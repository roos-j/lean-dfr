/-- The coarse spatial multiplicity in the energy sum preceding (3.24),
for arbitrary nonnegative weights on the first marginal. -/
theorem smoothingEnlargedInteractionIndices_weighted_first
    {ζ : (ℝ × ℝ) × ℝ → ℂ} (hc : HasCompactSupport ζ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ a : ℝ, 1 ≤ a →
    ∀ S : Finset ((Fin 2 → ℤ) × (Fin 2 → ℤ)),
    (∀ m ∈ S, m ∈ smoothingEnlargedInteractionIndices ζ a) →
    ∀ w : (Fin 2 → ℤ) → ℝ, (∀ n, 0 ≤ w n) →
      (∑ m ∈ S, w m.1) ≤ C*a*(∑ n ∈ S.image Prod.fst, w n) := by
  classical
  obtain ⟨C,hC,hcount⟩ := smoothingEnlargedInteractionIndices_first_fiber_count hc
  refine ⟨C,hC,?_⟩
  intro a ha S hS w hw
  apply smoothing_weighted_localization_count S (S.image Prod.fst) Prod.fst w (C*a)
    (fun m hm => Finset.mem_image_of_mem _ hm) (fun n _ => hw n)
  intro n hn
  let Q := (S.filter (fun m => m.1=n)).image Prod.snd
  have hQ : ∀ m ∈ Q, (n,m) ∈ smoothingEnlargedInteractionIndices ζ a := by
    intro m hm
    exact hS (n,m) ((smoothing_first_pair_fiber_mem S n m).mp hm)
  have hh := hcount a ha n Q hQ
  simpa only [Q, smoothing_first_pair_fiber_card] using hh
