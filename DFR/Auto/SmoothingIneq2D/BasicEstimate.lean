/-- Equation (3.1): the localized bilinear operator dual to the trilinear
form in Theorem 5. -/
noncomputable def smoothingLocalized (f₁ f₂ : ℝ × ℝ → ℂ)
    (ζ : (ℝ × ℝ) × ℝ → ℂ) (z : ℝ × ℝ) : ℂ :=
  ∫ t : ℝ, f₁ (z.1 + t, z.2) * f₂ (z.1, z.2 + t ^ 2) * ζ (z, t)

/-- The positive-time part of (3.1). -/
noncomputable def smoothingLocalizedPositive (f₁ f₂ : ℝ × ℝ → ℂ)
    (ζ : (ℝ × ℝ) × ℝ → ℂ) (z : ℝ × ℝ) : ℂ :=
  ∫ t in Set.Ioi (0 : ℝ), f₁ (z.1 + t, z.2) * f₂ (z.1, z.2 + t ^ 2) * ζ (z, t)

/-- Reflection used in the positive-time reduction following (3.1). -/
def smoothingReflectX (f : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℂ := f (-z.1, z.2)

/-- Reflect both the first spatial coordinate and time in the cutoff. -/
def smoothingReflectCutoff (ζ : (ℝ × ℝ) × ℝ → ℂ) (p : (ℝ × ℝ) × ℝ) : ℂ :=
  ζ ((-p.1.1, p.1.2), -p.2)

