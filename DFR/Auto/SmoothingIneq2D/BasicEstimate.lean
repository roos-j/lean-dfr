/-- The cutoff reflection is a homeomorphism, preserving compact support. -/
def smoothingCutoffReflection : ((ℝ × ℝ) × ℝ) ≃ₜ ((ℝ × ℝ) × ℝ) :=
  ((Homeomorph.neg ℝ).prodCongr (Homeomorph.refl ℝ)).prodCongr (Homeomorph.neg ℝ)

/-- Reflected cutoffs retain all the cutoff hypotheses in the positive-time
reduction following (3.1). -/
theorem smoothingReflectCutoff_admissible {ζ : (ℝ × ℝ) × ℝ → ℂ}
    (hζ : ContDiff ℝ ∞ ζ) (hc : HasCompactSupport ζ)
    (hoff : ∀ p ∈ tsupport ζ, p.2 ≠ 0) :
