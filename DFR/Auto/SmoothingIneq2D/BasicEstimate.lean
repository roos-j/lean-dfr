  congr 1
  have hn := integral_comp_neg_Ioi (0 : ℝ)
    (fun t : ℝ => f₁ (z.1 + t, z.2) * f₂ (z.1, z.2 + t ^ 2) * ζ (z, t))
  simpa only [neg_zero, neg_sq, add_comm] using hn.symm

