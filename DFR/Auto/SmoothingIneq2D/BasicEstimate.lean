      smoothingLocalizedPositive (smoothingReflectX f₁) (smoothingReflectX f₂)
        (smoothingReflectCutoff ζ) (-z.1, z.2) := by
  have h := integral_add_compl (s := Set.Ioi (0 : ℝ)) measurableSet_Ioi hi
  simp only [Set.compl_Ioi] at h
  unfold smoothingLocalized smoothingLocalizedPositive smoothingReflectX smoothingReflectCutoff
  simp only [neg_neg, neg_add_rev]
