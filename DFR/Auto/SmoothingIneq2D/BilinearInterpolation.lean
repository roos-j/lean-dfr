    (hB1 : ∀ (f : SimpleFunc X ℂ) (g : SimpleFunc Y ℂ), Integrable f μ → Integrable g ν →
      eLpNorm (B f g) 1 ρ ≤ ENNReal.ofReal M1*eLpNorm (f : X → ℂ) ⊤ μ*eLpNorm (g : Y → ℂ) ⊤ ν)
    (f : SimpleFunc X ℂ) (g : SimpleFunc Y ℂ) (hf : Integrable f μ) (hg : Integrable g ν) :
    eLpNorm (B f g) 1 ρ ≤ ENNReal.ofReal (M0^(3/4:ℝ)*M1^(1/4:ℝ))*
      eLpNorm (f : X → ℂ) 2 μ*eLpNorm (g : Y → ℂ) 2 ν := by
  have hgp : MemLp (g : Y → ℂ) 2 ν :=
    g.memLp_of_finite_measure_preimage _ (SimpleFunc.integrable_iff.mp hg)
  by_cases hz : eLpNorm (g : Y → ℂ) 2 ν = 0
  · have hga : (g : Y → ℂ) =ᵐ[ν] 0 := (eLpNorm_eq_zero_iff hgp.1 (by norm_num)).mp hz
    have hgz : eLpNorm (g : Y → ℂ) (3/2) ν = 0 := by rw [eLpNorm_congr_ae hga]; simp
    have hh := hB0 f g hf hg
