    have he : (fun u : ℝ => EuclideanSpace.single j u) =
        (fun u : ℝ => u • EuclideanSpace.single j (1 : ℝ)) := by
      funext u
      ext i
      simp only [PiLp.smul_apply, PiLp.single_apply, smul_eq_mul]
      split_ifs <;> simp
    rw [he]
    fun_prop
  let F := fun (m : Fin 2 → ℤ) (u : ℝ) => ψ u * smoothingSpatialPiece a m f (x -
