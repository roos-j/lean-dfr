        (C / q ^ 2) * ((∫ η in {η : EuclideanSpace ℝ (Fin 2) | |η j| ≤ 2 * T}, ‖(𝓕 F) η‖ ^ 2) +
          (∫ x, ‖F x‖ ^ 2) / (1 + T / q) ^ N) := by
  obtain ⟨C, hC, hb⟩ := smoothing_fourier_finite_region_sampling N
