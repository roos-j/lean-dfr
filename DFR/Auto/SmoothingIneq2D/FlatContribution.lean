theorem smoothingRawOscillatoryIntegral_finite_low_bound
    {ζ : (ℝ × ℝ) × ℝ → ℂ} (hζ : ContDiff ℝ ∞ ζ) {R : ℝ} (hR : 0 ≤ R) (N : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (a : ℝ) (ha : 1 ≤ a) (L : ℝ), 0 < L → ∀ (s : ℝ)
    (p : EuclideanSpace ℝ (Fin 3)) (m : (Fin 2 → ℤ) × (Fin 2 → ℤ)), ‖p‖ ≤ R →
    |a*(p 0+p 2)-(m.1 0 : ℝ)| ≤ 2 → |a*p 1-(m.1 1 : ℝ)| ≤ 2 →
    |a*p 0-(m.2 0 : ℝ)| ≤ 2 → |a*(p 1+(p 2)^2)-(m.2 1 : ℝ)| ≤ 2 → |a*s| ≤ 8 →
    ∀ (c₁ c₂ : (Fin 2 → ℤ) → ℂ) (S T : Finset (Fin 2 → ℤ)),
    (∀ v ∈ T, |(v 1 : ℝ)| ≤ a) →
    ‖∑ u ∈ S, ∑ v ∈ T, (c₁ u*c₂ v) *
      (∫ z, Complex.exp (↑Real.pi * Complex.I * ↑(smoothingOscillatoryPhase (a/2) (u,v) z)) *
        smoothingRawOscillatoryAmplitude (show 0 < a by linarith) s p m ζ z)‖ ≤
      C/a^3 * ((L^N)⁻¹ * Real.sqrt (∑ u ∈ S, ‖c₁ u‖^2) * Real.sqrt (∑ v ∈ T, ‖c₂ v‖^2) +
        ∑ k ∈ (S ×ˢ T).filter (fun k => k ∈ smoothingResonantFrequencies L (p 2)), ‖c₁ k.1*c₂
          k.2‖) := by
  classical
  obtain ⟨A, hA, hnon⟩ := smoothingRawOscillatoryIntegral_nonresonant_sum hζ hR N
  obtain ⟨B, hB, hkernel⟩ := smoothingRawOscillatoryIntegral_decay hζ hR 0
  refine ⟨A+B, by positivity, ?_⟩
  intro a ha L hL s p m hp h₀ h₁ h₂ h₃ hs c₁ c₂ S T hT
  let E := (S ×ˢ T).filter (fun k => k ∈ smoothingResonantFrequencies L (p 2))
  let D := (S ×ˢ T).filter (fun k => k ∉ smoothingResonantFrequencies L (p 2))
  let H := fun k : (Fin 2 → ℤ) × (Fin 2 → ℤ) => ∫ z,
    Complex.exp (↑Real.pi * Complex.I * ↑(smoothingOscillatoryPhase (a/2) k z)) *
      smoothingRawOscillatoryAmplitude (show 0 < a by linarith) s p m ζ z
  let W := fun k => c₁ k.1*c₂ k.2*H k
  have hD : D ⊆ S ×ˢ T := Finset.filter_subset _ _
  have hDn (k) (hk : k ∈ D) : k ∈ smoothingNonresonantFrequencies a L (p 2) := by
    have hh := Finset.mem_filter.mp hk
    refine ⟨hT k.2 (Finset.mem_product.mp hh.1).2, ?_⟩
    simpa only [smoothingResonantFrequencies, Set.mem_ofPred_eq, not_and_or, not_lt] using hh.2
  have hn := hnon a ha L hL s p m hp h₀ h₁ h₂ h₃ hs c₁ c₂ S T D hD hDn
  have hr : (∑ k ∈ E, ‖W k‖) ≤ B*(a^3)⁻¹ * ∑ k ∈ E, ‖c₁ k.1*c₂ k.2‖ := by
    rw [Finset.mul_sum]
    apply Finset.sum_le_sum
    intro k hk
    have hkT := (Finset.mem_product.mp (Finset.mem_filter.mp hk).1).2
    have hh := hkernel a ha s p m k hp h₀ h₁ h₂ h₃ hs (hT k.2 hkT)
    simp only [pow_zero, one_mul] at hh
    dsimp only [W]
    rw [norm_mul, mul_comm (B*(a^3)⁻¹)]
    exact mul_le_mul_of_nonneg_left hh (norm_nonneg _)
  have hsplit : (∑ k ∈ S ×ˢ T, ‖W k‖) = (∑ k ∈ E, ‖W k‖) + ∑ k ∈ D, ‖W k‖ := by
    exact (Finset.sum_filter_add_sum_filter_not (S ×ˢ T) (fun k => k ∈
      smoothingResonantFrequencies L (p 2)) (fun k => ‖W k‖)).symm
  calc
    _ = ‖∑ k ∈ S ×ˢ T, W k‖ := by rw [Finset.sum_product]
    _ ≤ ∑ k ∈ S ×ˢ T, ‖W k‖ := norm_sum_le _ _
    _ ≤ B*(a^3)⁻¹ * (∑ k ∈ E, ‖c₁ k.1*c₂ k.2‖) +
        A*(a^3)⁻¹*(L^N)⁻¹ * Real.sqrt (∑ u ∈ S, ‖c₁ u‖^2) * Real.sqrt (∑ v ∈ T, ‖c₂ v‖^2) := by
      rw [hsplit]
      exact add_le_add hr hn
    _ ≤ _ := by
      have hEA : 0 ≤ ∑ k ∈ E, ‖c₁ k.1*c₂ k.2‖ := Finset.sum_nonneg (fun _ _ => norm_nonneg _)
      have ha₀ : 0 < a := by linarith
      have h1 := mul_nonneg (mul_nonneg hA (inv_nonneg.mpr (pow_nonneg ha₀.le 3))) hEA
      have h2 : 0 ≤ B*(a^3)⁻¹*(L^N)⁻¹ * Real.sqrt (∑ u ∈ S, ‖c₁ u‖^2) * Real.sqrt (∑ v ∈ T, ‖c₂
        v‖^2) := by positivity
      dsimp only [E] at h1
      simp only [div_eq_mul_inv]
      nlinarith

/-- A finite subregion is bounded by the summable mass of its containing
frequency region. -/
theorem smoothing_finite_sum_le_subtype_tsum {X : Type*} (E : Finset X) (A : Set X) (f : X → ℝ)
    (hE : ∀ x ∈ E, x ∈ A)
    (hf : ∀ x, 0 ≤ f x) (hs : Summable (fun x : A => f x.val)) : (∑ x ∈ E, f x) ≤ ∑' x : A, f
      x.val := by
  classical
  have hi : Summable (A.indicator f) := summable_subtype_iff_indicator.mp hs
  calc
    _ = ∑ x ∈ E, A.indicator f x := Finset.sum_congr rfl (fun x hx => (Set.indicator_of_mem (hE x
      hx) f).symm)
    _ ≤ ∑' x, A.indicator f x := hi.sum_le_tsum E (fun x hx => Set.indicator_nonneg (fun y hy =>
      hf y) x)
    _ = _ := (tsum_subtype A f).symm

/-- Splitting the second finite Fourier set splits the actual pairing
exactly, before any norm estimate or approximation limit. -/
theorem smoothingMainCorrelationPairing_finite_partition {a : ℝ} (ha : 0 < a)
    (s : ℝ) (p : EuclideanSpace ℝ (Fin 3)) (m : (Fin 2 → ℤ) × (Fin 2 → ℤ))
    (h k : EuclideanSpace ℝ (Fin 2)) (F G : EuclideanSpace ℝ (Fin 2) → ℂ)
    (S T : Finset (Fin 2 → ℤ)) (P : (Fin 2 → ℤ) → Prop) [DecidablePred P]
    {ζ : (ℝ × ℝ) × ℝ → ℂ} (hζ : ContDiff ℝ ∞ ζ) :
    smoothingMainCorrelationPairing a ((p 0,p 1),p 2) ζ s
      (smoothingRawLocalFourierApprox ha m.1 h F S) (smoothingRawLocalFourierApprox ha m.2 k G T) =
    smoothingMainCorrelationPairing a ((p 0,p 1),p 2) ζ s
      (smoothingRawLocalFourierApprox ha m.1 h F S) (smoothingRawLocalFourierApprox ha m.2 k G
        (T.filter P)) +
    smoothingMainCorrelationPairing a ((p 0,p 1),p 2) ζ s
      (smoothingRawLocalFourierApprox ha m.1 h F S) (smoothingRawLocalFourierApprox ha m.2 k G
        (T.filter (fun v => ¬P v))) := by
  simp only [smoothingMainCorrelationPairing_finite_fourier ha s p m h k F G S _ hζ]
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro u hu
  exact (Finset.sum_filter_add_sum_filter_not T P _).symm

/-- The actual finite Fourier pairing obeys the source frequency split,
with full energy, resonant mass, and high coefficient energy all retained. -/
theorem smoothingMainCorrelationPairing_finite_frequency_bound
    {ζ : (ℝ × ℝ) × ℝ → ℂ} (hζ : ContDiff ℝ ∞ ζ) (hc : HasCompactSupport ζ)
    {R : ℝ} (hR : 0 ≤ R) (N : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (a : ℝ) (ha : 1 ≤ a) (L : ℝ), 1 ≤ L → ∀ (s : ℝ)
    (p : EuclideanSpace ℝ (Fin 3)) (m : (Fin 2 → ℤ) × (Fin 2 → ℤ)), ‖p‖ ≤ R →
    |a*(p 0+p 2)-(m.1 0 : ℝ)| ≤ 2 → |a*p 1-(m.1 1 : ℝ)| ≤ 2 →
    |a*p 0-(m.2 0 : ℝ)| ≤ 2 → |a*(p 1+(p 2)^2)-(m.2 1 : ℝ)| ≤ 2 → |a*s| ≤ 8 →
    ∀ (h k : EuclideanSpace ℝ (Fin 2)) (F G : EuclideanSpace ℝ (Fin 2) → ℂ),
    Summable (fun u => ‖smoothingRawLocalFourierCoefficient a m.1 h F u‖^2) →
    Summable (fun v => ‖smoothingRawLocalFourierCoefficient a m.2 k G v‖^2) →
    ∀ (S T : Finset (Fin 2 → ℤ)),
    let c₁ := smoothingRawLocalFourierCoefficient a m.1 h F
    let c₂ := smoothingRawLocalFourierCoefficient a m.2 k G
    ‖smoothingMainCorrelationPairing a ((p 0,p 1),p 2) ζ s
      (smoothingRawLocalFourierApprox (show 0 < a by linarith) m.1 h F S)
      (smoothingRawLocalFourierApprox (show 0 < a by linarith) m.2 k G T)‖ ≤
    C/a^3 * ((L^N)⁻¹ * Real.sqrt (∑' u, ‖c₁ u‖^2) * Real.sqrt (∑' v, ‖c₂ v‖^2) +
      (∑' z : smoothingResonantFrequencies L (p 2), ‖c₁ z.val.1*c₂ z.val.2‖) +
      Real.sqrt (∑' u, ‖c₁ u‖^2) * Real.sqrt (∑' v : {v : Fin 2 → ℤ | a ≤ |(v 1 : ℝ)|}, ‖c₂
        v.val‖^2)) := by
  classical
  obtain ⟨A, hA, hlow⟩ := smoothingRawOscillatoryIntegral_finite_low_bound hζ hR N
  obtain ⟨B, hB, hhigh⟩ := smoothingMainCorrelationPairing_finite_energy hζ hc
  refine ⟨A+B, by positivity, ?_⟩
  intro a ha L hL s p m hp h₀ h₁ h₂ h₃ hs h k F G hs₁ hs₂ S T
  have ha₀ : 0 < a := by linarith
  let c₁ := smoothingRawLocalFourierCoefficient a m.1 h F
  let c₂ := smoothingRawLocalFourierCoefficient a m.2 k G
  let T₀ := T.filter (fun v => |(v 1 : ℝ)| ≤ a)
  let T₁ := T.filter (fun v => ¬ |(v 1 : ℝ)| ≤ a)
  let E₁ := ∑' u, ‖c₁ u‖^2
  let E₂ := ∑' v, ‖c₂ v‖^2
  let Ehigh := ∑' v : {v : Fin 2 → ℤ | a ≤ |(v 1 : ℝ)|}, ‖c₂ v.val‖^2
  let Res := ∑' z : smoothingResonantFrequencies L (p 2), ‖c₁ z.val.1*c₂ z.val.2‖
  let P := fun U => smoothingMainCorrelationPairing a ((p 0,p 1),p 2) ζ s
    (smoothingRawLocalFourierApprox ha₀ m.1 h F S) (smoothingRawLocalFourierApprox ha₀ m.2 k G U)
  have he₁ : (∑ u ∈ S, ‖c₁ u‖^2) ≤ E₁ := hs₁.sum_le_tsum S (fun u hu => sq_nonneg _)
  have he₂ : (∑ v ∈ T₀, ‖c₂ v‖^2) ≤ E₂ := hs₂.sum_le_tsum T₀ (fun v hv => sq_nonneg _)
  have hehigh : (∑ v ∈ T₁, ‖c₂ v‖^2) ≤ Ehigh := smoothing_finite_sum_le_subtype_tsum T₁ _ _
    (fun v hv => (lt_of_not_ge (Finset.mem_filter.mp hv).2).le) (fun v => sq_nonneg _)
      (hs₂.subtype _)
  have hres := (smoothing_resonance_energy_second_L2 (t := p 2) hL c₁ c₂ hs₁ hs₂).1
  have hr : (∑ z ∈ (S ×ˢ T₀).filter (fun z => z ∈ smoothingResonantFrequencies L (p 2)), ‖c₁
    z.1*c₂ z.2‖) ≤ Res :=
    smoothing_finite_sum_le_subtype_tsum _ _ _ (fun z hz => (Finset.mem_filter.mp hz).2) (fun z =>
      norm_nonneg _) hres
  have hlo : ‖P T₀‖ ≤ A/a^3 * ((L^N)⁻¹ * Real.sqrt E₁ * Real.sqrt E₂ + Res) := by
    have hh := hlow a ha L (by linarith) s p m hp h₀ h₁ h₂ h₃ hs c₁ c₂ S T₀
      (fun v hv => (Finset.mem_filter.mp hv).2)
    have heq := smoothingMainCorrelationPairing_finite_fourier ha₀ s p m h k F G S T₀ hζ
    change P T₀ = _ at heq
    rw [heq]
    apply hh.trans
    gcongr
  have hhi : ‖P T₁‖ ≤ B/a^3 * Real.sqrt E₁ * Real.sqrt Ehigh := by
    have hh := hhigh a ha ((p 0,p 1),p 2) s m h k F G S T₁
    apply hh.trans
    gcongr
  have heq : P T = P T₀ + P T₁ := smoothingMainCorrelationPairing_finite_partition ha₀ s p m h k F
    G S T
    (fun v => |(v 1 : ℝ)| ≤ a) hζ
  change ‖P T‖ ≤ (A+B)/a^3 * ((L^N)⁻¹ * Real.sqrt E₁ * Real.sqrt E₂ + Res + Real.sqrt E₁ *
    Real.sqrt Ehigh)
  rw [heq]
  apply (norm_add_le _ _).trans ((add_le_add hlo hhi).trans ?_)
  have hRes : 0 ≤ Res := tsum_nonneg (fun z => norm_nonneg _)
  have hleft : 0 ≤ (B/a^3)*((L^N)⁻¹ * Real.sqrt E₁ * Real.sqrt E₂ + Res) := by positivity
  have hright : 0 ≤ (A/a^3)*Real.sqrt E₁*Real.sqrt Ehigh := by positivity
  simp only [div_eq_mul_inv] at *
  nlinarith

/-- Passing both local Fourier limits gives the frequency-split estimate
for the actual bounded measurable multiplicative differences. -/
theorem smoothingMainCorrelationPairing_frequency_bound
    {ζ : (ℝ × ℝ) × ℝ → ℂ} (hζ : ContDiff ℝ ∞ ζ) (hc : HasCompactSupport ζ)
    {R : ℝ} (hR : 0 ≤ R) (N : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (a : ℝ) (_ : 1 ≤ a) (L : ℝ), 1 ≤ L → ∀ (s : ℝ)
    (p : EuclideanSpace ℝ (Fin 3)) (m : (Fin 2 → ℤ) × (Fin 2 → ℤ)), ‖p‖ ≤ R →
    |a*(p 0+p 2)-(m.1 0 : ℝ)| ≤ 2 → |a*p 1-(m.1 1 : ℝ)| ≤ 2 →
    |a*p 0-(m.2 0 : ℝ)| ≤ 2 → |a*(p 1+(p 2)^2)-(m.2 1 : ℝ)| ≤ 2 → |a*s| ≤ 8 →
    ∀ (h k : EuclideanSpace ℝ (Fin 2)) (F G : EuclideanSpace ℝ (Fin 2) → ℂ),
    Measurable F → Measurable G → MemLp F 2 volume → MemLp G 2 volume →
    ∀ (M₁ M₂ : ℝ), 0 ≤ M₁ → 0 ≤ M₂ → (∀ x, ‖F x‖ ≤ M₁) → (∀ x, ‖G x‖ ≤ M₂) →
    (∀ x, F x ≠ 0 → ∀ i, |x i-(m.1 i : ℝ)/a| < 5/(4*a)) →
    (∀ x, G x ≠ 0 → ∀ i, |x i-(m.2 i : ℝ)/a| < 5/(4*a)) →
    let c₁ := smoothingRawLocalFourierCoefficient a m.1 h F
    let c₂ := smoothingRawLocalFourierCoefficient a m.2 k G
    ‖smoothingMainCorrelationPairing a ((p 0,p 1),p 2) ζ s
      (smoothingMultiplicativeDifference F h) (smoothingMultiplicativeDifference G k)‖ ≤
    C/a^3 * ((L^N)⁻¹ * Real.sqrt (∑' u, ‖c₁ u‖^2) * Real.sqrt (∑' v, ‖c₂ v‖^2) +
      (∑' z : smoothingResonantFrequencies L (p 2), ‖c₁ z.val.1*c₂ z.val.2‖) +
      Real.sqrt (∑' u, ‖c₁ u‖^2) * Real.sqrt (∑' v : {v : Fin 2 → ℤ | a ≤ |(v 1 : ℝ)|}, ‖c₂
        v.val‖^2)) := by
  obtain ⟨C, hC, hb⟩ := smoothingMainCorrelationPairing_finite_frequency_bound hζ hc hR N
  refine ⟨C, hC, ?_⟩
  intro a ha L hL s p m hp h₀ h₁ h₂ h₃ hs h k F G hF hG hF2 hG2 M₁ M₂ hM₁ hM₂ hFb hGb hsF hsG
  have ha₀ : 0 < a := by linarith
  have hc₁ := (smoothingRawLocalFourierCoefficient_parseval_scaled ha₀ m.1 h hF hM₁ hFb
    hsF).summable
  have hc₂ := (smoothingRawLocalFourierCoefficient_parseval_scaled ha₀ m.2 k hG hM₂ hGb
    hsG).summable
  exact smoothingMainCorrelation_pairing_bound_of_local_fourier hζ hc ha ((p 0,p 1),p 2) s m.1 m.2
    h k
    hF hG hF2 hG2 hM₁ hM₂ hFb hGb hsF hsG
    (hb a ha L hL s p m hp h₀ h₁ h₂ h₃ hs h k F G hc₁ hc₂)

/-- Positive reference times give the uniform increment Jacobian in
(3.20) for arbitrary integrable nonnegative energy functions. -/
theorem smoothing_increment_energy_dilation {E : ℝ → ℝ} (hE : Integrable E)
    (hE0 : ∀ s, 0 ≤ E s) {c t : ℝ} (hc : 0 < c) (ht : c ≤ t) (I : Set ℝ) :
    Integrable (fun s : ℝ => E (2*s*t)) ∧
    (∫ s in I, E (2*s*t)) ≤ (2*c)⁻¹ * ∫ v : ℝ, E v := by
  have ht₀ : 0 < t := hc.trans_le ht
  have hi : Integrable (fun s : ℝ => E (2*s*t)) := by
    have hh := hE.comp_mul_left' (show 2*t ≠ 0 by positivity)
    convert hh using 1
    funext s
    congr 1
    ring
  refine ⟨hi, ?_⟩
  calc
    _ ≤ ∫ s : ℝ, E (2*s*t) := integral_mono_measure Measure.restrict_le_self
      (Filter.Eventually.of_forall (fun s => hE0 _)) hi
    _ = (2*t)⁻¹ * ∫ v : ℝ, E v := by
      have hh := Measure.integral_comp_mul_left E (2*t)
      have he (s : ℝ) : 2*s*t = (2*t)*s := by ring
      simpa only [he, smul_eq_mul, abs_of_pos (by positivity : 0 < (2*t)⁻¹)] using hh
    _ ≤ _ := mul_le_mul_of_nonneg_right
      (inv_anti₀ (by positivity : 0 < 2*c) (by linarith : 2*c ≤ 2*t)) (integral_nonneg hE0)

/-- The source main correlation is the Euclidean pairing of the two
preferred-coordinate multiplicative differences. -/
theorem smoothingMainCorrelation_eq_pairing (a : ℝ) (p : (ℝ × ℝ) × ℝ)
    (F G : EuclideanSpace ℝ (Fin 2) → ℂ) (ζ : (ℝ × ℝ) × ℝ → ℂ) (s : ℝ) :
    smoothingMainCorrelation a p (fun z => F (smoothingPlaneEquiv.symm z))
      (fun z => G (smoothingPlaneEquiv.symm z)) ζ s =
    smoothingMainCorrelationPairing a p ζ s (smoothingMultiplicativeDifference F
      (smoothingCoordinateLine 0 s))
      (smoothingMultiplicativeDifference G (smoothingCoordinateLine 1 (2*s*p.2))) := by
  have h₀ : smoothingPlaneEquiv.symm (s,0) = smoothingCoordinateLine 0 s := by
    simpa only [map_zero, zero_add] using (smoothing_first_plane_point s 0).symm
  have h₁ : smoothingPlaneEquiv.symm (0,2*s*p.2) = smoothingCoordinateLine 1 (2*s*p.2) := by
    simpa only [map_zero, zero_add] using (smoothing_second_plane_point 0 (2*s*p.2)).symm
  simp only [smoothingMainCorrelation, smoothingLinearizedCorrelationIntegrand,
    smoothingMainCorrelationPairing, smoothingMultiplicativeDifference, map_add, h₀, h₁]

/-- The actual relocalized main correlation is integrable in the
increment, as required by the source summation after (3.18). -/
theorem smoothingRelocalized_mainCorrelation_integrable
    (g₁ g₂ : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℂ) {a R₁ R₂ ρ₁ ρ₂ : ℝ}
    (ha : 0 < a) (hR₁ : 0 < R₁) (hR₂ : 0 < R₂) (hρ₁ : 0 < ρ₁) (hρ₂ : 0 < ρ₂)
    (m : (Fin 2 → ℤ) × (Fin 2 → ℤ)) (flat₁ flat₂ : Bool) (p : (ℝ × ℝ) × ℝ)
    {ζ : (ℝ × ℝ) × ℝ → ℂ} (hζ : ContDiff ℝ ∞ ζ) :
    let F := smoothingRelocalizedComponent g₁ 0 a R₁ hρ₁ m.1 flat₁
    let G := smoothingRelocalizedComponent g₂ 1 a R₂ hρ₂ m.2 flat₂
    Integrable (smoothingMainCorrelation a p (fun z => F (smoothingPlaneEquiv.symm z))
      (fun z => G (smoothingPlaneEquiv.symm z)) ζ) := by
  obtain ⟨M, hM, hMb⟩ := smoothingRelocalizedComponent_bounded g₁ 0 a hR₁ hρ₁ m.1 flat₁
  obtain ⟨N, hN, hNb⟩ := smoothingRelocalizedComponent_bounded g₂ 1 a hR₂ hρ₂ m.2 flat₂
  have hmF := (smoothingRelocalizedComponent_measurable_support g₁ 0 ha R₁ hρ₁ m.1 flat₁).1.comp
    smoothingPlaneEquiv.symm.continuous.measurable
  have hmG := (smoothingRelocalizedComponent_measurable_support g₂ 1 ha R₂ hρ₂ m.2 flat₂).1.comp
    smoothingPlaneEquiv.symm.continuous.measurable
  have hi := (smoothingCorrelationIntegrands_measurable_integrable hmF hmG hM hN
    (fun z => hMb (smoothingPlaneEquiv.symm z)) (fun z => hNb (smoothingPlaneEquiv.symm z)) ha p
      hζ).2
  exact (smoothingMainCorrelation_fubini_of_integrable a p _ _ ζ hi).1

/-- All side conditions of the frequency estimate hold for the actual
selected relocalized components, with the source increments s and 2*s*t0. -/
theorem smoothingRelocalized_mainCorrelation_frequency_bound
    {ζ : (ℝ × ℝ) × ℝ → ℂ} (hζ : ContDiff ℝ ∞ ζ) (hc : HasCompactSupport ζ)
    {R : ℝ} (hR : 0 ≤ R) (N : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (a : ℝ) (_ : 1 ≤ a) (L : ℝ), 1 ≤ L → ∀ (s : ℝ)
    (p : EuclideanSpace ℝ (Fin 3)) (m : (Fin 2 → ℤ) × (Fin 2 → ℤ)), ‖p‖ ≤ R →
    |a*(p 0+p 2)-(m.1 0 : ℝ)| ≤ 2 → |a*p 1-(m.1 1 : ℝ)| ≤ 2 →
    |a*p 0-(m.2 0 : ℝ)| ≤ 2 → |a*(p 1+(p 2)^2)-(m.2 1 : ℝ)| ≤ 2 → |a*s| ≤ 8 →
    ∀ (g₁ g₂ : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℂ)
    (R₁ R₂ ρ₁ ρ₂ : ℝ) (_ : 0 < R₁) (_ : 0 < R₂) (hρ₁ : 0 < ρ₁) (hρ₂ : 0 < ρ₂) (flat₁ flat₂ : Bool),
    let F := smoothingRelocalizedComponent g₁ 0 a R₁ hρ₁ m.1 flat₁
    let G := smoothingRelocalizedComponent g₂ 1 a R₂ hρ₂ m.2 flat₂
    let c₁ := smoothingRawLocalFourierCoefficient a m.1 (smoothingCoordinateLine 0 s) F
    let c₂ := smoothingRawLocalFourierCoefficient a m.2 (smoothingCoordinateLine 1 (2*s*(p 2))) G
    ‖smoothingMainCorrelation a ((p 0,p 1),p 2) (fun z => F (smoothingPlaneEquiv.symm z))
      (fun z => G (smoothingPlaneEquiv.symm z)) ζ s‖ ≤
    C/a^3 * ((L^N)⁻¹ * Real.sqrt (∑' u, ‖c₁ u‖^2) * Real.sqrt (∑' v, ‖c₂ v‖^2) +
      (∑' z : smoothingResonantFrequencies L (p 2), ‖c₁ z.val.1*c₂ z.val.2‖) +
      Real.sqrt (∑' u, ‖c₁ u‖^2) * Real.sqrt (∑' v : {v : Fin 2 → ℤ | a ≤ |(v 1 : ℝ)|}, ‖c₂
        v.val‖^2)) := by
  obtain ⟨C, hC, hb⟩ := smoothingMainCorrelationPairing_frequency_bound hζ hc hR N
  refine ⟨C, hC, ?_⟩
  intro a ha L hL s p m hp h₀ h₁ h₂ h₃ hs g₁ g₂ R₁ R₂ ρ₁ ρ₂ hR₁ hR₂ hρ₁ hρ₂ flat₁ flat₂
  have ha₀ : 0 < a := by linarith
  obtain ⟨M₁, hM₁, hMb₁⟩ := smoothingRelocalizedComponent_bounded g₁ 0 a hR₁ hρ₁ m.1 flat₁
  obtain ⟨M₂, hM₂, hMb₂⟩ := smoothingRelocalizedComponent_bounded g₂ 1 a hR₂ hρ₂ m.2 flat₂
  obtain ⟨hm₁, hs₁⟩ := smoothingRelocalizedComponent_measurable_support g₁ 0 ha₀ R₁ hρ₁ m.1 flat₁
  obtain ⟨hm₂, hs₂⟩ := smoothingRelocalizedComponent_measurable_support g₂ 1 ha₀ R₂ hρ₂ m.2 flat₂
  have hF2 := smoothingRelocalizedComponent_memLp g₁ 0 ha₀ hR₁ hρ₁ m.1 flat₁
  have hG2 := smoothingRelocalizedComponent_memLp g₂ 1 ha₀ hR₂ hρ₂ m.2 flat₂
  dsimp only
  rw [smoothingMainCorrelation_eq_pairing]
  exact hb a ha L hL s p m hp h₀ h₁ h₂ h₃ hs (smoothingCoordinateLine 0 s)
    (smoothingCoordinateLine 1 (2*s*(p 2)))
    _ _ hm₁ hm₂ hF2 hG2 M₁ M₂ hM₁ hM₂ hMb₁ hMb₂ hs₁ hs₂

/-- The four source reference-point incidences with the fixed enlarged
support tolerance used by the actual local Fourier cutoff. -/
def smoothingEnlargedIncidence (a : ℝ) (m : (Fin 2 → ℤ) × (Fin 2 → ℤ))
    (p : (ℝ × ℝ) × ℝ) : Prop :=
  |a*(p.1.1+p.2)-(m.1 0 : ℝ)| ≤ 2 ∧ |a*p.1.2-(m.1 1 : ℝ)| ≤ 2 ∧
  |a*p.1.1-(m.2 0 : ℝ)| ≤ 2 ∧ |a*(p.1.2+p.2^2)-(m.2 1 : ℝ)| ≤ 2

/-- The enlarged geometric interaction set contains every nonzero
interaction of the actual relocalized components. -/
def smoothingEnlargedInteractionIndices (ζ : (ℝ × ℝ) × ℝ → ℂ) (a : ℝ) :
    Set ((Fin 2 → ℤ) × (Fin 2 → ℤ)) :=
  {m | ∃ p, ζ p ≠ 0 ∧ smoothingEnlargedIncidence a m p}

/-- The bounded quadratic residual persists for enlarged incidences. -/
theorem smoothingEnlargedIncidence_quadratic_relation {a R : ℝ} (ha : 1 ≤ a) (hR : 0 ≤ R)
    {m : (Fin 2 → ℤ) × (Fin 2 → ℤ)} {p : (ℝ × ℝ) × ℝ}
    (hp : smoothingEnlargedIncidence a m p) (ht : |p.2| ≤ R) :
    |(m.2 1 : ℝ) - ((m.1 1 : ℝ) + ((m.1 0 : ℝ) - (m.2 0 : ℝ)) ^ 2 / a)| ≤ 8*R+20 := by
  have hh := smoothing_quadratic_lattice_relation_tolerance ha hR (by norm_num : (0 : ℝ) ≤ 2)
    ht hp.1 hp.2.1 hp.2.2.1 hp.2.2.2
  norm_num at hh
  linarith

/-- Enlarged incidences bound both localization indices by the same
O(a) coordinate box as in the source marginal count. -/
theorem smoothingEnlargedIncidence_coordinate_bounds {a R : ℝ} (ha : 1 ≤ a) (hR : 1 ≤ R)
    {m : (Fin 2 → ℤ) × (Fin 2 → ℤ)} {p : (ℝ × ℝ) × ℝ}
    (hp : smoothingEnlargedIncidence a m p)
    (hx : |p.1.1| ≤ R) (hy : |p.1.2| ≤ R) (ht : |p.2| ≤ R) :
    (∀ i, |(m.1 i : ℝ)| ≤ a*(R+R^2+2)) ∧ (∀ i, |(m.2 i : ℝ)| ≤ a*(R+R^2+2)) := by
  have ha₀ : 0 ≤ a := by linarith
  have hcoord (z n : ℝ) (hz : |z| ≤ R+R^2) (hn : |a*z-n| ≤ 2) : |n| ≤ a*(R+R^2+2) := by
    have hh := abs_sub_le n (a*z) 0
    rw [sub_zero, sub_zero, abs_sub_comm, abs_mul, abs_of_nonneg ha₀] at hh
    nlinarith [mul_le_mul_of_nonneg_left hz ha₀]
  have hxt : |p.1.1+p.2| ≤ R+R^2 := (abs_add_le _ _).trans (by nlinarith)
  have hyt : |p.1.2+p.2^2| ≤ R+R^2 := by
    have hh := abs_add_le p.1.2 (p.2^2)
    rw [abs_of_nonneg (sq_nonneg p.2)] at hh
    have ht2 := pow_le_pow_left₀ (abs_nonneg _) ht 2
    rw [sq_abs] at ht2
    nlinarith
  constructor
  · intro i
    fin_cases i
    · exact hcoord _ _ hxt hp.1
    · exact hcoord _ _ (hy.trans (by nlinarith [sq_nonneg R])) hp.2.1
  · intro i
    fin_cases i
    · exact hcoord _ _ (hx.trans (by nlinarith [sq_nonneg R])) hp.2.2.1
    · exact hcoord _ _ hyt hp.2.2.2

/-- Enlarging the fixed radius of the existing source box accommodates
all actual enlarged-support interactions, without changing its a^3 count. -/
theorem smoothingEnlargedIncidence_box {a R : ℝ} (ha : 1 ≤ a) (hR : 1 ≤ R)
    {m : (Fin 2 → ℤ) × (Fin 2 → ℤ)} {p : (ℝ × ℝ) × ℝ}
    (hp : smoothingEnlargedIncidence a m p)
    (hx : |p.1.1| ≤ R) (hy : |p.1.2| ≤ R) (ht : |p.2| ≤ R) :
    m.1 ∈ smoothingSpatialIndices a (2*R+4) ∧ m.2 ∈ smoothingSpatialIndices a (2*R+4) ∧
    smoothingInteractionCode a m ∈ smoothingInteractionBox a (2*R+4) := by
  obtain ⟨h₁, h₂⟩ := smoothingEnlargedIncidence_coordinate_bounds ha hR hp hx hy ht
  have hbound (n : Fin 2 → ℤ) (hn : ∀ i, |(n i : ℝ)| ≤ a*(R+R^2+2)) : n ∈ smoothingSpatialIndices
    a (2*R+4) := by
    apply Fintype.mem_piFinset.mpr
    intro i
    have hb : |(n i : ℝ)| ≤ a*((2*R+4)+(2*R+4)^2+1) := (hn i).trans
      (mul_le_mul_of_nonneg_left (by nlinarith [sq_nonneg R]) (by linarith))
    have hbs := abs_le.mp hb
    have hc := Int.le_ceil (a*((2*R+4)+(2*R+4)^2+1))
    apply Finset.mem_Icc.mpr
    constructor
    · have hh : -(⌈a*((2*R+4)+(2*R+4)^2+1)⌉ : ℝ) ≤ (n i : ℝ) := by linarith
      exact_mod_cast hh
    · have hh : (n i : ℝ) ≤ (⌈a*((2*R+4)+(2*R+4)^2+1)⌉ : ℝ) := by linarith
      exact_mod_cast hh
  have hm₁ := hbound m.1 h₁
  have hm₂ := hbound m.2 h₂
  refine ⟨hm₁, hm₂, smoothingInteractionCode_mem_of_bounds a (2*R+4) m hm₁ hm₂ ?_⟩
  have hh := smoothingEnlargedIncidence_quadratic_relation ha (by linarith : 0 ≤ R) hp ht
  linarith

/-- The source O(a^3) interaction count and O(a^2) marginal counts
remain valid for the actual enlarged supports. -/
theorem smoothingEnlargedInteractionIndices_count {ζ : (ℝ × ℝ) × ℝ → ℂ}
    (hc : HasCompactSupport ζ) :
    ∃ C D : ℝ, 0 ≤ C ∧ 0 ≤ D ∧ ∀ a : ℝ, 1 ≤ a →
    (smoothingEnlargedInteractionIndices ζ a).Finite ∧
    ((smoothingEnlargedInteractionIndices ζ a).ncard : ℝ) ≤ C*a^3 ∧
    (Prod.fst '' smoothingEnlargedInteractionIndices ζ a).Finite ∧
    (Prod.snd '' smoothingEnlargedInteractionIndices ζ a).Finite ∧
    ((Prod.fst '' smoothingEnlargedInteractionIndices ζ a).ncard : ℝ) ≤ D*a^2 ∧
    ((Prod.snd '' smoothingEnlargedInteractionIndices ζ a).ncard : ℝ) ≤ D*a^2 := by
  obtain ⟨R, hR, hcut⟩ := smoothing_cutoff_coordinate_bound hc
  let B := 2*R+4
  have hB : 1 ≤ B := by dsimp only [B]; linarith
  have hceil : 0 ≤ (⌈4*B+7⌉ : ℝ) := by exact_mod_cast Int.ceil_nonneg (show 0 ≤ 4*B+7 by linarith)
  refine ⟨(2*B+2*B^2+5)^3*(2*(⌈4*B+7⌉ : ℝ)+1), (2*B+2*B^2+5)^2, by positivity, by positivity, ?_⟩
  intro a ha
  have hbox (m) (hm : m ∈ smoothingEnlargedInteractionIndices ζ a) :
      m.1 ∈ smoothingSpatialIndices a B ∧ m.2 ∈ smoothingSpatialIndices a B ∧
      smoothingInteractionCode a m ∈ smoothingInteractionBox a B := by
    obtain ⟨p, hp, hinc⟩ := hm
    have hh := hcut p.1.1 p.1.2 p.2 hp
    exact smoothingEnlargedIncidence_box ha hR hinc hh.1 hh.2.1 hh.2.2
  have hmap : Set.MapsTo (smoothingInteractionCode a) (smoothingEnlargedInteractionIndices ζ a)
      (smoothingInteractionBox a B : Set ((Fin 3 → ℤ) × ℤ)) := fun m hm => (hbox m hm).2.2
  have hinj : Set.InjOn (smoothingInteractionCode a) (smoothingEnlargedInteractionIndices ζ a) :=
    (smoothingInteractionCode_injective a).injOn
  have hfinite := Set.Finite.of_injOn hmap hinj (smoothingInteractionBox a B).finite_toSet
  have hcount : ((smoothingEnlargedInteractionIndices ζ a).ncard : ℝ) ≤
      ((2*B+2*B^2+5)^3*(2*(⌈4*B+7⌉ : ℝ)+1))*a^3 := by
    have hn := Set.ncard_le_ncard_of_injOn _ hmap hinj (smoothingInteractionBox a B).finite_toSet
    simp only [Set.ncard_coe_finset] at hn
    exact (Nat.cast_le.mpr hn).trans (smoothingInteractionBox_card ha hB)
  have hfirst : Prod.fst '' smoothingEnlargedInteractionIndices ζ a ⊆
      (smoothingSpatialIndices a B : Set (Fin 2 → ℤ)) := by
    rintro _ ⟨m, hm, rfl⟩
    exact (hbox m hm).1
  have hsecond : Prod.snd '' smoothingEnlargedInteractionIndices ζ a ⊆
      (smoothingSpatialIndices a B : Set (Fin 2 → ℤ)) := by
    rintro _ ⟨m, hm, rfl⟩
    exact (hbox m hm).2.1
  have hbound {S : Set (Fin 2 → ℤ)} (hS : S ⊆ (smoothingSpatialIndices a B : Set (Fin 2 → ℤ))) :
      (S.ncard : ℝ) ≤ (2*B+2*B^2+5)^2*a^2 := by
    have hh := Set.ncard_le_ncard hS (smoothingSpatialIndices a B).finite_toSet
    simp only [Set.ncard_coe_finset] at hh
    exact (Nat.cast_le.mpr hh).trans (smoothingSpatialIndices_card ha hB)
  exact ⟨hfinite, hcount, (smoothingSpatialIndices a B).finite_toSet.subset hfirst,
    (smoothingSpatialIndices a B).finite_toSet.subset hsecond, hbound hfirst, hbound hsecond⟩

/-- The enlarged incidences preserve the reference-time relation in (3.21),
with a fixed overlap error of four. -/
theorem smoothingEnlargedIncidence_time_relation {a : ℝ}
    {m : (Fin 2 → ℤ) × (Fin 2 → ℤ)} {p : (ℝ × ℝ) × ℝ}
    (hp : smoothingEnlargedIncidence a m p) :
    |(m.1 0 : ℝ) - (m.2 0 : ℝ) - a*p.2| ≤ 4 := by
  have he : (m.1 0 : ℝ) - (m.2 0 : ℝ) - a*p.2 =
      -(a*(p.1.1+p.2)-(m.1 0 : ℝ)) + (a*p.1.1-(m.2 0 : ℝ)) := by ring
  rw [he]
  exact (abs_add_le _ _).trans
    (by simpa only [abs_neg, show (2 : ℝ)+2=4 by norm_num] using add_le_add hp.1 hp.2.2.1)

/-- Time diameter bounds the free coordinate at fixed first spatial index,
including the enlarged support overlap. -/
theorem smoothingEnlargedIncidence_first_diameter {a W : ℝ} (ha : 0 ≤ a)
    (m₁ m n : Fin 2 → ℤ) (p q : (ℝ × ℝ) × ℝ)
    (hp : smoothingEnlargedIncidence a (m₁, m) p)
    (hq : smoothingEnlargedIncidence a (m₁, n) q)
    (hW : |p.2 - q.2| ≤ W) : |(m 0 : ℝ)-(n 0 : ℝ)| ≤ 8+a*W := by
  have hp' := smoothingEnlargedIncidence_time_relation hp
  have hq' := smoothingEnlargedIncidence_time_relation hq
  have he : (m 0 : ℝ)-(n 0 : ℝ) =
      -((m₁ 0 : ℝ)-(m 0 : ℝ)-a*p.2) +
      ((m₁ 0 : ℝ)-(n 0 : ℝ)-a*q.2) - a*(p.2-q.2) := by ring
  rw [he]
  apply (abs_sub _ _).trans
  have hh := (abs_add_le (-((m₁ 0 : ℝ)-(m 0 : ℝ)-a*p.2))
    ((m₁ 0 : ℝ)-(n 0 : ℝ)-a*q.2)).trans
    (by simpa only [abs_neg] using add_le_add hp' hq')
  rw [abs_mul, abs_of_nonneg ha]
  nlinarith [mul_le_mul_of_nonneg_left hW ha]

/-- The corresponding free-coordinate diameter at fixed second spatial index. -/
theorem smoothingEnlargedIncidence_second_diameter {a W : ℝ} (ha : 0 ≤ a)
    (m₂ m n : Fin 2 → ℤ) (p q : (ℝ × ℝ) × ℝ)
    (hp : smoothingEnlargedIncidence a (m, m₂) p)
    (hq : smoothingEnlargedIncidence a (n, m₂) q)
    (hW : |p.2 - q.2| ≤ W) : |(m 0 : ℝ)-(n 0 : ℝ)| ≤ 8+a*W := by
  have hp' := smoothingEnlargedIncidence_time_relation hp
  have hq' := smoothingEnlargedIncidence_time_relation hq
  have he : (m 0 : ℝ)-(n 0 : ℝ) =
      ((m 0 : ℝ)-(m₂ 0 : ℝ)-a*p.2) -
      ((n 0 : ℝ)-(m₂ 0 : ℝ)-a*q.2) + a*(p.2-q.2) := by ring
  rw [he]
  apply (abs_add_le _ _).trans
  have hh := (abs_sub ((m 0 : ℝ)-(m₂ 0 : ℝ)-a*p.2)
    ((n 0 : ℝ)-(m₂ 0 : ℝ)-a*q.2)).trans (add_le_add hp' hq')
  rw [abs_mul, abs_of_nonneg ha]
  nlinarith [mul_le_mul_of_nonneg_left hW ha]

/-- Equation (3.21) for the actual enlarged localization supports. -/
theorem smoothingEnlargedIncidence_eq3_21 {ζ : (ℝ × ℝ) × ℝ → ℂ} (hc : HasCompactSupport ζ)
    (hpos : ∀ p ∈ tsupport ζ, 0 < p.2) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ a : ℝ, 1 ≤ a →
    ∀ (m₁ : Fin 2 → ℤ)
      (S : Finset (Fin 2 → ℤ)) (P : (Fin 2 → ℤ) → (ℝ × ℝ) × ℝ),
    (∀ m ∈ S, ζ (P m) ≠ 0 ∧
      smoothingEnlargedIncidence a (m₁,m) (P m)) →
    ∀ (k : Fin 2 → ℤ), k 0 ≠ 0 → ∀ L : ℝ, 0 ≤ L →
    (∀ m ∈ S, |2 * (P m).2 * (k 1 : ℝ) - (k 0 : ℝ)| ≤ L) →
      (S.card : ℝ) ≤ C * (1 + a * L / |(k 0 : ℝ)|) := by
  obtain ⟨R, hR, hbound⟩ := smoothing_cutoff_coordinate_bound hc
  obtain ⟨c, _, hc0, _, htime⟩ := smoothing_cutoff_positive_time_bounds hc hpos
  let V : ℝ := 2 * (⌈8 * R + 21⌉ : ℝ) + 1
  have hV : 0 ≤ V := by
    have hh : 0 ≤ (⌈8 * R + 21⌉ : ℝ) :=
      by exact_mod_cast Int.ceil_nonneg (show 0 ≤ 8 * R + 21 by linarith)
    dsimp [V]
    linarith
  refine ⟨(19 + 4 * R^2 / c) * V, by positivity, ?_⟩
  intro a ha m₁ S P hP k hk L hL hres
  have ha0 : 0 < a := by linarith
  have hk0 : (k 0 : ℝ) ≠ 0 := by exact_mod_cast hk
  have hkabs : 0 < |(k 0 : ℝ)| := abs_pos.mpr hk0
  let W : ℝ := 2 * R^2 * L / (c * |(k 0 : ℝ)|)
  have hW : 0 ≤ W := by dsimp [W]; positivity
  have ht : ∀ m ∈ S, c ≤ (P m).2 ∧ (P m).2 ≤ R := by
    intro m hm
    exact ⟨(htime (P m) (hP m hm).1).1,
      (le_abs_self _).trans (hbound (P m).1.1 (P m).1.2 (P m).2 (hP m hm).1).2.2⟩
  have hdiam : ∀ m ∈ S, ∀ n ∈ S, |(m 0 : ℝ) - (n 0 : ℝ)| ≤ 8 + a * W := by
    intro m hm n hn
    exact smoothingEnlargedIncidence_first_diameter ha0.le m₁ m n (P m) (P n)
      (hP m hm).2 (hP n hn).2
      (smoothing_resonance_time_diameter hc0 (ht m hm) (ht n hn) k hk (hres m hm) (hres n hn))
  have hquad := fun m hm => smoothingEnlargedIncidence_quadratic_relation ha (by linarith : 0 ≤ R)
    (hP m hm).2 (hbound (P m).1.1 (P m).1.2 (P m).2 (hP m hm).1).2.2
  have hh := smoothing_quadratic_fiber_diameter_count a m₁ S
    (by positivity : 0 ≤ 8 + a * W) (by linarith : 0 ≤ 8 * R + 20) hdiam hquad
  have hfac : 2 * (8 + a * W) + 3 ≤ (19 + 4 * R^2 / c) * (1 + a * L / |(k 0 : ℝ)|) := by
    have he : 2 * (8 + a * W) + 3 = 19 + (4 * R^2 / c) * (a * L / |(k 0 : ℝ)|) := by
      dsimp [W]
      ring
    rw [he]
    have hx : 0 ≤ a * L / |(k 0 : ℝ)| := by positivity
    have hy : 0 ≤ 4 * R^2 / c := by positivity
    nlinarith
  have hh' : (S.card : ℝ) ≤ (2 * (8 + a * W) + 3) * V := by
    simpa only [V, show 8 * R + 20 + 1 = 8 * R + 21 by ring] using hh
  exact hh'.trans ((mul_le_mul_of_nonneg_right hfac hV).trans_eq (by ring))

/-- Equation (3.23) for the actual enlarged localization supports. -/
theorem smoothingEnlargedIncidence_eq3_23 {ζ : (ℝ × ℝ) × ℝ → ℂ} (hc : HasCompactSupport ζ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ a : ℝ, 1 ≤ a →
    ∀ (m₂ : Fin 2 → ℤ)
      (S : Finset (Fin 2 → ℤ)) (P : (Fin 2 → ℤ) → (ℝ × ℝ) × ℝ),
    (∀ m ∈ S, ζ (P m) ≠ 0 ∧
      smoothingEnlargedIncidence a (m,m₂) (P m)) →
    ∀ (k : Fin 2 → ℤ), k 1 ≠ 0 → ∀ L : ℝ, 0 ≤ L →
    (∀ m ∈ S, |2 * (P m).2 * (k 1 : ℝ) - (k 0 : ℝ)| ≤ L) →
      (S.card : ℝ) ≤ C * (1 + a * L / |(k 1 : ℝ)|) := by
  obtain ⟨R, hR, hbound⟩ := smoothing_cutoff_coordinate_bound hc
  let V : ℝ := 2 * (⌈8 * R + 21⌉ : ℝ) + 1
  have hV : 0 ≤ V := by
    have hh : 0 ≤ (⌈8 * R + 21⌉ : ℝ) :=
      by exact_mod_cast Int.ceil_nonneg (show 0 ≤ 8 * R + 21 by linarith)
    dsimp [V]
    linarith
  refine ⟨21 * V, by positivity, ?_⟩
  intro a ha m₂ S P hP k hk L hL hres
  have ha0 : 0 < a := by linarith
  have hk0 : (k 1 : ℝ) ≠ 0 := by exact_mod_cast hk
  have hkabs : 0 < |(k 1 : ℝ)| := abs_pos.mpr hk0
  let W : ℝ := L / |(k 1 : ℝ)|
  have hW : 0 ≤ W := by dsimp [W]; positivity
  have hdiam : ∀ m ∈ S, ∀ n ∈ S, |(m 0 : ℝ) - (n 0 : ℝ)| ≤ 8 + a * W := by
    intro m hm n hn
    exact smoothingEnlargedIncidence_second_diameter ha0.le m₂ m n (P m) (P n)
      (hP m hm).2 (hP n hn).2
      (smoothing_resonance_second_time_diameter k hk (hres m hm) (hres n hn))
  have hquad := fun m hm => smoothingEnlargedIncidence_quadratic_relation ha (by linarith : 0 ≤ R)
    (hP m hm).2 (hbound (P m).1.1 (P m).1.2 (P m).2 (hP m hm).1).2.2
  have hh := smoothing_quadratic_second_fiber_diameter_count a m₂ S
    (by positivity : 0 ≤ 8 + a * W) (by linarith : 0 ≤ 8 * R + 20) hdiam hquad
  have hfac : 2 * (8 + a * W) + 3 ≤ 21 * (1 + a * L / |(k 1 : ℝ)|) := by
    dsimp [W]
    rw [← mul_div_assoc]
    have hx : 0 ≤ a * L / |(k 1 : ℝ)| := by positivity
    nlinarith
  have hh' : (S.card : ℝ) ≤ (2 * (8 + a * W) + 3) * V := by
    simpa only [V, show 8 * R + 20 + 1 = 8 * R + 21 by ring] using hh
  exact hh'.trans ((mul_le_mul_of_nonneg_right hfac hV).trans_eq (by ring))

/-- The coarse fiber count used beside (3.21): fixing the first index
leaves O(a) enlarged interactions. -/
theorem smoothingEnlargedInteractionIndices_first_fiber_count
    {ζ : (ℝ × ℝ) × ℝ → ℂ} (hc : HasCompactSupport ζ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ a : ℝ, 1 ≤ a →
    ∀ (m₁ : Fin 2 → ℤ) (S : Finset (Fin 2 → ℤ)),
      (∀ m ∈ S, (m₁,m) ∈ smoothingEnlargedInteractionIndices ζ a) →
      (S.card : ℝ) ≤ C*a := by
  obtain ⟨R, hR, hbound⟩ := smoothing_cutoff_coordinate_bound hc
  let V : ℝ := 2*(⌈8*R+21⌉ : ℝ)+1
  have hV : 0 ≤ V := by
    have hh : 0 ≤ (⌈8*R+21⌉ : ℝ) := by exact_mod_cast Int.ceil_nonneg (show 0 ≤ 8*R+21 by linarith)
    dsimp [V]
    linarith
  refine ⟨(4*(R+R^2+2)+3)*V, by positivity, ?_⟩
  intro a ha m₁ S hS
  have hcoord : ∀ m ∈ S, |(m 0 : ℝ)| ≤ a*(R+R^2+2) := by
    intro m hm
    obtain ⟨p, hp, hi⟩ := hS m hm
    have hb := hbound p.1.1 p.1.2 p.2 hp
    exact (smoothingEnlargedIncidence_coordinate_bounds ha hR hi hb.1 hb.2.1 hb.2.2).2 0
  have hdiam : ∀ m ∈ S, ∀ n ∈ S, |(m 0 : ℝ)-(n 0 : ℝ)| ≤ 2*a*(R+R^2+2) := by
    intro m hm n hn
    exact (abs_sub _ _).trans (by linarith [hcoord m hm, hcoord n hn])
  have hquad : ∀ m ∈ S, |(m 1 : ℝ)-((m₁ 1 : ℝ)+((m₁ 0 : ℝ)-(m 0 : ℝ)) ^ 2 / a)| ≤ 8*R+20 := by
    intro m hm
    obtain ⟨p, hp, hi⟩ := hS m hm
    exact smoothingEnlargedIncidence_quadratic_relation ha (by linarith) hi (hbound p.1.1 p.1.2
      p.2 hp).2.2
  have hh := smoothing_quadratic_fiber_diameter_count a m₁ S
    (by positivity : 0 ≤ 2*a*(R+R^2+2)) (by linarith : 0 ≤ 8*R+20) hdiam hquad
  have hh' : (S.card : ℝ) ≤ (2*(2*a*(R+R^2+2))+3)*V := by
    simpa only [V, show 8*R+20+1=8*R+21 by ring] using hh
  have hfac : 2*(2*a*(R+R^2+2))+3 ≤ (4*(R+R^2+2)+3)*a := by nlinarith
  exact hh'.trans ((mul_le_mul_of_nonneg_right hfac hV).trans_eq (by ring))
/-- The coarse fiber count used beside (3.23): fixing the second index
leaves O(a) enlarged interactions. -/
theorem smoothingEnlargedInteractionIndices_second_fiber_count
    {ζ : (ℝ × ℝ) × ℝ → ℂ} (hc : HasCompactSupport ζ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ a : ℝ, 1 ≤ a →
    ∀ (m₂ : Fin 2 → ℤ) (S : Finset (Fin 2 → ℤ)),
      (∀ m ∈ S, (m,m₂) ∈ smoothingEnlargedInteractionIndices ζ a) →
      (S.card : ℝ) ≤ C*a := by
  obtain ⟨R, hR, hbound⟩ := smoothing_cutoff_coordinate_bound hc
  let V : ℝ := 2*(⌈8*R+21⌉ : ℝ)+1
  have hV : 0 ≤ V := by
    have hh : 0 ≤ (⌈8*R+21⌉ : ℝ) := by exact_mod_cast Int.ceil_nonneg (show 0 ≤ 8*R+21 by linarith)
    dsimp [V]
    linarith
  refine ⟨(4*(R+R^2+2)+3)*V, by positivity, ?_⟩
  intro a ha m₂ S hS
  have hcoord : ∀ m ∈ S, |(m 0 : ℝ)| ≤ a*(R+R^2+2) := by
    intro m hm
    obtain ⟨p, hp, hi⟩ := hS m hm
    have hb := hbound p.1.1 p.1.2 p.2 hp
    exact (smoothingEnlargedIncidence_coordinate_bounds ha hR hi hb.1 hb.2.1 hb.2.2).1 0
  have hdiam : ∀ m ∈ S, ∀ n ∈ S, |(m 0 : ℝ)-(n 0 : ℝ)| ≤ 2*a*(R+R^2+2) := by
    intro m hm n hn
    exact (abs_sub _ _).trans (by linarith [hcoord m hm, hcoord n hn])
  have hquad : ∀ m ∈ S, |(m₂ 1 : ℝ)-((m 1 : ℝ)+((m 0 : ℝ)-(m₂ 0 : ℝ)) ^ 2 / a)| ≤ 8*R+20 := by
    intro m hm
    obtain ⟨p, hp, hi⟩ := hS m hm
    exact smoothingEnlargedIncidence_quadratic_relation ha (by linarith) hi (hbound p.1.1 p.1.2
      p.2 hp).2.2
  have hh := smoothing_quadratic_second_fiber_diameter_count a m₂ S
    (by positivity : 0 ≤ 2*a*(R+R^2+2)) (by linarith : 0 ≤ 8*R+20) hdiam hquad
  have hh' : (S.card : ℝ) ≤ (2*(2*a*(R+R^2+2))+3)*V := by
    simpa only [V, show 8*R+20+1=8*R+21 by ring] using hh
  have hfac : 2*(2*a*(R+R^2+2))+3 ≤ (4*(R+R^2+2)+3)*a := by nlinarith
  exact hh'.trans ((mul_le_mul_of_nonneg_right hfac hV).trans_eq (by ring))

/-- The exact scaled radius of the actual enlarged component. -/
theorem smoothingRelocalizedComponent_scaled_support_quarter
    (g : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℂ) (j : Fin 2)
    {a : ℝ} (ha : 0 < a) (R : ℝ) {ρ : ℝ} (hρ : 0 < ρ)
    (m : Fin 2 → ℤ) (flat : Bool) (x : EuclideanSpace ℝ (Fin 2))
    (hx : smoothingRelocalizedComponent g j a R hρ m flat x ≠ 0) :
    ∀ i, |a*x i-(m i : ℝ)| ≤ 5/4 := by
  intro i
  have hh := (smoothingRelocalizedComponent_measurable_support g j ha R hρ m flat).2 x hx i
  have he : a*x i-(m i : ℝ) = a*(x i-(m i : ℝ)/a) := by field_simp
  rw [he, abs_mul, abs_of_pos ha]
  have hb := mul_lt_mul_of_pos_left hh ha
  have he' : a*(5/(4*a)) = 5/4 := by field_simp
  rw [he'] at hb
  exact hb.le

/-- The actual enlarged physical support gives the scaled incidence
bounds used in the source interaction counting. -/
theorem smoothingRelocalizedComponent_scaled_support
    (g : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℂ) (j : Fin 2)
    {a : ℝ} (ha : 0 < a) (R : ℝ) {ρ : ℝ} (hρ : 0 < ρ)
    (m : Fin 2 → ℤ) (flat : Bool) (x : EuclideanSpace ℝ (Fin 2))
    (hx : smoothingRelocalizedComponent g j a R hρ m flat x ≠ 0) :
    ∀ i, |a*x i-(m i : ℝ)| ≤ 2 := by
  intro i
  exact (smoothingRelocalizedComponent_scaled_support_quarter g j ha R hρ m flat x hx i).trans
    (by norm_num)
/-- A nonzero localized product with the source cutoff is an enlarged
interaction; this supplies the actual reference points for (3.21) and (3.23). -/
theorem smoothingRelocalizedComponent_interaction
    (g₁ g₂ : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℂ)
    {a : ℝ} (ha : 0 < a) (R₁ R₂ : ℝ) {ρ₁ ρ₂ : ℝ}
    (hρ₁ : 0 < ρ₁) (hρ₂ : 0 < ρ₂)
    (m : (Fin 2 → ℤ) × (Fin 2 → ℤ)) (flat₁ flat₂ : Bool)
    (ζ : (ℝ × ℝ) × ℝ → ℂ) (p : (ℝ × ℝ) × ℝ)
    (hp : smoothingRelocalizedComponent g₁ 0 a R₁ hρ₁ m.1 flat₁
        (smoothingPlaneEquiv.symm (p.1.1 + p.2, p.1.2)) *
      smoothingRelocalizedComponent g₂ 1 a R₂ hρ₂ m.2 flat₂
        (smoothingPlaneEquiv.symm (p.1.1, p.1.2 + p.2 ^ 2)) * ζ p ≠ 0) :
    ζ p ≠ 0 ∧ smoothingEnlargedIncidence a m p := by
  have hζ := (mul_ne_zero_iff.mp hp).2
  have h₁ := (mul_ne_zero_iff.mp (mul_ne_zero_iff.mp hp).1).1
  have h₂ := (mul_ne_zero_iff.mp (mul_ne_zero_iff.mp hp).1).2
  have hb₁ := smoothingRelocalizedComponent_scaled_support g₁ 0 ha R₁ hρ₁ m.1 flat₁ _ h₁
  have hb₂ := smoothingRelocalizedComponent_scaled_support g₂ 1 ha R₂ hρ₂ m.2 flat₂ _ h₂
  exact ⟨hζ, hb₁ 0, hb₁ 1, hb₂ 0, hb₂ 1⟩

/-- The spatial energy separation after (3.23), with enlarged supports and arbitrary summable
  nonnegative energies. -/
theorem smoothingEnlargedIncidence_low_high_energy_first {ζ : (ℝ × ℝ) × ℝ → ℂ}
    (hc : HasCompactSupport ζ) (hpos : ∀ p ∈ tsupport ζ, 0 < p.2) :
    ∃ C D : ℝ, 0 ≤ C ∧ 0 ≤ D ∧ ∀ a : ℝ, 1 ≤ a →
    ∀ w : (Fin 2 → ℤ) → (Fin 2 → ℤ) → ℝ, (∀ n k, 0 ≤ w n k) → (∀ n, Summable (w n)) →
    ∀ (S : Finset ((Fin 2 → ℤ) × (Fin 2 → ℤ)))
      (P : ((Fin 2 → ℤ) × (Fin 2 → ℤ)) → (ℝ × ℝ) × ℝ),
    (∀ m ∈ S, ζ (P m) ≠ 0 ∧
      smoothingEnlargedIncidence a m (P m)) →
    ∀ L q : ℝ, 0 ≤ L → 0 < q →
    (∑ m ∈ S, ∑' k : smoothingResonantStrip L (P m).2,
      w m.1 k.val) ≤
    C * a * (∑ n ∈ S.image Prod.fst, ∑' k : {k : Fin 2 → ℤ | |(k 0 : ℝ)| ≤ q},
      w n k.val) +
    D * (1 + a * L / q) * (∑ n ∈ S.image Prod.fst, ∑' k : Fin 2 → ℤ,
      w n k) := by
  classical
  obtain ⟨C, hC, hcoarse⟩ := smoothingEnlargedInteractionIndices_first_fiber_count hc
  obtain ⟨D, hD, hfine⟩ := smoothingEnlargedIncidence_eq3_21 hc hpos
  refine ⟨C, D, hC, hD, ?_⟩
  intro a ha w hw hs S P hP L q hL hq
  let R := fun m => smoothingResonantStrip L (P m).2
  let U := {k : Fin 2 → ℤ | |(k 0 : ℝ)| ≤ q}
  apply smoothing_localization_energy_separation S (S.image Prod.fst) Prod.fst w R U
    (by positivity : 0 ≤ D * (1 + a * L / q))
    (fun m hm => Finset.mem_image_of_mem _ hm) hw hs
  · intro k _ n _
    let F := S.filter (fun m => k ∈ R m)
    let Q := (F.filter (fun m => m.1 = n)).image Prod.snd
    have hQ : ∀ m ∈ Q, (n, m) ∈ S := by
      intro m hm
      exact (Finset.mem_filter.mp ((smoothing_first_pair_fiber_mem F n m).mp hm)).1
    have hh := hcoarse a ha n Q (fun m hm => ⟨P (n,m), hP (n,m) (hQ m hm)⟩)
    simpa only [Q, smoothing_first_pair_fiber_card, F] using hh
  · intro k hk n _
    have hkq : q < |(k 0 : ℝ)| := lt_of_not_ge hk
    have hk0 : k 0 ≠ 0 := by
      intro hz
      simp only [hz, Int.cast_zero, abs_zero] at hkq
      linarith
    let F := S.filter (fun m => k ∈ R m)
    let Q := (F.filter (fun m => m.1 = n)).image Prod.snd
    have hQ : ∀ m ∈ Q, (n, m) ∈ S ∧ k ∈ R (n, m) := by
      intro m hm
      exact Finset.mem_filter.mp ((smoothing_first_pair_fiber_mem F n m).mp hm)
    have hh := hfine a ha n Q (fun m => P (n, m))
      (fun m hm => hP (n, m) (hQ m hm).1)
      k hk0 L hL (fun m hm => (hQ m hm).2)
    have hdiv : a * L / |(k 0 : ℝ)| ≤ a * L / q := by gcongr
    have hbound := hh.trans (mul_le_mul_of_nonneg_left (add_le_add le_rfl hdiv) hD)
    simpa only [Q, smoothing_first_pair_fiber_card, F] using hbound

/-- The second component of the low-coordinate-frequency separation after
(3.23), with the actual second-input energies and denominator frequency k₂,₂. -/
theorem smoothingEnlargedIncidence_low_high_energy_second {ζ : (ℝ × ℝ) × ℝ → ℂ}
    (hc : HasCompactSupport ζ) :
    ∃ C D : ℝ, 0 ≤ C ∧ 0 ≤ D ∧ ∀ a : ℝ, 1 ≤ a →
    ∀ w : (Fin 2 → ℤ) → (Fin 2 → ℤ) → ℝ, (∀ n k, 0 ≤ w n k) → (∀ n, Summable (w n)) →
    ∀ (S : Finset ((Fin 2 → ℤ) × (Fin 2 → ℤ)))
      (P : ((Fin 2 → ℤ) × (Fin 2 → ℤ)) → (ℝ × ℝ) × ℝ),
    (∀ m ∈ S, ζ (P m) ≠ 0 ∧
      smoothingEnlargedIncidence a m (P m)) →
    ∀ L q : ℝ, 0 ≤ L → 0 < q →
    (∑ m ∈ S, ∑' k : smoothingResonantStrip L (P m).2,
      w m.2 k.val) ≤
    C * a * (∑ n ∈ S.image Prod.snd, ∑' k : {k : Fin 2 → ℤ | |(k 1 : ℝ)| ≤ q},
      w n k.val) +
    D * (1 + a * L / q) * (∑ n ∈ S.image Prod.snd, ∑' k : Fin 2 → ℤ,
      w n k) := by
  classical
  obtain ⟨C, hC, hcoarse⟩ := smoothingEnlargedInteractionIndices_second_fiber_count hc
  obtain ⟨D, hD, hfine⟩ := smoothingEnlargedIncidence_eq3_23 hc
  refine ⟨C, D, hC, hD, ?_⟩
  intro a ha w hw hs S P hP L q hL hq
  let R := fun m => smoothingResonantStrip L (P m).2
  let U := {k : Fin 2 → ℤ | |(k 1 : ℝ)| ≤ q}
  apply smoothing_localization_energy_separation S (S.image Prod.snd) Prod.snd w R U
    (by positivity : 0 ≤ D * (1 + a * L / q))
    (fun m hm => Finset.mem_image_of_mem _ hm) hw hs
  · intro k _ n _
    let F := S.filter (fun m => k ∈ R m)
    let Q := (F.filter (fun m => m.2 = n)).image Prod.fst
    have hQ : ∀ m ∈ Q, (m, n) ∈ S := by
      intro m hm
      exact (Finset.mem_filter.mp ((smoothing_second_pair_fiber_mem F n m).mp hm)).1
    have hh := hcoarse a ha n Q (fun m hm => ⟨P (m,n), hP (m,n) (hQ m hm)⟩)
    simpa only [Q, smoothing_second_pair_fiber_card, F] using hh
  · intro k hk n _
    have hkq : q < |(k 1 : ℝ)| := lt_of_not_ge hk
    have hk0 : k 1 ≠ 0 := by
      intro hz
      simp only [hz, Int.cast_zero, abs_zero] at hkq
      linarith
    let F := S.filter (fun m => k ∈ R m)
    let Q := (F.filter (fun m => m.2 = n)).image Prod.fst
    have hQ : ∀ m ∈ Q, (m, n) ∈ S ∧ k ∈ R (m, n) := by
      intro m hm
      exact Finset.mem_filter.mp ((smoothing_second_pair_fiber_mem F n m).mp hm)
    have hh := hfine a ha n Q (fun m => P (m, n))
      (fun m hm => hP (m, n) (hQ m hm).1)
      k hk0 L hL (fun m hm => (hQ m hm).2)
    have hdiv : a * L / |(k 1 : ℝ)| ≤ a * L / q := by gcongr
    have hbound := hh.trans (mul_le_mul_of_nonneg_left (add_le_add le_rfl hdiv) hD)
    simpa only [Q, smoothing_second_pair_fiber_card, F] using hbound

/-- Restricting a nonnegative summable coefficient energy to a frequency
set preserves integrability and decreases its integral. -/
theorem smoothing_subtype_energy_integrable {κ : Type*} [Countable κ]
    (w : ℝ → κ → ℝ) (μ : Measure ℝ)
    (hw : ∀ s k, 0 ≤ w s k) (hm : ∀ k, Measurable (fun s => w s k))
    (hs : ∀ s, Summable (w s)) (hi : Integrable (fun s => ∑' k, w s k) μ)
    (U : Set κ) :
    Integrable (fun s => ∑' k : U, w s k.val) μ ∧
    (∫ s, ∑' k : U, w s k.val ∂μ) ≤ ∫ s, ∑' k, w s k ∂μ := by
  have hb : ∀ s, (∑' k : U, w s k.val) ≤ ∑' k, w s k :=
    fun s => Summable.tsum_subtype_le (w s) U (hw s) (hs s)
  have hsub : Measurable (fun s => ∑' k : U, w s k.val) :=
    Measurable.tsum (fun k => hm k.val)
  have hsubi : Integrable (fun s => ∑' k : U, w s k.val) μ :=
    hi.mono' hsub.aestronglyMeasurable (Filter.Eventually.of_forall (fun s => by
      rw [Real.norm_eq_abs, abs_of_nonneg (tsum_nonneg (fun k : U => hw s k.val))]
      exact hb s))
  exact ⟨hsubi, integral_mono hsubi hi hb⟩

/-- Integrate the first-input spatial separation following (3.23).
Only summable nonnegative energies and their genuine integrability are used. -/
theorem smoothingEnlargedIncidence_integrated_low_high_first
    {ζ : (ℝ × ℝ) × ℝ → ℂ} (hc : HasCompactSupport ζ)
    (hpos : ∀ p ∈ tsupport ζ, 0 < p.2) :
    ∃ C D : ℝ, 0 ≤ C ∧ 0 ≤ D ∧ ∀ a : ℝ, 1 ≤ a →
    ∀ (w : (Fin 2 → ℤ) → ℝ → (Fin 2 → ℤ) → ℝ) (μ : Measure ℝ),
    (∀ n s k, 0 ≤ w n s k) → (∀ n k, Measurable (fun s => w n s k)) →
    (∀ n s, Summable (w n s)) →
    (∀ n, Integrable (fun s => ∑' k, w n s k) μ) →
    ∀ (S : Finset ((Fin 2 → ℤ) × (Fin 2 → ℤ)))
      (P : ((Fin 2 → ℤ) × (Fin 2 → ℤ)) → (ℝ × ℝ) × ℝ),
    (∀ m ∈ S, ζ (P m) ≠ 0 ∧ smoothingEnlargedIncidence a m (P m)) →
    ∀ L q : ℝ, 0 ≤ L → 0 < q →
    Integrable (fun s => ∑ m ∈ S, ∑' k : smoothingResonantStrip L (P m).2, w m.1 s k.val) μ ∧
    (∫ s, ∑ m ∈ S, ∑' k : smoothingResonantStrip L (P m).2, w m.1 s k.val ∂μ) ≤
      C*a*(∑ n ∈ S.image Prod.fst, ∫ s, ∑' k : {k : Fin 2 → ℤ | |(k 0 : ℝ)| ≤ q}, w n s k.val ∂μ) +
      D*(1+a*L/q)*(∑ n ∈ S.image Prod.fst, ∫ s, ∑' k, w n s k ∂μ) := by
  classical
  obtain ⟨C,D,hC,hD,hbound⟩ := smoothingEnlargedIncidence_low_high_energy_first hc hpos
  refine ⟨C,D,hC,hD,?_⟩
  intro a ha w μ hw hm hs hi S P hP L q hL hq
  have hu (n : Fin 2 → ℤ) (U : Set (Fin 2 → ℤ)) :=
    (smoothing_subtype_energy_integrable (w n) μ (hw n) (hm n) (hs n) (hi n) U).1
  have he := integrable_finsetSum S (fun m _ => hu m.1 (smoothingResonantStrip L (P m).2))
  have hlo := integrable_finsetSum (S.image Prod.fst)
    (fun n _ => hu n {k : Fin 2 → ℤ | |(k 0 : ℝ)| ≤ q})
  have hfull := integrable_finsetSum (S.image Prod.fst) (fun n _ => hi n)
  refine ⟨he, ?_⟩
  have hb := integral_mono he ((hlo.const_mul (C*a)).add (hfull.const_mul (D*(1+a*L/q))))
    (fun s => hbound a ha (fun n k => w n s k) (fun n => hw n s) (fun n => hs n s) S P hP L q hL hq)
  simp only [Pi.add_apply] at hb
  rw [integral_add (hlo.const_mul _) (hfull.const_mul _), integral_const_mul, integral_const_mul,
    integral_finsetSum (S.image Prod.fst) (fun n _ => hu n {k : Fin 2 → ℤ | |(k 0 : ℝ)| ≤ q}),
    integral_finsetSum (S.image Prod.fst) (fun n _ => hi n)] at hb
  exact hb
