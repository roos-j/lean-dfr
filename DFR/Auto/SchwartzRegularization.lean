/-- Bounded pointwise simple-function approximation passes through the
regularizer at every point, with a fixed compact cutoff and kernel. -/
theorem smoothingSimpleRegularizer_tendsto
    (κ χ : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℂ)
    (hκ : HasCompactSupport κ) (hχ : HasCompactSupport χ) (hχb : ∀ x, ‖χ x‖ ≤ 1)
    (f : ℕ → SimpleFunc (EuclideanSpace ℝ (Fin 2)) ℂ)
    (F : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℂ) {M : ℝ}
    (hf : ∀ n x, ‖f n x‖ ≤ M)
    (hlim : ∀ x, Filter.Tendsto (fun n => f n x) Filter.atTop (nhds (F x)))
    (x : EuclideanSpace ℝ (Fin 2)) :
    Filter.Tendsto (fun n => smoothingSimpleRegularizer κ χ hκ hχ (f n) x)
      Filter.atTop (nhds (smoothingSchwartzRegularizer κ χ F x)) := by
  simp_rw [smoothingSimpleRegularizer_apply,smoothingSchwartzRegularizer_apply]
  apply tendsto_integral_of_dominated_convergence (fun y => M*‖κ (x-y)‖)
  · intro n
    exact ((χ.continuous.measurable.mul (f n).measurable).mul
      (κ.continuous.measurable.comp (measurable_const.sub measurable_id))).aestronglyMeasurable
  · exact (κ.integrable.comp_sub_left x).norm.const_mul M
  · intro n
    filter_upwards [] with y
    rw [norm_mul,norm_mul]
    apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
    exact ((mul_le_mul_of_nonneg_right (hχb y) (norm_nonneg _)).trans_eq (one_mul _)).trans (hf n y)
  · filter_upwards [] with y
    exact (Filter.Tendsto.const_mul (χ y) (hlim y)).mul_const _

