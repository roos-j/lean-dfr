/-- The standard zero-preserving simple approximation of a Schwartz input. -/
def smoothingSimpleApproximation
    (f : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℂ) (n : ℕ) :
    SimpleFunc (EuclideanSpace ℝ (Fin 2)) ℂ :=
  SimpleFunc.approxOn f f.continuous.measurable Set.univ 0 (Set.mem_univ 0) n

theorem smoothingSimpleApproximation_bound
    (f : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℂ) (n : ℕ) (x : EuclideanSpace ℝ (Fin 2)) :
    ‖smoothingSimpleApproximation f n x‖ ≤ 2*‖f x‖ := by
  simpa only [smoothingSimpleApproximation,two_mul] using
    SimpleFunc.norm_approxOn_zero_le f.continuous.measurable (Set.mem_univ (0:ℂ)) x n

theorem smoothingSimpleApproximation_integrable
    (f : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℂ) (n : ℕ) :
    Integrable (smoothingSimpleApproximation f n : EuclideanSpace ℝ (Fin 2) → ℂ) :=
  (f.integrable.norm.const_mul 2).mono' (smoothingSimpleApproximation f n).aestronglyMeasurable
    (Filter.Eventually.of_forall (smoothingSimpleApproximation_bound f n))

