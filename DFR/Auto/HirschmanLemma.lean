    ∫ t : ℝ, poissonStrip θ (-1) t = θ := by
  have hθ' : (1 - θ) ∈ Ioo (0 : ℝ) 1 := ⟨by linarith [hθ.2], by linarith [hθ.1]⟩
  simp only [poissonStrip_reflect]
  rw [integral_poissonStrip_one hθ']
  ring

