    refine (Real.continuous_arctan.tendsto _).comp ?_
    simpa using hratioTop.const_mul (Real.cos (π * θ / 2) / Real.sin (π * θ / 2))
  have hbotF : Filter.Tendsto (poissonStripPrimitive θ) Filter.atBot
      (nhds (π⁻¹ * -(π / 2 - π * θ / 2))) := by
    rw [hPeq, ← hval, ← Real.arctan_neg]
    refine Filter.Tendsto.const_mul _ ?_
    refine (Real.continuous_arctan.tendsto _).comp ?_
    have := hratioBot.const_mul (Real.cos (π * θ / 2) / Real.sin (π * θ / 2))
    simpa using this
  have hres := integral_of_hasDerivAt_of_tendsto (hasDerivAt_poissonStripPrimitive hθ) hint
    hbotF htopF
  rw [hres]
