/-! ### The harmonic measure densities of the strip -/

/-- The two boundary densities of the harmonic measure of the strip `0 < re z < 1` seen from the
interior point `θ`, written with a sign parameter: `σ = 1` gives the density `w₀` on the edge
`re z = 0` and `σ = -1` gives the density `w₁` on the edge `re z = 1`. -/
noncomputable def poissonStrip (θ σ t : ℝ) : ℝ :=
  Real.sin (π * θ) / (2 * (Real.cosh (π * t) - σ * Real.cos (π * θ)))

/-- The density carried by the edge `re z = 0`. -/
noncomputable def poissonStripLeft (θ t : ℝ) : ℝ := poissonStrip θ 1 t

/-- The density carried by the edge `re z = 1`. -/
noncomputable def poissonStripRight (θ t : ℝ) : ℝ := poissonStrip θ (-1) t

/-! ### Elementary estimates -/

/-- The quadratic lower bound `1 + x²/4 ≤ cosh x`, from the second-order Taylor bound for `exp`
on the positive axis together with `1 - y ≤ exp (-y)`. -/
theorem one_add_sq_div_four_le_cosh (x : ℝ) : 1 + x ^ 2 / 4 ≤ Real.cosh x := by
  have hy : (0 : ℝ) ≤ |x| := abs_nonneg x
  have h1 : 1 + |x| + |x| ^ 2 / 2 ≤ Real.exp |x| := Real.quadratic_le_exp_of_nonneg hy
  have h2 : 1 - |x| ≤ Real.exp (-|x|) := by
    have := Real.add_one_le_exp (-|x|)
    linarith
  have hsq : |x| ^ 2 = x ^ 2 := sq_abs x
  have hc : Real.cosh |x| = (Real.exp |x| + Real.exp (-|x|)) / 2 := Real.cosh_eq _
  have habs : Real.cosh |x| = Real.cosh x := Real.cosh_abs x
  rw [← habs, hc]
  nlinarith [h1, h2, hsq]

/-- For `θ ∈ (0,1)` the angle `π θ` lies strictly between `0` and `π`. -/
theorem pi_mul_mem_Ioo {θ : ℝ} (hθ : θ ∈ Ioo (0 : ℝ) 1) : π * θ ∈ Ioo (0 : ℝ) π := by
  obtain ⟨h0, h1⟩ := hθ
  exact ⟨mul_pos Real.pi_pos h0, by nlinarith [Real.pi_pos]⟩

/-- For `θ ∈ (0,1)` the cosine factor is strictly less than one in absolute value. -/
theorem abs_cos_pi_mul_lt_one {θ : ℝ} (hθ : θ ∈ Ioo (0 : ℝ) 1) :
    |Real.cos (π * θ)| < 1 := by
  obtain ⟨h0, h1⟩ := pi_mul_mem_Ioo hθ
  refine abs_lt.mpr ⟨?_, ?_⟩
  · have := Real.cos_lt_cos_of_nonneg_of_le_pi h0.le le_rfl h1
    rwa [Real.cos_pi] at this
  · have := Real.cos_lt_cos_of_nonneg_of_le_pi le_rfl h1.le h0
    rwa [Real.cos_zero] at this

/-- For `θ ∈ (0,1)` the numerator `sin (π θ)` is positive. -/
theorem sin_pi_mul_pos {θ : ℝ} (hθ : θ ∈ Ioo (0 : ℝ) 1) : 0 < Real.sin (π * θ) := by
  obtain ⟨h0, h1⟩ := pi_mul_mem_Ioo hθ
  exact Real.sin_pos_of_pos_of_lt_pi h0 h1

/-- The denominator of `poissonStrip` dominates `1 + t²` up to a positive constant. -/
theorem poissonStrip_denom_lower {θ σ : ℝ} (hθ : θ ∈ Ioo (0 : ℝ) 1) (hσ : |σ| ≤ 1) (t : ℝ) :
    min (1 - |Real.cos (π * θ)|) (π ^ 2 / 4) * (1 + t ^ 2)
      ≤ Real.cosh (π * t) - σ * Real.cos (π * θ) := by
  have hc : |Real.cos (π * θ)| < 1 := abs_cos_pi_mul_lt_one hθ
  have hσc : σ * Real.cos (π * θ) ≤ |Real.cos (π * θ)| := by
    calc σ * Real.cos (π * θ) ≤ |σ * Real.cos (π * θ)| := le_abs_self _
      _ = |σ| * |Real.cos (π * θ)| := abs_mul _ _
      _ ≤ 1 * |Real.cos (π * θ)| :=
          mul_le_mul_of_nonneg_right hσ (abs_nonneg _)
      _ = |Real.cos (π * θ)| := one_mul _
  have hcosh : 1 + (π * t) ^ 2 / 4 ≤ Real.cosh (π * t) := one_add_sq_div_four_le_cosh _
  have hm1 : min (1 - |Real.cos (π * θ)|) (π ^ 2 / 4) ≤ 1 - |Real.cos (π * θ)| :=
    min_le_left _ _
  have hm2 : min (1 - |Real.cos (π * θ)|) (π ^ 2 / 4) ≤ π ^ 2 / 4 := min_le_right _ _
  nlinarith [sq_nonneg t, hm1, hm2]

/-- The constant appearing in the domination is positive. -/
theorem poissonStrip_kappa_pos {θ : ℝ} (hθ : θ ∈ Ioo (0 : ℝ) 1) :
    0 < min (1 - |Real.cos (π * θ)|) (π ^ 2 / 4) :=
  lt_min (by linarith [abs_cos_pi_mul_lt_one hθ]) (by positivity)

/-- The denominator of `poissonStrip` is positive. -/
theorem poissonStrip_denom_pos {θ σ : ℝ} (hθ : θ ∈ Ioo (0 : ℝ) 1) (hσ : |σ| ≤ 1) (t : ℝ) :
    0 < Real.cosh (π * t) - σ * Real.cos (π * θ) := by
  refine lt_of_lt_of_le ?_ (poissonStrip_denom_lower hθ hσ t)
  have := poissonStrip_kappa_pos hθ
  positivity

/-- `poissonStrip` is nonnegative, and positive for `θ ∈ (0,1)`. -/
theorem poissonStrip_pos {θ σ : ℝ} (hθ : θ ∈ Ioo (0 : ℝ) 1) (hσ : |σ| ≤ 1) (t : ℝ) :
    0 < poissonStrip θ σ t := by
  have hsin : 0 < Real.sin (π * θ) := sin_pi_mul_pos hθ
  have hden := poissonStrip_denom_pos hθ hσ t
  rw [poissonStrip]
  positivity

/-- `poissonStrip` is continuous in the boundary coordinate. -/
theorem continuous_poissonStrip {θ σ : ℝ} (hθ : θ ∈ Ioo (0 : ℝ) 1) (hσ : |σ| ≤ 1) :
    Continuous fun t : ℝ => poissonStrip θ σ t := by
  refine continuous_const.div ?_ ?_
  · exact continuous_const.mul
      ((Real.continuous_cosh.comp (continuous_const.mul continuous_id)).sub continuous_const)
  · intro t
    have := poissonStrip_denom_pos hθ hσ t
    positivity

/-- `poissonStrip` is dominated by a constant multiple of `(1 + t²)⁻¹`, hence integrable. -/
theorem integrable_poissonStrip {θ σ : ℝ} (hθ : θ ∈ Ioo (0 : ℝ) 1) (hσ : |σ| ≤ 1) :
    Integrable fun t : ℝ => poissonStrip θ σ t := by
  set κ : ℝ := min (1 - |Real.cos (π * θ)|) (π ^ 2 / 4) with hκdef
  have hκ : 0 < κ := poissonStrip_kappa_pos hθ
  have hsin : 0 ≤ Real.sin (π * θ) := (sin_pi_mul_pos hθ).le
  refine Integrable.mono' (g := fun t : ℝ => Real.sin (π * θ) / (2 * κ) * (1 + t ^ 2)⁻¹)
    (integrable_inv_one_add_sq.const_mul _)
    (continuous_poissonStrip hθ hσ).aestronglyMeasurable ?_
  filter_upwards with t
  have hden := poissonStrip_denom_pos hθ hσ t
  have hlow := poissonStrip_denom_lower hθ hσ t
  have hpos : (0 : ℝ) < 1 + t ^ 2 := by positivity
  have hrhs : Real.sin (π * θ) / (2 * κ) * (1 + t ^ 2)⁻¹
      = Real.sin (π * θ) / (2 * (κ * (1 + t ^ 2))) := by
    field_simp
  rw [Real.norm_eq_abs, poissonStrip, abs_of_nonneg (by positivity), hrhs]
  gcongr

/-! ### The total masses of the two densities

`w₀` has mass `1 - θ` and `w₁` has mass `θ`.  The primitive is
`t ↦ π⁻¹ arctan (cot (π θ / 2) tanh (π t / 2))`, whose limits at `±∞` are
`±(1 - θ)/2`. -/

theorem tendsto_sinh_div_cosh_atTop :
    Filter.Tendsto (fun x : ℝ => Real.sinh x / Real.cosh x) Filter.atTop (nhds 1) := by
  have key : ∀ x : ℝ, Real.sinh x / Real.cosh x
      = (1 - Real.exp (-(2 * x))) / (1 + Real.exp (-(2 * x))) := by
    intro x
    have hpos : (0 : ℝ) < Real.exp x := Real.exp_pos x
    have hneg : Real.exp (-x) = (Real.exp x)⁻¹ := Real.exp_neg x
    have h2 : Real.exp (-(2 * x)) = (Real.exp x)⁻¹ * (Real.exp x)⁻¹ := by
      rw [show -(2 * x) = -x + -x by ring, Real.exp_add, hneg]
    rw [Real.sinh_eq, Real.cosh_eq, hneg, h2]
    field_simp
  have hexp : Filter.Tendsto (fun x : ℝ => Real.exp (-(2 * x))) Filter.atTop (nhds 0) := by
    refine Real.tendsto_exp_atBot.comp ?_
    exact Filter.tendsto_neg_atTop_atBot.comp
      (Filter.tendsto_id.const_mul_atTop (by norm_num : (0 : ℝ) < 2))
  have hlim : Filter.Tendsto
      (fun x : ℝ => (1 - Real.exp (-(2 * x))) / (1 + Real.exp (-(2 * x))))
      Filter.atTop (nhds ((1 - 0) / (1 + 0))) :=
    (tendsto_const_nhds.sub hexp).div (tendsto_const_nhds.add hexp) (by norm_num)
  norm_num at hlim
  simpa only [key] using hlim

theorem tendsto_sinh_div_cosh_atBot :
    Filter.Tendsto (fun x : ℝ => Real.sinh x / Real.cosh x) Filter.atBot (nhds (-1)) := by
  have h := tendsto_sinh_div_cosh_atTop.comp Filter.tendsto_neg_atBot_atTop
  have hfun : ((fun x : ℝ => Real.sinh x / Real.cosh x) ∘ (fun x : ℝ => -x))
      = fun x : ℝ => -(Real.sinh x / Real.cosh x) := by
    funext x
    simp only [Function.comp_apply, Real.sinh_neg, Real.cosh_neg]
    ring
  rw [hfun] at h
  simpa using h.neg

/-- The primitive of the density `w₀` of `poissonStrip θ 1`. -/
noncomputable def poissonStripPrimitive (θ t : ℝ) : ℝ :=
  π⁻¹ * Real.arctan (Real.cos (π * θ / 2) * Real.sinh (π * t / 2)
    / (Real.sin (π * θ / 2) * Real.cosh (π * t / 2)))

theorem sin_cos_half_pos {θ : ℝ} (hθ : θ ∈ Ioo (0 : ℝ) 1) :
    0 < Real.sin (π * θ / 2) ∧ 0 < Real.cos (π * θ / 2) := by
  obtain ⟨h0, h1⟩ := hθ
  have hpi := Real.pi_pos
  have hlow : 0 < π * θ / 2 := by positivity
  have hhigh : π * θ / 2 < π / 2 := by nlinarith
  exact ⟨Real.sin_pos_of_pos_of_lt_pi hlow (by linarith),
    Real.cos_pos_of_mem_Ioo ⟨by linarith, hhigh⟩⟩

theorem hasDerivAt_poissonStripPrimitive {θ : ℝ} (hθ : θ ∈ Ioo (0 : ℝ) 1) (t : ℝ) :
    HasDerivAt (poissonStripPrimitive θ) (poissonStrip θ 1 t) t := by
  obtain ⟨hs, hc⟩ := sin_cos_half_pos hθ
  set s : ℝ := Real.sin (π * θ / 2) with hsdef
  set c : ℝ := Real.cos (π * θ / 2) with hcdef
  set S : ℝ := Real.sinh (π * t / 2) with hSdef
  set C : ℝ := Real.cosh (π * t / 2) with hCdef
  have hC : 0 < C := by rw [hCdef]; exact Real.cosh_pos _
  have hC1 : 1 ≤ C := by rw [hCdef]; exact Real.one_le_cosh _
  have hinner : HasDerivAt (fun u : ℝ => π * u / 2) (π / 2) t := by
    simpa using ((hasDerivAt_id t).const_mul π).div_const 2
  have hSd : HasDerivAt (fun u : ℝ => Real.sinh (π * u / 2)) (C * (π / 2)) t :=
    (Real.hasDerivAt_sinh _).comp t hinner
  have hCd : HasDerivAt (fun u : ℝ => Real.cosh (π * u / 2)) (S * (π / 2)) t :=
    (Real.hasDerivAt_cosh _).comp t hinner
  have hnum : HasDerivAt (fun u : ℝ => c * Real.sinh (π * u / 2)) (c * (C * (π / 2))) t :=
    hSd.const_mul c
  have hden : HasDerivAt (fun u : ℝ => s * Real.cosh (π * u / 2)) (s * (S * (π / 2))) t :=
    hCd.const_mul s
  have hdenne : s * C ≠ 0 := by positivity
  have hq := hnum.div hden hdenne
  have harc := (Real.hasDerivAt_arctan (c * S / (s * C))).comp t hq
  have hfin := harc.const_mul π⁻¹
  have hsq : C ^ 2 - S ^ 2 = 1 := by rw [hCdef, hSdef]; exact Real.cosh_sq_sub_sinh_sq _
  have hpy : s ^ 2 + c ^ 2 = 1 := by rw [hsdef, hcdef]; exact Real.sin_sq_add_cos_sq _
  have h2 := Real.cosh_two_mul (π * t / 2)
  rw [show 2 * (π * t / 2) = π * t by ring] at h2
  have hcoshtwo : Real.cosh (π * t) = 2 * C ^ 2 - 1 := by
    rw [h2, ← hCdef, ← hSdef]; linarith [hsq]
  have h3 := Real.cos_two_mul (π * θ / 2)
  rw [show 2 * (π * θ / 2) = π * θ by ring] at h3
  have hcostwo : Real.cos (π * θ) = 1 - 2 * s ^ 2 := by
    rw [h3, ← hcdef]; linarith [hpy]
  have h4 := Real.sin_two_mul (π * θ / 2)
  rw [show 2 * (π * θ / 2) = π * θ by ring] at h4
  have hsintwo : Real.sin (π * θ) = 2 * s * c := by rw [h4, ← hsdef, ← hcdef]
  have hpos : 0 < C ^ 2 + s ^ 2 - 1 := by nlinarith [hC1, hs]
  have hden2 : s ^ 2 * C ^ 2 + c ^ 2 * S ^ 2 = C ^ 2 + s ^ 2 - 1 := by nlinarith [hsq, hpy]
  have hkey : π⁻¹ * (1 / (1 + (c * S / (s * C)) ^ 2)
      * ((c * (C * (π / 2)) * (s * C) - c * S * (s * (S * (π / 2)))) / (s * C) ^ 2))
      = poissonStrip θ 1 t := by
    rw [poissonStrip, hcoshtwo, hcostwo, hsintwo]
    have hpi : π ≠ 0 := Real.pi_pos.ne'
    have hd2 : (0 : ℝ) < s ^ 2 * C ^ 2 + c ^ 2 * S ^ 2 := by rw [hden2]; exact hpos
    have h1 : 1 + (c * S / (s * C)) ^ 2 = (s ^ 2 * C ^ 2 + c ^ 2 * S ^ 2) / (s ^ 2 * C ^ 2) := by
      field_simp
    have hnm : c * (C * (π / 2)) * (s * C) - c * S * (s * (S * (π / 2)))
        = π / 2 * (c * s) * (C ^ 2 - S ^ 2) := by ring
    rw [h1, hnm, hsq, hden2]
    have hrhs : 2 * (2 * C ^ 2 - 1 - 1 * (1 - 2 * s ^ 2)) = 4 * (C ^ 2 + s ^ 2 - 1) := by ring
    rw [hrhs]
    field_simp
    ring
  rw [← hkey]
  exact hfin

