theorem poissonStrip_reflect (θ t : ℝ) : poissonStrip θ (-1) t = poissonStrip (1 - θ) 1 t := by
  have hs : Real.sin (π * (1 - θ)) = Real.sin (π * θ) := by
    rw [show π * (1 - θ) = π - π * θ by ring, Real.sin_pi_sub]
  have hc : Real.cos (π * (1 - θ)) = -Real.cos (π * θ) := by
    rw [show π * (1 - θ) = π - π * θ by ring, Real.cos_pi_sub]
  rw [poissonStrip, poissonStrip, hs, hc]
  ring_nf

