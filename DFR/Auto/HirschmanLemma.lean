    (Filter.tendsto_id.const_mul_atTop Real.pi_pos).atTop_div_const (by norm_num)
  have hbo : Filter.Tendsto (fun t : ℝ => π * t / 2) Filter.atBot Filter.atBot :=
    (Filter.tendsto_id.const_mul_atBot Real.pi_pos).atBot_div_const (by norm_num)
  have hratioTop : Filter.Tendsto
      (fun t : ℝ => Real.sinh (π * t / 2) / Real.cosh (π * t / 2)) Filter.atTop (nhds 1) :=
    tendsto_sinh_div_cosh_atTop.comp hto
  have hratioBot : Filter.Tendsto
      (fun t : ℝ => Real.sinh (π * t / 2) / Real.cosh (π * t / 2)) Filter.atBot (nhds (-1)) :=
    tendsto_sinh_div_cosh_atBot.comp hbo
  have hrw : (fun t : ℝ => Real.cos (π * θ / 2) * Real.sinh (π * t / 2)
      / (Real.sin (π * θ / 2) * Real.cosh (π * t / 2)))
      = fun t : ℝ => Real.cos (π * θ / 2) / Real.sin (π * θ / 2)
        * (Real.sinh (π * t / 2) / Real.cosh (π * t / 2)) := by
    funext t
    have hC : (0 : ℝ) < Real.cosh (π * t / 2) := Real.cosh_pos _
    field_simp
  have hval : Real.arctan (Real.cos (π * θ / 2) / Real.sin (π * θ / 2))
      = π / 2 - π * θ / 2 := by
    have htan : Real.tan (π * θ / 2) = Real.sin (π * θ / 2) / Real.cos (π * θ / 2) :=
      Real.tan_eq_sin_div_cos _
    have hinv : Real.cos (π * θ / 2) / Real.sin (π * θ / 2)
        = (Real.tan (π * θ / 2))⁻¹ := by
      rw [htan]
      field_simp
    rw [hinv, Real.arctan_inv_of_pos (by rw [htan]; positivity),
      Real.arctan_tan (by nlinarith [Real.pi_pos, hθ.1]) (by nlinarith [Real.pi_pos, hθ.2])]
  have hPeq : poissonStripPrimitive θ = fun t : ℝ => π⁻¹ * Real.arctan
      (Real.cos (π * θ / 2) / Real.sin (π * θ / 2)
        * (Real.sinh (π * t / 2) / Real.cosh (π * t / 2))) := by
    funext t
