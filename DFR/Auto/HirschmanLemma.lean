/-! ### The densities as the push-forward of the half-plane Poisson kernel

The map `φ z = exp (i π z)` carries the strip `0 < re z < 1` conformally onto the upper
half-plane, the edge `re z = 0` onto the positive real axis by `t ↦ exp (-π t)`, and the edge
`re z = 1` onto the negative real axis by `t ↦ -exp (-π t)`.  The interior point `θ` goes to
`exp (i π θ) = cos (π θ) + i sin (π θ)`.  The Poisson kernel of the half-plane at the point
`u + i v` is `π⁻¹ v / ((ξ - u)² + v²)`, so the push-forward of the harmonic measure to the
boundary coordinate `t` is exactly `poissonStrip`.  The identity below records this; it is the
computation on which the harmonic majorization of `lem:scalar-strip` rests. -/

theorem poissonStrip_eq_halfPlane {θ σ : ℝ} (hθ : θ ∈ Ioo (0 : ℝ) 1) (hσ : σ = 1 ∨ σ = -1)
    (t : ℝ) :
    poissonStrip θ σ t
      = Real.exp (-(π * t)) * Real.sin (π * θ)
        / ((σ * Real.exp (-(π * t)) - Real.cos (π * θ)) ^ 2 + Real.sin (π * θ) ^ 2) := by
  have hσabs : |σ| ≤ 1 := by rcases hσ with rfl | rfl <;> norm_num
  have hE : (0 : ℝ) < Real.exp (-(π * t)) := Real.exp_pos _
  have hinv : Real.exp (-(π * t)) * Real.exp (π * t) = 1 := by
    rw [← Real.exp_add]
    simp
  have hcosh : Real.cosh (π * t) = (Real.exp (π * t) + Real.exp (-(π * t))) / 2 :=
    Real.cosh_eq _
  have hpy : Real.sin (π * θ) ^ 2 + Real.cos (π * θ) ^ 2 = 1 := Real.sin_sq_add_cos_sq _
  have hD : (0 : ℝ) < 2 * (Real.cosh (π * t) - σ * Real.cos (π * θ)) := by
    have := poissonStrip_denom_pos hθ hσabs t
    linarith
  have hden : (σ * Real.exp (-(π * t)) - Real.cos (π * θ)) ^ 2 + Real.sin (π * θ) ^ 2
      = Real.exp (-(π * t)) * (2 * (Real.cosh (π * t) - σ * Real.cos (π * θ))) := by
    rw [hcosh]
    rcases hσ with rfl | rfl <;> nlinarith [hinv, hpy, hE]
  rw [poissonStrip, hden]
  field_simp

/-! ### Jensen's inequality for the boundary averages

The last step of `lem:scalar-strip` passes from the additive (logarithmic) majorization to the
multiplicative statement by Jensen's inequality applied to the concave function `log`, against
the normalized densities.  It is convenient to record it in the equivalent convex form for
`exp`. -/

open MeasureTheory in
/-- Jensen's inequality for `exp` against a probability measure: the exponential of the mean is at
most the mean of the exponential. -/
theorem exp_integral_le_integral_exp {α : Type*} [MeasurableSpace α] {μ : Measure α}
    [IsProbabilityMeasure μ] {h : α → ℝ} (hi : Integrable h μ)
    (hei : Integrable (fun x => Real.exp (h x)) μ) :
    Real.exp (∫ x, h x ∂μ) ≤ ∫ x, Real.exp (h x) ∂μ := by
  have hav := ConvexOn.map_average_le convexOn_exp Real.continuous_exp.continuousOn isClosed_univ
    (Filter.Eventually.of_forall fun _ => Set.mem_univ _) hi hei
  simpa only [average_eq_integral, Function.comp_def] using hav

open MeasureTheory in
/-- Jensen's inequality in geometric-mean form: for a positive integrable `f` with integrable
logarithm, the mean of `log f` is at most the logarithm of the mean of `f`. -/
theorem integral_log_le_log_integral {α : Type*} [MeasurableSpace α] {μ : Measure α}
    [IsProbabilityMeasure μ] {f : α → ℝ} (hpos : ∀ x, 0 < f x)
    (hi : Integrable f μ) (hli : Integrable (fun x => Real.log (f x)) μ) :
    ∫ x, Real.log (f x) ∂μ ≤ Real.log (∫ x, f x ∂μ) := by
  have hexp : (fun x => Real.exp (Real.log (f x))) = f := by
    funext x
    exact Real.exp_log (hpos x)
  have h := exp_integral_le_integral_exp hli (by rw [hexp]; exact hi)
  rw [hexp] at h
  calc ∫ x, Real.log (f x) ∂μ
      = Real.log (Real.exp (∫ x, Real.log (f x) ∂μ)) := (Real.log_exp _).symm
    _ ≤ Real.log (∫ x, f x ∂μ) := Real.log_le_log (Real.exp_pos _) h

/-! ### The complex Herglotz kernel of the strip

The densities `poissonStrip` are the imaginary parts of a kernel that is analytic in the interior
variable.  This is what turns the harmonic majorization into a statement about an analytic
function, to which `PhragmenLindelof.vertical_strip` applies: its growth hypothesis for the strip
`0 < re z < 1` is exactly `c < π`, the hypothesis of `lem:scalar-strip`. -/

/-- The Herglotz kernel of the strip in the boundary coordinate `t`, pulled back from the upper
half-plane along `z ↦ exp (i π z)`.  For `σ = 1` it carries the edge `re z = 0` and for `σ = -1`
the edge `re z = 1`. -/
noncomputable def stripKernel (σ t : ℝ) (z : ℂ) : ℂ :=
  (Real.exp (-(π * t)) : ℂ)
    / ((σ * Real.exp (-(π * t)) : ℝ) - Complex.exp (↑π * z * Complex.I))

theorem exp_pi_mul_I_re (z : ℂ) : (↑π * z * Complex.I).re = -(π * z.im) := by
  simp

theorem exp_pi_mul_I_im (z : ℂ) : (↑π * z * Complex.I).im = π * z.re := by
  simp

/-- The image of the strip under `z ↦ exp (i π z)` lies in the open upper half-plane. -/
theorem im_exp_pi_mul_I_pos {z : ℂ} (hz : z.re ∈ Ioo (0 : ℝ) 1) :
    0 < (Complex.exp (↑π * z * Complex.I)).im := by
  rw [Complex.exp_im, exp_pi_mul_I_re, exp_pi_mul_I_im]
  have hsin : 0 < Real.sin (π * z.re) := sin_pi_mul_pos hz
  positivity

/-- The denominator of the Herglotz kernel does not vanish on the open strip. -/
theorem stripKernel_denom_ne_zero {σ t : ℝ} {z : ℂ} (hz : z.re ∈ Ioo (0 : ℝ) 1) :
    ((σ * Real.exp (-(π * t)) : ℝ) : ℂ) - Complex.exp (↑π * z * Complex.I) ≠ 0 := by
  intro h
  have him := congrArg Complex.im h
  rw [Complex.sub_im, Complex.ofReal_im, Complex.zero_im, zero_sub, neg_eq_zero] at him
  exact absurd him (im_exp_pi_mul_I_pos hz).ne'

/-- The kernel is analytic in the interior variable on the open strip. -/
theorem differentiableAt_stripKernel {σ t : ℝ} {z : ℂ} (hz : z.re ∈ Ioo (0 : ℝ) 1) :
    DifferentiableAt ℂ (stripKernel σ t) z :=
  DifferentiableAt.div (by fun_prop) (by fun_prop) (stripKernel_denom_ne_zero hz)

theorem re_exp_pi_mul_I_ofReal (θ : ℝ) :
    (Complex.exp (↑π * (θ : ℂ) * Complex.I)).re = Real.cos (π * θ) := by
  rw [Complex.exp_re, exp_pi_mul_I_re, exp_pi_mul_I_im]
  simp

theorem im_exp_pi_mul_I_ofReal (θ : ℝ) :
    (Complex.exp (↑π * (θ : ℂ) * Complex.I)).im = Real.sin (π * θ) := by
  rw [Complex.exp_im, exp_pi_mul_I_re, exp_pi_mul_I_im]
  simp

/-- The imaginary part of the Herglotz kernel at a real interior point is the density
`poissonStrip`.  With `poissonStrip_eq_halfPlane` this identifies `poissonStrip` as the
push-forward of the Poisson kernel of the half-plane. -/
theorem im_stripKernel {θ σ : ℝ} (hθ : θ ∈ Ioo (0 : ℝ) 1) (hσ : σ = 1 ∨ σ = -1) (t : ℝ) :
    (stripKernel σ t (θ : ℂ)).im = poissonStrip θ σ t := by
  have hre : (((σ * Real.exp (-(π * t)) : ℝ) : ℂ)
      - Complex.exp (↑π * (θ : ℂ) * Complex.I)).re
      = σ * Real.exp (-(π * t)) - Real.cos (π * θ) := by
    rw [Complex.sub_re, Complex.ofReal_re, re_exp_pi_mul_I_ofReal]
  have him : (((σ * Real.exp (-(π * t)) : ℝ) : ℂ)
      - Complex.exp (↑π * (θ : ℂ) * Complex.I)).im = -Real.sin (π * θ) := by
    rw [Complex.sub_im, Complex.ofReal_im, im_exp_pi_mul_I_ofReal, zero_sub]
  have hns : Complex.normSq (((σ * Real.exp (-(π * t)) : ℝ) : ℂ)
      - Complex.exp (↑π * (θ : ℂ) * Complex.I))
      = (σ * Real.exp (-(π * t)) - Real.cos (π * θ)) ^ 2 + Real.sin (π * θ) ^ 2 := by
    rw [Complex.normSq_apply, hre, him]
    ring
  rw [stripKernel, Complex.div_im, hre, him, hns, poissonStrip_eq_halfPlane hθ hσ t,
    Complex.ofReal_im, Complex.ofReal_re]
  ring

/-! ### The maximum principle under the admissible growth of `lem:scalar-strip`

The blueprint's growth hypothesis `|H(z)| ≤ exp (C exp (c |Im z|))` with `c < π` is exactly the
hypothesis of `PhragmenLindelof.vertical_strip` for the strip `0 < re z < 1`, whose threshold is
`π / (1 - 0)`.  The statement below converts the blueprint's pointwise bound into the
`IsBigO` form the Mathlib lemma expects. -/

open Complex in
/-- Maximum principle on the closed strip `0 ≤ re z ≤ 1` for functions of admissible growth.
This is the form in which `lem:scalar-strip` uses the Phragmen-Lindelöf principle. -/
theorem norm_le_of_strip_growth {G : ℂ → ℂ} {c B C : ℝ} (hc : c < π)
    (hd : DiffContOnCl ℂ G (Complex.re ⁻¹' Ioo (0 : ℝ) 1))
    (hgrow : ∀ z : ℂ, z.re ∈ Ioo (0 : ℝ) 1 → ‖G z‖ ≤ Real.exp (B * Real.exp (c * |z.im|)))
    (h0 : ∀ z : ℂ, z.re = 0 → ‖G z‖ ≤ C) (h1 : ∀ z : ℂ, z.re = 1 → ‖G z‖ ≤ C)
    {z : ℂ} (hz : z.re ∈ Icc (0 : ℝ) 1) : ‖G z‖ ≤ C := by
  refine PhragmenLindelof.vertical_strip hd ⟨c, by simpa using hc, B, ?_⟩ h0 h1 hz.1 hz.2
  refine Asymptotics.IsBigO.of_bound 1 ?_
  rw [Filter.eventually_inf_principal]
  filter_upwards with w hw
  rw [one_mul, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
  exact hgrow w hw

/-! ### The kernel at a general interior point

The Poisson kernel of the strip is invariant under vertical translation: at the interior point
`z = x + i y` it is the density at the real point `x`, translated by `y` in the boundary
coordinate.  Positivity, continuity and integrability in `t` therefore come for free from the
results already proved for `poissonStrip`. -/

/-- The algebraic identity behind the translation invariance. -/
theorem strip_denom_identity {σ E F c s : ℝ} (hσ : σ ^ 2 = 1) (hcs : c ^ 2 + s ^ 2 = 1)
    (hE : 0 < E) (hF : 0 < F) :
    (σ * E - F * c) ^ 2 + (F * s) ^ 2 = E * F * (F / E + E / F - 2 * σ * c) := by
  have h1 : E * F * (F / E + E / F - 2 * σ * c) = F ^ 2 + E ^ 2 - 2 * σ * c * E * F := by
    field_simp
  rw [h1]
  linear_combination E ^ 2 * hσ + F ^ 2 * hcs

theorem sq_eq_one_of_eq_one_or_neg_one {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) : σ ^ 2 = 1 := by
  rcases hσ with rfl | rfl <;> norm_num

theorem abs_le_one_of_eq_one_or_neg_one {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) : |σ| ≤ 1 := by
  rcases hσ with rfl | rfl <;> norm_num

/-- **Vertical translation invariance of the strip Poisson kernel.**  At the interior point `z`
the kernel is the density at the real point `re z`, translated by `im z`. -/
theorem im_stripKernel_eq {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) {z : ℂ} (hz : z.re ∈ Ioo (0 : ℝ) 1)
    (t : ℝ) : (stripKernel σ t z).im = poissonStrip z.re σ (t - z.im) := by
  have hσ2 : σ ^ 2 = 1 := sq_eq_one_of_eq_one_or_neg_one hσ
  have hσabs : |σ| ≤ 1 := abs_le_one_of_eq_one_or_neg_one hσ
  have hEt : (0 : ℝ) < Real.exp (-(π * t)) := Real.exp_pos _
  have hEy : (0 : ℝ) < Real.exp (-(π * z.im)) := Real.exp_pos _
  have hcs : Real.cos (π * z.re) ^ 2 + Real.sin (π * z.re) ^ 2 = 1 := by
    have := Real.sin_sq_add_cos_sq (π * z.re)
    linarith
  have hre : (Complex.exp (↑π * z * Complex.I)).re
      = Real.exp (-(π * z.im)) * Real.cos (π * z.re) := by
    rw [Complex.exp_re, exp_pi_mul_I_re, exp_pi_mul_I_im]
  have him : (Complex.exp (↑π * z * Complex.I)).im
      = Real.exp (-(π * z.im)) * Real.sin (π * z.re) := by
    rw [Complex.exp_im, exp_pi_mul_I_re, exp_pi_mul_I_im]
  have hdre : (((σ * Real.exp (-(π * t)) : ℝ) : ℂ)
        - Complex.exp (↑π * z * Complex.I)).re
      = σ * Real.exp (-(π * t)) - Real.exp (-(π * z.im)) * Real.cos (π * z.re) := by
    rw [Complex.sub_re, Complex.ofReal_re, hre]
  have hdim : (((σ * Real.exp (-(π * t)) : ℝ) : ℂ)
        - Complex.exp (↑π * z * Complex.I)).im
      = -(Real.exp (-(π * z.im)) * Real.sin (π * z.re)) := by
    rw [Complex.sub_im, Complex.ofReal_im, him, zero_sub]
  have hA : Real.exp (π * (t - z.im))
      = Real.exp (-(π * z.im)) / Real.exp (-(π * t)) := by
    rw [← Real.exp_sub]; congr 1; ring
  have hB : Real.exp (-(π * (t - z.im)))
      = Real.exp (-(π * t)) / Real.exp (-(π * z.im)) := by
    rw [← Real.exp_sub]; congr 1; ring
  have hcosh : 2 * Real.cosh (π * (t - z.im))
      = Real.exp (-(π * z.im)) / Real.exp (-(π * t))
        + Real.exp (-(π * t)) / Real.exp (-(π * z.im)) := by
    rw [Real.cosh_eq, hA, hB]
    ring
  have hns : Complex.normSq (((σ * Real.exp (-(π * t)) : ℝ) : ℂ)
        - Complex.exp (↑π * z * Complex.I))
      = Real.exp (-(π * t)) * Real.exp (-(π * z.im))
        * (2 * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re))) := by
    rw [Complex.normSq_apply, hdre, hdim]
    have hexp : (σ * Real.exp (-(π * t)) - Real.exp (-(π * z.im)) * Real.cos (π * z.re))
          * (σ * Real.exp (-(π * t)) - Real.exp (-(π * z.im)) * Real.cos (π * z.re))
        + -(Real.exp (-(π * z.im)) * Real.sin (π * z.re))
          * -(Real.exp (-(π * z.im)) * Real.sin (π * z.re))
        = (σ * Real.exp (-(π * t)) - Real.exp (-(π * z.im)) * Real.cos (π * z.re)) ^ 2
          + (Real.exp (-(π * z.im)) * Real.sin (π * z.re)) ^ 2 := by ring
    rw [hexp, strip_denom_identity hσ2 hcs hEt hEy]
    have : Real.exp (-(π * z.im)) / Real.exp (-(π * t))
        + Real.exp (-(π * t)) / Real.exp (-(π * z.im)) - 2 * σ * Real.cos (π * z.re)
        = 2 * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re)) := by
      rw [← hcosh]; ring
    rw [this]
  have hposD : 0 < Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re) :=
    poissonStrip_denom_pos hz hσabs (t - z.im)
  rw [stripKernel, Complex.div_im, hdre, hdim, hns, poissonStrip, Complex.ofReal_im,
    Complex.ofReal_re]
  field_simp
  ring

theorem im_stripKernel_pos {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) {z : ℂ} (hz : z.re ∈ Ioo (0 : ℝ) 1)
    (t : ℝ) : 0 < (stripKernel σ t z).im := by
  rw [im_stripKernel_eq hσ hz]
  exact poissonStrip_pos hz (abs_le_one_of_eq_one_or_neg_one hσ) _

theorem integrable_im_stripKernel {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) {z : ℂ}
    (hz : z.re ∈ Ioo (0 : ℝ) 1) :
    Integrable fun t : ℝ => (stripKernel σ t z).im := by
  have h := (integrable_poissonStrip hz (abs_le_one_of_eq_one_or_neg_one hσ)).comp_sub_right z.im
  refine h.congr ?_
  filter_upwards with t
  exact (im_stripKernel_eq hσ hz t).symm

/-- The total mass of the interior kernel is `1 - re z` on the edge `re z = 0` and `re z` on the
edge `re z = 1`: vertical translation does not change it. -/
theorem integral_im_stripKernel_one {z : ℂ} (hz : z.re ∈ Ioo (0 : ℝ) 1) :
    ∫ t : ℝ, (stripKernel 1 t z).im = 1 - z.re := by
  have hfun : (fun t : ℝ => (stripKernel 1 t z).im)
      = fun t : ℝ => poissonStrip z.re 1 (t - z.im) :=
    funext fun t => im_stripKernel_eq (Or.inl rfl) hz t
  rw [hfun, integral_sub_right_eq_self (fun t : ℝ => poissonStrip z.re 1 t) z.im,
    integral_poissonStrip_one hz]

theorem integral_im_stripKernel_neg_one {z : ℂ} (hz : z.re ∈ Ioo (0 : ℝ) 1) :
    ∫ t : ℝ, (stripKernel (-1) t z).im = z.re := by
  have hfun : (fun t : ℝ => (stripKernel (-1) t z).im)
      = fun t : ℝ => poissonStrip z.re (-1) (t - z.im) :=
    funext fun t => im_stripKernel_eq (Or.inr rfl) hz t
  rw [hfun, integral_sub_right_eq_self (fun t : ℝ => poissonStrip z.re (-1) t) z.im,
    integral_poissonStrip_neg_one hz]

/-! ### The normalized Herglotz kernel

Rotating by `-i` turns the Poisson kernel into the *real* part, which is the part that decays in
`t`.  The imaginary part of `-i · stripKernel` tends to `-σ` as `t → -∞`, so the analytic
completion has to be normalized before it can be integrated against boundary data.  Subtracting a
purely imaginary quantity that does not depend on `z` leaves the real part -- hence the harmonic
majorization -- unchanged, and makes the imaginary part vanish at the reference point `1/2`.
This is the strip analogue of the Schwarz kernel `1/(ξ - w) - ξ/(1 + ξ²)` of the half-plane. -/

/-- The reference point of the strip used to normalize the analytic completion. -/
noncomputable def stripBase : ℂ := ((1 / 2 : ℝ) : ℂ)

theorem stripBase_re : stripBase.re = 1 / 2 := by simp [stripBase]

theorem stripBase_im : stripBase.im = 0 := by simp [stripBase]

theorem stripBase_mem : stripBase.re ∈ Ioo (0 : ℝ) 1 := by
  rw [stripBase_re]
  constructor <;> norm_num

/-- The normalized Herglotz kernel of the strip. -/
noncomputable def stripKernelNorm (σ t : ℝ) (z : ℂ) : ℂ :=
  -Complex.I * stripKernel σ t z
    - (((-Complex.I * stripKernel σ t stripBase).im : ℝ) : ℂ) * Complex.I

theorem re_neg_I_mul (w : ℂ) : (-Complex.I * w).re = w.im := by
  simp [Complex.mul_re]

theorem im_neg_I_mul (w : ℂ) : (-Complex.I * w).im = -w.re := by
  simp [Complex.mul_im]

/-- Normalizing does not change the real part: it is still the Poisson kernel of the strip. -/
theorem re_stripKernelNorm {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) {z : ℂ} (hz : z.re ∈ Ioo (0 : ℝ) 1)
    (t : ℝ) : (stripKernelNorm σ t z).re = poissonStrip z.re σ (t - z.im) := by
  rw [stripKernelNorm, Complex.sub_re, re_neg_I_mul, im_stripKernel_eq hσ hz]
  simp

/-- The normalized kernel vanishes in the imaginary direction at the reference point. -/
theorem im_stripKernelNorm_stripBase (σ t : ℝ) :
    (stripKernelNorm σ t stripBase).im = 0 := by
  rw [stripKernelNorm, Complex.sub_im]
  simp

/-- The normalized kernel is still analytic in the interior variable. -/
theorem differentiableAt_stripKernelNorm {σ t : ℝ} {z : ℂ} (hz : z.re ∈ Ioo (0 : ℝ) 1) :
    DifferentiableAt ℂ (stripKernelNorm σ t) z := by
  refine DifferentiableAt.sub ?_ (differentiableAt_const _)
  exact (differentiableAt_const _).mul (differentiableAt_stripKernel hz)

/-- The real part of the normalized kernel is positive on the open strip, and integrable in the
boundary coordinate, with total mass `1 - re z` for `σ = 1` and `re z` for `σ = -1`. -/
theorem re_stripKernelNorm_pos {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) {z : ℂ}
    (hz : z.re ∈ Ioo (0 : ℝ) 1) (t : ℝ) : 0 < (stripKernelNorm σ t z).re := by
  rw [re_stripKernelNorm hσ hz]
  exact poissonStrip_pos hz (abs_le_one_of_eq_one_or_neg_one hσ) _

theorem integrable_re_stripKernelNorm {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) {z : ℂ}
    (hz : z.re ∈ Ioo (0 : ℝ) 1) :
    Integrable fun t : ℝ => (stripKernelNorm σ t z).re := by
  have h := (integrable_poissonStrip hz (abs_le_one_of_eq_one_or_neg_one hσ)).comp_sub_right z.im
  refine h.congr ?_
  filter_upwards with t
  exact (re_stripKernelNorm hσ hz t).symm

theorem integral_re_stripKernelNorm_one {z : ℂ} (hz : z.re ∈ Ioo (0 : ℝ) 1) :
    ∫ t : ℝ, (stripKernelNorm 1 t z).re = 1 - z.re := by
  have hfun : (fun t : ℝ => (stripKernelNorm 1 t z).re)
      = fun t : ℝ => poissonStrip z.re 1 (t - z.im) :=
    funext fun t => re_stripKernelNorm (Or.inl rfl) hz t
  rw [hfun, integral_sub_right_eq_self (fun t : ℝ => poissonStrip z.re 1 t) z.im,
    integral_poissonStrip_one hz]

theorem integral_re_stripKernelNorm_neg_one {z : ℂ} (hz : z.re ∈ Ioo (0 : ℝ) 1) :
    ∫ t : ℝ, (stripKernelNorm (-1) t z).re = z.re := by
  have hfun : (fun t : ℝ => (stripKernelNorm (-1) t z).re)
      = fun t : ℝ => poissonStrip z.re (-1) (t - z.im) :=
    funext fun t => re_stripKernelNorm (Or.inr rfl) hz t
  rw [hfun, integral_sub_right_eq_self (fun t : ℝ => poissonStrip z.re (-1) t) z.im,
    integral_poissonStrip_neg_one hz]

/-! ### The real part of the kernel, and the closed form of the normalized imaginary part

The real part of `stripKernel` has the closed form

  `σ/2 - σ sinh(π s) / (2 (cosh(π s) - σ cos(π x)))`,  `s = t - im z`,  `x = re z`,

which exhibits the obstruction described above: it tends to `σ` as `t → -∞` and to `0` as
`t → +∞`.  Subtracting the value at the reference point cancels the constant, and the normalized
imaginary part becomes a difference of two such expressions, each tending to the same limits at
each end. -/

theorem stripKernel_denom_re (σ t : ℝ) (z : ℂ) :
    (((σ * Real.exp (-(π * t)) : ℝ) : ℂ) - Complex.exp (↑π * z * Complex.I)).re
      = σ * Real.exp (-(π * t)) - Real.exp (-(π * z.im)) * Real.cos (π * z.re) := by
  rw [Complex.sub_re, Complex.ofReal_re, Complex.exp_re, exp_pi_mul_I_re, exp_pi_mul_I_im]

theorem stripKernel_denom_im (σ t : ℝ) (z : ℂ) :
    (((σ * Real.exp (-(π * t)) : ℝ) : ℂ) - Complex.exp (↑π * z * Complex.I)).im
      = -(Real.exp (-(π * z.im)) * Real.sin (π * z.re)) := by
  rw [Complex.sub_im, Complex.ofReal_im, Complex.exp_im, exp_pi_mul_I_re, exp_pi_mul_I_im,
    zero_sub]

theorem normSq_stripKernel_denom {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) (t : ℝ) (z : ℂ) :
    Complex.normSq (((σ * Real.exp (-(π * t)) : ℝ) : ℂ) - Complex.exp (↑π * z * Complex.I))
      = Real.exp (-(π * t)) * Real.exp (-(π * z.im))
        * (2 * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re))) := by
  have hσ2 : σ ^ 2 = 1 := sq_eq_one_of_eq_one_or_neg_one hσ
  have hcs : Real.cos (π * z.re) ^ 2 + Real.sin (π * z.re) ^ 2 = 1 := by
    have := Real.sin_sq_add_cos_sq (π * z.re)
    linarith
  have hEt : (0 : ℝ) < Real.exp (-(π * t)) := Real.exp_pos _
  have hEy : (0 : ℝ) < Real.exp (-(π * z.im)) := Real.exp_pos _
  have hA : Real.exp (π * (t - z.im)) = Real.exp (-(π * z.im)) / Real.exp (-(π * t)) := by
    rw [← Real.exp_sub]; congr 1; ring
  have hB : Real.exp (-(π * (t - z.im))) = Real.exp (-(π * t)) / Real.exp (-(π * z.im)) := by
    rw [← Real.exp_sub]; congr 1; ring
  have hcosh : 2 * Real.cosh (π * (t - z.im))
      = Real.exp (-(π * z.im)) / Real.exp (-(π * t))
        + Real.exp (-(π * t)) / Real.exp (-(π * z.im)) := by
    rw [Real.cosh_eq, hA, hB]; ring
  rw [Complex.normSq_apply, stripKernel_denom_re, stripKernel_denom_im]
  have hsq : (σ * Real.exp (-(π * t)) - Real.exp (-(π * z.im)) * Real.cos (π * z.re))
        * (σ * Real.exp (-(π * t)) - Real.exp (-(π * z.im)) * Real.cos (π * z.re))
      + -(Real.exp (-(π * z.im)) * Real.sin (π * z.re))
        * -(Real.exp (-(π * z.im)) * Real.sin (π * z.re))
      = (σ * Real.exp (-(π * t)) - Real.exp (-(π * z.im)) * Real.cos (π * z.re)) ^ 2
        + (Real.exp (-(π * z.im)) * Real.sin (π * z.re)) ^ 2 := by ring
  rw [hsq, strip_denom_identity hσ2 hcs hEt hEy]
  have hfin : Real.exp (-(π * z.im)) / Real.exp (-(π * t))
      + Real.exp (-(π * t)) / Real.exp (-(π * z.im)) - 2 * σ * Real.cos (π * z.re)
      = 2 * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re)) := by
    rw [← hcosh]; ring
  rw [hfin]

/-- Closed form of the real part of the Herglotz kernel. -/
theorem re_stripKernel_eq {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) {z : ℂ} (hz : z.re ∈ Ioo (0 : ℝ) 1)
    (t : ℝ) :
    (stripKernel σ t z).re
      = σ / 2 - σ * Real.sinh (π * (t - z.im))
          / (2 * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re))) := by
  have hσ2 : σ ^ 2 = 1 := sq_eq_one_of_eq_one_or_neg_one hσ
  have hD : 0 < Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re) :=
    poissonStrip_denom_pos hz (abs_le_one_of_eq_one_or_neg_one hσ) (t - z.im)
  have hEt : (0 : ℝ) < Real.exp (-(π * t)) := Real.exp_pos _
  have hEy : (0 : ℝ) < Real.exp (-(π * z.im)) := Real.exp_pos _
  have hkey : Real.cosh (π * (t - z.im)) - Real.sinh (π * (t - z.im))
      = Real.exp (-(π * t)) / Real.exp (-(π * z.im)) := by
    rw [Real.cosh_sub_sinh, ← Real.exp_sub]
    congr 1
    ring
  have hEq : Real.exp (-(π * t)) * (σ * Real.exp (-(π * t))
        - Real.exp (-(π * z.im)) * Real.cos (π * z.re))
      = Real.exp (-(π * t)) * Real.exp (-(π * z.im))
        * (σ * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re))
          - σ * Real.sinh (π * (t - z.im))) := by
    have h1 : σ * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re))
          - σ * Real.sinh (π * (t - z.im))
        = σ * (Real.cosh (π * (t - z.im)) - Real.sinh (π * (t - z.im)))
          - σ ^ 2 * Real.cos (π * z.re) := by ring
    rw [h1, hσ2, hkey]
    field_simp
  rw [stripKernel, Complex.div_re, stripKernel_denom_re, stripKernel_denom_im,
    normSq_stripKernel_denom hσ, Complex.ofReal_re, Complex.ofReal_im, hEq]
  field_simp
  ring

/-- Closed form of the imaginary part of the normalized kernel: a difference of two copies of the
same expression, one at the point `z` and one at the reference point. -/
theorem im_stripKernelNorm_eq {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) {z : ℂ}
    (hz : z.re ∈ Ioo (0 : ℝ) 1) (t : ℝ) :
    (stripKernelNorm σ t z).im
      = σ * Real.sinh (π * (t - z.im))
          / (2 * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re)))
        - σ * Real.sinh (π * t) / (2 * Real.cosh (π * t)) := by
  have hbase : (stripKernel σ t stripBase).re
      = σ / 2 - σ * Real.sinh (π * t) / (2 * Real.cosh (π * t)) := by
    have h := re_stripKernel_eq hσ stripBase_mem t
    rw [stripBase_re, stripBase_im, sub_zero, show π * (1 / 2 : ℝ) = π / 2 by ring,
      Real.cos_pi_div_two, mul_zero, sub_zero] at h
    exact h
  rw [stripKernelNorm, Complex.sub_im, im_neg_I_mul, re_stripKernel_eq hσ hz]
  have hmul : ((((-Complex.I * stripKernel σ t stripBase).im : ℝ) : ℂ) * Complex.I).im
      = (-Complex.I * stripKernel σ t stripBase).im := by
    simp
  rw [hmul, im_neg_I_mul, hbase]
  ring

/-! ### The decay of the normalized kernel

Combining the two fractions of `im_stripKernelNorm_eq` over a common denominator and using
`sinh (a - b) = sinh a cosh b - cosh a sinh b` collapses the difference into a single quotient.
The resulting closed form shows at once that the imaginary part of the normalized kernel is
dominated by its real part, uniformly in `t`, with a constant depending only on the point `z`.
That is the estimate needed for the Poisson integral to converge and to be analytic: the
imaginary part is integrable against exactly the same boundary data as the real part. -/

theorem abs_sinh_le_cosh (x : ℝ) : |Real.sinh x| ≤ Real.cosh x := by
  have h := Real.cosh_sq x
  nlinarith [Real.cosh_pos x, abs_nonneg (Real.sinh x), sq_abs (Real.sinh x)]

/-- Closed form of the imaginary part of the normalized kernel as a single quotient. -/
theorem im_stripKernelNorm_closed {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) {z : ℂ}
    (hz : z.re ∈ Ioo (0 : ℝ) 1) (t : ℝ) :
    (stripKernelNorm σ t z).im
      = σ * (σ * Real.cos (π * z.re) * Real.sinh (π * t) - Real.sinh (π * z.im))
        / (2 * ((Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re))
            * Real.cosh (π * t))) := by
  have hσ2 : σ ^ 2 = 1 := sq_eq_one_of_eq_one_or_neg_one hσ
  have hD : 0 < Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re) :=
    poissonStrip_denom_pos hz (abs_le_one_of_eq_one_or_neg_one hσ) (t - z.im)
  have hCt : 0 < Real.cosh (π * t) := Real.cosh_pos _
  have hDne : Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re) ≠ 0 := hD.ne'
  have hCtne : Real.cosh (π * t) ≠ 0 := hCt.ne'
  have h2D : (2 : ℝ) * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re)) ≠ 0 := by
    have : (0 : ℝ) < 2 * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re)) := by linarith
    exact this.ne'
  have h2Ct : (2 : ℝ) * Real.cosh (π * t) ≠ 0 := by
    have : (0 : ℝ) < 2 * Real.cosh (π * t) := by linarith
    exact this.ne'
  have hsub : Real.sinh (π * (t - z.im)) * Real.cosh (π * t)
      - Real.cosh (π * (t - z.im)) * Real.sinh (π * t) = -Real.sinh (π * z.im) := by
    rw [← Real.sinh_sub, show π * (t - z.im) - π * t = -(π * z.im) by ring, Real.sinh_neg]
  have key : σ * Real.sinh (π * (t - z.im)) * (2 * Real.cosh (π * t))
      - 2 * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re)) * (σ * Real.sinh (π * t))
      = 2 * (σ * (σ * Real.cos (π * z.re) * Real.sinh (π * t) - Real.sinh (π * z.im))) := by
    have h1 : σ * Real.sinh (π * (t - z.im)) * (2 * Real.cosh (π * t))
        - 2 * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re)) * (σ * Real.sinh (π * t))
        = 2 * σ * (Real.sinh (π * (t - z.im)) * Real.cosh (π * t)
            - Real.cosh (π * (t - z.im)) * Real.sinh (π * t))
          + 2 * σ ^ 2 * Real.cos (π * z.re) * Real.sinh (π * t) := by ring
    rw [h1, hsub]
    ring
  rw [im_stripKernelNorm_eq hσ hz, div_sub_div _ _ h2D h2Ct, key]
  field_simp

/-- **The imaginary part of the normalized kernel is dominated by its real part.**  The constant
depends only on the interior point `z`, not on the boundary coordinate `t`. -/
theorem abs_im_stripKernelNorm_le {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) {z : ℂ}
    (hz : z.re ∈ Ioo (0 : ℝ) 1) (t : ℝ) :
    |(stripKernelNorm σ t z).im|
      ≤ (|Real.cos (π * z.re)| + |Real.sinh (π * z.im)|) / Real.sin (π * z.re)
        * (stripKernelNorm σ t z).re := by
  have hsx : 0 < Real.sin (π * z.re) := sin_pi_mul_pos hz
  have hsxne : Real.sin (π * z.re) ≠ 0 := hsx.ne'
  have hD : 0 < Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re) :=
    poissonStrip_denom_pos hz (abs_le_one_of_eq_one_or_neg_one hσ) (t - z.im)
  have hCt : 0 < Real.cosh (π * t) := Real.cosh_pos _
  have hCt1 : 1 ≤ Real.cosh (π * t) := Real.one_le_cosh _
  have hDne : Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re) ≠ 0 := hD.ne'
  have hD2 : (0 : ℝ) < 2 * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re)) := by linarith
  have hDC2 : (0 : ℝ)
      < 2 * ((Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re)) * Real.cosh (π * t)) := by
    have h := mul_pos hD hCt
    linarith
  have hsc : |Real.sinh (π * t)| ≤ Real.cosh (π * t) := abs_sinh_le_cosh _
  have hσ1 : |σ| = 1 := by rcases hσ with rfl | rfl <;> norm_num
  have habs : |σ * (σ * Real.cos (π * z.re) * Real.sinh (π * t) - Real.sinh (π * z.im))|
      ≤ (|Real.cos (π * z.re)| + |Real.sinh (π * z.im)|) * Real.cosh (π * t) := by
    rw [abs_mul, hσ1, one_mul]
    have hstep : |σ * Real.cos (π * z.re) * Real.sinh (π * t) - Real.sinh (π * z.im)|
        ≤ |σ * Real.cos (π * z.re) * Real.sinh (π * t)| + |Real.sinh (π * z.im)| := by
      rw [sub_eq_add_neg]
      simpa using abs_add_le (σ * Real.cos (π * z.re) * Real.sinh (π * t))
        (-Real.sinh (π * z.im))
    have heq : |σ * Real.cos (π * z.re) * Real.sinh (π * t)|
        = |Real.cos (π * z.re)| * |Real.sinh (π * t)| := by
      rw [abs_mul, abs_mul, hσ1, one_mul]
    have hA : |Real.cos (π * z.re)| * |Real.sinh (π * t)|
        ≤ |Real.cos (π * z.re)| * Real.cosh (π * t) :=
      mul_le_mul_of_nonneg_left hsc (abs_nonneg _)
    have hB : |Real.sinh (π * z.im)| ≤ |Real.sinh (π * z.im)| * Real.cosh (π * t) := by
      nlinarith [abs_nonneg (Real.sinh (π * z.im))]
    rw [heq] at hstep
    nlinarith [hstep, hA, hB]
  rw [im_stripKernelNorm_closed hσ hz, re_stripKernelNorm hσ hz, poissonStrip]
  have hrhs : (|Real.cos (π * z.re)| + |Real.sinh (π * z.im)|) / Real.sin (π * z.re)
      * (Real.sin (π * z.re)
        / (2 * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re))))
      = (|Real.cos (π * z.re)| + |Real.sinh (π * z.im)|)
        / (2 * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re))) := by
    field_simp
  rw [hrhs, abs_div, abs_of_pos hDC2, div_le_div_iff₀ hDC2 hD2]
  calc |σ * (σ * Real.cos (π * z.re) * Real.sinh (π * t) - Real.sinh (π * z.im))|
        * (2 * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re)))
      ≤ (|Real.cos (π * z.re)| + |Real.sinh (π * z.im)|) * Real.cosh (π * t)
        * (2 * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re))) :=
        mul_le_mul_of_nonneg_right habs hD2.le
    _ = (|Real.cos (π * z.re)| + |Real.sinh (π * z.im)|)
        * (2 * ((Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re))
          * Real.cosh (π * t))) := by ring

/-! ### Well-definedness of the Poisson integral

The boundary data enters only through the hypothesis that it is integrable against the Poisson
kernel, i.e. against the real part of the normalized kernel.  By
`abs_im_stripKernelNorm_le` the imaginary part is then automatically integrable against the same
data, so the complex-valued integrand is integrable and the Poisson integral is well defined. -/

theorem continuous_re_stripKernelNorm {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) {z : ℂ}
    (hz : z.re ∈ Ioo (0 : ℝ) 1) :
    Continuous fun t : ℝ => (stripKernelNorm σ t z).re := by
  have hfun : (fun t : ℝ => (stripKernelNorm σ t z).re)
      = fun t : ℝ => poissonStrip z.re σ (t - z.im) :=
    funext fun t => re_stripKernelNorm hσ hz t
  rw [hfun]
  exact (continuous_poissonStrip hz (abs_le_one_of_eq_one_or_neg_one hσ)).comp
    (continuous_id.sub continuous_const)

theorem continuous_im_stripKernelNorm {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) {z : ℂ}
    (hz : z.re ∈ Ioo (0 : ℝ) 1) :
    Continuous fun t : ℝ => (stripKernelNorm σ t z).im := by
  have hfun : (fun t : ℝ => (stripKernelNorm σ t z).im)
      = fun t : ℝ => σ * (σ * Real.cos (π * z.re) * Real.sinh (π * t) - Real.sinh (π * z.im))
        / (2 * ((Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re))
            * Real.cosh (π * t))) :=
    funext fun t => im_stripKernelNorm_closed hσ hz t
  rw [hfun]
  refine Continuous.div (by fun_prop) (by fun_prop) ?_
  intro t
  have hD : 0 < Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re) :=
    poissonStrip_denom_pos hz (abs_le_one_of_eq_one_or_neg_one hσ) (t - z.im)
  have hCt : 0 < Real.cosh (π * t) := Real.cosh_pos _
  have hpos : (0 : ℝ)
      < 2 * ((Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re)) * Real.cosh (π * t)) := by
    have := mul_pos hD hCt
    linarith
  exact hpos.ne'

open MeasureTheory in
/-- Boundary data integrable against the Poisson kernel is integrable against the whole
normalized kernel. -/
theorem integrable_mul_stripKernelNorm {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) {z : ℂ}
    (hz : z.re ∈ Ioo (0 : ℝ) 1) {g : ℝ → ℝ} (hgm : AEStronglyMeasurable g volume)
    (hg : Integrable fun t : ℝ => g t * (stripKernelNorm σ t z).re) :
    Integrable fun t : ℝ => (g t : ℂ) * stripKernelNorm σ t z := by
  set C : ℝ := (|Real.cos (π * z.re)| + |Real.sinh (π * z.im)|) / Real.sin (π * z.re) with hCdef
  have him : Integrable fun t : ℝ => g t * (stripKernelNorm σ t z).im := by
    refine Integrable.mono' (hg.abs.const_mul C)
      (hgm.mul (continuous_im_stripKernelNorm hσ hz).aestronglyMeasurable) ?_
    filter_upwards with t
    have hb := abs_im_stripKernelNorm_le hσ hz (z := z) t
    have hre : 0 < (stripKernelNorm σ t z).re := re_stripKernelNorm_pos hσ hz t
    rw [Real.norm_eq_abs, abs_mul]
    calc |g t| * |(stripKernelNorm σ t z).im|
        ≤ |g t| * (C * (stripKernelNorm σ t z).re) :=
          mul_le_mul_of_nonneg_left hb (abs_nonneg _)
      _ = C * |g t * (stripKernelNorm σ t z).re| := by
          rw [abs_mul, abs_of_pos hre]
          ring
  have hfun : (fun t : ℝ => (g t : ℂ) * stripKernelNorm σ t z)
      = fun t : ℝ => ((g t * (stripKernelNorm σ t z).re : ℝ) : ℂ)
        + ((g t * (stripKernelNorm σ t z).im : ℝ) : ℂ) * Complex.I := by
    funext t
    apply Complex.ext <;> simp
  rw [hfun]
  exact hg.ofReal.add (him.ofReal.mul_const Complex.I)

/-- The Poisson integral of boundary data on the two edges of the strip. -/
noncomputable def stripPoissonIntegral (g₀ g₁ : ℝ → ℝ) (z : ℂ) : ℂ :=
  (∫ t : ℝ, (g₀ t : ℂ) * stripKernelNorm 1 t z)
    + ∫ t : ℝ, (g₁ t : ℂ) * stripKernelNorm (-1) t z

open MeasureTheory in
/-- The real part of the Poisson integral is the harmonic extension of the boundary data: the
sum of the two averages against the Poisson kernels of the two edges. -/
theorem re_stripPoissonIntegral {g₀ g₁ : ℝ → ℝ} {z : ℂ} (hz : z.re ∈ Ioo (0 : ℝ) 1)
    (hgm₀ : AEStronglyMeasurable g₀ volume) (hgm₁ : AEStronglyMeasurable g₁ volume)
    (hg₀ : Integrable fun t : ℝ => g₀ t * (stripKernelNorm 1 t z).re)
    (hg₁ : Integrable fun t : ℝ => g₁ t * (stripKernelNorm (-1) t z).re) :
    (stripPoissonIntegral g₀ g₁ z).re
      = (∫ t : ℝ, g₀ t * poissonStrip z.re 1 (t - z.im))
        + ∫ t : ℝ, g₁ t * poissonStrip z.re (-1) (t - z.im) := by
  have hi₀ := integrable_mul_stripKernelNorm (Or.inl rfl) hz hgm₀ hg₀
  have hi₁ := integrable_mul_stripKernelNorm (Or.inr rfl) hz hgm₁ hg₁
  have hre₀ : ∀ t : ℝ, ((g₀ t : ℂ) * stripKernelNorm 1 t z).re
      = g₀ t * poissonStrip z.re 1 (t - z.im) := by
    intro t
    rw [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero,
      re_stripKernelNorm (Or.inl rfl) hz]
  have hre₁ : ∀ t : ℝ, ((g₁ t : ℂ) * stripKernelNorm (-1) t z).re
      = g₁ t * poissonStrip z.re (-1) (t - z.im) := by
    intro t
    rw [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero,
      re_stripKernelNorm (Or.inr rfl) hz]
  rw [stripPoissonIntegral, Complex.add_re, ← Complex.reCLM_apply, ← Complex.reCLM_apply,
    ← ContinuousLinearMap.integral_comp_comm _ hi₀, ← ContinuousLinearMap.integral_comp_comm _ hi₁]
  simp only [Complex.reCLM_apply, hre₀, hre₁]

/-! ### The derivative of the kernel in the interior variable

Differentiating `stripKernelNorm` in `z` produces a kernel whose modulus is again a constant
multiple of the Poisson kernel:

  `‖∂_z stripKernelNorm σ t z‖ = π / (2 (cosh(π (t - y)) - σ cos(π x)))`
                              = (π / sin(π x)) · re (stripKernelNorm σ t z) .

So the derivative is controlled by exactly the same quantity as the kernel itself, which is what
makes differentiation under the integral sign available with no new hypothesis on the boundary
data. -/

/-- The derivative of `stripKernelNorm σ t` in the interior variable. -/
noncomputable def stripKernelDeriv (σ t : ℝ) (z : ℂ) : ℂ :=
  (π : ℂ) * (Real.exp (-(π * t)) : ℂ) * Complex.exp (↑π * z * Complex.I)
    / (((σ * Real.exp (-(π * t)) : ℝ) : ℂ) - Complex.exp (↑π * z * Complex.I)) ^ 2

theorem hasDerivAt_stripKernelNorm {σ t : ℝ} {z : ℂ} (hz : z.re ∈ Ioo (0 : ℝ) 1) :
    HasDerivAt (stripKernelNorm σ t) (stripKernelDeriv σ t z) z := by
  have hne := stripKernel_denom_ne_zero (σ := σ) (t := t) hz
  have hlin : HasDerivAt (fun w : ℂ => ↑π * w * Complex.I) (↑π * Complex.I) z := by
    simpa using ((hasDerivAt_id z).const_mul (π : ℂ)).mul_const Complex.I
  have hexp : HasDerivAt (fun w : ℂ => Complex.exp (↑π * w * Complex.I))
      (Complex.exp (↑π * z * Complex.I) * (↑π * Complex.I)) z := hlin.cexp
  have hden : HasDerivAt (fun w : ℂ => ((σ * Real.exp (-(π * t)) : ℝ) : ℂ)
      - Complex.exp (↑π * w * Complex.I))
      (0 - Complex.exp (↑π * z * Complex.I) * (↑π * Complex.I)) z :=
    (hasDerivAt_const z _).sub hexp
  have hK := (hasDerivAt_const z ((Real.exp (-(π * t)) : ℂ))).div hden hne
  have hfin : HasDerivAt (stripKernelNorm σ t)
      (-Complex.I * ((0 * (((σ * Real.exp (-(π * t)) : ℝ) : ℂ)
            - Complex.exp (↑π * z * Complex.I))
          - (Real.exp (-(π * t)) : ℂ)
            * (0 - Complex.exp (↑π * z * Complex.I) * (↑π * Complex.I)))
        / (((σ * Real.exp (-(π * t)) : ℝ) : ℂ) - Complex.exp (↑π * z * Complex.I)) ^ 2)) z :=
    (hK.const_mul (-Complex.I)).sub_const
      ((((-Complex.I * stripKernel σ t stripBase).im : ℝ) : ℂ) * Complex.I)
  convert hfin using 1
  have h1 : (0 : ℂ) * (((σ * Real.exp (-(π * t)) : ℝ) : ℂ)
        - Complex.exp (↑π * z * Complex.I))
      - (Real.exp (-(π * t)) : ℂ)
        * (0 - Complex.exp (↑π * z * Complex.I) * (↑π * Complex.I))
      = (Real.exp (-(π * t)) : ℂ) * Complex.exp (↑π * z * Complex.I) * ↑π * Complex.I := by
    ring
  rw [stripKernelDeriv, h1, mul_div_assoc']
  congr 1
  linear_combination ((π : ℂ) * (Real.exp (-(π * t)) : ℂ)
    * Complex.exp (↑π * z * Complex.I)) * Complex.I_mul_I

theorem norm_stripKernelDeriv {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) {z : ℂ}
    (hz : z.re ∈ Ioo (0 : ℝ) 1) (t : ℝ) :
    ‖stripKernelDeriv σ t z‖
      = π / (2 * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re))) := by
  have hD : 0 < Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re) :=
    poissonStrip_denom_pos hz (abs_le_one_of_eq_one_or_neg_one hσ) (t - z.im)
  have hE : (0 : ℝ) < Real.exp (-(π * t)) := Real.exp_pos _
  have hM : (0 : ℝ) < Real.exp (-(π * z.im)) := Real.exp_pos _
  have hnorm_sq : ‖(((σ * Real.exp (-(π * t)) : ℝ) : ℂ)
        - Complex.exp (↑π * z * Complex.I)) ^ 2‖
      = Real.exp (-(π * t)) * Real.exp (-(π * z.im))
        * (2 * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re))) := by
    rw [norm_pow, ← Complex.normSq_eq_norm_sq, normSq_stripKernel_denom hσ]
  have hnum : ‖(π : ℂ) * (Real.exp (-(π * t)) : ℂ) * Complex.exp (↑π * z * Complex.I)‖
      = π * Real.exp (-(π * t)) * Real.exp (-(π * z.im)) := by
    rw [norm_mul, norm_mul, Complex.norm_exp, exp_pi_mul_I_re, Complex.norm_real,
      Complex.norm_real, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_pos Real.pi_pos,
      abs_of_pos hE]
  rw [stripKernelDeriv, norm_div, hnum, hnorm_sq]
  field_simp

/-- The modulus of the derivative is a constant multiple of the Poisson kernel. -/
theorem norm_stripKernelDeriv_le {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) {z : ℂ}
    (hz : z.re ∈ Ioo (0 : ℝ) 1) (t : ℝ) :
    ‖stripKernelDeriv σ t z‖
      = π / Real.sin (π * z.re) * (stripKernelNorm σ t z).re := by
  have hsx : 0 < Real.sin (π * z.re) := sin_pi_mul_pos hz
  have hD : 0 < Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re) :=
    poissonStrip_denom_pos hz (abs_le_one_of_eq_one_or_neg_one hσ) (t - z.im)
  rw [norm_stripKernelDeriv hσ hz, re_stripKernelNorm hσ hz, poissonStrip]
  field_simp

/-! ### Uniform bounds on a sub-rectangle of the strip

To differentiate the Poisson integral under the integral sign one needs a bound on the derivative
that is uniform for `z` in a neighbourhood of the point considered.  Both the kernel and its
derivative are controlled by `1 / (cosh(π (t - im z)) - σ cos(π (re z)))`, so it is enough to
bound that denominator from below by a constant multiple of `cosh (π t)`, uniformly on a closed
sub-rectangle of the strip.  Two elementary facts do it: `cos` is antitone on `[0, π]`, so
`|cos (π x)|` is at most its larger endpoint value; and `cosh (a - b) ≥ cosh a / (2 cosh b)`. -/

/-- `|cos|` on a subinterval of `(0, 1)` is bounded by its endpoint values. -/
theorem abs_cos_pi_mul_le_max {x₁ x₂ x : ℝ} (h₁ : 0 ≤ x₁) (h₂ : x₂ ≤ 1)
    (hx : x ∈ Icc x₁ x₂) :
    |Real.cos (π * x)| ≤ max (Real.cos (π * x₁)) (-Real.cos (π * x₂)) := by
  have hpi := Real.pi_pos
  obtain ⟨hxa, hxb⟩ := hx
  have hx1 : 0 ≤ π * x₁ := by positivity
  have hx0 : 0 ≤ π * x := le_trans hx1 (by nlinarith)
  have hxpi : π * x ≤ π := by nlinarith
  have h2pi : π * x₂ ≤ π := by nlinarith
  have hle1 : Real.cos (π * x) ≤ Real.cos (π * x₁) :=
    Real.cos_le_cos_of_nonneg_of_le_pi hx1 hxpi (by nlinarith)
  have hle2 : Real.cos (π * x₂) ≤ Real.cos (π * x) :=
    Real.cos_le_cos_of_nonneg_of_le_pi hx0 h2pi (by nlinarith)
  rcases le_or_gt 0 (Real.cos (π * x)) with h | h
  · rw [abs_of_nonneg h]
    exact le_max_of_le_left hle1
  · rw [abs_of_neg h]
    exact le_max_of_le_right (by linarith)

/-- `cosh (a - b) ≥ cosh a / (2 cosh b)`. -/
theorem cosh_sub_lower (a b : ℝ) : Real.cosh a / (2 * Real.cosh b) ≤ Real.cosh (a - b) := by
  have hb : 0 < Real.cosh b := Real.cosh_pos _
  have hab : 0 < Real.cosh (a - b) := Real.cosh_pos _
  have hadd : Real.cosh a = Real.cosh (a - b) * Real.cosh b
      + Real.sinh (a - b) * Real.sinh b := by
    rw [← Real.cosh_add]
    congr 1
    ring
  have h1 : Real.sinh (a - b) * Real.sinh b ≤ Real.cosh (a - b) * Real.cosh b := by
    have hs1 : |Real.sinh (a - b)| ≤ Real.cosh (a - b) := abs_sinh_le_cosh _
    have hs2 : |Real.sinh b| ≤ Real.cosh b := abs_sinh_le_cosh _
    calc Real.sinh (a - b) * Real.sinh b ≤ |Real.sinh (a - b) * Real.sinh b| := le_abs_self _
      _ = |Real.sinh (a - b)| * |Real.sinh b| := abs_mul _ _
      _ ≤ Real.cosh (a - b) * Real.cosh b := by
          apply mul_le_mul hs1 hs2 (abs_nonneg _) hab.le
  rw [div_le_iff₀ (by positivity)]
  nlinarith [hadd, h1]

/-- The uniform lower bound for the Poisson denominator on a closed sub-rectangle of the strip. -/
theorem strip_denom_uniform_lower {x₁ x₂ Y : ℝ} (hx₁ : 0 < x₁) (hx₂ : x₂ < 1)
    {σ x y : ℝ} (hσ : |σ| ≤ 1) (hxm : x ∈ Icc x₁ x₂) (hym : |y| ≤ Y) (t : ℝ) :
    (1 - max (Real.cos (π * x₁)) (-Real.cos (π * x₂))) / (2 * Real.cosh (π * Y))
        * Real.cosh (π * t)
      ≤ Real.cosh (π * (t - y)) - σ * Real.cos (π * x) := by
  set c : ℝ := max (Real.cos (π * x₁)) (-Real.cos (π * x₂)) with hcdef
  have hc1 : c < 1 := by
    rw [hcdef]
    refine max_lt ?_ ?_
    · have := abs_cos_pi_mul_lt_one (θ := x₁) ⟨hx₁, lt_of_le_of_lt hxm.1 (lt_of_le_of_lt hxm.2 hx₂)⟩
      exact lt_of_le_of_lt (le_abs_self _) this
    · have := abs_cos_pi_mul_lt_one (θ := x₂)
        ⟨lt_of_lt_of_le hx₁ (le_trans hxm.1 hxm.2), hx₂⟩
      exact lt_of_le_of_lt (neg_le_abs _) this
  have habs : |Real.cos (π * x)| ≤ c :=
    abs_cos_pi_mul_le_max hx₁.le hx₂.le hxm
  have hσc : σ * Real.cos (π * x) ≤ c := by
    calc σ * Real.cos (π * x) ≤ |σ * Real.cos (π * x)| := le_abs_self _
      _ = |σ| * |Real.cos (π * x)| := abs_mul _ _
      _ ≤ 1 * c := mul_le_mul hσ habs (abs_nonneg _) zero_le_one
      _ = c := one_mul _
  have hcosh1 : 1 ≤ Real.cosh (π * (t - y)) := Real.one_le_cosh _
  have hlow : Real.cosh (π * t) / (2 * Real.cosh (π * y)) ≤ Real.cosh (π * (t - y)) := by
    have h := cosh_sub_lower (π * t) (π * y)
    rwa [show π * t - π * y = π * (t - y) by ring] at h
  have hYcosh : Real.cosh (π * y) ≤ Real.cosh (π * Y) := by
    rw [Real.cosh_le_cosh]
    rw [abs_mul, abs_mul, abs_of_pos Real.pi_pos]
    exact mul_le_mul_of_nonneg_left (le_trans hym (le_abs_self Y)) Real.pi_pos.le
  have hCy : 0 < Real.cosh (π * y) := Real.cosh_pos _
  have hCY : 0 < Real.cosh (π * Y) := Real.cosh_pos _
  have hCt : 0 < Real.cosh (π * t) := Real.cosh_pos _
  have hstep : Real.cosh (π * t) / (2 * Real.cosh (π * Y))
      ≤ Real.cosh (π * (t - y)) := by
    refine le_trans ?_ hlow
    apply div_le_div_of_nonneg_left hCt.le (by positivity)
    nlinarith
  have hfinal : (1 - c) * (Real.cosh (π * t) / (2 * Real.cosh (π * Y)))
      ≤ (1 - c) * Real.cosh (π * (t - y)) :=
    mul_le_mul_of_nonneg_left hstep (by linarith)
  have hc0 : 0 ≤ c := le_trans (abs_nonneg _) habs
  have hexp : (1 - c) * Real.cosh (π * (t - y))
      ≤ Real.cosh (π * (t - y)) - σ * Real.cos (π * x) := by
    nlinarith [hcosh1, hσc, hc0]
  calc (1 - c) / (2 * Real.cosh (π * Y)) * Real.cosh (π * t)
      = (1 - c) * (Real.cosh (π * t) / (2 * Real.cosh (π * Y))) := by ring
    _ ≤ (1 - c) * Real.cosh (π * (t - y)) := hfinal
    _ ≤ Real.cosh (π * (t - y)) - σ * Real.cos (π * x) := hexp

/-- The constant in `strip_denom_uniform_lower` is positive. -/
theorem strip_denom_uniform_const_pos {x₁ x₂ Y : ℝ} (hx₁ : 0 < x₁) (hx₂ : x₂ < 1)
    (hx : x₁ ≤ x₂) :
    0 < (1 - max (Real.cos (π * x₁)) (-Real.cos (π * x₂))) / (2 * Real.cosh (π * Y)) := by
  have hCY : 0 < Real.cosh (π * Y) := Real.cosh_pos _
  have hlt : max (Real.cos (π * x₁)) (-Real.cos (π * x₂)) < 1 := by
    refine max_lt ?_ ?_
    · exact lt_of_le_of_lt (le_abs_self _)
        (abs_cos_pi_mul_lt_one (θ := x₁) ⟨hx₁, lt_of_le_of_lt hx hx₂⟩)
    · exact lt_of_le_of_lt (neg_le_abs _)
        (abs_cos_pi_mul_lt_one (θ := x₂) ⟨lt_of_lt_of_le hx₁ hx, hx₂⟩)
  have : 0 < 1 - max (Real.cos (π * x₁)) (-Real.cos (π * x₂)) := by linarith
  positivity

/-- The Poisson kernel at the base point `1/2`. -/
theorem re_stripKernelNorm_stripBase (σ : ℝ) (hσ : σ = 1 ∨ σ = -1) (t : ℝ) :
    (stripKernelNorm σ t stripBase).re = 1 / (2 * Real.cosh (π * t)) := by
  rw [re_stripKernelNorm hσ stripBase_mem, stripBase_re, stripBase_im, sub_zero, poissonStrip,
    show π * (1 / 2 : ℝ) = π / 2 by ring, Real.cos_pi_div_two, Real.sin_pi_div_two, mul_zero,
    sub_zero]

/-- Uniform bound for the kernel derivative on a closed sub-rectangle of the strip. -/
theorem norm_stripKernelDeriv_uniform_le {x₁ x₂ Y : ℝ} (hx₁ : 0 < x₁) (hx₂ : x₂ < 1)
    {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) {z : ℂ} (hxm : z.re ∈ Icc x₁ x₂) (hym : |z.im| ≤ Y)
    (hz : z.re ∈ Ioo (0 : ℝ) 1) (t : ℝ) :
    ‖stripKernelDeriv σ t z‖
      ≤ π / (2 * ((1 - max (Real.cos (π * x₁)) (-Real.cos (π * x₂)))
          / (2 * Real.cosh (π * Y)) * Real.cosh (π * t))) := by
  have hden := strip_denom_uniform_lower hx₁ hx₂ (abs_le_one_of_eq_one_or_neg_one hσ) hxm hym t
  have hκ : 0 < (1 - max (Real.cos (π * x₁)) (-Real.cos (π * x₂))) / (2 * Real.cosh (π * Y)) :=
    strip_denom_uniform_const_pos hx₁ hx₂ (le_trans hxm.1 hxm.2)
  have hCt : 0 < Real.cosh (π * t) := Real.cosh_pos _
  have hpos : (0 : ℝ) < 2 * ((1 - max (Real.cos (π * x₁)) (-Real.cos (π * x₂)))
      / (2 * Real.cosh (π * Y)) * Real.cosh (π * t)) := by
    have := mul_pos hκ hCt
    linarith
  rw [norm_stripKernelDeriv hσ hz]
  exact div_le_div_of_nonneg_left Real.pi_pos.le hpos (by linarith)

/-- Uniform bound for the kernel itself on a closed sub-rectangle: it is dominated by a constant
multiple of the kernel at the base point.  This is the comparability of the harmonic measures of
the strip seen from different interior points. -/
theorem re_stripKernelNorm_uniform_le {x₁ x₂ Y : ℝ} (hx₁ : 0 < x₁) (hx₂ : x₂ < 1)
    {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) {z : ℂ} (hxm : z.re ∈ Icc x₁ x₂) (hym : |z.im| ≤ Y)
    (hz : z.re ∈ Ioo (0 : ℝ) 1) (t : ℝ) :
    (stripKernelNorm σ t z).re
      ≤ ((1 - max (Real.cos (π * x₁)) (-Real.cos (π * x₂)))
          / (2 * Real.cosh (π * Y)))⁻¹ * (stripKernelNorm 1 t stripBase).re := by
  have hden := strip_denom_uniform_lower hx₁ hx₂ (abs_le_one_of_eq_one_or_neg_one hσ) hxm hym t
  have hκ : 0 < (1 - max (Real.cos (π * x₁)) (-Real.cos (π * x₂))) / (2 * Real.cosh (π * Y)) :=
    strip_denom_uniform_const_pos hx₁ hx₂ (le_trans hxm.1 hxm.2)
  have hCt : 0 < Real.cosh (π * t) := Real.cosh_pos _
  have hD : 0 < Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re) :=
    poissonStrip_denom_pos hz (abs_le_one_of_eq_one_or_neg_one hσ) (t - z.im)
  have h2D : (0 : ℝ) < 2 * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re)) := by linarith
  have hsin : Real.sin (π * z.re) ≤ 1 := Real.sin_le_one _
  have hpos : (0 : ℝ) < 2 * ((1 - max (Real.cos (π * x₁)) (-Real.cos (π * x₂)))
      / (2 * Real.cosh (π * Y)) * Real.cosh (π * t)) := by
    have := mul_pos hκ hCt
    linarith
  rw [re_stripKernelNorm hσ hz, poissonStrip, re_stripKernelNorm_stripBase 1 (Or.inl rfl)]
  have h1 : Real.sin (π * z.re)
      / (2 * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re)))
      ≤ 1 / (2 * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re))) :=
    (div_le_div_iff_of_pos_right h2D).mpr hsin
  have h2 : (1 : ℝ) / (2 * (Real.cosh (π * (t - z.im)) - σ * Real.cos (π * z.re)))
      ≤ 1 / (2 * ((1 - max (Real.cos (π * x₁)) (-Real.cos (π * x₂)))
          / (2 * Real.cosh (π * Y)) * Real.cosh (π * t))) :=
    div_le_div_of_nonneg_left zero_le_one hpos (by linarith)
  refine le_trans h1 (le_trans h2 (le_of_eq ?_))
  field_simp

/-! ### Analyticity of the Poisson integral

All the pieces are now in place: the kernel is analytic in the interior variable with derivative
`stripKernelDeriv`, and on a ball contained in the strip both the kernel and its derivative are
bounded by a fixed constant times `1 / cosh (π t)`.  Differentiation under the integral sign
therefore applies, with the single hypothesis that the boundary data is integrable against
`1 / cosh (π t)`, i.e. against the Poisson kernel at the base point `1/2`. -/

theorem continuous_stripKernelNorm {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) {z : ℂ}
    (hz : z.re ∈ Ioo (0 : ℝ) 1) : Continuous fun t : ℝ => stripKernelNorm σ t z := by
  have hfun : (fun t : ℝ => stripKernelNorm σ t z)
      = fun t : ℝ => (((stripKernelNorm σ t z).re : ℝ) : ℂ)
        + (((stripKernelNorm σ t z).im : ℝ) : ℂ) * Complex.I :=
    funext fun t => (Complex.re_add_im _).symm
  rw [hfun]
  exact (Complex.continuous_ofReal.comp (continuous_re_stripKernelNorm hσ hz)).add
    ((Complex.continuous_ofReal.comp (continuous_im_stripKernelNorm hσ hz)).mul continuous_const)

theorem continuous_stripKernelDeriv {σ : ℝ} {z : ℂ} (hz : z.re ∈ Ioo (0 : ℝ) 1) :
    Continuous fun t : ℝ => stripKernelDeriv σ t z := by
  simp only [stripKernelDeriv]
  refine Continuous.div (by fun_prop) (by fun_prop) ?_
  intro t
  exact pow_ne_zero 2 (stripKernel_denom_ne_zero hz)

theorem abs_re_im_sub_le_of_mem_ball {z₀ z : ℂ} {r : ℝ} (h : z ∈ Metric.ball z₀ r) :
    |z.re - z₀.re| ≤ r ∧ |z.im - z₀.im| ≤ r := by
  have hd : ‖z - z₀‖ < r := by
    rw [← Complex.dist_eq]
    exact Metric.mem_ball.mp h
  have h1 := Complex.abs_re_le_norm (z - z₀)
  have h2 := Complex.abs_im_le_norm (z - z₀)
  rw [Complex.sub_re] at h1
  rw [Complex.sub_im] at h2
  exact ⟨by linarith, by linarith⟩

open MeasureTheory in
/-- Boundary data integrable against the kernel at the base point is integrable against the
kernel at every interior point. -/
theorem integrable_mul_re_stripKernelNorm_of_base {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) {g : ℝ → ℝ}
    (hgm : AEStronglyMeasurable g volume)
    (hg : Integrable fun t : ℝ => |g t| / Real.cosh (π * t))
    {x₁ x₂ Y : ℝ} (hx₁ : 0 < x₁) (hx₂ : x₂ < 1) {z : ℂ}
    (hxm : z.re ∈ Icc x₁ x₂) (hym : |z.im| ≤ Y) (hz : z.re ∈ Ioo (0 : ℝ) 1) :
    Integrable fun t : ℝ => g t * (stripKernelNorm σ t z).re := by
  set κ : ℝ := (1 - max (Real.cos (π * x₁)) (-Real.cos (π * x₂))) / (2 * Real.cosh (π * Y))
    with hκdef
  have hκ : 0 < κ := strip_denom_uniform_const_pos hx₁ hx₂ (le_trans hxm.1 hxm.2)
  refine Integrable.mono' (hg.const_mul (κ⁻¹ / 2))
    (hgm.mul (continuous_re_stripKernelNorm hσ hz).aestronglyMeasurable) ?_
  filter_upwards with t
  have hCt : 0 < Real.cosh (π * t) := Real.cosh_pos _
  have hb := re_stripKernelNorm_uniform_le hx₁ hx₂ hσ hxm hym hz t
  rw [re_stripKernelNorm_stripBase 1 (Or.inl rfl)] at hb
  have hre : 0 < (stripKernelNorm σ t z).re := re_stripKernelNorm_pos hσ hz t
  rw [Real.norm_eq_abs, abs_mul, abs_of_pos hre]
  calc |g t| * (stripKernelNorm σ t z).re
      ≤ |g t| * (κ⁻¹ * (1 / (2 * Real.cosh (π * t)))) :=
        mul_le_mul_of_nonneg_left hb (abs_nonneg _)
    _ = κ⁻¹ / 2 * (|g t| / Real.cosh (π * t)) := by
        field_simp

open MeasureTheory in
/-- The Poisson integral of one edge is complex-differentiable in the interior variable, with the
expected derivative. -/
theorem hasDerivAt_integral_stripKernelNorm {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) {g : ℝ → ℝ}
    (hgm : AEStronglyMeasurable g volume)
    (hg : Integrable fun t : ℝ => |g t| / Real.cosh (π * t))
    {z₀ : ℂ} (hz₀ : z₀.re ∈ Ioo (0 : ℝ) 1) :
    HasDerivAt (fun z : ℂ => ∫ t : ℝ, (g t : ℂ) * stripKernelNorm σ t z)
      (∫ t : ℝ, (g t : ℂ) * stripKernelDeriv σ t z₀) z₀ := by
  obtain ⟨hz₀a, hz₀b⟩ := hz₀
  set r : ℝ := min (z₀.re / 2) ((1 - z₀.re) / 2) with hrdef
  have hr : 0 < r := lt_min (by linarith) (by linarith)
  set x₁ : ℝ := z₀.re - r with hx₁def
  set x₂ : ℝ := z₀.re + r with hx₂def
  set Y : ℝ := |z₀.im| + r with hYdef
  have hrle₁ : r ≤ z₀.re / 2 := min_le_left _ _
  have hrle₂ : r ≤ (1 - z₀.re) / 2 := min_le_right _ _
  have hx₁ : 0 < x₁ := by rw [hx₁def]; linarith
  have hx₂ : x₂ < 1 := by rw [hx₂def]; linarith
  -- the geometry of the ball
  have hball : ∀ z ∈ Metric.ball z₀ r,
      z.re ∈ Icc x₁ x₂ ∧ |z.im| ≤ Y ∧ z.re ∈ Ioo (0 : ℝ) 1 := by
    intro z hzb
    obtain ⟨h1, h2⟩ := abs_re_im_sub_le_of_mem_ball hzb
    rw [abs_le] at h1 h2
    have hre : z.re ∈ Icc x₁ x₂ := by
      rw [hx₁def, hx₂def]
      exact ⟨by linarith [h1.1], by linarith [h1.2]⟩
    refine ⟨hre, ?_, ?_⟩
    · rw [hYdef, abs_le]
      constructor
      · have hb1 : -|z₀.im| ≤ z₀.im := neg_abs_le _
        linarith [h2.1]
      · have hb2 : z₀.im ≤ |z₀.im| := le_abs_self _
        linarith [h2.2]
    · exact ⟨lt_of_lt_of_le hx₁ hre.1, lt_of_le_of_lt hre.2 hx₂⟩
  set κ : ℝ := (1 - max (Real.cos (π * x₁)) (-Real.cos (π * x₂))) / (2 * Real.cosh (π * Y))
    with hκdef
  have hκ : 0 < κ := strip_denom_uniform_const_pos hx₁ hx₂ (by rw [hx₁def, hx₂def]; linarith)
  have hz₀mem := hball z₀ (Metric.mem_ball_self hr)
  -- the dominating function
  have hbound_int : Integrable fun t : ℝ => π / (2 * κ) * (|g t| / Real.cosh (π * t)) :=
    hg.const_mul _
  refine (_root_.hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (F := fun z t => (g t : ℂ) * stripKernelNorm σ t z)
    (F' := fun z t => (g t : ℂ) * stripKernelDeriv σ t z)
    (bound := fun t : ℝ => π / (2 * κ) * (|g t| / Real.cosh (π * t)))
    (Metric.ball_mem_nhds z₀ hr) ?_ ?_ ?_ ?_ hbound_int ?_).2
  · filter_upwards [Metric.ball_mem_nhds z₀ hr] with z hzb
    obtain ⟨-, -, hzs⟩ := hball z hzb
    exact (Complex.continuous_ofReal.comp_aestronglyMeasurable hgm).mul
      (continuous_stripKernelNorm hσ hzs).aestronglyMeasurable
  · exact integrable_mul_stripKernelNorm hσ hz₀mem.2.2 hgm
      (integrable_mul_re_stripKernelNorm_of_base hσ hgm hg hx₁ hx₂ hz₀mem.1 hz₀mem.2.1
        hz₀mem.2.2)
  · exact (Complex.continuous_ofReal.comp_aestronglyMeasurable hgm).mul
      (continuous_stripKernelDeriv hz₀mem.2.2).aestronglyMeasurable
  · filter_upwards with t z hzb
    obtain ⟨hxm, hym, hzs⟩ := hball z hzb
    have hCt : 0 < Real.cosh (π * t) := Real.cosh_pos _
    have hb := norm_stripKernelDeriv_uniform_le hx₁ hx₂ hσ hxm hym hzs t
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
    calc |g t| * ‖stripKernelDeriv σ t z‖
        ≤ |g t| * (π / (2 * (κ * Real.cosh (π * t)))) :=
          mul_le_mul_of_nonneg_left hb (abs_nonneg _)
      _ = π / (2 * κ) * (|g t| / Real.cosh (π * t)) := by
          field_simp
  · filter_upwards with t z hzb
    obtain ⟨-, -, hzs⟩ := hball z hzb
    exact (hasDerivAt_stripKernelNorm hzs).const_mul (g t : ℂ)

open MeasureTheory in
/-- Specialization of `integrable_mul_re_stripKernelNorm_of_base` to the degenerate rectangle
`{z}`: integrability against the kernel at the base point gives integrability against the kernel
at any interior point. -/
theorem integrable_mul_re_stripKernelNorm {σ : ℝ} (hσ : σ = 1 ∨ σ = -1) {g : ℝ → ℝ}
    (hgm : AEStronglyMeasurable g volume)
    (hg : Integrable fun t : ℝ => |g t| / Real.cosh (π * t))
    {z : ℂ} (hz : z.re ∈ Ioo (0 : ℝ) 1) :
    Integrable fun t : ℝ => g t * (stripKernelNorm σ t z).re :=
  integrable_mul_re_stripKernelNorm_of_base hσ hgm hg hz.1 hz.2 ⟨le_rfl, le_rfl⟩ le_rfl hz

open MeasureTheory in
/-- **The Poisson integral is holomorphic on the open strip.** -/
theorem hasDerivAt_stripPoissonIntegral {g₀ g₁ : ℝ → ℝ}
    (hgm₀ : AEStronglyMeasurable g₀ volume) (hgm₁ : AEStronglyMeasurable g₁ volume)
    (hg₀ : Integrable fun t : ℝ => |g₀ t| / Real.cosh (π * t))
    (hg₁ : Integrable fun t : ℝ => |g₁ t| / Real.cosh (π * t))
    {z₀ : ℂ} (hz₀ : z₀.re ∈ Ioo (0 : ℝ) 1) :
    HasDerivAt (stripPoissonIntegral g₀ g₁)
      ((∫ t : ℝ, (g₀ t : ℂ) * stripKernelDeriv 1 t z₀)
        + ∫ t : ℝ, (g₁ t : ℂ) * stripKernelDeriv (-1) t z₀) z₀ :=
  (hasDerivAt_integral_stripKernelNorm (Or.inl rfl) hgm₀ hg₀ hz₀).add
    (hasDerivAt_integral_stripKernelNorm (Or.inr rfl) hgm₁ hg₁ hz₀)

open MeasureTheory in
theorem differentiableOn_stripPoissonIntegral {g₀ g₁ : ℝ → ℝ}
    (hgm₀ : AEStronglyMeasurable g₀ volume) (hgm₁ : AEStronglyMeasurable g₁ volume)
    (hg₀ : Integrable fun t : ℝ => |g₀ t| / Real.cosh (π * t))
    (hg₁ : Integrable fun t : ℝ => |g₁ t| / Real.cosh (π * t)) :
    DifferentiableOn ℂ (stripPoissonIntegral g₀ g₁) {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1} :=
  fun _ hz =>
    (hasDerivAt_stripPoissonIntegral hgm₀ hgm₁ hg₀ hg₁ hz).differentiableAt.differentiableWithinAt

open MeasureTheory in
/-- The real part of the Poisson integral is the harmonic extension of the boundary data, under
the single hypothesis that the data is integrable against the kernel at the base point. -/
theorem re_stripPoissonIntegral' {g₀ g₁ : ℝ → ℝ}
    (hgm₀ : AEStronglyMeasurable g₀ volume) (hgm₁ : AEStronglyMeasurable g₁ volume)
    (hg₀ : Integrable fun t : ℝ => |g₀ t| / Real.cosh (π * t))
    (hg₁ : Integrable fun t : ℝ => |g₁ t| / Real.cosh (π * t))
    {z : ℂ} (hz : z.re ∈ Ioo (0 : ℝ) 1) :
    (stripPoissonIntegral g₀ g₁ z).re
      = (∫ t : ℝ, g₀ t * poissonStrip z.re 1 (t - z.im))
        + ∫ t : ℝ, g₁ t * poissonStrip z.re (-1) (t - z.im) :=
  re_stripPoissonIntegral hz hgm₀ hgm₁
    (integrable_mul_re_stripKernelNorm (Or.inl rfl) hgm₀ hg₀ hz)
    (integrable_mul_re_stripKernelNorm (Or.inr rfl) hgm₁ hg₁ hz)

/-! ### The kernel as an approximate identity

As the interior point approaches the edge `re z = 0`, the kernel of that edge concentrates at the
corresponding boundary point while the kernel of the opposite edge vanishes uniformly.  The two
estimates below are the quantitative form of this: away from the peak the near kernel is at most
`sin(π x) / (2 (cosh(π δ) - 1))`, and the far kernel is at most `sin(π x) / (2 (1 + cos(π x)))`
everywhere.  Both bounds tend to `0` as `x → 0⁺`, and the near kernel has total mass `1 - x → 1`
(`integral_poissonStripLeft`), which is exactly the peak-function situation. -/

theorem one_lt_cosh_of_ne_zero {x : ℝ} (hx : x ≠ 0) : 1 < Real.cosh x := by
  have h := one_add_sq_div_four_le_cosh x
  have hx2 : 0 < x ^ 2 := by positivity
  linarith

/-- Away from the peak the near kernel is uniformly small. -/
theorem poissonStrip_one_le_of_le_abs {θ δ s : ℝ} (hθ : θ ∈ Ioo (0 : ℝ) 1) (hδ : 0 < δ)
    (hs : δ ≤ |s|) :
    poissonStrip θ 1 s ≤ Real.sin (π * θ) / (2 * (Real.cosh (π * δ) - 1)) := by
  have hpi := Real.pi_pos
  have hsin : 0 < Real.sin (π * θ) := sin_pi_mul_pos hθ
  have hcosδ : 1 < Real.cosh (π * δ) := one_lt_cosh_of_ne_zero (by positivity)
  have hcos1 : Real.cos (π * θ) ≤ 1 := Real.cos_le_one _
  have hmono : Real.cosh (π * δ) ≤ Real.cosh (π * s) := by
    rw [Real.cosh_le_cosh, abs_mul, abs_mul, abs_of_pos hpi]
    have hδabs : |δ| ≤ |s| := by rwa [abs_of_pos hδ]
    exact mul_le_mul_of_nonneg_left hδabs hpi.le
  have hD : 0 < Real.cosh (π * s) - 1 * Real.cos (π * θ) :=
    poissonStrip_denom_pos hθ (by norm_num) s
  have h2 : (0 : ℝ) < 2 * (Real.cosh (π * δ) - 1) := by linarith
  rw [poissonStrip]
  refine div_le_div_of_nonneg_left hsin.le h2 ?_
  simp only [one_mul]
  linarith

/-- The far kernel is uniformly small when the interior point is near the edge `re z = 0`. -/
theorem poissonStrip_neg_one_le {θ s : ℝ} (hθ : θ ∈ Ioo (0 : ℝ) 1) :
    poissonStrip θ (-1) s ≤ Real.sin (π * θ) / (2 * (1 + Real.cos (π * θ))) := by
  have hsin : 0 < Real.sin (π * θ) := sin_pi_mul_pos hθ
  have hc : |Real.cos (π * θ)| < 1 := abs_cos_pi_mul_lt_one hθ
  have hc1 : -1 < Real.cos (π * θ) := by
    have := abs_lt.mp hc
    linarith [this.1]
  have hcosh1 : 1 ≤ Real.cosh (π * s) := Real.one_le_cosh _
  have h2 : (0 : ℝ) < 2 * (1 + Real.cos (π * θ)) := by linarith
  rw [poissonStrip]
  refine div_le_div_of_nonneg_left hsin.le h2 ?_
  have : (-1 : ℝ) * Real.cos (π * θ) = -Real.cos (π * θ) := by ring
  rw [this]
  linarith

/-- Both bounds tend to zero as the interior point approaches the edge. -/
theorem tendsto_sin_pi_mul_zero :
    Filter.Tendsto (fun x : ℝ => Real.sin (π * x)) (nhds 0) (nhds 0) := by
  have hc : Continuous fun x : ℝ => Real.sin (π * x) := by fun_prop
  simpa using hc.tendsto 0

theorem tendsto_poissonStrip_bound_zero (δ : ℝ) :
    Filter.Tendsto (fun x : ℝ => Real.sin (π * x) / (2 * (Real.cosh (π * δ) - 1)))
      (nhds 0) (nhds 0) := by
  simpa using tendsto_sin_pi_mul_zero.div_const (2 * (Real.cosh (π * δ) - 1))

theorem tendsto_poissonStrip_far_bound_zero :
    Filter.Tendsto (fun x : ℝ => Real.sin (π * x) / (2 * (1 + Real.cos (π * x))))
      (nhds 0) (nhds 0) := by
  have hden : Filter.Tendsto (fun x : ℝ => 2 * (1 + Real.cos (π * x))) (nhds 0) (nhds 4) := by
    have hc : Continuous fun x : ℝ => 2 * (1 + Real.cos (π * x)) := by fun_prop
    have := hc.tendsto 0
    norm_num at this
    exact this
  have h := tendsto_sin_pi_mul_zero.div hden (by norm_num)
  rw [show (0 : ℝ) / 4 = 0 by norm_num] at h
  exact h

/-! ### The tail of the boundary limit

The peak-function theorem of Mathlib needs the data to be globally integrable, which the boundary
data here is not: it is integrable only against the kernel.  The limit is therefore split at a
radius `δ` around the peak.  This section handles the outer part: away from the peak the kernel is
bounded by `sin(π x)` times a constant multiple of `1 / cosh(π (t - y))`, and that weight is in
turn comparable to the reference weight `1 / cosh(π t)`.  So the whole outer contribution is
`O(sin(π x))`, which vanishes as the interior point approaches the edge. -/

/-- Away from the peak the kernel is bounded by a multiple of `1 / cosh (π s)`. -/
theorem poissonStrip_one_le_cosh_of_le_abs {x δ s : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) (hδ : 0 < δ)
    (hs : δ ≤ |s|) :
    poissonStrip x 1 s
      ≤ Real.sin (π * x) * (Real.cosh (π * δ) / (Real.cosh (π * δ) - 1))
        / (2 * Real.cosh (π * s)) := by
  have hpi := Real.pi_pos
  have hsin : 0 < Real.sin (π * x) := sin_pi_mul_pos hx
  have hcosδ : 1 < Real.cosh (π * δ) := one_lt_cosh_of_ne_zero (by positivity)
  have hCs : 0 < Real.cosh (π * s) := Real.cosh_pos _
  have hmono : Real.cosh (π * δ) ≤ Real.cosh (π * s) := by
    rw [Real.cosh_le_cosh, abs_mul, abs_mul, abs_of_pos hpi]
    have hδabs : |δ| ≤ |s| := by rwa [abs_of_pos hδ]
    exact mul_le_mul_of_nonneg_left hδabs hpi.le
  have hcos1 : Real.cos (π * x) ≤ 1 := Real.cos_le_one _
  have hD : 0 < Real.cosh (π * s) - 1 * Real.cos (π * x) :=
    poissonStrip_denom_pos hx (by norm_num) s
  -- `cosh (π s) - 1 ≥ cosh (π s) (cosh (π δ) - 1) / cosh (π δ)`
  have hCδ : (0 : ℝ) < Real.cosh (π * δ) := by linarith
  have hkey : Real.cosh (π * s) * ((Real.cosh (π * δ) - 1) / Real.cosh (π * δ))
      ≤ Real.cosh (π * s) - 1 * Real.cos (π * x) := by
    rw [mul_div_assoc', div_le_iff₀ hCδ]
    have h1 : Real.cos (π * x) * Real.cosh (π * δ) ≤ 1 * Real.cosh (π * δ) :=
      mul_le_mul_of_nonneg_right hcos1 hCδ.le
    nlinarith [h1, hmono]
  have hpos : (0 : ℝ) < 2 * (Real.cosh (π * s) * ((Real.cosh (π * δ) - 1)
      / Real.cosh (π * δ))) := by
    have : 0 < (Real.cosh (π * δ) - 1) / Real.cosh (π * δ) := by positivity
    positivity
  rw [poissonStrip]
  have hstep : Real.sin (π * x) / (2 * (Real.cosh (π * s) - 1 * Real.cos (π * x)))
      ≤ Real.sin (π * x) / (2 * (Real.cosh (π * s)
        * ((Real.cosh (π * δ) - 1) / Real.cosh (π * δ)))) :=
    div_le_div_of_nonneg_left hsin.le hpos (by linarith)
  refine hstep.trans (le_of_eq ?_)
  field_simp

/-- The reference weight is comparable to its translates. -/
theorem inv_cosh_sub_le (t y : ℝ) :
    1 / Real.cosh (π * (t - y)) ≤ 2 * Real.cosh (π * y) / Real.cosh (π * t) := by
  have h := cosh_sub_lower (π * t) (π * y)
  rw [show π * t - π * y = π * (t - y) by ring] at h
  have hCt : 0 < Real.cosh (π * t) := Real.cosh_pos _
  have hCy : 0 < Real.cosh (π * y) := Real.cosh_pos _
  have hCd : 0 < Real.cosh (π * (t - y)) := Real.cosh_pos _
  rw [div_le_iff₀ (by positivity)] at h
  rw [div_le_div_iff₀ hCd hCt]
  linarith

open MeasureTheory in
/-- Boundary data integrable against the reference weight is integrable against every translate
of it. -/
theorem integrable_weight_translate {g : ℝ → ℝ} (hgm : AEStronglyMeasurable g volume)
    (hg : Integrable fun t : ℝ => |g t| / Real.cosh (π * t)) (y : ℝ) :
    Integrable fun t : ℝ => |g t| / Real.cosh (π * (t - y)) := by
  have hCy : 0 < Real.cosh (π * y) := Real.cosh_pos _
  have habs : AEStronglyMeasurable (fun t : ℝ => |g t|) volume := by
    simpa [Real.norm_eq_abs] using hgm.norm
  have hcont : Continuous fun t : ℝ => Real.cosh (π * (t - y)) := by fun_prop
  have hinv : Continuous fun t : ℝ => (Real.cosh (π * (t - y)))⁻¹ :=
    hcont.inv₀ fun t => (Real.cosh_pos _).ne'
  have hmeas : AEStronglyMeasurable
      (fun t : ℝ => |g t| / Real.cosh (π * (t - y))) volume := by
    simp only [div_eq_mul_inv]
    exact habs.mul hinv.aestronglyMeasurable
  refine Integrable.mono' (hg.const_mul (2 * Real.cosh (π * y))) hmeas ?_
  filter_upwards with t
  have hCd : 0 < Real.cosh (π * (t - y)) := Real.cosh_pos _
  have hCt : 0 < Real.cosh (π * t) := Real.cosh_pos _
  rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
  calc |g t| / Real.cosh (π * (t - y)) = |g t| * (1 / Real.cosh (π * (t - y))) := by ring
    _ ≤ |g t| * (2 * Real.cosh (π * y) / Real.cosh (π * t)) :=
        mul_le_mul_of_nonneg_left (inv_cosh_sub_le t y) (abs_nonneg _)
    _ = 2 * Real.cosh (π * y) * (|g t| / Real.cosh (π * t)) := by ring


open MeasureTheory in
/-- **The tail estimate.**  The contribution to the Poisson integral of the region at distance at
least `δ` from the peak is `O(sin (π x))`, with a constant depending only on `δ`, on the height
`y` of the point, and on the weighted `L¹` norm of the boundary data.  Since `sin (π x) → 0` as
`x → 0⁺`, this contribution vanishes in the boundary limit. -/
theorem integral_tail_le {g : ℝ → ℝ} (hgm : AEStronglyMeasurable g volume)
    (hg : Integrable fun t : ℝ => |g t| / Real.cosh (π * t))
    {x δ y : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) (hδ : 0 < δ) :
    ∫ t : ℝ, Set.indicator {t : ℝ | δ ≤ |t - y|}
        (fun t => |g t| * poissonStrip x 1 (t - y)) t
      ≤ Real.sin (π * x) * (Real.cosh (π * δ) / (Real.cosh (π * δ) - 1))
          * Real.cosh (π * y)
        * ∫ t : ℝ, |g t| / Real.cosh (π * t) := by
  have hsin : 0 < Real.sin (π * x) := sin_pi_mul_pos hx
  have hcosδ : 1 < Real.cosh (π * δ) := one_lt_cosh_of_ne_zero (by positivity)
  have hCy : 0 < Real.cosh (π * y) := Real.cosh_pos _
  have hratio : 0 < Real.cosh (π * δ) / (Real.cosh (π * δ) - 1) := by
    have h1 : (0 : ℝ) < Real.cosh (π * δ) - 1 := by linarith
    positivity
  set C : ℝ := Real.sin (π * x) * (Real.cosh (π * δ) / (Real.cosh (π * δ) - 1))
    * Real.cosh (π * y) with hCdef
  have hC : 0 < C := by rw [hCdef]; positivity
  have habs : AEStronglyMeasurable (fun t : ℝ => |g t|) volume := by
    simpa [Real.norm_eq_abs] using hgm.norm
  have hkercont : Continuous fun t : ℝ => poissonStrip x 1 (t - y) :=
    (continuous_poissonStrip hx (by norm_num)).comp (continuous_id.sub continuous_const)
  have hsetm : MeasurableSet {t : ℝ | δ ≤ |t - y|} :=
    measurableSet_le measurable_const (by fun_prop)
  have hprodm : AEStronglyMeasurable
      (fun t : ℝ => |g t| * poissonStrip x 1 (t - y)) volume :=
    habs.mul hkercont.aestronglyMeasurable
  have hbound_int : Integrable fun t : ℝ => C * (|g t| / Real.cosh (π * t)) := hg.const_mul C
  -- the pointwise bound
  have hle : ∀ t : ℝ, Set.indicator {t : ℝ | δ ≤ |t - y|}
      (fun t => |g t| * poissonStrip x 1 (t - y)) t
      ≤ C * (|g t| / Real.cosh (π * t)) := by
    intro t
    have hCt : 0 < Real.cosh (π * t) := Real.cosh_pos _
    by_cases ht : t ∈ {t : ℝ | δ ≤ |t - y|}
    · simp only [Set.indicator_apply, if_pos ht]
      have hker := poissonStrip_one_le_cosh_of_le_abs hx hδ (Set.mem_setOf_eq ▸ ht)
      have hCd : 0 < Real.cosh (π * (t - y)) := Real.cosh_pos _
      have hfac : (0 : ℝ)
          ≤ Real.sin (π * x) * (Real.cosh (π * δ) / (Real.cosh (π * δ) - 1)) / 2 := by
        positivity
      calc |g t| * poissonStrip x 1 (t - y)
          ≤ |g t| * (Real.sin (π * x) * (Real.cosh (π * δ) / (Real.cosh (π * δ) - 1))
              / (2 * Real.cosh (π * (t - y)))) :=
            mul_le_mul_of_nonneg_left hker (abs_nonneg _)
        _ = Real.sin (π * x) * (Real.cosh (π * δ) / (Real.cosh (π * δ) - 1)) / 2
              * (|g t| * (1 / Real.cosh (π * (t - y)))) := by
            field_simp
        _ ≤ Real.sin (π * x) * (Real.cosh (π * δ) / (Real.cosh (π * δ) - 1)) / 2
              * (|g t| * (2 * Real.cosh (π * y) / Real.cosh (π * t))) := by
            refine mul_le_mul_of_nonneg_left ?_ hfac
            exact mul_le_mul_of_nonneg_left (inv_cosh_sub_le t y) (abs_nonneg _)
        _ = C * (|g t| / Real.cosh (π * t)) := by
            rw [hCdef]
            field_simp
    · simp only [Set.indicator_apply, if_neg ht]
      positivity
  have hind_int : Integrable (Set.indicator {t : ℝ | δ ≤ |t - y|}
      (fun t => |g t| * poissonStrip x 1 (t - y))) volume := by
    refine Integrable.mono' hbound_int (hprodm.indicator hsetm) ?_
    filter_upwards with t
    have hnn : 0 ≤ Set.indicator {t : ℝ | δ ≤ |t - y|}
        (fun t => |g t| * poissonStrip x 1 (t - y)) t := by
      refine Set.indicator_nonneg (fun s _ => ?_) t
      have := (poissonStrip_pos (σ := 1) hx (by norm_num) (s - y)).le
      positivity
    rw [Real.norm_eq_abs, abs_of_nonneg hnn]
    exact hle t
  calc ∫ t : ℝ, Set.indicator {t : ℝ | δ ≤ |t - y|}
        (fun t => |g t| * poissonStrip x 1 (t - y)) t
      ≤ ∫ t : ℝ, C * (|g t| / Real.cosh (π * t)) := integral_mono hind_int hbound_int hle
    _ = C * ∫ t : ℝ, |g t| / Real.cosh (π * t) := integral_const_mul _ _


/-! ### The Poisson average of boundary data

Everything needed for the boundary limit is now phrased in terms of the *Poisson average*
`∫ g t * poissonStrip x 1 (t - y) dt`.  This section records that the average is well defined and
computes the mass of the kernel, and then splits the average at radius `δ` around the peak. -/

/-- A global bound for the kernel by a multiple of the reference weight. -/
theorem poissonStrip_le_global {x σ s : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) (hσ : |σ| ≤ 1) :
    poissonStrip x σ s
      ≤ Real.sin (π * x) / (2 * (1 - |Real.cos (π * x)|)) / Real.cosh (π * s) := by
  have hsin : 0 < Real.sin (π * x) := sin_pi_mul_pos hx
  have hc : |Real.cos (π * x)| < 1 := abs_cos_pi_mul_lt_one hx
  have hCs : 0 < Real.cosh (π * s) := Real.cosh_pos _
  have hCs1 : 1 ≤ Real.cosh (π * s) := Real.one_le_cosh _
  have hD : 0 < Real.cosh (π * s) - σ * Real.cos (π * x) :=
    poissonStrip_denom_pos hx hσ s
  have hlow : (1 - |Real.cos (π * x)|) * Real.cosh (π * s)
      ≤ Real.cosh (π * s) - σ * Real.cos (π * x) := by
    have h1 : σ * Real.cos (π * x) ≤ |Real.cos (π * x)| := by
      calc σ * Real.cos (π * x) ≤ |σ * Real.cos (π * x)| := le_abs_self _
        _ = |σ| * |Real.cos (π * x)| := abs_mul _ _
        _ ≤ 1 * |Real.cos (π * x)| := mul_le_mul_of_nonneg_right hσ (abs_nonneg _)
        _ = |Real.cos (π * x)| := one_mul _
    nlinarith [abs_nonneg (Real.cos (π * x)), hCs1]
  have hpos : (0 : ℝ) < 2 * ((1 - |Real.cos (π * x)|) * Real.cosh (π * s)) := by
    have : (0 : ℝ) < 1 - |Real.cos (π * x)| := by linarith
    positivity
  rw [poissonStrip]
  refine (div_le_div_of_nonneg_left hsin.le hpos (by linarith)).trans (le_of_eq ?_)
  have h1 : (0 : ℝ) < 1 - |Real.cos (π * x)| := by linarith
  field_simp

open MeasureTheory in
/-- The Poisson average of weighted-integrable boundary data is well defined. -/
theorem integrable_mul_poissonStrip {g : ℝ → ℝ} (hgm : AEStronglyMeasurable g volume)
    (hg : Integrable fun t : ℝ => |g t| / Real.cosh (π * t)) {x σ : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1)
    (hσ : |σ| ≤ 1) (y : ℝ) : Integrable fun t : ℝ => g t * poissonStrip x σ (t - y) := by
  have hc : |Real.cos (π * x)| < 1 := abs_cos_pi_mul_lt_one hx
  have h1 : (0 : ℝ) < 1 - |Real.cos (π * x)| := by linarith
  have hsin : 0 < Real.sin (π * x) := sin_pi_mul_pos hx
  set K : ℝ := Real.sin (π * x) / (2 * (1 - |Real.cos (π * x)|)) with hKdef
  have hK : 0 < K := by rw [hKdef]; positivity
  have habs : AEStronglyMeasurable (fun t : ℝ => |g t|) volume := by
    simpa [Real.norm_eq_abs] using hgm.norm
  have hkercont : Continuous fun t : ℝ => poissonStrip x σ (t - y) :=
    (continuous_poissonStrip hx hσ).comp (continuous_id.sub continuous_const)
  refine Integrable.mono' ((integrable_weight_translate hgm hg y).const_mul K)
    (hgm.mul hkercont.aestronglyMeasurable) ?_
  filter_upwards with t
  have hCd : 0 < Real.cosh (π * (t - y)) := Real.cosh_pos _
  have hker := poissonStrip_le_global (s := t - y) hx hσ
  have hkerpos : 0 < poissonStrip x σ (t - y) := poissonStrip_pos hx hσ _
  rw [Real.norm_eq_abs, abs_mul, abs_of_pos hkerpos]
  calc |g t| * poissonStrip x σ (t - y)
      ≤ |g t| * (K / Real.cosh (π * (t - y))) :=
        mul_le_mul_of_nonneg_left hker (abs_nonneg _)
    _ = K * (|g t| / Real.cosh (π * (t - y))) := by ring

open MeasureTheory in
/-- The mass of the kernel at the interior point `x + i y` is `1 - x`, independently of `y`. -/
theorem integral_poissonStrip_translate (x y : ℝ) (hx : x ∈ Ioo (0 : ℝ) 1) :
    ∫ t : ℝ, poissonStrip x 1 (t - y) = 1 - x := by
  rw [integral_sub_right_eq_self (fun t : ℝ => poissonStrip x 1 t) y,
    integral_poissonStrip_one hx]


open MeasureTheory in
/-- The reference weight is integrable: it is twice the kernel at the base point. -/
theorem integrable_inv_cosh : Integrable fun t : ℝ => 1 / Real.cosh (π * t) := by
  have hmem : (1 / 2 : ℝ) ∈ Ioo (0 : ℝ) 1 := by constructor <;> norm_num
  have h := integrable_poissonStrip (θ := 1 / 2) (σ := 1) hmem (by norm_num)
  have hfun : (fun t : ℝ => poissonStrip (1 / 2) 1 t)
      = fun t : ℝ => 1 / (2 * Real.cosh (π * t)) := by
    funext t
    rw [poissonStrip, show π * (1 / 2 : ℝ) = π / 2 by ring, Real.cos_pi_div_two,
      Real.sin_pi_div_two, mul_zero, sub_zero]
  rw [hfun] at h
  refine (h.const_mul (2 : ℝ)).congr ?_
  filter_upwards with t
  have hCt : (0 : ℝ) < Real.cosh (π * t) := Real.cosh_pos _
  field_simp

open MeasureTheory in
theorem integrable_poissonStrip_translate {x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) (y : ℝ) :
    Integrable fun t : ℝ => poissonStrip x 1 (t - y) := by
  have h := (integrable_poissonStrip hx (by norm_num : |(1 : ℝ)| ≤ 1)).comp_sub_right y
  exact h

open MeasureTheory in
/-- The tail mass of the kernel is `O(sin (π x))`. -/
theorem tail_mass_le {x δ y : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) (hδ : 0 < δ) :
    ∫ t : ℝ, Set.indicator {t : ℝ | δ ≤ |t - y|}
        (fun t => poissonStrip x 1 (t - y)) t
      ≤ Real.sin (π * x) * (Real.cosh (π * δ) / (Real.cosh (π * δ) - 1)) * Real.cosh (π * y)
        * ∫ t : ℝ, 1 / Real.cosh (π * t) := by
  have h := integral_tail_le (g := fun _ : ℝ => (1 : ℝ)) aestronglyMeasurable_const
    (by simpa using integrable_inv_cosh) hx hδ (y := y)
  simpa using h


open MeasureTheory in
/-- **The boundary estimate.**  The Poisson average of `g` at the interior point `x + i y`
differs from `g y` by at most the local oscillation of `g` on a `δ`-neighbourhood of `y`, plus
two terms that vanish as `x → 0⁺`.  This is the quantitative form of the statement that the
kernel of the edge `re z = 0` is an approximate identity. -/
theorem abs_poissonAverage_sub_le {g : ℝ → ℝ} (hgm : AEStronglyMeasurable g volume)
    (hg : Integrable fun t : ℝ => |g t| / Real.cosh (π * t))
    {x δ y ε : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) (hδ : 0 < δ) (hε : 0 ≤ ε)
    (hosc : ∀ t : ℝ, |t - y| < δ → |g t - g y| ≤ ε) :
    |(∫ t : ℝ, g t * poissonStrip x 1 (t - y)) - g y|
      ≤ ε + |g y| * x
        + Real.sin (π * x) * (Real.cosh (π * δ) / (Real.cosh (π * δ) - 1)) * Real.cosh (π * y)
          * ((∫ t : ℝ, |g t| / Real.cosh (π * t))
            + |g y| * ∫ t : ℝ, 1 / Real.cosh (π * t)) := by
  have hBm : MeasurableSet {t : ℝ | δ ≤ |t - y|} :=
    measurableSet_le measurable_const (by fun_prop)
  have hwpos : ∀ t : ℝ, 0 < poissonStrip x 1 (t - y) :=
    fun t => poissonStrip_pos hx (by norm_num) _
  have hwint : Integrable fun t : ℝ => poissonStrip x 1 (t - y) :=
    integrable_poissonStrip_translate hx y
  have hmass : (∫ t : ℝ, poissonStrip x 1 (t - y)) = 1 - x :=
    integral_poissonStrip_translate x y hx
  have habs : AEStronglyMeasurable (fun t : ℝ => |g t|) volume := by
    simpa [Real.norm_eq_abs] using hgm.norm
  have hgw : Integrable fun t : ℝ => g t * poissonStrip x 1 (t - y) :=
    integrable_mul_poissonStrip hgm hg hx (by norm_num) y
  have habsw : Integrable fun t : ℝ => |g t| * poissonStrip x 1 (t - y) :=
    integrable_mul_poissonStrip habs (by simpa using hg) hx (by norm_num) y
  have hdiffint : Integrable fun t : ℝ => (g t - g y) * poissonStrip x 1 (t - y) := by
    have h2 : (fun t : ℝ => (g t - g y) * poissonStrip x 1 (t - y))
        = fun t : ℝ => g t * poissonStrip x 1 (t - y)
          - g y * poissonStrip x 1 (t - y) := by
      funext t; ring
    rw [h2]
    exact hgw.sub (hwint.const_mul (g y))
  have hsub : (∫ t : ℝ, (g t - g y) * poissonStrip x 1 (t - y))
      = (∫ t : ℝ, g t * poissonStrip x 1 (t - y)) - g y * (1 - x) := by
    have h1 : (fun t : ℝ => (g t - g y) * poissonStrip x 1 (t - y))
        = fun t : ℝ => g t * poissonStrip x 1 (t - y)
          - g y * poissonStrip x 1 (t - y) := by
      funext t; ring
    rw [h1, integral_sub hgw (hwint.const_mul (g y)), integral_const_mul, hmass]
  -- the three pieces of the majorant
  have hA : Integrable (fun t : ℝ => ε * poissonStrip x 1 (t - y)) volume := hwint.const_mul ε
  have hB : Integrable (fun t : ℝ => Set.indicator {t : ℝ | δ ≤ |t - y|}
      (fun t => |g t| * poissonStrip x 1 (t - y)) t) volume := habsw.indicator hBm
  have hC : Integrable (fun t : ℝ => |g y| * Set.indicator {t : ℝ | δ ≤ |t - y|}
      (fun t => poissonStrip x 1 (t - y)) t) volume := (hwint.indicator hBm).const_mul _
  have hAB : Integrable (fun t : ℝ => ε * poissonStrip x 1 (t - y)
      + Set.indicator {t : ℝ | δ ≤ |t - y|}
          (fun t => |g t| * poissonStrip x 1 (t - y)) t) volume := hA.add hB
  have hRint : Integrable (fun t : ℝ => (ε * poissonStrip x 1 (t - y)
      + Set.indicator {t : ℝ | δ ≤ |t - y|}
          (fun t => |g t| * poissonStrip x 1 (t - y)) t)
      + |g y| * Set.indicator {t : ℝ | δ ≤ |t - y|}
          (fun t => poissonStrip x 1 (t - y)) t) volume := hAB.add hC
  have hmaj : ∀ t : ℝ, ‖(g t - g y) * poissonStrip x 1 (t - y)‖
      ≤ (ε * poissonStrip x 1 (t - y)
        + Set.indicator {t : ℝ | δ ≤ |t - y|}
            (fun t => |g t| * poissonStrip x 1 (t - y)) t)
        + |g y| * Set.indicator {t : ℝ | δ ≤ |t - y|}
            (fun t => poissonStrip x 1 (t - y)) t := by
    intro t
    have hw := hwpos t
    rw [Real.norm_eq_abs, abs_mul, abs_of_pos hw]
    by_cases ht : t ∈ {t : ℝ | δ ≤ |t - y|}
    · simp only [Set.indicator_apply, if_pos ht]
      have h1 : |g t - g y| ≤ |g t| + |g y| := by
        rw [sub_eq_add_neg]
        simpa using abs_add_le (g t) (-g y)
      nlinarith [hw.le, h1, mul_nonneg hε hw.le]
    · simp only [Set.indicator_apply, if_neg ht]
      have hlt : |t - y| < δ := by
        by_contra hcon
        exact ht (Set.mem_setOf_eq ▸ not_lt.mp hcon)
      nlinarith [hw.le, hosc t hlt, abs_nonneg (g y)]
  have hL : |∫ t : ℝ, (g t - g y) * poissonStrip x 1 (t - y)|
      ≤ ∫ t : ℝ, ((ε * poissonStrip x 1 (t - y)
        + Set.indicator {t : ℝ | δ ≤ |t - y|}
            (fun t => |g t| * poissonStrip x 1 (t - y)) t)
        + |g y| * Set.indicator {t : ℝ | δ ≤ |t - y|}
            (fun t => poissonStrip x 1 (t - y)) t) := by
    have h1 := norm_integral_le_integral_norm
      (μ := (volume : Measure ℝ))
      (f := fun t : ℝ => (g t - g y) * poissonStrip x 1 (t - y))
    rw [Real.norm_eq_abs] at h1
    exact h1.trans (integral_mono hdiffint.norm hRint hmaj)
  have hRval : (∫ t : ℝ, ((ε * poissonStrip x 1 (t - y)
        + Set.indicator {t : ℝ | δ ≤ |t - y|}
            (fun t => |g t| * poissonStrip x 1 (t - y)) t)
        + |g y| * Set.indicator {t : ℝ | δ ≤ |t - y|}
            (fun t => poissonStrip x 1 (t - y)) t))
      = ε * (1 - x)
        + (∫ t : ℝ, Set.indicator {t : ℝ | δ ≤ |t - y|}
            (fun t => |g t| * poissonStrip x 1 (t - y)) t)
        + |g y| * ∫ t : ℝ, Set.indicator {t : ℝ | δ ≤ |t - y|}
            (fun t => poissonStrip x 1 (t - y)) t := by
    rw [integral_add hAB hC, integral_add hA hB, integral_const_mul, integral_const_mul, hmass]
  have hTg := integral_tail_le hgm hg hx hδ (y := y)
  have hT1 := tail_mass_le hx hδ (y := y)
  have hx0 : 0 < x := hx.1
  have hx1 : x < 1 := hx.2
  have hgy : 0 ≤ |g y| := abs_nonneg _
  have hcomb : |(∫ t : ℝ, g t * poissonStrip x 1 (t - y)) - g y|
      ≤ |∫ t : ℝ, (g t - g y) * poissonStrip x 1 (t - y)| + |g y| * x := by
    have heq : (∫ t : ℝ, g t * poissonStrip x 1 (t - y)) - g y
        = (∫ t : ℝ, (g t - g y) * poissonStrip x 1 (t - y)) + -(g y * x) := by
      rw [hsub]; ring
    rw [heq]
    refine (abs_add_le _ _).trans ?_
    rw [abs_neg, abs_mul, abs_of_pos hx0]
  refine hcomb.trans ?_
  rw [hRval] at hL
  nlinarith [hL, hTg, hT1, hgy, hε, hx0.le, hx1]


open MeasureTheory in
/-- **The boundary limit.**  For weighted-integrable boundary data that is continuous at `y`, the
Poisson average converges to the boundary value as the interior point approaches the edge
`re z = 0` at height `y`.  This is the approximate-identity property of the strip kernel. -/
theorem tendsto_poissonAverage {g : ℝ → ℝ} (hgm : AEStronglyMeasurable g volume)
    (hg : Integrable fun t : ℝ => |g t| / Real.cosh (π * t)) {y : ℝ}
    (hcont : ContinuousAt g y) :
    Filter.Tendsto (fun x : ℝ => ∫ t : ℝ, g t * poissonStrip x 1 (t - y))
      (nhdsWithin 0 (Ioo (0 : ℝ) 1)) (nhds (g y)) := by
  have hW1 : 0 ≤ ∫ t : ℝ, 1 / Real.cosh (π * t) := by
    refine integral_nonneg fun t => ?_
    have : (0 : ℝ) < Real.cosh (π * t) := Real.cosh_pos _
    positivity
  have hWg : 0 ≤ ∫ t : ℝ, |g t| / Real.cosh (π * t) := by
    refine integral_nonneg fun t => ?_
    have : (0 : ℝ) < Real.cosh (π * t) := Real.cosh_pos _
    positivity
  rw [Metric.tendsto_nhdsWithin_nhds]
  intro ε' hε'
  obtain ⟨δ, hδpos, hδ⟩ := Metric.continuousAt_iff.mp hcont (ε' / 4) (by linarith)
  have hosc : ∀ t : ℝ, |t - y| < δ → |g t - g y| ≤ ε' / 4 := by
    intro t ht
    have := hδ (by rwa [Real.dist_eq])
    rw [Real.dist_eq] at this
    exact this.le
  have hcosδ : 1 < Real.cosh (π * δ) := one_lt_cosh_of_ne_zero (by positivity)
  set K : ℝ := Real.cosh (π * δ) / (Real.cosh (π * δ) - 1) * Real.cosh (π * y) with hKdef
  set W : ℝ := (∫ t : ℝ, |g t| / Real.cosh (π * t))
    + |g y| * ∫ t : ℝ, 1 / Real.cosh (π * t) with hWdef
  have hK : 0 < K := by
    rw [hKdef]
    have h1 : (0 : ℝ) < Real.cosh (π * δ) - 1 := by linarith
    have h2 : (0 : ℝ) < Real.cosh (π * y) := Real.cosh_pos _
    positivity
  have hW : 0 ≤ W := by
    rw [hWdef]
    have := abs_nonneg (g y)
    positivity
  set C : ℝ := |g y| + π * (K * W) + 1 with hCdef
  have hC : 0 < C := by
    rw [hCdef]
    have h1 : (0 : ℝ) ≤ π * (K * W) := by positivity
    have h2 : (0 : ℝ) ≤ |g y| := abs_nonneg _
    linarith
  refine ⟨min 1 (ε' / (2 * C)), lt_min one_pos (by positivity), ?_⟩
  intro x hxs hxd
  obtain ⟨hx0, hx1⟩ := hxs
  have hxlt : x < ε' / (2 * C) := by
    rw [Real.dist_eq, sub_zero, abs_of_pos hx0] at hxd
    exact lt_of_lt_of_le hxd (min_le_right _ _)
  have hsinle : Real.sin (π * x) ≤ π * x := Real.sin_le (by positivity)
  have hsinpos : 0 < Real.sin (π * x) := sin_pi_mul_pos ⟨hx0, hx1⟩
  have hmain := abs_poissonAverage_sub_le hgm hg ⟨hx0, hx1⟩ hδpos (by linarith : (0:ℝ) ≤ ε' / 4)
    hosc (y := y)
  -- the two vanishing terms are at most `C * x`
  have hF : |g y| * x + Real.sin (π * x) * K * W ≤ C * x := by
    have h1 : Real.sin (π * x) * K * W ≤ π * x * (K * W) := by
      have hKW : 0 ≤ K * W := by positivity
      nlinarith [hsinle, hKW]
    rw [hCdef]
    nlinarith [h1, hx0.le]
  have hCx : C * x < ε' / 2 := by
    calc C * x < C * (ε' / (2 * C)) := mul_lt_mul_of_pos_left hxlt hC
      _ = ε' / 2 := by field_simp
  rw [Real.dist_eq]
  have hrewrite : Real.sin (π * x) * (Real.cosh (π * δ) / (Real.cosh (π * δ) - 1))
      * Real.cosh (π * y) * ((∫ t : ℝ, |g t| / Real.cosh (π * t))
        + |g y| * ∫ t : ℝ, 1 / Real.cosh (π * t))
      = Real.sin (π * x) * K * W := by rw [hKdef, hWdef]; ring
  rw [hrewrite] at hmain
  linarith [hmain, hF, hCx]


/-! ### The far edge

As the interior point approaches the edge `re z = 0`, the kernel of the opposite edge vanishes:
for `x ≤ 1/2` it is at most `sin(π x) / (2 cosh(π s))`, so the far-edge Poisson average is
`O(sin(π x))` and tends to zero. -/

theorem poissonStrip_neg_one_le_cosh {x s : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) (hx2 : x ≤ 1 / 2) :
    poissonStrip x (-1) s ≤ Real.sin (π * x) / (2 * Real.cosh (π * s)) := by
  have hpi := Real.pi_pos
  have hsin : 0 < Real.sin (π * x) := sin_pi_mul_pos hx
  have hCs : 0 < Real.cosh (π * s) := Real.cosh_pos _
  have hcosnn : 0 ≤ Real.cos (π * x) := by
    refine Real.cos_nonneg_of_mem_Icc ⟨?_, ?_⟩
    · nlinarith [hx.1]
    · nlinarith
  have hD : 0 < Real.cosh (π * s) - (-1) * Real.cos (π * x) :=
    poissonStrip_denom_pos hx (by norm_num) s
  have h2Cs : (0 : ℝ) < 2 * Real.cosh (π * s) := by linarith
  rw [poissonStrip]
  exact div_le_div_of_nonneg_left hsin.le h2Cs (by linarith)

open MeasureTheory in
/-- The far-edge Poisson average is `O(sin (π x))`. -/
theorem abs_poissonAverage_far_le {g : ℝ → ℝ} (hgm : AEStronglyMeasurable g volume)
    (hg : Integrable fun t : ℝ => |g t| / Real.cosh (π * t))
    {x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) (hx2 : x ≤ 1 / 2) (y : ℝ) :
    |∫ t : ℝ, g t * poissonStrip x (-1) (t - y)|
      ≤ Real.sin (π * x) * Real.cosh (π * y) * ∫ t : ℝ, |g t| / Real.cosh (π * t) := by
  have habs : AEStronglyMeasurable (fun t : ℝ => |g t|) volume := by
    simpa [Real.norm_eq_abs] using hgm.norm
  have hCy : 0 < Real.cosh (π * y) := Real.cosh_pos _
  have hsin : 0 < Real.sin (π * x) := sin_pi_mul_pos hx
  have hgw : Integrable fun t : ℝ => g t * poissonStrip x (-1) (t - y) :=
    integrable_mul_poissonStrip hgm hg hx (by norm_num) y
  have habsw : Integrable fun t : ℝ => |g t| * poissonStrip x (-1) (t - y) :=
    integrable_mul_poissonStrip habs (by simpa using hg) hx (by norm_num) y
  have htrans : Integrable fun t : ℝ => |g t| / Real.cosh (π * (t - y)) :=
    integrable_weight_translate hgm hg y
  have hWg : 0 ≤ ∫ t : ℝ, |g t| / Real.cosh (π * t) := by
    refine integral_nonneg fun t => ?_
    have : (0 : ℝ) < Real.cosh (π * t) := Real.cosh_pos _
    positivity
  have hstep1 : |∫ t : ℝ, g t * poissonStrip x (-1) (t - y)|
      ≤ ∫ t : ℝ, |g t| * poissonStrip x (-1) (t - y) := by
    have h1 := norm_integral_le_integral_norm (μ := (volume : Measure ℝ))
      (f := fun t : ℝ => g t * poissonStrip x (-1) (t - y))
    rw [Real.norm_eq_abs] at h1
    refine h1.trans (le_of_eq (integral_congr_ae ?_))
    filter_upwards with t
    rw [Real.norm_eq_abs, abs_mul,
      abs_of_pos (poissonStrip_pos hx (by norm_num : |(-1 : ℝ)| ≤ 1) (t - y))]
  have hstep2 : (∫ t : ℝ, |g t| * poissonStrip x (-1) (t - y))
      ≤ Real.sin (π * x) / 2 * ∫ t : ℝ, |g t| / Real.cosh (π * (t - y)) := by
    rw [← integral_const_mul]
    refine integral_mono habsw (htrans.const_mul _) ?_
    intro t
    have hker := poissonStrip_neg_one_le_cosh (s := t - y) hx hx2
    have hCd : 0 < Real.cosh (π * (t - y)) := Real.cosh_pos _
    calc |g t| * poissonStrip x (-1) (t - y)
        ≤ |g t| * (Real.sin (π * x) / (2 * Real.cosh (π * (t - y)))) :=
          mul_le_mul_of_nonneg_left hker (abs_nonneg _)
      _ = Real.sin (π * x) / 2 * (|g t| / Real.cosh (π * (t - y))) := by
          field_simp
  have hstep3 : (∫ t : ℝ, |g t| / Real.cosh (π * (t - y)))
      ≤ 2 * Real.cosh (π * y) * ∫ t : ℝ, |g t| / Real.cosh (π * t) := by
    rw [← integral_const_mul]
    refine integral_mono htrans (hg.const_mul _) ?_
    intro t
    have hCd : 0 < Real.cosh (π * (t - y)) := Real.cosh_pos _
    have hCt : 0 < Real.cosh (π * t) := Real.cosh_pos _
    calc |g t| / Real.cosh (π * (t - y)) = |g t| * (1 / Real.cosh (π * (t - y))) := by ring
      _ ≤ |g t| * (2 * Real.cosh (π * y) / Real.cosh (π * t)) :=
          mul_le_mul_of_nonneg_left (inv_cosh_sub_le t y) (abs_nonneg _)
      _ = 2 * Real.cosh (π * y) * (|g t| / Real.cosh (π * t)) := by ring
  nlinarith [hstep1, hstep2, hstep3, hsin.le, hWg, hCy.le]

open MeasureTheory in
/-- The far-edge Poisson average tends to zero as the interior point approaches the near edge. -/
theorem tendsto_poissonAverage_far {g : ℝ → ℝ} (hgm : AEStronglyMeasurable g volume)
    (hg : Integrable fun t : ℝ => |g t| / Real.cosh (π * t)) (y : ℝ) :
    Filter.Tendsto (fun x : ℝ => ∫ t : ℝ, g t * poissonStrip x (-1) (t - y))
      (nhdsWithin 0 (Ioo (0 : ℝ) (1 / 2))) (nhds 0) := by
  have hCy : 0 < Real.cosh (π * y) := Real.cosh_pos _
  have hWg : 0 ≤ ∫ t : ℝ, |g t| / Real.cosh (π * t) := by
    refine integral_nonneg fun t => ?_
    have : (0 : ℝ) < Real.cosh (π * t) := Real.cosh_pos _
    positivity
  rw [Metric.tendsto_nhdsWithin_nhds]
  intro ε hε
  set C : ℝ := π * (Real.cosh (π * y) * ∫ t : ℝ, |g t| / Real.cosh (π * t)) + 1 with hCdef
  have hC : 0 < C := by
    rw [hCdef]
    have : (0 : ℝ) ≤ π * (Real.cosh (π * y) * ∫ t : ℝ, |g t| / Real.cosh (π * t)) := by positivity
    linarith
  refine ⟨ε / C, by positivity, ?_⟩
  intro x hxs hxd
  obtain ⟨hx0, hx2⟩ := hxs
  have hxlt : x < ε / C := by
    rwa [Real.dist_eq, sub_zero, abs_of_pos hx0] at hxd
  have hx1 : x ∈ Ioo (0 : ℝ) 1 := ⟨hx0, by linarith⟩
  have hmain := abs_poissonAverage_far_le hgm hg hx1 (by linarith) y
  have hsinle : Real.sin (π * x) ≤ π * x := Real.sin_le (by positivity)
  have hbound : Real.sin (π * x) * Real.cosh (π * y) * (∫ t : ℝ, |g t| / Real.cosh (π * t))
      ≤ C * x := by
    rw [hCdef]
    have hprod : 0 ≤ Real.cosh (π * y) * ∫ t : ℝ, |g t| / Real.cosh (π * t) :=
      mul_nonneg hCy.le hWg
    have h1 : Real.sin (π * x) * (Real.cosh (π * y) * ∫ t : ℝ, |g t| / Real.cosh (π * t))
        ≤ (π * x) * (Real.cosh (π * y) * ∫ t : ℝ, |g t| / Real.cosh (π * t)) :=
      mul_le_mul_of_nonneg_right hsinle hprod
    nlinarith [h1, hx0.le]
  have hCx : C * x < ε := by
    calc C * x < C * (ε / C) := mul_lt_mul_of_pos_left hxlt hC
      _ = ε := by field_simp
  rw [Real.dist_eq, sub_zero]
  linarith [hmain, hbound, hCx]


/-! ### A maximum modulus principle with boundary limit superior conditions

Mathlib's maximum modulus principle on a bounded domain,
`Complex.norm_le_of_forall_mem_frontier_norm_le`, requires the function to be continuous up to the
boundary.  That is too strong for the harmonic majorization of `lem:scalar-strip`.  There the
majorant is `G = H exp (-Φ)` with `Φ` the analytic completion of a Poisson integral: `‖G‖` does
extend continuously to the boundary of the strip, because its boundary values involve only
`re Φ`, but `G` itself need not, because `im Φ` is a conjugate function and has no reason to
converge at the boundary.  What is available at the boundary is a bound on the limit superior of
`‖G‖`, and the argument below shows that this suffices.

The proof is the classical one: the set where `‖f‖` is at least the value at an alleged
counterexample is closed in `ℂ` — closed inside the domain by continuity, and with no limit point
on the boundary by the hypothesis — hence compact, so `‖f‖` attains a maximum there, which is a
maximum over the whole domain.  The maximum modulus principle on a connected set then forces
`‖f‖` to be constant, contradicting the boundary hypothesis. -/

open Filter Topology in
/-- **Maximum modulus principle with boundary limit superior conditions.**  If `f` is
differentiable on a bounded connected open set `U` and `‖f‖` is eventually `< C` on approach to
every boundary point, then `‖f‖ ≤ C` on `U`.  No continuity of `f` up to the boundary is
assumed. -/
theorem norm_le_of_eventually_lt_boundary {U : Set ℂ} (hUo : IsOpen U)
    (hUb : Bornology.IsBounded U) (hUc : IsPreconnected U) {f : ℂ → ℂ}
    (hf : DifferentiableOn ℂ f U) {C : ℝ}
    (hb : ∀ ζ ∈ frontier U, ∀ᶠ z in 𝓝[U] ζ, ‖f z‖ < C) :
    ∀ z ∈ U, ‖f z‖ ≤ C := by
  by_contra hcon
  push Not at hcon
  obtain ⟨w, hwU, hw⟩ := hcon
  -- the sublevel set at the alleged counterexample
  set K : Set ℂ := {z | z ∈ U ∧ ‖f w‖ ≤ ‖f z‖} with hKdef
  have hKU : K ⊆ U := fun z hz => hz.1
  have hwK : w ∈ K := ⟨hwU, le_rfl⟩
  have hKclosed : IsClosed K := by
    rw [← closure_subset_iff_isClosed]
    intro z hz
    have hnb : (𝓝[K] z).NeBot := mem_closure_iff_nhdsWithin_neBot.mp hz
    have hzU : z ∈ closure U := closure_mono hKU hz
    by_cases hzmem : z ∈ U
    · refine ⟨hzmem, ?_⟩
      have hcontAt : ContinuousAt f z :=
        hf.continuousOn.continuousAt (hUo.mem_nhds hzmem)
      have htend : Filter.Tendsto (fun u => ‖f u‖) (𝓝[K] z) (nhds ‖f z‖) :=
        (hcontAt.norm).tendsto.mono_left nhdsWithin_le_nhds
      refine ge_of_tendsto htend ?_
      exact eventually_nhdsWithin_of_forall fun u hu => hu.2
    · exfalso
      have hζ : z ∈ frontier U := by
        rw [hUo.frontier_eq]
        exact ⟨hzU, hzmem⟩
      have hev : ∀ᶠ u in 𝓝[K] z, ‖f u‖ < C :=
        (hb z hζ).filter_mono (nhdsWithin_mono z hKU)
      obtain ⟨u, hu1, hu2⟩ :=
        (hev.and (eventually_nhdsWithin_of_forall fun u (hu : u ∈ K) => hu)).exists
      exact absurd (hu2.2.trans_lt hu1) (not_lt.mpr hw.le)
  have hKcompact : IsCompact K :=
    Metric.isCompact_iff_isClosed_bounded.mpr ⟨hKclosed, hUb.subset hKU⟩
  obtain ⟨z₀, hz₀K, hz₀max⟩ :=
    hKcompact.exists_isMaxOn ⟨w, hwK⟩ (hf.continuousOn.norm.mono hKU)
  -- `z₀` maximizes `‖f‖` over all of `U`
  have hmax : IsMaxOn (norm ∘ f) U z₀ := by
    intro z hz
    by_cases hzK : z ∈ K
    · exact hz₀max hzK
    · have : ‖f z‖ < ‖f w‖ := by
        by_contra hcon2
        exact hzK ⟨hz, not_lt.mp hcon2⟩
      exact le_trans this.le hz₀K.2
  have heq := Complex.norm_eqOn_of_isPreconnected_of_isMaxOn hUc hUo hf hz₀K.1 hmax
  -- a boundary point exists, and near it `‖f‖ < C`
  have hUne : U.Nonempty := ⟨w, hwU⟩
  have hUuniv : U ≠ Set.univ := by
    intro h
    obtain ⟨r, hr⟩ := hUb.subset_closedBall (0 : ℂ)
    have hmem : ((|r| + 1 : ℝ) : ℂ) ∈ U := by rw [h]; trivial
    have h2 := hr hmem
    rw [Metric.mem_closedBall, dist_zero_right, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (by positivity)] at h2
    linarith [le_abs_self r]
  have hfrontier : (frontier U).Nonempty := by
    by_contra hcon2
    rw [Set.not_nonempty_iff_eq_empty] at hcon2
    have : IsClopen U := isClopen_iff_frontier_eq_empty.mpr hcon2
    rcases isClopen_iff.mp this with h | h
    · exact absurd h (Set.nonempty_iff_ne_empty.mp hUne)
    · exact hUuniv h
  obtain ⟨ζ, hζ⟩ := hfrontier
  haveI : (𝓝[U] ζ).NeBot :=
    mem_closure_iff_nhdsWithin_neBot.mp (frontier_subset_closure hζ)
  obtain ⟨u, hu1, hu2⟩ := ((hb ζ hζ).and self_mem_nhdsWithin).exists
  have : ‖f u‖ = ‖f z₀‖ := heq hu2
  have hz₀ge : ‖f w‖ ≤ ‖f z₀‖ := hz₀K.2
  rw [this] at hu1
  linarith [hu1, hz₀ge, hw]


/-! ### Phragmén–Lindelöf for the strip with boundary limit superior conditions

The auxiliary factor is the one Mathlib uses in `PhragmenLindelof.horizontal_strip`, transported
to the vertical strip: with `aff z = d (z - 1/2) (-i)` one has `re (aff z) = d (im z)` and
`im (aff z) = -d (re z - 1/2)`, so on the closed strip `0 ≤ re z ≤ 1` the angle `im (aff z)` stays
within `d/2 < π/2` of zero.  Consequently

  `‖exp (ε (exp (aff z) + exp (-aff z)))‖ = exp (2 ε cos (d (re z - 1/2)) cosh (d (im z)))`

is at most `1` for `ε ≤ 0`, and decays like `exp (ε cos (d/2) exp (d |im z|))` as `|im z| → ∞`
*uniformly on the closed strip*, boundary included.  That uniformity is what lets the argument run
with only a boundary limit superior hypothesis. -/

/-- The affine change of variable in the Phragmén–Lindelöf auxiliary factor. -/
noncomputable def plAff (d : ℝ) (z : ℂ) : ℂ := (d : ℂ) * (z - 1 / 2) * (-Complex.I)

theorem plAff_re (d : ℝ) (z : ℂ) : (plAff d z).re = d * z.im := by
  simp [plAff, Complex.mul_re, Complex.mul_im]

theorem plAff_im (d : ℝ) (z : ℂ) : (plAff d z).im = -(d * (z.re - 1 / 2)) := by
  simp [plAff, Complex.mul_re, Complex.mul_im]

theorem differentiable_plAff (d : ℝ) : Differentiable ℂ (plAff d) := by
  unfold plAff
  fun_prop

/-- The Phragmén–Lindelöf auxiliary factor. -/
noncomputable def plAux (d ε : ℝ) (z : ℂ) : ℂ :=
  Complex.exp ((ε : ℂ) * (Complex.exp (plAff d z) + Complex.exp (-plAff d z)))

theorem differentiable_plAux (d ε : ℝ) : Differentiable ℂ (plAux d ε) := by
  unfold plAux
  exact (((differentiable_plAff d).cexp.add
    (differentiable_plAff d).neg.cexp).const_mul _).cexp

theorem norm_plAux (d ε : ℝ) (z : ℂ) :
    ‖plAux d ε z‖
      = Real.exp (2 * ε * Real.cos (d * (z.re - 1 / 2)) * Real.cosh (d * z.im)) := by
  rw [plAux, Complex.norm_exp]
  congr 1
  simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero,
    Complex.add_re, Complex.exp_re, plAff_re, plAff_im, Complex.neg_re, Complex.neg_im,
    Real.cos_neg, neg_neg]
  rw [Real.cosh_eq]
  ring

/-- On the closed strip the auxiliary factor has modulus at most one, for `ε ≤ 0`. -/
theorem norm_plAux_le_one {d ε : ℝ} (hd0 : 0 < d) (hdpi : d < π) (hε : ε ≤ 0) {z : ℂ}
    (hz : z.re ∈ Icc (0 : ℝ) 1) : ‖plAux d ε z‖ ≤ 1 := by
  rw [norm_plAux, Real.exp_le_one_iff]
  have hcos : 0 ≤ Real.cos (d * (z.re - 1 / 2)) := by
    refine Real.cos_nonneg_of_mem_Icc ⟨?_, ?_⟩
    · nlinarith [hz.1, hz.2, Real.pi_pos]
    · nlinarith [hz.1, hz.2, Real.pi_pos]
  have hcosh : 0 < Real.cosh (d * z.im) := Real.cosh_pos _
  have h1 : 0 ≤ Real.cos (d * (z.re - 1 / 2)) * Real.cosh (d * z.im) :=
    mul_nonneg hcos hcosh.le
  nlinarith [mul_nonneg (neg_nonneg.mpr hε) h1]

/-- On the closed strip the auxiliary factor decays uniformly in the imaginary direction. -/
theorem norm_plAux_le_decay {d ε : ℝ} (hd0 : 0 < d) (hdpi : d < π) (hε : ε ≤ 0) {z : ℂ}
    (hz : z.re ∈ Icc (0 : ℝ) 1) :
    ‖plAux d ε z‖ ≤ Real.exp (ε * Real.cos (d / 2) * Real.exp (d * |z.im|)) := by
  rw [norm_plAux, Real.exp_le_exp]
  have hd2 : d / 2 < π / 2 := by linarith
  have hcosd2 : 0 < Real.cos (d / 2) :=
    Real.cos_pos_of_mem_Ioo ⟨by nlinarith [Real.pi_pos], hd2⟩
  have hmono : Real.cos (d / 2) ≤ Real.cos (d * (z.re - 1 / 2)) := by
    rcases le_or_gt 0 (z.re - 1 / 2) with h | h
    · refine Real.cos_le_cos_of_nonneg_of_le_pi (by nlinarith) (by nlinarith [Real.pi_pos])
        (by nlinarith [hz.2])
    · rw [← Real.cos_neg (d * (z.re - 1 / 2))]
      refine Real.cos_le_cos_of_nonneg_of_le_pi (by nlinarith) (by nlinarith [Real.pi_pos])
        (by nlinarith [hz.1])
  have hexp : Real.exp (d * |z.im|) ≤ 2 * Real.cosh (d * z.im) := by
    rw [Real.cosh_eq]
    rcases abs_cases (z.im) with ⟨h1, _⟩ | ⟨h1, _⟩
    · rw [h1]
      have := Real.exp_pos (-(d * z.im))
      linarith
    · rw [h1]
      have := Real.exp_pos (d * z.im)
      have heq : d * -z.im = -(d * z.im) := by ring
      rw [heq]
      linarith
  have hcosh : 0 < Real.cosh (d * z.im) := Real.cosh_pos _
  have h1 : Real.cos (d / 2) * Real.exp (d * |z.im|)
      ≤ Real.cos (d / 2) * (2 * Real.cosh (d * z.im)) :=
    mul_le_mul_of_nonneg_left hexp hcosd2.le
  have h2 : Real.cos (d / 2) * (2 * Real.cosh (d * z.im))
      ≤ Real.cos (d * (z.re - 1 / 2)) * (2 * Real.cosh (d * z.im)) :=
    mul_le_mul_of_nonneg_right hmono (by positivity)
  have h4 : 0 ≤ (-ε) * (2 * Real.cos (d * (z.re - 1 / 2)) * Real.cosh (d * z.im)
      - Real.cos (d / 2) * Real.exp (d * |z.im|)) :=
    mul_nonneg (neg_nonneg.mpr hε) (by linarith)
  nlinarith [h4]


/-- The open rectangles exhausting the strip. -/
def plRect (T : ℝ) : Set ℂ := {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1} ∩ {z : ℂ | |z.im| < T}

theorem plRect_subset (T : ℝ) : plRect T ⊆ {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1} := fun _ hz => hz.1

theorem isOpen_plRect (T : ℝ) : IsOpen (plRect T) :=
  (isOpen_Ioo.preimage Complex.continuous_re).inter
    (isOpen_Iio.preimage Complex.continuous_im.abs)

theorem convex_plRect (T : ℝ) : Convex ℝ (plRect T) := by
  have h1 : Convex ℝ {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1} :=
    (convex_Ioo (0 : ℝ) 1).linear_preimage Complex.reLm
  have h2 : Convex ℝ {z : ℂ | |z.im| < T} := by
    have heq : {z : ℂ | |z.im| < T} = Complex.imLm ⁻¹' Ioo (-T) T := by
      ext z
      simp only [Set.mem_setOf_eq, Set.mem_preimage, Set.mem_Ioo, abs_lt]
      exact ⟨fun h => ⟨h.1, h.2⟩, fun h => ⟨h.1, h.2⟩⟩
    rw [heq]
    exact (convex_Ioo (-T) T).linear_preimage Complex.imLm
  exact h1.inter h2

theorem isBounded_plRect (T : ℝ) : Bornology.IsBounded (plRect T) := by
  refine (Metric.isBounded_closedBall (x := (0 : ℂ)) (r := 1 + |T|)).subset ?_
  intro z hz
  rw [Metric.mem_closedBall, dist_zero_right]
  refine (Complex.norm_le_abs_re_add_abs_im z).trans ?_
  have h1 : |z.re| ≤ 1 := by
    obtain ⟨ha, hb⟩ := hz.1
    rw [abs_le]
    constructor <;> linarith
  have h2 : |z.im| ≤ |T| := le_trans hz.2.le (le_abs_self T)
  linarith

theorem closure_plRect_subset (T : ℝ) :
    closure (plRect T) ⊆ {z : ℂ | z.re ∈ Icc (0 : ℝ) 1} ∩ {z : ℂ | |z.im| ≤ T} := by
  refine closure_minimal ?_ ?_
  · intro z hz
    simp only [Set.mem_inter_iff, Set.mem_setOf_eq, Set.mem_Icc] at hz ⊢
    exact ⟨⟨hz.1.1.le, hz.1.2.le⟩, hz.2.le⟩
  · exact (isClosed_Icc.preimage Complex.continuous_re).inter
      (isClosed_Iic.preimage Complex.continuous_im.abs)

theorem frontier_plRect_subset (T : ℝ) :
    frontier (plRect T) ⊆ {z : ℂ | z.re = 0 ∨ z.re = 1 ∨ |z.im| = T} := by
  intro ζ hζ
  rw [(isOpen_plRect T).frontier_eq] at hζ
  obtain ⟨hcl, hnot⟩ := hζ
  obtain ⟨hre, him⟩ := closure_plRect_subset T hcl
  by_cases h1 : |ζ.im| = T
  · exact Or.inr (Or.inr h1)
  · have h2 : |ζ.im| < T := lt_of_le_of_ne him h1
    have h3 : ζ.re ∉ Ioo (0 : ℝ) 1 := fun h => hnot ⟨h, h2⟩
    rw [Set.mem_Ioo, not_and_or, not_lt, not_lt] at h3
    rcases h3 with h | h
    · exact Or.inl (le_antisymm h hre.1)
    · exact Or.inr (Or.inl (le_antisymm hre.2 h))

/-- Points of the closed rectangle have real part in `[0, 1]`. -/
theorem re_mem_Icc_of_mem_closure_plRect {T : ℝ} {z : ℂ} (hz : z ∈ closure (plRect T)) :
    z.re ∈ Icc (0 : ℝ) 1 := (closure_plRect_subset T hz).1


/-- The exponent controlling `‖G · plAux d ε‖` tends to `-∞` in the imaginary direction, because
the auxiliary factor's exponent `d` beats the growth exponent `c`. -/
theorem tendsto_plExponent {B c d k : ℝ} (hc0 : 0 ≤ c) (hcd : c < d) (hk : 0 < k) :
    Filter.Tendsto (fun s : ℝ => B * Real.exp (c * s) - k * Real.exp (d * s))
      Filter.atTop Filter.atBot := by
  have hdc : 0 < d - c := by linarith
  have h1 : Filter.Tendsto (fun s : ℝ => Real.exp ((d - c) * s)) Filter.atTop Filter.atTop :=
    Real.tendsto_exp_atTop.comp (Filter.tendsto_id.const_mul_atTop hdc)
  have h2 : Filter.Tendsto (fun s : ℝ => k * Real.exp ((d - c) * s)) Filter.atTop
      Filter.atTop := h1.const_mul_atTop hk
  have h3 : Filter.Tendsto (fun s : ℝ => -(k * Real.exp ((d - c) * s))) Filter.atTop
      Filter.atBot := Filter.tendsto_neg_atTop_atBot.comp h2
  have hbr : Filter.Tendsto (fun s : ℝ => B - k * Real.exp ((d - c) * s)) Filter.atTop
      Filter.atBot := by
    simpa [sub_eq_add_neg] using Filter.tendsto_atBot_add_const_left Filter.atTop B h3
  refine Filter.tendsto_atBot_mono' _ ?_ hbr
  filter_upwards [Filter.eventually_ge_atTop (0 : ℝ), hbr.eventually_le_atBot 0] with s hs0 hsb
  have hE : (1 : ℝ) ≤ Real.exp (c * s) := Real.one_le_exp (by positivity)
  have hsplit : Real.exp (d * s) = Real.exp (c * s) * Real.exp ((d - c) * s) := by
    rw [← Real.exp_add]
    congr 1
    ring
  rw [hsplit]
  nlinarith [hE, hsb]


open Filter Topology in
/-- **Phragmén–Lindelöf for the strip, with boundary limit superior conditions.**
If `G` is differentiable on the open strip `0 < re z < 1`, obeys the admissible growth
`‖G z‖ ≤ exp (B exp (c |im z|))` with `c < π`, and `‖G‖` is eventually `< C` on approach to every
boundary point, then `‖G‖ ≤ C` on the strip.

Unlike `PhragmenLindelof.vertical_strip`, no continuity of `G` up to the boundary is assumed.
That is essential for `lem:scalar-strip`, where the majorant `G = H exp (-Φ)` has `‖G‖` but not
`G` continuous at the boundary; see `automation/ErrorReport.md`. -/
theorem norm_le_of_boundary_lt_strip {G : ℂ → ℂ}
    (hG : DifferentiableOn ℂ G {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1})
    {B c C : ℝ} (hc0 : 0 ≤ c) (hc : c < π) (hC : 0 < C)
    (hgrow : ∀ z : ℂ, z.re ∈ Ioo (0 : ℝ) 1 → ‖G z‖ ≤ Real.exp (B * Real.exp (c * |z.im|)))
    (hbd : ∀ ζ : ℂ, ζ.re = 0 ∨ ζ.re = 1 →
      ∀ᶠ z in 𝓝[{z : ℂ | z.re ∈ Ioo (0 : ℝ) 1}] ζ, ‖G z‖ < C) :
    ∀ z : ℂ, z.re ∈ Ioo (0 : ℝ) 1 → ‖G z‖ ≤ C := by
  obtain ⟨d, hcd, hdpi⟩ := exists_between hc
  have hd0 : 0 < d := lt_of_le_of_lt hc0 hcd
  have hcosd2 : 0 < Real.cos (d / 2) :=
    Real.cos_pos_of_mem_Ioo ⟨by nlinarith [Real.pi_pos], by linarith⟩
  intro z₀ hz₀
  have key : ∀ ε : ℝ, ε < 0 → ‖G z₀‖ * ‖plAux d ε z₀‖ ≤ C := by
    intro ε hε
    set k : ℝ := -(ε * Real.cos (d / 2)) with hkdef
    have hk : 0 < k := by rw [hkdef]; nlinarith [hcosd2, hε]
    have hexp : Filter.Tendsto
        (fun s : ℝ => Real.exp (B * Real.exp (c * s) - k * Real.exp (d * s)))
        Filter.atTop (nhds 0) :=
      Real.tendsto_exp_atBot.comp (tendsto_plExponent hc0 hcd hk)
    obtain ⟨S, hS⟩ := Filter.eventually_atTop.mp (hexp.eventually (gt_mem_nhds hC))
    set T : ℝ := max (|z₀.im| + 1) (S + 1) with hTdef
    have hT1 : |z₀.im| + 1 ≤ T := le_max_left _ _
    have hT2 : S + 1 ≤ T := le_max_right _ _
    -- the bound on the modified function
    have hFbound : ∀ z : ℂ, z.re ∈ Ioo (0 : ℝ) 1 →
        ‖G z * plAux d ε z‖
          ≤ Real.exp (B * Real.exp (c * |z.im|) - k * Real.exp (d * |z.im|)) := by
      intro z hz
      have h1 := hgrow z hz
      have h2 := norm_plAux_le_decay hd0 hdpi hε.le (z := z) ⟨hz.1.le, hz.2.le⟩
      rw [norm_mul]
      calc ‖G z‖ * ‖plAux d ε z‖
          ≤ Real.exp (B * Real.exp (c * |z.im|))
            * Real.exp (ε * Real.cos (d / 2) * Real.exp (d * |z.im|)) :=
            mul_le_mul h1 h2 (norm_nonneg _) (Real.exp_pos _).le
        _ = Real.exp (B * Real.exp (c * |z.im|) - k * Real.exp (d * |z.im|)) := by
            rw [← Real.exp_add, hkdef]
            congr 1
            ring
    have hrect : ∀ z ∈ plRect T, ‖G z * plAux d ε z‖ ≤ C := by
      refine norm_le_of_eventually_lt_boundary (isOpen_plRect T) (isBounded_plRect T)
        (convex_plRect T).isPreconnected
        ((hG.mono (plRect_subset T)).mul ((differentiable_plAux d ε).differentiableOn)) ?_
      intro ζ hζ
      have hside : ∀ (hre : ζ.re = 0 ∨ ζ.re = 1),
          ∀ᶠ z in 𝓝[plRect T] ζ, ‖G z * plAux d ε z‖ < C := by
        intro hre
        filter_upwards [(hbd ζ hre).filter_mono (nhdsWithin_mono ζ (plRect_subset T)),
          self_mem_nhdsWithin] with z hz1 hz2
        have h2 := norm_plAux_le_one hd0 hdpi hε.le (z := z) ⟨hz2.1.1.le, hz2.1.2.le⟩
        rw [norm_mul]
        calc ‖G z‖ * ‖plAux d ε z‖ ≤ ‖G z‖ * 1 :=
              mul_le_mul_of_nonneg_left h2 (norm_nonneg _)
          _ = ‖G z‖ := mul_one _
          _ < C := hz1
      rcases frontier_plRect_subset T hζ with h | h | h
      · exact hside (Or.inl h)
      · exact hside (Or.inr h)
      · have hcont : Filter.Tendsto (fun z : ℂ => |z.im|) (nhds ζ) (nhds |ζ.im|) :=
          (Complex.continuous_im.abs).continuousAt
        have hgt : T - 1 < |ζ.im| := by rw [h]; linarith
        have hev : ∀ᶠ z in nhds ζ, T - 1 < |z.im| :=
          hcont.eventually (eventually_gt_nhds hgt)
        filter_upwards [hev.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin] with z hz1 hz2
        have hb := hFbound z hz2.1
        have hge : S ≤ |z.im| := by linarith
        exact lt_of_le_of_lt hb (hS _ hge)
    have hz₀im : |z₀.im| < T := by linarith
    have hz₀mem : z₀ ∈ plRect T := ⟨hz₀, hz₀im⟩
    have := hrect z₀ hz₀mem
    rwa [norm_mul] at this
  -- let `ε → 0` from below
  have heq : ∀ ε : ℝ, ‖plAux d ε z₀‖
      = Real.exp (2 * ε * Real.cos (d * (z₀.re - 1 / 2)) * Real.cosh (d * z₀.im)) :=
    fun ε => norm_plAux d ε z₀
  have hlim : Filter.Tendsto (fun ε : ℝ => ‖G z₀‖ * ‖plAux d ε z₀‖)
      (nhdsWithin 0 (Iio 0)) (nhds (‖G z₀‖ * 1)) := by
    refine Filter.Tendsto.const_mul _ ?_
    simp only [heq]
    have hcts : Continuous fun ε : ℝ =>
        Real.exp (2 * ε * Real.cos (d * (z₀.re - 1 / 2)) * Real.cosh (d * z₀.im)) := by
      fun_prop
    have h0 : Filter.Tendsto (fun ε : ℝ =>
        Real.exp (2 * ε * Real.cos (d * (z₀.re - 1 / 2)) * Real.cosh (d * z₀.im)))
        (nhdsWithin 0 (Iio 0))
        (nhds (Real.exp (2 * 0 * Real.cos (d * (z₀.re - 1 / 2)) * Real.cosh (d * z₀.im)))) :=
      (hcts.tendsto 0).mono_left nhdsWithin_le_nhds
    simpa using h0
  have hfin : ‖G z₀‖ * 1 ≤ C := by
    refine le_of_tendsto hlim ?_
    filter_upwards [self_mem_nhdsWithin] with ε hε
    exact key ε hε
  simpa using hfin


open MeasureTheory Filter Topology in
/-- **The two-variable boundary limit.**  The Poisson average of the edge `re z = 0` converges to
the boundary value as the interior point approaches `i t₀` from inside the strip along any path.
Only continuity of `g` at `t₀` is needed: the halved-radius triangle inequality converts it into
the oscillation hypothesis of `abs_poissonAverage_sub_le` at every nearby height, and all the
constants there depend on the height only through `cosh (π y)` and `|g y|`. -/
theorem tendsto_poissonAverage_strip {g : ℝ → ℝ} (hgm : AEStronglyMeasurable g volume)
    (hg : Integrable fun t : ℝ => |g t| / Real.cosh (π * t)) {t₀ : ℝ}
    (hcont : ContinuousAt g t₀) :
    Filter.Tendsto (fun z : ℂ => ∫ t : ℝ, g t * poissonStrip z.re 1 (t - z.im))
      (nhdsWithin ((t₀ : ℂ) * Complex.I) {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1}) (nhds (g t₀)) := by
  have hW1 : 0 ≤ ∫ t : ℝ, 1 / Real.cosh (π * t) := by
    refine integral_nonneg fun t => ?_
    have : (0 : ℝ) < Real.cosh (π * t) := Real.cosh_pos _
    positivity
  have hWg : 0 ≤ ∫ t : ℝ, |g t| / Real.cosh (π * t) := by
    refine integral_nonneg fun t => ?_
    have : (0 : ℝ) < Real.cosh (π * t) := Real.cosh_pos _
    positivity
  rw [Metric.tendsto_nhdsWithin_nhds]
  intro ε' hε'
  obtain ⟨δ₀, hδ₀pos, hδ₀⟩ := Metric.continuousAt_iff.mp hcont (ε' / 8) (by linarith)
  set δ : ℝ := δ₀ / 2 with hδdef
  have hδpos : 0 < δ := by rw [hδdef]; linarith
  have hcosδ : 1 < Real.cosh (π * δ) := one_lt_cosh_of_ne_zero (by positivity)
  set M : ℝ := |g t₀| + ε' / 8 with hMdef
  have hM : 0 ≤ M := by rw [hMdef]; positivity
  set Kst : ℝ := Real.cosh (π * δ) / (Real.cosh (π * δ) - 1) * Real.cosh (π * (|t₀| + δ))
    with hKdef
  have hKst : 0 ≤ Kst := by
    rw [hKdef]
    have h1 : (0 : ℝ) < Real.cosh (π * δ) - 1 := by linarith
    have h2 : (0 : ℝ) < Real.cosh (π * (|t₀| + δ)) := Real.cosh_pos _
    positivity
  set Wst : ℝ := (∫ t : ℝ, |g t| / Real.cosh (π * t)) + M * ∫ t : ℝ, 1 / Real.cosh (π * t)
    with hWdef
  have hWst : 0 ≤ Wst := by rw [hWdef]; positivity
  set Cst : ℝ := M + π * (Kst * Wst) + 1 with hCdef
  have hCst : 0 < Cst := by
    rw [hCdef]
    have : (0 : ℝ) ≤ π * (Kst * Wst) := by positivity
    linarith
  refine ⟨min δ (ε' / (4 * Cst)), lt_min hδpos (by positivity), ?_⟩
  intro z hzs hzd
  obtain ⟨hz0, hz1⟩ := hzs
  -- geometry of the approach
  have hre0 : ((t₀ : ℂ) * Complex.I).re = 0 := by simp
  have him0 : ((t₀ : ℂ) * Complex.I).im = t₀ := by simp
  have hnorm : ‖z - (t₀ : ℂ) * Complex.I‖ < min δ (ε' / (4 * Cst)) := by
    rw [← Complex.dist_eq]
    exact hzd
  have hreb : z.re < min δ (ε' / (4 * Cst)) := by
    have h1 := Complex.abs_re_le_norm (z - (t₀ : ℂ) * Complex.I)
    rw [Complex.sub_re, hre0, sub_zero] at h1
    calc z.re ≤ |z.re| := le_abs_self _
      _ ≤ ‖z - (t₀ : ℂ) * Complex.I‖ := h1
      _ < _ := hnorm
  have himb : |z.im - t₀| < min δ (ε' / (4 * Cst)) := by
    have h1 := Complex.abs_im_le_norm (z - (t₀ : ℂ) * Complex.I)
    rw [Complex.sub_im, him0] at h1
    exact lt_of_le_of_lt h1 hnorm
  have himδ : |z.im - t₀| < δ := lt_of_lt_of_le himb (min_le_left _ _)
  have hreδ : z.re < ε' / (4 * Cst) := lt_of_lt_of_le hreb (min_le_right _ _)
  -- the value at the nearby height is close to the value at `t₀`
  have hgy : |g z.im - g t₀| ≤ ε' / 8 := by
    have := hδ₀ (x := z.im) (by rw [Real.dist_eq]; rw [hδdef] at himδ; linarith)
    rw [Real.dist_eq] at this
    exact this.le
  have hgyM : |g z.im| ≤ M := by
    rw [hMdef]
    calc |g z.im| = |g z.im - g t₀ + g t₀| := by ring_nf
      _ ≤ |g z.im - g t₀| + |g t₀| := by
          simpa using abs_add_le (g z.im - g t₀) (g t₀)
      _ ≤ ε' / 8 + |g t₀| := by linarith
      _ = |g t₀| + ε' / 8 := by ring
  -- oscillation of `g` on the `δ`-neighbourhood of the nearby height
  have hosc : ∀ t : ℝ, |t - z.im| < δ → |g t - g z.im| ≤ ε' / 4 := by
    intro t ht
    have h1 : |t - t₀| < δ₀ := by
      have : |t - t₀| ≤ |t - z.im| + |z.im - t₀| := by
        simpa using abs_sub_le t z.im t₀
      rw [hδdef] at ht himδ
      linarith
    have h2 : |g t - g t₀| ≤ ε' / 8 := by
      have := hδ₀ (x := t) (by rw [Real.dist_eq]; exact h1)
      rw [Real.dist_eq] at this
      exact this.le
    calc |g t - g z.im| = |(g t - g t₀) - (g z.im - g t₀)| := by ring_nf
      _ ≤ |g t - g t₀| + |g z.im - g t₀| := by
          rw [sub_eq_add_neg]
          refine (abs_add_le _ _).trans ?_
          rw [abs_neg]
      _ ≤ ε' / 4 := by linarith
  -- the main estimate at the nearby height
  have hmain := abs_poissonAverage_sub_le hgm hg ⟨hz0, hz1⟩ hδpos
    (by linarith : (0 : ℝ) ≤ ε' / 4) hosc (y := z.im)
  -- bound the two vanishing terms
  have hcoshb : Real.cosh (π * z.im) ≤ Real.cosh (π * (|t₀| + δ)) := by
    rw [Real.cosh_le_cosh, abs_mul, abs_mul, abs_of_pos Real.pi_pos]
    have h1 : |z.im| ≤ |t₀| + δ := by
      have : |z.im| ≤ |z.im - t₀| + |t₀| := by simpa using abs_sub_le z.im t₀ 0
      linarith
    have h2 : |(|t₀| + δ)| = |t₀| + δ := abs_of_nonneg (by positivity)
    rw [h2]
    exact mul_le_mul_of_nonneg_left h1 Real.pi_pos.le
  have hA : Real.cosh (π * δ) / (Real.cosh (π * δ) - 1) * Real.cosh (π * z.im) ≤ Kst := by
    rw [hKdef]
    have h1 : (0 : ℝ) ≤ Real.cosh (π * δ) / (Real.cosh (π * δ) - 1) := by
      have : (0 : ℝ) < Real.cosh (π * δ) - 1 := by linarith
      positivity
    exact mul_le_mul_of_nonneg_left hcoshb h1
  have hA0 : 0 ≤ Real.cosh (π * δ) / (Real.cosh (π * δ) - 1) * Real.cosh (π * z.im) := by
    have h1 : (0 : ℝ) < Real.cosh (π * δ) - 1 := by linarith
    have h2 : (0 : ℝ) < Real.cosh (π * z.im) := Real.cosh_pos _
    positivity
  have hB : (∫ t : ℝ, |g t| / Real.cosh (π * t))
      + |g z.im| * ∫ t : ℝ, 1 / Real.cosh (π * t) ≤ Wst := by
    rw [hWdef]
    have := mul_le_mul_of_nonneg_right hgyM hW1
    linarith
  have hB0 : 0 ≤ (∫ t : ℝ, |g t| / Real.cosh (π * t))
      + |g z.im| * ∫ t : ℝ, 1 / Real.cosh (π * t) := by positivity
  have hsin : Real.sin (π * z.re) ≤ π * z.re := Real.sin_le (by positivity)
  have hsin0 : 0 ≤ Real.sin (π * z.re) := (sin_pi_mul_pos ⟨hz0, hz1⟩).le
  have hstep : Real.sin (π * z.re) * (Real.cosh (π * δ) / (Real.cosh (π * δ) - 1))
        * Real.cosh (π * z.im)
        * ((∫ t : ℝ, |g t| / Real.cosh (π * t))
          + |g z.im| * ∫ t : ℝ, 1 / Real.cosh (π * t))
      ≤ π * z.re * Kst * Wst := by
    have e1 : Real.sin (π * z.re) * (Real.cosh (π * δ) / (Real.cosh (π * δ) - 1))
          * Real.cosh (π * z.im)
        = Real.sin (π * z.re) * ((Real.cosh (π * δ) / (Real.cosh (π * δ) - 1))
          * Real.cosh (π * z.im)) := by ring
    rw [e1]
    refine mul_le_mul (mul_le_mul hsin hA hA0 (by positivity)) hB hB0 ?_
    have : (0 : ℝ) ≤ π * z.re := by positivity
    exact mul_nonneg this hKst
  have htail : |g z.im| * z.re + π * z.re * Kst * Wst ≤ Cst * z.re := by
    rw [hCdef]
    have h1 : |g z.im| * z.re ≤ M * z.re := mul_le_mul_of_nonneg_right hgyM hz0.le
    nlinarith [hz0.le, hKst, hWst]
  have hCx : Cst * z.re < ε' / 4 := by
    calc Cst * z.re < Cst * (ε' / (4 * Cst)) := mul_lt_mul_of_pos_left hreδ hCst
      _ = ε' / 4 := by field_simp
  rw [Real.dist_eq]
  calc |(∫ t : ℝ, g t * poissonStrip z.re 1 (t - z.im)) - g t₀|
      ≤ |(∫ t : ℝ, g t * poissonStrip z.re 1 (t - z.im)) - g z.im| + |g z.im - g t₀| := by
        have : (∫ t : ℝ, g t * poissonStrip z.re 1 (t - z.im)) - g t₀
            = ((∫ t : ℝ, g t * poissonStrip z.re 1 (t - z.im)) - g z.im)
              + (g z.im - g t₀) := by ring
        rw [this]
        simpa using abs_add_le ((∫ t : ℝ, g t * poissonStrip z.re 1 (t - z.im)) - g z.im)
          (g z.im - g t₀)
    _ < ε' := by linarith [hmain, hstep, htail, hCx, hgy]


open MeasureTheory Filter Topology in
/-- **The two-variable far-edge limit.**  The Poisson average against the opposite edge tends to
zero as the interior point approaches `i t₀`. -/
theorem tendsto_poissonAverage_far_strip {g : ℝ → ℝ} (hgm : AEStronglyMeasurable g volume)
    (hg : Integrable fun t : ℝ => |g t| / Real.cosh (π * t)) (t₀ : ℝ) :
    Filter.Tendsto (fun z : ℂ => ∫ t : ℝ, g t * poissonStrip z.re (-1) (t - z.im))
      (nhdsWithin ((t₀ : ℂ) * Complex.I) {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1}) (nhds 0) := by
  have hWg : 0 ≤ ∫ t : ℝ, |g t| / Real.cosh (π * t) := by
    refine integral_nonneg fun t => ?_
    have : (0 : ℝ) < Real.cosh (π * t) := Real.cosh_pos _
    positivity
  set Cst : ℝ := π * (Real.cosh (π * (|t₀| + 1)) * ∫ t : ℝ, |g t| / Real.cosh (π * t)) + 1
    with hCdef
  have hCst : 0 < Cst := by
    rw [hCdef]
    have h1 : (0 : ℝ) ≤ π * (Real.cosh (π * (|t₀| + 1))
        * ∫ t : ℝ, |g t| / Real.cosh (π * t)) := by
      have : (0 : ℝ) < Real.cosh (π * (|t₀| + 1)) := Real.cosh_pos _
      positivity
    linarith
  rw [Metric.tendsto_nhdsWithin_nhds]
  intro ε hε
  refine ⟨min (1 / 2) (min 1 (ε / Cst)), lt_min (by norm_num) (lt_min one_pos (by positivity)),
    ?_⟩
  intro z hzs hzd
  obtain ⟨hz0, hz1⟩ := hzs
  have hre0 : ((t₀ : ℂ) * Complex.I).re = 0 := by simp
  have him0 : ((t₀ : ℂ) * Complex.I).im = t₀ := by simp
  have hnorm : ‖z - (t₀ : ℂ) * Complex.I‖ < min (1 / 2) (min 1 (ε / Cst)) := by
    rw [← Complex.dist_eq]
    exact hzd
  have hreb : z.re < min (1 / 2) (min 1 (ε / Cst)) := by
    have h1 := Complex.abs_re_le_norm (z - (t₀ : ℂ) * Complex.I)
    rw [Complex.sub_re, hre0, sub_zero] at h1
    calc z.re ≤ |z.re| := le_abs_self _
      _ ≤ ‖z - (t₀ : ℂ) * Complex.I‖ := h1
      _ < _ := hnorm
  have himb : |z.im - t₀| < min (1 / 2) (min 1 (ε / Cst)) := by
    have h1 := Complex.abs_im_le_norm (z - (t₀ : ℂ) * Complex.I)
    rw [Complex.sub_im, him0] at h1
    exact lt_of_le_of_lt h1 hnorm
  have hre2 : z.re ≤ 1 / 2 := le_of_lt (lt_of_lt_of_le hreb (min_le_left _ _))
  have him1 : |z.im - t₀| < 1 :=
    lt_of_lt_of_le himb (le_trans (min_le_right _ _) (min_le_left _ _))
  have hreC : z.re < ε / Cst :=
    lt_of_lt_of_le hreb (le_trans (min_le_right _ _) (min_le_right _ _))
  -- the modulus bound
  have hmain := abs_poissonAverage_far_le hgm hg ⟨hz0, hz1⟩ hre2 z.im
  have hcoshb : Real.cosh (π * z.im) ≤ Real.cosh (π * (|t₀| + 1)) := by
    rw [Real.cosh_le_cosh, abs_mul, abs_mul, abs_of_pos Real.pi_pos]
    have h1 : |z.im| ≤ |t₀| + 1 := by
      have : |z.im| ≤ |z.im - t₀| + |t₀| := by simpa using abs_sub_le z.im t₀ 0
      linarith
    rw [abs_of_nonneg (by positivity : (0 : ℝ) ≤ |t₀| + 1)]
    exact mul_le_mul_of_nonneg_left h1 Real.pi_pos.le
  have hsin : Real.sin (π * z.re) ≤ π * z.re := Real.sin_le (by positivity)
  have hsin0 : 0 ≤ Real.sin (π * z.re) := (sin_pi_mul_pos ⟨hz0, hz1⟩).le
  have hstep : Real.sin (π * z.re) * Real.cosh (π * z.im)
        * (∫ t : ℝ, |g t| / Real.cosh (π * t))
      ≤ Cst * z.re := by
    have hch0 : (0 : ℝ) < Real.cosh (π * z.im) := Real.cosh_pos _
    have h1 : Real.sin (π * z.re) * Real.cosh (π * z.im)
        ≤ (π * z.re) * Real.cosh (π * (|t₀| + 1)) :=
      mul_le_mul hsin hcoshb hch0.le (by positivity)
    have h2 : Real.sin (π * z.re) * Real.cosh (π * z.im)
          * (∫ t : ℝ, |g t| / Real.cosh (π * t))
        ≤ (π * z.re) * Real.cosh (π * (|t₀| + 1))
          * ∫ t : ℝ, |g t| / Real.cosh (π * t) :=
      mul_le_mul_of_nonneg_right h1 hWg
    rw [hCdef]
    nlinarith [h2, hz0.le]
  have hCx : Cst * z.re < ε := by
    calc Cst * z.re < Cst * (ε / Cst) := mul_lt_mul_of_pos_left hreC hCst
      _ = ε := by field_simp
  rw [Real.dist_eq, sub_zero]
  linarith [hmain, hstep, hCx]

/-! ### Reflection of the strip

The map `z ↦ 1 - conj z` exchanges the two edges of the strip, and the two Poisson kernels are
exchanged with it (`poissonStrip_reflect`).  So the boundary statements at the edge `re z = 1`
follow from those at `re z = 0` with no new analysis. -/

/-- Reflection of the strip in the line `re z = 1/2`. -/
noncomputable def stripReflect (z : ℂ) : ℂ := 1 - (starRingEnd ℂ) z

theorem stripReflect_re (z : ℂ) : (stripReflect z).re = 1 - z.re := by simp [stripReflect]

theorem stripReflect_im (z : ℂ) : (stripReflect z).im = z.im := by simp [stripReflect]

theorem continuous_stripReflect : Continuous stripReflect := by
  unfold stripReflect
  fun_prop

theorem stripReflect_one_add (t₀ : ℝ) :
    stripReflect ((1 : ℂ) + (t₀ : ℂ) * Complex.I) = (t₀ : ℂ) * Complex.I := by
  apply Complex.ext <;> simp [stripReflect]

open Filter Topology in
theorem tendsto_stripReflect (t₀ : ℝ) :
    Filter.Tendsto stripReflect
      (nhdsWithin ((1 : ℂ) + (t₀ : ℂ) * Complex.I) {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1})
      (nhdsWithin ((t₀ : ℂ) * Complex.I) {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1}) := by
  refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ ?_ ?_
  · have h := (continuous_stripReflect.tendsto ((1 : ℂ) + (t₀ : ℂ) * Complex.I)).mono_left
      (nhdsWithin_le_nhds (s := {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1}))
    rwa [stripReflect_one_add] at h
  · filter_upwards [self_mem_nhdsWithin] with z hz
    obtain ⟨h1, h2⟩ := hz
    rw [stripReflect_re, Set.mem_Ioo]
    constructor <;> linarith


theorem poissonStrip_reflect' (θ t : ℝ) : poissonStrip θ 1 t = poissonStrip (1 - θ) (-1) t := by
  have h := poissonStrip_reflect (1 - θ) t
  rw [show (1 : ℝ) - (1 - θ) = θ by ring] at h
  exact h.symm

open MeasureTheory Filter Topology in
/-- The boundary limit at the edge `re z = 1`: the kernel of that edge reproduces the data. -/
theorem tendsto_poissonAverage_strip_right {g : ℝ → ℝ} (hgm : AEStronglyMeasurable g volume)
    (hg : Integrable fun t : ℝ => |g t| / Real.cosh (π * t)) {t₀ : ℝ}
    (hcont : ContinuousAt g t₀) :
    Filter.Tendsto (fun z : ℂ => ∫ t : ℝ, g t * poissonStrip z.re (-1) (t - z.im))
      (nhdsWithin ((1 : ℂ) + (t₀ : ℂ) * Complex.I) {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1})
      (nhds (g t₀)) := by
  have hfun : (fun z : ℂ => ∫ t : ℝ, g t * poissonStrip z.re (-1) (t - z.im))
      = (fun w : ℂ => ∫ t : ℝ, g t * poissonStrip w.re 1 (t - w.im)) ∘ stripReflect := by
    funext z
    simp only [Function.comp_apply, stripReflect_re, stripReflect_im]
    refine integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
    change g t * poissonStrip z.re (-1) (t - z.im) = g t * poissonStrip (1 - z.re) 1 (t - z.im)
    rw [poissonStrip_reflect]
  rw [hfun]
  exact (tendsto_poissonAverage_strip hgm hg hcont).comp (tendsto_stripReflect t₀)

open MeasureTheory Filter Topology in
/-- The far-edge limit at the edge `re z = 1`. -/
theorem tendsto_poissonAverage_far_strip_right {g : ℝ → ℝ}
    (hgm : AEStronglyMeasurable g volume)
    (hg : Integrable fun t : ℝ => |g t| / Real.cosh (π * t)) (t₀ : ℝ) :
    Filter.Tendsto (fun z : ℂ => ∫ t : ℝ, g t * poissonStrip z.re 1 (t - z.im))
      (nhdsWithin ((1 : ℂ) + (t₀ : ℂ) * Complex.I) {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1})
      (nhds 0) := by
  have hfun : (fun z : ℂ => ∫ t : ℝ, g t * poissonStrip z.re 1 (t - z.im))
      = (fun w : ℂ => ∫ t : ℝ, g t * poissonStrip w.re (-1) (t - w.im)) ∘ stripReflect := by
    funext z
    simp only [Function.comp_apply, stripReflect_re, stripReflect_im]
    refine integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
    change g t * poissonStrip z.re 1 (t - z.im) = g t * poissonStrip (1 - z.re) (-1) (t - z.im)
    rw [poissonStrip_reflect']
  rw [hfun]
  exact (tendsto_poissonAverage_far_strip hgm hg t₀).comp (tendsto_stripReflect t₀)


/-! ### The boundary behaviour of the Poisson integral

Combining the four limits: the real part of `stripPoissonIntegral` extends continuously to each
edge of the strip, with the corresponding boundary datum as its limit.  This is the hypothesis
needed by `norm_le_of_boundary_lt_strip`. -/

open MeasureTheory Filter Topology in
theorem tendsto_re_stripPoissonIntegral_left {g₀ g₁ : ℝ → ℝ}
    (hgm₀ : AEStronglyMeasurable g₀ volume) (hgm₁ : AEStronglyMeasurable g₁ volume)
    (hg₀ : Integrable fun t : ℝ => |g₀ t| / Real.cosh (π * t))
    (hg₁ : Integrable fun t : ℝ => |g₁ t| / Real.cosh (π * t))
    {t₀ : ℝ} (hcont : ContinuousAt g₀ t₀) :
    Filter.Tendsto (fun z : ℂ => (stripPoissonIntegral g₀ g₁ z).re)
      (nhdsWithin ((t₀ : ℂ) * Complex.I) {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1}) (nhds (g₀ t₀)) := by
  have heq : (fun z : ℂ => (∫ t : ℝ, g₀ t * poissonStrip z.re 1 (t - z.im))
        + ∫ t : ℝ, g₁ t * poissonStrip z.re (-1) (t - z.im))
      =ᶠ[nhdsWithin ((t₀ : ℂ) * Complex.I) {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1}]
      fun z : ℂ => (stripPoissonIntegral g₀ g₁ z).re := by
    filter_upwards [self_mem_nhdsWithin] with z hz
    exact (re_stripPoissonIntegral' hgm₀ hgm₁ hg₀ hg₁ hz).symm
  refine Filter.Tendsto.congr' heq ?_
  have h1 := tendsto_poissonAverage_strip hgm₀ hg₀ hcont
  have h2 := tendsto_poissonAverage_far_strip hgm₁ hg₁ t₀
  simpa using h1.add h2

open MeasureTheory Filter Topology in
theorem tendsto_re_stripPoissonIntegral_right {g₀ g₁ : ℝ → ℝ}
    (hgm₀ : AEStronglyMeasurable g₀ volume) (hgm₁ : AEStronglyMeasurable g₁ volume)
    (hg₀ : Integrable fun t : ℝ => |g₀ t| / Real.cosh (π * t))
    (hg₁ : Integrable fun t : ℝ => |g₁ t| / Real.cosh (π * t))
    {t₀ : ℝ} (hcont : ContinuousAt g₁ t₀) :
    Filter.Tendsto (fun z : ℂ => (stripPoissonIntegral g₀ g₁ z).re)
      (nhdsWithin ((1 : ℂ) + (t₀ : ℂ) * Complex.I) {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1})
      (nhds (g₁ t₀)) := by
  have heq : (fun z : ℂ => (∫ t : ℝ, g₀ t * poissonStrip z.re 1 (t - z.im))
        + ∫ t : ℝ, g₁ t * poissonStrip z.re (-1) (t - z.im))
      =ᶠ[nhdsWithin ((1 : ℂ) + (t₀ : ℂ) * Complex.I) {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1}]
      fun z : ℂ => (stripPoissonIntegral g₀ g₁ z).re := by
    filter_upwards [self_mem_nhdsWithin] with z hz
    exact (re_stripPoissonIntegral' hgm₀ hgm₁ hg₀ hg₁ hz).symm
  refine Filter.Tendsto.congr' heq ?_
  have h1 := tendsto_poissonAverage_far_strip_right hgm₀ hg₀ t₀
  have h2 := tendsto_poissonAverage_strip_right hgm₁ hg₁ hcont
  simpa using h1.add h2


open MeasureTheory in
theorem integrable_poissonStrip_translate_sigma {x σ : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1)
    (hσ : |σ| ≤ 1) (y : ℝ) : Integrable fun t : ℝ => poissonStrip x σ (t - y) :=
  (integrable_poissonStrip hx hσ).comp_sub_right y

open MeasureTheory in
/-- The mass of the far kernel at the interior point `x + i y` is `x`. -/
theorem integral_poissonStrip_neg_one_translate (x y : ℝ) (hx : x ∈ Ioo (0 : ℝ) 1) :
    ∫ t : ℝ, poissonStrip x (-1) (t - y) = x := by
  rw [integral_sub_right_eq_self (fun t : ℝ => poissonStrip x (-1) t) y,
    integral_poissonStrip_neg_one hx]

open MeasureTheory in
/-- If both boundary data are at least `m`, so is the harmonic extension: the two kernel masses
are `1 - re z` and `re z`, and they sum to one. -/
theorem re_stripPoissonIntegral_ge {g₀ g₁ : ℝ → ℝ}
    (hgm₀ : AEStronglyMeasurable g₀ volume) (hgm₁ : AEStronglyMeasurable g₁ volume)
    (hg₀ : Integrable fun t : ℝ => |g₀ t| / Real.cosh (π * t))
    (hg₁ : Integrable fun t : ℝ => |g₁ t| / Real.cosh (π * t))
    {m : ℝ} (hm₀ : ∀ t, m ≤ g₀ t) (hm₁ : ∀ t, m ≤ g₁ t)
    {z : ℂ} (hz : z.re ∈ Ioo (0 : ℝ) 1) :
    m ≤ (stripPoissonIntegral g₀ g₁ z).re := by
  rw [re_stripPoissonIntegral' hgm₀ hgm₁ hg₀ hg₁ hz]
  have h1 : m * (1 - z.re) ≤ ∫ t : ℝ, g₀ t * poissonStrip z.re 1 (t - z.im) := by
    have hint : Integrable fun t : ℝ => m * poissonStrip z.re 1 (t - z.im) :=
      (integrable_poissonStrip_translate_sigma hz (by norm_num) z.im).const_mul m
    have hmono : ∀ t : ℝ, m * poissonStrip z.re 1 (t - z.im)
        ≤ g₀ t * poissonStrip z.re 1 (t - z.im) := fun t =>
      mul_le_mul_of_nonneg_right (hm₀ t) (poissonStrip_pos hz (by norm_num) _).le
    calc m * (1 - z.re) = ∫ t : ℝ, m * poissonStrip z.re 1 (t - z.im) := by
          rw [integral_const_mul, integral_poissonStrip_translate _ _ hz]
      _ ≤ _ := integral_mono hint
          (integrable_mul_poissonStrip hgm₀ hg₀ hz (by norm_num) z.im) hmono
  have h2 : m * z.re ≤ ∫ t : ℝ, g₁ t * poissonStrip z.re (-1) (t - z.im) := by
    have hint : Integrable fun t : ℝ => m * poissonStrip z.re (-1) (t - z.im) :=
      (integrable_poissonStrip_translate_sigma hz (by norm_num) z.im).const_mul m
    have hmono : ∀ t : ℝ, m * poissonStrip z.re (-1) (t - z.im)
        ≤ g₁ t * poissonStrip z.re (-1) (t - z.im) := fun t =>
      mul_le_mul_of_nonneg_right (hm₁ t) (poissonStrip_pos hz (by norm_num) _).le
    calc m * z.re = ∫ t : ℝ, m * poissonStrip z.re (-1) (t - z.im) := by
          rw [integral_const_mul, integral_poissonStrip_neg_one_translate _ _ hz]
      _ ≤ _ := integral_mono hint
          (integrable_mul_poissonStrip hgm₁ hg₁ hz (by norm_num) z.im) hmono
  linarith


/-! ### The harmonic majorization

Everything is now in place to run the blueprint's argument: `G = H exp (-Φ)` with `Φ` the analytic
completion of the Poisson integral of `log (‖H‖ + ε)` is analytic on the strip, has admissible
growth because `re Φ ≥ log ε`, and has `‖G‖ < 1` in the limit at every boundary point because
`re Φ` reproduces the boundary data there.  `norm_le_of_boundary_lt_strip` then gives `‖G‖ ≤ 1`,
that is, `‖H‖ ≤ exp (re Φ)`. -/

open MeasureTheory Filter Topology in
/-- **The harmonic majorization**, the additive form of `lem:scalar-strip`. -/
theorem norm_le_exp_re_stripPoissonIntegral {H : ℂ → ℂ}
    (hHc : ContinuousOn H {z : ℂ | z.re ∈ Icc (0 : ℝ) 1})
    (hHd : DifferentiableOn ℂ H {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1})
    {B c ε : ℝ} (hc0 : 0 ≤ c) (hc : c < π) (hε : 0 < ε)
    (hgrow : ∀ z : ℂ, z.re ∈ Ioo (0 : ℝ) 1 → ‖H z‖ ≤ Real.exp (B * Real.exp (c * |z.im|)))
    (hint₀ : Integrable fun t : ℝ =>
      |Real.log (‖H ((t : ℂ) * Complex.I)‖ + ε)| / Real.cosh (π * t))
    (hint₁ : Integrable fun t : ℝ =>
      |Real.log (‖H (1 + (t : ℂ) * Complex.I)‖ + ε)| / Real.cosh (π * t)) :
    ∀ z : ℂ, z.re ∈ Ioo (0 : ℝ) 1 →
      ‖H z‖ ≤ Real.exp ((stripPoissonIntegral
        (fun t => Real.log (‖H ((t : ℂ) * Complex.I)‖ + ε))
        (fun t => Real.log (‖H (1 + (t : ℂ) * Complex.I)‖ + ε)) z).re) := by
  set g₀ : ℝ → ℝ := fun t => Real.log (‖H ((t : ℂ) * Complex.I)‖ + ε) with hg₀def
  set g₁ : ℝ → ℝ := fun t => Real.log (‖H (1 + (t : ℂ) * Complex.I)‖ + ε) with hg₁def
  have hsub : {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1} ⊆ {z : ℂ | z.re ∈ Icc (0 : ℝ) 1} :=
    fun w hw => ⟨hw.1.le, hw.2.le⟩
  have hmemL : ∀ t : ℝ, ((t : ℂ) * Complex.I) ∈ {z : ℂ | z.re ∈ Icc (0 : ℝ) 1} := by
    intro t; simp [Set.mem_Icc]
  have hmemR : ∀ t : ℝ, ((1 : ℂ) + (t : ℂ) * Complex.I) ∈ {z : ℂ | z.re ∈ Icc (0 : ℝ) 1} := by
    intro t; simp [Set.mem_Icc]
  have hleft : Continuous fun t : ℝ => H ((t : ℂ) * Complex.I) :=
    hHc.comp_continuous (by fun_prop) hmemL
  have hright : Continuous fun t : ℝ => H ((1 : ℂ) + (t : ℂ) * Complex.I) :=
    hHc.comp_continuous (by fun_prop) hmemR
  have hposL : ∀ t : ℝ, (0 : ℝ) < ‖H ((t : ℂ) * Complex.I)‖ + ε := fun t => by
    linarith [norm_nonneg (H ((t : ℂ) * Complex.I))]
  have hposR : ∀ t : ℝ, (0 : ℝ) < ‖H ((1 : ℂ) + (t : ℂ) * Complex.I)‖ + ε := fun t => by
    linarith [norm_nonneg (H ((1 : ℂ) + (t : ℂ) * Complex.I))]
  have hcont₀ : Continuous g₀ := by
    rw [hg₀def]
    refine continuous_iff_continuousAt.mpr fun t => ?_
    have hinner : ContinuousAt (fun s : ℝ => ‖H ((s : ℂ) * Complex.I)‖ + ε) t :=
      (hleft.norm.add continuous_const).continuousAt
    exact hinner.log (hposL t).ne'
  have hcont₁ : Continuous g₁ := by
    rw [hg₁def]
    refine continuous_iff_continuousAt.mpr fun t => ?_
    have hinner : ContinuousAt (fun s : ℝ => ‖H ((1 : ℂ) + (s : ℂ) * Complex.I)‖ + ε) t :=
      (hright.norm.add continuous_const).continuousAt
    exact hinner.log (hposR t).ne'
  have hgm₀ : AEStronglyMeasurable g₀ volume := hcont₀.aestronglyMeasurable
  have hgm₁ : AEStronglyMeasurable g₁ volume := hcont₁.aestronglyMeasurable
  have hm₀ : ∀ t, Real.log ε ≤ g₀ t := by
    intro t
    simp only [hg₀def]
    exact Real.log_le_log hε (by linarith [norm_nonneg (H ((t : ℂ) * Complex.I))])
  have hm₁ : ∀ t, Real.log ε ≤ g₁ t := by
    intro t
    simp only [hg₁def]
    exact Real.log_le_log hε
      (by linarith [norm_nonneg (H ((1 : ℂ) + (t : ℂ) * Complex.I))])
  have hΦd : DifferentiableOn ℂ (stripPoissonIntegral g₀ g₁) {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1} :=
    differentiableOn_stripPoissonIntegral hgm₀ hgm₁ hint₀ hint₁
  have hGd : DifferentiableOn ℂ
      (fun z : ℂ => H z * Complex.exp (-stripPoissonIntegral g₀ g₁ z))
      {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1} := hHd.mul hΦd.neg.cexp
  have hGnorm : ∀ z : ℂ, ‖H z * Complex.exp (-stripPoissonIntegral g₀ g₁ z)‖
      = ‖H z‖ * Real.exp (-(stripPoissonIntegral g₀ g₁ z).re) := by
    intro z
    rw [norm_mul, Complex.norm_exp, Complex.neg_re]
  have hGgrow : ∀ z : ℂ, z.re ∈ Ioo (0 : ℝ) 1 →
      ‖H z * Complex.exp (-stripPoissonIntegral g₀ g₁ z)‖
        ≤ Real.exp ((B + |Real.log ε|) * Real.exp (c * |z.im|)) := by
    intro z hz
    have hΦge := re_stripPoissonIntegral_ge hgm₀ hgm₁ hint₀ hint₁ hm₀ hm₁ hz
    have h1 : Real.exp (-(stripPoissonIntegral g₀ g₁ z).re) ≤ Real.exp (-Real.log ε) :=
      Real.exp_le_exp.mpr (by linarith)
    rw [hGnorm]
    calc ‖H z‖ * Real.exp (-(stripPoissonIntegral g₀ g₁ z).re)
        ≤ Real.exp (B * Real.exp (c * |z.im|)) * Real.exp (-Real.log ε) :=
          mul_le_mul (hgrow z hz) h1 (Real.exp_pos _).le (Real.exp_pos _).le
      _ = Real.exp (B * Real.exp (c * |z.im|) - Real.log ε) := by
          rw [← Real.exp_add]; ring_nf
      _ ≤ Real.exp ((B + |Real.log ε|) * Real.exp (c * |z.im|)) := by
          refine Real.exp_le_exp.mpr ?_
          have he : (1 : ℝ) ≤ Real.exp (c * |z.im|) := Real.one_le_exp (by positivity)
          nlinarith [neg_abs_le (Real.log ε), he, abs_nonneg (Real.log ε)]
  have hkey : ∀ (w : ℂ) (v : ℝ), w ∈ {z : ℂ | z.re ∈ Icc (0 : ℝ) 1} →
      Filter.Tendsto (fun z : ℂ => (stripPoissonIntegral g₀ g₁ z).re)
        (𝓝[{z : ℂ | z.re ∈ Ioo (0 : ℝ) 1}] w) (nhds v) →
      Real.exp v = ‖H w‖ + ε →
      ∀ᶠ z in 𝓝[{z : ℂ | z.re ∈ Ioo (0 : ℝ) 1}] w,
        ‖H z * Complex.exp (-stripPoissonIntegral g₀ g₁ z)‖ < 1 := by
    intro w v hw hlimΦ hv
    have hlimH : Filter.Tendsto (fun z : ℂ => ‖H z‖)
        (𝓝[{z : ℂ | z.re ∈ Ioo (0 : ℝ) 1}] w) (nhds ‖H w‖) :=
      ((hHc w hw).mono hsub).norm
    have hlimE : Filter.Tendsto
        (fun z : ℂ => Real.exp (-(stripPoissonIntegral g₀ g₁ z).re))
        (𝓝[{z : ℂ | z.re ∈ Ioo (0 : ℝ) 1}] w) (nhds (Real.exp (-v))) :=
      (Real.continuous_exp.tendsto _).comp hlimΦ.neg
    have hlim := hlimH.mul hlimE
    have hp : (0 : ℝ) < ‖H w‖ + ε := by linarith [norm_nonneg (H w)]
    have hvalue : ‖H w‖ * Real.exp (-v) < 1 := by
      rw [Real.exp_neg, hv, mul_inv_lt_iff₀ hp]
      linarith [norm_nonneg (H w)]
    filter_upwards [hlim.eventually_lt_const hvalue] with z hz
    rw [hGnorm]
    exact hz
  have hGbd : ∀ ζ : ℂ, ζ.re = 0 ∨ ζ.re = 1 →
      ∀ᶠ z in 𝓝[{z : ℂ | z.re ∈ Ioo (0 : ℝ) 1}] ζ,
        ‖H z * Complex.exp (-stripPoissonIntegral g₀ g₁ z)‖ < 1 := by
    intro ζ hζ
    rcases hζ with h | h
    · have hζeq : ((ζ.im : ℂ) * Complex.I) = ζ := by
        apply Complex.ext <;> simp [h]
      have hlim := tendsto_re_stripPoissonIntegral_left hgm₀ hgm₁ hint₀ hint₁
        (t₀ := ζ.im) hcont₀.continuousAt
      rw [hζeq] at hlim
      refine hkey ζ (g₀ ζ.im) (hζeq ▸ hmemL ζ.im) hlim ?_
      simp only [hg₀def]
      rw [hζeq]
      exact Real.exp_log (by linarith [norm_nonneg (H ζ)])
    · have hζeq : ((1 : ℂ) + (ζ.im : ℂ) * Complex.I) = ζ := by
        apply Complex.ext <;> simp [h]
      have hlim := tendsto_re_stripPoissonIntegral_right hgm₀ hgm₁ hint₀ hint₁
        (t₀ := ζ.im) hcont₁.continuousAt
      rw [hζeq] at hlim
      refine hkey ζ (g₁ ζ.im) (hζeq ▸ hmemR ζ.im) hlim ?_
      simp only [hg₁def]
      rw [hζeq]
      exact Real.exp_log (by linarith [norm_nonneg (H ζ)])
  have hmain := norm_le_of_boundary_lt_strip hGd hc0 hc one_pos hGgrow hGbd
  intro z hz
  have h1 := hmain z hz
  rw [hGnorm z] at h1
  have hpos : (0 : ℝ) < Real.exp ((stripPoissonIntegral g₀ g₁ z).re) := Real.exp_pos _
  rw [Real.exp_neg, mul_inv_le_iff₀ hpos] at h1
  linarith


/-! ### Jensen's inequality against a probability density

The final step of `lem:scalar-strip` needs Jensen's inequality against the normalized harmonic
measures.  Rather than build the measures `volume.withDensity (w / mass)`, it is shorter to prove
the weighted form directly from the tangent line `exp a (1 + u - a) ≤ exp u` at `u = a`: multiply
by the density, integrate, and the linear term integrates to the mean. -/

open MeasureTheory in
/-- **Jensen's inequality for `exp` against a probability density.** -/
theorem exp_integral_le_integral_exp_weighted {w h : ℝ → ℝ}
    (hw : ∀ t, 0 ≤ w t) (hwint : Integrable w) (hmass : ∫ t : ℝ, w t = 1)
    (hhw : Integrable fun t : ℝ => h t * w t)
    (hehw : Integrable fun t : ℝ => Real.exp (h t) * w t) :
    Real.exp (∫ t : ℝ, h t * w t) ≤ ∫ t : ℝ, Real.exp (h t) * w t := by
  set a : ℝ := ∫ t : ℝ, h t * w t with hadef
  have hpt : ∀ t : ℝ, Real.exp a * (1 + h t - a) * w t ≤ Real.exp (h t) * w t := by
    intro t
    refine mul_le_mul_of_nonneg_right ?_ (hw t)
    have h2 : 1 + h t - a ≤ Real.exp (h t - a) := by
      linarith [Real.add_one_le_exp (h t - a)]
    calc Real.exp a * (1 + h t - a) ≤ Real.exp a * Real.exp (h t - a) :=
          mul_le_mul_of_nonneg_left h2 (Real.exp_pos a).le
      _ = Real.exp (h t) := by
          rw [← Real.exp_add]
          congr 1
          ring
  have heq : (fun t : ℝ => Real.exp a * (1 + h t - a) * w t)
      = fun t : ℝ => Real.exp a * ((1 - a) * w t + h t * w t) := by
    funext t; ring
  have hlhsint : Integrable fun t : ℝ => Real.exp a * (1 + h t - a) * w t := by
    rw [heq]
    exact ((hwint.const_mul (1 - a)).add hhw).const_mul _
  have hint := integral_mono hlhsint hehw hpt
  have hval : (∫ t : ℝ, Real.exp a * (1 + h t - a) * w t) = Real.exp a := by
    rw [heq, integral_const_mul, integral_add (hwint.const_mul (1 - a)) hhw,
      integral_const_mul, hmass, ← hadef]
    ring
  rwa [hval] at hint

open MeasureTheory in
/-- **Jensen's inequality in geometric-mean form against a probability density.** -/
theorem integral_log_le_log_integral_weighted {w f : ℝ → ℝ}
    (hw : ∀ t, 0 ≤ w t) (hwint : Integrable w) (hmass : ∫ t : ℝ, w t = 1)
    (hf : ∀ t, 0 < f t)
    (hlogw : Integrable fun t : ℝ => Real.log (f t) * w t)
    (hfw : Integrable fun t : ℝ => f t * w t) :
    ∫ t : ℝ, Real.log (f t) * w t ≤ Real.log (∫ t : ℝ, f t * w t) := by
  have hexp : (fun t : ℝ => Real.exp (Real.log (f t)) * w t) = fun t : ℝ => f t * w t := by
    funext t
    rw [Real.exp_log (hf t)]
  have h := exp_integral_le_integral_exp_weighted hw hwint hmass hlogw (by rw [hexp]; exact hfw)
  rw [hexp] at h
  calc ∫ t : ℝ, Real.log (f t) * w t
      = Real.log (Real.exp (∫ t : ℝ, Real.log (f t) * w t)) := (Real.log_exp _).symm
    _ ≤ Real.log (∫ t : ℝ, f t * w t) := Real.log_le_log (Real.exp_pos _) h


open MeasureTheory in
/-- One edge of the Jensen step of `lem:scalar-strip`: for a positive density `w` of total mass
`m`, the `w`-integral of `log u` is at most `m / s` times the logarithm of the normalized
`s`-th power mean of `u`. -/
theorem weighted_log_pow_bound {u w : ℝ → ℝ} {m s : ℝ}
    (hs : 0 < s) (hm : 0 < m)
    (hwpos : ∀ t, 0 < w t) (hwint : Integrable w) (hmass : ∫ t : ℝ, w t = m)
    (hu : ∀ t, 0 < u t)
    (hlogw : Integrable fun t : ℝ => Real.log (u t) * w t)
    (hpow : Integrable fun t : ℝ => u t ^ s * (w t / m)) :
    0 < (∫ t : ℝ, u t ^ s * (w t / m))
      ∧ (∫ t : ℝ, Real.log (u t) * w t)
        ≤ m / s * Real.log (∫ t : ℝ, u t ^ s * (w t / m)) := by
  have hŵ0 : ∀ t, 0 ≤ w t / m := fun t => by
    have := (hwpos t).le
    positivity
  have hŵint : Integrable fun t : ℝ => w t / m := hwint.div_const m
  have hŵmass : ∫ t : ℝ, w t / m = 1 := by
    rw [integral_div, hmass, div_self hm.ne']
  have hf : ∀ t, 0 < u t ^ s := fun t => Real.rpow_pos_of_pos (hu t) s
  have hlogf : ∀ t, Real.log (u t ^ s) = s * Real.log (u t) := fun t => Real.log_rpow (hu t) s
  have h2 : (fun t : ℝ => Real.log (u t ^ s) * (w t / m))
      = fun t : ℝ => (s / m) * (Real.log (u t) * w t) := by
    funext t
    rw [hlogf]
    field_simp
  have hlogfw : Integrable fun t : ℝ => Real.log (u t ^ s) * (w t / m) := by
    rw [h2]
    exact hlogw.const_mul _
  have hexp : (fun t : ℝ => Real.exp (Real.log (u t ^ s)) * (w t / m))
      = fun t : ℝ => u t ^ s * (w t / m) := by
    funext t
    rw [Real.exp_log (hf t)]
  have hpos : 0 < ∫ t : ℝ, u t ^ s * (w t / m) := by
    have h := exp_integral_le_integral_exp_weighted hŵ0 hŵint hŵmass hlogfw
      (by rw [hexp]; exact hpow)
    rw [hexp] at h
    exact lt_of_lt_of_le (Real.exp_pos _) h
  refine ⟨hpos, ?_⟩
  have hjen := integral_log_le_log_integral_weighted hŵ0 hŵint hŵmass hf hlogfw hpow
  rw [h2, integral_const_mul] at hjen
  have hms : (0 : ℝ) < m / s := by positivity
  have hfin := mul_le_mul_of_nonneg_left hjen hms.le
  rw [show m / s * (s / m * ∫ t : ℝ, Real.log (u t) * w t)
      = ∫ t : ℝ, Real.log (u t) * w t by field_simp] at hfin
  exact hfin


open MeasureTheory in
/-- **The scalar strip inequality**, blueprint `lem:scalar-strip`, in its `ε`-regularized form.
For `H` continuous on the closed strip, analytic inside, of admissible growth
`exp (B exp (c |im z|))` with `c < π`, and for every `s > 0`, the modulus of `H` at the interior
real point `θ` is at most the geometric mean, with weights `1 - θ` and `θ`, of the `s`-th power
means of `‖H‖ + ε` on the two edges against the normalized harmonic measures. -/
theorem norm_le_geom_mean_strip {H : ℂ → ℂ} {θ s ε : ℝ}
    (hθ : θ ∈ Ioo (0 : ℝ) 1) (hs : 0 < s) (hε : 0 < ε)
    (hHc : ContinuousOn H {z : ℂ | z.re ∈ Icc (0 : ℝ) 1})
    (hHd : DifferentiableOn ℂ H {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1})
    {B c : ℝ} (hc0 : 0 ≤ c) (hc : c < π)
    (hgrow : ∀ z : ℂ, z.re ∈ Ioo (0 : ℝ) 1 → ‖H z‖ ≤ Real.exp (B * Real.exp (c * |z.im|)))
    (hint₀ : Integrable fun t : ℝ =>
      |Real.log (‖H ((t : ℂ) * Complex.I)‖ + ε)| / Real.cosh (π * t))
    (hint₁ : Integrable fun t : ℝ =>
      |Real.log (‖H (1 + (t : ℂ) * Complex.I)‖ + ε)| / Real.cosh (π * t))
    (hpow₀ : Integrable fun t : ℝ =>
      (‖H ((t : ℂ) * Complex.I)‖ + ε) ^ s * (poissonStrip θ 1 t / (1 - θ)))
    (hpow₁ : Integrable fun t : ℝ =>
      (‖H (1 + (t : ℂ) * Complex.I)‖ + ε) ^ s * (poissonStrip θ (-1) t / θ)) :
    ‖H (θ : ℂ)‖
      ≤ (∫ t : ℝ, (‖H ((t : ℂ) * Complex.I)‖ + ε) ^ s * (poissonStrip θ 1 t / (1 - θ)))
          ^ ((1 - θ) / s)
        * (∫ t : ℝ, (‖H (1 + (t : ℂ) * Complex.I)‖ + ε) ^ s * (poissonStrip θ (-1) t / θ))
          ^ (θ / s) := by
  obtain ⟨hθ0, hθ1⟩ := hθ
  have hθre : ((θ : ℂ)).re ∈ Ioo (0 : ℝ) 1 := by
    rw [Complex.ofReal_re]
    exact ⟨hθ0, hθ1⟩
  set g₀ : ℝ → ℝ := fun t => Real.log (‖H ((t : ℂ) * Complex.I)‖ + ε) with hg₀def
  set g₁ : ℝ → ℝ := fun t => Real.log (‖H (1 + (t : ℂ) * Complex.I)‖ + ε) with hg₁def
  -- continuity of the boundary data, as in the majorization
  have hmemL : ∀ t : ℝ, ((t : ℂ) * Complex.I) ∈ {z : ℂ | z.re ∈ Icc (0 : ℝ) 1} := by
    intro t; simp [Set.mem_Icc]
  have hmemR : ∀ t : ℝ, ((1 : ℂ) + (t : ℂ) * Complex.I) ∈ {z : ℂ | z.re ∈ Icc (0 : ℝ) 1} := by
    intro t; simp [Set.mem_Icc]
  have hleft : Continuous fun t : ℝ => H ((t : ℂ) * Complex.I) :=
    hHc.comp_continuous (by fun_prop) hmemL
  have hright : Continuous fun t : ℝ => H ((1 : ℂ) + (t : ℂ) * Complex.I) :=
    hHc.comp_continuous (by fun_prop) hmemR
  have hposL : ∀ t : ℝ, (0 : ℝ) < ‖H ((t : ℂ) * Complex.I)‖ + ε := fun t => by
    linarith [norm_nonneg (H ((t : ℂ) * Complex.I))]
  have hposR : ∀ t : ℝ, (0 : ℝ) < ‖H ((1 : ℂ) + (t : ℂ) * Complex.I)‖ + ε := fun t => by
    linarith [norm_nonneg (H ((1 : ℂ) + (t : ℂ) * Complex.I))]
  have hcont₀ : Continuous g₀ := by
    rw [hg₀def]
    refine continuous_iff_continuousAt.mpr fun t => ?_
    have hinner : ContinuousAt (fun x : ℝ => ‖H ((x : ℂ) * Complex.I)‖ + ε) t :=
      (hleft.norm.add continuous_const).continuousAt
    exact hinner.log (hposL t).ne'
  have hcont₁ : Continuous g₁ := by
    rw [hg₁def]
    refine continuous_iff_continuousAt.mpr fun t => ?_
    have hinner : ContinuousAt (fun x : ℝ => ‖H ((1 : ℂ) + (x : ℂ) * Complex.I)‖ + ε) t :=
      (hright.norm.add continuous_const).continuousAt
    exact hinner.log (hposR t).ne'
  have hgm₀ : AEStronglyMeasurable g₀ volume := hcont₀.aestronglyMeasurable
  have hgm₁ : AEStronglyMeasurable g₁ volume := hcont₁.aestronglyMeasurable
  -- the majorization at the real point `θ`
  have hmaj := norm_le_exp_re_stripPoissonIntegral hHc hHd hc0 hc hε hgrow hint₀ hint₁
    (θ : ℂ) hθre
  have hre := re_stripPoissonIntegral' hgm₀ hgm₁ hint₀ hint₁ hθre
  simp only [Complex.ofReal_re, Complex.ofReal_im, sub_zero] at hre
  -- the two Jensen bounds
  have hmass₀ : ∫ t : ℝ, poissonStrip θ 1 t = 1 - θ := integral_poissonStrip_one ⟨hθ0, hθ1⟩
  have hmass₁ : ∫ t : ℝ, poissonStrip θ (-1) t = θ := integral_poissonStrip_neg_one ⟨hθ0, hθ1⟩
  have hlog₀ : Integrable fun t : ℝ => g₀ t * poissonStrip θ 1 t := by
    have h := integrable_mul_poissonStrip hgm₀ hint₀ ⟨hθ0, hθ1⟩
      (by norm_num : |(1 : ℝ)| ≤ 1) (0 : ℝ)
    simpa using h
  have hlog₁ : Integrable fun t : ℝ => g₁ t * poissonStrip θ (-1) t := by
    have h := integrable_mul_poissonStrip hgm₁ hint₁ ⟨hθ0, hθ1⟩
      (by norm_num : |(-1 : ℝ)| ≤ 1) (0 : ℝ)
    simpa using h
  obtain ⟨hA₀pos, hA₀⟩ := weighted_log_pow_bound hs (by linarith : (0 : ℝ) < 1 - θ)
    (fun t => poissonStrip_pos ⟨hθ0, hθ1⟩ (by norm_num : |(1 : ℝ)| ≤ 1) t)
    (integrable_poissonStrip ⟨hθ0, hθ1⟩ (by norm_num : |(1 : ℝ)| ≤ 1)) hmass₀ hposL hlog₀ hpow₀
  obtain ⟨hA₁pos, hA₁⟩ := weighted_log_pow_bound hs hθ0
    (fun t => poissonStrip_pos ⟨hθ0, hθ1⟩ (by norm_num : |(-1 : ℝ)| ≤ 1) t)
    (integrable_poissonStrip ⟨hθ0, hθ1⟩ (by norm_num : |(-1 : ℝ)| ≤ 1)) hmass₁ hposR hlog₁ hpow₁
  set A₀ : ℝ := ∫ t : ℝ, (‖H ((t : ℂ) * Complex.I)‖ + ε) ^ s * (poissonStrip θ 1 t / (1 - θ))
    with hA₀def
  set A₁ : ℝ := ∫ t : ℝ, (‖H (1 + (t : ℂ) * Complex.I)‖ + ε) ^ s * (poissonStrip θ (-1) t / θ)
    with hA₁def
  have hlogle : (stripPoissonIntegral g₀ g₁ (θ : ℂ)).re
      ≤ (1 - θ) / s * Real.log A₀ + θ / s * Real.log A₁ := by
    rw [hre]
    linarith [hA₀, hA₁]
  calc ‖H (θ : ℂ)‖ ≤ Real.exp ((stripPoissonIntegral g₀ g₁ (θ : ℂ)).re) := hmaj
    _ ≤ Real.exp ((1 - θ) / s * Real.log A₀ + θ / s * Real.log A₁) :=
        Real.exp_le_exp.mpr hlogle
    _ = A₀ ^ ((1 - θ) / s) * A₁ ^ (θ / s) := by
        rw [Real.rpow_def_of_pos hA₀pos, Real.rpow_def_of_pos hA₁pos, ← Real.exp_add]
        congr 1
        ring


/-! ### Removing the regularization

The hypotheses of `norm_le_geom_mean_strip` depend on `ε`.  For the passage `ε → 0` they are
reduced to their `ε = 1` instances: `log (x + ε)` lies between `log ε` and `log (x + 1)`, and
`(x + ε) ^ s ≤ (x + 1) ^ s`, so both integrability hypotheses for `ε ∈ (0, 1]` follow from the
ones at `ε = 1` together with the integrability of the reference weight. -/

theorem abs_log_add_le {x ε : ℝ} (hx : 0 ≤ x) (hε0 : 0 < ε) (hε1 : ε ≤ 1) :
    |Real.log (x + ε)| ≤ |Real.log (x + 1)| + |Real.log ε| := by
  have hxe : (0 : ℝ) < x + ε := by linarith
  have hmono : Real.log (x + ε) ≤ Real.log (x + 1) := Real.log_le_log hxe (by linarith)
  have hlow : Real.log ε ≤ Real.log (x + ε) := Real.log_le_log hε0 (by linarith)
  rcases le_or_gt 0 (Real.log (x + ε)) with h | h
  · rw [abs_of_nonneg h]
    linarith [le_abs_self (Real.log (x + 1)), abs_nonneg (Real.log ε)]
  · rw [abs_of_neg h]
    linarith [neg_le_abs (Real.log ε), abs_nonneg (Real.log (x + 1))]

open MeasureTheory in
theorem integrable_abs_log_shift {F : ℝ → ℝ} (hF : ∀ t, 0 ≤ F t) (hFc : Continuous F)
    (h1 : Integrable fun t : ℝ => |Real.log (F t + 1)| / Real.cosh (π * t))
    {ε : ℝ} (hε0 : 0 < ε) (hε1 : ε ≤ 1) :
    Integrable fun t : ℝ => |Real.log (F t + ε)| / Real.cosh (π * t) := by
  have hbound : Integrable fun t : ℝ =>
      |Real.log (F t + 1)| / Real.cosh (π * t) + |Real.log ε| * (1 / Real.cosh (π * t)) :=
    h1.add (integrable_inv_cosh.const_mul _)
  have hc : Continuous fun t : ℝ => |Real.log (F t + ε)| / Real.cosh (π * t) := by
    refine Continuous.div ?_ (by fun_prop) fun t => (Real.cosh_pos _).ne'
    refine continuous_abs.comp (continuous_iff_continuousAt.mpr fun t => ?_)
    exact ((hFc.add continuous_const).continuousAt).log
      (by linarith [hF t] : (0 : ℝ) < F t + ε).ne'
  refine Integrable.mono' hbound hc.aestronglyMeasurable ?_
  filter_upwards with t
  have hCt : (0 : ℝ) < Real.cosh (π * t) := Real.cosh_pos _
  rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
  calc |Real.log (F t + ε)| / Real.cosh (π * t)
      ≤ (|Real.log (F t + 1)| + |Real.log ε|) / Real.cosh (π * t) :=
        (div_le_div_iff_of_pos_right hCt).mpr (abs_log_add_le (hF t) hε0 hε1)
    _ = |Real.log (F t + 1)| / Real.cosh (π * t)
          + |Real.log ε| * (1 / Real.cosh (π * t)) := by
        field_simp

open MeasureTheory in
theorem integrable_rpow_shift {F w : ℝ → ℝ} {s : ℝ} (hs : 0 < s)
    (hF : ∀ t, 0 ≤ F t) (hFc : Continuous F) (hw : ∀ t, 0 ≤ w t) (hwc : Continuous w)
    (h1 : Integrable fun t : ℝ => (F t + 1) ^ s * w t)
    {ε : ℝ} (hε0 : 0 < ε) (hε1 : ε ≤ 1) :
    Integrable fun t : ℝ => (F t + ε) ^ s * w t := by
  have hrc : Continuous fun t : ℝ => (F t + ε) ^ s := by
    refine continuous_iff_continuousAt.mpr fun t => ?_
    exact (Real.continuousAt_rpow_const _ _ (Or.inr hs.le)).comp
      ((hFc.add continuous_const).continuousAt)
  refine Integrable.mono' h1 (hrc.mul hwc).aestronglyMeasurable ?_
  filter_upwards with t
  have hFe : (0 : ℝ) ≤ F t + ε := by linarith [hF t]
  have hpow : (0 : ℝ) ≤ (F t + ε) ^ s := Real.rpow_nonneg hFe s
  rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hpow (hw t))]
  exact mul_le_mul_of_nonneg_right
    (Real.rpow_le_rpow hFe (by linarith) hs.le) (hw t)


open MeasureTheory Filter Topology in
/-- Dominated convergence for the regularized power means as `ε → 0⁺`. -/
theorem tendsto_integral_rpow_shift {F w : ℝ → ℝ} {s : ℝ} (hs : 0 < s)
    (hF : ∀ t, 0 ≤ F t) (hFc : Continuous F) (hw : ∀ t, 0 ≤ w t) (hwc : Continuous w)
    (h1 : Integrable fun t : ℝ => (F t + 1) ^ s * w t) :
    Filter.Tendsto (fun ε : ℝ => ∫ t : ℝ, (F t + ε) ^ s * w t)
      (nhdsWithin 0 (Ioi (0 : ℝ))) (nhds (∫ t : ℝ, F t ^ s * w t)) := by
  have hrc : ∀ ε : ℝ, Continuous fun t : ℝ => (F t + ε) ^ s := by
    intro ε
    refine continuous_iff_continuousAt.mpr fun t => ?_
    exact (Real.continuousAt_rpow_const _ _ (Or.inr hs.le)).comp
      ((hFc.add continuous_const).continuousAt)
  have hle1 : ∀ᶠ ε : ℝ in nhdsWithin 0 (Ioi (0 : ℝ)), ε ≤ 1 := by
    refine Filter.Eventually.filter_mono nhdsWithin_le_nhds ?_
    exact (eventually_lt_nhds (by norm_num : (0 : ℝ) < 1)).mono fun x hx => hx.le
  refine tendsto_integral_filter_of_dominated_convergence
    (fun t => (F t + 1) ^ s * w t) ?_ ?_ h1 ?_
  · filter_upwards with ε
    exact ((hrc ε).mul hwc).aestronglyMeasurable
  · filter_upwards [hle1, self_mem_nhdsWithin] with ε hε1 hε0
    filter_upwards with t
    have hFe : (0 : ℝ) ≤ F t + ε := by linarith [hF t, Set.mem_Ioi.mp hε0]
    have hpow : (0 : ℝ) ≤ (F t + ε) ^ s := Real.rpow_nonneg hFe s
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hpow (hw t))]
    exact mul_le_mul_of_nonneg_right (Real.rpow_le_rpow hFe (by linarith) hs.le) (hw t)
  · filter_upwards with t
    have hbase : Filter.Tendsto (fun ε : ℝ => F t + ε) (nhdsWithin 0 (Ioi (0 : ℝ)))
        (nhds (F t)) := by
      have hc : Continuous fun x : ℝ => F t + x := by fun_prop
      have h0 := hc.tendsto 0
      rw [add_zero] at h0
      exact h0.mono_left nhdsWithin_le_nhds
    have hpow : Filter.Tendsto (fun ε : ℝ => (F t + ε) ^ s) (nhdsWithin 0 (Ioi (0 : ℝ)))
        (nhds (F t ^ s)) :=
      ((Real.continuousAt_rpow_const (F t) s (Or.inr hs.le)).tendsto).comp hbase
    exact hpow.mul_const (w t)


open MeasureTheory Filter Topology in
/-- **The scalar strip inequality, blueprint `lem:scalar-strip`.**  For `H` continuous on the
closed strip, analytic inside, of admissible growth `exp (B exp (c |im z|))` with `c < π`, and for
every `s > 0`, the modulus of `H` at the interior real point `θ` is at most the geometric mean,
with weights `1 - θ` and `θ`, of the `s`-th power means of `‖H‖` on the two edges against the
normalized harmonic measures `w₀ / (1 - θ)` and `w₁ / θ`. -/
theorem norm_le_geom_mean_strip_zero {H : ℂ → ℂ} {θ s : ℝ}
    (hθ : θ ∈ Ioo (0 : ℝ) 1) (hs : 0 < s)
    (hHc : ContinuousOn H {z : ℂ | z.re ∈ Icc (0 : ℝ) 1})
    (hHd : DifferentiableOn ℂ H {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1})
    {B c : ℝ} (hc0 : 0 ≤ c) (hc : c < π)
    (hgrow : ∀ z : ℂ, z.re ∈ Ioo (0 : ℝ) 1 → ‖H z‖ ≤ Real.exp (B * Real.exp (c * |z.im|)))
    (hint₀ : Integrable fun t : ℝ =>
      |Real.log (‖H ((t : ℂ) * Complex.I)‖ + 1)| / Real.cosh (π * t))
    (hint₁ : Integrable fun t : ℝ =>
      |Real.log (‖H (1 + (t : ℂ) * Complex.I)‖ + 1)| / Real.cosh (π * t))
    (hpow₀ : Integrable fun t : ℝ =>
      (‖H ((t : ℂ) * Complex.I)‖ + 1) ^ s * (poissonStrip θ 1 t / (1 - θ)))
    (hpow₁ : Integrable fun t : ℝ =>
      (‖H (1 + (t : ℂ) * Complex.I)‖ + 1) ^ s * (poissonStrip θ (-1) t / θ)) :
    ‖H (θ : ℂ)‖
      ≤ (∫ t : ℝ, ‖H ((t : ℂ) * Complex.I)‖ ^ s * (poissonStrip θ 1 t / (1 - θ)))
          ^ ((1 - θ) / s)
        * (∫ t : ℝ, ‖H (1 + (t : ℂ) * Complex.I)‖ ^ s * (poissonStrip θ (-1) t / θ))
          ^ (θ / s) := by
  obtain ⟨hθ0, hθ1⟩ := hθ
  have h1θ : (0 : ℝ) < 1 - θ := by linarith
  have hmemL : ∀ t : ℝ, ((t : ℂ) * Complex.I) ∈ {z : ℂ | z.re ∈ Icc (0 : ℝ) 1} := by
    intro t; simp [Set.mem_Icc]
  have hmemR : ∀ t : ℝ, ((1 : ℂ) + (t : ℂ) * Complex.I) ∈ {z : ℂ | z.re ∈ Icc (0 : ℝ) 1} := by
    intro t; simp [Set.mem_Icc]
  have hF₀c : Continuous fun t : ℝ => ‖H ((t : ℂ) * Complex.I)‖ :=
    (hHc.comp_continuous (by fun_prop) hmemL).norm
  have hF₁c : Continuous fun t : ℝ => ‖H ((1 : ℂ) + (t : ℂ) * Complex.I)‖ :=
    (hHc.comp_continuous (by fun_prop) hmemR).norm
  have hw₀c : Continuous fun t : ℝ => poissonStrip θ 1 t / (1 - θ) :=
    (continuous_poissonStrip ⟨hθ0, hθ1⟩ (by norm_num : |(1 : ℝ)| ≤ 1)).div_const _
  have hw₁c : Continuous fun t : ℝ => poissonStrip θ (-1) t / θ :=
    (continuous_poissonStrip ⟨hθ0, hθ1⟩ (by norm_num : |(-1 : ℝ)| ≤ 1)).div_const _
  have hw₀ : ∀ t : ℝ, 0 ≤ poissonStrip θ 1 t / (1 - θ) := fun t => by
    have h := (poissonStrip_pos ⟨hθ0, hθ1⟩ (by norm_num : |(1 : ℝ)| ≤ 1) t).le
    positivity
  have hw₁ : ∀ t : ℝ, 0 ≤ poissonStrip θ (-1) t / θ := fun t => by
    have h := (poissonStrip_pos ⟨hθ0, hθ1⟩ (by norm_num : |(-1 : ℝ)| ≤ 1) t).le
    positivity
  have hp : (0 : ℝ) < (1 - θ) / s := by positivity
  have hq : (0 : ℝ) < θ / s := by positivity
  have hlim₀ := tendsto_integral_rpow_shift hs (fun t => norm_nonneg _) hF₀c hw₀ hw₀c hpow₀
  have hlim₁ := tendsto_integral_rpow_shift hs (fun t => norm_nonneg _) hF₁c hw₁ hw₁c hpow₁
  have hr₀ : Filter.Tendsto
      (fun ε : ℝ => (∫ t : ℝ, (‖H ((t : ℂ) * Complex.I)‖ + ε) ^ s
        * (poissonStrip θ 1 t / (1 - θ))) ^ ((1 - θ) / s))
      (nhdsWithin 0 (Ioi (0 : ℝ)))
      (nhds ((∫ t : ℝ, ‖H ((t : ℂ) * Complex.I)‖ ^ s
        * (poissonStrip θ 1 t / (1 - θ))) ^ ((1 - θ) / s))) :=
    ((Real.continuousAt_rpow_const _ ((1 - θ) / s) (Or.inr hp.le)).tendsto).comp hlim₀
  have hr₁ : Filter.Tendsto
      (fun ε : ℝ => (∫ t : ℝ, (‖H ((1 : ℂ) + (t : ℂ) * Complex.I)‖ + ε) ^ s
        * (poissonStrip θ (-1) t / θ)) ^ (θ / s))
      (nhdsWithin 0 (Ioi (0 : ℝ)))
      (nhds ((∫ t : ℝ, ‖H ((1 : ℂ) + (t : ℂ) * Complex.I)‖ ^ s
        * (poissonStrip θ (-1) t / θ)) ^ (θ / s))) :=
    ((Real.continuousAt_rpow_const _ (θ / s) (Or.inr hq.le)).tendsto).comp hlim₁
  refine ge_of_tendsto (hr₀.mul hr₁) ?_
  filter_upwards [self_mem_nhdsWithin,
    (eventually_lt_nhds (by norm_num : (0 : ℝ) < 1)).filter_mono nhdsWithin_le_nhds]
    with ε hε0 hε1
  have hε0' : (0 : ℝ) < ε := Set.mem_Ioi.mp hε0
  exact norm_le_geom_mean_strip ⟨hθ0, hθ1⟩ hs hε0' hHc hHd hc0 hc hgrow
    (integrable_abs_log_shift (fun t => norm_nonneg _) hF₀c hint₀ hε0' hε1.le)
    (integrable_abs_log_shift (fun t => norm_nonneg _) hF₁c hint₁ hε0' hε1.le)
    (integrable_rpow_shift hs (fun t => norm_nonneg _) hF₀c hw₀ hw₀c hpow₀ hε0' hε1.le)
    (integrable_rpow_shift hs (fun t => norm_nonneg _) hF₁c hw₁ hw₁c hpow₁ hε0' hε1.le)

end Auto
