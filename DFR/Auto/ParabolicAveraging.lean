/-- The positive-half-line factor of the analytic parabolic kernel. -/
def parabolicLaplaceDensity (z : ℂ) (u : ℝ) : ℂ :=
  (Set.Ioi (0:ℝ)).indicator (parabolicLaplaceIntegrand z 1) u

/-- The physical-space analytic kernel, with the parabolic shear explicit. -/
