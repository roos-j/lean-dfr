    simp only [hz,sub_self,Real.rpow_zero,one_mul,Complex.one_re,neg_one_mul]
    exact (Real.exp_le_one_iff).mpr (by linarith)
  · simp [parabolicLaplaceDensity,Set.indicator_of_notMem (show u ∉ Set.Ioi (0:ℝ) from hu)]

