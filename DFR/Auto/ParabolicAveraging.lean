  unfold parabolicAnalyticKernel
  simpa only [Function.comp_def,neg_one_mul,← sub_eq_add_neg,mul_assoc] using! hh

/-- The inverse parabolic shear as a measurable equivalence. -/
def parabolicShearEquiv (c : ℝ) : (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) where
  toFun p := (p.1,p.2+c*p.1^2)
  invFun p := (p.1,p.2-c*p.1^2)
  left_inv p := by ext <;> simp
  right_inv p := by ext <;> simp
  measurable_toFun := by change Measurable (fun p : ℝ × ℝ => (p.1,p.2+c*p.1^2)); fun_prop
  measurable_invFun := by change Measurable (fun p : ℝ × ℝ => (p.1,p.2-c*p.1^2)); fun_prop

/-- Fourier transform of the one-sided Laplace density. -/
theorem parabolicLaplaceDensity_fourier {z : ℂ} (hz : 0 < z.re) (v : ℝ) :
    (∫ u : ℝ, parabolicLaplaceDensity z u *
      Complex.exp (-2*Real.pi*Complex.I*(v:ℂ)*(u:ℂ))) =
      (parabolicGaussianCoefficient v)^(-z)*Complex.Gamma z := by
  rw [← parabolicLaplace_eq_gamma hz (by rw [parabolicGaussianCoefficient_re]; norm_num)]
  have he (u : ℝ) :
      parabolicLaplaceIntegrand z 1 u * Complex.exp (-2*Real.pi*Complex.I*(v:ℂ)*(u:ℂ)) =
      parabolicLaplaceIntegrand z (parabolicGaussianCoefficient v) u := by
    simp only [parabolicLaplaceIntegrand,mul_assoc,← Complex.exp_add]
    congr 2
    dsimp [parabolicGaussianCoefficient]
    ring
  calc
    _ = ∫ u : ℝ, (Set.Ioi (0:ℝ)).indicator
        (parabolicLaplaceIntegrand z (parabolicGaussianCoefficient v)) u := by
      apply integral_congr_ae
      filter_upwards [] with u
      by_cases hu : u ∈ Set.Ioi (0:ℝ)
      · simp only [parabolicLaplaceDensity,Set.indicator_of_mem hu,he]
      · simp only [parabolicLaplaceDensity,Set.indicator_of_notMem hu,zero_mul]
    _ = _ := integral_indicator measurableSet_Ioi

/-- The planar Fourier character, written in coordinates for the kernel calculation. -/
def parabolicFourierCharacter (ξ p : ℝ × ℝ) : ℂ :=
  Complex.exp (-2*Real.pi*Complex.I*((ξ.1*p.1+ξ.2*p.2:ℝ):ℂ))

/-- Exact Fourier transform of the analytic parabolic kernel on Re z > 0. -/
theorem parabolicAnalyticKernel_fourier {z : ℂ} (hz : 0 < z.re) (ξ : ℝ × ℝ) :
    (∫ p : ℝ × ℝ, parabolicAnalyticKernel z p * parabolicFourierCharacter ξ p) =
      parabolicAnalyticMultiplier z ξ := by
  let A : ℝ → ℂ := fun x => Complex.exp (-(x:ℂ)^2)*
    Complex.exp (-2*Real.pi*Complex.I*((ξ.1*x+ξ.2*x^2:ℝ):ℂ))
  let B : ℝ → ℂ := fun u => parabolicLaplaceDensity z u *
    Complex.exp (-2*Real.pi*Complex.I*(ξ.2:ℂ)*(u:ℂ))
  have he (p : ℝ × ℝ) :
      parabolicAnalyticKernel z (parabolicShearEquiv 1 p) *
        parabolicFourierCharacter ξ (parabolicShearEquiv 1 p) =
      (Complex.exp (z^2)*z)*(A p.1*B p.2) := by
    change (Complex.exp (z^2)*z*Complex.exp (-(p.1:ℂ)^2)*
      parabolicLaplaceDensity z (p.2+1*p.1^2-p.1^2))*
      Complex.exp (-2*Real.pi*Complex.I*((ξ.1*p.1+ξ.2*(p.2+1*p.1^2):ℝ):ℂ)) = _
    simp only [one_mul,add_sub_cancel_right,A,B]
    have hp : -2*(Real.pi:ℂ)*Complex.I*((ξ.1*p.1+ξ.2*(p.2+p.1^2):ℝ):ℂ) =
        -2*Real.pi*Complex.I*((ξ.1*p.1+ξ.2*p.1^2:ℝ):ℂ)+
        -2*Real.pi*Complex.I*(ξ.2:ℂ)*(p.2:ℂ) := by push_cast; ring
    rw [hp,Complex.exp_add]
    ring
  have hchange := (parabolicShear_measurePreserving 1).integral_comp
    (parabolicShearEquiv 1).measurableEmbedding
    (fun p => parabolicAnalyticKernel z p * parabolicFourierCharacter ξ p)
  calc
    _ = ∫ p : ℝ × ℝ, (Complex.exp (z^2)*z)*(A p.1*B p.2) := by
      rw [← hchange]
      apply integral_congr_ae
      exact Filter.Eventually.of_forall he
    _ = (Complex.exp (z^2)*z)*((∫ x, A x)*(∫ u, B u)) := by
      rw [integral_const_mul]
      congr 1
      exact integral_prod_mul A B
    _ = parabolicAnalyticMultiplier z ξ := by
      change (Complex.exp (z^2)*z)*(parabolicGaussianSymbol ξ*(∫ u, B u)) = _
      rw [show (∫ u, B u) = (parabolicGaussianCoefficient ξ.2)^(-z)*Complex.Gamma z from
        parabolicLaplaceDensity_fourier hz ξ.2]
      have hz0 : z ≠ 0 := by intro he; subst z; norm_num at hz
      rw [parabolicAnalyticMultiplier,Complex.Gamma_add_one z hz0]
      ring

/-- The multiplier is holomorphic in its parameter throughout the
half-plane containing the closed interpolation strip. -/
theorem parabolicAnalyticMultiplier_differentiableAt {z : ℂ} (hz : -1 < z.re)
    (ξ : ℝ × ℝ) : DifferentiableAt ℂ (fun w => parabolicAnalyticMultiplier w ξ) z := by
  have hg : DifferentiableAt ℂ (fun w : ℂ => Complex.Gamma (w+1)) z := by
    have havoid : ∀ n : ℕ, z+1 ≠ -(n:ℂ) := by
      intro n he
      have hre := congrArg Complex.re he
      simp only [Complex.add_re,Complex.one_re,Complex.neg_re,Complex.natCast_re] at hre
      have hn : (0:ℝ) ≤ n := Nat.cast_nonneg n
      linarith
    exact (Complex.differentiableAt_Gamma (z+1) havoid).comp z (by fun_prop)
  have hp : DifferentiableAt ℂ (fun w : ℂ => (parabolicGaussianCoefficient ξ.2)^(-w)) z :=
    (differentiableAt_id.neg).const_cpow (Or.inl (parabolicGaussianCoefficient_ne_zero _))
  exact (((differentiableAt_id.pow 2).cexp.mul hg).mul hp).mul_const (parabolicGaussianSymbol ξ)

/-- Measurable representatives of L2 functions, used to satisfy the
pointwise linearity contract of Stein interpolation. -/
def parabolicL2Representatives {X : Type*} [MeasurableSpace X] (μ : Measure X) :
    Submodule ℂ (X → ℂ) where
  carrier := {f | Measurable f ∧ MemLp f 2 μ}
  zero_mem' := ⟨measurable_const,MemLp.zero⟩
  add_mem' hf hg := ⟨hf.1.add hg.1,hf.2.add hg.2⟩
  smul_mem' c _ hf := ⟨measurable_const.smul hf.1,hf.2.const_smul c⟩

/-- The linear quotient map from actual measurable representatives to L2. -/
def parabolicL2Quotient {X : Type*} [MeasurableSpace X] (μ : Measure X) :
    parabolicL2Representatives μ →ₗ[ℂ] Lp ℂ 2 μ where
  toFun f := f.property.2.toLp f.val
  map_add' f g := MemLp.toLp_add f.property.2 g.property.2
  map_smul' c f := MemLp.toLp_const_smul c f.property.2

/-- Every L2 equivalence class has a measurable representative. -/
theorem parabolicL2Quotient_surjective {X : Type*} [MeasurableSpace X] (μ : Measure X) :
    Function.Surjective (parabolicL2Quotient μ) := by
  intro f
  refine ⟨⟨f, (Lp.stronglyMeasurable f).measurable,Lp.memLp f⟩,?_⟩
  exact Lp.toLp_coeFn f (Lp.memLp f)

/-- A linear choice of measurable L2 representatives. No continuity in the
pointwise function topology is asserted or needed. -/
def parabolicL2Section {X : Type*} [MeasurableSpace X] (μ : Measure X) :
    Lp ℂ 2 μ →ₗ[ℂ] parabolicL2Representatives μ :=
  ((parabolicL2Quotient μ).exists_rightInverse_of_surjective
    (LinearMap.range_eq_top.mpr (parabolicL2Quotient_surjective μ))).choose

theorem parabolicL2Section_rightInverse {X : Type*} [MeasurableSpace X] (μ : Measure X) :
    (parabolicL2Quotient μ).comp (parabolicL2Section μ) = LinearMap.id :=
  ((parabolicL2Quotient μ).exists_rightInverse_of_surjective
    (LinearMap.range_eq_top.mpr (parabolicL2Quotient_surjective μ))).choose_spec

/-- The chosen pointwise-linear representative agrees almost everywhere
with the canonical L2 representative. -/
theorem parabolicL2Section_ae {X : Type*} [MeasurableSpace X] (μ : Measure X) (f : Lp ℂ 2 μ) :
    ((parabolicL2Section μ f).val : X → ℂ) =ᵐ[μ] f := by
  have he := LinearMap.congr_fun (parabolicL2Section_rightInverse μ) f
  change parabolicL2Quotient μ (parabolicL2Section μ f) = f at he
  have hae := (parabolicL2Section μ f).property.2.coeFn_toLp
  change ((parabolicL2Quotient μ) (parabolicL2Section μ f) : X → ℂ) =ᵐ[μ]
    (parabolicL2Section μ f).val at hae
  rw [he] at hae
  exact hae.symm

/-- Joint measurability of the Gaussian parabola Fourier integrand. -/
theorem parabolicGaussianSymbol_measurable : Measurable parabolicGaussianSymbol := by
  have hm : Measurable (fun p : (ℝ × ℝ) × ℝ => Complex.exp (-(p.2:ℂ)^2)*
      Complex.exp (-2*Real.pi*Complex.I*((p.1.1*p.2+p.1.2*p.2^2:ℝ):ℂ))) := by fun_prop
  exact hm.stronglyMeasurable.integral_prod_right.measurable

/-- Frequency measurability needed for the L2 multiplier operator. -/
theorem parabolicAnalyticMultiplier_measurable (z : ℂ) :
    Measurable (parabolicAnalyticMultiplier z) := by
  have hb : Measurable (fun ξ : ℝ × ℝ => parabolicGaussianCoefficient ξ.2) := by
    unfold parabolicGaussianCoefficient
    fun_prop
  have hp : Continuous (fun ξ : ℝ × ℝ => (parabolicGaussianCoefficient ξ.2)^(-z)) := by
    apply continuous_iff_continuousAt.mpr
    intro ξ
    have hc : ContinuousAt (fun η : ℝ × ℝ => parabolicGaussianCoefficient η.2) ξ := by
      unfold parabolicGaussianCoefficient
      fun_prop
    exact (continuousAt_cpow_const (show parabolicGaussianCoefficient ξ.2 ∈ Complex.slitPlane from
      Or.inl (by rw [parabolicGaussianCoefficient_re]; norm_num))).comp (f := fun η : ℝ × ℝ => parabolicGaussianCoefficient η.2) (x := ξ) hc
  exact ((measurable_const.mul hp.measurable).mul parabolicGaussianSymbol_measurable)

/-- Multiplication by a bounded measurable symbol preserves L2. -/
theorem parabolicL2_product_memLp {X : Type*} [MeasurableSpace X] (μ : Measure X)
    {m : X → ℂ} (hm : Measurable m) {C : ℝ} (hC : ∀ x, ‖m x‖ ≤ C)
    (f : Lp ℂ 2 μ) : MemLp (fun x => m x*f x) 2 μ := by
  apply (Lp.memLp f).of_le_mul (c := C) (hm.aestronglyMeasurable.mul (Lp.aestronglyMeasurable f))
  exact Filter.Eventually.of_forall (fun x => by rw [Pi.mul_apply,norm_mul]; exact mul_le_mul_of_nonneg_right (hC x) (norm_nonneg _))

/-- The bounded measurable multiplication operator on L2. -/
def parabolicL2Multiply {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (m : X → ℂ) (hm : Measurable m) (C : ℝ) (hC : ∀ x, ‖m x‖ ≤ C) :
    Lp ℂ 2 μ →ₗ[ℂ] Lp ℂ 2 μ where
  toFun f := (parabolicL2_product_memLp μ hm hC f).toLp (fun x => m x*f x)
  map_add' f g := by
    apply Lp.ext
    filter_upwards [(parabolicL2_product_memLp μ hm hC (f+g)).coeFn_toLp,
      (parabolicL2_product_memLp μ hm hC f).coeFn_toLp,
      (parabolicL2_product_memLp μ hm hC g).coeFn_toLp,
      Lp.coeFn_add f g,
      Lp.coeFn_add ((parabolicL2_product_memLp μ hm hC f).toLp _) ((parabolicL2_product_memLp μ hm hC g).toLp _)] with x hfg hf hg ha hb
    simp only [Pi.add_apply] at ha hb
    rw [hfg,hb,hf,hg,ha,mul_add]
  map_smul' c f := by
    apply Lp.ext
    filter_upwards [(parabolicL2_product_memLp μ hm hC (c • f)).coeFn_toLp,
      (parabolicL2_product_memLp μ hm hC f).coeFn_toLp,
      Lp.coeFn_smul c f,
      Lp.coeFn_smul c ((parabolicL2_product_memLp μ hm hC f).toLp _)] with x hcf hf ha hb
    simp only [RingHom.id_apply,Pi.smul_apply,smul_eq_mul] at ha hb ⊢
    rw [hcf,hb,hf,ha]
    ring

/-- Operator bound for multiplication by a bounded symbol. -/
theorem parabolicL2Multiply_norm_le {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (m : X → ℂ) (hm : Measurable m) (C : ℝ) (hC : ∀ x, ‖m x‖ ≤ C)
    (f : Lp ℂ 2 μ) : ‖parabolicL2Multiply μ m hm C hC f‖ ≤ C*‖f‖ := by
  apply Lp.norm_le_mul_norm_of_ae_le_mul
  filter_upwards [(parabolicL2_product_memLp μ hm hC f).coeFn_toLp] with x hx
  change ‖(parabolicL2_product_memLp μ hm hC f).toLp _ x‖ ≤ C*‖f x‖
  rw [hx,norm_mul]
  exact mul_le_mul_of_nonneg_right (hC x) (norm_nonneg _)

/-- Coordinate map used by the planar Fourier multiplier. -/
def parabolicPlaneEquiv : EuclideanSpace ℝ (Fin 2) ≃L[ℝ] (ℝ × ℝ) :=
  (PiLp.continuousLinearEquiv 2 ℝ (fun _ : Fin 2 => ℝ)).trans
    (ContinuousLinearEquiv.finTwoArrow ℝ ℝ)

/-- A fixed positive bound for the multiplier on the whole closed strip. -/
def parabolicMultiplierBound : ℝ := parabolicAnalyticMultiplier_uniform_bound.choose

theorem parabolicMultiplierBound_pos : 0 < parabolicMultiplierBound :=
  parabolicAnalyticMultiplier_uniform_bound.choose_spec.1

theorem parabolicMultiplierBound_spec {z : ℂ} (hz : z.re ∈ Set.Icc (-1/2:ℝ) 1)
    (ξ : ℝ × ℝ) : ‖parabolicAnalyticMultiplier z ξ‖ ≤ parabolicMultiplierBound :=
  parabolicAnalyticMultiplier_uniform_bound.choose_spec.2 z (by simpa only [neg_div] using hz) ξ

/-- The symbol extended by zero outside the interpolation strip. This
extension merely makes the operator family total; interpolation uses only the strip. -/
def parabolicStripSymbol (z : ℂ) (ξ : EuclideanSpace ℝ (Fin 2)) : ℂ :=
  if z.re ∈ Set.Icc (-1/2:ℝ) 1 then parabolicAnalyticMultiplier z (parabolicPlaneEquiv ξ) else 0

theorem parabolicStripSymbol_measurable (z : ℂ) : Measurable (parabolicStripSymbol z) := by
  classical
  unfold parabolicStripSymbol
  by_cases hz : z.re ∈ Set.Icc (-1/2:ℝ) 1
  · simpa only [parabolicStripSymbol,if_pos hz,Function.comp_def] using!
      (parabolicAnalyticMultiplier_measurable z).comp parabolicPlaneEquiv.continuous.measurable
  · simpa only [parabolicStripSymbol,if_neg hz] using (measurable_const : Measurable (fun _ : EuclideanSpace ℝ (Fin 2) => (0:ℂ)))

theorem parabolicStripSymbol_bound (z : ℂ) (ξ : EuclideanSpace ℝ (Fin 2)) :
    ‖parabolicStripSymbol z ξ‖ ≤ parabolicMultiplierBound := by
  classical
  by_cases hz : z.re ∈ Set.Icc (-1/2:ℝ) 1
  · simpa only [parabolicStripSymbol,if_pos hz] using parabolicMultiplierBound_spec hz (parabolicPlaneEquiv ξ)
  · simpa only [parabolicStripSymbol,if_neg hz,norm_zero] using parabolicMultiplierBound_pos.le

/-- The analytic parabola family on L2, defined by the verified multiplier. -/
def parabolicL2Family (z : ℂ) :
    Lp (α := EuclideanSpace ℝ (Fin 2)) ℂ 2 →ₗ[ℂ] Lp (α := EuclideanSpace ℝ (Fin 2)) ℂ 2 :=
  (Lp.fourierTransformₗᵢ (EuclideanSpace ℝ (Fin 2)) ℂ).symm.toLinearMap.comp
    ((parabolicL2Multiply volume (parabolicStripSymbol z) (parabolicStripSymbol_measurable z)
      parabolicMultiplierBound (parabolicStripSymbol_bound z)).comp
      (Lp.fourierTransformₗᵢ (EuclideanSpace ℝ (Fin 2)) ℂ).toLinearMap)

/-- Uniform L2 bound for the family, including the left interpolation boundary. -/
theorem parabolicL2Family_norm_le (z : ℂ) (f : Lp (α := EuclideanSpace ℝ (Fin 2)) ℂ 2) :
    ‖parabolicL2Family z f‖ ≤ parabolicMultiplierBound*‖f‖ := by
  change ‖(Lp.fourierTransformₗᵢ (EuclideanSpace ℝ (Fin 2)) ℂ).symm
    (parabolicL2Multiply volume (parabolicStripSymbol z) (parabolicStripSymbol_measurable z)
      parabolicMultiplierBound (parabolicStripSymbol_bound z) (𝓕 f))‖ ≤ _
  rw [LinearIsometryEquiv.norm_map]
  exact (parabolicL2Multiply_norm_le volume _ _ _ _ (𝓕 f)).trans_eq
    (by rw [Lp.norm_fourier_eq])

/-- Explicit parameter derivative of the multiplier, used for dominated
integration of the Fourier pairing. -/
def parabolicMultiplierDerivative (z : ℂ) (ξ : ℝ × ℝ) : ℂ :=
  (((2*z*Complex.exp (z^2))*Complex.Gamma (z+1)+Complex.exp (z^2)*deriv Complex.Gamma (z+1))*
    (parabolicGaussianCoefficient ξ.2)^(-z)+
    (Complex.exp (z^2)*Complex.Gamma (z+1))*
      ((parabolicGaussianCoefficient ξ.2)^(-z)*Complex.log (parabolicGaussianCoefficient ξ.2)*(-1)))*
    parabolicGaussianSymbol ξ

/-- Exact derivative formula for the analytic multiplier. -/
theorem parabolicAnalyticMultiplier_hasDerivAt {z : ℂ} (hz : -1 < z.re) (ξ : ℝ × ℝ) :
    HasDerivAt (fun w => parabolicAnalyticMultiplier w ξ) (parabolicMultiplierDerivative z ξ) z := by
  have havoid : ∀ n : ℕ, z+1 ≠ -(n:ℂ) := by
    intro n he
    have hre := congrArg Complex.re he
    simp only [Complex.add_re,Complex.one_re,Complex.neg_re,Complex.natCast_re] at hre
    have hn : (0:ℝ) ≤ n := Nat.cast_nonneg n
    linarith
  have hg := (Complex.differentiableAt_Gamma (z+1) havoid).hasDerivAt.comp z ((hasDerivAt_id z).add_const 1)
  have hp := (hasDerivAt_id z).neg.const_cpow (Or.inl (parabolicGaussianCoefficient_ne_zero ξ.2))
  have he := ((hasDerivAt_id z).pow 2).cexp
  have hh := ((he.mul hg).mul hp).mul_const (parabolicGaussianSymbol ξ)
  convert! hh using 1
  simp only [parabolicMultiplierDerivative,id_eq,Pi.neg_apply,Pi.pow_apply,Pi.mul_apply,Function.comp_def,mul_one]
  norm_num
  ring_nf
  simp

/-- Frequency measurability of the explicit parameter derivative. -/
theorem parabolicMultiplierDerivative_measurable (z : ℂ) :
    Measurable (parabolicMultiplierDerivative z) := by
  have hp : Continuous (fun ξ : ℝ × ℝ => (parabolicGaussianCoefficient ξ.2)^(-z)) := by
    apply continuous_iff_continuousAt.mpr
    intro ξ
    have hc : ContinuousAt (fun η : ℝ × ℝ => parabolicGaussianCoefficient η.2) ξ := by
      unfold parabolicGaussianCoefficient
      fun_prop
    exact (continuousAt_cpow_const (show parabolicGaussianCoefficient ξ.2 ∈ Complex.slitPlane from
      Or.inl (by rw [parabolicGaussianCoefficient_re]; norm_num))).comp (f := fun η : ℝ × ℝ => parabolicGaussianCoefficient η.2) (x := ξ) hc
  have hl : Continuous (fun ξ : ℝ × ℝ => Complex.log (parabolicGaussianCoefficient ξ.2)) := by
    apply continuous_iff_continuousAt.mpr
    intro ξ
    have hc : ContinuousAt (fun η : ℝ × ℝ => parabolicGaussianCoefficient η.2) ξ := by
      unfold parabolicGaussianCoefficient
      fun_prop
    exact (continuousAt_clog (show parabolicGaussianCoefficient ξ.2 ∈ Complex.slitPlane from
      Or.inl (by rw [parabolicGaussianCoefficient_re]; norm_num))).comp (f := fun η : ℝ × ℝ => parabolicGaussianCoefficient η.2) (x := ξ) hc
  exact ((measurable_const.mul hp.measurable).add
    (measurable_const.mul ((hp.measurable.mul hl.measurable).mul measurable_const))).mul
      parabolicGaussianSymbol_measurable

/-- A Cauchy estimate for the multiplier derivative on any disk contained
in the closed interpolation strip. -/
theorem parabolicMultiplierDerivative_bound {z : ℂ} {R : ℝ} (hR : 0 < R)
    (hball : ∀ w ∈ Metric.closedBall z R, w.re ∈ Set.Icc (-1/2:ℝ) 1)
    (ξ : ℝ × ℝ) : ‖parabolicMultiplierDerivative z ξ‖ ≤ parabolicMultiplierBound/R := by
  have hz := hball z (Metric.mem_closedBall_self hR.le)
  have hd : DifferentiableOn ℂ (fun w => parabolicAnalyticMultiplier w ξ) {w | -1 < w.re} :=
    fun w hw => (parabolicAnalyticMultiplier_differentiableAt hw ξ).differentiableWithinAt
  have hf : DiffContOnCl ℂ (fun w => parabolicAnalyticMultiplier w ξ) (Metric.ball z R) :=
    hd.diffContOnCl_ball (fun w hw => by have := (hball w hw).1; change -1 < w.re; linarith)
  rw [← (parabolicAnalyticMultiplier_hasDerivAt (by linarith [hz.1]) ξ).deriv]
  exact Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hR hf
    (fun w hw => parabolicMultiplierBound_spec (hball w (Metric.sphere_subset_closedBall hw)) ξ)

/-- Every interior strip point has a disk twice as large as the local
neighborhood on which one common Cauchy derivative bound will be used. -/
theorem parabolicStrip_interior_disk {z : ℂ} (hz : z.re ∈ Set.Ioo (-1/2:ℝ) 1) :
    ∃ R : ℝ, 0 < R ∧ ∀ w ∈ Metric.closedBall z (2*R), w.re ∈ Set.Icc (-1/2:ℝ) 1 := by
  let R := min (z.re+1/2) (1-z.re)/4
  have hR : 0 < R := by dsimp [R]; exact div_pos (lt_min (by linarith [hz.1]) (by linarith [hz.2])) (by norm_num)
  refine ⟨R,hR,?_⟩
  intro w hw
  have hn : |w.re-z.re| ≤ 2*R := by
    calc
      |w.re-z.re| = |(w-z).re| := by rw [Complex.sub_re]
      _ ≤ ‖w-z‖ := Complex.abs_re_le_norm _
      _ ≤ 2*R := by simpa only [Metric.mem_closedBall,dist_eq_norm] using hw
  have hleft : 4*R ≤ z.re+1/2 := by dsimp [R]; linarith [min_le_left (z.re+1/2) (1-z.re)]
  have hright : 4*R ≤ 1-z.re := by dsimp [R]; linarith [min_le_right (z.re+1/2) (1-z.re)]
  obtain ⟨hnl,hnr⟩ := abs_le.mp hn
  constructor <;> linarith

/-- Absolute integrability of multiplier pairings throughout the closed strip. -/
theorem parabolicMultiplierPairing_integrable {h : (ℝ × ℝ) → ℂ} (hh : Integrable h)
    {z : ℂ} (hz : z.re ∈ Set.Icc (-1/2:ℝ) 1) :
    Integrable (fun ξ => parabolicAnalyticMultiplier z ξ*h ξ) := by
  apply (hh.norm.const_mul parabolicMultiplierBound).mono'
    ((parabolicAnalyticMultiplier_measurable z).aestronglyMeasurable.mul hh.aestronglyMeasurable)
  filter_upwards [] with ξ
  rw [Pi.mul_apply,norm_mul]
  exact mul_le_mul_of_nonneg_right (parabolicMultiplierBound_spec hz ξ) (norm_nonneg _)

/-- Continuity of the Fourier pairing on the closed interpolation strip. -/
theorem parabolicMultiplierPairing_continuousOn {h : (ℝ × ℝ) → ℂ} (hh : Integrable h) :
    ContinuousOn (fun z : ℂ => ∫ ξ, parabolicAnalyticMultiplier z ξ*h ξ)
      {z | z.re ∈ Set.Icc (-1/2:ℝ) 1} := by
  apply continuousOn_of_dominated (bound := fun ξ => parabolicMultiplierBound*‖h ξ‖)
  · intro z hz
    exact (parabolicMultiplierPairing_integrable hh hz).aestronglyMeasurable
  · intro z hz
    exact Filter.Eventually.of_forall (fun ξ => by rw [norm_mul]; exact mul_le_mul_of_nonneg_right (parabolicMultiplierBound_spec hz ξ) (norm_nonneg _))
  · exact hh.norm.const_mul _
  · filter_upwards [] with ξ
    intro z hz
    exact ((parabolicAnalyticMultiplier_differentiableAt (by linarith [hz.1]) ξ).continuousAt.mul continuousAt_const).continuousWithinAt

/-- Holomorphy of the Fourier pairing in the open strip, with all
interchanges justified by the Cauchy derivative majorant. -/
theorem parabolicMultiplierPairing_differentiableAt {h : (ℝ × ℝ) → ℂ} (hh : Integrable h)
    {z : ℂ} (hz : z.re ∈ Set.Ioo (-1/2:ℝ) 1) :
    DifferentiableAt ℂ (fun w => ∫ ξ, parabolicAnalyticMultiplier w ξ*h ξ) z := by
  obtain ⟨R,hR,hball⟩ := parabolicStrip_interior_disk hz
  have hlocal {w : ℂ} (hw : w ∈ Metric.ball z R) : w.re ∈ Set.Icc (-1/2:ℝ) 1 :=
    hball w (by apply Metric.mem_closedBall.mpr; have := Metric.mem_ball.mp hw; linarith)
  have hderiv {w : ℂ} (hw : w ∈ Metric.ball z R) (ξ : ℝ × ℝ) :
      ‖parabolicMultiplierDerivative w ξ‖ ≤ parabolicMultiplierBound/R := by
    apply parabolicMultiplierDerivative_bound hR _ ξ
    intro v hv
    apply hball v
    apply Metric.mem_closedBall.mpr
    have hvw := Metric.mem_closedBall.mp hv
    have hwz := Metric.mem_ball.mp hw
    have ht := dist_triangle v w z
    linarith
  have hm (w : ℂ) : AEStronglyMeasurable (fun ξ => parabolicAnalyticMultiplier w ξ*h ξ) :=
    (parabolicAnalyticMultiplier_measurable w).aestronglyMeasurable.mul hh.aestronglyMeasurable
  have hdm : AEStronglyMeasurable (fun ξ => parabolicMultiplierDerivative z ξ*h ξ) :=
    (parabolicMultiplierDerivative_measurable z).aestronglyMeasurable.mul hh.aestronglyMeasurable
  have hresult := hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (F := fun w ξ => parabolicAnalyticMultiplier w ξ*h ξ)
    (F' := fun w ξ => parabolicMultiplierDerivative w ξ*h ξ)
    (Metric.ball_mem_nhds z hR) (Filter.Eventually.of_forall hm)
    (parabolicMultiplierPairing_integrable hh ⟨hz.1.le,hz.2.le⟩) hdm
    (bound := fun ξ => (parabolicMultiplierBound/R)*‖h ξ‖)
    (Filter.Eventually.of_forall (fun ξ w hw => by
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_right (hderiv hw ξ) (norm_nonneg _)))
    (hh.norm.const_mul _) (Filter.Eventually.of_forall (fun ξ w hw =>
      (parabolicAnalyticMultiplier_hasDerivAt (by have := (hlocal hw).1; linarith) ξ).mul_const (h ξ)))
  exact hresult.2.differentiableAt

/-- The planar coordinate equivalence preserves Lebesgue volume. -/
theorem parabolicPlaneEquiv_measurePreserving :
    MeasurePreserving parabolicPlaneEquiv.toHomeomorph.toMeasurableEquiv := by
  exact (volume_preserving_finTwoArrow ℝ).comp (PiLp.volume_preserving_ofLp (Fin 2))

/-- The Fourier transform of the L2 family is multiplication by its symbol. -/
theorem parabolicL2Family_fourier_ae (z : ℂ) (f : Lp (α := EuclideanSpace ℝ (Fin 2)) ℂ 2) :
    (fun ξ => (𝓕 (parabolicL2Family z f)) ξ) =ᵐ[volume]
      (fun ξ : EuclideanSpace ℝ (Fin 2) => parabolicStripSymbol z ξ*(𝓕 f : Lp (α := EuclideanSpace ℝ (Fin 2)) ℂ 2) ξ) := by
  have he : 𝓕 (parabolicL2Family z f) =
      parabolicL2Multiply volume (parabolicStripSymbol z) (parabolicStripSymbol_measurable z)
        parabolicMultiplierBound (parabolicStripSymbol_bound z) (𝓕 f) := by
    exact (Lp.fourierTransformₗᵢ (EuclideanSpace ℝ (Fin 2)) ℂ).apply_symm_apply _
  rw [he]
  exact (parabolicL2_product_memLp volume (parabolicStripSymbol_measurable z) (parabolicStripSymbol_bound z) (𝓕 f)).coeFn_toLp

/-- The fixed product of two L2 Fourier transforms, in pair coordinates. -/
def parabolicFourierPair (f g : Lp (α := EuclideanSpace ℝ (Fin 2)) ℂ 2) (ξ : ℝ × ℝ) : ℂ :=
  star ((𝓕 g) (parabolicPlaneEquiv.symm ξ))*(𝓕 f) (parabolicPlaneEquiv.symm ξ)

theorem parabolicFourierPair_integrable (f g : Lp (α := EuclideanSpace ℝ (Fin 2)) ℂ 2) :
    Integrable (parabolicFourierPair f g) := by
  have hh := ((Lp.memLp (𝓕 g)).star).integrable_mul (Lp.memLp (𝓕 f))
  exact parabolicPlaneEquiv_measurePreserving.symm.integrable_comp_of_integrable hh

/-- Plancherel identifies the operator pairing with the analytic Fourier
integral already controlled above. -/
theorem parabolicL2Family_inner {z : ℂ} (hz : z.re ∈ Set.Icc (-1/2:ℝ) 1)
    (f g : Lp (α := EuclideanSpace ℝ (Fin 2)) ℂ 2) :
    inner ℂ g (parabolicL2Family z f) =
      ∫ ξ : ℝ × ℝ, parabolicAnalyticMultiplier z ξ*parabolicFourierPair f g ξ := by
  rw [← Lp.inner_fourier_eq g (parabolicL2Family z f),L2.inner_def]
  have he : (∫ ξ : EuclideanSpace ℝ (Fin 2), inner ℂ ((𝓕 g) ξ) ((𝓕 (parabolicL2Family z f)) ξ)) =
      ∫ ξ : EuclideanSpace ℝ (Fin 2), parabolicAnalyticMultiplier z (parabolicPlaneEquiv ξ)*
        (star ((𝓕 g) ξ)*(𝓕 f) ξ) := by
    apply integral_congr_ae
    filter_upwards [parabolicL2Family_fourier_ae z f] with ξ hξ
    rw [hξ]
    simp only [parabolicStripSymbol,if_pos hz,RCLike.inner_apply,starRingEnd_apply]
    ring
  rw [he]
  have hc := parabolicPlaneEquiv_measurePreserving.integral_comp
    parabolicPlaneEquiv.toHomeomorph.toMeasurableEquiv.measurableEmbedding
    (fun ξ => parabolicAnalyticMultiplier z ξ*parabolicFourierPair f g ξ)
  change (∫ ξ : EuclideanSpace ℝ (Fin 2), parabolicAnalyticMultiplier z (parabolicPlaneEquiv ξ)*parabolicFourierPair f g (parabolicPlaneEquiv ξ)) =
    (∫ ξ : ℝ × ℝ, parabolicAnalyticMultiplier z ξ*parabolicFourierPair f g ξ) at hc
  simpa only [parabolicFourierPair,ContinuousLinearEquiv.symm_apply_apply] using! hc

/-- The actual L2 operator pairings satisfy the analytic strip condition. -/
theorem parabolicL2Family_inner_analytic (f g : Lp (α := EuclideanSpace ℝ (Fin 2)) ℂ 2) :
    DiffContOnCl ℂ (fun z => inner ℂ g (parabolicL2Family z f))
      {z | z.re ∈ Set.Ioo (-1/2:ℝ) 1} := by
  have hh := parabolicFourierPair_integrable f g
  have hc : closure {z : ℂ | z.re ∈ Set.Ioo (-1/2:ℝ) 1} ⊆
      {z : ℂ | z.re ∈ Set.Icc (-1/2:ℝ) 1} :=
    closure_minimal (fun z hz => ⟨hz.1.le,hz.2.le⟩) (isClosed_Icc.preimage Complex.continuous_re)
  constructor
  · have hd : DifferentiableOn ℂ (fun z => ∫ ξ, parabolicAnalyticMultiplier z ξ*parabolicFourierPair f g ξ)
        {z : ℂ | z.re ∈ Set.Ioo (-1/2:ℝ) 1} :=
      fun z hz => (parabolicMultiplierPairing_differentiableAt hh hz).differentiableWithinAt
    exact hd.congr (fun z hz => parabolicL2Family_inner ⟨hz.1.le,hz.2.le⟩ f g)
  · exact ((parabolicMultiplierPairing_continuousOn hh).mono hc).congr
      (fun z hz => parabolicL2Family_inner (hc hz) f g)

/-- Affine change from Stein's unit strip to the parabolic family strip. -/
def parabolicInterpolationParameter (w : ℂ) : ℂ := (3*w-1)/2

theorem parabolicInterpolationParameter_re (w : ℂ) :
    (parabolicInterpolationParameter w).re = (3*w.re-1)/2 := by
  simp [parabolicInterpolationParameter,Complex.mul_re]

/-- Analyticity on the unit strip in precisely the convention of Stein interpolation. -/
theorem parabolicL2Family_stein_analytic (f g : Lp (α := EuclideanSpace ℝ (Fin 2)) ℂ 2) :
    DiffContOnCl ℂ (fun w => inner ℂ g (parabolicL2Family (parabolicInterpolationParameter w) f))
      (Complex.HadamardThreeLines.verticalStrip 0 1) := by
  apply (parabolicL2Family_inner_analytic f g).comp
    (show DiffContOnCl ℂ parabolicInterpolationParameter (Complex.HadamardThreeLines.verticalStrip 0 1) from
      (show Differentiable ℂ parabolicInterpolationParameter by unfold parabolicInterpolationParameter; fun_prop).diffContOnCl)
  intro w hw
  change (parabolicInterpolationParameter w).re ∈ Set.Ioo (-1/2:ℝ) 1
  change w.re ∈ Set.Ioo (0:ℝ) 1 at hw
  rw [parabolicInterpolationParameter_re]
  constructor <;> linarith [hw.1,hw.2]

/-- Integrable simple functions lie in L2. -/
theorem parabolicSimple_memLp {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (f : SimpleFunc X ℂ) (hf : Integrable f μ) : MemLp (f : X → ℂ) 2 μ :=
  f.memLp_of_finite_measure_preimage 2 (SimpleFunc.integrable_iff.mp hf)

/-- Inclusion of the integrable simple-function core into L2, extended
by zero off that core so the interpolation family is a total function. -/
def parabolicSimpleToL2 {X : Type*} [MeasurableSpace X] (μ : Measure X) (f : SimpleFunc X ℂ) : Lp ℂ 2 μ := by
  classical
  exact if hf : Integrable f μ then (parabolicSimple_memLp f hf).toLp f else 0

theorem parabolicSimpleToL2_add {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (f g : SimpleFunc X ℂ) (hf : Integrable f μ) (hg : Integrable g μ) :
    parabolicSimpleToL2 μ (f+g) = parabolicSimpleToL2 μ f+parabolicSimpleToL2 μ g := by
  have hfg : Integrable (f+g : SimpleFunc X ℂ) μ := hf.add hg
  simp only [parabolicSimpleToL2,dif_pos hf,dif_pos hg,dif_pos hfg]
  exact MemLp.toLp_add (parabolicSimple_memLp f hf) (parabolicSimple_memLp g hg)

theorem parabolicSimpleToL2_smul {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (c : ℂ) (f : SimpleFunc X ℂ) (hf : Integrable f μ) :
    parabolicSimpleToL2 μ (c • f) = c • parabolicSimpleToL2 μ f := by
  have hcf : Integrable (c • f : SimpleFunc X ℂ) μ := hf.smul c
  simp only [parabolicSimpleToL2,dif_pos hf,dif_pos hcf]
  exact MemLp.toLp_const_smul c (parabolicSimple_memLp f hf)

/-- The simple-function operator family in the exact form required by
Stein interpolation, using pointwise-linear measurable representatives. -/
def parabolicSteinFamily (w : ℂ) (f : SimpleFunc (EuclideanSpace ℝ (Fin 2)) ℂ) :
    EuclideanSpace ℝ (Fin 2) → ℂ :=
  (parabolicL2Section volume (parabolicL2Family (parabolicInterpolationParameter w)
    (parabolicSimpleToL2 volume f))).val

theorem parabolicSteinFamily_measurable (w : ℂ) (f : SimpleFunc (EuclideanSpace ℝ (Fin 2)) ℂ) :
    Measurable (parabolicSteinFamily w f) :=
  (parabolicL2Section volume (parabolicL2Family (parabolicInterpolationParameter w)
    (parabolicSimpleToL2 volume f))).property.1

theorem parabolicSteinFamily_add (w : ℂ) (f g : SimpleFunc (EuclideanSpace ℝ (Fin 2)) ℂ)
    (hf : Integrable f) (hg : Integrable g) :
    parabolicSteinFamily w (f+g) = parabolicSteinFamily w f+parabolicSteinFamily w g := by
  unfold parabolicSteinFamily
  rw [parabolicSimpleToL2_add volume f g hf hg,map_add,map_add]
  rfl

theorem parabolicSteinFamily_smul (w c : ℂ) (f : SimpleFunc (EuclideanSpace ℝ (Fin 2)) ℂ)
    (hf : Integrable f) : parabolicSteinFamily w (c • f) = c • parabolicSteinFamily w f := by
  unfold parabolicSteinFamily
  rw [parabolicSimpleToL2_smul volume c f hf,map_smul,map_smul]
  rfl

theorem parabolicSimpleToL2_ae {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (f : SimpleFunc X ℂ) (hf : Integrable f μ) :
    (parabolicSimpleToL2 μ f : X → ℂ) =ᵐ[μ] f := by
  simp only [parabolicSimpleToL2,dif_pos hf]
  exact (parabolicSimple_memLp f hf).coeFn_toLp

theorem parabolicSteinFamily_ae (w : ℂ) (f : SimpleFunc (EuclideanSpace ℝ (Fin 2)) ℂ) :
    parabolicSteinFamily w f =ᵐ[volume]
      parabolicL2Family (parabolicInterpolationParameter w) (parabolicSimpleToL2 volume f) :=
  parabolicL2Section_ae volume _

theorem parabolicSteinFamily_memLp (w : ℂ) (f : SimpleFunc (EuclideanSpace ℝ (Fin 2)) ℂ) :
    MemLp (parabolicSteinFamily w f) 2 volume :=
  (parabolicL2Section volume (parabolicL2Family (parabolicInterpolationParameter w)
    (parabolicSimpleToL2 volume f))).property.2

/-- Pairings against integrable simple functions are absolutely integrable. -/
theorem parabolicSteinFamily_pair_integrable (w : ℂ)
    (f g : SimpleFunc (EuclideanSpace ℝ (Fin 2)) ℂ) (hg : Integrable g) :
    Integrable (fun x => parabolicSteinFamily w f x*g x) :=
  (parabolicSteinFamily_memLp w f).integrable_mul (parabolicSimple_memLp g hg)

/-- The simple-function pairing is the L2 pairing against the conjugate test function. -/
theorem parabolicSteinFamily_pair_inner (w : ℂ)
    (f g : SimpleFunc (EuclideanSpace ℝ (Fin 2)) ℂ) (hg : Integrable g) :
    (∫ x, parabolicSteinFamily w f x*g x) =
      inner ℂ (parabolicSimpleToL2 volume (star g))
        (parabolicL2Family (parabolicInterpolationParameter w) (parabolicSimpleToL2 volume f)) := by
  rw [L2.inner_def]
  apply integral_congr_ae
  have hgs : Integrable (star g : SimpleFunc (EuclideanSpace ℝ (Fin 2)) ℂ) :=
    memLp_one_iff_integrable.mp ((memLp_one_iff_integrable.mpr hg).star)
  filter_upwards [parabolicSteinFamily_ae w f,parabolicSimpleToL2_ae volume (star g) hgs] with x hx hgx
  rw [hx,hgx]
  simp only [RCLike.inner_apply,starRingEnd_apply,SimpleFunc.coe_star,Pi.star_apply,star_star]

/-- The simple-function family satisfies the analytic pairing hypothesis of Stein's theorem. -/
theorem parabolicSteinFamily_pair_analytic
    (f g : SimpleFunc (EuclideanSpace ℝ (Fin 2)) ℂ) (hg : Integrable g) :
    DiffContOnCl ℂ (fun w => ∫ x, parabolicSteinFamily w f x*g x)
      (Complex.HadamardThreeLines.verticalStrip 0 1) := by
  have he : (fun w => ∫ x, parabolicSteinFamily w f x*g x) =
      (fun w => inner ℂ (parabolicSimpleToL2 volume (star g))
        (parabolicL2Family (parabolicInterpolationParameter w) (parabolicSimpleToL2 volume f))) :=
    funext (fun w => parabolicSteinFamily_pair_inner w f g hg)
  rw [he]
  exact parabolicL2Family_stein_analytic _ _

/-- Uniform L2 estimate in eLpNorm form for the Stein family. -/
theorem parabolicSteinFamily_L2_bound (w : ℂ)
    (f : SimpleFunc (EuclideanSpace ℝ (Fin 2)) ℂ) (hf : Integrable f) :
    eLpNorm (parabolicSteinFamily w f) 2 volume ≤
      ENNReal.ofReal parabolicMultiplierBound*eLpNorm (f : EuclideanSpace ℝ (Fin 2) → ℂ) 2 volume := by
  rw [eLpNorm_congr_ae (parabolicSteinFamily_ae w f),← Lp.enorm_def]
  have he : eLpNorm (f : EuclideanSpace ℝ (Fin 2) → ℂ) 2 volume = ‖parabolicSimpleToL2 volume f‖ₑ := by
    simp only [parabolicSimpleToL2,dif_pos hf,Lp.enorm_toLp]
  rw [he]
  simpa only [← ofReal_norm,← ENNReal.ofReal_mul parabolicMultiplierBound_pos.le] using
    ENNReal.ofReal_le_ofReal (parabolicL2Family_norm_le (parabolicInterpolationParameter w) (parabolicSimpleToL2 volume f))

/-- Coordinate form of the Euclidean Fourier character. -/
theorem parabolicFourierCharacter_euclidean (ξ x : EuclideanSpace ℝ (Fin 2)) :
    (Real.fourierChar (-inner ℝ x ξ) : ℂ) =
      parabolicFourierCharacter (parabolicPlaneEquiv ξ) (parabolicPlaneEquiv x) := by
  have hi : inner ℝ x ξ = (parabolicPlaneEquiv ξ).1*(parabolicPlaneEquiv x).1+
      (parabolicPlaneEquiv ξ).2*(parabolicPlaneEquiv x).2 := by
    simp only [PiLp.inner_apply,Fin.sum_univ_two,RCLike.inner_apply,conj_trivial]
    rfl
  rw [hi,Real.fourierChar_apply,parabolicFourierCharacter]
  congr 1
  push_cast
  ring

/-- The analytic kernel transported to Euclidean Fourier coordinates. -/
def parabolicEuclideanKernel (z : ℂ) (x : EuclideanSpace ℝ (Fin 2)) : ℂ :=
  parabolicAnalyticKernel z (parabolicPlaneEquiv x)

theorem parabolicEuclideanKernel_integrable {z : ℂ} (hz : 0 < z.re) :
    Integrable (parabolicEuclideanKernel z) :=
  parabolicPlaneEquiv_measurePreserving.integrable_comp_of_integrable (parabolicAnalyticKernel_integrable hz)

/-- The verified coordinate Fourier identity agrees with Mathlib's Euclidean Fourier transform. -/
theorem parabolicEuclideanKernel_fourier {z : ℂ} (hz : 0 < z.re)
    (ξ : EuclideanSpace ℝ (Fin 2)) :
    (𝓕 (parabolicEuclideanKernel z)) ξ = parabolicAnalyticMultiplier z (parabolicPlaneEquiv ξ) := by
  rw [Real.fourier_eq,← parabolicAnalyticKernel_fourier hz (parabolicPlaneEquiv ξ),
    ← parabolicPlaneEquiv_measurePreserving.integral_comp'
      (fun p => parabolicAnalyticKernel z p*parabolicFourierCharacter (parabolicPlaneEquiv ξ) p)]
  apply integral_congr_ae
  filter_upwards [] with x
  change Real.fourierChar (-inner ℝ x ξ) • parabolicEuclideanKernel z x = _
  rw [Circle.smul_def,smul_eq_mul,parabolicFourierCharacter_euclidean]
  exact mul_comm _ _

/-- Kernel convolution on the right boundary. -/
def parabolicKernelConvolution (z : ℂ) (f : EuclideanSpace ℝ (Fin 2) → ℂ) :
    EuclideanSpace ℝ (Fin 2) → ℂ :=
  MeasureTheory.convolution f (parabolicEuclideanKernel z) (ContinuousLinearMap.mul ℂ ℂ) volume

/-- Pointwise L1 to L-infinity bound supplied by the bounded analytic kernel. -/
theorem parabolicKernelConvolution_bound {z : ℂ} (hz : z.re = 1)
    {f : EuclideanSpace ℝ (Fin 2) → ℂ} (hf : Integrable f) (x : EuclideanSpace ℝ (Fin 2)) :
    ‖parabolicKernelConvolution z f x‖ ≤ (2*Real.exp 1)*(∫ y, ‖f y‖) := by
  change ‖∫ y, f y*parabolicEuclideanKernel z (x-y)‖ ≤ _
  have hh := norm_integral_le_of_norm_le (hf.norm.const_mul (2*Real.exp 1))
    (Filter.Eventually.of_forall (fun y => show ‖f y*parabolicEuclideanKernel z (x-y)‖ ≤
      (2*Real.exp 1)*‖f y‖ by
      rw [norm_mul,mul_comm]
      exact mul_le_mul_of_nonneg_right (parabolicAnalyticKernel_boundary_bound hz _) (norm_nonneg _)))
  simpa only [integral_const_mul] using hh

/-- Absolute integrability of the boundary convolution. -/
theorem parabolicKernelConvolution_integrable {z : ℂ} (hz : 0 < z.re)
    {f : EuclideanSpace ℝ (Fin 2) → ℂ} (hf : Integrable f) :
    Integrable (parabolicKernelConvolution z f) :=
  hf.integrable_convolution (L := ContinuousLinearMap.mul ℂ ℂ) (parabolicEuclideanKernel_integrable hz)

/-- The right-boundary convolution belongs to L2 because it is both
integrable and bounded. -/
theorem parabolicKernelConvolution_memLp {z : ℂ} (hz : z.re = 1)
    {f : EuclideanSpace ℝ (Fin 2) → ℂ} (hf : Integrable f) :
    MemLp (parabolicKernelConvolution z f) 2 volume := by
  have hi := parabolicKernelConvolution_integrable (by rw [hz]; norm_num) hf
  apply (integrable_norm_rpow_iff hi.aestronglyMeasurable (by norm_num : (2:ENNReal) ≠ 0)
    (by norm_num : (2:ENNReal) ≠ ⊤)).mp
  simp only [ENNReal.toReal_ofNat,Real.rpow_two]
  apply (hi.norm.const_mul ((2*Real.exp 1)*(∫ y, ‖f y‖))).mono'
    (hi.aestronglyMeasurable.norm.pow 2)
  filter_upwards [] with x
  rw [Real.norm_eq_abs,abs_of_nonneg (sq_nonneg _),pow_two]
  exact mul_le_mul_of_nonneg_right (parabolicKernelConvolution_bound hz hf x) (norm_nonneg _)

/-- The L2 family equals convolution by the analytic kernel on the right
boundary, by L1/L2 Fourier compatibility and injectivity of Plancherel. -/
theorem parabolicL2Family_kernel_eq {z : ℂ} (hz : z.re = 1)
    {f : EuclideanSpace ℝ (Fin 2) → ℂ} (hf : Integrable f) (hf2 : MemLp f 2 volume) :
    parabolicL2Family z (hf2.toLp f) =
      (parabolicKernelConvolution_memLp hz hf).toLp (parabolicKernelConvolution z f) := by
  have hzpos : 0 < z.re := by rw [hz]; norm_num
  have hzstrip : z.re ∈ Set.Icc (-1/2:ℝ) 1 := by rw [hz]; norm_num
  apply (Lp.fourierTransformₗᵢ (EuclideanSpace ℝ (Fin 2)) ℂ).injective
  apply Lp.ext
  filter_upwards [parabolicL2Family_fourier_ae z (hf2.toLp f),
    smoothing_fourier_toLp_ae_eq hf hf2,
    smoothing_fourier_toLp_ae_eq (parabolicKernelConvolution_integrable hzpos hf)
      (parabolicKernelConvolution_memLp hz hf)] with ξ hT hfξ hK
  change (𝓕 (parabolicL2Family z (hf2.toLp f))) ξ =
    (𝓕 ((parabolicKernelConvolution_memLp hz hf).toLp (parabolicKernelConvolution z f))) ξ
  rw [hT,hfξ,hK]
  rw [parabolicKernelConvolution,Real.fourier_mul_convolution_eq hf (parabolicEuclideanKernel_integrable hzpos),
    parabolicEuclideanKernel_fourier hzpos,parabolicStripSymbol,if_pos hzstrip,mul_comm]

/-- The right boundary of the simple-function family has the required
L1 to L-infinity bound. -/
theorem parabolicSteinFamily_right_bound (t : ℝ)
    (f : SimpleFunc (EuclideanSpace ℝ (Fin 2)) ℂ) (hf : Integrable f) :
    eLpNorm (parabolicSteinFamily (1+(t:ℂ)*Complex.I) f) ⊤ volume ≤
      ENNReal.ofReal (2*Real.exp 1)*eLpNorm (f : EuclideanSpace ℝ (Fin 2) → ℂ) 1 volume := by
  let z := parabolicInterpolationParameter (1+(t:ℂ)*Complex.I)
  have hz : z.re = 1 := by dsimp [z]; rw [parabolicInterpolationParameter_re]; norm_num
  have hconv : parabolicSteinFamily (1+(t:ℂ)*Complex.I) f =ᵐ[volume] parabolicKernelConvolution z f := by
    have ha := parabolicSteinFamily_ae (1+(t:ℂ)*Complex.I) f
    change parabolicSteinFamily (1+(t:ℂ)*Complex.I) f =ᵐ[volume] parabolicL2Family z (parabolicSimpleToL2 volume f) at ha
    rw [parabolicSimpleToL2,dif_pos hf,parabolicL2Family_kernel_eq hz hf (parabolicSimple_memLp f hf)] at ha
    exact ha.trans (parabolicKernelConvolution_memLp hz hf).coeFn_toLp
  have hb : ∀ᵐ x, ‖parabolicSteinFamily (1+(t:ℂ)*Complex.I) f x‖ ≤
      (2*Real.exp 1)*(∫ y, ‖f y‖) := hconv.mono (fun x hx => by rw [hx]; exact parabolicKernelConvolution_bound hz hf x)
  have he := eLpNormEssSup_le_of_ae_bound hb
  rw [ENNReal.ofReal_mul (by positivity : 0 ≤ 2*Real.exp 1),ofReal_integral_norm_eq_lintegral_enorm hf,
    ← eLpNorm_one_eq_lintegral_enorm] at he
  exact he

/-- The uniform L2 bound supplies the sub-double-exponential pairing
growth required by Stein interpolation. -/
theorem parabolicSteinFamily_growth :
    ∃ a : ℝ, a < Real.pi ∧
      ∀ (f g : SimpleFunc (EuclideanSpace ℝ (Fin 2)) ℂ), Integrable f → Integrable g →
        ∃ C : ℝ, ∀ w : Complex.HadamardThreeLines.verticalClosedStrip 0 1,
          ‖∫ x, parabolicSteinFamily w f x*g x‖ ≤ Real.exp (C*Real.exp (a*|(w:ℂ).im|)) := by
  refine ⟨0,Real.pi_pos,?_⟩
  intro f g hf hg
  let C := ‖parabolicSimpleToL2 volume (star g)‖*(parabolicMultiplierBound*‖parabolicSimpleToL2 volume f‖)
  refine ⟨C,?_⟩
  intro w
  simp only [zero_mul,Real.exp_zero,mul_one]
  rw [parabolicSteinFamily_pair_inner w f g hg]
  calc
    _ ≤ ‖parabolicSimpleToL2 volume (star g)‖*
        ‖parabolicL2Family (parabolicInterpolationParameter w) (parabolicSimpleToL2 volume f)‖ := norm_inner_le_norm _ _
    _ ≤ C := mul_le_mul_of_nonneg_left (parabolicL2Family_norm_le _ _) (norm_nonneg _)
    _ ≤ Real.exp C := (le_add_of_nonneg_right zero_le_one).trans (Real.add_one_le_exp C)

/-- Interpolation constant for Gaussian parabolic averaging. -/
def parabolicAveragingBound : ℝ :=
  parabolicMultiplierBound^(1-(1/3:ℝ))*(2*Real.exp 1)^(1/3:ℝ)

theorem parabolicAveragingBound_pos : 0 < parabolicAveragingBound := by
  unfold parabolicAveragingBound
  exact mul_pos (Real.rpow_pos_of_pos parabolicMultiplierBound_pos _)
    (Real.rpow_pos_of_pos (by positivity) _)

/-- Stein interpolation gives the exact L^(3/2) to L^3 estimate on the
integrable simple-function core at parameter z=0 of the parabolic family. -/
theorem parabolicStein_simple_bound
    (f : SimpleFunc (EuclideanSpace ℝ (Fin 2)) ℂ) (hf : Integrable f) :
    MemLp (parabolicSteinFamily (1/3:ℂ) f) 3 volume ∧
      eLpNorm (parabolicSteinFamily (1/3:ℂ) f) 3 volume ≤
        ENNReal.ofReal parabolicAveragingBound*
          eLpNorm (f : EuclideanSpace ℝ (Fin 2) → ℂ) (3/2) volume := by
  have hh := SteinInterpolation.stein_interpolation_constant_bounds
    (μ := (volume : Measure (EuclideanSpace ℝ (Fin 2))))
    (ν := (volume : Measure (EuclideanSpace ℝ (Fin 2))))
    (p₀ := 2) (p₁ := 1) (p := 3/2) (q₀ := 2) (q₁ := ⊤) (q := 3)
    (θ := 1/3) (M₀ := parabolicMultiplierBound) (M₁ := 2*Real.exp 1)
    parabolicSteinFamily (by norm_num) le_rfl (by norm_num) le_top
    (by norm_num)
    (by norm_num [ENNReal.ofReal_div_of_pos (by norm_num : (0:ℝ) < 3),ENNReal.inv_div]; apply (ENNReal.toReal_eq_toReal_iff' (by finiteness) (by finiteness)).mp; rw [ENNReal.toReal_add (by finiteness) (by finiteness)]; norm_num [ENNReal.toReal_mul,ENNReal.toReal_div,ENNReal.toReal_inv])
    (by norm_num [ENNReal.ofReal_div_of_pos (by norm_num : (0:ℝ) < 3)]; apply (ENNReal.toReal_eq_toReal_iff' (by finiteness) (by finiteness)).mp; norm_num [ENNReal.toReal_mul,ENNReal.toReal_div,ENNReal.toReal_inv])
    (fun w f g hf hg => parabolicSteinFamily_add w f g hf hg)
    (fun w c f hf => parabolicSteinFamily_smul w c f hf)
    (fun w f hf => parabolicSteinFamily_measurable w f)
    (fun w f g hf hg => parabolicSteinFamily_pair_integrable w f g hg)
    (fun f g hf hg => parabolicSteinFamily_pair_analytic f g hg)
    parabolicSteinFamily_growth parabolicMultiplierBound_pos (by positivity)
    (fun t f hf => parabolicSteinFamily_L2_bound ((t:ℂ)*Complex.I) f hf)
    parabolicSteinFamily_right_bound f hf
  simpa only [Complex.ofReal_div,Complex.ofReal_one,Complex.ofReal_ofNat,parabolicAveragingBound] using! hh

/-- The parabola in Euclidean coordinates. -/
def parabolicCurve (t : ℝ) : EuclideanSpace ℝ (Fin 2) := parabolicPlaneEquiv.symm (t,t^2)

/-- Gaussian weight used to dominate compact time cutoffs. -/
def parabolicGaussianWeight (t : ℝ) : ℂ := Complex.exp (-(t:ℂ)^2)

theorem parabolicGaussianWeight_integrable : Integrable parabolicGaussianWeight := by
  unfold parabolicGaussianWeight
  simpa only [parabolicGaussianWeight,neg_one_mul] using
    (integrable_cexp_neg_mul_sq (b := (1:ℂ)) (by norm_num))

theorem parabolicGaussianWeight_norm (t : ℝ) : ‖parabolicGaussianWeight t‖ = Real.exp (-t^2) := by
  rw [parabolicGaussianWeight,Complex.norm_exp]
  simp only [Complex.neg_re,← Complex.ofReal_pow,Complex.ofReal_re]

/-- The actual Gaussian parabola averaging operator. -/
def parabolicGaussianAverage (f : EuclideanSpace ℝ (Fin 2) → ℂ) (x : EuclideanSpace ℝ (Fin 2)) : ℂ :=
  ∫ t : ℝ, parabolicGaussianWeight t*f (x-parabolicCurve t)

/-- Fiberwise translation along the parabola preserves product volume. -/
theorem parabolicCurveTranslation_measurePreserving :
    MeasurePreserving (fun p : ℝ × EuclideanSpace ℝ (Fin 2) => (p.1,p.2-parabolicCurve p.1)) volume volume := by
  change MeasurePreserving _ (volume.prod volume) (volume.prod volume)
  apply (MeasurePreserving.id volume).skew_product (g := fun t x => x-parabolicCurve t)
  · unfold parabolicCurve
    fun_prop
  · exact Filter.Eventually.of_forall (fun t => by
      simpa only [sub_eq_add_neg] using (measurePreserving_add_right volume (-parabolicCurve t)).map_eq)

/-- Absolute integrability of the joint averaging integrand. -/
theorem parabolicGaussianAverage_integrand_integrable
    {f : EuclideanSpace ℝ (Fin 2) → ℂ} (hf : Integrable f) :
    Integrable (fun p : ℝ × EuclideanSpace ℝ (Fin 2) =>
      parabolicGaussianWeight p.1*f (p.2-parabolicCurve p.1)) :=
  parabolicCurveTranslation_measurePreserving.integrable_comp_of_integrable
    (parabolicGaussianWeight_integrable.mul_prod hf)

/-- Gaussian parabola averaging preserves integrability. -/
theorem parabolicGaussianAverage_integrable
    {f : EuclideanSpace ℝ (Fin 2) → ℂ} (hf : Integrable f) :
    Integrable (parabolicGaussianAverage f) :=
  (parabolicGaussianAverage_integrand_integrable hf).integral_prod_right

/-- The Gaussian parabola average of a bounded function is bounded. -/
theorem parabolicGaussianAverage_bound
    {f : EuclideanSpace ℝ (Fin 2) → ℂ} {B : ℝ} (hf : ∀ x, ‖f x‖ ≤ B)
    (x : EuclideanSpace ℝ (Fin 2)) :
    ‖parabolicGaussianAverage f x‖ ≤ (∫ t : ℝ, ‖parabolicGaussianWeight t‖)*B := by
  apply (norm_integral_le_of_norm_le (parabolicGaussianWeight_integrable.norm.mul_const B)
    (Filter.Eventually.of_forall (fun t => by
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_left (hf _) (norm_nonneg _)))).trans_eq
  exact integral_mul_const B _

/-- Translation by a parabola point has the expected Fourier character. -/
theorem parabolicCurve_fourier_translation (f : EuclideanSpace ℝ (Fin 2) → ℂ) (t : ℝ)
    (ξ : EuclideanSpace ℝ (Fin 2)) :
    (𝓕 (fun x => f (x-parabolicCurve t))) ξ =
      (Real.fourierChar (-inner ℝ (parabolicCurve t) ξ) : ℂ)*(𝓕 f) ξ := by
  have hh := congrFun (VectorFourier.fourierIntegral_comp_add_right Real.fourierChar volume
    (innerₗ (EuclideanSpace ℝ (Fin 2))) f (-parabolicCurve t)) ξ
  change (𝓕 (f ∘ (fun x => x+(-parabolicCurve t)))) ξ =
    Real.fourierChar (inner ℝ (-parabolicCurve t) ξ) • (𝓕 f) ξ at hh
  simpa only [Function.comp_def,← sub_eq_add_neg,inner_neg_left,Circle.smul_def,smul_eq_mul] using! hh

/-- The actual Gaussian parabola average has the Gaussian parabola multiplier. -/
theorem parabolicGaussianAverage_fourier
    {f : EuclideanSpace ℝ (Fin 2) → ℂ} (hf : Integrable f)
    (ξ : EuclideanSpace ℝ (Fin 2)) :
    (𝓕 (parabolicGaussianAverage f)) ξ = parabolicGaussianSymbol (parabolicPlaneEquiv ξ)*(𝓕 f) ξ := by
  let χ : EuclideanSpace ℝ (Fin 2) → ℂ := fun x => Real.fourierChar (-inner ℝ x ξ)
  let J : ℝ × EuclideanSpace ℝ (Fin 2) → ℂ := fun p =>
    χ p.2*(parabolicGaussianWeight p.1*f (p.2-parabolicCurve p.1))
  have hχ : Continuous (fun p : ℝ × EuclideanSpace ℝ (Fin 2) => χ p.2) := by
    dsimp [χ]
    fun_prop
  have hJ : Integrable J := by
    apply (parabolicGaussianAverage_integrand_integrable hf).norm.mono'
      (hχ.aestronglyMeasurable.mul (parabolicGaussianAverage_integrand_integrable hf).aestronglyMeasurable)
    filter_upwards [] with p
    dsimp [J,χ]
    rw [norm_mul,Circle.norm_coe,one_mul]
  have hphase (t : ℝ) : χ (parabolicCurve t) =
      Complex.exp (-2*Real.pi*Complex.I*((((parabolicPlaneEquiv ξ).1)*t+(parabolicPlaneEquiv ξ).2*t^2:ℝ):ℂ)) := by
    rw [show χ (parabolicCurve t) = parabolicFourierCharacter (parabolicPlaneEquiv ξ)
        (parabolicPlaneEquiv (parabolicCurve t)) from parabolicFourierCharacter_euclidean ξ (parabolicCurve t)]
    simp only [parabolicCurve,ContinuousLinearEquiv.apply_symm_apply,parabolicFourierCharacter]
  calc
    _ = ∫ x : EuclideanSpace ℝ (Fin 2), ∫ t : ℝ, J (t,x) := by
      rw [Real.fourier_eq]
      apply integral_congr_ae
      filter_upwards [] with x
      change χ x*(∫ t, parabolicGaussianWeight t*f (x-parabolicCurve t)) = _
      exact (integral_const_mul (χ x) _).symm
    _ = ∫ t : ℝ, ∫ x : EuclideanSpace ℝ (Fin 2), J (t,x) := (integral_integral_swap hJ).symm
    _ = ∫ t : ℝ, parabolicGaussianWeight t*((𝓕 (fun x => f (x-parabolicCurve t))) ξ) := by
      apply integral_congr_ae
      filter_upwards [] with t
      rw [Real.fourier_eq,← integral_const_mul]
      apply integral_congr_ae
      filter_upwards [] with x
      change χ x*(parabolicGaussianWeight t*f (x-parabolicCurve t)) = parabolicGaussianWeight t*(χ x*f (x-parabolicCurve t))
      ring
    _ = (∫ t : ℝ, parabolicGaussianWeight t*χ (parabolicCurve t))*(𝓕 f) ξ := by
      simp_rw [parabolicCurve_fourier_translation,← mul_assoc]
      exact integral_mul_const _ _
    _ = _ := by
      congr 1
      apply integral_congr_ae
      filter_upwards [] with t
      rw [hphase]
      rfl

/-- Gaussian averaging of an integrable bounded function belongs to L2. -/
theorem parabolicGaussianAverage_memLp
    {f : EuclideanSpace ℝ (Fin 2) → ℂ} (hf : Integrable f) {B : ℝ} (hB : ∀ x, ‖f x‖ ≤ B) :
    MemLp (parabolicGaussianAverage f) 2 volume := by
  have hi := parabolicGaussianAverage_integrable hf
  apply (integrable_norm_rpow_iff hi.aestronglyMeasurable (by norm_num : (2:ENNReal) ≠ 0)
    (by norm_num : (2:ENNReal) ≠ ⊤)).mp
  simp only [ENNReal.toReal_ofNat,Real.rpow_two]
  apply (hi.norm.const_mul ((∫ t : ℝ, ‖parabolicGaussianWeight t‖)*B)).mono'
    (hi.aestronglyMeasurable.norm.pow 2)
  filter_upwards [] with x
  rw [Real.norm_eq_abs,abs_of_nonneg (sq_nonneg _),pow_two]
  exact mul_le_mul_of_nonneg_right (parabolicGaussianAverage_bound hB x) (norm_nonneg _)

/-- The zero parameter of the L2 family is exactly Gaussian parabola averaging. -/
theorem parabolicL2Family_zero_eq
    {f : EuclideanSpace ℝ (Fin 2) → ℂ} (hf : Integrable f) (hf2 : MemLp f 2 volume)
    {B : ℝ} (hB : ∀ x, ‖f x‖ ≤ B) :
    parabolicL2Family 0 (hf2.toLp f) =
      (parabolicGaussianAverage_memLp hf hB).toLp (parabolicGaussianAverage f) := by
  apply (Lp.fourierTransformₗᵢ (EuclideanSpace ℝ (Fin 2)) ℂ).injective
  apply Lp.ext
  filter_upwards [parabolicL2Family_fourier_ae 0 (hf2.toLp f),
    smoothing_fourier_toLp_ae_eq hf hf2,
    smoothing_fourier_toLp_ae_eq (parabolicGaussianAverage_integrable hf)
      (parabolicGaussianAverage_memLp hf hB)] with ξ hT hfξ hA
  change (𝓕 (parabolicL2Family 0 (hf2.toLp f))) ξ =
    (𝓕 ((parabolicGaussianAverage_memLp hf hB).toLp (parabolicGaussianAverage f))) ξ
  rw [hT,hfξ,hA,parabolicGaussianAverage_fourier hf,parabolicStripSymbol,
    if_pos (by norm_num : (0:ℂ).re ∈ Set.Icc (-1/2:ℝ) 1),parabolicAnalyticMultiplier_zero]

/-- The interpolated simple-function family equals the actual Gaussian average. -/
theorem parabolicSteinFamily_average_ae
    (f : SimpleFunc (EuclideanSpace ℝ (Fin 2)) ℂ) (hf : Integrable f) :
    parabolicSteinFamily (1/3:ℂ) f =ᵐ[volume] parabolicGaussianAverage f := by
  obtain ⟨B,hB⟩ := f.exists_forall_norm_le
  have ha := parabolicSteinFamily_ae (1/3:ℂ) f
  have hz : parabolicInterpolationParameter (1/3:ℂ) = 0 := by norm_num [parabolicInterpolationParameter]
  rw [hz,parabolicSimpleToL2,dif_pos hf,parabolicL2Family_zero_eq hf (parabolicSimple_memLp f hf) hB] at ha
  exact ha.trans (parabolicGaussianAverage_memLp hf hB).coeFn_toLp

/-- Exact L^(3/2) to L^3 Gaussian parabola averaging estimate on integrable simple functions. -/
theorem parabolicGaussianAverage_simple_bound
    (f : SimpleFunc (EuclideanSpace ℝ (Fin 2)) ℂ) (hf : Integrable f) :
    MemLp (parabolicGaussianAverage f) 3 volume ∧
      eLpNorm (parabolicGaussianAverage f) 3 volume ≤ ENNReal.ofReal parabolicAveragingBound*
        eLpNorm (f : EuclideanSpace ℝ (Fin 2) → ℂ) (3/2) volume := by
  have hh := parabolicStein_simple_bound f hf
  have ha := parabolicSteinFamily_average_ae f hf
  exact ⟨hh.1.ae_eq ha,(eLpNorm_congr_ae ha).symm.trans_le hh.2⟩

/-- Pointwise dominated approximation of inputs yields almost-everywhere
convergence of their Gaussian parabola averages. -/
theorem parabolicGaussianAverage_tendsto
    {f : EuclideanSpace ℝ (Fin 2) → ℂ} (hf : Integrable f)
    {F : ℕ → EuclideanSpace ℝ (Fin 2) → ℂ} (hF : ∀ n, Measurable (F n))
    (hbound : ∀ n x, ‖F n x‖ ≤ 2*‖f x‖)
    (hlim : ∀ x, Filter.Tendsto (fun n => F n x) Filter.atTop (nhds (f x))) :
    ∀ᵐ x, Filter.Tendsto (fun n => parabolicGaussianAverage (F n) x) Filter.atTop
      (nhds (parabolicGaussianAverage f x)) := by
  filter_upwards [(parabolicGaussianAverage_integrand_integrable hf).prod_left_ae] with x hx
  apply tendsto_integral_of_dominated_convergence
    (fun t => 2*‖parabolicGaussianWeight t*f (x-parabolicCurve t)‖)
  · intro n
    have hg : Measurable parabolicGaussianWeight := by unfold parabolicGaussianWeight; fun_prop
    exact (hg.mul ((hF n).comp (by unfold parabolicCurve; fun_prop))).aestronglyMeasurable
  · exact hx.norm.const_mul 2
  · intro n
    filter_upwards [] with t
    rw [norm_mul,norm_mul]
    calc
      _ ≤ ‖parabolicGaussianWeight t‖*(2*‖f (x-parabolicCurve t)‖) :=
        mul_le_mul_of_nonneg_left (hbound n _) (norm_nonneg _)
      _ = _ := by ring
  · filter_upwards [] with t
    exact Filter.Tendsto.const_mul (parabolicGaussianWeight t) (hlim (x-parabolicCurve t))

/-- Gaussian parabola averaging has the required endpoint bound for
measurable integrable inputs. The approximation changes only the harmless
operator constant by a factor of two. -/
theorem parabolicGaussianAverage_bound_general
    {f : EuclideanSpace ℝ (Fin 2) → ℂ} (hm : Measurable f) (hf : Integrable f) :
    eLpNorm (parabolicGaussianAverage f) 3 volume ≤ ENNReal.ofReal (2*parabolicAveragingBound)*
      eLpNorm f (3/2) volume := by
  let F : ℕ → SimpleFunc (EuclideanSpace ℝ (Fin 2)) ℂ :=
    fun n => SimpleFunc.approxOn f hm Set.univ 0 (Set.mem_univ 0) n
  have hbound (n : ℕ) (x : EuclideanSpace ℝ (Fin 2)) : ‖F n x‖ ≤ 2*‖f x‖ := by
    simpa only [F,two_mul] using SimpleFunc.norm_approxOn_zero_le hm (Set.mem_univ (0:ℂ)) x n
  have hint (n : ℕ) : Integrable (F n : EuclideanSpace ℝ (Fin 2) → ℂ) :=
    (hf.norm.const_mul 2).mono' (F n).aestronglyMeasurable (Filter.Eventually.of_forall (hbound n))
  have hlim (x : EuclideanSpace ℝ (Fin 2)) : Filter.Tendsto (fun n => F n x) Filter.atTop (nhds (f x)) :=
    SimpleFunc.tendsto_approxOn hm (Set.mem_univ 0) (by simp)
  apply Lp.eLpNorm_le_of_ae_tendsto (u := Filter.atTop) (f := fun n => parabolicGaussianAverage (F n))
  · apply Filter.Eventually.of_forall
    intro n
    have hi := (parabolicGaussianAverage_simple_bound (F n) (hint n)).2
    have hn := eLpNorm_le_mul_eLpNorm_of_ae_le_mul (μ := volume) (Filter.Eventually.of_forall (hbound n)) (3/2:ENNReal)
    calc
      _ ≤ ENNReal.ofReal parabolicAveragingBound*eLpNorm (F n : EuclideanSpace ℝ (Fin 2) → ℂ) (3/2) volume := hi
      _ ≤ ENNReal.ofReal parabolicAveragingBound*(ENNReal.ofReal 2*eLpNorm f (3/2) volume) := mul_le_mul' le_rfl hn
      _ = _ := by rw [ENNReal.ofReal_mul (by norm_num : (0:ℝ) ≤ 2)]; ring
  · intro n
    exact (parabolicGaussianAverage_integrable (hint n)).aestronglyMeasurable
  · exact parabolicGaussianAverage_tendsto hf (fun n => (F n).measurable) hbound hlim

/-- Every continuous compact time cutoff is dominated by a Gaussian. -/
theorem parabolic_cutoff_gaussian_domination {η : ℝ → ℂ}
    (hη : Continuous η) (hc : HasCompactSupport η) :
    ∃ C : ℝ, 0 < C ∧ ∀ t, ‖η t‖ ≤ C*Real.exp (-t^2) := by
  have hprod : HasCompactSupport (fun t : ℝ => η t*(Real.exp (t^2):ℂ)) := hc.mul_right
  have hp : Continuous (fun t : ℝ => η t*(Real.exp (t^2):ℂ)) := by fun_prop
  obtain ⟨B,hB⟩ := hprod.exists_bound_of_continuous hp
  refine ⟨max B 1,lt_of_lt_of_le zero_lt_one (le_max_right _ _),?_⟩
  intro t
  have hb : ‖η t‖*Real.exp (t^2) ≤ max B 1 := by
    have hh := (hB t).trans (le_max_left B 1)
    simpa only [norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_pos (Real.exp_pos _)] using hh
  have hh := mul_le_mul_of_nonneg_right hb (Real.exp_pos (-t^2)).le
  simpa only [mul_assoc,← Real.exp_add,add_neg_cancel,Real.exp_zero,mul_one] using hh

/-- Averaging with a general scalar time weight. -/
def parabolicWeightedAverage (η : ℝ → ℂ) (f : EuclideanSpace ℝ (Fin 2) → ℂ)
    (x : EuclideanSpace ℝ (Fin 2)) : ℂ := ∫ t, η t*f (x-parabolicCurve t)

theorem parabolicWeightedAverage_integrable {η : ℝ → ℂ} (hη : Integrable η)
    {f : EuclideanSpace ℝ (Fin 2) → ℂ} (hf : Integrable f) :
    Integrable (parabolicWeightedAverage η f) :=
  (parabolicCurveTranslation_measurePreserving.integrable_comp_of_integrable (hη.mul_prod hf)).integral_prod_right

/-- Gaussian averaging of the pointwise norm is the nonnegative scalar
majorant used for compactly supported time weights. -/
theorem parabolicGaussianAverage_normInput (f : EuclideanSpace ℝ (Fin 2) → ℂ)
    (x : EuclideanSpace ℝ (Fin 2)) :
    ‖parabolicGaussianAverage (fun y => (‖f y‖:ℂ)) x‖ =
      ∫ t : ℝ, ‖parabolicGaussianWeight t*f (x-parabolicCurve t)‖ := by
  have hw (t : ℝ) : parabolicGaussianWeight t = (Real.exp (-t^2):ℂ) := by
    simp only [parabolicGaussianWeight,Complex.ofReal_exp,Complex.ofReal_neg,Complex.ofReal_pow]
  simp_rw [parabolicGaussianAverage,norm_mul,parabolicGaussianWeight_norm,hw,← Complex.ofReal_mul]
  rw [integral_complex_ofReal,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg]
  exact integral_nonneg (fun t => mul_nonneg (Real.exp_pos _).le (norm_nonneg _))

/-- Gaussian domination controls any dominated weighted average almost everywhere. -/
theorem parabolicWeightedAverage_domination {η : ℝ → ℂ} {C : ℝ}
    (hC : ∀ t, ‖η t‖ ≤ C*Real.exp (-t^2))
    {f : EuclideanSpace ℝ (Fin 2) → ℂ} (hf : Integrable f) :
    ∀ᵐ x, ‖parabolicWeightedAverage η f x‖ ≤ C*‖parabolicGaussianAverage (fun y => (‖f y‖:ℂ)) x‖ := by
  filter_upwards [(parabolicGaussianAverage_integrand_integrable hf).prod_left_ae] with x hx
  rw [parabolicGaussianAverage_normInput]
  apply (norm_integral_le_of_norm_le (hx.norm.const_mul C) _).trans_eq
  · exact integral_const_mul C _
  · filter_upwards [] with t
    rw [norm_mul,norm_mul,parabolicGaussianWeight_norm]
    exact (mul_le_mul_of_nonneg_right (hC t) (norm_nonneg _)).trans_eq (mul_assoc _ _ _)

/-- The parabolic averaging prerequisite invoked after (3.2) in
arXiv:2008.10140v2: every continuous compactly supported time weight gives
an L^(3/2) to L^3 bound. The averaging integral is the actual parabola
operator, and the estimate applies to measurable integrable L^(3/2) inputs. -/
theorem parabolicAveraging_Lp_improving {η : ℝ → ℂ}
    (hη : Continuous η) (hc : HasCompactSupport η) :
    ∃ C : ℝ, 0 < C ∧ ∀ f : EuclideanSpace ℝ (Fin 2) → ℂ,
      Measurable f → Integrable f → MemLp f (3/2) volume →
      MemLp (parabolicWeightedAverage η f) 3 volume ∧
        eLpNorm (parabolicWeightedAverage η f) 3 volume ≤ ENNReal.ofReal C*eLpNorm f (3/2) volume := by
  obtain ⟨D,hD,hdom⟩ := parabolic_cutoff_gaussian_domination hη hc
  refine ⟨D*(2*parabolicAveragingBound),mul_pos hD (mul_pos (by norm_num) parabolicAveragingBound_pos),?_⟩
  intro f hm hf hfp
  have hnm : Measurable (fun x => (‖f x‖:ℂ)) := Complex.continuous_ofReal.measurable.comp hm.norm
  have hni : Integrable (fun x => (‖f x‖:ℂ)) := Complex.ofRealCLM.integrable_comp hf.norm
  have hn : eLpNorm (fun x => (‖f x‖:ℂ)) (3/2) volume = eLpNorm f (3/2) volume :=
    eLpNorm_congr_norm_ae (Filter.Eventually.of_forall (fun x => by simp))
  have hgauss := parabolicGaussianAverage_bound_general hnm hni
  rw [hn] at hgauss
  have hw := eLpNorm_le_mul_eLpNorm_of_ae_le_mul
    (parabolicWeightedAverage_domination hdom hf) (3:ENNReal)
  have hbound : eLpNorm (parabolicWeightedAverage η f) 3 volume ≤
      ENNReal.ofReal (D*(2*parabolicAveragingBound))*eLpNorm f (3/2) volume := by
    calc
      _ ≤ ENNReal.ofReal D*eLpNorm (parabolicGaussianAverage (fun x => (‖f x‖:ℂ))) 3 volume := hw
      _ ≤ ENNReal.ofReal D*(ENNReal.ofReal (2*parabolicAveragingBound)*eLpNorm f (3/2) volume) :=
        mul_le_mul' le_rfl hgauss
      _ = _ := by rw [ENNReal.ofReal_mul hD.le,mul_assoc]
  refine ⟨⟨(parabolicWeightedAverage_integrable (hη.integrable_of_hasCompactSupport hc) hf).aestronglyMeasurable,?_⟩,hbound⟩
  exact hbound.trans_lt (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hfp.2)

end
