open MeasureTheory Filter Topology Set
open scoped ENNReal ContDiff

namespace Auto

noncomputable section

/-! ### Lc03: the localized amplitude `ψ(t+s) ψ(t) ζ(x,y,t)` satisfies the hypotheses of
`mfk_bilinear` -/
theorem mlc_phi_nonneg (x : ℝ) : 0 ≤ monoPhi x := Real.smoothTransition.nonneg _
theorem mlc_phi_le_one (x : ℝ) : monoPhi x ≤ 1 := Real.smoothTransition.le_one _
theorem mlc_abs_phi_le (x : ℝ) : |monoPhi x| ≤ 1 := by
  rw [abs_of_nonneg (mlc_phi_nonneg x)]; exact mlc_phi_le_one x

theorem mlc_phi_ne_zero {x : ℝ} (h : monoPhi x ≠ 0) : |x| < 2 := by
  by_contra h'; exact h (monoPhi_eq_zero (not_lt.mp h'))

/-- The amplitude of the pair `(m,n)` for a fixed `s`. -/
def mlcAmp (ψ : ℝ → ℝ) (C0 h x0 y0 t0 s : ℝ) (p : (ℝ × ℝ) × ℝ) : ℂ :=
  ((ψ (p.2 + s) * ψ p.2 * monoPhi ((p.2 - t0) / (2 * C0 * h)) *
    (monoPhi ((p.1.1 - x0) / (C0 * h)) * monoPhi ((p.1.2 - y0) / (C0 * h))) : ℝ) : ℂ)

/-- A uniform bound for the first twelve derivatives of `φ`. -/
def mlcMphi : ℝ := Classical.choose (mlc_iteratedDeriv_bdd monoPhi_contDiff
  monoPhi_hasCompactSupport 12)

theorem mlcMphi_spec : 0 ≤ mlcMphi ∧ ∀ k ≤ 12, ∀ x, |iteratedDeriv k monoPhi x| ≤ mlcMphi :=
  Classical.choose_spec (mlc_iteratedDeriv_bdd monoPhi_contDiff monoPhi_hasCompactSupport 12)

/-- The amplitude constant. -/
def mlcLam (C0 : ℝ) : ℝ := 4 * C0 + 2 ^ 36 * mlcMphi

theorem mlcLam_pos {C0 : ℝ} (hC0 : 1 ≤ C0) : 0 < mlcLam C0 := by
  unfold mlcLam; have := mlcMphi_spec.1; positivity

theorem mlc_rpow_neg_nat {h : ℝ} (hh : 0 < h) (k : ℕ) : h ^ (-(k : ℝ)) = h⁻¹ ^ k := by
  rw [Real.rpow_neg hh.le, Real.rpow_natCast, inv_pow]

theorem mlc_reg_to_mfk {f : ℝ → ℝ} {α h Λ : ℝ} (hf : MlcReg 12 f α h⁻¹) (hh : 0 < h) (hαΛ : α ≤ Λ) :
    ContDiff ℝ 12 (fun x => (f x : ℂ)) ∧ ∀ k ≤ 12, ∀ x,
      ‖iteratedDeriv k (fun x => (f x : ℂ)) x‖ ≤ Λ * h ^ (-(k : ℝ)) := by
  refine ⟨mlc_contDiff_ofReal hf.1, fun k hk x => ?_⟩
  rw [mlc_norm_iteratedDeriv_ofReal hf.1 hk, mlc_rpow_neg_nat hh]
  exact (hf.2 k hk x).trans (mul_le_mul_of_nonneg_right hαΛ (by positivity))

theorem mlc_bump_reg {C : ℝ} (hC : 1 ≤ C) {h : ℝ} (hh : 0 < h) (a : ℝ) :
    MlcReg 12 (fun x => monoPhi ((x - a) / (C * h))) mlcMphi h⁻¹ :=
  (mlcReg_bump monoPhi_contDiff mlcMphi_spec.2 a (by positivity)).mono le_rfl (by positivity)
    (inv_anti₀ hh (by nlinarith))

theorem mlc_amp_hyp {ψ : ℝ → ℝ} (hψ : ContDiff ℝ ∞ ψ) {A B : ℝ} (hsupp : tsupport ψ ⊆ Icc A B)
    (hC : monoC20 ψ ≤ 1) {C0 h : ℝ} (hC0 : 1 ≤ C0) (hh : 0 < h) (hh1 : h ≤ 1) (x0 y0 t0 s : ℝ) :
    Continuous (mlcAmp ψ C0 h x0 y0 t0 s) ∧
    (∀ p, mlcAmp ψ C0 h x0 y0 t0 s p ≠ 0 → |p.1.1 - x0| ≤ mlcLam C0 * h ∧
        |p.1.2 - y0| ≤ mlcLam C0 * h ∧ |p.2 - t0| ≤ mlcLam C0 * h) ∧
    (∀ y t, ContDiff ℝ 12 (fun x => mlcAmp ψ C0 h x0 y0 t0 s ((x, y), t)) ∧ ∀ k ≤ 12, ∀ x,
        ‖iteratedDeriv k (fun x => mlcAmp ψ C0 h x0 y0 t0 s ((x, y), t)) x‖
          ≤ mlcLam C0 * h ^ (-(k : ℝ))) ∧
    (∀ x t, ContDiff ℝ 12 (fun y => mlcAmp ψ C0 h x0 y0 t0 s ((x, y), t)) ∧ ∀ k ≤ 12, ∀ y,
        ‖iteratedDeriv k (fun y => mlcAmp ψ C0 h x0 y0 t0 s ((x, y), t)) y‖
          ≤ mlcLam C0 * h ^ (-(k : ℝ))) ∧
    (∀ x y, ContDiff ℝ 12 (fun t => mlcAmp ψ C0 h x0 y0 t0 s ((x, y), t)) ∧ ∀ k ≤ 12, ∀ t,
        ‖iteratedDeriv k (fun t => mlcAmp ψ C0 h x0 y0 t0 s ((x, y), t)) t‖
          ≤ mlcLam C0 * h ^ (-(k : ℝ))) := by
  have hMφ := mlcMphi_spec.1
  have hψc : Continuous ψ := hψ.continuous
  have hφc : Continuous monoPhi := monoPhi_contDiff.continuous
  have hψ1 : ∀ t, |ψ t| ≤ 1 := fun t => by
    simpa using mlc_psi_deriv_le hψ hsupp hC (k := 0) (by norm_num) t
  have hεh : 1 ≤ h⁻¹ := by rw [le_inv_comm₀ one_pos hh]; simpa using hh1
  have hΛ1 : mlcMphi ≤ mlcLam C0 := by
    unfold mlcLam; nlinarith
  have hcoef : ∀ c : ℝ, |c| ≤ 1 → 2 ^ 12 * (|c| * mlcMphi) ≤ mlcLam C0 := by
    intro c hc
    unfold mlcLam
