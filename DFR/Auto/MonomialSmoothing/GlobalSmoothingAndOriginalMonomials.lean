  refine ⟨max K₁ K₂ + 1, σ / 39, by positivity, by positivity, ?_⟩
  intro ψ hψ hsupp L hL u₁ u₂ hu₁ hu₂ hf₁ hf₂
  have hp := ms7_C20_nonneg hψ hsupp
  have hLs : 0 ≤ L ^ (-(σ / 39)) := Real.rpow_nonneg (by linarith) _
