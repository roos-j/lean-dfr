/-! ### (8.4): the mollification error -/
theorem ms8_ftc {ψ : ℝ → ℝ} (hψ : ContDiff ℝ 1 ψ) (x s : ℝ) :
    ‖ψ x - ψ (x - s)‖ₑ ≤ ‖s‖ₑ * ∫⁻ θ in Ioc (0 : ℝ) 1, ‖deriv ψ (x - s + θ * s)‖ₑ := by
  have hD : Continuous (deriv ψ) := hψ.continuous_deriv le_rfl
  have hd : Differentiable ℝ ψ := hψ.differentiable one_ne_zero
  have hderiv : ∀ θ ∈ uIcc (0 : ℝ) 1, HasDerivAt (fun θ => ψ (x - s + θ * s))
      (deriv ψ (x - s + θ * s) * s) θ := by
    intro θ _
    have h1 : HasDerivAt (fun θ : ℝ => x - s + θ * s) s θ := by
      simpa using ((hasDerivAt_id θ).mul_const s).const_add (x - s)
    exact (hd (x - s + θ * s)).hasDerivAt.comp θ h1
  have hint : IntervalIntegrable (fun θ => deriv ψ (x - s + θ * s) * s) volume 0 1 :=
    ((hD.comp (continuous_const.add (continuous_id.mul continuous_const))).mul
      continuous_const).intervalIntegrable _ _
  have hF := intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv hint
  simp only [one_mul, zero_mul, add_zero, sub_add_cancel] at hF
  rw [← hF, intervalIntegral.integral_of_le zero_le_one]
  refine (enorm_integral_le_lintegral_enorm _).trans (le_of_eq ?_)
  rw [← lintegral_const_mul' _ _ enorm_ne_top]
  refine lintegral_congr fun θ => ?_
  rw [enorm_mul, mul_comm]

theorem ms8_lintegral_G {ψ : ℝ → ℝ} (hψ : ContDiff ℝ 1 ψ) (s : ℝ) :
    ∫⁻ x, ∫⁻ θ in Ioc (0 : ℝ) 1, ‖deriv ψ (x - s + θ * s)‖ₑ = ∫⁻ x, ‖deriv ψ x‖ₑ := by
  have hD : Continuous (deriv ψ) := hψ.continuous_deriv le_rfl
  have hm : Measurable (Function.uncurry fun (x θ : ℝ) => ‖deriv ψ (x - s + θ * s)‖ₑ) :=
    (hD.comp ((continuous_fst.sub continuous_const).add
      (continuous_snd.mul continuous_const))).measurable.enorm
  rw [lintegral_lintegral_swap hm.aemeasurable]
  have : ∀ θ : ℝ, ∫⁻ x, ‖deriv ψ (x - s + θ * s)‖ₑ = ∫⁻ x, ‖deriv ψ x‖ₑ := by
    intro θ
    have e : ∀ x, x - s + θ * s = x + (θ * s - s) := fun x => by ring
    simp_rw [e]
    exact lintegral_add_right_eq_self (fun x => ‖deriv ψ x‖ₑ) (θ * s - s)
  simp_rw [this]
  rw [setLIntegral_const, Real.volume_Ioc, sub_zero, ENNReal.ofReal_one, mul_one]

theorem ms8_lintegral_enorm_zetaH {h : ℝ} (hh : 0 < h) : ∫⁻ s, ‖ms8ZetaH h s‖ₑ = 1 := by
  rw [← ofReal_integral_norm_eq_lintegral_enorm (ms8_zetaH_integrable hh)]
  have : ∫ s, ‖ms8ZetaH h s‖ = ∫ s, ms8ZetaH h s := by
    refine integral_congr_ae (Eventually.of_forall fun s => ?_)
    simp only [Real.norm_eq_abs, abs_of_nonneg (ms8_zetaH_nonneg hh s)]
  rw [this, ms8_zetaH_integral hh, ENNReal.ofReal_one]

/-- **(8.4)**: `‖ψ - ψ_h‖_1 ≤ h ‖ψ'‖_1`. -/
theorem ms8_moll_err {ψ : ℝ → ℝ} (hψ : ContDiff ℝ 1 ψ) {M : ℝ} (hM : ∀ t, |ψ t| ≤ M)
    {h : ℝ} (hh : 0 < h) :
    ∫⁻ x, ‖ψ x - ms8Moll ψ h x‖ₑ ≤ ENNReal.ofReal h * ∫⁻ x, ‖deriv ψ x‖ₑ := by
  have hD : Continuous (deriv ψ) := hψ.continuous_deriv le_rfl
  have hc : Continuous ψ := hψ.continuous
  have hζ := ms8_zetaH_integrable hh
  set V := ∫⁻ x, ‖deriv ψ x‖ₑ
  -- pointwise representation
  have hpt : ∀ x, ‖ψ x - ms8Moll ψ h x‖ₑ ≤ ∫⁻ s, ‖ms8ZetaH h s‖ₑ *
      (‖s‖ₑ * ∫⁻ θ in Ioc (0 : ℝ) 1, ‖deriv ψ (x - s + θ * s)‖ₑ) := by
    intro x
    have hI1 : Integrable (fun s => ms8ZetaH h s * ψ x) volume := hζ.mul_const _
    have hI2 : Integrable (fun s => ms8ZetaH h s * ψ (x - s)) volume :=
      hζ.mul_bdd (c := M) (hc.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
        (Eventually.of_forall fun s => by rw [Real.norm_eq_abs]; exact hM _)
    have e : ψ x - ms8Moll ψ h x = ∫ s, ms8ZetaH h s * (ψ x - ψ (x - s)) := by
      simp_rw [mul_sub]
      rw [integral_sub hI1 hI2, integral_mul_const, ms8_zetaH_integral hh, one_mul, ms8Moll,
        convolution_eq_swap]
      congr 1
      refine integral_congr_ae (Eventually.of_forall fun s => ?_)
      simp [mul_comm]
    rw [e]
    refine (enorm_integral_le_lintegral_enorm _).trans (lintegral_mono fun s => ?_)
    rw [enorm_mul]
    gcongr; exact ms8_ftc hψ x s
  have hGm : Measurable fun q : ℝ × ℝ =>
      ∫⁻ θ in Ioc (0 : ℝ) 1, ‖deriv ψ (q.1 - q.2 + θ * q.2)‖ₑ := by
    have : Measurable fun w : (ℝ × ℝ) × ℝ => ‖deriv ψ (w.1.1 - w.1.2 + w.2 * w.1.2)‖ₑ :=
      (hD.comp (((continuous_fst.comp continuous_fst).sub (continuous_snd.comp continuous_fst)).add
        (continuous_snd.mul (continuous_snd.comp continuous_fst)))).measurable.enorm
    exact this.lintegral_prod_right'
  have hm : Measurable (Function.uncurry fun (x s : ℝ) => ‖ms8ZetaH h s‖ₑ *
      (‖s‖ₑ * ∫⁻ θ in Ioc (0 : ℝ) 1, ‖deriv ψ (x - s + θ * s)‖ₑ)) :=
    ((ms8_zetaH_contDiff h).continuous.measurable.comp measurable_snd).enorm.mul
      (measurable_snd.enorm.mul hGm)
  calc ∫⁻ x, ‖ψ x - ms8Moll ψ h x‖ₑ
      ≤ ∫⁻ x, ∫⁻ s, ‖ms8ZetaH h s‖ₑ *
          (‖s‖ₑ * ∫⁻ θ in Ioc (0 : ℝ) 1, ‖deriv ψ (x - s + θ * s)‖ₑ) := lintegral_mono hpt
    _ = ∫⁻ s, ∫⁻ x, ‖ms8ZetaH h s‖ₑ *
          (‖s‖ₑ * ∫⁻ θ in Ioc (0 : ℝ) 1, ‖deriv ψ (x - s + θ * s)‖ₑ) :=
        lintegral_lintegral_swap hm.aemeasurable
    _ = ∫⁻ s, ‖ms8ZetaH h s‖ₑ * (‖s‖ₑ * V) := by
        refine lintegral_congr fun s => ?_
        have hGs : Measurable fun x => ∫⁻ θ in Ioc (0 : ℝ) 1, ‖deriv ψ (x - s + θ * s)‖ₑ :=
          hGm.comp (measurable_id.prodMk measurable_const)
        rw [lintegral_const_mul _ (hGs.const_mul _), lintegral_const_mul _ hGs, ms8_lintegral_G hψ
          s]
    _ ≤ ∫⁻ s, ‖ms8ZetaH h s‖ₑ * (ENNReal.ofReal h * V) := by
        refine lintegral_mono fun s => ?_
        by_cases hs : h ≤ |s|
        · rw [ms8_zetaH_eq_zero hh hs]; simp
        · gcongr
          rw [← ofReal_norm, Real.norm_eq_abs]
          exact ENNReal.ofReal_le_ofReal (not_le.mp hs).le
    _ = ENNReal.ofReal h * V := by
        rw [lintegral_mul_const _ (ms8_zetaH_contDiff h).continuous.measurable.enorm,
          ms8_lintegral_enorm_zetaH hh, one_mul]

end

