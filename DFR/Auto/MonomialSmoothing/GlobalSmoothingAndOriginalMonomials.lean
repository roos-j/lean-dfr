/-! ### Returning to the monomials `(t^m, t^n)` on `ℝ × ℝ` -/

/-- `∫ ψ(t) f₁(x + t^m, y) f₂(x, y + t^n) dt`. -/
def ms8AvgP (m n : ℕ) (ψ : ℝ → ℝ) (f₁ f₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℂ :=
  ∫ t, (ψ t : ℂ) * (f₁ (z.1 + t ^ m, z.2) * f₂ (z.1, z.2 + t ^ n))

theorem ms8_avgP_eq {m n : ℕ} (hm : 0 < m) {a b : ℝ} (ha : 0 < a) {ψ : ℝ → ℝ}
    (hsupp : tsupport ψ ⊆ Icc a b) (f₁ f₂ : ℝ × ℝ → ℂ) :
    ms8AvgP m n ψ f₁ f₂ = monoT ((n : ℝ) / m) (ms8Sub m ψ) f₁ f₂ := by
  funext z
  unfold ms8AvgP monoT
  refine ms8_integral_sub hm ha hsupp fun t ht => ?_
  congr 3
  unfold monoQ
  rw [← Real.rpow_natCast t m, ← Real.rpow_mul ht.le, ← Real.rpow_natCast t n]
  congr 1
  have : (m : ℝ) ≠ 0 := by exact_mod_cast hm.ne'
  field_simp

theorem ms8_plane
    (hG : ∀ r A B : ℝ, 1 < r → 0 < A → A < B → ∃ C s : ℝ, 0 < C ∧ 0 < s ∧ MonoGlobal77 r A B C s)
    {m n : ℕ} (hm : 0 < m) (hmn : m < n) {a b : ℝ} (ha : 0 < a) (hab : a < b) :
    ∃ C δ : ℝ, 0 < C ∧ 0 < δ ∧ ∀ ψ : ℝ → ℝ, ContDiff ℝ 1 ψ → tsupport ψ ⊆ Icc a b →
      ∀ Λ : ℝ, 1 ≤ Λ → ∀ f₁ f₂ : ℝ × ℝ → ℂ, Measurable f₁ → Measurable f₂ →
      ∀ M₁ M₂ : ℝ, (∀ z, ‖f₁ z‖ ≤ M₁) → (∀ z, ‖f₂ z‖ ≤ M₂) →
      (∀ p, Integrable (monoFib 0 f₁ p) volume) → (∀ p, Integrable (monoFib 1 f₂ p) volume) →
      eLpNorm f₁ 2 volume ≠ ⊤ → eLpNorm f₂ 2 volume ≠ ⊤ →
      ((∀ p ξ, |ξ| < Λ → 𝓕 (monoFib 0 f₁ p) ξ = 0) ∨
        (∀ p ξ, |ξ| < Λ → 𝓕 (monoFib 1 f₂ p) ξ = 0)) →
      eLpNorm (ms8AvgP m n ψ f₁ f₂) 1 volume ≤
        ENNReal.ofReal (C * ((⨆ t, |ψ t|) + ∫ t, |deriv ψ t|) * Λ ^ (-δ)) *
          (eLpNorm f₁ 2 volume * eLpNorm f₂ 2 volume) := by
  have hm0 : (0 : ℝ) < m := by exact_mod_cast hm
  have hr : 1 < (n : ℝ) / m := by
    rw [one_lt_div hm0]; exact_mod_cast hmn
  have hA : 0 < a ^ m := pow_pos ha m
  have hAB : a ^ m < b ^ m := pow_lt_pow_left₀ hab ha.le hm.ne'
  obtain ⟨C₁, δ, hC₁, hδ, hT⟩ := ms8_c1_tail hG hr hA hAB
  obtain ⟨K, hK, hKb⟩ := ms8_sub_bound hm ha hab
  refine ⟨C₁ * K, δ, by positivity, hδ, ?_⟩
  intro ψ hψ hsupp Λ hΛ f₁ f₂ hf₁ hf₂ M₁ M₂ hM₁ hM₂ hfib₁ hfib₂ h2₁ h2₂ hF
  rw [ms8_avgP_eq hm ha hsupp]
  refine (hT (ms8Sub m ψ) (ms8_sub_contDiff hm ha hψ hsupp) (ms8_sub_tsupport hm ha hsupp) Λ hΛ
    f₁ f₂ hf₁ hf₂ M₁ M₂ hM₁ hM₂ hfib₁ hfib₂ h2₁ h2₂ hF).trans ?_
  refine mul_le_mul_of_nonneg_right (ENNReal.ofReal_le_ofReal ?_) (by simp)
  have hΛp : 0 ≤ Λ ^ (-δ) := by positivity
  have := hKb ψ hψ hsupp
  calc C₁ * ((⨆ u, |ms8Sub m ψ u|) + ∫ u, |deriv (ms8Sub m ψ) u|) * Λ ^ (-δ)
      ≤ C₁ * (K * ((⨆ t, |ψ t|) + ∫ t, |deriv ψ t|)) * Λ ^ (-δ) := by gcongr
    _ = C₁ * K * ((⨆ t, |ψ t|) + ∫ t, |deriv ψ t|) * Λ ^ (-δ) := by ring

end

end Auto

