theorem mfk_inner_plane (z ξ : ℝ × ℝ) :
    inner ℝ (smoothingPlaneEquiv.symm z) (smoothingPlaneEquiv.symm ξ) = z.1 * ξ.1 + z.2 * ξ.2 := by
  obtain ⟨z1, z2⟩ := z
  obtain ⟨x1, x2⟩ := ξ
