namespace Auto

noncomputable section

theorem mfk_memLp_of_lintegral {f : ℝ → ℂ} (hf : AEStronglyMeasurable f volume)
    (h : ∫⁻ x, ‖f x‖ₑ ^ 2 < ∞) : MemLp f 2 volume := by
  refine (memLp_two_iff_integrable_sq_norm hf).mpr ⟨hf.norm.pow 2, ?_⟩
  rw [hasFiniteIntegral_iff_enorm]
  refine lt_of_eq_of_lt ?_ h
  congr 1; ext x
  rw [Real.enorm_of_nonneg (by positivity), ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm]

theorem mfk_slice_ae {F : ℝ × ℝ → ℂ} (h1 : Integrable F volume) (h2 : MemLp F 2 volume) :
    ∀ᵐ y : ℝ, Integrable (fun x => F (x, y)) ∧ MemLp (fun x => F (x, y)) 2 volume := by
  have h1' : Integrable F (volume.prod volume) :=
    by simpa only [Measure.volume_eq_prod] using h1
  have hsq := (memLp_two_iff_integrable_sq_norm h2.aestronglyMeasurable).mp h2
  have hsq' : Integrable (fun z => ‖F z‖ ^ 2) (volume.prod volume) := by
    simpa only [Measure.volume_eq_prod] using hsq
  filter_upwards [h1'.prod_left_ae, hsq'.prod_left_ae] with y hy hy2
  exact ⟨hy, (memLp_two_iff_integrable_sq_norm hy.1).mpr hy2⟩

theorem mfk_lintegral_prod_sq (F : ℝ × ℝ → ℂ) (hF : Measurable F) :
    ∫⁻ z, ‖F z‖ₑ ^ 2 = ∫⁻ y, ∫⁻ x, ‖F (x, y)‖ₑ ^ 2 := by
  rw [Measure.volume_eq_prod, lintegral_prod_symm]
  exact (hF.enorm.pow_const 2).aemeasurable

theorem mfk_lintegral_G_swap {F : ℝ × ℝ → ℂ} (hF : Measurable F) (S : Set ℝ) :
    ∫⁻ ξ in S, ∫⁻ y, ‖mfkG F ξ y‖ₑ ^ 2 = ∫⁻ y, ∫⁻ ξ in S, ‖mfkG F ξ y‖ₑ ^ 2 := by
  apply lintegral_lintegral_swap
  have := ((mfkG_measurable hF).enorm.pow_const 2)
  exact this.aemeasurable

theorem mfk_G_energy {F : ℝ × ℝ → ℂ} (hF : Measurable F) (h1 : Integrable F volume)
    (h2 : MemLp F 2 volume) :
    ∫⁻ y, ∫⁻ ξ, ‖mfkG F ξ y‖ₑ ^ 2 = ∫⁻ z, ‖F z‖ₑ ^ 2 := by
  rw [mfk_lintegral_prod_sq F hF]
  apply lintegral_congr_ae
  filter_upwards [mfk_slice_ae h1 h2] with y hy
  have := mfk_plancherel1 hy.1 hy.2
  simpa only [mfkF1, mfkG] using this

theorem mfk_G_memLp_ae {F : ℝ × ℝ → ℂ} (hF : Measurable F) (h1 : Integrable F volume)
    (h2 : MemLp F 2 volume) : ∀ᵐ ξ : ℝ, MemLp (mfkG F ξ) 2 volume := by
  have hfin : ∫⁻ ξ, ∫⁻ y, ‖mfkG F ξ y‖ₑ ^ 2 < ∞ := by
    have := mfk_lintegral_G_swap hF univ
    simp only [Measure.restrict_univ] at this
    rw [this, mfk_G_energy hF h1 h2]
    rw [mfk_lintegral_sq_eq_ofReal h2]
    exact ENNReal.ofReal_lt_top
  have hm : AEMeasurable (fun ξ => ∫⁻ y, ‖mfkG F ξ y‖ₑ ^ 2) := by
    exact ((mfkG_measurable hF).enorm.pow_const 2).lintegral_prod_right'.aemeasurable
  filter_upwards [ae_lt_top' hm hfin.ne] with ξ hξ
  exact mfk_memLp_of_lintegral (mfkG_integrable hF h1 ξ).1 hξ

/-- Main slice identity. -/
theorem mfk_strip_identity {F : ℝ × ℝ → ℂ} (hF : Measurable F) (h1 : Integrable F volume)
    (h2 : MemLp F 2 volume) (S : Set ℝ) :
    ∫⁻ ξ₁ in S, ∫⁻ ξ₂, ‖mfkF2 F (ξ₁, ξ₂)‖ₑ ^ 2 = ∫⁻ y, ∫⁻ ξ₁ in S, ‖mfkG F ξ₁ y‖ₑ ^ 2 := by
  rw [← mfk_lintegral_G_swap hF S]
  apply lintegral_congr_ae
  apply ae_restrict_of_ae
  filter_upwards [mfk_G_memLp_ae hF h1 h2] with ξ hξ
  simp only [mfkF2_eq_iter h1]
  exact mfk_plancherel1 (mfkG_integrable hF h1 ξ) hξ

end

end Auto

