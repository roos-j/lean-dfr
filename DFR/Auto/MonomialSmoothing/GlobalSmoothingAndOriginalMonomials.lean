open MeasureTheory Filter Topology Set
open scoped ENNReal FourierTransform

namespace Auto

noncomputable section

theorem mfk_exp_integral_eq_fourier (g : ℝ → ℂ) (τ : ℝ) :
    ∫ x : ℝ, Complex.exp (2 * Real.pi * Complex.I * (x * τ)) * g x = 𝓕 g (-τ) := by
  rw [← mfkF1_eq_fourier, mfkF1]
  congr 1; ext x
  congr 2
  push_cast
  ring

/-- One-dimensional integration by parts bound, twelve times. -/
theorem mfk_1d_decay {Λ h x0 : ℝ} (hΛ : 0 < Λ) (hh : 0 < h) {g : ℝ → ℂ}
    (hg : ContDiff ℝ 12 g)
    (hd : ∀ k ≤ 12, ∀ x, ‖iteratedDeriv k g x‖ ≤ Λ * h ^ (-(k : ℝ)))
    (hs : ∀ x, g x ≠ 0 → |x - x0| ≤ Λ * h) (τ : ℝ) :
    ‖∫ x : ℝ, Complex.exp (2 * Real.pi * Complex.I * (x * τ)) * g x‖ * (1 + h * |τ|) ^ 12
      ≤ 2 ^ 13 * Λ ^ 2 * h := by
  have hs' : ∀ x, g x ≠ 0 → x ∈ Icc (x0 - Λ * h) (x0 + Λ * h) := by
    intro x hx
    have := abs_le.mp (hs x hx)
    constructor <;> linarith [this.1, this.2]
  have hab : x0 - Λ * h ≤ x0 + Λ * h := by nlinarith
  rw [mfk_exp_integral_eq_fourier]
  set E := 𝓕 g (-τ)
  have hlen : x0 + Λ * h - (x0 - Λ * h) = 2 * Λ * h := by ring
  -- zeroth order bound
  have B0 : ‖E‖ ≤ 2 * Λ ^ 2 * h := by
    have h0 := mfk_integral_norm_iteratedDeriv_le hab hs' (k := 0)
      (M := Λ) (fun x => by simpa using hd 0 (by norm_num) x)
    simp only [iteratedDeriv_zero] at h0
    have : ‖E‖ ≤ ∫ x, ‖g x‖ := by
      simp only [E, Real.fourier_eq]
      refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
      congr 1; ext x; rw [Circle.norm_smul]
    rw [hlen] at h0
    nlinarith
  have B12 : ‖E‖ * (2 * Real.pi * |τ|) ^ 12 ≤ 2 * Λ ^ 2 * h * h ^ (-(12 : ℝ)) := by
    have h1 := mfk_fourier_mul_pow_le hg hs' (-τ)
    rw [abs_neg] at h1
    have h2 := mfk_integral_norm_iteratedDeriv_le hab hs' (k := 12)
      (M := Λ * h ^ (-((12 : ℕ) : ℝ))) (fun x => hd 12 le_rfl x)
    rw [hlen] at h2
    simp only [Nat.cast_ofNat] at h2
    calc _ ≤ _ := h1
      _ ≤ _ := h2
      _ = _ := by ring
  have hE : 0 ≤ ‖E‖ := norm_nonneg _
  have hX : 0 ≤ h * |τ| := by positivity
  rcases le_total (h * |τ|) 1 with hle | hle
  · have hp : (1 + h * |τ|) ^ 12 ≤ 2 ^ 12 := pow_le_pow_left₀ (by positivity) (by linarith) 12
    calc ‖E‖ * (1 + h * |τ|) ^ 12 ≤ (2 * Λ ^ 2 * h) * 2 ^ 12 :=
          mul_le_mul B0 hp (by positivity) (by positivity)
      _ = _ := by ring
  · have hpi : (1 : ℝ) ≤ 2 * Real.pi := by linarith [Real.pi_gt_three]
    have h1 : 1 + h * |τ| ≤ 2 * h * (2 * Real.pi * |τ|) := by
      have : h * |τ| ≤ h * |τ| * (2 * Real.pi) := le_mul_of_one_le_right hX hpi
      nlinarith
    have hp : (1 + h * |τ|) ^ 12 ≤ (2 * h) ^ 12 * (2 * Real.pi * |τ|) ^ 12 := by
      rw [← mul_pow]; exact pow_le_pow_left₀ (by positivity) h1 12
    have hhh : h ^ (12 : ℕ) * h ^ (-(12 : ℝ)) = 1 := by
      rw [Real.rpow_neg hh.le, ← Real.rpow_natCast]
      simp only [Nat.cast_ofNat]
      exact mul_inv_cancel₀ (by positivity)
    calc ‖E‖ * (1 + h * |τ|) ^ 12 ≤ ‖E‖ * ((2 * h) ^ 12 * (2 * Real.pi * |τ|) ^ 12) :=
          mul_le_mul_of_nonneg_left hp hE
      _ = (2 * h) ^ 12 * (‖E‖ * (2 * Real.pi * |τ|) ^ 12) := by ring
      _ ≤ (2 * h) ^ 12 * (2 * Λ ^ 2 * h * h ^ (-(12 : ℝ))) :=
          mul_le_mul_of_nonneg_left B12 (by positivity)
      _ = 2 ^ 13 * Λ ^ 2 * h * (h ^ (12 : ℕ) * h ^ (-(12 : ℝ))) := by ring
      _ = _ := by rw [hhh, mul_one]

end

end Auto

end

