/-! ### Lc17: Hölder over the pairs and the proof of Lemma 5.1 -/

/-- Hölder with exponents `(2,4,4)` over a finite set. -/
theorem mlc_holder {ι : Type*} (s : Finset ι) (X Y : ι → ℝ≥0∞) :
    ∑ i ∈ s, X i ^ (1 / 4 : ℝ) * Y i ^ (1 / 4 : ℝ) ≤
      (s.card : ℝ≥0∞) ^ (1 / 2 : ℝ) * ((∑ i ∈ s, X i) ^ (1 / 4 : ℝ) * (∑ i ∈ s, Y i) ^ (1 / 4 :
        ℝ)) := by
  have h1 := ENNReal.inner_le_Lp_mul_Lq s (fun _ => (1 : ℝ≥0∞))
    (fun i => X i ^ (1 / 4 : ℝ) * Y i ^ (1 / 4 : ℝ)) Real.HolderConjugate.two_two
  have h2 := ENNReal.inner_le_Lp_mul_Lq s (fun i => X i ^ (1 / 2 : ℝ)) (fun i => Y i ^ (1 / 2 : ℝ))
    Real.HolderConjugate.two_two
  have e1 : ∀ x : ℝ≥0∞, (x ^ (1 / 4 : ℝ)) ^ (2 : ℝ) = x ^ (1 / 2 : ℝ) := fun x => by
    rw [← ENNReal.rpow_mul]; norm_num
  have e2 : ∀ x : ℝ≥0∞, (x ^ (1 / 2 : ℝ)) ^ (2 : ℝ) = x := fun x => by
    rw [← ENNReal.rpow_mul]; norm_num
  simp only [one_mul, ENNReal.one_rpow, Finset.sum_const, nsmul_eq_mul, mul_one] at h1
  simp only [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0:ℝ) ≤ 2), e1, e2] at h1 h2
  refine h1.trans ?_
  gcongr
  calc (∑ i ∈ s, X i ^ (1 / 2 : ℝ) * Y i ^ (1 / 2 : ℝ)) ^ (1 / 2 : ℝ)
      ≤ ((∑ i ∈ s, X i) ^ (1 / 2 : ℝ) * (∑ i ∈ s, Y i) ^ (1 / 2 : ℝ)) ^ (1 / 2 : ℝ) :=
        ENNReal.rpow_le_rpow h2 (by norm_num)
    _ = _ := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul, ← ENNReal.rpow_mul]
        norm_num

theorem mlc_card_P {r A B C0 h K Rχ : ℝ} {χ : ℝ × ℝ → ℝ} {v₁ v₂ : ℤ × ℤ → ℝ × ℝ → ℂ} {B₁ B₂ : ℝ}
    (G : MlcGlob r A B C0 h K Rχ χ v₁ v₂ B₁ B₂) (M₁ M₂ : Finset (ℤ × ℤ)) :
    ((mlcP r A B C0 h χ M₁ M₂).card : ℝ≥0∞) ≤
      ENNReal.ofReal ((2 * mlcR0 r B C0 Rχ + 1) ^ 2 * (mlcM0 r B C0 * (B - A + 2) / h ^ 3)) := by
  have hh := G.hh
  have hM := mlcM0_nonneg r B C0
  have hBA : 0 ≤ B - A + 2 := by linarith [G.hAB]
  rw [Finset.card_eq_sum_ones, Nat.cast_sum, mlcP_sum_fst]
  refine G.sum_relevant_fst M₁ M₂ _ (by positivity) (fun m _ _ => ?_) (fun m _ H => ?_)
  · simp only [Nat.cast_one, Finset.sum_const, nsmul_eq_mul, mul_one]
    rw [← ENNReal.ofReal_natCast]
    apply ENNReal.ofReal_le_ofReal
    refine (mlc_card_Nm G.hr G.hA G.hAB G.hC0 G.hh G.hh1 M₂ m).trans (le_of_eq ?_)
    have := hh.ne'
    field_simp
  · rw [Finset.not_nonempty_iff_eq_empty] at H
    rw [H, Finset.sum_empty]

/-- The ENNReal bookkeeping of the final sum. -/
theorem mlc_final_ennreal {ι : Type*} (P : Finset ι) (X Y F : ι → ℝ≥0∞) {Mχ K₁ K₂ h Nr Z E : ℝ}
    (hMχ : 0 ≤ Mχ) (hK₁ : 0 ≤ K₁) (hK₂ : 0 ≤ K₂) (hh : 0 < h) (hNr : 0 ≤ Nr) (hZ : 0 ≤ Z)
    (hE : 0 ≤ E)
    (hF : ∀ p ∈ P, F p ≤ ENNReal.ofReal (K₁ * h ^ (3 / 2 : ℝ)) * (X p ^ (1 / 4 : ℝ) * Y p ^ (1 / 4
      : ℝ)) +
      ENNReal.ofReal (K₂ * E))
    (hN : (P.card : ℝ≥0∞) ≤ ENNReal.ofReal Nr)
    (hXY : (∑ p ∈ P, X p) ^ (1 / 4 : ℝ) * (∑ p ∈ P, Y p) ^ (1 / 4 : ℝ) ≤ ENNReal.ofReal (Z ^ (1 /
      4 : ℝ))) :
    ∑ p ∈ P, ENNReal.ofReal Mχ * F p ≤
      ENNReal.ofReal (Mχ * (K₁ * h ^ (3 / 2 : ℝ) * (Nr ^ (1 / 2 : ℝ) * Z ^ (1 / 4 : ℝ)) + Nr * (K₂
        * E))) := by
  set a := ENNReal.ofReal (K₁ * h ^ (3 / 2 : ℝ))
  set b := ENNReal.ofReal (K₂ * E)
  have hS := mlc_holder P X Y
  calc ∑ p ∈ P, ENNReal.ofReal Mχ * F p
      ≤ ∑ p ∈ P, ENNReal.ofReal Mχ * (a * (X p ^ (1 / 4 : ℝ) * Y p ^ (1 / 4 : ℝ)) + b) :=
        Finset.sum_le_sum fun p hpP => mul_le_mul' le_rfl (hF p hpP)
    _ = ENNReal.ofReal Mχ * (a * ∑ p ∈ P, X p ^ (1 / 4 : ℝ) * Y p ^ (1 / 4 : ℝ) + (P.card : ℝ≥0∞)
      * b) := by
        rw [← Finset.mul_sum, Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_const,
          nsmul_eq_mul]
    _ ≤ ENNReal.ofReal Mχ * (a * ((ENNReal.ofReal Nr) ^ (1 / 2 : ℝ) * ENNReal.ofReal (Z ^ (1 / 4 :
      ℝ))) +
          ENNReal.ofReal Nr * b) := by
        gcongr
        exact hS.trans (mul_le_mul' (ENNReal.rpow_le_rpow hN (by norm_num)) hXY)
    _ = _ := by
        simp only [a, b]
        rw [ENNReal.ofReal_rpow_of_nonneg hNr (by norm_num), ← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul hNr,
          ← ENNReal.ofReal_add (by positivity) (by positivity), ← ENNReal.ofReal_mul hMχ]

/-- The real arithmetic of the final bound. -/
theorem mlc_final_real {Mχ K₁ K₂ h Np cu Tc ρ K B₁ B₂ L : ℝ} (hMχ : 0 ≤ Mχ) (hK₁ : 0 ≤ K₁)
    (hK₂ : 0 ≤ K₂) (hh : 0 < h) (hNp : 0 ≤ Np) (hcu : 0 ≤ cu) (hTc : 0 ≤ Tc) (hρ : 0 < ρ)
    (hK : 0 < K) (hB₁ : 0 ≤ B₁) (hB₂ : 0 ≤ B₂) (hL : 0 ≤ L) :
    Mχ * (K₁ * h ^ (3 / 2 : ℝ) * ((Np / h ^ 3) ^ (1 / 2 : ℝ) *
        (cu * (ρ + h + 1 / K) * Tc) ^ (1 / 4 : ℝ)) +
      Np / h ^ 3 * (K₂ * (B₁ * B₂ * L ^ (1 / 2 : ℝ) * h ^ 4))) ≤
    (Mχ * K₁ * Np ^ (1 / 2 : ℝ) * (cu * Tc) ^ (1 / 4 : ℝ) + Mχ * Np * K₂) *
      (B₁ * B₂ * L ^ (1 / 2 : ℝ) * h + (ρ + h + 1 / K) ^ (1 / 4 : ℝ)) := by
  have e1 : h ^ (3 / 2 : ℝ) * (Np / h ^ 3) ^ (1 / 2 : ℝ) = Np ^ (1 / 2 : ℝ) := by
    rw [Real.div_rpow hNp (by positivity), ← Real.rpow_natCast h 3, ← Real.rpow_mul hh.le]
    rw [show ((3 : ℕ) : ℝ) * (1 / 2 : ℝ) = 3 / 2 by norm_num]
    have hpos : 0 < h ^ (3 / 2 : ℝ) := by positivity
    field_simp
  have e2 : Np / h ^ 3 * h ^ 4 = Np * h := by
    have := hh.ne'
    field_simp
  have e3 : (cu * (ρ + h + 1 / K) * Tc) ^ (1 / 4 : ℝ) =
      (cu * Tc) ^ (1 / 4 : ℝ) * (ρ + h + 1 / K) ^ (1 / 4 : ℝ) := by
    rw [← Real.mul_rpow (by positivity) (by positivity)]
    congr 1; ring
  have hq : 0 ≤ (ρ + h + 1 / K) ^ (1 / 4 : ℝ) := by positivity
  have hx : 0 ≤ B₁ * B₂ * L ^ (1 / 2 : ℝ) * h := by positivity
  calc Mχ * (K₁ * h ^ (3 / 2 : ℝ) * ((Np / h ^ 3) ^ (1 / 2 : ℝ) *
        (cu * (ρ + h + 1 / K) * Tc) ^ (1 / 4 : ℝ)) +
        Np / h ^ 3 * (K₂ * (B₁ * B₂ * L ^ (1 / 2 : ℝ) * h ^ 4)))
      = Mχ * K₁ * (h ^ (3 / 2 : ℝ) * (Np / h ^ 3) ^ (1 / 2 : ℝ)) *
          (cu * (ρ + h + 1 / K) * Tc) ^ (1 / 4 : ℝ) +
          Mχ * K₂ * B₁ * B₂ * L ^ (1 / 2 : ℝ) * (Np / h ^ 3 * h ^ 4) := by ring
    _ = Mχ * K₁ * Np ^ (1 / 2 : ℝ) * (cu * Tc) ^ (1 / 4 : ℝ) * (ρ + h + 1 / K) ^ (1 / 4 : ℝ) +
          (Mχ * Np * K₂) * (B₁ * B₂ * L ^ (1 / 2 : ℝ) * h) := by
        rw [e1, e2, e3]; ring
    _ ≤ _ := by
        have h1 : 0 ≤ Mχ * K₁ * Np ^ (1 / 2 : ℝ) * (cu * Tc) ^ (1 / 4 : ℝ) := by positivity
        have h2 : 0 ≤ Mχ * Np * K₂ := by positivity
        nlinarith [mul_nonneg h1 hx, mul_nonneg h2 hq]

end

end Auto

