theorem mfk_dir_bound (e : ℝ × (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) × ℝ) (he : MeasurePreserving e volume volume)
    (f : (ℝ × ℝ) × ℝ → ℂ) (hf : Integrable f) {B : ℝ} (S : Set (ℝ × ℝ))
    (hSv : volume S < ∞) (hB : ∀ w, ‖∫ s, f (e (s, w))‖ ≤ B)
    (h0 : ∀ w ∉ S, ∀ s, f (e (s, w)) = 0) :
    ‖∫ p, f p‖ ≤ B * volume.real S := by
  rw [← he.integral_comp' f]
  have hi : Integrable (fun z => f (e z)) (volume.prod volume) :=
    he.integrable_comp_of_integrable hf
  rw [show (volume : Measure (ℝ × (ℝ × ℝ))) = volume.prod volume from rfl,
    integral_prod_symm _ hi]
  refine (norm_integral_le_integral_norm _).trans ?_
  have hz : ∀ w, w ∉ S → ‖∫ s, f (e (s, w))‖ = 0 := by
    intro w hw
    simp [h0 w hw]
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero hz]
  have := norm_setIntegral_le_of_norm_le_const (μ := volume) (s := S)
    (f := fun w => ‖∫ s, f (e (s, w))‖) (C := B) hSv
    (fun w _ => by rw [norm_norm]; exact hB w)
  exact (le_abs_self _).trans (by simpa [Real.norm_eq_abs] using this)

def mfkEX : ℝ × (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) × ℝ := MeasurableEquiv.prodAssoc.symm

theorem mfkEX_apply (s y t : ℝ) : mfkEX (s, (y, t)) = ((s, y), t) := rfl

theorem mfkEX_mp : MeasurePreserving mfkEX volume volume :=
  (volume_preserving_prodAssoc (α₁ := ℝ) (β₁ := ℝ) (γ₁ := ℝ)).symm _

def mfkEY : ℝ × (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) × ℝ :=
  MeasurableEquiv.prodAssoc.symm.trans
    (MeasurableEquiv.prodCongr MeasurableEquiv.prodComm (MeasurableEquiv.refl ℝ))

theorem mfkEY_apply (s x t : ℝ) : mfkEY (s, (x, t)) = ((x, s), t) := rfl

theorem mfkEY_mp : MeasurePreserving mfkEY volume volume := by
  have h1 := (volume_preserving_prodAssoc (α₁ := ℝ) (β₁ := ℝ) (γ₁ := ℝ)).symm _
  have h2 : MeasurePreserving (Prod.map (Prod.swap : ℝ × ℝ → ℝ × ℝ) (id : ℝ → ℝ))
      ((volume : Measure (ℝ × ℝ)).prod (volume : Measure ℝ)) (volume.prod volume) := by
    have hs : MeasurePreserving (Prod.swap : ℝ × ℝ → ℝ × ℝ) volume volume := by
      simpa only [Measure.volume_eq_prod] using
        (Measure.measurePreserving_swap (μ := (volume : Measure ℝ)) (ν := (volume : Measure ℝ)))
    exact hs.prod (MeasurePreserving.id volume)
  exact h2.comp h1

def mfkET : ℝ × (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) × ℝ := MeasurableEquiv.prodComm

theorem mfkET_apply (s x y : ℝ) : mfkET (s, (x, y)) = ((x, y), s) := rfl

theorem mfkET_mp : MeasurePreserving mfkET volume volume :=
  Measure.measurePreserving_swap

end

end Auto

