theorem mfk_row_full {Λ h q qhi : ℝ} (hΛ : 0 < Λ) (hh : 0 < h) (hq : 0 ≤ q) (hqq : q ≤ qhi)
    (ξ : ℝ × ℝ) :
    ∫⁻ η, ENNReal.ofReal (3 ^ 12 * (2 ^ 15 * Λ ^ 4 * h ^ 3) * mfkK h q ξ η)
      ≤ ENNReal.ofReal (mfkC Λ qhi * h) *
          ENNReal.ofReal ((1 + |h * (ξ.1 - q * ξ.2)|) ^ (-8 : ℝ)) := by
  have hK0 : 0 ≤ 3 ^ 12 * (2 ^ 15 * Λ ^ 4 * h ^ 3) := by positivity
  have hM : (1 : ℝ) ≤ max 1 qhi := le_max_left _ _
  have hqM : q ≤ max 1 qhi := hqq.trans (le_max_right _ _)
  simp_rw [ENNReal.ofReal_mul hK0]
  rw [lintegral_const_mul _ (by unfold mfkK; fun_prop)]
  refine (mul_le_mul' le_rfl (mfk_row hh hq hqM hM ξ)).trans (le_of_eq ?_)
  rw [← ENNReal.ofReal_mul hK0, ← ENNReal.ofReal_mul (mul_nonneg (mfkC_nonneg _ _) hh.le),
    ← mfkW_eq]
  congr 1
  unfold mfkC
  field_simp

theorem mfk_col_full {Λ h q qhi : ℝ} (hΛ : 0 < Λ) (hh : 0 < h) (hq : 0 ≤ q) (hqq : q ≤ qhi)
    (η : ℝ × ℝ) :
    ∫⁻ ξ, ENNReal.ofReal (3 ^ 12 * (2 ^ 15 * Λ ^ 4 * h ^ 3) * mfkK h q ξ η)
      ≤ ENNReal.ofReal (mfkC Λ qhi * h) *
          ENNReal.ofReal ((1 + |h * (η.1 - q * η.2)|) ^ (-8 : ℝ)) := by
  have hK0 : 0 ≤ 3 ^ 12 * (2 ^ 15 * Λ ^ 4 * h ^ 3) := by positivity
  have hM : (1 : ℝ) ≤ max 1 qhi := le_max_left _ _
  have hqM : q ≤ max 1 qhi := hqq.trans (le_max_right _ _)
  simp_rw [ENNReal.ofReal_mul hK0]
  rw [lintegral_const_mul _ (by unfold mfkK; fun_prop)]
  refine (mul_le_mul' le_rfl (mfk_col hh hq hqM hM η)).trans (le_of_eq ?_)
  rw [← ENNReal.ofReal_mul hK0, ← ENNReal.ofReal_mul (mul_nonneg (mfkC_nonneg _ _) hh.le),
    ← mfkW_eq]
  congr 1
  unfold mfkC
  field_simp

theorem mfk_const_split (c X Y : ℝ≥0∞) :
    (c * X) ^ (1 / 2 : ℝ) * (c * Y) ^ (1 / 2 : ℝ) = c * X ^ (1 / 2 : ℝ) * Y ^ (1 / 2 : ℝ) := by
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]
  have : c ^ (1 / 2 : ℝ) * c ^ (1 / 2 : ℝ) = c := by
    rw [← sq, ← ENNReal.rpow_two, mfk_sqrt_sq]
  calc c ^ (1 / 2 : ℝ) * X ^ (1 / 2 : ℝ) * (c ^ (1 / 2 : ℝ) * Y ^ (1 / 2 : ℝ))
      = (c ^ (1 / 2 : ℝ) * c ^ (1 / 2 : ℝ)) * X ^ (1 / 2 : ℝ) * Y ^ (1 / 2 : ℝ) := by ring
    _ = _ := by rw [this]

theorem mfk_nice_bound {Λ h q qhi x0 y0 t0 : ℝ} (hΛ : 0 < Λ) (hh : 0 < h) (hq : 0 ≤ q)
    (hqq : q ≤ qhi) {A : (ℝ × ℝ) × ℝ → ℂ} (hA : MfkAmp Λ h x0 y0 t0 A) (c : ℝ)
    {G₁ G₂ : ℝ × ℝ → ℂ} (h1 : MfkNice G₁) (h2 : MfkNice G₂) :
    ‖mfkTri A c q G₁ G₂‖ₑ ≤ ENNReal.ofReal (mfkC Λ qhi * h) * mfkX h q G₁ * mfkX h q G₂ := by
  set K0 := 3 ^ 12 * (2 ^ 15 * Λ ^ 4 * h ^ 3)
  have hm1 := mfkF2_measurable_of G₁ h1.measurable
  have hm2 := mfkF2_measurable_of G₂ h2.measurable
  have hKm := mfk_K_measurable h q K0
  have hKm' : Measurable (fun w : (ℝ × ℝ) × (ℝ × ℝ) => ENNReal.ofReal (K0 * mfkK h q w.1 w.2)) :=
    hKm
  rw [mfk_tri_fourier hA c q h1 h2]
  calc _ ≤ ∫⁻ w : (ℝ × ℝ) × (ℝ × ℝ), ‖mfkF2 G₁ w.1 * mfkF2 G₂ w.2 * mfkPhi A c q w.1 w.2‖ₑ :=
        enorm_integral_le_lintegral_enorm _
    _ ≤ ∫⁻ w : (ℝ × ℝ) × (ℝ × ℝ), ‖mfkF2 G₁ w.1‖ₑ * ‖mfkF2 G₂ w.2‖ₑ *
          ENNReal.ofReal (K0 * mfkK h q w.1 w.2) := by
        apply lintegral_mono
        intro w
        dsimp only; rw [enorm_mul, enorm_mul]
        gcongr
        exact mfk_phi_le_K hΛ hh hA c q w.1 w.2
    _ = ∫⁻ ξ, ∫⁻ η, ‖mfkF2 G₁ ξ‖ₑ * ‖mfkF2 G₂ η‖ₑ * ENNReal.ofReal (K0 * mfkK h q ξ η) := by
        rw [show (volume : Measure ((ℝ × ℝ) × (ℝ × ℝ))) = volume.prod volume from rfl,
          lintegral_prod (fun w : (ℝ × ℝ) × (ℝ × ℝ) => ‖mfkF2 G₁ w.1‖ₑ * ‖mfkF2 G₂ w.2‖ₑ *
            ENNReal.ofReal (K0 * mfkK h q w.1 w.2)) (((hm1.enorm.comp measurable_fst).mul
            (hm2.enorm.comp measurable_snd)).mul hKm').aemeasurable]
    _ ≤ (∫⁻ ξ, ‖mfkF2 G₁ ξ‖ₑ ^ 2 * (ENNReal.ofReal (mfkC Λ qhi * h) *
            ENNReal.ofReal ((1 + |h * (ξ.1 - q * ξ.2)|) ^ (-8 : ℝ)))) ^ (1 / 2 : ℝ) *
        (∫⁻ η, ‖mfkF2 G₂ η‖ₑ ^ 2 * (ENNReal.ofReal (mfkC Λ qhi * h) *
            ENNReal.ofReal ((1 + |h * (η.1 - q * η.2)|) ^ (-8 : ℝ)))) ^ (1 / 2 : ℝ) :=
        mfk_schur hm1.enorm hm2.enorm hKm (mfk_row_full hΛ hh hq hqq) (mfk_col_full hΛ hh hq hqq)
    _ = _ := by
        simp_rw [mul_left_comm (‖_‖ₑ ^ 2) (ENNReal.ofReal (mfkC Λ qhi * h))]
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
          lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
          mfk_const_split _ _ _ ]
        rfl

end

