    (HL2 : ∀ (q : ℝ × ℝ) (u₁ u₂ : ℝ × ℝ → ℂ), Measurable u₁ → Measurable u₂ →
        eLpNorm u₁ 2 volume ≠ ⊤ → eLpNorm u₂ 2 volume ≠ ⊤ →
