theorem mfk_lint_after_pointwise {h C : ℝ} (hh : 0 < h) (hC : 0 ≤ C) (f : ℝ × ℝ → ℝ)
    (hf : ∀ η : ℝ × ℝ, f η ≤ C * (((1 + h * |η.1|) ^ 2)⁻¹ * ((1 + h * |η.2|) ^ 2)⁻¹)) :
    ∫⁻ η, ENNReal.ofReal (f η) ≤ ENNReal.ofReal (C * (h⁻¹ * mfkJ) ^ 2) := by
  calc ∫⁻ η, ENNReal.ofReal (f η)
      ≤ ∫⁻ η : ℝ × ℝ, ENNReal.ofReal C *
          ENNReal.ofReal (((1 + h * |η.1|) ^ 2)⁻¹ * ((1 + h * |η.2|) ^ 2)⁻¹) := by
        apply lintegral_mono
        intro η
        dsimp only; rw [← ENNReal.ofReal_mul hC]
        exact ENNReal.ofReal_le_ofReal (hf η)
    _ = ENNReal.ofReal C * ENNReal.ofReal ((h⁻¹ * mfkJ) ^ 2) := by
        rw [lintegral_const_mul _ (by fun_prop), mfk_lint_2d hh]
    _ = _ := by rw [← ENNReal.ofReal_mul hC]

theorem mfk_row {h q M : ℝ} (hh : 0 < h) (hq : 0 ≤ q) (hqM : q ≤ M) (hM : 1 ≤ M) (ξ : ℝ × ℝ) :
    ∫⁻ η, ENNReal.ofReal (mfkK h q ξ η)
      ≤ ENNReal.ofReal ((2 * M) ^ 8 * mfkW (h * (ξ.1 - q * ξ.2)) * (h⁻¹ * mfkJ) ^ 2) := by
  rw [← lintegral_sub_right_eq_self _ ξ]
  apply mfk_lint_after_pointwise hh (by unfold mfkW; positivity)
  intro η
  have hk : mfkK h q ξ (η - ξ) =
      ((1 + h * |η.1| + h * |η.2| + h * |ξ.1 + q * (η.2 - ξ.2)|) ^ 12)⁻¹ := by
    simp only [mfkK, Prod.fst_sub, Prod.snd_sub, add_sub_cancel]
  rw [hk]
  have hU : |h * (ξ.1 - q * ξ.2)| ≤ h * |ξ.1 + q * (η.2 - ξ.2)| + M * (h * |η.1| + h * |η.2|) := by
    have e : h * (ξ.1 - q * ξ.2) = h * (ξ.1 + q * (η.2 - ξ.2)) - q * (h * η.2) := by ring
    rw [e]
    refine (abs_sub _ _).trans ?_
    rw [abs_mul, abs_mul, abs_mul, abs_of_pos hh, abs_of_nonneg hq]
    have : q * (h * |η.2|) ≤ M * (h * |η.1| + h * |η.2|) := by
      have h1 : 0 ≤ h * |η.1| := by positivity
      have h2 : 0 ≤ h * |η.2| := by positivity
      nlinarith
    linarith
  have := mfk_pointwise (by positivity) (by positivity) (by positivity) hM hU
  refine this.trans (le_of_eq ?_)
  ring

theorem mfk_col {h q M : ℝ} (hh : 0 < h) (hq : 0 ≤ q) (hqM : q ≤ M) (hM : 1 ≤ M) (η : ℝ × ℝ) :
    ∫⁻ ξ, ENNReal.ofReal (mfkK h q ξ η)
      ≤ ENNReal.ofReal ((2 * M) ^ 8 * mfkW (h * (η.1 - q * η.2)) * (h⁻¹ * mfkJ) ^ 2) := by
  rw [← lintegral_sub_right_eq_self _ η]
  apply mfk_lint_after_pointwise hh (by unfold mfkW; positivity)
  intro ξ
  have hk : mfkK h q (ξ - η) η =
      ((1 + h * |ξ.1| + h * |ξ.2| + h * |ξ.1 - η.1 + q * η.2|) ^ 12)⁻¹ := by
    simp only [mfkK, Prod.fst_sub, Prod.snd_sub, sub_add_cancel]
  rw [hk]
  have hU : |h * (η.1 - q * η.2)| ≤ h * |ξ.1 - η.1 + q * η.2| + M * (h * |ξ.1| + h * |ξ.2|) := by
    have e : h * (η.1 - q * η.2) = h * ξ.1 - h * (ξ.1 - η.1 + q * η.2) := by ring
    rw [e]
    refine (abs_sub _ _).trans ?_
    rw [abs_mul, abs_mul, abs_of_pos hh]
    have : h * |ξ.1| ≤ M * (h * |ξ.1| + h * |ξ.2|) := by
      have h1 : 0 ≤ h * |ξ.1| := by positivity
      have h2 : 0 ≤ h * |ξ.2| := by positivity
      nlinarith
    linarith
  have := mfk_pointwise (by positivity) (by positivity) (by positivity) hM hU
  refine this.trans (le_of_eq ?_)
  ring

end

