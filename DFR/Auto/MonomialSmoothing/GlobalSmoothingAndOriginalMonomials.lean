/-- Smooth compactly supported functions on the plane. -/
structure MfkNice (G : ℝ × ℝ → ℂ) : Prop where
  cpt : HasCompactSupport G
  smooth : ContDiff ℝ ∞ G

namespace MfkNice

variable {G : ℝ × ℝ → ℂ}

theorem continuous (hG : MfkNice G) : Continuous G := hG.smooth.continuous

theorem integrable (hG : MfkNice G) : Integrable G :=
  hG.continuous.integrable_of_hasCompactSupport hG.cpt

theorem memLp (hG : MfkNice G) : MemLp G 2 volume := hG.continuous.memLp_of_hasCompactSupport hG.cpt

theorem measurable (hG : MfkNice G) : Measurable G := hG.continuous.measurable

theorem euclid_cpt (hG : MfkNice G) : HasCompactSupport (fun x => G (smoothingPlaneEquiv x)) :=
  hG.cpt.comp_homeomorph smoothingPlaneEquiv.toHomeomorph

theorem euclid_smooth (hG : MfkNice G) : ContDiff ℝ ∞ (fun x => G (smoothingPlaneEquiv x)) :=
  hG.smooth.comp smoothingPlaneEquiv.contDiff

/-- The Schwartz function attached to `G`. -/
def schwartz (hG : MfkNice G) : SchwartzMap (EuclideanSpace ℝ (Fin 2)) ℂ :=
  hG.euclid_cpt.toSchwartzMap hG.euclid_smooth

theorem schwartz_coe (hG : MfkNice G) :
    (hG.schwartz : EuclideanSpace ℝ (Fin 2) → ℂ) = fun x => G (smoothingPlaneEquiv x) := rfl

theorem fourier_integrable (hG : MfkNice G) :
    Integrable (𝓕 (fun x => G (smoothingPlaneEquiv x))) := by
  rw [← hG.schwartz_coe, ← SchwartzMap.fourier_coe]
  exact (𝓕 hG.schwartz).integrable

theorem mfkF2_integrable (hG : MfkNice G) : Integrable (mfkF2 G) := by
  have h := mfk_plane_mp.symm.integrable_comp_of_integrable hG.fourier_integrable
  refine h.congr (Eventually.of_forall (fun ξ => ?_))
  rw [mfkF2_eq_fourier]
  rfl

theorem inversion (hG : MfkNice G) (z : ℝ × ℝ) :
    G z = ∫ ξ : ℝ × ℝ, Complex.exp (2 * Real.pi * Complex.I * (z.1 * ξ.1 + z.2 * ξ.2)) * mfkF2 G ξ
      := by
  have hinv := (hG.euclid_smooth.continuous).fourierInv_fourier_eq
    (hG.euclid_smooth.continuous.integrable_of_hasCompactSupport hG.euclid_cpt)
      hG.fourier_integrable
  have h1 : G z = (fun x => G (smoothingPlaneEquiv x)) (smoothingPlaneEquiv.symm z) :=
    by simp
  rw [h1, ← hinv, Real.fourierInv_eq]
  rw [← mfk_plane_mp.symm.integral_comp']
  congr 1; ext ξ
  change Real.fourierChar (inner ℝ (smoothingPlaneEquiv.symm ξ) (smoothingPlaneEquiv.symm z)) •
    𝓕 (fun x => G (smoothingPlaneEquiv x)) (smoothingPlaneEquiv.symm ξ) = _
  rw [Circle.smul_def, smul_eq_mul, Real.fourierChar_apply, mfk_inner_plane, ← mfkF2_eq_fourier]
  congr 2
  push_cast; ring

end MfkNice

