theorem ms8_fourier_multK {ϑ : ℝ → ℝ} (hs : ContDiff ℝ ∞ ϑ) (hc : HasCompactSupport ϑ) (ξ : ℝ) :
    𝓕 (⇑(monoMultK hs hc)) ξ = (ϑ ξ : ℂ) := by
  have h : 𝓕 (monoMultK hs hc) = monoMultS hs hc := fourier_fourierInv_eq _
