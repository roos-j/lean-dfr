/-! ### Young's inequality for coordinate convolutions, kernel integrals -/
theorem ms7_meas_shift (j : Fin 2) :
    Measurable fun q : (ℝ × ℝ) × ℝ => q.1 - monoEj j q.2 := by
  unfold monoEj
  exact measurable_fst.sub ((measurable_monoPt j).comp (measurable_snd.prodMk measurable_const))

/-- Jensen/Hölder: `(∫ k G)^p ≤ (∫ k)^(p-1) ∫ k G^p`. -/
theorem ms7_jensen {p : ℝ} (hp : 1 < p) {k G : ℝ → ℝ≥0∞} (hk : Measurable k) (hG : Measurable G) :
    (∫⁻ s, k s * G s) ^ p ≤ (∫⁻ s, k s) ^ (p - 1) * ∫⁻ s, k s * G s ^ p := by
  have hp0 : 0 < p := by linarith
  have ha : 0 ≤ 1 - 1 / p := by
    rw [sub_nonneg, div_le_one hp0]; exact hp.le
  have hb : 0 ≤ 1 / p := by positivity
  have key : ∀ s, k s * G s = k s ^ (1 - 1 / p) * (k s * G s ^ p) ^ (1 / p) := by
    intro s
    rw [ENNReal.mul_rpow_of_nonneg _ _ hb, one_div, ENNReal.rpow_rpow_inv hp0.ne', ← mul_assoc,
      ← ENNReal.rpow_add_of_nonneg _ _ (by rw [← one_div]; exact ha) (by positivity)]
    simp
  have h1 : ∫⁻ s, k s * G s ≤ (∫⁻ s, k s) ^ (1 - 1 / p) * (∫⁻ s, k s * G s ^ p) ^ (1 / p) := by
    simp_rw [key]
    exact ENNReal.lintegral_mul_norm_pow_le hk.aemeasurable
      (hk.mul (hG.pow_const p)).aemeasurable ha hb (by ring)
  calc (∫⁻ s, k s * G s) ^ p
      ≤ ((∫⁻ s, k s) ^ (1 - 1 / p) * (∫⁻ s, k s * G s ^ p) ^ (1 / p)) ^ p :=
        ENNReal.rpow_le_rpow h1 hp0.le
    _ = (∫⁻ s, k s) ^ (p - 1) * ∫⁻ s, k s * G s ^ p := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul]
        congr 2
        · field_simp
        · field_simp; simp

/-- **Young's inequality** for a coordinate convolution with a nonnegative kernel. -/
theorem ms7_young (j : Fin 2) {p : ℝ} (hp : 1 < p) {k : ℝ → ℝ≥0∞} (hk : Measurable k)
    {g : ℝ × ℝ → ℝ≥0∞} (hg : Measurable g) :
    ∫⁻ z, (∫⁻ s, k s * g (z - monoEj j s)) ^ p ≤ (∫⁻ s, k s) ^ p * ∫⁻ z, g z ^ p := by
  have hsh := ms7_meas_shift j
  calc ∫⁻ z, (∫⁻ s, k s * g (z - monoEj j s)) ^ p
      ≤ ∫⁻ z, (∫⁻ s, k s) ^ (p - 1) * ∫⁻ s, k s * g (z - monoEj j s) ^ p :=
        lintegral_mono fun z => ms7_jensen hp hk (hg.comp (measurable_const.sub
          ((measurable_monoPt j).comp (measurable_id.prodMk measurable_const))))
    _ = (∫⁻ s, k s) ^ (p - 1) * ∫⁻ s, ∫⁻ z, k s * g (z - monoEj j s) ^ p := by
        rw [lintegral_const_mul]
        · rw [lintegral_lintegral_swap]
          exact ((hk.comp measurable_snd).mul ((hg.comp hsh).pow_const p)).aemeasurable
        · exact ((hk.comp measurable_snd).mul ((hg.comp hsh).pow_const p)).lintegral_prod_right'
    _ = (∫⁻ s, k s) ^ (p - 1) * ∫⁻ s, k s * ∫⁻ z, g z ^ p := by
        congr 1
        refine lintegral_congr fun s => ?_
        rw [lintegral_const_mul]
        · congr 1
          exact lintegral_sub_right_eq_self (fun z => g z ^ p) (monoEj j s)
        · exact (hg.comp (measurable_id.sub_const _)).pow_const p
    _ = (∫⁻ s, k s) ^ p * ∫⁻ z, g z ^ p := by
        rw [lintegral_mul_const _ hk, ← mul_assoc]
        congr 1
        conv_rhs => rw [show p = (p - 1) + 1 by ring]
        rw [ENNReal.rpow_add_of_nonneg _ _ (by linarith) zero_le_one, ENNReal.rpow_one]

/-- Young's inequality in `eLpNorm` form, for any function dominated by a convolution. -/
theorem ms7_young_eLp (j : Fin 2) {p : ℝ≥0∞} (hp : 1 < p.toReal) {k : ℝ → ℝ≥0∞}
    (hk : Measurable k) {g : ℝ × ℝ → ℝ≥0∞} (hg : Measurable g) {F : ℝ × ℝ → ℂ}
    (hF : ∀ z, ‖F z‖ₑ ≤ ∫⁻ s, k s * g (z - monoEj j s))
    (hFm : AEStronglyMeasurable F volume := by fun_prop) :
    eLpNorm F p volume ≤ (∫⁻ s, k s) * (∫⁻ z, g z ^ p.toReal) ^ (1 / p.toReal) := by
  have hp0 : p ≠ 0 := by rintro rfl; simp at hp; linarith
  have hpt : p ≠ ⊤ := by rintro rfl; simp at hp; linarith
  have hpr : 0 < p.toReal := by linarith
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hpt (by fun_prop)]
  calc (∫⁻ z, ‖F z‖ₑ ^ p.toReal) ^ (1 / p.toReal)
      ≤ (∫⁻ z, (∫⁻ s, k s * g (z - monoEj j s)) ^ p.toReal) ^ (1 / p.toReal) := by
        gcongr with z; exact hF z
    _ ≤ ((∫⁻ s, k s) ^ p.toReal * ∫⁻ z, g z ^ p.toReal) ^ (1 / p.toReal) := by
        gcongr; exact ms7_young j hp hk hg
    _ = _ := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), one_div,
          ENNReal.rpow_rpow_inv hpr.ne']

theorem ms7_eLpNorm_eq_enorm {p : ℝ≥0∞} (hp : 1 < p.toReal) (u : ℝ × ℝ → ℂ)
    (hu : AEStronglyMeasurable u volume := by fun_prop) :
    (∫⁻ z, ‖u z‖ₑ ^ p.toReal) ^ (1 / p.toReal) = eLpNorm u p volume := by
  have hp0 : p ≠ 0 := by rintro rfl; simp at hp; linarith
  have hpt : p ≠ ⊤ := by rintro rfl; simp at hp; linarith
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hpt (by fun_prop)]

/-- Pointwise bound for the coordinate convolution. -/
theorem ms7_enorm_P_le (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L : ℝ) (u : ℝ × ℝ → ℂ) (z : ℝ × ℝ) :
    ‖monoP j κ L u z‖ₑ ≤ ∫⁻ s, ‖(L : ℂ) * κ (L * s)‖ₑ * ‖u (z - monoEj j s)‖ₑ := by
  unfold monoP monoCConv
  refine (enorm_integral_le_lintegral_enorm _).trans (le_of_eq ?_)
  simp only [enorm_mul]

/-- Change of variables `s ↦ L s`. -/
theorem ms7_lint_comp_mul {L : ℝ} (hL : 0 < L) {f : ℝ → ℝ≥0∞} (hf : Measurable f) :
    ∫⁻ s, f (L * s) = ENNReal.ofReal L⁻¹ * ∫⁻ s, f s := by
  rw [← lintegral_map hf (measurable_const_mul L), Real.map_volume_mul_left hL.ne',
    lintegral_smul_measure, abs_of_pos (inv_pos.2 hL), smul_eq_mul]

theorem ms7_enorm_K (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L) (s : ℝ) :
    ‖(L : ℂ) * κ (L * s)‖ₑ = ENNReal.ofReal L * ‖κ (L * s)‖ₑ := by
  rw [enorm_mul, monoEnorm_ofReal, Real.enorm_eq_ofReal hL.le]

theorem ms7_kerL1 (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L) :
    ∫⁻ s, ‖(L : ℂ) * κ (L * s)‖ₑ = ∫⁻ s, ‖κ s‖ₑ := by
  simp_rw [ms7_enorm_K κ hL]
  rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
    ms7_lint_comp_mul hL κ.continuous.measurable.enorm, ← mul_assoc,
    ← ENNReal.ofReal_mul hL.le, mul_inv_cancel₀ hL.ne', ENNReal.ofReal_one, one_mul]

theorem ms7_kerL1_lt_top (κ : 𝓢(ℝ, ℂ)) : ∫⁻ s, ‖κ s‖ₑ < ⊤ :=
  (κ.integrable (μ := volume)).hasFiniteIntegral

/-- Young in `L^p` for `monoP`. -/
theorem ms7_P_young (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L) {p : ℝ≥0∞}
    (hp : 1 < p.toReal) {u : ℝ × ℝ → ℂ} (hu : Measurable u) :
    eLpNorm (monoP j κ L u) p volume ≤ (∫⁻ s, ‖κ s‖ₑ) * eLpNorm u p volume := by
  rw [← ms7_kerL1 κ hL, ← ms7_eLpNorm_eq_enorm hp u]
  exact ms7_young_eLp j hp ((ms7_measK κ L).enorm) hu.enorm (ms7_enorm_P_le j κ L u)

/-- The first absolute moment of a Schwartz kernel. -/
def ms7M1 (κ : 𝓢(ℝ, ℂ)) : ℝ := ∫ x, |x| * ‖κ x‖

theorem ms7_M1_integrable (κ : 𝓢(ℝ, ℂ)) : Integrable (fun x : ℝ => |x| * ‖κ x‖) volume := by
  have h := κ.integrable_pow_mul (μ := volume) 1
  refine h.congr (Eventually.of_forall fun x => ?_)
  simp [Real.norm_eq_abs]

theorem ms7_M1_nonneg (κ : 𝓢(ℝ, ℂ)) : 0 ≤ ms7M1 κ :=
  integral_nonneg fun _ => mul_nonneg (abs_nonneg _) (norm_nonneg _)

/-- The tail kernel `1_{|s| ≥ R} |L κ(L s)|`. -/
def ms7Tail (κ : 𝓢(ℝ, ℂ)) (L R : ℝ) (s : ℝ) : ℝ≥0∞ :=
  {s : ℝ | R ≤ |s|}.indicator (fun s => ‖(L : ℂ) * κ (L * s)‖ₑ) s

theorem ms7_measTail (κ : 𝓢(ℝ, ℂ)) (L R : ℝ) : Measurable (ms7Tail κ L R) :=
  (ms7_measK κ L).enorm.indicator (measurableSet_le measurable_const (by fun_prop))

theorem ms7_tail_le (κ : 𝓢(ℝ, ℂ)) {L R : ℝ} (hL : 1 / 2 ≤ L) (hR : 0 < R) :
    ∫⁻ s, ms7Tail κ L R s ≤ ENNReal.ofReal (2 * ms7M1 κ / R) := by
  have hL0 : 0 < L := by linarith
  have hmeas : Measurable fun x : ℝ => ENNReal.ofReal |x| * ‖κ x‖ₑ :=
    (by fun_prop : Measurable fun x : ℝ => ENNReal.ofReal |x|).mul κ.continuous.measurable.enorm
  have hpt : ∀ s, ms7Tail κ L R s ≤
      ENNReal.ofReal R⁻¹ * (ENNReal.ofReal |L * s| * ‖κ (L * s)‖ₑ) := by
    intro s
    unfold ms7Tail
    by_cases hs : R ≤ |s|
    · rw [indicator_of_mem (show s ∈ {s : ℝ | R ≤ |s|} from hs), ms7_enorm_K κ hL0, ← mul_assoc,
        ← ENNReal.ofReal_mul (inv_nonneg.2 hR.le)]
      gcongr
      rw [abs_mul, abs_of_pos hL0, ← mul_assoc, mul_comm _ L, mul_assoc]
      refine le_mul_of_one_le_right hL0.le ?_
      rw [le_inv_mul_iff₀ hR, mul_one]; exact hs
    · rw [indicator_of_notMem (show s ∉ {s : ℝ | R ≤ |s|} from hs)]; exact bot_le
  calc ∫⁻ s, ms7Tail κ L R s
      ≤ ∫⁻ s, ENNReal.ofReal R⁻¹ * (ENNReal.ofReal |L * s| * ‖κ (L * s)‖ₑ) := lintegral_mono hpt
    _ = ENNReal.ofReal R⁻¹ * (ENNReal.ofReal L⁻¹ * ∫⁻ x, ENNReal.ofReal |x| * ‖κ x‖ₑ) := by
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
          ms7_lint_comp_mul hL0 hmeas]
    _ = ENNReal.ofReal R⁻¹ * (ENNReal.ofReal L⁻¹ * ENNReal.ofReal (ms7M1 κ)) := by
        congr 2
        rw [ms7M1, ofReal_integral_eq_lintegral_ofReal (ms7_M1_integrable κ)
          (Eventually.of_forall fun x => mul_nonneg (abs_nonneg _) (norm_nonneg _))]
        refine lintegral_congr fun x => ?_
        rw [ENNReal.ofReal_mul (abs_nonneg _), ofReal_norm]
    _ ≤ ENNReal.ofReal (2 * ms7M1 κ / R) := by
        rw [← ENNReal.ofReal_mul (inv_nonneg.2 hL0.le), ← ENNReal.ofReal_mul (inv_nonneg.2 hR.le)]
        refine ENNReal.ofReal_le_ofReal ?_
        have : L⁻¹ ≤ 2 := by rw [inv_le_comm₀ hL0 two_pos]; linarith
        have hm := ms7_M1_nonneg κ
        rw [div_eq_inv_mul]
        exact mul_le_mul_of_nonneg_left (by nlinarith [mul_le_mul_of_nonneg_right this hm])
          (inv_nonneg.2 hR.le)

end

