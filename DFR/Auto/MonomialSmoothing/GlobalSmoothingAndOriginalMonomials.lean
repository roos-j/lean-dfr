/-! ### Lc16: bilinear expansion over the compatible pairs -/

section

variable {r A B : ℝ} {ψ : ℝ → ℝ}

theorem mlc_meas_integrand (hr : 0 < r) (hψm : Measurable ψ) {u₁ u₂ : ℝ × ℝ → ℂ}
    (hu₁ : Measurable u₁) (hu₂ : Measurable u₂) :
    Measurable (fun p : (ℝ × ℝ) × ℝ => (ψ p.2 : ℂ) * (u₁ (p.1.1 + p.2, p.1.2) * u₂ (p.1.1, p.1.2 +
      monoQ r p.2))) :=
  (Complex.measurable_ofReal.comp (hψm.comp measurable_snd)).mul
    ((hu₁.comp measurable_monoShift1).mul (hu₂.comp (measurable_monoShift2 hr)))

theorem mlc_meas_monoT (hr : 0 < r) (hψm : Measurable ψ) {u₁ u₂ : ℝ × ℝ → ℂ}
    (hu₁ : Measurable u₁) (hu₂ : Measurable u₂) : Measurable (monoT r ψ u₁ u₂) :=
  ((mlc_meas_integrand hr hψm hu₁ hu₂).stronglyMeasurable.integral_prod_right'
    (ν := (volume : Measure ℝ))).measurable

theorem mlc_integrable_integrand (hr : 0 < r) (hψm : Measurable ψ) (hψ1 : ∀ t, |ψ t| ≤ 1)
    (hψs : ∀ t, ψ t ≠ 0 → t ∈ Icc A B) {u₁ u₂ : ℝ × ℝ → ℂ} (hu₁ : Measurable u₁)
    (hu₂ : Measurable u₂) {B₁ B₂ : ℝ} (hb₁ : ∀ z, ‖u₁ z‖ ≤ B₁) (hb₂ : ∀ z, ‖u₂ z‖ ≤ B₂)
    (z : ℝ × ℝ) :
    Integrable (fun t => (ψ t : ℂ) * (u₁ (z.1 + t, z.2) * u₂ (z.1, z.2 + monoQ r t))) := by
  have hB₁ : 0 ≤ B₁ := (norm_nonneg _).trans (hb₁ 0)
  refine mlc_integrable_of_bdd measurableSet_Icc (measure_Icc_lt_top (a := A) (b := B)).ne
    ((mlc_meas_integrand hr hψm hu₁ hu₂).comp (measurable_const.prodMk
      measurable_id)).aestronglyMeasurable
    (M := B₁ * B₂) (fun t => ?_) (fun t ht => ?_)
  · rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs]
    calc |ψ t| * (‖u₁ (z.1 + t, z.2)‖ * ‖u₂ (z.1, z.2 + monoQ r t)‖) ≤ 1 * (B₁ * B₂) := by
          gcongr
          · exact hψ1 t
          · exact hb₁ _
          · exact hb₂ _
      _ = _ := one_mul _
  · refine hψs t fun h0 => ht ?_
    simp [h0]

/-- `T` is bilinear over finite sums. -/
theorem mlc_monoT_sum (hr : 0 < r) (hψm : Measurable ψ) (hψ1 : ∀ t, |ψ t| ≤ 1)
    (hψs : ∀ t, ψ t ≠ 0 → t ∈ Icc A B) (M₁ M₂ : Finset (ℤ × ℤ)) (v₁ v₂ : ℤ × ℤ → ℝ × ℝ → ℂ)
    (hv₁ : ∀ m, Measurable (v₁ m)) (hv₂ : ∀ m, Measurable (v₂ m)) {B₁ B₂ : ℝ}
    (hb₁ : ∀ m z, ‖v₁ m z‖ ≤ B₁) (hb₂ : ∀ m z, ‖v₂ m z‖ ≤ B₂) (z : ℝ × ℝ) :
    monoT r ψ (fun w => ∑ m ∈ M₁, v₁ m w) (fun w => ∑ n ∈ M₂, v₂ n w) z =
      ∑ m ∈ M₁, ∑ n ∈ M₂, monoT r ψ (v₁ m) (v₂ n) z := by
  unfold monoT
  have e : ∀ t, (ψ t : ℂ) * ((∑ m ∈ M₁, v₁ m (z.1 + t, z.2)) * (∑ n ∈ M₂, v₂ n (z.1, z.2 + monoQ r
    t)))
      = ∑ m ∈ M₁, ∑ n ∈ M₂, (ψ t : ℂ) * (v₁ m (z.1 + t, z.2) * v₂ n (z.1, z.2 + monoQ r t)) := by
    intro t
    rw [Finset.sum_mul_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun m _ => ?_
    rw [Finset.mul_sum]
  simp_rw [e]
  rw [integral_finsetSum _ (fun m _ => integrable_finsetSum _ (fun n _ =>
    mlc_integrable_integrand hr hψm hψ1 hψs (hv₁ m) (hv₂ n) (hb₁ m) (hb₂ n) z))]
  refine Finset.sum_congr rfl fun m _ => ?_
  rw [integral_finsetSum _ (fun n _ =>
    mlc_integrable_integrand hr hψm hψ1 hψs (hv₁ m) (hv₂ n) (hb₁ m) (hb₂ n) z)]

end

/-- Only compatible pairs contribute. -/
theorem mlc_noncompat_zero {r A B C0 h : ℝ} {χ : ℝ × ℝ → ℝ} {ψ : ℝ → ℝ}
    (hψs : ∀ t, ψ t ≠ 0 → t ∈ Icc A B) {u₁ u₂ : ℝ × ℝ → ℂ} {m n : ℤ × ℤ}
    (hl₁ : ∀ z, u₁ z ≠ 0 → |z.1 - h * m.1| ≤ C0 * h ∧ |z.2 - h * m.2| ≤ C0 * h)
    (hl₂ : ∀ z, u₂ z ≠ 0 → |z.1 - h * n.1| ≤ C0 * h ∧ |z.2 - h * n.2| ≤ C0 * h)
    (hnc : ¬ mlcCompat r A B C0 h χ m n) (z : ℝ × ℝ) :
    (χ z : ℂ) * monoT r ψ u₁ u₂ z = 0 := by
  by_contra hne
  have hχ : χ z ≠ 0 := by
    intro h0; apply hne; rw [h0, Complex.ofReal_zero, zero_mul]
  have hT : monoT r ψ u₁ u₂ z ≠ 0 := right_ne_zero_of_mul hne
  obtain ⟨t, ht⟩ : ∃ t, (ψ t : ℂ) * (u₁ (z.1 + t, z.2) * u₂ (z.1, z.2 + monoQ r t)) ≠ 0 := by
    by_contra hall
    push Not at hall
    apply hT
    unfold monoT
    simp [hall]
  simp only [ne_eq, mul_eq_zero, Complex.ofReal_eq_zero, not_or] at ht
  obtain ⟨h1, h2, h3⟩ := ht
  have htI := hψs t h1
  obtain ⟨e1, e2⟩ := hl₁ _ h2
  obtain ⟨e3, e4⟩ := hl₂ _ h3
  simp only at e1 e2 e3 e4
  apply hnc
  refine ⟨⟨z, hχ, e3, e2⟩, t, htI, ?_, ?_⟩
  · rw [abs_le] at e1 e3 ⊢; constructor <;> linarith
  · rw [abs_le] at e2 e4 ⊢; constructor <;> linarith

/-- **Step 0**: `‖χ T(∑v₁, ∑v₂)‖₁ ≤ ‖χ‖_∞ ∑_{compatible} ‖T(v₁m, v₂n)‖₁`. -/
theorem mlc_expand {r A B C0 h Mχ : ℝ} (hr : 0 < r) {χ : ℝ × ℝ → ℝ} (hχm : Measurable χ)
    (hχb : ∀ z, |χ z| ≤ Mχ) {ψ : ℝ → ℝ} (hψm : Measurable ψ) (hψ1 : ∀ t, |ψ t| ≤ 1)
    (hψs : ∀ t, ψ t ≠ 0 → t ∈ Icc A B) (M₁ M₂ : Finset (ℤ × ℤ)) (v₁ v₂ : ℤ × ℤ → ℝ × ℝ → ℂ)
    (hv₁ : ∀ m, Measurable (v₁ m)) (hv₂ : ∀ m, Measurable (v₂ m)) {B₁ B₂ : ℝ}
    (hb₁ : ∀ m z, ‖v₁ m z‖ ≤ B₁) (hb₂ : ∀ m z, ‖v₂ m z‖ ≤ B₂)
    (hl₁ : ∀ m z, v₁ m z ≠ 0 → |z.1 - h * m.1| ≤ C0 * h ∧ |z.2 - h * m.2| ≤ C0 * h)
    (hl₂ : ∀ m z, v₂ m z ≠ 0 → |z.1 - h * m.1| ≤ C0 * h ∧ |z.2 - h * m.2| ≤ C0 * h) :
    eLpNorm (fun z => (χ z : ℂ) *
        monoT r ψ (fun w => ∑ m ∈ M₁, v₁ m w) (fun w => ∑ n ∈ M₂, v₂ n w) z) 1 volume ≤
      ∑ p ∈ mlcP r A B C0 h χ M₁ M₂,
        ENNReal.ofReal Mχ * ∫⁻ z, ‖monoT r ψ (v₁ p.1) (v₂ p.2) z‖ₑ := by
  classical
  rw [eLpNorm_one_eq_lintegral_enorm (by fun_prop)]
  have hmT : ∀ m n, Measurable (monoT r ψ (v₁ m) (v₂ n)) := fun m n =>
    mlc_meas_monoT hr hψm (hv₁ m) (hv₂ n)
  have hmχT : ∀ m n, Measurable fun z => ‖(χ z : ℂ) * monoT r ψ (v₁ m) (v₂ n) z‖ₑ := fun m n =>
    ((Complex.measurable_ofReal.comp hχm).mul (hmT m n)).enorm
  calc ∫⁻ z, ‖(χ z : ℂ) * monoT r ψ (fun w => ∑ m ∈ M₁, v₁ m w) (fun w => ∑ n ∈ M₂, v₂ n w) z‖ₑ
      ≤ ∫⁻ z, ∑ m ∈ M₁, ∑ n ∈ M₂, ‖(χ z : ℂ) * monoT r ψ (v₁ m) (v₂ n) z‖ₑ := by
        refine lintegral_mono fun z => ?_
        rw [mlc_monoT_sum hr hψm hψ1 hψs M₁ M₂ v₁ v₂ hv₁ hv₂ hb₁ hb₂ z, Finset.mul_sum]
        refine (enorm_sum_le _ _).trans (Finset.sum_le_sum fun m _ => ?_)
        rw [Finset.mul_sum]
        exact enorm_sum_le _ _
    _ = ∑ m ∈ M₁, ∑ n ∈ M₂, ∫⁻ z, ‖(χ z : ℂ) * monoT r ψ (v₁ m) (v₂ n) z‖ₑ := by
        rw [lintegral_finsetSum _ (fun m _ => Finset.measurable_sum _ fun n _ => hmχT m n)]
        refine Finset.sum_congr rfl fun m _ => ?_
        rw [lintegral_finsetSum _ (fun n _ => hmχT m n)]
    _ ≤ ∑ m ∈ M₁, ∑ n ∈ M₂, if mlcCompat r A B C0 h χ m n then
          ENNReal.ofReal Mχ * ∫⁻ z, ‖monoT r ψ (v₁ m) (v₂ n) z‖ₑ else 0 := by
        refine Finset.sum_le_sum fun m _ => Finset.sum_le_sum fun n _ => ?_
        split_ifs with H
        · rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
          refine lintegral_mono fun z => ?_
          rw [enorm_mul, monoEnorm_ofReal, ← ofReal_norm, Real.norm_eq_abs]
          exact mul_le_mul' (ENNReal.ofReal_le_ofReal (hχb z)) le_rfl
        · have : ∀ z, (χ z : ℂ) * monoT r ψ (v₁ m) (v₂ n) z = 0 :=
            mlc_noncompat_zero hψs (hl₁ m) (hl₂ n) H
          simp [this]
    _ = _ := by
        rw [mlcP_sum_fst]
        refine Finset.sum_congr rfl fun m _ => ?_
        unfold mlcNm
        rw [Finset.sum_filter]

end

end Auto

