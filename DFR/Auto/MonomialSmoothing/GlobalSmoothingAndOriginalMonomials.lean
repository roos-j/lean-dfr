/-! ### Lc04: localized functions, multiplicative differences, weights -/

/-- `D^{(1)}_s u(w) = u(w + s e_1) \bar{u(w)}`. -/
def mlcD1 (u : ℝ × ℝ → ℂ) (s : ℝ) (w : ℝ × ℝ) : ℂ := u (w.1 + s, w.2) * star (u w)

/-- `D^{(2)}_s u(w) = u(w + s e_2) \bar{u(w)}`. -/
def mlcD2 (u : ℝ × ℝ → ℂ) (s : ℝ) (w : ℝ × ℝ) : ℂ := u (w.1, w.2 + s) * star (u w)

/-- The weight `w(h(ξ_1 - q ξ_2))`, `w(u) = (1+|u|)^{-8}`. -/
def mlcW (h q : ℝ) (ξ : ℝ × ℝ) : ℝ≥0∞ := ENNReal.ofReal ((1 + |h * (ξ.1 - q * ξ.2)|) ^ (-8 : ℝ))

/-- The weighted correlation energy of the first family. -/
def mlcX1 (h q : ℝ) (u : ℝ × ℝ → ℂ) : ℝ≥0∞ :=
  ∫⁻ s, ∫⁻ ξ, ‖mfkF2 (mlcD1 u s) ξ‖ₑ ^ 2 * mlcW h q ξ

/-- The weighted correlation energy of the second family. -/
def mlcX2 (h q : ℝ) (u : ℝ × ℝ → ℂ) : ℝ≥0∞ :=
  ∫⁻ s, ∫⁻ ξ, ‖mfkF2 (mlcD2 u s) ξ‖ₑ ^ 2 * mlcW h q ξ

/-- `u` is measurable, bounded by `B` and supported in the square of half side `R` at `(a,b)`. -/
def MlcLoc (u : ℝ × ℝ → ℂ) (B a b R : ℝ) : Prop :=
  Measurable u ∧ (∀ z, ‖u z‖ ≤ B) ∧ ∀ z, u z ≠ 0 → |z.1 - a| ≤ R ∧ |z.2 - b| ≤ R

def mlcBox (a b R : ℝ) : Set (ℝ × ℝ) := Icc (a - R) (a + R) ×ˢ Icc (b - R) (b + R)

theorem mlcBox_measurable (a b R : ℝ) : MeasurableSet (mlcBox a b R) :=
  measurableSet_Icc.prod measurableSet_Icc

theorem mlcBox_lt_top (a b R : ℝ) : volume (mlcBox a b R) < ⊤ :=
  (isCompact_Icc.prod isCompact_Icc).measure_lt_top

theorem mem_mlcBox {a b R : ℝ} {z : ℝ × ℝ} (h : |z.1 - a| ≤ R ∧ |z.2 - b| ≤ R) : z ∈ mlcBox a b R
  := by
  rw [abs_le, abs_le] at h
  exact ⟨⟨by linarith, by linarith⟩, ⟨by linarith, by linarith⟩⟩

theorem MlcLoc.eq_indicator {u : ℝ × ℝ → ℂ} {B a b R : ℝ} (hu : MlcLoc u B a b R) :
    (mlcBox a b R).indicator u = u := by
  funext z
  by_cases hz : u z = 0
  · simp [hz]
  · exact indicator_of_mem (mem_mlcBox (hu.2.2 z hz)) u

theorem MlcLoc.memLp {u : ℝ × ℝ → ℂ} {B a b R : ℝ} (hu : MlcLoc u B a b R) (p : ℝ≥0∞) :
    MemLp u p volume := by
  rw [← hu.eq_indicator, memLp_indicator_iff_restrict (mlcBox_measurable a b R)]
  have : IsFiniteMeasure (volume.restrict (mlcBox a b R)) :=
    isFiniteMeasure_restrict.mpr (mlcBox_lt_top a b R).ne
  exact MemLp.of_bound hu.1.aestronglyMeasurable B (Eventually.of_forall hu.2.1)

theorem MlcLoc.integrable {u : ℝ × ℝ → ℂ} {B a b R : ℝ} (hu : MlcLoc u B a b R) :
    Integrable u volume :=
  memLp_one_iff_integrable.mp (hu.memLp 1)

theorem MlcLoc.D1 {u : ℝ × ℝ → ℂ} {B a b R : ℝ} (hu : MlcLoc u B a b R) (s : ℝ) :
    MlcLoc (mlcD1 u s) (B * B) a b R := by
  refine ⟨?_, fun z => ?_, fun z hz => ?_⟩
  · unfold mlcD1
    exact (hu.1.comp ((measurable_fst.add_const s).prodMk measurable_snd)).mul
      (continuous_star.measurable.comp hu.1)
  · unfold mlcD1
    rw [norm_mul, norm_star]
    exact mul_le_mul (hu.2.1 _) (hu.2.1 _) (norm_nonneg _) ((norm_nonneg _).trans (hu.2.1 z))
  · unfold mlcD1 at hz
    refine hu.2.2 z fun h0 => hz ?_
    rw [h0, star_zero, mul_zero]

theorem MlcLoc.D2 {u : ℝ × ℝ → ℂ} {B a b R : ℝ} (hu : MlcLoc u B a b R) (s : ℝ) :
    MlcLoc (mlcD2 u s) (B * B) a b R := by
  refine ⟨?_, fun z => ?_, fun z hz => ?_⟩
  · unfold mlcD2
    exact (hu.1.comp (measurable_fst.prodMk (measurable_snd.add_const s))).mul
      (continuous_star.measurable.comp hu.1)
  · unfold mlcD2
    rw [norm_mul, norm_star]
    exact mul_le_mul (hu.2.1 _) (hu.2.1 _) (norm_nonneg _) ((norm_nonneg _).trans (hu.2.1 z))
  · unfold mlcD2 at hz
    refine hu.2.2 z fun h0 => hz ?_
    rw [h0, star_zero, mul_zero]

theorem mlc_meas_F2D1 {u : ℝ × ℝ → ℂ} (hu : Measurable u) :
    Measurable (fun p : ℝ × (ℝ × ℝ) => mfkF2 (mlcD1 u p.1) p.2) := by
  unfold mfkF2 mlcD1
  have hm : Measurable (fun q : (ℝ × (ℝ × ℝ)) × (ℝ × ℝ) =>
      Complex.exp (-(2 * Real.pi * Complex.I * (q.2.1 * q.1.2.1 + q.2.2 * q.1.2.2))) *
        (u (q.2.1 + q.1.1, q.2.2) * star (u q.2))) := by
    refine Measurable.mul (by fun_prop) ?_
    exact (hu.comp ((measurable_fst.comp measurable_snd |>.add (measurable_fst.comp
      measurable_fst)).prodMk (measurable_snd.comp measurable_snd))).mul
        (continuous_star.measurable.comp (hu.comp measurable_snd))
  exact (hm.stronglyMeasurable.integral_prod_right' (ν := (volume : Measure (ℝ × ℝ)))).measurable

theorem mlc_meas_F2D2 {u : ℝ × ℝ → ℂ} (hu : Measurable u) :
    Measurable (fun p : ℝ × (ℝ × ℝ) => mfkF2 (mlcD2 u p.1) p.2) := by
  unfold mfkF2 mlcD2
  have hm : Measurable (fun q : (ℝ × (ℝ × ℝ)) × (ℝ × ℝ) =>
      Complex.exp (-(2 * Real.pi * Complex.I * (q.2.1 * q.1.2.1 + q.2.2 * q.1.2.2))) *
        (u (q.2.1, q.2.2 + q.1.1) * star (u q.2))) := by
    refine Measurable.mul (by fun_prop) ?_
    exact (hu.comp ((measurable_fst.comp measurable_snd).prodMk ((measurable_snd.comp
      measurable_snd).add (measurable_fst.comp measurable_fst)))).mul
        (continuous_star.measurable.comp (hu.comp measurable_snd))
  exact (hm.stronglyMeasurable.integral_prod_right' (ν := (volume : Measure (ℝ × ℝ)))).measurable

theorem mlcW_measurable (h q : ℝ) : Measurable (mlcW h q) := by
  unfold mlcW
  exact ENNReal.measurable_ofReal.comp (by fun_prop)

theorem mlcW_le_one (h q : ℝ) (ξ : ℝ × ℝ) : mlcW h q ξ ≤ 1 := by
  unfold mlcW
  rw [ENNReal.ofReal_le_one]
  exact Real.rpow_le_one_of_one_le_of_nonpos (by linarith [abs_nonneg (h * (ξ.1 - q * ξ.2))])
    (by norm_num)

end

