section

open MeasureTheory Filter Topology Set
open scoped ENNReal

namespace Auto

noncomputable section

/-! ### Lc15: the totals `H_j` over the compatible pairs, (5.12)-(5.15) -/

/-- The global hypotheses of Lemma 5.1 used for the energy sums. -/
structure MlcGlob (r A B C0 h K Rχ : ℝ) (χ : ℝ × ℝ → ℝ) (v₁ v₂ : ℤ × ℤ → ℝ × ℝ → ℂ)
    (B₁ B₂ : ℝ) : Prop where
  hr : 1 < r
  hA : 0 < A
  hAB : A < B
  hC0 : 1 ≤ C0
  hh : 0 < h
  hh1 : h ≤ 1
  hK : 1 ≤ K
  hRχ0 : 0 ≤ Rχ
  hRχ : ∀ z, χ z ≠ 0 → |z.1| ≤ Rχ ∧ |z.2| ≤ Rχ
  loc₁ : ∀ m, MlcLoc (v₁ m) B₁ (h * m.1) (h * m.2) (C0 * h)
  loc₂ : ∀ n, MlcLoc (v₂ n) B₂ (h * n.1) (h * n.2) (C0 * h)
  en₁ : ∀ m, ∫⁻ y, (∫⁻ x, ‖v₁ m (x, y)‖ₑ ^ 2) ^ 2 ≤ ENNReal.ofReal (C0 * h ^ 3)
  en₂ : ∀ n, ∫⁻ x, (∫⁻ y, ‖v₂ n (x, y)‖ₑ ^ 2) ^ 2 ≤ ENNReal.ofReal (C0 * h ^ 3)

namespace MlcGlob

variable {r A B C0 h K Rχ : ℝ} {χ : ℝ × ℝ → ℝ} {v₁ v₂ : ℤ × ℤ → ℝ × ℝ → ℂ} {B₁ B₂ : ℝ}

theorem R0_nonneg (G : MlcGlob r A B C0 h K Rχ χ v₁ v₂ B₁ B₂) : 0 ≤ mlcR0 r B C0 Rχ := by
  unfold mlcR0
  have := mlc_Q_nonneg (r := r) (G.hA.le.trans G.hAB.le)
  have := G.hRχ0; have := G.hC0; have := G.hA; have := G.hAB
  linarith

/-- A sum over indices, supported on those with a partner, is at most `O(h^{-2})` times the
largest term. -/
theorem sum_relevant_fst (G : MlcGlob r A B C0 h K Rχ χ v₁ v₂ B₁ B₂) (M₁ M₂ : Finset (ℤ × ℤ))
    (f : ℤ × ℤ → ℝ≥0∞) {c : ℝ} (hc : 0 ≤ c)
    (hf : ∀ m ∈ M₁, (mlcNm r A B C0 h χ M₂ m).Nonempty → f m ≤ ENNReal.ofReal (c * h ^ 2))
    (hf0 : ∀ m ∈ M₁, ¬ (mlcNm r A B C0 h χ M₂ m).Nonempty → f m = 0) :
    ∑ m ∈ M₁, f m ≤ ENNReal.ofReal ((2 * mlcR0 r B C0 Rχ + 1) ^ 2 * c) := by
  classical
  set M₁' := M₁.filter fun m => (mlcNm r A B C0 h χ M₂ m).Nonempty
  have hsplit : ∑ m ∈ M₁, f m = ∑ m ∈ M₁', f m := by
    rw [Finset.sum_filter]
    refine Finset.sum_congr rfl fun m hm => ?_
    split_ifs with H
    · rfl
    · exact hf0 m hm H
  have hcard : (M₁'.card : ℝ) ≤ (2 * mlcR0 r B C0 Rχ + 1) ^ 2 / h ^ 2 := by
    refine mlc_card_relevant G.hh G.hh1 G.R0_nonneg M₁' fun m hm => ?_
    obtain ⟨n, hn⟩ := (Finset.mem_filter.mp hm).2
    exact (mlc_compat_bdd G.hr G.hA G.hC0 G.hh1 G.hRχ (mem_mlcNm.mp hn).2).1
  rw [hsplit]
  calc ∑ m ∈ M₁', f m ≤ ∑ m ∈ M₁', ENNReal.ofReal (c * h ^ 2) := Finset.sum_le_sum fun m hm =>
        hf m (Finset.mem_filter.mp hm).1 (Finset.mem_filter.mp hm).2
    _ = ENNReal.ofReal (M₁'.card * (c * h ^ 2)) := by
        rw [Finset.sum_const, nsmul_eq_mul, ENNReal.ofReal_mul (Nat.cast_nonneg _),
          ENNReal.ofReal_natCast]
    _ ≤ _ := by
        apply ENNReal.ofReal_le_ofReal
        have hh2 : 0 < h ^ 2 := by have := G.hh; positivity
        calc (M₁'.card : ℝ) * (c * h ^ 2) ≤ (2 * mlcR0 r B C0 Rχ + 1) ^ 2 / h ^ 2 * (c * h ^ 2) :=
          by
              gcongr
          _ = _ := by have := G.hh.ne'; field_simp

theorem sum_relevant_snd (G : MlcGlob r A B C0 h K Rχ χ v₁ v₂ B₁ B₂) (M₁ M₂ : Finset (ℤ × ℤ))
    (f : ℤ × ℤ → ℝ≥0∞) {c : ℝ} (hc : 0 ≤ c)
    (hf : ∀ n ∈ M₂, (mlcMn r A B C0 h χ M₁ n).Nonempty → f n ≤ ENNReal.ofReal (c * h ^ 2))
    (hf0 : ∀ n ∈ M₂, ¬ (mlcMn r A B C0 h χ M₁ n).Nonempty → f n = 0) :
    ∑ n ∈ M₂, f n ≤ ENNReal.ofReal ((2 * mlcR0 r B C0 Rχ + 1) ^ 2 * c) := by
  classical
  set M₂' := M₂.filter fun n => (mlcMn r A B C0 h χ M₁ n).Nonempty
  have hsplit : ∑ n ∈ M₂, f n = ∑ n ∈ M₂', f n := by
    rw [Finset.sum_filter]
    refine Finset.sum_congr rfl fun n hn => ?_
    split_ifs with H
    · rfl
    · exact hf0 n hn H
  have hcard : (M₂'.card : ℝ) ≤ (2 * mlcR0 r B C0 Rχ + 1) ^ 2 / h ^ 2 := by
    refine mlc_card_relevant G.hh G.hh1 G.R0_nonneg M₂' fun n hn => ?_
    obtain ⟨m, hm⟩ := (Finset.mem_filter.mp hn).2
    exact (mlc_compat_bdd G.hr G.hA G.hC0 G.hh1 G.hRχ (mem_mlcMn.mp hm).2).2
  rw [hsplit]
  calc ∑ n ∈ M₂', f n ≤ ∑ n ∈ M₂', ENNReal.ofReal (c * h ^ 2) := Finset.sum_le_sum fun n hn =>
        hf n (Finset.mem_filter.mp hn).1 (Finset.mem_filter.mp hn).2
    _ = ENNReal.ofReal (M₂'.card * (c * h ^ 2)) := by
        rw [Finset.sum_const, nsmul_eq_mul, ENNReal.ofReal_mul (Nat.cast_nonneg _),
          ENNReal.ofReal_natCast]
    _ ≤ _ := by
        apply ENNReal.ofReal_le_ofReal
        have hh2 : 0 < h ^ 2 := by have := G.hh; positivity
        calc (M₂'.card : ℝ) * (c * h ^ 2) ≤ (2 * mlcR0 r B C0 Rχ + 1) ^ 2 / h ^ 2 * (c * h ^ 2) :=
          by
              gcongr
          _ = _ := by have := G.hh.ne'; field_simp

/-- The partners of `m` have reference parameters in `[A,B]`. -/
theorem tb_mem_fst {r A B C0 h : ℝ} {χ : ℝ × ℝ → ℝ} {M₂ : Finset (ℤ × ℤ)} {m : ℤ × ℤ} :
    ∀ n ∈ mlcNm r A B C0 h χ M₂ m, mlcTb r A B C0 h m n ∈ Icc A B :=
  fun _ hn => (mlcTb_spec (mem_mlcNm.mp hn).2.2).1

theorem tb_mem_snd {r A B C0 h : ℝ} {χ : ℝ × ℝ → ℝ} {M₁ : Finset (ℤ × ℤ)} {n : ℤ × ℤ} :
    ∀ m ∈ mlcMn r A B C0 h χ M₁ n, mlcTb r A B C0 h m n ∈ Icc A B :=
  fun _ hm => (mlcTb_spec (mem_mlcMn.mp hm).2.2).1

/-- `H_1` for a uniform first family: `≤ C (ρ + h + 1/K)`. -/
theorem sumX1_unif (G : MlcGlob r A B C0 h K Rχ χ v₁ v₂ B₁ B₂) (M₁ M₂ : Finset (ℤ × ℤ)) {ρ : ℝ}
    (hρ : 0 < ρ)
    (hU : ∀ m, ∫⁻ y, monoU (K / h) (fun x => v₁ m (x, y)) ≤ ENNReal.ofReal (C0 * ρ * h ^ 3)) :
    ∑ p ∈ mlcP r A B C0 h χ M₁ M₂, mlcX1 h (monoq r (mlcTb r A B C0 h p.1 p.2)) (v₁ p.1) ≤
      ENNReal.ofReal ((2 * mlcR0 r B C0 Rχ + 1) ^ 2 *
        (2 * mlcCw r A B C0 * C0 * (ρ + h + 1 / K))) := by
  rw [mlcP_sum_fst]
  have hCw0 : 0 ≤ mlcCw r A B C0 :=
    (mul_nonneg (mlcM0_nonneg r B C0) (by linarith [G.hAB])).trans (mlcCw_ge G.hr G.hA G.hAB).1
  have hh := G.hh
  have hK0 : 0 < K := by linarith [G.hK]
  have hC0 := G.hC0
  refine G.sum_relevant_fst M₁ M₂ _ (by positivity) (fun m _ _ => ?_) (fun m _ H => ?_)
  · have hW := mlc_W1 G.hr G.hA G.hAB (mlcNm r A B C0 h χ M₂ m) (fun n => mlcTb r A B C0 h m n)
      tb_mem_fst G.hh G.hK (mlc_mult_fst G.hr G.hA G.hAB G.hC0 G.hh M₂ m)
      (mlc_card_Nm G.hr G.hA G.hAB G.hC0 G.hh G.hh1 M₂ m)
    refine (mlc_sum_X1_le (G.loc₁ m).1 _ _ h hW).trans ?_
    rw [mlc_split_weight (mlc_meas_F2D1 (G.loc₁ m).1) (by
      exact measurableSet_le (continuous_abs.measurable.comp measurable_fst) measurable_const)
        (by positivity) (by positivity)]
    rw [mlc_penergy1 (G.loc₁ m), mlc_energy1 (G.loc₁ m)]
    calc ENNReal.ofReal (mlcCw r A B C0 / h) * (∫⁻ y, monoU (K / h) (fun x => v₁ m (x, y))) +
          ENNReal.ofReal (mlcCw r A B C0 * (1 + 1 / (h * K))) *
            ∫⁻ y, (∫⁻ x, ‖v₁ m (x, y)‖ₑ ^ 2) ^ 2
        ≤ ENNReal.ofReal (mlcCw r A B C0 / h) * ENNReal.ofReal (C0 * ρ * h ^ 3) +
          ENNReal.ofReal (mlcCw r A B C0 * (1 + 1 / (h * K))) * ENNReal.ofReal (C0 * h ^ 3) := by
          gcongr
          · exact hU m
          · exact G.en₁ m
      _ = ENNReal.ofReal (mlcCw r A B C0 / h * (C0 * ρ * h ^ 3) +
            mlcCw r A B C0 * (1 + 1 / (h * K)) * (C0 * h ^ 3)) := by
          rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity),
            ← ENNReal.ofReal_add (by positivity) (by positivity)]
      _ ≤ ENNReal.ofReal (2 * mlcCw r A B C0 * C0 * (ρ + h + 1 / K) * h ^ 2) := by
          apply ENNReal.ofReal_le_ofReal
          have e1 : mlcCw r A B C0 / h * (C0 * ρ * h ^ 3) = mlcCw r A B C0 * C0 * ρ * h ^ 2 := by
            field_simp
          have e2 : mlcCw r A B C0 * (1 + 1 / (h * K)) * (C0 * h ^ 3) =
              mlcCw r A B C0 * C0 * (h + 1 / K) * h ^ 2 := by
            field_simp
          rw [e1, e2]
          have : 0 ≤ mlcCw r A B C0 * C0 * h ^ 2 := by positivity
          have : 0 ≤ ρ + h + 1 / K := by positivity
          nlinarith [mul_nonneg (mul_nonneg hCw0 (by linarith : (0:ℝ) ≤ C0)) (sq_nonneg h)]
  · rw [Finset.not_nonempty_iff_eq_empty] at H
    rw [H, Finset.sum_empty]

/-- `H_2` for a uniform second family. -/
theorem sumX2_unif (G : MlcGlob r A B C0 h K Rχ χ v₁ v₂ B₁ B₂) (M₁ M₂ : Finset (ℤ × ℤ)) {ρ : ℝ}
    (hρ : 0 < ρ)
    (hU : ∀ n, ∫⁻ x, monoU (K / h) (fun y => v₂ n (x, y)) ≤ ENNReal.ofReal (C0 * ρ * h ^ 3)) :
    ∑ p ∈ mlcP r A B C0 h χ M₁ M₂, mlcX2 h (monoq r (mlcTb r A B C0 h p.1 p.2)) (v₂ p.2) ≤
      ENNReal.ofReal ((2 * mlcR0 r B C0 Rχ + 1) ^ 2 *
        (2 * mlcCw r A B C0 * C0 * (ρ + h + 1 / K))) := by
  rw [mlcP_sum_snd]
  have hCw0 : 0 ≤ mlcCw r A B C0 :=
    (mul_nonneg (mlcM0_nonneg r B C0) (by linarith [G.hAB])).trans (mlcCw_ge G.hr G.hA G.hAB).1
  have hh := G.hh
  have hK0 : 0 < K := by linarith [G.hK]
  have hC0 := G.hC0
  refine G.sum_relevant_snd M₁ M₂ _ (by positivity) (fun n _ _ => ?_) (fun n _ H => ?_)
  · have hW := mlc_W2 G.hr G.hA G.hAB (mlcMn r A B C0 h χ M₁ n) (fun m => mlcTb r A B C0 h m n)
      tb_mem_snd G.hh G.hK (mlc_mult_snd G.hr G.hA G.hAB G.hC0 G.hh M₁ n)
      (mlc_card_Mn G.hr G.hA G.hAB G.hC0 G.hh G.hh1 M₁ n)
    refine (mlc_sum_X2_le (G.loc₂ n).1 _ _ h hW).trans ?_
    rw [mlc_split_weight (mlc_meas_F2D2 (G.loc₂ n).1) (by
      exact measurableSet_le (continuous_abs.measurable.comp measurable_snd) measurable_const)
        (by positivity) (by positivity)]
    rw [mlc_penergy2 (G.loc₂ n), mlc_energy2 (G.loc₂ n)]
    calc ENNReal.ofReal (mlcCw r A B C0 / h) * (∫⁻ x, monoU (K / h) (fun y => v₂ n (x, y))) +
          ENNReal.ofReal (mlcCw r A B C0 * (1 + 1 / (h * K))) *
            ∫⁻ x, (∫⁻ y, ‖v₂ n (x, y)‖ₑ ^ 2) ^ 2
        ≤ ENNReal.ofReal (mlcCw r A B C0 / h) * ENNReal.ofReal (C0 * ρ * h ^ 3) +
          ENNReal.ofReal (mlcCw r A B C0 * (1 + 1 / (h * K))) * ENNReal.ofReal (C0 * h ^ 3) := by
          gcongr
          · exact hU n
          · exact G.en₂ n
      _ = ENNReal.ofReal (mlcCw r A B C0 / h * (C0 * ρ * h ^ 3) +
            mlcCw r A B C0 * (1 + 1 / (h * K)) * (C0 * h ^ 3)) := by
          rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity),
            ← ENNReal.ofReal_add (by positivity) (by positivity)]
      _ ≤ ENNReal.ofReal (2 * mlcCw r A B C0 * C0 * (ρ + h + 1 / K) * h ^ 2) := by
          apply ENNReal.ofReal_le_ofReal
          have e1 : mlcCw r A B C0 / h * (C0 * ρ * h ^ 3) = mlcCw r A B C0 * C0 * ρ * h ^ 2 := by
            field_simp
          have e2 : mlcCw r A B C0 * (1 + 1 / (h * K)) * (C0 * h ^ 3) =
              mlcCw r A B C0 * C0 * (h + 1 / K) * h ^ 2 := by
            field_simp
          rw [e1, e2]
          have : 0 ≤ mlcCw r A B C0 * C0 * h ^ 2 := by positivity
          have : 0 ≤ ρ + h + 1 / K := by positivity
          nlinarith [mul_nonneg (mul_nonneg hCw0 (by linarith : (0:ℝ) ≤ C0)) (sq_nonneg h)]
  · rw [Finset.not_nonempty_iff_eq_empty] at H
    rw [H, Finset.sum_empty]

/-- `H_1` by the trivial partner count. -/
theorem sumX1_triv (G : MlcGlob r A B C0 h K Rχ χ v₁ v₂ B₁ B₂) (M₁ M₂ : Finset (ℤ × ℤ)) :
    ∑ p ∈ mlcP r A B C0 h χ M₁ M₂, mlcX1 h (monoq r (mlcTb r A B C0 h p.1 p.2)) (v₁ p.1) ≤
      ENNReal.ofReal ((2 * mlcR0 r B C0 Rχ + 1) ^ 2 * (mlcM0 r B C0 * (B - A + 2) * C0)) := by
  rw [mlcP_sum_fst]
  have hM := mlcM0_nonneg r B C0
  have hh := G.hh
  have hC0 := G.hC0
  have hBA : 0 ≤ B - A + 2 := by linarith [G.hAB]
  refine G.sum_relevant_fst M₁ M₂ _ (by positivity) (fun m _ _ => ?_) (fun m _ H => ?_)
  · have hW : ∀ ξ, ∑ n ∈ mlcNm r A B C0 h χ M₂ m, mlcw h (monoq r (mlcTb r A B C0 h m n)) ξ ≤
        mlcM0 r B C0 * (B - A + 2) / h := fun ξ =>
      (mlc_sum_w_le_card _ _ h ξ).trans (mlc_card_Nm G.hr G.hA G.hAB G.hC0 G.hh G.hh1 M₂ m)
    refine (mlc_sum_X1_le (G.loc₁ m).1 _ _ h hW).trans ?_
    rw [mlc_const_weight, mlc_energy1 (G.loc₁ m)]
    calc ENNReal.ofReal (mlcM0 r B C0 * (B - A + 2) / h) * ∫⁻ y, (∫⁻ x, ‖v₁ m (x, y)‖ₑ ^ 2) ^ 2
        ≤ ENNReal.ofReal (mlcM0 r B C0 * (B - A + 2) / h) * ENNReal.ofReal (C0 * h ^ 3) := by
          gcongr; exact G.en₁ m
      _ = ENNReal.ofReal (mlcM0 r B C0 * (B - A + 2) * C0 * h ^ 2) := by
          rw [← ENNReal.ofReal_mul (by positivity)]
          congr 1
          field_simp
  · rw [Finset.not_nonempty_iff_eq_empty] at H
    rw [H, Finset.sum_empty]

/-- `H_2` by the trivial partner count. -/
theorem sumX2_triv (G : MlcGlob r A B C0 h K Rχ χ v₁ v₂ B₁ B₂) (M₁ M₂ : Finset (ℤ × ℤ)) :
    ∑ p ∈ mlcP r A B C0 h χ M₁ M₂, mlcX2 h (monoq r (mlcTb r A B C0 h p.1 p.2)) (v₂ p.2) ≤
      ENNReal.ofReal ((2 * mlcR0 r B C0 Rχ + 1) ^ 2 * (mlcM0 r B C0 * (B - A + 2) * C0)) := by
  rw [mlcP_sum_snd]
  have hM := mlcM0_nonneg r B C0
  have hh := G.hh
  have hC0 := G.hC0
  have hBA : 0 ≤ B - A + 2 := by linarith [G.hAB]
  refine G.sum_relevant_snd M₁ M₂ _ (by positivity) (fun n _ _ => ?_) (fun n _ H => ?_)
  · have hW : ∀ ξ, ∑ m ∈ mlcMn r A B C0 h χ M₁ n, mlcw h (monoq r (mlcTb r A B C0 h m n)) ξ ≤
        mlcM0 r B C0 * (B - A + 2) / h := fun ξ =>
      (mlc_sum_w_le_card _ _ h ξ).trans (mlc_card_Mn G.hr G.hA G.hAB G.hC0 G.hh G.hh1 M₁ n)
    refine (mlc_sum_X2_le (G.loc₂ n).1 _ _ h hW).trans ?_
    rw [mlc_const_weight, mlc_energy2 (G.loc₂ n)]
    calc ENNReal.ofReal (mlcM0 r B C0 * (B - A + 2) / h) * ∫⁻ x, (∫⁻ y, ‖v₂ n (x, y)‖ₑ ^ 2) ^ 2
        ≤ ENNReal.ofReal (mlcM0 r B C0 * (B - A + 2) / h) * ENNReal.ofReal (C0 * h ^ 3) := by
          gcongr; exact G.en₂ n
      _ = ENNReal.ofReal (mlcM0 r B C0 * (B - A + 2) * C0 * h ^ 2) := by
          rw [← ENNReal.ofReal_mul (by positivity)]
          congr 1
          field_simp
  · rw [Finset.not_nonempty_iff_eq_empty] at H
    rw [H, Finset.sum_empty]

end MlcGlob

end

end Auto

