open MeasureTheory Filter Topology Set
open scoped ENNReal FourierTransform

namespace Auto

noncomputable section

theorem mfkF2_congr_ae {F F' : ℝ × ℝ → ℂ} (h : F =ᵐ[volume] F') : mfkF2 F = mfkF2 F' := by
  funext ξ
  apply integral_congr_ae
  filter_upwards [h] with z hz
  rw [hz]

theorem mfk_slices_congr_ae {F F' : ℝ × ℝ → ℂ} (h : F =ᵐ[volume] F') :
    ∀ᵐ y : ℝ, ∀ᵐ x : ℝ, F (x, y) = F' (x, y) := by
  have h' : ∀ᵐ z ∂(volume.prod volume : Measure (ℝ × ℝ)), F z = F' z := by
    rw [← Measure.volume_eq_prod]; exact h
  have hs := (Measure.measurePreserving_swap (μ := (volume : Measure ℝ))
    (ν := (volume : Measure ℝ))).quasiMeasurePreserving.ae h'
  exact Measure.ae_ae_of_ae_prod hs

theorem mfk_plancherel {F : ℝ × ℝ → ℂ} (h1 : Integrable F volume) (h2 : MemLp F 2 volume) :
    ∫⁻ ξ, ‖mfkF2 F ξ‖ₑ ^ 2 = ∫⁻ z, ‖F z‖ₑ ^ 2 := by
  set F' := h1.1.mk F
  have hae : F =ᵐ[volume] F' := h1.1.ae_eq_mk
  have hm : Measurable F' := h1.1.stronglyMeasurable_mk.measurable
  rw [mfkF2_congr_ae hae, mfk_plancherel_meas hm (h1.congr hae) (h2.ae_eq hae)]
  apply lintegral_congr_ae
  filter_upwards [hae] with z hz
  rw [hz]

theorem mfk_partial_plancherel_fst {F : ℝ × ℝ → ℂ} (h1 : Integrable F volume) (h2 : MemLp F 2
  volume)
    (R : ℝ) :
    ∫⁻ ξ in {ξ : ℝ × ℝ | |ξ.1| ≤ R}, ‖mfkF2 F ξ‖ₑ ^ 2
      = ∫⁻ y : ℝ, ∫⁻ ξ₁ in Set.Icc (-R) R,
          ‖∫ x : ℝ, Complex.exp (-(2 * Real.pi * Complex.I * (x * ξ₁))) * F (x, y)‖ₑ ^ 2 := by
  set F' := h1.1.mk F
  have hae : F =ᵐ[volume] F' := h1.1.ae_eq_mk
  have hm : Measurable F' := h1.1.stronglyMeasurable_mk.measurable
  rw [mfkF2_congr_ae hae, mfk_partial_fst_meas hm (h1.congr hae) (h2.ae_eq hae)]
  apply lintegral_congr_ae
  filter_upwards [mfk_slices_congr_ae hae] with y hy
  congr 1; ext ξ₁
  congr 2
  apply integral_congr_ae
  filter_upwards [hy] with x hx
  rw [hx]

theorem mfkF2_swap (F : ℝ × ℝ → ℂ) (ξ : ℝ × ℝ) :
    mfkF2 (fun z => F z.swap) ξ.swap = mfkF2 F ξ := by
  unfold mfkF2
  have := integral_prod_swap (μ := (volume : Measure ℝ)) (ν := (volume : Measure ℝ))
    (fun z : ℝ × ℝ => Complex.exp (-(2 * Real.pi * Complex.I * (z.1 * ξ.1 + z.2 * ξ.2))) * F z)
  simp only [← Measure.volume_eq_prod] at this
  rw [← this]
  congr 1; ext z
  simp only [Prod.fst_swap, Prod.snd_swap]
  congr 3
  ring

theorem mfk_partial_plancherel_snd {F : ℝ × ℝ → ℂ} (h1 : Integrable F volume) (h2 : MemLp F 2
  volume)
    (R : ℝ) :
    ∫⁻ ξ in {ξ : ℝ × ℝ | |ξ.2| ≤ R}, ‖mfkF2 F ξ‖ₑ ^ 2
      = ∫⁻ x : ℝ, ∫⁻ ξ₂ in Set.Icc (-R) R,
          ‖∫ y : ℝ, Complex.exp (-(2 * Real.pi * Complex.I * (y * ξ₂))) * F (x, y)‖ₑ ^ 2 := by
  have hmp : MeasurePreserving (Prod.swap : ℝ × ℝ → ℝ × ℝ) volume volume := by
    simpa only [Measure.volume_eq_prod] using
      (Measure.measurePreserving_swap (μ := (volume : Measure ℝ)) (ν := (volume : Measure ℝ)))
  have h1' : Integrable (fun z : ℝ × ℝ => F z.swap) volume := hmp.integrable_comp_of_integrable h1
  have h2' : MemLp (fun z : ℝ × ℝ => F z.swap) 2 volume := h2.comp_measurePreserving hmp
  have hL := hmp.setLIntegral_comp_preimage_emb MeasurableEquiv.prodComm.measurableEmbedding
    (fun ξ => ‖mfkF2 F ξ‖ₑ ^ 2) {ξ : ℝ × ℝ | |ξ.2| ≤ R}
  rw [← hL]
  have hpre : Prod.swap ⁻¹' {ξ : ℝ × ℝ | |ξ.2| ≤ R} = {ξ : ℝ × ℝ | |ξ.1| ≤ R} := by
    ext ξ; simp
  rw [hpre]
  have := mfk_partial_plancherel_fst h1' h2' R
  simp only [← mfkF2_swap F] at this ⊢
  simp only [Prod.swap_swap]
  rw [this]
  rfl

end

end Auto

