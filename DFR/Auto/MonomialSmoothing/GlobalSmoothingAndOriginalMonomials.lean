namespace Auto

noncomputable section

/-! ### Globalization: summing (averaging) the per-`q` bounds -/
theorem ms7_G_L2 (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L R₁ : ℝ) {u : ℝ × ℝ → ℂ} (hu : Measurable u) :
    (∫⁻ z, ms7G j κ L R₁ u z ^ (2 : ℝ)) ^ (1 / 2 : ℝ) ≤
      (∫⁻ s, ms7Tail κ L R₁ s) * eLpNorm u 2 volume :=
  ms7_dom_young j (ms7_measTail κ L R₁) hu

theorem ms7_H_L2 (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L) {u : ℝ × ℝ → ℂ}
    (hu : Measurable u) :
    (∫⁻ z, ms7H j κ L u z ^ (2 : ℝ)) ^ (1 / 2 : ℝ) ≤ (∫⁻ s, ‖κ s‖ₑ) * eLpNorm u 2 volume := by
  rw [← ms7_kerL1 κ hL]
  exact ms7_dom_young j (ms7_measK κ L).enorm hu

/-- **Global bound** from the local `L^2` bound: for every `R_1 ≥ 0`,
`4 ‖T_ψ(P_1u_1,P_2u_2)‖_1 ≤ (M_2 (2(R_0+R_1))^2 + C ‖ψ‖ (τ_1 N_2 + N_1 τ_2)) ‖u_1‖_2 ‖u_2‖_2`,
with `τ_i` the tails of the kernels beyond `R_1`. -/
theorem ms7_glob_bound {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) {C₁ : ℝ}
    (hloc : ∀ ψ : ℝ → ℝ, ContDiff ℝ ∞ ψ → tsupport ψ ⊆ Icc A B →
      ∀ (q : ℝ × ℝ) (f g : ℝ × ℝ → ℂ), Measurable f → Measurable g →
        eLpNorm (fun z => (ms7Chi (z - q) : ℂ) * monoT r ψ f g z) 1 volume ≤
          ENNReal.ofReal (C₁ * monoC20 ψ) *
            eLpNorm ((ms7Box q (ms7R0 r B)).indicator f) (12 / 7 : ℝ≥0∞) volume *
            eLpNorm ((ms7Box q (ms7R0 r B)).indicator g) (12 / 7 : ℝ≥0∞) volume)
    {ψ : ℝ → ℝ} (hψ : ContDiff ℝ ∞ ψ) (hsupp : tsupport ψ ⊆ Icc A B)
