/-- The trilinear form. -/
def mfkTri (A : (ℝ × ℝ) × ℝ → ℂ) (c q : ℝ) (F₁ F₂ : ℝ × ℝ → ℂ) : ℂ :=
  ∫ p : (ℝ × ℝ) × ℝ, F₁ (p.1.1 + p.2, p.1.2) * F₂ (p.1.1, p.1.2 + c + q * p.2) * A p

theorem mfk_tri_fourier {Λ h x0 y0 t0 : ℝ} {A : (ℝ × ℝ) × ℝ → ℂ}
    (hA : MfkAmp Λ h x0 y0 t0 A) (c q : ℝ) {G₁ G₂ : ℝ × ℝ → ℂ} (h1 : MfkNice G₁) (h2 : MfkNice G₂) :
    mfkTri A c q G₁ G₂ =
      ∫ w : (ℝ × ℝ) × (ℝ × ℝ), mfkF2 G₁ w.1 * mfkF2 G₂ w.2 * mfkPhi A c q w.1 w.2 := by
  let e : ℝ → ℂ := fun θ => Complex.exp (2 * Real.pi * Complex.I * (θ : ℂ))
  let H : (ℝ × ℝ) × ℝ → (ℝ × ℝ) × (ℝ × ℝ) → ℂ := fun p w =>
    (e ((p.1.1 + p.2) * w.1.1 + p.1.2 * w.1.2) * mfkF2 G₁ w.1) *
      (e (p.1.1 * w.2.1 + (p.1.2 + c + q * p.2) * w.2.2) * mfkF2 G₂ w.2) * A p
  have hm1 := mfkF2_measurable_of G₁ h1.measurable
  have hm2 := mfkF2_measurable_of G₂ h2.measurable
  have he : Continuous e := by fun_prop
  have hHm : Measurable (Function.uncurry H) := by
    have hA' := hA.cont.measurable
    have he' := he.measurable
    simp only [H, Function.uncurry_def]
    fun_prop
  have hHi : Integrable (Function.uncurry H) (volume.prod volume) := by
    have hdom := hA.integrable.norm.mul_prod (h1.mfkF2_integrable.norm.mul_prod
      h2.mfkF2_integrable.norm)
    refine hdom.mono' hHm.aestronglyMeasurable (Eventually.of_forall (fun z => ?_))
    simp only [H, Function.uncurry_def, norm_mul, e, mfk_norm_exp, one_mul]
    exact le_of_eq (by ring)
  have hinner : ∀ p : (ℝ × ℝ) × ℝ,
      G₁ (p.1.1 + p.2, p.1.2) * G₂ (p.1.1, p.1.2 + c + q * p.2) * A p = ∫ w, H p w := by
    intro p
    rw [h1.inversion, h2.inversion]
    simp only [H]
    rw [integral_mul_const]
    congr 1
    have := integral_prod_mul (μ := (volume : Measure (ℝ × ℝ))) (ν := (volume : Measure (ℝ × ℝ)))
      (fun ξ : ℝ × ℝ => e ((p.1.1 + p.2) * ξ.1 + p.1.2 * ξ.2) * mfkF2 G₁ ξ)
      (fun η : ℝ × ℝ => e (p.1.1 * η.1 + (p.1.2 + c + q * p.2) * η.2) * mfkF2 G₂ η)
    rw [show (volume : Measure ((ℝ × ℝ) × (ℝ × ℝ))) = volume.prod volume from rfl, this]
    simp only [e]
    push_cast
    rfl
  rw [mfkTri]
  simp_rw [hinner]
  rw [integral_integral_swap hHi]
  congr 1; ext w
  have hH : ∀ p, H p w = mfkF2 G₁ w.1 * mfkF2 G₂ w.2 *
      (Complex.exp (2 * Real.pi * Complex.I * (mfkPh c q w.1 w.2 p : ℂ)) * A p) := by
    intro p
    simp only [H, e, mfkPh]
    have : Complex.exp (2 * Real.pi * Complex.I *
        ((((p.1.1 + p.2) * w.1.1 + p.1.2 * w.1.2) + (p.1.1 * w.2.1 + (p.1.2 + c + q * p.2) *
          w.2.2) : ℝ) : ℂ))
        = Complex.exp (2 * Real.pi * Complex.I * ((((p.1.1 + p.2) * w.1.1 + p.1.2 * w.1.2) : ℝ) :
          ℂ)) *
          Complex.exp (2 * Real.pi * Complex.I *
            (((p.1.1 * w.2.1 + (p.1.2 + c + q * p.2) * w.2.2) : ℝ) : ℂ)) := by
      rw [← Complex.exp_add]; congr 1; push_cast; ring
    rw [this]; ring
  simp_rw [hH]
  rw [integral_const_mul]
  rfl

end

