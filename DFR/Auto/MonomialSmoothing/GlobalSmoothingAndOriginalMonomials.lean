      (fun v₁ v₂ hv₁ hv₂ B₁ B₂ hB₁ hB₂ => (hloc ψ hψ hsupp L hL v₁ v₂ hv₁ hv₂ B₁ B₂ hB₁ hB₂).1)
      u₁ u₂ hu₁ hu₂ hf₁ hf₂).trans ?_
    gcongr
    exact (le_max_left _ _).trans (le_add_of_nonneg_right zero_le_one)
  · refine (h₂ ψ hψ hsupp L (L / 2) L hL (by linarith) (by linarith)
