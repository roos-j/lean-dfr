/-! ### The two-dimensional Fourier support hypothesis implies the fiber condition -/
theorem ms8_integral_pt (n : Fin 2) (G : EuclideanSpace ℝ (Fin 2) → ℂ) :
    ∫ q : ℝ × ℝ, G (ms8E.symm (monoPt n q.2 q.1)) = ∫ x, G x := by
  rw [← ms8_E_symm_mp.integral_comp' G]
  fin_cases n
  · simp only [monoPt, Fin.zero_eta, ite_true]
    exact (Measure.measurePreserving_swap (μ := (volume : Measure ℝ)) (ν := volume)).integral_comp'
      (f := MeasurableEquiv.prodComm) (fun q => G (ms8E.symm q))
  · simp [monoPt]

theorem ms8_inner_pt (n : Fin 2) (a p η ζ : ℝ) :
    ⟪ms8E.symm (monoPt n a p), ms8E.symm (monoPt n η ζ)⟫ = a * η + p * ζ := by
  rw [PiLp.inner_apply, Fin.sum_univ_two]
  fin_cases n <;>
    simp [monoPt, ms8_E_symm_apply0, ms8_E_symm_apply1, mul_comm]
  ring

theorem ms8_fiber_fourier_zero (g : 𝓢(EuclideanSpace ℝ (Fin 2), ℂ)) (n : Fin 2) {lam : ℝ}
    (hg : ∀ ξ, 𝓕 (g : EuclideanSpace ℝ (Fin 2) → ℂ) ξ ≠ 0 → lam ≤ |ξ n|) {η : ℝ}
    (hη : |η| < lam) (p : ℝ) : 𝓕 (monoFib n (⇑g ∘ ms8E.symm) p) η = 0 := by
  obtain ⟨C, hC, hd⟩ := ms8_decay2 g
  set F : ℝ → ℝ → ℂ := fun p a => g (ms8E.symm (monoPt n a p)) with hF
  have hcF : Continuous fun q : ℝ × ℝ => F q.1 q.2 :=
    g.continuous.comp (ms8_continuous_E_symm.comp
      ((continuous_monoPt n).comp (continuous_snd.prodMk continuous_fst)))
  set H : ℝ → ℂ := fun p => ∫ a, (𝐞 (-(a * η)) : ℂ) * F p a with hH
  have hHeq : ∀ p, 𝓕 (monoFib n (⇑g ∘ ms8E.symm) p) η = H p := by
    intro p
    rw [Real.fourier_real_eq]
    rfl
  have hI0 := ms8_integrable_inv_sq
  set I0 := ∫ a : ℝ, 1 / (1 + |a|) ^ 2
  have hbd : ∀ p a, ‖(𝐞 (-(a * η)) : ℂ) * F p a‖ ≤ C * (1 / (1 + |a|) ^ 2 * (1 / (1 + |p|) ^ 2))
    := by
    intro p a
    rw [norm_mul, Circle.norm_coe, one_mul]
    exact hd n a p
  have hp1 : ∀ p : ℝ, 1 / (1 + |p|) ^ 2 ≤ 1 := fun p => by
    rw [div_le_one (by positivity)]; nlinarith [abs_nonneg p]
  -- continuity of `H`
  have hHc : Continuous H := by
    refine continuous_of_dominated (bound := fun a => C * (1 / (1 + |a|) ^ 2)) ?_ ?_ ?_ ?_
    · intro p
      exact (Continuous.aestronglyMeasurable (by
        have : Continuous fun a : ℝ => F p a := hcF.comp (continuous_const.prodMk continuous_id)
        fun_prop))
    · intro p
      refine Eventually.of_forall fun a => (hbd p a).trans ?_
      have := hp1 p
      have : 0 ≤ 1 / (1 + |a|) ^ 2 := by positivity
      calc C * (1 / (1 + |a|) ^ 2 * (1 / (1 + |p|) ^ 2)) ≤ C * (1 / (1 + |a|) ^ 2 * 1) := by gcongr
        _ = C * (1 / (1 + |a|) ^ 2) := by ring
    · exact hI0.const_mul C
    · refine Eventually.of_forall fun a => ?_
      have : Continuous fun p : ℝ => F p a := hcF.comp (continuous_id.prodMk continuous_const)
      fun_prop
  -- integrability of `H`
  have hHi : Integrable H volume := by
    refine (hI0.const_mul (C * I0)).mono' hHc.aestronglyMeasurable
      (Eventually.of_forall fun p => ?_)
    refine (norm_integral_le_of_norm_le ((hI0.mul_const (1 / (1 + |p|) ^ 2)).const_mul C)
      (Eventually.of_forall fun a => hbd p a)).trans (le_of_eq ?_)
    rw [integral_const_mul, integral_mul_const]; ring
  -- the Fourier transform of `H` vanishes
  have hFH : ∀ ζ, 𝓕 H ζ = 0 := by
    intro ζ
    set ξ := ms8E.symm (monoPt n η ζ)
    have hξ : 𝓕 (g : EuclideanSpace ℝ (Fin 2) → ℂ) ξ = 0 := by
      by_contra h
      have := hg ξ h
      rw [ms8_E_symm_pt_coord] at this
      linarith
    rw [← hξ, Real.fourier_real_eq, Real.fourier_eq, ← ms8_integral_pt n]
    have hint : Integrable (fun q : ℝ × ℝ => (𝐞 (-(q.1 * ζ)) : ℂ) *
        ((𝐞 (-(q.2 * η)) : ℂ) * F q.1 q.2)) (volume.prod volume) := by
      have hprod := (hI0.const_mul C).mul_prod hI0
      refine hprod.mono' ?_ (Eventually.of_forall fun q => ?_)
      · exact (Continuous.aestronglyMeasurable (by fun_prop))
      · rw [norm_mul, Circle.norm_coe, one_mul]
        refine (hbd q.1 q.2).trans (le_of_eq ?_)
        ring
    have e : ∀ q : ℝ × ℝ, 𝐞 (-⟪ms8E.symm (monoPt n q.2 q.1), ξ⟫) • g (ms8E.symm (monoPt n q.2 q.1))
        = (𝐞 (-(q.1 * ζ)) : ℂ) * ((𝐞 (-(q.2 * η)) : ℂ) * F q.1 q.2) := by
      intro q
      rw [ms8_inner_pt, Circle.smul_def, smul_eq_mul, ← mul_assoc, ← Circle.coe_mul,
        ← AddChar.map_add_eq_mul]
      congr 3; ring
    simp_rw [e]
    rw [Measure.volume_eq_prod, integral_prod _ hint]
    refine integral_congr_ae (Eventually.of_forall fun p => ?_)
    simp only [hH, Circle.smul_def, smul_eq_mul]
    rw [← integral_const_mul]
  have hFH0 : 𝓕 H = 0 := funext hFH
  have hinv := hHc.fourierInv_fourier_eq hHi (by rw [hFH0]; exact integrable_zero _ _ _)
  rw [hHeq, ← hinv, hFH0]
  simp [Real.fourierInv_eq]

end

end Auto

