/-! ### Lc10: the bound for a single compatible pair -/
theorem mlc_sqrt_add_le (a b : ℝ≥0∞) : (a + b) ^ (1 / 2 : ℝ) ≤ a ^ (1 / 2 : ℝ) + b ^ (1 / 2 : ℝ) :=
  ENNReal.rpow_add_le_add_rpow a b (by norm_num) (by norm_num)

theorem mlc_err_real {B₁ B₂ L Mq R : ℝ} (hB₁ : 0 ≤ B₁) (hB₂ : 0 ≤ B₂) (hL : 0 ≤ L) (hM : 0 ≤ Mq)
    (hR : 0 ≤ R) :
    (B₁ ^ 2 * B₂ ^ 2 * L * (Mq * (52 * R ^ 2)) * (64 * R ^ 4)) ^ (1 / 2 : ℝ) =
      B₁ * B₂ * R ^ 3 * (L ^ (1 / 2 : ℝ) * (3328 * Mq) ^ (1 / 2 : ℝ)) := by
  rw [← Real.mul_rpow hL (by positivity), ← Real.sqrt_eq_rpow, ← Real.sqrt_eq_rpow]
  rw [show B₁ ^ 2 * B₂ ^ 2 * L * (Mq * (52 * R ^ 2)) * (64 * R ^ 4) =
    (B₁ * B₂ * R ^ 3) ^ 2 * (L * (3328 * Mq)) by ring, Real.sqrt_mul (sq_nonneg _),
    Real.sqrt_sq (by positivity)]

/-- **The pair bound**: for a compatible pair,
`‖T(u₁,u₂)‖_1 ≤ K₁ h^{3/2} X̃^{1/4} Ỹ^{1/4} + K₂ B₁ B₂ L^{1/2} h^4`. -/
theorem mlc_pair_bound {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) {C0 : ℝ} (hC0 : 1 ≤ C0) :
    ∃ K₁ K₂ : ℝ, 0 ≤ K₁ ∧ 0 ≤ K₂ ∧ ∀ (h L B₁ B₂ a₁ b₁ a₂ b₂ tb : ℝ) (ψ : ℝ → ℝ) (u₁ u₂ : ℝ × ℝ → ℂ),
      MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂ →
      ∫⁻ z, ‖monoT r ψ u₁ u₂ z‖ₑ ≤
        ENNReal.ofReal (K₁ * h ^ (3 / 2 : ℝ)) * mlcX1 h (monoq r tb) u₁ ^ (1 / 4 : ℝ) *
          mlcX2 h (monoq r tb) u₂ ^ (1 / 4 : ℝ) +
        ENNReal.ofReal (K₂ * (B₁ * B₂ * L ^ (1 / 2 : ℝ) * h ^ 4)) := by
  have hqA : 0 < monoq r A := mlc_q_pos (by linarith) hA
  have hqAB : monoq r A ≤ monoq r B := mlc_q_mono hr hA hAB ⟨le_rfl, hAB.le⟩ ⟨hAB.le, le_rfl⟩ hAB.le
  obtain ⟨Cm, hCm0, hCm⟩ := mfk_bilinear (mlcLam C0) (monoq r A) (monoq r B) (mlcLam_pos hC0) hqA
  have hMq := mlcMq_nonneg hr hA hAB
  refine ⟨2 * C0 * Cm ^ (1 / 2 : ℝ) * (monoq r A)⁻¹ ^ (1 / 4 : ℝ),
    2 * C0 ^ 4 * (3328 * mlcMq r A B) ^ (1 / 2 : ℝ), by positivity, by positivity, ?_⟩
  intro h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂ P
  have hh := P.hh
  set qb := monoq r tb
  have hqb : monoq r A ≤ qb := mlc_q_mono hr hA hAB ⟨le_rfl, hAB.le⟩ P.htb P.htb.1
  have hqb0 : 0 < qb := hqA.trans_le hqb
  set X := mlcX1 h qb u₁
  set Y := mlcX2 h qb u₂
  set E := ENNReal.ofReal (mlcKe r A B C0 h L B₁ B₂ * (64 * (C0 * h) ^ 4))
  have hsq : ∫⁻ z, ‖monoT r ψ u₁ u₂ z‖ₑ ^ 2 ≤
      ENNReal.ofReal (Cm * h) * X ^ (1 / 2 : ℝ) * (ENNReal.ofReal qb⁻¹ * Y) ^ (1 / 2 : ℝ) + E := by
    rw [P.step2]
    have hdec : ∫ p, mlcPhi r ψ u₁ u₂ p = (∫ p, mlcPhiM r ψ C0 h a₁ b₁ a₂ tb u₁ u₂ p) +
        ∫ p, (mlcPhi r ψ u₁ u₂ p - mlcPhiM r ψ C0 h a₁ b₁ a₂ tb u₁ u₂ p) := by
      rw [integral_sub P.integrable_Phi P.integrable_PhiM]; ring
    rw [hdec]
    refine (enorm_add_le _ _).trans (add_le_add (P.step4 hCm) ?_)
    exact (enorm_integral_le_lintegral_enorm _).trans P.step3
  have hR : 0 ≤ C0 * h := mul_nonneg (by linarith) hh.le
  have hKe : 0 ≤ mlcKe r A B C0 h L B₁ B₂ * (64 * (C0 * h) ^ 4) := by
    unfold mlcKe; have := P.hL; positivity
  have alg : ∀ a b X Y : ℝ≥0∞, (a * X ^ (1 / 2 : ℝ) * (b * Y) ^ (1 / 2 : ℝ)) ^ (1 / 2 : ℝ) =
      a ^ (1 / 2 : ℝ) * b ^ (1 / 4 : ℝ) * X ^ (1 / 4 : ℝ) * Y ^ (1 / 4 : ℝ) := by
    intro a b X Y
    simp only [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0:ℝ) ≤ 1 / 2), ←
      ENNReal.rpow_mul]
    norm_num
    ring
  have hmain : ENNReal.ofReal (2 * (C0 * h)) *
      (ENNReal.ofReal (Cm * h) * X ^ (1 / 2 : ℝ) * (ENNReal.ofReal qb⁻¹ * Y) ^ (1 / 2 : ℝ)) ^ (1 /
        2 : ℝ)
      ≤ ENNReal.ofReal (2 * C0 * Cm ^ (1 / 2 : ℝ) * (monoq r A)⁻¹ ^ (1 / 4 : ℝ) * h ^ (3 / 2 : ℝ)) *
        X ^ (1 / 4 : ℝ) * Y ^ (1 / 4 : ℝ) := by
    rw [alg, ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num),
      ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num)]
    rw [show ∀ c d e X' Y' : ℝ≥0∞, c * (d * e * X' * Y') = c * d * e * X' * Y' from
      fun c d e X' Y' => by ring]
    rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
    refine mul_le_mul' (mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl) le_rfl
    rw [Real.mul_rpow (by positivity) hh.le]
    have e : h * h ^ (1 / 2 : ℝ) = h ^ (3 / 2 : ℝ) := by
      rw [show (3 / 2 : ℝ) = 1 + 1 / 2 by norm_num, Real.rpow_add hh, Real.rpow_one]
    have hq4 : qb⁻¹ ^ (1 / 4 : ℝ) ≤ (monoq r A)⁻¹ ^ (1 / 4 : ℝ) :=
      Real.rpow_le_rpow (by positivity) (inv_anti₀ hqA hqb) (by norm_num)
    calc 2 * (C0 * h) * (Cm ^ (1 / 2 : ℝ) * h ^ (1 / 2 : ℝ)) * qb⁻¹ ^ (1 / 4 : ℝ)
        = 2 * C0 * Cm ^ (1 / 2 : ℝ) * qb⁻¹ ^ (1 / 4 : ℝ) * (h * h ^ (1 / 2 : ℝ)) := by ring
      _ ≤ 2 * C0 * Cm ^ (1 / 2 : ℝ) * (monoq r A)⁻¹ ^ (1 / 4 : ℝ) * (h * h ^ (1 / 2 : ℝ)) := by
          gcongr
      _ = _ := by rw [e]
  have herr : ENNReal.ofReal (2 * (C0 * h)) * E ^ (1 / 2 : ℝ) =
      ENNReal.ofReal (2 * C0 ^ 4 * (3328 * mlcMq r A B) ^ (1 / 2 : ℝ) *
        (B₁ * B₂ * L ^ (1 / 2 : ℝ) * h ^ 4)) := by
    simp only [E]
    rw [ENNReal.ofReal_rpow_of_nonneg hKe (by norm_num), ← ENNReal.ofReal_mul (by positivity)]
    congr 1
    unfold mlcKe
    rw [mlc_err_real P.B₁_nonneg P.B₂_nonneg P.hL hMq hR]
    ring
  calc ∫⁻ z, ‖monoT r ψ u₁ u₂ z‖ₑ
      ≤ ENNReal.ofReal (2 * (C0 * h)) * (∫⁻ z, ‖monoT r ψ u₁ u₂ z‖ₑ ^ 2) ^ (1 / 2 : ℝ) := P.step1
    _ ≤ ENNReal.ofReal (2 * (C0 * h)) *
          ((ENNReal.ofReal (Cm * h) * X ^ (1 / 2 : ℝ) * (ENNReal.ofReal qb⁻¹ * Y) ^ (1 / 2 : ℝ)) ^
            (1 / 2 : ℝ)
            + E ^ (1 / 2 : ℝ)) := by
        gcongr
        exact (ENNReal.rpow_le_rpow hsq (by norm_num)).trans (mlc_sqrt_add_le _ _)
    _ = ENNReal.ofReal (2 * (C0 * h)) *
          (ENNReal.ofReal (Cm * h) * X ^ (1 / 2 : ℝ) * (ENNReal.ofReal qb⁻¹ * Y) ^ (1 / 2 : ℝ)) ^
            (1 / 2 : ℝ)
          + ENNReal.ofReal (2 * (C0 * h)) * E ^ (1 / 2 : ℝ) := mul_add _ _ _
    _ ≤ _ := by
        rw [herr]
        gcongr

end

