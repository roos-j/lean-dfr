theorem mfk_one_step {Λ h q qhi x0 y0 t0 : ℝ} (hΛ : 0 < Λ) (hh : 0 < h) (hq : 0 ≤ q)
    (hqq : q ≤ qhi) {A : (ℝ × ℝ) × ℝ → ℂ} (hA : MfkAmp Λ h x0 y0 t0 A) (c : ℝ)
    {F₁ F₂ G₁ G₂ : ℝ × ℝ → ℂ} (hF₁ : Measurable F₁) (hF₂ : Measurable F₂)
    (i₁ : Integrable F₁) (i₂ : Integrable F₂) (m₁ : MemLp F₁ 2 volume) (m₂ : MemLp F₂ 2 volume)
    (g₁ : MfkNice G₁) (g₂ : MfkNice G₂) {δ : ℝ≥0∞} (hδ : δ ≤ 1)
    (d₁ : eLpNorm (F₁ - G₁) 2 volume ≤ δ) (d₂ : eLpNorm (F₂ - G₂) 2 volume ≤ δ) :
    ‖mfkTri A c q F₁ F₂‖ₑ ≤
      ENNReal.ofReal (mfkC Λ qhi * h) * mfkX h q F₁ * mfkX h q F₂ +
      δ * (ENNReal.ofReal (mfkC Λ qhi * h) * mfkX h q F₂ +
        ENNReal.ofReal (mfkC Λ qhi * h) * mfkX h q F₁ + ENNReal.ofReal (mfkC Λ qhi * h) +
        ENNReal.ofReal (Λ * (2 * (Λ * h))) * eLpNorm F₂ 2 volume +
        ENNReal.ofReal (Λ * (2 * (Λ * h))) * eLpNorm F₁ 2 volume +
        ENNReal.ofReal (Λ * (2 * (Λ * h)))) := by
  set Ch := ENNReal.ofReal (mfkC Λ qhi * h)
  set L := ENNReal.ofReal (Λ * (2 * (Λ * h)))
  set X₁ := mfkX h q F₁
  set X₂ := mfkX h q F₂
  set N₁ := eLpNorm F₁ 2 volume
  set N₂ := eLpNorm F₂ 2 volume
  have hX₁ : mfkX h q G₁ ≤ X₁ + δ :=
    (mfkX_le_add i₁ g₁.integrable m₁ g₁.memLp).trans (add_le_add le_rfl d₁)
  have hX₂ : mfkX h q G₂ ≤ X₂ + δ :=
    (mfkX_le_add i₂ g₂.integrable m₂ g₂.memLp).trans (add_le_add le_rfl d₂)
  have hN : eLpNorm G₁ 2 volume ≤ N₁ + δ := by
    have e : G₁ = F₁ - (F₁ - G₁) := by funext z; simp
    rw [e]
    exact (eLpNorm_sub_le (by norm_num)).trans (add_le_add le_rfl d₁)
  rw [mfk_tri_decomp hΛ hA c q hF₁ hF₂ g₁.measurable g₂.measurable m₁ m₂ g₁.memLp g₂.memLp]
  calc _ ≤ ‖mfkTri A c q G₁ G₂‖ₑ + ‖mfkTri A c q (F₁ - G₁) F₂‖ₑ + ‖mfkTri A c q G₁ (F₂ - G₂)‖ₑ :=
        (enorm_add_le _ _).trans (add_le_add (enorm_add_le _ _) le_rfl)
    _ ≤ Ch * mfkX h q G₁ * mfkX h q G₂ + L * eLpNorm (F₁ - G₁) 2 volume * N₂ +
          L * eLpNorm G₁ 2 volume * eLpNorm (F₂ - G₂) 2 volume := by
        gcongr
        · exact mfk_nice_bound hΛ hh hq hqq hA c g₁ g₂
        · exact mfk_tri_enorm_le hΛ hA c q (hF₁.sub g₁.measurable) hF₂
        · exact mfk_tri_enorm_le hΛ hA c q g₁.measurable (hF₂.sub g₂.measurable)
    _ ≤ Ch * (X₁ + δ) * (X₂ + δ) + L * δ * N₂ + L * (N₁ + δ) * δ := by gcongr
    _ = Ch * X₁ * X₂ + δ * (Ch * X₂ + Ch * X₁ + L * N₂ + L * N₁) + δ * δ * (Ch + L) := by ring
    _ ≤ Ch * X₁ * X₂ + δ * (Ch * X₂ + Ch * X₁ + L * N₂ + L * N₁) + δ * 1 * (Ch + L) := by gcongr
    _ = _ := by ring

theorem mfk_bilinear_core {Λ h q qhi x0 y0 t0 : ℝ} (hΛ : 0 < Λ) (hh : 0 < h) (hq : 0 ≤ q)
    (hqq : q ≤ qhi) {A : (ℝ × ℝ) × ℝ → ℂ} (hA : MfkAmp Λ h x0 y0 t0 A) (c : ℝ)
    {F₁ F₂ : ℝ × ℝ → ℂ} (hF₁ : Measurable F₁) (hF₂ : Measurable F₂)
    (i₁ : Integrable F₁) (i₂ : Integrable F₂) (m₁ : MemLp F₁ 2 volume) (m₂ : MemLp F₂ 2 volume) :
    ‖mfkTri A c q F₁ F₂‖ₑ ≤ ENNReal.ofReal (mfkC Λ qhi * h) * mfkX h q F₁ * mfkX h q F₂ := by
  have hex : ∀ (F : ℝ × ℝ → ℂ), MemLp F 2 volume → ∀ n : ℕ, ∃ G, MfkNice G ∧
      eLpNorm (F - G) 2 volume ≤ ENNReal.ofReal (1 / ((n : ℝ) + 1)) := by
    intro F hF n
    obtain ⟨G, hG1, hG2, hG3⟩ := hF.exist_eLpNorm_sub_le (by norm_num) (by norm_num)
      (ε := 1 / ((n : ℝ) + 1)) (by positivity)
    exact ⟨G, ⟨hG1, hG2⟩, hG3⟩
  choose G₁ hG₁ hd₁ using hex F₁ m₁
  choose G₂ hG₂ hd₂ using hex F₂ m₂
  set Z := ENNReal.ofReal (mfkC Λ qhi * h) * mfkX h q F₂ +
        ENNReal.ofReal (mfkC Λ qhi * h) * mfkX h q F₁ + ENNReal.ofReal (mfkC Λ qhi * h) +
        ENNReal.ofReal (Λ * (2 * (Λ * h))) * eLpNorm F₂ 2 volume +
        ENNReal.ofReal (Λ * (2 * (Λ * h))) * eLpNorm F₁ 2 volume +
        ENNReal.ofReal (Λ * (2 * (Λ * h)))
  have hZ : Z ≠ ⊤ := by
    have a1 := (mfkX_lt_top (h := h) (q := q) i₁ m₁).ne
    have a2 := (mfkX_lt_top (h := h) (q := q) i₂ m₂).ne
    have a3 := m₁.eLpNorm_lt_top.ne
    have a4 := m₂.eLpNorm_lt_top.ne
    simp only [Z, ne_eq, ENNReal.add_eq_top, ENNReal.mul_eq_top, ENNReal.ofReal_ne_top,
      a1, a2, a3,
      a4, and_false, false_and, or_self, not_false_eq_true]
  have hbound : ∀ n : ℕ, ‖mfkTri A c q F₁ F₂‖ₑ ≤
      ENNReal.ofReal (mfkC Λ qhi * h) * mfkX h q F₁ * mfkX h q F₂ +
        ENNReal.ofReal (1 / ((n : ℝ) + 1)) * Z := by
    intro n
    have hδ : ENNReal.ofReal (1 / ((n : ℝ) + 1)) ≤ 1 := by
      rw [ENNReal.ofReal_le_one]
      rw [div_le_one (by positivity)]
      linarith [(Nat.cast_nonneg n : (0 : ℝ) ≤ n)]
    exact mfk_one_step hΛ hh hq hqq hA c hF₁ hF₂ i₁ i₂ m₁ m₂ (hG₁ n) (hG₂ n) hδ (hd₁ n) (hd₂ n)
  have hlim : Tendsto (fun n : ℕ => ENNReal.ofReal (mfkC Λ qhi * h) * mfkX h q F₁ * mfkX h q F₂ +
      ENNReal.ofReal (1 / ((n : ℝ) + 1)) * Z) atTop
      (𝓝 (ENNReal.ofReal (mfkC Λ qhi * h) * mfkX h q F₁ * mfkX h q F₂ + 0 * Z)) := by
    apply tendsto_const_nhds.add
    apply ENNReal.Tendsto.mul_const _ (Or.inr hZ)
    have := ENNReal.tendsto_ofReal (tendsto_one_div_add_atTop_nhds_zero_nat)
    simpa using this
  rw [zero_mul, add_zero] at hlim
  exact ge_of_tendsto' hlim hbound

theorem mfk_bilinear (Λ qlo qhi : ℝ) (hΛ : 0 < Λ) (hq : 0 < qlo) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (h q c x0 y0 t0 : ℝ), 0 < h → h ≤ 1 → q ∈ Set.Icc qlo qhi →
    ∀ A : (ℝ × ℝ) × ℝ → ℂ, Continuous A →
      (∀ p, A p ≠ 0 → |p.1.1 - x0| ≤ Λ * h ∧ |p.1.2 - y0| ≤ Λ * h ∧ |p.2 - t0| ≤ Λ * h) →
      (∀ y t, ContDiff ℝ 12 (fun x => A ((x, y), t)) ∧ ∀ k ≤ 12, ∀ x,
          ‖iteratedDeriv k (fun x => A ((x, y), t)) x‖ ≤ Λ * h ^ (-(k : ℝ))) →
      (∀ x t, ContDiff ℝ 12 (fun y => A ((x, y), t)) ∧ ∀ k ≤ 12, ∀ y,
          ‖iteratedDeriv k (fun y => A ((x, y), t)) y‖ ≤ Λ * h ^ (-(k : ℝ))) →
      (∀ x y, ContDiff ℝ 12 (fun t => A ((x, y), t)) ∧ ∀ k ≤ 12, ∀ t,
          ‖iteratedDeriv k (fun t => A ((x, y), t)) t‖ ≤ Λ * h ^ (-(k : ℝ))) →
      ∀ F₁ F₂ : ℝ × ℝ → ℂ, Measurable F₁ → Measurable F₂ → Integrable F₁ volume → Integrable F₂
        volume →
        MemLp F₁ 2 volume → MemLp F₂ 2 volume →
        ‖∫ p : (ℝ × ℝ) × ℝ, F₁ (p.1.1 + p.2, p.1.2) * F₂ (p.1.1, p.1.2 + c + q * p.2) * A p‖ₑ
          ≤ ENNReal.ofReal (C * h) *
            (∫⁻ ξ, ‖mfkF2 F₁ ξ‖ₑ ^ 2 * ENNReal.ofReal ((1 + |h * (ξ.1 - q * ξ.2)|) ^ (-8 : ℝ))) ^
              (1/2 : ℝ) *
            (∫⁻ ξ, ‖mfkF2 F₂ ξ‖ₑ ^ 2 * ENNReal.ofReal ((1 + |h * (ξ.1 - q * ξ.2)|) ^ (-8 : ℝ))) ^
              (1/2 : ℝ) := by
  refine ⟨mfkC Λ qhi, mfkC_nonneg Λ qhi, ?_⟩
  intro h q c x0 y0 t0 hh _ hqI A hAc hAs hAx hAy hAt F₁ F₂ hF₁ hF₂ i₁ i₂ m₁ m₂
  have hA : MfkAmp Λ h x0 y0 t0 A := ⟨hAc, hAs, hAx, hAy, hAt⟩
  exact mfk_bilinear_core hΛ hh (hq.le.trans hqI.1) hqI.2 hA c hF₁ hF₂ i₁ i₂ m₁ m₂

end

