theorem ms8_sq_ne_top {u : ℝ × ℝ → ℂ} (h : eLpNorm u 2 volume ≠ ⊤) : ∫⁻ z, ‖u z‖ₑ ^ 2 ≠ ⊤ := by
  intro h'
  rw [ms8_eLpNorm_two (aestronglyMeasurable_of_eLpNorm_ne_top h), h', ENNReal.top_rpow_of_pos
    (by norm_num)] at h
  exact h rfl

/-- The upper end of the telescoping sum: `‖T(f₁,f₂) - Φ(L)‖₁ ≤ e(L)`. -/
theorem ms8_upper {r : ℝ} (hr : 0 < r) {ψ : ℝ → ℝ} (hψI : Integrable ψ volume) (hψm : Measurable ψ)
    {f₁ f₂ : ℝ × ℝ → ℂ} (hf₁ : Measurable f₁) (hf₂ : Measurable f₂) {M₁ M₂ : ℝ}
    (hM₁ : ∀ z, ‖f₁ z‖ ≤ M₁) (hM₂ : ∀ z, ‖f₂ z‖ ≤ M₂)
    (hfib₁ : ∀ p, Integrable (monoFib 0 f₁ p) volume) {L : ℝ} (hL : 0 < L) :
    eLpNorm (fun z => monoT r ψ f₁ f₂ z - ms8Phi r ψ f₁ f₂ L z) 1 volume ≤
      (∫⁻ t, ‖ψ t‖ₑ) * (eLpNorm (fun z => f₁ z - monoP 0 monoKPhi L f₁ z) 2 volume *
        eLpNorm f₂ 2 volume) +
      (∫⁻ t, ‖ψ t‖ₑ) * (eLpNorm f₁ 2 volume *
        eLpNorm (fun z => f₂ z - monoP 1 monoKPhi L f₂ z) 2 volume) := by
  have mS0 := ms8_measurable_monoP 0 monoKPhi L hf₁
  have mS1 := ms8_measurable_monoP 1 monoKPhi L hf₂
  have bS0 := ms8_monoP_bdd 0 monoKPhi hL hM₁
  have bS1 := ms8_monoP_bdd 1 monoKPhi hL hM₂
  have e1 := ms8_monoT_sub_left hr hψI hf₁ mS0 hf₂ hM₁ bS0 hM₂
  have e2 := ms8_monoT_sub_right hr hψI mS0 hf₂ mS1 bS0 hM₂ bS1
  have e : (fun z => monoT r ψ f₁ f₂ z - ms8Phi r ψ f₁ f₂ L z) =
      monoT r ψ (fun z => f₁ z - monoP 0 monoKPhi L f₁ z) f₂ +
        monoT r ψ (monoP 0 monoKPhi L f₁) (fun z => f₂ z - monoP 1 monoKPhi L f₂ z) := by
    rw [e1, e2]; funext z; simp only [ms8Phi, Pi.add_apply]; ring
  rw [e]
  refine (eLpNorm_add_le le_rfl).trans (add_le_add ?_ ?_)
  · exact eLpNorm_monoT_le hr hψm (hf₁.sub mS0) hf₂
  · refine (eLpNorm_monoT_le hr hψm mS0 (hf₂.sub mS1)).trans ?_
    gcongr
    · exact ms8_eLpNorm_monoP_le 0 _ ms8_norm_fourier_KPhi_le hL hf₁ hfib₁ hM₁
    · exact le_rfl

/-- **(8.2)**: the smooth high-frequency tail estimate. -/
theorem ms8_smooth_tail {r A B C s : ℝ} (hr : 1 < r) (hC : 0 ≤ C) (hs : 0 < s)
    (hG : MonoGlobal77 r A B C s)
    {ψ : ℝ → ℝ} (hψ : ContDiff ℝ ∞ ψ) (hsupp : tsupport ψ ⊆ Icc A B) {Λ : ℝ} (hΛ : 1 ≤ Λ)
    {f₁ f₂ : ℝ × ℝ → ℂ} (hf₁ : Measurable f₁) (hf₂ : Measurable f₂) {M₁ M₂ : ℝ}
    (hM₁ : ∀ z, ‖f₁ z‖ ≤ M₁) (hM₂ : ∀ z, ‖f₂ z‖ ≤ M₂)
    (hfib₁ : ∀ p, Integrable (monoFib 0 f₁ p) volume)
    (hfib₂ : ∀ p, Integrable (monoFib 1 f₂ p) volume)
    (h2₁ : eLpNorm f₁ 2 volume ≠ ⊤) (h2₂ : eLpNorm f₂ 2 volume ≠ ⊤)
    (hF : (∀ p ξ, |ξ| < Λ → 𝓕 (monoFib 0 f₁ p) ξ = 0) ∨
      (∀ p ξ, |ξ| < Λ → 𝓕 (monoFib 1 f₂ p) ξ = 0)) :
    eLpNorm (monoT r ψ f₁ f₂) 1 volume ≤
      ENNReal.ofReal (2 * C * (2 ^ s / (1 - 2 ^ (-s))) * monoC20 ψ * Λ ^ (-s)) *
        (eLpNorm f₁ 2 volume * eLpNorm f₂ 2 volume) := by
  have hr0 : 0 < r := by linarith
  have hψc : HasCompactSupport ψ := isCompact_Icc.of_isClosed_subset (isClosed_tsupport ψ) hsupp
  have hψI : Integrable ψ volume := hψ.continuous.integrable_of_hasCompactSupport hψc
  have hψm : Measurable ψ := hψ.continuous.measurable
  have hψfin : (∫⁻ t, ‖ψ t‖ₑ) ≠ ⊤ := hψI.2.ne
  obtain ⟨N, hN1, hN2⟩ := exists_nat_pow_near hΛ (by norm_num : (1 : ℝ) < 2)
  set X := eLpNorm f₁ 2 volume * eLpNorm f₂ 2 volume with hX
  set a : ℝ → ℝ≥0∞ := fun L => ENNReal.ofReal (C * monoC20 ψ * L ^ (-s)) * X with ha
  have hpos : ∀ i : ℕ, 1 ≤ (2 : ℝ) ^ N * 2 ^ i := fun i =>
    one_le_mul_of_one_le_of_one_le (one_le_pow₀ (by norm_num)) (one_le_pow₀ (by norm_num))
  -- telescoping by induction
  have tel : ∀ I : ℕ, eLpNorm (ms8Phi r ψ f₁ f₂ ((2 : ℝ) ^ N * 2 ^ I / 2)) 1 volume ≤
      eLpNorm (ms8Phi r ψ f₁ f₂ ((2 : ℝ) ^ N / 2)) 1 volume +
        ∑ i ∈ Finset.range I, (a ((2 : ℝ) ^ N * 2 ^ i) + a ((2 : ℝ) ^ N * 2 ^ i)) := by
    intro I
    induction I with
    | zero => simp
    | succ I ih =>
      have eL : (2 : ℝ) ^ N * 2 ^ (I + 1) / 2 = 2 ^ N * 2 ^ I := by rw [pow_succ]; ring
      rw [eL, Finset.sum_range_succ, ← add_assoc]
      set L := (2 : ℝ) ^ N * 2 ^ I
      have hsplit : ms8Phi r ψ f₁ f₂ L = ms8Phi r ψ f₁ f₂ (L / 2) +
          fun z => ms8Phi r ψ f₁ f₂ L z - ms8Phi r ψ f₁ f₂ (L / 2) z := by
        funext z; simp
      rw [hsplit]
      refine (eLpNorm_add_le le_rfl).trans (add_le_add ih ?_)
      · exact ms8_step hr hG hψ hsupp hf₁ hf₂ hM₁ hM₂ h2₁ h2₂ (hpos I)
  -- the lower end vanishes
  have hzero : eLpNorm (ms8Phi r ψ f₁ f₂ ((2 : ℝ) ^ N / 2)) 1 volume = 0 := by
    have hL : (0 : ℝ) < 2 ^ N / 2 := by positivity
    have hLΛ : 2 * ((2 : ℝ) ^ N / 2) ≤ Λ := by linarith
    refine le_antisymm ((eLpNorm_monoT_le hr0 hψm (ms8_measurable_monoP 0 _ _ hf₁)
      (ms8_measurable_monoP 1 _ _ hf₂)).trans (le_of_eq ?_)) (by simp)
    rcases hF with h | h
    · rw [ms8_eLpNorm_monoP_Phi_eq_zero 0 hL hLΛ hf₁ hfib₁ hM₁ h]; simp
    · rw [ms8_eLpNorm_monoP_Phi_eq_zero 1 hL hLΛ hf₂ hfib₂ hM₂ h]; simp
  -- the geometric sum
  set K : ℝ := 2 * C * (2 ^ s / (1 - 2 ^ (-s))) * monoC20 ψ * Λ ^ (-s)
  have hsum : ∀ I : ℕ, ∑ i ∈ Finset.range I, (a ((2 : ℝ) ^ N * 2 ^ i) + a ((2 : ℝ) ^ N * 2 ^ i))
      ≤ ENNReal.ofReal K * X := by
    intro I
    have hC20 := ms8_monoC20_nonneg ψ
    have hnn : ∀ i : ℕ, 0 ≤ C * monoC20 ψ * ((2 : ℝ) ^ N * 2 ^ i) ^ (-s) := fun i => by positivity
    have e : ∀ i : ℕ, a ((2 : ℝ) ^ N * 2 ^ i) + a ((2 : ℝ) ^ N * 2 ^ i) =
        ENNReal.ofReal (2 * (C * monoC20 ψ * ((2 : ℝ) ^ N * 2 ^ i) ^ (-s))) * X := by
      intro i
      simp only [ha]
      rw [← add_mul, ← ENNReal.ofReal_add (hnn i) (hnn i), two_mul]
    simp_rw [e]
    rw [← Finset.sum_mul, ← ENNReal.ofReal_sum_of_nonneg (fun i _ => by linarith [hnn i])]
    gcongr
    rw [← Finset.mul_sum, ← Finset.mul_sum]
    have hg := ms8_geom hs N I hN2 hΛ
    have : 0 ≤ 2 * (C * monoC20 ψ) := by positivity
    calc 2 * (C * monoC20 ψ * ∑ i ∈ Finset.range I, ((2 : ℝ) ^ N * 2 ^ i) ^ (-s))
        = 2 * (C * monoC20 ψ) * ∑ i ∈ Finset.range I, ((2 : ℝ) ^ N * 2 ^ i) ^ (-s) := by ring
      _ ≤ 2 * (C * monoC20 ψ) * (2 ^ s / (1 - 2 ^ (-s)) * Λ ^ (-s)) :=
          mul_le_mul_of_nonneg_left hg this
      _ = K := by ring
  -- the upper end
  set e : ℝ → ℝ≥0∞ := fun L =>
    (∫⁻ t, ‖ψ t‖ₑ) * (eLpNorm (fun z => f₁ z - monoP 0 monoKPhi L f₁ z) 2 volume *
        eLpNorm f₂ 2 volume) +
      (∫⁻ t, ‖ψ t‖ₑ) * (eLpNorm f₁ 2 volume *
        eLpNorm (fun z => f₂ z - monoP 1 monoKPhi L f₂ z) 2 volume) with he
  have hbound : ∀ I : ℕ, eLpNorm (monoT r ψ f₁ f₂) 1 volume ≤
      e ((2 : ℝ) ^ N * 2 ^ I / 2) + ENNReal.ofReal K * X := by
    intro I
    set L := (2 : ℝ) ^ N * 2 ^ I / 2
    have hL : 0 < L := by positivity
    have hsplit : monoT r ψ f₁ f₂ = (fun z => monoT r ψ f₁ f₂ z - ms8Phi r ψ f₁ f₂ L z) +
        ms8Phi r ψ f₁ f₂ L := by funext z; simp
    rw [hsplit]
    refine (eLpNorm_add_le le_rfl).trans (add_le_add ?_ ?_)
    · exact ms8_upper hr0 hψI hψm hf₁ hf₂ hM₁ hM₂ hfib₁ hL
    · refine (tel I).trans ?_
      rw [hzero, zero_add]
      exact hsum I
  have hlim : Tendsto e atTop (𝓝 0) := by
    have t1 := ms8_tendsto_eLpNorm_sub_monoP 0 hf₁ hfib₁ hM₁ (ms8_sq_ne_top h2₁)
    have t2 := ms8_tendsto_eLpNorm_sub_monoP 1 hf₂ hfib₂ hM₂ (ms8_sq_ne_top h2₂)
    have t1' := ENNReal.Tendsto.const_mul (ENNReal.Tendsto.mul_const t1 (Or.inr h2₂))
      (Or.inr hψfin) (a := ∫⁻ t, ‖ψ t‖ₑ)
    have t2' := ENNReal.Tendsto.const_mul (ENNReal.Tendsto.const_mul t2 (Or.inr h2₁))
      (Or.inr hψfin) (a := ∫⁻ t, ‖ψ t‖ₑ)
    have := t1'.add t2'
    simpa using this
  have hseq : Tendsto (fun I : ℕ => (2 : ℝ) ^ N * 2 ^ I / 2) atTop atTop := by
    have h := tendsto_pow_atTop_atTop_of_one_lt (by norm_num : (1 : ℝ) < 2)
    exact (h.const_mul_atTop (by positivity : (0:ℝ) < 2 ^ N)).atTop_div_const (by norm_num)
  have hfin := ((hlim.comp hseq).add_const (ENNReal.ofReal K * X))
  rw [zero_add] at hfin
  exact ge_of_tendsto' hfin hbound

end

