/-! ### Continuous averaging over the box centres `q ∈ ℝ^2` -/

/-- The local `L^2` norm `‖F 1_{q + [-R,R]^2}‖_2` of a nonnegative function. -/
def ms7Loc (F : ℝ × ℝ → ℝ≥0∞) (R : ℝ) (q : ℝ × ℝ) : ℝ≥0∞ :=
  (∫⁻ z, (ms7Box q R).indicator (fun z => F z ^ (2 : ℝ)) z) ^ (1 / 2 : ℝ)

theorem ms7_box_ind_eq (F : ℝ × ℝ → ℝ≥0∞) (R : ℝ) (q z : ℝ × ℝ) :
    (ms7Box q R).indicator F z =
      {p : (ℝ × ℝ) × (ℝ × ℝ) | p.2 ∈ ms7Box p.1 R}.indicator (fun p => F p.2) (q, z) := by
  rfl

theorem ms7_box_ind_meas {F : ℝ × ℝ → ℝ≥0∞} (hF : Measurable F) (R : ℝ) :
    Measurable fun p : (ℝ × ℝ) × (ℝ × ℝ) => (ms7Box p.1 R).indicator F p.2 := by
  simp_rw [ms7_box_ind_eq F R]
  exact (hF.comp measurable_snd).indicator (ms7Box_meas_prod R)

theorem ms7Loc_meas {F : ℝ × ℝ → ℝ≥0∞} (hF : Measurable F) (R : ℝ) : Measurable (ms7Loc F R) :=
  (ms7_box_ind_meas (hF.pow_const (2 : ℝ)) R).lintegral_prod_right'.pow_const _

/-- `∫_q ∫_{q + [-R,R]^2} F = (2R)^2 ∫ F`. -/
theorem ms7_avg_int {F : ℝ × ℝ → ℝ≥0∞} (hF : Measurable F) {R : ℝ} (hR : 0 ≤ R) :
    ∫⁻ q, ∫⁻ z, (ms7Box q R).indicator F z = ENNReal.ofReal ((2 * R) ^ 2) * ∫⁻ z, F z := by
  rw [lintegral_lintegral_swap (ms7_box_ind_meas hF R).aemeasurable, ← lintegral_const_mul _ hF]
  refine lintegral_congr fun z => ?_
  have e : (fun q => (ms7Box q R).indicator F z) = (ms7Box z R).indicator (fun _ => F z) := by
    funext q
    by_cases h : z ∈ ms7Box q R
    · rw [indicator_of_mem h, indicator_of_mem (ms7Box_comm.1 h)]
    · rw [indicator_of_notMem h, indicator_of_notMem (fun h' => h (ms7Box_comm.2 h'))]
  rw [e, lintegral_indicator_const (ms7Box_meas z R), ms7Box_vol z hR, mul_comm]

/-- **Cauchy–Schwarz in `q`**: `∫_q ‖F 1_{Q_q}‖_2 ‖G 1_{Q_q}‖_2 ≤ (2R)^2 ‖F‖_2 ‖G‖_2`. -/
theorem ms7_avg {F G : ℝ × ℝ → ℝ≥0∞} (hF : Measurable F) (hG : Measurable G) {R : ℝ}
    (hR : 0 ≤ R) :
    ∫⁻ q, ms7Loc F R q * ms7Loc G R q ≤ ENNReal.ofReal ((2 * R) ^ 2) *
      ((∫⁻ z, F z ^ (2 : ℝ)) ^ (1 / 2 : ℝ) * (∫⁻ z, G z ^ (2 : ℝ)) ^ (1 / 2 : ℝ)) := by
  have hcs := ENNReal.lintegral_mul_le_Lp_mul_Lq volume Real.HolderConjugate.two_two
    (ms7Loc_meas hF R).aemeasurable (ms7Loc_meas hG R).aemeasurable
  refine hcs.trans (le_of_eq ?_)
  have sq : ∀ H : ℝ × ℝ → ℝ≥0∞, Measurable H →
      (∫⁻ q, ms7Loc H R q ^ (2 : ℝ)) ^ (1 / 2 : ℝ) =
        ENNReal.ofReal ((2 * R) ^ 2) ^ (1 / 2 : ℝ) * (∫⁻ z, H z ^ (2 : ℝ)) ^ (1 / 2 : ℝ) := by
    intro H hH
    have e : ∀ q, ms7Loc H R q ^ (2 : ℝ) = ∫⁻ z, (ms7Box q R).indicator (fun z => H z ^ (2 : ℝ)) z
      := by
      intro q
      rw [ms7Loc, ← ENNReal.rpow_mul]; norm_num
    simp_rw [e]
    rw [ms7_avg_int (hH.pow_const _) hR, ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]
  rw [sq F hF, sq G hG]
  calc ENNReal.ofReal ((2 * R) ^ 2) ^ (1 / 2 : ℝ) * (∫⁻ z, F z ^ (2 : ℝ)) ^ (1 / 2 : ℝ) *
        (ENNReal.ofReal ((2 * R) ^ 2) ^ (1 / 2 : ℝ) * (∫⁻ z, G z ^ (2 : ℝ)) ^ (1 / 2 : ℝ))
      = (ENNReal.ofReal ((2 * R) ^ 2) ^ (1 / 2 : ℝ) * ENNReal.ofReal ((2 * R) ^ 2) ^ (1 / 2 : ℝ)) *
        ((∫⁻ z, F z ^ (2 : ℝ)) ^ (1 / 2 : ℝ) * (∫⁻ z, G z ^ (2 : ℝ)) ^ (1 / 2 : ℝ)) := by ring
    _ = _ := by rw [mimp_half_mul_self]

/-- Domination on a box gives a bound on the localized `L^2` norm. -/
theorem ms7_eLp_box_le {f : ℝ × ℝ → ℂ} {F : ℝ × ℝ → ℝ≥0∞} {q : ℝ × ℝ} {R : ℝ}
    (h : ∀ z ∈ ms7Box q R, ‖f z‖ₑ ≤ F z)
    (hf : AEStronglyMeasurable f volume := by fun_prop) :
    eLpNorm ((ms7Box q R).indicator f) 2 volume ≤ ms7Loc F R q := by
  rw [eLpNorm_two_eq_lintegral (hf.indicator (ms7Box_meas q R)), ms7Loc]
  gcongr with z
  by_cases hz : z ∈ ms7Box q R
  · rw [indicator_of_mem hz, indicator_of_mem hz]
    exact ENNReal.rpow_le_rpow (h z hz) (by norm_num)
  · rw [indicator_of_notMem hz, indicator_of_notMem hz, enorm_zero,
      ENNReal.zero_rpow_of_pos (by norm_num)]

/-- The full dominating convolution `H = |K| * |u|` along coordinate `j`. -/
def ms7H (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L : ℝ) (u : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℝ≥0∞ :=
  ∫⁻ s, ‖(L : ℂ) * κ (L * s)‖ₑ * ‖u (z - monoEj j s)‖ₑ

/-- The tail dominating convolution `G = (1_{|s| ≥ R_1} |K|) * |u|`. -/
def ms7G (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L R₁ : ℝ) (u : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℝ≥0∞ :=
  ∫⁻ s, ms7Tail κ L R₁ s * ‖u (z - monoEj j s)‖ₑ

theorem ms7H_meas (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L : ℝ) {u : ℝ × ℝ → ℂ} (hu : Measurable u) :
    Measurable (ms7H j κ L u) :=
  (((ms7_measK κ L).enorm.comp measurable_snd).mul
    (hu.comp (ms7_meas_shift j)).enorm).lintegral_prod_right'

theorem ms7G_meas (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L R₁ : ℝ) {u : ℝ × ℝ → ℂ} (hu : Measurable u) :
    Measurable (ms7G j κ L R₁ u) :=
  (((ms7_measTail κ L R₁).comp measurable_snd).mul
    (hu.comp (ms7_meas_shift j)).enorm).lintegral_prod_right'

theorem ms7_P_ind_le_H (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L : ℝ) (u : ℝ × ℝ → ℂ) (S : Set (ℝ × ℝ))
    (z : ℝ × ℝ) : ‖monoP j κ L (S.indicator u) z‖ₑ ≤ ms7H j κ L u z := by
  refine (ms7_enorm_P_le j κ L _ z).trans (lintegral_mono fun s => ?_)
  gcongr
  by_cases hs : z - monoEj j s ∈ S
  · rw [indicator_of_mem hs]
  · rw [indicator_of_notMem hs, enorm_zero]; exact bot_le

theorem ms7_P_le_H (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L : ℝ) (u : ℝ × ℝ → ℂ) (z : ℝ × ℝ) :
    ‖monoP j κ L u z‖ₑ ≤ ms7H j κ L u z :=
  ms7_enorm_P_le j κ L u z

theorem ms7_Ej_components (j : Fin 2) (s : ℝ) :
    |(monoEj j s).1| ≤ |s| ∧ |(monoEj j s).2| ≤ |s| := by
  fin_cases j <;> simp [monoEj, monoPt]

/-- **Spatial tail (7.4), pointwise form**: on `q + [-R_0,R_0]^2` the contribution of `u` from
outside `q + [-(R_0+R_1), R_0+R_1]^2` is dominated by the tail convolution. -/
theorem ms7_far_le (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L : ℝ) (u : ℝ × ℝ → ℂ) {q z : ℝ × ℝ}
    {R₀ R₁ : ℝ} (hz : z ∈ ms7Box q R₀) :
    ‖monoP j κ L ((ms7Box q (R₀ + R₁))ᶜ.indicator u) z‖ₑ ≤ ms7G j κ L R₁ u z := by
  refine (ms7_enorm_P_le j κ L _ z).trans (lintegral_mono fun s => ?_)
  by_cases hs : z - monoEj j s ∈ (ms7Box q (R₀ + R₁))ᶜ
  · rw [indicator_of_mem hs]
    have hR : R₁ ≤ |s| := by
      by_contra hlt
      push Not at hlt
      apply hs
      obtain ⟨h1, h2⟩ := ms7_Ej_components j s
      simp only [ms7Box, mem_ofPred_eq, Prod.fst_sub, Prod.snd_sub] at hz ⊢
      constructor
      · calc |z.1 - (monoEj j s).1 - q.1| = |(z.1 - q.1) - (monoEj j s).1| := by ring_nf
          _ ≤ |z.1 - q.1| + |(monoEj j s).1| := abs_sub _ _
          _ ≤ R₀ + R₁ := by linarith [hz.1]
      · calc |z.2 - (monoEj j s).2 - q.2| = |(z.2 - q.2) - (monoEj j s).2| := by ring_nf
          _ ≤ |z.2 - q.2| + |(monoEj j s).2| := abs_sub _ _
          _ ≤ R₀ + R₁ := by linarith [hz.2]
    unfold ms7Tail
    rw [indicator_of_mem (show s ∈ {s : ℝ | R₁ ≤ |s|} from hR)]
  · rw [indicator_of_notMem hs, enorm_zero, mul_zero]; exact bot_le

/-- Young for the dominating convolutions: `‖k * |u|‖_2 ≤ ‖k‖_1 ‖u‖_2`. -/
theorem ms7_dom_young (j : Fin 2) {k : ℝ → ℝ≥0∞} (hk : Measurable k) {u : ℝ × ℝ → ℂ}
    (hu : Measurable u) :
    (∫⁻ z, (∫⁻ s, k s * ‖u (z - monoEj j s)‖ₑ) ^ (2 : ℝ)) ^ (1 / 2 : ℝ) ≤
      (∫⁻ s, k s) * eLpNorm u 2 volume := by
  rw [eLpNorm_two_eq_lintegral]
  calc (∫⁻ z, (∫⁻ s, k s * ‖u (z - monoEj j s)‖ₑ) ^ (2 : ℝ)) ^ (1 / 2 : ℝ)
      ≤ ((∫⁻ s, k s) ^ (2 : ℝ) * ∫⁻ z, ‖u z‖ₑ ^ (2 : ℝ)) ^ (1 / 2 : ℝ) := by
        gcongr
        exact ms7_young j (by norm_num) hk hu.enorm
    _ = _ := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul]
        norm_num

end

end Auto

