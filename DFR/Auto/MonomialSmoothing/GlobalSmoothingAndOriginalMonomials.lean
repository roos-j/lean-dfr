namespace Auto

noncomputable section

/-- The hypotheses on the amplitude `A`. -/
structure MfkAmp (Λ h x0 y0 t0 : ℝ) (A : (ℝ × ℝ) × ℝ → ℂ) : Prop where
  cont : Continuous A
  supp : ∀ p, A p ≠ 0 → |p.1.1 - x0| ≤ Λ * h ∧ |p.1.2 - y0| ≤ Λ * h ∧ |p.2 - t0| ≤ Λ * h
  dx : ∀ y t, ContDiff ℝ 12 (fun x => A ((x, y), t)) ∧ ∀ k ≤ 12, ∀ x,
          ‖iteratedDeriv k (fun x => A ((x, y), t)) x‖ ≤ Λ * h ^ (-(k : ℝ))
  dy : ∀ x t, ContDiff ℝ 12 (fun y => A ((x, y), t)) ∧ ∀ k ≤ 12, ∀ y,
          ‖iteratedDeriv k (fun y => A ((x, y), t)) y‖ ≤ Λ * h ^ (-(k : ℝ))
  dt : ∀ x y, ContDiff ℝ 12 (fun t => A ((x, y), t)) ∧ ∀ k ≤ 12, ∀ t,
          ‖iteratedDeriv k (fun t => A ((x, y), t)) t‖ ≤ Λ * h ^ (-(k : ℝ))

/-- The phase of the kernel. -/
def mfkPh (c q : ℝ) (ξ η : ℝ × ℝ) (p : (ℝ × ℝ) × ℝ) : ℝ :=
  ((p.1.1 + p.2) * ξ.1 + p.1.2 * ξ.2) + (p.1.1 * η.1 + (p.1.2 + c + q * p.2) * η.2)

/-- The Fourier kernel `Φ(ξ, η)`. -/
def mfkPhi (A : (ℝ × ℝ) × ℝ → ℂ) (c q : ℝ) (ξ η : ℝ × ℝ) : ℂ :=
  ∫ p, Complex.exp (2 * Real.pi * Complex.I * (mfkPh c q ξ η p : ℂ)) * A p

theorem mfk_norm_exp (θ : ℝ) : ‖Complex.exp (2 * Real.pi * Complex.I * (θ : ℂ))‖ = 1 := by
  rw [Complex.norm_exp]
  simp

theorem mfk_inner_bound {Λ h x0 : ℝ} (hΛ : 0 < Λ) (hh : 0 < h) {g : ℝ → ℂ}
    (hg : ContDiff ℝ 12 g)
    (hd : ∀ k ≤ 12, ∀ x, ‖iteratedDeriv k g x‖ ≤ Λ * h ^ (-(k : ℝ)))
    (hs : ∀ x, g x ≠ 0 → |x - x0| ≤ Λ * h) (κ a : ℝ) :
    ‖∫ s : ℝ, Complex.exp (2 * Real.pi * Complex.I * ((κ + s * a : ℝ) : ℂ)) * g s‖
      ≤ 2 ^ 13 * Λ ^ 2 * h / (1 + h * |a|) ^ 12 := by
  have he : ∀ s : ℝ, Complex.exp (2 * Real.pi * Complex.I * ((κ + s * a : ℝ) : ℂ)) * g s =
      Complex.exp (2 * Real.pi * Complex.I * (κ : ℂ)) *
        (Complex.exp (2 * Real.pi * Complex.I * ((s : ℂ) * (a : ℂ))) * g s) := by
    intro s
    rw [← mul_assoc, ← Complex.exp_add]
    congr 2
    push_cast; ring
  simp_rw [he]
  rw [integral_const_mul, norm_mul, mfk_norm_exp, one_mul]
  have := mfk_1d_decay hΛ hh hg hd hs a
  rw [le_div_iff₀ (by positivity)]
  exact this

theorem MfkAmp.hasCompactSupport {Λ h x0 y0 t0 : ℝ} {A : (ℝ × ℝ) × ℝ → ℂ}
    (hA : MfkAmp Λ h x0 y0 t0 A) : HasCompactSupport A := by
  apply HasCompactSupport.of_support_subset_isCompact
    (((isCompact_Icc (a := x0 - Λ * h) (b := x0 + Λ * h)).prod
      (isCompact_Icc (a := y0 - Λ * h) (b := y0 + Λ * h))).prod
      (isCompact_Icc (a := t0 - Λ * h) (b := t0 + Λ * h)))
  intro p hp
  obtain ⟨h1, h2, h3⟩ := hA.supp p hp
  rw [abs_le] at h1 h2 h3
  refine ⟨⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩, ⟨?_, ?_⟩⟩ <;> linarith [h1.1, h1.2, h2.1, h2.2, h3.1, h3.2]

theorem MfkAmp.integrable {Λ h x0 y0 t0 : ℝ} {A : (ℝ × ℝ) × ℝ → ℂ}
    (hA : MfkAmp Λ h x0 y0 t0 A) : Integrable A :=
  hA.cont.integrable_of_hasCompactSupport hA.hasCompactSupport

theorem mfk_phi_integrand_integrable {Λ h x0 y0 t0 : ℝ} {A : (ℝ × ℝ) × ℝ → ℂ}
    (hA : MfkAmp Λ h x0 y0 t0 A) (c q : ℝ) (ξ η : ℝ × ℝ) :
    Integrable (fun p => Complex.exp (2 * Real.pi * Complex.I * (mfkPh c q ξ η p : ℂ)) * A p) := by
  refine hA.integrable.bdd_mul (c := 1) ?_ ?_
  · apply Continuous.aestronglyMeasurable
    unfold mfkPh
    fun_prop
  · exact Eventually.of_forall (fun p => (mfk_norm_exp _).le)

theorem mfk_box_vol {a b r : ℝ} (hr : 0 ≤ r) :
    volume.real (Icc (a - r) (a + r) ×ˢ Icc (b - r) (b + r)) = (2 * r) ^ 2 := by
  rw [Measure.real, Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Icc, Real.volume_Icc,
    ← ENNReal.ofReal_mul (by linarith), ENNReal.toReal_ofReal (by nlinarith)]
  ring

theorem mfk_box_lt_top {a b r : ℝ} :
    volume (Icc (a - r) (a + r) ×ˢ Icc (b - r) (b + r)) < ∞ := by
  rw [Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Icc, Real.volume_Icc]
  exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top ENNReal.ofReal_lt_top

end

end Auto

end

