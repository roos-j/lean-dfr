/-! ### Transport between `EuclideanSpace ℝ (Fin 2)` and `ℝ × ℝ` -/

/-- `x ↦ (x_0, x_1)`. -/
def ms8E : EuclideanSpace ℝ (Fin 2) ≃ᵐ ℝ × ℝ :=
  (MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow

theorem ms8_E_mp : MeasurePreserving ms8E volume volume :=
  (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 2)).trans
    (volume_preserving_finTwoArrow ℝ)

theorem ms8_E_symm_mp : MeasurePreserving ms8E.symm volume volume := ms8_E_mp.symm

theorem ms8_E_apply (x : EuclideanSpace ℝ (Fin 2)) : ms8E x = (x 0, x 1) := rfl

theorem ms8_E_symm_apply0 (z : ℝ × ℝ) : ms8E.symm z 0 = z.1 := rfl
theorem ms8_E_symm_apply1 (z : ℝ × ℝ) : ms8E.symm z 1 = z.2 := rfl

theorem ms8_continuous_E_symm : Continuous ms8E.symm := by
  have : (ms8E.symm : ℝ × ℝ → EuclideanSpace ℝ (Fin 2)) =
      fun z => (EuclideanSpace.equiv (Fin 2) ℝ).symm ![z.1, z.2] := by
    funext z
    ext i
    fin_cases i <;> rfl
  rw [this]
  exact (EuclideanSpace.equiv (Fin 2) ℝ).symm.continuous.comp
    (continuous_pi fun i => by fin_cases i <;> simp only [Nat.succ_eq_add_one, Nat.reduceAdd,
      Fin.zero_eta, Fin.isValue, Matrix.cons_val_zero, Fin.mk_one, Matrix.cons_val_one,
      Matrix.cons_val_fin_one] <;> fun_prop)

/-- Schwartz decay `‖g x‖ ≤ C (1+‖x‖)^{-k}`. -/
theorem ms8_decay {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V] (g : 𝓢(V, ℂ)) (k : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x, ‖g x‖ ≤ C / (1 + ‖x‖) ^ k := by
  set C : ℝ := 2 ^ k * (Finset.Iic (k, (0 : ℕ))).sup (fun m => SchwartzMap.seminorm ℝ m.1 m.2) g
  refine ⟨C, by positivity, fun x => ?_⟩
  have h := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := (k, (0 : ℕ)))
    (k := k) (n := 0) le_rfl le_rfl g x
  rw [norm_iteratedFDeriv_zero] at h
  rw [le_div_iff₀ (by positivity), mul_comm]
  exact h

theorem ms8_abs_coord_le (x : EuclideanSpace ℝ (Fin 2)) (i : Fin 2) : |x i| ≤ ‖x‖ := by
  have := PiLp.norm_apply_le x i
  rwa [Real.norm_eq_abs] at this

/-- The plane point with coordinate `n` equal to `a` and the other equal to `p`. -/
theorem ms8_E_symm_pt_coord (n : Fin 2) (a p : ℝ) :
    ms8E.symm (monoPt n a p) n = a := by
  fin_cases n <;> rfl

theorem ms8_E_symm_pt_coord' (n : Fin 2) (a p : ℝ) :
    ms8E.symm (monoPt n a p) (1 - n) = p := by
  fin_cases n <;> rfl

/-- Two-variable decay along coordinate planes. -/
theorem ms8_decay2 (g : 𝓢(EuclideanSpace ℝ (Fin 2), ℂ)) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ n : Fin 2, ∀ a p : ℝ,
      ‖g (ms8E.symm (monoPt n a p))‖ ≤ C * (1 / (1 + |a|) ^ 2 * (1 / (1 + |p|) ^ 2)) := by
  obtain ⟨C, hC, hg⟩ := ms8_decay g 4
  refine ⟨C, hC, fun n a p => ?_⟩
  set x := ms8E.symm (monoPt n a p)
  have ha : |a| ≤ ‖x‖ := by
    have := ms8_abs_coord_le x n; rwa [ms8_E_symm_pt_coord] at this
  have hp : |p| ≤ ‖x‖ := by
    have := ms8_abs_coord_le x (1 - n); rwa [ms8_E_symm_pt_coord'] at this
  refine (hg x).trans ?_
  have h1 : (1 + |a|) ^ 2 * (1 + |p|) ^ 2 ≤ (1 + ‖x‖) ^ 4 := by
    have e : (1 + ‖x‖) ^ 4 = (1 + ‖x‖) ^ 2 * (1 + ‖x‖) ^ 2 := by ring
    rw [e]
    have := abs_nonneg a; have := abs_nonneg p
    gcongr
  rw [div_eq_mul_one_div C]
  gcongr
  rw [one_div_mul_one_div]
  exact one_div_le_one_div_of_le (by positivity) h1

theorem ms8_integrable_inv_sq : Integrable (fun a : ℝ => 1 / (1 + |a|) ^ 2) volume := by
  have := integrable_inv_one_add_sq 0
  refine this.congr (Eventually.of_forall fun a => ?_)
  simp [abs_neg]

/-- The planar function `f = g ∘ E⁻¹` has the properties needed in Sections 1-8. -/
theorem ms8_schwartz_props (g : 𝓢(EuclideanSpace ℝ (Fin 2), ℂ)) :
    Continuous (⇑g ∘ ms8E.symm) ∧ (∃ M, ∀ z, ‖(⇑g ∘ ms8E.symm) z‖ ≤ M) ∧
      eLpNorm (⇑g ∘ ms8E.symm) 2 volume = eLpNorm (⇑g) 2 volume ∧
      eLpNorm (⇑g) 2 volume ≠ ⊤ ∧
      ∀ n : Fin 2, ∀ p, Integrable (monoFib n (⇑g ∘ ms8E.symm) p) volume := by
  obtain ⟨C, hC, hd⟩ := ms8_decay2 g
  obtain ⟨C0, hC0, hd0⟩ := ms8_decay g 0
  refine ⟨g.continuous.comp ms8_continuous_E_symm, ⟨C0, fun z => by simpa using hd0 _⟩,
    eLpNorm_comp_measurePreserving g.continuous.aestronglyMeasurable ms8_E_symm_mp,
    (g.memLp 2 volume).eLpNorm_ne_top, fun n p => ?_⟩
  have hc : Continuous (monoFib n (⇑g ∘ ms8E.symm) p) := by
    unfold monoFib
    exact (g.continuous.comp ms8_continuous_E_symm).comp
      ((continuous_monoPt n).comp (continuous_id.prodMk continuous_const))
  refine (ms8_integrable_inv_sq.const_mul (C * (1 / (1 + |p|) ^ 2))).mono'
    hc.aestronglyMeasurable (Eventually.of_forall fun a => ?_)
  refine (hd n a p).trans (le_of_eq ?_)
  ring

end

end Auto

