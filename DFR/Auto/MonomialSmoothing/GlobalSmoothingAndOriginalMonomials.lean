/-! ### Almost-everywhere bilinearity of `monoT` -/

/-- The integrand of `T_ψ` has finite double integral (the computation behind (1.2)). -/
theorem ms7_T_int_le {r : ℝ} (hr : 0 < r) {ψ : ℝ → ℝ} (hψ : Measurable ψ)
    {f₁ f₂ : ℝ × ℝ → ℂ} (hf₁ : Measurable f₁) (hf₂ : Measurable f₂) :
    ∫⁻ z : ℝ × ℝ, ∫⁻ t : ℝ, ‖ψ t‖ₑ * (‖f₁ (z.1 + t, z.2)‖ₑ * ‖f₂ (z.1, z.2 + monoQ r t)‖ₑ)
      ≤ (∫⁻ t, ‖ψ t‖ₑ) * (eLpNorm f₁ 2 volume * eLpNorm f₂ 2 volume) := by
  have hmeas : Measurable (Function.uncurry fun (z : ℝ × ℝ) (t : ℝ) =>
      ‖ψ t‖ₑ * (‖f₁ (z.1 + t, z.2)‖ₑ * ‖f₂ (z.1, z.2 + monoQ r t)‖ₑ)) :=
    (hψ.comp measurable_snd).enorm.mul ((hf₁.comp measurable_monoShift1).enorm.mul
      (hf₂.comp (measurable_monoShift2 hr)).enorm)
  calc ∫⁻ z : ℝ × ℝ, ∫⁻ t : ℝ, ‖ψ t‖ₑ * (‖f₁ (z.1 + t, z.2)‖ₑ * ‖f₂ (z.1, z.2 + monoQ r t)‖ₑ)
      = ∫⁻ t : ℝ, ∫⁻ z : ℝ × ℝ, ‖ψ t‖ₑ * (‖f₁ (z.1 + t, z.2)‖ₑ * ‖f₂ (z.1, z.2 + monoQ r t)‖ₑ) :=
        lintegral_lintegral_swap hmeas.aemeasurable
    _ = ∫⁻ t : ℝ, ‖ψ t‖ₑ * ∫⁻ z : ℝ × ℝ, ‖f₁ (z + (t, 0))‖ₑ * ‖f₂ (z + (0, monoQ r t))‖ₑ := by
        refine lintegral_congr fun t => ?_
        rw [← lintegral_const_mul]
        · refine lintegral_congr fun z => ?_
          rw [show z + (t, 0) = (z.1 + t, z.2) from Prod.ext rfl (add_zero _),
            show z + (0, monoQ r t) = (z.1, z.2 + monoQ r t) from Prod.ext (add_zero _) rfl]
        · exact ((hf₁.comp (measurable_add_const _)).enorm.mul
            (hf₂.comp (measurable_add_const _)).enorm)
    _ ≤ ∫⁻ t : ℝ, ‖ψ t‖ₑ * (eLpNorm f₁ 2 volume * eLpNorm f₂ 2 volume) := by
        gcongr with t
        exact lintegral_translate_mul_le hf₁ hf₂ _ _
    _ = _ := by rw [lintegral_mul_const _ hψ.enorm]

/-- For a.e. `z` the integrand defining `T_ψ(f_1,f_2)(z)` is integrable. -/
theorem ms7_T_integrable_ae {r : ℝ} (hr : 0 < r) {ψ : ℝ → ℝ} (hψ : Measurable ψ)
    (hψ1 : ∫⁻ t, ‖ψ t‖ₑ ≠ ⊤) {f₁ f₂ : ℝ × ℝ → ℂ} (hf₁ : Measurable f₁) (hf₂ : Measurable f₂)
    (h1 : eLpNorm f₁ 2 volume ≠ ⊤) (h2 : eLpNorm f₂ 2 volume ≠ ⊤) :
    ∀ᵐ z : ℝ × ℝ, Integrable
      (fun t => (ψ t : ℂ) * (f₁ (z.1 + t, z.2) * f₂ (z.1, z.2 + monoQ r t))) volume := by
  have hmeas : Measurable (Function.uncurry fun (z : ℝ × ℝ) (t : ℝ) =>
      ‖ψ t‖ₑ * (‖f₁ (z.1 + t, z.2)‖ₑ * ‖f₂ (z.1, z.2 + monoQ r t)‖ₑ)) :=
    (hψ.comp measurable_snd).enorm.mul ((hf₁.comp measurable_monoShift1).enorm.mul
      (hf₂.comp (measurable_monoShift2 hr)).enorm)
  have hfin := (ms7_T_int_le hr hψ hf₁ hf₂).trans_lt
    (ENNReal.mul_lt_top hψ1.lt_top (ENNReal.mul_lt_top h1.lt_top h2.lt_top))
  filter_upwards [ae_lt_top hmeas.lintegral_prod_right' hfin.ne] with z hz
  refine ⟨?_, ?_⟩
  · have : Measurable fun t : ℝ => (ψ t : ℂ) * (f₁ (z.1 + t, z.2) * f₂ (z.1, z.2 + monoQ r t)) := by
      have hQ := (continuous_monoQ hr).measurable
      exact (Complex.measurable_ofReal.comp hψ).mul
        ((hf₁.comp ((measurable_const.add measurable_id).prodMk measurable_const)).mul
          (hf₂.comp (measurable_const.prodMk (measurable_const.add hQ))))
    exact this.aestronglyMeasurable
  · unfold HasFiniteIntegral
    simp only [enorm_mul, monoEnorm_ofReal]
    exact hz

theorem ms7_ae_snd {P : ℝ → Prop} (h : ∀ᵐ y : ℝ, P y) : ∀ᵐ z : ℝ × ℝ, P z.2 := by
  have := (Measure.quasiMeasurePreserving_snd (μ := (volume : Measure ℝ))
    (ν := (volume : Measure ℝ))).ae h
  rwa [← Measure.volume_eq_prod] at this

theorem ms7_ae_fst {P : ℝ → Prop} (h : ∀ᵐ x : ℝ, P x) : ∀ᵐ z : ℝ × ℝ, P z.1 := by
  have := (Measure.quasiMeasurePreserving_fst (μ := (volume : Measure ℝ))
    (ν := (volume : Measure ℝ))).ae h
  rwa [← Measure.volume_eq_prod] at this

/-- **A.e. additivity of `T_ψ` in the first slot.** -/
theorem ms7_T_split1 {r : ℝ} (hr : 0 < r) {ψ : ℝ → ℝ} (hψ : Measurable ψ)
    (hψ1 : ∫⁻ t, ‖ψ t‖ₑ ≠ ⊤) {f f' f'' g : ℝ × ℝ → ℂ} (hf' : Measurable f')
    (hf'' : Measurable f'') (hg : Measurable g) (h' : eLpNorm f' 2 volume ≠ ⊤)
    (h'' : eLpNorm f'' 2 volume ≠ ⊤) (hg2 : eLpNorm g 2 volume ≠ ⊤)
    (h : ∀ᵐ y : ℝ, ∀ x : ℝ, f (x, y) = f' (x, y) + f'' (x, y)) :
    monoT r ψ f g =ᵐ[volume] fun z => monoT r ψ f' g z + monoT r ψ f'' g z := by
  filter_upwards [ms7_T_integrable_ae hr hψ hψ1 hf' hg h' hg2,
    ms7_T_integrable_ae hr hψ hψ1 hf'' hg h'' hg2, ms7_ae_snd h] with z i1 i2 hz
  unfold monoT
  rw [← integral_add i1 i2]
  congr 1; funext t
  rw [hz (z.1 + t)]; ring

/-- **A.e. additivity of `T_ψ` in the second slot.** -/
theorem ms7_T_split2 {r : ℝ} (hr : 0 < r) {ψ : ℝ → ℝ} (hψ : Measurable ψ)
    (hψ1 : ∫⁻ t, ‖ψ t‖ₑ ≠ ⊤) {f g g' g'' : ℝ × ℝ → ℂ} (hf : Measurable f)
    (hg' : Measurable g') (hg'' : Measurable g'') (hf2 : eLpNorm f 2 volume ≠ ⊤)
    (h' : eLpNorm g' 2 volume ≠ ⊤) (h'' : eLpNorm g'' 2 volume ≠ ⊤)
    (h : ∀ᵐ x : ℝ, ∀ y : ℝ, g (x, y) = g' (x, y) + g'' (x, y)) :
    monoT r ψ f g =ᵐ[volume] fun z => monoT r ψ f g' z + monoT r ψ f g'' z := by
  filter_upwards [ms7_T_integrable_ae hr hψ hψ1 hf hg' hf2 h',
    ms7_T_integrable_ae hr hψ hψ1 hf hg'' hf2 h'', ms7_ae_fst h] with z i1 i2 hz
  unfold monoT
  rw [← integral_add i1 i2]
  congr 1; funext t
  rw [hz (z.2 + monoQ r t)]; ring

/-- The fiber split of `monoP` in coordinate `0`, in the form used by `ms7_T_split1`. -/
theorem ms7_P_split0 (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L) {u : ℝ × ℝ → ℂ}
    (hu : Measurable u) (hu2 : eLpNorm u 2 volume ≠ ⊤) {S : Set (ℝ × ℝ)} (hS : MeasurableSet S) :
    ∀ᵐ y : ℝ, ∀ x : ℝ, monoP 0 κ L u (x, y) =
      monoP 0 κ L (S.indicator u) (x, y) + monoP 0 κ L (Sᶜ.indicator u) (x, y) := by
  filter_upwards [ms7_P_split 0 κ hL hu hu2 hS] with y hy x
  simpa [monoPt] using hy x

/-- The fiber split of `monoP` in coordinate `1`, in the form used by `ms7_T_split2`. -/
theorem ms7_P_split1 (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L) {u : ℝ × ℝ → ℂ}
    (hu : Measurable u) (hu2 : eLpNorm u 2 volume ≠ ⊤) {S : Set (ℝ × ℝ)} (hS : MeasurableSet S) :
    ∀ᵐ x : ℝ, ∀ y : ℝ, monoP 1 κ L u (x, y) =
      monoP 1 κ L (S.indicator u) (x, y) + monoP 1 κ L (Sᶜ.indicator u) (x, y) := by
  filter_upwards [ms7_P_split 1 κ hL hu hu2 hS] with x hx y
  simpa [monoPt] using hx y

end

