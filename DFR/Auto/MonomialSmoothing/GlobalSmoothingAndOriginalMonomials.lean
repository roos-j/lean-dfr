/-! ### The local `L^2` bound (7.3) by level-set truncation -/
theorem ms7_mul_le_left {b c : ℝ≥0∞} (h : b ≤ c) (a : ℝ≥0∞) : a * b ≤ a * c :=
  mul_le_mul' le_rfl h

theorem ms7_two_toReal : (2 : ℝ≥0∞).toReal = 2 := by simp

theorem ms7_P_fin (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L) {u : ℝ × ℝ → ℂ}
    (hu : Measurable u) (hu2 : eLpNorm u 2 volume ≠ ⊤) : eLpNorm (monoP j κ L u) 2 volume ≠ ⊤ :=
  ((ms7_P_young j κ hL (by rw [ms7_two_toReal]; norm_num) hu).trans_lt
    (ENNReal.mul_lt_top (ms7_kerL1_lt_top κ) hu2.lt_top)).ne

/-- The three-term decomposition of `χ_q T_ψ(P_1 u_1, P_2 u_2)` along measurable sets. -/
theorem ms7_three_split {r : ℝ} (hr : 0 < r) {ψ : ℝ → ℝ} (hψ : Measurable ψ)
    (hψ1 : ∫⁻ t, ‖ψ t‖ₑ ≠ ⊤) {κ₁ κ₂ : 𝓢(ℝ, ℂ)} {L₁ L₂ : ℝ} (hL₁ : 0 < L₁) (hL₂ : 0 < L₂)
    {u₁ u₂ : ℝ × ℝ → ℂ} (hu₁ : Measurable u₁) (hu₂ : Measurable u₂)
    (h₁ : eLpNorm u₁ 2 volume ≠ ⊤) (h₂ : eLpNorm u₂ 2 volume ≠ ⊤)
    {S₁ S₂ : Set (ℝ × ℝ)} (hS₁ : MeasurableSet S₁) (hS₂ : MeasurableSet S₂) (c : ℝ × ℝ → ℂ) :
    (fun z => c z * monoT r ψ (monoP 0 κ₁ L₁ u₁) (monoP 1 κ₂ L₂ u₂) z) =ᵐ[volume]
      fun z => c z * monoT r ψ (monoP 0 κ₁ L₁ (S₁.indicator u₁)) (monoP 1 κ₂ L₂ (S₂.indicator u₂)) z
        + c z * monoT r ψ (monoP 0 κ₁ L₁ (S₁ᶜ.indicator u₁)) (monoP 1 κ₂ L₂ u₂) z
        + c z * monoT r ψ (monoP 0 κ₁ L₁ (S₁.indicator u₁)) (monoP 1 κ₂ L₂ (S₂ᶜ.indicator u₂)) z
          := by
  have hv₁ := hu₁.indicator hS₁
  have hw₁ := hu₁.indicator hS₁.compl
  have hv₂ := hu₂.indicator hS₂
  have hw₂ := hu₂.indicator hS₂.compl
  have nv₁ : eLpNorm (S₁.indicator u₁) 2 volume ≠ ⊤ := ((eLpNorm_indicator_le _
    (by measurability)).trans_lt h₁.lt_top).ne
  have nw₁ : eLpNorm (S₁ᶜ.indicator u₁) 2 volume ≠ ⊤ :=
    ((eLpNorm_indicator_le _ (by measurability)).trans_lt h₁.lt_top).ne
  have nv₂ : eLpNorm (S₂.indicator u₂) 2 volume ≠ ⊤ := ((eLpNorm_indicator_le _
    (by measurability)).trans_lt h₂.lt_top).ne
  have nw₂ : eLpNorm (S₂ᶜ.indicator u₂) 2 volume ≠ ⊤ :=
    ((eLpNorm_indicator_le _ (by measurability)).trans_lt h₂.lt_top).ne
  have e1 := ms7_T_split1 hr hψ hψ1 (ms7_measP 0 κ₁ L₁ hv₁) (ms7_measP 0 κ₁ L₁ hw₁)
    (ms7_measP 1 κ₂ L₂ hu₂) (ms7_P_fin 0 κ₁ hL₁ hv₁ nv₁) (ms7_P_fin 0 κ₁ hL₁ hw₁ nw₁)
    (ms7_P_fin 1 κ₂ hL₂ hu₂ h₂) (ms7_P_split0 κ₁ hL₁ hu₁ h₁ hS₁)
  have e2 := ms7_T_split2 hr hψ hψ1 (ms7_measP 0 κ₁ L₁ hv₁) (ms7_measP 1 κ₂ L₂ hv₂)
    (ms7_measP 1 κ₂ L₂ hw₂) (ms7_P_fin 0 κ₁ hL₁ hv₁ nv₁) (ms7_P_fin 1 κ₂ hL₂ hv₂ nv₂)
    (ms7_P_fin 1 κ₂ hL₂ hw₂ nw₂) (ms7_P_split1 κ₂ hL₂ hu₂ h₂ hS₂)
  filter_upwards [e1, e2] with z hz1 hz2
  rw [hz1, hz2]; ring

/-- **The local `L^2` estimate (7.3)** (level-set truncation route): given the bounded-input
estimate for the cutoff `χ` with constant `M`, for every `Λ > 0`,
`‖χ_q T_ψ(P_1 u_1, P_2 u_2)‖_1 ≤ (M Λ^2 + C ‖ψ‖_{C^20} Λ^{-1/6}) ‖u_1‖_2 ‖u_2‖_2`. -/
theorem ms7_localL2 {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) :
    ∃ C₁ : ℝ, 0 ≤ C₁ ∧ ∀ ψ : ℝ → ℝ, ContDiff ℝ ∞ ψ → tsupport ψ ⊆ Icc A B →
      ∀ (κ₁ κ₂ : 𝓢(ℝ, ℂ)) (L₁ L₂ : ℝ), 0 < L₁ → 0 < L₂ → ∀ M : ℝ, 0 ≤ M →
      (∀ u₁ u₂ : ℝ × ℝ → ℂ, Measurable u₁ → Measurable u₂ → ∀ B₁ B₂ : ℝ,
        (∀ z, ‖u₁ z‖ ≤ B₁) → (∀ z, ‖u₂ z‖ ≤ B₂) →
        eLpNorm (fun z => (ms7Chi z : ℂ) * monoT r ψ (monoP 0 κ₁ L₁ u₁) (monoP 1 κ₂ L₂ u₂) z)
          1 volume ≤ ENNReal.ofReal (M * B₁ * B₂)) →
      ∀ Λ : ℝ, 0 < Λ → ∀ (q : ℝ × ℝ) (u₁ u₂ : ℝ × ℝ → ℂ), Measurable u₁ → Measurable u₂ →
        eLpNorm u₁ 2 volume ≠ ⊤ → eLpNorm u₂ 2 volume ≠ ⊤ →
        eLpNorm (fun z => (ms7Chi (z - q) : ℂ) *
            monoT r ψ (monoP 0 κ₁ L₁ u₁) (monoP 1 κ₂ L₂ u₂) z) 1 volume ≤
          (ENNReal.ofReal (M * Λ ^ 2) + 2 * ENNReal.ofReal (C₁ * monoC20 ψ) *
            ENNReal.ofReal (((2 * ms7R0 r B) ^ 2) ^ (1 / 12 : ℝ)) *
            (∫⁻ s, ‖κ₁ s‖ₑ) * (∫⁻ s, ‖κ₂ s‖ₑ) * ENNReal.ofReal (Λ ^ (-(1 / 6) : ℝ))) *
          eLpNorm u₁ 2 volume * eLpNorm u₂ 2 volume := by
  obtain ⟨C₁, hC₁, hloc⟩ := ms7_loc41 hr hA hAB
  refine ⟨C₁, hC₁, fun ψ hψ hsupp κ₁ κ₂ L₁ L₂ hL₁ hL₂ M hM H Λ hΛ q u₁ u₂ hu₁ hu₂ h₁ h₂ => ?_⟩
  have hr0 : 0 < r := by linarith
  have hψm : Measurable ψ := hψ.continuous.measurable
  have hψ1 := ms7_psi_L1 hψ hsupp
  have hR0 := (ms7R0_pos (r := r) (hA.trans hAB)).le
  set D := ms7Box q (ms7R0 r B)
  set cD := ENNReal.ofReal (((2 * ms7R0 r B) ^ 2) ^ (1 / 12 : ℝ))
  set N₁ := ∫⁻ s, ‖κ₁ s‖ₑ
  set N₂ := ∫⁻ s, ‖κ₂ s‖ₑ
  set Λ' := ENNReal.ofReal (Λ ^ (-(1 / 6) : ℝ))
  set c := ENNReal.ofReal (C₁ * monoC20 ψ)
  set a₁ := (eLpNorm u₁ 2 volume).toReal
  set a₂ := (eLpNorm u₂ 2 volume).toReal
  set S₁ := {z | ‖u₁ z‖ ≤ Λ * a₁}
  set S₂ := {z | ‖u₂ z‖ ≤ Λ * a₂}
  have hS₁ : MeasurableSet S₁ := measurableSet_le hu₁.norm measurable_const
  have hS₂ : MeasurableSet S₂ := measurableSet_le hu₂.norm measurable_const
  have hv₁ := hu₁.indicator hS₁
  have hw₁ := hu₁.indicator hS₁.compl
  have hv₂ := hu₂.indicator hS₂
  have hw₂ := hu₂.indicator hS₂.compl
  have h2r : 1 < (2 : ℝ≥0∞).toReal := by rw [ms7_two_toReal]; norm_num
  have h127 : 1 < (12 / 7 : ℝ≥0∞).toReal := by rw [ms7_toReal_12_7]; norm_num
  have hχc : Continuous fun z : ℝ × ℝ => (ms7Chi (z - q) : ℂ) :=
    Complex.continuous_ofReal.comp (ms7Chi_contDiff.continuous.comp (continuous_id.sub
      continuous_const))
  have hmT : ∀ {f g : ℝ × ℝ → ℂ}, Measurable f → Measurable g →
      AEStronglyMeasurable (fun z => (ms7Chi (z - q) : ℂ) * monoT r ψ f g z) volume :=
    fun hf hg => (hχc.measurable.mul (ms7_measT hr0 hψm hf hg)).aestronglyMeasurable
  refine (ms7_eLp_three (ms7_three_split hr0 hψm hψ1 hL₁ hL₂ hu₁ hu₂ h₁ h₂ hS₁ hS₂ _)
    ).trans ?_
  -- the bounded-bounded term
  have hb₁ : ∀ z, ‖S₁.indicator u₁ z‖ ≤ Λ * a₁ := by
    intro z; by_cases hz : z ∈ S₁
    · rw [indicator_of_mem hz]; exact hz
    · rw [indicator_of_notMem hz, norm_zero]; positivity
  have hb₂ : ∀ z, ‖S₂.indicator u₂ z‖ ≤ Λ * a₂ := by
    intro z; by_cases hz : z ∈ S₂
    · rw [indicator_of_mem hz]; exact hz
    · rw [indicator_of_notMem hz, norm_zero]; positivity
  have T1 := ms7_Hinf_transl H q hv₁ hv₂ hb₁ hb₂
  have T1' : ENNReal.ofReal (M * (Λ * a₁) * (Λ * a₂)) =
      ENNReal.ofReal (M * Λ ^ 2) * eLpNorm u₁ 2 volume * eLpNorm u₂ 2 volume := by
    rw [show M * (Λ * a₁) * (Λ * a₂) = M * Λ ^ 2 * a₁ * a₂ by ring,
      ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity),
      ENNReal.ofReal_toReal h₁, ENNReal.ofReal_toReal h₂]
  -- the factor bounds
  have Fw₁ : eLpNorm (D.indicator (monoP 0 κ₁ L₁ (S₁ᶜ.indicator u₁))) (12 / 7 : ℝ≥0∞) volume ≤
      N₁ * (Λ' * eLpNorm u₁ 2 volume) :=
    (eLpNorm_indicator_le _
      (by
        exact ms7Box_meas _ _)).trans ((ms7_P_young 0 κ₁ hL₁ h127 hw₁).trans
      (ms7_mul_le_left (ms7_levelset hu₁ h₁ hΛ) _))
  have Fw₂ : eLpNorm (D.indicator (monoP 1 κ₂ L₂ (S₂ᶜ.indicator u₂))) (12 / 7 : ℝ≥0∞) volume ≤
      N₂ * (Λ' * eLpNorm u₂ 2 volume) :=
    (eLpNorm_indicator_le _
      (by
        exact ms7Box_meas _ _)).trans ((ms7_P_young 1 κ₂ hL₂ h127 hw₂).trans
      (ms7_mul_le_left (ms7_levelset hu₂ h₂ hΛ) _))
  have Fv₁ : eLpNorm (D.indicator (monoP 0 κ₁ L₁ (S₁.indicator u₁))) (12 / 7 : ℝ≥0∞) volume ≤
      cD * (N₁ * eLpNorm u₁ 2 volume) :=
    (ms7_holder_box q hR0 (ms7_measP 0 κ₁ L₁ hv₁)).trans (ms7_mul_le_left
      ((eLpNorm_indicator_le _
        (by
          exact ms7Box_meas _ _)).trans ((ms7_P_young 0 κ₁ hL₁ h2r hv₁).trans
        (ms7_mul_le_left (eLpNorm_indicator_le _
          (by
            exact hS₁)) _))) _)
  have Fu₂ : eLpNorm (D.indicator (monoP 1 κ₂ L₂ u₂)) (12 / 7 : ℝ≥0∞) volume ≤
      cD * (N₂ * eLpNorm u₂ 2 volume) :=
    (ms7_holder_box q hR0 (ms7_measP 1 κ₂ L₂ hu₂)).trans (ms7_mul_le_left
      ((eLpNorm_indicator_le _
        (by
          exact ms7Box_meas _ _)).trans (ms7_P_young 1 κ₂ hL₂ h2r hu₂)) _)
  have T2 := (hloc ψ hψ hsupp q _ _ (ms7_measP 0 κ₁ L₁ hw₁) (ms7_measP 1 κ₂ L₂ hu₂)).trans
    (mul_le_mul' (ms7_mul_le_left Fw₁ _) Fu₂)
  have T3 := (hloc ψ hψ hsupp q _ _ (ms7_measP 0 κ₁ L₁ hv₁) (ms7_measP 1 κ₂ L₂ hw₂)).trans
    (mul_le_mul' (ms7_mul_le_left Fv₁ _) Fw₂)
  calc _ ≤ ENNReal.ofReal (M * Λ ^ 2) * eLpNorm u₁ 2 volume * eLpNorm u₂ 2 volume
          + c * (N₁ * (Λ' * eLpNorm u₁ 2 volume)) * (cD * (N₂ * eLpNorm u₂ 2 volume))
          + c * (cD * (N₁ * eLpNorm u₁ 2 volume)) * (N₂ * (Λ' * eLpNorm u₂ 2 volume)) := by
        refine add_le_add (add_le_add ?_ T2) T3
        rw [← T1']; exact T1
    _ = _ := by ring

end

