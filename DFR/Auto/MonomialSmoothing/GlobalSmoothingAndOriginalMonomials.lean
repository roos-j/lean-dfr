/-! ### Section 7 basics: cutoff `χ`, boxes, measurability, translation invariance -/

/-- The fixed spatial cutoff `χ(x,y) = φ(x) φ(y)`. -/
def ms7Chi (z : ℝ × ℝ) : ℝ := monoPhi z.1 * monoPhi z.2

theorem ms7_monoPhi_nonneg (x : ℝ) : 0 ≤ monoPhi x := Real.smoothTransition.nonneg _

theorem ms7_monoPhi_le_one (x : ℝ) : monoPhi x ≤ 1 := Real.smoothTransition.le_one _

theorem ms7Chi_contDiff : ContDiff ℝ ∞ ms7Chi :=
  (monoPhi_contDiff.comp contDiff_fst).mul (monoPhi_contDiff.comp contDiff_snd)

@[fun_prop] theorem ms7Chi_continuous : Continuous ms7Chi := ms7Chi_contDiff.continuous


theorem ms7Chi_nonneg (z : ℝ × ℝ) : 0 ≤ ms7Chi z :=
  mul_nonneg (ms7_monoPhi_nonneg _) (ms7_monoPhi_nonneg _)

theorem ms7Chi_le_one (z : ℝ × ℝ) : ms7Chi z ≤ 1 :=
  ((mul_le_of_le_one_left (ms7_monoPhi_nonneg _) (ms7_monoPhi_le_one _)).trans (ms7_monoPhi_le_one
    _))

theorem ms7_abs_lt_two_of_monoPhi_ne {x : ℝ} (h : monoPhi x ≠ 0) : |x| < 2 := by
  by_contra h'
  exact h (monoPhi_eq_zero (not_lt.mp h'))

theorem ms7Chi_ne_zero {z : ℝ × ℝ} (h : ms7Chi z ≠ 0) : |z.1| < 2 ∧ |z.2| < 2 := by
  unfold ms7Chi at h
  exact ⟨ms7_abs_lt_two_of_monoPhi_ne (left_ne_zero_of_mul h),
    ms7_abs_lt_two_of_monoPhi_ne (right_ne_zero_of_mul h)⟩

theorem ms7Chi_hasCompactSupport : HasCompactSupport ms7Chi := by
  refine HasCompactSupport.of_support_subset_isCompact
    ((isCompact_Icc (a := (-2 : ℝ)) (b := 2)).prod (isCompact_Icc (a := (-2 : ℝ)) (b := 2))) ?_
  intro z hz
  obtain ⟨h1, h2⟩ := ms7Chi_ne_zero hz
  rw [abs_lt] at h1 h2
  exact ⟨⟨h1.1.le, h1.2.le⟩, ⟨h2.1.le, h2.2.le⟩⟩

/-- The closed box `q + [-R,R]^2`. -/
def ms7Box (q : ℝ × ℝ) (R : ℝ) : Set (ℝ × ℝ) := {z | |z.1 - q.1| ≤ R ∧ |z.2 - q.2| ≤ R}

theorem ms7Box_eq (q : ℝ × ℝ) (R : ℝ) :
    ms7Box q R = Icc (q.1 - R) (q.1 + R) ×ˢ Icc (q.2 - R) (q.2 + R) := by
  ext z
  simp only [ms7Box, mem_ofPred_eq, mem_prod, mem_Icc, abs_le]
  constructor <;> rintro ⟨⟨a, b⟩, c, d⟩ <;> refine ⟨⟨?_, ?_⟩, ?_, ?_⟩ <;> linarith

theorem ms7Box_meas (q : ℝ × ℝ) (R : ℝ) : MeasurableSet (ms7Box q R) := by
  rw [ms7Box_eq]; exact measurableSet_Icc.prod measurableSet_Icc

theorem ms7Box_vol (q : ℝ × ℝ) {R : ℝ} (hR : 0 ≤ R) :
    volume (ms7Box q R) = ENNReal.ofReal ((2 * R) ^ 2) := by
  rw [ms7Box_eq, Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Icc, Real.volume_Icc,
    ← ENNReal.ofReal_mul (by linarith)]
  congr 1; ring

theorem ms7Box_comm {q z : ℝ × ℝ} {R : ℝ} : z ∈ ms7Box q R ↔ q ∈ ms7Box z R := by
  simp only [ms7Box, mem_ofPred_eq, abs_sub_comm]

