/-! ### Lc09: the main term via the Fourier kernel bound (5.9)-(5.10) -/
theorem mlc_lintegral_comp_mul {a : ℝ} (ha : 0 < a) (f : ℝ → ℝ≥0∞) :
    ∫⁻ s, f (a * s) = ENNReal.ofReal a⁻¹ * ∫⁻ s, f s := by
  have := lintegral_map_equiv f (Homeomorph.mulLeft₀ a ha.ne').toMeasurableEquiv (μ := volume)
  rw [show (∫⁻ s, f (a * s)) = ∫⁻ s, f ((Homeomorph.mulLeft₀ a ha.ne').toMeasurableEquiv s) from
    rfl,
    ← this]
  have e2 : ⇑(Homeomorph.mulLeft₀ a ha.ne').toMeasurableEquiv = (a * ·) := rfl
  rw [e2, Real.map_volume_mul_left ha.ne', lintegral_smul_measure, abs_of_pos (inv_pos.mpr ha),
    smul_eq_mul]

theorem mlc_meas_X1 {u : ℝ × ℝ → ℂ} (hu : Measurable u) (h q : ℝ) :
    Measurable (fun s => ∫⁻ ξ, ‖mfkF2 (mlcD1 u s) ξ‖ₑ ^ 2 * mlcW h q ξ) :=
  (((mlc_meas_F2D1 hu).enorm.pow_const 2).mul ((mlcW_measurable h q).comp
    measurable_snd)).lintegral_prod_right'

theorem mlc_meas_X2 {u : ℝ × ℝ → ℂ} (hu : Measurable u) (h q : ℝ) :
    Measurable (fun s => ∫⁻ ξ, ‖mfkF2 (mlcD2 u s) ξ‖ₑ ^ 2 * mlcW h q ξ) :=
  (((mlc_meas_F2D2 hu).enorm.pow_const 2).mul ((mlcW_measurable h q).comp
    measurable_snd)).lintegral_prod_right'

/-- Cauchy-Schwarz with square roots. -/
theorem mlc_lintegral_sqrt_mul_le {f g : ℝ → ℝ≥0∞} (hf : Measurable f) (hg : Measurable g) :
    ∫⁻ s, f s ^ (1 / 2 : ℝ) * g s ^ (1 / 2 : ℝ) ≤
      (∫⁻ s, f s) ^ (1 / 2 : ℝ) * (∫⁻ s, g s) ^ (1 / 2 : ℝ) := by
  have h := ENNReal.lintegral_mul_le_Lp_mul_Lq volume Real.HolderConjugate.two_two
    ((hf.pow_const (1 / 2 : ℝ)).aemeasurable) ((hg.pow_const (1 / 2 : ℝ)).aemeasurable)
  have e : ∀ x : ℝ≥0∞, (x ^ (1 / 2 : ℝ)) ^ (2 : ℝ) = x := fun x => by
    rw [← ENNReal.rpow_mul]; norm_num
  simp only [Pi.mul_apply, e] at h
  exact h

namespace MlcPair

variable {r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb : ℝ} {ψ : ℝ → ℝ} {u₁ u₂ : ℝ × ℝ → ℂ}

theorem amp_le (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) (x0 y0 t0 s : ℝ)
    (p : (ℝ × ℝ) × ℝ) : ‖mlcAmp ψ C0 h x0 y0 t0 s p‖ ≤ 1 := by
  unfold mlcAmp
  rw [Complex.norm_real, Real.norm_eq_abs, abs_mul, abs_mul, abs_mul, abs_mul]
  exact ((mul_le_of_le_one_left (by positivity) (((mul_le_of_le_one_left (abs_nonneg _)
    (((mul_le_of_le_one_left (abs_nonneg _) (P.psi_le _)).trans (P.psi_le _)))).trans
    (mlc_abs_phi_le _)))).trans (((mul_le_of_le_one_left (abs_nonneg _) (mlc_abs_phi_le _)).trans
    (mlc_abs_phi_le _))))

theorem meas_PhiM (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) :
    Measurable (mlcPhiM r ψ C0 h a₁ b₁ a₂ tb u₁ u₂) := by
  have hu1 := P.hu₁.1
  have hu2 := P.hu₂.1
  have hψm := P.hψ.continuous.measurable
  have hφm := monoPhi_contDiff.continuous.measurable
  unfold mlcPhiM mlcD1 mlcD2 mlcAmp
  refine Measurable.mul (Measurable.mul ?_ ?_) ?_
  · exact (hu1.comp (by fun_prop)).mul (continuous_star.measurable.comp (hu1.comp (by fun_prop)))
  · exact (hu2.comp (by fun_prop)).mul (continuous_star.measurable.comp (hu2.comp (by fun_prop)))
  · refine Complex.measurable_ofReal.comp ?_
    refine Measurable.mul (Measurable.mul (Measurable.mul ?_ ?_) ?_) (Measurable.mul ?_ ?_)
    · exact hψm.comp (by fun_prop)
    · exact hψm.comp (by fun_prop)
    · exact hφm.comp (by fun_prop)
    · exact hφm.comp (by fun_prop)
    · exact hφm.comp (by fun_prop)

theorem integrable_PhiM (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) :
    Integrable (mlcPhiM r ψ C0 h a₁ b₁ a₂ tb u₁ u₂) := by
  have hmS : MeasurableSet (mlcSerr C0 h a₁ b₁ a₂) :=
    ((mlcBox_measurable _ _ _).prod measurableSet_Icc).prod measurableSet_Icc
  refine mlc_integrable_of_bdd hmS (by rw [P.volume_mlcSerr]; exact ENNReal.ofReal_ne_top)
    P.meas_PhiM.aestronglyMeasurable (M := B₁ * B₁ * (B₂ * B₂) * 1) (fun p => ?_) (fun p hp => ?_)
  · unfold mlcPhiM
    rw [norm_mul, norm_mul]
    exact mul_le_mul (mul_le_mul ((P.hu₁.D1 _).2.1 _) ((P.hu₂.D2 _).2.1 _) (norm_nonneg _)
      (mul_nonneg P.B₁_nonneg P.B₁_nonneg)) (P.amp_le _ _ _ _ _) (norm_nonneg _)
      (mul_nonneg (mul_nonneg P.B₁_nonneg P.B₁_nonneg) (mul_nonneg P.B₂_nonneg P.B₂_nonneg))
  · obtain ⟨⟨⟨x, y⟩, t⟩, s⟩ := p
    unfold mlcPhiM mlcD1 mlcD2 at hp
    simp only [ne_eq, mul_eq_zero, not_or, star_eq_zero] at hp
    obtain ⟨⟨⟨h1, h2⟩, ⟨h3, -⟩⟩, -⟩ := hp
    have e1 := P.hu₁.2.2 _ h1
    have e2 := P.hu₁.2.2 _ h2
    have e3 := P.hu₂.2.2 _ h3
    simp only at e1 e2 e3
    obtain ⟨e1a, -⟩ := e1
    obtain ⟨e2a, e2b⟩ := e2
    obtain ⟨e3a, -⟩ := e3
    rw [abs_le] at e1a e2a e3a
    refine ⟨⟨mem_mlcBox ⟨abs_le.mpr e3a, e2b⟩, ?_, ?_⟩, ?_, ?_⟩ <;> simp only <;> linarith

/-- **Step 4**: the main term, (5.9)-(5.10) with Cauchy-Schwarz in `s`. -/
theorem step4 (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) {Cm : ℝ}
    (hCm : ∀ (h q c x0 y0 t0 : ℝ), 0 < h → h ≤ 1 → q ∈ Set.Icc (monoq r A) (monoq r B) →
      ∀ A : (ℝ × ℝ) × ℝ → ℂ, Continuous A →
      (∀ p, A p ≠ 0 → |p.1.1 - x0| ≤ mlcLam C0 * h ∧ |p.1.2 - y0| ≤ mlcLam C0 * h ∧
        |p.2 - t0| ≤ mlcLam C0 * h) →
      (∀ y t, ContDiff ℝ 12 (fun x => A ((x, y), t)) ∧ ∀ k ≤ 12, ∀ x,
          ‖iteratedDeriv k (fun x => A ((x, y), t)) x‖ ≤ mlcLam C0 * h ^ (-(k : ℝ))) →
      (∀ x t, ContDiff ℝ 12 (fun y => A ((x, y), t)) ∧ ∀ k ≤ 12, ∀ y,
          ‖iteratedDeriv k (fun y => A ((x, y), t)) y‖ ≤ mlcLam C0 * h ^ (-(k : ℝ))) →
      (∀ x y, ContDiff ℝ 12 (fun t => A ((x, y), t)) ∧ ∀ k ≤ 12, ∀ t,
          ‖iteratedDeriv k (fun t => A ((x, y), t)) t‖ ≤ mlcLam C0 * h ^ (-(k : ℝ))) →
      ∀ F₁ F₂ : ℝ × ℝ → ℂ, Measurable F₁ → Measurable F₂ → Integrable F₁ volume →
        Integrable F₂ volume → MemLp F₁ 2 volume → MemLp F₂ 2 volume →
        ‖∫ p : (ℝ × ℝ) × ℝ, F₁ (p.1.1 + p.2, p.1.2) * F₂ (p.1.1, p.1.2 + c + q * p.2) * A p‖ₑ
          ≤ ENNReal.ofReal (Cm * h) *
            (∫⁻ ξ, ‖mfkF2 F₁ ξ‖ₑ ^ 2 * ENNReal.ofReal ((1 + |h * (ξ.1 - q * ξ.2)|) ^ (-8 : ℝ))) ^
              (1/2 : ℝ) *
            (∫⁻ ξ, ‖mfkF2 F₂ ξ‖ₑ ^ 2 * ENNReal.ofReal ((1 + |h * (ξ.1 - q * ξ.2)|) ^ (-8 : ℝ))) ^
              (1/2 : ℝ)) :
    ‖∫ p, mlcPhiM r ψ C0 h a₁ b₁ a₂ tb u₁ u₂ p‖ₑ ≤
      ENNReal.ofReal (Cm * h) * (mlcX1 h (monoq r tb) u₁) ^ (1 / 2 : ℝ) *
        (ENNReal.ofReal (monoq r tb)⁻¹ * mlcX2 h (monoq r tb) u₂) ^ (1 / 2 : ℝ) := by
  set qb := monoq r tb with hqb
  have hqb0 : 0 < qb := mlc_q_pos (by linarith [P.hr]) (P.hA.trans_le P.htb.1)
  have hqI : qb ∈ Icc (monoq r A) (monoq r B) :=
    ⟨mlc_q_mono P.hr P.hA P.hAB ⟨le_rfl, P.hAB.le⟩ P.htb P.htb.1,
      mlc_q_mono P.hr P.hA P.hAB P.htb ⟨P.hAB.le, le_rfl⟩ P.htb.2⟩
  have hint := P.integrable_PhiM
  have hsplit : ∫ p, mlcPhiM r ψ C0 h a₁ b₁ a₂ tb u₁ u₂ p =
      ∫ s, ∫ p', mlcPhiM r ψ C0 h a₁ b₁ a₂ tb u₁ u₂ (p', s) := by
    rw [Measure.volume_eq_prod, integral_prod_symm _ (by rw [← Measure.volume_eq_prod]; exact hint)]
  set X : ℝ → ℝ≥0∞ := fun s => ∫⁻ ξ, ‖mfkF2 (mlcD1 u₁ s) ξ‖ₑ ^ 2 * mlcW h qb ξ
  set Y : ℝ → ℝ≥0∞ := fun s => ∫⁻ ξ, ‖mfkF2 (mlcD2 u₂ s) ξ‖ₑ ^ 2 * mlcW h qb ξ
  have hG : ∀ s, ‖∫ p', mlcPhiM r ψ C0 h a₁ b₁ a₂ tb u₁ u₂ (p', s)‖ₑ ≤
      ENNReal.ofReal (Cm * h) * (X s ^ (1 / 2 : ℝ) * Y (qb * s) ^ (1 / 2 : ℝ)) := by
    intro s
    obtain ⟨a1, a2, a3, a4, a5⟩ := mlc_amp_hyp P.hψ P.hsupp P.hC20 P.hC0 P.hh P.hh1 a₂ b₁ (a₁ -
      a₂) s
    have := hCm h qb (monoQ r tb - qb * tb) a₂ b₁ (a₁ - a₂) P.hh P.hh1 hqI _ a1 a2 a3 a4 a5
      (mlcD1 u₁ s) (mlcD2 u₂ (qb * s)) (P.hu₁.D1 s).1 (P.hu₂.D2 _).1 (P.hu₁.D1 s).integrable
      (P.hu₂.D2 _).integrable ((P.hu₁.D1 s).memLp 2) ((P.hu₂.D2 _).memLp 2)
    rw [← mul_assoc]
    exact this
  have hX := mlc_meas_X1 P.hu₁.1 h qb
  have hY := (mlc_meas_X2 P.hu₂.1 h qb).comp (measurable_const_mul qb)
  rw [hsplit]
  calc ‖∫ s, ∫ p', mlcPhiM r ψ C0 h a₁ b₁ a₂ tb u₁ u₂ (p', s)‖ₑ
      ≤ ∫⁻ s, ‖∫ p', mlcPhiM r ψ C0 h a₁ b₁ a₂ tb u₁ u₂ (p', s)‖ₑ :=
        enorm_integral_le_lintegral_enorm _
    _ ≤ ∫⁻ s, ENNReal.ofReal (Cm * h) * (X s ^ (1 / 2 : ℝ) * Y (qb * s) ^ (1 / 2 : ℝ)) :=
        lintegral_mono hG
    _ = ENNReal.ofReal (Cm * h) * ∫⁻ s, X s ^ (1 / 2 : ℝ) * Y (qb * s) ^ (1 / 2 : ℝ) :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
    _ ≤ ENNReal.ofReal (Cm * h) * ((∫⁻ s, X s) ^ (1 / 2 : ℝ) * (∫⁻ s, Y (qb * s)) ^ (1 / 2 : ℝ))
      := by
        gcongr
        exact mlc_lintegral_sqrt_mul_le hX hY
    _ = _ := by
        rw [mlc_lintegral_comp_mul hqb0 Y, mul_assoc]
        rfl

end MlcPair

