namespace Auto

noncomputable section

/-! ### Globalization: covering by the translates `χ(· - q)` and the per-`q` bound -/

/-- **Covering**: `4 ‖T‖_1 ≤ ∫_q ‖χ(· - q) T‖_1`, since `χ(z - q) = 1` for `q ∈ z + [-1,1]^2`. -/
theorem ms7_cover {T : ℝ × ℝ → ℂ} (hT : Measurable T) :
    ENNReal.ofReal 4 * eLpNorm T 1 volume ≤
      ∫⁻ q, eLpNorm (fun z => (ms7Chi (z - q) : ℂ) * T z) 1 volume := by
  rw [eLpNorm_one_eq_lintegral_enorm hT.aestronglyMeasurable]
  have hnorm (q : ℝ × ℝ) :
      eLpNorm (fun z => (ms7Chi (z - q) : ℂ) * T z) 1 volume =
        ∫⁻ z, ‖(ms7Chi (z - q) : ℂ) * T z‖ₑ :=
    eLpNorm_one_eq_lintegral_enorm
      (((Complex.continuous_ofReal.comp (ms7Chi_contDiff.continuous.comp
        (continuous_id.sub continuous_const))).measurable.mul hT).aestronglyMeasurable)
  simp_rw [hnorm]
  have hχc : Continuous fun p : (ℝ × ℝ) × (ℝ × ℝ) => (ms7Chi (p.1 - p.2) : ℂ) :=
    Complex.continuous_ofReal.comp (ms7Chi_contDiff.continuous.comp (continuous_fst.sub
      continuous_snd))
  have hm : Measurable (Function.uncurry fun (z q : ℝ × ℝ) => ‖(ms7Chi (z - q) : ℂ) * T z‖ₑ) :=
    (hχc.measurable.mul (hT.comp measurable_fst)).enorm
  rw [← lintegral_lintegral_swap hm.aemeasurable, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine lintegral_mono fun z => ?_
  calc ENNReal.ofReal 4 * ‖T z‖ₑ = ∫⁻ q, (ms7Box z 1).indicator (fun _ => ‖T z‖ₑ) q := by
        rw [lintegral_indicator_const (ms7Box_meas z 1), ms7Box_vol z zero_le_one, mul_comm]
        norm_num
    _ ≤ ∫⁻ q, ‖(ms7Chi (z - q) : ℂ) * T z‖ₑ := by
        refine lintegral_mono fun q => ?_
        by_cases hq : q ∈ ms7Box z 1
        · rw [indicator_of_mem hq]
          have h1 : ms7Chi (z - q) = 1 := by
            simp only [ms7Box, mem_ofPred_eq] at hq
            unfold ms7Chi
            rw [monoPhi_eq_one (by rw [Prod.fst_sub, abs_sub_comm]; exact hq.1),
              monoPhi_eq_one (by rw [Prod.snd_sub, abs_sub_comm]; exact hq.2), mul_one]
          rw [h1, Complex.ofReal_one, one_mul]
        · rw [indicator_of_notMem hq]; exact bot_le

/-- **The per-`q` bound** combining (7.3) for the near parts with the localized trivial bound and
the spatial tails (7.4) for the far parts. -/
theorem ms7_perq {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) {C₁ : ℝ}
    (hloc : ∀ ψ : ℝ → ℝ, ContDiff ℝ ∞ ψ → tsupport ψ ⊆ Icc A B →
      ∀ (q : ℝ × ℝ) (f g : ℝ × ℝ → ℂ), Measurable f → Measurable g →
        eLpNorm (fun z => (ms7Chi (z - q) : ℂ) * monoT r ψ f g z) 1 volume ≤
          ENNReal.ofReal (C₁ * monoC20 ψ) *
            eLpNorm ((ms7Box q (ms7R0 r B)).indicator f) (12 / 7 : ℝ≥0∞) volume *
            eLpNorm ((ms7Box q (ms7R0 r B)).indicator g) (12 / 7 : ℝ≥0∞) volume)
    {ψ : ℝ → ℝ} (hψ : ContDiff ℝ ∞ ψ) (hsupp : tsupport ψ ⊆ Icc A B)
    {κ₁ κ₂ : 𝓢(ℝ, ℂ)} {L₁ L₂ : ℝ} (hL₁ : 0 < L₁) (hL₂ : 0 < L₂) {M₂ : ℝ≥0∞}
    (HL2 : ∀ (q : ℝ × ℝ) (u₁ u₂ : ℝ × ℝ → ℂ), Measurable u₁ → Measurable u₂ →
        eLpNorm u₁ 2 volume ≠ ⊤ → eLpNorm u₂ 2 volume ≠ ⊤ →
        eLpNorm (fun z => (ms7Chi (z - q) : ℂ) *
            monoT r ψ (monoP 0 κ₁ L₁ u₁) (monoP 1 κ₂ L₂ u₂) z) 1 volume ≤
          M₂ * eLpNorm u₁ 2 volume * eLpNorm u₂ 2 volume)
    {R₁ : ℝ} {u₁ u₂ : ℝ × ℝ → ℂ} (hu₁ : Measurable u₁) (hu₂ : Measurable u₂)
    (h₁ : eLpNorm u₁ 2 volume ≠ ⊤) (h₂ : eLpNorm u₂ 2 volume ≠ ⊤) (q : ℝ × ℝ) :
    eLpNorm (fun z => (ms7Chi (z - q) : ℂ) *
        monoT r ψ (monoP 0 κ₁ L₁ u₁) (monoP 1 κ₂ L₂ u₂) z) 1 volume ≤
      M₂ * ms7Loc (fun z => ‖u₁ z‖ₑ) (ms7R0 r B + R₁) q *
          ms7Loc (fun z => ‖u₂ z‖ₑ) (ms7R0 r B + R₁) q +
        ENNReal.ofReal (C₁ * monoC20 ψ) * ENNReal.ofReal (((2 * ms7R0 r B) ^ 2) ^ (1 / 12 : ℝ)) *
          ENNReal.ofReal (((2 * ms7R0 r B) ^ 2) ^ (1 / 12 : ℝ)) *
          (ms7Loc (ms7G 0 κ₁ L₁ R₁ u₁) (ms7R0 r B) q * ms7Loc (ms7H 1 κ₂ L₂ u₂) (ms7R0 r B) q +
           ms7Loc (ms7H 0 κ₁ L₁ u₁) (ms7R0 r B) q * ms7Loc (ms7G 1 κ₂ L₂ R₁ u₂) (ms7R0 r B) q) := by
  have hr0 : 0 < r := by linarith
  have hψm : Measurable ψ := hψ.continuous.measurable
  have hψ1 := ms7_psi_L1 hψ hsupp
  have hR0 := (ms7R0_pos (r := r) (hA.trans hAB)).le
  set R₀ := ms7R0 r B
  set Bx := ms7Box q (R₀ + R₁)
  set cD := ENNReal.ofReal (((2 * R₀) ^ 2) ^ (1 / 12 : ℝ))
  set c := ENNReal.ofReal (C₁ * monoC20 ψ)
  have hB : MeasurableSet Bx := ms7Box_meas q _
  have hv₁ := hu₁.indicator hB
  have hw₁ := hu₁.indicator hB.compl
  have hv₂ := hu₂.indicator hB
  have hw₂ := hu₂.indicator hB.compl
  have hχc : Continuous fun z : ℝ × ℝ => (ms7Chi (z - q) : ℂ) :=
    Complex.continuous_ofReal.comp (ms7Chi_contDiff.continuous.comp (continuous_id.sub
      continuous_const))
  have hmT : ∀ {f g : ℝ × ℝ → ℂ}, Measurable f → Measurable g →
      AEStronglyMeasurable (fun z => (ms7Chi (z - q) : ℂ) * monoT r ψ f g z) volume :=
    fun hf hg => (hχc.measurable.mul (ms7_measT hr0 hψm hf hg)).aestronglyMeasurable
  refine (ms7_eLp_three (ms7_three_split hr0 hψm hψ1 hL₁ hL₂ hu₁ hu₂ h₁ h₂ hB hB _)
    ).trans ?_
  have nv₁ : eLpNorm (Bx.indicator u₁) 2 volume ≠ ⊤ := ((eLpNorm_indicator_le _
    (by measurability)).trans_lt h₁.lt_top).ne
  have nv₂ : eLpNorm (Bx.indicator u₂) 2 volume ≠ ⊤ := ((eLpNorm_indicator_le _
    (by measurability)).trans_lt h₂.lt_top).ne
  have T1 := HL2 q _ _ hv₁ hv₂ nv₁ nv₂
  have L₁b : eLpNorm (Bx.indicator u₁) 2 volume ≤ ms7Loc (fun z => ‖u₁ z‖ₑ) (R₀ + R₁) q :=
    ms7_eLp_box_le fun z _ => le_rfl
  have L₂b : eLpNorm (Bx.indicator u₂) 2 volume ≤ ms7Loc (fun z => ‖u₂ z‖ₑ) (R₀ + R₁) q :=
    ms7_eLp_box_le fun z _ => le_rfl
  have Fw₁ : eLpNorm ((ms7Box q R₀).indicator (monoP 0 κ₁ L₁ (Bxᶜ.indicator u₁)))
      (12 / 7 : ℝ≥0∞) volume ≤ cD * ms7Loc (ms7G 0 κ₁ L₁ R₁ u₁) R₀ q :=
    (ms7_holder_box q hR0 (ms7_measP 0 κ₁ L₁ hw₁)).trans
      (ms7_mul_le_left (ms7_eLp_box_le fun z hz => ms7_far_le 0 κ₁ L₁ u₁ hz) _)
  have Fw₂ : eLpNorm ((ms7Box q R₀).indicator (monoP 1 κ₂ L₂ (Bxᶜ.indicator u₂)))
      (12 / 7 : ℝ≥0∞) volume ≤ cD * ms7Loc (ms7G 1 κ₂ L₂ R₁ u₂) R₀ q :=
    (ms7_holder_box q hR0 (ms7_measP 1 κ₂ L₂ hw₂)).trans
      (ms7_mul_le_left (ms7_eLp_box_le fun z hz => ms7_far_le 1 κ₂ L₂ u₂ hz) _)
  have Fv₁ : eLpNorm ((ms7Box q R₀).indicator (monoP 0 κ₁ L₁ (Bx.indicator u₁)))
      (12 / 7 : ℝ≥0∞) volume ≤ cD * ms7Loc (ms7H 0 κ₁ L₁ u₁) R₀ q :=
    (ms7_holder_box q hR0 (ms7_measP 0 κ₁ L₁ hv₁)).trans
      (ms7_mul_le_left (ms7_eLp_box_le fun z _ => ms7_P_ind_le_H 0 κ₁ L₁ u₁ _ z) _)
  have Fu₂ : eLpNorm ((ms7Box q R₀).indicator (monoP 1 κ₂ L₂ u₂))
      (12 / 7 : ℝ≥0∞) volume ≤ cD * ms7Loc (ms7H 1 κ₂ L₂ u₂) R₀ q :=
    (ms7_holder_box q hR0 (ms7_measP 1 κ₂ L₂ hu₂)).trans
      (ms7_mul_le_left (ms7_eLp_box_le fun z _ => ms7_P_le_H 1 κ₂ L₂ u₂ z) _)
  have T2 := (hloc ψ hψ hsupp q _ _ (ms7_measP 0 κ₁ L₁ hw₁) (ms7_measP 1 κ₂ L₂ hu₂)).trans
    (mul_le_mul' (ms7_mul_le_left Fw₁ _) Fu₂)
  have T3 := (hloc ψ hψ hsupp q _ _ (ms7_measP 0 κ₁ L₁ hv₁) (ms7_measP 1 κ₂ L₂ hw₂)).trans
    (mul_le_mul' (ms7_mul_le_left Fv₁ _) Fw₂)
  calc _ ≤ M₂ * ms7Loc (fun z => ‖u₁ z‖ₑ) (R₀ + R₁) q * ms7Loc (fun z => ‖u₂ z‖ₑ) (R₀ + R₁) q
          + c * (cD * ms7Loc (ms7G 0 κ₁ L₁ R₁ u₁) R₀ q) * (cD * ms7Loc (ms7H 1 κ₂ L₂ u₂) R₀ q)
          + c * (cD * ms7Loc (ms7H 0 κ₁ L₁ u₁) R₀ q) * (cD * ms7Loc (ms7G 1 κ₂ L₂ R₁ u₂) R₀ q) := by
        refine add_le_add (add_le_add (T1.trans ?_) T2) T3
        exact mul_le_mul' (ms7_mul_le_left L₁b _) L₂b
    _ = _ := by ring

end

end Auto

