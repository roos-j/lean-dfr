/-! ### Choice of parameters: `Λ = L^{6σ/13}`, `R_1 = L^{σ/39}` -/
theorem ms7_rpow_facts {L t : ℝ} (hL : 1 ≤ L) (ht : 0 < t) :
    L ^ (-(13 * t)) * (L ^ (6 * t)) ^ 2 = L ^ (-t) ∧
    (L ^ (6 * t)) ^ (-(1 / 6) : ℝ) = L ^ (-t) ∧
    1 ≤ L ^ (t / 3) ∧
    (L ^ (t / 3)) ^ 2 = L ^ (2 * t / 3) ∧
    (L ^ (t / 3))⁻¹ = L ^ (-(t / 3)) ∧
    L ^ (-t) * L ^ (2 * t / 3) = L ^ (-(t / 3)) := by
  have hL0 : 0 < L := by linarith
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [← Real.rpow_natCast, ← Real.rpow_mul hL0.le, ← Real.rpow_add hL0]
    congr 1; push_cast; ring
  · rw [← Real.rpow_mul hL0.le]; congr 1; ring
  · exact Real.one_le_rpow hL (by positivity)
  · rw [← Real.rpow_natCast, ← Real.rpow_mul hL0.le]; congr 1; push_cast; ring
  · rw [Real.rpow_neg hL0.le]
  · rw [← Real.rpow_add hL0]; congr 1; ring

/-- One input configuration: from the bounded-input estimate with constant `C ‖ψ‖ L^{-σ}` to the
global `L^2` estimate with exponent `σ/39`. -/
theorem ms7_config {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) {C σ : ℝ} (hC : 0 < C)
    (hσ : 0 < σ) (κ₁ κ₂ : 𝓢(ℝ, ℂ)) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ ψ : ℝ → ℝ, ContDiff ℝ ∞ ψ → tsupport ψ ⊆ Icc A B →
      ∀ L L₁ L₂ : ℝ, 1 ≤ L → 1 / 2 ≤ L₁ → 1 / 2 ≤ L₂ →
      (∀ u₁ u₂ : ℝ × ℝ → ℂ, Measurable u₁ → Measurable u₂ → ∀ B₁ B₂ : ℝ,
        (∀ z, ‖u₁ z‖ ≤ B₁) → (∀ z, ‖u₂ z‖ ≤ B₂) →
        eLpNorm (fun z => (ms7Chi z : ℂ) * monoT r ψ (monoP 0 κ₁ L₁ u₁) (monoP 1 κ₂ L₂ u₂) z)
          1 volume ≤ ENNReal.ofReal (C * monoC20 ψ * L ^ (-σ) * B₁ * B₂)) →
      ∀ u₁ u₂ : ℝ × ℝ → ℂ, Measurable u₁ → Measurable u₂ →
        eLpNorm u₁ 2 volume ≠ ⊤ → eLpNorm u₂ 2 volume ≠ ⊤ →
        eLpNorm (monoT r ψ (monoP 0 κ₁ L₁ u₁) (monoP 1 κ₂ L₂ u₂)) 1 volume ≤
          ENNReal.ofReal (K * monoC20 ψ * L ^ (-(σ / 39))) *
            (eLpNorm u₁ 2 volume * eLpNorm u₂ 2 volume) := by
  obtain ⟨C₁, hC₁, hL2⟩ := ms7_localL2 hr hA hAB
  obtain ⟨C₂, hC₂, hloc⟩ := ms7_loc41 hr hA hAB
  have hR0 := (ms7R0_pos (r := r) (hA.trans hAB)).le
  set R₀ := ms7R0 r B with hR₀def
  set cd : ℝ := ((2 * R₀) ^ 2) ^ (1 / 12 : ℝ) with hcd
  have hcd0 : 0 ≤ cd := by positivity
  set n₁ : ℝ := (∫⁻ s, ‖κ₁ s‖ₑ).toReal
  set n₂ : ℝ := (∫⁻ s, ‖κ₂ s‖ₑ).toReal
  have hn₁ : 0 ≤ n₁ := ENNReal.toReal_nonneg
  have hn₂ : 0 ≤ n₂ := ENNReal.toReal_nonneg
  set m₁ := ms7M1 κ₁
  set m₂ := ms7M1 κ₂
  have hm₁ : 0 ≤ m₁ := ms7_M1_nonneg κ₁
  have hm₂ : 0 ≤ m₂ := ms7_M1_nonneg κ₂
  set v₀ : ℝ := (2 * R₀) ^ 2
  have hv₀ : 0 ≤ v₀ := by positivity
  set K : ℝ := (C + 2 * C₁ * cd * n₁ * n₂) * (4 * (R₀ + 1) ^ 2) +
    C₂ * cd * cd * v₀ * (2 * m₁ * n₂ + n₁ * (2 * m₂))
  refine ⟨K, by positivity, ?_⟩
  intro ψ hψ hsupp L L₁ L₂ hL hL₁ hL₂ H u₁ u₂ hu₁ hu₂ h₁ h₂
  have hL0 : 0 < L := by linarith
  have hL₁0 : 0 < L₁ := by linarith
  have hL₂0 : 0 < L₂ := by linarith
  set p := monoC20 ψ
  have hp : 0 ≤ p := ms7_C20_nonneg hψ hsupp
  set t := σ / 13 with ht_def
  have ht : 0 < t := by positivity
  obtain ⟨f1, f2, f3, f4, f5, f6⟩ := ms7_rpow_facts hL ht
  set Λ := L ^ (6 * t)
  set R₁ := L ^ (t / 3)
  have hΛ : 0 < Λ := by positivity
  have hM : 0 ≤ C * p * L ^ (-σ) := by positivity
  have HL2 := fun q u₁ u₂ hu₁ hu₂ h₁ h₂ =>
    hL2 ψ hψ hsupp κ₁ κ₂ L₁ L₂ hL₁0 hL₂0 (C * p * L ^ (-σ)) hM H Λ hΛ q u₁ u₂ hu₁ hu₂ h₁ h₂
  have G := ms7_glob_bound hr hA hAB hloc hψ hsupp hL₁0 hL₂0 HL2 (R₁ := R₁) (by positivity)
    hu₁ hu₂ h₁ h₂
  have hN₁ : (∫⁻ s, ‖κ₁ s‖ₑ) = ENNReal.ofReal n₁ := (ENNReal.ofReal_toReal (ms7_kerL1_lt_top
    κ₁).ne).symm
  have hN₂ : (∫⁻ s, ‖κ₂ s‖ₑ) = ENNReal.ofReal n₂ := (ENNReal.ofReal_toReal (ms7_kerL1_lt_top
    κ₂).ne).symm
  have e1 : C * p * L ^ (-σ) * Λ ^ 2 = C * p * L ^ (-t) := by
    rw [show σ = 13 * t by rw [ht_def]; ring, mul_assoc, f1]
  have b1 : (2 * (R₀ + R₁)) ^ 2 ≤ 4 * (R₀ + 1) ^ 2 * L ^ (2 * t / 3) := by
    rw [← f4]
    have : R₀ + R₁ ≤ (R₀ + 1) * R₁ := by nlinarith
    have h0 : 0 ≤ R₀ + R₁ := by positivity
    nlinarith
  have b2 : ∀ κ : 𝓢(ℝ, ℂ), ∀ L' : ℝ, 1 / 2 ≤ L' →
      ∫⁻ s, ms7Tail κ L' R₁ s ≤ ENNReal.ofReal (2 * ms7M1 κ * L ^ (-(t / 3))) := by
    intro κ L' hL'
    refine (ms7_tail_le κ hL' (by positivity)).trans (le_of_eq ?_)
    rw [div_eq_mul_inv, f5]
  have hcoef :
      (ENNReal.ofReal (C * p * L ^ (-σ) * Λ ^ 2) + 2 * ENNReal.ofReal (C₁ * p) *
            ENNReal.ofReal cd * (∫⁻ s, ‖κ₁ s‖ₑ) * (∫⁻ s, ‖κ₂ s‖ₑ) *
            ENNReal.ofReal (Λ ^ (-(1 / 6) : ℝ))) * ENNReal.ofReal ((2 * (R₀ + R₁)) ^ 2) +
        ENNReal.ofReal (C₂ * p) * ENNReal.ofReal cd * ENNReal.ofReal cd * ENNReal.ofReal v₀ *
          ((∫⁻ s, ms7Tail κ₁ L₁ R₁ s) * (∫⁻ s, ‖κ₂ s‖ₑ) +
            (∫⁻ s, ‖κ₁ s‖ₑ) * (∫⁻ s, ms7Tail κ₂ L₂ R₁ s)) ≤
      ENNReal.ofReal (K * p * L ^ (-(σ / 39))) := by
    rw [e1, f2, hN₁, hN₂]
    calc _ ≤ (ENNReal.ofReal (C * p * L ^ (-t)) + 2 * ENNReal.ofReal (C₁ * p) *
            ENNReal.ofReal cd * ENNReal.ofReal n₁ * ENNReal.ofReal n₂ *
            ENNReal.ofReal (L ^ (-t))) * ENNReal.ofReal (4 * (R₀ + 1) ^ 2 * L ^ (2 * t / 3)) +
          ENNReal.ofReal (C₂ * p) * ENNReal.ofReal cd * ENNReal.ofReal cd * ENNReal.ofReal v₀ *
          (ENNReal.ofReal (2 * m₁ * L ^ (-(t / 3))) * ENNReal.ofReal n₂ +
            ENNReal.ofReal n₁ * ENNReal.ofReal (2 * m₂ * L ^ (-(t / 3)))) := by
          gcongr ?_ * ?_ + _ * (?_ * _ + _ * ?_)
          · exact le_rfl
          · exact ENNReal.ofReal_le_ofReal b1
          · exact b2 κ₁ L₁ hL₁
          · exact b2 κ₂ L₂ hL₂
      _ = ENNReal.ofReal ((C * p * L ^ (-t) + 2 * (C₁ * p) * cd * n₁ * n₂ * L ^ (-t)) *
            (4 * (R₀ + 1) ^ 2 * L ^ (2 * t / 3)) +
          C₂ * p * cd * cd * v₀ * (2 * m₁ * L ^ (-(t / 3)) * n₂ + n₁ * (2 * m₂ * L ^ (-(t / 3)))))
            := by
          simp (disch := positivity) only [ENNReal.ofReal_add, ENNReal.ofReal_mul,
            ENNReal.ofReal_ofNat]
      _ = ENNReal.ofReal (K * p * L ^ (-(σ / 39))) := by
          congr 1
          rw [show σ / 39 = t / 3 by rw [ht_def]; ring, ← f6]
          ring
  calc eLpNorm (monoT r ψ (monoP 0 κ₁ L₁ u₁) (monoP 1 κ₂ L₂ u₂)) 1 volume
      ≤ ENNReal.ofReal 4 * eLpNorm (monoT r ψ (monoP 0 κ₁ L₁ u₁) (monoP 1 κ₂ L₂ u₂)) 1 volume :=
        le_mul_of_one_le_left bot_le (by
          rw [← ENNReal.ofReal_one];
          exact ENNReal.ofReal_le_ofReal (by norm_num))
    _ ≤ _ := G
    _ ≤ ENNReal.ofReal (K * p * L ^ (-(σ / 39))) * eLpNorm u₁ 2 volume * eLpNorm u₂ 2 volume := by
        gcongr
    _ = _ := by ring

end

