open MeasureTheory Filter Topology Set
open scoped ENNReal

namespace Auto

noncomputable section

/-! ### Lc14: summing the weighted energies over the partners -/
theorem mlc_sum_X1_le {u : ℝ × ℝ → ℂ} (hu : Measurable u) {ι : Type*} (T : Finset ι) (q : ι → ℝ)
    (h : ℝ) {G : ℝ × ℝ → ℝ} (hG : ∀ ξ, ∑ i ∈ T, mlcw h (q i) ξ ≤ G ξ) :
    ∑ i ∈ T, mlcX1 h (q i) u ≤
      ∫⁻ s, ∫⁻ ξ, ‖mfkF2 (mlcD1 u s) ξ‖ₑ ^ 2 * ENNReal.ofReal (G ξ) := by
  unfold mlcX1
  rw [← lintegral_finsetSum _ (fun i _ => mlc_meas_X1 hu h (q i))]
  refine lintegral_mono fun s => ?_
  have hmξ : Measurable fun ξ => ‖mfkF2 (mlcD1 u s) ξ‖ₑ ^ 2 :=
    ((mlc_meas_F2D1 hu).comp (measurable_const.prodMk measurable_id)).enorm.pow_const 2
  rw [← lintegral_finsetSum _ (fun i _ => (show Measurable fun ξ => ‖mfkF2 _ ξ‖ₑ ^ 2 * mlcW h (q
    i) ξ from hmξ.mul (mlcW_measurable h (q i))))]
  refine lintegral_mono fun ξ => ?_
  rw [← Finset.mul_sum]
  gcongr
  simp only [mlcW_eq]
  rw [← ENNReal.ofReal_sum_of_nonneg (fun i _ => mlcw_nonneg _ _ _)]
  exact ENNReal.ofReal_le_ofReal (hG ξ)

theorem mlc_sum_X2_le {u : ℝ × ℝ → ℂ} (hu : Measurable u) {ι : Type*} (T : Finset ι) (q : ι → ℝ)
    (h : ℝ) {G : ℝ × ℝ → ℝ} (hG : ∀ ξ, ∑ i ∈ T, mlcw h (q i) ξ ≤ G ξ) :
    ∑ i ∈ T, mlcX2 h (q i) u ≤
      ∫⁻ s, ∫⁻ ξ, ‖mfkF2 (mlcD2 u s) ξ‖ₑ ^ 2 * ENNReal.ofReal (G ξ) := by
  unfold mlcX2
  rw [← lintegral_finsetSum _ (fun i _ => mlc_meas_X2 hu h (q i))]
  refine lintegral_mono fun s => ?_
  have hmξ : Measurable fun ξ => ‖mfkF2 (mlcD2 u s) ξ‖ₑ ^ 2 :=
    ((mlc_meas_F2D2 hu).comp (measurable_const.prodMk measurable_id)).enorm.pow_const 2
  rw [← lintegral_finsetSum _ (fun i _ => (show Measurable fun ξ => ‖mfkF2 _ ξ‖ₑ ^ 2 * mlcW h (q
    i) ξ from hmξ.mul (mlcW_measurable h (q i))))]
  refine lintegral_mono fun ξ => ?_
  rw [← Finset.mul_sum]
  gcongr
  simp only [mlcW_eq]
  rw [← ENNReal.ofReal_sum_of_nonneg (fun i _ => mlcw_nonneg _ _ _)]
  exact ENNReal.ofReal_le_ofReal (hG ξ)

/-- Splitting the weight `c₁ 1_S + c₂`. -/
theorem mlc_split_weight {F : ℝ → ℝ × ℝ → ℂ} (hF : Measurable fun p : ℝ × (ℝ × ℝ) => F p.1 p.2)
    {S : Set (ℝ × ℝ)} (hS : MeasurableSet S) {c₁ c₂ : ℝ} (hc₁ : 0 ≤ c₁) (hc₂ : 0 ≤ c₂) :
    ∫⁻ s, ∫⁻ ξ, ‖F s ξ‖ₑ ^ 2 * ENNReal.ofReal (S.indicator (fun _ => c₁) ξ + c₂) =
      ENNReal.ofReal c₁ * (∫⁻ s, ∫⁻ ξ in S, ‖F s ξ‖ₑ ^ 2) +
        ENNReal.ofReal c₂ * ∫⁻ s, ∫⁻ ξ, ‖F s ξ‖ₑ ^ 2 := by
  have hm : Measurable fun p : ℝ × (ℝ × ℝ) => ‖F p.1 p.2‖ₑ ^ 2 := hF.enorm.pow_const 2
  have hmξ : ∀ s, Measurable fun ξ => ‖F s ξ‖ₑ ^ 2 := fun s =>
    hm.comp (measurable_const.prodMk measurable_id)
  have e1 : ∀ s, ∫⁻ ξ, ‖F s ξ‖ₑ ^ 2 * ENNReal.ofReal (S.indicator (fun _ => c₁) ξ + c₂) =
      ENNReal.ofReal c₁ * (∫⁻ ξ in S, ‖F s ξ‖ₑ ^ 2) + ENNReal.ofReal c₂ * ∫⁻ ξ, ‖F s ξ‖ₑ ^ 2 := by
    intro s
    have e : ∀ ξ, ‖F s ξ‖ₑ ^ 2 * ENNReal.ofReal (S.indicator (fun _ => c₁) ξ + c₂) =
        S.indicator (fun ξ => ENNReal.ofReal c₁ * ‖F s ξ‖ₑ ^ 2) ξ + ENNReal.ofReal c₂ * ‖F s ξ‖ₑ ^
          2 := by
      intro ξ
      by_cases hξ : ξ ∈ S
      · rw [indicator_of_mem hξ, indicator_of_mem hξ, ENNReal.ofReal_add hc₁ hc₂]; ring
      · rw [indicator_of_notMem hξ, indicator_of_notMem hξ, zero_add, zero_add]; ring
    simp_rw [e]
    rw [lintegral_add_left ((hmξ s).const_mul _ |>.indicator hS), lintegral_indicator hS,
      lintegral_const_mul _ (hmξ s), lintegral_const_mul _ (hmξ s)]
  simp_rw [e1]
  have hm1 : Measurable fun s => ENNReal.ofReal c₁ * ∫⁻ ξ in S, ‖F s ξ‖ₑ ^ 2 :=
    (hm.lintegral_prod_right' (ν := volume.restrict S)).const_mul _
  rw [lintegral_add_left hm1 (fun s => ENNReal.ofReal c₂ * ∫⁻ ξ, ‖F s ξ‖ₑ ^ 2),
    lintegral_const_mul _ (hm.lintegral_prod_right' (ν := volume.restrict S)),
    lintegral_const_mul _ (hm.lintegral_prod_right' (ν := volume))]

theorem mlc_const_weight {F : ℝ → ℝ × ℝ → ℂ} (c : ℝ) :
    ∫⁻ s, ∫⁻ ξ, ‖F s ξ‖ₑ ^ 2 * ENNReal.ofReal c = ENNReal.ofReal c * ∫⁻ s, ∫⁻ ξ, ‖F s ξ‖ₑ ^ 2 := by
  simp_rw [lintegral_mul_const' _ _ ENNReal.ofReal_ne_top]
  rw [mul_comm]

end

end Auto

