    hg2.eLpNorm_lt_top

theorem mfk_tri_enorm_le {Λ h x0 y0 t0 : ℝ} (hΛ : 0 < Λ) {A : (ℝ × ℝ) × ℝ → ℂ}
    (hA : MfkAmp Λ h x0 y0 t0 A) (c q : ℝ) {f g : ℝ × ℝ → ℂ} (hf : Measurable f) (hg : Measurable
      g) :
    ‖mfkTri A c q f g‖ₑ ≤ ENNReal.ofReal (Λ * (2 * (Λ * h))) * eLpNorm f 2 volume * eLpNorm g 2
      volume :=
