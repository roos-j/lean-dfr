/-! ### (8.5): the `C^1` cutoff -/
theorem ms8_rpow_arith {Λ s h₀ : ℝ} (hΛ : 0 < Λ) :
    (h₀ * Λ ^ (-s / 21))⁻¹ ^ 20 * Λ ^ (-s) = h₀⁻¹ ^ 20 * Λ ^ (-s / 21) := by
  rw [mul_inv, mul_pow, mul_assoc]
  congr 1
  rw [← Real.rpow_neg hΛ.le, ← Real.rpow_natCast, ← Real.rpow_mul hΛ.le, ← Real.rpow_add hΛ]
  congr 1; push_cast; ring

theorem ms8_abs_le_iSup {ψ : ℝ → ℝ} (hc : Continuous ψ) (hcs : HasCompactSupport ψ) (t : ℝ) :
    |ψ t| ≤ ⨆ t, |ψ t| := by
  have hb : BddAbove (range fun t => |ψ t|) :=
    (continuous_abs.comp hc).bddAbove_range_of_hasCompactSupport (hcs.comp_left abs_zero)
  exact le_ciSup hb t

/-- **(8.5)** for the normalized curve `(t, t^r)`. -/
theorem ms8_c1_tail
    (hG : ∀ r A B : ℝ, 1 < r → 0 < A → A < B → ∃ C s : ℝ, 0 < C ∧ 0 < s ∧ MonoGlobal77 r A B C s)
    {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) :
    ∃ C δ : ℝ, 0 < C ∧ 0 < δ ∧ ∀ ψ : ℝ → ℝ, ContDiff ℝ 1 ψ → tsupport ψ ⊆ Icc A B →
      ∀ Λ : ℝ, 1 ≤ Λ → ∀ f₁ f₂ : ℝ × ℝ → ℂ, Measurable f₁ → Measurable f₂ →
      ∀ M₁ M₂ : ℝ, (∀ z, ‖f₁ z‖ ≤ M₁) → (∀ z, ‖f₂ z‖ ≤ M₂) →
      (∀ p, Integrable (monoFib 0 f₁ p) volume) → (∀ p, Integrable (monoFib 1 f₂ p) volume) →
      eLpNorm f₁ 2 volume ≠ ⊤ → eLpNorm f₂ 2 volume ≠ ⊤ →
      ((∀ p ξ, |ξ| < Λ → 𝓕 (monoFib 0 f₁ p) ξ = 0) ∨
        (∀ p ξ, |ξ| < Λ → 𝓕 (monoFib 1 f₂ p) ξ = 0)) →
      eLpNorm (monoT r ψ f₁ f₂) 1 volume ≤
        ENNReal.ofReal (C * ((⨆ t, |ψ t|) + ∫ t, |deriv ψ t|) * Λ ^ (-δ)) *
          (eLpNorm f₁ 2 volume * eLpNorm f₂ 2 volume) := by
  obtain ⟨C₀, s, hC₀, hs, hG0⟩ := hG r (A / 2) (B + 1) hr (by linarith) (by linarith)
  set C' : ℝ := 2 * C₀ * (2 ^ s / (1 - 2 ^ (-s))) with hC'
  have hq1 : (2 : ℝ) ^ (-s) < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  have hC'0 : 0 ≤ C' := by
    have : 0 < 1 - (2 : ℝ) ^ (-s) := by linarith
    positivity
  set h₀ : ℝ := min (A / 2) 1 with hh₀
  have hh₀0 : 0 < h₀ := lt_min (by linarith) one_pos
  set Cf : ℝ := C' * ms8CZ * h₀⁻¹ ^ 20 + h₀ + 1
  have hCZ := ms8_CZ_nonneg
  have hCf : 0 < Cf := by positivity
  refine ⟨Cf, s / 21, hCf, by positivity, ?_⟩
  intro ψ hψ hsupp Λ hΛ f₁ f₂ hf₁ hf₂ M₁ M₂ hM₁ hM₂ hfib₁ hfib₂ h2₁ h2₂ hF
  have hΛ0 : 0 < Λ := by linarith
  have hr0 : 0 < r := by linarith
  have hψc : HasCompactSupport ψ := isCompact_Icc.of_isClosed_subset (isClosed_tsupport ψ) hsupp
  have hcont : Continuous ψ := hψ.continuous
  have hψI : Integrable ψ volume := hcont.integrable_of_hasCompactSupport hψc
  set M := ⨆ t, |ψ t| with hMdef
  have hM : ∀ t, |ψ t| ≤ M := ms8_abs_le_iSup hcont hψc
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  have hDI : Integrable (deriv ψ) volume :=
    (hψ.continuous_deriv le_rfl).integrable_of_hasCompactSupport hψc.deriv
  set V := ∫ t, |deriv ψ t| with hVdef
  have hV0 : 0 ≤ V := integral_nonneg fun t => abs_nonneg _
  have hVe : ∫⁻ t, ‖deriv ψ t‖ₑ = ENNReal.ofReal V := by
    rw [← ofReal_integral_norm_eq_lintegral_enorm hDI]; rfl
  -- the mollification scale
  set h : ℝ := h₀ * Λ ^ (-s / 21) with hhdef
  have hΛs : Λ ^ (-s / 21) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hΛ (by linarith)
  have hh0 : 0 < h := by positivity
  have hhh₀ : h ≤ h₀ := by
    calc h = h₀ * Λ ^ (-s / 21) := rfl
      _ ≤ h₀ * 1 := by gcongr
      _ = h₀ := mul_one _
  have hh1 : h ≤ 1 := hhh₀.trans (min_le_right _ _)
  have hhA : h ≤ A / 2 := hhh₀.trans (min_le_left _ _)
  set ψh := ms8Moll ψ h
  have hψh : ContDiff ℝ ∞ ψh := ms8_moll_contDiff hcont hh0
  have hψhs : tsupport ψh ⊆ Icc (A / 2) (B + 1) := by
    refine (ms8_moll_tsupport hsupp hh0).trans (Icc_subset_Icc (by linarith) (by linarith))
  have hψhc : HasCompactSupport ψh :=
    isCompact_Icc.of_isClosed_subset (isClosed_tsupport _) hψhs
  have hψhI : Integrable ψh volume := hψh.continuous.integrable_of_hasCompactSupport hψhc
  -- the smooth part
  have hsm := ms8_smooth_tail hr hC₀.le hs hG0 hψh hψhs hΛ hf₁ hf₂ hM₁ hM₂ hfib₁ hfib₂ h2₁ h2₂ hF
  have hC20 := ms8_monoC20_moll_le hcont hM hh0 hh1
  -- the error part
  have herr := eLpNorm_monoT_le hr0 (hcont.measurable.sub hψh.continuous.measurable) hf₁ hf₂
    (ψ := fun t => ψ t - ψh t)
  have hme := ms8_moll_err hψ hM hh0
  -- splitting
  have hsplit : monoT r ψ f₁ f₂ = monoT r ψh f₁ f₂ + monoT r (fun t => ψ t - ψh t) f₁ f₂ := by
    rw [ms8_monoT_sub_psi hr0 hψI hψhI hf₁ hf₂ hM₁ hM₂]; funext z; simp
  rw [hsplit]
  refine (eLpNorm_add_le le_rfl).trans ?_
  set X := eLpNorm f₁ 2 volume * eLpNorm f₂ 2 volume
  have h1 : eLpNorm (monoT r ψh f₁ f₂) 1 volume ≤
      ENNReal.ofReal (C' * ms8CZ * h₀⁻¹ ^ 20 * M * Λ ^ (-(s / 21))) * X := by
    refine hsm.trans (mul_le_mul_of_nonneg_right (ENNReal.ofReal_le_ofReal ?_) (by simp))
    calc C' * monoC20 ψh * Λ ^ (-s) ≤ C' * (ms8CZ * M * h⁻¹ ^ 20) * Λ ^ (-s) := by gcongr
      _ = C' * ms8CZ * M * (h⁻¹ ^ 20 * Λ ^ (-s)) := by ring
      _ = C' * ms8CZ * M * (h₀⁻¹ ^ 20 * Λ ^ (-s / 21)) := by rw [hhdef, ms8_rpow_arith hΛ0]
      _ = C' * ms8CZ * h₀⁻¹ ^ 20 * M * Λ ^ (-(s / 21)) := by rw [neg_div]; ring
  have h2 : eLpNorm (monoT r (fun t => ψ t - ψh t) f₁ f₂) 1 volume ≤
      ENNReal.ofReal (h₀ * V * Λ ^ (-(s / 21))) * X := by
    refine herr.trans (mul_le_mul_of_nonneg_right (hme.trans ?_) (by simp))
    rw [hVe, ← ENNReal.ofReal_mul hh0.le]
    apply ENNReal.ofReal_le_ofReal
    rw [hhdef, neg_div]; ring_nf; rfl
  refine (add_le_add h1 h2).trans ?_
  rw [← add_mul, ← ENNReal.ofReal_add (by positivity) (by positivity)]
  gcongr
  have hp : 0 ≤ Λ ^ (-(s / 21)) := by positivity
  have hA1 : C' * ms8CZ * h₀⁻¹ ^ 20 ≤ Cf := by linarith
  have hA2 : h₀ ≤ Cf := by
    have : 0 ≤ C' * ms8CZ * h₀⁻¹ ^ 20 := by positivity
    linarith
  calc C' * ms8CZ * h₀⁻¹ ^ 20 * M * Λ ^ (-(s / 21)) + h₀ * V * Λ ^ (-(s / 21))
      = (C' * ms8CZ * h₀⁻¹ ^ 20 * M + h₀ * V) * Λ ^ (-(s / 21)) := by ring
    _ ≤ (Cf * M + Cf * V) * Λ ^ (-(s / 21)) := by gcongr
    _ = Cf * (M + V) * Λ ^ (-(s / 21)) := by ring

end

end Auto

