/-! ### The cutoff `ψ`; localization of (4.1); Hölder on boxes -/
theorem ms7_psi_zero {A B : ℝ} {ψ : ℝ → ℝ} (hsupp : tsupport ψ ⊆ Icc A B) {t : ℝ}
    (ht : t ∉ Icc A B) : ψ t = 0 :=
  image_eq_zero_of_notMem_tsupport fun h => ht (hsupp h)

theorem ms7_psi_hcs {A B : ℝ} {ψ : ℝ → ℝ} (hsupp : tsupport ψ ⊆ Icc A B) : HasCompactSupport ψ :=
  isCompact_Icc.of_isClosed_subset (isClosed_tsupport ψ) hsupp

theorem ms7_psi_bound {A B : ℝ} {ψ : ℝ → ℝ} (hψ : ContDiff ℝ ∞ ψ) (hsupp : tsupport ψ ⊆ Icc A B)
    (t : ℝ) : |ψ t| ≤ monoC20 ψ := by
  have hc : Continuous ψ := hψ.continuous
  have hbdd : BddAbove (range fun t => |iteratedDeriv 0 ψ t|) := by
    simp only [iteratedDeriv_zero]
    exact (continuous_abs.comp hc).bddAbove_range_of_hasCompactSupport
      ((ms7_psi_hcs hsupp).comp_left abs_zero)
  have h0 : |ψ t| ≤ ⨆ t, |iteratedDeriv 0 ψ t| := by
    have := le_ciSup hbdd t
    simpa only [iteratedDeriv_zero] using this
  refine h0.trans ?_
  unfold monoC20
  exact Finset.single_le_sum (f := fun k => ⨆ t, |iteratedDeriv k ψ t|)
    (fun k _ => Real.iSup_nonneg fun t => abs_nonneg _) (Finset.mem_range.2 (by norm_num))

theorem ms7_C20_nonneg {A B : ℝ} {ψ : ℝ → ℝ} (hψ : ContDiff ℝ ∞ ψ) (hsupp : tsupport ψ ⊆ Icc A B) :
    0 ≤ monoC20 ψ :=
  (abs_nonneg _).trans (ms7_psi_bound hψ hsupp 0)

theorem ms7_psi_L1 {A B : ℝ} {ψ : ℝ → ℝ} (hψ : ContDiff ℝ ∞ ψ) (hsupp : tsupport ψ ⊆ Icc A B) :
    ∫⁻ t, ‖ψ t‖ₑ ≠ ⊤ :=
  ((hψ.continuous.integrable_of_hasCompactSupport (μ := volume) (ms7_psi_hcs
    hsupp)).hasFiniteIntegral).ne

/-- The localization radius: `χ_q T_ψ(f,g)` only sees `f, g` on `q + [-R_0,R_0]^2`. -/
def ms7R0 (r B : ℝ) : ℝ := 2 + B + monoQ r B

theorem ms7R0_pos {r B : ℝ} (hB : 0 < B) : 0 < ms7R0 r B := by
  unfold ms7R0 monoQ
  have := Real.rpow_nonneg hB.le r
  linarith

/-- **Localization**: `χ_q T_ψ(f,g) = χ_q T_ψ(1_D f, 1_D g)` pointwise. -/
theorem ms7_localize {r A B : ℝ} (hr : 0 < r) (hA : 0 < A) {ψ : ℝ → ℝ}
    (hsupp : tsupport ψ ⊆ Icc A B) (f g : ℝ × ℝ → ℂ) (q z : ℝ × ℝ) :
    (ms7Chi (z - q) : ℂ) * monoT r ψ f g z =
      (ms7Chi (z - q) : ℂ) * monoT r ψ ((ms7Box q (ms7R0 r B)).indicator f)
        ((ms7Box q (ms7R0 r B)).indicator g) z := by
  by_cases hχ : ms7Chi (z - q) = 0
  · simp [hχ]
  obtain ⟨h1, h2⟩ := ms7Chi_ne_zero hχ
  simp only [Prod.fst_sub, Prod.snd_sub] at h1 h2
  congr 1
  unfold monoT
  congr 1; funext t
  by_cases ht : t ∈ Icc A B
  · have ht0 : 0 ≤ t := hA.le.trans ht.1
    have hQ0 : 0 ≤ monoQ r t := Real.rpow_nonneg ht0 r
    have hQB : monoQ r t ≤ monoQ r B := Real.rpow_le_rpow ht0 ht.2 hr.le
    have hB : t ≤ B := ht.2
    have m1 : ((z.1 + t, z.2) : ℝ × ℝ) ∈ ms7Box q (ms7R0 r B) := by
      simp only [ms7Box, mem_ofPred_eq, ms7R0]
      rw [abs_lt] at h1 h2
      constructor <;> rw [abs_le] <;> constructor <;> linarith
    have m2 : ((z.1, z.2 + monoQ r t) : ℝ × ℝ) ∈ ms7Box q (ms7R0 r B) := by
      simp only [ms7Box, mem_ofPred_eq, ms7R0]
      rw [abs_lt] at h1 h2
      constructor <;> rw [abs_le] <;> constructor <;> linarith
    rw [indicator_of_mem m1, indicator_of_mem m2]
  · simp [ms7_psi_zero hsupp ht]

/-- **Localized (4.1)**: `‖χ_q T_ψ(f,g)‖_1 ≤ C ‖ψ‖_{C^20} ‖1_D f‖_{12/7} ‖1_D g‖_{12/7}`. -/
theorem ms7_loc41 {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ ψ : ℝ → ℝ, ContDiff ℝ ∞ ψ → tsupport ψ ⊆ Icc A B →
      ∀ (q : ℝ × ℝ) (f g : ℝ × ℝ → ℂ), Measurable f → Measurable g →
        eLpNorm (fun z => (ms7Chi (z - q) : ℂ) * monoT r ψ f g z) 1 volume ≤
          ENNReal.ofReal (C * monoC20 ψ) *
            eLpNorm ((ms7Box q (ms7R0 r B)).indicator f) (12 / 7 : ℝ≥0∞) volume *
            eLpNorm ((ms7Box q (ms7R0 r B)).indicator g) (12 / 7 : ℝ≥0∞) volume := by
  obtain ⟨C, hC, himp⟩ := mimp_improving hr hA hAB
  refine ⟨C, hC, fun ψ hψ hsupp q f g hf hg => ?_⟩
  have hD := ms7Box_meas q (ms7R0 r B)
  have hr0 : 0 < r := by linarith
  simp_rw [ms7_localize hr0 hA hsupp f g q]
  refine (eLpNorm_mono (g := monoT r ψ ((ms7Box q (ms7R0 r B)).indicator f)
    ((ms7Box q (ms7R0 r B)).indicator g))
      (((Complex.continuous_ofReal.comp (ms7Chi_contDiff.continuous.comp
        (continuous_id.sub continuous_const))).measurable.mul
        (ms7_measT hr0 hψ.continuous.measurable (hf.indicator hD)
          (hg.indicator hD))).aestronglyMeasurable) fun z => ?_).trans ?_
  · change ‖(ms7Chi (z - q) : ℂ) * _‖ ≤ _
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (ms7Chi_nonneg _)]
    exact mul_le_of_le_one_left (norm_nonneg _) (ms7Chi_le_one _)
  · exact himp ψ hψ.continuous.measurable (fun t ht => ms7_psi_zero hsupp ht) _
      (ms7_psi_bound hψ hsupp) _ _ (hf.indicator hD) (hg.indicator hD)

theorem ms7_toReal_12_7 : (12 / 7 : ℝ≥0∞).toReal = 12 / 7 := by
  rw [ENNReal.toReal_div]; norm_num

/-- Hölder on a box: `‖1_D f‖_{12/7} ≤ |D|^{1/12} ‖1_D f‖_2`. -/
theorem ms7_holder_box (q : ℝ × ℝ) {R : ℝ} (hR : 0 ≤ R) {f : ℝ × ℝ → ℂ} (hf : Measurable f) :
    eLpNorm ((ms7Box q R).indicator f) (12 / 7 : ℝ≥0∞) volume ≤
      ENNReal.ofReal (((2 * R) ^ 2) ^ (1 / 12 : ℝ)) *
        eLpNorm ((ms7Box q R).indicator f) 2 volume := by
  have hD := ms7Box_meas q R
  rw [eLpNorm_indicator_eq_eLpNorm_restrict hD, eLpNorm_indicator_eq_eLpNorm_restrict hD, mul_comm]
  refine (eLpNorm_le_eLpNorm_mul_rpow_measure_univ (p := 12 / 7) (q := 2) (by
    rw [ENNReal.div_le_iff (by norm_num) (by norm_num)]
    norm_num) hf.aestronglyMeasurable).trans (le_of_eq ?_)
  rw [Measure.restrict_apply_univ, ms7Box_vol q hR, ms7_toReal_12_7,
    ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num)]
  norm_num

end

