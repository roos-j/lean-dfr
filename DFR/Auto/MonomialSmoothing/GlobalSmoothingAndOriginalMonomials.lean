  refine ⟨(by fun_prop : Measurable (fun p : (ℝ × ℝ) × ℝ =>
      f (p.1.1 + p.2, p.1.2) * g (p.1.1, p.1.2 + c + q * p.2) * A p)).aestronglyMeasurable, ?_⟩
  rw [hasFiniteIntegral_iff_enorm]
  refine lt_of_le_of_lt (mfk_tri_lint_bound hΛ hA c q hf hg) ?_
