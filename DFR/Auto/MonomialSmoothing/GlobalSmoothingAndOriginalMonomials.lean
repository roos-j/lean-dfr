open MeasureTheory Filter Topology Set
open scoped ENNReal ContDiff

namespace Auto

noncomputable section

/-! ### Lc02: derivative bounds at scale `h` (Leibniz rule for the amplitudes) -/
theorem mlc_iteratedDeriv_bdd {f : ℝ → ℝ} (hf : ContDiff ℝ ∞ f) (hc : HasCompactSupport f)
    (N : ℕ) : ∃ M : ℝ, 0 ≤ M ∧ ∀ k ≤ N, ∀ x, |iteratedDeriv k f x| ≤ M := by
  have one : ∀ k : ℕ, ∃ M : ℝ, ∀ x, |iteratedDeriv k f x| ≤ M := by
    intro k
    obtain ⟨M, hM⟩ := (hf.continuous_iteratedFDeriv (m := k)
      (by exact_mod_cast le_top)).bounded_above_of_compact_support
      (hc.iteratedFDeriv k)
    refine ⟨M, fun x => ?_⟩
    rw [← Real.norm_eq_abs, ← norm_iteratedFDeriv_eq_norm_iteratedDeriv]
    exact hM x
  induction N with
  | zero =>
    obtain ⟨M, hM⟩ := one 0
    refine ⟨max M 0, le_max_right _ _, fun k hk x => ?_⟩
    have : k = 0 := by omega
    subst this; exact (hM x).trans (le_max_left _ _)
  | succ N ih =>
    obtain ⟨M, hM0, hM⟩ := ih
    obtain ⟨M', hM'⟩ := one (N + 1)
    refine ⟨max M M', hM0.trans (le_max_left _ _), fun k hk x => ?_⟩
    rcases Nat.lt_or_ge k (N + 1) with h | h
    · exact (hM k (by omega) x).trans (le_max_left _ _)
    · have : k = N + 1 := by omega
      subst this; exact (hM' x).trans (le_max_right _ _)

/-- `f` is `C^N` with `|f^{(k)}| ≤ α ε^k` for `k ≤ N`. -/
def MlcReg (N : ℕ) (f : ℝ → ℝ) (α ε : ℝ) : Prop :=
  ContDiff ℝ N f ∧ ∀ k ≤ N, ∀ x, |iteratedDeriv k f x| ≤ α * ε ^ k

theorem MlcReg.alpha_nonneg {N : ℕ} {f : ℝ → ℝ} {α ε : ℝ} (h : MlcReg N f α ε) : 0 ≤ α := by
  have := h.2 0 (Nat.zero_le _) 0
  simp only [iteratedDeriv_zero, pow_zero, mul_one] at this
  exact (abs_nonneg _).trans this

theorem MlcReg.mono {N : ℕ} {f : ℝ → ℝ} {α ε α' ε' : ℝ} (h : MlcReg N f α ε) (hα : α ≤ α')
    (hε0 : 0 ≤ ε) (hε : ε ≤ ε') : MlcReg N f α' ε' :=
  ⟨h.1, fun k hk x => (h.2 k hk x).trans (mul_le_mul hα (pow_le_pow_left₀ hε0 hε k)
    (pow_nonneg hε0 k) (h.alpha_nonneg.trans hα))⟩

theorem MlcReg.mul {N : ℕ} {f g : ℝ → ℝ} {α β ε : ℝ} (hf : MlcReg N f α ε) (hg : MlcReg N g β ε)
    (hε : 0 ≤ ε) : MlcReg N (fun x => f x * g x) (2 ^ N * (α * β)) ε := by
  refine ⟨hf.1.mul hg.1, fun k hk x => ?_⟩
  have hα := hf.alpha_nonneg
  have hβ := hg.alpha_nonneg
  have e := iteratedDeriv_mul (n := k) (f := f) (g := g) (x := x)
    ((hf.1.of_le (by exact_mod_cast hk)).contDiffAt) ((hg.1.of_le
      (by exact_mod_cast hk)).contDiffAt)
  have e' : iteratedDeriv k (fun x => f x * g x) x = iteratedDeriv k (f * g) x := rfl
  rw [e', e]
  calc
    |∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * iteratedDeriv i f x *
        iteratedDeriv (k - i) g x|
      ≤ ∑ i ∈ Finset.range (k + 1), |(k.choose i : ℝ) * iteratedDeriv i f x * iteratedDeriv (k -
        i) g x| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * (α * ε ^ i) * (β * ε ^ (k - i)) := by
        refine Finset.sum_le_sum fun i hi => ?_
        have hi' : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        rw [abs_mul, abs_mul, Nat.abs_cast]
        gcongr
        · exact hf.2 i (hi'.trans hk) x
        · exact hg.2 (k - i) ((Nat.sub_le k i).trans hk) x
    _ = ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * (α * β * ε ^ k) := by
        refine Finset.sum_congr rfl fun i hi => ?_
        have hi' : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        have : ε ^ k = ε ^ i * ε ^ (k - i) := by rw [← pow_add, Nat.add_sub_cancel' hi']
        rw [this]; ring
    _ = 2 ^ k * (α * β * ε ^ k) := by
        rw [← Finset.sum_mul]
        congr 1
        exact_mod_cast Nat.sum_range_choose k
    _ ≤ 2 ^ N * (α * β) * ε ^ k := by
        have : (2 : ℝ) ^ k ≤ 2 ^ N := pow_le_pow_right₀ (by norm_num) hk
        have : 0 ≤ α * β * ε ^ k := by positivity
        nlinarith

theorem mlcReg_const (N : ℕ) (c : ℝ) {ε : ℝ} (hε : 0 ≤ ε) : MlcReg N (fun _ => c) |c| ε := by
  refine ⟨contDiff_const, fun k hk x => ?_⟩
  rcases Nat.eq_zero_or_pos k with h | h
  · subst h; simp
  · rw [iteratedDeriv_const]
    simp only [show k ≠ 0 by omega, ite_false, abs_zero]
    positivity

theorem MlcReg.comp_add {N : ℕ} {f : ℝ → ℝ} {α ε : ℝ} (hf : MlcReg N f α ε) (s : ℝ) :
    MlcReg N (fun x => f (x + s)) α ε := by
  refine ⟨hf.1.comp (contDiff_id.add contDiff_const), fun k hk x => ?_⟩
  rw [iteratedDeriv_comp_add_const]
  exact hf.2 k hk (x + s)

/-- A bump at scale `b`: `x ↦ φ((x - a)/b)`. -/
theorem mlcReg_bump {φ : ℝ → ℝ} (hφ : ContDiff ℝ ∞ φ) {N : ℕ} {M : ℝ}
    (hM : ∀ k ≤ N, ∀ x, |iteratedDeriv k φ x| ≤ M) (a : ℝ) {b : ℝ} (hb : 0 < b) :
    MlcReg N (fun x => φ ((x - a) / b)) M b⁻¹ := by
  have e : (fun x => φ ((x - a) / b)) = fun x => (fun u => φ (u - a / b)) (b⁻¹ * x) := by
    funext x; congr 1; field_simp
  have hc : ContDiff ℝ ∞ (fun u => φ (u - a / b)) := hφ.comp (contDiff_id.sub contDiff_const)
  refine ⟨?_, fun k hk x => ?_⟩
  · rw [e]; exact (hc.comp (contDiff_const.mul contDiff_id)).of_le (by exact_mod_cast le_top)
  · rw [e, iteratedDeriv_comp_const_mul (hc.of_le (by exact_mod_cast le_top)) b⁻¹,
      iteratedDeriv_comp_sub_const]
    rw [abs_mul, abs_pow, abs_of_pos (inv_pos.mpr hb), mul_comm]
    exact mul_le_mul_of_nonneg_right (hM k hk _) (by positivity)

/-- Complex coercion does not change the size of derivatives. -/
theorem mlc_norm_iteratedDeriv_ofReal {f : ℝ → ℝ} {N : ℕ} (hf : ContDiff ℝ N f) {k : ℕ} (hk : k ≤ N)
    (x : ℝ) : ‖iteratedDeriv k (fun x => (f x : ℂ)) x‖ = |iteratedDeriv k f x| := by
  rw [← norm_iteratedFDeriv_eq_norm_iteratedDeriv, ← Real.norm_eq_abs,
    ← norm_iteratedFDeriv_eq_norm_iteratedDeriv]
  have : (fun x => (f x : ℂ)) = Complex.ofRealLI ∘ f := rfl
  rw [this, LinearIsometry.norm_iteratedFDeriv_comp_left _ hf.contDiffAt (by exact_mod_cast hk)]

theorem mlc_contDiff_ofReal {f : ℝ → ℝ} {N : ℕ∞ω} (hf : ContDiff ℝ N f) :
    ContDiff ℝ N (fun x => (f x : ℂ)) :=
  Complex.ofRealCLM.contDiff.comp hf

/-- Derivatives of the cutoff `ψ` are bounded by `‖ψ‖_{C^20}`. -/
theorem mlc_psi_deriv_le {ψ : ℝ → ℝ} (hψ : ContDiff ℝ ∞ ψ) {A B : ℝ} (hsupp : tsupport ψ ⊆ Icc A B)
    (hC : monoC20 ψ ≤ 1) {k : ℕ} (hk : k ≤ 20) (t : ℝ) : |iteratedDeriv k ψ t| ≤ 1 := by
  have hcs : HasCompactSupport ψ := isCompact_Icc.of_isClosed_subset
    (isClosed_tsupport ψ) hsupp
  obtain ⟨M, -, hM⟩ := mlc_iteratedDeriv_bdd hψ hcs k
  have hbdd : BddAbove (range fun t => |iteratedDeriv k ψ t|) :=
    ⟨M, by rintro _ ⟨t, rfl⟩; exact hM k le_rfl t⟩
  have h1 : |iteratedDeriv k ψ t| ≤ ⨆ t, |iteratedDeriv k ψ t| := le_ciSup hbdd t
  have h2 : (⨆ t, |iteratedDeriv k ψ t|) ≤ monoC20 ψ := by
    unfold monoC20
    exact Finset.single_le_sum (f := fun k => ⨆ t, |iteratedDeriv k ψ t|)
      (fun i _ => Real.iSup_nonneg fun t => abs_nonneg _) (Finset.mem_range.mpr (by omega))
  linarith

theorem mlcReg_psi {ψ : ℝ → ℝ} (hψ : ContDiff ℝ ∞ ψ) {A B : ℝ} (hsupp : tsupport ψ ⊆ Icc A B)
    (hC : monoC20 ψ ≤ 1) {N : ℕ} (hN : N ≤ 20) {ε : ℝ} (hε : 1 ≤ ε) : MlcReg N ψ 1 ε :=
  ⟨hψ.of_le (by exact_mod_cast le_top), fun k hk x =>
    (mlc_psi_deriv_le hψ hsupp hC (hk.trans hN) x).trans (by simpa using one_le_pow₀ hε)⟩

end

end Auto

