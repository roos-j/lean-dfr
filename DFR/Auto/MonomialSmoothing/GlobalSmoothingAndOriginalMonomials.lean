theorem mfk_sqrt_sq (x : ℝ≥0∞) : (x ^ (1 / 2 : ℝ)) ^ (2 : ℝ) = x := by
  rw [← ENNReal.rpow_mul]; norm_num

/-- Schur test (weighted Cauchy–Schwarz) in `ℝ≥0∞`. -/
theorem mfk_schur {α : Type*} [MeasurableSpace α] {μ : Measure α} [SFinite μ]
    {a b : α → ℝ≥0∞} (ha : Measurable a) (hb : Measurable b)
    {K : α → α → ℝ≥0∞} (hK : Measurable (Function.uncurry K))
    {R S : α → ℝ≥0∞} (hR : ∀ ξ, ∫⁻ η, K ξ η ∂μ ≤ R ξ) (hS : ∀ η, ∫⁻ ξ, K ξ η ∂μ ≤ S η) :
    ∫⁻ ξ, ∫⁻ η, a ξ * b η * K ξ η ∂μ ∂μ
      ≤ (∫⁻ ξ, a ξ ^ 2 * R ξ ∂μ) ^ (1 / 2 : ℝ) * (∫⁻ η, b η ^ 2 * S η ∂μ) ^ (1 / 2 : ℝ) := by
  have hK' : Measurable (fun z : α × α => K z.1 z.2) := hK
  have hsq : Measurable (fun z : α × α => K z.1 z.2 ^ (1 / 2 : ℝ)) := hK'.pow_const _
  set f := fun z : α × α => a z.1 * K z.1 z.2 ^ (1 / 2 : ℝ)
  set g := fun z : α × α => b z.2 * K z.1 z.2 ^ (1 / 2 : ℝ)
  have hf : Measurable f := (ha.comp measurable_fst).mul hsq
  have hg : Measurable g := (hb.comp measurable_snd).mul hsq
  have hfg : ∀ z : α × α, (f * g) z = a z.1 * b z.2 * K z.1 z.2 := by
    intro z
    simp only [f, g, Pi.mul_apply]
    have : K z.1 z.2 ^ (1 / 2 : ℝ) * K z.1 z.2 ^ (1 / 2 : ℝ) = K z.1 z.2 := by
      rw [← sq, ← ENNReal.rpow_two, mfk_sqrt_sq]
    calc a z.1 * K z.1 z.2 ^ (1 / 2 : ℝ) * (b z.2 * K z.1 z.2 ^ (1 / 2 : ℝ))
        = a z.1 * b z.2 * (K z.1 z.2 ^ (1 / 2 : ℝ) * K z.1 z.2 ^ (1 / 2 : ℝ)) := by ring
      _ = _ := by rw [this]
  have hL : ∫⁻ ξ, ∫⁻ η, a ξ * b η * K ξ η ∂μ ∂μ = ∫⁻ z, (f * g) z ∂(μ.prod μ) := by
    simp_rw [hfg]
    rw [lintegral_prod (fun z : α × α => a z.1 * b z.2 * K z.1 z.2)
      (((ha.comp measurable_fst).mul (hb.comp measurable_snd)).mul hK').aemeasurable]
  have hH := ENNReal.lintegral_mul_le_Lp_mul_Lq (μ.prod μ) Real.HolderConjugate.two_two
    hf.aemeasurable hg.aemeasurable
  rw [hL]
  refine hH.trans ?_
  have hf2 : ∀ z : α × α, f z ^ (2 : ℝ) = a z.1 ^ 2 * K z.1 z.2 := by
    intro z
    simp only [f]
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), mfk_sqrt_sq, ENNReal.rpow_two]
  have hg2 : ∀ z : α × α, g z ^ (2 : ℝ) = b z.2 ^ 2 * K z.1 z.2 := by
    intro z
    simp only [g]
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), mfk_sqrt_sq, ENNReal.rpow_two]
  simp_rw [hf2, hg2]
  gcongr
  · rw [lintegral_prod (fun z : α × α => a z.1 ^ 2 * K z.1 z.2)
      (((ha.comp measurable_fst).pow_const 2).mul hK').aemeasurable]
    apply lintegral_mono
    intro ξ
    dsimp only
    rw [lintegral_const_mul _ (show Measurable (fun η => K ξ η) from hK'.comp
      measurable_prodMk_left)]
    gcongr; exact hR ξ
  · rw [lintegral_prod_symm (fun z : α × α => b z.2 ^ 2 * K z.1 z.2)
      (((hb.comp measurable_snd).pow_const 2).mul hK').aemeasurable]
    apply lintegral_mono
    intro η
    dsimp only
    rw [lintegral_const_mul _ (show Measurable (fun ξ => K ξ η) from hK'.comp
      measurable_prodMk_right)]
    gcongr; exact hS η

end

