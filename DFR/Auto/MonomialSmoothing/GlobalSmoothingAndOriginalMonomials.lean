open MeasureTheory Filter Topology Set FourierTransform Convolution
open scoped ENNReal SchwartzMap Real ContDiff RealInnerProductSpace

namespace Auto

noncomputable section

/-! ### Fiberwise Plancherel and the coordinate multipliers -/

/-- The scaled kernel `L κ(L ·)`. -/
def ms8K (κ : 𝓢(ℝ, ℂ)) (L : ℝ) (s : ℝ) : ℂ := (L : ℂ) * κ (L * s)

theorem ms8_monoP_eq (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L : ℝ) (u : ℝ × ℝ → ℂ) :
    monoP j κ L u = monoCConv j (ms8K κ L) u := rfl

theorem ms8_integrable_K (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L) : Integrable (ms8K κ L) volume :=
  integrable_scaled_schwartz κ hL

theorem ms8_continuous_K (κ : 𝓢(ℝ, ℂ)) (L : ℝ) : Continuous (ms8K κ L) := by
  unfold ms8K
  exact continuous_const.mul (κ.continuous.comp (continuous_const.mul continuous_id))

theorem ms8_fourier_K (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L) (ξ : ℝ) :
    𝓕 (ms8K κ L) ξ = 𝓕 (⇑κ) (ξ / L) := ms8_fourier_scaled κ hL ξ

theorem ms8_lintegral_sq_fib (j : Fin 2) {u : ℝ × ℝ → ℂ} (hu : Measurable u) :
    ∫⁻ z, ‖u z‖ₑ ^ 2 = ∫⁻ p, ∫⁻ a, ‖monoFib j u p a‖ₑ ^ 2 :=
  lintegral_monoPt j (hu.enorm.pow_const 2)

/-- Fiberwise Plancherel. -/
theorem ms8_lintegral_sq_fourier (j : Fin 2) {u : ℝ × ℝ → ℂ} (hu : Measurable u)
    (hfib : ∀ p, Integrable (monoFib j u p) volume) {M : ℝ} (hM : ∀ z, ‖u z‖ ≤ M) :
    ∫⁻ z, ‖u z‖ₑ ^ 2 = ∫⁻ p, ∫⁻ ξ, ‖𝓕 (monoFib j u p) ξ‖ₑ ^ 2 := by
  rw [ms8_lintegral_sq_fib j hu]
  refine lintegral_congr fun p => ?_
  exact (lintegral_fourier_sq_eq (hfib p) (memLp_two_of_bdd (hfib p) fun a => hM _)).symm

theorem ms8_eLpNorm_two {u : ℝ × ℝ → ℂ}
    (hu : AEStronglyMeasurable u volume := by fun_prop) :
    eLpNorm u 2 volume = (∫⁻ z, ‖u z‖ₑ ^ 2) ^ (1 / 2 : ℝ) := by
  rw [eLpNorm_two_eq_lintegral]
  congr 1
  refine lintegral_congr fun z => ?_
  exact ENNReal.rpow_two _

theorem ms8_eLpNorm_le_of_sq_le {u v : ℝ × ℝ → ℂ}
    (h : ∫⁻ z, ‖u z‖ₑ ^ 2 ≤ ∫⁻ z, ‖v z‖ₑ ^ 2)
    (hu : AEStronglyMeasurable u volume := by fun_prop)
    (hv : AEStronglyMeasurable v volume := by fun_prop) : eLpNorm u 2 volume ≤ eLpNorm v 2 volume
      := by
  rw [ms8_eLpNorm_two, ms8_eLpNorm_two]
  exact ENNReal.rpow_le_rpow h (by norm_num)

theorem ms8_eLpNorm_eq_zero_of_sq {u : ℝ × ℝ → ℂ} (h : ∫⁻ z, ‖u z‖ₑ ^ 2 = 0)
    (hu : AEStronglyMeasurable u volume := by fun_prop) :
    eLpNorm u 2 volume = 0 := by
  rw [ms8_eLpNorm_two, h]; norm_num

/-! ### Properties of `monoP` -/

@[fun_prop] theorem ms8_measurable_monoP (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L : ℝ) {u : ℝ × ℝ → ℂ}
    (hu : Measurable u) : Measurable (monoP j κ L u) :=
  measurable_monoCConv (ms8_continuous_K κ L).measurable hu

theorem ms8_monoP_bdd (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L) {u : ℝ × ℝ → ℂ}
    {M : ℝ} (hM : ∀ z, ‖u z‖ ≤ M) (z : ℝ × ℝ) :
    ‖monoP j κ L u z‖ ≤ (∫ s, ‖ms8K κ L s‖) * M :=
  norm_monoCConv_le (ms8_integrable_K κ hL) hM z

theorem ms8_monoP_fib (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L : ℝ) (u : ℝ × ℝ → ℂ) (p : ℝ) :
    monoFib j (monoP j κ L u) p = ms8K κ L ⋆[ContinuousLinearMap.mul ℂ ℂ] monoFib j u p :=
  funext fun a => monoCConv_fib j _ u p a

theorem ms8_monoP_fib_int (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L) {u : ℝ × ℝ → ℂ}
    (hfib : ∀ p, Integrable (monoFib j u p) volume) (p : ℝ) :
    Integrable (monoFib j (monoP j κ L u) p) volume := by
  rw [ms8_monoP_fib]
  exact (ms8_integrable_K κ hL).integrable_convolution _ (hfib p)

theorem ms8_fourier_monoP_fib (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L)
    {u : ℝ × ℝ → ℂ} (hfib : ∀ p, Integrable (monoFib j u p) volume) (p ξ : ℝ) :
    𝓕 (monoFib j (monoP j κ L u) p) ξ = 𝓕 (⇑κ) (ξ / L) * 𝓕 (monoFib j u p) ξ := by
  rw [ms8_monoP_fib, Real.fourier_mul_convolution_eq (ms8_integrable_K κ hL) (hfib p),
    ms8_fourier_K κ hL]

/-- `L^2` contraction of a multiplier with symbol bounded by one. -/
theorem ms8_sq_monoP_le (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (hκ : ∀ ξ, ‖𝓕 (⇑κ) ξ‖ ≤ 1) {L : ℝ}
    (hL : 0 < L) {u : ℝ × ℝ → ℂ} (hu : Measurable u)
    (hfib : ∀ p, Integrable (monoFib j u p) volume) {M : ℝ} (hM : ∀ z, ‖u z‖ ≤ M) :
    ∫⁻ z, ‖monoP j κ L u z‖ₑ ^ 2 ≤ ∫⁻ z, ‖u z‖ₑ ^ 2 := by
  rw [ms8_lintegral_sq_fourier j (ms8_measurable_monoP j κ L hu) (ms8_monoP_fib_int j κ hL hfib)
    (ms8_monoP_bdd j κ hL hM), ms8_lintegral_sq_fourier j hu hfib hM]
  refine lintegral_mono fun p => lintegral_mono fun ξ => ?_
  rw [ms8_fourier_monoP_fib j κ hL hfib, enorm_mul]
  have h1 : ‖𝓕 (⇑κ) (ξ / L)‖ₑ ≤ 1 := by
    rw [← ofReal_norm]; exact ENNReal.ofReal_le_one.mpr (hκ _)
  calc (‖𝓕 (⇑κ) (ξ / L)‖ₑ * ‖𝓕 (monoFib j u p) ξ‖ₑ) ^ 2
      ≤ (1 * ‖𝓕 (monoFib j u p) ξ‖ₑ) ^ 2 := by gcongr
    _ = _ := by rw [one_mul]

theorem ms8_eLpNorm_monoP_le (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (hκ : ∀ ξ, ‖𝓕 (⇑κ) ξ‖ ≤ 1) {L : ℝ}
    (hL : 0 < L) {u : ℝ × ℝ → ℂ} (hu : Measurable u)
    (hfib : ∀ p, Integrable (monoFib j u p) volume) {M : ℝ} (hM : ∀ z, ‖u z‖ ≤ M) :
    eLpNorm (monoP j κ L u) 2 volume ≤ eLpNorm u 2 volume :=
  ms8_eLpNorm_le_of_sq_le (ms8_sq_monoP_le j κ hκ hL hu hfib hM)

theorem ms8_norm_fourier_KPhi_le (ξ : ℝ) : ‖𝓕 (⇑monoKPhi) ξ‖ ≤ 1 := by
  rw [ms8_fourier_KPhi, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (ms8_monoPhi_nonneg _)]
  exact ms8_monoPhi_le_one _

theorem ms8_norm_fourier_KPsiA_le (ξ : ℝ) : ‖𝓕 (⇑monoKPsiA) ξ‖ ≤ 1 := by
  rw [ms8_fourier_KPsiA, Complex.norm_real, Real.norm_eq_abs]
  exact ms8_abs_monoPsiA_le _

/-- The low-frequency part of an input with no active frequencies in `(-Λ, Λ)` vanishes in `L^2`
once `2L ≤ Λ`. -/
theorem ms8_eLpNorm_monoP_Phi_eq_zero (j : Fin 2) {L Λ : ℝ} (hL : 0 < L) (hLΛ : 2 * L ≤ Λ)
    {u : ℝ × ℝ → ℂ} (hu : Measurable u)
    (hfib : ∀ p, Integrable (monoFib j u p) volume) {M : ℝ} (hM : ∀ z, ‖u z‖ ≤ M)
    (hF : ∀ p ξ, |ξ| < Λ → 𝓕 (monoFib j u p) ξ = 0) :
    eLpNorm (monoP j monoKPhi L u) 2 volume = 0 := by
  refine ms8_eLpNorm_eq_zero_of_sq ?_ (by fun_prop)
  rw [ms8_lintegral_sq_fourier j (ms8_measurable_monoP j _ L hu) (ms8_monoP_fib_int j _ hL hfib)
    (ms8_monoP_bdd j _ hL hM)]
  have : ∀ p ξ, 𝓕 (monoFib j (monoP j monoKPhi L u) p) ξ = 0 := by
    intro p ξ
    rw [ms8_fourier_monoP_fib j _ hL hfib, ms8_fourier_KPhi]
    by_cases h : |ξ| < Λ
    · rw [hF p ξ h, mul_zero]
    · have h2 : 2 ≤ |ξ / L| := by
        rw [abs_div, abs_of_pos hL, le_div_iff₀ hL]; linarith
      rw [monoPhi_eq_zero h2]; simp
  simp [this]

end

