open MeasureTheory Filter Topology Set FourierTransform Convolution
open scoped ENNReal SchwartzMap Real ContDiff RealInnerProductSpace

namespace Auto

noncomputable section

/-! ### (8.7): the substitution `u = t^m` -/

/-- The weight `w(u) = (1/m) u^{1/m - 1}`. -/
def ms8W (m : ℕ) (u : ℝ) : ℝ := (1 / m) * u ^ ((1 : ℝ) / m - 1)

/-- `ρ(u) = u^{1/m}`. -/
def ms8Rho (m : ℕ) (u : ℝ) : ℝ := u ^ ((1 : ℝ) / m)

/-- The changed cutoff `ψ̃(u) = (1/m) u^{1/m-1} ψ(u^{1/m})` (8.7), extended by zero to `u ≤ 0`. -/
def ms8Sub (m : ℕ) (ψ : ℝ → ℝ) (u : ℝ) : ℝ := if 0 < u then ms8W m u * ψ (ms8Rho m u) else 0

theorem ms8_rho_pow {m : ℕ} (hm : 0 < m) {u : ℝ} (hu : 0 < u) : ms8Rho m u ^ m = u := by
  unfold ms8Rho
  rw [← Real.rpow_natCast, ← Real.rpow_mul hu.le, one_div_mul_cancel (by exact_mod_cast hm.ne'),
    Real.rpow_one]

theorem ms8_rho_pos {m : ℕ} {u : ℝ} (hu : 0 < u) : 0 < ms8Rho m u := Real.rpow_pos_of_pos hu _

theorem ms8_rho_of_pow {m : ℕ} (hm : 0 < m) {t : ℝ} (ht : 0 < t) : ms8Rho m (t ^ m) = t := by
  unfold ms8Rho
  rw [← Real.rpow_natCast, ← Real.rpow_mul ht.le, mul_one_div_cancel (by exact_mod_cast hm.ne'),
    Real.rpow_one]

/-- If `ψ(ρ(u)) ≠ 0` (with `tsupport ψ ⊆ [a,b]`) then `u ∈ [a^m, b^m]`. -/
theorem ms8_mem_Icc_of_ne {m : ℕ} (hm : 0 < m) {a b : ℝ} (ha : 0 < a) {g : ℝ → ℝ}
    (hsupp : tsupport g ⊆ Icc a b) {u : ℝ} (hu : 0 < u) (hne : g (ms8Rho m u) ≠ 0) :
    u ∈ Icc (a ^ m) (b ^ m) := by
  have h := hsupp (subset_tsupport _ hne)
  rw [← ms8_rho_pow hm hu]
  exact ⟨pow_le_pow_left₀ ha.le h.1 m, pow_le_pow_left₀ (ha.le.trans h.1) h.2 m⟩

theorem ms8_sub_eq_zero_of_lt {m : ℕ} (hm : 0 < m) {a b : ℝ} (ha : 0 < a) {ψ : ℝ → ℝ}
    (hsupp : tsupport ψ ⊆ Icc a b) {u : ℝ} (hu : u < a ^ m) : ms8Sub m ψ u = 0 := by
  unfold ms8Sub
  split_ifs with h
  · by_contra hne
    have := (ms8_mem_Icc_of_ne hm ha hsupp h (right_ne_zero_of_mul hne)).1
    linarith
  · rfl

theorem ms8_sub_tsupport {m : ℕ} (hm : 0 < m) {a b : ℝ} (ha : 0 < a) {ψ : ℝ → ℝ}
    (hsupp : tsupport ψ ⊆ Icc a b) : tsupport (ms8Sub m ψ) ⊆ Icc (a ^ m) (b ^ m) := by
  refine closure_minimal (fun u hu => ?_) isClosed_Icc
  simp only [Function.mem_support, ms8Sub] at hu
  split_ifs at hu with h
  · exact ms8_mem_Icc_of_ne hm ha hsupp h (right_ne_zero_of_mul hu)
  · exact absurd rfl hu

theorem ms8_hasDerivAt_W (m : ℕ) {u : ℝ} (hu : 0 < u) :
    HasDerivAt (ms8W m) ((1 / m) * (((1 : ℝ) / m - 1) * u ^ ((1 : ℝ) / m - 1 - 1))) u :=
  (Real.hasDerivAt_rpow_const (Or.inl hu.ne')).const_mul _

theorem ms8_hasDerivAt_rho (m : ℕ) {u : ℝ} (hu : 0 < u) :
    HasDerivAt (ms8Rho m) (ms8W m u) u := by
  unfold ms8W
  exact Real.hasDerivAt_rpow_const (Or.inl hu.ne')

theorem ms8_sub_eventually {m : ℕ} (ψ : ℝ → ℝ) {u : ℝ} (hu : 0 < u) :
    ms8Sub m ψ =ᶠ[𝓝 u] fun v => ms8W m v * ψ (ms8Rho m v) := by
  filter_upwards [lt_mem_nhds hu] with v hv
  simp [ms8Sub, hv]

theorem ms8_hasDerivAt_sub {m : ℕ} {ψ : ℝ → ℝ} (hψ : ContDiff ℝ 1 ψ) {u : ℝ} (hu : 0 < u) :
    HasDerivAt (ms8Sub m ψ) ((1 / m) * (((1 : ℝ) / m - 1) * u ^ ((1 : ℝ) / m - 1 - 1)) *
      ψ (ms8Rho m u) + ms8W m u * (deriv ψ (ms8Rho m u) * ms8W m u)) u := by
  have hd : Differentiable ℝ ψ := hψ.differentiable one_ne_zero
  have h := (ms8_hasDerivAt_W m hu).mul
    ((hd (ms8Rho m u)).hasDerivAt.comp u (ms8_hasDerivAt_rho m hu))
  exact h.congr_of_eventuallyEq (ms8_sub_eventually ψ hu)

theorem ms8_sub_contDiff {m : ℕ} (hm : 0 < m) {a b : ℝ} (ha : 0 < a) {ψ : ℝ → ℝ}
    (hψ : ContDiff ℝ 1 ψ) (hsupp : tsupport ψ ⊆ Icc a b) : ContDiff ℝ 1 (ms8Sub m ψ) := by
  rw [contDiff_iff_contDiffAt]
  intro u
  by_cases hu : 0 < u
  · have h1 : ContDiffAt ℝ 1 (ms8W m) u :=
      contDiffAt_const.mul (Real.contDiffAt_rpow_const_of_ne hu.ne')
    have h2 : ContDiffAt ℝ 1 (ms8Rho m) u := Real.contDiffAt_rpow_const_of_ne hu.ne'
    have h3 : ContDiffAt ℝ 1 (fun v => ms8W m v * ψ (ms8Rho m v)) u :=
      h1.mul (hψ.contDiffAt.comp u h2)
    exact h3.congr_of_eventuallyEq (ms8_sub_eventually ψ hu)
  · have hlt : u < a ^ m := lt_of_le_of_lt (not_lt.mp hu) (pow_pos ha m)
    have : ms8Sub m ψ =ᶠ[𝓝 u] fun _ => 0 := by
      filter_upwards [gt_mem_nhds hlt] with v hv
      exact ms8_sub_eq_zero_of_lt hm ha hsupp hv
    exact contDiffAt_const.congr_of_eventuallyEq this

/-- The change of variables `u = t^m`. -/
theorem ms8_integral_sub {m : ℕ} (hm : 0 < m) {a b : ℝ} (ha : 0 < a) {ψ : ℝ → ℝ}
    (hsupp : tsupport ψ ⊆ Icc a b) {H G : ℝ → ℂ} (hHG : ∀ t, 0 < t → H t = G (t ^ m)) :
    ∫ t, (ψ t : ℂ) * H t = ∫ u, (ms8Sub m ψ u : ℂ) * G u := by
  have hp : (1 : ℝ) / m ≠ 0 := by
    have : (0 : ℝ) < m := by exact_mod_cast hm
    positivity
  have hcv := integral_comp_rpow_Ioi (fun t => (ψ t : ℂ) * H t) hp
  have hψ0 : ∀ t, t ∉ Ioi (0 : ℝ) → ψ t = 0 := by
    intro t ht
    apply image_eq_zero_of_notMem_tsupport
    intro h
    have := (hsupp h).1
    simp only [mem_Ioi, not_lt] at ht
    linarith
  have e1 : ∫ t, (ψ t : ℂ) * H t = ∫ t in Ioi (0 : ℝ), (ψ t : ℂ) * H t :=
    (setIntegral_eq_integral_of_forall_compl_eq_zero (fun t ht => by simp [hψ0 t ht])).symm
  have e2 : ∫ u, (ms8Sub m ψ u : ℂ) * G u = ∫ u in Ioi (0 : ℝ), (ms8Sub m ψ u : ℂ) * G u := by
    refine (setIntegral_eq_integral_of_forall_compl_eq_zero (fun u hu => ?_)).symm
    simp only [mem_Ioi, not_lt] at hu
    simp [ms8Sub, not_lt.mpr hu]
  rw [e1, e2, ← hcv]
  refine setIntegral_congr_fun measurableSet_Ioi fun u (hu : 0 < u) => ?_
  have hmpos : (0 : ℝ) < m := by exact_mod_cast hm
  simp only [ms8Sub, hu, ite_true, ms8W, ms8Rho]
  rw [hHG _ (Real.rpow_pos_of_pos hu _)]
  have := ms8_rho_pow hm hu
  unfold ms8Rho at this
  rw [this, abs_of_pos (by positivity), Complex.real_smul]
  push_cast; ring

end

end Auto

