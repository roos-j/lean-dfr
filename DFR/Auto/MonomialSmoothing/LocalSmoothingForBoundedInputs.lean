open MeasureTheory Set intervalIntegral

namespace Auto

noncomputable section

theorem mnst_norm_expPhase (x : ℝ) : ‖Complex.exp (2 * Real.pi * Complex.I * x)‖ = 1 := by
  rw [Complex.norm_exp]; simp

/-- Integration by parts on a piece where `|φ'| ≥ 2S` with constant sign. -/
theorem mnst_ibp_piece {a b : ℝ} {H H' : ℝ → ℂ} {φ φ' φ'' : ℝ → ℝ} {M S : ℝ}
    (hab : a ≤ b) (hH : ∀ t ∈ Icc a b, HasDerivAt H (H' t) t) (hH' : ContinuousOn H' (Icc a b))
    (hM : ∀ t ∈ Icc a b, ‖H t‖ ≤ M)
    (hφ : ∀ t ∈ Icc a b, HasDerivAt φ (φ' t) t) (hφ' : ∀ t ∈ Icc a b, HasDerivAt φ' (φ'' t) t)
    (hφ'' : ContinuousOn φ'' (Icc a b))
    (hmono : MonotoneOn φ' (Icc a b) ∨ AntitoneOn φ' (Icc a b)) (hS : 0 < S)
    (hsgn : (∀ t ∈ Icc a b, 2 * S ≤ φ' t) ∨ (∀ t ∈ Icc a b, φ' t ≤ -(2 * S))) :
    ‖∫ t in a..b, Complex.exp (2 * Real.pi * Complex.I * φ t) * H t‖
      ≤ 1 / S * ((∫ t in a..b, ‖H' t‖) + M) := by
  set k : ℂ := 2 * Real.pi * Complex.I with hk
  have hk0 : k ≠ 0 := by simp [hk, Real.pi_ne_zero]
  have hkn : ‖k‖ = 2 * Real.pi := by simp [hk, abs_of_pos Real.pi_pos]
  have hq : ‖k‖⁻¹ ≤ 1 := by rw [hkn]; apply inv_le_one_of_one_le₀; linarith [Real.pi_gt_three]
  have hne : ∀ t ∈ Icc a b, φ' t ≠ 0 := by
    intro t ht; rcases hsgn with h | h
    · have := h t ht; intro h0; linarith
    · have := h t ht; intro h0; linarith
  have hr : ∀ t ∈ Icc a b, |(φ' t)⁻¹| ≤ 1 / (2 * S) := by
    intro t ht
    rw [abs_inv, one_div]
    apply inv_anti₀ (by positivity)
    rcases hsgn with h | h
    · have := h t ht; rw [abs_of_pos (by linarith)]; exact this
    · have := h t ht; rw [abs_of_neg (by linarith)]; linarith
  have hφ'c : ContinuousOn φ' (Icc a b) := fun t ht => (hφ' t ht).continuousAt.continuousWithinAt
  have hHc : ContinuousOn H (Icc a b) := fun t ht => (hH t ht).continuousAt.continuousWithinAt
  have hφc : ContinuousOn φ (Icc a b) := fun t ht => (hφ t ht).continuousAt.continuousWithinAt
  set E : ℝ → ℂ := fun t => Complex.exp (k * φ t) with hE
  set E' : ℝ → ℂ := fun t => Complex.exp (k * φ t) * (k * φ' t) with hE'
  set g : ℝ → ℂ := fun t => H t * (((φ' t)⁻¹ : ℝ) : ℂ) / k with hg
  set g' : ℝ → ℂ := fun t => (H' t * (((φ' t)⁻¹ : ℝ) : ℂ)
      + H t * ((-φ'' t / φ' t ^ 2 : ℝ) : ℂ)) / k with hg'
  have hU : uIcc a b = Icc a b := uIcc_of_le hab
  have hq2 : ‖k‖⁻¹ ≤ 1 / 2 := by
    rw [hkn]; rw [one_div]; apply inv_anti₀ (by norm_num); linarith [Real.pi_gt_three]
  have hq0 : 0 ≤ ‖k‖⁻¹ := by positivity
  have hEd : ∀ t ∈ uIcc a b, HasDerivAt E (E' t) t := by
    intro t ht; rw [hU] at ht
    exact (((hφ t ht).ofReal_comp).const_mul k).cexp
  have hgd : ∀ t ∈ uIcc a b, HasDerivAt g (g' t) t := by
    intro t ht; rw [hU] at ht
    exact ((hH t ht).mul ((hφ' t ht).inv (hne t ht)).ofReal_comp).div_const k
  have hrc : ContinuousOn (fun t => (φ' t)⁻¹) (Icc a b) := hφ'c.inv₀ hne
  have hsc : ContinuousOn (fun t => -φ'' t / φ' t ^ 2) (Icc a b) :=
    hφ''.neg.div (hφ'c.pow 2) (fun t ht => pow_ne_zero 2 (hne t ht))
  have hg'c : ContinuousOn g' (Icc a b) :=
    ((hH'.mul (Complex.continuous_ofReal.comp_continuousOn hrc)).add
      (hHc.mul (Complex.continuous_ofReal.comp_continuousOn hsc))).div_const k
  have hEc : ContinuousOn E (Icc a b) :=
    (Complex.continuous_exp.comp_continuousOn
      (continuousOn_const.mul (Complex.continuous_ofReal.comp_continuousOn hφc)))
  have hE'c : ContinuousOn E' (Icc a b) :=
    hEc.mul (continuousOn_const.mul (Complex.continuous_ofReal.comp_continuousOn hφ'c))
  have hibp := integral_mul_deriv_eq_deriv_mul hgd hEd
    ((hg'c.mono hU.subset).intervalIntegrable) ((hE'c.mono hU.subset).intervalIntegrable)
  have heq : ∫ t in a..b, Complex.exp (k * φ t) * H t = ∫ t in a..b, g t * E' t := by
    apply integral_congr
    intro t ht; rw [hU] at ht
    have h1 : (φ' t : ℂ) ≠ 0 := Complex.ofReal_ne_zero.2 (hne t ht)
    simp only [hg, hE']; push_cast; field_simp
  have hEn : ∀ t, ‖E t‖ = 1 := fun t => by simp only [hE, hk]; exact mnst_norm_expPhase _
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM a ⟨le_rfl, hab⟩)
  set u : ℝ := 1 / (2 * S) with hu
  have hu0 : 0 < u := by positivity
  have hgb : ∀ t ∈ Icc a b, ‖g t‖ ≤ M * u * ‖k‖⁻¹ := by
    intro t ht
    simp only [hg, norm_mul, Complex.norm_real, Real.norm_eq_abs, div_eq_mul_inv]
    gcongr
    · exact hM t ht
    · exact hr t ht
    · exact (norm_inv k).le
  have hY := mnst_int_abs_inv_deriv hab hφ' hφ'' hmono hS hsgn
  set Y := ∫ t in a..b, |φ'' t / φ' t ^ 2| with hYdef
  set X := ∫ t in a..b, ‖H' t‖ with hXdef
  have hX0 : 0 ≤ X := integral_nonneg hab (fun _ _ => norm_nonneg _)
  have hHn : IntervalIntegrable (fun t => ‖H' t‖) volume a b :=
    ((hH'.norm).mono hU.subset).intervalIntegrable
  have hsa : ContinuousOn (fun t => |φ'' t / φ' t ^ 2|) (Icc a b) :=
    (hφ''.div (hφ'c.pow 2) (fun t ht => pow_ne_zero 2 (hne t ht))).abs
  have hsn : IntervalIntegrable (fun t => |φ'' t / φ' t ^ 2|) volume a b :=
    (hsa.mono hU.subset).intervalIntegrable
  have hint : ‖∫ t in a..b, g' t * E t‖ ≤ ‖k‖⁻¹ * (X * u + M * Y) := by
    refine (intervalIntegral.norm_integral_le_integral_norm hab).trans ?_
    have h2 : ∫ t in a..b, ‖k‖⁻¹ * (‖H' t‖ * u + M * |φ'' t / φ' t ^ 2|)
        = ‖k‖⁻¹ * (X * u + M * Y) := by
      rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_add
        (hHn.mul_const _) (hsn.const_mul _), intervalIntegral.integral_mul_const,
        intervalIntegral.integral_const_mul]
    rw [← h2]
    apply integral_mono_on hab
    · exact (((hg'c.mul hEc).norm).mono hU.subset).intervalIntegrable
    · exact ((continuousOn_const.mul (((hH'.norm).mul continuousOn_const).add
        (continuousOn_const.mul hsa))).mono hU.subset).intervalIntegrable
    intro t ht
    rw [norm_mul, hEn, mul_one]
    simp only [hg', norm_div]
    rw [div_eq_mul_inv, mul_comm]
    gcongr
    refine (norm_add_le _ _).trans ?_
    rw [norm_mul, norm_mul, Complex.norm_real, Complex.norm_real, Real.norm_eq_abs,
      Real.norm_eq_abs, neg_div, abs_neg]
    exact add_le_add (mul_le_mul_of_nonneg_left (hr t ht) (norm_nonneg _))
      (mul_le_mul_of_nonneg_right (hM t ht) (abs_nonneg _))
  rw [hk.symm] at *
  change ‖∫ t in a..b, Complex.exp (k * φ t) * H t‖ ≤ _
  rw [heq, hibp]
  have ha' : a ∈ Icc a b := ⟨le_rfl, hab⟩
  have hb' : b ∈ Icc a b := ⟨hab, le_rfl⟩
  have hga := hgb a ha'; have hgb' := hgb b hb'
  have hsum : ‖g b * E b - g a * E a - ∫ t in a..b, g' t * E t‖
      ≤ ‖g b‖ + ‖g a‖ + ‖∫ t in a..b, g' t * E t‖ := by
    refine (norm_sub_le _ _).trans ?_
    gcongr
    refine (norm_sub_le _ _).trans ?_
    rw [norm_mul, norm_mul, hEn, hEn, mul_one, mul_one]
  refine hsum.trans ?_
  have hMY : M * Y ≤ M * u := mul_le_mul_of_nonneg_left hY hM0
  have e1 : 1 / S = 2 * u := by rw [hu]; field_simp
  rw [e1]
  have : ‖k‖⁻¹ * (X * u + M * Y) ≤ ‖k‖⁻¹ * (X * u + M * u) := by gcongr
  nlinarith [mul_nonneg hq0 hu0.le, mul_nonneg (mul_nonneg hq0 hu0.le) hM0,
    mul_nonneg (mul_nonneg hq0 hu0.le) hX0]

end

end Auto

end

