/-! ### Proposition 6.1: the main estimate for the localized inputs -/
theorem integrable_of_tsupport_Icc {ψ : ℝ → ℝ} (hψ : ContDiff ℝ ∞ ψ) {A B : ℝ}
    (hψs : tsupport ψ ⊆ Icc A B) : Integrable ψ volume :=
  hψ.continuous.integrable_of_hasCompactSupport (isCompact_Icc.of_isClosed_subset
    (isClosed_tsupport ψ) hψs)

theorem mono61_whole {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) (hLC : MonoLocCorr r A B)
    (χ : ℝ × ℝ → ℝ) (hχ : ContDiff ℝ ∞ χ) (hχc : HasCompactSupport χ) {a0 : ℝ} (ha0 : 0 ≤ a0) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ ψ : ℝ → ℝ, ContDiff ℝ ∞ ψ → tsupport ψ ⊆ Icc A B → monoC20 ψ ≤ 1 →
    ∀ L : ℝ, 2 ^ 16 ≤ L → ∀ high₁ high₂ : Bool, (high₁ = true ∨ high₂ = true) →
    ∀ (M₁ E₁ Ω₁ Λ₁ M₂ E₂ Ω₂ Λ₂ : ℝ) (G₁ G₂ : ℤ × ℤ → ℝ × ℝ → ℂ),
      (∀ m, MonoGoodPiece 0 (L ^ (-(3 / 4 : ℝ))) M₁ E₁ Ω₁ Λ₁ m (G₁ m)) →
      (∀ m, MonoGoodPiece 1 (L ^ (-(3 / 4 : ℝ))) M₂ E₂ Ω₂ Λ₂ m (G₂ m)) →
      0 ≤ M₁ → M₁ ≤ a0 → 0 ≤ E₁ → E₁ ≤ a0 * L ^ (-(3 / 4 : ℝ)) → 0 ≤ Ω₁ → Ω₁ ≤ 4 * L →
      0 ≤ Λ₁ → Λ₁ ≤ a0 * L →
      0 ≤ M₂ → M₂ ≤ a0 → 0 ≤ E₂ → E₂ ≤ a0 * L ^ (-(3 / 4 : ℝ)) → 0 ≤ Ω₂ → Ω₂ ≤ 4 * L →
      0 ≤ Λ₂ → Λ₂ ≤ a0 * L →
      (high₁ = true → ∀ m p ξ, |ξ| < L / 4 → 𝓕 (monoFib 0 (G₁ m) p) ξ = 0) →
      (high₂ = true → ∀ m p ξ, |ξ| < L / 4 → 𝓕 (monoFib 1 (G₂ m) p) ξ = 0) →
      ∀ S₁ S₂ : Finset (ℤ × ℤ),
      eLpNorm (fun z => (χ z : ℂ) * monoT r ψ
          (fun w => ∑ m ∈ S₁, monoVWhole (L ^ (-(3 / 4 : ℝ))) m (G₁ m) w)
          (fun w => ∑ m ∈ S₂, monoVWhole (L ^ (-(3 / 4 : ℝ))) m (G₂ m) w) z) 1 volume
        ≤ ENNReal.ofReal (C * L ^ (-((1 / 39 : ℝ) / 256))) := by
  obtain ⟨Css, hCss0, hss⟩ := mono61_ss hr hA hAB χ hχ hχc ha0
  obtain ⟨Clc, hClc0, hlc⟩ := mono61_lc hLC χ hχ hχc ha0
  refine ⟨Css + 2 * Clc, by positivity, ?_⟩
  intro ψ hψ hψs hC20 L hL high₁ high₂ hhigh M₁ E₁ Ω₁ Λ₁ M₂ E₂ Ω₂ Λ₂ G₁ G₂ hG₁ hG₂ hM₁0 hM₁ hE₁0 hE₁
    hΩ₁0 hΩ₁ hΛ₁0 hΛ₁ hM₂0 hM₂ hE₂0 hE₂ hΩ₂0 hΩ₂ hΛ₂0 hΛ₂ hlow₁ hlow₂ S₁ S₂
  have e1 := hss ψ hψ hψs hC20 L hL high₁ high₂ hhigh M₁ E₁ Ω₁ Λ₁ M₂ E₂ Ω₂ Λ₂ G₁ G₂ hG₁ hG₂ hM₁0 hM₁
    hM₂0 hM₂ hlow₁ hlow₂ S₁ S₂
  obtain ⟨e3, e2⟩ := hlc ψ hψ hψs hC20 L hL M₁ E₁ Ω₁ Λ₁ M₂ E₂ Ω₂ Λ₂ G₁ G₂ hG₁ hG₂ hM₁0 hM₁ hE₁0 hE₁
    hΩ₁0 hΩ₁ hΛ₁0 hΛ₁ hM₂0 hM₂ hE₂0 hE₂ hΩ₂0 hΩ₂ hΛ₂0 hΛ₂ S₁ S₂
  have hL1 : 1 ≤ L := le_trans (by norm_num) hL
  obtain ⟨hh, -, -, -, -, hR1, -, -, -, -, -, -, hρ0, hρ1⟩ := mono61_facts hL
  set h := L ^ (-(3 / 4 : ℝ)) with hh_def
  set R := L ^ (13 / 16 : ℝ) with hR_def
  set ρ := L ^ (-((1 / 39 : ℝ) / 64)) with hρ_def
  have hR0 : 0 < R := by linarith
  have hr0 : 0 < r := by linarith
  have hψi := integrable_of_tsupport_Icc hψ hψs
  have hχm : Measurable χ := hχ.continuous.measurable
  have hψm : Measurable ψ := hψ.continuous.measurable
  set B := monoC2 0 a0 / ρ with hB_def
  set Sh₁ := fun w => ∑ m ∈ S₁, monoVSharp 0 h R ρ m (G₁ m) w
  set Fl₁ := fun w => ∑ m ∈ S₁, monoVFlat 0 h R ρ m (G₁ m) w
  set Wh₁ := fun w => ∑ m ∈ S₁, monoVWhole h m (G₁ m) w
  set Sh₂ := fun w => ∑ m ∈ S₂, monoVSharp 1 h R ρ m (G₂ m) w
  set Fl₂ := fun w => ∑ m ∈ S₂, monoVFlat 1 h R ρ m (G₂ m) w
  set Wh₂ := fun w => ∑ m ∈ S₂, monoVWhole h m (G₂ m) w
  have hW₁ : Wh₁ = Sh₁ + Fl₁ := by
    funext w; simp only [Wh₁, Sh₁, Fl₁, Pi.add_apply, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun m _ => monoVWhole_eq_add 0 h R ρ m (G₁ m) w
  have hW₂ : Wh₂ = Sh₂ + Fl₂ := by
    funext w; simp only [Wh₂, Sh₂, Fl₂, Pi.add_apply, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun m _ => monoVWhole_eq_add 1 h R ρ m (G₂ m) w
  have mS₁ : Measurable Sh₁ := Finset.measurable_sum _ fun m _ => measurable_monoVSharp (hG₁ m)
    hR0 hρ0
  have mF₁ : Measurable Fl₁ := Finset.measurable_sum _ fun m _ => measurable_monoVFlat (hG₁ m) hR0
    hρ0
