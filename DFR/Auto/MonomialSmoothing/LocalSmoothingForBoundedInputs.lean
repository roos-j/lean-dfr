/-- The curve `Γ(t) = (-t, Q(t))`. -/
def msubGam (r t : ℝ) : ℝ × ℝ := (-t, monoQ r t)

/-- The incidence set (3.11) after the substitution `z = (x + t, y)`, for the box
`D ⊆ closedBall 0 R`. -/
def msubEset (r A B R : ℝ) (α β : ℝ × ℝ → ℝ) (ε : ℝ) : Set ((ℝ × ℝ) × ℝ) :=
  {p | (p.1.1 - p.2, p.1.2) ∈ Metric.closedBall (0 : ℝ × ℝ) R ∧ p.2 ∈ Icc A B ∧
    |α p.1 - monoq r p.2 * β (p.1 + msubGam r p.2)| ≤ ε}

theorem msub_meas_monoQ (r : ℝ) : Measurable (monoQ r) := by
  unfold monoQ; exact measurable_id.pow_const r

theorem msub_meas_monoq (r : ℝ) : Measurable (monoq r) := by
  unfold monoq; exact measurable_const.mul (measurable_id.pow_const _)

theorem msub_meas_Gam (r : ℝ) : Measurable (msubGam r) := by
  unfold msubGam; exact measurable_neg.prodMk (msub_meas_monoQ r)

theorem msub_Eset_meas (r A B R : ℝ) {α β : ℝ × ℝ → ℝ} (hα : Measurable α) (hβ : Measurable β)
    (ε : ℝ) : MeasurableSet (msubEset r A B R α β ε) := by
  have hq := msub_meas_monoq r
  have hG := msub_meas_Gam r
  refine ((by fun_prop : Measurable fun p : (ℝ × ℝ) × ℝ => (p.1.1 - p.2, p.1.2))
    Metric.isClosed_closedBall.measurableSet).inter ((measurable_snd measurableSet_Icc).inter ?_)
  exact measurableSet_le (f := fun p : (ℝ × ℝ) × ℝ => |α p.1 - monoq r p.2 * β (p.1 + msubGam r
    p.2)|)
    (continuous_abs.measurable.comp (f := fun p : (ℝ × ℝ) × ℝ =>
      α p.1 - monoq r p.2 * β (p.1 + msubGam r p.2)) (by fun_prop)) measurable_const

theorem msub_ball_facts {ρ : ℝ} (hρ : 0 < ρ) :
    MeasurableSet (Metric.closedBall (0 : ℝ × ℝ) ρ) ∧
      volume (Metric.closedBall (0 : ℝ × ℝ) ρ) ≠ ∞ ∧
      0 < (volume (Metric.closedBall (0 : ℝ × ℝ) ρ)).toReal := by
  refine ⟨Metric.isClosed_closedBall.measurableSet, ?_, ?_⟩
  · rw [msub_vol_ball2]; exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top
  · rw [msub_vol_ball2, ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity)]
    positivity

theorem msub_Eset_facts {r A B R : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) (hR : 0 < R) :
    ∃ D0 D1 : Set (ℝ × ℝ), MeasurableSet D0 ∧ MeasurableSet D1 ∧ volume D0 ≠ ∞ ∧
      volume D1 ≠ ∞ ∧ 0 < (volume D0).toReal ∧ 0 < (volume D1).toReal ∧
      ∀ α β ε, (∀ p ∈ msubEset r A B R α β ε, p.1 ∈ D0 ∧ p.1 + msubGam r p.2 ∈ D1) ∧
        volume (msubEset r A B R α β ε) ≠ ∞ := by
  obtain ⟨QM, hQM, hQ⟩ := msub_bound_of_contOn (f := monoQ r) (A := A) (B := B)
    ((continuous_monoQ (by linarith)).continuousOn)
  have hB : 0 < B := by linarith
  obtain ⟨m0, f0, p0⟩ := msub_ball_facts (ρ := R + B) (by linarith)
  obtain ⟨m1, f1, p1⟩ := msub_ball_facts (ρ := R + QM) (by linarith)
  refine ⟨_, _, m0, m1, f0, f1, p0, p1, fun α β ε => ?_⟩
  have hmem : ∀ p ∈ msubEset r A B R α β ε, p.1 ∈ Metric.closedBall (0 : ℝ × ℝ) (R + B) ∧
      p.1 + msubGam r p.2 ∈ Metric.closedBall (0 : ℝ × ℝ) (R + QM) := by
    rintro p ⟨h1, h2, -⟩
    rw [mem_closedBall_zero_iff, msub_norm2] at h1
    simp only at h1
    obtain ⟨a1, a2⟩ := max_le_iff.mp h1
    have hq := hQ p.2 h2
    rw [mem_closedBall_zero_iff, msub_norm2, mem_closedBall_zero_iff, msub_norm2]
    simp only [msubGam, Prod.fst_add, Prod.snd_add]
    obtain ⟨l1, u1⟩ := abs_le.mp a1
    obtain ⟨l2, u2⟩ := abs_le.mp a2
    obtain ⟨l3, u3⟩ := abs_le.mp hq
    have t1 := h2.1; have t2 := h2.2
    refine ⟨max_le (abs_le.mpr ⟨by linarith, by linarith⟩) (abs_le.mpr ⟨by linarith, by linarith⟩),
      max_le (abs_le.mpr ⟨by linarith, by linarith⟩) (abs_le.mpr ⟨by linarith, by linarith⟩)⟩
  refine ⟨hmem, ?_⟩
  refine ne_top_of_le_ne_top ?_ (measure_mono (t := Metric.closedBall (0 : ℝ × ℝ) (R + B) ×ˢ
    Icc A B) fun p hp => ⟨(hmem p hp).1, hp.2.1⟩)
  rw [Measure.volume_eq_prod, Measure.prod_prod]
  exact ENNReal.mul_ne_top f0 (by rw [Real.volume_Icc]; exact ENNReal.ofReal_ne_top)

theorem msub_Gam_sum (r : ℝ) (z0 : ℝ × ℝ) (t : ℝ × ℝ × ℝ) :
    z0 + msubGam r t.1 - msubGam r t.2.1 + msubGam r t.2.2 = z0 + msubTh r t := by
  ext <;> simp [msubGam, msubTh] <;> ring

/-- Lemma 3.1 in the case `|α| ≥ c₀`, for the incidence set. -/
theorem msub_alpha_case {r A B R : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) (hR : 0 < R)
    {c0 : ℝ} (hc0 : 0 < c0) :
    ∃ C, 0 ≤ C ∧ ∀ α β : ℝ × ℝ → ℝ, Measurable α → Measurable β → (∀ z, c0 ≤ |α z|) →
      ∀ ε : ℝ, 0 < ε → (volume (msubEset r A B R α β ε)).toReal ≤ C * ε ^ (1 / 39 : ℝ) := by
  obtain ⟨D0, D1, m0, m1, f0, f1, p0, p1, hfacts⟩ := msub_Eset_facts hr hA hAB hR
  obtain ⟨qm, qM, hqm, hq⟩ := msub_q_bounds (by linarith : (0:ℝ) < r) hA hAB.le
  obtain ⟨Cν, hCν, hCν'⟩ := msub_nu_alpha hr hA hAB hc0
  set Kl := qM / (qm * qm) + 2 / qm
  have hqM : 0 < qM := lt_of_lt_of_le hqm ((hq A ⟨le_rfl, hAB.le⟩).1.trans
    (hq A ⟨le_rfl, hAB.le⟩).2)
  have hKl : 0 < Kl := by positivity
  set K := 32 * (volume D0).toReal ^ 2 * (volume D1).toReal * (Cν * Kl ^ (1 / 13 : ℝ))
  have hK : 0 ≤ K := by positivity
  refine ⟨K ^ (1 / 3 : ℝ), by positivity, fun α β hα hβ hαc ε hε => ?_⟩
  obtain ⟨hmem, hfin⟩ := hfacts α β ε
  have h3 := msub_case (msub_meas_Gam r) (msub_Eset_meas r A B R hα hβ ε) m0 m1 f0 f1 p0 p1
    (fun p hp => (hmem p hp).1) (fun p hp => (hmem p hp).2) hfin (qg := monoq r) (a := α)
    (b := β) hqm hq (fun p hp => ⟨hp.2.1, hp.2.2⟩)
    (y := Cν * (Kl * ε) ^ (1 / 13 : ℝ)) (by positivity) (fun z0 => by
      simp_rw [msub_Gam_sum]
      exact hCν' (α z0) (hαc z0) (fun u => β (z0 + u))
        (hβ.comp (measurable_const.add measurable_id)) (Kl * ε) (by positivity))
  refine msub_final_alg ENNReal.toReal_nonneg hK hε (le_of_le_of_eq h3 ?_)
  rw [Real.mul_rpow hKl.le hε.le]; ring

end
