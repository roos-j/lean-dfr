/-- The bilinear bound `B_γ(F,G) ≤ ‖F‖₂ · (‖G‖_{3/2}-type quantity)`, from `TT*` and Young. -/
theorem mimp_E {S : Set ℝ} {γ : ℝ → ℝ × ℝ} (hγ : Measurable γ) {k : ℝ × ℝ → ℝ≥0∞}
    (hk : Measurable k)
    (hD : ∀ H : ℝ × ℝ → ℝ≥0∞, Measurable H →
      ∫⁻ s in S, ∫⁻ t in S, H (γ t - γ s) ≤ ∫⁻ v, H v * k v)
    {F G : ℝ × ℝ → ℝ≥0∞} (hF : Measurable F) (hG : Measurable G) :
    ∫⁻ z, F z * ∫⁻ t in S, G (z + γ t) ≤
      (∫⁻ z, F z ^ (2 : ℝ)) ^ (1 / 2 : ℝ) *
        ((∫⁻ w, G w ^ (3 / 2 : ℝ)) ^ (4 / 3 : ℝ) * (∫⁻ v, k v ^ (3 / 2 : ℝ)) ^ (2 / 3 : ℝ))
          ^ (1 / 2 : ℝ) := by
  have hA : Measurable fun z => ∫⁻ t in S, G (z + γ t) := by
    have : Measurable fun p : (ℝ × ℝ) × ℝ => G (p.1 + γ p.2) := by fun_prop
    exact this.lintegral_prod_right'
  have h1 := ENNReal.lintegral_mul_le_Lp_mul_Lq volume Real.HolderConjugate.two_two
    hF.aemeasurable hA.aemeasurable
  refine h1.trans ?_
  norm_num
  gcongr
  have h2 := (mimp_TTstar hγ hD hG).trans (mimp_young3 hG hk)
  simp only [ENNReal.rpow_two] at h2
  exact h2

theorem mimp_adjoint {S : Set ℝ} {γ : ℝ → ℝ × ℝ} (hγ : Measurable γ)
    {F G : ℝ × ℝ → ℝ≥0∞} (hF : Measurable F) (hG : Measurable G) :
    ∫⁻ z, F z * ∫⁻ t in S, G (z + γ t) = ∫⁻ w, G w * ∫⁻ t in S, F (w + -γ t) := by
  have e1 : ∀ z, F z * ∫⁻ t in S, G (z + γ t) = ∫⁻ t in S, F z * G (z + γ t) := by
    intro z; rw [lintegral_const_mul _ (by fun_prop)]
  have e2 : ∀ w, G w * ∫⁻ t in S, F (w + -γ t) = ∫⁻ t in S, F (w + -γ t) * G w := by
    intro w; rw [← lintegral_const_mul _ (by fun_prop)]; congr 1; ext t; ring
  simp_rw [e1, e2]
  rw [lintegral_lintegral_swap (by apply Measurable.aemeasurable; fun_prop)]
  conv_rhs => rw [lintegral_lintegral_swap (by apply Measurable.aemeasurable; fun_prop)]
  congr 1; ext t
  rw [← lintegral_add_right_eq_self (fun w => F (w + -γ t) * G w) (γ t)]
  congr 1; ext z
  simp

theorem mimp_D_neg {S : Set ℝ} {γ : ℝ → ℝ × ℝ} (hγ : Measurable γ) {k : ℝ × ℝ → ℝ≥0∞}
    (hD : ∀ H : ℝ × ℝ → ℝ≥0∞, Measurable H →
      ∫⁻ s in S, ∫⁻ t in S, H (γ t - γ s) ≤ ∫⁻ v, H v * k v) :
    ∀ H : ℝ × ℝ → ℝ≥0∞, Measurable H →
      ∫⁻ s in S, ∫⁻ t in S, H ((fun t => -γ t) t - (fun t => -γ t) s) ≤ ∫⁻ v, H v * k v := by
  intro H hH
  have e : ∀ s t, (fun t => -γ t) t - (fun t => -γ t) s = γ s - γ t := by
    intro s t; simp only; abel
  simp_rw [e]
  rw [lintegral_lintegral_swap (by apply Measurable.aemeasurable; fun_prop)]
  exact hD H hH

end

