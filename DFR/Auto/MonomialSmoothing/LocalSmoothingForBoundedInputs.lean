theorem exists_normalize {u : ℝ × ℝ → ℂ} (hu : Measurable u) {B : ℝ} (hb : ∀ z, ‖u z‖ ≤ B) :
    ∃ u' : ℝ × ℝ → ℂ, Measurable u' ∧ (∀ z, ‖u' z‖ ≤ 1) ∧ u = fun z => (B : ℂ) * u' z := by
  have hB0 : 0 ≤ B := (norm_nonneg _).trans (hb 0)
  rcases hB0.eq_or_lt with hB | hB
  · refine ⟨0, measurable_const, fun z => by simp, ?_⟩
    funext z
    have := hb z; rw [← hB] at this
    simpa using norm_le_zero_iff.mp this
  · refine ⟨fun z => (B⁻¹ : ℂ) * u z, measurable_const.mul hu, fun z => ?_, ?_⟩
    · rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hB.le, inv_mul_le_iff₀ hB,
        mul_one]
      exact hb z
    · funext z
      have : (B : ℂ) ≠ 0 := by exact_mod_cast hB.ne'
      field_simp

theorem monoT_zero_psi (r : ℝ) (f₁ f₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : monoT r (0 : ℝ → ℝ) f₁ f₂ z = 0
  := by
  simp [monoT]

/-- The normalized form of Proposition 6.1. -/
theorem mono61_normalized {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) (hLC : MonoLocCorr r
  A B)
    (χ : ℝ × ℝ → ℝ) (hχ : ContDiff ℝ ∞ χ) (hχc : HasCompactSupport χ) :
    ∃ C : ℝ, 0 < C ∧ ∀ ψ : ℝ → ℝ, ContDiff ℝ ∞ ψ → tsupport ψ ⊆ Icc A B → monoC20 ψ ≤ 1 →
      ∀ L : ℝ, 1 ≤ L → ∀ u₁ u₂ : ℝ × ℝ → ℂ, Measurable u₁ → Measurable u₂ →
      (∀ z, ‖u₁ z‖ ≤ 1) → (∀ z, ‖u₂ z‖ ≤ 1) →
        eLpNorm (fun z => (χ z : ℂ) * monoT r ψ (monoP 0 monoKPsiA L u₁) (monoP 1 monoKPhi L u₂) z)
            1 volume ≤ ENNReal.ofReal (C * L ^ (-((1 / 39 : ℝ) / 256))) ∧
        eLpNorm (fun z => (χ z : ℂ) *
            monoT r ψ (monoP 0 monoKPhi (L / 2) u₁) (monoP 1 monoKPsiA L u₂) z)
            1 volume ≤ ENNReal.ofReal (C * L ^ (-((1 / 39 : ℝ) / 256))) := by
  set Â := (∫ s, ‖monoKPsiA s‖) + ∫ s, ‖monoKPhi s‖
  have hkA : 0 ≤ ∫ s, ‖monoKPsiA s‖ := integral_nonneg fun _ => norm_nonneg _
  have hkP : 0 ≤ ∫ s, ‖monoKPhi s‖ := integral_nonneg fun _ => norm_nonneg _
  have hÂ : 0 ≤ Â := by positivity
  obtain ⟨C₁, hC₁0, h₁⟩ := mono61_loc hr hA hAB hLC χ hχ hχc monoPsiE_contDiff
    monoPsiE_hasCompactSupport (fun x hx => monoPsiE_eq_zero_large hx) monoPhiE_contDiff
    monoPhiE_hasCompactSupport (fun x hx => monoPhiE_eq_zero' hx) hÂ
  obtain ⟨C₂, hC₂0, h₂⟩ := mono61_loc hr hA hAB hLC χ hχ hχc monoPhiE_contDiff
    monoPhiE_hasCompactSupport (fun x hx => monoPhiE_eq_zero' hx) monoPsiE_contDiff
    monoPsiE_hasCompactSupport (fun x hx => monoPsiE_eq_zero_large hx) hÂ
  set σ : ℝ := (1 / 39 : ℝ) / 256
  set c16 : ℝ := (2 ^ 16 : ℝ) ^ σ
  have hc16 : 0 < c16 := by positivity
  set Iχ := ∫ z, |χ z|
  have hIχ : 0 ≤ Iχ := integral_nonneg fun _ => abs_nonneg _
  have hχi : Integrable χ volume := hχ.continuous.integrable_of_hasCompactSupport hχc
  set Cs := Iχ * (B - A) * Â * Â * c16
  have hCs : 0 ≤ Cs := by have : 0 ≤ B - A := by linarith
                          positivity
  refine ⟨C₁ + C₂ + Cs + 1, by positivity, ?_⟩
  intro ψ hψ hψs hC20 L hL u₁ u₂ hu₁ hu₂ hb₁ hb₂
  have hL0 : 0 < L := by linarith
  have hLσ : 0 ≤ L ^ (-σ) := by positivity
  have hr0 : 0 < r := by linarith
  have hψi := integrable_of_tsupport_Icc hψ hψs
  have hψv := vanish_of_tsupport hψs
  have hbP : ∀ (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L' : ℝ), 0 < L' → (∫ s, ‖κ s‖) ≤ Â →
      ∀ u : ℝ × ℝ → ℂ, (∀ z, ‖u z‖ ≤ 1) → ∀ z, ‖monoP j κ L' u z‖ ≤ Â := fun j κ L' hL' hk u hu z =>
    (mloc_P_norm_le j κ hL' hu z).trans (by rw [mul_one]; exact hk)
  have hkA' : (∫ s, ‖monoKPsiA s‖) ≤ Â := by linarith
  have hkP' : (∫ s, ‖monoKPhi s‖) ≤ Â := by linarith
  -- the small-`L` case
  have hsmall : ∀ f₁ f₂ : ℝ × ℝ → ℂ, Measurable f₁ → Measurable f₂ → (∀ z, ‖f₁ z‖ ≤ Â) → (∀ z, ‖f₂
    z‖ ≤ Â) → L < 2 ^ 16 →
      eLpNorm (fun z => (χ z : ℂ) * monoT r ψ f₁ f₂ z) 1 volume
        ≤ ENNReal.ofReal ((C₁ + C₂ + Cs + 1) * L ^ (-σ)) := by
    intro f₁ f₂ hm₁ hm₂ hf₁ hf₂ hL16
    refine (eLpNorm_chiT_le hχi hψi hψv hÂ (fun z _ t _ => hf₁ _) (fun z _ t _ => hf₂ _)
      ((Complex.measurable_ofReal.comp hχ.continuous.measurable).mul
        (measurable_monoT (by linarith) hψ.continuous.measurable hm₁
          hm₂)).aestronglyMeasurable).trans ?_
    refine ENNReal.ofReal_le_ofReal ?_
    have hIψ : ∫ t, |ψ t| ≤ 1 * (B - A) :=
      integral_abs_le_of_Icc hAB.le hψv fun t =>
        (abs_le_monoC20 hψ (isCompact_Icc.of_isClosed_subset (isClosed_tsupport ψ) hψs) t).trans
          hC20
    have h1 : 1 ≤ c16 * L ^ (-σ) := by
      rw [Real.rpow_neg hL0.le, ← div_eq_mul_inv, le_div_iff₀ (by positivity), one_mul]
      exact Real.rpow_le_rpow hL0.le hL16.le (by positivity)
    have h2 : Iχ * (∫ t, |ψ t|) * Â * Â ≤ Iχ * (B - A) * Â * Â := by
      have := hIψ; rw [one_mul] at this; gcongr
    calc Iχ * (∫ t, |ψ t|) * Â * Â ≤ Iχ * (B - A) * Â * Â := h2
      _ ≤ Iχ * (B - A) * Â * Â * (c16 * L ^ (-σ)) := by
          have : 0 ≤ Iχ * (B - A) * Â * Â := by have : 0 ≤ B - A := by linarith
                                                positivity
          nlinarith
      _ = Cs * L ^ (-σ) := by ring
      _ ≤ (C₁ + C₂ + Cs + 1) * L ^ (-σ) := by gcongr; linarith
  have hmP : ∀ (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L' : ℝ) (u : ℝ × ℝ → ℂ), Measurable u →
      Measurable (monoP j κ L' u) := fun j κ L' u hu => measurable_monoP' j κ L' hu
  constructor
  · by_cases hL16 : 2 ^ 16 ≤ L
    · have hh : 0 < L ^ (-(3 / 4 : ℝ)) := by positivity
      refine (h₁ ψ hψ hψs hC20 L hL16 true false (Or.inl rfl) _ _ (hmP 0 _ L u₁ hu₁) (hmP 1 _ L u₂
        hu₂)
        (hbP 0 _ L hL0 hkA' u₁ hb₁) (hbP 1 _ L hL0 hkP' u₂ hb₂)
        (mloc_P_psiE_psiA 0 hL0 hu₁ hb₁) (mloc_P_phiE_phi 1 hL0 hu₂ hb₂)
        (fun _ m p ξ hξ => monoUjm_psiE_low 0 hL0 hh m (hmP 0 _ L u₁ hu₁) (hbP 0 _ L hL0 hkA' u₁
          hb₁)
          p ξ hξ)
        (fun h => absurd h (by simp))).trans ?_
      exact ENNReal.ofReal_le_ofReal (by gcongr; linarith)
    · exact hsmall _ _ (by fun_prop) (by fun_prop) (hbP 0 _ L hL0 hkA' u₁ hb₁) (hbP 1 _ L hL0 hkP'
        u₂ hb₂) (not_le.mp hL16)
  · by_cases hL16 : 2 ^ 16 ≤ L
    · have hh : 0 < L ^ (-(3 / 4 : ℝ)) := by positivity
      refine (h₂ ψ hψ hψs hC20 L hL16 false true (Or.inr rfl) _ _ (hmP 0 _ (L / 2) u₁ hu₁)
        (hmP 1 _ L u₂ hu₂) (hbP 0 _ (L / 2) (by positivity) hkP' u₁ hb₁) (hbP 1 _ L hL0 hkA' u₂ hb₂)
        (mloc_P_phiE_phi_half 0 hL0 hu₁ hb₁) (mloc_P_psiE_psiA 1 hL0 hu₂ hb₂)
        (fun h => absurd h (by simp))
        (fun _ m p ξ hξ => monoUjm_psiE_low 1 hL0 hh m (hmP 1 _ L u₂ hu₂) (hbP 1 _ L hL0 hkA' u₂
          hb₂)
          p ξ hξ)).trans ?_
      exact ENNReal.ofReal_le_ofReal (by gcongr; linarith)
    · exact hsmall _ _ (by fun_prop) (by fun_prop) (hbP 0 _ (L / 2) (by positivity) hkP' u₁ hb₁)
        (hbP 1 _ L hL0 hkA' u₂ hb₂)
        (not_le.mp hL16)

/-- **Proposition 6.1** from Lemma 5.1. -/
theorem mono_local61 {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) (hLC : MonoLocCorr r A B) :
    MonoLocal61 r A B := by
  intro χ hχ hχc
  obtain ⟨C, hC0, hN⟩ := mono61_normalized hr hA hAB hLC χ hχ hχc
  refine ⟨C, (1 / 39 : ℝ) / 256, hC0, by norm_num, ?_⟩
  intro ψ hψ hψs L hL u₁ u₂ hu₁ hu₂ B₁ B₂ hb₁ hb₂
  have hB₁ : 0 ≤ B₁ := (norm_nonneg _).trans (hb₁ 0)
  have hB₂ : 0 ≤ B₂ := (norm_nonneg _).trans (hb₂ 0)
  obtain ⟨v₁, hv₁, hbv₁, rfl⟩ := exists_normalize hu₁ hb₁
  obtain ⟨v₂, hv₂, hbv₂, rfl⟩ := exists_normalize hu₂ hb₂
  have hc := monoC20_nonneg ψ
  have hψc : HasCompactSupport ψ := isCompact_Icc.of_isClosed_subset (isClosed_tsupport ψ) hψs
  rcases hc.eq_or_lt with hc0 | hc0
  · have hψ0 := eq_zero_of_monoC20 hψ hψc hc0.symm
    subst hψ0
    have e : ∀ (f₁ f₂ : ℝ × ℝ → ℂ), (fun z => (χ z : ℂ) * monoT r (0 : ℝ → ℝ) f₁ f₂ z) = 0 := by
      intro f₁ f₂; funext z; simp [monoT_zero_psi]
    simp only [e, eLpNorm_zero, zero_le, and_self]
  set c := monoC20 ψ
  set ψ' : ℝ → ℝ := fun t => c⁻¹ * ψ t
  have hψ' : ContDiff ℝ ∞ ψ' := contDiff_const.mul hψ
  have hψ's : tsupport ψ' ⊆ Icc A B :=
    (tsupport_mul_subset_right (f := fun _ => c⁻¹) (g := ψ)).trans hψs
  have hC20' : monoC20 ψ' ≤ 1 := by
    rw [monoC20_const_mul (inv_nonneg.mpr hc), inv_mul_cancel₀ hc0.ne']
  have eψ : ψ = fun t => c * ψ' t := by funext t; simp only [ψ']; field_simp
  obtain ⟨n₁, n₂⟩ := hN ψ' hψ' hψ's hC20' L hL v₁ v₂ hv₁ hv₂ hbv₁ hbv₂
  have hscale : ∀ (f₁ f₂ : ℝ × ℝ → ℂ),
      (fun z => (χ z : ℂ) * monoT r ψ (fun w => (B₁ : ℂ) * f₁ w) (fun w => (B₂ : ℂ) * f₂ w) z)
        = ((c * B₁ * B₂ : ℝ) : ℂ) • fun z => (χ z : ℂ) * monoT r ψ' f₁ f₂ z := by
    intro f₁ f₂; funext z
    simp only [Pi.smul_apply, smul_eq_mul]
    rw [monoT_smul_left, monoT_smul_right, eψ, monoT_const_mul_psi]
    push_cast; ring
  have hfin : ∀ X : ℝ≥0∞, X ≤ ENNReal.ofReal (C * L ^ (-((1 / 39 : ℝ) / 256))) →
      ENNReal.ofReal (c * B₁ * B₂) * X
        ≤ ENNReal.ofReal (C * c * L ^ (-((1 / 39 : ℝ) / 256)) * B₁ * B₂) := by
    intro X hX
    refine (mul_le_mul' le_rfl hX).trans ?_
    rw [← ENNReal.ofReal_mul (by positivity)]
    exact ENNReal.ofReal_le_ofReal (le_of_eq (by ring))
  constructor
  · rw [monoP_smul, monoP_smul, hscale, eLpNorm_const_smul, enorm_ofReal_complex (by positivity)]
    exact hfin _ n₁
  · rw [monoP_smul, monoP_smul, hscale, eLpNorm_const_smul, enorm_ofReal_complex (by positivity)]
    exact hfin _ n₂

end

end Auto

