theorem mloc_Eta_nonneg (h : ℝ) (m : ℤ × ℤ) (z : ℝ × ℝ) : 0 ≤ monoEta h m z :=
  mul_nonneg (mloc_theta_nonneg _) (mloc_theta_nonneg _)

theorem mloc_Eta_le_one (h : ℝ) (m : ℤ × ℤ) (z : ℝ × ℝ) : monoEta h m z ≤ 1 :=
  ((mul_le_of_le_one_left (mloc_theta_nonneg _) (mloc_theta_le_one _)).trans (mloc_theta_le_one _))

theorem mloc_ChiM_nonneg (h : ℝ) (m : ℤ × ℤ) (z : ℝ × ℝ) : 0 ≤ monoChiM h m z :=
  mul_nonneg (mloc_beta_nonneg _) (mloc_beta_nonneg _)

theorem mloc_ChiM_le_one (h : ℝ) (m : ℤ × ℤ) (z : ℝ × ℝ) : monoChiM h m z ≤ 1 :=
  ((mul_le_of_le_one_left (mloc_beta_nonneg _) (mloc_beta_le_one _)).trans (mloc_beta_le_one _))

theorem mloc_Eta_ne_zero {h : ℝ} {m : ℤ × ℤ} {z : ℝ × ℝ} (hz : monoEta h m z ≠ 0) :
    |z.1 / h - m.1| < 3 / 4 ∧ |z.2 / h - m.2| < 3 / 4 :=
  ⟨mloc_theta_ne_zero (left_ne_zero_of_mul hz), mloc_theta_ne_zero (right_ne_zero_of_mul hz)⟩

theorem mloc_ChiM_ne_zero {h : ℝ} {m : ℤ × ℤ} {z : ℝ × ℝ} (hz : monoChiM h m z ≠ 0) :
    |z.1 / h - m.1| < 3 / 2 ∧ |z.2 / h - m.2| < 3 / 2 :=
  ⟨mloc_beta_ne_zero (left_ne_zero_of_mul hz), mloc_beta_ne_zero (right_ne_zero_of_mul hz)⟩

theorem mloc_ChiM_eq_one_of_monoEta_ne_zero {h : ℝ} {m : ℤ × ℤ} {z : ℝ × ℝ}
    (hz : monoEta h m z ≠ 0) : monoChiM h m z = 1 := by
  obtain ⟨h1, h2⟩ := mloc_Eta_ne_zero hz
  simp only [monoChiM, mloc_beta_eq_one h1.le, mloc_beta_eq_one h2.le, mul_one]

/-- The integers within distance `3/2` of `x`. -/
def mlocNb1 (x : ℝ) : Finset ℤ := Finset.Icc (⌊x - 3 / 2⌋ + 1) (⌊x - 3 / 2⌋ + 3)

theorem mlocNb1_card (x : ℝ) : (mlocNb1 x).card = 3 := by
  simp only [mlocNb1, Int.card_Icc]; omega

theorem mloc_mem_Nb1 {x : ℝ} {n : ℤ} (hn : |x - n| < 3 / 2) : n ∈ mlocNb1 x := by
  rw [abs_lt] at hn
  simp only [mlocNb1, Finset.mem_Icc]
  constructor
  · have : x - 3 / 2 < n := by linarith
    have := Int.floor_lt.mpr this
    omega
  · have h1 := Int.lt_floor_add_one (x - 3 / 2)
    have : (n : ℝ) < ⌊x - 3 / 2⌋ + 4 := by linarith
    have : n < ⌊x - 3 / 2⌋ + 4 := by exact_mod_cast this
    omega

/-- The (at most nine) indices `m` near `z / h`. -/
def mlocNb (h : ℝ) (z : ℝ × ℝ) : Finset (ℤ × ℤ) := mlocNb1 (z.1 / h) ×ˢ mlocNb1 (z.2 / h)

theorem mlocNb_card (h : ℝ) (z : ℝ × ℝ) : (mlocNb h z).card = 9 := by
  simp [mlocNb, Finset.card_product, mlocNb1_card]

theorem mloc_mem_Nb_of_ChiM {h : ℝ} {m : ℤ × ℤ} {z : ℝ × ℝ} (hz : monoChiM h m z ≠ 0) :
    m ∈ mlocNb h z := by
  obtain ⟨h1, h2⟩ := mloc_ChiM_ne_zero hz
  exact Finset.mem_product.mpr ⟨mloc_mem_Nb1 h1, mloc_mem_Nb1 h2⟩

theorem mloc_mem_Nb_of_Eta {h : ℝ} {m : ℤ × ℤ} {z : ℝ × ℝ} (hz : monoEta h m z ≠ 0) :
    m ∈ mlocNb h z :=
  mloc_mem_Nb_of_ChiM (by rw [mloc_ChiM_eq_one_of_monoEta_ne_zero hz]; exact one_ne_zero)

/-- At most nine `χ_m` are nonzero at any point. -/
theorem mloc_ChiM_card_le {h : ℝ} {z : ℝ × ℝ} (S : Finset (ℤ × ℤ))
    (hS : ∀ m ∈ S, monoChiM h m z ≠ 0) : S.card ≤ 9 := by
  rw [← mlocNb_card h z]
  exact Finset.card_le_card fun m hm => mloc_mem_Nb_of_ChiM (hS m hm)

theorem mloc_Eta_card_le {h : ℝ} {z : ℝ × ℝ} (S : Finset (ℤ × ℤ))
    (hS : ∀ m ∈ S, monoEta h m z ≠ 0) : S.card ≤ 9 := by
  rw [← mlocNb_card h z]
  exact Finset.card_le_card fun m hm => mloc_mem_Nb_of_Eta (hS m hm)

theorem mloc_theta_tsum_sub (x : ℝ) : ∑' n : ℤ, smoothingPartitionCutoff (x - n) = 1 := by
  have hreindex := (Equiv.neg ℤ).tsum_eq (fun n : ℤ => smoothingPartitionCutoff (x + n))
  simp only [Equiv.neg_apply, Int.cast_neg, ← sub_eq_add_neg] at hreindex
  rw [hreindex, smoothingPartitionCutoff_partition]

theorem mloc_theta_sum_nb (x : ℝ) : ∑ n ∈ mlocNb1 x, smoothingPartitionCutoff (x - n) = 1 := by
  rw [← mloc_theta_tsum_sub x, tsum_eq_sum]
  intro n hn
  by_contra h0
  exact hn (mloc_mem_Nb1 (by linarith [mloc_theta_ne_zero h0]))

theorem mloc_Eta_eq_zero_of_not_mem {h : ℝ} {m : ℤ × ℤ} {z : ℝ × ℝ} (hm : m ∉ mlocNb h z) :
    monoEta h m z = 0 := by
