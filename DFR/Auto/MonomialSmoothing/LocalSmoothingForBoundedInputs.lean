theorem msub_slope_lower {A B m : ℝ} {φ φ' : ℝ → ℝ}
    (hφ : ∀ x ∈ Icc A B, HasDerivAt φ (φ' x) x) (hm : ∀ x ∈ Icc A B, m ≤ φ' x)
    {x y : ℝ} (hx : x ∈ Icc A B) (hy : y ∈ Icc A B) (hxy : x ≤ y) :
    m * (y - x) ≤ φ y - φ x := by
  rcases hxy.lt_or_eq with hxy | hxy
  · have hsub : Icc x y ⊆ Icc A B := Icc_subset_Icc hx.1 hy.2
    obtain ⟨ξ, hξ, hξeq⟩ := exists_hasDerivAt_eq_slope φ φ' hxy
      (fun z hz => (hφ z (hsub hz)).continuousAt.continuousWithinAt)
      (fun z hz => hφ z (hsub (Ioo_subset_Icc_self hz)))
    have := hm ξ (hsub (Ioo_subset_Icc_self hξ))
    rw [hξeq, le_div_iff₀ (sub_pos.mpr hxy)] at this
    exact this
  · subst hxy; simp

/-- The alternating expression `det[(1,1,1),(a,b,c),(F a,F b,F c)]`. -/
def msubV (F : ℝ → ℝ) (a b c : ℝ) : ℝ := (b - a) * (F c - F a) - (c - a) * (F b - F a)

def msubP (a b c : ℝ) : ℝ := (b - a) * (c - a) * (c - b)

theorem msub_V_sorted {F : ℝ → ℝ} {A B κ : ℝ}
    (hconv : ConvexOn ℝ (Icc A B) (fun t => F t - κ / 2 * (t * t)))
    {a b c : ℝ} (ha : a ∈ Icc A B) (hc : c ∈ Icc A B) (hab : a ≤ b) (hbc : b ≤ c) :
    κ / 2 * msubP a b c ≤ msubV F a b c := by
  rcases (hab.trans hbc).lt_or_eq with hac | hac
  · have hca : 0 < c - a := sub_pos.mpr hac
    have hw1 : 0 ≤ (c - b) / (c - a) := div_nonneg (by linarith) hca.le
    have hw2 : 0 ≤ (b - a) / (c - a) := div_nonneg (by linarith) hca.le
    have hsum : (c - b) / (c - a) + (b - a) / (c - a) = 1 := by
      rw [← add_div, div_eq_one_iff_eq hca.ne']; ring
    have h := hconv.2 ha hc hw1 hw2 hsum
    simp only [smul_eq_mul] at h
    have hpt : (c - b) / (c - a) * a + (b - a) / (c - a) * c = b := by
      field_simp; ring
    rw [hpt] at h
    have h2 : (c - a) * (F b - κ / 2 * (b * b)) ≤
        (c - b) * (F a - κ / 2 * (a * a)) + (b - a) * (F c - κ / 2 * (c * c)) := by
      have := mul_le_mul_of_nonneg_left h hca.le
      calc (c - a) * (F b - κ / 2 * (b * b)) ≤ (c - a) * ((c - b) / (c - a) *
            (F a - κ / 2 * (a * a)) + (b - a) / (c - a) * (F c - κ / 2 * (c * c))) := this
        _ = _ := by field_simp
    unfold msubP msubV; nlinarith [h2]
  · subst hac
    have hb : b = a := le_antisymm hbc hab
    subst hb; simp [msubP, msubV]

theorem msub_V_lower {F : ℝ → ℝ} {A B κ : ℝ}
    (hconv : ConvexOn ℝ (Icc A B) (fun t => F t - κ / 2 * (t * t)))
    {a b c : ℝ} (ha : a ∈ Icc A B) (hb : b ∈ Icc A B) (hc : c ∈ Icc A B) :
    κ / 2 * |msubP a b c| ≤ |msubV F a b c| := by
  have key : ∀ x y z, x ∈ Icc A B → z ∈ Icc A B → x ≤ y → y ≤ z →
      κ / 2 * |msubP x y z| ≤ |msubV F x y z| := by
    intro x y z hx hz hxy hyz
    have h1 := msub_V_sorted hconv hx hz hxy hyz
    have h0 : 0 ≤ msubP x y z := by
      unfold msubP; apply mul_nonneg (mul_nonneg _ _) <;> linarith
    rw [abs_of_nonneg h0]; exact h1.trans (le_abs_self _)
  have hsym : ∀ x y z, x ∈ Icc A B → z ∈ Icc A B → x ≤ y → y ≤ z →
      (|msubP a b c| = |msubP x y z|) → (|msubV F a b c| = |msubV F x y z|) →
      κ / 2 * |msubP a b c| ≤ |msubV F a b c| := by
    intro x y z hx hz hxy hyz e1 e2
    rw [e1, e2]; exact key x y z hx hz hxy hyz
  rcases le_total a b with hab | hab <;> rcases le_total b c with hbc | hbc <;>
    rcases le_total a c with hac | hac <;>
  first
  | exact hsym a b c ha hc hab hbc rfl rfl
  | exact hsym a c b ha hb hac hbc
      (abs_eq_abs.mpr (by unfold msubP; right; ring))
      (abs_eq_abs.mpr (by unfold msubV; right; ring))
  | exact hsym c a b hc hb hac hab
      (abs_eq_abs.mpr (by unfold msubP; left; ring))
      (abs_eq_abs.mpr (by unfold msubV; left; ring))
  | exact hsym b a c hb hc hab hac
      (abs_eq_abs.mpr (by unfold msubP; right; ring))
      (abs_eq_abs.mpr (by unfold msubV; right; ring))
  | exact hsym b c a hb ha hbc hac
      (abs_eq_abs.mpr (by unfold msubP; left; ring))
      (abs_eq_abs.mpr (by unfold msubV; left; ring))
  | exact hsym c b a hc ha hbc hab
      (abs_eq_abs.mpr (by unfold msubP; right; ring))
      (abs_eq_abs.mpr (by unfold msubV; right; ring))

end
end Auto

