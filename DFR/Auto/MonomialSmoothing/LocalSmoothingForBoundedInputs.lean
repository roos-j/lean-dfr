open MeasureTheory Set Filter Topology
open scoped ENNReal NNReal

namespace Auto
noncomputable section

theorem msub_comp_le {t t' : ℝ × ℝ × ℝ} :
    |t.1 - t'.1| ≤ ‖t - t'‖ ∧ |t.2.1 - t'.2.1| ≤ ‖t - t'‖ ∧ |t.2.2 - t'.2.2| ≤ ‖t - t'‖ := by
  rw [msub_norm3]
  simp only [Prod.fst_sub, Prod.snd_sub]
  exact ⟨le_max_left _ _, (le_max_left _ _).trans (le_max_right _ _),
    (le_max_right _ _).trans (le_max_right _ _)⟩

/-- (AL2): the second-order error of `msubH` on small cubes. -/
theorem msub_H_err {r A B : ℝ} (hA : 0 < A) :
    ∃ L, 0 ≤ L ∧ ∀ c ∈ msubI3 A B, ∀ t ∈ msubI3 A B, ∀ t' ∈ msubI3 A B, ∀ h : ℝ,
      ‖t - c‖ ≤ h → ‖t' - c‖ ≤ h →
        ‖msubH r t - msubH r t' - msubM r c (t - t')‖ ≤ L * h * ‖t - t'‖ := by
  obtain ⟨Lq, hLq, hLq'⟩ := msub_q_lip (r := r) (B := B) hA
  set L0 := max (A ^ 2)⁻¹ Lq
  have hL0 : 0 ≤ L0 := le_max_of_le_right hLq
  refine ⟨3 * L0, by positivity, ?_⟩
  rintro c ⟨c0, c1, c2⟩ t ⟨t0, t1, t2⟩ t' ⟨s0, s1, s2⟩ h htc hsc
  obtain ⟨a0, a1, a2⟩ := msub_comp_le (t := t) (t' := c)
  obtain ⟨b0, b1, b2⟩ := msub_comp_le (t := t') (t' := c)
  obtain ⟨d0, d1, d2⟩ := msub_comp_le (t := t) (t' := t')
  have hlog : ∀ x ∈ Icc A B, HasDerivAt Real.log x⁻¹ x := fun x hx =>
    Real.hasDerivAt_log (ne_of_gt (lt_of_lt_of_le hA hx.1))
  have hlogL : ∀ x ∈ Icc A B, ∀ y ∈ Icc A B, |x⁻¹ - y⁻¹| ≤ L0 * |x - y| := fun x hx y hy =>
    (msub_inv_lip hA hx.1 hy.1).trans (mul_le_mul_of_nonneg_right (le_max_left _ _)
      (abs_nonneg _))
  have hQL : ∀ x ∈ Icc A B, ∀ y ∈ Icc A B, |monoq r x - monoq r y| ≤ L0 * |x - y| :=
    fun x hx y hy => (hLq' x hx y hy).trans (mul_le_mul_of_nonneg_right (le_max_right _ _)
      (abs_nonneg _))
  have hQd : ∀ x ∈ Icc A B, HasDerivAt (monoQ r) (monoq r x) x := fun x hx =>
    hasDerivAt_monoQ r (lt_of_lt_of_le hA hx.1)
  have hh : 0 ≤ h := (norm_nonneg _).trans htc
  have hn : 0 ≤ L0 * h := mul_nonneg hL0 hh
  have e1 := msub_approx_lin hlog hlogL hL0 t0 s0 c0 (a0.trans htc) (b0.trans hsc)
  have e2 := msub_approx_lin hlog hlogL hL0 t1 s1 c1 (a1.trans htc) (b1.trans hsc)
  have e3 := msub_approx_lin hlog hlogL hL0 t2 s2 c2 (a2.trans htc) (b2.trans hsc)
  have f1 := msub_approx_lin hQd hQL hL0 t0 s0 c0 (a0.trans htc) (b0.trans hsc)
  have f2 := msub_approx_lin hQd hQL hL0 t1 s1 c1 (a1.trans htc) (b1.trans hsc)
  have f3 := msub_approx_lin hQd hQL hL0 t2 s2 c2 (a2.trans htc) (b2.trans hsc)
  have g0 := mul_le_mul_of_nonneg_left d0 hn
  have g1 := mul_le_mul_of_nonneg_left d1 hn
  have g2 := mul_le_mul_of_nonneg_left d2 hn
  rw [msub_norm3]
  simp only [msubH, msubM, msubLam, msubTh, Prod.fst_sub, Prod.snd_sub]
  obtain ⟨l1, u1⟩ := abs_le.mp e1
  obtain ⟨l2, u2⟩ := abs_le.mp e2
  obtain ⟨l3, u3⟩ := abs_le.mp e3
  obtain ⟨l4, u4⟩ := abs_le.mp f1
  obtain ⟨l5, u5⟩ := abs_le.mp f2
  obtain ⟨l6, u6⟩ := abs_le.mp f3
  have hz : 0 ≤ 3 * L0 * h * ‖t - t'‖ := by positivity
  refine max_le (abs_le.mpr ⟨by linarith, by linarith⟩)
    (max_le (by rw [abs_le]; constructor <;> ring_nf <;> linarith)
      (abs_le.mpr ⟨by linarith, by linarith⟩))

/-- Local antilipschitz estimate for `msubH` near a point with nonzero Jacobian. -/
theorem msub_antilip {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A ≤ B) :
    ∃ K L, 0 < K ∧ 0 ≤ L ∧ ∀ c ∈ msubI3 A B, ∀ t ∈ msubI3 A B, ∀ t' ∈ msubI3 A B, ∀ h : ℝ,
      ‖t - c‖ ≤ h → ‖t' - c‖ ≤ h →
        (|msubDet r c| / K - L * h) * ‖t - t'‖ ≤ ‖msubH r t - msubH r t'‖ := by
  obtain ⟨K, hK, hK'⟩ := msub_M_lower hr hA hAB
  obtain ⟨L, hL, hL'⟩ := msub_H_err (r := r) (B := B) hA
  refine ⟨K, L, hK, hL, ?_⟩
  intro c hc t ht t' ht' h htc hsc
  have h1 := hK' c hc (t - t')
  have h2 := hL' c hc t ht t' ht' h htc hsc
  have h3 : ‖msubM r c (t - t')‖ ≤ ‖msubH r t - msubH r t'‖ +
      ‖msubH r t - msubH r t' - msubM r c (t - t')‖ := by
    have := norm_sub_le (msubH r t - msubH r t') (msubH r t - msubH r t' - msubM r c (t - t'))
    rwa [sub_sub_cancel] at this
  have h4 : |msubDet r c| / K * ‖t - t'‖ ≤ ‖msubM r c (t - t')‖ := by
    rw [div_mul_eq_mul_div, div_le_iff₀ hK]; linarith
  nlinarith

/-- Lipschitz bound for `(θ₁, θ₂)` on `I³`. -/
theorem msub_Th_lip {r A B : ℝ} (hA : 0 < A) :
    ∃ L, 0 ≤ L ∧ ∀ t ∈ msubI3 A B, ∀ c ∈ msubI3 A B, ‖msubTh r t - msubTh r c‖ ≤ L * ‖t - c‖ := by
  obtain ⟨LQ, hLQ, hLQ'⟩ := msub_Q_lip (r := r) (B := B) hA
  refine ⟨3 * max 1 LQ, by positivity, ?_⟩
  rintro t ⟨t0, t1, t2⟩ c ⟨c0, c1, c2⟩
  obtain ⟨d0, d1, d2⟩ := msub_comp_le (t := t) (t' := c)
  have hm : 0 ≤ max 1 LQ := le_max_of_le_right hLQ
  have q0 := (hLQ' _ t0 _ c0).trans (mul_le_mul (le_max_right 1 LQ) d0 (abs_nonneg _) hm)
  have q1 := (hLQ' _ t1 _ c1).trans (mul_le_mul (le_max_right 1 LQ) d1 (abs_nonneg _) hm)
  have q2 := (hLQ' _ t2 _ c2).trans (mul_le_mul (le_max_right 1 LQ) d2 (abs_nonneg _) hm)
  have p0 := mul_le_mul (le_max_left 1 LQ) d0 (abs_nonneg _) hm
  have p1 := mul_le_mul (le_max_left 1 LQ) d1 (abs_nonneg _) hm
  have p2 := mul_le_mul (le_max_left 1 LQ) d2 (abs_nonneg _) hm
  rw [msub_norm2]
  simp only [msubTh, Prod.fst_sub, Prod.snd_sub]
  obtain ⟨l0, u0⟩ := abs_le.mp q0
  obtain ⟨l1, u1⟩ := abs_le.mp q1
  obtain ⟨l2, u2⟩ := abs_le.mp q2
  obtain ⟨m0, v0⟩ := abs_le.mp (by simpa using p0)
  obtain ⟨m1, v1⟩ := abs_le.mp (by simpa using p1)
  obtain ⟨m2, v2⟩ := abs_le.mp (by simpa using p2)
  have hn : 0 ≤ ‖t - c‖ := norm_nonneg _
  refine max_le (abs_le.mpr ⟨by nlinarith, by nlinarith⟩) (abs_le.mpr ⟨by nlinarith, by nlinarith⟩)

end
end Auto

