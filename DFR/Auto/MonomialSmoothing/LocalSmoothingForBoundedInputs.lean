/-- `TT*`: `‖A_γ G‖₂² ≤ ∫ G(w) ∫ G(w+v) k(v)`, given the difference bound for `γ`. -/
theorem mimp_TTstar {S : Set ℝ} {γ : ℝ → ℝ × ℝ} (hγ : Measurable γ) {k : ℝ × ℝ → ℝ≥0∞}
    (hD : ∀ H : ℝ × ℝ → ℝ≥0∞, Measurable H →
      ∫⁻ s in S, ∫⁻ t in S, H (γ t - γ s) ≤ ∫⁻ v, H v * k v)
    {G : ℝ × ℝ → ℝ≥0∞} (hG : Measurable G) :
    ∫⁻ z, (∫⁻ t in S, G (z + γ t)) ^ (2 : ℝ) ≤ ∫⁻ w, G w * ∫⁻ v, G (w + v) * k v := by
  have e1 : ∀ z, (∫⁻ t in S, G (z + γ t)) ^ (2 : ℝ) =
      ∫⁻ s in S, ∫⁻ t in S, G (z + γ s) * G (z + γ t) := by
    intro z
    have hX : Measurable fun t => G (z + γ t) := hG.comp (measurable_const.add hγ)
    rw [ENNReal.rpow_two, pow_two, ← lintegral_mul_const _ hX]
    congr 1; ext s
    rw [← lintegral_const_mul _ hX]
  simp_rw [e1]
  have hF : Measurable fun p : ((ℝ × ℝ) × ℝ) × ℝ => G (p.1.1 + γ p.1.2) * G (p.1.1 + γ p.2) := by
    fun_prop
  rw [lintegral_lintegral_swap ((hF.lintegral_prod_right').aemeasurable)]
  have e2 : ∀ s, ∫⁻ z, ∫⁻ t in S, G (z + γ s) * G (z + γ t) =
      ∫⁻ t in S, ∫⁻ w, G w * G (w + (γ t - γ s)) := by
    intro s
    rw [lintegral_lintegral_swap (by
      apply Measurable.aemeasurable
      fun_prop)]
    congr 1; ext t
    rw [← lintegral_add_right_eq_self (fun w => G w * G (w + (γ t - γ s))) (γ s)]
    congr 1; ext z
    congr 2
    abel
  simp_rw [e2]
  have e3 : ∀ s, ∫⁻ t in S, ∫⁻ w, G w * G (w + (γ t - γ s)) =
      ∫⁻ w, G w * ∫⁻ t in S, G (w + (γ t - γ s)) := by
    intro s
    rw [lintegral_lintegral_swap (by
      apply Measurable.aemeasurable
      fun_prop)]
    congr 1; ext w
    rw [lintegral_const_mul _ (by fun_prop)]
  simp_rw [e3]
  rw [lintegral_lintegral_swap (by
    apply Measurable.aemeasurable
    have : Measurable fun p : ℝ × (ℝ × ℝ) => G p.2 * ∫⁻ t in S, G (p.2 + (γ t - γ p.1)) := by
      refine (hG.comp measurable_snd).mul ?_
      have hh : Measurable fun q : (ℝ × (ℝ × ℝ)) × ℝ => G (q.1.2 + (γ q.2 - γ q.1.1)) := by
        fun_prop
      exact hh.lintegral_prod_right'
    exact this)]
  refine lintegral_mono fun w => ?_
  have e4 : ∫⁻ s in S, G w * ∫⁻ t in S, G (w + (γ t - γ s)) =
      G w * ∫⁻ s in S, ∫⁻ t in S, G (w + (γ t - γ s)) := by
    rw [lintegral_const_mul]
    have hh : Measurable fun q : ℝ × ℝ => G (w + (γ q.2 - γ q.1)) := by fun_prop
    exact hh.lintegral_prod_right'
  rw [e4]
  exact mul_le_mul_right (hD (fun v => G (w + v)) (by fun_prop)) _

end

end Auto

