theorem mimp_final_algebra (X Y κ : ℝ≥0∞) :
    (Y ^ (1 / 2 : ℝ) * (X ^ (4 / 3 : ℝ) * κ ^ (2 / 3 : ℝ)) ^ (1 / 2 : ℝ)) ^ (1 / 2 : ℝ) *
      (X ^ (1 / 2 : ℝ) * (Y ^ (4 / 3 : ℝ) * κ ^ (2 / 3 : ℝ)) ^ (1 / 2 : ℝ)) ^ (1 / 2 : ℝ) =
    κ ^ (1 / 3 : ℝ) * X ^ (7 / 12 : ℝ) * Y ^ (7 / 12 : ℝ) := by
  simp only [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 1 / 2), ←
    ENNReal.rpow_mul]
  rw [show (7 / 12 : ℝ) = 1 / 2 * (1 / 2) + 4 / 3 * (1 / 2) * (1 / 2) by norm_num,
    show (1 / 3 : ℝ) = 2 / 3 * (1 / 2) * (1 / 2) + 2 / 3 * (1 / 2) * (1 / 2) by norm_num,
    ENNReal.rpow_add_of_nonneg _ _ (by norm_num) (by norm_num),
    ENNReal.rpow_add_of_nonneg _ _ (by norm_num) (by norm_num),
    ENNReal.rpow_add_of_nonneg _ _ (by norm_num) (by norm_num)]
  ring

/-- `B(F,G) ≤ C ‖F‖_{12/7} ‖G‖_{12/7}` (generic curve form). -/
theorem mimp_B_generic {S : Set ℝ} {γ : ℝ → ℝ × ℝ} (hγ : Measurable γ) {k : ℝ × ℝ → ℝ≥0∞}
    (hk : Measurable k)
    (hD : ∀ H : ℝ × ℝ → ℝ≥0∞, Measurable H →
      ∫⁻ s in S, ∫⁻ t in S, H (γ t - γ s) ≤ ∫⁻ v, H v * k v)
    {F G : ℝ × ℝ → ℝ≥0∞} (hF : Measurable F) (hG : Measurable G) :
    ∫⁻ z, F z * ∫⁻ t in S, G (z + γ t) ≤
      (∫⁻ v, k v ^ (3 / 2 : ℝ)) ^ (1 / 3 : ℝ) * (∫⁻ z, F z ^ (12 / 7 : ℝ)) ^ (7 / 12 : ℝ) *
        (∫⁻ z, G z ^ (12 / 7 : ℝ)) ^ (7 / 12 : ℝ) := by
  set X := ∫⁻ z, F z ^ (12 / 7 : ℝ)
  set Y := ∫⁻ z, G z ^ (12 / 7 : ℝ)
  set κ := ∫⁻ v, k v ^ (3 / 2 : ℝ)
  have hpow : ∀ (H : ℝ × ℝ → ℝ≥0∞) (a b : ℝ), a * b = 12 / 7 →
      ∫⁻ z, (H z ^ a) ^ b = ∫⁻ z, H z ^ (12 / 7 : ℝ) := by
    intro H a b hab
    simp_rw [← ENNReal.rpow_mul, hab]
  have T1 : ∫⁻ z, F z ^ (8 / 7 : ℝ) * ∫⁻ t in S, G (z + γ t) ^ (6 / 7 : ℝ) ≤
      Y ^ (1 / 2 : ℝ) * (X ^ (4 / 3 : ℝ) * κ ^ (2 / 3 : ℝ)) ^ (1 / 2 : ℝ) := by
    have := mimp_adjoint (S := S) hγ (hF.pow_const (8 / 7 : ℝ)) (hG.pow_const (6 / 7 : ℝ))
    rw [this]
    have h2 := mimp_E (S := S) (γ := fun t => -γ t) (by fun_prop) hk (mimp_D_neg hγ hD)
      (hG.pow_const (6 / 7 : ℝ)) (hF.pow_const (8 / 7 : ℝ))
    rw [hpow G (6 / 7) 2 (by norm_num), hpow F (8 / 7) (3 / 2) (by norm_num)] at h2
    exact h2
  have T2 : ∫⁻ z, F z ^ (6 / 7 : ℝ) * ∫⁻ t in S, G (z + γ t) ^ (8 / 7 : ℝ) ≤
      X ^ (1 / 2 : ℝ) * (Y ^ (4 / 3 : ℝ) * κ ^ (2 / 3 : ℝ)) ^ (1 / 2 : ℝ) := by
    have h2 := mimp_E (S := S) hγ hk hD (hF.pow_const (6 / 7 : ℝ)) (hG.pow_const (8 / 7 : ℝ))
    rw [hpow F (6 / 7) 2 (by norm_num), hpow G (8 / 7) (3 / 2) (by norm_num)] at h2
    exact h2
  refine (mimp_split hγ hF hG).trans ?_
  rw [← mimp_final_algebra X Y κ]
  gcongr

end

