open MeasureTheory Set Filter Topology
open scoped ENNReal NNReal

namespace Auto
noncomputable section

/-- The Fubini identity behind (3.12)-(3.13), in abstract form. -/
theorem msub_fub_core {Γ : ℝ → ℝ × ℝ} (hΓ : Measurable Γ) {iE : (ℝ × ℝ) × ℝ → ℝ≥0∞}
    (hiE : Measurable iE) {dA : ℝ × ℝ → ℝ≥0∞} (hdA : Measurable dA) :
    ∫⁻ p, iE p * ∫⁻ s, iE (p.1 + Γ p.2 - Γ s, s) * dA (p.1 + Γ p.2 - Γ s) =
      ∫⁻ p, iE p * (dA p.1 * ∫⁻ t, iE (p.1 + Γ p.2 - Γ t, t)) := by
  set G : ℝ × ℝ → ℝ → ℝ → ℝ≥0∞ := fun z t s =>
    iE (z, t) * (iE (z + Γ t - Γ s, s) * dA (z + Γ t - Γ s)) with hG
  have hGm : Measurable fun q : ((ℝ × ℝ) × ℝ) × ℝ => G q.1.1 q.1.2 q.2 := by
    simp only [hG]; fun_prop
  set H : ℝ → ℝ → ℝ × ℝ → ℝ≥0∞ := fun t s z =>
    iE (z + (Γ s - Γ t), t) * (iE (z, s) * dA z) with hH
  have hHm : Measurable fun q : (ℝ × ℝ) × (ℝ × ℝ) => H q.1.1 q.1.2 q.2 := by
    simp only [hH]; fun_prop
  have hdB : Measurable fun w : ℝ × ℝ => ∫⁻ t, iE (w - Γ t, t) := by
    exact Measurable.lintegral_prod_right' (f := fun q : (ℝ × ℝ) × ℝ => iE (q.1 - Γ q.2, q.2))
      (by fun_prop)
  -- LHS as an iterated integral
  have e1 : ∫⁻ p, iE p * ∫⁻ s, iE (p.1 + Γ p.2 - Γ s, s) * dA (p.1 + Γ p.2 - Γ s) =
      ∫⁻ z, ∫⁻ t, ∫⁻ s, G z t s := by
    rw [Measure.volume_eq_prod, lintegral_prod]
    · refine lintegral_congr fun z => lintegral_congr fun t => ?_
      rw [← lintegral_const_mul]
      · fun_prop
    · refine Measurable.aemeasurable ?_
      refine Measurable.mul hiE ?_
      exact Measurable.lintegral_prod_right' (f := fun q : ((ℝ × ℝ) × ℝ) × ℝ =>
        iE (q.1.1 + Γ q.1.2 - Γ q.2, q.2) * dA (q.1.1 + Γ q.1.2 - Γ q.2)) (by fun_prop)
  have e2 : ∫⁻ z, ∫⁻ t, ∫⁻ s, G z t s = ∫⁻ t, ∫⁻ s, ∫⁻ z, G z t s := by
    rw [lintegral_lintegral_swap]
    · refine lintegral_congr fun t => ?_
      rw [lintegral_lintegral_swap]
      exact (hGm.comp
        (by fun_prop : Measurable fun q : (ℝ × ℝ) × ℝ => ((q.1, t), q.2))).aemeasurable
    · exact (Measurable.lintegral_prod_right' hGm).aemeasurable
  have e3 : ∀ t s, ∫⁻ z, G z t s = ∫⁻ z, H t s z := by
    intro t s
    rw [← lintegral_add_right_eq_self (fun z => G z t s) (Γ s - Γ t)]
    refine lintegral_congr fun z => ?_
    simp only [hG, hH]
    rw [show z + (Γ s - Γ t) + Γ t - Γ s = z by abel]
  have e4 : ∫⁻ t, ∫⁻ s, ∫⁻ z, H t s z = ∫⁻ s, ∫⁻ z, ∫⁻ t, H t s z := by
    rw [lintegral_lintegral_swap]
    · refine lintegral_congr fun s => ?_
      rw [lintegral_lintegral_swap]
      exact (hHm.comp
        (by fun_prop : Measurable fun q : ℝ × (ℝ × ℝ) => ((q.1, s), q.2))).aemeasurable
    · exact (Measurable.lintegral_prod_right' hHm).aemeasurable
  have e5 : ∀ s z, ∫⁻ t, H t s z = iE (z, s) * (dA z * ∫⁻ t, iE (z + Γ s - Γ t, t)) := by
    intro s z
    simp only [hH]
    rw [lintegral_mul_const, mul_comm, mul_assoc]
    · simp only [add_sub_assoc]
    · fun_prop
  have e6 : ∫⁻ s, ∫⁻ z, iE (z, s) * (dA z * ∫⁻ t, iE (z + Γ s - Γ t, t)) =
      ∫⁻ p, iE p * (dA p.1 * ∫⁻ t, iE (p.1 + Γ p.2 - Γ t, t)) := by
    have hm : Measurable fun p : (ℝ × ℝ) × ℝ => iE p * (dA p.1 * ∫⁻ t, iE (p.1 + Γ p.2 - Γ t, t))
      := by
      refine hiE.mul (hdA.comp measurable_fst |>.mul ?_)
      exact hdB.comp (measurable_fst.add (hΓ.comp measurable_snd))
    rw [show (volume : Measure ((ℝ × ℝ) × ℝ)) = volume.prod volume from rfl,
      lintegral_prod _ hm.aemeasurable, lintegral_lintegral_swap]
    exact (hm.comp measurable_swap).aemeasurable
  rw [e1, e2]
  simp_rw [e3]
  rw [e4]
  simp_rw [e5]
  exact e6

end
end Auto

end

