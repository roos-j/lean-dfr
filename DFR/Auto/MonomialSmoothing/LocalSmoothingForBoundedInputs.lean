theorem msub_vol_I3 (A B : ℝ) :
    volume (msubI3 A B) = ENNReal.ofReal (B - A) * (ENNReal.ofReal (B - A) *
      ENNReal.ofReal (B - A)) := by
  rw [show msubI3 A B = Icc A B ×ˢ (Icc A B ×ˢ Icc A B) from rfl, Measure.volume_eq_prod,
    Measure.prod_prod, Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Icc]

theorem msub_vol_I3_le {A B : ℝ} (hAB : A ≤ B) (s : Set (ℝ × ℝ × ℝ)) (hs : s ⊆ msubI3 A B) :
    volume s ≤ ENNReal.ofReal ((B - A) ^ 3) := by
  refine (measure_mono hs).trans (le_of_eq ?_)
  rw [msub_vol_I3, ← ENNReal.ofReal_mul (by linarith), ← ENNReal.ofReal_mul (by linarith)]
  ring_nf

/-- Coordinate sublevel estimate (3.9), logarithmic form. -/
theorem msub_core_delta {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) :
    ∃ C, 0 ≤ C ∧ ∀ g : ℝ × ℝ → ℝ, Measurable g → ∀ δ : ℝ, 0 < δ →
      volume {t | t ∈ msubI3 A B ∧ |msubLam t - g (msubTh r t)| ≤ δ} ≤
        ENNReal.ofReal (C * δ ^ (1 / 13 : ℝ)) := by
  obtain ⟨C, hC, hC'⟩ := msub_core_eta hr hA hAB
  refine ⟨max C ((B - A) ^ 3), le_max_of_le_left hC, fun g hg δ hδ => ?_⟩
  have hη : 0 < δ ^ (1 / 13 : ℝ) := Real.rpow_pos_of_pos hδ _
  by_cases hδ1 : δ ≤ 1
  · have hη1 : δ ^ (1 / 13 : ℝ) ≤ 1 := Real.rpow_le_one hδ.le hδ1 (by norm_num)
    have e : (δ ^ (1 / 13 : ℝ)) ^ 13 = δ := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hδ.le]; norm_num
    have := hC' g hg _ hη hη1
    rw [e] at this
    exact this.trans (ENNReal.ofReal_le_ofReal
      (mul_le_mul_of_nonneg_right (le_max_left _ _) hη.le))
  · push Not at hδ1
    refine (msub_vol_I3_le hAB.le _ fun t ht => ht.1).trans (ENNReal.ofReal_le_ofReal ?_)
    have : 1 ≤ δ ^ (1 / 13 : ℝ) := Real.one_le_rpow hδ1.le (by norm_num)
    have h3 : 0 ≤ (B - A) ^ 3 := by have := sub_pos.mpr hAB; positivity
    calc (B - A) ^ 3 ≤ max C ((B - A) ^ 3) := le_max_right _ _
      _ = max C ((B - A) ^ 3) * 1 := (mul_one _).symm
      _ ≤ _ := mul_le_mul_of_nonneg_left this (le_max_of_le_right h3)

theorem msub_log_close {ψ y νm e : ℝ} (hνm : 0 < νm) (hψ : νm ≤ ψ) (hy : |ψ - y| ≤ e)
    (he : e ≤ νm / 2) : 0 < y ∧ |Real.log ψ - Real.log y| ≤ 2 * e / νm := by
  have hψ0 : 0 < ψ := lt_of_lt_of_le hνm hψ
  obtain ⟨h1, h2⟩ := abs_le.mp hy
  have hy0 : νm / 2 ≤ y := by linarith
  have hy0' : 0 < y := by linarith
  refine ⟨hy0', abs_le.mpr ⟨?_, ?_⟩⟩
  · -- log y - log ψ ≤ (y - ψ)/ψ
    have := Real.log_le_sub_one_of_pos (div_pos hy0' hψ0)
    rw [Real.log_div hy0'.ne' hψ0.ne'] at this
    have h3 : y / ψ - 1 ≤ 2 * e / νm := by
      rw [div_sub_one hψ0.ne', div_le_div_iff₀ hψ0 hνm]
      nlinarith
    linarith
  · have := Real.log_le_sub_one_of_pos (div_pos hψ0 hy0')
    rw [Real.log_div hψ0.ne' hy0'.ne'] at this
    have h3 : ψ / y - 1 ≤ 2 * e / νm := by
      rw [div_sub_one hy0'.ne', div_le_div_iff₀ hy0' hνm]
      have : 0 ≤ e := (abs_nonneg _).trans hy
      nlinarith
    linarith

/-- Coordinate sublevel estimate (3.9) for a scalar coordinate `ψ` with `log ψ` affine in `λ`. -/
theorem msub_nu_form {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) {c0 : ℝ}
    (hc0 : 0 < c0) {ψ : ℝ × ℝ × ℝ → ℝ} {νm p' k : ℝ} (hνm : 0 < νm) (hp' : p' ≠ 0)
    (hψ : ∀ t ∈ msubI3 A B, νm ≤ ψ t ∧ Real.log (ψ t) = p' * msubLam t + k) :
    ∃ C, 0 ≤ C ∧ ∀ a0 : ℝ, c0 ≤ |a0| → ∀ b : ℝ × ℝ → ℝ, Measurable b → ∀ ε : ℝ, 0 < ε →
      volume {t | t ∈ msubI3 A B ∧ |a0 * ψ t - b (msubTh r t)| ≤ ε} ≤
        ENNReal.ofReal (C * ε ^ (1 / 13 : ℝ)) := by
  obtain ⟨C, hC, hC'⟩ := msub_core_delta hr hA hAB
  set Kc := 2 / (c0 * νm * |p'|) with hKc
  have hp0 : 0 < |p'| := abs_pos.mpr hp'
  have hKc0 : 0 < Kc := by positivity
  set ε0 := c0 * νm / 2 with hε0
  have hε00 : 0 < ε0 := by positivity
  set C1 := max (C * Kc ^ (1 / 13 : ℝ)) ((B - A) ^ 3 / ε0 ^ (1 / 13 : ℝ))
  have hBA : 0 < B - A := sub_pos.mpr hAB
  refine ⟨C1, le_max_of_le_left (by positivity), fun a0 ha0 b hb ε hε => ?_⟩
  have ha0' : 0 < |a0| := lt_of_lt_of_le hc0 ha0
  have hε13 : 0 < ε ^ (1 / 13 : ℝ) := Real.rpow_pos_of_pos hε _
  by_cases hsmall : ε ≤ ε0
  · set g : ℝ × ℝ → ℝ := fun u => (Real.log (b u / a0) - k) / p'
    have hg : Measurable g := by
      simp only [g]
      exact ((Real.measurable_log.comp (hb.div_const a0)).sub_const k).div_const p'
    have hsub : {t | t ∈ msubI3 A B ∧ |a0 * ψ t - b (msubTh r t)| ≤ ε} ⊆
        {t | t ∈ msubI3 A B ∧ |msubLam t - g (msubTh r t)| ≤ Kc * ε} := by
      rintro t ⟨ht, hle⟩
      refine ⟨ht, ?_⟩
      obtain ⟨hψm, hlog⟩ := hψ t ht
      have hclose : |ψ t - b (msubTh r t) / a0| ≤ ε / c0 := by
        have e1 : ψ t - b (msubTh r t) / a0 = (a0 * ψ t - b (msubTh r t)) / a0 := by
          rw [sub_div, mul_div_cancel_left₀ _ (abs_pos.mp ha0')]
        rw [e1, abs_div, div_le_div_iff₀ ha0' hc0]
        calc |a0 * ψ t - b (msubTh r t)| * c0 ≤ ε * c0 := mul_le_mul_of_nonneg_right hle hc0.le
          _ ≤ ε * |a0| := mul_le_mul_of_nonneg_left ha0 hε.le
      have hsm : ε / c0 ≤ νm / 2 := by
        rw [div_le_iff₀ hc0]; simp only [hε0] at hsmall; linarith
      obtain ⟨-, hlc⟩ := msub_log_close hνm hψm hclose hsm
      have e2 : msubLam t - g (msubTh r t) =
          (Real.log (ψ t) - Real.log (b (msubTh r t) / a0)) / p' := by
        simp only [g]; rw [hlog]; field_simp; ring
      rw [e2, abs_div, div_le_iff₀ hp0]
      calc |Real.log (ψ t) - Real.log (b (msubTh r t) / a0)| ≤ 2 * (ε / c0) / νm := hlc
        _ = Kc * ε * |p'| := by simp only [hKc]; field_simp
    refine (measure_mono hsub).trans ((hC' g hg _ (by positivity)).trans
      (ENNReal.ofReal_le_ofReal ?_))
    rw [Real.mul_rpow hKc0.le hε.le, ← mul_assoc]
    exact mul_le_mul_of_nonneg_right (le_max_left _ _) hε13.le
  · push Not at hsmall
    refine (msub_vol_I3_le hAB.le _ fun t ht => ht.1).trans (ENNReal.ofReal_le_ofReal ?_)
    have h1 : ε0 ^ (1 / 13 : ℝ) ≤ ε ^ (1 / 13 : ℝ) :=
      Real.rpow_le_rpow hε00.le hsmall.le (by norm_num)
    have h2 : 0 < ε0 ^ (1 / 13 : ℝ) := Real.rpow_pos_of_pos hε00 _
    calc (B - A) ^ 3 = (B - A) ^ 3 / ε0 ^ (1 / 13 : ℝ) * ε0 ^ (1 / 13 : ℝ) := by field_simp
      _ ≤ C1 * ε ^ (1 / 13 : ℝ) := mul_le_mul (le_max_right _ _) h1 h2.le
          (le_max_of_le_left (by positivity))

end
end Auto

