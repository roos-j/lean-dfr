/-! ### Proposition 6.1: the assembly for one input configuration -/
theorem norm_monoFTilde_le (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) {L h : ℝ} (M : Finset (ℤ × ℤ))
    {f : ℝ × ℝ → ℂ} {B : ℝ} (hB : ∀ m z, ‖monoUjm j κ L h m f z‖ ≤ B) (hB0 : 0 ≤ B) (z : ℝ × ℝ) :
    ‖monoFTilde j κ L h M f z‖ ≤ 9 * B := by
  classical
  unfold monoFTilde
  rw [← Finset.sum_filter_ne_zero]
  refine (norm_sum_le _ _).trans ?_
  have hcard : (M.filter fun m => monoVWhole h m (monoUjm j κ L h m f) z ≠ 0).card ≤ 9 :=
    mloc_ChiM_card_le (h := h) (z := z) _ fun m hm => by
      intro h0; exact (Finset.mem_filter.mp hm).2 (by simp only [monoVWhole, h0]; simp)
  calc ∑ m ∈ M.filter (fun m => monoVWhole h m (monoUjm j κ L h m f) z ≠ 0),
        ‖monoVWhole h m (monoUjm j κ L h m f) z‖
      ≤ ∑ m ∈ M.filter (fun m => monoVWhole h m (monoUjm j κ L h m f) z ≠ 0), B :=
        Finset.sum_le_sum fun m _ => norm_chiM_mul_le (hB m) z
    _ ≤ 9 * B := by
        rw [Finset.sum_const, nsmul_eq_mul]
        exact mul_le_mul_of_nonneg_right (by exact_mod_cast hcard) hB0

