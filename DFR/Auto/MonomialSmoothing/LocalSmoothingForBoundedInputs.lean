/-! ### Fourier transforms of the dilated kernels -/

/-- `𝓕 (L κ(L ·)) (ξ) = 𝓕 κ (ξ / L)`. -/
theorem mloc_fourier_dil (κ : ℝ → ℂ) {L : ℝ} (hL : 0 < L) (ξ : ℝ) :
    𝓕 (fun s => (L : ℂ) * κ (L * s)) ξ = 𝓕 κ (ξ / L) := by
  rw [Real.fourier_real_eq, Real.fourier_real_eq]
  have h := Measure.integral_comp_mul_left
    (fun t => Real.fourierChar (-(t * (ξ / L))) • κ t) L
  have e : ∀ v : ℝ, Real.fourierChar (-(v * ξ)) • ((L : ℂ) * κ (L * v)) =
      (L : ℂ) * (Real.fourierChar (-(L * v * (ξ / L))) • κ (L * v)) := by
    intro v
    rw [show L * v * (ξ / L) = v * ξ by field_simp, mul_smul_comm]
  simp_rw [e]
  rw [integral_const_mul, h, abs_inv, abs_of_pos hL, Complex.real_smul, ← mul_assoc,
    Complex.ofReal_inv, mul_inv_cancel₀ (Complex.ofReal_ne_zero.mpr hL.ne'), one_mul]

/-- The kernel `𝓕⁻¹ ϑ` has Fourier transform `ϑ`. -/
theorem mloc_fourier_multK {ϑ : ℝ → ℝ} (hs : ContDiff ℝ ∞ ϑ) (hc : HasCompactSupport ϑ) :
    𝓕 (⇑(monoMultK hs hc)) = fun ξ => (ϑ ξ : ℂ) := by
  rw [← SchwartzMap.fourier_coe]
  unfold monoMultK
  rw [FourierInvPair.fourier_fourierInv_eq]
  rfl

theorem mloc_continuous_dil (κ : 𝓢(ℝ, ℂ)) (L : ℝ) : Continuous fun s => (L : ℂ) * κ (L * s) := by
  have := κ.continuous
  fun_prop

theorem mloc_bdd_dil (κ : 𝓢(ℝ, ℂ)) (L : ℝ) :
    BddAbove (range fun s => ‖(L : ℂ) * κ (L * s)‖) := by
  refine ⟨‖(L : ℂ)‖ * SchwartzMap.seminorm ℝ 0 0 κ, ?_⟩
  rintro _ ⟨s, rfl⟩
  dsimp only
  rw [norm_mul]
  exact mul_le_mul_of_nonneg_left (SchwartzMap.norm_le_seminorm ℝ κ _) (norm_nonneg _)

theorem mloc_integrable_fourier_dil (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L) :
    Integrable (𝓕 fun s => (L : ℂ) * κ (L * s)) := by
  have e : (𝓕 fun s => (L : ℂ) * κ (L * s)) = fun ξ => (𝓕 κ) (L⁻¹ * ξ) := by
    ext ξ; rw [mloc_fourier_dil _ hL, SchwartzMap.fourier_coe, div_eq_inv_mul]
  rw [e]
  exact (𝓕 κ).integrable.comp_mul_left' (inv_ne_zero hL.ne')

/-- **Kernel identity**: if the multiplier of `κ₁` at scale `L₁` equals `1` on the support of
the multiplier of `κ₂` at scale `L₂`, then `κ₁,L₁ ⋆ κ₂,L₂ = κ₂,L₂`. -/
theorem mloc_conv_dil_eq {κ₁ κ₂ : 𝓢(ℝ, ℂ)} {L₁ L₂ : ℝ} (h₁ : 0 < L₁) (h₂ : 0 < L₂)
    (hmul : ∀ ξ, 𝓕 (⇑κ₁) (ξ / L₁) * 𝓕 (⇑κ₂) (ξ / L₂) = 𝓕 (⇑κ₂) (ξ / L₂)) :
    ((fun s => (L₁ : ℂ) * κ₁ (L₁ * s)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (fun s => (L₂ : ℂ) * κ₂ (L₂ * s))) = fun s => (L₂ : ℂ) * κ₂ (L₂ * s) := by
  set k₁ := fun s => (L₁ : ℂ) * κ₁ (L₁ * s)
  set k₂ := fun s => (L₂ : ℂ) * κ₂ (L₂ * s)
  have hk₁ : Integrable k₁ := mloc_integrable_dil κ₁ h₁.ne'
  have hk₂ : Integrable k₂ := mloc_integrable_dil κ₂ h₂.ne'
  have hcc : Continuous (k₁ ⋆[ContinuousLinearMap.mul ℂ ℂ] k₂) :=
    BddAbove.continuous_convolution_right_of_integrable _ (mloc_bdd_dil κ₂ L₂) hk₁
      (mloc_continuous_dil κ₂ L₂)
  have hci : Integrable (k₁ ⋆[ContinuousLinearMap.mul ℂ ℂ] k₂) :=
    hk₁.integrable_convolution _ hk₂
  have hF : 𝓕 (k₁ ⋆[ContinuousLinearMap.mul ℂ ℂ] k₂) = 𝓕 k₂ := by
    ext ξ
    rw [Real.fourier_mul_convolution_eq hk₁ hk₂, mloc_fourier_dil _ h₁, mloc_fourier_dil _ h₂,
      hmul]
  have hFi : Integrable (𝓕 k₂) := mloc_integrable_fourier_dil κ₂ h₂
  rw [← hcc.fourierInv_fourier_eq hci (hF ▸ hFi), hF,
    (mloc_continuous_dil κ₂ L₂).fourierInv_fourier_eq hk₂ hFi]

/-- **Composition of coordinate multipliers** (Fubini). -/
theorem mloc_monoP_comp {κ₁ κ₂ : 𝓢(ℝ, ℂ)} {L₁ L₂ : ℝ} (h₁ : 0 < L₁) (h₂ : 0 < L₂)
    (hmul : ∀ ξ, 𝓕 (⇑κ₁) (ξ / L₁) * 𝓕 (⇑κ₂) (ξ / L₂) = 𝓕 (⇑κ₂) (ξ / L₂)) (j : Fin 2)
    {u : ℝ × ℝ → ℂ} (hu : Measurable u) {M : ℝ} (hM : ∀ z, ‖u z‖ ≤ M) :
    monoP j κ₁ L₁ (monoP j κ₂ L₂ u) = monoP j κ₂ L₂ u := by
  ext z
  set k₁ := fun s => (L₁ : ℂ) * κ₁ (L₁ * s)
  set k₂ := fun s => (L₂ : ℂ) * κ₂ (L₂ * s)
  have hk₁ : Integrable k₁ := mloc_integrable_dil κ₁ h₁.ne'
  have hk₂ : Integrable k₂ := mloc_integrable_dil κ₂ h₂.ne'
  have hconv := mloc_conv_dil_eq h₁ h₂ hmul
  -- the integrand on the product
  have hH : Integrable (fun p : ℝ × ℝ => k₁ p.2 * k₂ (p.1 - p.2) * u (z - monoEj j p.1))
      (volume.prod volume) := by
    have hi := hk₁.convolution_integrand (ContinuousLinearMap.mul ℂ ℂ) hk₂
    simp only [ContinuousLinearMap.mul_apply'] at hi
    exact hi.mul_bdd ((mloc_meas_shift hu j z).comp measurable_fst).aestronglyMeasurable
      (Eventually.of_forall fun _ => hM _)
  have step1 : monoP j κ₁ L₁ (monoP j κ₂ L₂ u) z =
      ∫ s, ∫ r, k₁ s * k₂ (r - s) * u (z - monoEj j r) := by
    unfold monoP monoCConv
    congr 1; ext s
    rw [← integral_const_mul,
      ← integral_sub_right_eq_self (fun t => k₁ s * (k₂ t * u (z - monoEj j s - monoEj j t))) s]
    congr 1; ext r
    rw [sub_sub, ← mloc_monoEj_add, add_sub_cancel]
    ring
  have step2 : ∫ s, ∫ r, k₁ s * k₂ (r - s) * u (z - monoEj j r) =
      ∫ r, ∫ s, k₁ s * k₂ (r - s) * u (z - monoEj j r) :=
    (integral_integral_swap (f := fun r s => k₁ s * k₂ (r - s) * u (z - monoEj j r)) hH).symm
  rw [step1, step2]
  unfold monoP monoCConv
  congr 1; ext r
  rw [integral_mul_const]
  congr 1
  have := congrFun hconv r
  rw [convolution_def] at this
  simpa only [ContinuousLinearMap.mul_apply'] using this

/-! #### The specific enlarged multipliers -/
theorem mloc_psiA_ne_zero {x : ℝ} (hx : monoPsiA x ≠ 0) : 1 / 2 < |x| ∧ |x| < 2 := by
  constructor
  · by_contra h
    push Not at h
    apply hx
    have h1 : monoPhi x = 1 := monoPhi_eq_one (by linarith)
    have h2 : monoPhi (2 * x) = 1 := monoPhi_eq_one (by rw [abs_mul]; norm_num; linarith)
    simp [monoPsiA, h1, h2]
  · by_contra h
    push Not at h
    apply hx
    have h1 : monoPhi x = 0 := monoPhi_eq_zero h
    have h2 : monoPhi (2 * x) = 0 := monoPhi_eq_zero (by rw [abs_mul]; norm_num; linarith)
    simp [monoPsiA, h1, h2]

theorem mloc_psiE_mul_psiA (x : ℝ) : monoPsiE x * monoPsiA x = monoPsiA x := by
  by_cases hx : monoPsiA x = 0
  · rw [hx, mul_zero]
  obtain ⟨h1, h2⟩ := mloc_psiA_ne_zero hx
  have e1 : monoPhi (x / 2) = 1 := monoPhi_eq_one (by rw [abs_div, abs_two]; linarith)
  have e2 : monoPhi (4 * x) = 0 := monoPhi_eq_zero (by rw [abs_mul]; norm_num; linarith)
  simp [monoPsiE, e1, e2]

theorem mloc_phi_ne_zero {x : ℝ} (hx : monoPhi x ≠ 0) : |x| < 2 :=
  lt_of_not_ge fun h => hx (monoPhi_eq_zero h)

theorem mloc_phiE_mul_phi (x : ℝ) : monoPhiE x * monoPhi x = monoPhi x := by
  by_cases hx : monoPhi x = 0
  · rw [hx, mul_zero]
  have e1 : monoPhiE x = 1 :=
    monoPhi_eq_one (by rw [abs_div, abs_two]; linarith [mloc_phi_ne_zero hx])
  rw [e1, one_mul]

theorem mloc_phiE_mul_phi_two (x : ℝ) : monoPhiE x * monoPhi (2 * x) = monoPhi (2 * x) := by
  by_cases hx : monoPhi (2 * x) = 0
  · rw [hx, mul_zero]
  have h := mloc_phi_ne_zero hx
  rw [abs_mul, abs_two] at h
  have e1 : monoPhiE x = 1 :=
    monoPhi_eq_one (by rw [abs_div, abs_two]; linarith)
  rw [e1, one_mul]

/-- `ψ_E(D_j/L) ψ(D_j/L) = ψ(D_j/L)`. -/
theorem mloc_P_psiE_psiA (j : Fin 2) {L : ℝ} (hL : 0 < L) {u : ℝ × ℝ → ℂ} (hu : Measurable u)
    {M : ℝ} (hM : ∀ z, ‖u z‖ ≤ M) :
    monoP j monoKPsiE L (monoP j monoKPsiA L u) = monoP j monoKPsiA L u := by
  refine mloc_monoP_comp hL hL (fun ξ => ?_) j hu hM
  simp only [monoKPsiE, monoKPsiA, mloc_fourier_multK]
  exact_mod_cast mloc_psiE_mul_psiA (ξ / L)

/-- `φ_E(D_j/L) φ(D_j/L) = φ(D_j/L)`. -/
theorem mloc_P_phiE_phi (j : Fin 2) {L : ℝ} (hL : 0 < L) {u : ℝ × ℝ → ℂ} (hu : Measurable u)
    {M : ℝ} (hM : ∀ z, ‖u z‖ ≤ M) :
    monoP j monoKPhiE L (monoP j monoKPhi L u) = monoP j monoKPhi L u := by
  refine mloc_monoP_comp hL hL (fun ξ => ?_) j hu hM
  simp only [monoKPhiE, monoKPhi, mloc_fourier_multK]
  exact_mod_cast mloc_phiE_mul_phi (ξ / L)

/-- `φ_E(D_j/L) φ(2 D_j/L) = φ(2 D_j/L)`. -/
theorem mloc_P_phiE_phi_half (j : Fin 2) {L : ℝ} (hL : 0 < L) {u : ℝ × ℝ → ℂ}
    (hu : Measurable u) {M : ℝ} (hM : ∀ z, ‖u z‖ ≤ M) :
    monoP j monoKPhiE L (monoP j monoKPhi (L / 2) u) = monoP j monoKPhi (L / 2) u := by
  refine mloc_monoP_comp hL (by positivity) (fun ξ => ?_) j hu hM
  simp only [monoKPhiE, monoKPhi, mloc_fourier_multK]
  have e : ξ / (L / 2) = 2 * (ξ / L) := by field_simp
  rw [e]
  exact_mod_cast mloc_phiE_mul_phi_two (ξ / L)

end

end Auto

