/-! ### Proposition 6.1: parameter facts and elementary bounds -/
theorem rpow_ge_of_ge_two_pow {L : ℝ} (hL : 2 ^ 16 ≤ L) {e : ℝ} (he : 0 ≤ e) :
    (2 : ℝ) ^ (16 * e) ≤ L ^ e := by
  rw [show (2 : ℝ) ^ (16 * e) = ((2 : ℝ) ^ (16 : ℝ)) ^ e by rw [← Real.rpow_mul (by norm_num)]]
  exact Real.rpow_le_rpow (by positivity) (by norm_num at hL ⊢; linarith) he

/-- The parameter facts used in Proposition 6.1 for `L ≥ 2^16`. -/
theorem mono61_facts {L : ℝ} (hL : 2 ^ 16 ≤ L) :
    let h := L ^ (-(3 / 4 : ℝ)); let K := L ^ (1 / 16 : ℝ); let R := L ^ (13 / 16 : ℝ)
    let S := L ^ (7 / 8 : ℝ); let ρ := L ^ (-((1 / 39 : ℝ) / 64))
    0 < h ∧ h ≤ 1 ∧ 1 ≤ h * L ∧ 1 / h ≤ L ∧ 1 ≤ K ∧ 1 ≤ R ∧ R ≤ L / 8 ∧ R ≤ L ∧ 1 ≤ R * h ∧
      R * h = K ∧ 0 < S ∧ 2 * S ≤ L ∧ 0 < ρ ∧ ρ < 1 := by
  intro h K R S ρ
  have hL1 : 1 ≤ L := le_trans (by norm_num) hL
  have hL0 : 0 < L := by linarith
  obtain ⟨-, -, -, -, -, hRh, hhL⟩ := mono61_params hL1
  have hh : 0 < h := Real.rpow_pos_of_pos hL0 _
  have hhL' : 1 ≤ h * L := by
    change 1 ≤ L ^ (-(3 / 4 : ℝ)) * L; rw [hhL]; exact Real.one_le_rpow hL1 (by norm_num)
  have hK : 1 ≤ K := Real.one_le_rpow hL1 (by norm_num)
  have hR8 : R ≤ L / 8 := by
    have h8 : (8 : ℝ) ≤ L ^ (3 / 16 : ℝ) := by
      have := rpow_ge_of_ge_two_pow hL (e := 3 / 16) (by norm_num)
      norm_num at this; exact this
    have e : L = R * L ^ (3 / 16 : ℝ) := by
      change L = L ^ (13 / 16 : ℝ) * L ^ (3 / 16 : ℝ)
      rw [← Real.rpow_add hL0]; norm_num
    have hR0 : 0 ≤ R := (Real.rpow_pos_of_pos hL0 _).le
    rw [le_div_iff₀ (by norm_num : (0 : ℝ) < 8)]
    calc R * 8 ≤ R * L ^ (3 / 16 : ℝ) := mul_le_mul_of_nonneg_left h8 hR0
      _ = L := e.symm
  have hS2 : 2 * S ≤ L := by
    have h4 : (2 : ℝ) ≤ L ^ (1 / 8 : ℝ) := by
      have := rpow_ge_of_ge_two_pow hL (e := 1 / 8) (by norm_num)
      norm_num at this; linarith
    have e : L = S * L ^ (1 / 8 : ℝ) := by
      change L = L ^ (7 / 8 : ℝ) * L ^ (1 / 8 : ℝ)
      rw [← Real.rpow_add hL0]; norm_num
    have hS0 : 0 ≤ S := (Real.rpow_pos_of_pos hL0 _).le
    calc 2 * S = S * 2 := by ring
      _ ≤ S * L ^ (1 / 8 : ℝ) := mul_le_mul_of_nonneg_left h4 hS0
      _ = L := e.symm
  refine ⟨hh, Real.rpow_le_one_of_one_le_of_nonpos hL1 (by norm_num), hhL', ?_, hK,
    Real.one_le_rpow hL1 (by norm_num), hR8, hR8.trans (by linarith), hRh ▸ hK, hRh,
    Real.rpow_pos_of_pos hL0 _, hS2, Real.rpow_pos_of_pos hL0 _,
    Real.rpow_lt_one_of_one_lt_of_neg (by linarith) (by norm_num)⟩
  rw [div_le_iff₀ hh]; linarith

theorem norm_finset_sum_le_card {ι : Type*} (s : Finset ι) {v : ι → ℝ × ℝ → ℂ} {B : ℝ}
    (hv : ∀ m z, ‖v m z‖ ≤ B) (z : ℝ × ℝ) : ‖∑ m ∈ s, v m z‖ ≤ s.card * B := by
  refine (norm_sum_le _ _).trans ?_
  calc ∑ m ∈ s, ‖v m z‖ ≤ ∑ _m ∈ s, B := Finset.sum_le_sum fun m _ => hv m z
    _ = s.card * B := by rw [Finset.sum_const, nsmul_eq_mul]

/-- The uniform sup and Lipschitz constant of the three families. -/
def monoC2 (Cχ a0 : ℝ) : ℝ :=
  (Cχ + 1) * (1 + 9 * ∫ u, ‖monoKappa u‖) * a0 + a0 +
    9 * ((∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖) + 10 * π * ∫ u, ‖monoKappa u‖) * a0

section
variable {j : Fin 2} {h M E1 Ω Λ R ρ L Cχ a0 : ℝ} {m : ℤ × ℤ} {G : ℝ × ℝ → ℂ}

theorem monoLipS_le (hR0 : 0 ≤ R) (hRL : R ≤ L) (hΩ : Ω ≤ 4 * L) (hM0 : 0 ≤ M)
    (hM : M ≤ a0) (hρ : 0 < ρ) :
    monoLipS R ρ Ω M ≤ 9 * ((∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖) + 10 * π * ∫ u, ‖monoKappa u‖) *
      a0 * L / ρ := by
  have hk0 : 0 ≤ ∫ u, ‖monoKappa u‖ := integral_nonneg fun _ => norm_nonneg _
  have hk1 : 0 ≤ ∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖ := integral_nonneg fun _ => norm_nonneg _
  have hL0 : 0 ≤ L := hR0.trans hRL
  unfold monoLipS
  have h1 : R * (∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖) + 2 * π * (Ω + R) * (∫ u, ‖monoKappa u‖)
      ≤ ((∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖) + 10 * π * ∫ u, ‖monoKappa u‖) * L := by
    have : 2 * π * (Ω + R) ≤ 2 * π * (5 * L) := by gcongr; linarith
    nlinarith [Real.pi_pos]
  have h2 : (R * (∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖) + 2 * π * (Ω + R) * (∫ u, ‖monoKappa u‖)) * M
      ≤ ((∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖) + 10 * π * ∫ u, ‖monoKappa u‖) * L * a0 :=
    mul_le_mul h1 hM hM0 (by positivity)
  calc 9 / ρ * ((R * (∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖) + 2 * π * (Ω + R) * (∫ u, ‖monoKappa
    u‖)) * M)
      ≤ 9 / ρ * (((∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖) + 10 * π * ∫ u, ‖monoKappa u‖) * L * a0) :=
        by
        gcongr
    _ = _ := by field_simp

end

end

