/-- **Lemma 3.1 (sublevel estimate)**, blueprint `task_1_smoothing_inequality_2.tex`, (3.1). -/
theorem msub_sublevel {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B)
    {D : Set (ℝ × ℝ)} (hD : Bornology.IsBounded D) {c0 : ℝ} (hc0 : 0 < c0) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ α β : ℝ × ℝ → ℝ, Measurable α → Measurable β →
      ((∀ z, c0 ≤ |α z|) ∨ (∀ z, c0 ≤ |β z|)) → ∀ ε : ℝ, 0 < ε → ε ≤ 1 →
        volume {p : (ℝ × ℝ) × ℝ | p.1 ∈ D ∧ p.2 ∈ Set.Icc A B ∧
          |α (p.1.1 + p.2, p.1.2) - monoq r p.2 * β (p.1.1, p.1.2 + monoQ r p.2)| ≤ ε}
          ≤ ENNReal.ofReal (C * ε ^ (1 / 39 : ℝ)) := by
  obtain ⟨R, hR, hDR⟩ := hD.subset_closedBall_lt 0 0
  obtain ⟨C1, hC1, hC1'⟩ := msub_alpha_case hr hA hAB hR hc0
  obtain ⟨C2, hC2, hC2'⟩ := msub_beta_case hr hA hAB hR hc0
  obtain ⟨D0, D1, -, -, -, -, -, -, hfacts⟩ := msub_Eset_facts hr hA hAB hR
  refine ⟨max C1 C2, le_max_of_le_left hC1, fun α β hα hβ hαβ ε hε _ => ?_⟩
  set E := msubEset r A B R α β ε
  have hEm := msub_Eset_meas r A B R hα hβ ε
  have hfin := (hfacts α β ε).2
  have hf : Measurable fun t : ℝ => ((t, 0) : ℝ × ℝ) := measurable_id.prodMk measurable_const
  have hsub : {p : (ℝ × ℝ) × ℝ | p.1 ∈ D ∧ p.2 ∈ Set.Icc A B ∧
      |α (p.1.1 + p.2, p.1.2) - monoq r p.2 * β (p.1.1, p.1.2 + monoQ r p.2)| ≤ ε} ⊆
      (fun p : (ℝ × ℝ) × ℝ => (p.1 + (p.2, 0), p.2)) ⁻¹' E := by
    rintro p ⟨h1, h2, h3⟩
    have e0 : ((p.1 + (p.2, 0)).1 - p.2, (p.1 + (p.2, 0)).2) = p.1 := by
      ext <;> simp
    have e1 : p.1 + (p.2, 0) = (p.1.1 + p.2, p.1.2) := by ext <;> simp
    have e2 : p.1 + (p.2, 0) + msubGam r p.2 = (p.1.1, p.1.2 + monoQ r p.2) := by
      ext <;> simp [msubGam]
    refine ⟨?_, h2, ?_⟩
    · simp only; rw [e0]; exact hDR h1
    · simp only; rw [e2, e1]; exact h3
  have hbound : (volume E).toReal ≤ max C1 C2 * ε ^ (1 / 39 : ℝ) := by
    have hε39 : 0 ≤ ε ^ (1 / 39 : ℝ) := by positivity
    rcases hαβ with hαc | hβc
    · exact (hC1' α β hα hβ hαc ε hε).trans
        (mul_le_mul_of_nonneg_right (le_max_left _ _) hε39)
    · exact (hC2' α β hα hβ hβc ε hε).trans
        (mul_le_mul_of_nonneg_right (le_max_right _ _) hε39)
  calc _ ≤ volume ((fun p : (ℝ × ℝ) × ℝ => (p.1 + (p.2, 0), p.2)) ⁻¹' E) := measure_mono hsub
    _ = volume E := msub_shear hf hEm
    _ = ENNReal.ofReal (volume E).toReal := (ENNReal.ofReal_toReal hfin).symm
    _ ≤ _ := ENNReal.ofReal_le_ofReal hbound

end
