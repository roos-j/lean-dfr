/-! ### Section 2 preliminaries: the partition cutoff and its modulated kernels -/
theorem monoThetaC_contDiff : ContDiff ℝ ∞ (fun x : ℝ => (smoothingPartitionCutoff x : ℂ)) :=
  Complex.ofRealCLM.contDiff.comp smoothingPartitionCutoff_contDiff

theorem monoThetaC_hasCompactSupport :
    HasCompactSupport (fun x : ℝ => (smoothingPartitionCutoff x : ℂ)) :=
  smoothingPartitionCutoff_hasCompactSupport.comp_left Complex.ofReal_zero

/-- The partition cutoff `ϑ` of Lemma 2.1 (lines 244-250) as a complex Schwartz function. -/
def monoThetaS : 𝓢(ℝ, ℂ) := monoThetaC_hasCompactSupport.toSchwartzMap monoThetaC_contDiff

theorem monoThetaS_apply (x : ℝ) : monoThetaS x = (smoothingPartitionCutoff x : ℂ) := rfl

/-- The kernel `κ = 𝓕⁻¹ ϑ`. -/
def monoKappa : 𝓢(ℝ, ℂ) := 𝓕⁻ monoThetaS

theorem fourier_monoKappa (ξ : ℝ) : 𝓕 (⇑monoKappa) ξ = (smoothingPartitionCutoff ξ : ℂ) := by
  have h : 𝓕 monoKappa = monoThetaS := fourier_fourierInv_eq monoThetaS
  rw [← SchwartzMap.fourier_coe, h, monoThetaS_apply]

/-- The modulated, scaled kernel of `ϑ(D/R - n)`: `R κ(R s) e^{2πi n R s}`. -/
def monoKn (R : ℝ) (n : ℤ) (s : ℝ) : ℂ :=
  (R : ℂ) * monoKappa (R * s) * ((𝐞 (n * R * s) : Circle) : ℂ)

theorem integrable_scaled_schwartz (K : 𝓢(ℝ, ℂ)) {R : ℝ} (hR : 0 < R) :
    Integrable (fun s : ℝ => (R : ℂ) * K (R * s)) volume := by
  have h := (K.integrable (μ := volume)).comp_mul_left' hR.ne'
  exact h.const_mul (R : ℂ)

theorem integrable_monoKn {R : ℝ} (hR : 0 < R) (n : ℤ) : Integrable (monoKn R n) volume := by
  refine (integrable_scaled_schwartz monoKappa hR).mul_bdd (c := 1) ?_ ?_
  · exact (Continuous.aestronglyMeasurable (by fun_prop))
  · exact Eventually.of_forall fun s => (Circle.norm_coe _).le

/-- `𝓕(R κ(R ·) e^{2πinR·})(ξ) = ϑ(ξ/R - n)`. -/
theorem fourier_monoKn {R : ℝ} (hR : 0 < R) (n : ℤ) (ξ : ℝ) :
    𝓕 (monoKn R n) ξ = (smoothingPartitionCutoff (ξ / R - n) : ℂ) := by
  rw [Real.fourier_real_eq]
  have e1 : ∀ v : ℝ, 𝐞 (-(v * ξ)) • monoKn R n v
      = (fun u : ℝ => (R : ℂ) * ((𝐞 (-(u * (ξ / R - n))) : ℂ) * monoKappa u)) (R * v) := by
    intro v
    simp only [monoKn, Circle.smul_def, smul_eq_mul]
    have : (𝐞 (-(v * ξ)) : ℂ) * (𝐞 (n * R * v) : ℂ) = 𝐞 (-(R * v * (ξ / R - n))) := by
      rw [← Circle.coe_mul, ← AddChar.map_add_eq_mul]
      congr 2
      field_simp
      ring
    rw [← this]; ring
  simp_rw [e1]
  rw [Measure.integral_comp_mul_left (fun u : ℝ => (R : ℂ) * ((𝐞 (-(u * (ξ / R - n))) : ℂ) *
    monoKappa u)) R, integral_const_mul, ← fourier_monoKappa, Real.fourier_real_eq]
  simp only [Circle.smul_def, smul_eq_mul]
  rw [abs_inv, abs_of_pos hR, Complex.real_smul, ← mul_assoc, Complex.ofReal_inv,
    inv_mul_cancel₀ (by exact_mod_cast hR.ne'), one_mul]

/-- The frequency piece `ϑ(D/R - n) F = (R κ(R ·) e^{2πinR·}) * F`. -/
def monoPiece (R : ℝ) (n : ℤ) (F : ℝ → ℂ) : ℝ → ℂ :=
  monoKn R n ⋆[ContinuousLinearMap.mul ℂ ℂ] F

theorem integrable_monoPiece {R : ℝ} (hR : 0 < R) (n : ℤ) {F : ℝ → ℂ} (hF : Integrable F volume) :
    Integrable (monoPiece R n F) volume :=
  (integrable_monoKn hR n).integrable_convolution _ hF

theorem fourier_monoPiece {R : ℝ} (hR : 0 < R) (n : ℤ) {F : ℝ → ℂ} (hF : Integrable F volume)
    (ξ : ℝ) :
    𝓕 (monoPiece R n F) ξ = (smoothingPartitionCutoff (ξ / R - n) : ℂ) * 𝓕 F ξ := by
  rw [monoPiece, Real.fourier_mul_convolution_eq (integrable_monoKn hR n) hF, fourier_monoKn hR]

theorem monoPiece_apply (R : ℝ) (n : ℤ) (F : ℝ → ℂ) (x : ℝ) :
    monoPiece R n F x = ∫ t, monoKn R n t * F (x - t) := by
  rw [monoPiece, convolution_def]; rfl

end

