open MeasureTheory Set intervalIntegral ComplexConjugate

namespace Auto

noncomputable section

theorem mnst_intervalIntegral_conj {a b : ℝ} (hab : a ≤ b) (f : ℝ → ℂ) :
    ∫ t in a..b, conj (f t) = conj (∫ t in a..b, f t) := by
  rw [intervalIntegral.integral_of_le hab, intervalIntegral.integral_of_le hab, integral_conj]

theorem mnst_nonstationary : ∃ C : ℝ, 0 < C ∧ ∀ (c d : ℝ) (H H' : ℝ → ℂ) (φ φ' φ'' : ℝ → ℝ)
    (M S : ℝ),
    c ≤ d → (∀ t ∈ Set.Icc c d, HasDerivAt H (H' t) t) → ContinuousOn H' (Set.Icc c d) →
    H c = 0 → H d = 0 → (∀ t ∈ Set.Icc c d, ‖H t‖ ≤ M) →
    (∀ t ∈ Set.Icc c d, HasDerivAt φ (φ' t) t) → (∀ t ∈ Set.Icc c d, HasDerivAt φ' (φ'' t) t) →
    ContinuousOn φ'' (Set.Icc c d) → (MonotoneOn φ' (Set.Icc c d) ∨ AntitoneOn φ' (Set.Icc c d)) →
    0 < S →
    ‖∫ t in c..d, Complex.exp (2 * Real.pi * Complex.I * φ t) * H t‖
      ≤ (∫ t in c..d, Set.indicator {t | |φ' t| ≤ 2 * S} (fun t => ‖H t‖) t)
        + C / S * ((∫ t in c..d, ‖H' t‖) + M) := by
  refine ⟨2, by norm_num, ?_⟩
  intro c d H H' φ φ' φ'' M S hcd hH hH' _ _ hM hφ hφ' hφ'' hmono hS
  rcases hmono with hm | ha
  · exact mnst_mono hcd hH hH' hM hφ hφ' hφ'' hm hS
  · have key := mnst_mono (H := fun t => conj (H t)) (H' := fun t => conj (H' t))
      (φ := fun t => -φ t) (φ' := fun t => -φ' t) (φ'' := fun t => -φ'' t) (M := M) hcd
      (fun t ht => (hH t ht).star) hH'.star (fun t ht => by simpa using hM t ht)
      (fun t ht => (hφ t ht).neg) (fun t ht => (hφ' t ht).neg) hφ''.neg
      (fun x hx y hy hxy => neg_le_neg (ha hx hy hxy)) hS
    have e1 : ∫ t in c..d, Complex.exp (2 * Real.pi * Complex.I * ((-φ t : ℝ) : ℂ)) * conj (H t)
        = conj (∫ t in c..d, Complex.exp (2 * Real.pi * Complex.I * φ t) * H t) := by
      rw [← mnst_intervalIntegral_conj hcd]
      apply integral_congr
      intro t _
      simp only [map_mul, ← Complex.exp_conj, Complex.conj_ofReal, Complex.conj_I,
        map_ofNat]
      push_cast; ring_nf
    rw [e1, Complex.norm_conj] at key
    simpa [abs_neg, Complex.norm_conj] using key

end

end Auto

