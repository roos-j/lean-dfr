open MeasureTheory Set Filter Topology
open scoped ENNReal NNReal

namespace Auto
noncomputable section

/-- The shear `(z, t) ↦ (z + f t, t)` preserves Lebesgue measure on `ℝ² × ℝ`. -/
theorem msub_shear {f : ℝ → ℝ × ℝ} (hf : Measurable f) {S : Set ((ℝ × ℝ) × ℝ)}
    (hS : MeasurableSet S) :
    volume ((fun p : (ℝ × ℝ) × ℝ => (p.1 + f p.2, p.2)) ⁻¹' S) = volume S := by
  have hm : Measurable (fun p : (ℝ × ℝ) × ℝ => (p.1 + f p.2, p.2)) :=
    (measurable_fst.add (hf.comp measurable_snd)).prodMk measurable_snd
  rw [Measure.volume_eq_prod, Measure.prod_apply_symm (hm hS), Measure.prod_apply_symm hS]
  refine lintegral_congr fun t => ?_
  change volume ((fun z => z + f t) ⁻¹' ((fun z => (z, t)) ⁻¹' S)) = _
  exact measure_preimage_add_right _ _ _

/-- Pruning: the part of `F` over low-degree base points is small. -/
theorem msub_prune {F : Set ((ℝ × ℝ) × ℝ)} (hF : MeasurableSet F) {D : Set (ℝ × ℝ)}
    (hD : MeasurableSet D) (hFD : ∀ p ∈ F, p.1 ∈ D) (a : ℝ≥0∞) :
    volume (F ∩ {p | volume (Prod.mk p.1 ⁻¹' F) < a}) ≤ a * volume D := by
  have hm : MeasurableSet (F ∩ {p : (ℝ × ℝ) × ℝ | volume (Prod.mk p.1 ⁻¹' F) < a}) :=
    hF.inter (measurableSet_lt ((measurable_measure_prodMk_left hF).comp measurable_fst)
      measurable_const)
  rw [Measure.volume_eq_prod, Measure.prod_apply hm, ← lintegral_indicator_const hD]
  refine lintegral_mono fun z => ?_
  by_cases hz : z ∈ D
  · rw [indicator_of_mem hz]
    by_cases hza : volume (Prod.mk z ⁻¹' F) < a
    · exact (measure_mono fun t ht => ht.1).trans hza.le
    · rw [show Prod.mk z ⁻¹' (F ∩ {p : (ℝ × ℝ) × ℝ | volume (Prod.mk p.1 ⁻¹' F) < a}) = ∅ from
        eq_empty_of_forall_notMem fun t ht => hza ht.2]
      simp
  · rw [indicator_of_notMem hz, show Prod.mk z ⁻¹' (F ∩ {p : (ℝ × ℝ) × ℝ |
        volume (Prod.mk p.1 ⁻¹' F) < a}) = ∅ from
        eq_empty_of_forall_notMem fun t ht => hz (hFD _ ht.1)]
    simp

end
end Auto

