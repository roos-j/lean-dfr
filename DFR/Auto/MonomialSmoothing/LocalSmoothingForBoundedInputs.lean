    _ = R * (∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖) * M := by
        rw [integral_mul_const, integral_norm_monoKR' hR]

theorem continuous_monoPiece {R : ℝ} (hR : 1 ≤ R) (n : ℤ) {F : ℝ → ℂ}
    (hF : AEStronglyMeasurable F volume) {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) :
    Continuous (monoPiece R n F) := by
  have hH : Continuous (monoH R n F) := continuous_iff_continuousAt.mpr fun x =>
    (hasDerivAt_monoH hR n hF hM x).continuousAt
  have e : monoPiece R n F = fun x => monoH R n F x * (𝐞 (n * R * x) : Circle) :=
    funext (monoPiece_eq_monoH R n F)
  rw [e]
  exact hH.mul (by fun_prop)

theorem norm_monoPiece_le {R : ℝ} (hR : 0 < R) (n : ℤ) {F : ℝ → ℂ}
     {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) (x : ℝ) :
    ‖monoPiece R n F x‖ ≤ (∫ u, ‖monoKappa u‖) * M := by
  rw [monoPiece_eq_monoH, norm_mul, Circle.norm_coe, mul_one]
