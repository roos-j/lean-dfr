/-! ### Proposition 6.1: the flat terms via Lemma 5.1 -/
theorem energy_conv0 {v : ℝ × ℝ → ℂ} {c : ℝ≥0∞}
    (hv : ∫⁻ p, (∫⁻ a, ‖v (monoPt 0 a p)‖ₑ ^ 2) ^ 2 ≤ c) : ∫⁻ y, (∫⁻ x, ‖v (x, y)‖ₑ ^ 2) ^ 2 ≤ c
      := by
  simpa only [monoPt_zero'] using hv

theorem energy_conv1 {v : ℝ × ℝ → ℂ} {c : ℝ≥0∞}
    (hv : ∫⁻ p, (∫⁻ a, ‖v (monoPt 1 a p)‖ₑ ^ 2) ^ 2 ≤ c) : ∫⁻ x, (∫⁻ y, ‖v (x, y)‖ₑ ^ 2) ^ 2 ≤ c
      := by
  simpa only [monoPt_one'] using hv

theorem unif_conv0 {v : ℝ × ℝ → ℂ} {R : ℝ} {c : ℝ≥0∞}
    (hv : ∫⁻ p, monoU R (monoFib 0 v p) ≤ c) : ∫⁻ y, monoU R (fun x => v (x, y)) ≤ c := by
  have e : ∀ p, monoFib 0 v p = fun x => v (x, p) := fun p => by funext x; simp [monoFib, monoPt]
  simpa only [e] using hv

theorem unif_conv1 {v : ℝ × ℝ → ℂ} {R : ℝ} {c : ℝ≥0∞}
    (hv : ∫⁻ p, monoU R (monoFib 1 v p) ≤ c) : ∫⁻ x, monoU R (fun y => v (x, y)) ≤ c := by
  have e : ∀ p, monoFib 1 v p = fun y => v (p, y) := fun p => by funext y; simp [monoFib, monoPt]
  simpa only [e] using hv

theorem energy_scalar {E a0 h C0 : ℝ} (hE0 : 0 ≤ E) (hE : E ≤ a0 * h) (hh : 0 < h)
    (hC0 : 3 / 2 * a0 ^ 2 ≤ C0) : E ^ 2 * (3 / 2 * h) ≤ C0 * h ^ 3 := by
  have h1 : E ^ 2 ≤ (a0 * h) ^ 2 := pow_le_pow_left₀ hE0 hE 2
  have h2 : 0 ≤ h ^ 3 := by positivity
  calc E ^ 2 * (3 / 2 * h) ≤ (a0 * h) ^ 2 * (3 / 2 * h) := by gcongr
    _ = 3 / 2 * a0 ^ 2 * h ^ 3 := by ring
    _ ≤ C0 * h ^ 3 := mul_le_mul_of_nonneg_right hC0 h2

theorem unif_scalar {E a0 h C0 ρ : ℝ} (hE0 : 0 ≤ E) (hE : E ≤ a0 * h) (hh : 0 < h) (hρ : 0 < ρ)
    (hC0 : 3 / 2 * a0 ^ 2 * monoW0 ^ 2 ≤ C0) :
    monoW0 ^ 2 * ρ * E ^ 2 * (3 / 2 * h) ≤ C0 * ρ * h ^ 3 := by
  have h1 : E ^ 2 ≤ (a0 * h) ^ 2 := pow_le_pow_left₀ hE0 hE 2
  have h2 : 0 ≤ ρ * h ^ 3 := by positivity
  calc
    monoW0 ^ 2 * ρ * E ^ 2 * (3 / 2 * h)
        ≤ monoW0 ^ 2 * ρ * (a0 * h) ^ 2 * (3 / 2 * h) := by gcongr
    _ = 3 / 2 * a0 ^ 2 * monoW0 ^ 2 * (ρ * h ^ 3) := by ring
    _ ≤ C0 * (ρ * h ^ 3) := mul_le_mul_of_nonneg_right hC0 h2
    _ = C0 * ρ * h ^ 3 := by ring

theorem mono61_lc {r A B : ℝ} (hLC : MonoLocCorr r A B) (χ : ℝ × ℝ → ℝ)
    (hχ : ContDiff ℝ ∞ χ) (hχc : HasCompactSupport χ) {a0 : ℝ} (ha0 : 0 ≤ a0) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ ψ : ℝ → ℝ, ContDiff ℝ ∞ ψ → tsupport ψ ⊆ Icc A B → monoC20 ψ ≤ 1 →
    ∀ L : ℝ, 2 ^ 16 ≤ L →
    ∀ (M₁ E₁ Ω₁ Λ₁ M₂ E₂ Ω₂ Λ₂ : ℝ) (G₁ G₂ : ℤ × ℤ → ℝ × ℝ → ℂ),
      (∀ m, MonoGoodPiece 0 (L ^ (-(3 / 4 : ℝ))) M₁ E₁ Ω₁ Λ₁ m (G₁ m)) →
      (∀ m, MonoGoodPiece 1 (L ^ (-(3 / 4 : ℝ))) M₂ E₂ Ω₂ Λ₂ m (G₂ m)) →
      0 ≤ M₁ → M₁ ≤ a0 → 0 ≤ E₁ → E₁ ≤ a0 * L ^ (-(3 / 4 : ℝ)) → 0 ≤ Ω₁ → Ω₁ ≤ 4 * L →
      0 ≤ Λ₁ → Λ₁ ≤ a0 * L →
      0 ≤ M₂ → M₂ ≤ a0 → 0 ≤ E₂ → E₂ ≤ a0 * L ^ (-(3 / 4 : ℝ)) → 0 ≤ Ω₂ → Ω₂ ≤ 4 * L →
      0 ≤ Λ₂ → Λ₂ ≤ a0 * L →
      ∀ S₁ S₂ : Finset (ℤ × ℤ),
      eLpNorm (fun z => (χ z : ℂ) * monoT r ψ
          (fun w => ∑ m ∈ S₁, monoVFlat 0 (L ^ (-(3 / 4 : ℝ))) (L ^ (13 / 16 : ℝ))
            (L ^ (-((1 / 39 : ℝ) / 64))) m (G₁ m) w)
          (fun w => ∑ m ∈ S₂, monoVWhole (L ^ (-(3 / 4 : ℝ))) m (G₂ m) w) z) 1 volume
        ≤ ENNReal.ofReal (C * L ^ (-((1 / 39 : ℝ) / 256))) ∧
      eLpNorm (fun z => (χ z : ℂ) * monoT r ψ
          (fun w => ∑ m ∈ S₁, monoVSharp 0 (L ^ (-(3 / 4 : ℝ))) (L ^ (13 / 16 : ℝ))
            (L ^ (-((1 / 39 : ℝ) / 64))) m (G₁ m) w)
          (fun w => ∑ m ∈ S₂, monoVFlat 1 (L ^ (-(3 / 4 : ℝ))) (L ^ (13 / 16 : ℝ))
            (L ^ (-((1 / 39 : ℝ) / 64))) m (G₂ m) w) z) 1 volume
        ≤ ENNReal.ofReal (C * L ^ (-((1 / 39 : ℝ) / 256))) := by
  obtain ⟨Cχ, hCχ0, hCχl⟩ := mloc_ChiM_lip
  have hW := monoW0_nonneg
  set C0 : ℝ := 2 + 3 / 2 * a0 ^ 2 * (monoW0 ^ 2 + 1) with hC0_def
  have hC0 : 1 ≤ C0 := by have : 0 ≤ 3 / 2 * a0 ^ 2 * (monoW0 ^ 2 + 1) := by positivity
                          linarith
  have hC0e : 3 / 2 * a0 ^ 2 ≤ C0 := by nlinarith [sq_nonneg a0, sq_nonneg monoW0]
  have hC0u : 3 / 2 * a0 ^ 2 * monoW0 ^ 2 ≤ C0 := by nlinarith [sq_nonneg a0, sq_nonneg monoW0]
  have hC0s : 3 / 2 ≤ C0 := by have : 0 ≤ 3 / 2 * a0 ^ 2 * (monoW0 ^ 2 + 1) := by positivity
                               linarith
  obtain ⟨Clc, hClc0, hlc⟩ := hLC χ hχ hχc C0 hC0
  set c₂ := monoC2 Cχ a0 with hc₂_def
  have hc₂ : 0 ≤ c₂ := monoC2_nonneg hCχ0 ha0
  refine ⟨Clc * (c₂ ^ 2 + 3), by positivity, ?_⟩
  intro ψ hψ hψs hC20 L hL M₁ E₁ Ω₁ Λ₁ M₂ E₂ Ω₂ Λ₂ G₁ G₂ hG₁ hG₂ hM₁0 hM₁ hE₁0 hE₁ hΩ₁0 hΩ₁ hΛ₁0 hΛ₁
    hM₂0 hM₂ hE₂0 hE₂ hΩ₂0 hΩ₂ hΛ₂0 hΛ₂ S₁ S₂
  have hL1 : 1 ≤ L := le_trans (by norm_num) hL
  obtain ⟨-, hp2, hp3, -, -, -, -⟩ := mono61_params hL1
  obtain ⟨hh, hh1, hhL, hhL', hK, hR1, -, hRL, -, hRh, -, -, hρ0, hρ1⟩ := mono61_facts hL
  set h := L ^ (-(3 / 4 : ℝ)) with hh_def
  set K := L ^ (1 / 16 : ℝ) with hK_def
  set R := L ^ (13 / 16 : ℝ) with hR_def
  set ρ := L ^ (-((1 / 39 : ℝ) / 64)) with hρ_def
  have hR0 : 0 < R := by linarith
  have hKh : K / h = R := by rw [← hRh]; field_simp
  have hsupp : ∀ (F : ℝ × ℝ → ℂ) (m : ℤ × ℤ) (z : ℝ × ℝ), (monoChiM h m z : ℂ) * F z ≠ 0 →
      |z.1 - h * m.1| ≤ C0 * h ∧ |z.2 - h * m.2| ≤ C0 * h := fun F m z hz => by
    obtain ⟨a, b⟩ := support_chiM_mul hh hz
    exact ⟨a.trans (by gcongr), b.trans (by gcongr)⟩
  have hfin : ENNReal.ofReal (Clc * (c₂ / ρ * (c₂ / ρ) * L ^ (1 / 2 : ℝ) * h + (ρ + h + 1 / K) ^
    (1 / 4 : ℝ)))
      ≤ ENNReal.ofReal (Clc * (c₂ ^ 2 + 3) * L ^ (-((1 / 39 : ℝ) / 256))) := by
    refine ENNReal.ofReal_le_ofReal ?_
    have e : c₂ / ρ * (c₂ / ρ) * L ^ (1 / 2 : ℝ) * h = c₂ ^ 2 * (ρ⁻¹ ^ 2 * L ^ (1 / 2 : ℝ) * h) :=
      by
      rw [div_eq_mul_inv]; ring
    rw [e]
    have hLe : 0 ≤ L ^ (-((1 / 39 : ℝ) / 256)) := by positivity
    calc Clc * (c₂ ^ 2 * (ρ⁻¹ ^ 2 * L ^ (1 / 2 : ℝ) * h) + (ρ + h + 1 / K) ^ (1 / 4 : ℝ))
        ≤ Clc * (c₂ ^ 2 * L ^ (-((1 / 39 : ℝ) / 256)) + 3 * L ^ (-((1 / 39 : ℝ) / 256))) :=
          by gcongr
      _ = Clc * (c₂ ^ 2 + 3) * L ^ (-((1 / 39 : ℝ) / 256)) := by ring
  have hen : ∀ E : ℝ, 0 ≤ E → E ≤ a0 * h →
      ENNReal.ofReal (E ^ 2 * (3 / 2 * h)) ≤ ENNReal.ofReal (C0 * h ^ 3) := fun E hE0 hE =>
    ENNReal.ofReal_le_ofReal (energy_scalar hE0 hE hh hC0e)
  have hun : ∀ E : ℝ, 0 ≤ E → E ≤ a0 * h →
      ENNReal.ofReal (monoW0 ^ 2 * ρ * E ^ 2 * (3 / 2 * h)) ≤ ENNReal.ofReal (C0 * ρ * h ^ 3) :=
    fun E hE0 hE => ENNReal.ofReal_le_ofReal (unif_scalar hE0 hE hh hρ0 hC0u)
  constructor
  · refine (hlc ψ hψ hψs hC20 h L K ρ hh hh1 hhL hK hρ0 hρ1 S₁ S₂
      (fun m => monoVFlat 0 h R ρ m (G₁ m)) (fun m => monoVWhole h m (G₂ m)) (c₂ / ρ) (c₂ / ρ)
      (fun m => measurable_monoVFlat (hG₁ m) hR0 hρ0) (fun m => measurable_monoVWhole (hG₂ m))
      (fun m z hz => hsupp _ m z hz) (fun m z hz => hsupp _ m z hz)
      (fun m z => monoVFlat_bdd (hG₁ m) hR0 hρ0 hρ1.le hCχ0 hM₁0 hM₁ z)
      (fun m z => monoVWhole_bdd (hG₂ m) hρ0 hρ1.le hCχ0 hM₂0 hM₂ z)
      (fun m z a => by
        rw [← monoEj_zero']
        exact monoVFlat_lip (hCχl h hh m 0) (hG₁ m) hR1 hρ0 hρ1.le hCχ0 hhL' hRL hΩ₁0 hΩ₁ hM₁0
          hM₁
          hΛ₁ z a)
      (fun m z a => by
        rw [← monoEj_one']
        exact monoVWhole_lip (hCχl h hh m 1) (hG₂ m) hR1 hρ0 hρ1.le hCχ0 hhL' hRL hΩ₂0 hΩ₂ hM₂0
          hM₂
          hΛ₂ z a)
      (fun m => energy_conv0 ((energy_monoVFlat (hG₁ m) hh hR0 hE₁0).trans (hen E₁ hE₁0 hE₁)))
      (fun m => energy_conv1 ((energy_monoVWhole (hG₂ m) hh hE₂0).trans (hen E₂ hE₂0 hE₂)))
      (Or.inl fun m => by
        rw [hKh]
        exact unif_conv0 ((uniformity_monoVFlat (hG₁ m) hh hR1 hρ0 hE₁0).trans (hun E₁ hE₁0
          hE₁)))).trans
      hfin
  · refine (hlc ψ hψ hψs hC20 h L K ρ hh hh1 hhL hK hρ0 hρ1 S₁ S₂
      (fun m => monoVSharp 0 h R ρ m (G₁ m)) (fun m => monoVFlat 1 h R ρ m (G₂ m)) (c₂ / ρ) (c₂ / ρ)
      (fun m => measurable_monoVSharp (hG₁ m) hR0 hρ0) (fun m => measurable_monoVFlat (hG₂ m) hR0
        hρ0)
      (fun m z hz => hsupp _ m z hz) (fun m z hz => hsupp _ m z hz)
      (fun m z => monoVSharp_bdd (hG₁ m) hR0 hρ0 hρ1.le hCχ0 hM₁0 hM₁ z)
      (fun m z => monoVFlat_bdd (hG₂ m) hR0 hρ0 hρ1.le hCχ0 hM₂0 hM₂ z)
      (fun m z a => by
        rw [← monoEj_zero']
        exact monoVSharp_lip (hCχl h hh m 0) (hG₁ m) hR1 hρ0 hρ1.le hCχ0 hhL' hRL hΩ₁0 hΩ₁ hM₁0
          hM₁
          hΛ₁ hΛ₁0 z a)
      (fun m z a => by
        rw [← monoEj_one']
        exact monoVFlat_lip (hCχl h hh m 1) (hG₂ m) hR1 hρ0 hρ1.le hCχ0 hhL' hRL hΩ₂0 hΩ₂ hM₂0
          hM₂
          hΛ₂ z a)
      (fun m => energy_conv0 ((energy_monoVSharp (hG₁ m) hh hR0 hE₁0).trans (hen E₁ hE₁0 hE₁)))
      (fun m => energy_conv1 ((energy_monoVFlat (hG₂ m) hh hR0 hE₂0).trans (hen E₂ hE₂0 hE₂)))
      (Or.inr fun m => by
        rw [hKh]
        exact unif_conv1 ((uniformity_monoVFlat (hG₂ m) hh hR1 hρ0 hE₂0).trans (hun E₂ hE₂0
          hE₂)))).trans
      hfin

end

