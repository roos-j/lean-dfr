open MeasureTheory Filter Topology Set FourierTransform Convolution
open scoped ENNReal SchwartzMap Real ContDiff

namespace Auto

noncomputable section

/-! ### Littlewood-Paley multipliers and the `C^20` norm (lines 1311-1316, 679) -/

/-- `φ ∈ C_c^∞(ℝ)`, `φ = 1` on `[-1,1]`, `supp φ ⊆ [-2,2]` (line 1311). -/
def monoPhi (x : ℝ) : ℝ := Real.smoothTransition ((4 - x ^ 2) / 3)

/-- The annular multiplier `ψ = φ - φ(2·)`, supported in `{1/2 ≤ |ξ| ≤ 2}` (line 1315). -/
def monoPsiA (x : ℝ) : ℝ := monoPhi x - monoPhi (2 * x)

theorem monoPhi_contDiff : ContDiff ℝ ∞ monoPhi :=
  Real.smoothTransition.contDiff.comp ((contDiff_const.sub (contDiff_id.pow 2)).div_const 3)

theorem monoPhi_eq_one {x : ℝ} (hx : |x| ≤ 1) : monoPhi x = 1 := by
  unfold monoPhi
  apply Real.smoothTransition.one_of_one_le
  have : x ^ 2 ≤ 1 := by nlinarith [abs_nonneg x, sq_abs x]
  linarith

theorem monoPhi_eq_zero {x : ℝ} (hx : 2 ≤ |x|) : monoPhi x = 0 := by
  unfold monoPhi
  apply Real.smoothTransition.zero_of_nonpos
  have : 4 ≤ x ^ 2 := by nlinarith [abs_nonneg x, sq_abs x]
  linarith

theorem monoPhi_hasCompactSupport : HasCompactSupport monoPhi := by
  refine HasCompactSupport.of_support_subset_isCompact (isCompact_Icc (a := -2) (b := 2)) ?_
  intro x hx
  by_contra h
  apply hx
  apply monoPhi_eq_zero
  simp only [mem_Icc, not_and_or, not_le] at h
  rcases h with h | h
  · rw [abs_of_neg (by linarith)]; linarith
  · rw [abs_of_pos (by linarith)]; linarith

theorem monoPsiA_contDiff : ContDiff ℝ ∞ monoPsiA :=
  monoPhi_contDiff.sub (monoPhi_contDiff.comp (contDiff_const.mul contDiff_id))

theorem monoPsiA_hasCompactSupport : HasCompactSupport monoPsiA := by
  refine HasCompactSupport.of_support_subset_isCompact (isCompact_Icc (a := -2) (b := 2)) ?_
  intro x hx
  by_contra h
  apply hx
  have h2 : 2 ≤ |x| := by
    simp only [mem_Icc, not_and_or, not_le] at h
    rcases h with h | h
    · rw [abs_of_neg (by linarith)]; linarith
    · rw [abs_of_pos (by linarith)]; linarith
  have h4 : 2 ≤ |2 * x| := by rw [abs_mul]; norm_num; linarith
  simp only [monoPsiA, monoPhi_eq_zero h2, monoPhi_eq_zero h4, sub_self]

/-- A real smooth compactly supported multiplier as a complex Schwartz function. -/
def monoMultS {ϑ : ℝ → ℝ} (hs : ContDiff ℝ ∞ ϑ) (hc : HasCompactSupport ϑ) : 𝓢(ℝ, ℂ) :=
  (hc.comp_left Complex.ofReal_zero).toSchwartzMap (Complex.ofRealCLM.contDiff.comp hs)

/-- The kernel `𝓕⁻¹ ϑ` of a multiplier. -/
def monoMultK {ϑ : ℝ → ℝ} (hs : ContDiff ℝ ∞ ϑ) (hc : HasCompactSupport ϑ) : 𝓢(ℝ, ℂ) :=
  𝓕⁻ (monoMultS hs hc)

/-- The kernel of `φ`. -/
def monoKPhi : 𝓢(ℝ, ℂ) := monoMultK monoPhi_contDiff monoPhi_hasCompactSupport

/-- The kernel of `ψ = φ - φ(2·)`. -/
def monoKPsiA : 𝓢(ℝ, ℂ) := monoMultK monoPsiA_contDiff monoPsiA_hasCompactSupport

/-- The multiplier operator `ϑ(D_j / L) u = ∫ L κ(L s) u(z - s e_j) ds`, `κ = 𝓕⁻¹ ϑ`. -/
def monoP (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L : ℝ) (u : ℝ × ℝ → ℂ) : ℝ × ℝ → ℂ :=
  monoCConv j (fun s => (L : ℂ) * κ (L * s)) u

/-- `‖ψ‖_{C^20} = ∑_{k ≤ 20} sup |ψ^{(k)}|` (line 678; the sum is equivalent to the maximum). -/
def monoC20 (ψ : ℝ → ℝ) : ℝ := ∑ k ∈ Finset.range 21, ⨆ t, |iteratedDeriv k ψ t|

/-- **The global annular estimate (7.7)** in the form used in Section 8: for smooth cutoffs
supported in `[A,B]`, one annular input (multiplier `ψ(D_j/L)`) and the other with bounded
frequencies (multiplier `φ(D_2/L)` in slot 2, resp. `φ(2 D_1/L)` in slot 1), `‖T_ψ(f_1,f_2)‖_1 ≤ C
  ‖ψ‖_{C^20} L^{-s} ‖u_1‖_2 ‖u_2‖_2`. -/
def MonoGlobal77 (r A B C s : ℝ) : Prop :=
  ∀ ψ : ℝ → ℝ, ContDiff ℝ ∞ ψ → tsupport ψ ⊆ Icc A B → ∀ L : ℝ, 1 ≤ L →
    ∀ u₁ u₂ : ℝ × ℝ → ℂ, Measurable u₁ → Measurable u₂ →
      eLpNorm u₁ 2 volume ≠ ⊤ → eLpNorm u₂ 2 volume ≠ ⊤ →
      eLpNorm (monoT r ψ (monoP 0 monoKPsiA L u₁) (monoP 1 monoKPhi L u₂)) 1 volume
          ≤ ENNReal.ofReal (C * monoC20 ψ * L ^ (-s)) * (eLpNorm u₁ 2 volume * eLpNorm u₂ 2
            volume) ∧
      eLpNorm (monoT r ψ (monoP 0 monoKPhi (L / 2) u₁) (monoP 1 monoKPsiA L u₂)) 1 volume
          ≤ ENNReal.ofReal (C * monoC20 ψ * L ^ (-s)) * (eLpNorm u₁ 2 volume * eLpNorm u₂ 2 volume)

end

