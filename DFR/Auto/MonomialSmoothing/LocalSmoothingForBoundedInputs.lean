/-- The properties of a localized piece `u_{j,m}` used in Section 6. -/
structure MonoGoodPiece (j : Fin 2) (h M E1 Ω Λ : ℝ) (m : ℤ × ℤ) (G : ℝ × ℝ → ℂ) : Prop where
  meas : Measurable G
  bdd : ∀ z, ‖G z‖ ≤ M
  fibInt : ∀ p, Integrable (monoFib j G p) volume
  fibZero : ∀ p, 3 / 4 ≤ |p / h - monoMPas j m| → monoFib j G p = 0
  fibL2 : ∀ p, ∫⁻ a, ‖monoFib j G p a‖ₑ ^ 2 ≤ ENNReal.ofReal E1
  fibFT : ∀ p ξ, Ω < |ξ| → 𝓕 (monoFib j G p) ξ = 0
  lip : ∀ z a, ‖G (z + monoEj j a) - G z‖ ≤ Λ * |a|

theorem monoPas_add_E (j : Fin 2) (z : ℝ × ℝ) (a : ℝ) : monoPas j (z + monoEj j a) = monoPas j z
  := by
  fin_cases j <;> simp [monoPas, monoEj, monoPt]

theorem monoAct_add_E (j : Fin 2) (z : ℝ × ℝ) (a : ℝ) :
    monoAct j (z + monoEj j a) = monoAct j z + a := by
  fin_cases j <;> simp [monoAct, monoEj, monoPt]

theorem MonoGoodPiece.monoE_ne_top {j : Fin 2} {h M E1 Ω Λ : ℝ} {m : ℤ × ℤ} {G : ℝ × ℝ → ℂ}
    (hG : MonoGoodPiece j h M E1 Ω Λ m G) (p : ℝ) : monoE (monoFib j G p) ≠ ⊤ := by
  have h2 := memLp_two_of_bdd (hG.fibInt p) (fun _ => hG.bdd _)
  rw [monoE_eq (hG.fibInt p) h2]; exact lintegral_enorm_sq_ne_top h2

/-- The three families: `χ_m G_♯`, `χ_m G_♭`, `χ_m G`. -/
def monoVSharp (j : Fin 2) (h R ρ : ℝ) (m : ℤ × ℤ) (G : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℂ :=
  (monoChiM h m z : ℂ) * monoSharp2 j R ρ G z

def monoVFlat (j : Fin 2) (h R ρ : ℝ) (m : ℤ × ℤ) (G : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℂ :=
  (monoChiM h m z : ℂ) * monoFlat2 j R ρ G z

def monoVWhole (h : ℝ) (m : ℤ × ℤ) (G : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℂ := (monoChiM h m z : ℂ) * G z

theorem measurable_chiM_c (h : ℝ) (m : ℤ × ℤ) : Measurable fun z => (monoChiM h m z : ℂ) :=
  Complex.measurable_ofReal.comp (mloc_ChiM_contDiff h m).continuous.measurable

section
variable {j : Fin 2} {h M E1 Ω Λ R ρ : ℝ} {m : ℤ × ℤ} {G : ℝ × ℝ → ℂ}

theorem measurable_monoVSharp (hG : MonoGoodPiece j h M E1 Ω Λ m G) (hR : 0 < R) (hρ : 0 < ρ) :
    Measurable (monoVSharp j h R ρ m G) :=
  (measurable_chiM_c h m).mul (measurable_monoSharp2 j hR hρ hG.meas hG.fibInt hG.monoE_ne_top)

theorem measurable_monoVFlat (hG : MonoGoodPiece j h M E1 Ω Λ m G) (hR : 0 < R) (hρ : 0 < ρ) :
    Measurable (monoVFlat j h R ρ m G) :=
  (measurable_chiM_c h m).mul (hG.meas.sub
    (measurable_monoSharp2 j hR hρ hG.meas hG.fibInt hG.monoE_ne_top))

theorem measurable_monoVWhole (hG : MonoGoodPiece j h M E1 Ω Λ m G) :
    Measurable (monoVWhole h m G) := (measurable_chiM_c h m).mul hG.meas

theorem support_chiM_mul {F : ℝ × ℝ → ℂ} {z : ℝ × ℝ} (hh : 0 < h)
    (hz : (monoChiM h m z : ℂ) * F z ≠ 0) :
    |z.1 - h * m.1| ≤ 3 / 2 * h ∧ |z.2 - h * m.2| ≤ 3 / 2 * h := by
  have hχ : monoChiM h m z ≠ 0 := by intro h0; apply hz; simp [h0]
  obtain ⟨h1, h2⟩ := mloc_ChiM_ne_zero hχ
  have e : ∀ x : ℝ, ∀ k : ℤ, |x / h - k| < 3 / 2 → |x - h * k| ≤ 3 / 2 * h := by
    intro x k hk
    have : x - h * k = h * (x / h - k) := by field_simp
    rw [this, abs_mul, abs_of_pos hh]; nlinarith
  exact ⟨e _ _ h1, e _ _ h2⟩

theorem norm_chiM_mul_le {F : ℝ × ℝ → ℂ} {B : ℝ} (hF : ∀ z, ‖F z‖ ≤ B) (z : ℝ × ℝ) :
    ‖(monoChiM h m z : ℂ) * F z‖ ≤ B := by
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (mloc_ChiM_nonneg _ _ _)]
  calc monoChiM h m z * ‖F z‖ ≤ 1 * ‖F z‖ :=
        mul_le_mul_of_nonneg_right (mloc_ChiM_le_one _ _ _) (norm_nonneg _)
    _ ≤ B := by rw [one_mul]; exact hF z

/-- Lipschitz bound for `χ_m F` in the active coordinate. -/
theorem lip_chiM_mul {Cχ : ℝ} (hCχ : ∀ z a, |monoChiM h m (z + monoEj j a) - monoChiM h m z| ≤ Cχ
  / h * |a|)
    {F : ℝ × ℝ → ℂ} {B Λ' : ℝ} (hF : ∀ z, ‖F z‖ ≤ B) (hFl : ∀ z a, ‖F (z + monoEj j a) - F z‖ ≤ Λ'
      * |a|)
    (z : ℝ × ℝ) (a : ℝ) :
    ‖(monoChiM h m (z + monoEj j a) : ℂ) * F (z + monoEj j a) - (monoChiM h m z : ℂ) * F z‖
      ≤ (Cχ / h * B + Λ') * |a| := by
  have e : (monoChiM h m (z + monoEj j a) : ℂ) * F (z + monoEj j a) - (monoChiM h m z : ℂ) * F z
      = ((monoChiM h m (z + monoEj j a) - monoChiM h m z : ℝ) : ℂ) * F (z + monoEj j a)
        + (monoChiM h m z : ℂ) * (F (z + monoEj j a) - F z) := by push_cast; ring
  rw [e]
  refine (norm_add_le _ _).trans ?_
  rw [norm_mul, norm_mul, Complex.norm_real, Complex.norm_real, Real.norm_eq_abs, Real.norm_eq_abs,
    abs_of_nonneg (mloc_ChiM_nonneg h m z)]
  have h1 := hCχ z a
  have hB0 : 0 ≤ B := (norm_nonneg _).trans (hF z)
  have h2 : monoChiM h m z * ‖F (z + monoEj j a) - F z‖ ≤ Λ' * |a| :=
    (mul_le_of_le_one_left (norm_nonneg _) (mloc_ChiM_le_one h m z)).trans (hFl z a)
  have h3 : |monoChiM h m (z + monoEj j a) - monoChiM h m z| * ‖F (z + monoEj j a)‖
      ≤ Cχ / h * |a| * B := mul_le_mul h1 (hF _) (norm_nonneg _) ((abs_nonneg _).trans h1)
  nlinarith

theorem monoSharp2_bdd (hG : MonoGoodPiece j h M E1 Ω Λ m G) (hR : 0 < R) (hρ : 0 < ρ)
    (z : ℝ × ℝ) : ‖monoSharp2 j R ρ G z‖ ≤ 9 / ρ * ((∫ u, ‖monoKappa u‖) * M) :=
  norm_monoSharp_le' hR hρ (hG.fibInt _) (fun _ => hG.bdd _) _

theorem monoFlat2_bdd (hG : MonoGoodPiece j h M E1 Ω Λ m G) (hR : 0 < R) (hρ : 0 < ρ)
    (z : ℝ × ℝ) : ‖monoFlat2 j R ρ G z‖ ≤ M + 9 / ρ * ((∫ u, ‖monoKappa u‖) * M) :=
  (norm_sub_le _ _).trans (add_le_add (hG.bdd z) (monoSharp2_bdd hG hR hρ z))

/-- The Lipschitz constant of the sharp part. -/
def monoLipS (R ρ Ω M : ℝ) : ℝ :=
  9 / ρ * ((R * (∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖) + 2 * π * (Ω + R) * (∫ u, ‖monoKappa u‖)) * M)

theorem monoSharp2_lip (hG : MonoGoodPiece j h M E1 Ω Λ m G) (hR : 1 ≤ R) (hρ : 0 < ρ)
    (hΩ0 : 0 ≤ Ω) (z : ℝ × ℝ) (a : ℝ) :
    ‖monoSharp2 j R ρ G (z + monoEj j a) - monoSharp2 j R ρ G z‖ ≤ monoLipS R ρ Ω M * |a| := by
  unfold monoSharp2
  rw [monoPas_add_E, monoAct_add_E]
  have h := monoSharp_lip hR hρ (hG.fibInt (monoPas j z)) (fun _ => hG.bdd _) hΩ0
    (hG.fibFT _) (monoAct j z) (monoAct j z + a)
  rw [show monoAct j z + a - monoAct j z = a by ring] at h
  refine h.trans (le_of_eq ?_)
  unfold monoLipS; ring

theorem monoFlat2_lip (hG : MonoGoodPiece j h M E1 Ω Λ m G) (hR : 1 ≤ R) (hρ : 0 < ρ)
    (hΩ0 : 0 ≤ Ω) (z : ℝ × ℝ) (a : ℝ) :
    ‖monoFlat2 j R ρ G (z + monoEj j a) - monoFlat2 j R ρ G z‖ ≤ (Λ + monoLipS R ρ Ω M) * |a| := by
  unfold monoFlat2
  have e : G (z + monoEj j a) - monoSharp2 j R ρ G (z + monoEj j a) - (G z - monoSharp2 j R ρ G z)
      = (G (z + monoEj j a) - G z) - (monoSharp2 j R ρ G (z + monoEj j a) - monoSharp2 j R ρ G z)
        := by
    ring
  rw [e]
  refine (norm_sub_le _ _).trans ?_
  rw [add_mul]
  exact add_le_add (hG.lip z a) (monoSharp2_lip hG hR hρ hΩ0 z a)

end

end

end Auto

