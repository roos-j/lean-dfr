noncomputable section

/-- The stationary set of the pair of cubes `(m, n)`, with frequency functions `a` (first input,
depending on `y`) and `b` (second input, depending on `x`). -/
def mssE (r A B h C0 S : ℝ) (D : Set (ℝ × ℝ)) (m n : ℤ × ℤ) (a b : ℝ → ℝ) :
    Set ((ℝ × ℝ) × ℝ) :=
  {p | p.1 ∈ D ∧ p.2 ∈ Icc A B ∧ |a p.1.2 + monoq r p.2 * b p.1.1| ≤ 2 * S ∧
    (p.1.1 + p.2, p.1.2) ∈ mssBox h C0 m ∧ (p.1.1, p.1.2 + monoQ r p.2) ∈ mssBox h C0 n}

theorem mss_measurableSet_E {r : ℝ} (hr : 0 < r) (A B h C0 S : ℝ) {D : Set (ℝ × ℝ)}
    (hD : MeasurableSet D) (m n : ℤ × ℤ) {a b : ℝ → ℝ} (ha : Measurable a) (hb : Measurable b) :
    MeasurableSet (mssE r A B h C0 S D m n a b) := by
  have e : mssE r A B h C0 S D m n a b = (Prod.fst ⁻¹' D) ∩ ((Prod.snd ⁻¹' Icc A B) ∩
      ({p : (ℝ × ℝ) × ℝ | |a p.1.2 + monoq r p.2 * b p.1.1| ≤ 2 * S} ∩
      (((fun p : (ℝ × ℝ) × ℝ => (p.1.1 + p.2, p.1.2)) ⁻¹' mssBox h C0 m) ∩
      ((fun p : (ℝ × ℝ) × ℝ => (p.1.1, p.1.2 + monoQ r p.2)) ⁻¹' mssBox h C0 n)))) := by
    ext p; rfl
  rw [e]
  have hm : Measurable fun p : (ℝ × ℝ) × ℝ => |a p.1.2 + monoq r p.2 * b p.1.1| :=
    continuous_abs.measurable.comp ((ha.comp (measurable_snd.comp measurable_fst)).add
      (((mss_measurable_monoq r).comp measurable_snd).mul
        (hb.comp (measurable_fst.comp measurable_fst))))
  exact (measurable_fst hD).inter ((measurable_snd measurableSet_Icc).inter
    ((measurableSet_le hm measurable_const).inter
      ((measurable_monoShift1 (mss_measurableSet_box h C0 m)).inter
        (measurable_monoShift2 hr (mss_measurableSet_box h C0 n)))))

theorem mss_slice_subset (r A B h C0 S : ℝ) (D : Set (ℝ × ℝ)) (m n : ℤ × ℤ) (a b : ℝ → ℝ)
    (z : ℝ × ℝ) : Prod.mk z ⁻¹' mssE r A B h C0 S D m n a b ⊆ Icc A B :=
  fun _ ht => ht.2.1

theorem mss_stat_le {r A B h C0 S : ℝ} (hr : 1 < r) {D : Set (ℝ × ℝ)} (hD : MeasurableSet D)
    {ψ : ℝ → ℝ} (hψs : tsupport ψ ⊆ Icc A B) (hψ1 : ∀ t, |ψ t| ≤ 1)
    {f g : ℝ × ℝ → ℂ} {m n : ℤ × ℤ} (hf : ∀ w, f w ≠ 0 → w ∈ mssBox h C0 m)
    (hg : ∀ w, g w ≠ 0 → w ∈ mssBox h C0 n) (hf1 : ∀ w, ‖f w‖ ≤ 1) (hg1 : ∀ w, ‖g w‖ ≤ 1)
    {a b : ℝ → ℝ} (ha : Measurable a) (hb : Measurable b) {z : ℝ × ℝ} (hz : z ∈ D)
    (hAB : A ≤ B) :
    (∫ t in A..B, Set.indicator {t | |a z.2 + monoq r t * b z.1| ≤ 2 * S}
        (fun t => ‖(ψ t : ℂ) * (f (z.1 + t, z.2) * g (z.1, z.2 + monoQ r t))‖) t)
      ≤ (volume (Prod.mk z ⁻¹' mssE r A B h C0 S D m n a b)).toReal := by
  set E := Prod.mk z ⁻¹' mssE r A B h C0 S D m n a b
  have hEm : MeasurableSet E :=
    measurable_prodMk_left (mss_measurableSet_E (by linarith) A B h C0 S hD m n ha hb)
  have hfin : volume E ≠ ⊤ :=
    ((measure_mono (mss_slice_subset r A B h C0 S D m n a b z)).trans_lt measure_Icc_lt_top).ne
  have hint : Integrable (E.indicator fun _ => (1 : ℝ)) volume :=
    (integrable_indicator_iff hEm).2 (integrableOn_const hfin)
  have hpt : ∀ t, Set.indicator {t | |a z.2 + monoq r t * b z.1| ≤ 2 * S}
      (fun t => ‖(ψ t : ℂ) * (f (z.1 + t, z.2) * g (z.1, z.2 + monoQ r t))‖) t
      ≤ E.indicator (fun _ => (1 : ℝ)) t := by
    intro t
    by_cases hst : t ∈ {t | |a z.2 + monoq r t * b z.1| ≤ 2 * S}
    · rw [indicator_of_mem hst]
      by_cases htE : t ∈ E
      · rw [indicator_of_mem htE]
        rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs]
        have := hψ1 t
        have h1 := hf1 (z.1 + t, z.2)
        have h2 := hg1 (z.1, z.2 + monoQ r t)
        calc |ψ t| * (‖f (z.1 + t, z.2)‖ * ‖g (z.1, z.2 + monoQ r t)‖) ≤ 1 * (1 * 1) := by
              gcongr
          _ = 1 := by ring
      · rw [indicator_of_notMem htE]
        have hzero : (ψ t : ℂ) * (f (z.1 + t, z.2) * g (z.1, z.2 + monoQ r t)) = 0 := by
          by_cases ht : t ∈ Icc A B
          · by_cases h1 : (z.1 + t, z.2) ∈ mssBox h C0 m
            · by_cases h2 : (z.1, z.2 + monoQ r t) ∈ mssBox h C0 n
              · exact absurd ⟨hz, ht, hst, h1, h2⟩ htE
              · have : g (z.1, z.2 + monoQ r t) = 0 := by
                  by_contra hne; exact h2 (hg _ hne)
                simp [this]
            · have : f (z.1 + t, z.2) = 0 := by
                by_contra hne; exact h1 (hf _ hne)
              simp [this]
          · simp [mss_psi_zero_of_not_mem hψs ht]
        rw [hzero, norm_zero]
    · rw [indicator_of_notMem hst]
      exact indicator_nonneg (fun _ _ => zero_le_one) t
  rw [intervalIntegral.integral_of_le hAB]
  calc (∫ t in Ioc A B, Set.indicator {t | |a z.2 + monoq r t * b z.1| ≤ 2 * S}
        (fun t => ‖(ψ t : ℂ) * (f (z.1 + t, z.2) * g (z.1, z.2 + monoQ r t))‖) t)
      ≤ ∫ t in Ioc A B, E.indicator (fun _ => (1 : ℝ)) t :=
        integral_mono_of_nonneg (Eventually.of_forall fun t =>
          indicator_nonneg (fun _ _ => norm_nonneg _) t) hint.integrableOn
          (Eventually.of_forall hpt)
    _ ≤ ∫ t, E.indicator (fun _ => (1 : ℝ)) t :=
        setIntegral_le_integral hint (Eventually.of_forall fun t =>
          indicator_nonneg (fun _ _ => zero_le_one) t)
    _ = (volume E).toReal := by
        exact integral_indicator_one hEm

end

end Auto

