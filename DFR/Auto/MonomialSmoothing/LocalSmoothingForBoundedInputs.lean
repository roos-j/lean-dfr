theorem monoPhiE_eq_zero' {x : ℝ} (hx : 4 < |x|) : monoPhiE x = 0 := monoPhiE_eq_zero hx.le

theorem monoPsiE_eq_zero_large {x : ℝ} (hx : 4 < |x|) : monoPsiE x = 0 := by
  have h1 : monoPhi (x / 2) = 0 := monoPhi_eq_zero (by rw [abs_div, abs_two]; linarith)
  have h2 : monoPhi (4 * x) = 0 := monoPhi_eq_zero (by rw [abs_mul]; norm_num; linarith)
  simp [monoPsiE, h1, h2]

theorem monoPsiE_eq_zero_small {x : ℝ} (hx : |x| < 1 / 4) : monoPsiE x = 0 := by
  have h1 : monoPhi (x / 2) = 1 := monoPhi_eq_one (by rw [abs_div, abs_two]; linarith)
  have h2 : monoPhi (4 * x) = 1 := monoPhi_eq_one (by rw [abs_mul]; norm_num; linarith)
  simp [monoPsiE, h1, h2]

/-- The localized pieces `u_{j,m} = ϑ̃(D_j/L)(η_m f)` are good pieces. -/
theorem monoUjm_good (j : Fin 2) {ϑ : ℝ → ℝ} (hs : ContDiff ℝ ∞ ϑ) (hc : HasCompactSupport ϑ)
    (hvan : ∀ x, 4 < |x| → ϑ x = 0) {L h : ℝ} (hL : 0 < L) (hh : 0 < h) (m : ℤ × ℤ)
    {f : ℝ × ℝ → ℂ} (hf : Measurable f) {A : ℝ} (hA : ∀ z, ‖f z‖ ≤ A) :
    MonoGoodPiece j h ((∫ s, ‖monoMultK hs hc s‖) * A)
      ((∫ s, ‖monoMultK hs hc s‖) ^ 2 * (A ^ 2 * (3 / 2 * h))) (4 * L)
      (L * (∫ s, ‖deriv (monoMultK hs hc : ℝ → ℂ) s‖) * A) m (monoUjm j (monoMultK hs hc) L h m f)
        where
  meas := measurable_monoUjm j _ L h m hf
  bdd := norm_monoUjm_le j _ hL h m hA
  fibInt := integrable_monoUjm_fib j _ hL hh m hf hA
  fibZero := fun p hp => monoUjm_fib_eq_zero j _ L hh m hp
  fibL2 := lintegral_monoUjm_fib_sq j _ hL hh m hf hA
  fibFT := fun p ξ hξ => by
    rw [monoUjm, mloc_P_fib_fourier j hs hc hL (integrable_monoEtaF_fib hh hf hA p)]
    rw [hvan (ξ / L) (by
      rw [abs_div, abs_of_pos hL, lt_div_iff₀ hL];
      linarith), Complex.ofReal_zero,
      zero_mul]
  lip := fun z a => mloc_P_lip j _ hL (measurable_monoEtaF hf) (fun z => norm_monoEtaF_le hA z) z a

/-- The annular pieces have fiber frequencies `≥ L/4`. -/
theorem monoUjm_psiE_low (j : Fin 2) {L h : ℝ} (hL : 0 < L) (hh : 0 < h) (m : ℤ × ℤ)
    {f : ℝ × ℝ → ℂ} (hf : Measurable f) {A : ℝ} (hA : ∀ z, ‖f z‖ ≤ A) (p ξ : ℝ)
    (hξ : |ξ| < L / 4) : 𝓕 (monoFib j (monoUjm j monoKPsiE L h m f) p) ξ = 0 := by
  rw [monoUjm, show monoKPsiE = monoMultK monoPsiE_contDiff monoPsiE_hasCompactSupport from rfl,
    mloc_P_fib_fourier j _ _ hL (integrable_monoEtaF_fib hh hf hA p)]
  rw [monoPsiE_eq_zero_small (by rw [abs_div, abs_of_pos hL, div_lt_iff₀ hL]; linarith),
    Complex.ofReal_zero, zero_mul]

end

