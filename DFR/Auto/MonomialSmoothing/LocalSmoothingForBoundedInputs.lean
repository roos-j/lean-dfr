/-! ### The hypotheses of Lemma 5.1 for the decomposed families ((6.6)-(6.8)) -/

/-- `W₀ = ‖β̂‖_1`. -/
def monoW0 : ℝ := ∫ ξ, ‖𝓕 (monoBetaFib 1 0 1) ξ‖

theorem integral_norm_fourier_monoBetaFib {h : ℝ} (hh : 0 < h) (a c : ℝ) :
    ∫ ξ, ‖𝓕 (monoBetaFib h a c) ξ‖ = |c| * monoW0 := by
  simp_rw [fourier_monoBetaFib hh, norm_mul, Circle.norm_coe, mul_one]
  rw [integral_const_mul, Measure.integral_comp_mul_left (fun ξ => ‖𝓕 (monoBetaFib 1 0 1) ξ‖) h,
    abs_inv, abs_of_pos hh, smul_eq_mul, ← mul_assoc, monoW0]
  congr 1
  simp only [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hh]
  field_simp

theorem monoW0_nonneg : 0 ≤ monoW0 := integral_nonneg fun _ => norm_nonneg _

/-- The mean value theorem in the form used for Lipschitz bounds. -/
theorem norm_sub_le_of_deriv {f f' : ℝ → ℂ} (hf : ∀ x, HasDerivAt f (f' x) x) {C : ℝ}
    (hC : ∀ x, ‖f' x‖ ≤ C) (a b : ℝ) : ‖f b - f a‖ ≤ C * |b - a| := by
  have h := convex_univ.norm_image_sub_le_of_norm_hasDerivWithin_le
    (fun x _ => (hf x).hasDerivWithinAt) (fun x _ => hC x) (mem_univ a) (mem_univ b)
  simpa [Real.norm_eq_abs] using h

/-- A piece is Lipschitz with constant `(R ‖κ'‖_1 + 2π(Ω + R) ‖κ‖_1) M` when `f̂` vanishes for
`|ξ| > Ω`. -/
theorem monoPiece_lip {R : ℝ} (hR : 1 ≤ R) (n : ℤ) {F : ℝ → ℂ} (hF : Integrable F volume)
    {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) {Ω : ℝ} (hΩ0 : 0 ≤ Ω) (hΩ : ∀ ξ, Ω < |ξ| → 𝓕 F ξ = 0) (a b : ℝ) :
    ‖monoPiece R n F b - monoPiece R n F a‖
      ≤ (R * (∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖) + 2 * π * (Ω + R) * (∫ u, ‖monoKappa u‖)) * M
        * |b - a| := by
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  by_cases hn : Ω + R < |(n : ℝ) * R|
  · rw [monoPiece_eq_zero_of_large hR n hF hM hΩ hn]; simp only [Pi.zero_apply, sub_self, norm_zero]
    have : 0 ≤ R * (∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖) + 2 * π * (Ω + R) * (∫ u, ‖monoKappa u‖)
      := by
      have : 0 ≤ ∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖ := integral_nonneg fun u => norm_nonneg _
      have : 0 ≤ ∫ u, ‖monoKappa u‖ := integral_nonneg fun u => norm_nonneg _
      have : 0 ≤ R := by linarith
      positivity
    positivity
  · push Not at hn
    refine norm_sub_le_of_deriv (hasDerivAt_monoPiece hR n hF.1 hM) (fun x => ?_) a b
    refine (norm_deriv_monoPiece_le hR n hM x).trans ?_
    gcongr

/-- **The Lipschitz bound in (6.8) for the sharp part**. -/
theorem monoSharp_lip {R ρ : ℝ} (hR : 1 ≤ R) (hρ : 0 < ρ) {F : ℝ → ℂ} (hF : Integrable F volume)
    {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) {Ω : ℝ} (hΩ0 : 0 ≤ Ω) (hΩ : ∀ ξ, Ω < |ξ| → 𝓕 F ξ = 0) (a b : ℝ) :
    ‖monoSharp R ρ F b - monoSharp R ρ F a‖
      ≤ 9 / ρ * ((R * (∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖) + 2 * π * (Ω + R) *
          (∫ u, ‖monoKappa u‖)) * M * |b - a|) := by
  have hR0 : 0 < R := by linarith
  have hE : monoE F ≠ ⊤ := by
    rw [monoE_eq hF (memLp_two_of_bdd hF hM)];
    exact lintegral_enorm_sq_ne_top (memLp_two_of_bdd hF hM)
  unfold monoSharp
  rw [← Finset.sum_sub_distrib]
  refine (norm_sum_le _ _).trans ?_
  calc ∑ n ∈ monoSel R ρ F, ‖monoPiece R n F b - monoPiece R n F a‖
      ≤ ∑ n ∈ monoSel R ρ F, (R * (∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖) + 2 * π * (Ω + R) *
          (∫ u, ‖monoKappa u‖)) * M * |b - a| :=
        Finset.sum_le_sum fun n _ => monoPiece_lip hR n hF hM hΩ0 hΩ a b
    _ = (monoSel R ρ F).card * ((R * (∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖) + 2 * π * (Ω + R) *
          (∫ u, ‖monoKappa u‖)) * M * |b - a|) := by rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ _ := by
        gcongr
        · have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
          have : 0 ≤ ∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖ := integral_nonneg fun u => norm_nonneg _
          have : 0 ≤ ∫ u, ‖monoKappa u‖ := integral_nonneg fun u => norm_nonneg _
          positivity
        · exact card_monoSel_le hR0 hρ hF hE

end

end Auto

