theorem mss_Hd_norm_le {r A B C0 R : ℝ} (hr : 1 < r) (hA : 0 < A) (hC0 : 0 ≤ C0) (hR : 0 ≤ R)
    {ψ : ℝ → ℝ} (hψ1 : ∀ t, |ψ t| ≤ 1) (hdψ1 : ∀ t, |deriv ψ t| ≤ 1)
    {f g : ℝ × ℝ → ℂ} {Du Dv : ℝ → ℂ} (hf1 : ∀ w, ‖f w‖ ≤ 1) (hg1 : ∀ w, ‖g w‖ ≤ 1)
    (hDub : ∀ x, ‖Du x‖ ≤ C0 * R) (hDvb : ∀ y, ‖Dv y‖ ≤ C0 * R) (z : ℝ × ℝ) {t : ℝ}
    (ht : t ∈ Icc A B) :
    ‖mssHd r ψ f g Du Dv z t‖ ≤ 1 + C0 * R + C0 * R * monoq r B := by
  have hq0 : 0 ≤ monoq r t := mss_monoq_nonneg hr.le (hA.le.trans ht.1)
  have hqB : monoq r t ≤ monoq r B := mss_monoq_mono hr.le (hA.le.trans ht.1) ht.2
  have hCR : 0 ≤ C0 * R := mul_nonneg hC0 hR
  unfold mssHd
  have e1 := hψ1 t
  have e2 := hdψ1 t
  have f1 := hf1 (z.1 + t, z.2)
  have g1 := hg1 (z.1, z.2 + monoQ r t)
  have d1 := hDub (z.1 + t)
  have d2 := hDvb (z.2 + monoQ r t)
  have t1 : ‖((deriv ψ t : ℝ) : ℂ) * (f (z.1 + t, z.2) * g (z.1, z.2 + monoQ r t))‖ ≤ 1 := by
    rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs]
    calc |deriv ψ t| * (‖f (z.1 + t, z.2)‖ * ‖g (z.1, z.2 + monoQ r t)‖) ≤ 1 * (1 * 1) := by
          gcongr
      _ = 1 := by ring
  have t2' : ‖Du (z.1 + t) * g (z.1, z.2 + monoQ r t) +
      f (z.1 + t, z.2) * ((monoq r t : ℂ) * Dv (z.2 + monoQ r t))‖ ≤
      C0 * R + monoq r t * (C0 * R) := by
    refine (norm_add_le _ _).trans ?_
    simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs]
    rw [abs_of_nonneg hq0]
    calc ‖Du (z.1 + t)‖ * ‖g (z.1, z.2 + monoQ r t)‖ +
          ‖f (z.1 + t, z.2)‖ * (monoq r t * ‖Dv (z.2 + monoQ r t)‖)
        ≤ C0 * R * 1 + 1 * (monoq r t * (C0 * R)) := by gcongr
      _ = C0 * R + monoq r t * (C0 * R) := by ring
  have t2 : ‖(ψ t : ℂ) * (Du (z.1 + t) * g (z.1, z.2 + monoQ r t) +
      f (z.1 + t, z.2) * ((monoq r t : ℂ) * Dv (z.2 + monoQ r t)))‖ ≤
      C0 * R + monoq r t * (C0 * R) := by
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
    calc |ψ t| * _ ≤ 1 * (C0 * R + monoq r t * (C0 * R)) := by gcongr
      _ = _ := by ring
  refine (norm_add_le _ _).trans ?_
  nlinarith

theorem mss_Hd_eq_zero {r h C0 : ℝ} (ψ : ℝ → ℝ) {m n : ℤ × ℤ}
    {f g : ℝ × ℝ → ℂ} {Du Dv : ℝ → ℂ} (hf : ∀ w, f w ≠ 0 → w ∈ mssBox h C0 m)
    (hg : ∀ w, g w ≠ 0 → w ∈ mssBox h C0 n) (z : ℝ × ℝ)
    (hDu : ∀ x, HasDerivAt (fun x => f (x, z.2)) (Du x) x)
    (hDv : ∀ y, HasDerivAt (fun y => g (z.1, y)) (Dv y) y) {t : ℝ}
    (hmn : (z.1 + t, z.2) ∉ mssBox h C0 m ∨ (z.1, z.2 + monoQ r t) ∉ mssBox h C0 n) :
    mssHd r ψ f g Du Dv z t = 0 := by
  unfold mssHd
  rcases hmn with h1 | h2
  · have a1 : f (z.1 + t, z.2) = 0 := by by_contra hne; exact h1 (hf _ hne)
    have a2 : Du (z.1 + t) = 0 := mss_deriv_eq_zero_x hf (hDu (z.1 + t)) h1
    simp [a1, a2]
  · have a1 : g (z.1, z.2 + monoQ r t) = 0 := by by_contra hne; exact h2 (hg _ hne)
    have a2 : Dv (z.2 + monoQ r t) = 0 := mss_deriv_eq_zero_y hg (hDv (z.2 + monoQ r t)) h2
    simp [a1, a2]

theorem mss_Hd_sum_le {r A B h C0 R : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A ≤ B) (hh : 0 < h)
    (hC0 : 0 ≤ C0) (hR : 0 ≤ R) {ψ : ℝ → ℝ} (hψ : ContDiff ℝ ∞ ψ) (hψ1 : ∀ t, |ψ t| ≤ 1)
    (hdψ1 : ∀ t, |deriv ψ t| ≤ 1) (M₁ M₂ : Finset (ℤ × ℤ)) (f g : ℤ × ℤ → ℝ × ℝ → ℂ)
    (Du Dv : ℤ × ℤ → ℝ → ℂ) (z : ℝ × ℝ)
    (hf : ∀ m w, f m w ≠ 0 → w ∈ mssBox h C0 m) (hg : ∀ n w, g n w ≠ 0 → w ∈ mssBox h C0 n)
    (hf1 : ∀ m w, ‖f m w‖ ≤ 1) (hg1 : ∀ n w, ‖g n w‖ ≤ 1)
    (hDu : ∀ m x, HasDerivAt (fun x => f m (x, z.2)) (Du m x) x) (hDuc : ∀ m, Continuous (Du m))
    (hDub : ∀ m x, ‖Du m x‖ ≤ C0 * R)
    (hDv : ∀ n y, HasDerivAt (fun y => g n (z.1, y)) (Dv n y) y) (hDvc : ∀ n, Continuous (Dv n))
    (hDvb : ∀ n y, ‖Dv n y‖ ≤ C0 * R) :
    ∑ m ∈ M₁, ∑ n ∈ M₂, ∫ t in A..B, ‖mssHd r ψ (f m) (g n) (Du m) (Dv n) z t‖
      ≤ (B - A) * ((2 * C0 + 1) ^ 2 * (2 * C0 + 1) ^ 2 * (1 + C0 * R + C0 * R * monoq r B)) := by
  set Kt := 1 + C0 * R + C0 * R * monoq r B
  have hc : ∀ m n, Continuous fun t => ‖mssHd r ψ (f m) (g n) (Du m) (Dv n) z t‖ := fun m n =>
    (mss_continuous_Hd hr hψ (hDu m) (hDuc m) (hDv n) (hDvc n)).norm
  have e1 : ∑ m ∈ M₁, ∑ n ∈ M₂, ∫ t in A..B, ‖mssHd r ψ (f m) (g n) (Du m) (Dv n) z t‖ =
      ∫ t in A..B, ∑ m ∈ M₁, ∑ n ∈ M₂, ‖mssHd r ψ (f m) (g n) (Du m) (Dv n) z t‖ := by
    rw [intervalIntegral.integral_finsetSum]
    · refine Finset.sum_congr rfl fun m _ => ?_
      rw [intervalIntegral.integral_finsetSum]
      intro n _; exact (hc m n).intervalIntegrable _ _
    · intro m _
      exact (continuous_finsetSum _ fun n _ => hc m n).intervalIntegrable _ _
  rw [e1]
  have hpt : ∀ t ∈ Icc A B, ∑ m ∈ M₁, ∑ n ∈ M₂, ‖mssHd r ψ (f m) (g n) (Du m) (Dv n) z t‖ ≤
      (2 * C0 + 1) ^ 2 * (2 * C0 + 1) ^ 2 * Kt := by
    intro t ht
    have hK : 0 ≤ Kt := by
      have := mss_monoq_nonneg hr.le (hA.le.trans hAB); positivity
    set P₁ := M₁.filter fun m => (z.1 + t, z.2) ∈ mssBox h C0 m
    set P₂ := M₂.filter fun n => (z.1, z.2 + monoQ r t) ∈ mssBox h C0 n
    have s1 : ∑ m ∈ M₁, ∑ n ∈ M₂, ‖mssHd r ψ (f m) (g n) (Du m) (Dv n) z t‖ =
        ∑ m ∈ P₁, ∑ n ∈ P₂, ‖mssHd r ψ (f m) (g n) (Du m) (Dv n) z t‖ := by
      rw [Finset.sum_filter_of_ne]
      · refine Finset.sum_congr rfl fun m _ => ?_
        rw [Finset.sum_filter_of_ne]
        intro n _ hne
        by_contra hn
        exact hne (by rw [mss_Hd_eq_zero ψ (hf m) (hg n) z (hDu m) (hDv n) (Or.inr hn), norm_zero])
      · intro m _ hne
        by_contra hm
        apply hne
        refine Finset.sum_eq_zero fun n _ => ?_
        rw [mss_Hd_eq_zero ψ (hf m) (hg n) z (hDu m) (hDv n) (Or.inl hm), norm_zero]
    rw [s1]
    have s2 : ∑ m ∈ P₁, ∑ n ∈ P₂, ‖mssHd r ψ (f m) (g n) (Du m) (Dv n) z t‖ ≤
        ∑ m ∈ P₁, ∑ n ∈ P₂, Kt :=
      Finset.sum_le_sum fun m _ => Finset.sum_le_sum fun n _ =>
        mss_Hd_norm_le hr hA hC0 hR hψ1 hdψ1 (hf1 m) (hg1 n) (hDub m) (hDvb n) z ht
    refine s2.trans ?_
    simp only [Finset.sum_const, nsmul_eq_mul]
    have c1 := mss_card_box hh hC0 M₁ (z.1 + t, z.2)
    have c2 := mss_card_box hh hC0 M₂ (z.1, z.2 + monoQ r t)
    calc (P₁.card : ℝ) * ((P₂.card : ℝ) * Kt) = (P₁.card : ℝ) * (P₂.card : ℝ) * Kt := by ring
      _ ≤ (2 * C0 + 1) ^ 2 * (2 * C0 + 1) ^ 2 * Kt := by gcongr
  refine (intervalIntegral.integral_mono_on hAB
    ((continuous_finsetSum _ fun m _ => continuous_finsetSum _ fun n _ => hc m
      n).intervalIntegrable _ _)
    intervalIntegrable_const hpt).trans (le_of_eq ?_)
  rw [intervalIntegral.integral_const, smul_eq_mul]

end

