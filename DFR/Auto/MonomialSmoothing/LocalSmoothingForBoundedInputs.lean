  (mloc_Eta_hasSum h z).summable

/-- **Partition of unity** `∑_m η_m = 1` (line 945). -/
theorem mloc_Eta_tsum (h : ℝ) (z : ℝ × ℝ) : ∑' m : ℤ × ℤ, monoEta h m z = 1 :=
  (mloc_Eta_hasSum h z).tsum_eq

/-! #### Smoothness and the Lipschitz bounds `|∇η_m|, |∇χ_m| ≲ 1/h` -/
theorem mloc_Eta_contDiff (h : ℝ) (m : ℤ × ℤ) : ContDiff ℝ ∞ (monoEta h m) := by
  unfold monoEta
  exact (smoothingPartitionCutoff_contDiff.comp ((contDiff_fst.div_const h).sub contDiff_const)).mul
    (smoothingPartitionCutoff_contDiff.comp ((contDiff_snd.div_const h).sub contDiff_const))

theorem mloc_Beta_contDiff : ContDiff ℝ ∞ monoBeta :=
  monoPhi_contDiff.comp ((contDiff_const.mul contDiff_id).div_const 3)

theorem mloc_ChiM_contDiff (h : ℝ) (m : ℤ × ℤ) : ContDiff ℝ ∞ (monoChiM h m) := by
  unfold monoChiM
  exact (mloc_Beta_contDiff.comp ((contDiff_fst.div_const h).sub contDiff_const)).mul
    (mloc_Beta_contDiff.comp ((contDiff_snd.div_const h).sub contDiff_const))

theorem mloc_theta_lip : ∃ K : ℝ, 0 ≤ K ∧ ∀ x y : ℝ,
    |smoothingPartitionCutoff x - smoothingPartitionCutoff y| ≤ K * |x - y| := by
  obtain ⟨C, hC⟩ := ContDiff.lipschitzWith_of_hasCompactSupport
    smoothingPartitionCutoff_hasCompactSupport smoothingPartitionCutoff_contDiff (by simp)
  refine ⟨C, C.2, fun x y => ?_⟩
  have := hC.dist_le_mul x y
  simpa [Real.dist_eq] using this

theorem mloc_beta_lip : ∃ K : ℝ, 0 ≤ K ∧ ∀ x y : ℝ, |monoBeta x - monoBeta y| ≤ K * |x - y| := by
  obtain ⟨C, hC⟩ := ContDiff.lipschitzWith_of_hasCompactSupport
    monoPhi_hasCompactSupport monoPhi_contDiff (by simp)
  refine ⟨C * (4 / 3), by positivity, fun x y => ?_⟩
  have := hC.dist_le_mul (4 * x / 3) (4 * y / 3)
  simp only [Real.dist_eq] at this
  have e : 4 * x / 3 - 4 * y / 3 = (4 / 3) * (x - y) := by ring
  rw [e, abs_mul, abs_of_pos (by norm_num : (0:ℝ) < 4 / 3)] at this
  simp only [monoBeta]
  nlinarith [abs_nonneg (x - y)]

theorem mloc_prod_lip {g : ℝ → ℝ} {K : ℝ} (hg0 : ∀ x, 0 ≤ g x) (hg1 : ∀ x, g x ≤ 1)
    (hg : ∀ x y, |g x - g y| ≤ K * |x - y|) {h : ℝ} (hh : 0 < h) (m : ℤ × ℤ) (j : Fin 2)
    (z : ℝ × ℝ) (a : ℝ) :
    |g ((z + monoEj j a).1 / h - m.1) * g ((z + monoEj j a).2 / h - m.2) -
      g (z.1 / h - m.1) * g (z.2 / h - m.2)| ≤ K / h * |a| := by
  have key : ∀ u v c : ℝ, |g ((u + a) / h - c) * g v - g (u / h - c) * g v| ≤ K / h * |a| := by
    intro u v c
    rw [← sub_mul, abs_mul, abs_of_nonneg (hg0 v)]
    have e : (u + a) / h - c - (u / h - c) = a / h := by ring
    have := hg ((u + a) / h - c) (u / h - c)
    rw [e, abs_div, abs_of_pos hh] at this
    calc _ ≤ |g ((u + a) / h - c) - g (u / h - c)| * 1 :=
          mul_le_mul_of_nonneg_left (hg1 v) (abs_nonneg _)
      _ ≤ K * (|a| / h) := by linarith
      _ = K / h * |a| := by ring
  fin_cases j
  · simpa [monoEj, monoPt] using key z.1 (z.2 / h - m.2) m.1
  · have := key z.2 (z.1 / h - m.1) m.2
    simp only [monoEj, monoPt, Fin.mk_one, one_ne_zero, ite_false, Prod.fst_add,
      Prod.snd_add,
      add_zero]
    rwa [mul_comm (g (z.1 / h - m.1)), mul_comm (g (z.1 / h - m.1))]

/-- The mean value bound for `η_m` in coordinate direction `j`. -/
theorem mloc_Eta_lip : ∃ C : ℝ, 0 ≤ C ∧ ∀ h : ℝ, 0 < h → ∀ (m : ℤ × ℤ) (j : Fin 2) (z : ℝ × ℝ)
    (a : ℝ), |monoEta h m (z + monoEj j a) - monoEta h m z| ≤ C / h * |a| := by
  obtain ⟨K, hK, hl⟩ := mloc_theta_lip
  exact ⟨K, hK, fun h hh m j z a =>
    mloc_prod_lip mloc_theta_nonneg mloc_theta_le_one hl hh m j z a⟩

/-- The mean value bound for `χ_m` in coordinate direction `j`. -/
theorem mloc_ChiM_lip : ∃ C : ℝ, 0 ≤ C ∧ ∀ h : ℝ, 0 < h → ∀ (m : ℤ × ℤ) (j : Fin 2) (z : ℝ × ℝ)
    (a : ℝ), |monoChiM h m (z + monoEj j a) - monoChiM h m z| ≤ C / h * |a| := by
  obtain ⟨K, hK, hl⟩ := mloc_beta_lip
  exact ⟨K, hK, fun h hh m j z a =>
    mloc_prod_lip mloc_beta_nonneg mloc_beta_le_one hl hh m j z a⟩

end

