        field_simp
    _ ≤ 2 ^ 9 * M₀ / (c * |k₂| * h) * 2 + 2 ^ 9 * M₀ * 2 := by
        rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
        have g1 : ∑ d ∈ Finset.range D, ((1 / 2 : ℝ) ^ 7) ^ d ≤ 2 :=
