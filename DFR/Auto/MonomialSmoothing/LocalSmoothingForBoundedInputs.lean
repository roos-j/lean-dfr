/-! ### Enumerating the selected integers (lines 309-313) -/

/-- The `ν`-th element of `S` in increasing order (`0` if `ν ≥ #S`). -/
def monoEnum (S : Finset ℤ) (ν : ℕ) : ℤ := (S.sort (· ≤ ·)).getD ν 0

theorem sum_eq_sum_enum (S : Finset ℤ) {N : ℕ} (hN : S.card ≤ N) (f : ℤ → ℂ) :
    ∑ n ∈ S, f n = ∑ ν ∈ Finset.range N, if ν < S.card then f (monoEnum S ν) else 0 := by
  rw [Finset.sum_ite, Finset.sum_const_zero, add_zero]
  have hfilter : (Finset.range N).filter (fun ν => ν < S.card) = Finset.range S.card := by
    ext ν; simp only [Finset.mem_filter, Finset.mem_range]; constructor
    · rintro ⟨_, h⟩; exact h
    · intro h; exact ⟨lt_of_lt_of_le h hN, h⟩
  rw [hfilter]
  set l := S.sort (· ≤ ·)
  have hlen : l.length = S.card := Finset.length_sort _
  have hl : S = l.toFinset := by simp [l]
  have hnd : l.Nodup := Finset.sort_nodup _ _
  conv_lhs => rw [hl, List.sum_toFinset _ hnd]
  rw [← hlen, Finset.sum_range (fun ν => f (monoEnum S ν))]
  simp only [monoEnum]
  rw [← List.sum_ofFn]
  congr 1
  apply List.ext_get (by simp)
  intro i h1 h2
  simp [l]

/-- A function of the selected set is measurable in the passive coordinate. -/
theorem measurable_of_finset_valued {S : ℝ → Finset ℤ} (hS : ∀ n, MeasurableSet {p | n ∈ S p})
    {β : Type*} [MeasurableSpace β] (g : Finset ℤ → β) : Measurable fun p => g (S p) := by
  have hT : ∀ T : Finset ℤ, MeasurableSet {p | S p = T} := by
    intro T
    have e : {p | S p = T} = ⋂ n : ℤ, {p | n ∈ S p ↔ n ∈ T} := by
      ext p; simp only [mem_ofPred_eq, mem_iInter]; exact ⟨fun h n => by
        rw [h], fun h => Finset.ext h⟩
    rw [e]
    refine MeasurableSet.iInter fun n => ?_
    by_cases hn : n ∈ T
    · have e2 : {p | n ∈ S p ↔ n ∈ T} = {p | n ∈ S p} := by ext p; simp [hn]
      rw [e2]; exact hS n
    · have e2 : {p | n ∈ S p ↔ n ∈ T} = {p | n ∈ S p}ᶜ := by ext p; simp [hn]
      rw [e2]; exact (hS n).compl
  intro s _
  have e : (fun p => g (S p)) ⁻¹' s = ⋃ T ∈ {T : Finset ℤ | g T ∈ s}, {p | S p = T} := by
    ext p; simp
  rw [e]
  exact MeasurableSet.biUnion (Set.to_countable _) fun T _ => hT T

/-- `(p, a) ↦ h_n(fiber_p G)(a)` is jointly measurable. -/
theorem measurable_monoH_fib (j : Fin 2) {R : ℝ} (n : ℤ) {G : ℝ × ℝ → ℂ} (hG : Measurable G) :
    Measurable fun q : ℝ × ℝ => monoH R n (monoFib j G q.1) q.2 := by
  have hk : Measurable (monoKR R) := by unfold monoKR; fun_prop
  have h : StronglyMeasurable (Function.uncurry fun (q : ℝ × ℝ) (t : ℝ) =>
      monoKR R (q.2 - t) * ((𝐞 (-(n * R * t)) : Circle) * G (monoPt j t q.1))) :=
    Measurable.stronglyMeasurable ((hk.comp ((measurable_snd.comp measurable_fst).sub
      measurable_snd)).mul ((by fun_prop : Measurable fun x : (ℝ × ℝ) × ℝ =>
        ((𝐞 (-(n * R * x.2)) : Circle) : ℂ)).mul (hG.comp ((measurable_monoPt j).comp
          (measurable_snd.prodMk (measurable_fst.comp measurable_fst))))))
  exact h.integral_prod_right'.measurable

theorem continuous_monoH' {R : ℝ} (hR : 1 ≤ R) (n : ℤ) {F : ℝ → ℂ}
    (hF : AEStronglyMeasurable F volume) {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) :
    Continuous (monoH' R n F) := by
  obtain ⟨C1, hC1, h1⟩ := monoKR'_decay hR
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  unfold monoH'
  refine continuous_iff_continuousAt.mpr fun x0 => ?_
  refine continuousAt_of_dominated (bound := fun t => 4 * C1 * M * (1 / (1 + |x0 - t|) ^ 2))
    (Eventually.of_forall fun x => ((continuous_monoKR' R).comp (continuous_const.sub
      continuous_id)).aestronglyMeasurable.mul (aesm_modF hF)) ?_
    ((integrable_inv_one_add_sq x0).const_mul _) (Eventually.of_forall fun t =>
      (((continuous_monoKR' R).comp (continuous_id.sub continuous_const)).mul
        continuous_const).continuousAt)
  filter_upwards [Metric.ball_mem_nhds x0 one_pos] with x hx
  refine Eventually.of_forall fun t => ?_
  rw [Metric.mem_ball, Real.dist_eq] at hx
  rw [norm_mul]
  calc ‖monoKR' R (x - t)‖ * ‖((𝐞 (-(n * R * t)) : Circle) : ℂ) * F t‖
      ≤ C1 / (1 + |x - t|) ^ 2 * M :=
        mul_le_mul (h1 _) (norm_modF_le hM t) (norm_nonneg _) (div_nonneg hC1 (by positivity))
    _ = C1 * M * (1 / (1 + |x - t|) ^ 2) := by ring
    _ ≤ C1 * M * (4 / (1 + |x0 - t|) ^ 2) :=
        mul_le_mul_of_nonneg_left (inv_one_add_sq_shift hx) (by positivity)
    _ = 4 * C1 * M * (1 / (1 + |x0 - t|) ^ 2) := by ring

end

