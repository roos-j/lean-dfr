/-- The slopes `|k₁ - q(t_i) k₂| ≤ U` occur at most `M₀ (2U/(c|k₂|h) + 2)` times. -/
theorem card_slope_le {ι : Type*} (T : Finset ι) (t : ι → ℝ) {q : ℝ → ℝ} {c : ℝ} (hc : 0 < c)
    {I : Set ℝ} (hq : ∀ s ∈ I, ∀ t ∈ I, s ≤ t → c * (t - s) ≤ q t - q s) (htI : ∀ i ∈ T, t i ∈ I)
    {h M₀ : ℝ} (hh : 0 < h)
    (hmult : ∀ a, ((T.filter fun i => t i ∈ Icc a (a + h)).card : ℝ) ≤ M₀)
    {k₁ k₂ : ℝ} (hk : k₂ ≠ 0) {U : ℝ} (hU : 0 ≤ U) :
    ((T.filter fun i => |k₁ - q (t i) * k₂| ≤ U).card : ℝ) ≤ M₀ * (2 * U / (c * |k₂|) / h + 2) := by
  classical
  have hM0 : 0 ≤ M₀ := (Nat.cast_nonneg _).trans (hmult 0)
  set T' := T.filter fun i => |k₁ - q (t i) * k₂| ≤ U
  rcases T'.eq_empty_or_nonempty with he | hne
  · rw [he, Finset.card_empty, Nat.cast_zero]
    have hk2 : 0 < |k₂| := abs_pos.mpr hk
    positivity
  obtain ⟨i0, hi0, hmin⟩ := T'.exists_min_image t hne
  set ℓ := 2 * U / (c * |k₂|)
  have hℓ : 0 ≤ ℓ := by have := abs_pos.mpr hk; positivity
  have hsub : T' ⊆ T.filter fun i => t i ∈ Icc (t i0) (t i0 + ℓ) := by
    intro i hi
    have hi' := Finset.mem_filter.mp hi
    have hi0' := Finset.mem_filter.mp hi0
    refine Finset.mem_filter.mpr ⟨hi'.1, hmin i hi, ?_⟩
    have := slope_level_interval hc hq hk (htI i0 hi0'.1) (htI i hi'.1) hi0'.2 hi'.2
    linarith [le_abs_self (t i - t i0)]
  calc (T'.card : ℝ) ≤ ((T.filter fun i => t i ∈ Icc (t i0) (t i0 + ℓ)).card : ℝ) := by
        exact_mod_cast Finset.card_le_card hsub
    _ ≤ M₀ * (ℓ / h + 2) := card_filter_Icc_le T t hh hmult _ _ hℓ

theorem one_add_rpow_neg_le {x : ℝ} (hx : 0 ≤ x) {d : ℕ} (hd : 1 ≤ d) (hxd : 2 ^ (d - 1) < x) :
    (1 + x) ^ (-8 : ℝ) ≤ 2 ^ 8 * (2 ^ d : ℝ)⁻¹ ^ 8 := by
  have h1 : (2 : ℝ) ^ (d - 1) ≤ 1 + x := by linarith
  have h2 : (2 : ℝ) ^ d = 2 * 2 ^ (d - 1) := by
    rw [← pow_succ']; congr 1; omega
  have hx1 : 0 < 1 + x := by linarith
  rw [Real.rpow_neg hx1.le, show ((8 : ℝ)) = ((8 : ℕ) : ℝ) by norm_num, Real.rpow_natCast]
  have e : (2 : ℝ) ^ 8 * ((2 : ℝ) ^ d)⁻¹ ^ 8 = (((2 : ℝ) ^ (d - 1)) ^ 8)⁻¹ := by
    rw [h2, mul_inv, mul_pow, inv_pow, ← mul_assoc, mul_inv_cancel₀ (by positivity), one_mul,
      inv_pow]
  rw [e]
  exact inv_anti₀ (by positivity) (pow_le_pow_left₀ (by positivity) h1 8)

/-- **The slope count (5.13)** (lines 862-876): for reference parameters with bounded multiplicity
`M₀` in every interval of length `h`, `∑_i (1 + |k₁ - q(t_i) k₂|)^{-8} ≤ C M₀ (1 + 1/(h|k₂|))`. -/
theorem slope_sum_le {ι : Type*} (T : Finset ι) (t : ι → ℝ) {q : ℝ → ℝ} {c : ℝ} (hc : 0 < c)
    {I : Set ℝ} (hq : ∀ s ∈ I, ∀ t ∈ I, s ≤ t → c * (t - s) ≤ q t - q s) (htI : ∀ i ∈ T, t i ∈ I)
    {h M₀ : ℝ} (hh : 0 < h)
    (hmult : ∀ a, ((T.filter fun i => t i ∈ Icc a (a + h)).card : ℝ) ≤ M₀)
    {k₁ k₂ : ℝ} (hk : k₂ ≠ 0) :
    ∑ i ∈ T, (1 + |k₁ - q (t i) * k₂|) ^ (-8 : ℝ)
      ≤ 2 ^ 12 * (1 + 1 / c) * M₀ * (1 + 1 / (h * |k₂|)) := by
  classical
  have hM0 : 0 ≤ M₀ := (Nat.cast_nonneg _).trans (hmult 0)
  have hk2 : 0 < |k₂| := abs_pos.mpr hk
  set x : ι → ℝ := fun i => |k₁ - q (t i) * k₂|
  have hex : ∀ i, ∃ d : ℕ, x i ≤ 2 ^ d := fun i => pow_unbounded_of_one_lt (x i) (by norm_num)
    |>.imp
    fun _ h => h.le
  set d0 : ι → ℕ := fun i => Nat.find (hex i)
  set D : ℕ := T.sup d0 + 1
  -- each weight is dominated by one dyadic term
  have hw : ∀ i ∈ T, (1 + x i) ^ (-8 : ℝ)
      ≤ ∑ d ∈ Finset.range D, 2 ^ 8 * (2 ^ d : ℝ)⁻¹ ^ 8 * (if x i ≤ 2 ^ d then 1 else 0) := by
    intro i hi
    have hd0 : d0 i < D := Nat.lt_succ_of_le (Finset.le_sup (f := d0) hi)
    refine le_trans ?_ (Finset.single_le_sum (f := fun d => 2 ^ 8 * (2 ^ d : ℝ)⁻¹ ^ 8 *
      (if x i ≤ 2 ^ d then 1 else 0)) (fun d _ => by positivity) (Finset.mem_range.mpr hd0))
    have hspec : x i ≤ 2 ^ d0 i := Nat.find_spec (hex i)
    simp only [hspec, ite_true, mul_one]
    rcases Nat.eq_zero_or_pos (d0 i) with h0 | hpos
    · rw [h0]; simp only [pow_zero, inv_one, one_pow, mul_one]
      have hx0 : 0 ≤ x i := abs_nonneg _
      calc
        (1 + x i) ^ (-8 : ℝ) ≤ 1 :=
          Real.rpow_le_one_of_one_le_of_nonpos (by linarith) (by norm_num)
        _ ≤ 2 ^ 8 := by norm_num
    · have hlt : ¬ x i ≤ 2 ^ (d0 i - 1) := Nat.find_min (hex i) (Nat.sub_lt hpos one_pos)
      exact one_add_rpow_neg_le (abs_nonneg _) hpos (lt_of_not_ge hlt)
  have hcount : ∀ d : ℕ, ((T.filter fun i => x i ≤ 2 ^ d).card : ℝ)
      ≤ M₀ * (2 * 2 ^ d / (c * |k₂|) / h + 2) := fun d =>
    card_slope_le T t hc hq htI hh hmult hk (by positivity)
  calc ∑ i ∈ T, (1 + |k₁ - q (t i) * k₂|) ^ (-8 : ℝ)
      ≤ ∑ i ∈ T, ∑ d ∈ Finset.range D, 2 ^ 8 * (2 ^ d : ℝ)⁻¹ ^ 8 * (if x i ≤ 2 ^ d then 1 else 0) :=
        Finset.sum_le_sum hw
    _ = ∑ d ∈ Finset.range D, 2 ^ 8 * (2 ^ d : ℝ)⁻¹ ^ 8 * ((T.filter fun i => x i ≤ 2 ^ d).card :
      ℝ) := by
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun d _ => ?_
        rw [← Finset.mul_sum, Finset.sum_boole]
    _ ≤ ∑ d ∈ Finset.range D, 2 ^ 8 * (2 ^ d : ℝ)⁻¹ ^ 8 * (M₀ * (2 * 2 ^ d / (c * |k₂|) / h + 2)) :=
        Finset.sum_le_sum fun d _ => mul_le_mul_of_nonneg_left (hcount d) (by positivity)
