open MeasureTheory Filter Topology Set
open scoped ENNReal ContDiff

namespace Auto

noncomputable section

/-- The `t`-derivative of the amplitude `H_{mn}(z,t) = ψ(t) f(z_1+t,z_2) g(z_1,z_2+Q(t))`. -/
def mssHd (r : ℝ) (ψ : ℝ → ℝ) (f g : ℝ × ℝ → ℂ) (Du Dv : ℝ → ℂ) (z : ℝ × ℝ) (t : ℝ) : ℂ :=
  ((deriv ψ t : ℝ) : ℂ) * (f (z.1 + t, z.2) * g (z.1, z.2 + monoQ r t)) +
    (ψ t : ℂ) * (Du (z.1 + t) * g (z.1, z.2 + monoQ r t) +
      f (z.1 + t, z.2) * ((monoq r t : ℂ) * Dv (z.2 + monoQ r t)))

theorem mss_continuous_Hd {r : ℝ} (hr : 1 < r) {ψ : ℝ → ℝ} (hψ : ContDiff ℝ ∞ ψ)
    {f g : ℝ × ℝ → ℂ} {z : ℝ × ℝ} {Du Dv : ℝ → ℂ}
    (hDu : ∀ x, HasDerivAt (fun x => f (x, z.2)) (Du x) x) (hDuc : Continuous Du)
    (hDv : ∀ y, HasDerivAt (fun y => g (z.1, y)) (Dv y) y) (hDvc : Continuous Dv) :
    Continuous (mssHd r ψ f g Du Dv z) := by
  have hfc : Continuous fun x => f (x, z.2) :=
    continuous_iff_continuousAt.2 fun x => (hDu x).continuousAt
  have hgc : Continuous fun y => g (z.1, y) :=
    continuous_iff_continuousAt.2 fun y => (hDv y).continuousAt
  have hs1 : Continuous fun t : ℝ => z.1 + t := continuous_const.add continuous_id
  have hs2 : Continuous fun t : ℝ => z.2 + monoQ r t :=
    continuous_const.add (continuous_monoQ (by linarith))
  have hu : Continuous fun t => f (z.1 + t, z.2) := hfc.comp hs1
  have hv : Continuous fun t => g (z.1, z.2 + monoQ r t) := hgc.comp hs2
  have hψc : Continuous fun t => (ψ t : ℂ) := Complex.continuous_ofReal.comp hψ.continuous
  have hdψ : Continuous fun t => ((deriv ψ t : ℝ) : ℂ) :=
    Complex.continuous_ofReal.comp (hψ.continuous_deriv (by simp))
  have hq : Continuous fun t => (monoq r t : ℂ) :=
    Complex.continuous_ofReal.comp (mss_continuous_monoq hr.le)
  unfold mssHd
  exact (hdψ.mul (hu.mul hv)).add (hψc.mul (((hDuc.comp hs1).mul hv).add
    (hu.mul (hq.mul (hDvc.comp hs2)))))

theorem mss_hasDerivAt_Hf {r : ℝ} {ψ : ℝ → ℝ} (hψ : ContDiff ℝ ∞ ψ)
    {f g : ℝ × ℝ → ℂ} {z : ℝ × ℝ} {Du Dv : ℝ → ℂ}
    (hDu : ∀ x, HasDerivAt (fun x => f (x, z.2)) (Du x) x)
    (hDv : ∀ y, HasDerivAt (fun y => g (z.1, y)) (Dv y) y) {t : ℝ} (ht : 0 < t) :
    HasDerivAt (fun t => (ψ t : ℂ) * (f (z.1 + t, z.2) * g (z.1, z.2 + monoQ r t)))
      (mssHd r ψ f g Du Dv z t) t := by
  have hψd : HasDerivAt (fun t => (ψ t : ℂ)) ((deriv ψ t : ℝ) : ℂ) t :=
    ((hψ.differentiable (by simp)) t).hasDerivAt.ofReal_comp
  have hu : HasDerivAt (fun t => f (z.1 + t, z.2)) (Du (z.1 + t)) t :=
    (hDu (z.1 + t)).comp_const_add z.1 t
  have hv : HasDerivAt (fun t => g (z.1, z.2 + monoQ r t))
      ((monoq r t : ℂ) * Dv (z.2 + monoQ r t)) t := by
    have h2 := (hDv (z.2 + monoQ r t)).scomp t ((hasDerivAt_monoQ r ht).const_add z.2)
    rw [Complex.real_smul] at h2
    exact h2
  exact hψd.mul (hu.mul hv)

theorem mss_term : ∃ C : ℝ, 0 < C ∧ ∀ {r A B : ℝ}, 1 < r → 0 < A → A < B →
    ∀ (ψ : ℝ → ℝ), ContDiff ℝ ∞ ψ → tsupport ψ ⊆ Icc A B →
    ∀ (f g : ℝ × ℝ → ℂ) (a b : ℝ) (z : ℝ × ℝ) (Du Dv : ℝ → ℂ),
    (∀ x, HasDerivAt (fun x => f (x, z.2)) (Du x) x) → Continuous Du →
    (∀ y, HasDerivAt (fun y => g (z.1, y)) (Dv y) y) → Continuous Dv → ∀ S : ℝ, 0 < S →
    ‖∫ t, (ψ t : ℂ) * ((f (z.1 + t, z.2) *
        Complex.exp (2 * Real.pi * Complex.I * ((a : ℂ) * ((z.1 + t : ℝ) : ℂ)))) *
      (g (z.1, z.2 + monoQ r t) *
        Complex.exp (2 * Real.pi * Complex.I * ((b : ℂ) * ((z.2 + monoQ r t : ℝ) : ℂ)))))‖
    ≤ (∫ t in A..B, Set.indicator {t | |a + monoq r t * b| ≤ 2 * S}
        (fun t => ‖(ψ t : ℂ) * (f (z.1 + t, z.2) * g (z.1, z.2 + monoQ r t))‖) t)
      + 2 * C / S * ∫ t in A..B, ‖mssHd r ψ f g Du Dv z t‖ := by
  obtain ⟨C, hC, hmain⟩ := mnst_nonstationary
  refine ⟨C, hC, ?_⟩
  intro r A B hr hA hAB ψ hψ hψs f g a b z Du Dv hDu hDuc hDv hDvc S hS
  set Hf : ℝ → ℂ := fun t => (ψ t : ℂ) * (f (z.1 + t, z.2) * g (z.1, z.2 + monoQ r t)) with hHf
  set Hd : ℝ → ℂ := mssHd r ψ f g Du Dv z with hHd
  set φ : ℝ → ℝ := fun t => a * (z.1 + t) + b * (z.2 + monoQ r t) with hφ
  set φ' : ℝ → ℝ := fun t => a + monoq r t * b with hφ'
  set φ'' : ℝ → ℝ := fun t => r * ((r - 1) * t ^ (r - 1 - 1)) * b with hφ''
  have hIcc : ∀ t ∈ Icc A B, 0 < t := fun t ht => lt_of_lt_of_le hA ht.1
  -- rewrite the integrand
  have hpt : ∀ t, (ψ t : ℂ) * ((f (z.1 + t, z.2) *
        Complex.exp (2 * Real.pi * Complex.I * ((a : ℂ) * ((z.1 + t : ℝ) : ℂ)))) *
      (g (z.1, z.2 + monoQ r t) *
        Complex.exp (2 * Real.pi * Complex.I * ((b : ℂ) * ((z.2 + monoQ r t : ℝ) : ℂ)))))
      = Complex.exp (2 * Real.pi * Complex.I * (φ t : ℂ)) * Hf t := by
    intro t
    have he : Complex.exp (2 * Real.pi * Complex.I * (φ t : ℂ)) =
        Complex.exp (2 * Real.pi * Complex.I * ((a : ℂ) * ((z.1 + t : ℝ) : ℂ))) *
          Complex.exp (2 * Real.pi * Complex.I * ((b : ℂ) * ((z.2 + monoQ r t : ℝ) : ℂ))) := by
      rw [← Complex.exp_add]; congr 1; simp only [hφ]; push_cast; ring
    rw [he, hHf]; ring
  simp_rw [hpt]
  have hfull : ∫ t, Complex.exp (2 * Real.pi * Complex.I * (φ t : ℂ)) * Hf t =
      ∫ t in A..B, Complex.exp (2 * Real.pi * Complex.I * (φ t : ℂ)) * Hf t := by
    rw [intervalIntegral.integral_of_le hAB.le]
    refine (setIntegral_eq_integral_of_forall_compl_eq_zero fun t ht => ?_).symm
    have h0 : ψ t = 0 := mss_psi_zero_of_not_mem_Ioo hψ.continuous hψs
      (fun h => ht ⟨h.1, h.2.le⟩)
    simp [hHf, h0]
  rw [hfull]
  -- hypotheses for the nonstationary estimate
  have hHfd : ∀ t ∈ Icc A B, HasDerivAt Hf (Hd t) t := fun t ht =>
    mss_hasDerivAt_Hf hψ hDu hDv (hIcc t ht)
  have hHdc : Continuous Hd := mss_continuous_Hd hr hψ hDu hDuc hDv hDvc
  have hψA := (mss_psi_endpoints hψ.continuous hψs)
  have hHA : Hf A = 0 := by simp [hHf, hψA.1]
  have hHB : Hf B = 0 := by simp [hHf, hψA.2]
  have hM : ∀ t ∈ Icc A B, ‖Hf t‖ ≤ ∫ t in A..B, ‖Hd t‖ := by
    intro t ht
    have hftc : Hf t = ∫ s in A..t, Hd s := by
      rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (f := Hf), hHA, sub_zero]
      · intro s hs
        rw [uIcc_of_le ht.1] at hs
        exact hHfd s ⟨hs.1, hs.2.trans ht.2⟩
      · exact hHdc.intervalIntegrable _ _
    rw [hftc]
    refine (intervalIntegral.norm_integral_le_integral_norm ht.1).trans ?_
    refine intervalIntegral.integral_mono_interval le_rfl ht.1 ht.2
      (Eventually.of_forall fun _ => norm_nonneg _) (hHdc.norm.intervalIntegrable _ _)
  have hφd : ∀ t ∈ Icc A B, HasDerivAt φ (φ' t) t := by
    intro t ht
    have h1 := (((hasDerivAt_id t).const_add z.1).const_mul a).add
      (((hasDerivAt_monoQ r (hIcc t ht)).const_add z.2).const_mul b)
    have h2 : HasDerivAt φ (a * 1 + b * monoq r t) t := h1
    exact h2.congr_deriv (by simp only [hφ']; ring)
  have hφ'd : ∀ t ∈ Icc A B, HasDerivAt φ' (φ'' t) t := by
    intro t ht
    have h1 := (((Real.hasDerivAt_rpow_const (p := r - 1) (Or.inl (hIcc t ht).ne')).const_mul
      r).mul_const b).const_add a
    exact h1
  have hφ''c : ContinuousOn φ'' (Icc A B) := by
    change ContinuousOn (fun t => r * ((r - 1) * t ^ (r - 1 - 1)) * b) _
    refine (continuousOn_const.mul (continuousOn_const.mul
      (continuousOn_id.rpow_const fun x hx => Or.inl (hIcc x hx).ne'))).mul continuousOn_const
  have hmono : MonotoneOn φ' (Icc A B) ∨ AntitoneOn φ' (Icc A B) := by
    by_cases hb : 0 ≤ b
    · left
      intro s hs t ht hst
      simp only [hφ']
      have := mss_monoq_mono hr.le (hIcc s hs).le hst
      nlinarith
    · right
      intro s hs t ht hst
      simp only [hφ']
      have := mss_monoq_mono hr.le (hIcc s hs).le hst
      push Not at hb
      nlinarith
  have key := hmain A B Hf Hd φ φ' φ'' (∫ t in A..B, ‖Hd t‖) S hAB.le hHfd hHdc.continuousOn
    hHA hHB hM hφd hφ'd hφ''c hmono hS
  refine key.trans (le_of_eq ?_)
  simp only [hφ', hHf]
  ring

end

end Auto

end

