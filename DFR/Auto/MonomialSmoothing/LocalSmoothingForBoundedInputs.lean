/-- **(2.4), `k = 1`**: `‖h_n'‖_∞ ≤ R ‖κ'‖_1 ‖F‖_∞`. -/
theorem norm_monoH'_le {R : ℝ} (hR : 0 < R) (n : ℤ) {F : ℝ → ℂ} {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M)
