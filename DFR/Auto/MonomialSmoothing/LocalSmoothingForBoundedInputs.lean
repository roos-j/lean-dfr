/-! ### (6.17)-(6.18): the choice of parameters (lines 1154-1187) -/
theorem rpow_le_rpow_of_exp_le {L a b : ℝ} (hL : 1 ≤ L) (hab : a ≤ b) : L ^ a ≤ L ^ b :=
  Real.rpow_le_rpow_of_exponent_le hL hab

/-- With `h = L^{-3/4}`, `K = L^{1/16}`, `R = L^{13/16}`, `S = L^{7/8}`, `ρ = L^{-κ/64}` and
`κ = 1/39`, every error term in (6.17) is at most `3 L^{-κ/256}`. -/
theorem mono61_params {L : ℝ} (hL : 1 ≤ L) :
    let κ : ℝ := 1 / 39
    let h := L ^ (-(3 / 4 : ℝ)); let K := L ^ (1 / 16 : ℝ); let R := L ^ (13 / 16 : ℝ)
    let S := L ^ (7 / 8 : ℝ); let ρ := L ^ (-(κ / 64))
    (L * h)⁻¹ ≤ L ^ (-(κ / 256)) ∧ ρ⁻¹ ^ 2 * L ^ (1 / 2 : ℝ) * h ≤ L ^ (-(κ / 256)) ∧
      (ρ + h + 1 / K) ^ (1 / 4 : ℝ) ≤ 3 * L ^ (-(κ / 256)) ∧
      ρ⁻¹ ^ 2 * (R / S) ≤ L ^ (-(κ / 256)) ∧ ρ⁻¹ ^ 2 * (S / L) ^ κ ≤ L ^ (-(κ / 256)) ∧
      R * h = K ∧ h * L = L ^ (1 / 4 : ℝ) := by
  intro κ h K R S ρ
  have hL0 : 0 < L := by linarith
  have e : ∀ a b : ℝ, L ^ a * L ^ b = L ^ (a + b) := fun a b => (Real.rpow_add hL0 a b).symm
  have einv : ∀ a : ℝ, (L ^ a)⁻¹ = L ^ (-a) := fun a => (Real.rpow_neg hL0.le a).symm
  have ediv : ∀ a b : ℝ, L ^ a / L ^ b = L ^ (a - b) := fun a b => (Real.rpow_sub hL0 a b).symm
  have eL : ∀ a : ℝ, L * L ^ a = L ^ (1 + a) := fun a => by rw [Real.rpow_add hL0, Real.rpow_one]
  have eLd : ∀ a : ℝ, L ^ a / L = L ^ (a - 1) := fun a => (Real.rpow_sub_one hL0.ne' a).symm
  have hρ2 : ρ⁻¹ ^ 2 = L ^ (κ / 32) := by
    simp only [ρ, einv, neg_neg, sq, e]; congr 1; ring
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [show L * h = L ^ (1 / 4 : ℝ) by simp only [h]; rw [eL]; norm_num, einv]
    exact rpow_le_rpow_of_exp_le hL (by norm_num [κ])
  · rw [hρ2]; simp only [h, e]
    exact rpow_le_rpow_of_exp_le hL (by norm_num [κ])
  · have h1 : h ≤ ρ := rpow_le_rpow_of_exp_le hL (by norm_num [κ])
    have h2 : 1 / K ≤ ρ := by
      rw [one_div, einv]; exact rpow_le_rpow_of_exp_le hL (by norm_num [κ])
    have hρ0 : 0 ≤ ρ := by positivity
    have hK0 : 0 < K := by positivity
    calc (ρ + h + 1 / K) ^ (1 / 4 : ℝ) ≤ (3 * ρ) ^ (1 / 4 : ℝ) :=
          Real.rpow_le_rpow (by positivity) (by linarith) (by norm_num)
      _ = 3 ^ (1 / 4 : ℝ) * ρ ^ (1 / 4 : ℝ) := Real.mul_rpow (by norm_num) hρ0
      _ ≤ 3 * L ^ (-(κ / 256)) := by
          gcongr
          · exact Real.rpow_le_self_of_one_le (by norm_num) (by norm_num)
          · simp only [ρ]; rw [← Real.rpow_mul hL0.le]; exact le_of_eq (by congr 1; ring)
  · rw [hρ2]; simp only [R, S, ediv, e]
    exact rpow_le_rpow_of_exp_le hL (by norm_num [κ])
  · rw [hρ2]
    simp only [S]
    rw [show L ^ (7 / 8 : ℝ) / L = L ^ (-(1 / 8 : ℝ)) by rw [eLd]; norm_num,
      ← Real.rpow_mul hL0.le, e]
    exact rpow_le_rpow_of_exp_le hL (by norm_num [κ])
  · simp only [R, h, K, e]; norm_num
  · simp only [h]; rw [mul_comm, eL]; norm_num

end

end Auto

