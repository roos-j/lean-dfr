open MeasureTheory Filter Topology Set
open scoped ENNReal

namespace Auto

noncomputable section

/-- The curve `Γ(t) = (-t, Q(t))`. -/
def mimpΓ (r t : ℝ) : ℝ × ℝ := (-t, monoQ r t)

theorem mimp_measurable_Γ {r : ℝ} (hr : 0 < r) : Measurable (mimpΓ r) :=
  measurable_neg.prodMk (continuous_monoQ hr).measurable

/-- The dominating density for `μ * μ̃`. -/
def mimpK (c L B : ℝ) (v : ℝ × ℝ) : ℝ≥0∞ :=
  if v.1 ∈ Ioc (-B) B ∧ |v.2| ≤ L * |v.1| then ENNReal.ofReal ((c * |v.1|)⁻¹) else 0

theorem mimp_measurable_K (c L B : ℝ) : Measurable (mimpK c L B) := by
  unfold mimpK
  refine Measurable.ite ?_ ?_ measurable_const
  · refine (measurableSet_Ioc.preimage measurable_fst).inter ?_
    exact measurableSet_le (f := fun v : ℝ × ℝ => |v.2|) (g := fun v : ℝ × ℝ => L * |v.1|)
      (by fun_prop) (by fun_prop)
  · exact ENNReal.measurable_ofReal.comp (by fun_prop)

theorem mimp_K_slice {c L B h : ℝ} (hh : h ∈ Ioc (-B) B) (H : ℝ × ℝ → ℝ≥0∞) :
    ∫⁻ y, H (h, y) * mimpK c L B (h, y) =
      ENNReal.ofReal ((c * |h|)⁻¹) * ∫⁻ y in Icc (-(L * |h|)) (L * |h|), H (h, y) := by
  rw [← lintegral_indicator measurableSet_Icc, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  congr 1
  ext y
  by_cases hy : |y| ≤ L * |h|
  · have hy' : y ∈ Icc (-(L * |h|)) (L * |h|) := abs_le.1 hy
    simp [mimpK, hh, hy, hy', mul_comm]
  · have hy' : y ∉ Icc (-(L * |h|)) (L * |h|) := fun h' => hy (abs_le.2 h')
    simp [mimpK, hy, hy']

theorem mimp_J_empty {A B h : ℝ} (hA : 0 < A) (hh : h ∉ Ioc (-B) B) : mimpJ A B h = ∅ := by
  ext t
  simp only [mem_empty_iff_false, iff_false]
  intro ht
  rw [mimp_mem_J] at ht
  apply hh
  constructor <;> linarith [ht.1.1, ht.1.2, ht.2.1, ht.2.2]

/-- **(4.2)**, in dominated form: `∫∫_{I²} H(Γ t - Γ s) ≤ ∫ H k`. -/
theorem mimp_diff {r A B c : ℝ} (hr : 1 < r) (hA : 0 < A) (hc : 0 < c)
    (hsep : ∀ a ∈ Icc A B, ∀ b ∈ Icc A B, c * |b - a| ≤ |monoq r b - monoq r a|)
    (H : ℝ × ℝ → ℝ≥0∞) (hH : Measurable H) :
    ∫⁻ s in Icc A B, ∫⁻ t in Icc A B, H (mimpΓ r t - mimpΓ r s) ≤
      ∫⁻ v, H v * mimpK c (monoq r B) B v := by
  have hQ : Measurable (monoQ r) := (continuous_monoQ (by linarith)).measurable
  have hmeasΓ := mimp_measurable_Γ (r := r) (by linarith)
  rw [lintegral_lintegral_swap (by
    apply Measurable.aemeasurable
    exact hH.comp ((hmeasΓ.comp measurable_snd).sub (hmeasΓ.comp measurable_fst)))]
  have step : ∀ t : ℝ, ∫⁻ s in Icc A B, H (mimpΓ r t - mimpΓ r s) =
      ∫⁻ h, (Icc A B).indicator 1 (t + h) * H (h, monoQ r t - monoQ r (t + h)) := by
    intro t
    rw [← lintegral_indicator measurableSet_Icc,
      ← lintegral_add_right_eq_self _ t]
    congr 1
    ext h
    have e1 : mimpΓ r t - mimpΓ r (h + t) = (h, monoQ r t - monoQ r (t + h)) := by
      simp only [mimpΓ, Prod.mk_sub_mk, add_comm h t]
      congr 1; ring
    by_cases hm : t + h ∈ Icc A B
    · have hm' : h + t ∈ Icc A B := by rwa [add_comm]
      simp [indicator_of_mem hm, indicator_of_mem hm', e1]
    · have hm' : h + t ∉ Icc A B := by rwa [add_comm]
      simp [indicator_of_notMem hm, indicator_of_notMem hm']
  simp_rw [step]
  rw [lintegral_lintegral_swap (by
    apply Measurable.aemeasurable
    refine Measurable.mul ?_ ?_
    · exact (measurable_const.indicator measurableSet_Icc).comp (measurable_fst.add measurable_snd)
    · exact hH.comp (measurable_snd.prodMk ((hQ.comp measurable_fst).sub
        (hQ.comp (measurable_fst.add measurable_snd)))))]
  have step2 : ∀ h : ℝ, ∫⁻ t in Icc A B, (Icc A B).indicator 1 (t + h) *
      H (h, monoQ r t - monoQ r (t + h)) =
      ∫⁻ t in mimpJ A B h, H (h, monoQ r t - monoQ r (t + h)) := by
    intro h
    have e : ∀ t, (Icc A B).indicator 1 (t + h) * H (h, monoQ r t - monoQ r (t + h)) =
        (Icc (A - h) (B - h)).indicator (fun t => H (h, monoQ r t - monoQ r (t + h))) t := by
      intro t
      by_cases hm : t + h ∈ Icc A B
      · have hm' : t ∈ Icc (A - h) (B - h) := ⟨by linarith [hm.1], by linarith [hm.2]⟩
        simp [indicator_of_mem hm, indicator_of_mem hm']
      · have hm' : t ∉ Icc (A - h) (B - h) := fun h' => hm ⟨by linarith [h'.1], by linarith [h'.2]⟩
        simp [indicator_of_notMem hm, indicator_of_notMem hm']
    simp_rw [e]
    rw [lintegral_indicator measurableSet_Icc, Measure.restrict_restrict measurableSet_Icc,
      mimpJ, inter_comm]
  simp_rw [step2]
  rw [Measure.volume_eq_prod, lintegral_prod _ (by
    exact (hH.mul (mimp_measurable_K _ _ _)).aemeasurable)]
  have hae : ∀ᵐ h : ℝ, h ∈ ({0} : Set ℝ)ᶜ := compl_mem_ae_iff.2 (measure_singleton 0)
  refine lintegral_mono_ae ?_
  filter_upwards [hae] with h hh
  have hh0 : h ≠ 0 := by simpa using hh
  by_cases hB : h ∈ Ioc (-B) B
  · rw [mimp_K_slice hB]
    exact mimp_oneD hr hA hc hsep hh0 (fun y => H (h, y))
  · rw [mimp_J_empty hA hB, Measure.restrict_empty, lintegral_zero_measure]
    exact zero_le

end

end Auto

