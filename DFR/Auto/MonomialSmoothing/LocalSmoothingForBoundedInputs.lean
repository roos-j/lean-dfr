theorem msub_vol_ball2 (u : ℝ × ℝ) (ρ : ℝ) :
    volume (Metric.closedBall u ρ) = ENNReal.ofReal (2 * ρ) * ENNReal.ofReal (2 * ρ) := by
  rw [← closedBall_prod_same, Measure.volume_eq_prod, Measure.prod_prod, Real.volume_closedBall,
    Real.volume_closedBall]

/-- Fubini in the image coordinates: the thickened graph has small measure. -/
theorem msub_vol_graph (g : ℝ × ℝ → ℝ) (hg : Measurable g) (u : ℝ × ℝ) (ρ δ : ℝ) :
    volume {w : ℝ × ℝ × ℝ | w.2 ∈ Metric.closedBall u ρ ∧ |w.1 - g w.2| ≤ δ} ≤
      ENNReal.ofReal (2 * δ) * (ENNReal.ofReal (2 * ρ) * ENNReal.ofReal (2 * ρ)) := by
  have hm : MeasurableSet {w : ℝ × ℝ × ℝ | w.2 ∈ Metric.closedBall u ρ ∧ |w.1 - g w.2| ≤ δ} :=
    (measurable_snd Metric.isClosed_closedBall.measurableSet).inter
      (measurableSet_le (continuous_abs.measurable.comp (measurable_fst.sub (hg.comp
        measurable_snd))) measurable_const)
  rw [Measure.volume_eq_prod, Measure.prod_apply_symm hm, ← msub_vol_ball2 u ρ,
    ← lintegral_indicator_const Metric.isClosed_closedBall.measurableSet]
  refine lintegral_mono fun y => ?_
  by_cases hy : y ∈ Metric.closedBall u ρ
  · rw [indicator_of_mem hy]
    calc volume ((fun x => (x, y)) ⁻¹' {w : ℝ × ℝ × ℝ | w.2 ∈ Metric.closedBall u ρ ∧
          |w.1 - g w.2| ≤ δ}) ≤ volume (Icc (g y - δ) (g y + δ)) := by
          apply measure_mono
          intro x hx
          simp only [mem_preimage, mem_ofPred_eq] at hx
          rw [mem_Icc]; constructor <;> linarith [abs_le.mp hx.2]
      _ = ENNReal.ofReal (2 * δ) := by rw [Real.volume_Icc]; ring_nf
  · rw [indicator_of_notMem hy]
    apply le_of_eq
    rw [measure_eq_zero_iff_ae_notMem.mpr]
    · exact Filter.Eventually.of_forall fun x hx => hy hx.1

theorem msub_prod_le {Z : Type*} [MeasureSpace Z] [SFinite (volume : Measure Z)] {A B : ℝ}
    {Y : Set (ℝ × Z)} (hY : MeasurableSet Y) {K : ℝ≥0∞}
    (h : ∀ a, volume (Prod.mk a ⁻¹' Y) ≤ (Icc A B).indicator (fun _ => K) a) :
    volume Y ≤ K * ENNReal.ofReal (B - A) := by
  rw [Measure.volume_eq_prod, Measure.prod_apply hY, ← Real.volume_Icc,
    ← lintegral_indicator_const measurableSet_Icc]
  exact lintegral_mono h

theorem msub_I3_meas (A B : ℝ) : MeasurableSet (msubI3 A B) :=
  (measurable_fst measurableSet_Icc).inter
    (((measurable_fst.comp measurable_snd) measurableSet_Icc).inter
      ((measurable_snd.comp measurable_snd) measurableSet_Icc))

theorem msub_slice_le {Z : Type*} [MeasureSpace Z] {A B : ℝ} {Y : Set (ℝ × Z)} {W : ℝ → Set Z}
    {K : ℝ≥0∞} (hY : ∀ a z, (a, z) ∈ Y → a ∈ Icc A B ∧ z ∈ W a)
    (hW : ∀ a, volume (W a) ≤ K) (a : ℝ) :
    volume (Prod.mk a ⁻¹' Y) ≤ (Icc A B).indicator (fun _ => K) a := by
  by_cases ha : a ∈ Icc A B
  · rw [indicator_of_mem ha]
    exact (measure_mono fun z hz => (hY a z hz).2).trans (hW a)
  · rw [indicator_of_notMem ha]
    apply le_of_eq
    rw [show Prod.mk a ⁻¹' Y = ∅ from eq_empty_of_forall_notMem fun z hz => ha (hY a z hz).1]
    exact measure_empty

theorem msub_vol_diag2 {A B η : ℝ} :
    volume {p : ℝ × ℝ | p.1 ∈ Icc A B ∧ p.2 ∈ Icc A B ∧ |p.1 - p.2| < η} ≤
      ENNReal.ofReal (2 * η) * ENNReal.ofReal (B - A) := by
  apply msub_prod_le
  · exact (measurable_fst measurableSet_Icc).inter ((measurable_snd measurableSet_Icc).inter
      (measurableSet_lt (continuous_abs.measurable.comp (measurable_fst.sub measurable_snd))
        measurable_const))
  · refine msub_slice_le (W := fun a => Ioo (a - η) (a + η)) (fun a z hz => ⟨hz.1, ?_⟩)
      (fun a => ?_)
    · have := abs_lt.mp hz.2.2; constructor <;> linarith
    · rw [Real.volume_Ioo]; ring_nf; exact le_rfl

theorem msub_vol_X {A B η : ℝ} :
    volume {t : ℝ × ℝ × ℝ | t ∈ msubI3 A B ∧ (|t.1 - t.2.1| < η ∨ |t.1 - t.2.2| < η ∨
      |t.2.1 - t.2.2| < η)} ≤ 3 * (ENNReal.ofReal (2 * η) * ENNReal.ofReal (B - A) *
        ENNReal.ofReal (B - A)) := by
  have hsub : {t : ℝ × ℝ × ℝ | t ∈ msubI3 A B ∧ (|t.1 - t.2.1| < η ∨ |t.1 - t.2.2| < η ∨
      |t.2.1 - t.2.2| < η)} ⊆ {t | t ∈ msubI3 A B ∧ |t.1 - t.2.1| < η} ∪
      ({t | t ∈ msubI3 A B ∧ |t.1 - t.2.2| < η} ∪ {t | t ∈ msubI3 A B ∧ |t.2.1 - t.2.2| < η}) := by
    rintro t ⟨ht, h | h | h⟩
    · exact Or.inl ⟨ht, h⟩
    · exact Or.inr (Or.inl ⟨ht, h⟩)
    · exact Or.inr (Or.inr ⟨ht, h⟩)
  have mI := msub_I3_meas A B
  have h1 : volume {t : ℝ × ℝ × ℝ | t ∈ msubI3 A B ∧ |t.1 - t.2.1| < η} ≤
      ENNReal.ofReal (2 * η) * ENNReal.ofReal (B - A) * ENNReal.ofReal (B - A) := by
    apply msub_prod_le
    · exact mI.inter (measurableSet_lt (continuous_abs.measurable.comp (measurable_fst.sub
        (measurable_fst.comp measurable_snd))) measurable_const)
    · refine msub_slice_le (W := fun a => Ioo (a - η) (a + η) ×ˢ Icc A B)
        (fun a z hz => ⟨hz.1.1, ?_, hz.1.2.2⟩) (fun a => ?_)
      · have := abs_lt.mp hz.2; constructor <;> linarith
      · rw [Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Ioo, Real.volume_Icc]
        ring_nf; exact le_rfl
  have h2 : volume {t : ℝ × ℝ × ℝ | t ∈ msubI3 A B ∧ |t.1 - t.2.2| < η} ≤
      ENNReal.ofReal (2 * η) * ENNReal.ofReal (B - A) * ENNReal.ofReal (B - A) := by
    apply msub_prod_le
    · exact mI.inter (measurableSet_lt (continuous_abs.measurable.comp (measurable_fst.sub
        (measurable_snd.comp measurable_snd))) measurable_const)
    · refine msub_slice_le (W := fun a => Icc A B ×ˢ Ioo (a - η) (a + η))
        (fun a z hz => ⟨hz.1.1, hz.1.2.1, ?_⟩) (fun a => ?_)
      · have := abs_lt.mp hz.2; constructor <;> linarith
      · rw [Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Ioo, Real.volume_Icc]
        ring_nf; rw [mul_comm]
  have h3 : volume {t : ℝ × ℝ × ℝ | t ∈ msubI3 A B ∧ |t.2.1 - t.2.2| < η} ≤
      ENNReal.ofReal (2 * η) * ENNReal.ofReal (B - A) * ENNReal.ofReal (B - A) := by
    apply msub_prod_le
    · exact mI.inter (measurableSet_lt (continuous_abs.measurable.comp ((measurable_fst.comp
        measurable_snd).sub
        (measurable_snd.comp measurable_snd))) measurable_const)
    · exact msub_slice_le
        (W := fun _ => {p : ℝ × ℝ | p.1 ∈ Icc A B ∧ p.2 ∈ Icc A B ∧ |p.1 - p.2| < η})
        (fun a z hz => ⟨hz.1.1, hz.1.2.1, hz.1.2.2, hz.2⟩) (fun _ => msub_vol_diag2 )
  calc _ ≤ _ := measure_mono hsub
    _ ≤ _ := measure_union_le _ _
    _ ≤ _ := add_le_add le_rfl (measure_union_le _ _)
    _ ≤ _ := add_le_add h1 (add_le_add h2 h3)
    _ = _ := by ring

theorem msub_cover1 {A B h : ℝ} {N : ℕ} (hh : 0 < h) (hN : 0 < N) (hNh : B - A ≤ N * h)
    {x : ℝ} (hx : x ∈ Icc A B) : ∃ j : Fin N, A + j * h ≤ x ∧ x ≤ A + (j + 1) * h := by
  set k := ⌊(x - A) / h⌋₊
  have hxA : 0 ≤ (x - A) / h := div_nonneg (by linarith [hx.1]) hh.le
  have hk1 : (k : ℝ) ≤ (x - A) / h := Nat.floor_le hxA
  have hk2 : (x - A) / h < k + 1 := Nat.lt_floor_add_one _
  rw [le_div_iff₀ hh] at hk1
  rw [div_lt_iff₀ hh] at hk2
  by_cases hkN : k < N
  · exact ⟨⟨k, hkN⟩, by simp; linarith, by simp; linarith⟩
  · push Not at hkN
    refine ⟨⟨N - 1, by omega⟩, ?_, ?_⟩
    · simp only
      have : ((N - 1 : ℕ) : ℝ) ≤ k := by exact_mod_cast (Nat.sub_le N 1).trans hkN
      nlinarith
    · simp only
      have : ((N - 1 : ℕ) : ℝ) + 1 = N := by
        rw [Nat.cast_sub (by omega)]; simp
      rw [this]; linarith [hx.2]

def msubCube (A h : ℝ) {N : ℕ} (k : Fin N × Fin N × Fin N) : Set (ℝ × ℝ × ℝ) :=
  {t | (A + k.1 * h ≤ t.1 ∧ t.1 ≤ A + (k.1 + 1) * h) ∧
    (A + k.2.1 * h ≤ t.2.1 ∧ t.2.1 ≤ A + (k.2.1 + 1) * h) ∧
    (A + k.2.2 * h ≤ t.2.2 ∧ t.2.2 ≤ A + (k.2.2 + 1) * h)}

theorem msub_cover3 {A B h : ℝ} {N : ℕ} (hh : 0 < h) (hN : 0 < N) (hNh : B - A ≤ N * h) :
    msubI3 A B ⊆ ⋃ k : Fin N × Fin N × Fin N, msubCube A h k := by
  rintro t ⟨h0, h1, h2⟩
  obtain ⟨j0, a0, b0⟩ := msub_cover1 hh hN hNh h0
  obtain ⟨j1, a1, b1⟩ := msub_cover1 hh hN hNh h1
  obtain ⟨j2, a2, b2⟩ := msub_cover1 hh hN hNh h2
  exact mem_iUnion.mpr ⟨(j0, j1, j2), ⟨a0, b0⟩, ⟨a1, b1⟩, ⟨a2, b2⟩⟩

theorem msub_cube_diam {A h : ℝ} {N : ℕ} {k : Fin N × Fin N × Fin N} {t c : ℝ × ℝ × ℝ}
    (ht : t ∈ msubCube A h k) (hc : c ∈ msubCube A h k) : ‖t - c‖ ≤ h := by
  obtain ⟨⟨a0, b0⟩, ⟨a1, b1⟩, ⟨a2, b2⟩⟩ := ht
  obtain ⟨⟨c0, d0⟩, ⟨c1, d1⟩, ⟨c2, d2⟩⟩ := hc
  rw [msub_norm3]
  simp only [Prod.fst_sub, Prod.snd_sub]
  refine max_le (abs_le.mpr ⟨by nlinarith, by nlinarith⟩)
    (max_le (abs_le.mpr ⟨by nlinarith, by nlinarith⟩) (abs_le.mpr ⟨by nlinarith, by nlinarith⟩))

end
