attribute [local instance] Classical.propDecidable

/-- The measurable function equal to `F m w` on the cube indexed by `m ∈ P` (cubes of `P` being
disjoint) and to `1` outside these cubes. -/
def mssGlue (h C0 : ℝ) (P : Finset (ℤ × ℤ)) (F : ℤ × ℤ → ℝ × ℝ → ℝ) (w : ℝ × ℝ) : ℝ :=
  ∑ m ∈ P, (mssBox h C0 m).indicator (F m) w + (⋃ m ∈ P, mssBox h C0 m)ᶜ.indicator (fun _ => 1) w

theorem mss_glue_eq {h C0 : ℝ} {P : Finset (ℤ × ℤ)}
    (hP : ∀ m ∈ P, ∀ m' ∈ P, m ≠ m' → Disjoint (mssBox h C0 m) (mssBox h C0 m'))
    (F : ℤ × ℤ → ℝ × ℝ → ℝ) {m : ℤ × ℤ} (hm : m ∈ P) {w : ℝ × ℝ} (hw : w ∈ mssBox h C0 m) :
    mssGlue h C0 P F w = F m w := by
  unfold mssGlue
  have hU : w ∈ ⋃ m ∈ P, mssBox h C0 m := mem_biUnion hm hw
  rw [indicator_of_notMem (show w ∉ (⋃ m ∈ P, mssBox h C0 m)ᶜ from fun hh => hh hU), add_zero,
    Finset.sum_eq_single_of_mem m hm,
    indicator_of_mem hw]
  intro m' hm' hne
  exact indicator_of_notMem (fun hw' => Set.disjoint_left.1 (hP m' hm' m hm hne) hw' hw) _

theorem mss_glue_out {h C0 : ℝ} {P : Finset (ℤ × ℤ)} (F : ℤ × ℤ → ℝ × ℝ → ℝ) {w : ℝ × ℝ}
    (hw : w ∉ ⋃ m ∈ P, mssBox h C0 m) : mssGlue h C0 P F w = 1 := by
  unfold mssGlue
  rw [indicator_of_mem hw, Finset.sum_eq_zero, zero_add]
  intro m hm
  exact indicator_of_notMem (fun hh => hw (mem_biUnion hm hh)) _

theorem mss_glue_measurable (h C0 : ℝ) (P : Finset (ℤ × ℤ)) {F : ℤ × ℤ → ℝ × ℝ → ℝ}
    (hF : ∀ m, Measurable (F m)) : Measurable (mssGlue h C0 P F) := by
  unfold mssGlue
  refine (Finset.measurable_sum _ fun m _ => (hF m).indicator
    (mss_measurableSet_box h C0 m)).add (measurable_const.indicator ?_)
  exact (Finset.measurableSet_biUnion P fun m _ => mss_measurableSet_box h C0 m).compl

theorem mss_glue_lower {h C0 c : ℝ} {P : Finset (ℤ × ℤ)}
    (hP : ∀ m ∈ P, ∀ m' ∈ P, m ≠ m' → Disjoint (mssBox h C0 m) (mssBox h C0 m'))
    {F : ℤ × ℤ → ℝ × ℝ → ℝ} (hF : ∀ m w, c ≤ |F m w|) (w : ℝ × ℝ) :
    min c 1 ≤ |mssGlue h C0 P F w| := by
  by_cases hw : w ∈ ⋃ m ∈ P, mssBox h C0 m
  · obtain ⟨m, hm, hwm⟩ := mem_iUnion₂.1 hw
    rw [mss_glue_eq hP F hm hwm]
    exact (min_le_left _ _).trans (hF m w)
  · rw [mss_glue_out F hw, abs_one]
    exact min_le_right _ _

/-- One pair of residue classes: cubes within each family are pairwise disjoint. -/
theorem mss_class_pair {r A B : ℝ} (hr : 1 < r) {D : Set (ℝ × ℝ)} (hDm : MeasurableSet D)
    {c1 : ℝ} (Cs : ℝ)
    (hsub : ∀ α β : ℝ × ℝ → ℝ, Measurable α → Measurable β →
      ((∀ z, min c1 1 ≤ |α z|) ∨ (∀ z, min c1 1 ≤ |β z|)) → ∀ ε : ℝ, 0 < ε → ε ≤ 1 →
        volume {p : (ℝ × ℝ) × ℝ | p.1 ∈ D ∧ p.2 ∈ Set.Icc A B ∧
          |α (p.1.1 + p.2, p.1.2) - monoq r p.2 * β (p.1.1, p.1.2 + monoQ r p.2)| ≤ ε}
          ≤ ENNReal.ofReal (Cs * ε ^ (1 / 39 : ℝ)))
    {h C0 S L : ℝ} (hS : 0 < S) (hSL : 2 * S ≤ L) {P₁ P₂ : Finset (ℤ × ℤ)}
    (hP₁ : ∀ m ∈ P₁, ∀ m' ∈ P₁, m ≠ m' → Disjoint (mssBox h C0 m) (mssBox h C0 m'))
    (hP₂ : ∀ m ∈ P₂, ∀ m' ∈ P₂, m ≠ m' → Disjoint (mssBox h C0 m) (mssBox h C0 m'))
    {a b : ℤ × ℤ → ℝ → ℝ} (ha : ∀ m, Measurable (a m)) (hb : ∀ n, Measurable (b n))
    (hab : (∀ m y, c1 * L ≤ |a m y|) ∨ (∀ n x, c1 * L ≤ |b n x|)) :
    ∑ m ∈ P₁, ∑ n ∈ P₂, volume (mssE r A B h C0 S D m n (a m) (b n))
      ≤ ENNReal.ofReal (Cs * (2 * S / L) ^ (1 / 39 : ℝ)) := by
  have hL : 0 < L := by linarith
  set Fα : ℤ × ℤ → ℝ × ℝ → ℝ := fun m w => a m w.2 / L
  set Fβ : ℤ × ℤ → ℝ × ℝ → ℝ := fun n w => -(b n w.1 / L)
  have hαm : Measurable (mssGlue h C0 P₁ Fα) := mss_glue_measurable h C0 P₁ fun m =>
    ((ha m).comp measurable_snd).div_const L
  have hβm : Measurable (mssGlue h C0 P₂ Fβ) := mss_glue_measurable h C0 P₂ fun n =>
    (((hb n).comp measurable_fst).div_const L).neg
  have hlow : (∀ z, min c1 1 ≤ |mssGlue h C0 P₁ Fα z|) ∨
      (∀ z, min c1 1 ≤ |mssGlue h C0 P₂ Fβ z|) := by
    rcases hab with h1 | h2
    · left
      refine mss_glue_lower hP₁ (fun m w => ?_)
      simp only [Fα, abs_div, abs_of_pos hL]
      rw [le_div_iff₀ hL]; exact h1 m w.2
    · right
      refine mss_glue_lower hP₂ (fun n w => ?_)
      simp only [Fβ, abs_neg, abs_div, abs_of_pos hL]
      rw [le_div_iff₀ hL]; exact h2 n w.1
  have hε : 0 < 2 * S / L := by positivity
  have hε1 : 2 * S / L ≤ 1 := by rw [div_le_one hL]; exact hSL
  have key := hsub _ _ hαm hβm hlow (2 * S / L) hε hε1
  refine le_trans ?_ key
  rw [← Finset.sum_product']
  have hdisj : PairwiseDisjoint (↑(P₁ ×ˢ P₂))
      fun x : (ℤ × ℤ) × (ℤ × ℤ) => mssE r A B h C0 S D x.1 x.2 (a x.1) (b x.2) := by
    intro x hx y hy hxy
    rw [Function.onFun, Set.disjoint_left]
    intro p hpx hpy
    simp only [Finset.coe_product, mem_prod, Finset.mem_coe] at hx hy
    apply hxy
    refine Prod.ext ?_ ?_
    · by_contra hne
      exact Set.disjoint_left.1 (hP₁ _ hx.1 _ hy.1 hne) hpx.2.2.2.1 hpy.2.2.2.1
    · by_contra hne
      exact Set.disjoint_left.1 (hP₂ _ hx.2 _ hy.2 hne) hpx.2.2.2.2 hpy.2.2.2.2
  rw [← measure_biUnion_finset hdisj fun x _ =>
    mss_measurableSet_E (by linarith) A B h C0 S hDm x.1 x.2 (ha x.1) (hb x.2)]
  refine measure_mono ?_
  intro p hp
  obtain ⟨x, hx, hpx⟩ := mem_iUnion₂.1 hp
  rw [Finset.mem_product] at hx
  obtain ⟨hD, hI, hst, h1, h2⟩ := hpx
  refine ⟨hD, hI, ?_⟩
  rw [mss_glue_eq hP₁ Fα hx.1 h1, mss_glue_eq hP₂ Fβ hx.2 h2]
  simp only [Fα, Fβ]
  have e : a x.1 p.1.2 / L - monoq r p.2 * -(b x.2 p.1.1 / L) =
      (a x.1 p.1.2 + monoq r p.2 * b x.2 p.1.1) / L := by ring
  rw [e, abs_div, abs_of_pos hL]
  exact div_le_div_of_nonneg_right hst hL.le

end

