/-- **(2.4), `k = 0`**: `‖h_n‖_∞ ≤ ‖κ‖_1 ‖F‖_∞`. -/
theorem norm_monoH_le {R : ℝ} (hR : 0 < R) (n : ℤ) {F : ℝ → ℂ} {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) (x
    : ℝ) :
    ‖monoH R n F x‖ ≤ (∫ u, ‖monoKappa u‖) * M := by
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  unfold monoH
  refine (norm_integral_le_integral_norm _).trans ?_
  calc ∫ t, ‖monoKR R (x - t) * ((𝐞 (-(n * R * t)) : Circle) * F t)‖
      ≤ ∫ t, ‖monoKR R (x - t)‖ * M := by
        refine integral_mono_of_nonneg (Eventually.of_forall fun t => norm_nonneg _)
