theorem monoSel_finite {R ρ : ℝ} (hR : 0 < R) (hρ : 0 < ρ) {F : ℝ → ℂ}
    (hF : Integrable F volume) (hE : monoE F ≠ ⊤) : {n | monoSelP R ρ F n}.Finite := by
  by_contra hinf
  obtain ⟨N, hN⟩ := exists_nat_gt (9 / ρ)
  obtain ⟨T, hTs, hTc⟩ := Set.Infinite.exists_subset_card_eq hinf N
  have h := card_le_of_selected hR hρ hF hE T fun n hn => hTs hn
  rw [hTc] at h
  linarith

theorem mem_monoSel {R ρ : ℝ} (hR : 0 < R) (hρ : 0 < ρ) {F : ℝ → ℂ}
    (hF : Integrable F volume) (hE : monoE F ≠ ⊤) (n : ℤ) :
    n ∈ monoSel R ρ F ↔ monoSelP R ρ F n := by
  classical
  unfold monoSel
  rw [dite_eq_left (monoSel_finite hR hρ hF hE), Set.Finite.mem_toFinset, mem_ofPred_eq]

/-- **The count of selected integers** (lines 256-257): at most `9/ρ`. -/
theorem card_monoSel_le {R ρ : ℝ} (hR : 0 < R) (hρ : 0 < ρ) {F : ℝ → ℂ}
    (hF : Integrable F volume) (hE : monoE F ≠ ⊤) : ((monoSel R ρ F).card : ℝ) ≤ 9 / ρ :=
  card_le_of_selected hR hρ hF hE _ fun n hn => (mem_monoSel hR hρ hF hE n).mp hn

/-- The sharp multiplier `∑_{n ∈ S} ϑ(ξ/R - n)` (line 261). -/
def monoMult (R : ℝ) (S : Finset ℤ) (ξ : ℝ) : ℝ := ∑ n ∈ S, smoothingPartitionCutoff (ξ / R - n)

theorem summable_partition (x : ℝ) : Summable fun n : ℤ => smoothingPartitionCutoff (x - n) := by
  by_contra h
  have h1 := smoothingPartitionCutoff_partition x
  have h2 : Summable fun n : ℤ => smoothingPartitionCutoff (x + n) := by
    by_contra h'; rw [tsum_eq_zero_of_not_summable h'] at h1; norm_num at h1
  apply h
  have := (Equiv.neg ℤ).summable_iff.mpr h2
  simpa [Function.comp_def, sub_eq_add_neg] using this

theorem tsum_partition (x : ℝ) : ∑' n : ℤ, smoothingPartitionCutoff (x - n) = 1 := by
  have hreindex := (Equiv.neg ℤ).tsum_eq (fun n : ℤ => smoothingPartitionCutoff (x - n))
  rw [← hreindex]
  simpa only [Equiv.neg_apply, Int.cast_neg, sub_neg_eq_add] using
    smoothingPartitionCutoff_partition x

theorem monoMult_nonneg (R : ℝ) (S : Finset ℤ) (ξ : ℝ) : 0 ≤ monoMult R S ξ :=
  Finset.sum_nonneg fun _ _ => (smoothingPartitionCutoff_bounds _).1

theorem monoMult_le_one (R : ℝ) (S : Finset ℤ) (ξ : ℝ) : monoMult R S ξ ≤ 1 := by
  rw [← tsum_partition (ξ / R)]
  exact Summable.sum_le_tsum S (fun n _ => (smoothingPartitionCutoff_bounds _).1)
    (summable_partition _)

theorem monoMult_eq_one {R : ℝ} {S : Finset ℤ} {ξ : ℝ}
    (h : ∀ n, n ∉ S → smoothingPartitionCutoff (ξ / R - n) = 0) : monoMult R S ξ = 1 := by
  rw [← tsum_partition (ξ / R), tsum_eq_sum (s := S) fun n hn => h n hn]
  rfl

/-- The sharp part `f_♯ = ∑_{n selected} ϑ(D/R - n) f` (line 261). -/
def monoSharp (R ρ : ℝ) (F : ℝ → ℂ) (x : ℝ) : ℂ := ∑ n ∈ monoSel R ρ F, monoPiece R n F x

/-- The flat part `f_♭ = f - f_♯` (line 265). -/
def monoFlat (R ρ : ℝ) (F : ℝ → ℂ) (x : ℝ) : ℂ := F x - monoSharp R ρ F x

theorem integrable_monoSharp {R : ℝ} (hR : 0 < R) (ρ : ℝ) {F : ℝ → ℂ} (hF : Integrable F volume) :
    Integrable (monoSharp R ρ F) volume := by
  have : monoSharp R ρ F = ∑ n ∈ monoSel R ρ F, monoPiece R n F := by
    funext x; simp [monoSharp, Finset.sum_apply]
  rw [this]
  exact integrable_finsetSum' _ fun n _ => integrable_monoPiece hR n hF

theorem integrable_monoFlat {R : ℝ} (hR : 0 < R) (ρ : ℝ) {F : ℝ → ℂ} (hF : Integrable F volume) :
    Integrable (monoFlat R ρ F) volume :=
  hF.sub (integrable_monoSharp hR ρ hF)

theorem fourier_finset_sum {ι : Type*} (S : Finset ι) {f : ι → ℝ → ℂ}
    (hf : ∀ i ∈ S, Integrable (f i) volume) (ξ : ℝ) :
    𝓕 (fun x => ∑ i ∈ S, f i x) ξ = ∑ i ∈ S, 𝓕 (f i) ξ := by
  simp only [Real.fourier_real_eq, Finset.smul_sum]
  exact integral_finsetSum S fun i hi => (Real.fourierIntegral_convergent_iff ξ).2 (hf i hi)
    |>.congr
    (Eventually.of_forall fun x => by simp [mul_comm])

/-- `(f_♯)^ = (∑_{n ∈ S} ϑ(ξ/R - n)) f̂` (line 261). -/
theorem fourier_monoSharp {R : ℝ} (hR : 0 < R) (ρ : ℝ) {F : ℝ → ℂ} (hF : Integrable F volume)
    (ξ : ℝ) : 𝓕 (monoSharp R ρ F) ξ = (monoMult R (monoSel R ρ F) ξ : ℂ) * 𝓕 F ξ := by
  have e : monoSharp R ρ F = fun x => ∑ n ∈ monoSel R ρ F, monoPiece R n F x := rfl
  rw [e, fourier_finset_sum _ fun n _ => integrable_monoPiece hR n hF]
  simp only [fourier_monoPiece hR _ hF, monoMult, Complex.ofReal_sum, Finset.sum_mul]

theorem fourier_sub' {f g : ℝ → ℂ} (hf : Integrable f volume) (hg : Integrable g volume) (ξ : ℝ) :
    𝓕 (fun x => f x - g x) ξ = 𝓕 f ξ - 𝓕 g ξ := by
  simp only [Real.fourier_real_eq, smul_sub]
  exact integral_sub ((Real.fourierIntegral_convergent_iff ξ).2 hf |>.congr
    (Eventually.of_forall fun x => by simp [mul_comm]))
    ((Real.fourierIntegral_convergent_iff ξ).2 hg |>.congr (Eventually.of_forall fun x =>
      by simp [mul_comm]))

/-- `(f_♭)^ = (1 - ∑_{n ∈ S} ϑ(ξ/R - n)) f̂`. -/
theorem fourier_monoFlat {R : ℝ} (hR : 0 < R) (ρ : ℝ) {F : ℝ → ℂ} (hF : Integrable F volume)
    (ξ : ℝ) : 𝓕 (monoFlat R ρ F) ξ = ((1 - monoMult R (monoSel R ρ F) ξ : ℝ) : ℂ) * 𝓕 F ξ := by
  have e : monoFlat R ρ F = fun x => F x - monoSharp R ρ F x := rfl
  rw [e, fourier_sub' hF (integrable_monoSharp hR ρ hF), fourier_monoSharp hR ρ hF]
  push_cast; ring

/-- **(2.1)**, lines 214-216: `|(f_♯)^| ≤ |f̂|`. -/
theorem norm_fourier_monoSharp_le {R : ℝ} (hR : 0 < R) (ρ : ℝ) {F : ℝ → ℂ}
    (hF : Integrable F volume) (ξ : ℝ) : ‖𝓕 (monoSharp R ρ F) ξ‖ ≤ ‖𝓕 F ξ‖ := by
  rw [fourier_monoSharp hR ρ hF, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (monoMult_nonneg _ _ _)]
  exact mul_le_of_le_one_left (norm_nonneg _) (monoMult_le_one _ _ _)

/-- **(2.1)**, lines 214-216: `|(f_♭)^| ≤ |f̂|`. -/
theorem norm_fourier_monoFlat_le {R : ℝ} (hR : 0 < R) (ρ : ℝ) {F : ℝ → ℂ}
    (hF : Integrable F volume) (ξ : ℝ) : ‖𝓕 (monoFlat R ρ F) ξ‖ ≤ ‖𝓕 F ξ‖ := by
  rw [fourier_monoFlat hR ρ hF, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (by linarith [monoMult_le_one R (monoSel R ρ F) ξ])]
  exact mul_le_of_le_one_left (norm_nonneg _) (by linarith [monoMult_nonneg R (monoSel R ρ F) ξ])

/-- **(2.2)**, lines 219-222 and 268-275: every interval of length `2R` carries at most `ρ E` of
the flat part's Fourier mass. -/
theorem monoFlat_interval {R ρ : ℝ} (hR : 0 < R) (hρ : 0 < ρ) {F : ℝ → ℂ}
    (hF : Integrable F volume) (hE : monoE F ≠ ⊤) (a : ℝ) :
    ∫⁻ ξ in Icc a (a + 2 * R), ‖𝓕 (monoFlat R ρ F) ξ‖ₑ ^ 2 ≤ ENNReal.ofReal ρ * monoE F := by
  set S := monoSel R ρ F
  by_cases h : ∃ n, n ∉ S ∧ ∃ ξ ∈ Icc a (a + 2 * R), smoothingPartitionCutoff (ξ / R - n) ≠ 0
  · obtain ⟨n, hnS, ξ0, hξ0, hφ⟩ := h
    have hlt : |ξ0 / R - n| < 3 / 4 := by
      by_contra hc; exact hφ (smoothingPartitionCutoff_eq_zero (not_lt.mp hc))
    have hlt' : |ξ0 - n * R| < 3 / 4 * R := by
      have : ξ0 - n * R = R * (ξ0 / R - n) := by field_simp
      rw [this, abs_mul, abs_of_pos hR]; nlinarith
    have hsub : Icc a (a + 2 * R) ⊆ Icc ((n - 4) * R) ((n + 4) * R) := by
      intro ζ hζ
      obtain ⟨h1, h2⟩ := hζ
      obtain ⟨h3, h4⟩ := hξ0
      have := abs_lt.mp hlt'
      constructor <;> nlinarith
    have hns : ¬ monoSelP R ρ F n := fun hs => hnS ((mem_monoSel hR hρ hF hE n).mpr hs)
    unfold monoSelP at hns
    push Not at hns
    calc ∫⁻ ξ in Icc a (a + 2 * R), ‖𝓕 (monoFlat R ρ F) ξ‖ₑ ^ 2
        ≤ ∫⁻ ξ in Icc a (a + 2 * R), ‖𝓕 F ξ‖ₑ ^ 2 := by
          refine lintegral_mono fun ξ => ?_
          gcongr
          rw [← ofReal_norm, ← ofReal_norm]
          exact ENNReal.ofReal_le_ofReal (norm_fourier_monoFlat_le hR ρ hF ξ)
      _ ≤ ∫⁻ ξ in Icc ((n - 4) * R) ((n + 4) * R), ‖𝓕 F ξ‖ₑ ^ 2 := lintegral_mono_set hsub
      _ ≤ _ := hns
  · push Not at h
    have hz : ∀ ξ ∈ Icc a (a + 2 * R), ‖𝓕 (monoFlat R ρ F) ξ‖ₑ ^ 2 = 0 := by
      intro ξ hξ
      rw [fourier_monoFlat hR ρ hF, monoMult_eq_one fun n hn => h n hn ξ hξ]
      simp
    rw [setLIntegral_congr_fun measurableSet_Icc hz, lintegral_zero]
    exact bot_le

end

