theorem mss_two_rpow_le {S L : ℝ} (hS : 0 ≤ S) (hL : 0 ≤ L) :
    (2 * S / L) ^ (1 / 39 : ℝ) ≤ 2 * (S / L) ^ (1 / 39 : ℝ) := by
  rw [mul_div_assoc, Real.mul_rpow (by norm_num) (div_nonneg hS hL)]
  gcongr
  calc (2 : ℝ) ^ (1 / 39 : ℝ) ≤ 2 ^ (1 : ℝ) :=
        Real.rpow_le_rpow_of_exponent_le (by norm_num) (by norm_num)
    _ = 2 := Real.rpow_one 2

/-- **The stationary contributions (6.15)**, summed over all pairs of cubes, for fixed component
indices. -/
theorem mss_stationary_sum {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B)
    {D : Set (ℝ × ℝ)} (hD : Bornology.IsBounded D) (hDm : MeasurableSet D) {c1 : ℝ}
    (hc1 : 0 < c1) (C0 : ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (h S L : ℝ), 0 < h → 0 < S → 2 * S ≤ L →
    ∀ (M₁ M₂ : Finset (ℤ × ℤ)) (a b : ℤ × ℤ → ℝ → ℝ), (∀ m, Measurable (a m)) →
      (∀ n, Measurable (b n)) → ((∀ m y, c1 * L ≤ |a m y|) ∨ (∀ n x, c1 * L ≤ |b n x|)) →
      ∑ m ∈ M₁, ∑ n ∈ M₂, volume (mssE r A B h C0 S D m n (a m) (b n))
        ≤ ENNReal.ofReal (C * (S / L) ^ (1 / 39 : ℝ)) := by
  obtain ⟨Cs, hCs, hsub⟩ := msub_sublevel hr hA hAB hD (lt_min hc1 one_pos)
  set K : ℕ := ⌊2 * C0⌋₊ + 1 with hKdef
  have hK : 2 * C0 < (K : ℝ) := by
    rw [hKdef]; push_cast; exact Nat.lt_floor_add_one _
  have hKpos : (0 : ℤ) < K := by positivity
  refine ⟨(K : ℝ) ^ 4 * Cs * 2, by positivity, ?_⟩
  intro h S L hh hS hSL M₁ M₂ a b ha hb hab
  have hL : 0 < L := by linarith
  set cl : ℤ × ℤ → ℤ × ℤ := fun m => (m.1 % K, m.2 % K) with hcl
  set T : Finset (ℤ × ℤ) := (Finset.Ico 0 (K : ℤ)) ×ˢ (Finset.Ico 0 (K : ℤ)) with hT
  have hmaps : ∀ M : Finset (ℤ × ℤ), ∀ m ∈ M, cl m ∈ T := by
    intro M m _
    simp only [hT, hcl, Finset.mem_product, Finset.mem_Ico]
    exact ⟨⟨Int.emod_nonneg _ hKpos.ne', Int.emod_lt_of_pos _ hKpos⟩,
      ⟨Int.emod_nonneg _ hKpos.ne', Int.emod_lt_of_pos _ hKpos⟩⟩
  have hdisj : ∀ (M : Finset (ℤ × ℤ)) (c : ℤ × ℤ), ∀ m ∈ M.filter (fun m => cl m = c),
      ∀ m' ∈ M.filter (fun m => cl m = c), m ≠ m' → Disjoint (mssBox h C0 m) (mssBox h C0 m') := by
    intro M c m hm m' hm' hne
    rw [Finset.mem_filter] at hm hm'
    have e : cl m = cl m' := hm.2.trans hm'.2.symm
    simp only [hcl, Prod.mk.injEq] at e
    exact mss_box_disjoint hh hK e.1 e.2 hne
  have hsplit : ∑ m ∈ M₁, ∑ n ∈ M₂, volume (mssE r A B h C0 S D m n (a m) (b n)) =
      ∑ c₁ ∈ T, ∑ c₂ ∈ T, ∑ m ∈ M₁.filter (fun m => cl m = c₁),
        ∑ n ∈ M₂.filter (fun n => cl n = c₂), volume (mssE r A B h C0 S D m n (a m) (b n)) := by
    rw [← Finset.sum_fiberwise_of_maps_to (hmaps M₁)]
    refine Finset.sum_congr rfl fun c₁ _ => ?_
    exact (Finset.sum_congr rfl fun m _ =>
      (Finset.sum_fiberwise_of_maps_to (hmaps M₂) _).symm).trans Finset.sum_comm
  rw [hsplit]
  set y := ENNReal.ofReal (Cs * (2 * S / L) ^ (1 / 39 : ℝ))
  have hpair : ∀ c₁ ∈ T, ∀ c₂ ∈ T, ∑ m ∈ M₁.filter (fun m => cl m = c₁),
      ∑ n ∈ M₂.filter (fun n => cl n = c₂), volume (mssE r A B h C0 S D m n (a m) (b n)) ≤ y :=
    fun c₁ _ c₂ _ => mss_class_pair hr hDm Cs hsub hS hSL (hdisj M₁ c₁) (hdisj M₂ c₂) ha hb hab
  have hcard : T.card = K * K := by
    simp [hT, Finset.card_product, Int.card_Ico]
  calc ∑ c₁ ∈ T, ∑ c₂ ∈ T, ∑ m ∈ M₁.filter (fun m => cl m = c₁),
        ∑ n ∈ M₂.filter (fun n => cl n = c₂), volume (mssE r A B h C0 S D m n (a m) (b n))
      ≤ ∑ c₁ ∈ T, ∑ c₂ ∈ T, y :=
        Finset.sum_le_sum fun c₁ h₁ => Finset.sum_le_sum fun c₂ h₂ => hpair c₁ h₁ c₂ h₂
    _ = ((K : ℝ≥0∞) * K) * ((K * K) * y) := by
        simp only [Finset.sum_const, nsmul_eq_mul, hcard]; push_cast; ring
    _ = ENNReal.ofReal ((K : ℝ) ^ 4 * Cs * (2 * S / L) ^ (1 / 39 : ℝ)) := by
        have hy0 : 0 ≤ Cs * (2 * S / L) ^ (1 / 39 : ℝ) := by positivity
        rw [show (K : ℝ) ^ 4 * Cs * (2 * S / L) ^ (1 / 39 : ℝ) =
          ((K : ℝ) * K) * (((K : ℝ) * K) * (Cs * (2 * S / L) ^ (1 / 39 : ℝ))) by ring]
        rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity),
          ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_natCast, ENNReal.ofReal_mul
            (by positivity),
          ENNReal.ofReal_natCast]
    _ ≤ ENNReal.ofReal ((K : ℝ) ^ 4 * Cs * 2 * (S / L) ^ (1 / 39 : ℝ)) := by
        apply ENNReal.ofReal_le_ofReal
        have := mss_two_rpow_le hS.le hL.le
        have h0 : 0 ≤ (K : ℝ) ^ 4 * Cs := by positivity
        calc (K : ℝ) ^ 4 * Cs * (2 * S / L) ^ (1 / 39 : ℝ)
            ≤ (K : ℝ) ^ 4 * Cs * (2 * (S / L) ^ (1 / 39 : ℝ)) :=
              mul_le_mul_of_nonneg_left this h0
          _ = _ := by ring

end

end Auto

