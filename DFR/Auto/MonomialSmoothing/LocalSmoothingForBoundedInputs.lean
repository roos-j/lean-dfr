namespace Auto
noncomputable section

theorem msub_piece {r : ℝ} {s : Set (ℝ × ℝ × ℝ)} {g : ℝ × ℝ → ℝ} (hg : Measurable g)
    {c : ℝ × ℝ × ℝ} {m ρ δ : ℝ} (hm : 0 < m)
    (hanti : ∀ x ∈ s, ∀ y ∈ s, m * ‖x - y‖ ≤ ‖msubH r x - msubH r y‖)
    (hball : ∀ x ∈ s, ‖msubTh r x - msubTh r c‖ ≤ ρ)
    (hsub : ∀ x ∈ s, |msubLam x - g (msubTh r x)| ≤ δ) :
    volume s ≤ ENNReal.ofReal m⁻¹ ^ 3 *
      (ENNReal.ofReal (2 * δ) * (ENNReal.ofReal (2 * ρ) * ENNReal.ofReal (2 * ρ))) := by
  refine (msub_vol_le_of_antilip hm hanti).trans (mul_le_mul_right ?_ _)
  refine (measure_mono ?_).trans (msub_vol_graph g hg (msubTh r c) ρ δ)
  rintro _ ⟨x, hx, rfl⟩
  refine ⟨?_, hsub x hx⟩
  rw [Metric.mem_closedBall, dist_eq_norm]
  exact hball x hx

/-- Coordinate sublevel estimate (3.9), logarithmic form, with `δ = η^13`. -/
theorem msub_core_eta {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) :
    ∃ C, 0 ≤ C ∧ ∀ g : ℝ × ℝ → ℝ, Measurable g → ∀ η : ℝ, 0 < η → η ≤ 1 →
      volume {t | t ∈ msubI3 A B ∧ |msubLam t - g (msubTh r t)| ≤ η ^ 13} ≤
        ENNReal.ofReal (C * η) := by
  obtain ⟨κ₁, hκ₁, hdet⟩ := msub_det_lower hr hA hAB.le
  obtain ⟨K, L, hK, hL, hal⟩ := msub_antilip hr hA hAB.le
  obtain ⟨Lth, hLth, hth⟩ := msub_Th_lip (r := r) (B := B) hA
  set γ := κ₁ / (2 * K * (L + 1)) with hγ
  have hγ0 : 0 < γ := by positivity
  set C2 := 8 * (B - A + γ) ^ 3 * (2 * K / κ₁) ^ 3 * Lth ^ 2 / γ with hC2
  have hBA : 0 < B - A := sub_pos.mpr hAB
  have hC20 : 0 ≤ C2 := by positivity
  refine ⟨6 * (B - A) ^ 2 + C2, by positivity, ?_⟩
  intro g hg η hη hη1
  set h := γ * η ^ 3 with hh
  set m := κ₁ * η ^ 3 / (2 * K) with hm
  set ρ := Lth * h with hρ
  set δ := η ^ 13 with hδ
  have hh0 : 0 < h := by positivity
  have hm0 : 0 < m := by positivity
  set N := ⌈(B - A) / h⌉₊ with hN
  have hN1 : (B - A) / h ≤ N := Nat.le_ceil _
  have hN2 : (N : ℝ) < (B - A) / h + 1 := Nat.ceil_lt_add_one (by positivity)
  have hNpos : 0 < N := by
    have : (0:ℝ) < N := lt_of_lt_of_le (by positivity) hN1
    exact_mod_cast this
  have hNh : B - A ≤ N * h := by rwa [div_le_iff₀ hh0] at hN1
  set S := {t | t ∈ msubI3 A B ∧ |msubLam t - g (msubTh r t)| ≤ η ^ 13}
  set X := {t : ℝ × ℝ × ℝ | t ∈ msubI3 A B ∧ (|t.1 - t.2.1| < η ∨ |t.1 - t.2.2| < η ∨
      |t.2.1 - t.2.2| < η)}
  set G := {t : ℝ × ℝ × ℝ | η ≤ |t.2.1 - t.1| ∧ η ≤ |t.2.2 - t.1| ∧ η ≤ |t.2.2 - t.2.1|}
  set Bnd := ENNReal.ofReal m⁻¹ ^ 3 *
      (ENNReal.ofReal (2 * δ) * (ENNReal.ofReal (2 * ρ) * ENNReal.ofReal (2 * ρ)))
  -- decomposition
  have hdec : S ⊆ X ∪ ⋃ k : Fin N × Fin N × Fin N, S ∩ G ∩ msubCube A h k := by
    intro t ht
    by_cases hx : |t.1 - t.2.1| < η ∨ |t.1 - t.2.2| < η ∨ |t.2.1 - t.2.2| < η
    · exact Or.inl ⟨ht.1, hx⟩
    · right
      push Not at hx
      obtain ⟨k, hk⟩ := mem_iUnion.mp (msub_cover3 hh0 hNpos hNh ht.1)
      refine mem_iUnion.mpr ⟨k, ⟨ht, ?_, ?_, ?_⟩, hk⟩
      · rw [abs_sub_comm]; exact hx.1
      · rw [abs_sub_comm]; exact hx.2.1
      · rw [abs_sub_comm]; exact hx.2.2
  -- the key constant comparison
  have hLh : L * h ≤ κ₁ * η ^ 3 / (2 * K) := by
    have e : L * h = L / (L + 1) * (κ₁ * η ^ 3 / (2 * K)) := by
      simp only [hh, hγ]; field_simp
    rw [e]
    exact mul_le_of_le_one_left (by positivity) (div_le_one_of_le₀ (by linarith) (by linarith))
  -- bound on each piece
  have hpiece : ∀ k : Fin N × Fin N × Fin N, volume (S ∩ G ∩ msubCube A h k) ≤ Bnd := by
    intro k
    rcases (S ∩ G ∩ msubCube A h k).eq_empty_or_nonempty with he | ⟨c, hc⟩
    · rw [he, measure_empty]; exact bot_le
    · have hcI : c ∈ msubI3 A B := hc.1.1.1
      have hdc : κ₁ * η ^ 3 ≤ |msubDet r c| := by
        refine le_trans ?_ (hdet c hcI)
        apply mul_le_mul_of_nonneg_left _ hκ₁.le
        obtain ⟨g1, g2, g3⟩ := hc.1.2
        unfold msubP
        rw [abs_mul, abs_mul, show η ^ 3 = η * η * η by ring]
        exact mul_le_mul (mul_le_mul g1 g2 hη.le (abs_nonneg _)) g3 hη.le (by positivity)
      have hmle : m ≤ |msubDet r c| / K - L * h := by
        have : κ₁ * η ^ 3 / K ≤ |msubDet r c| / K := div_le_div_of_nonneg_right hdc hK.le
        have e2 : κ₁ * η ^ 3 / K = 2 * m := by simp only [hm]; field_simp
        linarith
      apply msub_piece hg hm0
      · intro x hx y hy
        have hxc := msub_cube_diam hx.2 hc.2
        have hyc := msub_cube_diam hy.2 hc.2
        exact (mul_le_mul_of_nonneg_right hmle (norm_nonneg _)).trans
          (hal c hcI x hx.1.1.1 y hy.1.1.1 h hxc hyc)
      · intro x hx
        exact (hth x hx.1.1.1 c hcI).trans (mul_le_mul_of_nonneg_left
          (msub_cube_diam hx.2 hc.2) hLth)
      · intro x hx; exact hx.1.1.2
  have hsum : volume (⋃ k : Fin N × Fin N × Fin N, S ∩ G ∩ msubCube A h k) ≤
      ((N * (N * N) : ℕ) : ℝ≥0∞) * Bnd := by
    refine (measure_iUnion_fintype_le _ _).trans ?_
    refine (Finset.sum_le_sum fun k _ => hpiece k).trans ?_
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_prod, Fintype.card_prod,
      Fintype.card_fin, nsmul_eq_mul]
  have hXb := msub_vol_X (A := A) (B := B) (η := η)
  -- real form of the bounds
  set R1 := 3 * (2 * η * (B - A) * (B - A))
  set R2 := ((N * (N * N) : ℕ) : ℝ) * (m⁻¹ ^ 3 * (2 * δ * (2 * ρ * (2 * ρ))))
  have hR1 : 3 * (ENNReal.ofReal (2 * η) * ENNReal.ofReal (B - A) * ENNReal.ofReal (B - A)) =
      ENNReal.ofReal R1 := by
    simp only [R1]
    rw [← ENNReal.ofReal_ofNat 3, ← ENNReal.ofReal_mul, ← ENNReal.ofReal_mul, ← ENNReal.ofReal_mul]
      <;> positivity
  have hR2 : ((N * (N * N) : ℕ) : ℝ≥0∞) * Bnd = ENNReal.ofReal R2 := by
    simp only [R2, Bnd]
    rw [← ENNReal.ofReal_natCast, ← ENNReal.ofReal_pow, ← ENNReal.ofReal_mul, ← ENNReal.ofReal_mul,
      ← ENNReal.ofReal_mul, ← ENNReal.ofReal_mul] <;> positivity
  have hR2le : R2 ≤ C2 * η := by
    have hNb : (N : ℝ) ≤ (B - A + γ) / h := by
      have : 1 ≤ γ / h := by
        rw [le_div_iff₀ hh0, one_mul, hh]
        exact mul_le_of_le_one_right hγ0.le (pow_le_one₀ hη.le hη1)
      rw [add_div]; linarith
    have hN3 : ((N * (N * N) : ℕ) : ℝ) ≤ ((B - A + γ) / h) ^ 3 := by
      push_cast
      have := pow_le_pow_left₀ (Nat.cast_nonneg N) hNb 3
      nlinarith [this]
    have hB0 : 0 ≤ m⁻¹ ^ 3 * (2 * δ * (2 * ρ * (2 * ρ))) := by positivity
    calc R2 ≤ ((B - A + γ) / h) ^ 3 * (m⁻¹ ^ 3 * (2 * δ * (2 * ρ * (2 * ρ)))) :=
          mul_le_mul_of_nonneg_right hN3 hB0
      _ = C2 * η := by
          simp only [hh, hm, hρ, hδ, hC2]
          field_simp
          ring
  calc volume S ≤ volume (X ∪ ⋃ k : Fin N × Fin N × Fin N, S ∩ G ∩ msubCube A h k) :=
        measure_mono hdec
    _ ≤ volume X + volume (⋃ k : Fin N × Fin N × Fin N, S ∩ G ∩ msubCube A h k) :=
        measure_union_le _ _
    _ ≤ ENNReal.ofReal R1 + ENNReal.ofReal R2 := by
        rw [← hR1, ← hR2]; exact add_le_add hXb hsum
    _ = ENNReal.ofReal (R1 + R2) := (ENNReal.ofReal_add (by positivity) (by positivity)).symm
    _ ≤ ENNReal.ofReal ((6 * (B - A) ^ 2 + C2) * η) := by
        apply ENNReal.ofReal_le_ofReal
        have : R1 = 6 * (B - A) ^ 2 * η := by simp only [R1]; ring
        rw [this]; nlinarith [hR2le]

end
end Auto

