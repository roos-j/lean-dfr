/-! ### The commutator estimate (6.3) -/
theorem mloc_monoEta_meas (h : ℝ) (m : ℤ × ℤ) : Measurable fun w => (monoEta h m w : ℂ) :=
  Complex.measurable_ofReal.comp (mloc_Eta_contDiff h m).continuous.measurable

theorem mloc_norm_eta_mul_le {h : ℝ} {m : ℤ × ℤ} {f : ℝ × ℝ → ℂ} {M : ℝ} (hM : ∀ z, ‖f z‖ ≤ M)
    (w : ℝ × ℝ) : ‖(monoEta h m w : ℂ) * f w‖ ≤ M := by
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (mloc_Eta_nonneg h m w)]
  exact (mul_le_of_le_one_left (norm_nonneg _) (mloc_Eta_le_one h m w)).trans (hM w)

/-- The moment `∫ |s| L |κ(L s)| ds = L⁻¹ ∫ |s| |κ(s)| ds`. -/
theorem mloc_moment_dil (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L) :
    ∫ s, ‖L * s‖ ^ 1 * ‖κ (L * s)‖ = L⁻¹ * ∫ s, ‖s‖ ^ 1 * ‖κ s‖ := by
  rw [Measure.integral_comp_mul_left (fun s => ‖s‖ ^ 1 * ‖κ s‖) L, abs_inv, abs_of_pos hL,
    smul_eq_mul]

/-- The commutator identity `η P f - P(η f) = ∫ K(s) (η(z) - η(z - s e_j)) f(z - s e_j) ds`. -/
theorem mloc_commutator_eq (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : L ≠ 0) (h : ℝ) (m : ℤ × ℤ)
    {f : ℝ × ℝ → ℂ} (hf : Measurable f) {M : ℝ} (hM : ∀ z, ‖f z‖ ≤ M) (z : ℝ × ℝ) :
    (monoEta h m z : ℂ) * monoP j κ L f z - monoP j κ L (fun w => (monoEta h m w : ℂ) * f w) z =
      ∫ s, (L : ℂ) * κ (L * s) * (((monoEta h m z : ℂ) - monoEta h m (z - monoEj j s)) *
        f (z - monoEj j s)) := by
  have hK := mloc_integrable_dil κ hL
  unfold monoP monoCConv
  rw [← integral_const_mul, ← integral_sub]
  · congr 1; ext s; ring
  · exact (mloc_integrable_conv hK hf hM j z).const_mul _
  · exact mloc_integrable_conv hK ((mloc_monoEta_meas h m).mul hf) (mloc_norm_eta_mul_le hM) j z

/-- **The commutator estimate (6.3)**: `‖[η_m, ϑ(D_j/L)] f‖_∞ ≲ ‖f‖_∞ / (L h)`. -/
theorem mloc_P_commutator (κ : 𝓢(ℝ, ℂ)) : ∃ C : ℝ, 0 ≤ C ∧ ∀ h L : ℝ, 0 < h → 0 < L →
    ∀ (f : ℝ × ℝ → ℂ), Measurable f → ∀ M : ℝ, (∀ z, ‖f z‖ ≤ M) →
    ∀ (m : ℤ × ℤ) (j : Fin 2) (z : ℝ × ℝ),
      ‖(monoEta h m z : ℂ) * monoP j κ L f z - monoP j κ L (fun w => (monoEta h m w : ℂ) * f w) z‖
        ≤ C * M / (L * h) := by
  obtain ⟨Cη, hCη, hlip⟩ := mloc_Eta_lip
  refine ⟨Cη * ∫ s, ‖s‖ ^ 1 * ‖κ s‖, mul_nonneg hCη (integral_nonneg fun _ => by positivity),
    fun h L hh hL f hf M hM m j z => ?_⟩
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM z)
  rw [mloc_commutator_eq j κ hL.ne' h m hf hM z]
  refine (norm_integral_le_integral_norm _).trans ?_
  have hG : Integrable fun s => Cη / h * M * (‖L * s‖ ^ 1 * ‖κ (L * s)‖) :=
    ((κ.integrable_pow_mul volume 1).comp_mul_left' hL.ne').const_mul _
  calc _ ≤ ∫ s, Cη / h * M * (‖L * s‖ ^ 1 * ‖κ (L * s)‖) := by
        refine integral_mono_of_nonneg (Eventually.of_forall fun s => norm_nonneg _) hG
          (Eventually.of_forall fun s => ?_)
        dsimp only
        have hl := hlip h hh m j (z - monoEj j s) s
        rw [sub_add_cancel] at hl
        rw [norm_mul, norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hL,
          ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs, pow_one, Real.norm_eq_abs,
          abs_mul, abs_of_pos hL]
        have h1 := hM (z - monoEj j s)
        have hk := norm_nonneg (κ (L * s))
        calc L * ‖κ (L * s)‖ * (|monoEta h m z - monoEta h m (z - monoEj j s)| *
              ‖f (z - monoEj j s)‖)
            ≤ L * ‖κ (L * s)‖ * (Cη / h * |s| * M) := by
              apply mul_le_mul_of_nonneg_left _ (by positivity)
              exact mul_le_mul hl h1 (norm_nonneg _) (by positivity)
          _ = _ := by ring
    _ = Cη * (∫ s, ‖s‖ ^ 1 * ‖κ s‖) * M / (L * h) := by
        rw [integral_const_mul, mloc_moment_dil κ hL]
        field_simp

end

