/-! ### Bilinearity and crude bounds for `χ T_ψ` -/
theorem integrable_monoT_integrand {r : ℝ} (hr : 0 < r) {ψ : ℝ → ℝ} (hψ : Integrable ψ volume)
    {a b : ℝ × ℝ → ℂ} (ha : Measurable a) (hb : Measurable b) {α β : ℝ} (hα : ∀ z, ‖a z‖ ≤ α)
    (hβ : ∀ z, ‖b z‖ ≤ β) (z : ℝ × ℝ) :
    Integrable (fun t => (ψ t : ℂ) * (a (z.1 + t, z.2) * b (z.1, z.2 + monoQ r t))) volume := by
  refine ((hψ.norm.mul_const (α * β))).mono' ?_ (Eventually.of_forall fun t => ?_)
  · refine (Complex.continuous_ofReal.comp_aestronglyMeasurable hψ.1).mul ?_
    exact ((ha.comp (measurable_const.add measurable_id |>.prodMk measurable_const)).mul
        (hb.comp (measurable_const.prodMk (measurable_const.add
          (continuous_monoQ hr).measurable)))).aestronglyMeasurable
  · rw [norm_mul, norm_mul, Complex.norm_real]
    have hα0 : 0 ≤ α := (norm_nonneg _).trans (hα z)
    exact mul_le_mul_of_nonneg_left (mul_le_mul (hα _) (hβ _) (norm_nonneg _) hα0) (norm_nonneg _)

theorem monoT_add_left {r : ℝ} (hr : 0 < r) {ψ : ℝ → ℝ} (hψ : Integrable ψ volume)
    {a₁ a₂ b : ℝ × ℝ → ℂ} (h₁ : Measurable a₁) (h₂ : Measurable a₂) (hb : Measurable b)
    {α₁ α₂ β : ℝ} (hα₁ : ∀ z, ‖a₁ z‖ ≤ α₁) (hα₂ : ∀ z, ‖a₂ z‖ ≤ α₂) (hβ : ∀ z, ‖b z‖ ≤ β) (z : ℝ ×
      ℝ) :
    monoT r ψ (a₁ + a₂) b z = monoT r ψ a₁ b z + monoT r ψ a₂ b z := by
  unfold monoT
  rw [← integral_add (integrable_monoT_integrand hr hψ h₁ hb hα₁ hβ z)
    (integrable_monoT_integrand hr hψ h₂ hb hα₂ hβ z)]
  congr 1; funext t; simp only [Pi.add_apply]; ring

theorem monoT_add_right {r : ℝ} (hr : 0 < r) {ψ : ℝ → ℝ} (hψ : Integrable ψ volume)
    {a b₁ b₂ : ℝ × ℝ → ℂ} (ha : Measurable a) (h₁ : Measurable b₁) (h₂ : Measurable b₂)
    {α β₁ β₂ : ℝ} (hα : ∀ z, ‖a z‖ ≤ α) (hβ₁ : ∀ z, ‖b₁ z‖ ≤ β₁) (hβ₂ : ∀ z, ‖b₂ z‖ ≤ β₂) (z : ℝ ×
      ℝ) :
    monoT r ψ a (b₁ + b₂) z = monoT r ψ a b₁ z + monoT r ψ a b₂ z := by
  unfold monoT
  rw [← integral_add (integrable_monoT_integrand hr hψ ha h₁ hα hβ₁ z)
    (integrable_monoT_integrand hr hψ ha h₂ hα hβ₂ z)]
  congr 1; funext t; simp only [Pi.add_apply]; ring


theorem measurable_chiT {r : ℝ} (hr : 0 < r) {χ : ℝ × ℝ → ℝ} (hχ : Measurable χ) {ψ : ℝ → ℝ}
    (hψ : Measurable ψ) {a b : ℝ × ℝ → ℂ} (ha : Measurable a) (hb : Measurable b) :
    Measurable fun z => (χ z : ℂ) * monoT r ψ a b z :=
  (Complex.measurable_ofReal.comp hχ).mul (measurable_monoT hr hψ ha hb)

/-- **The crude local bound**: `‖χ T_ψ(a,b)‖_1 ≤ ‖χ‖_1 ‖ψ‖_1 α β` when `|a| ≤ α` and `|b| ≤ β` at
all points reached from `supp χ` with `t ∈ supp ψ`. -/
theorem eLpNorm_chiT_le {r : ℝ} {χ : ℝ × ℝ → ℝ} (hχi : Integrable χ volume) {ψ : ℝ → ℝ}
    (hψi : Integrable ψ volume) {A B : ℝ} (hψs : ∀ t, t ∉ Icc A B → ψ t = 0) {a b : ℝ × ℝ → ℂ} {α
      β : ℝ} (hα0 : 0 ≤ α)
    (hα : ∀ z, χ z ≠ 0 → ∀ t ∈ Icc A B, ‖a (z.1 + t, z.2)‖ ≤ α)
    (hβ : ∀ z, χ z ≠ 0 → ∀ t ∈ Icc A B, ‖b (z.1, z.2 + monoQ r t)‖ ≤ β)
    (hm : AEStronglyMeasurable (fun z => (χ z : ℂ) * monoT r ψ a b z) volume := by fun_prop) :
    eLpNorm (fun z => (χ z : ℂ) * monoT r ψ a b z) 1 volume
      ≤ ENNReal.ofReal ((∫ z, |χ z|) * (∫ t, |ψ t|) * α * β) := by
  rw [eLpNorm_one_eq_lintegral_enorm (by fun_prop)]
  have hpt2 : ∀ z, ‖(χ z : ℂ) * monoT r ψ a b z‖ₑ ≤ ‖χ z‖ₑ * ((∫⁻ t, ‖ψ t‖ₑ) * ENNReal.ofReal (α *
    β)) := by
    intro z
    rw [enorm_mul, monoEnorm_ofReal]
    by_cases hz : χ z = 0
    · simp [hz]
    refine mul_le_mul' le_rfl ((enorm_monoT_le r ψ a b z).trans ?_)
    rw [← lintegral_mul_const' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_mono fun t => ?_
    by_cases ht : t ∈ Icc A B
    · rw [ENNReal.ofReal_mul hα0]
      gcongr
      · rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal (hα z hz t ht)
      · rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal (hβ z hz t ht)
    · simp [hψs t ht]
  have hχl : ∫⁻ z, ‖χ z‖ₑ = ENNReal.ofReal (∫ z, |χ z|) := by
    rw [ofReal_integral_eq_lintegral_ofReal hχi.abs (Eventually.of_forall fun _ => abs_nonneg _)]
    exact lintegral_congr fun z => by rw [← ofReal_norm, Real.norm_eq_abs]
  have hψl : ∫⁻ t, ‖ψ t‖ₑ = ENNReal.ofReal (∫ t, |ψ t|) := by
    rw [ofReal_integral_eq_lintegral_ofReal hψi.abs (Eventually.of_forall fun _ => abs_nonneg _)]
    exact lintegral_congr fun t => by rw [← ofReal_norm, Real.norm_eq_abs]
  calc ∫⁻ z, ‖(χ z : ℂ) * monoT r ψ a b z‖ₑ
      ≤ ∫⁻ z, ‖χ z‖ₑ * ((∫⁻ t, ‖ψ t‖ₑ) * ENNReal.ofReal (α * β)) := lintegral_mono hpt2
    _ = (∫⁻ z, ‖χ z‖ₑ) * ((∫⁻ t, ‖ψ t‖ₑ) * ENNReal.ofReal (α * β)) :=
        lintegral_mul_const' _ _ (ENNReal.mul_ne_top (by rw [hψl]; exact ENNReal.ofReal_ne_top)
          ENNReal.ofReal_ne_top)
    _ = _ := by
        rw [hχl, hψl, ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul
          (integral_nonneg fun _ => abs_nonneg _)]
        congr 1; ring

end

