    intro x
    have h0 : 𝓕⁻ (𝓕 χ : 𝓢(ℝ, ℂ)) = χ := fourierInv_fourier_eq χ
    have h := congrFun (congrArg (⇑) h0) x
    rw [SchwartzMap.fourierInv_coe, SchwartzMap.fourier_coe, Real.fourierInv_eq] at h
    rw [← h]
    refine integral_congr_ae (Eventually.of_forall fun η => ?_)
    simp only [Circle.smul_def, smul_eq_mul, RCLike.inner_apply,
      conj_trivial]
    ring_nf
  have hχ1 : Integrable (𝓕 (⇑χ)) volume := by
    rw [← SchwartzMap.fourier_coe]; exact (𝓕 χ).integrable
  rw [Real.fourier_real_eq]
  have e1 : ∀ x : ℝ, 𝐞 (-(x * ξ)) • (χ x * G x)
      = ∫ η, (𝐞 (-(x * (ξ - η))) : ℂ) * G x * 𝓕 (⇑χ) η := by
    intro x
    rw [hinv x, Circle.smul_def, smul_eq_mul, ← integral_mul_const, ← integral_const_mul]
    refine integral_congr_ae (Eventually.of_forall fun η => ?_)
    simp only
    have : (𝐞 (-(x * ξ)) : ℂ) * (𝐞 (η * x) : ℂ) = 𝐞 (-(x * (ξ - η))) := by
      rw [← Circle.coe_mul, ← AddChar.map_add_eq_mul]; congr 2; ring
    rw [← this]; ring
  simp_rw [e1]
  rw [integral_integral_swap]
  · refine integral_congr_ae (Eventually.of_forall fun η => ?_)
    simp only
    rw [integral_mul_const, Real.fourier_real_eq, mul_comm]
    congr 1
    refine integral_congr_ae (Eventually.of_forall fun x => ?_)
    simp [Circle.smul_def, mul_comm]
  · have h := hG.mul_prod hχ1
    have hm : AEStronglyMeasurable (Function.uncurry fun (v η : ℝ) =>
        ((𝐞 (-(v * (ξ - η))) : Circle) : ℂ) * G v * 𝓕 (⇑χ) η) (volume.prod volume) := by
      have hc : Continuous fun p : ℝ × ℝ => ((𝐞 (-(p.1 * (ξ - p.2))) : Circle) : ℂ) := by fun_prop
      refine (hc.aestronglyMeasurable.mul h.1).congr (Eventually.of_forall fun p => ?_)
      simp only [Function.uncurry, Pi.mul_apply]; ring
    refine h.norm.mono' hm (Eventually.of_forall fun p => ?_)
    simp only [Function.uncurry, norm_mul, Circle.norm_coe, one_mul]
    exact le_rfl

/-- Weighted Cauchy-Schwarz: `(∫ w g)^2 ≤ (∫ w)(∫ w g^2)`. -/
theorem lintegral_mul_sq_le {w g : ℝ → ℝ≥0∞} (hw : Measurable w) (hg : Measurable g) :
    (∫⁻ x, w x * g x) ^ 2 ≤ (∫⁻ x, w x) * ∫⁻ x, w x * g x ^ 2 := by
  have h := ENNReal.lintegral_mul_le_Lp_mul_Lq volume Real.HolderConjugate.two_two
    (f := fun x => w x ^ (1 / 2 : ℝ)) (g := fun x => w x ^ (1 / 2 : ℝ) * g x)
    (hw.pow_const _).aemeasurable ((hw.pow_const _).mul hg).aemeasurable
  have e1 : ∀ x, w x ^ (1 / 2 : ℝ) * (w x ^ (1 / 2 : ℝ) * g x) = w x * g x := by
    intro x
    rw [← mul_assoc, ← ENNReal.rpow_add_of_nonneg _ _ (by norm_num) (by norm_num)]; norm_num
  have e2 : ∀ x, (w x ^ (1 / 2 : ℝ)) ^ (2 : ℝ) = w x := by
    intro x; rw [← ENNReal.rpow_mul]; norm_num
  have e3 : ∀ x, (w x ^ (1 / 2 : ℝ) * g x) ^ (2 : ℝ) = w x * g x ^ 2 := by
    intro x; rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), e2]; norm_cast
  simp only [Pi.mul_apply, e1, e2, e3] at h
  have h2 := pow_le_pow_left₀ bot_le h 2
  calc (∫⁻ x, w x * g x) ^ 2
      ≤ ((∫⁻ x, w x) ^ (1 / 2 : ℝ) * (∫⁻ x, w x * g x ^ 2) ^ (1 / 2 : ℝ)) ^ 2 := h2
    _ = (∫⁻ x, w x) * ∫⁻ x, w x * g x ^ 2 := by
        rw [mul_pow, ← ENNReal.rpow_natCast, ← ENNReal.rpow_natCast, ← ENNReal.rpow_mul,
          ← ENNReal.rpow_mul]; norm_num

end

end Auto

