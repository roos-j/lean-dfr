theorem mimp_hasDerivAt_monoq {r t : ℝ} (ht : 0 < t) :
    HasDerivAt (monoq r) (r * ((r - 1) * t ^ (r - 1 - 1))) t := by
  unfold monoq
  exact (Real.hasDerivAt_rpow_const (Or.inl ht.ne')).const_mul r

theorem mimp_monoq_lt {r a b : ℝ} (hr : 1 < r) (ha : 0 < a) (hab : a < b) :
    monoq r a < monoq r b := by
  unfold monoq
  have := Real.rpow_lt_rpow ha.le hab (by linarith : 0 < r - 1)
  nlinarith

theorem mimp_monoq_le {r a b : ℝ} (hr : 1 < r) (ha : 0 < a) (hab : a ≤ b) :
    monoq r a ≤ monoq r b := by
  rcases hab.lt_or_eq with h | h
  · exact (mimp_monoq_lt hr ha h).le
  · rw [h]

theorem mimp_monoq_pos {r a : ℝ} (hr : 1 < r) (ha : 0 < a) : 0 < monoq r a := by
  unfold monoq
  have := Real.rpow_pos_of_pos ha (r - 1)
  positivity

/-- Lower bound `|q b - q a| ≥ c |b - a|` on `I`. -/
theorem mimp_monoq_sep {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) :
    ∃ c : ℝ, 0 < c ∧ ∀ a ∈ Icc A B, ∀ b ∈ Icc A B, c * |b - a| ≤ |monoq r b - monoq r a| := by
  set d : ℝ → ℝ := fun t => r * ((r - 1) * t ^ (r - 1 - 1)) with hd
  have hcont : ContinuousOn d (Icc A B) := by
    apply ContinuousOn.mul continuousOn_const
    apply ContinuousOn.mul continuousOn_const
    exact continuousOn_id.rpow_const fun x hx => Or.inl (by
      have : 0 < x := lt_of_lt_of_le hA hx.1
      exact this.ne')
  obtain ⟨t0, ht0, hmin⟩ := isCompact_Icc.exists_isMinOn (nonempty_Icc.2 hAB.le) hcont
  have hpos : ∀ t, 0 < t → 0 < d t := fun t ht => by
    have := Real.rpow_pos_of_pos ht (r - 1 - 1)
    have h1 : 0 < r - 1 := by linarith
    simp only [hd]; positivity
  refine ⟨d t0, hpos t0 (lt_of_lt_of_le hA ht0.1), ?_⟩
  have key : ∀ a ∈ Icc A B, ∀ b ∈ Icc A B, a < b →
      d t0 * |b - a| ≤ |monoq r b - monoq r a| := by
    intro a ha b hb hab
    have ha0 : 0 < a := lt_of_lt_of_le hA ha.1
    obtain ⟨ξ, hξ, hξeq⟩ := exists_hasDerivAt_eq_slope (monoq r) d hab
      (fun x hx => (mimp_hasDerivAt_monoq (lt_of_lt_of_le ha0
        hx.1)).continuousAt.continuousWithinAt)
      (fun x hx => mimp_hasDerivAt_monoq (lt_trans ha0 hx.1))
    have hξI : ξ ∈ Icc A B := ⟨by linarith [ha.1, hξ.1], by linarith [hb.2, hξ.2]⟩
    have hle : d t0 ≤ d ξ := hmin hξI
    have hba : 0 < b - a := by linarith
    have heq : monoq r b - monoq r a = d ξ * (b - a) := by
      rw [hξeq]; field_simp
    rw [heq, abs_of_pos hba, abs_of_pos (mul_pos (hpos ξ (lt_trans ha0 hξ.1)) hba)]
    exact mul_le_mul_of_nonneg_right hle hba.le
  intro a ha b hb
  rcases lt_trichotomy a b with h | h | h
  · exact key a ha b hb h
  · subst h; simp
  · rw [abs_sub_comm b a, abs_sub_comm (monoq r b)]
    exact key b hb a ha h

/-- Lipschitz bound `|Q b - Q a| ≤ q(B) |b - a|` on `I`. -/
theorem mimp_monoQ_lip {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) :
    ∀ a ∈ Icc A B, ∀ b ∈ Icc A B, |monoQ r b - monoQ r a| ≤ monoq r B * |b - a| := by
  have key : ∀ a ∈ Icc A B, ∀ b ∈ Icc A B, a < b →
      |monoQ r b - monoQ r a| ≤ monoq r B * |b - a| := by
    intro a ha b hb hab
    have ha0 : 0 < a := lt_of_lt_of_le hA ha.1
    obtain ⟨ξ, hξ, hξeq⟩ := exists_hasDerivAt_eq_slope (monoQ r) (monoq r) hab
      (fun x hx => (hasDerivAt_monoQ r (lt_of_lt_of_le ha0 hx.1)).continuousAt.continuousWithinAt)
      (fun x hx => hasDerivAt_monoQ r (lt_trans ha0 hx.1))
    have hba : 0 < b - a := by linarith
    have heq : monoQ r b - monoQ r a = monoq r ξ * (b - a) := by
      rw [hξeq]; field_simp
    have hξ0 : 0 < ξ := lt_trans ha0 hξ.1
    rw [heq, abs_of_pos hba, abs_of_pos (mul_pos (mimp_monoq_pos hr hξ0) hba)]
    exact mul_le_mul_of_nonneg_right (mimp_monoq_le hr hξ0 (by linarith [hξ.2, hb.2])) hba.le
  intro a ha b hb
  rcases lt_trichotomy a b with h | h | h
  · exact key a ha b hb h
  · subst h; simp
  · rw [abs_sub_comm b a, abs_sub_comm (monoQ r b)]
    exact key b hb a ha h

end

