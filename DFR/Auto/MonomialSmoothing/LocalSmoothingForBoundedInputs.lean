open MeasureTheory Set Filter Topology
open scoped ENNReal NNReal

namespace Auto
noncomputable section

/-- The triple set `𝒜(z₀)` of (3.13). -/
def msubA (Γ : ℝ → ℝ × ℝ) (E : Set ((ℝ × ℝ) × ℝ)) (z0 : ℝ × ℝ) : Set (ℝ × ℝ × ℝ) :=
  {t | (z0, t.1) ∈ E ∧ (z0 + Γ t.1 - Γ t.2.1, t.2.1) ∈ E ∧ (z0 + Γ t.1 - Γ t.2.1, t.2.2) ∈ E}

theorem msub_volA {Γ : ℝ → ℝ × ℝ} (hΓ : Measurable Γ) {E : Set ((ℝ × ℝ) × ℝ)}
    (hE : MeasurableSet E) (z0 : ℝ × ℝ) :
    volume (msubA Γ E z0) = ∫⁻ t1, E.indicator 1 (z0, t1) *
      ∫⁻ s, E.indicator 1 (z0 + Γ t1 - Γ s, s) * volume (Prod.mk (z0 + Γ t1 - Γ s) ⁻¹' E) := by
  have hA : MeasurableSet (msubA Γ E z0) :=
    ((by fun_prop : Measurable fun t : ℝ × ℝ × ℝ => (z0, t.1)) hE).inter
      (((by fun_prop : Measurable fun t : ℝ × ℝ × ℝ => (z0 + Γ t.1 - Γ t.2.1, t.2.1)) hE).inter
      ((by fun_prop : Measurable fun t : ℝ × ℝ × ℝ => (z0 + Γ t.1 - Γ t.2.1, t.2.2)) hE))
  rw [show (volume : Measure (ℝ × ℝ × ℝ)) = volume.prod volume from rfl, Measure.prod_apply hA]
  refine lintegral_congr fun t1 => ?_
  rw [show (volume : Measure (ℝ × ℝ)) = volume.prod volume from rfl,
    Measure.prod_apply (measurable_prodMk_left hA)]
  rw [← lintegral_const_mul]
  · refine lintegral_congr fun s => ?_
    by_cases h1 : (z0, t1) ∈ E
    · by_cases h2 : (z0 + Γ t1 - Γ s, s) ∈ E
      · rw [indicator_of_mem h1, indicator_of_mem h2]
        simp only [Pi.one_apply, one_mul]
        congr 1
        ext t3
        simp [msubA, h1, h2]
      · rw [indicator_of_notMem h2]
        simp only [zero_mul, mul_zero]
        rw [show Prod.mk s ⁻¹' (Prod.mk t1 ⁻¹' msubA Γ E z0) = ∅ from
          eq_empty_of_forall_notMem fun t3 ht3 => h2 ht3.2.1]
        exact measure_empty
    · rw [indicator_of_notMem h1]
      simp only [zero_mul]
      rw [show Prod.mk s ⁻¹' (Prod.mk t1 ⁻¹' msubA Γ E z0) = ∅ from
        eq_empty_of_forall_notMem fun t3 ht3 => h1 ht3.1]
      exact measure_empty
  · have hdA : Measurable fun z : ℝ × ℝ => volume (Prod.mk z ⁻¹' E) :=
      measurable_measure_prodMk_left hE
    have hiE : Measurable (E.indicator (1 : (ℝ × ℝ) × ℝ → ℝ≥0∞)) :=
      measurable_one.indicator hE
    exact (hiE.comp (by fun_prop)).mul (hdA.comp (by fun_prop))

theorem msub_real_step {x u v g : ℝ} {G : ℝ≥0∞} (hG : G ≠ ∞) (hg : g = G.toReal)
    (hu : 0 ≤ u) (hv : 0 ≤ v)
    (h : ENNReal.ofReal x ≤ ENNReal.ofReal u + ENNReal.ofReal v + G) : x ≤ u + v + g := by
  rw [← ENNReal.ofReal_toReal hG, ← ENNReal.ofReal_add hu hv,
    ← ENNReal.ofReal_add (by positivity) ENNReal.toReal_nonneg] at h
  rw [hg]
  exact (ENNReal.ofReal_le_ofReal_iff (by positivity)).mp h

/-- The three successive relations, measure-theoretic part: `μ³ ≲ sup |𝒜(z₀)|`. -/
theorem msub_P3 {Γ : ℝ → ℝ × ℝ} (hΓ : Measurable Γ) {E : Set ((ℝ × ℝ) × ℝ)}
    (hE : MeasurableSet E) {D0 D1 : Set (ℝ × ℝ)} (hD0 : MeasurableSet D0)
    (hD1 : MeasurableSet D1) (hD0f : volume D0 ≠ ∞) (hD1f : volume D1 ≠ ∞)
    (hD0p : 0 < (volume D0).toReal) (hD1p : 0 < (volume D1).toReal)
    (hE0 : ∀ p ∈ E, p.1 ∈ D0) (hE1 : ∀ p ∈ E, p.1 + Γ p.2 ∈ D1) (hEf : volume E ≠ ∞)
    {y : ℝ} (hy : 0 ≤ y) (hY : ∀ z0 ∈ D0, volume (msubA Γ E z0) ≤ ENNReal.ofReal y) :
    (volume E).toReal ^ 3 ≤ 32 * (volume D0).toReal ^ 2 * (volume D1).toReal * y := by
  set iE : (ℝ × ℝ) × ℝ → ℝ≥0∞ := E.indicator 1 with hiEdef
  have hiE : Measurable iE := measurable_one.indicator hE
  set dA : ℝ × ℝ → ℝ≥0∞ := fun z => volume (Prod.mk z ⁻¹' E) with hdAdef
  have hdA : Measurable dA := measurable_measure_prodMk_left hE
  set dB : ℝ × ℝ → ℝ≥0∞ := fun w => ∫⁻ t, iE (w - Γ t, t) with hdBdef
  have hdB : Measurable dB :=
    Measurable.lintegral_prod_right' (f := fun q : (ℝ × ℝ) × ℝ => iE (q.1 - Γ q.2, q.2))
      (by fun_prop)
  set P := ∫⁻ p, iE p * (dA p.1 * dB (p.1 + Γ p.2)) with hP
  -- (i) P = ∫ |𝒜(z₀)|
  have hPA : P = ∫⁻ z0, volume (msubA Γ E z0) := by
    simp_rw [msub_volA hΓ hE]
    rw [hP, ← msub_fub_core hΓ hiE hdA]
    rw [show (volume : Measure ((ℝ × ℝ) × ℝ)) = volume.prod volume from rfl, lintegral_prod]
    refine Measurable.aemeasurable (hiE.mul ?_)
    exact Measurable.lintegral_prod_right' (f := fun q : ((ℝ × ℝ) × ℝ) × ℝ =>
      iE (q.1.1 + Γ q.1.2 - Γ q.2, q.2) * dA (q.1.1 + Γ q.1.2 - Γ q.2)) (by fun_prop)
  -- (ii) upper bound
  have hPup : P ≤ ENNReal.ofReal y * volume D0 := by
    rw [hPA, ← lintegral_indicator_const hD0]
    refine lintegral_mono fun z0 => ?_
    by_cases hz : z0 ∈ D0
    · rw [indicator_of_mem hz]; exact hY z0 hz
    · rw [indicator_of_notMem hz, show msubA Γ E z0 = ∅ from
        eq_empty_of_forall_notMem fun t ht => hz (hE0 _ ht.1)]
      simp
  -- (iii) pruning
  set x := (volume E).toReal
  set m0 := (volume D0).toReal
  set m1 := (volume D1).toReal
  have hx : 0 ≤ x := ENNReal.toReal_nonneg
  set a := ENNReal.ofReal (x / (4 * m0))
  set b := ENNReal.ofReal (x / (4 * m1))
  set lowA := E ∩ {p | dA p.1 < a}
  set lowB := E ∩ {p | dB (p.1 + Γ p.2) < b}
  set good := E ∩ {p | a ≤ dA p.1} ∩ {p | b ≤ dB (p.1 + Γ p.2)}
  have hlowA : volume lowA ≤ ENNReal.ofReal (x / 4) := by
    refine (msub_prune hE hD0 hE0 a).trans (le_of_eq ?_)
    rw [← ENNReal.ofReal_toReal hD0f, ← ENNReal.ofReal_mul (by positivity)]
    congr 1; field_simp; rfl
  set E' := (fun p : (ℝ × ℝ) × ℝ => (p.1 - Γ p.2, p.2)) ⁻¹' E
  have hE' : MeasurableSet E' := (by fun_prop : Measurable fun p : (ℝ × ℝ) × ℝ =>
    (p.1 - Γ p.2, p.2)) hE
  have hdBE' : ∀ w, dB w = volume (Prod.mk w ⁻¹' E') := by
    intro w
    rw [← lintegral_indicator_one (measurable_prodMk_left hE')]
    rfl
  have hlowB : volume lowB ≤ ENNReal.ofReal (x / 4) := by
    have hS : MeasurableSet (E' ∩ {q | volume (Prod.mk q.1 ⁻¹' E') < b}) :=
      hE'.inter (measurableSet_lt ((measurable_measure_prodMk_left hE').comp measurable_fst)
        measurable_const)
    have heq : lowB = (fun p : (ℝ × ℝ) × ℝ => (p.1 + Γ p.2, p.2)) ⁻¹'
        (E' ∩ {q | volume (Prod.mk q.1 ⁻¹' E') < b}) := by
      ext p
      simp only [lowB, E', mem_inter_iff, mem_ofPred_eq, mem_preimage, add_sub_cancel_right,
        hdBE']
    rw [heq, msub_shear hΓ hS]
    refine (msub_prune hE' hD1 (fun p hp => ?_) b).trans (le_of_eq ?_)
    · have := hE1 _ hp
      simpa using this
    · rw [← ENNReal.ofReal_toReal hD1f, ← ENNReal.ofReal_mul (by positivity)]
      congr 1; field_simp; rfl
  have hgoodm : MeasurableSet good :=
    (hE.inter (measurableSet_le measurable_const (hdA.comp measurable_fst))).inter
      (measurableSet_le measurable_const (hdB.comp (measurable_fst.add
        (hΓ.comp measurable_snd))))
  have hcover : volume E ≤ ENNReal.ofReal (x / 4) + ENNReal.ofReal (x / 4) + volume good := by
    have hsub : E ⊆ lowA ∪ lowB ∪ good := by
      intro p hp
      by_cases h1 : dA p.1 < a
      · exact Or.inl (Or.inl ⟨hp, h1⟩)
      · by_cases h2 : dB (p.1 + Γ p.2) < b
        · exact Or.inl (Or.inr ⟨hp, h2⟩)
        · exact Or.inr ⟨⟨hp, not_lt.mp h1⟩, not_lt.mp h2⟩
    calc volume E ≤ volume (lowA ∪ lowB ∪ good) := measure_mono hsub
      _ ≤ volume (lowA ∪ lowB) + volume good := measure_union_le _ _
      _ ≤ volume lowA + volume lowB + volume good :=
          add_le_add (measure_union_le _ _) le_rfl
      _ ≤ _ := add_le_add (add_le_add hlowA hlowB) le_rfl
  have hPlow : a * b * volume good ≤ P := by
    rw [← lintegral_indicator_const hgoodm]
    refine lintegral_mono fun p => ?_
    by_cases hp : p ∈ good
    · rw [indicator_of_mem hp]
      have : iE p = 1 := by simp [iE, indicator_of_mem hp.1.1]
      rw [this, one_mul]
      exact mul_le_mul' hp.1.2 hp.2
    · rw [indicator_of_notMem hp]; exact zero_le
  -- real arithmetic
  have hgf : volume good ≠ ∞ := ne_top_of_le_ne_top hEf (measure_mono fun p hp => hp.1.1)
  have hr1 : x ≤ x / 4 + x / 4 + (volume good).toReal := by
    refine msub_real_step hgf rfl (by positivity) (by positivity) ?_
    rw [ENNReal.ofReal_toReal hEf]; exact hcover
  have hr2 : x / (4 * m0) * (x / (4 * m1)) * (volume good).toReal ≤ y * m0 := by
    have h := hPlow.trans hPup
    rw [← ENNReal.ofReal_toReal hgf, ← ENNReal.ofReal_mul (by positivity),
      ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_toReal hD0f,
      ← ENNReal.ofReal_mul hy] at h
    exact (ENNReal.ofReal_le_ofReal_iff (by positivity)).mp h
  have hg2 : x / 2 ≤ (volume good).toReal := by linarith
  have h3 : x / (4 * m0) * (x / (4 * m1)) * (x / 2) ≤ y * m0 :=
    le_trans (mul_le_mul_of_nonneg_left hg2 (by positivity)) hr2
  have e : x ^ 3 = 32 * m0 * m1 * (x / (4 * m0) * (x / (4 * m1)) * (x / 2)) := by
    field_simp; ring
  rw [e]
  calc 32 * m0 * m1 * (x / (4 * m0) * (x / (4 * m1)) * (x / 2)) ≤ 32 * m0 * m1 * (y * m0) :=
        mul_le_mul_of_nonneg_left h3 (by positivity)
    _ = 32 * m0 ^ 2 * m1 * y := by ring

end
