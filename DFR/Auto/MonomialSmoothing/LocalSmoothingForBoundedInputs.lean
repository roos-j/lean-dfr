open MeasureTheory Set Filter Topology
open scoped ENNReal NNReal

namespace Auto
noncomputable section

theorem msub_log_q {r x : ℝ} (hr : 0 < r) (hx : 0 < x) :
    Real.log (monoq r x) = Real.log r + (r - 1) * Real.log x := by
  unfold monoq
  rw [Real.log_mul hr.ne' (Real.rpow_pos_of_pos hx _).ne', Real.log_rpow hx]

theorem msub_q_pos {r x : ℝ} (hr : 0 < r) (hx : 0 < x) : 0 < monoq r x :=
  mul_pos hr (Real.rpow_pos_of_pos hx _)

/-- (3.9) for `ν = q(t₂)/(q(t₁)q(t₃))`. -/
theorem msub_nu_alpha {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) {c0 : ℝ}
    (hc0 : 0 < c0) :
    ∃ C, 0 ≤ C ∧ ∀ a0 : ℝ, c0 ≤ |a0| → ∀ b : ℝ × ℝ → ℝ, Measurable b → ∀ ε : ℝ, 0 < ε →
      volume {t | t ∈ msubI3 A B ∧
        |a0 * (monoq r t.2.1 / (monoq r t.1 * monoq r t.2.2)) - b (msubTh r t)| ≤ ε} ≤
        ENNReal.ofReal (C * ε ^ (1 / 13 : ℝ)) := by
  have hr0 : 0 < r := by linarith
  obtain ⟨qm, qM, hqm, hq⟩ := msub_q_bounds hr0 hA hAB.le
  have hqM : 0 < qM := lt_of_lt_of_le hqm ((hq A ⟨le_rfl, hAB.le⟩).1.trans
    (hq A ⟨le_rfl, hAB.le⟩).2)
  refine msub_nu_form hr hA hAB hc0 (νm := qm / (qM * qM)) (p' := r - 1) (k := -Real.log r)
    (by positivity) (by linarith) ?_
  rintro t ⟨h0, h1, h2⟩
  have p0 := lt_of_lt_of_le hA h0.1
  have p1 := lt_of_lt_of_le hA h1.1
  have p2 := lt_of_lt_of_le hA h2.1
  have q0 := msub_q_pos hr0 p0
  have q1 := msub_q_pos hr0 p1
  have q2 := msub_q_pos hr0 p2
  constructor
  · rw [div_le_div_iff₀ (by positivity) (by positivity)]
    have a1 := (hq _ h1).1
    have a0 := (hq _ h0).2
    have a2 := (hq _ h2).2
    have : monoq r t.1 * monoq r t.2.2 ≤ qM * qM := mul_le_mul a0 a2 q2.le hqM.le
    nlinarith [mul_le_mul a1 this (by positivity) q1.le]
  · rw [Real.log_div q1.ne' (by positivity), Real.log_mul q0.ne' q2.ne', msub_log_q hr0 p0,
      msub_log_q hr0 p1, msub_log_q hr0 p2]
    unfold msubLam; ring

/-- (3.9) for the reversed scalar coordinate `ν⁻¹` (the `β` case). -/
theorem msub_nu_beta {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) {c0 : ℝ}
    (hc0 : 0 < c0) :
    ∃ C, 0 ≤ C ∧ ∀ a0 : ℝ, c0 ≤ |a0| → ∀ b : ℝ × ℝ → ℝ, Measurable b → ∀ ε : ℝ, 0 < ε →
      volume {t | t ∈ msubI3 A B ∧
        |a0 * ((monoq r t.2.1)⁻¹ / ((monoq r t.1)⁻¹ * (monoq r t.2.2)⁻¹)) - b (msubTh r t)| ≤ ε}
        ≤ ENNReal.ofReal (C * ε ^ (1 / 13 : ℝ)) := by
  have hr0 : 0 < r := by linarith
  obtain ⟨qm, qM, hqm, hq⟩ := msub_q_bounds hr0 hA hAB.le
  have hqM : 0 < qM := lt_of_lt_of_le hqm ((hq A ⟨le_rfl, hAB.le⟩).1.trans
    (hq A ⟨le_rfl, hAB.le⟩).2)
  refine msub_nu_form hr hA hAB hc0 (νm := qm * qm / qM) (p' := -(r - 1)) (k := Real.log r)
    (by positivity) (by intro h; linarith) ?_
  rintro t ⟨h0, h1, h2⟩
  have p0 := lt_of_lt_of_le hA h0.1
  have p1 := lt_of_lt_of_le hA h1.1
  have p2 := lt_of_lt_of_le hA h2.1
  have q0 := msub_q_pos hr0 p0
  have q1 := msub_q_pos hr0 p1
  have q2 := msub_q_pos hr0 p2
  have e : (monoq r t.2.1)⁻¹ / ((monoq r t.1)⁻¹ * (monoq r t.2.2)⁻¹) =
      monoq r t.1 * monoq r t.2.2 / monoq r t.2.1 := by
    field_simp
  rw [e]
  constructor
  · rw [div_le_div_iff₀ (by positivity) (by positivity)]
    have a1 := (hq _ h1).2
    have a0 := (hq _ h0).1
    have a2 := (hq _ h2).1
    have : qm * qm ≤ monoq r t.1 * monoq r t.2.2 := mul_le_mul a0 a2 hqm.le q0.le
    nlinarith [mul_le_mul this a1 q1.le (by positivity)]
  · rw [Real.log_div (by positivity) q1.ne', Real.log_mul q0.ne' q2.ne', msub_log_q hr0 p0,
      msub_log_q hr0 p1, msub_log_q hr0 p2]
    unfold msubLam; ring

end
end Auto

