/-- Pointwise bound `|T_ψ(f₁,f₂)| ≤ M ∫_I |f₁(x+t,y)| |f₂(x,y+Q t)| dt`. -/
theorem mimp_T_pointwise {r A B : ℝ} {ψ : ℝ → ℝ} (hψ : ∀ t, t ∉ Icc A B → ψ t = 0)
    {M : ℝ} (hM : ∀ t, |ψ t| ≤ M) (f₁ f₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) :
    ‖monoT r ψ f₁ f₂ z‖ₑ ≤ ENNReal.ofReal M *
      ∫⁻ t in Icc A B, ‖f₁ (z.1 + t, z.2)‖ₑ * ‖f₂ (z.1, z.2 + monoQ r t)‖ₑ := by
  unfold monoT
  refine (enorm_integral_le_lintegral_enorm _).trans ?_
  rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, ← lintegral_indicator measurableSet_Icc]
  refine lintegral_mono fun t => ?_
  rw [enorm_mul, enorm_mul]
  by_cases ht : t ∈ Icc A B
  · rw [indicator_of_mem ht]
    refine mul_le_mul_left ?_ _
    rw [← ofReal_norm, Complex.norm_real, Real.norm_eq_abs]
    exact ENNReal.ofReal_le_ofReal (hM t)
  · rw [indicator_of_notMem ht, hψ t ht]
    simp

/-- The substitution `z = (x+t, y)`. -/
theorem mimp_subst {r A B : ℝ} (hr : 0 < r) {F G : ℝ × ℝ → ℝ≥0∞} (hF : Measurable F)
    (hG : Measurable G) :
    ∫⁻ z : ℝ × ℝ, ∫⁻ t in Icc A B, F (z.1 + t, z.2) * G (z.1, z.2 + monoQ r t) =
      ∫⁻ z, F z * ∫⁻ t in Icc A B, G (z + mimpΓ r t) := by
  have hQ : Measurable (monoQ r) := (continuous_monoQ hr).measurable
  have hΓ := mimp_measurable_Γ hr
  have e1 : ∀ z, F z * ∫⁻ t in Icc A B, G (z + mimpΓ r t) =
      ∫⁻ t in Icc A B, F z * G (z + mimpΓ r t) := by
    intro z; rw [lintegral_const_mul _ (by fun_prop)]
  simp_rw [e1]
  rw [lintegral_lintegral_swap (by apply Measurable.aemeasurable; fun_prop)]
  conv_rhs => rw [lintegral_lintegral_swap (by apply Measurable.aemeasurable; fun_prop)]
  refine lintegral_congr fun t => ?_
  rw [← lintegral_add_right_eq_self (fun w => F w * G (w + mimpΓ r t)) ((t, 0) : ℝ × ℝ)]
  refine lintegral_congr fun z => ?_
  have e2 : z + ((t, 0) : ℝ × ℝ) = (z.1 + t, z.2) := by ext <;> simp
  have e3 : z + ((t, 0) : ℝ × ℝ) + mimpΓ r t = (z.1, z.2 + monoQ r t) := by
    ext <;> simp [mimpΓ]
  simp only [e2]
  rw [← e2, e3]

theorem mimp_eLpNorm_12_7 {f : ℝ × ℝ → ℂ}
    (hf : AEStronglyMeasurable f volume := by fun_prop) :
    eLpNorm f (12 / 7 : ℝ≥0∞) volume =
      (∫⁻ z, ‖f z‖ₑ ^ (12 / 7 : ℝ)) ^ (7 / 12 : ℝ) := by
  have ht : (12 / 7 : ℝ≥0∞).toReal = 12 / 7 := by
    rw [ENNReal.toReal_div]; norm_num
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by finiteness) (by fun_prop), ht]
  norm_num

theorem mimp_improving {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ ψ : ℝ → ℝ, Measurable ψ → (∀ t, t ∉ Set.Icc A B → ψ t = 0) →
      ∀ M : ℝ, (∀ t, |ψ t| ≤ M) → ∀ f₁ f₂ : ℝ × ℝ → ℂ, Measurable f₁ → Measurable f₂ →
        eLpNorm (monoT r ψ f₁ f₂) 1 volume
          ≤ ENNReal.ofReal (C * M) * eLpNorm f₁ (12 / 7 : ℝ≥0∞) volume *
            eLpNorm f₂ (12 / 7 : ℝ≥0∞) volume := by
  obtain ⟨c, hc, hsep⟩ := mimp_monoq_sep hr hA hAB
  set k := mimpK c (monoq r B) B
  set C0 : ℝ≥0∞ := (∫⁻ v, k v ^ (3 / 2 : ℝ)) ^ (1 / 3 : ℝ)
  have hC0 : C0 ≠ ∞ :=
    (ENNReal.rpow_lt_top_of_nonneg (by norm_num) (mimp_K_finite hc (by linarith)).ne).ne
  refine ⟨C0.toReal, ENNReal.toReal_nonneg, ?_⟩
  intro ψ hψm hψ M hM f₁ f₂ hf₁ hf₂
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  have hF : Measurable fun z => ‖f₁ z‖ₑ := hf₁.enorm
  have hG : Measurable fun z => ‖f₂ z‖ₑ := hf₂.enorm
  have hB := mimp_B_generic (S := Icc A B) (mimp_measurable_Γ (r := r) (by linarith))
    (mimp_measurable_K c (monoq r B) B) (mimp_diff hr hA hc hsep) hF hG
  rw [eLpNorm_one_eq_lintegral_enorm
    (measurable_monoT (by linarith) hψm hf₁ hf₂).aestronglyMeasurable, mimp_eLpNorm_12_7,
      mimp_eLpNorm_12_7,
    ENNReal.ofReal_mul ENNReal.toReal_nonneg, ENNReal.ofReal_toReal hC0]
  calc ∫⁻ z, ‖monoT r ψ f₁ f₂ z‖ₑ
      ≤ ∫⁻ z, ENNReal.ofReal M *
          ∫⁻ t in Icc A B, ‖f₁ (z.1 + t, z.2)‖ₑ * ‖f₂ (z.1, z.2 + monoQ r t)‖ₑ :=
        lintegral_mono fun z => mimp_T_pointwise hψ hM f₁ f₂ z
    _ = ENNReal.ofReal M *
          ∫⁻ z, ‖f₁ z‖ₑ * ∫⁻ t in Icc A B, ‖f₂ (z + mimpΓ r t)‖ₑ := by
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
          mimp_subst (by linarith) hF hG]
    _ ≤ ENNReal.ofReal M * (C0 * (∫⁻ z, ‖f₁ z‖ₑ ^ (12 / 7 : ℝ)) ^ (7 / 12 : ℝ) *
          (∫⁻ z, ‖f₂ z‖ₑ ^ (12 / 7 : ℝ)) ^ (7 / 12 : ℝ)) := mul_le_mul_right hB _
    _ = C0 * ENNReal.ofReal M * (∫⁻ z, ‖f₁ z‖ₑ ^ (12 / 7 : ℝ)) ^ (7 / 12 : ℝ) *
          (∫⁻ z, ‖f₂ z‖ₑ ^ (12 / 7 : ℝ)) ^ (7 / 12 : ℝ) := by ring

end

