section
variable {j : Fin 2} {h M E1 Ω Λ R ρ : ℝ} {m : ℤ × ℤ} {G : ℝ × ℝ → ℂ}

theorem monoPiece_zero (R : ℝ) (n : ℤ) : monoPiece R n (0 : ℝ → ℂ) = 0 := by
  funext x; simp [monoPiece, convolution_def]

theorem monoSharp_zero (R ρ : ℝ) : monoSharp R ρ (0 : ℝ → ℂ) = 0 := by
  funext x; simp [monoSharp, monoPiece_zero]

theorem monoFlat_zero (R ρ : ℝ) : monoFlat R ρ (0 : ℝ → ℂ) = 0 := by
  funext x; simp [monoFlat, monoSharp_zero]

/-- A fiber quantity vanishing outside the passive window integrates to at most `(3/2) h` times
its bound. -/
theorem lintegral_window_le (hh : 0 < h) {g : ℝ → ℝ≥0∞} {c : ℝ≥0∞}
    (hg : ∀ p, g p ≤ c) (hz : ∀ p, 3 / 4 ≤ |p / h - monoMPas j m| → g p = 0) :
    ∫⁻ p, g p ≤ c * ENNReal.ofReal (3 / 2 * h) := by
  set I := Icc (h * (monoMPas j m - 3 / 4)) (h * (monoMPas j m + 3 / 4))
  calc ∫⁻ p, g p ≤ ∫⁻ p, I.indicator (fun _ => c) p := by
        refine lintegral_mono fun p => ?_
        by_cases hp : 3 / 4 ≤ |p / h - monoMPas j m|
        · rw [hz p hp]; exact bot_le
        · push Not at hp
          have hpI : p ∈ I := by
            obtain ⟨l, u⟩ := abs_lt.mp hp
            constructor
            · have : (monoMPas j m : ℝ) - 3 / 4 < p / h := by linarith
              rw [lt_div_iff₀ hh] at this; linarith
            · have : p / h < monoMPas j m + 3 / 4 := by linarith
              rw [div_lt_iff₀ hh] at this; linarith
          rw [indicator_of_mem hpI]; exact hg p
    _ = c * ENNReal.ofReal (3 / 2 * h) := by
        rw [lintegral_indicator measurableSet_Icc, setLIntegral_const, Real.volume_Icc]
        congr 2; ring

theorem fib_chiM_mul (hh : 0 < h) (F : ℝ × ℝ → ℂ) (p : ℝ) :
    monoFib j (fun z => (monoChiM h m z : ℂ) * F z) p
      = fun a => monoBetaFibS hh (monoMAct j m) (monoBeta (p / h - monoMPas j m)) a * monoFib j F
        p a := by
  funext a
  simp only [monoFib, monoChiM_pt, monoBetaFibS_apply, monoBetaFib]
  push_cast; ring

theorem lintegral_fib_chiM_mul_le (F : ℝ × ℝ → ℂ) (p : ℝ) :
    ∫⁻ a, ‖(monoChiM h m (monoPt j a p) : ℂ) * F (monoPt j a p)‖ₑ ^ 2
      ≤ ∫⁻ a, ‖monoFib j F p a‖ₑ ^ 2 := by
  refine lintegral_mono fun a => ?_
  gcongr
  rw [← ofReal_norm, ← ofReal_norm]
  refine ENNReal.ofReal_le_ofReal ?_
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (mloc_ChiM_nonneg _ _ _)]
  exact mul_le_of_le_one_left (norm_nonneg _) (mloc_ChiM_le_one _ _ _)

/-- **(6.6)** for the sharp family. -/
theorem energy_monoVSharp (hG : MonoGoodPiece j h M E1 Ω Λ m G) (hh : 0 < h) (hR : 0 < R)
    (hE1 : 0 ≤ E1) :
    ∫⁻ p, (∫⁻ a, ‖monoVSharp j h R ρ m G (monoPt j a p)‖ₑ ^ 2) ^ 2
      ≤ ENNReal.ofReal (E1 ^ 2 * (3 / 2 * h)) := by
  have hin : ∀ p, ∫⁻ a, ‖monoVSharp j h R ρ m G (monoPt j a p)‖ₑ ^ 2 ≤ ENNReal.ofReal E1 := by
    intro p
    refine (lintegral_fib_chiM_mul_le (m := m) (monoSharp2 j R ρ G) p).trans ?_
    have e : monoFib j (monoSharp2 j R ρ G) p = monoSharp R ρ (monoFib j G p) := by
      funext a; exact monoSharp2_fib j R ρ G p a
    rw [e]
    exact (lintegral_monoSharp_sq_le hR (hG.fibInt p) (fun _ => hG.bdd _)).trans (hG.fibL2 p)
  refine (lintegral_window_le (j := j) (m := m) hh (c := ENNReal.ofReal E1 ^ 2)
    (fun p => by gcongr; exact hin p) (fun p hp => ?_)).trans (le_of_eq ?_)
  · have e : ∀ a, monoVSharp j h R ρ m G (monoPt j a p) = 0 := by
      intro a
      simp only [monoVSharp]
      have : monoSharp2 j R ρ G (monoPt j a p) = 0 := by
        have h1 := monoSharp2_fib j R ρ G p a
        rw [hG.fibZero p hp, monoSharp_zero] at h1
        simpa [monoFib] using h1
      rw [this, mul_zero]
    simp [e]
  · rw [← ENNReal.ofReal_pow hE1, ← ENNReal.ofReal_mul (by positivity)]

/-- **(6.6)** for the flat family. -/
theorem energy_monoVFlat (hG : MonoGoodPiece j h M E1 Ω Λ m G) (hh : 0 < h) (hR : 0 < R)
    (hE1 : 0 ≤ E1) :
    ∫⁻ p, (∫⁻ a, ‖monoVFlat j h R ρ m G (monoPt j a p)‖ₑ ^ 2) ^ 2
      ≤ ENNReal.ofReal (E1 ^ 2 * (3 / 2 * h)) := by
  have hin : ∀ p, ∫⁻ a, ‖monoVFlat j h R ρ m G (monoPt j a p)‖ₑ ^ 2 ≤ ENNReal.ofReal E1 := by
    intro p
    refine (lintegral_fib_chiM_mul_le (m := m) (monoFlat2 j R ρ G) p).trans ?_
    have e : monoFib j (monoFlat2 j R ρ G) p = monoFlat R ρ (monoFib j G p) := by
      funext a; exact monoFlat2_fib j R ρ G p a
    rw [e]
    exact (lintegral_monoFlat_sq_le hR (hG.fibInt p) (fun _ => hG.bdd _)).trans (hG.fibL2 p)
  refine (lintegral_window_le (j := j) (m := m) hh (c := ENNReal.ofReal E1 ^ 2)
    (fun p => by gcongr; exact hin p) (fun p hp => ?_)).trans (le_of_eq ?_)
  · have e : ∀ a, monoVFlat j h R ρ m G (monoPt j a p) = 0 := by
      intro a
      simp only [monoVFlat]
      have : monoFlat2 j R ρ G (monoPt j a p) = 0 := by
        have h1 := monoFlat2_fib j R ρ G p a
        rw [hG.fibZero p hp, monoFlat_zero] at h1
        simpa [monoFib] using h1
      rw [this, mul_zero]
    simp [e]
  · rw [← ENNReal.ofReal_pow hE1, ← ENNReal.ofReal_mul (by positivity)]

/-- **(6.6)** for the whole family. -/
theorem energy_monoVWhole (hG : MonoGoodPiece j h M E1 Ω Λ m G) (hh : 0 < h) (hE1 : 0 ≤ E1) :
    ∫⁻ p, (∫⁻ a, ‖monoVWhole h m G (monoPt j a p)‖ₑ ^ 2) ^ 2
      ≤ ENNReal.ofReal (E1 ^ 2 * (3 / 2 * h)) := by
  have hin : ∀ p, ∫⁻ a, ‖monoVWhole h m G (monoPt j a p)‖ₑ ^ 2 ≤ ENNReal.ofReal E1 := fun p =>
    (lintegral_fib_chiM_mul_le (m := m) G p).trans (hG.fibL2 p)
  refine (lintegral_window_le (j := j) (m := m) hh (c := ENNReal.ofReal E1 ^ 2)
    (fun p => by gcongr; exact hin p) (fun p hp => ?_)).trans (le_of_eq ?_)
  · have e : ∀ a, monoVWhole h m G (monoPt j a p) = 0 := by
      intro a
      simp only [monoVWhole]
      have : G (monoPt j a p) = 0 := by
        have := congrFun (hG.fibZero p hp) a; simpa [monoFib] using this
      rw [this, mul_zero]
    simp [e]
  · rw [← ENNReal.ofReal_pow hE1, ← ENNReal.ofReal_mul (by positivity)]

theorem monoU_zero (R : ℝ) : monoU R (0 : ℝ → ℂ) = 0 := by
  simp [monoU, smoothingMultiplicativeDifference, Real.fourier_real_eq]

/-- **(6.7)**: the uniformity of the flat family. -/
theorem uniformity_monoVFlat (hG : MonoGoodPiece j h M E1 Ω Λ m G) (hh : 0 < h) (hR : 1 ≤ R)
    (hρ : 0 < ρ) (hE1 : 0 ≤ E1) :
    ∫⁻ p, monoU R (monoFib j (monoVFlat j h R ρ m G) p)
      ≤ ENNReal.ofReal (monoW0 ^ 2 * ρ * E1 ^ 2 * (3 / 2 * h)) := by
  have hpt : ∀ p, monoU R (monoFib j (monoVFlat j h R ρ m G) p)
      ≤ ENNReal.ofReal (monoW0 ^ 2 * ρ) * ENNReal.ofReal E1 ^ 2 := by
    intro p
    set c := monoBeta (p / h - monoMPas j m)
    have hc0 : 0 ≤ c := (monoBeta_bounds _).1
    have hc1 : c ≤ 1 := (monoBeta_bounds _).2
    have e : monoFib j (monoVFlat j h R ρ m G) p
        = fun a => monoBetaFibS hh (monoMAct j m) c a * monoFlat R ρ (monoFib j G p) a := by
      unfold monoVFlat
      rw [fib_chiM_mul hh]
      funext a; rw [monoFlat2_fib]
    rw [e]
    refine (monoU_flat_local hR hρ (monoBetaFibS hh (monoMAct j m) c)
      (norm_monoBetaFibS_le hh _ hc0 hc1) (hG.fibInt p) (fun _ => hG.bdd _)).trans ?_
    have hW : ∫ ξ, ‖𝓕 (⇑(monoBetaFibS hh (monoMAct j m) c)) ξ‖ ≤ monoW0 := by
      have : (⇑(monoBetaFibS hh (monoMAct j m) c) : ℝ → ℂ) = monoBetaFib h (monoMAct j m) c := rfl
      rw [this, integral_norm_fourier_monoBetaFib hh, abs_of_nonneg hc0]
      exact mul_le_of_le_one_left monoW0_nonneg hc1
    refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) (pow_le_pow_left₀ bot_le (hG.fibL2 p) 2)
    exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (integral_nonneg fun _ => norm_nonneg _) hW
      2)
      hρ.le
  refine (lintegral_window_le (j := j) (m := m) hh hpt (fun p hp => ?_)).trans (le_of_eq ?_)
  · have e : monoFib j (monoVFlat j h R ρ m G) p = 0 := by
      funext a
      simp only [monoFib, monoVFlat, Pi.zero_apply]
      have : monoFlat2 j R ρ G (monoPt j a p) = 0 := by
        have h1 := monoFlat2_fib j R ρ G p a
        rw [hG.fibZero p hp, monoFlat_zero] at h1
        simpa [monoFib] using h1
      rw [this, mul_zero]
    rw [e, monoU_zero]
  · rw [← ENNReal.ofReal_pow hE1, ← ENNReal.ofReal_mul (by have := monoW0_nonneg; positivity),
      ← ENNReal.ofReal_mul (by have := monoW0_nonneg; positivity)]

end

end

