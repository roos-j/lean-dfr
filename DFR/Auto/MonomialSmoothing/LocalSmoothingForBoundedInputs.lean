  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun k _ => ?_
  have e : ∀ t, iteratedDeriv k (fun t => c * ψ t) t = c * iteratedDeriv k ψ t := fun t => by
    rw [iteratedDeriv_const_mul_field]
  simp_rw [e, abs_mul, abs_of_nonneg hc]
  rw [Real.mul_iSup_of_nonneg hc]

