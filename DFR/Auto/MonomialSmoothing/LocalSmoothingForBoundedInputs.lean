theorem msub_approx_lin {A B L h : ℝ} {φ φ' : ℝ → ℝ}
    (hφ : ∀ x ∈ Icc A B, HasDerivAt φ (φ' x) x)
    (hL : ∀ x ∈ Icc A B, ∀ y ∈ Icc A B, |φ' x - φ' y| ≤ L * |x - y|) (hL0 : 0 ≤ L)
    {x y c : ℝ} (hx : x ∈ Icc A B) (hy : y ∈ Icc A B) (hc : c ∈ Icc A B)
    (hxc : |x - c| ≤ h) (hyc : |y - c| ≤ h) :
    |φ x - φ y - φ' c * (x - y)| ≤ L * h * |x - y| := by
  have key : ∀ x y, x ∈ Icc A B → y ∈ Icc A B → |x - c| ≤ h → |y - c| ≤ h → x < y →
      |φ x - φ y - φ' c * (x - y)| ≤ L * h * |x - y| := by
    intro x y hx hy hxc hyc hxy
    have hsub : Icc x y ⊆ Icc A B := Icc_subset_Icc hx.1 hy.2
    obtain ⟨ξ, hξ, hξeq⟩ := exists_hasDerivAt_eq_slope φ φ' hxy
      (fun z hz => (hφ z (hsub hz)).continuousAt.continuousWithinAt)
      (fun z hz => hφ z (hsub (Ioo_subset_Icc_self hz)))
    have hξI : ξ ∈ Icc A B := hsub (Ioo_subset_Icc_self hξ)
    have h1 : φ x - φ y = φ' ξ * (x - y) := by
      rw [hξeq]; field_simp [sub_ne_zero.mpr hxy.ne']; ring
    have h2 : |ξ - c| ≤ h := by
      rw [abs_le] at *; constructor <;> linarith [hξ.1, hξ.2]
    rw [h1, ← sub_mul, abs_mul]
    calc |φ' ξ - φ' c| * |x - y| ≤ (L * |ξ - c|) * |x - y| :=
          mul_le_mul_of_nonneg_right (hL ξ hξI c hc) (abs_nonneg _)
      _ ≤ L * h * |x - y| := by gcongr
  rcases lt_trichotomy x y with hxy | hxy | hxy
  · exact key x y hx hy hxc hyc hxy
  · subst hxy; simp
  · have e : φ x - φ y - φ' c * (x - y) = -(φ y - φ x - φ' c * (y - x)) := by ring
    rw [e, abs_neg, abs_sub_comm x y]
    exact key y x hy hx hyc hxc hxy

theorem msub_lip_of_deriv {A B L : ℝ} {φ φ' : ℝ → ℝ}
    (hφ : ∀ x ∈ Icc A B, HasDerivAt φ (φ' x) x)
    (hb : ∀ x ∈ Icc A B, |φ' x| ≤ L) {x y : ℝ} (hx : x ∈ Icc A B) (hy : y ∈ Icc A B) :
    |φ x - φ y| ≤ L * |x - y| := by
  have := (convex_Icc A B).norm_image_sub_le_of_norm_hasDerivWithin_le
    (fun z hz => (hφ z hz).hasDerivWithinAt) (fun z hz => by simpa using hb z hz) hy hx
  simpa [Real.norm_eq_abs] using this

theorem msub_bound_of_contOn {A B : ℝ} {f : ℝ → ℝ} (hf : ContinuousOn f (Icc A B)) :
    ∃ M, 0 ≤ M ∧ ∀ x ∈ Icc A B, |f x| ≤ M := by
  obtain ⟨C, hC⟩ := isCompact_Icc.exists_bound_of_continuousOn hf
  refine ⟨max C 0, le_max_right _ _, fun x hx => ?_⟩
  have := hC x hx; rw [Real.norm_eq_abs] at this; exact this.trans (le_max_left _ _)

theorem msub_pos_min_of_contOn {A B : ℝ} (hAB : A ≤ B) {f : ℝ → ℝ} (hf : ContinuousOn f (Icc A B))
    (hpos : ∀ x ∈ Icc A B, 0 < f x) : ∃ m, 0 < m ∧ ∀ x ∈ Icc A B, m ≤ f x := by
  obtain ⟨x0, hx0, hmin⟩ := isCompact_Icc.exists_isMinOn (nonempty_Icc.mpr hAB) hf
  exact ⟨f x0, hpos x0 hx0, fun x hx => hmin hx⟩

theorem msub_rpow_contOn {A B a : ℝ} (hA : 0 < A) :
    ContinuousOn (fun t : ℝ => t ^ a) (Icc A B) :=
  continuousOn_id.rpow_const (fun _ hx => Or.inl (ne_of_gt (lt_of_lt_of_le hA hx.1)))

theorem msub_monoq_hasDeriv (r : ℝ) {t : ℝ} (ht : 0 < t) :
    HasDerivAt (monoq r) (r * ((r - 1) * t ^ (r - 1 - 1))) t := by
  unfold monoq
  exact (Real.hasDerivAt_rpow_const (Or.inl ht.ne')).const_mul r

theorem msub_q_bounds {r A B : ℝ} (hr : 0 < r) (hA : 0 < A) (hAB : A ≤ B) :
    ∃ qm qM, 0 < qm ∧ ∀ t ∈ Icc A B, qm ≤ monoq r t ∧ monoq r t ≤ qM := by
  have hc : ContinuousOn (monoq r) (Icc A B) := by
    unfold monoq; exact continuousOn_const.mul (msub_rpow_contOn hA)
  obtain ⟨m, hm, hm'⟩ := msub_pos_min_of_contOn hAB hc (fun x hx => by
    unfold monoq; exact mul_pos hr (Real.rpow_pos_of_pos (lt_of_lt_of_le hA hx.1) _))
  obtain ⟨M, -, hM⟩ := msub_bound_of_contOn hc
  exact ⟨m, M, hm, fun t ht => ⟨hm' t ht, (le_abs_self _).trans (hM t ht)⟩⟩

theorem msub_q_lip {r A B : ℝ} (hA : 0 < A) :
    ∃ L, 0 ≤ L ∧ ∀ x ∈ Icc A B, ∀ y ∈ Icc A B, |monoq r x - monoq r y| ≤ L * |x - y| := by
  have hc : ContinuousOn (fun t => r * ((r - 1) * t ^ (r - 1 - 1))) (Icc A B) :=
    continuousOn_const.mul (continuousOn_const.mul (msub_rpow_contOn hA))
  obtain ⟨L, hL, hL'⟩ := msub_bound_of_contOn hc
  exact ⟨L, hL, fun x hx y hy => msub_lip_of_deriv
    (fun z hz => msub_monoq_hasDeriv r (lt_of_lt_of_le hA hz.1)) hL' hx hy⟩

theorem msub_Q_lip {r A B : ℝ} (hA : 0 < A) :
    ∃ L, 0 ≤ L ∧ ∀ x ∈ Icc A B, ∀ y ∈ Icc A B, |monoQ r x - monoQ r y| ≤ L * |x - y| := by
  have hc : ContinuousOn (monoq r) (Icc A B) := by
    unfold monoq; exact continuousOn_const.mul (msub_rpow_contOn hA)
  obtain ⟨L, hL, hL'⟩ := msub_bound_of_contOn hc
  exact ⟨L, hL, fun x hx y hy => msub_lip_of_deriv
    (fun z hz => hasDerivAt_monoQ r (lt_of_lt_of_le hA hz.1)) hL' hx hy⟩

theorem msub_inv_lip {A x y : ℝ} (hA : 0 < A) (hx : A ≤ x) (hy : A ≤ y) :
    |x⁻¹ - y⁻¹| ≤ (A ^ 2)⁻¹ * |x - y| := by
  have hx0 : 0 < x := lt_of_lt_of_le hA hx
  have hy0 : 0 < y := lt_of_lt_of_le hA hy
  rw [inv_sub_inv hx0.ne' hy0.ne', abs_div, abs_of_pos (mul_pos hx0 hy0), abs_sub_comm]
  rw [div_le_iff₀ (mul_pos hx0 hy0)]
  have : A ^ 2 ≤ x * y := by nlinarith
  calc |x - y| = (A ^ 2)⁻¹ * |x - y| * A ^ 2 := by field_simp
    _ ≤ (A ^ 2)⁻¹ * |x - y| * (x * y) := by gcongr

end
end Auto

