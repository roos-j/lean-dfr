  have hiter : ∀ k : ℕ, ∫ s, A (s, q) * (Real.fourierChar (-(lam * inner ℝ (gammaCurve s) e)) : ℂ)
      = ((2 * Real.pi * Complex.I * lam)⁻¹) ^ k *
          ∫ s, nspB A k (s, (e, q)) * (Real.fourierChar (-(lam * inner ℝ (gammaCurve s) e)) : ℂ)
