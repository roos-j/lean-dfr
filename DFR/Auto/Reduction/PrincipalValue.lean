/-- The odd part `F(t)/t + F(-t)/(-t)` of the principal-value integrand. -/
def pvOdd (F : ℝ → ℂ) (t : ℝ) : ℂ := F t / t + F (-t) / (-t)

/-- The truncations `∫_{|t|>ε} F(t)/t` fold onto the half-line: for `ε > 0`,
