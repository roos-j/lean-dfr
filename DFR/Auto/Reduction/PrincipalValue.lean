      (∀ t ∈ s, ε ≤ |t|) → IntegrableOn (fun t => G t / t) s := by
    intro G hGc hGi s hs hsε
    refine Integrable.mono' (hGi.norm.div_const ε).integrableOn
      (hGc.measurable.div Complex.measurable_ofReal).aestronglyMeasurable.restrict ?_
    rw [ae_restrict_iff' hs]
    refine Eventually.of_forall fun t ht => ?_
    have h1 := hsε t ht
    rw [norm_div, Complex.norm_real, Real.norm_eq_abs]
    exact div_le_div_of_nonneg_left (norm_nonneg _) hε h1
