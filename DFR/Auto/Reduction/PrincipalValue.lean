  · refine Measure.integrableOn_of_bounded (M := 2 * K) (by simp) hmeas ?_
    rw [ae_restrict_iff' measurableSet_Ioc]
    refine Eventually.of_forall fun t ht => ?_
    obtain ⟨h0, h1⟩ := ht
    have hmem : ∀ s, |s| ≤ 1 → s ∈ Icc (-1 : ℝ) 1 := fun s hs => abs_le.mp hs
