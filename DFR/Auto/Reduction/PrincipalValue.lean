      measurableSet_Ioi fun t ht => by
        rw [mem_Ioi] at ht; rw [abs_of_pos (by linarith)]; exact ht.le
    refine h.congr_fun (fun t _ => ?_) measurableSet_Ioi
    simp only [div_neg, neg_div]
