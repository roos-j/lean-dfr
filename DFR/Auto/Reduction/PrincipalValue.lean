    hint F hc hi _ measurableSet_Iio fun t ht => by
      rw [mem_Iio] at ht; rw [abs_of_neg (by linarith)]; linarith
  have hIoi : IntegrableOn (fun t => F t / t) (Ioi ε) :=
    hint F hc hi _ measurableSet_Ioi fun t ht => by
      rw [mem_Ioi] at ht; rw [abs_of_pos (by linarith)]; exact ht.le
  have hIoi' : IntegrableOn (fun t => F (-t) / (-t)) (Ioi ε) := by
