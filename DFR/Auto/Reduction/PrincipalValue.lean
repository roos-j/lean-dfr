/-- **The principal value exists** (`blueprints/main.tex`, lines 134-137): for Schwartz inputs
the truncations `∫_{|t|>ε} ∏_n f_n(x + t^n e_n) dt/t` converge as `ε → 0+`. -/
theorem tendsto_simplexTrunc (f : Fin 3 → SchwartzMap E3 ℂ) (x : E3) :
    Tendsto (DFR.T_trunc (fun n => f n) x) (𝓝[>] 0)
      (𝓝 (∫ t in Ioi 0, pvOdd (prodShift (fun n => f n) x) t)) := by
  obtain ⟨K, hK⟩ := (contDiff_prodShift_schwartz f x).contDiffOn.exists_lipschitzOnWith
    one_ne_zero (convex_Icc (-1 : ℝ) 1) isCompact_Icc
  exact tendsto_pv (continuous_prodShift (fun n => (f n).continuous) x)
    (integrable_prodShift_schwartz f x) hK

theorem simplexT_eq (f : Fin 3 → SchwartzMap E3 ℂ) (x : E3) :
    DFR.T (fun n => f n) x = ∫ t in Ioi 0, pvOdd (prodShift (fun n => f n) x) t :=
  (tendsto_simplexTrunc f x).limUnder_eq

/-- For Schwartz inputs, the official truncated operator converges pointwise to `DFR.T`
as the truncation parameter tends to zero from above. -/
theorem tendsto_T_trunc (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    Tendsto (DFR.T_trunc (fun i => f i) x) (𝓝[>] 0)
      (𝓝 (DFR.T (fun i => f i) x)) := by
  rw [simplexT_eq]
  exact tendsto_simplexTrunc f x

