/-- The diagonal map as a linear equivalence. -/
def diagEquiv {c : Fin 3 → ℝ} (hc : ∀ m, c m ≠ 0) : E3 ≃L[ℝ] E3 :=
  ContinuousLinearEquiv.equivOfInverse (diagCLM c) (diagCLM fun m => (c m)⁻¹)
    (fun x => by rw [diagCLM_comp]; ext m; simp [diagCLM_apply, inv_mul_cancel₀ (hc m)])
    (fun x => by rw [diagCLM_comp]; ext m; simp [diagCLM_apply, mul_inv_cancel₀ (hc m)])

theorem diagEquiv_apply {c : Fin 3 → ℝ} (hc : ∀ m, c m ≠ 0) (x : E3) :
    diagEquiv hc x = diagCLM c x := rfl

/-- A Schwartz function precomposed with a diagonal map. -/
def schwartzDiag {c : Fin 3 → ℝ} (hc : ∀ m, c m ≠ 0) (g : 𝓢(E3, ℂ)) : 𝓢(E3, ℂ) :=
  SchwartzMap.compCLMOfContinuousLinearEquiv ℂ (diagEquiv hc) g

theorem schwartzDiag_apply {c : Fin 3 → ℝ} (hc : ∀ m, c m ≠ 0) (g : 𝓢(E3, ℂ)) (x : E3) :
    schwartzDiag hc g x = g (diagCLM c x) := rfl

theorem abs_prod_pos {c : Fin 3 → ℝ} (hc : ∀ m, c m ≠ 0) : 0 < |∏ m, c m| :=
  abs_pos.mpr (Finset.prod_ne_zero_iff.mpr fun m _ => hc m)

theorem inv_ne_zero_fun {c : Fin 3 → ℝ} (hc : ∀ m, c m ≠ 0) : ∀ m, (c m)⁻¹ ≠ 0 :=
  fun m => inv_ne_zero (hc m)

theorem prod_inv_fun (c : Fin 3 → ℝ) : ∏ m, (c m)⁻¹ = (∏ m, c m)⁻¹ := by
  rw [Finset.prod_inv_distrib]

/-- Frequency localization survives a diagonal change of variables. -/
theorem fourier_support_diag {c : Fin 3 → ℝ} (hc : ∀ m, c m ≠ 0) (g : 𝓢(E3, ℂ)) {n0 : Fin 3}
    {lam : ℝ} (hg : ∀ ξ, 𝓕 (g : E3 → ℂ) ξ ≠ 0 → lam * |(c n0)⁻¹| ≤ |ξ n0|) :
    Function.support (𝓕 (schwartzDiag hc g : E3 → ℂ)) ⊆ {ξ : E3 | lam ≤ |ξ n0|} := by
  intro ξ hξ
  rw [Function.mem_support] at hξ
  have e : (schwartzDiag hc g : E3 → ℂ) = fun x => g (diagCLM c x) := rfl
  rw [e, fourier_comp_diagCLM hc] at hξ
  have h := hg _ (right_ne_zero_of_mul hξ)
  simp only [diagCLM_apply, abs_mul] at h
  have hpos : 0 < |(c n0)⁻¹| := abs_pos.mpr (inv_ne_zero (hc n0))
  change lam ≤ |ξ n0|
  nlinarith [abs_nonneg (ξ n0)]

