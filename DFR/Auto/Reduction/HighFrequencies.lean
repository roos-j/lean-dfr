  · rw [wPos_eq_zero_of_le h.le, wPos, ite_eq_left (by linarith), wL_neg]; ring
  · subst h; simp [wPos, wL]
  · rw [wPos, ite_eq_left h, wPos_eq_zero_of_le (by linarith), sub_zero]

