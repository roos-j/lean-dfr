/-- **The single-scale gain** (`lem:gain` proof, lines 460-463): for `p ≥ 1`, `p_n > 1` with
`∑ 1/p_n = 1/p`, there are `δ ∈ (0,1)` and `C` such that for every scale `j`, Schwartz inputs
`g_n` and `λ ≥ 1`, if `ĝ_{n_0}` is supported in `{|ξ_{n_0}| ≥ λ 2^{(n_0+1) j}}` then
`‖T_j(g)‖_p ≤ C λ^{-δ} ∏ ‖g_n‖_{p_n}`: `thm:smoothing` after the anisotropic rescaling
`Auto.simplexTj_rescale`. -/
theorem single_scale_gain {p : ℝ} {pv : Fin 3 → ℝ} (hp : 1 ≤ p) (hpv : ∀ i, 1 < pv i)
    (hsum : ∑ i, (pv i)⁻¹ = p⁻¹) :
    ∃ δ C : ℝ, δ ∈ Set.Ioo (0 : ℝ) 1 ∧ 0 < C ∧
      ∀ (j : ℤ) (g : Fin 3 → 𝓢(E3, ℂ)) (n0 : Fin 3) (lam : ℝ), 1 ≤ lam →
        (∀ ξ, 𝓕 (g n0 : E3 → ℂ) ξ ≠ 0 → lam * (2 : ℝ) ^ ((expo n0 : ℤ) * j) ≤ |ξ n0|) →
        eLpNorm (simplexTj j fun n => g n) (ENNReal.ofReal p) volume
          ≤ ENNReal.ofReal (C * lam ^ (-δ)) * ∏ n, eLpNorm (g n) (ENNReal.ofReal (pv n)) volume :=
            by
  obtain ⟨δ, C, hδ, hC, hsm⟩ := thm_smoothing (a := 1 / 2) (bb := 2) (by norm_num) (by norm_num)
    hp hpv hsum
  set M : ℝ := (∫⁻ t, ‖deriv wPos t‖ₑ ∂volume).toReal with hMdef
  have hMfin : (∫⁻ t, ‖deriv wPos t‖ₑ ∂volume) ≠ ⊤ := integrable_deriv_wPos.2.ne
  have hM0 : 0 ≤ M := ENNReal.toReal_nonneg
  have hMle : (∫⁻ t, ‖deriv wPos t‖ₑ ∂volume) ≤ ENNReal.ofReal M := by
    rw [hMdef, ENNReal.ofReal_toReal hMfin]
  have hderiv : ∀ t, HasDerivAt wPos (deriv wPos t) t := fun t =>
    ((contDiff_wPos.differentiable (by simp)) t).hasDerivAt
  have hderivc : Continuous (deriv wPos) := contDiff_wPos.continuous_deriv
    (by exact_mod_cast le_top)
  refine ⟨δ, 2 * (C * max 1 M), hδ, by positivity, fun j g n0 lam hlam hg => ?_⟩
  have hpos : 0 < p := by linarith
  have hp0 : ENNReal.ofReal p ≠ 0 := by simpa using hpos
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp
  -- the rescaled inputs
  set c : Fin 3 → ℝ := fun m => (dilC j m)⁻¹ with hcdef
  have hc : ∀ m, c m ≠ 0 := fun m => inv_ne_zero (dilC_ne_zero j m)
  set Gs : Fin 3 → 𝓢(E3, ℂ) := fun n => schwartzDiag hc (g n) with hGs
  set Rs : Fin 3 → 𝓢(E3, ℂ) := fun n => schwartzDiag reflC_ne_zero (Gs n) with hRs
  set cR : Fin 3 → ℝ := fun m => reflC m * dilC j m with hcR
  have hcR0 : ∀ m, cR m ≠ 0 := fun m => mul_ne_zero (reflC_ne_zero m) (dilC_ne_zero j m)
  have hresc : (simplexTj j fun n => g n)
      = (fun x => Apsi wPos (fun n => Gs n) (diagCLM (dilC j) x))
        - (fun x => Apsi wPos (fun n => Rs n) (diagCLM cR x)) := by
    funext x
    rw [simplexTj_rescale j (fun n => (g n).continuous) x, Pi.sub_apply, ← diagCLM_comp]
    rfl
  -- the frequency localization of the rescaled inputs
  have hlamG : ∃ n1 : Fin 3, Function.support (𝓕 (Gs n1 : E3 → ℂ)) ⊆ {ξ : E3 | lam ≤ |ξ n1|} := by
    refine ⟨n0, fourier_support_diag hc (g n0) fun ξ hξ => ?_⟩
    have := hg ξ hξ
    simp only [hcdef, inv_inv, dilC] at this ⊢
    rw [abs_of_pos (zpow_pos two_pos _)]
    linarith
  have hlamR : ∃ n1 : Fin 3, Function.support (𝓕 (Rs n1 : E3 → ℂ)) ⊆ {ξ : E3 | lam ≤ |ξ n1|} := by
    obtain ⟨n1, h1⟩ := hlamG
    refine ⟨n1, fourier_support_diag reflC_ne_zero (Gs n1) fun ξ hξ => ?_⟩
    have := h1 (Function.mem_support.mpr hξ)
    simp only [mem_ofPred_eq] at this
    have hr : |(reflC n1)⁻¹| = 1 := by fin_cases n1 <;> simp [reflC]
    rw [hr, mul_one]; exact this
  have h1 := hsm wPos (deriv wPos) M hderiv hderivc support_wPos hM0 hMle lam hlam Gs hlamG
  have h2 := hsm wPos (deriv wPos) M hderiv hderivc support_wPos hM0 hMle lam hlam Rs hlamR
  -- norms of the rescaled inputs
  set d : ℝ := |∏ m, dilC j m| with hd
  have hd0 : 0 < d := abs_prod_pos (dilC_ne_zero j)
  have hGn : ∀ n, eLpNorm (Gs n) (ENNReal.ofReal (pv n)) volume
      = ENNReal.ofReal d ^ (pv n)⁻¹ * eLpNorm (g n) (ENNReal.ofReal (pv n)) volume := by
    intro n
    have hpvn : 0 < pv n := by linarith [hpv n]
    have := eLpNorm_comp_diagCLM hc (g n).continuous.aestronglyMeasurable (p := ENNReal.ofReal (pv
      n))
       ENNReal.ofReal_ne_top
    rw [ENNReal.toReal_ofReal hpvn.le] at this
    rw [show (Gs n : E3 → ℂ) = fun x => g n (diagCLM c x) from rfl, this, hcdef, prod_inv_fun,
      abs_inv, inv_inv]
  have hRn : ∀ n, eLpNorm (Rs n) (ENNReal.ofReal (pv n)) volume
      = eLpNorm (Gs n) (ENNReal.ofReal (pv n)) volume := by
    intro n
    have hpvn : 0 < pv n := by linarith [hpv n]
    have := eLpNorm_comp_diagCLM reflC_ne_zero (Gs n).continuous.aestronglyMeasurable
      (p := ENNReal.ofReal (pv n)) ENNReal.ofReal_ne_top
    have hr : |∏ m, reflC m|⁻¹ = 1 := by simp [reflC, Fin.prod_univ_three]
    rw [show (Rs n : E3 → ℂ) = fun x => Gs n (diagCLM reflC x) from rfl, this, hr,
      ENNReal.ofReal_one, ENNReal.one_rpow, one_mul]
  have hprod : ∏ n, eLpNorm (Gs n) (ENNReal.ofReal (pv n)) volume
      = ENNReal.ofReal d ^ p⁻¹ * ∏ n, eLpNorm (g n) (ENNReal.ofReal (pv n)) volume := by
    simp_rw [hGn]
    rw [Finset.prod_mul_distrib]
    congr 1
    simp_rw [ENNReal.ofReal_rpow_of_pos hd0]
    rw [← ENNReal.ofReal_prod_of_nonneg fun n _ => (Real.rpow_pos_of_pos hd0 _).le,
      ← Real.rpow_sum_of_pos hd0, hsum]
  -- the output norms
  have hout : ∀ (F : E3 → ℂ) (e : Fin 3 → ℝ), (∀ m, e m ≠ 0) → |∏ m, e m| = d →
      AEStronglyMeasurable F volume →
      eLpNorm (fun x => F (diagCLM e x)) (ENNReal.ofReal p) volume
        = ENNReal.ofReal d⁻¹ ^ p⁻¹ * eLpNorm F (ENNReal.ofReal p) volume := by
    intro F e he hde hF
    rw [eLpNorm_comp_diagCLM he hF ENNReal.ofReal_ne_top, hde, ENNReal.toReal_ofReal hpos.le]
  have hdR : |∏ m, cR m| = d := by
    simp only [hcR, Finset.prod_mul_distrib, abs_mul, hd]
    simp [reflC, Fin.prod_univ_three]
  set K : ℝ := C * max 1 M * lam ^ (-δ) with hK
  have hK0 : 0 ≤ K := by positivity
  set X : ℝ≥0∞ := ENNReal.ofReal d⁻¹ ^ p⁻¹ with hX
  set P : ℝ≥0∞ := ∏ n, eLpNorm (g n) (ENNReal.ofReal (pv n)) volume with hP
  have hXY : X * ENNReal.ofReal d ^ p⁻¹ = 1 := by
    rw [hX, ← ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hpos.le),
      ← ENNReal.ofReal_mul (inv_nonneg.mpr hd0.le), inv_mul_cancel₀ hd0.ne', ENNReal.ofReal_one,
      ENNReal.one_rpow]
  have hc1 : Continuous fun x => Apsi wPos (fun n => Gs n) (diagCLM (dilC j) x) :=
    (continuous_Apsi_wPos Gs).comp (diagCLM (dilC j)).continuous
  have hc2 : Continuous fun x => Apsi wPos (fun n => Rs n) (diagCLM cR x) :=
    (continuous_Apsi_wPos Rs).comp (diagCLM cR).continuous
  have hRprod : ∏ n, eLpNorm (Rs n) (ENNReal.ofReal (pv n)) volume
      = ∏ n, eLpNorm (Gs n) (ENNReal.ofReal (pv n)) volume :=
    Finset.prod_congr rfl fun n _ => hRn n
  calc eLpNorm (simplexTj j fun n => g n) (ENNReal.ofReal p) volume
      = eLpNorm ((fun x => Apsi wPos (fun n => Gs n) (diagCLM (dilC j) x))
          - (fun x => Apsi wPos (fun n => Rs n) (diagCLM cR x))) (ENNReal.ofReal p) volume := by
        rw [hresc]
    _ ≤ eLpNorm (fun x => Apsi wPos (fun n => Gs n) (diagCLM (dilC j) x)) (ENNReal.ofReal p) volume
        + eLpNorm (fun x => Apsi wPos (fun n => Rs n) (diagCLM cR x)) (ENNReal.ofReal p) volume :=
        eLpNorm_sub_le hp1
    _ = X * eLpNorm (Apsi wPos fun n => Gs n) (ENNReal.ofReal p) volume
        + X * eLpNorm (Apsi wPos fun n => Rs n) (ENNReal.ofReal p) volume := by
        rw [hout _ (dilC j) (dilC_ne_zero j) rfl (continuous_Apsi_wPos Gs).aestronglyMeasurable,
          hout _ cR hcR0 hdR (continuous_Apsi_wPos Rs).aestronglyMeasurable]
    _ ≤ X * (ENNReal.ofReal K * ∏ n, eLpNorm (Gs n) (ENNReal.ofReal (pv n)) volume)
        + X * (ENNReal.ofReal K * ∏ n, eLpNorm (Rs n) (ENNReal.ofReal (pv n)) volume) :=
        add_le_add (mul_le_mul_right h1 _) (mul_le_mul_right h2 _)
    _ = ENNReal.ofReal (2 * (C * max 1 M) * lam ^ (-δ)) * P := by
        rw [hRprod, hprod, ← two_mul]
        have e2 : ENNReal.ofReal (2 * (C * max 1 M) * lam ^ (-δ)) = 2 * ENNReal.ofReal K := by
          rw [hK, show 2 * (C * max 1 M) * lam ^ (-δ) = 2 * (C * max 1 M * lam ^ (-δ)) by ring,
            ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_ofNat]
        rw [e2]
        calc 2 * (X * (ENNReal.ofReal K * (ENNReal.ofReal d ^ p⁻¹ * P)))
            = 2 * ENNReal.ofReal K * P * (X * ENNReal.ofReal d ^ p⁻¹) := by ring
          _ = 2 * ENNReal.ofReal K * P := by rw [hXY, mul_one]

/-! ### The partial Littlewood-Paley square function (lines 468-471) -/

/-- The line `ℝ` as `Euclidean 1`. -/
abbrev E1 : Type := EuclideanSpace ℝ (Fin 1)

theorem norm_E1 (ξ : E1) : ‖ξ‖ = |ξ 0| := by
  rw [EuclideanSpace.norm_eq, Fin.sum_univ_one, Real.norm_eq_abs, Real.sqrt_sq_eq_abs, abs_abs]

theorem continuous_E1_coord : Continuous fun ξ : E1 => ξ 0 := by fun_prop

theorem contDiff_phi1 : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun ξ : E1 => ((lpPhi (ξ 0) : ℝ) : ℂ))
  :=
  Complex.ofRealCLM.contDiff.comp (contDiff_lpPhi.comp (EuclideanSpace.proj (𝕜 := ℝ) (0 : Fin
    1)).contDiff)

theorem hasCompactSupport_phi1 : HasCompactSupport (fun ξ : E1 => ((lpPhi (ξ 0) : ℝ) : ℂ)) := by
  refine HasCompactSupport.intro (isCompact_closedBall (0 : E1) 2) fun ξ hξ => ?_
  rw [Metric.mem_closedBall, dist_zero_right, not_le, norm_E1] at hξ
  simp [lpPhi_eq_zero hξ.le]

/-- Our `φ` as lean-spherical cutoff data on `ℝ`. -/
def phiCutoffs : Auto.LittlewoodPaley.lpCutoffs 1 where
  cutoff := hasCompactSupport_phi1.toSchwartzMap contDiff_phi1
  cutoff_one := fun ξ hξ => by
    change ((lpPhi (ξ 0) : ℝ) : ℂ) = 1
    rw [norm_E1] at hξ; simp [lpPhi_eq_one hξ]
  cutoff_zero := fun ξ hξ => by
    change ((lpPhi (ξ 0) : ℝ) : ℂ) = 0
    rw [norm_E1] at hξ; simp [lpPhi_eq_zero hξ]
  norm_le_one := fun ξ => by
    change ‖((lpPhi (ξ 0) : ℝ) : ℂ)‖ ≤ 1
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (lpPhi_nonneg _)]
    exact lpPhi_le_one _

/-- Their band `k` is our `ψ_{k+1}`. -/
theorem phiCutoffs_band (k : ℤ) (ξ : E1) :
    Auto.LittlewoodPaley.intDyadicBandpassMultiplier phiCutoffs.cutoff k ξ
      = ((lpPsiJ (k + 1) (ξ 0) : ℝ) : ℂ) := by
  rw [Auto.LittlewoodPaley.intDyadicBandpassMultiplier_apply, lpPsiJ_eq]
  change ((lpPhi ((((2 : ℝ) ^ (k + 1))⁻¹ • ξ) 0) : ℝ) : ℂ) - ((lpPhi ((((2 : ℝ) ^ k)⁻¹ • ξ) 0) : ℝ)
    : ℂ)
    = ((lpPhiJ (k + 1) (ξ 0) - lpPhiJ (k + 1 - 1) (ξ 0) : ℝ) : ℂ)
  simp only [PiLp.smul_apply, smul_eq_mul, lpPhiJ, add_sub_cancel_right, zpow_neg]
  push_cast; ring

theorem schwartz_inversion_apply_E1 (g : 𝓢(E1, ℂ)) (z : E1) :
    g z = ∫ ξ : E1, Real.fourierChar (inner ℝ ξ z) • 𝓕 (g : E1 → ℂ) ξ := by
  have h := congrArg (fun F : 𝓢(E1, ℂ) => F z)
    (FourierPair.fourierInv_fourier_eq (E := 𝓢(E1, ℂ)) (F := 𝓢(E1, ℂ)) g)
  rw [← h, SchwartzMap.fourierInv_coe, Real.fourierInv_eq, SchwartzMap.fourier_coe]

/-- The unit vector of `E1`. -/
def e1 : E1 := EuclideanSpace.single 0 1

/-- **Their band projection is the line convolution with `ψ̌_{k+1}`**:
`Δ_k g(s) = ∫ ψ̌_{k+1}(u) g(s - u e_1) du`. -/
theorem integerDyadicProjection_eq_lineConv (k : ℤ) (g : 𝓢(E1, ℂ)) (s : E1) :
    Auto.LittlewoodPaley.integerDyadicProjection phiCutoffs.cutoff k g s
      = ∫ u : ℝ, (psiCM (k + 1)).check u * g (s - u • e1) := by
  set χ := psiCM (k + 1) with hχ
  unfold Auto.LittlewoodPaley.integerDyadicProjection
  rw [Real.fourierInv_eq]
  simp_rw [phiCutoffs_band]
  set G : E1 × ℝ → ℂ := fun p => (Real.fourierChar (inner ℝ p.1 s) : ℂ) *
      ((Real.fourierChar (-(p.2 * p.1 0)) : ℂ) * χ.check p.2 * 𝓕 (g : E1 → ℂ) p.1) with hG
  have hint : Integrable G (volume.prod volume) := by
    refine Integrable.mono' (((𝓕 g).integrable.norm.mul_prod
      χ.check.integrable.norm)) ?_ (Eventually.of_forall fun p => ?_)
    · have h4 : Continuous fun p : E1 × ℝ => 𝓕 (g : E1 → ℂ) p.1 := by
        rw [← SchwartzMap.fourier_coe]; exact (𝓕 g).continuous.comp continuous_fst
      refine (Continuous.aestronglyMeasurable ?_)
      exact (continuous_subtype_val.comp (Real.continuous_fourierChar.comp
        (continuous_fst.inner continuous_const))).mul
        (((continuous_subtype_val.comp (Real.continuous_fourierChar.comp
          (continuous_snd.mul (continuous_E1_coord.comp continuous_fst)).neg)).mul
          (χ.check.continuous.comp continuous_snd)).mul h4)
    · simp only [hG, norm_mul, Circle.norm_coe, one_mul, ← SchwartzMap.fourier_coe]
      exact le_of_eq (mul_comm _ _)
  have e1' : (fun ξ : E1 => Real.fourierChar (inner ℝ ξ s) •
      (((lpPsiJ (k + 1) (ξ 0) : ℝ) : ℂ) * 𝓕 (g : E1 → ℂ) ξ))
      = fun ξ => ∫ u : ℝ, G (ξ, u) := by
    funext ξ
    have hh : ((lpPsiJ (k + 1) (ξ 0) : ℝ) : ℂ)
        = ∫ u : ℝ, Real.fourierChar (-(u * ξ 0)) • χ.check u := χ.h_eq_fourier_check (ξ 0)
    rw [hh, ← integral_mul_const, Circle.smul_def, smul_eq_mul, ← integral_const_mul]
    refine integral_congr_ae (Eventually.of_forall fun u => ?_)
    simp only [hG, Circle.smul_def, smul_eq_mul, hχ]
  rw [e1', integral_integral_swap hint]
  refine integral_congr_ae (Eventually.of_forall fun u => ?_)
  simp only
  rw [schwartz_inversion_apply_E1 g (s - u • e1), ← integral_const_mul]
  refine integral_congr_ae (Eventually.of_forall fun ξ => ?_)
  simp only [hG, Circle.smul_def, smul_eq_mul]
  have hin : inner ℝ ξ (s - u • e1) = inner ℝ ξ s + -(u * ξ 0) := by
    rw [inner_sub_right, inner_smul_right, e1, EuclideanSpace.inner_single_right]
    simp; ring
  rw [hin, AddChar.map_add_eq_mul, Circle.coe_mul]
  ring

/-- The base point `y(r)` of the line through the remaining coordinates `r`, with `y_ℓ = 0`. -/
def fiberBase (ℓ : Fin 3) (r : Fin 2 → ℝ) : E3 := WithLp.toLp 2 (Fin.insertNth ℓ 0 r)

theorem insertNth_eq_fiberBase_add (ℓ : Fin 3) (s : ℝ) (r : Fin 2 → ℝ) :
    (WithLp.toLp 2 (Fin.insertNth ℓ s r) : E3) = fiberBase ℓ r + s • basisVec ℓ := by
  ext m
  simp only [fiberBase, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, basisVec,
    PiLp.single_apply]
  rcases Fin.eq_self_or_eq_succAbove ℓ m with h | ⟨i, rfl⟩
  · subst h; simp
  · simp [Fin.insertNth_apply_succAbove, Fin.succAbove_ne]

/-- **Fibrewise Tonelli on `ℝ^3`**: `∫ F = ∫_{r ∈ ℝ^2} ∫_{s ∈ ℝ} F(y(r) + s e_ℓ) ds dr`. -/
theorem lintegral_E3_fiber (ℓ : Fin 3) {F : E3 → ℝ≥0∞} (hF : Measurable F) :
    ∫⁻ x, F x = ∫⁻ r : Fin 2 → ℝ, ∫⁻ s : ℝ, F (fiberBase ℓ r + s • basisVec ℓ) := by
  rw [← (PiLp.volume_preserving_toLp (Fin 3)).lintegral_comp_emb
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  have hmp := (measurePreserving_piFinSuccAbove (fun _ : Fin 3 => (volume : Measure ℝ)) ℓ).symm
  conv_lhs => rw [volume_pi]
  rw [← hmp.lintegral_comp_emb (MeasurableEquiv.measurableEmbedding _)]
  have hF' : Measurable fun p : ℝ × (Fin 2 → ℝ) =>
      F (WithLp.toLp 2 ((MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) ℓ).symm p)) :=
    hF.comp ((PiLp.continuous_toLp 2 _).measurable.comp
      (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) ℓ).symm.measurable)
  rw [show (Measure.pi fun j : Fin 2 => (volume : Measure ℝ)) = volume from volume_pi.symm,
    lintegral_prod _ hF'.aemeasurable, lintegral_lintegral_swap hF'.aemeasurable]
  refine lintegral_congr fun r => lintegral_congr fun s => ?_
  simp only [MeasurableEquiv.piFinSuccAbove_symm_apply]
  change F (WithLp.toLp 2 (Fin.insertNth ℓ s r)) = _
  rw [insertNth_eq_fiberBase_add]

/-- The line map `v ↦ v_0 e_ℓ` from `E1` to `ℝ^3`. -/
def lineMap1 (ℓ : Fin 3) : E1 →L[ℝ] E3 :=
  (EuclideanSpace.proj (𝕜 := ℝ) (0 : Fin 1)).smulRight (basisVec ℓ)

theorem lineMap1_apply (ℓ : Fin 3) (v : E1) : lineMap1 ℓ v = v 0 • basisVec ℓ := by
  simp [lineMap1]

theorem lineMap1_injective (ℓ : Fin 3) : Function.Injective (lineMap1 ℓ) := by
  intro v w h
  have := congrArg (fun z : E3 => z ℓ) h
  simp only [lineMap1_apply, PiLp.smul_apply, smul_eq_mul, basisVec] at this
  simp only [Fin.isValue, PiLp.single_eq_same, mul_one] at this
  ext i; fin_cases i; exact this

/-- The fibre `v ↦ g(y + v_0 e_ℓ)` of a Schwartz function, as a Schwartz function on `E1`. -/
def fiberS (ℓ : Fin 3) (y : E3) (g : 𝓢(E3, ℂ)) : 𝓢(E1, ℂ) :=
  Twisted.schwartzAffinePullbackOfInjective (𝕜 := ℂ) (lineMap1 ℓ) (lineMap1_injective ℓ) y g

theorem fiberS_apply (ℓ : Fin 3) (y : E3) (g : 𝓢(E3, ℂ)) (v : E1) :
    fiberS ℓ y g v = g (y + v 0 • basisVec ℓ) := by
  simp [fiberS, Twisted.schwartzAffinePullbackOfInjective_apply, lineMap1_apply, add_comm]

/-- The one-dimensional band projection of a fibre is the fibre of `Δ^{(ℓ)}_m`. -/
theorem projection_fiberS (ℓ : Fin 3) (m : ℤ) (y : E3) (f : 𝓢(E3, ℂ)) (v : E1) :
    Auto.LittlewoodPaley.integerDyadicProjection phiCutoffs.cutoff (m - 1) (fiberS ℓ y f) v
      = fiberS ℓ y (lpDelta ℓ m f) v := by
  rw [integerDyadicProjection_eq_lineConv, fiberS_apply, ← psiCM_op, CoordMult.op_eq_lineConv,
    sub_add_cancel]
  refine integral_congr_ae (Eventually.of_forall fun u => ?_)
  simp only [fiberS_apply]
  congr 2
  simp only [PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, e1, PiLp.single_apply,
    ite_true, mul_one, sub_smul]
  abel

theorem single_E1_apply (s : ℝ) : (EuclideanSpace.single (0 : Fin 1) s : E1) 0 = s := by simp

/-- `∫_{E1} G = ∫_ℝ G(s e_1)`. -/
theorem lintegral_E1 {G : E1 → ℝ≥0∞} (_hG : Measurable G) :
    ∫⁻ v, G v = ∫⁻ s : ℝ, G (EuclideanSpace.single 0 s) := by
  rw [← (PiLp.volume_preserving_toLp (Fin 1)).lintegral_comp_emb
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  have h := (volume_preserving_funUnique (Fin 1) ℝ).symm.lintegral_comp_emb
    (MeasurableEquiv.measurableEmbedding _) (fun a => G (WithLp.toLp 2 a))
  refine h.symm.trans (lintegral_congr fun s => ?_)
  congr 1
  ext i; fin_cases i; simp

/-- `(∑_{m∈S} a_m^2)^{q/2} ≤ |S|^{q/2} ∑_{m∈S} a_m^q` for `a_m ≥ 0`, `q > 0`. -/
theorem sum_sq_rpow_le {ι : Type*} (S : Finset ι) {a : ι → ℝ} (ha : ∀ i, 0 ≤ a i) {q : ℝ}
    (hq : 0 < q) :
    (∑ i ∈ S, a i ^ 2) ^ (q / 2) ≤ (S.card : ℝ) ^ (q / 2) * ∑ i ∈ S, a i ^ q := by
  set M := ∑ i ∈ S, a i ^ q with hM
  have hM0 : 0 ≤ M := Finset.sum_nonneg fun i _ => Real.rpow_nonneg (ha i) _
  have hterm : ∀ i ∈ S, a i ^ 2 ≤ M ^ (2 / q) := by
    intro i hi
    have h1 : a i ^ q ≤ M := Finset.single_le_sum (f := fun i => a i ^ q)
      (fun i _ => Real.rpow_nonneg (ha i) _) hi
    have := Real.rpow_le_rpow (Real.rpow_nonneg (ha i) _) h1 (show 0 ≤ 2 / q by positivity)
    rwa [← Real.rpow_mul (ha i), mul_div_cancel₀ _ hq.ne', Real.rpow_two] at this
  have hsum : ∑ i ∈ S, a i ^ 2 ≤ S.card * M ^ (2 / q) := by
    calc ∑ i ∈ S, a i ^ 2 ≤ ∑ _i ∈ S, M ^ (2 / q) := Finset.sum_le_sum hterm
      _ = S.card * M ^ (2 / q) := by rw [Finset.sum_const, nsmul_eq_mul]
  calc (∑ i ∈ S, a i ^ 2) ^ (q / 2)
      ≤ ((S.card : ℝ) * M ^ (2 / q)) ^ (q / 2) :=
        Real.rpow_le_rpow (Finset.sum_nonneg fun i _ => sq_nonneg _) hsum (by positivity)
    _ = (S.card : ℝ) ^ (q / 2) * M := by
        rw [Real.mul_rpow (Nat.cast_nonneg _) (Real.rpow_nonneg hM0 _), ← Real.rpow_mul hM0,
          div_mul_div_comm, mul_comm 2 q, div_self (by positivity), Real.rpow_one]

theorem measurable_lpDelta_energy (ℓ : Fin 3) (S : Finset ℤ) (f : 𝓢(E3, ℂ)) (q : ℝ) :
    Measurable fun x : E3 => ENNReal.ofReal ((∑ m ∈ S, ‖lpDelta ℓ m f x‖ ^ 2) ^ (q / 2)) := by
  refine ENNReal.measurable_ofReal.comp (Measurable.pow_const ?_ _)
  exact Finset.measurable_sum _ fun m _ => ((lpDelta ℓ m f).continuous.norm.pow 2).measurable

/-- **The partial Littlewood-Paley square function** in coordinate `ℓ` (lines 468-471), for
Schwartz inputs and every finite family of scales, with a constant independent of the family:
`∫ (∑_{m∈S} |Δ^{(ℓ)}_m f|^2)^{q/2} ≤ A ∫ |f|^q`, `1 < q < ∞`. Obtained fibrewise from the
one-dimensional theorem of lean-spherical (`Auto.MikhlinHormander.littlewoodPaley_of_mikhlin`). -/
theorem partial_littlewoodPaley (ℓ : Fin 3) {q : ℝ} (hq : 1 < q) :
    ∃ A : ℝ, 0 < A ∧ ∀ (S : Finset ℤ) (f : 𝓢(E3, ℂ)),
      ∫⁻ x, ENNReal.ofReal ((∑ m ∈ S, ‖lpDelta ℓ m f x‖ ^ 2) ^ (q / 2))
        ≤ ENNReal.ofReal A * ∫⁻ x, ENNReal.ofReal (‖f x‖ ^ q) := by
  obtain ⟨A, hA, hLP⟩ := Auto.MikhlinHormander.littlewoodPaley_of_mikhlin phiCutoffs q hq
  refine ⟨A, hA, fun S f => ?_⟩
  have hq0 : 0 < q := by linarith
  rw [lintegral_E3_fiber ℓ (measurable_lpDelta_energy ℓ S f q),
    lintegral_E3_fiber ℓ (F := fun x => ENNReal.ofReal (‖f x‖ ^ q))
      (ENNReal.measurable_ofReal.comp (f.continuous.norm.measurable.pow_const q)),
    ← lintegral_const_mul _ (by
      refine Measurable.lintegral_prod_right' (f := fun p : (Fin 2 → ℝ) × ℝ =>
        ENNReal.ofReal (‖f (fiberBase ℓ p.1 + p.2 • basisVec ℓ)‖ ^ q)) ?_
      refine ENNReal.measurable_ofReal.comp (Measurable.pow_const ?_ _)
      refine (f.continuous.comp ?_).norm.measurable
      change Continuous fun p : (Fin 2 → ℝ) × ℝ => fiberBase ℓ p.1 + p.2 • basisVec ℓ
      unfold fiberBase
      exact ((PiLp.continuous_toLp 2 _).comp (Continuous.finInsertNth (A := fun _ => ℝ) ℓ
        continuous_const continuous_fst)).add (continuous_snd.smul continuous_const))]
  refine lintegral_mono fun r => ?_
  set y := fiberBase ℓ r with hy
  set g := fiberS ℓ y f with hg
  set K : Finset ℤ := S.image (fun m => m - 1) with hK
  -- the fibre inequality from the one-dimensional theorem
  have hfib := hLP K g
  have henergy : ∀ v : E1, Auto.LittlewoodPaley.finiteIntegerDyadicSquareEnergy phiCutoffs K g v
      = ∑ m ∈ S, ‖lpDelta ℓ m f (y + v 0 • basisVec ℓ)‖ ^ 2 := by
    intro v
    unfold Auto.LittlewoodPaley.finiteIntegerDyadicSquareEnergy
      Auto.LittlewoodPaley.finiteSquareEnergy
    rw [hK, Finset.sum_image (fun a _ b _ h => by simpa using h)]
    refine Finset.sum_congr rfl fun m _ => ?_
    beta_reduce
    rw [projection_fiberS, fiberS_apply]
  -- integrability on the fibre
  have hgint : Integrable fun v : E1 => ‖g v‖ ^ q :=
    (g.memLp (ENNReal.ofReal q) volume).integrable_norm_rpow (by simpa using hq0)
      ENNReal.ofReal_ne_top
      |>.congr (Eventually.of_forall fun v => by simp [ENNReal.toReal_ofReal hq0.le])
  have heint : Integrable fun v : E1 =>
      (Auto.LittlewoodPaley.finiteIntegerDyadicSquareEnergy phiCutoffs K g v) ^ (q / 2) := by
    have hdom : Integrable fun v : E1 => (S.card : ℝ) ^ (q / 2) *
        ∑ m ∈ S, ‖fiberS ℓ y (lpDelta ℓ m f) v‖ ^ q := by
      refine Integrable.const_mul (integrable_finsetSum _ fun m _ => ?_) _
      exact ((fiberS ℓ y (lpDelta ℓ m f)).memLp (ENNReal.ofReal q) volume).integrable_norm_rpow
        (by simpa using hq0) ENNReal.ofReal_ne_top |>.congr
          (Eventually.of_forall fun v => by simp [ENNReal.toReal_ofReal hq0.le])
    refine hdom.mono' ?_ (Eventually.of_forall fun v => ?_)
    · refine (Continuous.aestronglyMeasurable ?_)
      simp_rw [henergy]
      refine (continuous_finsetSum _ fun m _ => ?_).rpow_const fun _ => Or.inr (by positivity)
      exact ((lpDelta ℓ m f).continuous.comp (continuous_const.add
        (continuous_E1_coord.smul continuous_const))).norm.pow 2
    · rw [henergy, Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg
        (Finset.sum_nonneg fun m _ => sq_nonneg _) _)]
      have := sum_sq_rpow_le S (a := fun m => ‖lpDelta ℓ m f (y + v 0 • basisVec ℓ)‖)
        (fun m => norm_nonneg _) hq0
      simpa only [fiberS_apply] using this
  -- transport the fibre inequality to `lintegral`s over `ℝ`
  have hL : ∫⁻ s : ℝ, ENNReal.ofReal ((∑ m ∈ S, ‖lpDelta ℓ m f (y + s • basisVec ℓ)‖ ^ 2) ^ (q / 2))
      = ENNReal.ofReal (∫ v : E1,
          (Auto.LittlewoodPaley.finiteIntegerDyadicSquareEnergy phiCutoffs K g v) ^ (q / 2)) := by
    rw [ofReal_integral_eq_lintegral_ofReal heint (Eventually.of_forall fun v =>
      Real.rpow_nonneg (by rw [henergy]; exact Finset.sum_nonneg fun m _ => sq_nonneg _) _)]
    rw [lintegral_E1 (G := fun v => ENNReal.ofReal
        ((Auto.LittlewoodPaley.finiteIntegerDyadicSquareEnergy phiCutoffs K g v) ^ (q / 2))) (by
      simp_rw [henergy]
      refine ENNReal.measurable_ofReal.comp (Measurable.pow_const ?_ _)
      refine Finset.measurable_sum _ fun m _ => ?_
      exact ((lpDelta ℓ m f).continuous.comp (continuous_const.add
        (continuous_E1_coord.smul continuous_const))).norm.pow 2 |>.measurable)]
    refine lintegral_congr fun s => ?_
    rw [henergy, single_E1_apply]
  have hR : ∫⁻ s : ℝ, ENNReal.ofReal (‖f (y + s • basisVec ℓ)‖ ^ q)
      = ENNReal.ofReal (∫ v : E1, ‖g v‖ ^ q) := by
    rw [ofReal_integral_eq_lintegral_ofReal hgint (Eventually.of_forall fun v =>
      Real.rpow_nonneg (norm_nonneg _) _)]
    rw [lintegral_E1 (G := fun v => ENNReal.ofReal (‖g v‖ ^ q)) (ENNReal.measurable_ofReal.comp
      (g.continuous.norm.measurable.pow_const q))]
    refine lintegral_congr fun s => ?_
    rw [hg, fiberS_apply, single_E1_apply]
  rw [hL, hR, ← ENNReal.ofReal_mul hA.le]
  exact ENNReal.ofReal_le_ofReal hfib

/-- The Fourier transform of `Δ^{(ℓ)}_m g` is `ψ_m(ξ_ℓ) ĝ(ξ)`. -/
theorem fourier_lpDelta (ℓ : Fin 3) (m : ℤ) (g : 𝓢(E3, ℂ)) (ξ : E3) :
    𝓕 (lpDelta ℓ m g : E3 → ℂ) ξ = ((lpPsiJ m (ξ ℓ) : ℝ) : ℂ) * 𝓕 (g : E3 → ℂ) ξ := by
  have h : 𝓕 (lpDelta ℓ m g) = SchwartzMap.smulLeftCLM ℂ (psiCoord ℓ m) (𝓕 g) := by
    change 𝓕 (𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psiCoord ℓ m) (𝓕 g))) = _
    exact FourierInvPair.fourier_fourierInv_eq (E := 𝓢(E3, ℂ)) (F := 𝓢(E3, ℂ)) _
  have h2 := congrArg (fun F : 𝓢(E3, ℂ) => F ξ) h
  simp only [SchwartzMap.fourier_coe] at h2
  rw [h2, SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_psiCoord ℓ m), smul_eq_mul,
    SchwartzMap.fourier_coe]
  rfl

/-- `Δ^{(ℓ)}_m g` has Fourier support in `{2^{m-1} ≤ |ξ_ℓ|}`. -/
theorem fourier_lpDelta_support (ℓ : Fin 3) (m : ℤ) (g : 𝓢(E3, ℂ)) (ξ : E3)
    (h : 𝓕 (lpDelta ℓ m g : E3 → ℂ) ξ ≠ 0) : (2 : ℝ) ^ (m - 1) ≤ |ξ ℓ| := by
  rw [fourier_lpDelta] at h
  have h1 : lpPsi ((2 : ℝ) ^ (-m) * ξ ℓ) ≠ 0 := by
    intro h0; apply h; rw [lpPsiJ, h0]; simp
  have h2 := (lpPsi_support h1).1
  have hp : (0 : ℝ) < 2 ^ m := zpow_pos two_pos _
  rw [abs_mul, abs_of_pos (zpow_pos two_pos _), zpow_neg, ← div_eq_inv_mul, le_div_iff₀ hp] at h2
  rw [zpow_sub₀ two_ne_zero, zpow_one]; linarith

/-- `T_j(g)` is continuous for Schwartz inputs (dominated convergence). -/
@[fun_prop] theorem continuous_simplexTj (j : ℤ) (g : Fin 3 → 𝓢(E3, ℂ)) :
    Continuous (simplexTj j fun n => g n) := by
  obtain ⟨Cb, hCb⟩ : ∃ Cb : ℝ, ∀ i x, ‖g i x‖ ≤ Cb := by
    refine ⟨∑ i, ‖(g i).toBoundedContinuousFunction‖, fun i x => ?_⟩
    refine ((g i).toBoundedContinuousFunction.norm_coe_le_norm x).trans ?_
    exact Finset.single_le_sum (f := fun i => ‖(g i).toBoundedContinuousFunction‖)
      (fun i _ => norm_nonneg _) (Finset.mem_univ i)
  unfold simplexTj
  refine continuous_of_dominated (bound := fun t => ‖(lpPsi ((2 : ℝ) ^ j * t) : ℂ) / t‖ * Cb ^ 3)
    (fun x => ?_) (fun x => Eventually.of_forall fun t => ?_) ((integrable_psi_div
      j).norm.mul_const _)
    (Eventually.of_forall fun t => ?_)
  · refine ((integrable_psi_div j).aestronglyMeasurable.mul
      (continuous_prodShift (fun n => (g n).continuous) x).aestronglyMeasurable).congr
      (Eventually.of_forall fun t => ?_)
    simp only [Pi.mul_apply]; ring
  · rw [mul_div_right_comm, norm_mul]
    exact mul_le_mul_of_nonneg_left (norm_prodShift_le hCb x t) (norm_nonneg _)
  · have : Continuous fun x => prodShift (fun n => g n) x t := by
      unfold prodShift
      exact continuous_finsetProd _ fun i _ => (g i).continuous.comp (continuous_id.add
        continuous_const)
    exact continuous_const.mul this |>.div_const _

/-- `ℓ^2 ⊆ ℓ^q` for `q ≥ 2`: `∑ a_m^q ≤ (∑ a_m^2)^{q/2}`, `a_m ≥ 0`. -/
theorem sum_rpow_le_sum_sq_rpow {ι : Type*} (S : Finset ι) {a : ι → ℝ} (ha : ∀ i, 0 ≤ a i)
    {q : ℝ} (hq : 2 ≤ q) :
    ∑ i ∈ S, a i ^ q ≤ (∑ i ∈ S, a i ^ 2) ^ (q / 2) := by
  set B := ∑ i ∈ S, a i ^ 2 with hB
  have hB0 : 0 ≤ B := Finset.sum_nonneg fun i _ => sq_nonneg _
  have hr : 0 ≤ q / 2 - 1 := by linarith
  have hterm : ∀ i ∈ S, a i ^ q ≤ a i ^ 2 * B ^ (q / 2 - 1) := by
    intro i hi
    have hle : a i ^ 2 ≤ B := Finset.single_le_sum (f := fun i => a i ^ 2)
      (fun i _ => sq_nonneg _) hi
    have e : a i ^ q = a i ^ 2 * (a i ^ 2) ^ (q / 2 - 1) := by
      rw [← Real.rpow_two, ← Real.rpow_mul (ha i), ← Real.rpow_add' (ha i) (by linarith)]
      congr 1; ring
    rw [e]
    exact mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (sq_nonneg _) hle hr) (sq_nonneg _)
  calc ∑ i ∈ S, a i ^ q ≤ ∑ i ∈ S, a i ^ 2 * B ^ (q / 2 - 1) := Finset.sum_le_sum hterm
    _ = B * B ^ (q / 2 - 1) := by rw [Finset.sum_mul]
    _ = B ^ (q / 2) := by
        rcases hB0.eq_or_lt with h | h
        · rw [← h, zero_mul, Real.zero_rpow (by linarith)]
        · rw [← Real.rpow_one_add' hB0 (by linarith)]; congr 1; ring

/-- **The `ℓ^q`-sum of partial Littlewood-Paley pieces** (lines 468-471): for `q ≥ 2`,
`∑_{m∈S} ‖Δ^{(ℓ)}_m f‖_q^q ≤ ‖(∑_{m∈S} |Δ^{(ℓ)}_m f|^2)^{1/2}‖_q^q ≤ A ‖f‖_q^q`, uniformly in the
finite family `S`. -/
theorem sum_lintegral_lpDelta_le (ℓ : Fin 3) {q : ℝ} (hq : 2 ≤ q) :
    ∃ A : ℝ, 0 < A ∧ ∀ (S : Finset ℤ) (f : 𝓢(E3, ℂ)),
      ∑ m ∈ S, ∫⁻ x, ENNReal.ofReal (‖lpDelta ℓ m f x‖ ^ q)
        ≤ ENNReal.ofReal A * ∫⁻ x, ENNReal.ofReal (‖f x‖ ^ q) := by
  obtain ⟨A, hA, hLP⟩ := partial_littlewoodPaley ℓ (q := q) (by linarith)
  refine ⟨A, hA, fun S f => ?_⟩
  rw [← lintegral_finsetSum (f := fun m x => ENNReal.ofReal (‖lpDelta ℓ m f x‖ ^ q)) _
    fun m _ => ENNReal.measurable_ofReal.comp
      ((lpDelta ℓ m f).continuous.norm.measurable.pow_const q)]
  refine le_trans (lintegral_mono fun x => ?_) (hLP S f)
  rw [← ENNReal.ofReal_sum_of_nonneg fun m _ => Real.rpow_nonneg (norm_nonneg _) _]
  exact ENNReal.ofReal_le_ofReal (sum_rpow_le_sum_sq_rpow S (fun m => norm_nonneg _) hq)

/-- `∫ |g|^p = ‖g‖_p^p` for Schwartz `g` and `p > 0`. -/
theorem lintegral_ofReal_norm_rpow_eq (g : 𝓢(E3, ℂ)) {p : ℝ} (hp : 0 < p) :
    ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ p) = eLpNorm g (ENNReal.ofReal p) volume ^ p := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hp) ENNReal.ofReal_ne_top
    (by fun_prop),
    ENNReal.toReal_ofReal hp.le, ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hp.ne',
    ENNReal.rpow_one]
  refine lintegral_congr fun x => ?_
  rw [← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp.le, ofReal_norm]

theorem eLpNorm_schwartz_ne_top (g : 𝓢(E3, ℂ)) (p : ℝ) :
    eLpNorm g (ENNReal.ofReal p) volume ≠ ⊤ := (g.memLp _ _).eLpNorm_ne_top

/-- The `ℓ^{p_n}`-sum in `j` of the pieces `Δ^{(n)}_{(n+1)j+k_n} f`: for `q ≥ 2`,
`∑_{|j| ≤ J} ‖Δ^{(n)}_{(n+1)j+k_n} f‖_q^q ≤ A ‖f‖_q^q` (lines 468-471). -/
theorem sum_toReal_eLpNorm_lpDelta_le (n : Fin 3) {q : ℝ} (hq : 2 ≤ q) :
    ∃ A : ℝ, 0 < A ∧ ∀ (kn : ℤ) (J : ℕ) (f : 𝓢(E3, ℂ)),
      ∑ j ∈ Finset.Icc (-(J : ℤ)) J,
          (eLpNorm (lpDelta n ((expo n : ℤ) * j + kn) f) (ENNReal.ofReal q) volume).toReal ^ q
        ≤ A * (eLpNorm f (ENNReal.ofReal q) volume).toReal ^ q := by
  obtain ⟨A, hA, hS⟩ := sum_lintegral_lpDelta_le n hq
  refine ⟨A, hA, fun kn J f => ?_⟩
  have hq0 : 0 < q := by linarith
  have hinj : Set.InjOn (fun j : ℤ => (expo n : ℤ) * j + kn) (Finset.Icc (-(J : ℤ)) J) := by
    intro a _ b _ h
    have he : (0 : ℤ) < expo n := by exact_mod_cast expo_pos n
    have : (expo n : ℤ) * a = (expo n : ℤ) * b := by simpa using h
    exact mul_left_cancel₀ he.ne' this
  have h := hS ((Finset.Icc (-(J : ℤ)) J).image fun j => (expo n : ℤ) * j + kn) f
  rw [Finset.sum_image hinj] at h
  simp_rw [lintegral_ofReal_norm_rpow_eq _ hq0] at h
  have hfin : ENNReal.ofReal A * eLpNorm f (ENNReal.ofReal q) volume ^ q ≠ ⊤ :=
    ENNReal.mul_ne_top ENNReal.ofReal_ne_top
      (ENNReal.rpow_ne_top_of_nonneg hq0.le (eLpNorm_schwartz_ne_top f q))
  have h2 := ENNReal.toReal_mono hfin h
  rw [ENNReal.toReal_sum fun j _ =>
      ENNReal.rpow_ne_top_of_nonneg hq0.le (eLpNorm_schwartz_ne_top _ q),
    ENNReal.toReal_mul, ENNReal.toReal_ofReal hA.le, ← ENNReal.toReal_rpow] at h2
  simpa only [← ENNReal.toReal_rpow] using h2

/-- **`lem:gain` at `p = 1`** (`eq:gain`, lines 440-447, with the proof of lines 459-472): for
`p_1, p_2, p_3 ≥ 2` with `∑ 1/p_n = 1` there are `δ > 0`, `C` with
`‖T^{(k)}_J(f)‖_1 ≤ C 2^{-δ k^{(1)}} ∏ ‖f_n‖_{p_n}` for all `k ∈ F_H`, uniformly in the truncation
`J`. (On `F_H`, `2^{-δ k^{(1)}}` is comparable to the source's `2^{-δ|k|}`.) -/
theorem gain_one {pv : Fin 3 → ℝ} (hpv : ∀ n, 2 ≤ pv n) (hsum : ∑ n, (pv n)⁻¹ = 1) :
    ∃ δ C : ℝ, 0 < δ ∧ 0 < C ∧ ∀ k : Fin 3 → ℤ, 0 < kMax k → ∀ (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)),
      eLpNorm (kComp k J f) 1 volume
        ≤ ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * kMax k))) *
          ∏ n, eLpNorm (f n) (ENNReal.ofReal (pv n)) volume := by
  obtain ⟨δ, C, hδ, hC, hss⟩ := single_scale_gain (p := 1) (pv := pv) le_rfl
    (fun i => by linarith [hpv i]) (by simpa using hsum)
  choose A hA hLq using fun n : Fin 3 => sum_toReal_eLpNorm_lpDelta_le n (hpv n)
  have hpv0 : ∀ n, 0 < pv n := fun n => by linarith [hpv n]
  set Cf : ℝ := C * 2 ^ δ * ∏ n, A n ^ (pv n)⁻¹ with hCf
  have hCf0 : 0 < Cf := by
    have : 0 < ∏ n, A n ^ (pv n)⁻¹ := Finset.prod_pos fun n _ => Real.rpow_pos_of_pos (hA n) _
    positivity
  refine ⟨δ, Cf, hδ.1, hCf0, fun k hk J f => ?_⟩
  -- the coordinate carrying the largest frequency
  obtain ⟨n0, hn0⟩ : ∃ n0 : Fin 3, k n0 = kMax k := by
    have : kMax k = k 0 ∨ kMax k = k 1 ∨ kMax k = k 2 := by simp only [kMax]; omega
    rcases this with h | h | h
    exacts [⟨0, h.symm⟩, ⟨1, h.symm⟩, ⟨2, h.symm⟩]
  have hk1 : 1 ≤ kMax k := hk
  set lam : ℝ := (2 : ℝ) ^ (kMax k - 1) with hlamdef
  have hlam : 1 ≤ lam := one_le_zpow₀ (by norm_num) (by omega)
  have hlamδ : lam ^ (-δ) = 2 ^ δ * (2 : ℝ) ^ (-(δ * kMax k)) := by
    rw [hlamdef, ← Real.rpow_intCast, ← Real.rpow_mul (by norm_num), ← Real.rpow_add two_pos]
    congr 1; push_cast; ring
  set a : Fin 3 → ℤ → ℝ := fun n j =>
    (eLpNorm (lpDelta n ((expo n : ℤ) * j + k n) (f n)) (ENNReal.ofReal (pv n)) volume).toReal
    with ha
  have ha0 : ∀ n j, 0 ≤ a n j := fun n j => ENNReal.toReal_nonneg
  set N : Fin 3 → ℝ := fun n => (eLpNorm (f n) (ENNReal.ofReal (pv n)) volume).toReal with hN
  -- the single-scale gain for each `j`
  have hpiece : ∀ j : ℤ, eLpNorm (freqPiece j k f) 1 volume
      ≤ ENNReal.ofReal (C * lam ^ (-δ)) * ∏ n, ENNReal.ofReal (a n j) := by
    intro j
    have hsupp : ∀ ξ, 𝓕 (lpDelta n0 ((expo n0 : ℤ) * j + k n0) (f n0) : E3 → ℂ) ξ ≠ 0 →
        lam * (2 : ℝ) ^ ((expo n0 : ℤ) * j) ≤ |ξ n0| := by
      intro ξ hξ
      have h := fourier_lpDelta_support n0 _ _ ξ hξ
      rw [hlamdef, ← zpow_add₀ two_ne_zero]
      convert h using 2; rw [hn0]; ring
    have h := hss j (fun n => lpDelta n ((expo n : ℤ) * j + k n) (f n)) n0 lam hlam hsupp
    rw [ENNReal.ofReal_one] at h
    refine h.trans_eq ?_
    congr 1
    refine Finset.prod_congr rfl fun n _ => ?_
    rw [ha, ENNReal.ofReal_toReal (eLpNorm_schwartz_ne_top _ _)]
  -- Hölder in `j`
  have hhol : ∑ j ∈ Finset.Icc (-(J : ℤ)) J, ∏ n, a n j
      ≤ ∏ n, (∑ j ∈ Finset.Icc (-(J : ℤ)) J, a n j ^ pv n) ^ (1 / pv n) := by
    simp only [Fin.prod_univ_three]
    refine sum_mul3_le_holder _ (ha0 0) (ha0 1) (ha0 2) (hpv0 0) (hpv0 1) (hpv0 2) ?_
    simpa [Fin.sum_univ_three, one_div] using hsum
  -- the square function in each coordinate
  have hsq : ∀ n, (∑ j ∈ Finset.Icc (-(J : ℤ)) J, a n j ^ pv n) ^ (1 / pv n)
      ≤ A n ^ (pv n)⁻¹ * N n := by
    intro n
    have h := hLq n (k n) J (f n)
    have hN0 : 0 ≤ N n := ENNReal.toReal_nonneg
    calc (∑ j ∈ Finset.Icc (-(J : ℤ)) J, a n j ^ pv n) ^ (1 / pv n)
        ≤ (A n * N n ^ pv n) ^ (1 / pv n) :=
          Real.rpow_le_rpow (Finset.sum_nonneg fun j _ => Real.rpow_nonneg (ha0 n j) _) h
            (by have := hpv0 n; positivity)
      _ = A n ^ (pv n)⁻¹ * N n := by
          rw [Real.mul_rpow (hA n).le (Real.rpow_nonneg hN0 _), ← Real.rpow_mul hN0,
            mul_one_div_cancel (hpv0 n).ne', Real.rpow_one, one_div]
  have hkC : kComp k J f = ∑ j ∈ Finset.Icc (-(J : ℤ)) J, freqPiece j k f := by
    funext x; simp [kComp, Finset.sum_apply]
  have hmeas : ∀ j ∈ Finset.Icc (-(J : ℤ)) J,
      AEStronglyMeasurable (freqPiece j k f) volume := fun j _ =>
    (continuous_simplexTj j fun n => lpDelta n ((expo n : ℤ) * j + k n) (f n)).aestronglyMeasurable
  have hprod0 : ∀ j, 0 ≤ ∏ n, a n j := fun j => Finset.prod_nonneg fun n _ => ha0 n j
  have hCl : 0 ≤ C * lam ^ (-δ) := by positivity
  calc eLpNorm (kComp k J f) 1 volume
      ≤ ∑ j ∈ Finset.Icc (-(J : ℤ)) J, eLpNorm (freqPiece j k f) 1 volume := by
        rw [hkC]; exact eLpNorm_sum_le le_rfl
    _ ≤ ∑ j ∈ Finset.Icc (-(J : ℤ)) J,
          ENNReal.ofReal (C * lam ^ (-δ)) * ∏ n, ENNReal.ofReal (a n j) :=
        Finset.sum_le_sum fun j _ => hpiece j
    _ = ENNReal.ofReal (C * lam ^ (-δ) * ∑ j ∈ Finset.Icc (-(J : ℤ)) J, ∏ n, a n j) := by
        rw [ENNReal.ofReal_mul hCl, ENNReal.ofReal_sum_of_nonneg fun j _ => hprod0 j,
          Finset.mul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [ENNReal.ofReal_prod_of_nonneg fun n _ => ha0 n j]
    _ ≤ ENNReal.ofReal (C * lam ^ (-δ) * ∏ n, (A n ^ (pv n)⁻¹ * N n)) := by
        refine ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left (hhol.trans ?_) hCl)
        exact Finset.prod_le_prod₀ (fun n _ => Real.rpow_nonneg (Finset.sum_nonneg fun j _ =>
          Real.rpow_nonneg (ha0 n j) _) _) fun n _ => hsq n
    _ = ENNReal.ofReal (Cf * (2 : ℝ) ^ (-(δ * kMax k))) * ∏ n, ENNReal.ofReal (N n) := by
        rw [← ENNReal.ofReal_prod_of_nonneg fun n _ => ENNReal.toReal_nonneg,
          ← ENNReal.ofReal_mul (by positivity), hlamδ, Finset.prod_mul_distrib, hCf]
        congr 1; ring
    _ = _ := by
        congr 1
        refine Finset.prod_congr rfl fun n _ => ?_
        rw [hN, ENNReal.ofReal_toReal (eLpNorm_schwartz_ne_top _ _)]

/-! ### High frequencies: the small-loss bound (alternative route to line 456)

See `automation/ErrorReport-task4.md`, entry `lem:loss`. -/

/-- The weight `w_j(t) = |ψ(2^j t)/t|` of `T_j`. -/
def wJ (j : ℤ) (t : ℝ) : ℝ≥0∞ := ‖(lpPsi ((2 : ℝ) ^ j * t) : ℂ) / t‖ₑ

theorem measurable_wJ (j : ℤ) : Measurable (wJ j) := by
  unfold wJ
  exact ((Complex.continuous_ofReal.comp (continuous_lpPsi.comp
    (continuous_const.mul continuous_id))).measurable.div Complex.measurable_ofReal).enorm

/-- `w_j(t) ≠ 0` forces `|t| < 2 · 2^{-j}`. -/
theorem abs_lt_of_wJ_ne_zero {j : ℤ} {t : ℝ} (h : wJ j t ≠ 0) : |t| < 2 * (2 : ℝ) ^ (-j) := by
  have h1 : lpPsi ((2 : ℝ) ^ j * t) ≠ 0 := by
    intro h0; apply h; simp [wJ, h0]
  have h2 := (lpPsi_support h1).2
  have hp : (0 : ℝ) < 2 ^ j := zpow_pos two_pos _
  rw [abs_mul, abs_of_pos hp] at h2
  have e : (2 : ℝ) ^ (-j) = (2 ^ j)⁻¹ := zpow_neg _ _
  rw [e, ← div_eq_mul_inv, lt_div_iff₀ hp]; linarith

/-- **Cauchy-Schwarz in `t`** (Hölder `(∞, 2, 2)`): if `|g_0(x + t e_0)| ≤ a` for
`|t| ≤ 2 · 2^{-j}`, then `|T_j(g)(x)| ≤ a (∫ w_j |g_1(x+t^2 e_1)|^2)^{1/2} (∫ w_j |g_2(x+t^3
  e_2)|^2)^{1/2}`. -/
theorem enorm_simplexTj_le (j : ℤ) (g : Fin 3 → E3 → ℂ) (hg : ∀ n, Continuous (g n)) (x : E3)
    (a : ℝ≥0∞) (ha : ∀ t : ℝ, |t| < 2 * (2 : ℝ) ^ (-j) → ‖g 0 (x + curve 0 t)‖ₑ ≤ a) :
    ‖simplexTj j g x‖ₑ ≤ a *
      ((∫⁻ t, wJ j t * ‖g 1 (x + curve 1 t)‖ₑ ^ (2 : ℝ)) ^ (1 / 2 : ℝ) *
        (∫⁻ t, wJ j t * ‖g 2 (x + curve 2 t)‖ₑ ^ (2 : ℝ)) ^ (1 / 2 : ℝ)) := by
  have hcont : ∀ n, Continuous fun t : ℝ => g n (x + curve n t) := fun n =>
    (hg n).comp (continuous_const.add ((continuous_pow _).smul continuous_const))
  set u : Fin 3 → ℝ → ℝ≥0∞ := fun n t => ‖g n (x + curve n t)‖ₑ with hu
  have hum : ∀ n, Measurable (u n) := fun n => (hcont n).measurable.enorm
  -- pointwise domination
  have hpt : ∀ t, ‖(lpPsi ((2 : ℝ) ^ j * t) : ℂ) * prodShift g x t / t‖ₑ
      ≤ a * ((wJ j t ^ (1 / 2 : ℝ) * u 1 t) * (wJ j t ^ (1 / 2 : ℝ) * u 2 t)) := by
    intro t
    have e : ‖(lpPsi ((2 : ℝ) ^ j * t) : ℂ) * prodShift g x t / t‖ₑ
        = wJ j t * (u 0 t * (u 1 t * u 2 t)) := by
      rw [mul_div_right_comm, enorm_mul, prodShift, Fin.prod_univ_three, enorm_mul, enorm_mul,
        mul_assoc];
      rfl
    have e2 : (wJ j t ^ (1 / 2 : ℝ) * u 1 t) * (wJ j t ^ (1 / 2 : ℝ) * u 2 t)
        = wJ j t * (u 1 t * u 2 t) := by
      rw [mul_mul_mul_comm, ← ENNReal.rpow_add_of_nonneg _ _ (by norm_num) (by norm_num)]
      norm_num
    rw [e, e2]
    by_cases hw : wJ j t = 0
    · simp [hw]
    · have := ha t (abs_lt_of_wJ_ne_zero hw)
      calc wJ j t * (u 0 t * (u 1 t * u 2 t)) = u 0 t * (wJ j t * (u 1 t * u 2 t)) := by ring
        _ ≤ a * (wJ j t * (u 1 t * u 2 t)) := by gcongr
  unfold simplexTj
  refine (enorm_integral_le_lintegral_enorm _).trans ?_
  refine (lintegral_mono hpt).trans ?_
  have hf : Measurable fun t => wJ j t ^ (1 / 2 : ℝ) * u 1 t :=
    ((measurable_wJ j).pow_const _).mul (hum 1)
  have hg2 : Measurable fun t => wJ j t ^ (1 / 2 : ℝ) * u 2 t :=
    ((measurable_wJ j).pow_const _).mul (hum 2)
  rw [lintegral_const_mul a (f := fun t => (wJ j t ^ (1 / 2 : ℝ) * u 1 t) *
    (wJ j t ^ (1 / 2 : ℝ) * u 2 t)) (hf.mul hg2)]
  gcongr
  have h := ENNReal.lintegral_mul_le_Lp_mul_Lq volume Real.HolderConjugate.two_two
    hf.aemeasurable hg2.aemeasurable
  have e : ∀ n t, (wJ j t ^ (1 / 2 : ℝ) * u n t) ^ (2 : ℝ) = wJ j t * u n t ^ (2 : ℝ) := by
    intro n t
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul]; norm_num
  simp only [e] at h
  exact h

/-- `ψ̃_c` as a coordinate multiplier. -/
def psiTildeCM (c : ℤ) : CoordMult :=
  ⟨lpPsiTildeJ c, contDiff_lpPsiTildeJ c, hasCompactSupport_lpPsiTildeJ c, fun ζ => by
    simp only [lpPsiTildeJ, mul_neg, lpPsiTilde_neg]⟩

theorem psiTildeCM_op (c : ℤ) (ℓ : Fin 3) : (psiTildeCM c).op ℓ = lpDeltaTilde ℓ c := rfl

/-- Dyadic scaling of the line kernel: `ψ̃̌_c(u) = 2^c ψ̃̌_0(2^c u)`. -/
theorem psiTildeCM_check_eq (c : ℤ) (u : ℝ) :
    (psiTildeCM c).check u = (((2 : ℝ) ^ c : ℝ) : ℂ) * (psiTildeCM 0).check ((2 : ℝ) ^ c * u) := by
  rw [CoordMult.check_eq, CoordMult.check_eq]
  have hp : (0 : ℝ) < 2 ^ c := zpow_pos two_pos _
  have h := Measure.integral_comp_mul_left (fun η : ℝ =>
    (Real.fourierChar (η * ((2 : ℝ) ^ c * u)) : ℂ) * (((psiTildeCM 0).h η : ℝ) : ℂ))
    ((2 : ℝ) ^ (-c))
  have e1 : (fun ζ : ℝ => (Real.fourierChar (ζ * u) : ℂ) * (((psiTildeCM c).h ζ : ℝ) : ℂ))
      = fun ζ => (Real.fourierChar ((2 : ℝ) ^ (-c) * ζ * ((2 : ℝ) ^ c * u)) : ℂ) *
          (((psiTildeCM 0).h ((2 : ℝ) ^ (-c) * ζ) : ℝ) : ℂ) := by
    funext ζ
    have e : (2 : ℝ) ^ (-c) * ζ * ((2 : ℝ) ^ c * u) = ζ * u := by
      rw [zpow_neg]; field_simp
    rw [e]
    simp only [psiTildeCM, lpPsiTildeJ, neg_zero, zpow_zero, one_mul]
  rw [e1, h, zpow_neg, inv_inv, abs_of_pos hp, Complex.real_smul]

/-- `|ψ̃̌_0(u)| ≤ K (1 + |u|)^{-10}`. -/
theorem exists_psiTildeCM_check_decay :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ u : ℝ, ‖(psiTildeCM 0).check u‖ ≤ K * Twisted.bracketKernel u := by
  set f := (psiTildeCM 0).check
  set K : ℝ := 2 ^ 10 * (Finset.Iic ((10 : ℕ), (0 : ℕ))).sup
    (fun m => SchwartzMap.seminorm ℝ m.1 m.2) f
  have hK : 0 ≤ K := by positivity
  refine ⟨K, hK, fun u => ?_⟩
  have h := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := ((10 : ℕ), (0 : ℕ)))
    (k := 10) (n := 0) le_rfl le_rfl f u
  rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at h
  have hpos : 0 < (1 + |u|) ^ 10 := by positivity
  unfold Twisted.bracketKernel
  rw [Real.rpow_neg (by positivity), show ((10 : ℝ)) = ((10 : ℕ) : ℝ) by norm_num,
    Real.rpow_natCast, ← div_eq_mul_inv, le_div_iff₀ hpos, mul_comm]
  exact h

/-- The scaled bracket: `|ψ̃̌_c(u)| ≤ K b_{2^{-c}}(u)`, `b_s(u) = s^{-1}(1 + |u|/s)^{-10}`. -/
theorem norm_psiTildeCM_check_le {K : ℝ} (hK : ∀ u : ℝ, ‖(psiTildeCM 0).check u‖ ≤ K *
  Twisted.bracketKernel u)
    (c : ℤ) (u : ℝ) :
    ‖(psiTildeCM c).check u‖ ≤ K * Twisted.bracketKernelAt ((2 : ℝ) ^ (-c)) 0 u := by
  have hp : (0 : ℝ) < 2 ^ c := zpow_pos two_pos _
  rw [psiTildeCM_check_eq, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hp]
  simp only [Twisted.bracketKernelAt, Twisted.kernelAt, Twisted.kernelDilate, sub_zero,
    smul_eq_mul, zpow_neg, inv_inv, div_inv_eq_mul]
  calc (2 : ℝ) ^ c * ‖(psiTildeCM 0).check ((2 : ℝ) ^ c * u)‖
      ≤ 2 ^ c * (K * Twisted.bracketKernel ((2 : ℝ) ^ c * u)) :=
        mul_le_mul_of_nonneg_left (hK _) hp.le
    _ = K * (2 ^ c * Twisted.bracketKernel (u * 2 ^ c)) := by rw [mul_comm u]; ring

/-- Peetre's shift inequality for the bracket: `b_s(v + t) ≤ (1 + |t|/s)^{10} b_s(v)`. -/
theorem bracketKernelAt_add_le {s : ℝ} (hs : 0 < s) (v t : ℝ) :
    Twisted.bracketKernelAt s 0 (v + t) ≤ (1 + |t| / s) ^ (10 : ℝ) * Twisted.bracketKernelAt s 0 v
      := by
  simp only [Twisted.bracketKernelAt, Twisted.kernelAt, Twisted.kernelDilate, sub_zero,
    smul_eq_mul, Twisted.bracketKernel]
  have h1 : 0 < 1 + |v / s| := by positivity
  have h2 : 0 < 1 + |(v + t) / s| := by positivity
  have h3 : 0 < 1 + |t| / s := by positivity
  have htri : 1 + |v / s| ≤ (1 + |(v + t) / s|) * (1 + |t| / s) := by
    have : |v / s| ≤ |(v + t) / s| + |t| / s := by
      have h' : |v / s| ≤ |(v + t) / s| + |t / s| := by
        rw [show v / s = (v + t) / s - t / s by ring]; exact abs_sub _ _
      rwa [abs_div t s, abs_of_pos hs] at h'
    nlinarith [abs_nonneg ((v + t) / s), div_nonneg (abs_nonneg t) hs.le]
  rw [mul_left_comm]
  refine mul_le_mul_of_nonneg_left ?_ (inv_nonneg.mpr hs.le)
  rw [Real.rpow_neg h2.le, Real.rpow_neg h1.le, ← div_eq_mul_inv, le_div_iff₀
    (Real.rpow_pos_of_pos h1 _)]
  rw [mul_comm, ← div_eq_mul_inv, div_le_iff₀ (Real.rpow_pos_of_pos h2 _), ← Real.mul_rpow h3.le
    h2.le]
  exact Real.rpow_le_rpow h1.le (by linarith [htri, mul_comm (1 + |(v + t) / s|) (1 + |t| / s)])
    (by norm_num)

/-- A line average against the bracket `b_s` is dominated by the coordinate maximal function. -/
theorem integral_bracket_le_maximal (i : Fin 3) {F : E3 → ℂ} (hF : Measurable F) {B : ℝ}
    (hB : ∀ y, ‖F y‖ ≤ B) {s : ℝ} (hs : 0 < s) (x : E3) :
    (∫ r : ℝ, ‖F (x - r • basisVec i)‖ * Twisted.bracketKernelAt s 0 r)
      ≤ Twisted.dyadicBracketShellConstant * Twisted.coordinateDyadicBallMaximal i F x := by
  have hB0 : 0 ≤ B := (norm_nonneg _).trans (hB x)
  rw [← coordinateDirection_eq_basisVec,
    Twisted.displacementBracket_eq_coordinateBracketConvolution]
  exact Twisted.coordinateBracketConvolution_le_shell_dyadic i F hF B hB0 hB s x hs

/-- **The `∞` slot** (alternative route, line 456): from `Δ_m = Δ̃_m Δ_m`, Hölder, the decay of
`ψ̃̌` and Peetre's shift inequality, for `s > 1`, `|t| ≤ R 2^{-m}`:
`|Δ^{(ℓ)}_m g(x + t e_ℓ)| ≤ C (1 + R)^{10/s} (M^{(ℓ)} |Δ^{(ℓ)}_m g|^s (x))^{1/s}`. -/
theorem enorm_lpDelta_shift_le (ℓ : Fin 3) {s : ℝ} (hs : 1 < s) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (m : ℤ) (g : 𝓢(E3, ℂ)) (x : E3) (t R : ℝ), 0 ≤ R →
      |t| ≤ R * (2 : ℝ) ^ (-m) →
      ‖lpDelta ℓ m g (x + t • basisVec ℓ)‖ₑ ≤ ENNReal.ofReal (C * (1 + R) ^ (10 / s)) *
        ENNReal.ofReal (Twisted.coordinateDyadicBallMaximal ℓ
          (fun y => ((‖lpDelta ℓ m g y‖ ^ s : ℝ) : ℂ)) x) ^ (1 / s) := by
  obtain ⟨K, hK0, hK⟩ := exists_psiTildeCM_check_decay
  set D := Twisted.dyadicBracketShellConstant with hD
  have hD0 : 0 ≤ D := Twisted.dyadicBracketShellConstant_nonneg
  have hs0 : 0 < s := by linarith
  set s' := s.conjExponent with hs'
  have hhol : s'.HolderConjugate s := (Real.HolderConjugate.conjExponent hs).symm
  have hs'0 : 0 < s' := hhol.pos
  set C : ℝ := (K * (2 / 9)) ^ (1 / s') * (K * D) ^ (1 / s) with hC
  refine ⟨C, by positivity, fun m g x t R hR ht => ?_⟩
  set G := lpDelta ℓ m g with hG
  set χ := psiTildeCM m with hχ
  set y := x + t • basisVec ℓ with hy
  set r : ℝ := (2 : ℝ) ^ (-m) with hr
  have hr0 : 0 < r := zpow_pos two_pos _
  set b : ℝ → ℝ := fun v => Twisted.bracketKernelAt r 0 v with hb
  have hb0 : ∀ v, 0 ≤ b v := fun v => Twisted.bracketKernelAt_nonneg hr0.le
  have hbint : Integrable b := Twisted.integrable_bracketKernelAt hr0 0
  have hcheck : ∀ u, ‖χ.check u‖ ≤ K * b u := norm_psiTildeCM_check_le hK m
  obtain ⟨B, hB0, hBG⟩ := exists_bound_schwartz G
  set F : E3 → ℂ := fun z => ((‖G z‖ ^ s : ℝ) : ℂ) with hF
  have hFm : Measurable F :=
    Complex.continuous_ofReal.measurable.comp (G.continuous.norm.measurable.pow_const s)
  have hFB : ∀ z, ‖F z‖ ≤ B ^ s := fun z => by
    rw [hF, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)]
    exact Real.rpow_le_rpow (norm_nonneg _) (hBG z) hs0.le
  have hline : ∀ v : ℝ, Continuous fun u : ℝ => G (v • basisVec ℓ + -(u • basisVec ℓ)) := fun v =>
    G.continuous.comp (continuous_const.add (continuous_id.smul continuous_const).neg)
  -- the reproducing formula
  have hrep : G y = ∫ u : ℝ, χ.check u * G (y - u • basisVec ℓ) := by
    have h := CoordMult.op_eq_lineConv χ ℓ G y
    rwa [hχ, psiTildeCM_op, hG, lpDeltaTilde_lpDelta] at h
  have hmeasG : ∀ z : E3, Measurable fun u : ℝ => ‖G (z - u • basisVec ℓ)‖ₑ := fun z =>
    (G.continuous.comp (continuous_const.sub (continuous_id.smul
      continuous_const))).measurable.enorm
  have hmeasc : Measurable fun u : ℝ => ‖χ.check u‖ₑ := χ.check.continuous.measurable.enorm
  -- Hölder with the measure `|ψ̃̌_m(u)| du`
  have h1 : ‖G y‖ₑ ≤ (∫⁻ u, ‖χ.check u‖ₑ) ^ (1 / s') *
      (∫⁻ u, ‖χ.check u‖ₑ * ‖G (y - u • basisVec ℓ)‖ₑ ^ s) ^ (1 / s) := by
    rw [hrep]
    refine (enorm_integral_le_lintegral_enorm _).trans ?_
    have hH := ENNReal.lintegral_mul_le_Lp_mul_Lq volume hhol
      ((hmeasc.pow_const (1 / s')).aemeasurable)
      (((hmeasc.pow_const (1 / s)).mul (hmeasG y)).aemeasurable)
    have e1 : ∀ u, ‖χ.check u * G (y - u • basisVec ℓ)‖ₑ
        = (fun u => ‖χ.check u‖ₑ ^ (1 / s')) u *
          (fun u => ‖χ.check u‖ₑ ^ (1 / s) * ‖G (y - u • basisVec ℓ)‖ₑ) u := by
      intro u
      simp only
      have hsum : 1 / s' + 1 / s = 1 := by rw [one_div, one_div]; exact hhol.inv_add_inv_eq_one
      rw [enorm_mul, ← mul_assoc, ← ENNReal.rpow_add_of_nonneg _ _ (by positivity) (by positivity),
        hsum, ENNReal.rpow_one]
    simp_rw [e1]
    refine hH.trans_eq ?_
    congr 2
    · refine lintegral_congr fun u => ?_
      rw [← ENNReal.rpow_mul, one_div_mul_cancel hs'0.ne', ENNReal.rpow_one]
    · refine lintegral_congr fun u => ?_
      simp only [Pi.mul_apply]
      rw [ENNReal.mul_rpow_of_nonneg _ _ hs0.le, ← ENNReal.rpow_mul, one_div_mul_cancel hs0.ne',
        ENNReal.rpow_one]
  -- the mass of `|ψ̃̌_m|`
  have h2 : ∫⁻ u, ‖χ.check u‖ₑ ≤ ENNReal.ofReal (K * (2 / 9)) := by
    calc ∫⁻ u, ‖χ.check u‖ₑ ≤ ∫⁻ u, ENNReal.ofReal (K * b u) :=
          lintegral_mono fun u => by rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal (hcheck u)
      _ = ENNReal.ofReal (∫ u, K * b u) := by
          rw [ofReal_integral_eq_lintegral_ofReal (hbint.const_mul K)
            (Eventually.of_forall fun u => mul_nonneg hK0 (hb0 u))]
      _ = ENNReal.ofReal (K * (2 / 9)) := by
          rw [integral_const_mul, hb, Twisted.integral_bracketKernelAt hr0]
  -- the shifted average
  have h3 : ∫⁻ u, ‖χ.check u‖ₑ * ‖G (y - u • basisVec ℓ)‖ₑ ^ s
      ≤ ENNReal.ofReal (K * (1 + R) ^ (10 : ℝ)) *
        ENNReal.ofReal (D * Twisted.coordinateDyadicBallMaximal ℓ F x) := by
    have hshift : (∫⁻ u, ‖χ.check u‖ₑ * ‖G (y - u • basisVec ℓ)‖ₑ ^ s)
        = ∫⁻ v, ‖χ.check (v + t)‖ₑ * ‖G (x - v • basisVec ℓ)‖ₑ ^ s := by
      rw [← lintegral_add_right_eq_self (μ := volume)
        (fun u => ‖χ.check u‖ₑ * ‖G (y - u • basisVec ℓ)‖ₑ ^ s) t]
      refine lintegral_congr fun v => ?_
      simp only [hy, add_smul]
      congr 3; abel
    have hpeetre : ∀ v, ‖χ.check (v + t)‖ₑ ≤ ENNReal.ofReal (K * (1 + R) ^ (10 : ℝ)) *
        ENNReal.ofReal (b v) := by
      intro v
      rw [← ENNReal.ofReal_mul (by positivity), ← ofReal_norm]
      refine ENNReal.ofReal_le_ofReal ((hcheck _).trans ?_)
      rw [mul_assoc]
      refine mul_le_mul_of_nonneg_left ((bracketKernelAt_add_le hr0 v t).trans ?_) hK0
      refine mul_le_mul_of_nonneg_right (Real.rpow_le_rpow (by positivity) ?_ (by norm_num)) (hb0 v)
      have : |t| / r ≤ R := by rw [div_le_iff₀ hr0]; exact ht
      linarith
    have hint : Integrable fun v : ℝ => ‖F (x - v • basisVec ℓ)‖ * b v := by
      refine (hbint.const_mul (B ^ s)).mono' ?_ (Eventually.of_forall fun v => ?_)
      · exact ((hFm.comp (measurable_const.sub (measurable_id.smul_const
          _))).norm.aestronglyMeasurable).mul
          hbint.aestronglyMeasurable
      · rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (norm_nonneg _) (hb0 v))]
        exact mul_le_mul_of_nonneg_right (hFB _) (hb0 v)
    rw [hshift]
    calc ∫⁻ v, ‖χ.check (v + t)‖ₑ * ‖G (x - v • basisVec ℓ)‖ₑ ^ s
        ≤ ∫⁻ v, ENNReal.ofReal (K * (1 + R) ^ (10 : ℝ)) *
            ENNReal.ofReal (‖F (x - v • basisVec ℓ)‖ * b v) := by
          refine lintegral_mono fun v => ?_
          rw [ENNReal.ofReal_mul (norm_nonneg _), mul_comm (ENNReal.ofReal ‖F _‖), ← mul_assoc]
          refine mul_le_mul' (hpeetre v) (le_of_eq ?_)
          rw [hF, Complex.norm_real, Real.norm_eq_abs,
            abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _),
            ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hs0.le, ofReal_norm]
      _ = ENNReal.ofReal (K * (1 + R) ^ (10 : ℝ)) *
            ENNReal.ofReal (∫ v, ‖F (x - v • basisVec ℓ)‖ * b v) := by
          rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
            ofReal_integral_eq_lintegral_ofReal hint
              (Eventually.of_forall fun v => mul_nonneg (norm_nonneg _) (hb0 v))]
      _ ≤ _ := by
          gcongr
          exact integral_bracket_le_maximal ℓ hFm hFB hr0 x
  -- assemble
  have hM0 : 0 ≤ Twisted.coordinateDyadicBallMaximal ℓ F x := ENNReal.toReal_nonneg
  calc ‖G y‖ₑ ≤ ENNReal.ofReal (K * (2 / 9)) ^ (1 / s') *
        (ENNReal.ofReal (K * (1 + R) ^ (10 : ℝ)) *
          ENNReal.ofReal (D * Twisted.coordinateDyadicBallMaximal ℓ F x)) ^ (1 / s) := by
        refine h1.trans ?_
        gcongr
    _ = ENNReal.ofReal (C * (1 + R) ^ (10 / s)) *
        ENNReal.ofReal (Twisted.coordinateDyadicBallMaximal ℓ F x) ^ (1 / s) := by
        have hR1 : 0 ≤ 1 + R := by linarith
        have eL : ENNReal.ofReal (K * (2 / 9)) ^ (1 / s') *
            (ENNReal.ofReal (K * (1 + R) ^ (10 : ℝ)) *
              ENNReal.ofReal (D * Twisted.coordinateDyadicBallMaximal ℓ F x)) ^ (1 / s)
            = ENNReal.ofReal ((K * (2 / 9)) ^ (1 / s') *
              (K * (1 + R) ^ (10 : ℝ) * (D * Twisted.coordinateDyadicBallMaximal ℓ F x)) ^ (1 /
                s)) := by
          rw [← ENNReal.ofReal_mul (by positivity),
            ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity),
            ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity),
            ← ENNReal.ofReal_mul (by positivity)]
        have eR : ENNReal.ofReal (C * (1 + R) ^ (10 / s)) *
            ENNReal.ofReal (Twisted.coordinateDyadicBallMaximal ℓ F x) ^ (1 / s)
            = ENNReal.ofReal (C * (1 + R) ^ (10 / s) *
              Twisted.coordinateDyadicBallMaximal ℓ F x ^ (1 / s)) := by
          rw [ENNReal.ofReal_rpow_of_nonneg hM0 (by positivity), ← ENNReal.ofReal_mul
            (by positivity)]
        rw [eL, eR]
        congr 1
        have h10 : ((1 + R) ^ (10 : ℝ)) ^ (1 / s) = (1 + R) ^ (10 / s) := by
          rw [← Real.rpow_mul hR1]; ring_nf
        rw [hC, Real.mul_rpow (by positivity) (by positivity),
          Real.mul_rpow (by positivity) (by positivity),
          Real.mul_rpow (by positivity) hM0, Real.mul_rpow hK0 hD0,
          Real.mul_rpow hK0 (Real.rpow_nonneg hR1 _), h10]
        ring

/-- `w_j(t) ≤ (2/r) 1_{r/2 ≤ |t| ≤ 2r}`, `r = 2^{-j}`. -/
theorem wJ_le_indicator (j : ℤ) (t : ℝ) :
    wJ j t ≤ ENNReal.ofReal (2 / (2 : ℝ) ^ (-j)) *
      Set.indicator (Set.Icc ((2 : ℝ) ^ (-j) / 2) (2 * (2 : ℝ) ^ (-j))) 1 |t| := by
  set r : ℝ := (2 : ℝ) ^ (-j) with hr
  have hr0 : 0 < r := zpow_pos two_pos _
  by_cases hw : wJ j t = 0
  · rw [hw]; exact bot_le
  have h1 : lpPsi ((2 : ℝ) ^ j * t) ≠ 0 := by intro h0; apply hw; simp [wJ, h0]
  obtain ⟨hlo, hhi⟩ := lpPsi_support h1
  have hp : (0 : ℝ) < 2 ^ j := zpow_pos two_pos _
  have e : (2 : ℝ) ^ j = r⁻¹ := by rw [hr, zpow_neg, inv_inv]
  rw [abs_mul, abs_of_pos hp, e] at hlo hhi
  have ht1 : r / 2 ≤ |t| := by
    rw [div_le_iff₀ two_pos]; rw [← div_eq_inv_mul, le_div_iff₀ hr0] at hlo; linarith
  have ht2 : |t| ≤ 2 * r := by
    rw [← div_eq_inv_mul, div_lt_iff₀ hr0] at hhi; linarith
  have ht0 : 0 < |t| := lt_of_lt_of_le (by positivity) ht1
  rw [Set.indicator_of_mem (Set.mem_Icc.mpr ⟨ht1, ht2⟩), Pi.one_apply, mul_one, wJ,
    ← ofReal_norm, norm_div, Complex.norm_real, Complex.norm_real,
    Real.norm_eq_abs, Real.norm_eq_abs]
  refine ENNReal.ofReal_le_ofReal ?_
  rw [div_le_div_iff₀ ht0 hr0]
  have := lpPsi_abs_le_one ((2 : ℝ) ^ j * t)
  nlinarith [abs_nonneg (lpPsi ((2 : ℝ) ^ j * t))]

/-- The substitution `σ = t^e` on `[r/2, 2r]`. -/
theorem setLIntegral_comp_pow_le {e : ℕ} (he : 1 ≤ e) {r : ℝ} (hr : 0 < r) {φ : ℝ → ℝ≥0∞} :
    ∫⁻ t in Set.Icc (r / 2) (2 * r), φ (t ^ e)
      ≤ ENNReal.ofReal ((2 / r) ^ (e - 1) / e) * ∫⁻ σ in Set.Icc 0 ((2 * r) ^ e), φ σ := by
  set S := Set.Icc (r / 2) (2 * r) with hS
  have hSpos : ∀ t ∈ S, 0 < t := fun t ht => lt_of_lt_of_le (by positivity) ht.1
  have hderiv : ∀ t ∈ S, HasDerivWithinAt (fun t : ℝ => t ^ e) ((e : ℝ) * t ^ (e - 1)) S t :=
    fun t _ => (hasDerivAt_pow e t).hasDerivWithinAt
  have hinj : Set.InjOn (fun t : ℝ => t ^ e) S :=
    ((pow_left_strictMonoOn₀ (by omega : e ≠ 0)).injOn).mono fun t ht => le_of_lt (hSpos t ht)
  have hcv := lintegral_image_eq_lintegral_abs_deriv_mul measurableSet_Icc hderiv hinj φ
  have hc0 : 0 ≤ (2 / r) ^ (e - 1) / e := by positivity
  calc ∫⁻ t in S, φ (t ^ e)
      ≤ ∫⁻ t in S, ENNReal.ofReal ((2 / r) ^ (e - 1) / e) *
          (ENNReal.ofReal |(e : ℝ) * t ^ (e - 1)| * φ (t ^ e)) := by
        refine setLIntegral_mono' measurableSet_Icc fun t ht => ?_
        rw [← mul_assoc, ← ENNReal.ofReal_mul hc0]
        conv_lhs => rw [← one_mul (φ (t ^ e))]
        gcongr
        rw [ENNReal.one_le_ofReal, abs_of_pos (by have := hSpos t ht; positivity)]
        have hte : (1 : ℝ) ≤ (2 / r * t) ^ (e - 1) := by
          refine one_le_pow₀ ?_
          rw [div_mul_eq_mul_div, le_div_iff₀ hr]; linarith [ht.1]
        have hepos : (0 : ℝ) < e := by exact_mod_cast (show 0 < e by omega)
        calc (1 : ℝ) ≤ (2 / r * t) ^ (e - 1) := hte
          _ = (2 / r) ^ (e - 1) / e * (e * t ^ (e - 1)) := by
            rw [mul_pow]; field_simp
    _ = ENNReal.ofReal ((2 / r) ^ (e - 1) / e) * ∫⁻ σ in (fun t : ℝ => t ^ e) '' S, φ σ := by
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, hcv]
    _ ≤ _ := by
        gcongr
        intro σ hσ
        obtain ⟨t, ht, rfl⟩ := hσ
        have ht0 := hSpos t ht
        exact ⟨by positivity, pow_le_pow_left₀ ht0.le ht.2 e⟩

/-- On `[0, 2^e R]` the bracket `b_R` is at least `(1 + 2^e)^{-10} / R`. -/
theorem one_le_bracketKernelAt {e : ℕ} {R0 σ : ℝ} (hR : 0 < R0) (hσ : |σ| ≤ 2 ^ e * R0) :
    1 ≤ (1 + 2 ^ e) ^ (10 : ℝ) * R0 * Twisted.bracketKernelAt R0 0 σ := by
  simp only [Twisted.bracketKernelAt, Twisted.kernelAt, Twisted.kernelDilate, sub_zero,
    smul_eq_mul, Twisted.bracketKernel]
  have h1 : 0 < 1 + |σ / R0| := by positivity
  have hle : 1 + |σ / R0| ≤ 1 + 2 ^ e := by
    have : |σ| / R0 ≤ 2 ^ e := by rw [div_le_iff₀ hR]; exact hσ
    rw [abs_div, abs_of_pos hR]; linarith
  rw [Real.rpow_neg h1.le]
  have e1 : R0 * (R0⁻¹ * ((1 + |σ / R0|) ^ (10 : ℝ))⁻¹) = ((1 + |σ / R0|) ^ (10 : ℝ))⁻¹ := by
    field_simp
  rw [mul_assoc, e1, ← div_eq_mul_inv, le_div_iff₀ (Real.rpow_pos_of_pos h1 _), one_mul]
  exact Real.rpow_le_rpow h1.le hle (by norm_num)

theorem bracketKernelAt_neg (s σ : ℝ) :
    Twisted.bracketKernelAt s 0 (-σ) = Twisted.bracketKernelAt s 0 σ := by
  simp [Twisted.bracketKernelAt, Twisted.kernelAt, Twisted.kernelDilate, Twisted.bracketKernel,
    neg_div, abs_neg]

/-- **The curve average is dominated by the coordinate maximal function**: uniformly in `j`,
`∫ w_j(t) |h(y ± t^{n+1} e_n)| dt ≤ C M^{(n)} h(y)`. -/
theorem lintegral_wJ_curve_le_maximal (n : Fin 3) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (j : ℤ) (h : E3 → ℂ), Measurable h → ∀ B : ℝ, (∀ y, ‖h y‖ ≤ B) →
      ∀ (y : E3) (sg : ℝ), (sg = 1 ∨ sg = -1) →
      ∫⁻ t, wJ j t * ‖h (y + sg • curve n t)‖ₑ
        ≤ ENNReal.ofReal (C * Twisted.coordinateDyadicBallMaximal n h y) := by
  set e := expo n with he_def
  have he : 1 ≤ e := expo_pos n
  have hepos : (0 : ℝ) < e := by exact_mod_cast (show 0 < e by omega)
  set D := Twisted.dyadicBracketShellConstant
  have hD0 : 0 ≤ D := Twisted.dyadicBracketShellConstant_nonneg
  refine ⟨4 * 2 ^ e * (1 + 2 ^ e) ^ (10 : ℝ) / e * D, by positivity, fun j h hh B hB y sg hsg => ?_⟩
  set r : ℝ := (2 : ℝ) ^ (-j) with hr
  have hr0 : 0 < r := zpow_pos two_pos _
  set R0 : ℝ := r ^ e with hR0
  have hR00 : 0 < R0 := by positivity
  set S := Set.Icc (r / 2) (2 * r) with hS
  set b : ℝ → ℝ := fun σ => Twisted.bracketKernelAt R0 0 σ with hb
  have hb0 : ∀ σ, 0 ≤ b σ := fun σ => Twisted.bracketKernelAt_nonneg hR00.le
  have hbint : Integrable b := Twisted.integrable_bracketKernelAt hR00 0
  set ρ : ℝ → ℝ≥0∞ := fun σ => ‖h (y - σ • basisVec n)‖ₑ with hρ
  have hρm : Measurable ρ :=
    (hh.comp (measurable_const.sub (measurable_id.smul_const _))).enorm
  set φ : ℝ → ℝ≥0∞ := fun σ => ρ σ + ρ (-σ) with hφ
  have hφm : Measurable φ := hρm.add (hρm.comp measurable_neg)
  have hφeven : ∀ σ, φ (-σ) = φ σ := fun σ => by simp only [hφ, neg_neg]; ring
  set Kc : ℝ := (2 / r) ^ (e - 1) / e with hKc
  set L : ℝ := (1 + 2 ^ e) ^ (10 : ℝ) * R0 with hL
  -- Step A: the integrand is at most `w_j(t) φ(t^e)`
  have hA : ∀ t, ‖h (y + sg • curve n t)‖ₑ ≤ φ (t ^ e) := by
    intro t
    have : y + sg • curve n t = y - (-(sg * t ^ e)) • basisVec n := by
      simp only [curve, he_def, smul_smul, neg_smul, sub_neg_eq_add]
    rw [this]
    rcases hsg with rfl | rfl
    · simp only [one_mul, hφ, hρ]; exact le_add_self
    · simp only [neg_mul, one_mul, neg_neg, hφ, hρ]; exact le_self_add
  -- Step B: fold `t < 0` onto `t > 0`
  have hB' : ∫⁻ t, wJ j t * φ (t ^ e)
      ≤ ENNReal.ofReal (2 / r) * (2 * ∫⁻ t in S, φ (t ^ e)) := by
    have hind : ∀ t : ℝ, S.indicator (1 : ℝ → ℝ≥0∞) |t| = S.indicator (1 : ℝ → ℝ≥0∞) t +
      S.indicator (1 : ℝ → ℝ≥0∞) (-t) := by
      intro t
      rcases lt_trichotomy t 0 with ht | ht | ht
      · have : t ∉ S := fun h' => by linarith [h'.1, show 0 < r / 2 by positivity]
        rw [abs_of_neg ht, Set.indicator_of_notMem this, zero_add]
      · subst ht
        have : (0 : ℝ) ∉ S := fun h' => by linarith [h'.1, show 0 < r / 2 by positivity]
        simp [this]
      · have : -t ∉ S := fun h' => by linarith [h'.1, show 0 < r / 2 by positivity]
        rw [abs_of_pos ht, Set.indicator_of_notMem this, add_zero]
    calc ∫⁻ t, wJ j t * φ (t ^ e)
        ≤ ∫⁻ t, ENNReal.ofReal (2 / r) * (S.indicator (1 : ℝ → ℝ≥0∞) |t| * φ (t ^ e)) := by
          refine lintegral_mono fun t => ?_
          rw [← mul_assoc]; exact mul_le_mul' (wJ_le_indicator j t) le_rfl
      _ = ENNReal.ofReal (2 / r) * ((∫⁻ t, S.indicator (1 : ℝ → ℝ≥0∞) t * φ (t ^ e)) +
            ∫⁻ t, S.indicator (1 : ℝ → ℝ≥0∞) (-t) * φ (t ^ e)) := by
          rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, ← lintegral_add_left]
          · congr 1; refine lintegral_congr fun t => ?_; rw [hind, add_mul]
          · exact (((measurable_one.indicator measurableSet_Icc).mul
              (hφm.comp (measurable_id.pow_const e))) :
                Measurable fun t => S.indicator (1 : ℝ → ℝ≥0∞) t * φ (t ^ e))
      _ = ENNReal.ofReal (2 / r) * (2 * ∫⁻ t in S, φ (t ^ e)) := by
          have e2 : ∫⁻ t, S.indicator (1 : ℝ → ℝ≥0∞) (-t) * φ (t ^ e) = ∫⁻ t, S.indicator (1 : ℝ →
            ℝ≥0∞) t * φ (t ^ e) := by
            rw [← lintegral_neg_eq_self (fun t => S.indicator (1 : ℝ → ℝ≥0∞) (-t) * φ (t ^ e))]
            refine lintegral_congr fun t => ?_
            simp only [neg_neg]
            congr 1
            rcases neg_one_pow_eq_or ℝ e with h1 | h1
            · rw [neg_pow, h1, one_mul]
            · rw [neg_pow, h1, neg_one_mul, hφeven]
          rw [e2, ← two_mul]
          congr 2
          rw [← lintegral_indicator measurableSet_Icc]
          refine lintegral_congr fun t => ?_
          by_cases ht : t ∈ S
          · rw [Set.indicator_of_mem ht, Set.indicator_of_mem ht, Pi.one_apply, one_mul]
          · rw [Set.indicator_of_notMem ht, Set.indicator_of_notMem ht, zero_mul]
  -- Step C: substitute `σ = t^e` and dominate by the bracket
  have hC : ∫⁻ t in S, φ (t ^ e) ≤ ENNReal.ofReal Kc * (ENNReal.ofReal L * ∫⁻ σ, ENNReal.ofReal (b
    σ) * φ σ) := by
    refine (setLIntegral_comp_pow_le he hr0).trans ?_
    gcongr
    calc ∫⁻ σ in Set.Icc 0 ((2 * r) ^ e), φ σ
        ≤ ∫⁻ σ in Set.Icc 0 ((2 * r) ^ e), ENNReal.ofReal L * (ENNReal.ofReal (b σ) * φ σ) := by
          refine setLIntegral_mono' measurableSet_Icc fun σ hσ => ?_
          rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
          conv_lhs => rw [← one_mul (φ σ)]
          gcongr
          rw [ENNReal.one_le_ofReal]
          have hσ' : |σ| ≤ 2 ^ e * R0 := by
            rw [abs_of_nonneg hσ.1, hR0, ← mul_pow]; exact hσ.2
          exact one_le_bracketKernelAt hR00 hσ'
      _ ≤ ∫⁻ σ, ENNReal.ofReal L * (ENNReal.ofReal (b σ) * φ σ) := setLIntegral_le_lintegral _ _
      _ = _ := lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
  -- Step D, E: reflect and apply the maximal bound
  have hint : Integrable fun σ : ℝ => ‖h (y - σ • basisVec n)‖ * b σ := by
    refine (hbint.const_mul B).mono' ?_ (Eventually.of_forall fun σ => ?_)
    · exact ((hh.comp (measurable_const.sub (measurable_id.smul_const
        _))).norm.aestronglyMeasurable).mul
        hbint.aestronglyMeasurable
    · rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (norm_nonneg _) (hb0 σ))]
      exact mul_le_mul_of_nonneg_right (hB _) (hb0 σ)
  have hDE : ∫⁻ σ, ENNReal.ofReal (b σ) * φ σ
      ≤ 2 * ENNReal.ofReal (D * Twisted.coordinateDyadicBallMaximal n h y) := by
    have hmeasb : Measurable fun σ => ENNReal.ofReal (b σ) :=
      ENNReal.measurable_ofReal.comp (Twisted.continuous_bracketKernelAt hR00.ne' 0).measurable
    have hsplit : ∫⁻ σ, ENNReal.ofReal (b σ) * φ σ
        = (∫⁻ σ, ENNReal.ofReal (b σ) * ρ σ) + ∫⁻ σ, ENNReal.ofReal (b σ) * ρ (-σ) := by
      rw [← lintegral_add_left (f := fun σ => ENNReal.ofReal (b σ) * ρ σ) (hmeasb.mul hρm)]
      refine lintegral_congr fun σ => ?_
      rw [hφ, mul_add]
    have hrefl : ∫⁻ σ, ENNReal.ofReal (b σ) * ρ (-σ) = ∫⁻ σ, ENNReal.ofReal (b σ) * ρ σ := by
      rw [← lintegral_neg_eq_self (fun σ => ENNReal.ofReal (b σ) * ρ σ)]
      refine lintegral_congr fun σ => ?_
      simp only [hb, bracketKernelAt_neg]
    have hone : ∫⁻ σ, ENNReal.ofReal (b σ) * ρ σ
        ≤ ENNReal.ofReal (D * Twisted.coordinateDyadicBallMaximal n h y) := by
      calc ∫⁻ σ, ENNReal.ofReal (b σ) * ρ σ
          = ∫⁻ σ, ENNReal.ofReal (‖h (y - σ • basisVec n)‖ * b σ) := by
            refine lintegral_congr fun σ => ?_
            rw [ENNReal.ofReal_mul (norm_nonneg _), ofReal_norm, mul_comm]
        _ = ENNReal.ofReal (∫ σ, ‖h (y - σ • basisVec n)‖ * b σ) :=
            (ofReal_integral_eq_lintegral_ofReal hint
              (Eventually.of_forall fun σ => mul_nonneg (norm_nonneg _) (hb0 σ))).symm
        _ ≤ _ := ENNReal.ofReal_le_ofReal (integral_bracket_le_maximal n hh hB hR00 y)
    rw [hsplit, hrefl, ← two_mul]
    gcongr
  have hM0 : 0 ≤ Twisted.coordinateDyadicBallMaximal n h y := ENNReal.toReal_nonneg
  have hkey : (2 / r) * Kc * L = 2 ^ e * (1 + 2 ^ e) ^ (10 : ℝ) / e := by
    have hp : (2 / r) ^ (e - 1) * (2 / r) = (2 / r) ^ e := by
      rw [← pow_succ, Nat.sub_add_cancel he]
    have hq : (2 / r) ^ e * r ^ e = 2 ^ e := by rw [div_pow]; field_simp
    rw [hKc, hL, hR0]
    calc 2 / r * ((2 / r) ^ (e - 1) / e) * ((1 + 2 ^ e) ^ (10 : ℝ) * r ^ e)
        = ((2 / r) ^ (e - 1) * (2 / r)) * r ^ e * (1 + 2 ^ e) ^ (10 : ℝ) / e := by ring
      _ = _ := by rw [hp, hq]
  calc ∫⁻ t, wJ j t * ‖h (y + sg • curve n t)‖ₑ
      ≤ ∫⁻ t, wJ j t * φ (t ^ e) := lintegral_mono fun t => by gcongr; exact hA t
    _ ≤ ENNReal.ofReal (2 / r) * (2 * (ENNReal.ofReal Kc * (ENNReal.ofReal L *
          (2 * ENNReal.ofReal (D * Twisted.coordinateDyadicBallMaximal n h y))))) := by
        refine hB'.trans ?_
        gcongr
        exact hC.trans (by gcongr)
    _ = ENNReal.ofReal (4 * 2 ^ e * (1 + 2 ^ e) ^ (10 : ℝ) / e * D *
          Twisted.coordinateDyadicBallMaximal n h y) := by
        have h2 : (2 : ℝ≥0∞) = ENNReal.ofReal 2 := by simp
        have hKc0 : 0 ≤ Kc := by positivity
        have hL0 : 0 ≤ L := by positivity
        rw [h2, ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul hL0,
          ← ENNReal.ofReal_mul hKc0, ← ENNReal.ofReal_mul (by norm_num),
          ← ENNReal.ofReal_mul (by positivity)]
        congr 1
        calc 2 / r * (2 * (Kc * (L * (2 * (D * Twisted.coordinateDyadicBallMaximal n h y)))))
            = 4 * ((2 / r) * Kc * L) * D * Twisted.coordinateDyadicBallMaximal n h y := by ring
          _ = _ := by rw [hkey]; ring

/-- The curve average `B_j(G)(x) = ∫ w_j(t) |G(x + t^{n+1} e_n)|^2 dt`. -/
def curveAvg (n : Fin 3) (j : ℤ) (G : E3 → ℂ) (x : E3) : ℝ≥0∞ :=
  ∫⁻ t, wJ j t * ‖G (x + curve n t)‖ₑ ^ (2 : ℝ)

theorem measurable_curveAvg (n : Fin 3) (j : ℤ) {G : E3 → ℂ} (hG : Measurable G) :
    Measurable (curveAvg n j G) := by
  unfold curveAvg
  refine Measurable.lintegral_prod_right' (f := fun p : E3 × ℝ =>
    wJ j p.2 * ‖G (p.1 + curve n p.2)‖ₑ ^ (2 : ℝ)) ?_
  exact ((measurable_wJ j).comp measurable_snd).mul
    ((hG.comp (measurable_fst.add ((continuous_curve n).measurable.comp
      measurable_snd))).enorm.pow_const _)

/-- **Duality for the curve average** (Tonelli and translation invariance):
`∫ B_j(G) K = ∫ |G(y)|^2 ∫ w_j(t) K(y - t^{n+1} e_n) dt dy`. -/
theorem lintegral_curveAvg_mul (n : Fin 3) (j : ℤ) {G : E3 → ℂ} (hG : Measurable G)
    {K : E3 → ℝ≥0∞} (hK : Measurable K) :
    ∫⁻ x, curveAvg n j G x * K x
      = ∫⁻ y, ‖G y‖ₑ ^ (2 : ℝ) * ∫⁻ t, wJ j t * K (y - curve n t) := by
  have hc := (continuous_curve n).measurable
  have hj1 : Measurable fun p : E3 × ℝ => wJ j p.2 * ‖G (p.1 + curve n p.2)‖ₑ ^ (2 : ℝ) * K p.1 :=
    (((measurable_wJ j).comp measurable_snd).mul
      ((hG.comp (measurable_fst.add (hc.comp measurable_snd))).enorm.pow_const _)).mul
      (hK.comp measurable_fst)
  have hj2 : Measurable fun p : E3 × ℝ => ‖G p.1‖ₑ ^ (2 : ℝ) * (wJ j p.2 * K (p.1 - curve n p.2)) :=
    ((hG.comp measurable_fst).enorm.pow_const _).mul (((measurable_wJ j).comp measurable_snd).mul
      (hK.comp (measurable_fst.sub (hc.comp measurable_snd))))
  calc ∫⁻ x, curveAvg n j G x * K x
      = ∫⁻ x, ∫⁻ t, wJ j t * ‖G (x + curve n t)‖ₑ ^ (2 : ℝ) * K x := by
        refine lintegral_congr fun x => ?_
        rw [curveAvg, ← lintegral_mul_const (f := fun t => wJ j t * ‖G (x + curve n t)‖ₑ ^ (2 : ℝ))
          _ (((measurable_wJ j).mul ((hG.comp (measurable_const.add hc)).enorm.pow_const _)))]
    _ = ∫⁻ t, ∫⁻ x, wJ j t * ‖G (x + curve n t)‖ₑ ^ (2 : ℝ) * K x :=
        lintegral_lintegral_swap hj1.aemeasurable
    _ = ∫⁻ t, ∫⁻ y, ‖G y‖ₑ ^ (2 : ℝ) * (wJ j t * K (y - curve n t)) := by
        refine lintegral_congr fun t => ?_
        rw [← lintegral_add_right_eq_self (μ := volume)
          (fun y => ‖G y‖ₑ ^ (2 : ℝ) * (wJ j t * K (y - curve n t))) (curve n t)]
        refine lintegral_congr fun x => ?_
        simp only [add_sub_cancel_right]; ring
    _ = ∫⁻ y, ∫⁻ t, ‖G y‖ₑ ^ (2 : ℝ) * (wJ j t * K (y - curve n t)) :=
        (lintegral_lintegral_swap hj2.aemeasurable).symm
    _ = _ := by
        refine lintegral_congr fun y => ?_
        rw [lintegral_const_mul]
        exact ((measurable_wJ j).mul (hK.comp (measurable_const.sub hc)))

/-- `|G|^2` of a Schwartz function lies in every `L^ρ`. -/
theorem memLp_sq_schwartz (G : 𝓢(E3, ℂ)) {ρ : ℝ} :
    MemLp (fun y => ((‖G y‖ ^ (2 : ℝ) : ℝ) : ℂ)) (ENNReal.ofReal ρ) volume := by
  have h := (G.memLp (ENNReal.ofReal (2 * ρ)) volume).norm_rpow_div 2
  have e : ENNReal.ofReal (2 * ρ) / 2 = ENNReal.ofReal ρ := by
    rw [show (2 : ℝ≥0∞) = ENNReal.ofReal 2 by simp, ← ENNReal.ofReal_div_of_pos two_pos]
    congr 1; ring
  rw [e] at h
  exact h.ofReal (K := ℂ)

/-- `|G|^2` as a complex function. -/
def sqC (G : E3 → ℂ) (y : E3) : ℂ := ((‖G y‖ ^ (2 : ℝ) : ℝ) : ℂ)

theorem measurable_sqC {G : E3 → ℂ} (hG : Measurable G) : Measurable (sqC G) :=
  Complex.continuous_ofReal.measurable.comp (hG.norm.pow_const _)

theorem norm_sqC_le {G : E3 → ℂ} {B : ℝ} (hB : ∀ y, ‖G y‖ ≤ B) (y : E3) :
    ‖sqC G y‖ ≤ B ^ (2 : ℝ) := by
  rw [sqC, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)]
  exact Real.rpow_le_rpow (norm_nonneg _) (hB y) (by norm_num)

theorem enorm_sqC (G : E3 → ℂ) (z : E3) : ‖sqC G z‖ₑ = ‖G z‖ₑ ^ (2 : ℝ) := by
  rw [sqC, ← ofReal_norm, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _),
    ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by norm_num), ofReal_norm]

/-- The coordinate maximal constant of `Auto.Twisted.eLpNorm_coordinateDyadicBallMaximal_le`. -/
def maxConst (p : ℝ) : ℝ≥0∞ := (ENNReal.ofReal p * (2 * ENNReal.ofReal 4 *
    (ENNReal.ofReal (p - 1))⁻¹ * (ENNReal.ofReal (2 : ℝ)) ^ (p - 1))) ^ (1 / p)

theorem maxConst_ne_top {p : ℝ} (hp : 1 < p) : maxConst p ≠ ⊤ := by
  unfold maxConst
  apply ENNReal.rpow_ne_top_of_nonneg (div_nonneg zero_le_one (by linarith))
  apply ENNReal.mul_ne_top ENNReal.ofReal_ne_top
  apply ENNReal.mul_ne_top
  · apply ENNReal.mul_ne_top
    · exact ENNReal.mul_ne_top (by norm_num) ENNReal.ofReal_ne_top
    · exact ENNReal.inv_ne_top.mpr (by simpa using hp)
  · exact ENNReal.rpow_ne_top_of_nonneg (by linarith) ENNReal.ofReal_ne_top

/-- The sum of the maximal functions of `|G_j|^2` lies in `L^ρ`. -/
theorem lintegral_sum_maximal_sqC_lt_top (n : Fin 3) {ρ : ℝ} (hρ : 1 < ρ) (C1 : ℝ) (S : Finset ℤ)
    (G : ℤ → 𝓢(E3, ℂ)) :
    ∫⁻ x, ‖C1 * ∑ j ∈ S, Twisted.coordinateDyadicBallMaximal n (sqC (G j)) x‖ₑ ^ ρ < ⊤ := by
  have hρ0 : 0 < ρ := by linarith
  have hmem : MemLp (fun x => C1 * ∑ j ∈ S, Twisted.coordinateDyadicBallMaximal n (sqC (G j)) x)
      (ENNReal.ofReal ρ) volume := by
    refine MemLp.const_mul (memLp_finsetSum (f := fun j x => Twisted.coordinateDyadicBallMaximal n
      (sqC (G j)) x)
      _ fun j _ => ?_) C1
    obtain ⟨B, hB0, hB⟩ := exists_bound_schwartz (G j)
    exact Twisted.coordinateDyadicBallMaximal_memLp n (sqC (G j))
      (measurable_sqC (G j).continuous.measurable) _ (Real.rpow_nonneg hB0 _) (norm_sqC_le hB)
        hρ
      (memLp_sq_schwartz (G j) )
  have hlt := hmem.eLpNorm_lt_top
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hρ0) ENNReal.ofReal_ne_top
    hmem.aestronglyMeasurable,
    ENNReal.toReal_ofReal hρ0.le] at hlt
  by_contra hc
  rw [not_lt, top_le_iff] at hc
  rw [hc, ENNReal.top_rpow_of_pos (by positivity)] at hlt
  exact lt_irrefl _ hlt

theorem maximal_nonneg (n : Fin 3) (h : E3 → ℂ) (x : E3) :
    0 ≤ Twisted.coordinateDyadicBallMaximal n h x := ENNReal.toReal_nonneg

/-- **The `L^2` slots** (alternative route, line 456): for `ρ > 1`,
`‖∑_j B_j(G_j)‖_ρ ≲ ‖∑_j |G_j|^2‖_ρ` uniformly in the finite family, by duality with the
coordinate maximal function. -/
theorem lintegral_sum_curveAvg_rpow_le (n : Fin 3) {ρ : ℝ} (hρ : 1 < ρ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (S : Finset ℤ) (G : ℤ → 𝓢(E3, ℂ)),
      ∫⁻ x, (∑ j ∈ S, curveAvg n j (G j) x) ^ ρ
        ≤ ENNReal.ofReal C * ∫⁻ x, (∑ j ∈ S, ‖G j x‖ₑ ^ (2 : ℝ)) ^ ρ := by
  obtain ⟨C1, hC10, hC1⟩ := lintegral_wJ_curve_le_maximal n
  have hρ0 : 0 < ρ := by linarith
  set ρ' := ρ.conjExponent with hρ'
  have hhol : ρ.HolderConjugate ρ' := Real.HolderConjugate.conjExponent hρ
  have hρ'1 : 1 < ρ' := hhol.symm.lt
  have hρ'0 : 0 < ρ' := by linarith
  set CM := maxConst ρ' with hCM
  have hCMfin : CM ≠ ⊤ := maxConst_ne_top hρ'1
  refine ⟨(C1 * CM.toReal) ^ ρ, by positivity, fun S G => ?_⟩
  set F : E3 → ℝ≥0∞ := fun x => ∑ j ∈ S, curveAvg n j (G j) x with hF
  set Φ : E3 → ℝ≥0∞ := fun x => ∑ j ∈ S, ‖G j x‖ₑ ^ (2 : ℝ) with hΦ
  have hFm : Measurable F := Finset.measurable_sum _ fun j _ =>
    measurable_curveAvg n j (G j).continuous.measurable
  have hΦm : Measurable Φ := Finset.measurable_sum _ fun j _ =>
    (G j).continuous.measurable.enorm.pow_const _
  choose Bd hBd0 hBd using fun j => exists_bound_schwartz (G j)
  -- pointwise domination of `F`
  have hFle : ∀ x, F x ≤ ENNReal.ofReal (C1 * ∑ j ∈ S,
      Twisted.coordinateDyadicBallMaximal n (sqC (G j)) x) := by
    intro x
    rw [Finset.mul_sum, ENNReal.ofReal_sum_of_nonneg (f := fun j =>
      C1 * Twisted.coordinateDyadicBallMaximal n (sqC (G j)) x)
      fun j _ => mul_nonneg hC10 ENNReal.toReal_nonneg]
    refine Finset.sum_le_sum fun j _ => ?_
    have h := hC1 j (sqC (G j)) (measurable_sqC (G j).continuous.measurable) _
      (norm_sqC_le (hBd j)) x 1 (Or.inl rfl)
    simp only [one_smul, enorm_sqC] at h
    exact h
  set Btot : ℝ := C1 * ∑ j ∈ S, Bd j ^ (2 : ℝ) with hBtot
  have hB0 : 0 ≤ Btot := mul_nonneg hC10 (Finset.sum_nonneg fun j _ => Real.rpow_nonneg (hBd0 j) _)
  have hFB : ∀ x, F x ≤ ENNReal.ofReal Btot := fun x =>
    (hFle x).trans (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left
      (Finset.sum_le_sum fun j _ => Twisted.coordinateDyadicBallMaximal_top_bound n (sqC (G j)) _
        (Real.rpow_nonneg (hBd0 j) _) (norm_sqC_le (hBd j)) x) hC10))
  have hFfin : ∀ x, F x ≠ ⊤ := fun x => ne_top_of_le_ne_top ENNReal.ofReal_ne_top (hFB x)
  set I := ∫⁻ x, F x ^ ρ with hI
  set J := ∫⁻ x, Φ x ^ ρ with hJ
  -- `I < ∞`
  have hIfin : I ≠ ⊤ := by
    refine ne_top_of_le_ne_top (lintegral_sum_maximal_sqC_lt_top n hρ C1 S G).ne
      (lintegral_mono fun x => ENNReal.rpow_le_rpow ((hFle x).trans_eq ?_) hρ0.le)
    rw [← ofReal_norm, Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hC10
      (Finset.sum_nonneg fun j _ => maximal_nonneg n _ x))]
  -- the dual function `F^{ρ-1}`
  set H : E3 → ℂ := fun y => (((F y).toReal ^ (ρ - 1) : ℝ) : ℂ) with hH
  have hHm : Measurable H :=
    Complex.continuous_ofReal.measurable.comp (hFm.ennreal_toReal.pow_const _)
  have hHB : ∀ y, ‖H y‖ ≤ Btot ^ (ρ - 1) := fun y => by
    rw [hH, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg
      ENNReal.toReal_nonneg _)]
    refine Real.rpow_le_rpow ENNReal.toReal_nonneg ?_ (by linarith)
    simpa [ENNReal.toReal_ofReal hB0] using ENNReal.toReal_mono ENNReal.ofReal_ne_top (hFB y)
  have hHnorm : ∀ z, ‖H z‖ₑ = F z ^ (ρ - 1) := fun z => by
    rw [hH, ← ofReal_norm, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg ENNReal.toReal_nonneg _),
      ← ENNReal.ofReal_rpow_of_nonneg ENNReal.toReal_nonneg (by linarith),
      ENNReal.ofReal_toReal (hFfin z)]
  set MH : E3 → ℝ := Twisted.coordinateDyadicBallMaximal n H with hMH
  have hMHm : Measurable MH := Twisted.coordinateDyadicBallMaximal_measurable n H hHm
  -- duality
  have hdual : I ≤ ∫⁻ y, Φ y * ENNReal.ofReal (C1 * MH y) := by
    calc I = ∫⁻ x, F x * F x ^ (ρ - 1) := by
          refine lintegral_congr fun x => ?_
          conv_lhs => rw [show ρ = 1 + (ρ - 1) by ring]
          rw [ENNReal.rpow_add_of_nonneg _ _ (by norm_num) (by linarith), ENNReal.rpow_one]
      _ = ∑ j ∈ S, ∫⁻ x, curveAvg n j (G j) x * F x ^ (ρ - 1) := by
          rw [← lintegral_finsetSum (f := fun j x => curveAvg n j (G j) x * F x ^ (ρ - 1)) _ fun j
            _ =>
            (measurable_curveAvg n j (G j).continuous.measurable).mul (hFm.pow_const _)]
          refine lintegral_congr fun x => ?_
          rw [hF, Finset.sum_mul]
      _ = ∑ j ∈ S, ∫⁻ y, ‖G j y‖ₑ ^ (2 : ℝ) * ∫⁻ t, wJ j t * F (y - curve n t) ^ (ρ - 1) :=
          Finset.sum_congr rfl fun j _ =>
            lintegral_curveAvg_mul n j (G j).continuous.measurable (hFm.pow_const _)
      _ ≤ ∑ j ∈ S, ∫⁻ y, ‖G j y‖ₑ ^ (2 : ℝ) * ENNReal.ofReal (C1 * MH y) := by
          refine Finset.sum_le_sum fun j _ => lintegral_mono fun y => ?_
          gcongr
          have h := hC1 j H hHm _ hHB y (-1) (Or.inr rfl)
          simp only [hHnorm, neg_one_smul, ← sub_eq_add_neg] at h
          exact h
      _ = _ := by
          rw [← lintegral_finsetSum (f := fun j y => ‖G j y‖ₑ ^ (2 : ℝ) * ENNReal.ofReal (C1 * MH
            y))
            _ fun j _ => ((G j).continuous.measurable.enorm.pow_const _).mul
              (ENNReal.measurable_ofReal.comp (measurable_const.mul hMHm))]
          refine lintegral_congr fun y => ?_
          rw [hΦ, Finset.sum_mul]
  -- Hölder, then the maximal theorem for `H`
  have hMHnorm : ∀ y, ENNReal.ofReal (C1 * MH y) = ENNReal.ofReal C1 * ‖MH y‖ₑ := fun y => by
    rw [ENNReal.ofReal_mul hC10, ← ofReal_norm, Real.norm_eq_abs, abs_of_nonneg (maximal_nonneg n
      H y)]
  have hHol := ENNReal.lintegral_mul_le_Lp_mul_Lq volume hhol (f := Φ)
    (g := fun y => ENNReal.ofReal (C1 * MH y)) hΦm.aemeasurable
    (ENNReal.measurable_ofReal.comp (measurable_const.mul hMHm)).aemeasurable
  have hMax := Twisted.eLpNorm_coordinateDyadicBallMaximal_le n H hHm _ (by positivity) hHB hρ'1
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hρ'0) ENNReal.ofReal_ne_top
    (by fun_prop),
    eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hρ'0) ENNReal.ofReal_ne_top
      (by fun_prop),
    ENNReal.toReal_ofReal hρ'0.le] at hMax
  have hHint : ∫⁻ y, ‖H y‖ₑ ^ ρ' = I := by
    refine lintegral_congr fun y => ?_
    rw [hHnorm, ← ENNReal.rpow_mul]
    congr 1
    have h1 : ρ - 1 ≠ 0 := (sub_pos.mpr hρ).ne'
    rw [hρ', Real.conjExponent]; field_simp
  rw [hHint] at hMax
  have hMHint : (∫⁻ y, ENNReal.ofReal (C1 * MH y) ^ ρ') ^ (1 / ρ')
      ≤ ENNReal.ofReal C1 * (CM * I ^ (1 / ρ')) := by
    simp_rw [hMHnorm]
    rw [show (fun y => (ENNReal.ofReal C1 * ‖MH y‖ₑ) ^ ρ')
        = fun y => ENNReal.ofReal C1 ^ ρ' * ‖MH y‖ₑ ^ ρ' from
          funext fun y => ENNReal.mul_rpow_of_nonneg _ _ hρ'0.le,
      lintegral_const_mul' _ _ (ENNReal.rpow_ne_top_of_nonneg hρ'0.le ENNReal.ofReal_ne_top),
      ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
      mul_one_div_cancel hρ'0.ne', ENNReal.rpow_one]
    gcongr
    exact hMax
  have hmain : I ≤ ENNReal.ofReal C1 * CM * J ^ (1 / ρ) * I ^ (1 / ρ') := by
    calc I ≤ J ^ (1 / ρ) * (∫⁻ y, ENNReal.ofReal (C1 * MH y) ^ ρ') ^ (1 / ρ') := hdual.trans hHol
      _ ≤ J ^ (1 / ρ) * (ENNReal.ofReal C1 * (CM * I ^ (1 / ρ'))) := by gcongr
      _ = _ := by ring
  -- cancel `I^{1/ρ'}`
  by_cases hI0 : I = 0
  · rw [hI0]; exact bot_le
  have hsplit : I = I ^ (1 / ρ) * I ^ (1 / ρ') := by
    rw [← ENNReal.rpow_add_of_nonneg _ _ (by positivity) (by positivity), one_div, one_div,
      hhol.inv_add_inv_eq_one, ENNReal.rpow_one]
  have hIρ'0 : I ^ (1 / ρ') ≠ 0 := by
    intro h; rw [ENNReal.rpow_eq_zero_iff] at h
    rcases h with ⟨h, _⟩ | ⟨h, _⟩
    · exact hI0 h
    · exact hIfin h
  have hIρ'fin : I ^ (1 / ρ') ≠ ⊤ := ENNReal.rpow_ne_top_of_nonneg (by positivity) hIfin
  have hroot : I ^ (1 / ρ) ≤ ENNReal.ofReal C1 * CM * J ^ (1 / ρ) := by
    have h := hmain
    nth_rewrite 1 [hsplit] at h
    exact (ENNReal.mul_le_mul_iff_left hIρ'0 hIρ'fin).mp h
  have hfinal : I ≤ (ENNReal.ofReal C1 * CM) ^ ρ * J := by
    have h := ENNReal.rpow_le_rpow hroot hρ0.le
    rwa [← ENNReal.rpow_mul, one_div_mul_cancel hρ0.ne', ENNReal.rpow_one,
      ENNReal.mul_rpow_of_nonneg _ _ hρ0.le, ← ENNReal.rpow_mul (J), one_div_mul_cancel hρ0.ne',
      ENNReal.rpow_one] at h
  refine hfinal.trans_eq ?_
  congr 1
  rw [← ENNReal.ofReal_toReal hCMfin, ← ENNReal.ofReal_mul hC10,
    ENNReal.ofReal_rpow_of_nonneg (by positivity) hρ0.le, ENNReal.toReal_ofReal
      ENNReal.toReal_nonneg]

/-- The pieces `Δ^{(n)}_{(n+1)j+k_n} f_n` of `T^{(k)}`. -/
def kDelta (k : Fin 3 → ℤ) (f : Fin 3 → 𝓢(E3, ℂ)) (n : Fin 3) (j : ℤ) : 𝓢(E3, ℂ) :=
  lpDelta n ((expo n : ℤ) * j + k n) (f n)

theorem freqPiece_eq_kDelta (j : ℤ) (k : Fin 3 → ℤ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    freqPiece j k f x = simplexTj j (fun n => ⇑(kDelta k f n j)) x := rfl

@[fun_prop] theorem measurable_kComp (k : Fin 3 → ℤ) (J : ℕ)
    (f : Fin 3 → 𝓢(E3, ℂ)) : Measurable (kComp k J f) := by
  unfold kComp freqPiece
  exact Finset.measurable_sum _ fun j _ => (continuous_simplexTj j _).measurable

/-- **The pointwise bound behind the small-loss estimate**: Hölder `(∞, 2, 2)` in `t` for each
`j`, then `(∞, 2, 2)` in `j`, with the `∞` slot controlled by `Auto.enorm_lpDelta_shift_le`. -/
theorem enorm_kComp_le {s : ℝ} (hs : 1 < s) :
    ∃ C0 : ℝ, 0 ≤ C0 ∧ ∀ (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) (q : ℝ), 0 < q →
      ‖kComp k J f x‖ₑ ≤
        (∑ j ∈ Finset.Icc (-(J : ℤ)) J,
          (ENNReal.ofReal (C0 * (1 + (2 : ℝ) ^ (k 0 + 1)) ^ (10 / s)) *
            ENNReal.ofReal (Twisted.coordinateDyadicBallMaximal 0
              (fun y => ((‖kDelta k f 0 j y‖ ^ s : ℝ) : ℂ)) x) ^ (1 / s)) ^ q) ^ (1 / q) *
        ((∑ j ∈ Finset.Icc (-(J : ℤ)) J, curveAvg 1 j (kDelta k f 1 j) x) ^ (1 / 2 : ℝ) *
          (∑ j ∈ Finset.Icc (-(J : ℤ)) J, curveAvg 2 j (kDelta k f 2 j) x) ^ (1 / 2 : ℝ)) := by
  obtain ⟨C0, hC00, hC0⟩ := enorm_lpDelta_shift_le 0 hs
  refine ⟨C0, hC00, fun k J f x q hq => ?_⟩
  set Sj := Finset.Icc (-(J : ℤ)) J
  set a : ℤ → ℝ≥0∞ := fun j => ENNReal.ofReal (C0 * (1 + (2 : ℝ) ^ (k 0 + 1)) ^ (10 / s)) *
    ENNReal.ofReal (Twisted.coordinateDyadicBallMaximal 0
      (fun y => ((‖kDelta k f 0 j y‖ ^ s : ℝ) : ℂ)) x) ^ (1 / s) with ha
  set B1 : ℤ → ℝ≥0∞ := fun j => curveAvg 1 j (kDelta k f 1 j) x
  set B2 : ℤ → ℝ≥0∞ := fun j => curveAvg 2 j (kDelta k f 2 j) x
  -- each piece
  have hpiece : ∀ j, ‖freqPiece j k f x‖ₑ ≤ a j * (B1 j ^ (1 / 2 : ℝ) * B2 j ^ (1 / 2 : ℝ)) := by
    intro j
    rw [freqPiece_eq_kDelta]
    refine enorm_simplexTj_le j _ (fun n => (kDelta k f n j).continuous) x (a j) fun t ht => ?_
    have hR : (0 : ℝ) ≤ (2 : ℝ) ^ (k 0 + 1) := (zpow_pos two_pos _).le
    have ht' : |t| ≤ (2 : ℝ) ^ (k 0 + 1) * (2 : ℝ) ^ (-((expo 0 : ℤ) * j + k 0)) := by
      have e : (2 : ℝ) ^ (k 0 + 1) * (2 : ℝ) ^ (-((expo 0 : ℤ) * j + k 0)) = 2 * (2 : ℝ) ^ (-j) :=
        by
        rw [← zpow_add₀ two_ne_zero, show expo 0 = 1 from rfl]
        rw [show k 0 + 1 + -((((1 : ℕ) : ℤ)) * j + k 0) = 1 + -j by push_cast; ring,
          zpow_add₀ two_ne_zero, zpow_one]
      rw [e]; exact ht.le
    have h := hC0 ((expo 0 : ℤ) * j + k 0) (f 0) x t _ hR ht'
    have hc : curve 0 t = t • basisVec 0 := by simp [curve, show expo 0 = 1 from rfl]
    rw [hc]
    exact h
  have hsum : ‖kComp k J f x‖ₑ ≤ ∑ j ∈ Sj, a j * (B1 j ^ (1 / 2 : ℝ) * B2 j ^ (1 / 2 : ℝ)) := by
    unfold kComp
    exact (enorm_sum_le _ _).trans (Finset.sum_le_sum fun j _ => hpiece j)
  -- `a_j ≤ (∑ a^q)^{1/q}`
  have hsup : ∀ j ∈ Sj, a j ≤ (∑ i ∈ Sj, a i ^ q) ^ (1 / q) := by
    intro j hj
    have h1 : a j ^ q ≤ ∑ i ∈ Sj, a i ^ q :=
      Finset.single_le_sum (f := fun i => a i ^ q) (fun i _ => bot_le) hj
    have h2 := ENNReal.rpow_le_rpow h1 (by positivity : (0 : ℝ) ≤ 1 / q)
    rwa [← ENNReal.rpow_mul, mul_one_div_cancel hq.ne', ENNReal.rpow_one] at h2
  -- Cauchy-Schwarz in `j`
  have hcs : ∑ j ∈ Sj, B1 j ^ (1 / 2 : ℝ) * B2 j ^ (1 / 2 : ℝ)
      ≤ (∑ j ∈ Sj, B1 j) ^ (1 / 2 : ℝ) * (∑ j ∈ Sj, B2 j) ^ (1 / 2 : ℝ) := by
    have h := ENNReal.inner_le_Lp_mul_Lq Sj (fun j => B1 j ^ (1 / 2 : ℝ))
      (fun j => B2 j ^ (1 / 2 : ℝ)) Real.HolderConjugate.two_two
    have e : ∀ B : ℝ≥0∞, (B ^ (1 / 2 : ℝ)) ^ (2 : ℝ) = B := fun B => by
      rw [← ENNReal.rpow_mul]; norm_num
    simp only [e] at h
    exact h
  calc ‖kComp k J f x‖ₑ ≤ ∑ j ∈ Sj, a j * (B1 j ^ (1 / 2 : ℝ) * B2 j ^ (1 / 2 : ℝ)) := hsum
    _ ≤ ∑ j ∈ Sj, (∑ i ∈ Sj, a i ^ q) ^ (1 / q) * (B1 j ^ (1 / 2 : ℝ) * B2 j ^ (1 / 2 : ℝ)) :=
        Finset.sum_le_sum fun j hj => by gcongr; exact hsup j hj
    _ = (∑ i ∈ Sj, a i ^ q) ^ (1 / q) * ∑ j ∈ Sj, B1 j ^ (1 / 2 : ℝ) * B2 j ^ (1 / 2 : ℝ) := by
        rw [Finset.mul_sum]
    _ ≤ _ := by gcongr

/-- **The `∞`-slot integral**: `∑_{|j| ≤ J} ‖M^{(0)} |Δ^{(0)}_{j+k_0} g|^{q/2}‖_2^2 ≲ ‖g‖_q^q`, `q
  > 2`. -/
theorem sum_lintegral_maximal_slot_le {q : ℝ} (hq : 2 < q) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ (kn : ℤ) (J : ℕ) (g : 𝓢(E3, ℂ)),
      ∑ j ∈ Finset.Icc (-(J : ℤ)) J, ∫⁻ x, ENNReal.ofReal (Twisted.coordinateDyadicBallMaximal 0
          (fun y => ((‖lpDelta 0 ((expo 0 : ℤ) * j + kn) g y‖ ^ (q / 2) : ℝ) : ℂ)) x) ^ (2 : ℝ)
        ≤ ENNReal.ofReal A * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ q) := by
  obtain ⟨A0, hA0, hS⟩ := sum_lintegral_lpDelta_le 0 (q := q) hq.le
  set CM := maxConst 2 with hCM
  have hCMfin : CM ≠ ⊤ := maxConst_ne_top one_lt_two
  refine ⟨CM.toReal ^ 2 * A0, by positivity, fun kn J g => ?_⟩
  have hq0 : 0 < q := by linarith
  have hterm : ∀ G : 𝓢(E3, ℂ), ∫⁻ x, ENNReal.ofReal (Twisted.coordinateDyadicBallMaximal 0
      (fun y => ((‖G y‖ ^ (q / 2) : ℝ) : ℂ)) x) ^ (2 : ℝ)
      ≤ ENNReal.ofReal (CM.toReal ^ 2) * ∫⁻ x, ENNReal.ofReal (‖G x‖ ^ q) := by
    intro G
    set H : E3 → ℂ := fun y => ((‖G y‖ ^ (q / 2) : ℝ) : ℂ) with hH
    have hHm : Measurable H :=
      Complex.continuous_ofReal.measurable.comp (G.continuous.norm.measurable.pow_const _)
    obtain ⟨B, hB0, hB⟩ := exists_bound_schwartz G
    have hHB : ∀ y, ‖H y‖ ≤ B ^ (q / 2) := fun y => by
      rw [hH, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _)
        _)]
      exact Real.rpow_le_rpow (norm_nonneg _) (hB y) (by positivity)
    have hMax := Twisted.eLpNorm_coordinateDyadicBallMaximal_le 0 H hHm _ (by positivity) hHB
      one_lt_two
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simp) ENNReal.ofReal_ne_top (by fun_prop),
      eLpNorm_eq_lintegral_rpow_enorm_toReal (by simp) ENNReal.ofReal_ne_top (by fun_prop),
      ENNReal.toReal_ofReal zero_le_two] at hMax
    have h2 : ∫⁻ x, ‖Twisted.coordinateDyadicBallMaximal 0 H x‖ₑ ^ (2 : ℝ)
        ≤ CM ^ (2 : ℝ) * ∫⁻ x, ‖H x‖ₑ ^ (2 : ℝ) := by
      have h := ENNReal.rpow_le_rpow hMax (by norm_num : (0 : ℝ) ≤ 2)
      rwa [← ENNReal.rpow_mul, ENNReal.mul_rpow_of_nonneg _ _ (by norm_num),
        ← ENNReal.rpow_mul (∫⁻ _, _), show (1 / 2 : ℝ) * 2 = 1 by norm_num, ENNReal.rpow_one,
        ENNReal.rpow_one] at h
    have eL : ∀ x, ENNReal.ofReal (Twisted.coordinateDyadicBallMaximal 0 H x) ^ (2 : ℝ)
        = ‖Twisted.coordinateDyadicBallMaximal 0 H x‖ₑ ^ (2 : ℝ) := fun x => by
      rw [← ofReal_norm, Real.norm_eq_abs, abs_of_nonneg (maximal_nonneg 0 H x)]
    have eR : ∀ x, ‖H x‖ₑ ^ (2 : ℝ) = ENNReal.ofReal (‖G x‖ ^ q) := fun x => by
      rw [hH, ← ofReal_norm, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _),
        ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _) (by norm_num),
        ← Real.rpow_mul (norm_nonneg _)]
      congr 2; ring
    simp_rw [eL, eR] at h2 ⊢
    refine h2.trans_eq ?_
    congr 1
    rw [← ENNReal.ofReal_toReal hCMfin, ENNReal.ofReal_rpow_of_nonneg ENNReal.toReal_nonneg
      (by norm_num), ENNReal.toReal_ofReal ENNReal.toReal_nonneg, Real.rpow_two]
  have hinj : Set.InjOn (fun j : ℤ => (expo 0 : ℤ) * j + kn) (Finset.Icc (-(J : ℤ)) J) := by
    intro a _ b _ h
    have : (expo 0 : ℤ) * a = (expo 0 : ℤ) * b := by simpa using h
    exact mul_left_cancel₀ (by exact_mod_cast (expo_pos 0).ne') this
  calc _ ≤ ∑ j ∈ Finset.Icc (-(J : ℤ)) J, ENNReal.ofReal (CM.toReal ^ 2) *
        ∫⁻ x, ENNReal.ofReal (‖lpDelta 0 ((expo 0 : ℤ) * j + kn) g x‖ ^ q) :=
        Finset.sum_le_sum fun j _ => hterm _
    _ = ENNReal.ofReal (CM.toReal ^ 2) * ∑ m ∈ (Finset.Icc (-(J : ℤ)) J).image
          (fun j => (expo 0 : ℤ) * j + kn), ∫⁻ x, ENNReal.ofReal (‖lpDelta 0 m g x‖ ^ q) := by
        rw [Finset.sum_image hinj, Finset.mul_sum]
    _ ≤ ENNReal.ofReal (CM.toReal ^ 2) * (ENNReal.ofReal A0 * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ q)) :=
      by
        gcongr; exact hS _ g
    _ = _ := by rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]

/-- **The `L^2`-slot integral**: `∫ (∑_{|j| ≤ J} B_j(Δ^{(n)}_{(n+1)j+k_n} g))^{q/2} ≲ ‖g‖_q^q`, `q
  > 2`. -/
theorem lintegral_curveAvg_slot_le (n : Fin 3) {q : ℝ} (hq : 2 < q) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ (kn : ℤ) (J : ℕ) (g : 𝓢(E3, ℂ)),
      ∫⁻ x, (∑ j ∈ Finset.Icc (-(J : ℤ)) J,
          curveAvg n j (lpDelta n ((expo n : ℤ) * j + kn) g) x) ^ (q / 2)
        ≤ ENNReal.ofReal A * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ q) := by
  obtain ⟨C, hC0, hC⟩ := lintegral_sum_curveAvg_rpow_le n (ρ := q / 2) (by linarith)
  obtain ⟨A1, hA1, hLP⟩ := partial_littlewoodPaley n (q := q) (by linarith)
  refine ⟨C * A1, by positivity, fun kn J g => ?_⟩
  have hinj : Set.InjOn (fun j : ℤ => (expo n : ℤ) * j + kn) (Finset.Icc (-(J : ℤ)) J) := by
    intro a _ b _ h
    have : (expo n : ℤ) * a = (expo n : ℤ) * b := by simpa using h
    exact mul_left_cancel₀ (by exact_mod_cast (expo_pos n).ne') this
  have h1 := hC (Finset.Icc (-(J : ℤ)) J) fun j => lpDelta n ((expo n : ℤ) * j + kn) g
  have h2 := hLP ((Finset.Icc (-(J : ℤ)) J).image fun j => (expo n : ℤ) * j + kn) g
  simp only [Finset.sum_image hinj] at h2
  refine h1.trans ?_
  rw [ENNReal.ofReal_mul hC0, mul_assoc]
  gcongr
  refine le_of_eq_of_le ?_ h2
  refine lintegral_congr fun x => ?_
  rw [← ENNReal.ofReal_rpow_of_nonneg (Finset.sum_nonneg fun j _ => sq_nonneg _) (by positivity),
    ENNReal.ofReal_sum_of_nonneg fun j _ => sq_nonneg _]
  congr 1
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by norm_num)]
  norm_cast

/-- `(∫ |g|^q)^{1/q} = ‖g‖_q`. -/
theorem lintegral_ofReal_norm_rpow_rpow_inv (g : 𝓢(E3, ℂ)) {q : ℝ} (hq : 0 < q) :
    (∫⁻ x, ENNReal.ofReal (‖g x‖ ^ q)) ^ (1 / q) = eLpNorm g (ENNReal.ofReal q) volume := by
  rw [lintegral_ofReal_norm_rpow_eq g hq, ← ENNReal.rpow_mul, mul_one_div_cancel hq.ne',
    ENNReal.rpow_one]

theorem one_add_zpow_le {a b : ℤ} (hab : a ≤ b) (hb : 0 ≤ b) :
    1 + (2 : ℝ) ^ (a + 1) ≤ (2 : ℝ) ^ (b + 2) := by
  have h1 : (2 : ℝ) ^ (a + 1) ≤ 2 ^ (b + 1) := zpow_le_zpow_right₀ (by norm_num) (by omega)
  have h2 : (1 : ℝ) ≤ 2 ^ (b + 1) := one_le_zpow₀ (by norm_num) (by omega)
  have h3 : (2 : ℝ) ^ (b + 2) = 2 * 2 ^ (b + 1) := by
    rw [show b + 2 = 1 + (b + 1) by ring, zpow_add₀ two_ne_zero, zpow_one]
  linarith

/-- **The small-loss bound** (alternative route, line 456): for `q ≥ 3` and `k ∈ F_H`,
`‖T^{(k)}_J(f)‖_{q/3} ≤ C 2^{20 (k^{(1)} + 2)/q} ∏ ‖f_n‖_q`, uniformly in `J`. -/
theorem smallLoss_bound {q : ℝ} (hq : 3 ≤ q) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ k : Fin 3 → ℤ, 0 < kMax k → ∀ (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)),
      eLpNorm (kComp k J f) (ENNReal.ofReal (q / 3)) volume
        ≤ ENNReal.ofReal (C * (2 : ℝ) ^ (20 * ((kMax k : ℝ) + 2) / q)) *
          ∏ n, eLpNorm (f n) (ENNReal.ofReal q) volume := by
  have hq0 : 0 < q := by linarith
  have hq2 : 2 < q := by linarith
  have hs : 1 < q / 2 := by linarith
  obtain ⟨C0, hC00, hC0⟩ := enorm_kComp_le hs
  obtain ⟨A0, hA00, hA0⟩ := sum_lintegral_maximal_slot_le hq2
  obtain ⟨A1, hA10, hA1⟩ := lintegral_curveAvg_slot_le 1 hq2
  obtain ⟨A2, hA20, hA2⟩ := lintegral_curveAvg_slot_le 2 hq2
  refine ⟨C0 * (A0 * A1 * A2) ^ (1 / q), by positivity, fun k hk J f => ?_⟩
  set Sj := Finset.Icc (-(J : ℤ)) J
  set c : ℝ := C0 * (1 + (2 : ℝ) ^ (k 0 + 1)) ^ (10 / (q / 2)) with hc
  have hc0 : 0 ≤ c := by positivity
  set M : ℤ → E3 → ℝ := fun j => Twisted.coordinateDyadicBallMaximal 0
    (fun y => ((‖kDelta k f 0 j y‖ ^ (q / 2) : ℝ) : ℂ)) with hM
  have hMm : ∀ j, Measurable (M j) := fun j => Twisted.coordinateDyadicBallMaximal_measurable 0 _
    (Complex.continuous_ofReal.measurable.comp ((kDelta k f 0
      j).continuous.norm.measurable.pow_const _))
  set A : E3 → ℝ≥0∞ := fun x =>
    (∑ j ∈ Sj, (ENNReal.ofReal c * ENNReal.ofReal (M j x) ^ (1 / (q / 2))) ^ q) ^ (1 / q) with hA
  set P : E3 → ℝ≥0∞ := fun x => (∑ j ∈ Sj, curveAvg 1 j (kDelta k f 1 j) x) ^ (1 / 2 : ℝ) with hP
  set Q : E3 → ℝ≥0∞ := fun x => (∑ j ∈ Sj, curveAvg 2 j (kDelta k f 2 j) x) ^ (1 / 2 : ℝ) with hQ
  have hAm : Measurable A := (Finset.measurable_sum _ fun j _ =>
    (measurable_const.mul ((ENNReal.measurable_ofReal.comp (hMm j)).pow_const _)).pow_const
      _).pow_const _
  have hPm : Measurable P := (Finset.measurable_sum _ fun j _ =>
    measurable_curveAvg 1 j (kDelta k f 1 j).continuous.measurable).pow_const _
  have hQm : Measurable Q := (Finset.measurable_sum _ fun j _ =>
    measurable_curveAvg 2 j (kDelta k f 2 j).continuous.measurable).pow_const _
  have hpt : ∀ x, ‖kComp k J f x‖ₑ ≤ A x * (P x * Q x) := fun x => hC0 k J f x q hq0
  -- the three integrals
  have hIA : ∫⁻ x, A x ^ q ≤ ENNReal.ofReal c ^ q *
      (ENNReal.ofReal A0 * ∫⁻ x, ENNReal.ofReal (‖f 0 x‖ ^ q)) := by
    have e : ∀ x, A x ^ q = ENNReal.ofReal c ^ q * ∑ j ∈ Sj, ENNReal.ofReal (M j x) ^ (2 : ℝ) := by
      intro x
      rw [hA, ← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne', ENNReal.rpow_one, Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← ENNReal.rpow_mul]
      congr 2; field_simp
    simp_rw [e]
    rw [lintegral_const_mul' _ _ (ENNReal.rpow_ne_top_of_nonneg hq0.le ENNReal.ofReal_ne_top),
      lintegral_finsetSum (f := fun j x => ENNReal.ofReal (M j x) ^ (2 : ℝ)) _
        fun j _ => (ENNReal.measurable_ofReal.comp (hMm j)).pow_const _]
    gcongr
    exact hA0 (k 0) J (f 0)
  have hIP : ∫⁻ x, P x ^ q ≤ ENNReal.ofReal A1 * ∫⁻ x, ENNReal.ofReal (‖f 1 x‖ ^ q) := by
    refine le_of_eq_of_le (lintegral_congr fun x => ?_) (hA1 (k 1) J (f 1))
    rw [hP, ← ENNReal.rpow_mul]; congr 1; ring
  have hIQ : ∫⁻ x, Q x ^ q ≤ ENNReal.ofReal A2 * ∫⁻ x, ENNReal.ofReal (‖f 2 x‖ ^ q) := by
    refine le_of_eq_of_le (lintegral_congr fun x => ?_) (hA2 (k 2) J (f 2))
    rw [hQ, ← ENNReal.rpow_mul]; congr 1; ring
  -- Hölder in `x`
  have hH1 := ENNReal.lintegral_Lp_mul_le_Lq_mul_Lr (p := q / 3) (q := q) (r := q / 2)
    (by positivity) (by linarith) (by field_simp; norm_num) volume hAm.aemeasurable
    (hPm.mul hQm).aemeasurable
  have hH2 := ENNReal.lintegral_Lp_mul_le_Lq_mul_Lr (p := q / 2) (q := q) (r := q)
    (by positivity) (by linarith) (by field_simp; norm_num) volume hPm.aemeasurable hQm.aemeasurable
  have hr0 : 0 < q / 3 := by positivity
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hr0) ENNReal.ofReal_ne_top
    (by fun_prop),
    ENNReal.toReal_ofReal hr0.le]
  set N : Fin 3 → ℝ≥0∞ := fun n => eLpNorm (f n) (ENNReal.ofReal q) volume with hN
  have hNint : ∀ n, (∫⁻ x, ENNReal.ofReal (‖f n x‖ ^ q)) = N n ^ q := fun n =>
    lintegral_ofReal_norm_rpow_eq (f n) hq0
  calc (∫⁻ x, ‖kComp k J f x‖ₑ ^ (q / 3)) ^ (1 / (q / 3))
      ≤ (∫⁻ x, (A x * (P x * Q x)) ^ (q / 3)) ^ (1 / (q / 3)) := by
        gcongr with x; exact hpt x
    _ ≤ (∫⁻ x, A x ^ q) ^ (1 / q) * ((∫⁻ x, P x ^ q) ^ (1 / q) * (∫⁻ x, Q x ^ q) ^ (1 / q)) := by
        refine hH1.trans ?_
        gcongr
    _ ≤ (ENNReal.ofReal c ^ q * (ENNReal.ofReal A0 * N 0 ^ q)) ^ (1 / q) *
          ((ENNReal.ofReal A1 * N 1 ^ q) ^ (1 / q) * (ENNReal.ofReal A2 * N 2 ^ q) ^ (1 / q)) := by
        rw [← hNint 0, ← hNint 1, ← hNint 2]
        gcongr
    _ = ENNReal.ofReal c * ENNReal.ofReal ((A0 * A1 * A2) ^ (1 / q)) * (N 0 * (N 1 * N 2)) := by
        have hq' : (0 : ℝ) ≤ 1 / q := by positivity
        simp only [ENNReal.mul_rpow_of_nonneg _ _ hq', ← ENNReal.rpow_mul,
          mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
        rw [Real.mul_rpow (by positivity) hA20, Real.mul_rpow hA00 hA10,
          ENNReal.ofReal_mul (p := A0 ^ (1 / q) * A1 ^ (1 / q)) (by positivity),
          ENNReal.ofReal_mul (p := A0 ^ (1 / q)) (by positivity),
          ← ENNReal.ofReal_rpow_of_nonneg hA00 hq', ← ENNReal.ofReal_rpow_of_nonneg hA10 hq',
          ← ENNReal.ofReal_rpow_of_nonneg hA20 hq']
        ring
    _ ≤ ENNReal.ofReal (C0 * (A0 * A1 * A2) ^ (1 / q) * (2 : ℝ) ^ (20 * ((kMax k : ℝ) + 2) / q)) *
          ∏ n, N n := by
        rw [Fin.prod_univ_three, ← ENNReal.ofReal_mul hc0, mul_assoc (N 0)]
        refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
        rw [hc, show C0 * (A0 * A1 * A2) ^ (1 / q) * (2 : ℝ) ^ (20 * ((kMax k : ℝ) + 2) / q)
          = C0 * (2 : ℝ) ^ (20 * ((kMax k : ℝ) + 2) / q) * (A0 * A1 * A2) ^ (1 / q) by ring]
        refine mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left ?_ hC00) (by positivity)
        have hk0 : k 0 ≤ kMax k := by simp only [kMax]; omega
        have hkm : 0 ≤ kMax k := by omega
        calc (1 + (2 : ℝ) ^ (k 0 + 1)) ^ (10 / (q / 2)) ≤ ((2 : ℝ) ^ (kMax k + 2)) ^ (10 / (q /
          2)) :=
              Real.rpow_le_rpow (by positivity) (one_add_zpow_le hk0 hkm) (by positivity)
          _ = (2 : ℝ) ^ (20 * ((kMax k : ℝ) + 2) / q) := by
              rw [← Real.rpow_intCast, ← Real.rpow_mul (by norm_num)]
              congr 1; push_cast; field_simp; ring

theorem rpow_one_div_mul_self {a : ℝ≥0∞} {q : ℝ} (hq : 0 < q) (b : ℝ≥0∞) :
    (b * a ^ q) ^ (1 / q) = b ^ (1 / q) * a := by
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
    mul_one_div_cancel hq.ne', ENNReal.rpow_one]

/-- **The small-loss bound, general exponents**: for `q, q_1, q_2 > 2`,
`1/r = 1/q + 1/q_1 + 1/q_2` and `k ∈ F_H`:
`‖T^{(k)}_J(f)‖_r ≤ C 2^{20 (k^{(1)} + 2)/q} ‖f_0‖_q ‖f_1‖_{q_1} ‖f_2‖_{q_2}`, uniformly in `J`. -/
theorem smallLoss_bound' {q q1 q2 r : ℝ} (hq : 2 < q) (hq1 : 2 < q1) (hq2 : 2 < q2)
    (hr : 1 / r = 1 / q + 1 / q1 + 1 / q2) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ k : Fin 3 → ℤ, 0 < kMax k → ∀ (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)),
      eLpNorm (kComp k J f) (ENNReal.ofReal r) volume
        ≤ ENNReal.ofReal (C * (2 : ℝ) ^ (20 * ((kMax k : ℝ) + 2) / q)) *
          (eLpNorm (f 0) (ENNReal.ofReal q) volume * (eLpNorm (f 1) (ENNReal.ofReal q1) volume *
            eLpNorm (f 2) (ENNReal.ofReal q2) volume)) := by
  have hq0 : 0 < q := by linarith
  have hq10 : 0 < q1 := by linarith
  have hq20 : 0 < q2 := by linarith
  have hr0 : 0 < r := by
    have : 0 < 1 / r := by rw [hr]; positivity
    exact one_div_pos.mp this
  set r' : ℝ := 1 / (1 / q1 + 1 / q2) with hr'
  have hr'0 : 0 < r' := by positivity
  have hrr' : 1 / r = 1 / q + 1 / r' := by rw [hr, hr', one_div_one_div]; ring
  have hs : 1 < q / 2 := by linarith
  obtain ⟨C0, hC00, hC0⟩ := enorm_kComp_le hs
  obtain ⟨A0, hA00, hA0⟩ := sum_lintegral_maximal_slot_le hq
  obtain ⟨A1, hA10, hA1⟩ := lintegral_curveAvg_slot_le 1 hq1
  obtain ⟨A2, hA20, hA2⟩ := lintegral_curveAvg_slot_le 2 hq2
  refine ⟨C0 * (A0 ^ (1 / q) * (A1 ^ (1 / q1) * A2 ^ (1 / q2))), by positivity, fun k hk J f => ?_⟩
  set Sj := Finset.Icc (-(J : ℤ)) J
  set c : ℝ := C0 * (1 + (2 : ℝ) ^ (k 0 + 1)) ^ (10 / (q / 2)) with hc
  have hc0 : 0 ≤ c := by positivity
  set M : ℤ → E3 → ℝ := fun j => Twisted.coordinateDyadicBallMaximal 0
    (fun y => ((‖kDelta k f 0 j y‖ ^ (q / 2) : ℝ) : ℂ)) with hM
  have hMm : ∀ j, Measurable (M j) := fun j => Twisted.coordinateDyadicBallMaximal_measurable 0 _
    (Complex.continuous_ofReal.measurable.comp ((kDelta k f 0
      j).continuous.norm.measurable.pow_const _))
  set A : E3 → ℝ≥0∞ := fun x =>
    (∑ j ∈ Sj, (ENNReal.ofReal c * ENNReal.ofReal (M j x) ^ (1 / (q / 2))) ^ q) ^ (1 / q) with hA
  set P : E3 → ℝ≥0∞ := fun x => (∑ j ∈ Sj, curveAvg 1 j (kDelta k f 1 j) x) ^ (1 / 2 : ℝ) with hP
  set Q : E3 → ℝ≥0∞ := fun x => (∑ j ∈ Sj, curveAvg 2 j (kDelta k f 2 j) x) ^ (1 / 2 : ℝ) with hQ
  have hAm : Measurable A := (Finset.measurable_sum _ fun j _ =>
    (measurable_const.mul ((ENNReal.measurable_ofReal.comp (hMm j)).pow_const _)).pow_const
      _).pow_const _
  have hPm : Measurable P := (Finset.measurable_sum _ fun j _ =>
    measurable_curveAvg 1 j (kDelta k f 1 j).continuous.measurable).pow_const _
  have hQm : Measurable Q := (Finset.measurable_sum _ fun j _ =>
    measurable_curveAvg 2 j (kDelta k f 2 j).continuous.measurable).pow_const _
  have hpt : ∀ x, ‖kComp k J f x‖ₑ ≤ A x * (P x * Q x) := fun x => hC0 k J f x q hq0
  set N0 := eLpNorm (f 0) (ENNReal.ofReal q) volume
  set N1 := eLpNorm (f 1) (ENNReal.ofReal q1) volume
  set N2 := eLpNorm (f 2) (ENNReal.ofReal q2) volume
  -- the three integrals
  have hIA : ∫⁻ x, A x ^ q ≤ ENNReal.ofReal c ^ q * (ENNReal.ofReal A0 * N0 ^ q) := by
    have e : ∀ x, A x ^ q = ENNReal.ofReal c ^ q * ∑ j ∈ Sj, ENNReal.ofReal (M j x) ^ (2 : ℝ) := by
      intro x
      rw [hA, ← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne', ENNReal.rpow_one, Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← ENNReal.rpow_mul]
      congr 2; field_simp
    simp_rw [e]
    rw [lintegral_const_mul' _ _ (ENNReal.rpow_ne_top_of_nonneg hq0.le ENNReal.ofReal_ne_top),
      lintegral_finsetSum (f := fun j x => ENNReal.ofReal (M j x) ^ (2 : ℝ)) _
        fun j _ => (ENNReal.measurable_ofReal.comp (hMm j)).pow_const _,
      ← lintegral_ofReal_norm_rpow_eq (f 0) hq0]
    gcongr
    exact hA0 (k 0) J (f 0)
  have hIP : ∫⁻ x, P x ^ q1 ≤ ENNReal.ofReal A1 * N1 ^ q1 := by
    rw [← lintegral_ofReal_norm_rpow_eq (f 1) hq10]
    refine le_of_eq_of_le (lintegral_congr fun x => ?_) (hA1 (k 1) J (f 1))
    rw [hP, ← ENNReal.rpow_mul]; congr 1; ring
  have hIQ : ∫⁻ x, Q x ^ q2 ≤ ENNReal.ofReal A2 * N2 ^ q2 := by
    rw [← lintegral_ofReal_norm_rpow_eq (f 2) hq20]
    refine le_of_eq_of_le (lintegral_congr fun x => ?_) (hA2 (k 2) J (f 2))
    rw [hQ, ← ENNReal.rpow_mul]; congr 1; ring
  -- Hölder in `x`
  have hrq : r < q := by
    have h0 : 0 < 1 / r' := by positivity
    have h1 : 1 / q < 1 / r := by rw [hrr']; linarith
    exact (one_div_lt_one_div hq0 hr0).mp h1
  have hr'q1 : r' < q1 := by
    have h0 : 0 < 1 / q2 := by positivity
    have h1 : 1 / q1 < 1 / q1 + 1 / q2 := by linarith
    rw [hr', one_div_lt (by positivity) hq10]; exact h1
  have hH1 := ENNReal.lintegral_Lp_mul_le_Lq_mul_Lr (p := r) (q := q) (r := r')
    hr0 hrq hrr' volume hAm.aemeasurable (hPm.mul hQm).aemeasurable
  have hH2 := ENNReal.lintegral_Lp_mul_le_Lq_mul_Lr (p := r') (q := q1) (r := q2)
    hr'0 hr'q1 (by rw [hr', one_div_one_div]) volume hPm.aemeasurable hQm.aemeasurable
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hr0) ENNReal.ofReal_ne_top
    (by fun_prop),
    ENNReal.toReal_ofReal hr0.le]
  calc (∫⁻ x, ‖kComp k J f x‖ₑ ^ r) ^ (1 / r)
      ≤ (∫⁻ x, (A x * (P x * Q x)) ^ r) ^ (1 / r) := by
        gcongr with x; exact hpt x
    _ ≤ (∫⁻ x, A x ^ q) ^ (1 / q) * ((∫⁻ x, P x ^ q1) ^ (1 / q1) * (∫⁻ x, Q x ^ q2) ^ (1 / q2)) :=
      by
        refine hH1.trans ?_
        gcongr
    _ ≤ (ENNReal.ofReal c ^ q * (ENNReal.ofReal A0 * N0 ^ q)) ^ (1 / q) *
          ((ENNReal.ofReal A1 * N1 ^ q1) ^ (1 / q1) * (ENNReal.ofReal A2 * N2 ^ q2) ^ (1 / q2)) :=
            by
        gcongr
    _ = ENNReal.ofReal c * (ENNReal.ofReal (A0 ^ (1 / q)) *
          (ENNReal.ofReal (A1 ^ (1 / q1)) * ENNReal.ofReal (A2 ^ (1 / q2)))) * (N0 * (N1 * N2)) :=
            by
        have e0 : (ENNReal.ofReal c ^ q * (ENNReal.ofReal A0 * N0 ^ q)) ^ (1 / q)
            = ENNReal.ofReal c * (ENNReal.ofReal A0 ^ (1 / q) * N0) := by
          rw [← mul_assoc, rpow_one_div_mul_self hq0, ENNReal.mul_rpow_of_nonneg _ _
            (by positivity),
            ← ENNReal.rpow_mul, mul_one_div_cancel hq0.ne', ENNReal.rpow_one, mul_assoc]
        rw [e0, rpow_one_div_mul_self hq10, rpow_one_div_mul_self hq20,
          ENNReal.ofReal_rpow_of_nonneg hA00 (by positivity),
          ENNReal.ofReal_rpow_of_nonneg hA10 (by positivity),
          ENNReal.ofReal_rpow_of_nonneg hA20 (by positivity)]
        ring
    _ ≤ ENNReal.ofReal (C0 * (A0 ^ (1 / q) * (A1 ^ (1 / q1) * A2 ^ (1 / q2))) *
          (2 : ℝ) ^ (20 * ((kMax k : ℝ) + 2) / q)) * (N0 * (N1 * N2)) := by
        rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_mul (by positivity)]
        refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
        rw [hc, show C0 * (A0 ^ (1 / q) * (A1 ^ (1 / q1) * A2 ^ (1 / q2))) *
            (2 : ℝ) ^ (20 * ((kMax k : ℝ) + 2) / q)
          = C0 * (2 : ℝ) ^ (20 * ((kMax k : ℝ) + 2) / q) *
            (A0 ^ (1 / q) * (A1 ^ (1 / q1) * A2 ^ (1 / q2))) by ring]
        refine mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left ?_ hC00) (by positivity)
        have hk0 : k 0 ≤ kMax k := by simp only [kMax]; omega
        have hkm : 0 ≤ kMax k := by omega
        calc (1 + (2 : ℝ) ^ (k 0 + 1)) ^ (10 / (q / 2)) ≤ ((2 : ℝ) ^ (kMax k + 2)) ^ (10 / (q /
          2)) :=
              Real.rpow_le_rpow (by positivity) (one_add_zpow_le hk0 hkm) (by positivity)
          _ = (2 : ℝ) ^ (20 * ((kMax k : ℝ) + 2) / q) := by
              rw [← Real.rpow_intCast, ← Real.rpow_mul (by norm_num)]
              congr 1; push_cast; field_simp; ring

/-! ### Slot-0 extension of `T^{(k)}_J` to general inputs (for interpolation, line 456) -/

/-- Jensen: `(∫ w F)^r ≤ (∫ w)^{r-1} ∫ w F^r`, `r ≥ 1`. -/
theorem lintegral_mul_rpow_le {β : Type*} [MeasurableSpace β] (ν : Measure β) {w F : β → ℝ≥0∞}
    (hw : Measurable w) (hF : Measurable F) {r : ℝ} (hr : 1 ≤ r) :
    (∫⁻ t, w t * F t ∂ν) ^ r ≤ (∫⁻ t, w t ∂ν) ^ (r - 1) * ∫⁻ t, w t * F t ^ r ∂ν := by
  rcases hr.eq_or_lt with h | h
  · subst h; simp
  set r' := r.conjExponent
  have hhol : r'.HolderConjugate r := (Real.HolderConjugate.conjExponent h).symm
  have hr0 : 0 < r := by linarith
  have hr'0 : 0 < r' := hhol.pos
  have hH := ENNReal.lintegral_mul_le_Lp_mul_Lq ν hhol (f := fun t => w t ^ (1 / r'))
    (g := fun t => w t ^ (1 / r) * F t) (hw.pow_const _).aemeasurable
    ((hw.pow_const _).mul hF).aemeasurable
  have e1 : ∀ t, w t * F t = w t ^ (1 / r') * (w t ^ (1 / r) * F t) := by
    intro t
    have hsum : 1 / r' + 1 / r = 1 := by rw [one_div, one_div]; exact hhol.inv_add_inv_eq_one
    rw [← mul_assoc, ← ENNReal.rpow_add_of_nonneg _ _ (by positivity) (by positivity), hsum,
      ENNReal.rpow_one]
  have e2 : ∀ t, (w t ^ (1 / r')) ^ r' = w t := fun t => by
    rw [← ENNReal.rpow_mul, one_div_mul_cancel hr'0.ne', ENNReal.rpow_one]
  have e3 : ∀ t, (w t ^ (1 / r) * F t) ^ r = w t * F t ^ r := fun t => by
    rw [ENNReal.mul_rpow_of_nonneg _ _ hr0.le, ← ENNReal.rpow_mul, one_div_mul_cancel hr0.ne',
      ENNReal.rpow_one]
  simp only [Pi.mul_apply, e2, e3] at hH
  simp_rw [e1]
  calc (∫⁻ t, w t ^ (1 / r') * (w t ^ (1 / r) * F t) ∂ν) ^ r
      ≤ ((∫⁻ t, w t ∂ν) ^ (1 / r') * (∫⁻ t, w t * F t ^ r ∂ν) ^ (1 / r)) ^ r :=
        ENNReal.rpow_le_rpow hH hr0.le
    _ = (∫⁻ t, w t ∂ν) ^ (r - 1) * ∫⁻ t, w t * F t ^ r ∂ν := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hr0.le, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
          one_div_mul_cancel hr0.ne', ENNReal.rpow_one]
        congr 2
        have h1 : 1 / r' = 1 - 1 / r := by
          have := hhol.inv_add_inv_eq_one; rw [one_div, one_div]; linarith
        rw [h1]; field_simp

/-- **Minkowski's integral inequality** in the form used here (Jensen and Tonelli):
`∫_x (∫_t w(t) F(x,t) dt)^r dx ≤ (∫ w)^{r-1} ∫_t w(t) ∫_x F(x,t)^r dx dt`, `r ≥ 1`. -/
theorem lintegral_rpow_lintegral_le {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]
    (μ : Measure α) (ν : Measure β) [SFinite μ] [SFinite ν] {w : β → ℝ≥0∞} (hw : Measurable w)
    {F : α → β → ℝ≥0∞} (hF : Measurable (Function.uncurry F)) {r : ℝ} (hr : 1 ≤ r) :
    ∫⁻ x, (∫⁻ t, w t * F x t ∂ν) ^ r ∂μ
      ≤ (∫⁻ t, w t ∂ν) ^ (r - 1) * ∫⁻ t, w t * ∫⁻ x, F x t ^ r ∂μ ∂ν := by
  have hr0 : 0 < r := by linarith
  have hFx : ∀ x, Measurable (F x) := fun x => hF.comp measurable_prodMk_left
  calc ∫⁻ x, (∫⁻ t, w t * F x t ∂ν) ^ r ∂μ
      ≤ ∫⁻ x, (∫⁻ t, w t ∂ν) ^ (r - 1) * ∫⁻ t, w t * F x t ^ r ∂ν ∂μ :=
        lintegral_mono fun x => lintegral_mul_rpow_le ν hw (hFx x) hr
    _ = (∫⁻ t, w t ∂ν) ^ (r - 1) * ∫⁻ x, ∫⁻ t, w t * F x t ^ r ∂ν ∂μ := by
        rw [lintegral_const_mul]
        exact (hw.comp measurable_snd |>.mul (hF.pow_const r)).lintegral_prod_right'
    _ = (∫⁻ t, w t ∂ν) ^ (r - 1) * ∫⁻ t, ∫⁻ x, w t * F x t ^ r ∂μ ∂ν := by
        rw [lintegral_lintegral_swap ((hw.comp measurable_snd).mul (hF.pow_const r)).aemeasurable]
    _ = _ := by
        congr 1
        refine lintegral_congr fun t => ?_
        exact lintegral_const_mul (w t) (f := fun x => F x t ^ r)
          ((hF.comp (measurable_id.prodMk measurable_const)).pow_const r)

/-- `Δ^{(ℓ)}_m` on general inputs, as the line convolution `∫ ψ̌_m(u) g(y - u e_ℓ) du`. -/
def lineDelta (ℓ : Fin 3) (m : ℤ) (g : E3 → ℂ) (y : E3) : ℂ :=
  ∫ u : ℝ, (psiCM m).check u * g (y - u • basisVec ℓ)

theorem lineDelta_schwartz (ℓ : Fin 3) (m : ℤ) (g : 𝓢(E3, ℂ)) :
    lineDelta ℓ m g = lpDelta ℓ m g := by
  funext y; rw [lineDelta, ← psiCM_op, CoordMult.op_eq_lineConv]

theorem measurable_lineShift (ℓ : Fin 3) : Measurable fun p : E3 × ℝ => p.1 - p.2 • basisVec ℓ :=
  measurable_fst.sub (measurable_snd.smul_const _)

@[fun_prop] theorem measurable_lineDelta (ℓ : Fin 3) (m : ℤ) {g : E3 → ℂ} (hg : Measurable g) :
    Measurable (lineDelta ℓ m g) := by
  have h : StronglyMeasurable (Function.uncurry fun (y : E3) (u : ℝ) =>
      (psiCM m).check u * g (y - u • basisVec ℓ)) :=
    (((psiCM m).check.continuous.measurable.comp measurable_snd).mul
      (hg.comp (measurable_lineShift ℓ))).stronglyMeasurable
  exact h.integral_prod_right'.measurable

theorem enorm_lineDelta_le (ℓ : Fin 3) (m : ℤ) (g : E3 → ℂ) (y : E3) :
    ‖lineDelta ℓ m g y‖ₑ ≤ ∫⁻ u, ‖(psiCM m).check u‖ₑ * ‖g (y - u • basisVec ℓ)‖ₑ := by
  refine (enorm_integral_le_lintegral_enorm _).trans (le_of_eq ?_)
  refine lintegral_congr fun u => ?_
  rw [enorm_mul]

/-- **Young's inequality** for the line convolution: `‖Δ^{(ℓ)}_m g‖_P ≤ ‖ψ̌_m‖_1 ‖g‖_P`, `P ≥ 1`. -/
theorem eLpNorm_lineDelta_le (ℓ : Fin 3) (m : ℤ) {g : E3 → ℂ} (hg : Measurable g) {P : ℝ}
    (hP : 1 ≤ P) :
    eLpNorm (lineDelta ℓ m g) (ENNReal.ofReal P) volume
      ≤ (∫⁻ u, ‖(psiCM m).check u‖ₑ) * eLpNorm g (ENNReal.ofReal P) volume := by
  have hP0 : 0 < P := by linarith
  set W := ∫⁻ u, ‖(psiCM m).check u‖ₑ with hW
  have hwm : Measurable fun u : ℝ => ‖(psiCM m).check u‖ₑ := (psiCM
    m).check.continuous.measurable.enorm
  have hF : Measurable (Function.uncurry fun (y : E3) (u : ℝ) => ‖g (y - u • basisVec ℓ)‖ₑ) :=
    (hg.comp (measurable_lineShift ℓ)).enorm
  have hMJ := lintegral_rpow_lintegral_le volume volume hwm hF hP
  have htr : ∀ u : ℝ, ∫⁻ y, ‖g (y - u • basisVec ℓ)‖ₑ ^ P = ∫⁻ y, ‖g y‖ₑ ^ P := fun u =>
    lintegral_sub_right_eq_self (fun y => ‖g y‖ₑ ^ P) (u • basisVec ℓ)
  simp only [htr] at hMJ
  rw [lintegral_mul_const _ hwm] at hMJ
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hP0) ENNReal.ofReal_ne_top
    (by fun_prop),
    eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hP0) ENNReal.ofReal_ne_top (by fun_prop),
    ENNReal.toReal_ofReal hP0.le]
  calc (∫⁻ y, ‖lineDelta ℓ m g y‖ₑ ^ P) ^ (1 / P)
      ≤ (∫⁻ y, (∫⁻ u, ‖(psiCM m).check u‖ₑ * ‖g (y - u • basisVec ℓ)‖ₑ) ^ P) ^ (1 / P) := by
        gcongr with y; exact enorm_lineDelta_le ℓ m g y
    _ ≤ (W ^ (P - 1) * (W * ∫⁻ y, ‖g y‖ₑ ^ P)) ^ (1 / P) := by gcongr
    _ = W * (∫⁻ y, ‖g y‖ₑ ^ P) ^ (1 / P) := by
        have eW : W ^ (P - 1) * W = W ^ P := by
          rw [show W ^ (P - 1) * W = W ^ (P - 1) * W ^ (1 : ℝ) by rw [ENNReal.rpow_one],
            ← ENNReal.rpow_add_of_nonneg _ _ (by linarith) zero_le_one, show P - 1 + 1 = P by ring]
        rw [← mul_assoc, eW, ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
          ← ENNReal.rpow_mul, mul_one_div_cancel hP0.ne', ENNReal.rpow_one]

/-- Three-factor Hölder for `lintegral`s. -/
theorem lintegral_mul3_rpow_le {α : Type*} [MeasurableSpace α] (μ : Measure α) {f g h : α → ℝ≥0∞}
    (hf : AEMeasurable f μ) (hg : AEMeasurable g μ) (hh : AEMeasurable h μ) {r P0 P1 P2 : ℝ}
    (hP0 : 0 < P0) (hP1 : 0 < P1) (hP2 : 0 < P2) (hr : 1 / r = 1 / P0 + 1 / P1 + 1 / P2) :
    (∫⁻ x, (f x * (g x * h x)) ^ r ∂μ) ^ (1 / r)
      ≤ (∫⁻ x, f x ^ P0 ∂μ) ^ (1 / P0) * ((∫⁻ x, g x ^ P1 ∂μ) ^ (1 / P1) *
          (∫⁻ x, h x ^ P2 ∂μ) ^ (1 / P2)) := by
  have hr0 : 0 < r := by
    have : 0 < 1 / r := by rw [hr]; positivity
    exact one_div_pos.mp this
  set r' : ℝ := 1 / (1 / P1 + 1 / P2) with hr'
  have hr'0 : 0 < r' := by positivity
  have hrr' : 1 / r = 1 / P0 + 1 / r' := by rw [hr, hr', one_div_one_div]; ring
  have hrq : r < P0 := by
    have h0 : 0 < 1 / r' := by positivity
    have h1 : 1 / P0 < 1 / r := by rw [hrr']; linarith
    exact (one_div_lt_one_div hP0 hr0).mp h1
  have hr'q1 : r' < P1 := by
    have h0 : 0 < 1 / P2 := by positivity
    have h1 : 1 / P1 < 1 / P1 + 1 / P2 := by linarith
    rw [hr', one_div_lt (by positivity) hP1]; exact h1
  have hH1 := ENNReal.lintegral_Lp_mul_le_Lq_mul_Lr (p := r) (q := P0) (r := r')
    hr0 hrq hrr' μ hf (hg.mul hh)
  have hH2 := ENNReal.lintegral_Lp_mul_le_Lq_mul_Lr (p := r') (q := P1) (r := P2)
    hr'0 hr'q1 (by rw [hr', one_div_one_div]) μ hg hh
  exact hH1.trans (by gcongr)

theorem measurable_wJ_prod {h : Fin 3 → E3 → ℂ} (hh : ∀ n, Measurable (h n)) :
    Measurable (Function.uncurry fun (x : E3) (t : ℝ) =>
      ‖h 0 (x + curve 0 t)‖ₑ * (‖h 1 (x + curve 1 t)‖ₑ * ‖h 2 (x + curve 2 t)‖ₑ)) := by
  have hc : ∀ n, Measurable fun p : E3 × ℝ => p.1 + curve n p.2 := fun n =>
    measurable_fst.add ((continuous_curve n).measurable.comp measurable_snd)
  exact ((hh 0).comp (hc 0)).enorm.mul (((hh 1).comp (hc 1)).enorm.mul ((hh 2).comp (hc 2)).enorm)

/-- **The crude bound for `T_j`** (Minkowski and Hölder): for `1/r = ∑ 1/P_n`, `r ≥ 1`,
`‖T_j(h)‖_r ≤ ‖ψ(2^j ·)/·‖_1 ∏ ‖h_n‖_{P_n}`. -/
@[fun_prop] theorem measurable_simplexTj (j : ℤ) {h : Fin 3 → E3 → ℂ} (hh : ∀ n, Measurable (h n)) :
    Measurable (simplexTj j h) := by
  have hc : ∀ n, Measurable fun p : E3 × ℝ => p.1 + curve n p.2 := fun n =>
    measurable_fst.add ((continuous_curve n).measurable.comp measurable_snd)
  have hjoint : StronglyMeasurable (Function.uncurry fun (x : E3) (t : ℝ) =>
      (lpPsi ((2 : ℝ) ^ j * t) : ℂ) * prodShift h x t / t) := by
    refine Measurable.stronglyMeasurable ?_
    refine ((Complex.continuous_ofReal.comp (continuous_lpPsi.comp
      (continuous_const.mul continuous_id))).measurable.comp measurable_snd |>.mul ?_).div
      (Complex.measurable_ofReal.comp measurable_snd)
    unfold prodShift
    exact Finset.measurable_prod _ fun n _ => (hh n).comp (hc n)
  exact hjoint.integral_prod_right'.measurable

theorem eLpNorm_simplexTj_le (j : ℤ) {h : Fin 3 → E3 → ℂ} (hh : ∀ n, Measurable (h n))
    {r : ℝ} (hr1 : 1 ≤ r) {P : Fin 3 → ℝ} (hP : ∀ n, 0 < P n)
    (hsum : 1 / r = 1 / P 0 + 1 / P 1 + 1 / P 2) :
    eLpNorm (simplexTj j h) (ENNReal.ofReal r) volume
      ≤ (∫⁻ t, wJ j t) * (eLpNorm (h 0) (ENNReal.ofReal (P 0)) volume *
          (eLpNorm (h 1) (ENNReal.ofReal (P 1)) volume * eLpNorm (h 2) (ENNReal.ofReal (P 2))
            volume)) := by
  have hr0 : 0 < r := by linarith
  set W := ∫⁻ t, wJ j t with hW
  set F : E3 → ℝ → ℝ≥0∞ := fun x t =>
    ‖h 0 (x + curve 0 t)‖ₑ * (‖h 1 (x + curve 1 t)‖ₑ * ‖h 2 (x + curve 2 t)‖ₑ) with hFdef
  have hF : Measurable (Function.uncurry F) := measurable_wJ_prod hh
  have hpt : ∀ x, ‖simplexTj j h x‖ₑ ≤ ∫⁻ t, wJ j t * F x t := by
    intro x
    refine (enorm_integral_le_lintegral_enorm _).trans (le_of_eq (lintegral_congr fun t => ?_))
    rw [mul_div_right_comm, enorm_mul, prodShift, Fin.prod_univ_three, enorm_mul, enorm_mul,
      mul_assoc]; rfl
  have hMJ := lintegral_rpow_lintegral_le volume volume (measurable_wJ j) hF hr1
  set N : Fin 3 → ℝ≥0∞ := fun n => (∫⁻ y, ‖h n y‖ₑ ^ P n) ^ (1 / P n) with hN
  have hFt : ∀ t, ∫⁻ x, F x t ^ r ≤ (N 0 * (N 1 * N 2)) ^ r := by
    intro t
    have hc : ∀ n, ∫⁻ x, ‖h n (x + curve n t)‖ₑ ^ P n = ∫⁻ y, ‖h n y‖ₑ ^ P n := fun n =>
      lintegral_add_right_eq_self (fun y => ‖h n y‖ₑ ^ P n) (curve n t)
    have h3 := lintegral_mul3_rpow_le volume (f := fun x => ‖h 0 (x + curve 0 t)‖ₑ)
      (g := fun x => ‖h 1 (x + curve 1 t)‖ₑ) (h := fun x => ‖h 2 (x + curve 2 t)‖ₑ)
      (((hh 0).comp (measurable_id.add_const (curve 0 t))).enorm.aemeasurable)
      (((hh 1).comp (measurable_id.add_const (curve 1 t))).enorm.aemeasurable)
      (((hh 2).comp (measurable_id.add_const (curve 2 t))).enorm.aemeasurable)
      (hP 0) (hP 1) (hP 2) hsum
    rw [hc 0, hc 1, hc 2] at h3
    have h4 := ENNReal.rpow_le_rpow h3 hr0.le
    rwa [← ENNReal.rpow_mul, one_div_mul_cancel hr0.ne', ENNReal.rpow_one] at h4
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hr0) ENNReal.ofReal_ne_top
    (by fun_prop),
    ENNReal.toReal_ofReal hr0.le]
  have hNe : ∀ n, eLpNorm (h n) (ENNReal.ofReal (P n)) volume = N n := fun n => by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hP n) ENNReal.ofReal_ne_top
      (by fun_prop),
      ENNReal.toReal_ofReal (hP n).le]
  rw [hNe 0, hNe 1, hNe 2]
  calc (∫⁻ x, ‖simplexTj j h x‖ₑ ^ r) ^ (1 / r)
      ≤ (∫⁻ x, (∫⁻ t, wJ j t * F x t) ^ r) ^ (1 / r) := by gcongr with x; exact hpt x
    _ ≤ (W ^ (r - 1) * ∫⁻ t, wJ j t * (N 0 * (N 1 * N 2)) ^ r) ^ (1 / r) := by
        gcongr
        refine hMJ.trans ?_
        gcongr with t
        exact hFt t
    _ = W * (N 0 * (N 1 * N 2)) := by
        have eW : W ^ (r - 1) * W = W ^ r := by
          rw [show W ^ (r - 1) * W = W ^ (r - 1) * W ^ (1 : ℝ) by rw [ENNReal.rpow_one],
            ← ENNReal.rpow_add_of_nonneg _ _ (by linarith) zero_le_one, show r - 1 + 1 = r by ring]
        rw [lintegral_mul_const _ (measurable_wJ j), ← mul_assoc, eW,
          ← ENNReal.mul_rpow_of_nonneg _ _ hr0.le,
          ← ENNReal.rpow_mul, mul_one_div_cancel hr0.ne', ENNReal.rpow_one]

/-- `T^{(k)}_J` with a general function `g` in slot `0` and the Schwartz inputs `f_1, f_2`. -/
def kComp0 (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) (g : E3 → ℂ) (x : E3) : ℂ :=
  ∑ j ∈ Finset.Icc (-(J : ℤ)) J,
    simplexTj j ![lineDelta 0 ((expo 0 : ℤ) * j + k 0) g, ⇑(kDelta k f 1 j), ⇑(kDelta k f 2 j)] x

theorem kComp0_schwartz (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) (φ : 𝓢(E3, ℂ)) :
    kComp0 k J f φ = kComp k J (Function.update f 0 φ) := by
  funext x
  unfold kComp0 kComp
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [freqPiece_eq_kDelta]
  congr 1
  funext n
  fin_cases n
  · simp [kDelta, lineDelta_schwartz]
  · simp [kDelta]
  · simp [kDelta]

theorem kComp0_self (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) :
    kComp0 k J f (f 0) = kComp k J f := by
  rw [kComp0_schwartz, Function.update_eq_self]


theorem measurable_kComp0 (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) {g : E3 → ℂ}
    (hg : Measurable g) : Measurable (kComp0 k J f g) := by
  unfold kComp0
  refine Finset.measurable_sum _ fun j _ => measurable_simplexTj j fun n => ?_
  fin_cases n
  · exact measurable_lineDelta 0 _ hg
  · exact (kDelta k f 1 j).continuous.measurable
  · exact (kDelta k f 2 j).continuous.measurable

theorem integrable_lineDelta_integrand (ℓ : Fin 3) (m : ℤ) {g : E3 → ℂ} (hg : Measurable g)
    {B : ℝ} (hB : ∀ y, ‖g y‖ ≤ B) (y : E3) :
    Integrable fun u : ℝ => (psiCM m).check u * g (y - u • basisVec ℓ) := by
  refine ((psiCM m).check.integrable.norm.mul_const B).mono' ?_ (Eventually.of_forall fun u => ?_)
  · exact ((psiCM m).check.continuous.aestronglyMeasurable).mul
      (hg.comp (measurable_const.sub (measurable_id.smul_const _))).aestronglyMeasurable
  · rw [norm_mul]; exact mul_le_mul_of_nonneg_left (hB _) (norm_nonneg _)

theorem norm_lineDelta_le (ℓ : Fin 3) (m : ℤ) {g : E3 → ℂ} {B : ℝ} (hB : ∀ y, ‖g y‖ ≤ B) (y : E3) :
    ‖lineDelta ℓ m g y‖ ≤ (∫ u, ‖(psiCM m).check u‖) * B := by
  unfold lineDelta
  refine (norm_integral_le_integral_norm _).trans ?_
  rw [← integral_mul_const]
  refine integral_mono_of_nonneg (Eventually.of_forall fun u => norm_nonneg _)
    ((psiCM m).check.integrable.norm.mul_const B) (Eventually.of_forall fun u => ?_)
  simp only [norm_mul]
  exact mul_le_mul_of_nonneg_left (hB _) (norm_nonneg _)

theorem lineDelta_add (ℓ : Fin 3) (m : ℤ) {g₁ g₂ : E3 → ℂ} (h₁ : Measurable g₁) (h₂ : Measurable g₂)
    {B₁ B₂ : ℝ} (hB₁ : ∀ y, ‖g₁ y‖ ≤ B₁) (hB₂ : ∀ y, ‖g₂ y‖ ≤ B₂) :
    lineDelta ℓ m (g₁ + g₂) = lineDelta ℓ m g₁ + lineDelta ℓ m g₂ := by
  funext y
  simp only [lineDelta, Pi.add_apply, mul_add]
  exact integral_add (integrable_lineDelta_integrand ℓ m h₁ hB₁ y)
    (integrable_lineDelta_integrand ℓ m h₂ hB₂ y)

theorem lineDelta_smul (ℓ : Fin 3) (m : ℤ) (c : ℂ) (g : E3 → ℂ) :
    lineDelta ℓ m (c • g) = c • lineDelta ℓ m g := by
  funext y
  simp only [lineDelta, Pi.smul_apply, smul_eq_mul, ← integral_const_mul]
  congr 1; funext u; ring

theorem integrable_simplexTj_integrand (j : ℤ) {h : Fin 3 → E3 → ℂ} (hh : ∀ n, Measurable (h n))
    {B : ℝ} (hB : ∀ n y, ‖h n y‖ ≤ B) (x : E3) :
    Integrable fun t : ℝ => (lpPsi ((2 : ℝ) ^ j * t) : ℂ) * prodShift h x t / t := by
  refine ((integrable_psi_div j).norm.mul_const (B ^ 3)).mono' ?_ (Eventually.of_forall fun t => ?_)
  · have hps : Measurable fun t : ℝ => prodShift h x t := by
      unfold prodShift
      exact Finset.measurable_prod _ fun n _ => (hh n).comp
        (measurable_const.add (continuous_curve n).measurable)
    exact (((Complex.continuous_ofReal.comp (continuous_lpPsi.comp
      (continuous_const.mul continuous_id))).measurable.mul hps).div
      Complex.measurable_ofReal).aestronglyMeasurable
  · rw [mul_div_right_comm, norm_mul]
    exact mul_le_mul_of_nonneg_left (norm_prodShift_le hB x t) (norm_nonneg _)

theorem simplexTj_add0 (j : ℤ) {a₁ a₂ b c : E3 → ℂ} (h₁ : Measurable a₁) (h₂ : Measurable a₂)
    (hb : Measurable b) (hc : Measurable c) {B : ℝ}
    (hB₁ : ∀ y, ‖a₁ y‖ ≤ B) (hB₂ : ∀ y, ‖a₂ y‖ ≤ B) (hBb : ∀ y, ‖b y‖ ≤ B) (hBc : ∀ y, ‖c y‖ ≤ B)
    (x : E3) :
    simplexTj j ![a₁ + a₂, b, c] x = simplexTj j ![a₁, b, c] x + simplexTj j ![a₂, b, c] x := by
  have hm : ∀ a : E3 → ℂ, Measurable a → ∀ n, Measurable (![a, b, c] n) := fun a ha n => by
    fin_cases n
    exacts [ha, hb, hc]
  have hBd : ∀ a : E3 → ℂ, (∀ y, ‖a y‖ ≤ B) → ∀ n y, ‖(![a, b, c] n) y‖ ≤ B := fun a ha n y => by
    fin_cases n
    exacts [ha y, hBb y, hBc y]
  unfold simplexTj
  rw [← integral_add (integrable_simplexTj_integrand j (hm a₁ h₁) (hBd a₁ hB₁) x)
    (integrable_simplexTj_integrand j (hm a₂ h₂) (hBd a₂ hB₂) x)]
  congr 1; funext t
  simp only [prodShift, Fin.prod_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, Pi.add_apply]
  ring

theorem simplexTj_smul0 (j : ℤ) (s : ℂ) (a b c : E3 → ℂ) (x : E3) :
    simplexTj j ![s • a, b, c] x = s * simplexTj j ![a, b, c] x := by
  unfold simplexTj
  rw [← integral_const_mul]
  congr 1; funext t
  simp only [prodShift, Fin.prod_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, Pi.smul_apply, smul_eq_mul]
  ring

theorem kComp0_add (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) {g₁ g₂ : E3 → ℂ}
    (h₁ : Measurable g₁) (h₂ : Measurable g₂) {B₁ B₂ : ℝ} (hB₁ : ∀ y, ‖g₁ y‖ ≤ B₁)
    (hB₂ : ∀ y, ‖g₂ y‖ ≤ B₂) :
    kComp0 k J f (g₁ + g₂) = kComp0 k J f g₁ + kComp0 k J f g₂ := by
  funext x
  simp only [kComp0, Pi.add_apply, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  set m := (expo 0 : ℤ) * j + k 0
  obtain ⟨Bb, hBb0, hBb⟩ := exists_bound_schwartz (kDelta k f 1 j)
  obtain ⟨Bc, hBc0, hBc⟩ := exists_bound_schwartz (kDelta k f 2 j)
  set K := ∫ u, ‖(psiCM m).check u‖
  have hK0 : 0 ≤ K := integral_nonneg fun u => norm_nonneg _
  set B := max (max (K * B₁) (K * B₂)) (max Bb Bc)
  rw [lineDelta_add 0 m h₁ h₂ hB₁ hB₂]
  exact simplexTj_add0 j (measurable_lineDelta 0 m h₁) (measurable_lineDelta 0 m h₂)
    (kDelta k f 1 j).continuous.measurable (kDelta k f 2 j).continuous.measurable
    (B := B) (fun y => (norm_lineDelta_le 0 m hB₁ y).trans ((le_max_left _ _).trans (le_max_left _
      _)))
    (fun y => (norm_lineDelta_le 0 m hB₂ y).trans ((le_max_right _ _).trans (le_max_left _ _)))
    (fun y => (hBb y).trans ((le_max_left _ _).trans (le_max_right _ _)))
    (fun y => (hBc y).trans ((le_max_right _ _).trans (le_max_right _ _))) x

theorem kComp0_smul (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) (s : ℂ) (g : E3 → ℂ) :
    kComp0 k J f (s • g) = s • kComp0 k J f g := by
  funext x
  simp only [kComp0, Pi.smul_apply, smul_eq_mul, Finset.mul_sum, lineDelta_smul, simplexTj_smul0]

theorem lintegral_wJ_ne_top (j : ℤ) : ∫⁻ t, wJ j t ≠ ⊤ :=
  (integrable_psi_div j).2.ne

/-- **The crude bound for `T^{(k)}_J` in slot `0`** (fixed `J`, `f_1`, `f_2`): used only for the
density arguments. -/
theorem kComp0_crude (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) {r P0 P1 P2 : ℝ}
    (hr1 : 1 ≤ r) (hP0 : 1 ≤ P0) (hP1 : 0 < P1) (hP2 : 0 < P2)
    (hsum : 1 / r = 1 / P0 + 1 / P1 + 1 / P2) :
    ∃ C : ℝ≥0∞, C ≠ ⊤ ∧ ∀ g : E3 → ℂ, Measurable g →
      eLpNorm (kComp0 k J f g) (ENNReal.ofReal r) volume
        ≤ C * eLpNorm g (ENNReal.ofReal P0) volume := by
  set Sj := Finset.Icc (-(J : ℤ)) J
  set m : ℤ → ℤ := fun j => (expo 0 : ℤ) * j + k 0
  set C : ℝ≥0∞ := ∑ j ∈ Sj, (∫⁻ t, wJ j t) * ((∫⁻ u, ‖(psiCM (m j)).check u‖ₑ) *
    (eLpNorm (kDelta k f 1 j) (ENNReal.ofReal P1) volume *
      eLpNorm (kDelta k f 2 j) (ENNReal.ofReal P2) volume))
  refine ⟨C, ?_, fun g hg => ?_⟩
  · refine ENNReal.sum_ne_top.mpr fun j _ => ENNReal.mul_ne_top (lintegral_wJ_ne_top j)
      (ENNReal.mul_ne_top (psiCM (m j)).check.integrable.2.ne (ENNReal.mul_ne_top
        (eLpNorm_schwartz_ne_top _ _) (eLpNorm_schwartz_ne_top _ _)))
  have hP : ∀ n : Fin 3, 0 < ![P0, P1, P2] n := fun n => by
    fin_cases n <;> simp <;> linarith
  have hmeas : ∀ j, ∀ n, Measurable
      (![lineDelta 0 (m j) g, ⇑(kDelta k f 1 j), ⇑(kDelta k f 2 j)] n) := fun j n => by
    fin_cases n
    exacts [measurable_lineDelta 0 _ hg, (kDelta k f 1 j).continuous.measurable,
      (kDelta k f 2 j).continuous.measurable]
  have hfun : kComp0 k J f g = ∑ j ∈ Sj, simplexTj j
      ![lineDelta 0 (m j) g, ⇑(kDelta k f 1 j), ⇑(kDelta k f 2 j)] := by
    funext x; simp [kComp0, Finset.sum_apply, m, Sj]
  rw [hfun]
  refine (eLpNorm_sum_le
    (by simpa using hr1)).trans ?_
  rw [Finset.sum_mul]
  refine Finset.sum_le_sum fun j _ => ?_
  have h := eLpNorm_simplexTj_le j (hmeas j) hr1 (P := ![P0, P1, P2]) hP (by simpa using hsum)
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
    Matrix.tail_cons] at h
  set W := ∫⁻ t, wJ j t
  set K := ∫⁻ u, ‖(psiCM (m j)).check u‖ₑ
  set N1 := eLpNorm (kDelta k f 1 j) (ENNReal.ofReal P1) volume
  set N2 := eLpNorm (kDelta k f 2 j) (ENNReal.ofReal P2) volume
  set E := eLpNorm g (ENNReal.ofReal P0) volume
  calc eLpNorm (simplexTj j ![lineDelta 0 (m j) g, ⇑(kDelta k f 1 j), ⇑(kDelta k f 2 j)])
        (ENNReal.ofReal r) volume
      ≤ W * (eLpNorm (lineDelta 0 (m j) g) (ENNReal.ofReal P0) volume * (N1 * N2)) := h
    _ ≤ W * ((K * E) * (N1 * N2)) := by
        gcongr; exact eLpNorm_lineDelta_le 0 (m j) hg hP0
    _ = W * (K * (N1 * N2)) * E := by ring

/-- A function is bounded. -/
def IsBdd (g : E3 → ℂ) : Prop := ∃ B : ℝ, ∀ y, ‖g y‖ ≤ B

theorem IsBdd.sub {a b : E3 → ℂ} (ha : IsBdd a) (hb : IsBdd b) : IsBdd (a - b) := by
  obtain ⟨A, hA⟩ := ha; obtain ⟨B, hB⟩ := hb
  exact ⟨A + B, fun y => (norm_sub_le _ _).trans (add_le_add (hA y) (hB y))⟩

theorem isBdd_schwartz (φ : 𝓢(E3, ℂ)) : IsBdd φ :=
  let ⟨C, _, h⟩ := exists_bound_schwartz φ; ⟨C, h⟩

theorem isBdd_simpleFunc (s : SimpleFunc E3 ℂ) : IsBdd s := by
  refine ⟨(((s.range).sup (fun z => ‖z‖₊) : NNReal) : ℝ), fun y => ?_⟩
  have h : ‖s y‖₊ ≤ (s.range).sup (fun z => ‖z‖₊) :=
    Finset.le_sup (f := fun z => ‖z‖₊) (s.mem_range_self y)
  exact_mod_cast h

/-- **Density transfer of an `L^r` bound**: if a linear operator obeys a crude bound
`‖T a‖_r ≤ C ‖a‖_P` and the bound `‖T φ‖_r ≤ M ‖φ‖_P` on bounded measurable approximants of a
bounded `g ∈ L^P`, then `‖T g‖_r ≤ M ‖g‖_P`. -/
theorem eLpNorm_bound_transfer {T : (E3 → ℂ) → E3 → ℂ}
    (hadd : ∀ a b : E3 → ℂ, Measurable a → Measurable b → IsBdd a → IsBdd b → T (a + b) = T a + T b)
     {r P : ℝ} (hr : 1 ≤ r) (hP : 1 ≤ P)
    {C : ℝ≥0∞} (hC : C ≠ ⊤)
    (hcrude : ∀ a, Measurable a → eLpNorm (T a) (ENNReal.ofReal r) volume
      ≤ C * eLpNorm a (ENNReal.ofReal P) volume)
    {M : ℝ≥0∞} (hM : M ≠ ⊤) {g : E3 → ℂ} (hg : Measurable g) (hgB : IsBdd g)
    (happrox : ∀ ε : ℝ≥0∞, 0 < ε → ∃ φ : E3 → ℂ, Measurable φ ∧ IsBdd φ ∧
      eLpNorm (g - φ) (ENNReal.ofReal P) volume ≤ ε ∧
      eLpNorm (T φ) (ENNReal.ofReal r) volume ≤ M * eLpNorm φ (ENNReal.ofReal P) volume) :
    eLpNorm (T g) (ENNReal.ofReal r) volume ≤ M * eLpNorm g (ENNReal.ofReal P) volume := by
  have hr1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal r := by simpa using hr
  have hP1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal P := by simpa using hP
  refine ENNReal.le_of_forall_pos_le_add fun ε hε _ => ?_
  set D : ℝ≥0∞ := M + C + 1 with hD
  have hD0 : D ≠ 0 := by simp [hD]
  have hDt : D ≠ ⊤ := by simp [hD, hM, hC]
  set δ : ℝ≥0∞ := (ε : ℝ≥0∞) / D with hδ
  have hδ0 : 0 < δ := ENNReal.div_pos (by exact_mod_cast hε.ne') hDt
  obtain ⟨φ, hφm, hφB, hφε, hφM⟩ := happrox δ hδ0
  have hsplit : T g = T φ + T (g - φ) := by
    rw [← hadd φ (g - φ) hφm (hg.sub hφm) hφB (hgB.sub hφB), add_sub_cancel]
  have hφle : eLpNorm φ (ENNReal.ofReal P) volume
      ≤ eLpNorm g (ENNReal.ofReal P) volume + δ := by
    calc eLpNorm φ (ENNReal.ofReal P) volume = eLpNorm (g - (g - φ)) (ENNReal.ofReal P) volume := by
          rw [sub_sub_cancel]
      _ ≤ eLpNorm g (ENNReal.ofReal P) volume + eLpNorm (g - φ) (ENNReal.ofReal P) volume :=
          eLpNorm_sub_le hP1
      _ ≤ _ := by gcongr
  calc eLpNorm (T g) (ENNReal.ofReal r) volume
      ≤ eLpNorm (T φ) (ENNReal.ofReal r) volume + eLpNorm (T (g - φ)) (ENNReal.ofReal r) volume :=
        by
        rw [hsplit]
        exact eLpNorm_add_le hr1
    _ ≤ M * (eLpNorm g (ENNReal.ofReal P) volume + δ) + C * δ := by
        gcongr
        · exact hφM.trans (by gcongr)
        · exact (hcrude _ (hg.sub hφm)).trans (by gcongr)
    _ = M * eLpNorm g (ENNReal.ofReal P) volume + (M + C) * δ := by ring
    _ ≤ M * eLpNorm g (ENNReal.ofReal P) volume + ε := by
        gcongr
        calc (M + C) * δ ≤ D * δ := by gcongr; simp [hD]
          _ = ε := by rw [hδ, ENNReal.mul_div_cancel hD0 hDt]

theorem kComp0_add' (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) :
    ∀ a b : E3 → ℂ, Measurable a → Measurable b → IsBdd a → IsBdd b →
      kComp0 k J f (a + b) = kComp0 k J f a + kComp0 k J f b := by
  intro a b ha hb ⟨A, hA⟩ ⟨B, hB⟩
  exact kComp0_add k J f ha hb hA hB

theorem exists_real_pos_ofReal_le {δ : ℝ≥0∞} (hδ : 0 < δ) : ∃ ε : ℝ, 0 < ε ∧ ENNReal.ofReal ε ≤ δ
  := by
  refine ⟨(min δ 1).toReal, ENNReal.toReal_pos (by positivity) (by simp), ?_⟩
  rw [ENNReal.ofReal_toReal (by simp)]
  exact min_le_left _ _

/-- **Schwartz to bounded inputs**: a bound for `T^{(k)}_J` in slot `0` on Schwartz inputs passes to
bounded measurable `g ∈ L^P`. -/
theorem kComp0_bound_of_schwartz (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ))
    {r P P1 P2 : ℝ} (hr1 : 1 ≤ r) (hP : 1 ≤ P) (hP1 : 0 < P1) (hP2 : 0 < P2)
    (hsum : 1 / r = 1 / P + 1 / P1 + 1 / P2) {M : ℝ≥0∞} (hM : M ≠ ⊤)
    (hS : ∀ φ : 𝓢(E3, ℂ), eLpNorm (kComp0 k J f φ) (ENNReal.ofReal r) volume
      ≤ M * eLpNorm φ (ENNReal.ofReal P) volume)
    {g : E3 → ℂ} (hg : Measurable g) (hgB : IsBdd g) (hgP : MemLp g (ENNReal.ofReal P) volume) :
    eLpNorm (kComp0 k J f g) (ENNReal.ofReal r) volume ≤ M * eLpNorm g (ENNReal.ofReal P) volume
      := by
  obtain ⟨C, hC, hcrude⟩ := kComp0_crude k J f hr1 hP hP1 hP2 hsum
  refine eLpNorm_bound_transfer (kComp0_add' k J f)
    hr1 hP hC hcrude hM hg hgB fun δ hδ => ?_
  obtain ⟨ε, hε, hεδ⟩ := exists_real_pos_ofReal_le hδ
  obtain ⟨ψ, hψc, hψd, hψε⟩ := hgP.exist_eLpNorm_sub_le ENNReal.ofReal_ne_top (by simpa using hP) hε
  set Φ : 𝓢(E3, ℂ) := hψc.toSchwartzMap hψd
  have hΦ : (Φ : E3 → ℂ) = ψ := rfl
  refine ⟨Φ, Φ.continuous.measurable, isBdd_schwartz Φ, ?_, hS Φ⟩
  rw [hΦ]; exact hψε.trans hεδ

/-- **Simple functions to Schwartz inputs**: a bound for `T^{(k)}_J` in slot `0` on integrable
simple functions passes to Schwartz inputs. -/
theorem kComp0_bound_of_simple (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ))
    {r P P1 P2 : ℝ} (hr1 : 1 ≤ r) (hP : 1 ≤ P) (hP1 : 0 < P1) (hP2 : 0 < P2)
    (hsum : 1 / r = 1 / P + 1 / P1 + 1 / P2) {M : ℝ≥0∞} (hM : M ≠ ⊤)
    (hS : ∀ s : SimpleFunc E3 ℂ, Integrable s → eLpNorm (kComp0 k J f s) (ENNReal.ofReal r) volume
      ≤ M * eLpNorm s (ENNReal.ofReal P) volume) (φ : 𝓢(E3, ℂ)) :
    eLpNorm (kComp0 k J f φ) (ENNReal.ofReal r) volume ≤ M * eLpNorm φ (ENNReal.ofReal P) volume
      := by
  obtain ⟨C, hC, hcrude⟩ := kComp0_crude k J f hr1 hP hP1 hP2 hsum
  refine eLpNorm_bound_transfer (kComp0_add' k J f)
    hr1 hP hC hcrude hM φ.continuous.measurable (isBdd_schwartz φ) fun δ hδ => ?_
  have hP0 : ENNReal.ofReal P ≠ 0 := by simpa using (by linarith : (0 : ℝ) < P)
  obtain ⟨s, hsε, hsP⟩ := (φ.memLp (ENNReal.ofReal P) volume).exists_simpleFunc_eLpNorm_sub_lt
    ENNReal.ofReal_ne_top hδ.ne'
  have hsI : Integrable s := (SimpleFunc.memLp_iff_integrable hP0 ENNReal.ofReal_ne_top).mp hsP
  exact ⟨s, s.measurable, isBdd_simpleFunc s, hsε.le, hS s hsI⟩

/-- A Schwartz function with vanishing `L^p` norm vanishes. -/
theorem schwartz_eq_zero_of_eLpNorm (g : 𝓢(E3, ℂ)) {p : ℝ} (hp : 0 < p)
    (h : eLpNorm g (ENNReal.ofReal p) volume = 0) : (g : E3 → ℂ) = 0 := by
  rw [eLpNorm_eq_zero_iff (by simpa using hp)] at h
  exact (g.continuous.ae_eq_iff_eq volume continuous_const).mp h

/-- `T^{(k)}_J(f) = 0` as soon as one input vanishes. -/
theorem kComp_eq_zero_of (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) (n : Fin 3)
    (hn : (f n : E3 → ℂ) = 0) : kComp k J f = 0 := by
  have hf : f n = 0 := by ext y; exact congrFun hn y
  funext x
  simp only [kComp, Pi.zero_apply]
  refine Finset.sum_eq_zero fun j _ => ?_
  rw [freqPiece_eq_kDelta]
  unfold simplexTj
  have : ∀ t : ℝ, prodShift (fun m => ⇑(kDelta k f m j)) x t = 0 := by
    intro t
    unfold prodShift
    refine Finset.prod_eq_zero (Finset.mem_univ n) ?_
    simp [kDelta, hf]
  simp [this]

/-- The interpolated constant. -/
theorem interp_const_le {Cg Cv δ θ x0 ε K n : ℝ} (hCg : 0 < Cg) (hCv : 0 ≤ Cv) (hn : 0 ≤ n)
    (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1) (hx0 : x0 ≤ 1 - θ) (hK : 0 ≤ K) (hε : 0 ≤ ε) (hδ : 0 < δ)
    (hεδ : 20 * ε ≤ δ * x0 / 2) :
    (Cg * (2 : ℝ) ^ (-(δ * K)) * n) ^ (1 - θ) * ((Cv + 1) * (2 : ℝ) ^ (20 * (K + 2) * ε) * n) ^ θ
      ≤ max Cg 1 * (Cv + 1) * (2 : ℝ) ^ (40 * ε) * (2 : ℝ) ^ (-(δ * x0 / 2 * K)) * n := by
  have h1θ : 0 ≤ 1 - θ := by linarith
  have hb : (0 : ℝ) < 2 := two_pos
  rw [Real.mul_rpow (by positivity) hn, Real.mul_rpow (by positivity) hn,
    Real.mul_rpow hCg.le (by positivity), Real.mul_rpow (by positivity) (by positivity),
    ← Real.rpow_mul hb.le, ← Real.rpow_mul hb.le]
  have hnn : n ^ (1 - θ) * n ^ θ = n := by
    rcases hn.eq_or_lt with h | h
    · subst h
      rcases h1θ.eq_or_lt with h' | h'
      · rw [← h', Real.rpow_zero, one_mul, show θ = 1 by linarith, Real.rpow_one]
      · rw [Real.zero_rpow h'.ne', zero_mul]
    · rw [← Real.rpow_add h, show 1 - θ + θ = 1 by ring, Real.rpow_one]
  have hCg' : Cg ^ (1 - θ) ≤ max Cg 1 := by
    rcases le_or_gt 1 Cg with h | h
    · exact (Real.rpow_le_self_of_one_le h (by linarith)).trans (le_max_left _ _)
    · exact (Real.rpow_le_one hCg.le h.le h1θ).trans (le_max_right _ _)
  have hCv' : (Cv + 1) ^ θ ≤ Cv + 1 := Real.rpow_le_self_of_one_le (by linarith) hθ1
  have hexp : (2 : ℝ) ^ (-(δ * K) * (1 - θ)) * (2 : ℝ) ^ (20 * (K + 2) * ε * θ)
      ≤ (2 : ℝ) ^ (40 * ε) * (2 : ℝ) ^ (-(δ * x0 / 2 * K)) := by
    rw [← Real.rpow_add hb, ← Real.rpow_add hb]
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
    have h1 : δ * x0 * K ≤ δ * K * (1 - θ) := by
      have := mul_le_mul_of_nonneg_left hx0 (mul_nonneg hδ.le hK)
      nlinarith
    have h2 : 20 * (K + 2) * ε * θ ≤ 20 * (K + 2) * ε := by
      have : 0 ≤ 20 * (K + 2) * ε := by positivity
      nlinarith
    nlinarith
  calc Cg ^ (1 - θ) * (2 : ℝ) ^ (-(δ * K) * (1 - θ)) * n ^ (1 - θ) *
        ((Cv + 1) ^ θ * (2 : ℝ) ^ (20 * (K + 2) * ε * θ) * n ^ θ)
      = (Cg ^ (1 - θ) * (Cv + 1) ^ θ) *
          ((2 : ℝ) ^ (-(δ * K) * (1 - θ)) * (2 : ℝ) ^ (20 * (K + 2) * ε * θ)) *
          (n ^ (1 - θ) * n ^ θ) := by ring
    _ ≤ (max Cg 1 * (Cv + 1)) * ((2 : ℝ) ^ (40 * ε) * (2 : ℝ) ^ (-(δ * x0 / 2 * K))) * n := by
        rw [hnn]
        gcongr
    _ = _ := by ring

theorem ennreal_interp_exp {a b c θ : ℝ} (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (hθ0 : 0 ≤ θ)
    (hθ1 : θ ≤ 1) (h : 1 / c = (1 - θ) * (1 / a) + θ * (1 / b)) :
    (ENNReal.ofReal c)⁻¹ = ENNReal.ofReal (1 - θ) * (ENNReal.ofReal a)⁻¹ +
      ENNReal.ofReal θ * (ENNReal.ofReal b)⁻¹ := by
  rw [← ENNReal.ofReal_inv_of_pos ha, ← ENNReal.ofReal_inv_of_pos hb, ← ENNReal.ofReal_inv_of_pos
    hc,
    ← ENNReal.ofReal_mul (by linarith), ← ENNReal.ofReal_mul hθ0,
    ← ENNReal.ofReal_add (by positivity) (by positivity)]
  congr 1
  simpa [one_div] using h

/-- **Exponential gain for `T^{(k)}` in the range of `thm:main`** (line 456): interpolation in slot
`0` (Riesz-Thorin) between `lem:gain` and the small-loss bound. For `p > 1`, `p_1, p_2 > 2`,
`1/p_1 + 1/p_2 ≥ 1/2` and `1/p = ∑ 1/p_n`: `‖T^{(k)}_J(f)‖_p ≤ C 2^{-δ' k^{(1)}} ∏ ‖f_n‖_{p_n}`
for `k ∈ F_H`, uniformly in `J`. -/
theorem H_gain {pv : Fin 3 → ℝ} {p : ℝ} (hp : 1 < p) (hp0 : 0 < pv 0) (hp1 : 2 < pv 1)
    (hp2 : 2 < pv 2) (hsum : 1 / p = 1 / pv 0 + 1 / pv 1 + 1 / pv 2)
    (hhalf : 1 / 2 ≤ 1 / pv 1 + 1 / pv 2) :
    ∃ δ' C : ℝ, 0 < δ' ∧ 0 ≤ C ∧ ∀ k : Fin 3 → ℤ, 0 < kMax k → ∀ (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)),
      eLpNorm (kComp k J f) (ENNReal.ofReal p) volume
        ≤ ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ' * kMax k))) *
          (eLpNorm (f 0) (ENNReal.ofReal (pv 0)) volume * (eLpNorm (f 1) (ENNReal.ofReal (pv 1))
            volume *
            eLpNorm (f 2) (ENNReal.ofReal (pv 2)) volume)) := by
  set a := 1 / pv 1 + 1 / pv 2 with ha
  set x0 := 1 / pv 0 with hx0
  have hx00 : 0 < x0 := by positivity
  have ha1 : a < 1 / 2 + 1 / 2 := by
    have h1 : 1 / pv 1 < 1 / 2 := by rw [div_lt_div_iff₀ (by linarith) two_pos]; linarith
    have h2 : 1 / pv 2 < 1 / 2 := by rw [div_lt_div_iff₀ (by linarith) two_pos]; linarith
    linarith
  have hp' : 1 / p < 1 := by rw [div_lt_one (by linarith)]; exact hp
  set g0 := 1 - a with hg0
  have hg00 : 0 < g0 := by linarith
  have hg0h : g0 ≤ 1 / 2 := by linarith
  have hxg : x0 < g0 := by rw [hsum] at hp'; linarith
  set Pg := 1 / g0 with hPg
  have hPg2 : 2 ≤ Pg := by rw [hPg, le_div_iff₀ hg00]; linarith
  obtain ⟨δ, Cg, hδ, hCg, hgain⟩ := gain_one (pv := ![Pg, pv 1, pv 2])
    (fun n => by fin_cases n <;> simp <;> linarith)
    (by simp only [Fin.sum_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one,
          Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
        rw [hPg, inv_div, div_one]; simp only [hg0, ha, one_div]; ring)
  set ε := min (x0 / 2) (δ * x0 / 40) with hε
  have hε0 : 0 < ε := lt_min (by positivity) (by positivity)
  have hεx : ε ≤ x0 / 2 := min_le_left _ _
  have hεδ : 20 * ε ≤ δ * x0 / 2 := by have := min_le_right (x0 / 2) (δ * x0 / 40); linarith
  set q := 1 / ε with hq
  have hq2 : 2 < q := by rw [hq, lt_div_iff₀ hε0]; linarith
  set rv := 1 / (ε + a) with hrv
  have hrv1 : 1 < rv := by rw [hrv, lt_div_iff₀ (by positivity)]; linarith
  have hrvsum : 1 / rv = 1 / q + 1 / pv 1 + 1 / pv 2 := by
    rw [hrv, hq, one_div_one_div, one_div_one_div, ha]; ring
  obtain ⟨Cv, hCv, hloss⟩ := smallLoss_bound' hq2 hp1 hp2 hrvsum
  set θ := (g0 - x0) / (g0 - ε) with hθ
  have hgε : 0 < g0 - ε := by linarith
  have hθ0 : 0 < θ := div_pos (by linarith) hgε
  have hθ1 : θ < 1 := by rw [hθ, div_lt_one hgε]; linarith
  have h1θ : 1 - θ = (x0 - ε) / (g0 - ε) := by rw [hθ]; field_simp; ring
  have hθx : x0 ≤ 1 - θ := by
    rw [h1θ, le_div_iff₀ hgε]
    nlinarith
  have hgε' : g0 - ε ≠ 0 := hgε.ne'
  have hint0 : 1 / pv 0 = (1 - θ) * (1 / Pg) + θ * (1 / q) := by
    rw [hPg, hq, one_div_one_div, one_div_one_div, ← hx0, hθ]; field_simp; ring
  have hint1 : 1 / p = (1 - θ) * (1 / 1) + θ * (1 / rv) := by
    have e : 1 / p = x0 + a := by rw [hsum, hx0, ha]; ring
    have h' : 1 - a - ε ≠ 0 := by linarith
    rw [e, hrv, one_div_one_div, hθ, hg0]; field_simp; ring
  refine ⟨δ * x0 / 2, max Cg 1 * (Cv + 1) * (2 : ℝ) ^ (40 * ε), by positivity, by positivity,
    fun k hk J f => ?_⟩
  set K : ℝ := (kMax k : ℝ) with hK
  have hK0 : 0 ≤ K := by rw [hK]; exact_mod_cast (by omega : (0 : ℤ) ≤ kMax k)
  set N0 := eLpNorm (f 0) (ENNReal.ofReal (pv 0)) volume
  set N1 := eLpNorm (f 1) (ENNReal.ofReal (pv 1)) volume
  set N2 := eLpNorm (f 2) (ENNReal.ofReal (pv 2)) volume
  -- degenerate inputs
  by_cases hN : N1 = 0 ∨ N2 = 0
  · have hz : kComp k J f = 0 := by
      rcases hN with h | h
      · exact kComp_eq_zero_of k J f 1 (schwartz_eq_zero_of_eLpNorm (f 1) (by linarith) h)
      · exact kComp_eq_zero_of k J f 2 (schwartz_eq_zero_of_eLpNorm (f 2) (by linarith) h)
    rw [hz]; simp
  push Not at hN
  obtain ⟨hN1, hN2⟩ := hN
  set n1 := N1.toReal
  set n2 := N2.toReal
  have hn1 : 0 < n1 := ENNReal.toReal_pos hN1 (eLpNorm_schwartz_ne_top _ _)
  have hn2 : 0 < n2 := ENNReal.toReal_pos hN2 (eLpNorm_schwartz_ne_top _ _)
  have hN1e : N1 = ENNReal.ofReal n1 := (ENNReal.ofReal_toReal (eLpNorm_schwartz_ne_top _ _)).symm
  have hN2e : N2 = ENNReal.ofReal n2 := (ENNReal.ofReal_toReal (eLpNorm_schwartz_ne_top _ _)).symm
  set M₀ := Cg * (2 : ℝ) ^ (-(δ * K)) * (n1 * n2) with hM₀
  set M₁ := (Cv + 1) * (2 : ℝ) ^ (20 * (K + 2) * ε) * (n1 * n2) with hM₁
  have hM₀0 : 0 < M₀ := by positivity
  have hM₁0 : 0 < M₁ := by positivity
  -- the two vertex bounds on Schwartz inputs in slot `0`
  have hS₀ : ∀ φ : 𝓢(E3, ℂ), eLpNorm (kComp0 k J f φ) (ENNReal.ofReal 1) volume
      ≤ ENNReal.ofReal M₀ * eLpNorm φ (ENNReal.ofReal Pg) volume := by
    intro φ
    rw [kComp0_schwartz, ENNReal.ofReal_one]
    refine (hgain k hk J (Function.update f 0 φ)).trans (le_of_eq ?_)
    simp only [Fin.prod_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons, Function.update_self]
    rw [Function.update_of_ne (by decide), Function.update_of_ne (by decide)]
    change _ * (_ * N1 * N2) = _
    rw [hN1e, hN2e]
    simp only [hM₀, hK]
    rw [ENNReal.ofReal_mul (p := Cg * (2 : ℝ) ^ (-(δ * (kMax k : ℝ)))) (by positivity),
      ENNReal.ofReal_mul hn1.le]
    ring
  have hS₁ : ∀ φ : 𝓢(E3, ℂ), eLpNorm (kComp0 k J f φ) (ENNReal.ofReal rv) volume
      ≤ ENNReal.ofReal M₁ * eLpNorm φ (ENNReal.ofReal q) volume := by
    intro φ
    rw [kComp0_schwartz]
    refine (hloss k hk J (Function.update f 0 φ)).trans ?_
    simp only [Function.update_self]
    rw [Function.update_of_ne (by decide), Function.update_of_ne (by decide)]
    change _ * (_ * (N1 * N2)) ≤ _
    rw [hN1e, hN2e, hM₁, ← ENNReal.ofReal_mul hn1.le, show 20 * (K + 2) / q = 20 * (K + 2) * ε by
      rw [hq]; field_simp]
    calc ENNReal.ofReal (Cv * (2 : ℝ) ^ (20 * (K + 2) * ε)) *
          (eLpNorm φ (ENNReal.ofReal q) volume * ENNReal.ofReal (n1 * n2))
        ≤ ENNReal.ofReal ((Cv + 1) * (2 : ℝ) ^ (20 * (K + 2) * ε)) *
          (eLpNorm φ (ENNReal.ofReal q) volume * ENNReal.ofReal (n1 * n2)) := by
          gcongr; linarith
      _ = _ := by
          rw [ENNReal.ofReal_mul (p := (Cv + 1) * (2 : ℝ) ^ (20 * (K + 2) * ε)) (by positivity)]
          ring
  -- to simple functions
  have hPg1 : (1 : ℝ) ≤ Pg := by linarith
  have hpv01 : (1 : ℝ) ≤ pv 0 := by
    have : 1 / pv 0 < 1 := by rw [← hx0]; linarith
    rw [div_lt_one hp0] at this; linarith
  have hq1 : (1 : ℝ) ≤ q := by linarith
  have hsum₀ : 1 / (1 : ℝ) = 1 / Pg + 1 / pv 1 + 1 / pv 2 := by
    rw [hPg, one_div_one_div, hg0, ha]; ring
  have hsimple : ∀ (P : ℝ), 1 ≤ P → ∀ s : SimpleFunc E3 ℂ, Integrable s →
      MemLp s (ENNReal.ofReal P) volume := fun P hP s hs =>
    (SimpleFunc.memLp_iff_integrable (by simpa using (by linarith : (0 : ℝ) < P))
      ENNReal.ofReal_ne_top).mpr hs
  have hB₀ : ∀ s : SimpleFunc E3 ℂ, Integrable s →
      eLpNorm (kComp0 k J f s) (ENNReal.ofReal 1) volume
        ≤ ENNReal.ofReal M₀ * eLpNorm s (ENNReal.ofReal Pg) volume := fun s hs =>
    kComp0_bound_of_schwartz k J f le_rfl hPg1 (by linarith) (by linarith) hsum₀
      ENNReal.ofReal_ne_top hS₀ s.measurable (isBdd_simpleFunc s) (hsimple Pg hPg1 s hs)
  have hB₁ : ∀ s : SimpleFunc E3 ℂ, Integrable s →
      eLpNorm (kComp0 k J f s) (ENNReal.ofReal rv) volume
        ≤ ENNReal.ofReal M₁ * eLpNorm s (ENNReal.ofReal q) volume := fun s hs =>
    kComp0_bound_of_schwartz k J f hrv1.le hq1 (by linarith) (by linarith) hrvsum
      ENNReal.ofReal_ne_top hS₁ s.measurable (isBdd_simpleFunc s) (hsimple q hq1 s hs)
  -- Riesz-Thorin in slot `0`
  have hRT := Auto.SteinInterpolation.riesz_thorin (μ := volume) (ν := volume)
    (p₀ := ENNReal.ofReal Pg) (p₁ := ENNReal.ofReal q) (p := ENNReal.ofReal (pv 0))
    (q₀ := ENNReal.ofReal 1) (q₁ := ENNReal.ofReal rv) (q := ENNReal.ofReal p) (θ := θ)
    (M₀ := M₀) (M₁ := M₁) (fun s => kComp0 k J f s)
    (by simpa using hPg1) (by simpa using hq1) (by simp) (by simpa using hrv1.le) ⟨hθ0, hθ1⟩
    (ennreal_interp_exp (by linarith) (by linarith) hp0 hθ0.le hθ1.le hint0)
    (ennreal_interp_exp one_pos (by linarith) (by linarith) hθ0.le hθ1.le hint1)
    (fun s t _ _ => by
      rw [SimpleFunc.coe_add]
      exact kComp0_add' k J f _ _ s.measurable t.measurable (isBdd_simpleFunc s) (isBdd_simpleFunc
        t))
    (fun c s _ => by rw [SimpleFunc.coe_smul]; exact kComp0_smul k J f c s)
    (fun s _ => measurable_kComp0 k J f s.measurable) hM₀0 hM₁0 hB₀ hB₁
  have hfinal := kComp0_bound_of_simple k J f (r := p) (P := pv 0) (P1 := pv 1) (P2 := pv 2)
    hp.le hpv01 (by linarith) (by linarith) hsum ENNReal.ofReal_ne_top
    (fun s hs => (hRT s hs).2) (f 0)
  rw [kComp0_self] at hfinal
  refine hfinal.trans ?_
  have hic := interp_const_le (n := n1 * n2) hCg hCv (by positivity) hθ0.le hθ1.le hθx hK0 hε0.le
    hδ hεδ
  calc ENNReal.ofReal (Real.rpow M₀ (1 - θ) * Real.rpow M₁ θ) * N0
      ≤ ENNReal.ofReal (max Cg 1 * (Cv + 1) * (2 : ℝ) ^ (40 * ε) * (2 : ℝ) ^ (-(δ * x0 / 2 * K)) *
          (n1 * n2)) * N0 := by
        exact mul_le_mul' (ENNReal.ofReal_le_ofReal hic) le_rfl
    _ = _ := by
        rw [hN1e, hN2e, ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul hn1.le]
        ring

/-- The box `[-N, N]^3` of frequency indices. -/
def kBox (N : ℕ) : Finset (Fin 3 → ℤ) := Fintype.piFinset fun _ => Finset.Icc (-(N : ℤ)) N

theorem kBox_mono : Monotone kBox := by
  intro a b hab k hk
  simp only [kBox, Fintype.mem_piFinset, Finset.mem_Icc] at hk ⊢
  intro i; have := hk i; have hab' : (a : ℤ) ≤ b := by exact_mod_cast hab
  constructor <;> linarith [this.1, this.2]

theorem mem_kBox (k : Fin 3 → ℤ) : ∃ N, k ∈ kBox N := by
  refine ⟨(|k 0| + |k 1| + |k 2|).toNat, ?_⟩
  simp only [kBox, Fintype.mem_piFinset, Finset.mem_Icc]
  intro i
  have h0 := abs_nonneg (k 0); have h1 := abs_nonneg (k 1); have h2 := abs_nonneg (k 2)
  have hi : |k i| ≤ |k 0| + |k 1| + |k 2| := by fin_cases i <;> simp <;> omega
  have := Int.self_le_toNat (|k 0| + |k 1| + |k 2|)
  constructor <;> [have := neg_abs_le (k i); have := le_abs_self (k i)] <;> omega

/-- `∑_{m=-99}^{N} 2^{-(δ/3) m} ≤ 2^{33δ}/(1 - 2^{-δ/3})`. -/
theorem sum_Icc_rpow_le {δ : ℝ} (hδ : 0 < δ) (N : ℕ) :
    ∑ m ∈ Finset.Icc (-99 : ℤ) N, (2 : ℝ) ^ (-(δ / 3) * m)
      ≤ (2 : ℝ) ^ (33 * δ) / (1 - (2 : ℝ) ^ (-(δ / 3))) := by
  set c : ℝ := (2 : ℝ) ^ (-(δ / 3)) with hc
  have hc0 : 0 ≤ c := by positivity
  have hc1 : c < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  have hterm : ∀ m ∈ Finset.Icc (-99 : ℤ) N,
      (2 : ℝ) ^ (-(δ / 3) * m) = (2 : ℝ) ^ (33 * δ) * c ^ (m + 99).toNat := by
    intro m hm
    have hm0 : 0 ≤ m + 99 := by simp at hm; omega
    rw [hc, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num), ← Real.rpow_add (by norm_num)]
    congr 1
    have e : (((m + 99).toNat : ℕ) : ℝ) = (m : ℝ) + 99 := by
      rw [show (((m + 99).toNat : ℕ) : ℝ) = (((m + 99).toNat : ℤ) : ℝ) by norm_cast,
        Int.toNat_of_nonneg hm0]; push_cast; ring
    rw [e]; ring
  rw [Finset.sum_congr rfl hterm, ← Finset.mul_sum]
  have hinj : Set.InjOn (fun m : ℤ => (m + 99).toNat) (Finset.Icc (-99 : ℤ) N) := by
    intro a ha b hb h
    simp only [Finset.coe_Icc, Set.mem_Icc] at ha hb
    simp only at h
    omega
  rw [← Finset.sum_image (f := fun i : ℕ => c ^ i) hinj, div_eq_mul_one_div]
  gcongr
  calc ∑ i ∈ (Finset.Icc (-99 : ℤ) N).image (fun m : ℤ => (m + 99).toNat), c ^ i
      ≤ ∑ i ∈ Finset.range (N + 100), c ^ i := by
        refine Finset.sum_le_sum_of_subset_of_nonneg ?_ fun i _ _ => pow_nonneg hc0 i
        intro i hi
        simp only [Finset.mem_image, Finset.mem_Icc] at hi
        obtain ⟨m, ⟨h1, h2⟩, rfl⟩ := hi
        simp only [Finset.mem_range]; omega
    _ = (1 - c ^ (N + 100)) / (1 - c) := by
        rw [geom_sum_eq hc1.ne, ← neg_sub (c ^ (N + 100)), ← neg_sub c, neg_div_neg_eq]
    _ ≤ 1 / (1 - c) :=
        div_le_div_of_nonneg_right (by linarith [pow_nonneg hc0 (N + 100)]) (by linarith)

theorem le_kMax (k : Fin 3 → ℤ) (i : Fin 3) : k i ≤ kMax k := by
  unfold kMax
  fin_cases i
  exacts [le_max_of_le_left (le_max_left _ _), le_max_of_le_left (le_max_right _ _), le_max_right
    _ _]

theorem kMin_le (k : Fin 3 → ℤ) (i : Fin 3) : kMin k ≤ k i := by
  unfold kMin
  fin_cases i
  exacts [min_le_of_left_le (min_le_left _ _), min_le_of_left_le (min_le_right _ _), min_le_right
    _ _]

/-- **The summability over `F_H`**: `∑_{k ∈ F_H ∩ [-N,N]^3} 2^{-δ k^{(1)}} ≤ S`, uniformly in `N`.
-/
theorem sum_regH_le {δ : ℝ} (hδ : 0 < δ) :
    ∃ S : ℝ, 0 ≤ S ∧ ∀ N : ℕ, ∑ k ∈ (kBox N).filter RegH, (2 : ℝ) ^ (-(δ * kMax k)) ≤ S := by
  set T : ℝ := (2 : ℝ) ^ (33 * δ) / (1 - (2 : ℝ) ^ (-(δ / 3))) with hT
  have hc1 : (2 : ℝ) ^ (-(δ / 3)) < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num)
    (by linarith)
  have hT0 : 0 ≤ T := div_nonneg (by positivity) (by linarith)
  refine ⟨T ^ 3, by positivity, fun N => ?_⟩
  have hbound : ∀ k ∈ (kBox N).filter RegH,
      (2 : ℝ) ^ (-(δ * kMax k)) ≤ ∏ i, (2 : ℝ) ^ (-(δ / 3) * k i) := by
    intro k _
    rw [Fin.prod_univ_three, ← Real.rpow_add two_pos, ← Real.rpow_add two_pos]
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
    have h0 : ((k 0 : ℤ) : ℝ) ≤ kMax k := by exact_mod_cast le_kMax k 0
    have h1 : ((k 1 : ℤ) : ℝ) ≤ kMax k := by exact_mod_cast le_kMax k 1
    have h2 : ((k 2 : ℤ) : ℝ) ≤ kMax k := by exact_mod_cast le_kMax k 2
    nlinarith
  have hsub : (kBox N).filter RegH ⊆ Fintype.piFinset fun _ => Finset.Icc (-99 : ℤ) N := by
    intro k hk
    simp only [kBox, Finset.mem_filter, Fintype.mem_piFinset, Finset.mem_Icc] at hk ⊢
    obtain ⟨hbox, hH⟩ := hk
    intro i
    have hmin := kMin_le k i
    have hH1 := hH.1; have hH2 := hH.2
    exact ⟨by omega, (hbox i).2⟩
  calc ∑ k ∈ (kBox N).filter RegH, (2 : ℝ) ^ (-(δ * kMax k))
      ≤ ∑ k ∈ (kBox N).filter RegH, ∏ i, (2 : ℝ) ^ (-(δ / 3) * k i) := Finset.sum_le_sum hbound
    _ ≤ ∑ k ∈ Fintype.piFinset (fun _ : Fin 3 => Finset.Icc (-99 : ℤ) N),
          ∏ i, (2 : ℝ) ^ (-(δ / 3) * k i) :=
        Finset.sum_le_sum_of_subset_of_nonneg hsub fun k _ _ => Finset.prod_nonneg fun i _ =>
          by positivity
    _ = ∏ _i : Fin 3, ∑ m ∈ Finset.Icc (-99 : ℤ) N, (2 : ℝ) ^ (-(δ / 3) * m) :=
        Finset.sum_prod_piFinset (Finset.Icc (-99 : ℤ) N) (fun (_ : Fin 3) (m : ℤ) => (2 : ℝ) ^
          (-(δ / 3) * m))
    _ ≤ ∏ _i : Fin 3, T := Finset.prod_le_prod₀ (fun i _ => Finset.sum_nonneg fun m _ =>
      by positivity)
          fun i _ => sum_Icc_rpow_le hδ N
    _ = T ^ 3 := by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]

theorem summable_kComp_ite (R : (Fin 3 → ℤ) → Prop) [DecidablePred R] (J : ℕ)
    (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    Summable fun k => if R k then kComp k J f x else 0 := by
  have e : (fun k => if R k then kComp k J f x else 0)
      = fun k => ∑ j ∈ Finset.Icc (-(J : ℤ)) J, (if R k then freqPiece j k f x else 0) := by
    funext k; unfold kComp; split_ifs <;> simp
  rw [e]
  exact summable_sum fun j _ => summable_freqPiece_ite R j f x

/-- The region components are the limits of their partial sums over the boxes `[-N, N]^3`. -/
theorem tendsto_regComp_kBox (R : (Fin 3 → ℤ) → Prop) [DecidablePred R] (J : ℕ)
    (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    Tendsto (fun N : ℕ => ∑ k ∈ (kBox N).filter R, kComp k J f x) atTop
      (𝓝 (regComp R J f x)) := by
  rw [regComp_eq_tsum_kComp]
  have h := (summable_kComp_ite R J f x).hasSum.comp
    (tendsto_atTop_finset_of_monotone kBox_mono mem_kBox)
  refine h.congr fun N => ?_
  simp only [Function.comp_apply, Finset.sum_filter]


theorem H_bound {pv : Fin 3 → ℝ} {p : ℝ} (hp : 1 < p) (hp0 : 0 < pv 0) (hp1 : 2 < pv 1)
    (hp2 : 2 < pv 2) (hsum : 1 / p = 1 / pv 0 + 1 / pv 1 + 1 / pv 2)
    (hhalf : 1 / 2 ≤ 1 / pv 1 + 1 / pv 2) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)),
      eLpNorm (regComp RegH J f) (ENNReal.ofReal p) volume
        ≤ ENNReal.ofReal C *
          (eLpNorm (f 0) (ENNReal.ofReal (pv 0)) volume * (eLpNorm (f 1) (ENNReal.ofReal (pv 1))
            volume *
            eLpNorm (f 2) (ENNReal.ofReal (pv 2)) volume)) := by
  obtain ⟨δ', C, hδ', hC, hg⟩ := H_gain hp hp0 hp1 hp2 hsum hhalf
  obtain ⟨S, hS0, hS⟩ := sum_regH_le hδ'
  refine ⟨C * S, by positivity, fun J f => ?_⟩
  set Np := eLpNorm (f 0) (ENNReal.ofReal (pv 0)) volume * (eLpNorm (f 1) (ENNReal.ofReal (pv 1))
    volume *
    eLpNorm (f 2) (ENNReal.ofReal (pv 2)) volume)
  have hfatou := eLpNorm_limit_le_liminf (μ := (volume : Measure E3)) (p :=
    ENNReal.ofReal p)
    (fun N => (Finset.measurable_sum ((kBox N).filter RegH) fun k _ =>
      measurable_kComp k J f).aestronglyMeasurable)
    (regComp RegH J f) (Eventually.of_forall fun x => tendsto_regComp_kBox RegH J f x)
  refine hfatou.trans (Filter.liminf_le_of_frequently_le' (Frequently.of_forall fun N => ?_))
  have hp1' : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by simpa using hp.le
  calc eLpNorm (fun x => ∑ k ∈ (kBox N).filter RegH, kComp k J f x) (ENNReal.ofReal p) volume
      ≤ ∑ k ∈ (kBox N).filter RegH, eLpNorm (kComp k J f) (ENNReal.ofReal p) volume := by
        have e : (fun x => ∑ k ∈ (kBox N).filter RegH, kComp k J f x)
            = ∑ k ∈ (kBox N).filter RegH, kComp k J f := by
          funext x; simp [Finset.sum_apply]
        rw [e]
        exact eLpNorm_sum_le hp1'
    _ ≤ ∑ k ∈ (kBox N).filter RegH, ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ' * kMax k))) * Np :=
        Finset.sum_le_sum fun k hk => hg k (Finset.mem_filter.mp hk).2.1 J f
    _ = ENNReal.ofReal (C * ∑ k ∈ (kBox N).filter RegH, (2 : ℝ) ^ (-(δ' * kMax k))) * Np := by
        rw [← Finset.sum_mul, Finset.mul_sum, ENNReal.ofReal_sum_of_nonneg fun k _ => by positivity]
    _ ≤ ENNReal.ofReal (C * S) * Np := by
        gcongr; exact hS N

/-- The summability over any region all of whose indices satisfy `k_i ≥ -99`. -/
theorem sum_region_le {δ : ℝ} (hδ : 0 < δ) (R : (Fin 3 → ℤ) → Prop) [DecidablePred R]
    (hR : ∀ k, R k → ∀ i, -99 ≤ k i) :
    ∃ S : ℝ, 0 ≤ S ∧ ∀ N : ℕ, ∑ k ∈ (kBox N).filter R, (2 : ℝ) ^ (-(δ * kMax k)) ≤ S := by
  set T : ℝ := (2 : ℝ) ^ (33 * δ) / (1 - (2 : ℝ) ^ (-(δ / 3))) with hT
  have hc1 : (2 : ℝ) ^ (-(δ / 3)) < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num)
    (by linarith)
  have hT0 : 0 ≤ T := div_nonneg (by positivity) (by linarith)
  refine ⟨T ^ 3, by positivity, fun N => ?_⟩
  have hbound : ∀ k ∈ (kBox N).filter R,
      (2 : ℝ) ^ (-(δ * kMax k)) ≤ ∏ i, (2 : ℝ) ^ (-(δ / 3) * k i) := by
    intro k _
    rw [Fin.prod_univ_three, ← Real.rpow_add two_pos, ← Real.rpow_add two_pos]
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
    have h0 : ((k 0 : ℤ) : ℝ) ≤ kMax k := by exact_mod_cast le_kMax k 0
    have h1 : ((k 1 : ℤ) : ℝ) ≤ kMax k := by exact_mod_cast le_kMax k 1
    have h2 : ((k 2 : ℤ) : ℝ) ≤ kMax k := by exact_mod_cast le_kMax k 2
    nlinarith
  have hsub : (kBox N).filter R ⊆ Fintype.piFinset fun _ => Finset.Icc (-99 : ℤ) N := by
    intro k hk
    simp only [kBox, Finset.mem_filter, Fintype.mem_piFinset, Finset.mem_Icc] at hk ⊢
    obtain ⟨hbox, hRk⟩ := hk
    exact fun i => ⟨hR k hRk i, (hbox i).2⟩
  calc ∑ k ∈ (kBox N).filter R, (2 : ℝ) ^ (-(δ * kMax k))
      ≤ ∑ k ∈ (kBox N).filter R, ∏ i, (2 : ℝ) ^ (-(δ / 3) * k i) := Finset.sum_le_sum hbound
    _ ≤ ∑ k ∈ Fintype.piFinset (fun _ : Fin 3 => Finset.Icc (-99 : ℤ) N),
          ∏ i, (2 : ℝ) ^ (-(δ / 3) * k i) :=
        Finset.sum_le_sum_of_subset_of_nonneg hsub fun k _ _ => Finset.prod_nonneg fun i _ =>
          by positivity
    _ = ∏ _i : Fin 3, ∑ m ∈ Finset.Icc (-99 : ℤ) N, (2 : ℝ) ^ (-(δ / 3) * m) :=
        Finset.sum_prod_piFinset (Finset.Icc (-99 : ℤ) N) (fun (_ : Fin 3) (m : ℤ) => (2 : ℝ) ^
          (-(δ / 3) * m))
    _ ≤ ∏ _i : Fin 3, T := Finset.prod_le_prod₀ (fun i _ => Finset.sum_nonneg fun m _ =>
      by positivity)
          fun i _ => sum_Icc_rpow_le hδ N
    _ = T ^ 3 := by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]

/-- **The region bound from exponential gain**: for a region `R` with `k^{(1)} > 0` and all
`k_i ≥ -99`, in the range of `H_gain`, `‖T^R_J(f)‖_p ≤ C ∏ ‖f_n‖_{p_n}` uniformly in `J`. -/
theorem regComp_gain_bound (R : (Fin 3 → ℤ) → Prop) [DecidablePred R]
    (hRpos : ∀ k, R k → 0 < kMax k) (hRlow : ∀ k, R k → ∀ i, -99 ≤ k i)
    {pv : Fin 3 → ℝ} {p : ℝ} (hp : 1 < p) (hp0 : 0 < pv 0) (hp1 : 2 < pv 1)
    (hp2 : 2 < pv 2) (hsum : 1 / p = 1 / pv 0 + 1 / pv 1 + 1 / pv 2)
    (hhalf : 1 / 2 ≤ 1 / pv 1 + 1 / pv 2) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)),
      eLpNorm (regComp R J f) (ENNReal.ofReal p) volume
        ≤ ENNReal.ofReal C *
          (eLpNorm (f 0) (ENNReal.ofReal (pv 0)) volume * (eLpNorm (f 1) (ENNReal.ofReal (pv 1))
            volume *
            eLpNorm (f 2) (ENNReal.ofReal (pv 2)) volume)) := by
  obtain ⟨δ', C, hδ', hC, hg⟩ := H_gain hp hp0 hp1 hp2 hsum hhalf
  obtain ⟨S, hS0, hS⟩ := sum_region_le hδ' R hRlow
  refine ⟨C * S, by positivity, fun J f => ?_⟩
  set Np := eLpNorm (f 0) (ENNReal.ofReal (pv 0)) volume * (eLpNorm (f 1) (ENNReal.ofReal (pv 1))
    volume *
    eLpNorm (f 2) (ENNReal.ofReal (pv 2)) volume)
  have hfatou := eLpNorm_limit_le_liminf (μ := (volume : Measure E3)) (p :=
    ENNReal.ofReal p)
    (fun N => (Finset.measurable_sum ((kBox N).filter R) fun k _ =>
      measurable_kComp k J f).aestronglyMeasurable)
    (regComp R J f) (Eventually.of_forall fun x => tendsto_regComp_kBox R J f x)
  refine hfatou.trans (Filter.liminf_le_of_frequently_le' (Frequently.of_forall fun N => ?_))
  have hp1' : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by simpa using hp.le
  calc eLpNorm (fun x => ∑ k ∈ (kBox N).filter R, kComp k J f x) (ENNReal.ofReal p) volume
      ≤ ∑ k ∈ (kBox N).filter R, eLpNorm (kComp k J f) (ENNReal.ofReal p) volume := by
        have e : (fun x => ∑ k ∈ (kBox N).filter R, kComp k J f x)
            = ∑ k ∈ (kBox N).filter R, kComp k J f := by
          funext x; simp [Finset.sum_apply]
        rw [e]
        exact eLpNorm_sum_le hp1'
    _ ≤ ∑ k ∈ (kBox N).filter R, ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ' * kMax k))) * Np :=
        Finset.sum_le_sum fun k hk => hg k (hRpos k (Finset.mem_filter.mp hk).2) J f
    _ = ENNReal.ofReal (C * ∑ k ∈ (kBox N).filter R, (2 : ℝ) ^ (-(δ' * kMax k))) * Np := by
        rw [← Finset.sum_mul, Finset.mul_sum, ENNReal.ofReal_sum_of_nonneg fun k _ => by positivity]
    _ ≤ ENNReal.ofReal (C * S) * Np := by
        gcongr; exact hS N

/-- `F_{MH,n,+} = {k ∈ F_{MH,n} : k_n > 0}`, lines 585-588. -/
def RegMHnPlus (n : Fin 3) (k : Fin 3 → ℤ) : Prop := RegMHn n k ∧ 0 < k n

/-- `F_{MH,n,-} = {k ∈ F_{MH,n} : k_n ≤ 0}`, lines 585-588. -/
def RegMHnMinus (n : Fin 3) (k : Fin 3 → ℤ) : Prop := RegMHn n k ∧ k n ≤ 0

instance (n : Fin 3) (k : Fin 3 → ℤ) : Decidable (RegMHnPlus n k) := by
  unfold RegMHnPlus; infer_instance
instance (n : Fin 3) (k : Fin 3 → ℤ) : Decidable (RegMHnMinus n k) := by
  unfold RegMHnMinus; infer_instance

/-- `T^{MH,n} = T^{MH,n,+} + T^{MH,n,-}`. -/
theorem regComp_MHn_split (n : Fin 3) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    regComp (RegMHn n) J f x = regComp (RegMHnPlus n) J f x + regComp (RegMHnMinus n) J f x := by
  unfold regComp
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [← (summable_freqPiece_ite (RegMHnPlus n) j f x).tsum_add
    (summable_freqPiece_ite (RegMHnMinus n) j f x)]
  congr 1; funext k
  by_cases h : RegMHn n k
  · by_cases h2 : 0 < k n
    · have : ¬ RegMHnMinus n k := fun h' => by linarith [h'.2]
      simp [h, RegMHnPlus, h2, this]
    · have : ¬ RegMHnPlus n k := fun h' => h2 h'.2
      simp [h, RegMHnMinus, this, not_lt.mp h2]
  · simp [h, RegMHnPlus, RegMHnMinus]

/-- **`T^{MH,n,+}`** (`lem:gain_2+`, lines 595-602, 622-624): bounded in the range of `thm:main`. -/
theorem MHplus_bound (n : Fin 3) {pv : Fin 3 → ℝ} {p : ℝ} (hp : 1 < p) (hp0 : 0 < pv 0)
    (hp1 : 2 < pv 1) (hp2 : 2 < pv 2) (hsum : 1 / p = 1 / pv 0 + 1 / pv 1 + 1 / pv 2)
    (hhalf : 1 / 2 ≤ 1 / pv 1 + 1 / pv 2) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)),
      eLpNorm (regComp (RegMHnPlus n) J f) (ENNReal.ofReal p) volume
        ≤ ENNReal.ofReal C *
          (eLpNorm (f 0) (ENNReal.ofReal (pv 0)) volume * (eLpNorm (f 1) (ENNReal.ofReal (pv 1))
            volume *
            eLpNorm (f 2) (ENNReal.ofReal (pv 2)) volume)) :=
  regComp_gain_bound (RegMHnPlus n) (fun k hk => hk.1.1.1)
    (fun k hk i => by
      have h1 := kMin_le k i
      have h2 : kMin k = k n := hk.1.2
      have h3 := hk.2
      omega) hp hp0 hp1 hp2 hsum hhalf

/-- The bilinear average `A_ψ(g)(x) = ∫ ψ(t) ∏_{n=1}^2 g_n(x + t^{α_n} e_n) dt` on `ℝ^2`
(`blueprints/main.tex` lines 207-210). -/
def monomialAverage (α : Fin 2 → ℕ) (ψ : ℝ → ℝ) (g : Fin 2 → EuclideanSpace ℝ (Fin 2) → ℂ)
    (x : EuclideanSpace ℝ (Fin 2)) : ℂ :=
  ∫ t : ℝ, (ψ t : ℂ) * ∏ n, g n (x + (t ^ α n) • EuclideanSpace.single n (1 : ℝ))

/-- Measurability of the bilinear monomial average for Borel inputs. -/
@[fun_prop] theorem measurable_monomialAverage (α : Fin 2 → ℕ)
    {ψ : ℝ → ℝ} (hψ : Measurable ψ) {g : Fin 2 → EuclideanSpace ℝ (Fin 2) → ℂ}
    (hg : ∀ n, Measurable (g n)) : Measurable (monomialAverage α ψ g) := by
  have hm : Measurable (fun q : EuclideanSpace ℝ (Fin 2) × ℝ => (ψ q.2 : ℂ) *
      ∏ n, g n (q.1 + (q.2 ^ α n) • EuclideanSpace.single n (1 : ℝ))) := by
    fun_prop
  exact hm.stronglyMeasurable.integral_prod_right'.measurable

/-- **`thm:smoothing_2`** (`blueprints/main.tex` lines 211-221), as stated in the source: let
`α_1, α_2` be distinct positive integers, `0 < a < b`. There is a constant `C` and, for every value
of `‖ψ'‖_1`, an exponent `δ = δ(a, b, ‖ψ'‖_1) > 0`, such that for every `ψ ∈ C^1(ℝ)` with
`supp ψ ⊆ [a, b]`, every `λ ≥ 1` and every couple of Schwartz functions `g_1, g_2` on `ℝ^2` with
`supp ĝ_n ⊆ {|ξ_n| ≥ λ}` for at least one `n`,
`‖A_ψ(g)‖_1 ≤ C (‖ψ‖_∞ + ‖ψ'‖_1) λ^{-δ} ‖g_1‖_2 ‖g_2‖_2`.

The source proves it only by reference ("analogous to Theorem 5 of CDR21", line 705); it is proved
as `Auto.smoothingTwo` from `Auto.monomial_smoothing` (blueprint
`blueprints/task_1_smoothing_inequality_2.tex`). -/
def SmoothingTwo : Prop :=
  ∀ α : Fin 2 → ℕ, (∀ n, 0 < α n) → α 0 ≠ α 1 →
  ∀ a b : ℝ, 0 < a → a < b →
  ∃ C : ℝ, 0 < C ∧ ∃ δ : ℝ → ℝ, (∀ v, 0 < δ v) ∧
  ∀ ψ : ℝ → ℝ, ContDiff ℝ 1 ψ → tsupport ψ ⊆ Set.Icc a b →
  ∀ lam : ℝ, 1 ≤ lam → ∀ g : Fin 2 → 𝓢(EuclideanSpace ℝ (Fin 2), ℂ),
    (∃ n, ∀ ξ, 𝓕 (g n : EuclideanSpace ℝ (Fin 2) → ℂ) ξ ≠ 0 → lam ≤ |ξ n|) →
    eLpNorm (monomialAverage α ψ fun n => ⇑(g n)) 1 volume
      ≤ ENNReal.ofReal (C * ((⨆ t, |ψ t|) + ∫ t, |deriv ψ t|) *
          lam ^ (-(δ (∫ t, |deriv ψ t|)))) *
