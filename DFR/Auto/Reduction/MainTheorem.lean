theorem main_result {p : ℝ≥0∞} (hp : 1 < p ∧ p < 4 / 3)
    {q : Fin 3 → ℝ≥0∞} (hq : ∀ i, 1 < q i ∧ q i < 4)
    (hpq : (q 0)⁻¹ + (q 1)⁻¹ + (q 2)⁻¹ = p⁻¹) :
    ∃ C : ℝ, ∀ f : Fin 3 → 𝓢(E3, ℂ),
      eLpNorm (DFR.T (fun i => f i)) p ≤ ENNReal.ofReal C * ∏ i, eLpNorm (f i) (q i) := by
  have hpfin : p ≠ ⊤ := ne_top_of_lt hp.2
  have hqfin : ∀ i, q i ≠ ⊤ := fun i => ne_top_of_lt (hq i).2
  have hpr : 1 < p.toReal ∧ p.toReal < 4 / 3 := by
    constructor
    · exact_mod_cast (ENNReal.toReal_lt_toReal (by norm_num) hpfin).mpr hp.1
    · have h := (ENNReal.toReal_lt_toReal hpfin (by finiteness)).mpr hp.2
      norm_num at h ⊢
      exact h
  have hqr : ∀ i, 1 < (q i).toReal ∧ (q i).toReal < 4 := by
    intro i
    constructor
    · exact_mod_cast (ENNReal.toReal_lt_toReal (by norm_num) (hqfin i)).mpr (hq i).1
    · exact_mod_cast (ENNReal.toReal_lt_toReal (hqfin i) (by norm_num)).mpr (hq i).2
  have hqzero : ∀ i, q i ≠ 0 := fun i => ne_of_gt (lt_trans zero_lt_one (hq i).1)
  have hsum : ∑ i, ((q i).toReal)⁻¹ = p.toReal⁻¹ := by
    have h := congrArg ENNReal.toReal hpq
    simpa [Fin.sum_univ_three, ENNReal.toReal_add, ENNReal.inv_ne_top.mpr,
      hqzero] using h
  obtain ⟨C, _, hC⟩ := thm_main hpr.1 hpr.2 hqr hsum
  exact ⟨C, fun f => by simpa [ENNReal.ofReal_toReal hpfin,
    ENNReal.ofReal_toReal (hqfin _)] using hC f⟩
