/-- The grouped single-scale piece `T_j(S^{(n_0)}_{(n_0+1) j + c} f_{n_0}, Δ f_n, Δ f_m)`. -/
def lowPiece (n0 : Fin 3) (j : ℤ) (p : Fin 3 → ℤ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) : ℂ :=
  simplexTj j (fun n => if n = n0 then ⇑(lpS n ((expo n : ℤ) * j + lowCut p) (f n))
    else ⇑(lpDelta n ((expo n : ℤ) * j + p n) (f n))) x

