def rhoCut (n0 : Fin 3) (s t : ℝ) : ℝ := wPos t * ((phiCM 0).check (t ^ expo n0 - s)).re

/-- The fibre average `B_s(y) = ∫ ρ_s(t) ∏_i G_i(y + t^{e_i} e_i) dt` over the two other slots. -/
def fibreAvg (n0 : Fin 3) (G : Fin 2 → E3 → ℂ) (s : ℝ) (y : E3) : ℂ :=
  ∫ t : ℝ, (rhoCut n0 s t : ℂ) * ∏ i, G i (y + curve (n0.succAbove i) t)

