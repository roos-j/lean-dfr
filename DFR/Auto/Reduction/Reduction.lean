  convert hsum using 1
  simp_rw [lpPsiJ_eq]
  rw [sum_Icc_sub_telescope (fun j => lpPhiJ j ζ)]
  have hone : lpPhiJ (-(L : ℤ) + (2 * L : ℕ)) ζ = 1 := by
    apply lpPhi_eq_one
    have e : -(-(L : ℤ) + (2 * L : ℕ)) = -(L : ℤ) := by push_cast; ring
    rw [e, abs_mul, abs_of_pos (zpow_pos two_pos _), zpow_neg, zpow_natCast,
      inv_mul_le_iff₀ (by positivity)]
