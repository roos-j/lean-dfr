  contDiff_lpPhi.comp (contDiff_const.mul contDiff_id)

theorem contDiff_lpPsiJ (j : ℤ) : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (lpPsiJ j) := by
  have : lpPsiJ j = fun ζ => lpPhiJ j ζ - lpPhiJ (j - 1) ζ := funext (lpPsiJ_eq j)
  rw [this]; exact (contDiff_lpPhiJ j).sub (contDiff_lpPhiJ (j - 1))

theorem hasCompactSupport_lpPhiJ (j : ℤ) : HasCompactSupport (lpPhiJ j) := by
  refine HasCompactSupport.intro (isCompact_Icc (a := -(2 * 2 ^ j)) (b := 2 * 2 ^ j))
    fun ζ hζ => lpPhi_eq_zero ?_
  have hp : (0 : ℝ) < 2 ^ j := zpow_pos two_pos _
  rw [mem_Icc, not_and_or, not_le, not_le] at hζ
  rw [abs_mul, abs_of_pos (zpow_pos two_pos _), zpow_neg, ← div_eq_inv_mul, le_div_iff₀ hp]
  rcases hζ with h | h
  · rw [abs_of_neg (by linarith)]; linarith
  · rw [abs_of_pos (by linarith)]; linarith

theorem hasCompactSupport_lpPsiJ (j : ℤ) : HasCompactSupport (lpPsiJ j) := by
  have : lpPsiJ j = fun ζ => lpPhiJ j ζ - lpPhiJ (j - 1) ζ := funext (lpPsiJ_eq j)
  rw [this]; exact (hasCompactSupport_lpPhiJ j).sub (hasCompactSupport_lpPhiJ (j - 1))

/-- The partial Littlewood-Paley operator `Δ^{(ℓ)}_j`, `(Δ^{(ℓ)}_j f)^(ξ) = ψ_j(ξ_ℓ) f̂(ξ)`,
`blueprints/main.tex` lines 289-293. -/
def lpDelta (ℓ : Fin 3) (j : ℤ) : 𝓢(E3, ℂ) →L[ℂ] 𝓢(E3, ℂ) :=
  SchwartzMap.fourierMultiplierCLM ℂ (fun ξ : E3 => ((lpPsiJ j (ξ ℓ) : ℝ) : ℂ))

/-- The partial sum `S^{(ℓ)}_j`, `(S^{(ℓ)}_j f)^(ξ) = φ_j(ξ_ℓ) f̂(ξ)`, lines 289-293. -/
def lpS (ℓ : Fin 3) (j : ℤ) : 𝓢(E3, ℂ) →L[ℂ] 𝓢(E3, ℂ) :=
  SchwartzMap.fourierMultiplierCLM ℂ (fun ξ : E3 => ((lpPhiJ j (ξ ℓ) : ℝ) : ℂ))

/-! ### The fattened bump `ψ̃`, lines 295-303

The source asks for `1_{1/2 ≤ |ζ| ≤ 1} ≤ ψ̃ ≤ 1_{1/2 - 1/100 ≤ |ζ| ≤ 1 + 1/100}`; the identity
`ψ̃_j ψ_j = ψ_j` it is used for requires `ψ̃ = 1` on the support `{1/2 ≤ |ζ| ≤ 2}` of `ψ`, so
`ψ̃` below satisfies `1_{1/2 ≤ |ζ| ≤ 2} ≤ ψ̃ ≤ 1_{1/2 - 1/100 ≤ |ζ| ≤ 2 + 1/100}` (see
`automation/ErrorReport-task4.md`). -/

/-- Outer bump for `ψ̃`: `1` on `|ζ| ≤ 2`, supported in `|ζ| < 2 + 1/100`. -/
def lpTildeOut : ContDiffBump (0 : ℝ) := ⟨2, 2 + 1 / 100, by norm_num, by norm_num⟩

/-- Inner bump for `ψ̃`: `1` on `|ζ| ≤ 1/2 - 1/100`, supported in `|ζ| < 1/2`. -/
def lpTildeIn : ContDiffBump (0 : ℝ) := ⟨1 / 2 - 1 / 100, 1 / 2, by norm_num, by norm_num⟩

/-- The smooth even function `ψ̃` of line 295 (with the corrected plateau). -/
def lpPsiTilde (ζ : ℝ) : ℝ := lpTildeOut ζ - lpTildeIn ζ

theorem lpPsiTilde_neg (ζ : ℝ) : lpPsiTilde (-ζ) = lpPsiTilde ζ := by
  simp only [lpPsiTilde, lpTildeOut.neg, lpTildeIn.neg]

theorem lpPsiTilde_eq_one {ζ : ℝ} (h1 : 1 / 2 ≤ |ζ|) (h2 : |ζ| ≤ 2) : lpPsiTilde ζ = 1 := by
  unfold lpPsiTilde
  rw [lpTildeOut.one_of_mem_closedBall (by simpa [Metric.mem_closedBall, lpTildeOut] using h2),
    lpTildeIn.zero_of_le_dist (by simpa [Real.dist_eq, lpTildeIn] using h1), sub_zero]

theorem lpPsiTilde_nonneg (ζ : ℝ) : 0 ≤ lpPsiTilde ζ := by
  unfold lpPsiTilde
  by_cases h : |ζ| ≤ 1 / 2
  · rw [lpTildeOut.one_of_mem_closedBall (by simp [Metric.mem_closedBall, lpTildeOut]; linarith)]
    linarith [lpTildeIn.le_one (x := ζ)]
  · rw [lpTildeIn.zero_of_le_dist (by simp [lpTildeIn]; linarith)]
    linarith [lpTildeOut.nonneg (x := ζ)]

theorem lpPsiTilde_le_one (ζ : ℝ) : lpPsiTilde ζ ≤ 1 := by
  unfold lpPsiTilde; linarith [lpTildeOut.le_one (x := ζ), lpTildeIn.nonneg (x := ζ)]

theorem lpPsiTilde_eq_zero {ζ : ℝ} (h : |ζ| < 1 / 2 - 1 / 100 ∨ 2 + 1 / 100 ≤ |ζ|) :
    lpPsiTilde ζ = 0 := by
  unfold lpPsiTilde
  rcases h with h | h
  · rw [lpTildeOut.one_of_mem_closedBall (by simp [Metric.mem_closedBall, lpTildeOut]; linarith),
      lpTildeIn.one_of_mem_closedBall (by simp [Metric.mem_closedBall, lpTildeIn]; linarith)]
    ring
  · rw [lpTildeOut.zero_of_le_dist (by simpa [Real.dist_eq, lpTildeOut] using h),
      lpTildeIn.zero_of_le_dist (by simp [lpTildeIn]; linarith)]
    ring

/-- `ψ̃_j(ζ) = ψ̃(2^{-j} ζ)`, line 301. -/
def lpPsiTildeJ (j : ℤ) (ζ : ℝ) : ℝ := lpPsiTilde ((2 : ℝ) ^ (-j) * ζ)

theorem contDiff_lpPsiTildeJ (j : ℤ) : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (lpPsiTildeJ j) := by
  unfold lpPsiTildeJ lpPsiTilde
  exact ((lpTildeOut.contDiff).sub (lpTildeIn.contDiff)).comp (contDiff_const.mul contDiff_id)

theorem hasCompactSupport_lpPsiTildeJ (j : ℤ) : HasCompactSupport (lpPsiTildeJ j) := by
  refine HasCompactSupport.intro (isCompact_Icc (a := -(3 * 2 ^ j)) (b := 3 * 2 ^ j))
    fun ζ hζ => lpPsiTilde_eq_zero (Or.inr ?_)
  have hp : (0 : ℝ) < 2 ^ j := zpow_pos two_pos _
  rw [mem_Icc, not_and_or, not_le, not_le] at hζ
  rw [abs_mul, abs_of_pos (zpow_pos two_pos _), zpow_neg, ← div_eq_inv_mul, le_div_iff₀ hp]
  rcases hζ with h | h
  · rw [abs_of_neg (by linarith)]; linarith
  · rw [abs_of_pos (by linarith)]; linarith

/-- `ψ̃_j ψ_j = ψ_j`, line 303. -/
theorem lpPsiTildeJ_mul_lpPsiJ (j : ℤ) (ζ : ℝ) : lpPsiTildeJ j ζ * lpPsiJ j ζ = lpPsiJ j ζ := by
  by_cases h : lpPsiJ j ζ = 0
  · rw [h, mul_zero]
  · obtain ⟨h1, h2⟩ := lpPsi_support h
    rw [lpPsiTildeJ, lpPsiTilde_eq_one h1 h2.le, one_mul]

/-- The fattened operator `Δ̃^{(ℓ)}_j`, the Fourier multiplier `ψ̃_j(ξ_ℓ)`. -/
def lpDeltaTilde (ℓ : Fin 3) (j : ℤ) : 𝓢(E3, ℂ) →L[ℂ] 𝓢(E3, ℂ) :=
  SchwartzMap.fourierMultiplierCLM ℂ (fun ξ : E3 => ((lpPsiTildeJ j (ξ ℓ) : ℝ) : ℂ))

/-- `Δ_j Δ̃_j = Δ_j`, line 303. -/
theorem lpDelta_lpDeltaTilde (ℓ : Fin 3) (j : ℤ) (f : 𝓢(E3, ℂ)) :
    lpDelta ℓ j (lpDeltaTilde ℓ j f) = lpDelta ℓ j f := by
  unfold lpDelta lpDeltaTilde
  rw [SchwartzMap.fourierMultiplierCLM_fourierMultiplierCLM_apply
    (hasTemperateGrowth_coord (hasCompactSupport_lpPsiJ j) (contDiff_lpPsiJ j) ℓ)
    (hasTemperateGrowth_coord (hasCompactSupport_lpPsiTildeJ j) (contDiff_lpPsiTildeJ j) ℓ)]
  refine congrArg (fun g => SchwartzMap.fourierMultiplierCLM ℂ g f) (funext fun ξ => ?_)
  simp only [Pi.mul_apply, ← Complex.ofReal_mul, mul_comm (lpPsiJ j (ξ ℓ)),
    lpPsiTildeJ_mul_lpPsiJ]

/-- `Δ̃_j Δ_j = Δ_j`, line 303. -/
theorem lpDeltaTilde_lpDelta (ℓ : Fin 3) (j : ℤ) (f : 𝓢(E3, ℂ)) :
    lpDeltaTilde ℓ j (lpDelta ℓ j f) = lpDelta ℓ j f := by
  unfold lpDelta lpDeltaTilde
  rw [SchwartzMap.fourierMultiplierCLM_fourierMultiplierCLM_apply
    (hasTemperateGrowth_coord (hasCompactSupport_lpPsiTildeJ j) (contDiff_lpPsiTildeJ j) ℓ)
    (hasTemperateGrowth_coord (hasCompactSupport_lpPsiJ j) (contDiff_lpPsiJ j) ℓ)]
  refine congrArg (fun g => SchwartzMap.fourierMultiplierCLM ℂ g f) (funext fun ξ => ?_)
  simp only [Pi.mul_apply, ← Complex.ofReal_mul, lpPsiTildeJ_mul_lpPsiJ]

/-- The single-scale piece `T_j(f)(x) = ∫ ψ(2^j t) ∏_n f_n(x + t^n e_n) dt/t`,
`blueprints/main.tex` line 307. -/
def simplexTj (j : ℤ) (g : Fin 3 → E3 → ℂ) (x : E3) : ℂ :=
  ∫ t : ℝ, (lpPsi ((2 : ℝ) ^ j * t) : ℂ) * prodShift g x t / t

/-- The scale truncation `T_J = ∑_{|j| ≤ J} T_j`. -/
def simplexTrunc' (J : ℕ) (g : Fin 3 → E3 → ℂ) (x : E3) : ℂ :=
  ∑ j ∈ Finset.Icc (-(J : ℤ)) J, simplexTj j g x

theorem lpPsi_neg (ζ : ℝ) : lpPsi (-ζ) = lpPsi ζ := by
  simp only [lpPsi, mul_neg, lpPhi_neg]

theorem lpPsi_abs_le_one (ζ : ℝ) : |lpPsi ζ| ≤ 1 := by
  unfold lpPsi
  rw [abs_le]
  constructor <;> linarith [lpPhi_nonneg ζ, lpPhi_le_one ζ, lpPhi_nonneg (2 * ζ),
    lpPhi_le_one (2 * ζ)]

theorem continuous_lpPsi : Continuous lpPsi :=
  (contDiff_lpPhi (n := 0)).continuous.sub
    ((contDiff_lpPhi (n := 0)).continuous.comp (continuous_const.mul continuous_id))

/-- An even, continuous, bounded weight vanishing on `(-ε, ε)` folds onto the half-line:
`∫ w(t) F(t) dt/t = ∫_0^∞ w(t) (F(t)/t + F(-t)/(-t)) dt`. -/
theorem integral_weight_eq_pvOdd {F : ℝ → ℂ} (hc : Continuous F) (hi : Integrable F)
    {w : ℝ → ℝ} (hw : Continuous w) (hwe : ∀ t, w (-t) = w t) {B : ℝ} (hB : ∀ t, |w t| ≤ B)
    {ε : ℝ} (hε : 0 < ε) (hw0 : ∀ t, |t| ≤ ε → w t = 0) :
    ∫ t : ℝ, (w t : ℂ) * F t / t = ∫ t in Ioi 0, (w t : ℂ) * pvOdd F t := by
  set G : ℝ → ℂ := fun t => (w t : ℂ) * F t with hG
  have hGc : Continuous G := (Complex.continuous_ofReal.comp hw).mul hc
  have hGi : Integrable G := by
    refine Integrable.mono' (hi.norm.const_mul B) hGc.aestronglyMeasurable
      (Eventually.of_forall fun t => ?_)
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
    exact mul_le_mul_of_nonneg_right (hB t) (norm_nonneg _)
  have h1 : ∫ t : ℝ, (w t : ℂ) * F t / t = ∫ t in {t : ℝ | ε < |t|}, G t / t := by
    rw [← integral_indicator (measurableSet_lt measurable_const continuous_abs.measurable)]
    refine integral_congr_ae (Eventually.of_forall fun t => ?_)
    by_cases ht : ε < |t|
    · rw [indicator_of_mem (show t ∈ {t : ℝ | ε < |t|} from ht)]
    · rw [indicator_of_notMem (show t ∉ {t : ℝ | ε < |t|} from ht)]
      simp [hw0 t (not_lt.mp ht)]
  rw [h1, integral_abs_gt_eq_pvOdd hGc hGi hε]
  rw [← integral_indicator measurableSet_Ioi, ← integral_indicator measurableSet_Ioi]
  refine integral_congr_ae (Eventually.of_forall fun t => ?_)
  by_cases ht : ε < t
  · have ht0 : 0 < t := hε.trans ht
    rw [indicator_of_mem (show t ∈ Ioi ε from ht), indicator_of_mem (show t ∈ Ioi 0 from ht0)]
    simp only [pvOdd, hG, hwe]
    ring
  · rw [indicator_of_notMem (show t ∉ Ioi ε from ht)]
    by_cases ht0 : 0 < t
    · rw [indicator_of_mem (show t ∈ Ioi 0 from ht0),
        hw0 t (by rw [abs_of_pos ht0]; exact not_lt.mp ht)]
      simp
    · rw [indicator_of_notMem (show t ∉ Ioi 0 from ht0)]

/-- `ψ(2^j t) = φ(2^j t) - φ(2^{j+1} t)`. -/
theorem lpPsi_two_zpow (j : ℤ) (t : ℝ) :
    lpPsi ((2 : ℝ) ^ j * t) = lpPhi ((2 : ℝ) ^ j * t) - lpPhi ((2 : ℝ) ^ (j + 1) * t) := by
  unfold lpPsi
  congr 2
  rw [zpow_add₀ two_ne_zero, zpow_one]; ring

/-- The scale partial sums `∑_{|j| ≤ J} ψ(2^j t) = φ(2^{-J} t) - φ(2^{J+1} t)`. -/
theorem sum_lpPsi_two_zpow (J : ℕ) (t : ℝ) :
    ∑ j ∈ Finset.Icc (-(J : ℤ)) J, lpPsi ((2 : ℝ) ^ j * t)
      = lpPhi ((2 : ℝ) ^ (-(J : ℤ)) * t) - lpPhi ((2 : ℝ) ^ ((J : ℤ) + 1) * t) := by
  have h := sum_Icc_sub_telescope (fun j => -lpPhi ((2 : ℝ) ^ (j + 1) * t)) (-(J : ℤ)) (2 * J)
  have e : -(J : ℤ) + ((2 * J : ℕ) : ℤ) = J := by push_cast; ring
  rw [e] at h
  have e2 : ∀ j : ℤ, -lpPhi ((2 : ℝ) ^ (j + 1) * t) - -lpPhi ((2 : ℝ) ^ (j - 1 + 1) * t)
      = lpPsi ((2 : ℝ) ^ j * t) := by
    intro j; rw [lpPsi_two_zpow, sub_add_cancel]; ring
  simp only [e2] at h
  rw [h, sub_add_cancel]; ring

theorem abs_sum_lpPsi_two_zpow_le (J : ℕ) (t : ℝ) :
    |∑ j ∈ Finset.Icc (-(J : ℤ)) J, lpPsi ((2 : ℝ) ^ j * t)| ≤ 1 := by
  rw [sum_lpPsi_two_zpow, abs_le]
  constructor <;> linarith [lpPhi_nonneg ((2 : ℝ) ^ (-(J : ℤ)) * t),
    lpPhi_le_one ((2 : ℝ) ^ (-(J : ℤ)) * t), lpPhi_nonneg ((2 : ℝ) ^ ((J : ℤ) + 1) * t),
    lpPhi_le_one ((2 : ℝ) ^ ((J : ℤ) + 1) * t)]

theorem tendsto_sum_lpPsi_two_zpow {t : ℝ} (ht : t ≠ 0) :
    Tendsto (fun J : ℕ => ∑ j ∈ Finset.Icc (-(J : ℤ)) J, lpPsi ((2 : ℝ) ^ j * t)) atTop
      (𝓝 1) := by
  have ha : 0 < |t| := abs_pos.mpr ht
  obtain ⟨N, hN⟩ := pow_unbounded_of_one_lt (|t|) (by norm_num : (1 : ℝ) < 2)
  obtain ⟨M, hM⟩ := pow_unbounded_of_one_lt (2 / |t|) (by norm_num : (1 : ℝ) < 2)
  refine tendsto_const_nhds.congr' ?_
  filter_upwards [eventually_ge_atTop (N + M)] with J hJ
  rw [sum_lpPsi_two_zpow]
  have hJN : (2 : ℝ) ^ N ≤ 2 ^ J := pow_le_pow_right₀ (by norm_num) (by omega)
  have hJM : (2 : ℝ) ^ M ≤ 2 ^ J := pow_le_pow_right₀ (by norm_num) (by omega)
  rw [lpPhi_eq_one, lpPhi_eq_zero]
  · norm_num
  · rw [abs_mul, abs_of_pos (zpow_pos two_pos _), zpow_add₀ two_ne_zero, zpow_one, zpow_natCast]
    have := (div_lt_iff₀ ha).mp (hM.trans_le hJM)
    nlinarith
  · rw [abs_mul, abs_of_pos (zpow_pos two_pos _), zpow_neg, zpow_natCast,
      inv_mul_le_iff₀ (by positivity)]
    linarith

/-- **The scale decomposition `T = ∑_j T_j`**, `blueprints/main.tex` lines 305-308, in the form
used below: for Schwartz inputs the truncations `T_J(f)(x) = ∑_{|j| ≤ J} T_j(f)(x)` converge to
`T(f)(x)` at every point. -/
theorem tendsto_simplexTrunc'_simplexT (f : Fin 3 → SchwartzMap E3 ℂ) (x : E3) :
    Tendsto (fun J : ℕ => simplexTrunc' J (fun n => f n) x) atTop
      (𝓝 (simplexT (fun n => f n) x)) := by
  set F := prodShift (fun n => f n) x with hF
  have hc : Continuous F := continuous_prodShift (fun n => (f n).continuous) x
  have hi : Integrable F := integrable_prodShift_schwartz f x
  obtain ⟨K, hK⟩ := (contDiff_prodShift_schwartz f x).contDiffOn.exists_lipschitzOnWith
    one_ne_zero (convex_Icc (-1 : ℝ) 1) isCompact_Icc
  have hH := integrableOn_pvOdd hc hi hK
  have hTj : ∀ j : ℤ, simplexTj j (fun n => f n) x
      = ∫ t in Ioi 0, (lpPsi ((2 : ℝ) ^ j * t) : ℂ) * pvOdd F t := by
    intro j
    have hp : (0 : ℝ) < 2 ^ j := zpow_pos two_pos _
    refine integral_weight_eq_pvOdd (w := fun t => lpPsi ((2 : ℝ) ^ j * t)) hc hi
      (continuous_lpPsi.comp (continuous_const.mul continuous_id))
      (fun t => by simp only [mul_neg, lpPsi_neg]) (fun t => lpPsi_abs_le_one _)
      (ε := (2 : ℝ) ^ (-j) / 4) (by positivity) (fun t ht => ?_)
    apply lpPsi_eq_zero_of_abs_lt
    rw [abs_mul, abs_of_pos hp]
    have : (2 : ℝ) ^ j * (2 : ℝ) ^ (-j) = 1 := by
      rw [← zpow_add₀ two_ne_zero, add_neg_cancel, zpow_zero]
    nlinarith
  have hsum : ∀ J : ℕ, simplexTrunc' J (fun n => f n) x
      = ∫ t in Ioi 0, ((∑ j ∈ Finset.Icc (-(J : ℤ)) J, lpPsi ((2 : ℝ) ^ j * t) : ℝ) : ℂ)
          * pvOdd F t := by
    intro J
    unfold simplexTrunc'
    simp_rw [hTj]
    rw [← integral_finsetSum]
    · refine integral_congr_ae (Eventually.of_forall fun t => ?_)
      simp only [Complex.ofReal_sum, Finset.sum_mul]
    · intro j _
      refine Integrable.mono' hH.norm
        ((Complex.continuous_ofReal.comp (continuous_lpPsi.comp
          (continuous_const.mul continuous_id))).aestronglyMeasurable.mul
          hH.aestronglyMeasurable) (Eventually.of_forall fun t => ?_)
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
      exact mul_le_of_le_one_left (norm_nonneg _) (lpPsi_abs_le_one _)
  simp_rw [hsum]
  rw [simplexT_eq]
  refine tendsto_integral_of_dominated_convergence (fun t => ‖pvOdd F t‖) (fun J => ?_) hH.norm
    (fun J => Eventually.of_forall fun t => ?_) ?_
  · refine (Complex.continuous_ofReal.comp (continuous_finsetSum _ fun j _ =>
      continuous_lpPsi.comp (continuous_const.mul continuous_id))).aestronglyMeasurable.mul
      hH.aestronglyMeasurable
  · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
    exact mul_le_of_le_one_left (norm_nonneg _) (abs_sum_lpPsi_two_zpow_le J t)
  · rw [ae_restrict_iff' measurableSet_Ioi]
    refine Eventually.of_forall fun t ht => ?_
    have := (Complex.continuous_ofReal.tendsto 1).comp
      (tendsto_sum_lpPsi_two_zpow (ne_of_gt (show (0 : ℝ) < t from ht)))
    simpa using this.mul_const (pvOdd F t)

/-! ### The frequency regions, lines 315-340 -/

/-- The largest component `k^{(1)}`. -/
def kMax (k : Fin 3 → ℤ) : ℤ := max (max (k 0) (k 1)) (k 2)

/-- The smallest component `k^{(3)}`. -/
def kMin (k : Fin 3 → ℤ) : ℤ := min (min (k 0) (k 1)) (k 2)

/-- The middle component `k^{(2)}`. -/
def kMid (k : Fin 3 → ℤ) : ℤ := k 0 + k 1 + k 2 - kMax k - kMin k

theorem kMin_le_kMid (k : Fin 3 → ℤ) : kMin k ≤ kMid k := by
  simp only [kMid, kMax, kMin]; omega

theorem kMid_le_kMax (k : Fin 3 → ℤ) : kMid k ≤ kMax k := by
  simp only [kMid, kMax, kMin]; omega

/-- The low-frequency region `F_L = {k^{(1)} ≤ 0}`, line 317. -/
def RegL (k : Fin 3 → ℤ) : Prop := kMax k ≤ 0

/-- `F_ML = {k^{(1)} > 0, k^{(1)} - k^{(2)} > 100}`, line 318. -/
def RegML (k : Fin 3 → ℤ) : Prop := 0 < kMax k ∧ 100 < kMax k - kMid k

/-- `F_MH = {k^{(1)} > 0, k^{(1)} - k^{(2)} ≤ 100, k^{(1)} - k^{(3)} > 100}`, line 321. -/
def RegMH (k : Fin 3 → ℤ) : Prop :=
  0 < kMax k ∧ kMax k - kMid k ≤ 100 ∧ 100 < kMax k - kMin k

/-- `F_H = {k^{(1)} > 0, k^{(1)} - k^{(3)} ≤ 100}`, line 322. -/
def RegH (k : Fin 3 → ℤ) : Prop := 0 < kMax k ∧ kMax k - kMin k ≤ 100

instance (k : Fin 3 → ℤ) : Decidable (RegL k) := by unfold RegL; infer_instance
instance (k : Fin 3 → ℤ) : Decidable (RegML k) := by unfold RegML; infer_instance
instance (k : Fin 3 → ℤ) : Decidable (RegMH k) := by unfold RegMH; infer_instance
instance (k : Fin 3 → ℤ) : Decidable (RegH k) := by unfold RegH; infer_instance

/-- **`ℤ^3 = F_L ∪ F_ML ∪ F_MH ∪ F_H`**, line 315, and the union is disjoint: every `k` lies in
exactly one region. -/
theorem reg_partition (k : Fin 3 → ℤ) :
    (RegL k ∨ RegML k ∨ RegMH k ∨ RegH k) ∧ ¬(RegL k ∧ RegML k) ∧ ¬(RegL k ∧ RegMH k) ∧
      ¬(RegL k ∧ RegH k) ∧ ¬(RegML k ∧ RegMH k) ∧ ¬(RegML k ∧ RegH k) ∧
      ¬(RegMH k ∧ RegH k) := by
  have h1 := kMin_le_kMid k
  have h2 := kMid_le_kMax k
  unfold RegL RegML RegMH RegH
  omega

/-- `F_{ML,n} = {k ∈ F_ML : k^{(1)} = k_n}`, line 333. -/
def RegMLn (n : Fin 3) (k : Fin 3 → ℤ) : Prop := RegML k ∧ kMax k = k n

/-- `F_{MH,n} = {k ∈ F_MH : k^{(3)} = k_n}`, line 339. -/
def RegMHn (n : Fin 3) (k : Fin 3 → ℤ) : Prop := RegMH k ∧ kMin k = k n

instance (n : Fin 3) (k : Fin 3 → ℤ) : Decidable (RegMLn n k) := by
  unfold RegMLn; infer_instance
instance (n : Fin 3) (k : Fin 3 → ℤ) : Decidable (RegMHn n k) := by
  unfold RegMHn; infer_instance

/-- `F_ML = F_{ML,1} ∪ F_{ML,2} ∪ F_{ML,3}` with exactly one `n` (the maximum is strict), line
330. -/
theorem regML_split {k : Fin 3 → ℤ} (h : RegML k) : ∃! n : Fin 3, RegMLn n k := by
  have hex : kMax k = k 0 ∨ kMax k = k 1 ∨ kMax k = k 2 := by simp only [kMax]; omega
  have huniq : ∀ n m : Fin 3, kMax k = k n → kMax k = k m → n = m := by
    intro n m hn hm
    obtain ⟨-, h2⟩ := h
    have key : ∀ a b c : ℤ, 100 < max (max a b) c - (a + b + c - max (max a b) c -
        min (min a b) c) → (max (max a b) c = a → max (max a b) c = b → False) ∧
        (max (max a b) c = a → max (max a b) c = c → False) ∧
        (max (max a b) c = b → max (max a b) c = c → False) := by
      intro a b c h; refine ⟨?_, ?_, ?_⟩ <;> intro h1 h2 <;> omega
    have K := key (k 0) (k 1) (k 2) (by simpa only [kMid, kMax, kMin] using h2)
    simp only [kMax] at hn hm
    fin_cases n <;> fin_cases m <;> first
      | rfl
      | (exfalso; simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk] at hn hm; tauto)
  rcases hex with e | e | e
  · exact ⟨0, ⟨h, e⟩, fun m hm => huniq m 0 hm.2 e⟩
  · exact ⟨1, ⟨h, e⟩, fun m hm => huniq m 1 hm.2 e⟩
  · exact ⟨2, ⟨h, e⟩, fun m hm => huniq m 2 hm.2 e⟩

/-- `F_MH = F_{MH,1} ∪ F_{MH,2} ∪ F_{MH,3}` with exactly one `n` (the minimum is strict), line
336. -/
theorem regMH_split {k : Fin 3 → ℤ} (h : RegMH k) : ∃! n : Fin 3, RegMHn n k := by
  have hex : kMin k = k 0 ∨ kMin k = k 1 ∨ kMin k = k 2 := by simp only [kMin]; omega
  have huniq : ∀ n m : Fin 3, kMin k = k n → kMin k = k m → n = m := by
    intro n m hn hm
    obtain ⟨-, h2, h3⟩ := h
    have key : ∀ a b c : ℤ, max (max a b) c - (a + b + c - max (max a b) c -
        min (min a b) c) ≤ 100 → 100 < max (max a b) c - min (min a b) c →
        (min (min a b) c = a → min (min a b) c = b → False) ∧
        (min (min a b) c = a → min (min a b) c = c → False) ∧
        (min (min a b) c = b → min (min a b) c = c → False) := by
      intro a b c h h' ; refine ⟨?_, ?_, ?_⟩ <;> intro h1 h2 <;> omega
    have K := key (k 0) (k 1) (k 2) (by simpa only [kMid, kMax, kMin] using h2)
      (by simpa only [kMax, kMin] using h3)
    simp only [kMin] at hn hm
    fin_cases n <;> fin_cases m <;> first
      | rfl
      | (exfalso; simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk] at hn hm; tauto)
  rcases hex with e | e | e
  · exact ⟨0, ⟨h, e⟩, fun m hm => huniq m 0 hm.2 e⟩
  · exact ⟨1, ⟨h, e⟩, fun m hm => huniq m 1 hm.2 e⟩
  · exact ⟨2, ⟨h, e⟩, fun m hm => huniq m 2 hm.2 e⟩

/-- At most three of the `ψ_m(ζ)` are nonzero, so `∑_{m ∈ s} |ψ_m(ζ)| ≤ 3` for every finite
set `s` of scales. -/
theorem sum_abs_lpPsiJ_le (s : Finset ℤ) (ζ : ℝ) : ∑ m ∈ s, |lpPsiJ m ζ| ≤ 3 := by
  classical
  set s' := s.filter (fun m => lpPsiJ m ζ ≠ 0) with hs'
  have hsum : ∑ m ∈ s, |lpPsiJ m ζ| = ∑ m ∈ s', |lpPsiJ m ζ| := by
    rw [hs', Finset.sum_filter]
    refine Finset.sum_congr rfl fun m _ => ?_
    split_ifs with h
    · rfl
    · rw [not_not.mp h, abs_zero]
  rw [hsum]
  rcases s'.eq_empty_or_nonempty with he | hne
  · rw [he, Finset.sum_empty]; norm_num
  set a := s'.min' hne
  have hsub : s' ⊆ Finset.Icc a (a + 2) := by
    intro m hm
    have ham : a ≤ m := s'.min'_le m hm
    have hm' := (Finset.mem_filter.mp hm).2
    have ha' := (Finset.mem_filter.mp (s'.min'_mem hne)).2
    obtain ⟨h1, -⟩ := lpPsiJ_support hm'
    obtain ⟨-, h2⟩ := lpPsiJ_support ha'
    have : (2 : ℝ) ^ (m - 1) ≤ 2 ^ (a + 1) := h1.trans h2
    have := (zpow_le_zpow_iff_right₀ (by norm_num : (1 : ℝ) < 2)).mp this
    rw [Finset.mem_Icc]; omega
  calc ∑ m ∈ s', |lpPsiJ m ζ| ≤ ∑ m ∈ s', (1 : ℝ) :=
        Finset.sum_le_sum fun m _ => lpPsi_abs_le_one _
    _ = s'.card := by simp
    _ ≤ (Finset.Icc a (a + 2)).card := by exact_mod_cast Finset.card_le_card hsub
    _ = 3 := by rw [Int.card_Icc, show a + 2 + 1 - a = 3 by ring]; rfl

theorem continuous_evalCoord (ℓ : Fin 3) : Continuous fun ξ : E3 => ξ ℓ := by fun_prop

/-- The coordinate multiplier `ξ ↦ ψ_m(ξ_ℓ)`. -/
def psiCoord (ℓ : Fin 3) (m : ℤ) (ξ : E3) : ℂ := ((lpPsiJ m (ξ ℓ) : ℝ) : ℂ)

theorem hasTemperateGrowth_psiCoord (ℓ : Fin 3) (m : ℤ) : (psiCoord ℓ m).HasTemperateGrowth :=
  hasTemperateGrowth_coord (hasCompactSupport_lpPsiJ m) (contDiff_lpPsiJ m) ℓ

/-- The value of a Schwartz Fourier multiplier: `(m(D) g)(y) = ∫ e(⟨ξ, y⟩) m(ξ) ĝ(ξ) dξ`. -/
theorem fourierMultiplierCLM_apply_eq {m : E3 → ℂ} (hm : m.HasTemperateGrowth)
    (g : 𝓢(E3, ℂ)) (y : E3) :
    SchwartzMap.fourierMultiplierCLM ℂ m g y
      = ∫ ξ : E3, Real.fourierChar (inner ℝ ξ y) • (m ξ * 𝓕 (g : E3 → ℂ) ξ) := by
  rw [SchwartzMap.fourierMultiplierCLM_apply, SchwartzMap.fourierInv_coe, Real.fourierInv_eq]
  congr 1
  funext ξ
  rw [SchwartzMap.smulLeftCLM_apply_apply hm, smul_eq_mul, SchwartzMap.fourier_coe]

theorem lpDelta_apply_eq (ℓ : Fin 3) (m : ℤ) (g : 𝓢(E3, ℂ)) (y : E3) :
    lpDelta ℓ m g y
      = ∫ ξ : E3, Real.fourierChar (inner ℝ ξ y) • (psiCoord ℓ m ξ * 𝓕 (g : E3 → ℂ) ξ) :=
  fourierMultiplierCLM_apply_eq (hasTemperateGrowth_psiCoord ℓ m) g y

/-- The sup-norm majorant `c_m = ∫ |ψ_m(ξ_ℓ)| |ĝ(ξ)| dξ` of `Δ^{(ℓ)}_m g`. -/
def deltaMajor (ℓ : Fin 3) (m : ℤ) (g : 𝓢(E3, ℂ)) : ℝ :=
  ∫ ξ : E3, |lpPsiJ m (ξ ℓ)| * ‖𝓕 (g : E3 → ℂ) ξ‖

theorem continuous_lpPsiJ (m : ℤ) : Continuous (lpPsiJ m) :=
  (contDiff_lpPsiJ m).continuous

theorem integrable_psi_fourier (ℓ : Fin 3) (m : ℤ) (g : 𝓢(E3, ℂ)) :
    Integrable (fun ξ : E3 => |lpPsiJ m (ξ ℓ)| * ‖𝓕 (g : E3 → ℂ) ξ‖) := by
  refine Integrable.mono' (𝓕 g).integrable.norm
    (((continuous_lpPsiJ m).comp (continuous_evalCoord ℓ)).abs.aestronglyMeasurable.mul
      (𝓕 g).integrable.norm.aestronglyMeasurable) (Eventually.of_forall fun ξ => ?_)
  rw [Real.norm_eq_abs, abs_mul, abs_abs, abs_norm, ← SchwartzMap.fourier_coe]
  exact mul_le_of_le_one_left (norm_nonneg _) (lpPsi_abs_le_one _)

theorem norm_lpDelta_le (ℓ : Fin 3) (m : ℤ) (g : 𝓢(E3, ℂ)) (y : E3) :
    ‖lpDelta ℓ m g y‖ ≤ deltaMajor ℓ m g := by
  rw [lpDelta_apply_eq]
  refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
  unfold deltaMajor
  congr 1; funext ξ
  rw [Circle.smul_def, smul_eq_mul, norm_mul, Circle.norm_coe, one_mul, norm_mul, psiCoord, Complex.norm_real,
    Real.norm_eq_abs]

theorem deltaMajor_nonneg (ℓ : Fin 3) (m : ℤ) (g : 𝓢(E3, ℂ)) : 0 ≤ deltaMajor ℓ m g :=
  integral_nonneg fun ξ => mul_nonneg (abs_nonneg _) (norm_nonneg _)

/-- `∑_m ‖Δ^{(ℓ)}_m g‖_∞ ≤ ∑_m c_m ≤ 3 ‖ĝ‖_1 < ∞`. -/
theorem summable_deltaMajor (ℓ : Fin 3) (g : 𝓢(E3, ℂ)) :
    Summable (fun m : ℤ => deltaMajor ℓ m g) := by
  refine summable_of_sum_le (c := 3 * ∫ ξ : E3, ‖𝓕 (g : E3 → ℂ) ξ‖)
    (fun m => deltaMajor_nonneg ℓ m g) fun s => ?_
  unfold deltaMajor
  rw [← integral_finsetSum _ fun m _ => integrable_psi_fourier ℓ m g, ← integral_const_mul]
  refine integral_mono (integrable_finsetSum _ fun m _ => integrable_psi_fourier ℓ m g)
    ((𝓕 g).integrable.norm.const_mul 3) fun ξ => ?_
  simp only
  rw [← Finset.sum_mul]
  exact mul_le_mul_of_nonneg_right (sum_abs_lpPsiJ_le s _) (norm_nonneg _)

/-- The hyperplane `{ξ_ℓ = 0}` is Lebesgue-null. -/
theorem volume_coord_eq_zero (ℓ : Fin 3) : volume {ξ : E3 | ξ ℓ = 0} = 0 := by
  have hs : {ξ : E3 | ξ ℓ = 0} = (LinearMap.ker (EuclideanSpace.proj (𝕜 := ℝ) ℓ :
      E3 →ₗ[ℝ] ℝ) : Set E3) := by
    ext ξ; simp
  rw [hs]
  refine Measure.addHaar_submodule volume _ fun h => ?_
  have : EuclideanSpace.single ℓ (1 : ℝ) ∈ LinearMap.ker (EuclideanSpace.proj (𝕜 := ℝ) ℓ :
      E3 →ₗ[ℝ] ℝ) := h ▸ Submodule.mem_top
  simp at this

/-- **Littlewood-Paley reconstruction**, pointwise: `∑_m Δ^{(ℓ)}_m g(y) = g(y)` for Schwartz `g`
(from `∑_m ψ_m = 1` off the null hyperplane `{ξ_ℓ = 0}` and Fourier inversion). -/
theorem hasSum_lpDelta (ℓ : Fin 3) (g : 𝓢(E3, ℂ)) (y : E3) :
    HasSum (fun m : ℤ => lpDelta ℓ m g y) (g y) := by
  have hinv : g y = ∫ ξ : E3, Real.fourierChar (inner ℝ ξ y) • 𝓕 (g : E3 → ℂ) ξ := by
    have h := congrArg (fun F : 𝓢(E3, ℂ) => F y)
      (FourierPair.fourierInv_fourier_eq (E := 𝓢(E3, ℂ)) (F := 𝓢(E3, ℂ)) g)
    rw [← h, SchwartzMap.fourierInv_coe, Real.fourierInv_eq, SchwartzMap.fourier_coe]
  have hb : ∀ ξ : E3, Summable (fun m : ℤ => |lpPsiJ m (ξ ℓ)| * ‖𝓕 (g : E3 → ℂ) ξ‖) := by
    intro ξ
    refine summable_of_sum_le (c := 3 * ‖𝓕 (g : E3 → ℂ) ξ‖)
      (fun m => mul_nonneg (abs_nonneg _) (norm_nonneg _)) fun s => ?_
    rw [← Finset.sum_mul]
    exact mul_le_mul_of_nonneg_right (sum_abs_lpPsiJ_le s _) (norm_nonneg _)
  simp_rw [lpDelta_apply_eq]
  rw [hinv]
  refine hasSum_integral_of_dominated_convergence
    (fun m ξ => |lpPsiJ m (ξ ℓ)| * ‖𝓕 (g : E3 → ℂ) ξ‖) (fun m => ?_) (fun m => ?_) ?_ ?_ ?_
  · exact (Real.continuous_fourierChar.comp (continuous_id.inner continuous_const)).aestronglyMeasurable.smul
      ((Complex.continuous_ofReal.comp ((continuous_lpPsiJ m).comp
        (continuous_evalCoord ℓ))).aestronglyMeasurable.mul
        (𝓕 g).integrable.aestronglyMeasurable)
  · refine Eventually.of_forall fun ξ => le_of_eq ?_
    rw [Circle.smul_def, smul_eq_mul, norm_mul, Circle.norm_coe, one_mul, norm_mul, psiCoord, Complex.norm_real,
      Real.norm_eq_abs]
  · exact Eventually.of_forall hb
  · refine Integrable.mono' ((𝓕 g).integrable.norm.const_mul 3) ?_
      (Eventually.of_forall fun ξ => ?_)
    · have e : (fun ξ : E3 => ∑' m : ℤ, |lpPsiJ m (ξ ℓ)| * ‖𝓕 (g : E3 → ℂ) ξ‖)
          = fun ξ => ((∑' m : ℤ, (|lpPsiJ m (ξ ℓ)| * ‖𝓕 (g : E3 → ℂ) ξ‖).toNNReal : NNReal) : ℝ) := by
        funext ξ
        rw [NNReal.coe_tsum]
        congr 1; funext m
        rw [Real.coe_toNNReal _ (mul_nonneg (abs_nonneg _) (norm_nonneg _))]
      rw [e]
      refine (Measurable.nnreal_tsum fun m => ?_).coe_nnreal_real.aestronglyMeasurable
      exact ((((continuous_lpPsiJ m).comp (continuous_evalCoord ℓ)).abs.measurable.mul
        (SchwartzMap.continuous (𝓕 g)).norm.measurable)).real_toNNReal
    · rw [Real.norm_eq_abs, abs_of_nonneg (tsum_nonneg fun m =>
        mul_nonneg (abs_nonneg _) (norm_nonneg _))]
      refine tsum_le_of_sum_le' (by positivity) fun s => ?_
      rw [← Finset.sum_mul, ← SchwartzMap.fourier_coe]
      exact mul_le_mul_of_nonneg_right (sum_abs_lpPsiJ_le s _) (norm_nonneg _)
  · have hae : ∀ᵐ ξ : E3 ∂volume, ξ ℓ ≠ 0 := by
      rw [ae_iff]; simpa using volume_coord_eq_zero ℓ
    filter_upwards [hae] with ξ hξ
    have h' : HasSum (fun m => psiCoord ℓ m ξ) 1 := by
      simpa [psiCoord] using Complex.ofRealCLM.hasSum (hasSum_lpPsiJ hξ)
    simpa using (h'.mul_right (𝓕 (g : E3 → ℂ) ξ)).const_smul (Real.fourierChar (inner ℝ ξ y))

/-- `ℤ × ℤ × ℤ ≃ (Fin 3 → ℤ)`. -/
def tripleEquiv : ℤ × ℤ × ℤ ≃ (Fin 3 → ℤ) where
  toFun p := ![p.1, p.2.1, p.2.2]
  invFun k := (k 0, k 1, k 2)
  left_inv p := by simp
  right_inv k := by ext n; fin_cases n <;> simp

/-- Products of three absolutely summable series: if `∑_m a_n(m) = s_n` with `∑_m ‖a_n(m)‖ < ∞`,
then `∑_{k ∈ ℤ^3} ∏_n a_n(k_n) = ∏_n s_n`, absolutely. -/
theorem hasSum_prod_three {a : Fin 3 → ℤ → ℂ} {s : Fin 3 → ℂ} (h : ∀ n, HasSum (a n) (s n))
    (hn : ∀ n, Summable fun m => ‖a n m‖) :
    HasSum (fun k : Fin 3 → ℤ => ∏ n, a n (k n)) (∏ n, s n) ∧
      Summable (fun k : Fin 3 → ℤ => ∏ n, ‖a n (k n)‖) := by
  have h12 : Summable (fun q : ℤ × ℤ => a 1 q.1 * a 2 q.2) :=
    summable_mul_of_summable_norm (hn 1) (hn 2)
  have h12n : Summable (fun q : ℤ × ℤ => ‖a 1 q.1‖ * ‖a 2 q.2‖) := by
    simpa only [norm_mul] using (hn 1).mul_norm (hn 2)
  have H12 : HasSum (fun q : ℤ × ℤ => a 1 q.1 * a 2 q.2) (s 1 * s 2) := (h 1).mul (h 2) h12
  have h012 : Summable (fun p : ℤ × ℤ × ℤ => a 0 p.1 * (a 1 p.2.1 * a 2 p.2.2)) := by
    refine summable_mul_of_summable_norm (f := a 0) (g := fun q : ℤ × ℤ => a 1 q.1 * a 2 q.2)
      (hn 0) ?_
    simpa only [norm_mul] using h12n
  have h012n : Summable (fun p : ℤ × ℤ × ℤ => ‖a 0 p.1‖ * (‖a 1 p.2.1‖ * ‖a 2 p.2.2‖)) := by
    have := (hn 0).mul_norm (f := fun m => a 0 m) (g := fun q : ℤ × ℤ => a 1 q.1 * a 2 q.2)
      (by simpa only [norm_mul] using h12n)
    simpa only [norm_mul] using this
  have H := (h 0).mul H12 h012
  constructor
  · have H' : HasSum (fun p : ℤ × ℤ × ℤ => ∏ n, a n (tripleEquiv p n)) (∏ n, s n) := by
      have e1 : (fun p : ℤ × ℤ × ℤ => ∏ n, a n (tripleEquiv p n))
          = fun p => a 0 p.1 * (a 1 p.2.1 * a 2 p.2.2) := by
        funext p; simp [tripleEquiv, Fin.prod_univ_three, mul_assoc]
      rw [e1, Fin.prod_univ_three, mul_assoc]; exact H
    exact tripleEquiv.hasSum_iff.mp H'
  · have H' : Summable (fun p : ℤ × ℤ × ℤ => ∏ n, ‖a n (tripleEquiv p n)‖) := by
      have e1 : (fun p : ℤ × ℤ × ℤ => ∏ n, ‖a n (tripleEquiv p n)‖)
          = fun p => ‖a 0 p.1‖ * (‖a 1 p.2.1‖ * ‖a 2 p.2.2‖) := by
        funext p; simp [tripleEquiv, Fin.prod_univ_three, mul_assoc]
      rw [e1]; exact h012n
    exact tripleEquiv.summable_iff.mp H'

/-- The frequency-localized piece `T_j(Δ^{(1)}_{j+k_1} f_1, Δ^{(2)}_{2j+k_2} f_2,
Δ^{(3)}_{3j+k_3} f_3)(x)` of `eq:decomposition_k` (coordinate `n` carries scale
`(n+1) j + k_n`). -/
def freqPiece (j : ℤ) (k : Fin 3 → ℤ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) : ℂ :=
  simplexTj j (fun n => ⇑(lpDelta n ((expo n : ℤ) * j + k n) (f n))) x

/-- The weight `ψ(2^j t)/t` is integrable: it vanishes for `|t| < 2^{-j-1}`. -/
theorem integrable_psi_div (j : ℤ) :
    Integrable (fun t : ℝ => (lpPsi ((2 : ℝ) ^ j * t) : ℂ) / t) := by
  have hp : (0 : ℝ) < 2 ^ j := zpow_pos two_pos _
  have hw : Continuous fun t : ℝ => lpPsi ((2 : ℝ) ^ j * t) :=
    continuous_lpPsi.comp (continuous_const.mul continuous_id)
  have hwc : HasCompactSupport fun t : ℝ => lpPsi ((2 : ℝ) ^ j * t) := by
    refine HasCompactSupport.intro (isCompact_Icc (a := -(2 * 2 ^ (-j))) (b := 2 * 2 ^ (-j)))
      fun t ht => lpPsi_eq_zero_of_le_abs ?_
    have hq : (0 : ℝ) < 2 ^ (-j) := zpow_pos two_pos _
    have e : (2 : ℝ) ^ j * 2 ^ (-j) = 1 := by rw [← zpow_add₀ two_ne_zero, add_neg_cancel, zpow_zero]
    rw [mem_Icc, not_and_or, not_le, not_le] at ht
    rw [abs_mul, abs_of_pos hp]
    rcases ht with h | h
    · rw [abs_of_neg (by linarith)]; nlinarith
    · rw [abs_of_pos (by linarith)]; nlinarith
  refine Integrable.mono' ((hw.integrable_of_hasCompactSupport hwc).norm.const_mul (4 * 2 ^ j))
    ((Complex.continuous_ofReal.comp hw).measurable.div
      Complex.measurable_ofReal).aestronglyMeasurable (Eventually.of_forall fun t => ?_)
  rw [norm_div, Complex.norm_real, Complex.norm_real, Real.norm_eq_abs, Real.norm_eq_abs]
  by_cases ht : |t| < (2 : ℝ) ^ (-j) / 4
  · rw [lpPsi_eq_zero_of_abs_lt]
    · simp
    · have e : (2 : ℝ) ^ j * 2 ^ (-j) = 1 := by
        rw [← zpow_add₀ two_ne_zero, add_neg_cancel, zpow_zero]
      rw [abs_mul, abs_of_pos hp]; nlinarith
  · push Not at ht
    have hq : (0 : ℝ) < 2 ^ (-j) := zpow_pos two_pos _
    have ht0 : 0 < |t| := lt_of_lt_of_le (by positivity) ht
    rw [div_le_iff₀ ht0]
    have e : (2 : ℝ) ^ j * 2 ^ (-j) = 1 := by
      rw [← zpow_add₀ two_ne_zero, add_neg_cancel, zpow_zero]
    have : 1 ≤ 4 * 2 ^ j * |t| := by nlinarith
    nlinarith [abs_nonneg (lpPsi ((2 : ℝ) ^ j * t))]

/-- **The frequency expansion of a single scale**, `eq:decomposition_k`: for Schwartz inputs,
`T_j(f)(x) = ∑_{k ∈ ℤ^3} T_j(Δ^{(1)}_{j+k_1} f_1, Δ^{(2)}_{2j+k_2} f_2, Δ^{(3)}_{3j+k_3} f_3)(x)`,
the series converging absolutely. -/
theorem hasSum_piece (j : ℤ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    HasSum (fun k => freqPiece j k f x) (simplexTj j (fun n => f n) x) ∧
      Summable (fun k => ‖freqPiece j k f x‖) := by
  set w : ℝ → ℂ := fun t => (lpPsi ((2 : ℝ) ^ j * t) : ℂ) / t with hw
  have hwi : Integrable w := integrable_psi_div j
  set c : Fin 3 → ℤ → ℝ := fun n m => deltaMajor n ((expo n : ℤ) * j + m) (f n) with hc
  have hcs : ∀ n, Summable (c n) := fun n =>
    (Equiv.addLeft ((expo n : ℤ) * j)).summable_iff.mpr (summable_deltaMajor n (f n))
  have hcn : ∀ n, Summable fun m => ‖(c n m : ℂ)‖ := fun n => by
    simpa [Complex.norm_real, Real.norm_eq_abs] using (hcs n).abs
  have hC := (hasSum_prod_three (a := fun n m => ((c n m : ℝ) : ℂ))
    (fun n => Complex.hasSum_ofReal.mpr (hcs n).hasSum) hcn).2
  set C : ℝ := ∑' k : Fin 3 → ℤ, ∏ n, c n (k n) with hCdef
  have hCs : Summable (fun k : Fin 3 → ℤ => ∏ n, c n (k n)) := by
    refine hC.congr fun k => ?_
    refine Finset.prod_congr rfl fun n _ => ?_
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (deltaMajor_nonneg _ _ _)]
  -- the integrand of each freqPiece
  set F : (Fin 3 → ℤ) → ℝ → ℂ := fun k t =>
    w t * ∏ n, lpDelta n ((expo n : ℤ) * j + k n) (f n) (x + curve n t) with hF
  have hpiece : ∀ k, freqPiece j k f x = ∫ t, F k t := by
    intro k
    unfold freqPiece simplexTj
    refine integral_congr_ae (Eventually.of_forall fun t => ?_)
    simp only [hF, hw, prodShift]
    ring
  have htot : simplexTj j (fun n => f n) x = ∫ t, w t * ∏ n, f n (x + curve n t) := by
    unfold simplexTj
    refine integral_congr_ae (Eventually.of_forall fun t => ?_)
    simp only [hw, prodShift]
    ring
  -- pointwise expansion
  have hpt : ∀ t, HasSum (fun k : Fin 3 → ℤ => ∏ n, lpDelta n ((expo n : ℤ) * j + k n) (f n)
      (x + curve n t)) (∏ n, f n (x + curve n t)) ∧
      Summable (fun k : Fin 3 → ℤ => ∏ n, ‖lpDelta n ((expo n : ℤ) * j + k n) (f n)
        (x + curve n t)‖) := by
    intro t
    have h1 : ∀ n : Fin 3, HasSum (fun m : ℤ => lpDelta n ((expo n : ℤ) * j + m) (f n)
        (x + curve n t)) (f n (x + curve n t)) := fun n => by
      have := ((Equiv.addLeft ((expo n : ℤ) * j)).hasSum_iff
        (f := fun m : ℤ => lpDelta n m (f n) (x + curve n t))).mpr
        (hasSum_lpDelta n (f n) (x + curve n t))
      simpa only [Function.comp_def, Equiv.coe_addLeft] using this
    have h2 : ∀ n : Fin 3, Summable (fun m : ℤ => ‖lpDelta n ((expo n : ℤ) * j + m) (f n)
        (x + curve n t)‖) := fun n =>
      Summable.of_nonneg_of_le (fun m => norm_nonneg _)
        (fun m => norm_lpDelta_le n _ (f n) _) (hcs n)
    exact hasSum_prod_three (a := fun n m => lpDelta n ((expo n : ℤ) * j + m) (f n)
      (x + curve n t)) (s := fun n => f n (x + curve n t)) h1 h2
  have hbound : ∀ k t, ‖F k t‖ ≤ ‖w t‖ * ∏ n, c n (k n) := by
    intro k t
    rw [hF, norm_mul, norm_prod]
    exact mul_le_mul_of_nonneg_left (Finset.prod_le_prod (fun n _ => norm_nonneg _)
      fun n _ => norm_lpDelta_le n _ (f n) _) (norm_nonneg _)
  have hmeas : ∀ k, AEStronglyMeasurable (F k) volume := by
    intro k
    refine hwi.aestronglyMeasurable.mul ?_
    exact (continuous_finsetProd _ fun n _ => (SchwartzMap.continuous _).comp
      (continuous_const.add (continuous_curve n))).aestronglyMeasurable
  constructor
  · simp_rw [hpiece]
    rw [htot]
    refine hasSum_integral_of_dominated_convergence (fun k t => ‖w t‖ * ∏ n, c n (k n))
      hmeas (fun k => Eventually.of_forall (hbound k)) (Eventually.of_forall fun t =>
        hCs.mul_left _) ?_ (Eventually.of_forall fun t => (hpt t).1.mul_left (w t))
    simp_rw [tsum_mul_left]
    exact hwi.norm.mul_const _
  · simp_rw [hpiece]
    refine Summable.of_nonneg_of_le (fun k => norm_nonneg _) (fun k => ?_)
      (hCs.mul_left (∫ t, ‖w t‖))
    refine (norm_integral_le_integral_norm _).trans ?_
    rw [← integral_mul_const]
    exact integral_mono_of_nonneg (Eventually.of_forall fun t => norm_nonneg _)
      (hwi.norm.mul_const _) (Eventually.of_forall (hbound k))

/-- The component of a region `R ⊆ ℤ^3` of the truncation `T_J`:
`T^R_J(f)(x) = ∑_{|j| ≤ J} ∑_{k ∈ R} T_j(Δ^{(1)}_{j+k_1} f_1, Δ^{(2)}_{2j+k_2} f_2, Δ^{(3)}_{3j+k_3} f_3)(x)`,
lines 326-329 (`T^ω = ∑_j T^ω_j`, truncated in `j`). -/
def regComp (R : (Fin 3 → ℤ) → Prop) [DecidablePred R] (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ))
    (x : E3) : ℂ :=
  ∑ j ∈ Finset.Icc (-(J : ℤ)) J, ∑' k : Fin 3 → ℤ, if R k then freqPiece j k f x else 0

/-- `T^{(k)}_J(f)(x) = ∑_{|j| ≤ J} T_j(Δ^{(1)}_{j+k_1} f_1, ...)(x)`, `eq:decomposition_k`
truncated in `j`. -/
def kComp (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) : ℂ :=
  ∑ j ∈ Finset.Icc (-(J : ℤ)) J, freqPiece j k f x

theorem summable_freqPiece_ite (R : (Fin 3 → ℤ) → Prop) [DecidablePred R] (j : ℤ)
    (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    Summable (fun k => if R k then freqPiece j k f x else 0) := by
  refine Summable.of_norm_bounded (hasSum_piece j f x).2 fun k => ?_
  split_ifs <;> simp

/-- A region component is the sum over the region of the `k`-components: the `j`- and
`k`-sums may be exchanged (finite `j`-sum, absolutely convergent `k`-series). -/
theorem regComp_eq_tsum_kComp (R : (Fin 3 → ℤ) → Prop) [DecidablePred R] (J : ℕ)
    (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    regComp R J f x = ∑' k : Fin 3 → ℤ, if R k then kComp k J f x else 0 := by
  unfold regComp kComp
  rw [← Summable.tsum_finsetSum fun j _ => summable_freqPiece_ite R j f x]
  congr 1; funext k
  split_ifs <;> simp

/-- **The frequency decomposition `eqn:basicfreqdecomp`**, lines 311-345, truncated in `j`:
`T_J = T^L_J + T^ML_J + T^MH_J + T^H_J` pointwise for Schwartz inputs. -/
theorem simplexTrunc'_eq_regComp (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    simplexTrunc' J (fun n => f n) x
      = regComp RegL J f x + regComp RegML J f x + regComp RegMH J f x
        + regComp RegH J f x := by
  unfold simplexTrunc' regComp
  simp only [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [← (hasSum_piece j f x).1.tsum_eq]
  rw [← (summable_freqPiece_ite RegL j f x).tsum_add (summable_freqPiece_ite RegML j f x),
    ← ((summable_freqPiece_ite RegL j f x).add (summable_freqPiece_ite RegML j f x)).tsum_add
      (summable_freqPiece_ite RegMH j f x),
    ← (((summable_freqPiece_ite RegL j f x).add (summable_freqPiece_ite RegML j f x)).add
      (summable_freqPiece_ite RegMH j f x)).tsum_add (summable_freqPiece_ite RegH j f x)]
  congr 1; funext k
  obtain ⟨hc, h1, h2, h3, h4, h5, h6⟩ := reg_partition k
  by_cases hL : RegL k <;> by_cases hML : RegML k <;> by_cases hMH : RegMH k <;>
    by_cases hH : RegH k <;> simp_all

/-- `T^{ML}_J = T^{ML,1}_J + T^{ML,2}_J + T^{ML,3}_J`, line 330. -/
theorem regComp_ML_split (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    regComp RegML J f x = ∑ n : Fin 3, regComp (RegMLn n) J f x := by
  unfold regComp
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [← Summable.tsum_finsetSum fun n _ => summable_freqPiece_ite (RegMLn n) j f x]
  congr 1; funext k
  by_cases h : RegML k
  · obtain ⟨n, hn, hu⟩ := regML_split h
    rw [if_pos h, Finset.sum_eq_single n (fun m _ hm => if_neg fun h' => hm (hu m h'))
      (by simp), if_pos hn]
  · rw [if_neg h]
    exact (Finset.sum_eq_zero fun n _ => if_neg fun h' => h h'.1).symm

/-- `T^{MH}_J = T^{MH,1}_J + T^{MH,2}_J + T^{MH,3}_J`, line 336. -/
theorem regComp_MH_split (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    regComp RegMH J f x = ∑ n : Fin 3, regComp (RegMHn n) J f x := by
  unfold regComp
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [← Summable.tsum_finsetSum fun n _ => summable_freqPiece_ite (RegMHn n) j f x]
  congr 1; funext k
  by_cases h : RegMH k
  · obtain ⟨n, hn, hu⟩ := regMH_split h
    rw [if_pos h, Finset.sum_eq_single n (fun m _ hm => if_neg fun h' => hm (hu m h'))
      (by simp), if_pos hn]
  · rw [if_neg h]
    exact (Finset.sum_eq_zero fun n _ => if_neg fun h' => h h'.1).symm

/-! ## Section 4 (imported): `thm:main_twist` from Task 3 -/

/-- The anisotropic twisted operator of `blueprints/main.tex`, lines 230-233, for a kernel `K`:
`Γ_K(f)(x) = ∫_{ℝ^3} K(t) ∏_{n=1}^3 f_n(x + t_n e_n) dt` (the source writes `t^n` for the
coordinate `t_n`). -/
def gammaOp (K : E3 → ℂ) (g : Fin 3 → E3 → ℂ) (x : E3) : ℂ :=
  ∫ t : E3, K t * ∏ n, g n (x + t n • basisVec n)

theorem coordinateDirection_eq_basisVec (i : Fin 3) :
    Twisted.Anisotropy.coordinateDirection i = basisVec i := by
  simp [Twisted.Anisotropy.coordinateDirection, basisVec]

theorem continuous_shiftProd (g : Fin 3 → 𝓢(E3, ℂ)) :
    Continuous (fun p : E3 × E3 => ∏ n, g n (p.1 + p.2 n • basisVec n)) :=
  continuous_finsetProd _ fun n _ => (g n).continuous.comp
    (continuous_fst.add ((continuous_evalCoord n).comp continuous_snd |>.smul continuous_const))

theorem norm_gammaProd_le (g : Fin 3 → 𝓢(E3, ℂ)) {C : Fin 3 → ℝ}
    (hC : ∀ n y, ‖g n y‖ ≤ C n) (x t : E3) :
    ‖∏ n, g n (x + t n • basisVec n)‖ ≤ ∏ n, C n := by
  rw [norm_prod]
  exact Finset.prod_le_prod (fun n _ => norm_nonneg _) fun n _ => hC n _

/-- `Γ_K(f)` is continuous for Schwartz `K`, `f_n` (dominated by `|K| ∏ ‖f_n‖_∞`). -/
theorem continuous_gammaOp (K : 𝓢(E3, ℂ)) (g : Fin 3 → 𝓢(E3, ℂ)) :
    Continuous (gammaOp K fun n => g n) := by
  choose C hC0 hC using fun n => exists_bound_schwartz (g n)
  refine continuous_of_dominated (bound := fun t => ‖K t‖ * ∏ n, C n) (fun x => ?_)
    (fun x => Eventually.of_forall fun t => ?_) (K.integrable.norm.mul_const _)
    (Eventually.of_forall fun t => ?_)
  · exact (K.continuous.mul ((continuous_shiftProd g).comp
      (continuous_const.prodMk continuous_id))).aestronglyMeasurable
  · rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (norm_gammaProd_le g hC x t) (norm_nonneg _)
  · exact continuous_const.mul ((continuous_shiftProd g).comp
      (continuous_id.prodMk continuous_const))

/-- **The kernel side of `thm:main_twist`**: for Schwartz `K`, the pairing of `Γ_K(f)` with
`f_0` is Task 3's multiplier form with multiplier `m = K̂`:
`∫ f_0 Γ_K(f) = Λ_{K̂}(f_0, f_1, f_2, f_3)`. -/
theorem integral_mul_gammaOp (K : 𝓢(E3, ℂ)) (f₀ : 𝓢(E3, ℂ)) (g : Fin 3 → 𝓢(E3, ℂ)) :
    ∫ x : E3, f₀ x * gammaOp K (fun n => g n) x
      = Twisted.multiplierForm (𝓕 (K : E3 → ℂ)) f₀ (g 0) (g 1) (g 2) := by
  set P : 𝓢(E3, ℂ) := Twisted.twistedProduct f₀ (g 0) (g 1) (g 2) with hP
  have hneg : Twisted.schwartzNegate (Twisted.schwartzFourier P) = 𝓕⁻ P := by
    ext ξ
    rw [Twisted.schwartzNegate_apply, SchwartzMap.fourierInv_apply_eq]
    rfl
  rw [Twisted.multiplierForm_eq_integral_negFourier, hneg]
  have h1 : ∫ ξ : E3, 𝓕 (K : E3 → ℂ) ξ * (𝓕⁻ P) ξ = ∫ t : E3, K t * P t := by
    have := SchwartzMap.integral_fourier_mul_eq K (𝓕⁻ P)
    rw [← SchwartzMap.fourier_coe, this, FourierInvPair.fourier_fourierInv_eq]
  rw [h1]
  -- Fubini
  choose C hC0 hC using fun n => exists_bound_schwartz (g n)
  have hint : Integrable (fun p : E3 × E3 => f₀ p.1 * (K p.2 *
      ∏ n, g n (p.1 + p.2 n • basisVec n))) (volume.prod volume) := by
    refine Integrable.mono' ((f₀.integrable.norm.mul_prod K.integrable.norm).mul_const
      (∏ n, C n)) ?_ (Eventually.of_forall fun p => ?_)
    · exact ((f₀.continuous.comp continuous_fst).mul ((K.continuous.comp continuous_snd).mul
        (continuous_shiftProd g))).aestronglyMeasurable
    · simp only [norm_mul]
      rw [mul_assoc]
      exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left (norm_gammaProd_le g hC _ _)
        (norm_nonneg _)) (norm_nonneg _)
  calc ∫ x : E3, f₀ x * gammaOp K (fun n => g n) x
      = ∫ x : E3, ∫ t : E3, f₀ x * (K t * ∏ n, g n (x + t n • basisVec n)) := by
        refine integral_congr_ae (Eventually.of_forall fun x => ?_)
        simp only [gammaOp]
        rw [integral_const_mul]
    _ = ∫ p : E3 × E3, f₀ p.1 * (K p.2 * ∏ n, g n (p.1 + p.2 n • basisVec n))
          ∂(volume.prod volume) := (integral_prod _ hint).symm
    _ = ∫ t : E3, ∫ x : E3, f₀ x * (K t * ∏ n, g n (x + t n • basisVec n)) :=
        integral_prod_symm _ hint
    _ = ∫ t : E3, K t * P t := by
        refine integral_congr_ae (Eventually.of_forall fun t => ?_)
        simp only [hP, Twisted.twistedProduct_apply, coordinateDirection_eq_basisVec]
        rw [← integral_const_mul]
        refine integral_congr_ae (Eventually.of_forall fun x => ?_)
        simp only [Fin.prod_univ_three]
        ring

/-- Translation invariance of `L^p` norms on `ℝ^3`. -/
theorem eLpNorm_comp_add_const {g : E3 → ℂ} (hg : AEStronglyMeasurable g volume) (v : E3)
    (p : ℝ≥0∞) : eLpNorm (fun x => g (x + v)) p volume = eLpNorm g p volume :=
  eLpNorm_comp_measurePreserving hg (measurePreserving_add_right volume v)

/-- `Γ_K(f) ∈ L^p` for Schwartz data, `1 ≤ p < ∞`: by Minkowski's integral inequality,
`‖Γ_K(f)‖_p ≤ ‖K‖_1 ‖f_1‖_p ‖f_2‖_∞ ‖f_3‖_∞`. -/
theorem memLp_gammaOp (K : 𝓢(E3, ℂ)) (g : Fin 3 → 𝓢(E3, ℂ)) {p : ℝ≥0∞} (hp1 : 1 ≤ p)
    (hptop : p ≠ ⊤) : MemLp (gammaOp K fun n => g n) p volume := by
  choose C hC0 hC using fun n => exists_bound_schwartz (g n)
  refine ⟨(continuous_gammaOp K g).aestronglyMeasurable, ?_⟩
  set D : ℝ := C 1 * C 2 with hD
  have hD0 : 0 ≤ D := mul_nonneg (hC0 1) (hC0 2)
  set a : E3 → ℂ := fun t => ((‖K t‖ * D : ℝ) : ℂ) with ha
  set F : E3 → E3 → ℝ≥0∞ := fun t x => ‖a t * g 0 (x + t 0 • basisVec 0)‖ₑ with hF
  have hFm : Measurable (Function.uncurry F) := by
    refine (((Complex.continuous_ofReal.comp ((K.continuous.norm.mul continuous_const))).comp
      continuous_fst).mul ((g 0).continuous.comp (continuous_snd.add
        ((continuous_evalCoord 0).comp continuous_fst |>.smul continuous_const)))).enorm.measurable
  have hpt : ∀ x, ‖gammaOp K (fun n => g n) x‖ₑ ≤ ∫⁻ t, F t x := by
    intro x
    refine (enorm_integral_le_lintegral_enorm _).trans (lintegral_mono fun t => ?_)
    simp only [hF, ha]
    refine enorm_le_iff_norm_le.mpr ?_
    rw [Fin.prod_univ_three, norm_mul, norm_mul, norm_mul, norm_mul,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    have h12 : ‖g 1 (x + t 1 • basisVec 1)‖ * ‖g 2 (x + t 2 • basisVec 2)‖ ≤ D :=
      mul_le_mul (hC 1 _) (hC 2 _) (norm_nonneg _) (hC0 1)
    calc ‖K t‖ * (‖g 0 (x + t 0 • basisVec 0)‖ * ‖g 1 (x + t 1 • basisVec 1)‖
          * ‖g 2 (x + t 2 • basisVec 2)‖)
        = ‖K t‖ * (‖g 0 (x + t 0 • basisVec 0)‖ * (‖g 1 (x + t 1 • basisVec 1)‖
          * ‖g 2 (x + t 2 • basisVec 2)‖)) := by ring
      _ ≤ ‖K t‖ * (‖g 0 (x + t 0 • basisVec 0)‖ * D) := by gcongr
      _ = ‖K t‖ * D * ‖g 0 (x + t 0 • basisVec 0)‖ := by ring
  have hmink := eLpNorm_lintegral_le (μ := (volume : Measure E3)) (ν := (volume : Measure E3))
    hp1 hptop hFm
  have htr : ∀ t, eLpNorm (F t) p volume = ‖a t‖ₑ * eLpNorm (g 0) p volume := by
    intro t
    have e : F t = fun x => ‖(a t • fun y => g 0 (y + t 0 • basisVec 0)) x‖ₑ := by
      funext x; simp only [hF, Pi.smul_apply, smul_eq_mul]
    rw [e, eLpNorm_enorm, eLpNorm_const_smul,
      eLpNorm_comp_add_const (g 0).continuous.aestronglyMeasurable]
  simp_rw [htr] at hmink
  rw [lintegral_mul_const' _ _ ((g 0).memLp p volume).eLpNorm_lt_top.ne] at hmink
  have ha1 : ∫⁻ t, ‖a t‖ₑ ≠ ⊤ := by
    have := ((K.integrable (μ := volume)).norm.mul_const D).2
    simp only [ha, HasFiniteIntegral] at this ⊢
    refine ne_of_lt (lt_of_le_of_lt (le_of_eq ?_) this)
    refine lintegral_congr fun t => ?_
    rw [← ofReal_norm, ← ofReal_norm, Complex.norm_real]
  calc eLpNorm (gammaOp K fun n => g n) p volume
      ≤ eLpNorm (fun x => ∫⁻ t, F t x) p volume :=
        eLpNorm_mono_enorm fun x => by rw [enorm_eq_self]; exact hpt x
    _ ≤ (∫⁻ t, ‖a t‖ₑ) * eLpNorm (g 0) p volume := hmink
    _ < ⊤ := ENNReal.mul_lt_top ha1.lt_top ((g 0).memLp p volume).eLpNorm_lt_top

/-- The anisotropy `α = (1, 2, 3)` of the moment curve. -/
def alpha123 : Twisted.Anisotropy := ⟨fun i => expo i, expo_pos⟩

/-- **`thm:main_twist`** (`blueprints/main.tex`, lines 236-245), from Task 3: for
`p ∈ (1, 4/3)`, `p_n ∈ (1, 4)` with `∑ 1/p_n = 1/p`, there is `C` such that
`‖Γ_K(f)‖_p ≤ C M ∏ ‖f_n‖_{p_n}` for every Schwartz kernel `K` whose multiplier `K̂` satisfies
the anisotropic symbol condition `eq:symbol_condition` with constant `M`
(`Auto.Twisted.Anisotropy.IsAnisotropicMultiplier` for `α = (1,2,3)`) and all Schwartz `f_n`.
The proof is `Auto.Twisted.thm_main` with `p_0 = p' > 4`, by duality against Schwartz functions
(`Auto.Twisted.lpNorm_le_of_schwartz_test_pairing_bound`) and `Auto.integral_mul_gammaOp`. -/
theorem mainTwist {p : ℝ} {pv : Fin 3 → ℝ} (hp : 1 < p) (hp43 : p < 4 / 3)
    (hpv : ∀ n, 1 < pv n ∧ pv n < 4) (hsum : ∑ n, (pv n)⁻¹ = p⁻¹) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (M : ℝ) (K : 𝓢(E3, ℂ)),
      alpha123.IsAnisotropicMultiplier M (𝓕 (K : E3 → ℂ)) →
      ∀ g : Fin 3 → 𝓢(E3, ℂ),
        eLpNorm (gammaOp K fun n => g n) (ENNReal.ofReal p) volume
          ≤ ENNReal.ofReal (C * M) * ∏ n, eLpNorm (g n) (ENNReal.ofReal (pv n)) volume := by
  have hconj := Real.HolderConjugate.conjExponent hp
  set q : Fin 4 → ℝ := ![p.conjExponent, pv 0, pv 1, pv 2] with hq
  have hq0 : 4 < q 0 := by
    simp only [hq, Matrix.cons_val_zero, Real.conjExponent]
    rw [lt_div_iff₀ (by linarith)]; linarith
  have hqsum : ∑ j : Fin 4, (q j)⁻¹ = 1 := by
    rw [Fin.sum_univ_four]
    simp only [hq, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]
    have h1 := hconj.inv_add_inv_eq_one
    rw [Fin.sum_univ_three] at hsum
    linarith
  obtain ⟨C, hC0, hC⟩ := Twisted.thm_main alpha123 q hq0 (hpv 0).1 (hpv 0).2 (hpv 1).1
    (hpv 1).2 (hpv 2).1 (hpv 2).2 hqsum
  refine ⟨C, hC0, fun M K hK g => ?_⟩
  have hM : 0 ≤ M := hK.nonneg
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  have hy := memLp_gammaOp K g hp1 ENNReal.ofReal_ne_top
  set B : ℝ := ∏ n, lpNorm (g n : E3 → ℂ) (ENNReal.ofReal (pv n)) volume with hB
  have hB0 : 0 ≤ B := Finset.prod_nonneg fun n _ => lpNorm_nonneg
  have hbound := Twisted.lpNorm_le_of_schwartz_test_pairing_bound hp (by positivity) hy
    (K := C * M * B) (fun f₀ => ?_)
  · rw [← ofReal_lpNorm hy]
    calc ENNReal.ofReal (lpNorm (gammaOp K fun n => g n) (ENNReal.ofReal p) volume)
        ≤ ENNReal.ofReal (C * M * B) := ENNReal.ofReal_le_ofReal hbound
      _ = ENNReal.ofReal (C * M) * ∏ n, eLpNorm (g n) (ENNReal.ofReal (pv n)) volume := by
        rw [ENNReal.ofReal_mul (by positivity), hB,
          ENNReal.ofReal_prod_of_nonneg fun n _ => lpNorm_nonneg]
        congr 1
        refine Finset.prod_congr rfl fun n _ => ?_
        exact ofReal_lpNorm ((g n).memLp _ _)
  · have e := integral_mul_gammaOp K f₀ g
    have hF := hC M (𝓕 (K : E3 → ℂ)) hK ![f₀, g 0, g 1, g 2]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons] at hF
    rw [Fin.prod_univ_four] at hF
    simp only [hq, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons] at hF
    have e2 : ∫ x : E3, gammaOp K (fun n => g n) x * f₀ x
        = ∫ x : E3, f₀ x * gammaOp K (fun n => g n) x := by
      congr 1; funext x; ring
    rw [e2, e]
    refine hF.trans (le_of_eq ?_)
    rw [hB, Fin.prod_univ_three]
    ring

/-- `∑_{m ≥ 0} ψ_{c-m}(ζ) = φ_c(ζ)` for `ζ ≠ 0`. -/
theorem hasSum_lpPsiJ_Iic {ζ : ℝ} (hζ : ζ ≠ 0) (c : ℤ) :
    HasSum (fun m : ℤ => if m ≤ 0 then lpPsiJ (c + m) ζ else 0) (lpPhiJ c ζ) := by
  have ha : 0 < |ζ| := abs_pos.mpr hζ
  obtain ⟨M, hM⟩ := pow_unbounded_of_one_lt (4 / |ζ| * 2 ^ c) (by norm_num : (1 : ℝ) < 2)
  have hzero : ∀ m ∉ Finset.Icc (-(M : ℤ)) 0,
      (if m ≤ 0 then lpPsiJ (c + m) ζ else 0) = 0 := by
    intro m hm
    split_ifs with h
    · by_contra hne
      obtain ⟨-, h2⟩ := lpPsiJ_support hne
      simp only [Finset.mem_Icc, not_and_or, not_le] at hm
      rcases hm with hm | hm
      · have hle : (2 : ℝ) ^ (c + m + 1) ≤ 2 ^ (c - M) :=
          zpow_le_zpow_right₀ (by norm_num) (by omega)
        have e : (2 : ℝ) ^ (c - (M : ℤ)) = 2 ^ c / 2 ^ M := by
          rw [zpow_sub₀ two_ne_zero, zpow_natCast]
        have hc : (0 : ℝ) < 2 ^ c := zpow_pos two_pos _
        rw [e] at hle
        have h4 : 4 * 2 ^ c < (2 : ℝ) ^ M * |ζ| := by
          have := hM; rw [div_mul_eq_mul_div, div_lt_iff₀ ha] at this; linarith
        have : 2 ^ c / (2 : ℝ) ^ M < |ζ| / 4 := by
          rw [div_lt_div_iff₀ (by positivity) (by norm_num)]; linarith
        linarith
      · omega
    · rfl
  have hsum : HasSum (fun m : ℤ => if m ≤ 0 then lpPsiJ (c + m) ζ else 0) _ :=
    hasSum_sum_of_ne_finset_zero hzero
  convert hsum using 1
  have e1 : ∀ m ∈ Finset.Icc (-(M : ℤ)) 0,
      (if m ≤ 0 then lpPsiJ (c + m) ζ else 0) = lpPhiJ (c + m) ζ - lpPhiJ (c + m - 1) ζ := by
    intro m hm
    rw [if_pos (Finset.mem_Icc.mp hm).2, lpPsiJ_eq]
  rw [Finset.sum_congr rfl e1]
  have h := sum_Icc_sub_telescope (fun m => lpPhiJ (c + m) ζ) (-(M : ℤ)) M
  simp only [neg_add_cancel] at h
  have e2 : ∀ m : ℤ, lpPhiJ (c + (m - 1)) ζ = lpPhiJ (c + m - 1) ζ := fun m => by ring_nf
  simp only [e2] at h
  rw [h, add_zero]
  have hz : lpPhiJ (c + -(M : ℤ) - 1) ζ = 0 := by
    apply lpPhi_eq_zero
    rw [abs_mul, abs_of_pos (zpow_pos two_pos _)]
    have e : -(c + -(M : ℤ) - 1) = (M : ℤ) + 1 - c := by ring
    rw [e, zpow_sub₀ two_ne_zero, zpow_add₀ two_ne_zero, zpow_one, zpow_natCast]
    have hc : (0 : ℝ) < 2 ^ c := zpow_pos two_pos _
    rw [div_mul_eq_mul_div, le_div_iff₀ hc]
    rw [div_mul_eq_mul_div, div_lt_iff₀ ha] at hM
    nlinarith
  rw [hz, sub_zero]

/-- The coordinate multiplier `ξ ↦ φ_c(ξ_ℓ)`. -/
def phiCoord (ℓ : Fin 3) (c : ℤ) (ξ : E3) : ℂ := ((lpPhiJ c (ξ ℓ) : ℝ) : ℂ)

theorem hasTemperateGrowth_phiCoord (ℓ : Fin 3) (c : ℤ) : (phiCoord ℓ c).HasTemperateGrowth :=
  hasTemperateGrowth_coord (hasCompactSupport_lpPhiJ c) (contDiff_lpPhiJ c) ℓ

theorem lpS_apply_eq (ℓ : Fin 3) (c : ℤ) (g : 𝓢(E3, ℂ)) (y : E3) :
    lpS ℓ c g y
      = ∫ ξ : E3, Real.fourierChar (inner ℝ ξ y) • (phiCoord ℓ c ξ * 𝓕 (g : E3 → ℂ) ξ) :=
  fourierMultiplierCLM_apply_eq (hasTemperateGrowth_phiCoord ℓ c) g y

/-- **`∑_{m ≤ c} Δ_m = S_c`** pointwise on Schwartz functions:
`∑_{m ≤ 0} Δ^{(ℓ)}_{c+m} g(y) = S^{(ℓ)}_c g(y)`. -/
theorem hasSum_lpDelta_Iic (ℓ : Fin 3) (c : ℤ) (g : 𝓢(E3, ℂ)) (y : E3) :
    HasSum (fun m : ℤ => if m ≤ 0 then lpDelta ℓ (c + m) g y else 0) (lpS ℓ c g y) := by
  have hb : ∀ ξ : E3, Summable (fun m : ℤ => |lpPsiJ (c + m) (ξ ℓ)| * ‖𝓕 (g : E3 → ℂ) ξ‖) := by
    intro ξ
    have h := (Equiv.addLeft c).summable_iff.mpr (summable_of_sum_le (c := 3 * ‖𝓕 (g : E3 → ℂ) ξ‖)
      (fun m => mul_nonneg (abs_nonneg (lpPsiJ m (ξ ℓ))) (norm_nonneg (𝓕 (g : E3 → ℂ) ξ)))
      fun s => by
        rw [← Finset.sum_mul]
        exact mul_le_mul_of_nonneg_right (sum_abs_lpPsiJ_le s _) (norm_nonneg _))
    simpa only [Function.comp_def, Equiv.coe_addLeft] using h
  have e : (fun m : ℤ => if m ≤ 0 then lpDelta ℓ (c + m) g y else 0) = fun m =>
      ∫ ξ : E3, Real.fourierChar (inner ℝ ξ y) •
        ((if m ≤ 0 then psiCoord ℓ (c + m) ξ else 0) * 𝓕 (g : E3 → ℂ) ξ) := by
    funext m
    split_ifs
    · exact lpDelta_apply_eq ℓ (c + m) g y
    · simp
  rw [e, lpS_apply_eq]
  refine hasSum_integral_of_dominated_convergence
    (fun m ξ => |lpPsiJ (c + m) (ξ ℓ)| * ‖𝓕 (g : E3 → ℂ) ξ‖) (fun m => ?_) (fun m => ?_)
    (Eventually.of_forall hb) ?_ ?_
  · refine (Real.continuous_fourierChar.comp
      (continuous_id.inner continuous_const)).aestronglyMeasurable.smul ?_
    split_ifs
    · exact (Complex.continuous_ofReal.comp ((continuous_lpPsiJ _).comp
        (continuous_evalCoord ℓ))).aestronglyMeasurable.mul (𝓕 g).integrable.aestronglyMeasurable
    · simp only [zero_mul]; exact aestronglyMeasurable_const
  · refine Eventually.of_forall fun ξ => ?_
    rw [Circle.smul_def, smul_eq_mul, norm_mul, Circle.norm_coe, one_mul, norm_mul]
    split_ifs
    · rw [psiCoord, Complex.norm_real, Real.norm_eq_abs]
    · simp only [norm_zero, zero_mul]; positivity
  · refine Integrable.mono' ((𝓕 g).integrable.norm.const_mul 3) ?_
      (Eventually.of_forall fun ξ => ?_)
    · have e : (fun ξ : E3 => ∑' m : ℤ, |lpPsiJ (c + m) (ξ ℓ)| * ‖𝓕 (g : E3 → ℂ) ξ‖)
          = fun ξ => ((∑' m : ℤ, (|lpPsiJ (c + m) (ξ ℓ)| * ‖𝓕 (g : E3 → ℂ) ξ‖).toNNReal
              : NNReal) : ℝ) := by
        funext ξ
        rw [NNReal.coe_tsum]
        congr 1; funext m
        rw [Real.coe_toNNReal _ (mul_nonneg (abs_nonneg _) (norm_nonneg _))]
      rw [e]
      refine (Measurable.nnreal_tsum fun m => ?_).coe_nnreal_real.aestronglyMeasurable
      exact ((((continuous_lpPsiJ _).comp (continuous_evalCoord ℓ)).abs.measurable.mul
        (SchwartzMap.continuous (𝓕 g)).norm.measurable)).real_toNNReal
    · rw [Real.norm_eq_abs, abs_of_nonneg (tsum_nonneg fun m =>
        mul_nonneg (abs_nonneg _) (norm_nonneg _))]
      refine tsum_le_of_sum_le' (by positivity) fun s => ?_
      rw [← Finset.sum_mul, ← SchwartzMap.fourier_coe]
      refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
      have := sum_abs_lpPsiJ_le (s.map (Equiv.addLeft c).toEmbedding) (ξ ℓ)
      simpa [Finset.sum_map] using this
  · have hae : ∀ᵐ ξ : E3 ∂volume, ξ ℓ ≠ 0 := by
      rw [ae_iff]; simpa using volume_coord_eq_zero ℓ
    filter_upwards [hae] with ξ hξ
    have h' : HasSum (fun m => if m ≤ 0 then psiCoord ℓ (c + m) ξ else 0) (phiCoord ℓ c ξ) := by
      have := Complex.ofRealCLM.hasSum (hasSum_lpPsiJ_Iic hξ c)
      convert this using 1
      · funext m; split_ifs <;> simp [psiCoord]
      · simp [phiCoord]
    simpa using (h'.mul_right (𝓕 (g : E3 → ℂ) ξ)).const_smul (Real.fourierChar (inner ℝ ξ y))

theorem prod_ite_three {A : Fin 3 → ℤ → Prop} [∀ n, DecidablePred (A n)] (b : Fin 3 → ℤ → ℂ)
    (k : Fin 3 → ℤ) :
    ∏ n, (if A n (k n) then b n (k n) else 0)
      = if (∀ n, A n (k n)) then ∏ n, b n (k n) else 0 := by
  by_cases h : ∀ n, A n (k n)
  · rw [if_pos h]; exact Finset.prod_congr rfl fun n _ => if_pos (h n)
  · rw [if_neg h]
    push Not at h
    obtain ⟨n, hn⟩ := h
    exact Finset.prod_eq_zero (Finset.mem_univ n) (if_neg hn)

/-- **Masked frequency expansion of a single scale.**  If, for each coordinate `n`, the
Littlewood-Paley pieces `Δ^{(n)}_{(n+1)j+m} f_n` summed over `m ∈ A_n` give `G_n`, then the
pieces `T_j(Δ^{(1)}_{j+k_1} f_1, ...)` summed over `k ∈ A_1 × A_2 × A_3` give `T_j(G)`. -/
theorem hasSum_piece_mask (j : ℤ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) (A : Fin 3 → ℤ → Prop)
    [∀ n, DecidablePred (A n)] (G : Fin 3 → 𝓢(E3, ℂ))
    (hG : ∀ n y, HasSum (fun m => if A n m then lpDelta n ((expo n : ℤ) * j + m) (f n) y
      else 0) (G n y)) :
    HasSum (fun k => if (∀ n, A n (k n)) then freqPiece j k f x else 0)
      (simplexTj j (fun n => G n) x) := by
  set w : ℝ → ℂ := fun t => (lpPsi ((2 : ℝ) ^ j * t) : ℂ) / t with hw
  have hwi : Integrable w := integrable_psi_div j
  set c : Fin 3 → ℤ → ℝ := fun n m => deltaMajor n ((expo n : ℤ) * j + m) (f n) with hc
  have hcs : ∀ n, Summable (c n) := fun n =>
    (Equiv.addLeft ((expo n : ℤ) * j)).summable_iff.mpr (summable_deltaMajor n (f n))
  have hcn : ∀ n, Summable fun m => ‖(c n m : ℂ)‖ := fun n => by
    simpa [Complex.norm_real, Real.norm_eq_abs] using (hcs n).abs
  have hC := (hasSum_prod_three (a := fun n m => ((c n m : ℝ) : ℂ))
    (fun n => Complex.hasSum_ofReal.mpr (hcs n).hasSum) hcn).2
  have hCs : Summable (fun k : Fin 3 → ℤ => ∏ n, c n (k n)) := by
    refine hC.congr fun k => ?_
    refine Finset.prod_congr rfl fun n _ => ?_
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (deltaMajor_nonneg _ _ _)]
  set b : Fin 3 → ℤ → ℝ → ℂ := fun n m t =>
    if A n m then lpDelta n ((expo n : ℤ) * j + m) (f n) (x + curve n t) else 0 with hb
  set F : (Fin 3 → ℤ) → ℝ → ℂ := fun k t => w t * ∏ n, b n (k n) t with hF
  have hpiece : ∀ k, (if (∀ n, A n (k n)) then freqPiece j k f x else 0) = ∫ t, F k t := by
    intro k
    by_cases hk : ∀ n, A n (k n)
    · rw [if_pos hk]
      unfold freqPiece simplexTj
      refine integral_congr_ae (Eventually.of_forall fun t => ?_)
      simp only [hF, hw, hb, prodShift, if_pos (hk _)]
      ring
    · rw [if_neg hk]
      symm
      refine integral_eq_zero_of_ae (Eventually.of_forall fun t => ?_)
      simp only [hF, hb]
      rw [prod_ite_three (fun n m => lpDelta n ((expo n : ℤ) * j + m) (f n) (x + curve n t)) k,
        if_neg hk, mul_zero, Pi.zero_apply]
  have htot : simplexTj j (fun n => G n) x = ∫ t, w t * ∏ n, G n (x + curve n t) := by
    unfold simplexTj
    refine integral_congr_ae (Eventually.of_forall fun t => ?_)
    simp only [hw, prodShift]
    ring
  have hpt : ∀ t, HasSum (fun k : Fin 3 → ℤ => ∏ n, b n (k n) t) (∏ n, G n (x + curve n t)) := by
    intro t
    have h2 : ∀ n : Fin 3, Summable (fun m : ℤ => ‖b n m t‖) := fun n =>
      Summable.of_nonneg_of_le (fun m => norm_nonneg _)
        (fun m => by
          simp only [hb]; split_ifs
          · exact norm_lpDelta_le n _ (f n) _
          · rw [norm_zero]; exact deltaMajor_nonneg _ _ _) (hcs n)
    exact (hasSum_prod_three (a := fun n m => b n m t) (s := fun n => G n (x + curve n t))
      (fun n => hG n _) h2).1
  have hbound : ∀ k t, ‖F k t‖ ≤ ‖w t‖ * ∏ n, c n (k n) := by
    intro k t
    rw [hF, norm_mul, norm_prod]
    refine mul_le_mul_of_nonneg_left (Finset.prod_le_prod (fun n _ => norm_nonneg _)
      fun n _ => ?_) (norm_nonneg _)
    simp only [hb]; split_ifs
    · exact norm_lpDelta_le n _ (f n) _
    · rw [norm_zero]; exact deltaMajor_nonneg _ _ _
  have hmeas : ∀ k, AEStronglyMeasurable (F k) volume := by
    intro k
    refine hwi.aestronglyMeasurable.mul ?_
    refine (continuous_finsetProd _ fun n _ => ?_).aestronglyMeasurable
    simp only [hb]; split_ifs
    · exact (SchwartzMap.continuous _).comp (continuous_const.add (continuous_curve n))
    · exact continuous_const
  simp_rw [hpiece]
  rw [htot]
  refine hasSum_integral_of_dominated_convergence (fun k t => ‖w t‖ * ∏ n, c n (k n))
    hmeas (fun k => Eventually.of_forall (hbound k)) (Eventually.of_forall fun t =>
      hCs.mul_left _) ?_ (Eventually.of_forall fun t => (hpt t).mul_left (w t))
  simp_rw [tsum_mul_left]
  exact hwi.norm.mul_const _

theorem regL_iff (k : Fin 3 → ℤ) : RegL k ↔ ∀ n, k n ≤ 0 := by
  unfold RegL kMax
  constructor
  · intro h n; fin_cases n <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk] <;> omega
  · intro h; have := h 0; have := h 1; have := h 2; omega

/-- **The low-frequency component**, line 356:
`T^L_J(f) = ∑_{|j| ≤ J} T_j(S^{(1)}_j f_1, S^{(2)}_{2j} f_2, S^{(3)}_{3j} f_3)`. -/
theorem regComp_L_eq (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    regComp RegL J f x = ∑ j ∈ Finset.Icc (-(J : ℤ)) J,
      simplexTj j (fun n => lpS n ((expo n : ℤ) * j) (f n)) x := by
  unfold regComp
  refine Finset.sum_congr rfl fun j _ => ?_
  have h := hasSum_piece_mask j f x (fun _ m => m ≤ 0) (fun n => lpS n ((expo n : ℤ) * j) (f n))
    (fun n y => hasSum_lpDelta_Iic n _ (f n) y)
  rw [← h.tsum_eq]
  congr 1; funext k
  simp only [regL_iff]

/-- Pointwise Fourier inversion for Schwartz functions on `ℝ^3`. -/
theorem schwartz_inversion_apply (g : 𝓢(E3, ℂ)) (z : E3) :
    g z = ∫ ξ : E3, Real.fourierChar (inner ℝ ξ z) • 𝓕 (g : E3 → ℂ) ξ := by
  have h := congrArg (fun F : 𝓢(E3, ℂ) => F z)
    (FourierPair.fourierInv_fourier_eq (E := 𝓢(E3, ℂ)) (F := 𝓢(E3, ℂ)) g)
  rw [← h, SchwartzMap.fourierInv_coe, Real.fourierInv_eq, SchwartzMap.fourier_coe]

theorem contDiff_lpPhiJ_complex (c : ℤ) :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun ζ : ℝ => ((lpPhiJ c ζ : ℝ) : ℂ)) :=
  Complex.ofRealCLM.contDiff.comp (contDiff_lpPhiJ c)

theorem hasCompactSupport_lpPhiJ_complex (c : ℤ) :
    HasCompactSupport (fun ζ : ℝ => ((lpPhiJ c ζ : ℝ) : ℂ)) :=
  (hasCompactSupport_lpPhiJ c).comp_left Complex.ofReal_zero

/-- `φ_c` as a Schwartz function on `ℝ`. -/
def phiS (c : ℤ) : 𝓢(ℝ, ℂ) :=
  (hasCompactSupport_lpPhiJ_complex c).toSchwartzMap (contDiff_lpPhiJ_complex c)

/-- `φ̌_c = 𝓕^{-1} φ_c`, the kernel of `S_c` along a line. -/
def phiCheck (c : ℤ) : 𝓢(ℝ, ℂ) := 𝓕⁻ (phiS c)

theorem lpPhiJ_eq_fourier_phiCheck (c : ℤ) (ζ : ℝ) :
    ((lpPhiJ c ζ : ℝ) : ℂ) = ∫ u : ℝ, Real.fourierChar (-(u * ζ)) • phiCheck c u := by
  have h := congrArg (fun F : 𝓢(ℝ, ℂ) => F ζ)
    (FourierInvPair.fourier_fourierInv_eq (E := 𝓢(ℝ, ℂ)) (F := 𝓢(ℝ, ℂ)) (phiS c))
  rw [SchwartzMap.fourier_coe, Real.fourier_eq] at h
  have h2 : (phiS c) ζ = ((lpPhiJ c ζ : ℝ) : ℂ) := rfl
  rw [← h2, ← h]
  congr 1; funext v
  simp only [phiCheck, RCLike.inner_apply, conj_trivial]
  rw [mul_comm]

/-- **`S^{(ℓ)}_c` is a convolution along the line `ℝ e_ℓ`**:
`S^{(ℓ)}_c g(y) = ∫ φ̌_c(u) g(y - u e_ℓ) du` (the partial convolution `g *_ℓ φ̌_c` of line 356). -/
theorem lpS_eq_lineConv (ℓ : Fin 3) (c : ℤ) (g : 𝓢(E3, ℂ)) (y : E3) :
    lpS ℓ c g y = ∫ u : ℝ, phiCheck c u * g (y - u • basisVec ℓ) := by
  rw [lpS_apply_eq]
  set G : E3 × ℝ → ℂ := fun p => (Real.fourierChar (inner ℝ p.1 y) : ℂ) *
      ((Real.fourierChar (-(p.2 * p.1 ℓ)) : ℂ) * phiCheck c p.2 * 𝓕 (g : E3 → ℂ) p.1) with hG
  have hint : Integrable G (volume.prod volume) := by
    refine Integrable.mono' (((𝓕 g).integrable.norm.mul_prod
      (phiCheck c).integrable.norm)) ?_ (Eventually.of_forall fun p => ?_)
    · have h4 : Continuous fun p : E3 × ℝ => 𝓕 (g : E3 → ℂ) p.1 := by
        rw [← SchwartzMap.fourier_coe]; exact (𝓕 g).continuous.comp continuous_fst
      refine (Continuous.aestronglyMeasurable ?_)
      exact (continuous_subtype_val.comp (Real.continuous_fourierChar.comp
        (continuous_fst.inner continuous_const))).mul
        (((continuous_subtype_val.comp (Real.continuous_fourierChar.comp
          (continuous_snd.mul ((continuous_evalCoord ℓ).comp continuous_fst)).neg)).mul
          ((phiCheck c).continuous.comp continuous_snd)).mul h4)
    · simp only [hG, norm_mul, Circle.norm_coe, one_mul, ← SchwartzMap.fourier_coe]
      exact le_of_eq (mul_comm _ _)
  have e1 : (fun ξ : E3 => Real.fourierChar (inner ℝ ξ y) • (phiCoord ℓ c ξ * 𝓕 (g : E3 → ℂ) ξ))
      = fun ξ => ∫ u : ℝ, G (ξ, u) := by
    funext ξ
    rw [phiCoord, lpPhiJ_eq_fourier_phiCheck, ← integral_mul_const, Circle.smul_def,
      smul_eq_mul, ← integral_const_mul]
    refine integral_congr_ae (Eventually.of_forall fun u => ?_)
    simp only [hG, Circle.smul_def, smul_eq_mul]
  rw [e1, integral_integral_swap hint]
  refine integral_congr_ae (Eventually.of_forall fun u => ?_)
  simp only
  rw [schwartz_inversion_apply g (y - u • basisVec ℓ), ← integral_const_mul]
  refine integral_congr_ae (Eventually.of_forall fun ξ => ?_)
  simp only [hG, Circle.smul_def, smul_eq_mul]
  have hin : inner ℝ ξ (y - u • basisVec ℓ) = inner ℝ ξ y + -(u * ξ ℓ) := by
    rw [inner_sub_right, inner_smul_right, basisVec, EuclideanSpace.inner_single_right]
    simp; ring
  rw [hin, AddChar.map_add_eq_mul, Circle.coe_mul]
  ring

/-- The two-sided geometric weights `2^{-|i|}` are summable with sum `3`. -/
theorem hasSum_two_pow_neg_natAbs :
    HasSum (fun i : ℤ => ((1 : ℝ) / 2) ^ i.natAbs) 3 := by
  have h1 : HasSum (fun n : ℕ => ((1 : ℝ) / 2) ^ ((n : ℤ).natAbs)) 2 := by
    simpa using hasSum_geometric_two
  have h2 : HasSum (fun n : ℕ => ((1 : ℝ) / 2) ^ ((-((n : ℤ) + 1)).natAbs)) 1 := by
    have : (fun n : ℕ => ((1 : ℝ) / 2) ^ ((-((n : ℤ) + 1)).natAbs))
        = fun n : ℕ => (1 / 2) * ((1 : ℝ) / 2) ^ n := by
      funext n
      have : (-((n : ℤ) + 1)).natAbs = n + 1 := by omega
      rw [this, pow_succ]; ring
    rw [this]
    simpa using (hasSum_geometric_two.mul_left (1 / 2 : ℝ))
  have := HasSum.int_rec h1 h2
  convert this using 1
  · funext i
    rcases i with n | n
    · rfl
    · simp [Int.negSucc_eq]
  · norm_num

theorem summable_two_pow_neg_natAbs :
    Summable (fun i : ℤ => ((1 : ℝ) / 2) ^ i.natAbs) := hasSum_two_pow_neg_natAbs.summable

/-- **The dyadic scalar estimate**: for `ρ > 0` and any finite set `s` of scales,
`∑_{j ∈ s} min(2^{-j} ρ, (2^{-j} ρ)^{-1}) ≤ 6`. -/
theorem sum_min_dyadic_le {ρ : ℝ} (hρ : 0 < ρ) (s : Finset ℤ) :
    ∑ j ∈ s, min ((2 : ℝ) ^ (-j) * ρ) ((2 : ℝ) ^ (-j) * ρ)⁻¹ ≤ 6 := by
  set m : ℤ := Int.log 2 ρ with hm
  have hlo : (2 : ℝ) ^ m ≤ ρ := by
    have := Int.zpow_log_le_self (b := 2) (by norm_num) hρ; exact_mod_cast this
  have hhi : ρ < (2 : ℝ) ^ (m + 1) := by
    have := Int.lt_zpow_succ_log_self (b := 2) (by norm_num) ρ; exact_mod_cast this
  have hterm : ∀ j : ℤ, min ((2 : ℝ) ^ (-j) * ρ) ((2 : ℝ) ^ (-j) * ρ)⁻¹
      ≤ 2 * ((1 : ℝ) / 2) ^ (j - m).natAbs := by
    intro j
    have hq : (0 : ℝ) < 2 ^ (-j) := zpow_pos two_pos _
    by_cases hj : j ≤ m
    · -- `x_j ≥ 2^{m-j} ≥ 1`, use `1/x_j ≤ 2^{j-m}`
      refine (min_le_right _ _).trans ?_
      have hx : (2 : ℝ) ^ (m - j) ≤ 2 ^ (-j) * ρ := by
        rw [show m - j = -j + m by ring, zpow_add₀ two_ne_zero]
        exact mul_le_mul_of_nonneg_left hlo hq.le
      have hpos : (0 : ℝ) < 2 ^ (m - j) := zpow_pos two_pos _
      have e : ((1 : ℝ) / 2) ^ (j - m).natAbs = ((2 : ℝ) ^ (m - j))⁻¹ := by
        have : (j - m).natAbs = ((m - j).toNat) := by omega
        rw [this, one_div, inv_pow, ← zpow_natCast, Int.toNat_of_nonneg (by omega)]
      rw [e]
      have := inv_anti₀ hpos hx
      linarith [inv_pos.mpr hpos]
    · -- `x_j < 2^{m+1-j}`
      push Not at hj
      refine (min_le_left _ _).trans ?_
      have hx : (2 : ℝ) ^ (-j) * ρ ≤ 2 ^ (m + 1 - j) := by
        rw [show m + 1 - j = -j + (m + 1) by ring, zpow_add₀ two_ne_zero]
        exact mul_le_mul_of_nonneg_left hhi.le hq.le
      have e : 2 * ((1 : ℝ) / 2) ^ (j - m).natAbs = (2 : ℝ) ^ (m + 1 - j) := by
        have : (j - m).natAbs = ((j - m).toNat) := by omega
        rw [this, one_div, inv_pow, ← zpow_natCast, Int.toNat_of_nonneg (by omega), ← zpow_neg,
          show m + 1 - j = 1 + -(j - m) by ring, zpow_add₀ two_ne_zero, zpow_one]
      rw [e]; exact hx
  calc ∑ j ∈ s, min ((2 : ℝ) ^ (-j) * ρ) ((2 : ℝ) ^ (-j) * ρ)⁻¹
      ≤ ∑ j ∈ s, 2 * ((1 : ℝ) / 2) ^ (j - m).natAbs := Finset.sum_le_sum fun j _ => hterm j
    _ = 2 * ∑ i ∈ s.map (Equiv.subRight m).toEmbedding, ((1 : ℝ) / 2) ^ i.natAbs := by
        rw [Finset.mul_sum, Finset.sum_map]; rfl
    _ ≤ 2 * 3 := by
        gcongr
        rw [← hasSum_two_pow_neg_natAbs.tsum_eq]
        exact summable_two_pow_neg_natAbs.sum_le_tsum _ fun i _ => by positivity
    _ = 6 := by norm_num

open Twisted in
/-- The anisotropic dilation `D_a ξ = (a ξ_1, a^2 ξ_2, a^3 ξ_3)` as a continuous linear map. -/
def dilCLM (a : ℝ) : E3 →L[ℝ] E3 := LinearMap.toContinuousLinearMap (alpha123.dilateLinear a)

theorem dilCLM_apply (a : ℝ) (ξ : E3) : dilCLM a ξ = alpha123.dilate a ξ := by
  simp [dilCLM, Twisted.Anisotropy.dilateLinear_apply]

theorem dilate_coordinateDirection (a : ℝ) (i : Fin 3) :
    alpha123.dilate a (Twisted.Anisotropy.coordinateDirection i)
      = (a ^ alpha123.weight i) • Twisted.Anisotropy.coordinateDirection i := by
  rw [coordinateDirection_eq_basisVec]
  ext l
  simp only [Twisted.Anisotropy.dilate, PiLp.toLp_apply, PiLp.smul_apply, smul_eq_mul, basisVec,
    PiLp.single_apply]
  split_ifs with h
  · subst h; ring
  · ring

theorem radius_zero : alpha123.radius 0 = 0 := by
  simp only [Twisted.Anisotropy.radius, PiLp.zero_apply, abs_zero]
  refine Finset.sum_eq_zero fun i _ => Real.zero_rpow ?_
  have := alpha123.weight_pos i
  positivity

theorem norm_coordinateDirection (i : Fin 3) :
    ‖Twisted.Anisotropy.coordinateDirection i‖ = 1 := by
  simp [Twisted.Anisotropy.coordinateDirection]

theorem alpha123_weight_le (i : Fin 3) : alpha123.weight i ≤ 3 := by
  change expo i ≤ 3; unfold expo; omega

theorem alpha123_weight_pos (i : Fin 3) : 1 ≤ alpha123.weight i := alpha123.weight_pos i

theorem natCast_le_smooth (k : ℕ) : (k : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) :=
  WithTop.coe_le_coe.mpr le_top

/-- The dyadic sum `m_J(ξ) = ∑_{|j| ≤ J} κ(D_{2^{-j}} ξ)`. -/
def dyadicSum (κ : E3 → ℂ) (J : ℕ) (ξ : E3) : ℂ :=
  ∑ j ∈ Finset.Icc (-(J : ℤ)) J, κ (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ)

/-- The elementary per-scale estimate: with `x = ρ(D_a ξ)` and `1 ≤ w ≤ 330`,
`x^w d ≤ B min(x, 1/x)` whenever `d ≤ B` and `d x^{331} ≤ B`. -/
theorem pow_mul_le_min {x d B : ℝ} (hx : 0 < x) (hd : 0 ≤ d) {w : ℕ} (hw1 : 1 ≤ w)
    (hw2 : w ≤ 330) (h1 : d ≤ B) (h2 : d * x ^ 331 ≤ B) :
    x ^ w * d ≤ B * min x x⁻¹ := by
  by_cases hx1 : x ≤ 1
  · have hxw : x ^ w ≤ x := by
      calc x ^ w ≤ x ^ 1 := pow_le_pow_of_le_one hx.le hx1 hw1
        _ = x := pow_one x
    have hmin : min x x⁻¹ = x := min_eq_left (by
      rw [le_inv_comm₀ hx hx]; exact le_trans hx1 (one_le_inv_iff₀.mpr ⟨hx, hx1⟩))
    rw [hmin]
    calc x ^ w * d ≤ x * B := mul_le_mul hxw h1 hd hx.le
      _ = B * x := mul_comm _ _
  · push Not at hx1
    have hmin : min x x⁻¹ = x⁻¹ := min_eq_right (by
      exact le_trans (inv_le_one_of_one_le₀ hx1.le) hx1.le)
    rw [hmin]
    have hpow : x * x ^ w ≤ x ^ 331 := by
      rw [← pow_succ']
      exact pow_le_pow_right₀ hx1.le (by omega)
    have hx331 : 0 < x ^ 331 := by positivity
    rw [← div_eq_mul_inv, le_div_iff₀ hx]
    calc x ^ w * d * x = d * (x * x ^ w) := by ring
      _ ≤ d * x ^ 331 := mul_le_mul_of_nonneg_left hpow hd
      _ ≤ B := h2

/-- The derivative of `κ ∘ D_a` in coordinate directions: `a^{wt σ}` times the derivative
of `κ` at `D_a ξ`. -/
theorem iteratedFDeriv_comp_dilate {κ : E3 → ℂ} (hκ : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) κ)
    (a : ℝ) (k : ℕ) (ξ : E3) (σ : Fin k → Fin 3) :
    iteratedFDeriv ℝ k (fun η => κ (alpha123.dilate a η)) ξ
        (fun r => Twisted.Anisotropy.coordinateDirection (σ r))
      = (a ^ alpha123.derivativeWeight σ) •
          iteratedFDeriv ℝ k κ (alpha123.dilate a ξ)
            (fun r => Twisted.Anisotropy.coordinateDirection (σ r)) := by
  have e : (fun η => κ (alpha123.dilate a η)) = κ ∘ dilCLM a := by
    funext η; simp [dilCLM_apply]
  rw [e, (dilCLM a).iteratedFDeriv_comp_right hκ ξ (natCast_le_smooth k)]
  simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply, dilCLM_apply,
    dilate_coordinateDirection]
  rw [ContinuousMultilinearMap.map_smul_univ, Twisted.Anisotropy.derivativeWeight,
    Finset.prod_pow_eq_pow_sum]

theorem derivativeWeight_bounds {k : ℕ} (σ : Fin k → Fin 3) :
    k ≤ alpha123.derivativeWeight σ ∧ alpha123.derivativeWeight σ ≤ 3 * k := by
  unfold Twisted.Anisotropy.derivativeWeight
  constructor
  · calc k = ∑ _r : Fin k, 1 := by simp
      _ ≤ ∑ r, alpha123.weight (σ r) := Finset.sum_le_sum fun r _ => alpha123_weight_pos _
  · calc ∑ r, alpha123.weight (σ r) ≤ ∑ _r : Fin k, 3 :=
          Finset.sum_le_sum fun r _ => alpha123_weight_le _
      _ = 3 * k := by simp [mul_comm]

/-- **The dyadic symbol lemma** (the step "`κ̂(0) = 0` and `κ` Schwartz, therefore `K̂` satisfies
`eq:symbol_condition`", lines 370-374 and 420-421): if `κ` is smooth with
`|κ(η)| ≤ B min(ρ(η), 1/ρ(η))` and `‖D^k κ(η)‖ ≤ B min(1, ρ(η)^{-331})` for `1 ≤ k ≤ 110`, then
every truncated dyadic sum `∑_{|j| ≤ J} κ(D_{2^{-j}} ξ)` is an anisotropic multiplier with
constant `6B`, uniformly in `J`. -/
theorem dyadicSum_isAnisotropicMultiplier {κ : E3 → ℂ}
    (hκ : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) κ) {B : ℝ} (hB : 0 ≤ B)
    (h0a : ∀ η, ‖κ η‖ ≤ B * alpha123.radius η) (h0b : ∀ η, ‖κ η‖ * alpha123.radius η ≤ B)
    (hka : ∀ k, 1 ≤ k → k ≤ 110 → ∀ η, ‖iteratedFDeriv ℝ k κ η‖ ≤ B)
    (hkb : ∀ k, 1 ≤ k → k ≤ 110 → ∀ η, ‖iteratedFDeriv ℝ k κ η‖ * alpha123.radius η ^ 331 ≤ B)
    (J : ℕ) : alpha123.IsAnisotropicMultiplier (6 * B) (dyadicSum κ J) := by
  have hterm : ∀ j : ℤ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞)
      (fun η => κ (alpha123.dilate ((2 : ℝ) ^ (-j)) η)) := by
    intro j
    have e : (fun η => κ (alpha123.dilate ((2 : ℝ) ^ (-j)) η)) = κ ∘ dilCLM ((2 : ℝ) ^ (-j)) := by
      funext η; simp [dilCLM_apply]
    rw [e]; exact hκ.comp (dilCLM _).contDiff
  have hsmooth : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (dyadicSum κ J) := by
    unfold dyadicSum
    exact ContDiff.sum fun j _ => hterm j
  have hrad : ∀ (j : ℤ) (ξ : E3), alpha123.radius (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ)
      = (2 : ℝ) ^ (-j) * alpha123.radius ξ := fun j ξ =>
    alpha123.radius_dilate (zpow_pos two_pos _) ξ
  refine ⟨by positivity, hsmooth.continuous.measurable, ?_, ?_, ?_⟩
  · unfold dyadicSum
    refine Finset.sum_eq_zero fun j _ => ?_
    have := h0a 0
    rw [radius_zero, mul_zero] at this
    have h0 : alpha123.dilate ((2 : ℝ) ^ (-j)) 0 = 0 := by
      ext i; simp [Twisted.Anisotropy.dilate]
    rw [h0]
    exact norm_le_zero_iff.mp this
  · exact (hsmooth.of_le (natCast_le_smooth 110)).contDiffOn
  · intro k hk ξ hξ σ
    have hρ : 0 < alpha123.radius ξ := Twisted.radius_pos_of_ne_zero alpha123 hξ
    set ρ := alpha123.radius ξ with hρdef
    set w := alpha123.derivativeWeight σ with hw
    obtain ⟨hw1, hw2⟩ := derivativeWeight_bounds σ
    have hsum := sum_min_dyadic_le hρ (Finset.Icc (-(J : ℤ)) J)
    rcases Nat.eq_zero_or_pos k with rfl | hk1
    · -- order zero
      have hw0 : w = 0 := by
        rw [hw, Twisted.Anisotropy.derivativeWeight]; simp
      rw [iteratedFDeriv_zero_apply, hw0]
      simp only [Nat.cast_zero, neg_zero, Real.rpow_zero, mul_one]
      unfold dyadicSum
      refine (norm_sum_le _ _).trans ?_
      calc ∑ j ∈ Finset.Icc (-(J : ℤ)) J, ‖κ (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ)‖
          ≤ ∑ j ∈ Finset.Icc (-(J : ℤ)) J,
              B * min ((2 : ℝ) ^ (-j) * ρ) ((2 : ℝ) ^ (-j) * ρ)⁻¹ := by
            refine Finset.sum_le_sum fun j _ => ?_
            have hx : 0 < (2 : ℝ) ^ (-j) * ρ := mul_pos (zpow_pos two_pos _) hρ
            have ha := h0a (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ)
            have hb := h0b (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ)
            rw [hrad] at ha hb
            rw [mul_min_of_nonneg _ _ hB]
            refine le_min ha ?_
            rw [← div_eq_mul_inv, le_div_iff₀ hx]; exact hb
        _ = B * ∑ j ∈ Finset.Icc (-(J : ℤ)) J,
              min ((2 : ℝ) ^ (-j) * ρ) ((2 : ℝ) ^ (-j) * ρ)⁻¹ := by rw [Finset.mul_sum]
        _ ≤ B * 6 := mul_le_mul_of_nonneg_left hsum hB
        _ = 6 * B := by ring
    · -- positive order
      have hw1' : 1 ≤ w := le_trans hk1 hw1
      have hw2' : w ≤ 330 := by omega
      have hfun : dyadicSum κ J = fun η => ∑ j ∈ Finset.Icc (-(J : ℤ)) J,
          κ (alpha123.dilate ((2 : ℝ) ^ (-j)) η) := rfl
      rw [hfun, iteratedFDeriv_sum fun j _ => (hterm j).of_le (natCast_le_smooth k)]
      rw [Finset.sum_apply, ContinuousMultilinearMap.sum_apply]
      refine (norm_sum_le _ _).trans ?_
      have hper : ∀ j ∈ Finset.Icc (-(J : ℤ)) J,
          ‖iteratedFDeriv ℝ k (fun η => κ (alpha123.dilate ((2 : ℝ) ^ (-j)) η)) ξ
            (fun r => Twisted.Anisotropy.coordinateDirection (σ r))‖
          ≤ B * min ((2 : ℝ) ^ (-j) * ρ) ((2 : ℝ) ^ (-j) * ρ)⁻¹ * ρ ^ (-(w : ℝ)) := by
        intro j _
        have hq : (0 : ℝ) < 2 ^ (-j) := zpow_pos two_pos _
        have hx : 0 < (2 : ℝ) ^ (-j) * ρ := mul_pos hq hρ
        rw [iteratedFDeriv_comp_dilate hκ, norm_smul, Real.norm_eq_abs,
          abs_of_pos (pow_pos hq _)]
        set η := alpha123.dilate ((2 : ℝ) ^ (-j)) ξ
        have hle : ‖iteratedFDeriv ℝ k κ η
            (fun r => Twisted.Anisotropy.coordinateDirection (σ r))‖
            ≤ ‖iteratedFDeriv ℝ k κ η‖ := by
          refine ((iteratedFDeriv ℝ k κ η).le_opNorm _).trans (le_of_eq ?_)
          simp [norm_coordinateDirection]
        have hd0 := norm_nonneg (iteratedFDeriv ℝ k κ η
            (fun r => Twisted.Anisotropy.coordinateDirection (σ r)))
        have h1 := (hle.trans (hka k hk1 hk η))
        have h2 : ‖iteratedFDeriv ℝ k κ η
            (fun r => Twisted.Anisotropy.coordinateDirection (σ r))‖
              * ((2 : ℝ) ^ (-j) * ρ) ^ 331 ≤ B := by
          rw [← hrad]
          exact (mul_le_mul_of_nonneg_right hle (pow_nonneg (by rw [hrad]; positivity) _)).trans
            (hkb k hk1 hk η)
        have key := pow_mul_le_min hx hd0 hw1' hw2' h1 h2
        have hρw : ρ ^ (-(w : ℝ)) = (ρ ^ w)⁻¹ := by
          rw [Real.rpow_neg hρ.le, Real.rpow_natCast]
        rw [← hw, hρw]
        have e : ((2 : ℝ) ^ (-j)) ^ w * ‖iteratedFDeriv ℝ k κ η
            (fun r => Twisted.Anisotropy.coordinateDirection (σ r))‖
            = ((2 ^ (-j) * ρ) ^ w * ‖iteratedFDeriv ℝ k κ η
              (fun r => Twisted.Anisotropy.coordinateDirection (σ r))‖) * (ρ ^ w)⁻¹ := by
          rw [mul_pow]; field_simp
        rw [e]
        exact mul_le_mul_of_nonneg_right key (by positivity)
      calc ∑ j ∈ Finset.Icc (-(J : ℤ)) J,
            ‖iteratedFDeriv ℝ k (fun η => κ (alpha123.dilate ((2 : ℝ) ^ (-j)) η)) ξ
              (fun r => Twisted.Anisotropy.coordinateDirection (σ r))‖
          ≤ ∑ j ∈ Finset.Icc (-(J : ℤ)) J,
              B * min ((2 : ℝ) ^ (-j) * ρ) ((2 : ℝ) ^ (-j) * ρ)⁻¹ * ρ ^ (-(w : ℝ)) :=
            Finset.sum_le_sum hper
        _ = B * (∑ j ∈ Finset.Icc (-(J : ℤ)) J,
              min ((2 : ℝ) ^ (-j) * ρ) ((2 : ℝ) ^ (-j) * ρ)⁻¹) * ρ ^ (-(w : ℝ)) := by
            rw [Finset.mul_sum, Finset.sum_mul]
        _ ≤ B * 6 * ρ ^ (-(w : ℝ)) := by gcongr
        _ = 6 * B * ρ ^ (-((w : ℕ) : ℝ)) := by ring

theorem continuous_radius123 : Continuous alpha123.radius := by
  unfold Twisted.Anisotropy.radius
  refine continuous_finsetSum _ fun i _ => ?_
  exact ((continuous_evalCoord i).abs).rpow_const fun _ => Or.inr (by positivity)

theorem norm_le_sum_abs_E3 (η : E3) : ‖η‖ ≤ |η 0| + |η 1| + |η 2| := by
  rw [EuclideanSpace.norm_eq, Fin.sum_univ_three]
  refine Real.sqrt_le_iff.mpr ⟨by positivity, ?_⟩
  simp only [Real.norm_eq_abs, sq_abs]
  nlinarith [abs_nonneg (η 0), abs_nonneg (η 1), abs_nonneg (η 2), sq_abs (η 0), sq_abs (η 1),
    sq_abs (η 2)]

/-- On a ball of radius `R`, the Euclidean norm is controlled by the anisotropic radius:
`‖η‖ ≤ 3 max(1,R)^2 ρ(η)`. -/
theorem norm_le_radius_of_norm_le {R : ℝ} {η : E3} (h : ‖η‖ ≤ R) :
    ‖η‖ ≤ 3 * max 1 R ^ 2 * alpha123.radius η := by
  set Q := max 1 R with hQ
  have hQ1 : 1 ≤ Q := le_max_left _ _
  have hcoord : ∀ i : Fin 3, |η i| ≤ Q ^ 2 * |η i| ^ ((alpha123.weight i : ℝ)⁻¹) := by
    intro i
    set a : ℕ := alpha123.weight i
    have ha1 : 1 ≤ a := alpha123_weight_pos i
    have ha3 : a ≤ 3 := alpha123_weight_le i
    set t := |η i| ^ ((a : ℝ)⁻¹) with ht
    have ht0 : 0 ≤ t := by positivity
    have hηi : |η i| ≤ Q := by
      refine le_trans ?_ (le_trans h (le_max_right _ _))
      have := PiLp.norm_apply_le η i
      rwa [Real.norm_eq_abs] at this
    have hta : t ^ a = |η i| := by
      rw [ht, ← Real.rpow_natCast, ← Real.rpow_mul (abs_nonneg _), inv_mul_cancel₀
        (by exact_mod_cast (Nat.pos_of_ne_zero (by omega)).ne'), Real.rpow_one]
    have htQ : t ≤ Q := by
      by_contra hc
      push Not at hc
      have : Q ^ a < t ^ a := pow_lt_pow_left₀ hc (by positivity) (by omega)
      have hQa : Q ≤ Q ^ a := le_self_pow₀ hQ1 (by omega)
      linarith
    rw [← hta]
    calc t ^ a = t * t ^ (a - 1) := by rw [← pow_succ']; congr 1
      _ ≤ t * Q ^ 2 := by
          refine mul_le_mul_of_nonneg_left ?_ ht0
          calc t ^ (a - 1) ≤ Q ^ (a - 1) := pow_le_pow_left₀ ht0 htQ _
            _ ≤ Q ^ 2 := pow_le_pow_right₀ hQ1 (by omega)
      _ = Q ^ 2 * t := mul_comm _ _
  have hsum : alpha123.radius η = ∑ i : Fin 3, |η i| ^ ((alpha123.weight i : ℝ)⁻¹) := rfl
  rw [hsum, Fin.sum_univ_three]
  have h0 := hcoord 0; have h1 := hcoord 1; have h2 := hcoord 2
  have hn := norm_le_sum_abs_E3 η
  have hr0 : 0 ≤ |η 0| ^ ((alpha123.weight 0 : ℝ)⁻¹) := by positivity
  have hr1 : 0 ≤ |η 1| ^ ((alpha123.weight 1 : ℝ)⁻¹) := by positivity
  have hr2 : 0 ≤ |η 2| ^ ((alpha123.weight 2 : ℝ)⁻¹) := by positivity
  nlinarith [sq_nonneg Q]

/-- **Smooth compactly supported symbols vanishing at the origin satisfy the hypotheses of the
dyadic symbol lemma** (`Auto.dyadicSum_isAnisotropicMultiplier`). -/
theorem dyadic_hyps_of_hasCompactSupport {κ : E3 → ℂ}
    (hκ : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) κ) (hc : HasCompactSupport κ) (h0 : κ 0 = 0) :
    ∃ B : ℝ, 0 ≤ B ∧ (∀ η, ‖κ η‖ ≤ B * alpha123.radius η) ∧
      (∀ η, ‖κ η‖ * alpha123.radius η ≤ B) ∧
      (∀ k, 1 ≤ k → k ≤ 110 → ∀ η, ‖iteratedFDeriv ℝ k κ η‖ ≤ B) ∧
      (∀ k, 1 ≤ k → k ≤ 110 → ∀ η, ‖iteratedFDeriv ℝ k κ η‖ * alpha123.radius η ^ 331 ≤ B) := by
  -- Lipschitz bound and the support ball
  obtain ⟨L, hL⟩ := hκ.lipschitzWith_of_hasCompactSupport hc (by simp)
  obtain ⟨R, hR⟩ := hc.isCompact.isBounded.subset_closedBall 0
  have hsupp : ∀ η, R < ‖η‖ → κ η = 0 := by
    intro η hη
    by_contra hne
    have := hR (subset_tsupport _ hne)
    rw [Metric.mem_closedBall, dist_zero_right] at this
    linarith
  -- bounds for the finitely many derivatives
  have hbd : ∀ k : ℕ, ∃ C : ℝ, ∀ η, ‖iteratedFDeriv ℝ k κ η‖ * (1 + alpha123.radius η ^ 331) ≤ C := by
    intro k
    have hcont : Continuous fun η => ‖iteratedFDeriv ℝ k κ η‖ * (1 + alpha123.radius η ^ 331) :=
      (hκ.continuous_iteratedFDeriv (natCast_le_smooth k)).norm.mul
        (continuous_const.add (continuous_radius123.pow _))
    have hcs : HasCompactSupport fun η => ‖iteratedFDeriv ℝ k κ η‖ *
        (1 + alpha123.radius η ^ 331) :=
      ((hc.iteratedFDeriv k).norm).mul_right
    obtain ⟨C, hC⟩ := hcont.bounded_above_of_compact_support hcs
    exact ⟨C, fun η => (le_abs_self _).trans (by simpa [Real.norm_eq_abs] using hC η)⟩
  choose C hC using hbd
  obtain ⟨C0, hC0⟩ : ∃ C0 : ℝ, ∀ η, ‖κ η‖ * alpha123.radius η ≤ C0 := by
    have hcont : Continuous fun η => ‖κ η‖ * alpha123.radius η :=
      hκ.continuous.norm.mul continuous_radius123
    obtain ⟨C0, h⟩ := hcont.bounded_above_of_compact_support (hc.norm.mul_right)
    exact ⟨C0, fun η => (le_abs_self _).trans (by simpa [Real.norm_eq_abs] using h η)⟩
  set Cmax : ℝ := ∑ k ∈ Finset.range 111, |C k| with hCmax
  set B : ℝ := (L : ℝ) * (3 * max 1 R ^ 2) + |C0| + Cmax with hB
  have hCk : ∀ k, k ≤ 110 → C k ≤ Cmax := fun k hk =>
    (le_abs_self _).trans (Finset.single_le_sum (f := fun k => |C k|)
      (fun _ _ => abs_nonneg _) (Finset.mem_range.mpr (by omega)))
  have hCmax0 : 0 ≤ Cmax := Finset.sum_nonneg fun _ _ => abs_nonneg _
  have hL0 : (0 : ℝ) ≤ L := L.2
  have hρ0 : ∀ η, 0 ≤ alpha123.radius η := fun η => by
    unfold Twisted.Anisotropy.radius; positivity
  have hLR : 0 ≤ (L : ℝ) * (3 * max 1 R ^ 2) := by positivity
  refine ⟨B, by positivity, fun η => ?_, fun η => ?_, fun k hk1 hk η => ?_, fun k hk1 hk η => ?_⟩
  · by_cases hη : ‖η‖ ≤ R
    · have h1 : ‖κ η‖ ≤ L * ‖η‖ := by
        have := hL.dist_le_mul η 0
        rwa [dist_eq_norm, h0, sub_zero, dist_zero_right] at this
      have h2 := norm_le_radius_of_norm_le hη
      calc ‖κ η‖ ≤ L * ‖η‖ := h1
        _ ≤ L * (3 * max 1 R ^ 2 * alpha123.radius η) := mul_le_mul_of_nonneg_left h2 hL0
        _ ≤ B * alpha123.radius η := by
            rw [← mul_assoc]
            exact mul_le_mul_of_nonneg_right (by rw [hB]; linarith [abs_nonneg C0]) (hρ0 η)
    · rw [hsupp η (not_le.mp hη), norm_zero]; exact mul_nonneg (by positivity) (hρ0 η)
  · exact (hC0 η).trans (by rw [hB]; linarith [le_abs_self C0, hLR])
  · have := hC k η
    have hle : ‖iteratedFDeriv ℝ k κ η‖ ≤ C k := by
      refine le_trans ?_ this
      exact le_mul_of_one_le_right (norm_nonneg _) (by linarith [pow_nonneg (hρ0 η) 331])
    exact hle.trans ((hCk k hk).trans (by rw [hB]; linarith [abs_nonneg C0, hLR]))
  · have := hC k η
    have hle : ‖iteratedFDeriv ℝ k κ η‖ * alpha123.radius η ^ 331 ≤ C k := by
      refine le_trans ?_ this
      exact mul_le_mul_of_nonneg_left (by linarith) (norm_nonneg _)
    exact hle.trans ((hCk k hk).trans (by rw [hB]; linarith [abs_nonneg C0, hLR]))

/-! ### The low-frequency symbol `κ̂_L`, lines 358-374 -/

/-- The weight `ψ(s)/s` of the operator `T_0`. -/
def wL (s : ℝ) : ℝ := lpPsi s / s

theorem wL_eq_zero_of_abs_lt {s : ℝ} (h : |s| < 1 / 2) : wL s = 0 := by
  simp [wL, lpPsi_eq_zero_of_abs_lt h]

theorem wL_eq_zero_of_le_abs {s : ℝ} (h : 2 ≤ |s|) : wL s = 0 := by
  simp [wL, lpPsi_eq_zero_of_le_abs h]

theorem wL_neg (s : ℝ) : wL (-s) = -wL s := by
  simp only [wL, lpPsi_neg, div_neg]

theorem continuous_wL : Continuous wL := by
  refine continuous_iff_continuousAt.mpr fun s => ?_
  by_cases hs : s = 0
  · subst hs
    have : wL =ᶠ[𝓝 0] fun _ => 0 := by
      filter_upwards [Metric.ball_mem_nhds (0 : ℝ) (by norm_num : (0 : ℝ) < 1 / 2)] with t ht
      rw [Metric.mem_ball, dist_zero_right, Real.norm_eq_abs] at ht
      exact wL_eq_zero_of_abs_lt ht
    rw [continuousAt_congr this]
    exact continuousAt_const
  · exact continuous_lpPsi.continuousAt.div continuousAt_id hs

theorem hasCompactSupport_wL : HasCompactSupport wL := by
  refine HasCompactSupport.intro (isCompact_Icc (a := -2) (b := 2)) fun s hs => ?_
  apply wL_eq_zero_of_le_abs
  rw [mem_Icc, not_and_or, not_le, not_le] at hs
  rcases hs with h | h
  · rw [abs_of_neg (by linarith)]; linarith
  · rw [abs_of_pos (by linarith)]; linarith

/-- `∫ ψ(s) ds/s = 0`: the weight is odd. -/
theorem integral_wL : ∫ s : ℝ, wL s = 0 := by
  have h := integral_neg_eq_self (fun s : ℝ => wL s) volume
  simp only [wL_neg, integral_neg] at h
  linarith

/-- The moment curve `γ(s) = (s, s^2, s^3)`. -/
def gammaCurve (s : ℝ) : E3 := ∑ n, curve n s

theorem continuous_gammaCurve : Continuous gammaCurve :=
  continuous_finsetSum _ fun n _ => continuous_curve n

theorem inner_gammaCurve (s : ℝ) (η : E3) :
    inner ℝ (gammaCurve s) η = ∑ n, s ^ expo n * η n := by
  simp only [gammaCurve, sum_inner, curve, inner_smul_left, basisVec,
    EuclideanSpace.inner_single_left]
  simp [conj_trivial]

theorem gammaCurve_zero_coord (s : ℝ) : gammaCurve s 0 = s := by
  simp [gammaCurve, Fin.sum_univ_three, curve_apply, expo]

/-- `θ(η) = ∫ ψ(s) e^{-2πi (s η_1 + s^2 η_2 + s^3 η_3)} ds/s`, the oscillatory factor of `κ̂_L`
(lines 368 and 413; Mathlib's convention `e^{-2πi⟨·,·⟩}` fixes the sign). -/
def thetaL (η : E3) : ℂ :=
  ∫ s : ℝ, (Real.fourierChar (-(inner ℝ (gammaCurve s) η)) : ℂ) * ((wL s : ℝ) : ℂ)

/-- `θ` is the Fourier transform of the pushforward of `ψ(s) ds/s` under the moment curve. -/
theorem thetaL_eq_fourierIntegral :
    thetaL = VectorFourier.fourierIntegral Real.fourierChar (Measure.map gammaCurve volume)
      (innerSL ℝ : E3 →L[ℝ] E3 →L[ℝ] ℝ).toLinearMap₁₂ (fun v : E3 => ((wL (v 0) : ℝ) : ℂ)) := by
  funext η
  rw [VectorFourier.fourierIntegral, integral_map continuous_gammaCurve.aemeasurable]
  · refine integral_congr_ae (Eventually.of_forall fun s => ?_)
    simp [gammaCurve_zero_coord, Circle.smul_def]
  · refine Continuous.aestronglyMeasurable ?_
    exact (Real.continuous_fourierChar.comp ((continuous_id.inner continuous_const).neg)).smul
      (Complex.continuous_ofReal.comp (continuous_wL.comp (continuous_evalCoord 0)))

theorem contDiff_thetaL : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) thetaL := by
  rw [thetaL_eq_fourierIntegral]
  refine VectorFourier.contDiff_fourierIntegral (innerSL ℝ) fun n _ => ?_
  rw [integrable_map_measure _ continuous_gammaCurve.aemeasurable]
  · have e : ((fun v : E3 => ‖v‖ ^ n * ‖((wL (v 0) : ℝ) : ℂ)‖) ∘ gammaCurve)
        = fun s => ‖gammaCurve s‖ ^ n * ‖wL s‖ := by
      funext s; simp [gammaCurve_zero_coord, Complex.norm_real]
    rw [e]
    exact ((continuous_gammaCurve.norm.pow n).mul continuous_wL.norm).integrable_of_hasCompactSupport
      hasCompactSupport_wL.norm.mul_left
  · exact ((continuous_norm.pow n).mul (Complex.continuous_ofReal.comp
      (continuous_wL.comp (continuous_evalCoord 0))).norm).aestronglyMeasurable

/-- **`κ̂_L`**, the Fourier transform of `κ_L` (lines 366-374): `κ̂_L(η) = φ(η_1) φ(η_2) φ(η_3) θ(η)`. -/
def kappaL (η : E3) : ℂ := (∏ n, ((lpPhi (η n) : ℝ) : ℂ)) * thetaL η

theorem contDiff_kappaL : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) kappaL := by
  unfold kappaL
  refine ContDiff.mul (contDiff_prod fun n _ => ?_) contDiff_thetaL
  exact Complex.ofRealCLM.contDiff.comp (contDiff_lpPhi.comp
    (EuclideanSpace.proj (𝕜 := ℝ) n).contDiff)

theorem hasCompactSupport_kappaL : HasCompactSupport kappaL := by
  refine HasCompactSupport.intro (isCompact_closedBall (0 : E3) 6) fun η hη => ?_
  rw [Metric.mem_closedBall, dist_zero_right, not_le] at hη
  have hn := norm_le_sum_abs_E3 η
  have : ∃ n : Fin 3, 2 ≤ |η n| := by
    by_contra h
    push Not at h
    have := h 0; have := h 1; have := h 2
    linarith
  obtain ⟨n, hn⟩ := this
  unfold kappaL
  rw [Finset.prod_eq_zero (Finset.mem_univ n) (by rw [lpPhi_eq_zero hn]; simp), zero_mul]

/-- **`κ̂_L(0) = ∫ κ_L = 0`**, line 372: `ψ(t)/t` has integral zero. -/
theorem kappaL_zero : kappaL 0 = 0 := by
  unfold kappaL thetaL
  simp only [PiLp.zero_apply, inner_zero_right, neg_zero, AddChar.map_zero_eq_one,
    Circle.coe_one, one_mul]
  rw [integral_complex_ofReal, integral_wL]
  simp

/-- **`K̂_L` satisfies the anisotropic symbol condition `eq:symbol_condition`** (line 374), for
`α = (1,2,3)`, uniformly over the scale truncations: the multipliers
`m_{L,J}(ξ) = ∑_{|j| ≤ J} κ̂_L(D_{2^{-j}} ξ)` are anisotropic multipliers with one constant. -/
theorem kappaL_symbol : ∃ M : ℝ, 0 ≤ M ∧
    ∀ J : ℕ, alpha123.IsAnisotropicMultiplier M (dyadicSum kappaL J) := by
  obtain ⟨B, hB, h0a, h0b, hka, hkb⟩ :=
    dyadic_hyps_of_hasCompactSupport contDiff_kappaL hasCompactSupport_kappaL kappaL_zero
  exact ⟨6 * B, by positivity, fun J =>
    dyadicSum_isAnisotropicMultiplier contDiff_kappaL hB h0a h0b hka hkb J⟩

/-- Fubini for products of functions of one coordinate each, on `ℝ^3`. -/
theorem integral_E3_prod (h : Fin 3 → ℝ → ℂ) :
    ∫ t : E3, ∏ n, h n (t n) = ∏ n, ∫ s : ℝ, h n s := by
  rw [← (PiLp.volume_preserving_toLp (Fin 3)).integral_comp
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  simpa using (integral_fintype_prod_volume_eq_prod (E := fun _ : Fin 3 => ℝ) h)

theorem integrable_E3_prod {h : Fin 3 → ℝ → ℂ} (hh : ∀ n, Integrable (h n)) :
    Integrable (fun t : E3 => ∏ n, h n (t n)) := by
  rw [← (PiLp.volume_preserving_toLp (Fin 3)).integrable_comp_emb
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  have := Integrable.fintype_prod (μ := fun _ : Fin 3 => (volume : Measure ℝ)) hh
  simpa [volume_pi, Function.comp_def] using this

theorem phiS_apply (c : ℤ) (ζ : ℝ) : phiS c ζ = ((lpPhiJ c ζ : ℝ) : ℂ) := rfl

/-- `φ̌_c` is even, as `φ_c` is. -/
theorem phiCheck_neg (c : ℤ) (a : ℝ) : phiCheck c (-a) = phiCheck c a := by
  simp only [phiCheck, SchwartzMap.fourierInv_coe, Real.fourierInv_eq]
  rw [← integral_neg_eq_self]
  refine integral_congr_ae (Eventually.of_forall fun ζ => ?_)
  simp only [phiS_apply, lpPhiJ, mul_neg, lpPhi_neg]
  congr 2
  simp [RCLike.inner_apply]

theorem phiCheck_eq (c : ℤ) (a : ℝ) :
    phiCheck c a = ∫ ζ : ℝ, (Real.fourierChar (ζ * a) : ℂ) * ((lpPhiJ c ζ : ℝ) : ℂ) := by
  simp only [phiCheck, SchwartzMap.fourierInv_coe, Real.fourierInv_eq, Circle.smul_def,
    smul_eq_mul]
  refine integral_congr_ae (Eventually.of_forall fun ζ => ?_)
  simp [phiS_apply, RCLike.inner_apply, mul_comm]

/-- `e(x_1 + x_2 + x_3) = e(x_1) e(x_2) e(x_3)`. -/
theorem fourierChar_sum_three (x : Fin 3 → ℝ) :
    (Real.fourierChar (∑ n, x n) : ℂ) = ∏ n, (Real.fourierChar (x n) : ℂ) := by
  rw [Fin.sum_univ_three, Fin.prod_univ_three, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul]
  push_cast; ring

theorem inner_eq_sum_E3 (ξ t : E3) : inner ℝ ξ t = ∑ n, ξ n * t n := by
  simp [PiLp.inner_apply, RCLike.inner_apply, mul_comm]

theorem gammaCurve_apply (s : ℝ) (n : Fin 3) : gammaCurve s n = s ^ expo n := by
  fin_cases n <;> simp [gammaCurve, Fin.sum_univ_three, curve_apply, expo]

/-- The per-scale multiplier: `κ̂_L(D_{2^{-j}} ξ) = ∏_n φ_{(n+1)j}(ξ_n) ∫ ψ(2^j s) e(-⟨γ(s), ξ⟩) ds/s`. -/
theorem kappaL_dilate (j : ℤ) (ξ : E3) :
    kappaL (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ)
      = (∏ n, ((lpPhiJ ((expo n : ℤ) * j) (ξ n) : ℝ) : ℂ)) *
        ∫ s : ℝ, (lpPsi ((2 : ℝ) ^ j * s) : ℂ) / s *
          (Real.fourierChar (-(inner ℝ (gammaCurve s) ξ)) : ℂ) := by
  have hq : (0 : ℝ) < 2 ^ j := zpow_pos two_pos _
  have hq' : (2 : ℝ) ^ (-j) * 2 ^ j = 1 := by
    rw [← zpow_add₀ two_ne_zero, neg_add_cancel, zpow_zero]
  unfold kappaL
  congr 1
  · refine Finset.prod_congr rfl fun n _ => ?_
    congr 2
    simp only [Twisted.Anisotropy.dilate, PiLp.toLp_apply, lpPhiJ]
    congr 1
    change ((2 : ℝ) ^ (-j)) ^ expo n = (2 : ℝ) ^ (-((expo n : ℤ) * j))
    rw [← zpow_natCast, ← zpow_mul]
    congr 1; ring
  · unfold thetaL
    -- substitute `σ = 2^j s`
    have h := Measure.integral_comp_mul_left (fun σ : ℝ =>
      (Real.fourierChar (-(inner ℝ (gammaCurve σ)
        (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ))) : ℂ) * ((wL σ : ℝ) : ℂ)) ((2 : ℝ) ^ j)
    rw [abs_of_pos (inv_pos.mpr hq)] at h
    have e : ∀ s : ℝ, inner ℝ (gammaCurve ((2 : ℝ) ^ j * s))
        (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ) = inner ℝ (gammaCurve s) ξ := by
      intro s
      rw [inner_gammaCurve, inner_gammaCurve]
      refine Finset.sum_congr rfl fun n _ => ?_
      simp only [Twisted.Anisotropy.dilate, PiLp.toLp_apply]
      change ((2 : ℝ) ^ j * s) ^ expo n * (((2 : ℝ) ^ (-j)) ^ expo n * ξ n) = s ^ expo n * ξ n
      rw [mul_pow, show ((2 : ℝ) ^ j) ^ expo n * s ^ expo n * ((2 ^ (-j)) ^ expo n * ξ n)
        = (2 ^ (-j) * 2 ^ j) ^ expo n * (s ^ expo n * ξ n) by ring, hq', one_pow, one_mul]
    simp only [e] at h
    calc ∫ σ : ℝ, (Real.fourierChar (-(inner ℝ (gammaCurve σ)
            (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ))) : ℂ) * ((wL σ : ℝ) : ℂ)
        = (2 : ℝ) ^ j • ((2 : ℝ) ^ j)⁻¹ • ∫ σ : ℝ, (Real.fourierChar (-(inner ℝ (gammaCurve σ)
            (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ))) : ℂ) * ((wL σ : ℝ) : ℂ) := by
          rw [smul_smul, mul_inv_cancel₀ hq.ne', one_smul]
      _ = (2 : ℝ) ^ j • ∫ s : ℝ, (Real.fourierChar (-(inner ℝ (gammaCurve s) ξ)) : ℂ) *
            ((wL ((2 : ℝ) ^ j * s) : ℝ) : ℂ) := by rw [h]
      _ = ∫ s : ℝ, (2 : ℝ) ^ j • ((Real.fourierChar (-(inner ℝ (gammaCurve s) ξ)) : ℂ) *
            ((wL ((2 : ℝ) ^ j * s) : ℝ) : ℂ)) := (integral_smul _ _).symm
      _ = _ := by
          refine integral_congr_ae (Eventually.of_forall fun s => ?_)
          simp only [wL, Complex.real_smul]
          by_cases hs : s = 0
          · subst hs; simp
          · push_cast
            field_simp

theorem integrable_lpPhiJ_complex (c : ℤ) : Integrable (fun ζ : ℝ => ((lpPhiJ c ζ : ℝ) : ℂ)) :=
  (contDiff_lpPhiJ_complex c).continuous.integrable_of_hasCompactSupport
    (hasCompactSupport_lpPhiJ_complex c)

/-- **The per-scale kernel** (lines 358-369): the inverse Fourier transform of
`κ̂_L(D_{2^{-j}} ·)` is `K_j(t) = ∫ ψ(2^j s) ∏_n φ̌_{(n+1)j}(t_n - s^{n+1}) ds/s`. -/
theorem fourierInv_kappaL_dilate (j : ℤ) (t : E3) :
    ∫ ξ : E3, (Real.fourierChar (inner ℝ ξ t) : ℂ) *
        kappaL (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ)
      = ∫ s : ℝ, (lpPsi ((2 : ℝ) ^ j * s) : ℂ) / s *
          ∏ n, phiCheck ((expo n : ℤ) * j) (t n - s ^ expo n) := by
  set w : ℝ → ℂ := fun s => (lpPsi ((2 : ℝ) ^ j * s) : ℂ) / s with hw
  have hwi : Integrable w := integrable_psi_div j
  set P : E3 → ℂ := fun ξ => ∏ n, ((lpPhiJ ((expo n : ℤ) * j) (ξ n) : ℝ) : ℂ) with hP
  have hPi : Integrable P :=
    integrable_E3_prod (h := fun n ζ => ((lpPhiJ ((expo n : ℤ) * j) ζ : ℝ) : ℂ))
      fun n => integrable_lpPhiJ_complex _
  set F : E3 × ℝ → ℂ := fun p => (Real.fourierChar (inner ℝ p.1 t) : ℂ) * (P p.1 *
      (w p.2 * (Real.fourierChar (-(inner ℝ (gammaCurve p.2) p.1)) : ℂ))) with hF
  have hFi : Integrable F (volume.prod volume) := by
    refine Integrable.mono' (hPi.norm.mul_prod hwi.norm) ?_ (Eventually.of_forall fun p => ?_)
    · refine Measurable.aestronglyMeasurable ?_
      have hPc : Continuous P := continuous_finsetProd _ fun n _ =>
        Complex.continuous_ofReal.comp ((contDiff_lpPhiJ _).continuous.comp (continuous_evalCoord n))
      have hwm : Measurable w := (Complex.continuous_ofReal.comp (continuous_lpPsi.comp
        (continuous_const.mul continuous_id))).measurable.div Complex.measurable_ofReal
      have hχ : Continuous (fun p : E3 × ℝ =>
          (Real.fourierChar (-(inner ℝ (gammaCurve p.2) p.1)) : ℂ)) :=
        continuous_subtype_val.comp (Real.continuous_fourierChar.comp
          ((continuous_gammaCurve.comp continuous_snd).inner continuous_fst).neg)
      exact (continuous_subtype_val.comp (Real.continuous_fourierChar.comp
        (continuous_fst.inner continuous_const))).measurable.mul
        ((hPc.comp continuous_fst).measurable.mul ((hwm.comp measurable_snd).mul hχ.measurable))
    · simp only [hF, norm_mul, Circle.norm_coe, one_mul, mul_one]; exact le_rfl
  have e1 : ∀ ξ : E3, (Real.fourierChar (inner ℝ ξ t) : ℂ) *
      kappaL (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ) = ∫ s : ℝ, F (ξ, s) := by
    intro ξ
    rw [kappaL_dilate, ← integral_const_mul, ← integral_const_mul]
  simp_rw [e1]
  rw [integral_integral_swap hFi]
  refine integral_congr_ae (Eventually.of_forall fun s => ?_)
  simp only [hF]
  have e2 : ∀ ξ : E3, (Real.fourierChar (inner ℝ ξ t) : ℂ) * (P ξ *
      (w s * (Real.fourierChar (-(inner ℝ (gammaCurve s) ξ)) : ℂ)))
      = w s * ∏ n, ((Real.fourierChar (ξ n * (t n - s ^ expo n)) : ℂ) *
          ((lpPhiJ ((expo n : ℤ) * j) (ξ n) : ℝ) : ℂ)) := by
    intro ξ
    rw [Finset.prod_mul_distrib, ← fourierChar_sum_three]
    have hin : inner ℝ ξ t + -(inner ℝ (gammaCurve s) ξ) = ∑ n, ξ n * (t n - s ^ expo n) := by
      rw [inner_eq_sum_E3, real_inner_comm, inner_eq_sum_E3, ← Finset.sum_neg_distrib,
        ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun n _ => ?_
      rw [gammaCurve_apply]; ring
    rw [← hin, AddChar.map_add_eq_mul, Circle.coe_mul]
    simp only [hP]
    ring
  simp_rw [e2]
  rw [integral_const_mul]
  congr 1
  rw [integral_E3_prod (fun n ζ => (Real.fourierChar (ζ * (t n - s ^ expo n)) : ℂ) *
    ((lpPhiJ ((expo n : ℤ) * j) ζ : ℝ) : ℂ))]
  refine Finset.prod_congr rfl fun n _ => ?_
  rw [phiCheck_eq]

theorem integral_E3_prod_real (h : Fin 3 → ℝ → ℝ) :
    ∫ t : E3, ∏ n, h n (t n) = ∏ n, ∫ s : ℝ, h n s := by
  rw [← (PiLp.volume_preserving_toLp (Fin 3)).integral_comp
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  simpa using (integral_fintype_prod_volume_eq_prod (E := fun _ : Fin 3 => ℝ) h)

theorem integrable_E3_prod_real {h : Fin 3 → ℝ → ℝ} (hh : ∀ n, Integrable (h n)) :
    Integrable (fun t : E3 => ∏ n, h n (t n)) := by
  rw [← (PiLp.volume_preserving_toLp (Fin 3)).integrable_comp_emb
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  have := Integrable.fintype_prod (μ := fun _ : Fin 3 => (volume : Measure ℝ)) hh
  simpa [volume_pi, Function.comp_def] using this

/-- The per-scale physical kernel `K_j(t) = ∫ ψ(2^j s) ∏_n φ̌_{(n+1)j}(t_n - s^{n+1}) ds/s`. -/
def kernelLj (j : ℤ) (t : E3) : ℂ :=
  ∫ s : ℝ, (lpPsi ((2 : ℝ) ^ j * s) : ℂ) / s *
    ∏ n, phiCheck ((expo n : ℤ) * j) (t n - s ^ expo n)

/-- `S^{(n)}_c g(x + b e_n) = ∫ φ̌_c(r - b) g(x + r e_n) dr`. -/
theorem lpS_shift (ℓ : Fin 3) (c : ℤ) (g : 𝓢(E3, ℂ)) (x : E3) (b : ℝ) :
    lpS ℓ c g (x + b • basisVec ℓ) = ∫ r : ℝ, phiCheck c (r - b) * g (x + r • basisVec ℓ) := by
  rw [lpS_eq_lineConv]
  rw [← integral_sub_left_eq_self (fun r : ℝ => phiCheck c (r - b) * g (x + r • basisVec ℓ))
    volume b]
  refine integral_congr_ae (Eventually.of_forall fun u => ?_)
  simp only
  rw [show b - u - b = -u by ring, phiCheck_neg]
  congr 2
  rw [sub_smul]; abel

/-- **The kernel form of a low-frequency scale** (lines 358-369):
`T_j(S^{(1)}_j f_1, S^{(2)}_{2j} f_2, S^{(3)}_{3j} f_3) = Γ_{K_j}(f)`. -/
theorem gammaOp_kernelLj (j : ℤ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    gammaOp (kernelLj j) (fun n => f n) x
      = simplexTj j (fun n => lpS n ((expo n : ℤ) * j) (f n)) x := by
  set w : ℝ → ℂ := fun s => (lpPsi ((2 : ℝ) ^ j * s) : ℂ) / s with hw
  have hwi : Integrable w := integrable_psi_div j
  have hwm : Measurable w := (Complex.continuous_ofReal.comp (continuous_lpPsi.comp
    (continuous_const.mul continuous_id))).measurable.div Complex.measurable_ofReal
  set c : Fin 3 → ℤ := fun n => (expo n : ℤ) * j with hc
  choose C hC0 hC using fun n => exists_bound_schwartz (f n)
  set G : E3 × ℝ → ℂ := fun p => w p.2 * ∏ n, (phiCheck (c n) (p.1 n - p.2 ^ expo n) *
      f n (x + p.1 n • basisVec n)) with hG
  set H : E3 × ℝ → ℝ := fun p => ‖w p.2‖ * ∏ n, (C n * ‖phiCheck (c n) (p.1 n - p.2 ^ expo n)‖)
    with hH
  have hHm : Measurable H := by
    refine hwm.norm.comp measurable_snd |>.mul ?_
    refine Finset.measurable_prod _ fun n _ => measurable_const.mul ?_
    exact ((phiCheck (c n)).continuous.comp (((continuous_evalCoord n).comp continuous_fst).sub
      (continuous_snd.pow _))).norm.measurable
  have hGm : Measurable G := by
    refine (hwm.comp measurable_snd).mul ?_
    refine Finset.measurable_prod _ fun n _ => ?_
    exact (((phiCheck (c n)).continuous.comp (((continuous_evalCoord n).comp
      continuous_fst).sub (continuous_snd.pow _))).mul ((f n).continuous.comp
        (continuous_const.add (((continuous_evalCoord n).comp continuous_fst).smul
          continuous_const)))).measurable
  have hHint : ∀ s : ℝ, ∫ t : E3, H (t, s) = ‖w s‖ * ∏ n, (C n * ∫ r : ℝ, ‖phiCheck (c n) r‖) := by
    intro s
    simp only [hH]
    rw [integral_const_mul]
    congr 1
    rw [integral_E3_prod_real (fun n r => C n * ‖phiCheck (c n) (r - s ^ expo n)‖)]
    refine Finset.prod_congr rfl fun n _ => ?_
    rw [integral_const_mul, integral_sub_right_eq_self (fun r => ‖phiCheck (c n) r‖) (s ^ expo n)]
  have hHi : Integrable H (volume.prod volume) := by
    rw [integrable_prod_iff' hHm.aestronglyMeasurable]
    refine ⟨Eventually.of_forall fun s => ?_, ?_⟩
    · have := integrable_E3_prod_real (h := fun n r => C n * ‖phiCheck (c n) (r - s ^ expo n)‖)
        fun n => ((phiCheck (c n)).integrable.norm.comp_sub_right _).const_mul _
      exact this.const_mul ‖w s‖
    · have e : (fun s => ∫ t : E3, ‖H (t, s)‖) = fun s => ∫ t : E3, H (t, s) := by
        funext s
        refine integral_congr_ae (Eventually.of_forall fun t => ?_)
        dsimp only
        rw [Real.norm_eq_abs, abs_of_nonneg]
        exact mul_nonneg (norm_nonneg _) (Finset.prod_nonneg fun n _ =>
          mul_nonneg (hC0 n) (norm_nonneg _))
      rw [e]
      simp_rw [hHint]
      exact hwi.norm.mul_const _
  have hGi : Integrable G (volume.prod volume) := by
    refine Integrable.mono' hHi hGm.aestronglyMeasurable (Eventually.of_forall fun p => ?_)
    simp only [hG, hH, norm_mul, norm_prod]
    refine mul_le_mul_of_nonneg_left (Finset.prod_le_prod (fun n _ => by positivity)
      fun n _ => ?_) (norm_nonneg _)
    rw [mul_comm]
    exact mul_le_mul_of_nonneg_right (hC n _) (norm_nonneg _)
  -- rewrite both sides as iterated integrals of `G`
  have hL : gammaOp (kernelLj j) (fun n => f n) x = ∫ t : E3, ∫ s : ℝ, G (t, s) := by
    unfold gammaOp kernelLj
    refine integral_congr_ae (Eventually.of_forall fun t => ?_)
    dsimp only
    rw [← integral_mul_const]
    refine integral_congr_ae (Eventually.of_forall fun s => ?_)
    simp only [hG, hw, Finset.prod_mul_distrib]
    ring
  have hR : simplexTj j (fun n => lpS n ((expo n : ℤ) * j) (f n)) x
      = ∫ s : ℝ, ∫ t : E3, G (t, s) := by
    unfold simplexTj
    refine integral_congr_ae (Eventually.of_forall fun s => ?_)
    simp only [hG, prodShift]
    rw [integral_const_mul, integral_E3_prod (fun n r => phiCheck (c n) (r - s ^ expo n) *
      f n (x + r • basisVec n))]
    have e : ∀ n : Fin 3, lpS n ((expo n : ℤ) * j) (f n) (x + curve n s)
        = ∫ r : ℝ, phiCheck (c n) (r - s ^ expo n) * f n (x + r • basisVec n) := by
      intro n
      rw [curve, lpS_shift]
    simp only [e, hw]
    ring
  rw [hL, hR, integral_integral_swap hGi]

/-- The dilation `D_a`, `a ≠ 0`, as a continuous linear equivalence. -/
def dilEquiv {a : ℝ} (ha : a ≠ 0) : E3 ≃L[ℝ] E3 :=
  ContinuousLinearEquiv.equivOfInverse (dilCLM a) (dilCLM a⁻¹)
    (fun ξ => by simp only [dilCLM_apply]; exact alpha123.dilate_inv_apply ha ξ)
    (fun ξ => by simp only [dilCLM_apply]; exact alpha123.dilate_apply_inv ha ξ)

theorem hasCompactSupport_kappaL_dilate (j : ℤ) :
    HasCompactSupport (fun ξ => kappaL (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ)) := by
  have ha : (2 : ℝ) ^ (-j) ≠ 0 := (zpow_pos two_pos _).ne'
  have := hasCompactSupport_kappaL.comp_homeomorph (dilEquiv ha).toHomeomorph
  convert this using 1
  funext ξ
  simp [dilEquiv, dilCLM_apply]

theorem contDiff_kappaL_dilate (j : ℤ) :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun ξ => kappaL (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ)) := by
  have e : (fun ξ => kappaL (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ))
      = kappaL ∘ dilCLM ((2 : ℝ) ^ (-j)) := by funext ξ; simp [dilCLM_apply]
  rw [e]; exact contDiff_kappaL.comp (dilCLM _).contDiff

/-- `κ̂_L(D_{2^{-j}} ·)` as a Schwartz function. -/
def kappaLjS (j : ℤ) : 𝓢(E3, ℂ) :=
  (hasCompactSupport_kappaL_dilate j).toSchwartzMap (contDiff_kappaL_dilate j)

theorem kappaLjS_apply (j : ℤ) (ξ : E3) :
    kappaLjS j ξ = kappaL (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ) := rfl

/-- The Schwartz kernel `K_j = 𝓕^{-1} κ̂_L(D_{2^{-j}} ·)`. -/
def kernelLjS (j : ℤ) : 𝓢(E3, ℂ) := 𝓕⁻ (kappaLjS j)

theorem kernelLjS_apply (j : ℤ) (t : E3) : kernelLjS j t = kernelLj j t := by
  rw [kernelLjS, SchwartzMap.fourierInv_coe, Real.fourierInv_eq, kernelLj,
    ← fourierInv_kappaL_dilate]
  refine integral_congr_ae (Eventually.of_forall fun ξ => ?_)
  dsimp only
  rw [Circle.smul_def, smul_eq_mul, kappaLjS_apply]

/-- The truncated low-frequency kernel `K_{L,J} = ∑_{|j| ≤ J} K_j` (line 364, truncated). -/
def kernelLJ (J : ℕ) : 𝓢(E3, ℂ) := ∑ j ∈ Finset.Icc (-(J : ℤ)) J, kernelLjS j

/-- `K̂_{L,J} = ∑_{|j| ≤ J} κ̂_L(D_{2^{-j}} ·)`. -/
theorem fourier_kernelLJ (J : ℕ) : 𝓕 (kernelLJ J : E3 → ℂ) = dyadicSum kappaL J := by
  rw [← SchwartzMap.fourier_coe]
  funext ξ
  have hs : 𝓕 (kernelLJ J) = ∑ j ∈ Finset.Icc (-(J : ℤ)) J, 𝓕 (kernelLjS j) := by
    have := map_sum (SchwartzMap.fourierTransformCLM ℂ (V := E3) (E := ℂ)) kernelLjS
      (Finset.Icc (-(J : ℤ)) J)
    simp [kernelLJ] at this ⊢
  rw [hs, SchwartzMap.sum_apply, dyadicSum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [kernelLjS, FourierInvPair.fourier_fourierInv_eq, kappaLjS_apply]

/-- `Γ` is additive in the kernel. -/
theorem gammaOp_sum (s : Finset ℤ) (K : ℤ → 𝓢(E3, ℂ)) (g : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    gammaOp (⇑(∑ j ∈ s, K j)) (fun n => g n) x = ∑ j ∈ s, gammaOp (K j) (fun n => g n) x := by
  choose C hC0 hC using fun n => exists_bound_schwartz (g n)
  unfold gammaOp
  rw [← integral_finsetSum]
  · refine integral_congr_ae (Eventually.of_forall fun t => ?_)
    simp only [SchwartzMap.sum_apply, Finset.sum_mul]
  · intro j _
    refine Integrable.mono' ((K j).integrable.norm.mul_const (∏ n, C n))
      ((K j).continuous.mul ((continuous_shiftProd g).comp
        (continuous_const.prodMk continuous_id))).aestronglyMeasurable
      (Eventually.of_forall fun t => ?_)
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (norm_gammaProd_le g hC x t) (norm_nonneg _)

/-- **The kernel form of `T^L`** (lines 358-369), truncated: `T^L_J(f) = Γ_{K_{L,J}}(f)`. -/
theorem regComp_L_eq_gammaOp (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    regComp RegL J f x = gammaOp (kernelLJ J) (fun n => f n) x := by
  rw [regComp_L_eq, kernelLJ, gammaOp_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [← gammaOp_kernelLj]
  congr 1
  funext t; exact (kernelLjS_apply j t).symm

/-- **The low-frequency bound** (lines 376-379): for `p ∈ (1, 4/3)`, `p_n ∈ (1, 4)` with
`∑ 1/p_n = 1/p`, `‖T^L_J(f)‖_p ≤ C ∏ ‖f_n‖_{p_n}` uniformly in the scale truncation `J`, by
`thm:main_twist` (`Auto.mainTwist`) applied to the kernels `K_{L,J}`. -/
theorem lowFreq_bound {p : ℝ} {pv : Fin 3 → ℝ} (hp : 1 < p) (hp43 : p < 4 / 3)
    (hpv : ∀ n, 1 < pv n ∧ pv n < 4) (hsum : ∑ n, (pv n)⁻¹ = p⁻¹) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)),
      eLpNorm (regComp RegL J f) (ENNReal.ofReal p) volume
        ≤ ENNReal.ofReal C * ∏ n, eLpNorm (f n) (ENNReal.ofReal (pv n)) volume := by
  obtain ⟨C0, hC0, hT⟩ := mainTwist hp hp43 hpv hsum
  obtain ⟨M, hM, hsym⟩ := kappaL_symbol
  refine ⟨C0 * M, mul_nonneg hC0 hM, fun J f => ?_⟩
  have e : regComp RegL J f = gammaOp (kernelLJ J) (fun n => f n) :=
    funext fun x => regComp_L_eq_gammaOp J f x
  rw [e]
  exact hT M (kernelLJ J) (by rw [fourier_kernelLJ]; exact hsym J) f

theorem moment_wL_integrable (n : ℕ) :
    Integrable (fun v : E3 => ‖v‖ ^ n * ‖((wL (v 0) : ℝ) : ℂ)‖) (Measure.map gammaCurve volume) := by
  rw [integrable_map_measure _ continuous_gammaCurve.aemeasurable]
  · have e : ((fun v : E3 => ‖v‖ ^ n * ‖((wL (v 0) : ℝ) : ℂ)‖) ∘ gammaCurve)
        = fun s => ‖gammaCurve s‖ ^ n * ‖wL s‖ := by
      funext s; simp [gammaCurve_zero_coord, Complex.norm_real]
    rw [e]
    exact ((continuous_gammaCurve.norm.pow n).mul continuous_wL.norm).integrable_of_hasCompactSupport
      hasCompactSupport_wL.norm.mul_left
  · exact ((continuous_norm.pow n).mul (Complex.continuous_ofReal.comp
      (continuous_wL.comp (continuous_evalCoord 0))).norm).aestronglyMeasurable

/-- **Derivatives of `θ`**: `D^k θ(η)(w_1, ..., w_k) = ∫ e(-⟨γ(s), η⟩) (-2πi)^k ∏_i ⟨γ(s), w_i⟩ ψ(s) ds/s`. -/
theorem iteratedFDeriv_thetaL_apply (k : ℕ) (η : E3) (w : Fin k → E3) :
    iteratedFDeriv ℝ k thetaL η w
      = ∫ s : ℝ, (Real.fourierChar (-(inner ℝ (gammaCurve s) η)) : ℂ) *
          ((-(2 * Real.pi * Complex.I)) ^ k * ((∏ i, inner ℝ (gammaCurve s) (w i) : ℝ) : ℂ) *
            ((wL s : ℝ) : ℂ)) := by
  have hfm : AEStronglyMeasurable (fun v : E3 => ((wL (v 0) : ℝ) : ℂ))
      (Measure.map gammaCurve volume) := (Complex.continuous_ofReal.comp (continuous_wL.comp
        (continuous_evalCoord 0))).aestronglyMeasurable
  have hint := (Real.fourierIntegral_convergent_iff' (innerSL ℝ) η).2
    (VectorFourier.integrable_fourierPowSMulRight (innerSL ℝ) (moment_wL_integrable k) hfm)
  rw [thetaL_eq_fourierIntegral, VectorFourier.iteratedFDeriv_fourierIntegral (N := ⊤)
    (innerSL ℝ) (fun n _ => moment_wL_integrable n)
    ((Complex.continuous_ofReal.comp (continuous_wL.comp
      (continuous_evalCoord 0))).aestronglyMeasurable) (by exact_mod_cast le_top)]
  rw [VectorFourier.fourierIntegral, ContinuousMultilinearMap.integral_apply]
  · rw [integral_map continuous_gammaCurve.aemeasurable]
    · refine integral_congr_ae (Eventually.of_forall fun s => ?_)
      simp only [ContinuousMultilinearMap.smul_apply, VectorFourier.fourierPowSMulRight_apply,
        gammaCurve_zero_coord, Circle.smul_def, smul_eq_mul,
        ContinuousLinearMap.toLinearMap₁₂_apply, Complex.real_smul, Complex.ofReal_prod]
      have hin : ∀ v u : E3, (innerSL ℝ) v u = inner ℝ v u := fun v u => rfl
      simp only [hin]
      ring
    · exact (continuous_eval_const w).comp_aestronglyMeasurable hint.aestronglyMeasurable
  · exact hint

/-- The oscillatory factor `e(-λ P(s))` has derivative `-2πiλ P'(s) e(-λ P(s))`. -/
theorem hasDerivAt_fourierChar_phase {P q : ℝ → ℝ} (lam : ℝ) {s : ℝ} (hP : HasDerivAt P (q s) s) :
    HasDerivAt (fun s => (Real.fourierChar (-(lam * P s)) : ℂ))
      (-(2 * Real.pi * Complex.I * lam * q s) * (Real.fourierChar (-(lam * P s)) : ℂ)) s := by
  simp only [Real.fourierChar_apply]
  have h1 : HasDerivAt (fun s => ((2 * Real.pi * -(lam * P s) : ℝ) : ℂ) * Complex.I)
      (((2 * Real.pi * -(lam * q s) : ℝ) : ℂ) * Complex.I) s := by
    have := ((hP.const_mul lam).neg.const_mul (2 * Real.pi)).ofReal_comp
    exact this.mul_const Complex.I
  convert h1.cexp using 1
  push_cast; ring

/-- A function with compact support vanishes outside some symmetric interval. -/
theorem exists_Icc_of_hasCompactSupport {b : ℝ → ℂ} (hb : HasCompactSupport b) :
    ∃ R : ℝ, 1 ≤ R ∧ ∀ s, R - 1 < |s| → s ∉ tsupport b := by
  obtain ⟨R, hR⟩ := hb.isCompact.isBounded.subset_closedBall 0
  refine ⟨max R 0 + 1, by linarith [le_max_right R 0], fun s hs hmem => ?_⟩
  have := hR hmem
  rw [Metric.mem_closedBall, dist_zero_right, Real.norm_eq_abs] at this
  linarith [le_max_left R 0]

/-- **One integration by parts** for a non-stationary phase: if `P' = q`, `r q = 1` on the
support of the compactly supported `C^1` amplitude `b`, and `λ ≠ 0`, then
`∫ b e(-λP) = (2πiλ)^{-1} ∫ (b r)' e(-λP)`. -/
theorem integral_fourierChar_ibp {b : ℝ → ℂ} {r P q : ℝ → ℝ} {lam : ℝ}
    (hb : ContDiff ℝ 1 b) (hbc : HasCompactSupport b) (hr : ContDiff ℝ 1 r)
    (hP : ∀ s, HasDerivAt P (q s) s) (hq : Continuous q)
    (hrq : ∀ s ∈ tsupport b, r s * q s = 1) (hlam : lam ≠ 0) :
    ∫ s, b s * (Real.fourierChar (-(lam * P s)) : ℂ)
      = (2 * Real.pi * Complex.I * lam)⁻¹ *
          ∫ s, deriv (fun s => b s * (r s : ℂ)) s * (Real.fourierChar (-(lam * P s)) : ℂ) := by
  obtain ⟨R, hR1, hR⟩ := exists_Icc_of_hasCompactSupport hbc
  set u : ℝ → ℂ := fun s => b s * (r s : ℂ) with hu
  set v : ℝ → ℂ := fun s => (Real.fourierChar (-(lam * P s)) : ℂ) with hv
  have hPc : Continuous P := continuous_iff_continuousAt.mpr fun s => (hP s).continuousAt
  have hvc : Continuous v := continuous_subtype_val.comp (Real.continuous_fourierChar.comp
    (continuous_const.mul hPc).neg)
  have huC : ContDiff ℝ 1 u := hb.mul (Complex.ofRealCLM.contDiff.comp hr)
  have hu_diff : ∀ s, HasDerivAt u (deriv u s) s := fun s =>
    (huC.differentiable one_ne_zero s).hasDerivAt
  have hu'c : Continuous (deriv u) := huC.continuous_deriv le_rfl
  have hv' : ∀ s, HasDerivAt v (-(2 * Real.pi * Complex.I * lam * q s) * v s) s := fun s =>
    hasDerivAt_fourierChar_phase lam (hP s)
  -- supports
  have hb0 : ∀ s, R - 1 < |s| → b s = 0 := fun s hs =>
    image_eq_zero_of_notMem_tsupport (hR s hs)
  have hu0 : ∀ s, R - 1 < |s| → deriv u s = 0 := by
    intro s hs
    have hsupp : s ∉ tsupport u := by
      intro h
      exact hR s hs (tsupport_mul_subset_left h)
    exact image_eq_zero_of_notMem_tsupport (fun h => hsupp (tsupport_deriv_subset h))
  have hIcc : ∀ F : ℝ → ℂ, (∀ s, R - 1 < |s| → F s = 0) → Continuous F →
      ∫ s, F s = ∫ s in (-R)..R, F s := by
    intro F hF hFc
    rw [intervalIntegral.integral_of_le (by linarith), ← integral_Icc_eq_integral_Ioc]
    symm
    refine setIntegral_eq_integral_of_forall_compl_eq_zero fun s hs => hF s ?_
    rw [mem_Icc, not_and_or, not_le, not_le] at hs
    rcases hs with h | h
    · rw [abs_of_neg (by linarith)]; linarith
    · rw [abs_of_pos (by linarith)]; linarith
  have hv'c : Continuous fun s => -(2 * Real.pi * Complex.I * lam * q s) * v s := by
    have hqc : Continuous fun s => ((q s : ℝ) : ℂ) := Complex.continuous_ofReal.comp hq
    fun_prop
  have hibp := intervalIntegral.integral_mul_deriv_eq_deriv_mul (a := -R) (b := R)
    (fun s _ => hu_diff s) (fun s _ => hv' s) (hu'c.intervalIntegrable _ _)
    (hv'c.intervalIntegrable _ _)
  have huR : u R = 0 := by
    simp only [hu, hb0 R (by rw [abs_of_pos (by linarith)]; linarith), zero_mul]
  have huR' : u (-R) = 0 := by
    simp only [hu, hb0 (-R) (by rw [abs_neg, abs_of_pos (by linarith)]; linarith), zero_mul]
  rw [huR, huR', zero_mul, zero_mul, sub_zero, zero_sub] at hibp
  have hpt : ∀ s, u s * (-(2 * Real.pi * Complex.I * lam * q s) * v s)
      = -(2 * Real.pi * Complex.I * lam) * (b s * v s) := by
    intro s
    by_cases hs : b s = 0
    · simp [hu, hs]
    · have h1 := hrq s (subset_tsupport _ hs)
      have h2 : ((r s : ℝ) : ℂ) * ((q s : ℝ) : ℂ) = 1 := by exact_mod_cast h1
      simp only [hu]
      linear_combination (-(2 * ↑Real.pi * Complex.I * ↑lam) * b s * v s) * h2
  simp only [hpt] at hibp
  rw [intervalIntegral.integral_const_mul] at hibp
  have hne : (2 * Real.pi * Complex.I * lam) ≠ 0 := by
    have : (lam : ℂ) ≠ 0 := by exact_mod_cast hlam
    have : (Real.pi : ℂ) ≠ 0 := by exact_mod_cast Real.pi_ne_zero
    simp_all
  rw [hIcc (fun s => b s * v s) (fun s hs => by simp [hb0 s hs]) (hb.continuous.mul hvc),
    hIcc (fun s => deriv u s * v s) (fun s hs => by simp [hu0 s hs]) (hu'c.mul hvc)]
  rw [eq_inv_mul_iff_mul_eq₀ hne]
  linear_combination -hibp

/-! ### Non-stationary phase for `θ` (lines 411-418) -/

/-- Outer bump for the band cutoff: `1` on `|s| ≤ 2`, supported in `|s| < 2.1`. -/
def nspOut : ContDiffBump (0 : ℝ) := ⟨2, 21 / 10, by norm_num, by norm_num⟩

/-- Inner bump for the band cutoff: `1` on `|s| ≤ 0.4`, supported in `|s| < 1/2`. -/
def nspIn : ContDiffBump (0 : ℝ) := ⟨2 / 5, 1 / 2, by norm_num, by norm_num⟩

/-- The band cutoff `χ`: `1` on `{1/2 ≤ |s| ≤ 2}`, vanishing off `{0.4 < |s| < 2.1}`. -/
def nspChi (s : ℝ) : ℝ := nspOut s - nspIn s

theorem contDiff_nspChi : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) nspChi :=
  nspOut.contDiff.sub nspIn.contDiff

theorem nspChi_eq_one {s : ℝ} (h1 : 1 / 2 ≤ |s|) (h2 : |s| ≤ 2) : nspChi s = 1 := by
  unfold nspChi
  rw [nspOut.one_of_mem_closedBall (by simpa [Metric.mem_closedBall, nspOut] using h2),
    nspIn.zero_of_le_dist (by simpa [Real.dist_eq, nspIn] using h1), sub_zero]

theorem tsupport_nspChi {s : ℝ} (hs : s ∈ tsupport nspChi) : 2 / 5 ≤ |s| ∧ |s| ≤ 21 / 10 := by
  have hsub : tsupport nspChi ⊆ {s : ℝ | 2 / 5 ≤ |s| ∧ |s| ≤ 21 / 10} := by
    refine closure_minimal (fun s hs => ?_) ?_
    · rw [Function.mem_support] at hs
      simp only [mem_setOf_eq]
      by_contra h
      rw [not_and_or, not_le, not_le] at h
      apply hs
      unfold nspChi
      rcases h with h | h
      · rw [nspOut.one_of_mem_closedBall (by simp [Metric.mem_closedBall, nspOut]; linarith),
          nspIn.one_of_mem_closedBall (by simp [Metric.mem_closedBall, nspIn]; linarith)]
        ring
      · rw [nspOut.zero_of_le_dist (by simp [Real.dist_eq, nspOut]; linarith),
          nspIn.zero_of_le_dist (by simp [Real.dist_eq, nspIn]; linarith)]
        ring
    · exact (isClosed_le continuous_const continuous_abs).inter
        (isClosed_le continuous_abs continuous_const)
  exact hsub hs

/-- The normalized phase derivative `q(s, e) = ∂_s ⟨γ(s), e⟩ = e_1 + 2 s e_2 + 3 s^2 e_3`. -/
def nspQ (s : ℝ) (e : E3) : ℝ := ∑ m : Fin 3, (expo m : ℝ) * s ^ (m : ℕ) * e m

theorem hasDerivAt_inner_gammaCurve (e : E3) (s : ℝ) :
    HasDerivAt (fun s => inner ℝ (gammaCurve s) e) (nspQ s e) s := by
  have h : (fun s => inner ℝ (gammaCurve s) e) = fun s => ∑ m : Fin 3, s ^ expo m * e m := by
    funext s; exact inner_gammaCurve s e
  rw [h]
  unfold nspQ
  refine HasDerivAt.fun_sum fun m _ => ?_
  have := (hasDerivAt_pow (expo m) s).mul_const (e m)
  have h' : expo m - 1 = (m : ℕ) := by simp [expo]
  rw [h'] at this
  exact this

theorem continuous_nspQ : Continuous fun p : ℝ × E3 => nspQ p.1 p.2 := by
  unfold nspQ
  refine continuous_finsetSum _ fun m _ => ?_
  exact (continuous_const.mul (continuous_fst.pow _)).mul ((continuous_evalCoord m).comp
    continuous_snd)

/-- The admissible normalized frequencies for the dominant coordinate `n`. -/
def nspK (n : Fin 3) : Set E3 := {e | e n = 1 ∧ ∀ m, m ≠ n → |e m| ≤ 1 / 32}

/-- On the band `2/5 ≤ |s| ≤ 21/10` the phase derivative stays away from zero,
`|q(s, e)| ≥ 3/10`, for every admissible `e`. -/
theorem nspQ_ge (n : Fin 3) {e : E3} (he : e ∈ nspK n) {s : ℝ} (h1 : 2 / 5 ≤ |s|)
    (h2 : |s| ≤ 21 / 10) : 3 / 10 ≤ |nspQ s e| := by
  obtain ⟨hn, hm⟩ := he
  have hq : nspQ s e = e 0 + 2 * s * e 1 + 3 * s ^ 2 * e 2 := by
    simp [nspQ, Fin.sum_univ_three, expo]; ring
  rw [hq]
  have hs2 : s ^ 2 ≤ (21 / 10) ^ 2 := by
    rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) h2 _
  have hs2' : (2 / 5) ^ 2 ≤ s ^ 2 := by
    have := mul_le_mul h1 h1 (by norm_num) (abs_nonneg s)
    nlinarith [sq_abs s]
  have hmul : ∀ {x y X Y : ℝ}, |x| ≤ X → |y| ≤ Y → |x * y| ≤ X * Y := fun hx hy => by
    rw [abs_mul]; exact mul_le_mul hx hy (abs_nonneg _) ((abs_nonneg _).trans hx)
  have hsq : |s ^ 2| ≤ (21 / 10) ^ 2 := by rw [abs_of_nonneg (sq_nonneg s)]; exact hs2
  fin_cases n
  · have hb := hmul h2 (hm 1 (by decide)); have hc := hmul hsq (hm 2 (by decide))
    simp only [Fin.zero_eta] at hn
    rw [hn]
    have := abs_le.mp hb; have := abs_le.mp hc
    rw [le_abs]; left; nlinarith
  · have ha := hm 0 (by decide); have hc := hmul hsq (hm 2 (by decide))
    simp only [Fin.mk_one] at hn
    rw [hn]
    have := abs_le.mp ha; have := abs_le.mp hc
    rcases le_or_gt 0 s with hs | hs
    · rw [abs_of_nonneg hs] at h1
      rw [le_abs]; left; nlinarith
    · rw [abs_of_neg hs] at h1
      rw [le_abs]; right; nlinarith
  · have ha := hm 0 (by decide); have hb := hmul h2 (hm 1 (by decide))
    simp only [Fin.reduceFinMk] at hn
    rw [hn]
    have := abs_le.mp ha; have := abs_le.mp hb
    rw [le_abs]; left; nlinarith

/-- The integration-by-parts factor `r = χ/q`. -/
def nspR (x : ℝ × E3) : ℝ := nspChi x.1 / nspQ x.1 x.2

/-- The open set where `r` is smooth: off the support of `χ`, or where `q ≠ 0`. -/
def nspO : Set (ℝ × E3) := {x | x.1 ∉ tsupport nspChi ∨ nspQ x.1 x.2 ≠ 0}

theorem isOpen_nspO : IsOpen nspO := by
  refine IsOpen.union ?_ ?_
  · exact (isClosed_tsupport nspChi).isOpen_compl.preimage continuous_fst
  · exact isOpen_ne_fun continuous_nspQ continuous_const

theorem contDiffOn_nspR : ContDiffOn ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) nspR nspO := by
  intro x hx
  refine ContDiffAt.contDiffWithinAt ?_
  rcases hx with hx | hx
  · -- `r` vanishes near `x`
    have : nspR =ᶠ[𝓝 x] fun _ => 0 := by
      have hopen : IsOpen ((tsupport nspChi)ᶜ ×ˢ (univ : Set E3)) :=
        (isClosed_tsupport nspChi).isOpen_compl.prod isOpen_univ
      filter_upwards [hopen.mem_nhds ⟨hx, mem_univ _⟩] with y hy
      simp [nspR, image_eq_zero_of_notMem_tsupport hy.1]
    exact contDiffAt_const.congr_of_eventuallyEq this
  · have hq : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) fun p : ℝ × E3 => nspQ p.1 p.2 := by
      unfold nspQ
      refine ContDiff.sum fun m _ => ?_
      exact (contDiff_const.mul (contDiff_fst.pow _)).mul
        ((EuclideanSpace.proj (𝕜 := ℝ) m).contDiff.comp contDiff_snd)
    exact ((contDiff_nspChi.comp contDiff_fst).contDiffAt).div hq.contDiffAt hx

/-- Admissible slices lie in the smooth region. -/
theorem mem_nspO {n : Fin 3} {e : E3} (he : e ∈ nspK n) (s : ℝ) : (s, e) ∈ nspO := by
  by_cases hs : s ∈ tsupport nspChi
  · right
    obtain ⟨h1, h2⟩ := tsupport_nspChi hs
    have := nspQ_ge n he h1 h2
    intro h0; rw [h0, abs_zero] at this; linarith
  · left; exact hs

theorem nspR_mul_nspQ {n : Fin 3} {e : E3} (he : e ∈ nspK n) {s : ℝ} (h1 : 1 / 2 ≤ |s|)
    (h2 : |s| ≤ 2) : nspR (s, e) * nspQ s e = 1 := by
  have hq := nspQ_ge n he (s := s) (by linarith) (by linarith)
  have hq0 : nspQ s e ≠ 0 := by intro h0; rw [h0, abs_zero] at hq; linarith
  simp only [nspR, nspChi_eq_one h1 h2]
  field_simp

variable {Q : Type*} [NormedAddCommGroup Q] [NormedSpace ℝ Q]

/-- The integration-by-parts iterates `B_0 = A`, `B_{N+1} = ∂_s (B_N r)`, as functions of
`(s, e, q)`. -/
def nspB (A : ℝ × Q → ℂ) : ℕ → ℝ × (E3 × Q) → ℂ
  | 0 => fun x => A (x.1, x.2.2)
  | N + 1 => fun x => fderiv ℝ (fun y : ℝ × (E3 × Q) => nspB A N y * (nspR (y.1, y.2.1) : ℂ)) x
      (1, 0)

/-- The smooth region for the iterates. -/
def nspOX : Set (ℝ × (E3 × Q)) := {x | (x.1, x.2.1) ∈ nspO}

theorem isOpen_nspOX : IsOpen (nspOX (Q := Q)) :=
  isOpen_nspO.preimage (continuous_fst.prodMk (continuous_fst.comp continuous_snd))

theorem contDiffOn_nspR_X : ContDiffOn ℝ ((⊤ : ℕ∞) : WithTop ℕ∞)
    (fun y : ℝ × (E3 × Q) => ((nspR (y.1, y.2.1) : ℝ) : ℂ)) nspOX := by
  have h : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) fun y : ℝ × (E3 × Q) => (y.1, y.2.1) :=
    contDiff_fst.prodMk (contDiff_fst.comp contDiff_snd)
  exact (Complex.ofRealCLM.contDiff.comp_contDiffOn (contDiffOn_nspR.comp h.contDiffOn
    fun y hy => hy))

theorem contDiffOn_nspB {A : ℝ × Q → ℂ} (hA : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) A) :
    ∀ N, ContDiffOn ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (nspB A N) nspOX
  | 0 => (hA.comp (contDiff_fst.prodMk (contDiff_snd.comp contDiff_snd))).contDiffOn
  | N + 1 => by
      have hprod := (contDiffOn_nspB hA N).mul contDiffOn_nspR_X
      have hd := hprod.fderiv_of_isOpen isOpen_nspOX (m := ((⊤ : ℕ∞) : WithTop ℕ∞))
        (by exact_mod_cast le_top)
      exact hd.clm_apply contDiffOn_const

/-- The band `{1/2 ≤ |s| ≤ 2}` carrying the amplitudes. -/
def nspBand : Set ℝ := {s | 1 / 2 ≤ |s| ∧ |s| ≤ 2}

theorem isClosed_nspBand : IsClosed nspBand :=
  (isClosed_le continuous_const continuous_abs).inter (isClosed_le continuous_abs continuous_const)

theorem nspB_slice_contDiff {A : ℝ × Q → ℂ} (hA : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) A)
    {n : Fin 3} {e : E3} (he : e ∈ nspK n) (q : Q) (N : ℕ) :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun s => nspB A N (s, (e, q))) :=
  (contDiffOn_nspB hA N).comp_contDiff (contDiff_id.prodMk contDiff_const)
    (fun s => mem_nspO he s)

theorem nspR_slice_contDiff {n : Fin 3} {e : E3} (he : e ∈ nspK n) :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun s => nspR (s, e)) :=
  contDiffOn_nspR.comp_contDiff (contDiff_id.prodMk contDiff_const) (fun s => mem_nspO he s)

theorem nspB_succ_slice {A : ℝ × Q → ℂ} (hA : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) A)
    {n : Fin 3} {e : E3} (he : e ∈ nspK n) (q : Q) (N : ℕ) (s : ℝ) :
    nspB A (N + 1) (s, (e, q))
      = deriv (fun s => nspB A N (s, (e, q)) * ((nspR (s, e) : ℝ) : ℂ)) s := by
  set F : ℝ × (E3 × Q) → ℂ := fun y => nspB A N y * ((nspR (y.1, y.2.1) : ℝ) : ℂ) with hF
  have hFd : ContDiffOn ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) F nspOX :=
    (contDiffOn_nspB hA N).mul contDiffOn_nspR_X
  have hx : ((s, (e, q)) : ℝ × (E3 × Q)) ∈ nspOX := mem_nspO he s
  have hdiff : DifferentiableAt ℝ F (s, (e, q)) :=
    (hFd.differentiableOn (by simp)).differentiableAt (isOpen_nspOX.mem_nhds hx)
  have hg : HasDerivAt (fun s : ℝ => ((s, (e, q)) : ℝ × (E3 × Q))) ((1, 0) : ℝ × (E3 × Q)) s :=
    (hasDerivAt_id s).prodMk (hasDerivAt_const s (e, q))
  have hcomp := hdiff.hasFDerivAt.comp_hasDerivAt s hg
  have e1 : (fun s => nspB A N (s, (e, q)) * ((nspR (s, e) : ℝ) : ℂ))
      = F ∘ fun s : ℝ => ((s, (e, q)) : ℝ × (E3 × Q)) := rfl
  rw [e1, hcomp.deriv]
  rfl

theorem tsupport_nspB_slice {A : ℝ × Q → ℂ} (hA : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) A)
    (hAs : ∀ q s, A (s, q) ≠ 0 → s ∈ nspBand) {n : Fin 3} {e : E3} (he : e ∈ nspK n) (q : Q) :
    ∀ N, tsupport (fun s => nspB A N (s, (e, q))) ⊆ nspBand
  | 0 => closure_minimal (fun s hs => hAs q s hs) isClosed_nspBand
  | N + 1 => by
      have h : (fun s => nspB A (N + 1) (s, (e, q)))
          = deriv (fun s => nspB A N (s, (e, q)) * ((nspR (s, e) : ℝ) : ℂ)) := by
        funext s; exact nspB_succ_slice hA he q N s
      rw [h]
      exact (tsupport_deriv_subset).trans (tsupport_mul_subset_left.trans
        (tsupport_nspB_slice hA hAs he q N))

theorem nspK_isCompact (n : Fin 3) : IsCompact (nspK n) := by
  refine Metric.isCompact_of_isClosed_isBounded ?_ ?_
  · have e : nspK n = {e : E3 | e n = 1} ∩ ⋂ m : Fin 3, ⋂ (_ : m ≠ n), {e : E3 | |e m| ≤ 1 / 32} := by
      ext e; simp [nspK]
    rw [e]
    refine IsClosed.inter (isClosed_eq (continuous_evalCoord n) continuous_const) ?_
    refine isClosed_iInter fun m => isClosed_iInter fun _ => ?_
    exact isClosed_le ((continuous_evalCoord m).abs) continuous_const
  · refine (Metric.isBounded_closedBall (x := (0 : E3)) (r := 3)).subset fun e he => ?_
    rw [Metric.mem_closedBall, dist_zero_right]
    obtain ⟨hn, hm⟩ := he
    have hle : ∀ m : Fin 3, |e m| ≤ 1 := by
      intro m
      by_cases h : m = n
      · subst h; rw [hn, abs_one]
      · exact (hm m h).trans (by norm_num)
    have := norm_le_sum_abs_E3 e
    linarith [hle 0, hle 1, hle 2]

theorem hasCompactSupport_of_tsupport_band {b : ℝ → ℂ} (hb : tsupport b ⊆ nspBand) :
    HasCompactSupport b := by
  refine IsCompact.of_isClosed_subset (isCompact_Icc (a := -2) (b := 2)) (isClosed_tsupport b)
    (hb.trans fun s hs => ?_)
  exact ⟨by linarith [neg_abs_le s, hs.2], le_trans (le_abs_self s) hs.2⟩

/-- **Non-stationary phase** (lines 411-418), uniform over a compact family of amplitudes:
for a smooth amplitude family `A(s, q)` supported in `{1/2 ≤ |s| ≤ 2}`, a compact parameter
set `Qc` and `N ∈ ℕ`, there is `C` with
`|∫ A(s, q) e(-λ ⟨γ(s), e⟩) ds| ≤ C |λ|^{-N}` for `λ ≠ 0`, `q ∈ Qc` and every admissible
normalized frequency `e ∈ nspK n` (`e_n = 1`, `|e_m| ≤ 1/32` for `m ≠ n`). -/
theorem nsp_decay {A : ℝ × Q → ℂ} (hA : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) A)
    (hAs : ∀ q s, A (s, q) ≠ 0 → s ∈ nspBand) (n : Fin 3) {Qc : Set Q} (hQc : IsCompact Qc)
    (N : ℕ) : ∃ C : ℝ, 0 ≤ C ∧ ∀ (lam : ℝ), lam ≠ 0 → ∀ e ∈ nspK n, ∀ q ∈ Qc,
      ‖∫ s, A (s, q) * (Real.fourierChar (-(lam * inner ℝ (gammaCurve s) e)) : ℂ)‖
        ≤ C * (|lam| ^ N)⁻¹ := by
  set K : Set (ℝ × (E3 × Q)) := Icc (-2 : ℝ) 2 ×ˢ (nspK n ×ˢ Qc) with hK
  have hKc : IsCompact K := isCompact_Icc.prod ((nspK_isCompact n).prod hQc)
  have hKO : K ⊆ nspOX := fun x hx => mem_nspO hx.2.1 x.1
  obtain ⟨M, hM⟩ := hKc.exists_bound_of_continuousOn
    ((contDiffOn_nspB hA N).continuousOn.mono hKO)
  refine ⟨4 * max M 0, by positivity, fun lam hlam e he q hq => ?_⟩
  have hiter : ∀ k : ℕ, ∫ s, A (s, q) * (Real.fourierChar (-(lam * inner ℝ (gammaCurve s) e)) : ℂ)
      = ((2 * Real.pi * Complex.I * lam)⁻¹) ^ k *
          ∫ s, nspB A k (s, (e, q)) * (Real.fourierChar (-(lam * inner ℝ (gammaCurve s) e)) : ℂ) := by
    intro k
    induction k with
    | zero => simp [nspB]
    | succ k ih =>
      rw [ih, pow_succ, mul_assoc (((2 * Real.pi * Complex.I * lam)⁻¹) ^ k)]
      congr 1
      have hb := nspB_slice_contDiff hA he q k
      have hbc : HasCompactSupport (fun s => nspB A k (s, (e, q))) :=
        hasCompactSupport_of_tsupport_band (tsupport_nspB_slice hA hAs he q k)
      rw [integral_fourierChar_ibp (hb.of_le (by exact_mod_cast le_top)) hbc
        ((nspR_slice_contDiff he).of_le (by exact_mod_cast le_top))
        (fun s => hasDerivAt_inner_gammaCurve e s)
        (continuous_nspQ.comp (continuous_id.prodMk continuous_const))
        (fun s hs => nspR_mul_nspQ he (tsupport_nspB_slice hA hAs he q k hs).1
          (tsupport_nspB_slice hA hAs he q k hs).2) hlam]
      congr 1
      refine integral_congr_ae (Eventually.of_forall fun s => ?_)
      dsimp only
      rw [nspB_succ_slice hA he q k s]
  rw [hiter N, norm_mul, norm_pow, norm_inv]
  have h2pi : ‖2 * Real.pi * Complex.I * lam‖ = 2 * Real.pi * |lam| := by
    simp [Complex.norm_real, abs_of_pos Real.pi_pos]
  rw [h2pi]
  have hint : ‖∫ s, nspB A N (s, (e, q)) *
      (Real.fourierChar (-(lam * inner ℝ (gammaCurve s) e)) : ℂ)‖ ≤ 4 * max M 0 := by
    refine (norm_integral_le_integral_norm _).trans ?_
    have hsupp : ∀ s, s ∉ Icc (-2 : ℝ) 2 → nspB A N (s, (e, q)) = 0 := by
      intro s hs
      refine image_eq_zero_of_notMem_tsupport (f := fun s => nspB A N (s, (e, q))) (x := s)
        fun h => hs ?_
      obtain ⟨-, h2⟩ := tsupport_nspB_slice hA hAs he q N h
      exact ⟨by linarith [neg_abs_le s], le_trans (le_abs_self s) h2⟩
    calc ∫ s, ‖nspB A N (s, (e, q)) * (Real.fourierChar (-(lam * inner ℝ (gammaCurve s) e)) : ℂ)‖
        = ∫ s in Icc (-2 : ℝ) 2, ‖nspB A N (s, (e, q))‖ := by
          rw [← integral_indicator measurableSet_Icc]
          refine integral_congr_ae (Eventually.of_forall fun s => ?_)
          by_cases hs : s ∈ Icc (-2 : ℝ) 2
          · simp [indicator_of_mem hs, Circle.norm_coe]
          · simp [indicator_of_notMem hs, hsupp s hs]
      _ ≤ ∫ s in Icc (-2 : ℝ) 2, max M 0 := by
          refine setIntegral_mono_on ?_ continuous_const.integrableOn_Icc measurableSet_Icc
            fun s hs => (hM (s, (e, q)) ⟨hs, he, hq⟩).trans (le_max_left _ _)
          exact ((nspB_slice_contDiff hA he q N).continuous.norm.integrableOn_Icc)
      _ = 4 * max M 0 := by
          rw [setIntegral_const, Real.volume_real_Icc_of_le (by norm_num)]; norm_num
  have hlam' : 0 < |lam| := abs_pos.mpr hlam
  calc ((2 * Real.pi * |lam|)⁻¹) ^ N * ‖∫ s, nspB A N (s, (e, q)) *
        (Real.fourierChar (-(lam * inner ℝ (gammaCurve s) e)) : ℂ)‖
      ≤ ((2 * Real.pi * |lam|)⁻¹) ^ N * (4 * max M 0) := by gcongr
    _ ≤ (|lam|⁻¹) ^ N * (4 * max M 0) := by
        gcongr
        nlinarith [Real.pi_gt_three, abs_nonneg lam]
    _ = 4 * max M 0 * (|lam| ^ N)⁻¹ := by rw [inv_pow]; ring

theorem contDiff_wL : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) wL := by
  rw [contDiff_iff_contDiffAt]
  intro s
  by_cases hs : s = 0
  · subst hs
    have : wL =ᶠ[𝓝 0] fun _ => 0 := by
      filter_upwards [Metric.ball_mem_nhds (0 : ℝ) (by norm_num : (0 : ℝ) < 1 / 2)] with t ht
      rw [Metric.mem_ball, dist_zero_right, Real.norm_eq_abs] at ht
      exact wL_eq_zero_of_abs_lt ht
    exact contDiffAt_const.congr_of_eventuallyEq this
  · have hψ : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) lpPsi :=
      contDiff_lpPhi.sub (contDiff_lpPhi.comp (contDiff_const.mul contDiff_id))
    exact hψ.contDiffAt.div contDiffAt_id hs

theorem wL_ne_zero_band {s : ℝ} (h : wL s ≠ 0) : s ∈ nspBand := by
  have hψ : lpPsi s ≠ 0 := by intro h0; apply h; simp [wL, h0]
  obtain ⟨h1, h2⟩ := lpPsi_support hψ
  exact ⟨h1, h2.le⟩

/-- The amplitude of `D^k θ` applied to `w = (w_1, ..., w_k)`. -/
def thetaAmp (k : ℕ) (x : ℝ × (Fin k → E3)) : ℂ :=
  (-(2 * Real.pi * Complex.I)) ^ k * ((∏ i, inner ℝ (gammaCurve x.1) (x.2 i) : ℝ) : ℂ) *
    ((wL x.1 : ℝ) : ℂ)

theorem contDiff_thetaAmp (k : ℕ) : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (thetaAmp k) := by
  unfold thetaAmp
  have hγ : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) gammaCurve := by
    unfold gammaCurve curve
    exact ContDiff.sum fun n _ => (contDiff_id.pow _).smul contDiff_const
  have h1 : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞)
      (fun x : ℝ × (Fin k → E3) => ∏ i, inner ℝ (gammaCurve x.1) (x.2 i)) := by
    refine contDiff_prod fun i _ => ?_
    have hi : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) fun f : Fin k → E3 => f i :=
      contDiff_apply ℝ E3 i
    exact (hγ.comp contDiff_fst).inner ℝ (hi.comp contDiff_snd)
  have h2 : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun x : ℝ × (Fin k → E3) => wL x.1) :=
    contDiff_wL.comp contDiff_fst
  have h1' := Complex.ofRealCLM.contDiff.comp h1
  have h2' := Complex.ofRealCLM.contDiff.comp h2
  exact (contDiff_const.mul h1').mul h2'

/-- **Rapid decay of `θ` and all its derivatives in the non-stationary region**
(lines 411-418): if `η_n` dominates, `|η_m| ≤ |η_n|/32` for `m ≠ n` and `|η_n| ≥ 1/2`, then
`‖D^k θ(η)‖ ≤ C_{k,N} |η_n|^{-N}`. -/
theorem thetaL_decay (n : Fin 3) (k N : ℕ) : ∃ C : ℝ, 0 ≤ C ∧ ∀ η : E3, 1 / 2 ≤ |η n| →
    (∀ m, m ≠ n → |η m| ≤ |η n| / 32) →
    ‖iteratedFDeriv ℝ k thetaL η‖ ≤ C * (|η n| ^ N)⁻¹ := by
  obtain ⟨C, hC0, hC⟩ := nsp_decay (contDiff_thetaAmp k)
    (fun w s hs => wL_ne_zero_band fun h0 => hs (by simp [thetaAmp, h0])) n
    (isCompact_closedBall (0 : Fin k → E3) 1) N
  refine ⟨C, hC0, fun η h1 h2 => ?_⟩
  have hηn : η n ≠ 0 := by intro h; rw [h, abs_zero] at h1; linarith
  set e : E3 := (η n)⁻¹ • η with he
  have heK : e ∈ nspK n := by
    refine ⟨by simp [he, hηn], fun m hm => ?_⟩
    simp only [he, PiLp.smul_apply, smul_eq_mul, abs_mul, abs_inv]
    rw [inv_mul_le_iff₀ (abs_pos.mpr hηn)]
    linarith [h2 m hm]
  have hphase : ∀ s, η n * inner ℝ (gammaCurve s) e = inner ℝ (gammaCurve s) η := by
    intro s
    rw [he, inner_smul_right, ← mul_assoc, mul_inv_cancel₀ hηn, one_mul]
  have hbound : ∀ w : Fin k → E3, (∀ i, ‖w i‖ ≤ 1) →
      ‖iteratedFDeriv ℝ k thetaL η w‖ ≤ C * (|η n| ^ N)⁻¹ := by
    intro w hw
    have hwmem : w ∈ Metric.closedBall (0 : Fin k → E3) 1 := by
      rw [Metric.mem_closedBall, dist_zero_right]
      exact (pi_norm_le_iff_of_nonneg zero_le_one).mpr hw
    have := hC (η n) hηn e heK w hwmem
    rw [iteratedFDeriv_thetaL_apply]
    convert this using 3
    funext s
    simp only [thetaAmp, hphase]
    ring
  refine ContinuousMultilinearMap.opNorm_le_bound (by positivity) fun w => ?_
  by_cases hz : ∃ i, w i = 0
  · obtain ⟨i, hi⟩ := hz
    rw [(iteratedFDeriv ℝ k thetaL η).map_coord_zero i hi, norm_zero]
    exact mul_nonneg (by positivity) (Finset.prod_nonneg fun i _ => norm_nonneg _)
  · push Not at hz
    set u : Fin k → E3 := fun i => ‖w i‖⁻¹ • w i with hu
    have hw : w = fun i => ‖w i‖ • u i := by
      funext i; simp [hu, smul_smul, mul_inv_cancel₀ (norm_ne_zero_iff.mpr (hz i))]
    have hun : ∀ i, ‖u i‖ ≤ 1 := fun i => by
      simp [hu, norm_smul, inv_mul_cancel₀ (norm_ne_zero_iff.mpr (hz i))]
    rw [hw, ContinuousMultilinearMap.map_smul_univ, norm_smul, Real.norm_eq_abs,
      abs_of_nonneg (Finset.prod_nonneg fun i _ => norm_nonneg _)]
    have hwn : ∀ i, ‖(fun i => ‖w i‖ • u i) i‖ = ‖w i‖ := fun i => by
      simp [norm_smul, hu, inv_mul_cancel₀ (norm_ne_zero_iff.mpr (hz i))]
    simp only [hwn]
    rw [mul_comm]
    exact mul_le_mul_of_nonneg_right (hbound u hun) (Finset.prod_nonneg fun i _ => norm_nonneg _)

/-! ### The mixed-frequency symbol `κ̂_{ML,n}`, lines 389-421 -/

/-- The fixed cutoff `G_n(ζ) = ψ(ζ_n) ∏_{m ≠ n} φ(ζ_m)`. -/
def mlG (n : Fin 3) (ζ : E3) : ℝ := lpPsi (ζ n) * ∏ m ∈ Finset.univ.erase n, lpPhi (ζ m)

/-- The scaling factors `a_n = 2^{-κ}`, `a_m = 2^{101-κ}` (`m ≠ n`). -/
def mlScale (n : Fin 3) (κ : ℤ) (m : Fin 3) : ℝ :=
  if m = n then (2 : ℝ) ^ (-κ) else (2 : ℝ) ^ (101 - κ)

/-- The diagonal scaling `L_κ ζ = (a_m ζ_m)_m`. -/
def mlL (n : Fin 3) (κ : ℤ) : E3 →L[ℝ] E3 :=
  LinearMap.toContinuousLinearMap (Matrix.toLpLin 2 2 (Matrix.diagonal (mlScale n κ)))

theorem mlL_apply (n : Fin 3) (κ : ℤ) (ζ : E3) (m : Fin 3) :
    mlL n κ ζ m = mlScale n κ m * ζ m := by
  simp [mlL, Matrix.toLpLin_apply, Matrix.mulVec_diagonal]

/-- The cutoff `c_κ(η) = ψ(2^{-κ} η_n) ∏_{m ≠ n} φ(2^{101-κ} η_m)` of the `κ`-th piece. -/
def mlCut (n : Fin 3) (κ : ℤ) (η : E3) : ℝ := mlG n (mlL n κ η)

theorem mlCut_apply (n : Fin 3) (κ : ℤ) (η : E3) :
    mlCut n κ η = lpPsi ((2 : ℝ) ^ (-κ) * η n) *
      ∏ m ∈ Finset.univ.erase n, lpPhi ((2 : ℝ) ^ (101 - κ) * η m) := by
  simp only [mlCut, mlG, mlL_apply, mlScale]
  congr 1
  refine Finset.prod_congr rfl fun m hm => ?_
  rw [if_neg (Finset.ne_of_mem_erase hm)]

theorem contDiff_mlG (n : Fin 3) : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (mlG n) := by
  unfold mlG
  have hψ : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) lpPsi :=
    contDiff_lpPhi.sub (contDiff_lpPhi.comp (contDiff_const.mul contDiff_id))
  exact (hψ.comp (EuclideanSpace.proj (𝕜 := ℝ) n).contDiff).mul
    (contDiff_prod fun m _ => contDiff_lpPhi.comp (EuclideanSpace.proj (𝕜 := ℝ) m).contDiff)

theorem hasCompactSupport_mlG (n : Fin 3) : HasCompactSupport (mlG n) := by
  refine HasCompactSupport.intro (isCompact_closedBall (0 : E3) 6) fun ζ hζ => ?_
  rw [Metric.mem_closedBall, dist_zero_right, not_le] at hζ
  have hn := norm_le_sum_abs_E3 ζ
  have : ∃ m : Fin 3, 2 ≤ |ζ m| := by
    by_contra h; push Not at h
    have := h 0; have := h 1; have := h 2; linarith
  obtain ⟨m, hm⟩ := this
  unfold mlG
  by_cases hmn : m = n
  · subst hmn; rw [lpPsi_eq_zero_of_le_abs hm, zero_mul]
  · rw [Finset.prod_eq_zero (Finset.mem_erase.mpr ⟨hmn, Finset.mem_univ m⟩) (lpPhi_eq_zero hm),
      mul_zero]

theorem contDiff_mlCut (n : Fin 3) (κ : ℤ) :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (mlCut n κ) :=
  (contDiff_mlG n).comp (mlL n κ).contDiff

/-- The support region of the `κ`-th piece. -/
def mlRegion (n : Fin 3) (κ : ℤ) : Set E3 :=
  {η | (2 : ℝ) ^ (κ - 1) ≤ |η n| ∧ |η n| ≤ (2 : ℝ) ^ (κ + 1) ∧
    ∀ m, m ≠ n → |η m| ≤ (2 : ℝ) ^ (κ - 100)}

theorem isClosed_mlRegion (n : Fin 3) (κ : ℤ) : IsClosed (mlRegion n κ) := by
  have e : mlRegion n κ = {η : E3 | (2 : ℝ) ^ (κ - 1) ≤ |η n|} ∩ {η : E3 | |η n| ≤ (2 : ℝ) ^ (κ + 1)} ∩
      ⋂ m : Fin 3, ⋂ (_ : m ≠ n), {η : E3 | |η m| ≤ (2 : ℝ) ^ (κ - 100)} := by
    ext η; simp [mlRegion, and_assoc]
  rw [e]
  refine ((isClosed_le continuous_const (continuous_evalCoord n).abs).inter
    (isClosed_le (continuous_evalCoord n).abs continuous_const)).inter ?_
  exact isClosed_iInter fun m => isClosed_iInter fun _ =>
    isClosed_le (continuous_evalCoord m).abs continuous_const

theorem tsupport_mlCut (n : Fin 3) (κ : ℤ) : tsupport (mlCut n κ) ⊆ mlRegion n κ := by
  refine closure_minimal (fun η hη => ?_) (isClosed_mlRegion n κ)
  rw [Function.mem_support, mlCut_apply] at hη
  have hψ : lpPsi ((2 : ℝ) ^ (-κ) * η n) ≠ 0 := left_ne_zero_of_mul hη
  have hφ : ∀ m ∈ Finset.univ.erase n, lpPhi ((2 : ℝ) ^ (101 - κ) * η m) ≠ 0 :=
    fun m hm h0 => right_ne_zero_of_mul hη (Finset.prod_eq_zero hm h0)
  obtain ⟨h1, h2⟩ := lpPsi_support hψ
  have hq : (0 : ℝ) < 2 ^ (-κ) := zpow_pos two_pos _
  rw [abs_mul, abs_of_pos hq] at h1 h2
  have ek : (2 : ℝ) ^ (-κ) * 2 ^ κ = 1 := by rw [← zpow_add₀ two_ne_zero, neg_add_cancel, zpow_zero]
  have hk : (0 : ℝ) < 2 ^ κ := zpow_pos two_pos _
  refine ⟨?_, ?_, fun m hm => ?_⟩
  · rw [zpow_sub₀ two_ne_zero, zpow_one]; nlinarith
  · rw [zpow_add₀ two_ne_zero, zpow_one]; nlinarith
  · have := hφ m (Finset.mem_erase.mpr ⟨hm, Finset.mem_univ m⟩)
    by_contra hc
    push Not at hc
    apply this
    apply lpPhi_eq_zero
    rw [abs_mul, abs_of_pos (zpow_pos two_pos _)]
    have e2 : (2 : ℝ) ^ (101 - κ) * 2 ^ (κ - 100) = 2 := by
      rw [← zpow_add₀ two_ne_zero]; norm_num
    have hp : (0 : ℝ) < 2 ^ (101 - κ) := zpow_pos two_pos _
    nlinarith

theorem abs_mlScale_le (n : Fin 3) {κ : ℤ} (hκ : 1 ≤ κ) (m : Fin 3) :
    |mlScale n κ m| ≤ 2 ^ 100 := by
  unfold mlScale
  split_ifs
  · rw [abs_of_pos (zpow_pos two_pos _)]
    calc (2 : ℝ) ^ (-κ) ≤ 2 ^ (100 : ℤ) := zpow_le_zpow_right₀ (by norm_num) (by omega)
      _ = 2 ^ 100 := by norm_num
  · rw [abs_of_pos (zpow_pos two_pos _)]
    calc (2 : ℝ) ^ (101 - κ) ≤ 2 ^ (100 : ℤ) := zpow_le_zpow_right₀ (by norm_num) (by omega)
      _ = 2 ^ 100 := by norm_num

theorem norm_mlL_le (n : Fin 3) {κ : ℤ} (hκ : 1 ≤ κ) : ‖mlL n κ‖ ≤ 2 ^ 100 := by
  refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) fun ζ => ?_
  rw [EuclideanSpace.norm_eq, EuclideanSpace.norm_eq, ← Real.sqrt_sq (show (0 : ℝ) ≤ 2 ^ 100 by
    positivity), ← Real.sqrt_mul (by positivity)]
  refine Real.sqrt_le_sqrt ?_
  rw [Finset.mul_sum]
  refine Finset.sum_le_sum fun m _ => ?_
  rw [mlL_apply, Real.norm_eq_abs, Real.norm_eq_abs, abs_mul, mul_pow, sq_abs, sq_abs]
  have h := abs_mlScale_le n hκ m
  have : mlScale n κ m ^ 2 ≤ (2 ^ 100) ^ 2 := by
    rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) h _
  exact mul_le_mul_of_nonneg_right this (sq_nonneg _)

theorem mlCut_deriv_bound (n : Fin 3) (i : ℕ) : ∃ C : ℝ, 0 ≤ C ∧ ∀ κ : ℤ, 1 ≤ κ → ∀ η,
    ‖iteratedFDeriv ℝ i (mlCut n κ) η‖ ≤ C := by
  obtain ⟨C0, hC0⟩ := ((contDiff_mlG n).continuous_iteratedFDeriv (natCast_le_smooth i)).norm
    |>.bounded_above_of_compact_support ((hasCompactSupport_mlG n).iteratedFDeriv i).norm
  refine ⟨max C0 0 * (2 ^ 100) ^ i, by positivity, fun κ hκ η => ?_⟩
  have e : mlCut n κ = mlG n ∘ mlL n κ := rfl
  rw [e, (mlL n κ).iteratedFDeriv_comp_right (contDiff_mlG n) η (natCast_le_smooth i)]
  refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
  rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  refine mul_le_mul ?_ (pow_le_pow_left₀ (norm_nonneg _) (norm_mlL_le n hκ) _)
    (by positivity) (le_max_right _ _)
  exact le_trans (by simpa [Real.norm_eq_abs] using hC0 (mlL n κ η)) (le_max_left _ _)

theorem mlCut_deriv_eq_zero (n : Fin 3) (κ : ℤ) (i : ℕ) {η : E3} (h : η ∉ mlRegion n κ) :
    iteratedFDeriv ℝ i (mlCut n κ) η = 0 := by
  have : η ∉ tsupport (mlCut n κ) := fun h' => h (tsupport_mlCut n κ h')
  exact image_eq_zero_of_notMem_tsupport fun h' => this (tsupport_iteratedFDeriv_subset i h')

theorem rpow_inv_le_max {t : ℝ} (ht : 0 ≤ t) {a : ℕ} (ha : 1 ≤ a) :
    t ^ ((a : ℝ)⁻¹) ≤ max 1 t := by
  have ha' : (0 : ℝ) < (a : ℝ)⁻¹ := by positivity
  have ha1 : (a : ℝ)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (by exact_mod_cast ha)
  rcases le_or_gt t 1 with h | h
  · exact le_trans (Real.rpow_le_one ht h ha'.le) (le_max_left _ _)
  · exact le_trans (by simpa using Real.rpow_le_rpow_of_exponent_le h.le ha1) (le_max_right _ _)

theorem mlRegion_facts (n : Fin 3) {κ : ℤ} (hκ : 1 ≤ κ) {η : E3} (h : η ∈ mlRegion n κ) :
    (2 : ℝ) ^ (κ - 1) ≤ |η n| ∧ 1 ≤ |η n| ∧ (∀ m, m ≠ n → |η m| ≤ |η n| / 32) ∧
      alpha123.radius η ≤ 3 * |η n| := by
  obtain ⟨h1, h2, h3⟩ := h
  have hk1 : (1 : ℝ) ≤ 2 ^ (κ - 1) := one_le_zpow₀ (by norm_num) (by omega)
  have hn1 : 1 ≤ |η n| := hk1.trans h1
  have hsmall : ∀ m, m ≠ n → |η m| ≤ |η n| / 32 := by
    intro m hm
    refine (h3 m hm).trans ?_
    have : (2 : ℝ) ^ (κ - 100) * 32 ≤ 2 ^ (κ - 1) := by
      rw [show (32 : ℝ) = 2 ^ (5 : ℤ) by norm_num, ← zpow_add₀ two_ne_zero]
      exact zpow_le_zpow_right₀ (by norm_num) (by omega)
    linarith
  refine ⟨h1, hn1, hsmall, ?_⟩
  have hterm : ∀ m : Fin 3, |η m| ^ ((alpha123.weight m : ℝ)⁻¹) ≤ |η n| := by
    intro m
    refine (rpow_inv_le_max (abs_nonneg _) (alpha123_weight_pos m)).trans (max_le hn1 ?_)
    by_cases hm : m = n
    · rw [hm]
    · exact (hsmall m hm).trans (by linarith)
  have : alpha123.radius η = ∑ m : Fin 3, |η m| ^ ((alpha123.weight m : ℝ)⁻¹) := rfl
  rw [this, Fin.sum_univ_three]
  linarith [hterm 0, hterm 1, hterm 2]

/-- The `κ`-th piece `μ_κ = c_κ θ` of `κ̂_{ML,n}`. -/
def mlPiece (n : Fin 3) (κ : ℤ) (η : E3) : ℂ := ((mlCut n κ η : ℝ) : ℂ) * thetaL η

theorem contDiff_mlPiece (n : Fin 3) (κ : ℤ) :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (mlPiece n κ) :=
  (Complex.ofRealCLM.contDiff.comp (contDiff_mlCut n κ)).mul contDiff_thetaL

/-- **The uniform estimate for the pieces**:
`‖D^k μ_κ(η)‖ (1 + ρ(η))^{331} ≤ B 2^{-κ}` for `κ ≥ 1` and `k ≤ 110`. -/
theorem mlPiece_bound (n : Fin 3) : ∃ B : ℝ, 0 ≤ B ∧ ∀ κ : ℤ, 1 ≤ κ → ∀ k, k ≤ 110 → ∀ η,
    ‖iteratedFDeriv ℝ k (mlPiece n κ) η‖ * (1 + alpha123.radius η) ^ 331
      ≤ B * (2 : ℝ) ^ (-κ) := by
  choose Cc hCc0 hCc using fun i => mlCut_deriv_bound n i
  choose Cθ hCθ0 hCθ using fun j => thetaL_decay n j 332
  set Bk : ℕ → ℝ := fun k => ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * Cc i * Cθ (k - i)
    with hBk
  have hBk0 : ∀ k, 0 ≤ Bk k := fun k => Finset.sum_nonneg fun i _ =>
    mul_nonneg (mul_nonneg (by positivity) (hCc0 i)) (hCθ0 _)
  set c4 : ℝ := (4 : ℝ) ^ 331 with hc4
  have hc40 : 0 ≤ c4 := pow_nonneg (by norm_num) _
  set Bs : ℝ := ∑ k ∈ Finset.range 111, Bk k with hBs
  have hBs0 : 0 ≤ Bs := Finset.sum_nonneg fun k _ => hBk0 k
  set B : ℝ := 2 * c4 * Bs with hB
  refine ⟨B, mul_nonneg (mul_nonneg zero_le_two hc40) hBs0, fun κ hκ k hk η => ?_⟩
  have hBkB : Bk k ≤ Bs :=
    Finset.single_le_sum (f := Bk) (fun k _ => hBk0 k) (Finset.mem_range.mpr (by omega))
  have hleib := norm_iteratedFDeriv_mul_le (𝕜 := ℝ) (N := ((⊤ : ℕ∞) : WithTop ℕ∞))
    (Complex.ofRealCLM.contDiff.comp (contDiff_mlCut n κ)) contDiff_thetaL η
    (natCast_le_smooth k) (n := k)
  have hcomp : ∀ i, ‖iteratedFDeriv ℝ i (⇑Complex.ofRealCLM ∘ mlCut n κ) η‖
      ≤ ‖iteratedFDeriv ℝ i (mlCut n κ) η‖ := by
    intro i
    refine (Complex.ofRealCLM.norm_iteratedFDeriv_comp_left
      ((contDiff_mlCut n κ).contDiffAt) (natCast_le_smooth i)).trans ?_
    have hL1 : ‖Complex.ofRealCLM‖ ≤ 1 :=
      ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun x => by simp [Complex.norm_real]
    exact mul_le_of_le_one_left (norm_nonneg _) hL1
  have hfun : mlPiece n κ = fun y => (⇑Complex.ofRealCLM ∘ mlCut n κ) y * thetaL y := rfl
  by_cases hreg : η ∈ mlRegion n κ
  · obtain ⟨hk1, hn1, hsmall, hrad⟩ := mlRegion_facts n hκ hreg
    have hηn : 0 < |η n| := by linarith
    have hpow : 0 < |η n| ^ 332 := by positivity
    -- the derivative bound
    have hD : ‖iteratedFDeriv ℝ k (mlPiece n κ) η‖ ≤ Bk k * (|η n| ^ 332)⁻¹ := by
      rw [hfun]
      refine hleib.trans ?_
      simp only [hBk, Finset.sum_mul]
      refine Finset.sum_le_sum fun i _ => ?_
      rw [mul_assoc, mul_assoc, mul_assoc]
      refine mul_le_mul_of_nonneg_left ?_ (by positivity)
      have h1 := (hcomp i).trans (hCc i κ hκ η)
      have h2 := hCθ (k - i) η (by linarith) hsmall
      calc ‖iteratedFDeriv ℝ i (⇑Complex.ofRealCLM ∘ mlCut n κ) η‖ *
            ‖iteratedFDeriv ℝ (k - i) thetaL η‖
          ≤ Cc i * (Cθ (k - i) * (|η n| ^ 332)⁻¹) :=
            mul_le_mul h1 h2 (norm_nonneg _) (hCc0 i)
        _ = Cc i * (Cθ (k - i) * (|η n| ^ 332)⁻¹) := rfl
    have h0r : 0 ≤ alpha123.radius η := by unfold Twisted.Anisotropy.radius; positivity
    have hR : (1 + alpha123.radius η) ^ 331 ≤ c4 * |η n| ^ 331 := by
      rw [hc4, ← mul_pow]
      exact pow_le_pow_left₀ (by linarith) (by linarith) _
    have h2k : (|η n|)⁻¹ ≤ 2 * (2 : ℝ) ^ (-κ) := by
      rw [inv_le_iff_one_le_mul₀ hηn]
      have : (1 : ℝ) = 2 * 2 ^ (-κ) * 2 ^ (κ - 1) := by
        rw [mul_assoc, ← zpow_add₀ two_ne_zero, show -κ + (κ - 1) = -1 by ring, zpow_neg_one]
        norm_num
      rw [this]
      exact mul_le_mul_of_nonneg_left hk1 (by positivity)
    have hx331 : 0 ≤ |η n| ^ 331 := pow_nonneg (abs_nonneg _) _
    have hBk0' := hBk0 k
    have e1 : (Bk k * (|η n| ^ 332)⁻¹) * (c4 * |η n| ^ 331) = c4 * Bk k * (|η n|)⁻¹ := by
      rw [pow_succ]
      field_simp
    calc ‖iteratedFDeriv ℝ k (mlPiece n κ) η‖ * (1 + alpha123.radius η) ^ 331
        ≤ (Bk k * (|η n| ^ 332)⁻¹) * (c4 * |η n| ^ 331) :=
          mul_le_mul hD hR (pow_nonneg (by linarith) _)
            (mul_nonneg hBk0' (inv_nonneg.mpr hpow.le))
      _ = c4 * Bk k * (|η n|)⁻¹ := e1
      _ ≤ c4 * Bs * (2 * (2 : ℝ) ^ (-κ)) :=
          mul_le_mul (mul_le_mul_of_nonneg_left hBkB hc40) h2k (inv_nonneg.mpr hηn.le)
            (mul_nonneg hc40 hBs0)
      _ = B * (2 : ℝ) ^ (-κ) := by rw [hB]; ring
  · -- off the region every derivative of the cutoff vanishes
    have h0 : ‖iteratedFDeriv ℝ k (mlPiece n κ) η‖ = 0 := by
      refine le_antisymm ?_ (norm_nonneg _)
      rw [hfun]
      refine hleib.trans (le_of_eq ?_)
      refine Finset.sum_eq_zero fun i _ => ?_
      have : ‖iteratedFDeriv ℝ i (⇑Complex.ofRealCLM ∘ mlCut n κ) η‖ = 0 := by
        refine le_antisymm ((hcomp i).trans (le_of_eq ?_)) (norm_nonneg _)
        rw [mlCut_deriv_eq_zero n κ i hreg, norm_zero]
      rw [this, mul_zero, zero_mul]
    rw [h0, zero_mul]
    exact mul_nonneg (mul_nonneg (mul_nonneg zero_le_two hc40) hBs0) (zpow_pos two_pos _).le

/-- **`κ̂_{ML,n}`** truncated to `1 ≤ κ ≤ K_0` (lines 399-405, with the sum over `k > 0` cut
at `K_0`): `∑_{κ=1}^{K_0} ψ(2^{-κ} η_n) ∏_{m≠n} φ(2^{101-κ} η_m) θ(η)`. -/
def kappaML (n : Fin 3) (K0 : ℕ) (η : E3) : ℂ :=
  ∑ κ ∈ Finset.Icc (1 : ℤ) K0, mlPiece n κ η

theorem contDiff_kappaML (n : Fin 3) (K0 : ℕ) :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (kappaML n K0) := by
  unfold kappaML
  exact ContDiff.sum fun κ _ => contDiff_mlPiece n κ

/-- **`κ̂_{ML,n}` vanishes near the origin** (lines 406-409): it is zero where `|η_n| < 1/2`. -/
theorem kappaML_eq_zero (n : Fin 3) (K0 : ℕ) {η : E3} (h : |η n| < 1 / 2) : kappaML n K0 η = 0 := by
  unfold kappaML
  refine Finset.sum_eq_zero fun κ hκ => ?_
  have hκ1 : 1 ≤ κ := (Finset.mem_Icc.mp hκ).1
  have : mlCut n κ η = 0 := by
    by_contra hne
    have := (mlRegion_facts n hκ1 (tsupport_mlCut n κ (subset_tsupport _ hne))).2.1
    linarith
  simp [mlPiece, this]

theorem sum_two_zpow_neg_le (K0 : ℕ) : ∑ κ ∈ Finset.Icc (1 : ℤ) K0, (2 : ℝ) ^ (-κ) ≤ 1 := by
  have e : ∑ κ ∈ Finset.Icc (1 : ℤ) K0, (2 : ℝ) ^ (-κ)
      = ∑ i ∈ Finset.range K0, (1 / 2 : ℝ) * (1 / 2) ^ i := by
    refine Finset.sum_nbij' (fun κ => (κ - 1).toNat) (fun i => (i : ℤ) + 1) ?_ ?_ ?_ ?_ ?_
    · intro κ hκ; simp only [Finset.mem_Icc] at hκ; simp only [Finset.mem_range]; omega
    · intro i hi; simp only [Finset.mem_range] at hi; simp only [Finset.mem_Icc]; omega
    · intro κ hκ; simp only [Finset.mem_Icc] at hκ; omega
    · intro i _; simp
    · intro κ hκ
      simp only [Finset.mem_Icc] at hκ
      rw [← pow_succ', one_div, inv_pow, ← zpow_natCast, ← zpow_neg]
      congr 1; omega
  rw [e, ← Finset.mul_sum]
  have := sum_geometric_two_le K0
  linarith

theorem rpow_inv_ge_half {t : ℝ} (ht : 1 / 2 ≤ t) {a : ℕ} (ha : 1 ≤ a) :
    1 / 2 ≤ t ^ ((a : ℝ)⁻¹) := by
  have ha' : (0 : ℝ) < (a : ℝ)⁻¹ := by positivity
  have ha1 : (a : ℝ)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (by exact_mod_cast ha)
  rcases le_or_gt 1 t with h | h
  · exact le_trans (by norm_num) (Real.one_le_rpow h ha'.le)
  · have := Real.rpow_le_rpow_of_exponent_ge (by linarith) h.le ha1
    rw [Real.rpow_one] at this
    linarith

/-- **`K̂_{ML,n}` satisfies `eq:symbol_condition`** (lines 420-421), uniformly in the scale
truncation `J` and the frequency truncation `K_0`. -/
theorem kappaML_symbol (n : Fin 3) : ∃ M : ℝ, 0 ≤ M ∧ ∀ K0 J : ℕ,
    alpha123.IsAnisotropicMultiplier M (dyadicSum (kappaML n K0) J) := by
  obtain ⟨B, hB0, hB⟩ := mlPiece_bound n
  have hsum : ∀ K0 k, k ≤ 110 → ∀ η,
      ‖iteratedFDeriv ℝ k (kappaML n K0) η‖ * (1 + alpha123.radius η) ^ 331 ≤ B := by
    intro K0 k hk η
    have hfun : kappaML n K0 = fun η => ∑ κ ∈ Finset.Icc (1 : ℤ) K0, mlPiece n κ η := rfl
    rw [hfun, iteratedFDeriv_sum fun κ _ => (contDiff_mlPiece n κ).of_le (natCast_le_smooth k)]
    rw [Finset.sum_apply]
    have h0r : 0 ≤ (1 + alpha123.radius η) ^ 331 := by
      have : 0 ≤ alpha123.radius η := by unfold Twisted.Anisotropy.radius; positivity
      positivity
    calc ‖∑ κ ∈ Finset.Icc (1 : ℤ) K0, iteratedFDeriv ℝ k (mlPiece n κ) η‖ *
          (1 + alpha123.radius η) ^ 331
        ≤ (∑ κ ∈ Finset.Icc (1 : ℤ) K0, ‖iteratedFDeriv ℝ k (mlPiece n κ) η‖) *
          (1 + alpha123.radius η) ^ 331 :=
          mul_le_mul_of_nonneg_right (norm_sum_le _ _) h0r
      _ = ∑ κ ∈ Finset.Icc (1 : ℤ) K0, ‖iteratedFDeriv ℝ k (mlPiece n κ) η‖ *
          (1 + alpha123.radius η) ^ 331 := Finset.sum_mul _ _ _
      _ ≤ ∑ κ ∈ Finset.Icc (1 : ℤ) K0, B * (2 : ℝ) ^ (-κ) :=
          Finset.sum_le_sum fun κ hκ => hB κ (Finset.mem_Icc.mp hκ).1 k hk η
      _ = B * ∑ κ ∈ Finset.Icc (1 : ℤ) K0, (2 : ℝ) ^ (-κ) := by rw [Finset.mul_sum]
      _ ≤ B * 1 := mul_le_mul_of_nonneg_left (sum_two_zpow_neg_le K0) hB0
      _ = B := mul_one B
  refine ⟨6 * (2 * B), by positivity, fun K0 J => ?_⟩
  have hρ0 : ∀ η, 0 ≤ alpha123.radius η := fun η => by
    unfold Twisted.Anisotropy.radius; positivity
  have hone : ∀ η, 1 ≤ (1 + alpha123.radius η) ^ 331 := fun η =>
    one_le_pow₀ (by linarith [hρ0 η])
  have hρle : ∀ η, alpha123.radius η ≤ (1 + alpha123.radius η) ^ 331 := fun η =>
    le_trans (by linarith) (le_self_pow₀ (by linarith [hρ0 η]) (by norm_num))
  have hρle331 : ∀ η, alpha123.radius η ^ 331 ≤ (1 + alpha123.radius η) ^ 331 := fun η =>
    pow_le_pow_left₀ (hρ0 η) (by linarith) _
  have h0 : ∀ η, ‖kappaML n K0 η‖ * (1 + alpha123.radius η) ^ 331 ≤ B := fun η => by
    have := hsum K0 0 (by norm_num) η
    rwa [norm_iteratedFDeriv_zero] at this
  refine dyadicSum_isAnisotropicMultiplier (contDiff_kappaML n K0) (by positivity) (fun η => ?_)
    (fun η => ?_) (fun k hk1 hk η => ?_) (fun k hk1 hk η => ?_) J
  · by_cases hη : |η n| < 1 / 2
    · rw [kappaML_eq_zero n K0 hη, norm_zero]; exact mul_nonneg (by positivity) (hρ0 η)
    · push Not at hη
      have hr : 1 / 2 ≤ alpha123.radius η := by
        have := rpow_inv_ge_half hη (alpha123_weight_pos n)
        have hsum' : alpha123.radius η = ∑ m : Fin 3, |η m| ^ ((alpha123.weight m : ℝ)⁻¹) := rfl
        rw [hsum']
        refine le_trans this (Finset.single_le_sum (f := fun m => |η m| ^
          ((alpha123.weight m : ℝ)⁻¹)) (fun m _ => by positivity) (Finset.mem_univ n))
      have := (le_mul_of_one_le_right (norm_nonneg _) (hone η)).trans (h0 η)
      nlinarith
  · exact (mul_le_mul_of_nonneg_left (hρle η) (norm_nonneg _)).trans ((h0 η).trans (by linarith))
  · have := hsum K0 k hk η
    exact (le_mul_of_one_le_right (norm_nonneg _) (hone η)).trans (this.trans (by linarith))
  · have := hsum K0 k hk η
    exact (mul_le_mul_of_nonneg_left (hρle331 η) (norm_nonneg _)).trans
      (this.trans (by linarith))

/-! ### General coordinate multipliers and their kernels -/

/-- An admissible one-dimensional multiplier: smooth, compactly supported and even. -/
structure CoordMult where
  h : ℝ → ℝ
  smooth : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) h
  compact : HasCompactSupport h
  even : ∀ ζ, h (-ζ) = h ζ

namespace CoordMult

variable (χ : CoordMult)

theorem contDiff_complex : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun ζ : ℝ => ((χ.h ζ : ℝ) : ℂ)) :=
  Complex.ofRealCLM.contDiff.comp χ.smooth

theorem hasCompactSupport_complex : HasCompactSupport (fun ζ : ℝ => ((χ.h ζ : ℝ) : ℂ)) :=
  χ.compact.comp_left Complex.ofReal_zero

/-- `h` as a Schwartz function on `ℝ`. -/
def schwartz : 𝓢(ℝ, ℂ) := χ.hasCompactSupport_complex.toSchwartzMap χ.contDiff_complex

theorem schwartz_apply (ζ : ℝ) : χ.schwartz ζ = ((χ.h ζ : ℝ) : ℂ) := rfl

/-- The line kernel `ȟ = 𝓕^{-1} h`. -/
def check : 𝓢(ℝ, ℂ) := 𝓕⁻ χ.schwartz

theorem h_eq_fourier_check (ζ : ℝ) :
    ((χ.h ζ : ℝ) : ℂ) = ∫ u : ℝ, Real.fourierChar (-(u * ζ)) • χ.check u := by
  have hh := congrArg (fun F : 𝓢(ℝ, ℂ) => F ζ)
    (FourierInvPair.fourier_fourierInv_eq (E := 𝓢(ℝ, ℂ)) (F := 𝓢(ℝ, ℂ)) χ.schwartz)
  rw [SchwartzMap.fourier_coe, Real.fourier_eq] at hh
  rw [← χ.schwartz_apply, ← hh]
  congr 1; funext v
  simp only [check, RCLike.inner_apply, conj_trivial]
  rw [mul_comm]

theorem check_eq (a : ℝ) :
    χ.check a = ∫ ζ : ℝ, (Real.fourierChar (ζ * a) : ℂ) * ((χ.h ζ : ℝ) : ℂ) := by
  simp only [check, SchwartzMap.fourierInv_coe, Real.fourierInv_eq, Circle.smul_def, smul_eq_mul]
  refine integral_congr_ae (Eventually.of_forall fun ζ => ?_)
  simp [schwartz_apply, RCLike.inner_apply, mul_comm]

theorem check_neg (a : ℝ) : χ.check (-a) = χ.check a := by
  rw [check_eq, check_eq, ← integral_neg_eq_self]
  refine integral_congr_ae (Eventually.of_forall fun ζ => ?_)
  simp only [χ.even, neg_mul_neg]

theorem integrable_complex : Integrable (fun ζ : ℝ => ((χ.h ζ : ℝ) : ℂ)) :=
  χ.contDiff_complex.continuous.integrable_of_hasCompactSupport χ.hasCompactSupport_complex

/-- The partial multiplier `ξ ↦ h(ξ_ℓ)`. -/
def coord (ℓ : Fin 3) (ξ : E3) : ℂ := ((χ.h (ξ ℓ) : ℝ) : ℂ)

theorem hasTemperateGrowth_coord (ℓ : Fin 3) : (χ.coord ℓ).HasTemperateGrowth :=
  Auto.hasTemperateGrowth_coord χ.compact χ.smooth ℓ

/-- The partial Fourier multiplier operator `h(D_ℓ)` on Schwartz functions. -/
def op (ℓ : Fin 3) : 𝓢(E3, ℂ) →L[ℂ] 𝓢(E3, ℂ) :=
  SchwartzMap.fourierMultiplierCLM ℂ (χ.coord ℓ)

theorem op_apply_eq (ℓ : Fin 3) (g : 𝓢(E3, ℂ)) (y : E3) :
    χ.op ℓ g y = ∫ ξ : E3, Real.fourierChar (inner ℝ ξ y) • (χ.coord ℓ ξ * 𝓕 (g : E3 → ℂ) ξ) :=
  fourierMultiplierCLM_apply_eq (χ.hasTemperateGrowth_coord ℓ) g y

/-- `h(D_ℓ) g(y) = ∫ ȟ(u) g(y - u e_ℓ) du`. -/
theorem op_eq_lineConv (ℓ : Fin 3) (g : 𝓢(E3, ℂ)) (y : E3) :
    χ.op ℓ g y = ∫ u : ℝ, χ.check u * g (y - u • basisVec ℓ) := by
  rw [op_apply_eq]
  set G : E3 × ℝ → ℂ := fun p => (Real.fourierChar (inner ℝ p.1 y) : ℂ) *
      ((Real.fourierChar (-(p.2 * p.1 ℓ)) : ℂ) * χ.check p.2 * 𝓕 (g : E3 → ℂ) p.1) with hG
  have hint : Integrable G (volume.prod volume) := by
    refine Integrable.mono' (((𝓕 g).integrable.norm.mul_prod
      χ.check.integrable.norm)) ?_ (Eventually.of_forall fun p => ?_)
    · have h4 : Continuous fun p : E3 × ℝ => 𝓕 (g : E3 → ℂ) p.1 := by
        rw [← SchwartzMap.fourier_coe]; exact (𝓕 g).continuous.comp continuous_fst
      refine (Continuous.aestronglyMeasurable ?_)
      exact (continuous_subtype_val.comp (Real.continuous_fourierChar.comp
        (continuous_fst.inner continuous_const))).mul
        (((continuous_subtype_val.comp (Real.continuous_fourierChar.comp
          (continuous_snd.mul ((continuous_evalCoord ℓ).comp continuous_fst)).neg)).mul
          (χ.check.continuous.comp continuous_snd)).mul h4)
    · simp only [hG, norm_mul, Circle.norm_coe, one_mul, ← SchwartzMap.fourier_coe]
      exact le_of_eq (mul_comm _ _)
  have e1 : (fun ξ : E3 => Real.fourierChar (inner ℝ ξ y) • (χ.coord ℓ ξ * 𝓕 (g : E3 → ℂ) ξ))
      = fun ξ => ∫ u : ℝ, G (ξ, u) := by
    funext ξ
    rw [coord, h_eq_fourier_check, ← integral_mul_const, Circle.smul_def,
      smul_eq_mul, ← integral_const_mul]
    refine integral_congr_ae (Eventually.of_forall fun u => ?_)
    simp only [hG, Circle.smul_def, smul_eq_mul]
  rw [e1, integral_integral_swap hint]
  refine integral_congr_ae (Eventually.of_forall fun u => ?_)
  simp only
  rw [schwartz_inversion_apply g (y - u • basisVec ℓ), ← integral_const_mul]
  refine integral_congr_ae (Eventually.of_forall fun ξ => ?_)
  simp only [hG, Circle.smul_def, smul_eq_mul]
  have hin : inner ℝ ξ (y - u • basisVec ℓ) = inner ℝ ξ y + -(u * ξ ℓ) := by
    rw [inner_sub_right, inner_smul_right, basisVec, EuclideanSpace.inner_single_right]
    simp; ring
  rw [hin, AddChar.map_add_eq_mul, Circle.coe_mul]
  ring

theorem op_shift (ℓ : Fin 3) (g : 𝓢(E3, ℂ)) (x : E3) (b : ℝ) :
    χ.op ℓ g (x + b • basisVec ℓ) = ∫ r : ℝ, χ.check (r - b) * g (x + r • basisVec ℓ) := by
  rw [op_eq_lineConv]
  rw [← integral_sub_left_eq_self (fun r : ℝ => χ.check (r - b) * g (x + r • basisVec ℓ))
    volume b]
  refine integral_congr_ae (Eventually.of_forall fun u => ?_)
  simp only
  rw [show b - u - b = -u by ring, check_neg]
  congr 2
  rw [sub_smul]; abel

end CoordMult

/-- The general per-scale multiplier `∏_n h_n(ξ_n) ∫ ψ(2^j s) e(-⟨γ(s), ξ⟩) ds/s`. -/
def genMult (χs : Fin 3 → CoordMult) (j : ℤ) (ξ : E3) : ℂ :=
  (∏ n, (((χs n).h (ξ n) : ℝ) : ℂ)) *
    ∫ s : ℝ, (lpPsi ((2 : ℝ) ^ j * s) : ℂ) / s *
      (Real.fourierChar (-(inner ℝ (gammaCurve s) ξ)) : ℂ)

/-- The general per-scale kernel `K(t) = ∫ ψ(2^j s) ∏_n ȟ_n(t_n - s^{n+1}) ds/s`. -/
def genKernel (χs : Fin 3 → CoordMult) (j : ℤ) (t : E3) : ℂ :=
  ∫ s : ℝ, (lpPsi ((2 : ℝ) ^ j * s) : ℂ) / s * ∏ n, (χs n).check (t n - s ^ expo n)

theorem fourierInv_genMult (χs : Fin 3 → CoordMult) (j : ℤ) (t : E3) :
    ∫ ξ : E3, (Real.fourierChar (inner ℝ ξ t) : ℂ) * genMult χs j ξ = genKernel χs j t := by
  unfold genKernel
  set w : ℝ → ℂ := fun s => (lpPsi ((2 : ℝ) ^ j * s) : ℂ) / s with hw
  have hwi : Integrable w := integrable_psi_div j
  set P : E3 → ℂ := fun ξ => ∏ n, (((χs n).h (ξ n) : ℝ) : ℂ) with hP
  have hPi : Integrable P :=
    integrable_E3_prod (h := fun n ζ => (((χs n).h ζ : ℝ) : ℂ))
      fun n => (χs n).integrable_complex
  set F : E3 × ℝ → ℂ := fun p => (Real.fourierChar (inner ℝ p.1 t) : ℂ) * (P p.1 *
      (w p.2 * (Real.fourierChar (-(inner ℝ (gammaCurve p.2) p.1)) : ℂ))) with hF
  have hFi : Integrable F (volume.prod volume) := by
    refine Integrable.mono' (hPi.norm.mul_prod hwi.norm) ?_ (Eventually.of_forall fun p => ?_)
    · refine Measurable.aestronglyMeasurable ?_
      have hPc : Continuous P := continuous_finsetProd _ fun n _ =>
        Complex.continuous_ofReal.comp ((χs n).smooth.continuous.comp (continuous_evalCoord n))
      have hwm : Measurable w := (Complex.continuous_ofReal.comp (continuous_lpPsi.comp
        (continuous_const.mul continuous_id))).measurable.div Complex.measurable_ofReal
      have hχ : Continuous (fun p : E3 × ℝ =>
          (Real.fourierChar (-(inner ℝ (gammaCurve p.2) p.1)) : ℂ)) :=
        continuous_subtype_val.comp (Real.continuous_fourierChar.comp
          ((continuous_gammaCurve.comp continuous_snd).inner continuous_fst).neg)
      exact (continuous_subtype_val.comp (Real.continuous_fourierChar.comp
        (continuous_fst.inner continuous_const))).measurable.mul
        ((hPc.comp continuous_fst).measurable.mul ((hwm.comp measurable_snd).mul hχ.measurable))
    · simp only [hF, norm_mul, Circle.norm_coe, one_mul, mul_one]; exact le_rfl
  have e1 : ∀ ξ : E3, (Real.fourierChar (inner ℝ ξ t) : ℂ) * genMult χs j ξ
      = ∫ s : ℝ, F (ξ, s) := by
    intro ξ
    rw [genMult, ← integral_const_mul, ← integral_const_mul]
  simp_rw [e1]
  rw [integral_integral_swap hFi]
  refine integral_congr_ae (Eventually.of_forall fun s => ?_)
  simp only [hF]
  have e2 : ∀ ξ : E3, (Real.fourierChar (inner ℝ ξ t) : ℂ) * (P ξ *
      (w s * (Real.fourierChar (-(inner ℝ (gammaCurve s) ξ)) : ℂ)))
      = w s * ∏ n, ((Real.fourierChar (ξ n * (t n - s ^ expo n)) : ℂ) *
          (((χs n).h (ξ n) : ℝ) : ℂ)) := by
    intro ξ
    rw [Finset.prod_mul_distrib, ← fourierChar_sum_three]
    have hin : inner ℝ ξ t + -(inner ℝ (gammaCurve s) ξ) = ∑ n, ξ n * (t n - s ^ expo n) := by
      rw [inner_eq_sum_E3, real_inner_comm, inner_eq_sum_E3, ← Finset.sum_neg_distrib,
        ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun n _ => ?_
      rw [gammaCurve_apply]; ring
    rw [← hin, AddChar.map_add_eq_mul, Circle.coe_mul]
    simp only [hP]
    ring
  simp_rw [e2]
  rw [integral_const_mul]
  congr 1
  rw [integral_E3_prod (fun n ζ => (Real.fourierChar (ζ * (t n - s ^ expo n)) : ℂ) *
    (((χs n).h ζ : ℝ) : ℂ))]
  refine Finset.prod_congr rfl fun n _ => ?_
  rw [CoordMult.check_eq]


theorem gammaOp_genKernel (χs : Fin 3 → CoordMult) (j : ℤ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    gammaOp (genKernel χs j) (fun n => f n) x
      = simplexTj j (fun n => (χs n).op n (f n)) x := by
  set w : ℝ → ℂ := fun s => (lpPsi ((2 : ℝ) ^ j * s) : ℂ) / s with hw
  have hwi : Integrable w := integrable_psi_div j
  have hwm : Measurable w := (Complex.continuous_ofReal.comp (continuous_lpPsi.comp
    (continuous_const.mul continuous_id))).measurable.div Complex.measurable_ofReal
  set c : Fin 3 → ℤ := fun n => (expo n : ℤ) * j with hc
  choose C hC0 hC using fun n => exists_bound_schwartz (f n)
  set G : E3 × ℝ → ℂ := fun p => w p.2 * ∏ n, ((χs n).check (p.1 n - p.2 ^ expo n) *
      f n (x + p.1 n • basisVec n)) with hG
  set H : E3 × ℝ → ℝ := fun p => ‖w p.2‖ * ∏ n, (C n * ‖(χs n).check (p.1 n - p.2 ^ expo n)‖)
    with hH
  have hHm : Measurable H := by
    refine hwm.norm.comp measurable_snd |>.mul ?_
    refine Finset.measurable_prod _ fun n _ => measurable_const.mul ?_
    exact (((χs n).check).continuous.comp (((continuous_evalCoord n).comp continuous_fst).sub
      (continuous_snd.pow _))).norm.measurable
  have hGm : Measurable G := by
    refine (hwm.comp measurable_snd).mul ?_
    refine Finset.measurable_prod _ fun n _ => ?_
    exact ((((χs n).check).continuous.comp (((continuous_evalCoord n).comp
      continuous_fst).sub (continuous_snd.pow _))).mul ((f n).continuous.comp
        (continuous_const.add (((continuous_evalCoord n).comp continuous_fst).smul
          continuous_const)))).measurable
  have hHint : ∀ s : ℝ, ∫ t : E3, H (t, s) = ‖w s‖ * ∏ n, (C n * ∫ r : ℝ, ‖(χs n).check r‖) := by
    intro s
    simp only [hH]
    rw [integral_const_mul]
    congr 1
    rw [integral_E3_prod_real (fun n r => C n * ‖(χs n).check (r - s ^ expo n)‖)]
    refine Finset.prod_congr rfl fun n _ => ?_
    rw [integral_const_mul, integral_sub_right_eq_self (fun r => ‖(χs n).check r‖) (s ^ expo n)]
  have hHi : Integrable H (volume.prod volume) := by
    rw [integrable_prod_iff' hHm.aestronglyMeasurable]
    refine ⟨Eventually.of_forall fun s => ?_, ?_⟩
    · have := integrable_E3_prod_real (h := fun n r => C n * ‖(χs n).check (r - s ^ expo n)‖)
        fun n => (((χs n).check).integrable.norm.comp_sub_right _).const_mul _
      exact this.const_mul ‖w s‖
    · have e : (fun s => ∫ t : E3, ‖H (t, s)‖) = fun s => ∫ t : E3, H (t, s) := by
        funext s
        refine integral_congr_ae (Eventually.of_forall fun t => ?_)
        dsimp only
        rw [Real.norm_eq_abs, abs_of_nonneg]
        exact mul_nonneg (norm_nonneg _) (Finset.prod_nonneg fun n _ =>
          mul_nonneg (hC0 n) (norm_nonneg _))
      rw [e]
      simp_rw [hHint]
      exact hwi.norm.mul_const _
  have hGi : Integrable G (volume.prod volume) := by
    refine Integrable.mono' hHi hGm.aestronglyMeasurable (Eventually.of_forall fun p => ?_)
    simp only [hG, hH, norm_mul, norm_prod]
    refine mul_le_mul_of_nonneg_left (Finset.prod_le_prod (fun n _ => by positivity)
      fun n _ => ?_) (norm_nonneg _)
    rw [mul_comm]
    exact mul_le_mul_of_nonneg_right (hC n _) (norm_nonneg _)
  -- rewrite both sides as iterated integrals of `G`
  have hL : gammaOp (genKernel χs j) (fun n => f n) x = ∫ t : E3, ∫ s : ℝ, G (t, s) := by
    unfold gammaOp genKernel
    refine integral_congr_ae (Eventually.of_forall fun t => ?_)
    dsimp only
    rw [← integral_mul_const]
    refine integral_congr_ae (Eventually.of_forall fun s => ?_)
    simp only [hG, hw, Finset.prod_mul_distrib]
    ring
  have hR : simplexTj j (fun n => (χs n).op n (f n)) x
      = ∫ s : ℝ, ∫ t : E3, G (t, s) := by
    unfold simplexTj
    refine integral_congr_ae (Eventually.of_forall fun s => ?_)
    simp only [hG, prodShift]
    rw [integral_const_mul, integral_E3_prod (fun n r => (χs n).check (r - s ^ expo n) *
      f n (x + r • basisVec n))]
    have e : ∀ n : Fin 3, (χs n).op n (f n) (x + curve n s)
        = ∫ r : ℝ, (χs n).check (r - s ^ expo n) * f n (x + r • basisVec n) := by
      intro n
      rw [curve, CoordMult.op_shift]
    simp only [e, hw]
    ring
  rw [hL, hR, integral_integral_swap hGi]

/-- `θ(D_{2^{-j}} ξ) = ∫ ψ(2^j s) e(-⟨γ(s), ξ⟩) ds/s`. -/
theorem thetaL_dilate (j : ℤ) (ξ : E3) :
    thetaL (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ)
      = ∫ s : ℝ, (lpPsi ((2 : ℝ) ^ j * s) : ℂ) / s *
          (Real.fourierChar (-(inner ℝ (gammaCurve s) ξ)) : ℂ) := by
  have hq : (0 : ℝ) < 2 ^ j := zpow_pos two_pos _
  have hq' : (2 : ℝ) ^ (-j) * 2 ^ j = 1 := by
    rw [← zpow_add₀ two_ne_zero, neg_add_cancel, zpow_zero]
  unfold thetaL
  -- substitute `σ = 2^j s`
  have h := Measure.integral_comp_mul_left (fun σ : ℝ =>
    (Real.fourierChar (-(inner ℝ (gammaCurve σ)
      (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ))) : ℂ) * ((wL σ : ℝ) : ℂ)) ((2 : ℝ) ^ j)
  rw [abs_of_pos (inv_pos.mpr hq)] at h
  have e : ∀ s : ℝ, inner ℝ (gammaCurve ((2 : ℝ) ^ j * s))
      (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ) = inner ℝ (gammaCurve s) ξ := by
    intro s
    rw [inner_gammaCurve, inner_gammaCurve]
    refine Finset.sum_congr rfl fun n _ => ?_
    simp only [Twisted.Anisotropy.dilate, PiLp.toLp_apply]
    change ((2 : ℝ) ^ j * s) ^ expo n * (((2 : ℝ) ^ (-j)) ^ expo n * ξ n) = s ^ expo n * ξ n
    rw [mul_pow, show ((2 : ℝ) ^ j) ^ expo n * s ^ expo n * ((2 ^ (-j)) ^ expo n * ξ n)
      = (2 ^ (-j) * 2 ^ j) ^ expo n * (s ^ expo n * ξ n) by ring, hq', one_pow, one_mul]
  simp only [e] at h
  calc ∫ σ : ℝ, (Real.fourierChar (-(inner ℝ (gammaCurve σ)
          (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ))) : ℂ) * ((wL σ : ℝ) : ℂ)
      = (2 : ℝ) ^ j • ((2 : ℝ) ^ j)⁻¹ • ∫ σ : ℝ, (Real.fourierChar (-(inner ℝ (gammaCurve σ)
          (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ))) : ℂ) * ((wL σ : ℝ) : ℂ) := by
        rw [smul_smul, mul_inv_cancel₀ hq.ne', one_smul]
    _ = (2 : ℝ) ^ j • ∫ s : ℝ, (Real.fourierChar (-(inner ℝ (gammaCurve s) ξ)) : ℂ) *
          ((wL ((2 : ℝ) ^ j * s) : ℝ) : ℂ) := by rw [h]
    _ = ∫ s : ℝ, (2 : ℝ) ^ j • ((Real.fourierChar (-(inner ℝ (gammaCurve s) ξ)) : ℂ) *
          ((wL ((2 : ℝ) ^ j * s) : ℝ) : ℂ)) := (integral_smul _ _).symm
    _ = _ := by
        refine integral_congr_ae (Eventually.of_forall fun s => ?_)
        simp only [wL, Complex.real_smul]
        by_cases hs : s = 0
        · subst hs; simp
        · push_cast
          field_simp

/-- `ψ_c` as a coordinate multiplier. -/
def psiCM (c : ℤ) : CoordMult :=
  ⟨lpPsiJ c, contDiff_lpPsiJ c, hasCompactSupport_lpPsiJ c, fun ζ => by
    simp only [lpPsiJ, mul_neg, lpPsi_neg]⟩

/-- `φ_c` as a coordinate multiplier. -/
def phiCM (c : ℤ) : CoordMult :=
  ⟨lpPhiJ c, contDiff_lpPhiJ c, hasCompactSupport_lpPhiJ c, fun ζ => by
    simp only [lpPhiJ, mul_neg, lpPhi_neg]⟩

theorem psiCM_op (c : ℤ) (ℓ : Fin 3) : (psiCM c).op ℓ = lpDelta ℓ c := rfl

theorem phiCM_op (c : ℤ) (ℓ : Fin 3) : (phiCM c).op ℓ = lpS ℓ c := rfl

/-- The coordinate multipliers of the `(j, κ)` mixed-frequency piece:
`ψ_{(n+1)j+κ}` in coordinate `n` and `φ_{(m+1)j+κ-101}` in the others. -/
def mlChis (n : Fin 3) (j κ : ℤ) (m : Fin 3) : CoordMult :=
  if m = n then psiCM ((expo n : ℤ) * j + κ) else phiCM ((expo m : ℤ) * j + κ - 101)

theorem mlPiece_dilate (n : Fin 3) (κ j : ℤ) (ξ : E3) :
    mlPiece n κ (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ) = genMult (mlChis n j κ) j ξ := by
  unfold mlPiece genMult
  rw [thetaL_dilate]
  congr 1
  rw [mlCut_apply]
  have hsc : ∀ (m : Fin 3) (c : ℤ), (2 : ℝ) ^ (-c) * (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ) m
      = (2 : ℝ) ^ (-(c + (expo m : ℤ) * j)) * ξ m := by
    intro m c
    simp only [Twisted.Anisotropy.dilate, PiLp.toLp_apply]
    change (2 : ℝ) ^ (-c) * (((2 : ℝ) ^ (-j)) ^ expo m * ξ m) = _
    rw [← zpow_natCast, ← zpow_mul, ← mul_assoc, ← zpow_add₀ two_ne_zero]
    congr 2; ring
  rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ n)]
  push_cast
  congr 1
  · simp only [mlChis, if_pos rfl, psiCM, lpPsiJ]
    rw [hsc]; congr 3; ring
  · refine Finset.prod_congr rfl fun m hm => ?_
    have hmn := Finset.ne_of_mem_erase hm
    simp only [mlChis, if_neg hmn, phiCM, lpPhiJ]
    rw [show (101 - κ : ℤ) = -(κ - 101) by ring, hsc]; congr 3; ring

theorem hasCompactSupport_mlCut (n : Fin 3) (κ : ℤ) : HasCompactSupport (mlCut n κ) := by
  refine IsCompact.of_isClosed_subset (isCompact_closedBall (0 : E3) (3 * 2 ^ (κ + 1)))
    (isClosed_tsupport _) ((tsupport_mlCut n κ).trans fun η hη => ?_)
  obtain ⟨h1, h2, h3⟩ := hη
  rw [Metric.mem_closedBall, dist_zero_right]
  have hn := norm_le_sum_abs_E3 η
  have hb : ∀ m : Fin 3, |η m| ≤ 2 ^ (κ + 1) := by
    intro m
    by_cases hm : m = n
    · rw [hm]; exact h2
    · exact (h3 m hm).trans (zpow_le_zpow_right₀ (by norm_num) (by omega))
  linarith [hb 0, hb 1, hb 2]

theorem hasCompactSupport_mlPiece_dilate (n : Fin 3) (κ j : ℤ) :
    HasCompactSupport (fun ξ => mlPiece n κ (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ)) := by
  have ha : (2 : ℝ) ^ (-j) ≠ 0 := (zpow_pos two_pos _).ne'
  have hc : HasCompactSupport (mlPiece n κ) :=
    ((hasCompactSupport_mlCut n κ).comp_left Complex.ofReal_zero).mul_right
  have := hc.comp_homeomorph (dilEquiv ha).toHomeomorph
  convert this using 1
  funext ξ
  simp [dilEquiv, dilCLM_apply]

theorem contDiff_mlPiece_dilate (n : Fin 3) (κ j : ℤ) :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞)
      (fun ξ => mlPiece n κ (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ)) := by
  have e : (fun ξ => mlPiece n κ (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ))
      = mlPiece n κ ∘ dilCLM ((2 : ℝ) ^ (-j)) := by funext ξ; simp [dilCLM_apply]
  rw [e]; exact (contDiff_mlPiece n κ).comp (dilCLM _).contDiff

/-- `μ_κ(D_{2^{-j}} ·)` as a Schwartz function. -/
def mlPieceS (n : Fin 3) (κ j : ℤ) : 𝓢(E3, ℂ) :=
  (hasCompactSupport_mlPiece_dilate n κ j).toSchwartzMap (contDiff_mlPiece_dilate n κ j)

theorem mlPieceS_apply (n : Fin 3) (κ j : ℤ) (ξ : E3) :
    mlPieceS n κ j ξ = mlPiece n κ (alpha123.dilate ((2 : ℝ) ^ (-j)) ξ) := rfl

/-- The Schwartz kernel of the `(j, κ)` mixed-frequency piece. -/
def kernelMLS (n : Fin 3) (κ j : ℤ) : 𝓢(E3, ℂ) := 𝓕⁻ (mlPieceS n κ j)

theorem kernelMLS_apply (n : Fin 3) (κ j : ℤ) (t : E3) :
    kernelMLS n κ j t = genKernel (mlChis n j κ) j t := by
  rw [kernelMLS, SchwartzMap.fourierInv_coe, Real.fourierInv_eq, ← fourierInv_genMult]
  refine integral_congr_ae (Eventually.of_forall fun ξ => ?_)
  dsimp only
  rw [Circle.smul_def, smul_eq_mul, mlPieceS_apply, mlPiece_dilate]

/-- The truncated mixed-frequency kernel `K_{ML,n}`, cut at scales `|j| ≤ J` and `κ ≤ K_0`. -/
def kernelML (n : Fin 3) (J K0 : ℕ) : 𝓢(E3, ℂ) :=
  ∑ j ∈ Finset.Icc (-(J : ℤ)) J, ∑ κ ∈ Finset.Icc (1 : ℤ) K0, kernelMLS n κ j

theorem fourier_kernelML (n : Fin 3) (J K0 : ℕ) :
    𝓕 (kernelML n J K0 : E3 → ℂ) = dyadicSum (kappaML n K0) J := by
  rw [← SchwartzMap.fourier_coe]
  funext ξ
  have hs : ∀ (s : Finset ℤ) (K : ℤ → 𝓢(E3, ℂ)), 𝓕 (∑ j ∈ s, K j) = ∑ j ∈ s, 𝓕 (K j) := by
    intro s K
    have := map_sum (SchwartzMap.fourierTransformCLM ℂ (V := E3) (E := ℂ)) K s
    simpa using this
  rw [kernelML, hs, SchwartzMap.sum_apply, dyadicSum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [hs, SchwartzMap.sum_apply, kappaML]
  refine Finset.sum_congr rfl fun κ _ => ?_
  rw [kernelMLS, FourierInvPair.fourier_fourierInv_eq, mlPieceS_apply]

/-- **The kernel form of `T^{ML,n}`** (lines 389-400), truncated:
`Γ_{K_{ML,n}}(f) = ∑_{|j| ≤ J} ∑_{κ=1}^{K_0} T_j(Δ^{(n)}_{(n+1)j+κ} f_n, S^{(m)}_{(m+1)j+κ-101} f_m)`. -/
theorem gammaOp_kernelML (n : Fin 3) (J K0 : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    gammaOp (kernelML n J K0) (fun m => f m) x
      = ∑ j ∈ Finset.Icc (-(J : ℤ)) J, ∑ κ ∈ Finset.Icc (1 : ℤ) K0,
          simplexTj j (fun m => (mlChis n j κ m).op m (f m)) x := by
  rw [kernelML, gammaOp_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [gammaOp_sum]
  refine Finset.sum_congr rfl fun κ _ => ?_
  rw [← gammaOp_genKernel]
  congr 1
  funext t; exact kernelMLS_apply n κ j t

theorem regMLn_iff (n : Fin 3) (k : Fin 3 → ℤ) :
    RegMLn n k ↔ 1 ≤ k n ∧ ∀ m, m ≠ n → k m ≤ k n - 101 := by
  unfold RegMLn RegML
  simp only [kMid, kMax, kMin]
  have h0 := k 0; have h1 := k 1; have h2 := k 2
  fin_cases n
  · simp only [Fin.zero_eta]
    constructor
    · rintro ⟨⟨h1, h2⟩, h3⟩
      refine ⟨by omega, fun m hm => ?_⟩
      fin_cases m
      · exact absurd rfl hm
      · simp only [Fin.mk_one]; omega
      · simp only [Fin.reduceFinMk]; omega
    · rintro ⟨h1, h2⟩
      have a := h2 1 (by decide); have b := h2 2 (by decide)
      refine ⟨⟨by omega, by omega⟩, by omega⟩
  · simp only [Fin.mk_one]
    constructor
    · rintro ⟨⟨h1, h2⟩, h3⟩
      refine ⟨by omega, fun m hm => ?_⟩
      fin_cases m
      · simp only [Fin.zero_eta]; omega
      · exact absurd rfl hm
      · simp only [Fin.reduceFinMk]; omega
    · rintro ⟨h1, h2⟩
      have a := h2 0 (by decide); have b := h2 2 (by decide)
      refine ⟨⟨by omega, by omega⟩, by omega⟩
  · simp only [Fin.reduceFinMk]
    constructor
    · rintro ⟨⟨h1, h2⟩, h3⟩
      refine ⟨by omega, fun m hm => ?_⟩
      fin_cases m
      · simp only [Fin.zero_eta]; omega
      · simp only [Fin.mk_one]; omega
      · exact absurd rfl hm
    · rintro ⟨h1, h2⟩
      have a := h2 0 (by decide); have b := h2 1 (by decide)
      refine ⟨⟨by omega, by omega⟩, by omega⟩

/-- `∑_{m ≤ d} Δ^{(ℓ)}_{c+m} g = S^{(ℓ)}_{c+d} g` pointwise. -/
theorem hasSum_lpDelta_le (ℓ : Fin 3) (c d : ℤ) (g : 𝓢(E3, ℂ)) (y : E3) :
    HasSum (fun m : ℤ => if m ≤ d then lpDelta ℓ (c + m) g y else 0) (lpS ℓ (c + d) g y) := by
  have h := hasSum_lpDelta_Iic ℓ (c + d) g y
  rw [← (Equiv.addLeft d).hasSum_iff]
  convert h using 1
  funext m
  simp only [Function.comp_apply, Equiv.coe_addLeft]
  by_cases hm : m ≤ 0
  · rw [if_pos (by omega), if_pos hm, add_assoc]
  · rw [if_neg (by omega), if_neg hm]

/-- The masks of the `κ`-th mixed-frequency fibre. -/
def mlMask (n : Fin 3) (κ : ℤ) (m : Fin 3) (t : ℤ) : Prop :=
  (m = n ∧ t = κ) ∨ (m ≠ n ∧ t ≤ κ - 101)

instance (n : Fin 3) (κ : ℤ) (m : Fin 3) : DecidablePred (mlMask n κ m) := by
  unfold mlMask; infer_instance

theorem mlMask_all (n : Fin 3) (κ : ℤ) (k : Fin 3 → ℤ) :
    (∀ m, mlMask n κ m (k m)) ↔ k n = κ ∧ ∀ m, m ≠ n → k m ≤ κ - 101 := by
  constructor
  · intro h
    refine ⟨?_, fun m hm => ?_⟩
    · rcases h n with h | h
      · exact h.2
      · exact absurd rfl h.1
    · rcases h m with h | h
      · exact absurd h.1 hm
      · exact h.2
  · rintro ⟨h1, h2⟩ m
    by_cases hm : m = n
    · left; exact ⟨hm, hm ▸ h1⟩
    · right; exact ⟨hm, h2 m hm⟩

/-- **The `κ`-th fibre of `F_{ML,n}`**: summing the pieces over `k_n = κ`,
`k_m ≤ κ - 101` gives `T_j(Δ^{(n)}_{(n+1)j+κ} f_n, S^{(m)}_{(m+1)j+κ-101} f_m)`. -/
theorem hasSum_ML_fibre (n : Fin 3) (j κ : ℤ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    HasSum (fun k => if (∀ m, mlMask n κ m (k m)) then freqPiece j k f x else 0)
      (simplexTj j (fun m => (mlChis n j κ m).op m (f m)) x) := by
  refine hasSum_piece_mask j f x (mlMask n κ) (fun m => (mlChis n j κ m).op m (f m))
    (fun m y => ?_)
  by_cases hm : m = n
  · subst hm
    have e : (fun t => if mlMask m κ m t then lpDelta m ((expo m : ℤ) * j + t) (f m) y else 0)
        = fun t => if t = κ then lpDelta m ((expo m : ℤ) * j + t) (f m) y else 0 := by
      funext t; simp [mlMask]
    rw [e, mlChis, if_pos rfl, psiCM_op]
    convert hasSum_ite_eq κ (lpDelta m ((expo m : ℤ) * j + κ) (f m) y) using 1
    funext t; split_ifs with h <;> simp [h]
  · have e : (fun t => if mlMask n κ m t then lpDelta m ((expo m : ℤ) * j + t) (f m) y else 0)
        = fun t => if t ≤ κ - 101 then lpDelta m ((expo m : ℤ) * j + t) (f m) y else 0 := by
      funext t; simp [mlMask, hm]
    rw [e, mlChis, if_neg hm, phiCM_op]
    have := hasSum_lpDelta_le m ((expo m : ℤ) * j) (κ - 101) (f m) y
    rwa [show (expo m : ℤ) * j + (κ - 101) = (expo m : ℤ) * j + κ - 101 by ring] at this

/-- **The mixed-frequency component as a series in `κ`** (line 387): for each scale `j`,
`∑_{k ∈ F_{ML,n}} T_j(Δ...) = ∑_{κ ≥ 1} T_j(Δ^{(n)}_{(n+1)j+κ} f_n, S^{(m)}_{(m+1)j+κ-101} f_m)`. -/
theorem hasSum_ML_kappa (n : Fin 3) (j : ℤ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    HasSum (fun κ : ℤ => if 1 ≤ κ then simplexTj j (fun m => (mlChis n j κ m).op m (f m)) x
      else 0) (∑' k : Fin 3 → ℤ, if RegMLn n k then freqPiece j k f x else 0) := by
  have hS := (summable_freqPiece_ite (RegMLn n) j f x).hasSum
  have hfib := hS.tsum_fiberwise (fun k => k n)
  suffices hfun : (fun κ : ℤ => if 1 ≤ κ then simplexTj j (fun m => (mlChis n j κ m).op m (f m)) x
      else 0) = (fun c => ∑' b : ((fun k : Fin 3 → ℤ => k n) ⁻¹' {c}),
        if RegMLn n (b : Fin 3 → ℤ) then freqPiece j b f x else 0) by
    rw [hfun]; exact hfib
  funext κ
  symm
  rw [tsum_subtype ((fun k : Fin 3 → ℤ => k n) ⁻¹' {κ})
    (fun k => if RegMLn n k then freqPiece j k f x else 0)]
  have e : (((fun k : Fin 3 → ℤ => k n) ⁻¹' {κ}).indicator
      (fun k => if RegMLn n k then freqPiece j k f x else 0))
      = fun k => if 1 ≤ κ ∧ (∀ m, mlMask n κ m (k m)) then freqPiece j k f x else 0 := by
    funext k
    by_cases hk : k n = κ
    · rw [indicator_of_mem (show k ∈ (fun k : Fin 3 → ℤ => k n) ⁻¹' {κ} from hk)]
      have : RegMLn n k ↔ 1 ≤ κ ∧ ∀ m, mlMask n κ m (k m) := by
        rw [regMLn_iff, mlMask_all, hk]; tauto
      simp only [this]
    · rw [indicator_of_notMem (show k ∉ (fun k : Fin 3 → ℤ => k n) ⁻¹' {κ} from hk)]
      have : ¬ (1 ≤ κ ∧ ∀ m, mlMask n κ m (k m)) := fun h =>
        hk ((mlMask_all n κ k).mp h.2).1
      rw [if_neg this]
  rw [e]
  by_cases hκ : 1 ≤ κ
  · simp only [hκ, true_and, if_true]
    exact (hasSum_ML_fibre n j κ f x).tsum_eq
  · simp [hκ]

/-- Partial sums over `1 ≤ κ ≤ K_0` of a series supported on `κ ≥ 1`. -/
theorem tendsto_sum_Icc_one {a : ℤ → ℂ} {s : ℂ} (ha : HasSum a s) (h0 : ∀ κ, κ < 1 → a κ = 0) :
    Tendsto (fun K0 : ℕ => ∑ κ ∈ Finset.Icc (1 : ℤ) K0, a κ) atTop (𝓝 s) := by
  have hinj : Function.Injective (fun i : ℕ => (i : ℤ) + 1) := fun i j h => by
    simp only [add_left_inj, Nat.cast_inj] at h; exact h
  have hN : HasSum (fun i : ℕ => a ((i : ℤ) + 1)) s := by
    refine (hinj.hasSum_iff (f := a) fun κ hκ => h0 κ ?_).mpr ha
    by_contra h; push Not at h
    exact hκ ⟨(κ - 1).toNat, by simp; omega⟩
  have e : ∀ K0 : ℕ, ∑ κ ∈ Finset.Icc (1 : ℤ) K0, a κ = ∑ i ∈ Finset.range K0, a ((i : ℤ) + 1) := by
    intro K0
    refine Finset.sum_nbij' (fun κ => (κ - 1).toNat) (fun i => (i : ℤ) + 1) ?_ ?_ ?_ ?_ ?_
    · intro κ hκ; simp only [Finset.mem_Icc] at hκ; simp only [Finset.mem_range]; omega
    · intro i hi; simp only [Finset.mem_range] at hi; simp only [Finset.mem_Icc]; omega
    · intro κ hκ; simp only [Finset.mem_Icc] at hκ; omega
    · intro i _; simp
    · intro κ hκ; simp only [Finset.mem_Icc] at hκ; congr 1; omega
  simp_rw [e]
  exact hN.tendsto_sum_nat

/-- **The truncated mixed-frequency component is the limit of the kernel operators**
(lines 387-400): `Γ_{K_{ML,n,J,K_0}}(f)(x) → T^{ML,n}_J(f)(x)` as `K_0 → ∞`. -/
theorem tendsto_gammaOp_kernelML (n : Fin 3) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    Tendsto (fun K0 : ℕ => gammaOp (kernelML n J K0) (fun m => f m) x) atTop
      (𝓝 (regComp (RegMLn n) J f x)) := by
  simp_rw [gammaOp_kernelML]
  unfold regComp
  refine tendsto_finset_sum _ fun j _ => ?_
  have h := tendsto_sum_Icc_one (hasSum_ML_kappa n j f x) (fun κ hκ => by simp [not_le.mpr hκ])
  refine h.congr fun K0 => Finset.sum_congr rfl fun κ hκ => ?_
  rw [if_pos (Finset.mem_Icc.mp hκ).1]

/-- **The mixed-frequency bound for `T^{ML,n}`** (lines 423-426, and line 383 for `n = 2, 3`):
for `p ∈ (1, 4/3)`, `p_m ∈ (1, 4)` with `∑ 1/p_m = 1/p`, `‖T^{ML,n}_J(f)‖_p ≤ C ∏ ‖f_m‖_{p_m}`
uniformly in `J`: `thm:main_twist` bounds each kernel operator `Γ_{K_{ML,n,J,K_0}}` uniformly
(`Auto.kappaML_symbol`), and Fatou's lemma passes to `K_0 → ∞`. -/
theorem mlFreq_bound (n : Fin 3) {p : ℝ} {pv : Fin 3 → ℝ} (hp : 1 < p) (hp43 : p < 4 / 3)
    (hpv : ∀ m, 1 < pv m ∧ pv m < 4) (hsum : ∑ m, (pv m)⁻¹ = p⁻¹) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)),
      eLpNorm (regComp (RegMLn n) J f) (ENNReal.ofReal p) volume
        ≤ ENNReal.ofReal C * ∏ m, eLpNorm (f m) (ENNReal.ofReal (pv m)) volume := by
  obtain ⟨C0, hC0, hT⟩ := mainTwist hp hp43 hpv hsum
  obtain ⟨M, hM, hsym⟩ := kappaML_symbol n
  refine ⟨C0 * M, mul_nonneg hC0 hM, fun J f => ?_⟩
  have hbound : ∀ K0 : ℕ, eLpNorm (gammaOp (kernelML n J K0) fun m => f m) (ENNReal.ofReal p) volume
      ≤ ENNReal.ofReal (C0 * M) * ∏ m, eLpNorm (f m) (ENNReal.ofReal (pv m)) volume := fun K0 =>
    hT M (kernelML n J K0) (by rw [fourier_kernelML]; exact hsym K0 J) f
  have hfatou := Lp.eLpNorm_lim_le_liminf_eLpNorm (μ := (volume : Measure E3))
    (p := ENNReal.ofReal p)
    (fun K0 => (continuous_gammaOp (kernelML n J K0) f).aestronglyMeasurable)
    (regComp (RegMLn n) J f)
    (Eventually.of_forall fun x => tendsto_gammaOp_kernelML n J f x)
  exact hfatou.trans (Filter.liminf_le_of_frequently_le' (Frequently.of_forall hbound))

/-- The measurability of the truncated components (continuity is not needed: a pointwise
limit of continuous functions). -/
theorem aestronglyMeasurable_regComp_ML (n : Fin 3) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) :
    AEStronglyMeasurable (regComp (RegMLn n) J f) volume := by
  have hf : ∀ K0 : ℕ, AEStronglyMeasurable (gammaOp (kernelML n J K0) fun m => f m) volume :=
    fun K0 => (continuous_gammaOp (kernelML n J K0) f).aestronglyMeasurable
  have hlim : ∀ᵐ x ∂(volume : Measure E3), Tendsto
      (fun K0 : ℕ => gammaOp (kernelML n J K0) (fun m => f m) x) atTop
      (𝓝 (regComp (RegMLn n) J f x)) := Eventually.of_forall fun x => tendsto_gammaOp_kernelML n J f x
  exact aestronglyMeasurable_of_tendsto_ae (u := atTop)
    (f := fun K0 : ℕ => gammaOp (kernelML n J K0) fun m => f m) hf hlim

/-- **The mixed-frequency bound for `T^{ML}`**: `T^{ML} = T^{ML,1} + T^{ML,2} + T^{ML,3}`. -/
theorem mlFreq_total_bound {p : ℝ} {pv : Fin 3 → ℝ} (hp : 1 < p) (hp43 : p < 4 / 3)
    (hpv : ∀ m, 1 < pv m ∧ pv m < 4) (hsum : ∑ m, (pv m)⁻¹ = p⁻¹) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)),
      eLpNorm (regComp RegML J f) (ENNReal.ofReal p) volume
        ≤ ENNReal.ofReal C * ∏ m, eLpNorm (f m) (ENNReal.ofReal (pv m)) volume := by
  choose C hC0 hC using fun n => mlFreq_bound n hp hp43 hpv hsum
  refine ⟨∑ n, C n, Finset.sum_nonneg fun n _ => hC0 n, fun J f => ?_⟩
  have e : regComp RegML J f = ∑ n : Fin 3, regComp (RegMLn n) J f := by
    funext x; rw [Finset.sum_apply]; exact regComp_ML_split J f x
  rw [e]
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp.le
  calc eLpNorm (∑ n : Fin 3, regComp (RegMLn n) J f) (ENNReal.ofReal p) volume
      ≤ ∑ n : Fin 3, eLpNorm (regComp (RegMLn n) J f) (ENNReal.ofReal p) volume :=
        eLpNorm_sum_le (fun n _ => aestronglyMeasurable_regComp_ML n J f) hp1
    _ ≤ ∑ n : Fin 3, ENNReal.ofReal (C n) *
          ∏ m, eLpNorm (f m) (ENNReal.ofReal (pv m)) volume :=
        Finset.sum_le_sum fun n _ => hC n J f
    _ = ENNReal.ofReal (∑ n, C n) * ∏ m, eLpNorm (f m) (ENNReal.ofReal (pv m)) volume := by
        rw [← Finset.sum_mul, ENNReal.ofReal_sum_of_nonneg fun n _ => hC0 n]

/-! ## Section 3 (imported): `thm:smoothing` from Task 2 -/

/-- **`thm:smoothing`** (`blueprints/main.tex`, lines 190-203), from Task 2 (`Auto.mainTheorem`),
for Schwartz inputs: for `0 < a < b`, `p ∈ [1, ∞)`, `p_n ∈ (1, ∞)` with `∑ 1/p_n = 1/p`, there
are `δ ∈ (0,1)` and `C` such that for `ψ ∈ C^1` supported in `[a, b]` with `‖ψ'‖_1 ≤ M`,
`λ ≥ 1`, and Schwartz `f_n` of which one has `supp f̂_n ⊆ {|ξ_n| ≥ λ}`,
`‖𝒜_ψ(f)‖_p ≤ C max(1, M) λ^{-δ} ∏ ‖f_n‖_{p_n}`.  (The source's implicit constant depends on
`a, b, ‖ψ'‖_1`; the imported statement makes the dependence on `‖ψ'‖_1` explicit.) -/
theorem thm_smoothing {a bb : ℝ} (ha : 0 < a) (hab : a < bb)
    {p : ℝ} {pv : Fin 3 → ℝ} (hp : 1 ≤ p) (hpv : ∀ i, 1 < pv i)
    (hsum : ∑ i, (pv i)⁻¹ = p⁻¹) :
    ∃ δ C : ℝ, δ ∈ Set.Ioo (0 : ℝ) 1 ∧ 0 < C ∧
      ∀ (ψ ψ' : ℝ → ℝ) (M : ℝ), (∀ t, HasDerivAt ψ (ψ' t) t) → Continuous ψ' →
        Function.support ψ ⊆ Set.Icc a bb → 0 ≤ M →
        (∫⁻ t, ‖ψ' t‖ₑ ∂volume) ≤ ENNReal.ofReal M →
        ∀ lam : ℝ, 1 ≤ lam → ∀ f : Fin 3 → 𝓢(E3, ℂ),
        (∃ j : Fin 3, Function.support (𝓕 (f j : E3 → ℂ)) ⊆ {ξ : E3 | lam ≤ |ξ j|}) →
        eLpNorm (Apsi ψ fun n => f n) (ENNReal.ofReal p) volume
          ≤ ENNReal.ofReal (C * max 1 M * lam ^ (-δ))
            * ∏ i, eLpNorm (f i) (ENNReal.ofReal (pv i)) volume := by
  obtain ⟨δ, C, hδ, hC, h⟩ := mainTheorem ha hab hp hpv hsum
  exact ⟨δ, C, hδ, hC, fun ψ ψ' M hψ hψ' hs hM hint lam hlam f hf =>
    h ψ ψ' M hψ hψ' hs hM hint lam hlam (fun n => f n) (fun i => nice_of_schwartz (f i)) hf⟩

/-! ## Section 2.4: high frequencies -- diagonal changes of variables -/

/-- The diagonal linear map `diag(c_1, c_2, c_3)` on `ℝ^3`. -/
def diagCLM (c : Fin 3 → ℝ) : E3 →L[ℝ] E3 :=
  LinearMap.toContinuousLinearMap (Matrix.toLpLin 2 2 (Matrix.diagonal c))

theorem diagCLM_apply (c : Fin 3 → ℝ) (x : E3) (m : Fin 3) : diagCLM c x m = c m * x m := by
  simp [diagCLM, Matrix.toLpLin_apply, Matrix.mulVec_diagonal]

theorem det_diagCLM (c : Fin 3 → ℝ) :
    LinearMap.det (diagCLM c : E3 →ₗ[ℝ] E3) = ∏ m, c m := by
  simp [diagCLM, LinearMap.det_toLpLin]

theorem diagCLM_comp (c d : Fin 3 → ℝ) (x : E3) :
    diagCLM c (diagCLM d x) = diagCLM (fun m => c m * d m) x := by
  ext m; simp [diagCLM_apply, mul_assoc]

theorem inner_diagCLM (c : Fin 3 → ℝ) (x ξ : E3) :
    inner ℝ (diagCLM c x) ξ = inner ℝ x (diagCLM c ξ) := by
  simp only [inner_eq_sum_E3, diagCLM_apply]
  refine Finset.sum_congr rfl fun m _ => ?_
  ring

/-- Change of variables under a diagonal map with nonzero entries:
`∫ F(diag(c) x) dx = |∏ c|^{-1} ∫ F`. -/
theorem integral_comp_diagCLM {c : Fin 3 → ℝ} (hc : ∀ m, c m ≠ 0) (F : E3 → ℂ) :
    ∫ x : E3, F (diagCLM c x) = |∏ m, c m|⁻¹ * ∫ y : E3, F y := by
  have hdet : LinearMap.det (diagCLM c : E3 →ₗ[ℝ] E3) ≠ 0 := by
    rw [det_diagCLM]; exact Finset.prod_ne_zero_iff.mpr fun m _ => hc m
  have hmap := MeasureTheory.Measure.map_linearMap_addHaar_eq_smul_addHaar
    (μ := (volume : Measure E3)) hdet
  have hme : MeasurableEmbedding (diagCLM c) := by
    have h1 : ∀ x, diagCLM (fun m => (c m)⁻¹) (diagCLM c x) = x := fun x => by
      rw [diagCLM_comp]; ext m; simp [diagCLM_apply, inv_mul_cancel₀ (hc m)]
    have h2 : ∀ x, diagCLM c (diagCLM (fun m => (c m)⁻¹) x) = x := fun x => by
      rw [diagCLM_comp]; ext m; simp [diagCLM_apply, mul_inv_cancel₀ (hc m)]
    exact (ContinuousLinearEquiv.equivOfInverse (diagCLM c) (diagCLM fun m => (c m)⁻¹) h1
      h2).toHomeomorph.measurableEmbedding
  rw [← hme.integral_map, show (diagCLM c : E3 → E3) = ((diagCLM c : E3 →ₗ[ℝ] E3) : E3 → E3)
    from rfl, hmap, integral_smul_measure, det_diagCLM]
  rw [ENNReal.toReal_ofReal (abs_nonneg _), abs_inv, Complex.real_smul]

/-- **The Fourier transform under a diagonal change of variables**:
`𝓕(g ∘ diag(c))(ξ) = |∏ c|^{-1} 𝓕 g(diag(c^{-1}) ξ)`. -/
theorem fourier_comp_diagCLM {c : Fin 3 → ℝ} (hc : ∀ m, c m ≠ 0) (g : E3 → ℂ) (ξ : E3) :
    𝓕 (fun x => g (diagCLM c x)) ξ
      = ((|∏ m, c m|⁻¹ : ℝ) : ℂ) * 𝓕 g (diagCLM (fun m => (c m)⁻¹) ξ) := by
  rw [Real.fourier_eq, Real.fourier_eq]
  have e : ∀ x : E3, Real.fourierChar (-(inner ℝ x ξ)) • g (diagCLM c x)
      = (fun y => Real.fourierChar (-(inner ℝ y (diagCLM (fun m => (c m)⁻¹) ξ))) • g y)
          (diagCLM c x) := by
    intro x
    simp only
    congr 3
    rw [inner_diagCLM, diagCLM_comp]
    congr 1
    ext m
    simp [diagCLM_apply, mul_inv_cancel₀ (hc m)]
  calc ∫ x : E3, Real.fourierChar (-(inner ℝ x ξ)) • g (diagCLM c x)
      = ∫ x : E3, (fun y => Real.fourierChar (-(inner ℝ y (diagCLM (fun m => (c m)⁻¹) ξ))) • g y)
          (diagCLM c x) := integral_congr_ae (Eventually.of_forall e)
    _ = _ := integral_comp_diagCLM hc
          (fun y => Real.fourierChar (-(inner ℝ y (diagCLM (fun m => (c m)⁻¹) ξ))) • g y)

/-- `L^p` norms under a diagonal change of variables:
`‖g ∘ diag(c)‖_p = |∏ c|^{-1/p} ‖g‖_p`. -/
theorem eLpNorm_comp_diagCLM {c : Fin 3 → ℝ} (hc : ∀ m, c m ≠ 0) {g : E3 → ℂ}
    (hg : AEStronglyMeasurable g volume) {p : ℝ≥0∞} (hp0 : p ≠ 0) (hp : p ≠ ⊤) :
    eLpNorm (fun x => g (diagCLM c x)) p volume
      = ENNReal.ofReal |∏ m, c m|⁻¹ ^ p.toReal⁻¹ * eLpNorm g p volume := by
  have hdet : LinearMap.det (diagCLM c : E3 →ₗ[ℝ] E3) ≠ 0 := by
    rw [det_diagCLM]; exact Finset.prod_ne_zero_iff.mpr fun m _ => hc m
  have hmap := MeasureTheory.Measure.map_linearMap_addHaar_eq_smul_addHaar
    (μ := (volume : Measure E3)) hdet
  have hmeas : Measurable (diagCLM c) := (diagCLM c).continuous.measurable
  have h1 : eLpNorm (fun x => g (diagCLM c x)) p volume
      = eLpNorm g p (Measure.map (diagCLM c) volume) := by
    rw [eLpNorm_map_measure (by rw [show (diagCLM c : E3 → E3) = ((diagCLM c : E3 →ₗ[ℝ] E3) :
      E3 → E3) from rfl, hmap]; exact hg.smul_measure _) hmeas.aemeasurable]
    rfl
  rw [h1, show (diagCLM c : E3 → E3) = ((diagCLM c : E3 →ₗ[ℝ] E3) : E3 → E3) from rfl, hmap,
    eLpNorm_smul_measure_of_ne_top hp, det_diagCLM, abs_inv, smul_eq_mul, one_div,
    ENNReal.toReal_inv]

/-- The positive half `w_+(s) = ψ(s)/s` for `s > 0` of the unit-scale weight. -/
def wPos (s : ℝ) : ℝ := if 0 < s then wL s else 0

theorem wPos_eq_zero_of_le {s : ℝ} (h : s ≤ 0) : wPos s = 0 := by simp [wPos, not_lt.mpr h]

theorem wL_eq_wPos_sub (s : ℝ) : wL s = wPos s - wPos (-s) := by
  rcases lt_trichotomy s 0 with h | h | h
  · rw [wPos_eq_zero_of_le h.le, wPos, if_pos (by linarith), wL_neg]; ring
  · subst h; simp [wPos, wL]
  · rw [wPos, if_pos h, wPos_eq_zero_of_le (by linarith), sub_zero]

theorem contDiff_wPos : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) wPos := by
  rw [contDiff_iff_contDiffAt]
  intro s
  by_cases hs : 0 < s
  · have : wPos =ᶠ[𝓝 s] wL := by
      filter_upwards [Ioi_mem_nhds hs] with t ht
      simp [wPos, show 0 < t from ht]
    exact contDiff_wL.contDiffAt.congr_of_eventuallyEq this
  · push Not at hs
    have : wPos =ᶠ[𝓝 s] fun _ => 0 := by
      filter_upwards [Iio_mem_nhds (show s < 1 / 2 by linarith)] with t ht
      by_cases ht0 : 0 < t
      · simp only [wPos, if_pos ht0]
        exact wL_eq_zero_of_abs_lt (by rw [abs_of_pos ht0]; exact ht)
      · exact wPos_eq_zero_of_le (not_lt.mp ht0)
    exact contDiffAt_const.congr_of_eventuallyEq this

theorem support_wPos : Function.support wPos ⊆ Icc (1 / 2) 2 := by
  intro s hs
  rw [Function.mem_support] at hs
  have hs0 : 0 < s := by by_contra h; exact hs (wPos_eq_zero_of_le (not_lt.mp h))
  rw [wPos, if_pos hs0] at hs
  obtain ⟨h1, h2⟩ := wL_ne_zero_band hs
  rw [abs_of_pos hs0] at h1 h2
  exact ⟨h1, h2⟩

/-- The reflection `R = diag(-1, 1, -1)`: `R(t^n e_n) = (-t)^n e_n`. -/
def reflC : Fin 3 → ℝ := ![-1, 1, -1]

theorem reflC_ne_zero (m : Fin 3) : reflC m ≠ 0 := by fin_cases m <;> simp [reflC]

theorem refl_curve (n : Fin 3) (s : ℝ) : diagCLM reflC (curve n s) = curve n (-s) := by
  ext m
  simp only [diagCLM_apply, curve_apply]
  split_ifs with h
  · subst h
    fin_cases m <;> simp [reflC, expo]; ring
  · simp

/-- The dilation `D = diag(2^{j}, 2^{2j}, 2^{3j})` of scale `j`. -/
def dilC (j : ℤ) : Fin 3 → ℝ := fun m => (2 : ℝ) ^ ((expo m : ℤ) * j)

theorem dilC_ne_zero (j : ℤ) (m : Fin 3) : dilC j m ≠ 0 := (zpow_pos two_pos _).ne'

theorem dilC_inv_curve (j : ℤ) (n : Fin 3) (s : ℝ) :
    diagCLM (fun m => (dilC j m)⁻¹) (curve n s) = curve n ((2 : ℝ) ^ (-j) * s) := by
  ext m
  simp only [diagCLM_apply, curve_apply, dilC]
  split_ifs with h
  · subst h
    rw [mul_pow, ← zpow_natCast ((2 : ℝ) ^ (-j)), ← zpow_mul, ← zpow_neg, ← mul_neg]
    congr 2; ring
  · simp

/-- **The rescaling of a single scale** (lines 460-463, 681-685): with `G = g ∘ D^{-1}`,
`T_j(g)(x) = 𝒜_{w_+}(G)(D x) - 𝒜_{w_+}(G ∘ R)(R D x)`. -/
theorem simplexTj_rescale (j : ℤ) {g : Fin 3 → E3 → ℂ} (hg : ∀ n, Continuous (g n)) (x : E3) :
    simplexTj j g x
      = Apsi wPos (fun n y => g n (diagCLM (fun m => (dilC j m)⁻¹) y)) (diagCLM (dilC j) x)
        - Apsi wPos (fun n y => g n (diagCLM (fun m => (dilC j m)⁻¹) (diagCLM reflC y)))
            (diagCLM reflC (diagCLM (dilC j) x)) := by
  set G : Fin 3 → E3 → ℂ := fun n y => g n (diagCLM (fun m => (dilC j m)⁻¹) y) with hG
  have hDinv : ∀ y, diagCLM (fun m => (dilC j m)⁻¹) (diagCLM (dilC j) y) = y := fun y => by
    rw [diagCLM_comp]; ext m; simp [diagCLM_apply, inv_mul_cancel₀ (dilC_ne_zero j m)]
  have hRR : ∀ y, diagCLM reflC (diagCLM reflC y) = y := fun y => by
    rw [diagCLM_comp]; ext m; fin_cases m <;> simp [diagCLM_apply, reflC]
  -- the substitution `t = 2^{-j} s`
  have hsub : simplexTj j g x = ∫ s : ℝ, ((wL s : ℝ) : ℂ) * prodShift G (diagCLM (dilC j) x) s := by
    unfold simplexTj
    have hq : (0 : ℝ) < 2 ^ j := zpow_pos two_pos _
    have h := Measure.integral_comp_mul_left (fun t : ℝ =>
      (lpPsi ((2 : ℝ) ^ j * t) : ℂ) * prodShift g x t / t) ((2 : ℝ) ^ (-j))
    have hc : |((2 : ℝ) ^ (-j))⁻¹| = 2 ^ j := by
      rw [abs_of_pos (inv_pos.mpr (zpow_pos two_pos _)), zpow_neg, inv_inv]
    rw [hc] at h
    have hpt : ∀ s : ℝ, (lpPsi ((2 : ℝ) ^ j * ((2 : ℝ) ^ (-j) * s)) : ℂ) *
        prodShift g x ((2 : ℝ) ^ (-j) * s) / ((((2 : ℝ) ^ (-j) * s : ℝ)) : ℂ)
        = (2 : ℝ) ^ j • (((wL s : ℝ) : ℂ) * prodShift G (diagCLM (dilC j) x) s) := by
      intro s
      have e2 : (2 : ℝ) ^ j * ((2 : ℝ) ^ (-j) * s) = s := by
        rw [← mul_assoc, ← zpow_add₀ two_ne_zero, add_neg_cancel, zpow_zero, one_mul]
      have ep : prodShift g x ((2 : ℝ) ^ (-j) * s) = prodShift G (diagCLM (dilC j) x) s := by
        unfold prodShift
        refine Finset.prod_congr rfl fun n _ => ?_
        simp only [hG, map_add, hDinv, dilC_inv_curve]
      rw [e2, ep, wL, Complex.real_smul, Complex.ofReal_mul, Complex.ofReal_div]
      have hab : (((2 : ℝ) ^ (-j) : ℝ) : ℂ) = (((2 : ℝ) ^ j : ℝ) : ℂ)⁻¹ := by
        rw [zpow_neg, Complex.ofReal_inv]
      have h2 : (((2 : ℝ) ^ j : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hq.ne'
      rw [hab]
      by_cases hs : s = 0
      · subst hs; simp
      · have hs' : ((s : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hs
        field_simp
    simp_rw [hpt] at h
    rw [integral_smul] at h
    have hq0 : ((2 : ℝ) ^ j) ≠ 0 := hq.ne'
    have := congrArg (fun z : ℂ => ((2 : ℝ) ^ j)⁻¹ • z) h
    simp only [smul_smul, inv_mul_cancel₀ hq0, one_smul] at this
    exact this.symm
  rw [hsub]
  -- split `w = w_+ - w_+(-·)`
  set y := diagCLM (dilC j) x with hy
  have hwc : Continuous fun s : ℝ => ((wPos s : ℝ) : ℂ) :=
    Complex.continuous_ofReal.comp contDiff_wPos.continuous
  have hwcs : HasCompactSupport fun s : ℝ => ((wPos s : ℝ) : ℂ) :=
    HasCompactSupport.intro isCompact_Icc (fun s hs => by
      simp only [Complex.ofReal_eq_zero]
      by_contra h; exact hs (support_wPos h))
  have hGc : ∀ n, Continuous (G n) := fun n =>
    (hg n).comp (diagCLM fun m => (dilC j m)⁻¹).continuous
  have hP : Continuous (prodShift G y) := continuous_prodShift hGc y
  have hi1 : Integrable fun s : ℝ => ((wPos s : ℝ) : ℂ) * prodShift G y s :=
    (hwc.mul hP).integrable_of_hasCompactSupport hwcs.mul_right
  have hi2 : Integrable fun s : ℝ => ((wPos (-s) : ℝ) : ℂ) * prodShift G y s := by
    have hwcs' : HasCompactSupport fun s : ℝ => ((wPos (-s) : ℝ) : ℂ) :=
      hwcs.comp_homeomorph (Homeomorph.neg ℝ)
    exact ((hwc.comp continuous_neg).mul hP).integrable_of_hasCompactSupport hwcs'.mul_right
  have hsplit : ∫ s : ℝ, ((wL s : ℝ) : ℂ) * prodShift G y s
      = (∫ s : ℝ, ((wPos s : ℝ) : ℂ) * prodShift G y s)
        - ∫ s : ℝ, ((wPos (-s) : ℝ) : ℂ) * prodShift G y s := by
    refine (integral_congr_ae (Eventually.of_forall fun s => ?_)).trans (integral_sub hi1 hi2)
    simp only [wL_eq_wPos_sub s]
    push_cast; ring
  rw [hsplit]
  unfold Apsi
  congr 1
  rw [← integral_neg_eq_self (fun s : ℝ => ((wPos (-s) : ℝ) : ℂ) * prodShift G y s)]
  refine integral_congr_ae (Eventually.of_forall fun s => ?_)
  simp only [neg_neg]
  congr 1
  unfold prodShift
  refine Finset.prod_congr rfl fun n _ => ?_
  simp only [hG]
  congr 2
  rw [map_add, hRR, refl_curve]

/-- The diagonal map as a linear equivalence. -/
def diagEquiv {c : Fin 3 → ℝ} (hc : ∀ m, c m ≠ 0) : E3 ≃L[ℝ] E3 :=
  ContinuousLinearEquiv.equivOfInverse (diagCLM c) (diagCLM fun m => (c m)⁻¹)
    (fun x => by rw [diagCLM_comp]; ext m; simp [diagCLM_apply, inv_mul_cancel₀ (hc m)])
    (fun x => by rw [diagCLM_comp]; ext m; simp [diagCLM_apply, mul_inv_cancel₀ (hc m)])

theorem diagEquiv_apply {c : Fin 3 → ℝ} (hc : ∀ m, c m ≠ 0) (x : E3) :
    diagEquiv hc x = diagCLM c x := rfl

/-- A Schwartz function precomposed with a diagonal map. -/
def schwartzDiag {c : Fin 3 → ℝ} (hc : ∀ m, c m ≠ 0) (g : 𝓢(E3, ℂ)) : 𝓢(E3, ℂ) :=
  SchwartzMap.compCLMOfContinuousLinearEquiv ℂ (diagEquiv hc) g

theorem schwartzDiag_apply {c : Fin 3 → ℝ} (hc : ∀ m, c m ≠ 0) (g : 𝓢(E3, ℂ)) (x : E3) :
    schwartzDiag hc g x = g (diagCLM c x) := rfl

theorem abs_prod_pos {c : Fin 3 → ℝ} (hc : ∀ m, c m ≠ 0) : 0 < |∏ m, c m| :=
  abs_pos.mpr (Finset.prod_ne_zero_iff.mpr fun m _ => hc m)

theorem inv_ne_zero_fun {c : Fin 3 → ℝ} (hc : ∀ m, c m ≠ 0) : ∀ m, (c m)⁻¹ ≠ 0 :=
  fun m => inv_ne_zero (hc m)

theorem prod_inv_fun (c : Fin 3 → ℝ) : ∏ m, (c m)⁻¹ = (∏ m, c m)⁻¹ := by
  rw [Finset.prod_inv_distrib]

/-- Frequency localization survives a diagonal change of variables. -/
theorem fourier_support_diag {c : Fin 3 → ℝ} (hc : ∀ m, c m ≠ 0) (g : 𝓢(E3, ℂ)) {n0 : Fin 3}
    {lam : ℝ} (hg : ∀ ξ, 𝓕 (g : E3 → ℂ) ξ ≠ 0 → lam * |(c n0)⁻¹| ≤ |ξ n0|) :
    Function.support (𝓕 (schwartzDiag hc g : E3 → ℂ)) ⊆ {ξ : E3 | lam ≤ |ξ n0|} := by
  intro ξ hξ
  rw [Function.mem_support] at hξ
  have e : (schwartzDiag hc g : E3 → ℂ) = fun x => g (diagCLM c x) := rfl
  rw [e, fourier_comp_diagCLM hc] at hξ
  have h := hg _ (right_ne_zero_of_mul hξ)
  simp only [diagCLM_apply, abs_mul] at h
  have hpos : 0 < |(c n0)⁻¹| := abs_pos.mpr (inv_ne_zero (hc n0))
  show lam ≤ |ξ n0|
  nlinarith [abs_nonneg (ξ n0)]

theorem continuous_Apsi_wPos (g : Fin 3 → 𝓢(E3, ℂ)) :
    Continuous (Apsi wPos fun n => g n) := by
  choose C hC0 hC using fun n => exists_bound_schwartz (g n)
  have hw : Integrable fun t : ℝ => ((wPos t : ℝ) : ℂ) :=
    (Complex.continuous_ofReal.comp contDiff_wPos.continuous).integrable_of_hasCompactSupport
      (HasCompactSupport.intro isCompact_Icc (fun s hs => by
        by_contra h; exact hs (support_wPos (by simpa using h))))
  unfold Apsi
  refine continuous_of_dominated (bound := fun t => ‖((wPos t : ℝ) : ℂ)‖ * ∏ n, C n)
    (fun x => ?_) (fun x => Eventually.of_forall fun t => ?_) (hw.norm.mul_const _)
    (Eventually.of_forall fun t => ?_)
  · exact (hw.aestronglyMeasurable.mul
      (continuous_prodShift (fun n => (g n).continuous) x).aestronglyMeasurable)
  · rw [norm_mul, prodShift, norm_prod]
    exact mul_le_mul_of_nonneg_left (Finset.prod_le_prod (fun n _ => norm_nonneg _)
      fun n _ => hC n _) (norm_nonneg _)
  · refine continuous_const.mul ?_
    unfold prodShift
    exact continuous_finsetProd _ fun n _ => (g n).continuous.comp
      (continuous_id.add continuous_const)

theorem integrable_deriv_wPos : Integrable (deriv wPos) := by
  refine (contDiff_wPos.continuous_deriv (by exact_mod_cast le_top)).integrable_of_hasCompactSupport ?_
  exact HasCompactSupport.deriv (HasCompactSupport.intro isCompact_Icc
    (fun s hs => by by_contra h; exact hs (support_wPos h)))

/-- **The single-scale gain** (`lem:gain` proof, lines 460-463): for `p ≥ 1`, `p_n > 1` with
`∑ 1/p_n = 1/p`, there are `δ ∈ (0,1)` and `C` such that for every scale `j`, Schwartz inputs
`g_n` and `λ ≥ 1`, if `ĝ_{n_0}` is supported in `{|ξ_{n_0}| ≥ λ 2^{(n_0+1) j}}` then
`‖T_j(g)‖_p ≤ C λ^{-δ} ∏ ‖g_n‖_{p_n}`: `thm:smoothing` after the anisotropic rescaling
`Auto.simplexTj_rescale`. -/
theorem single_scale_gain {p : ℝ} {pv : Fin 3 → ℝ} (hp : 1 ≤ p) (hpv : ∀ i, 1 < pv i)
    (hsum : ∑ i, (pv i)⁻¹ = p⁻¹) :
    ∃ δ C : ℝ, δ ∈ Set.Ioo (0 : ℝ) 1 ∧ 0 < C ∧
      ∀ (j : ℤ) (g : Fin 3 → 𝓢(E3, ℂ)) (n0 : Fin 3) (lam : ℝ), 1 ≤ lam →
        (∀ ξ, 𝓕 (g n0 : E3 → ℂ) ξ ≠ 0 → lam * (2 : ℝ) ^ ((expo n0 : ℤ) * j) ≤ |ξ n0|) →
        eLpNorm (simplexTj j fun n => g n) (ENNReal.ofReal p) volume
          ≤ ENNReal.ofReal (C * lam ^ (-δ)) * ∏ n, eLpNorm (g n) (ENNReal.ofReal (pv n)) volume := by
  obtain ⟨δ, C, hδ, hC, hsm⟩ := thm_smoothing (a := 1 / 2) (bb := 2) (by norm_num) (by norm_num)
    hp hpv hsum
  set M : ℝ := (∫⁻ t, ‖deriv wPos t‖ₑ ∂volume).toReal with hMdef
  have hMfin : (∫⁻ t, ‖deriv wPos t‖ₑ ∂volume) ≠ ⊤ := integrable_deriv_wPos.2.ne
  have hM0 : 0 ≤ M := ENNReal.toReal_nonneg
  have hMle : (∫⁻ t, ‖deriv wPos t‖ₑ ∂volume) ≤ ENNReal.ofReal M := by
    rw [hMdef, ENNReal.ofReal_toReal hMfin]
  have hderiv : ∀ t, HasDerivAt wPos (deriv wPos t) t := fun t =>
    ((contDiff_wPos.differentiable (by simp)) t).hasDerivAt
  have hderivc : Continuous (deriv wPos) := contDiff_wPos.continuous_deriv (by exact_mod_cast le_top)
  refine ⟨δ, 2 * (C * max 1 M), hδ, by positivity, fun j g n0 lam hlam hg => ?_⟩
  have hpos : 0 < p := by linarith
  have hp0 : ENNReal.ofReal p ≠ 0 := by simpa using hpos
  have hp1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp
  -- the rescaled inputs
  set c : Fin 3 → ℝ := fun m => (dilC j m)⁻¹ with hcdef
  have hc : ∀ m, c m ≠ 0 := fun m => inv_ne_zero (dilC_ne_zero j m)
  set Gs : Fin 3 → 𝓢(E3, ℂ) := fun n => schwartzDiag hc (g n) with hGs
  set Rs : Fin 3 → 𝓢(E3, ℂ) := fun n => schwartzDiag reflC_ne_zero (Gs n) with hRs
  set cR : Fin 3 → ℝ := fun m => reflC m * dilC j m with hcR
  have hcR0 : ∀ m, cR m ≠ 0 := fun m => mul_ne_zero (reflC_ne_zero m) (dilC_ne_zero j m)
  have hresc : (simplexTj j fun n => g n)
      = (fun x => Apsi wPos (fun n => Gs n) (diagCLM (dilC j) x))
        - (fun x => Apsi wPos (fun n => Rs n) (diagCLM cR x)) := by
    funext x
    rw [simplexTj_rescale j (fun n => (g n).continuous) x, Pi.sub_apply, ← diagCLM_comp]
    rfl
  -- the frequency localization of the rescaled inputs
  have hlamG : ∃ n1 : Fin 3, Function.support (𝓕 (Gs n1 : E3 → ℂ)) ⊆ {ξ : E3 | lam ≤ |ξ n1|} := by
    refine ⟨n0, fourier_support_diag hc (g n0) fun ξ hξ => ?_⟩
    have := hg ξ hξ
    simp only [hcdef, inv_inv, dilC] at this ⊢
    rw [abs_of_pos (zpow_pos two_pos _)]
    linarith
  have hlamR : ∃ n1 : Fin 3, Function.support (𝓕 (Rs n1 : E3 → ℂ)) ⊆ {ξ : E3 | lam ≤ |ξ n1|} := by
    obtain ⟨n1, h1⟩ := hlamG
    refine ⟨n1, fourier_support_diag reflC_ne_zero (Gs n1) fun ξ hξ => ?_⟩
    have := h1 (Function.mem_support.mpr hξ)
    simp only [mem_setOf_eq] at this
    have hr : |(reflC n1)⁻¹| = 1 := by fin_cases n1 <;> simp [reflC]
    rw [hr, mul_one]; exact this
  have h1 := hsm wPos (deriv wPos) M hderiv hderivc support_wPos hM0 hMle lam hlam Gs hlamG
  have h2 := hsm wPos (deriv wPos) M hderiv hderivc support_wPos hM0 hMle lam hlam Rs hlamR
  -- norms of the rescaled inputs
  set d : ℝ := |∏ m, dilC j m| with hd
  have hd0 : 0 < d := abs_prod_pos (dilC_ne_zero j)
  have hGn : ∀ n, eLpNorm (Gs n) (ENNReal.ofReal (pv n)) volume
      = ENNReal.ofReal d ^ (pv n)⁻¹ * eLpNorm (g n) (ENNReal.ofReal (pv n)) volume := by
    intro n
    have hpvn : 0 < pv n := by linarith [hpv n]
    have := eLpNorm_comp_diagCLM hc (g n).continuous.aestronglyMeasurable (p := ENNReal.ofReal (pv n))
      (by simpa using hpvn) ENNReal.ofReal_ne_top
    rw [ENNReal.toReal_ofReal hpvn.le] at this
    rw [show (Gs n : E3 → ℂ) = fun x => g n (diagCLM c x) from rfl, this, hcdef, prod_inv_fun,
      abs_inv, inv_inv]
  have hRn : ∀ n, eLpNorm (Rs n) (ENNReal.ofReal (pv n)) volume
      = eLpNorm (Gs n) (ENNReal.ofReal (pv n)) volume := by
    intro n
    have hpvn : 0 < pv n := by linarith [hpv n]
    have := eLpNorm_comp_diagCLM reflC_ne_zero (Gs n).continuous.aestronglyMeasurable
      (p := ENNReal.ofReal (pv n)) (by simpa using hpvn) ENNReal.ofReal_ne_top
    have hr : |∏ m, reflC m|⁻¹ = 1 := by simp [reflC, Fin.prod_univ_three]
    rw [show (Rs n : E3 → ℂ) = fun x => Gs n (diagCLM reflC x) from rfl, this, hr,
      ENNReal.ofReal_one, ENNReal.one_rpow, one_mul]
  have hprod : ∏ n, eLpNorm (Gs n) (ENNReal.ofReal (pv n)) volume
      = ENNReal.ofReal d ^ p⁻¹ * ∏ n, eLpNorm (g n) (ENNReal.ofReal (pv n)) volume := by
    simp_rw [hGn]
    rw [Finset.prod_mul_distrib]
    congr 1
    simp_rw [ENNReal.ofReal_rpow_of_pos hd0]
    rw [← ENNReal.ofReal_prod_of_nonneg fun n _ => (Real.rpow_pos_of_pos hd0 _).le,
      ← Real.rpow_sum_of_pos hd0, hsum]
  -- the output norms
  have hout : ∀ (F : E3 → ℂ) (e : Fin 3 → ℝ), (∀ m, e m ≠ 0) → |∏ m, e m| = d →
      AEStronglyMeasurable F volume →
      eLpNorm (fun x => F (diagCLM e x)) (ENNReal.ofReal p) volume
        = ENNReal.ofReal d⁻¹ ^ p⁻¹ * eLpNorm F (ENNReal.ofReal p) volume := by
    intro F e he hde hF
    rw [eLpNorm_comp_diagCLM he hF hp0 ENNReal.ofReal_ne_top, hde, ENNReal.toReal_ofReal hpos.le]
  have hdR : |∏ m, cR m| = d := by
    simp only [hcR, Finset.prod_mul_distrib, abs_mul, hd]
    simp [reflC, Fin.prod_univ_three]
  set K : ℝ := C * max 1 M * lam ^ (-δ) with hK
  have hK0 : 0 ≤ K := by positivity
  set X : ℝ≥0∞ := ENNReal.ofReal d⁻¹ ^ p⁻¹ with hX
  set P : ℝ≥0∞ := ∏ n, eLpNorm (g n) (ENNReal.ofReal (pv n)) volume with hP
  have hXY : X * ENNReal.ofReal d ^ p⁻¹ = 1 := by
    rw [hX, ← ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hpos.le),
      ← ENNReal.ofReal_mul (inv_nonneg.mpr hd0.le), inv_mul_cancel₀ hd0.ne', ENNReal.ofReal_one,
      ENNReal.one_rpow]
  have hc1 : Continuous fun x => Apsi wPos (fun n => Gs n) (diagCLM (dilC j) x) :=
    (continuous_Apsi_wPos Gs).comp (diagCLM (dilC j)).continuous
  have hc2 : Continuous fun x => Apsi wPos (fun n => Rs n) (diagCLM cR x) :=
    (continuous_Apsi_wPos Rs).comp (diagCLM cR).continuous
  have hRprod : ∏ n, eLpNorm (Rs n) (ENNReal.ofReal (pv n)) volume
      = ∏ n, eLpNorm (Gs n) (ENNReal.ofReal (pv n)) volume :=
    Finset.prod_congr rfl fun n _ => hRn n
  calc eLpNorm (simplexTj j fun n => g n) (ENNReal.ofReal p) volume
      = eLpNorm ((fun x => Apsi wPos (fun n => Gs n) (diagCLM (dilC j) x))
          - (fun x => Apsi wPos (fun n => Rs n) (diagCLM cR x))) (ENNReal.ofReal p) volume := by
        rw [hresc]
    _ ≤ eLpNorm (fun x => Apsi wPos (fun n => Gs n) (diagCLM (dilC j) x)) (ENNReal.ofReal p) volume
        + eLpNorm (fun x => Apsi wPos (fun n => Rs n) (diagCLM cR x)) (ENNReal.ofReal p) volume :=
        eLpNorm_sub_le hc1.aestronglyMeasurable hc2.aestronglyMeasurable hp1
    _ = X * eLpNorm (Apsi wPos fun n => Gs n) (ENNReal.ofReal p) volume
        + X * eLpNorm (Apsi wPos fun n => Rs n) (ENNReal.ofReal p) volume := by
        rw [hout _ (dilC j) (dilC_ne_zero j) rfl (continuous_Apsi_wPos Gs).aestronglyMeasurable,
          hout _ cR hcR0 hdR (continuous_Apsi_wPos Rs).aestronglyMeasurable]
    _ ≤ X * (ENNReal.ofReal K * ∏ n, eLpNorm (Gs n) (ENNReal.ofReal (pv n)) volume)
        + X * (ENNReal.ofReal K * ∏ n, eLpNorm (Rs n) (ENNReal.ofReal (pv n)) volume) :=
        add_le_add (mul_le_mul_right h1 _) (mul_le_mul_right h2 _)
    _ = ENNReal.ofReal (2 * (C * max 1 M) * lam ^ (-δ)) * P := by
        rw [hRprod, hprod, ← two_mul]
        have e2 : ENNReal.ofReal (2 * (C * max 1 M) * lam ^ (-δ)) = 2 * ENNReal.ofReal K := by
          rw [hK, show 2 * (C * max 1 M) * lam ^ (-δ) = 2 * (C * max 1 M * lam ^ (-δ)) by ring,
            ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_ofNat]
        rw [e2]
        calc 2 * (X * (ENNReal.ofReal K * (ENNReal.ofReal d ^ p⁻¹ * P)))
            = 2 * ENNReal.ofReal K * P * (X * ENNReal.ofReal d ^ p⁻¹) := by ring
          _ = 2 * ENNReal.ofReal K * P := by rw [hXY, mul_one]

/-! ### The partial Littlewood-Paley square function (lines 468-471) -/

/-- The line `ℝ` as `Euclidean 1`. -/
abbrev E1 : Type := EuclideanSpace ℝ (Fin 1)

theorem norm_E1 (ξ : E1) : ‖ξ‖ = |ξ 0| := by
  rw [EuclideanSpace.norm_eq, Fin.sum_univ_one, Real.norm_eq_abs, Real.sqrt_sq_eq_abs, abs_abs]

theorem continuous_E1_coord : Continuous fun ξ : E1 => ξ 0 := by fun_prop

theorem contDiff_phi1 : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun ξ : E1 => ((lpPhi (ξ 0) : ℝ) : ℂ)) :=
  Complex.ofRealCLM.contDiff.comp (contDiff_lpPhi.comp (EuclideanSpace.proj (𝕜 := ℝ) (0 : Fin 1)).contDiff)

theorem hasCompactSupport_phi1 : HasCompactSupport (fun ξ : E1 => ((lpPhi (ξ 0) : ℝ) : ℂ)) := by
  refine HasCompactSupport.intro (isCompact_closedBall (0 : E1) 2) fun ξ hξ => ?_
  rw [Metric.mem_closedBall, dist_zero_right, not_le, norm_E1] at hξ
  simp [lpPhi_eq_zero hξ.le]

/-- Our `φ` as lean-spherical cutoff data on `ℝ`. -/
def phiCutoffs : Auto.LittlewoodPaley.lpCutoffs 1 where
  cutoff := hasCompactSupport_phi1.toSchwartzMap contDiff_phi1
  cutoff_one := fun ξ hξ => by
    show ((lpPhi (ξ 0) : ℝ) : ℂ) = 1
    rw [norm_E1] at hξ; simp [lpPhi_eq_one hξ]
  cutoff_zero := fun ξ hξ => by
    show ((lpPhi (ξ 0) : ℝ) : ℂ) = 0
    rw [norm_E1] at hξ; simp [lpPhi_eq_zero hξ]
  norm_le_one := fun ξ => by
    show ‖((lpPhi (ξ 0) : ℝ) : ℂ)‖ ≤ 1
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (lpPhi_nonneg _)]
    exact lpPhi_le_one _

/-- Their band `k` is our `ψ_{k+1}`. -/
theorem phiCutoffs_band (k : ℤ) (ξ : E1) :
    Auto.LittlewoodPaley.intDyadicBandpassMultiplier phiCutoffs.cutoff k ξ
      = ((lpPsiJ (k + 1) (ξ 0) : ℝ) : ℂ) := by
  rw [Auto.LittlewoodPaley.intDyadicBandpassMultiplier_apply, lpPsiJ_eq]
  show ((lpPhi ((((2 : ℝ) ^ (k + 1))⁻¹ • ξ) 0) : ℝ) : ℂ) - ((lpPhi ((((2 : ℝ) ^ k)⁻¹ • ξ) 0) : ℝ) : ℂ)
    = ((lpPhiJ (k + 1) (ξ 0) - lpPhiJ (k + 1 - 1) (ξ 0) : ℝ) : ℂ)
  simp only [PiLp.smul_apply, smul_eq_mul, lpPhiJ, add_sub_cancel_right, zpow_neg]
  push_cast; ring

theorem schwartz_inversion_apply_E1 (g : 𝓢(E1, ℂ)) (z : E1) :
    g z = ∫ ξ : E1, Real.fourierChar (inner ℝ ξ z) • 𝓕 (g : E1 → ℂ) ξ := by
  have h := congrArg (fun F : 𝓢(E1, ℂ) => F z)
    (FourierPair.fourierInv_fourier_eq (E := 𝓢(E1, ℂ)) (F := 𝓢(E1, ℂ)) g)
  rw [← h, SchwartzMap.fourierInv_coe, Real.fourierInv_eq, SchwartzMap.fourier_coe]

/-- The unit vector of `E1`. -/
def e1 : E1 := EuclideanSpace.single 0 1

/-- **Their band projection is the line convolution with `ψ̌_{k+1}`**:
`Δ_k g(s) = ∫ ψ̌_{k+1}(u) g(s - u e_1) du`. -/
theorem integerDyadicProjection_eq_lineConv (k : ℤ) (g : 𝓢(E1, ℂ)) (s : E1) :
    Auto.LittlewoodPaley.integerDyadicProjection phiCutoffs.cutoff k g s
      = ∫ u : ℝ, (psiCM (k + 1)).check u * g (s - u • e1) := by
  set χ := psiCM (k + 1) with hχ
  unfold Auto.LittlewoodPaley.integerDyadicProjection
  rw [Real.fourierInv_eq]
  simp_rw [phiCutoffs_band]
  set G : E1 × ℝ → ℂ := fun p => (Real.fourierChar (inner ℝ p.1 s) : ℂ) *
      ((Real.fourierChar (-(p.2 * p.1 0)) : ℂ) * χ.check p.2 * 𝓕 (g : E1 → ℂ) p.1) with hG
  have hint : Integrable G (volume.prod volume) := by
    refine Integrable.mono' (((𝓕 g).integrable.norm.mul_prod
      χ.check.integrable.norm)) ?_ (Eventually.of_forall fun p => ?_)
    · have h4 : Continuous fun p : E1 × ℝ => 𝓕 (g : E1 → ℂ) p.1 := by
        rw [← SchwartzMap.fourier_coe]; exact (𝓕 g).continuous.comp continuous_fst
      refine (Continuous.aestronglyMeasurable ?_)
      exact (continuous_subtype_val.comp (Real.continuous_fourierChar.comp
        (continuous_fst.inner continuous_const))).mul
        (((continuous_subtype_val.comp (Real.continuous_fourierChar.comp
          (continuous_snd.mul (continuous_E1_coord.comp continuous_fst)).neg)).mul
          (χ.check.continuous.comp continuous_snd)).mul h4)
    · simp only [hG, norm_mul, Circle.norm_coe, one_mul, ← SchwartzMap.fourier_coe]
      exact le_of_eq (mul_comm _ _)
  have e1' : (fun ξ : E1 => Real.fourierChar (inner ℝ ξ s) •
      (((lpPsiJ (k + 1) (ξ 0) : ℝ) : ℂ) * 𝓕 (g : E1 → ℂ) ξ))
      = fun ξ => ∫ u : ℝ, G (ξ, u) := by
    funext ξ
    have hh : ((lpPsiJ (k + 1) (ξ 0) : ℝ) : ℂ)
        = ∫ u : ℝ, Real.fourierChar (-(u * ξ 0)) • χ.check u := χ.h_eq_fourier_check (ξ 0)
    rw [hh, ← integral_mul_const, Circle.smul_def, smul_eq_mul, ← integral_const_mul]
    refine integral_congr_ae (Eventually.of_forall fun u => ?_)
    simp only [hG, Circle.smul_def, smul_eq_mul, hχ]
  rw [e1', integral_integral_swap hint]
  refine integral_congr_ae (Eventually.of_forall fun u => ?_)
  simp only
  rw [schwartz_inversion_apply_E1 g (s - u • e1), ← integral_const_mul]
  refine integral_congr_ae (Eventually.of_forall fun ξ => ?_)
  simp only [hG, Circle.smul_def, smul_eq_mul]
  have hin : inner ℝ ξ (s - u • e1) = inner ℝ ξ s + -(u * ξ 0) := by
    rw [inner_sub_right, inner_smul_right, e1, EuclideanSpace.inner_single_right]
    simp; ring
  rw [hin, AddChar.map_add_eq_mul, Circle.coe_mul]
  ring

/-- The base point `y(r)` of the line through the remaining coordinates `r`, with `y_ℓ = 0`. -/
def fiberBase (ℓ : Fin 3) (r : Fin 2 → ℝ) : E3 := WithLp.toLp 2 (Fin.insertNth ℓ 0 r)

theorem insertNth_eq_fiberBase_add (ℓ : Fin 3) (s : ℝ) (r : Fin 2 → ℝ) :
    (WithLp.toLp 2 (Fin.insertNth ℓ s r) : E3) = fiberBase ℓ r + s • basisVec ℓ := by
  ext m
  simp only [fiberBase, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, basisVec,
    PiLp.single_apply]
  rcases Fin.eq_self_or_eq_succAbove ℓ m with h | ⟨i, rfl⟩
  · subst h; simp
  · simp [Fin.insertNth_apply_succAbove, Fin.succAbove_ne]

/-- **Fibrewise Tonelli on `ℝ^3`**: `∫ F = ∫_{r ∈ ℝ^2} ∫_{s ∈ ℝ} F(y(r) + s e_ℓ) ds dr`. -/
theorem lintegral_E3_fiber (ℓ : Fin 3) {F : E3 → ℝ≥0∞} (hF : Measurable F) :
    ∫⁻ x, F x = ∫⁻ r : Fin 2 → ℝ, ∫⁻ s : ℝ, F (fiberBase ℓ r + s • basisVec ℓ) := by
  rw [← (PiLp.volume_preserving_toLp (Fin 3)).lintegral_comp_emb
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  have hmp := (measurePreserving_piFinSuccAbove (fun _ : Fin 3 => (volume : Measure ℝ)) ℓ).symm
  conv_lhs => rw [volume_pi]
  rw [← hmp.lintegral_comp_emb (MeasurableEquiv.measurableEmbedding _)]
  have hF' : Measurable fun p : ℝ × (Fin 2 → ℝ) =>
      F (WithLp.toLp 2 ((MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) ℓ).symm p)) :=
    hF.comp ((PiLp.continuous_toLp 2 _).measurable.comp
      (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) ℓ).symm.measurable)
  rw [show (Measure.pi fun j : Fin 2 => (volume : Measure ℝ)) = volume from volume_pi.symm,
    lintegral_prod _ hF'.aemeasurable, lintegral_lintegral_swap hF'.aemeasurable]
  refine lintegral_congr fun r => lintegral_congr fun s => ?_
  simp only [MeasurableEquiv.piFinSuccAbove_symm_apply]
  show F (WithLp.toLp 2 (Fin.insertNth ℓ s r)) = _
  rw [insertNth_eq_fiberBase_add]

/-- The line map `v ↦ v_0 e_ℓ` from `E1` to `ℝ^3`. -/
def lineMap1 (ℓ : Fin 3) : E1 →L[ℝ] E3 :=
  (EuclideanSpace.proj (𝕜 := ℝ) (0 : Fin 1)).smulRight (basisVec ℓ)

theorem lineMap1_apply (ℓ : Fin 3) (v : E1) : lineMap1 ℓ v = v 0 • basisVec ℓ := by
  simp [lineMap1]

theorem lineMap1_injective (ℓ : Fin 3) : Function.Injective (lineMap1 ℓ) := by
  intro v w h
  have := congrArg (fun z : E3 => z ℓ) h
  simp only [lineMap1_apply, PiLp.smul_apply, smul_eq_mul, basisVec] at this
  simp at this
  ext i; fin_cases i; exact this

/-- The fibre `v ↦ g(y + v_0 e_ℓ)` of a Schwartz function, as a Schwartz function on `E1`. -/
def fiberS (ℓ : Fin 3) (y : E3) (g : 𝓢(E3, ℂ)) : 𝓢(E1, ℂ) :=
  Twisted.schwartzAffinePullbackOfInjective (𝕜 := ℂ) (lineMap1 ℓ) (lineMap1_injective ℓ) y g

theorem fiberS_apply (ℓ : Fin 3) (y : E3) (g : 𝓢(E3, ℂ)) (v : E1) :
    fiberS ℓ y g v = g (y + v 0 • basisVec ℓ) := by
  simp [fiberS, Twisted.schwartzAffinePullbackOfInjective_apply, lineMap1_apply, add_comm]

/-- The one-dimensional band projection of a fibre is the fibre of `Δ^{(ℓ)}_m`. -/
theorem projection_fiberS (ℓ : Fin 3) (m : ℤ) (y : E3) (f : 𝓢(E3, ℂ)) (v : E1) :
    Auto.LittlewoodPaley.integerDyadicProjection phiCutoffs.cutoff (m - 1) (fiberS ℓ y f) v
      = fiberS ℓ y (lpDelta ℓ m f) v := by
  rw [integerDyadicProjection_eq_lineConv, fiberS_apply, ← psiCM_op, CoordMult.op_eq_lineConv,
    sub_add_cancel]
  refine integral_congr_ae (Eventually.of_forall fun u => ?_)
  simp only [fiberS_apply]
  congr 2
  simp only [PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, e1, PiLp.single_apply,
    if_true, mul_one, sub_smul]
  abel

theorem single_E1_apply (s : ℝ) : (EuclideanSpace.single (0 : Fin 1) s : E1) 0 = s := by simp

/-- `∫_{E1} G = ∫_ℝ G(s e_1)`. -/
theorem lintegral_E1 {G : E1 → ℝ≥0∞} (_hG : Measurable G) :
    ∫⁻ v, G v = ∫⁻ s : ℝ, G (EuclideanSpace.single 0 s) := by
  rw [← (PiLp.volume_preserving_toLp (Fin 1)).lintegral_comp_emb
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  have h := (volume_preserving_funUnique (Fin 1) ℝ).symm.lintegral_comp_emb
    (MeasurableEquiv.measurableEmbedding _) (fun a => G (WithLp.toLp 2 a))
  refine h.symm.trans (lintegral_congr fun s => ?_)
  congr 1
  ext i; fin_cases i; simp

/-- `(∑_{m∈S} a_m^2)^{q/2} ≤ |S|^{q/2} ∑_{m∈S} a_m^q` for `a_m ≥ 0`, `q > 0`. -/
theorem sum_sq_rpow_le {ι : Type*} (S : Finset ι) {a : ι → ℝ} (ha : ∀ i, 0 ≤ a i) {q : ℝ}
    (hq : 0 < q) :
    (∑ i ∈ S, a i ^ 2) ^ (q / 2) ≤ (S.card : ℝ) ^ (q / 2) * ∑ i ∈ S, a i ^ q := by
  set M := ∑ i ∈ S, a i ^ q with hM
  have hM0 : 0 ≤ M := Finset.sum_nonneg fun i _ => Real.rpow_nonneg (ha i) _
  have hterm : ∀ i ∈ S, a i ^ 2 ≤ M ^ (2 / q) := by
    intro i hi
    have h1 : a i ^ q ≤ M := Finset.single_le_sum (f := fun i => a i ^ q)
      (fun i _ => Real.rpow_nonneg (ha i) _) hi
    have := Real.rpow_le_rpow (Real.rpow_nonneg (ha i) _) h1 (show 0 ≤ 2 / q by positivity)
    rwa [← Real.rpow_mul (ha i), mul_div_cancel₀ _ hq.ne', Real.rpow_two] at this
  have hsum : ∑ i ∈ S, a i ^ 2 ≤ S.card * M ^ (2 / q) := by
    calc ∑ i ∈ S, a i ^ 2 ≤ ∑ _i ∈ S, M ^ (2 / q) := Finset.sum_le_sum hterm
      _ = S.card * M ^ (2 / q) := by rw [Finset.sum_const, nsmul_eq_mul]
  calc (∑ i ∈ S, a i ^ 2) ^ (q / 2)
      ≤ ((S.card : ℝ) * M ^ (2 / q)) ^ (q / 2) :=
        Real.rpow_le_rpow (Finset.sum_nonneg fun i _ => sq_nonneg _) hsum (by positivity)
    _ = (S.card : ℝ) ^ (q / 2) * M := by
        rw [Real.mul_rpow (Nat.cast_nonneg _) (Real.rpow_nonneg hM0 _), ← Real.rpow_mul hM0,
          div_mul_div_comm, mul_comm 2 q, div_self (by positivity), Real.rpow_one]

theorem measurable_lpDelta_energy (ℓ : Fin 3) (S : Finset ℤ) (f : 𝓢(E3, ℂ)) (q : ℝ) :
    Measurable fun x : E3 => ENNReal.ofReal ((∑ m ∈ S, ‖lpDelta ℓ m f x‖ ^ 2) ^ (q / 2)) := by
  refine ENNReal.measurable_ofReal.comp (Measurable.pow_const ?_ _)
  exact Finset.measurable_sum _ fun m _ => ((lpDelta ℓ m f).continuous.norm.pow 2).measurable

/-- **The partial Littlewood-Paley square function** in coordinate `ℓ` (lines 468-471), for
Schwartz inputs and every finite family of scales, with a constant independent of the family:
`∫ (∑_{m∈S} |Δ^{(ℓ)}_m f|^2)^{q/2} ≤ A ∫ |f|^q`, `1 < q < ∞`.  Obtained fibrewise from the
one-dimensional theorem of lean-spherical (`Auto.MikhlinHormander.littlewoodPaley_of_mikhlin`). -/
theorem partial_littlewoodPaley (ℓ : Fin 3) {q : ℝ} (hq : 1 < q) :
    ∃ A : ℝ, 0 < A ∧ ∀ (S : Finset ℤ) (f : 𝓢(E3, ℂ)),
      ∫⁻ x, ENNReal.ofReal ((∑ m ∈ S, ‖lpDelta ℓ m f x‖ ^ 2) ^ (q / 2))
        ≤ ENNReal.ofReal A * ∫⁻ x, ENNReal.ofReal (‖f x‖ ^ q) := by
  obtain ⟨A, hA, hLP⟩ := Auto.MikhlinHormander.littlewoodPaley_of_mikhlin phiCutoffs q hq
  refine ⟨A, hA, fun S f => ?_⟩
  have hq0 : 0 < q := by linarith
  rw [lintegral_E3_fiber ℓ (measurable_lpDelta_energy ℓ S f q),
    lintegral_E3_fiber ℓ (F := fun x => ENNReal.ofReal (‖f x‖ ^ q))
      (ENNReal.measurable_ofReal.comp (f.continuous.norm.measurable.pow_const q)),
    ← lintegral_const_mul _ (by
      refine Measurable.lintegral_prod_right' (f := fun p : (Fin 2 → ℝ) × ℝ =>
        ENNReal.ofReal (‖f (fiberBase ℓ p.1 + p.2 • basisVec ℓ)‖ ^ q)) ?_
      refine ENNReal.measurable_ofReal.comp (Measurable.pow_const ?_ _)
      refine (f.continuous.comp ?_).norm.measurable
      show Continuous fun p : (Fin 2 → ℝ) × ℝ => fiberBase ℓ p.1 + p.2 • basisVec ℓ
      unfold fiberBase
      exact ((PiLp.continuous_toLp 2 _).comp (Continuous.finInsertNth (A := fun _ => ℝ) ℓ
        continuous_const continuous_fst)).add (continuous_snd.smul continuous_const))]
  refine lintegral_mono fun r => ?_
  set y := fiberBase ℓ r with hy
  set g := fiberS ℓ y f with hg
  set K : Finset ℤ := S.image (fun m => m - 1) with hK
  -- the fibre inequality from the one-dimensional theorem
  have hfib := hLP K g
  have henergy : ∀ v : E1, Auto.LittlewoodPaley.finiteIntegerDyadicSquareEnergy phiCutoffs K g v
      = ∑ m ∈ S, ‖lpDelta ℓ m f (y + v 0 • basisVec ℓ)‖ ^ 2 := by
    intro v
    unfold Auto.LittlewoodPaley.finiteIntegerDyadicSquareEnergy
      Auto.LittlewoodPaley.finiteSquareEnergy
    rw [hK, Finset.sum_image (fun a _ b _ h => by simpa using h)]
    refine Finset.sum_congr rfl fun m _ => ?_
    beta_reduce
    rw [projection_fiberS, fiberS_apply]
  -- integrability on the fibre
  have hgint : Integrable fun v : E1 => ‖g v‖ ^ q :=
    (g.memLp (ENNReal.ofReal q) volume).integrable_norm_rpow (by simpa using hq0) ENNReal.ofReal_ne_top
      |>.congr (Eventually.of_forall fun v => by simp [ENNReal.toReal_ofReal hq0.le])
  have heint : Integrable fun v : E1 =>
      (Auto.LittlewoodPaley.finiteIntegerDyadicSquareEnergy phiCutoffs K g v) ^ (q / 2) := by
    have hdom : Integrable fun v : E1 => (S.card : ℝ) ^ (q / 2) *
        ∑ m ∈ S, ‖fiberS ℓ y (lpDelta ℓ m f) v‖ ^ q := by
      refine Integrable.const_mul (integrable_finsetSum _ fun m _ => ?_) _
      exact ((fiberS ℓ y (lpDelta ℓ m f)).memLp (ENNReal.ofReal q) volume).integrable_norm_rpow
        (by simpa using hq0) ENNReal.ofReal_ne_top |>.congr
          (Eventually.of_forall fun v => by simp [ENNReal.toReal_ofReal hq0.le])
    refine hdom.mono' ?_ (Eventually.of_forall fun v => ?_)
    · refine (Continuous.aestronglyMeasurable ?_)
      simp_rw [henergy]
      refine (continuous_finsetSum _ fun m _ => ?_).rpow_const fun _ => Or.inr (by positivity)
      exact ((lpDelta ℓ m f).continuous.comp (continuous_const.add
        (continuous_E1_coord.smul continuous_const))).norm.pow 2
    · rw [henergy, Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg
        (Finset.sum_nonneg fun m _ => sq_nonneg _) _)]
      have := sum_sq_rpow_le S (a := fun m => ‖lpDelta ℓ m f (y + v 0 • basisVec ℓ)‖)
        (fun m => norm_nonneg _) hq0
      simpa only [fiberS_apply] using this
  -- transport the fibre inequality to `lintegral`s over `ℝ`
  have hL : ∫⁻ s : ℝ, ENNReal.ofReal ((∑ m ∈ S, ‖lpDelta ℓ m f (y + s • basisVec ℓ)‖ ^ 2) ^ (q / 2))
      = ENNReal.ofReal (∫ v : E1,
          (Auto.LittlewoodPaley.finiteIntegerDyadicSquareEnergy phiCutoffs K g v) ^ (q / 2)) := by
    rw [ofReal_integral_eq_lintegral_ofReal heint (Eventually.of_forall fun v =>
      Real.rpow_nonneg (by rw [henergy]; exact Finset.sum_nonneg fun m _ => sq_nonneg _) _)]
    rw [lintegral_E1 (G := fun v => ENNReal.ofReal
        ((Auto.LittlewoodPaley.finiteIntegerDyadicSquareEnergy phiCutoffs K g v) ^ (q / 2))) (by
      simp_rw [henergy]
      refine ENNReal.measurable_ofReal.comp (Measurable.pow_const ?_ _)
      refine Finset.measurable_sum _ fun m _ => ?_
      exact ((lpDelta ℓ m f).continuous.comp (continuous_const.add
        (continuous_E1_coord.smul continuous_const))).norm.pow 2 |>.measurable)]
    refine lintegral_congr fun s => ?_
    rw [henergy, single_E1_apply]
  have hR : ∫⁻ s : ℝ, ENNReal.ofReal (‖f (y + s • basisVec ℓ)‖ ^ q)
      = ENNReal.ofReal (∫ v : E1, ‖g v‖ ^ q) := by
    rw [ofReal_integral_eq_lintegral_ofReal hgint (Eventually.of_forall fun v =>
      Real.rpow_nonneg (norm_nonneg _) _)]
    rw [lintegral_E1 (G := fun v => ENNReal.ofReal (‖g v‖ ^ q)) (ENNReal.measurable_ofReal.comp
      (g.continuous.norm.measurable.pow_const q))]
    refine lintegral_congr fun s => ?_
    rw [hg, fiberS_apply, single_E1_apply]
  rw [hL, hR, ← ENNReal.ofReal_mul hA.le]
  exact ENNReal.ofReal_le_ofReal hfib

/-- The Fourier transform of `Δ^{(ℓ)}_m g` is `ψ_m(ξ_ℓ) ĝ(ξ)`. -/
theorem fourier_lpDelta (ℓ : Fin 3) (m : ℤ) (g : 𝓢(E3, ℂ)) (ξ : E3) :
    𝓕 (lpDelta ℓ m g : E3 → ℂ) ξ = ((lpPsiJ m (ξ ℓ) : ℝ) : ℂ) * 𝓕 (g : E3 → ℂ) ξ := by
  have h : 𝓕 (lpDelta ℓ m g) = SchwartzMap.smulLeftCLM ℂ (psiCoord ℓ m) (𝓕 g) := by
    show 𝓕 (𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psiCoord ℓ m) (𝓕 g))) = _
    exact FourierInvPair.fourier_fourierInv_eq (E := 𝓢(E3, ℂ)) (F := 𝓢(E3, ℂ)) _
  have h2 := congrArg (fun F : 𝓢(E3, ℂ) => F ξ) h
  simp only [SchwartzMap.fourier_coe] at h2
  rw [h2, SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_psiCoord ℓ m), smul_eq_mul,
    SchwartzMap.fourier_coe]
  rfl

/-- `Δ^{(ℓ)}_m g` has Fourier support in `{2^{m-1} ≤ |ξ_ℓ|}`. -/
theorem fourier_lpDelta_support (ℓ : Fin 3) (m : ℤ) (g : 𝓢(E3, ℂ)) (ξ : E3)
    (h : 𝓕 (lpDelta ℓ m g : E3 → ℂ) ξ ≠ 0) : (2 : ℝ) ^ (m - 1) ≤ |ξ ℓ| := by
  rw [fourier_lpDelta] at h
  have h1 : lpPsi ((2 : ℝ) ^ (-m) * ξ ℓ) ≠ 0 := by
    intro h0; apply h; rw [lpPsiJ, h0]; simp
  have h2 := (lpPsi_support h1).1
  have hp : (0 : ℝ) < 2 ^ m := zpow_pos two_pos _
  rw [abs_mul, abs_of_pos (zpow_pos two_pos _), zpow_neg, ← div_eq_inv_mul, le_div_iff₀ hp] at h2
  rw [zpow_sub₀ two_ne_zero, zpow_one]; linarith

/-- `T_j(g)` is continuous for Schwartz inputs (dominated convergence). -/
theorem continuous_simplexTj (j : ℤ) (g : Fin 3 → 𝓢(E3, ℂ)) :
    Continuous (simplexTj j fun n => g n) := by
  obtain ⟨Cb, hCb⟩ : ∃ Cb : ℝ, ∀ i x, ‖g i x‖ ≤ Cb := by
    refine ⟨∑ i, ‖(g i).toBoundedContinuousFunction‖, fun i x => ?_⟩
    refine ((g i).toBoundedContinuousFunction.norm_coe_le_norm x).trans ?_
    exact Finset.single_le_sum (f := fun i => ‖(g i).toBoundedContinuousFunction‖)
      (fun i _ => norm_nonneg _) (Finset.mem_univ i)
  unfold simplexTj
  refine continuous_of_dominated (bound := fun t => ‖(lpPsi ((2 : ℝ) ^ j * t) : ℂ) / t‖ * Cb ^ 3)
    (fun x => ?_) (fun x => Eventually.of_forall fun t => ?_) ((integrable_psi_div j).norm.mul_const _)
    (Eventually.of_forall fun t => ?_)
  · refine ((integrable_psi_div j).aestronglyMeasurable.mul
      (continuous_prodShift (fun n => (g n).continuous) x).aestronglyMeasurable).congr
      (Eventually.of_forall fun t => ?_)
    simp only [Pi.mul_apply]; ring
  · rw [mul_div_right_comm, norm_mul]
    exact mul_le_mul_of_nonneg_left (norm_prodShift_le hCb x t) (norm_nonneg _)
  · have : Continuous fun x => prodShift (fun n => g n) x t := by
      unfold prodShift
      exact continuous_finsetProd _ fun i _ => (g i).continuous.comp (continuous_id.add continuous_const)
    exact continuous_const.mul this |>.div_const _

/-- `ℓ^2 ⊆ ℓ^q` for `q ≥ 2`: `∑ a_m^q ≤ (∑ a_m^2)^{q/2}`, `a_m ≥ 0`. -/
theorem sum_rpow_le_sum_sq_rpow {ι : Type*} (S : Finset ι) {a : ι → ℝ} (ha : ∀ i, 0 ≤ a i)
    {q : ℝ} (hq : 2 ≤ q) :
    ∑ i ∈ S, a i ^ q ≤ (∑ i ∈ S, a i ^ 2) ^ (q / 2) := by
  set B := ∑ i ∈ S, a i ^ 2 with hB
  have hB0 : 0 ≤ B := Finset.sum_nonneg fun i _ => sq_nonneg _
  have hr : 0 ≤ q / 2 - 1 := by linarith
  have hterm : ∀ i ∈ S, a i ^ q ≤ a i ^ 2 * B ^ (q / 2 - 1) := by
    intro i hi
    have hle : a i ^ 2 ≤ B := Finset.single_le_sum (f := fun i => a i ^ 2)
      (fun i _ => sq_nonneg _) hi
    have e : a i ^ q = a i ^ 2 * (a i ^ 2) ^ (q / 2 - 1) := by
      rw [← Real.rpow_two, ← Real.rpow_mul (ha i), ← Real.rpow_add' (ha i) (by linarith)]
      congr 1; ring
    rw [e]
    exact mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (sq_nonneg _) hle hr) (sq_nonneg _)
  calc ∑ i ∈ S, a i ^ q ≤ ∑ i ∈ S, a i ^ 2 * B ^ (q / 2 - 1) := Finset.sum_le_sum hterm
    _ = B * B ^ (q / 2 - 1) := by rw [Finset.sum_mul]
    _ = B ^ (q / 2) := by
        rcases hB0.eq_or_lt with h | h
        · rw [← h, zero_mul, Real.zero_rpow (by linarith)]
        · rw [← Real.rpow_one_add' hB0 (by linarith)]; congr 1; ring

/-- **The `ℓ^q`-sum of partial Littlewood-Paley pieces** (lines 468-471): for `q ≥ 2`,
`∑_{m∈S} ‖Δ^{(ℓ)}_m f‖_q^q ≤ ‖(∑_{m∈S} |Δ^{(ℓ)}_m f|^2)^{1/2}‖_q^q ≤ A ‖f‖_q^q`, uniformly in the
finite family `S`. -/
theorem sum_lintegral_lpDelta_le (ℓ : Fin 3) {q : ℝ} (hq : 2 ≤ q) :
    ∃ A : ℝ, 0 < A ∧ ∀ (S : Finset ℤ) (f : 𝓢(E3, ℂ)),
      ∑ m ∈ S, ∫⁻ x, ENNReal.ofReal (‖lpDelta ℓ m f x‖ ^ q)
        ≤ ENNReal.ofReal A * ∫⁻ x, ENNReal.ofReal (‖f x‖ ^ q) := by
  obtain ⟨A, hA, hLP⟩ := partial_littlewoodPaley ℓ (q := q) (by linarith)
  refine ⟨A, hA, fun S f => ?_⟩
  rw [← lintegral_finsetSum (f := fun m x => ENNReal.ofReal (‖lpDelta ℓ m f x‖ ^ q)) _
    fun m _ => ENNReal.measurable_ofReal.comp
      ((lpDelta ℓ m f).continuous.norm.measurable.pow_const q)]
  refine le_trans (lintegral_mono fun x => ?_) (hLP S f)
  rw [← ENNReal.ofReal_sum_of_nonneg fun m _ => Real.rpow_nonneg (norm_nonneg _) _]
  exact ENNReal.ofReal_le_ofReal (sum_rpow_le_sum_sq_rpow S (fun m => norm_nonneg _) hq)

/-- `∫ |g|^p = ‖g‖_p^p` for Schwartz `g` and `p > 0`. -/
theorem lintegral_ofReal_norm_rpow_eq (g : 𝓢(E3, ℂ)) {p : ℝ} (hp : 0 < p) :
    ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ p) = eLpNorm g (ENNReal.ofReal p) volume ^ p := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hp) ENNReal.ofReal_ne_top,
    ENNReal.toReal_ofReal hp.le, ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hp.ne',
    ENNReal.rpow_one]
  refine lintegral_congr fun x => ?_
  rw [← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp.le, ofReal_norm]

theorem eLpNorm_schwartz_ne_top (g : 𝓢(E3, ℂ)) (p : ℝ) :
    eLpNorm g (ENNReal.ofReal p) volume ≠ ⊤ := (g.memLp _ _).eLpNorm_ne_top

/-- The `ℓ^{p_n}`-sum in `j` of the pieces `Δ^{(n)}_{(n+1)j+k_n} f`: for `q ≥ 2`,
`∑_{|j| ≤ J} ‖Δ^{(n)}_{(n+1)j+k_n} f‖_q^q ≤ A ‖f‖_q^q` (lines 468-471). -/
theorem sum_toReal_eLpNorm_lpDelta_le (n : Fin 3) {q : ℝ} (hq : 2 ≤ q) :
    ∃ A : ℝ, 0 < A ∧ ∀ (kn : ℤ) (J : ℕ) (f : 𝓢(E3, ℂ)),
      ∑ j ∈ Finset.Icc (-(J : ℤ)) J,
          (eLpNorm (lpDelta n ((expo n : ℤ) * j + kn) f) (ENNReal.ofReal q) volume).toReal ^ q
        ≤ A * (eLpNorm f (ENNReal.ofReal q) volume).toReal ^ q := by
  obtain ⟨A, hA, hS⟩ := sum_lintegral_lpDelta_le n hq
  refine ⟨A, hA, fun kn J f => ?_⟩
  have hq0 : 0 < q := by linarith
  have hinj : Set.InjOn (fun j : ℤ => (expo n : ℤ) * j + kn) (Finset.Icc (-(J : ℤ)) J) := by
    intro a _ b _ h
    have he : (0 : ℤ) < expo n := by exact_mod_cast expo_pos n
    have : (expo n : ℤ) * a = (expo n : ℤ) * b := by simpa using h
    exact mul_left_cancel₀ he.ne' this
  have h := hS ((Finset.Icc (-(J : ℤ)) J).image fun j => (expo n : ℤ) * j + kn) f
  rw [Finset.sum_image hinj] at h
  simp_rw [lintegral_ofReal_norm_rpow_eq _ hq0] at h
  have hfin : ENNReal.ofReal A * eLpNorm f (ENNReal.ofReal q) volume ^ q ≠ ⊤ :=
    ENNReal.mul_ne_top ENNReal.ofReal_ne_top
      (ENNReal.rpow_ne_top_of_nonneg hq0.le (eLpNorm_schwartz_ne_top f q))
  have h2 := ENNReal.toReal_mono hfin h
  rw [ENNReal.toReal_sum fun j _ =>
      ENNReal.rpow_ne_top_of_nonneg hq0.le (eLpNorm_schwartz_ne_top _ q),
    ENNReal.toReal_mul, ENNReal.toReal_ofReal hA.le, ← ENNReal.toReal_rpow] at h2
  simpa only [← ENNReal.toReal_rpow] using h2

/-- **`lem:gain` at `p = 1`** (`eq:gain`, lines 440-447, with the proof of lines 459-472): for
`p_1, p_2, p_3 ≥ 2` with `∑ 1/p_n = 1` there are `δ > 0`, `C` with
`‖T^{(k)}_J(f)‖_1 ≤ C 2^{-δ k^{(1)}} ∏ ‖f_n‖_{p_n}` for all `k ∈ F_H`, uniformly in the truncation
`J`.  (On `F_H`, `2^{-δ k^{(1)}}` is comparable to the source's `2^{-δ|k|}`.) -/
theorem gain_one {pv : Fin 3 → ℝ} (hpv : ∀ n, 2 ≤ pv n) (hsum : ∑ n, (pv n)⁻¹ = 1) :
    ∃ δ C : ℝ, 0 < δ ∧ 0 < C ∧ ∀ k : Fin 3 → ℤ, 0 < kMax k → ∀ (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)),
      eLpNorm (kComp k J f) 1 volume
        ≤ ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ * kMax k))) *
          ∏ n, eLpNorm (f n) (ENNReal.ofReal (pv n)) volume := by
  obtain ⟨δ, C, hδ, hC, hss⟩ := single_scale_gain (p := 1) (pv := pv) le_rfl
    (fun i => by linarith [hpv i]) (by simpa using hsum)
  choose A hA hLq using fun n : Fin 3 => sum_toReal_eLpNorm_lpDelta_le n (hpv n)
  have hpv0 : ∀ n, 0 < pv n := fun n => by linarith [hpv n]
  set Cf : ℝ := C * 2 ^ δ * ∏ n, A n ^ (pv n)⁻¹ with hCf
  have hCf0 : 0 < Cf := by
    have : 0 < ∏ n, A n ^ (pv n)⁻¹ := Finset.prod_pos fun n _ => Real.rpow_pos_of_pos (hA n) _
    positivity
  refine ⟨δ, Cf, hδ.1, hCf0, fun k hk J f => ?_⟩
  -- the coordinate carrying the largest frequency
  obtain ⟨n0, hn0⟩ : ∃ n0 : Fin 3, k n0 = kMax k := by
    have : kMax k = k 0 ∨ kMax k = k 1 ∨ kMax k = k 2 := by simp only [kMax]; omega
    rcases this with h | h | h
    exacts [⟨0, h.symm⟩, ⟨1, h.symm⟩, ⟨2, h.symm⟩]
  have hk1 : 1 ≤ kMax k := hk
  set lam : ℝ := (2 : ℝ) ^ (kMax k - 1) with hlamdef
  have hlam : 1 ≤ lam := one_le_zpow₀ (by norm_num) (by omega)
  have hlamδ : lam ^ (-δ) = 2 ^ δ * (2 : ℝ) ^ (-(δ * kMax k)) := by
    rw [hlamdef, ← Real.rpow_intCast, ← Real.rpow_mul (by norm_num), ← Real.rpow_add two_pos]
    congr 1; push_cast; ring
  set a : Fin 3 → ℤ → ℝ := fun n j =>
    (eLpNorm (lpDelta n ((expo n : ℤ) * j + k n) (f n)) (ENNReal.ofReal (pv n)) volume).toReal
    with ha
  have ha0 : ∀ n j, 0 ≤ a n j := fun n j => ENNReal.toReal_nonneg
  set N : Fin 3 → ℝ := fun n => (eLpNorm (f n) (ENNReal.ofReal (pv n)) volume).toReal with hN
  -- the single-scale gain for each `j`
  have hpiece : ∀ j : ℤ, eLpNorm (freqPiece j k f) 1 volume
      ≤ ENNReal.ofReal (C * lam ^ (-δ)) * ∏ n, ENNReal.ofReal (a n j) := by
    intro j
    have hsupp : ∀ ξ, 𝓕 (lpDelta n0 ((expo n0 : ℤ) * j + k n0) (f n0) : E3 → ℂ) ξ ≠ 0 →
        lam * (2 : ℝ) ^ ((expo n0 : ℤ) * j) ≤ |ξ n0| := by
      intro ξ hξ
      have h := fourier_lpDelta_support n0 _ _ ξ hξ
      rw [hlamdef, ← zpow_add₀ two_ne_zero]
      convert h using 2; rw [hn0]; ring
    have h := hss j (fun n => lpDelta n ((expo n : ℤ) * j + k n) (f n)) n0 lam hlam hsupp
    rw [ENNReal.ofReal_one] at h
    refine h.trans_eq ?_
    congr 1
    refine Finset.prod_congr rfl fun n _ => ?_
    rw [ha, ENNReal.ofReal_toReal (eLpNorm_schwartz_ne_top _ _)]
  -- Hölder in `j`
  have hhol : ∑ j ∈ Finset.Icc (-(J : ℤ)) J, ∏ n, a n j
      ≤ ∏ n, (∑ j ∈ Finset.Icc (-(J : ℤ)) J, a n j ^ pv n) ^ (1 / pv n) := by
    simp only [Fin.prod_univ_three]
    refine sum_mul3_le_holder _ (ha0 0) (ha0 1) (ha0 2) (hpv0 0) (hpv0 1) (hpv0 2) ?_
    simpa [Fin.sum_univ_three, one_div] using hsum
  -- the square function in each coordinate
  have hsq : ∀ n, (∑ j ∈ Finset.Icc (-(J : ℤ)) J, a n j ^ pv n) ^ (1 / pv n)
      ≤ A n ^ (pv n)⁻¹ * N n := by
    intro n
    have h := hLq n (k n) J (f n)
    have hN0 : 0 ≤ N n := ENNReal.toReal_nonneg
    calc (∑ j ∈ Finset.Icc (-(J : ℤ)) J, a n j ^ pv n) ^ (1 / pv n)
        ≤ (A n * N n ^ pv n) ^ (1 / pv n) :=
          Real.rpow_le_rpow (Finset.sum_nonneg fun j _ => Real.rpow_nonneg (ha0 n j) _) h
            (by have := hpv0 n; positivity)
      _ = A n ^ (pv n)⁻¹ * N n := by
          rw [Real.mul_rpow (hA n).le (Real.rpow_nonneg hN0 _), ← Real.rpow_mul hN0,
            mul_one_div_cancel (hpv0 n).ne', Real.rpow_one, one_div]
  have hkC : kComp k J f = ∑ j ∈ Finset.Icc (-(J : ℤ)) J, freqPiece j k f := by
    funext x; simp [kComp, Finset.sum_apply]
  have hmeas : ∀ j ∈ Finset.Icc (-(J : ℤ)) J,
      AEStronglyMeasurable (freqPiece j k f) volume := fun j _ =>
    (continuous_simplexTj j fun n => lpDelta n ((expo n : ℤ) * j + k n) (f n)).aestronglyMeasurable
  have hprod0 : ∀ j, 0 ≤ ∏ n, a n j := fun j => Finset.prod_nonneg fun n _ => ha0 n j
  have hCl : 0 ≤ C * lam ^ (-δ) := by positivity
  calc eLpNorm (kComp k J f) 1 volume
      ≤ ∑ j ∈ Finset.Icc (-(J : ℤ)) J, eLpNorm (freqPiece j k f) 1 volume := by
        rw [hkC]; exact eLpNorm_sum_le hmeas le_rfl
    _ ≤ ∑ j ∈ Finset.Icc (-(J : ℤ)) J,
          ENNReal.ofReal (C * lam ^ (-δ)) * ∏ n, ENNReal.ofReal (a n j) :=
        Finset.sum_le_sum fun j _ => hpiece j
    _ = ENNReal.ofReal (C * lam ^ (-δ) * ∑ j ∈ Finset.Icc (-(J : ℤ)) J, ∏ n, a n j) := by
        rw [ENNReal.ofReal_mul hCl, ENNReal.ofReal_sum_of_nonneg fun j _ => hprod0 j,
          Finset.mul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [ENNReal.ofReal_prod_of_nonneg fun n _ => ha0 n j]
    _ ≤ ENNReal.ofReal (C * lam ^ (-δ) * ∏ n, (A n ^ (pv n)⁻¹ * N n)) := by
        refine ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left (hhol.trans ?_) hCl)
        exact Finset.prod_le_prod (fun n _ => Real.rpow_nonneg (Finset.sum_nonneg fun j _ =>
          Real.rpow_nonneg (ha0 n j) _) _) fun n _ => hsq n
    _ = ENNReal.ofReal (Cf * (2 : ℝ) ^ (-(δ * kMax k))) * ∏ n, ENNReal.ofReal (N n) := by
        rw [← ENNReal.ofReal_prod_of_nonneg fun n _ => ENNReal.toReal_nonneg,
          ← ENNReal.ofReal_mul (by positivity), hlamδ, Finset.prod_mul_distrib, hCf]
        congr 1; ring
    _ = _ := by
        congr 1
        refine Finset.prod_congr rfl fun n _ => ?_
        rw [hN, ENNReal.ofReal_toReal (eLpNorm_schwartz_ne_top _ _)]

/-! ### High frequencies: the small-loss bound (alternative route to line 456)

See `automation/ErrorReport-task4.md`, entry `lem:loss`. -/

/-- The weight `w_j(t) = |ψ(2^j t)/t|` of `T_j`. -/
def wJ (j : ℤ) (t : ℝ) : ℝ≥0∞ := ‖(lpPsi ((2 : ℝ) ^ j * t) : ℂ) / t‖ₑ

theorem measurable_wJ (j : ℤ) : Measurable (wJ j) := by
  unfold wJ
  exact ((Complex.continuous_ofReal.comp (continuous_lpPsi.comp
    (continuous_const.mul continuous_id))).measurable.div Complex.measurable_ofReal).enorm

/-- `w_j(t) ≠ 0` forces `|t| < 2 · 2^{-j}`. -/
theorem abs_lt_of_wJ_ne_zero {j : ℤ} {t : ℝ} (h : wJ j t ≠ 0) : |t| < 2 * (2 : ℝ) ^ (-j) := by
  have h1 : lpPsi ((2 : ℝ) ^ j * t) ≠ 0 := by
    intro h0; apply h; simp [wJ, h0]
  have h2 := (lpPsi_support h1).2
  have hp : (0 : ℝ) < 2 ^ j := zpow_pos two_pos _
  rw [abs_mul, abs_of_pos hp] at h2
  have e : (2 : ℝ) ^ (-j) = (2 ^ j)⁻¹ := zpow_neg _ _
  rw [e, ← div_eq_mul_inv, lt_div_iff₀ hp]; linarith

/-- **Cauchy-Schwarz in `t`** (Hölder `(∞, 2, 2)`): if `|g_0(x + t e_0)| ≤ a` for
`|t| ≤ 2 · 2^{-j}`, then `|T_j(g)(x)| ≤ a (∫ w_j |g_1(x+t^2 e_1)|^2)^{1/2} (∫ w_j |g_2(x+t^3 e_2)|^2)^{1/2}`. -/
theorem enorm_simplexTj_le (j : ℤ) (g : Fin 3 → E3 → ℂ) (hg : ∀ n, Continuous (g n)) (x : E3)
    (a : ℝ≥0∞) (ha : ∀ t : ℝ, |t| < 2 * (2 : ℝ) ^ (-j) → ‖g 0 (x + curve 0 t)‖ₑ ≤ a) :
    ‖simplexTj j g x‖ₑ ≤ a *
      ((∫⁻ t, wJ j t * ‖g 1 (x + curve 1 t)‖ₑ ^ (2 : ℝ)) ^ (1 / 2 : ℝ) *
        (∫⁻ t, wJ j t * ‖g 2 (x + curve 2 t)‖ₑ ^ (2 : ℝ)) ^ (1 / 2 : ℝ)) := by
  have hcont : ∀ n, Continuous fun t : ℝ => g n (x + curve n t) := fun n =>
    (hg n).comp (continuous_const.add ((continuous_pow _).smul continuous_const))
  set u : Fin 3 → ℝ → ℝ≥0∞ := fun n t => ‖g n (x + curve n t)‖ₑ with hu
  have hum : ∀ n, Measurable (u n) := fun n => (hcont n).measurable.enorm
  -- pointwise domination
  have hpt : ∀ t, ‖(lpPsi ((2 : ℝ) ^ j * t) : ℂ) * prodShift g x t / t‖ₑ
      ≤ a * ((wJ j t ^ (1 / 2 : ℝ) * u 1 t) * (wJ j t ^ (1 / 2 : ℝ) * u 2 t)) := by
    intro t
    have e : ‖(lpPsi ((2 : ℝ) ^ j * t) : ℂ) * prodShift g x t / t‖ₑ
        = wJ j t * (u 0 t * (u 1 t * u 2 t)) := by
      rw [mul_div_right_comm, enorm_mul, prodShift, Fin.prod_univ_three, enorm_mul, enorm_mul, mul_assoc]; rfl
    have e2 : (wJ j t ^ (1 / 2 : ℝ) * u 1 t) * (wJ j t ^ (1 / 2 : ℝ) * u 2 t)
        = wJ j t * (u 1 t * u 2 t) := by
      rw [mul_mul_mul_comm, ← ENNReal.rpow_add_of_nonneg _ _ (by norm_num) (by norm_num)]
      norm_num
    rw [e, e2]
    by_cases hw : wJ j t = 0
    · simp [hw]
    · have := ha t (abs_lt_of_wJ_ne_zero hw)
      calc wJ j t * (u 0 t * (u 1 t * u 2 t)) = u 0 t * (wJ j t * (u 1 t * u 2 t)) := by ring
        _ ≤ a * (wJ j t * (u 1 t * u 2 t)) := by gcongr
  unfold simplexTj
  refine (enorm_integral_le_lintegral_enorm _).trans ?_
  refine (lintegral_mono hpt).trans ?_
  have hf : Measurable fun t => wJ j t ^ (1 / 2 : ℝ) * u 1 t :=
    ((measurable_wJ j).pow_const _).mul (hum 1)
  have hg2 : Measurable fun t => wJ j t ^ (1 / 2 : ℝ) * u 2 t :=
    ((measurable_wJ j).pow_const _).mul (hum 2)
  rw [lintegral_const_mul a (f := fun t => (wJ j t ^ (1 / 2 : ℝ) * u 1 t) *
    (wJ j t ^ (1 / 2 : ℝ) * u 2 t)) (hf.mul hg2)]
  gcongr
  have h := ENNReal.lintegral_mul_le_Lp_mul_Lq volume Real.HolderConjugate.two_two
    hf.aemeasurable hg2.aemeasurable
  have e : ∀ n t, (wJ j t ^ (1 / 2 : ℝ) * u n t) ^ (2 : ℝ) = wJ j t * u n t ^ (2 : ℝ) := by
    intro n t
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul]; norm_num
  simp only [e] at h
  exact h

/-- `ψ̃_c` as a coordinate multiplier. -/
def psiTildeCM (c : ℤ) : CoordMult :=
  ⟨lpPsiTildeJ c, contDiff_lpPsiTildeJ c, hasCompactSupport_lpPsiTildeJ c, fun ζ => by
    simp only [lpPsiTildeJ, mul_neg, lpPsiTilde_neg]⟩

theorem psiTildeCM_op (c : ℤ) (ℓ : Fin 3) : (psiTildeCM c).op ℓ = lpDeltaTilde ℓ c := rfl

/-- Dyadic scaling of the line kernel: `ψ̃̌_c(u) = 2^c ψ̃̌_0(2^c u)`. -/
theorem psiTildeCM_check_eq (c : ℤ) (u : ℝ) :
    (psiTildeCM c).check u = (((2 : ℝ) ^ c : ℝ) : ℂ) * (psiTildeCM 0).check ((2 : ℝ) ^ c * u) := by
  rw [CoordMult.check_eq, CoordMult.check_eq]
  have hp : (0 : ℝ) < 2 ^ c := zpow_pos two_pos _
  have h := Measure.integral_comp_mul_left (fun η : ℝ =>
    (Real.fourierChar (η * ((2 : ℝ) ^ c * u)) : ℂ) * (((psiTildeCM 0).h η : ℝ) : ℂ))
    ((2 : ℝ) ^ (-c))
  have e1 : (fun ζ : ℝ => (Real.fourierChar (ζ * u) : ℂ) * (((psiTildeCM c).h ζ : ℝ) : ℂ))
      = fun ζ => (Real.fourierChar ((2 : ℝ) ^ (-c) * ζ * ((2 : ℝ) ^ c * u)) : ℂ) *
          (((psiTildeCM 0).h ((2 : ℝ) ^ (-c) * ζ) : ℝ) : ℂ) := by
    funext ζ
    have e : (2 : ℝ) ^ (-c) * ζ * ((2 : ℝ) ^ c * u) = ζ * u := by
      rw [zpow_neg]; field_simp
    rw [e]
    simp only [psiTildeCM, lpPsiTildeJ, neg_zero, zpow_zero, one_mul]
  rw [e1, h, zpow_neg, inv_inv, abs_of_pos hp, Complex.real_smul]

/-- `|ψ̃̌_0(u)| ≤ K (1 + |u|)^{-10}`. -/
theorem exists_psiTildeCM_check_decay :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ u : ℝ, ‖(psiTildeCM 0).check u‖ ≤ K * Twisted.bracketKernel u := by
  set f := (psiTildeCM 0).check
  set K : ℝ := 2 ^ 10 * (Finset.Iic ((10 : ℕ), (0 : ℕ))).sup
    (fun m => SchwartzMap.seminorm ℝ m.1 m.2) f
  have hK : 0 ≤ K := by positivity
  refine ⟨K, hK, fun u => ?_⟩
  have h := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := ((10 : ℕ), (0 : ℕ)))
    (k := 10) (n := 0) le_rfl le_rfl f u
  rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at h
  have hpos : 0 < (1 + |u|) ^ 10 := by positivity
  unfold Twisted.bracketKernel
  rw [Real.rpow_neg (by positivity), show ((10 : ℝ)) = ((10 : ℕ) : ℝ) by norm_num,
    Real.rpow_natCast, ← div_eq_mul_inv, le_div_iff₀ hpos, mul_comm]
  exact h

/-- The scaled bracket: `|ψ̃̌_c(u)| ≤ K b_{2^{-c}}(u)`, `b_s(u) = s^{-1}(1 + |u|/s)^{-10}`. -/
theorem norm_psiTildeCM_check_le {K : ℝ} (hK : ∀ u : ℝ, ‖(psiTildeCM 0).check u‖ ≤ K * Twisted.bracketKernel u)
    (c : ℤ) (u : ℝ) :
    ‖(psiTildeCM c).check u‖ ≤ K * Twisted.bracketKernelAt ((2 : ℝ) ^ (-c)) 0 u := by
  have hp : (0 : ℝ) < 2 ^ c := zpow_pos two_pos _
  rw [psiTildeCM_check_eq, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hp]
  simp only [Twisted.bracketKernelAt, Twisted.kernelAt, Twisted.kernelDilate, sub_zero,
    smul_eq_mul, zpow_neg, inv_inv, div_inv_eq_mul]
  calc (2 : ℝ) ^ c * ‖(psiTildeCM 0).check ((2 : ℝ) ^ c * u)‖
      ≤ 2 ^ c * (K * Twisted.bracketKernel ((2 : ℝ) ^ c * u)) :=
        mul_le_mul_of_nonneg_left (hK _) hp.le
    _ = K * (2 ^ c * Twisted.bracketKernel (u * 2 ^ c)) := by rw [mul_comm u]; ring

/-- Peetre's shift inequality for the bracket: `b_s(v + t) ≤ (1 + |t|/s)^{10} b_s(v)`. -/
theorem bracketKernelAt_add_le {s : ℝ} (hs : 0 < s) (v t : ℝ) :
    Twisted.bracketKernelAt s 0 (v + t) ≤ (1 + |t| / s) ^ (10 : ℝ) * Twisted.bracketKernelAt s 0 v := by
  simp only [Twisted.bracketKernelAt, Twisted.kernelAt, Twisted.kernelDilate, sub_zero,
    smul_eq_mul, Twisted.bracketKernel]
  have h1 : 0 < 1 + |v / s| := by positivity
  have h2 : 0 < 1 + |(v + t) / s| := by positivity
  have h3 : 0 < 1 + |t| / s := by positivity
  have htri : 1 + |v / s| ≤ (1 + |(v + t) / s|) * (1 + |t| / s) := by
    have : |v / s| ≤ |(v + t) / s| + |t| / s := by
      have h' : |v / s| ≤ |(v + t) / s| + |t / s| := by
        rw [show v / s = (v + t) / s - t / s by ring]; exact abs_sub _ _
      rwa [abs_div t s, abs_of_pos hs] at h'
    nlinarith [abs_nonneg ((v + t) / s), div_nonneg (abs_nonneg t) hs.le]
  rw [mul_left_comm]
  refine mul_le_mul_of_nonneg_left ?_ (inv_nonneg.mpr hs.le)
  rw [Real.rpow_neg h2.le, Real.rpow_neg h1.le, ← div_eq_mul_inv, le_div_iff₀
    (Real.rpow_pos_of_pos h1 _)]
  rw [mul_comm, ← div_eq_mul_inv, div_le_iff₀ (Real.rpow_pos_of_pos h2 _), ← Real.mul_rpow h3.le h2.le]
  exact Real.rpow_le_rpow h1.le (by linarith [htri, mul_comm (1 + |(v + t) / s|) (1 + |t| / s)])
    (by norm_num)

/-- A line average against the bracket `b_s` is dominated by the coordinate maximal function. -/
theorem integral_bracket_le_maximal (i : Fin 3) {F : E3 → ℂ} (hF : Measurable F) {B : ℝ}
    (hB : ∀ y, ‖F y‖ ≤ B) {s : ℝ} (hs : 0 < s) (x : E3) :
    (∫ r : ℝ, ‖F (x - r • basisVec i)‖ * Twisted.bracketKernelAt s 0 r)
      ≤ Twisted.dyadicBracketShellConstant * Twisted.coordinateDyadicBallMaximal i F x := by
  have hB0 : 0 ≤ B := (norm_nonneg _).trans (hB x)
  rw [← coordinateDirection_eq_basisVec, Twisted.displacementBracket_eq_coordinateBracketConvolution]
  exact Twisted.coordinateBracketConvolution_le_shell_dyadic i F hF B hB0 hB s x hs

/-- **The `∞` slot** (alternative route, line 456): from `Δ_m = Δ̃_m Δ_m`, Hölder, the decay of
`ψ̃̌` and Peetre's shift inequality, for `s > 1`, `|t| ≤ R 2^{-m}`:
`|Δ^{(ℓ)}_m g(x + t e_ℓ)| ≤ C (1 + R)^{10/s} (M^{(ℓ)} |Δ^{(ℓ)}_m g|^s (x))^{1/s}`. -/
theorem enorm_lpDelta_shift_le (ℓ : Fin 3) {s : ℝ} (hs : 1 < s) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (m : ℤ) (g : 𝓢(E3, ℂ)) (x : E3) (t R : ℝ), 0 ≤ R →
      |t| ≤ R * (2 : ℝ) ^ (-m) →
      ‖lpDelta ℓ m g (x + t • basisVec ℓ)‖ₑ ≤ ENNReal.ofReal (C * (1 + R) ^ (10 / s)) *
        ENNReal.ofReal (Twisted.coordinateDyadicBallMaximal ℓ
          (fun y => ((‖lpDelta ℓ m g y‖ ^ s : ℝ) : ℂ)) x) ^ (1 / s) := by
  obtain ⟨K, hK0, hK⟩ := exists_psiTildeCM_check_decay
  set D := Twisted.dyadicBracketShellConstant with hD
  have hD0 : 0 ≤ D := Twisted.dyadicBracketShellConstant_nonneg
  have hs0 : 0 < s := by linarith
  set s' := s.conjExponent with hs'
  have hhol : s'.HolderConjugate s := (Real.HolderConjugate.conjExponent hs).symm
  have hs'0 : 0 < s' := hhol.pos
  set C : ℝ := (K * (2 / 9)) ^ (1 / s') * (K * D) ^ (1 / s) with hC
  refine ⟨C, by positivity, fun m g x t R hR ht => ?_⟩
  set G := lpDelta ℓ m g with hG
  set χ := psiTildeCM m with hχ
  set y := x + t • basisVec ℓ with hy
  set r : ℝ := (2 : ℝ) ^ (-m) with hr
  have hr0 : 0 < r := zpow_pos two_pos _
  set b : ℝ → ℝ := fun v => Twisted.bracketKernelAt r 0 v with hb
  have hb0 : ∀ v, 0 ≤ b v := fun v => Twisted.bracketKernelAt_nonneg hr0.le
  have hbint : Integrable b := Twisted.integrable_bracketKernelAt hr0 0
  have hcheck : ∀ u, ‖χ.check u‖ ≤ K * b u := norm_psiTildeCM_check_le hK m
  obtain ⟨B, hB0, hBG⟩ := exists_bound_schwartz G
  set F : E3 → ℂ := fun z => ((‖G z‖ ^ s : ℝ) : ℂ) with hF
  have hFm : Measurable F :=
    Complex.continuous_ofReal.measurable.comp (G.continuous.norm.measurable.pow_const s)
  have hFB : ∀ z, ‖F z‖ ≤ B ^ s := fun z => by
    rw [hF, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)]
    exact Real.rpow_le_rpow (norm_nonneg _) (hBG z) hs0.le
  have hline : ∀ v : ℝ, Continuous fun u : ℝ => G (v • basisVec ℓ + -(u • basisVec ℓ)) := fun v =>
    G.continuous.comp (continuous_const.add (continuous_id.smul continuous_const).neg)
  -- the reproducing formula
  have hrep : G y = ∫ u : ℝ, χ.check u * G (y - u • basisVec ℓ) := by
    have h := CoordMult.op_eq_lineConv χ ℓ G y
    rwa [hχ, psiTildeCM_op, hG, lpDeltaTilde_lpDelta] at h
  have hmeasG : ∀ z : E3, Measurable fun u : ℝ => ‖G (z - u • basisVec ℓ)‖ₑ := fun z =>
    (G.continuous.comp (continuous_const.sub (continuous_id.smul continuous_const))).measurable.enorm
  have hmeasc : Measurable fun u : ℝ => ‖χ.check u‖ₑ := χ.check.continuous.measurable.enorm
  -- Hölder with the measure `|ψ̃̌_m(u)| du`
  have h1 : ‖G y‖ₑ ≤ (∫⁻ u, ‖χ.check u‖ₑ) ^ (1 / s') *
      (∫⁻ u, ‖χ.check u‖ₑ * ‖G (y - u • basisVec ℓ)‖ₑ ^ s) ^ (1 / s) := by
    rw [hrep]
    refine (enorm_integral_le_lintegral_enorm _).trans ?_
    have hH := ENNReal.lintegral_mul_le_Lp_mul_Lq volume hhol
      ((hmeasc.pow_const (1 / s')).aemeasurable)
      (((hmeasc.pow_const (1 / s)).mul (hmeasG y)).aemeasurable)
    have e1 : ∀ u, ‖χ.check u * G (y - u • basisVec ℓ)‖ₑ
        = (fun u => ‖χ.check u‖ₑ ^ (1 / s')) u *
          (fun u => ‖χ.check u‖ₑ ^ (1 / s) * ‖G (y - u • basisVec ℓ)‖ₑ) u := by
      intro u
      simp only
      have hsum : 1 / s' + 1 / s = 1 := by rw [one_div, one_div]; exact hhol.inv_add_inv_eq_one
      rw [enorm_mul, ← mul_assoc, ← ENNReal.rpow_add_of_nonneg _ _ (by positivity) (by positivity),
        hsum, ENNReal.rpow_one]
    simp_rw [e1]
    refine hH.trans_eq ?_
    congr 2
    · refine lintegral_congr fun u => ?_
      rw [← ENNReal.rpow_mul, one_div_mul_cancel hs'0.ne', ENNReal.rpow_one]
    · refine lintegral_congr fun u => ?_
      simp only [Pi.mul_apply]
      rw [ENNReal.mul_rpow_of_nonneg _ _ hs0.le, ← ENNReal.rpow_mul, one_div_mul_cancel hs0.ne',
        ENNReal.rpow_one]
  -- the mass of `|ψ̃̌_m|`
  have h2 : ∫⁻ u, ‖χ.check u‖ₑ ≤ ENNReal.ofReal (K * (2 / 9)) := by
    calc ∫⁻ u, ‖χ.check u‖ₑ ≤ ∫⁻ u, ENNReal.ofReal (K * b u) :=
          lintegral_mono fun u => by rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal (hcheck u)
      _ = ENNReal.ofReal (∫ u, K * b u) := by
          rw [ofReal_integral_eq_lintegral_ofReal (hbint.const_mul K)
            (Eventually.of_forall fun u => mul_nonneg hK0 (hb0 u))]
      _ = ENNReal.ofReal (K * (2 / 9)) := by
          rw [integral_const_mul, hb, Twisted.integral_bracketKernelAt hr0]
  -- the shifted average
  have h3 : ∫⁻ u, ‖χ.check u‖ₑ * ‖G (y - u • basisVec ℓ)‖ₑ ^ s
      ≤ ENNReal.ofReal (K * (1 + R) ^ (10 : ℝ)) *
        ENNReal.ofReal (D * Twisted.coordinateDyadicBallMaximal ℓ F x) := by
    have hshift : (∫⁻ u, ‖χ.check u‖ₑ * ‖G (y - u • basisVec ℓ)‖ₑ ^ s)
        = ∫⁻ v, ‖χ.check (v + t)‖ₑ * ‖G (x - v • basisVec ℓ)‖ₑ ^ s := by
      rw [← lintegral_add_right_eq_self (μ := volume)
        (fun u => ‖χ.check u‖ₑ * ‖G (y - u • basisVec ℓ)‖ₑ ^ s) t]
      refine lintegral_congr fun v => ?_
      simp only [hy, add_smul]
      congr 3; abel
    have hpeetre : ∀ v, ‖χ.check (v + t)‖ₑ ≤ ENNReal.ofReal (K * (1 + R) ^ (10 : ℝ)) *
        ENNReal.ofReal (b v) := by
      intro v
      rw [← ENNReal.ofReal_mul (by positivity), ← ofReal_norm]
      refine ENNReal.ofReal_le_ofReal ((hcheck _).trans ?_)
      rw [mul_assoc]
      refine mul_le_mul_of_nonneg_left ((bracketKernelAt_add_le hr0 v t).trans ?_) hK0
      refine mul_le_mul_of_nonneg_right (Real.rpow_le_rpow (by positivity) ?_ (by norm_num)) (hb0 v)
      have : |t| / r ≤ R := by rw [div_le_iff₀ hr0]; exact ht
      linarith
    have hint : Integrable fun v : ℝ => ‖F (x - v • basisVec ℓ)‖ * b v := by
      refine (hbint.const_mul (B ^ s)).mono' ?_ (Eventually.of_forall fun v => ?_)
      · exact ((hFm.comp (measurable_const.sub (measurable_id.smul_const _))).norm.aestronglyMeasurable).mul
          hbint.aestronglyMeasurable
      · rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (norm_nonneg _) (hb0 v))]
        exact mul_le_mul_of_nonneg_right (hFB _) (hb0 v)
    rw [hshift]
    calc ∫⁻ v, ‖χ.check (v + t)‖ₑ * ‖G (x - v • basisVec ℓ)‖ₑ ^ s
        ≤ ∫⁻ v, ENNReal.ofReal (K * (1 + R) ^ (10 : ℝ)) *
            ENNReal.ofReal (‖F (x - v • basisVec ℓ)‖ * b v) := by
          refine lintegral_mono fun v => ?_
          rw [ENNReal.ofReal_mul (norm_nonneg _), mul_comm (ENNReal.ofReal ‖F _‖), ← mul_assoc]
          refine mul_le_mul' (hpeetre v) (le_of_eq ?_)
          rw [hF, Complex.norm_real, Real.norm_eq_abs,
            abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _),
            ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hs0.le, ofReal_norm]
      _ = ENNReal.ofReal (K * (1 + R) ^ (10 : ℝ)) *
            ENNReal.ofReal (∫ v, ‖F (x - v • basisVec ℓ)‖ * b v) := by
          rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
            ofReal_integral_eq_lintegral_ofReal hint
              (Eventually.of_forall fun v => mul_nonneg (norm_nonneg _) (hb0 v))]
      _ ≤ _ := by
          gcongr
          exact integral_bracket_le_maximal ℓ hFm hFB hr0 x
  -- assemble
  have hM0 : 0 ≤ Twisted.coordinateDyadicBallMaximal ℓ F x := ENNReal.toReal_nonneg
  calc ‖G y‖ₑ ≤ ENNReal.ofReal (K * (2 / 9)) ^ (1 / s') *
        (ENNReal.ofReal (K * (1 + R) ^ (10 : ℝ)) *
          ENNReal.ofReal (D * Twisted.coordinateDyadicBallMaximal ℓ F x)) ^ (1 / s) := by
        refine h1.trans ?_
        gcongr
    _ = ENNReal.ofReal (C * (1 + R) ^ (10 / s)) *
        ENNReal.ofReal (Twisted.coordinateDyadicBallMaximal ℓ F x) ^ (1 / s) := by
        have hR1 : 0 ≤ 1 + R := by linarith
        have eL : ENNReal.ofReal (K * (2 / 9)) ^ (1 / s') *
            (ENNReal.ofReal (K * (1 + R) ^ (10 : ℝ)) *
              ENNReal.ofReal (D * Twisted.coordinateDyadicBallMaximal ℓ F x)) ^ (1 / s)
            = ENNReal.ofReal ((K * (2 / 9)) ^ (1 / s') *
              (K * (1 + R) ^ (10 : ℝ) * (D * Twisted.coordinateDyadicBallMaximal ℓ F x)) ^ (1 / s)) := by
          rw [← ENNReal.ofReal_mul (by positivity),
            ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity),
            ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity),
            ← ENNReal.ofReal_mul (by positivity)]
        have eR : ENNReal.ofReal (C * (1 + R) ^ (10 / s)) *
            ENNReal.ofReal (Twisted.coordinateDyadicBallMaximal ℓ F x) ^ (1 / s)
            = ENNReal.ofReal (C * (1 + R) ^ (10 / s) *
              Twisted.coordinateDyadicBallMaximal ℓ F x ^ (1 / s)) := by
          rw [ENNReal.ofReal_rpow_of_nonneg hM0 (by positivity), ← ENNReal.ofReal_mul (by positivity)]
        rw [eL, eR]
        congr 1
        have h10 : ((1 + R) ^ (10 : ℝ)) ^ (1 / s) = (1 + R) ^ (10 / s) := by
          rw [← Real.rpow_mul hR1]; ring_nf
        rw [hC, Real.mul_rpow (by positivity) (by positivity),
          Real.mul_rpow (by positivity) (by positivity),
          Real.mul_rpow (by positivity) hM0, Real.mul_rpow hK0 hD0,
          Real.mul_rpow hK0 (Real.rpow_nonneg hR1 _), h10]
        ring

/-- `w_j(t) ≤ (2/r) 1_{r/2 ≤ |t| ≤ 2r}`, `r = 2^{-j}`. -/
theorem wJ_le_indicator (j : ℤ) (t : ℝ) :
    wJ j t ≤ ENNReal.ofReal (2 / (2 : ℝ) ^ (-j)) *
      Set.indicator (Set.Icc ((2 : ℝ) ^ (-j) / 2) (2 * (2 : ℝ) ^ (-j))) 1 |t| := by
  set r : ℝ := (2 : ℝ) ^ (-j) with hr
  have hr0 : 0 < r := zpow_pos two_pos _
  by_cases hw : wJ j t = 0
  · rw [hw]; exact bot_le
  have h1 : lpPsi ((2 : ℝ) ^ j * t) ≠ 0 := by intro h0; apply hw; simp [wJ, h0]
  obtain ⟨hlo, hhi⟩ := lpPsi_support h1
  have hp : (0 : ℝ) < 2 ^ j := zpow_pos two_pos _
  have e : (2 : ℝ) ^ j = r⁻¹ := by rw [hr, zpow_neg, inv_inv]
  rw [abs_mul, abs_of_pos hp, e] at hlo hhi
  have ht1 : r / 2 ≤ |t| := by
    rw [div_le_iff₀ two_pos]; rw [← div_eq_inv_mul, le_div_iff₀ hr0] at hlo; linarith
  have ht2 : |t| ≤ 2 * r := by
    rw [← div_eq_inv_mul, div_lt_iff₀ hr0] at hhi; linarith
  have ht0 : 0 < |t| := lt_of_lt_of_le (by positivity) ht1
  rw [Set.indicator_of_mem (Set.mem_Icc.mpr ⟨ht1, ht2⟩), Pi.one_apply, mul_one, wJ,
    ← ofReal_norm, norm_div, Complex.norm_real, Complex.norm_real,
    Real.norm_eq_abs, Real.norm_eq_abs]
  refine ENNReal.ofReal_le_ofReal ?_
  rw [div_le_div_iff₀ ht0 hr0]
  have := lpPsi_abs_le_one ((2 : ℝ) ^ j * t)
  nlinarith [abs_nonneg (lpPsi ((2 : ℝ) ^ j * t))]

/-- The substitution `σ = t^e` on `[r/2, 2r]`. -/
theorem setLIntegral_comp_pow_le {e : ℕ} (he : 1 ≤ e) {r : ℝ} (hr : 0 < r) {φ : ℝ → ℝ≥0∞} :
    ∫⁻ t in Set.Icc (r / 2) (2 * r), φ (t ^ e)
      ≤ ENNReal.ofReal ((2 / r) ^ (e - 1) / e) * ∫⁻ σ in Set.Icc 0 ((2 * r) ^ e), φ σ := by
  set S := Set.Icc (r / 2) (2 * r) with hS
  have hSpos : ∀ t ∈ S, 0 < t := fun t ht => lt_of_lt_of_le (by positivity) ht.1
  have hderiv : ∀ t ∈ S, HasDerivWithinAt (fun t : ℝ => t ^ e) ((e : ℝ) * t ^ (e - 1)) S t :=
    fun t _ => (hasDerivAt_pow e t).hasDerivWithinAt
  have hinj : Set.InjOn (fun t : ℝ => t ^ e) S :=
    ((pow_left_strictMonoOn₀ (by omega : e ≠ 0)).injOn).mono fun t ht => le_of_lt (hSpos t ht)
  have hcv := lintegral_image_eq_lintegral_abs_deriv_mul measurableSet_Icc hderiv hinj φ
  have hc0 : 0 ≤ (2 / r) ^ (e - 1) / e := by positivity
  calc ∫⁻ t in S, φ (t ^ e)
      ≤ ∫⁻ t in S, ENNReal.ofReal ((2 / r) ^ (e - 1) / e) *
          (ENNReal.ofReal |(e : ℝ) * t ^ (e - 1)| * φ (t ^ e)) := by
        refine setLIntegral_mono' measurableSet_Icc fun t ht => ?_
        rw [← mul_assoc, ← ENNReal.ofReal_mul hc0]
        conv_lhs => rw [← one_mul (φ (t ^ e))]
        gcongr
        rw [ENNReal.one_le_ofReal, abs_of_pos (by have := hSpos t ht; positivity)]
        have hte : (1 : ℝ) ≤ (2 / r * t) ^ (e - 1) := by
          refine one_le_pow₀ ?_
          rw [div_mul_eq_mul_div, le_div_iff₀ hr]; linarith [ht.1]
        have hepos : (0 : ℝ) < e := by exact_mod_cast (show 0 < e by omega)
        calc (1 : ℝ) ≤ (2 / r * t) ^ (e - 1) := hte
          _ = (2 / r) ^ (e - 1) / e * (e * t ^ (e - 1)) := by
            rw [mul_pow]; field_simp
    _ = ENNReal.ofReal ((2 / r) ^ (e - 1) / e) * ∫⁻ σ in (fun t : ℝ => t ^ e) '' S, φ σ := by
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, hcv]
    _ ≤ _ := by
        gcongr
        intro σ hσ
        obtain ⟨t, ht, rfl⟩ := hσ
        have ht0 := hSpos t ht
        exact ⟨by positivity, pow_le_pow_left₀ ht0.le ht.2 e⟩

/-- On `[0, 2^e R]` the bracket `b_R` is at least `(1 + 2^e)^{-10} / R`. -/
theorem one_le_bracketKernelAt {e : ℕ} {R0 σ : ℝ} (hR : 0 < R0) (hσ : |σ| ≤ 2 ^ e * R0) :
    1 ≤ (1 + 2 ^ e) ^ (10 : ℝ) * R0 * Twisted.bracketKernelAt R0 0 σ := by
  simp only [Twisted.bracketKernelAt, Twisted.kernelAt, Twisted.kernelDilate, sub_zero,
    smul_eq_mul, Twisted.bracketKernel]
  have h1 : 0 < 1 + |σ / R0| := by positivity
  have hle : 1 + |σ / R0| ≤ 1 + 2 ^ e := by
    have : |σ| / R0 ≤ 2 ^ e := by rw [div_le_iff₀ hR]; exact hσ
    rw [abs_div, abs_of_pos hR]; linarith
  rw [Real.rpow_neg h1.le]
  have e1 : R0 * (R0⁻¹ * ((1 + |σ / R0|) ^ (10 : ℝ))⁻¹) = ((1 + |σ / R0|) ^ (10 : ℝ))⁻¹ := by
    field_simp
  rw [mul_assoc, e1, ← div_eq_mul_inv, le_div_iff₀ (Real.rpow_pos_of_pos h1 _), one_mul]
  exact Real.rpow_le_rpow h1.le hle (by norm_num)

theorem bracketKernelAt_neg (s σ : ℝ) :
    Twisted.bracketKernelAt s 0 (-σ) = Twisted.bracketKernelAt s 0 σ := by
  simp [Twisted.bracketKernelAt, Twisted.kernelAt, Twisted.kernelDilate, Twisted.bracketKernel,
    neg_div, abs_neg]

/-- **The curve average is dominated by the coordinate maximal function**: uniformly in `j`,
`∫ w_j(t) |h(y ± t^{n+1} e_n)| dt ≤ C M^{(n)} h(y)`. -/
theorem lintegral_wJ_curve_le_maximal (n : Fin 3) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (j : ℤ) (h : E3 → ℂ), Measurable h → ∀ B : ℝ, (∀ y, ‖h y‖ ≤ B) →
      ∀ (y : E3) (sg : ℝ), (sg = 1 ∨ sg = -1) →
      ∫⁻ t, wJ j t * ‖h (y + sg • curve n t)‖ₑ
        ≤ ENNReal.ofReal (C * Twisted.coordinateDyadicBallMaximal n h y) := by
  set e := expo n with he_def
  have he : 1 ≤ e := expo_pos n
  have hepos : (0 : ℝ) < e := by exact_mod_cast (show 0 < e by omega)
  set D := Twisted.dyadicBracketShellConstant
  have hD0 : 0 ≤ D := Twisted.dyadicBracketShellConstant_nonneg
  refine ⟨4 * 2 ^ e * (1 + 2 ^ e) ^ (10 : ℝ) / e * D, by positivity, fun j h hh B hB y sg hsg => ?_⟩
  set r : ℝ := (2 : ℝ) ^ (-j) with hr
  have hr0 : 0 < r := zpow_pos two_pos _
  set R0 : ℝ := r ^ e with hR0
  have hR00 : 0 < R0 := by positivity
  set S := Set.Icc (r / 2) (2 * r) with hS
  set b : ℝ → ℝ := fun σ => Twisted.bracketKernelAt R0 0 σ with hb
  have hb0 : ∀ σ, 0 ≤ b σ := fun σ => Twisted.bracketKernelAt_nonneg hR00.le
  have hbint : Integrable b := Twisted.integrable_bracketKernelAt hR00 0
  set ρ : ℝ → ℝ≥0∞ := fun σ => ‖h (y - σ • basisVec n)‖ₑ with hρ
  have hρm : Measurable ρ :=
    (hh.comp (measurable_const.sub (measurable_id.smul_const _))).enorm
  set φ : ℝ → ℝ≥0∞ := fun σ => ρ σ + ρ (-σ) with hφ
  have hφm : Measurable φ := hρm.add (hρm.comp measurable_neg)
  have hφeven : ∀ σ, φ (-σ) = φ σ := fun σ => by simp only [hφ, neg_neg]; ring
  set Kc : ℝ := (2 / r) ^ (e - 1) / e with hKc
  set L : ℝ := (1 + 2 ^ e) ^ (10 : ℝ) * R0 with hL
  -- Step A: the integrand is at most `w_j(t) φ(t^e)`
  have hA : ∀ t, ‖h (y + sg • curve n t)‖ₑ ≤ φ (t ^ e) := by
    intro t
    have : y + sg • curve n t = y - (-(sg * t ^ e)) • basisVec n := by
      simp only [curve, he_def, smul_smul, neg_smul, sub_neg_eq_add]
    rw [this]
    rcases hsg with rfl | rfl
    · simp only [one_mul, hφ, hρ]; exact le_add_self
    · simp only [neg_mul, one_mul, neg_neg, hφ, hρ]; exact le_self_add
  -- Step B: fold `t < 0` onto `t > 0`
  have hB' : ∫⁻ t, wJ j t * φ (t ^ e)
      ≤ ENNReal.ofReal (2 / r) * (2 * ∫⁻ t in S, φ (t ^ e)) := by
    have hind : ∀ t : ℝ, S.indicator (1 : ℝ → ℝ≥0∞) |t| = S.indicator (1 : ℝ → ℝ≥0∞) t + S.indicator (1 : ℝ → ℝ≥0∞) (-t) := by
      intro t
      rcases lt_trichotomy t 0 with ht | ht | ht
      · have : t ∉ S := fun h' => by linarith [h'.1, show 0 < r / 2 by positivity]
        rw [abs_of_neg ht, Set.indicator_of_notMem this, zero_add]
      · subst ht
        have : (0 : ℝ) ∉ S := fun h' => by linarith [h'.1, show 0 < r / 2 by positivity]
        simp [this]
      · have : -t ∉ S := fun h' => by linarith [h'.1, show 0 < r / 2 by positivity]
        rw [abs_of_pos ht, Set.indicator_of_notMem this, add_zero]
    calc ∫⁻ t, wJ j t * φ (t ^ e)
        ≤ ∫⁻ t, ENNReal.ofReal (2 / r) * (S.indicator (1 : ℝ → ℝ≥0∞) |t| * φ (t ^ e)) := by
          refine lintegral_mono fun t => ?_
          rw [← mul_assoc]; exact mul_le_mul' (wJ_le_indicator j t) le_rfl
      _ = ENNReal.ofReal (2 / r) * ((∫⁻ t, S.indicator (1 : ℝ → ℝ≥0∞) t * φ (t ^ e)) +
            ∫⁻ t, S.indicator (1 : ℝ → ℝ≥0∞) (-t) * φ (t ^ e)) := by
          rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, ← lintegral_add_left]
          · congr 1; refine lintegral_congr fun t => ?_; rw [hind, add_mul]
          · exact (((measurable_one.indicator measurableSet_Icc).mul
              (hφm.comp (measurable_id.pow_const e))) :
                Measurable fun t => S.indicator (1 : ℝ → ℝ≥0∞) t * φ (t ^ e))
      _ = ENNReal.ofReal (2 / r) * (2 * ∫⁻ t in S, φ (t ^ e)) := by
          have e2 : ∫⁻ t, S.indicator (1 : ℝ → ℝ≥0∞) (-t) * φ (t ^ e) = ∫⁻ t, S.indicator (1 : ℝ → ℝ≥0∞) t * φ (t ^ e) := by
            rw [← lintegral_neg_eq_self (fun t => S.indicator (1 : ℝ → ℝ≥0∞) (-t) * φ (t ^ e))]
            refine lintegral_congr fun t => ?_
            simp only [neg_neg]
            congr 1
            rcases neg_one_pow_eq_or ℝ e with h1 | h1
            · rw [neg_pow, h1, one_mul]
            · rw [neg_pow, h1, neg_one_mul, hφeven]
          rw [e2, ← two_mul]
          congr 2
          rw [← lintegral_indicator measurableSet_Icc]
          refine lintegral_congr fun t => ?_
          by_cases ht : t ∈ S
          · rw [Set.indicator_of_mem ht, Set.indicator_of_mem ht, Pi.one_apply, one_mul]
          · rw [Set.indicator_of_notMem ht, Set.indicator_of_notMem ht, zero_mul]
  -- Step C: substitute `σ = t^e` and dominate by the bracket
  have hC : ∫⁻ t in S, φ (t ^ e) ≤ ENNReal.ofReal Kc * (ENNReal.ofReal L * ∫⁻ σ, ENNReal.ofReal (b σ) * φ σ) := by
    refine (setLIntegral_comp_pow_le he hr0).trans ?_
    gcongr
    calc ∫⁻ σ in Set.Icc 0 ((2 * r) ^ e), φ σ
        ≤ ∫⁻ σ in Set.Icc 0 ((2 * r) ^ e), ENNReal.ofReal L * (ENNReal.ofReal (b σ) * φ σ) := by
          refine setLIntegral_mono' measurableSet_Icc fun σ hσ => ?_
          rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
          conv_lhs => rw [← one_mul (φ σ)]
          gcongr
          rw [ENNReal.one_le_ofReal]
          have hσ' : |σ| ≤ 2 ^ e * R0 := by
            rw [abs_of_nonneg hσ.1, hR0, ← mul_pow]; exact hσ.2
          exact one_le_bracketKernelAt hR00 hσ'
      _ ≤ ∫⁻ σ, ENNReal.ofReal L * (ENNReal.ofReal (b σ) * φ σ) := setLIntegral_le_lintegral _ _
      _ = _ := lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
  -- Step D, E: reflect and apply the maximal bound
  have hint : Integrable fun σ : ℝ => ‖h (y - σ • basisVec n)‖ * b σ := by
    refine (hbint.const_mul B).mono' ?_ (Eventually.of_forall fun σ => ?_)
    · exact ((hh.comp (measurable_const.sub (measurable_id.smul_const _))).norm.aestronglyMeasurable).mul
        hbint.aestronglyMeasurable
    · rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (norm_nonneg _) (hb0 σ))]
      exact mul_le_mul_of_nonneg_right (hB _) (hb0 σ)
  have hDE : ∫⁻ σ, ENNReal.ofReal (b σ) * φ σ
      ≤ 2 * ENNReal.ofReal (D * Twisted.coordinateDyadicBallMaximal n h y) := by
    have hmeasb : Measurable fun σ => ENNReal.ofReal (b σ) :=
      ENNReal.measurable_ofReal.comp (Twisted.continuous_bracketKernelAt hR00.ne' 0).measurable
    have hsplit : ∫⁻ σ, ENNReal.ofReal (b σ) * φ σ
        = (∫⁻ σ, ENNReal.ofReal (b σ) * ρ σ) + ∫⁻ σ, ENNReal.ofReal (b σ) * ρ (-σ) := by
      rw [← lintegral_add_left (f := fun σ => ENNReal.ofReal (b σ) * ρ σ) (hmeasb.mul hρm)]
      refine lintegral_congr fun σ => ?_
      rw [hφ, mul_add]
    have hrefl : ∫⁻ σ, ENNReal.ofReal (b σ) * ρ (-σ) = ∫⁻ σ, ENNReal.ofReal (b σ) * ρ σ := by
      rw [← lintegral_neg_eq_self (fun σ => ENNReal.ofReal (b σ) * ρ σ)]
      refine lintegral_congr fun σ => ?_
      simp only [hb, bracketKernelAt_neg]
    have hone : ∫⁻ σ, ENNReal.ofReal (b σ) * ρ σ
        ≤ ENNReal.ofReal (D * Twisted.coordinateDyadicBallMaximal n h y) := by
      calc ∫⁻ σ, ENNReal.ofReal (b σ) * ρ σ
          = ∫⁻ σ, ENNReal.ofReal (‖h (y - σ • basisVec n)‖ * b σ) := by
            refine lintegral_congr fun σ => ?_
            rw [ENNReal.ofReal_mul (norm_nonneg _), ofReal_norm, mul_comm]
        _ = ENNReal.ofReal (∫ σ, ‖h (y - σ • basisVec n)‖ * b σ) :=
            (ofReal_integral_eq_lintegral_ofReal hint
              (Eventually.of_forall fun σ => mul_nonneg (norm_nonneg _) (hb0 σ))).symm
        _ ≤ _ := ENNReal.ofReal_le_ofReal (integral_bracket_le_maximal n hh hB hR00 y)
    rw [hsplit, hrefl, ← two_mul]
    gcongr
  have hM0 : 0 ≤ Twisted.coordinateDyadicBallMaximal n h y := ENNReal.toReal_nonneg
  have hkey : (2 / r) * Kc * L = 2 ^ e * (1 + 2 ^ e) ^ (10 : ℝ) / e := by
    have hp : (2 / r) ^ (e - 1) * (2 / r) = (2 / r) ^ e := by
      rw [← pow_succ, Nat.sub_add_cancel he]
    have hq : (2 / r) ^ e * r ^ e = 2 ^ e := by rw [div_pow]; field_simp
    rw [hKc, hL, hR0]
    calc 2 / r * ((2 / r) ^ (e - 1) / e) * ((1 + 2 ^ e) ^ (10 : ℝ) * r ^ e)
        = ((2 / r) ^ (e - 1) * (2 / r)) * r ^ e * (1 + 2 ^ e) ^ (10 : ℝ) / e := by ring
      _ = _ := by rw [hp, hq]
  calc ∫⁻ t, wJ j t * ‖h (y + sg • curve n t)‖ₑ
      ≤ ∫⁻ t, wJ j t * φ (t ^ e) := lintegral_mono fun t => by gcongr; exact hA t
    _ ≤ ENNReal.ofReal (2 / r) * (2 * (ENNReal.ofReal Kc * (ENNReal.ofReal L *
          (2 * ENNReal.ofReal (D * Twisted.coordinateDyadicBallMaximal n h y))))) := by
        refine hB'.trans ?_
        gcongr
        exact hC.trans (by gcongr)
    _ = ENNReal.ofReal (4 * 2 ^ e * (1 + 2 ^ e) ^ (10 : ℝ) / e * D *
          Twisted.coordinateDyadicBallMaximal n h y) := by
        have h2 : (2 : ℝ≥0∞) = ENNReal.ofReal 2 := by simp
        have hKc0 : 0 ≤ Kc := by positivity
        have hL0 : 0 ≤ L := by positivity
        rw [h2, ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul hL0,
          ← ENNReal.ofReal_mul hKc0, ← ENNReal.ofReal_mul (by norm_num),
          ← ENNReal.ofReal_mul (by positivity)]
        congr 1
        calc 2 / r * (2 * (Kc * (L * (2 * (D * Twisted.coordinateDyadicBallMaximal n h y)))))
            = 4 * ((2 / r) * Kc * L) * D * Twisted.coordinateDyadicBallMaximal n h y := by ring
          _ = _ := by rw [hkey]; ring

/-- The curve average `B_j(G)(x) = ∫ w_j(t) |G(x + t^{n+1} e_n)|^2 dt`. -/
def curveAvg (n : Fin 3) (j : ℤ) (G : E3 → ℂ) (x : E3) : ℝ≥0∞ :=
  ∫⁻ t, wJ j t * ‖G (x + curve n t)‖ₑ ^ (2 : ℝ)

theorem measurable_curveAvg (n : Fin 3) (j : ℤ) {G : E3 → ℂ} (hG : Measurable G) :
    Measurable (curveAvg n j G) := by
  unfold curveAvg
  refine Measurable.lintegral_prod_right' (f := fun p : E3 × ℝ =>
    wJ j p.2 * ‖G (p.1 + curve n p.2)‖ₑ ^ (2 : ℝ)) ?_
  exact ((measurable_wJ j).comp measurable_snd).mul
    ((hG.comp (measurable_fst.add ((continuous_curve n).measurable.comp measurable_snd))).enorm.pow_const _)

/-- **Duality for the curve average** (Tonelli and translation invariance):
`∫ B_j(G) K = ∫ |G(y)|^2 ∫ w_j(t) K(y - t^{n+1} e_n) dt dy`. -/
theorem lintegral_curveAvg_mul (n : Fin 3) (j : ℤ) {G : E3 → ℂ} (hG : Measurable G)
    {K : E3 → ℝ≥0∞} (hK : Measurable K) :
    ∫⁻ x, curveAvg n j G x * K x
      = ∫⁻ y, ‖G y‖ₑ ^ (2 : ℝ) * ∫⁻ t, wJ j t * K (y - curve n t) := by
  have hc := (continuous_curve n).measurable
  have hj1 : Measurable fun p : E3 × ℝ => wJ j p.2 * ‖G (p.1 + curve n p.2)‖ₑ ^ (2 : ℝ) * K p.1 :=
    (((measurable_wJ j).comp measurable_snd).mul
      ((hG.comp (measurable_fst.add (hc.comp measurable_snd))).enorm.pow_const _)).mul
      (hK.comp measurable_fst)
  have hj2 : Measurable fun p : E3 × ℝ => ‖G p.1‖ₑ ^ (2 : ℝ) * (wJ j p.2 * K (p.1 - curve n p.2)) :=
    ((hG.comp measurable_fst).enorm.pow_const _).mul (((measurable_wJ j).comp measurable_snd).mul
      (hK.comp (measurable_fst.sub (hc.comp measurable_snd))))
  calc ∫⁻ x, curveAvg n j G x * K x
      = ∫⁻ x, ∫⁻ t, wJ j t * ‖G (x + curve n t)‖ₑ ^ (2 : ℝ) * K x := by
        refine lintegral_congr fun x => ?_
        rw [curveAvg, ← lintegral_mul_const (f := fun t => wJ j t * ‖G (x + curve n t)‖ₑ ^ (2 : ℝ))
          _ (((measurable_wJ j).mul ((hG.comp (measurable_const.add hc)).enorm.pow_const _)))]
    _ = ∫⁻ t, ∫⁻ x, wJ j t * ‖G (x + curve n t)‖ₑ ^ (2 : ℝ) * K x :=
        lintegral_lintegral_swap hj1.aemeasurable
    _ = ∫⁻ t, ∫⁻ y, ‖G y‖ₑ ^ (2 : ℝ) * (wJ j t * K (y - curve n t)) := by
        refine lintegral_congr fun t => ?_
        rw [← lintegral_add_right_eq_self (μ := volume)
          (fun y => ‖G y‖ₑ ^ (2 : ℝ) * (wJ j t * K (y - curve n t))) (curve n t)]
        refine lintegral_congr fun x => ?_
        simp only [add_sub_cancel_right]; ring
    _ = ∫⁻ y, ∫⁻ t, ‖G y‖ₑ ^ (2 : ℝ) * (wJ j t * K (y - curve n t)) :=
        (lintegral_lintegral_swap hj2.aemeasurable).symm
    _ = _ := by
        refine lintegral_congr fun y => ?_
        rw [lintegral_const_mul]
        exact ((measurable_wJ j).mul (hK.comp (measurable_const.sub hc)))

/-- `|G|^2` of a Schwartz function lies in every `L^ρ`. -/
theorem memLp_sq_schwartz (G : 𝓢(E3, ℂ)) {ρ : ℝ} (hρ : 0 < ρ) :
    MemLp (fun y => ((‖G y‖ ^ (2 : ℝ) : ℝ) : ℂ)) (ENNReal.ofReal ρ) volume := by
  have h := (G.memLp (ENNReal.ofReal (2 * ρ)) volume).norm_rpow_div 2
  have e : ENNReal.ofReal (2 * ρ) / 2 = ENNReal.ofReal ρ := by
    rw [show (2 : ℝ≥0∞) = ENNReal.ofReal 2 by simp, ← ENNReal.ofReal_div_of_pos two_pos]
    congr 1; ring
  rw [e] at h
  exact h.ofReal (K := ℂ)

/-- `|G|^2` as a complex function. -/
def sqC (G : E3 → ℂ) (y : E3) : ℂ := ((‖G y‖ ^ (2 : ℝ) : ℝ) : ℂ)

theorem measurable_sqC {G : E3 → ℂ} (hG : Measurable G) : Measurable (sqC G) :=
  Complex.continuous_ofReal.measurable.comp (hG.norm.pow_const _)

theorem norm_sqC_le {G : E3 → ℂ} {B : ℝ} (hB0 : 0 ≤ B) (hB : ∀ y, ‖G y‖ ≤ B) (y : E3) :
    ‖sqC G y‖ ≤ B ^ (2 : ℝ) := by
  rw [sqC, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)]
  exact Real.rpow_le_rpow (norm_nonneg _) (hB y) (by norm_num)

theorem enorm_sqC (G : E3 → ℂ) (z : E3) : ‖sqC G z‖ₑ = ‖G z‖ₑ ^ (2 : ℝ) := by
  rw [sqC, ← ofReal_norm, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _),
    ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by norm_num), ofReal_norm]

/-- The coordinate maximal constant of `Auto.Twisted.eLpNorm_coordinateDyadicBallMaximal_le`. -/
def maxConst (p : ℝ) : ℝ≥0∞ := (ENNReal.ofReal p * (2 * ENNReal.ofReal 4 *
    (ENNReal.ofReal (p - 1))⁻¹ * (ENNReal.ofReal (2 : ℝ)) ^ (p - 1))) ^ (1 / p)

theorem maxConst_ne_top {p : ℝ} (hp : 1 < p) : maxConst p ≠ ⊤ := by
  unfold maxConst
  apply ENNReal.rpow_ne_top_of_nonneg (div_nonneg zero_le_one (by linarith))
  apply ENNReal.mul_ne_top ENNReal.ofReal_ne_top
  apply ENNReal.mul_ne_top
  · apply ENNReal.mul_ne_top
    · exact ENNReal.mul_ne_top (by norm_num) ENNReal.ofReal_ne_top
    · exact ENNReal.inv_ne_top.mpr (by simpa using hp)
  · exact ENNReal.rpow_ne_top_of_nonneg (by linarith) ENNReal.ofReal_ne_top

/-- The sum of the maximal functions of `|G_j|^2` lies in `L^ρ`. -/
theorem lintegral_sum_maximal_sqC_lt_top (n : Fin 3) {ρ : ℝ} (hρ : 1 < ρ) (C1 : ℝ) (S : Finset ℤ)
    (G : ℤ → 𝓢(E3, ℂ)) :
    ∫⁻ x, ‖C1 * ∑ j ∈ S, Twisted.coordinateDyadicBallMaximal n (sqC (G j)) x‖ₑ ^ ρ < ⊤ := by
  have hρ0 : 0 < ρ := by linarith
  have hmem : MemLp (fun x => C1 * ∑ j ∈ S, Twisted.coordinateDyadicBallMaximal n (sqC (G j)) x)
      (ENNReal.ofReal ρ) volume := by
    refine MemLp.const_mul (memLp_finsetSum (f := fun j x => Twisted.coordinateDyadicBallMaximal n (sqC (G j)) x)
      _ fun j _ => ?_) C1
    obtain ⟨B, hB0, hB⟩ := exists_bound_schwartz (G j)
    exact Twisted.coordinateDyadicBallMaximal_memLp n (sqC (G j))
      (measurable_sqC (G j).continuous.measurable) _ (Real.rpow_nonneg hB0 _) (norm_sqC_le hB0 hB) hρ
      (memLp_sq_schwartz (G j) hρ0)
  have hlt := hmem.eLpNorm_lt_top
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hρ0) ENNReal.ofReal_ne_top,
    ENNReal.toReal_ofReal hρ0.le] at hlt
  by_contra hc
  rw [not_lt, top_le_iff] at hc
  rw [hc, ENNReal.top_rpow_of_pos (by positivity)] at hlt
  exact lt_irrefl _ hlt

theorem maximal_nonneg (n : Fin 3) (h : E3 → ℂ) (x : E3) :
    0 ≤ Twisted.coordinateDyadicBallMaximal n h x := ENNReal.toReal_nonneg

/-- **The `L^2` slots** (alternative route, line 456): for `ρ > 1`,
`‖∑_j B_j(G_j)‖_ρ ≲ ‖∑_j |G_j|^2‖_ρ` uniformly in the finite family, by duality with the
coordinate maximal function. -/
theorem lintegral_sum_curveAvg_rpow_le (n : Fin 3) {ρ : ℝ} (hρ : 1 < ρ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (S : Finset ℤ) (G : ℤ → 𝓢(E3, ℂ)),
      ∫⁻ x, (∑ j ∈ S, curveAvg n j (G j) x) ^ ρ
        ≤ ENNReal.ofReal C * ∫⁻ x, (∑ j ∈ S, ‖G j x‖ₑ ^ (2 : ℝ)) ^ ρ := by
  obtain ⟨C1, hC10, hC1⟩ := lintegral_wJ_curve_le_maximal n
  have hρ0 : 0 < ρ := by linarith
  set ρ' := ρ.conjExponent with hρ'
  have hhol : ρ.HolderConjugate ρ' := Real.HolderConjugate.conjExponent hρ
  have hρ'1 : 1 < ρ' := hhol.symm.lt
  have hρ'0 : 0 < ρ' := by linarith
  set CM := maxConst ρ' with hCM
  have hCMfin : CM ≠ ⊤ := maxConst_ne_top hρ'1
  refine ⟨(C1 * CM.toReal) ^ ρ, by positivity, fun S G => ?_⟩
  set F : E3 → ℝ≥0∞ := fun x => ∑ j ∈ S, curveAvg n j (G j) x with hF
  set Φ : E3 → ℝ≥0∞ := fun x => ∑ j ∈ S, ‖G j x‖ₑ ^ (2 : ℝ) with hΦ
  have hFm : Measurable F := Finset.measurable_sum _ fun j _ =>
    measurable_curveAvg n j (G j).continuous.measurable
  have hΦm : Measurable Φ := Finset.measurable_sum _ fun j _ =>
    (G j).continuous.measurable.enorm.pow_const _
  choose Bd hBd0 hBd using fun j => exists_bound_schwartz (G j)
  -- pointwise domination of `F`
  have hFle : ∀ x, F x ≤ ENNReal.ofReal (C1 * ∑ j ∈ S,
      Twisted.coordinateDyadicBallMaximal n (sqC (G j)) x) := by
    intro x
    rw [Finset.mul_sum, ENNReal.ofReal_sum_of_nonneg (f := fun j =>
      C1 * Twisted.coordinateDyadicBallMaximal n (sqC (G j)) x)
      fun j _ => mul_nonneg hC10 ENNReal.toReal_nonneg]
    refine Finset.sum_le_sum fun j _ => ?_
    have h := hC1 j (sqC (G j)) (measurable_sqC (G j).continuous.measurable) _
      (norm_sqC_le (hBd0 j) (hBd j)) x 1 (Or.inl rfl)
    simp only [one_smul, enorm_sqC] at h
    exact h
  set Btot : ℝ := C1 * ∑ j ∈ S, Bd j ^ (2 : ℝ) with hBtot
  have hB0 : 0 ≤ Btot := mul_nonneg hC10 (Finset.sum_nonneg fun j _ => Real.rpow_nonneg (hBd0 j) _)
  have hFB : ∀ x, F x ≤ ENNReal.ofReal Btot := fun x =>
    (hFle x).trans (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left
      (Finset.sum_le_sum fun j _ => Twisted.coordinateDyadicBallMaximal_top_bound n (sqC (G j)) _
        (Real.rpow_nonneg (hBd0 j) _) (norm_sqC_le (hBd0 j) (hBd j)) x) hC10))
  have hFfin : ∀ x, F x ≠ ⊤ := fun x => ne_top_of_le_ne_top ENNReal.ofReal_ne_top (hFB x)
  set I := ∫⁻ x, F x ^ ρ with hI
  set J := ∫⁻ x, Φ x ^ ρ with hJ
  -- `I < ∞`
  have hIfin : I ≠ ⊤ := by
    refine ne_top_of_le_ne_top (lintegral_sum_maximal_sqC_lt_top n hρ C1 S G).ne
      (lintegral_mono fun x => ENNReal.rpow_le_rpow ((hFle x).trans_eq ?_) hρ0.le)
    rw [← ofReal_norm, Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hC10
      (Finset.sum_nonneg fun j _ => maximal_nonneg n _ x))]
  -- the dual function `F^{ρ-1}`
  set H : E3 → ℂ := fun y => (((F y).toReal ^ (ρ - 1) : ℝ) : ℂ) with hH
  have hHm : Measurable H :=
    Complex.continuous_ofReal.measurable.comp (hFm.ennreal_toReal.pow_const _)
  have hHB : ∀ y, ‖H y‖ ≤ Btot ^ (ρ - 1) := fun y => by
    rw [hH, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg ENNReal.toReal_nonneg _)]
    refine Real.rpow_le_rpow ENNReal.toReal_nonneg ?_ (by linarith)
    simpa [ENNReal.toReal_ofReal hB0] using ENNReal.toReal_mono ENNReal.ofReal_ne_top (hFB y)
  have hHnorm : ∀ z, ‖H z‖ₑ = F z ^ (ρ - 1) := fun z => by
    rw [hH, ← ofReal_norm, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg ENNReal.toReal_nonneg _),
      ← ENNReal.ofReal_rpow_of_nonneg ENNReal.toReal_nonneg (by linarith),
      ENNReal.ofReal_toReal (hFfin z)]
  set MH : E3 → ℝ := Twisted.coordinateDyadicBallMaximal n H with hMH
  have hMHm : Measurable MH := Twisted.coordinateDyadicBallMaximal_measurable n H hHm
  -- duality
  have hdual : I ≤ ∫⁻ y, Φ y * ENNReal.ofReal (C1 * MH y) := by
    calc I = ∫⁻ x, F x * F x ^ (ρ - 1) := by
          refine lintegral_congr fun x => ?_
          conv_lhs => rw [show ρ = 1 + (ρ - 1) by ring]
          rw [ENNReal.rpow_add_of_nonneg _ _ (by norm_num) (by linarith), ENNReal.rpow_one]
      _ = ∑ j ∈ S, ∫⁻ x, curveAvg n j (G j) x * F x ^ (ρ - 1) := by
          rw [← lintegral_finsetSum (f := fun j x => curveAvg n j (G j) x * F x ^ (ρ - 1)) _ fun j _ =>
            (measurable_curveAvg n j (G j).continuous.measurable).mul (hFm.pow_const _)]
          refine lintegral_congr fun x => ?_
          rw [hF, Finset.sum_mul]
      _ = ∑ j ∈ S, ∫⁻ y, ‖G j y‖ₑ ^ (2 : ℝ) * ∫⁻ t, wJ j t * F (y - curve n t) ^ (ρ - 1) :=
          Finset.sum_congr rfl fun j _ =>
            lintegral_curveAvg_mul n j (G j).continuous.measurable (hFm.pow_const _)
      _ ≤ ∑ j ∈ S, ∫⁻ y, ‖G j y‖ₑ ^ (2 : ℝ) * ENNReal.ofReal (C1 * MH y) := by
          refine Finset.sum_le_sum fun j _ => lintegral_mono fun y => ?_
          gcongr
          have h := hC1 j H hHm _ hHB y (-1) (Or.inr rfl)
          simp only [hHnorm, neg_one_smul, ← sub_eq_add_neg] at h
          exact h
      _ = _ := by
          rw [← lintegral_finsetSum (f := fun j y => ‖G j y‖ₑ ^ (2 : ℝ) * ENNReal.ofReal (C1 * MH y))
            _ fun j _ => ((G j).continuous.measurable.enorm.pow_const _).mul
              (ENNReal.measurable_ofReal.comp (measurable_const.mul hMHm))]
          refine lintegral_congr fun y => ?_
          rw [hΦ, Finset.sum_mul]
  -- Hölder, then the maximal theorem for `H`
  have hMHnorm : ∀ y, ENNReal.ofReal (C1 * MH y) = ENNReal.ofReal C1 * ‖MH y‖ₑ := fun y => by
    rw [ENNReal.ofReal_mul hC10, ← ofReal_norm, Real.norm_eq_abs, abs_of_nonneg (maximal_nonneg n H y)]
  have hHol := ENNReal.lintegral_mul_le_Lp_mul_Lq volume hhol (f := Φ)
    (g := fun y => ENNReal.ofReal (C1 * MH y)) hΦm.aemeasurable
    (ENNReal.measurable_ofReal.comp (measurable_const.mul hMHm)).aemeasurable
  have hMax := Twisted.eLpNorm_coordinateDyadicBallMaximal_le n H hHm _ (by positivity) hHB hρ'1
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hρ'0) ENNReal.ofReal_ne_top,
    eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hρ'0) ENNReal.ofReal_ne_top,
    ENNReal.toReal_ofReal hρ'0.le] at hMax
  have hHint : ∫⁻ y, ‖H y‖ₑ ^ ρ' = I := by
    refine lintegral_congr fun y => ?_
    rw [hHnorm, ← ENNReal.rpow_mul]
    congr 1
    have h1 : ρ - 1 ≠ 0 := (sub_pos.mpr hρ).ne'
    rw [hρ', Real.conjExponent]; field_simp
  rw [hHint] at hMax
  have hMHint : (∫⁻ y, ENNReal.ofReal (C1 * MH y) ^ ρ') ^ (1 / ρ')
      ≤ ENNReal.ofReal C1 * (CM * I ^ (1 / ρ')) := by
    simp_rw [hMHnorm]
    rw [show (fun y => (ENNReal.ofReal C1 * ‖MH y‖ₑ) ^ ρ')
        = fun y => ENNReal.ofReal C1 ^ ρ' * ‖MH y‖ₑ ^ ρ' from
          funext fun y => ENNReal.mul_rpow_of_nonneg _ _ hρ'0.le,
      lintegral_const_mul' _ _ (ENNReal.rpow_ne_top_of_nonneg hρ'0.le ENNReal.ofReal_ne_top),
      ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
      mul_one_div_cancel hρ'0.ne', ENNReal.rpow_one]
    gcongr
    exact hMax
  have hmain : I ≤ ENNReal.ofReal C1 * CM * J ^ (1 / ρ) * I ^ (1 / ρ') := by
    calc I ≤ J ^ (1 / ρ) * (∫⁻ y, ENNReal.ofReal (C1 * MH y) ^ ρ') ^ (1 / ρ') := hdual.trans hHol
      _ ≤ J ^ (1 / ρ) * (ENNReal.ofReal C1 * (CM * I ^ (1 / ρ'))) := by gcongr
      _ = _ := by ring
  -- cancel `I^{1/ρ'}`
  by_cases hI0 : I = 0
  · rw [hI0]; exact bot_le
  have hsplit : I = I ^ (1 / ρ) * I ^ (1 / ρ') := by
    rw [← ENNReal.rpow_add_of_nonneg _ _ (by positivity) (by positivity), one_div, one_div,
      hhol.inv_add_inv_eq_one, ENNReal.rpow_one]
  have hIρ'0 : I ^ (1 / ρ') ≠ 0 := by
    intro h; rw [ENNReal.rpow_eq_zero_iff] at h
    rcases h with ⟨h, _⟩ | ⟨h, _⟩
    · exact hI0 h
    · exact hIfin h
  have hIρ'fin : I ^ (1 / ρ') ≠ ⊤ := ENNReal.rpow_ne_top_of_nonneg (by positivity) hIfin
  have hroot : I ^ (1 / ρ) ≤ ENNReal.ofReal C1 * CM * J ^ (1 / ρ) := by
    have h := hmain
    nth_rewrite 1 [hsplit] at h
    exact (ENNReal.mul_le_mul_iff_left hIρ'0 hIρ'fin).mp h
  have hfinal : I ≤ (ENNReal.ofReal C1 * CM) ^ ρ * J := by
    have h := ENNReal.rpow_le_rpow hroot hρ0.le
    rwa [← ENNReal.rpow_mul, one_div_mul_cancel hρ0.ne', ENNReal.rpow_one,
      ENNReal.mul_rpow_of_nonneg _ _ hρ0.le, ← ENNReal.rpow_mul (J), one_div_mul_cancel hρ0.ne',
      ENNReal.rpow_one] at h
  refine hfinal.trans_eq ?_
  congr 1
  rw [← ENNReal.ofReal_toReal hCMfin, ← ENNReal.ofReal_mul hC10,
    ENNReal.ofReal_rpow_of_nonneg (by positivity) hρ0.le, ENNReal.toReal_ofReal ENNReal.toReal_nonneg]

/-- The pieces `Δ^{(n)}_{(n+1)j+k_n} f_n` of `T^{(k)}`. -/
def kDelta (k : Fin 3 → ℤ) (f : Fin 3 → 𝓢(E3, ℂ)) (n : Fin 3) (j : ℤ) : 𝓢(E3, ℂ) :=
  lpDelta n ((expo n : ℤ) * j + k n) (f n)

theorem freqPiece_eq_kDelta (j : ℤ) (k : Fin 3 → ℤ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    freqPiece j k f x = simplexTj j (fun n => ⇑(kDelta k f n j)) x := rfl

/-- **The pointwise bound behind the small-loss estimate**: Hölder `(∞, 2, 2)` in `t` for each
`j`, then `(∞, 2, 2)` in `j`, with the `∞` slot controlled by `Auto.enorm_lpDelta_shift_le`. -/
theorem enorm_kComp_le {s : ℝ} (hs : 1 < s) :
    ∃ C0 : ℝ, 0 ≤ C0 ∧ ∀ (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) (q : ℝ), 0 < q →
      ‖kComp k J f x‖ₑ ≤
        (∑ j ∈ Finset.Icc (-(J : ℤ)) J,
          (ENNReal.ofReal (C0 * (1 + (2 : ℝ) ^ (k 0 + 1)) ^ (10 / s)) *
            ENNReal.ofReal (Twisted.coordinateDyadicBallMaximal 0
              (fun y => ((‖kDelta k f 0 j y‖ ^ s : ℝ) : ℂ)) x) ^ (1 / s)) ^ q) ^ (1 / q) *
        ((∑ j ∈ Finset.Icc (-(J : ℤ)) J, curveAvg 1 j (kDelta k f 1 j) x) ^ (1 / 2 : ℝ) *
          (∑ j ∈ Finset.Icc (-(J : ℤ)) J, curveAvg 2 j (kDelta k f 2 j) x) ^ (1 / 2 : ℝ)) := by
  obtain ⟨C0, hC00, hC0⟩ := enorm_lpDelta_shift_le 0 hs
  refine ⟨C0, hC00, fun k J f x q hq => ?_⟩
  set Sj := Finset.Icc (-(J : ℤ)) J
  set a : ℤ → ℝ≥0∞ := fun j => ENNReal.ofReal (C0 * (1 + (2 : ℝ) ^ (k 0 + 1)) ^ (10 / s)) *
    ENNReal.ofReal (Twisted.coordinateDyadicBallMaximal 0
      (fun y => ((‖kDelta k f 0 j y‖ ^ s : ℝ) : ℂ)) x) ^ (1 / s) with ha
  set B1 : ℤ → ℝ≥0∞ := fun j => curveAvg 1 j (kDelta k f 1 j) x
  set B2 : ℤ → ℝ≥0∞ := fun j => curveAvg 2 j (kDelta k f 2 j) x
  -- each piece
  have hpiece : ∀ j, ‖freqPiece j k f x‖ₑ ≤ a j * (B1 j ^ (1 / 2 : ℝ) * B2 j ^ (1 / 2 : ℝ)) := by
    intro j
    rw [freqPiece_eq_kDelta]
    refine enorm_simplexTj_le j _ (fun n => (kDelta k f n j).continuous) x (a j) fun t ht => ?_
    have hR : (0 : ℝ) ≤ (2 : ℝ) ^ (k 0 + 1) := (zpow_pos two_pos _).le
    have ht' : |t| ≤ (2 : ℝ) ^ (k 0 + 1) * (2 : ℝ) ^ (-((expo 0 : ℤ) * j + k 0)) := by
      have e : (2 : ℝ) ^ (k 0 + 1) * (2 : ℝ) ^ (-((expo 0 : ℤ) * j + k 0)) = 2 * (2 : ℝ) ^ (-j) := by
        rw [← zpow_add₀ two_ne_zero, show expo 0 = 1 from rfl]
        rw [show k 0 + 1 + -((((1 : ℕ) : ℤ)) * j + k 0) = 1 + -j by push_cast; ring,
          zpow_add₀ two_ne_zero, zpow_one]
      rw [e]; exact ht.le
    have h := hC0 ((expo 0 : ℤ) * j + k 0) (f 0) x t _ hR ht'
    have hc : curve 0 t = t • basisVec 0 := by simp [curve, show expo 0 = 1 from rfl]
    rw [hc]
    exact h
  have hsum : ‖kComp k J f x‖ₑ ≤ ∑ j ∈ Sj, a j * (B1 j ^ (1 / 2 : ℝ) * B2 j ^ (1 / 2 : ℝ)) := by
    unfold kComp
    exact (enorm_sum_le _ _).trans (Finset.sum_le_sum fun j _ => hpiece j)
  -- `a_j ≤ (∑ a^q)^{1/q}`
  have hsup : ∀ j ∈ Sj, a j ≤ (∑ i ∈ Sj, a i ^ q) ^ (1 / q) := by
    intro j hj
    have h1 : a j ^ q ≤ ∑ i ∈ Sj, a i ^ q :=
      Finset.single_le_sum (f := fun i => a i ^ q) (fun i _ => bot_le) hj
    have h2 := ENNReal.rpow_le_rpow h1 (by positivity : (0 : ℝ) ≤ 1 / q)
    rwa [← ENNReal.rpow_mul, mul_one_div_cancel hq.ne', ENNReal.rpow_one] at h2
  -- Cauchy-Schwarz in `j`
  have hcs : ∑ j ∈ Sj, B1 j ^ (1 / 2 : ℝ) * B2 j ^ (1 / 2 : ℝ)
      ≤ (∑ j ∈ Sj, B1 j) ^ (1 / 2 : ℝ) * (∑ j ∈ Sj, B2 j) ^ (1 / 2 : ℝ) := by
    have h := ENNReal.inner_le_Lp_mul_Lq Sj (fun j => B1 j ^ (1 / 2 : ℝ))
      (fun j => B2 j ^ (1 / 2 : ℝ)) Real.HolderConjugate.two_two
    have e : ∀ B : ℝ≥0∞, (B ^ (1 / 2 : ℝ)) ^ (2 : ℝ) = B := fun B => by
      rw [← ENNReal.rpow_mul]; norm_num
    simp only [e] at h
    exact h
  calc ‖kComp k J f x‖ₑ ≤ ∑ j ∈ Sj, a j * (B1 j ^ (1 / 2 : ℝ) * B2 j ^ (1 / 2 : ℝ)) := hsum
    _ ≤ ∑ j ∈ Sj, (∑ i ∈ Sj, a i ^ q) ^ (1 / q) * (B1 j ^ (1 / 2 : ℝ) * B2 j ^ (1 / 2 : ℝ)) :=
        Finset.sum_le_sum fun j hj => by gcongr; exact hsup j hj
    _ = (∑ i ∈ Sj, a i ^ q) ^ (1 / q) * ∑ j ∈ Sj, B1 j ^ (1 / 2 : ℝ) * B2 j ^ (1 / 2 : ℝ) := by
        rw [Finset.mul_sum]
    _ ≤ _ := by gcongr

/-- **The `∞`-slot integral**: `∑_{|j| ≤ J} ‖M^{(0)} |Δ^{(0)}_{j+k_0} g|^{q/2}‖_2^2 ≲ ‖g‖_q^q`, `q > 2`. -/
theorem sum_lintegral_maximal_slot_le {q : ℝ} (hq : 2 < q) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ (kn : ℤ) (J : ℕ) (g : 𝓢(E3, ℂ)),
      ∑ j ∈ Finset.Icc (-(J : ℤ)) J, ∫⁻ x, ENNReal.ofReal (Twisted.coordinateDyadicBallMaximal 0
          (fun y => ((‖lpDelta 0 ((expo 0 : ℤ) * j + kn) g y‖ ^ (q / 2) : ℝ) : ℂ)) x) ^ (2 : ℝ)
        ≤ ENNReal.ofReal A * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ q) := by
  obtain ⟨A0, hA0, hS⟩ := sum_lintegral_lpDelta_le 0 (q := q) hq.le
  set CM := maxConst 2 with hCM
  have hCMfin : CM ≠ ⊤ := maxConst_ne_top one_lt_two
  refine ⟨CM.toReal ^ 2 * A0, by positivity, fun kn J g => ?_⟩
  have hq0 : 0 < q := by linarith
  have hterm : ∀ G : 𝓢(E3, ℂ), ∫⁻ x, ENNReal.ofReal (Twisted.coordinateDyadicBallMaximal 0
      (fun y => ((‖G y‖ ^ (q / 2) : ℝ) : ℂ)) x) ^ (2 : ℝ)
      ≤ ENNReal.ofReal (CM.toReal ^ 2) * ∫⁻ x, ENNReal.ofReal (‖G x‖ ^ q) := by
    intro G
    set H : E3 → ℂ := fun y => ((‖G y‖ ^ (q / 2) : ℝ) : ℂ) with hH
    have hHm : Measurable H :=
      Complex.continuous_ofReal.measurable.comp (G.continuous.norm.measurable.pow_const _)
    obtain ⟨B, hB0, hB⟩ := exists_bound_schwartz G
    have hHB : ∀ y, ‖H y‖ ≤ B ^ (q / 2) := fun y => by
      rw [hH, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)]
      exact Real.rpow_le_rpow (norm_nonneg _) (hB y) (by positivity)
    have hMax := Twisted.eLpNorm_coordinateDyadicBallMaximal_le 0 H hHm _ (by positivity) hHB one_lt_two
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simp) ENNReal.ofReal_ne_top,
      eLpNorm_eq_lintegral_rpow_enorm_toReal (by simp) ENNReal.ofReal_ne_top,
      ENNReal.toReal_ofReal zero_le_two] at hMax
    have h2 : ∫⁻ x, ‖Twisted.coordinateDyadicBallMaximal 0 H x‖ₑ ^ (2 : ℝ)
        ≤ CM ^ (2 : ℝ) * ∫⁻ x, ‖H x‖ₑ ^ (2 : ℝ) := by
      have h := ENNReal.rpow_le_rpow hMax (by norm_num : (0 : ℝ) ≤ 2)
      rwa [← ENNReal.rpow_mul, ENNReal.mul_rpow_of_nonneg _ _ (by norm_num),
        ← ENNReal.rpow_mul (∫⁻ _, _), show (1 / 2 : ℝ) * 2 = 1 by norm_num, ENNReal.rpow_one,
        ENNReal.rpow_one] at h
    have eL : ∀ x, ENNReal.ofReal (Twisted.coordinateDyadicBallMaximal 0 H x) ^ (2 : ℝ)
        = ‖Twisted.coordinateDyadicBallMaximal 0 H x‖ₑ ^ (2 : ℝ) := fun x => by
      rw [← ofReal_norm, Real.norm_eq_abs, abs_of_nonneg (maximal_nonneg 0 H x)]
    have eR : ∀ x, ‖H x‖ₑ ^ (2 : ℝ) = ENNReal.ofReal (‖G x‖ ^ q) := fun x => by
      rw [hH, ← ofReal_norm, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _),
        ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _) (by norm_num),
        ← Real.rpow_mul (norm_nonneg _)]
      congr 2; ring
    simp_rw [eL, eR] at h2 ⊢
    refine h2.trans_eq ?_
    congr 1
    rw [← ENNReal.ofReal_toReal hCMfin, ENNReal.ofReal_rpow_of_nonneg ENNReal.toReal_nonneg
      (by norm_num), ENNReal.toReal_ofReal ENNReal.toReal_nonneg, Real.rpow_two]
  have hinj : Set.InjOn (fun j : ℤ => (expo 0 : ℤ) * j + kn) (Finset.Icc (-(J : ℤ)) J) := by
    intro a _ b _ h
    have : (expo 0 : ℤ) * a = (expo 0 : ℤ) * b := by simpa using h
    exact mul_left_cancel₀ (by exact_mod_cast (expo_pos 0).ne') this
  calc _ ≤ ∑ j ∈ Finset.Icc (-(J : ℤ)) J, ENNReal.ofReal (CM.toReal ^ 2) *
        ∫⁻ x, ENNReal.ofReal (‖lpDelta 0 ((expo 0 : ℤ) * j + kn) g x‖ ^ q) :=
        Finset.sum_le_sum fun j _ => hterm _
    _ = ENNReal.ofReal (CM.toReal ^ 2) * ∑ m ∈ (Finset.Icc (-(J : ℤ)) J).image
          (fun j => (expo 0 : ℤ) * j + kn), ∫⁻ x, ENNReal.ofReal (‖lpDelta 0 m g x‖ ^ q) := by
        rw [Finset.sum_image hinj, Finset.mul_sum]
    _ ≤ ENNReal.ofReal (CM.toReal ^ 2) * (ENNReal.ofReal A0 * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ q)) := by
        gcongr; exact hS _ g
    _ = _ := by rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]

/-- **The `L^2`-slot integral**: `∫ (∑_{|j| ≤ J} B_j(Δ^{(n)}_{(n+1)j+k_n} g))^{q/2} ≲ ‖g‖_q^q`, `q > 2`. -/
theorem lintegral_curveAvg_slot_le (n : Fin 3) {q : ℝ} (hq : 2 < q) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ (kn : ℤ) (J : ℕ) (g : 𝓢(E3, ℂ)),
      ∫⁻ x, (∑ j ∈ Finset.Icc (-(J : ℤ)) J,
          curveAvg n j (lpDelta n ((expo n : ℤ) * j + kn) g) x) ^ (q / 2)
        ≤ ENNReal.ofReal A * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ q) := by
  obtain ⟨C, hC0, hC⟩ := lintegral_sum_curveAvg_rpow_le n (ρ := q / 2) (by linarith)
  obtain ⟨A1, hA1, hLP⟩ := partial_littlewoodPaley n (q := q) (by linarith)
  refine ⟨C * A1, by positivity, fun kn J g => ?_⟩
  have hinj : Set.InjOn (fun j : ℤ => (expo n : ℤ) * j + kn) (Finset.Icc (-(J : ℤ)) J) := by
    intro a _ b _ h
    have : (expo n : ℤ) * a = (expo n : ℤ) * b := by simpa using h
    exact mul_left_cancel₀ (by exact_mod_cast (expo_pos n).ne') this
  have h1 := hC (Finset.Icc (-(J : ℤ)) J) fun j => lpDelta n ((expo n : ℤ) * j + kn) g
  have h2 := hLP ((Finset.Icc (-(J : ℤ)) J).image fun j => (expo n : ℤ) * j + kn) g
  simp only [Finset.sum_image hinj] at h2
  refine h1.trans ?_
  rw [ENNReal.ofReal_mul hC0, mul_assoc]
  gcongr
  refine le_of_eq_of_le ?_ h2
  refine lintegral_congr fun x => ?_
  rw [← ENNReal.ofReal_rpow_of_nonneg (Finset.sum_nonneg fun j _ => sq_nonneg _) (by positivity),
    ENNReal.ofReal_sum_of_nonneg fun j _ => sq_nonneg _]
  congr 1
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by norm_num)]
  norm_cast

/-- `(∫ |g|^q)^{1/q} = ‖g‖_q`. -/
theorem lintegral_ofReal_norm_rpow_rpow_inv (g : 𝓢(E3, ℂ)) {q : ℝ} (hq : 0 < q) :
    (∫⁻ x, ENNReal.ofReal (‖g x‖ ^ q)) ^ (1 / q) = eLpNorm g (ENNReal.ofReal q) volume := by
  rw [lintegral_ofReal_norm_rpow_eq g hq, ← ENNReal.rpow_mul, mul_one_div_cancel hq.ne',
    ENNReal.rpow_one]

theorem one_add_zpow_le {a b : ℤ} (hab : a ≤ b) (hb : 0 ≤ b) :
    1 + (2 : ℝ) ^ (a + 1) ≤ (2 : ℝ) ^ (b + 2) := by
  have h1 : (2 : ℝ) ^ (a + 1) ≤ 2 ^ (b + 1) := zpow_le_zpow_right₀ (by norm_num) (by omega)
  have h2 : (1 : ℝ) ≤ 2 ^ (b + 1) := one_le_zpow₀ (by norm_num) (by omega)
  have h3 : (2 : ℝ) ^ (b + 2) = 2 * 2 ^ (b + 1) := by
    rw [show b + 2 = 1 + (b + 1) by ring, zpow_add₀ two_ne_zero, zpow_one]
  linarith

/-- **The small-loss bound** (alternative route, line 456): for `q ≥ 3` and `k ∈ F_H`,
`‖T^{(k)}_J(f)‖_{q/3} ≤ C 2^{20 (k^{(1)} + 2)/q} ∏ ‖f_n‖_q`, uniformly in `J`. -/
theorem smallLoss_bound {q : ℝ} (hq : 3 ≤ q) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ k : Fin 3 → ℤ, 0 < kMax k → ∀ (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)),
      eLpNorm (kComp k J f) (ENNReal.ofReal (q / 3)) volume
        ≤ ENNReal.ofReal (C * (2 : ℝ) ^ (20 * ((kMax k : ℝ) + 2) / q)) *
          ∏ n, eLpNorm (f n) (ENNReal.ofReal q) volume := by
  have hq0 : 0 < q := by linarith
  have hq2 : 2 < q := by linarith
  have hs : 1 < q / 2 := by linarith
  obtain ⟨C0, hC00, hC0⟩ := enorm_kComp_le hs
  obtain ⟨A0, hA00, hA0⟩ := sum_lintegral_maximal_slot_le hq2
  obtain ⟨A1, hA10, hA1⟩ := lintegral_curveAvg_slot_le 1 hq2
  obtain ⟨A2, hA20, hA2⟩ := lintegral_curveAvg_slot_le 2 hq2
  refine ⟨C0 * (A0 * A1 * A2) ^ (1 / q), by positivity, fun k hk J f => ?_⟩
  set Sj := Finset.Icc (-(J : ℤ)) J
  set c : ℝ := C0 * (1 + (2 : ℝ) ^ (k 0 + 1)) ^ (10 / (q / 2)) with hc
  have hc0 : 0 ≤ c := by positivity
  set M : ℤ → E3 → ℝ := fun j => Twisted.coordinateDyadicBallMaximal 0
    (fun y => ((‖kDelta k f 0 j y‖ ^ (q / 2) : ℝ) : ℂ)) with hM
  have hMm : ∀ j, Measurable (M j) := fun j => Twisted.coordinateDyadicBallMaximal_measurable 0 _
    (Complex.continuous_ofReal.measurable.comp ((kDelta k f 0 j).continuous.norm.measurable.pow_const _))
  set A : E3 → ℝ≥0∞ := fun x =>
    (∑ j ∈ Sj, (ENNReal.ofReal c * ENNReal.ofReal (M j x) ^ (1 / (q / 2))) ^ q) ^ (1 / q) with hA
  set P : E3 → ℝ≥0∞ := fun x => (∑ j ∈ Sj, curveAvg 1 j (kDelta k f 1 j) x) ^ (1 / 2 : ℝ) with hP
  set Q : E3 → ℝ≥0∞ := fun x => (∑ j ∈ Sj, curveAvg 2 j (kDelta k f 2 j) x) ^ (1 / 2 : ℝ) with hQ
  have hAm : Measurable A := (Finset.measurable_sum _ fun j _ =>
    (measurable_const.mul ((ENNReal.measurable_ofReal.comp (hMm j)).pow_const _)).pow_const _).pow_const _
  have hPm : Measurable P := (Finset.measurable_sum _ fun j _ =>
    measurable_curveAvg 1 j (kDelta k f 1 j).continuous.measurable).pow_const _
  have hQm : Measurable Q := (Finset.measurable_sum _ fun j _ =>
    measurable_curveAvg 2 j (kDelta k f 2 j).continuous.measurable).pow_const _
  have hpt : ∀ x, ‖kComp k J f x‖ₑ ≤ A x * (P x * Q x) := fun x => hC0 k J f x q hq0
  -- the three integrals
  have hIA : ∫⁻ x, A x ^ q ≤ ENNReal.ofReal c ^ q *
      (ENNReal.ofReal A0 * ∫⁻ x, ENNReal.ofReal (‖f 0 x‖ ^ q)) := by
    have e : ∀ x, A x ^ q = ENNReal.ofReal c ^ q * ∑ j ∈ Sj, ENNReal.ofReal (M j x) ^ (2 : ℝ) := by
      intro x
      rw [hA, ← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne', ENNReal.rpow_one, Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← ENNReal.rpow_mul]
      congr 2; field_simp
    simp_rw [e]
    rw [lintegral_const_mul' _ _ (ENNReal.rpow_ne_top_of_nonneg hq0.le ENNReal.ofReal_ne_top),
      lintegral_finsetSum (f := fun j x => ENNReal.ofReal (M j x) ^ (2 : ℝ)) _
        fun j _ => (ENNReal.measurable_ofReal.comp (hMm j)).pow_const _]
    gcongr
    exact hA0 (k 0) J (f 0)
  have hIP : ∫⁻ x, P x ^ q ≤ ENNReal.ofReal A1 * ∫⁻ x, ENNReal.ofReal (‖f 1 x‖ ^ q) := by
    refine le_of_eq_of_le (lintegral_congr fun x => ?_) (hA1 (k 1) J (f 1))
    rw [hP, ← ENNReal.rpow_mul]; congr 1; ring
  have hIQ : ∫⁻ x, Q x ^ q ≤ ENNReal.ofReal A2 * ∫⁻ x, ENNReal.ofReal (‖f 2 x‖ ^ q) := by
    refine le_of_eq_of_le (lintegral_congr fun x => ?_) (hA2 (k 2) J (f 2))
    rw [hQ, ← ENNReal.rpow_mul]; congr 1; ring
  -- Hölder in `x`
  have hH1 := ENNReal.lintegral_Lp_mul_le_Lq_mul_Lr (p := q / 3) (q := q) (r := q / 2)
    (by positivity) (by linarith) (by field_simp; norm_num) volume hAm.aemeasurable
    (hPm.mul hQm).aemeasurable
  have hH2 := ENNReal.lintegral_Lp_mul_le_Lq_mul_Lr (p := q / 2) (q := q) (r := q)
    (by positivity) (by linarith) (by field_simp; norm_num) volume hPm.aemeasurable hQm.aemeasurable
  have hr0 : 0 < q / 3 := by positivity
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hr0) ENNReal.ofReal_ne_top,
    ENNReal.toReal_ofReal hr0.le]
  set N : Fin 3 → ℝ≥0∞ := fun n => eLpNorm (f n) (ENNReal.ofReal q) volume with hN
  have hNint : ∀ n, (∫⁻ x, ENNReal.ofReal (‖f n x‖ ^ q)) = N n ^ q := fun n =>
    lintegral_ofReal_norm_rpow_eq (f n) hq0
  calc (∫⁻ x, ‖kComp k J f x‖ₑ ^ (q / 3)) ^ (1 / (q / 3))
      ≤ (∫⁻ x, (A x * (P x * Q x)) ^ (q / 3)) ^ (1 / (q / 3)) := by
        gcongr with x; exact hpt x
    _ ≤ (∫⁻ x, A x ^ q) ^ (1 / q) * ((∫⁻ x, P x ^ q) ^ (1 / q) * (∫⁻ x, Q x ^ q) ^ (1 / q)) := by
        refine hH1.trans ?_
        gcongr
    _ ≤ (ENNReal.ofReal c ^ q * (ENNReal.ofReal A0 * N 0 ^ q)) ^ (1 / q) *
          ((ENNReal.ofReal A1 * N 1 ^ q) ^ (1 / q) * (ENNReal.ofReal A2 * N 2 ^ q) ^ (1 / q)) := by
        rw [← hNint 0, ← hNint 1, ← hNint 2]
        gcongr
    _ = ENNReal.ofReal c * ENNReal.ofReal ((A0 * A1 * A2) ^ (1 / q)) * (N 0 * (N 1 * N 2)) := by
        have hq' : (0 : ℝ) ≤ 1 / q := by positivity
        simp only [ENNReal.mul_rpow_of_nonneg _ _ hq', ← ENNReal.rpow_mul,
          mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
        rw [Real.mul_rpow (by positivity) hA20, Real.mul_rpow hA00 hA10,
          ENNReal.ofReal_mul (p := A0 ^ (1 / q) * A1 ^ (1 / q)) (by positivity),
          ENNReal.ofReal_mul (p := A0 ^ (1 / q)) (by positivity),
          ← ENNReal.ofReal_rpow_of_nonneg hA00 hq', ← ENNReal.ofReal_rpow_of_nonneg hA10 hq',
          ← ENNReal.ofReal_rpow_of_nonneg hA20 hq']
        ring
    _ ≤ ENNReal.ofReal (C0 * (A0 * A1 * A2) ^ (1 / q) * (2 : ℝ) ^ (20 * ((kMax k : ℝ) + 2) / q)) *
          ∏ n, N n := by
        rw [Fin.prod_univ_three, ← ENNReal.ofReal_mul hc0, mul_assoc (N 0)]
        refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
        rw [hc, show C0 * (A0 * A1 * A2) ^ (1 / q) * (2 : ℝ) ^ (20 * ((kMax k : ℝ) + 2) / q)
          = C0 * (2 : ℝ) ^ (20 * ((kMax k : ℝ) + 2) / q) * (A0 * A1 * A2) ^ (1 / q) by ring]
        refine mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left ?_ hC00) (by positivity)
        have hk0 : k 0 ≤ kMax k := by simp only [kMax]; omega
        have hkm : 0 ≤ kMax k := by omega
        calc (1 + (2 : ℝ) ^ (k 0 + 1)) ^ (10 / (q / 2)) ≤ ((2 : ℝ) ^ (kMax k + 2)) ^ (10 / (q / 2)) :=
              Real.rpow_le_rpow (by positivity) (one_add_zpow_le hk0 hkm) (by positivity)
          _ = (2 : ℝ) ^ (20 * ((kMax k : ℝ) + 2) / q) := by
              rw [← Real.rpow_intCast, ← Real.rpow_mul (by norm_num)]
              congr 1; push_cast; field_simp; ring

theorem rpow_one_div_mul_self {a : ℝ≥0∞} {q : ℝ} (hq : 0 < q) (b : ℝ≥0∞) :
    (b * a ^ q) ^ (1 / q) = b ^ (1 / q) * a := by
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
    mul_one_div_cancel hq.ne', ENNReal.rpow_one]

/-- **The small-loss bound, general exponents**: for `q, q_1, q_2 > 2`,
`1/r = 1/q + 1/q_1 + 1/q_2` and `k ∈ F_H`:
`‖T^{(k)}_J(f)‖_r ≤ C 2^{20 (k^{(1)} + 2)/q} ‖f_0‖_q ‖f_1‖_{q_1} ‖f_2‖_{q_2}`, uniformly in `J`. -/
theorem smallLoss_bound' {q q1 q2 r : ℝ} (hq : 2 < q) (hq1 : 2 < q1) (hq2 : 2 < q2)
    (hr : 1 / r = 1 / q + 1 / q1 + 1 / q2) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ k : Fin 3 → ℤ, 0 < kMax k → ∀ (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)),
      eLpNorm (kComp k J f) (ENNReal.ofReal r) volume
        ≤ ENNReal.ofReal (C * (2 : ℝ) ^ (20 * ((kMax k : ℝ) + 2) / q)) *
          (eLpNorm (f 0) (ENNReal.ofReal q) volume * (eLpNorm (f 1) (ENNReal.ofReal q1) volume *
            eLpNorm (f 2) (ENNReal.ofReal q2) volume)) := by
  have hq0 : 0 < q := by linarith
  have hq10 : 0 < q1 := by linarith
  have hq20 : 0 < q2 := by linarith
  have hr0 : 0 < r := by
    have : 0 < 1 / r := by rw [hr]; positivity
    exact one_div_pos.mp this
  set r' : ℝ := 1 / (1 / q1 + 1 / q2) with hr'
  have hr'0 : 0 < r' := by positivity
  have hrr' : 1 / r = 1 / q + 1 / r' := by rw [hr, hr', one_div_one_div]; ring
  have hs : 1 < q / 2 := by linarith
  obtain ⟨C0, hC00, hC0⟩ := enorm_kComp_le hs
  obtain ⟨A0, hA00, hA0⟩ := sum_lintegral_maximal_slot_le hq
  obtain ⟨A1, hA10, hA1⟩ := lintegral_curveAvg_slot_le 1 hq1
  obtain ⟨A2, hA20, hA2⟩ := lintegral_curveAvg_slot_le 2 hq2
  refine ⟨C0 * (A0 ^ (1 / q) * (A1 ^ (1 / q1) * A2 ^ (1 / q2))), by positivity, fun k hk J f => ?_⟩
  set Sj := Finset.Icc (-(J : ℤ)) J
  set c : ℝ := C0 * (1 + (2 : ℝ) ^ (k 0 + 1)) ^ (10 / (q / 2)) with hc
  have hc0 : 0 ≤ c := by positivity
  set M : ℤ → E3 → ℝ := fun j => Twisted.coordinateDyadicBallMaximal 0
    (fun y => ((‖kDelta k f 0 j y‖ ^ (q / 2) : ℝ) : ℂ)) with hM
  have hMm : ∀ j, Measurable (M j) := fun j => Twisted.coordinateDyadicBallMaximal_measurable 0 _
    (Complex.continuous_ofReal.measurable.comp ((kDelta k f 0 j).continuous.norm.measurable.pow_const _))
  set A : E3 → ℝ≥0∞ := fun x =>
    (∑ j ∈ Sj, (ENNReal.ofReal c * ENNReal.ofReal (M j x) ^ (1 / (q / 2))) ^ q) ^ (1 / q) with hA
  set P : E3 → ℝ≥0∞ := fun x => (∑ j ∈ Sj, curveAvg 1 j (kDelta k f 1 j) x) ^ (1 / 2 : ℝ) with hP
  set Q : E3 → ℝ≥0∞ := fun x => (∑ j ∈ Sj, curveAvg 2 j (kDelta k f 2 j) x) ^ (1 / 2 : ℝ) with hQ
  have hAm : Measurable A := (Finset.measurable_sum _ fun j _ =>
    (measurable_const.mul ((ENNReal.measurable_ofReal.comp (hMm j)).pow_const _)).pow_const _).pow_const _
  have hPm : Measurable P := (Finset.measurable_sum _ fun j _ =>
    measurable_curveAvg 1 j (kDelta k f 1 j).continuous.measurable).pow_const _
  have hQm : Measurable Q := (Finset.measurable_sum _ fun j _ =>
    measurable_curveAvg 2 j (kDelta k f 2 j).continuous.measurable).pow_const _
  have hpt : ∀ x, ‖kComp k J f x‖ₑ ≤ A x * (P x * Q x) := fun x => hC0 k J f x q hq0
  set N0 := eLpNorm (f 0) (ENNReal.ofReal q) volume
  set N1 := eLpNorm (f 1) (ENNReal.ofReal q1) volume
  set N2 := eLpNorm (f 2) (ENNReal.ofReal q2) volume
  -- the three integrals
  have hIA : ∫⁻ x, A x ^ q ≤ ENNReal.ofReal c ^ q * (ENNReal.ofReal A0 * N0 ^ q) := by
    have e : ∀ x, A x ^ q = ENNReal.ofReal c ^ q * ∑ j ∈ Sj, ENNReal.ofReal (M j x) ^ (2 : ℝ) := by
      intro x
      rw [hA, ← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne', ENNReal.rpow_one, Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← ENNReal.rpow_mul]
      congr 2; field_simp
    simp_rw [e]
    rw [lintegral_const_mul' _ _ (ENNReal.rpow_ne_top_of_nonneg hq0.le ENNReal.ofReal_ne_top),
      lintegral_finsetSum (f := fun j x => ENNReal.ofReal (M j x) ^ (2 : ℝ)) _
        fun j _ => (ENNReal.measurable_ofReal.comp (hMm j)).pow_const _,
      ← lintegral_ofReal_norm_rpow_eq (f 0) hq0]
    gcongr
    exact hA0 (k 0) J (f 0)
  have hIP : ∫⁻ x, P x ^ q1 ≤ ENNReal.ofReal A1 * N1 ^ q1 := by
    rw [← lintegral_ofReal_norm_rpow_eq (f 1) hq10]
    refine le_of_eq_of_le (lintegral_congr fun x => ?_) (hA1 (k 1) J (f 1))
    rw [hP, ← ENNReal.rpow_mul]; congr 1; ring
  have hIQ : ∫⁻ x, Q x ^ q2 ≤ ENNReal.ofReal A2 * N2 ^ q2 := by
    rw [← lintegral_ofReal_norm_rpow_eq (f 2) hq20]
    refine le_of_eq_of_le (lintegral_congr fun x => ?_) (hA2 (k 2) J (f 2))
    rw [hQ, ← ENNReal.rpow_mul]; congr 1; ring
  -- Hölder in `x`
  have hrq : r < q := by
    have h0 : 0 < 1 / r' := by positivity
    have h1 : 1 / q < 1 / r := by rw [hrr']; linarith
    exact (one_div_lt_one_div hq0 hr0).mp h1
  have hr'q1 : r' < q1 := by
    have h0 : 0 < 1 / q2 := by positivity
    have h1 : 1 / q1 < 1 / q1 + 1 / q2 := by linarith
    rw [hr', one_div_lt (by positivity) hq10]; exact h1
  have hH1 := ENNReal.lintegral_Lp_mul_le_Lq_mul_Lr (p := r) (q := q) (r := r')
    hr0 hrq hrr' volume hAm.aemeasurable (hPm.mul hQm).aemeasurable
  have hH2 := ENNReal.lintegral_Lp_mul_le_Lq_mul_Lr (p := r') (q := q1) (r := q2)
    hr'0 hr'q1 (by rw [hr', one_div_one_div]) volume hPm.aemeasurable hQm.aemeasurable
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hr0) ENNReal.ofReal_ne_top,
    ENNReal.toReal_ofReal hr0.le]
  calc (∫⁻ x, ‖kComp k J f x‖ₑ ^ r) ^ (1 / r)
      ≤ (∫⁻ x, (A x * (P x * Q x)) ^ r) ^ (1 / r) := by
        gcongr with x; exact hpt x
    _ ≤ (∫⁻ x, A x ^ q) ^ (1 / q) * ((∫⁻ x, P x ^ q1) ^ (1 / q1) * (∫⁻ x, Q x ^ q2) ^ (1 / q2)) := by
        refine hH1.trans ?_
        gcongr
    _ ≤ (ENNReal.ofReal c ^ q * (ENNReal.ofReal A0 * N0 ^ q)) ^ (1 / q) *
          ((ENNReal.ofReal A1 * N1 ^ q1) ^ (1 / q1) * (ENNReal.ofReal A2 * N2 ^ q2) ^ (1 / q2)) := by
        gcongr
    _ = ENNReal.ofReal c * (ENNReal.ofReal (A0 ^ (1 / q)) *
          (ENNReal.ofReal (A1 ^ (1 / q1)) * ENNReal.ofReal (A2 ^ (1 / q2)))) * (N0 * (N1 * N2)) := by
        have e0 : (ENNReal.ofReal c ^ q * (ENNReal.ofReal A0 * N0 ^ q)) ^ (1 / q)
            = ENNReal.ofReal c * (ENNReal.ofReal A0 ^ (1 / q) * N0) := by
          rw [← mul_assoc, rpow_one_div_mul_self hq0, ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
            ← ENNReal.rpow_mul, mul_one_div_cancel hq0.ne', ENNReal.rpow_one, mul_assoc]
        rw [e0, rpow_one_div_mul_self hq10, rpow_one_div_mul_self hq20,
          ENNReal.ofReal_rpow_of_nonneg hA00 (by positivity),
          ENNReal.ofReal_rpow_of_nonneg hA10 (by positivity),
          ENNReal.ofReal_rpow_of_nonneg hA20 (by positivity)]
        ring
    _ ≤ ENNReal.ofReal (C0 * (A0 ^ (1 / q) * (A1 ^ (1 / q1) * A2 ^ (1 / q2))) *
          (2 : ℝ) ^ (20 * ((kMax k : ℝ) + 2) / q)) * (N0 * (N1 * N2)) := by
        rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_mul (by positivity)]
        refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
        rw [hc, show C0 * (A0 ^ (1 / q) * (A1 ^ (1 / q1) * A2 ^ (1 / q2))) *
            (2 : ℝ) ^ (20 * ((kMax k : ℝ) + 2) / q)
          = C0 * (2 : ℝ) ^ (20 * ((kMax k : ℝ) + 2) / q) *
            (A0 ^ (1 / q) * (A1 ^ (1 / q1) * A2 ^ (1 / q2))) by ring]
        refine mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left ?_ hC00) (by positivity)
        have hk0 : k 0 ≤ kMax k := by simp only [kMax]; omega
        have hkm : 0 ≤ kMax k := by omega
        calc (1 + (2 : ℝ) ^ (k 0 + 1)) ^ (10 / (q / 2)) ≤ ((2 : ℝ) ^ (kMax k + 2)) ^ (10 / (q / 2)) :=
              Real.rpow_le_rpow (by positivity) (one_add_zpow_le hk0 hkm) (by positivity)
          _ = (2 : ℝ) ^ (20 * ((kMax k : ℝ) + 2) / q) := by
              rw [← Real.rpow_intCast, ← Real.rpow_mul (by norm_num)]
              congr 1; push_cast; field_simp; ring

/-! ### Slot-0 extension of `T^{(k)}_J` to general inputs (for interpolation, line 456) -/

/-- Jensen: `(∫ w F)^r ≤ (∫ w)^{r-1} ∫ w F^r`, `r ≥ 1`. -/
theorem lintegral_mul_rpow_le {β : Type*} [MeasurableSpace β] (ν : Measure β) {w F : β → ℝ≥0∞}
    (hw : Measurable w) (hF : Measurable F) {r : ℝ} (hr : 1 ≤ r) :
    (∫⁻ t, w t * F t ∂ν) ^ r ≤ (∫⁻ t, w t ∂ν) ^ (r - 1) * ∫⁻ t, w t * F t ^ r ∂ν := by
  rcases hr.eq_or_lt with h | h
  · subst h; simp
  set r' := r.conjExponent
  have hhol : r'.HolderConjugate r := (Real.HolderConjugate.conjExponent h).symm
  have hr0 : 0 < r := by linarith
  have hr'0 : 0 < r' := hhol.pos
  have hH := ENNReal.lintegral_mul_le_Lp_mul_Lq ν hhol (f := fun t => w t ^ (1 / r'))
    (g := fun t => w t ^ (1 / r) * F t) (hw.pow_const _).aemeasurable
    ((hw.pow_const _).mul hF).aemeasurable
  have e1 : ∀ t, w t * F t = w t ^ (1 / r') * (w t ^ (1 / r) * F t) := by
    intro t
    have hsum : 1 / r' + 1 / r = 1 := by rw [one_div, one_div]; exact hhol.inv_add_inv_eq_one
    rw [← mul_assoc, ← ENNReal.rpow_add_of_nonneg _ _ (by positivity) (by positivity), hsum,
      ENNReal.rpow_one]
  have e2 : ∀ t, (w t ^ (1 / r')) ^ r' = w t := fun t => by
    rw [← ENNReal.rpow_mul, one_div_mul_cancel hr'0.ne', ENNReal.rpow_one]
  have e3 : ∀ t, (w t ^ (1 / r) * F t) ^ r = w t * F t ^ r := fun t => by
    rw [ENNReal.mul_rpow_of_nonneg _ _ hr0.le, ← ENNReal.rpow_mul, one_div_mul_cancel hr0.ne',
      ENNReal.rpow_one]
  simp only [Pi.mul_apply, e2, e3] at hH
  simp_rw [e1]
  calc (∫⁻ t, w t ^ (1 / r') * (w t ^ (1 / r) * F t) ∂ν) ^ r
      ≤ ((∫⁻ t, w t ∂ν) ^ (1 / r') * (∫⁻ t, w t * F t ^ r ∂ν) ^ (1 / r)) ^ r :=
        ENNReal.rpow_le_rpow hH hr0.le
    _ = (∫⁻ t, w t ∂ν) ^ (r - 1) * ∫⁻ t, w t * F t ^ r ∂ν := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hr0.le, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
          one_div_mul_cancel hr0.ne', ENNReal.rpow_one]
        congr 2
        have h1 : 1 / r' = 1 - 1 / r := by
          have := hhol.inv_add_inv_eq_one; rw [one_div, one_div]; linarith
        rw [h1]; field_simp

/-- **Minkowski's integral inequality** in the form used here (Jensen and Tonelli):
`∫_x (∫_t w(t) F(x,t) dt)^r dx ≤ (∫ w)^{r-1} ∫_t w(t) ∫_x F(x,t)^r dx dt`, `r ≥ 1`. -/
theorem lintegral_rpow_lintegral_le {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]
    (μ : Measure α) (ν : Measure β) [SFinite μ] [SFinite ν] {w : β → ℝ≥0∞} (hw : Measurable w)
    {F : α → β → ℝ≥0∞} (hF : Measurable (Function.uncurry F)) {r : ℝ} (hr : 1 ≤ r) :
    ∫⁻ x, (∫⁻ t, w t * F x t ∂ν) ^ r ∂μ
      ≤ (∫⁻ t, w t ∂ν) ^ (r - 1) * ∫⁻ t, w t * ∫⁻ x, F x t ^ r ∂μ ∂ν := by
  have hr0 : 0 < r := by linarith
  have hFx : ∀ x, Measurable (F x) := fun x => hF.comp measurable_prodMk_left
  calc ∫⁻ x, (∫⁻ t, w t * F x t ∂ν) ^ r ∂μ
      ≤ ∫⁻ x, (∫⁻ t, w t ∂ν) ^ (r - 1) * ∫⁻ t, w t * F x t ^ r ∂ν ∂μ :=
        lintegral_mono fun x => lintegral_mul_rpow_le ν hw (hFx x) hr
    _ = (∫⁻ t, w t ∂ν) ^ (r - 1) * ∫⁻ x, ∫⁻ t, w t * F x t ^ r ∂ν ∂μ := by
        rw [lintegral_const_mul]
        exact (hw.comp measurable_snd |>.mul (hF.pow_const r)).lintegral_prod_right'
    _ = (∫⁻ t, w t ∂ν) ^ (r - 1) * ∫⁻ t, ∫⁻ x, w t * F x t ^ r ∂μ ∂ν := by
        rw [lintegral_lintegral_swap ((hw.comp measurable_snd).mul (hF.pow_const r)).aemeasurable]
    _ = _ := by
        congr 1
        refine lintegral_congr fun t => ?_
        exact lintegral_const_mul (w t) (f := fun x => F x t ^ r)
          ((hF.comp (measurable_id.prodMk measurable_const)).pow_const r)

/-- `Δ^{(ℓ)}_m` on general inputs, as the line convolution `∫ ψ̌_m(u) g(y - u e_ℓ) du`. -/
def lineDelta (ℓ : Fin 3) (m : ℤ) (g : E3 → ℂ) (y : E3) : ℂ :=
  ∫ u : ℝ, (psiCM m).check u * g (y - u • basisVec ℓ)

theorem lineDelta_schwartz (ℓ : Fin 3) (m : ℤ) (g : 𝓢(E3, ℂ)) :
    lineDelta ℓ m g = lpDelta ℓ m g := by
  funext y; rw [lineDelta, ← psiCM_op, CoordMult.op_eq_lineConv]

theorem measurable_lineShift (ℓ : Fin 3) : Measurable fun p : E3 × ℝ => p.1 - p.2 • basisVec ℓ :=
  measurable_fst.sub (measurable_snd.smul_const _)

theorem measurable_lineDelta (ℓ : Fin 3) (m : ℤ) {g : E3 → ℂ} (hg : Measurable g) :
    Measurable (lineDelta ℓ m g) := by
  have h : StronglyMeasurable (Function.uncurry fun (y : E3) (u : ℝ) =>
      (psiCM m).check u * g (y - u • basisVec ℓ)) :=
    (((psiCM m).check.continuous.measurable.comp measurable_snd).mul
      (hg.comp (measurable_lineShift ℓ))).stronglyMeasurable
  exact h.integral_prod_right'.measurable

theorem enorm_lineDelta_le (ℓ : Fin 3) (m : ℤ) (g : E3 → ℂ) (y : E3) :
    ‖lineDelta ℓ m g y‖ₑ ≤ ∫⁻ u, ‖(psiCM m).check u‖ₑ * ‖g (y - u • basisVec ℓ)‖ₑ := by
  refine (enorm_integral_le_lintegral_enorm _).trans (le_of_eq ?_)
  refine lintegral_congr fun u => ?_
  rw [enorm_mul]

/-- **Young's inequality** for the line convolution: `‖Δ^{(ℓ)}_m g‖_P ≤ ‖ψ̌_m‖_1 ‖g‖_P`, `P ≥ 1`. -/
theorem eLpNorm_lineDelta_le (ℓ : Fin 3) (m : ℤ) {g : E3 → ℂ} (hg : Measurable g) {P : ℝ}
    (hP : 1 ≤ P) :
    eLpNorm (lineDelta ℓ m g) (ENNReal.ofReal P) volume
      ≤ (∫⁻ u, ‖(psiCM m).check u‖ₑ) * eLpNorm g (ENNReal.ofReal P) volume := by
  have hP0 : 0 < P := by linarith
  set W := ∫⁻ u, ‖(psiCM m).check u‖ₑ with hW
  have hwm : Measurable fun u : ℝ => ‖(psiCM m).check u‖ₑ := (psiCM m).check.continuous.measurable.enorm
  have hF : Measurable (Function.uncurry fun (y : E3) (u : ℝ) => ‖g (y - u • basisVec ℓ)‖ₑ) :=
    (hg.comp (measurable_lineShift ℓ)).enorm
  have hMJ := lintegral_rpow_lintegral_le volume volume hwm hF hP
  have htr : ∀ u : ℝ, ∫⁻ y, ‖g (y - u • basisVec ℓ)‖ₑ ^ P = ∫⁻ y, ‖g y‖ₑ ^ P := fun u =>
    lintegral_sub_right_eq_self (fun y => ‖g y‖ₑ ^ P) (u • basisVec ℓ)
  simp only [htr] at hMJ
  rw [lintegral_mul_const _ hwm] at hMJ
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hP0) ENNReal.ofReal_ne_top,
    eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hP0) ENNReal.ofReal_ne_top,
    ENNReal.toReal_ofReal hP0.le]
  calc (∫⁻ y, ‖lineDelta ℓ m g y‖ₑ ^ P) ^ (1 / P)
      ≤ (∫⁻ y, (∫⁻ u, ‖(psiCM m).check u‖ₑ * ‖g (y - u • basisVec ℓ)‖ₑ) ^ P) ^ (1 / P) := by
        gcongr with y; exact enorm_lineDelta_le ℓ m g y
    _ ≤ (W ^ (P - 1) * (W * ∫⁻ y, ‖g y‖ₑ ^ P)) ^ (1 / P) := by gcongr
    _ = W * (∫⁻ y, ‖g y‖ₑ ^ P) ^ (1 / P) := by
        have eW : W ^ (P - 1) * W = W ^ P := by
          rw [show W ^ (P - 1) * W = W ^ (P - 1) * W ^ (1 : ℝ) by rw [ENNReal.rpow_one],
            ← ENNReal.rpow_add_of_nonneg _ _ (by linarith) zero_le_one, show P - 1 + 1 = P by ring]
        rw [← mul_assoc, eW, ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
          ← ENNReal.rpow_mul, mul_one_div_cancel hP0.ne', ENNReal.rpow_one]

/-- Three-factor Hölder for `lintegral`s. -/
theorem lintegral_mul3_rpow_le {α : Type*} [MeasurableSpace α] (μ : Measure α) {f g h : α → ℝ≥0∞}
    (hf : AEMeasurable f μ) (hg : AEMeasurable g μ) (hh : AEMeasurable h μ) {r P0 P1 P2 : ℝ}
    (hP0 : 0 < P0) (hP1 : 0 < P1) (hP2 : 0 < P2) (hr : 1 / r = 1 / P0 + 1 / P1 + 1 / P2) :
    (∫⁻ x, (f x * (g x * h x)) ^ r ∂μ) ^ (1 / r)
      ≤ (∫⁻ x, f x ^ P0 ∂μ) ^ (1 / P0) * ((∫⁻ x, g x ^ P1 ∂μ) ^ (1 / P1) *
          (∫⁻ x, h x ^ P2 ∂μ) ^ (1 / P2)) := by
  have hr0 : 0 < r := by
    have : 0 < 1 / r := by rw [hr]; positivity
    exact one_div_pos.mp this
  set r' : ℝ := 1 / (1 / P1 + 1 / P2) with hr'
  have hr'0 : 0 < r' := by positivity
  have hrr' : 1 / r = 1 / P0 + 1 / r' := by rw [hr, hr', one_div_one_div]; ring
  have hrq : r < P0 := by
    have h0 : 0 < 1 / r' := by positivity
    have h1 : 1 / P0 < 1 / r := by rw [hrr']; linarith
    exact (one_div_lt_one_div hP0 hr0).mp h1
  have hr'q1 : r' < P1 := by
    have h0 : 0 < 1 / P2 := by positivity
    have h1 : 1 / P1 < 1 / P1 + 1 / P2 := by linarith
    rw [hr', one_div_lt (by positivity) hP1]; exact h1
  have hH1 := ENNReal.lintegral_Lp_mul_le_Lq_mul_Lr (p := r) (q := P0) (r := r')
    hr0 hrq hrr' μ hf (hg.mul hh)
  have hH2 := ENNReal.lintegral_Lp_mul_le_Lq_mul_Lr (p := r') (q := P1) (r := P2)
    hr'0 hr'q1 (by rw [hr', one_div_one_div]) μ hg hh
  exact hH1.trans (by gcongr)

theorem measurable_wJ_prod (j : ℤ) {h : Fin 3 → E3 → ℂ} (hh : ∀ n, Measurable (h n)) :
    Measurable (Function.uncurry fun (x : E3) (t : ℝ) =>
      ‖h 0 (x + curve 0 t)‖ₑ * (‖h 1 (x + curve 1 t)‖ₑ * ‖h 2 (x + curve 2 t)‖ₑ)) := by
  have hc : ∀ n, Measurable fun p : E3 × ℝ => p.1 + curve n p.2 := fun n =>
    measurable_fst.add ((continuous_curve n).measurable.comp measurable_snd)
  exact ((hh 0).comp (hc 0)).enorm.mul (((hh 1).comp (hc 1)).enorm.mul ((hh 2).comp (hc 2)).enorm)

/-- **The crude bound for `T_j`** (Minkowski and Hölder): for `1/r = ∑ 1/P_n`, `r ≥ 1`,
`‖T_j(h)‖_r ≤ ‖ψ(2^j ·)/·‖_1 ∏ ‖h_n‖_{P_n}`. -/
theorem eLpNorm_simplexTj_le (j : ℤ) {h : Fin 3 → E3 → ℂ} (hh : ∀ n, Measurable (h n))
    {r : ℝ} (hr1 : 1 ≤ r) {P : Fin 3 → ℝ} (hP : ∀ n, 0 < P n)
    (hsum : 1 / r = 1 / P 0 + 1 / P 1 + 1 / P 2) :
    eLpNorm (simplexTj j h) (ENNReal.ofReal r) volume
      ≤ (∫⁻ t, wJ j t) * (eLpNorm (h 0) (ENNReal.ofReal (P 0)) volume *
          (eLpNorm (h 1) (ENNReal.ofReal (P 1)) volume * eLpNorm (h 2) (ENNReal.ofReal (P 2)) volume)) := by
  have hr0 : 0 < r := by linarith
  set W := ∫⁻ t, wJ j t with hW
  set F : E3 → ℝ → ℝ≥0∞ := fun x t =>
    ‖h 0 (x + curve 0 t)‖ₑ * (‖h 1 (x + curve 1 t)‖ₑ * ‖h 2 (x + curve 2 t)‖ₑ) with hFdef
  have hF : Measurable (Function.uncurry F) := measurable_wJ_prod j hh
  have hpt : ∀ x, ‖simplexTj j h x‖ₑ ≤ ∫⁻ t, wJ j t * F x t := by
    intro x
    refine (enorm_integral_le_lintegral_enorm _).trans (le_of_eq (lintegral_congr fun t => ?_))
    rw [mul_div_right_comm, enorm_mul, prodShift, Fin.prod_univ_three, enorm_mul, enorm_mul,
      mul_assoc]; rfl
  have hMJ := lintegral_rpow_lintegral_le volume volume (measurable_wJ j) hF hr1
  set N : Fin 3 → ℝ≥0∞ := fun n => (∫⁻ y, ‖h n y‖ₑ ^ P n) ^ (1 / P n) with hN
  have hFt : ∀ t, ∫⁻ x, F x t ^ r ≤ (N 0 * (N 1 * N 2)) ^ r := by
    intro t
    have hc : ∀ n, ∫⁻ x, ‖h n (x + curve n t)‖ₑ ^ P n = ∫⁻ y, ‖h n y‖ₑ ^ P n := fun n =>
      lintegral_add_right_eq_self (fun y => ‖h n y‖ₑ ^ P n) (curve n t)
    have h3 := lintegral_mul3_rpow_le volume (f := fun x => ‖h 0 (x + curve 0 t)‖ₑ)
      (g := fun x => ‖h 1 (x + curve 1 t)‖ₑ) (h := fun x => ‖h 2 (x + curve 2 t)‖ₑ)
      (((hh 0).comp (measurable_id.add_const (curve 0 t))).enorm.aemeasurable)
      (((hh 1).comp (measurable_id.add_const (curve 1 t))).enorm.aemeasurable)
      (((hh 2).comp (measurable_id.add_const (curve 2 t))).enorm.aemeasurable)
      (hP 0) (hP 1) (hP 2) hsum
    rw [hc 0, hc 1, hc 2] at h3
    have h4 := ENNReal.rpow_le_rpow h3 hr0.le
    rwa [← ENNReal.rpow_mul, one_div_mul_cancel hr0.ne', ENNReal.rpow_one] at h4
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hr0) ENNReal.ofReal_ne_top,
    ENNReal.toReal_ofReal hr0.le]
  have hNe : ∀ n, eLpNorm (h n) (ENNReal.ofReal (P n)) volume = N n := fun n => by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hP n) ENNReal.ofReal_ne_top,
      ENNReal.toReal_ofReal (hP n).le]
  rw [hNe 0, hNe 1, hNe 2]
  calc (∫⁻ x, ‖simplexTj j h x‖ₑ ^ r) ^ (1 / r)
      ≤ (∫⁻ x, (∫⁻ t, wJ j t * F x t) ^ r) ^ (1 / r) := by gcongr with x; exact hpt x
    _ ≤ (W ^ (r - 1) * ∫⁻ t, wJ j t * (N 0 * (N 1 * N 2)) ^ r) ^ (1 / r) := by
        gcongr
        refine hMJ.trans ?_
        gcongr with t
        exact hFt t
    _ = W * (N 0 * (N 1 * N 2)) := by
        have eW : W ^ (r - 1) * W = W ^ r := by
          rw [show W ^ (r - 1) * W = W ^ (r - 1) * W ^ (1 : ℝ) by rw [ENNReal.rpow_one],
            ← ENNReal.rpow_add_of_nonneg _ _ (by linarith) zero_le_one, show r - 1 + 1 = r by ring]
        rw [lintegral_mul_const _ (measurable_wJ j), ← mul_assoc, eW,
          ← ENNReal.mul_rpow_of_nonneg _ _ hr0.le,
          ← ENNReal.rpow_mul, mul_one_div_cancel hr0.ne', ENNReal.rpow_one]

/-- `T^{(k)}_J` with a general function `g` in slot `0` and the Schwartz inputs `f_1, f_2`. -/
def kComp0 (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) (g : E3 → ℂ) (x : E3) : ℂ :=
  ∑ j ∈ Finset.Icc (-(J : ℤ)) J,
    simplexTj j ![lineDelta 0 ((expo 0 : ℤ) * j + k 0) g, ⇑(kDelta k f 1 j), ⇑(kDelta k f 2 j)] x

theorem kComp0_schwartz (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) (φ : 𝓢(E3, ℂ)) :
    kComp0 k J f φ = kComp k J (Function.update f 0 φ) := by
  funext x
  unfold kComp0 kComp
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [freqPiece_eq_kDelta]
  congr 1
  funext n
  fin_cases n
  · simp [kDelta, lineDelta_schwartz]
  · simp [kDelta]
  · simp [kDelta]

theorem kComp0_self (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) :
    kComp0 k J f (f 0) = kComp k J f := by
  rw [kComp0_schwartz, Function.update_eq_self]

theorem measurable_simplexTj (j : ℤ) {h : Fin 3 → E3 → ℂ} (hh : ∀ n, Measurable (h n)) :
    Measurable (simplexTj j h) := by
  have hc : ∀ n, Measurable fun p : E3 × ℝ => p.1 + curve n p.2 := fun n =>
    measurable_fst.add ((continuous_curve n).measurable.comp measurable_snd)
  have hjoint : StronglyMeasurable (Function.uncurry fun (x : E3) (t : ℝ) =>
      (lpPsi ((2 : ℝ) ^ j * t) : ℂ) * prodShift h x t / t) := by
    refine Measurable.stronglyMeasurable ?_
    refine ((Complex.continuous_ofReal.comp (continuous_lpPsi.comp
      (continuous_const.mul continuous_id))).measurable.comp measurable_snd |>.mul ?_).div
      (Complex.measurable_ofReal.comp measurable_snd)
    unfold prodShift
    exact Finset.measurable_prod _ fun n _ => (hh n).comp (hc n)
  exact hjoint.integral_prod_right'.measurable

theorem measurable_kComp0 (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) {g : E3 → ℂ}
    (hg : Measurable g) : Measurable (kComp0 k J f g) := by
  unfold kComp0
  refine Finset.measurable_sum _ fun j _ => measurable_simplexTj j fun n => ?_
  fin_cases n
  · exact measurable_lineDelta 0 _ hg
  · exact (kDelta k f 1 j).continuous.measurable
  · exact (kDelta k f 2 j).continuous.measurable

theorem integrable_lineDelta_integrand (ℓ : Fin 3) (m : ℤ) {g : E3 → ℂ} (hg : Measurable g)
    {B : ℝ} (hB : ∀ y, ‖g y‖ ≤ B) (y : E3) :
    Integrable fun u : ℝ => (psiCM m).check u * g (y - u • basisVec ℓ) := by
  refine ((psiCM m).check.integrable.norm.mul_const B).mono' ?_ (Eventually.of_forall fun u => ?_)
  · exact ((psiCM m).check.continuous.aestronglyMeasurable).mul
      (hg.comp (measurable_const.sub (measurable_id.smul_const _))).aestronglyMeasurable
  · rw [norm_mul]; exact mul_le_mul_of_nonneg_left (hB _) (norm_nonneg _)

theorem norm_lineDelta_le (ℓ : Fin 3) (m : ℤ) {g : E3 → ℂ} {B : ℝ} (hB : ∀ y, ‖g y‖ ≤ B) (y : E3) :
    ‖lineDelta ℓ m g y‖ ≤ (∫ u, ‖(psiCM m).check u‖) * B := by
  unfold lineDelta
  refine (norm_integral_le_integral_norm _).trans ?_
  rw [← integral_mul_const]
  refine integral_mono_of_nonneg (Eventually.of_forall fun u => norm_nonneg _)
    ((psiCM m).check.integrable.norm.mul_const B) (Eventually.of_forall fun u => ?_)
  simp only [norm_mul]
  exact mul_le_mul_of_nonneg_left (hB _) (norm_nonneg _)

theorem lineDelta_add (ℓ : Fin 3) (m : ℤ) {g₁ g₂ : E3 → ℂ} (h₁ : Measurable g₁) (h₂ : Measurable g₂)
    {B₁ B₂ : ℝ} (hB₁ : ∀ y, ‖g₁ y‖ ≤ B₁) (hB₂ : ∀ y, ‖g₂ y‖ ≤ B₂) :
    lineDelta ℓ m (g₁ + g₂) = lineDelta ℓ m g₁ + lineDelta ℓ m g₂ := by
  funext y
  simp only [lineDelta, Pi.add_apply, mul_add]
  exact integral_add (integrable_lineDelta_integrand ℓ m h₁ hB₁ y)
    (integrable_lineDelta_integrand ℓ m h₂ hB₂ y)

theorem lineDelta_smul (ℓ : Fin 3) (m : ℤ) (c : ℂ) (g : E3 → ℂ) :
    lineDelta ℓ m (c • g) = c • lineDelta ℓ m g := by
  funext y
  simp only [lineDelta, Pi.smul_apply, smul_eq_mul, ← integral_const_mul]
  congr 1; funext u; ring

theorem integrable_simplexTj_integrand (j : ℤ) {h : Fin 3 → E3 → ℂ} (hh : ∀ n, Measurable (h n))
    {B : ℝ} (hB : ∀ n y, ‖h n y‖ ≤ B) (x : E3) :
    Integrable fun t : ℝ => (lpPsi ((2 : ℝ) ^ j * t) : ℂ) * prodShift h x t / t := by
  refine ((integrable_psi_div j).norm.mul_const (B ^ 3)).mono' ?_ (Eventually.of_forall fun t => ?_)
  · have hps : Measurable fun t : ℝ => prodShift h x t := by
      unfold prodShift
      exact Finset.measurable_prod _ fun n _ => (hh n).comp
        (measurable_const.add (continuous_curve n).measurable)
    exact (((Complex.continuous_ofReal.comp (continuous_lpPsi.comp
      (continuous_const.mul continuous_id))).measurable.mul hps).div
      Complex.measurable_ofReal).aestronglyMeasurable
  · rw [mul_div_right_comm, norm_mul]
    exact mul_le_mul_of_nonneg_left (norm_prodShift_le hB x t) (norm_nonneg _)

theorem simplexTj_add0 (j : ℤ) {a₁ a₂ b c : E3 → ℂ} (h₁ : Measurable a₁) (h₂ : Measurable a₂)
    (hb : Measurable b) (hc : Measurable c) {B : ℝ}
    (hB₁ : ∀ y, ‖a₁ y‖ ≤ B) (hB₂ : ∀ y, ‖a₂ y‖ ≤ B) (hBb : ∀ y, ‖b y‖ ≤ B) (hBc : ∀ y, ‖c y‖ ≤ B)
    (x : E3) :
    simplexTj j ![a₁ + a₂, b, c] x = simplexTj j ![a₁, b, c] x + simplexTj j ![a₂, b, c] x := by
  have hm : ∀ a : E3 → ℂ, Measurable a → ∀ n, Measurable (![a, b, c] n) := fun a ha n => by
    fin_cases n
    exacts [ha, hb, hc]
  have hBd : ∀ a : E3 → ℂ, (∀ y, ‖a y‖ ≤ B) → ∀ n y, ‖(![a, b, c] n) y‖ ≤ B := fun a ha n y => by
    fin_cases n
    exacts [ha y, hBb y, hBc y]
  unfold simplexTj
  rw [← integral_add (integrable_simplexTj_integrand j (hm a₁ h₁) (hBd a₁ hB₁) x)
    (integrable_simplexTj_integrand j (hm a₂ h₂) (hBd a₂ hB₂) x)]
  congr 1; funext t
  simp only [prodShift, Fin.prod_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, Pi.add_apply]
  ring

theorem simplexTj_smul0 (j : ℤ) (s : ℂ) (a b c : E3 → ℂ) (x : E3) :
    simplexTj j ![s • a, b, c] x = s * simplexTj j ![a, b, c] x := by
  unfold simplexTj
  rw [← integral_const_mul]
  congr 1; funext t
  simp only [prodShift, Fin.prod_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, Pi.smul_apply, smul_eq_mul]
  ring

theorem kComp0_add (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) {g₁ g₂ : E3 → ℂ}
    (h₁ : Measurable g₁) (h₂ : Measurable g₂) {B₁ B₂ : ℝ} (hB₁ : ∀ y, ‖g₁ y‖ ≤ B₁)
    (hB₂ : ∀ y, ‖g₂ y‖ ≤ B₂) :
    kComp0 k J f (g₁ + g₂) = kComp0 k J f g₁ + kComp0 k J f g₂ := by
  funext x
  simp only [kComp0, Pi.add_apply, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  set m := (expo 0 : ℤ) * j + k 0
  obtain ⟨Bb, hBb0, hBb⟩ := exists_bound_schwartz (kDelta k f 1 j)
  obtain ⟨Bc, hBc0, hBc⟩ := exists_bound_schwartz (kDelta k f 2 j)
  set K := ∫ u, ‖(psiCM m).check u‖
  have hK0 : 0 ≤ K := integral_nonneg fun u => norm_nonneg _
  set B := max (max (K * B₁) (K * B₂)) (max Bb Bc)
  rw [lineDelta_add 0 m h₁ h₂ hB₁ hB₂]
  exact simplexTj_add0 j (measurable_lineDelta 0 m h₁) (measurable_lineDelta 0 m h₂)
    (kDelta k f 1 j).continuous.measurable (kDelta k f 2 j).continuous.measurable
    (B := B) (fun y => (norm_lineDelta_le 0 m hB₁ y).trans ((le_max_left _ _).trans (le_max_left _ _)))
    (fun y => (norm_lineDelta_le 0 m hB₂ y).trans ((le_max_right _ _).trans (le_max_left _ _)))
    (fun y => (hBb y).trans ((le_max_left _ _).trans (le_max_right _ _)))
    (fun y => (hBc y).trans ((le_max_right _ _).trans (le_max_right _ _))) x

theorem kComp0_smul (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) (s : ℂ) (g : E3 → ℂ) :
    kComp0 k J f (s • g) = s • kComp0 k J f g := by
  funext x
  simp only [kComp0, Pi.smul_apply, smul_eq_mul, Finset.mul_sum, lineDelta_smul, simplexTj_smul0]

theorem lintegral_wJ_ne_top (j : ℤ) : ∫⁻ t, wJ j t ≠ ⊤ :=
  (integrable_psi_div j).2.ne

/-- **The crude bound for `T^{(k)}_J` in slot `0`** (fixed `J`, `f_1`, `f_2`): used only for the
density arguments. -/
theorem kComp0_crude (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) {r P0 P1 P2 : ℝ}
    (hr1 : 1 ≤ r) (hP0 : 1 ≤ P0) (hP1 : 0 < P1) (hP2 : 0 < P2)
    (hsum : 1 / r = 1 / P0 + 1 / P1 + 1 / P2) :
    ∃ C : ℝ≥0∞, C ≠ ⊤ ∧ ∀ g : E3 → ℂ, Measurable g →
      eLpNorm (kComp0 k J f g) (ENNReal.ofReal r) volume
        ≤ C * eLpNorm g (ENNReal.ofReal P0) volume := by
  set Sj := Finset.Icc (-(J : ℤ)) J
  set m : ℤ → ℤ := fun j => (expo 0 : ℤ) * j + k 0
  set C : ℝ≥0∞ := ∑ j ∈ Sj, (∫⁻ t, wJ j t) * ((∫⁻ u, ‖(psiCM (m j)).check u‖ₑ) *
    (eLpNorm (kDelta k f 1 j) (ENNReal.ofReal P1) volume *
      eLpNorm (kDelta k f 2 j) (ENNReal.ofReal P2) volume))
  refine ⟨C, ?_, fun g hg => ?_⟩
  · refine ENNReal.sum_ne_top.mpr fun j _ => ENNReal.mul_ne_top (lintegral_wJ_ne_top j)
      (ENNReal.mul_ne_top (psiCM (m j)).check.integrable.2.ne (ENNReal.mul_ne_top
        (eLpNorm_schwartz_ne_top _ _) (eLpNorm_schwartz_ne_top _ _)))
  have hP : ∀ n : Fin 3, 0 < ![P0, P1, P2] n := fun n => by
    fin_cases n <;> simp <;> linarith
  have hmeas : ∀ j, ∀ n, Measurable
      (![lineDelta 0 (m j) g, ⇑(kDelta k f 1 j), ⇑(kDelta k f 2 j)] n) := fun j n => by
    fin_cases n
    exacts [measurable_lineDelta 0 _ hg, (kDelta k f 1 j).continuous.measurable,
      (kDelta k f 2 j).continuous.measurable]
  have hfun : kComp0 k J f g = ∑ j ∈ Sj, simplexTj j
      ![lineDelta 0 (m j) g, ⇑(kDelta k f 1 j), ⇑(kDelta k f 2 j)] := by
    funext x; simp [kComp0, Finset.sum_apply, m, Sj]
  rw [hfun]
  refine (eLpNorm_sum_le (fun j _ => (measurable_simplexTj j (hmeas j)).aestronglyMeasurable)
    (by simpa using hr1)).trans ?_
  rw [Finset.sum_mul]
  refine Finset.sum_le_sum fun j _ => ?_
  have h := eLpNorm_simplexTj_le j (hmeas j) hr1 (P := ![P0, P1, P2]) hP (by simpa using hsum)
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
    Matrix.tail_cons] at h
  set W := ∫⁻ t, wJ j t
  set K := ∫⁻ u, ‖(psiCM (m j)).check u‖ₑ
  set N1 := eLpNorm (kDelta k f 1 j) (ENNReal.ofReal P1) volume
  set N2 := eLpNorm (kDelta k f 2 j) (ENNReal.ofReal P2) volume
  set E := eLpNorm g (ENNReal.ofReal P0) volume
  calc eLpNorm (simplexTj j ![lineDelta 0 (m j) g, ⇑(kDelta k f 1 j), ⇑(kDelta k f 2 j)])
        (ENNReal.ofReal r) volume
      ≤ W * (eLpNorm (lineDelta 0 (m j) g) (ENNReal.ofReal P0) volume * (N1 * N2)) := h
    _ ≤ W * ((K * E) * (N1 * N2)) := by
        gcongr; exact eLpNorm_lineDelta_le 0 (m j) hg hP0
    _ = W * (K * (N1 * N2)) * E := by ring

/-- A function is bounded. -/
def IsBdd (g : E3 → ℂ) : Prop := ∃ B : ℝ, ∀ y, ‖g y‖ ≤ B

theorem IsBdd.sub {a b : E3 → ℂ} (ha : IsBdd a) (hb : IsBdd b) : IsBdd (a - b) := by
  obtain ⟨A, hA⟩ := ha; obtain ⟨B, hB⟩ := hb
  exact ⟨A + B, fun y => (norm_sub_le _ _).trans (add_le_add (hA y) (hB y))⟩

theorem isBdd_schwartz (φ : 𝓢(E3, ℂ)) : IsBdd φ :=
  let ⟨C, _, h⟩ := exists_bound_schwartz φ; ⟨C, h⟩

theorem isBdd_simpleFunc (s : SimpleFunc E3 ℂ) : IsBdd s := by
  refine ⟨(((s.range).sup (fun z => ‖z‖₊) : NNReal) : ℝ), fun y => ?_⟩
  have h : ‖s y‖₊ ≤ (s.range).sup (fun z => ‖z‖₊) :=
    Finset.le_sup (f := fun z => ‖z‖₊) (s.mem_range_self y)
  exact_mod_cast h

/-- **Density transfer of an `L^r` bound**: if a linear operator obeys a crude bound
`‖T a‖_r ≤ C ‖a‖_P` and the bound `‖T φ‖_r ≤ M ‖φ‖_P` on bounded measurable approximants of a
bounded `g ∈ L^P`, then `‖T g‖_r ≤ M ‖g‖_P`. -/
theorem eLpNorm_bound_transfer {T : (E3 → ℂ) → E3 → ℂ}
    (hadd : ∀ a b : E3 → ℂ, Measurable a → Measurable b → IsBdd a → IsBdd b → T (a + b) = T a + T b)
    (hmeas : ∀ a, Measurable a → Measurable (T a)) {r P : ℝ} (hr : 1 ≤ r) (hP : 1 ≤ P)
    {C : ℝ≥0∞} (hC : C ≠ ⊤)
    (hcrude : ∀ a, Measurable a → eLpNorm (T a) (ENNReal.ofReal r) volume
      ≤ C * eLpNorm a (ENNReal.ofReal P) volume)
    {M : ℝ≥0∞} (hM : M ≠ ⊤) {g : E3 → ℂ} (hg : Measurable g) (hgB : IsBdd g)
    (happrox : ∀ ε : ℝ≥0∞, 0 < ε → ∃ φ : E3 → ℂ, Measurable φ ∧ IsBdd φ ∧
      eLpNorm (g - φ) (ENNReal.ofReal P) volume ≤ ε ∧
      eLpNorm (T φ) (ENNReal.ofReal r) volume ≤ M * eLpNorm φ (ENNReal.ofReal P) volume) :
    eLpNorm (T g) (ENNReal.ofReal r) volume ≤ M * eLpNorm g (ENNReal.ofReal P) volume := by
  have hr1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal r := by simpa using hr
  have hP1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal P := by simpa using hP
  refine ENNReal.le_of_forall_pos_le_add fun ε hε _ => ?_
  set D : ℝ≥0∞ := M + C + 1 with hD
  have hD0 : D ≠ 0 := by simp [hD]
  have hDt : D ≠ ⊤ := by simp [hD, hM, hC]
  set δ : ℝ≥0∞ := (ε : ℝ≥0∞) / D with hδ
  have hδ0 : 0 < δ := ENNReal.div_pos (by exact_mod_cast hε.ne') hDt
  obtain ⟨φ, hφm, hφB, hφε, hφM⟩ := happrox δ hδ0
  have hsplit : T g = T φ + T (g - φ) := by
    rw [← hadd φ (g - φ) hφm (hg.sub hφm) hφB (hgB.sub hφB), add_sub_cancel]
  have hφle : eLpNorm φ (ENNReal.ofReal P) volume
      ≤ eLpNorm g (ENNReal.ofReal P) volume + δ := by
    calc eLpNorm φ (ENNReal.ofReal P) volume = eLpNorm (g - (g - φ)) (ENNReal.ofReal P) volume := by
          rw [sub_sub_cancel]
      _ ≤ eLpNorm g (ENNReal.ofReal P) volume + eLpNorm (g - φ) (ENNReal.ofReal P) volume :=
          eLpNorm_sub_le hg.aestronglyMeasurable (hg.sub hφm).aestronglyMeasurable hP1
      _ ≤ _ := by gcongr
  calc eLpNorm (T g) (ENNReal.ofReal r) volume
      ≤ eLpNorm (T φ) (ENNReal.ofReal r) volume + eLpNorm (T (g - φ)) (ENNReal.ofReal r) volume := by
        rw [hsplit]
        exact eLpNorm_add_le (hmeas φ hφm).aestronglyMeasurable
          (hmeas _ (hg.sub hφm)).aestronglyMeasurable hr1
    _ ≤ M * (eLpNorm g (ENNReal.ofReal P) volume + δ) + C * δ := by
        gcongr
        · exact hφM.trans (by gcongr)
        · exact (hcrude _ (hg.sub hφm)).trans (by gcongr)
    _ = M * eLpNorm g (ENNReal.ofReal P) volume + (M + C) * δ := by ring
    _ ≤ M * eLpNorm g (ENNReal.ofReal P) volume + ε := by
        gcongr
        calc (M + C) * δ ≤ D * δ := by gcongr; simp [hD]
          _ = ε := by rw [hδ, ENNReal.mul_div_cancel hD0 hDt]

theorem kComp0_add' (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) :
    ∀ a b : E3 → ℂ, Measurable a → Measurable b → IsBdd a → IsBdd b →
      kComp0 k J f (a + b) = kComp0 k J f a + kComp0 k J f b := by
  intro a b ha hb ⟨A, hA⟩ ⟨B, hB⟩
  exact kComp0_add k J f ha hb hA hB

theorem exists_real_pos_ofReal_le {δ : ℝ≥0∞} (hδ : 0 < δ) : ∃ ε : ℝ, 0 < ε ∧ ENNReal.ofReal ε ≤ δ := by
  refine ⟨(min δ 1).toReal, ENNReal.toReal_pos (by positivity) (by simp), ?_⟩
  rw [ENNReal.ofReal_toReal (by simp)]
  exact min_le_left _ _

/-- **Schwartz to bounded inputs**: a bound for `T^{(k)}_J` in slot `0` on Schwartz inputs passes to
bounded measurable `g ∈ L^P`. -/
theorem kComp0_bound_of_schwartz (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ))
    {r P P1 P2 : ℝ} (hr1 : 1 ≤ r) (hP : 1 ≤ P) (hP1 : 0 < P1) (hP2 : 0 < P2)
    (hsum : 1 / r = 1 / P + 1 / P1 + 1 / P2) {M : ℝ≥0∞} (hM : M ≠ ⊤)
    (hS : ∀ φ : 𝓢(E3, ℂ), eLpNorm (kComp0 k J f φ) (ENNReal.ofReal r) volume
      ≤ M * eLpNorm φ (ENNReal.ofReal P) volume)
    {g : E3 → ℂ} (hg : Measurable g) (hgB : IsBdd g) (hgP : MemLp g (ENNReal.ofReal P) volume) :
    eLpNorm (kComp0 k J f g) (ENNReal.ofReal r) volume ≤ M * eLpNorm g (ENNReal.ofReal P) volume := by
  obtain ⟨C, hC, hcrude⟩ := kComp0_crude k J f hr1 hP hP1 hP2 hsum
  refine eLpNorm_bound_transfer (kComp0_add' k J f) (fun a ha => measurable_kComp0 k J f ha)
    hr1 hP hC hcrude hM hg hgB fun δ hδ => ?_
  obtain ⟨ε, hε, hεδ⟩ := exists_real_pos_ofReal_le hδ
  obtain ⟨ψ, hψc, hψd, hψε⟩ := hgP.exist_eLpNorm_sub_le ENNReal.ofReal_ne_top (by simpa using hP) hε
  set Φ : 𝓢(E3, ℂ) := hψc.toSchwartzMap hψd
  have hΦ : (Φ : E3 → ℂ) = ψ := rfl
  refine ⟨Φ, Φ.continuous.measurable, isBdd_schwartz Φ, ?_, hS Φ⟩
  rw [hΦ]; exact hψε.trans hεδ

/-- **Simple functions to Schwartz inputs**: a bound for `T^{(k)}_J` in slot `0` on integrable
simple functions passes to Schwartz inputs. -/
theorem kComp0_bound_of_simple (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ))
    {r P P1 P2 : ℝ} (hr1 : 1 ≤ r) (hP : 1 ≤ P) (hP1 : 0 < P1) (hP2 : 0 < P2)
    (hsum : 1 / r = 1 / P + 1 / P1 + 1 / P2) {M : ℝ≥0∞} (hM : M ≠ ⊤)
    (hS : ∀ s : SimpleFunc E3 ℂ, Integrable s → eLpNorm (kComp0 k J f s) (ENNReal.ofReal r) volume
      ≤ M * eLpNorm s (ENNReal.ofReal P) volume) (φ : 𝓢(E3, ℂ)) :
    eLpNorm (kComp0 k J f φ) (ENNReal.ofReal r) volume ≤ M * eLpNorm φ (ENNReal.ofReal P) volume := by
  obtain ⟨C, hC, hcrude⟩ := kComp0_crude k J f hr1 hP hP1 hP2 hsum
  refine eLpNorm_bound_transfer (kComp0_add' k J f) (fun a ha => measurable_kComp0 k J f ha)
    hr1 hP hC hcrude hM φ.continuous.measurable (isBdd_schwartz φ) fun δ hδ => ?_
  have hP0 : ENNReal.ofReal P ≠ 0 := by simpa using (by linarith : (0 : ℝ) < P)
  obtain ⟨s, hsε, hsP⟩ := (φ.memLp (ENNReal.ofReal P) volume).exists_simpleFunc_eLpNorm_sub_lt
    ENNReal.ofReal_ne_top hδ.ne'
  have hsI : Integrable s := (SimpleFunc.memLp_iff_integrable hP0 ENNReal.ofReal_ne_top).mp hsP
  exact ⟨s, s.measurable, isBdd_simpleFunc s, hsε.le, hS s hsI⟩

/-- A Schwartz function with vanishing `L^p` norm vanishes. -/
theorem schwartz_eq_zero_of_eLpNorm (g : 𝓢(E3, ℂ)) {p : ℝ} (hp : 0 < p)
    (h : eLpNorm g (ENNReal.ofReal p) volume = 0) : (g : E3 → ℂ) = 0 := by
  rw [eLpNorm_eq_zero_iff g.continuous.aestronglyMeasurable (by simpa using hp)] at h
  exact (g.continuous.ae_eq_iff_eq volume continuous_const).mp h

/-- `T^{(k)}_J(f) = 0` as soon as one input vanishes. -/
theorem kComp_eq_zero_of (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) (n : Fin 3)
    (hn : (f n : E3 → ℂ) = 0) : kComp k J f = 0 := by
  have hf : f n = 0 := by ext y; exact congrFun hn y
  funext x
  simp only [kComp, Pi.zero_apply]
  refine Finset.sum_eq_zero fun j _ => ?_
  rw [freqPiece_eq_kDelta]
  unfold simplexTj
  have : ∀ t : ℝ, prodShift (fun m => ⇑(kDelta k f m j)) x t = 0 := by
    intro t
    unfold prodShift
    refine Finset.prod_eq_zero (Finset.mem_univ n) ?_
    simp [kDelta, hf]
  simp [this]

/-- The interpolated constant. -/
theorem interp_const_le {Cg Cv δ θ x0 ε K n : ℝ} (hCg : 0 < Cg) (hCv : 0 ≤ Cv) (hn : 0 ≤ n)
    (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1) (hx0 : x0 ≤ 1 - θ) (hK : 0 ≤ K) (hε : 0 ≤ ε) (hδ : 0 < δ)
    (hεδ : 20 * ε ≤ δ * x0 / 2) :
    (Cg * (2 : ℝ) ^ (-(δ * K)) * n) ^ (1 - θ) * ((Cv + 1) * (2 : ℝ) ^ (20 * (K + 2) * ε) * n) ^ θ
      ≤ max Cg 1 * (Cv + 1) * (2 : ℝ) ^ (40 * ε) * (2 : ℝ) ^ (-(δ * x0 / 2 * K)) * n := by
  have h1θ : 0 ≤ 1 - θ := by linarith
  have hb : (0 : ℝ) < 2 := two_pos
  rw [Real.mul_rpow (by positivity) hn, Real.mul_rpow (by positivity) hn,
    Real.mul_rpow hCg.le (by positivity), Real.mul_rpow (by positivity) (by positivity),
    ← Real.rpow_mul hb.le, ← Real.rpow_mul hb.le]
  have hnn : n ^ (1 - θ) * n ^ θ = n := by
    rcases hn.eq_or_lt with h | h
    · subst h
      rcases h1θ.eq_or_lt with h' | h'
      · rw [← h', Real.rpow_zero, one_mul, show θ = 1 by linarith, Real.rpow_one]
      · rw [Real.zero_rpow h'.ne', zero_mul]
    · rw [← Real.rpow_add h, show 1 - θ + θ = 1 by ring, Real.rpow_one]
  have hCg' : Cg ^ (1 - θ) ≤ max Cg 1 := by
    rcases le_or_gt 1 Cg with h | h
    · exact (Real.rpow_le_self_of_one_le h (by linarith)).trans (le_max_left _ _)
    · exact (Real.rpow_le_one hCg.le h.le h1θ).trans (le_max_right _ _)
  have hCv' : (Cv + 1) ^ θ ≤ Cv + 1 := Real.rpow_le_self_of_one_le (by linarith) hθ1
  have hexp : (2 : ℝ) ^ (-(δ * K) * (1 - θ)) * (2 : ℝ) ^ (20 * (K + 2) * ε * θ)
      ≤ (2 : ℝ) ^ (40 * ε) * (2 : ℝ) ^ (-(δ * x0 / 2 * K)) := by
    rw [← Real.rpow_add hb, ← Real.rpow_add hb]
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
    have h1 : δ * x0 * K ≤ δ * K * (1 - θ) := by
      have := mul_le_mul_of_nonneg_left hx0 (mul_nonneg hδ.le hK)
      nlinarith
    have h2 : 20 * (K + 2) * ε * θ ≤ 20 * (K + 2) * ε := by
      have : 0 ≤ 20 * (K + 2) * ε := by positivity
      nlinarith
    nlinarith
  calc Cg ^ (1 - θ) * (2 : ℝ) ^ (-(δ * K) * (1 - θ)) * n ^ (1 - θ) *
        ((Cv + 1) ^ θ * (2 : ℝ) ^ (20 * (K + 2) * ε * θ) * n ^ θ)
      = (Cg ^ (1 - θ) * (Cv + 1) ^ θ) *
          ((2 : ℝ) ^ (-(δ * K) * (1 - θ)) * (2 : ℝ) ^ (20 * (K + 2) * ε * θ)) *
          (n ^ (1 - θ) * n ^ θ) := by ring
    _ ≤ (max Cg 1 * (Cv + 1)) * ((2 : ℝ) ^ (40 * ε) * (2 : ℝ) ^ (-(δ * x0 / 2 * K))) * n := by
        rw [hnn]
        gcongr
    _ = _ := by ring

theorem ennreal_interp_exp {a b c θ : ℝ} (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (hθ0 : 0 ≤ θ)
    (hθ1 : θ ≤ 1) (h : 1 / c = (1 - θ) * (1 / a) + θ * (1 / b)) :
    (ENNReal.ofReal c)⁻¹ = ENNReal.ofReal (1 - θ) * (ENNReal.ofReal a)⁻¹ +
      ENNReal.ofReal θ * (ENNReal.ofReal b)⁻¹ := by
  rw [← ENNReal.ofReal_inv_of_pos ha, ← ENNReal.ofReal_inv_of_pos hb, ← ENNReal.ofReal_inv_of_pos hc,
    ← ENNReal.ofReal_mul (by linarith), ← ENNReal.ofReal_mul hθ0,
    ← ENNReal.ofReal_add (by positivity) (by positivity)]
  congr 1
  simpa [one_div] using h

/-- **Exponential gain for `T^{(k)}` in the range of `thm:main`** (line 456): interpolation in slot
`0` (Riesz-Thorin) between `lem:gain` and the small-loss bound. For `p > 1`, `p_1, p_2 > 2`,
`1/p_1 + 1/p_2 ≥ 1/2` and `1/p = ∑ 1/p_n`: `‖T^{(k)}_J(f)‖_p ≤ C 2^{-δ' k^{(1)}} ∏ ‖f_n‖_{p_n}`
for `k ∈ F_H`, uniformly in `J`. -/
theorem H_gain {pv : Fin 3 → ℝ} {p : ℝ} (hp : 1 < p) (hp0 : 0 < pv 0) (hp1 : 2 < pv 1)
    (hp2 : 2 < pv 2) (hsum : 1 / p = 1 / pv 0 + 1 / pv 1 + 1 / pv 2)
    (hhalf : 1 / 2 ≤ 1 / pv 1 + 1 / pv 2) :
    ∃ δ' C : ℝ, 0 < δ' ∧ 0 ≤ C ∧ ∀ k : Fin 3 → ℤ, 0 < kMax k → ∀ (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)),
      eLpNorm (kComp k J f) (ENNReal.ofReal p) volume
        ≤ ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ' * kMax k))) *
          (eLpNorm (f 0) (ENNReal.ofReal (pv 0)) volume * (eLpNorm (f 1) (ENNReal.ofReal (pv 1)) volume *
            eLpNorm (f 2) (ENNReal.ofReal (pv 2)) volume)) := by
  set a := 1 / pv 1 + 1 / pv 2 with ha
  set x0 := 1 / pv 0 with hx0
  have hx00 : 0 < x0 := by positivity
  have ha1 : a < 1 / 2 + 1 / 2 := by
    have h1 : 1 / pv 1 < 1 / 2 := by rw [div_lt_div_iff₀ (by linarith) two_pos]; linarith
    have h2 : 1 / pv 2 < 1 / 2 := by rw [div_lt_div_iff₀ (by linarith) two_pos]; linarith
    linarith
  have hp' : 1 / p < 1 := by rw [div_lt_one (by linarith)]; exact hp
  set g0 := 1 - a with hg0
  have hg00 : 0 < g0 := by linarith
  have hg0h : g0 ≤ 1 / 2 := by linarith
  have hxg : x0 < g0 := by rw [hsum] at hp'; linarith
  set Pg := 1 / g0 with hPg
  have hPg2 : 2 ≤ Pg := by rw [hPg, le_div_iff₀ hg00]; linarith
  obtain ⟨δ, Cg, hδ, hCg, hgain⟩ := gain_one (pv := ![Pg, pv 1, pv 2])
    (fun n => by fin_cases n <;> simp <;> linarith)
    (by simp only [Fin.sum_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one,
          Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
        rw [hPg, inv_div, div_one]; simp only [hg0, ha, one_div]; ring)
  set ε := min (x0 / 2) (δ * x0 / 40) with hε
  have hε0 : 0 < ε := lt_min (by positivity) (by positivity)
  have hεx : ε ≤ x0 / 2 := min_le_left _ _
  have hεδ : 20 * ε ≤ δ * x0 / 2 := by have := min_le_right (x0 / 2) (δ * x0 / 40); linarith
  set q := 1 / ε with hq
  have hq2 : 2 < q := by rw [hq, lt_div_iff₀ hε0]; linarith
  set rv := 1 / (ε + a) with hrv
  have hrv1 : 1 < rv := by rw [hrv, lt_div_iff₀ (by positivity)]; linarith
  have hrvsum : 1 / rv = 1 / q + 1 / pv 1 + 1 / pv 2 := by
    rw [hrv, hq, one_div_one_div, one_div_one_div, ha]; ring
  obtain ⟨Cv, hCv, hloss⟩ := smallLoss_bound' hq2 hp1 hp2 hrvsum
  set θ := (g0 - x0) / (g0 - ε) with hθ
  have hgε : 0 < g0 - ε := by linarith
  have hθ0 : 0 < θ := div_pos (by linarith) hgε
  have hθ1 : θ < 1 := by rw [hθ, div_lt_one hgε]; linarith
  have h1θ : 1 - θ = (x0 - ε) / (g0 - ε) := by rw [hθ]; field_simp; ring
  have hθx : x0 ≤ 1 - θ := by
    rw [h1θ, le_div_iff₀ hgε]
    nlinarith
  have hgε' : g0 - ε ≠ 0 := hgε.ne'
  have hint0 : 1 / pv 0 = (1 - θ) * (1 / Pg) + θ * (1 / q) := by
    rw [hPg, hq, one_div_one_div, one_div_one_div, ← hx0, hθ]; field_simp; ring
  have hint1 : 1 / p = (1 - θ) * (1 / 1) + θ * (1 / rv) := by
    have e : 1 / p = x0 + a := by rw [hsum, hx0, ha]; ring
    have h' : 1 - a - ε ≠ 0 := by linarith
    rw [e, hrv, one_div_one_div, hθ, hg0]; field_simp; ring
  refine ⟨δ * x0 / 2, max Cg 1 * (Cv + 1) * (2 : ℝ) ^ (40 * ε), by positivity, by positivity,
    fun k hk J f => ?_⟩
  set K : ℝ := (kMax k : ℝ) with hK
  have hK0 : 0 ≤ K := by rw [hK]; exact_mod_cast (by omega : (0 : ℤ) ≤ kMax k)
  set N0 := eLpNorm (f 0) (ENNReal.ofReal (pv 0)) volume
  set N1 := eLpNorm (f 1) (ENNReal.ofReal (pv 1)) volume
  set N2 := eLpNorm (f 2) (ENNReal.ofReal (pv 2)) volume
  -- degenerate inputs
  by_cases hN : N1 = 0 ∨ N2 = 0
  · have hz : kComp k J f = 0 := by
      rcases hN with h | h
      · exact kComp_eq_zero_of k J f 1 (schwartz_eq_zero_of_eLpNorm (f 1) (by linarith) h)
      · exact kComp_eq_zero_of k J f 2 (schwartz_eq_zero_of_eLpNorm (f 2) (by linarith) h)
    rw [hz]; simp
  push Not at hN
  obtain ⟨hN1, hN2⟩ := hN
  set n1 := N1.toReal
  set n2 := N2.toReal
  have hn1 : 0 < n1 := ENNReal.toReal_pos hN1 (eLpNorm_schwartz_ne_top _ _)
  have hn2 : 0 < n2 := ENNReal.toReal_pos hN2 (eLpNorm_schwartz_ne_top _ _)
  have hN1e : N1 = ENNReal.ofReal n1 := (ENNReal.ofReal_toReal (eLpNorm_schwartz_ne_top _ _)).symm
  have hN2e : N2 = ENNReal.ofReal n2 := (ENNReal.ofReal_toReal (eLpNorm_schwartz_ne_top _ _)).symm
  set M₀ := Cg * (2 : ℝ) ^ (-(δ * K)) * (n1 * n2) with hM₀
  set M₁ := (Cv + 1) * (2 : ℝ) ^ (20 * (K + 2) * ε) * (n1 * n2) with hM₁
  have hM₀0 : 0 < M₀ := by positivity
  have hM₁0 : 0 < M₁ := by positivity
  -- the two vertex bounds on Schwartz inputs in slot `0`
  have hS₀ : ∀ φ : 𝓢(E3, ℂ), eLpNorm (kComp0 k J f φ) (ENNReal.ofReal 1) volume
      ≤ ENNReal.ofReal M₀ * eLpNorm φ (ENNReal.ofReal Pg) volume := by
    intro φ
    rw [kComp0_schwartz, ENNReal.ofReal_one]
    refine (hgain k hk J (Function.update f 0 φ)).trans (le_of_eq ?_)
    simp only [Fin.prod_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons, Function.update_self]
    rw [Function.update_of_ne (by decide), Function.update_of_ne (by decide)]
    change _ * (_ * N1 * N2) = _
    rw [hN1e, hN2e]
    simp only [hM₀, hK]
    rw [ENNReal.ofReal_mul (p := Cg * (2 : ℝ) ^ (-(δ * (kMax k : ℝ)))) (by positivity),
      ENNReal.ofReal_mul hn1.le]
    ring
  have hS₁ : ∀ φ : 𝓢(E3, ℂ), eLpNorm (kComp0 k J f φ) (ENNReal.ofReal rv) volume
      ≤ ENNReal.ofReal M₁ * eLpNorm φ (ENNReal.ofReal q) volume := by
    intro φ
    rw [kComp0_schwartz]
    refine (hloss k hk J (Function.update f 0 φ)).trans ?_
    simp only [Function.update_self]
    rw [Function.update_of_ne (by decide), Function.update_of_ne (by decide)]
    change _ * (_ * (N1 * N2)) ≤ _
    rw [hN1e, hN2e, hM₁, ← ENNReal.ofReal_mul hn1.le, show 20 * (K + 2) / q = 20 * (K + 2) * ε by
      rw [hq]; field_simp]
    calc ENNReal.ofReal (Cv * (2 : ℝ) ^ (20 * (K + 2) * ε)) *
          (eLpNorm φ (ENNReal.ofReal q) volume * ENNReal.ofReal (n1 * n2))
        ≤ ENNReal.ofReal ((Cv + 1) * (2 : ℝ) ^ (20 * (K + 2) * ε)) *
          (eLpNorm φ (ENNReal.ofReal q) volume * ENNReal.ofReal (n1 * n2)) := by
          gcongr; linarith
      _ = _ := by
          rw [ENNReal.ofReal_mul (p := (Cv + 1) * (2 : ℝ) ^ (20 * (K + 2) * ε)) (by positivity)]
          ring
  -- to simple functions
  have hPg1 : (1 : ℝ) ≤ Pg := by linarith
  have hpv01 : (1 : ℝ) ≤ pv 0 := by
    have : 1 / pv 0 < 1 := by rw [← hx0]; linarith
    rw [div_lt_one hp0] at this; linarith
  have hq1 : (1 : ℝ) ≤ q := by linarith
  have hsum₀ : 1 / (1 : ℝ) = 1 / Pg + 1 / pv 1 + 1 / pv 2 := by
    rw [hPg, one_div_one_div, hg0, ha]; ring
  have hsimple : ∀ (P : ℝ), 1 ≤ P → ∀ s : SimpleFunc E3 ℂ, Integrable s →
      MemLp s (ENNReal.ofReal P) volume := fun P hP s hs =>
    (SimpleFunc.memLp_iff_integrable (by simpa using (by linarith : (0 : ℝ) < P))
      ENNReal.ofReal_ne_top).mpr hs
  have hB₀ : ∀ s : SimpleFunc E3 ℂ, Integrable s →
      eLpNorm (kComp0 k J f s) (ENNReal.ofReal 1) volume
        ≤ ENNReal.ofReal M₀ * eLpNorm s (ENNReal.ofReal Pg) volume := fun s hs =>
    kComp0_bound_of_schwartz k J f le_rfl hPg1 (by linarith) (by linarith) hsum₀
      ENNReal.ofReal_ne_top hS₀ s.measurable (isBdd_simpleFunc s) (hsimple Pg hPg1 s hs)
  have hB₁ : ∀ s : SimpleFunc E3 ℂ, Integrable s →
      eLpNorm (kComp0 k J f s) (ENNReal.ofReal rv) volume
        ≤ ENNReal.ofReal M₁ * eLpNorm s (ENNReal.ofReal q) volume := fun s hs =>
    kComp0_bound_of_schwartz k J f hrv1.le hq1 (by linarith) (by linarith) hrvsum
      ENNReal.ofReal_ne_top hS₁ s.measurable (isBdd_simpleFunc s) (hsimple q hq1 s hs)
  -- Riesz-Thorin in slot `0`
  have hRT := Auto.SteinInterpolation.riesz_thorin (μ := volume) (ν := volume)
    (p₀ := ENNReal.ofReal Pg) (p₁ := ENNReal.ofReal q) (p := ENNReal.ofReal (pv 0))
    (q₀ := ENNReal.ofReal 1) (q₁ := ENNReal.ofReal rv) (q := ENNReal.ofReal p) (θ := θ)
    (M₀ := M₀) (M₁ := M₁) (fun s => kComp0 k J f s)
    (by simpa using hPg1) (by simpa using hq1) (by simp) (by simpa using hrv1.le) ⟨hθ0, hθ1⟩
    (ennreal_interp_exp (by linarith) (by linarith) hp0 hθ0.le hθ1.le hint0)
    (ennreal_interp_exp one_pos (by linarith) (by linarith) hθ0.le hθ1.le hint1)
    (fun s t _ _ => by
      rw [SimpleFunc.coe_add]
      exact kComp0_add' k J f _ _ s.measurable t.measurable (isBdd_simpleFunc s) (isBdd_simpleFunc t))
    (fun c s _ => by rw [SimpleFunc.coe_smul]; exact kComp0_smul k J f c s)
    (fun s _ => measurable_kComp0 k J f s.measurable) hM₀0 hM₁0 hB₀ hB₁
  have hfinal := kComp0_bound_of_simple k J f (r := p) (P := pv 0) (P1 := pv 1) (P2 := pv 2)
    hp.le hpv01 (by linarith) (by linarith) hsum ENNReal.ofReal_ne_top
    (fun s hs => (hRT s hs).2) (f 0)
  rw [kComp0_self] at hfinal
  refine hfinal.trans ?_
  have hic := interp_const_le (n := n1 * n2) hCg hCv (by positivity) hθ0.le hθ1.le hθx hK0 hε0.le hδ hεδ
  calc ENNReal.ofReal (Real.rpow M₀ (1 - θ) * Real.rpow M₁ θ) * N0
      ≤ ENNReal.ofReal (max Cg 1 * (Cv + 1) * (2 : ℝ) ^ (40 * ε) * (2 : ℝ) ^ (-(δ * x0 / 2 * K)) *
          (n1 * n2)) * N0 := by
        exact mul_le_mul' (ENNReal.ofReal_le_ofReal hic) le_rfl
    _ = _ := by
        rw [hN1e, hN2e, ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul hn1.le]
        ring

/-- The box `[-N, N]^3` of frequency indices. -/
def kBox (N : ℕ) : Finset (Fin 3 → ℤ) := Fintype.piFinset fun _ => Finset.Icc (-(N : ℤ)) N

theorem kBox_mono : Monotone kBox := by
  intro a b hab k hk
  simp only [kBox, Fintype.mem_piFinset, Finset.mem_Icc] at hk ⊢
  intro i; have := hk i; have hab' : (a : ℤ) ≤ b := by exact_mod_cast hab
  constructor <;> linarith [this.1, this.2]

theorem mem_kBox (k : Fin 3 → ℤ) : ∃ N, k ∈ kBox N := by
  refine ⟨(|k 0| + |k 1| + |k 2|).toNat, ?_⟩
  simp only [kBox, Fintype.mem_piFinset, Finset.mem_Icc]
  intro i
  have h0 := abs_nonneg (k 0); have h1 := abs_nonneg (k 1); have h2 := abs_nonneg (k 2)
  have hi : |k i| ≤ |k 0| + |k 1| + |k 2| := by fin_cases i <;> simp <;> omega
  have := Int.self_le_toNat (|k 0| + |k 1| + |k 2|)
  constructor <;> [have := neg_abs_le (k i); have := le_abs_self (k i)] <;> omega

/-- `∑_{m=-99}^{N} 2^{-(δ/3) m} ≤ 2^{33δ}/(1 - 2^{-δ/3})`. -/
theorem sum_Icc_rpow_le {δ : ℝ} (hδ : 0 < δ) (N : ℕ) :
    ∑ m ∈ Finset.Icc (-99 : ℤ) N, (2 : ℝ) ^ (-(δ / 3) * m)
      ≤ (2 : ℝ) ^ (33 * δ) / (1 - (2 : ℝ) ^ (-(δ / 3))) := by
  set c : ℝ := (2 : ℝ) ^ (-(δ / 3)) with hc
  have hc0 : 0 ≤ c := by positivity
  have hc1 : c < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  have hterm : ∀ m ∈ Finset.Icc (-99 : ℤ) N,
      (2 : ℝ) ^ (-(δ / 3) * m) = (2 : ℝ) ^ (33 * δ) * c ^ (m + 99).toNat := by
    intro m hm
    have hm0 : 0 ≤ m + 99 := by simp at hm; omega
    rw [hc, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num), ← Real.rpow_add (by norm_num)]
    congr 1
    have e : (((m + 99).toNat : ℕ) : ℝ) = (m : ℝ) + 99 := by
      rw [show (((m + 99).toNat : ℕ) : ℝ) = (((m + 99).toNat : ℤ) : ℝ) by norm_cast,
        Int.toNat_of_nonneg hm0]; push_cast; ring
    rw [e]; ring
  rw [Finset.sum_congr rfl hterm, ← Finset.mul_sum]
  have hinj : Set.InjOn (fun m : ℤ => (m + 99).toNat) (Finset.Icc (-99 : ℤ) N) := by
    intro a ha b hb h
    simp only [Finset.coe_Icc, Set.mem_Icc] at ha hb
    simp only at h
    omega
  rw [← Finset.sum_image (f := fun i : ℕ => c ^ i) hinj, div_eq_mul_one_div]
  gcongr
  calc ∑ i ∈ (Finset.Icc (-99 : ℤ) N).image (fun m : ℤ => (m + 99).toNat), c ^ i
      ≤ ∑ i ∈ Finset.range (N + 100), c ^ i := by
        refine Finset.sum_le_sum_of_subset_of_nonneg ?_ fun i _ _ => pow_nonneg hc0 i
        intro i hi
        simp only [Finset.mem_image, Finset.mem_Icc] at hi
        obtain ⟨m, ⟨h1, h2⟩, rfl⟩ := hi
        simp only [Finset.mem_range]; omega
    _ = (1 - c ^ (N + 100)) / (1 - c) := by
        rw [geom_sum_eq hc1.ne, ← neg_sub (c ^ (N + 100)), ← neg_sub c, neg_div_neg_eq]
    _ ≤ 1 / (1 - c) :=
        div_le_div_of_nonneg_right (by linarith [pow_nonneg hc0 (N + 100)]) (by linarith)

theorem le_kMax (k : Fin 3 → ℤ) (i : Fin 3) : k i ≤ kMax k := by
  unfold kMax
  fin_cases i
  exacts [le_max_of_le_left (le_max_left _ _), le_max_of_le_left (le_max_right _ _), le_max_right _ _]

theorem kMin_le (k : Fin 3 → ℤ) (i : Fin 3) : kMin k ≤ k i := by
  unfold kMin
  fin_cases i
  exacts [min_le_of_left_le (min_le_left _ _), min_le_of_left_le (min_le_right _ _), min_le_right _ _]

/-- **The summability over `F_H`**: `∑_{k ∈ F_H ∩ [-N,N]^3} 2^{-δ k^{(1)}} ≤ S`, uniformly in `N`. -/
theorem sum_regH_le {δ : ℝ} (hδ : 0 < δ) :
    ∃ S : ℝ, 0 ≤ S ∧ ∀ N : ℕ, ∑ k ∈ (kBox N).filter RegH, (2 : ℝ) ^ (-(δ * kMax k)) ≤ S := by
  set T : ℝ := (2 : ℝ) ^ (33 * δ) / (1 - (2 : ℝ) ^ (-(δ / 3))) with hT
  have hc1 : (2 : ℝ) ^ (-(δ / 3)) < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  have hT0 : 0 ≤ T := div_nonneg (by positivity) (by linarith)
  refine ⟨T ^ 3, by positivity, fun N => ?_⟩
  have hbound : ∀ k ∈ (kBox N).filter RegH,
      (2 : ℝ) ^ (-(δ * kMax k)) ≤ ∏ i, (2 : ℝ) ^ (-(δ / 3) * k i) := by
    intro k _
    rw [Fin.prod_univ_three, ← Real.rpow_add two_pos, ← Real.rpow_add two_pos]
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
    have h0 : ((k 0 : ℤ) : ℝ) ≤ kMax k := by exact_mod_cast le_kMax k 0
    have h1 : ((k 1 : ℤ) : ℝ) ≤ kMax k := by exact_mod_cast le_kMax k 1
    have h2 : ((k 2 : ℤ) : ℝ) ≤ kMax k := by exact_mod_cast le_kMax k 2
    nlinarith
  have hsub : (kBox N).filter RegH ⊆ Fintype.piFinset fun _ => Finset.Icc (-99 : ℤ) N := by
    intro k hk
    simp only [kBox, Finset.mem_filter, Fintype.mem_piFinset, Finset.mem_Icc] at hk ⊢
    obtain ⟨hbox, hH⟩ := hk
    intro i
    have hmin := kMin_le k i
    have hH1 := hH.1; have hH2 := hH.2
    exact ⟨by omega, (hbox i).2⟩
  calc ∑ k ∈ (kBox N).filter RegH, (2 : ℝ) ^ (-(δ * kMax k))
      ≤ ∑ k ∈ (kBox N).filter RegH, ∏ i, (2 : ℝ) ^ (-(δ / 3) * k i) := Finset.sum_le_sum hbound
    _ ≤ ∑ k ∈ Fintype.piFinset (fun _ : Fin 3 => Finset.Icc (-99 : ℤ) N),
          ∏ i, (2 : ℝ) ^ (-(δ / 3) * k i) :=
        Finset.sum_le_sum_of_subset_of_nonneg hsub fun k _ _ => Finset.prod_nonneg fun i _ => by positivity
    _ = ∏ _i : Fin 3, ∑ m ∈ Finset.Icc (-99 : ℤ) N, (2 : ℝ) ^ (-(δ / 3) * m) :=
        Finset.sum_prod_piFinset (Finset.Icc (-99 : ℤ) N) (fun (_ : Fin 3) (m : ℤ) => (2 : ℝ) ^ (-(δ / 3) * m))
    _ ≤ ∏ _i : Fin 3, T := Finset.prod_le_prod (fun i _ => Finset.sum_nonneg fun m _ => by positivity)
          fun i _ => sum_Icc_rpow_le hδ N
    _ = T ^ 3 := by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]

theorem summable_kComp_ite (R : (Fin 3 → ℤ) → Prop) [DecidablePred R] (J : ℕ)
    (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    Summable fun k => if R k then kComp k J f x else 0 := by
  have e : (fun k => if R k then kComp k J f x else 0)
      = fun k => ∑ j ∈ Finset.Icc (-(J : ℤ)) J, (if R k then freqPiece j k f x else 0) := by
    funext k; unfold kComp; split_ifs <;> simp
  rw [e]
  exact summable_sum fun j _ => summable_freqPiece_ite R j f x

/-- The region components are the limits of their partial sums over the boxes `[-N, N]^3`. -/
theorem tendsto_regComp_kBox (R : (Fin 3 → ℤ) → Prop) [DecidablePred R] (J : ℕ)
    (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    Tendsto (fun N : ℕ => ∑ k ∈ (kBox N).filter R, kComp k J f x) atTop
      (𝓝 (regComp R J f x)) := by
  rw [regComp_eq_tsum_kComp]
  have h := (summable_kComp_ite R J f x).hasSum.comp
    (tendsto_atTop_finset_of_monotone kBox_mono mem_kBox)
  refine h.congr fun N => ?_
  simp only [Function.comp_apply, Finset.sum_filter]

theorem measurable_kComp (k : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) :
    Measurable (kComp k J f) := by
  rw [← kComp0_self]; exact measurable_kComp0 k J f (f 0).continuous.measurable

/-- **`eq:final_gain`** (lines 430-437, 456) in the range of `thm:main`: for `p > 1`, `p_1, p_2 > 2`,
`1/p_1 + 1/p_2 ≥ 1/2`, `1/p = ∑ 1/p_n`: `‖T^H_J(f)‖_p ≤ C ∏ ‖f_n‖_{p_n}`, uniformly in `J`. -/
theorem H_bound {pv : Fin 3 → ℝ} {p : ℝ} (hp : 1 < p) (hp0 : 0 < pv 0) (hp1 : 2 < pv 1)
    (hp2 : 2 < pv 2) (hsum : 1 / p = 1 / pv 0 + 1 / pv 1 + 1 / pv 2)
    (hhalf : 1 / 2 ≤ 1 / pv 1 + 1 / pv 2) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)),
      eLpNorm (regComp RegH J f) (ENNReal.ofReal p) volume
        ≤ ENNReal.ofReal C *
          (eLpNorm (f 0) (ENNReal.ofReal (pv 0)) volume * (eLpNorm (f 1) (ENNReal.ofReal (pv 1)) volume *
            eLpNorm (f 2) (ENNReal.ofReal (pv 2)) volume)) := by
  obtain ⟨δ', C, hδ', hC, hg⟩ := H_gain hp hp0 hp1 hp2 hsum hhalf
  obtain ⟨S, hS0, hS⟩ := sum_regH_le hδ'
  refine ⟨C * S, by positivity, fun J f => ?_⟩
  set Np := eLpNorm (f 0) (ENNReal.ofReal (pv 0)) volume * (eLpNorm (f 1) (ENNReal.ofReal (pv 1)) volume *
    eLpNorm (f 2) (ENNReal.ofReal (pv 2)) volume)
  have hfatou := Lp.eLpNorm_lim_le_liminf_eLpNorm (μ := (volume : Measure E3)) (p := ENNReal.ofReal p)
    (fun N => (Finset.measurable_sum ((kBox N).filter RegH) fun k _ =>
      measurable_kComp k J f).aestronglyMeasurable)
    (regComp RegH J f) (Eventually.of_forall fun x => tendsto_regComp_kBox RegH J f x)
  refine hfatou.trans (Filter.liminf_le_of_frequently_le' (Frequently.of_forall fun N => ?_))
  have hp1' : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by simpa using hp.le
  calc eLpNorm (fun x => ∑ k ∈ (kBox N).filter RegH, kComp k J f x) (ENNReal.ofReal p) volume
      ≤ ∑ k ∈ (kBox N).filter RegH, eLpNorm (kComp k J f) (ENNReal.ofReal p) volume := by
        have e : (fun x => ∑ k ∈ (kBox N).filter RegH, kComp k J f x)
            = ∑ k ∈ (kBox N).filter RegH, kComp k J f := by
          funext x; simp [Finset.sum_apply]
        rw [e]
        exact eLpNorm_sum_le (fun k _ => (measurable_kComp k J f).aestronglyMeasurable) hp1'
    _ ≤ ∑ k ∈ (kBox N).filter RegH, ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ' * kMax k))) * Np :=
        Finset.sum_le_sum fun k hk => hg k (Finset.mem_filter.mp hk).2.1 J f
    _ = ENNReal.ofReal (C * ∑ k ∈ (kBox N).filter RegH, (2 : ℝ) ^ (-(δ' * kMax k))) * Np := by
        rw [← Finset.sum_mul, Finset.mul_sum, ENNReal.ofReal_sum_of_nonneg fun k _ => by positivity]
    _ ≤ ENNReal.ofReal (C * S) * Np := by
        gcongr; exact hS N

/-- The summability over any region all of whose indices satisfy `k_i ≥ -99`. -/
theorem sum_region_le {δ : ℝ} (hδ : 0 < δ) (R : (Fin 3 → ℤ) → Prop) [DecidablePred R]
    (hR : ∀ k, R k → ∀ i, -99 ≤ k i) :
    ∃ S : ℝ, 0 ≤ S ∧ ∀ N : ℕ, ∑ k ∈ (kBox N).filter R, (2 : ℝ) ^ (-(δ * kMax k)) ≤ S := by
  set T : ℝ := (2 : ℝ) ^ (33 * δ) / (1 - (2 : ℝ) ^ (-(δ / 3))) with hT
  have hc1 : (2 : ℝ) ^ (-(δ / 3)) < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  have hT0 : 0 ≤ T := div_nonneg (by positivity) (by linarith)
  refine ⟨T ^ 3, by positivity, fun N => ?_⟩
  have hbound : ∀ k ∈ (kBox N).filter R,
      (2 : ℝ) ^ (-(δ * kMax k)) ≤ ∏ i, (2 : ℝ) ^ (-(δ / 3) * k i) := by
    intro k _
    rw [Fin.prod_univ_three, ← Real.rpow_add two_pos, ← Real.rpow_add two_pos]
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
    have h0 : ((k 0 : ℤ) : ℝ) ≤ kMax k := by exact_mod_cast le_kMax k 0
    have h1 : ((k 1 : ℤ) : ℝ) ≤ kMax k := by exact_mod_cast le_kMax k 1
    have h2 : ((k 2 : ℤ) : ℝ) ≤ kMax k := by exact_mod_cast le_kMax k 2
    nlinarith
  have hsub : (kBox N).filter R ⊆ Fintype.piFinset fun _ => Finset.Icc (-99 : ℤ) N := by
    intro k hk
    simp only [kBox, Finset.mem_filter, Fintype.mem_piFinset, Finset.mem_Icc] at hk ⊢
    obtain ⟨hbox, hRk⟩ := hk
    exact fun i => ⟨hR k hRk i, (hbox i).2⟩
  calc ∑ k ∈ (kBox N).filter R, (2 : ℝ) ^ (-(δ * kMax k))
      ≤ ∑ k ∈ (kBox N).filter R, ∏ i, (2 : ℝ) ^ (-(δ / 3) * k i) := Finset.sum_le_sum hbound
    _ ≤ ∑ k ∈ Fintype.piFinset (fun _ : Fin 3 => Finset.Icc (-99 : ℤ) N),
          ∏ i, (2 : ℝ) ^ (-(δ / 3) * k i) :=
        Finset.sum_le_sum_of_subset_of_nonneg hsub fun k _ _ => Finset.prod_nonneg fun i _ => by positivity
    _ = ∏ _i : Fin 3, ∑ m ∈ Finset.Icc (-99 : ℤ) N, (2 : ℝ) ^ (-(δ / 3) * m) :=
        Finset.sum_prod_piFinset (Finset.Icc (-99 : ℤ) N) (fun (_ : Fin 3) (m : ℤ) => (2 : ℝ) ^ (-(δ / 3) * m))
    _ ≤ ∏ _i : Fin 3, T := Finset.prod_le_prod (fun i _ => Finset.sum_nonneg fun m _ => by positivity)
          fun i _ => sum_Icc_rpow_le hδ N
    _ = T ^ 3 := by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]

/-- **The region bound from exponential gain**: for a region `R` with `k^{(1)} > 0` and all
`k_i ≥ -99`, in the range of `H_gain`, `‖T^R_J(f)‖_p ≤ C ∏ ‖f_n‖_{p_n}` uniformly in `J`. -/
theorem regComp_gain_bound (R : (Fin 3 → ℤ) → Prop) [DecidablePred R]
    (hRpos : ∀ k, R k → 0 < kMax k) (hRlow : ∀ k, R k → ∀ i, -99 ≤ k i)
    {pv : Fin 3 → ℝ} {p : ℝ} (hp : 1 < p) (hp0 : 0 < pv 0) (hp1 : 2 < pv 1)
    (hp2 : 2 < pv 2) (hsum : 1 / p = 1 / pv 0 + 1 / pv 1 + 1 / pv 2)
    (hhalf : 1 / 2 ≤ 1 / pv 1 + 1 / pv 2) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)),
      eLpNorm (regComp R J f) (ENNReal.ofReal p) volume
        ≤ ENNReal.ofReal C *
          (eLpNorm (f 0) (ENNReal.ofReal (pv 0)) volume * (eLpNorm (f 1) (ENNReal.ofReal (pv 1)) volume *
            eLpNorm (f 2) (ENNReal.ofReal (pv 2)) volume)) := by
  obtain ⟨δ', C, hδ', hC, hg⟩ := H_gain hp hp0 hp1 hp2 hsum hhalf
  obtain ⟨S, hS0, hS⟩ := sum_region_le hδ' R hRlow
  refine ⟨C * S, by positivity, fun J f => ?_⟩
  set Np := eLpNorm (f 0) (ENNReal.ofReal (pv 0)) volume * (eLpNorm (f 1) (ENNReal.ofReal (pv 1)) volume *
    eLpNorm (f 2) (ENNReal.ofReal (pv 2)) volume)
  have hfatou := Lp.eLpNorm_lim_le_liminf_eLpNorm (μ := (volume : Measure E3)) (p := ENNReal.ofReal p)
    (fun N => (Finset.measurable_sum ((kBox N).filter R) fun k _ =>
      measurable_kComp k J f).aestronglyMeasurable)
    (regComp R J f) (Eventually.of_forall fun x => tendsto_regComp_kBox R J f x)
  refine hfatou.trans (Filter.liminf_le_of_frequently_le' (Frequently.of_forall fun N => ?_))
  have hp1' : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p := by simpa using hp.le
  calc eLpNorm (fun x => ∑ k ∈ (kBox N).filter R, kComp k J f x) (ENNReal.ofReal p) volume
      ≤ ∑ k ∈ (kBox N).filter R, eLpNorm (kComp k J f) (ENNReal.ofReal p) volume := by
        have e : (fun x => ∑ k ∈ (kBox N).filter R, kComp k J f x)
            = ∑ k ∈ (kBox N).filter R, kComp k J f := by
          funext x; simp [Finset.sum_apply]
        rw [e]
        exact eLpNorm_sum_le (fun k _ => (measurable_kComp k J f).aestronglyMeasurable) hp1'
    _ ≤ ∑ k ∈ (kBox N).filter R, ENNReal.ofReal (C * (2 : ℝ) ^ (-(δ' * kMax k))) * Np :=
        Finset.sum_le_sum fun k hk => hg k (hRpos k (Finset.mem_filter.mp hk).2) J f
    _ = ENNReal.ofReal (C * ∑ k ∈ (kBox N).filter R, (2 : ℝ) ^ (-(δ' * kMax k))) * Np := by
        rw [← Finset.sum_mul, Finset.mul_sum, ENNReal.ofReal_sum_of_nonneg fun k _ => by positivity]
    _ ≤ ENNReal.ofReal (C * S) * Np := by
        gcongr; exact hS N

/-- `F_{MH,n,+} = {k ∈ F_{MH,n} : k_n > 0}`, lines 585-588. -/
def RegMHnPlus (n : Fin 3) (k : Fin 3 → ℤ) : Prop := RegMHn n k ∧ 0 < k n

/-- `F_{MH,n,-} = {k ∈ F_{MH,n} : k_n ≤ 0}`, lines 585-588. -/
def RegMHnMinus (n : Fin 3) (k : Fin 3 → ℤ) : Prop := RegMHn n k ∧ k n ≤ 0

instance (n : Fin 3) (k : Fin 3 → ℤ) : Decidable (RegMHnPlus n k) := by
  unfold RegMHnPlus; infer_instance
instance (n : Fin 3) (k : Fin 3 → ℤ) : Decidable (RegMHnMinus n k) := by
  unfold RegMHnMinus; infer_instance

/-- `T^{MH,n} = T^{MH,n,+} + T^{MH,n,-}`. -/
theorem regComp_MHn_split (n : Fin 3) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    regComp (RegMHn n) J f x = regComp (RegMHnPlus n) J f x + regComp (RegMHnMinus n) J f x := by
  unfold regComp
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [← (summable_freqPiece_ite (RegMHnPlus n) j f x).tsum_add
    (summable_freqPiece_ite (RegMHnMinus n) j f x)]
  congr 1; funext k
  by_cases h : RegMHn n k
  · by_cases h2 : 0 < k n
    · have : ¬ RegMHnMinus n k := fun h' => by linarith [h'.2]
      simp [h, RegMHnPlus, h2, this]
    · have : ¬ RegMHnPlus n k := fun h' => h2 h'.2
      simp [h, RegMHnMinus, this, not_lt.mp h2]
  · simp [h, RegMHnPlus, RegMHnMinus]

/-- **`T^{MH,n,+}`** (`lem:gain_2+`, lines 595-602, 622-624): bounded in the range of `thm:main`. -/
theorem MHplus_bound (n : Fin 3) {pv : Fin 3 → ℝ} {p : ℝ} (hp : 1 < p) (hp0 : 0 < pv 0)
    (hp1 : 2 < pv 1) (hp2 : 2 < pv 2) (hsum : 1 / p = 1 / pv 0 + 1 / pv 1 + 1 / pv 2)
    (hhalf : 1 / 2 ≤ 1 / pv 1 + 1 / pv 2) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)),
      eLpNorm (regComp (RegMHnPlus n) J f) (ENNReal.ofReal p) volume
        ≤ ENNReal.ofReal C *
          (eLpNorm (f 0) (ENNReal.ofReal (pv 0)) volume * (eLpNorm (f 1) (ENNReal.ofReal (pv 1)) volume *
            eLpNorm (f 2) (ENNReal.ofReal (pv 2)) volume)) :=
  regComp_gain_bound (RegMHnPlus n) (fun k hk => hk.1.1.1)
    (fun k hk i => by
      have h1 := kMin_le k i
      have h2 : kMin k = k n := hk.1.2
      have h3 := hk.2
      omega) hp hp0 hp1 hp2 hsum hhalf

/-- The bilinear average `A_ψ(g)(x) = ∫ ψ(t) ∏_{n=1}^2 g_n(x + t^{α_n} e_n) dt` on `ℝ^2`
(`blueprints/main.tex` lines 207-210). -/
def monomialAverage (α : Fin 2 → ℕ) (ψ : ℝ → ℝ) (g : Fin 2 → EuclideanSpace ℝ (Fin 2) → ℂ)
    (x : EuclideanSpace ℝ (Fin 2)) : ℂ :=
  ∫ t : ℝ, (ψ t : ℂ) * ∏ n, g n (x + (t ^ α n) • EuclideanSpace.single n (1 : ℝ))

/-- **`thm:smoothing_2`** (`blueprints/main.tex` lines 211-221), as stated in the source: let
`α_1, α_2` be distinct positive integers, `0 < a < b`. There is a constant `C` and, for every value
of `‖ψ'‖_1`, an exponent `δ = δ(a, b, ‖ψ'‖_1) > 0`, such that for every `ψ ∈ C^1(ℝ)` with
`supp ψ ⊆ [a, b]`, every `λ ≥ 1` and every couple of Schwartz functions `g_1, g_2` on `ℝ^2` with
`supp ĝ_n ⊆ {|ξ_n| ≥ λ}` for at least one `n`,
`‖A_ψ(g)‖_1 ≤ C (‖ψ‖_∞ + ‖ψ'‖_1) λ^{-δ} ‖g_1‖_2 ‖g_2‖_2`.

The source proves it only by reference ("analogous to Theorem 5 of CDR21", line 705); it is proved
as `Auto.smoothingTwo` from `Auto.monomial_smoothing` (blueprint
`blueprints/task_1_smoothing_inequality_2.tex`). -/
def SmoothingTwo : Prop :=
  ∀ α : Fin 2 → ℕ, (∀ n, 0 < α n) → α 0 ≠ α 1 →
  ∀ a b : ℝ, 0 < a → a < b →
  ∃ C : ℝ, 0 < C ∧ ∃ δ : ℝ → ℝ, (∀ v, 0 < δ v) ∧
  ∀ ψ : ℝ → ℝ, ContDiff ℝ 1 ψ → tsupport ψ ⊆ Set.Icc a b →
  ∀ lam : ℝ, 1 ≤ lam → ∀ g : Fin 2 → 𝓢(EuclideanSpace ℝ (Fin 2), ℂ),
    (∃ n, ∀ ξ, 𝓕 (g n : EuclideanSpace ℝ (Fin 2) → ℂ) ξ ≠ 0 → lam ≤ |ξ n|) →
    eLpNorm (monomialAverage α ψ fun n => ⇑(g n)) 1 volume
      ≤ ENNReal.ofReal (C * ((⨆ t, |ψ t|) + ∫ t, |deriv ψ t|) *
          lam ^ (-(δ (∫ t, |deriv ψ t|)))) *
        (eLpNorm (g 0) 2 volume * eLpNorm (g 1) 2 volume)

/-! ### Mixed frequencies MH: the grouped operators `T^{(k_2,k_3)}` (lines 579-593) -/

/-- The index pairs of the grouped operators for the low slot `n_0`: `p_{n_0} = 0`, the other two
indices differ by at most `100` and their maximum is positive (lines 590-593). -/
def PairReg (n0 : Fin 3) (p : Fin 3 → ℤ) : Prop :=
  p n0 = 0 ∧ 0 < kMax p ∧ kMax p - kMin (Function.update p n0 (kMax p)) ≤ 100

instance (n0 : Fin 3) (p : Fin 3 → ℤ) : Decidable (PairReg n0 p) := by
  unfold PairReg; infer_instance

/-- The cut `min(0, k^{(1)} - 101)` of the low slot: `k_{n_0} ≤ lowCut p` exactly on the fibre
of `F_{MH,n_0,-}` over `p` (the source takes `0`, valid for `k^{(1)} > 100`). -/
def lowCut (p : Fin 3 → ℤ) : ℤ := min 0 (kMax p - 101)

theorem max_facts (a b : ℤ) : (max a b = a ∨ max a b = b) ∧ a ≤ max a b ∧ b ≤ max a b :=
  ⟨max_choice a b, le_max_left a b, le_max_right a b⟩

theorem min_facts (a b : ℤ) : (min a b = a ∨ min a b = b) ∧ min a b ≤ a ∧ min a b ≤ b :=
  ⟨min_choice a b, min_le_left a b, min_le_right a b⟩

/-- `F_{MH,n_0,-}` is fibred over the pairs: `k ∈ F_{MH,n_0,-}` iff the pair `k` with its
`n_0`-th index set to `0` is admissible and `k_{n_0} ≤ lowCut`. -/
theorem regMHnMinus_iff (n0 : Fin 3) (k : Fin 3 → ℤ) :
    RegMHnMinus n0 k ↔
      PairReg n0 (Function.update k n0 0) ∧ k n0 ≤ lowCut (Function.update k n0 0) := by
  have h01 : (0 : Fin 3) ≠ 1 := by decide
  have h02 : (0 : Fin 3) ≠ 2 := by decide
  have h12 : (1 : Fin 3) ≠ 2 := by decide
  unfold RegMHnMinus RegMHn RegMH PairReg lowCut kMid kMax kMin
  fin_cases n0
  · simp only [Fin.zero_eta, Function.update_self, Function.update_of_ne h01.symm,
      Function.update_of_ne h02.symm]
    generalize k 0 = a; generalize k 1 = b; generalize k 2 = c
    have f1 := max_facts a b; have f2 := max_facts (max a b) c
    have g1 := min_facts a b; have g2 := min_facts (min a b) c
    have f3 := max_facts 0 b; have f4 := max_facts (max 0 b) c
    have g3 := min_facts (max (max 0 b) c) b; have g4 := min_facts (min (max (max 0 b) c) b) c
    have g5 := min_facts 0 (max (max 0 b) c - 101)
    generalize max a b = M1 at *; generalize max M1 c = M2 at *
    generalize min a b = N1 at *; generalize min N1 c = N2 at *
    generalize max 0 b = M3 at *; generalize max M3 c = M4 at *
    generalize min M4 b = N3 at *; generalize min N3 c = N4 at *
    generalize min 0 (M4 - 101) = N5 at *
    constructor <;> intro h <;> (casesm* _ ∧ _) <;> (repeat' constructor) <;> omega
  · simp only [Fin.mk_one, Function.update_self, Function.update_of_ne h01,
      Function.update_of_ne h12.symm]
    generalize k 0 = a; generalize k 1 = b; generalize k 2 = c
    have f1 := max_facts a b; have f2 := max_facts (max a b) c
    have g1 := min_facts a b; have g2 := min_facts (min a b) c
    have f3 := max_facts a 0; have f4 := max_facts (max a 0) c
    have g3 := min_facts a (max (max a 0) c); have g4 := min_facts (min a (max (max a 0) c)) c
    have g5 := min_facts 0 (max (max a 0) c - 101)
    generalize max a b = M1 at *; generalize max M1 c = M2 at *
    generalize min a b = N1 at *; generalize min N1 c = N2 at *
    generalize max a 0 = M3 at *; generalize max M3 c = M4 at *
    generalize min a M4 = N3 at *; generalize min N3 c = N4 at *
    generalize min 0 (M4 - 101) = N5 at *
    constructor <;> intro h <;> (casesm* _ ∧ _) <;> (repeat' constructor) <;> omega
  · simp only [Fin.reduceFinMk, Function.update_self, Function.update_of_ne h02,
      Function.update_of_ne h12]
    generalize k 0 = a; generalize k 1 = b; generalize k 2 = c
    have f1 := max_facts a b; have f2 := max_facts (max a b) c
    have g1 := min_facts a b; have g2 := min_facts (min a b) c
    have f4 := max_facts (max a b) 0
    have g4 := min_facts (min a b) (max (max a b) 0)
    have g5 := min_facts 0 (max (max a b) 0 - 101)
    generalize max a b = M1 at *; generalize max M1 c = M2 at *
    generalize min a b = N1 at *; generalize min N1 c = N2 at *
    generalize max M1 0 = M4 at *
    generalize min N1 M4 = N4 at *
    generalize min 0 (M4 - 101) = N5 at *
    constructor <;> intro h <;> (casesm* _ ∧ _) <;> (repeat' constructor) <;> omega

/-- The grouped single-scale piece `T_j(S^{(n_0)}_{(n_0+1) j + c} f_{n_0}, Δ f_n, Δ f_m)`. -/
def lowPiece (n0 : Fin 3) (j : ℤ) (p : Fin 3 → ℤ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) : ℂ :=
  simplexTj j (fun n => if n = n0 then ⇑(lpS n ((expo n : ℤ) * j + lowCut p) (f n))
    else ⇑(lpDelta n ((expo n : ℤ) * j + p n) (f n))) x

/-- The mask of the fibre over `p`: `k_{n_0} ≤ lowCut p`, `k_n = p_n` otherwise. -/
def lowMask (n0 : Fin 3) (p : Fin 3 → ℤ) (n : Fin 3) (m : ℤ) : Prop :=
  if n = n0 then m ≤ lowCut p else m = p n

instance (n0 : Fin 3) (p : Fin 3 → ℤ) (n : Fin 3) : DecidablePred (lowMask n0 p n) := by
  intro m; unfold lowMask; split_ifs <;> infer_instance

/-- The fibre of `F_{MH,n_0,-}` over an admissible pair sums to the grouped piece. -/
theorem hasSum_MH_fibre (n0 : Fin 3) (j : ℤ) (p : Fin 3 → ℤ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    HasSum (fun k => if (∀ n, lowMask n0 p n (k n)) then freqPiece j k f x else 0)
      (lowPiece n0 j p f x) := by
  set G : Fin 3 → 𝓢(E3, ℂ) := fun n => if n = n0 then
    lpS n ((expo n : ℤ) * j + lowCut p) (f n) else lpDelta n ((expo n : ℤ) * j + p n) (f n) with hG
  have e : lowPiece n0 j p f x = simplexTj j (fun n => ⇑(G n)) x := by
    unfold lowPiece; congr 1; funext n; simp only [hG]; split_ifs <;> rfl
  rw [e]
  refine hasSum_piece_mask j f x (lowMask n0 p) G fun n y => ?_
  by_cases hn : n = n0
  · subst hn
    simp only [lowMask, if_true, hG]
    exact hasSum_lpDelta_le n ((expo n : ℤ) * j) (lowCut p) (f n) y
  · simp only [lowMask, hn, if_false, hG]
    convert hasSum_ite_eq (p n) (lpDelta n ((expo n : ℤ) * j + p n) (f n) y) using 1
    funext t; split_ifs with h <;> simp [h]

theorem fibre_MHminus_iff (n0 : Fin 3) (p k : Fin 3 → ℤ) :
    (Function.update k n0 0 = p ∧ RegMHnMinus n0 k) ↔
      (PairReg n0 p ∧ ∀ n, lowMask n0 p n (k n)) := by
  constructor
  · rintro ⟨rfl, hR⟩
    obtain ⟨hP, hc⟩ := (regMHnMinus_iff n0 k).mp hR
    refine ⟨hP, fun n => ?_⟩
    unfold lowMask
    split_ifs with hn
    · subst hn; exact hc
    · rw [Function.update_of_ne hn]
  · rintro ⟨hP, hm⟩
    have hk : Function.update k n0 0 = p := by
      funext n
      by_cases hn : n = n0
      · subst hn; rw [Function.update_self]; exact hP.1.symm
      · rw [Function.update_of_ne hn]
        have := hm n; simp only [lowMask, hn, if_false] at this; exact this
    refine ⟨hk, (regMHnMinus_iff n0 k).mpr ?_⟩
    rw [hk]
    refine ⟨hP, ?_⟩
    have := hm n0; simp only [lowMask, if_true] at this; exact this

/-- **`T^{MH,n_0,-}` at scale `j` as a series of grouped pieces** (lines 590-593). -/
theorem hasSum_MH_pairs (n0 : Fin 3) (j : ℤ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    HasSum (fun p => if PairReg n0 p then lowPiece n0 j p f x else 0)
      (∑' k : Fin 3 → ℤ, if RegMHnMinus n0 k then freqPiece j k f x else 0) := by
  have hS := (summable_freqPiece_ite (RegMHnMinus n0) j f x).hasSum
  have hfib := hS.tsum_fiberwise (fun k => Function.update k n0 0)
  suffices hfun : (fun p => if PairReg n0 p then lowPiece n0 j p f x else 0)
      = (fun c => ∑' b : ((fun k : Fin 3 → ℤ => Function.update k n0 0) ⁻¹' {c}),
        if RegMHnMinus n0 (b : Fin 3 → ℤ) then freqPiece j b f x else 0) by
    rw [hfun]; exact hfib
  funext q
  symm
  rw [tsum_subtype ((fun k : Fin 3 → ℤ => Function.update k n0 0) ⁻¹' {q})
    (fun k => if RegMHnMinus n0 k then freqPiece j k f x else 0)]
  have e : (((fun k : Fin 3 → ℤ => Function.update k n0 0) ⁻¹' {q}).indicator
      (fun k => if RegMHnMinus n0 k then freqPiece j k f x else 0))
      = fun k => if PairReg n0 q ∧ (∀ n, lowMask n0 q n (k n)) then freqPiece j k f x else 0 := by
    funext k
    by_cases h : PairReg n0 q ∧ (∀ n, lowMask n0 q n (k n))
    · have h' := (fibre_MHminus_iff n0 q k).mpr h
      rw [indicator_of_mem (show k ∈ (fun k : Fin 3 → ℤ => Function.update k n0 0) ⁻¹' {q}
        from h'.1), if_pos h'.2, if_pos h]
    · rw [if_neg h]
      by_cases hk : Function.update k n0 0 = q
      · rw [indicator_of_mem (show k ∈ (fun k : Fin 3 → ℤ => Function.update k n0 0) ⁻¹' {q}
          from hk)]
        have : ¬ RegMHnMinus n0 k := fun hR => h ((fibre_MHminus_iff n0 q k).mp ⟨hk, hR⟩)
        rw [if_neg this]
      · rw [indicator_of_notMem (show k ∉ (fun k : Fin 3 → ℤ => Function.update k n0 0) ⁻¹' {q}
          from hk)]
  rw [e]
  by_cases hq : PairReg n0 q
  · simp only [hq, true_and, if_true]
    exact (hasSum_MH_fibre n0 j q f x).tsum_eq
  · simp [hq]

/-- The grouped operator `T^{(k_2,k_3)}_J = ∑_{|j| ≤ J} T_j(S f_{n_0}, Δ f_n, Δ f_m)`. -/
def lowComp (n0 : Fin 3) (p : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) : ℂ :=
  ∑ j ∈ Finset.Icc (-(J : ℤ)) J, lowPiece n0 j p f x

/-- **`T^{MH,n_0,-}_J = ∑_{pairs} T^{(k_2,k_3)}_J`** (lines 590-593), pointwise, with the series
converging. -/
theorem hasSum_regComp_MHminus (n0 : Fin 3) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) (x : E3) :
    HasSum (fun p => if PairReg n0 p then lowComp n0 p J f x else 0)
      (regComp (RegMHnMinus n0) J f x) := by
  unfold regComp
  have h := hasSum_sum (s := Finset.Icc (-(J : ℤ)) J) fun j _ => hasSum_MH_pairs n0 j f x
  convert h using 1
  funext p
  unfold lowComp
  split_ifs <;> simp

/-- The line convolution `h(D_ℓ) g(y) = ∫ ȟ(u) g(y - u e_ℓ) du` on general inputs. -/
def lineConvC (χ : CoordMult) (ℓ : Fin 3) (g : E3 → ℂ) (y : E3) : ℂ :=
  ∫ u : ℝ, χ.check u * g (y - u • basisVec ℓ)

theorem lineConvC_schwartz (χ : CoordMult) (ℓ : Fin 3) (g : 𝓢(E3, ℂ)) :
    lineConvC χ ℓ g = χ.op ℓ g := by
  funext y; rw [lineConvC, CoordMult.op_eq_lineConv]

theorem lineDelta_eq_lineConvC (ℓ : Fin 3) (m : ℤ) (g : E3 → ℂ) :
    lineDelta ℓ m g = lineConvC (psiCM m) ℓ g := rfl

/-- The operator family `∑_{|j| ≤ J} T_j(χ_{0,j}(D_1) g_1, χ_{1,j}(D_2) g_2, χ_{2,j}(D_3) g_3)` on
general inputs, the common form of `T^{(k)}_J` and of the grouped operators `T^{(k_2,k_3)}_J`. -/
def gOp (χ : Fin 3 → ℤ → CoordMult) (J : ℕ) (g : Fin 3 → E3 → ℂ) (x : E3) : ℂ :=
  ∑ j ∈ Finset.Icc (-(J : ℤ)) J, simplexTj j (fun n => lineConvC (χ n j) n (g n)) x

/-- The multiplier family of the grouped operator: `φ_{(n_0+1)j + lowCut p}` in the low slot `n_0`,
`ψ_{(n+1)j + p_n}` in the other slots. -/
def lowFam (n0 : Fin 3) (p : Fin 3 → ℤ) (n : Fin 3) (j : ℤ) : CoordMult :=
  if n = n0 then phiCM ((expo n : ℤ) * j + lowCut p) else psiCM ((expo n : ℤ) * j + p n)

theorem lowComp_eq_gOp (n0 : Fin 3) (p : Fin 3 → ℤ) (J : ℕ) (f : Fin 3 → 𝓢(E3, ℂ)) :
    lowComp n0 p J f = gOp (lowFam n0 p) J (fun n => ⇑(f n)) := by
  funext x
  unfold lowComp gOp lowPiece
  refine Finset.sum_congr rfl fun j _ => ?_
  congr 1; funext n
  rw [lineConvC_schwartz]
  unfold lowFam
  split_ifs <;> rfl

/-- The line kernel `ȟ` of an even real multiplier is real. -/
theorem CoordMult.check_im (χ : CoordMult) (a : ℝ) : (χ.check a).im = 0 := by
  have hconj : (starRingEnd ℂ) (χ.check a) = χ.check a := by
    rw [CoordMult.check_eq, ← integral_conj]
    rw [← integral_neg_eq_self]
    refine integral_congr_ae (Eventually.of_forall fun ζ => ?_)
    simp only [map_mul, Complex.conj_ofReal, χ.even]
    congr 1
    rw [← Circle.coe_inv_eq_conj, ← AddChar.map_neg_eq_inv, neg_mul, neg_neg]
  exact Complex.conj_eq_iff_im.mp hconj

theorem CoordMult.check_eq_re (χ : CoordMult) (a : ℝ) : χ.check a = ((χ.check a).re : ℂ) :=
  Complex.ext rfl (by simp [χ.check_im a])

/-! ### `lem:gain_2-` (lines 603-651) -/

/-- The fibre cutoff `ρ_s(t) = w_+(t) φ̌(t^{n_0+1} - s)` of lines 643-645 (`w_+(t) = ψ(t)/t` for
`t > 0`; `φ̌` is real). -/
def rhoCut (n0 : Fin 3) (s t : ℝ) : ℝ := wPos t * ((phiCM 0).check (t ^ expo n0 - s)).re

/-- The fibre average `B_s(y) = ∫ ρ_s(t) ∏_i G_i(y + t^{e_i} e_i) dt` over the two other slots. -/
def fibreAvg (n0 : Fin 3) (G : Fin 2 → E3 → ℂ) (s : ℝ) (y : E3) : ℂ :=
  ∫ t : ℝ, (rhoCut n0 s t : ℂ) * ∏ i, G i (y + curve (n0.succAbove i) t)

theorem integrable_wPos : Integrable wPos :=
  contDiff_wPos.continuous.integrable_of_hasCompactSupport
    (HasCompactSupport.intro isCompact_Icc (fun s hs => by
      by_contra h; exact hs (support_wPos (by simpa using h))))

theorem measurable_lineConvC (χ : CoordMult) (ℓ : Fin 3) {g : E3 → ℂ} (hg : Measurable g) :
    Measurable (lineConvC χ ℓ g) := by
  have h : StronglyMeasurable (Function.uncurry fun (y : E3) (u : ℝ) =>
      χ.check u * g (y - u • basisVec ℓ)) :=
    ((χ.check.continuous.measurable.comp measurable_snd).mul
      (hg.comp (measurable_lineShift ℓ))).stronglyMeasurable
  exact h.integral_prod_right'.measurable

/-- The substitution `s = t^{n_0+1} - u` in the low-pass line convolution. -/
theorem lineConvC_shift_eq (χ : CoordMult) (ℓ : Fin 3) (g : E3 → ℂ) (y : E3) (a : ℝ) :
    lineConvC χ ℓ g (y + a • basisVec ℓ) = ∫ s : ℝ, χ.check (a - s) * g (y + s • basisVec ℓ) := by
  unfold lineConvC
  rw [← integral_sub_left_eq_self (fun u => χ.check u * g (y + a • basisVec ℓ - u • basisVec ℓ))
    volume a]
  refine integral_congr_ae (Eventually.of_forall fun s => ?_)
  simp only
  congr 2
  rw [sub_smul]; abel

theorem continuous_curve_pow (n : Fin 3) (y : E3) :
    Continuous fun t : ℝ => y + curve n t := continuous_const.add (continuous_curve n)

/-- **The Fubini reduction to the fibre forms** (`lem:gain_2-` proof, lines 637-647), at scale `0`
and for the positive times: `𝒜_{w_+}(S g_0, G_1, G_2)(y) = ∫ g_0(y + s e_{n_0}) B_s(y) ds`. -/
theorem Apsi_low_eq (n0 : Fin 3) {g0 : E3 → ℂ} (hg0 : Measurable g0) {B : ℝ}
    (hB : ∀ y, ‖g0 y‖ ≤ B) {G : Fin 2 → E3 → ℂ} (hG : ∀ i, Continuous (G i)) {BG : ℝ}
    (hBG : ∀ i y, ‖G i y‖ ≤ BG) (y : E3) :
    Apsi wPos (Fin.insertNth n0 (lineConvC (phiCM 0) n0 g0) G) y
      = ∫ s : ℝ, g0 (y + s • basisVec n0) * fibreAvg n0 G s y := by
  set φc := (phiCM 0).check
  set P : ℝ → ℂ := fun t => ∏ i, G i (y + curve (n0.succAbove i) t) with hP
  have hPc : Continuous P := continuous_finsetProd _ fun i _ =>
    (hG i).comp (continuous_curve_pow _ y)
  have hPB : ∀ t, ‖P t‖ ≤ BG ^ 2 := fun t => by
    rw [hP, norm_prod]
    calc ∏ i, ‖G i (y + curve (n0.succAbove i) t)‖ ≤ ∏ _i : Fin 2, BG :=
          Finset.prod_le_prod (fun i _ => norm_nonneg _) fun i _ => hBG i _
      _ = BG ^ 2 := by simp
  set K : ℝ × ℝ → ℂ := fun q => (wPos q.1 : ℂ) * (φc (q.1 ^ expo n0 - q.2) *
    g0 (y + q.2 • basisVec n0)) * P q.1 with hK
  have hKm : AEStronglyMeasurable K (volume.prod volume) := by
    refine Measurable.aestronglyMeasurable ?_
    refine ((Complex.continuous_ofReal.comp contDiff_wPos.continuous).measurable.comp
      measurable_fst |>.mul ?_).mul (hPc.measurable.comp measurable_fst)
    exact (φc.continuous.measurable.comp ((measurable_fst.pow_const _).sub measurable_snd)).mul
      (hg0.comp (measurable_const.add (measurable_snd.smul_const _)))
  have hKi : Integrable K (volume.prod volume) := by
    have hB0 : 0 ≤ B := (norm_nonneg _).trans (hB y)
    set M : ℝ × ℝ → ℝ := fun q => B * BG ^ 2 * (|wPos q.1| * ‖φc (q.1 ^ expo n0 - q.2)‖) with hM
    have hMi : Integrable M (volume.prod volume) := by
      refine Integrable.const_mul ?_ _
      refine (integrable_prod_iff ?_).mpr ⟨Eventually.of_forall fun t => ?_, ?_⟩
      · exact (((continuous_abs.comp contDiff_wPos.continuous).comp continuous_fst).mul
          (φc.continuous.norm.comp ((continuous_fst.pow _).sub continuous_snd))).aestronglyMeasurable
      · exact ((φc.integrable (μ := volume)).norm.comp_sub_left (t ^ expo n0)).const_mul |wPos t|
      · have e : (fun t => ∫ s, ‖|wPos t| * ‖φc (t ^ expo n0 - s)‖‖)
            = fun t => |wPos t| * ∫ u, ‖φc u‖ := by
          funext t
          simp only [norm_mul, Real.norm_eq_abs, abs_abs, abs_norm]
          rw [integral_const_mul, integral_sub_left_eq_self (fun u => ‖φc u‖) (μ := volume) (t ^ expo n0)]
        rw [e]; exact integrable_wPos.abs.mul_const _
    refine hMi.mono' hKm (Eventually.of_forall fun q => ?_)
    simp only [hK, hM, norm_mul, Complex.norm_real, Real.norm_eq_abs]
    have h1 := hB (y + q.2 • basisVec n0)
    have h2 := hPB q.1
    have h3 := mul_le_mul h1 h2 (norm_nonneg _) hB0
    calc |wPos q.1| * (‖φc (q.1 ^ expo n0 - q.2)‖ * ‖g0 (y + q.2 • basisVec n0)‖) * ‖P q.1‖
        = (|wPos q.1| * ‖φc (q.1 ^ expo n0 - q.2)‖) * (‖g0 (y + q.2 • basisVec n0)‖ * ‖P q.1‖) := by
          ring
      _ ≤ (|wPos q.1| * ‖φc (q.1 ^ expo n0 - q.2)‖) * (B * BG ^ 2) :=
          mul_le_mul_of_nonneg_left h3 (by positivity)
      _ = B * BG ^ 2 * (|wPos q.1| * ‖φc (q.1 ^ expo n0 - q.2)‖) := by ring
  have hprod : ∀ t, prodShift (Fin.insertNth n0 (lineConvC (phiCM 0) n0 g0) G) y t
      = lineConvC (phiCM 0) n0 g0 (y + (t ^ expo n0) • basisVec n0) * P t := by
    intro t
    rw [prodShift, Fin.prod_univ_succAbove _ n0, Fin.insertNth_apply_same]
    simp only [Fin.insertNth_apply_succAbove, hP, curve]
  calc Apsi wPos (Fin.insertNth n0 (lineConvC (phiCM 0) n0 g0) G) y
      = ∫ t, ∫ s, K (t, s) := by
        unfold Apsi
        refine integral_congr_ae (Eventually.of_forall fun t => ?_)
        simp only [hprod, lineConvC_shift_eq, hK]
        rw [← integral_mul_const, ← integral_const_mul]
        refine integral_congr_ae (Eventually.of_forall fun s => ?_)
        simp only
        ring
    _ = ∫ s, ∫ t, K (t, s) := integral_integral_swap hKi
    _ = _ := by
        refine integral_congr_ae (Eventually.of_forall fun s => ?_)
        simp only [hK, fibreAvg, rhoCut]
        rw [← integral_const_mul]
        refine integral_congr_ae (Eventually.of_forall fun t => ?_)
        simp only [hP]
        rw [CoordMult.check_eq_re (phiCM 0) (t ^ expo n0 - s)]
        simp only [Complex.ofReal_re]
        push_cast
        ring

/-- The plane `ℝ^2`. -/
abbrev E2 : Type := EuclideanSpace ℝ (Fin 2)

/-- The embedding of the plane of the two slots other than `n_0`:
`z ↦ z_1 e_{σ(1)} + z_2 e_{σ(2)}`, `σ = succAbove n_0`. -/
def slotEmb (n0 : Fin 3) : E2 →L[ℝ] E3 :=
  ∑ i : Fin 2, (EuclideanSpace.proj (𝕜 := ℝ) i).smulRight (basisVec (n0.succAbove i))

theorem slotEmb_apply (n0 : Fin 3) (z : E2) :
    slotEmb n0 z = ∑ i : Fin 2, z i • basisVec (n0.succAbove i) := by
  simp [slotEmb]

theorem slotEmb_apply_self (n0 : Fin 3) (z : E2) : slotEmb n0 z n0 = 0 := by
  rw [slotEmb_apply]
  simp [basisVec_apply, Fin.succAbove_ne]

theorem slotEmb_apply_succAbove (n0 : Fin 3) (z : E2) (i : Fin 2) :
    slotEmb n0 z (n0.succAbove i) = z i := by
  rw [slotEmb_apply]
  simp [basisVec_apply]
  fin_cases i <;> simp

theorem slotEmb_injective (n0 : Fin 3) : Function.Injective (slotEmb n0) := by
  intro z z' h
  ext i
  have := congrArg (fun y : E3 => y (n0.succAbove i)) h
  simpa only [slotEmb_apply_succAbove] using this

theorem slotEmb_single (n0 : Fin 3) (i : Fin 2) (c : ℝ) :
    slotEmb n0 (EuclideanSpace.single i c) = c • basisVec (n0.succAbove i) := by
  ext m
  rw [slotEmb_apply]
  simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, basisVec_apply, PiLp.single_apply,
    WithLp.ofLp_sum, Finset.sum_apply]
  rw [Finset.sum_eq_single i]
  · simp
  · intro b _ hb; simp [hb]
  · simp

/-- The fibre point `ι_w(z) = w e_{n_0} + slotEmb z`. -/
def fibrePt (n0 : Fin 3) (w : ℝ) (z : E2) : E3 := slotEmb n0 z + w • basisVec n0

/-- The fibre `z ↦ g(ι_w(z))` of a Schwartz function as a Schwartz function on the plane. -/
def fibreS2 (n0 : Fin 3) (w : ℝ) (g : 𝓢(E3, ℂ)) : 𝓢(E2, ℂ) :=
  Twisted.schwartzAffinePullbackOfInjective (𝕜 := ℂ) (slotEmb n0) (slotEmb_injective n0)
    (w • basisVec n0) g

theorem fibreS2_apply (n0 : Fin 3) (w : ℝ) (g : 𝓢(E3, ℂ)) (z : E2) :
    fibreS2 n0 w g z = g (fibrePt n0 w z) := by
  simp [fibreS2, Twisted.schwartzAffinePullbackOfInjective_apply, fibrePt]

theorem fibrePt_add_curve (n0 : Fin 3) (w : ℝ) (z : E2) (i : Fin 2) (t : ℝ) :
    fibrePt n0 w z + curve (n0.succAbove i) t
      = fibrePt n0 w (z + (t ^ expo (n0.succAbove i)) • EuclideanSpace.single i (1 : ℝ)) := by
  simp only [fibrePt, map_add, map_smul, slotEmb_single, curve, one_smul]
  abel

/-- The exponents of the two other slots, which are distinct and positive. -/
def slotExpo (n0 : Fin 3) (i : Fin 2) : ℕ := expo (n0.succAbove i)

theorem slotExpo_pos (n0 : Fin 3) (i : Fin 2) : 0 < slotExpo n0 i := expo_pos _

theorem slotExpo_ne (n0 : Fin 3) : slotExpo n0 0 ≠ slotExpo n0 1 := by
  unfold slotExpo expo
  intro h
  have := Fin.succAbove_right_injective (p := n0) (Fin.ext (by omega : ((n0.succAbove 0 : Fin 3) : ℕ)
    = (n0.succAbove 1 : Fin 3)) |> fun h' => h')
  exact absurd this (by decide)

/-- **The fibre average is the bilinear monomial average on each fibre** (lines 643-647). -/
theorem fibreAvg_fibrePt (n0 : Fin 3) (G : Fin 2 → E3 → ℂ) (s w : ℝ) (z : E2) :
    fibreAvg n0 G s (fibrePt n0 w z)
      = monomialAverage (slotExpo n0) (rhoCut n0 s) (fun i v => G i (fibrePt n0 w v)) z := by
  unfold fibreAvg monomialAverage
  refine integral_congr_ae (Eventually.of_forall fun t => ?_)
  simp only [fibrePt_add_curve, slotExpo]

theorem fibrePt_sub (n0 : Fin 3) (w : ℝ) (z : E2) (i : Fin 2) (u : ℝ) :
    fibrePt n0 w z - u • basisVec (n0.succAbove i)
      = fibrePt n0 w (z - u • EuclideanSpace.single i (1 : ℝ)) := by
  simp only [fibrePt, map_sub, map_smul, slotEmb_single, one_smul]
  abel

theorem inner_single_E2 (η : E2) (i : Fin 2) (u : ℝ) :
    inner ℝ (u • EuclideanSpace.single i (1 : ℝ)) η = u * η i := by
  rw [inner_smul_left, EuclideanSpace.inner_single_left]; simp [mul_comm]

/-- **The Fourier transform of a line convolution on the plane**:
`𝓕(z ↦ ∫ ȟ(u) F(z - u e_i) du)(η) = h(η_i) F̂(η)`. -/
theorem fourier_lineConv_E2 (χ : CoordMult) (i : Fin 2) (F : 𝓢(E2, ℂ)) (η : E2) :
    𝓕 (fun z : E2 => ∫ u : ℝ, χ.check u * F (z - u • EuclideanSpace.single i (1 : ℝ))) η
      = ((χ.h (η i) : ℝ) : ℂ) * 𝓕 (F : E2 → ℂ) η := by
  set e : E2 := EuclideanSpace.single i (1 : ℝ)
  rw [Real.fourier_eq, Real.fourier_eq]
  set K : E2 × ℝ → ℂ := fun q => (Real.fourierChar (-(inner ℝ q.1 η)) : ℂ) *
    (χ.check q.2 * F (q.1 - q.2 • e)) with hK
  have hKi : Integrable K (volume.prod volume) := by
    have hKc : Continuous K :=
      (continuous_subtype_val.comp (Real.continuous_fourierChar.comp
        (continuous_fst.inner continuous_const).neg)).mul
        ((χ.check.continuous.comp continuous_snd).mul
          (F.continuous.comp (continuous_fst.sub (continuous_snd.smul continuous_const))))
    have hm : AEStronglyMeasurable K (volume.prod volume) := hKc.aestronglyMeasurable
    refine (integrable_prod_iff' hm).mpr ⟨Eventually.of_forall fun u => ?_, ?_⟩
    · refine ((F.integrable (μ := volume)).comp_sub_right (u • e)).const_mul (χ.check u) |>.norm
        |>.mono' ((hKc.comp (continuous_id.prodMk continuous_const)).aestronglyMeasurable)
          (Eventually.of_forall fun z => ?_)
      simp [hK, norm_mul, Circle.norm_coe]
    · have e1 : (fun u => ∫ z, ‖K (z, u)‖) = fun u => ‖χ.check u‖ * ∫ z, ‖F z‖ := by
        funext u
        simp only [hK, norm_mul, Circle.norm_coe, one_mul]
        rw [integral_const_mul, integral_sub_right_eq_self (fun z => ‖F z‖) (μ := volume) (u • e)]
      rw [e1]; exact (χ.check.integrable.norm).mul_const _
  calc ∫ z, (Real.fourierChar (-(inner ℝ z η)) : ℂ) •
        ∫ u, χ.check u * F (z - u • e)
      = ∫ z, ∫ u, K (z, u) := by
        refine integral_congr_ae (Eventually.of_forall fun z => ?_)
        simp only [hK, Circle.smul_def, smul_eq_mul]; rw [integral_const_mul]
    _ = ∫ u, ∫ z, K (z, u) := integral_integral_swap hKi
    _ = ∫ u, (Real.fourierChar (-(u * η i)) : ℂ) * χ.check u *
          ∫ z, (Real.fourierChar (-(inner ℝ z η)) : ℂ) * F z := by
        refine integral_congr_ae (Eventually.of_forall fun u => ?_)
        simp only [hK]
        rw [← integral_const_mul, ← integral_add_right_eq_self
          (fun z => (Real.fourierChar (-(inner ℝ z η)) : ℂ) * (χ.check u * F (z - u • e))) (u • e)]
        refine integral_congr_ae (Eventually.of_forall fun z => ?_)
        simp only
        rw [add_sub_cancel_right, inner_add_left, show inner ℝ (u • e) η = u * η i from
          inner_single_E2 η i u, neg_add, AddChar.map_add_eq_mul, Circle.coe_mul]
        ring
    _ = _ := by
        rw [integral_mul_const, χ.h_eq_fourier_check (η i)]
        congr 1
        all_goals (refine integral_congr_ae (Eventually.of_forall fun _ => ?_); simp [Circle.smul_def])

/-- The fibre of `Δ^{(σ(i))}_m f` is the line convolution of the fibre of `f`. -/
theorem fibreS2_lpDelta (n0 : Fin 3) (w : ℝ) (i : Fin 2) (m : ℤ) (f : 𝓢(E3, ℂ)) :
    (fibreS2 n0 w (lpDelta (n0.succAbove i) m f) : E2 → ℂ)
      = fun z => ∫ u : ℝ, (psiCM m).check u *
          fibreS2 n0 w f (z - u • EuclideanSpace.single i (1 : ℝ)) := by
  funext z
  rw [fibreS2_apply, ← psiCM_op, CoordMult.op_eq_lineConv]
  refine integral_congr_ae (Eventually.of_forall fun u => ?_)
  simp only [fibreS2_apply, fibrePt_sub]

/-- **The frequency support of the fibres** (the hypothesis of `thm:smoothing_2` in line 648):
`supp 𝓕(fibre of Δ^{(σ(i))}_m f) ⊆ {|η_i| ≥ 2^{m-1}}`. -/
theorem fourier_fibreS2_lpDelta_support (n0 : Fin 3) (w : ℝ) (i : Fin 2) (m : ℤ)
    (f : 𝓢(E3, ℂ)) (η : E2)
    (h : 𝓕 (fibreS2 n0 w (lpDelta (n0.succAbove i) m f) : E2 → ℂ) η ≠ 0) :
    (2 : ℝ) ^ (m - 1) ≤ |η i| := by
  rw [fibreS2_lpDelta, fourier_lineConv_E2] at h
  exact (lpPsiJ_support (fun h0 => h (by simp only [psiCM]; rw [h0]; simp))).1

/-- Quadratic decay of a Schwartz function on the line. -/
theorem schwartz_decay_two (f : 𝓢(ℝ, ℂ)) : ∃ K : ℝ, 0 ≤ K ∧ ∀ u, ‖f u‖ ≤ K * ((1 + |u|) ^ 2)⁻¹ := by
  set K : ℝ := 2 ^ 2 * (Finset.Iic ((2 : ℕ), (0 : ℕ))).sup
    (fun m => SchwartzMap.seminorm ℝ m.1 m.2) f
  refine ⟨K, by positivity, fun u => ?_⟩
  have h := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := ((2 : ℕ), (0 : ℕ)))
    (k := 2) (n := 0) le_rfl le_rfl f u
  rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at h
  have hpos : 0 < (1 + |u|) ^ 2 := by positivity
  rw [← div_eq_mul_inv, le_div_iff₀ hpos, mul_comm]
  exact h

theorem decay_shift_le (e : ℕ) {t : ℝ} (ht : t ∈ Icc (1 / 2 : ℝ) 2) (s : ℝ) :
    ((1 + |t ^ e - s|) ^ 2)⁻¹ ≤ (1 + 2 ^ e) ^ 2 * ((1 + |s|) ^ 2)⁻¹ := by
  have ht0 : 0 ≤ t := by linarith [ht.1]
  have hte : |t ^ e| ≤ 2 ^ e := by
    rw [abs_of_nonneg (pow_nonneg ht0 e)]; exact pow_le_pow_left₀ ht0 ht.2 e
  have htri : 1 + |s| ≤ (1 + |t ^ e - s|) * (1 + 2 ^ e) := by
    have : |s| ≤ |t ^ e - s| + |t ^ e| := by
      rw [show s = t ^ e - (t ^ e - s) by ring]; rw [show t ^ e - (t ^ e - (t ^ e - s)) = t ^ e - s by ring]
      exact (abs_sub _ _).trans (by rw [add_comm])
    nlinarith [abs_nonneg (t ^ e - s), abs_nonneg s, hte,
      mul_nonneg (abs_nonneg (t ^ e - s)) (by positivity : (0 : ℝ) ≤ 2 ^ e)]
  have h1 : 0 < 1 + |t ^ e - s| := by positivity
  have h2 : 0 < 1 + |s| := by positivity
  rw [← div_eq_mul_inv, le_div_iff₀ (by positivity), inv_mul_eq_div, div_le_iff₀ (by positivity)]
  have := pow_le_pow_left₀ h2.le htri 2
  nlinarith [this]

theorem tsupport_wPos : tsupport wPos ⊆ Icc (1 / 2) 2 :=
  closure_minimal support_wPos isClosed_Icc

theorem contDiff_rhoCut (n0 : Fin 3) (s : ℝ) : ContDiff ℝ 1 (rhoCut n0 s) := by
  unfold rhoCut
  refine (contDiff_wPos.of_le (by exact_mod_cast le_top)).mul ?_
  refine Complex.reCLM.contDiff.comp ?_
  exact ((phiCM 0).check.smooth 1).comp ((contDiff_id.pow _).sub contDiff_const)

theorem tsupport_rhoCut (n0 : Fin 3) (s : ℝ) : tsupport (rhoCut n0 s) ⊆ Icc (1 / 2) 2 := by
  refine (tsupport_mul_subset_left).trans tsupport_wPos

theorem wPos_eq_zero_of_notMem {t : ℝ} (ht : t ∉ Icc (1 / 2 : ℝ) 2) : wPos t = 0 := by
  by_contra h; exact ht (support_wPos h)

theorem deriv_wPos_eq_zero_of_notMem {t : ℝ} (ht : t ∉ Icc (1 / 2 : ℝ) 2) : deriv wPos t = 0 := by
  by_contra h
  exact ht (tsupport_wPos (tsupport_deriv_subset (subset_tsupport _ h)))

theorem hasDerivAt_rhoCut (n0 : Fin 3) (s t : ℝ) :
    HasDerivAt (rhoCut n0 s) (deriv wPos t * ((phiCM 0).check (t ^ expo n0 - s)).re +
      wPos t * ((deriv (phiCM 0).check (t ^ expo n0 - s)).re * ((expo n0 : ℝ) * t ^ (expo n0 - 1))))
      t := by
  have hw : HasDerivAt wPos (deriv wPos t) t :=
    ((contDiff_wPos.differentiable (by simp)) t).hasDerivAt
  have hin : HasDerivAt (fun t : ℝ => t ^ expo n0 - s) ((expo n0 : ℝ) * t ^ (expo n0 - 1)) t := by
    simpa using (hasDerivAt_pow (expo n0) t).sub_const s
  have hc : HasDerivAt (phiCM 0).check (deriv (phiCM 0).check (t ^ expo n0 - s)) (t ^ expo n0 - s) :=
    ((phiCM 0).check.differentiableAt).hasDerivAt
  have hcomp := hc.scomp t hin
  have hre := (Complex.reCLM.hasFDerivAt.comp_hasDerivAt t hcomp)
  simp only [Complex.reCLM_apply, Function.comp_def] at hre
  have := hw.mul hre
  rw [show rhoCut n0 s = wPos * fun x => ((phiCM 0).check (x ^ expo n0 - s)).re from rfl]
  refine this.congr_deriv ?_
  simp only [Complex.smul_re, smul_eq_mul, Pi.mul_apply]; ring

/-- **The decay of the fibre cutoffs** (line 651, "the rapid decay of `φ̌`"):
`‖ρ_s‖_∞ + ‖ρ_s'‖_1 ≲ (1 + |s|)^{-2}`. -/
theorem rhoCut_bound (n0 : Fin 3) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ s : ℝ,
      (⨆ t, |rhoCut n0 s t|) + ∫ t, |deriv (rhoCut n0 s) t| ≤ K * ((1 + |s|) ^ 2)⁻¹ := by
  set e := expo n0
  obtain ⟨K1, hK10, hK1⟩ := schwartz_decay_two (phiCM 0).check
  obtain ⟨K2, hK20, hK2⟩ := schwartz_decay_two (SchwartzMap.derivCLM ℝ ℂ (phiCM 0).check)
  obtain ⟨W, hW⟩ := isCompact_Icc.exists_bound_of_continuousOn
    (contDiff_wPos.continuous.continuousOn (s := Icc (1 / 2 : ℝ) 2))
  obtain ⟨Wd, hWd⟩ := isCompact_Icc.exists_bound_of_continuousOn
    ((contDiff_wPos.continuous_deriv (by exact_mod_cast le_top)).continuousOn
      (s := Icc (1 / 2 : ℝ) 2))
  have hW0 : 0 ≤ W := (norm_nonneg _).trans (hW 1 ⟨by norm_num, by norm_num⟩)
  have hWd0 : 0 ≤ Wd := (norm_nonneg _).trans (hWd 1 ⟨by norm_num, by norm_num⟩)
  set D : ℝ := (1 + 2 ^ e) ^ 2
  set M : ℝ := (Wd * K1 + W * K2 * (e * 2 ^ e)) * D
  refine ⟨W * K1 * D + 2 * M, by positivity, fun s => ?_⟩
  set v : ℝ := ((1 + |s|) ^ 2)⁻¹
  have hv0 : 0 ≤ v := by positivity
  have hdec : ∀ t ∈ Icc (1 / 2 : ℝ) 2, ‖(phiCM 0).check (t ^ e - s)‖ ≤ K1 * (D * v) := fun t ht =>
    (hK1 _).trans (mul_le_mul_of_nonneg_left (decay_shift_le e ht s) hK10)
  have hdec' : ∀ t ∈ Icc (1 / 2 : ℝ) 2, ‖deriv (phiCM 0).check (t ^ e - s)‖ ≤ K2 * (D * v) :=
    fun t ht => by
      rw [← SchwartzMap.derivCLM_apply ℝ]
      exact (hK2 _).trans (mul_le_mul_of_nonneg_left (decay_shift_le e ht s) hK20)
  -- the sup
  have hsup : ∀ t, |rhoCut n0 s t| ≤ W * K1 * D * v := by
    intro t
    by_cases ht : t ∈ Icc (1 / 2 : ℝ) 2
    · rw [rhoCut, abs_mul]
      calc |wPos t| * |((phiCM 0).check (t ^ e - s)).re|
          ≤ W * (K1 * (D * v)) := mul_le_mul (by simpa using hW t ht)
            ((Complex.abs_re_le_norm _).trans (hdec t ht)) (abs_nonneg _) hW0
        _ = W * K1 * D * v := by ring
    · rw [rhoCut, wPos_eq_zero_of_notMem ht, zero_mul, abs_zero]; positivity
  -- the derivative
  have hder : ∀ t, |deriv (rhoCut n0 s) t| ≤ (Icc (1 / 2 : ℝ) 2).indicator (fun _ => M * v) t := by
    intro t
    rw [(hasDerivAt_rhoCut n0 s t).deriv]
    by_cases ht : t ∈ Icc (1 / 2 : ℝ) 2
    · rw [indicator_of_mem ht]
      have ht0 : 0 ≤ t := by linarith [ht.1]
      have hpow : |(e : ℝ) * t ^ (e - 1)| ≤ e * 2 ^ e := by
        rw [abs_mul, Nat.abs_cast, abs_of_nonneg (pow_nonneg ht0 _)]
        refine mul_le_mul_of_nonneg_left ?_ (Nat.cast_nonneg _)
        calc t ^ (e - 1) ≤ 2 ^ (e - 1) := pow_le_pow_left₀ ht0 ht.2 _
          _ ≤ 2 ^ e := pow_le_pow_right₀ (by norm_num) (Nat.sub_le e 1)
      calc |deriv wPos t * ((phiCM 0).check (t ^ e - s)).re +
            wPos t * ((deriv (phiCM 0).check (t ^ e - s)).re * ((e : ℝ) * t ^ (e - 1)))|
          ≤ |deriv wPos t| * |((phiCM 0).check (t ^ e - s)).re| +
            |wPos t| * (|(deriv (phiCM 0).check (t ^ e - s)).re| * |(e : ℝ) * t ^ (e - 1)|) := by
            rw [← abs_mul, ← abs_mul, ← abs_mul]; exact abs_add_le _ _
        _ ≤ Wd * (K1 * (D * v)) + W * ((K2 * (D * v)) * (e * 2 ^ e)) := by
            gcongr
            · simpa using hWd t ht
            · exact (Complex.abs_re_le_norm _).trans (hdec t ht)
            · simpa using hW t ht
            · exact (Complex.abs_re_le_norm _).trans (hdec' t ht)
        _ = M * v := by ring
    · rw [indicator_of_notMem ht, deriv_wPos_eq_zero_of_notMem ht, wPos_eq_zero_of_notMem ht]
      simp
  have hint : ∫ t, |deriv (rhoCut n0 s) t| ≤ 2 * M * v := by
    calc ∫ t, |deriv (rhoCut n0 s) t|
        ≤ ∫ t, (Icc (1 / 2 : ℝ) 2).indicator (fun _ => M * v) t :=
          integral_mono_of_nonneg (Eventually.of_forall fun t => abs_nonneg _)
            ((integrableOn_const (C := M * v) measure_Icc_lt_top.ne).integrable_indicator measurableSet_Icc) (Eventually.of_forall hder)
      _ = (3 / 2) * (M * v) := by
          rw [integral_indicator measurableSet_Icc, setIntegral_const, Real.volume_real_Icc]
          norm_num
      _ ≤ 2 * M * v := by nlinarith [mul_nonneg (show 0 ≤ M by positivity) hv0]
  have hsup' : (⨆ t, |rhoCut n0 s t|) ≤ W * K1 * D * v := ciSup_le hsup
  nlinarith [hsup', hint]

theorem monomialAverage_smul (α : Fin 2 → ℕ) (c : ℝ) (ψ : ℝ → ℝ) (g : Fin 2 → E2 → ℂ) :
    monomialAverage α (fun t => c * ψ t) g = (c : ℂ) • monomialAverage α ψ g := by
  funext x
  simp only [monomialAverage, Pi.smul_apply, smul_eq_mul, ← integral_const_mul]
  congr 1; funext t; push_cast; ring

/-- A `C^1` function with support in `[a, b]` and `∫ |ψ'| = 0` vanishes. -/
theorem eq_zero_of_integral_abs_deriv {ψ : ℝ → ℝ} (hψ : ContDiff ℝ 1 ψ) {a b : ℝ} (ha : 0 < a)
    (hs : tsupport ψ ⊆ Icc a b) (h0 : ∫ t, |deriv ψ t| = 0) : ψ = 0 := by
  have hdc : Continuous (deriv ψ) := hψ.continuous_deriv le_rfl
  have hcs : HasCompactSupport (deriv ψ) :=
    (HasCompactSupport.of_support_subset_isCompact isCompact_Icc
      (subset_tsupport ψ |>.trans hs) : HasCompactSupport ψ).deriv
  have hint : Integrable fun t => |deriv ψ t| := (hdc.integrable_of_hasCompactSupport hcs).abs
  have hae := (integral_eq_zero_iff_of_nonneg (fun t => abs_nonneg _) hint).mp h0
  have hz : (fun t => |deriv ψ t|) = 0 :=
    (hdc.abs.ae_eq_iff_eq volume continuous_const).mp hae
  have hd : ∀ t, deriv ψ t = 0 := fun t => abs_eq_zero.mp (congrFun hz t)
  have hconst := is_const_of_deriv_eq_zero (hψ.differentiable (by norm_num)) hd
  have hψ0 : ψ 0 = 0 := by
    by_contra h
    have := hs (subset_tsupport ψ h)
    linarith [this.1]
  funext t; rw [hconst t 0, hψ0]; rfl

theorem bddAbove_abs_of_contDiff {ψ : ℝ → ℝ} (hψ : ContDiff ℝ 1 ψ) {a b : ℝ}
    (hs : tsupport ψ ⊆ Icc a b) : BddAbove (Set.range fun t => |ψ t|) := by
  obtain ⟨C, hC⟩ := isCompact_Icc.exists_bound_of_continuousOn (hψ.continuous.continuousOn
    (s := Icc a b))
  refine ⟨max C 0, ?_⟩
  rintro _ ⟨t, rfl⟩
  by_cases ht : t ∈ Icc a b
  · exact (by simpa using hC t ht : |ψ t| ≤ C).trans (le_max_left _ _)
  · have : ψ t = 0 := by by_contra h; exact ht (hs (subset_tsupport ψ h))
    simp [this]

/-- **`thm:smoothing_2` with a uniform exponent** on cutoffs supported in `[1/2, 2]`: normalizing
`‖ψ'‖_1 = 1` (the estimate is homogeneous in `ψ`), one exponent `δ = δ(1/2, 2, 1)` serves all
cutoffs, with constant `C (‖ψ‖_∞ + ‖ψ'‖_1)`. -/
theorem smoothingTwo_uniform (hS : SmoothingTwo) (α : Fin 2 → ℕ) (hα : ∀ n, 0 < α n)
    (hα' : α 0 ≠ α 1) :
    ∃ C δ : ℝ, 0 < C ∧ 0 < δ ∧ ∀ ψ : ℝ → ℝ, ContDiff ℝ 1 ψ → tsupport ψ ⊆ Icc (1 / 2) 2 →
      ∀ lam : ℝ, 1 ≤ lam → ∀ g : Fin 2 → 𝓢(E2, ℂ),
        (∃ n, ∀ ξ, 𝓕 (g n : E2 → ℂ) ξ ≠ 0 → lam ≤ |ξ n|) →
        eLpNorm (monomialAverage α ψ fun n => ⇑(g n)) 1 volume
          ≤ ENNReal.ofReal (C * ((⨆ t, |ψ t|) + ∫ t, |deriv ψ t|) * lam ^ (-δ)) *
            (eLpNorm (g 0) 2 volume * eLpNorm (g 1) 2 volume) := by
  obtain ⟨C, hC, δf, hδf, hmain⟩ := hS α hα hα' (1 / 2) 2 (by norm_num) (by norm_num)
  refine ⟨C, δf 1, hC, hδf 1, fun ψ hψ hs lam hlam g hg => ?_⟩
  set c := ∫ t, |deriv ψ t| with hc
  have hc0 : 0 ≤ c := integral_nonneg fun t => abs_nonneg _
  rcases hc0.eq_or_lt with h | h
  · have hz := eq_zero_of_integral_abs_deriv hψ (by norm_num) hs h.symm
    have : monomialAverage α ψ (fun n => ⇑(g n)) = 0 := by
      funext x; simp [monomialAverage, hz]
    rw [this, eLpNorm_zero]; exact bot_le
  set ψ' : ℝ → ℝ := fun t => c⁻¹ * ψ t with hψ'
  have hψ'c : ContDiff ℝ 1 ψ' := contDiff_const.mul hψ
  have hψ's : tsupport ψ' ⊆ Icc (1 / 2) 2 := (tsupport_mul_subset_right).trans hs
  have hderiv : ∀ t, deriv ψ' t = c⁻¹ * deriv ψ t := fun t => by
    rw [hψ', deriv_const_mul _ ((hψ.differentiable (by norm_num)) t)]
  have hint1 : ∫ t, |deriv ψ' t| = 1 := by
    simp only [hderiv, abs_mul, abs_inv, abs_of_pos h]
    rw [integral_const_mul, ← hc, inv_mul_cancel₀ h.ne']
  have hmain' := hmain ψ' hψ'c hψ's lam hlam g hg
  rw [hint1] at hmain'
  have hbdd := bddAbove_abs_of_contDiff hψ hs
  have hsup : (⨆ t, |ψ' t|) ≤ c⁻¹ * ⨆ t, |ψ t| := ciSup_le fun t => by
    simp only [hψ', abs_mul, abs_inv, abs_of_pos h]
    exact mul_le_mul_of_nonneg_left (le_ciSup hbdd t) (by positivity)
  have hsup0 : 0 ≤ ⨆ t, |ψ' t| := (abs_nonneg _).trans (le_ciSup (bddAbove_abs_of_contDiff hψ'c hψ's) 0)
  have heq : monomialAverage α ψ (fun n => ⇑(g n))
      = (c : ℂ) • monomialAverage α ψ' (fun n => ⇑(g n)) := by
    rw [hψ', monomialAverage_smul, smul_smul, ← Complex.ofReal_mul, mul_inv_cancel₀ h.ne',
      Complex.ofReal_one, one_smul]
  rw [heq, eLpNorm_const_smul]
  have hlp : 0 ≤ lam ^ (-δf 1) := Real.rpow_nonneg (by linarith) _
  have hce : ‖(c : ℂ)‖ₑ = ENNReal.ofReal c := by
    rw [← ofReal_norm, Complex.norm_real, Real.norm_eq_abs, abs_of_pos h]
  calc ‖(c : ℂ)‖ₑ * eLpNorm (monomialAverage α ψ' fun n => ⇑(g n)) 1 volume
      ≤ ‖(c : ℂ)‖ₑ * (ENNReal.ofReal (C * ((⨆ t, |ψ' t|) + 1) * lam ^ (-δf 1)) *
          (eLpNorm (g 0) 2 volume * eLpNorm (g 1) 2 volume)) := mul_le_mul' le_rfl hmain'
    _ = ENNReal.ofReal (c * (C * ((⨆ t, |ψ' t|) + 1) * lam ^ (-δf 1))) *
          (eLpNorm (g 0) 2 volume * eLpNorm (g 1) 2 volume) := by
        rw [hce, ENNReal.ofReal_mul h.le]; ring
    _ ≤ _ := by
        refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
        calc c * (C * ((⨆ t, |ψ' t|) + 1) * lam ^ (-δf 1))
            = C * (c * (⨆ t, |ψ' t|) + c) * lam ^ (-δf 1) := by ring
          _ ≤ C * ((⨆ t, |ψ t|) + c) * lam ^ (-δf 1) := by
              gcongr
              calc c * (⨆ t, |ψ' t|) ≤ c * (c⁻¹ * ⨆ t, |ψ t|) := mul_le_mul_of_nonneg_left hsup h.le
                _ = ⨆ t, |ψ t| := by field_simp

theorem slotEmb_toLp (n0 : Fin 3) (r : Fin 2 → ℝ) :
    slotEmb n0 (WithLp.toLp 2 r) = fiberBase n0 r := by
  ext m
  rcases Fin.eq_self_or_eq_succAbove n0 m with h | ⟨i, rfl⟩
  · subst h; rw [slotEmb_apply_self]; simp [fiberBase]
  · rw [slotEmb_apply_succAbove]; simp [fiberBase, Fin.insertNth_apply_succAbove]

theorem fibrePt_toLp (n0 : Fin 3) (w : ℝ) (r : Fin 2 → ℝ) :
    fibrePt n0 w (WithLp.toLp 2 r) = fiberBase n0 r + w • basisVec n0 := by
  rw [fibrePt, slotEmb_toLp]

theorem measurable_fibrePt (n0 : Fin 3) :
    Measurable fun q : ℝ × E2 => fibrePt n0 q.1 q.2 :=
  ((slotEmb n0).continuous.measurable.comp measurable_snd).add
    (measurable_fst.smul_const _)

/-- **Integration over the fibres**: `∫_{ℝ^3} F = ∫_w ∫_{ℝ^2} F(ι_w z) dz dw`. -/
theorem lintegral_E3_fibrePt (n0 : Fin 3) {F : E3 → ℝ≥0∞} (hF : Measurable F) :
    ∫⁻ x, F x = ∫⁻ w : ℝ, ∫⁻ z : E2, F (fibrePt n0 w z) := by
  have hc : Continuous fun q : (Fin 2 → ℝ) × ℝ => fibrePt n0 q.2 (WithLp.toLp 2 q.1) := by
    unfold fibrePt
    exact ((slotEmb n0).continuous.comp ((PiLp.continuous_toLp 2 _).comp continuous_fst)).add
      (continuous_snd.smul continuous_const)
  have hm : Measurable fun q : (Fin 2 → ℝ) × ℝ => F (fibrePt n0 q.2 (WithLp.toLp 2 q.1)) :=
    hF.comp hc.measurable
  calc ∫⁻ x, F x = ∫⁻ r : Fin 2 → ℝ, ∫⁻ w : ℝ, F (fiberBase n0 r + w • basisVec n0) :=
        lintegral_E3_fiber n0 hF
    _ = ∫⁻ r : Fin 2 → ℝ, ∫⁻ w : ℝ, F (fibrePt n0 w (WithLp.toLp 2 r)) := by
        refine lintegral_congr fun r => lintegral_congr fun w => ?_
        rw [fibrePt_toLp]
    _ = ∫⁻ w : ℝ, ∫⁻ r : Fin 2 → ℝ, F (fibrePt n0 w (WithLp.toLp 2 r)) :=
        lintegral_lintegral_swap (f := fun r w => F (fibrePt n0 w (WithLp.toLp 2 r))) hm.aemeasurable
    _ = _ := by
        refine lintegral_congr fun w => ?_
        exact (PiLp.volume_preserving_toLp (Fin 2)).lintegral_comp_emb
          (MeasurableEquiv.toLp 2 _).measurableEmbedding (fun z => F (fibrePt n0 w z))

theorem continuous_rhoCut_joint (n0 : Fin 3) :
    Continuous fun q : ℝ × ℝ => rhoCut n0 q.1 q.2 := by
  unfold rhoCut
  exact (contDiff_wPos.continuous.comp continuous_snd).mul
    (Complex.continuous_re.comp ((phiCM 0).check.continuous.comp
      ((continuous_snd.pow _).sub continuous_fst)))

theorem measurable_fibreAvg (n0 : Fin 3) {G : Fin 2 → E3 → ℂ} (hG : ∀ i, Continuous (G i)) :
    Measurable fun q : ℝ × E3 => fibreAvg n0 G q.1 q.2 := by
  unfold fibreAvg
  have hc : Continuous (Function.uncurry fun (q : ℝ × E3) (t : ℝ) =>
      (rhoCut n0 q.1 t : ℂ) * ∏ i, G i (q.2 + curve (n0.succAbove i) t)) := by
    refine (Complex.continuous_ofReal.comp ((continuous_rhoCut_joint n0).comp
      ((continuous_fst.comp continuous_fst).prodMk continuous_snd))).mul ?_
    exact continuous_finsetProd _ fun i _ => (hG i).comp
      ((continuous_snd.comp continuous_fst).add ((continuous_curve _).comp continuous_snd))
  exact hc.measurable.stronglyMeasurable.integral_prod_right'.measurable

theorem eLpNorm_two_sq_eq {X : Type*} [MeasurableSpace X] {μ : Measure X} (g : X → ℂ) :
    eLpNorm g 2 μ = (∫⁻ x, ‖g x‖ₑ ^ (2 : ℝ) ∂μ) ^ (1 / 2 : ℝ) := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num)]; norm_num

/-- The fibrewise `L^2` identity: `∫_w ‖G(ι_w ·)‖_2^2 dw = ‖G‖_2^2`. -/
theorem lintegral_fibre_sq (n0 : Fin 3) {G : E3 → ℂ} (hG : Continuous G) :
    ∫⁻ w : ℝ, ∫⁻ z : E2, ‖G (fibrePt n0 w z)‖ₑ ^ (2 : ℝ) = ∫⁻ x, ‖G x‖ₑ ^ (2 : ℝ) :=
  (lintegral_E3_fibrePt n0 (hG.measurable.enorm.pow_const _)).symm

/-- **The positive-time single-scale gain** (`eq:mixedfreqpenult`, lines 648-651, at scale `0`):
`‖𝒜_{w_+}(S_0 g_0, Δ f_1, Δ f_2)‖_1 ≤ C ‖g_0‖_∞ λ^{-δ} ‖Δ f_1‖_2 ‖Δ f_2‖_2` when one of the two
`Δ`-pieces has frequency `≥ λ` in its own direction. -/
theorem gain2_pos (hS : SmoothingTwo) (n0 : Fin 3) :
    ∃ C δ : ℝ, 0 < C ∧ 0 < δ ∧ ∀ (g0 : E3 → ℂ), Measurable g0 → ∀ B : ℝ, (∀ y, ‖g0 y‖ ≤ B) →
      ∀ (f : Fin 2 → 𝓢(E3, ℂ)) (m : Fin 2 → ℤ) (i0 : Fin 2) (lam : ℝ), 1 ≤ lam →
        lam ≤ (2 : ℝ) ^ (m i0 - 1) →
        eLpNorm (Apsi wPos (Fin.insertNth n0 (lineConvC (phiCM 0) n0 g0)
            fun i => ⇑(lpDelta (n0.succAbove i) (m i) (f i)))) 1 volume
          ≤ ENNReal.ofReal (C * B * lam ^ (-δ)) *
            (eLpNorm (lpDelta (n0.succAbove 0) (m 0) (f 0)) 2 volume *
              eLpNorm (lpDelta (n0.succAbove 1) (m 1) (f 1)) 2 volume) := by
  obtain ⟨C, δ, hC, hδ, hsm⟩ := smoothingTwo_uniform hS (slotExpo n0) (slotExpo_pos n0)
    (slotExpo_ne n0)
  obtain ⟨K, hK0, hK⟩ := rhoCut_bound n0
  set I0 : ℝ := ∫ s : ℝ, ((1 + |s|) ^ 2)⁻¹ with hI0
  have hIint : Integrable fun s : ℝ => ((1 + |s|) ^ 2)⁻¹ := by
    have h := integrable_one_add_norm (E := ℝ) (μ := volume) (r := 2) (by simp)
    refine h.congr (Eventually.of_forall fun s => ?_)
    simp only [Real.norm_eq_abs]
    rw [Real.rpow_neg (by positivity), show ((2 : ℝ)) = ((2 : ℕ) : ℝ) by norm_num, Real.rpow_natCast]
  have hI00 : 0 ≤ I0 := integral_nonneg fun s => by positivity
  refine ⟨C * K * I0 + 1, δ, by positivity, hδ, fun g0 hg0 B hB f m i0 lam hlam hlm => ?_⟩
  have hB0 : 0 ≤ B := (norm_nonneg _).trans (hB 0)
  set G : Fin 2 → 𝓢(E3, ℂ) := fun i => lpDelta (n0.succAbove i) (m i) (f i) with hGdef
  have hGc : ∀ i, Continuous (G i : E3 → ℂ) := fun i => (G i).continuous
  obtain ⟨BG, hBG0, hBG⟩ : ∃ BG : ℝ, 0 ≤ BG ∧ ∀ i y, ‖G i y‖ ≤ BG := by
    obtain ⟨b0, hb00, hb0⟩ := exists_bound_schwartz (G 0)
    obtain ⟨b1, hb10, hb1⟩ := exists_bound_schwartz (G 1)
    refine ⟨max b0 b1, le_max_of_le_left hb00, fun i y => ?_⟩
    fin_cases i
    · exact (hb0 y).trans (le_max_left _ _)
    · exact (hb1 y).trans (le_max_right _ _)
  set F : ℝ × E3 → ℝ≥0∞ := fun q => ‖fibreAvg n0 (fun i => ⇑(G i)) q.1 q.2‖ₑ with hF
  have hFm : Measurable F := (measurable_fibreAvg n0 hGc).enorm
  -- the fibre functions
  set a : Fin 2 → ℝ → ℝ≥0∞ := fun i w => (∫⁻ z : E2, ‖G i (fibrePt n0 w z)‖ₑ ^ (2 : ℝ)) ^ (1 / 2 : ℝ)
    with ha
  have ham : ∀ i, Measurable (a i) := fun i => by
    refine Measurable.pow_const ?_ _
    refine Measurable.lintegral_prod_right' (f := fun q : ℝ × E2 =>
      ‖G i (fibrePt n0 q.1 q.2)‖ₑ ^ (2 : ℝ)) ?_
    exact ((G i).continuous.measurable.comp (measurable_fibrePt n0)).enorm.pow_const _
  -- `SmoothingTwo` on one fibre
  have hfib : ∀ s w, ∫⁻ z : E2, F (s, fibrePt n0 w z)
      ≤ ENNReal.ofReal (C * (K * ((1 + |s|) ^ 2)⁻¹) * lam ^ (-δ)) * (a 0 w * a 1 w) := by
    intro s w
    have hfreq : ∃ n, ∀ ξ, 𝓕 (fibreS2 n0 w (G n) : E2 → ℂ) ξ ≠ 0 → lam ≤ |ξ n| :=
      ⟨i0, fun ξ hξ => hlm.trans (fourier_fibreS2_lpDelta_support n0 w i0 (m i0) (f i0) ξ hξ)⟩
    have h := hsm (rhoCut n0 s) (contDiff_rhoCut n0 s) (tsupport_rhoCut n0 s) lam hlam
      (fun i => fibreS2 n0 w (G i)) hfreq
    have e1 : (fun i => ⇑(fibreS2 n0 w (G i))) = fun i v => G i (fibrePt n0 w v) := by
      funext i v; exact fibreS2_apply n0 w (G i) v
    rw [e1, eLpNorm_one_eq_lintegral_enorm] at h
    simp only [eLpNorm_two_sq_eq, fibreS2_apply] at h
    have e2 : ∫⁻ z : E2, F (s, fibrePt n0 w z)
        = ∫⁻ z : E2, ‖monomialAverage (slotExpo n0) (rhoCut n0 s)
            (fun i v => G i (fibrePt n0 w v)) z‖ₑ := by
      refine lintegral_congr fun z => ?_
      simp only [hF, fibreAvg_fibrePt]
    rw [e2]
    refine h.trans (mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl)
    have hlp : 0 ≤ lam ^ (-δ) := Real.rpow_nonneg (by linarith) _
    gcongr
    exact hK s
  -- Cauchy-Schwarz over the fibres
  have hcs : ∫⁻ w : ℝ, a 0 w * a 1 w
      ≤ eLpNorm (G 0) 2 volume * eLpNorm (G 1) 2 volume := by
    have h := ENNReal.lintegral_mul_le_Lp_mul_Lq volume Real.HolderConjugate.two_two
      (ham 0).aemeasurable (ham 1).aemeasurable
    have e : ∀ i, (∫⁻ w, a i w ^ (2 : ℝ)) ^ (1 / 2 : ℝ) = eLpNorm (G i) 2 volume := fun i => by
      rw [eLpNorm_two_sq_eq, ← lintegral_fibre_sq n0 (G i).continuous]
      congr 1
      refine lintegral_congr fun w => ?_
      rw [ha, ← ENNReal.rpow_mul]; norm_num
    rw [e 0, e 1] at h
    exact h
  -- assemble
  have hpt : ∀ y, ‖Apsi wPos (Fin.insertNth n0 (lineConvC (phiCM 0) n0 g0)
      fun i => ⇑(G i)) y‖ₑ ≤ ∫⁻ s, ENNReal.ofReal B * F (s, y) := by
    intro y
    rw [Apsi_low_eq n0 hg0 hB hGc hBG y]
    refine (enorm_integral_le_lintegral_enorm _).trans (lintegral_mono fun s => ?_)
    rw [enorm_mul]
    exact mul_le_mul' (by rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal (hB _)) le_rfl
  have hlp : 0 ≤ lam ^ (-δ) := Real.rpow_nonneg (by linarith) _
  rw [eLpNorm_one_eq_lintegral_enorm]
  calc ∫⁻ y, ‖Apsi wPos (Fin.insertNth n0 (lineConvC (phiCM 0) n0 g0) fun i => ⇑(G i)) y‖ₑ
      ≤ ∫⁻ y, ∫⁻ s, ENNReal.ofReal B * F (s, y) := lintegral_mono hpt
    _ = ∫⁻ s, ∫⁻ y, ENNReal.ofReal B * F (s, y) :=
        lintegral_lintegral_swap ((measurable_const.mul (hFm.comp measurable_swap)).aemeasurable)
    _ = ∫⁻ s, ENNReal.ofReal B * ∫⁻ w : ℝ, ∫⁻ z : E2, F (s, fibrePt n0 w z) := by
        refine lintegral_congr fun s => ?_
        rw [lintegral_const_mul (ENNReal.ofReal B) (f := fun y => F (s, y))
          (hFm.comp (measurable_const.prodMk measurable_id)),
          lintegral_E3_fibrePt n0 (F := fun y => F (s, y))
            (hFm.comp (measurable_const.prodMk measurable_id))]
    _ ≤ ∫⁻ s, ENNReal.ofReal B * (ENNReal.ofReal (C * (K * ((1 + |s|) ^ 2)⁻¹) * lam ^ (-δ)) *
          (eLpNorm (G 0) 2 volume * eLpNorm (G 1) 2 volume)) := by
        refine lintegral_mono fun s => mul_le_mul' le_rfl ?_
        calc ∫⁻ w : ℝ, ∫⁻ z : E2, F (s, fibrePt n0 w z)
            ≤ ∫⁻ w : ℝ, ENNReal.ofReal (C * (K * ((1 + |s|) ^ 2)⁻¹) * lam ^ (-δ)) *
                (a 0 w * a 1 w) := lintegral_mono fun w => hfib s w
          _ = ENNReal.ofReal (C * (K * ((1 + |s|) ^ 2)⁻¹) * lam ^ (-δ)) *
                ∫⁻ w : ℝ, a 0 w * a 1 w := lintegral_const_mul _ ((ham 0).mul (ham 1))
          _ ≤ _ := mul_le_mul' le_rfl hcs
    _ = ∫⁻ s, ENNReal.ofReal (B * (C * K * lam ^ (-δ))) * ENNReal.ofReal (((1 + |s|) ^ 2)⁻¹) *
          (eLpNorm (G 0) 2 volume * eLpNorm (G 1) 2 volume) := by
        refine lintegral_congr fun s => ?_
        rw [← mul_assoc, ← ENNReal.ofReal_mul hB0, ← ENNReal.ofReal_mul (by positivity)]
        congr 2; ring
    _ = ENNReal.ofReal (B * (C * K * lam ^ (-δ))) * (∫⁻ s, ENNReal.ofReal (((1 + |s|) ^ 2)⁻¹)) *
          (eLpNorm (G 0) 2 volume * eLpNorm (G 1) 2 volume) := by
        have hmeas : Measurable fun s : ℝ => ENNReal.ofReal (((1 + |s|) ^ 2)⁻¹) :=
          ENNReal.measurable_ofReal.comp (by fun_prop)
        rw [lintegral_mul_const (f := fun s : ℝ => ENNReal.ofReal (B * (C * K * lam ^ (-δ))) *
            ENNReal.ofReal (((1 + |s|) ^ 2)⁻¹)) _ (measurable_const.mul hmeas),
          lintegral_const_mul (f := fun s : ℝ => ENNReal.ofReal (((1 + |s|) ^ 2)⁻¹)) _ hmeas]
    _ = ENNReal.ofReal (B * (C * K * lam ^ (-δ)) * I0) *
          (eLpNorm (G 0) 2 volume * eLpNorm (G 1) 2 volume) := by
        rw [hI0, ENNReal.ofReal_mul (p := B * (C * K * lam ^ (-δ))) (by positivity),
          ofReal_integral_eq_lintegral_ofReal hIint (Eventually.of_forall fun s => by positivity)]
    _ ≤ _ := by
        refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
        have : B * (C * K * lam ^ (-δ)) * I0 = (C * K * I0) * B * lam ^ (-δ) := by ring
        rw [this]
        gcongr
        linarith

/-- A dyadic family of coordinate multipliers: `h_c(ζ) = h_0(2^{-c} ζ)`. -/
def IsDyadicFam (χ : ℤ → CoordMult) : Prop := ∀ c ζ, (χ c).h ζ = (χ 0).h ((2 : ℝ) ^ (-c) * ζ)

theorem isDyadicFam_psiCM : IsDyadicFam psiCM := fun c ζ => by
  simp only [psiCM, lpPsiJ, neg_zero, zpow_zero, one_mul]

theorem isDyadicFam_phiCM : IsDyadicFam phiCM := fun c ζ => by
  simp only [phiCM, lpPhiJ, neg_zero, zpow_zero, one_mul]

/-- Dyadic scaling of the line kernels: `ȟ_c(u) = 2^c ȟ_0(2^c u)`. -/
theorem IsDyadicFam.check_eq {χ : ℤ → CoordMult} (hχ : IsDyadicFam χ) (c : ℤ) (u : ℝ) :
    (χ c).check u = (((2 : ℝ) ^ c : ℝ) : ℂ) * (χ 0).check ((2 : ℝ) ^ c * u) := by
  rw [CoordMult.check_eq, CoordMult.check_eq]
  have hp : (0 : ℝ) < 2 ^ c := zpow_pos two_pos _
  have h := Measure.integral_comp_mul_left (fun η : ℝ =>
    (Real.fourierChar (η * ((2 : ℝ) ^ c * u)) : ℂ) * (((χ 0).h η : ℝ) : ℂ)) ((2 : ℝ) ^ (-c))
  have e1 : (fun ζ : ℝ => (Real.fourierChar (ζ * u) : ℂ) * (((χ c).h ζ : ℝ) : ℂ))
      = fun ζ => (Real.fourierChar ((2 : ℝ) ^ (-c) * ζ * ((2 : ℝ) ^ c * u)) : ℂ) *
          (((χ 0).h ((2 : ℝ) ^ (-c) * ζ) : ℝ) : ℂ) := by
    funext ζ
    have e : (2 : ℝ) ^ (-c) * ζ * ((2 : ℝ) ^ c * u) = ζ * u := by
      rw [zpow_neg]; field_simp
    rw [e, hχ c ζ]
  rw [e1, h, zpow_neg, inv_inv, abs_of_pos hp, Complex.real_smul]

/-- The inverse anisotropic dilation `D_j^{-1}`. -/
def dilInv (j : ℤ) : E3 →L[ℝ] E3 := diagCLM fun m => (dilC j m)⁻¹

theorem dilInv_sub_smul (j : ℤ) (ℓ : Fin 3) (y : E3) (v : ℝ) :
    dilInv j y - ((dilC j ℓ)⁻¹ * v) • basisVec ℓ = dilInv j (y - v • basisVec ℓ) := by
  ext m
  simp only [dilInv, PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, diagCLM_apply, map_sub,
    map_smul, basisVec_apply]
  split_ifs with h
  · subst h; ring
  · ring

/-- **Line convolutions commute with the anisotropic dilation**:
`(χ_{(ℓ+1)j + c}(D_ℓ) g)(D^{-1} y) = (χ_c(D_ℓ)(g ∘ D^{-1}))(y)`. -/
theorem lineConvC_dilInv {χ : ℤ → CoordMult} (hχ : IsDyadicFam χ) (j c : ℤ) (ℓ : Fin 3)
    (g : E3 → ℂ) (y : E3) :
    lineConvC (χ ((expo ℓ : ℤ) * j + c)) ℓ g (dilInv j y)
      = lineConvC (χ c) ℓ (fun x => g (dilInv j x)) y := by
  set a : ℝ := dilC j ℓ with ha
  have ha0 : 0 < a := zpow_pos two_pos _
  unfold lineConvC
  have h := Measure.integral_comp_mul_left (fun v : ℝ =>
    (χ ((expo ℓ : ℤ) * j + c)).check (a⁻¹ * v) * g (dilInv j (y - v • basisVec ℓ))) a
  have e1 : (fun u : ℝ => (χ ((expo ℓ : ℤ) * j + c)).check u * g (dilInv j y - u • basisVec ℓ))
      = fun u => (χ ((expo ℓ : ℤ) * j + c)).check (a⁻¹ * (a * u)) *
          g (dilInv j (y - (a * u) • basisVec ℓ)) := by
    funext u
    rw [← dilInv_sub_smul, ← ha, ← mul_assoc, inv_mul_cancel₀ ha0.ne', one_mul]
  rw [e1, h, abs_inv, abs_of_pos ha0, Complex.real_smul, ← integral_const_mul]
  refine integral_congr_ae (Eventually.of_forall fun v => ?_)
  simp only
  rw [hχ.check_eq, hχ.check_eq c, ← mul_assoc]
  congr 1
  · have e2 : (2 : ℝ) ^ ((expo ℓ : ℤ) * j + c) * (a⁻¹ * v) = (2 : ℝ) ^ c * v := by
      rw [ha, dilC, zpow_add₀ two_ne_zero]; field_simp
    have e3 : ((a⁻¹ : ℝ) : ℂ) * (((2 : ℝ) ^ ((expo ℓ : ℤ) * j + c) : ℝ) : ℂ)
        = (((2 : ℝ) ^ c : ℝ) : ℂ) := by
      rw [← Complex.ofReal_mul, ha, dilC, zpow_add₀ two_ne_zero]; congr 1; field_simp
    rw [e2, ← e3]; push_cast; ring

/-- `Δ` commutes with `D^{-1}` on Schwartz inputs. -/
theorem lpDelta_dilInv (j k : ℤ) (ℓ : Fin 3) (f : 𝓢(E3, ℂ)) (y : E3) :
    lpDelta ℓ ((expo ℓ : ℤ) * j + k) f (dilInv j y)
      = lpDelta ℓ k (schwartzDiag (fun m => inv_ne_zero (dilC_ne_zero j m)) f) y := by
  have h1 := congrFun (lineConvC_schwartz (psiCM ((expo ℓ : ℤ) * j + k)) ℓ f) (dilInv j y)
  have h2 := congrFun (lineConvC_schwartz (psiCM k) ℓ
    (schwartzDiag (fun m => inv_ne_zero (dilC_ne_zero j m)) f)) y
  rw [psiCM_op] at h1 h2
  rw [← h1, ← h2, lineConvC_dilInv isDyadicFam_psiCM]
  congr 1

/-- The reflection `R = diag(-1, 1, -1)`. -/
def reflR : E3 →L[ℝ] E3 := diagCLM reflC

theorem reflR_sub_smul (ℓ : Fin 3) (y : E3) (u : ℝ) :
    reflR y - u • basisVec ℓ = reflR (y - (reflC ℓ * u) • basisVec ℓ) := by
  ext m
  simp only [reflR, PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, diagCLM_apply, map_sub,
    map_smul, basisVec_apply]
  split_ifs with h
  · subst h; fin_cases m <;> simp [reflC]
  · ring

/-- Line convolutions with even kernels commute with the reflection. -/
theorem lineConvC_reflR (χ : CoordMult) (ℓ : Fin 3) (g : E3 → ℂ) (y : E3) :
    lineConvC χ ℓ g (reflR y) = lineConvC χ ℓ (fun x => g (reflR x)) y := by
  unfold lineConvC
  simp_rw [reflR_sub_smul]
  have hr : reflC ℓ = 1 ∨ reflC ℓ = -1 := by fin_cases ℓ <;> simp [reflC]
  rcases hr with h | h
  · simp only [h, one_mul]
  · simp only [h, neg_one_mul]
    rw [← integral_neg_eq_self]
    refine integral_congr_ae (Eventually.of_forall fun u => ?_)
    simp only [neg_neg, χ.check_neg]

theorem lpDelta_reflR (k : ℤ) (ℓ : Fin 3) (f : 𝓢(E3, ℂ)) (y : E3) :
    lpDelta ℓ k f (reflR y) = lpDelta ℓ k (schwartzDiag reflC_ne_zero f) y := by
  have h1 := congrFun (lineConvC_schwartz (psiCM k) ℓ f) (reflR y)
  have h2 := congrFun (lineConvC_schwartz (psiCM k) ℓ (schwartzDiag reflC_ne_zero f)) y
  rw [psiCM_op] at h1 h2
  rw [← h1, ← h2, lineConvC_reflR]
  congr 1

/-- `Auto.simplexTj_rescale` for bounded measurable inputs: with `G = g ∘ D^{-1}`,
`T_j(g)(x) = 𝒜_{w_+}(G)(D x) - 𝒜_{w_+}(G ∘ R)(R D x)`. -/
theorem simplexTj_rescale' (j : ℤ) {g : Fin 3 → E3 → ℂ} (hg : ∀ n, Measurable (g n)) {Bg : ℝ}
    (hBg : ∀ n y, ‖g n y‖ ≤ Bg) (x : E3) :
    simplexTj j g x
      = Apsi wPos (fun n y => g n (diagCLM (fun m => (dilC j m)⁻¹) y)) (diagCLM (dilC j) x)
        - Apsi wPos (fun n y => g n (diagCLM (fun m => (dilC j m)⁻¹) (diagCLM reflC y)))
            (diagCLM reflC (diagCLM (dilC j) x)) := by
  set G : Fin 3 → E3 → ℂ := fun n y => g n (diagCLM (fun m => (dilC j m)⁻¹) y) with hG
  have hDinv : ∀ y, diagCLM (fun m => (dilC j m)⁻¹) (diagCLM (dilC j) y) = y := fun y => by
    rw [diagCLM_comp]; ext m; simp [diagCLM_apply, inv_mul_cancel₀ (dilC_ne_zero j m)]
  have hRR : ∀ y, diagCLM reflC (diagCLM reflC y) = y := fun y => by
    rw [diagCLM_comp]; ext m; fin_cases m <;> simp [diagCLM_apply, reflC]
  -- the substitution `t = 2^{-j} s`
  have hsub : simplexTj j g x = ∫ s : ℝ, ((wL s : ℝ) : ℂ) * prodShift G (diagCLM (dilC j) x) s := by
    unfold simplexTj
    have hq : (0 : ℝ) < 2 ^ j := zpow_pos two_pos _
    have h := Measure.integral_comp_mul_left (fun t : ℝ =>
      (lpPsi ((2 : ℝ) ^ j * t) : ℂ) * prodShift g x t / t) ((2 : ℝ) ^ (-j))
    have hc : |((2 : ℝ) ^ (-j))⁻¹| = 2 ^ j := by
      rw [abs_of_pos (inv_pos.mpr (zpow_pos two_pos _)), zpow_neg, inv_inv]
    rw [hc] at h
    have hpt : ∀ s : ℝ, (lpPsi ((2 : ℝ) ^ j * ((2 : ℝ) ^ (-j) * s)) : ℂ) *
        prodShift g x ((2 : ℝ) ^ (-j) * s) / ((((2 : ℝ) ^ (-j) * s : ℝ)) : ℂ)
        = (2 : ℝ) ^ j • (((wL s : ℝ) : ℂ) * prodShift G (diagCLM (dilC j) x) s) := by
      intro s
      have e2 : (2 : ℝ) ^ j * ((2 : ℝ) ^ (-j) * s) = s := by
        rw [← mul_assoc, ← zpow_add₀ two_ne_zero, add_neg_cancel, zpow_zero, one_mul]
      have ep : prodShift g x ((2 : ℝ) ^ (-j) * s) = prodShift G (diagCLM (dilC j) x) s := by
        unfold prodShift
        refine Finset.prod_congr rfl fun n _ => ?_
        simp only [hG, map_add, hDinv, dilC_inv_curve]
      rw [e2, ep, wL, Complex.real_smul, Complex.ofReal_mul, Complex.ofReal_div]
      have hab : (((2 : ℝ) ^ (-j) : ℝ) : ℂ) = (((2 : ℝ) ^ j : ℝ) : ℂ)⁻¹ := by
        rw [zpow_neg, Complex.ofReal_inv]
      have h2 : (((2 : ℝ) ^ j : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hq.ne'
      rw [hab]
      by_cases hs : s = 0
      · subst hs; simp
      · have hs' : ((s : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hs
        field_simp
    simp_rw [hpt] at h
    rw [integral_smul] at h
    have hq0 : ((2 : ℝ) ^ j) ≠ 0 := hq.ne'
    have := congrArg (fun z : ℂ => ((2 : ℝ) ^ j)⁻¹ • z) h
    simp only [smul_smul, inv_mul_cancel₀ hq0, one_smul] at this
    exact this.symm
  rw [hsub]
  -- split `w = w_+ - w_+(-·)`
  set y := diagCLM (dilC j) x with hy
  have hwc : Continuous fun s : ℝ => ((wPos s : ℝ) : ℂ) :=
    Complex.continuous_ofReal.comp contDiff_wPos.continuous
  have hwcs : HasCompactSupport fun s : ℝ => ((wPos s : ℝ) : ℂ) :=
    HasCompactSupport.intro isCompact_Icc (fun s hs => by
      simp only [Complex.ofReal_eq_zero]
      by_contra h; exact hs (support_wPos h))
  have hGm : ∀ n, Measurable (G n) := fun n =>
    (hg n).comp (diagCLM fun m => (dilC j m)⁻¹).continuous.measurable
  have hPm : Measurable (prodShift G y) := by
    unfold prodShift
    exact Finset.measurable_prod _ fun n _ => (hGm n).comp
      (measurable_const.add (continuous_curve n).measurable)
  have hPB : ∀ s, ‖prodShift G y s‖ ≤ Bg ^ 3 := norm_prodShift_le (fun n y => hBg n _) y
  have hi1 : Integrable fun s : ℝ => ((wPos s : ℝ) : ℂ) * prodShift G y s := by
    refine ((hwc.integrable_of_hasCompactSupport hwcs).norm.mul_const (Bg ^ 3)).mono'
      ((hwc.aestronglyMeasurable).mul hPm.aestronglyMeasurable) (Eventually.of_forall fun s => ?_)
    rw [norm_mul]; exact mul_le_mul_of_nonneg_left (hPB s) (norm_nonneg _)
  have hi2 : Integrable fun s : ℝ => ((wPos (-s) : ℝ) : ℂ) * prodShift G y s := by
    have hwcs' : HasCompactSupport fun s : ℝ => ((wPos (-s) : ℝ) : ℂ) :=
      hwcs.comp_homeomorph (Homeomorph.neg ℝ)
    refine ((((hwc.comp continuous_neg)).integrable_of_hasCompactSupport hwcs').norm.mul_const
      (Bg ^ 3)).mono' (((hwc.comp continuous_neg).aestronglyMeasurable).mul
        hPm.aestronglyMeasurable) (Eventually.of_forall fun s => ?_)
    rw [norm_mul]; exact mul_le_mul_of_nonneg_left (hPB s) (norm_nonneg _)
  have hsplit : ∫ s : ℝ, ((wL s : ℝ) : ℂ) * prodShift G y s
      = (∫ s : ℝ, ((wPos s : ℝ) : ℂ) * prodShift G y s)
        - ∫ s : ℝ, ((wPos (-s) : ℝ) : ℂ) * prodShift G y s := by
    refine (integral_congr_ae (Eventually.of_forall fun s => ?_)).trans (integral_sub hi1 hi2)
    simp only [wL_eq_wPos_sub s]
    push_cast; ring
  rw [hsplit]
  unfold Apsi
  congr 1
  rw [← integral_neg_eq_self (fun s : ℝ => ((wPos (-s) : ℝ) : ℂ) * prodShift G y s)]
  refine integral_congr_ae (Eventually.of_forall fun s => ?_)
  simp only [neg_neg]
  congr 1
  unfold prodShift
  refine Finset.prod_congr rfl fun n _ => ?_
  simp only [hG]
  congr 2
  rw [map_add, hRR, refl_curve]

theorem norm_lineConvC_le (χ : CoordMult) (ℓ : Fin 3) {g : E3 → ℂ} {B : ℝ} (hB : ∀ y, ‖g y‖ ≤ B)
    (y : E3) : ‖lineConvC χ ℓ g y‖ ≤ (∫ u, ‖χ.check u‖) * B := by
  unfold lineConvC
  refine (norm_integral_le_integral_norm _).trans ?_
  rw [← integral_mul_const]
  refine integral_mono_of_nonneg (Eventually.of_forall fun u => norm_nonneg _)
    (χ.check.integrable.norm.mul_const B) (Eventually.of_forall fun u => ?_)
  simp only [norm_mul]
  exact mul_le_mul_of_nonneg_left (hB _) (norm_nonneg _)

/-- The slot inputs of the grouped single-scale piece. -/
def lowInputs (n0 : Fin 3) (c : ℤ) (g0 : E3 → ℂ) (G : Fin 2 → E3 → ℂ) : Fin 3 → E3 → ℂ :=
  Fin.insertNth n0 (lineConvC (phiCM c) n0 g0) G

theorem eLpNorm_comp_dilInv {g : E3 → ℂ} (hg : AEStronglyMeasurable g volume) (j : ℤ)
    {p : ℝ≥0∞} (hp0 : p ≠ 0) (hp : p ≠ ⊤) :
    eLpNorm (fun x => g (dilInv j x)) p volume
      = ENNReal.ofReal |∏ m, (dilC j m)⁻¹|⁻¹ ^ p.toReal⁻¹ * eLpNorm g p volume :=
  eLpNorm_comp_diagCLM (fun m => inv_ne_zero (dilC_ne_zero j m)) hg hp0 hp

theorem measurable_Apsi {ψ : ℝ → ℝ} (hψ : Measurable ψ) {h : Fin 3 → E3 → ℂ}
    (hh : ∀ n, Measurable (h n)) : Measurable (Apsi ψ h) := by
  have hc : ∀ n, Measurable fun p : E3 × ℝ => p.1 + curve n p.2 := fun n =>
    measurable_fst.add ((continuous_curve n).measurable.comp measurable_snd)
  have hjoint : StronglyMeasurable (Function.uncurry fun (x : E3) (t : ℝ) =>
      (ψ t : ℂ) * prodShift h x t) := by
    refine Measurable.stronglyMeasurable ?_
    refine (Complex.measurable_ofReal.comp (hψ.comp measurable_snd)).mul ?_
    unfold prodShift
    exact Finset.measurable_prod _ fun n _ => (hh n).comp (hc n)
  exact hjoint.integral_prod_right'.measurable

theorem abs_prod_reflC_dilC (j : ℤ) :
    |∏ m, reflC m * dilC j m| = |∏ m, dilC j m| := by
  rw [Finset.prod_mul_distrib, abs_mul]
  have : |∏ m, reflC m| = 1 := by simp [reflC, Fin.prod_univ_three]
  rw [this, one_mul]

theorem lowInputs_measurable (n0 : Fin 3) (c : ℤ) {g0 : E3 → ℂ} (hg0 : Measurable g0)
    (G : Fin 2 → 𝓢(E3, ℂ)) : ∀ n, Measurable (lowInputs n0 c g0 (fun i => ⇑(G i)) n) := by
  intro n
  rcases Fin.eq_self_or_eq_succAbove n0 n with h | ⟨i, rfl⟩
  · subst h; simp only [lowInputs, Fin.insertNth_apply_same]; exact measurable_lineConvC _ _ hg0
  · simp only [lowInputs, Fin.insertNth_apply_succAbove]; exact (G i).continuous.measurable

/-- **`eq:mixedfreqpenult`** (lines 609-611, 637-651): for every scale `j`,
`‖T_j(S_{(n_0+1)j} g_0, Δ_{(n+1)j+k} f, Δ_{(m+1)j+k'} f')‖_1 ≤ C ‖g_0‖_∞ λ^{-δ} ‖Δ f‖_2 ‖Δ f'‖_2`
when one of the two `Δ`-pieces has frequency index `k ≥ log_2 λ + 1`. -/
theorem gain2_single (hS : SmoothingTwo) (n0 : Fin 3) :
    ∃ C δ : ℝ, 0 < C ∧ 0 < δ ∧ ∀ (j : ℤ) (g0 : E3 → ℂ), Measurable g0 → ∀ B : ℝ,
      (∀ y, ‖g0 y‖ ≤ B) → ∀ (f : Fin 2 → 𝓢(E3, ℂ)) (k : Fin 2 → ℤ) (i0 : Fin 2) (lam : ℝ),
        1 ≤ lam → lam ≤ (2 : ℝ) ^ (k i0 - 1) →
        eLpNorm (simplexTj j (lowInputs n0 ((expo n0 : ℤ) * j) g0
            fun i => ⇑(lpDelta (n0.succAbove i) ((expo (n0.succAbove i) : ℤ) * j + k i) (f i)))) 1
            volume
          ≤ ENNReal.ofReal (2 * C * B * lam ^ (-δ)) *
            (eLpNorm (lpDelta (n0.succAbove 0) ((expo (n0.succAbove 0) : ℤ) * j + k 0) (f 0)) 2
                volume *
              eLpNorm (lpDelta (n0.succAbove 1) ((expo (n0.succAbove 1) : ℤ) * j + k 1) (f 1)) 2
                volume) := by
  obtain ⟨C, δ, hC, hδ, hpos⟩ := gain2_pos hS n0
  refine ⟨C, δ, hC, hδ, fun j g0 hg0 B hB f k i0 lam hlam hlm => ?_⟩
  set σ := n0.succAbove
  set c0 : ℤ := (expo n0 : ℤ) * j
  set Δf : Fin 2 → 𝓢(E3, ℂ) := fun i => lpDelta (σ i) ((expo (σ i) : ℤ) * j + k i) (f i) with hΔf
  set g : Fin 3 → E3 → ℂ := lowInputs n0 c0 g0 fun i => ⇑(Δf i) with hgdef
  have hB0 : 0 ≤ B := (norm_nonneg _).trans (hB 0)
  have hcinv : ∀ m, (dilC j m)⁻¹ ≠ 0 := fun m => inv_ne_zero (dilC_ne_zero j m)
  set fd : Fin 2 → 𝓢(E3, ℂ) := fun i => schwartzDiag hcinv (f i) with hfd
  set fr : Fin 2 → 𝓢(E3, ℂ) := fun i => schwartzDiag reflC_ne_zero (fd i) with hfr
  set g0d : E3 → ℂ := fun y => g0 (dilInv j y) with hg0d
  set g0r : E3 → ℂ := fun y => g0d (reflR y) with hg0r
  have hg0dm : Measurable g0d := hg0.comp (dilInv j).continuous.measurable
  have hg0rm : Measurable g0r := hg0dm.comp reflR.continuous.measurable
  -- measurability and bounds of the slot inputs
  have hslot : ∀ n, (n = n0 ∧ g n = lineConvC (phiCM c0) n0 g0) ∨
      ∃ i, n = σ i ∧ g n = ⇑(Δf i) := by
    intro n
    rcases Fin.eq_self_or_eq_succAbove n0 n with h | ⟨i, rfl⟩
    · left; subst h; exact ⟨rfl, Fin.insertNth_apply_same _ _ _⟩
    · right; exact ⟨i, rfl, Fin.insertNth_apply_succAbove _ _ _ _⟩
  have hgm : ∀ n, Measurable (g n) := by
    intro n
    rcases hslot n with ⟨-, h⟩ | ⟨i, -, h⟩
    · rw [h]; exact measurable_lineConvC _ _ hg0
    · rw [h]; exact (Δf i).continuous.measurable
  obtain ⟨b0, -, hb0⟩ := exists_bound_schwartz (Δf 0)
  obtain ⟨b1, -, hb1⟩ := exists_bound_schwartz (Δf 1)
  set Bg : ℝ := max ((∫ u, ‖(phiCM c0).check u‖) * B) (max b0 b1)
  have hBg : ∀ n y, ‖g n y‖ ≤ Bg := by
    intro n y
    rcases hslot n with ⟨-, h⟩ | ⟨i, -, h⟩
    · rw [h]; exact (norm_lineConvC_le _ _ hB y).trans (le_max_left _ _)
    · rw [h]; fin_cases i
      · exact (hb0 y).trans ((le_max_left _ _).trans (le_max_right _ _))
      · exact (hb1 y).trans ((le_max_right _ _).trans (le_max_right _ _))
  -- the rescaled inputs
  have hG : (fun n y => g n (diagCLM (fun m => (dilC j m)⁻¹) y))
      = lowInputs n0 0 g0d fun i => ⇑(lpDelta (σ i) (k i) (fd i)) := by
    funext n y
    change g n (dilInv j y) = _
    rcases Fin.eq_self_or_eq_succAbove n0 n with h | ⟨i, rfl⟩
    · subst h
      simp only [hgdef, lowInputs, Fin.insertNth_apply_same]
      have := lineConvC_dilInv isDyadicFam_phiCM j 0 n g0 y
      rw [add_zero] at this
      exact this
    · simp only [hgdef, lowInputs, Fin.insertNth_apply_succAbove, hΔf, hfd]
      exact lpDelta_dilInv j (k i) (σ i) (f i) y
  have hGR : (fun n y => g n (diagCLM (fun m => (dilC j m)⁻¹) (diagCLM reflC y)))
      = lowInputs n0 0 g0r fun i => ⇑(lpDelta (σ i) (k i) (fr i)) := by
    funext n y
    have h1 := congrFun (congrFun hG n) (reflR y)
    change g n (dilInv j (reflR y)) = _
    change g n (dilInv j (reflR y)) = _ at h1
    rw [h1]
    rcases Fin.eq_self_or_eq_succAbove n0 n with h | ⟨i, rfl⟩
    · subst h
      simp only [lowInputs, Fin.insertNth_apply_same]
      exact lineConvC_reflR _ _ _ y
    · simp only [lowInputs, Fin.insertNth_apply_succAbove, hfr]
      exact lpDelta_reflR (k i) (σ i) (fd i) y
  have hresc : ∀ x, simplexTj j g x
      = Apsi wPos (lowInputs n0 0 g0d fun i => ⇑(lpDelta (σ i) (k i) (fd i))) (diagCLM (dilC j) x)
        - Apsi wPos (lowInputs n0 0 g0r fun i => ⇑(lpDelta (σ i) (k i) (fr i)))
            (diagCLM reflC (diagCLM (dilC j) x)) := by
    intro x
    rw [simplexTj_rescale' j hgm hBg x, hG, hGR]
  set A1 := Apsi wPos (lowInputs n0 0 g0d fun i => ⇑(lpDelta (σ i) (k i) (fd i))) with hA1
  set A2 := Apsi wPos (lowInputs n0 0 g0r fun i => ⇑(lpDelta (σ i) (k i) (fr i))) with hA2
  have hwm : Measurable wPos := contDiff_wPos.continuous.measurable
  have hA1m : Measurable A1 := measurable_Apsi hwm (lowInputs_measurable n0 0 hg0dm _)
  have hA2m : Measurable A2 := measurable_Apsi hwm (lowInputs_measurable n0 0 hg0rm _)
  set Dd : ℝ := |∏ m, dilC j m| with hDd
  have hDd0 : 0 < Dd := abs_pos.mpr (Finset.prod_ne_zero_iff.mpr fun m _ => dilC_ne_zero j m)
  have hinvprod : |∏ m, (dilC j m)⁻¹|⁻¹ = Dd := by
    rw [Finset.prod_inv_distrib, abs_inv, inv_inv]
  -- the L^1 side
  have hT : simplexTj j g = fun x => A1 (diagCLM (dilC j) x) -
      A2 (diagCLM (fun m => reflC m * dilC j m) x) := by
    funext x; rw [hresc x, diagCLM_comp]
  have hL1 : eLpNorm (simplexTj j g) 1 volume
      ≤ ENNReal.ofReal Dd⁻¹ * eLpNorm A1 1 volume + ENNReal.ofReal Dd⁻¹ * eLpNorm A2 1 volume := by
    rw [hT]
    refine (eLpNorm_sub_le (hA1m.comp (diagCLM (dilC j)).continuous.measurable).aestronglyMeasurable
      (hA2m.comp (diagCLM _).continuous.measurable).aestronglyMeasurable le_rfl).trans (le_of_eq ?_)
    simp only [Function.comp_def]
    rw [eLpNorm_comp_diagCLM (dilC_ne_zero j) hA1m.aestronglyMeasurable one_ne_zero ENNReal.one_ne_top,
      eLpNorm_comp_diagCLM (fun m => mul_ne_zero (reflC_ne_zero m) (dilC_ne_zero j m))
        hA2m.aestronglyMeasurable one_ne_zero ENNReal.one_ne_top, abs_prod_reflC_dilC]
    simp [hDd]
  -- the L^2 side
  have hΔd : ∀ i, eLpNorm (lpDelta (σ i) (k i) (fd i)) 2 volume
      = ENNReal.ofReal Dd ^ (1 / 2 : ℝ) * eLpNorm (Δf i) 2 volume := by
    intro i
    have e : ⇑(lpDelta (σ i) (k i) (fd i)) = fun y => Δf i (dilInv j y) := by
      funext y; exact (lpDelta_dilInv j (k i) (σ i) (f i) y).symm
    rw [e, eLpNorm_comp_dilInv (Δf i).continuous.aestronglyMeasurable j (by norm_num) (by norm_num),
      hinvprod]
    norm_num
  have hΔr : ∀ i, eLpNorm (lpDelta (σ i) (k i) (fr i)) 2 volume
      = eLpNorm (lpDelta (σ i) (k i) (fd i)) 2 volume := by
    intro i
    have e : ⇑(lpDelta (σ i) (k i) (fr i)) = fun y => lpDelta (σ i) (k i) (fd i) (reflR y) := by
      funext y; exact (lpDelta_reflR (k i) (σ i) (fd i) y).symm
    rw [e, show (fun y => lpDelta (σ i) (k i) (fd i) (reflR y))
        = fun y => lpDelta (σ i) (k i) (fd i) (diagCLM reflC y) from rfl,
      eLpNorm_comp_diagCLM reflC_ne_zero (lpDelta _ _ _).continuous.aestronglyMeasurable
        (by norm_num) (by norm_num)]
    have : |∏ m, reflC m|⁻¹ = 1 := by simp [reflC, Fin.prod_univ_three]
    rw [this]; simp
  -- the two halves
  have hB0d : ∀ y, ‖g0d y‖ ≤ B := fun y => hB _
  have hB0r : ∀ y, ‖g0r y‖ ≤ B := fun y => hB _
  have h1 := hpos g0d hg0dm B hB0d fd k i0 lam hlam hlm
  have h2 := hpos g0r hg0rm B hB0r fr k i0 lam hlam hlm
  simp only [lowInputs] at hA1 hA2
  rw [← hA1] at h1; rw [← hA2] at h2
  rw [hΔr 0, hΔr 1] at h2
  rw [hΔd 0, hΔd 1] at h1 h2
  set N := eLpNorm (Δf 0) 2 volume * eLpNorm (Δf 1) 2 volume
  set X := ENNReal.ofReal (C * B * lam ^ (-δ))
  have hkey : ENNReal.ofReal Dd⁻¹ * (X * (ENNReal.ofReal Dd ^ (1 / 2 : ℝ) * eLpNorm (Δf 0) 2 volume *
      (ENNReal.ofReal Dd ^ (1 / 2 : ℝ) * eLpNorm (Δf 1) 2 volume))) = X * N := by
    have hsq : ENNReal.ofReal Dd ^ (1 / 2 : ℝ) * ENNReal.ofReal Dd ^ (1 / 2 : ℝ) = ENNReal.ofReal Dd := by
      rw [← ENNReal.rpow_add_of_nonneg _ _ (by norm_num) (by norm_num)]; norm_num
    have hone : ENNReal.ofReal Dd⁻¹ * ENNReal.ofReal Dd = 1 := by
      rw [← ENNReal.ofReal_mul (inv_nonneg.mpr hDd0.le), inv_mul_cancel₀ hDd0.ne', ENNReal.ofReal_one]
    calc ENNReal.ofReal Dd⁻¹ * (X * (ENNReal.ofReal Dd ^ (1 / 2 : ℝ) * eLpNorm (Δf 0) 2 volume *
          (ENNReal.ofReal Dd ^ (1 / 2 : ℝ) * eLpNorm (Δf 1) 2 volume)))
        = (ENNReal.ofReal Dd⁻¹ * (ENNReal.ofReal Dd ^ (1 / 2 : ℝ) * ENNReal.ofReal Dd ^ (1 / 2 : ℝ))) *
            (X * N) := by ring
      _ = X * N := by rw [hsq, hone, one_mul]
  calc eLpNorm (simplexTj j g) 1 volume
      ≤ ENNReal.ofReal Dd⁻¹ * eLpNorm A1 1 volume + ENNReal.ofReal Dd⁻¹ * eLpNorm A2 1 volume := hL1
    _ ≤ X * N + X * N := by
        rw [← hkey]
        exact add_le_add (mul_le_mul' le_rfl h1) (mul_le_mul' le_rfl h2)
    _ = ENNReal.ofReal (2 * C * B * lam ^ (-δ)) * N := by
        rw [← two_mul, ← mul_assoc, show (2 : ℝ≥0∞) = ENNReal.ofReal 2 by simp,
          ← ENNReal.ofReal_mul (by norm_num)]
        congr 2; ring

/-- The inputs `(g_0, G_1, G_2)` with `g_0` inserted in the slot `n_0`. -/
def insIn (n0 : Fin 3) (g0 : E3 → ℂ) (G : Fin 2 → E3 → ℂ) : Fin 3 → E3 → ℂ := Fin.insertNth n0 g0 G

theorem lowCut_eq_zero {p : Fin 3 → ℤ} (hp : 100 < kMax p) : lowCut p = 0 :=
  min_eq_left (by omega)

/-- The inputs of the grouped operator at scale `j` on the high side (`k^{(1)} > 100`). -/
theorem lowFam_inputs (n0 : Fin 3) {p : Fin 3 → ℤ} (hp : 100 < kMax p) (j : ℤ) (g0 : E3 → ℂ)
    (f : Fin 2 → 𝓢(E3, ℂ)) :
    (fun n => lineConvC (lowFam n0 p n j) n (insIn n0 g0 (fun i => ⇑(f i)) n))
      = lowInputs n0 ((expo n0 : ℤ) * j) g0 fun i =>
          ⇑(lpDelta (n0.succAbove i) ((expo (n0.succAbove i) : ℤ) * j + p (n0.succAbove i)) (f i)) := by
  funext n
  rcases Fin.eq_self_or_eq_succAbove n0 n with h | ⟨i, rfl⟩
  · subst h
    simp only [lowFam, if_true, lowCut_eq_zero hp, add_zero, lowInputs, insIn, Fin.insertNth_apply_same]
  · simp only [lowFam, Fin.succAbove_ne, if_false, lowInputs, insIn, Fin.insertNth_apply_succAbove,
      lineConvC_schwartz, psiCM_op]

theorem exists_slot_eq_kMax (n0 : Fin 3) {p : Fin 3 → ℤ} (h0 : p n0 = 0) (hp : 0 < kMax p) :
    ∃ i0 : Fin 2, p (n0.succAbove i0) = kMax p := by
  have hm : ∃ m, p m = kMax p := by
    unfold kMax
    rcases max_choice (max (p 0) (p 1)) (p 2) with h | h <;> rw [h]
    · rcases max_choice (p 0) (p 1) with h' | h' <;> rw [h']
      exacts [⟨0, rfl⟩, ⟨1, rfl⟩]
    · exact ⟨2, rfl⟩
  obtain ⟨m, hm⟩ := hm
  have hne : m ≠ n0 := by rintro rfl; omega
  obtain ⟨i0, rfl⟩ := Fin.exists_succAbove_eq hne
  exact ⟨i0, hm⟩

/-- Cauchy-Schwarz in `j` for the `L^2` pieces, with the partial Littlewood-Paley inequality:
`∑_j ‖Δ_{(n+1)j+k} f‖_2 ‖Δ_{(m+1)j+k'} g‖_2 ≤ A ‖f‖_2 ‖g‖_2`. -/
theorem sum_mul_eLpNorm_lpDelta_le (n m : Fin 3) :
    ∃ A : ℝ, 0 < A ∧ ∀ (kn km : ℤ) (J : ℕ) (f g : 𝓢(E3, ℂ)),
      ∑ j ∈ Finset.Icc (-(J : ℤ)) J,
          eLpNorm (lpDelta n ((expo n : ℤ) * j + kn) f) 2 volume *
            eLpNorm (lpDelta m ((expo m : ℤ) * j + km) g) 2 volume
        ≤ ENNReal.ofReal A * (eLpNorm f 2 volume * eLpNorm g 2 volume) := by
  obtain ⟨A0, hA0, h0⟩ := sum_toReal_eLpNorm_lpDelta_le n (q := 2) le_rfl
  obtain ⟨A1, hA1, h1⟩ := sum_toReal_eLpNorm_lpDelta_le m (q := 2) le_rfl
  refine ⟨Real.sqrt (A0 * A1), Real.sqrt_pos.mpr (mul_pos hA0 hA1), fun kn km J f g => ?_⟩
  have e2 : ENNReal.ofReal 2 = 2 := by simp
  have h0' := h0 kn J f
  have h1' := h1 km J g
  simp only [e2, Real.rpow_two] at h0' h1'
  set S := Finset.Icc (-(J : ℤ)) J
  set a : ℤ → ℝ := fun j => (eLpNorm (lpDelta n ((expo n : ℤ) * j + kn) f) 2 volume).toReal
  set b : ℤ → ℝ := fun j => (eLpNorm (lpDelta m ((expo m : ℤ) * j + km) g) 2 volume).toReal
  set Nf := (eLpNorm f 2 volume).toReal
  set Ng := (eLpNorm g 2 volume).toReal
  have hne : ∀ (ℓ : Fin 3) (c : ℤ) (h : 𝓢(E3, ℂ)), eLpNorm (lpDelta ℓ c h) 2 volume ≠ ⊤ :=
    fun ℓ c h => by simpa [e2] using eLpNorm_schwartz_ne_top (lpDelta ℓ c h) 2
  have hne' : ∀ h : 𝓢(E3, ℂ), eLpNorm h 2 volume ≠ ⊤ :=
    fun h => by simpa [e2] using eLpNorm_schwartz_ne_top h 2
  have hL : ∑ j ∈ S, eLpNorm (lpDelta n ((expo n : ℤ) * j + kn) f) 2 volume *
      eLpNorm (lpDelta m ((expo m : ℤ) * j + km) g) 2 volume = ENNReal.ofReal (∑ j ∈ S, a j * b j) := by
    rw [ENNReal.ofReal_sum_of_nonneg fun j _ => mul_nonneg ENNReal.toReal_nonneg ENNReal.toReal_nonneg]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [ENNReal.ofReal_mul ENNReal.toReal_nonneg, ENNReal.ofReal_toReal (hne _ _ _),
      ENNReal.ofReal_toReal (hne _ _ _)]
  have hR : ENNReal.ofReal (Real.sqrt (A0 * A1)) * (eLpNorm f 2 volume * eLpNorm g 2 volume)
      = ENNReal.ofReal (Real.sqrt (A0 * A1) * (Nf * Ng)) := by
    rw [ENNReal.ofReal_mul (Real.sqrt_nonneg _), ENNReal.ofReal_mul ENNReal.toReal_nonneg,
      ENNReal.ofReal_toReal (hne' f), ENNReal.ofReal_toReal (hne' g)]
  rw [hL, hR]
  refine ENNReal.ofReal_le_ofReal ?_
  have hcs := Finset.sum_mul_sq_le_sq_mul_sq S a b
  have hsq : (∑ j ∈ S, a j * b j) ^ 2 ≤ (Real.sqrt (A0 * A1) * (Nf * Ng)) ^ 2 := by
    rw [mul_pow, Real.sq_sqrt (by positivity)]
    calc (∑ j ∈ S, a j * b j) ^ 2 ≤ (∑ j ∈ S, a j ^ 2) * ∑ j ∈ S, b j ^ 2 := hcs
      _ ≤ (A0 * Nf ^ 2) * (A1 * Ng ^ 2) :=
          mul_le_mul h0' h1' (Finset.sum_nonneg fun j _ => sq_nonneg _) (by positivity)
      _ = A0 * A1 * (Nf * Ng) ^ 2 := by ring
  have hpos : 0 ≤ Real.sqrt (A0 * A1) * (Nf * Ng) := by positivity
  exact (abs_le_of_sq_le_sq' hsq hpos).2

/-- **`lem:gain_2-`** (`eq:gain_2-`, lines 603-608, with the proof of lines 631-651): for the
grouped operators with `k^{(1)} > 100`,
`‖T^{(k_2,k_3)}_J(g_0, f_1, f_2)‖_1 ≤ C 2^{-δ k^{(1)}} ‖g_0‖_∞ ‖f_1‖_2 ‖f_2‖_2`, uniformly in `J`. -/
theorem gain2_grouped (hS : SmoothingTwo) (n0 : Fin 3) :
    ∃ C δ : ℝ, 0 < C ∧ 0 < δ ∧ ∀ p : Fin 3 → ℤ, PairReg n0 p → 100 < kMax p →
      ∀ (J : ℕ) (g0 : E3 → ℂ), Measurable g0 → ∀ B : ℝ, (∀ y, ‖g0 y‖ ≤ B) →
      ∀ f : Fin 2 → 𝓢(E3, ℂ),
        eLpNorm (gOp (lowFam n0 p) J (insIn n0 g0 fun i => ⇑(f i))) 1 volume
          ≤ ENNReal.ofReal (C * B * (2 : ℝ) ^ (-(δ * kMax p))) *
            (eLpNorm (f 0) 2 volume * eLpNorm (f 1) 2 volume) := by
  obtain ⟨C, δ, hC, hδ, hsing⟩ := gain2_single hS n0
  obtain ⟨A, hA, hCS⟩ := sum_mul_eLpNorm_lpDelta_le (n0.succAbove 0) (n0.succAbove 1)
  refine ⟨2 * C * (2 : ℝ) ^ δ * A, δ, by positivity, hδ, fun p hp hK J g0 hg0 B hB f => ?_⟩
  have hB0 : 0 ≤ B := (norm_nonneg _).trans (hB 0)
  set σ := n0.succAbove
  set k : Fin 2 → ℤ := fun i => p (σ i) with hk
  obtain ⟨i0, hi0⟩ := exists_slot_eq_kMax n0 hp.1 (by omega)
  set lam : ℝ := (2 : ℝ) ^ (kMax p - 1) with hlam
  have hlam1 : 1 ≤ lam := one_le_zpow₀ (by norm_num) (by omega)
  have hlamk : lam ≤ (2 : ℝ) ^ (k i0 - 1) := by
    have e : k i0 = kMax p := hi0
    rw [e]
  have hlamδ : lam ^ (-δ) = (2 : ℝ) ^ δ * (2 : ℝ) ^ (-(δ * kMax p)) := by
    rw [hlam, ← Real.rpow_intCast, ← Real.rpow_mul (by norm_num), ← Real.rpow_add (by norm_num)]
    congr 1; push_cast; ring
  set X : ℝ := 2 * C * B * lam ^ (-δ)
  have hX0 : 0 ≤ X := by positivity
  set Sj := Finset.Icc (-(J : ℤ)) J
  have hpiece : ∀ j, eLpNorm (simplexTj j (fun n => lineConvC (lowFam n0 p n j) n
      (insIn n0 g0 (fun i => ⇑(f i)) n))) 1 volume
      ≤ ENNReal.ofReal X * (eLpNorm (lpDelta (σ 0) ((expo (σ 0) : ℤ) * j + k 0) (f 0)) 2 volume *
          eLpNorm (lpDelta (σ 1) ((expo (σ 1) : ℤ) * j + k 1) (f 1)) 2 volume) := by
    intro j
    rw [lowFam_inputs n0 hK j g0 f]
    exact hsing j g0 hg0 B hB f k i0 lam hlam1 hlamk
  have hmeas : ∀ j, Measurable (simplexTj j (fun n => lineConvC (lowFam n0 p n j) n
      (insIn n0 g0 (fun i => ⇑(f i)) n))) := fun j => by
    rw [lowFam_inputs n0 hK j g0 f]
    exact measurable_simplexTj j (lowInputs_measurable n0 _ hg0 _)
  have hfun : gOp (lowFam n0 p) J (insIn n0 g0 fun i => ⇑(f i))
      = ∑ j ∈ Sj, simplexTj j (fun n => lineConvC (lowFam n0 p n j) n
          (insIn n0 g0 (fun i => ⇑(f i)) n)) := by
    funext x; simp [gOp, Finset.sum_apply, Sj]
  rw [hfun]
  calc eLpNorm (∑ j ∈ Sj, simplexTj j (fun n => lineConvC (lowFam n0 p n j) n
        (insIn n0 g0 (fun i => ⇑(f i)) n))) 1 volume
      ≤ ∑ j ∈ Sj, eLpNorm (simplexTj j (fun n => lineConvC (lowFam n0 p n j) n
          (insIn n0 g0 (fun i => ⇑(f i)) n))) 1 volume :=
        eLpNorm_sum_le (fun j _ => (hmeas j).aestronglyMeasurable) le_rfl
    _ ≤ ∑ j ∈ Sj, ENNReal.ofReal X *
          (eLpNorm (lpDelta (σ 0) ((expo (σ 0) : ℤ) * j + k 0) (f 0)) 2 volume *
            eLpNorm (lpDelta (σ 1) ((expo (σ 1) : ℤ) * j + k 1) (f 1)) 2 volume) :=
        Finset.sum_le_sum fun j _ => hpiece j
    _ ≤ ENNReal.ofReal X * (ENNReal.ofReal A * (eLpNorm (f 0) 2 volume * eLpNorm (f 1) 2 volume)) := by
        rw [← Finset.mul_sum]
        exact mul_le_mul' le_rfl (hCS (k 0) (k 1) J (f 0) (f 1))
    _ = ENNReal.ofReal (2 * C * (2 : ℝ) ^ δ * A * B * (2 : ℝ) ^ (-(δ * kMax p))) *
          (eLpNorm (f 0) 2 volume * eLpNorm (f 1) 2 volume) := by
        rw [← mul_assoc, ← ENNReal.ofReal_mul hX0]
        congr 2
        simp only [X, hlamδ]; ring

/-! ### General inputs for the grouped operators (density and interpolation, line 620) -/

/-- Admissible inputs: measurable, bounded, and in every `L^P`, `P ≥ 1`. -/
def GoodIn (g : E3 → ℂ) : Prop :=
  Measurable g ∧ IsBdd g ∧ ∀ P : ℝ, 1 ≤ P → MemLp g (ENNReal.ofReal P) volume

theorem goodIn_simple (s : SimpleFunc E3 ℂ) (hs : Integrable s) : GoodIn s :=
  ⟨s.measurable, isBdd_simpleFunc s, fun P hP =>
    (SimpleFunc.memLp_iff_integrable (by simpa using (by linarith : (0 : ℝ) < P))
      ENNReal.ofReal_ne_top).mpr hs⟩

theorem goodIn_schwartz (φ : 𝓢(E3, ℂ)) : GoodIn φ :=
  ⟨φ.continuous.measurable, isBdd_schwartz φ, fun _ _ => φ.memLp _ _⟩

theorem GoodIn.eLpNorm_ne_top {g : E3 → ℂ} (hg : GoodIn g) {P : ℝ} (hP : 1 ≤ P) :
    eLpNorm g (ENNReal.ofReal P) volume ≠ ⊤ := (hg.2.2 P hP).eLpNorm_ne_top

theorem integrable_lineConvC_integrand (χ : CoordMult) (ℓ : Fin 3) {g : E3 → ℂ}
    (hg : Measurable g) {B : ℝ} (hB : ∀ y, ‖g y‖ ≤ B) (y : E3) :
    Integrable fun u : ℝ => χ.check u * g (y - u • basisVec ℓ) := by
  refine (χ.check.integrable.norm.mul_const B).mono' ?_ (Eventually.of_forall fun u => ?_)
  · exact (χ.check.continuous.aestronglyMeasurable).mul
      (hg.comp (measurable_const.sub (measurable_id.smul_const _))).aestronglyMeasurable
  · rw [norm_mul]; exact mul_le_mul_of_nonneg_left (hB _) (norm_nonneg _)

theorem lineConvC_add (χ : CoordMult) (ℓ : Fin 3) {g₁ g₂ : E3 → ℂ} (h₁ : Measurable g₁)
    (h₂ : Measurable g₂) {B₁ B₂ : ℝ} (hB₁ : ∀ y, ‖g₁ y‖ ≤ B₁) (hB₂ : ∀ y, ‖g₂ y‖ ≤ B₂) :
    lineConvC χ ℓ (g₁ + g₂) = lineConvC χ ℓ g₁ + lineConvC χ ℓ g₂ := by
  funext y
  simp only [lineConvC, Pi.add_apply, mul_add]
  exact integral_add (integrable_lineConvC_integrand χ ℓ h₁ hB₁ y)
    (integrable_lineConvC_integrand χ ℓ h₂ hB₂ y)

theorem lineConvC_smul (χ : CoordMult) (ℓ : Fin 3) (c : ℂ) (g : E3 → ℂ) :
    lineConvC χ ℓ (c • g) = c • lineConvC χ ℓ g := by
  funext y
  simp only [lineConvC, Pi.smul_apply, smul_eq_mul, ← integral_const_mul]
  congr 1; funext u; ring

/-- **Young's inequality** for the line convolutions: `‖h(D_ℓ) g‖_P ≤ ‖ȟ‖_1 ‖g‖_P`, `P ≥ 1`. -/
theorem eLpNorm_lineConvC_le (χ : CoordMult) (ℓ : Fin 3) {g : E3 → ℂ} (hg : Measurable g)
    {P : ℝ} (hP : 1 ≤ P) :
    eLpNorm (lineConvC χ ℓ g) (ENNReal.ofReal P) volume
      ≤ (∫⁻ u, ‖χ.check u‖ₑ) * eLpNorm g (ENNReal.ofReal P) volume := by
  have hP0 : 0 < P := by linarith
  set W := ∫⁻ u, ‖χ.check u‖ₑ with hW
  have hwm : Measurable fun u : ℝ => ‖χ.check u‖ₑ := χ.check.continuous.measurable.enorm
  have hF : Measurable (Function.uncurry fun (y : E3) (u : ℝ) => ‖g (y - u • basisVec ℓ)‖ₑ) :=
    (hg.comp (measurable_lineShift ℓ)).enorm
  have hMJ := lintegral_rpow_lintegral_le volume volume hwm hF hP
  have htr : ∀ u : ℝ, ∫⁻ y, ‖g (y - u • basisVec ℓ)‖ₑ ^ P = ∫⁻ y, ‖g y‖ₑ ^ P := fun u =>
    lintegral_sub_right_eq_self (fun y => ‖g y‖ₑ ^ P) (u • basisVec ℓ)
  simp only [htr] at hMJ
  rw [lintegral_mul_const _ hwm] at hMJ
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hP0) ENNReal.ofReal_ne_top,
    eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hP0) ENNReal.ofReal_ne_top,
    ENNReal.toReal_ofReal hP0.le]
  have hpt : ∀ y, ‖lineConvC χ ℓ g y‖ₑ ≤ ∫⁻ u, ‖χ.check u‖ₑ * ‖g (y - u • basisVec ℓ)‖ₑ := by
    intro y
    refine (enorm_integral_le_lintegral_enorm _).trans (le_of_eq ?_)
    refine lintegral_congr fun u => ?_
    rw [enorm_mul]
  calc (∫⁻ y, ‖lineConvC χ ℓ g y‖ₑ ^ P) ^ (1 / P)
      ≤ (∫⁻ y, (∫⁻ u, ‖χ.check u‖ₑ * ‖g (y - u • basisVec ℓ)‖ₑ) ^ P) ^ (1 / P) := by
        gcongr with y; exact hpt y
    _ ≤ (W ^ (P - 1) * (W * ∫⁻ y, ‖g y‖ₑ ^ P)) ^ (1 / P) := by gcongr
    _ = W * (∫⁻ y, ‖g y‖ₑ ^ P) ^ (1 / P) := by
        have eW : W ^ (P - 1) * W = W ^ P := by
          rw [show W ^ (P - 1) * W = W ^ (P - 1) * W ^ (1 : ℝ) by rw [ENNReal.rpow_one],
            ← ENNReal.rpow_add_of_nonneg _ _ (by linarith) zero_le_one, show P - 1 + 1 = P by ring]
        rw [← mul_assoc, eW, ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
          ← ENNReal.rpow_mul, mul_one_div_cancel hP0.ne', ENNReal.rpow_one]

theorem measurable_update {h : Fin 3 → E3 → ℂ} {n : Fin 3} (hh : ∀ m, m ≠ n → Measurable (h m))
    {a : E3 → ℂ} (ha : Measurable a) : ∀ m, Measurable (Function.update h n a m) := by
  intro m
  by_cases hm : m = n
  · subst hm; rw [Function.update_self]; exact ha
  · rw [Function.update_of_ne hm]; exact hh m hm

theorem bound_update {h : Fin 3 → E3 → ℂ} {n : Fin 3} {B : ℝ} (hh : ∀ m, m ≠ n → ∀ y, ‖h m y‖ ≤ B)
    {a : E3 → ℂ} (ha : ∀ y, ‖a y‖ ≤ B) : ∀ m y, ‖Function.update h n a m y‖ ≤ B := by
  intro m y
  by_cases hm : m = n
  · subst hm; rw [Function.update_self]; exact ha y
  · rw [Function.update_of_ne hm]; exact hh m hm y

theorem prodShift_update' (h : Fin 3 → E3 → ℂ) (n : Fin 3) (a : E3 → ℂ) (x : E3) (t : ℝ) :
    prodShift (Function.update h n a) x t
      = a (x + curve n t) * ∏ m ∈ Finset.univ.erase n, h m (x + curve m t) := by
  unfold prodShift
  rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ n), Function.update_self]
  congr 1
  refine Finset.prod_congr rfl fun m hm => ?_
  rw [Function.update_of_ne (Finset.ne_of_mem_erase hm)]

/-- `T_j` is additive in every slot on bounded measurable inputs. -/
theorem simplexTj_update_add (j : ℤ) (h : Fin 3 → E3 → ℂ) (n : Fin 3)
    (hh : ∀ m, m ≠ n → Measurable (h m)) {a b : E3 → ℂ} (ha : Measurable a) (hb : Measurable b)
    {B : ℝ} (hB : ∀ m, m ≠ n → ∀ y, ‖h m y‖ ≤ B) (haB : ∀ y, ‖a y‖ ≤ B) (hbB : ∀ y, ‖b y‖ ≤ B)
    (x : E3) :
    simplexTj j (Function.update h n (a + b)) x
      = simplexTj j (Function.update h n a) x + simplexTj j (Function.update h n b) x := by
  unfold simplexTj
  rw [← integral_add (integrable_simplexTj_integrand j (measurable_update hh ha) (bound_update hB haB) x)
    (integrable_simplexTj_integrand j (measurable_update hh hb) (bound_update hB hbB) x)]
  congr 1; funext t
  simp only [prodShift_update', Pi.add_apply]
  ring

theorem simplexTj_update_smul (j : ℤ) (h : Fin 3 → E3 → ℂ) (n : Fin 3) (c : ℂ) (a : E3 → ℂ)
    (x : E3) :
    simplexTj j (Function.update h n (c • a)) x = c * simplexTj j (Function.update h n a) x := by
  unfold simplexTj
  rw [← integral_const_mul]
  congr 1; funext t
  simp only [prodShift_update', Pi.smul_apply, smul_eq_mul]
  ring

theorem lineConvC_update (χ : Fin 3 → CoordMult) (g : Fin 3 → E3 → ℂ) (n : Fin 3) (a : E3 → ℂ) :
    (fun m => lineConvC (χ m) m (Function.update g n a m))
      = Function.update (fun m => lineConvC (χ m) m (g m)) n (lineConvC (χ n) n a) := by
  funext m
  by_cases hm : m = n
  · subst hm; simp only [Function.update_self]
  · simp only [Function.update_of_ne hm]

theorem measurable_gOp (χ : Fin 3 → ℤ → CoordMult) (J : ℕ) {g : Fin 3 → E3 → ℂ}
    (hg : ∀ m, Measurable (g m)) : Measurable (gOp χ J g) := by
  unfold gOp
  refine Finset.measurable_sum _ fun j _ => measurable_simplexTj j fun m => ?_
  exact measurable_lineConvC _ _ (hg m)

/-- `T^{(k_2,k_3)}_J` is additive in every slot on bounded measurable inputs. -/
theorem gOp_update_add (χ : Fin 3 → ℤ → CoordMult) (J : ℕ) (g : Fin 3 → E3 → ℂ) (n : Fin 3)
    (hg : ∀ m, m ≠ n → Measurable (g m)) (hgB : ∀ m, m ≠ n → IsBdd (g m)) {a b : E3 → ℂ}
    (ha : Measurable a) (hb : Measurable b) (haB : IsBdd a) (hbB : IsBdd b) :
    gOp χ J (Function.update g n (a + b))
      = gOp χ J (Function.update g n a) + gOp χ J (Function.update g n b) := by
  funext x
  simp only [gOp, Pi.add_apply, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  simp only [lineConvC_update (fun m => χ m j)]
  choose Bm hBm using hgB
  obtain ⟨Ba, hBa⟩ := haB
  obtain ⟨Bb, hBb⟩ := hbB
  set K : Fin 3 → ℝ := fun m => ∫ u, ‖(χ m j).check u‖ with hK
  have hK0 : ∀ m, 0 ≤ K m := fun m => integral_nonneg fun u => norm_nonneg _
  set Bm' : Fin 3 → ℝ := fun m => if hm : m = n then 0 else |Bm m hm|
  set Bt : ℝ := ∑ m, K m * Bm' m + K n * |Ba| + K n * |Bb| with hBt
  have hBm'0 : ∀ m, 0 ≤ K m * Bm' m := fun m => mul_nonneg (hK0 m) (by
    simp only [Bm']; split_ifs <;> positivity)
  have hsum0 : 0 ≤ ∑ m, K m * Bm' m := Finset.sum_nonneg fun m _ => hBm'0 m
  have ha' : ∀ y, ‖a y‖ ≤ |Ba| := fun y => (hBa y).trans (le_abs_self _)
  have hb' : ∀ y, ‖b y‖ ≤ |Bb| := fun y => (hBb y).trans (le_abs_self _)
  rw [lineConvC_add (χ n j) n ha hb ha' hb']
  refine simplexTj_update_add j _ n (fun m _ => measurable_lineConvC _ _ (hg m ‹_›))
    (measurable_lineConvC _ _ ha) (measurable_lineConvC _ _ hb) (B := Bt) ?_ ?_ ?_ x
  · intro m hm y
    refine (norm_lineConvC_le (χ m j) m (fun y => (hBm m hm y).trans (le_abs_self _)) y).trans ?_
    have h1 : K m * |Bm m hm| = K m * Bm' m := by simp only [Bm', dif_neg hm]
    have h2 : K m * Bm' m ≤ ∑ m, K m * Bm' m :=
      Finset.single_le_sum (f := fun m => K m * Bm' m) (fun m _ => hBm'0 m) (Finset.mem_univ m)
    have : 0 ≤ K n * |Ba| + K n * |Bb| := by have := hK0 n; positivity
    change K m * |Bm m hm| ≤ Bt
    linarith
  · intro y
    refine (norm_lineConvC_le (χ n j) n ha' y).trans ?_
    have : 0 ≤ K n * |Bb| := by have := hK0 n; positivity
    change K n * |Ba| ≤ Bt
    linarith
  · intro y
    refine (norm_lineConvC_le (χ n j) n hb' y).trans ?_
    have : 0 ≤ K n * |Ba| := by have := hK0 n; positivity
    change K n * |Bb| ≤ Bt
    linarith

theorem gOp_update_smul (χ : Fin 3 → ℤ → CoordMult) (J : ℕ) (g : Fin 3 → E3 → ℂ) (n : Fin 3)
    (c : ℂ) (a : E3 → ℂ) :
    gOp χ J (Function.update g n (c • a)) = c • gOp χ J (Function.update g n a) := by
  funext x
  simp only [gOp, Pi.smul_apply, smul_eq_mul, Finset.mul_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  simp only [lineConvC_update (fun m => χ m j), lineConvC_smul, simplexTj_update_smul]

/-- The constant of the crude bound for `T^{(k_2,k_3)}_J` (fixed `J`). -/
def gOpConst (χ : Fin 3 → ℤ → CoordMult) (J : ℕ) : ℝ≥0∞ :=
  ∑ j ∈ Finset.Icc (-(J : ℤ)) J, (∫⁻ t, wJ j t) * ((∫⁻ u, ‖(χ 0 j).check u‖ₑ) *
    ((∫⁻ u, ‖(χ 1 j).check u‖ₑ) * (∫⁻ u, ‖(χ 2 j).check u‖ₑ)))

theorem gOpConst_ne_top (χ : Fin 3 → ℤ → CoordMult) (J : ℕ) : gOpConst χ J ≠ ⊤ :=
  ENNReal.sum_ne_top.mpr fun j _ => ENNReal.mul_ne_top (lintegral_wJ_ne_top j)
    (ENNReal.mul_ne_top (χ 0 j).check.integrable.2.ne (ENNReal.mul_ne_top
      (χ 1 j).check.integrable.2.ne (χ 2 j).check.integrable.2.ne))

/-- **The crude bound** (Minkowski, Hölder and Young, fixed `J`): used only for the density
arguments. -/
theorem eLpNorm_gOp_le (χ : Fin 3 → ℤ → CoordMult) (J : ℕ) {g : Fin 3 → E3 → ℂ}
    (hg : ∀ m, Measurable (g m)) {r : ℝ} (hr1 : 1 ≤ r) {P : Fin 3 → ℝ} (hP : ∀ m, 1 ≤ P m)
    (hsum : 1 / r = 1 / P 0 + 1 / P 1 + 1 / P 2) :
    eLpNorm (gOp χ J g) (ENNReal.ofReal r) volume
      ≤ gOpConst χ J * (eLpNorm (g 0) (ENNReal.ofReal (P 0)) volume *
          (eLpNorm (g 1) (ENNReal.ofReal (P 1)) volume * eLpNorm (g 2) (ENNReal.ofReal (P 2)) volume)) := by
  set Sj := Finset.Icc (-(J : ℤ)) J
  have hmeas : ∀ j, ∀ m, Measurable (lineConvC (χ m j) m (g m)) := fun j m =>
    measurable_lineConvC _ _ (hg m)
  have hfun : gOp χ J g = ∑ j ∈ Sj, simplexTj j (fun m => lineConvC (χ m j) m (g m)) := by
    funext x; simp [gOp, Finset.sum_apply, Sj]
  rw [hfun]
  refine (eLpNorm_sum_le (fun j _ => (measurable_simplexTj j (hmeas j)).aestronglyMeasurable)
    (by simpa using hr1)).trans ?_
  unfold gOpConst
  rw [Finset.sum_mul]
  refine Finset.sum_le_sum fun j _ => ?_
  have h := eLpNorm_simplexTj_le j (hmeas j) hr1 (P := P) (fun m => by linarith [hP m]) hsum
  refine h.trans ?_
  have y0 := eLpNorm_lineConvC_le (χ 0 j) 0 (hg 0) (hP 0)
  have y1 := eLpNorm_lineConvC_le (χ 1 j) 1 (hg 1) (hP 1)
  have y2 := eLpNorm_lineConvC_le (χ 2 j) 2 (hg 2) (hP 2)
  calc (∫⁻ t, wJ j t) * (eLpNorm (lineConvC (χ 0 j) 0 (g 0)) (ENNReal.ofReal (P 0)) volume *
        (eLpNorm (lineConvC (χ 1 j) 1 (g 1)) (ENNReal.ofReal (P 1)) volume *
          eLpNorm (lineConvC (χ 2 j) 2 (g 2)) (ENNReal.ofReal (P 2)) volume))
      ≤ (∫⁻ t, wJ j t) * (((∫⁻ u, ‖(χ 0 j).check u‖ₑ) * eLpNorm (g 0) (ENNReal.ofReal (P 0)) volume) *
        (((∫⁻ u, ‖(χ 1 j).check u‖ₑ) * eLpNorm (g 1) (ENNReal.ofReal (P 1)) volume) *
          ((∫⁻ u, ‖(χ 2 j).check u‖ₑ) * eLpNorm (g 2) (ENNReal.ofReal (P 2)) volume))) := by
        gcongr
    _ = _ := by ring

/-- **Density transfer in one slot**: a bound for `T^{(k_2,k_3)}_J` in slot `n` (the other inputs
fixed and admissible) on a class `A` of admissible inputs that approximates every admissible input
in `L^{P_n}` passes to all admissible inputs. -/
theorem gOp_slot_transfer (χ : Fin 3 → ℤ → CoordMult) (J : ℕ) (n : Fin 3) {g : Fin 3 → E3 → ℂ}
    (hg : ∀ m, m ≠ n → GoodIn (g m)) {r : ℝ} (hr1 : 1 ≤ r) {P : Fin 3 → ℝ} (hP : ∀ m, 1 ≤ P m)
    (hsum : 1 / r = 1 / P 0 + 1 / P 1 + 1 / P 2) {M : ℝ≥0∞} (hM : M ≠ ⊤)
    (A : (E3 → ℂ) → Prop)
    (hA : ∀ a, GoodIn a → ∀ ε : ℝ≥0∞, 0 < ε → ∃ φ, A φ ∧ GoodIn φ ∧
      eLpNorm (a - φ) (ENNReal.ofReal (P n)) volume ≤ ε)
    (hbound : ∀ φ, A φ → GoodIn φ → eLpNorm (gOp χ J (Function.update g n φ)) (ENNReal.ofReal r) volume
      ≤ M * eLpNorm φ (ENNReal.ofReal (P n)) volume)
    {a : E3 → ℂ} (ha : GoodIn a) :
    eLpNorm (gOp χ J (Function.update g n a)) (ENNReal.ofReal r) volume
      ≤ M * eLpNorm a (ENNReal.ofReal (P n)) volume := by
  set N : Fin 3 → ℝ≥0∞ := fun m => if m = n then 1 else eLpNorm (g m) (ENNReal.ofReal (P m)) volume
  have hN : ∀ m, N m ≠ ⊤ := fun m => by
    simp only [N]; split_ifs with h
    · exact ENNReal.one_ne_top
    · exact (hg m h).eLpNorm_ne_top (hP m)
  set C : ℝ≥0∞ := gOpConst χ J * (N 0 * (N 1 * N 2))
  have hC : C ≠ ⊤ := ENNReal.mul_ne_top (gOpConst_ne_top χ J)
    (ENNReal.mul_ne_top (hN 0) (ENNReal.mul_ne_top (hN 1) (hN 2)))
  have hcrude : ∀ b, Measurable b → eLpNorm (gOp χ J (Function.update g n b)) (ENNReal.ofReal r) volume
      ≤ C * eLpNorm b (ENNReal.ofReal (P n)) volume := by
    intro b hb
    refine (eLpNorm_gOp_le χ J (measurable_update (fun m hm => (hg m hm).1) hb) hr1 hP hsum).trans
      (le_of_eq ?_)
    simp only [C, N]
    fin_cases n <;> simp [Function.update] <;> ring
  obtain ⟨hPn⟩ : ∃ _ : (1 : ℝ) ≤ P n, True := ⟨hP n, trivial⟩
  refine eLpNorm_bound_transfer (T := fun b => gOp χ J (Function.update g n b))
    (fun b c hb hc hbB hcB => gOp_update_add χ J g n (fun m hm => (hg m hm).1)
      (fun m hm => (hg m hm).2.1) hb hc hbB hcB)
    (fun b hb => measurable_gOp χ J (measurable_update (fun m hm => (hg m hm).1) hb))
    hr1 (hP n) hC hcrude hM ha.1 ha.2.1 fun ε hε => ?_
  obtain ⟨φ, hAφ, hφ, hφε⟩ := hA a ha ε hε
  exact ⟨φ, hφ.1, hφ.2.1, hφε, hbound φ hAφ hφ⟩

/-- Schwartz functions approximate admissible inputs in `L^P`. -/
theorem goodIn_approx_schwartz {a : E3 → ℂ} (ha : GoodIn a) {P : ℝ} (hP : 1 ≤ P)
    (ε : ℝ≥0∞) (hε : 0 < ε) : ∃ φ : E3 → ℂ, (∃ F : 𝓢(E3, ℂ), ⇑F = φ) ∧ GoodIn φ ∧
      eLpNorm (a - φ) (ENNReal.ofReal P) volume ≤ ε := by
  obtain ⟨ε', hε', hε'δ⟩ := exists_real_pos_ofReal_le hε
  obtain ⟨ψ, hψc, hψd, hψε⟩ := (ha.2.2 P hP).exist_eLpNorm_sub_le ENNReal.ofReal_ne_top
    (by simpa using hP) hε'
  set Φ : 𝓢(E3, ℂ) := hψc.toSchwartzMap hψd
  have hΦ : (Φ : E3 → ℂ) = ψ := rfl
  refine ⟨ψ, ⟨Φ, hΦ⟩, hΦ ▸ goodIn_schwartz Φ, hψε.trans hε'δ⟩

/-- Integrable simple functions approximate admissible inputs in `L^P`. -/
theorem goodIn_approx_simple {a : E3 → ℂ} (ha : GoodIn a) {P : ℝ} (hP : 1 ≤ P)
    (ε : ℝ≥0∞) (hε : 0 < ε) : ∃ φ : E3 → ℂ, (∃ s : SimpleFunc E3 ℂ, Integrable s ∧ ⇑s = φ) ∧
      GoodIn φ ∧ eLpNorm (a - φ) (ENNReal.ofReal P) volume ≤ ε := by
  have hP0 : ENNReal.ofReal P ≠ 0 := by simpa using (by linarith : (0 : ℝ) < P)
  obtain ⟨s, hsε, hsP⟩ := (ha.2.2 P hP).exists_simpleFunc_eLpNorm_sub_lt ENNReal.ofReal_ne_top hε.ne'
  have hsI : Integrable s := (SimpleFunc.memLp_iff_integrable hP0 ENNReal.ofReal_ne_top).mp hsP
  exact ⟨s, ⟨s, hsI, rfl⟩, goodIn_simple s hsI, hsε.le⟩

/-! ### The loss-free bound for the grouped operators (alternative route, line 620) -/

theorem lintegral_wJ_le (j : ℤ) : ∫⁻ t, wJ j t ≤ 8 := by
  set r : ℝ := (2 : ℝ) ^ (-j) with hr
  have hr0 : 0 < r := zpow_pos two_pos _
  have hle : ∀ t, wJ j t ≤ ENNReal.ofReal (2 / r) * Set.indicator (Set.Icc (-(2 * r)) (2 * r)) 1 t := by
    intro t
    refine (wJ_le_indicator j t).trans ?_
    gcongr
    by_cases ht : |t| ∈ Set.Icc (r / 2) (2 * r)
    · rw [Set.indicator_of_mem ht, Set.indicator_of_mem (Set.mem_Icc.mpr (abs_le.mp ht.2))]
      simp
    · rw [Set.indicator_of_notMem ht]; exact bot_le
  calc ∫⁻ t, wJ j t ≤ ∫⁻ t, ENNReal.ofReal (2 / r) * Set.indicator (Set.Icc (-(2 * r)) (2 * r)) 1 t :=
        lintegral_mono hle
    _ = ENNReal.ofReal (2 / r) * volume (Set.Icc (-(2 * r)) (2 * r)) := by
        rw [lintegral_const_mul _ (measurable_one.indicator measurableSet_Icc),
          lintegral_indicator_one measurableSet_Icc]
    _ = 8 := by
        rw [Real.volume_Icc, ← ENNReal.ofReal_mul (by positivity)]
        rw [show 2 / r * (2 * r - -(2 * r)) = 8 by field_simp; ring]
        simp

/-- **The `L^2` slots, `q ≥ 2`**: `∫ (∑_{|j| ≤ J} B_j(Δ^{(n)}_{(n+1)j+k_n} g))^{q/2} ≲ ‖g‖_q^q`. -/
theorem lintegral_curveAvg_slot_le' (n : Fin 3) {q : ℝ} (hq : 2 ≤ q) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ (kn : ℤ) (J : ℕ) (g : 𝓢(E3, ℂ)),
      ∫⁻ x, (∑ j ∈ Finset.Icc (-(J : ℤ)) J,
          curveAvg n j (lpDelta n ((expo n : ℤ) * j + kn) g) x) ^ (q / 2)
        ≤ ENNReal.ofReal A * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ q) := by
  rcases hq.lt_or_eq with hq | hq
  · exact lintegral_curveAvg_slot_le n hq
  subst hq
  obtain ⟨A0, hA0, hS⟩ := sum_lintegral_lpDelta_le n (q := 2) le_rfl
  refine ⟨8 * A0, by positivity, fun kn J g => ?_⟩
  have hinj : Set.InjOn (fun j : ℤ => (expo n : ℤ) * j + kn) (Finset.Icc (-(J : ℤ)) J) := by
    intro a _ b _ h
    have : (expo n : ℤ) * a = (expo n : ℤ) * b := by simpa using h
    exact mul_left_cancel₀ (by exact_mod_cast (expo_pos n).ne') this
  have h2 := hS ((Finset.Icc (-(J : ℤ)) J).image fun j => (expo n : ℤ) * j + kn) g
  rw [Finset.sum_image hinj] at h2
  simp only [div_self (two_ne_zero' ℝ), ENNReal.rpow_one]
  rw [lintegral_finsetSum _ fun j _ => measurable_curveAvg n j (lpDelta _ _ g).continuous.measurable]
  have hj : ∀ j, ∫⁻ x, curveAvg n j (lpDelta n ((expo n : ℤ) * j + kn) g) x
      ≤ 8 * ∫⁻ x, ENNReal.ofReal (‖lpDelta n ((expo n : ℤ) * j + kn) g x‖ ^ (2 : ℝ)) := by
    intro j
    have h := lintegral_curveAvg_mul n j (lpDelta n ((expo n : ℤ) * j + kn) g).continuous.measurable
      (K := fun _ => 1) measurable_const
    simp only [mul_one] at h
    rw [h]
    calc ∫⁻ y, ‖lpDelta n ((expo n : ℤ) * j + kn) g y‖ₑ ^ (2 : ℝ) * ∫⁻ t, wJ j t
        ≤ ∫⁻ y, ‖lpDelta n ((expo n : ℤ) * j + kn) g y‖ₑ ^ (2 : ℝ) * 8 := by
          gcongr; exact lintegral_wJ_le j
      _ = 8 * ∫⁻ x, ENNReal.ofReal (‖lpDelta n ((expo n : ℤ) * j + kn) g x‖ ^ (2 : ℝ)) := by
          rw [lintegral_mul_const _ ((lpDelta _ _ g).continuous.measurable.enorm.pow_const _), mul_comm]
          congr 1
          refine lintegral_congr fun x => ?_
          rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by norm_num)]
  calc ∑ j ∈ Finset.Icc (-(J : ℤ)) J, ∫⁻ x, curveAvg n j (lpDelta n ((expo n : ℤ) * j + kn) g) x
      ≤ ∑ j ∈ Finset.Icc (-(J : ℤ)) J,
          8 * ∫⁻ x, ENNReal.ofReal (‖lpDelta n ((expo n : ℤ) * j + kn) g x‖ ^ (2 : ℝ)) :=
        Finset.sum_le_sum fun j _ => hj j
    _ ≤ 8 * (ENNReal.ofReal A0 * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℝ))) := by
        rw [← Finset.mul_sum]; gcongr
    _ = _ := by
        rw [← mul_assoc, ENNReal.ofReal_mul (by norm_num)]; norm_num

/-- `|ȟ_0(u)| ≤ K (1 + |u|)^{-10}` for every coordinate multiplier. -/
theorem exists_check_decay (χ : CoordMult) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ u : ℝ, ‖χ.check u‖ ≤ K * Twisted.bracketKernel u := by
  set f := χ.check
  set K : ℝ := 2 ^ 10 * (Finset.Iic ((10 : ℕ), (0 : ℕ))).sup
    (fun m => SchwartzMap.seminorm ℝ m.1 m.2) f
  have hK : 0 ≤ K := by positivity
  refine ⟨K, hK, fun u => ?_⟩
  have h := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := ((10 : ℕ), (0 : ℕ)))
    (k := 10) (n := 0) le_rfl le_rfl f u
  rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at h
  have hpos : 0 < (1 + |u|) ^ 10 := by positivity
  unfold Twisted.bracketKernel
  rw [Real.rpow_neg (by positivity), show ((10 : ℝ)) = ((10 : ℕ) : ℝ) by norm_num,
    Real.rpow_natCast, ← div_eq_mul_inv, le_div_iff₀ hpos, mul_comm]
  exact h

/-- The scaled bracket for a dyadic family: `|ȟ_c(u)| ≤ K b_{2^{-c}}(u)`. -/
theorem IsDyadicFam.norm_check_le {χ : ℤ → CoordMult} (hχ : IsDyadicFam χ) {K : ℝ}
    (hK : ∀ u : ℝ, ‖(χ 0).check u‖ ≤ K * Twisted.bracketKernel u) (c : ℤ) (u : ℝ) :
    ‖(χ c).check u‖ ≤ K * Twisted.bracketKernelAt ((2 : ℝ) ^ (-c)) 0 u := by
  have hp : (0 : ℝ) < 2 ^ c := zpow_pos two_pos _
  rw [hχ.check_eq, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hp]
  simp only [Twisted.bracketKernelAt, Twisted.kernelAt, Twisted.kernelDilate, sub_zero,
    smul_eq_mul, zpow_neg, inv_inv, div_inv_eq_mul]
  calc (2 : ℝ) ^ c * ‖(χ 0).check ((2 : ℝ) ^ c * u)‖
      ≤ 2 ^ c * (K * Twisted.bracketKernel ((2 : ℝ) ^ c * u)) :=
        mul_le_mul_of_nonneg_left (hK _) hp.le
    _ = K * (2 ^ c * Twisted.bracketKernel (u * 2 ^ c)) := by rw [mul_comm u]; ring

/-- **Bounded shifts of the line convolutions**: for a dyadic family, bounded measurable `g` and
`|s| ≤ R 2^{-c}`, `|h_c(D_ℓ) g(y + s e_ℓ)| ≤ C (1 + R)^{10} M^{(ℓ)} g(y)`. -/
theorem norm_lineConvC_shift_le {χ : ℤ → CoordMult} (hχ : IsDyadicFam χ) (ℓ : Fin 3) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (c : ℤ) (g : E3 → ℂ), Measurable g → ∀ B : ℝ, (∀ y, ‖g y‖ ≤ B) →
      ∀ (y : E3) (s R : ℝ), 0 ≤ R → |s| ≤ R * (2 : ℝ) ^ (-c) →
        ‖lineConvC (χ c) ℓ g (y + s • basisVec ℓ)‖
          ≤ C * (1 + R) ^ (10 : ℝ) * Twisted.coordinateDyadicBallMaximal ℓ g y := by
  obtain ⟨K, hK0, hK⟩ := exists_check_decay (χ 0)
  set D := Twisted.dyadicBracketShellConstant
  have hD0 : 0 ≤ D := Twisted.dyadicBracketShellConstant_nonneg
  refine ⟨K * D, mul_nonneg hK0 hD0, fun c g hg B hB y s R hR hs => ?_⟩
  have hB0 : 0 ≤ B := (norm_nonneg _).trans (hB y)
  set r : ℝ := (2 : ℝ) ^ (-c) with hr
  have hr0 : 0 < r := zpow_pos two_pos _
  set b : ℝ → ℝ := fun v => Twisted.bracketKernelAt r 0 v with hb
  have hb0 : ∀ v, 0 ≤ b v := fun v => Twisted.bracketKernelAt_nonneg hr0.le
  have hbint : Integrable b := Twisted.integrable_bracketKernelAt hr0 0
  have hsR : (1 + |s| / r) ^ (10 : ℝ) ≤ (1 + R) ^ (10 : ℝ) := by
    refine Real.rpow_le_rpow (by positivity) ?_ (by norm_num)
    have : |s| / r ≤ R := by rw [div_le_iff₀ hr0]; exact hs
    linarith
  -- change of variables `u = v + s`
  have hcv : lineConvC (χ c) ℓ g (y + s • basisVec ℓ)
      = ∫ v : ℝ, (χ c).check (v + s) * g (y - v • basisVec ℓ) := by
    unfold lineConvC
    rw [← integral_add_right_eq_self (fun u => (χ c).check u * g (y + s • basisVec ℓ - u • basisVec ℓ)) s]
    refine integral_congr_ae (Eventually.of_forall fun v => ?_)
    simp only
    congr 2
    rw [add_smul]; abel
  have hgm : Measurable fun v : ℝ => g (y - v • basisVec ℓ) :=
    hg.comp (measurable_const.sub (measurable_id.smul_const _))
  have hint : Integrable fun v : ℝ => ‖g (y - v • basisVec ℓ)‖ * b v := by
    refine (hbint.const_mul B).mono' ((hgm.norm.mul (Twisted.measurable_bracketKernelAt hr0.ne' 0))
      |>.aestronglyMeasurable) (Eventually.of_forall fun v => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (norm_nonneg _) (hb0 v))]
    exact mul_le_mul_of_nonneg_right (hB _) (hb0 v)
  rw [hcv]
  have hmax := integral_bracket_le_maximal ℓ hg hB hr0 y
  calc ‖∫ v : ℝ, (χ c).check (v + s) * g (y - v • basisVec ℓ)‖
      ≤ ∫ v : ℝ, ‖(χ c).check (v + s) * g (y - v • basisVec ℓ)‖ := norm_integral_le_integral_norm _
    _ ≤ ∫ v : ℝ, K * (1 + R) ^ (10 : ℝ) * (‖g (y - v • basisVec ℓ)‖ * b v) := by
        refine integral_mono_of_nonneg (Eventually.of_forall fun v => norm_nonneg _)
          (hint.const_mul _) (Eventually.of_forall fun v => ?_)
        simp only
        rw [norm_mul]
        have h1 := hχ.norm_check_le hK c (v + s)
        have h2 := bracketKernelAt_add_le hr0 v s
        have h3 : ‖(χ c).check (v + s)‖ ≤ K * (1 + R) ^ (10 : ℝ) * b v :=
          h1.trans (by
            calc K * Twisted.bracketKernelAt r 0 (v + s)
                ≤ K * ((1 + |s| / r) ^ (10 : ℝ) * b v) := mul_le_mul_of_nonneg_left h2 hK0
              _ ≤ K * ((1 + R) ^ (10 : ℝ) * b v) := by gcongr; exact hb0 v
              _ = _ := by ring)
        calc ‖(χ c).check (v + s)‖ * ‖g (y - v • basisVec ℓ)‖
            ≤ K * (1 + R) ^ (10 : ℝ) * b v * ‖g (y - v • basisVec ℓ)‖ :=
              mul_le_mul_of_nonneg_right h3 (norm_nonneg _)
          _ = _ := by ring
    _ = K * (1 + R) ^ (10 : ℝ) * ∫ v : ℝ, ‖g (y - v • basisVec ℓ)‖ * b v := integral_const_mul _ _
    _ ≤ K * (1 + R) ^ (10 : ℝ) * (D * Twisted.coordinateDyadicBallMaximal ℓ g y) := by
        gcongr
    _ = _ := by ring

/-- **Cauchy-Schwarz in `t`** for `T_j` with a bounded slot `n_0`:
`|T_j(h)(x)| ≤ a B_j(h_{σ_0})(x)^{1/2} B_j(h_{σ_1})(x)^{1/2}`. -/
theorem enorm_simplexTj_le_slot (j : ℤ) (n0 : Fin 3) (h : Fin 3 → E3 → ℂ)
    (hh : ∀ n, Measurable (h n)) (x : E3) (a : ℝ≥0∞)
    (ha : ∀ t : ℝ, |t| < 2 * (2 : ℝ) ^ (-j) → ‖h n0 (x + curve n0 t)‖ₑ ≤ a) :
    ‖simplexTj j h x‖ₑ ≤ a * (curveAvg (n0.succAbove 0) j (h (n0.succAbove 0)) x ^ (1 / 2 : ℝ) *
        curveAvg (n0.succAbove 1) j (h (n0.succAbove 1)) x ^ (1 / 2 : ℝ)) := by
  set σ := n0.succAbove
  have hmc : ∀ n, Measurable fun t : ℝ => h n (x + curve n t) := fun n =>
    (hh n).comp (measurable_const.add (continuous_curve n).measurable)
  set u : Fin 3 → ℝ → ℝ≥0∞ := fun n t => ‖h n (x + curve n t)‖ₑ with hu
  have hum : ∀ n, Measurable (u n) := fun n => (hmc n).enorm
  have hpt : ∀ t, ‖(lpPsi ((2 : ℝ) ^ j * t) : ℂ) * prodShift h x t / t‖ₑ
      ≤ a * ((wJ j t ^ (1 / 2 : ℝ) * u (σ 0) t) * (wJ j t ^ (1 / 2 : ℝ) * u (σ 1) t)) := by
    intro t
    have e : ‖(lpPsi ((2 : ℝ) ^ j * t) : ℂ) * prodShift h x t / t‖ₑ
        = wJ j t * (u n0 t * (u (σ 0) t * u (σ 1) t)) := by
      rw [mul_div_right_comm, enorm_mul, prodShift, Fin.prod_univ_succAbove _ n0,
        Fin.prod_univ_two]
      simp only [enorm_mul, u, wJ]
      rfl
    have e2 : (wJ j t ^ (1 / 2 : ℝ) * u (σ 0) t) * (wJ j t ^ (1 / 2 : ℝ) * u (σ 1) t)
        = wJ j t * (u (σ 0) t * u (σ 1) t) := by
      rw [mul_mul_mul_comm, ← ENNReal.rpow_add_of_nonneg _ _ (by norm_num) (by norm_num)]
      norm_num
    rw [e, e2]
    by_cases hw : wJ j t = 0
    · simp [hw]
    · have := ha t (abs_lt_of_wJ_ne_zero hw)
      calc wJ j t * (u n0 t * (u (σ 0) t * u (σ 1) t))
          = u n0 t * (wJ j t * (u (σ 0) t * u (σ 1) t)) := by ring
        _ ≤ a * (wJ j t * (u (σ 0) t * u (σ 1) t)) := by gcongr
  unfold simplexTj
  refine (enorm_integral_le_lintegral_enorm _).trans ?_
  refine (lintegral_mono hpt).trans ?_
  have hf : Measurable fun t => wJ j t ^ (1 / 2 : ℝ) * u (σ 0) t :=
    ((measurable_wJ j).pow_const _).mul (hum _)
  have hg2 : Measurable fun t => wJ j t ^ (1 / 2 : ℝ) * u (σ 1) t :=
    ((measurable_wJ j).pow_const _).mul (hum _)
  rw [lintegral_const_mul a (f := fun t => (wJ j t ^ (1 / 2 : ℝ) * u (σ 0) t) *
    (wJ j t ^ (1 / 2 : ℝ) * u (σ 1) t)) (hf.mul hg2)]
  gcongr
  have h := ENNReal.lintegral_mul_le_Lp_mul_Lq volume Real.HolderConjugate.two_two
    hf.aemeasurable hg2.aemeasurable
  have e : ∀ n t, (wJ j t ^ (1 / 2 : ℝ) * u n t) ^ (2 : ℝ) = wJ j t * u n t ^ (2 : ℝ) := by
    intro n t
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul]; norm_num
  simp only [e] at h
  exact h

/-- **The pointwise bound for the grouped operators**: Cauchy-Schwarz in `t` and in `j`. -/
theorem enorm_gOp_le_slot (χ : Fin 3 → ℤ → CoordMult) (J : ℕ) (n0 : Fin 3) {g : Fin 3 → E3 → ℂ}
    (hg : ∀ n, Measurable (g n)) (x : E3) (a : ℝ≥0∞)
    (ha : ∀ j : ℤ, ∀ t : ℝ, |t| < 2 * (2 : ℝ) ^ (-j) →
      ‖lineConvC (χ n0 j) n0 (g n0) (x + curve n0 t)‖ₑ ≤ a) :
    ‖gOp χ J g x‖ₑ ≤ a * ((∑ j ∈ Finset.Icc (-(J : ℤ)) J, curveAvg (n0.succAbove 0) j
          (lineConvC (χ (n0.succAbove 0) j) (n0.succAbove 0) (g (n0.succAbove 0))) x) ^ (1 / 2 : ℝ) *
        (∑ j ∈ Finset.Icc (-(J : ℤ)) J, curveAvg (n0.succAbove 1) j
          (lineConvC (χ (n0.succAbove 1) j) (n0.succAbove 1) (g (n0.succAbove 1))) x) ^ (1 / 2 : ℝ)) := by
  set Sj := Finset.Icc (-(J : ℤ)) J
  set σ := n0.succAbove
  set B1 : ℤ → ℝ≥0∞ := fun j => curveAvg (σ 0) j (lineConvC (χ (σ 0) j) (σ 0) (g (σ 0))) x
  set B2 : ℤ → ℝ≥0∞ := fun j => curveAvg (σ 1) j (lineConvC (χ (σ 1) j) (σ 1) (g (σ 1))) x
  have hpiece : ∀ j, ‖simplexTj j (fun n => lineConvC (χ n j) n (g n)) x‖ₑ
      ≤ a * (B1 j ^ (1 / 2 : ℝ) * B2 j ^ (1 / 2 : ℝ)) := fun j =>
    enorm_simplexTj_le_slot j n0 _ (fun n => measurable_lineConvC _ _ (hg n)) x a (ha j)
  have hcs : ∑ j ∈ Sj, B1 j ^ (1 / 2 : ℝ) * B2 j ^ (1 / 2 : ℝ)
      ≤ (∑ j ∈ Sj, B1 j) ^ (1 / 2 : ℝ) * (∑ j ∈ Sj, B2 j) ^ (1 / 2 : ℝ) := by
    have h := ENNReal.inner_le_Lp_mul_Lq Sj (fun j => B1 j ^ (1 / 2 : ℝ))
      (fun j => B2 j ^ (1 / 2 : ℝ)) Real.HolderConjugate.two_two
    have e : ∀ B : ℝ≥0∞, (B ^ (1 / 2 : ℝ)) ^ (2 : ℝ) = B := fun B => by
      rw [← ENNReal.rpow_mul]; norm_num
    simp only [e] at h
    exact h
  calc ‖gOp χ J g x‖ₑ ≤ ∑ j ∈ Sj, ‖simplexTj j (fun n => lineConvC (χ n j) n (g n)) x‖ₑ :=
        enorm_sum_le _ _
    _ ≤ ∑ j ∈ Sj, a * (B1 j ^ (1 / 2 : ℝ) * B2 j ^ (1 / 2 : ℝ)) := Finset.sum_le_sum fun j _ => hpiece j
    _ = a * ∑ j ∈ Sj, B1 j ^ (1 / 2 : ℝ) * B2 j ^ (1 / 2 : ℝ) := by rw [Finset.mul_sum]
    _ ≤ _ := by gcongr

/-- The square function of the `L^2` slot `n`: `(∑_{|j| ≤ J} B_j(Δ^{(n)}_{(n+1)j+k_n} g))^{1/2}`. -/
def slotU (n : Fin 3) (kn : ℤ) (J : ℕ) (g : 𝓢(E3, ℂ)) (x : E3) : ℝ≥0∞ :=
  (∑ j ∈ Finset.Icc (-(J : ℤ)) J, curveAvg n j (lpDelta n ((expo n : ℤ) * j + kn) g) x) ^ (1 / 2 : ℝ)

theorem measurable_slotU (n : Fin 3) (kn : ℤ) (J : ℕ) (g : 𝓢(E3, ℂ)) : Measurable (slotU n kn J g) :=
  (Finset.measurable_sum _ fun j _ =>
    measurable_curveAvg n j (lpDelta _ _ g).continuous.measurable).pow_const _

/-- `‖U^{(n)} g‖_q ≲ ‖g‖_q`, `q ≥ 2`, uniformly in `k_n` and `J`. -/
theorem lintegral_slotU_le (n : Fin 3) {q : ℝ} (hq : 2 ≤ q) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ (kn : ℤ) (J : ℕ) (g : 𝓢(E3, ℂ)),
      (∫⁻ x, slotU n kn J g x ^ q) ^ (1 / q) ≤ ENNReal.ofReal A * eLpNorm g (ENNReal.ofReal q) volume := by
  obtain ⟨A, hA, h⟩ := lintegral_curveAvg_slot_le' n hq
  have hq0 : 0 < q := by linarith
  refine ⟨A ^ (1 / q), by positivity, fun kn J g => ?_⟩
  have e : ∀ x, slotU n kn J g x ^ q = (∑ j ∈ Finset.Icc (-(J : ℤ)) J,
      curveAvg n j (lpDelta n ((expo n : ℤ) * j + kn) g) x) ^ (q / 2) := fun x => by
    rw [slotU, ← ENNReal.rpow_mul]; congr 1; ring
  simp only [e]
  calc (∫⁻ x, (∑ j ∈ Finset.Icc (-(J : ℤ)) J,
        curveAvg n j (lpDelta n ((expo n : ℤ) * j + kn) g) x) ^ (q / 2)) ^ (1 / q)
      ≤ (ENNReal.ofReal A * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ q)) ^ (1 / q) := by
        gcongr; exact h kn J g
    _ = ENNReal.ofReal (A ^ (1 / q)) * eLpNorm g (ENNReal.ofReal q) volume := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), lintegral_ofReal_norm_rpow_rpow_inv g hq0,
          ENNReal.ofReal_rpow_of_nonneg hA (by positivity)]

theorem lowCut_nonpos (p : Fin 3 → ℤ) : lowCut p ≤ 0 := min_le_left _ _

theorem abs_curve_pow_le (n : Fin 3) (j c : ℤ) (hc : c ≤ 0) {t : ℝ} (ht : |t| < 2 * (2 : ℝ) ^ (-j)) :
    |t ^ expo n| ≤ (2 : ℝ) ^ expo n * (2 : ℝ) ^ (-((expo n : ℤ) * j + c)) := by
  rw [abs_pow]
  have h1 : |t| ^ expo n ≤ (2 * (2 : ℝ) ^ (-j)) ^ expo n :=
    pow_le_pow_left₀ (abs_nonneg _) ht.le _
  refine h1.trans (le_of_eq_of_le (by rw [mul_pow]) ?_)
  gcongr
  rw [← zpow_natCast, ← zpow_mul]
  refine zpow_le_zpow_right₀ (by norm_num) ?_
  have : (0 : ℤ) ≤ expo n := by positivity
  nlinarith

/-- **The pointwise bound for the grouped operators**: the low-pass slot `n_0` at bounded shifts
(`|S g(x + t^{n_0+1} e_{n_0})| ≲ M g(x)`, no loss since `k_{n_0} ≤ 0`), Cauchy-Schwarz in `t` and `j`. -/
theorem enorm_gOp_low_le (n0 : Fin 3) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (p : Fin 3 → ℤ) (J : ℕ) (g0 : E3 → ℂ), Measurable g0 → ∀ B : ℝ,
      (∀ y, ‖g0 y‖ ≤ B) → ∀ (f : Fin 2 → 𝓢(E3, ℂ)) (x : E3),
        ‖gOp (lowFam n0 p) J (insIn n0 g0 fun i => ⇑(f i)) x‖ₑ
          ≤ ENNReal.ofReal (C * Twisted.coordinateDyadicBallMaximal n0 g0 x) *
            (slotU (n0.succAbove 0) (p (n0.succAbove 0)) J (f 0) x *
              slotU (n0.succAbove 1) (p (n0.succAbove 1)) J (f 1) x) := by
  obtain ⟨C, hC0, hC⟩ := norm_lineConvC_shift_le isDyadicFam_phiCM n0
  set R : ℝ := (2 : ℝ) ^ expo n0
  have hR : 0 ≤ R := by positivity
  refine ⟨C * (1 + R) ^ (10 : ℝ), by positivity, fun p J g0 hg0 B hB f x => ?_⟩
  set σ := n0.succAbove
  set g := insIn n0 g0 fun i => ⇑(f i)
  have hg : ∀ n, Measurable (g n) := by
    intro n
    rcases Fin.eq_self_or_eq_succAbove n0 n with h | ⟨i, rfl⟩
    · subst h; simp only [g, insIn, Fin.insertNth_apply_same]; exact hg0
    · simp only [g, insIn, Fin.insertNth_apply_succAbove]; exact (f i).continuous.measurable
  have hslot : ∀ i : Fin 2, ∀ j : ℤ, lineConvC (lowFam n0 p (σ i) j) (σ i) (g (σ i))
      = ⇑(lpDelta (σ i) ((expo (σ i) : ℤ) * j + p (σ i)) (f i)) := by
    intro i j
    simp only [g, insIn, Fin.insertNth_apply_succAbove, lowFam, σ, Fin.succAbove_ne, if_false,
      lineConvC_schwartz, psiCM_op]
  have h := enorm_gOp_le_slot (lowFam n0 p) J n0 hg x
    (ENNReal.ofReal (C * (1 + R) ^ (10 : ℝ) * Twisted.coordinateDyadicBallMaximal n0 g0 x))
    (fun j t ht => by
      have e0 : g n0 = g0 := by simp only [g, insIn, Fin.insertNth_apply_same]
      have el : lowFam n0 p n0 j = phiCM ((expo n0 : ℤ) * j + lowCut p) := by
        simp only [lowFam, if_true]
      rw [e0, el, curve, ← ofReal_norm]
      refine ENNReal.ofReal_le_ofReal (hC _ g0 hg0 B hB x _ R hR ?_)
      exact abs_curve_pow_le n0 j (lowCut p) (lowCut_nonpos p) ht)
  have e : ∀ i : Fin 2, slotU (σ i) (p (σ i)) J (f i) x = (∑ j ∈ Finset.Icc (-(J : ℤ)) J,
      curveAvg (σ i) j (lineConvC (lowFam n0 p (σ i) j) (σ i) (g (σ i))) x) ^ (1 / 2 : ℝ) := by
    intro i
    unfold slotU
    congr 1
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [hslot]
  rw [e 0, e 1]
  exact h

/-- **The loss-free bound, `q_0 = ∞`** (alternative route, line 620): for `q_1, q_2 ≥ 2`,
`1/r = 1/q_1 + 1/q_2`: `‖T^{(k_2,k_3)}_J(g_0, f_1, f_2)‖_r ≤ C ‖g_0‖_∞ ‖f_1‖_{q_1} ‖f_2‖_{q_2}`,
uniformly in the pair and in `J`. -/
theorem lossFree_inf (n0 : Fin 3) {q1 q2 r : ℝ} (hq1 : 2 ≤ q1) (hq2 : 2 ≤ q2)
    (hr : 1 / r = 1 / q1 + 1 / q2) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (p : Fin 3 → ℤ) (J : ℕ) (g0 : E3 → ℂ), Measurable g0 → ∀ B : ℝ,
      (∀ y, ‖g0 y‖ ≤ B) → ∀ f : Fin 2 → 𝓢(E3, ℂ),
        eLpNorm (gOp (lowFam n0 p) J (insIn n0 g0 fun i => ⇑(f i))) (ENNReal.ofReal r) volume
          ≤ ENNReal.ofReal (C * B) *
            (eLpNorm (f 0) (ENNReal.ofReal q1) volume * eLpNorm (f 1) (ENNReal.ofReal q2) volume) := by
  obtain ⟨C, hC0, hpt⟩ := enorm_gOp_low_le n0
  obtain ⟨A1, hA1, hU1⟩ := lintegral_slotU_le (n0.succAbove 0) hq1
  obtain ⟨A2, hA2, hU2⟩ := lintegral_slotU_le (n0.succAbove 1) hq2
  have hq10 : 0 < q1 := by linarith
  have hq20 : 0 < q2 := by linarith
  have hr0 : 0 < r := by
    have : 0 < 1 / r := by rw [hr]; positivity
    exact one_div_pos.mp this
  have hrq : r < q1 := by
    have h1 : 1 / q1 < 1 / r := by rw [hr]; have : 0 < 1 / q2 := by positivity
                                   linarith
    exact (one_div_lt_one_div hq10 hr0).mp h1
  refine ⟨C * A1 * A2, by positivity, fun p J g0 hg0 B hB f => ?_⟩
  have hB0 : 0 ≤ B := (norm_nonneg _).trans (hB 0)
  set σ := n0.succAbove
  set U1 := slotU (σ 0) (p (σ 0)) J (f 0)
  set U2 := slotU (σ 1) (p (σ 1)) J (f 1)
  set a : ℝ≥0∞ := ENNReal.ofReal (C * B)
  have hle : ∀ x, ‖gOp (lowFam n0 p) J (insIn n0 g0 fun i => ⇑(f i)) x‖ₑ ≤ a * (U1 x * U2 x) := by
    intro x
    refine (hpt p J g0 hg0 B hB f x).trans (mul_le_mul' (ENNReal.ofReal_le_ofReal
      (mul_le_mul_of_nonneg_left (Twisted.coordinateDyadicBallMaximal_top_bound n0 g0 B hB0 hB x) hC0))
      le_rfl)
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hr0) ENNReal.ofReal_ne_top,
    ENNReal.toReal_ofReal hr0.le]
  have hH := ENNReal.lintegral_Lp_mul_le_Lq_mul_Lr hr0 hrq hr volume
    (measurable_slotU (σ 0) (p (σ 0)) J (f 0)).aemeasurable
    (measurable_slotU (σ 1) (p (σ 1)) J (f 1)).aemeasurable
  calc (∫⁻ x, ‖gOp (lowFam n0 p) J (insIn n0 g0 fun i => ⇑(f i)) x‖ₑ ^ r) ^ (1 / r)
      ≤ (∫⁻ x, (a * (U1 x * U2 x)) ^ r) ^ (1 / r) := by gcongr with x; exact hle x
    _ = a * (∫⁻ x, (U1 * U2) x ^ r) ^ (1 / r) := by
        rw [show (fun x => (a * (U1 x * U2 x)) ^ r) = fun x => a ^ r * (U1 * U2) x ^ r from
          funext fun x => by rw [ENNReal.mul_rpow_of_nonneg _ _ hr0.le]; rfl]
        rw [lintegral_const_mul' _ _ (ENNReal.rpow_ne_top_of_nonneg hr0.le ENNReal.ofReal_ne_top),
          ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hr0.ne', ENNReal.rpow_one]
    _ ≤ a * ((∫⁻ x, U1 x ^ q1) ^ (1 / q1) * (∫⁻ x, U2 x ^ q2) ^ (1 / q2)) := by gcongr
    _ ≤ a * ((ENNReal.ofReal A1 * eLpNorm (f 0) (ENNReal.ofReal q1) volume) *
          (ENNReal.ofReal A2 * eLpNorm (f 1) (ENNReal.ofReal q2) volume)) := by
        gcongr
        · exact hU1 _ J (f 0)
        · exact hU2 _ J (f 1)
    _ = ENNReal.ofReal (C * A1 * A2 * B) *
          (eLpNorm (f 0) (ENNReal.ofReal q1) volume * eLpNorm (f 1) (ENNReal.ofReal q2) volume) := by
        simp only [a]
        rw [ENNReal.ofReal_mul (show 0 ≤ C * A1 * A2 by positivity),
          ENNReal.ofReal_mul (show 0 ≤ C * A1 by positivity), ENNReal.ofReal_mul (p := C) (q := A1) hC0,
          ENNReal.ofReal_mul (p := C) (q := B) hC0]
        ring

/-- **The loss-free bound, `q_0 < ∞`** (alternative route, line 620): for `q_0 > 1`,
`q_1, q_2 ≥ 2`, `1/r = 1/q_0 + 1/q_1 + 1/q_2`:
`‖T^{(k_2,k_3)}_J(g_0, f_1, f_2)‖_r ≤ C ‖g_0‖_{q_0} ‖f_1‖_{q_1} ‖f_2‖_{q_2}`, uniformly in the pair
and in `J`. -/
theorem lossFree_fin (n0 : Fin 3) {q0 q1 q2 r : ℝ} (hq0 : 1 < q0) (hq1 : 2 ≤ q1) (hq2 : 2 ≤ q2)
    (hr : 1 / r = 1 / q0 + 1 / q1 + 1 / q2) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (p : Fin 3 → ℤ) (J : ℕ) (g0 : E3 → ℂ), Measurable g0 → ∀ B : ℝ,
      (∀ y, ‖g0 y‖ ≤ B) → ∀ f : Fin 2 → 𝓢(E3, ℂ),
        eLpNorm (gOp (lowFam n0 p) J (insIn n0 g0 fun i => ⇑(f i))) (ENNReal.ofReal r) volume
          ≤ ENNReal.ofReal C * (eLpNorm g0 (ENNReal.ofReal q0) volume *
            (eLpNorm (f 0) (ENNReal.ofReal q1) volume * eLpNorm (f 1) (ENNReal.ofReal q2) volume)) := by
  obtain ⟨C, hC0, hpt⟩ := enorm_gOp_low_le n0
  obtain ⟨A1, hA1, hU1⟩ := lintegral_slotU_le (n0.succAbove 0) hq1
  obtain ⟨A2, hA2, hU2⟩ := lintegral_slotU_le (n0.succAbove 1) hq2
  have hq00 : 0 < q0 := by linarith
  have hq10 : 0 < q1 := by linarith
  have hq20 : 0 < q2 := by linarith
  have hr0 : 0 < r := by
    have : 0 < 1 / r := by rw [hr]; positivity
    exact one_div_pos.mp this
  set CM := maxConst q0
  have hCM : CM ≠ ⊤ := maxConst_ne_top hq0
  refine ⟨C * CM.toReal * A1 * A2, by positivity, fun p J g0 hg0 B hB f => ?_⟩
  have hB0 : 0 ≤ B := (norm_nonneg _).trans (hB 0)
  set σ := n0.succAbove
  set U1 := slotU (σ 0) (p (σ 0)) J (f 0)
  set U2 := slotU (σ 1) (p (σ 1)) J (f 1)
  set Mg : E3 → ℝ := Twisted.coordinateDyadicBallMaximal n0 g0
  have hMm : Measurable Mg := Twisted.coordinateDyadicBallMaximal_measurable n0 g0 hg0
  set a : E3 → ℝ≥0∞ := fun x => ENNReal.ofReal (C * Mg x)
  have ham : Measurable a := ENNReal.measurable_ofReal.comp (measurable_const.mul hMm)
  have hle : ∀ x, ‖gOp (lowFam n0 p) J (insIn n0 g0 fun i => ⇑(f i)) x‖ₑ ≤ a x * (U1 x * U2 x) :=
    fun x => hpt p J g0 hg0 B hB f x
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hr0) ENNReal.ofReal_ne_top,
    ENNReal.toReal_ofReal hr0.le]
  have hH := lintegral_mul3_rpow_le volume ham.aemeasurable
    (measurable_slotU (σ 0) (p (σ 0)) J (f 0)).aemeasurable
    (measurable_slotU (σ 1) (p (σ 1)) J (f 1)).aemeasurable
    hq00 hq10 hq20 hr
  -- the maximal slot
  have ha : (∫⁻ x, a x ^ q0) ^ (1 / q0) ≤ ENNReal.ofReal C * (CM * eLpNorm g0 (ENNReal.ofReal q0) volume) := by
    have e : (∫⁻ x, a x ^ q0) ^ (1 / q0) = eLpNorm (fun x => C * Mg x) (ENNReal.ofReal q0) volume := by
      rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hq00) ENNReal.ofReal_ne_top,
        ENNReal.toReal_ofReal hq00.le]
      congr 1
      refine lintegral_congr fun x => ?_
      rw [Real.enorm_eq_ofReal (mul_nonneg hC0 (maximal_nonneg n0 g0 x))]
    rw [e, show (fun x => C * Mg x) = C • Mg from rfl, eLpNorm_const_smul, Real.enorm_eq_ofReal hC0]
    gcongr
    exact Twisted.eLpNorm_coordinateDyadicBallMaximal_le n0 g0 hg0 B hB0 hB hq0
  calc (∫⁻ x, ‖gOp (lowFam n0 p) J (insIn n0 g0 fun i => ⇑(f i)) x‖ₑ ^ r) ^ (1 / r)
      ≤ (∫⁻ x, (a x * (U1 x * U2 x)) ^ r) ^ (1 / r) := by gcongr with x; exact hle x
    _ ≤ (∫⁻ x, a x ^ q0) ^ (1 / q0) * ((∫⁻ x, U1 x ^ q1) ^ (1 / q1) * (∫⁻ x, U2 x ^ q2) ^ (1 / q2)) := hH
    _ ≤ (ENNReal.ofReal C * (CM * eLpNorm g0 (ENNReal.ofReal q0) volume)) *
          ((ENNReal.ofReal A1 * eLpNorm (f 0) (ENNReal.ofReal q1) volume) *
            (ENNReal.ofReal A2 * eLpNorm (f 1) (ENNReal.ofReal q2) volume)) := by
        gcongr
        · exact hU1 _ J (f 0)
        · exact hU2 _ J (f 1)
    _ = _ := by
        rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity),
          ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_toReal hCM]
        ring

theorem insIn_apply_self (n0 : Fin 3) (g0 : E3 → ℂ) (G : Fin 2 → E3 → ℂ) : insIn n0 g0 G n0 = g0 := by
  simp only [insIn, Fin.insertNth_apply_same]

theorem insIn_apply_succAbove (n0 : Fin 3) (g0 : E3 → ℂ) (G : Fin 2 → E3 → ℂ) (i : Fin 2) :
    insIn n0 g0 G (n0.succAbove i) = G i := by
  simp only [insIn, Fin.insertNth_apply_succAbove]

theorem insIn_update (n0 : Fin 3) (g0 : E3 → ℂ) (G : Fin 2 → E3 → ℂ) (i : Fin 2) (φ : E3 → ℂ) :
    Function.update (insIn n0 g0 G) (n0.succAbove i) φ = insIn n0 g0 (Function.update G i φ) := by
  funext m
  rcases Fin.eq_self_or_eq_succAbove n0 m with h | ⟨k, rfl⟩
  · subst h
    rw [Function.update_of_ne (Fin.succAbove_ne m i).symm, insIn_apply_self, insIn_apply_self]
  · rw [insIn_apply_succAbove]
    by_cases hk : k = i
    · subst hk; simp only [Function.update_self]
    · rw [Function.update_of_ne hk, Function.update_of_ne (Fin.succAbove_right_injective.ne hk),
        insIn_apply_succAbove]

theorem goodIn_insIn {n0 : Fin 3} {g0 : E3 → ℂ} (hg0 : GoodIn g0) {G : Fin 2 → E3 → ℂ} (i : Fin 2)
    (hG : ∀ k, k ≠ i → GoodIn (G k)) : ∀ m, m ≠ n0.succAbove i → GoodIn (insIn n0 g0 G m) := by
  intro m hm
  rcases Fin.eq_self_or_eq_succAbove n0 m with h | ⟨k, rfl⟩
  · subst h; rw [insIn_apply_self]; exact hg0
  · rw [insIn_apply_succAbove]
    exact hG k fun hk => hm (by rw [hk])

/-- **Density transfer in an `L^2`-type slot `σ_i` of the grouped operator.** -/
theorem gOp_sigma_transfer (χ : Fin 3 → ℤ → CoordMult) (J : ℕ) (n0 : Fin 3) (i : Fin 2)
    {g0 : E3 → ℂ} (hg0 : GoodIn g0) {G : Fin 2 → E3 → ℂ} (hG : ∀ k, k ≠ i → GoodIn (G k))
    {r a c0 c1 : ℝ} (hr1 : 1 ≤ r) (ha : 1 ≤ a) (hc0 : 1 ≤ c0) (hc1 : 1 ≤ c1)
    (hsum : 1 / r = 1 / c0 + 1 / a + 1 / c1) {M : ℝ≥0∞} (hM : M ≠ ⊤) (A : (E3 → ℂ) → Prop)
    (hA : ∀ b, GoodIn b → ∀ ε : ℝ≥0∞, 0 < ε → ∃ φ, A φ ∧ GoodIn φ ∧
      eLpNorm (b - φ) (ENNReal.ofReal a) volume ≤ ε)
    (hbound : ∀ φ, A φ → GoodIn φ →
      eLpNorm (gOp χ J (insIn n0 g0 (Function.update G i φ))) (ENNReal.ofReal r) volume
        ≤ M * eLpNorm φ (ENNReal.ofReal a) volume)
    {φ : E3 → ℂ} (hφ : GoodIn φ) :
    eLpNorm (gOp χ J (insIn n0 g0 (Function.update G i φ))) (ENNReal.ofReal r) volume
      ≤ M * eLpNorm φ (ENNReal.ofReal a) volume := by
  set P : Fin 3 → ℝ := Fin.insertNth (α := fun _ => ℝ) n0 c0 fun k => if k = i then a else c1 with hPdef
  have hPn0 : P n0 = c0 := by simp only [hPdef, Fin.insertNth_apply_same]
  have hPs : ∀ k, P (n0.succAbove k) = if k = i then a else c1 := fun k => by
    simp only [hPdef, Fin.insertNth_apply_succAbove]
  have hP : ∀ m, 1 ≤ P m := by
    intro m
    rcases Fin.eq_self_or_eq_succAbove n0 m with h | ⟨k, rfl⟩
    · subst h; rw [hPn0]; exact hc0
    · rw [hPs]; split_ifs; exacts [ha, hc1]
  have hPsum : 1 / r = 1 / P 0 + 1 / P 1 + 1 / P 2 := by
    have e : 1 / P 0 + 1 / P 1 + 1 / P 2 = ∑ m, 1 / P m := by rw [Fin.sum_univ_three]
    rw [e, Fin.sum_univ_succAbove _ n0, Fin.sum_univ_two, hPn0, hPs, hPs, hsum]
    fin_cases i <;> simp <;> ring
  have hPi : P (n0.succAbove i) = a := by rw [hPs, if_pos rfl]
  have key := gOp_slot_transfer χ J (n0.succAbove i) (g := insIn n0 g0 G)
    (goodIn_insIn hg0 i hG) hr1 hP hPsum hM A (by rw [hPi]; exact hA)
    (fun ψ hAψ hψ => by rw [insIn_update, hPi]; exact hbound ψ hAψ hψ) hφ
  rwa [insIn_update, hPi] at key

/-- **Schwartz to admissible inputs in both `L^2`-type slots.** -/
theorem gOp_sigma_good (χ : Fin 3 → ℤ → CoordMult) (J : ℕ) (n0 : Fin 3) {g0 : E3 → ℂ}
    (hg0 : GoodIn g0) {K : ℝ≥0∞} (hK : K ≠ ⊤) {r a0 a1 c0 c1 d0 d1 : ℝ} (hr1 : 1 ≤ r)
    (ha0 : 1 ≤ a0) (ha1 : 1 ≤ a1) (hc0 : 1 ≤ c0) (hc1 : 1 ≤ c1) (hd0 : 1 ≤ d0) (hd1 : 1 ≤ d1)
    (hsum1 : 1 / r = 1 / c0 + 1 / a0 + 1 / c1) (hsum2 : 1 / r = 1 / d0 + 1 / a1 + 1 / d1)
    (hS : ∀ f : Fin 2 → 𝓢(E3, ℂ),
      eLpNorm (gOp χ J (insIn n0 g0 fun k => ⇑(f k))) (ENNReal.ofReal r) volume
        ≤ K * (eLpNorm (f 0) (ENNReal.ofReal a0) volume * eLpNorm (f 1) (ENNReal.ofReal a1) volume))
    {G : Fin 2 → E3 → ℂ} (hG : ∀ k, GoodIn (G k)) :
    eLpNorm (gOp χ J (insIn n0 g0 G)) (ENNReal.ofReal r) volume
      ≤ K * (eLpNorm (G 0) (ENNReal.ofReal a0) volume * eLpNorm (G 1) (ENNReal.ofReal a1) volume) := by
  -- stage 1: slot `σ_0`, with a Schwartz function in slot `σ_1`
  have stage1 : ∀ (F1 : 𝓢(E3, ℂ)) (φ : E3 → ℂ), GoodIn φ →
      eLpNorm (gOp χ J (insIn n0 g0 ![φ, ⇑F1])) (ENNReal.ofReal r) volume
        ≤ K * (eLpNorm φ (ENNReal.ofReal a0) volume * eLpNorm F1 (ENNReal.ofReal a1) volume) := by
    intro F1 φ hφ
    have hM : K * eLpNorm F1 (ENNReal.ofReal a1) volume ≠ ⊤ :=
      ENNReal.mul_ne_top hK ((goodIn_schwartz F1).eLpNorm_ne_top ha1)
    have e : ∀ ψ : E3 → ℂ, (![ψ, ⇑F1] : Fin 2 → E3 → ℂ) = Function.update ![0, ⇑F1] 0 ψ := by
      intro ψ; funext k; fin_cases k <;> simp
    have h := gOp_sigma_transfer χ J n0 0 hg0 (G := ![0, ⇑F1])
      (fun k hk => by fin_cases k; · exact absurd rfl hk
                      · simpa using goodIn_schwartz F1)
      hr1 ha0 hc0 hc1 hsum1 hM (fun ψ => ∃ F : 𝓢(E3, ℂ), ⇑F = ψ)
      (fun b hb ε hε => goodIn_approx_schwartz hb ha0 ε hε)
      (fun ψ ⟨F, hF⟩ _ => by
        rw [← e, ← hF]
        have hf : (![⇑F, ⇑F1] : Fin 2 → E3 → ℂ) = fun k => ⇑(![F, F1] k) := by
          funext k; fin_cases k <;> simp
        rw [hf]
        refine (hS ![F, F1]).trans (le_of_eq ?_)
        simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
        ring) hφ
    rw [← e] at h
    refine h.trans (le_of_eq ?_)
    ring
  -- stage 2: slot `σ_1`
  have hM : K * eLpNorm (G 0) (ENNReal.ofReal a0) volume ≠ ⊤ :=
    ENNReal.mul_ne_top hK ((hG 0).eLpNorm_ne_top ha0)
  have e : ∀ ψ : E3 → ℂ, (![G 0, ψ] : Fin 2 → E3 → ℂ) = Function.update ![G 0, 0] 1 ψ := by
    intro ψ; funext k; fin_cases k <;> simp
  have hGe : G = ![G 0, G 1] := by funext k; fin_cases k <;> simp
  have h := gOp_sigma_transfer χ J n0 1 hg0 (G := ![G 0, 0])
    (fun k hk => by fin_cases k
                    · simpa using hG 0
                    · exact absurd rfl hk)
    hr1 ha1 hd0 hd1 (by rw [hsum2]) hM (fun ψ => ∃ F : 𝓢(E3, ℂ), ⇑F = ψ)
    (fun b hb ε hε => goodIn_approx_schwartz hb ha1 ε hε)
    (fun ψ ⟨F, hF⟩ _ => by
      rw [← e, ← hF]
      refine (stage1 F (G 0) (hG 0)).trans (le_of_eq ?_)
      ring) (hG 1)
  rw [← e, ← hGe] at h
  refine h.trans (le_of_eq ?_)
  ring

/-- **`lem:gain_2-` on admissible inputs.** -/
theorem gain2_good (hS : SmoothingTwo) (n0 : Fin 3) :
    ∃ C δ : ℝ, 0 < C ∧ 0 < δ ∧ ∀ p : Fin 3 → ℤ, PairReg n0 p → 100 < kMax p →
      ∀ (J : ℕ) (g0 : E3 → ℂ), GoodIn g0 → ∀ B : ℝ, (∀ y, ‖g0 y‖ ≤ B) →
      ∀ G : Fin 2 → E3 → ℂ, (∀ k, GoodIn (G k)) →
        eLpNorm (gOp (lowFam n0 p) J (insIn n0 g0 G)) (ENNReal.ofReal 1) volume
          ≤ ENNReal.ofReal (C * B * (2 : ℝ) ^ (-(δ * kMax p))) *
            (eLpNorm (G 0) (ENNReal.ofReal 2) volume * eLpNorm (G 1) (ENNReal.ofReal 2) volume) := by
  obtain ⟨C, δ, hC, hδ, h⟩ := gain2_grouped hS n0
  refine ⟨C, δ, hC, hδ, fun p hp hK J g0 hg0 B hB G hG => ?_⟩
  refine gOp_sigma_good _ J n0 hg0 ENNReal.ofReal_ne_top le_rfl (by norm_num) (by norm_num)
    (c0 := 4) (c1 := 4) (d0 := 4) (d1 := 4) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (fun f => ?_) hG
  have e2 : ENNReal.ofReal 2 = 2 := by simp
  rw [e2, ENNReal.ofReal_one]
  exact h p hp hK J g0 hg0.1 B hB f

/-- **The loss-free bound with `q_0 = ∞` on admissible inputs.** -/
theorem lossFree_inf_good (n0 : Fin 3) {q1 q2 r : ℝ} (hq1 : 2 ≤ q1) (hq2 : 2 ≤ q2)
    (hr : 1 / r = 1 / q1 + 1 / q2) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (p : Fin 3 → ℤ) (J : ℕ) (g0 : E3 → ℂ), GoodIn g0 → ∀ B : ℝ,
      (∀ y, ‖g0 y‖ ≤ B) → ∀ G : Fin 2 → E3 → ℂ, (∀ k, GoodIn (G k)) →
        eLpNorm (gOp (lowFam n0 p) J (insIn n0 g0 G)) (ENNReal.ofReal r) volume
          ≤ ENNReal.ofReal (C * B) *
            (eLpNorm (G 0) (ENNReal.ofReal q1) volume * eLpNorm (G 1) (ENNReal.ofReal q2) volume) := by
  obtain ⟨C, hC, h⟩ := lossFree_inf n0 hq1 hq2 hr
  have hr0 : 0 < r := by
    have : 0 < 1 / r := by rw [hr]; positivity
    exact one_div_pos.mp this
  have hr1 : 1 ≤ r := by
    have : 1 / r ≤ 1 := by
      rw [hr]
      have h1 : 1 / q1 ≤ 1 / 2 := by gcongr
      have h2 : 1 / q2 ≤ 1 / 2 := by gcongr
      linarith
    rwa [div_le_one hr0] at this
  refine ⟨C, hC, fun p J g0 hg0 B hB G hG => ?_⟩
  exact gOp_sigma_good _ J n0 hg0 ENNReal.ofReal_ne_top hr1 (by linarith) (by linarith)
    (c0 := 2 * q2) (c1 := 2 * q2) (d0 := 2 * q1) (d1 := 2 * q1) (by linarith) (by linarith)
    (by linarith) (by linarith) (by rw [hr]; field_simp; ring) (by rw [hr]; field_simp; ring)
    (fun f => h p J g0 hg0.1 B hB f) hG

/-- **The loss-free bound with `q_0 < ∞` on admissible inputs.** -/
theorem lossFree_fin_good (n0 : Fin 3) {q0 q1 q2 r : ℝ} (hq0 : 1 < q0) (hq1 : 2 ≤ q1) (hq2 : 2 ≤ q2)
    (hr1 : 1 ≤ r) (hr : 1 / r = 1 / q0 + 1 / q1 + 1 / q2) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (p : Fin 3 → ℤ) (J : ℕ) (g0 : E3 → ℂ), GoodIn g0 →
      ∀ G : Fin 2 → E3 → ℂ, (∀ k, GoodIn (G k)) →
        eLpNorm (gOp (lowFam n0 p) J (insIn n0 g0 G)) (ENNReal.ofReal r) volume
          ≤ ENNReal.ofReal C * eLpNorm g0 (ENNReal.ofReal q0) volume *
            (eLpNorm (G 0) (ENNReal.ofReal q1) volume * eLpNorm (G 1) (ENNReal.ofReal q2) volume) := by
  obtain ⟨C, hC, h⟩ := lossFree_fin n0 hq0 hq1 hq2 hr
  refine ⟨C, hC, fun p J g0 hg0 G hG => ?_⟩
  obtain ⟨B, hB⟩ := hg0.2.1
  exact gOp_sigma_good _ J n0 hg0 (ENNReal.mul_ne_top ENNReal.ofReal_ne_top
      (hg0.eLpNorm_ne_top hq0.le)) hr1 (by linarith) (by linarith)
    (c0 := q0) (c1 := q2) (d0 := q0) (d1 := q1) hq0.le (by linarith) hq0.le (by linarith)
    (by rw [hr]) (by rw [hr]; ring)
    (fun f => (h p J g0 hg0.1 B hB f).trans (le_of_eq (by ring))) hG

/-! ### Interpolation for the grouped operators (alternative route, line 620) -/

theorem le_ofReal_mul_of_tendsto {X S : ℝ≥0∞} (hS : S ≠ ⊤) {a : ℕ → ℝ} {a' : ℝ}
    (ha : Tendsto a atTop (𝓝 a')) (h : ∀ n, X ≤ ENNReal.ofReal (a n) * S) :
    X ≤ ENNReal.ofReal a' * S :=
  ge_of_tendsto' (ENNReal.Tendsto.mul_const (ENNReal.tendsto_ofReal ha) (Or.inr hS)) h

theorem interp_mul_rpow {A₀ A₁ Z θ : ℝ} (hA₀ : 0 ≤ A₀) (hA₁ : 0 ≤ A₁) (hZ : 0 < Z) :
    (A₀ * Z) ^ (1 - θ) * (A₁ * Z) ^ θ = A₀ ^ (1 - θ) * A₁ ^ θ * Z := by
  rw [Real.mul_rpow hA₀ hZ.le, Real.mul_rpow hA₁ hZ.le]
  have : Z ^ (1 - θ) * Z ^ θ = Z := by
    rw [← Real.rpow_add hZ, show 1 - θ + θ = 1 by ring, Real.rpow_one]
  calc A₀ ^ (1 - θ) * Z ^ (1 - θ) * (A₁ ^ θ * Z ^ θ)
      = A₀ ^ (1 - θ) * A₁ ^ θ * (Z ^ (1 - θ) * Z ^ θ) := by ring
    _ = _ := by rw [this]

theorem one_le_of_interp {r r₀ r₁ θ : ℝ} (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1) (hr₀ : 1 ≤ r₀) (hr₁ : 1 ≤ r₁)
    (h : 1 / r = (1 - θ) * (1 / r₀) + θ * (1 / r₁)) : 0 < r ∧ 1 ≤ r := by
  have h0 : 0 < 1 / r₀ := by positivity
  have h1 : 0 < 1 / r₁ := by positivity
  have h0' : 1 / r₀ ≤ 1 := by rw [div_le_one (by linarith)]; exact hr₀
  have h1' : 1 / r₁ ≤ 1 := by rw [div_le_one (by linarith)]; exact hr₁
  have hpos : 0 < 1 / r := by
    rw [h]
    rcases hθ0.eq_or_lt with h' | h'
    · subst h'; simpa using h0
    · have : 0 < θ * (1 / r₁) := mul_pos h' h1
      nlinarith
  have hle : 1 / r ≤ 1 := by rw [h]; nlinarith
  have hr : 0 < r := one_div_pos.mp hpos
  exact ⟨hr, by rwa [div_le_one hr] at hle⟩

/-- **Riesz-Thorin in one slot of the grouped operator** (`Auto.SteinInterpolation.riesz_thorin`). -/
theorem gOp_slot_rt (χ : Fin 3 → ℤ → CoordMult) (J : ℕ) (n : Fin 3) {g : Fin 3 → E3 → ℂ}
    (hg : ∀ m, m ≠ n → GoodIn (g m)) {p₀ p₁ p q₀ q₁ q : ℝ≥0∞} {θ M₀ M₁ : ℝ}
    (hp₀ : 1 ≤ p₀) (hp₁ : 1 ≤ p₁) (hq₀ : 1 ≤ q₀) (hq₁ : 1 ≤ q₁) (hθ : θ ∈ Set.Ioo 0 1)
    (hp : p⁻¹ = ENNReal.ofReal (1 - θ) * p₀⁻¹ + ENNReal.ofReal θ * p₁⁻¹)
    (hq : q⁻¹ = ENNReal.ofReal (1 - θ) * q₀⁻¹ + ENNReal.ofReal θ * q₁⁻¹)
    (hM₀ : 0 < M₀) (hM₁ : 0 < M₁)
    (hb₀ : ∀ s : SimpleFunc E3 ℂ, Integrable s →
      eLpNorm (gOp χ J (Function.update g n s)) q₀ volume ≤ ENNReal.ofReal M₀ * eLpNorm s p₀ volume)
    (hb₁ : ∀ s : SimpleFunc E3 ℂ, Integrable s →
      eLpNorm (gOp χ J (Function.update g n s)) q₁ volume ≤ ENNReal.ofReal M₁ * eLpNorm s p₁ volume)
    (s : SimpleFunc E3 ℂ) (hs : Integrable s) :
    eLpNorm (gOp χ J (Function.update g n s)) q volume
      ≤ ENNReal.ofReal (M₀ ^ (1 - θ) * M₁ ^ θ) * eLpNorm s p volume :=
  (Auto.SteinInterpolation.riesz_thorin (μ := volume) (ν := volume)
    (fun s => gOp χ J (Function.update g n s)) hp₀ hp₁ hq₀ hq₁ hθ hp hq
    (fun s t _ _ => by
      rw [SimpleFunc.coe_add]
      exact gOp_update_add χ J g n (fun m hm => (hg m hm).1) (fun m hm => (hg m hm).2.1)
        s.measurable t.measurable (isBdd_simpleFunc s) (isBdd_simpleFunc t))
    (fun c s _ => by rw [SimpleFunc.coe_smul]; exact gOp_update_smul χ J g n c s)
    (fun s _ => measurable_gOp χ J (measurable_update (fun m hm => (hg m hm).1) s.measurable))
    hM₀ hM₁ hb₀ hb₁ s hs).2

theorem tendsto_eta : Tendsto (fun n : ℕ => 1 / ((n : ℝ) + 1)) atTop (𝓝 0) :=
  tendsto_one_div_add_atTop_nhds_zero_nat

theorem eta_pos (n : ℕ) : 0 < 1 / ((n : ℝ) + 1) := by positivity

theorem fin2_rev_ne (i : Fin 2) : i.rev ≠ i := by fin_cases i <;> decide

/-- **One interpolation step in an `L^2`-type slot `σ_i`** (the slot `n_0` at `L^∞`, the other
`L^2`-type slot fixed). -/
theorem rt_sigma_step (χ : Fin 3 → ℤ → CoordMult) (J : ℕ) (n0 : Fin 3) (i : Fin 2)
    {r₀ r₁ r a₀ a₁ a b θ A₀ A₁ : ℝ} (hθ0 : 0 < θ) (hθ1 : θ < 1) (hA₀ : 0 < A₀) (hA₁ : 0 < A₁)
    (ha₀ : 1 ≤ a₀) (ha₁ : 1 ≤ a₁) (hr₀ : 1 ≤ r₀) (hr₁ : 1 ≤ r₁) (hb : 1 ≤ b)
    (hinta : 1 / a = (1 - θ) * (1 / a₀) + θ * (1 / a₁))
    (hintr : 1 / r = (1 - θ) * (1 / r₀) + θ * (1 / r₁)) (hrab : 1 / r = 1 / a + 1 / b)
    (E0 : ∀ g0, GoodIn g0 → ∀ B : ℝ, (∀ y, ‖g0 y‖ ≤ B) → ∀ G : Fin 2 → E3 → ℂ, (∀ k, GoodIn (G k)) →
      eLpNorm (gOp χ J (insIn n0 g0 G)) (ENNReal.ofReal r₀) volume
        ≤ ENNReal.ofReal (A₀ * B) * (eLpNorm (G i) (ENNReal.ofReal a₀) volume *
            eLpNorm (G i.rev) (ENNReal.ofReal b) volume))
    (E1 : ∀ g0, GoodIn g0 → ∀ B : ℝ, (∀ y, ‖g0 y‖ ≤ B) → ∀ G : Fin 2 → E3 → ℂ, (∀ k, GoodIn (G k)) →
      eLpNorm (gOp χ J (insIn n0 g0 G)) (ENNReal.ofReal r₁) volume
        ≤ ENNReal.ofReal (A₁ * B) * (eLpNorm (G i) (ENNReal.ofReal a₁) volume *
            eLpNorm (G i.rev) (ENNReal.ofReal b) volume)) :
    ∀ g0, GoodIn g0 → ∀ B : ℝ, (∀ y, ‖g0 y‖ ≤ B) → ∀ G : Fin 2 → E3 → ℂ, (∀ k, GoodIn (G k)) →
      eLpNorm (gOp χ J (insIn n0 g0 G)) (ENNReal.ofReal r) volume
        ≤ ENNReal.ofReal (A₀ ^ (1 - θ) * A₁ ^ θ * B) * (eLpNorm (G i) (ENNReal.ofReal a) volume *
            eLpNorm (G i.rev) (ENNReal.ofReal b) volume) := by
  intro g0 hg0 B hB G hG
  have hB0 : 0 ≤ B := (norm_nonneg _).trans (hB 0)
  obtain ⟨ha0, ha1⟩ := one_le_of_interp hθ0.le hθ1.le ha₀ ha₁ hinta
  obtain ⟨hr0, hr1⟩ := one_le_of_interp hθ0.le hθ1.le hr₀ hr₁ hintr
  have hb0 : 0 < b := by linarith
  set N := (eLpNorm (G i.rev) (ENNReal.ofReal b) volume).toReal with hNdef
  have hN0 : 0 ≤ N := ENNReal.toReal_nonneg
  have hNe : eLpNorm (G i.rev) (ENNReal.ofReal b) volume = ENNReal.ofReal N :=
    (ENNReal.ofReal_toReal ((hG _).eLpNorm_ne_top hb)).symm
  set Aθ := A₀ ^ (1 - θ) * A₁ ^ θ with hAθ
  have hAθ0 : 0 ≤ Aθ := by positivity
  have hGu : ∀ (φ : E3 → ℂ), GoodIn φ → ∀ k, GoodIn (Function.update G i φ k) := by
    intro φ hφ k
    by_cases hk : k = i
    · subst hk; rw [Function.update_self]; exact hφ
    · rw [Function.update_of_ne hk]; exact hG k
  have hGrev : ∀ φ : E3 → ℂ, Function.update G i φ i.rev = G i.rev := fun φ =>
    Function.update_of_ne (fin2_rev_ne i) _ _
  -- the simple-function bound, for every `η > 0`
  have hsimple : ∀ n : ℕ, ∀ s : SimpleFunc E3 ℂ, Integrable s →
      eLpNorm (gOp χ J (insIn n0 g0 (Function.update G i s))) (ENNReal.ofReal r) volume
        ≤ ENNReal.ofReal (Aθ * ((B + 1 / ((n : ℝ) + 1)) * (N + 1 / ((n : ℝ) + 1)))) *
          eLpNorm s (ENNReal.ofReal a) volume := by
    intro n
    set η := 1 / ((n : ℝ) + 1)
    have hη : 0 < η := eta_pos n
    set Z := (B + η) * (N + η) with hZ
    have hZ0 : 0 < Z := by positivity
    have hvert : ∀ (A a' r' : ℝ), 0 < A →
        (∀ G : Fin 2 → E3 → ℂ, (∀ k, GoodIn (G k)) →
          eLpNorm (gOp χ J (insIn n0 g0 G)) (ENNReal.ofReal r') volume
            ≤ ENNReal.ofReal (A * (B + η)) * (eLpNorm (G i) (ENNReal.ofReal a') volume *
                eLpNorm (G i.rev) (ENNReal.ofReal b) volume)) →
        ∀ s : SimpleFunc E3 ℂ, Integrable s →
          eLpNorm (gOp χ J (Function.update (insIn n0 g0 G) (n0.succAbove i) s)) (ENNReal.ofReal r') volume
            ≤ ENNReal.ofReal (A * Z) * eLpNorm s (ENNReal.ofReal a') volume := by
      intro A a' r' hA hE s hs
      rw [insIn_update]
      refine (hE _ (hGu s (goodIn_simple s hs))).trans ?_
      rw [Function.update_self, hGrev, hNe]
      calc ENNReal.ofReal (A * (B + η)) * (eLpNorm s (ENNReal.ofReal a') volume * ENNReal.ofReal N)
          ≤ ENNReal.ofReal (A * (B + η)) * (eLpNorm s (ENNReal.ofReal a') volume *
              ENNReal.ofReal (N + η)) := by gcongr; linarith
        _ = _ := by
            rw [show A * ((B + η) * (N + η)) = A * (B + η) * (N + η) by ring,
              ENNReal.ofReal_mul (show 0 ≤ A * (B + η) by positivity)]
            ring
    have hRT := gOp_slot_rt χ J (n0.succAbove i) (g := insIn n0 g0 G) (goodIn_insIn hg0 i fun k _ => hG k)
      (p₀ := ENNReal.ofReal a₀) (p₁ := ENNReal.ofReal a₁) (p := ENNReal.ofReal a)
      (q₀ := ENNReal.ofReal r₀) (q₁ := ENNReal.ofReal r₁) (q := ENNReal.ofReal r) (θ := θ)
      (M₀ := A₀ * Z) (M₁ := A₁ * Z) (by simpa using ha₀) (by simpa using ha₁) (by simpa using hr₀)
      (by simpa using hr₁) ⟨hθ0, hθ1⟩
      (ennreal_interp_exp (by linarith) (by linarith) ha0 hθ0.le hθ1.le hinta)
      (ennreal_interp_exp (by linarith) (by linarith) hr0 hθ0.le hθ1.le hintr)
      (by positivity) (by positivity)
      (hvert A₀ a₀ r₀ hA₀ fun G hG => E0 g0 hg0 (B + η) (fun y => (hB y).trans (by linarith)) G hG)
      (hvert A₁ a₁ r₁ hA₁ fun G hG => E1 g0 hg0 (B + η) (fun y => (hB y).trans (by linarith)) G hG)
    intro s hs
    rw [← insIn_update]
    refine (hRT s hs).trans (le_of_eq ?_)
    rw [interp_mul_rpow hA₀.le hA₁.le hZ0]
  -- `η → 0`
  have hlim : ∀ s : SimpleFunc E3 ℂ, Integrable s →
      eLpNorm (gOp χ J (insIn n0 g0 (Function.update G i s))) (ENNReal.ofReal r) volume
        ≤ ENNReal.ofReal (Aθ * B) * ENNReal.ofReal N * eLpNorm s (ENNReal.ofReal a) volume := by
    intro s hs
    have ht : Tendsto (fun n : ℕ => Aθ * ((B + 1 / ((n : ℝ) + 1)) * (N + 1 / ((n : ℝ) + 1))))
        atTop (𝓝 (Aθ * ((B + 0) * (N + 0)))) :=
      ((tendsto_const_nhds.add tendsto_eta).mul (tendsto_const_nhds.add tendsto_eta)).const_mul _
    have h := le_ofReal_mul_of_tendsto ((goodIn_simple s hs).eLpNorm_ne_top ha1) ht fun n => hsimple n s hs
    refine h.trans (le_of_eq ?_)
    rw [add_zero, add_zero, ← mul_assoc, ENNReal.ofReal_mul (by positivity)]
  -- simple to admissible in slot `σ_i`
  have hM : ENNReal.ofReal (Aθ * B) * ENNReal.ofReal N ≠ ⊤ :=
    ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top
  have key := gOp_sigma_transfer χ J n0 i hg0 (G := G) (fun k _ => hG k) hr1 ha1
    (c0 := 2 * b) (c1 := 2 * b) (by linarith) (by linarith) (by rw [hrab]; field_simp; ring) hM
    (fun ψ => ∃ s : SimpleFunc E3 ℂ, Integrable s ∧ ⇑s = ψ)
    (fun c hc ε hε => goodIn_approx_simple hc ha1 ε hε)
    (fun ψ ⟨s, hs, hsψ⟩ _ => by rw [← hsψ]; exact hlim s hs) (hG i)
  rw [Function.update_eq_self] at key
  refine key.trans (le_of_eq ?_)
  rw [hNe]; ring

theorem insIn_update_self (n0 : Fin 3) (g0 φ : E3 → ℂ) (G : Fin 2 → E3 → ℂ) :
    Function.update (insIn n0 g0 G) n0 φ = insIn n0 φ G := by
  funext m
  rcases Fin.eq_self_or_eq_succAbove n0 m with h | ⟨k, rfl⟩
  · subst h; rw [Function.update_self, insIn_apply_self]
  · rw [Function.update_of_ne (Fin.succAbove_ne n0 k), insIn_apply_succAbove, insIn_apply_succAbove]

/-- A grouped operator with an input vanishing a.e. vanishes in `L^r`. -/
theorem eLpNorm_gOp_eq_zero (χ : Fin 3 → ℤ → CoordMult) (J : ℕ) {g : Fin 3 → E3 → ℂ}
    (hg : ∀ m, Measurable (g m)) {r : ℝ} (hr : 1 ≤ r) (m : Fin 3) (hm : g m =ᵐ[volume] 0) :
    eLpNorm (gOp χ J g) (ENNReal.ofReal r) volume = 0 := by
  have h := eLpNorm_gOp_le χ J hg (r := r) (P := fun _ => 3 * r) hr (fun _ => by linarith)
    (by field_simp; ring)
  have hz : eLpNorm (g m) (ENNReal.ofReal (3 * r)) volume = 0 := by
    rw [eLpNorm_congr_ae hm, eLpNorm_zero]
  refine le_antisymm (h.trans (le_of_eq ?_)) bot_le
  fin_cases m <;> simp_all

theorem ennreal_interp_exp_top {b c θ : ℝ} (hb : 0 < b) (hc : 0 < c) (hθ0 : 0 ≤ θ)
    (h : 1 / c = θ * (1 / b)) :
    (ENNReal.ofReal c)⁻¹ = ENNReal.ofReal (1 - θ) * (⊤ : ℝ≥0∞)⁻¹ +
      ENNReal.ofReal θ * (ENNReal.ofReal b)⁻¹ := by
  rw [ENNReal.inv_top, mul_zero, zero_add, ← ENNReal.ofReal_inv_of_pos hb,
    ← ENNReal.ofReal_inv_of_pos hc, ← ENNReal.ofReal_mul hθ0]
  congr 1
  simpa [one_div] using h

/-- **The interpolation step in the low slot `n_0`**, from `L^∞` (with `‖g_0‖_∞` realized
through the essential supremum) to `L^{c_1}`, the `L^2`-type slots fixed. -/
theorem rt_low_step (χ : Fin 3 → ℤ → CoordMult) (J : ℕ) (n0 : Fin 3)
    {r₀ r₁ r c₁ c b0 b1 θ A₀ A₁ : ℝ} (hθ0 : 0 < θ) (hθ1 : θ < 1) (hA₀ : 0 < A₀) (hA₁ : 0 < A₁)
    (hc₁ : 1 ≤ c₁) (hr₀ : 1 ≤ r₀) (hr₁ : 1 ≤ r₁) (hb0 : 1 ≤ b0) (hb1 : 1 ≤ b1)
    (hintc : 1 / c = θ * (1 / c₁)) (hintr : 1 / r = (1 - θ) * (1 / r₀) + θ * (1 / r₁))
    (hrsum : 1 / r = 1 / c + 1 / b0 + 1 / b1)
    (E0 : ∀ g0, GoodIn g0 → ∀ B : ℝ, (∀ y, ‖g0 y‖ ≤ B) → ∀ G : Fin 2 → E3 → ℂ, (∀ k, GoodIn (G k)) →
      eLpNorm (gOp χ J (insIn n0 g0 G)) (ENNReal.ofReal r₀) volume
        ≤ ENNReal.ofReal (A₀ * B) * (eLpNorm (G 0) (ENNReal.ofReal b0) volume *
            eLpNorm (G 1) (ENNReal.ofReal b1) volume))
    (E1 : ∀ g0, GoodIn g0 → ∀ G : Fin 2 → E3 → ℂ, (∀ k, GoodIn (G k)) →
      eLpNorm (gOp χ J (insIn n0 g0 G)) (ENNReal.ofReal r₁) volume
        ≤ ENNReal.ofReal A₁ * eLpNorm g0 (ENNReal.ofReal c₁) volume *
            (eLpNorm (G 0) (ENNReal.ofReal b0) volume * eLpNorm (G 1) (ENNReal.ofReal b1) volume)) :
    ∀ g0, GoodIn g0 → ∀ G : Fin 2 → E3 → ℂ, (∀ k, GoodIn (G k)) →
      eLpNorm (gOp χ J (insIn n0 g0 G)) (ENNReal.ofReal r) volume
        ≤ ENNReal.ofReal (A₀ ^ (1 - θ) * A₁ ^ θ) * eLpNorm g0 (ENNReal.ofReal c) volume *
            (eLpNorm (G 0) (ENNReal.ofReal b0) volume * eLpNorm (G 1) (ENNReal.ofReal b1) volume) := by
  intro g0 hg0 G hG
  obtain ⟨hr0, hr1⟩ := one_le_of_interp hθ0.le hθ1.le hr₀ hr₁ hintr
  have hc0 : 0 < c := by
    have h1 : 0 < 1 / c₁ := by have : (0 : ℝ) < c₁ := by linarith
                               positivity
    have : 0 < 1 / c := by rw [hintc]; positivity
    exact one_div_pos.mp this
  have hc1 : 1 ≤ c := by
    have h1 : 1 / c ≤ 1 := by
      rw [hintc]
      have : 1 / c₁ ≤ 1 := by rw [div_le_one (by linarith)]; exact hc₁
      have : 0 ≤ 1 / c₁ := by positivity
      nlinarith
    rwa [div_le_one hc0] at h1
  set NG := eLpNorm (G 0) (ENNReal.ofReal b0) volume * eLpNorm (G 1) (ENNReal.ofReal b1) volume
  have hNGt : NG ≠ ⊤ := ENNReal.mul_ne_top ((hG 0).eLpNorm_ne_top hb0) ((hG 1).eLpNorm_ne_top hb1)
  set N := NG.toReal
  have hN0 : 0 ≤ N := ENNReal.toReal_nonneg
  have hNe : NG = ENNReal.ofReal N := (ENNReal.ofReal_toReal hNGt).symm
  set Aθ := A₀ ^ (1 - θ) * A₁ ^ θ
  have hAθ0 : 0 ≤ Aθ := by positivity
  have hGσ : ∀ m, m ≠ n0 → GoodIn (insIn n0 0 G m) := by
    intro m hm
    rcases Fin.eq_self_or_eq_succAbove n0 m with h | ⟨k, rfl⟩
    · exact absurd h hm
    · rw [insIn_apply_succAbove]; exact hG k
  have hmeasG : ∀ φ : E3 → ℂ, Measurable φ → ∀ m, Measurable (insIn n0 φ G m) := by
    intro φ hφ m
    rcases Fin.eq_self_or_eq_succAbove n0 m with h | ⟨k, rfl⟩
    · subst h; rw [insIn_apply_self]; exact hφ
    · rw [insIn_apply_succAbove]; exact (hG k).1
  -- the `L^∞` vertex on simple functions, through the essential supremum
  have hvert0 : ∀ s : SimpleFunc E3 ℂ, Integrable s →
      eLpNorm (gOp χ J (insIn n0 s G)) (ENNReal.ofReal r₀) volume
        ≤ ENNReal.ofReal A₀ * eLpNorm s ⊤ volume * NG := by
    intro s hs
    have hsg := goodIn_simple s hs
    have htop : eLpNorm s ⊤ volume ≠ ⊤ := by
      obtain ⟨B, hB⟩ := isBdd_simpleFunc s
      exact (memLp_top_of_bound s.aestronglyMeasurable B (Eventually.of_forall hB)).eLpNorm_ne_top
    set E := (eLpNorm s ⊤ volume).toReal
    have hE0 : 0 ≤ E := ENNReal.toReal_nonneg
    set S : Set E3 := {y | ‖s y‖ ≤ E}
    have hSm : MeasurableSet S := measurableSet_le s.measurable.norm measurable_const
    set s' : E3 → ℂ := S.indicator s
    have hs'B : ∀ y, ‖s' y‖ ≤ E := by
      intro y
      by_cases hy : y ∈ S
      · simp only [s', Set.indicator_of_mem hy]; exact hy
      · simp only [s', Set.indicator_of_notMem hy, norm_zero]; exact hE0
    have hs'g : GoodIn s' := ⟨s.measurable.indicator hSm, ⟨E, hs'B⟩, fun P hP => (hsg.2.2 P hP).indicator hSm⟩
    have hae : s' =ᵐ[volume] s := by
      have h := ae_le_eLpNormEssSup (μ := volume) (f := (s : E3 → ℂ))
      filter_upwards [h] with y hy
      have hy' : ‖s y‖ ≤ E := by
        rw [← eLpNorm_exponent_top] at hy
        have := ENNReal.toReal_mono htop hy
        rwa [toReal_enorm] at this
      simp only [s', Set.indicator_of_mem (show y ∈ S from hy')]
    -- `T s = T s' + T (s - s')` with `T (s - s') = 0` in `L^{r₀}`
    have hadd := gOp_update_add χ J (insIn n0 0 G) n0 (fun m hm => (hGσ m hm).1)
      (fun m hm => (hGσ m hm).2.1) hs'g.1 (s.measurable.sub hs'g.1) hs'g.2.1
      (hsg.2.1.sub hs'g.2.1)
    rw [insIn_update_self, insIn_update_self, insIn_update_self, add_sub_cancel] at hadd
    have hz : eLpNorm (gOp χ J (insIn n0 (⇑s - s') G)) (ENNReal.ofReal r₀) volume = 0 :=
      eLpNorm_gOp_eq_zero χ J (hmeasG _ (s.measurable.sub hs'g.1)) hr₀ n0 (by
        rw [insIn_apply_self]
        filter_upwards [hae] with y hy
        simp [hy])
    have heq : eLpNorm (gOp χ J (insIn n0 s G)) (ENNReal.ofReal r₀) volume
        = eLpNorm (gOp χ J (insIn n0 s' G)) (ENNReal.ofReal r₀) volume := by
      rw [hadd]
      refine le_antisymm ?_ ?_
      · refine (eLpNorm_add_le (measurable_gOp χ J (hmeasG _ hs'g.1)).aestronglyMeasurable
          (measurable_gOp χ J (hmeasG _ (s.measurable.sub hs'g.1))).aestronglyMeasurable
          (by simpa using hr₀)).trans ?_
        rw [hz, add_zero]
      · have h2 := eLpNorm_sub_le (μ := volume) (p := ENNReal.ofReal r₀)
          ((measurable_gOp χ J (hmeasG _ hs'g.1)).add
            (measurable_gOp χ J (hmeasG _ (s.measurable.sub hs'g.1)))).aestronglyMeasurable
          (measurable_gOp χ J (hmeasG _ (s.measurable.sub hs'g.1))).aestronglyMeasurable
          (by simpa using hr₀)
        rw [add_sub_cancel_right, hz, add_zero] at h2
        exact h2
    rw [heq]
    refine (E0 s' hs'g E hs'B G hG).trans (le_of_eq ?_)
    rw [ENNReal.ofReal_mul hA₀.le, ENNReal.ofReal_toReal htop]
  have hsimple : ∀ n : ℕ, ∀ s : SimpleFunc E3 ℂ, Integrable s →
      eLpNorm (gOp χ J (insIn n0 s G)) (ENNReal.ofReal r) volume
        ≤ ENNReal.ofReal (Aθ * (N + 1 / ((n : ℝ) + 1))) * eLpNorm s (ENNReal.ofReal c) volume := by
    intro n
    set η := 1 / ((n : ℝ) + 1)
    have hη : 0 < η := eta_pos n
    have hZ0 : 0 < N + η := by positivity
    have hle : NG ≤ ENNReal.ofReal (N + η) := by rw [hNe]; exact ENNReal.ofReal_le_ofReal (by linarith)
    have hRT := gOp_slot_rt χ J n0 (g := insIn n0 0 G) hGσ
      (p₀ := ⊤) (p₁ := ENNReal.ofReal c₁) (p := ENNReal.ofReal c)
      (q₀ := ENNReal.ofReal r₀) (q₁ := ENNReal.ofReal r₁) (q := ENNReal.ofReal r) (θ := θ)
      (M₀ := A₀ * (N + η)) (M₁ := A₁ * (N + η)) le_top (by simpa using hc₁) (by simpa using hr₀)
      (by simpa using hr₁) ⟨hθ0, hθ1⟩
      (ennreal_interp_exp_top (by linarith) hc0 hθ0.le hintc)
      (ennreal_interp_exp (by linarith) (by linarith) hr0 hθ0.le hθ1.le hintr)
      (by positivity) (by positivity)
      (fun s hs => by
        rw [insIn_update_self]
        refine (hvert0 s hs).trans ?_
        rw [ENNReal.ofReal_mul hA₀.le, mul_assoc, mul_assoc, mul_comm (ENNReal.ofReal (N + η))]
        exact mul_le_mul' le_rfl (mul_le_mul' le_rfl hle))
      (fun s hs => by
        rw [insIn_update_self]
        refine (E1 s (goodIn_simple s hs) G hG).trans ?_
        rw [ENNReal.ofReal_mul hA₁.le]
        change ENNReal.ofReal A₁ * eLpNorm s (ENNReal.ofReal c₁) volume * NG ≤ _
        rw [mul_assoc, mul_assoc, mul_comm (ENNReal.ofReal (N + η))]
        exact mul_le_mul' le_rfl (mul_le_mul' le_rfl hle))
    intro s hs
    have h := hRT s hs
    rw [insIn_update_self] at h
    refine h.trans (le_of_eq ?_)
    rw [interp_mul_rpow hA₀.le hA₁.le hZ0]
  have hlim : ∀ s : SimpleFunc E3 ℂ, Integrable s →
      eLpNorm (gOp χ J (insIn n0 s G)) (ENNReal.ofReal r) volume
        ≤ ENNReal.ofReal (Aθ * N) * eLpNorm s (ENNReal.ofReal c) volume := by
    intro s hs
    have ht : Tendsto (fun n : ℕ => Aθ * (N + 1 / ((n : ℝ) + 1))) atTop (𝓝 (Aθ * (N + 0))) :=
      (tendsto_const_nhds.add tendsto_eta).const_mul _
    have h := le_ofReal_mul_of_tendsto ((goodIn_simple s hs).eLpNorm_ne_top hc1) ht
      fun n => hsimple n s hs
    rwa [add_zero] at h
  -- simple to admissible in slot `n_0`
  set P : Fin 3 → ℝ := Fin.insertNth (α := fun _ => ℝ) n0 c ![b0, b1] with hPdef
  have hPn0 : P n0 = c := by simp only [hPdef, Fin.insertNth_apply_same]
  have hPs : ∀ k, P (n0.succAbove k) = ![b0, b1] k := fun k => by
    simp only [hPdef, Fin.insertNth_apply_succAbove]
  have hP : ∀ m, 1 ≤ P m := by
    intro m
    rcases Fin.eq_self_or_eq_succAbove n0 m with h | ⟨k, rfl⟩
    · subst h; rw [hPn0]; exact hc1
    · rw [hPs]; fin_cases k; exacts [hb0, hb1]
  have hPsum : 1 / r = 1 / P 0 + 1 / P 1 + 1 / P 2 := by
    have e : 1 / P 0 + 1 / P 1 + 1 / P 2 = ∑ m, 1 / P m := by rw [Fin.sum_univ_three]
    rw [e, Fin.sum_univ_succAbove _ n0, Fin.sum_univ_two, hPn0, hPs, hPs, hrsum]
    simp; ring
  have key := gOp_slot_transfer χ J n0 (g := insIn n0 0 G) hGσ hr1 hP hPsum
    (M := ENNReal.ofReal (Aθ * N)) ENNReal.ofReal_ne_top
    (fun ψ => ∃ s : SimpleFunc E3 ℂ, Integrable s ∧ ⇑s = ψ)
    (fun b hb ε hε => by rw [hPn0]; exact goodIn_approx_simple hb hc1 ε hε)
    (fun ψ ⟨s, hs, hsψ⟩ _ => by rw [insIn_update_self, hPn0, ← hsψ]; exact hlim s hs) hg0
  rw [insIn_update_self, hPn0] at key
  refine key.trans (le_of_eq ?_)
  rw [hNe, ENNReal.ofReal_mul hAθ0]
  ring

theorem prod_slots {α : Type*} [CommMonoid α] (n0 : Fin 3) (F : Fin 3 → α) :
    F n0 * (F (n0.succAbove 0) * F (n0.succAbove 1)) = F 0 * (F 1 * F 2) := by
  fin_cases n0
  · simp [Fin.succAbove]
  · simp [Fin.succAbove]; exact mul_left_comm _ _ _
  · simp [Fin.succAbove]; rw [mul_comm, mul_assoc]

theorem insIn_self (n0 : Fin 3) (g : Fin 3 → E3 → ℂ) :
    insIn n0 (g n0) (fun i => g (n0.succAbove i)) = g := by
  funext m
  rcases Fin.eq_self_or_eq_succAbove n0 m with h | ⟨k, rfl⟩
  · subst h; rw [insIn_apply_self]
  · rw [insIn_apply_succAbove]

theorem rpow_gain {D E γ K θ : ℝ} (hD : 0 ≤ D) (hE : 0 ≤ E) :
    (D * (2 : ℝ) ^ (-(γ * K))) ^ (1 - θ) * E ^ θ
      = D ^ (1 - θ) * E ^ θ * (2 : ℝ) ^ (-((γ * (1 - θ)) * K)) := by
  rw [Real.mul_rpow hD (by positivity), ← Real.rpow_mul (by norm_num),
    show -(γ * K) * (1 - θ) = -((γ * (1 - θ)) * K) by ring]
  ring

/-- The exponent bookkeeping of the three interpolation steps. -/
theorem interp_exponents {x0 x1 x2 : ℝ} (hx00 : 0 < x0) (hx10 : 0 < x1) (hx20 : 0 < x2)
    (hx1h : x1 < 1 / 2) (hx2h : x2 < 1 / 2) (hsum1 : x0 + x1 + x2 < 1) :
    ∃ u0 θ1 θ2 θ3 : ℝ, 0 < u0 ∧ u0 + x1 + x2 < 1 ∧ 0 < θ1 ∧ θ1 < 1 ∧ 0 < θ2 ∧ θ2 < 1 ∧
      0 < θ3 ∧ θ3 < 1 ∧
      1 / (1 / x1) = (1 - θ1) * (1 / 2) + θ1 * (1 / (2 / x1)) ∧
      1 / (1 / (x1 + 1 / 2)) = (1 - θ1) * (1 / 1) + θ1 * (1 / (1 / (x1 / 2 + 1 / 2))) ∧
      1 / (1 / (x1 + 1 / 2)) = 1 / (1 / x1) + 1 / 2 ∧
      1 / (1 / x2) = (1 - θ2) * (1 / 2) + θ2 * (1 / (2 / x2)) ∧
      1 / (1 / (x1 + x2)) = (1 - θ2) * (1 / (1 / (x1 + 1 / 2))) + θ2 * (1 / (1 / (x1 + x2 / 2))) ∧
      1 / (1 / (x1 + x2)) = 1 / (1 / x2) + 1 / (1 / x1) ∧
      1 / (1 / x0) = θ3 * (1 / (1 / u0)) ∧
      1 / (1 / (x0 + x1 + x2)) = (1 - θ3) * (1 / (1 / (x1 + x2))) + θ3 * (1 / (1 / (u0 + x1 + x2))) ∧
      1 / (1 / (x0 + x1 + x2)) = 1 / (1 / x0) + 1 / (1 / x1) + 1 / (1 / x2) := by
  set u0 := (x0 + (1 - x1 - x2)) / 2 with hu0
  have hu0x : x0 < u0 := by rw [hu0]; linarith
  have hu0s : u0 + x1 + x2 < 1 := by rw [hu0]; linarith
  have hu00 : 0 < u0 := by linarith
  have h1x1 : 0 < 1 - x1 := by linarith
  have h1x2 : 0 < 1 - x2 := by linarith
  have h1x1' : 1 - x1 ≠ 0 := h1x1.ne'
  have h1x2' : 1 - x2 ≠ 0 := h1x2.ne'
  refine ⟨u0, (1 - 2 * x1) / (1 - x1), (1 - 2 * x2) / (1 - x2), x0 / u0, hu00, hu0s,
    div_pos (by linarith) h1x1, by rw [div_lt_one h1x1]; linarith,
    div_pos (by linarith) h1x2, by rw [div_lt_one h1x2]; linarith,
    div_pos hx00 hu00, by rw [div_lt_one hu00]; exact hu0x, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  all_goals simp only [one_div_one_div, one_div_div]
  all_goals field_simp
  all_goals ring

