/-- The line map `t ↦ t • e_n`. -/
def lineMap (n : Fin 3) : ℝ →L[ℝ] E3 := (ContinuousLinearMap.id ℝ ℝ).smulRight (basisVec n)

theorem lineMap_apply (n : Fin 3) (t : ℝ) : lineMap n t = t • basisVec n := by
  simp [lineMap]

theorem lineMap_injective (n : Fin 3) : Function.Injective (lineMap n) := by
  intro s t h
  have := congrArg (fun v : E3 => v n) h
  simpa [lineMap_apply, basisVec] using this

/-- A Schwartz function restricted to the line `x + t e_n` is integrable in `t`. -/
theorem integrable_schwartz_line (g : SchwartzMap E3 ℂ) (n : Fin 3) (x : E3) :
    Integrable (fun t : ℝ => g (x + t • basisVec n)) := by
  have h := (Twisted.schwartzAffinePullbackOfInjective (𝕜 := ℂ) (lineMap n)
    (lineMap_injective n) x g).integrable (μ := volume)
  refine h.congr (Eventually.of_forall fun t => ?_)
  simp [Twisted.schwartzAffinePullbackOfInjective_apply, lineMap_apply, add_comm]

theorem exists_bound_schwartz (g : SchwartzMap E3 ℂ) : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, ‖g y‖ ≤ C :=
  ⟨‖g.toBoundedContinuousFunction‖, norm_nonneg _, fun y =>
    g.toBoundedContinuousFunction.norm_coe_le_norm y⟩

/-- For Schwartz inputs the integrand `t ↦ ∏_n f_n(x + t^n e_n)` is integrable on `ℝ`. -/
theorem integrable_prodShift_schwartz (f : Fin 3 → SchwartzMap E3 ℂ) (x : E3) :
    Integrable (prodShift (fun n => f n) x) := by
  obtain ⟨C1, hC1, h1⟩ := exists_bound_schwartz (f 1)
  obtain ⟨C2, hC2, h2⟩ := exists_bound_schwartz (f 2)
  refine Integrable.mono' ((integrable_schwartz_line (f 0) 0 x).norm.const_mul (C1 * C2))
    (continuous_prodShift (fun n => (f n).continuous) x).aestronglyMeasurable
    (Eventually.of_forall fun t => ?_)
  simp only [prodShift, Fin.prod_univ_three, norm_mul]
  have e0 : curve 0 t = t • basisVec 0 := by simp [curve, expo]
  rw [e0]
  have := mul_le_mul (h1 (x + curve 1 t)) (h2 (x + curve 2 t)) (norm_nonneg _) hC1
  nlinarith [norm_nonneg (f 0 (x + t • basisVec 0)), norm_nonneg (f 1 (x + curve 1 t)),
    norm_nonneg (f 2 (x + curve 2 t))]

theorem contDiff_prodShift_schwartz (f : Fin 3 → SchwartzMap E3 ℂ) (x : E3) :
    ContDiff ℝ 1 (prodShift (fun n => f n) x) := by
  unfold prodShift
  refine contDiff_prod fun n _ => ?_
  refine ((f n).smooth ⊤).of_le (by exact_mod_cast le_top) |>.comp ?_
  unfold curve
  fun_prop

/-- **The principal value exists** (`blueprints/main.tex`, lines 134-137): for Schwartz inputs
the truncations `∫_{|t|>ε} ∏_n f_n(x + t^n e_n) dt/t` converge as `ε → 0+`. -/
theorem tendsto_simplexTrunc (f : Fin 3 → SchwartzMap E3 ℂ) (x : E3) :
    Tendsto (simplexTrunc (fun n => f n) x) (𝓝[>] 0)
      (𝓝 (∫ t in Ioi 0, pvOdd (prodShift (fun n => f n) x) t)) := by
  obtain ⟨K, hK⟩ := (contDiff_prodShift_schwartz f x).contDiffOn.exists_lipschitzOnWith
    one_ne_zero (convex_Icc (-1 : ℝ) 1) isCompact_Icc
