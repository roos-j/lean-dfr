  have ha : 0 < |ζ| := abs_pos.mpr hζ
  obtain ⟨N, hN1⟩ := pow_unbounded_of_one_lt (4 * |ζ|) (by norm_num : (1 : ℝ) < 2)
  obtain ⟨M, hM1⟩ := pow_unbounded_of_one_lt (4 / |ζ|) (by norm_num : (1 : ℝ) < 2)
  set L : ℕ := N + M with hL
  have h2L : 4 * |ζ| < 2 ^ L ∧ 4 / |ζ| < 2 ^ L := by
    constructor
    · exact hN1.trans_le (pow_le_pow_right₀ (by norm_num) (by omega))
    · exact hM1.trans_le (pow_le_pow_right₀ (by norm_num) (by omega))
  have hzero : ∀ j ∉ Finset.Icc (-(L : ℤ)) (-(L : ℤ) + (2 * L : ℕ)), lpPsiJ j ζ = 0 := by
    intro j hj
    by_contra hne
    obtain ⟨h1, h2⟩ := lpPsiJ_support hne
    simp only [Finset.mem_Icc, not_and_or, not_le] at hj
    push_cast at hj
    rcases hj with hj | hj
    · -- `j < -L`: then `2^{j+1} ≤ 2^{-L} < |ζ| / 4`
      have hle : (2 : ℝ) ^ (j + 1) ≤ 2 ^ (-(L : ℤ)) :=
