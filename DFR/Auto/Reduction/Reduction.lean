  have h1 : (fun t : ℝ => ((m t : ℝ) : ℂ)).HasTemperateGrowth :=
    (hc.comp_left Complex.ofReal_zero).hasTemperateGrowth (Complex.ofRealCLM.contDiff.comp hd)
  exact h1.comp (EuclideanSpace.proj (𝕜 := ℝ) ℓ).hasTemperateGrowth

