    (integrable_prodShift_schwartz f x) hK

theorem simplexT_eq (f : Fin 3 → SchwartzMap E3 ℂ) (x : E3) :
    simplexT (fun n => f n) x = ∫ t in Ioi 0, pvOdd (prodShift (fun n => f n) x) t :=
  (tendsto_simplexTrunc f x).limUnder_eq

