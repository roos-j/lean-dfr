theorem contDiff_lpPhi {n : ℕ∞} : ContDiff ℝ n lpPhi := lpBump.contDiff

theorem lpPhi_nonneg (ζ : ℝ) : 0 ≤ lpPhi ζ := lpBump.nonneg

theorem lpPhi_le_one (ζ : ℝ) : lpPhi ζ ≤ 1 := lpBump.le_one

theorem lpPhi_neg (ζ : ℝ) : lpPhi (-ζ) = lpPhi ζ := lpBump.neg ζ

theorem lpPhi_eq_one {ζ : ℝ} (h : |ζ| ≤ 1) : lpPhi ζ = 1 :=
  lpBump.one_of_mem_closedBall (by simpa [Metric.mem_closedBall, lpBump] using h)

theorem lpPhi_eq_zero {ζ : ℝ} (h : 2 ≤ |ζ|) : lpPhi ζ = 0 :=
  lpBump.zero_of_le_dist (by simpa [Real.dist_eq, lpBump] using h)

/-- `ψ(ζ) = φ(ζ) - φ(2ζ)`, line 279. -/
def lpPsi (ζ : ℝ) : ℝ := lpPhi ζ - lpPhi (2 * ζ)

/-- `φ_j(ζ) = φ(2^{-j} ζ)`, line 283. -/
def lpPhiJ (j : ℤ) (ζ : ℝ) : ℝ := lpPhi ((2 : ℝ) ^ (-j) * ζ)

/-- `ψ_j(ζ) = ψ(2^{-j} ζ)`, line 283. -/
def lpPsiJ (j : ℤ) (ζ : ℝ) : ℝ := lpPsi ((2 : ℝ) ^ (-j) * ζ)

/-- `ψ_j = φ_j - φ_{j-1}`, line 283. -/
theorem lpPsiJ_eq (j : ℤ) (ζ : ℝ) : lpPsiJ j ζ = lpPhiJ j ζ - lpPhiJ (j - 1) ζ := by
  unfold lpPsiJ lpPsi lpPhiJ
  congr 2
  rw [← mul_assoc, neg_sub, zpow_sub₀ two_ne_zero, zpow_one, zpow_neg]
  ring

theorem lpPsi_eq_zero_of_abs_lt {ζ : ℝ} (h : |ζ| < 1 / 2) : lpPsi ζ = 0 := by
  unfold lpPsi
  rw [lpPhi_eq_one (by linarith), lpPhi_eq_one (by rw [abs_mul]; norm_num; linarith), sub_self]

theorem lpPsi_eq_zero_of_le_abs {ζ : ℝ} (h : 2 ≤ |ζ|) : lpPsi ζ = 0 := by
  unfold lpPsi
  rw [lpPhi_eq_zero h, lpPhi_eq_zero (by rw [abs_mul]; norm_num; linarith), sub_self]

