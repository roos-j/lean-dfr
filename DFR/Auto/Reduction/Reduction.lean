theorem lpPsi_support {ζ : ℝ} (h : lpPsi ζ ≠ 0) : 1 / 2 ≤ |ζ| ∧ |ζ| < 2 := by
  constructor
  · by_contra h'; exact h (lpPsi_eq_zero_of_abs_lt (not_le.mp h'))
  · by_contra h'; exact h (lpPsi_eq_zero_of_le_abs (not_lt.mp h'))

