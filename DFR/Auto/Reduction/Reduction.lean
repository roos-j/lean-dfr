    Finset.Icc a (b + 1) = insert (b + 1) (Finset.Icc a b) := by
  ext j; simp only [Finset.mem_Icc, Finset.mem_insert]; omega

/-- Telescoping over an integer interval. -/
theorem sum_Icc_sub_telescope (g : ℤ → ℝ) (a : ℤ) (n : ℕ) :
    ∑ j ∈ Finset.Icc a (a + n), (g j - g (j - 1)) = g (a + n) - g (a - 1) := by
  induction n with
  | zero => simp
  | succ n ih =>
    have e : a + ((n + 1 : ℕ) : ℤ) = (a + n) + 1 := by push_cast; ring
    rw [e, Icc_add_one_right _ _ (by omega), Finset.sum_insert (by simp), ih]
    simp only [add_sub_cancel_right]
    ring

