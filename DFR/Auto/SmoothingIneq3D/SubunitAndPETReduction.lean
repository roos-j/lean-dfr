  have := norm_setIntegral_le_of_norm_le_const (C := 1) (μ := volume) (s := B)
    (f := fun x : E3 => cfgProd g γ x t * (starRingEnd ℂ) (cfgProd g γ x s)) hfin
    fun x _ => hbd x
