    intro x
    rw [norm_mul, RCLike.norm_conj]
    exact ((mul_le_of_le_one_left (norm_nonneg _) (norm_cfgProd_le hg1 γ x t)).trans
      (norm_cfgProd_le hg1 γ x s))
