theorem lintegral_enorm_Astar_ne_top {N : ℝ} (hN : 0 < N) (j : Fin 3) {f0 : E3 → ℂ}
    (hf0c : Continuous f0) (hf0i : Integrable f0) {f : Fin 3 → E3 → ℂ} {Cb : ℝ}
    (hCb : 0 ≤ Cb) (hfb : ∀ i x, ‖f i x‖ ≤ Cb) :
    (∫⁻ y, ‖Astar N j f0 f y‖ₑ) ≠ ⊤ := by
  have hjoint : Measurable fun p : E3 × ℝ => ‖f0 (p.1 - curve j p.2)‖ₑ :=
    (hf0c.measurable.comp (measurable_fst.sub
      ((continuous_curve j).measurable.comp measurable_snd))).enorm
  have hslice : ∀ t : ℝ, (∫⁻ y, ‖f0 (y - curve j t)‖ₑ) = ∫⁻ y, ‖f0 y‖ₑ := fun t =>
    lintegral_add_right_eq_self (μ := (volume : Measure E3)) (fun y : E3 => ‖f0 y‖ₑ)
      (-curve j t)
  have hf0fin : (∫⁻ y, ‖f0 y‖ₑ) ≠ ⊤ := hf0i.hasFiniteIntegral.ne
  have htot : (∫⁻ y, ∫⁻ t in Set.Ioc (0 : ℝ) N, ‖f0 (y - curve j t)‖ₑ)
      = ENNReal.ofReal N * ∫⁻ y, ‖f0 y‖ₑ := by
    rw [lintegral_lintegral_swap hjoint.aemeasurable]
    simp only [hslice]
    rw [setLIntegral_const, Real.volume_Ioc, sub_zero]
    ring
  have hbound : (∫⁻ y, ‖Astar N j f0 f y‖ₑ)
      ≤ ENNReal.ofReal N⁻¹ * ENNReal.ofReal (Cb ^ 2) * (ENNReal.ofReal N * ∫⁻ y, ‖f0 y‖ₑ) := by
    calc (∫⁻ y, ‖Astar N j f0 f y‖ₑ)
        ≤ ∫⁻ y, ENNReal.ofReal N⁻¹ * ENNReal.ofReal (Cb ^ 2)
            * ∫⁻ t in Set.Ioc (0 : ℝ) N, ‖f0 (y - curve j t)‖ₑ :=
          lintegral_mono fun y => enorm_Astar_le hN j hCb hfb y
      _ = ENNReal.ofReal N⁻¹ * ENNReal.ofReal (Cb ^ 2)
            * ∫⁻ y, ∫⁻ t in Set.Ioc (0 : ℝ) N, ‖f0 (y - curve j t)‖ₑ :=
          lintegral_const_mul' _ _
            (ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top)
      _ = _ := by rw [htot]
  refine ne_top_of_le_ne_top ?_ hbound
