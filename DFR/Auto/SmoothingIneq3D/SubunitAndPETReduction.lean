/-! ## Blueprint `lem:degree-lowering-zero`: selecting the last difference

`Auto.locUnifPow_succ_split` writes the `(s+1)`-fold average as a Fejer average over the first
shift. Taking real parts through that integral and pigeonholing with
`Auto.exists_of_fejer_average_ge'` -- the variant that places the selected shift inside the kernel's
support -- gives the blueprint's "select the last difference `h` on a set of Fejer measure at least
`c rho^C`".

The pigeonhole is applied to the real part because that is what `Auto.locUnif` takes a root of, and
because the real part is what the nonnegativity `Auto.locUnifPow_re_nonneg` controls. -/

open MeasureTheory in
/-- The `s`-fold average of the differenced function is measurable in the shift, as a complex
quantity. -/
theorem measurable_locUnifPow_fdiff_c {N H : ℝ} (hH : 0 < H) (j : Fin 3) (s : ℕ) {f : E3 → ℂ}
    (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) :
    Measurable fun a : ℝ => locUnifPow N H j s (fdiff (basisVec j) a f) := by
  have hcongr : (fun a : ℝ => locUnifPow N H j s (fdiff (basisVec j) a f))
      = fun a : ℝ => ((N ^ (6 : ℕ))⁻¹ : ℂ) * ∫ h' : Fin s → ℝ, ((fejerCube H h' : ℝ) : ℂ)
          * pairAvg (basisVec j) (fdiffIter (basisVec j) s h' f) a := by
    funext a
    rw [locUnifPow_fdiff_eq hH j s hf hf1 a]
  rw [hcongr]
  refine measurable_const.mul ?_
  have hjoint : StronglyMeasurable fun p : ℝ × (Fin s → ℝ) =>
      ((fejerCube H p.2 : ℝ) : ℂ)
        * pairAvg (basisVec j) (fdiffIter (basisVec j) s p.2 f) p.1 := by
    refine StronglyMeasurable.mul ?_ (stronglyMeasurable_pairAvg_cube _ s hf.1)
    exact (Complex.continuous_ofReal.comp
      ((continuous_fejerCube H s).comp continuous_snd)).stronglyMeasurable
  exact (hjoint.integral_prod_right' (ν := (volume : Measure (Fin s → ℝ)))).measurable

open MeasureTheory in
/-- The Fejer average of the differenced averages is integrable. -/
theorem integrable_fejer_locUnifPow_fdiff {N H : ℝ} (hH : 0 < H) (j : Fin 3) (s : ℕ)
    {f : E3 → ℂ} (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) :
    Integrable fun a : ℝ =>
      ((fejer H a : ℝ) : ℂ) * locUnifPow N H j s (fdiff (basisVec j) a f) := by
  set M : ℝ := |((N : ℝ) ^ (6 : ℕ))⁻¹| * ∫ x : E3, ‖f x‖ with hM
  have hM0 : 0 ≤ M := by
    rw [hM]
    exact mul_nonneg (abs_nonneg _) (integral_nonneg fun _ => norm_nonneg _)
  refine Integrable.mono' ((integrable_fejer hH).mul_const M) ?_
    (Filter.Eventually.of_forall fun a => ?_)
  · exact ((Complex.continuous_ofReal.comp continuous_fejer).measurable.mul
      (measurable_locUnifPow_fdiff_c hH j s hf hf1)).aestronglyMeasurable
  · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (fejer_nonneg hH a)]
    exact mul_le_mul_of_nonneg_left (norm_locUnifPow_fdiff_le hH j s hf hf1 a)
      (fejer_nonneg hH a)

open MeasureTheory in
/-- **The real part of the splitting.** Real parts pass through the Fejer average. -/
theorem re_locUnifPow_succ_split {N H : ℝ} (hH : 0 < H) (hN : N ≠ 0) (j : Fin 3) (s : ℕ)
    {f : E3 → ℂ} (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) :
    (locUnifPow N H j (s + 1) f).re
      = ∫ a : ℝ, fejer H a * (locUnifPow N H j s (fdiff (basisVec j) a f)).re := by
  rw [locUnifPow_succ_split hH hN j s hf hf1]
  rw [← Complex.reCLM_apply, ← ContinuousLinearMap.integral_comp_comm _
    (integrable_fejer_locUnifPow_fdiff hH j s hf hf1)]
  refine integral_congr_ae (Filter.Eventually.of_forall fun a => ?_)
  change (((fejer H a : ℝ) : ℂ) * locUnifPow N H j s (fdiff (basisVec j) a f)).re
      = fejer H a * (locUnifPow N H j s (fdiff (basisVec j) a f)).re
  rw [Complex.re_ofReal_mul]

open MeasureTheory in
/-- **Selecting the last difference.** A lower bound on the `(s+1)`-fold average yields a shift
inside the kernel's support at which the `s`-fold average of the differenced function is bounded
below. -/
theorem exists_shift_locUnifPow_ge {N H : ℝ} (hH : 0 < H) (hN : N ≠ 0) (j : Fin 3) (s : ℕ)
    {f : E3 → ℂ} (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) {ρ : ℝ} (hρ : 0 < ρ)
    (hlow : ρ ≤ (locUnifPow N H j (s + 1) f).re) :
    ∃ a : ℝ, |a| ≤ H
      ∧ ρ / 2 ≤ (locUnifPow N H j s (fdiff (basisVec j) a f)).re := by
  set M : ℝ := |((N : ℝ) ^ (6 : ℕ))⁻¹| * ∫ x : E3, ‖f x‖ with hM
  have hbd : ∀ a : ℝ, |(locUnifPow N H j s (fdiff (basisVec j) a f)).re| ≤ M := by
    intro a
    refine le_trans (Complex.abs_re_le_norm _) ?_
    exact norm_locUnifPow_fdiff_le hH j s hf hf1 a
  refine exists_of_fejer_average_ge' hH hρ
    (Complex.measurable_re.comp (measurable_locUnifPow_fdiff_c hH j s hf hf1)) hbd ?_
  rw [← re_locUnifPow_succ_split hH hN j s hf hf1]
  exact hlow



/-! ## Blueprint `thm:real-inverse`: the phase cut-off

The theorem's witness is
  `h_j(x) = 1_{I_N(C_1)}(x) * ph(P_L^{(j)} f_j(x))`,

and the point of it is that pairing a function against the cut-off phase of itself returns the `L^1`
norm over the cut-off set. That is the same unimodular bridge as `Auto.dHead`, and it is extracted
here in the general form the theorem needs, so that an `L^1` lower bound becomes a lower bound for a
pairing against a one-bounded function supported in the box.

This part of `thm:real-inverse` is independent of `lem:pet-reduction` and of
`lem:degree-lowering-zero`: those supply the `L^1` lower bound, which enters as a hypothesis. -/

open Classical in
/-- The cut-off phase of a function: unimodular on the set, zero off it. -/
noncomputable def phaseCutoff (B : Set E3) (F : E3 → ℂ) : E3 → ℂ :=
  B.indicator (unitPhase F)

theorem norm_phaseCutoff_le (B : Set E3) (F : E3 → ℂ) (x : E3) :
    ‖phaseCutoff B F x‖ ≤ 1 := by
  classical
  rw [phaseCutoff]
  by_cases hx : x ∈ B
  · rw [Set.indicator_of_mem hx]
    exact norm_unitPhase_le _ x
  · rw [Set.indicator_of_notMem hx, norm_zero]
    exact zero_le_one

theorem phaseCutoff_eq_zero_of_notMem (B : Set E3) (F : E3 → ℂ) {x : E3} (hx : x ∉ B) :
    phaseCutoff B F x = 0 := by
  rw [phaseCutoff, Set.indicator_of_notMem hx]

open MeasureTheory in
theorem measurable_phaseCutoff {B : Set E3} (hBm : MeasurableSet B) {F : E3 → ℂ}
    (hFm : Measurable F) : Measurable (phaseCutoff B F) :=
  (measurable_unitPhase hFm).indicator hBm

open MeasureTheory in
/-- **The pairing against the cut-off phase is the `L^1` norm over the set.** -/
theorem integral_phaseCutoff_mul {B : Set E3} (hBm : MeasurableSet B) (F : E3 → ℂ) :
    (∫ x : E3, phaseCutoff B F x * F x) = ((∫ x in B, ‖F x‖ : ℝ) : ℂ) := by
  classical
  rw [setIntegral_norm_eq_setIntegral_unitPhase, ← integral_indicator hBm]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
  simp only [phaseCutoff]
  by_cases hx : x ∈ B
  · rw [Set.indicator_of_mem hx, Set.indicator_of_mem hx]
  · rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem hx, zero_mul]

open MeasureTheory in
/-- Hence an `L^1` lower bound over the set becomes a lower bound for a pairing against a
one-bounded function supported there -- the shape of `thm:real-inverse`'s conclusion. -/
theorem norm_integral_phaseCutoff_mul {B : Set E3} (hBm : MeasurableSet B) (F : E3 → ℂ) :
    ‖∫ x : E3, phaseCutoff B F x * F x‖ = ∫ x in B, ‖F x‖ := by
  rw [integral_phaseCutoff_mul hBm, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (integral_nonneg fun _ => norm_nonneg _)]

open MeasureTheory in
/-- **The witness of `thm:real-inverse`, packaged.** From an `L^1` lower bound on the box, a
one-bounded function supported in the box whose pairing with `F` is at least that bound. -/
theorem exists_phase_witness {B : Set E3} (hBm : MeasurableSet B) {F : E3 → ℂ}
    (hFm : Measurable F) {κ : ℝ} (hlow : κ ≤ ∫ x in B, ‖F x‖) :
    ∃ u : E3 → ℂ, Measurable u ∧ (∀ x, ‖u x‖ ≤ 1) ∧ (∀ x, x ∉ B → u x = 0)
      ∧ κ ≤ ‖∫ x : E3, u x * F x‖ :=
  ⟨phaseCutoff B F, measurable_phaseCutoff hBm hFm, norm_phaseCutoff_le B F,
    fun _x hx => phaseCutoff_eq_zero_of_notMem B F hx,
    by rw [norm_integral_phaseCutoff_mul hBm]; exact hlow⟩


open MeasureTheory in
/-- **`thm:real-inverse`: the witness in the blueprint's pairing form.**

The theorem asks for `h_j` with `|⟪f_j, P_L^{(j)} h_j⟫| ≥ C^{-1} δ^C N^6`, the projection sitting
on the witness. `exists_phase_witness` produces the bound with the projection on `f_j` instead;
`P_self_adjoint` moves it across. The witness is therefore
`h_j = conj (1_B · ph (P_L^{(j)} f_j))`, and the `L^1` lower bound on `P_L^{(j)} f_j` over the box
-- the output of `lem:degree-lowering-zero` -- enters as a hypothesis. -/
theorem exists_real_inverse_witness {L : ℝ} (hL : 0 < L) (j : Fin 3) {B : Set E3}
    (hBm : MeasurableSet B) {f : E3 → ℂ} (hfc : Continuous f) (hfi : Integrable f)
    {Cf : ℝ} (hfb : ∀ x, ‖f x‖ ≤ Cf) {κ : ℝ} (hlow : κ ≤ ∫ x in B, ‖P L j f x‖) :
    ∃ h : E3 → ℂ, Measurable h ∧ (∀ x, ‖h x‖ ≤ 1) ∧ (∀ x, x ∉ B → h x = 0)
      ∧ κ ≤ ‖∫ x : E3, f x * (starRingEnd ℂ) (P L j h x)‖ := by
  classical
  have hFm : Measurable (P L j f) := (continuous_P hL j hfc hfb).measurable
  have hm : Measurable fun x : E3 => (starRingEnd ℂ) (phaseCutoff B (P L j f) x) :=
    Complex.continuous_conj.measurable.comp (measurable_phaseCutoff hBm hFm)
  have hb : ∀ x : E3, ‖(starRingEnd ℂ) (phaseCutoff B (P L j f) x)‖ ≤ 1 := fun x => by
    rw [RCLike.norm_conj]
    exact norm_phaseCutoff_le B (P L j f) x
  refine ⟨fun x => (starRingEnd ℂ) (phaseCutoff B (P L j f) x), hm, hb, ?_, ?_⟩
  · intro x hx
    change (starRingEnd ℂ) (phaseCutoff B (P L j f) x) = 0
    rw [phaseCutoff_eq_zero_of_notMem B (P L j f) hx, map_zero]
  · rw [← P_self_adjoint hL j hfc hfi hm hb]
    have hcongr : (∫ x : E3, P L j f x
          * (starRingEnd ℂ) ((starRingEnd ℂ) (phaseCutoff B (P L j f) x)))
        = ∫ x : E3, phaseCutoff B (P L j f) x * P L j f x := by
      refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
      change P L j f x * (starRingEnd ℂ) ((starRingEnd ℂ) (phaseCutoff B (P L j f) x))
          = phaseCutoff B (P L j f) x * P L j f x
      rw [Complex.conj_conj]
      ring
    rw [hcongr, norm_integral_phaseCutoff_mul hBm]
    exact hlow


/-! ## Blueprint `lem:degree-lowering-zero`: the Fourier transform of the Fejer kernel

The `s = 2` endpoint of the lemma rests on the identity
  `hat kappa_H(xi) = (sin(pi H xi) / (pi H xi))^2`,

whose whole point is that the multiplier is **nonnegative**: it turns the local `U^2` expression
into a nonnegative weighted partial-frequency energy, which is what the major-frequency restriction
is then applied to. `Auto.fejer` is the normalized triangle of width `2H`, so the computation is
one elementary antiderivative on `[0, H]` together with the reflection `h -> -h`. -/
theorem fejer_neg (H h : ℝ) : fejer H (-h) = fejer H h := by
  rw [fejer, fejer, abs_neg]

open MeasureTheory intervalIntegral in
/-- The antiderivative behind the Fejer transform: `∫_0^H (1 - h/H) e^{ch} dh` for `c ≠ 0`. -/
theorem integral_one_sub_div_mul_cexp {H : ℝ} (hH : 0 < H) {c : ℂ} (hc : c ≠ 0) :
    (∫ h in (0 : ℝ)..H, (1 - (h : ℂ) / (H : ℂ)) * Complex.exp (c * h))
      = Complex.exp (c * H) / (c ^ 2 * H) - 1 / c - 1 / (c ^ 2 * H) := by
  have hH0 : (H : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hH.ne'
  have hderivC : ∀ z : ℂ,
      HasDerivAt (fun w : ℂ => ((1 - w / (H : ℂ)) / c + 1 / (c ^ 2 * (H : ℂ)))
          * Complex.exp (c * w))
        ((1 - z / (H : ℂ)) * Complex.exp (c * z)) z := by
    intro z
    have hid : HasDerivAt (fun w : ℂ => w) 1 z := hasDerivAt_id z
    have hA : HasDerivAt (fun w : ℂ => (1 - w / (H : ℂ)) / c + 1 / (c ^ 2 * (H : ℂ)))
        (-(1 / (H : ℂ)) / c) z :=
      (((hid.div_const (H : ℂ)).const_sub 1).div_const c).add_const _
    have hE : HasDerivAt (fun w : ℂ => Complex.exp (c * w))
        (Complex.exp (c * z) * (c * 1)) z := (hid.const_mul c).cexp
    refine (hA.mul hE).congr_deriv ?_
    field_simp
    ring
  have hderiv : ∀ h ∈ Set.uIcc (0 : ℝ) H,
      HasDerivAt (fun t : ℝ => ((1 - (t : ℂ) / (H : ℂ)) / c + 1 / (c ^ 2 * (H : ℂ)))
          * Complex.exp (c * t))
        ((1 - (h : ℂ) / (H : ℂ)) * Complex.exp (c * h)) h :=
    fun h _ => (hderivC (h : ℂ)).comp_ofReal
  have hcont : Continuous fun h : ℝ => (1 - (h : ℂ) / (H : ℂ)) * Complex.exp (c * h) := by
    fun_prop
  rw [integral_eq_sub_of_hasDerivAt hderiv (hcont.intervalIntegrable _ _)]
  rw [Complex.ofReal_zero, mul_zero, Complex.exp_zero, zero_div]
  field_simp
  ring

open MeasureTheory intervalIntegral in
/-- The full-line integral of the Fejer kernel against a complex exponential. -/
theorem integral_fejer_mul_cexp {H : ℝ} (hH : 0 < H) {c : ℂ} (hc : c ≠ 0) :
    (∫ h : ℝ, (fejer H h : ℂ) * Complex.exp (c * h))
      = (Complex.exp (c * H) + Complex.exp (-(c * H)) - 2) / (c ^ 2 * (H : ℂ) ^ 2) := by
  have hH0 : (H : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hH.ne'
  have hcont : ∀ d : ℂ, Continuous fun h : ℝ => (fejer H h : ℂ) * Complex.exp (d * h) :=
    fun d => (Complex.continuous_ofReal.comp continuous_fejer).mul (by fun_prop)
  have hzero : ∀ h : ℝ, h ∉ Set.Ioc (-H) H → (fejer H h : ℂ) * Complex.exp (c * h) = 0 := by
    intro h hh
    rw [fejer_eq_zero_off hH hh, Complex.ofReal_zero, zero_mul]
  -- the half-line piece, for an arbitrary exponent
  have hhalf : ∀ d : ℂ, d ≠ 0 →
      (∫ h in (0 : ℝ)..H, (fejer H h : ℂ) * Complex.exp (d * h))
        = (H : ℂ)⁻¹ * (Complex.exp (d * H) / (d ^ 2 * H) - 1 / d - 1 / (d ^ 2 * H)) := by
    intro d hd
    have hcongr : (∫ h in (0 : ℝ)..H, (fejer H h : ℂ) * Complex.exp (d * h))
        = ∫ h in (0 : ℝ)..H, (H : ℂ)⁻¹ * ((1 - (h : ℂ) / (H : ℂ)) * Complex.exp (d * h)) := by
      refine intervalIntegral.integral_congr fun h hh => ?_
      rw [Set.uIcc_of_le hH.le] at hh
      have habs : |h| ≤ H := by rw [abs_of_nonneg hh.1]; exact hh.2
      change (fejer H h : ℂ) * Complex.exp (d * h)
          = (H : ℂ)⁻¹ * ((1 - (h : ℂ) / (H : ℂ)) * Complex.exp (d * h))
      rw [fejer_eq_of_mem hH habs, abs_of_nonneg hh.1]
      push_cast
      ring
    rw [hcongr, intervalIntegral.integral_const_mul, integral_one_sub_div_mul_cexp hH hd]
  -- the reflected piece
  have hrefl : (∫ h in (-H)..(0 : ℝ), (fejer H h : ℂ) * Complex.exp (c * h))
      = ∫ h in (0 : ℝ)..H, (fejer H h : ℂ) * Complex.exp (-c * h) := by
    have h1 := intervalIntegral.integral_comp_neg (a := (0 : ℝ)) (b := H)
      (f := fun t : ℝ => (fejer H t : ℂ) * Complex.exp (c * t))
    rw [neg_zero] at h1
    rw [← h1]
    refine intervalIntegral.integral_congr fun h _ => ?_
    rw [fejer_neg]
    push_cast
    ring
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero hzero,
    ← intervalIntegral.integral_of_le (by linarith : (-H : ℝ) ≤ H),
    ← intervalIntegral.integral_add_adjacent_intervals (b := (0 : ℝ))
      ((hcont c).intervalIntegrable _ _) ((hcont c).intervalIntegrable _ _),
    hrefl, hhalf c hc, hhalf (-c) (neg_ne_zero.mpr hc)]
  rw [show Complex.exp (-c * (H : ℂ)) = Complex.exp (-(c * (H : ℂ))) by rw [neg_mul]]
  field_simp
  ring

/-- The Fejer multiplier `hat kappa_H`. At `xi = 0` the quotient is `0/0`, and the true value of
the transform there is the total mass `1`, so the definition names it. -/
noncomputable def fejerHat (H ξ : ℝ) : ℝ :=
  if ξ = 0 then 1 else (Real.sin (Real.pi * (H * ξ)) / (Real.pi * (H * ξ))) ^ 2

theorem fejerHat_nonneg (H ξ : ℝ) : 0 ≤ fejerHat H ξ := by
  rw [fejerHat]
  split_ifs with h
  · exact zero_le_one
  · exact sq_nonneg _

theorem fejerHat_le_one (H ξ : ℝ) : fejerHat H ξ ≤ 1 := by
  rw [fejerHat]
  split_ifs with h
  · exact le_rfl
  · rcases eq_or_ne (Real.pi * (H * ξ)) 0 with hz | hz
    · rw [hz]
      norm_num
    · rw [div_pow, div_le_one (by positivity)]
      calc Real.sin (Real.pi * (H * ξ)) ^ 2
          = |Real.sin (Real.pi * (H * ξ))| ^ 2 := (sq_abs _).symm
        _ ≤ |Real.pi * (H * ξ)| ^ 2 :=
            pow_le_pow_left₀ (abs_nonneg _) Real.abs_sin_le_abs 2
        _ = (Real.pi * (H * ξ)) ^ 2 := sq_abs _

open MeasureTheory in
/-- **The Fourier transform of the Fejer kernel**, blueprint `lem:degree-lowering-zero`. -/
theorem fourier_fejer {H : ℝ} (hH : 0 < H) (ξ : ℝ) :
    𝓕 (fun h : ℝ => (fejer H h : ℂ)) ξ = ((fejerHat H ξ : ℝ) : ℂ) := by
  rw [Real.fourier_real_eq_integral_exp_smul]
  by_cases hξ : ξ = 0
  · subst hξ
    have hsimp : ∀ v : ℝ,
        Complex.exp ((↑(-2 * Real.pi * v * (0 : ℝ)) : ℂ) * Complex.I) • ((fejer H v : ℝ) : ℂ)
          = ((fejer H v : ℝ) : ℂ) := by
      intro v
      norm_num
    have hhat : fejerHat H 0 = 1 := by rw [fejerHat, ite_eq_left rfl]
    have hofR : (∫ v : ℝ, ((fejer H v : ℝ) : ℂ)) = ((∫ v : ℝ, fejer H v : ℝ) : ℂ) := by
      simpa using Complex.ofRealCLM.integral_comp_comm (integrable_fejer hH)
    simp only [hsimp]
    rw [hofR, integral_fejer hH, hhat]
  · have hpi : (0 : ℝ) < Real.pi := Real.pi_pos
    have hne : (-(2 * Real.pi * ξ) : ℝ) ≠ 0 := by
      simp only [ne_eq, neg_eq_zero]
      exact mul_ne_zero (by positivity) hξ
    set c : ℂ := ((-(2 * Real.pi * ξ) : ℝ) : ℂ) * Complex.I with hcdef
    have hc : c ≠ 0 :=
      mul_ne_zero (Complex.ofReal_ne_zero.mpr hne) Complex.I_ne_zero
    have hint : ∀ v : ℝ,
        Complex.exp ((↑(-2 * Real.pi * v * ξ) : ℂ) * Complex.I) • ((fejer H v : ℝ) : ℂ)
          = ((fejer H v : ℝ) : ℂ) * Complex.exp (c * v) := by
      intro v
      rw [smul_eq_mul, mul_comm]
      congr 2
      rw [hcdef]
      push_cast
      ring
    simp only [hint]
    rw [integral_fejer_mul_cexp hH hc]
    have hz : c * (H : ℂ) = -(((2 * Real.pi * ξ * H : ℝ)) : ℂ) * Complex.I := by
      rw [hcdef]; push_cast; ring
    have hsum : Complex.exp (c * H) + Complex.exp (-(c * H))
        = 2 * ((Real.cos (2 * Real.pi * ξ * H) : ℝ) : ℂ) := by
      rw [hz, Complex.ofReal_cos, Complex.two_cos, neg_mul, neg_neg]
      ring
    have hsq : c ^ 2 = ((-(2 * Real.pi * ξ) ^ 2 : ℝ) : ℂ) := by
      rw [hcdef, mul_pow, Complex.I_sq]
      push_cast
      ring
    rw [hsum, hsq]
    have hargne : Real.pi * (H * ξ) ≠ 0 :=
      mul_ne_zero hpi.ne' (mul_ne_zero hH.ne' hξ)
    have hreal : (2 * Real.cos (2 * Real.pi * ξ * H) - 2) / (-(2 * Real.pi * ξ) ^ 2 * H ^ 2)
        = fejerHat H ξ := by
      have hcos : Real.cos (2 * Real.pi * ξ * H)
          = 1 - 2 * Real.sin (Real.pi * (H * ξ)) ^ 2 := by
        have harg : 2 * Real.pi * ξ * H = 2 * (Real.pi * (H * ξ)) := by ring
        rw [harg, Real.cos_two_mul]
        nlinarith [Real.sin_sq_add_cos_sq (Real.pi * (H * ξ))]
      rw [hcos, fejerHat, ite_eq_right hξ]
      field_simp
      ring
    rw [← hreal]
    push_cast
    ring


/-! ### The Fejer multiplier is integrable

`hat kappa_H` is bounded by `1` and decays like `(pi H xi)^{-2}`; both bounds together give the
single clean majorant `2 / (1 + (pi H xi)^2)`, which is a dilate of Mathlib's
`integrable_inv_one_add_sq`. Integrability is what lets the multiplier be paired with a
frequency-side energy, and it is also the hypothesis of Fourier inversion for
  `Auto.fourier_fejer`. -/
theorem fejerHat_le_two_div (H ξ : ℝ) :
    fejerHat H ξ ≤ 2 / (1 + (Real.pi * (H * ξ)) ^ 2) := by
  rw [fejerHat]
  split_ifs with hξ
  · subst hξ
    norm_num
  · set θ : ℝ := Real.pi * (H * ξ) with hθ
    have hs1 : Real.sin θ ^ 2 ≤ 1 := by
      nlinarith [Real.sin_sq_add_cos_sq θ, sq_nonneg (Real.cos θ)]
    have hs2 : Real.sin θ ^ 2 ≤ θ ^ 2 := by
      have habs : |Real.sin θ| ≤ |θ| := Real.abs_sin_le_abs
      have h1 : |Real.sin θ| ^ 2 ≤ |θ| ^ 2 :=
        pow_le_pow_left₀ (abs_nonneg _) habs 2
      rwa [sq_abs, sq_abs] at h1
    have hpos : (0 : ℝ) < 1 + θ ^ 2 := by positivity
    rcases eq_or_ne θ 0 with h0 | h0
    · rw [h0]
      norm_num
    · have hθ2 : (0 : ℝ) < θ ^ 2 := by positivity
      rw [div_pow, div_le_div_iff₀ hθ2 hpos]
      nlinarith [hs1, hs2, hθ2.le, mul_le_mul_of_nonneg_right hs1 hθ2.le]

open MeasureTheory in
theorem measurable_fejerHat (H : ℝ) : Measurable (fejerHat H) := by
  unfold fejerHat
  refine Measurable.ite measurableSet_eq measurable_const ?_
  exact ((Real.measurable_sin.comp (by fun_prop)).div (by fun_prop)).pow_const 2

open MeasureTheory in
/-- **The Fejer multiplier is integrable.** -/
theorem integrable_fejerHat {H : ℝ} (hH : 0 < H) : Integrable (fejerHat H) := by
  have hc : Real.pi * H ≠ 0 := by positivity
  have hbase : Integrable fun u : ℝ => 2 / (1 + u ^ 2) := by
    have h := integrable_inv_one_add_sq.const_mul (2 : ℝ)
    refine h.congr (Filter.Eventually.of_forall fun u => ?_)
    change (2 : ℝ) * (1 + u ^ 2)⁻¹ = 2 / (1 + u ^ 2)
    rw [div_eq_mul_inv]
  have hdom : Integrable fun ξ : ℝ => 2 / (1 + (Real.pi * (H * ξ)) ^ 2) := by
    have h := (integrable_comp_mul_left_iff (fun u : ℝ => 2 / (1 + u ^ 2)) hc).mpr hbase
    refine h.congr (Filter.Eventually.of_forall fun ξ => ?_)
    change (2 : ℝ) / (1 + (Real.pi * H * ξ) ^ 2) = 2 / (1 + (Real.pi * (H * ξ)) ^ 2)
    ring
  refine Integrable.mono' hdom (measurable_fejerHat H).aestronglyMeasurable
    (Filter.Eventually.of_forall fun ξ => ?_)
  rw [Real.norm_eq_abs, abs_of_nonneg (fejerHat_nonneg H ξ)]
  exact fejerHat_le_two_div H ξ

theorem fejerHat_neg (H ξ : ℝ) : fejerHat H (-ξ) = fejerHat H ξ := by
  rw [fejerHat, fejerHat]
  rcases eq_or_ne ξ 0 with h0 | h0
  · subst h0
    simp
  · rw [ite_eq_right (neg_ne_zero.mpr h0), ite_eq_right h0]
    rw [show H * -ξ = -(H * ξ) by ring, show Real.pi * -(H * ξ) = -(Real.pi * (H * ξ)) by ring,
      Real.sin_neg, neg_div_neg_eq]


open MeasureTheory in
/-- **Fourier inversion for the Fejer pair**: `𝓕 hat kappa_H = kappa_H`.

Both members of the pair are continuous and integrable, so inversion applies; the transform rather
than the inverse transform appears on the left because both are even. This is what lets the
multiplier be moved from one side of a pairing to the other. -/
theorem fourier_fejerHat {H : ℝ} (hH : 0 < H) (h : ℝ) :
    𝓕 (fun ξ : ℝ => ((fejerHat H ξ : ℝ) : ℂ)) h = ((fejer H h : ℝ) : ℂ) := by
  have hfc : Continuous fun t : ℝ => ((fejer H t : ℝ) : ℂ) :=
    Complex.continuous_ofReal.comp continuous_fejer
  have hfi : Integrable fun t : ℝ => ((fejer H t : ℝ) : ℂ) := (integrable_fejer hH).ofReal
  have hFeq : (𝓕 fun t : ℝ => ((fejer H t : ℝ) : ℂ))
      = fun ξ : ℝ => ((fejerHat H ξ : ℝ) : ℂ) := funext fun ξ => fourier_fejer hH ξ
  have hFi : Integrable (𝓕 fun t : ℝ => ((fejer H t : ℝ) : ℂ)) := by
    rw [hFeq]
    exact (integrable_fejerHat hH).ofReal
  have hinv := hfc.fourierInv_fourier_eq hfi hFi
  rw [hFeq] at hinv
  have hat := congrFun hinv (-h)
  rw [Real.fourierInv_eq_fourier_neg, neg_neg] at hat
  rw [hat, fejer_neg]


/-! ### The Fejer-weighted autocorrelation as a frequency energy

Blueprint `lem:degree-lowering-zero`, the `s = 2` endpoint: "Plancherel and the identity
`hat kappa_H(xi) = (sin(pi H xi) / (pi H xi))^2` identify the local `U^2` expression with a
nonnegative weighted partial-frequency energy."  In one variable the statement is
    ∫ kappa_H(h) ∫ psi(t + h) conj(psi t) dt dh = ∫ hat kappa_H(xi) ‖hat psi(xi)‖^2 dxi,

and the right-hand side is manifestly nonnegative by `Auto.fejerHat_nonneg`. The inner integral is
the autocorrelation of `psi`; this section builds it and its transform. -/

/-- The autocorrelation `A_psi(h) = ∫ psi(t + h) conj(psi t) dt`. -/
noncomputable def autocorr (ψ : ℝ → ℂ) (h : ℝ) : ℂ :=
  ∫ t : ℝ, ψ (t + h) * (starRingEnd ℂ) (ψ t)

open MeasureTheory in
/-- The autocorrelation integrand is integrable on the product: its `L^1` norm is `‖psi‖_1^2`. -/
theorem integrable_autocorr_prod {ψ : ℝ → ℂ} (hc : Continuous ψ) (hi : Integrable ψ) :
    Integrable (fun z : ℝ × ℝ => ψ (z.2 + z.1) * (starRingEnd ℂ) (ψ z.2))
      (volume.prod volume) := by
  have hmeas : Measurable fun z : ℝ × ℝ => ψ (z.2 + z.1) * (starRingEnd ℂ) (ψ z.2) := by
    fun_prop
  have hne : (∫⁻ u : ℝ, ‖ψ u‖ₑ) ≠ ⊤ := hi.hasFiniteIntegral.ne
  refine ⟨hmeas.aestronglyMeasurable, ?_⟩
  rw [hasFiniteIntegral_iff_enorm]
  have hstep : (∫⁻ z : ℝ × ℝ, ‖ψ (z.2 + z.1) * (starRingEnd ℂ) (ψ z.2)‖ₑ
        ∂(volume.prod volume))
      = (∫⁻ u : ℝ, ‖ψ u‖ₑ) * ∫⁻ u : ℝ, ‖ψ u‖ₑ := by
    calc (∫⁻ z : ℝ × ℝ, ‖ψ (z.2 + z.1) * (starRingEnd ℂ) (ψ z.2)‖ₑ ∂(volume.prod volume))
        = ∫⁻ z : ℝ × ℝ, ‖ψ (z.2 + z.1)‖ₑ * ‖ψ z.2‖ₑ ∂(volume.prod volume) := by
          refine lintegral_congr fun z => ?_
          simp [enorm_mul]
      _ = ∫⁻ t : ℝ, ∫⁻ h : ℝ, ‖ψ (t + h)‖ₑ * ‖ψ t‖ₑ := lintegral_prod_symm' _ (by fun_prop)
      _ = ∫⁻ t : ℝ, (∫⁻ u : ℝ, ‖ψ u‖ₑ) * ‖ψ t‖ₑ := by
          refine lintegral_congr fun t => ?_
          rw [lintegral_mul_const' _ _ (enorm_ne_top)]
          congr 1
          exact lintegral_add_left_eq_self (fun u : ℝ => ‖ψ u‖ₑ) t
      _ = (∫⁻ u : ℝ, ‖ψ u‖ₑ) * ∫⁻ t : ℝ, ‖ψ t‖ₑ := lintegral_const_mul' _ _ hne
  rw [hstep]
  exact ENNReal.mul_lt_top (lt_top_iff_ne_top.mpr hne) (lt_top_iff_ne_top.mpr hne)

open MeasureTheory in
theorem integrable_autocorr {ψ : ℝ → ℂ} (hc : Continuous ψ) (hi : Integrable ψ) :
    Integrable (autocorr ψ) :=
  (integrable_autocorr_prod hc hi).integral_prod_left


open MeasureTheory in
/-- **The transform of the autocorrelation is the frequency energy**: `hat A_psi = ‖hat psi‖^2`.

This is the Plancherel input of the `s = 2` endpoint of blueprint `lem:degree-lowering-zero`. It is
proved directly from Fubini and the translation invariance of Lebesgue measure rather than through
the convolution theorem, so no new import is needed. -/
theorem fourier_autocorr {ψ : ℝ → ℂ} (hc : Continuous ψ) (hi : Integrable ψ) (ξ : ℝ) :
    𝓕 (autocorr ψ) ξ = (‖𝓕 ψ ξ‖ : ℂ) ^ 2 := by
  set c : ℂ := ((-(2 * Real.pi * ξ) : ℝ) : ℂ) * Complex.I with hcdef
  have hnorm1 : ∀ t : ℝ, ‖Complex.exp (c * (t : ℂ))‖ = 1 := by
    intro t
    rw [Complex.norm_exp]
    have hre : (c * (t : ℂ)).re = 0 := by
      rw [hcdef]
      simp [Complex.mul_re, Complex.mul_im]
    rw [hre, Real.exp_zero]
  have hconjc : ∀ t : ℝ, (starRingEnd ℂ) (c * (t : ℂ)) = -(c * (t : ℂ)) := by
    intro t
    rw [hcdef, map_mul, map_mul, Complex.conj_ofReal, Complex.conj_I, Complex.conj_ofReal]
    ring
  have hexp : ∀ a b : ℝ, Complex.exp (c * ((a + b : ℝ) : ℂ))
      = Complex.exp (c * a) * Complex.exp (c * b) := by
    intro a b
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  have hF : ∀ φ : ℝ → ℂ, 𝓕 φ ξ = ∫ t : ℝ, Complex.exp (c * t) * φ t := by
    intro φ
    rw [Real.fourier_real_eq_integral_exp_smul]
    refine integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
    change Complex.exp ((↑(-2 * Real.pi * t * ξ) : ℂ) * Complex.I) • φ t
        = Complex.exp (c * t) * φ t
    rw [smul_eq_mul]
    congr 2
    rw [hcdef]
    push_cast
    ring
  -- the shift identity
  have hshift : ∀ t : ℝ, (∫ h : ℝ, Complex.exp (c * h) * ψ (t + h))
      = Complex.exp (-(c * (t : ℂ))) * 𝓕 ψ ξ := by
    intro t
    have hkey : (∫ h : ℝ, Complex.exp (c * ((h + t : ℝ) : ℂ)) * ψ (h + t)) = 𝓕 ψ ξ := by
      rw [hF ψ]
      exact integral_add_right_eq_self (fun u : ℝ => Complex.exp (c * u) * ψ u) t
    have hpull : (∫ h : ℝ, Complex.exp (c * ((h + t : ℝ) : ℂ)) * ψ (h + t))
        = Complex.exp (c * (t : ℂ)) * ∫ h : ℝ, Complex.exp (c * h) * ψ (t + h) := by
      rw [← integral_const_mul]
      refine integral_congr_ae (Filter.Eventually.of_forall fun h => ?_)
      change Complex.exp (c * ((h + t : ℝ) : ℂ)) * ψ (h + t)
          = Complex.exp (c * (t : ℂ)) * (Complex.exp (c * h) * ψ (t + h))
      rw [hexp h t, show ψ (h + t) = ψ (t + h) from by rw [add_comm]]
      ring
    rw [hpull] at hkey
    have hmul : Complex.exp (-(c * (t : ℂ))) * (Complex.exp (c * (t : ℂ))
        * ∫ h : ℝ, Complex.exp (c * h) * ψ (t + h))
        = Complex.exp (-(c * (t : ℂ))) * 𝓕 ψ ξ := by rw [hkey]
    rw [← mul_assoc, ← Complex.exp_add, neg_add_cancel, Complex.exp_zero, one_mul] at hmul
    exact hmul
  have hprodi : Integrable (fun z : ℝ × ℝ =>
      Complex.exp (c * (z.1 : ℂ)) * (ψ (z.2 + z.1) * (starRingEnd ℂ) (ψ z.2)))
      (volume.prod volume) :=
    (integrable_autocorr_prod hc hi).bdd_mul (by fun_prop)
      (Filter.Eventually.of_forall fun z => le_of_eq (hnorm1 z.1))
  calc 𝓕 (autocorr ψ) ξ
      = ∫ h : ℝ, Complex.exp (c * h) * autocorr ψ h := hF _
    _ = ∫ h : ℝ, ∫ t : ℝ, Complex.exp (c * h) * (ψ (t + h) * (starRingEnd ℂ) (ψ t)) := by
        refine integral_congr_ae (Filter.Eventually.of_forall fun h => ?_)
        change Complex.exp (c * h) * autocorr ψ h
            = ∫ t : ℝ, Complex.exp (c * h) * (ψ (t + h) * (starRingEnd ℂ) (ψ t))
        rw [autocorr, integral_const_mul]
    _ = ∫ t : ℝ, ∫ h : ℝ, Complex.exp (c * h) * (ψ (t + h) * (starRingEnd ℂ) (ψ t)) :=
        integral_integral_swap hprodi
    _ = ∫ t : ℝ, (starRingEnd ℂ) (ψ t) * Complex.exp (-(c * (t : ℂ))) * 𝓕 ψ ξ := by
        refine integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
        change (∫ h : ℝ, Complex.exp (c * h) * (ψ (t + h) * (starRingEnd ℂ) (ψ t)))
            = (starRingEnd ℂ) (ψ t) * Complex.exp (-(c * (t : ℂ))) * 𝓕 ψ ξ
        have hin : (∫ h : ℝ, Complex.exp (c * h) * (ψ (t + h) * (starRingEnd ℂ) (ψ t)))
            = (starRingEnd ℂ) (ψ t) * ∫ h : ℝ, Complex.exp (c * h) * ψ (t + h) := by
          rw [← integral_const_mul]
          refine integral_congr_ae (Filter.Eventually.of_forall fun h => ?_)
          change Complex.exp (c * h) * (ψ (t + h) * (starRingEnd ℂ) (ψ t))
              = (starRingEnd ℂ) (ψ t) * (Complex.exp (c * h) * ψ (t + h))
          ring
        rw [hin, hshift t, ← mul_assoc]
    _ = (∫ t : ℝ, (starRingEnd ℂ) (ψ t) * Complex.exp (-(c * (t : ℂ)))) * 𝓕 ψ ξ := by
        rw [← integral_mul_const]
    _ = (starRingEnd ℂ) (𝓕 ψ ξ) * 𝓕 ψ ξ := by
        congr 1
        rw [hF ψ, ← integral_conj]
        refine integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
        change (starRingEnd ℂ) (ψ t) * Complex.exp (-(c * (t : ℂ)))
            = (starRingEnd ℂ) (Complex.exp (c * t) * ψ t)
        rw [map_mul, ← Complex.exp_conj, hconjc t]
        ring
    _ = (‖𝓕 ψ ξ‖ : ℂ) ^ 2 := by
        rw [mul_comm]
        exact Complex.mul_conj' _


open MeasureTheory in
/-- **The multiplication formula** `∫ (𝓕 f) g = ∫ f (𝓕 g)` on the line: the Fourier transform is
symmetric for the bilinear pairing. Both sides need only integrability, and the proof is Fubini
against the symmetric kernel `e(-vx)`. -/
theorem integral_fourier_mul_comm {f g : ℝ → ℂ} (hf : Integrable f) (hg : Integrable g) :
    (∫ x : ℝ, 𝓕 f x * g x) = ∫ v : ℝ, f v * 𝓕 g v := by
  have hk : ∀ v x : ℝ, Complex.exp ((↑(-2 * Real.pi * v * x) : ℂ) * Complex.I)
      = Complex.exp ((↑(-2 * Real.pi * x * v) : ℂ) * Complex.I) := by
    intro v x
    congr 2
    push_cast
    ring
  have hnorm : ∀ v x : ℝ, ‖Complex.exp ((↑(-2 * Real.pi * v * x) : ℂ) * Complex.I)‖ = 1 := by
    intro v x
    rw [Complex.norm_exp]
    have hre : ((↑(-2 * Real.pi * v * x) : ℂ) * Complex.I).re = 0 := by
      simp [Complex.mul_re, Complex.mul_im]
    rw [hre, Real.exp_zero]
  have hbase : Integrable (fun z : ℝ × ℝ => g z.1 * f z.2) (volume.prod volume) :=
    hg.mul_prod hf
  have hint : Integrable (fun z : ℝ × ℝ =>
      Complex.exp ((↑(-2 * Real.pi * z.2 * z.1) : ℂ) * Complex.I) * (f z.2 * g z.1))
      (volume.prod volume) := by
    have h := hbase.bdd_mul (f := fun z : ℝ × ℝ =>
        Complex.exp ((↑(-2 * Real.pi * z.2 * z.1) : ℂ) * Complex.I)) (by fun_prop)
      (Filter.Eventually.of_forall fun z => le_of_eq (hnorm z.2 z.1))
    refine h.congr (Filter.Eventually.of_forall fun z => ?_)
    change Complex.exp ((↑(-2 * Real.pi * z.2 * z.1) : ℂ) * Complex.I) * (g z.1 * f z.2)
        = Complex.exp ((↑(-2 * Real.pi * z.2 * z.1) : ℂ) * Complex.I) * (f z.2 * g z.1)
    ring
  calc (∫ x : ℝ, 𝓕 f x * g x)
      = ∫ x : ℝ, ∫ v : ℝ,
          Complex.exp ((↑(-2 * Real.pi * v * x) : ℂ) * Complex.I) * (f v * g x) := by
        refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
        change 𝓕 f x * g x
            = ∫ v : ℝ, Complex.exp ((↑(-2 * Real.pi * v * x) : ℂ) * Complex.I) * (f v * g x)
        rw [Real.fourier_real_eq_integral_exp_smul, ← integral_mul_const]
        refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
        change Complex.exp ((↑(-2 * Real.pi * v * x) : ℂ) * Complex.I) • f v * g x
            = Complex.exp ((↑(-2 * Real.pi * v * x) : ℂ) * Complex.I) * (f v * g x)
        rw [smul_eq_mul]
        ring
    _ = ∫ v : ℝ, ∫ x : ℝ,
          Complex.exp ((↑(-2 * Real.pi * v * x) : ℂ) * Complex.I) * (f v * g x) :=
        integral_integral_swap hint
    _ = ∫ v : ℝ, f v * 𝓕 g v := by
        refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
        change (∫ x : ℝ, Complex.exp ((↑(-2 * Real.pi * v * x) : ℂ) * Complex.I) * (f v * g x))
            = f v * 𝓕 g v
        rw [Real.fourier_real_eq_integral_exp_smul, ← integral_const_mul]
        refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
        change Complex.exp ((↑(-2 * Real.pi * v * x) : ℂ) * Complex.I) * (f v * g x)
            = f v * (Complex.exp ((↑(-2 * Real.pi * x * v) : ℂ) * Complex.I) • g x)
        rw [smul_eq_mul, ← hk v x]
        ring

open MeasureTheory in
/-- **The Fejer-weighted autocorrelation is a frequency energy.**

Blueprint `lem:degree-lowering-zero`, the `s = 2` endpoint, in one variable:
    ∫ kappa_H(h) A_psi(h) dh = ∫ hat kappa_H(xi) ‖hat psi(xi)‖^2 dxi.

The right-hand side is a *nonnegative* weighted partial-frequency energy, by
`Auto.fejerHat_nonneg`; that is exactly what the major-frequency restriction is applied to. -/
theorem integral_fejer_autocorr {H : ℝ} (hH : 0 < H) {ψ : ℝ → ℂ}
    (hc : Continuous ψ) (hi : Integrable ψ) :
    (∫ h : ℝ, ((fejer H h : ℝ) : ℂ) * autocorr ψ h)
      = ∫ ξ : ℝ, ((fejerHat H ξ : ℝ) : ℂ) * (‖𝓕 ψ ξ‖ : ℂ) ^ 2 := by
  have hki : Integrable fun ξ : ℝ => ((fejerHat H ξ : ℝ) : ℂ) := (integrable_fejerHat hH).ofReal
  have hai : Integrable (autocorr ψ) := integrable_autocorr hc hi
  have hmain := integral_fourier_mul_comm hki hai
  have hL : (∫ x : ℝ, 𝓕 (fun ξ : ℝ => ((fejerHat H ξ : ℝ) : ℂ)) x * autocorr ψ x)
      = ∫ h : ℝ, ((fejer H h : ℝ) : ℂ) * autocorr ψ h := by
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    change 𝓕 (fun ξ : ℝ => ((fejerHat H ξ : ℝ) : ℂ)) x * autocorr ψ x
        = ((fejer H x : ℝ) : ℂ) * autocorr ψ x
    rw [fourier_fejerHat hH x]
  have hR : (∫ v : ℝ, ((fejerHat H v : ℝ) : ℂ) * 𝓕 (autocorr ψ) v)
      = ∫ ξ : ℝ, ((fejerHat H ξ : ℝ) : ℂ) * (‖𝓕 ψ ξ‖ : ℂ) ^ 2 := by
    refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
    change ((fejerHat H v : ℝ) : ℂ) * 𝓕 (autocorr ψ) v
        = ((fejerHat H v : ℝ) : ℂ) * (‖𝓕 ψ v‖ : ℂ) ^ 2
    rw [fourier_autocorr hc hi v]
  rw [← hL, ← hR]
  exact hmain


/-! ## Blueprint `lem:projection-off-diagonal`: decay of the projection kernel

`K_R = F^{-1}(eta(./R))` is `k_R(u) = R eta-check(R u)` with `eta-check` a Schwartz function
(`Auto.etaKerS`), so the blueprint's `|K_R(u)| <= C_m R (1 + R|u|)^{-m}` is just rapid decay,
rescaled. Both statements below are written multiplicatively, so no negative power appears. -/

/-- Rapid decay of `eta-check` in the form the rescaling needs. -/
theorem etaKer_decay (m : ℕ) : ∃ C : ℝ, 0 ≤ C ∧ ∀ v : ℝ, (1 + |v|) ^ m * ‖etaKer v‖ ≤ C := by
  obtain ⟨C0, hC0, h0⟩ := etaKerS.decay 0 0
  obtain ⟨Cm, hCm, hm⟩ := etaKerS.decay m 0
  refine ⟨2 ^ m * (C0 + Cm), by positivity, fun v => ?_⟩
  have hn0 : ‖etaKer v‖ ≤ C0 := by
    have h := h0 v
    rwa [pow_zero, one_mul, norm_iteratedFDeriv_zero] at h
  have hnm : |v| ^ m * ‖etaKer v‖ ≤ Cm := by
    have h := hm v
    rwa [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at h
  have hv0 : (0 : ℝ) ≤ |v| := abs_nonneg v
  rcases le_or_gt |v| 1 with hle | hgt
  · have hstep : (1 + |v|) ^ m ≤ 2 ^ m := by
      refine pow_le_pow_left₀ (by linarith) (by linarith) m
    calc (1 + |v|) ^ m * ‖etaKer v‖ ≤ 2 ^ m * ‖etaKer v‖ :=
          mul_le_mul_of_nonneg_right hstep (norm_nonneg _)
      _ ≤ 2 ^ m * (C0 + Cm) := by
          refine mul_le_mul_of_nonneg_left ?_ (by positivity)
          linarith
  · have hstep : (1 + |v|) ^ m ≤ 2 ^ m * |v| ^ m := by
      rw [← mul_pow]
      exact pow_le_pow_left₀ (by linarith) (by linarith) m
    calc (1 + |v|) ^ m * ‖etaKer v‖ ≤ 2 ^ m * |v| ^ m * ‖etaKer v‖ :=
          mul_le_mul_of_nonneg_right hstep (norm_nonneg _)
      _ = 2 ^ m * (|v| ^ m * ‖etaKer v‖) := by ring
      _ ≤ 2 ^ m * (C0 + Cm) := by
          refine mul_le_mul_of_nonneg_left ?_ (by positivity)
          linarith

/-- **The first estimate of blueprint `lem:projection-off-diagonal`**:
`|k_R(u)| ≤ C_m R (1 + R|u|)^{-m}`, uniformly in `R > 0`. -/
theorem projKernel_decay (m : ℕ) : ∃ C : ℝ, 0 ≤ C ∧ ∀ {R : ℝ}, 0 < R → ∀ u : ℝ,
    (1 + R * |u|) ^ m * ‖projKernel R u‖ ≤ C * R := by
  obtain ⟨C, hC, h⟩ := etaKer_decay m
  refine ⟨C, hC, fun {R} hR u => ?_⟩
  have habs : |R * u| = R * |u| := by rw [abs_mul, abs_of_pos hR]
  have hnorm : ‖projKernel R u‖ = R * ‖etaKer (R * u)‖ := by
    rw [projKernel, norm_mul, Complex.norm_real, Real.norm_of_nonneg hR.le]
  rw [hnorm, ← habs]
  calc (1 + |R * u|) ^ m * (R * ‖etaKer (R * u)‖)
      = R * ((1 + |R * u|) ^ m * ‖etaKer (R * u)‖) := by ring
    _ ≤ R * C := mul_le_mul_of_nonneg_left (h (R * u)) hR.le
    _ = C * R := mul_comm _ _


open MeasureTheory in
/-- Every weighted moment of `eta-check` is integrable: `(1 + |v|)^m <= 2^m (1 + |v|^m)` and both
pieces are Schwartz moments. -/
theorem integrable_etaKer_mom (m : ℕ) :
    Integrable fun v : ℝ => (1 + |v|) ^ m * ‖etaKer v‖ := by
  have h0 : Integrable fun v : ℝ => ‖v‖ ^ 0 * ‖etaKerS v‖ :=
    etaKerS.integrable_pow_mul volume 0
  have hm : Integrable fun v : ℝ => ‖v‖ ^ m * ‖etaKerS v‖ :=
    etaKerS.integrable_pow_mul volume m
  have hdom : Integrable fun v : ℝ => 2 ^ m * (‖v‖ ^ 0 * ‖etaKerS v‖ + ‖v‖ ^ m * ‖etaKerS v‖) :=
    (h0.add hm).const_mul _
  refine Integrable.mono' hdom
    (((continuous_const.add continuous_abs).pow m).mul
      etaKer_continuous.norm).aestronglyMeasurable
    (Filter.Eventually.of_forall fun v => ?_)
  rw [Real.norm_eq_abs, abs_of_nonneg (by positivity : (0 : ℝ) ≤ (1 + |v|) ^ m * ‖etaKer v‖)]
  have hpow : (1 + |v|) ^ m ≤ 2 ^ m * (1 ^ m + |v| ^ m) :=
    add_pow_le_two_pow_mul zero_le_one (abs_nonneg v) m
  have hstep : (1 + |v|) ^ m * ‖etaKer v‖
      ≤ 2 ^ m * (1 ^ m + |v| ^ m) * ‖etaKer v‖ :=
    mul_le_mul_of_nonneg_right hpow (norm_nonneg _)
  refine hstep.trans (le_of_eq ?_)
  rw [Real.norm_eq_abs]
  change 2 ^ m * (1 ^ m + |v| ^ m) * ‖etaKer v‖
      = 2 ^ m * (|v| ^ 0 * ‖etaKer v‖ + |v| ^ m * ‖etaKer v‖)
  ring

open MeasureTheory in
/-- The `m`-th weighted moment of `eta-check`; finite by `Auto.integrable_etaKer_mom`. -/
noncomputable def etaKerMom (m : ℕ) : ℝ := ∫ v : ℝ, (1 + |v|) ^ m * ‖etaKer v‖

theorem etaKerMom_nonneg (m : ℕ) : 0 ≤ etaKerMom m :=
  MeasureTheory.integral_nonneg fun v => by positivity

open MeasureTheory in
theorem integrable_projKernel_mom {R : ℝ} (hR : 0 < R) (m : ℕ) :
    Integrable fun u : ℝ => (1 + R * |u|) ^ m * ‖projKernel R u‖ := by
  have hg := (integrable_comp_mul_left_iff
      (fun v : ℝ => (1 + |v|) ^ m * ‖etaKer v‖) hR.ne').mpr (integrable_etaKer_mom m)
  refine (hg.const_mul R).congr (Filter.Eventually.of_forall fun u => ?_)
  change R * ((1 + |R * u|) ^ m * ‖etaKer (R * u)‖)
      = (1 + R * |u|) ^ m * ‖projKernel R u‖
  rw [projKernel, norm_mul, Complex.norm_real, Real.norm_of_nonneg hR.le,
    abs_mul, abs_of_pos hR]
  ring

open MeasureTheory in
/-- The weighted moment of the rescaled kernel is `R`-independent, as the substitution `v = R u`
shows. This is the quantitative form of the decay in `Auto.projKernel_decay`. -/
theorem integral_projKernel_mom {R : ℝ} (hR : 0 < R) (m : ℕ) :
    (∫ u : ℝ, (1 + R * |u|) ^ m * ‖projKernel R u‖) = etaKerMom m := by
  have hrw : ∀ u : ℝ, (1 + R * |u|) ^ m * ‖projKernel R u‖
      = R * ((1 + |R * u|) ^ m * ‖etaKer (R * u)‖) := by
    intro u
    rw [projKernel, norm_mul, Complex.norm_real, Real.norm_of_nonneg hR.le,
      abs_mul, abs_of_pos hR]
    ring
  simp only [hrw]
  rw [integral_const_mul,
    Measure.integral_comp_mul_left (fun v : ℝ => (1 + |v|) ^ m * ‖etaKer v‖) R,
    abs_of_pos (inv_pos.mpr hR), smul_eq_mul, ← mul_assoc, mul_inv_cancel₀ hR.ne', one_mul]
  rfl

open MeasureTheory in
/-- **The off-diagonal tail of the projection kernel**, blueprint `lem:projection-off-diagonal`:
outside `|u| <= d` the kernel carries mass at most `C_m (1 + R d)^{-m}`, uniformly in `R`.
Stated multiplicatively, so no negative power appears. -/
theorem integral_projKernel_tail_le {R d : ℝ} (hR : 0 < R) (hd : 0 ≤ d) (m : ℕ) :
    (∫ u in {u : ℝ | d ≤ |u|}, ‖projKernel R u‖) * (1 + R * d) ^ m ≤ etaKerMom m := by
  have hset : MeasurableSet {u : ℝ | d ≤ |u|} :=
    measurableSet_le measurable_const continuous_abs.measurable
  have hmom := integrable_projKernel_mom hR m
  have hnorm : Integrable fun u : ℝ => ‖projKernel R u‖ := (projKernel_integrable hR).norm
  rw [← integral_mul_const]
  calc (∫ u in {u : ℝ | d ≤ |u|}, ‖projKernel R u‖ * (1 + R * d) ^ m)
      ≤ ∫ u in {u : ℝ | d ≤ |u|}, (1 + R * |u|) ^ m * ‖projKernel R u‖ := by
        refine setIntegral_mono_on ((hnorm.mul_const _).integrableOn) hmom.integrableOn hset
          fun u hu => ?_
        have hu' : d ≤ |u| := hu
        have hle : (1 + R * d) ^ m ≤ (1 + R * |u|) ^ m :=
          pow_le_pow_left₀ (by positivity)
            (by nlinarith [mul_le_mul_of_nonneg_left hu' hR.le]) m
        calc ‖projKernel R u‖ * (1 + R * d) ^ m
            ≤ ‖projKernel R u‖ * (1 + R * |u|) ^ m :=
              mul_le_mul_of_nonneg_left hle (norm_nonneg _)
          _ = (1 + R * |u|) ^ m * ‖projKernel R u‖ := mul_comm _ _
    _ ≤ ∫ u : ℝ, (1 + R * |u|) ^ m * ‖projKernel R u‖ :=
        setIntegral_le_integral hmom (Filter.Eventually.of_forall fun u => by positivity)
    _ = etaKerMom m := integral_projKernel_mom hR m

end Auto
