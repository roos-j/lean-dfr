exponents of the adjoint are `r_0 = 6`, `r_{j'} = 40/7`, `r_k = 6`. -/
theorem erase_fin3_eq {j m k : Fin 3} (hjm : j ≠ m) (hkm : k ≠ m) (hjk : j ≠ k) :
    (Finset.univ : Finset (Fin 3)).erase j = {m, k} := by
  ext i
  simp only [Finset.mem_erase, Finset.mem_univ, and_true, Finset.mem_insert,
    Finset.mem_singleton]
  constructor
  · intro hi
    by_cases him : i = m
    · exact Or.inl him
    · exact Or.inr (fin3_third hjm hkm hjk hi him)
  · rintro (rfl | rfl)
    · exact Ne.symm hjm
    · exact Ne.symm hjk

theorem targetV_at_j (j m : Fin 3) : ((targetV j m j)⁻¹ : ℝ) = 2 := by
  simp only [targetV]
  norm_num

theorem targetV_at_m {j m : Fin 3} (hjm : j ≠ m) : ((targetV j m m)⁻¹ : ℝ) = 40 / 7 := by
  simp only [targetV, ite_eq_right (Ne.symm hjm)]
  norm_num

theorem targetV_at_k {j m k : Fin 3} (_hjm : j ≠ m) (hkm : k ≠ m) (hjk : j ≠ k) :
    ((targetV j m k)⁻¹ : ℝ) = 6 := by
  simp only [targetV, ite_eq_right (Ne.symm hjk), ite_eq_right hkm]
  norm_num

theorem adjShift_update (j : Fin 3) (f0 : E3 → ℂ) (f : Fin 3 → E3 → ℂ) (h : E3 → ℂ)
    (y : E3) (t : ℝ) : adjShift j f0 (Function.update f j h) y t = adjShift j f0 f y t := by
  simp only [adjShift]
  refine congrArg _ (Finset.prod_congr rfl fun i hi => ?_)
  rw [Function.update_of_ne (Finset.ne_of_mem_erase hi)]

theorem Astar_update (N : ℝ) (j : Fin 3) (f0 : E3 → ℂ) (f : Fin 3 → E3 → ℂ) (h : E3 → ℂ) :
    Astar N j f0 (Function.update f j h) = Astar N j f0 f := by
  funext y
  simp only [Astar, adjShift_update]

open MeasureTheory in
/-- **Blueprint `cor:kosz-53-internal`**, the internal proof of Corollary 5.3 of
Kosz-Mirek-Peluse-Wan-Wright in the real monomial case `k = 3`:
`‖A_N^{*j}(g)‖_{L^2} ≤ C N^{-1/20} ‖g₀‖_{L^6} ‖g_{j'}‖_{L^{40/7}} ‖g_k‖_{L^6}`, with
`1/6 + 7/40 + 1/6 = 61/120 = 1/r`, `1 < r = 120/61 < 2` and `6 (1/r - 1/2) = 1/20`. -/
theorem kosz53_internal {j m k : Fin 3} (hjm : j ≠ m) (hkm : k ≠ m) (hjk : j ≠ k) :
    ∃ C : ℝ≥0∞, C ≠ ⊤ ∧ ∀ N : ℝ, 0 < N → ∀ g0 : E3 → ℂ, Nice g0 →
      ∀ g : Fin 3 → E3 → ℂ, (∀ i, Nice (g i)) →
        eLpNorm (Astar N j g0 g) (ENNReal.ofReal 2) volume
          ≤ ENNReal.ofReal (N ^ (-(1 : ℝ) / 20))
            * (C * (eLpNorm g0 (ENNReal.ofReal 6) volume
                * eLpNorm (g m) (ENNReal.ofReal (40 / 7)) volume
                * eLpNorm (g k) (ENNReal.ofReal 6) volume)) := by
  obtain ⟨C, hCtop, hC⟩ := strong_real_improving' hjm hkm hjk
  refine ⟨C, hCtop, ?_⟩
  intro N hN g0 hg0 g hg
  obtain ⟨Cb, hCb0, hCb⟩ := exists_uniform_bound hg
  obtain ⟨C0, hC0⟩ := hg0.bounded
  have hgc : ∀ i, Continuous (g i) := fun i => (hg i).continuous
  have hfin : eLpNorm (Astar N j g0 g) (ENNReal.ofReal 2) volume ≠ ⊤ :=
    eLpNorm_Astar_two_ne_top hN j hg0.continuous hg0.integrable hC0 hCb0 hCb
  refine eLpNorm_le_of_pairing_bound (p := 2) (p' := 2) one_lt_two (by norm_num)
    (continuous_Astar N j hg0.continuous hgc) hfin ?_
  intro h hh
  set f : Fin 3 → E3 → ℂ := Function.update g j h with hfdef
  have hfNice : ∀ i, Nice (f i) := by
    intro i
    by_cases hij : i = j
    · subst hij
      rw [hfdef, Function.update_self]
      exact hh
    · rw [hfdef, Function.update_of_ne hij]
      exact hg i
  have hfc : ∀ i, Continuous (f i) := fun i => (hfNice i).continuous
  obtain ⟨Cf, hCf0, hCf⟩ := exists_uniform_bound hfNice
  have hAstar : Astar N j g0 f = Astar N j g0 g := by rw [hfdef, Astar_update]
  -- the pairing is the adjoint pairing, conjugated
  have hswap : ‖∫ y : E3, Astar N j g0 g y * conj (h y)‖ₑ
      = ‖∫ y : E3, f j y * conj (Astar N j g0 f y)‖ₑ := by
    have hj : f j = h := by rw [hfdef, Function.update_self]
    have hconj : (∫ y : E3, f j y * conj (Astar N j g0 f y))
        = conj (∫ y : E3, Astar N j g0 g y * conj (h y)) := by
      rw [← integral_conj, hj, hAstar]
      refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
      simp [mul_comm]
    rw [hconj, ← ofReal_norm, ← ofReal_norm, RCLike.norm_conj]
  have hLam : (∫ x : E3, A N f x * conj (g0 x))
      = ∫ y : E3, f j y * conj (Astar N j g0 f y) :=
    adjoint_identity hN j hg0.continuous hg0.integrable hfc hCf0 hCf
  -- the exponents of the three slots
  have hprod : (∏ i, eLpNorm (f i) (ENNReal.ofReal ((targetV j m i)⁻¹)) volume)
      = eLpNorm h (ENNReal.ofReal 2) volume
        * (eLpNorm (g m) (ENNReal.ofReal (40 / 7)) volume
          * eLpNorm (g k) (ENNReal.ofReal 6) volume) := by
    rw [← Finset.mul_prod_erase Finset.univ
        (fun i => eLpNorm (f i) (ENNReal.ofReal ((targetV j m i)⁻¹)) volume) (Finset.mem_univ j),
      erase_fin3_eq hjm hkm hjk, Finset.prod_pair (Ne.symm hkm), targetV_at_j,
      targetV_at_m hjm, targetV_at_k hjm hkm hjk, hfdef, Function.update_self,
      Function.update_of_ne (Ne.symm hjm), Function.update_of_ne (Ne.symm hjk)]
  have hAle := hC N hN f fun i => (hfc i).measurable
  rw [hprod] at hAle
  calc ‖∫ y : E3, Astar N j g0 g y * conj (h y)‖ₑ
      = ‖∫ x : E3, A N f x * conj (g0 x)‖ₑ := by rw [hswap, hLam]
    _ ≤ eLpNorm (A N f) (ENNReal.ofReal (6 / 5)) volume
        * eLpNorm g0 (ENNReal.ofReal 6) volume :=
        enorm_integral_mul_conj_le
          (ennreal_conj_exponent (by norm_num) (by norm_num) (by norm_num))
          (continuous_A hfc N).aestronglyMeasurable
          hg0.continuous.aestronglyMeasurable
    _ ≤ (ENNReal.ofReal (N ^ (-(1 : ℝ) / 20))
          * (C * (eLpNorm h (ENNReal.ofReal 2) volume
            * (eLpNorm (g m) (ENNReal.ofReal (40 / 7)) volume
              * eLpNorm (g k) (ENNReal.ofReal 6) volume))))
        * eLpNorm g0 (ENNReal.ofReal 6) volume := by
        gcongr
    _ = ENNReal.ofReal (N ^ (-(1 : ℝ) / 20))
          * (C * (eLpNorm g0 (ENNReal.ofReal 6) volume
              * eLpNorm (g m) (ENNReal.ofReal (40 / 7)) volume
              * eLpNorm (g k) (ENNReal.ofReal 6) volume))
        * eLpNorm h (ENNReal.ofReal 2) volume := by ring



/-! ### Blueprint `lem:fejer-vdc`: the Gowers-Cauchy-Schwarz step

"Repeated use of this inequality followed by Cauchy-Schwarz in all variables except a selected
function bounds every polynomial average ... by a finite power of a local uniformity norm of that
selected function, plus a boundary error."

Each application of `Auto.fejer_vdc'` squares the left side and adds one Fejer average on the
right, so after `s` applications the left side carries the exponent `2^s` and the right side is
the nested Fejer average `Auto.vdcAvg` of depth `s`. The powers are moved inside the successive
kernel averages by `Auto.pow_integral_fejer_le`, which is the Cauchy-Schwarz in the shift
variables; the boundary terms accumulate to a fixed multiple of `sum_i H_i / N`, which is the
"geometric multiple of `H/N`" of the blueprint. -/
theorem pow_two_pow_le_mul {y M : ℝ} (hy : 0 ≤ y) (hM : y ≤ M) (hM1 : 1 ≤ M) (s : ℕ) :
    y ^ (2 ^ s) ≤ M ^ (2 ^ s) * y := by
  obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero (by positivity : (0 : ℕ) < 2 ^ s).ne'
  rw [hm, pow_succ]
  refine mul_le_mul_of_nonneg_right ?_ hy
  calc y ^ m ≤ M ^ m := pow_le_pow_left₀ hy hM m
    _ ≤ M ^ (m + 1) := pow_le_pow_right₀ hM1 (Nat.le_succ m)

open MeasureTheory in
/-- **Blueprint `lem:fejer-vdc`, the Gowers-Cauchy-Schwarz step.** After `s` applications of
the Fejer van der Corput inequality the normalized average of a `1`-bounded measurable function,
raised to the power `2^s`, is bounded by a constant multiple of the nested Fejer average of depth
`s` of its iterated differences, plus a constant multiple of `sum_i H_i / N`. The two constants
depend only on `s`. -/
theorem exists_vdc_iterate : ∀ s : ℕ, ∃ A B : ℝ, 0 ≤ A ∧ 0 ≤ B ∧
    ∀ N c : ℝ, 0 < N → ∀ H : Fin s → ℝ, (∀ i, 0 < H i) → (∀ i, H i ≤ N / 4) →
      ∀ F : ℝ → ℂ, Measurable F → (∀ t, ‖F t‖ ≤ 1) →
        ‖N⁻¹ • ∫ t in c..(c + N), F t‖ ^ (2 ^ s)
          ≤ A * vdcAvg N c s H F + B * ∑ i, H i / N := by
  intro s
  induction s with
  | zero =>
      refine ⟨1, 0, zero_le_one, le_refl 0, ?_⟩
      intro N c _ H _ _ F _ _
      simp [vdcAvg_zero]
  | succ s ih =>
      obtain ⟨A, B, hA0, hB0, hAB⟩ := ih
      set P : ℝ := 2 ^ (2 ^ s) with hP
      set Q : ℝ := 4 ^ (2 ^ s) with hQ
      set R : ℝ := 3 ^ (2 ^ s) with hR
      have hPpos : (0 : ℝ) < P := by rw [hP]; positivity
      have hQpos : (0 : ℝ) < Q := by rw [hQ]; positivity
      have hRpos : (0 : ℝ) < R := by rw [hR]; positivity
      refine ⟨P * (Q * A), P * (Q * B) + P * (R * 12),
        mul_nonneg hPpos.le (mul_nonneg hQpos.le hA0),
        by positivity, ?_⟩
      intro N c hN H hHpos hHN F hFm hF
      have hH0pos : 0 < H 0 := hHpos 0
      -- the level-zero average of the first difference
      set g : ℝ → ℝ := fun h => ‖N⁻¹ • ∫ t in c..(c + N), rdiff h F t‖ with hgdef
      have hrdiffm : ∀ h : ℝ, Measurable (rdiff h F) := fun h => measurable_rdiff hFm h
      have hrdiffb : ∀ h t : ℝ, ‖rdiff h F t‖ ≤ 1 := fun h => norm_rdiff_le hF h
      have hjoint : Measurable fun p : ℝ × ℝ => rdiff p.1 F p.2 :=
        (hFm.comp (measurable_snd.add measurable_fst)).mul
          (Complex.continuous_conj.measurable.comp (hFm.comp measurable_snd))
      have hgm : Measurable g :=
        measurable_vdcAvg N c hN 0 Fin.elim0 (fun h : ℝ => rdiff h F) hjoint
      have hg0 : ∀ h : ℝ, 0 ≤ g h := fun h => norm_nonneg _
      have hg1 : ∀ h : ℝ, g h ≤ 1 := fun h =>
        vdcAvg_le_one N c hN 0 Fin.elim0 (fun i => i.elim0) (rdiff h F) (hrdiffm h) (hrdiffb h)
      -- the level-`s` nested average of the first difference
      set V : ℝ → ℝ := fun h => vdcAvg N c s (fun i => H i.succ) (rdiff h F) with hVdef
      have hVm : Measurable V :=
        measurable_vdcAvg N c hN s (fun i => H i.succ) (fun h : ℝ => rdiff h F) hjoint
      have hV0 : ∀ h : ℝ, 0 ≤ V h := fun h =>
        vdcAvg_nonneg N c s (fun i => H i.succ) (fun i => hHpos i.succ) _
      have hV1 : ∀ h : ℝ, V h ≤ 1 := fun h =>
        vdcAvg_le_one N c hN s (fun i => H i.succ) (fun i => hHpos i.succ) (rdiff h F)
          (hrdiffm h) (hrdiffb h)
      set S' : ℝ := ∑ i : Fin s, H i.succ / N with hS'
      have hS'0 : 0 ≤ S' := by
        rw [hS']
        exact Finset.sum_nonneg fun i _ => div_nonneg (hHpos i.succ).le hN.le
      set u : ℝ := H 0 / N with hu
      have hu0 : 0 ≤ u := div_nonneg hH0pos.le hN.le
      have hu3 : 12 * u ≤ 3 := by
        rw [hu, mul_div_assoc']
        rw [div_le_iff₀ hN]
        have := hHN 0
        linarith
      -- one application of the Fejér van der Corput inequality
      set J : ℝ := ∫ h : ℝ, fejer (H 0) h * g h with hJ
      have hJ0 : 0 ≤ J := by
        rw [hJ]
        exact integral_nonneg fun h => mul_nonneg (fejer_nonneg hH0pos h) (hg0 h)
      have hstep1 : ‖N⁻¹ • ∫ t in c..(c + N), F t‖ ^ 2 ≤ 4 * J + 12 * H 0 / N :=
        fejer_vdc' hFm hF hN hH0pos (hHN 0) c
      -- Cauchy-Schwarz moves the power inside the kernel average
      have hpow : J ^ (2 ^ s) ≤ ∫ h : ℝ, fejer (H 0) h * g h ^ (2 ^ s) :=
        pow_integral_fejer_le hH0pos s g hgm hg0 1 hg1
      -- the inductive hypothesis, applied to the first difference
      have hptwise : ∀ h : ℝ, g h ^ (2 ^ s) ≤ A * V h + B * S' := fun h =>
        hAB N c hN (fun i => H i.succ) (fun i => hHpos i.succ) (fun i => hHN i.succ)
          (rdiff h F) (hrdiffm h) (hrdiffb h)
      have hint1 : Integrable fun h : ℝ => fejer (H 0) h * g h ^ (2 ^ s) :=
        integrable_fejer_mul hH0pos (hgm.pow_const _) (M := 1) fun t => by
          rw [abs_of_nonneg (pow_nonneg (hg0 t) _)]
          exact pow_le_one₀ (hg0 t) (hg1 t)
      have hint2 : Integrable fun h : ℝ => fejer (H 0) h * (A * V h + B * S') :=
        integrable_fejer_mul hH0pos ((measurable_const.mul hVm).add measurable_const)
          (M := A + B * S') fun t => by
            rw [abs_of_nonneg (add_nonneg (mul_nonneg hA0 (hV0 t)) (mul_nonneg hB0 hS'0))]
            have : A * V t ≤ A * 1 := mul_le_mul_of_nonneg_left (hV1 t) hA0
            linarith
      have hint3 : Integrable fun h : ℝ => A * (fejer (H 0) h * V h) :=
        (integrable_fejer_mul hH0pos hVm (M := 1) fun t => by
          rw [abs_of_nonneg (hV0 t)]; exact hV1 t).const_mul A
      have hint4 : Integrable fun h : ℝ => B * S' * fejer (H 0) h :=
        (integrable_fejer hH0pos).const_mul _
      have hintegral : (∫ h : ℝ, fejer (H 0) h * (A * V h + B * S'))
          = A * vdcAvg N c (s + 1) H F + B * S' := by
        have hcongr : (fun h : ℝ => fejer (H 0) h * (A * V h + B * S'))
            = fun h : ℝ => A * (fejer (H 0) h * V h) + B * S' * fejer (H 0) h := by
          funext h; ring
        rw [hcongr, integral_add hint3 hint4, integral_const_mul, integral_const_mul,
          integral_fejer hH0pos, mul_one, vdcAvg_succ]
      have hmid : (∫ h : ℝ, fejer (H 0) h * g h ^ (2 ^ s))
          ≤ A * vdcAvg N c (s + 1) H F + B * S' := by
        rw [← hintegral]
        refine integral_mono hint1 hint2 fun h => ?_
        exact mul_le_mul_of_nonneg_left (hptwise h) (fejer_nonneg hH0pos h)
      -- the boundary term stays linear in `H 0 / N`
      have hbdry : (12 * u) ^ (2 ^ s) ≤ R * (12 * u) := by
        rw [hR]
        exact pow_two_pow_le_mul (by positivity) hu3 (by norm_num) s
      have hVs0 : 0 ≤ vdcAvg N c (s + 1) H F := vdcAvg_nonneg N c (s + 1) H hHpos F
      -- assembly
      have hchain : ‖N⁻¹ • ∫ t in c..(c + N), F t‖ ^ (2 ^ (s + 1))
          ≤ P * (Q * (A * vdcAvg N c (s + 1) H F + B * S') + R * (12 * u)) := by
        calc ‖N⁻¹ • ∫ t in c..(c + N), F t‖ ^ (2 ^ (s + 1))
            = (‖N⁻¹ • ∫ t in c..(c + N), F t‖ ^ 2) ^ (2 ^ s) := by
              rw [← pow_mul, pow_succ]
              ring_nf
          _ ≤ (4 * J + 12 * u) ^ (2 ^ s) := by
              refine pow_le_pow_left₀ (sq_nonneg _) ?_ (2 ^ s)
              rw [hu, mul_div_assoc']
              exact hstep1
          _ ≤ P * ((4 * J) ^ (2 ^ s) + (12 * u) ^ (2 ^ s)) := by
              rw [hP]
              exact add_pow_le_two_pow_mul (by positivity) (by positivity) (2 ^ s)
          _ = P * (Q * J ^ (2 ^ s) + (12 * u) ^ (2 ^ s)) := by
              rw [mul_pow, hQ]
          _ ≤ P * (Q * (A * vdcAvg N c (s + 1) H F + B * S') + R * (12 * u)) := by
              refine mul_le_mul_of_nonneg_left (add_le_add ?_ hbdry) hPpos.le
              exact mul_le_mul_of_nonneg_left (le_trans hpow hmid) hQpos.le
      have hsum : (∑ i, H i / N) = u + S' := by
        rw [hu, hS', Fin.sum_univ_succ]
      rw [hsum]
      nlinarith [hchain, mul_nonneg (mul_nonneg (mul_nonneg hPpos.le hQpos.le) hB0) hu0,
        mul_nonneg (mul_nonneg hPpos.le hRpos.le) hS'0]



/-! ### Blueprint `lem:real-polynomial-oscillation`

"For every `d` there is `C_d >= 1` such that, if `P(t) = sum_{m=1}^d a_m t^m`, then
`norm(N^{-1} int_0^N exp(2 pi i P(t)) dt) <= C_d min(1, (max_m abs(a_m) N^m)^{-1/d})`."

The reusable prerequisite `Auto.exists_polynomial_oscillation_bound`, proved in
DFR/Auto/VanDerCorput.lean, is the normalized case `N = 1` with the phase `exp(i
f)`. The two remaining steps are the substitution `t = N s`, which replaces `a_m` by `a_m N^m`,
and the factor `2 pi`, which only rescales the largest coefficient by a fixed amount. -/

/-- The polynomial `sum_{m=1}^d b_m X^m`, with no constant term. -/
noncomputable def oscPoly (d : ℕ) (b : ℕ → ℝ) : Polynomial ℝ :=
  ∑ m ∈ Finset.Icc 1 d, Polynomial.C (b m) * Polynomial.X ^ m

theorem oscPoly_coeff (d : ℕ) (b : ℕ → ℝ) (n : ℕ) :
    (oscPoly d b).coeff n = if n ∈ Finset.Icc 1 d then b n else 0 := by
  classical
  rw [oscPoly, Polynomial.finsetSum_coeff]
  simp only [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, mul_ite, mul_one, mul_zero]
  rw [Finset.sum_ite_eq (Finset.Icc 1 d) n b]

theorem oscPoly_natDegree_le (d : ℕ) (b : ℕ → ℝ) : (oscPoly d b).natDegree ≤ d := by
  refine Polynomial.natDegree_le_iff_coeff_eq_zero.mpr fun n hn => ?_
  rw [oscPoly_coeff]
  refine ite_eq_right ?_
  simp only [Finset.mem_Icc, not_and, not_le]
  intro _
  omega

theorem oscPoly_eval (d : ℕ) (b : ℕ → ℝ) (s : ℝ) :
    (oscPoly d b).eval s = ∑ m ∈ Finset.Icc 1 d, b m * s ^ m := by
  rw [oscPoly, Polynomial.eval_finsetSum]
  refine Finset.sum_congr rfl fun m _ => ?_
  simp

open MeasureTheory in
/-- **Blueprint `lem:real-polynomial-oscillation`.** -/
theorem real_polynomial_oscillation (d : ℕ) : ∃ C : ℝ, 1 ≤ C ∧
    ∀ (a : ℕ → ℝ) (N A : ℝ), 0 < N → 0 < A →
      (∀ m, 1 ≤ m → m ≤ d → |a m| * N ^ m ≤ A) →
      (∃ m₀, 1 ≤ m₀ ∧ m₀ ≤ d ∧ A ≤ |a m₀| * N ^ m₀) →
      ‖N⁻¹ • ∫ t in (0 : ℝ)..N,
          expPhase (fun s => 2 * Real.pi * ∑ m ∈ Finset.Icc 1 d, a m * s ^ m) t‖
        ≤ C * min 1 (A ^ (-(1 : ℝ) / d)) := by
  classical
  obtain ⟨C, hC1, hC⟩ := exists_polynomial_oscillation_bound d
  refine ⟨C, hC1, ?_⟩
  intro a N A hN hA hAle hAex
  obtain ⟨m₀, hm₀1, hm₀d, hm₀A⟩ := hAex
  have hpi : (0 : ℝ) < 2 * Real.pi := by positivity
  have hpi1 : (1 : ℝ) ≤ 2 * Real.pi := by nlinarith [Real.two_le_pi]
  set b : ℕ → ℝ := fun m => 2 * Real.pi * (a m * N ^ m) with hbdef
  set f : Polynomial ℝ := oscPoly d b with hfdef
  have hfdeg : f.natDegree ≤ d := oscPoly_natDegree_le d b
  have hA' : (0 : ℝ) < 2 * Real.pi * A := by positivity
  -- the coefficients of the dilated polynomial
  have hcoeff : ∀ m, 1 ≤ m → |f.coeff m| ≤ 2 * Real.pi * A := by
    intro m hm
    rw [hfdef, oscPoly_coeff]
    by_cases hmd : m ∈ Finset.Icc 1 d
    · rw [ite_eq_left hmd, hbdef]
      simp only []
      rw [abs_mul, abs_of_nonneg hpi.le, abs_mul, abs_pow, abs_of_nonneg hN.le]
      exact mul_le_mul_of_nonneg_left (hAle m hm (Finset.mem_Icc.mp hmd).2) hpi.le
    · rw [ite_eq_right hmd, abs_zero]
      positivity
  have hcoeff₀ : 2 * Real.pi * A ≤ |f.coeff m₀| := by
    rw [hfdef, oscPoly_coeff, ite_eq_left (Finset.mem_Icc.mpr ⟨hm₀1, hm₀d⟩), hbdef]
    simp only []
    rw [abs_mul, abs_of_nonneg hpi.le, abs_mul, abs_pow, abs_of_nonneg hN.le]
    exact mul_le_mul_of_nonneg_left hm₀A hpi.le
  -- the substitution `t = N s`
  have heval : ∀ s : ℝ,
      f.eval s = 2 * Real.pi * ∑ m ∈ Finset.Icc 1 d, a m * (N * s) ^ m := by
    intro s
    rw [hfdef, oscPoly_eval, Finset.mul_sum]
    refine Finset.sum_congr rfl fun m _ => ?_
    rw [hbdef]
    simp only []
    rw [mul_pow]
    ring
  have hsub : (∫ s in (0 : ℝ)..1, expPhase (fun s => f.eval s) s)
      = N⁻¹ • ∫ t in (0 : ℝ)..N,
          expPhase (fun s => 2 * Real.pi * ∑ m ∈ Finset.Icc 1 d, a m * s ^ m) t := by
    have hcv := intervalIntegral.integral_comp_mul_left
      (f := expPhase (fun s => 2 * Real.pi * ∑ m ∈ Finset.Icc 1 d, a m * s ^ m))
      (a := (0 : ℝ)) (b := 1) (c := N) hN.ne'
    rw [mul_zero, mul_one] at hcv
    rw [← hcv]
    refine intervalIntegral.integral_congr fun s _ => ?_
    simp only [expPhase]
    rw [heval s]
  have hmain := hC f hfdeg (2 * Real.pi * A) hA' hcoeff ⟨m₀, hm₀1, hcoeff₀⟩
  rw [hsub] at hmain
  refine le_trans hmain ?_
  refine mul_le_mul_of_nonneg_left (min_le_min le_rfl ?_) (le_trans zero_le_one hC1)
  refine Real.rpow_le_rpow_of_nonpos hA ?_ ?_
  · nlinarith
  · rw [neg_div]
    rcases Nat.eq_zero_or_pos d with hd0 | hd1
    · simp [hd0]
    · have hd0' : (0 : ℝ) < (d : ℝ) := by exact_mod_cast hd1
      have : (0 : ℝ) < 1 / (d : ℝ) := by positivity
      linarith



/-! ## Blueprint `lem:pet-reduction`: the local uniformity norm as a real number

`def:local-uniformity` defines `U^s_{j,H}(f)` through its `2^s`-th power, and the proof attached
to that definition shows the power is real and nonnegative, so that the root is well defined.
Splitting the outermost shift variable off the cube of shifts turns the power into a Fejer average
of `Auto.pairAvg` of the remaining differences, and `Auto.re_fejer_fdiffIter_nonneg` is exactly the
nonnegativity of that average. -/

open MeasureTheory in
/-- Splitting the outermost shift variable off the cube of shifts. -/
theorem integral_pi_fin_succ {s : ℕ} (G : (Fin (s + 1) → ℝ) → ℂ) :
    (∫ h : Fin (s + 1) → ℝ, G h) = ∫ p : ℝ × (Fin s → ℝ), G (Fin.cons p.1 p.2) := by
  have hmp := (MeasureTheory.volume_preserving_piFinSuccAbove (fun _ : Fin (s + 1) => ℝ) 0).symm
  rw [← hmp.integral_comp' G]
  refine integral_congr_ae (Filter.Eventually.of_forall fun p => ?_)
  simp [MeasurableEquiv.piFinSuccAbove_symm_apply, Fin.insertNthEquiv, Fin.insertNth_zero']

/-- The iterated difference is dominated by the function itself at the base point: the vertex
`omega = 0` of the cube contributes the undisplaced factor. -/
theorem norm_fdiffIter_le_self (v : E3) : ∀ (s : ℕ) (h : Fin s → ℝ) {f : E3 → ℂ},
    (∀ y, ‖f y‖ ≤ 1) → ∀ x, ‖fdiffIter v s h f x‖ ≤ ‖f x‖
  | 0, _, _, _, x => le_of_eq rfl
  | (s + 1), h, f, hf, x => by
      rw [fdiffIter_succ, fdiff, norm_mul, RCLike.norm_conj]
      calc ‖fdiffIter v s (fun i => h i.succ) f (x + h 0 • v)‖
            * ‖fdiffIter v s (fun i => h i.succ) f x‖
          ≤ 1 * ‖f x‖ := by
            refine mul_le_mul (norm_fdiffIter_le v s _ hf _)
              (norm_fdiffIter_le_self v s _ hf x) (norm_nonneg _) zero_le_one
        _ = ‖f x‖ := one_mul _

/-- The Fejer weight attached to a cube of shifts. -/
noncomputable def fejerCube (H : ℝ) {s : ℕ} (h : Fin s → ℝ) : ℝ := ∏ l : Fin s, fejer H (h l)

theorem fejerCube_nonneg {H : ℝ} (hH : 0 < H) {s : ℕ} (h : Fin s → ℝ) : 0 ≤ fejerCube H h :=
  prod_fejer_nonneg hH h

open MeasureTheory in
theorem integrable_fejerCube {H : ℝ} (hH : 0 < H) (s : ℕ) :
    Integrable (fun h : Fin s → ℝ => fejerCube H h) :=
  MeasureTheory.Integrable.fin_nat_prod (fun _ => integrable_fejer hH)

open MeasureTheory in
theorem integral_fejerCube {H : ℝ} (hH : 0 < H) (s : ℕ) :
    (∫ h : Fin s → ℝ, fejerCube H h) = 1 := by
  simp only [fejerCube]
  rw [MeasureTheory.integral_fin_nat_prod_volume_eq_prod (fun _ : Fin s => fejer H)]
  simp [integral_fejer hH]

theorem continuous_cubeShift {s : ℕ} (ω : Fin s → Bool) :
    Continuous fun h : Fin s → ℝ => cubeShift h ω := by
  refine continuous_finsetSum _ fun i _ => ?_
  by_cases hi : ω i
  · simp only [hi]
    exact continuous_apply i
  · simp only [hi]
    exact continuous_const

open MeasureTheory in
/-- The iterated difference is jointly continuous in the point and the cube of shifts. -/
theorem continuous_fdiffIter_uncurry (v : E3) (s : ℕ) {f : E3 → ℂ} (hf : Continuous f) :
    Continuous fun p : E3 × (Fin s → ℝ) => fdiffIter v s p.2 f p.1 := by
  have heq : (fun p : E3 × (Fin s → ℝ) => fdiffIter v s p.2 f p.1)
      = fun p : E3 × (Fin s → ℝ) =>
        ∏ ω : Fin s → Bool, conjPar (numFalse ω) (f (p.1 + cubeShift p.2 ω • v)) := by
    funext p
    exact locUnif_integrand_eq v s p.2 f p.1
  rw [heq]
  refine continuous_finsetProd _ fun ω _ => ?_
  have hc : Continuous fun p : E3 × (Fin s → ℝ) => f (p.1 + cubeShift p.2 ω • v) :=
    hf.comp (continuous_fst.add
      (((continuous_cubeShift ω).comp continuous_snd).smul continuous_const))
  by_cases hω : Even (numFalse ω)
  · simpa only [conjPar, ite_eq_left hω] using hc
  · simpa only [conjPar, ite_eq_right hω, Function.comp_def] using Complex.continuous_conj.comp hc



open MeasureTheory in
/-- The integrand of `Auto.locUnifPow` is integrable in the point and the cube of shifts jointly:
it is dominated by the integrable function of the point times the integrable Fejer weight. -/
theorem integrable_locUnif_integrand {H : ℝ} (hH : 0 < H) (v : E3) (s : ℕ) {f : E3 → ℂ}
    (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) :
    Integrable (fun p : E3 × (Fin s → ℝ) =>
      fdiffIter v s p.2 f p.1 * ((fejerCube H p.2 : ℝ) : ℂ)) (volume.prod volume) := by
  have hdom : Integrable (fun p : E3 × (Fin s → ℝ) => ‖f p.1‖ * fejerCube H p.2)
      (volume.prod volume) :=
    MeasureTheory.Integrable.mul_prod hf.2.1.norm (integrable_fejerCube hH s)
  refine Integrable.mono' hdom ?_ (Filter.Eventually.of_forall fun p => ?_)
  · refine (continuous_fdiffIter_uncurry v s hf.1).aestronglyMeasurable.mul ?_
    exact ((Complex.continuous_ofReal.comp
      ((continuous_finsetProd _ fun l _ =>
        continuous_fejer.comp (continuous_apply l)).comp continuous_snd))).aestronglyMeasurable
  · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (fejerCube_nonneg hH p.2)]
    have h1 : ‖fdiffIter v s p.2 f p.1‖ ≤ ‖f p.1‖ := norm_fdiffIter_le_self v s p.2 hf1 p.1
    have h2 : (0 : ℝ) ≤ fejerCube H p.2 := fejerCube_nonneg hH p.2
    exact mul_le_mul_of_nonneg_right h1 h2

open MeasureTheory in
/-- `Auto.locUnifPow` with the two integrations exchanged: the cube of shifts outside. -/
theorem locUnifPow_swap {N H : ℝ} (hH : 0 < H) (j : Fin 3) (s : ℕ) {f : E3 → ℂ}
    (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) :
    locUnifPow N H j s f
      = ((N ^ (6 : ℕ))⁻¹ : ℂ) * ∫ h : Fin s → ℝ,
          ((fejerCube H h : ℝ) : ℂ) * ∫ x : E3, fdiffIter (basisVec j) s h f x := by
  rw [locUnifPow]
  congr 1
  have hint := integrable_locUnif_integrand hH (basisVec j) s hf hf1
  have hcongr : (∫ x : E3, ∫ h : Fin s → ℝ,
        fdiffIter (basisVec j) s h f x * ∏ l : Fin s, ((fejer H (h l) : ℝ) : ℂ))
      = ∫ x : E3, ∫ h : Fin s → ℝ,
        fdiffIter (basisVec j) s h f x * ((fejerCube H h : ℝ) : ℂ) := by
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    refine integral_congr_ae (Filter.Eventually.of_forall fun h => ?_)
    simp only [fejerCube, Complex.ofReal_prod]
  rw [hcongr, integral_integral_swap hint]
  refine integral_congr_ae (Filter.Eventually.of_forall fun h => ?_)
  change (∫ x : E3, fdiffIter (basisVec j) s h f x * ((fejerCube H h : ℝ) : ℂ))
      = ((fejerCube H h : ℝ) : ℂ) * ∫ x : E3, fdiffIter (basisVec j) s h f x
  rw [integral_mul_const, mul_comm]

open MeasureTheory in
/-- The inner integral of the iterated difference is the paired average of the remaining
differences. -/
theorem integral_fdiffIter_succ (v : E3) (s : ℕ) (h : Fin (s + 1) → ℝ) (f : E3 → ℂ) :
    (∫ x : E3, fdiffIter v (s + 1) h f x)
      = pairAvg v (fdiffIter v s (fun i => h i.succ) f) (h 0) := by
  rw [pairAvg]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
  rw [fdiffIter_succ, fdiff]



theorem fejerCube_cons {H : ℝ} {s : ℕ} (h0 : ℝ) (h : Fin s → ℝ) :
    fejerCube H (Fin.cons h0 h) = fejer H h0 * fejerCube H h := by
  simp only [fejerCube, Fin.prod_univ_succ, Fin.cons_zero, Fin.cons_succ]

open MeasureTheory in
/-- The Fejer average of the outermost difference, whose real part is nonnegative by
`Auto.re_fejer_fdiffIter_nonneg`. -/
noncomputable def innerFejer (H : ℝ) (v : E3) (s : ℕ) (f : E3 → ℂ) (h : Fin s → ℝ) : ℂ :=
  ∫ t : ℝ, ((fejer H t : ℝ) : ℂ) * pairAvg v (fdiffIter v s h f) t

open MeasureTheory in
theorem re_innerFejer_nonneg {H : ℝ} (hH : 0 < H) (v : E3) (s : ℕ) (h : Fin s → ℝ)
    {f : E3 → ℂ} (hf : Nice f) : 0 ≤ (innerFejer H v s f h).re := by
  have h1 := re_fejer_fdiffIter_nonneg hH v s h hf
  have heq : (∫ t : ℝ, fejer H t • pairAvg v (fdiffIter v s h f) t) = innerFejer H v s f h := by
    rw [innerFejer]
    refine integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
    change fejer H t • pairAvg v (fdiffIter v s h f) t
        = ((fejer H t : ℝ) : ℂ) * pairAvg v (fdiffIter v s h f) t
    rw [Complex.real_smul]
  rwa [heq] at h1

open MeasureTheory in
theorem norm_innerFejer_le {H : ℝ} (hH : 0 < H) (v : E3) (s : ℕ) (h : Fin s → ℝ)
    {f : E3 → ℂ} (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) :
    ‖innerFejer H v s f h‖ ≤ ∫ x : E3, ‖f x‖ := by
  have hnice := nice_fdiffIter v s h hf
  have hb : ∀ y, ‖fdiffIter v s h f y‖ ≤ 1 := norm_fdiffIter_le v s h hf1
  have hbd : ∀ t : ℝ, ‖((fejer H t : ℝ) : ℂ) * pairAvg v (fdiffIter v s h f) t‖
      ≤ fejer H t * ∫ x : E3, ‖f x‖ := by
    intro t
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (fejer_nonneg hH t)]
    refine mul_le_mul_of_nonneg_left ?_ (fejer_nonneg hH t)
    refine le_trans (norm_pairAvg_le v hnice hb t) ?_
    rw [one_mul]
    refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun x => norm_nonneg _)
      hf.2.1.norm (Filter.Eventually.of_forall fun x => ?_)
    exact norm_fdiffIter_le_self v s h hf1 x
  have hint : Integrable fun t : ℝ => fejer H t * ∫ x : E3, ‖f x‖ :=
    (integrable_fejer hH).mul_const _
  refine le_trans (norm_integral_le_of_norm_le hint (Filter.Eventually.of_forall hbd)) ?_
  rw [integral_mul_const, integral_fejer hH, one_mul]



theorem continuous_fin_cons {α : Type*} [TopologicalSpace α] {s : ℕ}
    {g : α → ℝ} {G : α → Fin s → ℝ} (hg : Continuous g) (hG : Continuous G) :
    Continuous fun a => (Fin.cons (g a) (G a) : Fin (s + 1) → ℝ) := by
  refine continuous_pi fun i => ?_
  induction i using Fin.cases with
  | zero => simpa using hg
  | succ k => simpa [Function.comp_def] using (continuous_apply k).comp hG

open MeasureTheory in
/-- The paired average of the remaining differences, as a function of the outermost shift and the
cube of the others, is strongly measurable. -/
theorem stronglyMeasurable_pairAvg_cube (v : E3) (s : ℕ) {f : E3 → ℂ} (hf : Continuous f) :
    StronglyMeasurable fun p : ℝ × (Fin s → ℝ) =>
      pairAvg v (fdiffIter v s p.2 f) p.1 := by
  have h1 : Continuous fun q : (ℝ × (Fin s → ℝ)) × E3 =>
      ((q.2, (Fin.cons q.1.1 q.1.2 : Fin (s + 1) → ℝ)) : E3 × (Fin (s + 1) → ℝ)) :=
    continuous_snd.prodMk
      (continuous_fin_cons (continuous_fst.comp continuous_fst)
        (continuous_snd.comp continuous_fst))
  have hcont : Continuous fun q : (ℝ × (Fin s → ℝ)) × E3 =>
      fdiffIter v (s + 1) (Fin.cons q.1.1 q.1.2) f q.2 :=
    (continuous_fdiffIter_uncurry v (s + 1) hf).comp h1
  have hsm : StronglyMeasurable fun p : ℝ × (Fin s → ℝ) =>
      ∫ x : E3, fdiffIter v (s + 1) (Fin.cons p.1 p.2) f x :=
    hcont.stronglyMeasurable.integral_prod_right' (ν := (volume : Measure E3))
  have heq : (fun p : ℝ × (Fin s → ℝ) => ∫ x : E3, fdiffIter v (s + 1) (Fin.cons p.1 p.2) f x)
      = fun p : ℝ × (Fin s → ℝ) => pairAvg v (fdiffIter v s p.2 f) p.1 := by
    funext p
    rw [integral_fdiffIter_succ v s (Fin.cons p.1 p.2) f]
    simp only [Fin.cons_zero, Fin.cons_succ]
  rwa [heq] at hsm

open MeasureTheory in
theorem integrable_split_integrand {H : ℝ} (hH : 0 < H) (v : E3) (s : ℕ) {f : E3 → ℂ}
    (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) :
    Integrable (fun p : ℝ × (Fin s → ℝ) =>
      ((fejer H p.1 : ℝ) : ℂ) * (((fejerCube H p.2 : ℝ) : ℂ)
        * pairAvg v (fdiffIter v s p.2 f) p.1)) (volume.prod volume) := by
  set L : ℝ := ∫ x : E3, ‖f x‖ with hL
  have hL0 : 0 ≤ L := integral_nonneg fun x => norm_nonneg _
  have hdom : Integrable (fun p : ℝ × (Fin s → ℝ) =>
      (fejer H p.1 * L) * fejerCube H p.2) (volume.prod volume) :=
    MeasureTheory.Integrable.mul_prod ((integrable_fejer hH).mul_const L)
      (integrable_fejerCube hH s)
  refine Integrable.mono' hdom ?_ (Filter.Eventually.of_forall fun p => ?_)
  · refine AEStronglyMeasurable.mul ?_ (AEStronglyMeasurable.mul ?_ ?_)
    · exact ((Complex.continuous_ofReal.comp
        (continuous_fejer.comp continuous_fst))).aestronglyMeasurable
    · exact ((Complex.continuous_ofReal.comp
        ((continuous_finsetProd _ fun l _ =>
          continuous_fejer.comp (continuous_apply l)).comp continuous_snd))).aestronglyMeasurable
    · exact (stronglyMeasurable_pairAvg_cube v s hf.1).aestronglyMeasurable
  · have hb : ∀ y, ‖fdiffIter v s p.2 f y‖ ≤ 1 := norm_fdiffIter_le v s p.2 hf1
    have hpair : ‖pairAvg v (fdiffIter v s p.2 f) p.1‖ ≤ L := by
      refine le_trans (norm_pairAvg_le v (nice_fdiffIter v s p.2 hf) hb p.1) ?_
      rw [one_mul, hL]
      refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun x => norm_nonneg _)
        hf.2.1.norm (Filter.Eventually.of_forall fun x => ?_)
      exact norm_fdiffIter_le_self v s p.2 hf1 x
    have hnorm : ‖((fejer H p.1 : ℝ) : ℂ) * (((fejerCube H p.2 : ℝ) : ℂ)
          * pairAvg v (fdiffIter v s p.2 f) p.1)‖
        = fejer H p.1 * (fejerCube H p.2 * ‖pairAvg v (fdiffIter v s p.2 f) p.1‖) := by
      rw [norm_mul, norm_mul, Complex.norm_real, Complex.norm_real, Real.norm_eq_abs,
        Real.norm_eq_abs, abs_of_nonneg (fejer_nonneg hH p.1),
        abs_of_nonneg (fejerCube_nonneg hH p.2)]
    rw [hnorm]
    calc fejer H p.1 * (fejerCube H p.2 * ‖pairAvg v (fdiffIter v s p.2 f) p.1‖)
        ≤ fejer H p.1 * (fejerCube H p.2 * L) := by
          refine mul_le_mul_of_nonneg_left ?_ (fejer_nonneg hH p.1)
          exact mul_le_mul_of_nonneg_left hpair (fejerCube_nonneg hH p.2)
      _ = fejer H p.1 * L * fejerCube H p.2 := by ring



open MeasureTheory in
/-- The `2^{s+1}`-th power of the local uniformity norm, with the outermost shift split off. -/
theorem locUnifPow_succ_eq {N H : ℝ} (hH : 0 < H) (j : Fin 3) (s : ℕ) {f : E3 → ℂ}
    (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) :
    locUnifPow N H j (s + 1) f
      = ((N ^ (6 : ℕ))⁻¹ : ℂ) * ∫ h : Fin s → ℝ,
          ((fejerCube H h : ℝ) : ℂ) * innerFejer H (basisVec j) s f h := by
  rw [locUnifPow_swap hH j (s + 1) hf hf1]
  congr 1
  have hstep : ∀ h : Fin (s + 1) → ℝ,
      ((fejerCube H h : ℝ) : ℂ) * ∫ x : E3, fdiffIter (basisVec j) (s + 1) h f x
        = ((fejer H (h 0) : ℝ) : ℂ) * ((((fejerCube H (fun i => h i.succ)) : ℝ) : ℂ)
            * pairAvg (basisVec j) (fdiffIter (basisVec j) s (fun i => h i.succ) f) (h 0)) := by
    intro h
    rw [integral_fdiffIter_succ]
    have hc : fejerCube H h = fejer H (h 0) * fejerCube H (fun i => h i.succ) := by
      simp only [fejerCube, Fin.prod_univ_succ]
    rw [hc, Complex.ofReal_mul]
    ring
  rw [integral_congr_ae (Filter.Eventually.of_forall hstep), integral_pi_fin_succ]
  have hsimp : ∀ p : ℝ × (Fin s → ℝ),
      ((fejer H ((Fin.cons p.1 p.2 : Fin (s + 1) → ℝ) 0) : ℝ) : ℂ)
        * ((((fejerCube H (fun i => (Fin.cons p.1 p.2 : Fin (s + 1) → ℝ) i.succ)) : ℝ) : ℂ)
          * pairAvg (basisVec j) (fdiffIter (basisVec j) s
              (fun i => (Fin.cons p.1 p.2 : Fin (s + 1) → ℝ) i.succ) f)
              ((Fin.cons p.1 p.2 : Fin (s + 1) → ℝ) 0))
      = ((fejer H p.1 : ℝ) : ℂ) * (((fejerCube H p.2 : ℝ) : ℂ)
          * pairAvg (basisVec j) (fdiffIter (basisVec j) s p.2 f) p.1) := by
    intro p
    have h2 : (fun i => (Fin.cons p.1 p.2 : Fin (s + 1) → ℝ) i.succ) = p.2 := by
      funext i
      exact Fin.cons_succ _ _ _
    rw [Fin.cons_zero, h2]
  rw [integral_congr_ae (Filter.Eventually.of_forall hsimp),
    MeasureTheory.Measure.volume_eq_prod,
    integral_prod_symm _ (integrable_split_integrand hH (basisVec j) s hf hf1)]
  refine integral_congr_ae (Filter.Eventually.of_forall fun h => ?_)
  simp only [innerFejer]
  rw [← integral_const_mul]
  refine integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
  ring

open MeasureTheory in
theorem stronglyMeasurable_innerFejer {H : ℝ} (v : E3) (s : ℕ) {f : E3 → ℂ}
    (hf : Continuous f) : StronglyMeasurable (innerFejer H v s f) := by
  have hjoint : StronglyMeasurable fun q : (Fin s → ℝ) × ℝ =>
      ((fejer H q.2 : ℝ) : ℂ) * pairAvg v (fdiffIter v s q.1 f) q.2 := by
    refine StronglyMeasurable.mul ?_ ?_
    · exact (Complex.continuous_ofReal.comp
        (continuous_fejer.comp continuous_snd)).stronglyMeasurable
    · exact (stronglyMeasurable_pairAvg_cube v s hf).measurable.comp
        (measurable_snd.prodMk measurable_fst) |>.stronglyMeasurable
  exact hjoint.integral_prod_right' (ν := (volume : Measure ℝ))

open MeasureTheory in
theorem integrable_fejerCube_innerFejer {H : ℝ} (hH : 0 < H) (v : E3) (s : ℕ) {f : E3 → ℂ}
    (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) :
    Integrable fun h : Fin s → ℝ => ((fejerCube H h : ℝ) : ℂ) * innerFejer H v s f h := by
  set L : ℝ := ∫ x : E3, ‖f x‖ with hL
  have hL0 : 0 ≤ L := integral_nonneg fun x => norm_nonneg _
  refine Integrable.mono' ((integrable_fejerCube hH s).mul_const L) ?_
    (Filter.Eventually.of_forall fun h => ?_)
  · exact ((Complex.continuous_ofReal.comp
      (continuous_finsetProd _ fun l _ =>
        continuous_fejer.comp (continuous_apply l))).aestronglyMeasurable).mul
      (stronglyMeasurable_innerFejer v s hf.1).aestronglyMeasurable
  · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (fejerCube_nonneg hH h)]
    exact mul_le_mul_of_nonneg_left (norm_innerFejer_le hH v s h hf hf1)
      (fejerCube_nonneg hH h)

open MeasureTheory in
/-- **The `2^{s+1}`-th power of the local uniformity norm is real and nonnegative.** This is the
statement that makes the root in `def:local-uniformity` well defined. -/
theorem locUnifPow_re_nonneg {N H : ℝ} (hH : 0 < H) (hN : 0 < N) (j : Fin 3) (s : ℕ)
    {f : E3 → ℂ} (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) :
    0 ≤ (locUnifPow N H j (s + 1) f).re := by
  rw [locUnifPow_succ_eq hH j s hf hf1]
  have hcast : ((N ^ (6 : ℕ))⁻¹ : ℂ) = (((N ^ (6 : ℕ))⁻¹ : ℝ) : ℂ) := by push_cast; ring
  rw [hcast, Complex.re_ofReal_mul]
  refine mul_nonneg (by positivity) ?_
  have hre := (Complex.reCLM).integral_comp_comm
    (integrable_fejerCube_innerFejer hH (basisVec j) s hf hf1)
  simp only [Complex.reCLM_apply] at hre
  rw [← hre]
  refine integral_nonneg fun h => ?_
  rw [Complex.re_ofReal_mul]
  exact mul_nonneg (fejerCube_nonneg hH h) (re_innerFejer_nonneg hH (basisVec j) s h hf)

/-- The local uniformity norm `U^s_{j,H}(f)` itself: the real `2^s`-th root of
`Auto.locUnifPow`, which `Auto.locUnifPow_re_nonneg` shows is well defined. -/
noncomputable def locUnif (N H : ℝ) (j : Fin 3) (s : ℕ) (f : E3 → ℂ) : ℝ :=
  (locUnifPow N H j s f).re ^ ((1 : ℝ) / 2 ^ s)

open MeasureTheory in
theorem locUnif_nonneg {N H : ℝ} (hH : 0 < H) (hN : 0 < N) (j : Fin 3) (s : ℕ)
    {f : E3 → ℂ} (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) :
    0 ≤ locUnif N H j (s + 1) f :=
  Real.rpow_nonneg (locUnifPow_re_nonneg hH hN j s hf hf1) _

/-- **The bridge**: a lower bound on the `2^s`-th power is a lower bound on the norm. -/
theorem le_locUnif_of_le_pow {N H : ℝ} {j : Fin 3} {s : ℕ} {f : E3 → ℂ} {c : ℝ}
    (hc : 0 ≤ c) (h : c ^ (2 ^ s) ≤ (locUnifPow N H j s f).re) :
    c ≤ locUnif N H j s f := by
  have hpow : (0 : ℝ) < 2 ^ s := by positivity
  have hcp : (0 : ℝ) ≤ c ^ (2 ^ s) := pow_nonneg hc _
  have hmono : (c ^ (2 ^ s)) ^ ((1 : ℝ) / 2 ^ s) ≤ locUnif N H j s f :=
    Real.rpow_le_rpow hcp h (by positivity)
  refine le_trans (le_of_eq ?_) hmono
  have hc2 : ((2 : ℝ) ^ s) ≠ 0 := by positivity
  rw [← Real.rpow_natCast c (2 ^ s), ← Real.rpow_mul hc]
  push_cast
  rw [mul_one_div, div_self hc2, Real.rpow_one]



/-! ## Blueprint `lem:pet-reduction`: the anisotropic box

"`I_N(C) = [-CN, CN] x [-CN^2, CN^2] x [-CN^3, CN^3]`."  Its volume is `8 C^3 N^6`, which is the
normalization `N^6` of the lemma up to the fixed factor `8 C^3`; a `1`-bounded family supported
there therefore has `|Lambda_N| <= 8 C^3 N^6`, so the hypothesis `|Lambda_N| >= delta N^6` is a
genuine largeness assumption exactly when `delta` is small compared with `C^3`. -/

/-- The anisotropic box `I_N(C)` of blueprint `lem:pet-reduction`. -/
def petBox (C N : ℝ) : Set E3 :=
  {x | ∀ i : Fin 3, x i ∈ Set.Icc (-(C * N ^ expo i)) (C * N ^ expo i)}

theorem petBox_eq_preimage (C N : ℝ) :
    petBox C N = (WithLp.ofLp : E3 → (Fin 3 → ℝ)) ⁻¹'
      (Set.univ.pi fun i : Fin 3 => Set.Icc (-(C * N ^ expo i)) (C * N ^ expo i)) := by
  ext x
  simp only [petBox, Set.mem_ofPred_eq, Set.mem_preimage, Set.mem_pi, Set.mem_univ,
    forall_const, Set.mem_Icc]

open MeasureTheory in
theorem measurableSet_petBox (C N : ℝ) : MeasurableSet (petBox C N) := by
  have hEq : petBox C N
      = ⋂ i : Fin 3, (fun x : E3 => x i) ⁻¹' Set.Icc (-(C * N ^ expo i)) (C * N ^ expo i) := by
    ext x
    simp [petBox, Set.mem_iInter]
  rw [hEq]
  exact MeasurableSet.iInter fun i => (continuous_E3_coord i).measurable measurableSet_Icc

open MeasureTheory in
/-- **The volume of the anisotropic box is `8 C^3 N^6`.** -/
theorem volume_petBox {C N : ℝ} (hC : 0 ≤ C) (hN : 0 ≤ N) :
    volume (petBox C N) = ENNReal.ofReal (8 * C ^ 3 * N ^ 6) := by
  have hm : MeasurableSet (Set.univ.pi fun i : Fin 3 =>
      Set.Icc (-(C * N ^ expo i)) (C * N ^ expo i)) :=
    MeasurableSet.univ_pi fun _ => measurableSet_Icc
  rw [petBox_eq_preimage,
    (PiLp.volume_preserving_ofLp (Fin 3)).measure_preimage hm.nullMeasurableSet, volume_pi_pi]
  have hfac : ∀ i : Fin 3, (volume (Set.Icc (-(C * N ^ expo i)) (C * N ^ expo i)))
      = ENNReal.ofReal (2 * (C * N ^ expo i)) := by
    intro i
    rw [Real.volume_Icc]
    congr 1
    ring
  simp only [hfac, Fin.prod_univ_three]
  rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
  congr 1
  simp only [expo]
  norm_num
  ring

open MeasureTheory in
/-- The trivial upper bound for the four-linear form on a `1`-bounded family supported in the
box: the modulus of the average is at most one, so the pairing is at most the volume. -/
theorem norm_Lambda_le_volume {N : ℝ} (hN : 0 < N) {C : ℝ} (hC : 0 ≤ C) {f0 : E3 → ℂ}
    {f : Fin 3 → E3 → ℂ} (hf1 : ∀ i x, ‖f i x‖ ≤ 1) (hf01 : ∀ x, ‖f0 x‖ ≤ 1)
    (hsupp : ∀ x, x ∉ petBox C N → f0 x = 0) :
    ‖Lambda N f0 f‖ ≤ 8 * C ^ 3 * N ^ 6 := by
  have hvol : volume (petBox C N) = ENNReal.ofReal (8 * C ^ 3 * N ^ 6) :=
    volume_petBox hC hN.le
  have htop : volume (petBox C N) ≠ ⊤ := by rw [hvol]; exact ENNReal.ofReal_ne_top
  have hA : ∀ x : E3, ‖A N f x‖ ≤ 1 := by
    intro x
    rw [A, norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hN.le]
    have hb : ∀ t ∈ Set.uIoc (0 : ℝ) N, ‖prodShift f x t‖ ≤ 1 := fun t _ => by
      refine le_trans (norm_prodShift_le hf1 x t) ?_
      norm_num
    have hint := intervalIntegral.norm_integral_le_of_norm_le_const hb
    rw [sub_zero, abs_of_pos hN] at hint
    calc N⁻¹ * ‖∫ t in (0 : ℝ)..N, prodShift f x t‖ ≤ N⁻¹ * (1 * N) :=
          mul_le_mul_of_nonneg_left hint (by positivity)
      _ = 1 := by field_simp
  have hbd : ∀ x : E3, ‖A N f x * (starRingEnd ℂ) (f0 x)‖
      ≤ Set.indicator (petBox C N) (fun _ => (1 : ℝ)) x := by
    intro x
    rw [norm_mul, RCLike.norm_conj]
    by_cases hx : x ∈ petBox C N
    · rw [Set.indicator_of_mem hx]
      calc ‖A N f x‖ * ‖f0 x‖ ≤ 1 * 1 :=
            mul_le_mul (hA x) (hf01 x) (norm_nonneg _) zero_le_one
        _ = 1 := one_mul 1
    · rw [Set.indicator_of_notMem hx, hsupp x hx, norm_zero, mul_zero]
  have hintind : Integrable (Set.indicator (petBox C N) fun _ : E3 => (1 : ℝ)) := by
    rw [integrable_indicator_iff (measurableSet_petBox C N)]
    exact (MeasureTheory.integrableOn_const_iff).mpr
      (Or.inr (lt_of_le_of_ne le_top htop))
  refine le_trans (norm_integral_le_of_norm_le hintind (Filter.Eventually.of_forall hbd)) ?_
  rw [integral_indicator (measurableSet_petBox C N), setIntegral_const, smul_eq_mul, mul_one,
    MeasureTheory.measureReal_def, hvol, ENNReal.toReal_ofReal (by positivity)]



/-! ## Blueprint `lem:pet-reduction`: one van der Corput step

The step has two halves. Cauchy-Schwarz in the point removes the undifferenced factor `f_0`,
leaving the `L^2` norm of the average; the support of `f_0` enters only through the volume of the
box. Then van der Corput in the parameter, `Auto.fejer_vdc'`, replaces the average by a Fejer
average of the differenced average, in which every factor has acquired a shift. -/

open MeasureTheory in
/-- The average vanishes off the box enlarged by one unit in each anisotropic direction: for
`0 <= t <= N` the translation `Gamma_i(t)` moves the `i`-th coordinate by at most `N^{expo i}`. -/
theorem A_eq_zero_of_notMem_petBox {N : ℝ} (hN : 0 < N) {C : ℝ} {f : Fin 3 → E3 → ℂ}
    (hsupp : ∀ i x, x ∉ petBox C N → f i x = 0) {x : E3} (hx : x ∉ petBox (C + 1) N) :
    A N f x = 0 := by
  obtain ⟨i, hi⟩ : ∃ i : Fin 3,
      x i ∉ Set.Icc (-((C + 1) * N ^ expo i)) ((C + 1) * N ^ expo i) := by
    by_contra hcon
    push Not at hcon
    exact hx hcon
  have hNi : (0 : ℝ) ≤ N ^ expo i := pow_nonneg hN.le _
  have hzero : Set.EqOn (prodShift f x) (fun _ => (0 : ℂ)) (Set.uIcc (0 : ℝ) N) := by
    intro t ht
    rw [Set.uIcc_of_le hN.le, Set.mem_Icc] at ht
    have hpow0 : (0 : ℝ) ≤ t ^ expo i := pow_nonneg ht.1 _
    have hpowN : t ^ expo i ≤ N ^ expo i := pow_le_pow_left₀ ht.1 ht.2 _
    have hnot : x + curve i t ∉ petBox C N := by
      intro hmem
      have hco : (x + curve i t) i = x i + t ^ expo i := by
        rw [PiLp.add_apply, curve_apply]
        simp
      have hb := hmem i
      rw [Set.mem_Icc, hco] at hb
      refine hi ?_
      rw [Set.mem_Icc]
      exact ⟨by nlinarith [hb.1], by nlinarith [hb.2]⟩
    have hfi : f i (x + curve i t) = 0 := hsupp i _ hnot
    rw [prodShift]
    exact Finset.prod_eq_zero (Finset.mem_univ i) hfi
  rw [A, intervalIntegral.integral_congr hzero]
  simp

open MeasureTheory in
/-- **Cauchy-Schwarz in the point.** The undifferenced factor is removed at the cost of the
square root of the volume of its support. -/
theorem enorm_Lambda_le_L2 {N : ℝ} {C : ℝ} {f0 : E3 → ℂ} {f : Fin 3 → E3 → ℂ}
    (hfc : ∀ i, Continuous (f i)) (hf0m : AEStronglyMeasurable f0 volume)
    (hf01 : ∀ x, ‖f0 x‖ ≤ 1) (hsupp : ∀ x, x ∉ petBox C N → f0 x = 0) :
    ‖Lambda N f0 f‖ₑ
      ≤ eLpNorm (A N f) 2 volume * volume (petBox C N) ^ ((1 : ℝ) / 2) := by
  have hcs : ‖Lambda N f0 f‖ₑ ≤ eLpNorm (A N f) 2 volume * eLpNorm f0 2 volume := by
    refine enorm_integral_mul_conj_le (a := 2) (b := 2) ?_
      (continuous_A hfc N).aestronglyMeasurable hf0m
    rw [ENNReal.inv_two_add_inv_two]
  refine le_trans hcs (mul_le_mul' le_rfl ?_)
  have hmono : eLpNorm f0 2 volume
      ≤ eLpNorm (Set.indicator (petBox C N) (fun _ => (1 : ℂ))) 2 volume := by
    refine eLpNorm_mono (by fun_prop) fun x => ?_
    by_cases hx : x ∈ petBox C N
    · rw [Set.indicator_of_mem hx]
      simpa using hf01 x
    · rw [Set.indicator_of_notMem hx, hsupp x hx]
  refine le_trans hmono (le_of_eq ?_)
  rw [eLpNorm_indicator_const (measurableSet_petBox C N).nullMeasurableSet (by norm_num)
    (by norm_num)]
  simp



/-- The differenced configuration: after one van der Corput step every factor has acquired the
shift `h` along its own anisotropic curve, and the conjugate of the undisplaced factor. -/
noncomputable def dshift (f : Fin 3 → E3 → ℂ) (h : ℝ) (x : E3) (t : ℝ) : ℂ :=
  ∏ i : Fin 3, (f i (x + curve i (t + h)) * (starRingEnd ℂ) (f i (x + curve i t)))

theorem dshift_eq_rdiff (f : Fin 3 → E3 → ℂ) (h : ℝ) (x : E3) (t : ℝ) :
    dshift f h x t = rdiff h (prodShift f x) t := by
  rw [dshift, rdiff, prodShift, prodShift, map_prod, ← Finset.prod_mul_distrib]

theorem A_eq_smul (N : ℝ) (f : Fin 3 → E3 → ℂ) (x : E3) :
    A N f x = N⁻¹ • ∫ t in (0 : ℝ)..N, prodShift f x t := by
  rw [A, Complex.real_smul, Complex.ofReal_inv]

theorem norm_dshift_le {f : Fin 3 → E3 → ℂ} (hf1 : ∀ i x, ‖f i x‖ ≤ 1) (h : ℝ) (x : E3)
    (t : ℝ) : ‖dshift f h x t‖ ≤ 1 := by
  rw [dshift_eq_rdiff, rdiff, norm_mul, RCLike.norm_conj]
  have h1 : ‖prodShift f x (t + h)‖ ≤ 1 := le_trans (norm_prodShift_le hf1 x (t + h)) (by norm_num)
  have h2 : ‖prodShift f x t‖ ≤ 1 := le_trans (norm_prodShift_le hf1 x t) (by norm_num)
  exact ((mul_le_of_le_one_left (norm_nonneg _) h1).trans h2)

open MeasureTheory in
/-- **One van der Corput step in the parameter.** The square of the average is controlled by the
Fejer average of the differenced averages, up to the boundary error `12 H / N`. -/
theorem sq_norm_A_le {N H : ℝ} (hN : 0 < N) (hH : 0 < H) (hHN : H ≤ N / 4)
    {f : Fin 3 → E3 → ℂ} (hfc : ∀ i, Continuous (f i)) (hf1 : ∀ i x, ‖f i x‖ ≤ 1) (x : E3) :
    ‖A N f x‖ ^ 2
      ≤ 4 * (∫ h : ℝ, fejer H h * ‖N⁻¹ • ∫ t in (0 : ℝ)..N, dshift f h x t‖)
        + 12 * H / N := by
  have hFm : Measurable (prodShift f x) := (continuous_prodShift hfc x).measurable
  have hF1 : ∀ t, ‖prodShift f x t‖ ≤ 1 := fun t =>
    le_trans (norm_prodShift_le hf1 x t) (by norm_num)
  have hvdc := fejer_vdc' hFm hF1 hN hH hHN 0
  rw [zero_add] at hvdc
  have hint : ∀ h : ℝ,
      (∫ t in (0 : ℝ)..N, prodShift f x (t + h) * (starRingEnd ℂ) (prodShift f x t))
        = ∫ t in (0 : ℝ)..N, dshift f h x t := fun h =>
    intervalIntegral.integral_congr fun t _ => (dshift_eq_rdiff f h x t).symm
  simp only [hint] at hvdc
  rw [A_eq_smul]
  exact hvdc



/-! ## Blueprint `lem:pet-reduction`: the differencing calculus

"Choose a polynomial of largest degree and apply `lem:fejer-vdc`; translate so that this
polynomial becomes zero. Every other polynomial `Q` is replaced by `Q(t+h) - P(t)` and
`Q(t) - P(t)`."

Translating the point by `-Gamma_k(t)` leaves the `k`-th conjugated factor undisplaced, which is
what selects one function of the configuration; the `k`-th displaced factor then carries
`Gamma_k(t+h) - Gamma_k(t)`, whose degree in `t` is one less than that of `Gamma_k`. For the
system `t, t^2, t^3` the three drops are computed explicitly below: a degree-one translation
becomes the constant `h`, a degree-two one becomes `2 h t + h^2`, and a degree-three one becomes
`3 h t^2 + 3 h^2 t + h^3`. -/
theorem curve_sub_curve (k : Fin 3) (t h : ℝ) :
    curve k (t + h) - curve k t = ((t + h) ^ expo k - t ^ expo k) • basisVec k := by
  rw [curve, curve, ← sub_smul]

/-- The degree-one translation loses its dependence on `t` entirely. -/
theorem expo_diff_zero (t h : ℝ) : (t + h) ^ expo 0 - t ^ expo 0 = h := by
  simp only [expo, Fin.val_zero]
  ring

/-- The degree-two translation becomes a degree-one polynomial in `t`. -/
theorem expo_diff_one (t h : ℝ) : (t + h) ^ expo 1 - t ^ expo 1 = 2 * h * t + h ^ 2 := by
  simp only [expo, Fin.val_one]
  ring

/-- The degree-three translation becomes a degree-two polynomial in `t`. -/
theorem expo_diff_two (t h : ℝ) :
    (t + h) ^ expo 2 - t ^ expo 2 = 3 * h * t ^ 2 + 3 * h ^ 2 * t + h ^ 3 := by
  simp only [expo, Fin.val_two]
  ring

open MeasureTheory in
/-- **The translation that selects one function.** Translating the point by `-Gamma_k(t)` does
not change the integral, and leaves the `k`-th conjugated factor undisplaced. -/
theorem integral_dshift_translate (f : Fin 3 → E3 → ℂ) (k : Fin 3) (h t : ℝ) :
    (∫ x : E3, dshift f h x t)
      = ∫ x : E3, ∏ i : Fin 3,
          (f i (x - curve k t + curve i (t + h))
            * (starRingEnd ℂ) (f i (x - curve k t + curve i t))) :=
  (integral_sub_right_eq_self
    (fun x : E3 => ∏ i : Fin 3, (f i (x + curve i (t + h))
      * (starRingEnd ℂ) (f i (x + curve i t)))) (curve k t)).symm

/-- After the translation the selected factor appears undisplaced, and the factor paired with it
carries the difference `Gamma_k(t+h) - Gamma_k(t)`, of lower degree in `t`. -/
theorem prod_translate_split (f : Fin 3 → E3 → ℂ) (k : Fin 3) (h t : ℝ) (x : E3) :
    (∏ i : Fin 3, (f i (x - curve k t + curve i (t + h))
        * (starRingEnd ℂ) (f i (x - curve k t + curve i t))))
      = (f k (x + ((t + h) ^ expo k - t ^ expo k) • basisVec k) * (starRingEnd ℂ) (f k x))
        * ∏ i ∈ Finset.univ.erase k, (f i (x - curve k t + curve i (t + h))
            * (starRingEnd ℂ) (f i (x - curve k t + curve i t))) := by
  rw [← Finset.mul_prod_erase Finset.univ
    (fun i => f i (x - curve k t + curve i (t + h))
      * (starRingEnd ℂ) (f i (x - curve k t + curve i t))) (Finset.mem_univ k)]
  congr 2
  · congr 1
    rw [← curve_sub_curve]
    abel
  · congr 1
    abel



/-! ## Blueprint `lem:pet-reduction`: polynomial translations

"To a finite family of nonconstant polynomials attach its weight."  One van der Corput step
replaces the monomial translations `Gamma_i` by differences `Gamma_i(t+h) - Gamma_k(t)` and
`Gamma_i(t) - Gamma_k(t)`, which are no longer monomial and no longer point along a single axis.
The class closed under the step is therefore the *polynomial translations*: a triple of real
polynomials acting by `x -> x + sum_d q_d(t) e_d`. This section sets up that class, its action,
and the two operations the step performs on it. -/

/-- A polynomial translation of `R^3`: one real polynomial per coordinate direction. -/
noncomputable def translAct (q : Fin 3 → Polynomial ℝ) (t : ℝ) : E3 :=
  ∑ d : Fin 3, ((q d).eval t) • basisVec d

theorem translAct_apply (q : Fin 3 → Polynomial ℝ) (t : ℝ) (d : Fin 3) :
    translAct q t d = (q d).eval t := by
  simp only [translAct, Fin.sum_univ_three]
  fin_cases d <;>
    simp [basisVec, PiLp.add_apply, PiLp.smul_apply]

theorem continuous_translAct (q : Fin 3 → Polynomial ℝ) : Continuous (translAct q) := by
  refine continuous_finsetSum _ fun d _ => ?_
  exact ((q d).continuous).smul continuous_const

/-- The monomial translation `Gamma_i` as a polynomial translation. -/
noncomputable def curveTransl (i : Fin 3) : Fin 3 → Polynomial ℝ :=
  fun d => if d = i then Polynomial.X ^ expo i else 0

theorem curveTransl_self (i : Fin 3) : curveTransl i i = Polynomial.X ^ expo i := by
  simp [curveTransl]

theorem curveTransl_ne {i d : Fin 3} (h : d ≠ i) : curveTransl i d = 0 := by
  simp [curveTransl, h]

theorem translAct_curveTransl (i : Fin 3) (t : ℝ) : translAct (curveTransl i) t = curve i t := by
  rw [translAct, curve, Finset.sum_eq_single i]
  · rw [curveTransl_self]
    simp
  · intro e _ hei
    rw [curveTransl_ne hei]
    simp
  · intro hi
    exact absurd (Finset.mem_univ i) hi

/-- The shift `q(. + h)` of a polynomial translation. -/
noncomputable def translShift (q : Fin 3 → Polynomial ℝ) (h : ℝ) : Fin 3 → Polynomial ℝ :=
  fun d => Polynomial.taylor h (q d)

theorem translAct_translShift (q : Fin 3 → Polynomial ℝ) (h t : ℝ) :
    translAct (translShift q h) t = translAct q (t + h) := by
  rw [translAct, translAct]
  refine Finset.sum_congr rfl fun d _ => ?_
  rw [translShift, Polynomial.taylor_eval]

/-- The difference of two polynomial translations. -/
noncomputable def translSub (q r : Fin 3 → Polynomial ℝ) : Fin 3 → Polynomial ℝ :=
  fun d => q d - r d

theorem translAct_translSub (q r : Fin 3 → Polynomial ℝ) (t : ℝ) :
    translAct (translSub q r) t = translAct q t - translAct r t := by
  rw [translAct, translAct, translAct, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun d _ => ?_
  rw [translSub, Polynomial.eval_sub, sub_smul]

/-- The degree of a polynomial translation: the largest of the degrees of its three
coordinates. -/
noncomputable def translDeg (q : Fin 3 → Polynomial ℝ) : ℕ :=
  Finset.univ.sup fun d => (q d).natDegree

theorem translDeg_le_iff {q : Fin 3 → Polynomial ℝ} {n : ℕ} :
    translDeg q ≤ n ↔ ∀ d, (q d).natDegree ≤ n := by
  rw [translDeg, Finset.sup_le_iff]
  exact ⟨fun h d => h d (Finset.mem_univ d), fun h d _ => h d⟩

theorem natDegree_le_translDeg (q : Fin 3 → Polynomial ℝ) (d : Fin 3) :
    (q d).natDegree ≤ translDeg q := by
  rw [translDeg]
  exact Finset.le_sup (f := fun e => (q e).natDegree) (Finset.mem_univ d)

theorem translDeg_curveTransl (i : Fin 3) : translDeg (curveTransl i) = expo i := by
  refine le_antisymm (translDeg_le_iff.mpr fun d => ?_) ?_
  · by_cases hd : d = i
    · subst hd
      rw [curveTransl_self, Polynomial.natDegree_X_pow]
    · rw [curveTransl_ne hd, Polynomial.natDegree_zero]
      exact Nat.zero_le _
  · have h := natDegree_le_translDeg (curveTransl i) i
    rwa [curveTransl_self, Polynomial.natDegree_X_pow] at h

/-- Shifting a polynomial does not change its degree or its leading coefficient, so the
difference has strictly smaller degree. -/
theorem natDegree_taylor_sub_lt {p : Polynomial ℝ} (hp : 0 < p.natDegree) (h : ℝ) :
    (Polynomial.taylor h p - p).natDegree < p.natDegree := by
  have hp0 : p ≠ 0 := fun h0 => by simp [h0] at hp
  by_cases hz : Polynomial.taylor h p - p = 0
  · rw [hz, Polynomial.natDegree_zero]
    exact hp
  · have htp0 : Polynomial.taylor h p ≠ 0 := by simpa using hp0
    have hd : (Polynomial.taylor h p).degree = p.degree := Polynomial.degree_taylor p h
    have hlt := Polynomial.degree_sub_lt_left hd htp0 (Polynomial.leadingCoeff_taylor h p)
    rw [hd] at hlt
    exact Polynomial.natDegree_lt_natDegree hz hlt

/-- **The degree drops under the step applied to the selected translation.** This is the
blueprint's "if `Q` has the same leading coefficient as `P`, its degree drops", in the case
`Q = P` where the drop is automatic: shifting does not move the leading coefficient. -/
theorem translDeg_shift_sub_self_lt {q : Fin 3 → Polynomial ℝ} (hq : 0 < translDeg q) (h : ℝ) :
    translDeg (translSub (translShift q h) q) < translDeg q := by
  rw [translDeg, Finset.sup_lt_iff hq]
  intro d _
  simp only [translSub, translShift]
  by_cases hd : 0 < (q d).natDegree
  · exact lt_of_lt_of_le (natDegree_taylor_sub_lt hd h) (natDegree_le_translDeg q d)
  · have hd0 : (q d).natDegree = 0 := Nat.eq_zero_of_not_pos hd
    have hconst : Polynomial.taylor h (q d) - q d = 0 := by
      conv_lhs => rw [Polynomial.eq_C_of_natDegree_eq_zero hd0]
      simp
    rw [hconst, Polynomial.natDegree_zero]
    exact hq



/-! ## Blueprint `lem:pet-reduction`: leading-coefficient classes

"`w_d` is the number of distinct leading-coefficient classes of degree `d`."  The class of a
polynomial translation at level `d` is the triple of its degree-`d` coefficients. Two
translations of degree `d` lie in the same class exactly when their difference has degree below
`d`; this is what makes the weight drop under the step. -/

/-- The degree-`d` coefficient vector of a polynomial translation. At `d = translDeg q` it is the
leading-coefficient class of the blueprint. -/
noncomputable def leadVec (d : ℕ) (q : Fin 3 → Polynomial ℝ) : Fin 3 → ℝ :=
  fun c => (q c).coeff d

/-- Shifting a polynomial does not change any coefficient at or above its degree. -/
theorem coeff_taylor_of_natDegree_le {p : Polynomial ℝ} {d : ℕ} (hd : p.natDegree ≤ d) (h : ℝ) :
    (Polynomial.taylor h p).coeff d = p.coeff d := by
  rcases eq_or_lt_of_le hd with heq | hlt
  · rw [← heq]
    have h1 : (Polynomial.taylor h p).coeff p.natDegree = (Polynomial.taylor h p).leadingCoeff := by
      rw [Polynomial.leadingCoeff, Polynomial.natDegree_taylor]
    rw [h1, Polynomial.leadingCoeff_taylor, Polynomial.leadingCoeff]
  · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by rwa [Polynomial.natDegree_taylor]),
      Polynomial.coeff_eq_zero_of_natDegree_lt hlt]

/-- **Shifting does not change the leading-coefficient class.** This is why the selected
translation cancels against its own shift. -/
theorem leadVec_translShift {q : Fin 3 → Polynomial ℝ} {d : ℕ} (hd : translDeg q ≤ d) (h : ℝ) :
    leadVec d (translShift q h) = leadVec d q := by
  funext c
  exact coeff_taylor_of_natDegree_le
    (le_trans (natDegree_le_translDeg q c) hd) h

theorem leadVec_translSub (d : ℕ) (q r : Fin 3 → Polynomial ℝ) :
    leadVec d (translSub q r) = leadVec d q - leadVec d r := by
  funext c
  simp only [leadVec, translSub, Polynomial.coeff_sub, Pi.sub_apply]

theorem translDeg_translSub_le {q r : Fin 3 → Polynomial ℝ} {d : ℕ}
    (hq : translDeg q ≤ d) (hr : translDeg r ≤ d) : translDeg (translSub q r) ≤ d := by
  refine translDeg_le_iff.mpr fun c => ?_
  simp only [translSub]
  refine le_trans (Polynomial.natDegree_sub_le _ _) ?_
  exact max_le (le_trans (natDegree_le_translDeg q c) hq)
    (le_trans (natDegree_le_translDeg r c) hr)

/-- **Equal classes make the degree drop.** If two translations of degree at most `d` have the
same degree-`d` coefficient vector, their difference has degree below `d`. -/
theorem translDeg_translSub_lt {q r : Fin 3 → Polynomial ℝ} {d : ℕ} (hd : 0 < d)
    (hq : translDeg q ≤ d) (hr : translDeg r ≤ d) (hlead : leadVec d q = leadVec d r) :
    translDeg (translSub q r) < d := by
  refine lt_of_le_of_lt (translDeg_le_iff.mpr fun c => ?_) (Nat.sub_lt hd Nat.one_pos)
  refine Polynomial.natDegree_le_iff_coeff_eq_zero.mpr fun M hM => ?_
  have hMd : d ≤ M := by omega
  simp only [translSub, Polynomial.coeff_sub]
  rcases eq_or_lt_of_le hMd with hMeq | hMlt
  · rw [← hMeq]
    have := congrFun hlead c
    simp only [leadVec] at this
    rw [this, sub_self]
  · rw [Polynomial.coeff_eq_zero_of_natDegree_lt
      (lt_of_le_of_lt (le_trans (natDegree_le_translDeg q c) hq) hMlt),
    Polynomial.coeff_eq_zero_of_natDegree_lt
      (lt_of_le_of_lt (le_trans (natDegree_le_translDeg r c) hr) hMlt), sub_self]

/-- **Different classes keep the degree.** If the degree-`d` coefficient vectors differ, the
difference has degree exactly `d`, with coefficient vector the difference of the two. -/
theorem translDeg_translSub_eq {q r : Fin 3 → Polynomial ℝ} {d : ℕ}
    (hq : translDeg q ≤ d) (hr : translDeg r ≤ d) (hlead : leadVec d q ≠ leadVec d r) :
    translDeg (translSub q r) = d := by
  refine le_antisymm (translDeg_translSub_le hq hr) ?_
  obtain ⟨c, hc⟩ : ∃ c : Fin 3, leadVec d q c ≠ leadVec d r c := by
    by_contra hcon
    push Not at hcon
    exact hlead (funext hcon)
  have hne : (translSub q r c).coeff d ≠ 0 := by
    simp only [translSub, Polynomial.coeff_sub]
    exact sub_ne_zero_of_ne hc
  refine le_trans (Polynomial.le_natDegree_of_ne_zero hne) ?_
  exact natDegree_le_translDeg _ c



/-! ## Blueprint `lem:pet-reduction`: the weight of a configuration

"To a finite family of nonconstant polynomials attach its weight `(w_3, w_2, w_1)`, where `w_d` is
the number of distinct leading-coefficient classes of degree `d`. Order these triples
lexicographically from degree 3 downward."

The differencing polynomial is taken of **smallest** degree, not largest; with the largest the
weight need not decrease, see the ErrorReport entry of 2026-09-14. -/

open Classical in
/-- The set of leading-coefficient classes of degree `d` occurring in a family. -/
noncomputable def petClassSet (d : ℕ) (S : Finset (Fin 3 → Polynomial ℝ)) : Finset (Fin 3 → ℝ) :=
  (S.filter fun q => translDeg q = d).image (leadVec d)

open Classical in
/-- `w_d`: the number of distinct leading-coefficient classes of degree `d`. -/
noncomputable def petClasses (d : ℕ) (S : Finset (Fin 3 → Polynomial ℝ)) : ℕ :=
  (petClassSet d S).card

open Classical in
/-- One step of the recursion: every member is replaced by its shift minus the selected
translation and by itself minus the selected translation, and the constants are dropped. -/
noncomputable def petStep (h : ℝ) (P : Fin 3 → Polynomial ℝ)
    (S : Finset (Fin 3 → Polynomial ℝ)) : Finset (Fin 3 → Polynomial ℝ) :=
  (((S.image fun q => translSub (translShift q h) P) ∪ (S.image fun q => translSub q P)).filter
    fun u => 0 < translDeg u)

theorem leadVec_eq_zero_of_translDeg_lt {q : Fin 3 → Polynomial ℝ} {d : ℕ}
    (h : translDeg q < d) : leadVec d q = 0 := by
  funext c
  exact Polynomial.coeff_eq_zero_of_natDegree_lt
    (lt_of_le_of_lt (natDegree_le_translDeg q c) h)

theorem leadVec_ne_zero_of_translDeg_eq {q : Fin 3 → Polynomial ℝ} {d : ℕ} (hd : 0 < d)
    (h : translDeg q = d) : leadVec d q ≠ 0 := by
  obtain ⟨c, hc⟩ : ∃ c : Fin 3, (q c).natDegree = d := by
    by_contra hcon
    push Not at hcon
    have hlt : translDeg q < d := by
      rw [translDeg, Finset.sup_lt_iff hd]
      intro c _
      exact lt_of_le_of_ne (h ▸ natDegree_le_translDeg q c) (hcon c)
    exact absurd h (Nat.ne_of_lt hlt)
  intro h0
  have hq0 : q c ≠ 0 := by
    intro hz
    rw [hz, Polynomial.natDegree_zero] at hc
    omega
  have := congrFun h0 c
  simp only [leadVec, Pi.zero_apply] at this
  rw [← hc] at this
  exact Polynomial.leadingCoeff_ne_zero.mpr hq0 this

/-- When the selected translation has strictly smaller degree, the difference keeps the degree
and the leading-coefficient class of the other member. -/
theorem translDeg_translSub_of_lt {q P : Fin 3 → Polynomial ℝ}
    (hlt : translDeg P < translDeg q) (hq : 0 < translDeg q) :
    translDeg (translSub q P) = translDeg q := by
  refine translDeg_translSub_eq le_rfl (le_of_lt hlt) ?_
  rw [leadVec_eq_zero_of_translDeg_lt hlt]
  exact leadVec_ne_zero_of_translDeg_eq hq rfl

theorem leadVec_translSub_of_lt {q P : Fin 3 → Polynomial ℝ} {d : ℕ}
    (hP : translDeg P < d) : leadVec d (translSub q P) = leadVec d q := by
  rw [leadVec_translSub, leadVec_eq_zero_of_translDeg_lt hP, sub_zero]



theorem translDeg_translShift (q : Fin 3 → Polynomial ℝ) (h : ℝ) :
    translDeg (translShift q h) = translDeg q := by
  rw [translDeg, translDeg]
  refine Finset.sup_congr rfl fun d _ => ?_
  simp only [translShift, Polynomial.natDegree_taylor]

open Classical in
theorem mem_petStep {h : ℝ} {P u : Fin 3 → Polynomial ℝ} {S : Finset (Fin 3 → Polynomial ℝ)} :
    u ∈ petStep h P S ↔
      0 < translDeg u ∧ ∃ q ∈ S, u = translSub (translShift q h) P ∨ u = translSub q P := by
  rw [petStep, Finset.mem_filter, Finset.mem_union, Finset.mem_image, Finset.mem_image]
  constructor
  · rintro ⟨h1 | h1, h2⟩
    · obtain ⟨q, hq, hqu⟩ := h1
      exact ⟨h2, q, hq, Or.inl hqu.symm⟩
    · obtain ⟨q, hq, hqu⟩ := h1
      exact ⟨h2, q, hq, Or.inr hqu.symm⟩
  · rintro ⟨h2, q, hq, (hqu | hqu)⟩
    · exact ⟨Or.inl ⟨q, hq, hqu.symm⟩, h2⟩
    · exact ⟨Or.inr ⟨q, hq, hqu.symm⟩, h2⟩

/-- **What one step does to a member.** If the selected translation has the minimal degree `m`
and a member of the new family has degree `d ≥ m`, then it came from a member of the old family of
degree exactly `d`, and its class is the difference of the two classes. -/
theorem step_member_data {h : ℝ} {P q u : Fin 3 → Polynomial ℝ} {m d : ℕ}
    (hPdeg : translDeg P = m) (hqm : m ≤ translDeg q) (hmd : m ≤ d)
    (hu : u = translSub (translShift q h) P ∨ u = translSub q P)
    (hudeg : translDeg u = d) :
    translDeg q = d ∧ leadVec d u = leadVec d q - leadVec d P := by
  have hshift : translDeg (translShift q h) = translDeg q := translDeg_translShift q h
  have hdq : translDeg q = d := by
    rcases eq_or_lt_of_le hqm with heq | hlt
    · -- the member has the minimal degree too, so the difference drops to at most `m`
      have hle : translDeg u ≤ m := by
        rcases hu with rfl | rfl
        · exact translDeg_translSub_le (by rw [hshift, ← heq]) (le_of_eq hPdeg)
        · exact translDeg_translSub_le (by rw [← heq]) (le_of_eq hPdeg)
      omega
    · -- the member has larger degree, which the difference preserves
      have hPq : translDeg P < translDeg q := by rw [hPdeg]; exact hlt
      have hq0 : 0 < translDeg q := lt_of_le_of_lt (Nat.zero_le _) hlt
      rcases hu with rfl | rfl
      · rw [← hudeg, translDeg_translSub_of_lt (by rw [hshift]; exact hPq)
          (by rw [hshift]; exact hq0), hshift]
      · rw [← hudeg, translDeg_translSub_of_lt hPq hq0]
  refine ⟨hdq, ?_⟩
  have hqd : translDeg q ≤ d := le_of_eq hdq
  rcases hu with rfl | rfl
  · rw [leadVec_translSub, leadVec_translShift hqd]
  · rw [leadVec_translSub]

open Classical in
/-- Above the minimal degree the classes are unchanged, in particular no new ones appear. -/
theorem petClassSet_step_subset_of_lt {h : ℝ} {P : Fin 3 → Polynomial ℝ}
    {S : Finset (Fin 3 → Polynomial ℝ)} {m : ℕ}
    (hPdeg : translDeg P = m) (hmin : ∀ q ∈ S, m ≤ translDeg q) {d : ℕ} (hd : m < d) :
    petClassSet d (petStep h P S) ⊆ petClassSet d S := by
  intro v hv
  simp only [petClassSet, Finset.mem_image, Finset.mem_filter] at hv ⊢
  obtain ⟨u, ⟨huS, hudeg⟩, hvu⟩ := hv
  obtain ⟨-, q, hqS, hqu⟩ := mem_petStep.mp huS
  obtain ⟨hdq, hlead⟩ := step_member_data hPdeg (hmin q hqS) (le_of_lt hd) hqu hudeg
  refine ⟨q, ⟨hqS, hdq⟩, ?_⟩
  rw [← hvu, hlead,
    leadVec_eq_zero_of_translDeg_lt (q := P) (by rw [hPdeg]; exact hd), sub_zero]

open Classical in
/-- At the minimal degree every class of the new family is a nonzero translate of a class of the
old one. -/
theorem petClassSet_step_subset_min {h : ℝ} {P : Fin 3 → Polynomial ℝ}
    {S : Finset (Fin 3 → Polynomial ℝ)} {m : ℕ} (hm : 0 < m)
    (hPdeg : translDeg P = m) (hmin : ∀ q ∈ S, m ≤ translDeg q) :
    petClassSet m (petStep h P S)
      ⊆ ((petClassSet m S).image fun v => v - leadVec m P).erase 0 := by
  intro v hv
  simp only [petClassSet, Finset.mem_image, Finset.mem_filter] at hv
  obtain ⟨u, ⟨huS, hudeg⟩, hvu⟩ := hv
  obtain ⟨-, q, hqS, hqu⟩ := mem_petStep.mp huS
  obtain ⟨hdq, hlead⟩ := step_member_data hPdeg (hmin q hqS) le_rfl hqu hudeg
  have hvne : v ≠ 0 := by
    rw [← hvu]
    exact leadVec_ne_zero_of_translDeg_eq hm hudeg
  refine Finset.mem_erase.mpr ⟨hvne, ?_⟩
  refine Finset.mem_image.mpr ⟨leadVec m q, ?_, ?_⟩
  · exact Finset.mem_image.mpr ⟨q, Finset.mem_filter.mpr ⟨hqS, hdq⟩, rfl⟩
  · rw [← hvu, hlead]

open Classical in
/-- **The weight drops at the minimal degree.** The class of the selected translation disappears
and no new class replaces it. -/
theorem petClasses_step_lt {h : ℝ} {P : Fin 3 → Polynomial ℝ}
    {S : Finset (Fin 3 → Polynomial ℝ)} {m : ℕ} (hm : 0 < m) (hPS : P ∈ S)
    (hPdeg : translDeg P = m) (hmin : ∀ q ∈ S, m ≤ translDeg q) :
    petClasses m (petStep h P S) < petClasses m S := by
  have hPmem : leadVec m P ∈ petClassSet m S :=
    Finset.mem_image.mpr ⟨P, Finset.mem_filter.mpr ⟨hPS, hPdeg⟩, rfl⟩
  have hzero : (0 : Fin 3 → ℝ) ∈ (petClassSet m S).image fun v => v - leadVec m P :=
    Finset.mem_image.mpr ⟨leadVec m P, hPmem, sub_self _⟩
  have hcard1 : petClasses m (petStep h P S)
      ≤ (((petClassSet m S).image fun v => v - leadVec m P).erase 0).card :=
    Finset.card_le_card (petClassSet_step_subset_min hm hPdeg hmin)
  have hcard2 : (((petClassSet m S).image fun v => v - leadVec m P).erase 0).card
      = ((petClassSet m S).image fun v => v - leadVec m P).card - 1 :=
    Finset.card_erase_of_mem hzero
  have hcard3 : ((petClassSet m S).image fun v => v - leadVec m P).card
      ≤ petClasses m S := Finset.card_image_le
  have hpos : 0 < petClasses m S := Finset.card_pos.mpr ⟨leadVec m P, hPmem⟩
  omega



open Classical in
/-- **The weight triple of a configuration**, read lexicographically from degree three downward.
Degrees never increase under the step, so three levels suffice for the system `t, t^2, t^3`. -/
noncomputable def petWeight (S : Finset (Fin 3 → Polynomial ℝ)) : ℕ ×ₗ ℕ ×ₗ ℕ :=
  toLex (petClasses 3 S, toLex (petClasses 2 S, petClasses 1 S))

open Classical in
/-- **The weight decreases under one step of the recursion.** The selected translation `P` has
the minimal degree `m` of the family; at that level the number of classes drops by at least one,
and at the levels above it does not increase. This is the well-founded descent of
`lem:pet-reduction`, with the differencing polynomial of *smallest* degree -- see the ErrorReport
entry of 2026-09-14 for why the blueprint's choice of largest degree does not descend. -/
theorem petWeight_step_lt {h : ℝ} {P : Fin 3 → Polynomial ℝ}
    {S : Finset (Fin 3 → Polynomial ℝ)} {m : ℕ} (hm : 0 < m) (hm3 : m ≤ 3) (hPS : P ∈ S)
    (hPdeg : translDeg P = m) (hmin : ∀ q ∈ S, m ≤ translDeg q) :
    petWeight (petStep h P S) < petWeight S := by
  have hdrop := petClasses_step_lt (h := h) hm hPS hPdeg hmin
  have habove : ∀ d, m < d → petClasses d (petStep h P S) ≤ petClasses d S := fun d hd =>
    Finset.card_le_card (petClassSet_step_subset_of_lt hPdeg hmin hd)
  rw [petWeight, petWeight, Prod.Lex.toLex_lt_toLex]
  interval_cases m
  · -- the minimal degree is one: levels three and two do not increase
    rcases lt_or_eq_of_le (habove 3 (by norm_num)) with h3 | h3
    · exact Or.inl h3
    · refine Or.inr ⟨h3, ?_⟩
      rw [Prod.Lex.toLex_lt_toLex]
      rcases lt_or_eq_of_le (habove 2 (by norm_num)) with h2 | h2
      · exact Or.inl h2
      · exact Or.inr ⟨h2, hdrop⟩
  · -- the minimal degree is two: level three does not increase
    rcases lt_or_eq_of_le (habove 3 (by norm_num)) with h3 | h3
    · exact Or.inl h3
    · refine Or.inr ⟨h3, ?_⟩
      rw [Prod.Lex.toLex_lt_toLex]
      exact Or.inl hdrop
  · -- the minimal degree is three: the drop is at the top level
    exact Or.inl hdrop



/-! ## Blueprint `lem:pet-reduction`: the recursion terminates

"Thus the weight decreases in the well-founded lexicographic order after finitely many
repetitions. Starting with `{t, t^2, t^3}`, the resulting primitive recursion terminates at
linear polynomials." -/

open Classical in
/-- The initial family of the system `t, t^2, t^3`. -/
noncomputable def petInit : Finset (Fin 3 → Polynomial ℝ) :=
  {curveTransl 0, curveTransl 1, curveTransl 2}

open Classical in
theorem petInit_deg : ∀ q ∈ petInit, 0 < translDeg q ∧ translDeg q ≤ 3 := by
  intro q hq
  simp only [petInit, Finset.mem_insert, Finset.mem_singleton] at hq
  rcases hq with rfl | rfl | rfl <;> rw [translDeg_curveTransl] <;> norm_num [expo]

open Classical in
/-- The step preserves the standing bounds on the degrees: the constants are dropped, and no
degree can grow above the largest one present. -/
theorem petStep_deg {h : ℝ} {P : Fin 3 → Polynomial ℝ} {S : Finset (Fin 3 → Polynomial ℝ)}
    (hP : translDeg P ≤ 3) (hS : ∀ q ∈ S, translDeg q ≤ 3) :
    ∀ u ∈ petStep h P S, 0 < translDeg u ∧ translDeg u ≤ 3 := by
  intro u hu
  obtain ⟨hu0, q, hqS, hqu⟩ := mem_petStep.mp hu
  refine ⟨hu0, ?_⟩
  rcases hqu with rfl | rfl
  · exact translDeg_translSub_le (by rw [translDeg_translShift]; exact hS q hqS) hP
  · exact translDeg_translSub_le (hS q hqS) hP

open Classical in
/-- **The recursion terminates.** Any run in which each family is obtained from the previous one
by a step whose selected translation has minimal degree reaches the empty family, because the
weight strictly decreases in a well-founded order. -/
theorem petStep_terminates (F : ℕ → Finset (Fin 3 → Polynomial ℝ))
    (hdeg : ∀ n, ∀ q ∈ F n, 0 < translDeg q ∧ translDeg q ≤ 3)
    (hstep : ∀ n, F n ≠ ∅ → ∃ (h : ℝ) (P : Fin 3 → Polynomial ℝ), P ∈ F n ∧
      (∀ q ∈ F n, translDeg P ≤ translDeg q) ∧ F (n + 1) = petStep h P (F n)) :
    ∃ n, F n = ∅ := by
  by_contra hcon
  push Not at hcon
  have hdec : ∀ n, petWeight (F (n + 1)) < petWeight (F n) := by
    intro n
    obtain ⟨h, P, hPS, hPmin, hF⟩ := hstep n (Finset.nonempty_iff_ne_empty.mp (hcon n))
    obtain ⟨hP0, hP3⟩ := hdeg n P hPS
    rw [hF]
    exact petWeight_step_lt hP0 hP3 hPS rfl fun q hq => hPmin q hq
  obtain ⟨w, hw, hmin⟩ := (wellFounded_lt (α := ℕ ×ₗ ℕ ×ₗ ℕ)).has_min
    (Set.range fun n => petWeight (F n)) ⟨_, ⟨0, rfl⟩⟩
  obtain ⟨n, rfl⟩ := hw
  exact hmin _ ⟨n + 1, rfl⟩ (hdec n)



/-! ## Blueprint `lem:pet-reduction`: the `delta` bookkeeping

"At each use of van der Corput take `H = c delta^C N` in the current normalized parameter.  The
boundary error in `lem:fejer-vdc` is then at most half the current lower bound after enlarging
`C`. Pigeonholing the difference variable loses only a fixed power of `delta`. ... All
recurrences are inequalities between natural powers of `delta`."

The three ingredients are isolated here: the shift is small enough that the boundary error is
absorbed, the Fejer average is attained up to a factor two at some shift, and a finite
composition of maps `delta -> c delta^C` is again of that shape. -/

/-- Choosing the shift this small makes the boundary error of `lem:fejer-vdc` at most half of the
square of the current lower bound. -/
theorem vdc_boundary_small {H N ρ : ℝ} (hN : 0 < N)
    (hH : H ≤ ρ ^ 2 * N / 24) : 12 * H / N ≤ ρ ^ 2 / 2 := by
  have h1 : 12 * H ≤ 12 * (ρ ^ 2 * N / 24) := by linarith
  calc 12 * H / N ≤ 12 * (ρ ^ 2 * N / 24) / N := div_le_div_of_nonneg_right h1 hN.le
    _ = ρ ^ 2 / 2 := by field_simp; ring

/-- **The step squares the lower bound.** Once the boundary error is at most half of it, the
Fejer average inherits a lower bound of the same shape, smaller by the fixed factor eight. -/
theorem vdc_boundary_absorb {X Y ρ b : ℝ} (hρ : 0 < ρ) (hX : ρ ≤ X)
    (hb : b ≤ ρ ^ 2 / 2) (hstep : X ^ 2 ≤ 4 * Y + b) : ρ ^ 2 / 8 ≤ Y := by
  have hsq : ρ ^ 2 ≤ X ^ 2 := by nlinarith
  linarith

open MeasureTheory in
/-- **Pigeonholing the difference variable.** A Fejer average bounded below is attained, up to a
factor two, at some shift; the Fejer kernel is a probability density, so a uniformly smaller
integrand could not reach the bound. -/
theorem exists_of_fejer_average_ge {H β : ℝ} (hH : 0 < H) (hβ : 0 < β) {g : ℝ → ℝ}
    (hgm : Measurable g) {M : ℝ} (hgM : ∀ h, |g h| ≤ M)
    (hge : β ≤ ∫ h : ℝ, fejer H h * g h) : ∃ h : ℝ, β / 2 ≤ g h := by
  by_contra hcon
  push Not at hcon
  have hle : (∫ h : ℝ, fejer H h * g h) ≤ ∫ h : ℝ, fejer H h * (β / 2) := by
    refine integral_mono (integrable_fejer_mul hH hgm hgM)
      ((integrable_fejer hH).mul_const _) fun h => ?_
    exact mul_le_mul_of_nonneg_left (le_of_lt (hcon h)) (fejer_nonneg hH h)
  rw [integral_mul_const, integral_fejer hH, one_mul] at hle
  linarith

/-- **All recurrences are powers of `delta`.** A finite composition of maps `x -> c x^C` is again
a map of that shape, so a fixed number of steps costs only a fixed power. -/
theorem exists_pow_iterate {c C : ℝ} (hc : 0 < c) (hC : 1 ≤ C) : ∀ n : ℕ,
    ∃ c' C' : ℝ, 0 < c' ∧ 1 ≤ C' ∧ ∀ δ : ℝ, 0 < δ →
      (fun x => c * x ^ C)^[n] δ = c' * δ ^ C' := by
  intro n
  induction n with
  | zero => exact ⟨1, 1, one_pos, le_refl 1, fun δ _ => by simp⟩
  | succ n ih =>
      obtain ⟨c', C', hc', hC', hfn⟩ := ih
      refine ⟨c * c' ^ C, C' * C, by positivity, by nlinarith, fun δ hδ => ?_⟩
      rw [Function.iterate_succ_apply', hfn δ hδ,
        Real.mul_rpow hc'.le (Real.rpow_nonneg hδ.le _), ← Real.rpow_mul hδ.le]
      ring



/-! ## Blueprint `lem:pet-reduction`: configurations and their averages

The van der Corput step does not preserve the shape "three functions along the three monomial
curves": it doubles the number of factors and replaces the curves by polynomial translations.  The
shape it does preserve is a *configuration*: a finite family of one-bounded functions, each
translated along its own polynomial translation. One step sends a configuration indexed by `iota`
to one indexed by `iota x Bool`, the two copies carrying the shifted and the conjugated factor. -/

/-- The integrand of a configuration at a point and a parameter. -/
noncomputable def cfgProd {ι : Type*} [Fintype ι] (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (x : E3) (t : ℝ) : ℂ :=
  ∏ a : ι, g a (x + translAct (γ a) t)

/-- The average of a configuration over the parameter interval. -/
noncomputable def cfgAvg {ι : Type*} [Fintype ι] (N : ℝ) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (x : E3) : ℂ :=
  N⁻¹ • ∫ t in (0 : ℝ)..N, cfgProd g γ x t

theorem norm_cfgProd_le {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    (hg : ∀ a x, ‖g a x‖ ≤ 1) (γ : ι → (Fin 3 → Polynomial ℝ)) (x : E3) (t : ℝ) :
    ‖cfgProd g γ x t‖ ≤ 1 := by
  rw [cfgProd, norm_prod]
  exact Finset.prod_le_one₀ (fun a _ => norm_nonneg _) fun a _ => hg a _

theorem continuous_cfgProd {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    (hg : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ)) (x : E3) :
    Continuous (cfgProd g γ x) := by
  refine continuous_finsetProd _ fun a _ => ?_
  exact (hg a).comp (continuous_const.add (continuous_translAct (γ a)))

/-- The monomial system is the configuration of the three curves. -/
theorem cfgAvg_curveTransl (N : ℝ) (f : Fin 3 → E3 → ℂ) (x : E3) :
    cfgAvg N f curveTransl x = A N f x := by
  rw [cfgAvg, A_eq_smul]
  congr 1
  refine intervalIntegral.integral_congr fun t _ => ?_
  rw [cfgProd, prodShift]
  exact Finset.prod_congr rfl fun i _ => by rw [translAct_curveTransl]

/-- The functions of the differenced configuration: the shifted copy and the conjugated one. -/
noncomputable def dcfgFun {ι : Type*} (g : ι → E3 → ℂ) : ι × Bool → E3 → ℂ :=
  fun p => if p.2 then g p.1 else fun y => (starRingEnd ℂ) (g p.1 y)

/-- The translations of the differenced configuration. -/
noncomputable def dcfgTransl {ι : Type*} (γ : ι → (Fin 3 → Polynomial ℝ)) (h : ℝ) :
    ι × Bool → (Fin 3 → Polynomial ℝ) :=
  fun p => if p.2 then translShift (γ p.1) h else γ p.1

theorem norm_dcfgFun_le {ι : Type*} {g : ι → E3 → ℂ} (hg : ∀ a x, ‖g a x‖ ≤ 1)
    (p : ι × Bool) (x : E3) : ‖dcfgFun g p x‖ ≤ 1 := by
  rw [dcfgFun]
  by_cases hp : p.2
  · simpa [hp] using hg p.1 x
  · simpa [hp] using hg p.1 x

theorem continuous_dcfgFun {ι : Type*} {g : ι → E3 → ℂ} (hg : ∀ a, Continuous (g a))
    (p : ι × Bool) : Continuous (dcfgFun g p) := by
  rw [dcfgFun]
  by_cases hp : p.2
  · simpa [hp] using hg p.1
  · simpa [hp, Function.comp_def] using Complex.continuous_conj.comp (hg p.1)

/-- **The differenced configuration computes the difference of the product.** -/
theorem cfgProd_dcfg {ι : Type*} [Fintype ι] (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (h : ℝ) (x : E3) (t : ℝ) :
    cfgProd (dcfgFun g) (dcfgTransl γ h) x t
      = cfgProd g γ x (t + h) * (starRingEnd ℂ) (cfgProd g γ x t) := by
  rw [cfgProd, Fintype.prod_prod_type]
  rw [cfgProd, cfgProd, map_prod, ← Finset.prod_mul_distrib]
  refine Finset.prod_congr rfl fun a _ => ?_
  rw [Fintype.prod_bool]
  simp only [dcfgFun, dcfgTransl, ite_eq_left, ite_eq_right, Bool.false_eq_true, not_false_eq_true]
  rw [translAct_translShift]

open MeasureTheory in
/-- **One van der Corput step in configuration form.** The square of the average of a
configuration is controlled by the Fejer average of the averages of its differenced
configurations, up to the boundary error. -/
theorem sq_norm_cfgAvg_le {ι : Type*} [Fintype ι] {N H : ℝ} (hN : 0 < N) (hH : 0 < H)
    (hHN : H ≤ N / 4) {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a))
    (hg1 : ∀ a x, ‖g a x‖ ≤ 1) (γ : ι → (Fin 3 → Polynomial ℝ)) (x : E3) :
    ‖cfgAvg N g γ x‖ ^ 2
      ≤ 4 * (∫ h : ℝ, fejer H h * ‖cfgAvg N (dcfgFun g) (dcfgTransl γ h) x‖)
        + 12 * H / N := by
  have hFm : Measurable (cfgProd g γ x) := (continuous_cfgProd hgc γ x).measurable
  have hF1 : ∀ t, ‖cfgProd g γ x t‖ ≤ 1 := norm_cfgProd_le hg1 γ x
  have hvdc := fejer_vdc' hFm hF1 hN hH hHN 0
  rw [zero_add] at hvdc
  have hint : ∀ h : ℝ,
      (∫ t in (0 : ℝ)..N, cfgProd g γ x (t + h) * (starRingEnd ℂ) (cfgProd g γ x t))
        = ∫ t in (0 : ℝ)..N, cfgProd (dcfgFun g) (dcfgTransl γ h) x t := fun h =>
    intervalIntegral.integral_congr fun t _ => (cfgProd_dcfg g γ h x t).symm
  simp only [hint] at hvdc
  exact hvdc



/-! ## Blueprint `lem:pet-reduction`: the two inequalities that let the step iterate

The van der Corput step leaves a modulus inside the parameter average, which blocks the next
translation. The standard remedy is to pass back to `L^2` after each step: Cauchy-Schwarz in the
point turns the `L^1` norm of the differenced average into the square root of its `L^2` norm, and
Cauchy-Schwarz in the shift turns the Fejer average of a square root into the square root of the
Fejer average. Both are recorded here. -/

open MeasureTheory in
/-- **Cauchy-Schwarz in the shift.** The Fejer density is a probability density, so the Fejer
average of a square root is at most the square root of the Fejer average. -/
theorem fejer_average_sqrt_le {H : ℝ} (hH : 0 < H) {g : ℝ → ℝ} (hgm : Measurable g)
    (hg0 : ∀ t, 0 ≤ g t) {M : ℝ} (hgM : ∀ t, g t ≤ M) :
    (∫ h : ℝ, fejer H h * Real.sqrt (g h)) ≤ Real.sqrt (∫ h : ℝ, fejer H h * g h) := by
  have hM0 : 0 ≤ M := le_trans (hg0 0) (hgM 0)
  have hsqm : Measurable fun t => Real.sqrt (g t) := Real.continuous_sqrt.measurable.comp hgm
  have hsqb : ∀ t, |Real.sqrt (g t)| ≤ Real.sqrt M := by
    intro t
    rw [abs_of_nonneg (Real.sqrt_nonneg _)]
    exact Real.sqrt_le_sqrt (hgM t)
  have hsq := sq_integral_fejer_le hH hsqm hsqb
  have hcongr : (∫ h : ℝ, fejer H h * Real.sqrt (g h) ^ 2) = ∫ h : ℝ, fejer H h * g h := by
    refine integral_congr_ae (Filter.Eventually.of_forall fun h => ?_)
    simp only [Real.sq_sqrt (hg0 h)]
  rw [hcongr] at hsq
  have hnn : 0 ≤ ∫ h : ℝ, fejer H h * Real.sqrt (g h) :=
    integral_nonneg fun h => mul_nonneg (fejer_nonneg hH h) (Real.sqrt_nonneg _)
  have hrad : 0 ≤ ∫ h : ℝ, fejer H h * g h :=
    integral_nonneg fun h => mul_nonneg (fejer_nonneg hH h) (hg0 h)
  exact (Real.le_sqrt hnn hrad).mpr hsq

open MeasureTheory in
/-- **Cauchy-Schwarz in the point.** On a set of finite measure the `L^1` norm is at most the
square root of the measure times the `L^2` norm. -/
theorem lintegral_enorm_le_sqrt {B : Set E3} {u : E3 → ℂ}
    (hu : AEMeasurable u (volume.restrict B)) :
    (∫⁻ x in B, ‖u x‖ₑ)
      ≤ (volume B) ^ ((1 : ℝ) / 2) * (∫⁻ x in B, ‖u x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2) := by
  have hconj : Real.HolderConjugate 2 2 := ⟨by norm_num, by norm_num, by norm_num⟩
  have hol := ENNReal.lintegral_mul_le_Lp_mul_Lq (volume.restrict B) hconj
    (aemeasurable_const (b := (1 : ℝ≥0∞))) hu.enorm
  simp only [Pi.mul_apply, one_mul, ENNReal.one_rpow, lintegral_const, one_mul] at hol
  rw [Measure.restrict_apply_univ] at hol
  exact hol



/-! ## Blueprint `lem:pet-reduction`: the differenced average as a function of the shift

For the recursion the differenced average has to be handled jointly in the point and the shift:
the Fejer average is taken in the shift, and the point is then integrated over the box. Writing
it through `Auto.cfgProd` rather than through `Auto.dcfgTransl` makes the joint continuity
immediate, since the shift enters only as a translation of the parameter. -/
theorem continuous_uncurry_cfgProd {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    (hg : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ)) :
    Continuous fun z : E3 × ℝ => cfgProd g γ z.1 z.2 := by
  refine continuous_finsetProd _ fun a _ => ?_
  exact (hg a).comp (continuous_fst.add ((continuous_translAct (γ a)).comp continuous_snd))

open MeasureTheory in
theorem continuous_cfgAvg {ι : Type*} [Fintype ι] (N : ℝ) {g : ι → E3 → ℂ}
    (hg : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ)) :
    Continuous (cfgAvg N g γ) := by
  have hc : Continuous fun x : E3 => ∫ t in (0 : ℝ)..N, cfgProd g γ x t :=
    intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
      (continuous_uncurry_cfgProd hg γ) 0 N
  exact hc.const_smul (N⁻¹ : ℝ)

open MeasureTheory in
theorem norm_cfgAvg_le {ι : Type*} [Fintype ι] {N : ℝ} (hN : 0 < N) {g : ι → E3 → ℂ}
    (hg1 : ∀ a x, ‖g a x‖ ≤ 1) (γ : ι → (Fin 3 → Polynomial ℝ)) (x : E3) :
    ‖cfgAvg N g γ x‖ ≤ 1 := by
  rw [cfgAvg, norm_smul, Real.norm_eq_abs, abs_of_nonneg (by positivity : (0 : ℝ) ≤ N⁻¹)]
  have hb : ∀ t ∈ Set.uIoc (0 : ℝ) N, ‖cfgProd g γ x t‖ ≤ 1 := fun t _ =>
    norm_cfgProd_le hg1 γ x t
  have hint := intervalIntegral.norm_integral_le_of_norm_le_const hb
  rw [sub_zero, abs_of_pos hN] at hint
  calc N⁻¹ * ‖∫ t in (0 : ℝ)..N, cfgProd g γ x t‖ ≤ N⁻¹ * (1 * N) :=
        mul_le_mul_of_nonneg_left hint (by positivity)
    _ = 1 := by field_simp

/-- The differenced average, as a function of the point and the shift. -/
noncomputable def dAvg {ι : Type*} [Fintype ι] (N : ℝ) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (x : E3) (h : ℝ) : ℂ :=
  N⁻¹ • ∫ t in (0 : ℝ)..N, cfgProd g γ x (t + h) * (starRingEnd ℂ) (cfgProd g γ x t)

theorem dAvg_eq {ι : Type*} [Fintype ι] (N : ℝ) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (x : E3) (h : ℝ) :
    dAvg N g γ x h = cfgAvg N (dcfgFun g) (dcfgTransl γ h) x := by
  rw [dAvg, cfgAvg]
  congr 1
  exact intervalIntegral.integral_congr fun t _ => (cfgProd_dcfg g γ h x t).symm

open MeasureTheory in
/-- The differenced average is jointly continuous in the point and the shift. -/
theorem continuous_uncurry_dAvg {ι : Type*} [Fintype ι] (N : ℝ) {g : ι → E3 → ℂ}
    (hg : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ)) :
    Continuous fun p : E3 × ℝ => dAvg N g γ p.1 p.2 := by
  have hc := continuous_uncurry_cfgProd hg γ
  have hb : Continuous fun p : E3 × ℝ =>
      ∫ t in (0 : ℝ)..N, cfgProd g γ p.1 (t + p.2) * (starRingEnd ℂ) (cfgProd g γ p.1 t) := by
    refine intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' ?_ 0 N
    refine Continuous.mul ?_ ?_
    · exact hc.comp ((continuous_fst.comp continuous_fst).prodMk
        (continuous_snd.add (continuous_snd.comp continuous_fst)))
    · exact Complex.continuous_conj.comp
        (hc.comp ((continuous_fst.comp continuous_fst).prodMk continuous_snd))
  exact hb.const_smul (N⁻¹ : ℝ)

open MeasureTheory in
theorem norm_dAvg_le {ι : Type*} [Fintype ι] {N : ℝ} (hN : 0 < N) {g : ι → E3 → ℂ}
    (hg1 : ∀ a x, ‖g a x‖ ≤ 1) (γ : ι → (Fin 3 → Polynomial ℝ)) (x : E3) (h : ℝ) :
    ‖dAvg N g γ x h‖ ≤ 1 := by
  rw [dAvg_eq]
  exact norm_cfgAvg_le hN (norm_dcfgFun_le hg1) _ x

open MeasureTheory in
/-- **One van der Corput step**, with the differenced average written as a function of the
shift. -/
theorem sq_norm_cfgAvg_le' {ι : Type*} [Fintype ι] {N H : ℝ} (hN : 0 < N) (hH : 0 < H)
    (hHN : H ≤ N / 4) {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a))
    (hg1 : ∀ a x, ‖g a x‖ ≤ 1) (γ : ι → (Fin 3 → Polynomial ℝ)) (x : E3) :
    ‖cfgAvg N g γ x‖ ^ 2
      ≤ 4 * (∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖) + 12 * H / N := by
  simp only [dAvg_eq]
  exact sq_norm_cfgAvg_le hN hH hHN hgc hg1 γ x



/-- The algebraic core of Cauchy-Schwarz: a quadratic in `c` that is nonnegative everywhere has
nonpositive discriminant. -/
theorem sq_le_of_quadratic_nonneg {I J V : ℝ} (hV : 0 < V)
    (h : ∀ c : ℝ, 0 ≤ J - 2 * c * I + c ^ 2 * V) : I ^ 2 ≤ V * J := by
  have h1 := h (I / V)
  have hVne : V ≠ 0 := ne_of_gt hV
  have h2 : J - 2 * (I / V) * I + (I / V) ^ 2 * V = J - I ^ 2 / V := by
    field_simp
    ring
  rw [h2, sub_nonneg, div_le_iff₀ hV] at h1
  linarith

open MeasureTheory in
/-- **Cauchy-Schwarz on a set of finite measure**, in real form: the square of the integral is at
most the measure times the integral of the square. Proved by expanding the square of `u - c` and
choosing `c` to be the mean. -/
theorem sq_setIntegral_le {B : Set E3} (hBfin : volume B ≠ ⊤)
    {u : E3 → ℝ} (hum : Measurable u) (hu0 : ∀ x, 0 ≤ u x) (hub : ∀ x, u x ≤ 1) :
    (∫ x in B, u x) ^ 2 ≤ (volume B).toReal * ∫ x in B, u x ^ 2 := by
  have : IsFiniteMeasure (volume.restrict B) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact lt_of_le_of_ne le_top hBfin⟩
  set V := (volume B).toReal with hV
  set I := ∫ x in B, u x with hI
  set J := ∫ x in B, u x ^ 2 with hJ
  have hu1 : Integrable u (volume.restrict B) := by
    refine Integrable.mono' (integrable_const (1 : ℝ)) hum.aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (hu0 x)]
    exact hub x
  have hu2 : Integrable (fun x => u x ^ 2) (volume.restrict B) := by
    refine Integrable.mono' (integrable_const (1 : ℝ)) (hum.pow_const 2).aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    nlinarith [hu0 x, hub x]
  have hVeq : (∫ _x in B, (1 : ℝ)) = V := by
    rw [setIntegral_const, smul_eq_mul, mul_one, hV, measureReal_def]
  have hexp : ∀ c : ℝ, 0 ≤ J - 2 * c * I + c ^ 2 * V := by
    intro c
    have hnn : 0 ≤ ∫ x in B, (u x - c) ^ 2 := integral_nonneg fun x => sq_nonneg _
    have hsub : Integrable (fun x => u x ^ 2 - 2 * c * u x) (volume.restrict B) := by
      exact hu2.sub (hu1.const_mul (2 * c))
    have hc2 : Integrable (fun _ : E3 => c ^ 2 * (1 : ℝ)) (volume.restrict B) :=
      (integrable_const (1 : ℝ)).const_mul (c ^ 2)
    have h1 : (∫ x in B, (u x - c) ^ 2)
        = ∫ x in B, (u x ^ 2 - 2 * c * u x + c ^ 2 * 1) :=
      integral_congr_ae (Filter.Eventually.of_forall fun x => by ring)
    rw [h1, integral_add hsub hc2, integral_sub hu2 (hu1.const_mul (2 * c)),
      integral_const_mul, integral_const_mul, hVeq] at hnn
    exact hnn
  rcases eq_or_lt_of_le (ENNReal.toReal_nonneg (a := volume B)) with hV0 | hV0
  · have hzero : volume B = 0 :=
      ((ENNReal.toReal_eq_zero_iff _).mp hV0.symm).resolve_right hBfin
    have hI0 : I = 0 := by rw [hI, Measure.restrict_eq_zero.mpr hzero, integral_zero_measure]
    have hJ0 : J = 0 := by rw [hJ, Measure.restrict_eq_zero.mpr hzero, integral_zero_measure]
    rw [hI0, hJ0]
    norm_num
  · exact sq_le_of_quadratic_nonneg hV0 hexp

open MeasureTheory in
/-- **The point and the shift may be exchanged.** The integrand is bounded by the Fejer weight,
which is integrable, and the box has finite measure. -/
theorem integral_fejer_dAvg_swap {ι : Type*} [Fintype ι] {N H : ℝ} (hN : 0 < N) (hH : 0 < H)
    {B : Set E3} (hBfin : volume B ≠ ⊤) {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a))
    (hg1 : ∀ a x, ‖g a x‖ ≤ 1) (γ : ι → (Fin 3 → Polynomial ℝ)) :
    (∫ x in B, ∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖)
      = ∫ h : ℝ, fejer H h * ∫ x in B, ‖dAvg N g γ x h‖ := by
  have : IsFiniteMeasure (volume.restrict B) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact lt_of_le_of_ne le_top hBfin⟩
  have hcont : Continuous fun p : E3 × ℝ => fejer H p.2 * ‖dAvg N g γ p.1 p.2‖ :=
    (continuous_fejer.comp continuous_snd).mul (continuous_uncurry_dAvg N hgc γ).norm
  have hint : Integrable (Function.uncurry fun (x : E3) (h : ℝ) =>
      fejer H h * ‖dAvg N g γ x h‖) ((volume.restrict B).prod volume) := by
    have huc : (Function.uncurry fun (x : E3) (h : ℝ) => fejer H h * ‖dAvg N g γ x h‖)
        = fun p : E3 × ℝ => fejer H p.2 * ‖dAvg N g γ p.1 p.2‖ := rfl
    rw [huc]
    refine Integrable.mono' (g := fun p : E3 × ℝ => (1 : ℝ) * fejer H p.2)
      (MeasureTheory.Integrable.mul_prod (integrable_const (1 : ℝ)) (integrable_fejer hH))
      hcont.aestronglyMeasurable (Filter.Eventually.of_forall fun p => ?_)
    rw [Real.norm_eq_abs,
      abs_of_nonneg (mul_nonneg (fejer_nonneg hH p.2) (norm_nonneg _)), one_mul, mul_comm]
    exact mul_le_of_le_one_left (fejer_nonneg hH p.2) (norm_dAvg_le hN hg1 γ p.1 p.2)
  rw [integral_integral_swap hint]
  refine integral_congr_ae (Filter.Eventually.of_forall fun h => ?_)
  exact integral_const_mul _ _



/-! ## Blueprint `lem:pet-reduction`: the recursion for the `L^2` functional

The quantity that iterates is the `L^2` norm of the average over the box. One van der Corput step
followed by Cauchy-Schwarz in the point and in the shift gives
  `Phi <= 4 vol^{1/2} (avg_h Phi_h)^{1/2} + 12 H vol / N`,

which is the recursion the induction runs on: a lower bound on `Phi`, with the boundary error
absorbed, forces a lower bound on `avg_h Phi_h` and hence, by pigeonholing, on a single `Phi_h`. -/

open MeasureTheory in
/-- The `L^2` norm of the average of a configuration over the box. -/
noncomputable def cfgL2 {ι : Type*} [Fintype ι] (N : ℝ) (B : Set E3) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) : ℝ :=
  ∫ x in B, ‖cfgAvg N g γ x‖ ^ 2

open MeasureTheory in
theorem cfgL2_eq_dAvg {ι : Type*} [Fintype ι] (N : ℝ) (B : Set E3) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (h : ℝ) :
    cfgL2 N B (dcfgFun g) (dcfgTransl γ h) = ∫ x in B, ‖dAvg N g γ x h‖ ^ 2 := by
  rw [cfgL2]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
  simp only [dAvg_eq]

open MeasureTheory in
theorem cfgL2_nonneg {ι : Type*} [Fintype ι] (N : ℝ) (B : Set E3) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) : 0 ≤ cfgL2 N B g γ :=
  integral_nonneg fun _x => sq_nonneg _

open MeasureTheory in
theorem measurable_cfgL2_shift {ι : Type*} [Fintype ι] (N : ℝ) (B : Set E3)
    {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ)) :
    Measurable fun h : ℝ => cfgL2 N B (dcfgFun g) (dcfgTransl γ h) := by
  have hcongr : (fun h : ℝ => cfgL2 N B (dcfgFun g) (dcfgTransl γ h))
      = fun h : ℝ => ∫ x in B, ‖dAvg N g γ x h‖ ^ 2 := by
    funext h
    exact cfgL2_eq_dAvg N B g γ h
  rw [hcongr]
  have hjoint : StronglyMeasurable fun q : ℝ × E3 => ‖dAvg N g γ q.2 q.1‖ ^ 2 :=
    Continuous.stronglyMeasurable
      ((((continuous_uncurry_dAvg N hgc γ).comp
        (continuous_snd.prodMk continuous_fst)).norm).pow 2)
  exact (hjoint.integral_prod_right' (ν := volume.restrict B)).measurable

open MeasureTheory in
theorem cfgL2_le_volume {ι : Type*} [Fintype ι] {N : ℝ} (hN : 0 < N) {B : Set E3}
    (hBfin : volume B ≠ ⊤) {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a))
    (hg1 : ∀ a x, ‖g a x‖ ≤ 1) (γ : ι → (Fin 3 → Polynomial ℝ)) :
    cfgL2 N B g γ ≤ (volume B).toReal := by
  have : IsFiniteMeasure (volume.restrict B) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact lt_of_le_of_ne le_top hBfin⟩
  have hint : Integrable (fun x : E3 => ‖cfgAvg N g γ x‖ ^ 2) (volume.restrict B) := by
    refine Integrable.mono' (integrable_const (1 : ℝ))
      (((continuous_cfgAvg N hgc γ).norm.pow 2)).aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    nlinarith [norm_nonneg (cfgAvg N g γ x), norm_cfgAvg_le hN hg1 γ x]
  have hmono : (∫ x in B, ‖cfgAvg N g γ x‖ ^ 2) ≤ ∫ _x in B, (1 : ℝ) := by
    refine integral_mono hint (integrable_const (1 : ℝ)) fun x => ?_
    nlinarith [norm_nonneg (cfgAvg N g γ x), norm_cfgAvg_le hN hg1 γ x]
  rw [setIntegral_const, smul_eq_mul, mul_one, measureReal_def] at hmono
  exact hmono



open MeasureTheory in
theorem measurable_fejerAvg_dAvg {ι : Type*} [Fintype ι] (N H : ℝ) {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ)) :
    Measurable fun x : E3 => ∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖ := by
  have hjoint : StronglyMeasurable fun q : E3 × ℝ => fejer H q.2 * ‖dAvg N g γ q.1 q.2‖ :=
    Continuous.stronglyMeasurable
      ((continuous_fejer.comp continuous_snd).mul (continuous_uncurry_dAvg N hgc γ).norm)
  exact (hjoint.integral_prod_right' (ν := (volume : Measure ℝ))).measurable

open MeasureTheory in
theorem measurable_setIntegral_dAvg {ι : Type*} [Fintype ι] (N : ℝ) (B : Set E3)
    {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ)) :
    Measurable fun h : ℝ => ∫ x in B, ‖dAvg N g γ x h‖ := by
  have hjoint : StronglyMeasurable fun q : ℝ × E3 => ‖dAvg N g γ q.2 q.1‖ :=
    Continuous.stronglyMeasurable
      (((continuous_uncurry_dAvg N hgc γ).comp (continuous_snd.prodMk continuous_fst)).norm)
  exact (hjoint.integral_prod_right' (ν := volume.restrict B)).measurable

open MeasureTheory in
/-- **The one-step recursion for the `L^2` functional.** One van der Corput step, then
Cauchy-Schwarz in the point and in the shift. -/
theorem cfgL2_step {ι : Type*} [Fintype ι] {N H : ℝ} (hN : 0 < N) (hH : 0 < H)
    (hHN : H ≤ N / 4) {B : Set E3} (hBfin : volume B ≠ ⊤) {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) (hg1 : ∀ a x, ‖g a x‖ ≤ 1)
    (γ : ι → (Fin 3 → Polynomial ℝ)) :
    cfgL2 N B g γ
      ≤ 4 * (Real.sqrt ((volume B).toReal)
          * Real.sqrt (∫ h : ℝ, fejer H h * cfgL2 N B (dcfgFun g) (dcfgTransl γ h)))
        + 12 * H / N * (volume B).toReal := by
  have : IsFiniteMeasure (volume.restrict B) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact lt_of_le_of_ne le_top hBfin⟩
  have hV0 : (0 : ℝ) ≤ (volume B).toReal := ENNReal.toReal_nonneg
  have hdm : ∀ x : E3, Measurable fun h : ℝ => ‖dAvg N g γ x h‖ := fun x =>
    ((continuous_uncurry_dAvg N hgc γ).comp
      (continuous_const.prodMk continuous_id)).norm.measurable
  have hdb : ∀ (x : E3) (h : ℝ), |‖dAvg N g γ x h‖| ≤ 1 := by
    intro x h
    rw [abs_of_nonneg (norm_nonneg _)]
    exact norm_dAvg_le hN hg1 γ x h
  have hΨ0 : ∀ x : E3, 0 ≤ ∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖ := fun x =>
    integral_nonneg fun h => mul_nonneg (fejer_nonneg hH h) (norm_nonneg _)
  have hΨ1 : ∀ x : E3, (∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖) ≤ 1 := by
    intro x
    have hi1 := integrable_fejer_mul hH (hdm x) (hdb x)
    have hi2 : Integrable fun h : ℝ => fejer H h * (1 : ℝ) :=
      integrable_fejer_mul hH measurable_const (M := 1) fun _ => by norm_num
    calc (∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖) ≤ ∫ h : ℝ, fejer H h * (1 : ℝ) := by
          refine integral_mono hi1 hi2 fun h => ?_
          exact mul_le_mul_of_nonneg_left (norm_dAvg_le hN hg1 γ x h) (fejer_nonneg hH h)
      _ = 1 := by rw [integral_mul_const, integral_fejer hH, one_mul]
  have hΨm : Measurable fun x : E3 => ∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖ :=
    measurable_fejerAvg_dAvg N H hgc γ
  have hintΨ : Integrable (fun x : E3 => ∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖)
      (volume.restrict B) := by
    refine Integrable.mono' (integrable_const (1 : ℝ)) hΨm.aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (hΨ0 x)]
    exact hΨ1 x
  -- the pointwise van der Corput step, integrated over the box
  have hintL : Integrable (fun x : E3 => ‖cfgAvg N g γ x‖ ^ 2) (volume.restrict B) := by
    refine Integrable.mono' (integrable_const (1 : ℝ))
      ((continuous_cfgAvg N hgc γ).norm.pow 2).aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    nlinarith [norm_nonneg (cfgAvg N g γ x), norm_cfgAvg_le hN hg1 γ x]
  have hintR : Integrable
      (fun x : E3 => 4 * (∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖) + 12 * H / N)
      (volume.restrict B) := (hintΨ.const_mul 4).add (integrable_const _)
  have hstep1 : cfgL2 N B g γ
      ≤ ∫ x in B, (4 * (∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖) + 12 * H / N) := by
    rw [cfgL2]
    exact integral_mono hintL hintR fun x => sq_norm_cfgAvg_le' hN hH hHN hgc hg1 γ x
  have hsplit : (∫ x in B, (4 * (∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖) + 12 * H / N))
      = 4 * (∫ x in B, ∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖)
        + 12 * H / N * (volume B).toReal := by
    rw [integral_add (hintΨ.const_mul 4) (integrable_const _), integral_const_mul,
      setIntegral_const, smul_eq_mul, measureReal_def]
    ring
  -- exchange the point and the shift
  have hfub : (∫ x in B, ∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖)
      = ∫ h : ℝ, fejer H h * ∫ x in B, ‖dAvg N g γ x h‖ :=
    integral_fejer_dAvg_swap hN hH hBfin hgc hg1 γ
  -- Cauchy-Schwarz in the point
  have hcs : ∀ h : ℝ, (∫ x in B, ‖dAvg N g γ x h‖)
      ≤ Real.sqrt ((volume B).toReal)
        * Real.sqrt (cfgL2 N B (dcfgFun g) (dcfgTransl γ h)) := by
    intro h
    have hum : Measurable fun x : E3 => ‖dAvg N g γ x h‖ :=
      ((continuous_uncurry_dAvg N hgc γ).comp
        (continuous_id.prodMk continuous_const)).norm.measurable
    have hsq := sq_setIntegral_le hBfin hum (fun x => norm_nonneg _)
      (fun x => norm_dAvg_le hN hg1 γ x h)
    rw [← cfgL2_eq_dAvg] at hsq
    have hnn : (0 : ℝ) ≤ ∫ x in B, ‖dAvg N g γ x h‖ := integral_nonneg fun x => norm_nonneg _
    have hrad : (0 : ℝ) ≤ (volume B).toReal * cfgL2 N B (dcfgFun g) (dcfgTransl γ h) :=
      mul_nonneg hV0 (cfgL2_nonneg _ _ _ _)
    rw [← Real.sqrt_mul hV0]
    exact (Real.le_sqrt hnn hrad).mpr hsq
  -- Cauchy-Schwarz in the shift
  have hL2b : ∀ h : ℝ, cfgL2 N B (dcfgFun g) (dcfgTransl γ h) ≤ (volume B).toReal := fun h =>
    cfgL2_le_volume hN hBfin (fun p => continuous_dcfgFun hgc p) (norm_dcfgFun_le hg1) _
  have hint1 : Integrable fun h : ℝ => fejer H h * ∫ x in B, ‖dAvg N g γ x h‖ := by
    refine integrable_fejer_mul hH (measurable_setIntegral_dAvg N B hgc γ)
      (M := (volume B).toReal) fun h => ?_
    rw [abs_of_nonneg (integral_nonneg fun x => norm_nonneg _)]
    have hum : Measurable fun x : E3 => ‖dAvg N g γ x h‖ :=
      ((continuous_uncurry_dAvg N hgc γ).comp
        (continuous_id.prodMk continuous_const)).norm.measurable
    have hb : (∫ x in B, ‖dAvg N g γ x h‖) ≤ ∫ _x in B, (1 : ℝ) := by
      refine integral_mono ?_ (integrable_const (1 : ℝ)) fun x => norm_dAvg_le hN hg1 γ x h
      refine Integrable.mono' (integrable_const (1 : ℝ)) hum.aestronglyMeasurable
        (Filter.Eventually.of_forall fun x => ?_)
      rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
      exact norm_dAvg_le hN hg1 γ x h
    rwa [setIntegral_const, smul_eq_mul, mul_one, measureReal_def] at hb
  have hint2 : Integrable fun h : ℝ => fejer H h *
      (Real.sqrt ((volume B).toReal)
        * Real.sqrt (cfgL2 N B (dcfgFun g) (dcfgTransl γ h))) := by
    refine integrable_fejer_mul hH
      (measurable_const.mul
        (Real.continuous_sqrt.measurable.comp (measurable_cfgL2_shift N B hgc γ)))
      (M := (volume B).toReal) fun h => ?_
    rw [abs_of_nonneg (mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _))]
    calc Real.sqrt ((volume B).toReal) * Real.sqrt (cfgL2 N B (dcfgFun g) (dcfgTransl γ h))
        ≤ Real.sqrt ((volume B).toReal) * Real.sqrt ((volume B).toReal) :=
          mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt (hL2b h)) (Real.sqrt_nonneg _)
      _ = (volume B).toReal := Real.mul_self_sqrt hV0
  have hmono : (∫ h : ℝ, fejer H h * ∫ x in B, ‖dAvg N g γ x h‖)
      ≤ ∫ h : ℝ, fejer H h * (Real.sqrt ((volume B).toReal)
        * Real.sqrt (cfgL2 N B (dcfgFun g) (dcfgTransl γ h))) :=
    integral_mono hint1 hint2 fun h => mul_le_mul_of_nonneg_left (hcs h) (fejer_nonneg hH h)
  have hpull : (∫ h : ℝ, fejer H h * (Real.sqrt ((volume B).toReal)
        * Real.sqrt (cfgL2 N B (dcfgFun g) (dcfgTransl γ h))))
      = Real.sqrt ((volume B).toReal)
        * ∫ h : ℝ, fejer H h * Real.sqrt (cfgL2 N B (dcfgFun g) (dcfgTransl γ h)) := by
    rw [← integral_const_mul]
    refine integral_congr_ae (Filter.Eventually.of_forall fun h => ?_)
    ring
  have hjensen : (∫ h : ℝ, fejer H h * Real.sqrt (cfgL2 N B (dcfgFun g) (dcfgTransl γ h)))
      ≤ Real.sqrt (∫ h : ℝ, fejer H h * cfgL2 N B (dcfgFun g) (dcfgTransl γ h)) :=
    fejer_average_sqrt_le hH (measurable_cfgL2_shift N B hgc γ)
      (fun h => cfgL2_nonneg _ _ _ _) hL2b
  have hsqrt0 : (0 : ℝ) ≤ Real.sqrt ((volume B).toReal) := Real.sqrt_nonneg _
  calc cfgL2 N B g γ
      ≤ 4 * (∫ x in B, ∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖)
          + 12 * H / N * (volume B).toReal := by rw [← hsplit]; exact hstep1
    _ = 4 * (∫ h : ℝ, fejer H h * ∫ x in B, ‖dAvg N g γ x h‖)
          + 12 * H / N * (volume B).toReal := by rw [hfub]
    _ ≤ 4 * (Real.sqrt ((volume B).toReal)
          * ∫ h : ℝ, fejer H h * Real.sqrt (cfgL2 N B (dcfgFun g) (dcfgTransl γ h)))
          + 12 * H / N * (volume B).toReal := by
        rw [← hpull]
        linarith [hmono]
    _ ≤ 4 * (Real.sqrt ((volume B).toReal)
          * Real.sqrt (∫ h : ℝ, fejer H h * cfgL2 N B (dcfgFun g) (dcfgTransl γ h)))
          + 12 * H / N * (volume B).toReal := by
        have := mul_le_mul_of_nonneg_left hjensen hsqrt0
        linarith



open MeasureTheory in
/-- **The descent step in usable form.** A lower bound on the `L^2` functional, with the boundary
error absorbed, produces a single shift at which the differenced configuration still obeys a lower
bound of the same shape -- the square of the old one, divided by a fixed multiple of the volume.
This is the step the induction of `lem:pet-reduction` repeats. -/
theorem exists_shift_cfgL2_ge {ι : Type*} [Fintype ι] {N H : ℝ} (hN : 0 < N) (hH : 0 < H)
    (hHN : H ≤ N / 4) {B : Set E3} (hBfin : volume B ≠ ⊤) (hBpos : 0 < (volume B).toReal)
    {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a)) (hg1 : ∀ a x, ‖g a x‖ ≤ 1)
    (γ : ι → (Fin 3 → Polynomial ℝ)) {β : ℝ} (hβ : 0 < β) (hlow : β ≤ cfgL2 N B g γ)
    (hsmall : 12 * H / N * (volume B).toReal ≤ β / 2) :
    ∃ h : ℝ, β ^ 2 / (128 * (volume B).toReal)
      ≤ cfgL2 N B (dcfgFun g) (dcfgTransl γ h) := by
  have hstep := cfgL2_step hN hH hHN hBfin hgc hg1 γ
  set V := (volume B).toReal with hVdef
  set A := ∫ h : ℝ, fejer H h * cfgL2 N B (dcfgFun g) (dcfgTransl γ h) with hAdef
  have hV0 : 0 < V := hBpos
  have hsqV : 0 < Real.sqrt V := Real.sqrt_pos.mpr hV0
  have hA0 : 0 ≤ A := by
    rw [hAdef]
    exact integral_nonneg fun h => mul_nonneg (fejer_nonneg hH h) (cfgL2_nonneg _ _ _ _)
  have hkey : β / 2 ≤ 4 * (Real.sqrt V * Real.sqrt A) := by linarith
  have hc : β / (8 * Real.sqrt V) ≤ Real.sqrt A := by
    rw [div_le_iff₀ (by positivity)]
    nlinarith [hkey]
  have hAge : β ^ 2 / (64 * V) ≤ A := by
    have h1 : (0 : ℝ) ≤ β / (8 * Real.sqrt V) := by positivity
    have h2 := (Real.le_sqrt h1 hA0).mp hc
    have h3 : (β / (8 * Real.sqrt V)) ^ 2 = β ^ 2 / (64 * V) := by
      rw [div_pow, mul_pow, Real.sq_sqrt hV0.le]
      norm_num
    rwa [h3] at h2
  have hbd : ∀ h : ℝ, |cfgL2 N B (dcfgFun g) (dcfgTransl γ h)| ≤ V := by
    intro h
    rw [abs_of_nonneg (cfgL2_nonneg _ _ _ _), hVdef]
    exact cfgL2_le_volume hN hBfin (fun p => continuous_dcfgFun hgc p) (norm_dcfgFun_le hg1) _
  obtain ⟨h, hh⟩ := exists_of_fejer_average_ge hH (β := β ^ 2 / (64 * V)) (by positivity)
    (measurable_cfgL2_shift N B hgc γ) hbd hAge
  refine ⟨h, ?_⟩
  have hdiv : β ^ 2 / (64 * V) / 2 = β ^ 2 / (128 * V) := by
    field_simp
    ring
  rwa [hdiv] at hh



/-! ## Blueprint `lem:pet-reduction`: the entry point

The recursion starts from the four-linear form. Cauchy-Schwarz in the point, with the
undifferenced factor supported in the box, turns the hypothesis `|Lambda_N| >= delta N^6` into a
lower bound for the `L^2` functional of the monomial configuration, which is where
`Auto.exists_shift_cfgL2_ge` takes over. -/

open MeasureTheory in
/-- **The entry point of the recursion.** The square of the four-linear form is at most the
volume of the box times the `L^2` functional of the monomial configuration. -/
theorem sq_norm_Lambda_le_cfgL2 {N : ℝ} (hN : 0 < N) {B : Set E3} (hBfin : volume B ≠ ⊤)
    {f0 : E3 → ℂ} {f : Fin 3 → E3 → ℂ} (hfc : ∀ i, Continuous (f i)) (hf1 : ∀ i x, ‖f i x‖ ≤ 1)
    (hf0m : Measurable f0) (hf01 : ∀ x, ‖f0 x‖ ≤ 1) (hsupp : ∀ x, x ∉ B → f0 x = 0) :
    ‖Lambda N f0 f‖ ^ 2 ≤ (volume B).toReal * cfgL2 N B f curveTransl := by
  have : IsFiniteMeasure (volume.restrict B) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact lt_of_le_of_ne le_top hBfin⟩
  have hA1 : ∀ x : E3, ‖A N f x‖ ≤ 1 := by
    intro x
    rw [← cfgAvg_curveTransl]
    exact norm_cfgAvg_le hN hf1 curveTransl x
  have hAm : Measurable fun x : E3 => ‖A N f x‖ := (continuous_A hfc N).norm.measurable
  have hrestrict : Lambda N f0 f = ∫ x in B, A N f x * (starRingEnd ℂ) (f0 x) := by
    rw [Lambda]
    refine (setIntegral_eq_integral_of_forall_compl_eq_zero fun x hx => ?_).symm
    rw [hsupp x hx, map_zero, mul_zero]
  have hintB : Integrable (fun x : E3 => ‖A N f x‖) (volume.restrict B) := by
    refine Integrable.mono' (integrable_const (1 : ℝ)) hAm.aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
    exact hA1 x
  have hintP : Integrable (fun x : E3 => A N f x * (starRingEnd ℂ) (f0 x))
      (volume.restrict B) := by
    refine Integrable.mono' (integrable_const (1 : ℝ))
      ((continuous_A hfc N).measurable.mul
        (Complex.continuous_conj.measurable.comp hf0m)).aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => ?_)
    rw [norm_mul, RCLike.norm_conj]
    exact ((mul_le_of_le_one_left (norm_nonneg _) (hA1 x)).trans (hf01 x))
  have hpair : ‖Lambda N f0 f‖ ≤ ∫ x in B, ‖A N f x‖ := by
    rw [hrestrict]
    refine le_trans (norm_integral_le_integral_norm _) ?_
    refine integral_mono hintP.norm hintB fun x => ?_
    rw [norm_mul, RCLike.norm_conj]
    exact mul_le_of_le_one_right (norm_nonneg _) (hf01 x)
  have hsq := sq_setIntegral_le hBfin hAm (fun x => norm_nonneg _) hA1
  have hcfg : (∫ x in B, ‖A N f x‖ ^ 2) = cfgL2 N B f curveTransl := by
    rw [cfgL2]
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    simp only [cfgAvg_curveTransl]
  rw [hcfg] at hsq
  calc ‖Lambda N f0 f‖ ^ 2 ≤ (∫ x in B, ‖A N f x‖) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) hpair 2
    _ ≤ (volume B).toReal * cfgL2 N B f curveTransl := hsq



/-! ## Blueprint `lem:pet-reduction`: iterating the descent

Each step doubles the family, so the index type after `n` steps is `iota` with `n` copies of
`Bool` appended. The one-boundedness and the continuity are preserved, and the bound is squared
and divided by a fixed multiple of the volume at each step; the shifts chosen along the way are
collected into a tuple. -/

/-- The index type after `n` steps of the recursion. -/
def cfgIdx (ι : Type) : ℕ → Type
  | 0 => ι
  | (n + 1) => cfgIdx (ι × Bool) n

@[instance_reducible]
def cfgIdxFintype : ∀ (n : ℕ) (ι : Type) [Fintype ι], Fintype (cfgIdx ι n)
  | 0, _, h => h
  | (n + 1), ι, _ => cfgIdxFintype n (ι × Bool)

instance instFintypeCfgIdx (n : ℕ) (ι : Type) [Fintype ι] : Fintype (cfgIdx ι n) :=
  cfgIdxFintype n ι

/-- The functions of the `n`-fold differenced configuration. -/
noncomputable def dcfgFunN : ∀ (n : ℕ) {ι : Type}, (ι → E3 → ℂ) → cfgIdx ι n → E3 → ℂ
  | 0, _, g => g
  | (n + 1), _, g => dcfgFunN n (dcfgFun g)

/-- The translations of the `n`-fold differenced configuration, for a given tuple of shifts. -/
noncomputable def dcfgTranslN : ∀ (n : ℕ) {ι : Type}, (ι → (Fin 3 → Polynomial ℝ)) →
    (Fin n → ℝ) → cfgIdx ι n → (Fin 3 → Polynomial ℝ)
  | 0, _, γ, _ => γ
  | (n + 1), _, γ, hs => dcfgTranslN n (dcfgTransl γ (hs 0)) (fun i => hs i.succ)

theorem continuous_dcfgFunN : ∀ (n : ℕ) {ι : Type} {g : ι → E3 → ℂ},
    (∀ a, Continuous (g a)) → ∀ a, Continuous (dcfgFunN n g a)
  | 0, _, _, hg => hg
  | (n + 1), _, _, hg => continuous_dcfgFunN n fun p => continuous_dcfgFun hg p

theorem norm_dcfgFunN_le : ∀ (n : ℕ) {ι : Type} {g : ι → E3 → ℂ},
    (∀ a x, ‖g a x‖ ≤ 1) → ∀ a x, ‖dcfgFunN n g a x‖ ≤ 1
  | 0, _, _, hg => hg
  | (n + 1), _, _, hg => norm_dcfgFunN_le n (norm_dcfgFun_le hg)

/-- The lower bound after `n` steps: each step squares it and divides by a fixed multiple of the
volume. -/
noncomputable def iterBound (V β : ℝ) : ℕ → ℝ
  | 0 => β
  | (n + 1) => (iterBound V β n) ^ 2 / (128 * V)

theorem iterBound_succ_left (V β : ℝ) : ∀ n : ℕ,
    iterBound V β (n + 1) = iterBound V (β ^ 2 / (128 * V)) n
  | 0 => rfl
  | (n + 1) => by
      change (iterBound V β (n + 1)) ^ 2 / (128 * V)
        = (iterBound V (β ^ 2 / (128 * V)) n) ^ 2 / (128 * V)
      rw [iterBound_succ_left V β n]

open MeasureTheory in
/-- **The descent, iterated.** After `n` steps there is a tuple of shifts along which the
`n`-fold differenced configuration still obeys the iterated lower bound; one-boundedness and
continuity are carried along by `Auto.norm_dcfgFunN_le` and `Auto.continuous_dcfgFunN`. -/
theorem exists_iterated_descent {N H : ℝ} (hN : 0 < N) (hH : 0 < H) (hHN : H ≤ N / 4)
    {B : Set E3} (hBfin : volume B ≠ ⊤) (hBpos : 0 < (volume B).toReal) :
    ∀ (n : ℕ) (ι : Type) [Fintype ι] (g : ι → E3 → ℂ) (γ : ι → (Fin 3 → Polynomial ℝ)) (β : ℝ),
      (∀ a, Continuous (g a)) → (∀ a x, ‖g a x‖ ≤ 1) →
      (∀ k, k < n → 0 < iterBound (volume B).toReal β k) →
      (∀ k, k < n → 12 * H / N * (volume B).toReal ≤ iterBound (volume B).toReal β k / 2) →
      β ≤ cfgL2 N B g γ →
      ∃ hs : Fin n → ℝ,
        iterBound (volume B).toReal β n
          ≤ cfgL2 N B (dcfgFunN n g) (dcfgTranslN n γ hs) := by
  intro n
  induction n with
  | zero =>
      intro ι _ g γ β _ _ _ _ hlow
      exact ⟨Fin.elim0, hlow⟩
  | succ n ih =>
      intro ι _ g γ β hgc hg1 hpos hsmall hlow
      have hβ0 : 0 < β := hpos 0 (Nat.succ_pos n)
      have hs0 : 12 * H / N * (volume B).toReal ≤ β / 2 := hsmall 0 (Nat.succ_pos n)
      obtain ⟨h0, hh0⟩ :=
        exists_shift_cfgL2_ge hN hH hHN hBfin hBpos hgc hg1 γ hβ0 hlow hs0
      have hconv : ∀ k : ℕ,
          iterBound (volume B).toReal (β ^ 2 / (128 * (volume B).toReal)) k
            = iterBound (volume B).toReal β (k + 1) := fun k =>
        (iterBound_succ_left _ β k).symm
      obtain ⟨hs', hb'⟩ := ih (ι × Bool) (dcfgFun g) (dcfgTransl γ h0)
        (β ^ 2 / (128 * (volume B).toReal))
        (fun p => continuous_dcfgFun hgc p) (norm_dcfgFun_le hg1)
        (fun k hk => by rw [hconv k]; exact hpos (k + 1) (by omega))
        (fun k hk => by rw [hconv k]; exact hsmall (k + 1) (by omega))
        hh0
      refine ⟨Fin.cons h0 hs', ?_⟩
      have hT : dcfgTranslN (n + 1) γ (Fin.cons h0 hs') = dcfgTranslN n (dcfgTransl γ h0) hs' := by
        change dcfgTranslN n (dcfgTransl γ ((Fin.cons h0 hs' : Fin (n + 1) → ℝ) 0))
            (fun i => (Fin.cons h0 hs' : Fin (n + 1) → ℝ) i.succ) = _
        simp only [Fin.cons_zero, Fin.cons_succ]
      rw [hT, ← hconv n]
      exact hb'



/-! ## Blueprint `lem:pet-reduction`: the normalization and the endpoint

Two facts about the shape of a configuration.

First, "translate so that this polynomial becomes zero": subtracting one common translation from
every member of the family is invisible to the integral in the point, because it amounts to
translating the point by a quantity depending only on the parameter. This is what reconciles the
combinatorial step `Auto.petStep`, which subtracts the selected translation, with the analytic
step `Auto.dcfgTransl`, which does not.

Second, the endpoint: when every surviving translation is constant the average no longer depends
on the parameter, and the `L^2` functional becomes the integral of a product of fixed translates
of the functions. -/
theorem cfgProd_translSub {ι : Type*} [Fintype ι] (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (P : Fin 3 → Polynomial ℝ) (x : E3) (t : ℝ) :
    cfgProd g (fun a => translSub (γ a) P) x t = cfgProd g γ (x - translAct P t) t := by
  rw [cfgProd, cfgProd]
  refine Finset.prod_congr rfl fun a _ => ?_
  congr 1
  rw [translAct_translSub]
  abel

open MeasureTheory in
/-- **Subtracting a common translation does not change the integral in the point.** -/
theorem integral_cfgProd_translSub {ι : Type*} [Fintype ι] (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (P : Fin 3 → Polynomial ℝ) (t : ℝ) :
    (∫ x : E3, cfgProd g (fun a => translSub (γ a) P) x t)
      = ∫ x : E3, cfgProd g γ x t := by
  rw [integral_congr_ae (Filter.Eventually.of_forall fun x => cfgProd_translSub g γ P x t)]
  exact integral_sub_right_eq_self (fun x : E3 => cfgProd g γ x t) (translAct P t)

/-- A translation of degree zero does not move with the parameter. -/
theorem translAct_of_translDeg_zero {q : Fin 3 → Polynomial ℝ} (hq : translDeg q = 0) (t s : ℝ) :
    translAct q t = translAct q s := by
  rw [translAct, translAct]
  refine Finset.sum_congr rfl fun d _ => ?_
  have hd : (q d).natDegree = 0 := Nat.le_zero.mp (hq ▸ natDegree_le_translDeg q d)
  rw [Polynomial.eq_C_of_natDegree_eq_zero hd]
  simp

theorem cfgProd_of_constant {ι : Type*} [Fintype ι] (g : ι → E3 → ℂ)
    {γ : ι → (Fin 3 → Polynomial ℝ)} (hconst : ∀ a, translDeg (γ a) = 0) (x : E3) (t : ℝ) :
    cfgProd g γ x t = cfgProd g γ x 0 := by
  rw [cfgProd, cfgProd]
  refine Finset.prod_congr rfl fun a _ => ?_
  rw [translAct_of_translDeg_zero (hconst a) t 0]

open MeasureTheory in
/-- **The endpoint.** When every translation is constant the average does not depend on the
parameter: it is the product of fixed translates of the functions. -/
theorem cfgAvg_of_constant {ι : Type*} [Fintype ι] {N : ℝ} (hN : 0 < N) (g : ι → E3 → ℂ)
    {γ : ι → (Fin 3 → Polynomial ℝ)} (hconst : ∀ a, translDeg (γ a) = 0) (x : E3) :
    cfgAvg N g γ x = cfgProd g γ x 0 := by
  rw [cfgAvg,
    intervalIntegral.integral_congr (g := fun _ : ℝ => cfgProd g γ x 0)
      fun t _ => cfgProd_of_constant g hconst x t,
    intervalIntegral.integral_const, sub_zero, smul_smul, inv_mul_cancel₀ hN.ne', one_smul]

open MeasureTheory in
theorem cfgL2_of_constant {ι : Type*} [Fintype ι] {N : ℝ} (hN : 0 < N) (B : Set E3)
    (g : ι → E3 → ℂ) {γ : ι → (Fin 3 → Polynomial ℝ)} (hconst : ∀ a, translDeg (γ a) = 0) :
    cfgL2 N B g γ = ∫ x in B, ‖cfgProd g γ x 0‖ ^ 2 := by
  rw [cfgL2]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
  simp only [cfgAvg_of_constant hN g hconst x]



/-! ## Blueprint `lem:pet-reduction`: the unmodulated functional

The quantity the recursion must iterate is the one with the integral in the point *innermost* and
no modulus, so that the translation of the point and the removal of the selected factor by
Cauchy-Schwarz are both available. See the Status entry of 2026-09-14 for why the modulus form
cannot shed a factor. -/

open MeasureTheory in
/-- The unmodulated functional of a configuration: the integral in the point, averaged over the
parameter. -/
noncomputable def cfgInt {ι : Type*} [Fintype ι] (N : ℝ) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) : ℂ :=
  N⁻¹ • ∫ t in (0 : ℝ)..N, ∫ x : E3, cfgProd g γ x t

open MeasureTheory in
/-- **"Translate so that this polynomial becomes zero".**  Normalizing the family by subtracting
one common translation leaves the functional unchanged, so the combinatorial step
`Auto.petStep` -- which subtracts the selected translation -- is analytically free. -/
theorem cfgInt_translSub {ι : Type*} [Fintype ι] (N : ℝ) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (P : Fin 3 → Polynomial ℝ) :
    cfgInt N g (fun a => translSub (γ a) P) = cfgInt N g γ := by
  rw [cfgInt, cfgInt]
  congr 1
  exact intervalIntegral.integral_congr fun t _ =>
    integral_cfgProd_translSub g γ P t

open MeasureTheory in
/-- The functional of the differenced configuration, written through `Auto.cfgProd`. -/
theorem cfgInt_dcfg {ι : Type*} [Fintype ι] (N : ℝ) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (h : ℝ) :
    cfgInt N (dcfgFun g) (dcfgTransl γ h)
      = N⁻¹ • ∫ t in (0 : ℝ)..N,
          ∫ x : E3, cfgProd g γ x (t + h) * (starRingEnd ℂ) (cfgProd g γ x t) := by
  rw [cfgInt]
  congr 1
  refine intervalIntegral.integral_congr fun t _ => ?_
  exact integral_congr_ae (Filter.Eventually.of_forall fun x => cfgProd_dcfg g γ h x t)



/-! ## Blueprint `lem:pet-reduction`: the modulus as an extra factor

The van der Corput step leaves `int_x |D(x)| dx` with a modulus outside the integral in the point,
which blocks both the translation and the removal of the selected factor. The modulus can be
removed at the cost of one extra factor: `|D(x)| = u(x) D(x)` for the unimodular `u = conj D / |D|`,
so the quantity is again an integral of a product of one-bounded functions, with `u` carrying the
zero translation. That extra undisplaced factor is precisely the one the next step removes by
Cauchy-Schwarz. -/

open Classical in
/-- The unimodular phase that turns a modulus into a product. -/
noncomputable def unitPhase (D : E3 → ℂ) : E3 → ℂ :=
  fun x => if D x = 0 then 1 else (starRingEnd ℂ) (D x) / ((‖D x‖ : ℝ) : ℂ)

theorem norm_unitPhase (D : E3 → ℂ) (x : E3) : ‖unitPhase D x‖ = 1 := by
  rw [unitPhase]
  by_cases h : D x = 0
  · simp [h]
  · rw [ite_eq_right h, norm_div, RCLike.norm_conj, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (norm_nonneg _)]
    exact div_self (norm_ne_zero_iff.mpr h)

theorem norm_unitPhase_le (D : E3 → ℂ) (x : E3) : ‖unitPhase D x‖ ≤ 1 :=
  le_of_eq (norm_unitPhase D x)

theorem unitPhase_mul (D : E3 → ℂ) (x : E3) :
    unitPhase D x * D x = ((‖D x‖ : ℝ) : ℂ) := by
  rw [unitPhase]
  by_cases h : D x = 0
  · simp [h]
  · have hn : ((‖D x‖ : ℝ) : ℂ) ≠ 0 :=
      Complex.ofReal_ne_zero.mpr (norm_ne_zero_iff.mpr h)
    rw [ite_eq_right h, div_mul_eq_mul_div, ← Complex.normSq_eq_conj_mul_self,
      Complex.normSq_eq_norm_sq, Complex.ofReal_pow, sq]
    field_simp

theorem measurable_unitPhase {D : E3 → ℂ} (hD : Measurable D) : Measurable (unitPhase D) := by
  classical
  refine Measurable.ite (hD (measurableSet_singleton (0 : ℂ))) measurable_const ?_
  exact (Complex.continuous_conj.measurable.comp hD).div
    (Complex.continuous_ofReal.measurable.comp hD.norm)

open MeasureTheory in
/-- **The `L^1` norm as a pairing against a unimodular function.** -/
theorem integral_norm_eq_integral_unitPhase (D : E3 → ℂ) :
    ((∫ x : E3, ‖D x‖ : ℝ) : ℂ) = ∫ x : E3, unitPhase D x * D x := by
  rw [← integral_complex_ofReal]
  exact integral_congr_ae (Filter.Eventually.of_forall fun x => (unitPhase_mul D x).symm)

open MeasureTheory in
/-- The same, on a set. -/
theorem setIntegral_norm_eq_setIntegral_unitPhase (B : Set E3) (D : E3 → ℂ) :
    ((∫ x in B, ‖D x‖ : ℝ) : ℂ) = ∫ x in B, unitPhase D x * D x := by
  rw [← integral_complex_ofReal]
  exact integral_congr_ae (Filter.Eventually.of_forall fun x => (unitPhase_mul D x).symm)



/-! ## Blueprint `lem:pet-reduction`: the headed functional and the shedding Cauchy-Schwarz

The quantity the corrected recursion iterates carries a **head**: one distinguished one-bounded
factor, supported in the box and carrying the zero translation, multiplying the average of a
configuration whose translations are all nonconstant. Writing it this way is what makes the two
operations of the blueprint's step available at the same time:

* the head is what Cauchy-Schwarz in the point removes, so the family *shrinks* at each step --
  this is the defect of the modulus form recorded in the Status entry of 2026-09-14;
* once the head is gone the surviving quantity is `Auto.cfgInt`, whose point integral runs over all
  of `E3` and is therefore invariant under the parameter-dependent translation
  (`Auto.cfgInt_translSub`), which is the blueprint's "translate so that this polynomial becomes
  zero".

No modulus appears anywhere on this route: the square that Cauchy-Schwarz produces is itself a
product, so the van der Corput step is applied to a product of one-bounded functions. -/

open MeasureTheory in
/-- The headed functional: the undisplaced factor `g0` paired against the average of the
configuration `(g, γ)`. -/
noncomputable def cfgHeadInt {ι : Type*} [Fintype ι] (N : ℝ) (g0 : E3 → ℂ)
    (g : ι → E3 → ℂ) (γ : ι → (Fin 3 → Polynomial ℝ)) : ℂ :=
  ∫ x : E3, g0 x * cfgAvg N g γ x

open MeasureTheory in
/-- The headed functional is bounded by the `L^1` norm of the configuration average over the
support of the head. -/
theorem norm_cfgHeadInt_le {ι : Type*} [Fintype ι] {N : ℝ} (hN : 0 < N) {B : Set E3}
    (hBm : MeasurableSet B) (hBfin : volume B ≠ ⊤) {g0 : E3 → ℂ}
    (hg0m : Measurable g0) (hg01 : ∀ x, ‖g0 x‖ ≤ 1) (hg0supp : ∀ x, x ∉ B → g0 x = 0)
    {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a)) (hg1 : ∀ a x, ‖g a x‖ ≤ 1)
    (γ : ι → (Fin 3 → Polynomial ℝ)) :
    ‖cfgHeadInt N g0 g γ‖ ≤ ∫ x in B, ‖cfgAvg N g γ x‖ := by
  classical
  have : IsFiniteMeasure (volume.restrict B) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact lt_of_le_of_ne le_top hBfin⟩
  have hCAm : Measurable (cfgAvg N g γ) := (continuous_cfgAvg N hgc γ).measurable
  have hCA1 : ∀ x, ‖cfgAvg N g γ x‖ ≤ 1 := fun x => norm_cfgAvg_le hN hg1 γ x
  have hPm : Measurable fun x : E3 => ‖g0 x * cfgAvg N g γ x‖ := (hg0m.mul hCAm).norm
  have hIu : IntegrableOn (fun x : E3 => ‖cfgAvg N g γ x‖) B := by
    refine Integrable.mono' (integrable_const (1 : ℝ)) hCAm.norm.aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
    exact hCA1 x
  have hIp : IntegrableOn (fun x : E3 => ‖g0 x * cfgAvg N g γ x‖) B := by
    refine Integrable.mono' (integrable_const (1 : ℝ)) hPm.aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _), norm_mul]
    exact ((mul_le_of_le_one_left (norm_nonneg _) (hg01 x)).trans (hCA1 x))
  have hstep : ‖cfgHeadInt N g0 g γ‖ ≤ ∫ x : E3, ‖g0 x * cfgAvg N g γ x‖ :=
    norm_integral_le_integral_norm _
  refine hstep.trans ?_
  have heq : (∫ x : E3, ‖g0 x * cfgAvg N g γ x‖)
      = ∫ x : E3, B.indicator (fun y : E3 => ‖g0 y * cfgAvg N g γ y‖) x := by
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    by_cases hx : x ∈ B
    · rw [Set.indicator_of_mem hx]
    · rw [Set.indicator_of_notMem hx]
      simp only [hg0supp x hx, zero_mul, norm_zero]
  rw [heq, integral_indicator hBm]
  refine setIntegral_mono_on hIp hIu hBm fun x _ => ?_
  rw [norm_mul]
  exact mul_le_of_le_one_left (norm_nonneg _) (hg01 x)

open MeasureTheory in
/-- **Shedding the head.** Cauchy-Schwarz in the point removes the undisplaced factor: a headed
functional whose head is one-bounded and supported in `B` is controlled by the `L^2` functional of
the configuration alone. -/
theorem sq_norm_cfgHeadInt_le {ι : Type*} [Fintype ι] {N : ℝ} (hN : 0 < N) {B : Set E3}
    (hBm : MeasurableSet B) (hBfin : volume B ≠ ⊤) {g0 : E3 → ℂ}
    (hg0m : Measurable g0) (hg01 : ∀ x, ‖g0 x‖ ≤ 1) (hg0supp : ∀ x, x ∉ B → g0 x = 0)
    {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a)) (hg1 : ∀ a x, ‖g a x‖ ≤ 1)
    (γ : ι → (Fin 3 → Polynomial ℝ)) :
    ‖cfgHeadInt N g0 g γ‖ ^ 2 ≤ (volume B).toReal * cfgL2 N B g γ := by
  have hle := norm_cfgHeadInt_le hN hBm hBfin hg0m hg01 hg0supp hgc hg1 γ
  have hsq := sq_setIntegral_le (u := fun x : E3 => ‖cfgAvg N g γ x‖) hBfin
    (continuous_cfgAvg N hgc γ).measurable.norm (fun _ => norm_nonneg _)
    (fun x => norm_cfgAvg_le hN hg1 γ x)
  calc ‖cfgHeadInt N g0 g γ‖ ^ 2 ≤ (∫ x in B, ‖cfgAvg N g γ x‖) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) hle 2
    _ ≤ (volume B).toReal * ∫ x in B, ‖cfgAvg N g γ x‖ ^ 2 := hsq
    _ = (volume B).toReal * cfgL2 N B g γ := by rw [cfgL2]



/-! ## Blueprint `lem:pet-reduction`: adjoining the head to the family

The headed functional is the headless one for the family extended by a single member carrying the
zero translation. This is the bookkeeping that closes the descent cycle: `Auto.cfgInt` is what
the normalization `Auto.cfgInt_translSub` acts on, `Auto.cfgHeadInt` is what Cauchy-Schwarz sheds,
and the two are the same object read through `Auto.cfgCons`. -/
theorem translAct_zero (t : ℝ) : translAct (0 : Fin 3 → Polynomial ℝ) t = 0 := by
  simp [translAct]

/-- The family extended by one member carrying the zero translation. -/
noncomputable def cfgCons {ι : Type*} (g0 : E3 → ℂ) (g : ι → E3 → ℂ) : Option ι → E3 → ℂ :=
  fun a => a.elim g0 g

/-- The translations extended by the zero translation on the new member. -/
noncomputable def translCons {ι : Type*} (γ : ι → (Fin 3 → Polynomial ℝ)) :
    Option ι → (Fin 3 → Polynomial ℝ) :=
  fun a => a.elim 0 γ

theorem cfgProd_cons {ι : Type*} [Fintype ι] (g0 : E3 → ℂ) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (x : E3) (t : ℝ) :
    cfgProd (cfgCons g0 g) (translCons γ) x t = g0 x * cfgProd g γ x t := by
  rw [cfgProd, cfgProd, Fintype.prod_option]
  simp [cfgCons, translCons, translAct_zero]

open MeasureTheory in
/-- **The head is a member of the family.** Fubini in the point and the parameter identifies the
headless functional of the extended family with the headed functional of the original one. -/
theorem cfgInt_cons {ι : Type*} [Fintype ι] {N : ℝ} (hN : 0 < N) {B : Set E3}
    (hBm : MeasurableSet B) (hBfin : volume B ≠ ⊤) {g0 : E3 → ℂ}
    (hg0m : Measurable g0) (hg01 : ∀ x, ‖g0 x‖ ≤ 1) (hg0supp : ∀ x, x ∉ B → g0 x = 0)
    {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a)) (hg1 : ∀ a x, ‖g a x‖ ≤ 1)
    (γ : ι → (Fin 3 → Polynomial ℝ)) :
    cfgInt N (cfgCons g0 g) (translCons γ) = cfgHeadInt N g0 g γ := by
  classical
  have : IsFiniteMeasure (volume.restrict (Set.Ioc (0 : ℝ) N)) := by
    refine ⟨?_⟩
    rw [Measure.restrict_apply_univ, Real.volume_Ioc]
    exact ENNReal.ofReal_lt_top
  have : IsFiniteMeasure (volume.restrict B) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact lt_of_le_of_ne le_top hBfin⟩
  -- the dominating function: the head is one-bounded and supported in `B`
  have hIonB : IntegrableOn (fun _ : E3 => (1 : ℝ)) B := integrable_const 1
  have hindint : Integrable (B.indicator fun _ : E3 => (1 : ℝ)) volume :=
    hIonB.integrable_indicator hBm
  have hdom : Integrable
      (fun p : ℝ × E3 => (1 : ℝ) * B.indicator (fun _ : E3 => (1 : ℝ)) p.2)
      ((volume.restrict (Set.Ioc (0 : ℝ) N)).prod volume) :=
    MeasureTheory.Integrable.mul_prod (integrable_const (1 : ℝ)) hindint
  have hmeas : Measurable fun p : ℝ × E3 => g0 p.2 * cfgProd g γ p.2 p.1 :=
    (hg0m.comp measurable_snd).mul
      (((continuous_uncurry_cfgProd hgc γ).comp continuous_swap).measurable)
  have hint : Integrable
      (Function.uncurry fun (t : ℝ) (x : E3) => g0 x * cfgProd g γ x t)
      ((volume.restrict (Set.Ioc (0 : ℝ) N)).prod volume) := by
    refine Integrable.mono' hdom hmeas.aestronglyMeasurable
      (Filter.Eventually.of_forall fun p => ?_)
    obtain ⟨t, x⟩ := p
    simp only [Function.uncurry_apply_pair, one_mul]
    by_cases hx : x ∈ B
    · rw [Set.indicator_of_mem hx, norm_mul]
      exact ((mul_le_of_le_one_left (norm_nonneg _) (hg01 x)).trans (norm_cfgProd_le hg1 γ x t))
    · rw [Set.indicator_of_notMem hx]
      simp [hg0supp x hx]
  rw [cfgInt, cfgHeadInt]
  simp only [cfgProd_cons]
  rw [intervalIntegral.integral_of_le hN.le, integral_integral_swap hint]
  have h2 : ∀ x : E3, (∫ t in Set.Ioc (0 : ℝ) N, g0 x * cfgProd g γ x t)
      = g0 x * ∫ t in (0 : ℝ)..N, cfgProd g γ x t := by
    intro x
    rw [intervalIntegral.integral_of_le hN.le, integral_const_mul]
  have h3 : ∀ x : E3, g0 x * cfgAvg N g γ x
      = (N⁻¹ : ℝ) • (g0 x * ∫ t in (0 : ℝ)..N, cfgProd g γ x t) := by
    intro x
    rw [cfgAvg, mul_smul_comm]
  simp only [h2, h3]
  rw [integral_smul]



/-! ## Blueprint `lem:pet-reduction`: the van der Corput half in headed shape

The descent cycle needs its other half: from a lower bound on `Auto.cfgL2` produce a single shift
`h` and a *headed* functional of the differenced family bounded below. The `L^1` functional over
the box is the intermediary. The van der Corput step bounds `cfgL2` by the Fejer average of
`cfgL1` of the differenced family; pigeonholing fixes `h`; and the unimodular bridge of
`Auto.unitPhase` rewrites `int_B ‖D‖` as the pairing of `D` against a one-bounded function
supported in `B`, which is exactly a head. -/

open MeasureTheory in
/-- The `L^1` norm of the average of a configuration over the box. -/
noncomputable def cfgL1 {ι : Type*} [Fintype ι] (N : ℝ) (B : Set E3) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) : ℝ :=
  ∫ x in B, ‖cfgAvg N g γ x‖

open MeasureTheory in
theorem cfgL1_eq_dAvg {ι : Type*} [Fintype ι] (N : ℝ) (B : Set E3) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (h : ℝ) :
    cfgL1 N B (dcfgFun g) (dcfgTransl γ h) = ∫ x in B, ‖dAvg N g γ x h‖ := by
  rw [cfgL1]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
  simp only [dAvg_eq]

open MeasureTheory in
theorem cfgL1_nonneg {ι : Type*} [Fintype ι] (N : ℝ) (B : Set E3) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) : 0 ≤ cfgL1 N B g γ :=
  integral_nonneg fun _x => norm_nonneg _

open MeasureTheory in
theorem measurable_cfgL1_shift {ι : Type*} [Fintype ι] (N : ℝ) (B : Set E3)
    {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ)) :
    Measurable fun h : ℝ => cfgL1 N B (dcfgFun g) (dcfgTransl γ h) := by
  have hcongr : (fun h : ℝ => cfgL1 N B (dcfgFun g) (dcfgTransl γ h))
      = fun h : ℝ => ∫ x in B, ‖dAvg N g γ x h‖ := by
    funext h
    exact cfgL1_eq_dAvg N B g γ h
  rw [hcongr]
  exact measurable_setIntegral_dAvg N B hgc γ

open MeasureTheory in
theorem cfgL1_le_volume {ι : Type*} [Fintype ι] {N : ℝ} (hN : 0 < N) {B : Set E3}
    (hBfin : volume B ≠ ⊤) {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a))
    (hg1 : ∀ a x, ‖g a x‖ ≤ 1) (γ : ι → (Fin 3 → Polynomial ℝ)) :
    cfgL1 N B g γ ≤ (volume B).toReal := by
  have : IsFiniteMeasure (volume.restrict B) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact lt_of_le_of_ne le_top hBfin⟩
  have hint : Integrable (fun x : E3 => ‖cfgAvg N g γ x‖) (volume.restrict B) := by
    refine Integrable.mono' (integrable_const (1 : ℝ))
      ((continuous_cfgAvg N hgc γ).norm).aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
    exact norm_cfgAvg_le hN hg1 γ x
  have hmono : (∫ x in B, ‖cfgAvg N g γ x‖) ≤ ∫ _x in B, (1 : ℝ) :=
    integral_mono hint (integrable_const (1 : ℝ)) fun x => norm_cfgAvg_le hN hg1 γ x
  rwa [setIntegral_const, smul_eq_mul, mul_one, measureReal_def, ← cfgL1] at hmono

open MeasureTheory in
/-- **One van der Corput step, in `L^1` form.** The `L^2` functional is bounded by the Fejer
average of the `L^1` functional of the differenced family, plus the boundary error. -/
theorem cfgL2_le_fejer_cfgL1 {ι : Type*} [Fintype ι] {N H : ℝ} (hN : 0 < N) (hH : 0 < H)
    (hHN : H ≤ N / 4) {B : Set E3} (hBfin : volume B ≠ ⊤) {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) (hg1 : ∀ a x, ‖g a x‖ ≤ 1)
    (γ : ι → (Fin 3 → Polynomial ℝ)) :
    cfgL2 N B g γ
      ≤ 4 * (∫ h : ℝ, fejer H h * cfgL1 N B (dcfgFun g) (dcfgTransl γ h))
        + 12 * H / N * (volume B).toReal := by
  have : IsFiniteMeasure (volume.restrict B) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact lt_of_le_of_ne le_top hBfin⟩
  have hdm : ∀ x : E3, Measurable fun h : ℝ => ‖dAvg N g γ x h‖ := fun x =>
    ((continuous_uncurry_dAvg N hgc γ).comp
      (continuous_const.prodMk continuous_id)).norm.measurable
  have hdb : ∀ (x : E3) (h : ℝ), |‖dAvg N g γ x h‖| ≤ 1 := by
    intro x h
    rw [abs_of_nonneg (norm_nonneg _)]
    exact norm_dAvg_le hN hg1 γ x h
  have hΨ0 : ∀ x : E3, 0 ≤ ∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖ := fun x =>
    integral_nonneg fun h => mul_nonneg (fejer_nonneg hH h) (norm_nonneg _)
  have hΨ1 : ∀ x : E3, (∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖) ≤ 1 := by
    intro x
    have hi1 := integrable_fejer_mul hH (hdm x) (hdb x)
    have hi2 : Integrable fun h : ℝ => fejer H h * (1 : ℝ) :=
      integrable_fejer_mul hH measurable_const (M := 1) fun _ => by norm_num
    calc (∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖) ≤ ∫ h : ℝ, fejer H h * (1 : ℝ) := by
          refine integral_mono hi1 hi2 fun h => ?_
          exact mul_le_mul_of_nonneg_left (norm_dAvg_le hN hg1 γ x h) (fejer_nonneg hH h)
      _ = 1 := by rw [integral_mul_const, integral_fejer hH, one_mul]
  have hΨm : Measurable fun x : E3 => ∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖ :=
    measurable_fejerAvg_dAvg N H hgc γ
  have hintΨ : Integrable (fun x : E3 => ∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖)
      (volume.restrict B) := by
    refine Integrable.mono' (integrable_const (1 : ℝ)) hΨm.aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (hΨ0 x)]
    exact hΨ1 x
  have hintL : Integrable (fun x : E3 => ‖cfgAvg N g γ x‖ ^ 2) (volume.restrict B) := by
    refine Integrable.mono' (integrable_const (1 : ℝ))
      ((continuous_cfgAvg N hgc γ).norm.pow 2).aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    nlinarith [norm_nonneg (cfgAvg N g γ x), norm_cfgAvg_le hN hg1 γ x]
  have hintR : Integrable
      (fun x : E3 => 4 * (∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖) + 12 * H / N)
      (volume.restrict B) := (hintΨ.const_mul 4).add (integrable_const _)
  have hstep1 : cfgL2 N B g γ
      ≤ ∫ x in B, (4 * (∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖) + 12 * H / N) := by
    rw [cfgL2]
    exact integral_mono hintL hintR fun x => sq_norm_cfgAvg_le' hN hH hHN hgc hg1 γ x
  have hsplit : (∫ x in B, (4 * (∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖) + 12 * H / N))
      = 4 * (∫ x in B, ∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖)
        + 12 * H / N * (volume B).toReal := by
    rw [integral_add (hintΨ.const_mul 4) (integrable_const _), integral_const_mul,
      setIntegral_const, smul_eq_mul, measureReal_def]
    ring
  have hfub : (∫ x in B, ∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖)
      = ∫ h : ℝ, fejer H h * ∫ x in B, ‖dAvg N g γ x h‖ :=
    integral_fejer_dAvg_swap hN hH hBfin hgc hg1 γ
  calc cfgL2 N B g γ
      ≤ ∫ x in B, (4 * (∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖) + 12 * H / N) := hstep1
    _ = 4 * (∫ x in B, ∫ h : ℝ, fejer H h * ‖dAvg N g γ x h‖)
          + 12 * H / N * (volume B).toReal := hsplit
    _ = 4 * (∫ h : ℝ, fejer H h * ∫ x in B, ‖dAvg N g γ x h‖)
          + 12 * H / N * (volume B).toReal := by rw [hfub]
    _ = 4 * (∫ h : ℝ, fejer H h * cfgL1 N B (dcfgFun g) (dcfgTransl γ h))
          + 12 * H / N * (volume B).toReal := by simp only [cfgL1_eq_dAvg]

open MeasureTheory in
/-- **Pigeonholing the shift.** A lower bound on the `L^2` functional, with the boundary error
absorbed, yields a single shift at which the `L^1` functional of the differenced family is bounded
below. -/
theorem exists_shift_cfgL1_ge {ι : Type*} [Fintype ι] {N H : ℝ} (hN : 0 < N) (hH : 0 < H)
    (hHN : H ≤ N / 4) {B : Set E3} (hBfin : volume B ≠ ⊤) {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) (hg1 : ∀ a x, ‖g a x‖ ≤ 1)
    (γ : ι → (Fin 3 → Polynomial ℝ)) {β : ℝ} (hβ : 0 < β) (hlow : β ≤ cfgL2 N B g γ)
    (hsmall : 12 * H / N * (volume B).toReal ≤ β / 2) :
    ∃ h : ℝ, β / 16 ≤ cfgL1 N B (dcfgFun g) (dcfgTransl γ h) := by
  have hstep := cfgL2_le_fejer_cfgL1 hN hH hHN hBfin hgc hg1 γ
  have hA : β / 8 ≤ ∫ h : ℝ, fejer H h * cfgL1 N B (dcfgFun g) (dcfgTransl γ h) := by
    linarith
  have hm : Measurable fun h : ℝ => cfgL1 N B (dcfgFun g) (dcfgTransl γ h) :=
    measurable_cfgL1_shift N B hgc γ
  have hM : ∀ h : ℝ, |cfgL1 N B (dcfgFun g) (dcfgTransl γ h)| ≤ (volume B).toReal := by
    intro h
    rw [abs_of_nonneg (cfgL1_nonneg _ _ _ _)]
    exact cfgL1_le_volume hN hBfin (fun p => continuous_dcfgFun hgc p)
      (norm_dcfgFun_le hg1) _
  obtain ⟨h, hh⟩ := exists_of_fejer_average_ge hH (by linarith : (0 : ℝ) < β / 8) hm hM hA
  exact ⟨h, by linarith⟩

open MeasureTheory in
/-- The head produced by one step: the unimodular phase of the differenced average, cut off to the
box. It is one-bounded, measurable and supported in `B`, which is exactly what
`Auto.sq_norm_cfgHeadInt_le` asks of a head. -/
noncomputable def dHead {ι : Type*} [Fintype ι] (N : ℝ) (B : Set E3) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (h : ℝ) : E3 → ℂ :=
  B.indicator (unitPhase fun x => dAvg N g γ x h)

theorem measurable_dHead {ι : Type*} [Fintype ι] (N : ℝ) {B : Set E3} (hBm : MeasurableSet B)
    {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ)) (h : ℝ) :
    Measurable (dHead N B g γ h) := by
  refine Measurable.indicator (measurable_unitPhase ?_) hBm
  exact ((continuous_uncurry_dAvg N hgc γ).comp
    (continuous_id.prodMk continuous_const)).measurable

theorem norm_dHead_le {ι : Type*} [Fintype ι] (N : ℝ) (B : Set E3) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (h : ℝ) (x : E3) : ‖dHead N B g γ h x‖ ≤ 1 := by
  classical
  rw [dHead]
  by_cases hx : x ∈ B
  · rw [Set.indicator_of_mem hx]
    exact norm_unitPhase_le _ x
  · rw [Set.indicator_of_notMem hx, norm_zero]
    exact zero_le_one

theorem dHead_eq_zero_of_notMem {ι : Type*} [Fintype ι] (N : ℝ) (B : Set E3) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (h : ℝ) {x : E3} (hx : x ∉ B) : dHead N B g γ h x = 0 := by
  rw [dHead, Set.indicator_of_notMem hx]

open MeasureTheory in
/-- **The bridge.** Pairing the differenced average against its own unimodular phase, cut off to
the box, recovers the `L^1` functional -- so the lower bound produced by the pigeonhole is a lower
bound for a headed functional of the differenced family. -/
theorem cfgHeadInt_dHead {ι : Type*} [Fintype ι] (N : ℝ) {B : Set E3} (hBm : MeasurableSet B)
    (g : ι → E3 → ℂ) (γ : ι → (Fin 3 → Polynomial ℝ)) (h : ℝ) :
    cfgHeadInt N (dHead N B g γ h) (dcfgFun g) (dcfgTransl γ h)
      = ((cfgL1 N B (dcfgFun g) (dcfgTransl γ h) : ℝ) : ℂ) := by
  classical
  rw [cfgHeadInt, cfgL1_eq_dAvg, setIntegral_norm_eq_setIntegral_unitPhase,
    ← integral_indicator hBm]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
  simp only [dHead, dAvg_eq]
  by_cases hx : x ∈ B
  · rw [Set.indicator_of_mem hx, Set.indicator_of_mem hx]
  · rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem hx, zero_mul]

open MeasureTheory in
theorem norm_cfgHeadInt_dHead {ι : Type*} [Fintype ι] (N : ℝ) {B : Set E3}
    (hBm : MeasurableSet B) (g : ι → E3 → ℂ) (γ : ι → (Fin 3 → Polynomial ℝ)) (h : ℝ) :
    ‖cfgHeadInt N (dHead N B g γ h) (dcfgFun g) (dcfgTransl γ h)‖
      = cfgL1 N B (dcfgFun g) (dcfgTransl γ h) := by
  rw [cfgHeadInt_dHead N hBm g γ h, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (cfgL1_nonneg _ _ _ _)]

open MeasureTheory in
/-- **The van der Corput half of the cycle.** From a lower bound on the `L^2` functional, one
shift and one head, with the headed functional of the differenced family bounded below. Together
with `Auto.sq_norm_cfgHeadInt_le` and `Auto.cfgInt_cons` this closes the descent cycle. -/
theorem exists_shift_cfgHeadInt_ge {ι : Type*} [Fintype ι] {N H : ℝ} (hN : 0 < N) (hH : 0 < H)
    (hHN : H ≤ N / 4) {B : Set E3} (hBm : MeasurableSet B) (hBfin : volume B ≠ ⊤)
    {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a)) (hg1 : ∀ a x, ‖g a x‖ ≤ 1)
    (γ : ι → (Fin 3 → Polynomial ℝ)) {β : ℝ} (hβ : 0 < β) (hlow : β ≤ cfgL2 N B g γ)
    (hsmall : 12 * H / N * (volume B).toReal ≤ β / 2) :
    ∃ h : ℝ, β / 16 ≤ ‖cfgHeadInt N (dHead N B g γ h) (dcfgFun g) (dcfgTransl γ h)‖ := by
  obtain ⟨h, hh⟩ := exists_shift_cfgL1_ge hN hH hHN hBfin hgc hg1 γ hβ hlow hsmall
  exact ⟨h, by rwa [norm_cfgHeadInt_dHead N hBm g γ h]⟩



/-! ## Blueprint `lem:pet-reduction`: one full turn of the descent

Composing the two halves gives the step the induction repeats. Note that the head it produces,
`Auto.dHead`, satisfies exactly the three hypotheses the step demands of a head, and the functions
it produces, `Auto.dcfgFun g`, are again continuous and one-bounded, so the conclusion can be fed
straight back into the hypothesis. -/

open MeasureTheory in
/-- **One turn.** Cauchy-Schwarz sheds the head, van der Corput and the pigeonhole produce a
shift, and the unimodular bridge supplies the next head: a headed functional bounded below by
`beta` yields a differenced headed functional bounded below by `beta^2 / (16 vol(B))`. -/
theorem exists_head_descent {ι : Type*} [Fintype ι] {N H : ℝ} (hN : 0 < N) (hH : 0 < H)
    (hHN : H ≤ N / 4) {B : Set E3} (hBm : MeasurableSet B) (hBfin : volume B ≠ ⊤)
    (hBpos : 0 < (volume B).toReal) {g0 : E3 → ℂ} (hg0m : Measurable g0)
    (hg01 : ∀ x, ‖g0 x‖ ≤ 1) (hg0supp : ∀ x, x ∉ B → g0 x = 0)
    {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a)) (hg1 : ∀ a x, ‖g a x‖ ≤ 1)
    (γ : ι → (Fin 3 → Polynomial ℝ)) {β : ℝ} (hβ : 0 < β)
    (hlow : β ≤ ‖cfgHeadInt N g0 g γ‖)
    (hsmall : 12 * H / N * (volume B).toReal ≤ β ^ 2 / (volume B).toReal / 2) :
    ∃ h : ℝ, β ^ 2 / (volume B).toReal / 16
      ≤ ‖cfgHeadInt N (dHead N B g γ h) (dcfgFun g) (dcfgTransl γ h)‖ := by
  have hCS := sq_norm_cfgHeadInt_le hN hBm hBfin hg0m hg01 hg0supp hgc hg1 γ
  have hsq : β ^ 2 ≤ ‖cfgHeadInt N g0 g γ‖ ^ 2 := pow_le_pow_left₀ hβ.le hlow 2
  have hL2 : β ^ 2 / (volume B).toReal ≤ cfgL2 N B g γ := by
    rw [div_le_iff₀ hBpos]
    calc β ^ 2 ≤ ‖cfgHeadInt N g0 g γ‖ ^ 2 := hsq
      _ ≤ (volume B).toReal * cfgL2 N B g γ := hCS
      _ = cfgL2 N B g γ * (volume B).toReal := by ring
  have hβ' : 0 < β ^ 2 / (volume B).toReal := by positivity
  exact exists_shift_cfgHeadInt_ge hN hH hHN hBm hBfin hgc hg1 γ hβ' hL2 hsmall

open MeasureTheory in
/-- The head produced by a turn is a legitimate head for the next one. -/
theorem dHead_is_head {ι : Type*} [Fintype ι] (N : ℝ) {B : Set E3} (hBm : MeasurableSet B)
    {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ)) (h : ℝ) :
    Measurable (dHead N B g γ h) ∧ (∀ x, ‖dHead N B g γ h x‖ ≤ 1)
      ∧ ∀ x, x ∉ B → dHead N B g γ h x = 0 :=
  ⟨measurable_dHead N hBm hgc γ h, norm_dHead_le N B g γ h,
    fun _x hx => dHead_eq_zero_of_notMem N B g γ h hx⟩



/-! ## Blueprint `lem:pet-reduction`: the turn iterated

The turn of `Auto.exists_head_descent` composes with itself: the head it produces is a head, the
functions it produces are continuous and one-bounded, and the index type doubles exactly as in
`Auto.cfgIdx`. Iterating it is the analytic half of the recursion, to be run for as many steps as
the combinatorial half `Auto.petStep_terminates` asks for. -/

/-- The lower bound after `n` turns: each turn squares it and divides by sixteen times the
volume. -/
noncomputable def headBound (V β : ℝ) : ℕ → ℝ
  | 0 => β
  | (n + 1) => (headBound V β n) ^ 2 / V / 16

theorem headBound_succ_left (V β : ℝ) : ∀ n : ℕ,
    headBound V β (n + 1) = headBound V (β ^ 2 / V / 16) n
  | 0 => rfl
  | (n + 1) => by
      change (headBound V β (n + 1)) ^ 2 / V / 16
        = (headBound V (β ^ 2 / V / 16) n) ^ 2 / V / 16
      rw [headBound_succ_left V β n]

open MeasureTheory in
/-- **The turn, iterated.** After `n` turns there is a tuple of shifts and a final head along
which the `n`-fold differenced configuration still obeys the iterated lower bound. -/
theorem exists_iterated_head_descent {N H : ℝ} (hN : 0 < N) (hH : 0 < H) (hHN : H ≤ N / 4)
    {B : Set E3} (hBm : MeasurableSet B) (hBfin : volume B ≠ ⊤)
    (hBpos : 0 < (volume B).toReal) :
    ∀ (n : ℕ) (ι : Type) [Fintype ι] (g : ι → E3 → ℂ) (γ : ι → (Fin 3 → Polynomial ℝ))
      (g0 : E3 → ℂ) (β : ℝ),
      Measurable g0 → (∀ x, ‖g0 x‖ ≤ 1) → (∀ x, x ∉ B → g0 x = 0) →
      (∀ a, Continuous (g a)) → (∀ a x, ‖g a x‖ ≤ 1) →
      (∀ k, k < n → 0 < headBound (volume B).toReal β k) →
      (∀ k, k < n → 12 * H / N * (volume B).toReal
        ≤ headBound (volume B).toReal β k ^ 2 / (volume B).toReal / 2) →
      β ≤ ‖cfgHeadInt N g0 g γ‖ →
      ∃ (hs : Fin n → ℝ) (u : E3 → ℂ), Measurable u ∧ (∀ x, ‖u x‖ ≤ 1)
        ∧ (∀ x, x ∉ B → u x = 0)
        ∧ headBound (volume B).toReal β n
            ≤ ‖cfgHeadInt N u (dcfgFunN n g) (dcfgTranslN n γ hs)‖ := by
  intro n
  induction n with
  | zero =>
      intro ι _ g γ g0 β hg0m hg01 hg0supp _ _ _ _ hlow
      exact ⟨Fin.elim0, g0, hg0m, hg01, hg0supp, hlow⟩
  | succ n ih =>
      intro ι _ g γ g0 β hg0m hg01 hg0supp hgc hg1 hpos hsmall hlow
      have hβ0 : 0 < β := hpos 0 (Nat.succ_pos n)
      have hs0 : 12 * H / N * (volume B).toReal ≤ β ^ 2 / (volume B).toReal / 2 :=
        hsmall 0 (Nat.succ_pos n)
      obtain ⟨h0, hh0⟩ := exists_head_descent hN hH hHN hBm hBfin hBpos hg0m hg01 hg0supp
        hgc hg1 γ hβ0 hlow hs0
      have hconv : ∀ k : ℕ,
          headBound (volume B).toReal (β ^ 2 / (volume B).toReal / 16) k
            = headBound (volume B).toReal β (k + 1) := fun k =>
        (headBound_succ_left _ β k).symm
      obtain ⟨hs', u, hum, hu1, husupp, hb'⟩ := ih (ι × Bool) (dcfgFun g) (dcfgTransl γ h0)
        (dHead N B g γ h0) (β ^ 2 / (volume B).toReal / 16)
        (measurable_dHead N hBm hgc γ h0) (norm_dHead_le N B g γ h0)
        (fun _x hx => dHead_eq_zero_of_notMem N B g γ h0 hx)
        (fun p => continuous_dcfgFun hgc p) (norm_dcfgFun_le hg1)
        (fun k hk => by rw [hconv k]; exact hpos (k + 1) (by omega))
        (fun k hk => by rw [hconv k]; exact hsmall (k + 1) (by omega))
        hh0
      refine ⟨Fin.cons h0 hs', u, hum, hu1, husupp, ?_⟩
      have hT : dcfgTranslN (n + 1) γ (Fin.cons h0 hs') = dcfgTranslN n (dcfgTransl γ h0) hs' := by
        change dcfgTranslN n (dcfgTransl γ ((Fin.cons h0 hs' : Fin (n + 1) → ℝ) 0))
            (fun i => (Fin.cons h0 hs' : Fin (n + 1) → ℝ) i.succ) = _
        simp only [Fin.cons_zero, Fin.cons_succ]
      rw [hT, ← hconv n]
      exact hb'



/-! ## Blueprint `lem:pet-reduction`: merging the constant translations into the head

After the normalization by the selected translation, some members acquire a constant translation:
in the blueprint these are the ones that "become zero" or drop out of the recursion, and
`Auto.petStep` deletes them with its `0 < translDeg` filter. Analytically they do not disappear,
they are absorbed: a member with constant translation contributes a fixed translate of its
function, independent of the parameter, so it multiplies into the head. The head stays
one-bounded and stays supported in `B`, because the factor it acquires is one-bounded.

This is the last piece of bookkeeping the analytic turn needs in order to run alongside
`Auto.petStep`. -/

open MeasureTheory in
/-- The product of the members whose translation is constant, evaluated at the parameter `0`. -/
noncomputable def constFactor {ι : Type*} [Fintype ι] (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (p : ι → Prop) [DecidablePred p] (x : E3) : ℂ :=
  ∏ a ∈ Finset.univ.filter fun a => ¬ p a, g a (x + translAct (γ a) 0)

theorem norm_constFactor_le {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    (hg1 : ∀ a x, ‖g a x‖ ≤ 1) (γ : ι → (Fin 3 → Polynomial ℝ)) (p : ι → Prop)
    [DecidablePred p] (x : E3) : ‖constFactor g γ p x‖ ≤ 1 := by
  rw [constFactor, norm_prod]
  exact Finset.prod_le_one₀ (fun a _ => norm_nonneg _) fun a _ => hg1 a _

theorem continuous_constFactor {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ)) (p : ι → Prop)
    [DecidablePred p] : Continuous (constFactor g γ p) := by
  refine continuous_finsetProd _ fun a _ => ?_
  exact (hgc a).comp (continuous_id.add continuous_const)

/-- Splitting the integrand at a set of members whose translations are constant. -/
theorem cfgProd_split {ι : Type*} [Fintype ι] (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (p : ι → Prop) [DecidablePred p]
    (hconst : ∀ a, ¬ p a → translDeg (γ a) = 0) (x : E3) (t : ℝ) :
    cfgProd g γ x t
      = constFactor g γ p x
        * cfgProd (fun a : {a // p a} => g a.1) (fun a : {a // p a} => γ a.1) x t := by
  classical
  rw [cfgProd, ← Finset.prod_filter_mul_prod_filter_not Finset.univ p, mul_comm, constFactor]
  congr 1
  · refine Finset.prod_congr rfl fun a ha => ?_
    have hp : ¬ p a := by
      simpa using (Finset.mem_filter.mp ha).2
    rw [translAct_of_translDeg_zero (hconst a hp) t 0]
  · rw [cfgProd]
    exact Finset.prod_subtype (p := p) (Finset.univ.filter p) (fun a => by simp)
      (fun a => g a (x + translAct (γ a) t))

open MeasureTheory in
theorem cfgAvg_split {ι : Type*} [Fintype ι] (N : ℝ) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (p : ι → Prop) [DecidablePred p]
    (hconst : ∀ a, ¬ p a → translDeg (γ a) = 0) (x : E3) :
    cfgAvg N g γ x
      = constFactor g γ p x
        * cfgAvg N (fun a : {a // p a} => g a.1) (fun a : {a // p a} => γ a.1) x := by
  rw [cfgAvg, cfgAvg,
    intervalIntegral.integral_congr
      (g := fun t => constFactor g γ p x
        * cfgProd (fun a : {a // p a} => g a.1) (fun a : {a // p a} => γ a.1) x t)
      fun t _ => cfgProd_split g γ p hconst x t,
    intervalIntegral.integral_const_mul, mul_smul_comm]

open MeasureTheory in
/-- **Merging the constant translations into the head.** The members whose translation has become
constant multiply into the head; the reduced family carries only the nonconstant translations,
which are the ones `Auto.petStep` keeps. -/
theorem cfgHeadInt_merge {ι : Type*} [Fintype ι] (N : ℝ) (g0 : E3 → ℂ) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (p : ι → Prop) [DecidablePred p]
    (hconst : ∀ a, ¬ p a → translDeg (γ a) = 0) :
    cfgHeadInt N g0 g γ
      = cfgHeadInt N (fun x => g0 x * constFactor g γ p x)
          (fun a : {a // p a} => g a.1) (fun a : {a // p a} => γ a.1) := by
  rw [cfgHeadInt, cfgHeadInt]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
  simp only [cfgAvg_split N g γ p hconst x]
  ring

/-- The merged head is still one-bounded. -/
theorem norm_mul_constFactor_le {ι : Type*} [Fintype ι] {g0 : E3 → ℂ}
    (hg01 : ∀ x, ‖g0 x‖ ≤ 1) {g : ι → E3 → ℂ} (hg1 : ∀ a x, ‖g a x‖ ≤ 1)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (p : ι → Prop) [DecidablePred p] (x : E3) :
    ‖g0 x * constFactor g γ p x‖ ≤ 1 := by
  rw [norm_mul]
  exact ((mul_le_of_le_one_left (norm_nonneg _) (hg01 x)).trans (norm_constFactor_le hg1 γ p x))

/-- The merged head is still supported in the box. -/
theorem mul_constFactor_eq_zero_of_notMem {ι : Type*} [Fintype ι] {B : Set E3} {g0 : E3 → ℂ}
    (hg0supp : ∀ x, x ∉ B → g0 x = 0) (g : ι → E3 → ℂ) (γ : ι → (Fin 3 → Polynomial ℝ))
    (p : ι → Prop) [DecidablePred p] {x : E3} (hx : x ∉ B) :
    g0 x * constFactor g γ p x = 0 := by
  rw [hg0supp x hx, zero_mul]

/-- The merged head is still measurable. -/
theorem measurable_mul_constFactor {ι : Type*} [Fintype ι] {g0 : E3 → ℂ} (hg0m : Measurable g0)
    {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ))
    (p : ι → Prop) [DecidablePred p] :
    Measurable fun x => g0 x * constFactor g γ p x :=
  hg0m.mul (continuous_constFactor hgc γ p).measurable



/-! ## Blueprint `lem:pet-reduction`: the endpoint is the cube of the local uniformity norm

"A final Cauchy-Schwarz produces the cube defining `U^{s_*}`."  At the end of the recursion every
surviving translation is constant, so the configuration is a family of fixed translates of a
single function, one per vertex of a cube, conjugated according to the parity of the vertex. That
is literally the cube expansion `Auto.fdiffIter_eq_cubeProd` of the iterated Fejer difference whose
average defines `Auto.locUnifPow`.

This section provides the dictionary: the constant translation attached to a vector, the cube
family, and the identification of its configuration product with `Auto.fdiffIter`. -/

/-- The constant polynomial translation by a fixed vector. -/
noncomputable def constTransl (v : E3) : Fin 3 → Polynomial ℝ := fun d => Polynomial.C (v d)

theorem translAct_constTransl (v : E3) (t : ℝ) : translAct (constTransl v) t = v := by
  ext d
  rw [translAct_apply, constTransl]
  simp

theorem translDeg_constTransl (v : E3) : translDeg (constTransl v) = 0 := by
  simp [translDeg, constTransl]

/-- The endpoint family: one member per vertex of the `s`-cube, a copy of `f` conjugated according
to the parity of the vertex. -/
noncomputable def cubeFun (s : ℕ) (f : E3 → ℂ) : (Fin s → Bool) → E3 → ℂ :=
  fun ω x => conjPar (numFalse ω) (f x)

/-- The endpoint translations: the constant translation by `cubeShift h ω` along `basisVec j`. -/
noncomputable def cubeTransl (j : Fin 3) {s : ℕ} (h : Fin s → ℝ) :
    (Fin s → Bool) → (Fin 3 → Polynomial ℝ) :=
  fun ω => constTransl (cubeShift h ω • basisVec j)

theorem translDeg_cubeTransl (j : Fin 3) {s : ℕ} (h : Fin s → ℝ) (ω : Fin s → Bool) :
    translDeg (cubeTransl j h ω) = 0 :=
  translDeg_constTransl _

theorem norm_cubeFun_le {s : ℕ} {f : E3 → ℂ} (hf1 : ∀ x, ‖f x‖ ≤ 1) (ω : Fin s → Bool) (x : E3) :
    ‖cubeFun s f ω x‖ ≤ 1 := by
  change ‖conjPar (numFalse ω) (f x)‖ ≤ 1
  rw [norm_conjPar]
  exact hf1 x

theorem continuous_cubeFun {s : ℕ} {f : E3 → ℂ} (hf : Continuous f) (ω : Fin s → Bool) :
    Continuous (cubeFun s f ω) := by
  change Continuous fun x => conjPar (numFalse ω) (f x)
  by_cases hω : Even (numFalse ω)
  · simpa only [conjPar, ite_eq_left hω] using hf
  · simpa only [conjPar, ite_eq_right hω, Function.comp_def] using Complex.continuous_conj.comp hf

/-- **The endpoint identification.** The configuration product of the cube family is the iterated
Fejer difference; in particular it does not depend on the parameter. -/
theorem cfgProd_cube (j : Fin 3) (s : ℕ) (f : E3 → ℂ) (h : Fin s → ℝ) (x : E3) (t : ℝ) :
    cfgProd (cubeFun s f) (cubeTransl j h) x t = fdiffIter (basisVec j) s h f x := by
  rw [cfgProd, fdiffIter_eq_cubeProd]
  refine Finset.prod_congr rfl fun ω _ => ?_
  change conjPar (numFalse ω) (f (x + translAct (constTransl (cubeShift h ω • basisVec j)) t))
      = conjPar (numFalse ω) (f (x + cubeShift h ω • basisVec j))
  rw [translAct_constTransl]

open MeasureTheory in
theorem cfgAvg_cube {N : ℝ} (hN : 0 < N) (j : Fin 3) (s : ℕ) (f : E3 → ℂ) (h : Fin s → ℝ)
    (x : E3) :
    cfgAvg N (cubeFun s f) (cubeTransl j h) x = fdiffIter (basisVec j) s h f x := by
  rw [cfgAvg,
    intervalIntegral.integral_congr (g := fun _ : ℝ => fdiffIter (basisVec j) s h f x)
      fun t _ => cfgProd_cube j s f h x t,
    intervalIntegral.integral_const, sub_zero, smul_smul, inv_mul_cancel₀ hN.ne', one_smul]

open MeasureTheory in
/-- The headed functional of the cube family is the pairing of the head against the iterated Fejer
difference -- the inner integral of `Auto.locUnifPow`, weighted by the head instead of unweighted.
This is the shape in which the endpoint of the descent reaches the local uniformity norm. -/
theorem cfgHeadInt_cube {N : ℝ} (hN : 0 < N) (j : Fin 3) (s : ℕ) (f : E3 → ℂ) (h : Fin s → ℝ)
    (g0 : E3 → ℂ) :
    cfgHeadInt N g0 (cubeFun s f) (cubeTransl j h)
      = ∫ x : E3, g0 x * fdiffIter (basisVec j) s h f x := by
  rw [cfgHeadInt]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
  simp only [cfgAvg_cube hN j s f h]



/-! ## Blueprint `lem:pet-reduction`: the entry point in headed form

The hypothesis of the lemma is a lower bound on the four-linear form `Auto.Lambda`. Read through
`Auto.cfgAvg_curveTransl`, that form *is* a headed functional: the head is the conjugate of `f_0`,
the family is `f_1, f_2, f_3` and the translations are the monomial ones `Auto.curveTransl`. So
the descent can be started directly from the hypothesis, with no intermediate Cauchy-Schwarz --
the first turn performs it. -/

open MeasureTheory in
/-- **The entry point.** The four-linear form is the headed functional of the monomial
configuration, with head the conjugate of `f_0`. -/
theorem Lambda_eq_cfgHeadInt (N : ℝ) (f0 : E3 → ℂ) (f : Fin 3 → E3 → ℂ) :
    Lambda N f0 f = cfgHeadInt N (fun x => (starRingEnd ℂ) (f0 x)) f curveTransl := by
  rw [Lambda, cfgHeadInt]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
  simp only [cfgAvg_curveTransl]
  ring

theorem measurable_conj_head {f0 : E3 → ℂ} (hf0m : Measurable f0) :
    Measurable fun x => (starRingEnd ℂ) (f0 x) :=
  Complex.continuous_conj.measurable.comp hf0m

theorem norm_conj_head_le {f0 : E3 → ℂ} (hf01 : ∀ x, ‖f0 x‖ ≤ 1) (x : E3) :
    ‖(starRingEnd ℂ) (f0 x)‖ ≤ 1 := by
  rw [RCLike.norm_conj]
  exact hf01 x

theorem conj_head_eq_zero_of_notMem {B : Set E3} {f0 : E3 → ℂ}
    (hsupp : ∀ x, x ∉ B → f0 x = 0) {x : E3} (hx : x ∉ B) :
    (starRingEnd ℂ) (f0 x) = 0 := by
  rw [hsupp x hx, map_zero]

open MeasureTheory in
/-- **The descent, started from the hypothesis of `lem:pet-reduction`.** A lower bound on the
four-linear form drives the iterated turn: after `n` turns there is a tuple of shifts and a head
along which the `n`-fold differenced monomial configuration still obeys the iterated bound. -/
theorem exists_iterated_descent_of_Lambda {N H : ℝ} (hN : 0 < N) (hH : 0 < H) (hHN : H ≤ N / 4)
    {B : Set E3} (hBm : MeasurableSet B) (hBfin : volume B ≠ ⊤)
    (hBpos : 0 < (volume B).toReal) {f0 : E3 → ℂ} (hf0m : Measurable f0)
    (hf01 : ∀ x, ‖f0 x‖ ≤ 1) (hsupp : ∀ x, x ∉ B → f0 x = 0)
    {f : Fin 3 → E3 → ℂ} (hfc : ∀ i, Continuous (f i)) (hf1 : ∀ i x, ‖f i x‖ ≤ 1)
    (n : ℕ) {β : ℝ}
    (hpos : ∀ k, k < n → 0 < headBound (volume B).toReal β k)
    (hsmall : ∀ k, k < n → 12 * H / N * (volume B).toReal
      ≤ headBound (volume B).toReal β k ^ 2 / (volume B).toReal / 2)
    (hlow : β ≤ ‖Lambda N f0 f‖) :
    ∃ (hs : Fin n → ℝ) (u : E3 → ℂ), Measurable u ∧ (∀ x, ‖u x‖ ≤ 1)
      ∧ (∀ x, x ∉ B → u x = 0)
      ∧ headBound (volume B).toReal β n
          ≤ ‖cfgHeadInt N u (dcfgFunN n f) (dcfgTranslN n curveTransl hs)‖ := by
  refine exists_iterated_head_descent hN hH hHN hBm hBfin hBpos n (Fin 3) f curveTransl
    (fun x => (starRingEnd ℂ) (f0 x)) β (measurable_conj_head hf0m)
    (fun x => norm_conj_head_le hf01 x) (fun _x hx => conj_head_eq_zero_of_notMem hsupp hx)
    hfc hf1 hpos hsmall ?_
  rwa [Lambda_eq_cfgHeadInt] at hlow



/-! ## Blueprint `lem:pet-reduction`: the `L^2` pairing, foundation of the corrected van der Corput

The correction recorded in `automation/ErrorReport.md` at 2026-09-15T11:35:11-04:00 requires van der
Corput to be applied to the `L^2(E3)`-valued average `t -> cfgProd(., t)` rather than pointwise in
the point. The inner product of two such vectors is the pairing defined here. Its parameter
average over `t` at a fixed shift `h` is exactly `Auto.cfgInt` of the differenced family -- a
quantity with no modulus inside the integral in the point, hence one that
`Auto.cfgInt_translSub` can normalize.

A configuration is *supported in* `B` when its integrand vanishes off `B` for every parameter.
That property is what makes the pairing finite, and it is preserved by differencing, which is why
it can be carried along the recursion. -/

open MeasureTheory in
/-- The configuration is supported in `B`: its integrand vanishes off `B`, uniformly in the
parameter. -/
-- SUPERSEDED. `Auto.CfgSupported` and the four lemmas that consume it below
-- (`Auto.CfgSupported.dcfg`, `Auto.cfgSupported_cons`, `Auto.cfgPair_eq_setIntegral`,
-- `Auto.norm_cfgPair_le`, `Auto.integral_sq_norm_eq_setIntegral_of_cfgSupported`) are true but no
-- longer used: quantifying over *every* real parameter, the notion does not survive the
-- normalization, since the displacement `translAct P t` is unbounded in `t`. See
-- `automation/ErrorReport.md` at 2026-09-15T13:16:11-04:00. The chain now runs on
-- `Auto.CfgMemSupported` (a property of the members, giving bounds at every parameter) and
-- `Auto.CfgSupportedOn` (the product support over a bounded parameter range). Kept, as
-- `Auto.cfgL2_step` is, so that the record of the route is complete; do not build on them.
def CfgSupported {ι : Type*} [Fintype ι] (B : Set E3) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) : Prop :=
  ∀ (t : ℝ) (x : E3), x ∉ B → cfgProd g γ x t = 0

/-- Being supported in `B` is inherited by the differenced configuration. -/
theorem CfgSupported.dcfg {ι : Type*} [Fintype ι] {B : Set E3} {g : ι → E3 → ℂ}
    {γ : ι → (Fin 3 → Polynomial ℝ)} (hs : CfgSupported B g γ) (h : ℝ) :
    CfgSupported B (dcfgFun g) (dcfgTransl γ h) := by
  intro t x hx
  rw [cfgProd_dcfg, hs t x hx, map_zero, mul_zero]

/-- A configuration with a member supported in `B` and carrying the zero translation is supported
in `B`. -/
theorem cfgSupported_cons {ι : Type*} [Fintype ι] {B : Set E3} {g0 : E3 → ℂ}
    (hg0supp : ∀ x, x ∉ B → g0 x = 0) (g : ι → E3 → ℂ) (γ : ι → (Fin 3 → Polynomial ℝ)) :
    CfgSupported B (cfgCons g0 g) (translCons γ) := by
  intro t x hx
  rw [cfgProd_cons, hg0supp x hx, zero_mul]

open MeasureTheory in
/-- The `L^2` pairing of the configuration integrand at two parameters -- the inner product of the
two vectors that the corrected van der Corput step compares. -/
noncomputable def cfgPair {ι : Type*} [Fintype ι] (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (t s : ℝ) : ℂ :=
  ∫ x : E3, cfgProd g γ x t * (starRingEnd ℂ) (cfgProd g γ x s)



/-! ## Blueprint `lem:pet-reduction`: the support invariant that survives the turn

`Auto.CfgSupported` is a property of the *product* and, as recorded in `automation/ErrorReport.md`
at 2026-09-15T13:16:11-04:00, it does not survive the normalization. The property that does is a
property of the *members*: each member function supported in a fixed set. It is preserved by
differencing (the functions are the same up to conjugation), by the normalization (which changes
only the translations), by merging into the head (a product of translates), and by shedding (which
only removes members).

Its strength is that the bound it gives on the pairing holds for **all** parameters, with no
restriction: the product is dominated by any single one of its factors, and translating the point
does not change the measure of that factor's support. -/

/-- Every member of the configuration is supported in `B`. -/
def CfgMemSupported {ι : Type*} (B : Set E3) (g : ι → E3 → ℂ) : Prop :=
  ∀ (a : ι) (x : E3), x ∉ B → g a x = 0

/-- Member support is inherited by the differenced configuration: its members are the original
functions and their conjugates. -/
theorem CfgMemSupported.dcfg {ι : Type*} {B : Set E3} {g : ι → E3 → ℂ}
    (hm : CfgMemSupported B g) : CfgMemSupported B (dcfgFun g) := by
  intro p x hx
  have h0 : g p.1 x = 0 := hm p.1 x hx
  rw [dcfgFun]
  by_cases hp : p.2 <;> simp [hp, h0]

/-- The integrand is dominated by any single one of its factors. -/
theorem norm_cfgProd_le_single {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    (hg1 : ∀ a x, ‖g a x‖ ≤ 1) (γ : ι → (Fin 3 → Polynomial ℝ)) (a₀ : ι) (x : E3) (t : ℝ) :
    ‖cfgProd g γ x t‖ ≤ ‖g a₀ (x + translAct (γ a₀) t)‖ := by
  classical
  rw [cfgProd, norm_prod, ← Finset.mul_prod_erase _ _ (Finset.mem_univ a₀)]
  calc ‖g a₀ (x + translAct (γ a₀) t)‖
        * ∏ a ∈ Finset.univ.erase a₀, ‖g a (x + translAct (γ a) t)‖
      ≤ ‖g a₀ (x + translAct (γ a₀) t)‖ * 1 :=
        mul_le_mul_of_nonneg_left
          (Finset.prod_le_one₀ (fun a _ => norm_nonneg _) fun a _ => hg1 a _) (norm_nonneg _)
    _ = ‖g a₀ (x + translAct (γ a₀) t)‖ := mul_one _

open MeasureTheory in
/-- A one-bounded function supported in a set of finite measure is integrable, with `L^1` norm at
most the measure of that set -- and translating the point changes neither. -/
theorem integral_norm_shift_le {B : Set E3} (hBm : MeasurableSet B) (hBfin : volume B ≠ ⊤)
    {f : E3 → ℂ} (hfc : Continuous f) (hf1 : ∀ x, ‖f x‖ ≤ 1)
    (hsupp : ∀ x, x ∉ B → f x = 0) (v : E3) :
    Integrable (fun x : E3 => ‖f (x + v)‖) ∧ (∫ x : E3, ‖f (x + v)‖) ≤ (volume B).toReal := by
  classical
  have : IsFiniteMeasure (volume.restrict B) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact lt_of_le_of_ne le_top hBfin⟩
  have hIonB : IntegrableOn (fun _ : E3 => (1 : ℝ)) B := integrable_const 1
  have hindint : Integrable (B.indicator fun _ : E3 => (1 : ℝ)) volume :=
    hIonB.integrable_indicator hBm
  have hdomf : ∀ y : E3, ‖f y‖ ≤ B.indicator (fun _ : E3 => (1 : ℝ)) y := by
    intro y
    by_cases hy : y ∈ B
    · rw [Set.indicator_of_mem hy]
      exact hf1 y
    · rw [Set.indicator_of_notMem hy, hsupp y hy, norm_zero]
  have hint0 : Integrable (fun y : E3 => ‖f y‖) := by
    refine Integrable.mono' hindint hfc.norm.aestronglyMeasurable
      (Filter.Eventually.of_forall fun y => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
    exact hdomf y
  refine ⟨hint0.comp_add_right v, ?_⟩
  have hshift : (∫ x : E3, ‖f (x + v)‖) = ∫ y : E3, ‖f y‖ :=
    integral_add_right_eq_self (fun y : E3 => ‖f y‖) v
  rw [hshift]
  have hmono : (∫ y : E3, ‖f y‖) ≤ ∫ y : E3, B.indicator (fun _ : E3 => (1 : ℝ)) y :=
    integral_mono hint0 hindint hdomf
  rwa [integral_indicator hBm, setIntegral_const, smul_eq_mul, mul_one,
    measureReal_def] at hmono

open MeasureTheory in
/-- Continuity of the integrand in the point, at a fixed parameter. -/
theorem continuous_cfgProd_point {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ)) (t : ℝ) :
    Continuous fun x : E3 => cfgProd g γ x t :=
  (continuous_uncurry_cfgProd hgc γ).comp (continuous_id.prodMk continuous_const)

open MeasureTheory in
/-- **The `L^1` bound on the integrand, uniform in the parameter.** This is the point of the
member-support invariant: the bound holds for every `t`, because translating the point does not
change the measure of the dominating factor's support. -/
theorem integral_norm_cfgProd_le {ι : Type*} [Fintype ι] {B : Set E3} (hBm : MeasurableSet B)
    (hBfin : volume B ≠ ⊤) {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a))
    (hg1 : ∀ a x, ‖g a x‖ ≤ 1) (hm : CfgMemSupported B g)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (a₀ : ι) (t : ℝ) :
    Integrable (fun x : E3 => ‖cfgProd g γ x t‖)
      ∧ (∫ x : E3, ‖cfgProd g γ x t‖) ≤ (volume B).toReal := by
  obtain ⟨hdint, hdle⟩ := integral_norm_shift_le hBm hBfin (hgc a₀) (hg1 a₀) (hm a₀)
    (translAct (γ a₀) t)
  have hdom : ∀ x : E3, ‖cfgProd g γ x t‖ ≤ ‖g a₀ (x + translAct (γ a₀) t)‖ :=
    fun x => norm_cfgProd_le_single hg1 γ a₀ x t
  have hint : Integrable (fun x : E3 => ‖cfgProd g γ x t‖) := by
    refine Integrable.mono' hdint
      (continuous_cfgProd_point hgc γ t).norm.aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
    exact hdom x
  exact ⟨hint, le_trans (integral_mono hint hdint hdom) hdle⟩

open MeasureTheory in
/-- **The pairing is bounded, at every pair of parameters.** No restriction on the parameters is
needed, in contrast with the bound derived from `Auto.CfgSupported`. -/
theorem norm_cfgPair_le' {ι : Type*} [Fintype ι] {B : Set E3} (hBm : MeasurableSet B)
    (hBfin : volume B ≠ ⊤) {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a))
    (hg1 : ∀ a x, ‖g a x‖ ≤ 1) (hm : CfgMemSupported B g)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (a₀ : ι) (u v : ℝ) :
    ‖cfgPair g γ u v‖ ≤ (volume B).toReal := by
  obtain ⟨hint, hle⟩ := integral_norm_cfgProd_le hBm hBfin hgc hg1 hm γ a₀ u
  have hcu : Continuous fun x : E3 => cfgProd g γ x u := continuous_cfgProd_point hgc γ u
  have hcv : Continuous fun x : E3 => cfgProd g γ x v := continuous_cfgProd_point hgc γ v
  have hptwise : ∀ x : E3,
      ‖cfgProd g γ x u * (starRingEnd ℂ) (cfgProd g γ x v)‖ ≤ ‖cfgProd g γ x u‖ := by
    intro x
    rw [norm_mul, RCLike.norm_conj]
    exact mul_le_of_le_one_right (norm_nonneg _) (norm_cfgProd_le hg1 γ x v)
  rw [cfgPair]
  refine le_trans (norm_integral_le_integral_norm _) (le_trans ?_ hle)
  refine integral_mono ?_ hint hptwise
  refine Integrable.mono' hint
    ((hcu.mul (Complex.continuous_conj.comp hcv)).norm).aestronglyMeasurable
    (Filter.Eventually.of_forall fun x => ?_)
  rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
  exact hptwise x



/-! ## Blueprint `lem:pet-reduction`: the product support over a bounded parameter range

The bounds no longer need a parameter restriction (`Auto.norm_cfgPair_le'`), but one place still
does: identifying the integral over the box with the integral over `E3`, where the Fubini
domination is by the indicator of a fixed set.

`Auto.CfgSupported` cannot serve there, and no constructor can rescue it: it quantifies over every
real parameter, so the set would have to contain `B - translAct q t` for all `t`, which for a
nonconstant translation is unbounded. The notion below restricts the parameter to `|t| <= L`,
which is all any call site uses -- every integral in the chain runs over `t ∈ [0, N]` with shifts in
`[0, H]`, `H <= N`, so `L = 2N` suffices. Over such a range the member-support invariant does
supply a fixed set, namely the box enlarged by the displacement, which is the blueprint's own
enlargement of `I_N(C)` from step to step.

Introduced alongside `Auto.CfgSupported` rather than replacing it, so that the lemmas already proved
keep compiling while they are ported one at a time. -/

/-- The integrand vanishes off `B`, for every parameter of size at most `L`. -/
def CfgSupportedOn {ι : Type*} [Fintype ι] (L : ℝ) (B : Set E3) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) : Prop :=
  ∀ t : ℝ, |t| ≤ L → ∀ x : E3, x ∉ B → cfgProd g γ x t = 0

/-- The unrestricted notion is the restricted one at every parameter. -/
theorem CfgSupported.on {ι : Type*} [Fintype ι] {B : Set E3} {g : ι → E3 → ℂ}
    {γ : ι → (Fin 3 → Polynomial ℝ)} (hs : CfgSupported B g γ) (L : ℝ) :
    CfgSupportedOn L B g γ :=
  fun t _ x hx => hs t x hx

/-- Restricted support is inherited by the differenced configuration. -/
theorem CfgSupportedOn.dcfg {ι : Type*} [Fintype ι] {L : ℝ} {B : Set E3} {g : ι → E3 → ℂ}
    {γ : ι → (Fin 3 → Polynomial ℝ)} (hs : CfgSupportedOn L B g γ) (h : ℝ) :
    CfgSupportedOn L B (dcfgFun g) (dcfgTransl γ h) := by
  intro t ht x hx
  rw [cfgProd_dcfg, hs t ht x hx, map_zero, mul_zero]

/-- The box enlarged by the displacement a translation performs over the parameter range: `x` lies
in it when `x + translAct q t` lies in `B` for some `|t| <= L`. -/
def cfgBox (L : ℝ) (B : Set E3) (q : Fin 3 → Polynomial ℝ) : Set E3 :=
  {x : E3 | ∃ t : ℝ, |t| ≤ L ∧ x + translAct q t ∈ B}

theorem mem_cfgBox {L : ℝ} {B : Set E3} {q : Fin 3 → Polynomial ℝ} {t : ℝ} (ht : |t| ≤ L)
    {x : E3} (hx : x + translAct q t ∈ B) : x ∈ cfgBox L B q :=
  ⟨t, ht, hx⟩

/-- **The product support over a bounded parameter range, from the member-support invariant.**
This is the constructor `Auto.CfgSupported` cannot have. -/
theorem cfgSupportedOn_of_memSupported {ι : Type*} [Fintype ι] {B : Set E3} {g : ι → E3 → ℂ}
    (hm : CfgMemSupported B g) (γ : ι → (Fin 3 → Polynomial ℝ)) (a₀ : ι) (L : ℝ) :
    CfgSupportedOn L (cfgBox L B (γ a₀)) g γ := by
  intro t ht x hx
  have hnot : x + translAct (γ a₀) t ∉ B := fun hmem => hx (mem_cfgBox ht hmem)
  exact Finset.prod_eq_zero (Finset.mem_univ a₀) (hm a₀ _ hnot)

/-- The enlarged box is a union of translates of `B`, so it is measurable whenever `B` is and the
displacement is taken over a compact parameter range: here it is written as the image of a
continuous map, which is what the measurability argument at the call site uses. -/
theorem cfgBox_subset_iUnion (L : ℝ) (B : Set E3) (q : Fin 3 → Polynomial ℝ) :
    cfgBox L B q ⊆ ⋃ t ∈ Set.Icc (-L) L, (fun y : E3 => y - translAct q t) '' B := by
  rintro x ⟨t, ht, hx⟩
  refine Set.mem_iUnion.mpr ⟨t, Set.mem_iUnion.mpr ⟨?_, ?_⟩⟩
  · exact ⟨neg_le_of_abs_le ht, le_of_abs_le ht⟩
  · exact ⟨x + translAct q t, hx, by abel⟩

open MeasureTheory in
/-- On a configuration with restricted support, the pairing is an integral over the box, at
parameters within the range. -/
theorem cfgPair_eq_setIntegralOn {ι : Type*} [Fintype ι] {L : ℝ} {B : Set E3} {g : ι → E3 → ℂ}
    {γ : ι → (Fin 3 → Polynomial ℝ)} (hs : CfgSupportedOn L B g γ) {t : ℝ} (ht : |t| ≤ L)
    (s : ℝ) :
    cfgPair g γ t s = ∫ x in B, cfgProd g γ x t * (starRingEnd ℂ) (cfgProd g γ x s) := by
  rw [cfgPair]
  refine (setIntegral_eq_integral_of_forall_compl_eq_zero fun x hx => ?_).symm
  rw [hs t ht x hx, zero_mul]

open MeasureTheory in
/-- The same, for the quantity the expansion of the inner average produces. -/
theorem integral_sq_norm_eq_setIntegral_of_cfgSupportedOn {ι : Type*} [Fintype ι] {L : ℝ}
    {B : Set E3} {g : ι → E3 → ℂ} {γ : ι → (Fin 3 → Polynomial ℝ)}
