open MeasureTheory in
theorem lintegral_unitCube_le (j : Fin 3) {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Measurable (f i))
    (z : Fin 3 → ℤ) :
    (∫⁻ x in unitCube z, ‖Atilde 1 f x‖ₑ ^ (8 / 9 : ℝ))
      ≤ uhC1 j ^ (8 / 9 : ℝ)
        * (uhM j f 0 z ^ uhTh j 0 * (uhM j f 1 z ^ uhTh j 1 * uhM j f 2 z ^ uhTh j 2)) := by
  have hq : (0 : ℝ) < 8 / 9 := by norm_num
  set g : Fin 3 → E3 → ℂ := fun i => Set.indicator (bigCube z) (f i) with hg
  have hgm : ∀ i, Measurable (g i) := fun i => (hf i).indicator (measurableSet_bigCube z)
  have hloc : (∫⁻ x in unitCube z, ‖Atilde 1 f x‖ₑ ^ (8 / 9 : ℝ))
      = ∫⁻ x in unitCube z, ‖Atilde 1 g x‖ₑ ^ (8 / 9 : ℝ) := by
    refine setLIntegral_congr_fun (measurableSet_unitCube z) fun x hx => ?_
    rw [Atilde_localize hx f]
  have hstep1 : (∫⁻ x in unitCube z, ‖Atilde 1 g x‖ₑ ^ (8 / 9 : ℝ))
      ≤ (∫⁻ x in unitCube z, ‖Atilde 1 g x‖ₑ) ^ (8 / 9 : ℝ) :=
    lintegral_enorm_rpow_le_of_probability
      (measurable_Atilde_one hgm).aestronglyMeasurable hq (by norm_num)
  have hstep2 : (∫⁻ x in unitCube z, ‖Atilde 1 g x‖ₑ) ≤ eLpNorm (Atilde 1 g) 1 volume := by
    rw [eLpNorm_one_eq_lintegral_enorm (by fun_prop)]
    exact setLIntegral_le_lintegral _ _
  have hS := eLpNorm_Atilde_le j g hgm
  have hnorm : ∀ i, eLpNorm (g i) (ENNReal.ofReal ((uhB j i)⁻¹)) volume
      = uhM j f i z ^ (uhB j i) := by
    intro i
    rw [hg, eLpNorm_indicator_rpow (measurableSet_bigCube z) (inv_pos.mpr (uhB_pos j i)), uhM,
      one_div, inv_inv]
  simp only [hnorm, Fin.prod_univ_three] at hS
  have hfin : (eLpNorm (Atilde 1 g) 1 volume) ^ (8 / 9 : ℝ)
      ≤ uhC1 j ^ (8 / 9 : ℝ)
        * (uhM j f 0 z ^ uhTh j 0 * (uhM j f 1 z ^ uhTh j 1 * uhM j f 2 z ^ uhTh j 2)) := by
    refine le_trans (ENNReal.rpow_le_rpow hS hq.le) (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le, ENNReal.mul_rpow_of_nonneg _ _ hq.le,
      ENNReal.mul_rpow_of_nonneg _ _ hq.le, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
      ← ENNReal.rpow_mul, uhTh, uhTh, uhTh, mul_assoc]
    ring_nf
  calc (∫⁻ x in unitCube z, ‖Atilde 1 f x‖ₑ ^ (8 / 9 : ℝ))
      = ∫⁻ x in unitCube z, ‖Atilde 1 g x‖ₑ ^ (8 / 9 : ℝ) := hloc
    _ ≤ (∫⁻ x in unitCube z, ‖Atilde 1 g x‖ₑ) ^ (8 / 9 : ℝ) := hstep1
    _ ≤ (eLpNorm (Atilde 1 g) 1 volume) ^ (8 / 9 : ℝ) := ENNReal.rpow_le_rpow hstep2 hq.le
    _ ≤ _ := hfin



open MeasureTheory in
theorem lintegral_enorm_rpow_eq_eLpNorm {g : E3 → ℂ} {r : ℝ} (hr : 0 < r)
    (hg : AEStronglyMeasurable g volume := by fun_prop) :
    (∫⁻ y, ‖g y‖ₑ ^ r) = eLpNorm g (ENNReal.ofReal r) volume ^ r := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hr) ENNReal.ofReal_ne_top
    (by fun_prop),
    ENNReal.toReal_ofReal hr.le, ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hr.ne',
    ENNReal.rpow_one]

open MeasureTheory in
/-- **Patch 2 `lem:adjoint-gain-to-subunit` (Q).** The subunit bound for the upper-half monomial
average at scale one. -/
theorem eLpNorm_Atilde_subunit (j : Fin 3) (f : Fin 3 → E3 → ℂ) (hf : ∀ i, Measurable (f i)) :
    eLpNorm (Atilde 1 f) (ENNReal.ofReal (8 / 9)) volume
      ≤ 8 ^ ((9 : ℝ) / 8) * uhC1 j
        * ∏ i, eLpNorm (f i) (ENNReal.ofReal ((uhB j i)⁻¹)) volume := by
  have hq : (0 : ℝ) < 8 / 9 := by norm_num
  set N : Fin 3 → ℝ≥0∞ := fun i => eLpNorm (f i) (ENNReal.ofReal ((uhB j i)⁻¹)) volume with hN
  have hexp : ∀ i : Fin 3, ((uhB j i)⁻¹) * uhTh j i = 8 / 9 := by
    intro i
    have hne : uhB j i ≠ 0 := (uhB_pos j i).ne'
    rw [uhTh]
    field_simp
  have hMbound : ∀ i, (∑' z : Fin 3 → ℤ, uhM j f i z) ≤ 8 * N i ^ ((uhB j i)⁻¹) := by
    intro i
    have hmeas : Measurable fun y : E3 => ‖f i y‖ₑ ^ ((uhB j i)⁻¹) := (hf i).enorm.pow_const _
    have h := tsum_setLIntegral_bigCube_le hmeas
    rw [lintegral_enorm_rpow_eq_eLpNorm (inv_pos.mpr (uhB_pos j i))] at h
    exact h
  have hfac : ∀ i : Fin 3, (8 * N i ^ ((uhB j i)⁻¹)) ^ uhTh j i
      = 8 ^ uhTh j i * N i ^ (8 / 9 : ℝ) := by
    intro i
    rw [ENNReal.mul_rpow_of_nonneg _ _ (uhTh_pos j i).le, ← ENNReal.rpow_mul, hexp i]
  have h8 : (8 : ℝ≥0∞) ^ uhTh j 0 * ((8 : ℝ≥0∞) ^ uhTh j 1 * (8 : ℝ≥0∞) ^ uhTh j 2) = 8 := by
    rw [← ENNReal.rpow_add _ _ (by norm_num) (by norm_num),
      ← ENNReal.rpow_add _ _ (by norm_num) (by norm_num),
      show uhTh j 0 + (uhTh j 1 + uhTh j 2) = 1 by have := uhTh_sum j; linarith]
    exact ENNReal.rpow_one 8
  have hkey : (∫⁻ x, ‖Atilde 1 f x‖ₑ ^ (8 / 9 : ℝ))
      ≤ 8 * (uhC1 j ^ (8 / 9 : ℝ)
        * (N 0 ^ (8 / 9 : ℝ) * (N 1 ^ (8 / 9 : ℝ) * N 2 ^ (8 / 9 : ℝ)))) := by
    rw [lintegral_eq_tsum_unitCube]
    calc (∑' z : Fin 3 → ℤ, ∫⁻ x in unitCube z, ‖Atilde 1 f x‖ₑ ^ (8 / 9 : ℝ))
        ≤ ∑' z : Fin 3 → ℤ, uhC1 j ^ (8 / 9 : ℝ)
            * (uhM j f 0 z ^ uhTh j 0 * (uhM j f 1 z ^ uhTh j 1 * uhM j f 2 z ^ uhTh j 2)) :=
          ENNReal.tsum_le_tsum (lintegral_unitCube_le j hf)
      _ = uhC1 j ^ (8 / 9 : ℝ) * ∑' z : Fin 3 → ℤ,
            (uhM j f 0 z ^ uhTh j 0 * (uhM j f 1 z ^ uhTh j 1 * uhM j f 2 z ^ uhTh j 2)) :=
          ENNReal.tsum_mul_left
      _ ≤ uhC1 j ^ (8 / 9 : ℝ) * ((∑' z : Fin 3 → ℤ, uhM j f 0 z) ^ uhTh j 0
            * ((∑' z : Fin 3 → ℤ, uhM j f 1 z) ^ uhTh j 1
              * (∑' z : Fin 3 → ℤ, uhM j f 2 z) ^ uhTh j 2)) :=
          mul_le_mul' le_rfl (tsum_rpow_mul3_le _ _ _ (uhTh_pos j 0) (uhTh_pos j 1)
            (uhTh_pos j 2) (uhTh_sum j))
      _ ≤ uhC1 j ^ (8 / 9 : ℝ) * ((8 * N 0 ^ ((uhB j 0)⁻¹)) ^ uhTh j 0
            * ((8 * N 1 ^ ((uhB j 1)⁻¹)) ^ uhTh j 1
              * (8 * N 2 ^ ((uhB j 2)⁻¹)) ^ uhTh j 2)) := by
          refine mul_le_mul' le_rfl (mul_le_mul'
            (ENNReal.rpow_le_rpow (hMbound 0) (uhTh_pos j 0).le)
            (mul_le_mul' (ENNReal.rpow_le_rpow (hMbound 1) (uhTh_pos j 1).le)
              (ENNReal.rpow_le_rpow (hMbound 2) (uhTh_pos j 2).le)))
      _ = 8 * (uhC1 j ^ (8 / 9 : ℝ)
            * (N 0 ^ (8 / 9 : ℝ) * (N 1 ^ (8 / 9 : ℝ) * N 2 ^ (8 / 9 : ℝ)))) := by
          rw [hfac 0, hfac 1, hfac 2]
          calc uhC1 j ^ (8 / 9 : ℝ) * ((8 ^ uhTh j 0 * N 0 ^ (8 / 9 : ℝ))
                * ((8 ^ uhTh j 1 * N 1 ^ (8 / 9 : ℝ)) * (8 ^ uhTh j 2 * N 2 ^ (8 / 9 : ℝ))))
              = ((8 : ℝ≥0∞) ^ uhTh j 0 * ((8 : ℝ≥0∞) ^ uhTh j 1 * (8 : ℝ≥0∞) ^ uhTh j 2))
                * (uhC1 j ^ (8 / 9 : ℝ)
                  * (N 0 ^ (8 / 9 : ℝ) * (N 1 ^ (8 / 9 : ℝ) * N 2 ^ (8 / 9 : ℝ)))) := by ring
            _ = 8 * (uhC1 j ^ (8 / 9 : ℝ)
                  * (N 0 ^ (8 / 9 : ℝ) * (N 1 ^ (8 / 9 : ℝ) * N 2 ^ (8 / 9 : ℝ)))) := by
                rw [h8]
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simp) ENNReal.ofReal_ne_top (by fun_prop),
    ENNReal.toReal_ofReal hq.le]
  have hroot := ENNReal.rpow_le_rpow hkey (by norm_num : (0 : ℝ) ≤ 1 / (8 / 9))
  refine le_trans hroot (le_of_eq ?_)
  have hundo : ∀ X : ℝ≥0∞, (X ^ (8 / 9 : ℝ)) ^ (1 / (8 / 9) : ℝ) = X := by
    intro X
    rw [← ENNReal.rpow_mul]
    norm_num
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 1 / (8 / 9)),
    ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 1 / (8 / 9)),
    ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 1 / (8 / 9)),
    ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 1 / (8 / 9)),
    hundo, hundo, hundo, hundo, Fin.prod_univ_three,
    show (1 / (8 / 9) : ℝ) = 9 / 8 by norm_num]
  ring



/-! ### Patch 2 `cor:kosz-subunit-internal`

The subunit bound (Q) is exactly the scale-one input `Auto.KoszSubunitScaleOne` that the
blueprint's proof of `thm:kosz-subunit` takes from Kosz-Mirek-Peluse-Wan-Wright; it is now proved
rather than imported. -/

open MeasureTheory in
theorem koszSubunitScaleOne (j : Fin 3) : KoszSubunitScaleOne j := by
  have htop : (8 : ℝ≥0∞) ^ ((9 : ℝ) / 8) * uhC1 j ≠ ⊤ :=
    ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg (by norm_num) (by norm_num))
      (uhC1_ne_top j)
  have hzero : (8 : ℝ≥0∞) ^ ((9 : ℝ) / 8) * uhC1 j ≠ 0 := by
    refine mul_ne_zero ?_ (uhC1_ne_zero j)
    exact (ENNReal.rpow_pos (by norm_num) (by norm_num)).ne'
  refine ⟨8 / 9, fun i => (uhB j i)⁻¹, ((8 : ℝ≥0∞) ^ ((9 : ℝ) / 8) * uhC1 j).toReal,
    ⟨by norm_num, by norm_num⟩, ?_, ?_, ?_, ?_, ?_⟩
  · intro i
    fin_cases j <;> fin_cases i <;>
      norm_num [uhB, Matrix.cons_val_two, Matrix.tail_cons]
  · fin_cases j <;> norm_num [uhB, Matrix.cons_val_two, Matrix.tail_cons]
  · rw [Fin.sum_univ_three]
    fin_cases j <;> norm_num [uhB, Matrix.cons_val_two, Matrix.tail_cons]
  · exact ENNReal.toReal_pos hzero htop
  · intro f hfc
    rw [ENNReal.ofReal_toReal htop]
    exact eLpNorm_Atilde_subunit j f fun i => (hfc i).measurable



/-! ### `thm:strong-real-improving` at every index triple

`Auto.main_smoothing` needs `Auto.KoszAdjoint j` for every `j`, so `cor:kosz-53-internal` and with
it `thm:strong-real-improving` are needed at every choice of the distinguished pair. The improving
vertex is available at all six choices (`Auto.restrictedWeak_A_improving`), the three trivial
vertices and the `L^infinity` vertex are symmetric, and the weights of the convex combination are
the same numbers attached to the permuted indices. -/
theorem fin3_third {j m k i : Fin 3} (hjm : j ≠ m) (hkm : k ≠ m) (hjk : j ≠ k)
    (hij : i ≠ j) (him : i ≠ m) : i = k := by
  revert hjm hkm hjk hij him
  revert j m k i
  decide

/-- The target exponent vector of `thm:strong-real-improving`, with `1/2` at the `L^2` index `j`,
`7/40` at the index `m`, and `1/6` at the remaining one. -/
noncomputable def targetV (j m : Fin 3) : Fin 3 → ℝ :=
  fun i => if i = j then 1 / 2 else if i = m then 7 / 40 else 1 / 6

theorem targetV_zero_one : targetV 0 1 = targetVertex := by
  funext i
  fin_cases i <;> simp [targetV, targetVertex]

open MeasureTheory in
/-- One chain at `N = 1`, at an arbitrary index triple. -/
theorem restrictedStrong_A_chain' {m j k : Fin 3} (hjm : j ≠ m) (hkm : k ≠ m) (hjk : j ≠ k)
    {θ qm : ℝ} (hqm0 : 1 < qm) (hqm1 : qm < 6 / 5)
    (hθqm : 1 / qm = (1 - θ) / 1 + θ / (6 / 5))
    {w : Fin 3 → ℝ} (hw : ∀ i, 0 ≤ w i) (hsum : w 0 + w 1 + w 2 = 1) :
    RestrictedStrong (A 1)
      (fun i => qm / (6 / 5) * ((1 - θ) * w i + θ * improvingExp j m i)
        + ((6 : ℝ) / 5 - qm) / (6 / 5) * trivialVertexInf i) (6 / 5) (chainConst θ qm) := by
  have hmeas := measInd_A (N := 1) zero_le_one
  have h₀ : RestrictedWeak (A 1) w 1 1 :=
