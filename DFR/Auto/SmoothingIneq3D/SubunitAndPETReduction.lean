/-- The pairing is bounded by the volume of the support. -/
theorem norm_cfgPair_le {ι : Type*} [Fintype ι] {B : Set E3} (hBfin : volume B ≠ ⊤)
    {g : ι → E3 → ℂ} (hg1 : ∀ a x, ‖g a x‖ ≤ 1)
    {γ : ι → (Fin 3 → Polynomial ℝ)} (hs : CfgSupported B g γ) (t s : ℝ) :
    ‖cfgPair g γ t s‖ ≤ (volume B).toReal := by
