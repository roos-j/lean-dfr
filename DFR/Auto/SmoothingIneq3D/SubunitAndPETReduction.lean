  have hz : (∫ a in S, cfgProd g γ x (t + a)) = 0 := by
    rw [setIntegral_congr_fun hSm (g := fun _ : ℝ => (0 : ℂ))
      (fun a ha => hs (t + a) (hTS a ha) x hx), integral_zero]
  rw [hz, norm_zero]
  norm_num


open MeasureTheory in
/-- On a configuration supported in `B`, the pairing is an integral over `B`. -/
theorem cfgPair_eq_setIntegral {ι : Type*} [Fintype ι] {B : Set E3} {g : ι → E3 → ℂ}
    {γ : ι → (Fin 3 → Polynomial ℝ)} (hs : CfgSupported B g γ) (t s : ℝ) :
    cfgPair g γ t s = ∫ x in B, cfgProd g γ x t * (starRingEnd ℂ) (cfgProd g γ x s) := by
  rw [cfgPair]
