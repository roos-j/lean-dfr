/-- The pairing at equal parameters is the squared `L^2` norm of the integrand, a nonnegative
real. -/
theorem cfgPair_self {ι : Type*} [Fintype ι] (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (t : ℝ) :
    cfgPair g γ t t = ((∫ x : E3, ‖cfgProd g γ x t‖ ^ 2 : ℝ) : ℂ) := by
  rw [cfgPair, ← integral_complex_ofReal]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
  change cfgProd g γ x t * (starRingEnd ℂ) (cfgProd g γ x t)
      = ((‖cfgProd g γ x t‖ ^ 2 : ℝ) : ℂ)
  simp [Complex.mul_conj, Complex.normSq_eq_norm_sq]



/-! ## Blueprint `lem:pet-reduction`: expanding the square of an inner average

First analytic step of the `L^2`-valued van der Corput. The square of the modulus of an integral
is the double integral of the pairing of the integrand with itself; carrying that through the
integral in the point turns the squared `L^2` norm of an inner average into a double parameter
integral of `Auto.cfgPair`, with the integral in the point innermost. That placement is the whole
object of the exercise: it is what the pointwise-modulus route of the superseded entries could
never produce. -/

open MeasureTheory in
/-- The square of the modulus of an integral is the double integral of the pairing. -/
theorem sq_norm_setIntegral_eq_double {S : Set ℝ} {W : ℝ → ℂ} (_hW : IntegrableOn W S) :
    ((‖∫ a in S, W a‖ ^ 2 : ℝ) : ℂ)
      = ∫ a in S, ∫ b in S, W a * (starRingEnd ℂ) (W b) := by
  have h1 : ((‖∫ a in S, W a‖ ^ 2 : ℝ) : ℂ)
      = (∫ a in S, W a) * (starRingEnd ℂ) (∫ b in S, W b) := by
    rw [Complex.mul_conj, Complex.normSq_eq_norm_sq]
  have h2 : (starRingEnd ℂ) (∫ b in S, W b) = ∫ b in S, (starRingEnd ℂ) (W b) :=
    integral_conj.symm
  rw [h1, h2, ← integral_mul_const]
  refine integral_congr_ae (Filter.Eventually.of_forall fun a => ?_)
  change W a * (∫ b in S, (starRingEnd ℂ) (W b)) = ∫ b in S, W a * (starRingEnd ℂ) (W b)
  rw [← integral_const_mul]

open MeasureTheory in
/-- A quantity built pointwise from the integrand of a configuration supported in `B` vanishes off
`B`, so its integral over the whole space is an integral over `B`. -/
theorem integral_sq_norm_eq_setIntegral_of_cfgSupported {ι : Type*} [Fintype ι] {B : Set E3}
    {g : ι → E3 → ℂ} {γ : ι → (Fin 3 → Polynomial ℝ)} (hs : CfgSupported B g γ)
    (S : Set ℝ) (t : ℝ) :
    (∫ x : E3, ‖∫ a in S, cfgProd g γ x (t + a)‖ ^ 2)
      = ∫ x in B, ‖∫ a in S, cfgProd g γ x (t + a)‖ ^ 2 := by
  refine (setIntegral_eq_integral_of_forall_compl_eq_zero fun x hx => ?_).symm
  have hz : (∫ a in S, cfgProd g γ x (t + a)) = 0 := by
    rw [show (fun a : ℝ => cfgProd g γ x (t + a)) = fun _ : ℝ => (0 : ℂ) from
      funext fun a => hs (t + a) x hx, integral_zero]
  rw [hz, norm_zero]
  norm_num

open MeasureTheory in
/-- **The squared `L^2` norm of an inner average, expanded.** Two applications of Fubini move the
integral in the point inside the two parameter integrals, where it is exactly `Auto.cfgPair`. -/
theorem ofReal_integral_sq_norm_innerAvg {ι : Type*} [Fintype ι] {L : ℝ} {B : Set E3}
    (hBfin : volume B ≠ ⊤) {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a))
    (hg1 : ∀ a x, ‖g a x‖ ≤ 1) {γ : ι → (Fin 3 → Polynomial ℝ)} (hs : CfgSupportedOn L B g γ)
    {H : ℝ} (t : ℝ) (hTa : ∀ a ∈ Set.Ioc (0 : ℝ) H, |t + a| ≤ L) :
    ((∫ x : E3, ‖∫ a in Set.Ioc (0 : ℝ) H, cfgProd g γ x (t + a)‖ ^ 2 : ℝ) : ℂ)
      = ∫ a in Set.Ioc (0 : ℝ) H, ∫ b in Set.Ioc (0 : ℝ) H, cfgPair g γ (t + a) (t + b) := by
  classical
  set S : Set ℝ := Set.Ioc (0 : ℝ) H with hSdef
  have hSfin : volume S < ⊤ := by
    rw [hSdef, Real.volume_Ioc]
    exact ENNReal.ofReal_lt_top
  have : IsFiniteMeasure (volume.restrict B) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact lt_of_le_of_ne le_top hBfin⟩
  have : IsFiniteMeasure (volume.restrict S) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact hSfin⟩
  have hjoint : Continuous fun p : E3 × ℝ => cfgProd g γ p.1 p.2 :=
    continuous_uncurry_cfgProd hgc γ
  have hWint : ∀ x : E3, IntegrableOn (fun a : ℝ => cfgProd g γ x (t + a)) S := by
    intro x
    refine Integrable.mono' (integrable_const (1 : ℝ))
      ((continuous_cfgProd hgc γ x).comp
        (continuous_const.add continuous_id)).aestronglyMeasurable
      (Filter.Eventually.of_forall fun a => ?_)
    simpa using norm_cfgProd_le hg1 γ x (t + a)
  have hbound : ∀ (x : E3) (a b : ℝ),
      ‖cfgProd g γ x (t + a) * (starRingEnd ℂ) (cfgProd g γ x (t + b))‖ ≤ 1 := by
    intro x a b
    rw [norm_mul, RCLike.norm_conj]
    exact ((mul_le_of_le_one_left (norm_nonneg _) (norm_cfgProd_le hg1 γ x (t + a))).trans
      (norm_cfgProd_le hg1 γ x (t + b)))
  -- the inner exchange, at a fixed first parameter
  have hswap2 : ∀ a : ℝ, (∫ x in B, ∫ b in S,
        cfgProd g γ x (t + a) * (starRingEnd ℂ) (cfgProd g γ x (t + b)))
      = ∫ b in S, ∫ x in B,
        cfgProd g γ x (t + a) * (starRingEnd ℂ) (cfgProd g γ x (t + b)) := by
    intro a
    refine integral_integral_swap ?_
    refine Integrable.mono' (integrable_const (1 : ℝ)) ?_
      (Filter.Eventually.of_forall fun p => ?_)
    · refine Continuous.aestronglyMeasurable ?_
      exact (hjoint.comp (continuous_fst.prodMk continuous_const)).mul
        (Complex.continuous_conj.comp
          (hjoint.comp (continuous_fst.prodMk (continuous_const.add continuous_snd))))
    · obtain ⟨x, b⟩ := p
      simpa using hbound x a b
  -- the outer exchange
  have hcOuter : Continuous fun q : (E3 × ℝ) × ℝ =>
      cfgProd g γ q.1.1 (t + q.1.2) * (starRingEnd ℂ) (cfgProd g γ q.1.1 (t + q.2)) :=
    (hjoint.comp ((continuous_fst.comp continuous_fst).prodMk
        (continuous_const.add (continuous_snd.comp continuous_fst)))).mul
      (Complex.continuous_conj.comp
        (hjoint.comp ((continuous_fst.comp continuous_fst).prodMk
          (continuous_const.add continuous_snd))))
  have hswap1 : (∫ x in B, ∫ a in S, ∫ b in S,
        cfgProd g γ x (t + a) * (starRingEnd ℂ) (cfgProd g γ x (t + b)))
      = ∫ a in S, ∫ x in B, ∫ b in S,
        cfgProd g γ x (t + a) * (starRingEnd ℂ) (cfgProd g γ x (t + b)) := by
    refine integral_integral_swap ?_
    refine Integrable.mono' (integrable_const ((volume S).toReal)) ?_
      (Filter.Eventually.of_forall fun p => ?_)
    · exact (hcOuter.stronglyMeasurable.integral_prod_right'
        (ν := volume.restrict S)).aestronglyMeasurable
    · obtain ⟨x, a⟩ := p
      have := norm_setIntegral_le_of_norm_le_const (C := 1) (μ := volume) (s := S)
        (f := fun b : ℝ => cfgProd g γ x (t + a)
          * (starRingEnd ℂ) (cfgProd g γ x (t + b))) hSfin fun b _ => hbound x a b
