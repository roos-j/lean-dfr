  rw [integral_sq_norm_eq_setIntegral_of_cfgSupportedOn hs hSm t hTa, ← integral_complex_ofReal]
  calc (∫ x in B, ((‖∫ a in S, cfgProd g γ x (t + a)‖ ^ 2 : ℝ) : ℂ))
      = ∫ x in B, ∫ a in S, ∫ b in S,
          cfgProd g γ x (t + a) * (starRingEnd ℂ) (cfgProd g γ x (t + b)) :=
        integral_congr_ae (Filter.Eventually.of_forall fun x =>
          sq_norm_setIntegral_eq_double (hWint x))
    _ = ∫ a in S, ∫ x in B, ∫ b in S,
          cfgProd g γ x (t + a) * (starRingEnd ℂ) (cfgProd g γ x (t + b)) := hswap1
    _ = ∫ a in S, ∫ b in S, ∫ x in B,
          cfgProd g γ x (t + a) * (starRingEnd ℂ) (cfgProd g γ x (t + b)) :=
        integral_congr_ae (Filter.Eventually.of_forall fun a => hswap2 a)
    _ = ∫ a in S, ∫ b in S, cfgPair g γ (t + a) (t + b) := by
        refine setIntegral_congr_fun hSm fun a ha => ?_
        refine setIntegral_congr_fun hSm fun b _ => ?_
        exact (cfgPair_eq_setIntegralOn hs (hTa a ha) (t + b)).symm



/-! ## Blueprint `lem:pet-reduction`: van der Corput without taking the modulus in the point

The obstruction recorded on 2026-09-15T11:35:11-04:00 is that `Auto.sq_norm_cfgAvg_le'` takes the
modulus pointwise in the point. It turns out that no Hilbert-space machinery is needed to avoid
that: the two analytic steps of van der Corput -- replacing an average by an average of shifted
averages, and Cauchy-Schwarz in the parameter -- both *square* the modulus they produce, and a
square is a product. So they may be applied pointwise in the point, with the existing scalar
lemmas, and the quantity that reaches the integral in the point is already
`|int_a cfgProd(x, t+a) da|^2`, which `Auto.ofReal_integral_sq_norm_innerAvg` expands into a double
parameter integral of `Auto.cfgPair`.

The modulus is taken only at the very end, on a scalar function of the shift -- outside the integral
in the point. That is exactly what the superseded route could not arrange. -/

open MeasureTheory in
/-- **The scalar step, stopped before the modulus.** The square of an integral is controlled by
the mean square of its inner averages, with no modulus of a paired quantity anywhere: from
`Auto.norm_integral_avg_sub_le` (the boundary error) and `Auto.sq_norm_avg_le` (Cauchy-Schwarz in
the parameter). -/
theorem sq_norm_integral_le_inner {F : ℝ → ℂ} (hFm : Measurable F)
    (hFi : ∀ c d : ℝ, IntervalIntegrable F volume c d) (hF : ∀ t, ‖F t‖ ≤ 1)
    {N H : ℝ} (hN : 0 < N) (hH : 0 < H) (c : ℝ) :
    ‖∫ t in c..(c + N), F t‖ ^ 2
      ≤ 2 * N * (H⁻¹ ^ 2 * ∫ t in c..(c + N), ‖∫ a in (0 : ℝ)..H, F (t + a)‖ ^ 2)
        + 8 * H ^ 2 := by
  have h4 : ‖∫ t in c..(c + N), F t‖
      ≤ ‖H⁻¹ • ∫ h in (0 : ℝ)..H, ∫ t in c..(c + N), F (t + h)‖ + 2 * H := by
    have h6 := norm_sub_norm_le (∫ t in c..(c + N), F t)
      (H⁻¹ • ∫ h in (0 : ℝ)..H, ∫ t in c..(c + N), F (t + h))
    have h7 := norm_integral_avg_sub_le hFm hFi hF hN.le hH c
    linarith
  have h3 := sq_norm_avg_le hFm hF hN hH c
  have hA0 : (0 : ℝ) ≤ ‖H⁻¹ • ∫ h in (0 : ℝ)..H, ∫ t in c..(c + N), F (t + h)‖ :=
    norm_nonneg _
  have hn0 : (0 : ℝ) ≤ ‖∫ t in c..(c + N), F t‖ := norm_nonneg _
  nlinarith [h4, h3, hA0, hn0,
    sq_nonneg (‖H⁻¹ • ∫ h in (0 : ℝ)..H, ∫ t in c..(c + N), F (t + h)‖ - 2 * H)]

open MeasureTheory in
/-- The mean square, over the box, of the inner average of the configuration integrand. -/
noncomputable def innerSq {ι : Type*} [Fintype ι] (B : Set E3) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (H t : ℝ) : ℝ :=
  ∫ x in B, ‖∫ a in (0 : ℝ)..H, cfgProd g γ x (t + a)‖ ^ 2

open MeasureTheory in
theorem innerSq_nonneg {ι : Type*} [Fintype ι] (B : Set E3) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (H t : ℝ) : 0 ≤ innerSq B g γ H t :=
  integral_nonneg fun _x => sq_nonneg _

open MeasureTheory in
/-- The inner average is jointly continuous in the point and the parameter. -/
theorem continuous_innerAvg {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ)) (H : ℝ) :
    Continuous fun q : E3 × ℝ => ∫ a in (0 : ℝ)..H, cfgProd g γ q.1 (q.2 + a) := by
  have hc : Continuous fun p : (E3 × ℝ) × ℝ => cfgProd g γ p.1.1 (p.1.2 + p.2) :=
    (continuous_uncurry_cfgProd hgc γ).comp
      ((continuous_fst.comp continuous_fst).prodMk
        ((continuous_snd.comp continuous_fst).add continuous_snd))
  exact intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' hc 0 H

open MeasureTheory in
/-- **The van der Corput step for the `L^2` functional.** Every modulus taken is squared, hence a
product, so nothing is lost: the bound is by the mean square of the inner averages. -/
theorem cfgL2_le_innerSq {ι : Type*} [Fintype ι] {N H : ℝ} (hN : 0 < N) (hH : 0 < H)
    {B : Set E3} (hBfin : volume B ≠ ⊤) {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a))
    (hg1 : ∀ a x, ‖g a x‖ ≤ 1) (γ : ι → (Fin 3 → Polynomial ℝ)) :
    cfgL2 N B g γ
      ≤ 2 * N⁻¹ * H⁻¹ ^ 2 * (∫ t in (0 : ℝ)..N, innerSq B g γ H t)
        + 8 * (H / N) ^ 2 * (volume B).toReal := by
  classical
  have : IsFiniteMeasure (volume.restrict B) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact lt_of_le_of_ne le_top hBfin⟩
  have hV0 : (0 : ℝ) ≤ (volume B).toReal := ENNReal.toReal_nonneg
  set T : E3 → ℝ := fun x => ∫ t in (0 : ℝ)..N, ‖∫ a in (0 : ℝ)..H, cfgProd g γ x (t + a)‖ ^ 2
    with hTdef
  -- the pointwise bound
  have hpt : ∀ x : E3, ‖cfgAvg N g γ x‖ ^ 2
      ≤ 2 * N⁻¹ * H⁻¹ ^ 2 * T x + 8 * (H / N) ^ 2 := by
    intro x
    have hFm : Measurable (cfgProd g γ x) := (continuous_cfgProd hgc γ x).measurable
    have hFi : ∀ c d : ℝ, IntervalIntegrable (cfgProd g γ x) volume c d := fun c d =>
      (continuous_cfgProd hgc γ x).intervalIntegrable c d
    have hF : ∀ t, ‖cfgProd g γ x t‖ ≤ 1 := norm_cfgProd_le hg1 γ x
    have hkey := sq_norm_integral_le_inner hFm hFi hF hN hH (0 : ℝ)
    rw [zero_add] at hkey
    have hCA : ‖cfgAvg N g γ x‖ ^ 2
        = N⁻¹ ^ 2 * ‖∫ t in (0 : ℝ)..N, cfgProd g γ x t‖ ^ 2 := by
      rw [cfgAvg, norm_smul, Real.norm_eq_abs,
        abs_of_nonneg (le_of_lt (inv_pos.mpr hN)), mul_pow]
    rw [hCA]
    have hmul := mul_le_mul_of_nonneg_left hkey (by positivity : (0 : ℝ) ≤ N⁻¹ ^ 2)
    refine hmul.trans (le_of_eq ?_)
    rw [hTdef]
    field_simp
  -- integrability of the two sides over the box
  have hTc : Continuous T := by
    have hc : Continuous fun q : E3 × ℝ =>
        ‖∫ a in (0 : ℝ)..H, cfgProd g γ q.1 (q.2 + a)‖ ^ 2 :=
      (continuous_innerAvg hgc γ H).norm.pow 2
    exact intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
      (by exact hc.comp (continuous_fst.prodMk continuous_snd)) 0 N
  have hTb : ∀ x : E3, |T x| ≤ N * H ^ 2 := by
    intro x
    have hb : ∀ t ∈ Set.uIoc (0 : ℝ) N,
        ‖(‖∫ a in (0 : ℝ)..H, cfgProd g γ x (t + a)‖ ^ 2 : ℝ)‖ ≤ H ^ 2 := by
      intro t _
      have hia : ∀ a ∈ Set.uIoc (0 : ℝ) H, ‖cfgProd g γ x (t + a)‖ ≤ 1 := fun a _ =>
        norm_cfgProd_le hg1 γ x (t + a)
      have hle := intervalIntegral.norm_integral_le_of_norm_le_const hia
      rw [sub_zero, abs_of_pos hH] at hle
      rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
      nlinarith [norm_nonneg (∫ a in (0 : ℝ)..H, cfgProd g γ x (t + a)), hle, hH.le]
    have := intervalIntegral.norm_integral_le_of_norm_le_const hb
    rw [sub_zero, abs_of_pos hN] at this
    calc |T x| = ‖T x‖ := (Real.norm_eq_abs _).symm
      _ ≤ H ^ 2 * N := this
      _ = N * H ^ 2 := by ring
  have hintL : Integrable (fun x : E3 => ‖cfgAvg N g γ x‖ ^ 2) (volume.restrict B) := by
    refine Integrable.mono' (integrable_const (1 : ℝ))
      ((continuous_cfgAvg N hgc γ).norm.pow 2).aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    nlinarith [norm_nonneg (cfgAvg N g γ x), norm_cfgAvg_le hN hg1 γ x]
  have hintT : Integrable T (volume.restrict B) := by
    refine Integrable.mono' (integrable_const (N * H ^ 2)) hTc.aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => ?_)
    rw [Real.norm_eq_abs]
    exact hTb x
  have hintR : Integrable
      (fun x : E3 => 2 * N⁻¹ * H⁻¹ ^ 2 * T x + 8 * (H / N) ^ 2) (volume.restrict B) :=
    (hintT.const_mul _).add (integrable_const _)
  -- integrate the pointwise bound and exchange the point with the parameter
  have hstep : cfgL2 N B g γ
      ≤ ∫ x in B, (2 * N⁻¹ * H⁻¹ ^ 2 * T x + 8 * (H / N) ^ 2) := by
    rw [cfgL2]
    exact integral_mono hintL hintR hpt
  have hsplit : (∫ x in B, (2 * N⁻¹ * H⁻¹ ^ 2 * T x + 8 * (H / N) ^ 2))
      = 2 * N⁻¹ * H⁻¹ ^ 2 * (∫ x in B, T x) + 8 * (H / N) ^ 2 * (volume B).toReal := by
    rw [integral_add (hintT.const_mul _) (integrable_const _), integral_const_mul,
      setIntegral_const, smul_eq_mul, measureReal_def]
    ring
  have hswap : (∫ x in B, T x) = ∫ t in (0 : ℝ)..N, innerSq B g γ H t := by
    simp only [hTdef, innerSq, intervalIntegral.integral_of_le hN.le]
    refine integral_integral_swap ?_
    refine Integrable.mono' (integrable_const (H ^ 2)) ?_
      (Filter.Eventually.of_forall fun p => ?_)
    · exact ((continuous_innerAvg hgc γ H).norm.pow 2).aestronglyMeasurable
    · obtain ⟨x, t⟩ := p
      have hia : ∀ a ∈ Set.uIoc (0 : ℝ) H, ‖cfgProd g γ x (t + a)‖ ≤ 1 := fun a _ =>
        norm_cfgProd_le hg1 γ x (t + a)
      have hle := intervalIntegral.norm_integral_le_of_norm_le_const hia
      rw [sub_zero, abs_of_pos hH] at hle
      change ‖‖∫ a in (0 : ℝ)..H, cfgProd g γ x (t + a)‖ ^ 2‖ ≤ H ^ 2
      rw [Real.norm_eq_abs, abs_of_nonneg
        (by positivity : (0 : ℝ) ≤ ‖∫ a in (0 : ℝ)..H, cfgProd g γ x (t + a)‖ ^ 2)]
      nlinarith [norm_nonneg (∫ a in (0 : ℝ)..H, cfgProd g γ x (t + a)), hle, hH.le]
  rw [hsplit, hswap] at hstep
  exact hstep



/-! ## Blueprint `lem:pet-reduction`: the capped pairing and the change of shift variables

The scalar development compares `int_t F(t+a) conj(F(t+b)) dt` over the interval with the same
integrand over the intersection of the interval and its translate, at the single shift `h = a - b`.
Exactly the same comparison is needed here, with `Auto.cfgPair` in place of `F(t+a) conj(F(t+b))`.
Everything about the intervals is reusable verbatim -- `Auto.capSet`, `Auto.capLeft`,
`Auto.capRight`, `Auto.endpoint_displacement_le`, `Auto.volume_capSet_le` mention no integrand --
and only the integrand bound changes, from `1` to the volume of the box. -/

open MeasureTheory in
/-- The difference of two interval integrals of a function bounded by `M`, with the scaling in `M`
that `Auto.norm_integral_sub_integral_le` fixes at `M = 1`. -/
theorem norm_integral_sub_integral_le' {g : ℝ → ℂ} {M : ℝ}
    (hgi : ∀ c d : ℝ, IntervalIntegrable g volume c d) (hg : ∀ t, ‖g t‖ ≤ M) (p q p' q' : ℝ) :
    ‖(∫ t in p..q, g t) - ∫ t in p'..q', g t‖ ≤ M * (|p - p'| + |q - q'|) := by
  have hsplit : (∫ t in p'..p, g t) + (∫ t in p..q, g t) + (∫ t in q..q', g t)
      = ∫ t in p'..q', g t := by
    rw [intervalIntegral.integral_add_adjacent_intervals (hgi _ _) (hgi _ _),
      intervalIntegral.integral_add_adjacent_intervals (hgi _ _) (hgi _ _)]
  have hdiff : (∫ t in p..q, g t) - ∫ t in p'..q', g t
      = -(∫ t in p'..p, g t) - ∫ t in q..q', g t := by
    rw [← hsplit]
    ring
  have hb1 : ‖∫ t in p'..p, g t‖ ≤ M * |p - p'| := by
    have hb := intervalIntegral.norm_integral_le_of_norm_le_const (C := M) (a := p') (b := p)
      (f := g) fun t _ => hg t
    simpa [abs_sub_comm] using hb
  have hb2 : ‖∫ t in q..q', g t‖ ≤ M * |q - q'| := by
    have hb := intervalIntegral.norm_integral_le_of_norm_le_const (C := M) (a := q) (b := q')
      (f := g) fun t _ => hg t
    simpa [abs_sub_comm] using hb
  rw [hdiff]
  calc ‖-(∫ t in p'..p, g t) - ∫ t in q..q', g t‖
      ≤ ‖-(∫ t in p'..p, g t)‖ + ‖∫ t in q..q', g t‖ := norm_sub_le _ _
    _ = ‖∫ t in p'..p, g t‖ + ‖∫ t in q..q', g t‖ := by rw [norm_neg]
    _ ≤ M * |p - p'| + M * |q - q'| := add_le_add hb1 hb2
    _ = M * (|p - p'| + |q - q'|) := by ring

open MeasureTheory in
/-- **The pairing at two shifts is measurable in the interval variable.** Stated in the
`ℝ × E3` shape that `Auto.measurable_setIntegral_dAvg` already uses; the `ℝ × ℝ` product form
exhausts the elaborator's heartbeats on this space. -/
theorem measurable_cfgPairPair {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ)) (a b : ℝ) :
    Measurable fun t : ℝ => cfgPair g γ (t + a) (t + b) := by
  have hjoint : Continuous fun p : E3 × ℝ => cfgProd g γ p.1 p.2 :=
    continuous_uncurry_cfgProd hgc γ
  have hc : StronglyMeasurable fun q : ℝ × E3 =>
      cfgProd g γ q.2 (q.1 + a) * (starRingEnd ℂ) (cfgProd g γ q.2 (q.1 + b)) :=
    Continuous.stronglyMeasurable
      ((hjoint.comp (continuous_snd.prodMk (continuous_fst.add_const a))).mul
        (Complex.continuous_conj.comp
          (hjoint.comp (continuous_snd.prodMk (continuous_fst.add_const b)))))
  simp only [cfgPair]
  exact (hc.integral_prod_right' (ν := volume)).measurable

open MeasureTheory in
/-- The pairing along a fixed shift is measurable. -/
theorem measurable_cfgPairShift {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ)) (h : ℝ) :
    Measurable fun s : ℝ => cfgPair g γ (s + h) s := by
  have hjoint : Continuous fun p : E3 × ℝ => cfgProd g γ p.1 p.2 :=
    continuous_uncurry_cfgProd hgc γ
  have hc : StronglyMeasurable fun q : ℝ × E3 =>
      cfgProd g γ q.2 (q.1 + h) * (starRingEnd ℂ) (cfgProd g γ q.2 q.1) :=
    Continuous.stronglyMeasurable
      ((hjoint.comp (continuous_snd.prodMk (continuous_fst.add_const h))).mul
        (Complex.continuous_conj.comp
          (hjoint.comp (continuous_snd.prodMk continuous_fst))))
  simp only [cfgPair]
  exact (hc.integral_prod_right' (ν := volume)).measurable

open MeasureTheory in
/-- The pairing, integrated over the intersection of the interval with its translate. -/
noncomputable def cfgCapPair {ι : Type*} [Fintype ι] (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (c N h : ℝ) : ℂ :=
  ∫ t in capSet c N h, cfgPair g γ (t + h) t

open MeasureTheory in
theorem cfgCapPair_eq_intervalIntegral {ι : Type*} [Fintype ι] (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) {N h : ℝ} (hh : |h| ≤ N) (c : ℝ) :
    cfgCapPair g γ c N h
      = ∫ t in capLeft c h..capRight c N h, cfgPair g γ (t + h) t := by
  rw [cfgCapPair, capSet_eq_Ioc, intervalIntegral.integral_of_le (capLeft_le_capRight hh c)]

open MeasureTheory in
theorem norm_cfgCapPair_le {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    {γ : ι → (Fin 3 → Polynomial ℝ)} {M : ℝ} (hM0 : 0 ≤ M)
    (hMb : ∀ u v : ℝ, ‖cfgPair g γ u v‖ ≤ M) {N : ℝ} (hN : 0 ≤ N) (c h : ℝ) :
    ‖cfgCapPair g γ c N h‖ ≤ M * N := by
  have hfin : volume (capSet c N h) < ⊤ := by
    rw [capSet_eq_Ioc]
    exact measure_Ioc_lt_top
  have hb := norm_setIntegral_le_of_norm_le_const (C := M)
    (f := fun t : ℝ => cfgPair g γ (t + h) t) hfin
    (fun t _ => hMb (t + h) t)
  exact le_trans hb (mul_le_mul_of_nonneg_left (volume_capSet_le hN c h) hM0)

open MeasureTheory in
/-- **The cost of the change of shift variables, at one pair of shifts.** Substituting `t + b` for
`t` makes the integrand depend only on the difference of the shifts; replacing the shifted interval
by the capped one costs the volume of the box times twice the shift range. -/
theorem norm_cfgPairIntegral_sub_cfgCapPair_le {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) {γ : ι → (Fin 3 → Polynomial ℝ)} {M : ℝ} (hM0 : 0 ≤ M)
    (hMb : ∀ u v : ℝ, ‖cfgPair g γ u v‖ ≤ M)
    {N H a b : ℝ} (hHN : H ≤ N) (ha : a ∈ Set.Icc (0 : ℝ) H) (hb : b ∈ Set.Icc (0 : ℝ) H)
    (c : ℝ) :
    ‖(∫ t in c..(c + N), cfgPair g γ (t + a) (t + b)) - cfgCapPair g γ c N (a - b)‖
      ≤ M * (2 * H) := by
  have habs : |a - b| ≤ N := by
    refine le_trans (abs_le.mpr ⟨?_, ?_⟩) hHN
    · linarith [ha.1, hb.2]
    · linarith [ha.2, hb.1]
  have hgm := measurable_cfgPairShift hgc γ (a - b)
  have hgb : ∀ s : ℝ, ‖cfgPair g γ (s + (a - b)) s‖ ≤ M := fun s => hMb (s + (a - b)) s
  have hgi : ∀ p q : ℝ,
      IntervalIntegrable (fun s => cfgPair g γ (s + (a - b)) s) volume p q :=
    fun p q => intervalIntegrable_of_bdd' hgm hgb p q
  have hsub : (∫ t in c..(c + N), cfgPair g γ (t + a) (t + b))
      = ∫ s in (c + b)..(c + N + b), cfgPair g γ (s + (a - b)) s := by
    rw [← intervalIntegral.integral_comp_add_right
      (fun s : ℝ => cfgPair g γ (s + (a - b)) s) b]
    refine intervalIntegral.integral_congr fun t _ => ?_
    have ht : t + b + (a - b) = t + a := by ring
    rw [ht]
  rw [hsub, cfgCapPair_eq_intervalIntegral g γ habs c]
  exact le_trans (norm_integral_sub_integral_le' hgi hgb (c + b) (c + N + b)
      (capLeft c (a - b)) (capRight c N (a - b)))
    (mul_le_mul_of_nonneg_left (endpoint_displacement_le ha hb c N) hM0)




/-! ## Blueprint `lem:pet-reduction`: measurability of the pairing in its shifts

The comparison over the square of shifts needs the pairing, the capped pairing and the parametric
integrals of both to be measurable in the shifts. Everything reduces to one joint measurability
statement for `Auto.cfgPair` on `ℝ × ℝ`, after which `Auto.measurable_varSetIntegral` supplies the
rest.

Two points of technique. First, that one statement is expensive to elaborate -- `E3` is
`EuclideanSpace`, and integrating it out of a nested product exceeds the default heartbeat budget --
so it carries the same `set_option maxHeartbeats 2000000` the file already uses in four earlier
places. Second, and more important, the lemmas built on top of it must **not** mention `cfgPair`
while they are being elaborated: stating them for an arbitrary pairing `P : ℝ → ℝ → ℂ` keeps every
space involved a copy of `ℝ`, whereas instantiating first makes the unifier unfold an integral over
`E3` and diverge -- 2000000 heartbeats are not enough, which is the sign that the problem is
unification and not arithmetic. -/

set_option maxHeartbeats 2000000 in
-- The extended analytic estimates below require additional elaboration steps.
open MeasureTheory in
/-- **The pairing is jointly measurable in its two parameters.** -/
theorem measurable_cfgPair_prod {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ)) :
    Measurable fun p : ℝ × ℝ => cfgPair g γ p.1 p.2 := by
  have hjoint : Continuous fun q : E3 × ℝ => cfgProd g γ q.1 q.2 :=
    continuous_uncurry_cfgProd hgc γ
  have hc : StronglyMeasurable fun q : (ℝ × ℝ) × E3 =>
      cfgProd g γ q.2 q.1.1 * (starRingEnd ℂ) (cfgProd g γ q.2 q.1.2) :=
    Continuous.stronglyMeasurable
      ((hjoint.comp (continuous_snd.prodMk (continuous_fst.comp continuous_fst))).mul
        (Complex.continuous_conj.comp
          (hjoint.comp (continuous_snd.prodMk (continuous_snd.comp continuous_fst)))))
  simp only [cfgPair]
  exact (hc.integral_prod_right' (ν := volume)).measurable

open MeasureTheory in
/-- The capped integral of an abstract pairing is measurable in the shift. -/
theorem measurable_capPairOf {P : ℝ → ℝ → ℂ} (hP : Measurable fun p : ℝ × ℝ => P p.1 p.2)
    (c N : ℝ) : Measurable fun h : ℝ => ∫ t in capSet c N h, P (t + h) t := by
  have hu : Measurable fun h : ℝ => capLeft c h := by
    simp only [capLeft]
    exact (continuous_const.add (continuous_const.max continuous_neg)).measurable
  have hv : Measurable fun h : ℝ => capRight c N h := by
    simp only [capRight]
    exact (continuous_const.sub (continuous_const.max continuous_id')).measurable
  have hjm : Measurable fun p : ℝ × ℝ => P (p.2 + p.1) p.2 :=
    hP.comp ((measurable_snd.add measurable_fst).prodMk measurable_snd)
  simp only [capSet_eq_Ioc]
  exact measurable_varSetIntegral hjm hu hv

open MeasureTheory in
/-- The interval integral of an abstract pairing is jointly measurable in the two shifts. -/
theorem stronglyMeasurable_pairIntegralOf {P : ℝ → ℝ → ℂ}
    (hP : Measurable fun p : ℝ × ℝ => P p.1 p.2) (c N : ℝ) :
    StronglyMeasurable fun p : ℝ × ℝ => ∫ t in Set.Ioc c (c + N), P (t + p.1) (t + p.2) := by
  have hjm : Measurable fun q : (ℝ × ℝ) × ℝ => P (q.2 + q.1.1) (q.2 + q.1.2) :=
    hP.comp ((measurable_snd.add (measurable_fst.comp measurable_fst)).prodMk
      (measurable_snd.add (measurable_snd.comp measurable_fst)))
  exact hjm.stronglyMeasurable.integral_prod_right'
    (ν := (volume : Measure ℝ).restrict (Set.Ioc c (c + N)))

open MeasureTheory in
/-- The capped pairing is measurable in the shift. -/
theorem measurable_cfgCapPair {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ)) (c N : ℝ) :
    Measurable fun h : ℝ => cfgCapPair g γ c N h :=
  measurable_capPairOf (measurable_cfgPair_prod hgc γ) c N

open MeasureTheory in
/-- The paired integral over the interval is jointly measurable in the two shifts. -/
theorem stronglyMeasurable_cfgPairIntegral {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ)) (c N : ℝ) :
    StronglyMeasurable fun p : ℝ × ℝ =>
      ∫ t in Set.Ioc c (c + N), cfgPair g γ (t + p.1) (t + p.2) :=
  stronglyMeasurable_pairIntegralOf (measurable_cfgPair_prod hgc γ) c N

open MeasureTheory in
/-- The capped pairing, as a function of the two shifts through their difference. -/
theorem measurable_cfgCapPair_sub {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ)) (c N : ℝ) :
    Measurable fun p : ℝ × ℝ => cfgCapPair g γ c N (p.1 - p.2) :=
  (measurable_cfgCapPair hgc γ c N).comp (measurable_fst.sub measurable_snd)

open MeasureTheory in
/-- The paired integral over the interval is bounded by the volume of the box times its length. -/
theorem norm_cfgPairIntegral_le {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    {γ : ι → (Fin 3 → Polynomial ℝ)} {M : ℝ}
    (hMb : ∀ u v : ℝ, ‖cfgPair g γ u v‖ ≤ M) {N : ℝ} (hN : 0 ≤ N) (c a b : ℝ) :
    ‖∫ t in c..(c + N), cfgPair g γ (t + a) (t + b)‖ ≤ M * N := by
  have hb := intervalIntegral.norm_integral_le_of_norm_le_const
    (C := M) (a := c) (b := c + N)
    (f := fun t : ℝ => cfgPair g γ (t + a) (t + b))
    fun t _ => hMb (t + a) (t + b)
  have habs : |c + N - c| = N := by
    rw [show c + N - c = N from by ring, abs_of_nonneg hN]
  rwa [habs] at hb




/-! ## Blueprint `lem:pet-reduction`: the comparison over the square of shifts

Integrating `Auto.norm_cfgPairIntegral_sub_cfgCapPair_le` over `[0,H]^2`, on the model of the
scalar `Auto.norm_double_pair_sub_cap_le`. As in the previous section, every measurability lemma
is stated for an abstract pairing first and instantiated only at the end: composing a statement
that already mentions `Auto.cfgPair` makes the unifier unfold an integral over `E3`. -/

open MeasureTheory in
/-- The interval integral of an abstract pairing, measurable in the second shift. -/
theorem measurable_pairIntegralOf_snd {P : ℝ → ℝ → ℂ}
    (hP : Measurable fun p : ℝ × ℝ => P p.1 p.2) (c N a : ℝ) :
    Measurable fun b : ℝ => ∫ t in Set.Ioc c (c + N), P (t + a) (t + b) :=
  ((stronglyMeasurable_pairIntegralOf hP c N).measurable).comp
    (measurable_const.prodMk measurable_id)

open MeasureTheory in
/-- The double integral of an abstract pairing, measurable in the first shift. -/
theorem measurable_pairDoubleOf {P : ℝ → ℝ → ℂ}
    (hP : Measurable fun p : ℝ × ℝ => P p.1 p.2) (c N H : ℝ) :
    Measurable fun a : ℝ =>
      ∫ b in Set.Ioc (0 : ℝ) H, ∫ t in Set.Ioc c (c + N), P (t + a) (t + b) :=
  ((stronglyMeasurable_pairIntegralOf hP c N).integral_prod_right'
    (ν := (volume : Measure ℝ).restrict (Set.Ioc (0 : ℝ) H))).measurable

open MeasureTheory in
/-- The average of a measurable function of the difference of two shifts. -/
theorem measurable_capDoubleOf {Q : ℝ → ℂ} (hQ : Measurable Q) (H : ℝ) :
    Measurable fun a : ℝ => ∫ b in Set.Ioc (0 : ℝ) H, Q (a - b) :=
  (((hQ.comp (measurable_fst.sub measurable_snd)).stronglyMeasurable).integral_prod_right'
    (ν := (volume : Measure ℝ).restrict (Set.Ioc (0 : ℝ) H))).measurable

open MeasureTheory in
/-- The interval integral of the pairing is measurable in the second shift. -/
theorem measurable_cfgPairIntegral_snd {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ)) {N : ℝ} (hN : 0 ≤ N)
    (c a : ℝ) :
    Measurable fun b : ℝ => ∫ t in c..(c + N), cfgPair g γ (t + a) (t + b) := by
  have hcongr : (fun b : ℝ => ∫ t in c..(c + N), cfgPair g γ (t + a) (t + b))
      = fun b : ℝ => ∫ t in Set.Ioc c (c + N), cfgPair g γ (t + a) (t + b) := by
    funext b
    exact intervalIntegral.integral_of_le (by linarith)
  rw [hcongr]
  exact measurable_pairIntegralOf_snd (measurable_cfgPair_prod hgc γ) c N a

open MeasureTheory in
/-- The double integral of the pairing is measurable in the first shift. -/
theorem measurable_cfgPairDouble {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ)) {N H : ℝ} (hN : 0 ≤ N)
    (hH : 0 ≤ H) (c : ℝ) :
    Measurable fun a : ℝ =>
      ∫ b in (0 : ℝ)..H, ∫ t in c..(c + N), cfgPair g γ (t + a) (t + b) := by
  have hcongr : (fun a : ℝ => ∫ b in (0 : ℝ)..H, ∫ t in c..(c + N),
        cfgPair g γ (t + a) (t + b))
      = fun a : ℝ => ∫ b in Set.Ioc (0 : ℝ) H, ∫ t in Set.Ioc c (c + N),
        cfgPair g γ (t + a) (t + b) := by
    funext a
    rw [intervalIntegral.integral_of_le hH]
    refine setIntegral_congr_fun measurableSet_Ioc fun b _ => ?_
    exact intervalIntegral.integral_of_le (by linarith)
  rw [hcongr]
  exact measurable_pairDoubleOf (measurable_cfgPair_prod hgc γ) c N H

open MeasureTheory in
/-- The double integral of the capped pairing is measurable in the first shift. -/
theorem measurable_cfgCapDouble {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) (γ : ι → (Fin 3 → Polynomial ℝ)) {H : ℝ} (hH : 0 ≤ H)
    (c N : ℝ) :
    Measurable fun a : ℝ => ∫ b in (0 : ℝ)..H, cfgCapPair g γ c N (a - b) := by
  have hcongr : (fun a : ℝ => ∫ b in (0 : ℝ)..H, cfgCapPair g γ c N (a - b))
      = fun a : ℝ => ∫ b in Set.Ioc (0 : ℝ) H, cfgCapPair g γ c N (a - b) := by
    funext a
    exact intervalIntegral.integral_of_le hH
  rw [hcongr]
  exact measurable_capDoubleOf (measurable_cfgCapPair hgc γ c N) H

open MeasureTheory in
/-- **The total cost of the change of shift variables**, over the square of shifts. -/
theorem norm_double_cfgPair_sub_cap_le {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) {γ : ι → (Fin 3 → Polynomial ℝ)} {M : ℝ} (hM0 : 0 ≤ M)
    (hMb : ∀ u v : ℝ, ‖cfgPair g γ u v‖ ≤ M)
    {N H : ℝ} (hN : 0 ≤ N) (hH : 0 ≤ H) (hHN : H ≤ N) (c : ℝ) :
    ‖(∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H, ∫ t in c..(c + N), cfgPair g γ (t + a) (t + b))
        - ∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H, cfgCapPair g γ c N (a - b)‖
      ≤ M * (2 * H) * H * H := by
  have hCb : ∀ a : ℝ, Measurable fun b : ℝ => cfgCapPair g γ c N (a - b) := fun a =>
    (measurable_cfgCapPair hgc γ c N).comp (measurable_const.sub measurable_id)
  have hCi : ∀ a : ℝ, IntervalIntegrable (fun b : ℝ => cfgCapPair g γ c N (a - b)) volume 0 H :=
    fun a => intervalIntegrable_of_bdd' (hCb a)
      (fun b => norm_cfgCapPair_le hM0 hMb hN c (a - b)) 0 H
  have hinner : ∀ a ∈ Set.Icc (0 : ℝ) H,
      ‖(∫ b in (0 : ℝ)..H, ∫ t in c..(c + N), cfgPair g γ (t + a) (t + b))
          - ∫ b in (0 : ℝ)..H, cfgCapPair g γ c N (a - b)‖ ≤ M * (2 * H) * H := by
    intro a ha
    have hPi := intervalIntegrable_of_bdd' (measurable_cfgPairIntegral_snd hgc γ hN c a)
      (fun b => norm_cfgPairIntegral_le hMb hN c a b) (0 : ℝ) H
    rw [← intervalIntegral.integral_sub hPi (hCi a)]
    have hb := intervalIntegral.norm_integral_le_of_norm_le_const (C := M * (2 * H))
      (a := (0 : ℝ)) (b := H)
      (f := fun b => (∫ t in c..(c + N), cfgPair g γ (t + a) (t + b))
          - cfgCapPair g γ c N (a - b))
      fun b hbm => by
        rw [Set.uIoc_of_le hH] at hbm
        exact norm_cfgPairIntegral_sub_cfgCapPair_le hgc hM0 hMb hHN ha
          ⟨hbm.1.le, hbm.2⟩ c
    simpa [abs_of_nonneg hH] using hb
  have hPa : IntervalIntegrable (fun a : ℝ => ∫ b in (0 : ℝ)..H,
      ∫ t in c..(c + N), cfgPair g γ (t + a) (t + b)) volume 0 H := by
    refine intervalIntegrable_of_bdd' (measurable_cfgPairDouble hgc γ hN hH c)
      (M := M * N * H) (fun a => ?_) 0 H
    have hb := intervalIntegral.norm_integral_le_of_norm_le_const (C := M * N)
      (a := (0 : ℝ)) (b := H)
      (f := fun b => ∫ t in c..(c + N), cfgPair g γ (t + a) (t + b))
      fun b _ => norm_cfgPairIntegral_le hMb hN c a b
    simpa [abs_of_nonneg hH] using hb
  have hCa : IntervalIntegrable (fun a : ℝ => ∫ b in (0 : ℝ)..H, cfgCapPair g γ c N (a - b))
      volume 0 H := by
    refine intervalIntegrable_of_bdd' (measurable_cfgCapDouble hgc γ hH c N)
      (M := M * N * H) (fun a => ?_) 0 H
    have hb := intervalIntegral.norm_integral_le_of_norm_le_const (C := M * N)
      (a := (0 : ℝ)) (b := H)
      (f := fun b => cfgCapPair g γ c N (a - b))
      fun b _ => norm_cfgCapPair_le hM0 hMb hN c (a - b)
    simpa [abs_of_nonneg hH] using hb
  rw [← intervalIntegral.integral_sub hPa hCa]
  have hb := intervalIntegral.norm_integral_le_of_norm_le_const (C := M * (2 * H) * H)
    (a := (0 : ℝ)) (b := H)
    (f := fun a => (∫ b in (0 : ℝ)..H, ∫ t in c..(c + N), cfgPair g γ (t + a) (t + b))
      - ∫ b in (0 : ℝ)..H, cfgCapPair g γ c N (a - b))
    fun a ham => by
      rw [Set.uIoc_of_le hH] at ham
      exact hinner a ⟨ham.1.le, ham.2⟩
  simpa [abs_of_nonneg hH] using hb



/-! ## Blueprint `lem:pet-reduction`: putting the interval variable innermost

`Auto.cfgL2_le_innerSq` leaves the interval variable outermost and the two shifts inside;
`Auto.norm_double_cfgPair_sub_cap_le` wants the opposite order. The exchange is two applications of
Fubini on bounded intervals, stated -- as everywhere in this part -- for an abstract pairing, so
that no integral over `E3` is ever exposed to the unifier. The scalar
`Auto.integral_swap_triple_interval` cannot be reused: its proof factors the inner integral using
the special form `F(t+a) conj(F(t+b))`, which a general pairing does not have. -/

open MeasureTheory in
/-- **Exchanging the interval variable with the two shifts**, for an abstract bounded pairing. -/
theorem integral_swap_triple_pairOf {P : ℝ → ℝ → ℂ}
    (hP : Measurable fun p : ℝ × ℝ => P p.1 p.2) {M : ℝ} (hM : ∀ u v, ‖P u v‖ ≤ M)
    {N H : ℝ} (hN : 0 ≤ N) (hH : 0 ≤ H) (c : ℝ) :
    (∫ t in c..(c + N), ∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H, P (t + a) (t + b))
      = ∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H, ∫ t in c..(c + N), P (t + a) (t + b) := by
  have hM0 : (0 : ℝ) ≤ M := le_trans (norm_nonneg _) (hM 0 0)
  have : IsFiniteMeasure (volume.restrict (Set.Ioc c (c + N))) := by
    refine ⟨?_⟩
    rw [Measure.restrict_apply_univ, Real.volume_Ioc]
    exact ENNReal.ofReal_lt_top
  have : IsFiniteMeasure (volume.restrict (Set.Ioc (0 : ℝ) H)) := by
    refine ⟨?_⟩
    rw [Measure.restrict_apply_univ, Real.volume_Ioc]
    exact ENNReal.ofReal_lt_top
  have hHvol : (volume (Set.Ioc (0 : ℝ) H)).toReal = H := by
    rw [Real.volume_Ioc, sub_zero, ENNReal.toReal_ofReal hH]
  -- the inner integral in the second shift
  have hPb : ∀ u : ℝ, Measurable fun q : ℝ × ℝ => P (q.1 + u) (q.1 + q.2) := fun u =>
    hP.comp ((measurable_fst.add_const u).prodMk (measurable_fst.add measurable_snd))
  have hbnd : ∀ t a : ℝ, ‖∫ b in Set.Ioc (0 : ℝ) H, P (t + a) (t + b)‖ ≤ M * H := by
    intro t a
    have hfin : volume (Set.Ioc (0 : ℝ) H) < ⊤ := by
      rw [Real.volume_Ioc]; exact ENNReal.ofReal_lt_top
    have hb := norm_setIntegral_le_of_norm_le_const (C := M) (μ := volume)
      (s := Set.Ioc (0 : ℝ) H) (f := fun b : ℝ => P (t + a) (t + b)) hfin
      fun b _ => hM _ _
    rwa [measureReal_def, hHvol] at hb
  -- convert every interval integral to a set integral
  simp only [intervalIntegral.integral_of_le hH, intervalIntegral.integral_of_le
    (show c ≤ c + N from by linarith)]
  -- second exchange, at a fixed first shift
  have hswapb : ∀ a : ℝ,
      (∫ t in Set.Ioc c (c + N), ∫ b in Set.Ioc (0 : ℝ) H, P (t + a) (t + b))
        = ∫ b in Set.Ioc (0 : ℝ) H, ∫ t in Set.Ioc c (c + N), P (t + a) (t + b) := by
    intro a
    refine integral_integral_swap ?_
    refine Integrable.mono' (integrable_const M) (hPb a).aestronglyMeasurable
      (Filter.Eventually.of_forall fun q => ?_)
    obtain ⟨t, b⟩ := q
    exact hM _ _
  -- first exchange
  have hswapa :
      (∫ t in Set.Ioc c (c + N), ∫ a in Set.Ioc (0 : ℝ) H,
          ∫ b in Set.Ioc (0 : ℝ) H, P (t + a) (t + b))
        = ∫ a in Set.Ioc (0 : ℝ) H, ∫ t in Set.Ioc c (c + N),
          ∫ b in Set.Ioc (0 : ℝ) H, P (t + a) (t + b) := by
    refine integral_integral_swap ?_
    refine Integrable.mono' (integrable_const (M * H)) ?_
      (Filter.Eventually.of_forall fun q => ?_)
    · have hq : Measurable fun r : (ℝ × ℝ) × ℝ => P (r.1.1 + r.1.2) (r.1.1 + r.2) :=
        hP.comp (((measurable_fst.comp measurable_fst).add
          (measurable_snd.comp measurable_fst)).prodMk
            ((measurable_fst.comp measurable_fst).add measurable_snd))
      exact (hq.stronglyMeasurable.integral_prod_right'
        (ν := (volume : Measure ℝ).restrict (Set.Ioc (0 : ℝ) H))).aestronglyMeasurable
    · obtain ⟨t, a⟩ := q
      exact hbnd t a
  rw [hswapa]
  refine integral_congr_ae (Filter.Eventually.of_forall fun a => ?_)
  exact hswapb a

open MeasureTheory in
/-- **The mean square of the inner averages, expanded.** Combining
`Auto.ofReal_integral_sq_norm_innerAvg` pointwise in the interval variable with the exchange above
puts the interval variable innermost, where `Auto.norm_double_cfgPair_sub_cap_le` acts on it. -/
theorem ofReal_integral_innerSq_eq {ι : Type*} [Fintype ι] {L : ℝ} {B : Set E3}
    (hBfin : volume B ≠ ⊤)
    {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a)) (hg1 : ∀ a x, ‖g a x‖ ≤ 1)
    {γ : ι → (Fin 3 → Polynomial ℝ)} (hs : CfgSupportedOn L B g γ)
    {M : ℝ} (hMb : ∀ u v : ℝ, ‖cfgPair g γ u v‖ ≤ M) {N H : ℝ} (hN : 0 ≤ N)
    (hH : 0 ≤ H) (c : ℝ)
    (hTt : ∀ t ∈ Set.uIcc c (c + N), ∀ a ∈ Set.Ioc (0 : ℝ) H, |t + a| ≤ L) :
    ((∫ t in c..(c + N), innerSq B g γ H t : ℝ) : ℂ)
      = ∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H, ∫ t in c..(c + N),
        cfgPair g γ (t + a) (t + b) := by
  rw [← integral_swap_triple_pairOf (measurable_cfgPair_prod hgc γ) hMb hN hH c,
    ← intervalIntegral.integral_ofReal]
  refine intervalIntegral.integral_congr fun t ht => ?_
  have hTa : ∀ a ∈ Set.Ioc (0 : ℝ) H, |t + a| ≤ L := hTt t ht
  have h1 : innerSq B g γ H t
      = ∫ x in B, ‖∫ a in Set.Ioc (0 : ℝ) H, cfgProd g γ x (t + a)‖ ^ 2 := by
    rw [innerSq]
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    change ‖∫ a in (0 : ℝ)..H, cfgProd g γ x (t + a)‖ ^ 2
        = ‖∫ a in Set.Ioc (0 : ℝ) H, cfgProd g γ x (t + a)‖ ^ 2
    rw [intervalIntegral.integral_of_le hH]
  have h2 : innerSq B g γ H t
      = ∫ x : E3, ‖∫ a in Set.Ioc (0 : ℝ) H, cfgProd g γ x (t + a)‖ ^ 2 := by
    rw [h1, ← integral_sq_norm_eq_setIntegral_of_cfgSupportedOn hs measurableSet_Ioc t hTa]
  rw [h2, ofReal_integral_sq_norm_innerAvg hBfin hgc hg1 hs t hTa,
    intervalIntegral.integral_of_le hH]
  refine setIntegral_congr_fun measurableSet_Ioc fun a _ => ?_
  rw [intervalIntegral.integral_of_le hH]



/-! ## Blueprint `lem:pet-reduction`: the corrected van der Corput inequality

The three links now compose. `Auto.cfgL2_le_innerSq` bounds the `L^2` functional by the mean square
of the inner averages; `Auto.ofReal_integral_innerSq_eq` turns that into a double shift integral of
`Auto.cfgPair` with the interval variable innermost; `Auto.norm_double_cfgPair_sub_cap_le` replaces
it by the capped pairing at the difference of the shifts; and `Auto.integral_double_sub_eq_fejer`,
reused verbatim, turns the double shift integral into `H^2` times a Fejer average.

The result is the inequality the corrected descent needs: a bound on `Auto.cfgL2` by the Fejer
average of `‖cfgCapPair‖` -- a modulus of a *scalar* function of the shift, taken outside the
integral in the point. -/

open MeasureTheory in
/-- The double shift integral of the capped pairing is a Fejer average. -/
theorem integral_double_cfgCapPair_eq_fejer {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) {γ : ι → (Fin 3 → Polynomial ℝ)} {M : ℝ} (hM0 : 0 ≤ M)
    (hMb : ∀ u v : ℝ, ‖cfgPair g γ u v‖ ≤ M)
    {N H : ℝ} (hN : 0 ≤ N) (hH : 0 < H) (c : ℝ) :
    (∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H, cfgCapPair g γ c N (a - b))
      = (H ^ 2 : ℝ) • ∫ h : ℝ, fejer H h • cfgCapPair g γ c N h :=
  integral_double_sub_eq_fejer hH (measurable_cfgCapPair hgc γ c N)
    (M := M * N) fun y => norm_cfgCapPair_le hM0 hMb hN c y

open MeasureTheory in
/-- The Fejer average of the capped pairing, bounded by the average of its modulus. -/
theorem norm_integral_fejer_cfgCapPair_le {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    {γ : ι → (Fin 3 → Polynomial ℝ)} {H : ℝ} (hH : 0 < H) (c N : ℝ) :
    ‖∫ h : ℝ, fejer H h • cfgCapPair g γ c N h‖
      ≤ ∫ h : ℝ, fejer H h * ‖cfgCapPair g γ c N h‖ := by
  refine le_trans (norm_integral_le_integral_norm _) (le_of_eq ?_)
  refine integral_congr_ae (Filter.Eventually.of_forall fun h => ?_)
  simp only [norm_smul, Real.norm_eq_abs, abs_of_nonneg (fejer_nonneg hH h)]

open MeasureTheory in
/-- **The corrected van der Corput inequality for the `L^2` functional.** The modulus is taken on
`Auto.cfgCapPair`, a scalar function of the shift, *outside* the integral in the point -- which is
what makes the normalization `Auto.cfgInt_translSub` available at the next step. -/
theorem cfgL2_le_fejer_cfgCapPair {ι : Type*} [Fintype ι] {L : ℝ} {B : Set E3}
    (hBfin : volume B ≠ ⊤) {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a))
    (hg1 : ∀ a x, ‖g a x‖ ≤ 1) {γ : ι → (Fin 3 → Polynomial ℝ)} (hs : CfgSupportedOn L B g γ)
    {M : ℝ} (hM0 : 0 ≤ M) (hMb : ∀ u v : ℝ, ‖cfgPair g γ u v‖ ≤ M)
    {N H : ℝ} (hN : 0 < N) (hH : 0 < H) (hHN : H ≤ N) (hL : 2 * N ≤ L) :
    cfgL2 N B g γ
      ≤ 2 * N⁻¹ * (∫ h : ℝ, fejer H h * ‖cfgCapPair g γ 0 N h‖)
        + 4 * M * (H / N)
        + 8 * (H / N) ^ 2 * (volume B).toReal := by
  have hTt : ∀ t ∈ Set.uIcc (0 : ℝ) ((0 : ℝ) + N), ∀ a ∈ Set.Ioc (0 : ℝ) H, |t + a| ≤ L := by
    intro t ht a ha
    rw [Set.uIcc_of_le (by linarith : (0 : ℝ) ≤ (0 : ℝ) + N)] at ht
    rw [abs_of_nonneg (by linarith [ht.1, ha.1] : (0 : ℝ) ≤ t + a)]
    linarith [ht.2, ha.2]
  set K := ∫ h : ℝ, fejer H h * ‖cfgCapPair g γ 0 N h‖ with hKdef
  have hK0 : 0 ≤ K :=
    integral_nonneg fun h => mul_nonneg (fejer_nonneg hH h) (norm_nonneg _)
  -- the mean square of the inner averages, as a double shift integral
  have hzero : (0 : ℝ) + N = N := by ring
  have hEq := ofReal_integral_innerSq_eq hBfin hgc hg1 hs hMb hN.le hH.le (0 : ℝ) hTt
  have hCmp := norm_double_cfgPair_sub_cap_le hgc hM0 hMb hN.le hH.le hHN (0 : ℝ)
  have hFej := integral_double_cfgCapPair_eq_fejer hgc hM0 hMb hN.le hH (0 : ℝ)
  -- the modulus of the double shift integral of the pairing
  have hDb : ‖(∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H, ∫ t in (0 : ℝ)..((0 : ℝ) + N),
        cfgPair g γ (t + a) (t + b))‖ ≤ H ^ 2 * K + M * (2 * H) * H * H := by
    have hy : ‖∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H, cfgCapPair g γ 0 N (a - b)‖
        ≤ H ^ 2 * K := by
      rw [hFej, norm_smul, Real.norm_eq_abs, abs_of_nonneg (by positivity : (0 : ℝ) ≤ H ^ 2)]
      exact mul_le_mul_of_nonneg_left
        (norm_integral_fejer_cfgCapPair_le (g := g) (γ := γ) hH 0 N) (by positivity)
    exact norm_le_of_norm_sub_le hCmp hy
  -- transfer to the real mean square
  have hInner : |∫ t in (0 : ℝ)..((0 : ℝ) + N), innerSq B g γ H t|
      ≤ H ^ 2 * K + M * (2 * H) * H * H := by
    have hnorm : |∫ t in (0 : ℝ)..((0 : ℝ) + N), innerSq B g γ H t|
        = ‖((∫ t in (0 : ℝ)..((0 : ℝ) + N), innerSq B g γ H t : ℝ) : ℂ)‖ := by
      rw [Complex.norm_real, Real.norm_eq_abs]
    rw [hnorm, hEq]
    exact hDb
  have hInner' : (∫ t in (0 : ℝ)..N, innerSq B g γ H t)
      ≤ H ^ 2 * K + M * (2 * H) * H * H := by
    rw [hzero] at hInner
    exact le_trans (le_abs_self _) hInner
  -- feed it into the van der Corput step
  have hstep := cfgL2_le_innerSq hN hH hBfin hgc hg1 γ
  have hcoef : (0 : ℝ) ≤ 2 * N⁻¹ * H⁻¹ ^ 2 := by positivity
  have hmul := mul_le_mul_of_nonneg_left hInner' hcoef
  have hHne : H ≠ 0 := hH.ne'
  have hNne : N ≠ 0 := hN.ne'
  have hexp : 2 * N⁻¹ * H⁻¹ ^ 2 * (H ^ 2 * K + M * (2 * H) * H * H)
      = 2 * N⁻¹ * K + 4 * M * (H / N) := by
    field_simp
    ring
  rw [hexp] at hmul
  linarith [hstep, hmul]



/-! ## Blueprint `lem:pet-reduction`: the corrected descent step

Pigeonholing the shift against the Fejer kernel and undoing the capping. The result is a lower
bound on `‖cfgInt‖` of the *differenced* family -- the headless functional, whose integral in the
point runs over all of `E3`, so that `Auto.cfgInt_translSub` can normalize it. This is the step the
superseded route could not reach. -/

open MeasureTheory in
/-- **Pigeonholing inside the support of the kernel.** The Fejer kernel vanishes off `[-H, H]`, so
the shift it produces may be taken there. -/
theorem exists_of_fejer_average_ge' {H β : ℝ} (hH : 0 < H) (hβ : 0 < β) {g : ℝ → ℝ}
    (hgm : Measurable g) {M : ℝ} (hgM : ∀ h, |g h| ≤ M)
    (hge : β ≤ ∫ h : ℝ, fejer H h * g h) : ∃ h : ℝ, |h| ≤ H ∧ β / 2 ≤ g h := by
  by_contra hcon
  simp only [not_exists, not_and, not_le] at hcon
  have hle : (∫ h : ℝ, fejer H h * g h) ≤ ∫ h : ℝ, fejer H h * (β / 2) := by
    refine integral_mono (integrable_fejer_mul hH hgm hgM)
      ((integrable_fejer hH).mul_const _) fun h => ?_
    by_cases hh : |h| ≤ H
    · exact mul_le_mul_of_nonneg_left (le_of_lt (hcon h hh)) (fejer_nonneg hH h)
    · push Not at hh
      rw [fejer_eq_zero_of_le hH hh.le, zero_mul, zero_mul]
  rw [integral_mul_const, integral_fejer hH, one_mul] at hle
  linarith

open MeasureTheory in
/-- The paired integral along a single shift is bounded by the volume of the box times the length
of the interval. -/
theorem norm_cfgPairShiftIntegral_le {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    {γ : ι → (Fin 3 → Polynomial ℝ)} {M : ℝ}
    (hMb : ∀ u v : ℝ, ‖cfgPair g γ u v‖ ≤ M) {N : ℝ} (hN : 0 ≤ N) (c h : ℝ) :
    ‖∫ t in c..(c + N), cfgPair g γ (t + h) t‖ ≤ M * N := by
  have hb := intervalIntegral.norm_integral_le_of_norm_le_const
    (C := M) (a := c) (b := c + N)
    (f := fun t : ℝ => cfgPair g γ (t + h) t)
    fun t _ => hMb (t + h) t
  have habs : |c + N - c| = N := by
    rw [show c + N - c = N from by ring, abs_of_nonneg hN]
  rwa [habs] at hb

open MeasureTheory in
/-- **Undoing the capping.** Replacing the intersection of the interval with its translate by the
interval itself costs the volume of the box times the shift. -/
theorem norm_cfgPairShiftIntegral_sub_cfgCapPair_le {ι : Type*} [Fintype ι] {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) {γ : ι → (Fin 3 → Polynomial ℝ)} {M : ℝ} (hM0 : 0 ≤ M)
    (hMb : ∀ u v : ℝ, ‖cfgPair g γ u v‖ ≤ M)
    {N : ℝ} (hN : 0 ≤ N) (c h : ℝ) :
    ‖(∫ t in c..(c + N), cfgPair g γ (t + h) t) - cfgCapPair g γ c N h‖
      ≤ M * |h| := by
  have hgm := measurable_cfgPairShift hgc γ h
  have hgb : ∀ s : ℝ, ‖cfgPair g γ (s + h) s‖ ≤ M := fun s => hMb (s + h) s
  have hgi : ∀ p q : ℝ,
      IntervalIntegrable (fun s => cfgPair g γ (s + h) s) volume p q :=
    fun p q => intervalIntegrable_of_bdd' hgm hgb p q
  rcases le_or_gt |h| N with hcase | hcase
  · rw [cfgCapPair_eq_intervalIntegral g γ hcase c]
    refine le_trans (norm_integral_sub_integral_le' hgi hgb c (c + N)
      (capLeft c h) (capRight c N h)) ?_
    rw [capLeft, capRight]
    have e1 : |c - (c + max 0 (-h))| = max 0 (-h) := by
      rw [show c - (c + max 0 (-h)) = -max 0 (-h) by ring, abs_neg,
        abs_of_nonneg (le_max_left _ _)]
    have e2 : |c + N - (c + N - max 0 h)| = max 0 h := by
      rw [show c + N - (c + N - max 0 h) = max 0 h by ring, abs_of_nonneg (le_max_left _ _)]
    rw [e1, e2, add_comm, max_zero_add_max_zero_neg h]
  · have hlt : capRight c N h < capLeft c h := by
      rw [capLeft, capRight]
      have hsum := max_zero_add_max_zero_neg h
      linarith
    have hempty : cfgCapPair g γ c N h = 0 := by
      rw [cfgCapPair, capSet_eq_Ioc, Set.Ioc_eq_empty (not_lt.mpr hlt.le), setIntegral_empty]
    rw [hempty, sub_zero]
    exact le_trans (norm_cfgPairShiftIntegral_le hMb hN c h)
      (mul_le_mul_of_nonneg_left hcase.le hM0)

open MeasureTheory in
/-- **The corrected descent step.** A lower bound on the `L^2` functional, with the boundary error
absorbed, yields a shift within the kernel's support at which the headless functional of the
differenced family is bounded below. Unlike the superseded
`Auto.exists_shift_cfgHeadInt_ge`, the conclusion is about `Auto.cfgInt`, on which
`Auto.cfgInt_translSub` acts. -/
theorem exists_shift_cfgInt_ge {ι : Type*} [Fintype ι] {L : ℝ} {B : Set E3}
    (hBfin : volume B ≠ ⊤)
    {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a)) (hg1 : ∀ a x, ‖g a x‖ ≤ 1)
    {γ : ι → (Fin 3 → Polynomial ℝ)} (hs : CfgSupportedOn L B g γ)
    {M : ℝ} (hM0 : 0 ≤ M) (hMb : ∀ u v : ℝ, ‖cfgPair g γ u v‖ ≤ M)
    {N H : ℝ} (hN : 0 < N) (hH : 0 < H) (hHN : H ≤ N) (hL : 2 * N ≤ L) {β : ℝ} (hβ : 0 < β)
    (hlow : β ≤ cfgL2 N B g γ)
    (hsmall : 4 * M * (H / N) + 8 * (H / N) ^ 2 * (volume B).toReal ≤ β / 2) :
    ∃ h : ℝ, |h| ≤ H ∧
      (β * N / 8 - M * H) / N
        ≤ ‖cfgInt N (dcfgFun g) (dcfgTransl γ h)‖ := by
  have hvdc := cfgL2_le_fejer_cfgCapPair hBfin hgc hg1 hs hM0 hMb hN hH hHN hL
  set K := ∫ h : ℝ, fejer H h * ‖cfgCapPair g γ 0 N h‖ with hKdef
  have hK : β * N / 4 ≤ K := by
    have h2 : β / 2 ≤ 2 * N⁻¹ * K := by linarith
    have hNpos : (0 : ℝ) < N := hN
    rw [show (2 : ℝ) * N⁻¹ * K = 2 * K / N from by field_simp] at h2
    rw [le_div_iff₀ hNpos] at h2
    linarith
  -- pigeonhole the shift inside the support of the kernel
  have hmeas : Measurable fun h : ℝ => ‖cfgCapPair g γ 0 N h‖ :=
    (measurable_cfgCapPair hgc γ 0 N).norm
  have hbd : ∀ h : ℝ, |‖cfgCapPair g γ 0 N h‖| ≤ M * N := by
    intro h
    rw [abs_of_nonneg (norm_nonneg _)]
    exact norm_cfgCapPair_le hM0 hMb hN.le 0 h
  obtain ⟨h, hhH, hhge⟩ := exists_of_fejer_average_ge' hH
    (by positivity : (0 : ℝ) < β * N / 4) hmeas hbd hK
  refine ⟨h, hhH, ?_⟩
  -- undo the capping
  have hcmp := norm_cfgPairShiftIntegral_sub_cfgCapPair_le hgc hM0 hMb hN.le 0 h
  rw [zero_add] at hcmp
  have hMh : M * |h| ≤ M * H := mul_le_mul_of_nonneg_left hhH hM0
  have h1 : ‖cfgCapPair g γ 0 N h‖ - ‖∫ t in (0 : ℝ)..N, cfgPair g γ (t + h) t‖
      ≤ ‖(∫ t in (0 : ℝ)..N, cfgPair g γ (t + h) t) - cfgCapPair g γ 0 N h‖ := by
    have hnn := norm_sub_norm_le (cfgCapPair g γ 0 N h)
      (∫ t in (0 : ℝ)..N, cfgPair g γ (t + h) t)
    rwa [norm_sub_rev] at hnn
  have hlower : β * N / 8 - M * H
      ≤ ‖∫ t in (0 : ℝ)..N, cfgPair g γ (t + h) t‖ := by
    linarith [hhge, hcmp, hMh, h1]
  -- read it as the headless functional of the differenced family
  rw [cfgInt_dcfg_eq_pair, norm_smul, Real.norm_eq_abs,
    abs_of_nonneg (le_of_lt (inv_pos.mpr hN)), div_eq_inv_mul]
  exact mul_le_mul_of_nonneg_left hlower (le_of_lt (inv_pos.mpr hN))



/-! ## Blueprint `lem:pet-reduction`: normalizing, and recognizing `Auto.petStep`

Two facts complete the transition described by the blueprint's step.

First, once the family has been normalized by the selected translation, the members whose
translation has become constant can be read off as a head: `Auto.cfgInt` becomes
`Auto.cfgHeadInt` of the reduced family, with `Auto.constFactor` as the head. This is the
`Auto.cfgInt_cons` identification applied to `Auto.cfgProd_split`.

Second, the translations that survive -- those of positive degree -- are exactly the members of
`Auto.petStep h P`, so the combinatorial half applies verbatim. -/

open MeasureTheory in
/-- **Reading the normalized family as a headed one.** The members whose translation is constant
multiply into the head, and the headless functional becomes the headed functional of the reduced
family. -/
theorem cfgInt_eq_cfgHeadInt_constFactor {ι : Type*} [Fintype ι] {N : ℝ} (hN : 0 < N)
    {B : Set E3} (hBm : MeasurableSet B) (hBfin : volume B ≠ ⊤) {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) (hg1 : ∀ a x, ‖g a x‖ ≤ 1)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (p : ι → Prop) [DecidablePred p]
    (hconst : ∀ a, ¬ p a → translDeg (γ a) = 0)
    (hCsupp : ∀ x, x ∉ B → constFactor g γ p x = 0) :
    cfgInt N g γ
      = cfgHeadInt N (constFactor g γ p)
          (fun a : {a // p a} => g a.1) (fun a : {a // p a} => γ a.1) := by
  classical
  have hstep : cfgInt N g γ
      = cfgInt N (cfgCons (constFactor g γ p) (fun a : {a // p a} => g a.1))
          (translCons (fun a : {a // p a} => γ a.1)) := by
    rw [cfgInt, cfgInt]
    congr 1
    refine intervalIntegral.integral_congr fun t _ => ?_
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    change cfgProd g γ x t
        = cfgProd (cfgCons (constFactor g γ p) (fun a : {a // p a} => g a.1))
            (translCons (fun a : {a // p a} => γ a.1)) x t
    rw [cfgProd_cons, ← cfgProd_split g γ p hconst x t]
  rw [hstep]
  exact cfgInt_cons hN hBm hBfin ((continuous_constFactor hgc γ p).measurable)
    (norm_constFactor_le hg1 γ p) hCsupp
    (fun a : {a // p a} => hgc a.1) (fun (a : {a // p a}) (x : E3) => hg1 a.1 x) _

/-- **The surviving translations are exactly the members of `Auto.petStep`.** Every normalized
translation of positive degree comes from one of the two replacements the step performs. -/
theorem normalized_transl_mem_petStep {ι : Type*} [Fintype ι]
    (γ : ι → (Fin 3 → Polynomial ℝ)) (h : ℝ) (P : Fin 3 → Polynomial ℝ) (q : ι × Bool)
    (hpos : 0 < translDeg (translSub (dcfgTransl γ h q) P)) :
    translSub (dcfgTransl γ h q) P ∈ petStep h P (Finset.image γ Finset.univ) := by
  classical
  rw [mem_petStep]
  refine ⟨hpos, γ q.1, Finset.mem_image.mpr ⟨q.1, Finset.mem_univ _, rfl⟩, ?_⟩
  by_cases hb : q.2
  · left
    rw [dcfgTransl, ite_eq_left hb]
  · right
    rw [dcfgTransl, ite_eq_right hb]

/-- The normalization is invisible to the headless functional: this is
`Auto.cfgInt_translSub` in the direction the step uses. -/
theorem cfgInt_normalize {ι : Type*} [Fintype ι] (N : ℝ) (g : ι → E3 → ℂ)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (P : Fin 3 → Polynomial ℝ) :
    cfgInt N g γ = cfgInt N g (fun a => translSub (γ a) P) :=
  (cfgInt_translSub N g γ P).symm

/-- After normalizing by a member's own translation, that member carries the zero translation. -/
theorem translSub_self_eq_zero (P : Fin 3 → Polynomial ℝ) : translSub P P = 0 := by
  funext d
  simp [translSub]

/-- A member whose normalized translation is zero has degree zero, so it merges into the head. -/
theorem translDeg_eq_zero_of_translSub_eq_zero {q P : Fin 3 → Polynomial ℝ}
    (h : translSub q P = 0) : translDeg (translSub q P) = 0 := by
  rw [h]
  simp [translDeg]





/-! ## Blueprint `lem:pet-reduction`: one turn of the corrected descent, assembled

The parts proved above compose into a single step. Its statement carries exactly the data the next
turn needs, so that it can be iterated:

* the members are continuous, one-bounded, and supported in a common set (`Auto.CfgMemSupported`),
  which is what bounds the pairing at every parameter (`Auto.norm_cfgPair_le'`);
* the configuration is supported over the parameter range (`Auto.CfgSupportedOn`), which is what
  identifies the integral over the box with the integral over `E3`;
* the conclusion is a lower bound on `Auto.cfgInt` of the differenced family -- the headless
  functional, on which `Auto.cfgInt_translSub` acts.

Shedding the head is `Auto.sq_norm_cfgHeadInt_le`; the analytic step is
`Auto.exists_shift_cfgInt_ge`. -/

open MeasureTheory in
/-- **One turn, from a headed functional to the differenced headless one.** Cauchy-Schwarz in the
point sheds the head; van der Corput, the pigeonhole and the uncapping produce a shift within
`[-H, H]` at which the differenced family's headless functional is bounded below. -/
theorem exists_shift_cfgInt_of_cfgHeadInt {ι : Type*} [Fintype ι] {L : ℝ} {B : Set E3}
    (hBm : MeasurableSet B) (hBfin : volume B ≠ ⊤) (hBpos : 0 < (volume B).toReal)
    {g0 : E3 → ℂ} (hg0m : Measurable g0) (hg01 : ∀ x, ‖g0 x‖ ≤ 1)
    (hg0supp : ∀ x, x ∉ B → g0 x = 0)
    {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a)) (hg1 : ∀ a x, ‖g a x‖ ≤ 1)
    {γ : ι → (Fin 3 → Polynomial ℝ)} (hs : CfgSupportedOn L B g γ)
    {M : ℝ} (hM0 : 0 ≤ M) (hMb : ∀ u v : ℝ, ‖cfgPair g γ u v‖ ≤ M)
    {N H : ℝ} (hN : 0 < N) (hH : 0 < H) (hHN : H ≤ N) (hL : 2 * N ≤ L)
    {β : ℝ} (hβ : 0 < β) (hlow : β ≤ ‖cfgHeadInt N g0 g γ‖)
    (hsmall : 4 * M * (H / N) + 8 * (H / N) ^ 2 * (volume B).toReal
      ≤ β ^ 2 / (volume B).toReal / 2) :
    ∃ h : ℝ, |h| ≤ H ∧
      (β ^ 2 / (volume B).toReal * N / 8 - M * H) / N
        ≤ ‖cfgInt N (dcfgFun g) (dcfgTransl γ h)‖ := by
  -- Cauchy-Schwarz in the point sheds the head
  have hCS := sq_norm_cfgHeadInt_le hN hBm hBfin hg0m hg01 hg0supp hgc hg1 γ
  have hsq : β ^ 2 ≤ ‖cfgHeadInt N g0 g γ‖ ^ 2 := pow_le_pow_left₀ hβ.le hlow 2
  have hL2 : β ^ 2 / (volume B).toReal ≤ cfgL2 N B g γ := by
    rw [div_le_iff₀ hBpos]
    calc β ^ 2 ≤ ‖cfgHeadInt N g0 g γ‖ ^ 2 := hsq
      _ ≤ (volume B).toReal * cfgL2 N B g γ := hCS
      _ = cfgL2 N B g γ * (volume B).toReal := by ring
  have hβ' : 0 < β ^ 2 / (volume B).toReal := by positivity
  exact exists_shift_cfgInt_ge hBfin hgc hg1 hs hM0 hMb hN hH hHN hL hβ' hL2 hsmall

open MeasureTheory in
/-- The differenced family inherits the member-support invariant, so the bound on its pairing is
again available at every parameter -- this is what lets the turn be applied to its own
conclusion. -/
theorem norm_cfgPair_dcfg_le {ι : Type*} [Fintype ι] {B : Set E3} (hBm : MeasurableSet B)
    (hBfin : volume B ≠ ⊤) {g : ι → E3 → ℂ} (hgc : ∀ a, Continuous (g a))
    (hg1 : ∀ a x, ‖g a x‖ ≤ 1) (hm : CfgMemSupported B g)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (a₀ : ι) (h : ℝ) (u v : ℝ) :
    ‖cfgPair (dcfgFun g) (dcfgTransl γ h) u v‖ ≤ (volume B).toReal :=
  norm_cfgPair_le' hBm hBfin (fun p => continuous_dcfgFun hgc p) (norm_dcfgFun_le hg1)
    hm.dcfg (dcfgTransl γ h) (a₀, true) u v

open MeasureTheory in
/-- After the turn, the normalized family is again headed: the members whose translation became
constant merge into the head. This is the other half of the cycle, and it is where the family
sheds a genuine member rather than a phase factor. -/
theorem cfgHeadInt_of_cfgInt_normalized {ι : Type*} [Fintype ι] {N : ℝ} (hN : 0 < N)
    {B : Set E3} (hBm : MeasurableSet B) (hBfin : volume B ≠ ⊤) {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) (hg1 : ∀ a x, ‖g a x‖ ≤ 1)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (P : Fin 3 → Polynomial ℝ)
    (p : ι → Prop) [DecidablePred p]
    (hconst : ∀ a, ¬ p a → translDeg (translSub (γ a) P) = 0)
    (hCsupp : ∀ x, x ∉ B → constFactor g (fun a => translSub (γ a) P) p x = 0) :
    cfgInt N g γ
      = cfgHeadInt N (constFactor g (fun a => translSub (γ a) P) p)
          (fun a : {a // p a} => g a.1)
          (fun a : {a // p a} => translSub (γ a.1) P) := by
  rw [cfgInt_normalize N g γ P]
  exact cfgInt_eq_cfgHeadInt_constFactor hN hBm hBfin hgc hg1
    (fun a => translSub (γ a) P) p hconst hCsupp



/-! ## Blueprint `lem:pet-reduction`: the weight descends for the surviving translations

`Auto.petWeight_step_lt` compares the weight of `Auto.petStep h P S` with that of `S`. What the
iteration needs is the weight of the translations that actually survive one analytic turn, which
`Auto.normalized_transl_mem_petStep` places inside `Auto.petStep h P S` but need not exhaust.
Monotonicity of the weight under inclusion closes that gap: fewer translations means no more
leading-coefficient classes at any level, hence a no-larger weight in the lexicographic order. -/

open Classical in
/-- Fewer translations, no more classes. -/
theorem petClassSet_mono {d : ℕ} {S T : Finset (Fin 3 → Polynomial ℝ)} (hST : S ⊆ T) :
    petClassSet d S ⊆ petClassSet d T :=
  Finset.image_subset_image (Finset.filter_subset_filter _ hST)

open Classical in
theorem petClasses_mono {d : ℕ} {S T : Finset (Fin 3 → Polynomial ℝ)} (hST : S ⊆ T) :
    petClasses d S ≤ petClasses d T :=
  Finset.card_le_card (petClassSet_mono hST)

open Classical in
/-- **The weight is monotone under inclusion.** Componentwise `≤` gives `≤` in the lexicographic
order, because the first place where the two differ is then a strict `<`. -/
theorem petWeight_mono {S T : Finset (Fin 3 → Polynomial ℝ)} (hST : S ⊆ T) :
    petWeight S ≤ petWeight T := by
  have h3 := petClasses_mono (d := 3) hST
  have h2 := petClasses_mono (d := 2) hST
  have h1 := petClasses_mono (d := 1) hST
  rw [petWeight, petWeight, Prod.Lex.toLex_le_toLex]
  rcases lt_or_eq_of_le h3 with hlt | heq
  · exact Or.inl hlt
  · refine Or.inr ⟨heq, ?_⟩
    rw [Prod.Lex.toLex_le_toLex]
    rcases lt_or_eq_of_le h2 with hlt2 | heq2
    · exact Or.inl hlt2
    · exact Or.inr ⟨heq2, h1⟩

open Classical in
/-- The translations surviving one turn: the normalized differenced ones of positive degree. -/
noncomputable def survivorSet {ι : Type*} [Fintype ι] (γ : ι → (Fin 3 → Polynomial ℝ))
    (h : ℝ) (P : Fin 3 → Polynomial ℝ) : Finset (Fin 3 → Polynomial ℝ) :=
  (Finset.univ.image fun q : ι × Bool => translSub (dcfgTransl γ h q) P).filter
    fun u => 0 < translDeg u

open Classical in
theorem survivorSet_subset_petStep {ι : Type*} [Fintype ι]
    (γ : ι → (Fin 3 → Polynomial ℝ)) (h : ℝ) (P : Fin 3 → Polynomial ℝ) :
    survivorSet γ h P ⊆ petStep h P (Finset.image γ Finset.univ) := by
  intro u hu
  rw [survivorSet, Finset.mem_filter, Finset.mem_image] at hu
  obtain ⟨⟨q, _, hq⟩, hpos⟩ := hu
  rw [← hq] at hpos ⊢
  exact normalized_transl_mem_petStep γ h P q hpos

open Classical in
/-- **The descent the iteration runs on.** Selecting a translation of minimal positive degree from
the family, the translations that survive one turn have strictly smaller weight. -/
theorem petWeight_survivorSet_lt {ι : Type*} [Fintype ι] {γ : ι → (Fin 3 → Polynomial ℝ)}
    {h : ℝ} {P : Fin 3 → Polynomial ℝ} {m : ℕ} (hm : 0 < m) (hm3 : m ≤ 3)
    (hPS : P ∈ Finset.image γ Finset.univ) (hPdeg : translDeg P = m)
    (hmin : ∀ q ∈ Finset.image γ Finset.univ, m ≤ translDeg q) :
    petWeight (survivorSet γ h P) < petWeight (Finset.image γ Finset.univ) :=
  lt_of_le_of_lt (petWeight_mono (survivorSet_subset_petStep γ h P))
    (petWeight_step_lt hm hm3 hPS hPdeg hmin)

open Classical in
/-- A nonempty finite family of translations has one of minimal degree. -/
theorem exists_min_translDeg {S : Finset (Fin 3 → Polynomial ℝ)} (hS : S.Nonempty) :
    ∃ P ∈ S, ∀ q ∈ S, translDeg P ≤ translDeg q := by
  obtain ⟨P, hPS, hPmin⟩ := S.exists_min_image translDeg hS
  exact ⟨P, hPS, hPmin⟩



/-! ## Blueprint `lem:pet-reduction`: the working box as a ball

`Auto.cfgBox` is the honest enlargement, but it is a projection -- `x` lies in it when `x +
  translAct q t`
lies in `B` for *some* `t` -- and a projection of a Borel set is analytic, not in general Borel.
  The
lemmas of the chain need a measurable box of finite measure, so the iteration works instead with a
closed ball containing it: the members live in a ball, the displacement over a bounded parameter
range is bounded by compactness, and the sum of the two radii is the working box.

This also makes the invariant easy to carry. The member ball never changes -- differencing only
conjugates the member functions -- and only the radius of the working box grows, by the bound on the
displacement, which is the blueprint's enlargement of `I_N(C)` from step to step. -/

open MeasureTheory in
/-- Restricted support passes to any larger set. -/
theorem CfgSupportedOn.mono {ι : Type*} [Fintype ι] {L : ℝ} {B B' : Set E3} {g : ι → E3 → ℂ}
    {γ : ι → (Fin 3 → Polynomial ℝ)} (hs : CfgSupportedOn L B g γ) (hBB' : B ⊆ B') :
    CfgSupportedOn L B' g γ :=
  fun t ht x hx => hs t ht x fun hxB => hx (hBB' hxB)

/-- **The displacement over a bounded parameter range is bounded**, by continuity of the
translation on a compact interval. -/
theorem exists_bound_translAct (q : Fin 3 → Polynomial ℝ) (L : ℝ) :
    ∃ ρ : ℝ, 0 ≤ ρ ∧ ∀ t : ℝ, |t| ≤ L → ‖translAct q t‖ ≤ ρ := by
  obtain ⟨ρ, hρ⟩ := (isCompact_Icc (a := -L) (b := L)).exists_bound_of_continuousOn
    (continuous_translAct q).continuousOn
  refine ⟨max ρ 0, le_max_right _ _, fun t ht => ?_⟩
  have htm : t ∈ Set.Icc (-L) L := ⟨neg_le_of_abs_le ht, le_of_abs_le ht⟩
  exact le_trans (hρ t htm) (le_max_left _ _)

/-- The enlarged box sits inside a closed ball whose radius is the sum of the member radius and the
displacement bound. -/
theorem cfgBox_subset_closedBall {L r ρ : ℝ} {q : Fin 3 → Polynomial ℝ}
    (hρ : ∀ t : ℝ, |t| ≤ L → ‖translAct q t‖ ≤ ρ) :
    cfgBox L (Metric.closedBall (0 : E3) r) q ⊆ Metric.closedBall (0 : E3) (r + ρ) := by
  rintro x ⟨t, ht, hx⟩
  rw [Metric.mem_closedBall, dist_zero_right] at hx ⊢
  calc ‖x‖ = ‖(x + translAct q t) - translAct q t‖ := by congr 1; abel
    _ ≤ ‖x + translAct q t‖ + ‖translAct q t‖ := norm_sub_le _ _
    _ ≤ r + ρ := add_le_add hx (hρ t ht)

open MeasureTheory in
/-- **The working box.** From members supported in a ball of radius `r`, the configuration is
supported -- over parameters of size at most `L` -- in the ball of radius `r + ρ`, where `ρ` bounds
the displacement of the distinguished member's translation. -/
theorem cfgSupportedOn_closedBall {ι : Type*} [Fintype ι] {r : ℝ} {g : ι → E3 → ℂ}
    (hm : CfgMemSupported (Metric.closedBall (0 : E3) r) g)
    (γ : ι → (Fin 3 → Polynomial ℝ)) (a₀ : ι) {L ρ : ℝ}
    (hρ : ∀ t : ℝ, |t| ≤ L → ‖translAct (γ a₀) t‖ ≤ ρ) :
    CfgSupportedOn L (Metric.closedBall (0 : E3) (r + ρ)) g γ :=
  (cfgSupportedOn_of_memSupported hm γ a₀ L).mono (cfgBox_subset_closedBall hρ)

open MeasureTheory in
/-- A closed ball is measurable, of finite measure, and of positive measure when the radius is
positive -- the three facts the chain asks of its box. -/
theorem closedBall_facts {R : ℝ} (hR : 0 < R) :
    MeasurableSet (Metric.closedBall (0 : E3) R)
      ∧ volume (Metric.closedBall (0 : E3) R) ≠ ⊤
      ∧ 0 < (volume (Metric.closedBall (0 : E3) R)).toReal := by
  refine ⟨measurableSet_closedBall, ?_, ?_⟩
  · exact (Metric.isBounded_closedBall.measure_lt_top).ne
  · rw [ENNReal.toReal_pos_iff]
    refine ⟨?_, Metric.isBounded_closedBall.measure_lt_top⟩
    exact Metric.measure_closedBall_pos _ _ hR



/-! ## Blueprint `lem:pet-reduction`: choosing the shift range, and the head after normalizing

Two ingredients of the induction step.

First, the blueprint takes `H = c delta^C N` "at each use of van der Corput, in the current
normalized parameter": the shift range is chosen afresh at every turn from the current lower bound,
so the boundary error is absorbed step by step and no uniform bound on the number of turns is
needed. `Auto.exists_H_small` is that choice.

Second, the head produced by normalizing is supported where the *selected* member is. The member
whose translation is the selected `P` normalizes to the zero translation, so it always belongs to
the merged head, and a product vanishes wherever one factor does. The head therefore does not
spread: only the working box, which must also contain the support of the reduced family, grows. -/

/-- **The shift range at one turn.** The boundary error is at most half the current lower bound for
all sufficiently small shift ranges, and one such range is exhibited. -/
theorem exists_H_small {M V N β : ℝ} (hN : 0 < N) (hM0 : 0 ≤ M) (hV0 : 0 < V) (hβ : 0 < β) :
    ∃ H : ℝ, 0 < H ∧ H ≤ N ∧
      4 * M * (H / N) + 8 * (H / N) ^ 2 * V ≤ β ^ 2 / V / 2
      ∧ M * H ≤ β ^ 2 / V * N / 16 := by
  set ε : ℝ := β ^ 2 / V with hεdef
  have hε0 : 0 < ε := by rw [hεdef]; positivity
  set D : ℝ := 2 * (4 * M + 8 * V) with hDdef
  have hD0 : 0 < D := by rw [hDdef]; positivity
  set E : ℝ := 16 * (M + 1) with hEdef
  have hE0 : 0 < E := by rw [hEdef]; positivity
  set u : ℝ := min 1 (min (ε / D) (ε / E)) with hudef
  have hu0 : 0 < u := lt_min one_pos (lt_min (by positivity) (by positivity))
  have hu1 : u ≤ 1 := min_le_left _ _
  have huD : u ≤ ε / D := le_trans (min_le_right _ _) (min_le_left _ _)
  have huE : u ≤ ε / E := le_trans (min_le_right _ _) (min_le_right _ _)
  refine ⟨u * N, by positivity, ?_, ?_, ?_⟩
  · calc u * N ≤ 1 * N := mul_le_mul_of_nonneg_right hu1 hN.le
      _ = N := one_mul N
  · have hdiv : u * N / N = u := by field_simp
    rw [hdiv]
    have husq : u ^ 2 ≤ u := by nlinarith
    have hsum : (0 : ℝ) < 4 * M + 8 * V := by positivity
    calc 4 * M * u + 8 * u ^ 2 * V ≤ 4 * M * u + 8 * u * V := by nlinarith
      _ = u * (4 * M + 8 * V) := by ring
      _ ≤ ε / D * (4 * M + 8 * V) := mul_le_mul_of_nonneg_right huD hsum.le
      _ = ε / 2 := by rw [hDdef]; field_simp
  · have hu' : u * E ≤ ε := by
      calc u * E ≤ ε / E * E := mul_le_mul_of_nonneg_right huE hE0.le
        _ = ε := by field_simp
    have hgoal : M * (u * N) * 16 ≤ ε * N := by
      rw [hEdef] at hu'
      nlinarith [hu', hN.le, hM0, hu0.le]
    linarith [hgoal]

open Classical in
/-- **The merged head does not spread.** The member carrying the zero translation is one of the
factors of `Auto.constFactor`, and a product vanishes wherever one of its factors does, so the head
is supported where that member is. -/
theorem constFactor_eq_zero_of_zero_transl {ι : Type*} [Fintype ι] {B : Set E3}
    {g : ι → E3 → ℂ} (hm : CfgMemSupported B g) (γ : ι → (Fin 3 → Polynomial ℝ))
    (p : ι → Prop) [DecidablePred p] (a₀ : ι) (ha₀ : ¬ p a₀) (hγ : γ a₀ = 0)
    {x : E3} (hx : x ∉ B) : constFactor g γ p x = 0 := by
  rw [constFactor]
  refine Finset.prod_eq_zero (Finset.mem_filter.mpr ⟨Finset.mem_univ a₀, ha₀⟩) ?_
  rw [hγ, translAct_zero, add_zero]
  exact hm a₀ x hx

/-- After normalizing by its own translation, the selected member carries the zero translation --
so it is never in the reduced family, and always in the head. -/
theorem translSub_selected_eq_zero {ι : Type*} (γ : ι → (Fin 3 → Polynomial ℝ)) (a₀ : ι) :
    translSub (γ a₀) (γ a₀) = 0 :=
  translSub_self_eq_zero (γ a₀)

/-- The selected member fails the "nonconstant" test, hence merges into the head. -/
theorem not_pos_translDeg_selected {ι : Type*} (γ : ι → (Fin 3 → Polynomial ℝ)) (a₀ : ι) :
    ¬ (0 < translDeg (translSub (γ a₀) (γ a₀))) := by
  rw [translSub_selected_eq_zero γ a₀]
  simp [translDeg]



/-! ## Blueprint `lem:pet-reduction`: the reduced family's translations are the survivors

The bookkeeping that connects the analytic step to the combinatorial one. After a turn and the
normalization, the reduced family is indexed by the members whose translation stayed nonconstant,
and the image of its translations is exactly `Auto.survivorSet` -- on which
`Auto.petWeight_survivorSet_lt` gives the descent. The degree bound of the recursion is inherited
along the way, so the selected translation always has degree between one and three, which is what
`Auto.petWeight_step_lt` requires. -/

open Classical in
/-- The predicate that keeps a member in the reduced family: its normalized translation is
nonconstant. -/
def keepMem {ι : Type*} (γ : ι → (Fin 3 → Polynomial ℝ)) (h : ℝ) (P : Fin 3 → Polynomial ℝ)
    (q : ι × Bool) : Prop :=
  0 < translDeg (translSub (dcfgTransl γ h q) P)

open Classical in
noncomputable instance decidableKeepMem {ι : Type*} (γ : ι → (Fin 3 → Polynomial ℝ)) (h : ℝ)
    (P : Fin 3 → Polynomial ℝ) : DecidablePred (keepMem γ h P) :=
  fun _ => Classical.propDecidable _

open Classical in
/-- **The reduced family's translations are exactly the survivors.** -/
theorem image_reduced_transl {ι : Type*} [Fintype ι] (γ : ι → (Fin 3 → Polynomial ℝ))
    (h : ℝ) (P : Fin 3 → Polynomial ℝ) :
    (Finset.univ.image fun a : {q : ι × Bool // keepMem γ h P q} =>
        translSub (dcfgTransl γ h a.1) P)
      = survivorSet γ h P := by
  ext u
  simp only [Finset.mem_image, Finset.mem_univ, true_and, survivorSet, Finset.mem_filter]
  constructor
  · rintro ⟨a, rfl⟩
    exact ⟨⟨a.1, rfl⟩, a.2⟩
  · rintro ⟨⟨q, rfl⟩, hpos⟩
    exact ⟨⟨q, hpos⟩, rfl⟩

open Classical in
/-- The degree bound of the recursion is inherited by the survivors. -/
theorem survivorSet_deg {ι : Type*} [Fintype ι] {γ : ι → (Fin 3 → Polynomial ℝ)} {h : ℝ}
    {P : Fin 3 → Polynomial ℝ} (hP : translDeg P ≤ 3)
    (hγ : ∀ q ∈ Finset.image γ Finset.univ, translDeg q ≤ 3) :
    ∀ u ∈ survivorSet γ h P, 0 < translDeg u ∧ translDeg u ≤ 3 :=
  fun u hu => petStep_deg hP hγ u (survivorSet_subset_petStep γ h P hu)

open Classical in
/-- The selected translation realizes the minimum, and that minimum is positive when every
translation of the family is nonconstant. -/
theorem exists_selected {ι : Type*} [Fintype ι] [Nonempty ι] (γ : ι → (Fin 3 → Polynomial ℝ))
    (hpos : ∀ a, 0 < translDeg (γ a)) :
    ∃ a₀ : ι, 0 < translDeg (γ a₀)
      ∧ ∀ q ∈ Finset.image γ Finset.univ, translDeg (γ a₀) ≤ translDeg q := by
  obtain ⟨P, hPS, hPmin⟩ := exists_min_translDeg (S := Finset.image γ Finset.univ)
    (Finset.image_nonempty.mpr Finset.univ_nonempty)
  obtain ⟨a₀, _, ha₀⟩ := Finset.mem_image.mp hPS
  refine ⟨a₀, ?_, ?_⟩
  · exact hpos a₀
  · rw [ha₀]
    exact hPmin

open Classical in
/-- The member realizing the selected translation, taken undifferenced, normalizes to zero -- which
is what places it in the merged head. -/
theorem keepMem_false_of_selected {ι : Type*} (γ : ι → (Fin 3 → Polynomial ℝ)) (h : ℝ) (a₀ : ι) :
    ¬ keepMem γ h (γ a₀) (a₀, false) := by
  rw [keepMem, dcfgTransl]
  simp only [Bool.false_eq_true, ite_false]
  rw [translSub_self_eq_zero]
  simp [translDeg]

open Classical in
/-- Every translation of the reduced family is nonconstant, so the invariant the descent needs is
restored after each turn. -/
theorem reduced_transl_pos {ι : Type*} (γ : ι → (Fin 3 → Polynomial ℝ)) (h : ℝ)
    (P : Fin 3 → Polynomial ℝ) (a : {q : ι × Bool // keepMem γ h P q}) :
    0 < translDeg (translSub (dcfgTransl γ h a.1) P) :=
  a.2



/-! ## Blueprint `lem:pet-reduction`: the induction step

One turn, from a headed configuration to a headed configuration of strictly smaller weight, with
every component of the invariant restored. The pieces are proved above; what this section does is
choose the data at each turn -- the selected translation, the shift range, the shift -- and check
that the result is again admissible.

Two features are worth pointing out. The shift range is chosen *inside* the step, from the current
lower bound (`Auto.exists_H_small`), which is the blueprint's prescription and is why no bound on
the number of turns is needed. And the member ball does not change: differencing only conjugates
the member functions, and the merged head is supported where the selected member was, so the same
radius `r` serves at every turn. -/

open Classical in
open MeasureTheory in
/-- **One step of the induction.** A headed configuration whose translations are all nonconstant,
with members in a ball of radius `r` and working box a ball of radius `R`, yields a headed
configuration of strictly smaller weight whose members lie in the *same* ball. -/
theorem exists_step_of_headed {N L r : ℝ} (hN : 0 < N) (hL : 2 * N ≤ L) (hr : 0 < r)
    {ι : Type} [Fintype ι] [Nonempty ι] {g : ι → E3 → ℂ}
    (hgc : ∀ a, Continuous (g a)) (hg1 : ∀ a x, ‖g a x‖ ≤ 1)
    (hm : CfgMemSupported (Metric.closedBall (0 : E3) r) g)
    {γ : ι → (Fin 3 → Polynomial ℝ)} (hpos : ∀ a, 0 < translDeg (γ a))
    (hdeg : ∀ a, translDeg (γ a) ≤ 3)
    {R : ℝ} (hR : 0 < R) (hrR : Metric.closedBall (0 : E3) r ⊆ Metric.closedBall (0 : E3) R)
    (hs : CfgSupportedOn L (Metric.closedBall (0 : E3) R) g γ)
    {g0 : E3 → ℂ} (hg0m : Measurable g0) (hg01 : ∀ x, ‖g0 x‖ ≤ 1)
    (hg0supp : ∀ x, x ∉ Metric.closedBall (0 : E3) R → g0 x = 0)
    {β : ℝ} (hβ : 0 < β) (hlow : β ≤ ‖cfgHeadInt N g0 g γ‖) :
    ∃ (ι' : Type) (_ : Fintype ι') (g' : ι' → E3 → ℂ) (γ' : ι' → (Fin 3 → Polynomial ℝ))
      (g0' : E3 → ℂ) (β' : ℝ),
      (∀ a, Continuous (g' a)) ∧ (∀ a x, ‖g' a x‖ ≤ 1)
        ∧ CfgMemSupported (Metric.closedBall (0 : E3) r) g'
        ∧ (∀ a, 0 < translDeg (γ' a)) ∧ (∀ a, translDeg (γ' a) ≤ 3)
        ∧ Measurable g0' ∧ (∀ x, ‖g0' x‖ ≤ 1)
        ∧ (∀ x, x ∉ Metric.closedBall (0 : E3) r → g0' x = 0)
        ∧ petWeight (Finset.image γ' Finset.univ)
            < petWeight (Finset.image γ Finset.univ)
        ∧ 0 < β' ∧ β' ≤ ‖cfgHeadInt N g0' g' γ'‖ := by
  classical
  obtain ⟨hBm, hBfin, hBpos⟩ := closedBall_facts (R := R) hR
  obtain ⟨hrm, hrfin, _hrpos⟩ := closedBall_facts (R := r) hr
  set V : ℝ := (volume (Metric.closedBall (0 : E3) R)).toReal with hVdef
  set Mr : ℝ := (volume (Metric.closedBall (0 : E3) r)).toReal with hMrdef
  have hMb : ∀ u v : ℝ, ‖cfgPair g γ u v‖ ≤ Mr := fun u v =>
    norm_cfgPair_le' hrm hrfin hgc hg1 hm γ (Classical.arbitrary ι) u v
  have hM0 : (0 : ℝ) ≤ Mr := ENNReal.toReal_nonneg
  obtain ⟨H, hH0, hHN, hHsmall, hHtight⟩ :=
    exists_H_small (M := Mr) (V := V) (N := N) (β := β) hN hM0 hBpos hβ
  obtain ⟨h, _hhH, hh⟩ := exists_shift_cfgInt_of_cfgHeadInt hBm hBfin hBpos hg0m hg01 hg0supp
    hgc hg1 hs hM0 hMb hN hH0 hHN hL hβ hlow hHsmall
  obtain ⟨a₀, ha₀pos, ha₀min⟩ := exists_selected γ hpos
  set P : Fin 3 → Polynomial ℝ := γ a₀ with hPdef
  set p : ι × Bool → Prop := keepMem γ h P with hpdef
  have hconst : ∀ q : ι × Bool, ¬ p q →
      translDeg (translSub (dcfgTransl γ h q) P) = 0 := by
    intro q hq
    rw [hpdef, keepMem] at hq
    omega
  have hCsupp : ∀ x, x ∉ Metric.closedBall (0 : E3) r →
      constFactor (dcfgFun g) (fun q => translSub (dcfgTransl γ h q) P) p x = 0 := by
    intro x hx
    refine constFactor_eq_zero_of_zero_transl hm.dcfg _ p (a₀, false) ?_ ?_ hx
    · exact keepMem_false_of_selected γ h a₀
    · rw [dcfgTransl]
      simp only [Bool.false_eq_true, ite_false]
      exact translSub_self_eq_zero P
  have hEq := cfgHeadInt_of_cfgInt_normalized (N := N) hN hBm hBfin
    (fun q => continuous_dcfgFun hgc q) (norm_dcfgFun_le hg1) (dcfgTransl γ h) P p hconst
    (fun x hx => hCsupp x fun hxr => hx (hrR hxr))
  have hdegim : ∀ q ∈ Finset.image γ Finset.univ, translDeg q ≤ 3 := by
    intro q hq
    obtain ⟨b, _, rfl⟩ := Finset.mem_image.mp hq
    exact hdeg b
  refine ⟨{q : ι × Bool // p q}, inferInstance,
    (fun a => dcfgFun g a.1), (fun a => translSub (dcfgTransl γ h a.1) P),
    constFactor (dcfgFun g) (fun q => translSub (dcfgTransl γ h q) P) p,
    (β ^ 2 / V * N / 8 - Mr * H) / N,
    (fun a => continuous_dcfgFun hgc a.1), (fun a x => norm_dcfgFun_le hg1 a.1 x),
    (fun a x hx => hm.dcfg a.1 x hx), (fun a => a.2), ?_,
    (continuous_constFactor (fun q => continuous_dcfgFun hgc q) _ p).measurable,
    norm_constFactor_le (norm_dcfgFun_le hg1) _ p, hCsupp, ?_, ?_, ?_⟩
  · intro a
    have hmem : translSub (dcfgTransl γ h a.1) P ∈ survivorSet γ h P := by
      rw [← image_reduced_transl γ h P]
      exact Finset.mem_image.mpr ⟨a, Finset.mem_univ _, rfl⟩
    exact (survivorSet_deg (hdeg a₀) hdegim _ hmem).2
  · rw [image_reduced_transl γ h P]
    exact petWeight_survivorSet_lt ha₀pos (hdeg a₀)
      (Finset.mem_image.mpr ⟨a₀, Finset.mem_univ _, rfl⟩) rfl ha₀min
  · have hnum : 0 < β ^ 2 / V * N / 8 - Mr * H := by
      have h16 : (0 : ℝ) < β ^ 2 / V * N / 16 := by positivity
      linarith [hHtight]
    exact div_pos hnum hN
  · rw [← hEq]
    exact hh



/-! ## Blueprint `lem:pet-reduction`: the recursion

Iterating `Auto.exists_step_of_headed` by well-founded recursion on `Auto.petWeight`. The
recursion stops when the family is empty -- every translation having become constant and merged
into the head -- and at that point the configuration average is one, so the headed functional is
just the integral of the accumulated head.

The working box is rebuilt at each turn rather than carried: from the member ball and a bound on
the displacement of one member's translation over the parameter range
(`Auto.exists_bound_translAct`, `Auto.cfgSupportedOn_closedBall`). That is why the step does not
have to return it. -/

open MeasureTheory in
/-- The empty configuration has average one. -/
theorem cfgAvg_of_isEmpty {ι : Type*} [Fintype ι] [IsEmpty ι] {N : ℝ} (hN : 0 < N)
    (g : ι → E3 → ℂ) (γ : ι → (Fin 3 → Polynomial ℝ)) (x : E3) :
    cfgAvg N g γ x = 1 := by
  have h1 : ∀ t : ℝ, cfgProd g γ x t = 1 := by
    intro t
    simp [cfgProd]
  rw [cfgAvg, intervalIntegral.integral_congr (g := fun _ : ℝ => (1 : ℂ)) fun t _ => h1 t,
    intervalIntegral.integral_const, sub_zero, smul_smul, inv_mul_cancel₀ hN.ne', one_smul]

open MeasureTheory in
/-- With no members left, the headed functional is the integral of the head. -/
theorem cfgHeadInt_of_isEmpty {ι : Type*} [Fintype ι] [IsEmpty ι] {N : ℝ} (hN : 0 < N)
    (g0 : E3 → ℂ) (g : ι → E3 → ℂ) (γ : ι → (Fin 3 → Polynomial ℝ)) :
    cfgHeadInt N g0 g γ = ∫ x : E3, g0 x := by
  rw [cfgHeadInt]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
  change g0 x * cfgAvg N g γ x = g0 x
  rw [cfgAvg_of_isEmpty hN g γ x, mul_one]

open Classical in
open MeasureTheory in
/-- **The recursion.** Iterating the turn to the empty family: a headed configuration with all
translations nonconstant yields an accumulated head, one-bounded and supported in the same ball,
whose integral is bounded below. -/
theorem exists_constant_endpoint {N L r : ℝ} (hN : 0 < N) (hL : 2 * N ≤ L) (hr : 0 < r) :
    ∀ (w : ℕ ×ₗ ℕ ×ₗ ℕ) (ι : Type) [Fintype ι] (g : ι → E3 → ℂ)
      (γ : ι → (Fin 3 → Polynomial ℝ)) (g0 : E3 → ℂ) (β : ℝ),
      petWeight (Finset.image γ Finset.univ) = w →
      (∀ a, Continuous (g a)) → (∀ a x, ‖g a x‖ ≤ 1) →
      CfgMemSupported (Metric.closedBall (0 : E3) r) g →
      (∀ a, 0 < translDeg (γ a)) → (∀ a, translDeg (γ a) ≤ 3) →
      Measurable g0 → (∀ x, ‖g0 x‖ ≤ 1) →
      (∀ x, x ∉ Metric.closedBall (0 : E3) r → g0 x = 0) →
      0 < β → β ≤ ‖cfgHeadInt N g0 g γ‖ →
      ∃ (u : E3 → ℂ) (β' : ℝ), Measurable u ∧ (∀ x, ‖u x‖ ≤ 1)
        ∧ (∀ x, x ∉ Metric.closedBall (0 : E3) r → u x = 0)
        ∧ 0 < β' ∧ β' ≤ ‖∫ x : E3, u x‖ := by
  intro w
  induction w using WellFoundedLT.induction with
  | ind w ih =>
    intro ι _ g γ g0 β hw hgc hg1 hm hpos hdeg hg0m hg01 hg0supp hβ hlow
    rcases isEmpty_or_nonempty ι with hemp | hne
    · refine ⟨g0, β, hg0m, hg01, hg0supp, hβ, ?_⟩
      rwa [cfgHeadInt_of_isEmpty hN g0 g γ] at hlow
    · have := hne
      obtain ⟨ρ, hρ0, hρ⟩ := exists_bound_translAct (γ (Classical.arbitrary ι)) L
      have hR : 0 < r + ρ := by linarith
      have hrR : Metric.closedBall (0 : E3) r ⊆ Metric.closedBall (0 : E3) (r + ρ) :=
        Metric.closedBall_subset_closedBall (by linarith)
      have hs : CfgSupportedOn L (Metric.closedBall (0 : E3) (r + ρ)) g γ :=
        cfgSupportedOn_closedBall hm γ (Classical.arbitrary ι) hρ
      obtain ⟨ι', hFin, g', γ', g0', β', hgc', hg1', hm', hpos', hdeg', hg0m', hg01',
        hg0supp', hwlt, hβ', hlow'⟩ :=
        exists_step_of_headed hN hL hr hgc hg1 hm hpos hdeg hR hrR hs hg0m hg01
          (fun x hx => hg0supp x fun hxr => hx (hrR hxr)) hβ hlow
      let : Fintype ι' := hFin
      exact ih _ (hw ▸ hwlt) ι' g' γ' g0' β' rfl
        hgc' hg1' hm' hpos' hdeg' hg0m' hg01' hg0supp' hβ' hlow'



/-! ## Blueprint `lem:degree-lowering-zero`: expanding the last difference

The proof begins "expand the `(s+1)`-st difference and use Fubini to select the last difference
`h`".  The algebraic content is that Fejer differences along a fixed direction commute, so the
`(s+1)`-fold difference at shifts `(a, h')` is the `s`-fold difference at `h'` of the single
difference at `a`. Iterating that identity is what lets the outer shift be pulled out of the
`(s+1)`-fold average, turning it into an average of `s`-fold averages of differenced functions.

This row is stated under the hypotheses of `lem:pet-reduction` but does not depend on how that lemma
is proved, so it is available while the endpoint of `lem:pet-reduction` is blocked. -/

/-- **Fejer differences along a fixed direction commute.** Both sides expand to the same product of
four values of `f`, over the four vertices of the rectangle spanned by the two shifts. -/
theorem fdiff_comm (v : E3) (a b : ℝ) (f : E3 → ℂ) (x : E3) :
    fdiff v a (fdiff v b f) x = fdiff v b (fdiff v a f) x := by
  have hx : x + a • v + b • v = x + b • v + a • v := by abel
  simp only [fdiff, map_mul, Complex.conj_conj, hx]
  ring

/-- A single difference passes through an iterated one. -/
theorem fdiff_fdiffIter_comm (v : E3) (a : ℝ) :
    ∀ (s : ℕ) (h : Fin s → ℝ) (f : E3 → ℂ) (x : E3),
      fdiff v a (fdiffIter v s h f) x = fdiffIter v s h (fdiff v a f) x
  | 0, _, _, _ => rfl
  | (s + 1), h, f, x => by
      have IH : ∀ y : E3,
          fdiff v a (fdiffIter v s (fun i => h i.succ) f) y
            = fdiffIter v s (fun i => h i.succ) (fdiff v a f) y :=
        fun y => fdiff_fdiffIter_comm v a s (fun i => h i.succ) f y
      rw [fdiffIter_succ, fdiffIter_succ, fdiff_comm]
      have hfun : fdiff v a (fdiffIter v s (fun i => h i.succ) f)
          = fdiffIter v s (fun i => h i.succ) (fdiff v a f) := funext IH
      rw [hfun]

/-- **The last difference, split off.** The `(s+1)`-fold difference at the shifts `Fin.cons a h'`
is the `s`-fold difference at `h'` of the single difference at `a`. -/
theorem fdiffIter_cons (v : E3) (s : ℕ) (a : ℝ) (h' : Fin s → ℝ) (f : E3 → ℂ) (x : E3) :
    fdiffIter v (s + 1) (Fin.cons a h') f x = fdiffIter v s h' (fdiff v a f) x := by
  rw [fdiffIter_succ]
  simp only [Fin.cons_zero, Fin.cons_succ]
  exact fdiff_fdiffIter_comm v a s h' f x

-- The splitting of the Fejer product is already available as `Auto.fejerCube_cons`, and the
-- one-boundedness of a difference as `Auto.norm_fdiff_le`; both are used below unchanged.



/-! ## Blueprint `lem:degree-lowering-zero`: the Fubini selection

"Expand the `(s+1)`-st difference and use Fubini to select the last difference `h`."  With
`Auto.fdiffIter_cons` the `(s+1)`-fold difference factors over the first shift, and Fubini on
`ℝ × (Fin s → ℝ)` turns the `(s+1)`-fold average into an average, against the Fejer kernel, of the
`s`-fold averages of the differenced functions:
  `locUnifPow N H j (s+1) f = int_a fejer(a) * locUnifPow N H j s (fdiff e_j a f)`.

The integrability is `Auto.integrable_split_integrand`, already proved for
`Auto.locUnifPow_succ_eq`, which splits the same product the other way; the only new ingredient is
that the inner integral of the `(s+1)`-fold difference is simultaneously a pairing of the `s`-fold
difference (`Auto.integral_fdiffIter_succ`) and the `s`-fold average of the differenced function
(`Auto.fdiffIter_cons`). -/

open MeasureTheory in
/-- The two readings of the inner integral: pairing the `s`-fold difference, or averaging the
`s`-fold difference of the single difference. -/
theorem pairAvg_eq_integral_fdiffIter (v : E3) (s : ℕ) (a : ℝ) (h' : Fin s → ℝ) (f : E3 → ℂ) :
    pairAvg v (fdiffIter v s h' f) a
      = ∫ x : E3, fdiffIter v s h' (fdiff v a f) x := by
  have h1 := integral_fdiffIter_succ v s (Fin.cons a h') f
  simp only [Fin.cons_zero, Fin.cons_succ] at h1
  rw [← h1]
  exact integral_congr_ae (Filter.Eventually.of_forall fun x => fdiffIter_cons v s a h' f x)

open MeasureTheory in
/-- **The Fubini selection.** The `(s+1)`-fold local uniformity average is the Fejer average, over
the first shift, of the `s`-fold averages of the differenced function. -/
theorem locUnifPow_succ_split {N H : ℝ} (hH : 0 < H) (hN : N ≠ 0) (j : Fin 3) (s : ℕ)
    {f : E3 → ℂ} (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) :
    locUnifPow N H j (s + 1) f
      = ∫ a : ℝ, ((fejer H a : ℝ) : ℂ) * locUnifPow N H j s (fdiff (basisVec j) a f) := by
  classical
  have hNpow : ((N : ℂ) ^ (6 : ℕ)) ≠ 0 := pow_ne_zero _ (by exact_mod_cast hN)
  -- the right-hand side, expanded
  have hRHS : (∫ a : ℝ, ((fejer H a : ℝ) : ℂ) * locUnifPow N H j s (fdiff (basisVec j) a f))
      = ((N ^ (6 : ℕ))⁻¹ : ℂ) * ∫ a : ℝ, ((fejer H a : ℝ) : ℂ)
          * ∫ h' : Fin s → ℝ, ((fejerCube H h' : ℝ) : ℂ)
              * pairAvg (basisVec j) (fdiffIter (basisVec j) s h' f) a := by
    rw [← integral_const_mul]
    refine integral_congr_ae (Filter.Eventually.of_forall fun a => ?_)
    change ((fejer H a : ℝ) : ℂ) * locUnifPow N H j s (fdiff (basisVec j) a f)
        = ((N ^ (6 : ℕ))⁻¹ : ℂ) * (((fejer H a : ℝ) : ℂ)
            * ∫ h' : Fin s → ℝ, ((fejerCube H h' : ℝ) : ℂ)
                * pairAvg (basisVec j) (fdiffIter (basisVec j) s h' f) a)
    rw [locUnifPow_swap hH j s (nice_fdiff _ a hf) (fun y => norm_fdiff_le _ a hf1 y)]
    have hinner : ∀ h' : Fin s → ℝ,
        ((fejerCube H h' : ℝ) : ℂ)
            * ∫ x : E3, fdiffIter (basisVec j) s h' (fdiff (basisVec j) a f) x
          = ((fejerCube H h' : ℝ) : ℂ)
            * pairAvg (basisVec j) (fdiffIter (basisVec j) s h' f) a := by
      intro h'
      rw [pairAvg_eq_integral_fdiffIter]
    rw [integral_congr_ae (Filter.Eventually.of_forall hinner)]
    ring
  rw [hRHS, locUnifPow_swap hH j (s + 1) hf hf1]
  congr 1
  -- the left-hand side, split over the first shift
  have hstep : ∀ h : Fin (s + 1) → ℝ,
      ((fejerCube H h : ℝ) : ℂ) * ∫ x : E3, fdiffIter (basisVec j) (s + 1) h f x
        = ((fejer H (h 0) : ℝ) : ℂ) * ((((fejerCube H (fun i => h i.succ)) : ℝ) : ℂ)
            * pairAvg (basisVec j) (fdiffIter (basisVec j) s (fun i => h i.succ) f) (h 0)) := by
    intro h
    rw [integral_fdiffIter_succ]
    have hc : fejerCube H h = fejer H (h 0) * fejerCube H (fun i => h i.succ) := by
      simp only [fejerCube, Fin.prod_univ_succ]
    rw [hc, Complex.ofReal_mul]
    ring
  rw [integral_congr_ae (Filter.Eventually.of_forall hstep), integral_pi_fin_succ]
  have hsimp : ∀ p : ℝ × (Fin s → ℝ),
      ((fejer H ((Fin.cons p.1 p.2 : Fin (s + 1) → ℝ) 0) : ℝ) : ℂ)
        * ((((fejerCube H (fun i => (Fin.cons p.1 p.2 : Fin (s + 1) → ℝ) i.succ)) : ℝ) : ℂ)
          * pairAvg (basisVec j) (fdiffIter (basisVec j) s
              (fun i => (Fin.cons p.1 p.2 : Fin (s + 1) → ℝ) i.succ) f)
              ((Fin.cons p.1 p.2 : Fin (s + 1) → ℝ) 0))
      = ((fejer H p.1 : ℝ) : ℂ) * (((fejerCube H p.2 : ℝ) : ℂ)
          * pairAvg (basisVec j) (fdiffIter (basisVec j) s p.2 f) p.1) := by
    intro p
    have h2 : (fun i => (Fin.cons p.1 p.2 : Fin (s + 1) → ℝ) i.succ) = p.2 := by
      funext i
      exact Fin.cons_succ _ _ _
    rw [Fin.cons_zero, h2]
  rw [integral_congr_ae (Filter.Eventually.of_forall hsimp),
    MeasureTheory.Measure.volume_eq_prod,
    integral_prod _ (integrable_split_integrand hH (basisVec j) s hf hf1)]
  refine integral_congr_ae (Filter.Eventually.of_forall fun a => ?_)
  change (∫ y : Fin s → ℝ, ((fejer H a : ℝ) : ℂ)
      * (((fejerCube H y : ℝ) : ℂ) * pairAvg (basisVec j) (fdiffIter (basisVec j) s y f) a))
      = ((fejer H a : ℝ) : ℂ) * ∫ h' : Fin s → ℝ, ((fejerCube H h' : ℝ) : ℂ)
          * pairAvg (basisVec j) (fdiffIter (basisVec j) s h' f) a
  rw [← integral_const_mul]



/-! ## Blueprint `lem:degree-lowering-zero`: pigeonholing the last difference

`Auto.locUnifPow_succ_split` writes the `(s+1)`-fold average as a Fejer average over the first
shift. To select a shift the average has to be pigeonholed, which needs the `s`-fold average of the
differenced function to be measurable in that shift and bounded uniformly in it. Both follow from
reading it through `Auto.pairAvg`, where the point integral is already packaged. -/

open MeasureTheory in
/-- The `s`-fold average of the differenced function, read as a pairing -- the form in which its
dependence on the shift is visible. -/
theorem locUnifPow_fdiff_eq {N H : ℝ} (hH : 0 < H) (j : Fin 3) (s : ℕ) {f : E3 → ℂ}
    (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) (a : ℝ) :
    locUnifPow N H j s (fdiff (basisVec j) a f)
      = ((N ^ (6 : ℕ))⁻¹ : ℂ) * ∫ h' : Fin s → ℝ, ((fejerCube H h' : ℝ) : ℂ)
          * pairAvg (basisVec j) (fdiffIter (basisVec j) s h' f) a := by
  rw [locUnifPow_swap hH j s (nice_fdiff _ a hf) (fun y => norm_fdiff_le _ a hf1 y)]
  congr 1
  refine integral_congr_ae (Filter.Eventually.of_forall fun h' => ?_)
  change ((fejerCube H h' : ℝ) : ℂ)
      * ∫ x : E3, fdiffIter (basisVec j) s h' (fdiff (basisVec j) a f) x
      = ((fejerCube H h' : ℝ) : ℂ)
        * pairAvg (basisVec j) (fdiffIter (basisVec j) s h' f) a
  rw [pairAvg_eq_integral_fdiffIter]

/-- The Fejer weight of a cube of shifts is continuous. -/
theorem continuous_fejerCube (H : ℝ) (s : ℕ) :
    Continuous fun h : Fin s → ℝ => fejerCube H h := by
  refine continuous_finsetProd _ fun l _ => ?_
  exact continuous_fejer.comp (continuous_apply l)

open MeasureTheory in
/-- The `s`-fold average of the differenced function is measurable in the shift. -/
theorem measurable_locUnifPow_fdiff {N H : ℝ} (hH : 0 < H) (j : Fin 3) (s : ℕ) {f : E3 → ℂ}
    (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) :
    Measurable fun a : ℝ => (locUnifPow N H j s (fdiff (basisVec j) a f)).re := by
  have hcongr : (fun a : ℝ => (locUnifPow N H j s (fdiff (basisVec j) a f)).re)
      = fun a : ℝ => ((((N ^ (6 : ℕ))⁻¹ : ℂ) * ∫ h' : Fin s → ℝ, ((fejerCube H h' : ℝ) : ℂ)
          * pairAvg (basisVec j) (fdiffIter (basisVec j) s h' f) a)).re := by
    funext a
    rw [locUnifPow_fdiff_eq hH j s hf hf1 a]
  rw [hcongr]
  refine Complex.measurable_re.comp (measurable_const.mul ?_)
  have hjoint : StronglyMeasurable fun p : ℝ × (Fin s → ℝ) =>
      ((fejerCube H p.2 : ℝ) : ℂ)
        * pairAvg (basisVec j) (fdiffIter (basisVec j) s p.2 f) p.1 := by
    refine StronglyMeasurable.mul ?_ (stronglyMeasurable_pairAvg_cube _ s hf.1)
    exact (Complex.continuous_ofReal.comp
      ((continuous_fejerCube H s).comp continuous_snd)).stronglyMeasurable
  exact (hjoint.integral_prod_right' (ν := (volume : Measure (Fin s → ℝ)))).measurable

open MeasureTheory in
/-- **The uniform bound in the shift.** The `s`-fold average of the differenced function is bounded
by the `L^1` norm of the function, normalized -- because the Fejer cube is a probability density and
the pairing is bounded by that norm. -/
theorem norm_locUnifPow_fdiff_le {N H : ℝ} (hH : 0 < H) (j : Fin 3) (s : ℕ) {f : E3 → ℂ}
    (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) (a : ℝ) :
    ‖locUnifPow N H j s (fdiff (basisVec j) a f)‖
      ≤ |((N : ℝ) ^ (6 : ℕ))⁻¹| * ∫ x : E3, ‖f x‖ := by
  classical
  set L : ℝ := ∫ x : E3, ‖f x‖ with hL
  have hL0 : 0 ≤ L := integral_nonneg fun _ => norm_nonneg _
  have hpair : ∀ h' : Fin s → ℝ,
      ‖pairAvg (basisVec j) (fdiffIter (basisVec j) s h' f) a‖ ≤ L := by
    intro h'
    refine le_trans (norm_pairAvg_le _ (nice_fdiffIter _ s h' hf)
      (norm_fdiffIter_le _ s h' hf1) a) ?_
    rw [one_mul, hL]
    exact integral_mono_of_nonneg (Filter.Eventually.of_forall fun x => norm_nonneg _)
      hf.integrable.norm
      (Filter.Eventually.of_forall fun x => norm_fdiffIter_le_self _ s h' hf1 x)
  have hint : ‖∫ h' : Fin s → ℝ, ((fejerCube H h' : ℝ) : ℂ)
      * pairAvg (basisVec j) (fdiffIter (basisVec j) s h' f) a‖ ≤ L := by
    refine le_trans (norm_integral_le_integral_norm _) ?_
    have hmono : (∫ h' : Fin s → ℝ, ‖((fejerCube H h' : ℝ) : ℂ)
        * pairAvg (basisVec j) (fdiffIter (basisVec j) s h' f) a‖)
        ≤ ∫ h' : Fin s → ℝ, fejerCube H h' * L := by
      refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun h' => norm_nonneg _)
        ((integrable_fejerCube hH s).mul_const L)
        (Filter.Eventually.of_forall fun h' => ?_)
      change ‖((fejerCube H h' : ℝ) : ℂ)
          * pairAvg (basisVec j) (fdiffIter (basisVec j) s h' f) a‖ ≤ fejerCube H h' * L
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (fejerCube_nonneg hH h')]
      exact mul_le_mul_of_nonneg_left (hpair h') (fejerCube_nonneg hH h')
    refine le_trans hmono (le_of_eq ?_)
    rw [integral_mul_const, integral_fejerCube hH s, one_mul]
  rw [locUnifPow_fdiff_eq hH j s hf hf1 a, norm_mul]
  refine mul_le_mul_of_nonneg_left hint ?_ |>.trans (le_of_eq ?_)
  · exact norm_nonneg _
  · congr 1
    rw [← Complex.ofReal_pow, ← Complex.ofReal_inv, Complex.norm_real, Real.norm_eq_abs]



/-! ## Patch 3: the slope blocks

`blueprints/task_2_patch_3.tex` replaces the blocked last assertion of `lem:fejer-vdc` by a terminal
configuration theorem, and its first step is to name the object the induction carries. For an
affine configuration with slopes `a i`, the block attached to input `i` after `r` removals is
defined by the recursion of the patch's (eq:blocksucc):
  `G_{i,0}(x) = g_i(x)`,
  `G_{i,r+1}(x; h, h_r) = G_{i,r}(x; h) * conj (G_{i,r}(x + (a_i - a_r) h_r e_j; h))`,

the new shift being appended and the slope gap being against the block removed at stage `r`. Note
that this is the *conjugate* of `Auto.fdiff` applied to the block, not `Auto.fdiff` itself; the
patch's conjugation-convention paragraph addresses the comparison, and the real parts and
integrated Fejer powers agree.

Two bounds come with it: every block is one-bounded, and -- the zero vertex being undisplaced -- it
is dominated by the input it is built from. Those are the patch's `headBlock_norm_le` and the
domination it uses for the `L^2` bound `int |G_{i,r}|^2 <= V`. -/

/-- The block attached to input `i` after `r` removals, by the patch's recursion. -/
noncomputable def headBlock (j : Fin 3) (a : ℕ → ℝ) (g : E3 → ℂ) (i : ℕ) :
    ∀ (r : ℕ), (Fin r → ℝ) → E3 → ℂ
  | 0, _, x => g x
  | (r + 1), h, x =>
      headBlock j a g i r (fun ν : Fin r => h ν.castSucc) x *
        (starRingEnd ℂ) (headBlock j a g i r (fun ν : Fin r => h ν.castSucc)
          (x + ((a i - a r) * h (Fin.last r)) • basisVec j))

theorem headBlock_zero (j : Fin 3) (a : ℕ → ℝ) (g : E3 → ℂ) (i : ℕ) (h : Fin 0 → ℝ) (x : E3) :
    headBlock j a g i 0 h x = g x := rfl

/-- **The block recursion**, the patch's (eq:blocksucc). -/
theorem headBlock_succ (j : Fin 3) (a : ℕ → ℝ) (g : E3 → ℂ) (i r : ℕ)
    (h : Fin (r + 1) → ℝ) (x : E3) :
    headBlock j a g i (r + 1) h x
      = headBlock j a g i r (fun ν : Fin r => h ν.castSucc) x
        * (starRingEnd ℂ) (headBlock j a g i r (fun ν : Fin r => h ν.castSucc)
            (x + ((a i - a r) * h (Fin.last r)) • basisVec j)) := rfl

/-- Every block is one-bounded. -/
theorem headBlock_norm_le (j : Fin 3) (a : ℕ → ℝ) {g : E3 → ℂ} (i : ℕ)
    (hg : ∀ y, ‖g y‖ ≤ 1) :
    ∀ (r : ℕ) (h : Fin r → ℝ) (x : E3), ‖headBlock j a g i r h x‖ ≤ 1
  | 0, _, x => hg x
  | (r + 1), h, x => by
      rw [headBlock_succ, norm_mul, RCLike.norm_conj]
      exact ((mul_le_of_le_one_left (norm_nonneg _) (headBlock_norm_le j a i hg r _ x)).trans
        (headBlock_norm_le j a i hg r _ _))

/-- **The zero vertex is undisplaced**, so the block is dominated by its input. This is what gives
`int |G_{i,r}|^2 <= V` from `int |g_i|^2 <= V`. -/
theorem headBlock_le_self (j : Fin 3) (a : ℕ → ℝ) {g : E3 → ℂ} (i : ℕ)
    (hg : ∀ y, ‖g y‖ ≤ 1) :
    ∀ (r : ℕ) (h : Fin r → ℝ) (x : E3), ‖headBlock j a g i r h x‖ ≤ ‖g x‖
  | 0, _, x => le_of_eq rfl
  | (r + 1), h, x => by
      rw [headBlock_succ, norm_mul, RCLike.norm_conj]
      calc ‖headBlock j a g i r (fun ν : Fin r => h ν.castSucc) x‖
            * ‖headBlock j a g i r (fun ν : Fin r => h ν.castSucc)
                (x + ((a i - a r) * h (Fin.last r)) • basisVec j)‖
          ≤ ‖g x‖ * 1 :=
            mul_le_mul (headBlock_le_self j a i hg r _ x)
              (headBlock_norm_le j a i hg r _ _) (norm_nonneg _) (norm_nonneg _)
        _ = ‖g x‖ := mul_one _

/-- Blocks of a continuous input are continuous. -/
theorem continuous_headBlock (j : Fin 3) (a : ℕ → ℝ) {g : E3 → ℂ} (hg : Continuous g) (i : ℕ) :
    ∀ (r : ℕ) (h : Fin r → ℝ), Continuous (headBlock j a g i r h)
  | 0, _ => hg
  | (r + 1), h => by
      have hprev := continuous_headBlock j a hg i r (fun ν : Fin r => h ν.castSucc)
      refine Continuous.mul hprev ?_
      exact Complex.continuous_conj.comp (hprev.comp (continuous_id.add continuous_const))



/-! ## Patch 3: the closed form of a block

The patch's (eq:block): the block is a cube product over the vertices `omega` of `{0,1}^r`, the
vertex `omega` carrying the shift `sum_{nu<r} omega_nu (a_i - a_nu) h_nu` and a conjugation
according to the parity of `|omega|`. The patch instructs to prove it from the recursion by the
equivalence `{0,1}^{r+1} ≃ {0,1}^r × {0,1}`, the new bit `0` keeping the old term and the bit `1`
translating it and toggling the parity -- and not to deduplicate equal factors, the indexing being a
finite product with multiplicity.

The new shift is appended, so the equivalence needed is the `snoc` counterpart of the existing
`Auto.consBoolEquiv`. -/

/-- Appending a bit, as an equivalence -- the `snoc` counterpart of `Auto.consBoolEquiv`. -/
def snocBoolEquiv (s : ℕ) : (Fin s → Bool) × Bool ≃ (Fin (s + 1) → Bool) where
  toFun p := Fin.snoc p.1 p.2
  invFun ω := (fun i => ω i.castSucc, ω (Fin.last s))
  left_inv p := by
    ext <;> simp
  right_inv ω := by
    funext i
    induction i using Fin.lastCases with
    | last => simp
    | cast i => simp

/-- The number of ones of a vertex -- the patch's `|omega|`. -/
def numTrue {s : ℕ} (ω : Fin s → Bool) : ℕ := ∑ i, if ω i then 1 else 0

theorem numTrue_snoc {s : ℕ} (σ : Fin s → Bool) (b : Bool) :
    numTrue (Fin.snoc σ b) = numTrue σ + (if b then 1 else 0) := by
  rw [numTrue, numTrue, Fin.sum_univ_castSucc]
  simp

/-- The shift carried by a vertex: each chosen coordinate contributes its slope gap times its
shift. -/
noncomputable def slopeShift (a : ℕ → ℝ) (i : ℕ) {r : ℕ} (h : Fin r → ℝ) (ω : Fin r → Bool) : ℝ :=
  ∑ ν : Fin r, if ω ν then (a i - a ν.val) * h ν else 0

theorem slopeShift_snoc (a : ℕ → ℝ) (i : ℕ) {r : ℕ} (h : Fin (r + 1) → ℝ)
    (σ : Fin r → Bool) (b : Bool) :
    slopeShift a i h (Fin.snoc σ b)
      = slopeShift a i (fun ν : Fin r => h ν.castSucc) σ
        + (if b then (a i - a r) * h (Fin.last r) else 0) := by
  rw [slopeShift, slopeShift, Fin.sum_univ_castSucc]
  simp

/-- **The closed form of a block**, the patch's (eq:block). -/
theorem headBlock_cube (j : Fin 3) (a : ℕ → ℝ) (g : E3 → ℂ) (i : ℕ) :
    ∀ (r : ℕ) (h : Fin r → ℝ) (x : E3),
      headBlock j a g i r h x
        = ∏ ω : Fin r → Bool,
            conjPar (numTrue ω) (g (x + slopeShift a i h ω • basisVec j))
  | 0, h, x => by
      rw [headBlock_zero, Fintype.prod_unique]
      simp [numTrue, slopeShift, conjPar]
  | (r + 1), h, x => by
      have IH := fun y : E3 =>
        headBlock_cube j a g i r (fun ν : Fin r => h ν.castSucc) y
      rw [headBlock_succ, IH x, IH (x + ((a i - a r) * h (Fin.last r)) • basisVec j),
        map_prod, ← Finset.prod_mul_distrib,
        ← (snocBoolEquiv r).prod_comp
          fun ω => conjPar (numTrue ω) (g (x + slopeShift a i h ω • basisVec j)),
        Fintype.prod_prod_type]
      refine Finset.prod_congr rfl fun σ _ => ?_
      rw [Fintype.prod_bool]
      have hfalse : numTrue (Fin.snoc σ false) = numTrue σ := by
        rw [numTrue_snoc]
        simp
      have htrue : numTrue (Fin.snoc σ true) = numTrue σ + 1 := by
        rw [numTrue_snoc]
        simp
      have hsf : slopeShift a i h (Fin.snoc σ false)
          = slopeShift a i (fun ν : Fin r => h ν.castSucc) σ := by
        rw [slopeShift_snoc]
        simp
      have hst : slopeShift a i h (Fin.snoc σ true)
          = slopeShift a i (fun ν : Fin r => h ν.castSucc) σ + (a i - a r) * h (Fin.last r) := by
        rw [slopeShift_snoc]
        simp
      have hpt : x + ((a i - a r) * h (Fin.last r)) • basisVec j
            + (slopeShift a i (fun ν : Fin r => h ν.castSucc) σ) • basisVec j
          = x + (slopeShift a i (fun ν : Fin r => h ν.castSucc) σ
              + (a i - a r) * h (Fin.last r)) • basisVec j := by
        rw [add_smul]
        abel
      simp only [snocBoolEquiv, Equiv.coe_fn_mk, hfalse, htrue, hsf, hst, conjPar_succ, hpt]
      ring



/-! ## Patch 3: the state of the induction, and isolating the removed block

The patch's (eq:state):
  `A_r(h) = V^{-1} int_{R^3} E_{t in I} prod_{i=r}^m G_{i,r}(x + a_i t e_j; h) dx`.

Step 2 begins by translating `x` by `-a_r t e_j`, after which the block `G_{r,r}` -- and only that
block -- is independent of the parameter, so Cauchy-Schwarz in the point can remove it. That
translation is the content of `Auto.slopeProd_translate` below.

The removal order is fixed: at stage `r` the block removed is `G_{r,r}`, the `2^r` descendants of
the nuisance input `g_r`, and no block carrying the protected input `g_m` is ever removed. -/

/-- The product of the blocks surviving at stage `r`, each translated by its own slope. -/
noncomputable def slopeProd (j : Fin 3) (a : ℕ → ℝ) (g : ℕ → E3 → ℂ) (m r : ℕ)
    (h : Fin r → ℝ) (x : E3) (t : ℝ) : ℂ :=
  ∏ i ∈ Finset.Icc r m, headBlock j a (g i) i r h (x + (a i * t) • basisVec j)

/-- The state of the patch's induction, (eq:state). -/
noncomputable def slopeState (j : Fin 3) (a : ℕ → ℝ) (g : ℕ → E3 → ℂ) (V N c : ℝ)
    (m r : ℕ) (h : Fin r → ℝ) : ℂ :=
  (V⁻¹ : ℂ) * ∫ x : E3, (N⁻¹ : ℂ) * ∫ t in c..(c + N), slopeProd j a g m r h x t

/-- Every surviving product is one-bounded. -/
theorem norm_slopeProd_le {j : Fin 3} {a : ℕ → ℝ} {g : ℕ → E3 → ℂ}
    (hg : ∀ i y, ‖g i y‖ ≤ 1) (m r : ℕ) (h : Fin r → ℝ) (x : E3) (t : ℝ) :
    ‖slopeProd j a g m r h x t‖ ≤ 1 := by
  rw [slopeProd, norm_prod]
  exact Finset.prod_le_one₀ (fun i _ => norm_nonneg _)
    fun i _ => headBlock_norm_le j a i (hg i) r h _

/-- The index set of the surviving blocks, with the removed one split off. -/
theorem Icc_eq_insert_succ {r m : ℕ} (hrm : r ≤ m) :
    Finset.Icc r m = insert r (Finset.Icc (r + 1) m) := by
  ext i
  simp only [Finset.mem_Icc, Finset.mem_insert]
  omega

/-- **Isolating the removed block.** After translating the point by `-a_r t e_j`, the block
`G_{r,r}` carries no parameter and factors out; every other block is displaced by its slope *gap*
against `a_r`. -/
theorem slopeProd_translate (j : Fin 3) (a : ℕ → ℝ) (g : ℕ → E3 → ℂ) {m r : ℕ} (hrm : r ≤ m)
    (h : Fin r → ℝ) (x : E3) (t : ℝ) :
    slopeProd j a g m r h (x - (a r * t) • basisVec j) t
      = headBlock j a (g r) r r h x
        * ∏ i ∈ Finset.Icc (r + 1) m,
            headBlock j a (g i) i r h (x + ((a i - a r) * t) • basisVec j) := by
  classical
  have hpt : ∀ i : ℕ, x - (a r * t) • basisVec j + (a i * t) • basisVec j
      = x + ((a i - a r) * t) • basisVec j := by
    intro i
    rw [sub_mul, sub_smul]
    abel
  have hnotmem : r ∉ Finset.Icc (r + 1) m := by
    simp only [Finset.mem_Icc, not_and, not_le]
    intro hcon
    omega
  rw [slopeProd, Icc_eq_insert_succ hrm, Finset.prod_insert hnotmem]
  congr 1
  · rw [hpt r]
    simp
  · exact Finset.prod_congr rfl fun i _ => by rw [hpt i]

/-- At the terminal stage only the protected block remains. -/
theorem slopeProd_terminal (j : Fin 3) (a : ℕ → ℝ) (g : ℕ → E3 → ℂ) (m : ℕ)
    (h : Fin m → ℝ) (x : E3) (t : ℝ) :
    slopeProd j a g m m h x t = headBlock j a (g m) m m h (x + (a m * t) • basisVec j) := by
  rw [slopeProd, Finset.Icc_self, Finset.prod_singleton]



/-! ## Patch 3: Cauchy-Schwarz in the point

The patch's step 2 removes the block `G_{r,r}` by Cauchy-Schwarz in the point, and insists that this
is a genuine Cauchy-Schwarz rather than "bounding a complex product by the same product with a
factor deleted".  The inequality needed is the integral form over `E3`, which is not in Mathlib in
a directly usable shape here, so it is built from the quadratic-discriminant argument already in the
file (`Auto.sq_le_of_quadratic_nonneg`), the same device that proves `Auto.sq_setIntegral_le`. -/

open MeasureTheory in
/-- **Cauchy-Schwarz for integrals.** The degenerate case is genuine: when the second factor has
vanishing `L^2` norm it is null, and so is the pairing. -/
theorem sq_integral_mul_le {α : Type*} [MeasurableSpace α] {μ : Measure α} {u v : α → ℝ}
    (hu2 : Integrable (fun x : α => u x ^ 2) μ) (hv2 : Integrable (fun x : α => v x ^ 2) μ)
    (huv : Integrable (fun x : α => u x * v x) μ) :
    (∫ x : α, u x * v x ∂μ) ^ 2 ≤ (∫ x : α, u x ^ 2 ∂μ) * ∫ x : α, v x ^ 2 ∂μ := by
  set I : ℝ := ∫ x : α, u x * v x ∂μ with hI
  set J : ℝ := ∫ x : α, u x ^ 2 ∂μ with hJ
  set W : ℝ := ∫ x : α, v x ^ 2 ∂μ with hW
  have hJ0 : 0 ≤ J := integral_nonneg fun _ => sq_nonneg _
  have hW0 : 0 ≤ W := integral_nonneg fun _ => sq_nonneg _
  rcases eq_or_lt_of_le hW0 with hWz | hWp
  · -- the second factor is null
    have hv0 : (fun x : α => v x ^ 2) =ᵐ[μ] 0 :=
      (integral_eq_zero_iff_of_nonneg (fun x => sq_nonneg (v x)) hv2).mp hWz.symm
    have huv0 : (fun x : α => u x * v x) =ᵐ[μ] 0 := by
      filter_upwards [hv0] with x hx
      have hvx : v x = 0 := by
        have h2 : v x ^ 2 = 0 := hx
        exact sq_eq_zero_iff.mp h2
      simp [hvx]
    have hIz : I = 0 := by
      rw [hI, integral_congr_ae huv0]
      simp
    rw [hIz, ← hWz]
    simp
  · have hexp : ∀ c : ℝ, 0 ≤ J - 2 * c * I + c ^ 2 * W := by
      intro c
      have hnn : 0 ≤ ∫ x : α, (u x - c * v x) ^ 2 ∂μ :=
        integral_nonneg fun _ => sq_nonneg _
      have hcongr : (∫ x : α, (u x - c * v x) ^ 2 ∂μ)
          = ∫ x : α, (u x ^ 2 - 2 * c * (u x * v x) + c ^ 2 * v x ^ 2) ∂μ :=
        integral_congr_ae (Filter.Eventually.of_forall fun x => by ring)
      have hint1 : Integrable (fun x : α => u x ^ 2 - 2 * c * (u x * v x)) μ :=
        hu2.sub (huv.const_mul (2 * c))
      have hint2 : Integrable (fun x : α => c ^ 2 * v x ^ 2) μ := hv2.const_mul (c ^ 2)
      rw [hcongr, integral_add hint1 hint2, integral_sub hu2 (huv.const_mul (2 * c)),
        integral_const_mul, integral_const_mul] at hnn
      linarith [hnn]
    exact le_trans (sq_le_of_quadratic_nonneg hWp hexp) (le_of_eq (mul_comm W J))

open MeasureTheory in
/-- The pairing of two functions is bounded by the geometric mean of their `L^2` norms -- the form
in which the removal step uses Cauchy-Schwarz. -/
theorem sq_norm_integral_mul_le {α : Type*} [MeasurableSpace α] {μ : Measure α} {F G : α → ℂ}
    (hF2 : Integrable (fun x : α => ‖F x‖ ^ 2) μ) (hG2 : Integrable (fun x : α => ‖G x‖ ^ 2) μ)
    (hFG : Integrable (fun x : α => ‖F x‖ * ‖G x‖) μ) :
    ‖∫ x : α, F x * G x ∂μ‖ ^ 2
      ≤ (∫ x : α, ‖F x‖ ^ 2 ∂μ) * ∫ x : α, ‖G x‖ ^ 2 ∂μ := by
  have hstep : ‖∫ x : α, F x * G x ∂μ‖ ≤ ∫ x : α, ‖F x‖ * ‖G x‖ ∂μ := by
    refine le_trans (norm_integral_le_integral_norm _) (le_of_eq ?_)
    exact integral_congr_ae (Filter.Eventually.of_forall fun x => norm_mul _ _)
  calc ‖∫ x : α, F x * G x ∂μ‖ ^ 2 ≤ (∫ x : α, ‖F x‖ * ‖G x‖ ∂μ) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) hstep 2
    _ ≤ (∫ x : α, ‖F x‖ ^ 2 ∂μ) * ∫ x : α, ‖G x‖ ^ 2 ∂μ := sq_integral_mul_le hF2 hG2 hFG



/-! ## Patch 3: the `L^2` bounds on the blocks

The patch records, right after the block definition, that every `G_{i,r}` is one-bounded with zero
vertex `g_i(x)`, so `|G_{i,r}(x)| <= |g_i(x)|` and hence `int |G_{i,r}|^2 <= V`; and that at every
nonterminal stage at least two blocks survive, so their product is integrable with integral at most
`V` by Cauchy-Schwarz. These are the hypotheses the removal step feeds to
`Auto.sq_norm_integral_mul_le`. -/

/-- A product of one-bounded factors is dominated by any one of them. -/
theorem norm_finsetProd_le_single {ι' : Type*} {s : Finset ι'} {F : ι' → ℂ}
    {i₀ : ι'} (hi₀ : i₀ ∈ s) (hF : ∀ i ∈ s, ‖F i‖ ≤ 1) :
    ‖∏ i ∈ s, F i‖ ≤ ‖F i₀‖ := by
  classical
  rw [norm_prod, ← Finset.mul_prod_erase _ _ hi₀]
  calc ‖F i₀‖ * ∏ i ∈ s.erase i₀, ‖F i‖
      ≤ ‖F i₀‖ * 1 :=
        mul_le_mul_of_nonneg_left
          (Finset.prod_le_one₀ (fun i _ => norm_nonneg _)
            fun i hi => hF i (Finset.mem_of_mem_erase hi)) (norm_nonneg _)
    _ = ‖F i₀‖ := mul_one _

open MeasureTheory in
/-- The square of a block is integrable, being dominated by the square of its input. -/
theorem integrable_sq_headBlock (j : Fin 3) (a : ℕ → ℝ) {g : E3 → ℂ} (i : ℕ)
    (hgc : Continuous g) (hg1 : ∀ y, ‖g y‖ ≤ 1)
    (hg2 : Integrable fun x : E3 => ‖g x‖ ^ 2) (r : ℕ) (h : Fin r → ℝ) :
    Integrable fun x : E3 => ‖headBlock j a g i r h x‖ ^ 2 := by
  refine Integrable.mono' hg2
    ((continuous_headBlock j a hgc i r h).norm.pow 2).aestronglyMeasurable
    (Filter.Eventually.of_forall fun x => ?_)
  rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
  exact pow_le_pow_left₀ (norm_nonneg _) (headBlock_le_self j a i hg1 r h x) 2

open MeasureTheory in
/-- **`int |G_{i,r}|^2 <= V`.** The zero vertex is undisplaced, so the block is dominated by its
input. -/
theorem integral_sq_headBlock_le (j : Fin 3) (a : ℕ → ℝ) {g : E3 → ℂ} (i : ℕ)
    (hgc : Continuous g) (hg1 : ∀ y, ‖g y‖ ≤ 1)
    (hg2 : Integrable fun x : E3 => ‖g x‖ ^ 2) (r : ℕ) (h : Fin r → ℝ) :
    (∫ x : E3, ‖headBlock j a g i r h x‖ ^ 2) ≤ ∫ x : E3, ‖g x‖ ^ 2 := by
  refine integral_mono (integrable_sq_headBlock j a i hgc hg1 hg2 r h) hg2 fun x => ?_
  exact pow_le_pow_left₀ (norm_nonneg _) (headBlock_le_self j a i hg1 r h x) 2

open MeasureTheory in
/-- The surviving tail at a nonterminal stage is dominated by the protected block, since the
protected index survives every removal. -/
theorem norm_slopeTail_le (j : Fin 3) (a : ℕ → ℝ) (g : ℕ → E3 → ℂ) {m r : ℕ} (hrm : r < m)
    (hg : ∀ i y, ‖g i y‖ ≤ 1) (h : Fin r → ℝ) (x : E3) (t : ℝ) :
    ‖∏ i ∈ Finset.Icc (r + 1) m,
        headBlock j a (g i) i r h (x + ((a i - a r) * t) • basisVec j)‖
      ≤ ‖headBlock j a (g m) m r h (x + ((a m - a r) * t) • basisVec j)‖ := by
  classical
  refine norm_finsetProd_le_single (Finset.mem_Icc.mpr ⟨by omega, le_refl m⟩) ?_
  intro i _
  exact headBlock_norm_le j a i (hg i) r h _

open MeasureTheory in
/-- Hence the tail is dominated pointwise by the protected input, translated. -/
theorem norm_slopeTail_le_input (j : Fin 3) (a : ℕ → ℝ) (g : ℕ → E3 → ℂ) {m r : ℕ} (hrm : r < m)
    (hg : ∀ i y, ‖g i y‖ ≤ 1) (h : Fin r → ℝ) (x : E3) (t : ℝ) :
    ‖∏ i ∈ Finset.Icc (r + 1) m,
        headBlock j a (g i) i r h (x + ((a i - a r) * t) • basisVec j)‖
      ≤ ‖g m (x + ((a m - a r) * t) • basisVec j)‖ :=
  le_trans (norm_slopeTail_le j a g hrm hg h x t)
    (headBlock_le_self j a m (hg m) r h _)



/-! ## Patch 3: Cauchy-Schwarz against a support of finite measure

Both Cauchy-Schwarz steps of the patch's step 2 have the same shape: a function supported in a set
of finite measure, paired against the constant one. In the point it is the removed block, supported
in the selected box; on the parameter line it is the windowed average `S_u`, supported in an
interval of length `N + H`. Stating it once, for an arbitrary measure space, serves both. -/

open MeasureTheory in
/-- **Cauchy-Schwarz against a support.** A function vanishing off a set of finite measure has
`|int F|^2 <= mu(S) * int |F|^2`. -/
theorem sq_norm_integral_le_measure_mul {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {S : Set α} (hSm : MeasurableSet S) (hSfin : μ S ≠ ⊤) {F : α → ℂ}
    (hsupp : ∀ x, x ∉ S → F x = 0)
    (hF2 : Integrable (fun x : α => ‖F x‖ ^ 2) μ)
    (hFn : Integrable (fun x : α => ‖F x‖) μ) :
    ‖∫ x : α, F x ∂μ‖ ^ 2 ≤ (μ S).toReal * ∫ x : α, ‖F x‖ ^ 2 ∂μ := by
  classical
  have : IsFiniteMeasure (μ.restrict S) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact lt_of_le_of_ne le_top hSfin⟩
  set u : α → ℝ := S.indicator fun _ => (1 : ℝ) with hu
  have hu0 : ∀ x, 0 ≤ u x := fun x => Set.indicator_nonneg (fun _ _ => zero_le_one) x
  have huint : Integrable u μ := by
    rw [hu]
    exact (integrable_indicator_iff hSm).mpr (integrable_const (1 : ℝ))
  have husq : ∀ x, u x ^ 2 = u x := by
    intro x
    by_cases hx : x ∈ S
    · rw [hu, Set.indicator_of_mem hx]
      norm_num
    · rw [hu, Set.indicator_of_notMem hx]
      norm_num
  have hu2 : Integrable (fun x : α => u x ^ 2) μ := by
    refine huint.congr ?_
    exact Filter.Eventually.of_forall fun x => (husq x).symm
  have hint_u2 : (∫ x : α, u x ^ 2 ∂μ) = (μ S).toReal := by
    rw [integral_congr_ae (Filter.Eventually.of_forall husq), hu,
      integral_indicator hSm, setIntegral_const, smul_eq_mul, mul_one, measureReal_def]
  -- the pairing is the plain integral, since `F` vanishes off `S`
  have hpair : ∀ x, u x * ‖F x‖ = ‖F x‖ := by
    intro x
    by_cases hx : x ∈ S
    · rw [hu, Set.indicator_of_mem hx, one_mul]
    · rw [hu, Set.indicator_of_notMem hx, zero_mul, hsupp x hx, norm_zero]
  have huF : Integrable (fun x : α => u x * ‖F x‖) μ := by
    refine hFn.congr ?_
    exact Filter.Eventually.of_forall fun x => (hpair x).symm
  have hcs := sq_integral_mul_le (μ := μ) hu2 hF2 huF
  rw [integral_congr_ae (Filter.Eventually.of_forall hpair), hint_u2] at hcs
  calc ‖∫ x : α, F x ∂μ‖ ^ 2 ≤ (∫ x : α, ‖F x‖ ∂μ) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) (norm_integral_le_integral_norm _) 2
    _ ≤ (μ S).toReal * ∫ x : α, ‖F x‖ ^ 2 ∂μ := hcs



/-! ## Patch 3: the window on the parameter line

The patch's step 2 replaces the parameter average by a window:
  `W_t(x) = 1_I(t) F_t(x)`, `S_u(x) = H^{-1} int_0^H W_{u+s}(x) ds`,

whose `u`-support lies in `I - [0,H]`, an interval of length `N + H`, and whose total integral in
  `u`
is the parameter integral of `F` over `I`. Cauchy-Schwarz in `u` against that support is then
`Auto.sq_norm_integral_le_measure_mul`.

This section defines the window and settles its support and its bound; the identity
`int_R S_u du = int_I F_t dt` is a Fubini step and is taken separately. -/

open MeasureTheory in
/-- The window average of a scalar function on the parameter line. -/
noncomputable def windowAvg (H : ℝ) (W : ℝ → ℂ) (u : ℝ) : ℂ :=
  (H⁻¹ : ℂ) * ∫ s in (0 : ℝ)..H, W (u + s)

open MeasureTheory in
/-- **The window's support.** If the function is carried by `Ioc c (c+N)`, the window is carried by
`Ioc (c-H) (c+N)`, an interval of length `N + H`. -/
theorem windowAvg_eq_zero_of_notMem {H c N : ℝ} (hH : 0 ≤ H) {W : ℝ → ℂ}
    (hsupp : ∀ t, t ∉ Set.Ioc c (c + N) → W t = 0) {u : ℝ}
    (hu : u ∉ Set.Ioc (c - H) (c + N)) : windowAvg H W u = 0 := by
  have hzero : Set.EqOn (fun s : ℝ => W (u + s)) (fun _ : ℝ => (0 : ℂ)) (Set.uIcc 0 H) := by
    intro s hs
    rw [Set.uIcc_of_le hH] at hs
    obtain ⟨hs0, hsH⟩ := hs
    simp only [Set.mem_Ioc, not_and, not_le] at hu
    refine hsupp _ ?_
    simp only [Set.mem_Ioc, not_and, not_le]
    intro hlt
    by_cases h1 : u ≤ c - H
    · linarith
    · push Not at h1
      have h2 := hu h1
      linarith
  rw [windowAvg, intervalIntegral.integral_congr hzero, intervalIntegral.integral_zero,
    mul_zero]

open MeasureTheory in
/-- The window inherits a uniform bound. -/
theorem norm_windowAvg_le {H M : ℝ} (hH : 0 < H) {W : ℝ → ℂ}
    (hW : ∀ t, ‖W t‖ ≤ M) (u : ℝ) : ‖windowAvg H W u‖ ≤ M := by
  have hM0 : 0 ≤ M := le_trans (norm_nonneg _) (hW 0)
  have hb : ∀ s ∈ Set.uIoc (0 : ℝ) H, ‖W (u + s)‖ ≤ M := fun s _ => hW _
  have hint := intervalIntegral.norm_integral_le_of_norm_le_const hb
  rw [sub_zero, abs_of_pos hH] at hint
  rw [windowAvg, norm_mul]
  have hHnorm : ‖(H⁻¹ : ℂ)‖ = H⁻¹ := by
    rw [← Complex.ofReal_inv, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (le_of_lt (inv_pos.mpr hH))]
  rw [hHnorm]
  calc H⁻¹ * ‖∫ s in (0 : ℝ)..H, W (u + s)‖ ≤ H⁻¹ * (M * H) :=
        mul_le_mul_of_nonneg_left hint (le_of_lt (inv_pos.mpr hH))
    _ = M := by field_simp

open MeasureTheory in
/-- The window is measurable in the window variable. -/
theorem measurable_windowAvg {H : ℝ} {W : ℝ → ℂ} (hWi : ∀ p q : ℝ,
    IntervalIntegrable W volume p q) :
    Measurable fun u : ℝ => windowAvg H W u := by
  have hshift : ∀ u : ℝ, (∫ s in (0 : ℝ)..H, W (u + s)) = ∫ t in u..(u + H), W t := by
    intro u
    rw [intervalIntegral.integral_comp_add_left W u]
    norm_num
  have hcongr : (fun u : ℝ => windowAvg H W u)
      = fun u : ℝ => (H⁻¹ : ℂ) * ∫ t in u..(u + H), W t := by
    funext u
    rw [windowAvg, hshift u]
  rw [hcongr]
  refine measurable_const.mul ?_
  have hprim : Measurable fun u : ℝ => ∫ t in (0 : ℝ)..u, W t :=
    (intervalIntegral.continuous_primitive hWi 0).measurable
  have hsplit : ∀ u : ℝ, (∫ t in u..(u + H), W t)
      = (∫ t in (0 : ℝ)..(u + H), W t) - ∫ t in (0 : ℝ)..u, W t := by
    intro u
    rw [← intervalIntegral.integral_interval_sub_left (hWi 0 (u + H)) (hWi 0 u)]
  rw [show (fun u : ℝ => ∫ t in u..(u + H), W t)
      = fun u : ℝ => (∫ t in (0 : ℝ)..(u + H), W t) - ∫ t in (0 : ℝ)..u, W t from
    funext hsplit]
  exact (hprim.comp (measurable_id.add_const H)).sub hprim



/-! ## Patch 3: the window has the same total integral

The patch's `int_R S_u du = int_I F_t dt`. This is Fubini together with translation invariance of
Lebesgue measure, and the joint integrability is genuine work; it is easy here only because the
patch's `W` is bounded and carried by a bounded interval, so the whole exchange happens over a set
of finite measure.

To keep the domination pointwise rather than almost-everywhere, the inner integral is written as an
integral of an indicator over the whole line, which also makes the dominating function a product and
hence integrable on the product measure. -/

open MeasureTheory in
/-- A bounded function carried by a bounded interval is integrable. -/
theorem integrable_of_bdd_support {c N M : ℝ} {W : ℝ → ℂ} (hWm : Measurable W)
    (hWb : ∀ t, ‖W t‖ ≤ M) (hWsupp : ∀ t, t ∉ Set.Ioc c (c + N) → W t = 0) :
    Integrable W := by
  classical
  have hIm : MeasurableSet (Set.Ioc c (c + N)) := measurableSet_Ioc
  have hdom : Integrable ((Set.Ioc c (c + N)).indicator fun _ : ℝ => M) := by
    exact (integrable_indicator_iff hIm).mpr (integrable_const M)
  refine Integrable.mono' hdom hWm.aestronglyMeasurable
    (Filter.Eventually.of_forall fun t => ?_)
  by_cases ht : t ∈ Set.Ioc c (c + N)
  · rw [Set.indicator_of_mem ht]
    exact hWb t
  · rw [Set.indicator_of_notMem ht, hWsupp t ht, norm_zero]

