theorem measurableSet_uhFibSet {F : Fin 3 → Set E3} (hF : ∀ i, MeasurableSet (F i)) (i : Fin 3)
    (y : E3) : MeasurableSet (uhFibSet F i y) :=
  (measurableSet_uhFibPre hF i y).inter measurableSet_uhI

theorem prod_indicator_eq_indicator (F : Fin 3 → Set E3) (i : Fin 3) (y : E3) (t : ℝ) :
    (∏ a ∈ Finset.univ.erase i,
        Set.indicator (F a) (fun _ => (1 : ℝ≥0∞)) (y - curve i t + curve a t))
      = Set.indicator {s : ℝ | ∀ a, a ≠ i → y - curve i s + curve a s ∈ F a}
          (fun _ => (1 : ℝ≥0∞)) t := by
  classical
  by_cases h : t ∈ {s : ℝ | ∀ a, a ≠ i → y - curve i s + curve a s ∈ F a}
  · rw [Set.indicator_of_mem h]
    refine Finset.prod_eq_one fun a ha => ?_
    rw [Set.indicator_of_mem (h a (Finset.ne_of_mem_erase ha))]
  · rw [Set.indicator_of_notMem h]
    simp only [Set.mem_ofPred_eq] at h
    push Not at h
    obtain ⟨a, ha, hmem⟩ := h
    refine Finset.prod_eq_zero (Finset.mem_erase.mpr ⟨ha, Finset.mem_univ a⟩) ?_
    rw [Set.indicator_of_notMem hmem]

open MeasureTheory in
/-- **The fibre function is twice the measure of its fibre set.** -/
theorem uhFib_eq_volume {F : Fin 3 → Set E3} (hF : ∀ i, MeasurableSet (F i)) (i : Fin 3)
    (y : E3) : uhFib F i y = 2 * volume (uhFibSet F i y) := by
  rw [uhFib]
  congr 1
  simp_rw [prod_indicator_eq_indicator F i y]
  rw [lintegral_indicator (measurableSet_uhFibPre hF i y) _, setLIntegral_one,
    Measure.restrict_apply (measurableSet_uhFibPre hF i y)]
  rfl

open MeasureTheory in
/-- **Patch 2 (T1), the first fibre.** -/
theorem uhFibSet_zero_ge {E : Fin 3 → Set E3} (hE : ∀ i, MeasurableSet (E i)) (d : Fin 3)
    {z : E3} (hz : z ∈ uhF3 E d 0) :
    uhAlpha E 0 / 2 / 2 / 2 / 2 ≤ volume (uhFibSet (uhF2 E d) 0 z) := by
  rw [uhF3_zero] at hz
  have h := hz.2
  rw [uhFib_eq_volume (measurableSet_uhF2 hE d) 0 z] at h
  exact enn_le_half_of_two_mul_le h

open MeasureTheory in
/-- **Patch 2 (T1), the second fibre.** -/
theorem uhFibSet_d_ge {E : Fin 3 → Set E3} (hE : ∀ i, MeasurableSet (E i)) {d : Fin 3}
    (hd : d ≠ 0) {z : E3} {u : ℝ} (hu : u ∈ uhFibSet (uhF2 E d) 0 z) :
    uhAlpha E d / 2 / 2 / 2
      ≤ volume (uhFibSet (uhF1 E) d (z - curve 0 u + curve d u)) := by
  have hmem : z - curve 0 u + curve d u ∈ uhF2 E d d := hu.1 d hd
  rw [uhF2_self] at hmem
  have h := hmem.2
  rw [uhFib_eq_volume (measurableSet_uhF1 hE) d _] at h
  exact enn_le_half_of_two_mul_le h

open MeasureTheory in
/-- **Patch 2 (T1), the third fibre.** -/
theorem uhFibSet_third_ge {E : Fin 3 → Set E3} (hE : ∀ i, MeasurableSet (E i)) {d : Fin 3}
    (hd : d ≠ 0) {y : E3} {v : ℝ} (hv : v ∈ uhFibSet (uhF1 E) d y) :
    uhAlpha E 0 / 2 / 2
      ≤ volume (uhFibSet E 0 (y - curve d v + curve 0 v)) := by
  have hmem : y - curve d v + curve 0 v ∈ uhF1 E 0 := hv.1 0 (Ne.symm hd)
  rw [uhF1_zero] at hmem
  have h := hmem.2
  rw [uhFib_eq_volume hE 0 _] at h
  exact enn_le_half_of_two_mul_le h


/-! ### Patch 2 (T2): the parameter set of the tower

The three fibres are assembled into a subset of the parameter cube, with the middle fibre separated
from the first parameter by removing one interval. Tonelli and (T1) give the lower bound
`2^{-10} alpha_1^2 alpha_d`. -/

open MeasureTheory in
theorem measurableSet_memFibSet {F : Fin 3 → Set E3} (hF : ∀ i, MeasurableSet (F i)) (i : Fin 3)
    {α : Type*} [MeasurableSpace α] {g : α → E3} (hg : Measurable g) {h : α → ℝ}
    (hh : Measurable h) : MeasurableSet {p : α | h p ∈ uhFibSet F i (g p)} := by
  have heq : {p : α | h p ∈ uhFibSet F i (g p)}
      = (⋂ a ∈ ({i}ᶜ : Set (Fin 3)),
          {p : α | g p - curve i (h p) + curve a (h p) ∈ F a}) ∩ (h ⁻¹' uhI) := by
    ext p
    simp only [uhFibSet, Set.mem_inter_iff, Set.mem_ofPred_eq, Set.mem_iInter,
      Set.mem_compl_iff, Set.mem_singleton_iff, Set.mem_preimage]
  rw [heq]
  refine MeasurableSet.inter ?_ (hh measurableSet_uhI)
  refine MeasurableSet.biInter (Set.to_countable _) fun a _ => ?_
  exact (hF a).preimage
    ((hg.sub ((continuous_curve i).measurable.comp hh)).add
      ((continuous_curve a).measurable.comp hh))

/-- The point reached after the first move of the tower. -/
noncomputable def uhY1 (d : Fin 3) (z : E3) (u : ℝ) : E3 := z - curve 0 u + curve d u

/-- The point reached after the second move of the tower. -/
noncomputable def uhY2 (d : Fin 3) (z : E3) (u v : ℝ) : E3 :=
  uhY1 d z u - curve d v + curve 0 v

theorem continuous_uhY1 (d : Fin 3) (z : E3) : Continuous (uhY1 d z) :=
  (continuous_const.sub (continuous_curve 0)).add (continuous_curve d)

open MeasureTheory in
/-- The parameter set of the tower, separated in the middle coordinate. -/
noncomputable def uhParam (E : Fin 3 → Set E3) (d : Fin 3) (z : E3) (ε : ℝ) :
    Set (ℝ × ℝ × ℝ) :=
  {p | p.1 ∈ uhFibSet (uhF2 E d) 0 z}
    ∩ {p | p.2.1 ∈ uhFibSet (uhF1 E) d (uhY1 d z p.1)}
    ∩ {p | ε ≤ |p.1 - p.2.1|}
    ∩ {p | p.2.2 ∈ uhFibSet E 0 (uhY2 d z p.1 p.2.1)}

open MeasureTheory in
theorem measurableSet_uhParam {E : Fin 3 → Set E3} (hE : ∀ i, MeasurableSet (E i)) (d : Fin 3)
    (z : E3) (ε : ℝ) : MeasurableSet (uhParam E d z ε) := by
  have hy1 : Measurable fun p : ℝ × ℝ × ℝ => uhY1 d z p.1 :=
    (continuous_uhY1 d z).measurable.comp measurable_fst
  have hy2 : Measurable fun p : ℝ × ℝ × ℝ => uhY2 d z p.1 p.2.1 := by
    have : Measurable fun p : ℝ × ℝ × ℝ => uhY1 d z p.1 - curve d p.2.1 + curve 0 p.2.1 :=
      (hy1.sub ((continuous_curve d).measurable.comp (measurable_fst.comp measurable_snd))).add
        ((continuous_curve 0).measurable.comp (measurable_fst.comp measurable_snd))
    exact this
  refine MeasurableSet.inter (MeasurableSet.inter (MeasurableSet.inter ?_ ?_) ?_) ?_
  · exact measurableSet_memFibSet (measurableSet_uhF2 hE d) 0 measurable_const measurable_fst
  · exact measurableSet_memFibSet (measurableSet_uhF1 hE) d hy1 (measurable_fst.comp measurable_snd)
  · have habs : Measurable fun p : ℝ × ℝ × ℝ => |p.1 - p.2.1| := by fun_prop
    exact measurableSet_le measurable_const habs
  · exact measurableSet_memFibSet hE 0 hy2 (measurable_snd.comp measurable_snd)

open MeasureTheory in
/-- The measure of the interval removed by the separation. -/
theorem volume_sep_interval (u ε : ℝ) :
    volume {v : ℝ | ¬ ε ≤ |u - v|} = ENNReal.ofReal (2 * ε) := by
  have heq : {v : ℝ | ¬ ε ≤ |u - v|} = Set.Ioo (u - ε) (u + ε) := by
    ext v
    simp only [Set.mem_ofPred_eq, not_le, Set.mem_Ioo, abs_lt]
    constructor
    · intro h
      constructor <;> [linarith [h.2]; linarith [h.1]]
    · intro h
      constructor <;> [linarith [h.2]; linarith [h.1]]
  rw [heq, Real.volume_Ioo]
  congr 1
  ring

open MeasureTheory in
/-- **Patch 2 (T2).** The parameter set has measure at least `2^{-10} alpha_1^2 alpha_d`. -/
theorem volume_uhParam_ge {E : Fin 3 → Set E3} (hE : ∀ i, MeasurableSet (E i))
    {d : Fin 3} (hd : d ≠ 0) {z : E3} (hz : z ∈ uhF3 E d 0)
    (hdt : uhAlpha E d / 2 / 2 / 2 / 2 ≠ ⊤) :
    uhAlpha E 0 / 2 / 2 * (uhAlpha E d / 2 / 2 / 2 / 2)
        * (uhAlpha E 0 / 2 / 2 / 2 / 2)
      ≤ volume (uhParam E d z ((uhAlpha E d / 2 / 2 / 2 / 2).toReal / 2)) := by
  classical
  set β : ℝ≥0∞ := uhAlpha E d / 2 / 2 / 2 / 2 with hβ
  set ε : ℝ := β.toReal / 2 with hε
  have h2ε : ENNReal.ofReal (2 * ε) = β := by
    rw [hε]
    have : 2 * (β.toReal / 2) = β.toReal := by ring
    rw [this, ENNReal.ofReal_toReal hdt]
  -- the inner fibre bound
  have hinner : ∀ u ∈ uhFibSet (uhF2 E d) 0 z,
      uhAlpha E 0 / 2 / 2 * β ≤ volume (Prod.mk u ⁻¹' uhParam E d z ε) := by
    intro u hu
    set A : Set ℝ := uhFibSet (uhF1 E) d (uhY1 d z u) ∩ {v : ℝ | ε ≤ |u - v|} with hA
    have habsv : Measurable fun v : ℝ => |u - v| := by fun_prop
    have hAm : MeasurableSet A :=
      (measurableSet_uhFibSet (measurableSet_uhF1 hE) d _).inter
        (measurableSet_le measurable_const habsv)
    have hAvol : β ≤ volume A := by
      have hsub : uhFibSet (uhF1 E) d (uhY1 d z u)
          ⊆ A ∪ {v : ℝ | ¬ ε ≤ |u - v|} := by
        intro v hv
        by_cases hsep : ε ≤ |u - v|
        · exact Or.inl ⟨hv, hsep⟩
        · exact Or.inr hsep
      have hle : uhAlpha E d / 2 / 2 / 2 ≤ volume A + β := by
        calc uhAlpha E d / 2 / 2 / 2
            ≤ volume (uhFibSet (uhF1 E) d (uhY1 d z u)) := uhFibSet_d_ge hE hd hu
          _ ≤ volume (A ∪ {v : ℝ | ¬ ε ≤ |u - v|}) := measure_mono hsub
          _ ≤ volume A + volume {v : ℝ | ¬ ε ≤ |u - v|} := measure_union_le _ _
          _ = volume A + β := by rw [volume_sep_interval u ε, h2ε]
      refine (ENNReal.add_le_add_iff_right hdt).mp ?_
      calc β + β = uhAlpha E d / 2 / 2 / 2 := ENNReal.add_halves _
        _ ≤ volume A + β := hle
    have hTm : MeasurableSet (Prod.mk u ⁻¹' uhParam E d z ε) :=
      (measurableSet_uhParam hE d z ε).preimage measurable_prodMk_left
    have hfib : ∀ v ∈ A, uhAlpha E 0 / 2 / 2
        ≤ volume (Prod.mk v ⁻¹' (Prod.mk u ⁻¹' uhParam E d z ε)) := by
      intro v hv
      have hsub : uhFibSet E 0 (uhY2 d z u v)
          ⊆ Prod.mk v ⁻¹' (Prod.mk u ⁻¹' uhParam E d z ε) := by
        intro w hw
        exact ⟨⟨⟨hu, hv.1⟩, hv.2⟩, hw⟩
      exact le_trans (uhFibSet_third_ge hE hd hv.1) (measure_mono hsub)
    have hkey := measure_prod_ge_of_fibres (μ := (volume : Measure ℝ))
      (ν := (volume : Measure ℝ)) hTm hAm hfib
    calc uhAlpha E 0 / 2 / 2 * β ≤ uhAlpha E 0 / 2 / 2 * volume A := mul_le_mul' le_rfl hAvol
      _ ≤ volume (Prod.mk u ⁻¹' uhParam E d z ε) := by
          rw [Measure.volume_eq_prod]
          exact hkey
  have houter := measure_prod_ge_of_fibres (μ := (volume : Measure ℝ))
    (ν := (volume : Measure (ℝ × ℝ))) (measurableSet_uhParam hE d z ε)
    (measurableSet_uhFibSet (measurableSet_uhF2 hE d) 0 z) hinner
  calc uhAlpha E 0 / 2 / 2 * β * (uhAlpha E 0 / 2 / 2 / 2 / 2)
      ≤ uhAlpha E 0 / 2 / 2 * β * volume (uhFibSet (uhF2 E d) 0 z) :=
        mul_le_mul' le_rfl (uhFibSet_zero_ge hE d hz)
    _ ≤ volume (uhParam E d z ε) := by
        rw [Measure.volume_eq_prod]
        exact houter


/-! ### Patch 2: the polynomial flow

The parameter set is transported from the three-fold product of the line to `R^3`, where the
change-of-variables theorem applies, and the flow is the composition of the three moves of the
tower with a last move into the remaining set. -/

open MeasureTheory in
/-- `R^3` is measure-preservingly the three-fold product of the line. -/
noncomputable def e3ToProd (s : E3) : ℝ × ℝ × ℝ := (s 0, s 1, s 2)

open MeasureTheory in
theorem measurePreserving_E3_prod :
    MeasurePreserving
      (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 0 ∘ (WithLp.ofLp : E3 → (Fin 3 → ℝ)))
      (volume : Measure E3) (volume : Measure (ℝ × (Fin 2 → ℝ))) :=
  (measurePreserving_piFinSucc 2).comp (PiLp.volume_preserving_ofLp (Fin 3))

open MeasureTheory in
theorem measurePreserving_e3ToProd :
    MeasurePreserving e3ToProd (volume : Measure E3) (volume : Measure (ℝ × ℝ × ℝ)) := by
  have hid : MeasurePreserving (id : ℝ → ℝ) volume volume := MeasurePreserving.id _
  have prodStep : ∀ {X Y : Type} [MeasureSpace X] [MeasureSpace Y]
      [SFinite (volume : Measure X)] [SFinite (volume : Measure Y)] (f : X → Y),
      MeasurePreserving f volume volume →
      MeasurePreserving (Prod.map (id : ℝ → ℝ) f) (volume : Measure (ℝ × X))
        (volume : Measure (ℝ × Y)) := by
    intro X Y _ _ _ _ f hf
    rw [Measure.volume_eq_prod, Measure.volume_eq_prod]
    exact hid.prod hf
  have hu : MeasurePreserving (MeasurableEquiv.funUnique (Fin 1) ℝ)
      (volume : Measure (Fin 1 → ℝ)) (volume : Measure ℝ) := volume_preserving_funUnique (Fin 1) ℝ
  have s0 := prodStep _ (prodStep _ hu)
  have s1 := prodStep _ (measurePreserving_piFinSucc 1)
  exact s0.comp (s1.comp measurePreserving_E3_prod)

open MeasureTheory in
theorem measure_e3ToProd_preimage {S : Set (ℝ × ℝ × ℝ)} (hS : MeasurableSet S) :
    volume (e3ToProd ⁻¹' S) = volume S :=
  measurePreserving_e3ToProd.measure_preimage hS.nullMeasurableSet

open MeasureTheory in
theorem measurableSet_e3ToProd_preimage {S : Set (ℝ × ℝ × ℝ)} (hS : MeasurableSet S) :
    MeasurableSet (e3ToProd ⁻¹' S) :=
  measurePreserving_e3ToProd.measurable hS

open MeasureTheory in
/-- **The change of variables for an injective `C^1` map.** -/
theorem lintegral_abs_det_le_of_injOn {f : E3 → E3} {f' : E3 → E3 →L[ℝ] E3} {S T : Set E3}
    (hS : MeasurableSet S) (hf' : ∀ x, HasFDerivAt f (f' x) x) (hinj : Set.InjOn f S)
    (himg : f '' S ⊆ T) :
    (∫⁻ x in S, ENNReal.ofReal |(f' x).det|) ≤ volume T := by
  rw [lintegral_abs_det_fderiv_eq_addHaar_image volume hS
    (fun x _ => (hf' x).hasFDerivWithinAt) hinj]
  exact measure_mono himg

/-- The flow of patch 2: the three moves of the tower followed by the move into the remaining
set. -/
noncomputable def uhFlow (d l : Fin 3) (z : E3) (s : E3) : E3 :=
  uhY2 d z (s 0) (s 1) - curve 0 (s 2) + curve l (s 2)

open MeasureTheory in
/-- **Patch 2: the flow routes the parameter set into the remaining set.** -/
theorem uhFlow_image_subset {E : Fin 3 → Set E3} {d l : Fin 3} (hl : l ≠ 0) (z : E3) (ε : ℝ) :
    uhFlow d l z '' (e3ToProd ⁻¹' uhParam E d z ε) ⊆ E l := by
  rintro y ⟨s, hs, rfl⟩
  have hw : s 2 ∈ uhFibSet E 0 (uhY2 d z (s 0) (s 1)) := hs.2
  exact hw.1 l hl


/-! ### Patch 2 (J1): the Jacobian of the flow

The flow is a translate of a polynomial map of the three parameters. Its two cases, `d = 1` with
`l = 2` and `d = 2` with `l = 1`, have Jacobians `6 w^2 (v - u)` and `6 w (u^2 - v^2)`. -/
theorem det_toEuclideanLin3 (M : Matrix (Fin 3) (Fin 3) ℝ) :
    LinearMap.det (Matrix.toEuclideanLin M : E3 →ₗ[ℝ] E3) = M.det := by
  rw [Matrix.toEuclideanLin_eq_toLin_orthonormal]
  exact LinearMap.det_toLin _ M

/-- The linear part of the flow in coordinates, for `d = 1` and `l = 2`. -/
noncomputable def uhPiA (s : Fin 3 → ℝ) : Fin 3 → ℝ :=
  ![-(s 0) + s 1 - s 2, s 0 ^ 2 - s 1 ^ 2, s 2 ^ 3]

/-- The linear part of the flow in coordinates, for `d = 2` and `l = 1`. -/
noncomputable def uhPiB (s : Fin 3 → ℝ) : Fin 3 → ℝ :=
  ![-(s 0) + s 1 - s 2, s 2 ^ 2, s 0 ^ 3 - s 1 ^ 3]

/-- The Jacobian matrix for `d = 1`, `l = 2`. -/
def uhMatA (u v w : ℝ) : Matrix (Fin 3) (Fin 3) ℝ :=
  !![-1, 1, -1;
     2 * u, -(2 * v), 0;
     0, 0, 3 * w ^ 2]

/-- The Jacobian matrix for `d = 2`, `l = 1`. -/
def uhMatB (u v w : ℝ) : Matrix (Fin 3) (Fin 3) ℝ :=
  !![-1, 1, -1;
     0, 0, 2 * w;
     3 * u ^ 2, -(3 * v ^ 2), 0]

theorem det_uhMatA (u v w : ℝ) : (uhMatA u v w).det = 6 * w ^ 2 * (v - u) := by
  simp [uhMatA, Matrix.det_fin_three]
  ring

theorem det_uhMatB (u v w : ℝ) : (uhMatB u v w).det = 6 * w * (u ^ 2 - v ^ 2) := by
  simp [uhMatB, Matrix.det_fin_three]
  ring

/-- The flow map without the translation, for `d = 1`, `l = 2`. -/
noncomputable def uhMapA (t : E3) : E3 := WithLp.toLp 2 (uhPiA (WithLp.ofLp t))

/-- The flow map without the translation, for `d = 2`, `l = 1`. -/
noncomputable def uhMapB (t : E3) : E3 := WithLp.toLp 2 (uhPiB (WithLp.ofLp t))

noncomputable def uhDerivA (t : E3) : E3 →L[ℝ] E3 :=
  LinearMap.toContinuousLinearMap (Matrix.toEuclideanLin (uhMatA (t 0) (t 1) (t 2)))

noncomputable def uhDerivB (t : E3) : E3 →L[ℝ] E3 :=
  LinearMap.toContinuousLinearMap (Matrix.toEuclideanLin (uhMatB (t 0) (t 1) (t 2)))

theorem det_uhDerivA (t : E3) :
    LinearMap.det ((uhDerivA t : E3 →L[ℝ] E3) : E3 →ₗ[ℝ] E3)
      = 6 * t 2 ^ 2 * (t 1 - t 0) := by
  rw [uhDerivA]
  rw [show ((LinearMap.toContinuousLinearMap
      (Matrix.toEuclideanLin (uhMatA (t 0) (t 1) (t 2))) : E3 →L[ℝ] E3) : E3 →ₗ[ℝ] E3)
      = (Matrix.toEuclideanLin (uhMatA (t 0) (t 1) (t 2)) : E3 →ₗ[ℝ] E3) from rfl]
  rw [det_toEuclideanLin3, det_uhMatA]

theorem det_uhDerivB (t : E3) :
    LinearMap.det ((uhDerivB t : E3 →L[ℝ] E3) : E3 →ₗ[ℝ] E3)
      = 6 * t 2 * (t 0 ^ 2 - t 1 ^ 2) := by
  rw [uhDerivB]
  rw [show ((LinearMap.toContinuousLinearMap
      (Matrix.toEuclideanLin (uhMatB (t 0) (t 1) (t 2))) : E3 →L[ℝ] E3) : E3 →ₗ[ℝ] E3)
      = (Matrix.toEuclideanLin (uhMatB (t 0) (t 1) (t 2)) : E3 →ₗ[ℝ] E3) from rfl]
  rw [det_toEuclideanLin3, det_uhMatB]

theorem hasFDerivAt_uhPiA (s : Fin 3 → ℝ) :
    HasFDerivAt uhPiA
      (LinearMap.toContinuousLinearMap (Matrix.toLin' (uhMatA (s 0) (s 1) (s 2)))) s := by
  have hp : ∀ k : Fin 3, HasFDerivAt (fun x : Fin 3 → ℝ => x k)
      (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℝ) k) s :=
    fun k => hasFDerivAt_apply k s
  refine hasFDerivAt_pi'' fun i => ?_
  fin_cases i
  · refine HasFDerivAt.congr_fderiv (((hp 0).neg.add (hp 1)).sub (hp 2)) ?_
    ext v
    simp [uhMatA, dotProduct, Fin.sum_univ_three]
    ring
  · refine HasFDerivAt.congr_fderiv (((hp 0).pow 2).sub ((hp 1).pow 2)) ?_
    ext v
    simp [uhMatA, dotProduct, Fin.sum_univ_three]
    ring
  · refine HasFDerivAt.congr_fderiv ((hp 2).pow 3) ?_
    ext v
    simp [uhMatA, dotProduct, Fin.sum_univ_three]

theorem hasFDerivAt_uhPiB (s : Fin 3 → ℝ) :
    HasFDerivAt uhPiB
      (LinearMap.toContinuousLinearMap (Matrix.toLin' (uhMatB (s 0) (s 1) (s 2)))) s := by
  have hp : ∀ k : Fin 3, HasFDerivAt (fun x : Fin 3 → ℝ => x k)
      (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 3 => ℝ) k) s :=
    fun k => hasFDerivAt_apply k s
  refine hasFDerivAt_pi'' fun i => ?_
  fin_cases i
  · refine HasFDerivAt.congr_fderiv (((hp 0).neg.add (hp 1)).sub (hp 2)) ?_
    ext v
    simp [uhMatB, dotProduct, Fin.sum_univ_three]
    ring
  · refine HasFDerivAt.congr_fderiv ((hp 2).pow 2) ?_
    ext v
    simp [uhMatB, dotProduct, Fin.sum_univ_three]
  · refine HasFDerivAt.congr_fderiv (((hp 0).pow 3).sub ((hp 1).pow 3)) ?_
    ext v
    simp [uhMatB, dotProduct, Fin.sum_univ_three]
    ring

theorem hasFDerivAt_uhMapA (t : E3) : HasFDerivAt uhMapA (uhDerivA t) t := by
  set e : E3 ≃L[ℝ] (Fin 3 → ℝ) := PiLp.continuousLinearEquiv 2 ℝ (fun _ : Fin 3 => ℝ) with hedef
  have he : HasFDerivAt (⇑e) (e : E3 →L[ℝ] (Fin 3 → ℝ)) t :=
    (e : E3 →L[ℝ] (Fin 3 → ℝ)).hasFDerivAt
  have hsym : HasFDerivAt (⇑e.symm) (e.symm : (Fin 3 → ℝ) →L[ℝ] E3) (uhPiA (e t)) :=
    (e.symm : (Fin 3 → ℝ) →L[ℝ] E3).hasFDerivAt
  have hcomp := hsym.comp t ((hasFDerivAt_uhPiA (e t)).comp t he)
  refine hcomp.congr_fderiv ?_
  ext v k
  rfl

theorem hasFDerivAt_uhMapB (t : E3) : HasFDerivAt uhMapB (uhDerivB t) t := by
  set e : E3 ≃L[ℝ] (Fin 3 → ℝ) := PiLp.continuousLinearEquiv 2 ℝ (fun _ : Fin 3 => ℝ) with hedef
  have he : HasFDerivAt (⇑e) (e : E3 →L[ℝ] (Fin 3 → ℝ)) t :=
    (e : E3 →L[ℝ] (Fin 3 → ℝ)).hasFDerivAt
  have hsym : HasFDerivAt (⇑e.symm) (e.symm : (Fin 3 → ℝ) →L[ℝ] E3) (uhPiB (e t)) :=
    (e.symm : (Fin 3 → ℝ) →L[ℝ] E3).hasFDerivAt
  have hcomp := hsym.comp t ((hasFDerivAt_uhPiB (e t)).comp t he)
  refine hcomp.congr_fderiv ?_
  ext v k
  rfl


/-! ### Patch 2 (J2): injectivity of the flow and the change of variables

Off the diagonal `u = v` the flow is injective: its `l`-coordinate determines `w`, the first
coordinate then determines `v - u`, and the `d`-coordinate determines `u + v`. The change of
variables then turns the lower bound for the Jacobian into a lower bound for the measure of the
remaining set. -/
theorem sq_lt_sq_of_lt_nonneg {x y : ℝ} (hx : 0 ≤ x) (h : x < y) : x ^ 2 < y ^ 2 := by
  nlinarith [hx, h]

theorem cube_lt_cube_of_lt_nonneg {x y : ℝ} (hx : 0 ≤ x) (h : x < y) : x ^ 3 < y ^ 3 := by
  have hy : 0 < y := lt_of_le_of_lt hx h
  have hfac : y ^ 3 - x ^ 3 = (y - x) * (y ^ 2 + x * y + x ^ 2) := by ring
  have hpos : 0 < y ^ 2 + x * y + x ^ 2 := by nlinarith [hy, hx]
  have hmul := mul_pos (sub_pos.mpr h) hpos
  linarith [hfac, hmul]

theorem injOn_const_add3 {f : E3 → E3} {P : Set E3} (z : E3) (h : Set.InjOn f P) :
    Set.InjOn (fun s => z + f s) P := by
  intro a ha b hb hab
  exact h ha hb (by simpa using hab)

theorem uhMapA_zero (s : E3) : uhMapA s 0 = -(s 0) + s 1 - s 2 := rfl
theorem uhMapA_one (s : E3) : uhMapA s 1 = s 0 ^ 2 - s 1 ^ 2 := rfl
theorem uhMapA_two (s : E3) : uhMapA s 2 = s 2 ^ 3 := rfl
theorem uhMapB_zero (s : E3) : uhMapB s 0 = -(s 0) + s 1 - s 2 := rfl
theorem uhMapB_one (s : E3) : uhMapB s 1 = s 2 ^ 2 := rfl
theorem uhMapB_two (s : E3) : uhMapB s 2 = s 0 ^ 3 - s 1 ^ 3 := rfl

theorem uhFlow_eq_uhMapA (z s : E3) : uhFlow 1 2 z s = z + uhMapA s := by
  ext k
  fin_cases k <;>
    simp [uhFlow, uhY2, uhY1, uhMapA, uhPiA, curve_apply, expo] <;> ring

theorem uhFlow_eq_uhMapB (z s : E3) : uhFlow 2 1 z s = z + uhMapB s := by
  ext k
  fin_cases k <;>
    simp [uhFlow, uhY2, uhY1, uhMapB, uhPiB, curve_apply, expo] <;> ring

/-- The domain on which the flow is injective: the parameter cube off the diagonal. -/
def uhOmega : Set E3 := {s | s 0 ∈ uhI ∧ s 1 ∈ uhI ∧ s 2 ∈ uhI ∧ s 0 ≠ s 1}

theorem injOn_uhMapA : Set.InjOn uhMapA uhOmega := by
  intro a ha b hb hab
  have e0 : -(a 0) + a 1 - a 2 = -(b 0) + b 1 - b 2 := by
    rw [← uhMapA_zero, ← uhMapA_zero, hab]
  have e1 : a 0 ^ 2 - a 1 ^ 2 = b 0 ^ 2 - b 1 ^ 2 := by
    rw [← uhMapA_one, ← uhMapA_one, hab]
  have e2 : a 2 ^ 3 = b 2 ^ 3 := by
    rw [← uhMapA_two, ← uhMapA_two, hab]
  have hA : (0 : ℝ) < a 2 := lt_trans (by norm_num) ha.2.2.1.1
  have hB : (0 : ℝ) < b 2 := lt_trans (by norm_num) hb.2.2.1.1
  have h2 : a 2 = b 2 := by
    by_contra hne
    rcases lt_or_gt_of_ne hne with h | h
    · exact absurd e2 (ne_of_lt (cube_lt_cube_of_lt_nonneg hA.le h))
    · exact absurd e2.symm (ne_of_lt (cube_lt_cube_of_lt_nonneg hB.le h))
  have hd : a 0 - a 1 = b 0 - b 1 := by linarith
  have hne : a 0 - a 1 ≠ 0 := sub_ne_zero.mpr ha.2.2.2
  have hs : a 0 + a 1 = b 0 + b 1 := by
    have hfac : (a 0 - a 1) * (a 0 + a 1) = (b 0 - b 1) * (b 0 + b 1) := by
      linear_combination e1
    rw [← hd] at hfac
    exact mul_left_cancel₀ hne hfac
  have h0 : a 0 = b 0 := by linarith
  have h1 : a 1 = b 1 := by linarith
  ext k
  fin_cases k <;> assumption

theorem injOn_uhMapB : Set.InjOn uhMapB uhOmega := by
  intro a ha b hb hab
  have e0 : -(a 0) + a 1 - a 2 = -(b 0) + b 1 - b 2 := by
    rw [← uhMapB_zero, ← uhMapB_zero, hab]
  have e1 : a 2 ^ 2 = b 2 ^ 2 := by
    rw [← uhMapB_one, ← uhMapB_one, hab]
  have e2 : a 0 ^ 3 - a 1 ^ 3 = b 0 ^ 3 - b 1 ^ 3 := by
    rw [← uhMapB_two, ← uhMapB_two, hab]
  have hA : (0 : ℝ) < a 2 := lt_trans (by norm_num) ha.2.2.1.1
  have hB : (0 : ℝ) < b 2 := lt_trans (by norm_num) hb.2.2.1.1
  have h2 : a 2 = b 2 := by
    by_contra hne
    rcases lt_or_gt_of_ne hne with h | h
    · exact absurd e1 (ne_of_lt (sq_lt_sq_of_lt_nonneg hA.le h))
    · exact absurd e1.symm (ne_of_lt (sq_lt_sq_of_lt_nonneg hB.le h))
  have hd : a 0 - a 1 = b 0 - b 1 := by linarith
  have hne : a 0 - a 1 ≠ 0 := sub_ne_zero.mpr ha.2.2.2
  have ha0 : (0 : ℝ) < a 0 := lt_trans (by norm_num) ha.1.1
  have ha1 : (0 : ℝ) < a 1 := lt_trans (by norm_num) ha.2.1.1
  have hb0 : (0 : ℝ) < b 0 := lt_trans (by norm_num) hb.1.1
  have hb1 : (0 : ℝ) < b 1 := lt_trans (by norm_num) hb.2.1.1
  have hsq : (a 0 + a 1) ^ 2 = (b 0 + b 1) ^ 2 := by
    have hfac : (a 0 - a 1) * (a 0 ^ 2 + a 0 * a 1 + a 1 ^ 2)
        = (b 0 - b 1) * (b 0 ^ 2 + b 0 * b 1 + b 1 ^ 2) := by linear_combination e2
    rw [← hd] at hfac
    have hc := mul_left_cancel₀ hne hfac
    nlinarith [hc, hd]
  have hs : a 0 + a 1 = b 0 + b 1 := by
    nlinarith [hsq, ha0, ha1, hb0, hb1]
  have h0 : a 0 = b 0 := by linarith
  have h1 : a 1 = b 1 := by linarith
  ext k
  fin_cases k <;> assumption

open MeasureTheory in
theorem uhParam_preimage_subset_uhOmega {E : Fin 3 → Set E3} {d : Fin 3} {z : E3} {ε : ℝ}
    (hε : 0 < ε) : e3ToProd ⁻¹' uhParam E d z ε ⊆ uhOmega := by
  intro s hs
  refine ⟨hs.1.1.1.2, hs.1.1.2.2, hs.2.2, ?_⟩
  intro heq
  have h := hs.1.2
  simp only [Set.mem_ofPred_eq, e3ToProd] at h
  rw [heq, sub_self, abs_zero] at h
  linarith


theorem det_uhDerivA' (t : E3) : (uhDerivA t).det = 6 * t 2 ^ 2 * (t 1 - t 0) := det_uhDerivA t

theorem det_uhDerivB' (t : E3) : (uhDerivB t).det = 6 * t 2 * (t 0 ^ 2 - t 1 ^ 2) :=
  det_uhDerivB t

open MeasureTheory in
/-- **Patch 2 (J2) for `d = 1`, `l = 2`.** The change of variables turns the lower bound for the
Jacobian into a lower bound for the measure of the remaining set. -/
theorem uhArea_A {E : Fin 3 → Set E3} (hE : ∀ i, MeasurableSet (E i)) (z : E3) {ε : ℝ}
    (hε : 0 < ε) :
    ENNReal.ofReal ε * volume (uhParam E 1 z ε) ≤ volume (E 2) := by
  have hPm : MeasurableSet (e3ToProd ⁻¹' uhParam E 1 z ε) :=
    measurableSet_e3ToProd_preimage (measurableSet_uhParam hE 1 z ε)
  have hPvol : volume (e3ToProd ⁻¹' uhParam E 1 z ε) = volume (uhParam E 1 z ε) :=
    measure_e3ToProd_preimage (measurableSet_uhParam hE 1 z ε)
  have hsub : e3ToProd ⁻¹' uhParam E 1 z ε ⊆ uhOmega := uhParam_preimage_subset_uhOmega hε
  have heq : uhFlow 1 2 z = fun x => z + uhMapA x := funext fun x => uhFlow_eq_uhMapA z x
  have hinj : Set.InjOn (uhFlow 1 2 z) (e3ToProd ⁻¹' uhParam E 1 z ε) := by
    rw [heq]
    exact injOn_const_add3 z (injOn_uhMapA.mono hsub)
  have hfd : ∀ s : E3, HasFDerivAt (uhFlow 1 2 z) (uhDerivA s) s := by
    intro s
    rw [heq]
    exact (hasFDerivAt_uhMapA s).const_add z
  have hkey := lintegral_abs_det_le_of_injOn hPm hfd hinj
    (uhFlow_image_subset (E := E) (d := 1) (l := 2) (by decide) z ε)
  refine le_trans ?_ hkey
  rw [← hPvol]
  calc ENNReal.ofReal ε * volume (e3ToProd ⁻¹' uhParam E 1 z ε)
      = ∫⁻ _s in e3ToProd ⁻¹' uhParam E 1 z ε, ENNReal.ofReal ε := (setLIntegral_const _ _).symm
    _ ≤ ∫⁻ s in e3ToProd ⁻¹' uhParam E 1 z ε, ENNReal.ofReal |(uhDerivA s).det| := by
        refine setLIntegral_mono' hPm fun s hs => ENNReal.ofReal_le_ofReal ?_
        have hs2 : (1 : ℝ) / 2 < s 2 := (hsub hs).2.2.1.1
        have hsep : ε ≤ |s 0 - s 1| := by
          have h := hs.1.2
          simpa [e3ToProd] using h
        rw [det_uhDerivA', abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ 6 * s 2 ^ 2),
          abs_sub_comm]
        have hone : (1 : ℝ) ≤ 6 * s 2 ^ 2 := by nlinarith [hs2]
        have hprod := mul_nonneg (by linarith : (0 : ℝ) ≤ 6 * s 2 ^ 2 - 1)
          (abs_nonneg (s 0 - s 1))
        nlinarith [hsep, hprod]

open MeasureTheory in
/-- **Patch 2 (J2) for `d = 2`, `l = 1`.** -/
theorem uhArea_B {E : Fin 3 → Set E3} (hE : ∀ i, MeasurableSet (E i)) (z : E3) {ε : ℝ}
    (hε : 0 < ε) :
    ENNReal.ofReal ε * volume (uhParam E 2 z ε) ≤ volume (E 1) := by
  have hPm : MeasurableSet (e3ToProd ⁻¹' uhParam E 2 z ε) :=
    measurableSet_e3ToProd_preimage (measurableSet_uhParam hE 2 z ε)
  have hPvol : volume (e3ToProd ⁻¹' uhParam E 2 z ε) = volume (uhParam E 2 z ε) :=
    measure_e3ToProd_preimage (measurableSet_uhParam hE 2 z ε)
  have hsub : e3ToProd ⁻¹' uhParam E 2 z ε ⊆ uhOmega := uhParam_preimage_subset_uhOmega hε
  have heq : uhFlow 2 1 z = fun x => z + uhMapB x := funext fun x => uhFlow_eq_uhMapB z x
  have hinj : Set.InjOn (uhFlow 2 1 z) (e3ToProd ⁻¹' uhParam E 2 z ε) := by
    rw [heq]
    exact injOn_const_add3 z (injOn_uhMapB.mono hsub)
  have hfd : ∀ s : E3, HasFDerivAt (uhFlow 2 1 z) (uhDerivB s) s := by
    intro s
    rw [heq]
    exact (hasFDerivAt_uhMapB s).const_add z
  have hkey := lintegral_abs_det_le_of_injOn hPm hfd hinj
    (uhFlow_image_subset (E := E) (d := 2) (l := 1) (by decide) z ε)
  refine le_trans ?_ hkey
  rw [← hPvol]
  calc ENNReal.ofReal ε * volume (e3ToProd ⁻¹' uhParam E 2 z ε)
      = ∫⁻ _s in e3ToProd ⁻¹' uhParam E 2 z ε, ENNReal.ofReal ε := (setLIntegral_const _ _).symm
    _ ≤ ∫⁻ s in e3ToProd ⁻¹' uhParam E 2 z ε, ENNReal.ofReal |(uhDerivB s).det| := by
        refine setLIntegral_mono' hPm fun s hs => ENNReal.ofReal_le_ofReal ?_
        have hs0 : (1 : ℝ) / 2 < s 0 := (hsub hs).1.1
        have hs1 : (1 : ℝ) / 2 < s 1 := (hsub hs).2.1.1
        have hs2 : (1 : ℝ) / 2 < s 2 := (hsub hs).2.2.1.1
        have hsep : ε ≤ |s 0 - s 1| := by
          have h := hs.1.2
          simpa [e3ToProd] using h
        have hfac : |s 0 ^ 2 - s 1 ^ 2| = |s 0 - s 1| * (s 0 + s 1) := by
          rw [show s 0 ^ 2 - s 1 ^ 2 = (s 0 - s 1) * (s 0 + s 1) by ring, abs_mul,
            abs_of_pos (by linarith : (0 : ℝ) < s 0 + s 1)]
        rw [det_uhDerivB', abs_mul, abs_of_nonneg (by linarith : (0 : ℝ) ≤ 6 * s 2), hfac]
        have hsum : (1 : ℝ) < s 0 + s 1 := by linarith
        have hone : (1 : ℝ) ≤ 6 * s 2 * (s 0 + s 1) := by nlinarith [hs2, hsum]
        have hprod := mul_nonneg (by linarith : (0 : ℝ) ≤ 6 * s 2 * (s 0 + s 1) - 1)
          (abs_nonneg (s 0 - s 1))
        nlinarith [hsep, hprod]


/-! ### Patch 2 (R): the restricted three-set estimate

Combining the tower bound (T2) with the area bound (J2) and substituting the densities gives
`K^4 <= 2^15 |E_1|^2 |E_d|^2 |E_ell|`, whose fourth root is the patch's (R). -/

open MeasureTheory in
theorem volume_uhI : volume uhI = ENNReal.ofReal (1 / 2) := by
  rw [uhI, Real.volume_Ioc]
  norm_num

open MeasureTheory in
theorem uhFib_le_one {F : Fin 3 → Set E3} (hF : ∀ i, MeasurableSet (F i)) (i : Fin 3) (y : E3) :
    uhFib F i y ≤ 1 := by
  rw [uhFib_eq_volume hF i y]
  calc 2 * volume (uhFibSet F i y) ≤ 2 * volume uhI :=
        mul_le_mul' le_rfl (measure_mono Set.inter_subset_right)
    _ = 1 := by
        rw [volume_uhI, show (1 / 2 : ℝ) = (2 : ℝ)⁻¹ by norm_num,
          ENNReal.ofReal_inv_of_pos (by norm_num)]
        norm_num
        exact ENNReal.mul_inv_cancel (by norm_num) (by norm_num)

open MeasureTheory in
theorem uhInc_le_volume {E : Fin 3 → Set E3} (hE : ∀ i, MeasurableSet (E i)) (i : Fin 3) :
    uhInc E ≤ volume (E i) := by
  rw [uhInc_eq_setLIntegral hE i]
  calc (∫⁻ y in E i, uhFib E i y) ≤ ∫⁻ _y in E i, 1 :=
        setLIntegral_mono' (hE i) fun y _ => uhFib_le_one hE i y
    _ = volume (E i) := setLIntegral_one _

theorem uh_const_arith {K a0 ad m0 md : ℝ≥0∞} (h0 : a0 * m0 = K) (hd : ad * md = K) :
    2 ^ (15 : ℕ) * m0 ^ (2 : ℕ) * md ^ (2 : ℕ)
        * (ad / 2 / 2 / 2 / 2 / 2 * (a0 / 2 / 2 * (ad / 2 / 2 / 2 / 2)
          * (a0 / 2 / 2 / 2 / 2))) = K ^ (4 : ℕ) := by
  have hinv : (2 : ℝ≥0∞) ^ (15 : ℕ) * ((2 : ℝ≥0∞)⁻¹) ^ (15 : ℕ) = 1 := by
    rw [← mul_pow, ENNReal.mul_inv_cancel (by norm_num) (by norm_num), one_pow]
  have hx : ad / 2 / 2 / 2 / 2 / 2 * (a0 / 2 / 2 * (ad / 2 / 2 / 2 / 2)
      * (a0 / 2 / 2 / 2 / 2)) = a0 * a0 * (ad * ad) * ((2 : ℝ≥0∞)⁻¹) ^ (15 : ℕ) := by
    simp only [div_eq_mul_inv]
    ring
  rw [hx]
  calc 2 ^ (15 : ℕ) * m0 ^ (2 : ℕ) * md ^ (2 : ℕ)
        * (a0 * a0 * (ad * ad) * ((2 : ℝ≥0∞)⁻¹) ^ (15 : ℕ))
      = 2 ^ (15 : ℕ) * ((2 : ℝ≥0∞)⁻¹) ^ (15 : ℕ) * ((a0 * m0) ^ (2 : ℕ) * (ad * md) ^ (2 : ℕ)) := by
        ring
    _ = K ^ (4 : ℕ) := by
        rw [hinv, h0, hd, one_mul, ← pow_add]

open MeasureTheory in
/-- **Patch 2 (R), the power form.** The fourth power of the incidence integral. -/
theorem uhInc_pow_four_le {E : Fin 3 → Set E3} (hE : ∀ i, MeasurableSet (E i))
    (h0 : ∀ i, volume (E i) ≠ 0) (ht : ∀ i, volume (E i) ≠ ⊤)
    {d l : Fin 3} (hdl : (d = 1 ∧ l = 2) ∨ (d = 2 ∧ l = 1)) :
    uhInc E ^ (4 : ℕ)
      ≤ 2 ^ (15 : ℕ) * (volume (E 0) ^ (2 : ℕ) * volume (E d) ^ (2 : ℕ) * volume (E l)) := by
  rcases eq_or_ne (uhInc E) 0 with hK0 | hK0
  · rw [hK0]
    simp
  have hKt : uhInc E ≠ ⊤ := ne_top_of_le_ne_top (ht 0) (uhInc_le_volume hE 0)
  have hd0 : d ≠ 0 := by rcases hdl with ⟨rfl, -⟩ | ⟨rfl, -⟩ <;> decide
  have hAd : uhAlpha E d ≠ 0 := by
    rw [uhAlpha]
    exact ENNReal.div_ne_zero.mpr ⟨hK0, ht d⟩
  have hAdt : uhAlpha E d ≠ ⊤ := ENNReal.div_ne_top hKt (h0 d)
  have hβ0 : uhAlpha E d / 2 / 2 / 2 / 2 ≠ 0 := by
    simp only [ne_eq, ENNReal.div_eq_zero_iff, not_or]
    refine ⟨⟨⟨⟨hAd, by norm_num⟩, by norm_num⟩, by norm_num⟩, by norm_num⟩
  have hβt : uhAlpha E d / 2 / 2 / 2 / 2 ≠ ⊤ := by
    refine ENNReal.div_ne_top (ENNReal.div_ne_top (ENNReal.div_ne_top
      (ENNReal.div_ne_top hAdt (by norm_num)) (by norm_num)) (by norm_num)) (by norm_num)
  obtain ⟨z, hz⟩ := uhF3_zero_nonempty hE h0 ht hKt hK0 hd0
  have hεpos : 0 < (uhAlpha E d / 2 / 2 / 2 / 2).toReal / 2 := by
    have := ENNReal.toReal_pos hβ0 hβt
    linarith
  have hofε : ENNReal.ofReal ((uhAlpha E d / 2 / 2 / 2 / 2).toReal / 2)
      = uhAlpha E d / 2 / 2 / 2 / 2 / 2 := by
    rw [ENNReal.ofReal_div_of_pos (by norm_num), ENNReal.ofReal_toReal hβt]
    norm_num
  have hT2 := volume_uhParam_ge hE hd0 hz hβt
  have hJ2 : ENNReal.ofReal ((uhAlpha E d / 2 / 2 / 2 / 2).toReal / 2)
      * volume (uhParam E d z ((uhAlpha E d / 2 / 2 / 2 / 2).toReal / 2)) ≤ volume (E l) := by
    rcases hdl with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact uhArea_A hE z hεpos
    · exact uhArea_B hE z hεpos
  have hchain : uhAlpha E d / 2 / 2 / 2 / 2 / 2
      * (uhAlpha E 0 / 2 / 2 * (uhAlpha E d / 2 / 2 / 2 / 2)
        * (uhAlpha E 0 / 2 / 2 / 2 / 2)) ≤ volume (E l) := by
    rw [← hofε]
    exact le_trans (mul_le_mul' le_rfl hT2) hJ2
  have harith := uh_const_arith (uhAlpha_mul (h0 0) (ht 0)) (uhAlpha_mul (h0 d) (ht d))
  calc uhInc E ^ (4 : ℕ)
      = 2 ^ (15 : ℕ) * volume (E 0) ^ (2 : ℕ) * volume (E d) ^ (2 : ℕ)
          * (uhAlpha E d / 2 / 2 / 2 / 2 / 2
            * (uhAlpha E 0 / 2 / 2 * (uhAlpha E d / 2 / 2 / 2 / 2)
              * (uhAlpha E 0 / 2 / 2 / 2 / 2))) := harith.symm
    _ ≤ 2 ^ (15 : ℕ) * volume (E 0) ^ (2 : ℕ) * volume (E d) ^ (2 : ℕ) * volume (E l) :=
        mul_le_mul' le_rfl hchain
    _ = 2 ^ (15 : ℕ) * (volume (E 0) ^ (2 : ℕ) * volume (E d) ^ (2 : ℕ) * volume (E l)) := by
        ring


open MeasureTheory in
/-- **Patch 2 `lem:three-set-restricted-upper-half` (R).** The restricted three-set estimate for
the upper-half monomial average. -/
theorem uhInc_le_restricted {E : Fin 3 → Set E3} (hE : ∀ i, MeasurableSet (E i))
    (h0 : ∀ i, volume (E i) ≠ 0) (ht : ∀ i, volume (E i) ≠ ⊤)
    {d l : Fin 3} (hdl : (d = 1 ∧ l = 2) ∨ (d = 2 ∧ l = 1)) :
    uhInc E ≤ 16 * (volume (E 0) ^ ((2 : ℝ)⁻¹) * volume (E d) ^ ((2 : ℝ)⁻¹)
      * volume (E l) ^ ((4 : ℝ)⁻¹)) := by
  have hz : (0 : ℝ) ≤ (4 : ℝ)⁻¹ := by norm_num
  have hroot := ENNReal.rpow_le_rpow (uhInc_pow_four_le hE h0 ht hdl) hz
  have e4 : ((4 : ℕ) : ℝ) * (4 : ℝ)⁻¹ = 1 := by norm_num
  have e2 : ((2 : ℕ) : ℝ) * (4 : ℝ)⁻¹ = (2 : ℝ)⁻¹ := by norm_num
  have hL : (uhInc E ^ (4 : ℕ)) ^ ((4 : ℝ)⁻¹) = uhInc E := by
    rw [← ENNReal.rpow_natCast (uhInc E) 4, ← ENNReal.rpow_mul, e4, ENNReal.rpow_one]
  have hR : ((2 : ℝ≥0∞) ^ (15 : ℕ)
        * (volume (E 0) ^ (2 : ℕ) * volume (E d) ^ (2 : ℕ) * volume (E l))) ^ ((4 : ℝ)⁻¹)
      = (2 : ℝ≥0∞) ^ (((15 : ℕ) : ℝ) * (4 : ℝ)⁻¹)
        * (volume (E 0) ^ ((2 : ℝ)⁻¹) * volume (E d) ^ ((2 : ℝ)⁻¹)
          * volume (E l) ^ ((4 : ℝ)⁻¹)) := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ hz, ENNReal.mul_rpow_of_nonneg _ _ hz,
      ENNReal.mul_rpow_of_nonneg _ _ hz,
      ← ENNReal.rpow_natCast (2 : ℝ≥0∞) 15, ← ENNReal.rpow_mul,
      ← ENNReal.rpow_natCast (volume (E 0)) 2, ← ENNReal.rpow_mul,
      ← ENNReal.rpow_natCast (volume (E d)) 2, ← ENNReal.rpow_mul, e2]
  rw [hL, hR] at hroot
  refine le_trans hroot (mul_le_mul' ?_ le_rfl)
  have h16 : (16 : ℝ≥0∞) = 2 ^ (((4 : ℕ) : ℝ)) := by
    rw [ENNReal.rpow_natCast]
    norm_num
  rw [h16]
  exact ENNReal.rpow_le_rpow_of_exponent_le (by norm_num) (by norm_num)


/-! ### The monomial average over an arbitrary parameter interval

Patch 2 works with the upper-half average `Atilde 1`, whose parameter interval is `(1/2, 1]`. The
admissibility proofs for `Auto.A` use nothing about the interval `(0, N]`, so they are restated
here for an arbitrary interval and an arbitrary normalizing constant; both `Auto.A` and
`Auto.Atilde` are instances. -/

/-- The monomial average over the interval `a..b`, normalized by `c`. -/
noncomputable def Aint (a b : ℝ) (c : ℂ) (f : Fin 3 → E3 → ℂ) (x : E3) : ℂ :=
  c * ∫ t in a..b, prodShift f x t

theorem A_eq_Aint (N : ℝ) : A N = Aint 0 N (N : ℂ)⁻¹ := rfl

theorem Atilde_eq_Aint (N : ℝ) : Atilde N = Aint (N / 2) N (2 * (N : ℂ)⁻¹) := by
  funext f x
  rw [Atilde, Aint, mul_assoc]

theorem Aint_ofReal (a b : ℝ) (c : ℂ) (u : Fin 3 → E3 → ℝ) (x : E3) :
    Aint a b c (fun i y => ((u i y : ℝ) : ℂ)) x
      = c * ((∫ t in a..b, prodShiftR u x t : ℝ) : ℂ) := by
  rw [Aint]
  congr 1
  simp_rw [prodShift_ofReal]
  rw [intervalIntegral.integral_ofReal]

open MeasureTheory in
theorem trilin_Aint (a b : ℝ) (c : ℂ) : Trilin (Aint a b c) := by
  classical
  intro i g u v cc hg hu hv
  funext x
  simp only [Aint]
  simp_rw [prodShift_update]
  have hring : ∀ t : ℝ, (cc * u (x + curve i t) + v (x + curve i t))
        * ∏ l ∈ Finset.univ.erase i, g l (x + curve l t)
      = cc * (u (x + curve i t) * ∏ l ∈ Finset.univ.erase i, g l (x + curve l t))
        + v (x + curve i t) * ∏ l ∈ Finset.univ.erase i, g l (x + curve l t) := by
    intro t
    ring
  simp_rw [hring]
  rw [intervalIntegral.integral_add ((intervalIntegrable_slot hg hu i x a b).const_mul cc)
    (intervalIntegrable_slot hg hv i x a b), intervalIntegral.integral_const_mul]
  ring

open MeasureTheory in
theorem mono3_Aint {a b : ℝ} (hab : a ≤ b) (c : ℂ) : Mono3 (Aint a b c) := by
  intro u v hu hv huv x
  have hun : ∀ i y, 0 ≤ u i y := fun i y => (hu i).2.1 y
  have h0u : 0 ≤ ∫ t in a..b, prodShiftR u x t :=
    intervalIntegral.integral_nonneg hab fun t _ => prodShiftR_nonneg hun x t
  have hle : (∫ t in a..b, prodShiftR u x t) ≤ ∫ t in a..b, prodShiftR v x t :=
    intervalIntegral.integral_mono_on hab (intervalIntegrable_prodShiftR hu x a b)
      (intervalIntegrable_prodShiftR hv x a b) fun t _ => prodShiftR_mono hun huv x t
  rw [Aint_ofReal, Aint_ofReal, norm_mul, norm_mul, Complex.norm_real, Complex.norm_real,
    Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg h0u, abs_of_nonneg (le_trans h0u hle)]
  exact mul_le_mul_of_nonneg_left hle (norm_nonneg _)

open MeasureTheory in
theorem measurable_intervalIntegral_prodShiftR' {a b : ℝ} (hab : a ≤ b) {u : Fin 3 → E3 → ℝ}
    (hu : ∀ i, Measurable (u i)) :
    Measurable fun x => ∫ t in a..b, prodShiftR u x t := by
  have hm : Measurable fun p : E3 × ℝ => prodShiftR u p.1 p.2 := by
    simp only [prodShiftR]
    exact Finset.measurable_prod _ fun i _ =>
      (hu i).comp (measurable_fst.add ((continuous_curve i).measurable.comp measurable_snd))
  have heq : (fun x => ∫ t in a..b, prodShiftR u x t)
      = fun x => ∫ t in Set.Ioc a b, prodShiftR u x t := by
    funext x
    exact intervalIntegral.integral_of_le hab
  rw [heq]
  exact hm.stronglyMeasurable.integral_prod_right'.measurable

open MeasureTheory in
theorem measFun_Aint {a b : ℝ} (hab : a ≤ b) (c : ℂ) (u : Fin 3 → E3 → ℝ)
    (hum : ∀ i, Measurable (u i)) : Measurable (Aint a b c fun i y => ((u i y : ℝ) : ℂ)) := by
  have heq : (Aint a b c fun i y => ((u i y : ℝ) : ℂ))
      = fun x => c * ((∫ t in a..b, prodShiftR u x t : ℝ) : ℂ) :=
    funext fun x => Aint_ofReal a b c u x
  rw [heq]
  exact measurable_const.mul
    (Complex.measurable_ofReal.comp (measurable_intervalIntegral_prodShiftR' hab hum))

open MeasureTheory in
theorem measInd_Aint {a b : ℝ} (hab : a ≤ b) (c : ℂ) (E : Fin 3 → Set E3)
    (hE : ∀ i, MeasurableSet (E i)) :
    AEStronglyMeasurable (Aint a b c (indicators E)) volume := by
  rw [indicators_eq_ofReal]
  exact (measFun_Aint hab c _ fun i => measurable_const.indicator (hE i)).aestronglyMeasurable

open MeasureTheory in
theorem null3_Aint {a b : ℝ} (hab : a ≤ b) (c : ℂ) : Null3 (Aint a b c) := by
  intro E hE
  obtain ⟨i, hi⟩ := hE
  obtain ⟨F, hEF, hFm, hF0⟩ := exists_measurable_superset_of_null hi
  have hjoint : Measurable fun q : E3 × ℝ =>
      Set.indicator F (fun _ => (1 : ℝ≥0∞)) (q.1 + curve i q.2) :=
    (measurable_const.indicator hFm).comp
      (measurable_fst.add ((continuous_curve i).measurable.comp measurable_snd))
  have hslice : ∀ t : ℝ, (∫⁻ x, Set.indicator F (fun _ => (1 : ℝ≥0∞)) (x + curve i t)) = 0 := by
    intro t
    rw [lintegral_add_right_eq_self (fun x => Set.indicator F (fun _ => (1 : ℝ≥0∞)) x)
      (curve i t), lintegral_indicator hFm _, setLIntegral_one, hF0]
  have htot : (∫⁻ x, ∫⁻ t in Set.Ioc a b,
      Set.indicator F (fun _ => (1 : ℝ≥0∞)) (x + curve i t)) = 0 := by
    rw [lintegral_lintegral_swap hjoint.aemeasurable]
    simp only [hslice]
    simp
  have hae := (lintegral_eq_zero_iff hjoint.lintegral_prod_right').mp htot
  filter_upwards [hae] with x hx
  have hx0 : (fun t => Set.indicator F (fun _ => (1 : ℝ≥0∞)) (x + curve i t))
      =ᵐ[volume.restrict (Set.Ioc a b)] 0 :=
    (lintegral_eq_zero_iff (hjoint.comp (measurable_const.prodMk measurable_id))).mp hx
  have hzero : ∀ᵐ t ∂(volume.restrict (Set.Ioc a b)),
      prodShift (indicators E) x t = 0 := by
    filter_upwards [hx0] with t ht
    have hnot : x + curve i t ∉ F := by
      intro hmem
      rw [Set.indicator_of_mem hmem] at ht
      exact one_ne_zero ht
    have hzeroi : indicators E i (x + curve i t) = 0 := by
      rw [indicators, Set.indicator_of_notMem fun hc => hnot (hEF hc)]
    rw [prodShift, Finset.prod_eq_zero (Finset.mem_univ i) hzeroi]
  have hI : (∫ t in a..b, prodShift (indicators E) x t) = 0 := by
    rw [intervalIntegral.integral_of_le hab]
    exact integral_eq_zero_of_ae hzero
  rw [Pi.zero_apply, Aint, hI, mul_zero]

open MeasureTheory in
theorem lim3_Aint {a b : ℝ} (hab : a ≤ b) (c : ℂ) : Lim3 (Aint a b c) := by
  intro uu v huu hvm hvn hle htend x
  have huun : ∀ (k : ℕ) (i : Fin 3) (y : E3), 0 ≤ uu k i y := fun k i y => (huu k i).2.1 y
  by_cases hint : IntervalIntegrable (prodShiftR v x) volume a b
  · left
    have hcast : ∀ u : Fin 3 → E3 → ℝ, (Aint a b c fun i y => ((u i y : ℝ) : ℂ)) x
        = c * ((∫ t in a..b, prodShiftR u x t : ℝ) : ℂ) := fun u => Aint_ofReal a b c u x
    simp only [hcast]
    refine Filter.Tendsto.const_mul _ (Complex.continuous_ofReal.continuousAt.tendsto.comp ?_)
    rw [intervalIntegral.integral_of_le hab]
    have hdom : Integrable (prodShiftR v x) (volume.restrict (Set.Ioc a b)) :=
      (intervalIntegrable_iff_integrableOn_Ioc_of_le hab).mp hint
    have hmeask : ∀ k, AEStronglyMeasurable (prodShiftR (uu k) x)
        (volume.restrict (Set.Ioc a b)) := fun k =>
      (measurable_prodShiftR (fun i => (huu k i).1) x).aestronglyMeasurable
    have hbound : ∀ k, ∀ᵐ t ∂(volume.restrict (Set.Ioc a b)),
        ‖prodShiftR (uu k) x t‖ ≤ prodShiftR v x t := by
      intro k
      refine Filter.Eventually.of_forall fun t => ?_
      rw [Real.norm_eq_abs, abs_of_nonneg (prodShiftR_nonneg (huun k) x t)]
      exact Finset.prod_le_prod₀ (fun l _ => huun k l _) fun l _ => hle k l _
    have hlim : ∀ᵐ t ∂(volume.restrict (Set.Ioc a b)),
        Filter.Tendsto (fun k => prodShiftR (uu k) x t) Filter.atTop
          (nhds (prodShiftR v x t)) := by
      refine Filter.Eventually.of_forall fun t => ?_
      simp only [prodShiftR]
      exact tendsto_finsetProd _ fun l _ => htend l _
    have := MeasureTheory.tendsto_integral_of_dominated_convergence _ hmeask hdom hbound hlim
    simpa [intervalIntegral.integral_of_le hab] using this
  · right
    rw [Aint_ofReal a b c v x, intervalIntegral.integral_undef hint]
    simp

open MeasureTheory in
theorem modC_Aint {a b : ℝ} (hab : a ≤ b) (c : ℂ) (f : Fin 3 → E3 → ℂ) (x : E3) :
    ‖Aint a b c f x‖ ≤ ‖Aint a b c (fun i y => ((‖f i y‖ : ℝ) : ℂ)) x‖ := by
  set w : Fin 3 → E3 → ℝ := fun i y => ‖f i y‖ with hw
  have hnn : ∀ (i : Fin 3) (y : E3), 0 ≤ w i y := fun i y => norm_nonneg _
  have hnorm : ∀ t : ℝ, ‖prodShift f x t‖ = prodShiftR w x t := by
    intro t
    rw [prodShift, prodShiftR, norm_prod]
  have hI0 : 0 ≤ ∫ t in a..b, prodShiftR w x t :=
    intervalIntegral.integral_nonneg hab fun t _ => prodShiftR_nonneg hnn x t
  have hle : ‖∫ t in a..b, prodShift f x t‖ ≤ ∫ t in a..b, prodShiftR w x t := by
    refine le_trans (intervalIntegral.norm_integral_le_integral_norm hab) (le_of_eq ?_)
    exact intervalIntegral.integral_congr fun t _ => hnorm t
  rw [Aint, Aint_ofReal, norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg hI0]
  exact mul_le_mul_of_nonneg_left hle (norm_nonneg _)

open MeasureTheory in
theorem measurable_Aint {a b : ℝ} (hab : a ≤ b) (c : ℂ) {f : Fin 3 → E3 → ℂ}
    (hf : ∀ i, Measurable (f i)) : Measurable (Aint a b c f) := by
  have hm : Measurable fun p : E3 × ℝ => prodShift f p.1 p.2 := by
    simp only [prodShift]
    exact Finset.measurable_prod _ fun i _ =>
      (hf i).comp (measurable_fst.add ((continuous_curve i).measurable.comp measurable_snd))
  have heq : Aint a b c f = fun x => c * ∫ t in Set.Ioc a b, prodShift f x t := by
    funext x
    rw [Aint, intervalIntegral.integral_of_le hab]
  rw [heq]
  exact measurable_const.mul hm.stronglyMeasurable.integral_prod_right'.measurable

open MeasureTheory in
/-- The monomial average over any interval is admissible. -/
@[fun_prop] theorem measurable_Atilde_one {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Measurable (f i)) :
    Measurable (Atilde 1 f) := by
  rw [Atilde_eq_Aint]
  exact measurable_Aint (by norm_num) _ hf

open MeasureTheory in
theorem admissible_Aint {a b : ℝ} (hab : a ≤ b) (c : ℂ) : Admissible (Aint a b c) where
  lin := trilin_Aint a b c
  mono := mono3_Aint hab c
  null := null3_Aint hab c
  measInd := measInd_Aint hab c
  measFun := fun u hum _ => measFun_Aint hab c u hum
  limit := lim3_Aint hab c
  measComplex := fun _ hf => measurable_Aint hab c hf
  modC := fun f _ x => modC_Aint hab c f x

open MeasureTheory in
theorem admissible_Atilde_one : Admissible (Atilde 1) := by
  rw [Atilde_eq_Aint]
  exact admissible_Aint (by norm_num) _


/-! ### Patch 2: the incidence integral is the `L^1` norm of the upper-half average

This identifies the quantity `K` of the patch with the `L^1` norm of the output on indicators, so
that (R) is literally a restricted strong estimate at `q = 1`. -/

open MeasureTheory in
theorem enorm_Atilde_indicators {E : Fin 3 → Set E3} (hE : ∀ i, MeasurableSet (E i)) (x : E3) :
    ‖Atilde 1 (indicators E) x‖ₑ
      = 2 * ∫⁻ t in uhI, ∏ i, Set.indicator (E i) (fun _ => (1 : ℝ≥0∞)) (x + curve i t) := by
  set ind : Fin 3 → E3 → ℝ := fun i => Set.indicator (E i) fun _ => (1 : ℝ) with hind
  have hbm : ∀ i, BddMeas (ind i) := fun i => bddMeas_indicator (hE i)
  have hnn : ∀ (i : Fin 3) (y : E3), 0 ≤ ind i y := fun i y => (hbm i).2.1 y
  have hI0 : 0 ≤ ∫ t in (1 / 2 : ℝ)..1, prodShiftR ind x t :=
    intervalIntegral.integral_nonneg (by norm_num) fun t _ => prodShiftR_nonneg hnn x t
  have hr : ‖Atilde 1 (indicators E) x‖ = 2 * ∫ t in (1 / 2 : ℝ)..1, prodShiftR ind x t := by
    rw [indicators_eq_ofReal, Atilde_eq_Aint, Aint_ofReal, norm_mul, Complex.norm_real,
      Real.norm_eq_abs, abs_of_nonneg hI0]
    norm_num
  have hlin : ENNReal.ofReal (∫ t in (1 / 2 : ℝ)..1, prodShiftR ind x t)
      = ∫⁻ t in uhI, ∏ i, Set.indicator (E i) (fun _ => (1 : ℝ≥0∞)) (x + curve i t) := by
    rw [uhI, intervalIntegral.integral_of_le (by norm_num),
      ofReal_integral_eq_lintegral_ofReal (intervalIntegrable_prodShiftR hbm x (1 / 2) 1).1
        (Filter.Eventually.of_forall fun t => prodShiftR_nonneg hnn x t)]
    exact lintegral_congr fun t => ofReal_prodShiftR_indicator x t
  rw [← ofReal_norm, hr, ENNReal.ofReal_mul (by norm_num), hlin]
  norm_num

open MeasureTheory in
/-- **The incidence integral is the `L^1` norm of the upper-half average on indicators.** -/
theorem eLpNorm_Atilde_indicators {E : Fin 3 → Set E3} (hE : ∀ i, MeasurableSet (E i)) :
    eLpNorm (Atilde 1 (indicators E)) 1 volume = uhInc E := by
  have hjoint : Measurable fun p : E3 × ℝ =>
      ∏ i, Set.indicator (E i) (fun _ => (1 : ℝ≥0∞)) (p.1 + curve i p.2) :=
    Finset.measurable_prod _ fun i _ =>
      (measurable_const.indicator (hE i)).comp
        (measurable_fst.add ((continuous_curve i).measurable.comp measurable_snd))
  rw [eLpNorm_one_eq_lintegral_enorm (f := Atilde 1 (indicators E))
    (measurable_Atilde_one (fun i => measurable_const.indicator (hE i))).aestronglyMeasurable]
  simp_rw [enorm_Atilde_indicators hE]
  rw [lintegral_const_mul' _ _ (by norm_num), uhInc]
  congr 1
  exact lintegral_lintegral_swap hjoint.aemeasurable

/-- The exponent vector of the patch's restricted estimate: `1/4` at the terminal index and `1/2`
elsewhere. -/
noncomputable def uhV (l : Fin 3) : Fin 3 → ℝ := fun i => if i = l then 1 / 4 else 1 / 2

open MeasureTheory in
/-- **Patch 2 (R) as a restricted strong estimate at `q = 1`.** -/
theorem restrictedStrong_Atilde_uhV {d l : Fin 3}
    (hdl : (d = 1 ∧ l = 2) ∨ (d = 2 ∧ l = 1)) :
    RestrictedStrong (Atilde 1) (uhV l) 1 16 := by
  intro E hE h0 ht
  have hprod : (∏ i, volume (E i) ^ uhV l i)
      = volume (E 0) ^ ((2 : ℝ)⁻¹) * volume (E d) ^ ((2 : ℝ)⁻¹)
        * volume (E l) ^ ((4 : ℝ)⁻¹) := by
    rcases hdl with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · simp [uhV, Fin.prod_univ_three]
    · simp [uhV, Fin.prod_univ_three]
      ring
  rw [show (ENNReal.ofReal 1 : ℝ≥0∞) = 1 by simp, eLpNorm_Atilde_indicators hE, hprod]
  exact uhInc_le_restricted hE h0 ht hdl

open MeasureTheory in
/-- The three trivial vertices for the upper-half average. -/
theorem restrictedStrong_Atilde_trivial (i : Fin 3) :
    RestrictedStrong (Atilde 1) (trivialVertex i) 1 1 := by
  intro E hE _ _
  have hprod : (∏ j, volume (E j) ^ trivialVertex i j) = volume (E i) := by
    match i with
    | 0 => simp [trivialVertex, Fin.prod_univ_three]
    | 1 => simp [trivialVertex, Fin.prod_univ_three]
    | 2 => simp [trivialVertex, Fin.prod_univ_three]
  rw [show (ENNReal.ofReal 1 : ℝ≥0∞) = 1 by simp, eLpNorm_Atilde_indicators hE, hprod, one_mul]
  exact uhInc_le_volume hE i


/-! ### Patch 2 (S1): the barycentric combination

Any exponent vector of the tetrahedron spanned by the patch's `v` and the three standard vectors
carries a restricted strong `L^1` estimate with constant `16`, by convex combination. -/

open MeasureTheory in
/-- The restricted strong estimate at every point of the simplex, for an abstract operator. -/
theorem restrictedStrong_simplex {T : (Fin 3 → E3 → ℂ) → E3 → ℂ} {q : ℝ}
    (hT : ∀ i, RestrictedStrong T (trivialVertex i) q 1)
    {w : Fin 3 → ℝ} (hw : ∀ i, 0 ≤ w i) (hsum : w 0 + w 1 + w 2 = 1) :
    RestrictedStrong T w q 1 := by
  set t : ℝ := w 1 + w 2 with ht
  have ht0 : 0 ≤ t := add_nonneg (hw 1) (hw 2)
  have ht1 : t ≤ 1 := by
    rw [ht]
    linarith [hw 0, hsum]
  rcases eq_or_lt_of_le ht0 with hteq | htpos
  · have hw1 : w 1 = 0 := by
      have h : w 1 + w 2 = 0 := by rw [← ht, ← hteq]
      linarith [hw 1, hw 2]
    have hw2 : w 2 = 0 := by
      have h : w 1 + w 2 = 0 := by rw [← ht, ← hteq]
      linarith [hw 1, hw 2]
    have hw0 : w 0 = 1 := by linarith [hsum]
    refine (hT 0).congr ?_ rfl
    funext i
    fin_cases i <;> simp [trivialVertex] <;> linarith
  · set s : ℝ := w 2 / t with hs
    have hs0 : 0 ≤ s := div_nonneg (hw 2) htpos.le
    have hs1 : s ≤ 1 := by
      rw [hs, div_le_one htpos, ht]
      linarith [hw 1]
    have hw2t : s * t = w 2 := by
      rw [hs]
      field_simp
    have hw1t : (1 - s) * t = w 1 := by
      have hexp : (1 - s) * t = t - s * t := by ring
      rw [hexp, hw2t, ht]
      ring
    have h12 := restrictedStrong_combine (T := T) (θ := s) hs0 hs1 (hT 1) (hT 2)
    have h := restrictedStrong_combine (T := T) (θ := t) ht0 ht1 (hT 0) h12
    refine h.congr ?_ (by simp)
    funext i
    fin_cases i <;> simp [trivialVertex] <;> linarith

open MeasureTheory in
/-- **Patch 2 (S1).** Every point `tau * v + lam` of the tetrahedron carries the restricted strong
`L^1` estimate with constant `16`. -/
theorem restrictedStrong_Atilde_combo {d l : Fin 3}
    (hdl : (d = 1 ∧ l = 2) ∨ (d = 2 ∧ l = 1)) {τ : ℝ} {lam : Fin 3 → ℝ}
    (hτ0 : 0 ≤ τ) (hτ1 : τ ≤ 1) (hlam : ∀ i, 0 ≤ lam i)
    (hsum : τ + lam 0 + lam 1 + lam 2 = 1) :
    RestrictedStrong (Atilde 1) (fun i => τ * uhV l i + lam i) 1 16 := by
  have hv := restrictedStrong_Atilde_uhV hdl
  rcases eq_or_lt_of_le hτ1 with hτeq | hτlt
  · have h0 : lam 0 = 0 := by linarith [hlam 0, hlam 1, hlam 2]
    have h1 : lam 1 = 0 := by linarith [hlam 0, hlam 1, hlam 2]
    have h2 : lam 2 = 0 := by linarith [hlam 0, hlam 1, hlam 2]
    refine hv.congr ?_ rfl
    funext i
    fin_cases i <;> simp [hτeq, h0, h1, h2]
  · set S : ℝ := 1 - τ with hS
    have hS0 : 0 < S := by rw [hS]; linarith
    set w : Fin 3 → ℝ := fun i => lam i / S with hw
    have hwnn : ∀ i, 0 ≤ w i := fun i => div_nonneg (hlam i) hS0.le
    have hwsum : w 0 + w 1 + w 2 = 1 := by
      rw [hw]
      field_simp
      linarith
    have hsimp : RestrictedStrong (Atilde 1) w 1 1 :=
      restrictedStrong_simplex restrictedStrong_Atilde_trivial hwnn hwsum
    have hcomb := restrictedStrong_combine (T := Atilde 1) (θ := τ) hτ0 hτ1 hsimp hv
    refine (hcomb.congr ?_ rfl).mono_const ?_
    · funext i
      have : (1 - τ) * w i = lam i := by
        rw [hw, ← hS]
        field_simp
      rw [this]
      ring
    · rw [ENNReal.one_rpow, one_mul]
      calc (16 : ℝ≥0∞) ^ τ ≤ (16 : ℝ≥0∞) ^ (1 : ℝ) :=
            ENNReal.rpow_le_rpow_of_exponent_le (by norm_num) hτ1
        _ = 16 := ENNReal.rpow_one 16



/-! ### Patch 2 (S1) at the eight cone vectors

The barycentric coefficients of the patch, `tau = 4 (sum c - 1)` and `lam_i = c_i - tau v_i`, are
positive at each of the eight perturbations of the target by `1/64`. -/

/-- The exponent vectors of the target for the three distinguished inputs. -/
noncomputable def uhB : Fin 3 → Fin 3 → ℝ :=
  ![![1 / 2, 3 / 8, 1 / 4], ![3 / 8, 1 / 2, 1 / 4], ![3 / 8, 1 / 4, 1 / 2]]

/-- The middle index of the routing, for each distinguished input. -/
def uhD : Fin 3 → Fin 3 := ![1, 1, 2]

/-- The terminal index of the routing, for each distinguished input. -/
def uhL : Fin 3 → Fin 3 := ![2, 2, 1]

theorem uhDL (j : Fin 3) : (uhD j = 1 ∧ uhL j = 2) ∨ (uhD j = 2 ∧ uhL j = 1) := by
  fin_cases j <;> simp [uhD, uhL]

open MeasureTheory in
/-- **Patch 2 (S1) in barycentric form.** -/
theorem restrictedStrong_Atilde_of_coeffs {d l : Fin 3}
    (hdl : (d = 1 ∧ l = 2) ∨ (d = 2 ∧ l = 1)) {c : Fin 3 → ℝ}
    (hτ0 : 0 ≤ 4 * (c 0 + c 1 + c 2 - 1)) (hτ1 : 4 * (c 0 + c 1 + c 2 - 1) ≤ 1)
    (hlam : ∀ i, 0 ≤ c i - 4 * (c 0 + c 1 + c 2 - 1) * uhV l i) :
    RestrictedStrong (Atilde 1) c 1 16 := by
  have hsum : 4 * (c 0 + c 1 + c 2 - 1)
      + (c 0 - 4 * (c 0 + c 1 + c 2 - 1) * uhV l 0)
      + (c 1 - 4 * (c 0 + c 1 + c 2 - 1) * uhV l 1)
      + (c 2 - 4 * (c 0 + c 1 + c 2 - 1) * uhV l 2) = 1 := by
    rcases hdl with ⟨-, rfl⟩ | ⟨-, rfl⟩ <;>
      · simp [uhV]
        ring
  have h := restrictedStrong_Atilde_combo hdl hτ0 hτ1 hlam hsum
  refine h.congr ?_ rfl
  funext i
  ring

open MeasureTheory in
/-- **Patch 2: the restricted strong estimate at the eight cone vectors.** -/
theorem restrictedStrong_Atilde_cone (j : Fin 3) (n : Fin 3 → ℤ) :
    RestrictedStrong (Atilde 1) (coneVec (uhB j) (1 / 64) n) 1 16 := by
  refine restrictedStrong_Atilde_of_coeffs (uhDL j) ?_ ?_ ?_
  · fin_cases j <;> by_cases h0 : (0 : ℤ) ≤ n 0 <;> by_cases h1 : (0 : ℤ) ≤ n 1 <;>
      by_cases h2 : (0 : ℤ) ≤ n 2 <;>
      simp [coneVec, coneExp, uhB, h0, h1, h2, Matrix.cons_val_two, Matrix.tail_cons] <;>
      norm_num
  · fin_cases j <;> by_cases h0 : (0 : ℤ) ≤ n 0 <;> by_cases h1 : (0 : ℤ) ≤ n 1 <;>
      by_cases h2 : (0 : ℤ) ≤ n 2 <;>
      simp [coneVec, coneExp, uhB, h0, h1, h2, Matrix.cons_val_two, Matrix.tail_cons] <;>
      norm_num
  · intro i
    fin_cases j <;> fin_cases i <;> by_cases h0 : (0 : ℤ) ≤ n 0 <;>
      by_cases h1 : (0 : ℤ) ≤ n 1 <;> by_cases h2 : (0 : ℤ) ≤ n 2 <;>
      simp [coneVec, coneExp, uhB, uhV, uhL, h0, h1, h2, Matrix.cons_val_two,
        Matrix.tail_cons] <;>
      norm_num



/-! ### Patch 2 (S): the strong `L^1` bound

The finite Marcinkiewicz lemma turns the eight cone estimates into the estimate for normalized
inputs, and scaling each slot removes the normalization. -/
theorem Aint_smul_slots (a b : ℝ) (cst : ℂ) (c : Fin 3 → ℂ) (f : Fin 3 → E3 → ℂ) (x : E3) :
    Aint a b cst (fun i y => c i * f i y) x = (∏ i, c i) * Aint a b cst f x := by
  have h : ∀ t : ℝ, prodShift (fun i y => c i * f i y) x t = (∏ i, c i) * prodShift f x t := by
    intro t
    rw [prodShift, prodShift, ← Finset.prod_mul_distrib]
  rw [Aint, Aint]
  simp_rw [h]
  rw [intervalIntegral.integral_const_mul]
  ring

open MeasureTheory in
theorem Aint_ae_zero_of_slot_ae_zero {a b : ℝ} (hab : a ≤ b) (cst : ℂ) {f : Fin 3 → E3 → ℂ}
    {i : Fin 3} (hfm : ∀ l, Measurable (f l)) (hi : f i =ᵐ[volume] 0) :
    Aint a b cst f =ᵐ[volume] 0 := by
  have hZm : MeasurableSet {y : E3 | f i y ≠ 0} := by
    have h : MeasurableSet {y : E3 | f i y = 0} := (hfm i) (measurableSet_singleton (0 : ℂ))
    have h2 := h.compl
    rwa [Set.compl_ofPred] at h2
  have hZ0 : volume {y : E3 | f i y ≠ 0} = 0 := by
    have h := hi
    rw [Filter.EventuallyEq, ae_iff] at h
    simpa using h
  have hjoint : Measurable fun q : E3 × ℝ =>
      Set.indicator {y : E3 | f i y ≠ 0} (fun _ => (1 : ℝ≥0∞)) (q.1 + curve i q.2) :=
    (measurable_const.indicator hZm).comp
      (measurable_fst.add ((continuous_curve i).measurable.comp measurable_snd))
  have hslice : ∀ t : ℝ, (∫⁻ x, Set.indicator {y : E3 | f i y ≠ 0}
      (fun _ => (1 : ℝ≥0∞)) (x + curve i t)) = 0 := by
    intro t
    rw [lintegral_add_right_eq_self
      (fun x => Set.indicator {y : E3 | f i y ≠ 0} (fun _ => (1 : ℝ≥0∞)) x) (curve i t),
      lintegral_indicator hZm _, setLIntegral_one, hZ0]
  have htot : (∫⁻ x, ∫⁻ t in Set.Ioc a b,
      Set.indicator {y : E3 | f i y ≠ 0} (fun _ => (1 : ℝ≥0∞)) (x + curve i t)) = 0 := by
    rw [lintegral_lintegral_swap hjoint.aemeasurable]
    simp only [hslice]
    simp
  have hae := (lintegral_eq_zero_iff hjoint.lintegral_prod_right').mp htot
  filter_upwards [hae] with x hx
  have hx0 : (fun t => Set.indicator {y : E3 | f i y ≠ 0} (fun _ => (1 : ℝ≥0∞))
      (x + curve i t)) =ᵐ[volume.restrict (Set.Ioc a b)] 0 :=
    (lintegral_eq_zero_iff (hjoint.comp (measurable_const.prodMk measurable_id))).mp hx
  have hzero : ∀ᵐ t ∂(volume.restrict (Set.Ioc a b)), prodShift f x t = 0 := by
    filter_upwards [hx0] with t ht
    have hnot : x + curve i t ∉ {y : E3 | f i y ≠ 0} := by
      intro hmem
      rw [Set.indicator_of_mem hmem] at ht
      exact one_ne_zero ht
    have hzeroi : f i (x + curve i t) = 0 := by simpa using hnot
    rw [prodShift, Finset.prod_eq_zero (Finset.mem_univ i) hzeroi]
  have hI : (∫ t in a..b, prodShift f x t) = 0 := by
    rw [intervalIntegral.integral_of_le hab]
    exact integral_eq_zero_of_ae hzero
  rw [Pi.zero_apply, Aint, hI, mul_zero]

open MeasureTheory in
/-- **Removing the normalization**, for an operator that scales with its slots and vanishes when
one of them does. -/
theorem eLpNorm_normalize {T : (Fin 3 → E3 → ℂ) → E3 → ℂ} {C : ℝ≥0∞} (hC0 : C ≠ 0)
    {q : ℝ} {p : Fin 3 → ℝ} (hp : ∀ i, 0 < p i)
    (hsmul : ∀ (c : Fin 3 → ℂ) (g : Fin 3 → E3 → ℂ) (x : E3),
      T (fun i y => c i * g i y) x = (∏ i, c i) * T g x)
    (hzero : ∀ (g : Fin 3 → E3 → ℂ) (i : Fin 3), (∀ l, Measurable (g l)) →
      g i =ᵐ[volume] 0 → T g =ᵐ[volume] 0)
    (hmain : ∀ g : Fin 3 → E3 → ℂ, (∀ i, Measurable (g i)) →
      (∀ i, eLpNorm (g i) (ENNReal.ofReal (p i)) volume ≤ 1) →
      eLpNorm (T g) (ENNReal.ofReal q) volume ≤ C)
    (f : Fin 3 → E3 → ℂ) (hf : ∀ i, Measurable (f i)) :
    eLpNorm (T f) (ENNReal.ofReal q) volume
      ≤ C * ∏ i, eLpNorm (f i) (ENNReal.ofReal (p i)) volume := by
  classical
  have hpne : ∀ i, ENNReal.ofReal (p i) ≠ 0 := fun i => (ENNReal.ofReal_pos.mpr (hp i)).ne'
  by_cases hzz : ∃ i, eLpNorm (f i) (ENNReal.ofReal (p i)) volume = 0
  · obtain ⟨i, hi⟩ := hzz
    have hfi : f i =ᵐ[volume] 0 :=
      (eLpNorm_eq_zero_iff (hpne i)).mp hi
    rw [eLpNorm_congr_ae (hzero f i hf hfi)]
    simp
  push Not at hzz
  by_cases htop : ∃ i, eLpNorm (f i) (ENNReal.ofReal (p i)) volume = ⊤
  · obtain ⟨i, hi⟩ := htop
    have hprod : (∏ j, eLpNorm (f j) (ENNReal.ofReal (p j)) volume) = ⊤ := by
      rw [Fin.prod_univ_three]
      match i with
      | 0 => rw [hi, ENNReal.top_mul (hzz 1), ENNReal.top_mul (hzz 2)]
      | 1 => rw [hi, ENNReal.mul_top (hzz 0), ENNReal.top_mul (hzz 2)]
      | 2 => rw [hi, ENNReal.mul_top (mul_ne_zero (hzz 0) (hzz 1))]
    rw [hprod, ENNReal.mul_top hC0]
    exact le_top
  push Not at htop
  have hrpos : ∀ i, 0 < (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal := fun i =>
    ENNReal.toReal_pos (hzz i) (htop i)
  have hra : ∀ i, ENNReal.ofReal (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal
      = eLpNorm (f i) (ENNReal.ofReal (p i)) volume := fun i => ENNReal.ofReal_toReal (htop i)
  have hgm : ∀ i, Measurable fun y =>
      (((eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹ : ℝ) : ℂ) * f i y :=
    fun i => measurable_const.mul (hf i)
  have hgnorm : ∀ i, eLpNorm (fun y =>
      (((eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹ : ℝ) : ℂ) * f i y)
        (ENNReal.ofReal (p i)) volume = 1 := by
    intro i
    have hc : ‖((((eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹ : ℝ)) : ℂ)‖ₑ
        = ENNReal.ofReal (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹ := by
      rw [← ofReal_norm, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (by positivity : (0 : ℝ)
          ≤ (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹)]
    have hstep : ENNReal.ofReal (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹
        = (eLpNorm (f i) (ENNReal.ofReal (p i)) volume)⁻¹ := by
      rw [ENNReal.ofReal_inv_of_pos (hrpos i), hra i]
    rw [eLpNorm_const_mul', hc, hstep, ENNReal.inv_mul_cancel (hzz i) (htop i)]
  have hkey := hmain _ hgm fun i => le_of_eq (hgnorm i)
  have hAg : (T fun i y =>
      (((eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹ : ℝ) : ℂ) * f i y)
      = fun x => (∏ i, (((eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹ : ℝ) : ℂ))
        * T f x := by
    funext x
    exact hsmul _ f x
  have hnormc : ‖(∏ i, (((eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹ : ℝ) : ℂ))‖ₑ
      = ENNReal.ofReal (∏ i, (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹) := by
    rw [← ofReal_norm, norm_prod]
    congr 1
    refine Finset.prod_congr rfl fun i _ => ?_
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by positivity : (0 : ℝ)
      ≤ (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹)]
  rw [hAg, eLpNorm_const_mul', hnormc] at hkey
  have hmul := mul_le_mul'
    (le_refl (ENNReal.ofReal (∏ i, (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal))) hkey
  have hone : ENNReal.ofReal (∏ i, (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal)
      * ENNReal.ofReal (∏ i, (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹) = 1 := by
    have hcan : (∏ i, (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal)
        * (∏ i, (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹) = 1 := by
      rw [← Finset.prod_mul_distrib]
      exact Finset.prod_eq_one fun i _ => mul_inv_cancel₀ (hrpos i).ne'
    rw [← ENNReal.ofReal_mul (Finset.prod_nonneg fun i _ => (hrpos i).le), hcan,
      ENNReal.ofReal_one]
  rw [← mul_assoc, hone, one_mul] at hmul
  have hprodr : ENNReal.ofReal (∏ i, (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal)
      = ∏ i, eLpNorm (f i) (ENNReal.ofReal (p i)) volume := by
    rw [ENNReal.ofReal_prod_of_nonneg fun i _ => (hrpos i).le]
    exact Finset.prod_congr rfl fun i _ => hra i
  rw [hprodr, mul_comm] at hmul
  exact hmul



/-- The constant of patch 2's strong `L^1` bound. -/
noncomputable def uhC1 (j : Fin 3) : ℝ≥0∞ :=
  64 * (8 * 16 * ((2 * (1 - ENNReal.ofReal ((2 : ℝ) ^ (-((uhB j 0)⁻¹ * (1 / 64)))))⁻¹)
    * (2 * (1 - ENNReal.ofReal ((2 : ℝ) ^ (-((uhB j 1)⁻¹ * (1 / 64)))))⁻¹)
    * (2 * (1 - ENNReal.ofReal ((2 : ℝ) ^ (-((uhB j 2)⁻¹ * (1 / 64)))))⁻¹)))

theorem uhB_pos (j i : Fin 3) : 0 < uhB j i := by
  fin_cases j <;> fin_cases i <;> norm_num [uhB]

theorem uhC1_ne_zero (j : Fin 3) : uhC1 j ≠ 0 := by
  have hfac : ∀ c : ℝ, (2 : ℝ≥0∞) * (1 - ENNReal.ofReal ((2 : ℝ) ^ (-c)))⁻¹ ≠ 0 := by
    intro c
    refine mul_ne_zero (by norm_num) ?_
    rw [ne_eq, ENNReal.inv_eq_zero]
    exact (lt_of_le_of_lt tsub_le_self ENNReal.one_lt_top).ne
  rw [uhC1]
  exact mul_ne_zero (by norm_num) (mul_ne_zero (by norm_num)
    (mul_ne_zero (mul_ne_zero (hfac _) (hfac _)) (hfac _)))

theorem uhC1_ne_top (j : Fin 3) : uhC1 j ≠ ⊤ := by
  have hfac : ∀ c : ℝ, 0 < c →
      (2 : ℝ≥0∞) * (1 - ENNReal.ofReal ((2 : ℝ) ^ (-c)))⁻¹ ≠ ⊤ := fun c hc =>
    ENNReal.mul_ne_top (by norm_num) (one_sub_ofReal_rpow_inv_ne_top hc)
  have hpos : ∀ i : Fin 3, 0 < (uhB j i)⁻¹ * (1 / 64) :=
    fun i => mul_pos (inv_pos.mpr (uhB_pos j i)) (by norm_num)
  rw [uhC1]
  exact ENNReal.mul_ne_top (by norm_num) (ENNReal.mul_ne_top (by norm_num)
    (ENNReal.mul_ne_top (ENNReal.mul_ne_top (hfac _ (hpos 0)) (hfac _ (hpos 1)))
      (hfac _ (hpos 2))))

open MeasureTheory in
theorem eLpNorm_Atilde_normalized (j : Fin 3) (f : Fin 3 → E3 → ℂ) (hf : ∀ i, Measurable (f i))
    (hn : ∀ i, eLpNorm (f i) (ENNReal.ofReal (uhB j i)⁻¹) volume ≤ 1) :
    eLpNorm (Atilde 1 f) (ENNReal.ofReal 1) volume ≤ uhC1 j := by
  have hp : ∀ i, 0 < (uhB j i)⁻¹ := fun i => inv_pos.mpr (uhB_pos j i)
  have hrecip : (fun i => 1 / ((uhB j i)⁻¹)) = uhB j := by
    funext i
    rw [one_div, inv_inv]
  have hdl' : ∀ i, (1 : ℝ) / 64 ≤ 1 / ((uhB j i)⁻¹) := by
    intro i
    have hinv : (1 : ℝ) / ((uhB j i)⁻¹) = uhB j i := by
      rw [one_div, inv_inv]
    rw [hinv]
    fin_cases j <;> fin_cases i <;> norm_num [uhB]
  have hrest : ∀ n : Fin 3 → ℤ,
      RestrictedStrong (Atilde 1) (coneVec (fun i => 1 / ((uhB j i)⁻¹)) (1 / 64) n) 1 16 := by
    intro n
    rw [hrecip]
    exact restrictedStrong_Atilde_cone j n
  exact finite_marcinkiewicz admissible_Atilde_one (le_refl 1) hp (by norm_num) hdl' hrest hf hn

open MeasureTheory in
/-- **Patch 2 `lem:three-set-strong-upper-half` (S).** The strong `L^1` bound for the upper-half
monomial average at scale one. -/
theorem eLpNorm_Atilde_le (j : Fin 3) (f : Fin 3 → E3 → ℂ) (hf : ∀ i, Measurable (f i)) :
    eLpNorm (Atilde 1 f) 1 volume
      ≤ uhC1 j * ∏ i, eLpNorm (f i) (ENNReal.ofReal (uhB j i)⁻¹) volume := by
  have hsmul : ∀ (c : Fin 3 → ℂ) (g : Fin 3 → E3 → ℂ) (x : E3),
      Atilde 1 (fun i y => c i * g i y) x = (∏ i, c i) * Atilde 1 g x := by
    intro c g x
    rw [Atilde_eq_Aint]
    exact Aint_smul_slots _ _ _ c g x
  have hzero : ∀ (g : Fin 3 → E3 → ℂ) (i : Fin 3), (∀ l, Measurable (g l)) →
      g i =ᵐ[volume] 0 → Atilde 1 g =ᵐ[volume] 0 := by
    intro g i hgm hgi
    rw [Atilde_eq_Aint]
    exact Aint_ae_zero_of_slot_ae_zero (by norm_num) _ hgm hgi
  have h := eLpNorm_normalize (T := Atilde 1) (C := uhC1 j) (q := 1)
    (p := fun i => (uhB j i)⁻¹) (uhC1_ne_zero j) (fun i => inv_pos.mpr (uhB_pos j i))
    hsmul hzero (eLpNorm_Atilde_normalized j) f hf
  simpa using h



/-! ### Patch 2 (Q): localization to unit cubes

On a unit cube every translate of the average stays inside the enlargement, so the output there
depends only on the inputs restricted to the enlargement. The unit cubes have measure one, which
is what makes the Hölder step on each of them available. -/

open MeasureTheory in
theorem Atilde_localize {z : Fin 3 → ℤ} {x : E3} (hx : x ∈ unitCube z) (f : Fin 3 → E3 → ℂ) :
    Atilde 1 f x = Atilde 1 (fun i => Set.indicator (bigCube z) (f i)) x := by
  rw [Atilde, Atilde]
  congr 1
  refine intervalIntegral.integral_congr fun t ht => ?_
  rw [prodShift, prodShift]
  refine Finset.prod_congr rfl fun i _ => ?_
  have htI : t ∈ Set.Icc (0 : ℝ) 1 := by
    rw [Set.uIcc_of_le (by norm_num : (1 : ℝ) / 2 ≤ 1)] at ht
    exact ⟨le_trans (by norm_num) ht.1, ht.2⟩
  rw [Set.indicator_of_mem (shift_mem_bigCube hx htI)]

theorem unitCube_eq_preimage (m : Fin 3 → ℤ) :
    unitCube m = (WithLp.ofLp : E3 → (Fin 3 → ℝ)) ⁻¹'
      (Set.univ.pi fun i => Set.Ico ((m i : ℝ)) ((m i : ℝ) + 1)) := by
  ext x
  simp only [unitCube, Set.mem_ofPred_eq, Set.mem_preimage, Set.mem_pi, Set.mem_univ,
    forall_const, Set.mem_Ico]
  constructor
  · intro h i
    exact ⟨by linarith [(h i).1], by linarith [(h i).2]⟩
  · intro h i
    exact ⟨by linarith [(h i).1], by linarith [(h i).2]⟩

open MeasureTheory in
theorem volume_unitCube (m : Fin 3 → ℤ) : volume (unitCube m) = 1 := by
  have hm : MeasurableSet (Set.univ.pi fun i : Fin 3 => Set.Ico ((m i : ℝ)) ((m i : ℝ) + 1)) :=
    MeasurableSet.univ_pi fun _ => measurableSet_Ico
  rw [unitCube_eq_preimage,
    (PiLp.volume_preserving_ofLp (Fin 3)).measure_preimage hm.nullMeasurableSet,
    volume_pi_pi]
  simp [Real.volume_Ico]

open MeasureTheory in
instance isProbabilityMeasure_unitCube (m : Fin 3 → ℤ) :
    IsProbabilityMeasure (volume.restrict (unitCube m)) := by
  refine ⟨?_⟩
  rw [Measure.restrict_apply_univ, volume_unitCube]



/-! ### Patch 2 (Q): the bounded overlap of the enlargements

Every point lies in at most eight of the enlarged cubes, because in each coordinate only two
integers can occur. -/

open MeasureTheory in
theorem tsum_indicator_bigCube_le (x : E3) :
    (∑' z : Fin 3 → ℤ, Set.indicator (bigCube z) (fun _ => (1 : ℝ≥0∞)) x) ≤ 8 := by
  classical
  set S : Finset (Fin 3 → ℤ) := Fintype.piFinset fun i => ({⌊x i⌋, ⌊x i⌋ - 1} : Finset ℤ) with hS
  have hsupp : ∀ z ∉ S, Set.indicator (bigCube z) (fun _ => (1 : ℝ≥0∞)) x = 0 := by
    intro z hz
    rw [Set.indicator_of_notMem]
    intro hmem
    refine hz ?_
    rw [hS, Fintype.mem_piFinset]
    intro i
    have h1 : (0 : ℝ) ≤ x i - (z i : ℝ) := (hmem i).1
    have h2 : x i - (z i : ℝ) < 2 := (hmem i).2
    have hle : z i ≤ ⌊x i⌋ := Int.le_floor.mpr (by linarith)
    have hfl : ((⌊x i⌋ : ℤ) : ℝ) ≤ x i := Int.floor_le _
    have hlt : ((⌊x i⌋ : ℤ) : ℝ) < (z i : ℝ) + 2 := by linarith
    have hlt' : (⌊x i⌋ : ℤ) < z i + 2 := by exact_mod_cast hlt
    simp only [Finset.mem_insert, Finset.mem_singleton]
    omega
  rw [tsum_eq_sum hsupp]
  have hcard : (S.card : ℝ≥0∞) ≤ 8 := by
    have hc : S.card ≤ 8 := by
      rw [hS, Fintype.card_piFinset]
      calc (∏ i : Fin 3, ({⌊x i⌋, ⌊x i⌋ - 1} : Finset ℤ).card)
          ≤ ∏ _i : Fin 3, 2 := Finset.prod_le_prod₀ (fun i _ => Nat.zero_le _) fun i _ => by
            exact le_trans (Finset.card_insert_le _ _) (by simp)
        _ = 8 := by norm_num
    exact_mod_cast hc
  calc (∑ z ∈ S, Set.indicator (bigCube z) (fun _ => (1 : ℝ≥0∞)) x)
      ≤ ∑ _z ∈ S, (1 : ℝ≥0∞) :=
        Finset.sum_le_sum fun z _ => indicator_one_le_one3 (bigCube z) x
    _ = (S.card : ℝ≥0∞) := by simp
    _ ≤ 8 := hcard

open MeasureTheory in
/-- **The bounded overlap.** Summing an integral over the enlargements costs a factor eight. -/
theorem tsum_setLIntegral_bigCube_le {g : E3 → ℝ≥0∞} (hg : Measurable g) :
    (∑' z : Fin 3 → ℤ, ∫⁻ y in bigCube z, g y) ≤ 8 * ∫⁻ y, g y := by
  have hstep : ∀ z : Fin 3 → ℤ, (∫⁻ y in bigCube z, g y)
      = ∫⁻ y, Set.indicator (bigCube z) (fun _ => (1 : ℝ≥0∞)) y * g y := by
    intro z
    rw [← lintegral_indicator (measurableSet_bigCube z)]
    refine lintegral_congr fun y => ?_
    by_cases hy : y ∈ bigCube z
    · rw [Set.indicator_of_mem hy, Set.indicator_of_mem hy, one_mul]
    · rw [Set.indicator_of_notMem hy, Set.indicator_of_notMem hy, zero_mul]
  simp_rw [hstep]
  rw [← lintegral_tsum (f := fun (z : Fin 3 → ℤ) (y : E3) =>
    Set.indicator (bigCube z) (fun _ => (1 : ℝ≥0∞)) y * g y)
    fun z => ((measurable_const.indicator (measurableSet_bigCube z)).mul hg).aemeasurable]
  calc (∫⁻ y, ∑' z : Fin 3 → ℤ, Set.indicator (bigCube z) (fun _ => (1 : ℝ≥0∞)) y * g y)
      = ∫⁻ y, (∑' z : Fin 3 → ℤ, Set.indicator (bigCube z) (fun _ => (1 : ℝ≥0∞)) y) * g y := by
        refine lintegral_congr fun y => ?_
        rw [ENNReal.tsum_mul_right]
    _ ≤ ∫⁻ y, 8 * g y :=
        lintegral_mono fun y => mul_le_mul' (tsum_indicator_bigCube_le y) le_rfl
    _ = 8 * ∫⁻ y, g y := lintegral_const_mul' _ _ (by norm_num)



/-! ### Patch 2 (Q): Hölder in three factors

The discrete Hölder inequality of the patch, in the form needed: for weights summing to one, the
integral of a weighted geometric mean is at most the weighted geometric mean of the integrals. -/
theorem holderConjugate_of_mem_Ioo {t : ℝ} (h0 : 0 < t) (h1 : t < 1) :
    Real.HolderConjugate (1 / t) (1 / (1 - t)) := by
  have ht : (0 : ℝ) < 1 - t := by linarith
  refine ⟨?_, by positivity, by positivity⟩
  rw [one_div, one_div, inv_inv, inv_inv, inv_one]
  ring

open MeasureTheory in
theorem lintegral_rpow_mul_rpow_le {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {A B : α → ℝ≥0∞} (hA : AEMeasurable A μ) (hB : AEMeasurable B μ)
    {t : ℝ} (h0 : 0 < t) (h1 : t < 1) :
    (∫⁻ z, A z ^ t * B z ^ (1 - t) ∂μ)
      ≤ (∫⁻ z, A z ∂μ) ^ t * (∫⁻ z, B z ∂μ) ^ (1 - t) := by
  have ht : (0 : ℝ) < 1 - t := by linarith
  have h := ENNReal.lintegral_mul_le_Lp_mul_Lq μ (holderConjugate_of_mem_Ioo h0 h1)
    (hA.pow_const t) (hB.pow_const (1 - t))
  have hAp : ∀ z, (A z ^ t) ^ (1 / t) = A z := by
    intro z
    rw [← ENNReal.rpow_mul, mul_one_div, div_self h0.ne', ENNReal.rpow_one]
  have hBp : ∀ z, (B z ^ (1 - t)) ^ (1 / (1 - t)) = B z := by
    intro z
    rw [← ENNReal.rpow_mul, mul_one_div, div_self ht.ne', ENNReal.rpow_one]
  have h1p : (1 : ℝ) / (1 / t) = t := by field_simp
  have h1q : (1 : ℝ) / (1 / (1 - t)) = 1 - t := by field_simp
  simp only [hAp, hBp, h1p, h1q, Pi.mul_apply] at h
  exact h

open MeasureTheory in
/-- **Hölder in three factors.** -/
theorem lintegral_rpow_mul3_le {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {A B C : α → ℝ≥0∞} (hA : AEMeasurable A μ) (hB : AEMeasurable B μ) (hC : AEMeasurable C μ)
    {a b c : ℝ} (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (habc : a + b + c = 1) :
    (∫⁻ z, A z ^ a * (B z ^ b * C z ^ c) ∂μ)
      ≤ (∫⁻ z, A z ∂μ) ^ a * ((∫⁻ z, B z ∂μ) ^ b * (∫⁻ z, C z ∂μ) ^ c) := by
  have hs : (0 : ℝ) < b + c := by linarith
  have hsa : (1 : ℝ) - a = b + c := by linarith
  have ha1 : a < 1 := by linarith
  set b' : ℝ := b / (b + c) with hb'
  set c' : ℝ := c / (b + c) with hc'
  have hb'0 : 0 < b' := div_pos hb hs
  have hb'1 : b' < 1 := by
    rw [hb', div_lt_one hs]
    linarith
  have hc'eq : (1 : ℝ) - b' = c' := by
    have hbc : b' + c' = 1 := by
      rw [hb', hc']
      field_simp
    linarith
  have hbb : b' * (1 - a) = b := by
    rw [hb', hsa]
    field_simp
  have hcc : c' * (1 - a) = c := by
    rw [hc', hsa]
    field_simp
  set D : α → ℝ≥0∞ := fun z => B z ^ b' * C z ^ c' with hD
  have hDm : AEMeasurable D μ := (hB.pow_const b').mul (hC.pow_const c')
  have hDpow : ∀ z, D z ^ (1 - a) = B z ^ b * C z ^ c := by
    intro z
    rw [hD, ENNReal.mul_rpow_of_nonneg _ _ (by linarith : (0 : ℝ) ≤ 1 - a),
      ← ENNReal.rpow_mul, ← ENNReal.rpow_mul, hbb, hcc]
  have hstep1 := lintegral_rpow_mul_rpow_le hA hDm ha ha1
  have hstep2 : (∫⁻ z, D z ∂μ) ≤ (∫⁻ z, B z ∂μ) ^ b' * (∫⁻ z, C z ∂μ) ^ c' := by
    have h := lintegral_rpow_mul_rpow_le hB hC hb'0 hb'1
    rw [hc'eq] at h
    exact h
  calc (∫⁻ z, A z ^ a * (B z ^ b * C z ^ c) ∂μ)
      = ∫⁻ z, A z ^ a * D z ^ (1 - a) ∂μ := by
        refine lintegral_congr fun z => ?_
        rw [hDpow z]
    _ ≤ (∫⁻ z, A z ∂μ) ^ a * (∫⁻ z, D z ∂μ) ^ (1 - a) := hstep1
    _ ≤ (∫⁻ z, A z ∂μ) ^ a * ((∫⁻ z, B z ∂μ) ^ b' * (∫⁻ z, C z ∂μ) ^ c') ^ (1 - a) :=
        mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hstep2 (by linarith))
    _ = (∫⁻ z, A z ∂μ) ^ a * ((∫⁻ z, B z ∂μ) ^ b * (∫⁻ z, C z ∂μ) ^ c) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by linarith : (0 : ℝ) ≤ 1 - a),
          ← ENNReal.rpow_mul, ← ENNReal.rpow_mul, hbb, hcc]



/-! ### Patch 2 (Q): the Hölder step on a cube, and the partition -/

/-- The local mass of the `i`-th input on the enlargement of the cube `z`. -/
noncomputable def uhM (j : Fin 3) (f : Fin 3 → E3 → ℂ) (i : Fin 3) (z : Fin 3 → ℤ) : ℝ≥0∞ :=
  ∫⁻ y in bigCube z, ‖f i y‖ₑ ^ ((uhB j i)⁻¹)

/-- The weights of the discrete Hölder step, `q / p_i`. -/
noncomputable def uhTh (j : Fin 3) (i : Fin 3) : ℝ := (8 / 9 : ℝ) * uhB j i

theorem uhTh_pos (j i : Fin 3) : 0 < uhTh j i := mul_pos (by norm_num) (uhB_pos j i)

theorem uhTh_sum (j : Fin 3) : uhTh j 0 + uhTh j 1 + uhTh j 2 = 1 := by
  fin_cases j <;> norm_num [uhTh, uhB, Matrix.cons_val_two, Matrix.tail_cons]

open MeasureTheory in
/-- On a probability space the `q`-th power integrates to at most the `q`-th power of the
integral, for `q <= 1`. -/
theorem lintegral_enorm_rpow_le_of_probability {α : Type*} [MeasurableSpace α] {μ : Measure α}
    [IsProbabilityMeasure μ] {g : α → ℂ} (hg : AEStronglyMeasurable g μ) {q : ℝ}
    (hq0 : 0 < q) (hq1 : q ≤ 1) :
    (∫⁻ x, ‖g x‖ₑ ^ q ∂μ) ≤ (∫⁻ x, ‖g x‖ₑ ∂μ) ^ q := by
  have hqne : ENNReal.ofReal q ≠ 0 := (ENNReal.ofReal_pos.mpr hq0).ne'
  have hle : eLpNorm g (ENNReal.ofReal q) μ ≤ eLpNorm g 1 μ := by
    refine eLpNorm_le_eLpNorm_of_exponent_le ?_
    rw [← ENNReal.ofReal_one]
    exact ENNReal.ofReal_le_ofReal hq1
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hqne ENNReal.ofReal_ne_top (by fun_prop),
    ENNReal.toReal_ofReal hq0.le, eLpNorm_one_eq_lintegral_enorm (by fun_prop)] at hle
  have h := ENNReal.rpow_le_rpow hle hq0.le
  rwa [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one] at h

open MeasureTheory in
/-- The unit cubes partition the space, so an integral is the sum of the integrals over them. -/
theorem lintegral_eq_tsum_unitCube (g : E3 → ℝ≥0∞) :
    (∫⁻ x, g x) = ∑' z : Fin 3 → ℤ, ∫⁻ x in unitCube z, g x := by
  have hdisj : Pairwise (Function.onFun Disjoint (fun z : Fin 3 → ℤ => unitCube z)) :=
    fun z z' h => unitCube_disjoint h
  have h := lintegral_iUnion (μ := (volume : Measure E3))
    (fun z : Fin 3 → ℤ => measurableSet_unitCube z) hdisj g
  rw [iUnion_unitCube, Measure.restrict_univ] at h
  exact h



open MeasureTheory in
theorem eLpNorm_indicator_rpow {S : Set E3} (hS : MeasurableSet S) {g : E3 → ℂ}
    {r : ℝ} (hr : 0 < r) (hg : AEStronglyMeasurable g volume := by fun_prop) :
    eLpNorm (Set.indicator S g) (ENNReal.ofReal r) volume
      = (∫⁻ y in S, ‖g y‖ₑ ^ r) ^ (1 / r) := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hr) ENNReal.ofReal_ne_top
    (by fun_prop),
    ENNReal.toReal_ofReal hr.le]
  congr 1
  rw [← lintegral_indicator hS]
  refine lintegral_congr fun y => ?_
  by_cases hy : y ∈ S
  · rw [Set.indicator_of_mem hy, Set.indicator_of_mem hy]
  · rw [Set.indicator_of_notMem hy, Set.indicator_of_notMem hy, enorm_zero,
      ENNReal.zero_rpow_of_pos hr]

open MeasureTheory in
/-- **Hölder in three factors for sums.** -/
theorem tsum_rpow_mul3_le {ι : Type*} [Countable ι] [MeasurableSpace ι]
    [MeasurableSingletonClass ι] (A B C : ι → ℝ≥0∞)
    {a b c : ℝ} (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (habc : a + b + c = 1) :
    (∑' z, A z ^ a * (B z ^ b * C z ^ c))
      ≤ (∑' z, A z) ^ a * ((∑' z, B z) ^ b * (∑' z, C z) ^ c) := by
  calc (∑' z, A z ^ a * (B z ^ b * C z ^ c))
      = ∫⁻ z, A z ^ a * (B z ^ b * C z ^ c) ∂Measure.count := (lintegral_count _).symm
    _ ≤ (∫⁻ z, A z ∂Measure.count) ^ a * ((∫⁻ z, B z ∂Measure.count) ^ b
          * (∫⁻ z, C z ∂Measure.count) ^ c) :=
        lintegral_rpow_mul3_le (measurable_of_countable A).aemeasurable
          (measurable_of_countable B).aemeasurable (measurable_of_countable C).aemeasurable
          ha hb hc habc
    _ = (∑' z, A z) ^ a * ((∑' z, B z) ^ b * (∑' z, C z) ^ c) := by
        rw [lintegral_count, lintegral_count, lintegral_count]



