open MeasureTheory in
/-- **Patch 2: the terminal set of the third update is nonempty**, so the point `z` can be
chosen. -/
theorem uhF3_zero_nonempty {E : Fin 3 → Set E3} (hE : ∀ i, MeasurableSet (E i))
    (h0 : ∀ i, volume (E i) ≠ 0) (ht : ∀ i, volume (E i) ≠ ⊤) (hKt : uhInc E ≠ ⊤)
    (hK0 : uhInc E ≠ 0) {d : Fin 3} (hd : d ≠ 0) : (uhF3 E d 0).Nonempty := by
  rw [Set.nonempty_iff_ne_empty]
  intro hemp
  have hzero : uhInc (uhF3 E d) = 0 := by
    rw [uhInc_eq_setLIntegral (measurableSet_uhF3 hE d) 0, hemp]
    simp
  have hle := uhInc_uhF3_ge hE h0 ht hKt hd
  rw [hzero, le_zero_iff] at hle
  have h8 : uhInc E = 0 := by
    have h1 : uhInc E / 2 / 2 = 0 := by
      have := ENNReal.add_halves (uhInc E / 2 / 2)
      rw [hle, add_zero] at this
      exact this.symm
    have h2 : uhInc E / 2 = 0 := by
      have := ENNReal.add_halves (uhInc E / 2)
      rw [h1, add_zero] at this
      exact this.symm
    have := ENNReal.add_halves (uhInc E)
    rw [h2, add_zero] at this
    exact this.symm
  exact hK0 h8


/-! ### Patch 2 (T1): the three fibres of the tower

The fibre function is twice the measure of the set of parameters for which the two remaining
translates land in their sets, so each threshold is a lower bound for that measure. -/
theorem enn_le_half_of_two_mul_le {c X : ℝ≥0∞} (h : c ≤ 2 * X) : c / 2 ≤ X := by
  rw [div_eq_mul_inv, mul_comm]
  calc (2 : ℝ≥0∞)⁻¹ * c ≤ 2⁻¹ * (2 * X) := mul_le_mul' le_rfl h
    _ = X := by
        rw [← mul_assoc, ENNReal.inv_mul_cancel (by norm_num) (by norm_num), one_mul]

/-- The set of parameters for which the two translates other than the `i`-th land in their
sets. -/
def uhFibSet (F : Fin 3 → Set E3) (i : Fin 3) (y : E3) : Set ℝ :=
  {t : ℝ | ∀ a, a ≠ i → y - curve i t + curve a t ∈ F a} ∩ uhI

open MeasureTheory in
theorem measurableSet_uhFibPre {F : Fin 3 → Set E3} (hF : ∀ i, MeasurableSet (F i)) (i : Fin 3)
    (y : E3) : MeasurableSet {t : ℝ | ∀ a, a ≠ i → y - curve i t + curve a t ∈ F a} := by
  have heq : {t : ℝ | ∀ a, a ≠ i → y - curve i t + curve a t ∈ F a}
      = ⋂ a ∈ ({i}ᶜ : Set (Fin 3)), {t : ℝ | y - curve i t + curve a t ∈ F a} := by
    ext t
    simp only [Set.mem_ofPred_eq, Set.mem_iInter, Set.mem_compl_iff, Set.mem_singleton_iff]
  rw [heq]
  refine MeasurableSet.biInter (Set.to_countable _) fun a _ => ?_
  exact (hF a).preimage
    ((measurable_const.sub (continuous_curve i).measurable).add (continuous_curve a).measurable)

