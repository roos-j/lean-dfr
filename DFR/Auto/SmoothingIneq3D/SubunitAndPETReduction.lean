open MeasureTheory in
/-- **Patch 2 (D2): one measurable refinement loses at most the threshold times the measure.** -/
theorem uhInc_refine_le {F : Fin 3 → Set E3} (hF : ∀ i, MeasurableSet (F i)) (i : Fin 3)
    (c : ℝ≥0∞) :
    uhInc F
      ≤ uhInc (Function.update F i (uhRefine F i c)) + c * volume (F i) := by
  classical
  have hGm : MeasurableSet (uhRefine F i c) := measurableSet_uhRefine hF i c
  have hF'm : ∀ a, MeasurableSet (Function.update F i (uhRefine F i c) a) := by
    intro a
    by_cases h : a = i
    · subst h
      rw [Function.update_self]
      exact hGm
    · rw [Function.update_of_ne h]
      exact hF a
  have hsplit : (∫⁻ y in F i ∩ uhRefine F i c, uhFib F i y)
      + ∫⁻ y in F i \ uhRefine F i c, uhFib F i y = ∫⁻ y in F i, uhFib F i y :=
    lintegral_inter_add_sdiff _ _ hGm
  have hinter : F i ∩ uhRefine F i c = uhRefine F i c :=
    Set.inter_eq_self_of_subset_right (uhRefine_subset F i c)
  have hrest : uhInc (Function.update F i (uhRefine F i c))
      = ∫⁻ y in uhRefine F i c, uhFib F i y := by
    rw [uhInc_eq_setLIntegral hF'm i, Function.update_self, uhFib_update]
  have hbad : (∫⁻ y in F i \ uhRefine F i c, uhFib F i y) ≤ c * volume (F i) := by
    calc (∫⁻ y in F i \ uhRefine F i c, uhFib F i y)
        ≤ ∫⁻ _y in F i \ uhRefine F i c, c := by
          refine setLIntegral_mono' ((hF i).diff hGm) fun y hy => ?_
          by_contra hc
          exact hy.2 ⟨hy.1, le_of_not_ge hc⟩
      _ = c * volume (F i \ uhRefine F i c) := setLIntegral_const _ _
      _ ≤ c * volume (F i) := mul_le_mul' le_rfl (measure_mono Set.sdiff_subset)
  rw [uhInc_eq_setLIntegral hF i, ← hsplit, hinter, hrest]
  exact add_le_add le_rfl hbad


/-! ### Patch 2 (D3): exactly three updates, in the order `1, d, 1`

The thresholds are `alpha_1/2`, `alpha_d/4` and `alpha_1/8`, and each application of (D2) loses at
