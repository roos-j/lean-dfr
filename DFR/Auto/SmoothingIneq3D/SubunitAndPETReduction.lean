open MeasureTheory in
/-- **Blueprint `thm:strong-real-improving`, at an arbitrary index triple.** The `L^2` index is
`j`, the `L^{40/7}` index is `m`, and the remaining one carries `L^6`. -/
theorem strong_real_improving' {m j k : Fin 3} (hjm : j ≠ m) (hkm : k ≠ m) (hjk : j ≠ k) :
    ∃ C : ℝ≥0∞, C ≠ ⊤ ∧ ∀ N : ℝ, 0 < N → ∀ f : Fin 3 → E3 → ℂ, (∀ i, Measurable (f i)) →
      eLpNorm (A N f) (ENNReal.ofReal (6 / 5)) volume
        ≤ ENNReal.ofReal (N ^ (-(1 : ℝ) / 20))
          * (C * ∏ i, eLpNorm (f i) (ENNReal.ofReal ((targetV j m i)⁻¹)) volume) := by
  have hppos : ∀ i : Fin 3, 0 < (targetV j m i)⁻¹ := fun i =>
    inv_pos.mpr (targetV_pos j m i)
  have hrecip : (fun i : Fin 3 => 1 / ((targetV j m i)⁻¹)) = targetV j m := by
    funext i
    rw [one_div, inv_inv]
  have hdl' : ∀ i : Fin 3, (1 : ℝ) / 400 ≤ 1 / ((targetV j m i)⁻¹) := by
    intro i
    have hinv : (1 : ℝ) / ((targetV j m i)⁻¹) = targetV j m i := by rw [one_div, inv_inv]
    rw [hinv]
    exact targetV_ge j m i
  have hrest : ∀ n : Fin 3 → ℤ,
      RestrictedStrong (A 1)
        (coneVec (fun i => 1 / ((targetV j m i)⁻¹)) (1 / 400) n) (6 / 5) coneConst := by
    intro n
    rw [hrecip]
    exact restrictedStrong_A_cone' hjm hkm hjk n
  set B : ℝ≥0∞ := 64 * (8 * coneConst
      * ((2 * (1 - ENNReal.ofReal ((2 : ℝ) ^ (-((targetV j m 0)⁻¹ * (1 / 400)))))⁻¹)
        * (2 * (1 - ENNReal.ofReal ((2 : ℝ) ^ (-((targetV j m 1)⁻¹ * (1 / 400)))))⁻¹)
        * (2 * (1 - ENNReal.ofReal ((2 : ℝ) ^ (-((targetV j m 2)⁻¹ * (1 / 400)))))⁻¹))) with hB
  have hBtop : B ≠ ⊤ := by
    have hfac : ∀ i : Fin 3,
        (2 : ℝ≥0∞) * (1 - ENNReal.ofReal ((2 : ℝ) ^ (-((targetV j m i)⁻¹ * (1 / 400)))))⁻¹
          ≠ ⊤ := fun i =>
      ENNReal.mul_ne_top (by norm_num)
        (one_sub_ofReal_rpow_inv_ne_top (mul_pos (hppos i) (by norm_num)))
    rw [hB]
    exact ENNReal.mul_ne_top (by norm_num) (ENNReal.mul_ne_top
      (ENNReal.mul_ne_top (by norm_num) coneConst_ne_top)
      (ENNReal.mul_ne_top (ENNReal.mul_ne_top (hfac 0) (hfac 1)) (hfac 2)))
  have hmain : ∀ g : Fin 3 → E3 → ℂ, (∀ i, Measurable (g i)) →
      (∀ i, eLpNorm (g i) (ENNReal.ofReal ((targetV j m i)⁻¹)) volume ≤ 1) →
      eLpNorm (A 1 g) (ENNReal.ofReal (6 / 5)) volume ≤ B ⊔ 1 := by
    intro g hgm hgn
    exact le_trans (finite_marcinkiewicz (admissible_A zero_le_one) (by norm_num) hppos
      (by norm_num) hdl' hrest hgm hgn) le_sup_left
  have hone : ∀ f : Fin 3 → E3 → ℂ, (∀ i, Measurable (f i)) →
      eLpNorm (A 1 f) (ENNReal.ofReal (6 / 5)) volume
        ≤ (B ⊔ 1) * ∏ i, eLpNorm (f i) (ENNReal.ofReal ((targetV j m i)⁻¹)) volume :=
    fun f hf => eLpNorm_A_one_le (lt_of_lt_of_le zero_lt_one le_sup_right).ne' hppos hmain f hf
  refine ⟨B ⊔ 1, ?_, ?_⟩
  · refine lt_top_iff_ne_top.mp (max_lt (lt_top_iff_ne_top.mpr hBtop) ?_)
    exact lt_top_iff_ne_top.mpr ENNReal.one_ne_top
  intro N hNpos f hf
  have h := eLpNorm_A_of_scale_one (q := 6 / 5) (by norm_num) hppos hone hNpos f hf
  rwa [strong_real_improving_scale_factor' hjm hkm hjk hNpos] at h



/-! ### `cor:kosz-53-internal`: the adjoint is in `L^2` for nice inputs

The duality lemma needs the `L^2` norm of the adjoint to be finite before the estimate is
available. That does not follow from a trivial Hölder bound -- the trivial exponent for the
adjoint is `120/61`, and reaching `2` is the content of the corollary -- but it does follow from
the pointwise bound by the average of `|g_0|` along the curve, which is bounded and in `L^1`. -/
theorem enorm_rpow_two (x : ℝ≥0∞) : x ^ (2 : ℝ) = x * x := by
  rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, ENNReal.rpow_natCast, sq]

open MeasureTheory in
theorem enorm_Astar_le {N : ℝ} (hN : 0 < N) (j : Fin 3) {f0 : E3 → ℂ}
    {f : Fin 3 → E3 → ℂ} {Cb : ℝ} (hCb : 0 ≤ Cb) (hfb : ∀ i x, ‖f i x‖ ≤ Cb) (y : E3) :
    ‖Astar N j f0 f y‖ₑ
      ≤ ENNReal.ofReal N⁻¹ * ENNReal.ofReal (Cb ^ 2)
        * ∫⁻ t in Set.Ioc (0 : ℝ) N, ‖f0 (y - curve j t)‖ₑ := by
  have h1 : ‖Astar N j f0 f y‖ₑ
      = ENNReal.ofReal N⁻¹ * ‖∫ t in (0 : ℝ)..N, adjShift j f0 f y t‖ₑ := by
    rw [Astar, enorm_mul, ← ofReal_norm ((N : ℂ)⁻¹), norm_inv, Complex.norm_real,
      Real.norm_of_nonneg hN.le]
  have h2 : ‖∫ t in (0 : ℝ)..N, adjShift j f0 f y t‖ₑ
      ≤ ∫⁻ t in Set.Ioc (0 : ℝ) N, ‖adjShift j f0 f y t‖ₑ := by
    rw [intervalIntegral.integral_of_le hN.le]
    exact enorm_integral_le_lintegral_enorm _
  have h3 : ∀ t : ℝ, ‖adjShift j f0 f y t‖ₑ
      ≤ ENNReal.ofReal (Cb ^ 2) * ‖f0 (y - curve j t)‖ₑ := by
    intro t
    rw [← ofReal_norm, ← ofReal_norm (f0 (y - curve j t)),
      ← ENNReal.ofReal_mul (by positivity)]
    exact ENNReal.ofReal_le_ofReal (norm_adjShift_le hCb hfb j y t)
  calc ‖Astar N j f0 f y‖ₑ
      = ENNReal.ofReal N⁻¹ * ‖∫ t in (0 : ℝ)..N, adjShift j f0 f y t‖ₑ := h1
    _ ≤ ENNReal.ofReal N⁻¹ * ∫⁻ t in Set.Ioc (0 : ℝ) N, ‖adjShift j f0 f y t‖ₑ :=
        mul_le_mul' le_rfl h2
    _ ≤ ENNReal.ofReal N⁻¹
          * ∫⁻ t in Set.Ioc (0 : ℝ) N, ENNReal.ofReal (Cb ^ 2) * ‖f0 (y - curve j t)‖ₑ :=
        mul_le_mul' le_rfl (lintegral_mono h3)
    _ = ENNReal.ofReal N⁻¹ * ENNReal.ofReal (Cb ^ 2)
          * ∫⁻ t in Set.Ioc (0 : ℝ) N, ‖f0 (y - curve j t)‖ₑ := by
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, ← mul_assoc]

