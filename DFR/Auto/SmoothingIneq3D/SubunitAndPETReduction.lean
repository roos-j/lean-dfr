theorem enn_div_mul (a m k : ℝ≥0∞) : a / k * m = a * m / k := by
  rw [div_eq_mul_inv, div_eq_mul_inv]
  ring

open MeasureTheory in
/-- The density of the `i`-th set: the incidence integral divided by its measure. -/
