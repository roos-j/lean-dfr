/-- **Patch 2 (D3).** The three updates lose at most half of the incidence integral in total. -/
theorem uhInc_uhF3_ge {E : Fin 3 → Set E3} (hE : ∀ i, MeasurableSet (E i))
    (h0 : ∀ i, volume (E i) ≠ 0) (ht : ∀ i, volume (E i) ≠ ⊤) (hKt : uhInc E ≠ ⊤)
    {d : Fin 3} (hd : d ≠ 0) :
    uhInc E / 2 / 2 / 2 ≤ uhInc (uhF3 E d) := by
  have hK2 : uhInc E / 2 ≠ ⊤ := (ENNReal.div_lt_top hKt (by norm_num)).ne
  have hK4 : uhInc E / 2 / 2 ≠ ⊤ := (ENNReal.div_lt_top hK2 (by norm_num)).ne
  have hK8 : uhInc E / 2 / 2 / 2 ≠ ⊤ := (ENNReal.div_lt_top hK4 (by norm_num)).ne
  -- the first update
  have hs1 := uhInc_refine_le hE 0 (uhAlpha E 0 / 2)
  have hv1 : uhAlpha E 0 / 2 * volume (E 0) = uhInc E / 2 := by
    rw [enn_div_mul, uhAlpha_mul (h0 0) (ht 0)]
  rw [hv1] at hs1
  have hstep1 : uhInc E / 2 ≤ uhInc (uhF1 E) := by
    refine (ENNReal.add_le_add_iff_right hK2).mp ?_
    calc uhInc E / 2 + uhInc E / 2 = uhInc E := ENNReal.add_halves _
      _ ≤ uhInc (uhF1 E) + uhInc E / 2 := hs1
  -- the second update
  have hs2 := uhInc_refine_le (measurableSet_uhF1 hE) d (uhAlpha E d / 2 / 2)
  have hvol1d : volume (uhF1 E d) = volume (E d) := by rw [uhF1_ne E hd]
  have hv2 : uhAlpha E d / 2 / 2 * volume (uhF1 E d) = uhInc E / 2 / 2 := by
    rw [hvol1d, enn_div_mul, enn_div_mul, uhAlpha_mul (h0 d) (ht d)]
  rw [hv2] at hs2
  have hstep2 : uhInc E / 2 / 2 ≤ uhInc (uhF2 E d) := by
    refine (ENNReal.add_le_add_iff_right hK4).mp ?_
    calc uhInc E / 2 / 2 + uhInc E / 2 / 2 = uhInc E / 2 := ENNReal.add_halves _
      _ ≤ uhInc (uhF1 E) := hstep1
      _ ≤ uhInc (uhF2 E d) + uhInc E / 2 / 2 := hs2
  -- the third update
  have hs3 := uhInc_refine_le (measurableSet_uhF2 hE d) 0 (uhAlpha E 0 / 2 / 2 / 2)
  have hsub : uhF2 E d 0 ⊆ E 0 := by
    rw [uhF2_ne E d (Ne.symm hd), uhF1_zero]
    exact uhRefine_subset E 0 _
  have hv3 : uhAlpha E 0 / 2 / 2 / 2 * volume (uhF2 E d 0) ≤ uhInc E / 2 / 2 / 2 := by
    calc uhAlpha E 0 / 2 / 2 / 2 * volume (uhF2 E d 0)
        ≤ uhAlpha E 0 / 2 / 2 / 2 * volume (E 0) := mul_le_mul' le_rfl (measure_mono hsub)
      _ = uhInc E / 2 / 2 / 2 := by
          rw [enn_div_mul, enn_div_mul, enn_div_mul, uhAlpha_mul (h0 0) (ht 0)]
  refine (ENNReal.add_le_add_iff_right hK8).mp ?_
  calc uhInc E / 2 / 2 / 2 + uhInc E / 2 / 2 / 2 = uhInc E / 2 / 2 := ENNReal.add_halves _
    _ ≤ uhInc (uhF2 E d) := hstep2
    _ ≤ uhInc (uhF3 E d) + uhAlpha E 0 / 2 / 2 / 2 * volume (uhF2 E d 0) := hs3
