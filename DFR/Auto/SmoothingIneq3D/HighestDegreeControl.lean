/-! ### The chain of levels with all earlier shifts retained and averaged

Blueprint `patch:cs-loss`, last sentence: "The same assertion holds with all earlier shift
parameters retained and averaged."  A level `r` is a real function of the `r` shifts introduced so
far; its mean is the average against the product Fejer density. All the integrability side
conditions follow from measurability and the bound by one. -/

/-- The mean of a level-`r` quantity over the `r` shifts, against the product Fejer density. -/
noncomputable def fejerMean (H : ℝ) (r : ℕ) (a : (Fin r → ℝ) → ℝ) : ℝ :=
  ∫ h : Fin r → ℝ, (∏ l : Fin r, fejer H (h l)) * a h

theorem measurable_fin_cons_real (r : ℕ) :
    Measurable fun q : ℝ × (Fin r → ℝ) => (Fin.cons q.1 q.2 : Fin (r + 1) → ℝ) := by
  have hsymm : ∀ q : ℝ × (Fin r → ℝ),
      (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (r + 1) => ℝ) 0).symm q
        = Fin.cons q.1 q.2 := by
    intro q
    simp [MeasurableEquiv.piFinSuccAbove, Fin.consEquiv]
  have h := (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (r + 1) => ℝ) 0).symm.measurable
  simp only [funext hsymm] at h
  exact h

theorem measurable_prod_fejer {H : ℝ} (r : ℕ) :
    Measurable fun h : Fin r → ℝ => ∏ l : Fin r, fejer H (h l) :=
  Finset.measurable_prod _ fun l _ => continuous_fejer.measurable.comp (measurable_pi_apply l)

theorem integrable_prod_fejer_mul {H : ℝ} (hH : 0 < H) {r : ℕ} {a : (Fin r → ℝ) → ℝ}
    (ham : Measurable a) (ha1 : ∀ h, |a h| ≤ 1) :
    Integrable fun h : Fin r → ℝ => (∏ l : Fin r, fejer H (h l)) * a h :=
  (integrable_prod_fejer hH r).mul_bdd ham.aestronglyMeasurable
    (.of_forall fun h => by rw [Real.norm_eq_abs]; exact ha1 h)

theorem abs_fejerMean_le_one {H : ℝ} (hH : 0 < H) {r : ℕ} {a : (Fin r → ℝ) → ℝ}
    (ham : Measurable a) (ha1 : ∀ h, |a h| ≤ 1) : |fejerMean H r a| ≤ 1 := by
  rw [fejerMean]
  calc |∫ h : Fin r → ℝ, (∏ l : Fin r, fejer H (h l)) * a h|
      ≤ ∫ h : Fin r → ℝ, |(∏ l : Fin r, fejer H (h l)) * a h| := by
        have := norm_integral_le_integral_norm (μ := (volume : Measure (Fin r → ℝ)))
          (fun h : Fin r → ℝ => (∏ l : Fin r, fejer H (h l)) * a h)
        simpa only [Real.norm_eq_abs] using this
    _ ≤ ∫ h : Fin r → ℝ, (∏ l : Fin r, fejer H (h l)) := by
        refine integral_mono (integrable_prod_fejer_mul hH ham ha1).abs
          (integrable_prod_fejer hH r) fun h => ?_
        rw [abs_mul, abs_of_nonneg (prod_fejer_nonneg hH h)]
        exact mul_le_of_le_one_right (prod_fejer_nonneg hH h) (ha1 h)
    _ = 1 := integral_prod_fejer hH r

theorem fejerMean_nonneg {H : ℝ} (hH : 0 < H) {r : ℕ} {a : (Fin r → ℝ) → ℝ}
    (ha0 : ∀ h, 0 ≤ a h) : 0 ≤ fejerMean H r a :=
  integral_nonneg fun h => mul_nonneg (prod_fejer_nonneg hH h) (ha0 h)

/-- At level zero there are no shifts, so the mean is the quantity itself. -/
theorem fejerMean_zero (H : ℝ) (a : (Fin 0 → ℝ) → ℝ) : fejerMean H 0 a = a Fin.elim0 := by
  have hvol : (volume : Measure (Fin 0 → ℝ)) Set.univ = 1 := by
    rw [volume_pi,
      Measure.pi_of_empty (fun _ : Fin 0 => (volume : Measure ℝ)) (fun _ => (0 : ℝ))]
    simp
  rw [fejerMean, integral_unique]
  simp only [Measure.real, hvol, ENNReal.toReal_one, Finset.univ_eq_empty, Finset.prod_empty,
    one_mul, one_smul]
  exact congrArg a (Subsingleton.elim _ _)

/-- **One step of the chain, averaged over the earlier shifts.** A pointwise bound
`a(h)^2 <= 2 E_{u ~ κ_H} b(u, h) + δ` becomes `(E a)^2 <= 2 E b + δ` for the Fejer means at levels
`r` and `r + 1`: Jensen against the product density, and Fubini to recombine the new shift with the
old ones. -/
theorem fejerMean_sq_le {H δ : ℝ} (hH : 0 < H) {r : ℕ} {a : (Fin r → ℝ) → ℝ}
    {b : (Fin (r + 1) → ℝ) → ℝ} (ham : Measurable a) (ha1 : ∀ h, |a h| ≤ 1)
    (hbm : Measurable b) (hb1 : ∀ h, |b h| ≤ 1)
    (hpt : ∀ h, a h ^ 2 ≤ 2 * (∫ u : ℝ, fejer H u * b (Fin.cons u h)) + δ) :
    fejerMean H r a ^ 2 ≤ 2 * fejerMean H (r + 1) b + δ := by
  have hbc : Measurable fun q : ℝ × (Fin r → ℝ) => b (Fin.cons q.1 q.2) :=
    hbm.comp (measurable_fin_cons_real r)
  -- the joint integrand on `ℝ × (Fin r → ℝ)`
  have hwq : Integrable (fun q : ℝ × (Fin r → ℝ) => fejer H q.1 * ∏ l : Fin r, fejer H (q.2 l))
      ((volume : Measure ℝ).prod (volume : Measure (Fin r → ℝ))) :=
    (integrable_fejer hH).mul_prod (integrable_prod_fejer hH r)
  have hint : Integrable fun q : ℝ × (Fin r → ℝ) =>
      (∏ l : Fin (r + 1), fejer H ((Fin.cons q.1 q.2 : Fin (r + 1) → ℝ) l))
        * b (Fin.cons q.1 q.2) := by
    simp_rw [prod_fejer_cons]
    rw [Measure.volume_eq_prod]
    exact hwq.mul_bdd hbc.aestronglyMeasurable
      (.of_forall fun q => by rw [Real.norm_eq_abs]; exact hb1 _)
  have hint' : Integrable (Function.uncurry fun (h : Fin r → ℝ) (u : ℝ) =>
      (∏ l : Fin r, fejer H (h l)) * (fejer H u * b (Fin.cons u h)))
      ((volume : Measure (Fin r → ℝ)).prod (volume : Measure ℝ)) := by
    have h1 : Integrable (fun q : ℝ × (Fin r → ℝ) =>
        (∏ l : Fin r, fejer H (q.2 l)) * (fejer H q.1 * b (Fin.cons q.1 q.2)))
        ((volume : Measure ℝ).prod (volume : Measure (Fin r → ℝ))) := by
      rw [← Measure.volume_eq_prod]
      refine hint.congr (.of_forall fun q => ?_)
      simp only [prod_fejer_cons]
      ring
    refine h1.swap.congr (.of_forall fun q => ?_)
    simp [Function.uncurry]
  have hswap := integral_integral_swap hint'
  have hrec := integral_prod_fejer_mul_inner_eq r (B := b) hswap hint
  -- the inner Fejer average of `b` is measurable and bounded by one
  have hSm : Measurable fun h : Fin r → ℝ => ∫ u : ℝ, fejer H u * b (Fin.cons u h) := by
    have hjm : Measurable (Function.uncurry fun (h : Fin r → ℝ) (u : ℝ) =>
        fejer H u * b (Fin.cons u h)) :=
      (continuous_fejer.measurable.comp measurable_snd).mul
        (hbc.comp measurable_swap)
    exact (hjm.stronglyMeasurable.integral_prod_right (ν := (volume : Measure ℝ))).measurable
  have hS1 : ∀ h : Fin r → ℝ, |∫ u : ℝ, fejer H u * b (Fin.cons u h)| ≤ 1 := by
    intro h
    have hi : Integrable fun u : ℝ => fejer H u * b (Fin.cons u h) :=
      (integrable_fejer hH).mul_bdd
        ((hbm.comp ((measurable_fin_cons_real r).comp
          (measurable_id.prodMk measurable_const))).aestronglyMeasurable)
        (.of_forall fun u => by rw [Real.norm_eq_abs]; exact hb1 _)
    calc |∫ u : ℝ, fejer H u * b (Fin.cons u h)|
        ≤ ∫ u : ℝ, |fejer H u * b (Fin.cons u h)| := by
          have := norm_integral_le_integral_norm (μ := (volume : Measure ℝ))
            (fun u : ℝ => fejer H u * b (Fin.cons u h))
          simpa only [Real.norm_eq_abs] using this
      _ ≤ ∫ u : ℝ, fejer H u := by
          refine integral_mono hi.abs (integrable_fejer hH) fun u => ?_
          rw [abs_mul, abs_of_nonneg (fejer_nonneg hH u)]
          exact mul_le_of_le_one_right (fejer_nonneg hH u) (hb1 _)
      _ = 1 := integral_fejer hH
  have ha2 : ∀ h, |a h ^ 2| ≤ 1 := fun h => by
    rw [abs_pow]
    exact pow_le_one₀ (abs_nonneg _) (ha1 h)
  have hmain := sq_weighted_mean_le_of_pointwise (μ := (volume : Measure (Fin r → ℝ)))
    (fun h => prod_fejer_nonneg hH h) (integral_prod_fejer hH r) (integrable_prod_fejer hH r)
    (integrable_prod_fejer_mul hH ham ha1) (integrable_prod_fejer_mul hH (ham.pow_const 2) ha2)
    (integrable_prod_fejer_mul hH hSm hS1) hpt
  rw [hrec] at hmain
  exact hmain

/-- **`patch:cs-loss` with all earlier shifts retained and averaged.** Levels `a r` of the
chain, each a measurable function of the `r` shifts bounded by one, nonnegative before the last
level, with the step `a_r(h)^2 <= 2 E_{u ~ κ_H} a_{r+1}(u, h) + 2δ` at every level `r < T`. The
last level is the signed average; its mean `Q` enters through `max Q 0`. -/
theorem fejerChain {T : ℕ} {a : (r : ℕ) → (Fin r → ℝ) → ℝ} {H δ : ℝ} (hH : 0 < H)
    (hδ : 0 ≤ δ) (ham : ∀ r, Measurable (a r)) (ha1 : ∀ r h, |a r h| ≤ 1)
    (ha0 : ∀ r < T, ∀ h, 0 ≤ a r h)
    (hstep : ∀ r < T, ∀ h, a r h ^ 2
      ≤ 2 * (∫ u : ℝ, fejer H u * a (r + 1) (Fin.cons u h)) + 2 * δ) :
    a 0 Fin.elim0 ^ (2 ^ T) ≤ 2 ^ (2 ^ T) / 2 * (max (fejerMean H T (a T)) 0 + T * δ) := by
  classical
  let M : ℕ → ℝ := fun r => if r < T then fejerMean H r (a r) else max (fejerMean H T (a T)) 0
  have hMlt : ∀ r < T, M r = fejerMean H r (a r) := fun r hr => ite_eq_left hr
  have hMT : M T = max (fejerMean H T (a T)) 0 := ite_eq_right (lt_irrefl T)
  have hM0 : ∀ r, 0 ≤ M r := by
    intro r
    by_cases hr : r < T
    · rw [hMlt r hr]; exact fejerMean_nonneg hH (ha0 r hr)
    · simp only [M, ite_eq_right hr]; exact le_max_right _ _
  have hM1 : ∀ r, M r ≤ 1 := by
    intro r
    by_cases hr : r < T
    · rw [hMlt r hr]; exact (abs_le.mp (abs_fejerMean_le_one hH (ham r) (ha1 r))).2
    · simp only [M, ite_eq_right hr]
      exact max_le (abs_le.mp (abs_fejerMean_le_one hH (ham T) (ha1 T))).2 zero_le_one
  have hrec : ∀ r, r < T → csPhi (M r) ≤ M (r + 1) + δ := by
    intro r hr
    have hs := fejerMean_sq_le hH (ham r) (ha1 r) (ham (r + 1)) (ha1 (r + 1)) (hstep r hr)
    have hnext : fejerMean H (r + 1) (a (r + 1)) ≤ M (r + 1) := by
      by_cases hr1 : r + 1 < T
      · rw [hMlt _ hr1]
      · have : r + 1 = T := by omega
        subst this
        rw [hMT]; exact le_max_left _ _
    rw [hMlt r hr, csPhi]
    linarith
  have hc := csLoss hδ hM0 hM1 hrec (le_of_eq hMT)
  rcases Nat.eq_zero_or_pos T with hT | hT
  · subst hT
    simp only [pow_zero, pow_one, CharP.cast_eq_zero, zero_mul, add_zero]
    rw [fejerMean_zero]
    norm_num
  · rw [hMlt 0 hT, fejerMean_zero] at hc
    exact hc

