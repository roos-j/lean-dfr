/-! ### A level of the chain and the step to the next level

A level of the chain is the normalized correlation `A = V⁻¹ ∫ g(x) E_{t ∈ [0,N]} F(x,t) dx` of
a spatial block `g` against a PET family times a phase. `Auto.vecStep_phase` bounds `|A|^2` by the
Fejer average of the children's correlation; the next level puts a spatial block back (the enlarged
box's indicator, or the constant children) and averages over `x` last again. -/

/-- The level quantity `V⁻¹ ∫ g(x) E_{t ∈ [0,N]} ∏ blocks · φ dx`. -/
noncomputable def vecAmp (V N : ℝ) (g : E3 → ℂ) (L : PetFam) (φ : E3 → ℝ → ℂ) : ℂ :=
  (V⁻¹ : ℝ) • ∫ x, g x * ((N⁻¹ : ℝ) • ∫ t in (0 : ℝ)..(0 + N), vecProd L x t * φ x t)

theorem vecChildren_facts {L : PetFam} (hL : ∀ b ∈ L, Measurable b.1 ∧ Continuous b.2)
    (hL1 : ∀ b ∈ L, ∀ y, ‖b.1 y‖ ≤ 1) {Qp : ℝ → E3} (hQp : Continuous Qp) (u : ℝ) :
    (∀ b ∈ vecChildren L Qp u, Measurable b.1 ∧ Continuous b.2)
      ∧ (∀ b ∈ vecChildren L Qp u, ∀ y, ‖b.1 y‖ ≤ 1) := by
  constructor
  · intro b hb
    simp only [vecChildren, List.mem_flatMap, List.mem_cons, List.not_mem_nil, or_false] at hb
    obtain ⟨b0, hb0, rfl | rfl⟩ := hb
    · exact ⟨(hL b0 hb0).1, ((hL b0 hb0).2.comp (continuous_id.add continuous_const)).sub hQp⟩
    · exact ⟨Complex.continuous_conj.measurable.comp (hL b0 hb0).1, (hL b0 hb0).2.sub hQp⟩
  · intro b hb y
    simp only [vecChildren, List.mem_flatMap, List.mem_cons, List.not_mem_nil, or_false] at hb
    obtain ⟨b0, hb0, rfl | rfl⟩ := hb
    · exact hL1 b0 hb0 y
    · simpa using hL1 b0 hb0 y

theorem measurable_phaseChild {φ : E3 → ℝ → ℂ} (hφm : Measurable (Function.uncurry φ))
    {Qp : ℝ → E3} (hQp : Continuous Qp) (u : ℝ) :
    Measurable (Function.uncurry (phaseChild φ Qp u)) := by
  have h1 : Measurable fun z : E3 × ℝ => φ (z.1 - Qp z.2) (z.2 + u) :=
    hφm.comp ((measurable_fst.sub (hQp.measurable.comp measurable_snd)).prodMk
      (measurable_snd.add_const u))
  have h2 : Measurable fun z : E3 × ℝ => φ (z.1 - Qp z.2) z.2 :=
    hφm.comp ((measurable_fst.sub (hQp.measurable.comp measurable_snd)).prodMk measurable_snd)
  have : Function.uncurry (phaseChild φ Qp u)
      = fun z : E3 × ℝ => φ (z.1 - Qp z.2) (z.2 + u) * conj (φ (z.1 - Qp z.2) z.2) := by
    funext z; rfl
  rw [this]
  exact h1.mul (Complex.continuous_conj.measurable.comp h2)

theorem norm_phaseChild_le {φ : E3 → ℝ → ℂ} (hφ1 : ∀ x t, ‖φ x t‖ ≤ 1) (Qp : ℝ → E3)
    (u : ℝ) (x : E3) (t : ℝ) : ‖phaseChild φ Qp u x t‖ ≤ 1 := by
  rw [phaseChild, norm_mul, Complex.norm_conj]
  exact ((mul_le_of_le_one_left (norm_nonneg _) (hφ1 _ _)).trans (hφ1 _ _))

/-- **The correlation of the children is `V N` times the next level**, when the children's
integrand factors as a spatial block times the next family and phase for `t ∈ [0, N]`: the
integrals over `t` and `x` are exchanged (the integrand is bounded and has bounded support), and
the constants are pulled out. -/
theorem integral_children_eq_vecAmp {N V : ℝ} (hN : 0 < N) {b : (E3 → ℂ) × (ℝ → E3)}
    {L : PetFam} (hL : ∀ b' ∈ b :: L, Measurable b'.1 ∧ Continuous b'.2)
    (hL1 : ∀ b' ∈ b :: L, ∀ y, ‖b'.1 y‖ ≤ 1)
    {φ : E3 → ℝ → ℂ} (hφm : Measurable (Function.uncurry φ)) (hφ1 : ∀ x t, ‖φ x t‖ ≤ 1)
    {K : Set E3} (hKb : Bornology.IsBounded K) (hb : ∀ y, y ∉ K → b.1 y = 0)
    {Qp : ℝ → E3} (hQp : Continuous Qp) (u : ℝ)
    {g' : E3 → ℂ} {L' : PetFam} {φ' : E3 → ℝ → ℂ}
    (hid : ∀ t ∈ Set.Icc (0 : ℝ) N, ∀ x, vecProd (vecChildren (b :: L) Qp u) x t
      * phaseChild φ Qp u x t = g' x * (vecProd L' x t * φ' x t)) :
    (V⁻¹ * N⁻¹ : ℝ) • (∫ t in (0 : ℝ)..(0 + N), ∫ x,
        vecProd (vecChildren (b :: L) Qp u) x t * phaseChild φ Qp u x t)
      = vecAmp V N g' L' φ' := by
  set X : E3 → ℝ → ℂ := fun x t =>
    vecProd (vecChildren (b :: L) Qp u) x t * phaseChild φ Qp u x t with hX
  obtain ⟨hcm, hc1⟩ := vecChildren_facts hL hL1 hQp u
  have hXm : Measurable (Function.uncurry X) :=
    (measurable_vecProd hcm).mul (measurable_phaseChild hφm hQp u)
  have hX1 : ∀ x t, ‖X x t‖ ≤ 1 := fun x t => by
    simp only [hX, norm_mul]
    exact ((mul_le_of_le_one_left (norm_nonneg _) (norm_vecProd_le hc1 x t)).trans
      (norm_phaseChild_le hφ1 Qp u x t))
  obtain ⟨R₀, hR₀⟩ := hKb.subset_closedBall (0 : E3)
  have hsc : Continuous fun t => b.2 (t + u) - Qp t :=
    ((hL b (by simp)).2.comp (continuous_id.add continuous_const)).sub hQp
  obtain ⟨B, hB⟩ : ∃ B, ∀ t ∈ Set.Icc (0 : ℝ) N, ‖b.2 (t + u) - Qp t‖ ≤ B :=
    (isCompact_Icc.image_of_continuousOn hsc.continuousOn).isBounded.exists_norm_le.imp
      fun B hB t ht => hB _ ⟨t, ht, rfl⟩
  have hXz : ∀ x t, t ∈ Set.Icc (0 : ℝ) N → R₀ + B < ‖x‖ → X x t = 0 := by
    intro x t ht hx
    have hnK : x + (b.2 (t + u) - Qp t) ∉ K := fun hK => by
      have h1 := hR₀ hK
      rw [Metric.mem_closedBall, dist_zero_right] at h1
      have := norm_sub_norm_le x (-(b.2 (t + u) - Qp t))
      rw [norm_neg, sub_neg_eq_add] at this
      linarith [hB t ht]
    have hc : vecChildren (b :: L) Qp u = (b.1, fun t => b.2 (t + u) - Qp t)
        :: (fun y => conj (b.1 y), fun t => b.2 t - Qp t) :: vecChildren L Qp u := by
      simp [vecChildren]
    simp only [hX, hc, vecProd_cons, hb _ hnK, zero_mul]
  have hle : (0 : ℝ) ≤ 0 + N := by linarith
  have hsub : Set.Ioc (0 : ℝ) (0 + N) ⊆ Set.Icc 0 N := fun t ht => by
    rw [zero_add] at ht; exact ⟨ht.1.le, ht.2⟩
  have hint : Integrable (Function.uncurry fun (x : E3) (t : ℝ) => X x t)
      ((volume : Measure E3).prod (volume.restrict (Set.Ioc (0 : ℝ) (0 + N)))) :=
    integrable_prod_restrict_of_bdd_ball measurableSet_Ioc measure_Ioc_lt_top.ne
      hXm.aestronglyMeasurable (C := 1) (R := R₀ + B) (fun z => hX1 z.1 z.2)
      (fun z hz hR => hXz z.1 z.2 (hsub hz) hR)
  have hswap := integral_integral_swap hint
  have hin : ∀ x, (∫ t in Set.Ioc (0 : ℝ) (0 + N), X x t)
      = g' x * ∫ t in Set.Ioc (0 : ℝ) (0 + N), vecProd L' x t * φ' x t := by
    intro x
    rw [← integral_const_mul]
    exact setIntegral_congr_fun measurableSet_Ioc fun t ht => hid t (hsub ht) x
  rw [intervalIntegral.integral_of_le hle, ← hswap]
  simp_rw [hin]
  rw [vecAmp]
  simp_rw [intervalIntegral.integral_of_le hle]
  rw [mul_smul, ← integral_smul]
  congr 1
  congr 1
  funext x
  exact (mul_smul_comm _ _ _).symm

/-- **One step between consecutive levels of the chain** (blueprint `patch:pet-analytic-step`
followed by reinstating a spatial block): if the children's integrand factors, for `|u| ≤ H` and
`t ∈ [0, N]`, as a spatial block `g'_u` times a family `L'_u` and phase `φ'_u`, then
`|A|^2 ≤ 2 E_{u ~ κ_H} |A'(u)| + 2H/N` with `A'(u)` the level of `(g'_u, L'_u, φ'_u)`. -/
theorem vecAmp_step {N H V : ℝ} (hN : 0 < N) (hH : 0 < H) (hHN : H ≤ N / 4) (hV : 0 < V)
    {b : (E3 → ℂ) × (ℝ → E3)} {L : PetFam}
    (hL : ∀ b' ∈ b :: L, Measurable b'.1 ∧ Continuous b'.2)
    (hL1 : ∀ b' ∈ b :: L, ∀ y, ‖b'.1 y‖ ≤ 1)
    {φ : E3 → ℝ → ℂ} (hφm : Measurable (Function.uncurry φ)) (hφ1 : ∀ x t, ‖φ x t‖ ≤ 1)
    {K : Set E3} (hKm : MeasurableSet K) (hKb : Bornology.IsBounded K)
    (hb : ∀ y, y ∉ K → b.1 y = 0) (hKV : (volume K).toReal ≤ V)
    {g : E3 → ℂ} (hgm : Measurable g) (hg1 : ∀ x, ‖g x‖ ≤ 1) {Rg : ℝ}
    (hgR : ∀ x, Rg < ‖x‖ → g x = 0) (hgV : (∫ x, ‖g x‖ ^ 2) ≤ V)
    {Qp : ℝ → E3} (hQp : Continuous Qp)
    {g' : ℝ → E3 → ℂ} {L' : ℝ → PetFam} {φ' : ℝ → E3 → ℝ → ℂ}
    (hid : ∀ u, |u| ≤ H → ∀ t ∈ Set.Icc (0 : ℝ) N, ∀ x,
      vecProd (vecChildren (b :: L) Qp u) x t * phaseChild φ Qp u x t
        = g' u x * (vecProd (L' u) x t * φ' u x t))
    (hAm : Measurable fun u => ‖vecAmp V N (g' u) (L' u) (φ' u)‖)
    (hA1 : ∀ u, |u| ≤ H → ‖vecAmp V N (g' u) (L' u) (φ' u)‖ ≤ 1) :
    ‖vecAmp V N g (b :: L) φ‖ ^ 2
      ≤ 2 * (∫ u : ℝ, fejer H u * ‖vecAmp V N (g' u) (L' u) (φ' u)‖) + 2 * H / N := by
  have key := vecStep_phase (c := 0) hN hH hHN hV hL hL1 hφm hφ1 hKm hKb hb hKV hgm hg1 hgR
    hgV Qp
  set Z : ℝ → ℂ := fun u => ∫ t in (0 : ℝ)..(0 + N), ∫ x,
    vecProd (vecChildren (b :: L) Qp u) x t * phaseChild φ Qp u x t with hZ
  set A' : ℝ → ℝ := fun u => ‖vecAmp V N (g' u) (L' u) (φ' u)‖ with hA'
  have hfA : Integrable fun u => fejer H u * A' u := by
    refine (integrable_fejer hH).mono' ((continuous_fejer.measurable.mul hAm).aestronglyMeasurable)
      (.of_forall fun u => ?_)
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (fejer_nonneg hH u), abs_of_nonneg (norm_nonneg _)]
    by_cases hu : |u| ≤ H
    · exact mul_le_of_le_one_right (fejer_nonneg hH u) (hA1 u hu)
    · rw [fejer_eq_zero_of_le hH (le_of_lt (not_le.mp hu)), zero_mul]
  have hpt : ∀ u, V⁻¹ * N⁻¹ * (fejer H u * (Z u).re) ≤ fejer H u * A' u := by
    intro u
    by_cases hu : |u| ≤ H
    · have heq := integral_children_eq_vecAmp (V := V) hN hL hL1 hφm hφ1 hKb hb hQp u
        (hid u hu)
      have hre : V⁻¹ * N⁻¹ * (Z u).re = (vecAmp V N (g' u) (L' u) (φ' u)).re := by
        rw [← heq, Complex.smul_re, smul_eq_mul]
      calc V⁻¹ * N⁻¹ * (fejer H u * (Z u).re) = fejer H u * (V⁻¹ * N⁻¹ * (Z u).re) := by ring
        _ ≤ fejer H u * A' u := by
          rw [hre]
          exact mul_le_mul_of_nonneg_left (Complex.re_le_norm _) (fejer_nonneg hH u)
    · rw [fejer_eq_zero_of_le hH (le_of_lt (not_le.mp hu))]
      simp
  have hbound : V⁻¹ * N⁻¹ * (∫ u : ℝ, fejer H u • Z u).re ≤ ∫ u : ℝ, fejer H u * A' u := by
    by_cases hZi : Integrable fun u => fejer H u • Z u
    · have hre : (∫ u : ℝ, fejer H u • Z u).re = ∫ u : ℝ, fejer H u * (Z u).re := by
        rw [← integral_re_of_integrable hZi]
        congr 1
        funext u
        simp
      rw [hre, ← integral_const_mul]
      refine integral_mono ?_ hfA hpt
      have := (hZi.re).const_mul (V⁻¹ * N⁻¹)
      refine this.congr (.of_forall fun u => ?_)
      simp
    · rw [integral_undef hZi, Complex.zero_re, mul_zero]
      exact integral_nonneg fun u => mul_nonneg (fejer_nonneg hH u) (norm_nonneg _)
  have hL0 : vecAmp V N g (b :: L) φ = (V⁻¹ : ℝ) • ∫ x, g x * ((N⁻¹ : ℝ) •
      ∫ t in (0 : ℝ)..(0 + N), vecProd (b :: L) x t * φ x t) := rfl
  rw [hL0]
  linarith [key, hbound]

end

section
open Filter Topology MeasureTheory

/-! ### Bounds shared by every level -/

/-- A point of the box has norm at most the sum of the side half-lengths. -/
theorem norm_le_of_mem_petBox {C N : ℝ} {x : E3} (hx : x ∈ petBox C N) :
    ‖x‖ ≤ ∑ i : Fin 3, |C * N ^ expo i| := by
  have hco : ∀ i : Fin 3, ‖x i‖ ≤ |C * N ^ expo i| := by
    intro i
    have h1 := (hx i).1
    have h2 := (hx i).2
    rw [Real.norm_eq_abs, abs_le]
    constructor <;> linarith [le_abs_self (C * N ^ expo i), neg_abs_le (C * N ^ expo i)]
  have hnn : ∀ i : Fin 3, 0 ≤ |C * N ^ expo i| := fun i => abs_nonneg _
  rw [EuclideanSpace.norm_eq]
  have hsq : ∑ i : Fin 3, ‖x i‖ ^ 2 ≤ (∑ i : Fin 3, |C * N ^ expo i|) ^ 2 := by
    rw [Fin.sum_univ_three, Fin.sum_univ_three]
    nlinarith [hco 0, hco 1, hco 2, norm_nonneg (x 0), norm_nonneg (x 1), norm_nonneg (x 2),
      hnn 0, hnn 1, hnn 2]
  calc Real.sqrt (∑ i : Fin 3, ‖x i‖ ^ 2) ≤ Real.sqrt ((∑ i : Fin 3, |C * N ^ expo i|) ^ 2) :=
        Real.sqrt_le_sqrt hsq
    _ = _ := Real.sqrt_sq (Finset.sum_nonneg fun i _ => hnn i)

theorem isBounded_petBox (C N : ℝ) : Bornology.IsBounded (petBox C N) :=
  (Metric.isBounded_closedBall (x := (0 : E3))
    (r := ∑ i : Fin 3, |C * N ^ expo i|)).subset fun x hx => by
      rw [Metric.mem_closedBall, dist_zero_right]; exact norm_le_of_mem_petBox hx

theorem petBox_mono {C C' N : ℝ} (hCC : C ≤ C') (hN : 0 ≤ N) : petBox C N ⊆ petBox C' N := by
  intro x hx i
  have h := hx i
  have hNi : 0 ≤ N ^ expo i := pow_nonneg hN _
  have hle : C * N ^ expo i ≤ C' * N ^ expo i := mul_le_mul_of_nonneg_right hCC hNi
  exact ⟨by linarith [h.1], by linarith [h.2]⟩

theorem volume_petBox_ne_top (C N : ℝ) : volume (petBox C N) ≠ ⊤ :=
  (isBounded_petBox C N).measure_lt_top.ne

/-- The box indicator as a spatial block. -/
noncomputable def boxInd (C N : ℝ) : E3 → ℂ := (petBox C N).indicator fun _ => (1 : ℂ)

theorem measurable_boxInd (C N : ℝ) : Measurable (boxInd C N) :=
  measurable_const.indicator (measurableSet_petBox C N)

theorem norm_boxInd_le (C N : ℝ) (x : E3) : ‖boxInd C N x‖ ≤ 1 := by
  by_cases hx : x ∈ petBox C N
  · simp [boxInd, Set.indicator_of_mem hx]
  · simp [boxInd, Set.indicator_of_notMem hx]

theorem boxInd_eq_zero {C N : ℝ} {x : E3} (hx : ∑ i : Fin 3, |C * N ^ expo i| < ‖x‖) :
    boxInd C N x = 0 :=
  Set.indicator_of_notMem (fun hmem => by linarith [norm_le_of_mem_petBox hmem]) _

theorem integrable_boxInd (C N : ℝ) : Integrable (boxInd C N) := by
  rw [boxInd, integrable_indicator_iff (measurableSet_petBox C N)]
  exact integrableOn_const (volume_petBox_ne_top C N) (by simp)

theorem integral_norm_boxInd (C N : ℝ) :
    (∫ x, ‖boxInd C N x‖) = (volume (petBox C N)).toReal := by
  have : (fun x => ‖boxInd C N x‖) = (petBox C N).indicator fun _ => (1 : ℝ) := by
    funext x
    by_cases hx : x ∈ petBox C N
    · simp [boxInd, Set.indicator_of_mem hx]
    · simp [boxInd, Set.indicator_of_notMem hx]
  rw [this, integral_indicator (measurableSet_petBox C N), setIntegral_const, smul_eq_mul,
    mul_one, Measure.real]

theorem integral_sq_boxInd (C N : ℝ) :
    (∫ x, ‖boxInd C N x‖ ^ 2) = (volume (petBox C N)).toReal := by
  have : (fun x => ‖boxInd C N x‖ ^ 2) = fun x => ‖boxInd C N x‖ := by
    funext x
    by_cases hx : x ∈ petBox C N
    · simp [boxInd, Set.indicator_of_mem hx]
    · simp [boxInd, Set.indicator_of_notMem hx]
  rw [this, integral_norm_boxInd]

/-- **Every level is at most one** when the spatial block has `L^1` mass at most `V`. -/
theorem norm_vecAmp_le_one {V N : ℝ} (hV : 0 < V) (hN : 0 < N) {g : E3 → ℂ}
    (hgi : Integrable g) (hgV : (∫ x, ‖g x‖) ≤ V) {L : PetFam}
    (hL1 : ∀ b ∈ L, ∀ y, ‖b.1 y‖ ≤ 1) {φ : E3 → ℝ → ℂ} (hφ1 : ∀ x t, ‖φ x t‖ ≤ 1) :
    ‖vecAmp V N g L φ‖ ≤ 1 := by
  have hVinv : 0 ≤ V⁻¹ := inv_nonneg.mpr hV.le
  have hptw : ∀ x, ‖g x * ((N⁻¹ : ℝ) • ∫ t in (0 : ℝ)..(0 + N), vecProd L x t * φ x t)‖
      ≤ ‖g x‖ := by
    intro x
    have hb : ‖∫ t in (0 : ℝ)..(0 + N), vecProd L x t * φ x t‖ ≤ 1 * |0 + N - 0| :=
      intervalIntegral.norm_integral_le_of_norm_le_const fun t _ => by
        rw [norm_mul]
        exact ((mul_le_of_le_one_left (norm_nonneg _) (norm_vecProd_le hL1 x t)).trans (hφ1 x t))
    have e : (1 : ℝ) * |0 + N - 0| = N := by rw [zero_add, sub_zero, abs_of_pos hN, one_mul]
    rw [e] at hb
    rw [norm_mul, norm_smul, Real.norm_eq_abs, abs_of_nonneg (inv_nonneg.mpr hN.le)]
    calc ‖g x‖ * (N⁻¹ * ‖∫ t in (0 : ℝ)..(0 + N), vecProd L x t * φ x t‖)
        ≤ ‖g x‖ * (N⁻¹ * N) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hb (inv_nonneg.mpr hN.le))
            (norm_nonneg _)
      _ = ‖g x‖ := by rw [inv_mul_cancel₀ hN.ne', mul_one]
  rw [vecAmp, norm_smul, Real.norm_eq_abs, abs_of_nonneg hVinv]
  calc V⁻¹ * ‖∫ x, g x * ((N⁻¹ : ℝ) • ∫ t in (0 : ℝ)..(0 + N), vecProd L x t * φ x t)‖
      ≤ V⁻¹ * ∫ x, ‖g x‖ := by
        refine mul_le_mul_of_nonneg_left ((norm_integral_le_integral_norm _).trans ?_) hVinv
        exact integral_mono_of_nonneg (.of_forall fun x => norm_nonneg _) hgi.norm
          (.of_forall hptw)
    _ ≤ V⁻¹ * V := mul_le_mul_of_nonneg_left hgV hVinv
    _ = 1 := inv_mul_cancel₀ hV.ne'

/-- **Every level is measurable in its shift parameters** when its data are jointly measurable. -/
theorem measurable_vecAmp_param {ι : Type*} [MeasurableSpace ι] (V N : ℝ) {G : ι → E3 → ℂ}
    {F : ι → E3 → ℝ → ℂ} (hG : Measurable fun q : ι × E3 => G q.1 q.2)
    (hF : Measurable fun q : (ι × E3) × ℝ => F q.1.1 q.1.2 q.2) :
    Measurable fun i => (V⁻¹ : ℝ) • ∫ x, G i x
      * ((N⁻¹ : ℝ) • ∫ t in (0 : ℝ)..(0 + N), F i x t) := by
  have hin : Measurable fun q : ι × E3 => ∫ t in (0 : ℝ)..(0 + N), F q.1 q.2 t := by
    rcases le_total (0 : ℝ) (0 + N) with hle | hle
    · simp_rw [intervalIntegral.integral_of_le hle]
      exact (hF.stronglyMeasurable.integral_prod_right'
        (ν := volume.restrict (Set.Ioc (0 : ℝ) (0 + N)))).measurable
    · simp_rw [intervalIntegral.integral_of_ge hle]
      exact ((hF.stronglyMeasurable.integral_prod_right'
        (ν := volume.restrict (Set.Ioc (0 + N) (0 : ℝ)))).measurable).neg
  have hout : Measurable fun q : ι × E3 =>
      G q.1 q.2 * ((N⁻¹ : ℝ) • ∫ t in (0 : ℝ)..(0 + N), F q.1 q.2 t) :=
    hG.mul ((continuous_const_smul (N⁻¹ : ℝ)).measurable.comp hin)
  exact (continuous_const_smul (V⁻¹ : ℝ)).measurable.comp
    (hout.stronglyMeasurable.integral_prod_right' (ν := (volume : Measure E3))).measurable

/-! ### The four phase steps as levels `0` to `4` of the chain

Blueprint `patch:highest-control`, "Polynomial phases: the four initial steps are also explicit".
The level-`r` integrand is the parity cube `Auto.phaseProdIter` of the phased product; it is
carried as the phase of a one-block family whose block is the indicator of the protected input's
box along the protected shift, which the cube's zero vertex makes harmless. -/

/-- The protected head block: the box indicator along the protected shift `-P_m(t) e_{j m}`. -/
noncomputable def phaseHead (C N : ℝ) (P : Polynomial ℝ) (j : Fin 3) :
    (E3 → ℂ) × (ℝ → E3) :=
  (boxInd C N, fun t => -((P.eval t) • basisVec j))

theorem phaseHead_facts (C N : ℝ) (P : Polynomial ℝ) (j : Fin 3) :
    (∀ b' ∈ [phaseHead C N P j], Measurable b'.1 ∧ Continuous b'.2)
      ∧ (∀ b' ∈ [phaseHead C N P j], ∀ y, ‖b'.1 y‖ ≤ 1) := by
  constructor
  · intro b' hb'
    rw [List.mem_singleton] at hb'
    subst hb'
    exact ⟨measurable_boxInd C N, (P.continuous.smul continuous_const).neg⟩
  · intro b' hb' y
    rw [List.mem_singleton] at hb'
    subst hb'
    exact norm_boxInd_le C N y

/-- The phase level: the level-`r` cube against the spatial block `g`. -/
noncomputable def phaseLevel (V N C : ℝ) (g : E3 → ℂ) (r m : ℕ) (f : ℕ → E3 → ℂ)
    (P : ℕ → Polynomial ℝ) (p : E3 → Polynomial ℝ) (j : ℕ → Fin 3) (h : Fin r → ℝ) : ℂ :=
  vecAmp V N g [phaseHead C N (P m) (j m)] fun x t => phaseProdIter r m f P p j x h t

open scoped Classical in
/-- The phased product vanishes where the protected input does. -/
theorem phaseProd_eq_zero_of_protected {m : ℕ} (hm : 1 ≤ m) {f : ℕ → E3 → ℂ}
    {P : ℕ → Polynomial ℝ} {p : E3 → Polynomial ℝ} {j : ℕ → Fin 3} {x : E3} {t : ℝ}
    (h0 : f m (x - ((P m).eval t) • basisVec (j m)) = 0) : phaseProd m f P p j x t = 0 := by
  rw [phaseProd, Finset.prod_eq_zero (Finset.mem_Icc.mpr ⟨hm, le_refl m⟩) h0, zero_mul]

/-- **The head block is harmless**: against the cube it is one wherever the cube is nonzero. -/
theorem vecProd_phaseHead_mul {C N : ℝ} {m : ℕ} (hm : 1 ≤ m) {f : ℕ → E3 → ℂ}
    (hsupp : ∀ y, y ∉ petBox C N → f m y = 0) (P : ℕ → Polynomial ℝ)
    (p : E3 → Polynomial ℝ) (j : ℕ → Fin 3) {r : ℕ} (h : Fin r → ℝ) (x : E3) (t : ℝ) :
    vecProd [phaseHead C N (P m) (j m)] x t * phaseProdIter r m f P p j x h t
      = phaseProdIter r m f P p j x h t := by
  rw [vecProd_cons, vecProd_nil, mul_one]
  simp only [phaseHead, ← sub_eq_add_neg]
  by_cases hx : x - ((P m).eval t) • basisVec (j m) ∈ petBox C N
  · rw [boxInd, Set.indicator_of_mem hx, one_mul]
  · rw [phaseProdIter_eq_zero_of_zero_vertex r m f P p j x h t
      (phaseProd_eq_zero_of_protected hm (hsupp _ hx)), mul_zero]

theorem measurable_uncurry_vecProd_phaseHead (C N : ℝ) (P : Polynomial ℝ) (j : Fin 3) :
    Measurable (Function.uncurry (vecProd [phaseHead C N P j])) :=
  measurable_vecProd (phaseHead_facts C N P j).1

/-- The phase level is measurable in its shifts. -/
theorem measurable_phaseLevel {V N C : ℝ} {g : E3 → ℂ} (hgm : Measurable g) (r m : ℕ)
    {f : ℕ → E3 → ℂ} {P : ℕ → Polynomial ℝ} {p : E3 → Polynomial ℝ} {j : ℕ → Fin 3}
    (hFm : Measurable (Function.uncurry fun (x : E3) (t : ℝ) => phaseProd m f P p j x t)) :
    Measurable fun h : Fin r → ℝ => phaseLevel V N C g r m f P p j h := by
  have hI := measurable_phaseProdIter_shift r m hFm
  have hhead := measurable_uncurry_vecProd_phaseHead C N (P m) (j m)
  have hmap : Measurable fun q : ((Fin r → ℝ) × E3) × ℝ =>
      (((q.1.2, q.1.1), q.2) : (E3 × (Fin r → ℝ)) × ℝ) :=
    ((measurable_snd.comp measurable_fst).prodMk (measurable_fst.comp measurable_fst)).prodMk
      measurable_snd
  have hc0 : Measurable ((fun q : (E3 × (Fin r → ℝ)) × ℝ =>
      phaseProdIter r m f P p j q.1.1 q.1.2 q.2) ∘ fun q : ((Fin r → ℝ) × E3) × ℝ =>
        (((q.1.2, q.1.1), q.2) : (E3 × (Fin r → ℝ)) × ℝ)) := hI.comp hmap
  have hc1 : Measurable fun q : ((Fin r → ℝ) × E3) × ℝ =>
      phaseProdIter r m f P p j q.1.2 q.1.1 q.2 := hc0
  have hh0 : Measurable ((Function.uncurry (vecProd [phaseHead C N (P m) (j m)])) ∘
      fun q : ((Fin r → ℝ) × E3) × ℝ => ((q.1.2, q.2) : E3 × ℝ)) :=
    hhead.comp ((measurable_snd.comp measurable_fst).prodMk measurable_snd)
  have hh1 : Measurable fun q : ((Fin r → ℝ) × E3) × ℝ =>
      vecProd [phaseHead C N (P m) (j m)] q.1.2 q.2 := hh0
  have hF := hh1.mul hc1
  exact measurable_vecAmp_param V N (G := fun _ => g)
    (F := fun h x t => vecProd [phaseHead C N (P m) (j m)] x t * phaseProdIter r m f P p j x h t)
    (hgm.comp measurable_snd) hF

/-- **Translating by a shift bounded in units of the box side lands in the enlarged box.** -/
theorem mem_petBox_of_sub_mem_scaled {C K N : ℝ} (hK : 0 ≤ K) (hN : 0 ≤ N) {j : Fin 3}
    {a : ℝ} (ha : |a| ≤ K * N ^ expo j) {x : E3} (hx : x - a • basisVec j ∈ petBox C N) :
    x ∈ petBox (C + K) N := by
  intro i
  have hxi : (x - a • basisVec j) i = x i - a * (if i = j then 1 else 0) := by
    simp [basisVec_apply]
  have hmem := hx i
  rw [Set.mem_Icc] at hmem ⊢
  rw [hxi] at hmem
  have hNi : (0 : ℝ) ≤ N ^ expo i := pow_nonneg hN _
  by_cases hij : i = j
  · subst hij
    rw [ite_eq_left rfl, mul_one] at hmem
    have := abs_le.mp ha
    constructor <;> nlinarith [hmem.1, hmem.2]
  · rw [ite_eq_right hij, mul_zero, sub_zero] at hmem
    have : 0 ≤ K * N ^ expo i := mul_nonneg hK hNi
    constructor <;> nlinarith [hmem.1, hmem.2]

open scoped Classical in
/-- **The cube lives in the enlarged box**, with the protected shift bounded in units of its box
side. -/
theorem phaseProdIter_eq_zero_of_notMem_scaled (r m : ℕ) (f : ℕ → E3 → ℂ) (P : ℕ → Polynomial ℝ)
    (p : E3 → Polynomial ℝ) (j : ℕ → Fin 3) {C K N : ℝ} (hN : 0 ≤ N) (hK : 0 ≤ K)
    (hm : 1 ≤ m) (hsupp : ∀ y, y ∉ petBox C N → f m y = 0)
    {t : ℝ} (hbd : |(P m).eval t| ≤ K * N ^ expo (j m))
    {x : E3} (hx : x ∉ petBox (C + K) N) (h : Fin r → ℝ) :
    phaseProdIter r m f P p j x h t = 0 := by
  refine phaseProdIter_eq_zero_of_zero_vertex r m f P p j x h t ?_
  rw [phaseProd]
  have hzero : f m (x - ((P m).eval t) • basisVec (j m)) = 0 := by
    refine hsupp _ fun hmem => ?_
    exact hx (mem_petBox_of_sub_mem_scaled hK hN hbd hmem)
  rw [Finset.prod_eq_zero (Finset.mem_Icc.mpr ⟨hm, le_refl m⟩) hzero, zero_mul]

/-- **One phase step between consecutive levels.** The level-`r` cube against a spatial block `g`
is controlled by the Fejer average of the level-`(r+1)` cube against the enlarged box's
indicator, where `V` is that box's volume. -/
theorem phaseLevel_step {N H C K : ℝ} (hN1 : 1 ≤ N) (hH : 0 < H) (hHN : H ≤ N / 4)
    (hC : 0 < C) (hK : 0 ≤ K) {r m : ℕ} (hm : 1 ≤ m) {f : ℕ → E3 → ℂ}
    {P : ℕ → Polynomial ℝ} {p : E3 → Polynomial ℝ} {j : ℕ → Fin 3}
    (hf1 : ∀ i y, ‖f i y‖ ≤ 1)
    (hFm : Measurable (Function.uncurry fun (x : E3) (t : ℝ) => phaseProd m f P p j x t))
    (hsupp : ∀ y, y ∉ petBox C N → f m y = 0)
    (hbd : ∀ t ∈ Set.Icc (0 : ℝ) N, |(P m).eval t| ≤ K * N ^ expo (j m))
    {g : E3 → ℂ} (hgm : Measurable g) (hg1 : ∀ x, ‖g x‖ ≤ 1) {Rg : ℝ}
    (hgR : ∀ x, Rg < ‖x‖ → g x = 0)
    (hgV : (∫ x, ‖g x‖ ^ 2) ≤ (volume (petBox (C + K) N)).toReal) (h : Fin r → ℝ) :
    ‖phaseLevel (volume (petBox (C + K) N)).toReal N C g r m f P p j h‖ ^ 2
      ≤ 2 * (∫ u : ℝ, fejer H u * ‖phaseLevel (volume (petBox (C + K) N)).toReal N C
          (boxInd (C + K) N) (r + 1) m f P p j (Fin.cons u h)‖) + 2 * H / N := by
  set V := (volume (petBox (C + K) N)).toReal with hVdef
  have hN : 0 < N := by linarith
  have hCK : 0 < C + K := by linarith
  have hV : 0 < V := by
    rw [hVdef, volume_petBox hCK.le hN.le, ENNReal.toReal_ofReal (by positivity)]
    positivity
  have hKV : (volume (petBox C N)).toReal ≤ V :=
    ENNReal.toReal_mono (volume_petBox_ne_top _ _)
      (measure_mono (petBox_mono (by linarith) hN.le))
  obtain ⟨hL, hL1⟩ := phaseHead_facts C N (P m) (j m)
  have hφm : Measurable (Function.uncurry fun (x : E3) (t : ℝ) =>
      phaseProdIter r m f P p j x h t) :=
    measurable_uncurry_phaseProdIter r m hFm h
  have hhead : ∀ y, y ∉ petBox C N → (phaseHead C N (P m) (j m)).1 y = 0 := fun y hy =>
    (Set.indicator_of_notMem hy _ : boxInd C N y = 0)
  have hid : ∀ u, |u| ≤ H → ∀ t ∈ Set.Icc (0 : ℝ) N, ∀ x,
      vecProd (vecChildren [phaseHead C N (P m) (j m)] 0 u) x t
          * phaseChild (fun x t => phaseProdIter r m f P p j x h t) 0 u x t
        = (fun _ => boxInd (C + K) N) u x * (vecProd ((fun _ => [phaseHead C N (P m) (j m)]) u) x t
          * (fun u x t => phaseProdIter (r + 1) m f P p j x (Fin.cons u h) t) u x t) := by
    intro u _ t ht x
    simp only
    rw [vecProd_phaseHead_mul hm hsupp P p j]
    have hz : boxInd (C + K) N x * phaseProdIter (r + 1) m f P p j x (Fin.cons u h) t
        = phaseProdIter (r + 1) m f P p j x (Fin.cons u h) t := by
      by_cases hx : x ∈ petBox (C + K) N
      · rw [boxInd, Set.indicator_of_mem hx, one_mul]
      · rw [phaseProdIter_eq_zero_of_notMem_scaled (r + 1) m f P p j (by linarith) hK hm hsupp
          (hbd t ht) hx, mul_zero]
    rw [hz, phaseProdIter_cons]
    have e1 := vecProd_phaseHead_mul hm hsupp P p j h x (t + u)
    have e2 := vecProd_phaseHead_mul hm hsupp P p j h x t
    rw [← e1, ← e2]
    simp only [vecChildren, List.flatMap_cons, List.flatMap_nil, List.append_nil, vecProd_cons,
      vecProd_nil, phaseChild, Pi.zero_apply, sub_zero, mul_one, map_mul]
    ring
  have hAm : Measurable fun u : ℝ => ‖vecAmp V N ((fun _ => boxInd (C + K) N) u)
      ((fun _ => [phaseHead C N (P m) (j m)]) u)
      ((fun u x t => phaseProdIter (r + 1) m f P p j x (Fin.cons u h) t) u)‖ := by
    have h1 := measurable_phaseLevel (V := V) (N := N) (C := C) (measurable_boxInd (C + K) N)
      (r + 1) m hFm
    have h2 : Measurable fun u : ℝ => (Fin.cons u h : Fin (r + 1) → ℝ) :=
      (measurable_fin_cons_real r).comp (measurable_id.prodMk measurable_const)
    exact (h1.comp h2).norm
  have hA1 : ∀ u, |u| ≤ H → ‖vecAmp V N ((fun _ => boxInd (C + K) N) u)
      ((fun _ => [phaseHead C N (P m) (j m)]) u)
      ((fun u x t => phaseProdIter (r + 1) m f P p j x (Fin.cons u h) t) u)‖ ≤ 1 := fun u _ =>
    norm_vecAmp_le_one hV hN (integrable_boxInd _ _) (le_of_eq (integral_norm_boxInd _ _)) hL1
      fun x t => norm_phaseProdIter_le_one (r + 1) m hf1 P p j x _ t
  exact vecAmp_step hN hH hHN hV hL hL1 hφm
    (fun x t => norm_phaseProdIter_le_one r m hf1 P p j x h t) (measurableSet_petBox C N)
    (isBounded_petBox C N) hhead hKV hgm hg1 hgR hgV continuous_const hid hAm hA1

end

section
open Filter Topology MeasureTheory

/-- The support of the product Fejer density: every shift at most `H`. -/
def fejerBox (H : ℝ) (r : ℕ) : Set (Fin r → ℝ) := {h | ∀ l, |h l| ≤ H}

theorem measurableSet_fejerBox (H : ℝ) (r : ℕ) : MeasurableSet (fejerBox H r) := by
  have : fejerBox H r = ⋂ l : Fin r, {h : Fin r → ℝ | |h l| ≤ H} := by
    ext h; simp [fejerBox]
  rw [this]
  exact MeasurableSet.iInter fun l =>
    measurableSet_le ((continuous_apply l).abs.measurable) measurable_const

theorem prod_fejer_eq_zero_of_notMem {H : ℝ} (hH : 0 < H) {r : ℕ} {h : Fin r → ℝ}
    (hh : h ∉ fejerBox H r) : ∏ l : Fin r, fejer H (h l) = 0 := by
  simp only [fejerBox, Set.mem_ofPred_eq, not_forall, not_le] at hh
  obtain ⟨l, hl⟩ := hh
  exact Finset.prod_eq_zero (Finset.mem_univ l) (fejer_eq_zero_of_le hH hl.le)

theorem fin_cons_mem_fejerBox {H : ℝ} {r : ℕ} {u : ℝ} {h : Fin r → ℝ} (hu : |u| ≤ H)
    (hh : h ∈ fejerBox H r) : (Fin.cons u h : Fin (r + 1) → ℝ) ∈ fejerBox H (r + 1) := by
  intro l
  refine Fin.cases ?_ (fun l => ?_) l
  · simpa using hu
  · simpa using hh l

theorem fin_cons_notMem_fejerBox {H : ℝ} {r : ℕ} (u : ℝ) {h : Fin r → ℝ}
    (hh : h ∉ fejerBox H r) : (Fin.cons u h : Fin (r + 1) → ℝ) ∉ fejerBox H (r + 1) := by
  intro hc
  exact hh fun l => by simpa using hc l.succ

/-- **`patch:cs-loss` along a chain whose levels are controlled only on the support of the shift
densities**, the form in which support bounds depending on the shifts can be used. -/
theorem fejerChain_box {T : ℕ} {a : (r : ℕ) → (Fin r → ℝ) → ℝ} {H δ : ℝ} (hH : 0 < H)
    (hδ : 0 ≤ δ) (ham : ∀ r, Measurable (a r))
    (ha1 : ∀ r, ∀ h ∈ fejerBox H r, |a r h| ≤ 1)
    (ha0 : ∀ r < T, ∀ h ∈ fejerBox H r, 0 ≤ a r h)
    (hstep : ∀ r < T, ∀ h ∈ fejerBox H r, a r h ^ 2
      ≤ 2 * (∫ u : ℝ, fejer H u * a (r + 1) (Fin.cons u h)) + 2 * δ) :
    a 0 Fin.elim0 ^ (2 ^ T) ≤ 2 ^ (2 ^ T) / 2 * (max (fejerMean H T (a T)) 0 + T * δ) := by
  classical
  let a' : (r : ℕ) → (Fin r → ℝ) → ℝ := fun r h => if h ∈ fejerBox H r then a r h else 0
  have ha'in : ∀ r, ∀ h ∈ fejerBox H r, a' r h = a r h := fun r h hh => ite_eq_left hh
  have ha'out : ∀ r, ∀ h ∉ fejerBox H r, a' r h = 0 := fun r h hh => ite_eq_right hh
  have hmean : ∀ r, fejerMean H r (a' r) = fejerMean H r (a r) := by
    intro r
    refine integral_congr_ae (.of_forall fun h => ?_)
    by_cases hh : h ∈ fejerBox H r
    · simp only [ha'in r h hh]
    · simp only [prod_fejer_eq_zero_of_notMem hH hh, zero_mul]
  have hinner : ∀ r, ∀ h ∈ fejerBox H r, (∫ u : ℝ, fejer H u * a' (r + 1) (Fin.cons u h))
      = ∫ u : ℝ, fejer H u * a (r + 1) (Fin.cons u h) := by
    intro r h hh
    refine integral_congr_ae (.of_forall fun u => ?_)
    by_cases hu : |u| ≤ H
    · simp only [ha'in _ _ (fin_cons_mem_fejerBox hu hh)]
    · simp only [fejer_eq_zero_of_le hH (not_le.mp hu).le, zero_mul]
  have h0 : a' 0 Fin.elim0 = a 0 Fin.elim0 := ha'in 0 _ fun l => l.elim0
  have key := fejerChain (T := T) (a := a') hH hδ
    (fun r => (ham r).ite (measurableSet_fejerBox H r) measurable_const)
    (fun r h => by
      by_cases hh : h ∈ fejerBox H r
      · rw [ha'in r h hh]; exact ha1 r h hh
      · rw [ha'out r h hh, abs_zero]; exact zero_le_one)
    (fun r hr h => by
      by_cases hh : h ∈ fejerBox H r
      · rw [ha'in r h hh]; exact ha0 r hr h hh
      · rw [ha'out r h hh])
    (fun r hr h => by
      by_cases hh : h ∈ fejerBox H r
      · rw [ha'in r h hh, hinner r h hh]; exact hstep r hr h hh
      · rw [ha'out r h hh]
        have hz : (∫ u : ℝ, fejer H u * a' (r + 1) (Fin.cons u h)) = 0 := by
          have : (fun u : ℝ => fejer H u * a' (r + 1) (Fin.cons u h)) = fun _ => 0 := by
            funext u
            simp only [ha'out _ _ (fin_cons_notMem_fejerBox u hh), mul_zero]
          rw [this, integral_zero]
        rw [hz]
        nlinarith)
  rwa [h0, hmean] at key

end

section
open Filter Topology MeasureTheory

/-- **Level zero of the chain is the correlation of the proposition**, normalized by `V`. -/
theorem phaseLevel_zero {C N : ℝ} {m : ℕ} (hm : 1 ≤ m) {f : ℕ → E3 → ℂ}
    (hsupp : ∀ y, y ∉ petBox C N → f m y = 0) (V : ℝ) (P : ℕ → Polynomial ℝ)
    (p : E3 → Polynomial ℝ) (j : ℕ → Fin 3) (g : E3 → ℂ) (h : Fin 0 → ℝ) :
    phaseLevel V N C g 0 m f P p j h
      = (V⁻¹ : ℝ) • ∫ x, g x * ((N⁻¹ : ℝ) • ∫ t in (0 : ℝ)..(0 + N), phaseProd m f P p j x t) := by
  rw [phaseLevel, vecAmp]
  congr 1
  refine integral_congr_ae (.of_forall fun x => ?_)
  simp only
  congr 2
  refine intervalIntegral.integral_congr fun t _ => ?_
  rw [vecProd_phaseHead_mul hm hsupp P p j h x t, phaseProdIter_zero]

end

section
open Filter Topology MeasureTheory

/-! ### Evaluating a symbolic state at numeric shifts

Blueprint `patch:pet-analytic-step`: "For fixed old shifts let
`A = V⁻¹ ∫ g_0(x) E_t ∏ g_i(x + Q_i(t))`."
A symbolic state is evaluated at shifts `η : Fin r → ℝ` and inputs `G : ι → E3 → ℂ`: the
coefficients are evaluated at `η`, a factor is its input translated by its evaluated translation and
conjugated by its flag. The evaluation carries a global conjugation flag `c`, flipped at every
step: the analytic correlation conjugates the unshifted child, the symbolic update the shifted one,
and the two differ by a global conjugation. -/

/-- A list product is additive in the list: grouping keys and multiplying the groups back gives
the same product. -/
theorem prod_group_eq {α β M : Type*} [DecidableEq α] [CommMonoid M] (l : List (α × β))
    (w : α × β → M) :
    ((l.map Prod.fst).dedup.map fun k => ((l.filter fun it => decide (it.1 = k)).map w).prod).prod
      = (l.map w).prod := by
  rw [← List.prod_toFinset _ (List.nodup_dedup _)]
  have hd : (l.map Prod.fst).dedup.toFinset = (l.map Prod.fst).toFinset := by ext; simp
  rw [hd]
  clear hd
  induction l with
  | nil => simp
  | cons a l ih =>
    rw [List.map_cons, List.toFinset_cons, List.map_cons, List.prod_cons]
    have hsplit : ∀ k, ((List.filter (fun it => decide (it.1 = k)) (a :: l)).map w).prod
        = (if a.1 = k then w a else 1)
          * ((List.filter (fun it => decide (it.1 = k)) l).map w).prod := by
      intro k
      by_cases hk : a.1 = k
      · simp [hk]
      · simp [hk]
    simp_rw [hsplit]
    rw [Finset.prod_mul_distrib, Finset.prod_ite_eq]
    simp only [Finset.mem_insert, true_or, ite_true]
    congr 1
    by_cases ha : a.1 ∈ (l.map Prod.fst).toFinset
    · rw [Finset.insert_eq_of_mem ha, ih]
    · rw [Finset.prod_insert ha, ih]
      have hnil : List.filter (fun it => decide (it.1 = a.1)) l = [] := by
        rw [List.filter_eq_nil_iff]
        intro it hit
        simp only [decide_eq_true_eq]
        intro heq
        exact ha (List.mem_toFinset.mpr (List.mem_map.mpr ⟨it, hit, heq⟩))
      rw [hnil]
      simp

variable {r : ℕ} {ι : Type*} {f : ι}

/-- Evaluating the coefficients at the shifts. -/
noncomputable def petEvalHom (η : Fin r → ℝ) : (Fin 3 → MvPolynomial (Fin r) ℝ) →+* (Fin 3 → ℝ) :=
  RingHom.pi fun k => (MvPolynomial.eval η).comp (Pi.evalRingHom _ k)

@[simp] theorem petEvalHom_apply (η : Fin r → ℝ) (v : Fin 3 → MvPolynomial (Fin r) ℝ) (k : Fin 3) :
    petEvalHom η v k = MvPolynomial.eval η (v k) := rfl

/-- The evaluated translation of a factor, as a point of `E3`. -/
noncomputable def petEvalVec (η : Fin r → ℝ) (v : Fin 3 → MvPolynomial (Fin r) ℝ) : E3 :=
  WithLp.toLp 2 (petEvalHom η v)

/-- The evaluated polynomial shift `t ↦ Q(t, η)`. -/
noncomputable def petEvalPoly (η : Fin r → ℝ) (Q : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ))
    (t : ℝ) : E3 :=
  WithLp.toLp 2 ((Q.map (petEvalHom η)).eval fun _ => t)

theorem continuous_petEvalPoly (η : Fin r → ℝ) (Q : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ)) :
    Continuous (petEvalPoly η Q) :=
  (PiLp.continuous_toLp 2 _).comp
    ((Q.map (petEvalHom η)).continuous.comp (continuous_pi fun _ => continuous_id))

theorem petEvalPoly_sub (η : Fin r → ℝ) (Q R : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ))
    (t : ℝ) : petEvalPoly η (Q - R) t = petEvalPoly η Q t - petEvalPoly η R t := by
  simp only [petEvalPoly, Polynomial.map_sub, Polynomial.eval_sub]
  rfl

theorem petEvalPoly_zero (η : Fin r → ℝ) (t : ℝ) :
    petEvalPoly η (0 : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ)) t = 0 := by
  simp only [petEvalPoly, Polynomial.map_zero, Polynomial.eval_zero]
  rfl

/-- **The fresh shift evaluates to a translation of the parameter.** -/
theorem petEvalPoly_taylor (η : Fin r → ℝ) (iu : Fin r)
    (Q : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ)) (t : ℝ) :
    petEvalPoly η (Polynomial.taylor (fun _ => MvPolynomial.X iu) Q) t
      = petEvalPoly η Q (t + η iu) := by
  simp only [petEvalPoly, Polynomial.map_taylor, Polynomial.taylor_eval]
  congr 2
  funext k
  simp

/-- **Subtracting the constant term translates the evaluated shift.** -/
theorem petEvalPoly_petSubConst (η : Fin r → ℝ) (Q : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ))
    (t : ℝ) : petEvalPoly η (petSubConst Q) t = petEvalPoly η Q t - petEvalVec η (Q.coeff 0) := by
  simp only [petEvalPoly, petSubConst, Polynomial.map_sub, Polynomial.map_C, Polynomial.eval_sub,
    Polynomial.eval_C, petEvalVec]
  rfl

/-- Conjugating according to a flag. -/
noncomputable def condConj (b : Bool) (z : ℂ) : ℂ := if b then conj z else z

@[simp] theorem condConj_false (z : ℂ) : condConj false z = z := rfl
@[simp] theorem condConj_true (z : ℂ) : condConj true z = conj z := rfl

theorem condConj_not (b : Bool) (z : ℂ) : condConj (!b) z = conj (condConj b z) := by
  cases b <;> simp

theorem norm_condConj (b : Bool) (z : ℂ) : ‖condConj b z‖ = ‖z‖ := by
  cases b <;> simp

/-- The function of a factor: its input, translated and conjugated, under the global flag `c`. -/
noncomputable def petFacFun (G : ι → E3 → ℂ) (η : Fin r → ℝ) (c : Bool)
    (F : PetFactor r 3 ι) (y : E3) : ℂ :=
  condConj (xor c F.isConj) (G F.origin (y + petEvalVec η F.transl))

/-- The function of a block: the product of its factors. -/
noncomputable def petBlockFun (G : ι → E3 → ℂ) (η : Fin r → ℝ) (c : Bool)
    (l : List (PetFactor r 3 ι)) (y : E3) : ℂ :=
  (l.map fun F => petFacFun G η c F y).prod

theorem petBlockFun_append (G : ι → E3 → ℂ) (η : Fin r → ℝ) (c : Bool)
    (l l' : List (PetFactor r 3 ι)) (y : E3) :
    petBlockFun G η c (l ++ l') y = petBlockFun G η c l y * petBlockFun G η c l' y := by
  simp [petBlockFun]

theorem petBlockFun_flatMap {α : Type*} (G : ι → E3 → ℂ) (η : Fin r → ℝ) (c : Bool)
    (l : List α) (b : α → List (PetFactor r 3 ι)) (y : E3) :
    petBlockFun G η c (l.flatMap b) y = (l.map fun a => petBlockFun G η c (b a) y).prod := by
  induction l with
  | nil => simp [petBlockFun]
  | cons a l ih => rw [List.flatMap_cons, petBlockFun_append, ih, List.map_cons, List.prod_cons]

/-- The shifted child's conjugated block, under the flipped flag, is the old block. -/
theorem petBlockFun_starFac (G : ι → E3 → ℂ) (η : Fin r → ℝ) (c : Bool)
    (l : List (PetFactor r 3 ι)) (y : E3) :
    petBlockFun G η (!c) (l.map PetFactor.starFac) y = petBlockFun G η c l y := by
  simp only [petBlockFun, List.map_map]
  congr 1
  refine List.map_congr_left fun F _ => ?_
  simp only [Function.comp, petFacFun, PetFactor.starFac]
  cases c <;> cases F.isConj <;> rfl

/-- The unshifted child's block, under the flipped flag, is the conjugate of the old block. -/
theorem petBlockFun_not (G : ι → E3 → ℂ) (η : Fin r → ℝ) (c : Bool)
    (l : List (PetFactor r 3 ι)) (y : E3) :
    petBlockFun G η (!c) l y = conj (petBlockFun G η c l y) := by
  simp only [petBlockFun, map_list_prod, List.map_map]
  congr 1
  refine List.map_congr_left fun F _ => ?_
  simp only [Function.comp, petFacFun, Bool.not_xor, condConj_not]

/-- Absorbing a translation into every factor translates the block. -/
theorem petBlockFun_shiftFac (G : ι → E3 → ℂ) (η : Fin r → ℝ) (c : Bool)
    (l : List (PetFactor r 3 ι)) (v : Fin 3 → MvPolynomial (Fin r) ℝ) (y : E3) :
    petBlockFun G η c (l.map fun F => F.shiftFac v) y
      = petBlockFun G η c l (y + petEvalVec η v) := by
  simp only [petBlockFun, List.map_map]
  congr 1
  refine List.map_congr_left fun F _ => ?_
  simp only [Function.comp, petFacFun, PetFactor.shiftFac]
  congr 2
  have : petEvalVec η (F.transl + v) = petEvalVec η F.transl + petEvalVec η v := by
    simp only [petEvalVec, map_add]; rfl
  rw [this]
  abel

/-- An item evaluated as a block of a PET family. -/
noncomputable def petEvalItem (G : ι → E3 → ℂ) (η : Fin r → ℝ) (c : Bool)
    (it : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ) × List (PetFactor r 3 ι)) :
    (E3 → ℂ) × (ℝ → E3) :=
  (petBlockFun G η c it.2, petEvalPoly η it.1)

/-- The evaluated state: the head first, then the other items. -/
noncomputable def petEvalFam (G : ι → E3 → ℂ) (η : Fin r → ℝ) (c : Bool)
    (S : NormalPETState r 3 ι f) : PetFam :=
  (petAllItems S).map (petEvalItem G η c)

/-- Normalizing an item does not change its evaluated value. -/
theorem petEvalItem_normalize (G : ι → E3 → ℂ) (η : Fin r → ℝ) (c : Bool)
    (it : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ) × List (PetFactor r 3 ι)) (x : E3)
    (t : ℝ) :
    (petEvalItem G η c (petNormalizeItem it)).1 (x + (petEvalItem G η c (petNormalizeItem it)).2 t)
      = (petEvalItem G η c it).1 (x + (petEvalItem G η c it).2 t) := by
  simp only [petEvalItem, petNormalizeItem, petBlockFun_shiftFac, petEvalPoly_petSubConst]
  congr 1
  abel

/-- The value of a family at a point, as the list of its block values. -/
theorem vecProd_eq_prod_map (L : PetFam) (x : E3) (t : ℝ) :
    vecProd L x t = (L.map fun b => b.1 (x + b.2 t)).prod := rfl

/-- **The analytic children are the evaluated symbolic children**: the correlation of the
evaluated state under the evaluated pivot and the evaluated fresh shift is the product over the
evaluated raw children, under the flipped flag. -/
theorem vecProd_vecChildren_petEvalFam (G : ι → E3 → ℂ) (η : Fin r → ℝ) (c : Bool) (iu : Fin r)
    (Qp : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ)) (S : NormalPETState r 3 ι f) (x : E3)
    (t : ℝ) :
    vecProd (vecChildren (petEvalFam G η c S) (petEvalPoly η Qp) (η iu)) x t
      = (((petRawChildren (fun _ => MvPolynomial.X iu) Qp S).map (petEvalItem G η (!c))).map
          fun b => b.1 (x + b.2 t)).prod := by
  rw [vecProd_eq_prod_map, petEvalFam, petRawChildren, vecChildren, List.flatMap_map,
    List.map_flatMap, List.map_flatMap, List.map_flatMap]
  congr 1
  refine List.flatMap_congr fun it _ => ?_
  simp only [petChildren, petEvalItem, List.map_cons, List.map_nil]
  rw [petBlockFun_starFac, petBlockFun_not]
  simp only [petEvalPoly_sub, petEvalPoly_taylor]

theorem prod_map_filter_mul_not {α M : Type*} [CommMonoid M] (l : List α) (p : α → Bool)
    (w : α → M) :
    ((l.filter p).map w).prod * ((l.filter fun a => !p a).map w).prod = (l.map w).prod := by
  induction l with
  | nil => simp
  | cons a l ih =>
    by_cases hp : p a
    · simp only [List.filter_cons, hp, ite_true, Bool.not_true, List.map_cons, List.prod_cons,
        Bool.false_eq_true, ite_false]
      rw [mul_assoc, ih]
    · simp only [List.filter_cons, hp, Bool.not_false, ite_true, List.map_cons, List.prod_cons,
        Bool.false_eq_true, ite_false]
      rw [mul_left_comm, ih]

/-- **Grouping does not change the evaluated product**: items sharing a polynomial are merged by
concatenating their blocks, and the product of the merged block is the product of its parts. -/
theorem vecProd_petGroup [DecidableEq (Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ))]
    (G : ι → E3 → ℂ) (η : Fin r → ℝ) (c : Bool)
    (l : List (Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ) × List (PetFactor r 3 ι))) (x : E3)
    (t : ℝ) :
    vecProd ((petGroup l).map (petEvalItem G η c)) x t
      = ((l.map (petEvalItem G η c)).map fun b => b.1 (x + b.2 t)).prod := by
  rw [vecProd_eq_prod_map, List.map_map, List.map_map, petGroup, List.map_map]
  refine Eq.trans ?_ (prod_group_eq l ((fun b => b.1 (x + b.2 t)) ∘ petEvalItem G η c))
  congr 1
  refine List.map_congr_left fun k _ => ?_
  simp only [Function.comp, petEvalItem]
  rw [petBlockFun_flatMap]
  congr 1
  refine List.map_congr_left fun it hit => ?_
  rw [List.mem_filter, decide_eq_true_eq] at hit
  rw [← hit.2]
  rfl

open scoped Classical in
/-- **The update identity of `patch:pet-analytic-step`**: the analytic children of the evaluated
state, under the evaluated pivot and fresh shift, are the new spatial block times the evaluated
updated state -- normalization absorbs constants, zero children form the spatial block, and
grouping multiplies blocks. -/
theorem vecProd_vecChildren_update
    (G : ι → E3 → ℂ) (η : Fin r → ℝ) (c : Bool) (iu : Fin r)
    (Qp : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ)) (S : NormalPETState r 3 ι f)
    (hne : (petNewHead (fun _ => MvPolynomial.X iu) Qp S).1 ≠ 0) (x : E3) (t : ℝ) :
    vecProd (vecChildren (petEvalFam G η c S) (petEvalPoly η Qp) (η iu)) x t
      = petBlockFun G η (!c) (petNewSpatial (fun _ => MvPolynomial.X iu) Qp S) x
        * vecProd (petEvalItem G η (!c) ((petNewHead (fun _ => MvPolynomial.X iu) Qp S).1,
            [petNewHeadFactor (fun _ => MvPolynomial.X iu) Qp S])
          :: (petGroup (petNonConstChildren (fun _ => MvPolynomial.X iu) Qp S)).map
            (petEvalItem G η (!c))) x t := by
  set u : Fin 3 → MvPolynomial (Fin r) ℝ := fun _ => MvPolynomial.X iu with hu
  set w : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ) × List (PetFactor r 3 ι) → ℂ :=
    fun it => (petEvalItem G η (!c) it).1 (x + (petEvalItem G η (!c) it).2 t) with hw
  rw [vecProd_vecChildren_petEvalFam]
  -- normalization does not change the values
  have hnorm : (((petRawChildren u Qp S).map (petEvalItem G η (!c))).map
        fun b => b.1 (x + b.2 t)).prod = ((petNormalized u Qp S).map w).prod := by
    rw [petNormalized]
    simp only [List.map_map]
    congr 1
    refine List.map_congr_left fun it _ => ?_
    simp only [Function.comp, hw]
    exact (petEvalItem_normalize G η (!c) it x t).symm
  rw [hnorm]
  -- the normalized list is the new head followed by the rest
  obtain ⟨tl, htl⟩ : ∃ tl, petNormalized u Qp S = petNewHead u Qp S :: tl := by
    refine ⟨petNormalizeItem ((S.headPoly - Qp), [S.headFactor])
      :: (S.rest.flatMap (petChildren u Qp)).map petNormalizeItem, ?_⟩
    simp only [petNormalized, petRawChildren, petAllItems, List.flatMap_cons, petChildren,
      List.map_cons, List.map_nil, List.cons_append, List.nil_append,
      petNewHead]
  have hhead2 : (petNewHead u Qp S).2 = [petNewHeadFactor u Qp S] := by
    simp [petNewHead, petNormalizeItem, petNewHeadFactor]
  have hsp : petNewSpatial u Qp S = (tl.filter fun it => decide (it.1 = 0)).flatMap Prod.snd := by
    rw [petNewSpatial, htl, List.filter_cons, ite_eq_right (by simpa using hne)]
  have hnc : petNonConstChildren u Qp S = tl.filter fun it => !decide (it.1 = 0) := by
    rw [petNonConstChildren, htl, List.tail_cons]
    exact List.filter_congr fun it _ => by simp
  rw [hsp, hnc, htl, List.map_cons, List.prod_cons, vecProd_cons, vecProd_petGroup]
  rw [← prod_map_filter_mul_not tl (fun it => decide (it.1 = 0)) w, petBlockFun_flatMap]
  have hz : ((tl.filter fun it => decide (it.1 = 0)).map fun a => petBlockFun G η (!c) a.2 x)
      = (tl.filter fun it => decide (it.1 = 0)).map w := by
    refine List.map_congr_left fun it hit => ?_
    rw [List.mem_filter, decide_eq_true_eq] at hit
    simp only [hw, petEvalItem, hit.2, petEvalPoly_zero, add_zero]
  rw [hz]
  have hh : w (petNewHead u Qp S) = (petEvalItem G η (!c) ((petNewHead u Qp S).1,
      [petNewHeadFactor u Qp S])).1 (x + (petEvalItem G η (!c) ((petNewHead u Qp S).1,
      [petNewHeadFactor u Qp S])).2 t) := by
    simp only [hw]
    rw [← hhead2]
  rw [hh, List.map_map]
  simp only [hw, Function.comp_def]
  ring

end

section
open Filter Topology MeasureTheory

variable {r n : ℕ} {ι : Type*} {f : ι}

/-! ### Translation records use only the shift variables already introduced

The level-`k` correlation must be a function of the first `k` shifts alone, so every constant
translation absorbed into a factor must use only the variables introduced so far. The constants
come from children's constant terms, which use at most the fresh variable. -/

/-- A factor's translation uses only the first `s` shift variables. -/
def PetFacBelow (s : ℕ) (F : PetFactor r n ι) : Prop := ∀ k, F.transl k ∈ petVarAlg r s

theorem PetFacBelow.mono {s s' : ℕ} (hs : s ≤ s') {F : PetFactor r n ι} (h : PetFacBelow s F) :
    PetFacBelow s' F := fun k => by
  have hsub : {v : Fin r | v.val < s} ⊆ {v : Fin r | v.val < s'} := fun v hv => by
    simp only [Set.mem_ofPred_eq] at hv ⊢; omega
  exact MvPolynomial.supported_mono hsub (h k)

theorem PetFacBelow.starFac {s : ℕ} {F : PetFactor r n ι} (h : PetFacBelow s F) :
    PetFacBelow s F.starFac := h

theorem PetFacBelow.shiftFac {s : ℕ} {F : PetFactor r n ι} (h : PetFacBelow s F)
    {c : Fin n → MvPolynomial (Fin r) ℝ} (hc : ∀ k, c k ∈ petVarAlg r s) :
    PetFacBelow s (F.shiftFac c) := fun k =>
  (add_mem (h k) (hc k) : F.transl k + c k ∈ petVarAlg r s)

/-- Every translation record of a state uses only the first `s` shift variables. -/
def PetFacsBelow (s : ℕ) (S : NormalPETState r n ι f) : Prop :=
  (∀ F ∈ S.spatial, PetFacBelow s F) ∧ ∀ it ∈ petAllItems S, ∀ F ∈ it.2, PetFacBelow s F

theorem PetFacsBelow.mono {s s' : ℕ} (hs : s ≤ s') {S : NormalPETState r n ι f}
    (h : PetFacsBelow s S) : PetFacsBelow s' S :=
  ⟨fun F hF => (h.1 F hF).mono hs, fun it hit F hF => (h.2 it hit F hF).mono hs⟩

/-- **The normalized children use at most the fresh variable.** -/
theorem petNormalized_facBelow {s : ℕ} {S : NormalPETState r n ι f} (hS : PetFacsBelow s S)
    (hB : ∀ it ∈ petAllItems S, PetPolyBelow s it.1) {iu : Fin r} (hiu : iu.val = s)
    {Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)} (hQp : PetPolyBelow s Qp) :
    ∀ it ∈ petNormalized (fun _ => MvPolynomial.X iu) Qp S, ∀ F ∈ it.2, PetFacBelow (s + 1) F := by
  intro it hit F hF
  rw [petNormalized, List.mem_map] at hit
  obtain ⟨ch, hch, rfl⟩ := hit
  rw [petRawChildren, List.mem_flatMap] at hch
  obtain ⟨old, hold, hch⟩ := hch
  simp only [petChildren, List.mem_cons, List.not_mem_nil, or_false] at hch
  simp only [petNormalizeItem, List.mem_map] at hF
  obtain ⟨F0, hF0, rfl⟩ := hF
  have hpoly : PetPolyBelow (s + 1) ch.1 := by
    rcases hch with rfl | rfl
    · exact ((hB old hold).taylor iu hiu).sub (hQp.mono (Nat.le_succ s))
    · exact ((hB old hold).sub hQp).mono (Nat.le_succ s)
  have hF0' : PetFacBelow (s + 1) F0 := by
    rcases hch with rfl | rfl
    · simp only [List.mem_map] at hF0
      obtain ⟨F1, hF1, rfl⟩ := hF0
      exact ((hS.2 old hold F1 hF1).mono (Nat.le_succ s)).starFac
    · exact (hS.2 old hold F0 hF0).mono (Nat.le_succ s)
  exact hF0'.shiftFac fun k => hpoly.coeff_mem 0 k

open scoped Classical in
/-- **The update preserves the translation records' variable bound**, with one more variable. -/
theorem petFacsBelow_update [DecidableEq (Polynomial (Fin n → MvPolynomial (Fin r) ℝ))]
    {s : ℕ} {S : NormalPETState r n ι f} (hS : PetFacsBelow s S)
    (hB : ∀ it ∈ petAllItems S, PetPolyBelow s it.1) {iu : Fin r} (hiu : iu.val = s)
    {Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)} (hQp : PetPolyBelow s Qp)
    {S' : NormalPETState r n ι f}
    (hsp : S'.spatial = petNewSpatial (fun _ => MvPolynomial.X iu) Qp S)
    (hhf : S'.headFactor = petNewHeadFactor (fun _ => MvPolynomial.X iu) Qp S)
    (hrest : S'.rest = petGroup (petNonConstChildren (fun _ => MvPolynomial.X iu) Qp S)) :
    PetFacsBelow (s + 1) S' := by
  have hN := petNormalized_facBelow hS hB hiu hQp
  obtain ⟨tl, htl⟩ : ∃ tl, petNormalized (fun _ => MvPolynomial.X iu) Qp S
      = petNewHead (fun _ => MvPolynomial.X iu) Qp S :: tl := by
    refine ⟨petNormalizeItem ((S.headPoly - Qp), [S.headFactor])
      :: (S.rest.flatMap (petChildren (fun _ => MvPolynomial.X iu) Qp)).map petNormalizeItem, ?_⟩
    simp only [petNormalized, petRawChildren, petAllItems, List.flatMap_cons, petChildren,
      List.map_cons, List.map_nil, List.cons_append, List.nil_append, petNewHead]
  refine ⟨?_, ?_⟩
  · intro F hF
    rw [hsp, petNewSpatial, List.mem_flatMap] at hF
    obtain ⟨it, hit, hF⟩ := hF
    exact hN it (List.mem_of_mem_filter hit) F hF
  · intro it hit F hF
    rw [petAllItems, List.mem_cons] at hit
    rcases hit with rfl | hit
    · simp only [List.mem_singleton] at hF
      subst hF
      rw [hhf]
      have hh : petNewHead (fun _ => MvPolynomial.X iu) Qp S ∈
          petNormalized (fun _ => MvPolynomial.X iu) Qp S := by rw [htl]; exact List.mem_cons_self
      refine hN _ hh _ ?_
      simp [petNewHead, petNormalizeItem, petNewHeadFactor]
    · rw [hrest, petGroup, List.mem_map] at hit
      obtain ⟨k, -, rfl⟩ := hit
      simp only [List.mem_flatMap, List.mem_filter] at hF
      obtain ⟨it', ⟨hit', -⟩, hF⟩ := hF
      rw [petNonConstChildren, List.mem_filter] at hit'
      exact hN it' (List.mem_of_mem_tail hit'.1) F hF

/-- The items of a state satisfying the run invariant use only the introduced variables. -/
theorem PetRunInv.itemsBelow {a : ℝ} {m : Fin n} {D s : ℕ} {S : NormalPETState r n ι f}
    (h : PetRunInv a m D s S) : ∀ it ∈ petAllItems S, PetPolyBelow s it.1 := by
  intro it hit
  rw [petAllItems, List.mem_cons] at hit
  rcases hit with rfl | hit
  · exact h.2.2.1
  · exact h.2.2.2.1 it hit

/-- **Along the run every translation record uses only the variables introduced so far.** -/
theorem petRunSeq_facsBelow {a : ℝ} (ha : a ≠ 0) {m : Fin n} {D s0 : ℕ} (hD3 : D ≤ 3) {B0 : ℝ}
    (hB0 : 0 ≤ B0) (S0 : NormalPETState r n ι f) (hinv0 : PetRunInv a m D s0 S0)
    (hbd0 : PetRunBd a m B0 S0) (h0 : PetFacsBelow s0 S0) :
    ∀ k, PetFacsBelow (s0 + k) (petRunSeq ha hD3 hB0 S0 hinv0 hbd0 k).1 := by
  classical
  intro k
  induction k with
  | zero => exact h0
  | succ k ih =>
    rw [petRunSeq_succ]
    set x := petRunSeq ha hD3 hB0 S0 hinv0 hbd0 k with hx
    by_cases hmv : 2 ≤ x.1.headPoly.natDegree ∧ s0 + k < r
    · obtain ⟨Qp, hQp, hsp, -, hhf, hrest, -⟩ := petRunMove_spec ha hD3 hB0 k x hmv
      have hB := x.2.1.itemsBelow
      obtain ⟨it, hit, rfl⟩ := List.mem_map.mp hQp
      rw [← Nat.add_assoc]
      exact petFacsBelow_update ih hB rfl (hB it hit) hsp hhf hrest
    · rw [petRunMove_neg ha hD3 hB0 k x hmv]
      exact ih.mono (by omega)

end

section
open Filter Topology MeasureTheory

variable {r : ℕ} {ι : Type*} {f : ι}

/-! ### The support envelope of the evaluated shifts

Blueprint `patch:pet-producer`, "Full coefficient and translation bounds": "A shift `t ↦ t + u`,
`|u| ≤ H ≤ N`, transforms that coefficient [bound] ... Subtracting the pivot multiplies this bound
by at most two ... This proves every support-envelope ... bound used by the analytic execution."
Only the envelope is needed: at shifts of size at most `H` and parameters `|t| ≤ R`, the `k`-th
coordinate of every evaluated shift is at most `M N^{expo k}`. An update costs a factor `4` and
shrinks the parameter range by `H`. -/

@[simp] theorem petEvalPoly_apply (η : Fin r → ℝ) (Q : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ))
    (t : ℝ) (k : Fin 3) :
    petEvalPoly η Q t k = ((Q.map (petEvalHom η)).eval fun _ => t) k := rfl

/-- At `t = 0` the evaluated shift is the evaluated constant term. -/
theorem petEvalPoly_zero_eq (η : Fin r → ℝ) (Q : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ)) :
    petEvalPoly η Q 0 = petEvalVec η (Q.coeff 0) := by
  have h0 : (fun _ : Fin 3 => (0 : ℝ)) = 0 := rfl
  simp only [petEvalPoly, petEvalVec, h0, ← Polynomial.coeff_zero_eq_eval_zero,
    Polynomial.coeff_map]

/-- The envelope of an evaluated shift. -/
def PetEnv (N H R M : ℝ) (Q : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ)) : Prop :=
  ∀ η : Fin r → ℝ, (∀ v, |η v| ≤ H) → ∀ t, |t| ≤ R → ∀ k : Fin 3,
    |petEvalPoly η Q t k| ≤ M * N ^ expo k

theorem PetEnv.mono {N H R R' M M' : ℝ} (hN : 0 ≤ N) (hR : R' ≤ R) (hM : M ≤ M')
    {Q : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ)} (h : PetEnv N H R M Q) :
    PetEnv N H R' M' Q := fun η hη t ht k =>
  (h η hη t (ht.trans hR) k).trans (mul_le_mul_of_nonneg_right hM (pow_nonneg hN _))

theorem petEnv_zero (N H R : ℝ) {M : ℝ} (hM : 0 ≤ M) (hN : 0 ≤ N) :
    PetEnv N H R M (0 : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ)) := fun η _ t _ k => by
  rw [petEvalPoly_zero]
  simp only [PiLp.zero_apply, abs_zero]
  positivity

/-- **The envelope after normalizing a child**: `X(t) - X(0)` with `X` a difference of two
enveloped shifts, one of them possibly translated by the fresh shift. -/
theorem PetEnv.normalize {N H R M : ℝ} (hH : 0 ≤ H)
    {Q Qp : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ)}
    (hQ : PetEnv N H R M Q) (hQp : PetEnv N H R M Qp) (iu : Fin r) (shifted : Bool) :
    PetEnv N H (R - H) (4 * M)
      (petSubConst ((if shifted then Polynomial.taylor (fun _ => MvPolynomial.X iu) Q else Q)
        - Qp)) := by
  intro η hη t ht k
  have hR0 : |(0 : ℝ)| ≤ R := by
    have := abs_nonneg t; rw [abs_zero]; linarith
  have hevq : ∀ s, |s| ≤ R - H → |petEvalPoly η
      (if shifted then Polynomial.taylor (fun _ => MvPolynomial.X iu) Q else Q) s k|
        ≤ M * N ^ expo k := by
    intro s hs
    cases shifted
    · exact hQ η hη s (by linarith) k
    · simp only [ite_true]
      rw [petEvalPoly_taylor]
      refine hQ η hη _ ?_ k
      calc |s + η iu| ≤ |s| + |η iu| := abs_add_le _ _
        _ ≤ R - H + H := add_le_add hs (hη iu)
        _ = R := by ring
  have hHR : |(0 : ℝ)| ≤ R - H := by
    have := abs_nonneg t; rw [abs_zero]; linarith
  rw [petEvalPoly_petSubConst, ← petEvalPoly_zero_eq, PiLp.sub_apply, petEvalPoly_sub,
    petEvalPoly_sub, PiLp.sub_apply, PiLp.sub_apply]
  have h1 := hevq t ht
  have h2 := hQp η hη t (by linarith [abs_nonneg t]) k
  have h3 := hevq 0 hHR
  have h4 := hQp η hη 0 hR0 k
  calc |_ - _ - (_ - _)| ≤ |_| + |_| + (|_| + |_|) := by
        refine (abs_sub _ _).trans (add_le_add (abs_sub _ _) (abs_sub _ _))
    _ ≤ M * N ^ expo k + M * N ^ expo k + (M * N ^ expo k + M * N ^ expo k) :=
        add_le_add (add_le_add h1 h2) (add_le_add h3 h4)
    _ = 4 * M * N ^ expo k := by ring

/-- The envelope of every item of a state. -/
def PetStateEnv (N H R M : ℝ) (S : NormalPETState r 3 ι f) : Prop :=
  ∀ it ∈ petAllItems S, PetEnv N H R M it.1

open scoped Classical in
/-- **One update multiplies the envelope by four and shrinks the range by `H`.** -/
theorem petStateEnv_update [DecidableEq (Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ))]
    {N H R M : ℝ} (hH : 0 ≤ H) {S : NormalPETState r 3 ι f} (hS : PetStateEnv N H R M S)
    {iu : Fin r} {Qp : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ)}
    (hQp : Qp ∈ (petAllItems S).map Prod.fst) {S' : NormalPETState r 3 ι f}
    (hhp : S'.headPoly = (petNewHead (fun _ => MvPolynomial.X iu) Qp S).1)
    (hrest : S'.rest = petGroup (petNonConstChildren (fun _ => MvPolynomial.X iu) Qp S)) :
    PetStateEnv N H (R - H) (4 * M) S' := by
  obtain ⟨itp, hitp, rfl⟩ := List.mem_map.mp hQp
  have hEp := hS itp hitp
  -- every normalized child is enveloped
  have hN : ∀ it ∈ petNormalized (fun _ => MvPolynomial.X iu) itp.1 S,
      PetEnv N H (R - H) (4 * M) it.1 := by
    intro it hit
    rw [petNormalized, List.mem_map] at hit
    obtain ⟨ch, hch, rfl⟩ := hit
    rw [petRawChildren, List.mem_flatMap] at hch
    obtain ⟨old, hold, hch⟩ := hch
    simp only [petChildren, List.mem_cons, List.not_mem_nil, or_false] at hch
    rcases hch with rfl | rfl
    · simpa [petNormalizeItem] using (hS old hold).normalize hH hEp iu true
    · simpa [petNormalizeItem] using (hS old hold).normalize hH hEp iu false
  intro it hit
  rw [petAllItems, List.mem_cons] at hit
  rcases hit with rfl | hit
  · rw [hhp]
    have := (hS _ (List.mem_cons_self)).normalize hH hEp iu true
    simpa [petNewHead, petNormalizeItem] using this
  · rw [hrest] at hit
    have hk := petGroup_fst_mem hit
    obtain ⟨it', hit', heq⟩ := List.mem_map.mp hk
    rw [← heq]
    rw [petNonConstChildren, List.mem_filter] at hit'
    exact hN it' (List.mem_of_mem_tail hit'.1)

/-- **Along the run the envelope after `k` moves is `4^k M` on the range `R - k H`.** -/
theorem petRunSeq_env {a : ℝ} (ha : a ≠ 0) {m : Fin 3} {D s0 : ℕ} (hD3 : D ≤ 3) {B0 : ℝ}
    (hB0 : 0 ≤ B0) (S0 : NormalPETState r 3 ι f) (hinv0 : PetRunInv a m D s0 S0)
    (hbd0 : PetRunBd a m B0 S0) {N H R M : ℝ} (hN : 0 ≤ N) (hH : 0 ≤ H) (hM : 0 ≤ M)
    (h0 : PetStateEnv N H R M S0) :
    ∀ k : ℕ, PetStateEnv N H (R - k * H) (4 ^ k * M) (petRunSeq ha hD3 hB0 S0 hinv0 hbd0 k).1 := by
  classical
  intro k
  induction k with
  | zero =>
    have e : R - ((0 : ℕ) : ℝ) * H = R := by simp
    rw [e, pow_zero, one_mul]
    exact h0
  | succ k ih =>
    rw [petRunSeq_succ]
    set x := petRunSeq ha hD3 hB0 S0 hinv0 hbd0 k with hx
    have hR : R - (k + 1 : ℕ) * H = R - k * H - H := by push_cast; ring
    have hM' : (4 : ℝ) ^ (k + 1) * M = 4 * (4 ^ k * M) := by ring
    rw [hR, hM']
    by_cases hmv : 2 ≤ x.1.headPoly.natDegree ∧ s0 + k < r
    · obtain ⟨Qp, hQp, -, hhp, -, hrest, -⟩ := petRunMove_spec ha hD3 hB0 k x hmv
      exact petStateEnv_update hH ih hQp hhp hrest
    · rw [petRunMove_neg ha hD3 hB0 k x hmv]
      intro it hit
      exact (ih it hit).mono hN (by linarith)
        (by nlinarith [pow_nonneg (by norm_num : (0:ℝ) ≤ 4) k])

end

section
open Filter Topology MeasureTheory

variable {r : ℕ} {ι : Type*} {f : ι}

/-! ### Evaluations: continuity, measurability, and independence of unused variables -/
theorem continuous_mvEval (p : MvPolynomial (Fin r) ℝ) :
    Continuous fun η : Fin r → ℝ => MvPolynomial.eval η p := by
  induction p using MvPolynomial.induction_on with
  | C a => simp only [MvPolynomial.eval_C]; exact continuous_const
  | add p q hp hq => simp only [map_add]; exact hp.add hq
  | mul_X p i hp => simp only [map_mul, MvPolynomial.eval_X]; exact hp.mul (continuous_apply i)

theorem continuous_petEvalHom_apply (v : Fin 3 → MvPolynomial (Fin r) ℝ) :
    Continuous fun η : Fin r → ℝ => petEvalHom η v := by
  refine continuous_pi fun k => ?_
  simp only [petEvalHom_apply]
  exact continuous_mvEval (v k)

theorem continuous_petEvalVec (v : Fin 3 → MvPolynomial (Fin r) ℝ) :
    Continuous fun η : Fin r → ℝ => petEvalVec η v :=
  (PiLp.continuous_toLp 2 _).comp (continuous_petEvalHom_apply v)

/-- The evaluated shift is jointly continuous in the shifts and the parameter. -/
theorem continuous_petEvalPoly_joint (Q : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ)) :
    Continuous fun q : (Fin r → ℝ) × ℝ => petEvalPoly q.1 Q q.2 := by
  have h : ∀ q : (Fin r → ℝ) × ℝ, petEvalPoly q.1 Q q.2
      = WithLp.toLp 2 (∑ i ∈ Q.support, petEvalHom q.1 (Q.coeff i) * (fun _ => q.2) ^ i) := by
    intro q
    simp only [petEvalPoly, Polynomial.eval_map, Polynomial.eval₂_eq_sum, Polynomial.sum_def]
  simp_rw [h]
  refine (PiLp.continuous_toLp 2 _).comp (continuous_finsetSum _ fun i _ => ?_)
  exact ((continuous_petEvalHom_apply _).comp continuous_fst).mul
    ((continuous_pi fun _ => continuous_snd).pow i)

theorem measurable_condConj (b : Bool) : Measurable (condConj b) := by
  cases b
  · exact measurable_id
  · exact Complex.continuous_conj.measurable

/-- A factor's function is jointly measurable in the shifts and the point. -/
theorem measurable_petFacFun {G : ι → E3 → ℂ} (hG : ∀ i, Measurable (G i)) (c : Bool)
    (F : PetFactor r 3 ι) :
    Measurable fun q : (Fin r → ℝ) × E3 => petFacFun G q.1 c F q.2 := by
  have h1 : Measurable fun q : (Fin r → ℝ) × E3 => q.2 + petEvalVec q.1 F.transl :=
    measurable_snd.add ((continuous_petEvalVec F.transl).measurable.comp measurable_fst)
  exact (measurable_condConj _).comp ((hG F.origin).comp h1)

theorem measurable_petBlockFun {G : ι → E3 → ℂ} (hG : ∀ i, Measurable (G i)) (c : Bool)
    (l : List (PetFactor r 3 ι)) :
    Measurable fun q : (Fin r → ℝ) × E3 => petBlockFun G q.1 c l q.2 := by
  induction l with
  | nil => simp [petBlockFun]
  | cons F l ih =>
    have : (fun q : (Fin r → ℝ) × E3 => petBlockFun G q.1 c (F :: l) q.2)
        = fun q => petFacFun G q.1 c F q.2 * petBlockFun G q.1 c l q.2 := by
      funext q; simp [petBlockFun]
    rw [this]
    exact (measurable_petFacFun hG c F).mul ih

theorem norm_petBlockFun_le {G : ι → E3 → ℂ} (hG1 : ∀ i y, ‖G i y‖ ≤ 1) (η : Fin r → ℝ)
    (c : Bool) (l : List (PetFactor r 3 ι)) (y : E3) : ‖petBlockFun G η c l y‖ ≤ 1 := by
  induction l with
  | nil => simp [petBlockFun]
  | cons F l ih =>
    have : petBlockFun G η c (F :: l) y = petFacFun G η c F y * petBlockFun G η c l y := by
      simp [petBlockFun]
    rw [this, norm_mul]
    refine ((mul_le_of_le_one_left (norm_nonneg _) ?_).trans ih)
    rw [petFacFun, norm_condConj]
    exact hG1 _ _

set_option maxHeartbeats 400000 in
-- Elaborating the nested PET family and its joint measurability exceeds the default module budget.
/-- The evaluated family is jointly measurable in shifts, point and parameter. -/
theorem measurable_vecProd_petEvalFam {G : ι → E3 → ℂ} (hG : ∀ i, Measurable (G i)) (c : Bool)
    (S : NormalPETState r 3 ι f) :
    Measurable fun q : ((Fin r → ℝ) × E3) × ℝ => vecProd (petEvalFam G q.1.1 c S) q.1.2 q.2 := by
  simp only [vecProd_eq_prod_map, petEvalFam, List.map_map]
  induction petAllItems S with
  | nil => simp
  | cons it l ih =>
    simp only [List.map_cons, List.prod_cons]
    refine Measurable.mul ?_ ih
    have hpt : Measurable fun q : ((Fin r → ℝ) × E3) × ℝ =>
        ((q.1.1, q.1.2 + petEvalPoly q.1.1 it.1 q.2) : (Fin r → ℝ) × E3) :=
      (measurable_fst.comp measurable_fst).prodMk ((measurable_snd.comp measurable_fst).add
        ((continuous_petEvalPoly_joint it.1).measurable.comp
          ((measurable_fst.comp measurable_fst).prodMk measurable_snd)))
    exact (measurable_petBlockFun hG c it.2).comp hpt

theorem petEvalFam_facts {G : ι → E3 → ℂ} (hG : ∀ i, Measurable (G i))
    (hG1 : ∀ i y, ‖G i y‖ ≤ 1) (η : Fin r → ℝ) (c : Bool) (S : NormalPETState r 3 ι f) :
    (∀ b ∈ petEvalFam G η c S, Measurable b.1 ∧ Continuous b.2)
      ∧ (∀ b ∈ petEvalFam G η c S, ∀ y, ‖b.1 y‖ ≤ 1) := by
  constructor
  · intro b hb
    rw [petEvalFam, List.mem_map] at hb
    obtain ⟨it, -, rfl⟩ := hb
    exact ⟨(measurable_petBlockFun hG c it.2).comp (measurable_const.prodMk measurable_id),
      continuous_petEvalPoly η it.1⟩
  · intro b hb y
    rw [petEvalFam, List.mem_map] at hb
    obtain ⟨it, -, rfl⟩ := hb
    exact norm_petBlockFun_le hG1 η c it.2 y

/-- **Evaluation ignores the variables a polynomial does not use.** -/
theorem MvPolynomial.eval_eq_of_mem_supported {s : ℕ} {p : MvPolynomial (Fin r) ℝ}
    (hp : p ∈ petVarAlg r s) {η η' : Fin r → ℝ} (h : ∀ v : Fin r, v.val < s → η v = η' v) :
    MvPolynomial.eval η p = MvPolynomial.eval η' p := by
  rw [MvPolynomial.mem_supported] at hp
  exact MvPolynomial.eval₂Hom_congr' rfl (fun v hv _ => h v (hp hv)) rfl

theorem petEvalHom_eq_of_below {s : ℕ} {v : Fin 3 → MvPolynomial (Fin r) ℝ}
    (hv : ∀ k, v k ∈ petVarAlg r s) {η η' : Fin r → ℝ} (h : ∀ w : Fin r, w.val < s → η w = η' w) :
    petEvalHom η v = petEvalHom η' v := by
  funext k
  exact MvPolynomial.eval_eq_of_mem_supported (hv k) h

theorem petEvalPoly_eq_of_below {s : ℕ} {Q : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ)}
    (hQ : PetPolyBelow s Q) {η η' : Fin r → ℝ} (h : ∀ w : Fin r, w.val < s → η w = η' w) :
    petEvalPoly η Q = petEvalPoly η' Q := by
  funext t
  simp only [petEvalPoly]
  congr 1
  rw [Polynomial.eval_map, Polynomial.eval_map, Polynomial.eval₂_eq_sum, Polynomial.eval₂_eq_sum]
  refine Finset.sum_congr rfl fun q _ => ?_
  dsimp only
  rw [petEvalHom_eq_of_below (fun k => hQ q k) h]

theorem petFacFun_eq_of_below {s : ℕ} {F : PetFactor r 3 ι} (hF : PetFacBelow s F)
    (G : ι → E3 → ℂ) (c : Bool) {η η' : Fin r → ℝ} (h : ∀ w : Fin r, w.val < s → η w = η' w) :
    petFacFun G η c F = petFacFun G η' c F := by
  funext y
  simp only [petFacFun, petEvalVec, petEvalHom_eq_of_below hF h]

theorem petBlockFun_eq_of_below {s : ℕ} {l : List (PetFactor r 3 ι)}
    (hl : ∀ F ∈ l, PetFacBelow s F) (G : ι → E3 → ℂ) (c : Bool) {η η' : Fin r → ℝ}
    (h : ∀ w : Fin r, w.val < s → η w = η' w) :
    petBlockFun G η c l = petBlockFun G η' c l := by
  funext y
  simp only [petBlockFun]
  congr 1
  refine List.map_congr_left fun F hF => ?_
  rw [petFacFun_eq_of_below (hl F hF) G c h]

theorem petEvalFam_eq_of_below {s : ℕ} {S : NormalPETState r 3 ι f} (hS : PetFacsBelow s S)
    (hB : ∀ it ∈ petAllItems S, PetPolyBelow s it.1) (G : ι → E3 → ℂ) (c : Bool)
    {η η' : Fin r → ℝ} (h : ∀ w : Fin r, w.val < s → η w = η' w) :
    petEvalFam G η c S = petEvalFam G η' c S := by
  rw [petEvalFam, petEvalFam]
  refine List.map_congr_left fun it hit => ?_
  rw [petEvalItem, petEvalItem, petBlockFun_eq_of_below (hS.2 it hit) G c h,
    petEvalPoly_eq_of_below (hB it hit) h]

/-- Translating into a box by a bounded shift lands in the enlarged box. -/
theorem mem_petBox_of_add_mem {C K N : ℝ} {y d : E3} (hy : y + d ∈ petBox C N)
    (hd : ∀ k : Fin 3, |d k| ≤ K * N ^ expo k) : y ∈ petBox (C + K) N := by
  intro k
  have h1 := hy k
  have h2 := hd k
  rw [PiLp.add_apply] at h1
  rw [abs_le] at h2
  simp only [Set.mem_Icc] at h1 ⊢
  rw [add_mul]
  constructor <;> linarith [h1.1, h1.2, h2.1, h2.2]

end

section
open Filter Topology MeasureTheory

/-! ### A translated box times a bounded block, as a spatial block -/
theorem translBox_facts (Cs N : ℝ) (v : E3) {B : E3 → ℂ} (hBm : Measurable B)
    (hB1 : ∀ x, ‖B x‖ ≤ 1) :
    Measurable (fun x => boxInd Cs N (x + v) * B x)
      ∧ (∀ x, ‖boxInd Cs N (x + v) * B x‖ ≤ 1)
      ∧ (∀ x, (∑ i : Fin 3, |Cs * N ^ expo i|) + ‖v‖ < ‖x‖ → boxInd Cs N (x + v) * B x = 0)
      ∧ Integrable (fun x => boxInd Cs N (x + v) * B x)
      ∧ (∫ x, ‖boxInd Cs N (x + v) * B x‖) ≤ (volume (petBox Cs N)).toReal
      ∧ (∫ x, ‖boxInd Cs N (x + v) * B x‖ ^ 2) ≤ (volume (petBox Cs N)).toReal := by
  have hm : Measurable fun x => boxInd Cs N (x + v) * B x :=
    ((measurable_boxInd Cs N).comp (measurable_id.add_const v)).mul hBm
  have h1 : ∀ x, ‖boxInd Cs N (x + v) * B x‖ ≤ 1 := fun x => by
    rw [norm_mul]
    exact (mul_le_of_le_one_left (norm_nonneg _) (norm_boxInd_le _ _ _)).trans (hB1 x)
  have hle : ∀ x, ‖boxInd Cs N (x + v) * B x‖ ≤ ‖boxInd Cs N (x + v)‖ := fun x => by
    rw [norm_mul]; exact mul_le_of_le_one_right (norm_nonneg _) (hB1 x)
  have hz : ∀ x, (∑ i : Fin 3, |Cs * N ^ expo i|) + ‖v‖ < ‖x‖ →
      boxInd Cs N (x + v) * B x = 0 := by
    intro x hx
    rw [boxInd_eq_zero, zero_mul]
    have := norm_sub_norm_le x (-v)
    rw [norm_neg, sub_neg_eq_add] at this
    linarith
  have hti : Integrable fun x => ‖boxInd Cs N (x + v)‖ :=
    ((integrable_boxInd Cs N).comp_add_right v).norm
  have hint : (∫ x, ‖boxInd Cs N (x + v)‖) = (volume (petBox Cs N)).toReal := by
    rw [integral_add_right_eq_self (fun x => ‖boxInd Cs N x‖) v, integral_norm_boxInd]
  refine ⟨hm, h1, hz, ?_, ?_, ?_⟩
  · exact integrable_of_bdd_ball hm.aestronglyMeasurable h1 hz
  · rw [← hint]
    exact integral_mono_of_nonneg (.of_forall fun x => norm_nonneg _) hti (.of_forall hle)
  · rw [← hint]
    refine integral_mono_of_nonneg (.of_forall fun x => by positivity) hti (.of_forall fun x => ?_)
    have := h1 x
    have h0 := norm_nonneg (boxInd Cs N (x + v) * B x)
    nlinarith [hle x]

variable {r : ℕ} {ι : Type*} {f : ι}

/-- The spatial block of a PET level: the enlarged box, translated along with the protected
input, times the state's spatial block. -/
noncomputable def petSpatialFun (N Cs : ℝ) (G : ι → E3 → ℂ) (η : Fin r → ℝ) (c : Bool)
    (S : NormalPETState r 3 ι f) (x : E3) : ℂ :=
  boxInd Cs N (x + petEvalVec η S.headFactor.transl) * petBlockFun G η c S.spatial x

/-- **A PET level**: the evaluated state against its spatial block, with no phase. -/
noncomputable def petLevel (V N Cs : ℝ) (G : ι → E3 → ℂ) (c : Bool) (S : NormalPETState r 3 ι f)
    (η : Fin r → ℝ) : ℂ :=
  vecAmp V N (petSpatialFun N Cs G η c S) (petEvalFam G η c S) fun _ _ => 1

/-- A PET level is measurable in the shifts. -/
theorem measurable_petLevel {G : ι → E3 → ℂ} (hG : ∀ i, Measurable (G i)) (V N Cs : ℝ)
    (c : Bool) (S : NormalPETState r 3 ι f) :
    Measurable fun η : Fin r → ℝ => petLevel V N Cs G c S η := by
  have hg : Measurable fun q : (Fin r → ℝ) × E3 => petSpatialFun N Cs G q.1 c S q.2 :=
    ((measurable_boxInd Cs N).comp (measurable_snd.add
      ((continuous_petEvalVec _).measurable.comp measurable_fst))).mul
      (measurable_petBlockFun hG c S.spatial)
  have hF : Measurable fun q : ((Fin r → ℝ) × E3) × ℝ =>
      vecProd (petEvalFam G q.1.1 c S) q.1.2 q.2 * 1 :=
    (measurable_vecProd_petEvalFam hG c S).mul measurable_const
  exact measurable_vecAmp_param V N (G := fun η x => petSpatialFun N Cs G η c S x)
    (F := fun η x t => vecProd (petEvalFam G η c S) x t * 1) hg hF

theorem petLevel_norm_le_one {G : ι → E3 → ℂ} (hG : ∀ i, Measurable (G i))
    (hG1 : ∀ i y, ‖G i y‖ ≤ 1) {N Cs : ℝ} (hN : 0 < N) (hCs : 0 < Cs) (c : Bool)
    (S : NormalPETState r 3 ι f) (η : Fin r → ℝ) :
    ‖petLevel (volume (petBox Cs N)).toReal N Cs G c S η‖ ≤ 1 := by
  have hV : 0 < (volume (petBox Cs N)).toReal := by
    rw [volume_petBox hCs.le hN.le, ENNReal.toReal_ofReal (by positivity)]; positivity
  obtain ⟨-, -, -, hi, hL1, -⟩ := translBox_facts Cs N (petEvalVec η S.headFactor.transl)
    ((measurable_petBlockFun hG c S.spatial).comp (measurable_const.prodMk measurable_id))
    (norm_petBlockFun_le hG1 η c S.spatial)
  exact norm_vecAmp_le_one hV hN hi hL1 (petEvalFam_facts hG hG1 η c S).2 fun _ _ => by simp

open scoped Classical in
/-- **Blueprint `patch:pet-analytic-step` between consecutive PET levels.** For fixed old shifts
`η` in the Fejer box, the level of a state is controlled by the Fejer average over the fresh shift
of the level of the updated state, with the global conjugation flag flipped. The spatial block of
each level is the enlarged box translated with the protected input; the support envelope of the
new head puts the children inside it. -/
theorem petLevel_step {N H C Cs M : ℝ} (hN1 : 1 ≤ N) (hH : 0 < H) (hHN : H ≤ N / 4)
    (hC : 0 < C) (hCM : C + M ≤ Cs) (hCCs : C ≤ Cs)
    {G : ι → E3 → ℂ} (hG : ∀ i, Measurable (G i)) (hG1 : ∀ i y, ‖G i y‖ ≤ 1)
    (hGf : ∀ y, y ∉ petBox C N → G f y = 0) (c : Bool)
    {s : ℕ} {S : NormalPETState r 3 ι f} (hFB : PetFacsBelow s S)
    (hB : ∀ it ∈ petAllItems S, PetPolyBelow s it.1) {iu : Fin r} (hiu : iu.val = s)
    {Qp : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ)} (hQp : Qp ∈ (petAllItems S).map Prod.fst)
    {S' : NormalPETState r 3 ι f}
    (hsp : S'.spatial = petNewSpatial (fun _ => MvPolynomial.X iu) Qp S)
    (hhp : S'.headPoly = (petNewHead (fun _ => MvPolynomial.X iu) Qp S).1)
    (hhf : S'.headFactor = petNewHeadFactor (fun _ => MvPolynomial.X iu) Qp S)
    (hrest : S'.rest = petGroup (petNonConstChildren (fun _ => MvPolynomial.X iu) Qp S))
    (hEnv : PetStateEnv N H N M S') {η : Fin r → ℝ} (hη : ∀ v, |η v| ≤ H) :
    ‖petLevel (volume (petBox Cs N)).toReal N Cs G c S η‖ ^ 2
      ≤ 2 * (∫ u : ℝ, fejer H u
          * ‖petLevel (volume (petBox Cs N)).toReal N Cs G (!c) S' (Function.update η iu u)‖)
        + 2 * H / N := by
  set V := (volume (petBox Cs N)).toReal with hVdef
  have hN : 0 < N := by linarith
  have hCs : 0 < Cs := by linarith
  have hV : 0 < V := by
    rw [hVdef, volume_petBox hCs.le hN.le, ENNReal.toReal_ofReal (by positivity)]; positivity
  set η' : ℝ → Fin r → ℝ := fun u => Function.update η iu u with hη'
  have hagree : ∀ u, ∀ w : Fin r, w.val < s → η w = η' u w := by
    intro u w hw
    have hne : w ≠ iu := fun h => by rw [h] at hw; omega
    simp [hη', Function.update_of_ne hne]
  have hη'box : ∀ u, |u| ≤ H → ∀ w, |η' u w| ≤ H := by
    intro u hu w
    by_cases hw : w = iu
    · subst hw; simpa [hη'] using hu
    · simpa [hη', Function.update_of_ne hw] using hη w
  obtain ⟨itp, hitp, rfl⟩ := List.mem_map.mp hQp
  have hQpB := hB itp hitp
  -- the head block and its support
  set v : E3 := petEvalVec η S.headFactor.transl with hv
  obtain ⟨hL, hL1⟩ := petEvalFam_facts hG hG1 η c S
  have hfam : petEvalFam G η c S = petEvalItem G η c (S.headPoly, [S.headFactor])
      :: S.rest.map (petEvalItem G η c) := by
    simp [petEvalFam, petAllItems]
  rw [hfam] at hL hL1
  set K : Set E3 := (fun y => y + v) ⁻¹' petBox C N with hK
  have hKm : MeasurableSet K := (measurableSet_petBox C N).preimage (measurable_id.add_const v)
  have hKb : Bornology.IsBounded K := by
    refine (Metric.isBounded_closedBall (x := (0 : E3))
      (r := (∑ i : Fin 3, |C * N ^ expo i|) + ‖v‖)).subset fun y hy => ?_
    rw [Metric.mem_closedBall, dist_zero_right]
    have h1 := norm_le_of_mem_petBox (show y + v ∈ petBox C N from hy)
    have h2 := norm_sub_le (y + v) v
    rw [add_sub_cancel_right] at h2
    linarith
  have hbK : ∀ y, y ∉ K → (petEvalItem G η c (S.headPoly, [S.headFactor])).1 y = 0 := by
    intro y hy
    simp only [petEvalItem, petBlockFun, List.map_cons, List.map_nil, List.prod_cons,
      List.prod_nil, mul_one, petFacFun, S.head_origin]
    rw [hGf _ hy]
    cases xor c S.headFactor.isConj <;> simp
  have hKV : (volume K).toReal ≤ V := by
    rw [hK, measure_preimage_add_right]
    exact ENNReal.toReal_mono (volume_petBox_ne_top _ _) (measure_mono (petBox_mono hCCs hN.le))
  obtain ⟨hgm, hg1, hgR, -, -, hgV⟩ := translBox_facts Cs N v
    ((measurable_petBlockFun hG c S.spatial).comp (measurable_const.prodMk measurable_id))
    (norm_petBlockFun_le hG1 η c S.spatial)
  -- the next level
  have hne : (petNewHead (fun _ => MvPolynomial.X iu) itp.1 S).1 ≠ 0 := hhp ▸ S'.headPoly_ne_zero
  have hid : ∀ u, |u| ≤ H → ∀ t ∈ Set.Icc (0 : ℝ) N, ∀ x,
      vecProd (vecChildren (petEvalItem G η c (S.headPoly, [S.headFactor])
          :: S.rest.map (petEvalItem G η c)) (petEvalPoly η itp.1) u) x t
          * phaseChild (fun _ _ => (1 : ℂ)) (petEvalPoly η itp.1) u x t
        = petSpatialFun N Cs G (η' u) (!c) S' x
          * (vecProd (petEvalFam G (η' u) (!c) S') x t * 1) := by
    intro u hu t ht x
    have hpc : phaseChild (fun _ _ => (1 : ℂ)) (petEvalPoly η itp.1) u x t = 1 := by
      simp [phaseChild]
    rw [hpc, mul_one, mul_one, ← hfam, petEvalFam_eq_of_below hFB hB G c (hagree u),
      petEvalPoly_eq_of_below hQpB (hagree u)]
    have hup := vecProd_vecChildren_update G (η' u) c iu itp.1 S hne x t
    rw [show η' u iu = u by simp [hη']] at hup
    rw [hup, ← hsp, ← hhp, ← hhf, ← hrest]
    have hfam' : petEvalFam G (η' u) (!c) S' = petEvalItem G (η' u) (!c)
        (S'.headPoly, [S'.headFactor]) :: S'.rest.map (petEvalItem G (η' u) (!c)) := by
      simp [petEvalFam, petAllItems]
    rw [← hfam', petSpatialFun]
    -- the box indicator is one wherever the product is nonzero
    by_cases hx : x + petEvalVec (η' u) S'.headFactor.transl ∈ petBox Cs N
    · rw [boxInd, Set.indicator_of_mem hx, one_mul]
    · have hz : vecProd (petEvalFam G (η' u) (!c) S') x t = 0 := by
        rw [hfam', vecProd_cons]
        have hhead : G f (x + petEvalPoly (η' u) S'.headPoly t
            + petEvalVec (η' u) S'.headFactor.transl) = 0 := by
          refine hGf _ fun hmem => hx ?_
          have hmem' : (x + petEvalVec (η' u) S'.headFactor.transl)
              + petEvalPoly (η' u) S'.headPoly t ∈ petBox C N := by
            rwa [add_right_comm]
          have hd : ∀ k : Fin 3, |petEvalPoly (η' u) S'.headPoly t k| ≤ M * N ^ expo k :=
            hEnv _ (List.mem_cons_self) (η' u) (hη'box u hu) t
              (by rw [abs_of_nonneg ht.1]; exact ht.2)
          exact petBox_mono hCM hN.le (mem_petBox_of_add_mem hmem' hd)
        simp only [petEvalItem, petBlockFun, List.map_cons, List.map_nil, List.prod_cons,
          List.prod_nil, mul_one, petFacFun, S'.head_origin, hhead]
        cases xor (!c) S'.headFactor.isConj <;> simp
      rw [hz]; ring
  have hAm : Measurable fun u : ℝ => ‖vecAmp V N (petSpatialFun N Cs G (η' u) (!c) S')
      (petEvalFam G (η' u) (!c) S') fun _ _ => (1 : ℂ)‖ := by
    have h1 := measurable_petLevel hG V N Cs (!c) S'
    have h2 : Continuous η' := continuous_const.update iu continuous_id
    exact (h1.comp h2.measurable).norm
  have hA1 : ∀ u, |u| ≤ H → ‖vecAmp V N (petSpatialFun N Cs G (η' u) (!c) S')
      (petEvalFam G (η' u) (!c) S') (fun _ _ => (1 : ℂ))‖ ≤ 1 := fun u _ =>
    petLevel_norm_le_one hG hG1 hN hCs (!c) S' (η' u)
  have key := vecAmp_step (g' := fun u => petSpatialFun N Cs G (η' u) (!c) S')
    (L' := fun u => petEvalFam G (η' u) (!c) S') (φ' := fun _ _ _ => (1 : ℂ))
    hN hH hHN hV hL hL1 measurable_const (fun _ _ => by simp) hKm hKb hbK hKV hgm hg1 hgR hgV
    (continuous_petEvalPoly η itp.1) hid hAm hA1
  rw [petLevel, hfam]
  exact key

end

section
open Filter Topology MeasureTheory

variable {r : ℕ}

/-! ### The initial shifted family as symbolic polynomials

Blueprint `patch:initial-shift-family`: after the four phase steps the shifts are
`P_i(t + ω·h) e_i - P_i(ω·h) e_i`. A real polynomial `P` along the coordinate `j` is lifted to a
vector polynomial with coefficients in the shift ring; the vertex shift `ω·h` becomes the symbolic
sum of the corresponding shift variables. -/

/-- `P(t) e_j` as a vector polynomial over the shift ring. -/
noncomputable def vecLift (P : Polynomial ℝ) (j : Fin 3) :
    Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ) :=
  Polynomial.C (Pi.single j 1) * P.map (algebraMap ℝ (Fin 3 → MvPolynomial (Fin r) ℝ))

theorem vecLift_coeff (P : Polynomial ℝ) (j : Fin 3) (q : ℕ) :
    (vecLift (r := r) P j).coeff q = Pi.single j (MvPolynomial.C (P.coeff q)) := by
  rw [vecLift, Polynomial.coeff_C_mul, Polynomial.coeff_map]
  funext k
  by_cases hk : k = j
  · subst hk; simp
  · simp [hk]

theorem pi_single_C_eq_zero_iff {j : Fin 3} {a : ℝ} :
    (Pi.single j (MvPolynomial.C a) : Fin 3 → MvPolynomial (Fin r) ℝ) = 0 ↔ a = 0 := by
  constructor
  · intro h
    have := congrFun h j
    simpa using this
  · rintro rfl; simp

theorem natDegree_vecLift (P : Polynomial ℝ) (j : Fin 3) :
    (vecLift (r := r) P j).natDegree = P.natDegree := by
  apply le_antisymm
  · refine Polynomial.natDegree_le_iff_coeff_eq_zero.mpr fun q hq => ?_
    rw [vecLift_coeff, Polynomial.coeff_eq_zero_of_natDegree_lt hq]; simp
  · by_cases hP : P = 0
    · simp [hP]
    · refine Polynomial.le_natDegree_of_ne_zero ?_
      rw [vecLift_coeff, Ne, pi_single_C_eq_zero_iff]
      exact Polynomial.leadingCoeff_ne_zero.mpr hP

theorem leadingCoeff_vecLift (P : Polynomial ℝ) (j : Fin 3) :
    (vecLift (r := r) P j).leadingCoeff = Pi.single j (MvPolynomial.C P.leadingCoeff) := by
  rw [Polynomial.leadingCoeff, natDegree_vecLift, vecLift_coeff]; rfl

theorem petEvalPoly_vecLift (η : Fin r → ℝ) (P : Polynomial ℝ) (j : Fin 3) (t : ℝ) :
    petEvalPoly η (vecLift P j) t = P.eval t • basisVec j := by
  have key : ∀ k, (((vecLift (r := r) P j).map (petEvalHom η)).eval fun _ => t) k
      = (Pi.single j 1 : Fin 3 → ℝ) k * P.eval t := by
    intro k
    rw [vecLift, Polynomial.map_mul, Polynomial.map_C, Polynomial.eval_mul, Polynomial.eval_C,
      Pi.mul_apply]
    congr 1
    · simp [Pi.single_apply]
    · rw [Polynomial.map_map, Polynomial.eval_map]
      change (Pi.evalRingHom (fun _ : Fin 3 => ℝ) k) (P.eval₂ _ _) = _
      rw [Polynomial.hom_eval₂]
      have hid : ((Pi.evalRingHom (fun _ : Fin 3 => ℝ) k).comp ((petEvalHom η).comp
          (algebraMap ℝ (Fin 3 → MvPolynomial (Fin r) ℝ)))) = RingHom.id ℝ :=
        RingHom.ext fun a => by simp [Pi.algebraMap_apply]
      rw [hid]
      rfl
  ext k
  rw [petEvalPoly_apply, key, PiLp.smul_apply, smul_eq_mul, basisVec]
  by_cases hk : k = j
  · subst hk; simp
  · simp [hk]

/-- The item polynomial of the shifted family: `-(P(t + s) - P(s)) e_j`. -/
noncomputable def initPoly (P : Polynomial ℝ) (j : Fin 3) (s : MvPolynomial (Fin r) ℝ) :
    Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ) :=
  petSubConst (-(Polynomial.taylor (fun _ => s) (vecLift P j)))

/-- Its translation record: `-P(s) e_j`. -/
noncomputable def initTransl (P : Polynomial ℝ) (j : Fin 3) (s : MvPolynomial (Fin r) ℝ) :
    Fin 3 → MvPolynomial (Fin r) ℝ :=
  (-(Polynomial.taylor (fun _ => s) (vecLift P j))).coeff 0

theorem initPoly_coeff_zero (P : Polynomial ℝ) (j : Fin 3) (s : MvPolynomial (Fin r) ℝ) :
    (initPoly P j s).coeff 0 = 0 := petSubConst_coeff_zero _

theorem natDegree_initPoly {P : Polynomial ℝ} (hP : 1 ≤ P.natDegree) (j : Fin 3)
    (s : MvPolynomial (Fin r) ℝ) : (initPoly P j s).natDegree = P.natDegree := by
  have h : (-(Polynomial.taylor (fun _ => s) (vecLift (r := r) P j))).natDegree = P.natDegree := by
    rw [Polynomial.natDegree_neg, Polynomial.natDegree_taylor, natDegree_vecLift]
  rw [initPoly, natDegree_petSubConst (by rw [h]; exact hP), h]

theorem leadingCoeff_initPoly {P : Polynomial ℝ} (hP : 1 ≤ P.natDegree) (j : Fin 3)
    (s : MvPolynomial (Fin r) ℝ) :
    (initPoly P j s).leadingCoeff = Pi.single j (MvPolynomial.C (-P.leadingCoeff)) := by
  have h : (-(Polynomial.taylor (fun _ => s) (vecLift (r := r) P j))).natDegree = P.natDegree := by
    rw [Polynomial.natDegree_neg, Polynomial.natDegree_taylor, natDegree_vecLift]
  rw [initPoly, leadingCoeff_petSubConst (by rw [h]; exact hP), Polynomial.leadingCoeff_neg,
    Polynomial.leadingCoeff_taylor, leadingCoeff_vecLift, map_neg, Pi.single_neg]

theorem initPoly_ne_zero {P : Polynomial ℝ} (hP : 1 ≤ P.natDegree) (j : Fin 3)
    (s : MvPolynomial (Fin r) ℝ) : initPoly P j s ≠ 0 := by
  intro h0
  have := natDegree_initPoly hP j s
  rw [h0, Polynomial.natDegree_zero] at this
  omega

/-- **Two shifts of the same input differ in degree `d - 1`**, with leading coefficient
`-lc(P) d (s₁ - s₂) e_j` (blueprint `patch:initial-shift-family`: "their difference has degree
`D - 1` and leading coefficient `a D [(1 - ω)·h] e_m`"). -/
theorem sub_initPoly_same {P : Polynomial ℝ} {e : ℕ} (hP : P.natDegree = e + 1) (he : 1 ≤ e)
    (j : Fin 3) {s₁ s₂ : MvPolynomial (Fin r) ℝ} (hs : s₁ ≠ s₂) :
    (initPoly P j s₁ - initPoly P j s₂).natDegree = e
      ∧ (initPoly P j s₁ - initPoly P j s₂).leadingCoeff
        = Pi.single j (MvPolynomial.C (-P.leadingCoeff) * (((e : ℝ) + 1) • (s₁ - s₂))) := by
  set L := vecLift (r := r) P j with hL
  have hLd : L.natDegree = e + 1 := by rw [hL, natDegree_vecLift, hP]
  set u : Fin 3 → MvPolynomial (Fin r) ℝ := fun _ => s₁ - s₂ with hu
  set X := Polynomial.taylor u L - L with hX
  have hXle : X.natDegree ≤ e := natDegree_taylor_sub_self_le L u hLd
  have hXe : X.coeff e
      = Pi.single j (((e : ℝ) + 1) • (s₁ - s₂) * MvPolynomial.C P.leadingCoeff) := by
    rw [hX, coeff_taylor_sub_self L u hLd, hL, leadingCoeff_vecLift]
    funext k
    by_cases hk : k = j
    · subst hk; simp [hu, Algebra.smul_def, mul_comm, mul_assoc]
    · simp [hk]
  have hlc0 : P.leadingCoeff ≠ 0 := by
    intro h0; rw [Polynomial.leadingCoeff_eq_zero] at h0; rw [h0] at hP; simp at hP
  have hXe0 : X.coeff e ≠ 0 := by
    rw [hXe]
    intro h0
    have := congrFun h0 j
    rw [Pi.single_eq_same, Pi.zero_apply, mul_eq_zero] at this
    rcases this with h1 | h1
    · rw [smul_eq_zero] at h1
      rcases h1 with h1 | h1
      · have : (0 : ℝ) < (e : ℝ) + 1 := by positivity
        linarith
      · exact hs (sub_eq_zero.mp h1)
    · exact hlc0 (MvPolynomial.C_eq_zero.mp h1)
  have hXd : X.natDegree = e := le_antisymm hXle (Polynomial.le_natDegree_of_ne_zero hXe0)
  have hXlc : X.leadingCoeff = X.coeff e := by rw [Polynomial.leadingCoeff, hXd]
  -- the difference of the two items
  have hdiff : initPoly P j s₁ - initPoly P j s₂
      = petSubConst (-(Polynomial.taylor (fun _ => s₂) X)) := by
    rw [initPoly, initPoly, petSubConst_sub, hX, map_sub, Polynomial.taylor_taylor]
    congr 1
    have : (fun _ : Fin 3 => s₂) + u = fun _ => s₁ := by funext k; simp [hu]
    rw [this]
    ring
  have hTd : (-(Polynomial.taylor (fun _ => s₂) X)).natDegree = e := by
    rw [Polynomial.natDegree_neg, Polynomial.natDegree_taylor, hXd]
  rw [hdiff, natDegree_petSubConst (by rw [hTd]; exact he), hTd,
    leadingCoeff_petSubConst (by rw [hTd]; exact he), Polynomial.leadingCoeff_neg,
    Polynomial.leadingCoeff_taylor, hXlc, hXe]
  refine ⟨rfl, ?_⟩
  funext k
  by_cases hk : k = j
  · subst hk; simp only [Pi.neg_apply, Pi.single_eq_same, map_neg]; ring
  · simp [hk]

/-! ### Vertex shifts, their witnesses, and the numeric shift vector -/

/-- The numeric shift vector at level `k`: the `k` shifts of the chain, the newest (index `0` of
`Fin.cons`) in the last introduced variable `k - 1`, every later variable zero. -/
noncomputable def petShiftVec (k : ℕ) (h : Fin k → ℝ) : Fin r → ℝ := fun v =>
  if hv : v.val < k then h ⟨k - 1 - v.val, by omega⟩ else 0

theorem petShiftVec_cons {k : ℕ} (hk : k < r) (u : ℝ) (h : Fin k → ℝ) :
    petShiftVec (r := r) (k + 1) (Fin.cons u h)
      = Function.update (petShiftVec k h) ⟨k, hk⟩ u := by
  funext v
  by_cases hv : v = ⟨k, hk⟩
  · subst hv
    simp [petShiftVec]
  · rw [Function.update_of_ne hv]
    have hvk : v.val ≠ k := fun h => hv (Fin.ext h)
    by_cases hlt : v.val < k
    · simp only [petShiftVec, dite_eq_left hlt, dite_eq_left (show v.val < k + 1 by omega)]
      have : (⟨k + 1 - 1 - v.val, by omega⟩ : Fin (k + 1))
          = (⟨k - 1 - v.val, by omega⟩ : Fin k).succ := by
        ext; simp; omega
      rw [this, Fin.cons_succ]
    · simp only [petShiftVec, dite_eq_right hlt, dite_eq_right (show ¬ v.val < k + 1 by omega)]

theorem abs_petShiftVec_le {H : ℝ} (hH : 0 ≤ H) {k : ℕ} {h : Fin k → ℝ}
    (hh : ∀ l, |h l| ≤ H) (v : Fin r) : |petShiftVec k h v| ≤ H := by
  unfold petShiftVec
  split_ifs
  · exact hh _
  · simpa using hH

theorem continuous_petShiftVec (k : ℕ) : Continuous (petShiftVec (r := r) k) := by
  refine continuous_pi fun v => ?_
  unfold petShiftVec
  split_ifs
  · exact continuous_apply _
  · exact continuous_const

/-- The integer vertex shift `Σ_{l : ω l} X_{3 - l}`. -/
noncomputable def vShiftZ (hr : 4 ≤ r) (ω : Fin 4 → Bool) : MvPolynomial (Fin r) ℤ :=
  ∑ l : Fin 4, if ω l then MvPolynomial.X ⟨3 - l.val, by omega⟩ else 0

/-- Its real version. -/
noncomputable def vShift (hr : 4 ≤ r) (ω : Fin 4 → Bool) : MvPolynomial (Fin r) ℝ :=
  (vShiftZ hr ω).map (Int.castRingHom ℝ)

theorem eval_vShift (hr : 4 ≤ r) (ω : Fin 4 → Bool) (h : Fin 4 → ℝ) :
    MvPolynomial.eval (petShiftVec 4 h) (vShift hr ω) = cubeShift h ω := by
  simp only [vShift, vShiftZ, map_sum, cubeShift]
  refine Finset.sum_congr rfl fun l _ => ?_
  split_ifs
  · simp only [MvPolynomial.map_X, MvPolynomial.eval_X, petShiftVec]
    rw [dite_eq_left (show 3 - l.val < 4 by omega)]
    congr 1; ext; simp only; omega
  · simp

theorem vShift_sub (hr : 4 ≤ r) (ω : Fin 4 → Bool) :
    vShift hr (fun _ => true) - vShift hr ω = vShift hr fun l => !ω l := by
  simp only [vShift, vShiftZ, ← map_sub, ← Finset.sum_sub_distrib]
  congr 1
  refine Finset.sum_congr rfl fun l _ => ?_
  by_cases hl : ω l <;> simp [hl]

theorem vShiftZ_isHomogeneous (hr : 4 ≤ r) (ω : Fin 4 → Bool) :
    (vShiftZ hr ω).IsHomogeneous 1 := by
  refine MvPolynomial.IsHomogeneous.sum _ _ _ fun l _ => ?_
  split_ifs
  · exact MvPolynomial.isHomogeneous_X _ _
  · exact MvPolynomial.isHomogeneous_zero _ _ _

theorem vShiftZ_degreeOf_le (hr : 4 ≤ r) (ω : Fin 4 → Bool) (i : Fin r) :
    (vShiftZ hr ω).degreeOf i ≤ 1 := by
  classical
  refine (MvPolynomial.degreeOf_sum_le _ _ _).trans (Finset.sup_le fun l _ => ?_)
  split_ifs
  · rw [MvPolynomial.degreeOf_X]; split_ifs <;> omega
  · rw [MvPolynomial.degreeOf_zero]; omega

theorem vShiftZ_ne_zero (hr : 4 ≤ r) {ω : Fin 4 → Bool} (hω : ∃ l, ω l = true) :
    vShiftZ hr ω ≠ 0 := by
  intro h0
  have h1 := congrArg (MvPolynomial.eval (fun _ : Fin r => (1 : ℤ))) h0
  simp only [vShiftZ, map_sum, map_zero] at h1
  obtain ⟨l, hl⟩ := hω
  have hpos : 0 < ∑ l : Fin 4, MvPolynomial.eval (fun _ : Fin r => (1 : ℤ))
      (if ω l then MvPolynomial.X ⟨3 - l.val, by omega⟩ else 0) := by
    refine Finset.sum_pos' (fun l _ => ?_) ⟨l, Finset.mem_univ _, ?_⟩
    · split_ifs <;> simp
    · simp [hl]
  omega

theorem abs_aeval_vShiftZ_le (hr : 4 ≤ r) (ω : Fin 4 → Bool) {u : Fin r → ℝ}
    (hu : ∀ i, |u i| ≤ 1) : |MvPolynomial.aeval u (vShiftZ hr ω)| ≤ 4 := by
  simp only [vShiftZ, map_sum]
  calc |∑ l : Fin 4, MvPolynomial.aeval u
        (if ω l then MvPolynomial.X ⟨3 - l.val, by omega⟩ else (0 : MvPolynomial (Fin r) ℤ))|
      ≤ ∑ l : Fin 4, |MvPolynomial.aeval u
        (if ω l then MvPolynomial.X ⟨3 - l.val, by omega⟩ else (0 : MvPolynomial (Fin r) ℤ))| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _l : Fin 4, (1 : ℝ) := Finset.sum_le_sum fun l _ => by
        split_ifs
        · simp only [MvPolynomial.aeval_X]; exact hu _
        · simp
    _ = 4 := by simp

end

section
open Filter Topology MeasureTheory

variable {r : ℕ}

theorem petEvalPoly_taylor_const (η : Fin r → ℝ) (s : MvPolynomial (Fin r) ℝ)
    (Q : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ)) (t : ℝ) :
    petEvalPoly η (Polynomial.taylor (fun _ => s) Q) t
      = petEvalPoly η Q (t + MvPolynomial.eval η s) := by
  simp only [petEvalPoly, Polynomial.map_taylor, Polynomial.taylor_eval]
  congr 2

theorem petEvalPoly_neg (η : Fin r → ℝ) (Q : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ))
    (t : ℝ) : petEvalPoly η (-Q) t = -petEvalPoly η Q t := by
  simp only [petEvalPoly, Polynomial.map_neg, Polynomial.eval_neg]
  rfl

theorem PetPolyBelow.taylor_const {s : ℕ} {Q : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ)}
    (hQ : PetPolyBelow s Q) {c : MvPolynomial (Fin r) ℝ} (hc : c ∈ petVarAlg r s) :
    PetPolyBelow s (Polynomial.taylor (fun _ => c) Q) := by
  intro q k
  rw [Polynomial.taylor_coeff, Polynomial.eval_eq_sum_range, Finset.sum_apply]
  refine Subalgebra.sum_mem _ fun i _ => ?_
  rw [Pi.mul_apply, Pi.pow_apply, Polynomial.hasseDeriv_coeff]
  refine mul_mem ?_ (pow_mem hc _)
  have : (((i + q).choose q : ℕ) * Q.coeff (i + q) : Fin 3 → MvPolynomial (Fin r) ℝ) k
      = ((i + q).choose q : ℕ) • Q.coeff (i + q) k := by
    simp [nsmul_eq_mul]
  rw [this]
  exact nsmul_mem (hQ _ k) _

theorem PetPolyBelow.neg {s : ℕ} {Q : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ)}
    (hQ : PetPolyBelow s Q) : PetPolyBelow s (-Q) := fun q k => by
  rw [Polynomial.coeff_neg, Pi.neg_apply]; exact neg_mem (hQ q k)

theorem petPolyBelow_vecLift (s : ℕ) (P : Polynomial ℝ) (j : Fin 3) :
    PetPolyBelow s (vecLift (r := r) P j) := fun q k => by
  rw [vecLift_coeff]
  by_cases hk : k = j
  · subst hk; rw [Pi.single_eq_same]; exact Subalgebra.algebraMap_mem _ _
  · rw [Pi.single_eq_of_ne hk]; exact zero_mem _

theorem vShift_mem (hr : 4 ≤ r) (ω : Fin 4 → Bool) : vShift hr ω ∈ petVarAlg r 4 := by
  simp only [vShift, vShiftZ, map_sum]
  refine Subalgebra.sum_mem _ fun l _ => ?_
  split_ifs
  · rw [MvPolynomial.map_X]
    exact MvPolynomial.mem_supported.mpr (by
      rw [MvPolynomial.vars_X]; intro v hv
      simp only [Finset.coe_singleton, Set.mem_singleton_iff] at hv
      subst hv; simp only [Set.mem_ofPred_eq]; omega)
  · rw [map_zero]; exact zero_mem _

theorem petPolyBelow_initPoly (hr : 4 ≤ r) (P : Polynomial ℝ) (j : Fin 3) (ω : Fin 4 → Bool) :
    PetPolyBelow 4 (initPoly P j (vShift hr ω)) :=
  (((petPolyBelow_vecLift 4 P j).taylor_const (vShift_mem hr ω)).neg).petSubConst

theorem initTransl_mem (hr : 4 ≤ r) (P : Polynomial ℝ) (j : Fin 3) (ω : Fin 4 → Bool)
    (k : Fin 3) : initTransl P j (vShift hr ω) k ∈ petVarAlg r 4 :=
  ((petPolyBelow_vecLift 4 P j).taylor_const (vShift_mem hr ω)).neg.coeff_mem 0 k

/-- The evaluated item shift: `-(P(t + s) - P(s)) e_j`. -/
theorem petEvalPoly_initPoly (η : Fin r → ℝ) (P : Polynomial ℝ) (j : Fin 3)
    (s : MvPolynomial (Fin r) ℝ) (t : ℝ) :
    petEvalPoly η (initPoly P j s) t
      = -((P.eval (t + MvPolynomial.eval η s) - P.eval (MvPolynomial.eval η s)) • basisVec j) := by
  rw [initPoly, petEvalPoly_petSubConst, ← petEvalPoly_zero_eq, petEvalPoly_neg, petEvalPoly_neg,
    petEvalPoly_taylor_const, petEvalPoly_taylor_const, petEvalPoly_vecLift, petEvalPoly_vecLift,
    zero_add, sub_smul]
  abel

/-- The evaluated translation record: `-P(s) e_j`. -/
theorem petEvalVec_initTransl (η : Fin r → ℝ) (P : Polynomial ℝ) (j : Fin 3)
    (s : MvPolynomial (Fin r) ℝ) :
    petEvalVec η (initTransl P j s) = -(P.eval (MvPolynomial.eval η s) • basisVec j) := by
  rw [initTransl, ← petEvalPoly_zero_eq, petEvalPoly_neg, petEvalPoly_taylor_const,
    petEvalPoly_vecLift, zero_add]

/-! ### The initial normal state -/

/-- The conjugation flag of a vertex: conjugated when the number of zero bits is odd. -/
def vertexConj {s : ℕ} (ω : Fin s → Bool) : Bool := !decide (Even (numFalse ω))

theorem condConj_vertexConj {s : ℕ} (ω : Fin s → Bool) (z : ℂ) :
    condConj (vertexConj ω) z = conjPar (numFalse ω) z := by
  by_cases h : Even (numFalse ω) <;> simp [vertexConj, conjPar, h]

/-- The item of the shifted family at vertex `ω` and input `i`. -/
noncomputable def initItem (hr : 4 ≤ r) (P : ℕ → Polynomial ℝ) (j : ℕ → Fin 3)
    (q : (Fin 4 → Bool) × ℕ) :
    Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ) × List (PetFactor r 3 ℕ) :=
  (initPoly (P q.2) (j q.2) (vShift hr q.1),
    [⟨q.2, vertexConj q.1, initTransl (P q.2) (j q.2) (vShift hr q.1)⟩])

/-- The indices of the family other than the protected head `((1,1,1,1), m)`. -/
noncomputable def initIndex (m : ℕ) : Finset ((Fin 4 → Bool) × ℕ) :=
  (Finset.univ ×ˢ Finset.Icc 1 m).erase ((fun _ => true), m)

/-- The other items, before grouping. -/
noncomputable def initRestRaw (hr : 4 ≤ r) (P : ℕ → Polynomial ℝ) (j : ℕ → Fin 3) (m : ℕ) :
    List (Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ) × List (PetFactor r 3 ℕ)) :=
  (initIndex m).toList.map (initItem hr P j)

/-- The hypotheses on the input polynomials of `patch:highest-control`. -/
structure InitDegrees (P : ℕ → Polynomial ℝ) (m : ℕ) : Prop where
  one_le : 1 ≤ m
  deg_pos : ∀ i ∈ Finset.Icc 1 m, 1 ≤ (P i).natDegree
  deg_lt : ∀ i ∈ Finset.Icc 1 m, i ≠ m → (P i).natDegree < (P m).natDegree
  two_le : 2 ≤ (P m).natDegree
  le_three : (P m).natDegree ≤ 3

theorem mem_initRestRaw {hr : 4 ≤ r} {P : ℕ → Polynomial ℝ} {j : ℕ → Fin 3} {m : ℕ}
    {it : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ) × List (PetFactor r 3 ℕ)}
    (h : it ∈ initRestRaw hr P j m) :
    ∃ q : (Fin 4 → Bool) × ℕ, q.2 ∈ Finset.Icc 1 m ∧ q ≠ ((fun _ => true), m)
      ∧ it = initItem hr P j q := by
  rw [initRestRaw, List.mem_map] at h
  obtain ⟨q, hq, rfl⟩ := h
  rw [Finset.mem_toList, initIndex, Finset.mem_erase, Finset.mem_product] at hq
  exact ⟨q, hq.2.2, hq.1, rfl⟩

theorem vShift_top_ne (hr : 4 ≤ r) {ω : Fin 4 → Bool} (hω : ω ≠ fun _ => true) :
    vShift hr (fun _ => true) ≠ vShift hr ω := by
  intro h
  have h0 := sub_eq_zero.mpr h
  rw [vShift_sub] at h0
  have hex : ∃ l, (fun l => !ω l) l = true := by
    by_contra hno
    push Not at hno
    exact hω (funext fun l => by simpa using hno l)
  exact vShiftZ_ne_zero hr hex
    ((MvPolynomial.map_injective _ (Int.castRingHom ℝ).injective_int) (by
      rw [map_zero]; exact h0))

/-- The witness of a same-input difference, `D (Σ_{ω_l = 0} X_{3-l})`. -/
noncomputable def initWitness (hr : 4 ≤ r) (e : ℕ) (ω : Fin 4 → Bool) : MvPolynomial (Fin r) ℤ :=
  MvPolynomial.C ((e : ℤ) + 1) * vShiftZ hr fun l => !ω l

/-- **The lead invariant for the differences of the head with the other items.** -/
theorem initItem_lead {hr : 4 ≤ r} {P : ℕ → Polynomial ℝ} {j : ℕ → Fin 3} {m : ℕ}
    (hP : InitDegrees P m) {q : (Fin 4 → Bool) × ℕ} (hq : q.2 ∈ Finset.Icc 1 m)
    (hqne : q ≠ ((fun _ => true), m)) :
    let head := initPoly (r := r) (P m) (j m) (vShift hr fun _ => true)
    let a := -(P m).leadingCoeff
    ∃ p : MvPolynomial (Fin r) ℤ, p ≠ 0 ∧ p.IsHomogeneous ((P m).natDegree
        - (head - (initItem hr P j q).1).natDegree) ∧ (∀ i, p.degreeOf i ≤ 1)
      ∧ (head - (initItem hr P j q).1).leadingCoeff
        = Pi.single (j m) (MvPolynomial.C a * p.map (Int.castRingHom ℝ))
      ∧ EvalBd (4 * (P m).natDegree) p := by
  intro head a
  have hm1 : m ∈ Finset.Icc 1 m := Finset.mem_Icc.mpr ⟨hP.one_le, le_rfl⟩
  have hDpos := hP.deg_pos m hm1
  have hhd : head.natDegree = (P m).natDegree := natDegree_initPoly hDpos _ _
  have hhlc : head.leadingCoeff = Pi.single (j m) (MvPolynomial.C a) :=
    leadingCoeff_initPoly hDpos _ _
  by_cases hi : q.2 = m
  · -- the same input at another vertex
    have hω : q.1 ≠ fun _ => true := fun h => hqne (Prod.ext h hi)
    obtain ⟨e, he⟩ : ∃ e, (P m).natDegree = e + 1 := ⟨(P m).natDegree - 1, by omega⟩
    have he1 : 1 ≤ e := by have := hP.two_le; omega
    obtain ⟨hd, hlc⟩ := sub_initPoly_same (r := r) he he1 (j m) (vShift_top_ne hr hω)
    have hit : (initItem hr P j q).1 = initPoly (P m) (j m) (vShift hr q.1) := by
      simp [initItem, hi]
    refine ⟨initWitness hr e q.1, ?_, ?_, ?_, ?_, ?_⟩
    · have hex : ∃ l, (fun l => !q.1 l) l = true := by
        by_contra hno
        push Not at hno
        exact hω (funext fun l => by simpa using hno l)
      refine mul_ne_zero ?_ (vShiftZ_ne_zero hr hex)
      rw [Ne, MvPolynomial.C_eq_zero]; omega
    · rw [hit, hd, he, show e + 1 - e = 0 + 1 by omega]
      exact (MvPolynomial.isHomogeneous_C _ _).mul (vShiftZ_isHomogeneous hr _)
    · intro i
      exact (MvPolynomial.degreeOf_C_mul_le _ _ _).trans (vShiftZ_degreeOf_le hr _ i)
    · rw [hit, hlc, vShift_sub, initWitness, map_mul, MvPolynomial.map_C]
      congr 1
      simp only [a, vShift, MvPolynomial.smul_eq_C_mul, map_neg, map_add, map_natCast, map_one]
    · intro u hu
      rw [initWitness, map_mul, MvPolynomial.aeval_C, abs_mul, he]
      have h4 := abs_aeval_vShiftZ_le hr (fun l => !q.1 l) hu
      have : |(algebraMap ℤ ℝ) ((e : ℤ) + 1)| = (e : ℝ) + 1 := by
        simp only [eq_intCast, Int.cast_add, Int.cast_natCast, Int.cast_one]
        exact abs_of_pos (by positivity)
      rw [this]
      push_cast
      nlinarith
  · -- another input, of lower degree
    have hlt := hP.deg_lt q.2 hq hi
    have hid : (initItem hr P j q).1.natDegree = (P q.2).natDegree := by
      simp only [initItem]; exact natDegree_initPoly (hP.deg_pos q.2 hq) _ _
    have hlt' : (initItem hr P j q).1.natDegree < head.natDegree := by rw [hid, hhd]; exact hlt
    have hd : (head - (initItem hr P j q).1).natDegree = (P m).natDegree := by
      rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt hlt', hhd]
    have hlc : (head - (initItem hr P j q).1).leadingCoeff = head.leadingCoeff :=
      Polynomial.leadingCoeff_sub_of_degree_lt (Polynomial.degree_lt_degree hlt')
    refine ⟨1, one_ne_zero, ?_, fun i => by simp, ?_, ?_⟩
    · rw [hd, Nat.sub_self]; exact MvPolynomial.isHomogeneous_one _ _
    · rw [hlc, hhlc]; simp
    · intro u _
      simp only [map_one, abs_one]
      have := hP.two_le
      have : (2 : ℝ) ≤ (P m).natDegree := by exact_mod_cast this
      linarith

theorem initItem_facts {hr : 4 ≤ r} {P : ℕ → Polynomial ℝ} {j : ℕ → Fin 3} {m : ℕ}
    (hP : InitDegrees P m)
    {it : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ) × List (PetFactor r 3 ℕ)}
    (hit : it ∈ initRestRaw hr P j m) :
    it.1 ≠ 0 ∧ it.1.coeff 0 = 0
      ∧ it.1 ≠ initPoly (P m) (j m) (vShift hr fun _ => true)
      ∧ it.1.natDegree ≤ (initPoly (r := r) (P m) (j m) (vShift hr fun _ => true)).natDegree := by
  obtain ⟨q, hq, hqne, rfl⟩ := mem_initRestRaw hit
  have hm1 : m ∈ Finset.Icc 1 m := Finset.mem_Icc.mpr ⟨hP.one_le, le_rfl⟩
  refine ⟨initPoly_ne_zero (hP.deg_pos q.2 hq) _ _, initPoly_coeff_zero _ _ _, ?_, ?_⟩
  · intro heq
    obtain ⟨p, hp0, -, -, hlc, -⟩ := initItem_lead (hr := hr) (j := j) hP hq hqne
    rw [← heq, sub_self, Polynomial.leadingCoeff_zero] at hlc
    have ha : -(P m).leadingCoeff ≠ 0 := by
      rw [neg_ne_zero, Ne, Polynomial.leadingCoeff_eq_zero]
      intro h0; have := hP.deg_pos m hm1; rw [h0] at this; simp at this
    exact leadVec_ne_zero ha (j m) hp0 hlc.symm
  · simp only [initItem]
    rw [natDegree_initPoly (hP.deg_pos q.2 hq), natDegree_initPoly (hP.deg_pos m hm1)]
    by_cases hi : q.2 = m
    · rw [hi]
    · exact (hP.deg_lt q.2 hq hi).le

open scoped Classical in
/-- **The initial normal state**: the protected head `-(P_m(t + Σ h) - P_m(Σ h)) e_{j m}` at the
all-ones vertex, and every other vertex and input grouped by polynomial. -/
noncomputable def initState (hr : 4 ≤ r) (P : ℕ → Polynomial ℝ) (j : ℕ → Fin 3) (m : ℕ)
    (hP : InitDegrees P m) : NormalPETState r 3 ℕ m :=
  petAssemble [] (initPoly (P m) (j m) (vShift hr fun _ => true))
    ⟨m, vertexConj (fun _ : Fin 4 => true), initTransl (P m) (j m) (vShift hr fun _ => true)⟩
    (initRestRaw hr P j m) rfl
    (initPoly_ne_zero (hP.deg_pos m (Finset.mem_Icc.mpr ⟨hP.one_le, le_rfl⟩)) _ _)
    (initPoly_coeff_zero _ _ _)
    (fun _ hit => (initItem_facts hP hit).1) (fun _ hit => (initItem_facts hP hit).2.1)
    (fun _ hit => (initItem_facts hP hit).2.2.1) (fun _ hit => (initItem_facts hP hit).2.2.2)

theorem InitDegrees.leadingCoeff_ne {P : ℕ → Polynomial ℝ} {m : ℕ} (hP : InitDegrees P m) :
    -(P m).leadingCoeff ≠ 0 := by
  rw [neg_ne_zero, Ne, Polynomial.leadingCoeff_eq_zero]
  intro h0
  have := hP.deg_pos m (Finset.mem_Icc.mpr ⟨hP.one_le, le_rfl⟩)
  rw [h0] at this; simp at this

section
variable {hr : 4 ≤ r} {P : ℕ → Polynomial ℝ} {j : ℕ → Fin 3} {m : ℕ} {hP : InitDegrees P m}

@[simp] theorem initState_spatial : (initState hr P j m hP).spatial = [] := rfl
@[simp] theorem initState_headPoly :
    (initState hr P j m hP).headPoly = initPoly (P m) (j m) (vShift hr fun _ => true) := rfl
@[simp] theorem initState_headFactor : (initState hr P j m hP).headFactor
    = ⟨m, vertexConj (fun _ : Fin 4 => true), initTransl (P m) (j m) (vShift hr fun _ => true)⟩ :=
  rfl
open scoped Classical in
theorem initState_rest : (initState hr P j m hP).rest = petGroup (initRestRaw hr P j m) := rfl

theorem initState_rest_mem {jt : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ)
    × List (PetFactor r 3 ℕ)} (hjt : jt ∈ (initState hr P j m hP).rest) :
    ∃ q : (Fin 4 → Bool) × ℕ, q.2 ∈ Finset.Icc 1 m ∧ q ≠ ((fun _ => true), m)
      ∧ jt.1 = (initItem hr P j q).1 := by
  classical
  rw [initState_rest] at hjt
  obtain ⟨it, hit, heq⟩ := List.mem_map.mp (petGroup_fst_mem hjt)
  obtain ⟨q, hq, hqne, rfl⟩ := mem_initRestRaw hit
  exact ⟨q, hq, hqne, heq.symm⟩

/-- **The run invariant holds for the initial state** (blueprint `patch:initial-shift-family`:
"`patch:lead-invariant` holds with `p_R = 1` for the head and its differences with lower-degree
inputs ... For two shifts of that input, their difference has degree `D - 1` and leading
coefficient `a D [(1 - ω)·h] e_m`"). -/
theorem initState_inv :
    PetRunInv (-(P m).leadingCoeff) (j m) (P m).natDegree 4 (initState hr P j m hP) := by
  have hm1 : m ∈ Finset.Icc 1 m := Finset.mem_Icc.mpr ⟨hP.one_le, le_rfl⟩
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · refine ⟨1, one_ne_zero, ?_, fun i => by simp, ?_⟩
    · rw [initState_headPoly, natDegree_initPoly (hP.deg_pos m hm1), Nat.sub_self]
      exact MvPolynomial.isHomogeneous_one _ _
    · rw [initState_headPoly, leadingCoeff_initPoly (hP.deg_pos m hm1)]; simp
  · intro jt hjt
    obtain ⟨q, hq, hqne, heq⟩ := initState_rest_mem hjt
    obtain ⟨p, hp0, hph, hpd, hlc, -⟩ := initItem_lead (hr := hr) (j := j) hP hq hqne
    refine ⟨p, hp0, ?_, hpd, ?_⟩
    · rw [heq]; exact hph
    · rw [heq]; exact hlc
  · exact petPolyBelow_initPoly hr _ _ _
  · intro jt hjt
    obtain ⟨q, -, -, heq⟩ := initState_rest_mem hjt
    rw [heq]; exact petPolyBelow_initPoly hr _ _ _
  · rw [initState_headPoly, natDegree_initPoly (hP.deg_pos m hm1)]

/-- **The witness bounds hold for the initial state**, with bound `4 D`. -/
theorem initState_bd :
    PetRunBd (-(P m).leadingCoeff) (j m) (4 * (P m).natDegree) (initState hr P j m hP) := by
  have hm1 : m ∈ Finset.Icc 1 m := Finset.mem_Icc.mpr ⟨hP.one_le, le_rfl⟩
  have ha := hP.leadingCoeff_ne
  refine ⟨?_, ?_⟩
  · refine PetWitBd.of_eq ha (w := 1) ?_ ?_
    · rw [initState_headPoly, leadingCoeff_initPoly (hP.deg_pos m hm1)]; simp
    · refine evalBd_one.mono ?_
      have := hP.two_le
      have : (2 : ℝ) ≤ (P m).natDegree := by exact_mod_cast this
      linarith
  · intro jt hjt
    obtain ⟨q, hq, hqne, heq⟩ := initState_rest_mem hjt
    obtain ⟨p, -, -, -, hlc, hbd⟩ := initItem_lead (hr := hr) (j := j) hP hq hqne
    rw [heq]
    exact PetWitBd.of_eq ha hlc hbd

/-- The initial translation records use only the four phase variables. -/
theorem initState_facsBelow : PetFacsBelow 4 (initState hr P j m hP) := by
  classical
  refine ⟨fun F hF => by simp at hF, ?_⟩
  intro it hit F hF
  rw [petAllItems, List.mem_cons] at hit
  rcases hit with rfl | hit
  · simp only [initState_headFactor, List.mem_singleton] at hF
    subst hF
    exact fun k => initTransl_mem hr _ _ _ k
  · rw [initState_rest, petGroup, List.mem_map] at hit
    obtain ⟨k, -, rfl⟩ := hit
    simp only [List.mem_flatMap, List.mem_filter] at hF
    obtain ⟨it', ⟨hit', -⟩, hF⟩ := hF
    obtain ⟨q, -, -, rfl⟩ := mem_initRestRaw hit'
    simp only [initItem, List.mem_singleton] at hF
    subst hF
    exact fun k => initTransl_mem hr _ _ _ k

end

end

section
open Filter Topology MeasureTheory

variable {r : ℕ}

theorem abs_eval_vShift_le (hr : 4 ≤ r) (ω : Fin 4 → Bool) {H : ℝ} (hH : 0 ≤ H)
    {η : Fin r → ℝ} (hη : ∀ v, |η v| ≤ H) : |MvPolynomial.eval η (vShift hr ω)| ≤ 4 * H := by
  simp only [vShift, vShiftZ, map_sum]
  calc |∑ l : Fin 4, MvPolynomial.eval η (MvPolynomial.map (Int.castRingHom ℝ)
        (if ω l then MvPolynomial.X ⟨3 - l.val, by omega⟩ else 0))|
      ≤ ∑ l : Fin 4, |MvPolynomial.eval η (MvPolynomial.map (Int.castRingHom ℝ)
        (if ω l then MvPolynomial.X ⟨3 - l.val, by omega⟩ else 0))| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _l : Fin 4, H := Finset.sum_le_sum fun l _ => by
        split_ifs
        · simp only [MvPolynomial.map_X, MvPolynomial.eval_X]; exact hη _
        · simpa using hH
    _ = 4 * H := by simp

theorem abs_cubeShift_le {H : ℝ} (hH : 0 ≤ H) {h : Fin 4 → ℝ} (hh : ∀ l, |h l| ≤ H)
    (ω : Fin 4 → Bool) : |cubeShift h ω| ≤ 4 * H := by
  rw [cubeShift]
  calc |∑ i, if ω i then h i else 0| ≤ ∑ i, |if ω i then h i else 0| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _i : Fin 4, H := Finset.sum_le_sum fun i _ => by
        split_ifs
        · exact hh i
        · simpa using hH
    _ = 4 * H := by simp

/-- **The support envelope of the initial state.** -/
theorem initState_env {hr : 4 ≤ r} {P : ℕ → Polynomial ℝ} {j : ℕ → Fin 3} {m : ℕ}
    {hP : InitDegrees P m} {N H R M : ℝ} (hN : 0 ≤ N) (hH : 0 ≤ H) (hM : 0 ≤ M)
    (hPb : ∀ i ∈ Finset.Icc 1 m, ∀ x, |x| ≤ R + 4 * H → |(P i).eval x| ≤ M / 2 * N ^ expo (j i)) :
    PetStateEnv N H R M (initState hr P j m hP) := by
  have hitem : ∀ q : (Fin 4 → Bool) × ℕ, q.2 ∈ Finset.Icc 1 m →
      PetEnv N H R M (initPoly (P q.2) (j q.2) (vShift hr q.1)) := by
    intro q hq η hη t ht k
    rw [petEvalPoly_initPoly]
    have hs := abs_eval_vShift_le hr q.1 hH hη
    simp only [PiLp.neg_apply, PiLp.smul_apply, smul_eq_mul, basisVec, abs_neg]
    by_cases hk : k = j q.2
    · subst hk
      simp only [PiLp.single_apply, ite_true, mul_one]
      have h1 := hPb q.2 hq (t + MvPolynomial.eval η (vShift hr q.1))
        (by calc |t + _| ≤ |t| + |_| := abs_add_le _ _
              _ ≤ R + 4 * H := add_le_add ht hs)
      have h2 := hPb q.2 hq (MvPolynomial.eval η (vShift hr q.1))
        (by have := abs_nonneg t; linarith)
      calc |_ - _| ≤ |(P q.2).eval (t + MvPolynomial.eval η (vShift hr q.1))|
            + |(P q.2).eval (MvPolynomial.eval η (vShift hr q.1))| := abs_sub _ _
        _ ≤ M / 2 * N ^ expo (j q.2) + M / 2 * N ^ expo (j q.2) := add_le_add h1 h2
        _ = M * N ^ expo (j q.2) := by ring
    · simp only [PiLp.single_apply, hk, ite_false, mul_zero, abs_zero]
      positivity
  intro it hit
  rw [petAllItems, List.mem_cons] at hit
  rcases hit with rfl | hit
  · exact hitem ((fun _ => true), m) (Finset.mem_Icc.mpr ⟨hP.one_le, le_rfl⟩)
  · obtain ⟨q, hq, -, heq⟩ := initState_rest_mem hit
    rw [heq]
    exact hitem q hq

theorem conjPar_prod {α : Type*} (n : ℕ) (s : Finset α) (z : α → ℂ) :
    conjPar n (∏ a ∈ s, z a) = ∏ a ∈ s, conjPar n (z a) := by
  by_cases h : Even n
  · simp [conjPar, h]
  · simp [conjPar, h, map_prod]

/-- The value of an evaluated initial item: the input at the vertex-shifted polynomial,
conjugated by the vertex parity. -/
theorem initItem_value (hr : 4 ≤ r) (P : ℕ → Polynomial ℝ) (j : ℕ → Fin 3) (f : ℕ → E3 → ℂ)
    (q : (Fin 4 → Bool) × ℕ) (h : Fin 4 → ℝ) (x : E3) (t : ℝ) :
    (petEvalItem f (petShiftVec 4 h) false (initItem hr P j q)).1
        (x + (petEvalItem f (petShiftVec 4 h) false (initItem hr P j q)).2 t)
      = conjPar (numFalse q.1)
          (f q.2 (x - ((P q.2).eval (t + cubeShift h q.1)) • basisVec (j q.2))) := by
  simp only [petEvalItem, initItem, petBlockFun, List.map_cons, List.map_nil, List.prod_cons,
    List.prod_nil, mul_one, petFacFun, Bool.false_xor, condConj_vertexConj]
  congr 2
  rw [petEvalPoly_initPoly, petEvalVec_initTransl, eval_vShift, sub_smul]
  abel

open scoped Classical in
/-- **The evaluated initial state is the four-step cube of the bare inputs.** -/
theorem vecProd_initState {hr : 4 ≤ r} {P : ℕ → Polynomial ℝ} {j : ℕ → Fin 3} {m : ℕ}
    {hP : InitDegrees P m} (f : ℕ → E3 → ℂ) (h : Fin 4 → ℝ) (x : E3) (t : ℝ) :
    vecProd (petEvalFam f (petShiftVec 4 h) false (initState hr P j m hP)) x t
      = ∏ ω : Fin 4 → Bool, conjPar (numFalse ω)
          (∏ i ∈ Finset.Icc 1 m, f i (x - ((P i).eval (t + cubeShift h ω)) • basisVec (j i))) := by
  have hm1 : m ∈ Finset.Icc 1 m := Finset.mem_Icc.mpr ⟨hP.one_le, le_rfl⟩
  set w : (Fin 4 → Bool) × ℕ → ℂ := fun q => conjPar (numFalse q.1)
    (f q.2 (x - ((P q.2).eval (t + cubeShift h q.1)) • basisVec (j q.2))) with hw
  have hfam : petEvalFam f (petShiftVec 4 h) false (initState hr P j m hP)
      = petEvalItem f (petShiftVec 4 h) false (initItem hr P j ((fun _ => true), m))
        :: (initState hr P j m hP).rest.map (petEvalItem f (petShiftVec 4 h) false) := by
    simp [petEvalFam, petAllItems, initItem]
  rw [hfam, vecProd_cons, initState_rest, vecProd_petGroup, initItem_value]
  have hraw : (((initRestRaw hr P j m).map (petEvalItem f (petShiftVec 4 h) false)).map
      fun b => b.1 (x + b.2 t)).prod = ∏ q ∈ initIndex m, w q := by
    rw [initRestRaw, List.map_map, List.map_map, ← Finset.prod_map_toList]
    congr 1
    refine List.map_congr_left fun q _ => ?_
    simp only [Function.comp]
    exact initItem_value hr P j f q h x t
  rw [hraw]
  have hall : w ((fun _ => true), m) * ∏ q ∈ initIndex m, w q
      = ∏ q ∈ Finset.univ ×ˢ Finset.Icc 1 m, w q := by
    rw [initIndex]
    exact Finset.mul_prod_erase _ _ (Finset.mem_product.mpr ⟨Finset.mem_univ _, hm1⟩)
  rw [show conjPar (numFalse (fun _ : Fin 4 => true))
      (f m (x - ((P m).eval (t + cubeShift h fun _ => true)) • basisVec (j m)))
      = w ((fun _ => true), m) from rfl, hall, Finset.prod_product]
  refine Finset.prod_congr rfl fun ω _ => ?_
  rw [conjPar_prod]

open scoped Classical in
/-- **Level four of the chain in both forms**: after the four phase steps the phase cube against
the enlarged box is the evaluated initial PET state against its translated box. -/
theorem phaseLevel_four_eq_petLevel {hr : 4 ≤ r} {P : ℕ → Polynomial ℝ} {j : ℕ → Fin 3} {m : ℕ}
    {hP : InitDegrees P m} {f : ℕ → E3 → ℂ} {p : E3 → Polynomial ℝ} {C Cs Kb N H : ℝ}
    (hN1 : 1 ≤ N) (hH : 0 ≤ H) (hK : 0 ≤ Kb) (hCs : C + Kb ≤ Cs)
    (hsupp : ∀ y, y ∉ petBox C N → f m y = 0) (hp3 : ∀ x, (p x).natDegree ≤ 3)
    (hK1 : ∀ t ∈ Set.Icc (0 : ℝ) N, |(P m).eval t| ≤ Kb * N ^ expo (j m))
    (hK2 : ∀ t ∈ Set.Icc (0 : ℝ) N, ∀ c, |c| ≤ 4 * H →
      |(P m).eval (t + c) - (P m).eval c| ≤ Kb * N ^ expo (j m))
    (V : ℝ) {h : Fin 4 → ℝ} (hh : ∀ l, |h l| ≤ H) :
    phaseLevel V N C (boxInd Cs N) 4 m f P p j h
      = petLevel V N Cs f false (initState hr P j m hP) (petShiftVec 4 h) := by
  have hN0 : (0 : ℝ) ≤ N := by linarith
  have hm1 : m ∈ Finset.Icc 1 m := Finset.mem_Icc.mpr ⟨hP.one_le, le_rfl⟩
  have key : ∀ x, ∀ t ∈ Set.uIcc (0 : ℝ) (0 + N),
      boxInd Cs N x * (vecProd [phaseHead C N (P m) (j m)] x t
        * phaseProdIter 4 m f P p j x h t)
      = petSpatialFun N Cs f (petShiftVec 4 h) false (initState hr P j m hP) x
        * (vecProd (petEvalFam f (petShiftVec 4 h) false (initState hr P j m hP)) x t * 1) := by
    intro x t ht
    rw [zero_add, Set.uIcc_of_le hN0] at ht
    rw [vecProd_phaseHead_mul hP.one_le hsupp, phaseProdIter_four_eq m f P p j x (hp3 x),
      vecProd_initState, mul_one, petSpatialFun, initState_spatial, initState_headFactor]
    simp only [petBlockFun, List.map_nil, List.prod_nil, mul_one]
    set cube := ∏ ω : Fin 4 → Bool, conjPar (numFalse ω)
      (∏ i ∈ Finset.Icc 1 m, f i (x - ((P i).eval (t + cubeShift h ω)) • basisVec (j i)))
    by_cases hz : cube = 0
    · rw [hz, mul_zero, mul_zero]
    · have hv : ∀ ω : Fin 4 → Bool,
          f m (x - ((P m).eval (t + cubeShift h ω)) • basisVec (j m)) ≠ 0 := by
        intro ω h0
        refine hz (Finset.prod_eq_zero (Finset.mem_univ ω) ?_)
        rw [Finset.prod_eq_zero hm1 h0]
        by_cases he : Even (numFalse ω) <;> simp [conjPar, he]
      have hmem : ∀ ω : Fin 4 → Bool,
          x - ((P m).eval (t + cubeShift h ω)) • basisVec (j m) ∈ petBox C N :=
        fun ω => by_contra fun hn => hv ω (hsupp _ hn)
      have h1 : boxInd Cs N x = 1 := by
        have := hmem fun _ => false
        rw [cubeShift_const_false, add_zero] at this
        exact Set.indicator_of_mem (petBox_mono hCs hN0
          (mem_petBox_of_sub_mem_scaled hK hN0 (hK1 t ht) this)) _
      have h2 : boxInd Cs N (x + petEvalVec (petShiftVec 4 h)
          (initTransl (P m) (j m) (vShift hr fun _ => true))) = 1 := by
        rw [petEvalVec_initTransl, eval_vShift, ← sub_eq_add_neg]
        set c := cubeShift h fun _ => true
        have hc : |c| ≤ 4 * H := abs_cubeShift_le hH hh _
        have hmc := hmem fun _ => true
        have heq : x - ((P m).eval (t + c)) • basisVec (j m)
            = (x - ((P m).eval c) • basisVec (j m))
              - ((P m).eval (t + c) - (P m).eval c) • basisVec (j m) := by
          rw [sub_smul]; abel
        rw [heq] at hmc
        exact Set.indicator_of_mem (petBox_mono hCs hN0
          (mem_petBox_of_sub_mem_scaled hK hN0 (hK2 t ht c hc) hmc)) _
      rw [h1, h2]
  rw [phaseLevel, petLevel, vecAmp, vecAmp]
  congr 1
  refine integral_congr_ae (.of_forall fun x => ?_)
  simp only
  rw [mul_smul_comm, mul_smul_comm, ← intervalIntegral.integral_const_mul,
    ← intervalIntegral.integral_const_mul]
  congr 1
  exact intervalIntegral.integral_congr (key x)

end

section
open Filter Topology MeasureTheory

variable {r : ℕ} {ι : Type*} {f : ι}

/-! ### The PET levels of the chain

Blueprint `patch:cs-loss` along the run of `patch:pet-producer`: the `k`-th state of the run,
evaluated at the first `s₀ + k` shifts, with the conjugation flag of parity `k`, is level `s₀ + k`
of the chain, and consecutive levels satisfy the Cauchy--Schwarz recursion. -/
theorem abs_petShiftVec_le' {H : ℝ} (hH : 0 < H) {k : ℕ} {h : Fin k → ℝ}
    (hh : h ∈ fejerBox H k) (v : Fin r) : |petShiftVec k h v| ≤ H :=
  abs_petShiftVec_le hH.le hh v

/-- **The Cauchy--Schwarz recursion between consecutive PET levels of the run.** -/
theorem petRun_level_step {a : ℝ} (ha : a ≠ 0) {m : Fin 3} {D s0 : ℕ} (hD3 : D ≤ 3) {B0 : ℝ}
    (hB0 : 0 ≤ B0) (S0 : NormalPETState r 3 ι f) (hinv0 : PetRunInv a m D s0 S0)
    (hbd0 : PetRunBd a m B0 S0) (hFB0 : PetFacsBelow s0 S0)
    {N H C Cs M0 R0 : ℝ} (hN1 : 1 ≤ N) (hH : 0 < H) (hHN : H ≤ N / 4) (hC : 0 < C)
    (hCCs : C ≤ Cs) (hM0 : 0 ≤ M0) (hEnv0 : PetStateEnv N H R0 M0 S0)
    {G : ι → E3 → ℂ} (hG : ∀ i, Measurable (G i)) (hG1 : ∀ i y, ‖G i y‖ ≤ 1)
    (hGf : ∀ y, y ∉ petBox C N → G f y = 0)
    {k : ℕ} (hmove : 2 ≤ (petRunSeq ha hD3 hB0 S0 hinv0 hbd0 k).1.headPoly.natDegree)
    (hkr : s0 + k < r) (hR : N ≤ R0 - (k + 1 : ℕ) * H) (hCM : C + 4 ^ (k + 1) * M0 ≤ Cs)
    {h : Fin (s0 + k) → ℝ} (hh : h ∈ fejerBox H (s0 + k)) :
    ‖petLevel (volume (petBox Cs N)).toReal N Cs G (Nat.bodd k)
        (petRunSeq ha hD3 hB0 S0 hinv0 hbd0 k).1 (petShiftVec (s0 + k) h)‖ ^ 2
      ≤ 2 * (∫ u : ℝ, fejer H u * ‖petLevel (volume (petBox Cs N)).toReal N Cs G
          (Nat.bodd (k + 1)) (petRunSeq ha hD3 hB0 S0 hinv0 hbd0 (k + 1)).1
          (petShiftVec (s0 + k + 1) (Fin.cons u h))‖) + 2 * H / N := by
  classical
  set x := petRunSeq ha hD3 hB0 S0 hinv0 hbd0 k with hx
  have hN0 : (0 : ℝ) ≤ N := by linarith
  obtain ⟨Qp, hQp, hsp, hhp, hhf, hrest, -⟩ := petRunMove_spec ha hD3 hB0 k x ⟨hmove, hkr⟩
  have hFB := petRunSeq_facsBelow ha hD3 hB0 S0 hinv0 hbd0 hFB0 k
  have hB := x.2.1.itemsBelow
  have hEnv := petRunSeq_env ha hD3 hB0 S0 hinv0 hbd0 hN0 hH.le hM0 hEnv0 (k + 1)
  have hEnv' : PetStateEnv N H N (4 ^ (k + 1) * M0)
      (petRunSeq ha hD3 hB0 S0 hinv0 hbd0 (k + 1)).1 := fun it hit =>
    (hEnv it hit).mono hN0 hR le_rfl
  rw [petRunSeq_succ] at hEnv'
  have key := petLevel_step hN1 hH hHN hC hCM hCCs hG hG1 hGf (Nat.bodd k) hFB hB
    (iu := ⟨s0 + k, hkr⟩) rfl hQp hsp hhp hhf hrest hEnv'
    (η := petShiftVec (s0 + k) h) (fun v => abs_petShiftVec_le' hH hh v)
  rw [Nat.bodd_succ, petRunSeq_succ]
  simp_rw [petShiftVec_cons hkr]
  exact key

end

section
open Filter Topology MeasureTheory

variable {r n : ℕ} {ι : Type*} {f : ι}

/-! ### Every block of the run is nonempty

"Normalization groups function lists; it does not discard duplicate factors": the head block is a
singleton and every other block collects at least one factor, so each block function is dominated
by a translated input and has bounded support. -/

/-- Every nuisance block of the state is nonempty. -/
def PetBlocksNonempty (S : NormalPETState r n ι f) : Prop := ∀ it ∈ S.rest, it.2 ≠ []

theorem petGroup_nonempty [DecidableEq (Polynomial (Fin n → MvPolynomial (Fin r) ℝ))]
    {l : List (Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι))}
    (hl : ∀ it ∈ l, it.2 ≠ []) : ∀ g ∈ petGroup l, g.2 ≠ [] := by
  intro g hg
  rw [petGroup, List.mem_map] at hg
  obtain ⟨k, hk, rfl⟩ := hg
  obtain ⟨it, hit, rfl⟩ := List.mem_map.mp (List.mem_dedup.mp hk)
  intro hnil
  rw [List.flatMap_eq_nil_iff] at hnil
  exact hl it hit (hnil it (List.mem_filter.mpr ⟨hit, by simp⟩))

theorem petNormalized_nonempty {S : NormalPETState r n ι f} (hS : PetBlocksNonempty S)
    (u : Fin n → MvPolynomial (Fin r) ℝ) (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)) :
    ∀ it ∈ petNormalized u Qp S, it.2 ≠ [] := by
  intro it hit
  rw [petNormalized, List.mem_map] at hit
  obtain ⟨ch, hch, rfl⟩ := hit
  rw [petRawChildren, List.mem_flatMap] at hch
  obtain ⟨old, hold, hch⟩ := hch
  have hold' : old.2 ≠ [] := by
    rw [petAllItems, List.mem_cons] at hold
    rcases hold with rfl | hold
    · simp
    · exact hS old hold
  simp only [petChildren, List.mem_cons, List.not_mem_nil, or_false] at hch
  rcases hch with rfl | rfl <;> simpa [petNormalizeItem] using hold'

open scoped Classical in
theorem petBlocksNonempty_update [DecidableEq (Polynomial (Fin n → MvPolynomial (Fin r) ℝ))]
    {S : NormalPETState r n ι f} (hS : PetBlocksNonempty S) {iu : Fin r}
    {Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)} {S' : NormalPETState r n ι f}
    (hrest : S'.rest = petGroup (petNonConstChildren (fun _ => MvPolynomial.X iu) Qp S)) :
    PetBlocksNonempty S' := by
  intro it hit
  rw [hrest] at hit
  refine petGroup_nonempty (fun it' hit' => ?_) it hit
  rw [petNonConstChildren, List.mem_filter] at hit'
  exact petNormalized_nonempty hS _ _ it' (List.mem_of_mem_tail hit'.1)

theorem petRunSeq_nonempty {a : ℝ} (ha : a ≠ 0) {m : Fin n} {D s0 : ℕ} (hD3 : D ≤ 3) {B0 : ℝ}
    (hB0 : 0 ≤ B0) (S0 : NormalPETState r n ι f) (hinv0 : PetRunInv a m D s0 S0)
    (hbd0 : PetRunBd a m B0 S0) (h0 : PetBlocksNonempty S0) :
    ∀ k, PetBlocksNonempty (petRunSeq ha hD3 hB0 S0 hinv0 hbd0 k).1 := by
  classical
  intro k
  induction k with
  | zero => exact h0
  | succ k ih =>
    rw [petRunSeq_succ]
    set x := petRunSeq ha hD3 hB0 S0 hinv0 hbd0 k with hx
    by_cases hmv : 2 ≤ x.1.headPoly.natDegree ∧ s0 + k < r
    · obtain ⟨Qp, -, -, -, -, hrest, -⟩ := petRunMove_spec ha hD3 hB0 k x hmv
      exact petBlocksNonempty_update ih hrest
    · rw [petRunMove_neg ha hD3 hB0 k x hmv]
      exact ih

theorem initState_nonempty {hr : 4 ≤ r} {P : ℕ → Polynomial ℝ} {j : ℕ → Fin 3} {m : ℕ}
    {hP : InitDegrees P m} : PetBlocksNonempty (initState hr P j m hP) := by
  classical
  intro it hit
  rw [initState_rest] at hit
  refine petGroup_nonempty (fun it' hit' => ?_) it hit
  obtain ⟨q, -, -, rfl⟩ := mem_initRestRaw hit'
  simp [initItem]

/-- **A nonempty block vanishes off a translate of the input box.** -/
theorem petBlockFun_eq_zero_of_notMem {G : ι → E3 → ℂ} {C N : ℝ}
    (hGs : ∀ i y, y ∉ petBox C N → G i y = 0) (η : Fin r → ℝ) (c : Bool)
    {F : PetFactor r 3 ι} {l : List (PetFactor r 3 ι)} {y : E3}
    (hy : y + petEvalVec η F.transl ∉ petBox C N) : petBlockFun G η c (F :: l) y = 0 := by
  simp only [petBlockFun, List.map_cons, List.prod_cons, petFacFun, hGs _ _ hy]
  cases xor c F.isConj <;> simp

end

section
open Filter Topology MeasureTheory

/-- **The step between consecutive levels, keeping the signed average** (the last step of
`patch:cs-loss`: "The last signed average is essential"): as `Auto.vecAmp_step`, with the real part
of the next level in place of its modulus. -/
theorem vecAmp_step_re {N H V : ℝ} (hN : 0 < N) (hH : 0 < H) (hHN : H ≤ N / 4) (hV : 0 < V)
    {b : (E3 → ℂ) × (ℝ → E3)} {L : PetFam}
    (hL : ∀ b' ∈ b :: L, Measurable b'.1 ∧ Continuous b'.2)
    (hL1 : ∀ b' ∈ b :: L, ∀ y, ‖b'.1 y‖ ≤ 1)
    {φ : E3 → ℝ → ℂ} (hφm : Measurable (Function.uncurry φ)) (hφ1 : ∀ x t, ‖φ x t‖ ≤ 1)
    {K : Set E3} (hKm : MeasurableSet K) (hKb : Bornology.IsBounded K)
    (hb : ∀ y, y ∉ K → b.1 y = 0) (hKV : (volume K).toReal ≤ V)
    {g : E3 → ℂ} (hgm : Measurable g) (hg1 : ∀ x, ‖g x‖ ≤ 1) {Rg : ℝ}
    (hgR : ∀ x, Rg < ‖x‖ → g x = 0) (hgV : (∫ x, ‖g x‖ ^ 2) ≤ V)
    {Qp : ℝ → E3} (hQp : Continuous Qp)
    {g' : ℝ → E3 → ℂ} {L' : ℝ → PetFam} {φ' : ℝ → E3 → ℝ → ℂ}
    (hid : ∀ u, |u| ≤ H → ∀ t ∈ Set.Icc (0 : ℝ) N, ∀ x,
      vecProd (vecChildren (b :: L) Qp u) x t * phaseChild φ Qp u x t
        = g' u x * (vecProd (L' u) x t * φ' u x t))
    (hAm : Measurable fun u => vecAmp V N (g' u) (L' u) (φ' u))
    (hA1 : ∀ u, |u| ≤ H → ‖vecAmp V N (g' u) (L' u) (φ' u)‖ ≤ 1) :
    ‖vecAmp V N g (b :: L) φ‖ ^ 2
      ≤ 2 * (∫ u : ℝ, fejer H u * (vecAmp V N (g' u) (L' u) (φ' u)).re) + 2 * H / N := by
  have key := vecStep_phase (c := 0) hN hH hHN hV hL hL1 hφm hφ1 hKm hKb hb hKV hgm hg1 hgR
    hgV Qp
  set Z : ℝ → ℂ := fun u => ∫ t in (0 : ℝ)..(0 + N), ∫ x,
    vecProd (vecChildren (b :: L) Qp u) x t * phaseChild φ Qp u x t with hZ
  set A' : ℝ → ℂ := fun u => vecAmp V N (g' u) (L' u) (φ' u) with hA'
  have hA'def : ∀ u, A' u = vecAmp V N (g' u) (L' u) (φ' u) := fun u => rfl
  have hVN : V * N * (V⁻¹ * N⁻¹) = 1 := by field_simp
  have hZA : ∀ u, fejer H u • Z u = fejer H u • ((V * N : ℝ) • A' u) := by
    intro u
    by_cases hu : |u| ≤ H
    · have heq := integral_children_eq_vecAmp (V := V) hN hL hL1 hφm hφ1 hKb hb hQp u
        (hid u hu)
      rw [hA'def, ← heq, smul_smul (V * N), hVN, one_smul]
    · rw [fejer_eq_zero_of_le hH (le_of_lt (not_le.mp hu)), zero_smul, zero_smul]
  have hbd : ∀ u, ‖fejer H u • ((V * N : ℝ) • A' u)‖ ≤ fejer H u * (V * N) := by
    intro u
    by_cases hu : |u| ≤ H
    · rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs,
        abs_of_nonneg (fejer_nonneg hH u), abs_of_nonneg (by positivity)]
      exact mul_le_mul_of_nonneg_left (mul_le_of_le_one_right (by positivity) (hA1 u hu))
        (fejer_nonneg hH u)
    · rw [fejer_eq_zero_of_le hH (le_of_lt (not_le.mp hu))]; simp
  have hAm' : Measurable A' := hAm
  have hm : Measurable fun u => fejer H u • ((V * N : ℝ) • A' u) :=
    Measurable.smul continuous_fejer.measurable (Measurable.const_smul hAm' (V * N : ℝ))
  have hint : Integrable fun u => fejer H u • ((V * N : ℝ) • A' u) :=
    Integrable.mono' ((integrable_fejer hH).mul_const (V * N)) hm.aestronglyMeasurable
      (.of_forall hbd)
  have hre : (∫ u : ℝ, fejer H u • Z u).re = ∫ u : ℝ, fejer H u * ((V * N) * (A' u).re) := by
    rw [integral_congr_ae (.of_forall hZA), ← integral_re_of_integrable hint]
    congr 1
    funext u
    simp
  have hbound : V⁻¹ * N⁻¹ * (∫ u : ℝ, fejer H u • Z u).re = ∫ u : ℝ, fejer H u * (A' u).re := by
    rw [hre, ← integral_const_mul]
    congr 1
    funext u
    calc V⁻¹ * N⁻¹ * (fejer H u * (V * N * (A' u).re))
        = (V * N * (V⁻¹ * N⁻¹)) * (fejer H u * (A' u).re) := by ring
      _ = fejer H u * (A' u).re := by rw [hVN, one_mul]
  have hL0 : vecAmp V N g (b :: L) φ = (V⁻¹ : ℝ) • ∫ x, g x * ((N⁻¹ : ℝ) •
      ∫ t in (0 : ℝ)..(0 + N), vecProd (b :: L) x t * φ x t) := rfl
  rw [hL0]
  linarith [key, hbound]

/-! ### The affine removal as levels of the chain

Blueprint `patch:affine-block` and `patch:affine-cube-invariant`: at the linear state the blocks
`g_0, ..., g_s` (the spatial block first, the protected input last) have slopes `b_i` along `e_m`.
At level `r` the block `i ≥ r` has become the cube `G_{i,r}`, an iterated Fejer difference with
increments `(b_i - b_ν) w_ν`; the block `r` is independent of `t` after translating by
`-b_r t e_m` and is the spatial block removed by the next step. -/

/-- The block `G_{i,r}(w)`: the newest increment `w 0` is that of step `r - 1`. -/
noncomputable def affG (em : E3) (b : ℕ → ℝ) (g : ℕ → E3 → ℂ) (i r : ℕ) (w : Fin r → ℝ) :
    E3 → ℂ :=
  fdiffIter em r (fun ν => (b i - b (r - 1 - ν.val)) * w ν) (g i)

/-- The family at level `r`: the blocks `r < i ≤ s` along their relative slopes. -/
noncomputable def affFam (em : E3) (b : ℕ → ℝ) (g : ℕ → E3 → ℂ) (s r : ℕ) (w : Fin r → ℝ) :
    PetFam :=
  (List.range' (r + 1) (s - r)).map fun i => (affG em b g i r w, fun t => ((b i - b r) * t) • em)

/-- The level-`r` quantity of the affine removal. -/
noncomputable def affAmp (V N : ℝ) (em : E3) (b : ℕ → ℝ) (g : ℕ → E3 → ℂ) (s r : ℕ)
    (w : Fin r → ℝ) : ℂ :=
  vecAmp V N (affG em b g r r w) (affFam em b g s r w) fun _ _ => 1

/-- **The cube recursion** `G_{i,r+1}(u, w) = Δ_{(b_i - b_r) u} G_{i,r}(w)`. -/
theorem affG_succ (em : E3) (b : ℕ → ℝ) (g : ℕ → E3 → ℂ) (i r : ℕ) (u : ℝ) (w : Fin r → ℝ)
    (y : E3) :
    affG em b g i (r + 1) (Fin.cons u w) y
      = affG em b g i r w (y + ((b i - b r) * u) • em) * conj (affG em b g i r w y) := by
  rw [affG, affG, fdiffIter_succ, fdiff]
  have ht : (fun ν : Fin r => (b i - b (r + 1 - 1 - (ν.succ : Fin (r + 1)).val))
      * (Fin.cons u w : Fin (r + 1) → ℝ) ν.succ) = fun ν => (b i - b (r - 1 - ν.val)) * w ν := by
    funext ν
    simp only [Fin.cons_succ, Fin.val_succ]
    congr 3
    omega
  rw [ht]
  simp only [Fin.cons_zero, Fin.val_zero, Nat.add_sub_cancel, Nat.sub_zero]

theorem measurable_fdiffIter_param {Θ : Type*} [MeasurableSpace Θ] (v : E3) :
    ∀ (s : ℕ) {g : Θ → E3 → ℂ}, Measurable (fun q : Θ × E3 => g q.1 q.2) →
      Measurable fun q : Θ × (Fin s → ℝ) × E3 => fdiffIter v s q.2.1 (g q.1) q.2.2
  | 0, g, hg => by
      simp only [fdiffIter_zero]
      exact hg.comp (measurable_fst.prodMk (measurable_snd.comp measurable_snd))
  | (s + 1), g, hg => by
      have ih := measurable_fdiffIter_param v s hg
      have htail : Measurable fun q : Θ × (Fin (s + 1) → ℝ) × E3 =>
          (fun i : Fin s => q.2.1 i.succ) :=
        Measurable.of_eval fun i => (measurable_pi_apply i.succ).comp
          (measurable_fst.comp measurable_snd)
      have h0 : Measurable fun q : Θ × (Fin (s + 1) → ℝ) × E3 => q.2.1 0 :=
        (measurable_pi_apply 0).comp (measurable_fst.comp measurable_snd)
      have hA : Measurable fun q : Θ × (Fin (s + 1) → ℝ) × E3 =>
          fdiffIter v s (fun i => q.2.1 i.succ) (g q.1) (q.2.2 + q.2.1 0 • v) :=
        ih.comp (measurable_fst.prodMk (htail.prodMk
          ((measurable_snd.comp measurable_snd).add (h0.smul_const v))))
      have hB : Measurable fun q : Θ × (Fin (s + 1) → ℝ) × E3 =>
          fdiffIter v s (fun i => q.2.1 i.succ) (g q.1) q.2.2 :=
        ih.comp (measurable_fst.prodMk (htail.prodMk (measurable_snd.comp measurable_snd)))
      have : (fun q : Θ × (Fin (s + 1) → ℝ) × E3 => fdiffIter v (s + 1) q.2.1 (g q.1) q.2.2)
          = fun q => fdiffIter v s (fun i => q.2.1 i.succ) (g q.1) (q.2.2 + q.2.1 0 • v)
            * conj (fdiffIter v s (fun i => q.2.1 i.succ) (g q.1) q.2.2) := by
        funext q; rw [fdiffIter_succ, fdiff]
      rw [this]
      exact hA.mul (Complex.continuous_conj.measurable.comp hB)

theorem measurable_affG_joint (em : E3) (b : ℕ → ℝ) {g : ℕ → E3 → ℂ} (hgm : ∀ i, Measurable (g i))
    (i r : ℕ) : Measurable fun q : (Fin r → ℝ) × E3 => affG em b g i r q.1 q.2 := by
  have h := measurable_fdiffIter_param (Θ := Unit) em r (g := fun _ => g i)
    ((hgm i).comp measurable_snd)
  have hκ : Measurable fun q : (Fin r → ℝ) × E3 =>
      (((), (fun ν : Fin r => (b i - b (r - 1 - ν.val)) * q.1 ν), q.2) :
        Unit × (Fin r → ℝ) × E3) :=
    measurable_const.prodMk ((Measurable.of_eval fun ν =>
      ((measurable_pi_apply ν).comp measurable_fst).const_mul _).prodMk measurable_snd)
  exact h.comp hκ

theorem measurable_affG (em : E3) (b : ℕ → ℝ) {g : ℕ → E3 → ℂ} (hgm : ∀ i, Measurable (g i))
    (i r : ℕ) (w : Fin r → ℝ) : Measurable (affG em b g i r w) :=
  (measurable_affG_joint em b hgm i r).comp (measurable_const.prodMk measurable_id)

theorem norm_affG_le (em : E3) (b : ℕ → ℝ) {g : ℕ → E3 → ℂ} (hg1 : ∀ i y, ‖g i y‖ ≤ 1)
    (i r : ℕ) (w : Fin r → ℝ) (y : E3) : ‖affG em b g i r w y‖ ≤ 1 :=
  norm_fdiffIter_le em r _ (hg1 i) y

theorem affG_eq_zero (em : E3) (b : ℕ → ℝ) {g : ℕ → E3 → ℂ} (hg1 : ∀ i y, ‖g i y‖ ≤ 1)
    (i r : ℕ) (w : Fin r → ℝ) {y : E3} (hy : g i y = 0) : affG em b g i r w y = 0 := by
  have := norm_fdiffIter_le_self em r (fun ν => (b i - b (r - 1 - ν.val)) * w ν) (hg1 i) y
  rw [hy, norm_zero] at this
  exact norm_le_zero_iff.mp this

/-- A block vanishing off a bounded set of volume at most `V`: the facts a spatial block of a level
needs. -/
theorem block_facts_of_support {B : E3 → ℂ} (hBm : Measurable B) (hB1 : ∀ y, ‖B y‖ ≤ 1)
    {K : Set E3} (hKm : MeasurableSet K) (hKb : Bornology.IsBounded K) {V : ℝ}
    (hKV : (volume K).toReal ≤ V) (hB : ∀ y, y ∉ K → B y = 0) :
    (∃ R, ∀ x, R < ‖x‖ → B x = 0) ∧ Integrable B ∧ (∫ x, ‖B x‖) ≤ V
      ∧ (∫ x, ‖B x‖ ^ 2) ≤ V := by
  obtain ⟨R₀, hR₀⟩ := hKb.subset_closedBall (0 : E3)
  have hz : ∀ x, R₀ < ‖x‖ → B x = 0 := fun x hx => hB x fun hK => by
    have := hR₀ hK
    rw [Metric.mem_closedBall, dist_zero_right] at this
    linarith
  have hKfin : volume K ≠ ⊤ := hKb.measure_lt_top.ne
  have hind : Integrable (K.indicator fun _ => (1 : ℝ)) :=
    (integrable_indicator_iff hKm).mpr (integrableOn_const hKfin (by simp))
  have hle : ∀ x, ‖B x‖ ≤ K.indicator (fun _ => (1 : ℝ)) x := fun x => by
    by_cases hx : x ∈ K
    · rw [Set.indicator_of_mem hx]; exact hB1 x
    · rw [Set.indicator_of_notMem hx, hB x hx, norm_zero]
  have hval : (∫ x, K.indicator (fun _ => (1 : ℝ)) x) = (volume K).toReal := by
    rw [integral_indicator hKm, setIntegral_const, smul_eq_mul, mul_one, Measure.real]
  refine ⟨⟨R₀, hz⟩, integrable_of_bdd_ball hBm.aestronglyMeasurable hB1 hz, ?_, ?_⟩
  · calc (∫ x, ‖B x‖) ≤ ∫ x, K.indicator (fun _ => (1 : ℝ)) x :=
          integral_mono_of_nonneg (.of_forall fun x => norm_nonneg _) hind (.of_forall hle)
      _ ≤ V := by rw [hval]; exact hKV
  · calc (∫ x, ‖B x‖ ^ 2) ≤ ∫ x, K.indicator (fun _ => (1 : ℝ)) x :=
          integral_mono_of_nonneg (.of_forall fun x => by positivity) hind (.of_forall fun x => by
            have h1 := hB1 x
            have h0 := norm_nonneg (B x)
            nlinarith [hle x])
      _ ≤ V := by rw [hval]; exact hKV

theorem range'_succ_eq_cons {r s : ℕ} (hrs : r < s) :
    List.range' (r + 1) (s - r) = (r + 1) :: List.range' (r + 2) (s - (r + 1)) := by
  obtain ⟨k, hk⟩ : ∃ k, s - r = k + 1 := ⟨s - r - 1, by omega⟩
  rw [hk, List.range'_succ]
  congr 2
  omega

theorem vecProd_affFam (em : E3) (b : ℕ → ℝ) (g : ℕ → E3 → ℂ) (s r : ℕ) (w : Fin r → ℝ)
    (x : E3) (t : ℝ) :
    vecProd (affFam em b g s r w) x t
      = ((List.range' (r + 1) (s - r)).map fun i =>
          affG em b g i r w (x + ((b i - b r) * t) • em)).prod := by
  rw [vecProd_eq_prod_map, affFam, List.map_map]
  rfl

/-- **The children identity of the affine removal** (`patch:affine-block`): translating by the
next slope, the children of the level-`r` family are the level-`(r+1)` spatial block times the
level-`(r+1)` family. -/
theorem affChildren_eq (em : E3) (b : ℕ → ℝ) (g : ℕ → E3 → ℂ) {s r : ℕ} (hrs : r < s)
    (w : Fin r → ℝ) (u : ℝ) (x : E3) (t : ℝ) :
    vecProd (vecChildren (affFam em b g s r w) (fun t => ((b (r + 1) - b r) * t) • em) u) x t
        * phaseChild (fun _ _ => (1 : ℂ)) (fun t => ((b (r + 1) - b r) * t) • em) u x t
      = affG em b g (r + 1) (r + 1) (Fin.cons u w) x
        * (vecProd (affFam em b g s (r + 1) (Fin.cons u w)) x t * 1) := by
  have hpc : phaseChild (fun _ _ => (1 : ℂ)) (fun t => ((b (r + 1) - b r) * t) • em) u x t = 1 := by
    simp [phaseChild]
  rw [hpc, mul_one, mul_one, ← vecProd_children, vecProd_affFam, vecProd_affFam, vecProd_affFam,
    map_list_prod, List.map_map, ← List.prod_map_mul, range'_succ_eq_cons hrs, List.map_cons,
    List.prod_cons, show r + 1 + 1 = r + 2 from rfl]
  have hterm : ∀ i : ℕ, affG em b g i r w (x - ((b (r + 1) - b r) * t) • em
        + ((b i - b r) * (t + u)) • em)
      * conj (affG em b g i r w (x - ((b (r + 1) - b r) * t) • em + ((b i - b r) * t) • em))
      = affG em b g i (r + 1) (Fin.cons u w) (x + ((b i - b (r + 1)) * t) • em) := by
    intro i
    have e1 : x - ((b (r + 1) - b r) * t) • em + ((b i - b r) * (t + u)) • em
        = (x + ((b i - b (r + 1)) * t) • em) + ((b i - b r) * u) • em := by module
    have e2 : x - ((b (r + 1) - b r) * t) • em + ((b i - b r) * t) • em
        = x + ((b i - b (r + 1)) * t) • em := by module
    rw [affG_succ, e1, e2]
  simp only [Function.comp]
  rw [hterm (r + 1), sub_self, zero_mul, zero_smul, add_zero]
  congr 1
  congr 1
  refine List.map_congr_left fun i _ => ?_
  exact hterm i

/-- **The affine terminal identity** (`patch:affine-terminal`): at the last level the family is
empty and the parameter average disappears. -/
theorem affAmp_terminal {V N : ℝ} (hN : 0 < N) (em : E3) (b : ℕ → ℝ) (g : ℕ → E3 → ℂ) (s : ℕ)
    (w : Fin s → ℝ) :
    affAmp V N em b g s s w
      = (V⁻¹ : ℝ) • ∫ x, fdiffIter em s (fun ν => (b s - b (s - 1 - ν.val)) * w ν) (g s) x := by
  rw [affAmp, vecAmp]
  congr 1
  refine integral_congr_ae (.of_forall fun x => ?_)
  simp only [affFam, Nat.sub_self, List.range'_zero, List.map_nil, vecProd_nil, mul_one,
    intervalIntegral.integral_const, zero_add, sub_zero, Complex.real_smul]
  rw [affG]
  push_cast
  have hN' : (N : ℂ) ≠ 0 := by exact_mod_cast hN.ne'
  rw [inv_mul_cancel₀ hN', mul_one]

theorem measurable_prod_affG (em : E3) (b : ℕ → ℝ) {g : ℕ → E3 → ℂ}
    (hgm : ∀ i, Measurable (g i)) (r : ℕ) (l : List ℕ) :
    Measurable fun q : ((Fin r → ℝ) × E3) × ℝ =>
      (l.map fun i => affG em b g i r q.1.1 (q.1.2 + ((b i - b r) * q.2) • em)).prod := by
  induction l with
  | nil => simp
  | cons i l ih =>
    simp only [List.map_cons, List.prod_cons]
    refine Measurable.mul ?_ ih
    exact (measurable_affG_joint em b hgm i r).comp ((measurable_fst.comp measurable_fst).prodMk
      ((measurable_snd.comp measurable_fst).add
        ((measurable_snd.const_mul _).smul_const em)))

/-- Every affine level is measurable in its increments. -/
theorem measurable_affAmp (V N : ℝ) (em : E3) (b : ℕ → ℝ) {g : ℕ → E3 → ℂ}
    (hgm : ∀ i, Measurable (g i)) (s r : ℕ) :
    Measurable fun w : Fin r → ℝ => affAmp V N em b g s r w := by
  have hF : Measurable fun q : ((Fin r → ℝ) × E3) × ℝ =>
      vecProd (affFam em b g s r q.1.1) q.1.2 q.2 * 1 := by
    simp_rw [vecProd_affFam, mul_one]
    exact measurable_prod_affG em b hgm r _
  exact measurable_vecAmp_param V N (G := fun w x => affG em b g r r w x)
    (F := fun w x t => vecProd (affFam em b g s r w) x t * 1)
    (measurable_affG_joint em b hgm r r) hF

/-- The standing hypotheses of the affine removal: measurable one-bounded blocks, each vanishing
off a bounded measurable set of volume at most `V`. -/
structure AffData (V : ℝ) (g : ℕ → E3 → ℂ) (s : ℕ) : Prop where
  meas : ∀ i, Measurable (g i)
  bdd : ∀ i y, ‖g i y‖ ≤ 1
  supp : ∀ i ≤ s, ∃ K : Set E3, MeasurableSet K ∧ Bornology.IsBounded K
    ∧ (volume K).toReal ≤ V ∧ ∀ y, y ∉ K → g i y = 0

theorem AffData.affG_facts {V : ℝ} {g : ℕ → E3 → ℂ} {s : ℕ} (hd : AffData V g s) (em : E3)
    (b : ℕ → ℝ) {i : ℕ} (hi : i ≤ s) (r : ℕ) (w : Fin r → ℝ) :
    (∃ R, ∀ x, R < ‖x‖ → affG em b g i r w x = 0) ∧ Integrable (affG em b g i r w)
      ∧ (∫ x, ‖affG em b g i r w x‖) ≤ V ∧ (∫ x, ‖affG em b g i r w x‖ ^ 2) ≤ V := by
  obtain ⟨K, hKm, hKb, hKV, hK⟩ := hd.supp i hi
  exact block_facts_of_support (measurable_affG em b hd.meas i r w) (norm_affG_le em b hd.bdd i r w)
    hKm hKb hKV fun y hy => affG_eq_zero em b hd.bdd i r w (hK y hy)

theorem affFam_facts {V : ℝ} {g : ℕ → E3 → ℂ} {s : ℕ} (hd : AffData V g s) (em : E3)
    (b : ℕ → ℝ) (r : ℕ) (w : Fin r → ℝ) :
    (∀ b' ∈ affFam em b g s r w, Measurable b'.1 ∧ Continuous b'.2)
      ∧ (∀ b' ∈ affFam em b g s r w, ∀ y, ‖b'.1 y‖ ≤ 1) := by
  constructor
  · intro b' hb'
    rw [affFam, List.mem_map] at hb'
    obtain ⟨i, -, rfl⟩ := hb'
    exact ⟨measurable_affG em b hd.meas i r w,
      (continuous_const.mul continuous_id).smul continuous_const⟩
  · intro b' hb' y
    rw [affFam, List.mem_map] at hb'
    obtain ⟨i, -, rfl⟩ := hb'
    exact norm_affG_le em b hd.bdd i r w y

/-- The data of one affine step: the family is nonempty, its first block is supported. -/
theorem affStep_data {V : ℝ} {g : ℕ → E3 → ℂ} {s : ℕ} (hd : AffData V g s) (em : E3)
    (b : ℕ → ℝ) {r : ℕ} (hrs : r < s) (w : Fin r → ℝ) :
    ∃ K : Set E3, MeasurableSet K ∧ Bornology.IsBounded K ∧ (volume K).toReal ≤ V
      ∧ ∀ y, y ∉ K → affG em b g (r + 1) r w y = 0 := by
  obtain ⟨K, hKm, hKb, hKV, hK⟩ := hd.supp (r + 1) hrs
  exact ⟨K, hKm, hKb, hKV, fun y hy => affG_eq_zero em b hd.bdd _ r w (hK y hy)⟩

theorem affFam_cons (em : E3) (b : ℕ → ℝ) (g : ℕ → E3 → ℂ) {s r : ℕ} (hrs : r < s)
    (w : Fin r → ℝ) :
    affFam em b g s r w = (affG em b g (r + 1) r w, fun t => ((b (r + 1) - b r) * t) • em)
      :: (List.range' (r + 2) (s - (r + 1))).map fun i =>
        (affG em b g i r w, fun t => ((b i - b r) * t) • em) := by
  rw [affFam, range'_succ_eq_cons hrs, List.map_cons]

/-- **One affine removal step** (`patch:affine-block`): `|A_r|^2 ≤ 2 E_u |A_{r+1}| + 2H/N`. -/
theorem affAmp_step {V N H : ℝ} (hN : 0 < N) (hH : 0 < H) (hHN : H ≤ N / 4) (hV : 0 < V)
    (em : E3) (b : ℕ → ℝ) {g : ℕ → E3 → ℂ} {s : ℕ} (hd : AffData V g s) {r : ℕ} (hrs : r < s)
    (w : Fin r → ℝ) :
    ‖affAmp V N em b g s r w‖ ^ 2
      ≤ 2 * (∫ u : ℝ, fejer H u * ‖affAmp V N em b g s (r + 1) (Fin.cons u w)‖) + 2 * H / N := by
  obtain ⟨hL, hL1⟩ := affFam_facts hd em b r w
  rw [affFam_cons em b g hrs] at hL hL1
  obtain ⟨K, hKm, hKb, hKV, hK⟩ := affStep_data hd em b hrs w
  obtain ⟨⟨Rg, hgR⟩, -, -, hgV⟩ := hd.affG_facts em b hrs.le r w
  have hAm : Measurable fun u : ℝ => ‖affAmp V N em b g s (r + 1) (Fin.cons u w)‖ :=
    ((measurable_affAmp V N em b hd.meas s (r + 1)).comp
      ((measurable_fin_cons_real r).comp (measurable_id.prodMk measurable_const))).norm
  have hA1 : ∀ u, |u| ≤ H → ‖affAmp V N em b g s (r + 1) (Fin.cons u w)‖ ≤ 1 := by
    intro u _
    obtain ⟨-, hi, hL1', -⟩ := hd.affG_facts em b (Nat.succ_le_of_lt hrs) (r + 1) (Fin.cons u w)
    exact norm_vecAmp_le_one hV hN hi hL1' (affFam_facts hd em b (r + 1) _).2 fun _ _ => by simp
  have key := vecAmp_step (g' := fun u => affG em b g (r + 1) (r + 1) (Fin.cons u w))
    (L' := fun u => affFam em b g s (r + 1) (Fin.cons u w)) (φ' := fun _ _ _ => (1 : ℂ))
    (φ := fun _ _ => (1 : ℂ)) hN hH hHN hV hL hL1 measurable_const (fun _ _ => by simp)
    hKm hKb hK hKV
    (measurable_affG em b hd.meas r r w) (norm_affG_le em b hd.bdd r r w) hgR hgV
    ((continuous_const.mul continuous_id).smul continuous_const)
    (fun u _ t _ x => by rw [← affFam_cons em b g hrs]; exact affChildren_eq em b g hrs w u x t)
    hAm hA1
  rw [affAmp, affFam_cons em b g hrs]
  exact key

/-- **The last affine step, keeping the signed average.** -/
theorem affAmp_step_re {V N H : ℝ} (hN : 0 < N) (hH : 0 < H) (hHN : H ≤ N / 4) (hV : 0 < V)
    (em : E3) (b : ℕ → ℝ) {g : ℕ → E3 → ℂ} {s : ℕ} (hd : AffData V g s) {r : ℕ} (hrs : r < s)
    (w : Fin r → ℝ) :
    ‖affAmp V N em b g s r w‖ ^ 2
      ≤ 2 * (∫ u : ℝ, fejer H u * (affAmp V N em b g s (r + 1) (Fin.cons u w)).re)
        + 2 * H / N := by
  obtain ⟨hL, hL1⟩ := affFam_facts hd em b r w
  rw [affFam_cons em b g hrs] at hL hL1
  obtain ⟨K, hKm, hKb, hKV, hK⟩ := affStep_data hd em b hrs w
  obtain ⟨⟨Rg, hgR⟩, -, -, hgV⟩ := hd.affG_facts em b hrs.le r w
  have hAm : Measurable fun u : ℝ => affAmp V N em b g s (r + 1) (Fin.cons u w) :=
    (measurable_affAmp V N em b hd.meas s (r + 1)).comp
      ((measurable_fin_cons_real r).comp (measurable_id.prodMk measurable_const))
  have hA1 : ∀ u, |u| ≤ H → ‖affAmp V N em b g s (r + 1) (Fin.cons u w)‖ ≤ 1 := by
    intro u _
    obtain ⟨-, hi, hL1', -⟩ := hd.affG_facts em b (Nat.succ_le_of_lt hrs) (r + 1) (Fin.cons u w)
    exact norm_vecAmp_le_one hV hN hi hL1' (affFam_facts hd em b (r + 1) _).2 fun _ _ => by simp
  have key := vecAmp_step_re (g' := fun u => affG em b g (r + 1) (r + 1) (Fin.cons u w))
    (L' := fun u => affFam em b g s (r + 1) (Fin.cons u w)) (φ' := fun _ _ _ => (1 : ℂ))
    (φ := fun _ _ => (1 : ℂ)) hN hH hHN hV hL hL1 measurable_const (fun _ _ => by simp)
    hKm hKb hK hKV
    (measurable_affG em b hd.meas r r w) (norm_affG_le em b hd.bdd r r w) hgR hgV
    ((continuous_const.mul continuous_id).smul continuous_const)
    (fun u _ t _ x => by rw [← affFam_cons em b g hrs]; exact affChildren_eq em b g hrs w u x t)
    hAm hA1
  rw [affAmp, affFam_cons em b g hrs]
  exact key

end

section
open Filter Topology MeasureTheory

variable {r : ℕ} {ι : Type*} {f : ι}

/-! ### The linear state enters the affine removal

Blueprint `patch:affine-terminal` and "The affine endpoint": "At a formal linear state,
`patch:lead-invariant` says that the head slope and its differences with every other slope are
multiples of `e_m`. Hence all the slopes are multiples of `e_m`. Include the spatial block as a
nuisance of slope zero ... and place the protected block last." -/

/-- A linear shift along `e_m` evaluates to a multiple of `e_m`. -/
theorem petEvalPoly_linear {Q : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ)} {m : Fin 3}
    (hQ1 : Q.natDegree ≤ 1) (hQ0 : Q.coeff 0 = 0) (hQm : ∀ k, k ≠ m → Q.coeff 1 k = 0)
    (η : Fin r → ℝ) (t : ℝ) :
    petEvalPoly η Q t = (MvPolynomial.eval η (Q.coeff 1 m) * t) • basisVec m := by
  rw [Polynomial.eq_X_add_C_of_natDegree_le_one hQ1, hQ0]
  ext k
  simp only [petEvalPoly_apply, map_zero, add_zero, Polynomial.map_mul, Polynomial.map_C,
    Polynomial.map_X, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X, Pi.mul_apply,
    petEvalHom_apply, PiLp.smul_apply, smul_eq_mul, basisVec, PiLp.single_apply]
  by_cases hk : k = m
  · subst hk; simp
  · simp [hk, hQm k hk]

/-- The slope of an item along `e_m`. -/
noncomputable def petSlope (η : Fin r → ℝ) (m : Fin 3)
    (Q : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ)) : ℝ :=
  MvPolynomial.eval η (Q.coeff 1 m)

/-- **At a linear state every shift is along `e_m`**: the head has degree one and every item's
linear coefficient is supported on the coordinate `m`. -/
theorem linState_facts {a : ℝ} {m : Fin 3} {D s : ℕ} {S : NormalPETState r 3 ι f}
    (hinv : PetRunInv a m D s S) (hlin : S.headPoly.natDegree ≤ 1) :
    ∀ it ∈ petAllItems S, it.1.natDegree ≤ 1 ∧ it.1.coeff 0 = 0
      ∧ ∀ k, k ≠ m → it.1.coeff 1 k = 0 := by
  have hh1 : S.headPoly.natDegree = 1 :=
    le_antisymm hlin (one_le_natDegree_of_coeff_zero S.headPoly_ne_zero S.headPoly_vanish)
  obtain ⟨p, -, -, -, hlc⟩ := hinv.1
  have hhc : S.headPoly.coeff 1 = Pi.single m (MvPolynomial.C a * p.map (Int.castRingHom ℝ)) := by
    rw [← hlc, Polynomial.leadingCoeff, hh1]
  have hheadm : ∀ k, k ≠ m → S.headPoly.coeff 1 k = 0 := fun k hk => by
    rw [hhc, Pi.single_eq_of_ne hk]
  intro it hit
  rw [petAllItems, List.mem_cons] at hit
  rcases hit with rfl | hit
  · exact ⟨hlin, S.headPoly_vanish, hheadm⟩
  · have hdeg : it.1.natDegree ≤ 1 := (S.head_max it hit).trans hlin
    refine ⟨hdeg, S.rest_vanish it hit, fun k hk => ?_⟩
    have hne : S.headPoly - it.1 ≠ 0 := sub_ne_zero.mpr (S.rest_ne_head it hit).symm
    have h0 : (S.headPoly - it.1).coeff 0 = 0 := by
      rw [Polynomial.coeff_sub, S.headPoly_vanish, S.rest_vanish it hit, sub_zero]
    have hd1 : (S.headPoly - it.1).natDegree = 1 :=
      le_antisymm ((Polynomial.natDegree_sub_le _ _).trans (max_le hlin hdeg))
        (one_le_natDegree_of_coeff_zero hne h0)
    obtain ⟨p', -, -, -, hlc'⟩ := hinv.2.1 it hit
    have hc : (S.headPoly - it.1).coeff 1
        = Pi.single m (MvPolynomial.C a * p'.map (Int.castRingHom ℝ)) := by
      rw [← hlc', Polynomial.leadingCoeff, hd1]
    have := congrFun hc k
    rw [Polynomial.coeff_sub, Pi.sub_apply, Pi.single_eq_of_ne hk, hheadm k hk, zero_sub,
      neg_eq_zero] at this
    exact this

/-- **The gaps are `a p_i(h)`** (blueprint "every head gap ... has form `a p_i(h)`"): the head
slope minus an item's slope is the evaluated witness of their difference. -/
theorem linState_gap {a : ℝ} {m : Fin 3} {S : NormalPETState r 3 ι f}
    (hlin : S.headPoly.natDegree ≤ 1) {it : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ)
      × List (PetFactor r 3 ι)} (hit : it ∈ S.rest) {p : MvPolynomial (Fin r) ℤ}
    (hlc : (S.headPoly - it.1).leadingCoeff
      = Pi.single m (MvPolynomial.C a * p.map (Int.castRingHom ℝ))) (η : Fin r → ℝ) :
    petSlope η m S.headPoly - petSlope η m it.1 = a * MvPolynomial.aeval η p := by
  have hdeg : it.1.natDegree ≤ 1 := (S.head_max it hit).trans hlin
  have hne : S.headPoly - it.1 ≠ 0 := sub_ne_zero.mpr (S.rest_ne_head it hit).symm
  have h0 : (S.headPoly - it.1).coeff 0 = 0 := by
    rw [Polynomial.coeff_sub, S.headPoly_vanish, S.rest_vanish it hit, sub_zero]
  have hd1 : (S.headPoly - it.1).natDegree = 1 :=
    le_antisymm ((Polynomial.natDegree_sub_le _ _).trans (max_le hlin hdeg))
      (one_le_natDegree_of_coeff_zero hne h0)
  have hc : (S.headPoly - it.1).coeff 1
      = Pi.single m (MvPolynomial.C a * p.map (Int.castRingHom ℝ)) := by
    rw [← hlc, Polynomial.leadingCoeff, hd1]
  have := congrArg (fun v => MvPolynomial.eval η (v m)) hc
  simp only [Polynomial.coeff_sub, Pi.sub_apply, map_sub, Pi.single_eq_same, map_mul,
    MvPolynomial.eval_C, MvPolynomial.eval_map] at this
  rw [petSlope, petSlope, this, MvPolynomial.aeval_def, algebraMap_int_eq]

/-- The head slope is `a p_head(h)`. -/
theorem linState_headSlope {a : ℝ} {m : Fin 3} {S : NormalPETState r 3 ι f}
    (hlin : S.headPoly.natDegree ≤ 1) {p : MvPolynomial (Fin r) ℤ}
    (hlc : S.headPoly.leadingCoeff = Pi.single m (MvPolynomial.C a * p.map (Int.castRingHom ℝ)))
    (η : Fin r → ℝ) : petSlope η m S.headPoly = a * MvPolynomial.aeval η p := by
  have hh1 : S.headPoly.natDegree = 1 :=
    le_antisymm hlin (one_le_natDegree_of_coeff_zero S.headPoly_ne_zero S.headPoly_vanish)
  have hc : S.headPoly.coeff 1 = Pi.single m (MvPolynomial.C a * p.map (Int.castRingHom ℝ)) := by
    rw [← hlc, Polynomial.leadingCoeff, hh1]
  rw [petSlope, hc, Pi.single_eq_same, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_map,
    MvPolynomial.aeval_def, algebraMap_int_eq]

/-! ### The affine data of a linear state -/

/-- The blocks of the affine removal: the spatial block at index `0`, the nuisance items
`1, ..., s - 1`, the protected head at index `s = |rest| + 1`. -/
noncomputable def linBlocks (N Cs : ℝ) (G : ι → E3 → ℂ) (η : Fin r → ℝ) (c : Bool)
    (S : NormalPETState r 3 ι f) (i : ℕ) : E3 → ℂ :=
  if i = 0 then petSpatialFun N Cs G η c S
  else if i ≤ S.rest.length then petBlockFun G η c (S.rest.getD (i - 1) (0, [])).2
  else petBlockFun G η c [S.headFactor]

/-- Their slopes along `e_m`, the spatial block having slope zero. -/
noncomputable def linSlopes (η : Fin r → ℝ) (m : Fin 3) (S : NormalPETState r 3 ι f) (i : ℕ) :
    ℝ :=
  if i = 0 then 0
  else if i ≤ S.rest.length then petSlope η m (S.rest.getD (i - 1) (0, [])).1
  else petSlope η m S.headPoly

theorem translBoxSet_facts (C N : ℝ) (v : E3) :
    MeasurableSet ((fun y => y + v) ⁻¹' petBox C N)
      ∧ Bornology.IsBounded ((fun y => y + v) ⁻¹' petBox C N)
      ∧ volume ((fun y => y + v) ⁻¹' petBox C N) = volume (petBox C N) := by
  refine ⟨(measurableSet_petBox C N).preimage (measurable_id.add_const v), ?_,
    measure_preimage_add_right _ _ _⟩
  refine (Metric.isBounded_closedBall (x := (0 : E3))
    (r := (∑ i : Fin 3, |C * N ^ expo i|) + ‖v‖)).subset fun y hy => ?_
  rw [Metric.mem_closedBall, dist_zero_right]
  have h1 := norm_le_of_mem_petBox (show y + v ∈ petBox C N from hy)
  have h2 := norm_sub_le (y + v) v
  rw [add_sub_cancel_right] at h2
  linarith

theorem measurable_petSpatialFun {G : ι → E3 → ℂ} (hG : ∀ i, Measurable (G i)) (N Cs : ℝ)
    (η : Fin r → ℝ) (c : Bool) (S : NormalPETState r 3 ι f) :
    Measurable (petSpatialFun N Cs G η c S) :=
  ((measurable_boxInd Cs N).comp (measurable_id.add_const _)).mul
    ((measurable_petBlockFun hG c S.spatial).comp (measurable_const.prodMk measurable_id))

theorem getD_mem_of_lt {α : Type*} {l : List α} {k : ℕ} (d : α) (hk : k < l.length) :
    l.getD k d ∈ l := by
  rw [List.getD_eq_getElem _ _ hk]; exact List.getElem_mem hk

/-- **The blocks of a linear state satisfy the standing hypotheses of the affine removal.** -/
theorem linBlocks_affData {N C Cs : ℝ} (hN : 0 ≤ N) (hCCs : C ≤ Cs) {G : ι → E3 → ℂ}
    (hG : ∀ i, Measurable (G i)) (hG1 : ∀ i y, ‖G i y‖ ≤ 1)
    (hGs : ∀ i y, y ∉ petBox C N → G i y = 0) (η : Fin r → ℝ) (c : Bool)
    {S : NormalPETState r 3 ι f} (hne : PetBlocksNonempty S) :
    AffData (volume (petBox Cs N)).toReal (linBlocks N Cs G η c S) (S.rest.length + 1) := by
  have hvolC : (volume (petBox C N)).toReal ≤ (volume (petBox Cs N)).toReal :=
    ENNReal.toReal_mono (volume_petBox_ne_top _ _) (measure_mono (petBox_mono hCCs hN))
  have hblock : ∀ l : List (PetFactor r 3 ι), l ≠ [] → ∃ K : Set E3, MeasurableSet K
      ∧ Bornology.IsBounded K ∧ (volume K).toReal ≤ (volume (petBox Cs N)).toReal
      ∧ ∀ y, y ∉ K → petBlockFun G η c l y = 0 := by
    intro l hl
    obtain ⟨F, l', rfl⟩ := List.exists_cons_of_ne_nil hl
    obtain ⟨hKm, hKb, hKv⟩ := translBoxSet_facts C N (petEvalVec η F.transl)
    exact ⟨_, hKm, hKb, by rw [hKv]; exact hvolC,
      fun y hy => petBlockFun_eq_zero_of_notMem hGs η c hy⟩
  refine ⟨fun i => ?_, fun i y => ?_, fun i hi => ?_⟩
  · unfold linBlocks
    split_ifs
    · exact measurable_petSpatialFun hG N Cs η c S
    · exact (measurable_petBlockFun hG c _).comp (measurable_const.prodMk measurable_id)
    · exact (measurable_petBlockFun hG c _).comp (measurable_const.prodMk measurable_id)
  · unfold linBlocks
    split_ifs
    · exact (translBox_facts Cs N _ ((measurable_petBlockFun hG c S.spatial).comp
        (measurable_const.prodMk measurable_id)) (norm_petBlockFun_le hG1 η c S.spatial)).2.1 y
    · exact norm_petBlockFun_le hG1 η c _ y
    · exact norm_petBlockFun_le hG1 η c _ y
  · unfold linBlocks
    split_ifs with h0 h1
    · obtain ⟨hKm, hKb, hKv⟩ := translBoxSet_facts Cs N (petEvalVec η S.headFactor.transl)
      refine ⟨_, hKm, hKb, by rw [hKv], fun y hy => ?_⟩
      rw [petSpatialFun, boxInd,
        Set.indicator_of_notMem (show y + petEvalVec η S.headFactor.transl ∉ petBox Cs N from hy),
        zero_mul]
    · exact hblock _ (hne _ (getD_mem_of_lt _ (by omega)))
    · exact hblock _ (by simp)

theorem map_eq_map_range_getD {α β : Type*} (l : List α) (d : α) (F : α → β) :
    l.map F = (List.range l.length).map fun k => F (l.getD k d) := by
  induction l with
  | nil => simp
  | cons a l ih =>
    rw [List.length_cons, List.range_succ_eq_map, List.map_cons, List.map_cons, List.map_map, ih]
    simp [Function.comp]

/-- **The linear state is affine level zero** (blueprint "The affine endpoint": "For fixed old
shifts the quantity has the exact form `A_0 = V⁻¹ ∫ E_t ∏_{i=0}^s g_i(x + a_i t e_m) dx`"). -/
theorem petLevel_eq_affAmp_zero {a : ℝ} {m : Fin 3} {D s : ℕ} {S : NormalPETState r 3 ι f}
    (hinv : PetRunInv a m D s S) (hlin : S.headPoly.natDegree ≤ 1) (V N Cs : ℝ)
    (G : ι → E3 → ℂ) (η : Fin r → ℝ) (c : Bool) :
    petLevel V N Cs G c S η = affAmp V N (basisVec m) (linSlopes η m S) (linBlocks N Cs G η c S)
      (S.rest.length + 1) 0 Fin.elim0 := by
  have hlf := linState_facts hinv hlin
  have hfam : ∀ x t, vecProd (petEvalFam G η c S) x t
      = vecProd (affFam (basisVec m) (linSlopes η m S) (linBlocks N Cs G η c S)
          (S.rest.length + 1) 0 Fin.elim0) x t := by
    intro x t
    rw [vecProd_affFam, vecProd_eq_prod_map, petEvalFam, petAllItems, List.map_cons,
      List.map_cons, List.prod_cons, Nat.sub_zero, List.range'_concat, List.map_append,
      List.prod_append, List.map_singleton, List.prod_singleton, mul_comm]
    simp only [affG, fdiffIter_zero]
    have hls0 : linSlopes η m S 0 = 0 := by simp [linSlopes]
    rw [hls0]
    congr 1
    · rw [List.map_map, map_eq_map_range_getD S.rest (0, []), List.range'_eq_map_range,
        List.map_map]
      congr 1
      refine List.map_congr_left fun k hk => ?_
      rw [List.mem_range] at hk
      have hmem := getD_mem_of_lt ((0 : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ)),
        ([] : List (PetFactor r 3 ι))) hk
      obtain ⟨h1, h0, hm⟩ := hlf _ (List.mem_cons_of_mem _ hmem)
      have e : 0 + 1 + k = k + 1 := by omega
      simp only [Function.comp, e, linBlocks, linSlopes, petEvalItem, Nat.add_sub_cancel]
      rw [ite_eq_right (by omega), ite_eq_left (by omega), ite_eq_right (by omega), ite_eq_left
        (by omega),
        petEvalPoly_linear h1 h0 hm, sub_zero]
      rfl
    · obtain ⟨h1, h0, hm⟩ := hlf _ (List.mem_cons_self)
      simp only [linBlocks, linSlopes, petEvalItem]
      rw [ite_eq_right (by omega), ite_eq_right (by omega), ite_eq_right (by omega), ite_eq_right
        (by omega),
        petEvalPoly_linear h1 h0 hm, sub_zero]
      rfl
  rw [petLevel, affAmp, vecAmp, vecAmp]
  congr 1
  refine integral_congr_ae (.of_forall fun x => ?_)
  simp only [affG, fdiffIter_zero, linBlocks]
  congr 2
  refine intervalIntegral.integral_congr fun t _ => ?_
  simp only [hfam]

end

section
open Filter Topology MeasureTheory

/-- **A run bound uniform over all initial types of bounded length** (blueprint
`patch:pet-producer`: "If the initial length is at most `L_0`, take the finite maximum of
`B(w, L_0)` over `0 ≤ w_q ≤ L_0`"). -/
theorem petRun_terminates_uniform (L : ℕ) : ∃ R : ℕ, ∀ {r n : ℕ} {ι : Type*} {f : ι}
    {a : ℝ} (ha : a ≠ 0) {m : Fin n} {D s0 : ℕ} (hD3 : D ≤ 3) {B0 : ℝ} (hB0 : 0 ≤ B0)
    (S0 : NormalPETState r n ι f) (hinv0 : PetRunInv a m D s0 S0) (hbd0 : PetRunBd a m B0 S0),
    (petAllItems S0).length ≤ L → s0 + R < r →
    ∃ T ≤ R, (petRunSeq ha hD3 hB0 S0 hinv0 hbd0 T).1.headPoly.natDegree ≤ 1
      ∧ ∀ k < T, 2 ≤ (petRunSeq ha hD3 hB0 S0 hinv0 hbd0 k).1.headPoly.natDegree := by
  classical
  choose Rw hRw using fun w : ℕ × ℕ × ℕ => petRun_terminates w L
  let W : Finset (ℕ × ℕ × ℕ) :=
    Finset.range (L + 1) ×ˢ (Finset.range (L + 1) ×ˢ Finset.range (L + 1))
  refine ⟨W.sup Rw, ?_⟩
  intro r n ι f a ha m D s0 hD3 B0 hB0 S0 hinv0 hbd0 hL hr
  have hty := petStateType_le_length S0
  have hmem : petStateType S0 ∈ W := by
    simp only [W, Finset.mem_product, Finset.mem_range]
    omega
  have hle : Rw (petStateType S0) ≤ W.sup Rw := Finset.le_sup hmem
  obtain ⟨T, hT, h1, h2⟩ := hRw (petStateType S0) ha hD3 hB0 S0 hinv0 hbd0 rfl hL (by omega)
  exact ⟨T, hT.trans hle, h1, h2⟩

end

section
open Filter Topology MeasureTheory

/-! ### Bookkeeping for the chain: parametric measurability and index transport -/
theorem measurable_affG_param {Θ : Type*} [MeasurableSpace Θ] (em : E3)
    {b : Θ → ℕ → ℝ} (hb : ∀ i, Measurable fun θ => b θ i) {g : Θ → ℕ → E3 → ℂ}
    (hg : ∀ i, Measurable fun q : Θ × E3 => g q.1 i q.2) (i r : ℕ) :
    Measurable fun q : (Θ × (Fin r → ℝ)) × E3 => affG em (b q.1.1) (g q.1.1) i r q.1.2 q.2 := by
  have h := measurable_fdiffIter_param (Θ := Θ) em r (g := fun θ => g θ i) (hg i)
  have hκ : Measurable fun q : (Θ × (Fin r → ℝ)) × E3 =>
      ((q.1.1, (fun ν : Fin r => (b q.1.1 i - b q.1.1 (r - 1 - ν.val)) * q.1.2 ν), q.2) :
        Θ × (Fin r → ℝ) × E3) :=
    (measurable_fst.comp measurable_fst).prodMk ((Measurable.of_eval fun ν =>
      (((hb i).comp (measurable_fst.comp measurable_fst)).sub
        ((hb _).comp (measurable_fst.comp measurable_fst))).mul
        ((measurable_pi_apply ν).comp (measurable_snd.comp measurable_fst))).prodMk
      measurable_snd)
  have hc : Measurable ((fun q : Θ × (Fin r → ℝ) × E3 => fdiffIter em r q.2.1 (g q.1 i) q.2.2) ∘
      fun q : (Θ × (Fin r → ℝ)) × E3 =>
        ((q.1.1, (fun ν : Fin r => (b q.1.1 i - b q.1.1 (r - 1 - ν.val)) * q.1.2 ν), q.2) :
          Θ × (Fin r → ℝ) × E3)) := h.comp hκ
  exact hc

theorem measurable_affAmp_param {Θ : Type*} [MeasurableSpace Θ] (V N : ℝ) (em : E3)
    {b : Θ → ℕ → ℝ} (hb : ∀ i, Measurable fun θ => b θ i) {g : Θ → ℕ → E3 → ℂ}
    (hg : ∀ i, Measurable fun q : Θ × E3 => g q.1 i q.2) (s r : ℕ) :
    Measurable fun q : Θ × (Fin r → ℝ) => affAmp V N em (b q.1) (g q.1) s r q.2 := by
  have hterm : ∀ i, Measurable fun q : ((Θ × (Fin r → ℝ)) × E3) × ℝ =>
      affG em (b q.1.1.1) (g q.1.1.1) i r q.1.1.2
        (q.1.2 + ((b q.1.1.1 i - b q.1.1.1 r) * q.2) • em) := by
    intro i
    have hpt : Measurable fun q : ((Θ × (Fin r → ℝ)) × E3) × ℝ =>
        ((q.1.1, q.1.2 + ((b q.1.1.1 i - b q.1.1.1 r) * q.2) • em) : (Θ × (Fin r → ℝ)) × E3) :=
      (measurable_fst.comp measurable_fst).prodMk
        ((measurable_snd.comp measurable_fst).add
          (((((hb i).comp (measurable_fst.comp (measurable_fst.comp measurable_fst))).sub
            ((hb r).comp (measurable_fst.comp (measurable_fst.comp measurable_fst)))).mul
            measurable_snd).smul_const em))
    have hc : Measurable ((fun q : (Θ × (Fin r → ℝ)) × E3 =>
        affG em (b q.1.1) (g q.1.1) i r q.1.2 q.2) ∘ fun q : ((Θ × (Fin r → ℝ)) × E3) × ℝ =>
          ((q.1.1, q.1.2 + ((b q.1.1.1 i - b q.1.1.1 r) * q.2) • em) :
            (Θ × (Fin r → ℝ)) × E3)) := (measurable_affG_param em hb hg i r).comp hpt
    exact hc
  have hF : Measurable fun q : ((Θ × (Fin r → ℝ)) × E3) × ℝ =>
      vecProd (affFam em (b q.1.1.1) (g q.1.1.1) s r q.1.1.2) q.1.2 q.2 * 1 := by
    simp_rw [vecProd_affFam, mul_one]
    induction List.range' (r + 1) (s - r) with
    | nil => simp
    | cons i l ih =>
      simp only [List.map_cons, List.prod_cons]
      exact (hterm i).mul ih
  have key := measurable_vecAmp_param (ι := Θ × (Fin r → ℝ)) V N
    (G := fun q x => affG em (b q.1) (g q.1) r r q.2 x)
    (F := fun q x t => vecProd (affFam em (b q.1) (g q.1) s r q.2) x t * 1)
    (measurable_affG_param em hb hg r r) hF
  unfold affAmp vecAmp
  exact key

theorem affAmp_congr {V N : ℝ} {em : E3} {b : ℕ → ℝ} {g : ℕ → E3 → ℂ} {s r₁ r₂ : ℕ}
    (e : r₁ = r₂) {w₁ : Fin r₁ → ℝ} {w₂ : Fin r₂ → ℝ} (hw : ∀ ν, w₁ ν = w₂ (Fin.cast e ν)) :
    affAmp V N em b g s r₁ w₁ = affAmp V N em b g s r₂ w₂ := by
  subst e
  congr
  funext ν
  exact hw ν

/-- The newest `k - K₀` shifts: the affine increments. -/
def hcW (k K₀ : ℕ) (h : Fin k → ℝ) : Fin (k - K₀) → ℝ := fun ν => h ⟨ν.val, by omega⟩

/-- The oldest `K₀` shifts: those of the phase steps and of the PET run. -/
def hcOld (k K₀ : ℕ) (h : Fin k → ℝ) : Fin K₀ → ℝ := fun i =>
  if hi : i.val + (k - K₀) < k then h ⟨i.val + (k - K₀), hi⟩ else 0

theorem hcW_cons {k K₀ : ℕ} (hk : K₀ ≤ k) (u : ℝ) (h : Fin k → ℝ) (ν : Fin (k + 1 - K₀)) :
    hcW (k + 1) K₀ (Fin.cons u h) ν
      = (Fin.cons u (hcW k K₀ h) : Fin (k - K₀ + 1) → ℝ) (Fin.cast (by omega) ν) := by
  rcases Nat.eq_zero_or_pos ν.val with h0 | hpos
  · have e1 : (⟨ν.val, by omega⟩ : Fin (k + 1)) = 0 := Fin.ext h0
    have e2 : (Fin.cast (by omega) ν : Fin (k - K₀ + 1)) = 0 := Fin.ext (by simp [h0])
    simp only [hcW, e1, e2, Fin.cons_zero]
  · obtain ⟨n, hn⟩ : ∃ n, ν.val = n + 1 := ⟨ν.val - 1, by omega⟩
    have e1 : (⟨ν.val, by omega⟩ : Fin (k + 1)) = (⟨n, by omega⟩ : Fin k).succ :=
      Fin.ext (by simp [hn])
    have e2 : (Fin.cast (by omega) ν : Fin (k - K₀ + 1)) = (⟨n, by omega⟩ : Fin (k - K₀)).succ :=
      Fin.ext (by simp [hn])
    simp only [hcW, e1, e2, Fin.cons_succ]

theorem hcOld_cons {k K₀ : ℕ} (hk : K₀ ≤ k) (u : ℝ) (h : Fin k → ℝ) :
    hcOld (k + 1) K₀ (Fin.cons u h) = hcOld k K₀ h := by
  funext i
  simp only [hcOld]
  rw [dite_eq_left (by omega), dite_eq_left (by omega)]
  have e1 : (⟨i.val + (k + 1 - K₀), by omega⟩ : Fin (k + 1))
      = (⟨i.val + (k - K₀), by omega⟩ : Fin k).succ := Fin.ext (by simp; omega)
  rw [e1, Fin.cons_succ]

theorem hcOld_self (K₀ : ℕ) (h : Fin K₀ → ℝ) : hcOld K₀ K₀ h = h := by
  funext i
  simp only [hcOld, Nat.sub_self, add_zero, dite_eq_left i.isLt]

theorem measurable_hcW (k K₀ : ℕ) : Measurable (hcW k K₀) :=
  Measurable.of_eval fun _ => measurable_pi_apply _

theorem measurable_hcOld (k K₀ : ℕ) : Measurable (hcOld k K₀) := by
  refine Measurable.of_eval fun i => ?_
  simp only [hcOld]
  split_ifs
  · exact measurable_pi_apply _
  · exact measurable_const

theorem hcOld_mem_fejerBox {H : ℝ} (hH : 0 ≤ H) {k K₀ : ℕ} {h : Fin k → ℝ}
    (hh : h ∈ fejerBox H k) : hcOld k K₀ h ∈ fejerBox H K₀ := by
  intro i
  simp only [hcOld]
  split_ifs
  · exact hh _
  · simpa using hH

end

section
open Filter Topology MeasureTheory

/-! ### The whole chain of `patch:highest-control`

Levels `0` to `3`: the four phase steps (`Auto.phaseLevel`); levels `4` to `4 + T`: the PET run
(`Auto.petLevel`); levels `4 + T + i`, `0 < i ≤ s`: the affine removal (`Auto.affAmp`), the last
one kept signed. -/

/-- The level `k` of the chain, as a function of the `k` shifts introduced so far. -/
noncomputable def hcLevel (V N C Cs : ℝ) (m : ℕ) (f : ℕ → E3 → ℂ) (P : ℕ → Polynomial ℝ)
    (p : E3 → Polynomial ℝ) (j : ℕ → Fin 3) {r : ℕ} (seq : ℕ → NormalPETState r 3 ℕ m)
    (T k : ℕ) (h : Fin k → ℝ) : ℝ :=
  if k = 0 then ‖phaseLevel V N C (f 0) k m f P p j h‖
  else if k < 4 then ‖phaseLevel V N C (boxInd Cs N) k m f P p j h‖
  else if k ≤ 4 + T then ‖petLevel V N Cs f (Nat.bodd (k - 4)) (seq (k - 4)) (petShiftVec k h)‖
  else if k < 4 + T + ((seq T).rest.length + 1) then
    ‖affAmp V N (basisVec (j m))
      (linSlopes (petShiftVec (4 + T) (hcOld k (4 + T) h)) (j m) (seq T))
      (linBlocks N Cs f (petShiftVec (4 + T) (hcOld k (4 + T) h)) (Nat.bodd T) (seq T))
      ((seq T).rest.length + 1) (k - (4 + T)) (hcW k (4 + T) h)‖
  else if k = 4 + T + ((seq T).rest.length + 1) then
    (affAmp V N (basisVec (j m))
      (linSlopes (petShiftVec (4 + T) (hcOld k (4 + T) h)) (j m) (seq T))
      (linBlocks N Cs f (petShiftVec (4 + T) (hcOld k (4 + T) h)) (Nat.bodd T) (seq T))
      ((seq T).rest.length + 1) (k - (4 + T)) (hcW k (4 + T) h)).re
  else 0

section
variable {V N C Cs : ℝ} {m : ℕ} {f : ℕ → E3 → ℂ} {P : ℕ → Polynomial ℝ}
  {p : E3 → Polynomial ℝ} {j : ℕ → Fin 3} {r : ℕ} {seq : ℕ → NormalPETState r 3 ℕ m} {T : ℕ}

theorem hcLevel_zero (h : Fin 0 → ℝ) :
    hcLevel V N C Cs m f P p j seq T 0 h = ‖phaseLevel V N C (f 0) 0 m f P p j h‖ := by
  simp [hcLevel]

theorem hcLevel_phase {k : ℕ} (hk0 : k ≠ 0) (hk : k < 4) (h : Fin k → ℝ) :
    hcLevel V N C Cs m f P p j seq T k h = ‖phaseLevel V N C (boxInd Cs N) k m f P p j h‖ := by
  simp [hcLevel, hk0, hk]

theorem hcLevel_pet {k : ℕ} (hk4 : 4 ≤ k) (hk : k ≤ 4 + T) (h : Fin k → ℝ) :
    hcLevel V N C Cs m f P p j seq T k h
      = ‖petLevel V N Cs f (Nat.bodd (k - 4)) (seq (k - 4)) (petShiftVec k h)‖ := by
  rw [hcLevel, ite_eq_right (by omega), ite_eq_right (by omega), ite_eq_left hk]

theorem hcLevel_aff {k : ℕ} (hk1 : 4 + T < k) (hk2 : k < 4 + T + ((seq T).rest.length + 1))
    (h : Fin k → ℝ) :
    hcLevel V N C Cs m f P p j seq T k h
      = ‖affAmp V N (basisVec (j m))
          (linSlopes (petShiftVec (4 + T) (hcOld k (4 + T) h)) (j m) (seq T))
          (linBlocks N Cs f (petShiftVec (4 + T) (hcOld k (4 + T) h)) (Nat.bodd T) (seq T))
          ((seq T).rest.length + 1) (k - (4 + T)) (hcW k (4 + T) h)‖ := by
  rw [hcLevel, ite_eq_right (by omega), ite_eq_right (by omega), ite_eq_right (by omega),
    ite_eq_left hk2]

theorem hcLevel_last {k : ℕ} (hk : k = 4 + T + ((seq T).rest.length + 1)) (h : Fin k → ℝ) :
    hcLevel V N C Cs m f P p j seq T k h
      = (affAmp V N (basisVec (j m))
          (linSlopes (petShiftVec (4 + T) (hcOld k (4 + T) h)) (j m) (seq T))
          (linBlocks N Cs f (petShiftVec (4 + T) (hcOld k (4 + T) h)) (Nat.bodd T) (seq T))
          ((seq T).rest.length + 1) (k - (4 + T)) (hcW k (4 + T) h)).re := by
  rw [hcLevel, ite_eq_right (by omega), ite_eq_right (by omega), ite_eq_right (by omega),
    ite_eq_right (by omega),
    ite_eq_left hk]

theorem hcLevel_beyond {k : ℕ} (hk : 4 + T + ((seq T).rest.length + 1) < k) (h : Fin k → ℝ) :
    hcLevel V N C Cs m f P p j seq T k h = 0 := by
  rw [hcLevel, ite_eq_right (by omega), ite_eq_right (by omega), ite_eq_right (by omega),
    ite_eq_right (by omega),
    ite_eq_right (by omega)]

end

theorem measurable_linSlopes {r : ℕ} {ι : Type*} {f : ι} (m : Fin 3)
    (S : NormalPETState r 3 ι f) (i : ℕ) : Measurable fun η : Fin r → ℝ => linSlopes η m S i := by
  unfold linSlopes
  split_ifs
  · exact measurable_const
  · exact (continuous_mvEval _).measurable
  · exact (continuous_mvEval _).measurable

theorem measurable_linBlocks_joint {r : ℕ} {ι : Type*} {f : ι} {G : ι → E3 → ℂ}
    (hG : ∀ i, Measurable (G i)) (N Cs : ℝ) (c : Bool) (S : NormalPETState r 3 ι f) (i : ℕ) :
    Measurable fun q : (Fin r → ℝ) × E3 => linBlocks N Cs G q.1 c S i q.2 := by
  unfold linBlocks
  split_ifs
  · exact ((measurable_boxInd Cs N).comp (measurable_snd.add
      ((continuous_petEvalVec _).measurable.comp measurable_fst))).mul
      (measurable_petBlockFun hG c S.spatial)
  · exact measurable_petBlockFun hG c _
  · exact measurable_petBlockFun hG c _

section
variable {N C Cs : ℝ} {m : ℕ} {f : ℕ → E3 → ℂ} {P : ℕ → Polynomial ℝ}
  {p : E3 → Polynomial ℝ} {j : ℕ → Fin 3} {r : ℕ} {seq : ℕ → NormalPETState r 3 ℕ m} {T : ℕ}

/-- Every level of the chain is measurable in its shifts. -/
theorem measurable_hcLevel (hf : ∀ i, Measurable (f i))
    (hFm : Measurable (Function.uncurry fun (x : E3) (t : ℝ) => phaseProd m f P p j x t))
    (V : ℝ) (k : ℕ) :
    Measurable (hcLevel V N C Cs m f P p j seq T k) := by
  set K₀ := 4 + T
  set s := (seq T).rest.length + 1
  have haff : Measurable fun h : Fin k → ℝ => affAmp V N (basisVec (j m))
      (linSlopes (petShiftVec K₀ (hcOld k K₀ h)) (j m) (seq T))
      (linBlocks N Cs f (petShiftVec K₀ (hcOld k K₀ h)) (Nat.bodd T) (seq T)) s (k - K₀)
      (hcW k K₀ h) := by
    have hη : Measurable fun h : Fin k → ℝ => petShiftVec (r := r) K₀ (hcOld k K₀ h) :=
      (continuous_petShiftVec K₀).measurable.comp (measurable_hcOld k K₀)
    have hb : ∀ i, Measurable fun h : Fin k → ℝ =>
        linSlopes (petShiftVec K₀ (hcOld k K₀ h)) (j m) (seq T) i := fun i => by
      have hc : Measurable ((fun η : Fin r → ℝ => linSlopes η (j m) (seq T) i) ∘
          fun h : Fin k → ℝ => petShiftVec (r := r) K₀ (hcOld k K₀ h)) :=
        (measurable_linSlopes (j m) (seq T) i).comp hη
      exact hc
    have hg : ∀ i, Measurable fun q : (Fin k → ℝ) × E3 =>
        linBlocks N Cs f (petShiftVec K₀ (hcOld k K₀ q.1)) (Nat.bodd T) (seq T) i q.2 := fun i => by
      have hc : Measurable ((fun q : (Fin r → ℝ) × E3 =>
          linBlocks N Cs f q.1 (Nat.bodd T) (seq T) i q.2) ∘
          fun q : (Fin k → ℝ) × E3 => ((petShiftVec (r := r) K₀ (hcOld k K₀ q.1), q.2) :
            (Fin r → ℝ) × E3)) :=
        (measurable_linBlocks_joint hf N Cs (Nat.bodd T) (seq T) i).comp
          ((hη.comp measurable_fst).prodMk measurable_snd)
      exact hc
    have h1 := measurable_affAmp_param (Θ := Fin k → ℝ) V N (basisVec (j m))
      (b := fun h => linSlopes (petShiftVec K₀ (hcOld k K₀ h)) (j m) (seq T)) hb
      (g := fun h => linBlocks N Cs f (petShiftVec K₀ (hcOld k K₀ h)) (Nat.bodd T) (seq T))
      hg s (k - K₀)
    have h2 : Measurable ((fun q : (Fin k → ℝ) × (Fin (k - K₀) → ℝ) => affAmp V N (basisVec (j m))
        (linSlopes (petShiftVec K₀ (hcOld k K₀ q.1)) (j m) (seq T))
        (linBlocks N Cs f (petShiftVec K₀ (hcOld k K₀ q.1)) (Nat.bodd T) (seq T)) s (k - K₀) q.2)
        ∘ fun h : Fin k → ℝ => (h, hcW k K₀ h)) :=
      h1.comp (measurable_id.prodMk (measurable_hcW k K₀))
    exact h2
  by_cases h0 : k = 0
  · subst h0
    rw [funext hcLevel_zero]
    exact (measurable_phaseLevel (hf 0) 0 m hFm).norm
  by_cases h4 : k < 4
  · have : hcLevel V N C Cs m f P p j seq T k = fun h =>
        ‖phaseLevel V N C (boxInd Cs N) k m f P p j h‖ := funext (hcLevel_phase h0 h4)
    rw [this]
    exact (measurable_phaseLevel (measurable_boxInd Cs N) k m hFm).norm
  by_cases hT : k ≤ 4 + T
  · have : hcLevel V N C Cs m f P p j seq T k = fun h =>
        ‖petLevel V N Cs f (Nat.bodd (k - 4)) (seq (k - 4)) (petShiftVec k h)‖ :=
      funext (hcLevel_pet (by omega) hT)
    rw [this]
    exact ((measurable_petLevel hf V N Cs _ _).comp (continuous_petShiftVec k).measurable).norm
  by_cases hs : k < 4 + T + s
  · rw [funext (hcLevel_aff (by omega) hs)]
    exact haff.norm
  by_cases hl : k = 4 + T + s
  · rw [funext (hcLevel_last hl)]
    exact Complex.measurable_re.comp haff
  · rw [funext (hcLevel_beyond (by omega))]
    exact measurable_const

end

theorem affAmp_norm_le_one {V N : ℝ} (hV : 0 < V) (hN : 0 < N) {em : E3} {b : ℕ → ℝ}
    {g : ℕ → E3 → ℂ} {s : ℕ} (hd : AffData V g s) {r : ℕ} (hr : r ≤ s) (w : Fin r → ℝ) :
    ‖affAmp V N em b g s r w‖ ≤ 1 := by
  obtain ⟨-, hi, hL1, -⟩ := hd.affG_facts em b hr r w
  exact norm_vecAmp_le_one hV hN hi hL1 (affFam_facts hd em b r w).2 fun _ _ => by simp

theorem phaseLevel_norm_le_one {V N C : ℝ} (hV : 0 < V) (hN : 0 < N) {g : E3 → ℂ}
    (hgi : Integrable g) (hgV : (∫ x, ‖g x‖) ≤ V) {r m : ℕ} {f : ℕ → E3 → ℂ}
    (hf1 : ∀ i y, ‖f i y‖ ≤ 1) (P : ℕ → Polynomial ℝ) (p : E3 → Polynomial ℝ) (j : ℕ → Fin 3)
    (h : Fin r → ℝ) : ‖phaseLevel V N C g r m f P p j h‖ ≤ 1 :=
  norm_vecAmp_le_one hV hN hgi hgV (phaseHead_facts C N (P m) (j m)).2
    fun x t => norm_phaseProdIter_le_one r m hf1 P p j x h t

section
variable {N C Cs : ℝ} {m : ℕ} {f : ℕ → E3 → ℂ} {P : ℕ → Polynomial ℝ}
  {p : E3 → Polynomial ℝ} {j : ℕ → Fin 3} {r : ℕ} {seq : ℕ → NormalPETState r 3 ℕ m} {T : ℕ}

/-- **Every level of the chain is at most one in modulus, and nonnegative before the last.** -/
theorem hcLevel_bounds (hN : 0 < N) (hC : 0 < C) (hCCs : C ≤ Cs)
    (hf : ∀ i, Measurable (f i)) (hf1 : ∀ i y, ‖f i y‖ ≤ 1)
    (hfs : ∀ i y, y ∉ petBox C N → f i y = 0) (hne : PetBlocksNonempty (seq T)) (k : ℕ)
    (h : Fin k → ℝ) :
    |hcLevel (volume (petBox Cs N)).toReal N C Cs m f P p j seq T k h| ≤ 1
      ∧ (k < 4 + T + ((seq T).rest.length + 1) →
        0 ≤ hcLevel (volume (petBox Cs N)).toReal N C Cs m f P p j seq T k h) := by
  set V := (volume (petBox Cs N)).toReal with hVdef
  have hCs : 0 < Cs := by linarith
  have hV : 0 < V := by
    rw [hVdef, volume_petBox hCs.le hN.le, ENNReal.toReal_ofReal (by positivity)]; positivity
  have hvolC : (volume (petBox C N)).toReal ≤ V :=
    ENNReal.toReal_mono (volume_petBox_ne_top _ _) (measure_mono (petBox_mono hCCs hN.le))
  have hd : ∀ η : Fin r → ℝ, AffData V (linBlocks N Cs f η (Nat.bodd T) (seq T))
      ((seq T).rest.length + 1) := fun η =>
    linBlocks_affData hN.le hCCs hf hf1 hfs η (Nat.bodd T) hne
  by_cases h0 : k = 0
  · subst h0
    rw [hcLevel_zero]
    obtain ⟨-, hi, hL1, -⟩ := block_facts_of_support (hf 0) (hf1 0) (measurableSet_petBox C N)
      (isBounded_petBox C N) hvolC (hfs 0)
    refine ⟨?_, fun _ => norm_nonneg _⟩
    rw [abs_of_nonneg (norm_nonneg _)]
    exact phaseLevel_norm_le_one hV hN hi hL1 hf1 P p j h
  by_cases h4 : k < 4
  · rw [hcLevel_phase h0 h4]
    refine ⟨?_, fun _ => norm_nonneg _⟩
    rw [abs_of_nonneg (norm_nonneg _)]
    exact phaseLevel_norm_le_one hV hN (integrable_boxInd Cs N)
      (le_of_eq (integral_norm_boxInd Cs N)) hf1 P p j h
  by_cases hT : k ≤ 4 + T
  · rw [hcLevel_pet (by omega) hT]
    refine ⟨?_, fun _ => norm_nonneg _⟩
    rw [abs_of_nonneg (norm_nonneg _)]
    exact petLevel_norm_le_one hf hf1 hN hCs _ _ _
  by_cases hs : k < 4 + T + ((seq T).rest.length + 1)
  · rw [hcLevel_aff (by omega) hs]
    refine ⟨?_, fun _ => norm_nonneg _⟩
    rw [abs_of_nonneg (norm_nonneg _)]
    exact affAmp_norm_le_one hV hN (hd _) (by omega) _
  by_cases hl : k = 4 + T + ((seq T).rest.length + 1)
  · rw [hcLevel_last hl]
    exact ⟨(Complex.abs_re_le_norm _).trans (affAmp_norm_le_one hV hN (hd _) (by omega) _),
      fun h' => absurd h' (by omega)⟩
  · rw [hcLevel_beyond (by omega)]
    exact ⟨by simp, fun h' => absurd h' (by omega)⟩

end

end

section
open Filter Topology MeasureTheory

variable {r : ℕ}

theorem initDeg_bound_nonneg {P : ℕ → Polynomial ℝ} {m : ℕ} :
    (0 : ℝ) ≤ 4 * ((P m).natDegree : ℝ) := by positivity

/-- The PET run from the initial shifted family. -/
noncomputable def hcSeq (hr : 4 ≤ r) (P : ℕ → Polynomial ℝ) (j : ℕ → Fin 3) (m : ℕ)
    (hP : InitDegrees P m) (k : ℕ) : NormalPETState r 3 ℕ m :=
  (petRunSeq hP.leadingCoeff_ne hP.le_three initDeg_bound_nonneg (initState hr P j m hP)
    initState_inv initState_bd k).1

theorem hcSeq_inv (hr : 4 ≤ r) (P : ℕ → Polynomial ℝ) (j : ℕ → Fin 3) (m : ℕ)
    (hP : InitDegrees P m) (k : ℕ) :
    PetRunInv (-(P m).leadingCoeff) (j m) (P m).natDegree (4 + k) (hcSeq hr P j m hP k) :=
  (petRunSeq hP.leadingCoeff_ne hP.le_three initDeg_bound_nonneg (initState hr P j m hP)
    initState_inv initState_bd k).2.1

theorem hcSeq_nonempty (hr : 4 ≤ r) (P : ℕ → Polynomial ℝ) (j : ℕ → Fin 3) (m : ℕ)
    (hP : InitDegrees P m) (k : ℕ) : PetBlocksNonempty (hcSeq hr P j m hP k) :=
  petRunSeq_nonempty _ _ _ _ _ _ initState_nonempty k

/-- **The Cauchy--Schwarz recursion at every level of the chain of `patch:highest-control`.** -/
theorem hcLevel_step {N H C Kb M0 R0 : ℝ} (hN1 : 1 ≤ N) (hH : 0 < H) (hHN : H ≤ N / 4)
    (hC : 0 < C) (hKb : 0 ≤ Kb) (hM0 : 0 ≤ M0)
    {m : ℕ} {f : ℕ → E3 → ℂ} {P : ℕ → Polynomial ℝ} {p : E3 → Polynomial ℝ} {j : ℕ → Fin 3}
    (hr : 4 ≤ r) (hP : InitDegrees P m)
    (hf : ∀ i, Measurable (f i)) (hf1 : ∀ i y, ‖f i y‖ ≤ 1)
    (hfs : ∀ i y, y ∉ petBox C N → f i y = 0)
    (hFm : Measurable (Function.uncurry fun (x : E3) (t : ℝ) => phaseProd m f P p j x t))
    (hp3 : ∀ x, (p x).natDegree ≤ 3)
    (hK1 : ∀ t ∈ Set.Icc (0 : ℝ) N, |(P m).eval t| ≤ Kb * N ^ expo (j m))
    (hK2 : ∀ t ∈ Set.Icc (0 : ℝ) N, ∀ c, |c| ≤ 4 * H →
      |(P m).eval (t + c) - (P m).eval c| ≤ Kb * N ^ expo (j m))
    (hEnv0 : PetStateEnv N H R0 M0 (initState hr P j m hP))
    {T : ℕ} (hTr : 4 + T < r) (hRT : N ≤ R0 - T * H) (hMT : 4 ^ T * M0 ≤ Kb)
    (hmove : ∀ k < T, 2 ≤ (hcSeq hr P j m hP k).headPoly.natDegree)
    (hlin : (hcSeq hr P j m hP T).headPoly.natDegree ≤ 1)
    {k : ℕ} (hk : k < 4 + T + ((hcSeq hr P j m hP T).rest.length + 1))
    {h : Fin k → ℝ} (hh : h ∈ fejerBox H k) :
    hcLevel (volume (petBox (C + Kb) N)).toReal N C (C + Kb) m f P p j (hcSeq hr P j m hP) T k h
        ^ 2
      ≤ 2 * (∫ u : ℝ, fejer H u * hcLevel (volume (petBox (C + Kb) N)).toReal N C (C + Kb) m f
          P p j (hcSeq hr P j m hP) T (k + 1) (Fin.cons u h)) + 2 * (H / N) := by
  set Cs := C + Kb with hCsdef
  set V := (volume (petBox Cs N)).toReal with hVdef
  set seq := hcSeq hr P j m hP with hseq
  set s := (seq T).rest.length + 1 with hsdef
  have hN : 0 < N := by linarith
  have hCs : 0 < Cs := by linarith
  have hCCs : C ≤ Cs := by linarith
  have hV : 0 < V := by
    rw [hVdef, volume_petBox hCs.le hN.le, ENNReal.toReal_ofReal (by positivity)]; positivity
  have hvolC : (volume (petBox C N)).toReal ≤ V :=
    ENNReal.toReal_mono (volume_petBox_ne_top _ _) (measure_mono (petBox_mono hCCs hN.le))
  have h2H : 2 * H / N = 2 * (H / N) := by ring
  have hm1 := hP.one_le
  -- the phase steps
  by_cases hk4 : k < 4
  · have hphase : ∀ g : E3 → ℂ, Measurable g → (∀ x, ‖g x‖ ≤ 1) →
        (∃ R, ∀ x, R < ‖x‖ → g x = 0) → (∫ x, ‖g x‖ ^ 2) ≤ V →
        ‖phaseLevel V N C g k m f P p j h‖ ^ 2
          ≤ 2 * (∫ u : ℝ, fejer H u
            * ‖phaseLevel V N C (boxInd Cs N) (k + 1) m f P p j (Fin.cons u h)‖)
            + 2 * (H / N) := by
      intro g hgm hg1 hgR hgV
      obtain ⟨Rg, hRg⟩ := hgR
      rw [← h2H]
      exact phaseLevel_step hN1 hH hHN hC hKb hm1 hf1 hFm (hfs m) hK1 hgm hg1 hRg hgV h
    have hRHS : (∫ u : ℝ, fejer H u
          * ‖phaseLevel V N C (boxInd Cs N) (k + 1) m f P p j (Fin.cons u h)‖)
        = ∫ u : ℝ, fejer H u * hcLevel V N C Cs m f P p j seq T (k + 1) (Fin.cons u h) := by
      refine integral_congr_ae (.of_forall fun u => ?_)
      simp only
      by_cases hk3 : k + 1 < 4
      · rw [hcLevel_phase (by omega) hk3]
      · have hk3' : k = 3 := by omega
        subst hk3'
        by_cases hu : |u| ≤ H
        · have hcons : ∀ l, |(Fin.cons u h : Fin 4 → ℝ) l| ≤ H := by
            intro l
            refine Fin.cases ?_ (fun l => ?_) l
            · simpa using hu
            · simpa using hh l
          rw [hcLevel_pet (by omega) (by omega),
            phaseLevel_four_eq_petLevel (hr := hr) (hP := hP) hN1 hH.le hKb le_rfl (hfs m) hp3
              hK1 hK2 V hcons]
          rfl
        · rw [fejer_eq_zero_of_le hH (le_of_lt (not_le.mp hu)), zero_mul, zero_mul]
    rw [← hRHS]
    by_cases hk0 : k = 0
    · subst hk0
      rw [hcLevel_zero]
      obtain ⟨hR, -, -, hsq⟩ := block_facts_of_support (hf 0) (hf1 0)
        (measurableSet_petBox C N) (isBounded_petBox C N) hvolC (hfs 0)
      exact hphase (f 0) (hf 0) (hf1 0) hR hsq
    · rw [hcLevel_phase hk0 hk4]
      exact hphase (boxInd Cs N) (measurable_boxInd Cs N) (norm_boxInd_le Cs N)
        ⟨_, fun x hx => boxInd_eq_zero hx⟩ (le_of_eq (integral_sq_boxInd Cs N))
  -- the PET steps
  by_cases hkT : k < 4 + T
  · obtain ⟨k', rfl⟩ : ∃ k', k = 4 + k' := ⟨k - 4, by omega⟩
    have hk'T : k' < T := by omega
    have hpow : (4 : ℝ) ^ (k' + 1) ≤ 4 ^ T := pow_le_pow_right₀ (by norm_num) (by omega)
    have key := petRun_level_step hP.leadingCoeff_ne hP.le_three initDeg_bound_nonneg
      (initState hr P j m hP) initState_inv initState_bd initState_facsBelow hN1 hH hHN hC hCCs
      hM0 hEnv0 hf hf1 (hfs m) (hmove k' hk'T) (by omega)
      (by have : ((k' + 1 : ℕ) : ℝ) ≤ T := by exact_mod_cast hk'T
          nlinarith)
      (by nlinarith) hh
    rw [hcLevel_pet (by omega) (by omega), show 4 + k' - 4 = k' by omega]
    have hRHS : ∀ u, hcLevel V N C Cs m f P p j seq T (4 + k' + 1) (Fin.cons u h)
        = ‖petLevel V N Cs f (Nat.bodd (k' + 1)) (seq (k' + 1))
            (petShiftVec (4 + k' + 1) (Fin.cons u h))‖ := by
      intro u
      rw [hcLevel_pet (by omega) (by omega), show 4 + k' + 1 - 4 = k' + 1 by omega]
    simp_rw [hRHS]
    rw [← h2H]
    exact key
  -- the affine removal
  have hinvT := hcSeq_inv hr P j m hP T
  have hneT := hcSeq_nonempty hr P j m hP T
  set K₀ := 4 + T with hK₀
  have hd : ∀ η : Fin r → ℝ, AffData V (linBlocks N Cs f η (Nat.bodd T) (seq T)) s := fun η =>
    linBlocks_affData hN.le hCCs hf hf1 hfs η (Nat.bodd T) hneT
  have hLHS : hcLevel V N C Cs m f P p j seq T k h
      = ‖affAmp V N (basisVec (j m))
          (linSlopes (petShiftVec K₀ (hcOld k K₀ h)) (j m) (seq T))
          (linBlocks N Cs f (petShiftVec K₀ (hcOld k K₀ h)) (Nat.bodd T) (seq T))
          s (k - K₀) (hcW k K₀ h)‖ := by
    by_cases hkK : k = K₀
    · subst hkK
      rw [hcLevel_pet (by omega) le_rfl, show 4 + T - 4 = T by omega, hcOld_self,
        petLevel_eq_affAmp_zero hinvT hlin]
      congr 1
      exact affAmp_congr (by omega) fun ν => ν.elim0
    · exact hcLevel_aff (by omega) hk h
  rw [hLHS]
  have hrs : k - K₀ < s := by omega
  have hdata : ∀ u, hcOld (k + 1) K₀ (Fin.cons u h) = hcOld k K₀ h := fun u =>
    hcOld_cons (by omega) u h
  have hw : ∀ u, affAmp V N (basisVec (j m))
        (linSlopes (petShiftVec K₀ (hcOld k K₀ h)) (j m) (seq T))
        (linBlocks N Cs f (petShiftVec K₀ (hcOld k K₀ h)) (Nat.bodd T) (seq T))
        s (k - K₀ + 1) (Fin.cons u (hcW k K₀ h))
      = affAmp V N (basisVec (j m))
        (linSlopes (petShiftVec K₀ (hcOld (k + 1) K₀ (Fin.cons u h))) (j m) (seq T))
        (linBlocks N Cs f (petShiftVec K₀ (hcOld (k + 1) K₀ (Fin.cons u h))) (Nat.bodd T) (seq T))
        s (k + 1 - K₀) (hcW (k + 1) K₀ (Fin.cons u h)) := by
    intro u
    rw [hdata]
    exact affAmp_congr (by omega) fun ν => by
      rw [hcW_cons (by omega) u h]
      rfl
  by_cases hlast : k + 1 < K₀ + s
  · have key := affAmp_step hN hH hHN hV (basisVec (j m))
      (linSlopes (petShiftVec K₀ (hcOld k K₀ h)) (j m) (seq T))
      (hd (petShiftVec K₀ (hcOld k K₀ h))) hrs (hcW k K₀ h)
    have hRHS : ∀ u, hcLevel V N C Cs m f P p j seq T (k + 1) (Fin.cons u h)
        = ‖affAmp V N (basisVec (j m))
          (linSlopes (petShiftVec K₀ (hcOld k K₀ h)) (j m) (seq T))
          (linBlocks N Cs f (petShiftVec K₀ (hcOld k K₀ h)) (Nat.bodd T) (seq T))
          s (k - K₀ + 1) (Fin.cons u (hcW k K₀ h))‖ := by
      intro u
      rw [hcLevel_aff (by omega) hlast, hw u]
    simp_rw [hRHS]
    rw [← h2H]
    exact key
  · have key := affAmp_step_re hN hH hHN hV (basisVec (j m))
      (linSlopes (petShiftVec K₀ (hcOld k K₀ h)) (j m) (seq T))
      (hd (petShiftVec K₀ (hcOld k K₀ h))) hrs (hcW k K₀ h)
    have hRHS : ∀ u, hcLevel V N C Cs m f P p j seq T (k + 1) (Fin.cons u h)
        = (affAmp V N (basisVec (j m))
          (linSlopes (petShiftVec K₀ (hcOld k K₀ h)) (j m) (seq T))
          (linBlocks N Cs f (petShiftVec K₀ (hcOld k K₀ h)) (Nat.bodd T) (seq T))
          s (k - K₀ + 1) (Fin.cons u (hcW k K₀ h))).re := by
      intro u
      rw [hcLevel_last (by omega), hw u]
    simp_rw [hRHS]
    rw [← h2H]
    exact key

end

section
open Filter Topology MeasureTheory

variable {r : ℕ}

/-- **`patch:cs-loss` along the whole chain of `patch:highest-control`**: the level-zero
correlation, raised to the power `2^{T_tot}`, is controlled by the signed terminal mean. -/
theorem hc_chain {N H C Kb M0 R0 : ℝ} (hN1 : 1 ≤ N) (hH : 0 < H) (hHN : H ≤ N / 4)
    (hC : 0 < C) (hKb : 0 ≤ Kb) (hM0 : 0 ≤ M0)
    {m : ℕ} {f : ℕ → E3 → ℂ} {P : ℕ → Polynomial ℝ} {p : E3 → Polynomial ℝ} {j : ℕ → Fin 3}
    (hr : 4 ≤ r) (hP : InitDegrees P m)
    (hf : ∀ i, Measurable (f i)) (hf1 : ∀ i y, ‖f i y‖ ≤ 1)
    (hfs : ∀ i y, y ∉ petBox C N → f i y = 0)
    (hFm : Measurable (Function.uncurry fun (x : E3) (t : ℝ) => phaseProd m f P p j x t))
    (hp3 : ∀ x, (p x).natDegree ≤ 3)
    (hK1 : ∀ t ∈ Set.Icc (0 : ℝ) N, |(P m).eval t| ≤ Kb * N ^ expo (j m))
    (hK2 : ∀ t ∈ Set.Icc (0 : ℝ) N, ∀ c, |c| ≤ 4 * H →
      |(P m).eval (t + c) - (P m).eval c| ≤ Kb * N ^ expo (j m))
    (hEnv0 : PetStateEnv N H R0 M0 (initState hr P j m hP))
    {T : ℕ} (hTr : 4 + T < r) (hRT : N ≤ R0 - T * H) (hMT : 4 ^ T * M0 ≤ Kb)
    (hmove : ∀ k < T, 2 ≤ (hcSeq hr P j m hP k).headPoly.natDegree)
    (hlin : (hcSeq hr P j m hP T).headPoly.natDegree ≤ 1) :
    hcLevel (volume (petBox (C + Kb) N)).toReal N C (C + Kb) m f P p j (hcSeq hr P j m hP) T 0
        Fin.elim0 ^ (2 ^ (4 + T + ((hcSeq hr P j m hP T).rest.length + 1)))
      ≤ 2 ^ (2 ^ (4 + T + ((hcSeq hr P j m hP T).rest.length + 1))) / 2
        * (max (fejerMean H (4 + T + ((hcSeq hr P j m hP T).rest.length + 1))
            (hcLevel (volume (petBox (C + Kb) N)).toReal N C (C + Kb) m f P p j
              (hcSeq hr P j m hP) T (4 + T + ((hcSeq hr P j m hP T).rest.length + 1)))) 0
          + ((4 + T + ((hcSeq hr P j m hP T).rest.length + 1) : ℕ) : ℝ) * (H / N)) := by
  have hN : 0 < N := by linarith
  have hCCs : C ≤ C + Kb := by linarith
  refine fejerChain_box hH (div_nonneg hH.le hN.le)
    (fun k => measurable_hcLevel hf hFm _ k)
    (fun k h _ => (hcLevel_bounds hN hC hCCs hf hf1 hfs (hcSeq_nonempty hr P j m hP T) k h).1)
    (fun k hk h _ => (hcLevel_bounds hN hC hCCs hf hf1 hfs (hcSeq_nonempty hr P j m hP T) k h).2
      hk)
    (fun k hk h hh => hcLevel_step hN1 hH hHN hC hKb hM0 hr hP hf hf1 hfs hFm hp3 hK1 hK2
      hEnv0 hTr hRT hMT hmove hlin hk hh)

end

section
open Filter Topology MeasureTheory

/-! ### The terminal mean as the averaged raw cube of the protected input

"Translation/conjugation invariance identifies its integrated power with that of `f`." -/
theorem fdiffIter_translate (v : E3) : ∀ (s : ℕ) (c : Fin s → ℝ) (F : E3 → ℂ) (a x : E3),
    fdiffIter v s c (fun y => F (y + a)) x = fdiffIter v s c F (x + a)
  | 0, _, _, _, _ => rfl
  | (s + 1), c, F, a, x => by
      rw [fdiffIter_succ, fdiffIter_succ, fdiff, fdiff,
        fdiffIter_translate v s _ F a, fdiffIter_translate v s _ F a]
      congr 2
      abel

theorem fdiffIter_conj (v : E3) : ∀ (s : ℕ) (c : Fin s → ℝ) (F : E3 → ℂ) (x : E3),
    fdiffIter v s c (fun y => conj (F y)) x = conj (fdiffIter v s c F x)
  | 0, _, _, _ => rfl
  | (s + 1), c, F, x => by
      rw [fdiffIter_succ, fdiffIter_succ, fdiff, fdiff, fdiffIter_conj v s _ F,
        fdiffIter_conj v s _ F, map_mul]

theorem re_integral_fdiffIter_condConj (v : E3) (s : ℕ) (c : Fin s → ℝ) (F : E3 → ℂ)
    (b : Bool) (a : E3) :
    (∫ x, fdiffIter v s c (fun y => condConj b (F (y + a))) x).re
      = (∫ x, fdiffIter v s c F x).re := by
  cases b
  · simp only [condConj_false]
    rw [show (fun x => fdiffIter v s c (fun y => F (y + a)) x)
        = fun x => fdiffIter v s c F (x + a) from funext fun x => fdiffIter_translate v s c F a x,
      integral_add_right_eq_self (fun x => fdiffIter v s c F x) a]
  · simp only [condConj_true]
    rw [show (fun x => fdiffIter v s c (fun y => conj (F (y + a))) x)
        = fun x => conj (fdiffIter v s c F (x + a)) from funext fun x => by
          rw [fdiffIter_conj, fdiffIter_translate],
      integral_conj, Complex.conj_re,
      integral_add_right_eq_self (fun x => fdiffIter v s c F x) a]

variable {r : ℕ}

/-- The first `s` shifts. -/
def hcWs (K s : ℕ) (h : Fin (K + s) → ℝ) : Fin s → ℝ := fun ν => h ⟨ν.val, by omega⟩

/-- The gaps at the terminal level: `b_s - b_{s-1-ν}`. -/
noncomputable def hcGap {ι : Type*} {f : ι} (η : Fin r → ℝ) (em : Fin 3)
    (S : NormalPETState r 3 ι f) (ν : ℕ) : ℝ :=
  linSlopes η em S (S.rest.length + 1) - linSlopes η em S (S.rest.length - ν)

/-- **The terminal level is the raw cube of the protected input** at the gaps `a p_i(h)`. -/
theorem hcLevel_terminal {V N C Cs : ℝ} (hN : 0 < N) {m : ℕ} {f : ℕ → E3 → ℂ}
    {P : ℕ → Polynomial ℝ} {p : E3 → Polynomial ℝ} {j : ℕ → Fin 3}
    {seq : ℕ → NormalPETState r 3 ℕ m} {T : ℕ}
    (h : Fin (4 + T + ((seq T).rest.length + 1)) → ℝ) :
    hcLevel V N C Cs m f P p j seq T (4 + T + ((seq T).rest.length + 1)) h
      = V⁻¹ * (∫ x, fdiffIter (basisVec (j m)) ((seq T).rest.length + 1)
          (fun ν => hcGap (petShiftVec (4 + T) (hcOld _ (4 + T) h)) (j m) (seq T) ν.val
            * hcWs (4 + T) _ h ν) (f m) x).re := by
  rw [hcLevel_last rfl]
  rw [affAmp_congr (w₂ := hcWs (4 + T) ((seq T).rest.length + 1) h) (by omega)
    (fun ν => by simp [hcW, hcWs])]
  rw [affAmp_terminal hN, Complex.smul_re]
  simp only [smul_eq_mul]
  congr 1
  have hblk : linBlocks N Cs f (petShiftVec (4 + T) (hcOld _ (4 + T) h)) (Nat.bodd T) (seq T)
      ((seq T).rest.length + 1)
      = fun y => condConj (xor (Nat.bodd T) (seq T).headFactor.isConj)
          (f m (y + petEvalVec (petShiftVec (4 + T) (hcOld _ (4 + T) h))
            (seq T).headFactor.transl)) := by
    funext y
    rw [linBlocks, ite_eq_right (Nat.succ_ne_zero _), ite_eq_right (by omega)]
    simp only [petBlockFun, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
      petFacFun, (seq T).head_origin]
  rw [hblk, re_integral_fdiffIter_condConj]
  rfl

end

section
open Filter Topology MeasureTheory

theorem hcWs_cons {K s : ℕ} (u : ℝ) (h : Fin (K + s) → ℝ) :
    hcWs K (s + 1) (Fin.cons u h : Fin (K + s + 1) → ℝ) = Fin.cons u (hcWs K s h) := by
  funext ν
  refine Fin.cases ?_ (fun ν => ?_) ν
  · simp only [hcWs, Fin.cons_zero]
    rfl
  · simp only [hcWs, Fin.cons_succ]
    have : (⟨(ν.succ : Fin (s + 1)).val, by omega⟩ : Fin (K + s + 1))
        = (⟨ν.val, by omega⟩ : Fin (K + s)).succ := Fin.ext (by simp)
    rw [this, Fin.cons_succ]

theorem measurable_hcWs (K s : ℕ) : Measurable (hcWs K s) :=
  Measurable.of_eval fun _ => measurable_pi_apply _

/-- **Recombining a Fejer average over a new first shift with the product mean** for a bounded
measurable integrand. -/
theorem fejer_inner_eq {H : ℝ} (hH : 0 < H) {s : ℕ} {B : (Fin (s + 1) → ℝ) → ℝ}
    (hBm : Measurable B) (hB1 : ∀ w, |B w| ≤ 1) :
    (∫ h : Fin s → ℝ, (∏ l, fejer H (h l)) * ∫ u : ℝ, fejer H u * B (Fin.cons u h))
      = ∫ k : Fin (s + 1) → ℝ, (∏ l, fejer H (k l)) * B k := by
  have hbc : Measurable fun q : ℝ × (Fin s → ℝ) => B (Fin.cons q.1 q.2) :=
    hBm.comp (measurable_fin_cons_real s)
  have hwq : Integrable (fun q : ℝ × (Fin s → ℝ) => fejer H q.1 * ∏ l : Fin s, fejer H (q.2 l))
      ((volume : Measure ℝ).prod (volume : Measure (Fin s → ℝ))) :=
    (integrable_fejer hH).mul_prod (integrable_prod_fejer hH s)
  have hint : Integrable fun q : ℝ × (Fin s → ℝ) =>
      (∏ l : Fin (s + 1), fejer H ((Fin.cons q.1 q.2 : Fin (s + 1) → ℝ) l))
        * B (Fin.cons q.1 q.2) := by
    simp_rw [prod_fejer_cons]
    rw [Measure.volume_eq_prod]
    exact hwq.mul_bdd hbc.aestronglyMeasurable
      (.of_forall fun q => by rw [Real.norm_eq_abs]; exact hB1 _)
  have hint' : Integrable (Function.uncurry fun (h : Fin s → ℝ) (u : ℝ) =>
      (∏ l : Fin s, fejer H (h l)) * (fejer H u * B (Fin.cons u h)))
      ((volume : Measure (Fin s → ℝ)).prod (volume : Measure ℝ)) := by
    have h1 : Integrable (fun q : ℝ × (Fin s → ℝ) =>
        (∏ l : Fin s, fejer H (q.2 l)) * (fejer H q.1 * B (Fin.cons q.1 q.2)))
        ((volume : Measure ℝ).prod (volume : Measure (Fin s → ℝ))) := by
      rw [← Measure.volume_eq_prod]
      refine hint.congr (.of_forall fun q => ?_)
      simp only [prod_fejer_cons]
      ring
    refine h1.swap.congr (.of_forall fun q => ?_)
    simp [Function.uncurry]
  exact integral_prod_fejer_mul_inner_eq s (B := B) (integral_integral_swap hint') hint

/-- **Splitting the product Fejer mean into the newest `s` shifts and the oldest `K`.** -/
theorem integral_split_fejer {H : ℝ} (hH : 0 < H) (K : ℕ) : ∀ (s : ℕ)
    {Φ : (Fin s → ℝ) → (Fin K → ℝ) → ℝ}, Measurable (Function.uncurry Φ) →
    (∀ w o, |Φ w o| ≤ 1) →
    (∫ h : Fin (K + s) → ℝ, (∏ l, fejer H (h l)) * Φ (hcWs K s h) (hcOld (K + s) K h))
      = ∫ o : Fin K → ℝ, (∏ l, fejer H (o l)) * ∫ w : Fin s → ℝ, (∏ l, fejer H (w l)) * Φ w o
  | 0, Φ, hΦ, hb => by
      have h0 : ∀ o : Fin K → ℝ, (∫ w : Fin 0 → ℝ, (∏ l, fejer H (w l)) * Φ w o)
          = Φ Fin.elim0 o := fun o => fejerMean_zero H (fun w => Φ w o)
      simp_rw [h0]
      refine integral_congr_ae (.of_forall fun h => ?_)
      simp only
      congr 2
      · funext ν; exact ν.elim0
      · funext i; simp [hcOld]
  | (s + 1), Φ, hΦ, hb => by
      -- the inner average over the newest shift
      set Ψ : (Fin s → ℝ) → (Fin K → ℝ) → ℝ :=
        fun w o => ∫ u : ℝ, fejer H u * Φ (Fin.cons u w) o with hΨ
      have hconsm : Measurable fun q : ℝ × ((Fin s → ℝ) × (Fin K → ℝ)) =>
          ((Fin.cons q.1 q.2.1 : Fin (s + 1) → ℝ), q.2.2) :=
        ((measurable_fin_cons_real s).comp (measurable_fst.prodMk
          (measurable_fst.comp measurable_snd))).prodMk (measurable_snd.comp measurable_snd)
      have hΨm : Measurable (Function.uncurry Ψ) := by
        have hj : Measurable (Function.uncurry fun (q : (Fin s → ℝ) × (Fin K → ℝ)) (u : ℝ) =>
            fejer H u * Φ (Fin.cons u q.1) q.2) :=
          (continuous_fejer.measurable.comp measurable_snd).mul
            (hΦ.comp (hconsm.comp measurable_swap))
        exact (hj.stronglyMeasurable.integral_prod_right (ν := (volume : Measure ℝ))).measurable
      have hint1 : ∀ w o, Integrable fun u : ℝ => fejer H u * Φ (Fin.cons u w) o := fun w o =>
        (integrable_fejer hH).mul_bdd ((hΦ.comp ((measurable_fin_cons_real s).comp
          (measurable_id.prodMk measurable_const) |>.prodMk measurable_const)).aestronglyMeasurable)
          (.of_forall fun u => by rw [Real.norm_eq_abs]; exact hb _ _)
      have hΨb : ∀ w o, |Ψ w o| ≤ 1 := by
        intro w o
        calc |Ψ w o| ≤ ∫ u : ℝ, |fejer H u * Φ (Fin.cons u w) o| := by
              have := norm_integral_le_integral_norm (μ := (volume : Measure ℝ))
                (fun u : ℝ => fejer H u * Φ (Fin.cons u w) o)
              simpa only [Real.norm_eq_abs] using this
          _ ≤ ∫ u : ℝ, fejer H u := by
              refine integral_mono (hint1 w o).abs (integrable_fejer hH) fun u => ?_
              rw [abs_mul, abs_of_nonneg (fejer_nonneg hH u)]
              exact mul_le_of_le_one_right (fejer_nonneg hH u) (hb _ _)
          _ = 1 := integral_fejer hH
      have ih := integral_split_fejer hH K s hΨm hΨb
      have hBm : Measurable fun k : Fin (K + s + 1) → ℝ =>
          Φ (hcWs K (s + 1) k) (hcOld (K + s + 1) K k) :=
        hΦ.comp ((measurable_hcWs K (s + 1)).prodMk (measurable_hcOld _ K))
      have hstep1 := fejer_inner_eq hH (s := K + s) hBm (fun k => hb _ _)
      have hin : ∀ h' : Fin (K + s) → ℝ, (∫ u : ℝ, fejer H u
            * Φ (hcWs K (s + 1) (Fin.cons u h' : Fin (K + s + 1) → ℝ))
              (hcOld (K + s + 1) K (Fin.cons u h')))
          = Ψ (hcWs K s h') (hcOld (K + s) K h') := by
        intro h'
        simp only [hΨ]
        refine integral_congr_ae (.of_forall fun u => ?_)
        simp only
        rw [hcWs_cons, hcOld_cons (by omega)]
      simp_rw [hin] at hstep1
      refine hstep1.symm.trans ?_
      rw [ih]
      refine integral_congr_ae (.of_forall fun o => ?_)
      simp only
      congr 1
      exact fejer_inner_eq hH ((hΦ.comp (measurable_id.prodMk measurable_const)))
        (fun w => hb w o)

variable {r : ℕ}

/-- The terminal integrand: `V⁻¹ Re ∫ Δ_{gap ⊙ w} f_m` at old shifts `o` and new shifts `w`. -/
noncomputable def hcTerm (V : ℝ) (m : ℕ) (f : ℕ → E3 → ℂ) (j : ℕ → Fin 3) (K s : ℕ)
    (S : NormalPETState r 3 ℕ m) (w : Fin s → ℝ) (o : Fin K → ℝ) : ℝ :=
  V⁻¹ * (∫ x, fdiffIter (basisVec (j m)) s
    (fun ν => hcGap (petShiftVec K o) (j m) S ν.val * w ν) (f m) x).re

theorem measurable_hcGap {ι : Type*} {f : ι} (em : Fin 3) (S : NormalPETState r 3 ι f) (ν : ℕ) :
    Measurable fun η : Fin r → ℝ => hcGap η em S ν :=
  (measurable_linSlopes em S _).sub (measurable_linSlopes em S _)

theorem measurable_hcTerm (V : ℝ) {m : ℕ} {f : ℕ → E3 → ℂ} (hf : ∀ i, Measurable (f i))
    (j : ℕ → Fin 3) (K s : ℕ) (S : NormalPETState r 3 ℕ m) :
    Measurable (Function.uncurry (hcTerm V m f j K s S)) := by
  have hjoint := measurable_fdiffIter_param (Θ := Unit) (basisVec (j m)) s
    (g := fun _ => f m) ((hf m).comp measurable_snd)
  have hκ : Measurable fun q : ((Fin s → ℝ) × (Fin K → ℝ)) × E3 =>
      (((), (fun ν : Fin s => hcGap (petShiftVec K q.1.2) (j m) S ν.val * q.1.1 ν), q.2) :
        Unit × (Fin s → ℝ) × E3) :=
    measurable_const.prodMk ((Measurable.of_eval fun ν : Fin s =>
      ((measurable_hcGap (j m) S ν.val).comp ((continuous_petShiftVec K).measurable.comp
        (measurable_snd.comp measurable_fst))).mul
        ((measurable_pi_apply ν).comp (measurable_fst.comp measurable_fst))).prodMk
      measurable_snd)
  have hc : Measurable ((fun q : Unit × (Fin s → ℝ) × E3 =>
      fdiffIter (basisVec (j m)) s q.2.1 (f m) q.2.2) ∘ fun q : ((Fin s → ℝ) × (Fin K → ℝ)) × E3 =>
        (((), (fun ν : Fin s => hcGap (petShiftVec K q.1.2) (j m) S ν.val * q.1.1 ν), q.2) :
          Unit × (Fin s → ℝ) × E3)) := hjoint.comp hκ
  have hint := (hc.stronglyMeasurable.integral_prod_right' (ν := (volume : Measure E3))).measurable
  exact measurable_const.mul (Complex.measurable_re.comp hint)

theorem abs_hcTerm_le {V C N : ℝ} (hV : 0 < V) {m : ℕ} {f : ℕ → E3 → ℂ}
    (hf : ∀ i, Measurable (f i)) (hf1 : ∀ i y, ‖f i y‖ ≤ 1)
    (hfs : ∀ i y, y ∉ petBox C N → f i y = 0) (hvol : (volume (petBox C N)).toReal ≤ V)
    (j : ℕ → Fin 3) (K s : ℕ) (S : NormalPETState r 3 ℕ m) (w : Fin s → ℝ) (o : Fin K → ℝ) :
    |hcTerm V m f j K s S w o| ≤ 1 := by
  obtain ⟨-, hi, hL1, -⟩ := block_facts_of_support (hf m) (hf1 m) (measurableSet_petBox C N)
    (isBounded_petBox C N) hvol (hfs m)
  rw [hcTerm, abs_mul, abs_of_pos (inv_pos.mpr hV)]
  calc V⁻¹ * |(∫ x, fdiffIter (basisVec (j m)) s _ (f m) x).re|
      ≤ V⁻¹ * ∫ x, ‖f m x‖ := by
        refine mul_le_mul_of_nonneg_left ?_ (inv_nonneg.mpr hV.le)
        refine (Complex.abs_re_le_norm _).trans ((norm_integral_le_integral_norm _).trans ?_)
        exact integral_mono_of_nonneg (.of_forall fun x => norm_nonneg _) hi.norm
          (.of_forall fun x => norm_fdiffIter_le_self _ s _ (hf1 m) x)
    _ ≤ V⁻¹ * V := mul_le_mul_of_nonneg_left hL1 (inv_nonneg.mpr hV.le)
    _ = 1 := inv_mul_cancel₀ hV.ne'

/-- **The terminal mean is the mean over the old shifts of the averaged raw cube.** -/
theorem hc_terminal_mean {N H C Cs : ℝ} (hN : 0 < N) (hH : 0 < H) (hCCs : C ≤ Cs) (hC : 0 < C)
    {m : ℕ} {f : ℕ → E3 → ℂ} {P : ℕ → Polynomial ℝ} {p : E3 → Polynomial ℝ} {j : ℕ → Fin 3}
    (hf : ∀ i, Measurable (f i)) (hf1 : ∀ i y, ‖f i y‖ ≤ 1)
    (hfs : ∀ i y, y ∉ petBox C N → f i y = 0)
    {seq : ℕ → NormalPETState r 3 ℕ m} {T : ℕ} :
    fejerMean H (4 + T + ((seq T).rest.length + 1))
        (hcLevel (volume (petBox Cs N)).toReal N C Cs m f P p j seq T
          (4 + T + ((seq T).rest.length + 1)))
      = ∫ o : Fin (4 + T) → ℝ, (∏ l, fejer H (o l)) * ∫ w : Fin ((seq T).rest.length + 1) → ℝ,
          (∏ l, fejer H (w l)) * hcTerm (volume (petBox Cs N)).toReal m f j (4 + T)
            ((seq T).rest.length + 1) (seq T) w o := by
  have hCs : 0 < Cs := by linarith
  have hV : 0 < (volume (petBox Cs N)).toReal := by
    rw [volume_petBox hCs.le hN.le, ENNReal.toReal_ofReal (by positivity)]; positivity
  have hvol : (volume (petBox C N)).toReal ≤ (volume (petBox Cs N)).toReal :=
    ENNReal.toReal_mono (volume_petBox_ne_top _ _) (measure_mono (petBox_mono hCCs hN.le))
  rw [fejerMean]
  rw [← integral_split_fejer hH (4 + T) ((seq T).rest.length + 1)
    (measurable_hcTerm _ hf j _ _ (seq T)) (abs_hcTerm_le hV hf hf1 hfs hvol j _ _ (seq T))]
  refine integral_congr_ae (.of_forall fun h => ?_)
  simp only
  rw [hcLevel_terminal hN]
  rfl

end

section
open Filter Topology MeasureTheory

/-! ### The sublevel exclusion at the old shifts

"By `patch:multiaffine-sublevel`, the union of all bad gap sets has probability at most `κ/4` ...
Hence there are old shifts outside the union with `F ≥ κ/2`." -/
theorem integrable_prod_fejer_one (n : ℕ) :
    Integrable (fun u : Fin n → ℝ => ∏ l, fejer 1 (u l)) := integrable_prod_fejer one_pos n

/-- **The product Fejer measure has the product Fejer density.** -/
theorem pi_fejerMeasure_eq (n : ℕ) :
    Measure.pi (fun _ : Fin n => fejerMeasure)
      = (volume : Measure (Fin n → ℝ)).withDensity
          (fun u => ENNReal.ofReal (∏ l, fejer 1 (u l))) := by
  refine Measure.pi_eq (μ := fun _ : Fin n => fejerMeasure) fun s hs => ?_
  rw [withDensity_apply _ (MeasurableSet.univ_pi hs)]
  have hint : IntegrableOn (fun u : Fin n → ℝ => ∏ l, fejer 1 (u l)) (Set.univ.pi s) :=
    (integrable_prod_fejer_one n).integrableOn
  rw [← ofReal_integral_eq_lintegral_ofReal hint
    (.of_forall fun u => prod_fejer_nonneg one_pos u)]
  rw [volume_pi, Measure.restrict_pi_pi,
    integral_fintype_prod_eq_prod (fun _ t => fejer 1 t),
    ENNReal.ofReal_prod_of_nonneg (fun l _ => setIntegral_nonneg (hs l)
      fun t _ => fejer_nonneg one_pos t)]
  refine Finset.prod_congr rfl fun l _ => ?_
  rw [fejerMeasure_apply (hs l), ofReal_integral_eq_lintegral_ofReal
    (integrable_fejer one_pos).integrableOn (.of_forall fun t => fejer_nonneg one_pos t)]

theorem pi_fejerMeasure_real (n : ℕ) {S : Set (Fin n → ℝ)} (hS : MeasurableSet S) :
    (Measure.pi (fun _ : Fin n => fejerMeasure)).real S
      = ∫ u, (∏ l, fejer 1 (u l)) * S.indicator (fun _ => (1 : ℝ)) u := by
  rw [Measure.real, pi_fejerMeasure_eq, withDensity_apply _ hS,
    ← ofReal_integral_eq_lintegral_ofReal (integrable_prod_fejer_one n).integrableOn
      (.of_forall fun u => prod_fejer_nonneg one_pos u),
    ENNReal.toReal_ofReal (setIntegral_nonneg hS fun u _ => prod_fejer_nonneg one_pos u),
    ← integral_indicator hS]
  refine integral_congr_ae (.of_forall fun u => ?_)
  by_cases hu : u ∈ S <;> simp [hu]

/-- **`patch:multiaffine-sublevel` for a nonzero multilinear integer polynomial of degree at most
two**, in the form `Pr{|p(u)| ≤ ε} ≤ 4 √ε`. -/
theorem mvPoly_sublevel_le {n : ℕ} {q : MvPolynomial (Fin (n + 1)) ℤ} (hq : q ≠ 0)
    (hml : ∀ i, q.degreeOf i ≤ 1) (hdeg : q.totalDegree ≤ 2) {ε : ℝ} (hε0 : 0 < ε) (hε1 : ε < 1) :
    (Measure.pi fun _ : Fin (n + 1) => fejerMeasure)
        {u : Fin (n + 1) → ℝ | |MvPolynomial.aeval u q| ≤ ε}
      ≤ ENNReal.ofReal (4 * Real.sqrt ε) := by
  classical
  have hset : {u : Fin (n + 1) → ℝ | |MvPolynomial.aeval u q| ≤ ε}
      = {u | |multiAff (q.coeff 0) (fun k => q.coeff (Finsupp.single k 1))
          (fun k l => if k < l then q.coeff (Finsupp.single k 1 + Finsupp.single l 1) else 0)
          u| ≤ ε} := by
    ext u; simp only [Set.mem_ofPred_eq, aeval_eq_multiAff hml hdeg]
  rw [hset]
  refine multiAff_sublevel_le _ _ _ (fun k l hkl => by simp [hkl]) ?_ hε0 hε1
  obtain ⟨d, hd⟩ := MvPolynomial.ne_zero_iff.mp hq
  have hds : d ∈ q.support := MvPolynomial.mem_support_iff.mpr hd
  rcases multilinear_support_cases hml hdeg hds with rfl | ⟨k, rfl⟩ | ⟨k, l, hkl, rfl⟩
  · exact Or.inl hd
  · exact Or.inr (Or.inl ⟨k, hd⟩)
  · refine Or.inr (Or.inr ?_)
    rcases lt_or_gt_of_ne hkl with h | h
    · exact ⟨k, l, by simp [h, hd]⟩
    · exact ⟨l, k, by simp [h, add_comm, hd]⟩

/-- **Scaling the old shifts to unit radius.** -/
theorem integral_prod_fejer_indicator_scale {n : ℕ} {H : ℝ} (hH : 0 < H)
    {S : Set (Fin n → ℝ)} (hS : MeasurableSet S) :
    (∫ o : Fin n → ℝ, (∏ l, fejer H (o l)) * S.indicator (fun _ => (1 : ℝ)) o)
      = ∫ u : Fin n → ℝ, (∏ l, fejer 1 (u l))
          * S.indicator (fun _ => (1 : ℝ)) (fun l => H * u l) := by
  have hG : AEStronglyMeasurable (fun z : Fin n → ℝ =>
      ((∏ l : Fin n, fejer ((fun _ => H) l * 1) (z l) : ℝ) : ℂ)
        * ((S.indicator (fun _ => (1 : ℝ)) z : ℝ) : ℂ)) volume :=
    ((measurable_prod_fejer n).complex_ofReal.mul
      ((measurable_const.indicator hS).complex_ofReal)).aestronglyMeasurable
  have key := integral_prod_fejer_mul_comp_diag (H := 1) (c := fun _ : Fin n => H)
    (fun _ => hH) (G := fun z => ((S.indicator (fun _ => (1 : ℝ)) z : ℝ) : ℂ)) hG
  simp only [mul_one, ← Complex.ofReal_mul] at key
  rw [integral_complex_ofReal, integral_complex_ofReal, Complex.ofReal_inj] at key
  exact key.symm

theorem measurableSet_abs_aeval_le {n : ℕ} (q : MvPolynomial (Fin n) ℤ) (c : ℝ) :
    MeasurableSet {o : Fin n → ℝ | |MvPolynomial.aeval o q| ≤ c} := by
  have : Continuous fun o : Fin n → ℝ => MvPolynomial.aeval o q := by
    have h : (fun o : Fin n → ℝ => MvPolynomial.aeval o q)
        = fun o => MvPolynomial.eval o (q.map (Int.castRingHom ℝ)) := by
      funext o; rw [MvPolynomial.aeval_def, MvPolynomial.eval_map, algebraMap_int_eq]
    rw [h]; exact continuous_mvEval _
  exact measurableSet_le this.abs.measurable measurable_const

/-- **One bad gap set is small** (`patch:multiaffine-sublevel` after scaling by `H`). -/
theorem integral_bad_le {n : ℕ} {H ε : ℝ} (hH : 0 < H) (hε0 : 0 < ε) (hε1 : ε < 1)
    {q : MvPolynomial (Fin (n + 1)) ℤ} (hq : q ≠ 0) (hml : ∀ i, q.degreeOf i ≤ 1)
    (hdeg : q.totalDegree ≤ 2) {d : ℕ} (hhom : q.IsHomogeneous d) :
    (∫ o : Fin (n + 1) → ℝ, (∏ l, fejer H (o l))
        * {o | |MvPolynomial.aeval o q| ≤ ε * H ^ d}.indicator (fun _ => (1 : ℝ)) o)
      ≤ 4 * Real.sqrt ε := by
  have hHd : 0 < H ^ d := pow_pos hH d
  rw [integral_prod_fejer_indicator_scale hH (measurableSet_abs_aeval_le q _)]
  have hset : ∀ u : Fin (n + 1) → ℝ,
      {o : Fin (n + 1) → ℝ | |MvPolynomial.aeval o q| ≤ ε * H ^ d}.indicator (fun _ => (1 : ℝ))
        (fun l => H * u l)
      = {u : Fin (n + 1) → ℝ | |MvPolynomial.aeval u q| ≤ ε}.indicator (fun _ => (1 : ℝ)) u := by
    intro u
    have hiff : |MvPolynomial.aeval (fun l => H * u l) q| ≤ ε * H ^ d
        ↔ |MvPolynomial.aeval u q| ≤ ε := by
      rw [aeval_smul_of_isHomogeneous hhom, abs_mul, abs_of_pos hHd, mul_comm ε]
      exact mul_le_mul_iff_of_pos_left hHd
    by_cases hu : |MvPolynomial.aeval u q| ≤ ε
    · rw [Set.indicator_of_mem (show (fun l => H * u l) ∈ _ from hiff.mpr hu),
        Set.indicator_of_mem (show u ∈ _ from hu)]
    · rw [Set.indicator_of_notMem (show (fun l => H * u l) ∉ {o : Fin (n + 1) → ℝ |
          |MvPolynomial.aeval o q| ≤ ε * H ^ d} from fun h => hu (hiff.mp h)),
        Set.indicator_of_notMem (show u ∉ {u : Fin (n + 1) → ℝ | |MvPolynomial.aeval u q| ≤ ε}
          from hu)]
  simp_rw [hset]
  rw [← pi_fejerMeasure_real _ (measurableSet_abs_aeval_le q ε)]
  have h := mvPoly_sublevel_le hq hml hdeg hε0 hε1
  rw [Measure.real]
  have hfin : (Measure.pi fun _ : Fin (n + 1) => fejerMeasure)
      {u : Fin (n + 1) → ℝ | |MvPolynomial.aeval u q| ≤ ε} ≠ ⊤ := measure_ne_top _ _
  calc ((Measure.pi fun _ : Fin (n + 1) => fejerMeasure)
        {u : Fin (n + 1) → ℝ | |MvPolynomial.aeval u q| ≤ ε}).toReal
      ≤ (ENNReal.ofReal (4 * Real.sqrt ε)).toReal := ENNReal.toReal_mono ENNReal.ofReal_ne_top h
    _ = 4 * Real.sqrt ε := ENNReal.toReal_ofReal (by positivity)

/-- **The sublevel exclusion**: given a mean at least `κ` of a one-bounded function against the
product Fejer density, and nonzero multilinear homogeneous integer polynomials of degree at most
two, with `s · 4 √ε ≤ κ/4`, some point of the support has every polynomial outside its sublevel
set and the function at least `κ/2`. -/
theorem exists_good_old {n s : ℕ} {H κ ε : ℝ} (hH : 0 < H) (hκ : 0 < κ) (hε0 : 0 < ε)
    (hε1 : ε < 1) {q : Fin s → MvPolynomial (Fin (n + 1)) ℤ} {d : Fin s → ℕ}
    (hq : ∀ ν, q ν ≠ 0) (hml : ∀ ν i, (q ν).degreeOf i ≤ 1) (hdeg : ∀ ν, (q ν).totalDegree ≤ 2)
    (hhom : ∀ ν, (q ν).IsHomogeneous (d ν)) (hsε : s * (4 * Real.sqrt ε) ≤ κ / 4)
    {F : (Fin (n + 1) → ℝ) → ℝ} (hFm : Measurable F) (hF1 : ∀ o, |F o| ≤ 1)
    (hmean : κ ≤ ∫ o : Fin (n + 1) → ℝ, (∏ l, fejer H (o l)) * F o) :
    ∃ o : Fin (n + 1) → ℝ, 0 < ∏ l, fejer H (o l)
      ∧ (∀ ν, ε * H ^ d ν < |MvPolynomial.aeval o (q ν)|) ∧ κ / 2 ≤ F o := by
  classical
  set w : (Fin (n + 1) → ℝ) → ℝ := fun o => ∏ l, fejer H (o l) with hw
  set B : Set (Fin (n + 1) → ℝ) :=
    ⋃ ν, {o | |MvPolynomial.aeval o (q ν)| ≤ ε * H ^ d ν} with hB
  have hBm : MeasurableSet B := MeasurableSet.iUnion fun ν => measurableSet_abs_aeval_le _ _
  have hwi : Integrable w := integrable_prod_fejer hH _
  have hw0 : ∀ o, 0 ≤ w o := fun o => prod_fejer_nonneg hH o
  have hind : ∀ (S : Set (Fin (n + 1) → ℝ)), MeasurableSet S →
      Integrable fun o => w o * S.indicator (fun _ => (1 : ℝ)) o := fun S hS =>
    hwi.mul_bdd ((measurable_const.indicator hS).aestronglyMeasurable)
      (.of_forall fun o => (show ‖S.indicator (fun _ => (1 : ℝ)) o‖ ≤ 1 by
        by_cases h : o ∈ S <;> simp [h]))
  -- the bad union is small
  have hBsmall : (∫ o, w o * B.indicator (fun _ => (1 : ℝ)) o) ≤ κ / 4 := by
    have hle : ∀ o, w o * B.indicator (fun _ => (1 : ℝ)) o ≤ ∑ ν, w o
        * {o | |MvPolynomial.aeval o (q ν)| ≤ ε * H ^ d ν}.indicator (fun _ => (1 : ℝ)) o := by
      intro o
      rw [← Finset.mul_sum]
      refine mul_le_mul_of_nonneg_left ?_ (hw0 o)
      by_cases ho : o ∈ B
      · rw [Set.indicator_of_mem ho]
        obtain ⟨ν, hν⟩ := Set.mem_iUnion.mp ho
        calc (1 : ℝ) = {o | |MvPolynomial.aeval o (q ν)| ≤ ε * H ^ d ν}.indicator
              (fun _ => (1 : ℝ)) o := by rw [Set.indicator_of_mem hν]
          _ ≤ _ := Finset.single_le_sum (f := fun ν => {o | |MvPolynomial.aeval o (q ν)|
                ≤ ε * H ^ d ν}.indicator (fun _ => (1 : ℝ)) o)
              (fun ν _ => Set.indicator_nonneg (fun _ _ => zero_le_one) _) (Finset.mem_univ ν)
      · rw [Set.indicator_of_notMem ho]
        exact Finset.sum_nonneg fun ν _ => Set.indicator_nonneg (fun _ _ => zero_le_one) _
    calc (∫ o, w o * B.indicator (fun _ => (1 : ℝ)) o)
        ≤ ∫ o, ∑ ν, w o
            * {o | |MvPolynomial.aeval o (q ν)| ≤ ε * H ^ d ν}.indicator (fun _ => (1 : ℝ)) o :=
          integral_mono (hind B hBm)
            (integrable_finsetSum _ fun ν _ => hind _ (measurableSet_abs_aeval_le _ _)) hle
      _ = ∑ ν, ∫ o, w o
            * {o | |MvPolynomial.aeval o (q ν)| ≤ ε * H ^ d ν}.indicator (fun _ => (1 : ℝ)) o :=
          integral_finsetSum _ fun ν _ => hind _ (measurableSet_abs_aeval_le _ _)
      _ ≤ ∑ _ν : Fin s, 4 * Real.sqrt ε := Finset.sum_le_sum fun ν _ =>
          integral_bad_le hH hε0 hε1 (hq ν) (hml ν) (hdeg ν) (hhom ν)
      _ = s * (4 * Real.sqrt ε) := by simp
      _ ≤ κ / 4 := hsε
  by_contra hno
  push Not at hno
  have hpt : ∀ o, w o * F o ≤ w o * B.indicator (fun _ => (1 : ℝ)) o + κ / 2 * w o := by
    intro o
    by_cases hwo : w o = 0
    · rw [hwo]; simp
    have hpos : 0 < w o := lt_of_le_of_ne (hw0 o) (Ne.symm hwo)
    by_cases ho : o ∈ B
    · rw [Set.indicator_of_mem ho, mul_one]
      have := (abs_le.mp (hF1 o)).2
      nlinarith
    · rw [Set.indicator_of_notMem ho, mul_zero, zero_add]
      have hgood : ∀ ν, ε * H ^ d ν < |MvPolynomial.aeval o (q ν)| := by
        intro ν
        by_contra hc
        push Not at hc
        exact ho (Set.mem_iUnion.mpr ⟨ν, hc⟩)
      have := hno o hpos hgood
      nlinarith
  have hFi : Integrable fun o => w o * F o :=
    hwi.mul_bdd hFm.aestronglyMeasurable (.of_forall fun o => by rw [Real.norm_eq_abs]; exact hF1 o)
  have hint : (∫ o, w o * F o)
      ≤ ∫ o, (w o * B.indicator (fun _ => (1 : ℝ)) o + κ / 2 * w o) :=
    integral_mono hFi ((hind B hBm).add (hwi.const_mul (κ / 2))) hpt
  rw [integral_add (hind B hBm) (hwi.const_mul (κ / 2)), integral_const_mul,
    integral_prod_fejer hH] at hint
  linarith

end

section
open Filter Topology MeasureTheory

variable {r : ℕ}

/-- **A polynomial in the first `K` shift variables, read in the chain's own coordinates.** -/
theorem exists_reverse_poly {K : ℕ} (hK : K ≤ r) {p : MvPolynomial (Fin r) ℤ}
    (hp : ∀ v ∈ p.vars, v.val < K) :
    ∃ q : MvPolynomial (Fin K) ℤ,
      (∀ o : Fin K → ℝ, MvPolynomial.aeval o q = MvPolynomial.aeval (petShiftVec K o) p)
      ∧ (p ≠ 0 → q ≠ 0) ∧ (∀ d, p.IsHomogeneous d → q.IsHomogeneous d)
      ∧ ((∀ i, p.degreeOf i ≤ 1) → ∀ i, q.degreeOf i ≤ 1) := by
  let ι : Fin K → Fin r := fun i => ⟨K - 1 - i.val, by omega⟩
  have hinj : Function.Injective ι := by
    intro a b hab
    have := congrArg Fin.val hab
    simp only [ι] at this
    exact Fin.ext (by omega)
  have hrange : (p.vars : Set (Fin r)) ⊆ Set.range ι := by
    intro v hv
    have hvK := hp v hv
    exact ⟨⟨K - 1 - v.val, by omega⟩, Fin.ext (by simp [ι]; omega)⟩
  obtain ⟨q, rfl⟩ := MvPolynomial.exists_rename_eq_of_vars_subset_range p ι hinj hrange
  refine ⟨q, fun o => ?_, fun h hq => h (by rw [hq, map_zero]), fun d hd => ?_, fun hml i => ?_⟩
  · rw [MvPolynomial.aeval_rename]
    have hfun : (petShiftVec K o ∘ ι) = o := by
      funext i
      simp only [Function.comp, petShiftVec, ι]
      rw [dite_eq_left (by omega)]
      congr 1
      ext; simp; omega
    rw [hfun]
  · exact (MvPolynomial.IsHomogeneous.rename_isHomogeneous_iff hinj).mp hd
  · have := hml (ι i)
    rwa [MvPolynomial.degreeOf_rename_of_injective hinj] at this

variable {ι : Type*} {f : ι}

theorem linState_sub_natDegree {S : NormalPETState r 3 ι f} (hlin : S.headPoly.natDegree ≤ 1)
    {it : Polynomial (Fin 3 → MvPolynomial (Fin r) ℝ) × List (PetFactor r 3 ι)}
    (hit : it ∈ S.rest) : (S.headPoly - it.1).natDegree = 1 := by
  have hdeg : it.1.natDegree ≤ 1 := (S.head_max it hit).trans hlin
  have hne : S.headPoly - it.1 ≠ 0 := sub_ne_zero.mpr (S.rest_ne_head it hit).symm
  have h0 : (S.headPoly - it.1).coeff 0 = 0 := by
    rw [Polynomial.coeff_sub, S.headPoly_vanish, S.rest_vanish it hit, sub_zero]
  exact le_antisymm ((Polynomial.natDegree_sub_le _ _).trans (max_le hlin hdeg))
    (one_le_natDegree_of_coeff_zero hne h0)

theorem linState_head_natDegree {S : NormalPETState r 3 ι f} (hlin : S.headPoly.natDegree ≤ 1) :
    S.headPoly.natDegree = 1 :=
  le_antisymm hlin (one_le_natDegree_of_coeff_zero S.headPoly_ne_zero S.headPoly_vanish)

/-- **The gaps at the linear state are `a q_ν(o)`** with `q_ν` a nonzero multilinear homogeneous
integer polynomial of degree `D - 1` in the chain's `K` shifts, bounded by the witness bound on
the unit cube. -/
theorem linState_gap_witness {a : ℝ} (ha : a ≠ 0) {m : Fin 3} {D K : ℕ} {B : ℝ}
    {S : NormalPETState r 3 ι f} (hinv : PetRunInv a m D K S) (hbd : PetRunBd a m B S)
    (hlin : S.headPoly.natDegree ≤ 1) (hK : K ≤ r) {ν : ℕ} (hν : ν ≤ S.rest.length) :
    ∃ q : MvPolynomial (Fin K) ℤ, q ≠ 0 ∧ q.IsHomogeneous (D - 1) ∧ (∀ i, q.degreeOf i ≤ 1)
      ∧ EvalBd B q ∧ ∀ o : Fin K → ℝ,
        hcGap (petShiftVec K o) m S ν = a * MvPolynomial.aeval o q := by
  have hh1 := linState_head_natDegree hlin
  -- the witness in the shift ring
  obtain ⟨p, hp0, hphom, hpml, hlc, hpB, hgap⟩ : ∃ p : MvPolynomial (Fin r) ℤ, p ≠ 0
      ∧ p.IsHomogeneous (D - 1) ∧ (∀ i, p.degreeOf i ≤ 1)
      ∧ (∀ v ∈ p.vars, v.val < K) ∧ EvalBd B p
      ∧ ∀ η : Fin r → ℝ, hcGap η m S ν = a * MvPolynomial.aeval η p := by
    by_cases hν0 : S.rest.length - ν = 0
    · obtain ⟨p, hp0, hph, hpml, hlc⟩ := hinv.1
      refine ⟨p, hp0, by rwa [hh1] at hph, hpml, ?_, hbd.1 p hlc, fun η => ?_⟩
      · refine vars_lt_of_lead ha ?_ hlc
        have := hinv.2.2.1 1 m
        rwa [Polynomial.leadingCoeff, hh1]
      · rw [hcGap, hν0]
        simp only [linSlopes]
        rw [ite_eq_right (by omega), ite_eq_right (by omega), ite_eq_left trivial, sub_zero,
          linState_headSlope hlin hlc]
    · set it := S.rest.getD (S.rest.length - ν - 1) (0, []) with hitdef
      have hit : it ∈ S.rest := getD_mem_of_lt _ (by omega)
      obtain ⟨p, hp0, hph, hpml, hlc⟩ := hinv.2.1 it hit
      have hd1 := linState_sub_natDegree hlin hit
      refine ⟨p, hp0, by rwa [hd1] at hph, hpml, ?_, hbd.2 it hit p hlc, fun η => ?_⟩
      · refine vars_lt_of_lead ha ?_ hlc
        have := (hinv.2.2.1.sub (hinv.2.2.2.1 it hit)) 1 m
        rwa [Polynomial.leadingCoeff, hd1]
      · rw [hcGap, ← linState_gap hlin hit hlc η]
        simp only [linSlopes]
        rw [ite_eq_right (by omega), ite_eq_right (by omega), ite_eq_right hν0, ite_eq_left
          (by omega)]
  obtain ⟨q, hqev, hq0, hqhom, hqml⟩ := exists_reverse_poly hK hlc
  refine ⟨q, hq0 hp0, hqhom _ hphom, hqml hpml, fun u hu => ?_, fun o => by rw [hgap, hqev]⟩
  rw [hqev]
  exact hpB _ fun v => by
    unfold petShiftVec
    split_ifs
    · exact hu _
    · simp

theorem fejer_pos_lt {H t : ℝ} (hH : 0 < H) (h : 0 < fejer H t) : |t| < H := by
  by_contra hc
  push Not at hc
  rw [fejer_eq_zero_of_le hH hc] at h
  exact lt_irrefl _ h

theorem prod_fejer_pos_lt {H : ℝ} (hH : 0 < H) {n : ℕ} {o : Fin n → ℝ}
    (h : 0 < ∏ l, fejer H (o l)) (l : Fin n) : |o l| < H := by
  refine fejer_pos_lt hH ?_
  rcases (fejer_nonneg hH (o l)).lt_or_eq with h1 | h1
  · exact h1
  · rw [Finset.prod_eq_zero (Finset.mem_univ l) h1.symm] at h
    exact absurd h (lt_irrefl _)

/-- **The sublevel exclusion and the physical radii at the linear state** (blueprint: "Hence
there are old shifts outside the union with `F ≥ κ/2` ... At those shifts
`|a| H^{D-1} ε ≤ |a p_i(h)| ≤ |a| H^{D-1} M_1`"). -/
theorem hc_good_old {a : ℝ} (ha : a ≠ 0) {m : Fin 3} {D K : ℕ} {B H κ ε : ℝ}
    {S : NormalPETState r 3 ι f} (hinv : PetRunInv a m D K S) (hbd : PetRunBd a m B S)
    (hlin : S.headPoly.natDegree ≤ 1) (hK : 1 ≤ K) (hKr : K ≤ r) (hD3 : D ≤ 3)
    (hH : 0 < H) (hκ : 0 < κ) (hε0 : 0 < ε) (hε1 : ε < 1)
    (hsε : ((S.rest.length + 1 : ℕ) : ℝ) * (4 * Real.sqrt ε) ≤ κ / 4)
    {F : (Fin K → ℝ) → ℝ} (hFm : Measurable F) (hF1 : ∀ o, |F o| ≤ 1)
    (hmean : κ ≤ ∫ o : Fin K → ℝ, (∏ l, fejer H (o l)) * F o) :
    ∃ o : Fin K → ℝ, (∀ l, |o l| < H)
      ∧ (∀ ν ≤ S.rest.length, |a| * ε * H ^ (D - 1) < |hcGap (petShiftVec K o) m S ν|
          ∧ |hcGap (petShiftVec K o) m S ν| ≤ |a| * B * H ^ (D - 1))
      ∧ κ / 2 ≤ F o := by
  obtain ⟨n, rfl⟩ : ∃ n, K = n + 1 := ⟨K - 1, by omega⟩
  choose q hq0 hqhom hqml hqB hqgap using fun ν : Fin (S.rest.length + 1) =>
    linState_gap_witness ha hinv hbd hlin hKr (ν := ν.val) (by omega)
  have hqdeg : ∀ ν, (q ν).totalDegree ≤ 2 := fun ν => by
    rw [(hqhom ν).totalDegree (hq0 ν)]; omega
  obtain ⟨o, hopos, hogap, hoF⟩ := exists_good_old (s := S.rest.length + 1) hH hκ hε0 hε1
    hq0 hqml hqdeg hqhom hsε hFm hF1 hmean
  have hol := prod_fejer_pos_lt hH hopos
  refine ⟨o, hol, fun ν hν => ?_, hoF⟩
  have hg := hqgap ⟨ν, by omega⟩ o
  simp only at hg
  rw [hg, abs_mul]
  have hlow := hogap ⟨ν, by omega⟩
  have hHd : 0 < H ^ (D - 1) := pow_pos hH _
  refine ⟨by rw [mul_assoc]; exact mul_lt_mul_of_pos_left hlow (abs_pos.mpr ha), ?_⟩
  -- the upper bound from the witness bound on the unit cube
  have hu : ∀ l, |o l / H| ≤ 1 := fun l => by
    rw [abs_div, abs_of_pos hH, div_le_one hH]; exact (hol l).le
  have hsc : MvPolynomial.aeval o (q ⟨ν, by omega⟩)
      = H ^ (D - 1) * MvPolynomial.aeval (fun l => o l / H) (q ⟨ν, by omega⟩) := by
    rw [← aeval_smul_of_isHomogeneous (hqhom _)]
    have : (fun l => H * (o l / H)) = o := by funext l; field_simp
    rw [this]
  rw [hsc, abs_mul, abs_of_pos hHd, mul_assoc |a|]
  refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg a)
  rw [mul_comm]
  exact mul_le_mul_of_nonneg_right (hqB _ _ hu) hHd.le

end

section
open Filter Topology MeasureTheory

/-! ### Sign symmetry of the Fejer density and the change to positive gaps -/
theorem fejer_mul_sign {H t σ : ℝ} (hσ : |σ| = 1) : fejer H (σ * t) = fejer H t := by
  simp [fejer, abs_mul, hσ]

/-- The coordinatewise sign flip. -/
def signFlip {s : ℕ} (σ : Fin s → ℝ) (hσ : ∀ l, σ l * σ l = 1) :
    (Fin s → ℝ) ≃ᵐ (Fin s → ℝ) where
  toFun w l := σ l * w l
  invFun w l := σ l * w l
  left_inv w := funext fun l => by simp only; rw [← mul_assoc, hσ l, one_mul]
  right_inv w := funext fun l => by simp only; rw [← mul_assoc, hσ l, one_mul]
  measurable_toFun := Measurable.of_eval fun l => (measurable_pi_apply l).const_mul _
  measurable_invFun := Measurable.of_eval fun l => (measurable_pi_apply l).const_mul _

theorem measurePreserving_signFlip {s : ℕ} (σ : Fin s → ℝ) (hσ : ∀ l, σ l * σ l = 1) :
    MeasurePreserving (signFlip σ hσ) := by
  have habs : ∀ l, |σ l| = 1 := fun l => by
    have h := hσ l
    have : |σ l| * |σ l| = 1 := by rw [← abs_mul, h, abs_one]
    nlinarith [abs_nonneg (σ l)]
  have h1 : ∀ l, MeasurePreserving (fun x : ℝ => σ l * x) := fun l => by
    refine ⟨measurable_const.mul measurable_id, ?_⟩
    have hne : σ l ≠ 0 := fun h0 => by have := habs l; rw [h0, abs_zero] at this; norm_num at this
    rw [Real.map_volume_mul_left hne, abs_inv, habs l, inv_one, ENNReal.ofReal_one, one_smul]
  have := measurePreserving_pi (fun _ : Fin s => (volume : Measure ℝ))
    (fun _ : Fin s => (volume : Measure ℝ)) h1
  rw [← volume_pi] at this
  exact this

/-- **The Fejer average is invariant under flipping the signs of the increments.** -/
theorem integral_fejer_signFlip {s : ℕ} {H : ℝ} (σ : Fin s → ℝ) (hσ : ∀ l, σ l * σ l = 1)
    (G : (Fin s → ℝ) → ℂ) :
    (∫ w : Fin s → ℝ, G (fun l => σ l * w l) * ∏ l, ((fejer H (w l) : ℝ) : ℂ))
      = ∫ w : Fin s → ℝ, G w * ∏ l, ((fejer H (w l) : ℝ) : ℂ) := by
  have habs : ∀ l, |σ l| = 1 := fun l => by
    have h := hσ l
    have : |σ l| * |σ l| = 1 := by rw [← abs_mul, h, abs_one]
    nlinarith [abs_nonneg (σ l)]
  have key := (measurePreserving_signFlip σ hσ).integral_comp (signFlip σ hσ).measurableEmbedding
    (fun w => G w * ∏ l, ((fejer H (w l) : ℝ) : ℂ))
  rw [← key]
  refine integral_congr_ae (.of_forall fun w => ?_)
  simp only [signFlip, MeasurableEquiv.coe_mk, Equiv.coe_fn_mk]
  congr 1
  refine Finset.prod_congr rfl fun l _ => ?_
  rw [fejer_mul_sign (habs l)]

theorem measurable_fdiffIter_joint (v : E3) (s : ℕ) {F : E3 → ℂ} (hF : Measurable F) :
    Measurable fun q : (Fin s → ℝ) × E3 => fdiffIter v s q.1 F q.2 := by
  have h := measurable_fdiffIter_param (Θ := Unit) v s (g := fun _ => F) (hF.comp measurable_snd)
  have hc : Measurable ((fun q : Unit × (Fin s → ℝ) × E3 => fdiffIter v s q.2.1 F q.2.2) ∘
      fun q : (Fin s → ℝ) × E3 => (((), q.1, q.2) : Unit × (Fin s → ℝ) × E3)) :=
    h.comp (measurable_const.prodMk (measurable_fst.prodMk measurable_snd))
  exact hc

variable {r : ℕ}

/-- **The averaged raw cube at nonzero gaps, in the form of `patch:uniformize`**: flipping the
signs of the increments makes all gaps positive. -/
theorem fejer_mean_hcTerm_eq {V N H : ℝ} (hN : 0 < N) (hH : 0 < H) {m : ℕ} {f : ℕ → E3 → ℂ}
    (hfm : Measurable (f m)) (hfi : Integrable (f m)) (hf1 : ∀ y, ‖f m y‖ ≤ 1)
    (j : ℕ → Fin 3) {K s : ℕ} (S : NormalPETState r 3 ℕ m) (o : Fin K → ℝ)
    (hg : ∀ ν : Fin s, hcGap (petShiftVec K o) (j m) S ν.val ≠ 0) :
    (∫ w : Fin s → ℝ, (∏ l, fejer H (w l)) * hcTerm V m f j K s S w o)
      = V⁻¹ * N ^ (6 : ℕ) * ((((N ^ (6 : ℕ))⁻¹ : ℂ) * ∫ x : E3, ∫ w : Fin s → ℝ,
          fdiffIter (basisVec (j m)) s
            (fun i => |hcGap (petShiftVec K o) (j m) S i.val| * w i) (f m) x
            * ∏ l, ((fejer H (w l) : ℝ) : ℂ)).re) := by
  set g : Fin s → ℝ := fun ν => hcGap (petShiftVec K o) (j m) S ν.val with hgdef
  set v := basisVec (j m)
  have hjm := measurable_fdiffIter_joint v s hfm
  -- the integrand on the product
  set Φ : (Fin s → ℝ) × E3 → ℂ := fun q =>
    ((∏ l, fejer H (q.1 l) : ℝ) : ℂ) * fdiffIter v s (fun i => g i * q.1 i) (f m) q.2 with hΦ
  have hΦm : Measurable Φ := by
    have h1 : Measurable fun q : (Fin s → ℝ) × E3 =>
        fdiffIter v s (fun i => g i * q.1 i) (f m) q.2 :=
      hjm.comp ((Measurable.of_eval fun i =>
        ((measurable_pi_apply i).comp measurable_fst).const_mul _).prodMk measurable_snd)
    exact ((measurable_prod_fejer s).comp measurable_fst).complex_ofReal.mul h1
  have hΦi : Integrable Φ ((volume : Measure (Fin s → ℝ)).prod (volume : Measure E3)) := by
    refine Integrable.mono' ((integrable_prod_fejer hH s).mul_prod hfi.norm)
      hΦm.aestronglyMeasurable (.of_forall fun q => ?_)
    simp only [hΦ, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (prod_fejer_nonneg hH q.1)]
    exact mul_le_mul_of_nonneg_left (norm_fdiffIter_le_self v s _ hf1 q.2)
      (prod_fejer_nonneg hH q.1)
  -- pull the real part out of the average over the shifts
  have hZ : ∀ w : Fin s → ℝ, (∏ l, fejer H (w l)) * hcTerm V m f j K s S w o
      = V⁻¹ * (∫ x : E3, Φ (w, x)).re := by
    intro w
    simp only [hΦ, hcTerm]
    rw [integral_const_mul, Complex.re_ofReal_mul]
    ring
  simp_rw [hZ]
  rw [integral_const_mul, integral_re_of_integrable hΦi.integral_prod_left,
    integral_integral_swap hΦi]
  -- flip the signs inside
  have hσ : ∀ l, (g l / |g l|) * (g l / |g l|) = 1 := fun l => by
    have h0 : |g l| ≠ 0 := abs_ne_zero.mpr (hg l)
    rw [div_mul_div_comm, ← abs_mul_abs_self (g l), div_self (mul_ne_zero h0 h0)]
  have hflip : ∀ x : E3, (∫ w : Fin s → ℝ, Φ (w, x))
      = ∫ w : Fin s → ℝ, fdiffIter v s (fun i => |g i| * w i) (f m) x
          * ∏ l, ((fejer H (w l) : ℝ) : ℂ) := by
    intro x
    have key := integral_fejer_signFlip (H := H) (fun l => g l / |g l|) hσ
      (fun w => fdiffIter v s (fun i => |g i| * w i) (f m) x)
    rw [← key]
    refine integral_congr_ae (.of_forall fun w => ?_)
    simp only [hΦ, Complex.ofReal_prod]
    rw [mul_comm]
    congr 3
    funext i
    have h0 : |g i| ≠ 0 := abs_ne_zero.mpr (hg i)
    field_simp
  simp_rw [hflip]
  have hN6 : (N ^ (6 : ℕ) : ℝ) ≠ 0 := by positivity
  rw [show ((N ^ (6 : ℕ))⁻¹ : ℂ) = (((N ^ (6 : ℕ))⁻¹ : ℝ) : ℂ) by push_cast; ring,
    Complex.re_ofReal_mul]
  field_simp
  rfl

/-- **`patch:uniformize` at the good old shifts**: the averaged raw cube at nonzero gaps is
controlled by the single-radius uniformity power at order `s + 1`. -/
theorem sq_fejer_mean_hcTerm_le {V N H C' L : ℝ} (hN : 0 < N) (hH : 0 < H) (hL : 0 < L)
    (hC' : 0 ≤ C') {m : ℕ} {f : ℕ → E3 → ℂ} (hfm : Nice (f m)) (hf1 : ∀ y, ‖f m y‖ ≤ 1)
    (hsupp : ∀ y, y ∉ petBox C' N → f m y = 0) (j : ℕ → Fin 3)
    (hLS : L ≤ 2 * (C' * N ^ expo (j m))) {K s : ℕ} (S : NormalPETState r 3 ℕ m)
    (o : Fin K → ℝ) (hg : ∀ ν : Fin s, hcGap (petShiftVec K o) (j m) S ν.val ≠ 0)
    (hhalf : ∀ ν : Fin s, |hcGap (petShiftVec K o) (j m) S ν.val| * H ≤ L / 2) :
    (∫ w : Fin s → ℝ, (∏ l, fejer H (w l)) * hcTerm V m f j K s S w o) ^ 2
      ≤ (V⁻¹ * N ^ (6 : ℕ)) ^ 2 * (16 * C' ^ 3 * ((∏ ν : Fin s,
          2 * L / (|hcGap (petShiftVec K o) (j m) S ν.val| * H))
          * (locUnifPow N L (j m) (s + 1) (f m)).re)) := by
  rw [fejer_mean_hcTerm_eq hN hH hfm.continuous.measurable hfm.integrable hf1 j S o hg, mul_pow]
  refine mul_le_mul_of_nonneg_left ?_ (sq_nonneg _)
  have hc : ∀ ν : Fin s, 0 < |hcGap (petShiftVec K o) (j m) S ν.val| := fun ν =>
    abs_pos.mpr (hg ν)
  refine sq_re_gapScaled_le_locUnifPow hL hC' hN (j m) hLS hc hH hhalf hfm hf1 hsupp ?_
  intro x
  have h1 : Measurable fun z : Fin s → ℝ =>
      ∏ l : Fin s, fejer (|hcGap (petShiftVec K o) (j m) S l.val| * H) (z l) :=
    Finset.measurable_prod _ fun l _ => continuous_fejer.measurable.comp (measurable_pi_apply l)
  have h2 : Measurable fun z : Fin s → ℝ => fdiffIter (basisVec (j m)) s z (f m) x :=
    (measurable_fdiffIter_joint (basisVec (j m)) s hfm.continuous.measurable).comp
      (measurable_id.prodMk measurable_const)
  exact (h1.complex_ofReal.mul h2).aestronglyMeasurable

end

section
open Filter Topology MeasureTheory

/-! ### Budget bookkeeping for `patch:highest-control` -/

/-- An admissible polynomial on `|t| ≤ ρ N` is at most `(d + 1) u_c(δ) ρ^d N^d`. -/
theorem AdmissiblePoly.abs_eval_le_scaled {c : ℕ} {δ N : ℝ} {d : ℕ} {P : Polynomial ℝ}
    (h : AdmissiblePoly c δ N d P) (hδ : 0 < δ) (hc : 1 ≤ c) (hN : 0 ≤ N) {ρ : ℝ} (hρ : 1 ≤ ρ)
    {t : ℝ} (ht : |t| ≤ ρ * N) :
    |P.eval t| ≤ (d + 1) * budHi c δ * ρ ^ d * N ^ d := by
  have hdeg := h.natDegree_eq
  have hbud : 0 < budHi c δ := budHi_pos hδ hc
  have hρ0 : 0 ≤ ρ := by linarith
  have htr : ∀ r : ℕ, r ≤ d → |t| ^ r ≤ ρ ^ d * N ^ r := by
    intro r hr
    calc |t| ^ r ≤ (ρ * N) ^ r := pow_le_pow_left₀ (abs_nonneg t) ht r
      _ = ρ ^ r * N ^ r := mul_pow _ _ _
      _ ≤ ρ ^ d * N ^ r := mul_le_mul_of_nonneg_right (pow_le_pow_right₀ hρ hr) (by positivity)
  have hterm : ∀ r ∈ Finset.range (d + 1), |P.coeff r * t ^ r| ≤ budHi c δ * ρ ^ d * N ^ d := by
    intro r hr
    rw [abs_mul, abs_pow]
    have hrd : r ≤ d := Nat.lt_succ_iff.mp (Finset.mem_range.mp hr)
    rcases lt_or_eq_of_le hrd with hlt | heq
    · have hcf := h.coeff_le hlt
      calc |P.coeff r| * |t| ^ r ≤ (budHi c δ * N ^ (d - r)) * (ρ ^ d * N ^ r) :=
            mul_le_mul hcf (htr r hrd) (by positivity) (by positivity)
        _ = budHi c δ * ρ ^ d * N ^ d := by
            rw [show d = (d - r) + r from by omega, pow_add]
            rw [show d - r + r - r = d - r by omega]
            ring
    · have hcf : |P.coeff r| ≤ budHi c δ := by
        rw [heq, ← hdeg]
        exact h.le_budHi
      calc |P.coeff r| * |t| ^ r ≤ budHi c δ * (ρ ^ d * N ^ r) :=
            mul_le_mul hcf (htr r hrd) (by positivity) (by positivity)
        _ = budHi c δ * ρ ^ d * N ^ d := by rw [heq]; ring
  have hsum : P.eval t = ∑ r ∈ Finset.range (d + 1), P.coeff r * t ^ r := by
    rw [← hdeg]
    exact Polynomial.eval_eq_sum_range t
  rw [hsum]
  refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
  refine (Finset.sum_le_sum hterm).trans (le_of_eq ?_)
  rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  push_cast
  ring

/-- **Padding the order** (`patch:raise-order` iterated): a lower bound `lam ≤ 1` at order `k`
gives `(lam / M)^{2^{t+1} - 1}` at order `k + t`, `M ≥ max(1, 16 C^3)`. -/
theorem locUnifPow_pad {C N H : ℝ} (hH : 0 < H) (hC : 0 ≤ C) (hN : 0 < N) (j : Fin 3)
    (hHS : H ≤ 2 * (C * N ^ expo j)) {f : E3 → ℂ} (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1)
    (hsupp : ∀ y, y ∉ petBox C N → f y = 0) {M lam : ℝ} (hM1 : 1 ≤ M) (hMC : 16 * C ^ 3 ≤ M)
    (hlam0 : 0 ≤ lam) (hlam1 : lam ≤ 1) {k : ℕ} (hk : lam ≤ (locUnifPow N H j k f).re) :
    ∀ t : ℕ, (lam / M) ^ (2 ^ (t + 1) - 1) ≤ (locUnifPow N H j (k + t) f).re := by
  have hM0 : 0 < M := by linarith
  have hq0 : 0 ≤ lam / M := div_nonneg hlam0 hM0.le
  have hq1 : lam / M ≤ 1 := (div_le_one hM0).mpr (hlam1.trans hM1)
  intro t
  induction t with
  | zero =>
    simp only [zero_add, pow_one, Nat.add_zero]
    have : lam / M ≤ lam := div_le_self hlam0 hM1
    norm_num
    linarith
  | succ t ih =>
    have hstep := sq_re_locUnifPow_le hH hC hN j hHS (k + t) hf hf1 hsupp
    have hpos : 0 ≤ (lam / M) ^ (2 ^ (t + 1) - 1) := pow_nonneg hq0 _
    have hsq : ((lam / M) ^ (2 ^ (t + 1) - 1)) ^ 2 ≤ (locUnifPow N H j (k + t) f).re ^ 2 :=
      pow_le_pow_left₀ hpos ih 2
    have hQ : ((lam / M) ^ (2 ^ (t + 1) - 1)) ^ 2 ≤ M * (locUnifPow N H j (k + t + 1) f).re := by
      have h0 := locUnifPow_re_nonneg hH hN j (k + t) hf hf1
      have h16 : 16 * C ^ 3 * (locUnifPow N H j (k + t + 1) f).re
          ≤ M * (locUnifPow N H j (k + t + 1) f).re := mul_le_mul_of_nonneg_right hMC h0
      linarith
    have hexp : 2 ^ (t + 1 + 1) - 1 = 2 * (2 ^ (t + 1) - 1) + 1 := by
      have : 1 ≤ 2 ^ (t + 1) := Nat.one_le_two_pow
      rw [pow_succ]; omega
    rw [hexp, pow_succ, pow_mul', show k + (t + 1) = k + t + 1 by ring]
    have h1 : ((lam / M) ^ (2 ^ (t + 1) - 1)) ^ 2 * (lam / M)
        ≤ ((lam / M) ^ (2 ^ (t + 1) - 1)) ^ 2 * (1 / M) := by
      refine mul_le_mul_of_nonneg_left ?_ (sq_nonneg _)
      rw [div_le_div_iff_of_pos_right hM0]; exact hlam1
    calc (((lam / M) ^ (2 ^ (t + 1) - 1)) ^ 2) * (lam / M)
        ≤ ((lam / M) ^ (2 ^ (t + 1) - 1)) ^ 2 * (1 / M) := h1
      _ ≤ M * (locUnifPow N H j (k + t + 1) f).re * (1 / M) :=
          mul_le_mul_of_nonneg_right hQ (by positivity)
      _ = (locUnifPow N H j (k + t + 1) f).re := by field_simp

/-- **A monomial lower bound is a lower budget.** -/
theorem exists_budLo_le {A : ℝ} (hA : 0 < A) (a : ℕ) :
    ∃ C : ℕ, 1 ≤ C ∧ ∀ δ : ℝ, 0 < δ → δ ≤ 1 → budLo C δ ≤ A * δ ^ a := by
  obtain ⟨n, hn⟩ := exists_nat_gt A⁻¹
  refine ⟨max (max n a) 1, le_max_right _ _, fun δ hδ0 hδ1 => ?_⟩
  set C := max (max n a) 1
  have hC1 : 1 ≤ C := le_max_right _ _
  have hCa : a ≤ C := le_trans (le_max_right _ _) (le_max_left _ _)
  have hCn : (n : ℝ) ≤ C := by exact_mod_cast le_trans (le_max_left _ _) (le_max_left _ _)
  have hC0 : (0 : ℝ) < C := by exact_mod_cast hC1
  rw [budLo]
  refine mul_le_mul ?_ (pow_le_pow_of_le_one hδ0.le hδ1 hCa) (by positivity) hA.le
  rw [inv_le_comm₀ hC0 hA]
  linarith

/-- **The loss lemma, solved for the terminal mean** (the blueprint's choice
`H/N ≤ λ^{2^{T_0}} / (4 T_0 c_{T_0})`, giving an averaged terminal cube at least
`κ = λ^{2^{T_0}} / (2 c_{T_0})`). -/
theorem chain_mean_lower {tot T0 : ℕ} (htot : tot ≤ T0) {A Q lam δ' : ℝ} (hA : lam ≤ A)
    (hlam0 : 0 < lam) (hlam1 : lam ≤ 1)
    (hchain : A ^ (2 ^ tot) ≤ 2 ^ (2 ^ tot) / 2 * (max Q 0 + tot * δ')) (hδ' : 0 ≤ δ')
    (hδsmall : T0 * δ' ≤ lam ^ (2 ^ T0) / (4 * (2 ^ (2 ^ T0) / 2))) :
    lam ^ (2 ^ T0) / (2 * (2 ^ (2 ^ T0) / 2)) ≤ Q := by
  set cT : ℝ := 2 ^ (2 ^ T0) / 2 with hcT
  set ct : ℝ := 2 ^ (2 ^ tot) / 2 with hct
  have hct0 : 0 < ct := by positivity
  have hcT0 : 0 < cT := by positivity
  have hcle : ct ≤ cT := by
    rw [hct, hcT]
    refine div_le_div_of_nonneg_right ?_ (by norm_num)
    exact pow_le_pow_right₀ (by norm_num) (Nat.pow_le_pow_right (by norm_num) htot)
  have hpow : lam ^ (2 ^ T0) ≤ A ^ (2 ^ tot) := by
    calc lam ^ (2 ^ T0) ≤ lam ^ (2 ^ tot) :=
          pow_le_pow_of_le_one hlam0.le hlam1 (Nat.pow_le_pow_right (by norm_num) htot)
      _ ≤ A ^ (2 ^ tot) := pow_le_pow_left₀ hlam0.le hA _
  have hmax0 : 0 ≤ max Q 0 := le_max_right _ _
  have htd : (tot : ℝ) * δ' ≤ T0 * δ' :=
    mul_le_mul_of_nonneg_right (by exact_mod_cast htot) hδ'
  have hlamT : 0 < lam ^ (2 ^ T0) := pow_pos hlam0 _
  have h1 : lam ^ (2 ^ T0) ≤ cT * max Q 0 + lam ^ (2 ^ T0) / 4 := by
    have hδs' : cT * (T0 * δ') ≤ lam ^ (2 ^ T0) / 4 := by
      rw [le_div_iff₀ (by norm_num : (0 : ℝ) < 4)]
      rw [le_div_iff₀ (by positivity : (0 : ℝ) < 4 * cT)] at hδsmall
      nlinarith
    calc lam ^ (2 ^ T0) ≤ ct * (max Q 0 + tot * δ') := hpow.trans hchain
      _ ≤ cT * (max Q 0 + T0 * δ') :=
          mul_le_mul hcle (add_le_add le_rfl htd) (by positivity) hcT0.le
      _ = cT * max Q 0 + cT * (T0 * δ') := by ring
      _ ≤ cT * max Q 0 + lam ^ (2 ^ T0) / 4 := by linarith
  have hQpos : lam ^ (2 ^ T0) / (2 * cT) ≤ max Q 0 := by
    rw [div_le_iff₀ (by positivity)]
    nlinarith
  have hmax : 0 < max Q 0 := lt_of_lt_of_le (by positivity) hQpos
  have hQ : max Q 0 = Q := by
    rcases le_total Q 0 with h | h
    · rw [max_eq_right h] at hmax; exact absurd hmax (lt_irrefl _)
    · exact max_eq_left h
  rw [← hQ]
  exact hQpos

variable {r : ℕ}

/-- The initial family has at most `16 m` items. -/
theorem initState_length (hr : 4 ≤ r) (P : ℕ → Polynomial ℝ) (j : ℕ → Fin 3) (m : ℕ)
    (hP : InitDegrees P m) : (petAllItems (initState hr P j m hP)).length ≤ 16 * m := by
  classical
  rw [petAllItems, List.length_cons, initState_rest]
  have h1 := length_petGroup_le (initRestRaw hr P j m)
  have h2 : (initRestRaw hr P j m).length = 16 * m - 1 := by
    have hmem : ((fun _ => true), m) ∈ (Finset.univ ×ˢ Finset.Icc 1 m :
        Finset ((Fin 4 → Bool) × ℕ)) :=
      Finset.mem_product.mpr ⟨Finset.mem_univ _, Finset.mem_Icc.mpr ⟨hP.one_le, le_rfl⟩⟩
    rw [initRestRaw, List.length_map, Finset.length_toList, initIndex,
      Finset.card_erase_of_mem hmem, Finset.card_product, Finset.card_univ,
      Fintype.card_fun, Fintype.card_bool, Fintype.card_fin, Nat.card_Icc]
    norm_num
  have := hP.one_le
  omega

/-- Along the run the number of items at most doubles at each move. -/
theorem hcSeq_length (hr : 4 ≤ r) (P : ℕ → Polynomial ℝ) (j : ℕ → Fin 3) (m : ℕ)
    (hP : InitDegrees P m) (k : ℕ) :
    (petAllItems (hcSeq hr P j m hP k)).length ≤ 16 * m * 2 ^ k := by
  induction k with
  | zero => simpa [hcSeq, petRunSeq] using initState_length hr P j m hP
  | succ k ih =>
    simp only [hcSeq] at ih ⊢
    rw [petRunSeq_succ]
    set x := petRunSeq hP.leadingCoeff_ne hP.le_three initDeg_bound_nonneg (initState hr P j m hP)
      initState_inv initState_bd k with hx
    by_cases hmv : 2 ≤ x.1.headPoly.natDegree ∧ 4 + k < r
    · obtain ⟨-, -, -, -, -, -, -, -, -, hlen⟩ := petRunMove_spec hP.leadingCoeff_ne hP.le_three
        initDeg_bound_nonneg k x hmv
      calc _ ≤ 2 * (petAllItems x.1).length := hlen
        _ ≤ 2 * (16 * m * 2 ^ k) := by omega
        _ = 16 * m * 2 ^ (k + 1) := by ring
    · rw [petRunMove_neg _ _ _ k x hmv]
      calc _ ≤ 16 * m * 2 ^ k := ih
        _ ≤ 16 * m * 2 ^ (k + 1) := Nat.mul_le_mul_left _ (Nat.pow_le_pow_right (by norm_num)
            (Nat.le_succ k))

end

section
open Filter Topology MeasureTheory

variable {r : ℕ}

theorem hcSeq_bd (hr : 4 ≤ r) (P : ℕ → Polynomial ℝ) (j : ℕ → Fin 3) (m : ℕ)
    (hP : InitDegrees P m) (k : ℕ) :
    PetRunBd (-(P m).leadingCoeff) (j m)
      (4 * ((P m).natDegree : ℝ) * ((P m).natDegree + 2) ^ k) (hcSeq hr P j m hP k) :=
  (petRunSeq hP.leadingCoeff_ne hP.le_three initDeg_bound_nonneg (initState hr P j m hP)
    initState_inv initState_bd k).2.2

/-- **`patch:highest-control`, the core estimate** for a PET run of length `T` ending at a linear
state: the level-zero correlation `λ` forces the order-`(s+1)` uniformity power of the protected
input at radius `L` to be at least an explicit expression in `λ`, the gaps, and the box. -/
theorem hc_core {N H C Kb M0 C' L lam : ℝ} (hN1 : 1 ≤ N) (hH : 0 < H) (hHN : H ≤ N / 4)
    (hC : 0 < C) (hKb : 0 ≤ Kb) (hM0 : 0 ≤ M0)
    {m : ℕ} {f : ℕ → E3 → ℂ} {P : ℕ → Polynomial ℝ} {p : E3 → Polynomial ℝ} {j : ℕ → Fin 3}
    (hr : 4 ≤ r) (hP : InitDegrees P m)
    (hf : ∀ i, Measurable (f i)) (hf1 : ∀ i y, ‖f i y‖ ≤ 1)
    (hfs : ∀ i y, y ∉ petBox C N → f i y = 0) (hfm : Nice (f m))
    (hFm : Measurable (Function.uncurry fun (x : E3) (t : ℝ) => phaseProd m f P p j x t))
    (hp3 : ∀ x, (p x).natDegree ≤ 3)
    (hK1 : ∀ t ∈ Set.Icc (0 : ℝ) N, |(P m).eval t| ≤ Kb * N ^ expo (j m))
    (hK2 : ∀ t ∈ Set.Icc (0 : ℝ) N, ∀ c, |c| ≤ 4 * H →
      |(P m).eval (t + c) - (P m).eval c| ≤ Kb * N ^ expo (j m))
    {R : ℕ} (hEnv0 : PetStateEnv N H (N + R * H) M0 (initState hr P j m hP))
    (hMT : 4 ^ R * M0 ≤ Kb)
    {T : ℕ} (hTR : T ≤ R) (hTr : 4 + T < r)
    (hmove : ∀ k < T, 2 ≤ (hcSeq hr P j m hP k).headPoly.natDegree)
    (hlin : (hcSeq hr P j m hP T).headPoly.natDegree ≤ 1)
    {Lmax T0 : ℕ} (hLmax : 16 * m * 2 ^ R ≤ Lmax) (hT0 : 4 + R + Lmax ≤ T0)
    (hlam0 : 0 < lam) (hlam1 : lam ≤ 1)
    (hlam : lam ≤ ‖phaseLevel (volume (petBox (C + Kb) N)).toReal N C (f 0) 0 m f P p j
      Fin.elim0‖)
    (hsmall : T0 * (H / N) ≤ lam ^ (2 ^ T0) / (4 * (2 ^ (2 ^ T0) / 2)))
    (hC'C : C ≤ C') (hLpos : 0 < L) (hLS : L ≤ 2 * (C' * N ^ expo (j m)))
    (hLbig : 2 * |(P m).leadingCoeff| * (4 * (P m).natDegree * ((P m).natDegree + 2) ^ R)
      * H ^ (P m).natDegree ≤ L) :
    ∃ s : ℕ, s ≤ Lmax ∧
      (lam ^ (2 ^ T0) / (2 * (2 ^ (2 ^ T0) / 2)) / 2) ^ 2
        ≤ ((volume (petBox (C + Kb) N)).toReal⁻¹ * N ^ (6 : ℕ)) ^ 2 * (16 * C' ^ 3
          * ((2 * L / (|(P m).leadingCoeff| * ((lam ^ (2 ^ T0) / (2 * (2 ^ (2 ^ T0) / 2)))
              / (16 * Lmax)) ^ 2 * H ^ (P m).natDegree)) ^ s
            * (locUnifPow N L (j m) (s + 1) (f m)).re)) := by
  set Cs := C + Kb with hCsdef
  set V := (volume (petBox Cs N)).toReal with hVdef
  set seq := hcSeq hr P j m hP with hseq
  set S := seq T with hSdef
  set s := S.rest.length + 1 with hsdef
  set cT : ℝ := 2 ^ (2 ^ T0) / 2 with hcT
  set κ := lam ^ (2 ^ T0) / (2 * cT) with hκdef
  set ε := (κ / (16 * Lmax)) ^ 2 with hεdef
  set a := -(P m).leadingCoeff with hadef
  set D := (P m).natDegree with hDdef
  have hN : 0 < N := by linarith
  have hCs : 0 < Cs := by linarith
  have hCCs : C ≤ Cs := by linarith
  have hV : 0 < V := by
    rw [hVdef, volume_petBox hCs.le hN.le, ENNReal.toReal_ofReal (by positivity)]; positivity
  have hcT1 : 1 ≤ cT := by
    rw [hcT, le_div_iff₀ (by norm_num : (0 : ℝ) < 2)]
    have : (2 : ℝ) ^ 1 ≤ 2 ^ (2 ^ T0) :=
      pow_le_pow_right₀ (by norm_num) Nat.one_le_two_pow
    linarith
  have hκ0 : 0 < κ := by positivity
  have hκ1 : κ ≤ 1 / 2 := by
    rw [hκdef, div_le_iff₀ (by positivity)]
    have : lam ^ (2 ^ T0) ≤ 1 := pow_le_one₀ hlam0.le hlam1
    nlinarith
  -- the length of the family at the linear state
  have hsL : s ≤ Lmax := by
    have h1 : (petAllItems S).length ≤ 16 * m * 2 ^ T := hcSeq_length hr P j m hP T
    have h2 : (16 * m * 2 ^ T : ℕ) ≤ 16 * m * 2 ^ R :=
      Nat.mul_le_mul_left _ (Nat.pow_le_pow_right (by norm_num) hTR)
    have h3 : s ≤ (petAllItems S).length := by simp [hsdef, petAllItems]
    omega
  have hLmax1 : (1 : ℝ) ≤ Lmax := by
    have : 1 ≤ Lmax := le_trans (by simp [hsdef]) hsL
    exact_mod_cast this
  -- step 1: the chain
  have hRT : N ≤ (N + R * H) - T * H := by
    have : (T : ℝ) ≤ R := by exact_mod_cast hTR
    nlinarith
  have hMT' : 4 ^ T * M0 ≤ Kb :=
    le_trans (mul_le_mul_of_nonneg_right (pow_le_pow_right₀ (by norm_num) hTR) hM0) hMT
  have hchain := hc_chain hN1 hH hHN hC hKb hM0 hr hP hf hf1 hfs hFm hp3 hK1 hK2 hEnv0 hTr hRT
    hMT' hmove hlin
  rw [hcLevel_zero] at hchain
  -- step 2: the terminal mean is at least `κ`
  have htot : 4 + T + s ≤ T0 := by omega
  have hQ := chain_mean_lower htot hlam hlam0 hlam1 hchain (div_nonneg hH.le hN.le) hsmall
  rw [hc_terminal_mean hN hH hCCs hC hf hf1 hfs] at hQ
  -- step 3: the sublevel exclusion
  set F : (Fin (4 + T) → ℝ) → ℝ := fun o => ∫ w : Fin s → ℝ,
    (∏ l, fejer H (w l)) * hcTerm V m f j (4 + T) s S w o with hFdef
  have hvolC : (volume (petBox C N)).toReal ≤ V :=
    ENNReal.toReal_mono (volume_petBox_ne_top _ _) (measure_mono (petBox_mono hCCs hN.le))
  have hT1 := abs_hcTerm_le hV hf hf1 hfs hvolC j (4 + T) s S
  have hTm := measurable_hcTerm V hf j (4 + T) s S
  have hFmeas : Measurable F := by
    have hΦ : Measurable fun q : (Fin s → ℝ) × (Fin (4 + T) → ℝ) =>
        (∏ l, fejer H (q.1 l)) * hcTerm V m f j (4 + T) s S q.1 q.2 :=
      ((measurable_prod_fejer s).comp measurable_fst).mul hTm
    exact (hΦ.stronglyMeasurable.integral_prod_left
      (μ := (volume : Measure (Fin s → ℝ)))).measurable
  have hF1 : ∀ o, |F o| ≤ 1 := by
    intro o
    have hc : Measurable ((Function.uncurry (hcTerm V m f j (4 + T) s S)) ∘
        fun w : Fin s → ℝ => (w, o)) := hTm.comp (measurable_id.prodMk measurable_const)
    have hm : Measurable fun w : Fin s → ℝ => hcTerm V m f j (4 + T) s S w o := hc
    have key := abs_fejerMean_le_one (a := fun w => hcTerm V m f j (4 + T) s S w o) hH hm
      (fun w => hT1 w o)
    exact key
  have hε0 : 0 < ε := by positivity
  have hsqε : Real.sqrt ε = κ / (16 * Lmax) := Real.sqrt_sq (by positivity)
  have hε1 : ε < 1 := by
    have h32 : κ / (16 * Lmax) ≤ 1 / 32 := by
      rw [div_le_iff₀ (by positivity)]; linarith [hκ1, hLmax1]
    have h0 : 0 ≤ κ / (16 * Lmax) := by positivity
    calc ε = (κ / (16 * Lmax)) ^ 2 := rfl
      _ ≤ (1 / 32) ^ 2 := pow_le_pow_left₀ h0 h32 2
      _ < 1 := by norm_num
  have hsε : ((S.rest.length + 1 : ℕ) : ℝ) * (4 * Real.sqrt ε) ≤ κ / 4 := by
    rw [hsqε]
    have hs' : ((S.rest.length + 1 : ℕ) : ℝ) ≤ Lmax := by exact_mod_cast hsL
    rw [show ((S.rest.length + 1 : ℕ) : ℝ) * (4 * (κ / (16 * Lmax)))
      = ((S.rest.length + 1 : ℕ) : ℝ) / Lmax * (κ / 4) by field_simp; ring]
    have : ((S.rest.length + 1 : ℕ) : ℝ) / Lmax ≤ 1 := (div_le_one (by positivity)).mpr hs'
    exact mul_le_of_le_one_left (by positivity) this
  have hinvT := hcSeq_inv hr P j m hP T
  have hbdT := hcSeq_bd hr P j m hP T
  have hD3 : D ≤ 3 := hP.le_three
  obtain ⟨o, hol, hgap, hoF⟩ := hc_good_old hP.leadingCoeff_ne hinvT hbdT hlin (by omega)
    (by omega) hD3 hH hκ0 hε0 hε1 hsε hFmeas hF1 hQ
  -- step 4: uniformize at the good old shifts
  have hD1 : 1 ≤ D := hP.deg_pos m (Finset.mem_Icc.mpr ⟨hP.one_le, le_rfl⟩)
  have ha0 : 0 < |a| := abs_pos.mpr hP.leadingCoeff_ne
  have habs : |a| = |(P m).leadingCoeff| := by rw [hadef, abs_neg]
  have hHD : H ^ (D - 1) * H = H ^ D := by rw [← pow_succ]; congr 1; omega
  have hg : ∀ ν : Fin s, hcGap (petShiftVec (4 + T) o) (j m) S ν.val ≠ 0 := by
    intro ν h0
    have := (hgap ν.val (Nat.lt_succ_iff.mp ν.isLt)).1
    rw [h0, abs_zero] at this
    have : 0 ≤ |a| * ε * H ^ (D - 1) := by positivity
    linarith
  have hBw : 4 * (D : ℝ) * (D + 2) ^ T ≤ 4 * D * (D + 2) ^ R :=
    mul_le_mul_of_nonneg_left (pow_le_pow_right₀ (by linarith) hTR) (by positivity)
  have hhalf : ∀ ν : Fin s, |hcGap (petShiftVec (4 + T) o) (j m) S ν.val| * H ≤ L / 2 := by
    intro ν
    have h1 := (hgap ν.val (Nat.lt_succ_iff.mp ν.isLt)).2
    calc |hcGap (petShiftVec (4 + T) o) (j m) S ν.val| * H
        ≤ |a| * (4 * D * (D + 2) ^ T) * H ^ (D - 1) * H :=
          mul_le_mul_of_nonneg_right h1 hH.le
      _ ≤ |a| * (4 * D * (D + 2) ^ R) * H ^ D := by
          rw [mul_assoc _ (H ^ (D - 1)), hHD]
          exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hBw (abs_nonneg _))
            (by positivity)
      _ ≤ L / 2 := by rw [habs]; linarith
  have hsupp' : ∀ y, y ∉ petBox C' N → f m y = 0 := fun y hy =>
    hfs m y fun h => hy (petBox_mono hC'C hN.le h)
  have hC'0 : 0 ≤ C' := by linarith
  have key := sq_fejer_mean_hcTerm_le (V := V) hN hH hLpos hC'0 hfm (hf1 m) hsupp' j hLS S o hg
    hhalf
  refine ⟨s, hsL, ?_⟩
  have hX0 := locUnifPow_re_nonneg hLpos hN (j m) s hfm (hf1 m)
  have hprod : (∏ ν : Fin s, 2 * L / (|hcGap (petShiftVec (4 + T) o) (j m) S ν.val| * H))
      ≤ (2 * L / (|(P m).leadingCoeff| * ε * H ^ D)) ^ s := by
    rw [← Fin.prod_const]
    refine Finset.prod_le_prod₀ (fun ν _ => by positivity) fun ν _ => ?_
    have hlow := (hgap ν.val (Nat.lt_succ_iff.mp ν.isLt)).1
    rw [← habs]
    have hpos : 0 < |a| * ε * H ^ D := by positivity
    refine div_le_div_of_nonneg_left (by positivity) hpos ?_
    calc |a| * ε * H ^ D = |a| * ε * H ^ (D - 1) * H := by rw [mul_assoc _ (H ^ (D - 1)), hHD]
      _ ≤ |hcGap (petShiftVec (4 + T) o) (j m) S ν.val| * H :=
          mul_le_mul_of_nonneg_right hlow.le hH.le
  have hsq : (κ / 2) ^ 2 ≤ (F o) ^ 2 := pow_le_pow_left₀ (by positivity) hoF 2
  calc (κ / 2) ^ 2 ≤ (F o) ^ 2 := hsq
    _ ≤ (V⁻¹ * N ^ (6 : ℕ)) ^ 2 * (16 * C' ^ 3 * ((∏ ν : Fin s,
          2 * L / (|hcGap (petShiftVec (4 + T) o) (j m) S ν.val| * H))
          * (locUnifPow N L (j m) (s + 1) (f m)).re)) := key
    _ ≤ (V⁻¹ * N ^ (6 : ℕ)) ^ 2 * (16 * C' ^ 3
          * ((2 * L / (|(P m).leadingCoeff| * ε * H ^ D)) ^ s
            * (locUnifPow N L (j m) (s + 1) (f m)).re)) := by
        refine mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_right hprod hX0) (by positivity)) (sq_nonneg _)

end

section
open Filter Topology MeasureTheory

/-! ### Power-controlled quantities (`patch:budgets`)

"Finite sums, products, quotients with a positive lower bound, and fixed natural powers of
power-controlled positive quantities are power-controlled."  A lower bound is a monomial
`A δ^a`, an upper bound `B δ^{-b}`, both for `0 < δ ≤ 1`. -/

/-- A power lower bound. -/
def MonoLow (F : ℝ → ℝ) : Prop :=
  ∃ A : ℝ, 0 < A ∧ ∃ a : ℕ, ∀ δ : ℝ, 0 < δ → δ ≤ 1 → A * δ ^ a ≤ F δ

/-- A power upper bound, for a positive quantity. -/
def MonoHigh (F : ℝ → ℝ) : Prop :=
  ∃ B : ℝ, 0 < B ∧ ∃ b : ℕ, ∀ δ : ℝ, 0 < δ → δ ≤ 1 → 0 < F δ ∧ F δ ≤ B / δ ^ b

theorem MonoLow.pos {F : ℝ → ℝ} (h : MonoLow F) {δ : ℝ} (hδ0 : 0 < δ) (hδ1 : δ ≤ 1) :
    0 < F δ := by
  obtain ⟨A, hA, a, hF⟩ := h
  exact lt_of_lt_of_le (by positivity) (hF δ hδ0 hδ1)

theorem monoLow_const {A : ℝ} (hA : 0 < A) : MonoLow fun _ => A :=
  ⟨A, hA, 0, fun δ _ _ => by simp⟩

theorem monoHigh_const {B : ℝ} (hB : 0 < B) : MonoHigh fun _ => B :=
  ⟨B, hB, 0, fun δ _ _ => ⟨hB, by simp⟩⟩

theorem monoLow_budLo {c : ℕ} (hc : 1 ≤ c) : MonoLow (budLo c) := by
  have hc0 : (0 : ℝ) < c := by exact_mod_cast hc
  exact ⟨(c : ℝ)⁻¹, inv_pos.mpr hc0, c, fun δ _ _ => le_of_eq rfl⟩

theorem monoHigh_budHi {c : ℕ} (hc : 1 ≤ c) : MonoHigh (budHi c) := by
  have hc0 : (0 : ℝ) < c := by exact_mod_cast hc
  exact ⟨c, hc0, c, fun δ hδ0 _ => ⟨budHi_pos hδ0 hc, le_of_eq (by rw [budHi, div_eq_mul_inv])⟩⟩

theorem MonoLow.mono {F G : ℝ → ℝ} (h : MonoLow F) (hFG : ∀ δ, 0 < δ → δ ≤ 1 → F δ ≤ G δ) :
    MonoLow G := by
  obtain ⟨A, hA, a, hF⟩ := h
  exact ⟨A, hA, a, fun δ h0 h1 => (hF δ h0 h1).trans (hFG δ h0 h1)⟩

theorem MonoHigh.mono {F G : ℝ → ℝ} (h : MonoHigh G) (hFG : ∀ δ, 0 < δ → δ ≤ 1 → F δ ≤ G δ)
    (hF0 : ∀ δ, 0 < δ → δ ≤ 1 → 0 < F δ) : MonoHigh F := by
  obtain ⟨B, hB, b, hG⟩ := h
  exact ⟨B, hB, b, fun δ h0 h1 => ⟨hF0 δ h0 h1, (hFG δ h0 h1).trans (hG δ h0 h1).2⟩⟩

theorem MonoLow.mul {F G : ℝ → ℝ} (hF : MonoLow F) (hG : MonoLow G) :
    MonoLow fun δ => F δ * G δ := by
  obtain ⟨A, hA, a, hF⟩ := hF
  obtain ⟨A', hA', a', hG⟩ := hG
  refine ⟨A * A', mul_pos hA hA', a + a', fun δ h0 h1 => ?_⟩
  have e : A * A' * δ ^ (a + a') = (A * δ ^ a) * (A' * δ ^ a') := by rw [pow_add]; ring
  rw [e]
  exact mul_le_mul (hF δ h0 h1) (hG δ h0 h1) (by positivity)
    ((by positivity : (0:ℝ) ≤ A * δ ^ a).trans (hF δ h0 h1))

theorem MonoHigh.mul {F G : ℝ → ℝ} (hF : MonoHigh F) (hG : MonoHigh G) :
    MonoHigh fun δ => F δ * G δ := by
  obtain ⟨B, hB, b, hF⟩ := hF
  obtain ⟨B', hB', b', hG⟩ := hG
  refine ⟨B * B', mul_pos hB hB', b + b', fun δ h0 h1 =>
    ⟨mul_pos (hF δ h0 h1).1 (hG δ h0 h1).1, ?_⟩⟩
  have e : B * B' / δ ^ (b + b') = (B / δ ^ b) * (B' / δ ^ b') := by
    rw [pow_add]; field_simp
  rw [e]
  exact mul_le_mul (hF δ h0 h1).2 (hG δ h0 h1).2 (hG δ h0 h1).1.le (by positivity)

theorem MonoHigh.add {F G : ℝ → ℝ} (hF : MonoHigh F) (hG : MonoHigh G) :
    MonoHigh fun δ => F δ + G δ := by
  obtain ⟨B, hB, b, hF⟩ := hF
  obtain ⟨B', hB', b', hG⟩ := hG
  refine ⟨B + B', add_pos hB hB', b + b', fun δ h0 h1 =>
    ⟨add_pos (hF δ h0 h1).1 (hG δ h0 h1).1, ?_⟩⟩
  have hb : B / δ ^ b ≤ B / δ ^ (b + b') :=
    div_le_div_of_nonneg_left hB.le (by positivity) (pow_le_pow_of_le_one h0.le h1 (by omega))
  have hb' : B' / δ ^ b' ≤ B' / δ ^ (b + b') :=
    div_le_div_of_nonneg_left hB'.le (by positivity) (pow_le_pow_of_le_one h0.le h1 (by omega))
  rw [add_div]
  linarith [(hF δ h0 h1).2, (hG δ h0 h1).2]

theorem MonoLow.pow {F : ℝ → ℝ} (hF : MonoLow F) (n : ℕ) : MonoLow fun δ => F δ ^ n := by
  induction n with
  | zero => simpa using monoLow_const one_pos
  | succ n ih =>
    have := ih.mul hF
    simpa [pow_succ] using this

theorem MonoHigh.pow {F : ℝ → ℝ} (hF : MonoHigh F) (n : ℕ) : MonoHigh fun δ => F δ ^ n := by
  induction n with
  | zero => simpa using monoHigh_const one_pos
  | succ n ih =>
    have := ih.mul hF
    simpa [pow_succ] using this

theorem MonoLow.div {F G : ℝ → ℝ} (hF : MonoLow F) (hG : MonoHigh G) :
    MonoLow fun δ => F δ / G δ := by
  obtain ⟨A, hA, a, hF⟩ := hF
  obtain ⟨B, hB, b, hG⟩ := hG
  refine ⟨A / B, div_pos hA hB, a + b, fun δ h0 h1 => ?_⟩
  obtain ⟨hG0, hGB⟩ := hG δ h0 h1
  have hFA := hF δ h0 h1
  rw [le_div_iff₀ hG0]
  calc A / B * δ ^ (a + b) * G δ ≤ A / B * δ ^ (a + b) * (B / δ ^ b) :=
        mul_le_mul_of_nonneg_left hGB (by positivity)
    _ = A * δ ^ a := by rw [pow_add]; field_simp
    _ ≤ F δ := hFA

theorem MonoHigh.div {F G : ℝ → ℝ} (hF : MonoHigh F) (hG : MonoLow G) :
    MonoHigh fun δ => F δ / G δ := by
  obtain ⟨B, hB, b, hF⟩ := hF
  obtain ⟨A, hA, a, hG⟩ := hG
  refine ⟨B / A, div_pos hB hA, b + a, fun δ h0 h1 => ?_⟩
  obtain ⟨hF0, hFB⟩ := hF δ h0 h1
  have hGA := hG δ h0 h1
  have hG0 : 0 < G δ := lt_of_lt_of_le (by positivity) hGA
  refine ⟨div_pos hF0 hG0, ?_⟩
  rw [div_le_div_iff₀ hG0 (by positivity)]
  calc F δ * δ ^ (b + a) ≤ B / δ ^ b * δ ^ (b + a) :=
        mul_le_mul_of_nonneg_right hFB (by positivity)
    _ = B / A * (A * δ ^ a) := by rw [pow_add]; field_simp
    _ ≤ B / A * G δ := mul_le_mul_of_nonneg_left hGA (by positivity)

theorem MonoLow.min_const {F : ℝ → ℝ} (hF : MonoLow F) {c : ℝ} (hc : 0 < c) :
    MonoLow fun δ => min c (F δ) := by
  obtain ⟨A, hA, a, hF⟩ := hF
  refine ⟨min c A, lt_min hc hA, a, fun δ h0 h1 => le_min ?_ ?_⟩
  · calc min c A * δ ^ a ≤ c * 1 :=
          mul_le_mul (min_le_left _ _) (pow_le_one₀ h0.le h1) (by positivity) hc.le
      _ = c := mul_one c
  · exact (mul_le_mul_of_nonneg_right (min_le_right _ _) (by positivity)).trans (hF δ h0 h1)

theorem MonoLow.exists_budLo {F : ℝ → ℝ} (hF : MonoLow F) :
    ∃ C : ℕ, 1 ≤ C ∧ ∀ δ : ℝ, 0 < δ → δ ≤ 1 → budLo C δ ≤ F δ := by
  obtain ⟨A, hA, a, hF⟩ := hF
  obtain ⟨C, hC, hCb⟩ := exists_budLo_le hA a
  exact ⟨C, hC, fun δ h0 h1 => (hCb δ h0 h1).trans (hF δ h0 h1)⟩

end

section
open Filter Topology MeasureTheory

/-! ### The explicit budgets of `patch:highest-control` -/

/-- The envelope of the initial shifted family, in units of the box sides. -/
noncomputable def hcM0 (c R : ℕ) (δ : ℝ) : ℝ := 8 * budHi c δ * ((R : ℝ) + 2) ^ 3

/-- The enlargement of the budget box that holds every level of the chain. -/
noncomputable def hcKb (c R : ℕ) (D : ℕ) (δ : ℝ) : ℝ :=
  16 * ((D : ℝ) + 1) * budHi c δ + 4 ^ R * hcM0 c R δ

/-- The side constant of the chain's box. -/
noncomputable def hcCs (c R D : ℕ) (δ : ℝ) : ℝ := budHi c δ + hcKb c R D δ

/-- The level-zero lower bound `λ = ℓ_c(δ) / (8 C_s^3)`. -/
noncomputable def hcLam (c R D : ℕ) (δ : ℝ) : ℝ := budLo c δ / (8 * hcCs c R D δ ^ 3)

/-- The loss constant `c_{T_0} = 2^{2^{T_0} - 1}`. -/
noncomputable def hcCT (T0 : ℕ) : ℝ := 2 ^ (2 ^ T0) / 2

/-- The shift radius `H/N`. -/
noncomputable def hcEpsH (c R D T0 : ℕ) (δ : ℝ) : ℝ :=
  min (1 / 32) (hcLam c R D δ ^ (2 ^ T0) / (4 * T0 * hcCT T0))

/-- The lower bound `κ` on the terminal mean. -/
noncomputable def hcKappa (c R D T0 : ℕ) (δ : ℝ) : ℝ :=
  hcLam c R D δ ^ (2 ^ T0) / (2 * hcCT T0)

/-- The sublevel threshold `ε`. -/
noncomputable def hcEps (c R D T0 Lmax : ℕ) (δ : ℝ) : ℝ :=
  (hcKappa c R D T0 δ / (16 * Lmax)) ^ 2

/-- The radius comparison factor. -/
noncomputable def hcG (c R D T0 Lmax C1 : ℕ) (δ : ℝ) : ℝ :=
  2 * budHi C1 δ / (budLo c δ * hcEps c R D T0 Lmax δ * hcEpsH c R D T0 δ ^ D)

/-- The uniformity lower bound before padding. -/
noncomputable def hcLam1 (c R D T0 Lmax C1 : ℕ) (δ : ℝ) : ℝ :=
  (hcKappa c R D T0 δ / 2) ^ 2 * 64 / (16 * budHi C1 δ ^ 3 * hcG c R D T0 Lmax C1 δ ^ Lmax)

/-- The final lower bound, after padding to the order `L_max + 1`. -/
noncomputable def hcPhi (c R D T0 Lmax C1 : ℕ) (δ : ℝ) : ℝ :=
  (min 1 (hcLam1 c R D T0 Lmax C1 δ) / (16 * budHi C1 δ ^ 3 + 1)) ^ (2 ^ (Lmax + 1) - 1)

section
variable {c R D T0 Lmax C1 : ℕ} (hc : 1 ≤ c) (hC1 : 1 ≤ C1) (hT0 : 1 ≤ T0) (hL : 1 ≤ Lmax)
include hc

theorem monoHigh_hcM0 : MonoHigh (hcM0 c R) :=
  (((monoHigh_const (by norm_num : (0 : ℝ) < 8)).mul (monoHigh_budHi hc)).mul
    (monoHigh_const (by positivity : (0 : ℝ) < ((R : ℝ) + 2) ^ 3)))

theorem monoHigh_hcKb : MonoHigh (hcKb c R D) :=
  ((monoHigh_const (by positivity : (0 : ℝ) < 16 * ((D : ℝ) + 1))).mul (monoHigh_budHi hc)).add
    ((monoHigh_const (by positivity : (0 : ℝ) < 4 ^ R)).mul (monoHigh_hcM0 hc))

theorem monoHigh_hcCs : MonoHigh (hcCs c R D) := (monoHigh_budHi hc).add (monoHigh_hcKb hc)

theorem monoLow_hcLam : MonoLow (hcLam c R D) :=
  (monoLow_budLo hc).div ((monoHigh_const (by norm_num : (0 : ℝ) < 8)).mul
    ((monoHigh_hcCs hc).pow 3))

theorem monoLow_hcKappa : MonoLow (hcKappa c R D T0) :=
  ((monoLow_hcLam hc).pow _).div (monoHigh_const (by unfold hcCT; positivity))

include hT0 in
theorem monoLow_hcEpsH : MonoLow (hcEpsH c R D T0) :=
  (((monoLow_hcLam hc).pow _).div (monoHigh_const (by
    have : (0 : ℝ) < T0 := by exact_mod_cast hT0
    unfold hcCT; positivity))).min_const (by norm_num)

include hL in
theorem monoLow_hcEps : MonoLow (hcEps c R D T0 Lmax) :=
  (((monoLow_hcKappa hc).div (monoHigh_const (by
    have : (0 : ℝ) < Lmax := by exact_mod_cast hL
    positivity))).pow 2)

include hT0 hL hC1 in
theorem monoHigh_hcG : MonoHigh (hcG c R D T0 Lmax C1) :=
  ((monoHigh_const (by norm_num : (0 : ℝ) < 2)).mul (monoHigh_budHi hC1)).div
    (((monoLow_budLo hc).mul (monoLow_hcEps hc hL)).mul ((monoLow_hcEpsH hc hT0).pow D))

include hT0 hL hC1 in
theorem monoLow_hcLam1 : MonoLow (hcLam1 c R D T0 Lmax C1) :=
  ((((monoLow_hcKappa hc).div (monoHigh_const (by norm_num))).pow 2).mul
    (monoLow_const (by norm_num : (0 : ℝ) < 64))).div
    (((monoHigh_const (by norm_num : (0 : ℝ) < 16)).mul ((monoHigh_budHi hC1).pow 3)).mul
      ((monoHigh_hcG hc hC1 hT0 hL).pow Lmax))

include hT0 hL hC1 in
theorem monoLow_hcPhi : MonoLow (hcPhi c R D T0 Lmax C1) :=
  ((((monoLow_hcLam1 hc hC1 hT0 hL).min_const one_pos).div
    (((monoHigh_const (by norm_num : (0 : ℝ) < 16)).mul ((monoHigh_budHi hC1).pow 3)).add
      (monoHigh_const one_pos))).pow _)

end

end

section
open Filter Topology MeasureTheory

theorem budHi_mul_le {δ : ℝ} (hδ0 : 0 < δ) (hδ1 : δ ≤ 1) {c k : ℕ} (hc : 1 ≤ c) (hk : 1 ≤ k) :
    (k : ℝ) * budHi c δ ≤ budHi (k * c) δ := by
  have hkc : c ≤ k * c := Nat.le_mul_of_pos_left c hk
  rw [budHi, budHi]
  push_cast
  have hpow : (δ ^ c)⁻¹ ≤ (δ ^ (k * c))⁻¹ :=
    (inv_le_inv₀ (by positivity) (by positivity)).mpr (pow_le_pow_of_le_one hδ0.le hδ1 hkc)
  have : (0 : ℝ) ≤ (k : ℝ) * c := by positivity
  nlinarith

theorem budLo_le_one {δ : ℝ} (hδ0 : 0 < δ) (hδ1 : δ ≤ 1) {c : ℕ} (hc : 1 ≤ c) :
    budLo c δ ≤ 1 := by
  have hc0 : (1 : ℝ) ≤ c := by exact_mod_cast hc
  rw [budLo]
  calc (c : ℝ)⁻¹ * δ ^ c ≤ 1 * 1 :=
        mul_le_mul (inv_le_one_of_one_le₀ hc0) (pow_le_one₀ hδ0.le hδ1) (by positivity)
          zero_le_one
    _ = 1 := one_mul 1

theorem one_le_budHi {δ : ℝ} (hδ0 : 0 < δ) (hδ1 : δ ≤ 1) {c : ℕ} (hc : 1 ≤ c) :
    1 ≤ budHi c δ := by
  have hc0 : (1 : ℝ) ≤ c := by exact_mod_cast hc
  rw [budHi]
  have : 1 ≤ (δ ^ c)⁻¹ := one_le_inv₀ (by positivity) |>.mpr (pow_le_one₀ hδ0.le hδ1)
  nlinarith

/-- **The level-zero correlation in the chain's normalization.** -/
theorem norm_phaseLevel_zero_eq {V N C : ℝ} {m : ℕ} (hm : 1 ≤ m) {f : ℕ → E3 → ℂ}
    (hsupp : ∀ y, y ∉ petBox C N → f m y = 0) (P : ℕ → Polynomial ℝ)
    (p : E3 → Polynomial ℝ) (j : ℕ → Fin 3) (hV : 0 < V) :
    ‖phaseLevel V N C (f 0) 0 m f P p j Fin.elim0‖ = V⁻¹ * ‖phaseCorr N m f P p j‖ := by
  rw [phaseLevel_zero hm hsupp V P p j (f 0) Fin.elim0, norm_smul, Real.norm_eq_abs,
    abs_of_pos (inv_pos.mpr hV), phaseCorr]
  congr 2
  refine integral_congr_ae (.of_forall fun x => ?_)
  simp only [zero_add, Complex.real_smul, Complex.ofReal_inv]

theorem sq_inv_box_le {x N : ℝ} (hx : 1 ≤ x) (hN : 0 < N) :
    ((8 * x ^ 3 * N ^ (6 : ℕ))⁻¹ * N ^ (6 : ℕ)) ^ 2 ≤ 1 / 64 := by
  have hN6 : (0 : ℝ) < N ^ (6 : ℕ) := by positivity
  have hx3 : 1 ≤ x ^ 3 := one_le_pow₀ hx
  have e : (8 * x ^ 3 * N ^ (6 : ℕ))⁻¹ * N ^ (6 : ℕ) = (8 * x ^ 3)⁻¹ := by field_simp
  rw [e]
  have h8 : (8 : ℝ) ≤ 8 * x ^ 3 := by linarith
  have h0 : 0 ≤ (8 * x ^ 3)⁻¹ := by positivity
  have h81 : (8 * x ^ 3)⁻¹ ≤ 8⁻¹ := (inv_le_inv₀ (by positivity) (by norm_num)).mpr h8
  calc ((8 * x ^ 3)⁻¹) ^ 2 ≤ (8⁻¹) ^ 2 := pow_le_pow_left₀ h0 h81 2
    _ = 1 / 64 := by norm_num

set_option maxHeartbeats 1000000 in
-- The proof assembles the whole chain, the run and all the budgets in one context.
/-- **`patch:highest-control`, highest active degree at least two, continuous protected input.**
For fixed directions (the degrees of the inputs are those of their directions, increasing, the
protected one of degree at least two) and input budget `c`, there are an order `s₀` and budgets
`C₁` (radius) and `C₂` (lower bound) such that a power-large phased correlation forces the
protected input to have power-large order-`s₀` uniformity at radius `u_{C₁}(δ) N^{d_m}`. -/
theorem highestControl_ge2 (m : ℕ) (hm1 : 1 ≤ m) (j : ℕ → Fin 3) (hjm : 2 ≤ expo (j m))
    (hj : ∀ i ∈ Finset.Icc 1 m, i ≠ m → expo (j i) < expo (j m)) (c : ℕ) (hc : 1 ≤ c) :
    ∃ s₀ C₁ C₂ : ℕ, 1 ≤ C₁ ∧ 1 ≤ C₂ ∧ ∀ δ N : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ N →
      ∀ (P : ℕ → Polynomial ℝ) (f : ℕ → E3 → ℂ) (p : E3 → Polynomial ℝ),
        (∀ i ∈ Finset.Icc 1 m, AdmissiblePoly c δ N (expo (j i)) (P i)) →
        (∀ i, Measurable (f i)) → (∀ i y, ‖f i y‖ ≤ 1) →
        (∀ i y, y ∉ petBox (budHi c δ) N → f i y = 0) → Nice (f m) →
        Measurable (Function.uncurry fun (x : E3) (t : ℝ) => phaseProd m f P p j x t) →
        (∀ x, (p x).natDegree ≤ 3) →
        budLo c δ * N ^ (6 : ℕ) ≤ ‖phaseCorr N m f P p j‖ →
        budLo C₂ δ ≤ (locUnifPow N (budHi C₁ δ * N ^ expo (j m)) (j m) s₀ (f m)).re := by
  obtain ⟨R, hRrun⟩ := petRun_terminates_uniform.{0} (16 * m)
  set D := expo (j m) with hDdef
  have hD3 : D ≤ 3 := by simp only [hDdef, expo]; omega
  set Lmax := 16 * m * 2 ^ R with hLmaxdef
  set T0 := 4 + R + Lmax with hT0def
  set C₁ := 24 * 5 ^ R * c with hC1def
  have hL1 : 1 ≤ Lmax := by
    have : 1 ≤ 2 ^ R := Nat.one_le_two_pow
    rw [hLmaxdef]; nlinarith
  have hT01 : 1 ≤ T0 := by omega
  have hC11 : 1 ≤ C₁ := by
    have : 1 ≤ 5 ^ R := Nat.one_le_pow _ _ (by norm_num)
    rw [hC1def]; nlinarith
  have hcC1 : c ≤ C₁ := by
    have : 1 ≤ 24 * 5 ^ R := by have := Nat.one_le_pow R 5 (by norm_num); omega
    rw [hC1def]; nlinarith
  obtain ⟨C₂, hC21, hC2⟩ := (monoLow_hcPhi (R := R) (D := D) hc hC11 hT01 hL1).exists_budLo
  refine ⟨Lmax + 1, C₁, C₂, hC11, hC21, ?_⟩
  intro δ N hδ0 hδ1 hN1 P f p hadm hf hf1 hfs hfm hFm hp3 hcorr
  -- the degree data
  have hP : InitDegrees P m := by
    refine ⟨hm1, fun i hi => ?_, fun i hi hne => ?_, ?_, ?_⟩
    · rw [(hadm i hi).natDegree_eq]; simp [expo]
    · rw [(hadm i hi).natDegree_eq, (hadm m (Finset.mem_Icc.mpr ⟨hm1, le_rfl⟩)).natDegree_eq]
      exact hj i hi hne
    · rw [(hadm m (Finset.mem_Icc.mpr ⟨hm1, le_rfl⟩)).natDegree_eq]; exact hjm
    · rw [(hadm m (Finset.mem_Icc.mpr ⟨hm1, le_rfl⟩)).natDegree_eq]; exact hD3
  have hmm : m ∈ Finset.Icc 1 m := Finset.mem_Icc.mpr ⟨hm1, le_rfl⟩
  have hDeg : (P m).natDegree = D := (hadm m hmm).natDegree_eq
  have hN0 : (0 : ℝ) < N := by linarith
  have hbud := budHi_pos hδ0 hc
  set C := budHi c δ with hCdef
  set C' := budHi C₁ δ with hC'def
  have hCC' : C ≤ C' := budHi_monotone hδ0 hδ1 hc hcC1
  have hC0 : 0 < C := hbud
  set Kb := hcKb c R D δ with hKbdef
  set M0 := hcM0 c R δ with hM0def
  have hM0 : 0 ≤ M0 := by rw [hM0def, hcM0]; positivity
  have hKb : 0 ≤ Kb := by rw [hKbdef, hcKb]; positivity
  set εH := hcEpsH c R D T0 δ with hεHdef
  have hεH0 : 0 < εH := (monoLow_hcEpsH (R := R) (D := D) hc hT01).pos hδ0 hδ1
  have hεH1 : εH ≤ 1 / 32 := min_le_left _ _
  set H := εH * N with hHdef
  have hH : 0 < H := by positivity
  have hHN : H ≤ N / 4 := by rw [hHdef]; nlinarith
  have hHN' : 4 * H ≤ N := by linarith
  -- the protected shift is bounded in units of its box side
  have hDp : (0 : ℝ) ≤ D := by positivity
  have hK1 : ∀ t ∈ Set.Icc (0 : ℝ) N, |(P m).eval t| ≤ Kb * N ^ expo (j m) := by
    intro t ht
    have h1 := (hadm m hmm).abs_eval_le hδ0 hc hN0.le ht.1 ht.2
    rw [← hCdef] at h1
    have : ((expo (j m) : ℕ) + 1 : ℝ) * C ≤ Kb := by
      rw [hKbdef, hcKb, ← hCdef]
      have : 0 ≤ (4 : ℝ) ^ R * hcM0 c R δ := by positivity
      rw [← hDdef]; nlinarith
    calc |(P m).eval t| ≤ ((expo (j m) : ℕ) + 1 : ℝ) * C * N ^ expo (j m) := h1
      _ ≤ Kb * N ^ expo (j m) := mul_le_mul_of_nonneg_right this (by positivity)
  have hK2 : ∀ t ∈ Set.Icc (0 : ℝ) N, ∀ c', |c'| ≤ 4 * H →
      |(P m).eval (t + c') - (P m).eval c'| ≤ Kb * N ^ expo (j m) := by
    intro t ht c' hc'
    have hx1 : |t + c'| ≤ 2 * N := by
      calc |t + c'| ≤ |t| + |c'| := abs_add_le _ _
        _ ≤ N + N := add_le_add (by rw [abs_of_nonneg ht.1]; exact ht.2) (hc'.trans hHN')
        _ = 2 * N := by ring
    have hx2 : |c'| ≤ 2 * N := by linarith
    have h1 := (hadm m hmm).abs_eval_le_scaled hδ0 hc hN0.le (by norm_num : (1 : ℝ) ≤ 2) hx1
    have h2 := (hadm m hmm).abs_eval_le_scaled hδ0 hc hN0.le (by norm_num : (1 : ℝ) ≤ 2) hx2
    rw [← hCdef] at h1 h2
    have h8 : (2 : ℝ) ^ expo (j m) ≤ 8 := by
      calc (2 : ℝ) ^ expo (j m) ≤ 2 ^ 3 := pow_le_pow_right₀ (by norm_num) hD3
        _ = 8 := by norm_num
    have hKb' : 2 * (((expo (j m) : ℕ) + 1 : ℝ) * C * 2 ^ expo (j m)) ≤ Kb := by
      rw [hKbdef, hcKb, ← hCdef]
      have : 0 ≤ (4 : ℝ) ^ R * hcM0 c R δ := by positivity
      rw [← hDdef]
      have hD8 : ((D : ℝ) + 1) * C * 2 ^ D ≤ ((D : ℝ) + 1) * C * 8 :=
        mul_le_mul_of_nonneg_left h8 (by positivity)
      nlinarith
    calc |(P m).eval (t + c') - (P m).eval c'| ≤ |(P m).eval (t + c')| + |(P m).eval c'| :=
          abs_sub _ _
      _ ≤ 2 * (((expo (j m) : ℕ) + 1 : ℝ) * C * 2 ^ expo (j m) * N ^ expo (j m)) := by
          linarith
      _ ≤ Kb * N ^ expo (j m) := by
          rw [show 2 * (((expo (j m) : ℕ) + 1 : ℝ) * C * 2 ^ expo (j m) * N ^ expo (j m))
            = 2 * (((expo (j m) : ℕ) + 1 : ℝ) * C * 2 ^ expo (j m)) * N ^ expo (j m) by ring]
          exact mul_le_mul_of_nonneg_right hKb' (by positivity)
  -- the envelope of the initial family
  set r := 4 + R + 1 with hrdef
  have hr : 4 ≤ r := by omega
  have hEnv0 : PetStateEnv N H (N + R * H) M0 (initState hr P j m hP) := by
    refine initState_env hN0.le hH.le hM0 fun i hi x hx => ?_
    have hR0 : (0 : ℝ) ≤ R := by positivity
    have hρ : (1 : ℝ) ≤ R + 2 := by linarith
    have hx' : |x| ≤ (R + 2) * N := by
      have : (R : ℝ) * H ≤ R * (N / 4) := mul_le_mul_of_nonneg_left hHN (by positivity)
      nlinarith
    have h1 := (hadm i hi).abs_eval_le_scaled hδ0 hc hN0.le hρ hx'
    rw [← hCdef] at h1
    have hdi : expo (j i) ≤ 3 := by simp only [expo]; omega
    have hpow : ((R : ℝ) + 2) ^ expo (j i) ≤ ((R : ℝ) + 2) ^ 3 := pow_le_pow_right₀ hρ hdi
    have hd4 : ((expo (j i) : ℕ) : ℝ) + 1 ≤ 4 := by
      have : ((expo (j i) : ℕ) : ℝ) ≤ 3 := by exact_mod_cast hdi
      linarith
    calc |(P i).eval x| ≤ ((expo (j i) : ℕ) + 1 : ℝ) * C * ((R : ℝ) + 2) ^ expo (j i)
          * N ^ expo (j i) := h1
      _ ≤ 4 * C * ((R : ℝ) + 2) ^ 3 * N ^ expo (j i) := by
          refine mul_le_mul_of_nonneg_right (mul_le_mul (mul_le_mul_of_nonneg_right hd4 hC0.le)
            hpow (by positivity) (by positivity)) (by positivity)
      _ = M0 / 2 * N ^ expo (j i) := by rw [hM0def, hcM0, ← hCdef]; ring
  have hMT : 4 ^ R * M0 ≤ Kb := by
    rw [hKbdef, hcKb, ← hM0def]
    have : 0 ≤ 16 * ((D : ℝ) + 1) * budHi c δ := by positivity
    linarith
  -- the run
  obtain ⟨T, hTR, hlin, hmove⟩ := hRrun hP.leadingCoeff_ne hP.le_three initDeg_bound_nonneg
    (initState hr P j m hP) initState_inv initState_bd (initState_length hr P j m hP)
    (by omega)
  -- the level-zero lower bound
  set lam := hcLam c R D δ with hlamdef
  have hlam0 : 0 < lam := (monoLow_hcLam (R := R) (D := D) hc).pos hδ0 hδ1
  have hCs1 : 1 ≤ hcCs c R D δ := by
    rw [hcCs]; have := one_le_budHi hδ0 hδ1 hc; linarith
  have hlam1 : lam ≤ 1 := by
    rw [hlamdef, hcLam, div_le_one (by positivity)]
    have h1 := budLo_le_one hδ0 hδ1 hc
    have : (1 : ℝ) ≤ hcCs c R D δ ^ 3 := one_le_pow₀ hCs1
    linarith
  have hCsKb : C + Kb = hcCs c R D δ := by rw [hcCs]
  have hV : 0 < (volume (petBox (C + Kb) N)).toReal := by
    rw [volume_petBox (by linarith) hN0.le, ENNReal.toReal_ofReal (by positivity)]; positivity
  have hVeq : (volume (petBox (C + Kb) N)).toReal = 8 * hcCs c R D δ ^ 3 * N ^ (6 : ℕ) := by
    rw [volume_petBox (by linarith) hN0.le, ENNReal.toReal_ofReal (by positivity), hCsKb]
  have hlam : lam ≤ ‖phaseLevel (volume (petBox (C + Kb) N)).toReal N C (f 0) 0 m f P p j
      Fin.elim0‖ := by
    rw [norm_phaseLevel_zero_eq hm1 (hfs m) P p j hV, hVeq, hlamdef, hcLam]
    rw [le_inv_mul_iff₀ (by positivity)]
    calc 8 * hcCs c R D δ ^ 3 * N ^ (6 : ℕ) * (budLo c δ / (8 * hcCs c R D δ ^ 3))
        = budLo c δ * N ^ (6 : ℕ) := by field_simp
      _ ≤ ‖phaseCorr N m f P p j‖ := hcorr
  -- the smallness of `H / N`
  have hT0pos : (0 : ℝ) < T0 := by exact_mod_cast hT01
  have hsmall : (T0 : ℝ) * (H / N) ≤ lam ^ (2 ^ T0) / (4 * (2 ^ (2 ^ T0) / 2)) := by
    have hHN' : H / N = εH := by rw [hHdef]; field_simp
    rw [hHN']
    have h2 : εH ≤ lam ^ (2 ^ T0) / (4 * T0 * hcCT T0) := min_le_right _ _
    have hcT0 : (0 : ℝ) < hcCT T0 := by unfold hcCT; positivity
    calc (T0 : ℝ) * εH ≤ T0 * (lam ^ (2 ^ T0) / (4 * T0 * hcCT T0)) :=
          mul_le_mul_of_nonneg_left h2 hT0pos.le
      _ = lam ^ (2 ^ T0) / (4 * (2 ^ (2 ^ T0) / 2)) := by unfold hcCT; field_simp
  -- the radius
  set L := C' * N ^ D with hLdef
  have hC'1 : 1 ≤ C' := one_le_budHi hδ0 hδ1 hC11
  have hLpos : 0 < L := by positivity
  have hLS : L ≤ 2 * (C' * N ^ expo (j m)) := by rw [hLdef, ← hDdef]; nlinarith [hLpos]
  have hlc : |(P m).leadingCoeff| ≤ C := (hadm m hmm).le_budHi
  have hlc0 : budLo c δ ≤ |(P m).leadingCoeff| := (hadm m hmm).budLo_le
  have hLbig : 2 * |(P m).leadingCoeff| * (4 * (P m).natDegree * ((P m).natDegree + 2) ^ R)
      * H ^ (P m).natDegree ≤ L := by
    rw [hDeg]
    have hB : 4 * (D : ℝ) * ((D : ℝ) + 2) ^ R ≤ 12 * 5 ^ R := by
      have h3 : (D : ℝ) ≤ 3 := by exact_mod_cast hD3
      have h5 : ((D : ℝ) + 2) ^ R ≤ 5 ^ R := pow_le_pow_left₀ (by positivity) (by linarith) R
      have : 4 * (D : ℝ) ≤ 12 := by linarith
      calc 4 * (D : ℝ) * ((D : ℝ) + 2) ^ R ≤ 12 * 5 ^ R :=
            mul_le_mul this h5 (by positivity) (by norm_num)
        _ = 12 * 5 ^ R := rfl
    have hHle : H ≤ N := by
      rw [hHdef]; exact mul_le_of_le_one_left hN0.le (by linarith)
    have hHD : H ^ D ≤ N ^ D := pow_le_pow_left₀ hH.le hHle D
    have hk0 : ((24 * 5 ^ R : ℕ) : ℝ) * C ≤ C' :=
      budHi_mul_le hδ0 hδ1 hc (by have := Nat.one_le_pow R 5 (by norm_num); omega)
    have hk : (24 * 5 ^ R : ℝ) * C ≤ C' := by
      have e : ((24 * 5 ^ R : ℕ) : ℝ) = 24 * 5 ^ R := by norm_num
      rw [e] at hk0; exact hk0
    calc 2 * |(P m).leadingCoeff| * (4 * (D : ℝ) * ((D : ℝ) + 2) ^ R) * H ^ D
        ≤ 2 * C * (12 * 5 ^ R) * N ^ D := by
          refine mul_le_mul (mul_le_mul (mul_le_mul_of_nonneg_left hlc (by norm_num)) hB
            (by positivity) (by positivity)) hHD (by positivity) (by positivity)
      _ = (24 * 5 ^ R) * C * N ^ D := by ring
      _ ≤ C' * N ^ D := mul_le_mul_of_nonneg_right hk (by positivity)
  obtain ⟨s, hs, hmain⟩ := hc_core hN1 hH hHN hC0 hKb hM0 hr hP hf hf1 hfs hfm hFm hp3 hK1 hK2
    hEnv0 hMT hTR (by omega) hmove hlin (le_refl _) (le_refl _) hlam0 hlam1 hlam hsmall hCC'
    hLpos hLS hLbig
  -- the order-`(s+1)` lower bound
  set X := (locUnifPow N L (j m) (s + 1) (f m)).re with hXdef
  have hX0 : 0 ≤ X := locUnifPow_re_nonneg hLpos hN0 (j m) s hfm (hf1 m)
  set κ := hcKappa c R D T0 δ with hκdef
  set ε := hcEps c R D T0 Lmax δ with hεdef
  set G := hcG c R D T0 Lmax C₁ δ with hGdef
  have hκ0 : 0 < κ := (monoLow_hcKappa (R := R) (D := D) (T0 := T0) hc).pos hδ0 hδ1
  have hε0 : 0 < ε := (monoLow_hcEps (R := R) (D := D) (T0 := T0) hc hL1).pos hδ0 hδ1
  have hε1 : ε ≤ 1 := by
    have hκ1 : κ ≤ 1 := by
      rw [hκdef, hcKappa, div_le_one (by unfold hcCT; positivity)]
      have : lam ^ (2 ^ T0) ≤ 1 := pow_le_one₀ hlam0.le hlam1
      have : 1 ≤ 2 * hcCT T0 := by
        unfold hcCT
        have : (2 : ℝ) ≤ 2 ^ (2 ^ T0) := by
          calc (2 : ℝ) = 2 ^ 1 := by norm_num
            _ ≤ 2 ^ (2 ^ T0) := pow_le_pow_right₀ (by norm_num) Nat.one_le_two_pow
        linarith
      linarith
    have hL16 : (1 : ℝ) ≤ 16 * Lmax := by
      have : (1 : ℝ) ≤ Lmax := by exact_mod_cast hL1
      linarith
    have : κ / (16 * Lmax) ≤ 1 := (div_le_one (by positivity)).mpr (by linarith)
    rw [hεdef, hcEps]
    exact pow_le_one₀ (by positivity) this
  have hbl0 : 0 < budLo c δ := budLo_pos hδ0 hc
  have hlcpos : 0 < |(P m).leadingCoeff| := lt_of_lt_of_le hbl0 hlc0
  have hden0 : 0 < budLo c δ * ε * εH ^ D := mul_pos (mul_pos hbl0 hε0) (pow_pos hεH0 D)
  have hG1 : 1 ≤ G := by
    rw [hGdef, hcG, le_div_iff₀ hden0]
    have h1 := budLo_le_one hδ0 hδ1 hc
    have h2 : εH ^ D ≤ 1 := pow_le_one₀ hεH0.le (by linarith)
    have h3 : budLo c δ * ε * εH ^ D ≤ 1 := by
      have := mul_le_mul (mul_le_mul h1 hε1 hε0.le zero_le_one) h2 (pow_pos hεH0 D).le
        (by norm_num)
      simpa using this
    rw [one_mul]
    linarith
  have hGact : 2 * L / (|(P m).leadingCoeff| * ε * H ^ (P m).natDegree) ≤ G := by
    rw [hDeg, hGdef, hcG, hLdef, hHdef, mul_pow]
    have hNpos : 0 < N ^ D := by positivity
    have hd1 : 0 < |(P m).leadingCoeff| * ε * (εH ^ D * N ^ D) :=
      mul_pos (mul_pos hlcpos hε0) (mul_pos (pow_pos hεH0 D) hNpos)
    rw [div_le_div_iff₀ hd1 hden0]
    have : budLo c δ * ε * εH ^ D * N ^ D ≤ |(P m).leadingCoeff| * ε * εH ^ D * N ^ D :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hlc0
        hε0.le) (pow_pos hεH0 D).le) hNpos.le
    have h2C : 0 ≤ 2 * C' := by linarith
    calc 2 * (C' * N ^ D) * (budLo c δ * ε * εH ^ D)
        = 2 * C' * (budLo c δ * ε * εH ^ D * N ^ D) := by ring
      _ ≤ 2 * C' * (|(P m).leadingCoeff| * ε * εH ^ D * N ^ D) :=
          mul_le_mul_of_nonneg_left this h2C
      _ = 2 * C' * (|(P m).leadingCoeff| * ε * (εH ^ D * N ^ D)) := by ring
  have hVN : ((volume (petBox (C + Kb) N)).toReal⁻¹ * N ^ (6 : ℕ)) ^ 2 ≤ 1 / 64 := by
    rw [hVeq]; exact sq_inv_box_le hCs1 hN0
  have hGact0 : 0 ≤ 2 * L / (|(P m).leadingCoeff| * ε * H ^ (P m).natDegree) :=
    div_nonneg (by linarith) (mul_pos (mul_pos hlcpos hε0) (pow_pos hH _)).le
  have hGs : (2 * L / (|(P m).leadingCoeff| * ε * H ^ (P m).natDegree)) ^ s ≤ G ^ Lmax :=
    (pow_le_pow_left₀ hGact0 hGact s).trans (pow_le_pow_right₀ hG1 hs)
  have hC'3 : 0 < 16 * C' ^ 3 := by have : 0 < C' := by linarith
                                    positivity
  have hGL : 0 < G ^ Lmax := pow_pos (by linarith) _
  have hlam1X : hcLam1 c R D T0 Lmax C₁ δ ≤ X := by
    rw [hcLam1, ← hκdef, ← hGdef, div_le_iff₀ (mul_pos hC'3 hGL)]
    have hmain' : (κ / 2) ^ 2 ≤ 1 / 64 * (16 * C' ^ 3 * (G ^ Lmax * X)) := by
      refine hmain.trans ?_
      refine mul_le_mul hVN (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hGs hX0)
        hC'3.le) (mul_nonneg hC'3.le (mul_nonneg (pow_nonneg hGact0 _) hX0)) (by norm_num)
    calc (κ / 2) ^ 2 * 64 ≤ (1 / 64 * (16 * C' ^ 3 * (G ^ Lmax * X))) * 64 :=
          mul_le_mul_of_nonneg_right hmain' (by norm_num)
      _ = X * (16 * C' ^ 3 * G ^ Lmax) := by ring
  -- padding to the fixed order `L_max + 1`
  set lam1 := hcLam1 c R D T0 Lmax C₁ δ with hlam1def
  have hlam1pos : 0 < lam1 := (monoLow_hcLam1 (R := R) (D := D) hc hC11 hT01 hL1).pos hδ0 hδ1
  set lam1' := min 1 lam1 with hlam1'def
  have hl0 : 0 ≤ lam1' := le_min zero_le_one hlam1pos.le
  have hl1 : lam1' ≤ 1 := min_le_left _ _
  have hlX : lam1' ≤ X := (min_le_right _ _).trans hlam1X
  set M := 16 * C' ^ 3 + 1 with hMdef
  have hM1 : 1 ≤ M := by linarith
  have hMC : 16 * C' ^ 3 ≤ M := by linarith
  have hsupp' : ∀ y, y ∉ petBox C' N → f m y = 0 := fun y hy =>
    hfs m y fun h => hy (petBox_mono hCC' hN0.le h)
  have hpad := locUnifPow_pad hLpos (by linarith : (0 : ℝ) ≤ C') hN0 (j m) hLS hfm (hf1 m)
    hsupp' hM1 hMC hl0 hl1 hlX (Lmax - s)
  rw [show s + 1 + (Lmax - s) = Lmax + 1 by omega] at hpad
  have hM0' : 0 < M := by linarith
  have hb0 : 0 ≤ lam1' / M := div_nonneg hl0 hM0'.le
  have hb1 : lam1' / M ≤ 1 := (div_le_one hM0').mpr (hl1.trans hM1)
  have hexp : 2 ^ (Lmax - s + 1) - 1 ≤ 2 ^ (Lmax + 1) - 1 := by
    have : 2 ^ (Lmax - s + 1) ≤ 2 ^ (Lmax + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
    omega
  have hPhi : hcPhi c R D T0 Lmax C₁ δ ≤ (lam1' / M) ^ (2 ^ (Lmax - s + 1) - 1) :=
    pow_le_pow_of_le_one hb0 hb1 hexp
  exact (hC2 δ hδ0 hδ1).trans (hPhi.trans hpad)

end

section
open Filter Topology MeasureTheory

/-- **One phase step keeping the signed average** (the degree-one branch of
`patch:highest-control`: "Keep the signed average at this last step"). -/
theorem phaseLevel_step_re {N H C K : ℝ} (hN1 : 1 ≤ N) (hH : 0 < H) (hHN : H ≤ N / 4)
    (hC : 0 < C) (hK : 0 ≤ K) {r m : ℕ} (hm : 1 ≤ m) {f : ℕ → E3 → ℂ}
    {P : ℕ → Polynomial ℝ} {p : E3 → Polynomial ℝ} {j : ℕ → Fin 3}
    (hf1 : ∀ i y, ‖f i y‖ ≤ 1)
    (hFm : Measurable (Function.uncurry fun (x : E3) (t : ℝ) => phaseProd m f P p j x t))
    (hsupp : ∀ y, y ∉ petBox C N → f m y = 0)
    (hbd : ∀ t ∈ Set.Icc (0 : ℝ) N, |(P m).eval t| ≤ K * N ^ expo (j m))
    {g : E3 → ℂ} (hgm : Measurable g) (hg1 : ∀ x, ‖g x‖ ≤ 1) {Rg : ℝ}
    (hgR : ∀ x, Rg < ‖x‖ → g x = 0)
    (hgV : (∫ x, ‖g x‖ ^ 2) ≤ (volume (petBox (C + K) N)).toReal) (h : Fin r → ℝ) :
    ‖phaseLevel (volume (petBox (C + K) N)).toReal N C g r m f P p j h‖ ^ 2
      ≤ 2 * (∫ u : ℝ, fejer H u * (phaseLevel (volume (petBox (C + K) N)).toReal N C
          (boxInd (C + K) N) (r + 1) m f P p j (Fin.cons u h)).re) + 2 * H / N := by
  set V := (volume (petBox (C + K) N)).toReal with hVdef
  have hN : 0 < N := by linarith
  have hCK : 0 < C + K := by linarith
  have hV : 0 < V := by
    rw [hVdef, volume_petBox hCK.le hN.le, ENNReal.toReal_ofReal (by positivity)]
    positivity
  have hKV : (volume (petBox C N)).toReal ≤ V :=
    ENNReal.toReal_mono (volume_petBox_ne_top _ _)
      (measure_mono (petBox_mono (by linarith) hN.le))
  obtain ⟨hL, hL1⟩ := phaseHead_facts C N (P m) (j m)
  have hφm : Measurable (Function.uncurry fun (x : E3) (t : ℝ) =>
      phaseProdIter r m f P p j x h t) :=
    measurable_uncurry_phaseProdIter r m hFm h
  have hhead : ∀ y, y ∉ petBox C N → (phaseHead C N (P m) (j m)).1 y = 0 := fun y hy =>
    (Set.indicator_of_notMem hy _ : boxInd C N y = 0)
  have hid : ∀ u, |u| ≤ H → ∀ t ∈ Set.Icc (0 : ℝ) N, ∀ x,
      vecProd (vecChildren [phaseHead C N (P m) (j m)] 0 u) x t
          * phaseChild (fun x t => phaseProdIter r m f P p j x h t) 0 u x t
        = (fun _ => boxInd (C + K) N) u x * (vecProd ((fun _ => [phaseHead C N (P m) (j m)]) u) x t
          * (fun u x t => phaseProdIter (r + 1) m f P p j x (Fin.cons u h) t) u x t) := by
    intro u _ t ht x
    simp only
    rw [vecProd_phaseHead_mul hm hsupp P p j]
    have hz : boxInd (C + K) N x * phaseProdIter (r + 1) m f P p j x (Fin.cons u h) t
        = phaseProdIter (r + 1) m f P p j x (Fin.cons u h) t := by
      by_cases hx : x ∈ petBox (C + K) N
      · rw [boxInd, Set.indicator_of_mem hx, one_mul]
      · rw [phaseProdIter_eq_zero_of_notMem_scaled (r + 1) m f P p j (by linarith) hK hm hsupp
          (hbd t ht) hx, mul_zero]
    rw [hz, phaseProdIter_cons]
    have e1 := vecProd_phaseHead_mul hm hsupp P p j h x (t + u)
    have e2 := vecProd_phaseHead_mul hm hsupp P p j h x t
    rw [← e1, ← e2]
    simp only [vecChildren, List.flatMap_cons, List.flatMap_nil, List.append_nil, vecProd_cons,
      vecProd_nil, phaseChild, Pi.zero_apply, sub_zero, mul_one, map_mul]
    ring
  have hAm : Measurable fun u : ℝ => (vecAmp V N ((fun _ => boxInd (C + K) N) u)
      ((fun _ => [phaseHead C N (P m) (j m)]) u)
      ((fun u x t => phaseProdIter (r + 1) m f P p j x (Fin.cons u h) t) u)) := by
    have h1 := measurable_phaseLevel (V := V) (N := N) (C := C) (measurable_boxInd (C + K) N)
      (r + 1) m hFm
    have h2 : Measurable fun u : ℝ => (Fin.cons u h : Fin (r + 1) → ℝ) :=
      (measurable_fin_cons_real r).comp (measurable_id.prodMk measurable_const)
    exact h1.comp h2
  have hA1 : ∀ u, |u| ≤ H → ‖vecAmp V N ((fun _ => boxInd (C + K) N) u)
      ((fun _ => [phaseHead C N (P m) (j m)]) u)
      ((fun u x t => phaseProdIter (r + 1) m f P p j x (Fin.cons u h) t) u)‖ ≤ 1 := fun u _ =>
    norm_vecAmp_le_one hV hN (integrable_boxInd _ _) (le_of_eq (integral_norm_boxInd _ _)) hL1
      fun x t => norm_phaseProdIter_le_one (r + 1) m hf1 P p j x _ t
  exact vecAmp_step_re hN hH hHN hV hL hL1 hφm
    (fun x t => norm_phaseProdIter_le_one r m hf1 P p j x h t) (measurableSet_petBox C N)
    (isBounded_petBox C N) hhead hKV hgm hg1 hgR hgV continuous_const hid hAm hA1


theorem cubeShift_smul {s : ℕ} (a : ℝ) (h : Fin s → ℝ) (ω : Fin s → Bool) :
    cubeShift (fun i => a * h i) ω = a * cubeShift h ω := by
  simp only [cubeShift, Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  split_ifs <;> simp

/-- **The four-step cube of a single linear input is a translated raw cube**: for
`P(t) = a t + b`, `∏_ω C^{|ω|} f(x - P(t + ω·h) e) = Δ_{-a h} f (x - P(t) e)`. -/
theorem phaseProdIter_four_linear {f : ℕ → E3 → ℂ} {P : ℕ → Polynomial ℝ}
    {p : E3 → Polynomial ℝ} {j : ℕ → Fin 3} (hP1 : (P 1).natDegree ≤ 1) (x : E3)
    (hp : (p x).natDegree ≤ 3) (h : Fin 4 → ℝ) (t : ℝ) :
    phaseProdIter 4 1 f P p j x h t
      = fdiffIter (basisVec (j 1)) 4 (fun i => -(P 1).coeff 1 * h i) (f 1)
          (x - ((P 1).eval t) • basisVec (j 1)) := by
  rw [phaseProdIter_four_eq 1 f P p j x hp h t, fdiffIter_eq_cubeProd]
  refine Finset.prod_congr rfl fun ω _ => ?_
  simp only [Finset.Icc_self, Finset.prod_singleton]
  congr 2
  have hlin : ∀ u, (P 1).eval u = (P 1).coeff 1 * u + (P 1).coeff 0 := by
    intro u
    have e := Polynomial.eq_X_add_C_of_natDegree_le_one hP1
    conv_lhs => rw [e]
    simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X]
  rw [cubeShift_smul, hlin (t + cubeShift h ω), hlin t]
  module

open scoped Classical in
/-- **Level four of the degree-one branch is the raw order-four cube** (blueprint: "After the
four steps, translating `x` by its affine `P_1(t)` removes `t` and gives the raw order-four cube
of `f_1` with increments `lc(P_1) h_i e_1` directly"). -/
theorem phaseLevel_four_linear {V N C Kb : ℝ} (hN : 0 < N) (hKb : 0 ≤ Kb)
    {f : ℕ → E3 → ℂ} {P : ℕ → Polynomial ℝ} {p : E3 → Polynomial ℝ} {j : ℕ → Fin 3}
    (hf : Measurable (f 1)) (hf1 : ∀ y, ‖f 1 y‖ ≤ 1)
    (hsupp : ∀ y, y ∉ petBox C N → f 1 y = 0) (hP1 : (P 1).natDegree ≤ 1)
    (hp3 : ∀ x, (p x).natDegree ≤ 3)
    (hK : ∀ t ∈ Set.Icc (0 : ℝ) N, |(P 1).eval t| ≤ Kb * N ^ expo (j 1)) (h : Fin 4 → ℝ) :
    phaseLevel V N C (boxInd (C + Kb) N) 4 1 f P p j h
      = (V⁻¹ : ℝ) • ∫ x, fdiffIter (basisVec (j 1)) 4 (fun i => -(P 1).coeff 1 * h i) (f 1) x := by
  set v := basisVec (j 1) with hv
  set Φ : E3 → ℂ := fdiffIter v 4 (fun i => -(P 1).coeff 1 * h i) (f 1) with hΦ
  have hΦm : Measurable Φ := by
    have hc : Measurable ((fun q : (Fin 4 → ℝ) × E3 => fdiffIter v 4 q.1 (f 1) q.2) ∘
        fun y : E3 => (((fun i => -(P 1).coeff 1 * h i) : Fin 4 → ℝ), y)) :=
      (measurable_fdiffIter_joint v 4 hf).comp (measurable_const.prodMk measurable_id)
    exact hc
  have hΦ1 : ∀ y, ‖Φ y‖ ≤ ‖f 1 y‖ := fun y => norm_fdiffIter_le_self v 4 _ hf1 y
  have hΦs : ∀ y, y ∉ petBox C N → Φ y = 0 := fun y hy => by
    have := hΦ1 y; rw [hsupp y hy, norm_zero] at this; exact norm_le_zero_iff.mp this
  have hle : (0 : ℝ) ≤ 0 + N := by linarith
  -- the integrand for `t` in the window
  have hpt : ∀ x, ∀ t ∈ Set.Icc (0 : ℝ) N, boxInd (C + Kb) N x
      * (vecProd [phaseHead C N (P 1) (j 1)] x t * phaseProdIter 4 1 f P p j x h t)
      = Φ (x - ((P 1).eval t) • v) := by
    intro x t ht
    rw [vecProd_phaseHead_mul le_rfl hsupp P p j h x t, phaseProdIter_four_linear hP1 x (hp3 x)]
    by_cases hy : x - ((P 1).eval t) • v ∈ petBox C N
    · rw [boxInd, Set.indicator_of_mem (mem_petBox_of_sub_mem_scaled hKb hN.le (hK t ht) hy),
        one_mul]
    · rw [hΦs _ hy]; exact mul_eq_zero_of_right _ (hΦs _ hy)
  -- Fubini
  obtain ⟨R₀, hR₀⟩ := (isBounded_petBox C N).subset_closedBall (0 : E3)
  have hPc : Continuous fun t => (P 1).eval t := (P 1).continuous
  obtain ⟨B, hB⟩ : ∃ B, ∀ t ∈ Set.Icc (0 : ℝ) N, ‖((P 1).eval t) • v‖ ≤ B :=
    (isCompact_Icc.image_of_continuousOn (hPc.smul continuous_const).continuousOn).isBounded
      |>.exists_norm_le.imp fun B hB t ht => hB _ ⟨t, ht, rfl⟩
  have hsub : Set.Ioc (0 : ℝ) (0 + N) ⊆ Set.Icc 0 N := fun t ht => by
    rw [zero_add] at ht; exact ⟨ht.1.le, ht.2⟩
  have hGm : Measurable fun q : E3 × ℝ => Φ (q.1 - ((P 1).eval q.2) • v) :=
    hΦm.comp (measurable_fst.sub ((hPc.measurable.comp measurable_snd).smul_const v))
  have hint : Integrable (fun q : E3 × ℝ => Φ (q.1 - ((P 1).eval q.2) • v))
      ((volume : Measure E3).prod (volume.restrict (Set.Ioc (0 : ℝ) (0 + N)))) :=
    integrable_prod_restrict_of_bdd_ball measurableSet_Ioc measure_Ioc_lt_top.ne
      hGm.aestronglyMeasurable (C := 1) (R := R₀ + B)
      (fun q => (hΦ1 _).trans (hf1 _))
      (fun q hq hR => hΦs _ fun hmem => by
        have h1 := hR₀ hmem
        rw [Metric.mem_closedBall, dist_zero_right] at h1
        have h2 := norm_sub_norm_le q.1 (((P 1).eval q.2) • v)
        have h3 := hB q.2 (hsub hq)
        linarith)
  rw [phaseLevel, vecAmp]
  congr 1
  have hin : ∀ x, boxInd (C + Kb) N x * ((N⁻¹ : ℝ) • ∫ t in (0 : ℝ)..(0 + N),
        vecProd [phaseHead C N (P 1) (j 1)] x t * phaseProdIter 4 1 f P p j x h t)
      = (N⁻¹ : ℝ) • ∫ t in Set.Ioc (0 : ℝ) (0 + N), Φ (x - ((P 1).eval t) • v) := by
    intro x
    rw [mul_smul_comm, ← intervalIntegral.integral_const_mul, intervalIntegral.integral_of_le hle]
    congr 1
    exact setIntegral_congr_fun measurableSet_Ioc fun t ht => hpt x t (hsub ht)
  simp_rw [hin]
  rw [integral_smul, integral_integral_swap (f := fun x t => Φ (x - ((P 1).eval t) • v)) hint]
  have hconst : ∀ t, (∫ x, Φ (x - ((P 1).eval t) • v)) = ∫ x, Φ x := fun t =>
    integral_sub_right_eq_self Φ _
  simp_rw [hconst]
  rw [setIntegral_const, Measure.real, Real.volume_Ioc, zero_add, sub_zero,
    ENNReal.toReal_ofReal hN.le, smul_smul, inv_mul_cancel₀ hN.ne', one_smul]

end

section
open Filter Topology MeasureTheory

/-- The averaged raw cube at fixed nonzero gaps in the form of `patch:uniformize`. -/
theorem fejer_mean_cube_eq {V N H : ℝ} (hN : 0 < N) (hH : 0 < H) {F : E3 → ℂ}
    (hfm : Measurable F) (hfi : Integrable F) (hf1 : ∀ y, ‖F y‖ ≤ 1)
    (jm : Fin 3) {s : ℕ} (g : Fin s → ℝ) (hg : ∀ ν : Fin s, g ν ≠ 0) :
    (∫ w : Fin s → ℝ, (∏ l, fejer H (w l))
        * (V⁻¹ * (∫ x, fdiffIter (basisVec jm) s (fun i => g i * w i) F x).re))
      = V⁻¹ * N ^ (6 : ℕ) * ((((N ^ (6 : ℕ))⁻¹ : ℂ) * ∫ x : E3, ∫ w : Fin s → ℝ,
          fdiffIter (basisVec jm) s (fun i => |g i| * w i) F x
            * ∏ l, ((fejer H (w l) : ℝ) : ℂ)).re) := by
  set v := basisVec jm
  have hjm := measurable_fdiffIter_joint v s hfm
  -- the integrand on the product
  set Φ : (Fin s → ℝ) × E3 → ℂ := fun q =>
    ((∏ l, fejer H (q.1 l) : ℝ) : ℂ) * fdiffIter v s (fun i => g i * q.1 i) F q.2 with hΦ
  have hΦm : Measurable Φ := by
    have h1 : Measurable fun q : (Fin s → ℝ) × E3 =>
        fdiffIter v s (fun i => g i * q.1 i) F q.2 :=
      hjm.comp ((Measurable.of_eval fun i =>
        ((measurable_pi_apply i).comp measurable_fst).const_mul _).prodMk measurable_snd)
    exact ((measurable_prod_fejer s).comp measurable_fst).complex_ofReal.mul h1
  have hΦi : Integrable Φ ((volume : Measure (Fin s → ℝ)).prod (volume : Measure E3)) := by
    refine Integrable.mono' ((integrable_prod_fejer hH s).mul_prod hfi.norm)
      hΦm.aestronglyMeasurable (.of_forall fun q => ?_)
    simp only [hΦ, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (prod_fejer_nonneg hH q.1)]
    exact mul_le_mul_of_nonneg_left (norm_fdiffIter_le_self v s _ hf1 q.2)
      (prod_fejer_nonneg hH q.1)
  -- pull the real part out of the average over the shifts
  have hZ : ∀ w : Fin s → ℝ, (∏ l, fejer H (w l))
        * (V⁻¹ * (∫ x, fdiffIter v s (fun i => g i * w i) F x).re)
      = V⁻¹ * (∫ x : E3, Φ (w, x)).re := by
    intro w
    simp only [hΦ]
    rw [integral_const_mul, Complex.re_ofReal_mul]
    ring
  simp_rw [hZ]
  rw [integral_const_mul, integral_re_of_integrable hΦi.integral_prod_left,
    integral_integral_swap hΦi]
  -- flip the signs inside
  have hσ : ∀ l, (g l / |g l|) * (g l / |g l|) = 1 := fun l => by
    have h0 : |g l| ≠ 0 := abs_ne_zero.mpr (hg l)
    rw [div_mul_div_comm, ← abs_mul_abs_self (g l), div_self (mul_ne_zero h0 h0)]
  have hflip : ∀ x : E3, (∫ w : Fin s → ℝ, Φ (w, x))
      = ∫ w : Fin s → ℝ, fdiffIter v s (fun i => |g i| * w i) F x
          * ∏ l, ((fejer H (w l) : ℝ) : ℂ) := by
    intro x
    have key := integral_fejer_signFlip (H := H) (fun l => g l / |g l|) hσ
      (fun w => fdiffIter v s (fun i => |g i| * w i) F x)
    rw [← key]
    refine integral_congr_ae (.of_forall fun w => ?_)
    simp only [hΦ, Complex.ofReal_prod]
    rw [mul_comm]
    congr 3
    funext i
    have h0 : |g i| ≠ 0 := abs_ne_zero.mpr (hg i)
    field_simp
  simp_rw [hflip]
  have hN6 : (N ^ (6 : ℕ) : ℝ) ≠ 0 := by positivity
  rw [show ((N ^ (6 : ℕ))⁻¹ : ℂ) = (((N ^ (6 : ℕ))⁻¹ : ℝ) : ℂ) by push_cast; ring,
    Complex.re_ofReal_mul]
  field_simp

/-- **`patch:uniformize` for a raw cube at fixed nonzero gaps.** -/
theorem sq_fejer_mean_cube_le {V N H C' L : ℝ} (hN : 0 < N) (hH : 0 < H) (hL : 0 < L)
    (hC' : 0 ≤ C') {F : E3 → ℂ} (hfm : Nice F) (hf1 : ∀ y, ‖F y‖ ≤ 1)
    (hsupp : ∀ y, y ∉ petBox C' N → F y = 0) (jm : Fin 3)
    (hLS : L ≤ 2 * (C' * N ^ expo jm)) {s : ℕ} (g : Fin s → ℝ) (hg : ∀ ν : Fin s, g ν ≠ 0)
    (hhalf : ∀ ν : Fin s, |g ν| * H ≤ L / 2) :
    (∫ w : Fin s → ℝ, (∏ l, fejer H (w l))
        * (V⁻¹ * (∫ x, fdiffIter (basisVec jm) s (fun i => g i * w i) F x).re)) ^ 2
      ≤ (V⁻¹ * N ^ (6 : ℕ)) ^ 2 * (16 * C' ^ 3 * ((∏ ν : Fin s,
          2 * L / (|g ν| * H)) * (locUnifPow N L jm (s + 1) F).re)) := by
  rw [fejer_mean_cube_eq hN hH hfm.continuous.measurable hfm.integrable hf1 jm g hg, mul_pow]
  refine mul_le_mul_of_nonneg_left ?_ (sq_nonneg _)
  have hc : ∀ ν : Fin s, 0 < |g ν| := fun ν => abs_pos.mpr (hg ν)
  refine sq_re_gapScaled_le_locUnifPow hL hC' hN jm hLS hc hH hhalf hfm hf1 hsupp ?_
  intro x
  have h1 : Measurable fun z : Fin s → ℝ =>
      ∏ l : Fin s, fejer (|g l| * H) (z l) :=
    Finset.measurable_prod _ fun l _ => continuous_fejer.measurable.comp (measurable_pi_apply l)
  have h2 : Measurable fun z : Fin s → ℝ => fdiffIter (basisVec jm) s z F x :=
    (measurable_fdiffIter_joint (basisVec jm) s hfm.continuous.measurable).comp
      (measurable_id.prodMk measurable_const)
  exact (h1.complex_ofReal.mul h2).aestronglyMeasurable

end

section
open Filter Topology MeasureTheory

/-! ### The degree-one branch of `patch:highest-control` -/

/-- Level-zero lower bound of the degree-one branch. -/
noncomputable def d1Lam (c : ℕ) (δ : ℝ) : ℝ := budLo c δ / (8 * (3 * budHi c δ) ^ 3)

/-- Shift radius `H/N` of the degree-one branch. -/
noncomputable def d1EpsH (c : ℕ) (δ : ℝ) : ℝ := min (1 / 32) (d1Lam c δ ^ 16 / (16 * hcCT 4))

/-- The lower bound `κ` on the degree-one terminal mean. -/
noncomputable def d1Kappa (c : ℕ) (δ : ℝ) : ℝ := d1Lam c δ ^ 16 / (2 * hcCT 4)

/-- The radius comparison factor of the degree-one branch. -/
noncomputable def d1G (c : ℕ) (δ : ℝ) : ℝ := 2 * budHi c δ / (budLo c δ * d1EpsH c δ)

/-- The final lower bound of the degree-one branch. -/
noncomputable def d1Phi (c : ℕ) (δ : ℝ) : ℝ :=
  d1Kappa c δ ^ 2 * 64 / (16 * budHi c δ ^ 3 * d1G c δ ^ 4)

section
variable {c : ℕ} (hc : 1 ≤ c)
include hc

theorem monoLow_d1Lam : MonoLow (d1Lam c) :=
  (monoLow_budLo hc).div ((monoHigh_const (by norm_num : (0 : ℝ) < 8)).mul
    (((monoHigh_const (by norm_num : (0 : ℝ) < 3)).mul (monoHigh_budHi hc)).pow 3))

theorem monoLow_d1EpsH : MonoLow (d1EpsH c) :=
  (((monoLow_d1Lam hc).pow 16).div (monoHigh_const (by unfold hcCT; positivity))).min_const
    (by norm_num)

theorem monoLow_d1Kappa : MonoLow (d1Kappa c) :=
  ((monoLow_d1Lam hc).pow 16).div (monoHigh_const (by unfold hcCT; positivity))

theorem monoHigh_d1G : MonoHigh (d1G c) :=
  ((monoHigh_const (by norm_num : (0 : ℝ) < 2)).mul (monoHigh_budHi hc)).div
    ((monoLow_budLo hc).mul (monoLow_d1EpsH hc))

theorem monoLow_d1Phi : MonoLow (d1Phi c) :=
  (((monoLow_d1Kappa hc).pow 2).mul (monoLow_const (by norm_num : (0 : ℝ) < 64))).div
    (((monoHigh_const (by norm_num : (0 : ℝ) < 16)).mul ((monoHigh_budHi hc).pow 3)).mul
      ((monoHigh_d1G hc).pow 4))

end

/-- The chain of the degree-one branch: four phase levels, the last one signed. -/
noncomputable def d1Level (V N C Cs : ℝ) (f : ℕ → E3 → ℂ) (P : ℕ → Polynomial ℝ)
    (p : E3 → Polynomial ℝ) (j : ℕ → Fin 3) (k : ℕ) (h : Fin k → ℝ) : ℝ :=
  if k = 0 then ‖phaseLevel V N C (f 0) k 1 f P p j h‖
  else if k < 4 then ‖phaseLevel V N C (boxInd Cs N) k 1 f P p j h‖
  else if k = 4 then (phaseLevel V N C (boxInd Cs N) k 1 f P p j h).re
  else 0

/-- **`patch:cs-loss` for the degree-one branch.** -/
theorem d1_chain {N H C Kb : ℝ} (hN1 : 1 ≤ N) (hH : 0 < H) (hHN : H ≤ N / 4) (hC : 0 < C)
    (hKb : 0 ≤ Kb) {f : ℕ → E3 → ℂ} {P : ℕ → Polynomial ℝ} {p : E3 → Polynomial ℝ}
    {j : ℕ → Fin 3} (hf : ∀ i, Measurable (f i)) (hf1 : ∀ i y, ‖f i y‖ ≤ 1)
    (hfs : ∀ i y, y ∉ petBox C N → f i y = 0)
    (hFm : Measurable (Function.uncurry fun (x : E3) (t : ℝ) => phaseProd 1 f P p j x t))
    (hbd : ∀ t ∈ Set.Icc (0 : ℝ) N, |(P 1).eval t| ≤ Kb * N ^ expo (j 1)) :
    d1Level (volume (petBox (C + Kb) N)).toReal N C (C + Kb) f P p j 0 Fin.elim0 ^ (2 ^ 4)
      ≤ 2 ^ (2 ^ 4) / 2 * (max (fejerMean H 4
          (d1Level (volume (petBox (C + Kb) N)).toReal N C (C + Kb) f P p j 4)) 0
        + ((4 : ℕ) : ℝ) * (H / N)) := by
  set V := (volume (petBox (C + Kb) N)).toReal with hVdef
  have hN : 0 < N := by linarith
  have hCs : 0 < C + Kb := by linarith
  have hV : 0 < V := by
    rw [hVdef, volume_petBox hCs.le hN.le, ENNReal.toReal_ofReal (by positivity)]; positivity
  have hvolC : (volume (petBox C N)).toReal ≤ V :=
    ENNReal.toReal_mono (volume_petBox_ne_top _ _) (measure_mono (petBox_mono (by linarith) hN.le))
  obtain ⟨⟨R0, hR0⟩, hi0, hL0, hsq0⟩ := block_facts_of_support (hf 0) (hf1 0)
    (measurableSet_petBox C N) (isBounded_petBox C N) hvolC (hfs 0)
  have hbox1 : ∀ k (h : Fin k → ℝ), ‖phaseLevel V N C (boxInd (C + Kb) N) k 1 f P p j h‖ ≤ 1 :=
    fun k h => phaseLevel_norm_le_one hV hN (integrable_boxInd _ _)
      (le_of_eq (integral_norm_boxInd _ _)) hf1 P p j h
  have hf01 : ∀ k (h : Fin k → ℝ), ‖phaseLevel V N C (f 0) k 1 f P p j h‖ ≤ 1 :=
    fun k h => phaseLevel_norm_le_one hV hN hi0 hL0 hf1 P p j h
  have h2H : 2 * H / N = 2 * (H / N) := by ring
  refine fejerChain_box (T := 4) hH (div_nonneg hH.le hN.le) (fun k => ?_) (fun k h _ => ?_)
    (fun k hk h _ => ?_) (fun k hk h hh => ?_)
  · unfold d1Level
    split_ifs
    · exact (measurable_phaseLevel (hf 0) k 1 hFm).norm
    · exact (measurable_phaseLevel (measurable_boxInd _ N) k 1 hFm).norm
    · exact Complex.measurable_re.comp (measurable_phaseLevel (measurable_boxInd _ N) k 1 hFm)
    · exact measurable_const
  · unfold d1Level
    split_ifs
    · rw [abs_of_nonneg (norm_nonneg _)]; exact hf01 k h
    · rw [abs_of_nonneg (norm_nonneg _)]; exact hbox1 k h
    · exact (Complex.abs_re_le_norm _).trans (hbox1 k h)
    · simp
  · unfold d1Level
    split_ifs <;> exact norm_nonneg _
  · have hstep_norm : ∀ g : E3 → ℂ, Measurable g → (∀ x, ‖g x‖ ≤ 1) →
        (∃ R, ∀ x, R < ‖x‖ → g x = 0) → (∫ x, ‖g x‖ ^ 2) ≤ V →
        ‖phaseLevel V N C g k 1 f P p j h‖ ^ 2 ≤ 2 * (∫ u : ℝ, fejer H u
          * ‖phaseLevel V N C (boxInd (C + Kb) N) (k + 1) 1 f P p j (Fin.cons u h)‖)
          + 2 * (H / N) := by
      intro g hgm hg1 hgR hgV
      obtain ⟨Rg, hRg⟩ := hgR
      rw [← h2H]
      exact phaseLevel_step hN1 hH hHN hC hKb le_rfl hf1 hFm (hfs 1) hbd hgm hg1 hRg hgV h
    have hstep_re : ∀ g : E3 → ℂ, Measurable g → (∀ x, ‖g x‖ ≤ 1) →
        (∃ R, ∀ x, R < ‖x‖ → g x = 0) → (∫ x, ‖g x‖ ^ 2) ≤ V →
        ‖phaseLevel V N C g k 1 f P p j h‖ ^ 2 ≤ 2 * (∫ u : ℝ, fejer H u
          * (phaseLevel V N C (boxInd (C + Kb) N) (k + 1) 1 f P p j (Fin.cons u h)).re)
          + 2 * (H / N) := by
      intro g hgm hg1 hgR hgV
      obtain ⟨Rg, hRg⟩ := hgR
      rw [← h2H]
      exact phaseLevel_step_re hN1 hH hHN hC hKb le_rfl hf1 hFm (hfs 1) hbd hgm hg1 hRg hgV h
    have hgbox : (∃ R, ∀ x, R < ‖x‖ → boxInd (C + Kb) N x = 0) :=
      ⟨_, fun x hx => boxInd_eq_zero hx⟩
    by_cases hk0 : k = 0
    · subst hk0
      have e1 : ∀ u, d1Level V N C (C + Kb) f P p j (0 + 1) (Fin.cons u h)
          = ‖phaseLevel V N C (boxInd (C + Kb) N) (0 + 1) 1 f P p j (Fin.cons u h)‖ := by
        intro u; simp [d1Level]
      simp only [d1Level] at *
      simp_rw [e1]
      exact hstep_norm (f 0) (hf 0) (hf1 0) ⟨R0, hR0⟩ hsq0
    · have e0 : d1Level V N C (C + Kb) f P p j k h
          = ‖phaseLevel V N C (boxInd (C + Kb) N) k 1 f P p j h‖ := by
        simp [d1Level, hk0, hk]
      rw [e0]
      by_cases hk3 : k + 1 < 4
      · have e1 : ∀ u, d1Level V N C (C + Kb) f P p j (k + 1) (Fin.cons u h)
            = ‖phaseLevel V N C (boxInd (C + Kb) N) (k + 1) 1 f P p j (Fin.cons u h)‖ := by
          intro u; simp [d1Level, hk3]
        simp_rw [e1]
        exact hstep_norm _ (measurable_boxInd _ N) (norm_boxInd_le _ N) hgbox
          (le_of_eq (integral_sq_boxInd _ N))
      · have e1 : ∀ u, d1Level V N C (C + Kb) f P p j (k + 1) (Fin.cons u h)
            = (phaseLevel V N C (boxInd (C + Kb) N) (k + 1) 1 f P p j (Fin.cons u h)).re := by
          intro u; simp [d1Level, show k + 1 = 4 by omega]
        simp_rw [e1]
        exact hstep_re _ (measurable_boxInd _ N) (norm_boxInd_le _ N) hgbox
          (le_of_eq (integral_sq_boxInd _ N))

set_option maxHeartbeats 1000000 in
-- The proof assembles the chain and the budgets in one context.
/-- **`patch:highest-control`, the degree-one branch**, continuous protected input: "If the
highest active degree is one, there is only one active input. After the four steps, translating
`x` by its affine `P_1(t)` removes `t` and gives the raw order-four cube of `f_1` ... Its radius
is `|lc(P_1)| H` ... Uniformize and pad as above." -/
theorem highestControl_one (j : ℕ → Fin 3) (hj1 : expo (j 1) = 1) (c : ℕ) (hc : 1 ≤ c) :
    ∃ C₂ : ℕ, 1 ≤ C₂ ∧ ∀ δ N : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ N →
      ∀ (P : ℕ → Polynomial ℝ) (f : ℕ → E3 → ℂ) (p : E3 → Polynomial ℝ),
        AdmissiblePoly c δ N (expo (j 1)) (P 1) →
        (∀ i, Measurable (f i)) → (∀ i y, ‖f i y‖ ≤ 1) →
        (∀ i y, y ∉ petBox (budHi c δ) N → f i y = 0) → Nice (f 1) →
        Measurable (Function.uncurry fun (x : E3) (t : ℝ) => phaseProd 1 f P p j x t) →
        (∀ x, (p x).natDegree ≤ 3) →
        budLo c δ * N ^ (6 : ℕ) ≤ ‖phaseCorr N 1 f P p j‖ →
        budLo C₂ δ ≤ (locUnifPow N (budHi c δ * N ^ expo (j 1)) (j 1) 5 (f 1)).re := by
  obtain ⟨C₂, hC21, hC2⟩ := (monoLow_d1Phi hc).exists_budLo
  refine ⟨C₂, hC21, ?_⟩
  intro δ N hδ0 hδ1 hN1 P f p hadm hf hf1 hfs hfm hFm hp3 hcorr
  have hN0 : (0 : ℝ) < N := by linarith
  set C := budHi c δ with hCdef
  have hC0 : 0 < C := budHi_pos hδ0 hc
  have hC1 : 1 ≤ C := one_le_budHi hδ0 hδ1 hc
  set Kb := 2 * C with hKbdef
  have hKb : 0 ≤ Kb := by positivity
  have hdeg1 : (P 1).natDegree = 1 := by rw [hadm.natDegree_eq, hj1]
  have hbd : ∀ t ∈ Set.Icc (0 : ℝ) N, |(P 1).eval t| ≤ Kb * N ^ expo (j 1) := by
    intro t ht
    have h1 := hadm.abs_eval_le hδ0 hc hN0.le ht.1 ht.2
    rw [hj1] at h1 ⊢
    rw [← hCdef] at h1
    have e2 : ((1 : ℕ) : ℝ) + 1 = 2 := by norm_num
    rw [e2] at h1
    exact h1
  set εH := d1EpsH c δ with hεHdef
  have hεH0 : 0 < εH := (monoLow_d1EpsH hc).pos hδ0 hδ1
  have hεH1 : εH ≤ 1 / 32 := min_le_left _ _
  set H := εH * N with hHdef
  have hH : 0 < H := by positivity
  have hHN : H ≤ N / 4 := by rw [hHdef]; nlinarith
  have hchain := d1_chain hN1 hH hHN hC0 hKb hf hf1 hfs hFm hbd
  set V := (volume (petBox (C + Kb) N)).toReal with hVdef
  have hCsKb : C + Kb = 3 * C := by rw [hKbdef]; ring
  have hVeq : V = 8 * (3 * C) ^ 3 * N ^ (6 : ℕ) := by
    rw [hVdef, volume_petBox (by positivity) hN0.le, ENNReal.toReal_ofReal (by positivity), hCsKb]
  have hV : 0 < V := by rw [hVeq]; positivity
  -- level zero
  set lam := d1Lam c δ with hlamdef
  have hlam0 : 0 < lam := (monoLow_d1Lam hc).pos hδ0 hδ1
  have hlam1 : lam ≤ 1 := by
    rw [hlamdef, d1Lam, ← hCdef, div_le_one (by positivity)]
    have h1 := budLo_le_one hδ0 hδ1 hc
    have : (1 : ℝ) ≤ (3 * C) ^ 3 := one_le_pow₀ (by linarith)
    linarith
  have hlam : lam ≤ d1Level V N C (C + Kb) f P p j 0 Fin.elim0 := by
    have e : d1Level V N C (C + Kb) f P p j 0 Fin.elim0
        = ‖phaseLevel V N C (f 0) 0 1 f P p j Fin.elim0‖ := by simp [d1Level]
    rw [e, norm_phaseLevel_zero_eq le_rfl (hfs 1) P p j hV, hVeq, hlamdef, d1Lam, ← hCdef,
      le_inv_mul_iff₀ (by positivity)]
    calc 8 * (3 * C) ^ 3 * N ^ (6 : ℕ) * (budLo c δ / (8 * (3 * C) ^ 3))
        = budLo c δ * N ^ (6 : ℕ) := by field_simp
      _ ≤ ‖phaseCorr N 1 f P p j‖ := hcorr
  have hsmall : ((4 : ℕ) : ℝ) * (H / N) ≤ lam ^ (2 ^ 4) / (4 * (2 ^ (2 ^ 4) / 2)) := by
    have hHN' : H / N = εH := by rw [hHdef]; field_simp
    rw [hHN']
    have h2 : εH ≤ lam ^ 16 / (16 * hcCT 4) := min_le_right _ _
    have e : hcCT 4 = 2 ^ (2 ^ 4) / 2 := rfl
    rw [e] at h2
    norm_num at h2 ⊢
    linarith [h2]
  have hQ := chain_mean_lower (tot := 4) (T0 := 4) le_rfl hlam hlam0 hlam1 hchain
    (div_nonneg hH.le hN0.le) hsmall
  -- the terminal mean is the averaged raw cube
  set a := (P 1).coeff 1 with hadef
  have hlc : (P 1).leadingCoeff = a := by rw [Polynomial.leadingCoeff, hdeg1]
  have ha : a ≠ 0 := by rw [← hlc]; exact hadm.leadingCoeff_ne_zero hδ0 hc
  set g : Fin 4 → ℝ := fun _ => -a with hgdef
  have hterm : ∀ h : Fin 4 → ℝ, d1Level V N C (C + Kb) f P p j 4 h
      = V⁻¹ * (∫ x, fdiffIter (basisVec (j 1)) 4 (fun i => g i * h i) (f 1) x).re := by
    intro h
    simp only [d1Level, show (4 : ℕ) ≠ 0 by norm_num, ite_false, lt_irrefl, ite_true]
    rw [phaseLevel_four_linear hN0 hKb (hf 1) (hf1 1) (hfs 1) hdeg1.le hp3 hbd h,
      Complex.smul_re]
    rfl
  have hQ' : lam ^ (2 ^ 4) / (2 * (2 ^ (2 ^ 4) / 2)) ≤ ∫ h : Fin 4 → ℝ, (∏ l, fejer H (h l))
      * (V⁻¹ * (∫ x, fdiffIter (basisVec (j 1)) 4 (fun i => g i * h i) (f 1) x).re) := by
    have h0 := hQ
    rw [fejerMean] at h0
    simp_rw [hterm] at h0
    exact h0
  -- uniformize
  set L := C * N ^ expo (j 1) with hLdef
  have hLpos : 0 < L := by positivity
  have hLS : L ≤ 2 * (C * N ^ expo (j 1)) := by rw [hLdef]; linarith
  have hg : ∀ ν : Fin 4, g ν ≠ 0 := fun ν => neg_ne_zero.mpr ha
  have hga : ∀ ν : Fin 4, |g ν| = |a| := fun ν => abs_neg a
  have halo : budLo c δ ≤ |a| := by rw [← hlc]; exact hadm.budLo_le
  have hahi : |a| ≤ C := by rw [← hlc]; exact hadm.le_budHi
  have hhalf : ∀ ν : Fin 4, |g ν| * H ≤ L / 2 := by
    intro ν
    rw [hga ν, hLdef, hj1, pow_one, hHdef]
    have hεN : εH * N ≤ N / 32 := by nlinarith
    have h1 : |a| * (εH * N) ≤ C * (N / 32) :=
      mul_le_mul hahi hεN (by positivity) hC0.le
    have hCN := mul_pos hC0 hN0
    nlinarith
  have key := sq_fejer_mean_cube_le (V := V) hN0 hH hLpos hC0.le hfm (hf1 1) (hfs 1) (j 1) hLS
    g hg hhalf
  set X := (locUnifPow N L (j 1) (4 + 1) (f 1)).re with hXdef
  have hX0 : 0 ≤ X := locUnifPow_re_nonneg hLpos hN0 (j 1) 4 hfm (hf1 1)
  set κ := d1Kappa c δ with hκdef
  have hκ0 : 0 < κ := (monoLow_d1Kappa hc).pos hδ0 hδ1
  have hκeq : κ = lam ^ (2 ^ 4) / (2 * (2 ^ (2 ^ 4) / 2)) := by
    rw [hκdef, d1Kappa, hlamdef, hcCT]
    norm_num
  have hκQ := hκeq ▸ hQ'
  have hsq := pow_le_pow_left₀ hκ0.le hκQ 2
  have hVN : (V⁻¹ * N ^ (6 : ℕ)) ^ 2 ≤ 1 / 64 := by
    rw [hVeq]; exact sq_inv_box_le (by linarith) hN0
  set G := d1G c δ with hGdef
  have hbl0 : 0 < budLo c δ := budLo_pos hδ0 hc
  have hapos : 0 < |a| := abs_pos.mpr ha
  have hratio : 2 * L / (|a| * H) ≤ G := by
    rw [hGdef, d1G, ← hCdef, ← hεHdef, hLdef, hHdef, hj1, pow_one]
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    have h3 : budLo c δ * εH * N ≤ |a| * εH * N :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right halo hεH0.le) hN0.le
    calc 2 * (C * N) * (budLo c δ * εH) = 2 * C * (budLo c δ * εH * N) := by ring
      _ ≤ 2 * C * (|a| * εH * N) := mul_le_mul_of_nonneg_left h3 (by positivity)
      _ = 2 * C * (|a| * (εH * N)) := by ring
  have hprod : (∏ ν : Fin 4, 2 * L / (|g ν| * H)) ≤ G ^ 4 := by
    simp_rw [hga]
    rw [Fin.prod_const]
    exact pow_le_pow_left₀ (by positivity) hratio 4
  have hC3 : 0 < 16 * C ^ 3 := by positivity
  have hG0 : 0 < G := lt_of_lt_of_le (by positivity) hratio
  have hfin : d1Phi c δ ≤ X := by
    rw [d1Phi, ← hκdef, ← hCdef, ← hGdef, div_le_iff₀ (by positivity)]
    have h1 : κ ^ 2 ≤ 1 / 64 * (16 * C ^ 3 * (G ^ 4 * X)) := by
      refine hsq.trans (key.trans ?_)
      refine mul_le_mul hVN (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hprod hX0)
        hC3.le) (by positivity) (by norm_num)
    calc κ ^ 2 * 64 ≤ (1 / 64 * (16 * C ^ 3 * (G ^ 4 * X))) * 64 :=
          mul_le_mul_of_nonneg_right h1 (by norm_num)
      _ = X * (16 * C ^ 3 * G ^ 4) := by ring
  exact (hC2 δ hδ0 hδ1).trans hfin

end

section
open Filter Topology MeasureTheory

/-- **Proposition `patch:highest-control` (highest-active-input control, including measurable
polynomial phases), for a continuous protected input.** Fix the directions `j` of the active
inputs `1, …, m`, whose degrees `d_i = expo (j i)` increase towards the protected input `m`, and
an input budget `c`. There are an order `s₀` and budgets `C₁`, `C₂` such that for `0 < δ ≤ 1`,
`N ≥ 1`, admissible `P_i`, Borel one-bounded inputs supported in the budget box (the protected one
continuous), and a phase `p_x` of degree at most three with measurable coefficients, the lower bound
`|∫ f_0(x) E_{t ∈ [0,N]} ∏ f_i(x - P_i(t) e_i) e(p_x(t)) dx| ≥ ℓ_c(δ) N^6` implies
`Q_{s₀, H}(f_m) ≥ ℓ_{C₂}(δ)` at the radius `H = u_{C₁}(δ) N^{d_m}`. The radius and the lower bound
carry separate budgets (see `automation/ErrorReport.md`). -/
theorem highestControl_nice (m : ℕ) (hm1 : 1 ≤ m) (j : ℕ → Fin 3)
    (hj : ∀ i ∈ Finset.Icc 1 m, i ≠ m → expo (j i) < expo (j m)) (c : ℕ) (hc : 1 ≤ c) :
    ∃ s₀ C₁ C₂ : ℕ, 1 ≤ C₁ ∧ 1 ≤ C₂ ∧ ∀ δ N : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ N →
      ∀ (P : ℕ → Polynomial ℝ) (f : ℕ → E3 → ℂ) (p : E3 → Polynomial ℝ),
        (∀ i ∈ Finset.Icc 1 m, AdmissiblePoly c δ N (expo (j i)) (P i)) →
        (∀ i, Measurable (f i)) → (∀ i y, ‖f i y‖ ≤ 1) →
        (∀ i y, y ∉ petBox (budHi c δ) N → f i y = 0) → Nice (f m) →
        Measurable (Function.uncurry fun (x : E3) (t : ℝ) => phaseProd m f P p j x t) →
        (∀ x, (p x).natDegree ≤ 3) →
        budLo c δ * N ^ (6 : ℕ) ≤ ‖phaseCorr N m f P p j‖ →
        budLo C₂ δ ≤ (locUnifPow N (budHi C₁ δ * N ^ expo (j m)) (j m) s₀ (f m)).re := by
  by_cases hD : 2 ≤ expo (j m)
  · exact highestControl_ge2 m hm1 j hD hj c hc
  · have hD1 : expo (j m) = 1 := by
      have : 1 ≤ expo (j m) := by simp [expo]
      omega
    have hm : m = 1 := by
      by_contra hne
      have h1 := hj 1 (Finset.mem_Icc.mpr ⟨le_rfl, hm1⟩) (Ne.symm hne)
      have : 1 ≤ expo (j 1) := by simp [expo]
      omega
    subst hm
    obtain ⟨C₂, hC21, hC2⟩ := highestControl_one j hD1 c hc
    refine ⟨5, c, C₂, hc, hC21, ?_⟩
    intro δ N hδ0 hδ1 hN1 P f p hadm hf hf1 hfs hfm hFm hp3 hcorr
    exact hC2 δ N hδ0 hδ1 hN1 P f p (hadm 1 (Finset.mem_Icc.mpr ⟨le_rfl, le_rfl⟩)) hf hf1 hfs
      hfm hFm hp3 hcorr

end

