theorem measurable_fdiffIter_fixed (v : E3) (s : ℕ) (h : Fin s → ℝ) {F : E3 → ℂ}
    (hF : Measurable F) : Measurable (fdiffIter v s h F) := by
  have hc : Measurable ((fun q : (Fin s → ℝ) × E3 => fdiffIter v s q.1 F q.2) ∘
      fun y : E3 => ((h, y) : (Fin s → ℝ) × E3)) :=
    (measurable_fdiffIter_joint v s hF).comp (measurable_const.prodMk measurable_id)
  exact hc

/-- **The iterated difference is `2^s`-Lipschitz in `L^1`** for one-bounded inputs. -/
theorem integral_norm_fdiffIter_sub_le (v : E3) : ∀ (s : ℕ) (h : Fin s → ℝ) {f g : E3 → ℂ},
    Measurable f → Measurable g → Integrable f → Integrable g →
    (∀ y, ‖f y‖ ≤ 1) → (∀ y, ‖g y‖ ≤ 1) →
    Integrable (fun x => ‖fdiffIter v s h f x - fdiffIter v s h g x‖)
      ∧ (∫ x, ‖fdiffIter v s h f x - fdiffIter v s h g x‖) ≤ 2 ^ s * ∫ x, ‖f x - g x‖
  | 0, h, f, g, hfm, hgm, hfi, hgi, _, _ => by
      simp only [fdiffIter_zero, pow_zero, one_mul]
      exact ⟨(hfi.sub hgi).norm, le_rfl⟩
  | (s + 1), h, f, g, hfm, hgm, hfi, hgi, hf1, hg1 => by
      set F := fdiffIter v s (fun i => h i.succ) f with hFdef
      set G := fdiffIter v s (fun i => h i.succ) g with hGdef
      obtain ⟨hI, hB⟩ := integral_norm_fdiffIter_sub_le v s (fun i => h i.succ) hfm hgm hfi hgi
        hf1 hg1
      have hF1 : ∀ y, ‖F y‖ ≤ 1 := fun y => norm_fdiffIter_le v s _ hf1 y
      have hG1 : ∀ y, ‖G y‖ ≤ 1 := fun y => norm_fdiffIter_le v s _ hg1 y
      have hpt : ∀ x, ‖fdiffIter v (s + 1) h f x - fdiffIter v (s + 1) h g x‖
          ≤ ‖F (x + h 0 • v) - G (x + h 0 • v)‖ + ‖F x - G x‖ := by
        intro x
        rw [fdiffIter_succ, fdiffIter_succ, fdiff, fdiff]
        have e : F (x + h 0 • v) * conj (F x) - G (x + h 0 • v) * conj (G x)
            = (F (x + h 0 • v) - G (x + h 0 • v)) * conj (F x)
              + G (x + h 0 • v) * conj (F x - G x) := by rw [map_sub]; ring
        rw [e]
        refine (norm_add_le _ _).trans (add_le_add ?_ ?_)
        · rw [norm_mul, Complex.norm_conj]
          exact mul_le_of_le_one_right (norm_nonneg _) (hF1 x)
        · rw [norm_mul, Complex.norm_conj]
          exact mul_le_of_le_one_left (norm_nonneg _) (hG1 _)
      have hIt : Integrable fun x => ‖F (x + h 0 • v) - G (x + h 0 • v)‖ :=
        hI.comp_add_right (h 0 • v)
      have hmeas : Measurable fun x => ‖fdiffIter v (s + 1) h f x - fdiffIter v (s + 1) h g x‖ :=
        ((measurable_fdiffIter_fixed v (s + 1) h hfm).sub
          (measurable_fdiffIter_fixed v (s + 1) h hgm)).norm
      refine ⟨Integrable.mono' (hIt.add hI) hmeas.aestronglyMeasurable
        (.of_forall fun x => by rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]; exact hpt x),
        ?_⟩
      calc (∫ x, ‖fdiffIter v (s + 1) h f x - fdiffIter v (s + 1) h g x‖)
          ≤ ∫ x, (‖F (x + h 0 • v) - G (x + h 0 • v)‖ + ‖F x - G x‖) :=
            integral_mono_of_nonneg (.of_forall fun x => norm_nonneg _) (hIt.add hI)
              (.of_forall hpt)
        _ = 2 * ∫ x, ‖F x - G x‖ := by
            rw [integral_add hIt hI,
              integral_add_right_eq_self (fun x => ‖F x - G x‖) (h 0 • v)]
            ring
        _ ≤ 2 * (2 ^ s * ∫ x, ‖f x - g x‖) := by linarith
        _ = 2 ^ (s + 1) * ∫ x, ‖f x - g x‖ := by ring

/-- **The uniformity power is Lipschitz in `L^1`**:
`|Re Q_s(f) - Re Q_s(g)| ≤ 2^s N^{-6} ‖f - g‖_1` for one-bounded integrable inputs. -/
theorem abs_re_locUnifPow_sub_le {N H : ℝ} (hH : 0 < H) (hN : 0 < N) (j : Fin 3) (s : ℕ)
    {f g : E3 → ℂ} (hfm : Measurable f) (hgm : Measurable g) (hfi : Integrable f)
    (hgi : Integrable g) (hf1 : ∀ y, ‖f y‖ ≤ 1) (hg1 : ∀ y, ‖g y‖ ≤ 1) :
    |(locUnifPow N H j s f).re - (locUnifPow N H j s g).re|
      ≤ 2 ^ s * ((N ^ (6 : ℕ))⁻¹ * ∫ x, ‖f x - g x‖) := by
  set v := basisVec j
  -- the integrands
  have hjoint : ∀ F : E3 → ℂ, Measurable F → Measurable fun q : E3 × (Fin s → ℝ) =>
      fdiffIter v s q.2 F q.1 * ∏ l, ((fejer H (q.2 l) : ℝ) : ℂ) := by
    intro F hF
    have h1 : Measurable fun q : E3 × (Fin s → ℝ) => fdiffIter v s q.2 F q.1 := by
      have hc : Measurable ((fun q : (Fin s → ℝ) × E3 => fdiffIter v s q.1 F q.2) ∘
          fun q : E3 × (Fin s → ℝ) => ((q.2, q.1) : (Fin s → ℝ) × E3)) :=
        (measurable_fdiffIter_joint v s hF).comp (measurable_snd.prodMk measurable_fst)
      exact hc
    have h2 : Measurable fun q : E3 × (Fin s → ℝ) => ∏ l, ((fejer H (q.2 l) : ℝ) : ℂ) := by
      simp_rw [← Complex.ofReal_prod]
      exact ((measurable_prod_fejer s).comp measurable_snd).complex_ofReal
    exact h1.mul h2
  have hprodint : ∀ F : E3 → ℂ, Integrable F → Integrable (fun q : E3 × (Fin s → ℝ) =>
      ‖F q.1‖ * ∏ l, fejer H (q.2 l)) ((volume : Measure E3).prod volume) :=
    fun F hF => hF.norm.mul_prod (integrable_prod_fejer hH s)
  have hΦint : ∀ F : E3 → ℂ, Measurable F → Integrable F → (∀ y, ‖F y‖ ≤ 1) →
      Integrable (fun q : E3 × (Fin s → ℝ) => fdiffIter v s q.2 F q.1
        * ∏ l, ((fejer H (q.2 l) : ℝ) : ℂ)) ((volume : Measure E3).prod volume) := by
    intro F hF hFi hF1
    refine Integrable.mono' (hprodint F hFi) (hjoint F hF).aestronglyMeasurable
      (.of_forall fun q => ?_)
    rw [norm_mul, ← Complex.ofReal_prod, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (prod_fejer_nonneg hH q.2)]
    exact mul_le_mul_of_nonneg_right (norm_fdiffIter_le_self v s _ hF1 q.1)
      (prod_fejer_nonneg hH q.2)
  have hIf := (hΦint f hfm hfi hf1).integral_prod_left
  have hIg := (hΦint g hgm hgi hg1).integral_prod_left
  have hsec : ∀ F : E3 → ℂ, Measurable F → Integrable F → (∀ y, ‖F y‖ ≤ 1) → ∀ x,
      Integrable fun h : Fin s → ℝ => fdiffIter v s h F x * ∏ l, ((fejer H (h l) : ℝ) : ℂ) := by
    intro F hF hFi hF1 x
    refine Integrable.mono' (integrable_prod_fejer hH s)
      ((hjoint F hF).comp (measurable_const.prodMk measurable_id)).aestronglyMeasurable
      (.of_forall fun h => ?_)
    rw [norm_mul, ← Complex.ofReal_prod, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (prod_fejer_nonneg hH h)]
    exact mul_le_of_le_one_left (prod_fejer_nonneg hH h) (norm_fdiffIter_le v s _ hF1 x)
  -- the difference
  have hdiff : locUnifPow N H j s f - locUnifPow N H j s g
      = ((N ^ (6 : ℕ))⁻¹ : ℂ) * ∫ x, ∫ h : Fin s → ℝ,
          (fdiffIter v s h f x - fdiffIter v s h g x) * ∏ l, ((fejer H (h l) : ℝ) : ℂ) := by
    rw [locUnifPow, locUnifPow, ← mul_sub, ← integral_sub hIf hIg]
    congr 1
    refine integral_congr_ae (.of_forall fun x => ?_)
    simp only
    rw [← integral_sub (hsec f hfm hfi hf1 x) (hsec g hgm hgi hg1 x)]
    congr 1
    funext h
    ring
  have hre : |(locUnifPow N H j s f).re - (locUnifPow N H j s g).re|
      ≤ ‖locUnifPow N H j s f - locUnifPow N H j s g‖ := by
    rw [← Complex.sub_re]; exact Complex.abs_re_le_norm _
  refine hre.trans ?_
  rw [hdiff, norm_mul, norm_inv, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hN]
  -- the bound by the absolute double integral
  set Ψ : E3 × (Fin s → ℝ) → ℝ := fun q =>
    ‖fdiffIter v s q.2 f q.1 - fdiffIter v s q.2 g q.1‖ * ∏ l, fejer H (q.2 l) with hΨ
  have hΨint : Integrable Ψ ((volume : Measure E3).prod volume) := by
    refine Integrable.mono' ((hprodint f hfi).add (hprodint g hgi))
      ((((hjoint f hfm).sub (hjoint g hgm)).norm).aestronglyMeasurable.congr ?_)
      (.of_forall fun q => ?_)
    · refine .of_forall fun q => ?_
      simp only [hΨ, Pi.sub_apply]
      rw [← sub_mul, norm_mul, ← Complex.ofReal_prod, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (prod_fejer_nonneg hH q.2)]
    · simp only [hΨ, Real.norm_eq_abs, Pi.add_apply]
      rw [abs_of_nonneg (mul_nonneg (norm_nonneg _) (prod_fejer_nonneg hH q.2)), ← add_mul]
      refine mul_le_mul_of_nonneg_right ((norm_sub_le _ _).trans (add_le_add
        (norm_fdiffIter_le_self v s _ hf1 q.1) (norm_fdiffIter_le_self v s _ hg1 q.1)))
        (prod_fejer_nonneg hH q.2)
  have h1 : ‖∫ x, ∫ h : Fin s → ℝ,
        (fdiffIter v s h f x - fdiffIter v s h g x) * ∏ l, ((fejer H (h l) : ℝ) : ℂ)‖
      ≤ ∫ x, ∫ h : Fin s → ℝ, Ψ (x, h) := by
    refine (norm_integral_le_integral_norm _).trans (integral_mono_of_nonneg
      (.of_forall fun x => norm_nonneg _) hΨint.integral_prod_left (.of_forall fun x => ?_))
    refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
    congr 1
    funext h
    simp only [hΨ, norm_mul, ← Complex.ofReal_prod, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (prod_fejer_nonneg hH h)]
  have h2 : (∫ x, ∫ h : Fin s → ℝ, Ψ (x, h)) ≤ 2 ^ s * ∫ x, ‖f x - g x‖ := by
    rw [integral_integral_swap (f := fun x h => Ψ (x, h)) hΨint]
    calc (∫ h : Fin s → ℝ, ∫ x, Ψ (x, h))
        = ∫ h : Fin s → ℝ, (∏ l, fejer H (h l))
            * ∫ x, ‖fdiffIter v s h f x - fdiffIter v s h g x‖ := by
          refine integral_congr_ae (.of_forall fun h => ?_)
          simp only [hΨ]
          rw [← integral_const_mul]
          congr 1; funext x; ring
      _ ≤ ∫ h : Fin s → ℝ, (∏ l, fejer H (h l)) * (2 ^ s * ∫ x, ‖f x - g x‖) := by
          refine integral_mono_of_nonneg (.of_forall fun h => by
            exact mul_nonneg (prod_fejer_nonneg hH h) (integral_nonneg fun _ => norm_nonneg _))
            ((integrable_prod_fejer hH s).mul_const _) (.of_forall fun h => ?_)
          exact mul_le_mul_of_nonneg_left
            (integral_norm_fdiffIter_sub_le v s h hfm hgm hfi hgi hf1 hg1).2
            (prod_fejer_nonneg hH h)
      _ = 2 ^ s * ∫ x, ‖f x - g x‖ := by
          rw [integral_mul_const, integral_prod_fejer hH s, one_mul]
  calc (N ^ (6 : ℕ))⁻¹ * ‖∫ x, ∫ h : Fin s → ℝ,
        (fdiffIter v s h f x - fdiffIter v s h g x) * ∏ l, ((fejer H (h l) : ℝ) : ℂ)‖
      ≤ (N ^ (6 : ℕ))⁻¹ * (2 ^ s * ∫ x, ‖f x - g x‖) :=
        mul_le_mul_of_nonneg_left (h1.trans h2) (by positivity)
    _ = 2 ^ s * ((N ^ (6 : ℕ))⁻¹ * ∫ x, ‖f x - g x‖) := by ring

end

section
open Filter Topology MeasureTheory

/-- The radial retraction onto the closed unit disk. -/
noncomputable def diskClamp (z : ℂ) : ℂ := (max 1 ‖z‖)⁻¹ • z

theorem continuous_diskClamp : Continuous diskClamp :=
  ((continuous_const.max continuous_norm).inv₀ fun z => by positivity).smul continuous_id

theorem norm_diskClamp_le (z : ℂ) : ‖diskClamp z‖ ≤ 1 := by
  rw [diskClamp, norm_smul, Real.norm_eq_abs, abs_of_pos (by positivity)]
  rw [inv_mul_le_iff₀ (by positivity)]
  rw [mul_one]; exact le_max_right 1 ‖z‖

/-- **The retraction is a nearest-point map**: it does not increase the distance to a point of
the disk. -/
theorem norm_diskClamp_sub_le (z : ℂ) {w : ℂ} (hw : ‖w‖ ≤ 1) :
    ‖diskClamp z - w‖ ≤ ‖z - w‖ := by
  rcases le_total ‖z‖ 1 with hz | hz
  · rw [diskClamp, max_eq_left hz, inv_one, one_smul]
  · rw [diskClamp, max_eq_right hz]
    have hz0 : 0 < ‖z‖ := by linarith
    set c := ‖z‖⁻¹ with hc
    have hcz : c * ‖z‖ = 1 := inv_mul_cancel₀ hz0.ne'
    have hc1 : c ≤ 1 := inv_le_one_of_one_le₀ hz
    have hc0 : 0 ≤ c := by positivity
    have hsq : ‖c • z - w‖ ^ 2 ≤ ‖z - w‖ ^ 2 := by
      rw [norm_sub_sq_real, norm_sub_sq_real, real_inner_smul_left, norm_smul, Real.norm_eq_abs,
        abs_of_nonneg hc0, hcz]
      have hin : inner ℝ z w ≤ ‖z‖ := (real_inner_le_norm z w).trans
        (mul_le_of_le_one_right hz0.le hw)
      have h1c : 0 ≤ 1 - c := by linarith
      nlinarith [mul_le_mul_of_nonneg_left hin h1c]
    exact (pow_le_pow_iff_left₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).mp hsq

theorem continuous_coord (i : Fin 3) : Continuous fun x : E3 => x i :=
  (continuous_apply i).comp (PiLp.continuous_ofLp 2 _)

theorem isClosed_petBox (C N : ℝ) : IsClosed (petBox C N) := by
  have : petBox C N = ⋂ i : Fin 3, (fun x : E3 => x i) ⁻¹'
      Set.Icc (-(C * N ^ expo i)) (C * N ^ expo i) := by
    ext x; simp [petBox]
  rw [this]
  exact isClosed_iInter fun i => isClosed_Icc.preimage (continuous_coord i)

/-- **A continuous cutoff of the budget box**: one on the box, zero off the box enlarged by one. -/
theorem exists_boxCutoff (C : ℝ) {N : ℝ} (hN : 0 < N) :
    ∃ χ : E3 → ℝ, Continuous χ ∧ (∀ x, χ x ∈ Set.Icc (0 : ℝ) 1)
      ∧ (∀ x ∈ petBox C N, χ x = 1) ∧ (∀ x, x ∉ petBox (C + 1) N → χ x = 0) := by
  set U : Set E3 := ⋂ i : Fin 3, {x : E3 | |x i| < (C + 1) * N ^ expo i} with hU
  have hUo : IsOpen U := isOpen_iInter_of_finite fun i =>
    isOpen_lt (continuous_abs.comp (continuous_coord i)) continuous_const
  have hsub : petBox C N ⊆ U := by
    intro x hx
    simp only [hU, Set.mem_iInter, Set.mem_ofPred_eq]
    intro i
    have h := hx i
    have hNi : 0 < N ^ expo i := pow_pos hN _
    rw [abs_lt]; constructor <;> nlinarith [h.1, h.2]
  have hU2 : U ⊆ petBox (C + 1) N := by
    intro x hx i
    simp only [hU, Set.mem_iInter, Set.mem_ofPred_eq] at hx
    have := abs_lt.mp (hx i)
    exact ⟨this.1.le, this.2.le⟩
  obtain ⟨χ, h0, h1, h01⟩ := exists_continuous_zero_one_of_isClosed hUo.isClosed_compl
    (isClosed_petBox C N) (Set.disjoint_compl_left_iff_subset.mpr hsub)
  exact ⟨χ, χ.continuous, h01, fun x hx => h1 hx, fun x hx => h0 (fun hxU => hx (hU2 hxU))⟩

/-- **Continuous one-bounded approximants in `L^1`** (`patch:conventions`: Borel representatives
are handled by approximation): a one-bounded Borel function supported in the budget box is
`L^1`-close to a continuous one-bounded function supported in the box enlarged by one. -/
theorem exists_nice_approx {C N : ℝ} (hN : 0 < N) {f : E3 → ℂ} (hfm : Measurable f)
    (hf1 : ∀ y, ‖f y‖ ≤ 1) (hfs : ∀ y, y ∉ petBox C N → f y = 0) {η : ℝ} (hη : 0 < η) :
    ∃ g : E3 → ℂ, Nice g ∧ (∀ y, ‖g y‖ ≤ 1) ∧ (∀ y, y ∉ petBox (C + 1) N → g y = 0)
      ∧ Integrable (fun y => f y - g y) ∧ (∫ y, ‖f y - g y‖) ≤ η := by
  obtain ⟨R₀, hR₀⟩ := (isBounded_petBox C N).subset_closedBall (0 : E3)
  have hfi : Integrable f := integrable_of_bdd_ball (R := R₀) hfm.aestronglyMeasurable hf1
    fun y hy => hfs y fun hm => by
      have := hR₀ hm; rw [Metric.mem_closedBall, dist_zero_right] at this; linarith
  obtain ⟨g0, -, hg0L, hg0c, hg0i⟩ := hfi.exists_hasCompactSupport_integral_sub_le hη
  obtain ⟨χ, hχc, hχ01, hχ1, hχ0⟩ := exists_boxCutoff C hN
  set g : E3 → ℂ := fun y => (χ y : ℂ) * diskClamp (g0 y) with hg
  have hgc : Continuous g :=
    (Complex.continuous_ofReal.comp hχc).mul (continuous_diskClamp.comp hg0c)
  have hg1 : ∀ y, ‖g y‖ ≤ 1 := fun y => by
    rw [hg, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hχ01 y).1]
    exact ((mul_le_of_le_one_left (norm_nonneg _) (hχ01 y).2).trans (norm_diskClamp_le _))
  have hgs : ∀ y, y ∉ petBox (C + 1) N → g y = 0 := fun y hy => by
    simp only [hg]; rw [hχ0 y hy, Complex.ofReal_zero, zero_mul]
  obtain ⟨R₁, hR₁⟩ := (isBounded_petBox (C + 1) N).subset_closedBall (0 : E3)
  have hgi : Integrable g := integrable_of_bdd_ball (R := R₁) hgc.aestronglyMeasurable hg1
    fun y hy => hgs y fun hm => by
      have := hR₁ hm; rw [Metric.mem_closedBall, dist_zero_right] at this; linarith
  have hpt : ∀ y, ‖f y - g y‖ ≤ ‖f y - g0 y‖ := by
    intro y
    by_cases hy : y ∈ petBox C N
    · simp only [hg]
      rw [hχ1 y hy, Complex.ofReal_one, one_mul, norm_sub_rev, norm_sub_rev (f y)]
      exact norm_diskClamp_sub_le _ (hf1 y)
    · simp only [hg]
      rw [hfs y hy, zero_sub, zero_sub, norm_neg, norm_neg, norm_mul, Complex.norm_real,
        Real.norm_eq_abs, abs_of_nonneg (hχ01 y).1]
      have h := norm_diskClamp_sub_le (g0 y) (w := 0) (by simp)
      rw [sub_zero, sub_zero] at h
      exact (mul_le_of_le_one_left (norm_nonneg _) (hχ01 y).2).trans h
  refine ⟨g, ⟨hgc, hgi, 1, hg1⟩, hg1, hgs, hfi.sub hgi, ?_⟩
  exact (integral_mono (hfi.sub hgi).norm (hfi.sub hg0i).norm hpt).trans hg0L

end

section
open Filter Topology MeasureTheory

theorem budLo_two_mul_le {δ : ℝ} (hδ0 : 0 < δ) (hδ1 : δ ≤ 1) {c : ℕ} (hc : 1 ≤ c) :
    budLo (2 * c) δ ≤ budLo c δ / 2 := by
  have hc0 : (0 : ℝ) < c := by exact_mod_cast hc
  rw [budLo, budLo]
  push_cast
  have : δ ^ (2 * c) ≤ δ ^ c := pow_le_pow_of_le_one hδ0.le hδ1 (by omega)
  have e : ((2 : ℝ) * c)⁻¹ * δ ^ c = (c : ℝ)⁻¹ * δ ^ c / 2 := by field_simp
  calc ((2 : ℝ) * c)⁻¹ * δ ^ (2 * c) ≤ ((2 : ℝ) * c)⁻¹ * δ ^ c :=
        mul_le_mul_of_nonneg_left this (by positivity)
    _ = _ := e

set_option maxHeartbeats 1000000 in
-- The proof combines the approximation with the continuous case in one context.
/-- **Proposition `patch:highest-control` (highest-active-input control, including measurable
polynomial phases).** Fix the directions `j` of the active inputs `1, …, m`, whose degrees
`d_i = expo (j i)` increase towards the protected input `m`, and an integer budget `c ≥ 1`.
There are an order `s₀` and budgets `C₁`, `C₂` such that for `0 < δ ≤ 1`, `N ≥ 1`, admissible
`P_i`, Borel inputs `f_0, …, f_m` bounded by one and supported in the budget box, and a phase
`p_x(t)` of degree at most three with Borel coefficients in `x`, the lower bound
`|∫ f_0(x) E_{t ∈ [0,N]} ∏ f_i(x - P_i(t) e_i) e(p_x(t)) dx| ≥ ℓ_c(δ) N^6` implies
`Q_{s₀, H}(f_m) ≥ ℓ_{C₂}(δ)` at the deterministic radius `H = u_{C₁}(δ) N^{d_m}`. The radius
and the lower bound carry separate budgets (see `automation/ErrorReport.md`). -/
theorem highestControl (m : ℕ) (hm1 : 1 ≤ m) (j : ℕ → Fin 3)
    (hj : ∀ i ∈ Finset.Icc 1 m, i ≠ m → expo (j i) < expo (j m)) (c : ℕ) (hc : 1 ≤ c) :
    ∃ s₀ C₁ C₂ : ℕ, 1 ≤ C₁ ∧ 1 ≤ C₂ ∧ ∀ δ N : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ N →
      ∀ (P : ℕ → Polynomial ℝ) (f : ℕ → E3 → ℂ) (p : E3 → Polynomial ℝ),
        (∀ i ∈ Finset.Icc 1 m, AdmissiblePoly c δ N (expo (j i)) (P i)) →
        (∀ i, Measurable (f i)) → (∀ i y, ‖f i y‖ ≤ 1) →
        (∀ i y, y ∉ petBox (budHi c δ) N → f i y = 0) →
        (∀ x, (p x).natDegree ≤ 3) → (∀ k, Measurable fun x => (p x).coeff k) →
        budLo c δ * N ^ (6 : ℕ) ≤ ‖phaseCorr N m f P p j‖ →
        budLo C₂ δ ≤ (locUnifPow N (budHi C₁ δ * N ^ expo (j m)) (j m) s₀ (f m)).re := by
  have hc2 : 1 ≤ 2 * c := by omega
  obtain ⟨s₀, C₁, C₂', hC1, hC2', hmain⟩ := highestControl_nice m hm1 j hj (2 * c) hc2
  refine ⟨s₀, C₁, 2 * C₂', hC1, by omega, ?_⟩
  intro δ N hδ0 hδ1 hN1 P f p hadm hf hf1 hfs hp3 hpc hcorr
  have hN0 : (0 : ℝ) < N := by linarith
  set C0 := budHi c δ with hC0def
  have hC01 : 1 ≤ C0 := one_le_budHi hδ0 hδ1 hc
  have hbl := budLo_pos hδ0 hc
  have hbl2 := budLo_pos hδ0 hC2'
  have hN6 : (0 : ℝ) < N ^ (6 : ℕ) := by positivity
  set η := min (budLo c δ * N ^ (6 : ℕ) / 2) (budLo C₂' δ * N ^ (6 : ℕ) / (2 * 2 ^ s₀)) with hηdef
  have hη : 0 < η := lt_min (by positivity) (by positivity)
  obtain ⟨g, hgn, hg1, hgs, hfgi, hfgL⟩ := exists_nice_approx hN0 (hf m) (hf1 m) (hfs m) hη
  set f' := Function.update f m g with hf'def
  have hf'm : f' m = g := Function.update_self _ _ _
  have hf'1 : ∀ i y, ‖f' i y‖ ≤ 1 := fun i y => by
    by_cases hi : i = m
    · subst hi; rw [hf'm]; exact hg1 y
    · rw [hf'def, Function.update_of_ne hi]; exact hf1 i y
  have hf'meas : ∀ i, Measurable (f' i) := fun i => by
    by_cases hi : i = m
    · subst hi; rw [hf'm]; exact hgn.continuous.measurable
    · rw [hf'def, Function.update_of_ne hi]; exact hf i
  -- the enlarged budget box
  have hbox : petBox (C0 + 1) N ⊆ petBox (budHi (2 * c) δ) N := by
    refine petBox_mono ?_ hN0.le
    have := budHi_mul_le hδ0 hδ1 hc (by norm_num : 1 ≤ 2)
    push_cast at this
    linarith
  have hf's : ∀ i y, y ∉ petBox (budHi (2 * c) δ) N → f' i y = 0 := by
    intro i y hy
    by_cases hi : i = m
    · subst hi; rw [hf'm]; exact hgs y fun h => hy (hbox h)
    · rw [hf'def, Function.update_of_ne hi]
      exact hfs i y fun h => hy (hbox (petBox_mono (by linarith) hN0.le h))
  have hadm' : ∀ i ∈ Finset.Icc 1 m, AdmissiblePoly (2 * c) δ N (expo (j i)) (P i) :=
    fun i hi => (hadm i hi).mono hδ0 hδ1 hc (by omega) hN0.le
  -- the correlation survives the replacement
  have hf0i : Integrable (f 0) := by
    obtain ⟨R₀, hR₀⟩ := (isBounded_petBox C0 N).subset_closedBall (0 : E3)
    exact integrable_of_bdd_ball (R := R₀) (hf 0).aestronglyMeasurable (hf1 0) fun y hy =>
      hfs 0 y fun hm => by
        have := hR₀ hm; rw [Metric.mem_closedBall, dist_zero_right] at this; linarith
  have hdiff := norm_phaseCorr_update_sub_le hN0 hm1 hf hf1 hgn.continuous.measurable hg1 hfgi
    hf0i P hp3 hpc j
  have hcorr' : budLo (2 * c) δ * N ^ (6 : ℕ) ≤ ‖phaseCorr N m f' P p j‖ := by
    have h1 : ‖phaseCorr N m f P p j‖ - ‖phaseCorr N m f' P p j‖ ≤ η :=
      ((norm_sub_norm_le _ _).trans hdiff).trans hfgL
    have h2 : η ≤ budLo c δ * N ^ (6 : ℕ) / 2 := min_le_left _ _
    have h3 : budLo (2 * c) δ * N ^ (6 : ℕ) ≤ budLo c δ / 2 * N ^ (6 : ℕ) :=
      mul_le_mul_of_nonneg_right (budLo_two_mul_le hδ0 hδ1 hc) hN6.le
    linarith
  have hQg := hmain δ N hδ0 hδ1 hN1 P f' p hadm' hf'meas hf'1 hf's (by rw [hf'm]; exact hgn)
    (measurable_phaseProd hf'meas P hp3 hpc j) hp3 hcorr'
  rw [hf'm] at hQg
  -- the uniformity power survives the replacement
  have hfmi : Integrable (f m) :=
    (hfgi.add hgn.integrable).congr (.of_forall fun y => by simp)
  have hL := abs_re_locUnifPow_sub_le (N := N) (H := budHi C₁ δ * N ^ expo (j m))
    (mul_pos (budHi_pos hδ0 hC1) (by positivity)) hN0 (j m) s₀ (hf m) hgn.continuous.measurable
    hfmi hgn.integrable (hf1 m) hg1
  have hsmall : 2 ^ s₀ * ((N ^ (6 : ℕ))⁻¹ * ∫ x, ‖f m x - g x‖) ≤ budLo C₂' δ / 2 := by
    have h2 : η ≤ budLo C₂' δ * N ^ (6 : ℕ) / (2 * 2 ^ s₀) := min_le_right _ _
    have hp : (0 : ℝ) < 2 ^ s₀ := by positivity
    calc 2 ^ s₀ * ((N ^ (6 : ℕ))⁻¹ * ∫ x, ‖f m x - g x‖)
        ≤ 2 ^ s₀ * ((N ^ (6 : ℕ))⁻¹ * (budLo C₂' δ * N ^ (6 : ℕ) / (2 * 2 ^ s₀))) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left (hfgL.trans h2)
            (by positivity)) hp.le
      _ = budLo C₂' δ / 2 := by field_simp
  have := abs_le.mp hL
  calc budLo (2 * C₂') δ ≤ budLo C₂' δ / 2 := budLo_two_mul_le hδ0 hδ1 hC2'
    _ ≤ (locUnifPow N (budHi C₁ δ * N ^ expo (j m)) (j m) s₀ (f m)).re := by linarith

end

/-! ### `patch:u2-fourier-selection`: the one-dimensional `U^2` inverse estimate

On the line, with the uniform law on `[0, H]` and paired cubes `D^r_{a,b}`, the order-two power of
a one-bounded function supported in an interval of length `S` is at most `H^{-2} ‖f̂‖_∞^2`. -/

section
open Filter Topology MeasureTheory

/-- The uniform probability law on `[0, H]`. -/
noncomputable def unifMeas (H : ℝ) : Measure ℝ :=
  (ENNReal.ofReal H)⁻¹ • volume.restrict (Set.Icc 0 H)

instance (H : ℝ) : SFinite (unifMeas H) := by unfold unifMeas; infer_instance

theorem isProbabilityMeasure_unifMeas {H : ℝ} (hH : 0 < H) :
    IsProbabilityMeasure (unifMeas H) := by
  constructor
  rw [unifMeas, Measure.smul_apply, Measure.restrict_apply MeasurableSet.univ, Set.univ_inter,
    Real.volume_Icc, sub_zero, smul_eq_mul]
  exact ENNReal.inv_mul_cancel (by simpa using hH) ENNReal.ofReal_ne_top

theorem integral_unifMeas {H : ℝ} (hH : 0 < H) (g : ℝ → ℂ) :
    ∫ a, g a ∂unifMeas H = (H : ℂ)⁻¹ * ∫ a in Set.Icc 0 H, g a := by
  rw [unifMeas, integral_smul_measure, ENNReal.toReal_inv, ENNReal.toReal_ofReal hH.le,
    Complex.real_smul, Complex.ofReal_inv]

theorem lintegral_unifMeas {H : ℝ} (g : ℝ → ℝ≥0∞) :
    ∫⁻ a, g a ∂unifMeas H = (ENNReal.ofReal H)⁻¹ * ∫⁻ a in Set.Icc 0 H, g a := by
  rw [unifMeas, lintegral_smul_measure, smul_eq_mul]

/-- **Plancherel's theorem in `lintegral` form** on the line. -/
theorem lintegral_enorm_sq_fourier {g : ℝ → ℂ} (hg1 : Integrable g) (hg2 : MemLp g 2) :
    ∫⁻ ξ, ‖𝓕 g ξ‖ₑ ^ (2 : ℕ) = ∫⁻ x, ‖g x‖ₑ ^ (2 : ℕ) := by
  have h := eLpNorm_two_fourier hg1 hg2
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal two_ne_zero ENNReal.ofNat_ne_top (by fun_prop),
    eLpNorm_eq_lintegral_rpow_enorm_toReal two_ne_zero ENNReal.ofNat_ne_top (by fun_prop)] at h
  have h2 := congrArg (fun z : ℝ≥0∞ => z ^ (2 : ℝ)) h
  simp only [ENNReal.toReal_ofNat] at h2
  rw [← ENNReal.rpow_mul, ← ENNReal.rpow_mul] at h2
  norm_num at h2
  simpa using h2

/-- The Fourier transform of a translate: `𝓕 (g (· + b)) ξ = 𝐞(b ξ) 𝓕 g ξ`. -/
theorem fourier_comp_add_right (g : ℝ → ℂ) (b ξ : ℝ) :
    𝓕 (fun y => g (y + b)) ξ = (𝐞 (b * ξ) : ℂ) * 𝓕 g ξ := by
  rw [Real.fourier_real_eq, Real.fourier_real_eq]
  have h := integral_add_right_eq_self (μ := (volume : Measure ℝ))
    (fun y : ℝ => 𝐞 (-((y - b) * ξ)) • g y) b
  simp only [add_sub_cancel_right] at h
  rw [h, ← integral_const_mul]
  refine integral_congr_ae (Eventually.of_forall fun y => ?_)
  simp only [Circle.smul_def, smul_eq_mul]
  rw [← mul_assoc, ← Circle.coe_mul, ← AddChar.map_add_eq_mul]
  congr 3
  ring

theorem norm_fourier_comp_add_right (g : ℝ → ℂ) (b ξ : ℝ) :
    ‖𝓕 (fun y => g (y + b)) ξ‖ = ‖𝓕 g ξ‖ := by
  rw [fourier_comp_add_right, norm_mul, Circle.norm_coe, one_mul]

/-- **Uniform differences have density at most `H⁻¹`**: for independent uniform `b, c` in
`[0, H]`, `E φ(c - b) ≤ H⁻¹ ∫ φ`. -/
theorem lintegral_unif_sub_le {H : ℝ} (hH : 0 < H) {φ : ℝ → ℝ≥0∞} (hφ : Measurable φ) :
    ∫⁻ p : ℝ × ℝ, φ (p.2 - p.1) ∂((unifMeas H).prod (unifMeas H))
      ≤ (ENNReal.ofReal H)⁻¹ * ∫⁻ u, φ u := by
  have := isProbabilityMeasure_unifMeas hH
  rw [lintegral_prod (fun p : ℝ × ℝ => φ (p.2 - p.1))
    (hφ.comp (measurable_snd.sub measurable_fst)).aemeasurable]
  calc ∫⁻ b, ∫⁻ c, φ (c - b) ∂unifMeas H ∂unifMeas H
      ≤ ∫⁻ _b : ℝ, ((ENNReal.ofReal H)⁻¹ * ∫⁻ u : ℝ, φ u) ∂unifMeas H := by
        refine lintegral_mono fun b => ?_
        rw [lintegral_unifMeas]
        gcongr (ENNReal.ofReal H)⁻¹ * ?_
        calc ∫⁻ c in Set.Icc 0 H, φ (c - b) ≤ ∫⁻ c, φ (c - b) := setLIntegral_le_lintegral _ _
          _ = ∫⁻ u, φ u := lintegral_sub_right_eq_self φ b
    _ = (ENNReal.ofReal H)⁻¹ * ∫⁻ u, φ u := by
        rw [lintegral_const, measure_univ, mul_one]

/-- A bounded function vanishing off a compact interval is integrable. -/
theorem integrable_of_bdd_Icc {E : Type*} [NormedAddCommGroup E] {g : ℝ → E}
    (hg : AEStronglyMeasurable g) {C p q : ℝ} (hC : ∀ x, ‖g x‖ ≤ C)
    (hs : ∀ x, x ∉ Set.Icc p q → g x = 0) : Integrable g := by
  refine IntegrableOn.integrable_of_forall_notMem_eq_zero ?_ hs
  refine Measure.integrableOn_of_bounded (M := C) (by simp) hg ?_
  exact Eventually.of_forall hC

theorem memLp_two_of_bdd_Icc {g : ℝ → ℂ} (hg : AEStronglyMeasurable g) {C p q : ℝ}
    (hC : ∀ x, ‖g x‖ ≤ C) (hs : ∀ x, x ∉ Set.Icc p q → g x = 0) : MemLp g 2 := by
  rw [memLp_two_iff_integrable_sq_norm hg]
  refine integrable_of_bdd_Icc (C := C ^ 2) (p := p) (q := q)
    (hg.norm.pow 2) (fun x => ?_) (fun x hx => by simp [hs x hx])
  rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
  exact pow_le_pow_left₀ (norm_nonneg _) (hC x) 2

/-- The window average `T_H G (x) = E_{a ∈ [0,H]} G (x + a)` on the line. -/
noncomputable def avgH (H : ℝ) (G : ℝ → ℂ) (x : ℝ) : ℂ := ∫ a, G (x + a) ∂unifMeas H

/-- The multiplier of the window average, `m_H(ξ) = E_{a ∈ [0,H]} e(a ξ)`. -/
noncomputable def avgMult (H ξ : ℝ) : ℂ := ∫ a, (𝐞 (a * ξ) : ℂ) ∂unifMeas H

theorem measurable_avgH {H : ℝ} {G : ℝ → ℂ} (hG : Measurable G) : Measurable (avgH H G) := by
  have : StronglyMeasurable (Function.uncurry fun x a : ℝ => G (x + a)) :=
    (hG.comp (measurable_fst.add measurable_snd)).stronglyMeasurable
  exact (this.integral_prod_right (ν := unifMeas H)).measurable

theorem norm_avgH_le {H : ℝ} (hH : 0 < H) {G : ℝ → ℂ} {C : ℝ} (hC : ∀ x, ‖G x‖ ≤ C) (x : ℝ) :
    ‖avgH H G x‖ ≤ C := by
  have := isProbabilityMeasure_unifMeas hH
  have := norm_integral_le_of_norm_le_const (μ := unifMeas H) (f := fun a => G (x + a))
    (C := C) (Eventually.of_forall fun a => hC _)
  rw [avgH]
  simpa using this

theorem avgH_eq_zero {H : ℝ} (hH : 0 < H) {G : ℝ → ℂ} {p q : ℝ}
    (hs : ∀ x, x ∉ Set.Icc p q → G x = 0) (x : ℝ) (hx : x ∉ Set.Icc (p - H) q) :
    avgH H G x = 0 := by
  rw [avgH, integral_unifMeas hH]
  rw [setIntegral_eq_zero_of_forall_eq_zero, mul_zero]
  intro a ha
  refine hs _ fun h => hx ⟨?_, ?_⟩
  · linarith [h.1, ha.2]
  · linarith [h.2, ha.1]

/-- **The multiplier formula for the window average**: `𝓕 (T_H G) = m_H 𝓕 G`. -/
theorem fourier_avgH {H : ℝ} (hH : 0 < H) {G : ℝ → ℂ} (hG : Measurable G) (hGi : Integrable G)
    (ξ : ℝ) : 𝓕 (avgH H G) ξ = avgMult H ξ * 𝓕 G ξ := by
  have := isProbabilityMeasure_unifMeas hH
  have hc : Continuous fun p : ℝ × ℝ => ((𝐞 (-(p.1 * ξ)) : Circle) : ℂ) := by fun_prop
  have hm : Measurable (Function.uncurry fun (x a : ℝ) =>
      ((𝐞 (-(x * ξ)) : Circle) : ℂ) * G (x + a)) :=
    hc.measurable.mul (hG.comp (measurable_fst.add measurable_snd))
  have hint : Integrable (Function.uncurry fun (x a : ℝ) =>
      ((𝐞 (-(x * ξ)) : Circle) : ℂ) * G (x + a)) ((volume : Measure ℝ).prod (unifMeas H)) := by
    rw [integrable_prod_iff' hm.aestronglyMeasurable]
    refine ⟨Eventually.of_forall fun a => ?_, ?_⟩
    · have h1 : Integrable (fun x => G (x + a)) := hGi.comp_add_right a
      refine (h1.norm.mono' ?_ (Eventually.of_forall fun x => ?_))
      · exact (hm.comp (measurable_id.prodMk measurable_const)).aestronglyMeasurable
      · simp [Circle.norm_coe]
    · have : ∀ a : ℝ, ∫ x, ‖Function.uncurry (fun (x a : ℝ) =>
            ((𝐞 (-(x * ξ)) : Circle) : ℂ) * G (x + a)) (x, a)‖ = ∫ x, ‖G x‖ := fun a => by
        simp only [Function.uncurry_apply_pair, norm_mul, Circle.norm_coe, one_mul]
        exact integral_add_right_eq_self (fun x => ‖G x‖) a
      simp_rw [this]
      exact integrable_const _
  rw [Real.fourier_real_eq]
  simp only [avgH, Circle.smul_def, smul_eq_mul]
  simp_rw [← integral_const_mul]
  rw [integral_integral_swap hint]
  have hin : ∀ a : ℝ, (∫ x, ((𝐞 (-(x * ξ)) : Circle) : ℂ) * G (x + a))
      = (𝐞 (a * ξ) : ℂ) * 𝓕 G ξ := by
    intro a
    rw [← fourier_comp_add_right, Real.fourier_real_eq]
    simp [Circle.smul_def]
  simp_rw [hin]
  rw [avgMult, integral_mul_const]



theorem avgMult_eq_fourier {H : ℝ} (hH : 0 < H) (ξ : ℝ) :
    avgMult H ξ = 𝓕 (Set.indicator (Set.Icc 0 H) fun _ => ((H : ℂ)⁻¹)) (-ξ) := by
  rw [avgMult, integral_unifMeas hH, Real.fourier_real_eq]
  simp only [Circle.smul_def, smul_eq_mul]
  have : ∀ y : ℝ, ((𝐞 (-(y * -ξ)) : Circle) : ℂ) * Set.indicator (Set.Icc 0 H)
      (fun _ => ((H : ℂ)⁻¹)) y = Set.indicator (Set.Icc 0 H)
        (fun y => (H : ℂ)⁻¹ * ((𝐞 (y * ξ) : Circle) : ℂ)) y := by
    intro y
    by_cases hy : y ∈ Set.Icc 0 H
    · simp [Set.indicator_of_mem hy, mul_comm]
    · simp [Set.indicator_of_notMem hy]
  simp_rw [this]
  rw [integral_indicator measurableSet_Icc, integral_const_mul]

/-- **`∫ |m_H|² = H⁻¹`**, by Plancherel for `H⁻¹ 1_{[0,H]}` and reflection invariance. -/
theorem lintegral_enorm_avgMult_sq {H : ℝ} (hH : 0 < H) :
    ∫⁻ ξ, ‖avgMult H ξ‖ₑ ^ (2 : ℕ) = (ENNReal.ofReal H)⁻¹ := by
  set w : ℝ → ℂ := Set.indicator (Set.Icc 0 H) fun _ => ((H : ℂ)⁻¹) with hw
  have hwm : Measurable w := measurable_const.indicator measurableSet_Icc
  have hwb : ∀ x, ‖w x‖ ≤ H⁻¹ := fun x => by
    rw [hw]
    by_cases hx : x ∈ Set.Icc 0 H
    · simp [Set.indicator_of_mem hx, abs_of_pos hH]
    · simp [Set.indicator_of_notMem hx, hH.le]
  have hws : ∀ x, x ∉ Set.Icc 0 H → w x = 0 := fun x hx => Set.indicator_of_notMem hx _
  have hwi := integrable_of_bdd_Icc hwm.aestronglyMeasurable hwb hws
  have hw2 := memLp_two_of_bdd_Icc hwm.aestronglyMeasurable hwb hws
  simp_rw [avgMult_eq_fourier hH]
  rw [lintegral_neg_eq_self (fun ξ => ‖𝓕 w ξ‖ₑ ^ (2 : ℕ)), lintegral_enorm_sq_fourier hwi hw2]
  have : (fun x => ‖w x‖ₑ ^ (2 : ℕ)) = Set.indicator (Set.Icc 0 H)
      fun _ => (ENNReal.ofReal H)⁻¹ ^ (2 : ℕ) := by
    funext x
    by_cases hx : x ∈ Set.Icc 0 H
    · rw [Set.indicator_of_mem hx, hw, Set.indicator_of_mem hx]
      congr 1
      rw [← ENNReal.ofReal_inv_of_pos hH, ← ofReal_norm]
      simp [abs_of_pos hH]
    · rw [Set.indicator_of_notMem hx, hw, Set.indicator_of_notMem hx]
      simp
  rw [this, lintegral_indicator measurableSet_Icc, setLIntegral_const, Real.volume_Icc, sub_zero]
  have h0 : ENNReal.ofReal H ≠ 0 := by simpa using hH
  rw [pow_two, mul_assoc, ENNReal.inv_mul_cancel h0 ENNReal.ofReal_ne_top, mul_one]

/-- The Fourier coefficient of the correlation `y ↦ f y conj f (y + u)` at `ξ`, as a function of
the shift `u`: the function `b_ξ` of `patch:u2-fourier-selection`. -/
noncomputable def corrFT (f : ℝ → ℂ) (ξ u : ℝ) : ℂ :=
  𝓕 (fun y => f y * conj (f (y + u))) ξ

theorem measurable_corrFT {f : ℝ → ℂ} (hf : Measurable f) :
    Measurable (Function.uncurry (corrFT f)) := by
  have hc : Continuous fun q : (ℝ × ℝ) × ℝ => ((𝐞 (-(q.2 * q.1.1)) : Circle) : ℂ) := by fun_prop
  have hf2 : Measurable fun q : (ℝ × ℝ) × ℝ => conj (f (q.2 + q.1.2)) :=
    Complex.continuous_conj.measurable.comp
      (hf.comp (measurable_snd.add (measurable_snd.comp measurable_fst)))
  have hm : StronglyMeasurable (Function.uncurry fun (p : ℝ × ℝ) (y : ℝ) =>
      ((𝐞 (-(y * p.1)) : Circle) : ℂ) * (f y * conj (f (y + p.2)))) :=
    (hc.measurable.mul ((hf.comp measurable_snd).mul hf2)).stronglyMeasurable
  have e : Function.uncurry (corrFT f) = fun p : ℝ × ℝ => ∫ y : ℝ,
      ((𝐞 (-(y * p.1)) : Circle) : ℂ) * (f y * conj (f (y + p.2))) := by
    funext p
    rw [Function.uncurry, corrFT, Real.fourier_real_eq]
    simp [Circle.smul_def]
  rw [e]
  exact (hm.integral_prod_right (ν := volume)).measurable

/-- The Fourier transform of the conjugate: `𝓕 (conj g) ζ = conj (𝓕 g (-ζ))`. -/
theorem fourier_conj_eq (g : ℝ → ℂ) (ζ : ℝ) :
    𝓕 (fun v => conj (g v)) ζ = conj (𝓕 g (-ζ)) := by
  rw [Real.fourier_real_eq, Real.fourier_real_eq, ← integral_conj]
  refine integral_congr_ae (Eventually.of_forall fun v => ?_)
  simp only [Circle.smul_def, smul_eq_mul, map_mul, ← Circle.coe_inv_eq_conj,
    ← AddChar.map_neg_eq_inv]
  congr 3
  ring

/-- A bounded measurable function on the plane vanishing off a compact rectangle is
integrable. -/
theorem integrable_of_bdd_rect {g : ℝ × ℝ → ℂ} (hg : Measurable g) {C p q p' q' : ℝ}
    (hC : ∀ z, ‖g z‖ ≤ C) (hs : ∀ z, z ∉ Set.Icc p q ×ˢ Set.Icc p' q' → g z = 0) :
    Integrable g ((volume : Measure ℝ).prod volume) := by
  refine IntegrableOn.integrable_of_forall_notMem_eq_zero ?_ hs
  refine Measure.integrableOn_of_bounded (M := C) ?_ hg.aestronglyMeasurable
    (Eventually.of_forall hC)
  rw [Measure.prod_prod]
  exact ENNReal.mul_ne_top (by simp) (by simp)

/-- **The Fourier transform of `b_ξ`** (`patch:u2-fourier-selection`): for a bounded function
supported in a compact interval, `𝓕 b_ξ (ζ) = 𝓕 f (ξ - ζ) conj (𝓕 f (-ζ))`. -/
theorem fourier_corrFT {f : ℝ → ℂ} (hf : Measurable f) (hf1 : ∀ x, ‖f x‖ ≤ 1) {c S : ℝ}
    (hfs : ∀ x, x ∉ Set.Icc c (c + S) → f x = 0) (ξ ζ : ℝ) :
    𝓕 (corrFT f ξ) ζ = 𝓕 f (ξ - ζ) * conj (𝓕 f (-ζ)) := by
  set K : ℝ × ℝ → ℂ := fun q => ((𝐞 (-(q.1 * ζ)) : Circle) : ℂ)
    * (((𝐞 (-(q.2 * ξ)) : Circle) : ℂ) * (f q.2 * conj (f (q.2 + q.1)))) with hK
  have hKm : Measurable K := by
    have h1 : Continuous fun q : ℝ × ℝ => ((𝐞 (-(q.1 * ζ)) : Circle) : ℂ) := by fun_prop
    have h2 : Continuous fun q : ℝ × ℝ => ((𝐞 (-(q.2 * ξ)) : Circle) : ℂ) := by fun_prop
    exact h1.measurable.mul (h2.measurable.mul ((hf.comp measurable_snd).mul
      (Complex.continuous_conj.measurable.comp (hf.comp (measurable_snd.add measurable_fst)))))
  have hKi : Integrable K ((volume : Measure ℝ).prod volume) := by
    refine integrable_of_bdd_rect hKm (C := 1) (p := -S) (q := S) (p' := c) (q' := c + S)
      (fun z => ?_) (fun z hz => ?_)
    · simp only [hK, norm_mul, Circle.norm_coe, one_mul, RCLike.norm_conj]
      exact ((mul_le_of_le_one_left (norm_nonneg _) (hf1 _)).trans (hf1 _))
    · simp only [hK]
      by_cases h2 : z.2 ∈ Set.Icc c (c + S)
      · have h1 : z.1 ∉ Set.Icc (-S) S := fun h1 => hz ⟨h1, h2⟩
        have : z.2 + z.1 ∉ Set.Icc c (c + S) := by
          intro h3
          apply h1
          constructor <;> linarith [h2.1, h2.2, h3.1, h3.2]
        rw [hfs _ this]
        simp
      · rw [hfs _ h2]
        simp
  have hL : 𝓕 (corrFT f ξ) ζ = ∫ u, ∫ y, K (u, y) := by
    rw [Real.fourier_real_eq]
    refine integral_congr_ae (Eventually.of_forall fun u => ?_)
    simp only [Circle.smul_def, smul_eq_mul, corrFT, Real.fourier_real_eq, hK]
    rw [← integral_const_mul]
  rw [hL, integral_integral_swap hKi]
  have hin : ∀ y : ℝ, (∫ u, K (u, y)) = conj (𝓕 f (-ζ))
      * (((𝐞 (-(y * (ξ - ζ))) : Circle) : ℂ) * f y) := by
    intro y
    have h1 : (∫ u, ((𝐞 (-(u * ζ)) : Circle) : ℂ) * conj (f (u + y)))
        = ((𝐞 (y * ζ) : Circle) : ℂ) * conj (𝓕 f (-ζ)) := by
      have := fourier_comp_add_right (fun v => conj (f v)) y ζ
      rw [Real.fourier_real_eq, fourier_conj_eq] at this
      simpa [Circle.smul_def] using this
    have e : ∀ u : ℝ, K (u, y) = (((𝐞 (-(y * ξ)) : Circle) : ℂ) * f y)
        * (((𝐞 (-(u * ζ)) : Circle) : ℂ) * conj (f (u + y))) := by
      intro u
      simp only [hK, add_comm y u]
      ring
    simp_rw [e]
    rw [integral_const_mul, h1]
    have : ((𝐞 (-(y * ξ)) : Circle) : ℂ) * ((𝐞 (y * ζ) : Circle) : ℂ)
        = ((𝐞 (-(y * (ξ - ζ))) : Circle) : ℂ) := by
      rw [← Circle.coe_mul, ← AddChar.map_add_eq_mul]
      congr 3
      ring
    rw [← this]
    ring
  simp_rw [hin]
  rw [integral_const_mul, mul_comm]
  congr 1
  rw [Real.fourier_real_eq]
  simp [Circle.smul_def]

theorem norm_le_indicator_of_bdd {f : ℝ → ℂ} (hf1 : ∀ x, ‖f x‖ ≤ 1) {c S : ℝ}
    (hfs : ∀ x, x ∉ Set.Icc c (c + S) → f x = 0) (x : ℝ) :
    ‖f x‖ ≤ Set.indicator (Set.Icc c (c + S)) (fun _ => (1 : ℝ)) x := by
  by_cases hx : x ∈ Set.Icc c (c + S)
  · rw [Set.indicator_of_mem hx]; exact hf1 x
  · rw [Set.indicator_of_notMem hx, hfs x hx, norm_zero]

theorem lintegral_enorm_sq_le_of_bdd {f : ℝ → ℂ} (hf1 : ∀ x, ‖f x‖ ≤ 1) {c S : ℝ}
    (hfs : ∀ x, x ∉ Set.Icc c (c + S) → f x = 0) :
    ∫⁻ x, ‖f x‖ₑ ^ (2 : ℕ) ≤ ENNReal.ofReal S := by
  calc ∫⁻ x, ‖f x‖ₑ ^ (2 : ℕ) ≤ ∫⁻ x, Set.indicator (Set.Icc c (c + S)) 1 x := by
        refine lintegral_mono fun x => ?_
        by_cases hx : x ∈ Set.Icc c (c + S)
        · rw [Set.indicator_of_mem hx, Pi.one_apply]
          have h1 : ‖f x‖ₑ ≤ 1 := by
            rw [← ofReal_norm]; exact ENNReal.ofReal_le_one.mpr (hf1 x)
          exact pow_le_one₀ (zero_le) h1
        · rw [Set.indicator_of_notMem hx, hfs x hx]
          simp
    _ = ENNReal.ofReal S := by
        rw [lintegral_indicator_one measurableSet_Icc, Real.volume_Icc]
        congr 1
        ring

theorem norm_corrFT_le {f : ℝ → ℂ} (hf1 : ∀ x, ‖f x‖ ≤ 1) {c S : ℝ} (hS : 0 ≤ S)
    (hfs : ∀ x, x ∉ Set.Icc c (c + S) → f x = 0) (ξ u : ℝ) : ‖corrFT f ξ u‖ ≤ S := by
  rw [corrFT, Real.fourier_real_eq]
  have hi : Integrable (Set.indicator (Set.Icc c (c + S)) fun _ => (1 : ℝ)) :=
    (continuous_const.integrableOn_Icc).integrable_indicator measurableSet_Icc
  refine (norm_integral_le_of_norm_le hi (Eventually.of_forall fun y => ?_)).trans ?_
  · rw [Circle.norm_smul, norm_mul, RCLike.norm_conj]
    exact (mul_le_of_le_one_right (norm_nonneg _) (hf1 _)).trans
      (norm_le_indicator_of_bdd hf1 hfs y)
  · rw [integral_indicator measurableSet_Icc, setIntegral_const, Real.volume_real_Icc]
    simp [hS]

theorem corrFT_eq_zero {f : ℝ → ℂ} {c S : ℝ} (hfs : ∀ x, x ∉ Set.Icc c (c + S) → f x = 0)
    (ξ u : ℝ) (hu : u ∉ Set.Icc (-S) S) : corrFT f ξ u = 0 := by
  have : (fun y => f y * conj (f (y + u))) = fun _ => 0 := by
    funext y
    by_cases hy : y ∈ Set.Icc c (c + S)
    · have : y + u ∉ Set.Icc c (c + S) := by
        intro h3
        apply hu
        constructor <;> linarith [hy.1, hy.2, h3.1, h3.2]
      rw [hfs _ this]
      simp
    · rw [hfs _ hy, zero_mul]
  rw [corrFT, this, Real.fourier_real_eq]
  simp

/-- **`∫ |b_ξ|² ≤ ‖f̂‖_∞² ‖f‖_2² ≤ ‖f̂‖_∞² S`**, by Plancherel in the shift variable. -/
theorem lintegral_corrFT_sq_le {f : ℝ → ℂ} (hf : Measurable f) (hf1 : ∀ x, ‖f x‖ ≤ 1)
    {c S : ℝ} (hS : 0 ≤ S) (hfs : ∀ x, x ∉ Set.Icc c (c + S) → f x = 0) {M : ℝ}
    (hM : ∀ ζ, ‖𝓕 f ζ‖ ≤ M) (ξ : ℝ) :
    ∫⁻ u, ‖corrFT f ξ u‖ₑ ^ (2 : ℕ) ≤ ENNReal.ofReal M ^ (2 : ℕ) * ENNReal.ofReal S := by
  have hbm : Measurable (corrFT f ξ) := by
    have h := (measurable_corrFT hf).comp (measurable_prodMk_left (x := ξ))
    exact h
  have hbi := integrable_of_bdd_Icc hbm.aestronglyMeasurable (norm_corrFT_le hf1 hS hfs ξ)
    (corrFT_eq_zero hfs ξ)
  have hb2 := memLp_two_of_bdd_Icc hbm.aestronglyMeasurable (norm_corrFT_le hf1 hS hfs ξ)
    (corrFT_eq_zero hfs ξ)
  have hfi := integrable_of_bdd_Icc hf.aestronglyMeasurable hf1 hfs
  have hf2 := memLp_two_of_bdd_Icc hf.aestronglyMeasurable hf1 hfs
  rw [← lintegral_enorm_sq_fourier hbi hb2]
  simp_rw [fourier_corrFT hf hf1 hfs ξ]
  calc ∫⁻ ζ, ‖𝓕 f (ξ - ζ) * conj (𝓕 f (-ζ))‖ₑ ^ (2 : ℕ)
      ≤ ∫⁻ ζ, ENNReal.ofReal M ^ (2 : ℕ) * ‖𝓕 f (-ζ)‖ₑ ^ (2 : ℕ) := by
        refine lintegral_mono fun ζ => ?_
        rw [enorm_mul, RCLike.enorm_conj, mul_pow]
        gcongr
        rw [← ofReal_norm]
        exact ENNReal.ofReal_le_ofReal (hM _)
    _ = ENNReal.ofReal M ^ (2 : ℕ) * ∫⁻ ζ, ‖𝓕 f ζ‖ₑ ^ (2 : ℕ) := by
        rw [lintegral_const_mul' _ _ (by simp),
          lintegral_neg_eq_self (fun ζ => ‖𝓕 f ζ‖ₑ ^ (2 : ℕ))]
    _ ≤ ENNReal.ofReal M ^ (2 : ℕ) * ENNReal.ofReal S := by
        rw [lintegral_enorm_sq_fourier hfi hf2]
        gcongr
        exact lintegral_enorm_sq_le_of_bdd hf1 hfs

/-- The paired correlation `g_{b,c}(y) = f(y + b) conj f(y + c)`. -/
noncomputable def pairCorr (f : ℝ → ℂ) (b c : ℝ) (y : ℝ) : ℂ := f (y + b) * conj (f (y + c))

theorem measurable_avgMult (H : ℝ) : Measurable (avgMult H) := by
  have hc : Continuous fun q : ℝ × ℝ => ((𝐞 (q.2 * q.1) : Circle) : ℂ) := by fun_prop
  exact (hc.measurable.stronglyMeasurable.integral_prod_right (ν := unifMeas H)).measurable

/-- **The `U²` estimate for one pair**: `∫ |T_H g_{b,c}|² = ∫ |m_H(ξ)|² |b_ξ(c - b)|² dξ`. -/
theorem lintegral_avgH_pairCorr_eq {H : ℝ} (hH : 0 < H) {f : ℝ → ℂ} (hf : Measurable f)
    (hf1 : ∀ x, ‖f x‖ ≤ 1) {c S : ℝ} (hfs : ∀ x, x ∉ Set.Icc c (c + S) → f x = 0) (b b' : ℝ) :
    ∫⁻ x, ‖avgH H (pairCorr f b b') x‖ₑ ^ (2 : ℕ)
      = ∫⁻ ξ, ‖avgMult H ξ‖ₑ ^ (2 : ℕ) * ‖corrFT f ξ (b' - b)‖ₑ ^ (2 : ℕ) := by
  have hGm : Measurable (pairCorr f b b') :=
    (hf.comp (measurable_id.add_const b)).mul
      (Complex.continuous_conj.measurable.comp (hf.comp (measurable_id.add_const b')))
  have hG1 : ∀ y, ‖pairCorr f b b' y‖ ≤ 1 := fun y => by
    rw [pairCorr, norm_mul, RCLike.norm_conj]
    exact ((mul_le_of_le_one_left (norm_nonneg _) (hf1 _)).trans (hf1 _))
  have hGs : ∀ y, y ∉ Set.Icc (c - b) (c + S - b) → pairCorr f b b' y = 0 := fun y hy => by
    have : y + b ∉ Set.Icc c (c + S) := fun h => hy ⟨by linarith [h.1], by linarith [h.2]⟩
    rw [pairCorr, hfs _ this, zero_mul]
  have hGi := integrable_of_bdd_Icc hGm.aestronglyMeasurable hG1 hGs
  have hAm := measurable_avgH (H := H) hGm
  have hA1 := norm_avgH_le hH hG1
  have hAs := avgH_eq_zero hH hGs
  have hAi := integrable_of_bdd_Icc hAm.aestronglyMeasurable hA1 hAs
  have hA2 := memLp_two_of_bdd_Icc hAm.aestronglyMeasurable hA1 hAs
  rw [← lintegral_enorm_sq_fourier hAi hA2]
  refine lintegral_congr fun ξ => ?_
  rw [fourier_avgH hH hGm hGi, enorm_mul, mul_pow]
  congr 2
  have e : pairCorr f b b' = fun y => (fun y => f y * conj (f (y + (b' - b)))) (y + b) := by
    funext y
    simp only [pairCorr]
    congr 3
    ring
  rw [e, ← ofReal_norm,
    norm_fourier_comp_add_right (fun y => f y * conj (f (y + (b' - b)))) b ξ, ofReal_norm]
  rfl

/-- **`patch:u2-fourier-selection`, the averaged estimate**:
`E_{b,c ∈ [0,H]} ∫ |T_H g_{b,c}|² ≤ H⁻² ‖f̂‖_∞² S`. -/
theorem lintegral_pair_avgH_le {H : ℝ} (hH : 0 < H) {f : ℝ → ℂ} (hf : Measurable f)
    (hf1 : ∀ x, ‖f x‖ ≤ 1) {c S : ℝ} (hS : 0 ≤ S) (hfs : ∀ x, x ∉ Set.Icc c (c + S) → f x = 0)
    {M : ℝ} (hM : ∀ ζ, ‖𝓕 f ζ‖ ≤ M) :
    ∫⁻ p : ℝ × ℝ, (∫⁻ x, ‖avgH H (pairCorr f p.1 p.2) x‖ₑ ^ (2 : ℕ))
        ∂((unifMeas H).prod (unifMeas H))
      ≤ (ENNReal.ofReal H)⁻¹ * ((ENNReal.ofReal H)⁻¹
          * (ENNReal.ofReal M ^ (2 : ℕ) * ENNReal.ofReal S)) := by
  simp_rw [lintegral_avgH_pairCorr_eq hH hf hf1 hfs]
  have hmeas : Measurable (Function.uncurry fun (p : ℝ × ℝ) (ξ : ℝ) =>
      ‖avgMult H ξ‖ₑ ^ (2 : ℕ) * ‖corrFT f ξ (p.2 - p.1)‖ₑ ^ (2 : ℕ)) := by
    have h1 : Measurable fun q : (ℝ × ℝ) × ℝ => avgMult H q.2 :=
      (measurable_avgMult H).comp measurable_snd
    have h2 : Measurable fun q : (ℝ × ℝ) × ℝ => corrFT f q.2 (q.1.2 - q.1.1) := by
      have hg : Measurable fun q : (ℝ × ℝ) × ℝ => (q.2, q.1.2 - q.1.1) :=
        measurable_snd.prodMk (measurable_fst.snd.sub measurable_fst.fst)
      have h := (measurable_corrFT hf).comp hg
      exact h
    have h3 : Measurable fun q : (ℝ × ℝ) × ℝ =>
        ‖avgMult H q.2‖ₑ ^ (2 : ℕ) * ‖corrFT f q.2 (q.1.2 - q.1.1)‖ₑ ^ (2 : ℕ) :=
      (h1.enorm.pow_const 2).mul (h2.enorm.pow_const 2)
    simp only [Function.uncurry_def]
    exact h3
  rw [lintegral_lintegral_swap hmeas.aemeasurable]
  calc ∫⁻ ξ, ∫⁻ p, ‖avgMult H ξ‖ₑ ^ (2 : ℕ) * ‖corrFT f ξ (p.2 - p.1)‖ₑ ^ (2 : ℕ)
        ∂((unifMeas H).prod (unifMeas H))
      ≤ ∫⁻ ξ, ‖avgMult H ξ‖ₑ ^ (2 : ℕ) * ((ENNReal.ofReal H)⁻¹
          * (ENNReal.ofReal M ^ (2 : ℕ) * ENNReal.ofReal S)) := by
        refine lintegral_mono fun ξ => ?_
        have hb : Measurable fun u => ‖corrFT f ξ u‖ₑ ^ (2 : ℕ) := by
          have h := (measurable_corrFT hf).comp (measurable_prodMk_left (x := ξ))
          exact h.enorm.pow_const 2
        rw [lintegral_const_mul' _ _ (by simp)]
        gcongr
        exact (lintegral_unif_sub_le hH hb).trans
          (by gcongr; exact lintegral_corrFT_sq_le hf hf1 hS hfs hM ξ)
    _ = _ := by
        rw [lintegral_mul_const _ ((measurable_avgMult H).enorm.pow_const 2),
          lintegral_enorm_avgMult_sq hH]

/-- **The one-dimensional paired-cube power** `Q_{r,H,S}(f)`: the normalized real part of
`E_{a,b ∈ [0,H]^r} ∫ D^r_{a,b} f(x) dx`, where `D^r_{a,b} f(x)` is the product over
`ω ∈ {0,1}^r` of `C^{|ω|} f(x + Σ_i [ω_i a_i + (1 - ω_i) b_i])` (`Auto.cubeProdSel`). -/
noncomputable def unifPow1 (H S : ℝ) (r : ℕ) (f : ℝ → ℂ) : ℝ :=
  S⁻¹ * (∫ x, ∫ Q : (Fin r → ℝ) × (Fin r → ℝ), cubeProdSel (fun β => f (x + ∑ i, β i)) Q.1 Q.2
    ∂((Measure.pi fun _ => unifMeas H).prod (Measure.pi fun _ => unifMeas H))).re

theorem measurable_cubeArg {f : ℝ → ℂ} (hf : Measurable f) {r : ℕ} (x : ℝ) :
    Measurable fun β : Fin r → ℝ => f (x + ∑ i, β i) :=
  hf.comp (measurable_const.add (Finset.measurable_sum _ fun i _ => measurable_pi_apply i))

/-- **The order-two cube is the square of a window average**:
`E_{a,b} D²_{a,b} f(x) = E_{b,c} |T_H g_{b,c}(x)|²` for the paired correlations `g_{b,c}`. -/
theorem integral_cube_two_eq {H : ℝ} (hH : 0 < H) {f : ℝ → ℂ} (hf : Measurable f)
    (hf1 : ∀ x, ‖f x‖ ≤ 1) (x : ℝ) :
    (∫ Q : (Fin 2 → ℝ) × (Fin 2 → ℝ), cubeProdSel (fun β => f (x + ∑ i, β i)) Q.1 Q.2
        ∂((Measure.pi fun _ => unifMeas H).prod (Measure.pi fun _ => unifMeas H)))
      = ∫ p : ℝ × ℝ, ((‖avgH H (pairCorr f p.1 p.2) x‖ ^ 2 : ℝ) : ℂ)
          ∂((unifMeas H).prod (unifMeas H)) := by
  have := isProbabilityMeasure_unifMeas hH
  set w : (Fin 2 → ℝ) → ℂ := fun β => f (x + ∑ i, β i) with hw
  have hwm : Measurable w := measurable_cubeArg hf x
  have hwb : ∀ β, ‖w β‖ ≤ 1 := fun β => hf1 _
  have hcm : Measurable (Function.uncurry fun b c : Fin 2 → ℝ => cubeProdSel w b c) := by
    have h := measurable_cubeProdSel (v := w) hwm
    exact h
  rw [integral_prod_of_bdd (f := fun b c => cubeProdSel w b c) hcm (C := 1)
    (fun b c => norm_cubeProdSel_le hwb b c), integral_cubeProdSel_snoc hwm hwb]
  refine integral_congr_ae (Eventually.of_forall fun p => ?_)
  have hpt : ∀ q : (Fin 1 → ℝ) × (Fin 1 → ℝ),
      cubeProdSel w (Fin.snoc q.1 p.1) (Fin.snoc q.2 p.2)
        = pairCorr f p.1 p.2 (x + q.1 0) * conj (pairCorr f p.1 p.2 (x + q.2 0)) := by
    intro q
    rw [← cubeProdSel_cylStep (fun _ : Unit => w) () p.1 p.2, cubeProdSel_one]
    simp only [cylStep, hw, Fin.sum_univ_two, pairCorr]
    simp [Fin.snoc, add_assoc]
  simp_rw [hpt]
  rw [integral_prod_mul (fun b : Fin 1 → ℝ => pairCorr f p.1 p.2 (x + b 0))
    (fun c : Fin 1 → ℝ => conj (pairCorr f p.1 p.2 (x + c 0))), integral_conj]
  have hu := measurePreserving_funUnique (unifMeas H) (Fin 1)
  have e1 : (∫ b : Fin 1 → ℝ, pairCorr f p.1 p.2 (x + b 0) ∂(Measure.pi fun _ => unifMeas H))
      = avgH H (pairCorr f p.1 p.2) x := by
    rw [avgH, ← hu.integral_comp' (fun a => pairCorr f p.1 p.2 (x + a))]
    rfl
  rw [e1, Complex.mul_conj, Complex.normSq_eq_norm_sq, Complex.ofReal_pow]

theorem measurable_avgH_pairCorr {H : ℝ} {f : ℝ → ℂ} (hf : Measurable f) :
    Measurable fun q : ℝ × ℝ × ℝ => avgH H (pairCorr f q.2.1 q.2.2) q.1 := by
  have hm : StronglyMeasurable (Function.uncurry fun (q : ℝ × ℝ × ℝ) (a : ℝ) =>
      pairCorr f q.2.1 q.2.2 (q.1 + a)) := by
    have h1 : Measurable fun z : (ℝ × ℝ × ℝ) × ℝ => f (z.1.1 + z.2 + z.1.2.1) :=
      hf.comp ((measurable_fst.fst.add measurable_snd).add measurable_fst.snd.fst)
    have h2 : Measurable fun z : (ℝ × ℝ × ℝ) × ℝ => conj (f (z.1.1 + z.2 + z.1.2.2)) :=
      Complex.continuous_conj.measurable.comp
        (hf.comp ((measurable_fst.fst.add measurable_snd).add measurable_fst.snd.snd))
    exact (h1.mul h2).stronglyMeasurable
  exact (hm.integral_prod_right (ν := unifMeas H)).measurable

/-- **Lemma `patch:u2-fourier-selection`, the inverse estimate**: if `|f| ≤ 1` and `f` is
supported in an interval of length `S`, then `Q_{2,H,S}(f) ≤ H⁻² ‖f̂‖_∞²`, for every bound
`M ≥ ‖f̂‖_∞`. -/
theorem unifPow1_two_le {H S c M : ℝ} (hH : 0 < H) (hS : 0 < S) {f : ℝ → ℂ}
    (hf : Measurable f) (hf1 : ∀ x, ‖f x‖ ≤ 1) (hfs : ∀ x, x ∉ Set.Icc c (c + S) → f x = 0)
    (hM : ∀ ζ, ‖𝓕 f ζ‖ ≤ M) :
    unifPow1 H S 2 f ≤ (H ^ 2)⁻¹ * M ^ 2 := by
  have := isProbabilityMeasure_unifMeas hH
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  set F : ℝ → ℝ × ℝ → ℝ := fun (x : ℝ) (p : ℝ × ℝ) => ‖avgH H (pairCorr f p.1 p.2) x‖ ^ 2 with hF
  have hFm : Measurable (Function.uncurry F) :=
    ((measurable_avgH_pairCorr (H := H) hf).norm.pow_const 2)
  have hF0 : ∀ x p, 0 ≤ F x p := fun x p => by positivity
  have hG1 : ∀ (p : ℝ × ℝ) (y : ℝ), ‖pairCorr f p.1 p.2 y‖ ≤ 1 := fun p y => by
    rw [pairCorr, norm_mul, RCLike.norm_conj]
    exact ((mul_le_of_le_one_left (norm_nonneg _) (hf1 _)).trans (hf1 _))
  have hF1 : ∀ x p, F x p ≤ 1 := fun x p => by
    simp only [hF]
    exact pow_le_one₀ (norm_nonneg _) (norm_avgH_le hH (hG1 p) x)
  set φ : ℝ → ℝ := fun x => ∫ p, F x p ∂((unifMeas H).prod (unifMeas H)) with hφ
  have hre : (∫ x, ∫ Q : (Fin 2 → ℝ) × (Fin 2 → ℝ),
      cubeProdSel (fun β => f (x + ∑ i, β i)) Q.1 Q.2
        ∂((Measure.pi fun _ => unifMeas H).prod (Measure.pi fun _ => unifMeas H))).re
      = ∫ x, φ x := by
    simp_rw [integral_cube_two_eq hH hf hf1, integral_complex_ofReal]
    rw [Complex.ofReal_re]
  have hφm : AEStronglyMeasurable φ :=
    (hFm.stronglyMeasurable.integral_prod_right' (ν := (unifMeas H).prod (unifMeas H))
      |>.aestronglyMeasurable)
  have hlin : ∀ x, ENNReal.ofReal (φ x)
      = ∫⁻ p, ‖avgH H (pairCorr f p.1 p.2) x‖ₑ ^ (2 : ℕ) ∂((unifMeas H).prod (unifMeas H)) := by
    intro x
    change ENNReal.ofReal (∫ p, F x p ∂((unifMeas H).prod (unifMeas H))) = _
    have hFx : Measurable fun p => F x p := by
      have h := hFm.comp (measurable_prodMk_left (x := x))
      exact h
    have hi : Integrable (fun p => F x p) ((unifMeas H).prod (unifMeas H)) :=
      integrable_of_bdd_finite hFx (C := 1) fun p => by
        rw [abs_of_nonneg (hF0 x p)]; exact hF1 x p
    rw [ofReal_integral_eq_lintegral_ofReal hi
      (Eventually.of_forall (hF0 x))]
    refine lintegral_congr fun p => ?_
    simp only [hF]
    rw [ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm]
  have hswap : ∫⁻ x, ∫⁻ p, ‖avgH H (pairCorr f p.1 p.2) x‖ₑ ^ (2 : ℕ)
        ∂((unifMeas H).prod (unifMeas H))
      = ∫⁻ p, (∫⁻ x, ‖avgH H (pairCorr f p.1 p.2) x‖ₑ ^ (2 : ℕ))
        ∂((unifMeas H).prod (unifMeas H)) := by
    refine lintegral_lintegral_swap ?_
    have h := ((measurable_avgH_pairCorr (H := H) hf).enorm.pow_const 2)
    exact h.aemeasurable
  set B : ℝ≥0∞ := (ENNReal.ofReal H)⁻¹ * ((ENNReal.ofReal H)⁻¹
    * (ENNReal.ofReal M ^ (2 : ℕ) * ENNReal.ofReal S)) with hB
  have hBt : B ≠ ⊤ := by
    have : (ENNReal.ofReal H)⁻¹ ≠ ⊤ := ENNReal.inv_ne_top.mpr (by simpa using hH)
    exact ENNReal.mul_ne_top this (ENNReal.mul_ne_top this
      (ENNReal.mul_ne_top (ENNReal.pow_ne_top ENNReal.ofReal_ne_top) ENNReal.ofReal_ne_top))
  have hBr : B.toReal = H⁻¹ * (H⁻¹ * (M ^ 2 * S)) := by
    rw [hB, ENNReal.toReal_mul, ENNReal.toReal_mul, ENNReal.toReal_mul, ENNReal.toReal_inv,
      ENNReal.toReal_ofReal hH.le, ENNReal.toReal_pow, ENNReal.toReal_ofReal hM0,
      ENNReal.toReal_ofReal hS.le]
  have hint : ∫ x, φ x ≤ H⁻¹ * (H⁻¹ * (M ^ 2 * S)) := by
    rw [integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall fun x =>
      integral_nonneg (hF0 x)) hφm, ← hBr]
    refine ENNReal.toReal_mono hBt ?_
    rw [lintegral_congr fun x => hlin x, hswap]
    exact lintegral_pair_avgH_le hH hf hf1 hS.le hfs hM
  rw [unifPow1, hre]
  calc S⁻¹ * ∫ x, φ x ≤ S⁻¹ * (H⁻¹ * (H⁻¹ * (M ^ 2 * S))) :=
        mul_le_mul_of_nonneg_left hint (inv_nonneg.mpr hS.le)
    _ = (H ^ 2)⁻¹ * M ^ 2 := by field_simp

end

section
open Filter Topology MeasureTheory

/-- **Measurable least-index selection of frequencies** (`patch:u2-fourier-selection`): if every
section `g θ` is continuous and `θ ↦ g θ ζ` is measurable for each `ζ`, there is a measurable
choice `ξ θ` with `‖g θ (ξ θ)‖ > a` wherever some frequency exceeds `a`. The frequency is the first
term of a countable dense sequence at which the modulus exceeds `a`; no finite frequency set is
assumed. -/
theorem exists_measurable_freq {Θ : Type*} [MeasurableSpace Θ] {g : Θ → ℝ → ℂ}
    (hgc : ∀ θ, Continuous (g θ)) (hgm : ∀ ζ, Measurable fun θ => g θ ζ) (a : ℝ) :
    ∃ ξ : Θ → ℝ, Measurable ξ ∧ ∀ θ, (∃ ζ, a < ‖g θ ζ‖) → a < ‖g θ (ξ θ)‖ := by
  classical
  obtain ⟨u, hu⟩ := TopologicalSpace.exists_dense_seq ℝ
  let P : Θ → ℕ → Prop := fun θ n =>
    (n = 0 ∧ ∀ m, ‖g θ (u m)‖ ≤ a) ∨ (1 ≤ n ∧ a < ‖g θ (u (n - 1))‖)
  have hex : ∀ θ, ∃ n, P θ n := by
    intro θ
    by_cases h : ∀ m, ‖g θ (u m)‖ ≤ a
    · exact ⟨0, Or.inl ⟨rfl, h⟩⟩
    · push Not at h
      obtain ⟨m, hm⟩ := h
      exact ⟨m + 1, Or.inr ⟨by omega, by simpa using hm⟩⟩
  have hPm : ∀ k, MeasurableSet {θ | P θ k} := by
    intro k
    have h1 : MeasurableSet {θ | ∀ m, ‖g θ (u m)‖ ≤ a} := by
      have : {θ | ∀ m, ‖g θ (u m)‖ ≤ a} = ⋂ m, {θ | ‖g θ (u m)‖ ≤ a} := by ext; simp
      rw [this]
      exact MeasurableSet.iInter fun m => measurableSet_le (hgm _).norm measurable_const
    have h2 : MeasurableSet {θ | a < ‖g θ (u (k - 1))‖} :=
      measurableSet_lt measurable_const (hgm _).norm
    have : {θ | P θ k} = ({θ | k = 0} ∩ {θ | ∀ m, ‖g θ (u m)‖ ≤ a})
        ∪ ({θ | 1 ≤ k} ∩ {θ | a < ‖g θ (u (k - 1))‖}) := by ext; simp [P]
    rw [this]
    exact ((MeasurableSet.const _).inter h1).union ((MeasurableSet.const _).inter h2)
  set N : Θ → ℕ := fun θ => Nat.find (hex θ) with hN
  have hNm : Measurable N := measurable_find hex hPm
  refine ⟨fun θ => u (N θ - 1), (measurable_from_nat (f := fun n => u (n - 1))).comp hNm, ?_⟩
  intro θ ⟨ζ, hζ⟩
  have hopen : IsOpen {z : ℝ | a < ‖g θ z‖} := isOpen_lt continuous_const (hgc θ).norm
  obtain ⟨m, hm⟩ := hu.exists_mem_open hopen ⟨ζ, hζ⟩
  have hspec := Nat.find_spec (hex θ)
  rcases hspec with ⟨_, hall⟩ | ⟨_, hgood⟩
  · exact absurd (hall m) (not_le.mpr hm)
  · exact hgood

/-- The Fourier coefficient of a jointly measurable family is measurable in the parameter. -/
theorem measurable_fourier_param {Θ : Type*} [MeasurableSpace Θ] {F : Θ → ℝ → ℂ}
    (hF : Measurable (Function.uncurry F)) (ζ : ℝ) : Measurable fun θ => 𝓕 (F θ) ζ := by
  have hc : Continuous fun x : ℝ => ((𝐞 (-(x * ζ)) : Circle) : ℂ) := by fun_prop
  have hm : StronglyMeasurable (Function.uncurry fun (θ : Θ) (x : ℝ) =>
      ((𝐞 (-(x * ζ)) : Circle) : ℂ) * F θ x) :=
    ((hc.measurable.comp measurable_snd).mul hF).stronglyMeasurable
  have e : (fun θ => 𝓕 (F θ) ζ) = fun θ => ∫ x : ℝ, ((𝐞 (-(x * ζ)) : Circle) : ℂ) * F θ x := by
    funext θ
    rw [Real.fourier_real_eq]
    simp [Circle.smul_def]
  rw [e]
  exact (hm.integral_prod_right (ν := volume)).measurable

/-- **Lemma `patch:u2-fourier-selection`, measurable frequencies**: for a jointly measurable
one-bounded family supported in a common interval of length `S`, there is a measurable frequency
`ξ θ` with `|f̂_θ (ξ θ)| > H √η / 2` wherever `Q_{2,H,S}(f_θ) ≥ η`. -/
theorem exists_measurable_freq_unifPow1 {Θ : Type*} [MeasurableSpace Θ] {F : Θ → ℝ → ℂ}
    (hF : Measurable (Function.uncurry F)) (hF1 : ∀ θ x, ‖F θ x‖ ≤ 1) {c S H η : ℝ}
    (hH : 0 < H) (hS : 0 < S) (hFs : ∀ θ x, x ∉ Set.Icc c (c + S) → F θ x = 0) (hη : 0 < η) :
    ∃ ξ : Θ → ℝ, Measurable ξ ∧ ∀ θ, η ≤ unifPow1 H S 2 (F θ)
      → H * Real.sqrt η / 2 < ‖𝓕 (F θ) (ξ θ)‖ := by
  have hFm : ∀ θ, Measurable (F θ) := fun θ => by
    have h := hF.comp (measurable_prodMk_left (x := θ))
    exact h
  have hgc : ∀ θ, Continuous (𝓕 (F θ)) := fun θ =>
    continuous_fourier_of_integrable
      (integrable_of_bdd_Icc (hFm θ).aestronglyMeasurable (hF1 θ) (hFs θ))
  obtain ⟨ξ, hξm, hξ⟩ := exists_measurable_freq hgc (measurable_fourier_param hF)
    (H * Real.sqrt η / 2)
  refine ⟨ξ, hξm, fun θ hθ => hξ θ ?_⟩
  by_contra hno
  push Not at hno
  have hQ := unifPow1_two_le hH hS (hFm θ) (hF1 θ) (hFs θ) hno
  have hs : Real.sqrt η ^ 2 = η := Real.sq_sqrt hη.le
  have : (H ^ 2)⁻¹ * (H * Real.sqrt η / 2) ^ 2 = η / 4 := by
    field_simp
    rw [hs]
    ring
  linarith

end

/-! ### `patch:dual-difference`: the dual-difference interchange

The explicit cylinder proof: the state is `(a, (x, y), t)` with independent parameters for each
vertex and copy; the nuisances are the vertex blocks with a given first true coordinate. -/

section
open Filter Topology MeasureTheory

/-- The uniform probability law on `[p, q]`. -/
noncomputable def unifIcc (p q : ℝ) : Measure ℝ :=
  (ENNReal.ofReal (q - p))⁻¹ • volume.restrict (Set.Icc p q)

instance (p q : ℝ) : IsFiniteMeasure (unifIcc p q) := by
  constructor
  rw [unifIcc, Measure.smul_apply, Measure.restrict_apply MeasurableSet.univ, Set.univ_inter,
    Real.volume_Icc, smul_eq_mul]
  rcases le_or_gt (q - p) 0 with h | h
  · rw [ENNReal.ofReal_of_nonpos h, mul_zero]; exact ENNReal.zero_lt_top
  · rw [ENNReal.inv_mul_cancel (by simpa using h) ENNReal.ofReal_ne_top]; exact ENNReal.one_lt_top

instance (H : ℝ) : IsFiniteMeasure (unifMeas H) := by
  constructor
  rw [unifMeas, Measure.smul_apply, Measure.restrict_apply MeasurableSet.univ, Set.univ_inter,
    Real.volume_Icc, smul_eq_mul, sub_zero]
  rcases le_or_gt H 0 with h | h
  · rw [ENNReal.ofReal_of_nonpos h, mul_zero]; exact ENNReal.zero_lt_top
  · rw [ENNReal.inv_mul_cancel (by simpa using h) ENNReal.ofReal_ne_top]; exact ENNReal.one_lt_top

theorem isProbabilityMeasure_unifIcc {p q : ℝ} (hpq : p < q) :
    IsProbabilityMeasure (unifIcc p q) := by
  constructor
  rw [unifIcc, Measure.smul_apply, Measure.restrict_apply MeasurableSet.univ, Set.univ_inter,
    Real.volume_Icc, smul_eq_mul]
  exact ENNReal.inv_mul_cancel (by simpa using hpq) ENNReal.ofReal_ne_top

theorem integral_unifIcc {p q : ℝ} (hpq : p < q) (g : ℝ → ℂ) :
    ∫ x, g x ∂unifIcc p q = ((q - p : ℝ) : ℂ)⁻¹ * ∫ x in Set.Icc p q, g x := by
  rw [unifIcc, integral_smul_measure, ENNReal.toReal_inv, ENNReal.toReal_ofReal (by linarith),
    Complex.real_smul, Complex.ofReal_inv]

/-- A function vanishing off `[p, q]` has uniform average `(q - p)⁻¹ ∫ g`. -/
theorem integral_unifIcc_of_support {p q : ℝ} (hpq : p < q) {g : ℝ → ℂ}
    (hg : ∀ x, x ∉ Set.Icc p q → g x = 0) :
    ∫ x, g x ∂unifIcc p q = ((q - p : ℝ) : ℂ)⁻¹ * ∫ x, g x := by
  rw [integral_unifIcc hpq, setIntegral_eq_integral_of_forall_compl_eq_zero hg]

/-- The additive character `e(s) = exp(2 π i s)`. -/
noncomputable def ephase (s : ℝ) : ℂ := Complex.exp (((2 * Real.pi * s : ℝ) : ℂ) * Complex.I)

theorem ephase_eq_fourierChar (s : ℝ) : ((𝐞 s : Circle) : ℂ) = ephase s := by
  rw [Real.fourierChar_apply, ephase]

theorem norm_ephase (s : ℝ) : ‖ephase s‖ = 1 := Complex.norm_exp_ofReal_mul_I _

theorem continuous_ephase : Continuous ephase := by unfold ephase; fun_prop

theorem ephase_add (s t : ℝ) : ephase (s + t) = ephase s * ephase t := by
  rw [ephase, ephase, ephase, ← Complex.exp_add]
  congr 1
  push_cast
  ring

theorem ephase_neg (s : ℝ) : ephase (-s) = conj (ephase s) := by
  rw [ephase, ephase, ← Complex.exp_conj]
  congr 1
  rw [map_mul, Complex.conj_ofReal, Complex.conj_I]
  push_cast
  ring

theorem ephase_sub (s t : ℝ) : ephase (s - t) = ephase s * conj (ephase t) := by
  rw [sub_eq_add_neg, ephase_add, ephase_neg]

theorem ephase_sum {ι : Type*} (s : Finset ι) (f : ι → ℝ) :
    ephase (∑ i ∈ s, f i) = ∏ i ∈ s, ephase (f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [ephase]
  | insert i s hi ih => rw [Finset.sum_insert hi, Finset.prod_insert hi, ephase_add, ih]

theorem conjPar_ephase (n : ℕ) (s : ℝ) : conjPar n (ephase s) = ephase ((-1) ^ n * s) := by
  rcases Nat.even_or_odd n with h | h
  · rw [conjPar, ite_eq_left h, h.neg_one_pow, one_mul]
  · rw [conjPar, ite_eq_right (Nat.not_even_iff_odd.mpr h), h.neg_one_pow, neg_one_mul, ephase_neg]

theorem conjPar_ite_one_zero (n : ℕ) (P : Prop) [Decidable P] :
    conjPar n (if P then (1 : ℂ) else 0) = if P then 1 else 0 := by
  unfold conjPar; split_ifs <;> simp

/-- Integrals commute with conjugation parities. -/
theorem integral_conjPar {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} (n : ℕ) (g : Ω → ℂ) :
    ∫ t, conjPar n (g t) ∂μ = conjPar n (∫ t, g t ∂μ) := by
  unfold conjPar
  split_ifs
  · rfl
  · exact integral_conj

/-- Almost every point of the uniform cube `[0, H]^r` lies in the cube. -/
theorem ae_pi_unifMeas_mem {H : ℝ} (r : ℕ) :
    ∀ᵐ b ∂(Measure.pi fun _ : Fin r => unifMeas H), ∀ i, b i ∈ Set.Icc 0 H := by
  have h1 : ∀ᵐ t ∂unifMeas H, t ∈ Set.Icc 0 H := by
    rw [unifMeas]
    exact Measure.smul_absolutelyContinuous.ae_le (ae_restrict_mem measurableSet_Icc)
  rw [eventually_all]
  exact fun i => (Measure.tendsto_eval_ae_ae (i := i)).eventually h1

/-- The first true coordinate of a vertex `ω ∈ {0,1}^r` (`⊤` for the zero vertex); its fibres
are the blocks `Ω_i` of `patch:dual-difference`. -/
noncomputable def vkey {r : ℕ} (ω : Fin r → Bool) : Option (Fin r) :=
  (Finset.univ.filter fun i => ω i = true).min

theorem vkey_eq_none_iff {r : ℕ} (ω : Fin r → Bool) : vkey ω = none ↔ ω = fun _ => false := by
  rw [vkey]
  change _ = (⊤ : WithTop (Fin r)) ↔ _
  rw [Finset.min_eq_top, Finset.filter_eq_empty_iff]
  constructor
  · intro h; funext i; simpa using h (Finset.mem_univ i)
  · intro h i _; simp [h]

theorem vkey_eq_some {r : ℕ} {ω : Fin r → Bool} {i : Fin r} (h : vkey ω = some i) :
    ω i = true := by
  have := Finset.mem_of_min (s := Finset.univ.filter fun i => ω i = true) (a := i) h
  simpa using this

/-- **The partition of the vertices by their first true coordinate**:
`∏_ω X_ω = X_0 ∏_i ∏_{ω ∈ Ω_i} X_ω`. -/
theorem prod_vertices_split {M : Type*} [CommMonoid M] {r : ℕ} (X : (Fin r → Bool) → M) :
    ∏ ω, X ω = X (fun _ => false) * ∏ i : Fin r, ∏ ω with vkey ω = some i, X ω := by
  classical
  rw [← Finset.prod_fiberwise Finset.univ vkey X, Fintype.prod_option]
  congr 1
  have : (Finset.univ.filter fun ω : Fin r → Bool => vkey ω = none) = {fun _ => false} := by
    ext ω
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_singleton]
    exact vkey_eq_none_iff ω
  rw [this, Finset.prod_singleton]

/-! #### The cylinder state of `patch:dual-difference`

The state is `z = (a, (x, y), t)` with `a ∈ [0,H]^r`, two spatial variables `x, y` and one
parameter `t_{ω,β}` for each vertex `ω` and each of the two copies `β`. -/

/-- The two spatial factors of the vertex `ω`. -/
noncomputable def ddVert {Ω : Type*} (Ft : Ω → ℝ → ℂ) {r : ℕ} (ω : Fin r → Bool)
    (z : (Fin r → ℝ) × (ℝ × ℝ) × ((Fin r → Bool) × Bool → Ω)) (b : Fin r → ℝ) : ℂ :=
  conjPar (numTrue ω) (Ft (z.2.2 (ω, false)) (z.2.1.1 + ∑ i, cubeSel ω b z.1 i))
    * conj (conjPar (numTrue ω) (Ft (z.2.2 (ω, true)) (z.2.1.2 + ∑ i, cubeSel ω b z.1 i)))

/-- The head `v` of the cylinder induction: indicator, phase and the zero vertex. -/
noncomputable def ddHead {Ω : Type*} {r : ℕ} (E : Set ((Fin r → ℝ) × (Fin r → ℝ)))
    (φ : (Fin r → ℝ) × (Fin r → ℝ) → ℝ) (Ft : Ω → ℝ → ℂ)
    (z : (Fin r → ℝ) × (ℝ × ℝ) × ((Fin r → Bool) × Bool → Ω)) (b : Fin r → ℝ) : ℂ :=
  Set.indicator E (fun _ => (1 : ℂ)) (z.1, b) * ephase (φ (z.1, b) * (z.2.1.1 - z.2.1.2))
    * ddVert Ft (fun _ => false) z b

/-- The nuisance `u_i`: the vertices whose first true coordinate is `i`. -/
noncomputable def ddNuis {Ω : Type*} (Ft : Ω → ℝ → ℂ) {r : ℕ} (i : Fin r)
    (z : (Fin r → ℝ) × (ℝ × ℝ) × ((Fin r → Bool) × Bool → Ω)) (b : Fin r → ℝ) : ℂ :=
  ∏ ω with vkey ω = some i, ddVert Ft ω z b

/-- The cube set `□^r E`. -/
def cubeBoxSet {r : ℕ} (E : Set ((Fin r → ℝ) × (Fin r → ℝ))) :
    Set ((Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ)) :=
  {p | ∀ ω : Fin r → Bool, (p.1, cubeSel ω p.2.1 p.2.2) ∈ E}

/-- The alternating phase `ψ(a,b,c) = Σ_ω (-1)^{|ω|} φ(a, b^ω)`. -/
noncomputable def altPhase {r : ℕ} (φ : (Fin r → ℝ) × (Fin r → ℝ) → ℝ)
    (p : (Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ)) : ℝ :=
  ∑ ω : Fin r → Bool, (-1) ^ numTrue ω * φ (p.1, cubeSel ω p.2.1 p.2.2)

theorem conjPar_one_val (n : ℕ) : conjPar n (1 : ℂ) = 1 := by
  unfold conjPar; split_ifs <;> simp

theorem conjPar_zero_val (n : ℕ) : conjPar n (0 : ℂ) = 0 := by
  unfold conjPar; split_ifs <;> simp

theorem numTrue_false {r : ℕ} : numTrue (fun _ : Fin r => false) = 0 := by simp [numTrue]

theorem ddHead_mul_nuis {Ω : Type*} {r : ℕ} (E : Set ((Fin r → ℝ) × (Fin r → ℝ)))
    (φ : (Fin r → ℝ) × (Fin r → ℝ) → ℝ) (Ft : Ω → ℝ → ℂ)
    (z : (Fin r → ℝ) × (ℝ × ℝ) × ((Fin r → Bool) × Bool → Ω)) (b : Fin r → ℝ) :
    ddHead E φ Ft z b * ∏ i, ddNuis Ft i z b
      = Set.indicator E (fun _ => (1 : ℂ)) (z.1, b) * ephase (φ (z.1, b) * (z.2.1.1 - z.2.1.2))
        * ∏ ω, ddVert Ft ω z b := by
  rw [prod_vertices_split (fun ω => ddVert Ft ω z b), ddHead]
  simp only [ddNuis]
  ring

theorem ddNuis_update {Ω : Type*} (Ft : Ω → ℝ → ℂ) {r : ℕ} (i : Fin r)
    (z : (Fin r → ℝ) × (ℝ × ℝ) × ((Fin r → Bool) × Bool → Ω)) (b : Fin r → ℝ) (β : ℝ) :
    ddNuis Ft i z (Function.update b i β) = ddNuis Ft i z b := by
  unfold ddNuis
  refine Finset.prod_congr rfl fun ω hω => ?_
  have hωi : ω i = true := vkey_eq_some (Finset.mem_filter.mp hω).2
  have hsel : cubeSel ω (Function.update b i β) z.1 = cubeSel ω b z.1 := by
    funext j
    by_cases hj : j = i
    · subst hj; simp [cubeSel, hωi]
    · simp [cubeSel, Function.update_of_ne hj]
  simp only [ddVert, hsel]

theorem prod_indicator_vertices {r : ℕ} (E : Set ((Fin r → ℝ) × (Fin r → ℝ)))
    (a b c : Fin r → ℝ) :
    ∏ ω : Fin r → Bool, conjPar (numTrue ω)
        (Set.indicator E (fun _ => (1 : ℂ)) (a, cubeSel ω b c))
      = Set.indicator (cubeBoxSet E) (fun _ => (1 : ℂ)) (a, b, c) := by
  classical
  by_cases h : (a, b, c) ∈ cubeBoxSet E
  · rw [Set.indicator_of_mem h]
    refine Finset.prod_eq_one fun ω _ => ?_
    rw [Set.indicator_of_mem (h ω), conjPar_one_val]
  · rw [Set.indicator_of_notMem h]
    simp only [cubeBoxSet, Set.mem_ofPred_eq, not_forall] at h
    obtain ⟨ω, hω⟩ := h
    refine Finset.prod_eq_zero (Finset.mem_univ ω) ?_
    rw [Set.indicator_of_notMem hω, conjPar_zero_val]

/-- **The cube of the head** (`patch:dual-difference`): the corners multiply the indicators to
`1_{□^r E}`, the phases to `e(ψ (x - y))`, and the two spatial factors to the paired cubes
`D^r_{c,b} F_{t_{0,0}}(x)` and the conjugate of `D^r_{c,b} F_{t_{0,1}}(y)`. -/
theorem cubeProdSel_ddHead {Ω : Type*} {r : ℕ} (E : Set ((Fin r → ℝ) × (Fin r → ℝ)))
    (φ : (Fin r → ℝ) × (Fin r → ℝ) → ℝ) (Ft : Ω → ℝ → ℂ)
    (z : (Fin r → ℝ) × (ℝ × ℝ) × ((Fin r → Bool) × Bool → Ω)) (b c : Fin r → ℝ) :
    cubeProdSel (ddHead E φ Ft z) b c
      = Set.indicator (cubeBoxSet E) (fun _ => (1 : ℂ)) (z.1, b, c)
        * ephase (altPhase φ (z.1, b, c) * (z.2.1.1 - z.2.1.2))
        * cubeProdSel (fun β => Ft (z.2.2 ((fun _ => false), false)) (z.2.1.1 + ∑ i, β i)) b c
        * conj (cubeProdSel (fun β => Ft (z.2.2 ((fun _ => false), true))
            (z.2.1.2 + ∑ i, β i)) b c) := by
  have hv : ∀ β : Fin r → ℝ, ddHead E φ Ft z β
      = Set.indicator E (fun _ => (1 : ℂ)) (z.1, β) * ephase (φ (z.1, β) * (z.2.1.1 - z.2.1.2))
        * (Ft (z.2.2 ((fun _ => false), false)) (z.2.1.1 + ∑ i, β i)
          * conj (Ft (z.2.2 ((fun _ => false), true)) (z.2.1.2 + ∑ i, β i))) := by
    intro β
    simp only [ddHead, ddVert, numTrue_false, conjPar_zero, cubeSel_const_false]
  unfold cubeProdSel
  simp_rw [hv, conjPar_mul, Finset.prod_mul_distrib, conjPar_conj]
  rw [prod_indicator_vertices, ← map_prod]
  have hph : ∏ ω : Fin r → Bool, conjPar (numTrue ω)
      (ephase (φ (z.1, cubeSel ω b c) * (z.2.1.1 - z.2.1.2)))
        = ephase (altPhase φ (z.1, b, c) * (z.2.1.1 - z.2.1.2)) := by
    rw [altPhase, Finset.sum_mul, ephase_sum]
    refine Finset.prod_congr rfl fun ω _ => ?_
    rw [conjPar_ephase, mul_assoc]
  rw [hph]
  ring

/-- **Independent parameters average each vertex separately**:
`E_t ∏_ω X_ω = D^r_{a,b} F(x) conj D^r_{a,b} F(y)` with `F = E_t F_t`. -/
theorem integral_prod_ddVert {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    [IsProbabilityMeasure μ] (Ft : Ω → ℝ → ℂ) {r : ℕ} (a : Fin r → ℝ) (x y : ℝ)
    (b : Fin r → ℝ) :
    ∫ tt, ∏ ω, ddVert Ft ω (a, (x, y), tt) b ∂(Measure.pi fun _ => μ)
      = cubeProdSel (fun β => ∫ t, Ft t (x + ∑ i, β i) ∂μ) b a
        * conj (cubeProdSel (fun β => ∫ t, Ft t (y + ∑ i, β i) ∂μ) b a) := by
  set h : (Fin r → Bool) × Bool → Ω → ℂ := fun k t =>
    if k.2 then conj (conjPar (numTrue k.1) (Ft t (y + ∑ i, cubeSel k.1 b a i)))
    else conjPar (numTrue k.1) (Ft t (x + ∑ i, cubeSel k.1 b a i)) with hh
  have hpt : ∀ tt : (Fin r → Bool) × Bool → Ω,
      ∏ ω, ddVert Ft ω (a, (x, y), tt) b = ∏ k, h k (tt k) := by
    intro tt
    rw [Fintype.prod_prod_type]
    refine Finset.prod_congr rfl fun ω _ => ?_
    rw [Fintype.prod_bool]
    simp only [hh, ddVert, ite_true, Bool.false_eq_true, ite_false]
    ring
  simp_rw [hpt]
  rw [integral_fintype_prod_eq_prod, Fintype.prod_prod_type]
  unfold cubeProdSel
  rw [map_prod, ← Finset.prod_mul_distrib]
  refine Finset.prod_congr rfl fun ω _ => ?_
  rw [Fintype.prod_bool]
  simp only [hh, ite_true, Bool.false_eq_true, ite_false]
  rw [integral_conj, integral_conjPar, integral_conjPar, mul_comm]

/-- Two distinct coordinates of an independent family are independent. -/
theorem integral_pi_two_coords {ι Ω : Type*} [Fintype ι] [MeasurableSpace Ω]
    {μ : Measure Ω} [IsProbabilityMeasure μ] {k0 k1 : ι} (hk : k0 ≠ k1) (A B : Ω → ℂ) :
    ∫ tt, A (tt k0) * B (tt k1) ∂(Measure.pi fun _ : ι => μ) = (∫ t, A t ∂μ) * ∫ t, B t ∂μ := by
  classical
  set h : ι → Ω → ℂ := fun k => if k = k0 then A else if k = k1 then B else fun _ => 1 with hh
  have h0 : h k0 = A := by simp [hh]
  have h1 : h k1 = B := by simp [hh, hk.symm]
  have hpt : ∀ tt : ι → Ω, A (tt k0) * B (tt k1) = ∏ k, h k (tt k) := by
    intro tt
    rw [Finset.prod_eq_mul k0 k1 hk (fun k _ hne => by simp [hh, hne.1, hne.2])
      (fun h => absurd (Finset.mem_univ _) h) (fun h => absurd (Finset.mem_univ _) h), h0, h1]
  simp_rw [hpt]
  rw [integral_fintype_prod_eq_prod, Finset.prod_eq_mul k0 k1 hk
    (fun k _ hne => by simp [hh, hne.1, hne.2])
    (fun h => absurd (Finset.mem_univ _) h) (fun h => absurd (Finset.mem_univ _) h), h0, h1]

/-- **The spatial square**: `E_{x,y} e(s(x - y)) g(x) conj g(y) = |E_x e(s x) g(x)|²`. -/
theorem integral_prod_ephase_conj {μ' : Measure ℝ} [SFinite μ'] (s : ℝ) (g : ℝ → ℂ) :
    ∫ p : ℝ × ℝ, ephase (s * (p.1 - p.2)) * g p.1 * conj (g p.2) ∂(μ'.prod μ')
      = ((‖∫ x, ephase (s * x) * g x ∂μ'‖ ^ 2 : ℝ) : ℂ) := by
  have hpt : ∀ p : ℝ × ℝ, ephase (s * (p.1 - p.2)) * g p.1 * conj (g p.2)
      = (ephase (s * p.1) * g p.1) * conj (ephase (s * p.2) * g p.2) := by
    intro p
    rw [mul_sub, ephase_sub, map_mul]
    ring
  simp_rw [hpt]
  rw [integral_prod_mul (fun x => ephase (s * x) * g x) (fun y => conj (ephase (s * y) * g y)),
    integral_conj, Complex.mul_conj, Complex.normSq_eq_norm_sq, Complex.ofReal_pow]

/-- The paired cube vanishes when its zero vertex does. -/
theorem cubeProdSel_eq_zero_of_head {B : Type*} {r : ℕ} {v : (Fin r → B) → ℂ} {b c : Fin r → B}
    (h : v b = 0) : cubeProdSel v b c = 0 := by
  refine Finset.prod_eq_zero (Finset.mem_univ (fun _ => false)) ?_
  rw [cubeSel_const_false, h, conjPar_zero_val]

/-- For shifts in `[0,H]^r`, a function supported in `[c, c + S]` has paired cubes supported in
`J_r = [c - r H, c + S]`. -/
theorem shift_notMem_Icc {r : ℕ} {H c S : ℝ} {b : Fin r → ℝ} (hb : ∀ i, b i ∈ Set.Icc 0 H)
    {x : ℝ} (hx : x ∉ Set.Icc (c - r * H) (c + S)) : x + ∑ i, b i ∉ Set.Icc c (c + S) := by
  have h0 : 0 ≤ ∑ i, b i := Finset.sum_nonneg fun i _ => (hb i).1
  have h1 : ∑ i, b i ≤ r * H := by
    calc ∑ i, b i ≤ ∑ _i : Fin r, H := Finset.sum_le_sum fun i _ => (hb i).2
      _ = r * H := by simp
  intro h
  exact hx ⟨by linarith [h.1], by linarith [h.2]⟩

theorem indicator_one_ofReal {α : Type*} (E : Set α) (p : α) :
    Set.indicator E (fun _ => (1 : ℂ)) p = ((Set.indicator E (fun _ => (1 : ℝ)) p : ℝ) : ℂ) := by
  classical
  by_cases h : p ∈ E
  · simp [Set.indicator_of_mem h]
  · simp [Set.indicator_of_notMem h]

theorem norm_indicator_one_le {α : Type*} (E : Set α) (p : α) :
    ‖Set.indicator E (fun _ => (1 : ℂ)) p‖ ≤ 1 := by
  classical
  by_cases h : p ∈ E
  · simp [Set.indicator_of_mem h]
  · simp [Set.indicator_of_notMem h]

theorem measurable_ddVert {Ω : Type*} [MeasurableSpace Ω] {Ft : Ω → ℝ → ℂ}
    (hFm : Measurable (Function.uncurry Ft)) {r : ℕ} (ω : Fin r → Bool) :
    Measurable fun p : ((Fin r → ℝ) × (ℝ × ℝ) × ((Fin r → Bool) × Bool → Ω)) × (Fin r → ℝ) =>
      ddVert Ft ω p.1 p.2 := by
  have hsel : Measurable fun p : ((Fin r → ℝ) × (ℝ × ℝ) × ((Fin r → Bool) × Bool → Ω))
      × (Fin r → ℝ) => cubeSel ω p.2 p.1.1 :=
    (measurable_cubeSel ω).comp (measurable_snd.prodMk measurable_fst.fst)
  have hsum : Measurable fun p : ((Fin r → ℝ) × (ℝ × ℝ) × ((Fin r → Bool) × Bool → Ω))
      × (Fin r → ℝ) => ∑ i, cubeSel ω p.2 p.1.1 i :=
    Finset.measurable_sum _ fun i _ => (measurable_pi_apply i).comp hsel
  have hk : ∀ k : (Fin r → Bool) × Bool, Measurable fun p : ((Fin r → ℝ) × (ℝ × ℝ)
      × ((Fin r → Bool) × Bool → Ω)) × (Fin r → ℝ) => p.1.2.2 k :=
    fun k => (measurable_pi_apply k).comp measurable_fst.snd.snd
  have h1 := hFm.comp ((hk (ω, false)).prodMk (measurable_fst.snd.fst.fst.add hsum))
  have h2 := hFm.comp ((hk (ω, true)).prodMk (measurable_fst.snd.fst.snd.add hsum))
  exact ((measurable_conjPar _).comp h1).mul
    (Complex.continuous_conj.measurable.comp ((measurable_conjPar _).comp h2))

theorem norm_ddVert_le {Ω : Type*} {Ft : Ω → ℝ → ℂ} (hF1 : ∀ t x, ‖Ft t x‖ ≤ 1) {r : ℕ}
    (ω : Fin r → Bool) (z : (Fin r → ℝ) × (ℝ × ℝ) × ((Fin r → Bool) × Bool → Ω))
    (b : Fin r → ℝ) : ‖ddVert Ft ω z b‖ ≤ 1 := by
  rw [ddVert, norm_mul, RCLike.norm_conj, norm_conjPar, norm_conjPar]
  exact ((mul_le_of_le_one_left (norm_nonneg _) (hF1 _ _)).trans (hF1 _ _))

theorem measurable_ddHead {Ω : Type*} [MeasurableSpace Ω] {Ft : Ω → ℝ → ℂ}
    (hFm : Measurable (Function.uncurry Ft)) {r : ℕ} {E : Set ((Fin r → ℝ) × (Fin r → ℝ))}
    (hE : MeasurableSet E) {φ : (Fin r → ℝ) × (Fin r → ℝ) → ℝ} (hφ : Measurable φ) :
    Measurable (Function.uncurry (ddHead E φ Ft)) := by
  have hab : Measurable fun p : ((Fin r → ℝ) × (ℝ × ℝ) × ((Fin r → Bool) × Bool → Ω))
      × (Fin r → ℝ) => (p.1.1, p.2) := measurable_fst.fst.prodMk measurable_snd
  have hind : Measurable fun p : ((Fin r → ℝ) × (ℝ × ℝ) × ((Fin r → Bool) × Bool → Ω))
      × (Fin r → ℝ) => Set.indicator E (fun _ => (1 : ℂ)) (p.1.1, p.2) :=
    (measurable_const.indicator hE).comp hab
  have hph : Measurable fun p : ((Fin r → ℝ) × (ℝ × ℝ) × ((Fin r → Bool) × Bool → Ω))
      × (Fin r → ℝ) => ephase (φ (p.1.1, p.2) * (p.1.2.1.1 - p.1.2.1.2)) :=
    continuous_ephase.measurable.comp ((hφ.comp hab).mul
      (measurable_fst.snd.fst.fst.sub measurable_fst.snd.fst.snd))
  have h := (hind.mul hph).mul (measurable_ddVert hFm (fun _ => false))
  exact h

theorem norm_ddHead_le {Ω : Type*} {Ft : Ω → ℝ → ℂ} (hF1 : ∀ t x, ‖Ft t x‖ ≤ 1) {r : ℕ}
    (E : Set ((Fin r → ℝ) × (Fin r → ℝ))) (φ : (Fin r → ℝ) × (Fin r → ℝ) → ℝ)
    (z : (Fin r → ℝ) × (ℝ × ℝ) × ((Fin r → Bool) × Bool → Ω)) (b : Fin r → ℝ) :
    ‖ddHead E φ Ft z b‖ ≤ 1 := by
  rw [ddHead, norm_mul, norm_mul, norm_ephase, mul_one]
  exact ((mul_le_of_le_one_left (norm_nonneg _) (norm_indicator_one_le _ _)).trans (norm_ddVert_le
    hF1 _ _ _))

theorem measurable_ddNuis {Ω : Type*} [MeasurableSpace Ω] {Ft : Ω → ℝ → ℂ}
    (hFm : Measurable (Function.uncurry Ft)) {r : ℕ} (i : Fin r) :
    Measurable (Function.uncurry (ddNuis Ft i)) := by
  have h : Measurable fun p : ((Fin r → ℝ) × (ℝ × ℝ) × ((Fin r → Bool) × Bool → Ω))
      × (Fin r → ℝ) => ∏ ω with vkey ω = some i, ddVert Ft ω p.1 p.2 :=
    Finset.measurable_prod _ fun ω _ => measurable_ddVert hFm ω
  exact h

theorem norm_ddNuis_le {Ω : Type*} {Ft : Ω → ℝ → ℂ} (hF1 : ∀ t x, ‖Ft t x‖ ≤ 1) {r : ℕ}
    (i : Fin r) (z : (Fin r → ℝ) × (ℝ × ℝ) × ((Fin r → Bool) × Bool → Ω)) (b : Fin r → ℝ) :
    ‖ddNuis Ft i z b‖ ≤ 1 := by
  rw [ddNuis]
  exact (Finset.norm_prod_le _ _).trans
    (Finset.prod_le_one₀ (fun _ _ => norm_nonneg _) fun ω _ => norm_ddVert_le hF1 ω z b)

/-- The normalized square `|L⁻¹ I|² = (S/L)² |S⁻¹ I|²`. -/
theorem sq_norm_inv_mul_eq {S L : ℝ} (hS : 0 < S) (hL : 0 < L) (I : ℂ) :
    ‖((L : ℂ))⁻¹ * I‖ ^ 2 = (S / L) ^ 2 * ‖(S : ℂ)⁻¹ * I‖ ^ 2 := by
  rw [norm_mul, norm_mul, norm_inv, norm_inv, Complex.norm_real, Complex.norm_real,
    Real.norm_of_nonneg hS.le, Real.norm_of_nonneg hL.le]
  field_simp

/-- **The head side on one fibre** (`patch:dual-difference`): for `a` and `b ∈ [0,H]^r`,
integrating the spatial variables and the parameters gives
`(S/L)² 1_E(a,b) |S⁻¹ ∫ D^r_{a,b} F(x) e(φ(a,b) x) dx|²`, `L = S + r H`. -/
theorem integral_ddHead_nuis {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    [IsProbabilityMeasure μ] {Ft : Ω → ℝ → ℂ} (hFm : Measurable (Function.uncurry Ft))
    (hF1 : ∀ t x, ‖Ft t x‖ ≤ 1) {c S H : ℝ} (hS : 0 < S) (hH : 0 < H)
    (hFs : ∀ t x, x ∉ Set.Icc c (c + S) → Ft t x = 0) {r : ℕ}
    {E : Set ((Fin r → ℝ) × (Fin r → ℝ))} (hE : MeasurableSet E)
    {φ : (Fin r → ℝ) × (Fin r → ℝ) → ℝ} (hφ : Measurable φ) (a b : Fin r → ℝ)
    (hb : ∀ i, b i ∈ Set.Icc 0 H) :
    ∫ w, ddHead E φ Ft (a, w) b * ∏ i, ddNuis Ft i (a, w) b
        ∂(((unifIcc (c - r * H) (c + S)).prod (unifIcc (c - r * H) (c + S))).prod
          (Measure.pi fun _ : (Fin r → Bool) × Bool => μ))
      = (((S / (S + r * H)) ^ 2 * (Set.indicator E (fun _ => (1 : ℝ)) (a, b)
          * ‖(S : ℂ)⁻¹ * ∫ x, cubeProdSel (fun β => ∫ t, Ft t (x + ∑ i, β i) ∂μ) b a
              * ephase (φ (a, b) * x)‖ ^ 2) : ℝ) : ℂ) := by
  have hr0 : (0 : ℝ) ≤ r * H := by positivity
  have hpq : c - r * H < c + S := by linarith
  have := isProbabilityMeasure_unifIcc hpq
  set uJ := unifIcc (c - r * H) (c + S) with huJ
  set K : (ℝ × ℝ) → ((Fin r → Bool) × Bool → Ω) → ℂ := fun xy tt =>
    ddHead E φ Ft (a, (xy, tt)) b * ∏ i, ddNuis Ft i (a, (xy, tt)) b with hK
  have hKm : Measurable (Function.uncurry K) := by
    have hmap : Measurable fun q : (ℝ × ℝ) × ((Fin r → Bool) × Bool → Ω) =>
        (((a, (q.1, q.2)) : (Fin r → ℝ) × (ℝ × ℝ) × ((Fin r → Bool) × Bool → Ω)), b) :=
      (measurable_const.prodMk (measurable_fst.prodMk measurable_snd)).prodMk measurable_const
    have h1 := (measurable_ddHead hFm hE hφ).comp hmap
    have h2 := (Finset.measurable_prod Finset.univ fun i _ => (measurable_ddNuis hFm i).comp hmap)
    have h3 := h1.mul h2
    exact h3
  have hKb : ∀ xy tt, ‖K xy tt‖ ≤ 1 := fun xy tt => by
    simp only [hK, norm_mul]
    exact ((mul_le_of_le_one_left (norm_nonneg _) (norm_ddHead_le hF1 _ _ _ _)).trans
      ((Finset.norm_prod_le _ _).trans
        (Finset.prod_le_one₀ (fun _ _ => norm_nonneg _) fun i _ => norm_ddNuis_le hF1 i _ _)))
  have hstep := integral_prod_of_bdd (μ := uJ.prod uJ)
    (ν := Measure.pi fun _ : (Fin r → Bool) × Bool => μ) hKm hKb
  simp only [hK] at hstep
  rw [show (fun w : (ℝ × ℝ) × ((Fin r → Bool) × Bool → Ω) =>
      ddHead E φ Ft (a, w) b * ∏ i, ddNuis Ft i (a, w) b)
      = fun w => ddHead E φ Ft (a, (w.1, w.2)) b * ∏ i, ddNuis Ft i (a, (w.1, w.2)) b from rfl,
    hstep]
  set DF : ℝ → ℂ := fun x => cubeProdSel (fun β => ∫ t, Ft t (x + ∑ i, β i) ∂μ) b a with hDF
  have hin : ∀ xy : ℝ × ℝ, (∫ tt, ddHead E φ Ft (a, (xy, tt)) b
        * ∏ i, ddNuis Ft i (a, (xy, tt)) b ∂(Measure.pi fun _ : (Fin r → Bool) × Bool => μ))
      = Set.indicator E (fun _ => (1 : ℂ)) (a, b)
        * (ephase (φ (a, b) * (xy.1 - xy.2)) * DF xy.1 * conj (DF xy.2)) := by
    intro xy
    simp_rw [ddHead_mul_nuis]
    rw [integral_const_mul]
    have := integral_prod_ddVert (μ := μ) Ft a xy.1 xy.2 b
    simp only [Prod.mk.eta] at this
    rw [this]
    simp only [hDF]
    ring
  simp_rw [hin]
  rw [integral_const_mul, integral_prod_ephase_conj]
  have hDFs : ∀ x, x ∉ Set.Icc (c - r * H) (c + S) → ephase (φ (a, b) * x) * DF x = 0 := by
    intro x hx
    have h0 : (∫ t, Ft t (x + ∑ i, b i) ∂μ) = 0 := by
      rw [integral_congr_ae (Eventually.of_forall fun t => hFs t _ (shift_notMem_Icc hb hx))]
      simp
    rw [hDF]
    simp only
    rw [cubeProdSel_eq_zero_of_head (v := fun β => ∫ t, Ft t (x + ∑ i, β i) ∂μ) h0, mul_zero]
  rw [integral_unifIcc_of_support hpq hDFs]
  have hL : (c + S) - (c - r * H) = S + r * H := by ring
  rw [hL, sq_norm_inv_mul_eq hS (by linarith), indicator_one_ofReal]
  simp_rw [mul_comm (ephase _) (DF _)]
  push_cast
  ring

/-- **The cube side on one fibre** (`patch:dual-difference`): for `a`, `b ∈ [0,H]^r` and `c`,
integrating the spatial variables and the parameters of the cube of the head gives
`(S/L)² 1_{□^r E}(a,b,c) |S⁻¹ ∫ G_{b,c}(x) e(ψ(a,b,c) x) dx|²`,
`G_{b,c} = E_t D^r_{c,b} F_t`. -/
theorem integral_cube_ddHead {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    [IsProbabilityMeasure μ] {Ft : Ω → ℝ → ℂ} (hFm : Measurable (Function.uncurry Ft))
    (hF1 : ∀ t x, ‖Ft t x‖ ≤ 1) {c S H : ℝ} (hS : 0 < S) (hH : 0 < H)
    (hFs : ∀ t x, x ∉ Set.Icc c (c + S) → Ft t x = 0) {r : ℕ}
    {E : Set ((Fin r → ℝ) × (Fin r → ℝ))} (hE : MeasurableSet E)
    {φ : (Fin r → ℝ) × (Fin r → ℝ) → ℝ} (hφ : Measurable φ) (a b c' : Fin r → ℝ)
    (hb : ∀ i, b i ∈ Set.Icc 0 H) :
    ∫ w, cubeProdSel (ddHead E φ Ft (a, w)) b c'
        ∂(((unifIcc (c - r * H) (c + S)).prod (unifIcc (c - r * H) (c + S))).prod
          (Measure.pi fun _ : (Fin r → Bool) × Bool => μ))
      = (((S / (S + r * H)) ^ 2 * (Set.indicator (cubeBoxSet E) (fun _ => (1 : ℝ)) (a, b, c')
          * ‖(S : ℂ)⁻¹ * ∫ x, (∫ t, cubeProdSel (fun β => Ft t (x + ∑ i, β i)) b c' ∂μ)
              * ephase (altPhase φ (a, b, c') * x)‖ ^ 2) : ℝ) : ℂ) := by
  classical
  have hr0 : (0 : ℝ) ≤ r * H := by positivity
  have hpq : c - r * H < c + S := by linarith
  have := isProbabilityMeasure_unifIcc hpq
  set uJ := unifIcc (c - r * H) (c + S) with huJ
  set K : (ℝ × ℝ) → ((Fin r → Bool) × Bool → Ω) → ℂ := fun xy tt =>
    cubeProdSel (ddHead E φ Ft (a, (xy, tt))) b c' with hK
  have hKm : Measurable (Function.uncurry K) := by
    have hmap : Measurable fun q : (ℝ × ℝ) × ((Fin r → Bool) × Bool → Ω) =>
        (((a, (q.1, q.2)) : (Fin r → ℝ) × (ℝ × ℝ) × ((Fin r → Bool) × Bool → Ω)), (b, c')) :=
      (measurable_const.prodMk (measurable_fst.prodMk measurable_snd)).prodMk measurable_const
    have h1 := (measurable_cubeProdSel_param (measurable_ddHead hFm hE hφ)).comp hmap
    exact h1
  have hKb : ∀ xy tt, ‖K xy tt‖ ≤ 1 := fun xy tt =>
    norm_cubeProdSel_le (norm_ddHead_le hF1 E φ _) b c'
  have hstep := integral_prod_of_bdd (μ := uJ.prod uJ)
    (ν := Measure.pi fun _ : (Fin r → Bool) × Bool => μ) hKm hKb
  simp only [hK] at hstep
  rw [show (fun w : (ℝ × ℝ) × ((Fin r → Bool) × Bool → Ω) =>
      cubeProdSel (ddHead E φ Ft (a, w)) b c')
      = fun w => cubeProdSel (ddHead E φ Ft (a, (w.1, w.2))) b c' from rfl, hstep]
  set G : ℝ → ℂ := fun x => ∫ t, cubeProdSel (fun β => Ft t (x + ∑ i, β i)) b c' ∂μ with hG
  have hk : ((fun _ => false, false) : (Fin r → Bool) × Bool) ≠ (fun _ => false, true) := by
    simp
  have hin : ∀ xy : ℝ × ℝ, (∫ tt, cubeProdSel (ddHead E φ Ft (a, (xy, tt))) b c'
        ∂(Measure.pi fun _ : (Fin r → Bool) × Bool => μ))
      = Set.indicator (cubeBoxSet E) (fun _ => (1 : ℂ)) (a, b, c')
        * (ephase (altPhase φ (a, b, c') * (xy.1 - xy.2)) * G xy.1 * conj (G xy.2)) := by
    intro xy
    simp_rw [cubeProdSel_ddHead]
    simp only [mul_assoc]
    rw [integral_const_mul, integral_const_mul]
    have := integral_pi_two_coords (μ := μ) hk
      (fun t => cubeProdSel (fun β => Ft t (xy.1 + ∑ i, β i)) b c')
      (fun t => conj (cubeProdSel (fun β => Ft t (xy.2 + ∑ i, β i)) b c'))
    rw [this, integral_conj]
  simp_rw [hin]
  rw [integral_const_mul, integral_prod_ephase_conj]
  have hGs : ∀ x, x ∉ Set.Icc (c - r * H) (c + S)
      → ephase (altPhase φ (a, b, c') * x) * G x = 0 := by
    intro x hx
    have h0 : G x = 0 := by
      rw [hG]
      simp only
      rw [integral_congr_ae (Eventually.of_forall fun t => cubeProdSel_eq_zero_of_head
        (v := fun β => Ft t (x + ∑ i, β i)) (hFs t _ (shift_notMem_Icc hb hx)))]
      simp
    rw [h0, mul_zero]
  rw [integral_unifIcc_of_support hpq hGs]
  have hL : (c + S) - (c - r * H) = S + r * H := by ring
  rw [hL, sq_norm_inv_mul_eq hS (by linarith), indicator_one_ofReal]
  simp_rw [mul_comm (ephase _) (G _)]
  push_cast
  ring

set_option maxHeartbeats 1000000 in
-- The Fubini rearrangements of both sides of the cylinder inequality share one context.
/-- **Lemma `patch:dual-difference`, inequality `patch:dual-diff-bound`.** Let
`F = E_t F_t` with `F_t` jointly measurable, one-bounded and supported in `J = [c, c + S]`, let
`E ⊆ [0,H]^{2r}` and `φ` be measurable, `r ≥ 1`, and put
`θ = E_{a,b} 1_E(a,b) |S⁻¹ ∫ D^r_{a,b} F(x) e(φ(a,b) x) dx|²`. Then with
`G_{b,c} = E_t D^r_{c,b} F_t`, `ψ(a,b,c) = Σ_ω (-1)^{|ω|} φ(a,b^ω)` and `T = (S + r H)/S`,
`θ^{2^r} ≤ T^{2(2^r - 1)} E_{a,b,c} 1_{□^r E}(a,b,c) |S⁻¹ ∫ G_{b,c}(x) e(ψ(a,b,c) x) dx|²`. -/
theorem dual_diff_bound {Ω : Type} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
    {r : ℕ} (hr : 1 ≤ r) {c S H : ℝ} (hS : 0 < S) (hH : 0 < H) {Ft : Ω → ℝ → ℂ}
    (hFm : Measurable (Function.uncurry Ft)) (hF1 : ∀ t x, ‖Ft t x‖ ≤ 1)
    (hFs : ∀ t x, x ∉ Set.Icc c (c + S) → Ft t x = 0)
    {E : Set ((Fin r → ℝ) × (Fin r → ℝ))} (hE : MeasurableSet E)
    {φ : (Fin r → ℝ) × (Fin r → ℝ) → ℝ} (hφ : Measurable φ) :
    (∫ a, ∫ b, Set.indicator E (fun _ => (1 : ℝ)) (a, b)
        * ‖(S : ℂ)⁻¹ * ∫ x, cubeProdSel (fun β => ∫ t, Ft t (x + ∑ i, β i) ∂μ) b a
            * ephase (φ (a, b) * x)‖ ^ 2
        ∂(Measure.pi fun _ => unifMeas H) ∂(Measure.pi fun _ => unifMeas H)) ^ (2 ^ r)
      ≤ ((S + r * H) / S) ^ (2 * (2 ^ r - 1))
        * ∫ a, ∫ b, ∫ c', Set.indicator (cubeBoxSet E) (fun _ => (1 : ℝ)) (a, b, c')
            * ‖(S : ℂ)⁻¹ * ∫ x, (∫ t, cubeProdSel (fun β => Ft t (x + ∑ i, β i)) b c' ∂μ)
                * ephase (altPhase φ (a, b, c') * x)‖ ^ 2
          ∂(Measure.pi fun _ => unifMeas H) ∂(Measure.pi fun _ => unifMeas H)
          ∂(Measure.pi fun _ => unifMeas H) := by
  obtain ⟨n, rfl⟩ : ∃ n, r = n + 1 := ⟨r - 1, by omega⟩
  have := isProbabilityMeasure_unifMeas hH
  have hr0 : (0 : ℝ) ≤ ((n + 1 : ℕ) : ℝ) * H := by positivity
  have hpq : c - ((n + 1 : ℕ) : ℝ) * H < c + S := by linarith
  have := isProbabilityMeasure_unifIcc hpq
  set πr := Measure.pi fun _ : Fin (n + 1) => unifMeas H with hπr
  set W := ((unifIcc (c - ((n + 1 : ℕ) : ℝ) * H) (c + S)).prod
    (unifIcc (c - ((n + 1 : ℕ) : ℝ) * H) (c + S))).prod
    (Measure.pi fun _ : (Fin (n + 1) → Bool) × Bool => μ) with hW
  set L := S + ((n + 1 : ℕ) : ℝ) * H with hL
  set q := S / L with hq
  have hLpos : 0 < L := by rw [hL]; linarith
  have hq0 : 0 < q := div_pos hS hLpos
  -- the cylinder inequality
  have cyl := sq_norm_pow_le_integral_cubeProdSel_prod (ν := unifMeas H) n (πr.prod W)
    (v := ddHead E φ Ft) (u := fun i => ddNuis Ft i) (measurable_ddHead hFm hE hφ)
    (norm_ddHead_le hF1 E φ) (fun i => measurable_ddNuis hFm i)
    (fun i z b => norm_ddNuis_le hF1 i z b) (fun i z b β => ddNuis_update Ft i z b β)
  -- the head side
  set θ := ∫ a, ∫ b, Set.indicator E (fun _ => (1 : ℝ)) (a, b)
    * ‖(S : ℂ)⁻¹ * ∫ x, cubeProdSel (fun β => ∫ t, Ft t (x + ∑ i, β i) ∂μ) b a
        * ephase (φ (a, b) * x)‖ ^ 2 ∂πr ∂πr with hθ
  set Kh : ((Fin (n + 1) → ℝ) × (ℝ × ℝ) × ((Fin (n + 1) → Bool) × Bool → Ω))
      → (Fin (n + 1) → ℝ) → ℂ := fun z b => ddHead E φ Ft z b * ∏ i, ddNuis Ft i z b with hKh
  have hKhm : Measurable (Function.uncurry Kh) := by
    have h := (measurable_ddHead hFm hE hφ).mul
      (Finset.measurable_prod Finset.univ fun i _ => measurable_ddNuis hFm i)
    exact h
  have hKhb : ∀ z b, ‖Kh z b‖ ≤ 1 := fun z b => by
    simp only [hKh, norm_mul]
    exact ((mul_le_of_le_one_left (norm_nonneg _) (norm_ddHead_le hF1 _ _ _ _)).trans
      ((Finset.norm_prod_le _ _).trans
        (Finset.prod_le_one₀ (fun _ _ => norm_nonneg _) fun i _ => norm_ddNuis_le hF1 i _ _)))
  have hA : (∫ z, ∫ b, Kh z b ∂πr ∂(πr.prod W)) = ((q ^ 2 * θ : ℝ) : ℂ) := by
    have hm1 : Measurable (Function.uncurry fun (a : Fin (n + 1) → ℝ)
        (w : (ℝ × ℝ) × ((Fin (n + 1) → Bool) × Bool → Ω)) => ∫ b, Kh (a, w) b ∂πr) := by
      have h := (hKhm.stronglyMeasurable.integral_prod_right (ν := πr)).measurable
      exact h
    rw [show (fun z : (Fin (n + 1) → ℝ) × (ℝ × ℝ) × ((Fin (n + 1) → Bool) × Bool → Ω) =>
        ∫ b, Kh z b ∂πr) = fun z => ∫ b, Kh (z.1, z.2) b ∂πr from rfl,
      integral_prod_of_bdd hm1 (C := 1) fun a w => norm_integral_le_one fun b => hKhb _ b]
    have hin : ∀ a : Fin (n + 1) → ℝ, (∫ w, ∫ b, Kh (a, w) b ∂πr ∂W)
        = ((q ^ 2 * ∫ b, Set.indicator E (fun _ => (1 : ℝ)) (a, b)
          * ‖(S : ℂ)⁻¹ * ∫ x, cubeProdSel (fun β => ∫ t, Ft t (x + ∑ i, β i) ∂μ) b a
            * ephase (φ (a, b) * x)‖ ^ 2 ∂πr : ℝ) : ℂ) := by
      intro a
      have hm2 : Measurable (Function.uncurry fun
          (w : (ℝ × ℝ) × ((Fin (n + 1) → Bool) × Bool → Ω)) (b : Fin (n + 1) → ℝ) =>
            Kh (a, w) b) := by
        have h := hKhm.comp
          (((measurable_const (a := a)).prodMk measurable_fst).prodMk measurable_snd)
        exact h
      rw [integral_swap_of_bdd hm2 (C := 1) fun w b => hKhb _ b, ← integral_const_mul,
        ← integral_complex_ofReal]
      refine integral_congr_ae ((ae_pi_unifMeas_mem (n + 1)).mono fun b hb => ?_)
      beta_reduce
      simp only [hKh]
      rw [integral_ddHead_nuis hFm hF1 hS hH hFs hE hφ a b hb]
    simp_rw [hin]
    rw [integral_complex_ofReal, integral_const_mul]
  -- the cube side
  set LHS := ∫ a, ∫ b, ∫ c', Set.indicator (cubeBoxSet E) (fun _ => (1 : ℝ)) (a, b, c')
    * ‖(S : ℂ)⁻¹ * ∫ x, (∫ t, cubeProdSel (fun β => Ft t (x + ∑ i, β i)) b c' ∂μ)
        * ephase (altPhase φ (a, b, c') * x)‖ ^ 2 ∂πr ∂πr ∂πr with hLHS
  have hcm := measurable_cubeProdSel_param (measurable_ddHead hFm hE hφ)
  have hB : (∫ z, ∫ Q, cubeProdSel (ddHead E φ Ft z) Q.1 Q.2 ∂(πr.prod πr) ∂(πr.prod W))
      = ((q ^ 2 * LHS : ℝ) : ℂ) := by
    have hm1 : Measurable (Function.uncurry fun (a : Fin (n + 1) → ℝ)
        (w : (ℝ × ℝ) × ((Fin (n + 1) → Bool) × Bool → Ω)) =>
          ∫ Q, cubeProdSel (ddHead E φ Ft (a, w)) Q.1 Q.2 ∂(πr.prod πr)) := by
      have h := (hcm.stronglyMeasurable.integral_prod_right' (ν := πr.prod πr)).measurable
      exact h
    rw [show (fun z : (Fin (n + 1) → ℝ) × (ℝ × ℝ) × ((Fin (n + 1) → Bool) × Bool → Ω) =>
        ∫ Q, cubeProdSel (ddHead E φ Ft z) Q.1 Q.2 ∂(πr.prod πr))
        = fun z => ∫ Q, cubeProdSel (ddHead E φ Ft (z.1, z.2)) Q.1 Q.2 ∂(πr.prod πr) from rfl,
      integral_prod_of_bdd hm1 (C := 1) fun a w =>
        norm_integral_le_one fun Q => norm_cubeProdSel_le (norm_ddHead_le hF1 E φ _) _ _]
    have hin : ∀ a : Fin (n + 1) → ℝ,
        (∫ w, ∫ Q, cubeProdSel (ddHead E φ Ft (a, w)) Q.1 Q.2 ∂(πr.prod πr) ∂W)
        = ((q ^ 2 * ∫ b, ∫ c', Set.indicator (cubeBoxSet E) (fun _ => (1 : ℝ)) (a, b, c')
          * ‖(S : ℂ)⁻¹ * ∫ x, (∫ t, cubeProdSel (fun β => Ft t (x + ∑ i, β i)) b c' ∂μ)
            * ephase (altPhase φ (a, b, c') * x)‖ ^ 2 ∂πr ∂πr : ℝ) : ℂ) := by
      intro a
      have hm2 : Measurable (Function.uncurry fun
          (w : (ℝ × ℝ) × ((Fin (n + 1) → Bool) × Bool → Ω))
          (Q : (Fin (n + 1) → ℝ) × (Fin (n + 1) → ℝ)) =>
            cubeProdSel (ddHead E φ Ft (a, w)) Q.1 Q.2) := by
        have h := hcm.comp
          (((measurable_const (a := a)).prodMk measurable_fst).prodMk measurable_snd)
        exact h
      rw [integral_swap_of_bdd hm2 (C := 1) fun w Q =>
        norm_cubeProdSel_le (norm_ddHead_le hF1 E φ _) _ _]
      have hm3 : Measurable (Function.uncurry fun (b c' : Fin (n + 1) → ℝ) =>
          ∫ w, cubeProdSel (ddHead E φ Ft (a, w)) b c' ∂W) := by
        have hmap : Measurable fun p : ((Fin (n + 1) → ℝ) × (Fin (n + 1) → ℝ))
            × ((ℝ × ℝ) × ((Fin (n + 1) → Bool) × Bool → Ω)) =>
            (((a, p.2) : (Fin (n + 1) → ℝ) × (ℝ × ℝ) × ((Fin (n + 1) → Bool) × Bool → Ω)),
              (p.1.1, p.1.2)) :=
          ((measurable_const (a := a)).prodMk measurable_snd).prodMk
            (measurable_fst.fst.prodMk measurable_fst.snd)
        have h := ((hcm.comp hmap).stronglyMeasurable.integral_prod_right' (ν := W)).measurable
        exact h
      rw [show (fun Q : (Fin (n + 1) → ℝ) × (Fin (n + 1) → ℝ) =>
          ∫ w, cubeProdSel (ddHead E φ Ft (a, w)) Q.1 Q.2 ∂W)
          = fun Q => ∫ w, cubeProdSel (ddHead E φ Ft (a, w)) Q.1 Q.2 ∂W from rfl,
        integral_prod_of_bdd hm3 (C := 1) fun b c' =>
          norm_integral_le_one fun w => norm_cubeProdSel_le (norm_ddHead_le hF1 E φ _) _ _,
        ← integral_const_mul, ← integral_complex_ofReal]
      refine integral_congr_ae ((ae_pi_unifMeas_mem (n + 1)).mono fun b hb => ?_)
      simp only
      rw [← integral_const_mul, ← integral_complex_ofReal]
      refine integral_congr_ae (Eventually.of_forall fun c' => ?_)
      exact integral_cube_ddHead hFm hF1 hS hH hFs hE hφ a b c' hb
    simp_rw [hin]
    rw [integral_complex_ofReal, integral_const_mul]
  -- conclusion
  rw [hA, hB, Complex.norm_real, Complex.ofReal_re] at cyl
  have hθ0 : 0 ≤ θ := integral_nonneg fun a => integral_nonneg fun b =>
    mul_nonneg (Set.indicator_nonneg (fun _ _ => zero_le_one) _) (sq_nonneg _)
  rw [Real.norm_of_nonneg (by positivity), mul_pow] at cyl
  have hpow : (q ^ 2) ^ (2 ^ (n + 1)) = q ^ 2 * q ^ (2 * (2 ^ (n + 1) - 1)) := by
    rw [← pow_mul, ← pow_add]
    congr 1
    have : 1 ≤ 2 ^ (n + 1) := Nat.one_le_two_pow
    omega
  rw [hpow, mul_assoc] at cyl
  have h2 := le_of_mul_le_mul_left cyl (by positivity)
  have hT : (S + ((n + 1 : ℕ) : ℝ) * H) / S = q⁻¹ := by rw [hq, inv_div]
  rw [hT, inv_pow]
  rw [le_inv_mul_iff₀ (by positivity)]
  exact h2

end

/-! ### `patch:missing-phase`: removal of missing-coordinate phases

The dual-difference bound with a one-point parameter space and `E` the whole cube: the alternating
sum of phases independent of one coordinate vanishes. The support Cauchy-Schwarz and the order
raising `S Q_{r+1} = E_{b,c} ‖T_H D^r_{c,b} f‖²` finish the proof. -/

section
open Filter Topology MeasureTheory

/-- The window average preserves the integral on the line. -/
theorem integral_avgH {H : ℝ} (hH : 0 < H) {G : ℝ → ℂ} (hG : Measurable G) (hGi : Integrable G) :
    ∫ x, avgH H G x = ∫ x, G x := by
  have := isProbabilityMeasure_unifMeas hH
  have hm : Measurable (Function.uncurry fun (x a : ℝ) => G (x + a)) :=
    hG.comp (measurable_fst.add measurable_snd)
  have hint : Integrable (Function.uncurry fun (x a : ℝ) => G (x + a))
      ((volume : Measure ℝ).prod (unifMeas H)) := by
    rw [integrable_prod_iff' hm.aestronglyMeasurable]
    refine ⟨Eventually.of_forall fun a => hGi.comp_add_right a, ?_⟩
    have : ∀ a : ℝ, ∫ x, ‖Function.uncurry (fun (x a : ℝ) => G (x + a)) (x, a)‖ = ∫ x, ‖G x‖ :=
      fun a => integral_add_right_eq_self (fun x => ‖G x‖) a
    simp_rw [this]
    exact integrable_const _
  simp only [avgH]
  rw [integral_integral_swap hint]
  simp_rw [integral_add_right_eq_self (fun x => G x)]
  simp

/-- **The support Cauchy-Schwarz of `patch:missing-phase`**: for a one-bounded `u` supported in an
interval of length `S`, `|S⁻¹ ∫ u|² ≤ (1 + H/S) S⁻¹ ‖T_H u‖₂²`. -/
theorem sq_norm_integral_le_avgH {H S p : ℝ} (hH : 0 < H) (hS : 0 < S) {u : ℝ → ℂ}
    (hu : Measurable u) (hu1 : ∀ x, ‖u x‖ ≤ 1) (hus : ∀ x, x ∉ Set.Icc p (p + S) → u x = 0) :
    ‖(S : ℂ)⁻¹ * ∫ x, u x‖ ^ 2 ≤ (1 + H / S) * (S⁻¹ * ∫ x, ‖avgH H u x‖ ^ 2) := by
  have hui := integrable_of_bdd_Icc hu.aestronglyMeasurable hu1 hus
  have hAm := measurable_avgH (H := H) hu
  have hA1 := norm_avgH_le hH hu1
  have hAs : ∀ x, x ∉ Set.Icc (p - H) (p + S) → avgH H u x = 0 := avgH_eq_zero hH hus
  have hAi := integrable_of_bdd_Icc hAm.aestronglyMeasurable hA1 hAs
  have hA2i : Integrable fun x => ‖avgH H u x‖ ^ 2 :=
    integrable_of_bdd_Icc (C := 1) (p := p - H) (q := p + S)
      (hAm.norm.pow_const 2).aestronglyMeasurable
      (fun x => by
        rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
        exact pow_le_one₀ (norm_nonneg _) (hA1 x))
      (fun x hx => by simp [hAs x hx])
  have hcs := sq_norm_integral_le_measure_mul (μ := volume) measurableSet_Icc
    (by simp) hAs hA2i hAi.norm
  rw [Real.volume_Icc, ENNReal.toReal_ofReal (by linarith)] at hcs
  rw [← integral_avgH hH hu hui, norm_mul, mul_pow, norm_inv, Complex.norm_real,
    Real.norm_of_nonneg hS.le]
  have hS2 : 0 < (S⁻¹) ^ 2 := by positivity
  calc S⁻¹ ^ 2 * ‖∫ x, avgH H u x‖ ^ 2
      ≤ S⁻¹ ^ 2 * ((p + S - (p - H)) * ∫ x, ‖avgH H u x‖ ^ 2) :=
        mul_le_mul_of_nonneg_left hcs hS2.le
    _ = (1 + H / S) * (S⁻¹ * ∫ x, ‖avgH H u x‖ ^ 2) := by
        field_simp
        ring

/-- **The alternating sum of a phase independent of one coordinate vanishes.** -/
theorem altPhase_eq_zero_of_indep {r : ℕ} (i : Fin r) {φ : (Fin r → ℝ) × (Fin r → ℝ) → ℝ}
    (hφ : ∀ a b β, φ (a, Function.update b i β) = φ (a, b))
    (p : (Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ)) : altPhase φ p = 0 := by
  classical
  set flip : (Fin r → Bool) ≃ (Fin r → Bool) :=
    { toFun := fun ω => Function.update ω i (!ω i)
      invFun := fun ω => Function.update ω i (!ω i)
      left_inv := fun ω => by funext j; by_cases hj : j = i <;> simp [Function.update, hj]
      right_inv := fun ω => by funext j; by_cases hj : j = i <;> simp [Function.update, hj] }
    with hflip
  have hnum : ∀ ω : Fin r → Bool,
      ((-1 : ℝ) ^ numTrue (flip ω)) = -((-1 : ℝ) ^ numTrue ω) := by
    intro ω
    have hsplit : ∀ σ : Fin r → Bool, numTrue σ = (if σ i then 1 else 0)
        + ∑ j ∈ Finset.univ.erase i, if σ j then 1 else 0 := by
      intro σ
      rw [numTrue, ← Finset.add_sum_erase _ _ (Finset.mem_univ i)]
    have hrest : (∑ j ∈ Finset.univ.erase i, if flip ω j then 1 else 0)
        = ∑ j ∈ Finset.univ.erase i, if ω j then 1 else 0 := by
      refine Finset.sum_congr rfl fun j hj => ?_
      rw [hflip]
      simp [Function.update_of_ne (Finset.ne_of_mem_erase hj)]
    rw [hsplit (flip ω), hsplit ω, hrest]
    have hfi : flip ω i = !ω i := by rw [hflip]; simp
    rw [hfi]
    cases ω i <;> simp [pow_add, pow_succ]
  have hsel : ∀ ω : Fin r → Bool, φ (p.1, cubeSel (flip ω) p.2.1 p.2.2)
      = φ (p.1, cubeSel ω p.2.1 p.2.2) := by
    intro ω
    have : cubeSel (flip ω) p.2.1 p.2.2 = Function.update (cubeSel ω p.2.1 p.2.2) i
        (cubeSel (flip ω) p.2.1 p.2.2 i) := by
      funext j
      by_cases hj : j = i
      · subst hj; simp
      · rw [Function.update_of_ne hj, cubeSel, cubeSel, hflip]
        simp [Function.update_of_ne hj]
    rw [this, hφ]
  have hneg : altPhase φ p = -altPhase φ p := by
    conv_lhs => rw [altPhase, ← Equiv.sum_comp flip]
    rw [altPhase, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun ω _ => ?_
    rw [hnum, hsel]
    ring
  linarith

/-- The paired cube `D^r_{c,b} f` as a function of the pair `q = (b, c)` and the point. -/
theorem measurable_pairedCube {f : ℝ → ℂ} (hf : Measurable f) (r : ℕ) :
    Measurable fun t : ℝ × ((Fin r → ℝ) × (Fin r → ℝ)) =>
      cubeProdSel (fun β => f (t.1 + ∑ i, β i)) t.2.1 t.2.2 := by
  have hv : Measurable (Function.uncurry fun (y : ℝ) (β : Fin r → ℝ) => f (y + ∑ i, β i)) :=
    hf.comp (measurable_fst.add
      (Finset.measurable_sum _ fun i _ => (measurable_pi_apply i).comp measurable_snd))
  exact measurable_cubeProdSel_param hv

theorem measurable_avgH_pairedCube {H : ℝ} {f : ℝ → ℂ} (hf : Measurable f) (r : ℕ) :
    Measurable fun t : ℝ × ((Fin r → ℝ) × (Fin r → ℝ)) =>
      avgH H (fun y => cubeProdSel (fun β => f (y + ∑ i, β i)) t.2.1 t.2.2) t.1 := by
  have hmap : Measurable fun s : (ℝ × ((Fin r → ℝ) × (Fin r → ℝ))) × ℝ =>
      ((s.1.1 + s.2, s.1.2) : ℝ × ((Fin r → ℝ) × (Fin r → ℝ))) :=
    (measurable_fst.fst.add measurable_snd).prodMk measurable_fst.snd
  have h := ((measurable_pairedCube hf r).comp hmap).stronglyMeasurable.integral_prod_right'
    (ν := unifMeas H)
  exact h.measurable

theorem pairedCube_eq_zero {f : ℝ → ℂ} {c S : ℝ} (hfs : ∀ x, x ∉ Set.Icc c (c + S) → f x = 0)
    {r : ℕ} (b c' : Fin r → ℝ) (y : ℝ)
    (hy : y ∉ Set.Icc (c - ∑ i, b i) (c + S - ∑ i, b i)) :
    cubeProdSel (fun β => f (y + ∑ i, β i)) b c' = 0 := by
  refine cubeProdSel_eq_zero_of_head (hfs _ fun h => hy ⟨?_, ?_⟩)
  · linarith [h.1]
  · linarith [h.2]

/-- The order-`r+1` cube at the doubled pair `(snoc b a, snoc c a')` is the order-`r` cube at
`x + a` times the conjugate order-`r` cube at `x + a'`. -/
theorem cubeProdSel_snoc_shift (f : ℝ → ℂ) {r : ℕ} (x a a' : ℝ) (b c' : Fin r → ℝ) :
    cubeProdSel (fun β : Fin (r + 1) → ℝ => f (x + ∑ i, β i)) (Fin.snoc b a) (Fin.snoc c' a')
      = cubeProdSel (fun β => f ((x + a) + ∑ i, β i)) b c'
        * conj (cubeProdSel (fun β => f ((x + a') + ∑ i, β i)) b c') := by
  rw [← cubeProdSel_cylStep (fun _ : Unit => fun β : Fin (r + 1) → ℝ => f (x + ∑ i, β i))
    () a a' b c']
  unfold cubeProdSel
  rw [map_prod, ← Finset.prod_mul_distrib]
  refine Finset.prod_congr rfl fun ω _ => ?_
  rw [cylStep, conjPar_mul, conjPar_conj]
  simp only [Fin.sum_univ_castSucc, Fin.snoc_castSucc, Fin.snoc_last]
  congr 3 <;> ring_nf

/-- **Raising the order** (`patch:missing-phase`): `S Q_{r+1,H,S}(f)` is the average over
`b, c ∈ [0,H]^r` of `‖T_H D^r_{c,b} f‖₂²`. -/
theorem unifPow1_succ_eq {H S c : ℝ} (hH : 0 < H) (hS : 0 < S) {f : ℝ → ℂ} (hf : Measurable f)
    (hf1 : ∀ x, ‖f x‖ ≤ 1) (hfs : ∀ x, x ∉ Set.Icc c (c + S) → f x = 0) (r : ℕ) :
    S * unifPow1 H S (r + 1) f
      = ∫ b : Fin r → ℝ, ∫ c' : Fin r → ℝ,
          (∫ x, ‖avgH H (fun y => cubeProdSel (fun β => f (y + ∑ i, β i)) b c') x‖ ^ 2)
          ∂(Measure.pi fun _ => unifMeas H) ∂(Measure.pi fun _ => unifMeas H) := by
  have := isProbabilityMeasure_unifMeas hH
  set πr := Measure.pi fun _ : Fin r => unifMeas H with hπr
  set U : (Fin r → ℝ) × (Fin r → ℝ) → ℝ → ℂ := fun q y =>
    cubeProdSel (fun β => f (y + ∑ i, β i)) q.1 q.2 with hU
  have hU1 : ∀ q y, ‖U q y‖ ≤ 1 := fun q y => norm_cubeProdSel_le (fun β => hf1 _) _ _
  set F : ℝ → (Fin r → ℝ) × (Fin r → ℝ) → ℝ := fun x q => ‖avgH H (U q) x‖ ^ 2 with hF
  have hFm : Measurable (Function.uncurry F) :=
    (measurable_avgH_pairedCube (H := H) hf r).norm.pow_const 2
  have hF0 : ∀ x q, 0 ≤ F x q := fun x q => by positivity
  have hF1 : ∀ x q, F x q ≤ 1 := fun x q =>
    pow_le_one₀ (norm_nonneg _) (norm_avgH_le hH (hU1 q) x)
  -- the cube at a point is the average of `‖T_H U_q‖²`
  have hpt : ∀ x : ℝ, (∫ Q : (Fin (r + 1) → ℝ) × (Fin (r + 1) → ℝ),
      cubeProdSel (fun β => f (x + ∑ i, β i)) Q.1 Q.2
        ∂((Measure.pi fun _ => unifMeas H).prod (Measure.pi fun _ => unifMeas H)))
      = ((∫ q, F x q ∂(πr.prod πr) : ℝ) : ℂ) := by
    intro x
    set w : (Fin (r + 1) → ℝ) → ℂ := fun β => f (x + ∑ i, β i) with hw
    have hwm : Measurable w := measurable_cubeArg hf x
    have hwb : ∀ β, ‖w β‖ ≤ 1 := fun β => hf1 _
    have hcm : Measurable (Function.uncurry fun b c : Fin (r + 1) → ℝ => cubeProdSel w b c) := by
      have h := measurable_cubeProdSel (v := w) hwm
      exact h
    rw [integral_prod_of_bdd (f := fun b c => cubeProdSel w b c) hcm (C := 1)
      (fun b c => norm_cubeProdSel_le hwb b c), integral_cubeProdSel_snoc hwm hwb]
    simp only [hw, cubeProdSel_snoc_shift f x]
    have hm2 : Measurable (Function.uncurry fun (p : ℝ × ℝ) (q : (Fin r → ℝ) × (Fin r → ℝ)) =>
        U q (x + p.1) * conj (U q (x + p.2))) := by
      have hm1 : Measurable fun t : (ℝ × ℝ) × ((Fin r → ℝ) × (Fin r → ℝ)) =>
          ((x + t.1.1, t.2) : ℝ × ((Fin r → ℝ) × (Fin r → ℝ))) :=
        (measurable_const.add measurable_fst.fst).prodMk measurable_snd
      have hm1' : Measurable fun t : (ℝ × ℝ) × ((Fin r → ℝ) × (Fin r → ℝ)) =>
          ((x + t.1.2, t.2) : ℝ × ((Fin r → ℝ) × (Fin r → ℝ))) :=
        (measurable_const.add measurable_fst.snd).prodMk measurable_snd
      have h1 := (measurable_pairedCube hf r).comp hm1
      have h2 := (measurable_pairedCube hf r).comp hm1'
      have h3 := h1.mul (Complex.continuous_conj.measurable.comp h2)
      exact h3
    have := integral_swap_of_bdd (μ := (unifMeas H).prod (unifMeas H)) (ν := πr.prod πr) hm2
      (C := 1) fun p q => by
        rw [norm_mul, RCLike.norm_conj]
        exact ((mul_le_of_le_one_left (norm_nonneg _) (hU1 _ _)).trans (hU1 _ _))
    simp only [hU] at this
    rw [this, ← integral_complex_ofReal]
    refine integral_congr_ae (Eventually.of_forall fun q => ?_)
    simp only [hF]
    rw [integral_prod_mul (fun a => U q (x + a)) (fun a' => conj (U q (x + a'))),
      integral_conj, Complex.mul_conj, Complex.normSq_eq_norm_sq, Complex.ofReal_pow]
    simp only [Complex.ofReal_pow]
    rfl
  rw [unifPow1, ← mul_assoc, mul_inv_cancel₀ hS.ne', one_mul]
  simp_rw [hpt]
  rw [integral_complex_ofReal, Complex.ofReal_re]
  -- exchange the point and the pair
  have hint : Integrable (Function.uncurry F) ((volume : Measure ℝ).prod (πr.prod πr)) := by
    set g : ℝ → ℝ := Set.indicator (Set.Icc (c - H) (c + S)) (fun _ => 1) with hg
    have hgi : Integrable g := (continuous_const.integrableOn_Icc).integrable_indicator
      measurableSet_Icc
    have hgm : Measurable g := measurable_const.indicator measurableSet_Icc
    have hs : Measurable fun t : ℝ × ((Fin r → ℝ) × (Fin r → ℝ)) => t.1 + ∑ i, t.2.1 i :=
      measurable_fst.add
        (Finset.measurable_sum _ fun i _ => (measurable_pi_apply i).comp measurable_snd.fst)
    have hGm : Measurable fun t : ℝ × ((Fin r → ℝ) × (Fin r → ℝ)) => g (t.1 + ∑ i, t.2.1 i) :=
      hgm.comp hs
    have hGi : Integrable (fun t : ℝ × ((Fin r → ℝ) × (Fin r → ℝ)) => g (t.1 + ∑ i, t.2.1 i))
        ((volume : Measure ℝ).prod (πr.prod πr)) := by
      rw [integrable_prod_iff' hGm.aestronglyMeasurable]
      refine ⟨Eventually.of_forall fun q => hgi.comp_add_right (∑ i, q.1 i), ?_⟩
      have : ∀ q : (Fin r → ℝ) × (Fin r → ℝ),
          ∫ x, ‖g (x + ∑ i, q.1 i)‖ = ∫ x, ‖g x‖ := fun q =>
        integral_add_right_eq_self (fun x => ‖g x‖) _
      simp_rw [this]
      exact integrable_const _
    refine hGi.mono' hFm.aestronglyMeasurable (Eventually.of_forall fun t => ?_)
    change ‖F t.1 t.2‖ ≤ _
    rw [Real.norm_of_nonneg (hF0 _ _)]
    by_cases ht : t.1 + ∑ i, t.2.1 i ∈ Set.Icc (c - H) (c + S)
    · rw [hg, Set.indicator_of_mem ht]
      exact hF1 _ _
    · have hx : t.1 ∉ Set.Icc (c - ∑ i, t.2.1 i - H) (c + S - ∑ i, t.2.1 i) := fun h =>
        ht ⟨by linarith [h.1], by linarith [h.2]⟩
      have h0 : avgH H (U t.2) t.1 = 0 :=
        avgH_eq_zero hH (fun y hy => pairedCube_eq_zero hfs t.2.1 t.2.2 y hy) t.1 hx
      rw [hg, Set.indicator_of_notMem ht]
      change ‖avgH H (U t.2) t.1‖ ^ 2 ≤ 0
      rw [h0, norm_zero]
      norm_num
  rw [integral_integral_swap hint]
  -- split the pair
  have hHm : Measurable fun q : (Fin r → ℝ) × (Fin r → ℝ) => ∫ x, F x q := by
    have h := (hFm.comp (measurable_snd.prodMk measurable_fst)).stronglyMeasurable
      |>.integral_prod_right' (ν := (volume : Measure ℝ))
    exact h.measurable
  have hHb : ∀ q : (Fin r → ℝ) × (Fin r → ℝ), |∫ x, F x q| ≤ S + H := by
    intro q
    rw [abs_of_nonneg (integral_nonneg (fun x => hF0 x q))]
    have hsupp : ∀ x, x ∉ Set.Icc (c - ∑ i, q.1 i - H) (c + S - ∑ i, q.1 i) → F x q = 0 := by
      intro x hx
      have h0 : avgH H (U q) x = 0 :=
        avgH_eq_zero hH (fun y hy => pairedCube_eq_zero hfs q.1 q.2 y hy) x
          (by simpa [sub_sub] using hx)
      simp [hF, h0]
    calc ∫ x, F x q ≤ ∫ x, Set.indicator (Set.Icc (c - ∑ i, q.1 i - H) (c + S - ∑ i, q.1 i))
          (fun _ => (1 : ℝ)) x := by
          refine integral_mono_of_nonneg (Eventually.of_forall fun x => hF0 x q)
            ((continuous_const.integrableOn_Icc).integrable_indicator measurableSet_Icc)
            (Eventually.of_forall fun x => ?_)
          by_cases hx : x ∈ Set.Icc (c - ∑ i, q.1 i - H) (c + S - ∑ i, q.1 i)
          · rw [Set.indicator_of_mem hx]; exact hF1 x q
          · rw [Set.indicator_of_notMem hx]
            change F x q ≤ 0
            rw [hsupp x hx]
      _ = S + H := by
          rw [integral_indicator measurableSet_Icc, setIntegral_const, Real.volume_real_Icc,
            smul_eq_mul, mul_one]
          rw [max_eq_left (by linarith)]; ring
  rw [integral_prod _ (integrable_of_bdd_finite hHm hHb)]

theorem measurable_integral_sq_avgH_pairedCube {H : ℝ} {f : ℝ → ℂ} (hf : Measurable f) (r : ℕ) :
    Measurable fun q : (Fin r → ℝ) × (Fin r → ℝ) =>
      ∫ x, ‖avgH H (fun y => cubeProdSel (fun β => f (y + ∑ i, β i)) q.1 q.2) x‖ ^ 2 := by
  have hm := ((measurable_avgH_pairedCube (H := H) hf r).norm.pow_const 2).comp
    (measurable_snd.prodMk measurable_fst)
  have h := hm.stronglyMeasurable.integral_prod_right' (ν := (volume : Measure ℝ))
  exact h.measurable

theorem integral_sq_avgH_pairedCube_le {H S c : ℝ} (hH : 0 < H) (hS : 0 < S) {f : ℝ → ℂ}
    (hf1 : ∀ x, ‖f x‖ ≤ 1) (hfs : ∀ x, x ∉ Set.Icc c (c + S) → f x = 0) {r : ℕ}
    (b c' : Fin r → ℝ) :
    ∫ x, ‖avgH H (fun y => cubeProdSel (fun β => f (y + ∑ i, β i)) b c') x‖ ^ 2 ≤ S + H := by
  set U : ℝ → ℂ := fun y => cubeProdSel (fun β => f (y + ∑ i, β i)) b c' with hU
  have hU1 : ∀ y, ‖U y‖ ≤ 1 := fun y => norm_cubeProdSel_le (fun β => hf1 _) _ _
  have hsupp : ∀ x, x ∉ Set.Icc (c - ∑ i, b i - H) (c + S - ∑ i, b i) →
      ‖avgH H U x‖ ^ 2 = 0 := by
    intro x hx
    have h0 : avgH H U x = 0 :=
      avgH_eq_zero hH (fun y hy => pairedCube_eq_zero hfs b c' y hy) x
        (by simpa [sub_sub] using hx)
    simp [h0]
  calc ∫ x, ‖avgH H U x‖ ^ 2 ≤ ∫ x, Set.indicator (Set.Icc (c - ∑ i, b i - H) (c + S - ∑ i, b i))
        (fun _ => (1 : ℝ)) x := by
        refine integral_mono_of_nonneg (Eventually.of_forall fun x => by positivity)
          ((continuous_const.integrableOn_Icc).integrable_indicator measurableSet_Icc)
          (Eventually.of_forall fun x => ?_)
        by_cases hx : x ∈ Set.Icc (c - ∑ i, b i - H) (c + S - ∑ i, b i)
        · rw [Set.indicator_of_mem hx]
          exact pow_le_one₀ (norm_nonneg _) (norm_avgH_le hH hU1 x)
        · rw [Set.indicator_of_notMem hx]
          change ‖avgH H U x‖ ^ 2 ≤ 0
          rw [hsupp x hx]
    _ = S + H := by
        rw [integral_indicator measurableSet_Icc, setIntegral_const, Real.volume_real_Icc,
          smul_eq_mul, mul_one, max_eq_left (by linarith)]
        ring

set_option maxHeartbeats 1000000 in
-- The dual-difference bound, the support Cauchy-Schwarz and the order raising share one context.
/-- **Lemma `patch:missing-phase`, inequality `patch:missing-phase-bound`.** Let `f` be one-bounded
and supported in `J = [c, c + S]`, and let `φ_i(a,b)` be measurable and independent of `b_i`,
`1 ≤ i ≤ r`. If `θ = E_{a,b} |S⁻¹ ∫ D^r_{a,b} f(x) e((Σ_i φ_i(a,b)) x) dx|²`, then
`θ^{2^r} ≤ T^{2(2^r - 1)} (1 + H/S) Q_{r+1,H,S}(f)` with `T = (S + r H)/S`. -/
theorem missing_phase_bound {r : ℕ} (hr : 1 ≤ r) {c S H : ℝ} (hS : 0 < S) (hH : 0 < H)
    {f : ℝ → ℂ} (hf : Measurable f) (hf1 : ∀ x, ‖f x‖ ≤ 1)
    (hfs : ∀ x, x ∉ Set.Icc c (c + S) → f x = 0)
    {φ : Fin r → (Fin r → ℝ) × (Fin r → ℝ) → ℝ} (hφm : ∀ i, Measurable (φ i))
    (hφi : ∀ i a b β, φ i (a, Function.update b i β) = φ i (a, b)) :
    (∫ a, ∫ b, ‖(S : ℂ)⁻¹ * ∫ x, cubeProdSel (fun β => f (x + ∑ i, β i)) b a
          * ephase ((∑ i, φ i (a, b)) * x)‖ ^ 2
        ∂(Measure.pi fun _ => unifMeas H) ∂(Measure.pi fun _ => unifMeas H)) ^ (2 ^ r)
      ≤ ((S + r * H) / S) ^ (2 * (2 ^ r - 1)) * ((1 + H / S) * unifPow1 H S (r + 1) f) := by
  have := isProbabilityMeasure_unifMeas hH
  set πr := Measure.pi fun _ : Fin r => unifMeas H with hπr
  have hFm : Measurable (Function.uncurry fun (_ : Unit) (x : ℝ) => f x) := hf.comp measurable_snd
  have hdd := dual_diff_bound (μ := Measure.dirac ()) hr hS hH hFm (fun _ x => hf1 x)
    (fun _ x hx => hfs x hx) MeasurableSet.univ
    (φ := fun p => ∑ i, φ i p) (Finset.measurable_sum _ fun i _ => hφm i)
  have hbox : cubeBoxSet (Set.univ : Set ((Fin r → ℝ) × (Fin r → ℝ))) = Set.univ := by
    ext p; simp [cubeBoxSet]
  have halt : ∀ p, altPhase (fun p => ∑ i, φ i p) p = 0 := by
    intro p
    have : altPhase (fun p => ∑ i, φ i p) p = ∑ i, altPhase (φ i) p := by
      simp only [altPhase, Finset.mul_sum]
      rw [Finset.sum_comm]
    rw [this]
    exact Finset.sum_eq_zero fun i _ => altPhase_eq_zero_of_indep i (hφi i) p
  simp only [integral_dirac, Set.indicator_univ, hbox, halt, zero_mul, one_mul] at hdd
  refine hdd.trans (mul_le_mul_of_nonneg_left ?_ (by positivity))
  -- the support Cauchy-Schwarz and the order raising
  set I : (Fin r → ℝ) × (Fin r → ℝ) → ℝ := fun q =>
    ∫ x, ‖avgH H (fun y => cubeProdSel (fun β => f (y + ∑ i, β i)) q.1 q.2) x‖ ^ 2 with hI
  have hIm : Measurable I := measurable_integral_sq_avgH_pairedCube hf r
  have hI0 : ∀ q, 0 ≤ I q := fun q => integral_nonneg fun x => by positivity
  have hI1 : ∀ q, I q ≤ S + H := fun q => integral_sq_avgH_pairedCube_le hH hS hf1 hfs q.1 q.2
  set K : ℝ := (1 + H / S) * S⁻¹ with hK
  have hK0 : 0 ≤ K := by positivity
  have hpt : ∀ b c' : Fin r → ℝ, ‖(S : ℂ)⁻¹ * ∫ x, cubeProdSel (fun β => f (x + ∑ i, β i)) b c'
      * ephase 0‖ ^ 2 ≤ K * I (b, c') := by
    intro b c'
    simp only [ephase, Complex.ofReal_zero, mul_zero, zero_mul,
      Complex.exp_zero, mul_one]
    have hum : Measurable fun y : ℝ => cubeProdSel (fun β => f (y + ∑ i, β i)) b c' := by
      have h := (measurable_pairedCube hf r).comp
        (measurable_id.prodMk (measurable_const (a := (b, c'))))
      exact h
    have := sq_norm_integral_le_avgH hH hS (p := c - ∑ i, b i) hum
      (fun x => norm_cubeProdSel_le (fun β => hf1 _) b c')
      (fun y hy => pairedCube_eq_zero hfs b c' y fun h => hy ⟨h.1, by linarith [h.2]⟩)
    simp only [hK, hI]
    calc _ ≤ (1 + H / S) * (S⁻¹ * ∫ x, ‖avgH H (fun y =>
          cubeProdSel (fun β => f (y + ∑ i, β i)) b c') x‖ ^ 2) := this
      _ = _ := by ring
  have hc : ∀ b : Fin r → ℝ, Integrable (fun c' => K * I (b, c')) πr := fun b =>
    integrable_of_bdd_finite
      ((hIm.comp ((measurable_const (a := b)).prodMk measurable_id)).const_mul K)
      (C := K * (S + H)) fun c' => by
        rw [abs_of_nonneg (mul_nonneg hK0 (hI0 _))]
        exact mul_le_mul_of_nonneg_left (hI1 _) hK0
  have hbm : Measurable fun b : Fin r → ℝ => ∫ c', K * I (b, c') ∂πr := by
    have h := ((hIm.const_mul K).stronglyMeasurable.integral_prod_right' (ν := πr)).measurable
    exact h
  have hbint : Integrable (fun b => ∫ c', K * I (b, c') ∂πr) πr :=
    integrable_of_bdd_finite hbm (C := K * (S + H)) fun b => by
      rw [abs_of_nonneg (integral_nonneg fun c' => mul_nonneg hK0 (hI0 _))]
      calc ∫ c', K * I (b, c') ∂πr ≤ ∫ _c' : Fin r → ℝ, K * (S + H) ∂πr :=
            integral_mono (hc b) (integrable_const _)
              fun c' => mul_le_mul_of_nonneg_left (hI1 _) hK0
        _ = K * (S + H) := by simp
  have hstep : (∫ b, ∫ c', ‖(S : ℂ)⁻¹ * ∫ x, cubeProdSel (fun β => f (x + ∑ i, β i)) b c'
        * ephase 0‖ ^ 2 ∂πr ∂πr) ≤ ∫ b, ∫ c', K * I (b, c') ∂πr ∂πr :=
    integral_mono_of_nonneg (Eventually.of_forall fun b => integral_nonneg fun c' => by positivity)
      hbint (Eventually.of_forall fun b => integral_mono_of_nonneg
        (Eventually.of_forall fun c' => by positivity) (hc b)
        (Eventually.of_forall fun c' => hpt b c'))
  have hQ := unifPow1_succ_eq hH hS hf hf1 hfs r
  rw [integral_const, probReal_univ, one_smul]
  calc _ ≤ ∫ b, ∫ c', K * I (b, c') ∂πr ∂πr := hstep
    _ = K * (S * unifPow1 H S (r + 1) f) := by
        simp_rw [integral_const_mul]
        exact congrArg (K * ·) hQ.symm
    _ = (1 + H / S) * unifPow1 H S (r + 1) f := by
        rw [hK]
        field_simp

end

/-! ### `patch:dummy-phase`: a measurable dummy phase with a small exceptional set -/

section
open Filter Topology MeasureTheory

/-- **The alternating sum of a product is the product of differences**:
`Σ_ω (-1)^{|ω|} ∏_i b^ω_i = ∏_i (b_i - c_i)`. -/
theorem sum_neg_one_pow_prod_cubeSel {r : ℕ} (b c : Fin r → ℝ) :
    ∑ ω : Fin r → Bool, (-1 : ℝ) ^ numTrue ω * ∏ i, cubeSel ω b c i = ∏ i, (b i - c i) := by
  have h1 : ∏ i, (b i - c i) = ∏ i, ∑ β : Bool, (if β then -c i else b i) := by
    refine Finset.prod_congr rfl fun i _ => ?_
    rw [Fintype.sum_bool]
    simp only [ite_true, Bool.false_eq_true, ite_false]
    ring
  rw [h1, Finset.prod_univ_sum, Fintype.piFinset_univ]
  refine Finset.sum_congr rfl fun ω _ => ?_
  have h2 : ∀ i, (if ω i then -c i else b i) = (if ω i then (-1 : ℝ) else 1) * cubeSel ω b c i := by
    intro i
    by_cases h : ω i <;> simp [h, cubeSel]
  simp_rw [h2]
  rw [Finset.prod_mul_distrib]
  congr 1
  rw [numTrue, ← Finset.prod_pow_eq_pow_sum]
  refine Finset.prod_congr rfl fun i _ => ?_
  by_cases h : ω i <;> simp [h]

/-- For independent uniform `b, c` in `[0,H]`, `P(|b - c| ≤ η) ≤ 2 η / H`. -/
theorem unif_prod_abs_sub_le {H η : ℝ} (hH : 0 < H) :
    ((unifMeas H).prod (unifMeas H)) {p : ℝ × ℝ | |p.1 - p.2| ≤ η}
      ≤ ENNReal.ofReal (2 * η / H) := by
  set φ : ℝ → ℝ≥0∞ := Set.indicator (Set.Icc (-η) η) 1 with hφ
  have hφm : Measurable φ := measurable_one.indicator measurableSet_Icc
  have hset : MeasurableSet {p : ℝ × ℝ | |p.1 - p.2| ≤ η} :=
    measurableSet_le (continuous_abs.comp (continuous_fst.sub continuous_snd)).measurable
      measurable_const
  rw [← lintegral_indicator_one hset]
  have hpt : ∀ p : ℝ × ℝ, Set.indicator {p : ℝ × ℝ | |p.1 - p.2| ≤ η} 1 p = φ (p.2 - p.1) := by
    intro p
    have : |p.1 - p.2| ≤ η ↔ p.2 - p.1 ∈ Set.Icc (-η) η := by
      rw [Set.mem_Icc, abs_sub_comm, abs_le]
    by_cases h : |p.1 - p.2| ≤ η
    · rw [Set.indicator_of_mem (by exact h), hφ, Set.indicator_of_mem (this.mp h)]
      rfl
    · rw [Set.indicator_of_notMem (by exact h), hφ,
        Set.indicator_of_notMem (fun h' => h (this.mpr h'))]
  simp_rw [hpt]
  refine (lintegral_unif_sub_le hH hφm).trans ?_
  rw [hφ, lintegral_indicator_one measurableSet_Icc, Real.volume_Icc,
    ← ENNReal.ofReal_inv_of_pos hH, ← ENNReal.ofReal_mul (by positivity)]
  refine ENNReal.ofReal_le_ofReal (le_of_eq ?_)
  field_simp
  ring

/-- The pair of `i`-th coordinates of the last two factors of the uniform triple cube is uniform. -/
theorem measurePreserving_coord_pair {H : ℝ} (hH : 0 < H) {r : ℕ} (i : Fin r) :
    MeasurePreserving (fun p : (Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ) => (p.2.1 i, p.2.2 i))
      ((Measure.pi fun _ => unifMeas H).prod
        ((Measure.pi fun _ => unifMeas H).prod (Measure.pi fun _ => unifMeas H)))
      ((unifMeas H).prod (unifMeas H)) := by
  have := isProbabilityMeasure_unifMeas hH
  have he := measurePreserving_eval (fun _ : Fin r => unifMeas H) i
  have h2 := he.prod he
  exact h2.comp (measurePreserving_snd (μ := Measure.pi fun _ : Fin r => unifMeas H)
    (ν := (Measure.pi fun _ => unifMeas H).prod (Measure.pi fun _ => unifMeas H)))

/-- **Lemma `patch:dummy-phase`, a measurable dummy phase with a small exceptional set.** For
`r ≥ 1`, `H, M > 0` and `0 < ε < 1` there is a finite-valued measurable `Φ(a,b)` whose alternating
sum `Ψ(a,b,c) = Σ_ω (-1)^{|ω|} Φ(a, b^ω)` satisfies `|Ψ| > M` off a set of relative measure at
most `ε` in `[0,H]^{3r}`. (Here `Φ(a,b) = L ∏_i b_i`, so that `Ψ = L ∏_i (b_i - c_i)`.) -/
theorem exists_dummy_phase {r : ℕ} (hr : 1 ≤ r) {H M ε : ℝ} (hH : 0 < H) (hM : 0 < M)
    (hε : 0 < ε) (_hε1 : ε < 1) :
    ∃ Φ : (Fin r → ℝ) × (Fin r → ℝ) → ℝ, Measurable Φ ∧
      ((Measure.pi fun _ => unifMeas H).prod
        ((Measure.pi fun _ => unifMeas H).prod (Measure.pi fun _ => unifMeas H)))
        {p | |altPhase Φ p| ≤ M} ≤ ENNReal.ofReal ε := by
  have hr0 : (0 : ℝ) < r := by exact_mod_cast hr
  set η : ℝ := ε * H / (2 * r) with hη
  have hη0 : 0 < η := by positivity
  set L : ℝ := (M + 1) / η ^ r with hL
  have hL0 : 0 < L := by positivity
  refine ⟨fun p => L * ∏ i, p.2 i, ?_, ?_⟩
  · exact measurable_const.mul (Finset.measurable_prod _ fun i _ =>
      (measurable_pi_apply i).comp measurable_snd)
  have halt : ∀ p : (Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ),
      altPhase (fun p => L * ∏ i, p.2 i) p = L * ∏ i, (p.2.1 i - p.2.2 i) := by
    intro p
    rw [altPhase, ← sum_neg_one_pow_prod_cubeSel, Finset.mul_sum]
    refine Finset.sum_congr rfl fun ω _ => ?_
    ring
  have hsub : {p : (Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ) |
      |altPhase (fun p => L * ∏ i, p.2 i) p| ≤ M}
      ⊆ ⋃ i, (fun p : (Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ) => (p.2.1 i, p.2.2 i)) ⁻¹'
        {q : ℝ × ℝ | |q.1 - q.2| ≤ η} := by
    intro p hp
    simp only [Set.mem_ofPred_eq, halt] at hp
    by_contra hno
    simp only [Set.mem_iUnion, Set.mem_preimage, Set.mem_ofPred_eq, not_exists, not_le] at hno
    have hprod : η ^ r ≤ ∏ i, |p.2.1 i - p.2.2 i| := by
      calc η ^ r = ∏ _i : Fin r, η := by simp
        _ ≤ ∏ i, |p.2.1 i - p.2.2 i| :=
          Finset.prod_le_prod₀ (fun _ _ => hη0.le) fun i _ => (hno i).le
    have : M + 1 ≤ |L * ∏ i, (p.2.1 i - p.2.2 i)| := by
      rw [abs_mul, abs_of_pos hL0, Finset.abs_prod]
      calc M + 1 = L * η ^ r := by rw [hL]; field_simp
        _ ≤ L * ∏ i, |p.2.1 i - p.2.2 i| := mul_le_mul_of_nonneg_left hprod hL0.le
    linarith
  refine (measure_mono hsub).trans ((measure_iUnion_fintype_le _ _).trans ?_)
  have hi : ∀ i : Fin r, ((Measure.pi fun _ => unifMeas H).prod
      ((Measure.pi fun _ => unifMeas H).prod (Measure.pi fun _ => unifMeas H)))
      ((fun p : (Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ) => (p.2.1 i, p.2.2 i)) ⁻¹'
        {q : ℝ × ℝ | |q.1 - q.2| ≤ η}) ≤ ENNReal.ofReal (2 * η / H) := by
    intro i
    refine le_trans (le_of_eq ((measurePreserving_coord_pair hH i).measure_preimage
      (measurableSet_le (continuous_abs.comp (continuous_fst.sub continuous_snd)).measurable
        measurable_const).nullMeasurableSet)) (unif_prod_abs_sub_le hH)
  calc ∑ i, _ ≤ ∑ _i : Fin r, ENNReal.ofReal (2 * η / H) := Finset.sum_le_sum fun i _ => hi i
    _ = ENNReal.ofReal ε := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
          ← ENNReal.ofReal_natCast, ← ENNReal.ofReal_mul (by positivity)]
        congr 1
        rw [hη]
        field_simp

end

/-! ### `patch:conditional-dl`: the property `MA(m, l)` -/

section
open Filter Topology MeasureTheory

/-- The phase of `patch:ma-correlation`:
`p_x = Σ_{i=m}^{l} ζ_i(x) P_i + Σ_{i=l+1}^{k} θ_i P_i`. -/
noncomputable def maPhase (m l k : ℕ) (ζ : ℕ → E3 → ℝ) (θ : ℕ → ℝ) (P : ℕ → Polynomial ℝ)
    (x : E3) : Polynomial ℝ :=
  ∑ i ∈ Finset.Icc m l, Polynomial.C (ζ i x) * P i
    + ∑ i ∈ Finset.Icc (l + 1) k, Polynomial.C (θ i) * P i

/-- The frequency size `Σ_{i=m}^{l} N^{d_i} |ζ_i(x)| + Σ_{i>l} N^{d_i} |θ_i|` of `patch:ma-set`. -/
noncomputable def maSize (m l k : ℕ) (j : ℕ → Fin 3) (N : ℝ) (ζ : ℕ → E3 → ℝ) (θ : ℕ → ℝ)
    (x : E3) : ℝ :=
  ∑ i ∈ Finset.Icc m l, N ^ expo (j i) * |ζ i x|
    + ∑ i ∈ Finset.Icc (l + 1) k, N ^ expo (j i) * |θ i|

/-- **The canonical set `Y` of `patch:ma-set`**: the points of the support envelope at which the
frequencies are small. -/
def maSet (m l k : ℕ) (j : ℕ → Fin 3) (C : ℕ) (δ N : ℝ) (ζ : ℕ → E3 → ℝ) (θ : ℕ → ℝ) :
    Set E3 :=
  {x | x ∈ petBox (budHi C δ) N ∧ maSize m l k j N ζ θ x ≤ budHi C δ}

/-- **The property `MA(m, l)` of `patch:conditional-dl`** for `k` inputs in the directions `j`
(of degrees `d_i = expo (j i)`): for every input budget `c ≥ 1` there is an output budget
`C ≥ c` such that a lower bound `ℓ_c(δ) N^6` for the correlation `patch:ma-correlation` of
`g_0, …, g_{m-1}` with the phase `Σ_{i=m}^{l} ζ_i(x) P_i(t) + Σ_{i>l} θ_i P_i(t)` implies that the
canonical set `patch:ma-set` has measure at least `ℓ_C(δ) N^6`. The functions live on `ℝ³`; the
coordinates outside `j 1, …, j (m-1)` are passive (see `automation/ErrorReport.md`). -/
def MajorArcProperty (k : ℕ) (j : ℕ → Fin 3) (m l : ℕ) : Prop :=
  ∀ c : ℕ, 1 ≤ c → ∃ C : ℕ, c ≤ C ∧ ∀ δ N : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ N →
    ∀ (P : ℕ → Polynomial ℝ) (g : ℕ → E3 → ℂ) (ζ : ℕ → E3 → ℝ) (θ : ℕ → ℝ),
      (∀ i ∈ Finset.Icc 1 k, AdmissiblePoly c δ N (expo (j i)) (P i)) →
      (∀ i, Measurable (g i)) → (∀ i y, ‖g i y‖ ≤ 1) →
      (∀ i y, y ∉ petBox (budHi c δ) N → g i y = 0) →
      (∀ i, Measurable (ζ i)) →
      budLo c δ * N ^ (6 : ℕ) ≤ ‖phaseCorr N (m - 1) g P (maPhase m l k ζ θ P) j‖ →
      budLo C δ * N ^ (6 : ℕ) ≤ (volume (maSet m l k j C δ N ζ θ)).toReal

theorem measurable_maSize {m l k : ℕ} (j : ℕ → Fin 3) (N : ℝ) {ζ : ℕ → E3 → ℝ}
    (hζ : ∀ i, Measurable (ζ i)) (θ : ℕ → ℝ) : Measurable (maSize m l k j N ζ θ) := by
  unfold maSize
  exact (Finset.measurable_sum _ fun i _ =>
    measurable_const.mul (continuous_abs.measurable.comp (hζ i))).add measurable_const

theorem maPhase_natDegree_le {m l k : ℕ} {ζ : ℕ → E3 → ℝ} {θ : ℕ → ℝ} {P : ℕ → Polynomial ℝ}
    (hP : ∀ i ∈ Finset.Icc m k, (P i).natDegree ≤ 3) (hml : m ≤ l) (hlk : l ≤ k) (x : E3) :
    (maPhase m l k ζ θ P x).natDegree ≤ 3 := by
  unfold maPhase
  refine (Polynomial.natDegree_add_le _ _).trans (max_le ?_ ?_)
  · refine Polynomial.natDegree_sum_le_of_forall_le _ _ fun i hi => ?_
    have hi' : i ∈ Finset.Icc m k := by
      rw [Finset.mem_Icc] at hi ⊢; exact ⟨hi.1, hi.2.trans hlk⟩
    exact (Polynomial.natDegree_C_mul_le _ _).trans (hP i hi')
  · refine Polynomial.natDegree_sum_le_of_forall_le _ _ fun i hi => ?_
    have hi' : i ∈ Finset.Icc m k := by
      rw [Finset.mem_Icc] at hi ⊢; exact ⟨by omega, hi.2⟩
    exact (Polynomial.natDegree_C_mul_le _ _).trans (hP i hi')

theorem measurable_maPhase_coeff {m l k : ℕ} {ζ : ℕ → E3 → ℝ} (hζ : ∀ i, Measurable (ζ i))
    (θ : ℕ → ℝ) (P : ℕ → Polynomial ℝ) (n : ℕ) :
    Measurable fun x => (maPhase m l k ζ θ P x).coeff n := by
  unfold maPhase
  simp only [Polynomial.coeff_add, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul]
  exact (Finset.measurable_sum _ fun i _ => (hζ i).mul measurable_const).add measurable_const

end

/-! ### `patch:conditional-degree`, Step 1: order splitting and the range of the powers -/

section
open Filter Topology MeasureTheory

/-- The paired cube `D^r_{c,b} f` of a one-bounded function supported in `[c₀, c₀ + S]` is
one-bounded and supported in `[c₀ - Σ b, c₀ - Σ b + S]`. -/
theorem pairedCube_support {f : ℝ → ℂ} {c S : ℝ} (hfs : ∀ x, x ∉ Set.Icc c (c + S) → f x = 0)
    {r : ℕ} (b c' : Fin r → ℝ) (y : ℝ)
    (hy : y ∉ Set.Icc (c - ∑ i, b i) (c - ∑ i, b i + S)) :
    cubeProdSel (fun β => f (y + ∑ i, β i)) b c' = 0 :=
  pairedCube_eq_zero hfs b c' y fun h => hy ⟨h.1, by linarith [h.2]⟩

theorem measurable_pairedCube_at {f : ℝ → ℂ} (hf : Measurable f) {r : ℕ} (b c' : Fin r → ℝ) :
    Measurable fun y => cubeProdSel (fun β => f (y + ∑ i, β i)) b c' := by
  have h := (measurable_pairedCube hf r).comp
    (measurable_id.prodMk (measurable_const (a := (b, c'))))
  exact h

/-- **Order splitting** (`patch:conditional-degree`, Step 1): the order-`(r+2)` power is the
average over the first `r` pairs of the order-two powers of the differenced functions,
`Q_{r+2}(f) = E_{b,c} Q_2(D^r_{c,b} f)`. -/
theorem unifPow1_add_two {H S c : ℝ} (hH : 0 < H) (hS : 0 < S) {f : ℝ → ℂ} (hf : Measurable f)
    (hf1 : ∀ x, ‖f x‖ ≤ 1) (hfs : ∀ x, x ∉ Set.Icc c (c + S) → f x = 0) (r : ℕ) :
    unifPow1 H S (r + 2) f
      = ∫ b : Fin r → ℝ, ∫ c' : Fin r → ℝ,
          unifPow1 H S 2 (fun y => cubeProdSel (fun β => f (y + ∑ i, β i)) b c')
          ∂(Measure.pi fun _ => unifMeas H) ∂(Measure.pi fun _ => unifMeas H) := by
  have := isProbabilityMeasure_unifMeas hH
  set I : (Fin (r + 1) → ℝ) × (Fin (r + 1) → ℝ) → ℝ := fun q =>
    ∫ x, ‖avgH H (fun y => cubeProdSel (fun β => f (y + ∑ i, β i)) q.1 q.2) x‖ ^ 2 with hI
  have hIm : Measurable I := measurable_integral_sq_avgH_pairedCube hf (r + 1)
  have hI0 : ∀ q, 0 ≤ I q := fun q => integral_nonneg fun x => by positivity
  have hI1 : ∀ q, I q ≤ S + H := fun q => integral_sq_avgH_pairedCube_le hH hS hf1 hfs q.1 q.2
  have hIb : ∀ q, ‖((I q : ℝ) : ℂ)‖ ≤ S + H := fun q => by
    rw [Complex.norm_real, Real.norm_of_nonneg (hI0 q)]; exact hI1 q
  set u : (Fin r → ℝ) → (Fin r → ℝ) → ℝ → ℂ := fun b c' y =>
    cubeProdSel (fun β => f (y + ∑ i, β i)) b c' with hu
  -- the doubled cube is the order-one cube of the differenced function
  have hkey : ∀ (b c' : Fin r → ℝ) (β γ : ℝ),
      I (Fin.snoc b β, Fin.snoc c' γ)
        = ∫ x, ‖avgH H (fun y => cubeProdSel (fun β' : Fin 1 → ℝ => u b c' (y + ∑ i, β' i))
            (fun _ => β) (fun _ => γ)) x‖ ^ 2 := by
    intro b c' β γ
    simp only [hI]
    congr 1
    funext x
    congr 3
    funext y
    rw [cubeProdSel_snoc_shift f y β γ b c', cubeProdSel_one]
    simp [hu]
  -- the order-two power of the differenced function
  have hQ2 : ∀ b c' : Fin r → ℝ, S * unifPow1 H S 2 (u b c')
      = ∫ β, ∫ γ, I (Fin.snoc b β, Fin.snoc c' γ) ∂unifMeas H ∂unifMeas H := by
    intro b c'
    have h := unifPow1_succ_eq hH hS (c := c - ∑ i, b i)
      (measurable_pairedCube_at hf b c') (fun y => norm_cubeProdSel_le (fun β => hf1 _) _ _)
      (fun y hy => pairedCube_support hfs b c' y hy) 1
    rw [h]
    have hu1 := measurePreserving_funUnique (unifMeas H) (Fin 1)
    rw [← hu1.integral_comp']
    refine integral_congr_ae (Eventually.of_forall fun β => ?_)
    beta_reduce
    rw [← hu1.integral_comp']
    refine integral_congr_ae (Eventually.of_forall fun γ => ?_)
    beta_reduce
    rw [hkey]
    congr 3
  -- the complex bookkeeping
  have hsucc := unifPow1_succ_eq hH hS hf hf1 hfs (r + 1)
  have hL : ((S * unifPow1 H S (r + 2) f : ℝ) : ℂ)
      = ∫ b', ∫ c', ((I (b', c') : ℝ) : ℂ) ∂(Measure.pi fun _ => unifMeas H)
          ∂(Measure.pi fun _ => unifMeas H) := by
    rw [hsucc, ← integral_complex_ofReal]
    refine integral_congr_ae (Eventually.of_forall fun b' => ?_)
    beta_reduce
    rw [← integral_complex_ofReal]
  have hIc : Measurable fun q : (Fin (r + 1) → ℝ) × (Fin (r + 1) → ℝ) => ((I q : ℝ) : ℂ) :=
    Complex.measurable_ofReal.comp hIm
  -- split `c'`
  have h2 : ∀ b' : Fin (r + 1) → ℝ, (∫ c', ((I (b', c') : ℝ) : ℂ) ∂(Measure.pi fun _ => unifMeas H))
      = ∫ c', (∫ γ, ((I (b', Fin.snoc c' γ) : ℝ) : ℂ) ∂unifMeas H)
          ∂(Measure.pi fun _ => unifMeas H) := by
    intro b'
    have hm : Measurable fun c' : Fin (r + 1) → ℝ => ((I (b', c') : ℝ) : ℂ) := by
      have h := hIc.comp ((measurable_const (a := b')).prodMk measurable_id)
      exact h
    exact integral_pi_snoc (unifMeas H) hm (C := S + H) fun c' => hIb _
  simp_rw [h2] at hL
  -- split `b'`
  have hm3 : Measurable fun b' : Fin (r + 1) → ℝ => ∫ c', (∫ γ, ((I (b', Fin.snoc c' γ) : ℝ) : ℂ)
      ∂unifMeas H) ∂(Measure.pi fun _ => unifMeas H) := by
    have hm0 : Measurable fun p : ((Fin (r + 1) → ℝ) × (Fin r → ℝ)) × ℝ =>
        ((I (p.1.1, Fin.snoc p.1.2 p.2) : ℝ) : ℂ) :=
      hIc.comp (measurable_fst.fst.prodMk (measurable_snoc.comp
        (measurable_fst.snd.prodMk measurable_snd)))
    have h1 := hm0.stronglyMeasurable.integral_prod_right' (ν := unifMeas H)
    have h2 := h1.integral_prod_right' (ν := Measure.pi fun _ : Fin r => unifMeas H)
    exact h2.measurable
  have hb3 : ∀ b' : Fin (r + 1) → ℝ, ‖∫ c', (∫ γ, ((I (b', Fin.snoc c' γ) : ℝ) : ℂ)
      ∂unifMeas H) ∂(Measure.pi fun _ => unifMeas H)‖ ≤ S + H := by
    intro b'
    refine (norm_integral_le_of_norm_le_const (C := S + H)
      (Eventually.of_forall fun c' => ?_)).trans
      (by simp)
    exact (norm_integral_le_of_norm_le_const (C := S + H)
      (Eventually.of_forall fun γ => hIb _)).trans (by simp)
  rw [integral_pi_snoc (unifMeas H) hm3 hb3] at hL
  -- swap `β` and `c'`
  have hswap : ∀ b : Fin r → ℝ, (∫ β, ∫ c', (∫ γ, ((I (Fin.snoc b β, Fin.snoc c' γ) : ℝ) : ℂ)
        ∂unifMeas H) ∂(Measure.pi fun _ => unifMeas H) ∂unifMeas H)
      = ∫ c', ∫ β, (∫ γ, ((I (Fin.snoc b β, Fin.snoc c' γ) : ℝ) : ℂ) ∂unifMeas H)
        ∂unifMeas H ∂(Measure.pi fun _ => unifMeas H) := by
    intro b
    have hm : Measurable (Function.uncurry fun (β : ℝ) (c' : Fin r → ℝ) =>
        ∫ γ, ((I (Fin.snoc b β, Fin.snoc c' γ) : ℝ) : ℂ) ∂unifMeas H) := by
      have hm0 : Measurable fun p : (ℝ × (Fin r → ℝ)) × ℝ =>
          ((I (Fin.snoc b p.1.1, Fin.snoc p.1.2 p.2) : ℝ) : ℂ) :=
        hIc.comp ((measurable_snoc.comp ((measurable_const (a := b)).prodMk
          measurable_fst.fst)).prodMk (measurable_snoc.comp
            (measurable_fst.snd.prodMk measurable_snd)))
      have h := (hm0.stronglyMeasurable.integral_prod_right' (ν := unifMeas H)).measurable
      exact h
    exact integral_swap_of_bdd hm (C := S + H) fun β c' =>
      (norm_integral_le_of_norm_le_const (C := S + H)
        (Eventually.of_forall fun γ => hIb _)).trans (by simp)
  simp_rw [hswap] at hL
  have hR : ((S * ∫ b, ∫ c', unifPow1 H S 2 (u b c') ∂(Measure.pi fun _ => unifMeas H)
      ∂(Measure.pi fun _ => unifMeas H) : ℝ) : ℂ)
      = ∫ b, ∫ c', ∫ β, (∫ γ, ((I (Fin.snoc b β, Fin.snoc c' γ) : ℝ) : ℂ) ∂unifMeas H)
        ∂unifMeas H ∂(Measure.pi fun _ => unifMeas H) ∂(Measure.pi fun _ => unifMeas H) := by
    rw [← integral_const_mul, ← integral_complex_ofReal]
    refine integral_congr_ae (Eventually.of_forall fun b => ?_)
    beta_reduce
    rw [← integral_const_mul, ← integral_complex_ofReal]
    refine integral_congr_ae (Eventually.of_forall fun c' => ?_)
    beta_reduce
    rw [hQ2 b c', ← integral_complex_ofReal]
    refine integral_congr_ae (Eventually.of_forall fun β => ?_)
    beta_reduce
    rw [← integral_complex_ofReal]
  have hfin := hL.trans hR.symm
  have hfin' : S * unifPow1 H S (r + 2) f = S * ∫ b, ∫ c', unifPow1 H S 2 (u b c')
      ∂(Measure.pi fun _ => unifMeas H) ∂(Measure.pi fun _ => unifMeas H) := by
    exact_mod_cast hfin
  exact mul_left_cancel₀ hS.ne' hfin'

/-- `∫ ‖T_H u‖² ≤ ∫ ‖u‖` for a one-bounded function with compact support. -/
theorem integral_sq_avgH_le_integral_norm {H p q : ℝ} (hH : 0 < H) {u : ℝ → ℂ}
    (hu : Measurable u) (hu1 : ∀ x, ‖u x‖ ≤ 1) (hus : ∀ x, x ∉ Set.Icc p q → u x = 0) :
    ∫ x, ‖avgH H u x‖ ^ 2 ≤ ∫ x, ‖u x‖ := by
  have := isProbabilityMeasure_unifMeas hH
  set G : ℝ → ℂ := fun x => ((‖u x‖ : ℝ) : ℂ) with hG
  have hGm : Measurable G := Complex.measurable_ofReal.comp hu.norm
  have hG1 : ∀ x, ‖G x‖ ≤ 1 := fun x => by simp [hG, hu1 x]
  have hGs : ∀ x, x ∉ Set.Icc p q → G x = 0 := fun x hx => by simp [hG, hus x hx]
  have hGi := integrable_of_bdd_Icc hGm.aestronglyMeasurable hG1 hGs
  have hav : ∀ x, avgH H G x = ((∫ a, ‖u (x + a)‖ ∂unifMeas H : ℝ) : ℂ) := fun x => by
    rw [avgH, ← integral_complex_ofReal]
  have hAm : Measurable fun x => ∫ a, ‖u (x + a)‖ ∂unifMeas H := by
    have h := ((hu.comp (measurable_fst.add measurable_snd)).norm.stronglyMeasurable
      |>.integral_prod_right' (ν := unifMeas H)).measurable
    exact h
  have hA0 : ∀ x, 0 ≤ ∫ a, ‖u (x + a)‖ ∂unifMeas H := fun x =>
    integral_nonneg fun a => norm_nonneg _
  have hA1 : ∀ x, ∫ a, ‖u (x + a)‖ ∂unifMeas H ≤ 1 := fun x => by
    have := norm_avgH_le hH hG1 x
    rwa [hav, Complex.norm_real, Real.norm_of_nonneg (hA0 x)] at this
  have hAs : ∀ x, x ∉ Set.Icc (p - H) q → ∫ a, ‖u (x + a)‖ ∂unifMeas H = 0 := fun x hx => by
    have := avgH_eq_zero hH hGs x hx
    rw [hav] at this
    exact_mod_cast this
  have hAi : Integrable fun x => ∫ a, ‖u (x + a)‖ ∂unifMeas H :=
    integrable_of_bdd_Icc hAm.aestronglyMeasurable (C := 1)
      (fun x => by rw [Real.norm_of_nonneg (hA0 x)]; exact hA1 x) hAs
  have hint : ∫ x, ∫ a, ‖u (x + a)‖ ∂unifMeas H = ∫ x, ‖u x‖ := by
    have h := integral_avgH hH hGm hGi
    simp_rw [hav] at h
    rw [integral_complex_ofReal, integral_complex_ofReal] at h
    exact_mod_cast h
  rw [← hint]
  refine integral_mono_of_nonneg (Eventually.of_forall fun x => by positivity) hAi
    (Eventually.of_forall fun x => ?_)
  have h1 : ‖avgH H u x‖ ≤ ∫ a, ‖u (x + a)‖ ∂unifMeas H := norm_integral_le_integral_norm _
  have h2 : ‖avgH H u x‖ ≤ 1 := norm_avgH_le hH hu1 x
  calc ‖avgH H u x‖ ^ 2 ≤ ‖avgH H u x‖ := by nlinarith [norm_nonneg (avgH H u x)]
    _ ≤ _ := h1

/-- **The powers are between zero and one** (`patch:fejer-squares`, one-dimensional form): for a
one-bounded function supported in an interval of length `S` and order `r + 1 ≥ 1`,
`0 ≤ Q_{r+1,H,S}(f) ≤ 1`. -/
theorem unifPow1_mem_Icc {H S c : ℝ} (hH : 0 < H) (hS : 0 < S) {f : ℝ → ℂ} (hf : Measurable f)
    (hf1 : ∀ x, ‖f x‖ ≤ 1) (hfs : ∀ x, x ∉ Set.Icc c (c + S) → f x = 0) (r : ℕ) :
    unifPow1 H S (r + 1) f ∈ Set.Icc 0 1 := by
  have := isProbabilityMeasure_unifMeas hH
  have h := unifPow1_succ_eq hH hS hf hf1 hfs r
  set I : (Fin r → ℝ) → (Fin r → ℝ) → ℝ := fun b c' =>
    ∫ x, ‖avgH H (fun y => cubeProdSel (fun β => f (y + ∑ i, β i)) b c') x‖ ^ 2 with hI
  have hI0 : ∀ b c', 0 ≤ I b c' := fun b c' => integral_nonneg fun x => by positivity
  have hIS : ∀ b c', I b c' ≤ S := by
    intro b c'
    refine (integral_sq_avgH_le_integral_norm hH (measurable_pairedCube_at hf b c')
      (fun y => norm_cubeProdSel_le (fun β => hf1 _) _ _)
      (fun y hy => pairedCube_support hfs b c' y hy)).trans ?_
    calc ∫ x, ‖cubeProdSel (fun β => f (x + ∑ i, β i)) b c'‖
        ≤ ∫ x, Set.indicator (Set.Icc (c - ∑ i, b i) (c - ∑ i, b i + S)) (fun _ => (1 : ℝ)) x := by
          refine integral_mono_of_nonneg (Eventually.of_forall fun x => norm_nonneg _)
            ((continuous_const.integrableOn_Icc).integrable_indicator measurableSet_Icc)
            (Eventually.of_forall fun x => ?_)
          by_cases hx : x ∈ Set.Icc (c - ∑ i, b i) (c - ∑ i, b i + S)
          · rw [Set.indicator_of_mem hx]; exact norm_cubeProdSel_le (fun β => hf1 _) _ _
          · rw [Set.indicator_of_notMem hx]
            beta_reduce
            rw [pairedCube_support hfs b c' x hx, norm_zero]
      _ = S := by
          rw [integral_indicator measurableSet_Icc, setIntegral_const, Real.volume_real_Icc,
            smul_eq_mul, mul_one, max_eq_left (by linarith)]
          ring
  have hmeas : Measurable fun q : (Fin r → ℝ) × (Fin r → ℝ) => I q.1 q.2 :=
    measurable_integral_sq_avgH_pairedCube hf r
  have hinner : ∀ b, Integrable (fun c' => I b c') (Measure.pi fun _ => unifMeas H) := by
    intro b
    have hm : Measurable fun c' => I b c' := by
      have h := hmeas.comp ((measurable_const (a := b)).prodMk measurable_id)
      exact h
    exact integrable_of_bdd_finite hm (C := S) fun c' => by
      rw [abs_of_nonneg (hI0 _ _)]; exact hIS _ _
  have hlo : 0 ≤ ∫ b, ∫ c', I b c' ∂(Measure.pi fun _ => unifMeas H)
      ∂(Measure.pi fun _ => unifMeas H) :=
    integral_nonneg fun b => integral_nonneg fun c' => hI0 b c'
  have hhi : ∫ b, ∫ c', I b c' ∂(Measure.pi fun _ => unifMeas H)
      ∂(Measure.pi fun _ => unifMeas H) ≤ S := by
    have h1 : ∀ b, ∫ c', I b c' ∂(Measure.pi fun _ => unifMeas H) ≤ S := fun b => by
      calc ∫ c', I b c' ∂(Measure.pi fun _ => unifMeas H)
          ≤ ∫ _c' : Fin r → ℝ, S ∂(Measure.pi fun _ => unifMeas H) :=
            integral_mono (hinner b) (integrable_const _) fun c' => hIS b c'
        _ = S := by simp
    have hbm : Measurable fun b => ∫ c', I b c' ∂(Measure.pi fun _ => unifMeas H) := by
      have h := (hmeas.stronglyMeasurable.integral_prod_right'
        (ν := Measure.pi fun _ : Fin r => unifMeas H)).measurable
      exact h
    calc _ ≤ ∫ _b : Fin r → ℝ, S ∂(Measure.pi fun _ => unifMeas H) :=
          integral_mono (integrable_of_bdd_finite hbm (C := S) fun b => by
            rw [abs_of_nonneg (integral_nonneg fun c' => hI0 b c')]; exact h1 b)
            (integrable_const _) h1
      _ = S := by simp
  constructor
  · have : 0 ≤ S * unifPow1 H S (r + 1) f := h ▸ hlo
    exact (mul_nonneg_iff_of_pos_left hS).mp this
  · have : S * unifPow1 H S (r + 1) f ≤ S * 1 := by rw [h, mul_one]; exact hhi
    exact le_of_mul_le_mul_left this hS

end

section
open Filter Topology MeasureTheory

/-- The power `Q_{r,H,S}` of a jointly measurable family is measurable in the parameter. -/
theorem measurable_unifPow1_param {Θ : Type*} [MeasurableSpace Θ] {G : Θ → ℝ → ℂ}
    (hG : Measurable (Function.uncurry G)) (H S : ℝ) (r : ℕ) :
    Measurable fun θ => unifPow1 H S r (G θ) := by
  have hv : Measurable (Function.uncurry fun (p : Θ × ℝ) (β : Fin r → ℝ) =>
      G p.1 (p.2 + ∑ i, β i)) :=
    hG.comp (measurable_fst.fst.prodMk (measurable_fst.snd.add
      (Finset.measurable_sum _ fun i _ => (measurable_pi_apply i).comp measurable_snd)))
  have hc := measurable_cubeProdSel_param hv
  have h1 := hc.stronglyMeasurable.integral_prod_right'
    (ν := (Measure.pi fun _ : Fin r => unifMeas H).prod (Measure.pi fun _ : Fin r => unifMeas H))
  have h2 := h1.integral_prod_right' (ν := (volume : Measure ℝ))
  have h3 := (Complex.measurable_re.comp h2.measurable).const_mul S⁻¹
  exact h3

/-- A normalized Fourier coefficient of a jointly measurable family at a measurable frequency is
measurable in the parameter. -/
theorem measurable_coef_param {Θ : Type*} [MeasurableSpace Θ] {G : Θ → ℝ → ℂ}
    (hG : Measurable (Function.uncurry G)) {ψ : Θ → ℝ} (hψ : Measurable ψ) :
    Measurable fun θ => ∫ z, G θ z * ephase (ψ θ * z) := by
  have h : Measurable fun p : Θ × ℝ => G p.1 p.2 * ephase (ψ p.1 * p.2) :=
    hG.mul (continuous_ephase.measurable.comp ((hψ.comp measurable_fst).mul measurable_snd))
  exact (h.stronglyMeasurable.integral_prod_right' (ν := (volume : Measure ℝ))).measurable

/-- **Measurable frequencies with supports depending on the parameter** (the selection of
`patch:u2-fourier-selection` for a family whose supports are translates of one interval of length
`S`). -/
theorem exists_measurable_freq_unifPow1' {Θ : Type*} [MeasurableSpace Θ] {F : Θ → ℝ → ℂ}
    (hF : Measurable (Function.uncurry F)) (hF1 : ∀ θ x, ‖F θ x‖ ≤ 1) {S H η : ℝ}
    (hH : 0 < H) (hS : 0 < S) (c : Θ → ℝ)
    (hFs : ∀ θ x, x ∉ Set.Icc (c θ) (c θ + S) → F θ x = 0) (hη : 0 < η) :
    ∃ ξ : Θ → ℝ, Measurable ξ ∧ ∀ θ, η ≤ unifPow1 H S 2 (F θ)
      → H * Real.sqrt η / 2 < ‖𝓕 (F θ) (ξ θ)‖ := by
  have hFm : ∀ θ, Measurable (F θ) := fun θ => by
    have h := hF.comp (measurable_prodMk_left (x := θ))
    exact h
  have hgc : ∀ θ, Continuous (𝓕 (F θ)) := fun θ =>
    continuous_fourier_of_integrable
      (integrable_of_bdd_Icc (hFm θ).aestronglyMeasurable (hF1 θ) (hFs θ))
  obtain ⟨ξ, hξm, hξ⟩ := exists_measurable_freq hgc (measurable_fourier_param hF)
    (H * Real.sqrt η / 2)
  refine ⟨ξ, hξm, fun θ hθ => hξ θ ?_⟩
  by_contra hno
  push Not at hno
  have hQ := unifPow1_two_le hH hS (hFm θ) (hF1 θ) (hFs θ) hno
  have hs : Real.sqrt η ^ 2 = η := Real.sq_sqrt hη.le
  have : (H ^ 2)⁻¹ * (H * Real.sqrt η / 2) ^ 2 = η / 4 := by
    field_simp
    rw [hs]
    ring
  linarith

/-- The Fourier transform written as a coefficient against `e(φ z)` with `φ = -ξ`. -/
theorem fourier_eq_integral_ephase (u : ℝ → ℂ) (ξ : ℝ) :
    𝓕 u ξ = ∫ z, u z * ephase (-ξ * z) := by
  rw [Real.fourier_real_eq]
  refine integral_congr_ae (Eventually.of_forall fun z => ?_)
  beta_reduce
  rw [Circle.smul_def, smul_eq_mul, ephase_eq_fourierChar, mul_comm]
  congr 2
  ring

/-- The paired cubes of the sections of a jointly measurable family, as a jointly measurable
function of the section, the pair and the point. -/
theorem measurable_sectionCube {Y : Type*} [MeasurableSpace Y] {F : Y → ℝ → ℂ}
    (hF : Measurable (Function.uncurry F)) (r : ℕ) :
    Measurable (Function.uncurry fun (θ : Y × ((Fin r → ℝ) × (Fin r → ℝ))) (z : ℝ) =>
      cubeProdSel (fun β => F θ.1 (z + ∑ i, β i)) θ.2.1 θ.2.2) := by
  have hv : Measurable (Function.uncurry fun (p : Y × ℝ) (β : Fin r → ℝ) =>
      F p.1 (p.2 + ∑ i, β i)) :=
    hF.comp (measurable_fst.fst.prodMk (measurable_fst.snd.add
      (Finset.measurable_sum _ fun i _ => (measurable_pi_apply i).comp measurable_snd)))
  have hc := measurable_cubeProdSel_param hv
  have hmap : Measurable fun q : (Y × ((Fin r → ℝ) × (Fin r → ℝ))) × ℝ =>
      (((q.1.1, q.2) : Y × ℝ), q.1.2) :=
    (measurable_fst.fst.prodMk measurable_snd).prodMk measurable_fst.snd
  have h := hc.comp hmap
  exact h

/-- **`patch:conditional-degree`, Step 1: Fourier coefficients on popular sections.** If the
order-`(r+2)` powers of the sections of `F` average at least `a`, there are a measurable frequency
`φ(y, b, c)` and a measurable set `E` of `(y, b, c)` on which the normalized coefficient of
`D^r_{c,b} F_y` at `φ` exceeds `(H/2S) √(a/2)`, and the set of `y` whose `E` section has measure
at least `a/4` has measure at least `a/4`. -/
theorem cdl_step1 {Y : Type*} [MeasurableSpace Y] {μ : Measure Y} [IsProbabilityMeasure μ]
    {F : Y → ℝ → ℂ} (hF : Measurable (Function.uncurry F)) (hF1 : ∀ y z, ‖F y z‖ ≤ 1)
    {c S H : ℝ} (hS : 0 < S) (hH : 0 < H) (hFs : ∀ y z, z ∉ Set.Icc c (c + S) → F y z = 0)
    (r : ℕ) {a : ℝ} (ha : 0 < a) (hQ : a ≤ ∫ y, unifPow1 H S (r + 2) (F y) ∂μ) :
    ∃ φ : Y × ((Fin r → ℝ) × (Fin r → ℝ)) → ℝ, Measurable φ ∧
      ∃ E : Set (Y × ((Fin r → ℝ) × (Fin r → ℝ))), MeasurableSet E ∧
        (∀ p ∈ E, H / (2 * S) * Real.sqrt (a / 2)
          < ‖(S : ℂ)⁻¹ * ∫ z, cubeProdSel (fun β => F p.1 (z + ∑ i, β i)) p.2.1 p.2.2
              * ephase (φ p * z)‖) ∧
        a / 4 ≤ (μ {y | a / 4 ≤ (((Measure.pi fun _ : Fin r => unifMeas H).prod
          (Measure.pi fun _ : Fin r => unifMeas H)) {q | (y, q) ∈ E}).toReal}).toReal := by
  have := isProbabilityMeasure_unifMeas hH
  set πr := Measure.pi fun _ : Fin r => unifMeas H with hπr
  set u : Y × ((Fin r → ℝ) × (Fin r → ℝ)) → ℝ → ℂ := fun θ z =>
    cubeProdSel (fun β => F θ.1 (z + ∑ i, β i)) θ.2.1 θ.2.2 with hu
  have hum : Measurable (Function.uncurry u) := measurable_sectionCube hF r
  have hu1 : ∀ θ z, ‖u θ z‖ ≤ 1 := fun θ z => norm_cubeProdSel_le (fun β => hF1 _ _) _ _
  have hus : ∀ θ z, z ∉ Set.Icc (c - ∑ i, θ.2.1 i) (c - ∑ i, θ.2.1 i + S) → u θ z = 0 :=
    fun θ z hz => pairedCube_support (hFs θ.1) θ.2.1 θ.2.2 z hz
  have hFy : ∀ y, Measurable (F y) := fun y => by
    have h := hF.comp (measurable_prodMk_left (x := y))
    exact h
  set J : Y × ((Fin r → ℝ) × (Fin r → ℝ)) → ℝ := fun θ => unifPow1 H S 2 (u θ) with hJ
  have hJm : Measurable J := measurable_unifPow1_param hum H S 2
  have hJ01 : ∀ θ, J θ ∈ Set.Icc 0 1 := fun θ => by
    have hθm : Measurable (u θ) := by
      have h := hum.comp (measurable_prodMk_left (x := θ))
      exact h
    exact unifPow1_mem_Icc hH hS hθm (hu1 θ) (hus θ) 1
  -- the joint average of the order-two powers
  have hjoint : a ≤ ∫ θ, J θ ∂(μ.prod (πr.prod πr)) := by
    have hJi : Integrable J (μ.prod (πr.prod πr)) :=
      integrable_of_bdd_finite hJm (C := 1) fun θ => by
        rw [abs_of_nonneg (hJ01 θ).1]; exact (hJ01 θ).2
    rw [integral_prod _ hJi]
    refine hQ.trans (le_of_eq (integral_congr_ae (Eventually.of_forall fun y => ?_)))
    beta_reduce
    rw [unifPow1_add_two hH hS (hFy y) (hF1 y) (hFs y) r]
    have hi : Integrable (fun q : (Fin r → ℝ) × (Fin r → ℝ) => J (y, q)) (πr.prod πr) := by
      have hm : Measurable fun q : (Fin r → ℝ) × (Fin r → ℝ) => J (y, q) := by
        have h := hJm.comp (measurable_prodMk_left (x := y))
        exact h
      exact integrable_of_bdd_finite hm (C := 1) fun q => by
        rw [abs_of_nonneg (hJ01 _).1]; exact (hJ01 _).2
    rw [integral_prod _ hi]
  -- popularity in the joint variable, then in the sections
  set E : Set (Y × ((Fin r → ℝ) × (Fin r → ℝ))) := {θ | a / (2 * 1) ≤ J θ} with hE
  have hEm : MeasurableSet E := measurableSet_le measurable_const hJm
  have hEμ := measure_popular_ge (μ := μ.prod (πr.prod πr)) hJm (fun θ => (hJ01 θ).1)
    (fun θ => (hJ01 θ).2) one_pos (by simp) ha hjoint
  set f : Y → ℝ := fun y => ((πr.prod πr) {q | (y, q) ∈ E}).toReal with hf
  have hfm : Measurable f := (measurable_measure_prodMk_left hEm).ennreal_toReal
  have hf01 : ∀ y, f y ∈ Set.Icc 0 1 := fun y => ⟨ENNReal.toReal_nonneg, by
    simp only [hf]
    exact ENNReal.toReal_le_of_le_ofReal zero_le_one (by
      rw [ENNReal.ofReal_one]; exact prob_le_one)⟩
  have hfint : a / (2 * 1) ≤ ∫ y, f y ∂μ := by
    rw [integral_toReal (hfm.ennreal_ofReal.aemeasurable.congr (Eventually.of_forall fun y => by
        simp [hf])) (Eventually.of_forall fun y => measure_lt_top _ _)]
    · have hp := Measure.prod_apply (μ := μ) (ν := πr.prod πr) hEm
      rw [show (∫⁻ y, (πr.prod πr) {q | (y, q) ∈ E} ∂μ) = (μ.prod (πr.prod πr)) E from hp.symm]
      exact hEμ
  have hYμ := measure_popular_ge (μ := μ) hfm (fun y => (hf01 y).1) (fun y => (hf01 y).2)
    one_pos (by simp) (by positivity) hfint
  -- the measurable frequencies
  obtain ⟨ξ, hξm, hξ⟩ := exists_measurable_freq_unifPow1' hum hu1 hH hS
    (fun θ => c - ∑ i, θ.2.1 i) hus (η := a / 2) (by positivity)
  refine ⟨fun θ => -ξ θ, hξm.neg, E, hEm, fun θ hθ => ?_, ?_⟩
  · have h1 := hξ θ (by simpa [hE] using hθ)
    rw [fourier_eq_integral_ephase] at h1
    rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hS.le]
    calc H / (2 * S) * Real.sqrt (a / 2) = S⁻¹ * (H * Real.sqrt (a / 2) / 2) := by
          field_simp
      _ < S⁻¹ * ‖∫ z, u θ z * ephase (-ξ θ * z)‖ :=
          mul_lt_mul_of_pos_left h1 (inv_pos.mpr hS)
  · have e : a / (2 * 1) / (2 * 1) = a / 4 := by ring
    rw [e] at hYμ
    simpa [hf] using hYμ

end

section
open Filter Topology MeasureTheory

/-- The normalized coefficient `S⁻¹ ∫ g(z) e(ψ z) dz`. -/
noncomputable def cdlCoef (S : ℝ) (g : ℝ → ℂ) (ψ : ℝ) : ℂ := (S : ℂ)⁻¹ * ∫ z, g z * ephase (ψ * z)

/-- A one-bounded function supported in an interval of length `S` has coefficients of modulus at
most one. -/
theorem norm_cdlCoef_le {S p : ℝ} (hS : 0 < S) {g : ℝ → ℂ} (hg1 : ∀ z, ‖g z‖ ≤ 1)
    (hgs : ∀ z, z ∉ Set.Icc p (p + S) → g z = 0) (ψ : ℝ) : ‖cdlCoef S g ψ‖ ≤ 1 := by
  rw [cdlCoef, norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hS.le]
  have hi : Integrable (Set.indicator (Set.Icc p (p + S)) fun _ => (1 : ℝ)) :=
    (continuous_const.integrableOn_Icc).integrable_indicator measurableSet_Icc
  have h : ‖∫ z, g z * ephase (ψ * z)‖ ≤ S := by
    refine (norm_integral_le_of_norm_le hi (Eventually.of_forall fun z => ?_)).trans ?_
    · rw [norm_mul, norm_ephase, mul_one]
      by_cases hz : z ∈ Set.Icc p (p + S)
      · rw [Set.indicator_of_mem hz]; exact hg1 z
      · rw [Set.indicator_of_notMem hz, hgs z hz, norm_zero]
    · rw [integral_indicator measurableSet_Icc, setIntegral_const, Real.volume_real_Icc,
        smul_eq_mul, mul_one, max_eq_left (by linarith)]
      ring_nf
      exact le_rfl
  calc S⁻¹ * ‖∫ z, g z * ephase (ψ * z)‖ ≤ S⁻¹ * S :=
        mul_le_mul_of_nonneg_left h (inv_nonneg.mpr hS.le)
    _ = 1 := inv_mul_cancel₀ hS.ne'

/-- The corner condition of Step 2: `(a, b^ω) ∈ E_y` for every vertex, in the pair order `(b^ω, a)`
of Step 1. -/
def cdlBox {Y : Type*} {r : ℕ} (E : Set (Y × ((Fin r → ℝ) × (Fin r → ℝ)))) :
    Set (Y × ((Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ))) :=
  {p | ∀ ω : Fin r → Bool, (p.1, (cubeSel ω p.2.2.1 p.2.2.2, p.2.1)) ∈ E}

/-- The alternating phase `ψ_y(a,b,c) = Σ_ω (-1)^{|ω|} φ_y(a, b^ω)` of Step 2. -/
noncomputable def cdlPsi {Y : Type*} {r : ℕ} (φ : Y × ((Fin r → ℝ) × (Fin r → ℝ)) → ℝ)
    (p : Y × ((Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ))) : ℝ :=
  ∑ ω : Fin r → Bool, (-1) ^ numTrue ω * φ (p.1, (cubeSel ω p.2.2.1 p.2.2.2, p.2.1))

/-- The interchanged function `G_{y,b,c} = E_t D^r_{c,b} F_{t,y}` of Step 2. -/
noncomputable def cdlG {Ω Y : Type*} [MeasurableSpace Ω] (ν : Measure Ω) (Ft : Ω → Y → ℝ → ℂ)
    {r : ℕ} (y : Y) (b c : Fin r → ℝ) (z : ℝ) : ℂ :=
  ∫ t, cubeProdSel (fun β => Ft t y (z + ∑ i, β i)) b c ∂ν

theorem measurableSet_cdlBox {Y : Type*} [MeasurableSpace Y] {r : ℕ}
    {E : Set (Y × ((Fin r → ℝ) × (Fin r → ℝ)))} (hE : MeasurableSet E) :
    MeasurableSet (cdlBox E) := by
  have : cdlBox E = ⋂ ω : Fin r → Bool,
      (fun p : Y × ((Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ)) =>
        (p.1, (cubeSel ω p.2.2.1 p.2.2.2, p.2.1))) ⁻¹' E := by
    ext p; simp [cdlBox]
  rw [this]
  refine MeasurableSet.iInter fun ω => ?_
  have hm : Measurable fun p : Y × ((Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ)) =>
      (p.1, (cubeSel ω p.2.2.1 p.2.2.2, p.2.1)) :=
    measurable_fst.prodMk (((measurable_cubeSel ω).comp
      (measurable_snd.snd.fst.prodMk measurable_snd.snd.snd)).prodMk measurable_snd.fst)
  exact hm hE

theorem measurable_cdlPsi {Y : Type*} [MeasurableSpace Y] {r : ℕ}
    {φ : Y × ((Fin r → ℝ) × (Fin r → ℝ)) → ℝ} (hφ : Measurable φ) : Measurable (cdlPsi φ) := by
  unfold cdlPsi
  refine Finset.measurable_sum _ fun ω _ => measurable_const.mul (hφ.comp ?_)
  exact measurable_fst.prodMk (((measurable_cubeSel ω).comp
    (measurable_snd.snd.fst.prodMk measurable_snd.snd.snd)).prodMk measurable_snd.fst)

theorem measurable_cdlG {Ω Y : Type*} [MeasurableSpace Ω] [MeasurableSpace Y] {ν : Measure Ω}
    [SFinite ν] {Ft : Ω → Y → ℝ → ℂ}
    (hFm : Measurable fun q : Ω × Y × ℝ => Ft q.1 q.2.1 q.2.2) (r : ℕ) :
    Measurable fun q : (Y × ((Fin r → ℝ) × (Fin r → ℝ))) × ℝ =>
      cdlG ν Ft q.1.1 q.1.2.1 q.1.2.2 q.2 := by
  have hv : Measurable (Function.uncurry fun (p : ((Y × ((Fin r → ℝ) × (Fin r → ℝ))) × ℝ) × Ω)
      (β : Fin r → ℝ) => Ft p.2 p.1.1.1 (p.1.2 + ∑ i, β i)) :=
    hFm.comp (measurable_fst.snd.prodMk (measurable_fst.fst.fst.fst.prodMk
      (measurable_fst.fst.snd.add
        (Finset.measurable_sum _ fun i _ => (measurable_pi_apply i).comp measurable_snd))))
  have hc := measurable_cubeProdSel_param hv
  have hmap : Measurable fun s : ((Y × ((Fin r → ℝ) × (Fin r → ℝ))) × ℝ) × Ω =>
      (s, (s.1.1.2.1, s.1.1.2.2)) :=
    measurable_id.prodMk (measurable_fst.fst.snd.fst.prodMk measurable_fst.fst.snd.snd)
  have h := ((hc.comp hmap).stronglyMeasurable.integral_prod_right' (ν := ν)).measurable
  exact h

theorem norm_cdlG_le {Ω Y : Type*} [MeasurableSpace Ω] {ν : Measure Ω} [IsProbabilityMeasure ν]
    {Ft : Ω → Y → ℝ → ℂ} (hF1 : ∀ t y z, ‖Ft t y z‖ ≤ 1) {r : ℕ} (y : Y) (b c : Fin r → ℝ)
    (z : ℝ) : ‖cdlG ν Ft y b c z‖ ≤ 1 :=
  norm_integral_le_one fun _ => norm_cubeProdSel_le (fun _ => hF1 _ _ _) _ _

theorem cdlG_eq_zero {Ω Y : Type*} [MeasurableSpace Ω] {ν : Measure Ω} {Ft : Ω → Y → ℝ → ℂ}
    {c S : ℝ} (hFs : ∀ t y z, z ∉ Set.Icc c (c + S) → Ft t y z = 0) {r : ℕ} (y : Y)
    (b c' : Fin r → ℝ) (z : ℝ) (hz : z ∉ Set.Icc (c - ∑ i, b i) (c - ∑ i, b i + S)) :
    cdlG ν Ft y b c' z = 0 := by
  rw [cdlG, integral_congr_ae (Eventually.of_forall fun t =>
    pairedCube_support (hFs t y) b c' z hz)]
  simp

/-- The integrand of Step 2 on the cube parameters `k = (a, b, c)`:
`1_{□^r E_y}(k) |S⁻¹ ∫ G_{y,b,c}(z) e(ψ_y(k) z) dz|²`. -/
noncomputable def cdlL {Ω Y : Type*} [MeasurableSpace Ω] (ν : Measure Ω) (Ft : Ω → Y → ℝ → ℂ)
    (S : ℝ) {r : ℕ} (φ : Y × ((Fin r → ℝ) × (Fin r → ℝ)) → ℝ)
    (E : Set (Y × ((Fin r → ℝ) × (Fin r → ℝ))))
    (p : Y × ((Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ))) : ℝ :=
  Set.indicator (cdlBox E) (fun _ => (1 : ℝ)) p
    * ‖cdlCoef S (cdlG ν Ft p.1 p.2.2.1 p.2.2.2) (cdlPsi φ p)‖ ^ 2

theorem measurable_cdlL {Ω Y : Type*} [MeasurableSpace Ω] [MeasurableSpace Y] {ν : Measure Ω}
    [SFinite ν] {Ft : Ω → Y → ℝ → ℂ}
    (hFm : Measurable fun q : Ω × Y × ℝ => Ft q.1 q.2.1 q.2.2) (S : ℝ) {r : ℕ}
    {φ : Y × ((Fin r → ℝ) × (Fin r → ℝ)) → ℝ} (hφ : Measurable φ)
    {E : Set (Y × ((Fin r → ℝ) × (Fin r → ℝ)))} (hE : MeasurableSet E) :
    Measurable (cdlL ν Ft S φ E) := by
  have hG := measurable_cdlG (ν := ν) hFm r
  have hG' : Measurable (Function.uncurry fun (p : Y × ((Fin r → ℝ) × (Fin r → ℝ) ×
      (Fin r → ℝ))) (z : ℝ) => cdlG ν Ft p.1 p.2.2.1 p.2.2.2 z) := by
    have hmap : Measurable fun q : (Y × ((Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ))) × ℝ =>
        (((q.1.1, (q.1.2.2.1, q.1.2.2.2)) : Y × ((Fin r → ℝ) × (Fin r → ℝ))), q.2) :=
      (measurable_fst.fst.prodMk (measurable_fst.snd.snd.fst.prodMk
        measurable_fst.snd.snd.snd)).prodMk measurable_snd
    have h := hG.comp hmap
    exact h
  have hc := measurable_coef_param hG' (measurable_cdlPsi hφ)
  have h1 : Measurable fun p : Y × ((Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ)) =>
      Set.indicator (cdlBox E) (fun _ => (1 : ℝ)) p :=
    measurable_const.indicator (measurableSet_cdlBox hE)
  have h2 : Measurable fun p : Y × ((Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ)) =>
      ‖cdlCoef S (cdlG ν Ft p.1 p.2.2.1 p.2.2.2) (cdlPsi φ p)‖ ^ 2 := by
    have h := (hc.const_mul ((S : ℂ)⁻¹)).norm.pow_const 2
    exact h
  exact h1.mul h2

theorem cdlL_mem_Icc {Ω Y : Type*} [MeasurableSpace Ω] {ν : Measure Ω} [IsProbabilityMeasure ν]
    {Ft : Ω → Y → ℝ → ℂ} (hF1 : ∀ t y z, ‖Ft t y z‖ ≤ 1) {c S : ℝ} (hS : 0 < S)
    (hFs : ∀ t y z, z ∉ Set.Icc c (c + S) → Ft t y z = 0) {r : ℕ}
    (φ : Y × ((Fin r → ℝ) × (Fin r → ℝ)) → ℝ) (E : Set (Y × ((Fin r → ℝ) × (Fin r → ℝ))))
    (p : Y × ((Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ))) : cdlL ν Ft S φ E p ∈ Set.Icc 0 1 := by
  classical
  have hc : ‖cdlCoef S (cdlG ν Ft p.1 p.2.2.1 p.2.2.2) (cdlPsi φ p)‖ ≤ 1 :=
    norm_cdlCoef_le hS (norm_cdlG_le hF1 _ _ _) (cdlG_eq_zero hFs _ _ _) _
  rw [cdlL]
  by_cases hp : p ∈ cdlBox E
  · rw [Set.indicator_of_mem hp, one_mul]
    exact ⟨by positivity, pow_le_one₀ (norm_nonneg _) hc⟩
  · rw [Set.indicator_of_notMem hp, zero_mul]
    exact ⟨le_rfl, zero_le_one⟩

/-- **`patch:conditional-degree`, Step 2 on one section**: if the Step 1 set has section measure at
least `m` at `y` and the coefficients there exceed `b₀`, the dual-difference interchange gives
`(b₀² m)^{2^r} ≤ T^{2(2^r - 1)} E_k 1_{□^r E_y}(k) |S⁻¹ ∫ G_{y,b,c} e(ψ_y(k) z) dz|²`. -/
theorem cdl_step2 {Ω : Type} [MeasurableSpace Ω] {ν : Measure Ω} [IsProbabilityMeasure ν]
    {Y : Type*} [MeasurableSpace Y] {Ft : Ω → Y → ℝ → ℂ}
    (hFm : Measurable fun q : Ω × Y × ℝ => Ft q.1 q.2.1 q.2.2) (hF1 : ∀ t y z, ‖Ft t y z‖ ≤ 1)
    {c S H : ℝ} (hS : 0 < S) (hH : 0 < H)
    (hFs : ∀ t y z, z ∉ Set.Icc c (c + S) → Ft t y z = 0) {r : ℕ} (hr : 1 ≤ r)
    {φ : Y × ((Fin r → ℝ) × (Fin r → ℝ)) → ℝ} (hφ : Measurable φ)
    {E : Set (Y × ((Fin r → ℝ) × (Fin r → ℝ)))} (hE : MeasurableSet E) {b₀ : ℝ} (hb0 : 0 ≤ b₀)
    (hcoef : ∀ p ∈ E, b₀ < ‖cdlCoef S (fun z => cubeProdSel
        (fun β => ∫ t, Ft t p.1 (z + ∑ i, β i) ∂ν) p.2.1 p.2.2) (φ p)‖)
    (y : Y) {m : ℝ} (hm0 : 0 ≤ m)
    (hm : m ≤ (((Measure.pi fun _ : Fin r => unifMeas H).prod
      (Measure.pi fun _ : Fin r => unifMeas H)) {q | (y, q) ∈ E}).toReal) :
    (b₀ ^ 2 * m) ^ (2 ^ r) ≤ ((S + r * H) / S) ^ (2 * (2 ^ r - 1))
      * ∫ k, cdlL ν Ft S φ E (y, k) ∂((Measure.pi fun _ : Fin r => unifMeas H).prod
        ((Measure.pi fun _ : Fin r => unifMeas H).prod
          (Measure.pi fun _ : Fin r => unifMeas H))) := by
  classical
  have := isProbabilityMeasure_unifMeas hH
  set πr := Measure.pi fun _ : Fin r => unifMeas H with hπr
  set Ed : Set ((Fin r → ℝ) × (Fin r → ℝ)) := {q | (y, (q.2, q.1)) ∈ E} with hEd
  have hEdm : MeasurableSet Ed := by
    have hm : Measurable fun q : (Fin r → ℝ) × (Fin r → ℝ) => (y, (q.2, q.1)) :=
      measurable_const.prodMk (measurable_snd.prodMk measurable_fst)
    exact hm hE
  set φd : (Fin r → ℝ) × (Fin r → ℝ) → ℝ := fun q => φ (y, (q.2, q.1)) with hφd
  have hφdm : Measurable φd :=
    hφ.comp (measurable_const.prodMk (measurable_snd.prodMk measurable_fst))
  have hFy : Measurable (Function.uncurry fun (t : Ω) (z : ℝ) => Ft t y z) := by
    have h := hFm.comp (measurable_fst.prodMk ((measurable_const (a := y)).prodMk measurable_snd))
    exact h
  have hdd := dual_diff_bound (μ := ν) hr hS hH (Ft := fun t z => Ft t y z) hFy
    (fun t z => hF1 t y z) (fun t z hz => hFs t y z hz) hEdm hφdm
  -- the right side is the Step 2 integrand
  have hR : (∫ a, ∫ b, ∫ c', Set.indicator (cubeBoxSet Ed) (fun _ => (1 : ℝ)) (a, b, c')
        * ‖(S : ℂ)⁻¹ * ∫ x, (∫ t, cubeProdSel (fun β => Ft t y (x + ∑ i, β i)) b c' ∂ν)
          * ephase (altPhase φd (a, b, c') * x)‖ ^ 2 ∂πr ∂πr ∂πr)
      = ∫ k, cdlL ν Ft S φ E (y, k) ∂(πr.prod (πr.prod πr)) := by
    have hLm : Measurable fun k => cdlL ν Ft S φ E (y, k) := by
      have h := (measurable_cdlL (ν := ν) hFm S hφ hE).comp (measurable_prodMk_left (x := y))
      exact h
    have hLb : ∀ k, |cdlL ν Ft S φ E (y, k)| ≤ 1 := fun k => by
      have := cdlL_mem_Icc (ν := ν) hF1 hS hFs φ E (y, k)
      rw [abs_of_nonneg this.1]; exact this.2
    rw [integral_prod _ (integrable_of_bdd_finite hLm hLb)]
    refine integral_congr_ae (Eventually.of_forall fun a => ?_)
    beta_reduce
    have hm2 : Measurable fun q : (Fin r → ℝ) × (Fin r → ℝ) => cdlL ν Ft S φ E (y, (a, q)) := by
      have h := hLm.comp ((measurable_const (a := a)).prodMk measurable_id)
      exact h
    rw [integral_prod _ (integrable_of_bdd_finite hm2 (C := 1) fun q => hLb _)]
    refine integral_congr_ae (Eventually.of_forall fun b => ?_)
    refine integral_congr_ae (Eventually.of_forall fun c' => ?_)
    rfl
  rw [hR] at hdd
  refine le_trans ?_ hdd
  -- the left side is at least `b₀² m`
  have hθ : b₀ ^ 2 * m ≤ ∫ a, ∫ b, Set.indicator Ed (fun _ => (1 : ℝ)) (a, b)
      * ‖(S : ℂ)⁻¹ * ∫ x, cubeProdSel (fun β => ∫ t, Ft t y (x + ∑ i, β i) ∂ν) b a
        * ephase (φd (a, b) * x)‖ ^ 2 ∂πr ∂πr := by
    set g : (Fin r → ℝ) × (Fin r → ℝ) → ℝ := fun q => Set.indicator Ed (fun _ => (1 : ℝ)) q
      * ‖(S : ℂ)⁻¹ * ∫ x, cubeProdSel (fun β => ∫ t, Ft t y (x + ∑ i, β i) ∂ν) q.2 q.1
        * ephase (φd q * x)‖ ^ 2 with hg
    have hFF : Measurable (Function.uncurry fun (y' : Y) (z : ℝ) => ∫ t, Ft t y' z ∂ν) := by
      have hmap : Measurable fun p : (Y × ℝ) × Ω => ((p.2, p.1) : Ω × Y × ℝ) :=
        measurable_snd.prodMk measurable_fst
      have h2 := hFm.comp hmap
      have h3 := (h2.stronglyMeasurable.integral_prod_right' (ν := ν)).measurable
      exact h3
    have hgm : Measurable g := by
      have hsc := measurable_sectionCube hFF r
      have hsc' : Measurable (Function.uncurry fun (q : (Fin r → ℝ) × (Fin r → ℝ)) (z : ℝ) =>
          cubeProdSel (fun β => ∫ t, Ft t y (z + ∑ i, β i) ∂ν) q.2 q.1) := by
        have h := hsc.comp (((measurable_const (a := y)).prodMk
          (measurable_fst.snd.prodMk measurable_fst.fst)).prodMk measurable_snd)
        exact h
      have hc := measurable_coef_param hsc' hφdm
      have h := ((measurable_const (a := (1 : ℝ))).indicator hEdm).mul
        ((hc.const_mul ((S : ℂ)⁻¹)).norm.pow_const 2)
      exact h
    have hg01 : ∀ q, g q ∈ Set.Icc 0 1 := fun q => by
      have hc : ‖(S : ℂ)⁻¹ * ∫ x, cubeProdSel (fun β => ∫ t, Ft t y (x + ∑ i, β i) ∂ν) q.2 q.1
          * ephase (φd q * x)‖ ≤ 1 :=
        norm_cdlCoef_le hS (fun z => norm_cubeProdSel_le
          (fun β => norm_integral_le_one fun t => hF1 _ _ _) _ _)
          (fun z hz => pairedCube_support (f := fun x => ∫ t, Ft t y x ∂ν) (fun x hx => by
            rw [integral_congr_ae (Eventually.of_forall fun t => hFs t y x hx)]; simp)
            q.2 q.1 z hz) _
      simp only [hg]
      by_cases hq : q ∈ Ed
      · rw [Set.indicator_of_mem hq, one_mul]
        exact ⟨by positivity, pow_le_one₀ (norm_nonneg _) hc⟩
      · rw [Set.indicator_of_notMem hq, zero_mul]
        exact ⟨le_rfl, zero_le_one⟩
    have hgi : Integrable g (πr.prod πr) :=
      integrable_of_bdd_finite hgm (C := 1) fun q => by
        rw [abs_of_nonneg (hg01 q).1]; exact (hg01 q).2
    have hiter : (∫ a, ∫ b, g (a, b) ∂πr ∂πr) = ∫ q, g q ∂(πr.prod πr) :=
      (integral_prod _ hgi).symm
    have hlow : ∀ q, b₀ ^ 2 * Set.indicator Ed (fun _ => (1 : ℝ)) q ≤ g q := by
      intro q
      simp only [hg]
      by_cases hq : q ∈ Ed
      · rw [Set.indicator_of_mem hq, one_mul, mul_one]
        have h1 := hcoef (y, (q.2, q.1)) hq
        exact pow_le_pow_left₀ hb0 h1.le 2
      · rw [Set.indicator_of_notMem hq, mul_zero, zero_mul]
    have hEdμ : ((πr.prod πr) Ed).toReal = ((πr.prod πr) {q | (y, q) ∈ E}).toReal := by
      have hsw : MeasurePreserving Prod.swap (πr.prod πr) (πr.prod πr) :=
        Measure.measurePreserving_swap
      have : Ed = Prod.swap ⁻¹' {q | (y, q) ∈ E} := by ext q; simp [hEd, Prod.swap]
      rw [this, hsw.measure_preimage (by
        have hm : Measurable fun q : (Fin r → ℝ) × (Fin r → ℝ) => (y, q) :=
          measurable_const.prodMk measurable_id
        exact (hm hE).nullMeasurableSet)]
    calc b₀ ^ 2 * m ≤ b₀ ^ 2 * ((πr.prod πr) Ed).toReal := by
          rw [hEdμ]; exact mul_le_mul_of_nonneg_left hm (sq_nonneg _)
      _ = ∫ q, b₀ ^ 2 * Set.indicator Ed (fun _ => (1 : ℝ)) q ∂(πr.prod πr) := by
          rw [integral_const_mul, integral_indicator hEdm, setIntegral_const, smul_eq_mul,
            mul_one]
          simp [Measure.real]
      _ ≤ ∫ q, g q ∂(πr.prod πr) :=
          integral_mono (((integrable_const (1 : ℝ)).indicator hEdm).const_mul (b₀ ^ 2)) hgi
            hlow
      _ = _ := hiter.symm
  have hθ0 : 0 ≤ b₀ ^ 2 * m := mul_nonneg (sq_nonneg _) hm0
  exact pow_le_pow_left₀ hθ0 hθ _

end

section
open Filter Topology MeasureTheory

/-- **Popularity on the sections of a product** (`patch:budgets`): if `0 ≤ f ≤ 1` and every `x`
in `A` has `t ≤ ∫ f(x, ·)`, the set `{t/2 ≤ f}` has product measure at least `μ(A) t/2`. -/
theorem measure_prod_popular_ge {X K : Type*} [MeasurableSpace X] [MeasurableSpace K]
    {μ : Measure X} [IsProbabilityMeasure μ] {π : Measure K} [IsProbabilityMeasure π]
    {f : X × K → ℝ} (hf : Measurable f) (hf01 : ∀ p, f p ∈ Set.Icc 0 1) {A : Set X}
    (hA : MeasurableSet A) {t : ℝ} (ht : 0 < t) (hAt : ∀ x ∈ A, t ≤ ∫ k, f (x, k) ∂π) :
    (μ A).toReal * (t / 2) ≤ ((μ.prod π) {p | t / 2 ≤ f p}).toReal := by
  have hZm : MeasurableSet {p : X × K | t / 2 ≤ f p} := measurableSet_le measurable_const hf
  have hsec : ∀ x ∈ A, t / 2 ≤ (π {k | t / 2 ≤ f (x, k)}).toReal := by
    intro x hx
    have hfx : Measurable fun k => f (x, k) := by
      have h := hf.comp (measurable_prodMk_left (x := x))
      exact h
    have := measure_popular_ge (μ := π) hfx (fun k => (hf01 _).1) (fun k => (hf01 _).2)
      one_pos (by simp) ht (hAt x hx)
    simpa using this
  rw [Measure.prod_apply hZm]
  have hmeas : Measurable fun x => π (Prod.mk x ⁻¹' {p : X × K | t / 2 ≤ f p}) :=
    measurable_measure_prodMk_left hZm
  rw [← integral_toReal hmeas.aemeasurable (Eventually.of_forall fun x => measure_lt_top _ _)]
  have hint : Integrable (fun x => (π (Prod.mk x ⁻¹' {p : X × K | t / 2 ≤ f p})).toReal) μ :=
    integrable_of_bdd_finite hmeas.ennreal_toReal (C := 1) fun x => by
      rw [abs_of_nonneg ENNReal.toReal_nonneg]
      exact ENNReal.toReal_le_of_le_ofReal zero_le_one
        (by rw [ENNReal.ofReal_one]; exact prob_le_one)
  calc (μ A).toReal * (t / 2) = ∫ x in A, t / 2 ∂μ := by rw [setIntegral_const_real]
    _ ≤ ∫ x in A, (π (Prod.mk x ⁻¹' {p : X × K | t / 2 ≤ f p})).toReal ∂μ :=
        setIntegral_mono_on (integrable_const _).integrableOn hint.integrableOn hA
          fun x hx => hsec x hx
    _ ≤ ∫ x, (π (Prod.mk x ⁻¹' {p : X × K | t / 2 ≤ f p})).toReal ∂μ :=
        setIntegral_le_integral hint (Eventually.of_forall fun x => ENNReal.toReal_nonneg)

/-- **Popular sections in the second variable**: if `(μ × π)(Z) ≥ s > 0`, the set of `k` whose
section `Z^k` has `μ`-measure at least `s/2` has `π`-measure at least `s/2`. -/
theorem measure_popular_sections_right {X K : Type*} [MeasurableSpace X] [MeasurableSpace K]
    {μ : Measure X} [IsProbabilityMeasure μ] {π : Measure K} [IsProbabilityMeasure π]
    {Z : Set (X × K)} (hZ : MeasurableSet Z) {s : ℝ} (hs : 0 < s)
    (hZs : s ≤ ((μ.prod π) Z).toReal) :
    s / 2 ≤ (π {k | s / 2 ≤ (μ {x | (x, k) ∈ Z}).toReal}).toReal := by
  have hm : Measurable fun k => (μ ((fun x => (x, k)) ⁻¹' Z)).toReal :=
    (measurable_measure_prodMk_right hZ).ennreal_toReal
  have hint : s ≤ ∫ k, (μ ((fun x => (x, k)) ⁻¹' Z)).toReal ∂π := by
    rw [integral_toReal (measurable_measure_prodMk_right hZ).aemeasurable
      (Eventually.of_forall fun k => measure_lt_top _ _), ← Measure.prod_apply_symm hZ]
    exact hZs
  have h := measure_popular_ge (μ := π) hm (fun k => ENNReal.toReal_nonneg)
    (fun k => ENNReal.toReal_le_of_le_ofReal zero_le_one (by
      rw [ENNReal.ofReal_one]; exact prob_le_one)) one_pos (by simp) hs hint
  have e : s / (2 * 1) = s / 2 := by ring
  rw [e] at h
  exact h

/-- **Popular sections in the first variable.** -/
theorem measure_popular_sections_left {X K : Type*} [MeasurableSpace X] [MeasurableSpace K]
    {μ : Measure X} [IsProbabilityMeasure μ] {π : Measure K} [IsProbabilityMeasure π]
    {Z : Set (X × K)} (hZ : MeasurableSet Z) {s : ℝ} (hs : 0 < s)
    (hZs : s ≤ ((μ.prod π) Z).toReal) :
    s / 2 ≤ (μ {x | s / 2 ≤ (π {k | (x, k) ∈ Z}).toReal}).toReal := by
  have hm : Measurable fun x => (π (Prod.mk x ⁻¹' Z)).toReal :=
    (measurable_measure_prodMk_left hZ).ennreal_toReal
  have hint : s ≤ ∫ x, (π (Prod.mk x ⁻¹' Z)).toReal ∂μ := by
    rw [integral_toReal (measurable_measure_prodMk_left hZ).aemeasurable
      (Eventually.of_forall fun x => measure_lt_top _ _), ← Measure.prod_apply hZ]
    exact hZs
  have h := measure_popular_ge (μ := μ) hm (fun x => ENNReal.toReal_nonneg)
    (fun x => ENNReal.toReal_le_of_le_ofReal zero_le_one (by
      rw [ENNReal.ofReal_one]; exact prob_le_one)) one_pos (by simp) hs hint
  have e : s / (2 * 1) = s / 2 := by ring
  rw [e] at h
  exact h

/-- **A product set is large if its sections are large on a large set.** -/
theorem measure_prod_ge_of_sections {X K : Type*} [MeasurableSpace X] [MeasurableSpace K]
    {μ : Measure X} [IsProbabilityMeasure μ] {π : Measure K} [IsProbabilityMeasure π]
    {Z : Set (X × K)} (hZ : MeasurableSet Z) {A : Set K} (hA : MeasurableSet A) {s : ℝ}
    (hAs : ∀ k ∈ A, s ≤ (μ {x | (x, k) ∈ Z}).toReal) :
    (π A).toReal * s ≤ ((μ.prod π) Z).toReal := by
  have hm : Measurable fun k => (μ ((fun x => (x, k)) ⁻¹' Z)).toReal :=
    (measurable_measure_prodMk_right hZ).ennreal_toReal
  rw [Measure.prod_apply_symm hZ,
    ← integral_toReal (measurable_measure_prodMk_right hZ).aemeasurable
    (Eventually.of_forall fun k => measure_lt_top _ _)]
  have hint : Integrable (fun k => (μ ((fun x => (x, k)) ⁻¹' Z)).toReal) π :=
    integrable_of_bdd_finite hm (C := 1) fun k => by
      rw [abs_of_nonneg ENNReal.toReal_nonneg]
      exact ENNReal.toReal_le_of_le_ofReal zero_le_one
        (by rw [ENNReal.ofReal_one]; exact prob_le_one)
  calc (π A).toReal * s = ∫ k in A, s ∂π := by rw [setIntegral_const_real]
    _ ≤ ∫ k in A, (μ ((fun x => (x, k)) ⁻¹' Z)).toReal ∂π :=
        setIntegral_mono_on (integrable_const _).integrableOn hint.integrableOn hA
          fun k hk => hAs k hk
    _ ≤ _ := setIntegral_le_integral hint (Eventually.of_forall fun k => ENNReal.toReal_nonneg)

end

section
open Filter Topology MeasureTheory

/-- `|e(u) - e(v)| ≤ 2π |u - v|`. -/
theorem norm_ephase_sub_le (u v : ℝ) : ‖ephase u - ephase v‖ ≤ 2 * Real.pi * |u - v| := by
  have h : ephase u - ephase v = ephase v * (ephase (u - v) - 1) := by
    rw [mul_sub, ← ephase_add, mul_one]
    ring_nf
  rw [h, norm_mul, norm_ephase, one_mul, ephase]
  have := Real.norm_exp_I_mul_ofReal_sub_one_le (x := 2 * Real.pi * (u - v))
  rw [mul_comm Complex.I] at this
  refine this.trans (le_of_eq ?_)
  rw [Real.norm_eq_abs, abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 2 * Real.pi)]

/-- **Changing the frequency changes the coefficient by at most `2π Z |Δφ|`** when the function is
one-bounded and supported in an interval of length `S` inside `[-Z, Z]`. -/
theorem norm_cdlCoef_sub_le {S p Z : ℝ} (hS : 0 < S) {g : ℝ → ℂ} (hg : Measurable g)
    (hg1 : ∀ z, ‖g z‖ ≤ 1) (hgs : ∀ z, z ∉ Set.Icc p (p + S) → g z = 0)
    (hZ : Set.Icc p (p + S) ⊆ Set.Icc (-Z) Z) (φ φ' : ℝ) :
    ‖cdlCoef S g φ - cdlCoef S g φ'‖ ≤ 2 * Real.pi * Z * |φ - φ'| := by
  have hgi := integrable_of_bdd_Icc hg.aestronglyMeasurable hg1 hgs
  have hi1 : Integrable fun z => g z * ephase (φ * z) :=
    hgi.mul_bdd (c := 1) (continuous_ephase.measurable.comp (measurable_const.mul
      measurable_id)).aestronglyMeasurable (Eventually.of_forall fun z => (norm_ephase _).le)
  have hi2 : Integrable fun z => g z * ephase (φ' * z) :=
    hgi.mul_bdd (c := 1) (continuous_ephase.measurable.comp (measurable_const.mul
      measurable_id)).aestronglyMeasurable (Eventually.of_forall fun z => (norm_ephase _).le)
  rw [cdlCoef, cdlCoef, ← mul_sub, ← integral_sub hi1 hi2, norm_mul, norm_inv,
    Complex.norm_real, Real.norm_of_nonneg hS.le]
  have hind : Integrable (Set.indicator (Set.Icc p (p + S))
      fun _ => 2 * Real.pi * Z * |φ - φ'|) :=
    (continuous_const.integrableOn_Icc).integrable_indicator measurableSet_Icc
  have hZ0 : 0 ≤ Z := by
    have h1 := hZ ⟨le_rfl, by linarith⟩
    linarith [h1.1, h1.2]
  have hb : ‖∫ z, (g z * ephase (φ * z) - g z * ephase (φ' * z))‖
      ≤ S * (2 * Real.pi * Z * |φ - φ'|) := by
    refine (norm_integral_le_of_norm_le hind (Eventually.of_forall fun z => ?_)).trans ?_
    · by_cases hz : z ∈ Set.Icc p (p + S)
      · rw [Set.indicator_of_mem hz, ← mul_sub, norm_mul]
        have hzZ := hZ hz
        have hzabs : |z| ≤ Z := abs_le.mpr ⟨hzZ.1, hzZ.2⟩
        calc ‖g z‖ * ‖ephase (φ * z) - ephase (φ' * z)‖
            ≤ 1 * (2 * Real.pi * |φ * z - φ' * z|) :=
              mul_le_mul (hg1 z) (norm_ephase_sub_le _ _) (norm_nonneg _) zero_le_one
          _ = 2 * Real.pi * (|z| * |φ - φ'|) := by
              rw [one_mul, ← sub_mul, abs_mul, mul_comm |φ - φ'|]
          _ ≤ 2 * Real.pi * (Z * |φ - φ'|) := by gcongr
          _ = 2 * Real.pi * Z * |φ - φ'| := by ring
      · rw [Set.indicator_of_notMem hz, hgs z hz]
        simp
    · rw [integral_indicator measurableSet_Icc, setIntegral_const, Real.volume_real_Icc,
        smul_eq_mul, max_eq_left (by linarith)]
      ring_nf
      exact le_rfl
  calc S⁻¹ * ‖∫ z, (g z * ephase (φ * z) - g z * ephase (φ' * z))‖
      ≤ S⁻¹ * (S * (2 * Real.pi * Z * |φ - φ'|)) :=
        mul_le_mul_of_nonneg_left hb (inv_nonneg.mpr hS.le)
    _ = 2 * Real.pi * Z * |φ - φ'| := by field_simp

/-- **`patch:conditional-degree`, Step 8 on one section.** Suppose that on a set of `(a, b)` of
measure at least `m₁` the coefficient of `D^r_{a,b} f` at `φ(a,b)` exceeds `b₀`, the shifts lie in
`[0,H]^r`, and `φ` is within `Δ/2` of a sum `Σ_i α_i` of phases independent of `b_i`, where
`2π Z Δ/2 ≤ b₀/2`. Then the missing-phase lemma gives
`((b₀/2)² m₁)^{2^r} ≤ T^{2(2^r-1)} (1 + H/S) Q_{r+1,H,S}(f)`. -/
theorem cdl_step8 {r : ℕ} (hr : 1 ≤ r) {c S H : ℝ} (hS : 0 < S) (hH : 0 < H)
    {f : ℝ → ℂ} (hf : Measurable f) (hf1 : ∀ x, ‖f x‖ ≤ 1)
    (hfs : ∀ x, x ∉ Set.Icc c (c + S) → f x = 0)
    {α : Fin r → (Fin r → ℝ) × (Fin r → ℝ) → ℝ} (hαm : ∀ i, Measurable (α i))
    (hαi : ∀ i a b β, α i (a, Function.update b i β) = α i (a, b))
    {φ : (Fin r → ℝ) × (Fin r → ℝ) → ℝ}
    {A : Set ((Fin r → ℝ) × (Fin r → ℝ))} (hA : MeasurableSet A) {m₁ b₀ Δ Z : ℝ}
    (hm₁ : 0 ≤ m₁) (hb₀ : 0 ≤ b₀)
    (hAm : m₁ ≤ (((Measure.pi fun _ : Fin r => unifMeas H).prod
      (Measure.pi fun _ : Fin r => unifMeas H)) A).toReal)
    (hAbox : ∀ q ∈ A, ∀ i, q.2 i ∈ Set.Icc 0 H)
    (hAcoef : ∀ q ∈ A, b₀ < ‖cdlCoef S (fun z => cubeProdSel (fun β => f (z + ∑ i, β i)) q.2 q.1)
      (φ q)‖)
    (hAclose : ∀ q ∈ A, |φ q - ∑ i, α i q| ≤ Δ / 2)
    (hZ : |c| + S + r * H ≤ Z) (hΔ : 2 * Real.pi * Z * (Δ / 2) ≤ b₀ / 2) :
    ((b₀ / 2) ^ 2 * m₁) ^ (2 ^ r)
      ≤ ((S + r * H) / S) ^ (2 * (2 ^ r - 1)) * ((1 + H / S) * unifPow1 H S (r + 1) f) := by
  classical
  have := isProbabilityMeasure_unifMeas hH
  set πr := Measure.pi fun _ : Fin r => unifMeas H with hπr
  have hmp := missing_phase_bound hr hS hH hf hf1 hfs hαm hαi
  refine le_trans ?_ hmp
  refine pow_le_pow_left₀ (by positivity) ?_ _
  -- the integrand of the missing-phase quantity
  set g : (Fin r → ℝ) × (Fin r → ℝ) → ℝ := fun q =>
    ‖(S : ℂ)⁻¹ * ∫ x, cubeProdSel (fun β => f (x + ∑ i, β i)) q.2 q.1
      * ephase ((∑ i, α i q) * x)‖ ^ 2 with hg
  have hgm : Measurable g := by
    have hsc : Measurable (Function.uncurry fun (q : (Fin r → ℝ) × (Fin r → ℝ)) (z : ℝ) =>
        cubeProdSel (fun β => f (z + ∑ i, β i)) q.2 q.1) := by
      have h := (measurable_pairedCube hf r).comp
        (measurable_snd.prodMk (measurable_fst.snd.prodMk measurable_fst.fst))
      exact h
    have hc := measurable_coef_param hsc (ψ := fun q => ∑ i, α i q)
      (Finset.measurable_sum Finset.univ fun i _ => hαm i)
    have h := (hc.const_mul ((S : ℂ)⁻¹)).norm.pow_const 2
    exact h
  have hg01 : ∀ q, g q ∈ Set.Icc 0 1 := fun q =>
    ⟨by positivity, pow_le_one₀ (norm_nonneg _) (norm_cdlCoef_le hS
      (fun z => norm_cubeProdSel_le (fun β => hf1 _) _ _)
      (fun z hz => pairedCube_support hfs q.2 q.1 z hz) _)⟩
  have hgi : Integrable g (πr.prod πr) :=
    integrable_of_bdd_finite hgm (C := 1) fun q => by
      rw [abs_of_nonneg (hg01 q).1]; exact (hg01 q).2
  have hlow : ∀ q, (b₀ / 2) ^ 2 * Set.indicator A (fun _ => (1 : ℝ)) q ≤ g q := by
    intro q
    by_cases hq : q ∈ A
    · rw [Set.indicator_of_mem hq, mul_one]
      have hsupp : Set.Icc (c - ∑ i, q.2 i) (c - ∑ i, q.2 i + S) ⊆ Set.Icc (-Z) Z := by
        have h0 : 0 ≤ ∑ i, q.2 i := Finset.sum_nonneg fun i _ => (hAbox q hq i).1
        have h1 : ∑ i, q.2 i ≤ r * H := by
          calc ∑ i, q.2 i ≤ ∑ _i : Fin r, H := Finset.sum_le_sum fun i _ => (hAbox q hq i).2
            _ = r * H := by simp
        intro z hz
        constructor
        · linarith [hz.1, neg_abs_le c, abs_nonneg c]
        · linarith [hz.2, le_abs_self c]
      have hdiff := norm_cdlCoef_sub_le hS (measurable_pairedCube_at hf q.2 q.1)
        (fun z => norm_cubeProdSel_le (fun β => hf1 _) _ _)
        (fun z hz => pairedCube_support hfs q.2 q.1 z hz) hsupp (φ q) (∑ i, α i q)
      have hZ0 : 0 ≤ Z := le_trans (by positivity) hZ
      have hclose : 2 * Real.pi * Z * |φ q - ∑ i, α i q| ≤ b₀ / 2 :=
        le_trans (mul_le_mul_of_nonneg_left (hAclose q hq) (by positivity)) hΔ
      have hlarge := hAcoef q hq
      have hge : b₀ / 2 ≤ ‖cdlCoef S (fun z => cubeProdSel (fun β => f (z + ∑ i, β i)) q.2 q.1)
          (∑ i, α i q)‖ := by
        have := norm_sub_norm_le (cdlCoef S (fun z => cubeProdSel (fun β => f (z + ∑ i, β i))
          q.2 q.1) (φ q)) (cdlCoef S (fun z => cubeProdSel (fun β => f (z + ∑ i, β i)) q.2 q.1)
          (∑ i, α i q))
        linarith
      exact pow_le_pow_left₀ (by positivity) hge 2
    · rw [Set.indicator_of_notMem hq, mul_zero]
      exact (hg01 q).1
  calc (b₀ / 2) ^ 2 * m₁ ≤ (b₀ / 2) ^ 2 * ((πr.prod πr) A).toReal :=
        mul_le_mul_of_nonneg_left hAm (sq_nonneg _)
    _ = ∫ q, (b₀ / 2) ^ 2 * Set.indicator A (fun _ => (1 : ℝ)) q ∂(πr.prod πr) := by
        rw [integral_const_mul, integral_indicator hA, setIntegral_const, smul_eq_mul, mul_one]
        simp [Measure.real]
    _ ≤ ∫ q, g q ∂(πr.prod πr) :=
        integral_mono (((integrable_const (1 : ℝ)).indicator hA).const_mul _) hgi hlow
    _ = ∫ a, ∫ b, g (a, b) ∂πr ∂πr := integral_prod _ hgi

end

section
open Filter Topology MeasureTheory

/-- The additive form of the vertex partition `Auto.prod_vertices_split`. -/
theorem sum_vertices_split {M : Type*} [AddCommMonoid M] {r : ℕ} (X : (Fin r → Bool) → M) :
    ∑ ω, X ω = X (fun _ => false) + ∑ i : Fin r, ∑ ω with vkey ω = some i, X ω := by
  classical
  rw [← Finset.sum_fiberwise Finset.univ vkey X, Fintype.sum_option]
  congr 1
  have : (Finset.univ.filter fun ω : Fin r → Bool => vkey ω = none) = {fun _ => false} := by
    ext ω
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_singleton]
    exact vkey_eq_none_iff ω
  rw [this, Finset.sum_singleton]

/-- The explicit constants of `patch:conditional-degree`: `b₀ = (H/2S) √(a/2)`,
`T = (S + r H)/S`, `e = 2(2^r - 1)`, `d = (b₀² a/4)^{2^r} / T^e` and `z₀ = (a/4)(d/2)`. -/
noncomputable def cdlB0 (a H S : ℝ) : ℝ := H / (2 * S) * Real.sqrt (a / 2)

noncomputable def cdlT (H S : ℝ) (r : ℕ) : ℝ := (S + r * H) / S

noncomputable def cdlD (a H S : ℝ) (r : ℕ) : ℝ :=
  (cdlB0 a H S ^ 2 * (a / 4)) ^ (2 ^ r) / cdlT H S r ^ (2 * (2 ^ r - 1))

noncomputable def cdlZ0 (a H S : ℝ) (r : ℕ) : ℝ := a / 4 * (cdlD a H S r / 2)

/-- The threshold fed into the major-arc property in Step 5: `(z₀/2) √(d/2)`. -/
noncomputable def cdlThr (a H S : ℝ) (r : ℕ) : ℝ :=
  cdlZ0 a H S r / 2 * Real.sqrt (cdlD a H S r / 2)

/-- The frequency cell width `Δ = b₀ / (2π Z)` of Step 7, `Z = |c| + S + r H`. -/
noncomputable def cdlDelta (a H S c : ℝ) (r : ℕ) : ℝ :=
  cdlB0 a H S / (2 * Real.pi * (|c| + S + r * H))

/-- The mass `m₀ = w / q` of a heavy cell: `w = (z₀/4) ρ`, `q = ⌈2B/Δ⌉ + 1`. -/
noncomputable def cdlM0 (a H S c : ℝ) (r : ℕ) (B ρ : ℝ) : ℝ :=
  cdlZ0 a H S r / 4 * ρ / ((⌈2 * B / cdlDelta a H S c r⌉₊ + 1 : ℕ) : ℝ)

/-- The final lower bound of `patch:conditional-degree`:
`(m₀/2) ((b₀/2)² m₀/2)^{2^r} / (T^e (1 + H/S))`. -/
noncomputable def cdlOut (a H S c : ℝ) (r : ℕ) (B ρ : ℝ) : ℝ :=
  cdlM0 a H S c r B ρ / 2 * (((cdlB0 a H S / 2) ^ 2 * (cdlM0 a H S c r B ρ / 2)) ^ (2 ^ r)
    / (cdlT H S r ^ (2 * (2 ^ r - 1)) * (1 + H / S)))

theorem cdlB0_pos {a H S : ℝ} (ha : 0 < a) (hH : 0 < H) (hS : 0 < S) : 0 < cdlB0 a H S := by
  unfold cdlB0; have := Real.sqrt_pos.mpr (by positivity : 0 < a / 2); positivity

theorem cdlT_pos {H S : ℝ} (hH : 0 < H) (hS : 0 < S) (r : ℕ) : 0 < cdlT H S r := by
  unfold cdlT; positivity

theorem cdlD_pos {a H S : ℝ} (ha : 0 < a) (hH : 0 < H) (hS : 0 < S) (r : ℕ) :
    0 < cdlD a H S r := by
  have := cdlB0_pos ha hH hS; have := cdlT_pos hH hS r
  unfold cdlD; positivity

theorem cdlZ0_pos {a H S : ℝ} (ha : 0 < a) (hH : 0 < H) (hS : 0 < S) (r : ℕ) :
    0 < cdlZ0 a H S r := by
  have := cdlD_pos ha hH hS r; unfold cdlZ0; positivity

theorem cdlDelta_pos {a H S : ℝ} (c : ℝ) (ha : 0 < a) (hH : 0 < H) (hS : 0 < S) (r : ℕ) :
    0 < cdlDelta a H S c r := by
  have := cdlB0_pos ha hH hS; unfold cdlDelta; positivity

theorem cdlM0_pos {a H S : ℝ} (c : ℝ) (ha : 0 < a) (hH : 0 < H) (hS : 0 < S) (r : ℕ)
    (B : ℝ) {ρ : ℝ} (hρ : 0 < ρ) : 0 < cdlM0 a H S c r B ρ := by
  have := cdlZ0_pos ha hH hS r; unfold cdlM0; positivity

/-- **A heavy frequency cell** (`patch:conditional-degree`, Step 7): if `|ψ| ≤ B` on `W`, the cells
of width `Δ` covering `[-B, B]` number at most `q = ⌈2B/Δ⌉ + 1`, and one of them carries at least
`1/q` of the mass of `W`; on it `ψ` is within `Δ/2` of the centre `ζ`. -/
theorem exists_heavy_cell {X : Type*} [MeasurableSpace X] {μ : Measure X} [IsFiniteMeasure μ]
    {W : Set X} (hW : MeasurableSet W) {ψ : X → ℝ} (hψ : Measurable ψ) {B Δ : ℝ}
    (hΔ : 0 < Δ) (hWB : ∀ p ∈ W, |ψ p| ≤ B) :
    ∃ ζ : ℝ, ∃ W' : Set X, MeasurableSet W' ∧ W' ⊆ W ∧ (∀ p ∈ W', |ψ p - ζ| ≤ Δ / 2) ∧
      (μ W).toReal / ((⌈2 * B / Δ⌉₊ + 1 : ℕ) : ℝ) ≤ (μ W').toReal := by
  set q : ℕ := ⌈2 * B / Δ⌉₊ + 1 with hq
  set cell : ℕ → Set X := fun i => W ∩ {p | (i : ℝ) * Δ ≤ ψ p + B ∧ ψ p + B < ((i : ℝ) + 1) * Δ}
    with hcell
  have hcm : ∀ i, MeasurableSet (cell i) := fun i =>
    hW.inter ((measurableSet_le measurable_const (hψ.add measurable_const)).inter
      (measurableSet_lt (hψ.add measurable_const) measurable_const))
  have hcover : W ⊆ ⋃ i ∈ Finset.range q, cell i := by
    intro p hp
    have hb := abs_le.mp (hWB p hp)
    have h0 : 0 ≤ (ψ p + B) / Δ := div_nonneg (by linarith) hΔ.le
    set i := ⌊(ψ p + B) / Δ⌋₊ with hi
    have hi1 : (i : ℝ) ≤ (ψ p + B) / Δ := Nat.floor_le h0
    have hi2 : (ψ p + B) / Δ < (i : ℝ) + 1 := Nat.lt_floor_add_one _
    have hiq : i < q := by
      have : i ≤ ⌈2 * B / Δ⌉₊ := by
        have hle : (ψ p + B) / Δ ≤ 2 * B / Δ :=
          div_le_div_of_nonneg_right (by linarith [hb.2]) hΔ.le
        exact (Nat.floor_le_floor hle).trans (Nat.floor_le_ceil _)
      omega
    refine Set.mem_biUnion (Finset.mem_range.mpr hiq) ⟨hp, ?_, ?_⟩
    · rwa [le_div_iff₀ hΔ] at hi1
    · rwa [div_lt_iff₀ hΔ] at hi2
  have hsum : (μ W).toReal ≤ ∑ i ∈ Finset.range q, (μ (cell i)).toReal := by
    rw [← ENNReal.toReal_sum fun i _ => measure_ne_top μ _]
    refine ENNReal.toReal_mono (ENNReal.sum_ne_top.mpr fun i _ => measure_ne_top μ _) ?_
    exact (measure_mono hcover).trans (measure_biUnion_finset_le _ _)
  have hne : (Finset.range q).Nonempty := ⟨0, Finset.mem_range.mpr (by omega)⟩
  obtain ⟨i, _, hi⟩ := exists_cell_ge hne hsum
  rw [Finset.card_range] at hi
  refine ⟨-B + ((i : ℝ) + 1 / 2) * Δ, cell i, hcm i, Set.inter_subset_left, fun p hp => ?_, hi⟩
  obtain ⟨_, h1, h2⟩ := hp
  rw [abs_le]
  constructor <;> nlinarith

/-- **Fixing the last cube variable** (Step 7): if the `y`-section of `W` has measure at least `m`
in `(a, b, c)`, some `c` has an `(a, b)`-section of measure at least `m`. -/
theorem exists_section_last {Y : Type*} [MeasurableSpace Y] {H : ℝ} (hH : 0 < H) {r : ℕ}
    {W : Set (Y × ((Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ)))} (hW : MeasurableSet W) (y : Y)
    {m : ℝ} (hm : m ≤ (((Measure.pi fun _ : Fin r => unifMeas H).prod
      ((Measure.pi fun _ : Fin r => unifMeas H).prod (Measure.pi fun _ : Fin r => unifMeas H)))
        {k | (y, k) ∈ W}).toReal) :
    ∃ c : Fin r → ℝ, m ≤ (((Measure.pi fun _ : Fin r => unifMeas H).prod
      (Measure.pi fun _ : Fin r => unifMeas H)) {q | (y, (q.1, (q.2, c))) ∈ W}).toReal := by
  have := isProbabilityMeasure_unifMeas hH
  set πr := Measure.pi fun _ : Fin r => unifMeas H with hπr
  have hWy : MeasurableSet {k : (Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ) | (y, k) ∈ W} :=
    measurable_prodMk_left hW
  set T : Set (((Fin r → ℝ) × (Fin r → ℝ)) × (Fin r → ℝ)) :=
    MeasurableEquiv.prodAssoc ⁻¹' {k | (y, k) ∈ W} with hT
  have hTm : MeasurableSet T := MeasurableEquiv.prodAssoc.measurable hWy
  have hTμ : ((πr.prod πr).prod πr) T = (πr.prod (πr.prod πr)) {k | (y, k) ∈ W} :=
    (measurePreserving_prodAssoc πr πr πr).measure_preimage hWy.nullMeasurableSet
  rw [← hTμ, Measure.prod_apply_symm hTm] at hm
  have hmeas : Measurable fun c => (πr.prod πr) ((fun q => (q, c)) ⁻¹' T) :=
    measurable_measure_prodMk_right hTm
  rw [← integral_toReal hmeas.aemeasurable (Eventually.of_forall fun c => measure_lt_top _ _)]
    at hm
  have hint : Integrable (fun c => ((πr.prod πr) ((fun q => (q, c)) ⁻¹' T)).toReal) πr :=
    integrable_of_bdd_finite hmeas.ennreal_toReal (C := 1) fun c => by
      rw [abs_of_nonneg ENNReal.toReal_nonneg]
      exact ENNReal.toReal_le_of_le_ofReal zero_le_one
        (by rw [ENNReal.ofReal_one]; exact prob_le_one)
  obtain ⟨c, hc⟩ := exists_integral_le hint
  exact ⟨c, hm.trans hc⟩

end

/-! ### `patch:conditional-degree`, Steps 2-8 for a family of sections

The structured input of Step 5 is an explicit hypothesis; `Auto.cdl_abstract` returns the explicit
lower bound `Auto.cdlOut` of the blueprint's threshold paragraph. -/

section
open Filter Topology MeasureTheory

/-- Almost every point of the uniform triple cube has its last two blocks in `[0,H]^r`. -/
theorem ae_pi3_unifMeas_mem {H : ℝ} (r : ℕ) :
    ∀ᵐ k ∂((Measure.pi fun _ : Fin r => unifMeas H).prod
      ((Measure.pi fun _ : Fin r => unifMeas H).prod (Measure.pi fun _ : Fin r => unifMeas H))),
      (∀ i, k.2.1 i ∈ Set.Icc 0 H) ∧ (∀ i, k.2.2 i ∈ Set.Icc 0 H) := by
  have h1 := ae_pi_unifMeas_mem (H := H) r
  have hq : ∀ᵐ k ∂((Measure.pi fun _ : Fin r => unifMeas H).prod
      (Measure.pi fun _ : Fin r => unifMeas H)), (∀ i, k.1 i ∈ Set.Icc 0 H) ∧
        (∀ i, k.2 i ∈ Set.Icc 0 H) :=
    (Measure.quasiMeasurePreserving_fst.ae h1).and (Measure.quasiMeasurePreserving_snd.ae h1)
  exact Measure.quasiMeasurePreserving_snd.ae hq

theorem measurable_altPhase {r : ℕ} {Φ : (Fin r → ℝ) × (Fin r → ℝ) → ℝ} (hΦ : Measurable Φ) :
    Measurable (altPhase Φ) := by
  unfold altPhase
  refine Finset.measurable_sum _ fun ω _ => measurable_const.mul (hΦ.comp ?_)
  exact measurable_fst.prodMk ((measurable_cubeSel ω).comp
    (measurable_snd.fst.prodMk measurable_snd.snd))

theorem measurableSet_box_snd {H : ℝ} {r : ℕ} :
    MeasurableSet {k : (Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ) |
      (∀ i, k.2.1 i ∈ Set.Icc 0 H) ∧ (∀ i, k.2.2 i ∈ Set.Icc 0 H)} := by
  have h1 : {k : (Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ) |
      (∀ i, k.2.1 i ∈ Set.Icc 0 H) ∧ (∀ i, k.2.2 i ∈ Set.Icc 0 H)}
      = (⋂ i, (fun k : (Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ) => k.2.1 i) ⁻¹' Set.Icc 0 H)
        ∩ ⋂ i, (fun k : (Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ) => k.2.2 i) ⁻¹' Set.Icc 0 H := by
    ext k; simp
  rw [h1]
  exact (MeasurableSet.iInter fun i => (((measurable_pi_apply i).comp measurable_snd.fst)
    measurableSet_Icc)).inter (MeasurableSet.iInter fun i =>
      (((measurable_pi_apply i).comp measurable_snd.snd) measurableSet_Icc))

/-- The phases `α_i` of Step 7: `α_i = [i = 0] ζ - Σ_{ω ∈ Ω_i} (-1)^{|ω|} φ_y(a, b^ω)`, with the
last cube variable `c` fixed. -/
noncomputable def cdlAlpha {Y : Type*} {r : ℕ} (hr : 1 ≤ r)
    (φ : Y × ((Fin r → ℝ) × (Fin r → ℝ)) → ℝ) (y : Y) (c : Fin r → ℝ) (ζ : ℝ) (j : Fin r)
    (q : (Fin r → ℝ) × (Fin r → ℝ)) : ℝ :=
  (if j = ⟨0, hr⟩ then ζ else 0)
    - ∑ ω with vkey ω = some j, (-1) ^ numTrue ω * φ (y, (cubeSel ω q.2 c, q.1))

theorem cdlAlpha_update {Y : Type*} {r : ℕ} (hr : 1 ≤ r)
    (φ : Y × ((Fin r → ℝ) × (Fin r → ℝ)) → ℝ) (y : Y) (c : Fin r → ℝ) (ζ : ℝ) (j : Fin r)
    (a b : Fin r → ℝ) (β : ℝ) :
    cdlAlpha hr φ y c ζ j (a, Function.update b j β) = cdlAlpha hr φ y c ζ j (a, b) := by
  unfold cdlAlpha
  congr 1
  refine Finset.sum_congr rfl fun ω hω => ?_
  have hωi : ω j = true := vkey_eq_some (Finset.mem_filter.mp hω).2
  have hsel : cubeSel ω (Function.update b j β) c = cubeSel ω b c := by
    funext i
    by_cases hi : i = j
    · subst hi; simp [cubeSel, hωi]
    · simp [cubeSel, Function.update_of_ne hi]
  simp only [hsel]

theorem measurable_cdlAlpha {Y : Type*} [MeasurableSpace Y] {r : ℕ} (hr : 1 ≤ r)
    {φ : Y × ((Fin r → ℝ) × (Fin r → ℝ)) → ℝ} (hφ : Measurable φ) (y : Y) (c : Fin r → ℝ)
    (ζ : ℝ) (j : Fin r) : Measurable (cdlAlpha hr φ y c ζ j) := by
  unfold cdlAlpha
  refine measurable_const.sub (Finset.measurable_sum _ fun ω _ => measurable_const.mul
    (hφ.comp (measurable_const.prodMk (((measurable_cubeSel ω).comp
      (measurable_snd.prodMk measurable_const)).prodMk measurable_fst))))

/-- **The exact partition of the nonzero vertices** (Step 7):
`φ_y(a,b) - Σ_i α_i = ψ_y(a,b,c) - ζ`. -/
theorem cdlAlpha_sum {Y : Type*} {r : ℕ} (hr : 1 ≤ r)
    (φ : Y × ((Fin r → ℝ) × (Fin r → ℝ)) → ℝ) (y : Y) (c : Fin r → ℝ) (ζ : ℝ)
    (q : (Fin r → ℝ) × (Fin r → ℝ)) :
    φ (y, (q.2, q.1)) - ∑ j, cdlAlpha hr φ y c ζ j q = cdlPsi φ (y, (q.1, (q.2, c))) - ζ := by
  classical
  have hsplit := sum_vertices_split (fun ω : Fin r → Bool =>
    (-1 : ℝ) ^ numTrue ω * φ (y, (cubeSel ω q.2 c, q.1)))
  have hz : ∑ j : Fin r, (if j = ⟨0, hr⟩ then ζ else 0) = ζ := by
    rw [Finset.sum_ite_eq']; simp
  unfold cdlAlpha
  rw [Finset.sum_sub_distrib, hz, cdlPsi]
  simp only at hsplit ⊢
  rw [hsplit, numTrue_false, cubeSel_const_false]
  ring

set_option maxHeartbeats 2000000 in
-- The eight steps share their measurable sets and thresholds.
/-- **`patch:conditional-degree`, Steps 1-8 for a family of sections.** Let `F = E_t F_t` be a
jointly measurable one-bounded family of sections supported in `[c, c + S]` over a probability space
`Y`, and suppose its order-`(r+2)` powers average at least `a > 0`, `r ≥ 1`. If the structured
input of Step 5 holds (a lower bound `cdlThr` for `E_y |S⁻¹ ∫ G_{y,b,c}(z) e(ψ(y) z) dz|` forces
`μ{|ψ| ≤ B} ≥ ρ`, for every measurable `ψ` and shifts in `[0,H]^r`), then the order-`(r+1)` powers
average at least `cdlOut`. -/
theorem cdl_abstract {Ω : Type} [MeasurableSpace Ω] {ν : Measure Ω} [IsProbabilityMeasure ν]
    {Y : Type*} [MeasurableSpace Y] {μ : Measure Y} [IsProbabilityMeasure μ]
    {Ft : Ω → Y → ℝ → ℂ} (hFm : Measurable fun q : Ω × Y × ℝ => Ft q.1 q.2.1 q.2.2)
    (hF1 : ∀ t y z, ‖Ft t y z‖ ≤ 1) {c S H : ℝ} (hS : 0 < S) (hH : 0 < H)
    (hFs : ∀ t y z, z ∉ Set.Icc c (c + S) → Ft t y z = 0) {r : ℕ} (hr : 1 ≤ r)
    {a : ℝ} (ha : 0 < a)
    (hQ : a ≤ ∫ y, unifPow1 H S (r + 2) (fun z => ∫ t, Ft t y z ∂ν) ∂μ)
    {B ρ : ℝ} (hB : 0 < B) (hρ : 0 < ρ)
    (hMA : ∀ k : (Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ), (∀ i, k.2.1 i ∈ Set.Icc 0 H) →
      (∀ i, k.2.2 i ∈ Set.Icc 0 H) → ∀ ψ : Y → ℝ, Measurable ψ →
      cdlThr a H S r ≤ ∫ y, ‖cdlCoef S (cdlG ν Ft y k.2.1 k.2.2) (ψ y)‖ ∂μ →
      ρ ≤ (μ {y | |ψ y| ≤ B}).toReal) :
    cdlOut a H S c r B ρ ≤ ∫ y, unifPow1 H S (r + 1) (fun z => ∫ t, Ft t y z ∂ν) ∂μ := by
  classical
  have := isProbabilityMeasure_unifMeas hH
  set πr := Measure.pi fun _ : Fin r => unifMeas H with hπr
  set π3 := πr.prod (πr.prod πr) with hπ3
  -- the averaged family
  have hFF : Measurable (Function.uncurry fun (y : Y) (z : ℝ) => ∫ t, Ft t y z ∂ν) := by
    have hmap : Measurable fun p : (Y × ℝ) × Ω => ((p.2, p.1) : Ω × Y × ℝ) :=
      measurable_snd.prodMk measurable_fst
    have h := ((hFm.comp hmap).stronglyMeasurable.integral_prod_right' (ν := ν)).measurable
    exact h
  have hF1' : ∀ y z, ‖∫ t, Ft t y z ∂ν‖ ≤ 1 := fun y z => norm_integral_le_one fun t => hF1 _ _ _
  have hFs' : ∀ y z, z ∉ Set.Icc c (c + S) → ∫ t, Ft t y z ∂ν = 0 := fun y z hz => by
    rw [integral_congr_ae (Eventually.of_forall fun t => hFs t y z hz)]; simp
  have hFy : ∀ y, Measurable fun z => ∫ t, Ft t y z ∂ν := fun y => by
    have h := hFF.comp (measurable_prodMk_left (x := y))
    exact h
  -- the constants
  have hb0 : 0 < cdlB0 a H S := cdlB0_pos ha hH hS
  have hT : 0 < cdlT H S r := cdlT_pos hH hS r
  have hd : 0 < cdlD a H S r := cdlD_pos ha hH hS r
  have hz0 : 0 < cdlZ0 a H S r := cdlZ0_pos ha hH hS r
  have hΔ : 0 < cdlDelta a H S c r := cdlDelta_pos c ha hH hS r
  have hm0 : 0 < cdlM0 a H S c r B ρ := cdlM0_pos c ha hH hS r B hρ
  -- Step 1
  obtain ⟨φ, hφ, E, hE, hEcoef, hY1⟩ := cdl_step1 hFF hF1' hS hH hFs' r ha hQ
  have hEcoef' : ∀ p ∈ E, cdlB0 a H S < ‖cdlCoef S (fun z => cubeProdSel
      (fun β => ∫ t, Ft t p.1 (z + ∑ i, β i) ∂ν) p.2.1 p.2.2) (φ p)‖ := hEcoef
  set Y1 := {y | a / 4 ≤ ((πr.prod πr) {q | (y, q) ∈ E}).toReal} with hY1def
  have hY1m : MeasurableSet Y1 :=
    measurableSet_le measurable_const (measurable_measure_prodMk_left hE).ennreal_toReal
  -- Step 2
  set L := cdlL ν Ft S φ E with hLdef
  have hLm : Measurable L := measurable_cdlL hFm S hφ hE
  have hL01 : ∀ p, L p ∈ Set.Icc 0 1 := cdlL_mem_Icc hF1 hS hFs φ E
  have hstep2 : ∀ y ∈ Y1, cdlD a H S r ≤ ∫ k, L (y, k) ∂π3 := by
    intro y hy
    have h := cdl_step2 hFm hF1 hS hH hFs hr hφ hE hb0.le hEcoef' y (by positivity) hy
    have hTe : 0 < cdlT H S r ^ (2 * (2 ^ r - 1)) := by positivity
    rw [cdlD, div_le_iff₀ hTe]
    refine h.trans (le_of_eq ?_)
    rw [cdlT]
    ring
  -- the joint set `Z` and the popular shifts `K`
  set Z := {p : Y × ((Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ)) | cdlD a H S r / 2 ≤ L p}
    with hZdef
  have hZm : MeasurableSet Z := measurableSet_le measurable_const hLm
  have hZmass : cdlZ0 a H S r ≤ ((μ.prod π3) Z).toReal := by
    have h := measure_prod_popular_ge (μ := μ) (π := π3) hLm hL01 hY1m hd hstep2
    calc cdlZ0 a H S r = a / 4 * (cdlD a H S r / 2) := rfl
      _ ≤ (μ Y1).toReal * (cdlD a H S r / 2) :=
          mul_le_mul_of_nonneg_right hY1 (by positivity)
      _ ≤ _ := h
  have hZprop : ∀ p ∈ Z, p ∈ cdlBox E ∧ cdlD a H S r / 2
      ≤ ‖cdlCoef S (cdlG ν Ft p.1 p.2.2.1 p.2.2.2) (cdlPsi φ p)‖ ^ 2 := by
    intro p hp
    have hp' : cdlD a H S r / 2 ≤ L p := hp
    simp only [hLdef, cdlL] at hp'
    by_cases hb : p ∈ cdlBox E
    · rw [Set.indicator_of_mem hb, one_mul] at hp'
      exact ⟨hb, hp'⟩
    · rw [Set.indicator_of_notMem hb, zero_mul] at hp'
      linarith
  set K := {k : (Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ) |
    cdlZ0 a H S r / 2 ≤ (μ {y | (y, k) ∈ Z}).toReal} with hKdef
  have hKm : MeasurableSet K :=
    measurableSet_le measurable_const (measurable_measure_prodMk_right hZm).ennreal_toReal
  have hKmass : cdlZ0 a H S r / 2 ≤ (π3 K).toReal :=
    measure_popular_sections_right hZm hz0 hZmass
  -- Step 4: the dummy phase
  obtain ⟨Φ, hΦm, hΦ⟩ := exists_dummy_phase (r := r) hr hH (M := B + 1)
    (ε := min (cdlZ0 a H S r / 4) (1 / 2)) (by linarith) (lt_min (by positivity) (by norm_num))
    (lt_of_le_of_lt (min_le_right _ _) (by norm_num))
  set Exc := {k : (Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ) | |altPhase Φ k| ≤ B + 1} with hExc
  have hExcm : MeasurableSet Exc :=
    measurableSet_le (continuous_abs.measurable.comp (measurable_altPhase hΦm)) measurable_const
  have hExcμ : (π3 Exc).toReal ≤ cdlZ0 a H S r / 4 := by
    have h1 : π3 Exc ≤ ENNReal.ofReal (min (cdlZ0 a H S r / 4) (1 / 2)) := hΦ
    have h2 := ENNReal.toReal_mono ENNReal.ofReal_ne_top h1
    rw [ENNReal.toReal_ofReal (le_min (by positivity) (by norm_num))] at h2
    exact h2.trans (min_le_left _ _)
  set ψs : Y × ((Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ)) → ℝ := fun p =>
    if p ∈ Z then cdlPsi φ p else altPhase Φ p.2 with hψs
  have hψsm : Measurable ψs :=
    Measurable.ite hZm (measurable_cdlPsi hφ) ((measurable_altPhase hΦm).comp measurable_snd)
  have hGk : ∀ k : (Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ),
      Measurable (Function.uncurry fun (y : Y) (z : ℝ) => cdlG ν Ft y k.2.1 k.2.2 z) := by
    intro k
    have hmap : Measurable fun q : Y × ℝ =>
        (((q.1, (k.2.1, k.2.2)) : Y × ((Fin r → ℝ) × (Fin r → ℝ))), q.2) :=
      (measurable_fst.prodMk measurable_const).prodMk measurable_snd
    have h := (measurable_cdlG (ν := ν) hFm r).comp hmap
    exact h
  have hthr : ∀ k ∈ K, cdlThr a H S r
      ≤ ∫ y, ‖cdlCoef S (cdlG ν Ft y k.2.1 k.2.2) (ψs (y, k))‖ ∂μ := by
    intro k hk
    have hgm : Measurable fun y => ‖cdlCoef S (cdlG ν Ft y k.2.1 k.2.2) (ψs (y, k))‖ := by
      have hψk : Measurable fun y => ψs (y, k) := by
        have h := hψsm.comp (measurable_id.prodMk (measurable_const (a := k)))
        exact h
      have h := ((measurable_coef_param (hGk k) hψk).const_mul ((S : ℂ)⁻¹)).norm
      exact h
    have hg1 : ∀ y, ‖cdlCoef S (cdlG ν Ft y k.2.1 k.2.2) (ψs (y, k))‖ ≤ 1 := fun y =>
      norm_cdlCoef_le hS (norm_cdlG_le hF1 _ _ _) (cdlG_eq_zero hFs _ _ _) _
    have hgi : Integrable (fun y => ‖cdlCoef S (cdlG ν Ft y k.2.1 k.2.2) (ψs (y, k))‖) μ :=
      integrable_of_bdd_finite hgm (C := 1) fun y => by
        rw [abs_of_nonneg (norm_nonneg _)]; exact hg1 y
    have hZk : MeasurableSet {y | (y, k) ∈ Z} := measurable_prodMk_right hZm
    have hon : ∀ y ∈ {y | (y, k) ∈ Z}, Real.sqrt (cdlD a H S r / 2)
        ≤ ‖cdlCoef S (cdlG ν Ft y k.2.1 k.2.2) (ψs (y, k))‖ := by
      intro y hy
      have hp := (hZprop (y, k) hy).2
      have hψe : ψs (y, k) = cdlPsi φ (y, k) :=
        by simp only [hψs, ite_eq_left (show (y, k) ∈ Z from hy)]
      rw [hψe]
      calc Real.sqrt (cdlD a H S r / 2)
          ≤ Real.sqrt (‖cdlCoef S (cdlG ν Ft y k.2.1 k.2.2) (cdlPsi φ (y, k))‖ ^ 2) :=
            Real.sqrt_le_sqrt hp
        _ = _ := Real.sqrt_sq (norm_nonneg _)
    calc cdlThr a H S r = cdlZ0 a H S r / 2 * Real.sqrt (cdlD a H S r / 2) := rfl
      _ ≤ (μ {y | (y, k) ∈ Z}).toReal * Real.sqrt (cdlD a H S r / 2) :=
          mul_le_mul_of_nonneg_right hk (Real.sqrt_nonneg _)
      _ = ∫ y in {y | (y, k) ∈ Z}, Real.sqrt (cdlD a H S r / 2) ∂μ := by
          rw [setIntegral_const_real]
      _ ≤ ∫ y in {y | (y, k) ∈ Z}, ‖cdlCoef S (cdlG ν Ft y k.2.1 k.2.2) (ψs (y, k))‖ ∂μ :=
          setIntegral_mono_on (integrable_const _).integrableOn hgi.integrableOn hZk hon
      _ ≤ _ := setIntegral_le_integral hgi (Eventually.of_forall fun y => norm_nonneg _)
  -- Step 5 and Step 6: the useful small-phase points
  set W := {p : Y × ((Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ)) | p ∈ Z ∧ |cdlPsi φ p| ≤ B}
    with hWdef
  have hWm : MeasurableSet W :=
    hZm.inter (measurableSet_le (continuous_abs.measurable.comp (measurable_cdlPsi hφ))
      measurable_const)
  set Box := {k : (Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ) |
    (∀ i, k.2.1 i ∈ Set.Icc 0 H) ∧ (∀ i, k.2.2 i ∈ Set.Icc 0 H)} with hBox
  have hBoxm : MeasurableSet Box := measurableSet_box_snd
  set Kg := (K \ Exc) ∩ Box with hKg
  have hKgm : MeasurableSet Kg := (hKm.diff hExcm).inter hBoxm
  have hKgmass : cdlZ0 a H S r / 4 ≤ (π3 Kg).toReal := by
    have h1 : π3 Kg = π3 (K \ Exc) := by
      rw [hKg, Set.inter_comm]
      exact Measure.measure_inter_eq_of_ae (ae_pi3_unifMeas_mem r)
    have h2 : π3 K ≤ π3 (K \ Exc) + π3 Exc :=
      (measure_mono (Set.subset_sdiff_union K Exc)).trans (measure_union_le _ _)
    have h3 := ENNReal.toReal_mono (ENNReal.add_ne_top.mpr ⟨measure_ne_top _ _,
      measure_ne_top _ _⟩) h2
    rw [ENNReal.toReal_add (measure_ne_top _ _) (measure_ne_top _ _)] at h3
    rw [h1]
    linarith
  have hWsec : ∀ k ∈ Kg, ρ ≤ (μ {y | (y, k) ∈ W}).toReal := by
    intro k hk
    obtain ⟨⟨hkK, hkE⟩, hkB⟩ := hk
    have h := hMA k hkB.1 hkB.2 (fun y => ψs (y, k)) (by
      have h := hψsm.comp (measurable_id.prodMk (measurable_const (a := k)))
      exact h) (hthr k hkK)
    refine h.trans (ENNReal.toReal_mono (measure_ne_top _ _) (measure_mono fun y hy => ?_))
    simp only [Set.mem_ofPred_eq] at hy ⊢
    by_cases hyZ : (y, k) ∈ Z
    · refine ⟨hyZ, ?_⟩
      simpa only [hψs, ite_eq_left hyZ] using hy
    · exfalso
      simp only [hψs, ite_eq_right hyZ] at hy
      exact hkE (show |altPhase Φ k| ≤ B + 1 by linarith)
  have hWmass : cdlZ0 a H S r / 4 * ρ ≤ ((μ.prod π3) W).toReal :=
    (mul_le_mul_of_nonneg_right hKgmass hρ.le).trans
      (measure_prod_ge_of_sections hWm hKgm hWsec)
  -- Step 7: a heavy frequency cell and a popular set of sections
  obtain ⟨ζ, W', hW'm, hW'W, hW'close, hW'mass⟩ := exists_heavy_cell (μ := μ.prod π3) hWm
    (measurable_cdlPsi hφ) hΔ (fun p hp => hp.2)
  have hW'm0 : cdlM0 a H S c r B ρ ≤ ((μ.prod π3) W').toReal := by
    refine le_trans ?_ hW'mass
    rw [cdlM0]
    exact div_le_div_of_nonneg_right hWmass (by positivity)
  set Y2 := {y | cdlM0 a H S c r B ρ / 2 ≤ (π3 {k | (y, k) ∈ W'}).toReal} with hY2
  have hY2m : MeasurableSet Y2 :=
    measurableSet_le measurable_const (measurable_measure_prodMk_left hW'm).ennreal_toReal
  have hY2mass : cdlM0 a H S c r B ρ / 2 ≤ (μ Y2).toReal :=
    measure_popular_sections_left hW'm hm0 hW'm0
  -- Step 8 on each popular section
  have hstep8 : ∀ y ∈ Y2, ((cdlB0 a H S / 2) ^ 2 * (cdlM0 a H S c r B ρ / 2)) ^ (2 ^ r)
      ≤ cdlT H S r ^ (2 * (2 ^ r - 1))
        * ((1 + H / S) * unifPow1 H S (r + 1) (fun z => ∫ t, Ft t y z ∂ν)) := by
    intro y hy
    obtain ⟨c₀, hc₀⟩ := exists_section_last hH hW'm y hy
    set A0 := {q : (Fin r → ℝ) × (Fin r → ℝ) | (y, (q.1, (q.2, c₀))) ∈ W'} with hA0
    have hA0m : MeasurableSet A0 := by
      have hm : Measurable fun q : (Fin r → ℝ) × (Fin r → ℝ) =>
          ((y, (q.1, (q.2, c₀))) : Y × ((Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ))) :=
        measurable_const.prodMk (measurable_fst.prodMk (measurable_snd.prodMk measurable_const))
      exact hm hW'm
    set Bx := {q : (Fin r → ℝ) × (Fin r → ℝ) | ∀ i, q.2 i ∈ Set.Icc 0 H} with hBx
    have hBxm : MeasurableSet Bx := by
      have : Bx = ⋂ i, (fun q : (Fin r → ℝ) × (Fin r → ℝ) => q.2 i) ⁻¹' Set.Icc 0 H := by
        ext q; simp [hBx]
      rw [this]
      exact MeasurableSet.iInter fun i =>
        ((measurable_pi_apply i).comp measurable_snd) measurableSet_Icc
    have hBxae : ∀ᵐ q ∂(πr.prod πr), q ∈ Bx :=
      Measure.quasiMeasurePreserving_snd.ae (ae_pi_unifMeas_mem (H := H) r)
    have hAmass : cdlM0 a H S c r B ρ / 2 ≤ ((πr.prod πr) (A0 ∩ Bx)).toReal := by
      rw [Set.inter_comm, Measure.measure_inter_eq_of_ae hBxae]; exact hc₀
    have hT' : cdlT H S r = (S + r * H) / S := rfl
    rw [hT']
    refine cdl_step8 hr hS hH (hFy y) (hF1' y) (hFs' y) (Δ := cdlDelta a H S c r)
      (Z := |c| + S + r * H) (α := cdlAlpha hr φ y c₀ ζ)
      (fun j => measurable_cdlAlpha hr hφ y c₀ ζ j)
      (fun j a' b β => cdlAlpha_update hr φ y c₀ ζ j a' b β) (φ := fun q => φ (y, (q.2, q.1)))
      (hA0m.inter hBxm) (by positivity) (cdlB0_pos ha hH hS).le hAmass
      (fun q hq => hq.2) (fun q hq => ?_) (fun q hq => ?_) le_rfl ?_
    · have hZq := hW'W hq.1
      have hbox := (hZprop _ hZq.1).1 (fun _ => false)
      simp only [cubeSel_const_false] at hbox
      have h := hEcoef' _ hbox
      exact h
    · rw [cdlAlpha_sum]
      exact hW'close _ hq.1
    · rw [cdlDelta]
      have hZ0 : 0 < |c| + S + r * H := by positivity
      field_simp
      exact le_rfl
  -- the final integration
  have hQm : Measurable fun y => unifPow1 H S (r + 1) (fun z => ∫ t, Ft t y z ∂ν) :=
    measurable_unifPow1_param hFF H S (r + 1)
  have hQ01 : ∀ y, unifPow1 H S (r + 1) (fun z => ∫ t, Ft t y z ∂ν) ∈ Set.Icc 0 1 :=
    fun y => unifPow1_mem_Icc hH hS (hFy y) (hF1' y) (hFs' y) r
  have hQi : Integrable (fun y => unifPow1 H S (r + 1) (fun z => ∫ t, Ft t y z ∂ν)) μ :=
    integrable_of_bdd_finite hQm (C := 1) fun y => by
      rw [abs_of_nonneg (hQ01 y).1]; exact (hQ01 y).2
  set out8 := ((cdlB0 a H S / 2) ^ 2 * (cdlM0 a H S c r B ρ / 2)) ^ (2 ^ r)
    / (cdlT H S r ^ (2 * (2 ^ r - 1)) * (1 + H / S)) with hout8
  have hden : 0 < cdlT H S r ^ (2 * (2 ^ r - 1)) * (1 + H / S) := by positivity
  have hon : ∀ y ∈ Y2, out8 ≤ unifPow1 H S (r + 1) (fun z => ∫ t, Ft t y z ∂ν) := by
    intro y hy
    rw [hout8, div_le_iff₀ hden]
    have := hstep8 y hy
    calc _ ≤ _ := this
      _ = _ := by ring
  calc cdlOut a H S c r B ρ = cdlM0 a H S c r B ρ / 2 * out8 := rfl
    _ ≤ (μ Y2).toReal * out8 := mul_le_mul_of_nonneg_right hY2mass (by positivity)
    _ = ∫ y in Y2, out8 ∂μ := by rw [setIntegral_const_real]
    _ ≤ ∫ y in Y2, unifPow1 H S (r + 1) (fun z => ∫ t, Ft t y z ∂ν) ∂μ :=
        setIntegral_mono_on (integrable_const _).integrableOn hQi.integrableOn hY2m hon
    _ ≤ _ := setIntegral_le_integral hQi (Eventually.of_forall fun y => (hQ01 y).1)

end

/-! ### Slab Fubini along a coordinate direction -/

section
open Filter Topology MeasureTheory

/-- The projection `π_j y = y - y_j e_j` onto the hyperplane `x_j = 0`. -/
noncomputable def projOff (j : Fin 3) (y : E3) : E3 := y - (y j) • basisVec j

theorem projOff_apply_self (j : Fin 3) (y : E3) : projOff j y j = 0 := by
  simp [projOff, basisVec_apply_self]

theorem projOff_apply_ne {j i : Fin 3} (h : i ≠ j) (y : E3) : projOff j y i = y i := by
  simp [projOff, basisVec_apply_ne h]

theorem projOff_add_smul (j : Fin 3) (y : E3) (z : ℝ) :
    projOff j (y + z • basisVec j) = projOff j y := by
  simp only [projOff, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, basisVec_apply_self,
    mul_one, add_smul]
  abel

theorem projOff_sub_smul_ne {j i : Fin 3} (h : i ≠ j) (y : E3) (s : ℝ) :
    projOff j (y - s • basisVec i) = projOff j y - s • basisVec i := by
  simp only [projOff, PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, basisVec_apply_ne h.symm,
    mul_zero, sub_zero]
  abel

theorem projOff_add_self (j : Fin 3) (y : E3) : projOff j y + (y j) • basisVec j = y := by
  simp [projOff]

theorem continuous_projOff (j : Fin 3) : Continuous (projOff j) := by
  unfold projOff
  exact continuous_id.sub ((continuous_apply j |>.comp (PiLp.continuous_ofLp 2 _)).smul
    continuous_const)

theorem measurable_projOff (j : Fin 3) : Measurable (projOff j) :=
  (continuous_projOff j).measurable

/-- **Slab Fubini**: integrating over `ℝ³` is integrating the lines in the direction `e_j` over the
slab `{y_j ∈ [0,1]}` of unit thickness. -/
theorem lintegral_slab (j : Fin 3) {g : E3 → ℝ≥0∞} (hg : Measurable g) :
    ∫⁻ x, g x = ∫⁻ y, Set.indicator (Set.Icc (0 : ℝ) 1) (fun _ => (1 : ℝ≥0∞)) (y j)
      * ∫⁻ z : ℝ, g (projOff j y + z • basisVec j) := by
  have hcj : Continuous fun x : E3 => x j := continuous_coord j
  have hind : Measurable fun s : ℝ => Set.indicator (Set.Icc (0 : ℝ) 1) (fun _ => (1 : ℝ≥0∞)) s :=
    measurable_const.indicator measurableSet_Icc
  -- step 1: recentre each line at `y`
  have h1 : ∀ y : E3, ∫⁻ z : ℝ, g (projOff j y + z • basisVec j)
      = ∫⁻ z : ℝ, g (y + z • basisVec j) := by
    intro y
    have h := lintegral_add_right_eq_self (μ := (volume : Measure ℝ))
      (fun z : ℝ => g (projOff j y + z • basisVec j)) (y j)
    rw [← h]
    refine lintegral_congr fun z => ?_
    congr 1
    conv_rhs => rw [← projOff_add_self j y]
    rw [add_smul]
    abel
  simp_rw [h1]
  set ind : ℝ → ℝ≥0∞ := Set.indicator (Set.Icc (0 : ℝ) 1) (fun _ => (1 : ℝ≥0∞)) with hind'
  have hgz : ∀ y : E3, Measurable fun z : ℝ => g (y + z • basisVec j) := fun y =>
    hg.comp (measurable_const.add (measurable_id.smul measurable_const))
  simp_rw [← lintegral_const_mul _ (hgz _)]
  have hm : Measurable (Function.uncurry fun (y : E3) (z : ℝ) =>
      ind (y j) * g (y + z • basisVec j)) :=
    (hind.comp (hcj.measurable.comp measurable_fst)).mul
      (hg.comp (measurable_fst.add (measurable_snd.smul measurable_const)))
  rw [lintegral_lintegral_swap hm.aemeasurable]
  have h2 : ∀ z : ℝ, ∫⁻ y, ind (y j) * g (y + z • basisVec j) = ∫⁻ x, ind (x j - z) * g x := by
    intro z
    have h := lintegral_add_right_eq_self (μ := (volume : Measure E3))
      (fun x : E3 => ind (x j - z) * g x) (z • basisVec j)
    rw [← h]
    refine lintegral_congr fun y => ?_
    simp [basisVec_apply_self]
  simp_rw [h2]
  have hm2 : Measurable (Function.uncurry fun (z : ℝ) (x : E3) => ind (x j - z) * g x) :=
    (hind.comp ((hcj.measurable.comp measurable_snd).sub measurable_fst)).mul
      (hg.comp measurable_snd)
  rw [lintegral_lintegral_swap hm2.aemeasurable]
  refine lintegral_congr fun x => ?_
  have hmz : Measurable fun z : ℝ => ind (x j - z) := hind.comp (measurable_const.sub measurable_id)
  rw [lintegral_mul_const _ hmz]
  have h3 : ∫⁻ z : ℝ, ind (x j - z) = 1 := by
    have h := lintegral_sub_left_eq_self (μ := (volume : Measure ℝ)) ind (x j)
    rw [h, hind', lintegral_indicator measurableSet_Icc, setLIntegral_const, Real.volume_Icc]
    simp
  rw [h3, one_mul]

/-- **Slab Fubini** for integrable functions. -/
theorem integral_slab (j : Fin 3) {g : E3 → ℂ} (hgm : Measurable g) (hgi : Integrable g) :
    ∫ x, g x = ∫ y, (Set.indicator (Set.Icc (0 : ℝ) 1) (fun _ => (1 : ℂ)) (y j))
      * ∫ z : ℝ, g (projOff j y + z • basisVec j) := by
  have hcj : Continuous fun x : E3 => x j := continuous_coord j
  set ind : ℝ → ℂ := Set.indicator (Set.Icc (0 : ℝ) 1) (fun _ => (1 : ℂ)) with hind'
  have hindm : Measurable ind := measurable_const.indicator measurableSet_Icc
  have hind1 : ∀ s, ‖ind s‖ ≤ 1 := fun s => by
    simp only [hind']
    by_cases h : s ∈ Set.Icc (0 : ℝ) 1
    · simp [Set.indicator_of_mem h]
    · simp [Set.indicator_of_notMem h]
  have hindE : ∀ s, ‖ind s‖ₑ = Set.indicator (Set.Icc (0 : ℝ) 1) (fun _ => (1 : ℝ≥0∞)) s :=
      fun s => by
    simp only [hind']
    by_cases h : s ∈ Set.Icc (0 : ℝ) 1
    · simp [Set.indicator_of_mem h]
    · simp [Set.indicator_of_notMem h]
  -- recentre each line
  have h1 : ∀ y : E3, ∫ z : ℝ, g (projOff j y + z • basisVec j)
      = ∫ z : ℝ, g (y + z • basisVec j) := by
    intro y
    have h := integral_add_right_eq_self (μ := (volume : Measure ℝ))
      (fun z : ℝ => g (projOff j y + z • basisVec j)) (y j)
    rw [← h]
    refine integral_congr_ae (Eventually.of_forall fun z => ?_)
    beta_reduce
    congr 1
    conv_rhs => rw [← projOff_add_self j y]
    rw [add_smul]
    abel
  simp_rw [h1, ← integral_const_mul]
  -- integrability of the two exchanges
  have hm : Measurable (Function.uncurry fun (y : E3) (z : ℝ) =>
      ind (y j) * g (y + z • basisVec j)) :=
    (hindm.comp (hcj.measurable.comp measurable_fst)).mul
      (hgm.comp (measurable_fst.add (measurable_snd.smul measurable_const)))
  have hfin : ∫⁻ x, ‖g x‖ₑ < ⊤ := hgi.hasFiniteIntegral
  have hi1 : Integrable (Function.uncurry fun (y : E3) (z : ℝ) =>
      ind (y j) * g (y + z • basisVec j))
      ((volume : Measure E3).prod (volume : Measure ℝ)) := by
    refine ⟨hm.aestronglyMeasurable, ?_⟩
    have hgE : Measurable fun x => ‖g x‖ₑ := hgm.enorm
    have hslab := lintegral_slab j hgE
    change ∫⁻ p : E3 × ℝ, ‖ind (p.1 j) * g (p.1 + p.2 • basisVec j)‖ₑ
        ∂((volume : Measure E3).prod volume) < ⊤
    have hae : AEMeasurable (fun p : E3 × ℝ => ‖ind (p.1 j) * g (p.1 + p.2 • basisVec j)‖ₑ)
        ((volume : Measure E3).prod volume) := hm.enorm.aemeasurable
    rw [lintegral_prod _ hae]
    simp_rw [enorm_mul, hindE]
    have hgz : ∀ y : E3, Measurable fun z : ℝ => ‖g (y + z • basisVec j)‖ₑ := fun y =>
      hgE.comp (measurable_const.add (measurable_id.smul measurable_const))
    simp_rw [lintegral_const_mul _ (hgz _)]
    have h1' : ∀ y : E3, ∫⁻ z : ℝ, ‖g (y + z • basisVec j)‖ₑ
        = ∫⁻ z : ℝ, ‖g (projOff j y + z • basisVec j)‖ₑ := by
      intro y
      have h := lintegral_add_right_eq_self (μ := (volume : Measure ℝ))
        (fun z : ℝ => ‖g (projOff j y + z • basisVec j)‖ₑ) (y j)
      rw [← h]
      refine lintegral_congr fun z => ?_
      congr 2
      conv_lhs => rw [← projOff_add_self j y]
      rw [add_smul]
      abel
    calc ∫⁻ y, Set.indicator (Set.Icc (0 : ℝ) 1) (fun _ => (1 : ℝ≥0∞)) (y j)
          * ∫⁻ z : ℝ, ‖g (y + z • basisVec j)‖ₑ
        = ∫⁻ y, Set.indicator (Set.Icc (0 : ℝ) 1) (fun _ => (1 : ℝ≥0∞)) (y j)
          * ∫⁻ z : ℝ, ‖g (projOff j y + z • basisVec j)‖ₑ :=
          lintegral_congr fun y => by rw [h1' y]
      _ = ∫⁻ x, ‖g x‖ₑ := hslab.symm
      _ < ⊤ := hfin
  rw [integral_integral_swap hi1]
  have h2 : ∀ z : ℝ, ∫ y, ind (y j) * g (y + z • basisVec j) = ∫ x, ind (x j - z) * g x := by
    intro z
    have h := integral_add_right_eq_self (μ := (volume : Measure E3))
      (fun x : E3 => ind (x j - z) * g x) (z • basisVec j)
    rw [← h]
    refine integral_congr_ae (Eventually.of_forall fun y => ?_)
    simp [basisVec_apply_self]
  simp_rw [h2]
  have hm2 : Measurable (Function.uncurry fun (z : ℝ) (x : E3) => ind (x j - z) * g x) :=
    (hindm.comp ((hcj.measurable.comp measurable_snd).sub measurable_fst)).mul
      (hgm.comp measurable_snd)
  have hi2 : Integrable (Function.uncurry fun (z : ℝ) (x : E3) => ind (x j - z) * g x)
      ((volume : Measure ℝ).prod (volume : Measure E3)) := by
    refine ⟨hm2.aestronglyMeasurable, ?_⟩
    change ∫⁻ p : ℝ × E3, ‖ind (p.2 j - p.1) * g p.2‖ₑ ∂((volume : Measure ℝ).prod volume) < ⊤
    have hae : AEMeasurable (fun p : ℝ × E3 => ‖ind (p.2 j - p.1) * g p.2‖ₑ)
        ((volume : Measure ℝ).prod volume) := hm2.enorm.aemeasurable
    rw [lintegral_prod_symm _ hae]
    simp_rw [enorm_mul, hindE]
    have hmz : ∀ x : E3, Measurable fun z : ℝ =>
        Set.indicator (Set.Icc (0 : ℝ) 1) (fun _ => (1 : ℝ≥0∞)) (x j - z) := fun x =>
      (measurable_const.indicator measurableSet_Icc).comp (measurable_const.sub measurable_id)
    simp_rw [lintegral_mul_const _ (hmz _)]
    have h3 : ∀ x : E3, ∫⁻ z : ℝ, Set.indicator (Set.Icc (0 : ℝ) 1) (fun _ => (1 : ℝ≥0∞))
        (x j - z) = 1 := by
      intro x
      have h := lintegral_sub_left_eq_self (μ := (volume : Measure ℝ))
        (Set.indicator (Set.Icc (0 : ℝ) 1) (fun _ => (1 : ℝ≥0∞))) (x j)
      rw [h, lintegral_indicator measurableSet_Icc, setLIntegral_const, Real.volume_Icc]
      simp
    simp_rw [h3, one_mul]
    exact hfin
  rw [integral_integral_swap hi2]
  refine integral_congr_ae (Eventually.of_forall fun x => ?_)
  beta_reduce
  rw [integral_mul_const]
  have h4 : ∫ z : ℝ, ind (x j - z) = 1 := by
    have h := integral_sub_left_eq_self (μ := (volume : Measure ℝ)) ind (x j)
    rw [h, hind', integral_indicator measurableSet_Icc, setIntegral_const]
    simp
  rw [h4, one_mul]

end

section
open Filter Topology MeasureTheory

/-- The point of `ℝ³` with coordinate `z` in the direction `m` and transverse coordinates `y`. -/
noncomputable def embT (m : Fin 3) (y : Fin 2 → ℝ) (z : ℝ) : E3 :=
  MeasurableEquiv.toLp 2 (Fin 3 → ℝ) (Fin.insertNth m z y)

theorem embT_apply_self (m : Fin 3) (y : Fin 2 → ℝ) (z : ℝ) : embT m y z m = z := by
  simp [embT]

theorem embT_apply_succAbove (m : Fin 3) (y : Fin 2 → ℝ) (z : ℝ) (i : Fin 2) :
    embT m y z (m.succAbove i) = y i := by
  simp [embT]

theorem embT_add_smul (m : Fin 3) (y : Fin 2 → ℝ) (z s : ℝ) :
    embT m y z + s • basisVec m = embT m y (z + s) := by
  ext i
  rcases Fin.eq_self_or_eq_succAbove m i with h | ⟨i', rfl⟩
  · subst h
    simp [embT_apply_self, basisVec_apply_self]
  · simp [embT_apply_succAbove, basisVec_apply_ne (Fin.succAbove_ne m i')]

theorem measurable_embT (m : Fin 3) : Measurable fun p : (Fin 2 → ℝ) × ℝ => embT m p.1 p.2 := by
  unfold embT
  exact (MeasurableEquiv.toLp 2 (Fin 3 → ℝ)).measurable.comp
    ((MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) m).symm.measurable.comp
      (measurable_snd.prodMk measurable_fst))

/-- The coordinates `(x_m, x_{≠m})` of `ℝ³`. -/
noncomputable def splitT (m : Fin 3) : E3 ≃ᵐ ℝ × (Fin 2 → ℝ) :=
  (MeasurableEquiv.toLp 2 (Fin 3 → ℝ)).symm.trans
    (MeasurableEquiv.piFinSuccAbove (fun _ => ℝ) m)

theorem measurePreserving_splitT (m : Fin 3) :
    MeasurePreserving (splitT m) (volume : Measure E3) (volume : Measure (ℝ × (Fin 2 → ℝ))) := by
  have h1 := EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 3)
  have h2 := measurePreserving_piFinSuccAbove (fun _ : Fin 3 => (volume : Measure ℝ)) m
  rw [← volume_pi] at h2
  exact h2.comp h1

theorem splitT_symm_apply (m : Fin 3) (p : ℝ × (Fin 2 → ℝ)) :
    (splitT m).symm p = embT m p.2 p.1 := by
  rfl

/-- **Transverse Fubini**: integrating over `ℝ³` is integrating the lines in the direction `e_m`
over the transverse plane. -/
theorem integral_embT (m : Fin 3) {g : E3 → ℂ} (hgi : Integrable g) :
    ∫ x, g x = ∫ y : Fin 2 → ℝ, ∫ z : ℝ, g (embT m y z) := by
  have hmp := measurePreserving_splitT m
  have h1 : ∫ x, g x = ∫ p : ℝ × (Fin 2 → ℝ), g (embT m p.2 p.1) := by
    rw [← hmp.integral_comp (splitT m).measurableEmbedding]
    refine integral_congr_ae (Eventually.of_forall fun x => ?_)
    beta_reduce
    rw [← splitT_symm_apply, MeasurableEquiv.symm_apply_apply]
  have hint : Integrable (fun p : ℝ × (Fin 2 → ℝ) => g (embT m p.2 p.1))
      ((volume : Measure ℝ).prod (volume : Measure (Fin 2 → ℝ))) := by
    rw [← Measure.volume_eq_prod]
    have := (hmp.symm).integrable_comp_emb (splitT m).symm.measurableEmbedding |>.mpr hgi
    exact this
  rw [h1, Measure.volume_eq_prod, integral_prod_symm _ hint]

theorem lintegral_embT (m : Fin 3) {g : E3 → ℝ≥0∞} (hg : Measurable g) :
    ∫⁻ x, g x = ∫⁻ y : Fin 2 → ℝ, ∫⁻ z : ℝ, g (embT m y z) := by
  have hmp := measurePreserving_splitT m
  have h1 : ∫⁻ x, g x = ∫⁻ p : ℝ × (Fin 2 → ℝ), g (embT m p.2 p.1) := by
    rw [← hmp.lintegral_comp_emb (splitT m).measurableEmbedding]
    refine lintegral_congr fun x => ?_
    rw [← splitT_symm_apply, MeasurableEquiv.symm_apply_apply]
  have hae : AEMeasurable (fun p : ℝ × (Fin 2 → ℝ) => g (embT m p.2 p.1))
      ((volume : Measure ℝ).prod (volume : Measure (Fin 2 → ℝ))) :=
    (hg.comp ((measurable_embT m).comp (measurable_snd.prodMk measurable_fst))).aemeasurable
  rw [h1, Measure.volume_eq_prod, lintegral_prod_symm _ hae]

end

section
open Filter Topology MeasureTheory

/-- The paired cube multiplies: `D(AB) = D(A) D(B)`. -/
theorem cubeProdSel_mul {B : Type*} {r : ℕ} (v w : (Fin r → B) → ℂ) (b c : Fin r → B) :
    cubeProdSel (fun β => v β * w β) b c = cubeProdSel v b c * cubeProdSel w b c := by
  unfold cubeProdSel
  rw [← Finset.prod_mul_distrib]
  exact Finset.prod_congr rfl fun ω _ => conjPar_mul _ _ _

theorem cubeProdSel_prod {B ι : Type*} {r : ℕ} (s : Finset ι) (v : ι → (Fin r → B) → ℂ)
    (b c : Fin r → B) :
    cubeProdSel (fun β => ∏ i ∈ s, v i β) b c = ∏ i ∈ s, cubeProdSel (v i) b c := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [cubeProdSel, conjPar_one_val]
  | insert i s hi ih =>
    simp_rw [Finset.prod_insert hi]
    rw [cubeProdSel_mul, ih]

/-- The paired cube of a phase is the phase of the alternating sum. -/
theorem cubeProdSel_ephase {B : Type*} {r : ℕ} (φ : (Fin r → B) → ℝ) (b c : Fin r → B) :
    cubeProdSel (fun β => ephase (φ β)) b c
      = ephase (∑ ω : Fin r → Bool, (-1) ^ numTrue ω * φ (cubeSel ω b c)) := by
  unfold cubeProdSel
  rw [ephase_sum]
  exact Finset.prod_congr rfl fun ω _ => conjPar_ephase _ _

/-- For `r ≥ 1` the signs of the vertices cancel: `Σ_ω (-1)^{|ω|} = 0`. -/
theorem sum_neg_one_pow_numTrue {r : ℕ} (hr : 1 ≤ r) :
    ∑ ω : Fin r → Bool, (-1 : ℝ) ^ numTrue ω = 0 := by
  have h := sum_neg_one_pow_prod_cubeSel (r := r) (fun _ => 1) (fun _ => 1)
  have e1 : ∀ ω : Fin r → Bool, ∏ i, cubeSel ω (fun _ : Fin r => (1 : ℝ)) (fun _ => 1) i = 1 := by
    intro ω; exact Finset.prod_eq_one fun i _ => by simp [cubeSel]
  simp_rw [e1, mul_one] at h
  rw [h]
  obtain ⟨n, rfl⟩ : ∃ n, r = n + 1 := ⟨r - 1, by omega⟩
  rw [Fin.prod_univ_succ]
  simp

/-- The paired cube of `f` along the direction `v` at the shifts `(b, c)`. -/
noncomputable def dirCube {r : ℕ} (f : E3 → ℂ) (v : E3) (b c : Fin r → ℝ) (x : E3) : ℂ :=
  cubeProdSel (fun β => f (x + (∑ i, β i) • v)) b c

theorem norm_dirCube_le {r : ℕ} {f : E3 → ℂ} (hf1 : ∀ x, ‖f x‖ ≤ 1) (v : E3) (b c : Fin r → ℝ)
    (x : E3) : ‖dirCube f v b c x‖ ≤ 1 :=
  norm_cubeProdSel_le (fun _ => hf1 _) b c

theorem measurable_dirCube {r : ℕ} {f : E3 → ℂ} (hf : Measurable f) (v : E3) (b c : Fin r → ℝ) :
    Measurable (dirCube f v b c) := by
  unfold dirCube cubeProdSel
  exact Finset.measurable_prod _ fun ω _ => (measurable_conjPar _).comp
    (hf.comp (measurable_id.add_const _))

theorem dirCube_eq_zero {r : ℕ} {f : E3 → ℂ} {v : E3} {b c : Fin r → ℝ} {x : E3}
    (h : f (x + (∑ i, b i) • v) = 0) : dirCube f v b c x = 0 :=
  cubeProdSel_eq_zero_of_head (v := fun β => f (x + (∑ i, β i) • v)) h

/-- **The adjoint-type function of `patch:conditional-degree`**:
`F(x) = E_{t ∈ [0,N]} f_0(x + P_m(t) e_m) ∏_{i<m} f_i(x - P_i(t) e_i + P_m(t) e_m)
e(p_{x + P_m(t) e_m}(t))`. -/
noncomputable def cdlF (N : ℝ) (m : ℕ) (f : ℕ → E3 → ℂ) (P : ℕ → Polynomial ℝ)
    (p : E3 → Polynomial ℝ) (j : ℕ → Fin 3) (x : E3) : ℂ :=
  (N : ℂ)⁻¹ * ∫ t in (0 : ℝ)..N, f 0 (x + (P m).eval t • basisVec (j m))
    * phaseProd (m - 1) f P p j (x + (P m).eval t • basisVec (j m)) t

/-- The value of an admissible polynomial on `[0, N]` is at most `4 u_c(δ) N^d` for `d ≤ 3`. -/
theorem abs_eval_le_of_admissible {c : ℕ} {δ N : ℝ} (hN : 1 ≤ N) {d : ℕ} (hd : d ≤ 3)
    {P : Polynomial ℝ} (hP : AdmissiblePoly c δ N d P) (hc : 1 ≤ c) (hδ0 : 0 < δ) {t : ℝ}
    (ht : t ∈ Set.Icc 0 N) : |P.eval t| ≤ 4 * budHi c δ * N ^ d := by
  have hN0 : 0 ≤ N := by linarith
  have hu := (budHi_pos hδ0 hc).le
  obtain ⟨hdeg, _, hlc, hco⟩ := hP
  rw [Polynomial.eval_eq_sum_range, hdeg]
  have hterm : ∀ r ∈ Finset.range (d + 1), |P.coeff r * t ^ r| ≤ budHi c δ * N ^ d := by
    intro r hr
    have hr' : r ≤ d := Nat.lt_succ_iff.mp (Finset.mem_range.mp hr)
    have ht0 : 0 ≤ t := ht.1
    have htr : |t ^ r| ≤ N ^ r := by
      rw [abs_of_nonneg (pow_nonneg ht0 r)]; exact pow_le_pow_left₀ ht0 ht.2 r
    rw [abs_mul]
    rcases eq_or_lt_of_le hr' with h | h
    · subst h
      have hlc' : |P.coeff r| ≤ budHi c δ := by
        rw [show P.coeff r = P.leadingCoeff by rw [Polynomial.leadingCoeff, hdeg]]
        exact hlc
      calc |P.coeff r| * |t ^ r| ≤ budHi c δ * N ^ r :=
            mul_le_mul hlc' htr (abs_nonneg _) hu
        _ = budHi c δ * N ^ r := rfl
    · have h1 := hco r h
      calc |P.coeff r| * |t ^ r| ≤ budHi c δ * N ^ (d - r) * N ^ r :=
            mul_le_mul h1 htr (abs_nonneg _) (by positivity)
        _ = budHi c δ * N ^ d := by
            rw [mul_assoc, ← pow_add, Nat.sub_add_cancel h.le]
  calc |∑ r ∈ Finset.range (d + 1), P.coeff r * t ^ r|
      ≤ ∑ r ∈ Finset.range (d + 1), |P.coeff r * t ^ r| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _r ∈ Finset.range (d + 1), budHi c δ * N ^ d := Finset.sum_le_sum hterm
    _ = (d + 1) * (budHi c δ * N ^ d) := by simp
    _ ≤ 4 * (budHi c δ * N ^ d) := by
        gcongr
        have : (d : ℝ) ≤ 3 := by exact_mod_cast hd
        linarith
    _ = 4 * budHi c δ * N ^ d := by ring

end

/-! ### `patch:conditional-degree`, Step 5: the section coefficients as an `MA(m, l)` correlation -/

section
open Filter Topology MeasureTheory

theorem expPhase_eq_ephase (q : Polynomial ℝ) (t : ℝ) :
    expPhase (fun s => 2 * Real.pi * q.eval s) t = ephase (q.eval t) := by
  simp only [expPhase, ephase]

theorem maPhase_eval (m l k : ℕ) (ζ : ℕ → E3 → ℝ) (θ : ℕ → ℝ) (P : ℕ → Polynomial ℝ) (x : E3)
    (t : ℝ) : (maPhase m l k ζ θ P x).eval t
      = ∑ i ∈ Finset.Icc m l, ζ i x * (P i).eval t
        + ∑ i ∈ Finset.Icc (l + 1) k, θ i * (P i).eval t := by
  simp [maPhase, Polynomial.eval_finsetSum]

/-- The transverse coordinates of a point. -/
noncomputable def projT (m : Fin 3) (x : E3) : Fin 2 → ℝ := (splitT m x).2

theorem embT_projT (m : Fin 3) (x : E3) : embT m (projT m x) (x m) = x := by
  have h := (splitT m).symm_apply_apply x
  rw [splitT_symm_apply] at h
  have h2 : (splitT m x).1 = x m := rfl
  rw [projT, ← h2]
  exact h

theorem projT_embT (m : Fin 3) (y : Fin 2 → ℝ) (z : ℝ) : projT m (embT m y z) = y := by
  have h := (splitT m).apply_symm_apply (z, y)
  rw [splitT_symm_apply] at h
  rw [projT, h]

theorem measurable_projT (m : Fin 3) : Measurable (projT m) :=
  measurable_snd.comp (splitT m).measurable

/-- The alternating shift `s_ω = Σ_i (b^ω)_i`. -/
noncomputable def cubeShiftSum {r : ℕ} (ω : Fin r → Bool) (b c : Fin r → ℝ) : ℝ :=
  ∑ i, cubeSel ω b c i

/-- The differenced phase `ζ'_i(x) = Σ_ω (-1)^{|ω|} ξ_i(x + s_ω e_m)` of Step 5. -/
noncomputable def cdlZeta' {r : ℕ} (ξ : E3 → ℝ) (e : E3) (b c : Fin r → ℝ) (x : E3) : ℝ :=
  ∑ ω : Fin r → Bool, (-1) ^ numTrue ω * ξ (x + cubeShiftSum ω b c • e)

/-- The one-parameter integrand of `cdlF`. -/
noncomputable def cdlPhi (m : ℕ) (f : ℕ → E3 → ℂ) (P : ℕ → Polynomial ℝ)
    (p : E3 → Polynomial ℝ) (j : ℕ → Fin 3) (t : ℝ) (x : E3) : ℂ :=
  f 0 (x + (P m).eval t • basisVec (j m))
    * phaseProd (m - 1) f P p j (x + (P m).eval t • basisVec (j m)) t

/-- **Step 5, the pointwise expansion**: the paired cube of the integrand distributes over the
factors, the fixed higher phases cancel (`r ≥ 1`), and the spatial variable moves to
`w = z + P_m(t)`. -/
theorem cube_cdlPhi {r : ℕ} (hr : 1 ≤ r) {m l k : ℕ}
    (f : ℕ → E3 → ℂ) (P : ℕ → Polynomial ℝ) (ξ : ℕ → E3 → ℝ) (η : ℕ → ℝ) (j : ℕ → Fin 3)
    (b c : Fin r → ℝ) (t : ℝ)
    (y : Fin 2 → ℝ) (z ψ : ℝ) :
    cubeProdSel (fun β => cdlPhi m f P (maPhase (m + 1) l k ξ η P) j t
        (embT (j m) y (z + ∑ i, β i))) b c * ephase (ψ * z)
      = dirCube (f 0) (basisVec (j m)) b c (embT (j m) y (z + (P m).eval t))
          * ephase (ψ * (z + (P m).eval t))
        * ((∏ i ∈ Finset.Icc 1 (m - 1), dirCube (f i) (basisVec (j m)) b c
            (embT (j m) y (z + (P m).eval t) - (P i).eval t • basisVec (j i)))
          * ephase (∑ i ∈ Finset.Icc (m + 1) l,
              cdlZeta' (ξ i) (basisVec (j m)) b c (embT (j m) y (z + (P m).eval t))
                * (P i).eval t - ψ * (P m).eval t)) := by
  set e := basisVec (j m) with he
  set X := embT (j m) y (z + (P m).eval t) with hX
  have hpt : ∀ β : Fin r → ℝ, embT (j m) y (z + ∑ i, β i) + (P m).eval t • e
      = X + (∑ i, β i) • e := by
    intro β
    rw [hX, embT_add_smul, embT_add_smul]
    congr 1
    ring
  have hΦ : ∀ β : Fin r → ℝ, cdlPhi m f P (maPhase (m + 1) l k ξ η P) j t
      (embT (j m) y (z + ∑ i, β i))
      = f 0 (X + (∑ i, β i) • e)
        * ((∏ i ∈ Finset.Icc 1 (m - 1), f i ((X - (P i).eval t • basisVec (j i))
            + (∑ i, β i) • e))
          * ephase ((maPhase (m + 1) l k ξ η P (X + (∑ i, β i) • e)).eval t)) := by
    intro β
    rw [cdlPhi, phaseProd, hpt β, expPhase_eq_ephase]
    congr 2
    refine Finset.prod_congr rfl fun i _ => ?_
    congr 1
    abel
  simp_rw [hΦ]
  rw [cubeProdSel_mul, cubeProdSel_mul, cubeProdSel_prod, cubeProdSel_ephase]
  have hphase : ∑ ω : Fin r → Bool, (-1) ^ numTrue ω
      * (maPhase (m + 1) l k ξ η P (X + (∑ i, cubeSel ω b c i) • e)).eval t
      = ∑ i ∈ Finset.Icc (m + 1) l, cdlZeta' (ξ i) e b c X * (P i).eval t := by
    simp_rw [maPhase_eval, mul_add, Finset.sum_add_distrib, Finset.mul_sum]
    rw [Finset.sum_comm, Finset.sum_comm (s := Finset.univ) (t := Finset.Icc (l + 1) k)]
    have h0 : ∑ i ∈ Finset.Icc (l + 1) k, ∑ ω : Fin r → Bool,
        (-1 : ℝ) ^ numTrue ω * (η i * (P i).eval t) = 0 := by
      refine Finset.sum_eq_zero fun i _ => ?_
      rw [← Finset.sum_mul, sum_neg_one_pow_numTrue hr, zero_mul]
    rw [h0, add_zero]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [cdlZeta', Finset.sum_mul]
    refine Finset.sum_congr rfl fun ω _ => ?_
    rw [cubeShiftSum]
    ring
  rw [hphase]
  have he1 : ephase (ψ * z) = ephase (ψ * (z + (P m).eval t)) * ephase (-(ψ * (P m).eval t)) := by
    rw [← ephase_add]; congr 1; ring
  rw [he1]
  simp only [dirCube]
  have he2 : ephase (∑ i ∈ Finset.Icc (m + 1) l, cdlZeta' (ξ i) e b c X * (P i).eval t
        - ψ * (P m).eval t)
      = ephase (∑ i ∈ Finset.Icc (m + 1) l, cdlZeta' (ξ i) e b c X * (P i).eval t)
        * ephase (-(ψ * (P m).eval t)) := by
    rw [← ephase_add, sub_eq_add_neg]
  rw [he2]
  ring

/-- The first input of the Step 5 correlation: `g'_0(x) = u(y) D^r_{c,b} f_0(x) e(ψ(y) x_m)`. -/
noncomputable def cdlG0 {r : ℕ} (f0 : E3 → ℂ) (jm : Fin 3) (b c : Fin r → ℝ)
    (ψ : (Fin 2 → ℝ) → ℝ) (u : (Fin 2 → ℝ) → ℂ) (x : E3) : ℂ :=
  u (projT jm x) * dirCube f0 (basisVec jm) b c x * ephase (ψ (projT jm x) * x jm)

/-- The inputs of the Step 5 correlation. -/
noncomputable def cdlGs {r : ℕ} (f : ℕ → E3 → ℂ) (jm : Fin 3) (b c : Fin r → ℝ)
    (ψ : (Fin 2 → ℝ) → ℝ) (u : (Fin 2 → ℝ) → ℂ) (i : ℕ) : E3 → ℂ :=
  if i = 0 then cdlG0 (f 0) jm b c ψ u else dirCube (f i) (basisVec jm) b c

/-- The phases of the Step 5 correlation: `ζ'_m = -ψ(y)` and
`ζ'_i = Σ_ω (-1)^{|ω|} ξ_i(x + s_ω e_m)`. -/
noncomputable def cdlZs {r : ℕ} (ξ : ℕ → E3 → ℝ) (m : ℕ) (jm : Fin 3) (b c : Fin r → ℝ)
    (ψ : (Fin 2 → ℝ) → ℝ) (i : ℕ) : E3 → ℝ :=
  if i = m then fun x => -ψ (projT jm x) else cdlZeta' (ξ i) (basisVec jm) b c

/-- The integrand of the Step 5 identity after the substitution `w = z + P_m(t)`. -/
noncomputable def cdlGamma {r : ℕ} (m l : ℕ) (f : ℕ → E3 → ℂ) (P : ℕ → Polynomial ℝ)
    (ξ : ℕ → E3 → ℝ) (j : ℕ → Fin 3) (b c : Fin r → ℝ) (ψ : ℝ) (t : ℝ) (x : E3) : ℂ :=
  dirCube (f 0) (basisVec (j m)) b c x * ephase (ψ * x (j m))
    * ((∏ i ∈ Finset.Icc 1 (m - 1), dirCube (f i) (basisVec (j m)) b c
        (x - (P i).eval t • basisVec (j i)))
      * ephase (∑ i ∈ Finset.Icc (m + 1) l,
          cdlZeta' (ξ i) (basisVec (j m)) b c x * (P i).eval t - ψ * (P m).eval t))

theorem norm_cdlGamma_le {r : ℕ} {m l : ℕ} {f : ℕ → E3 → ℂ} (hf1 : ∀ i x, ‖f i x‖ ≤ 1)
    (P : ℕ → Polynomial ℝ) (ξ : ℕ → E3 → ℝ) (j : ℕ → Fin 3) (b c : Fin r → ℝ) (ψ t : ℝ)
    (x : E3) : ‖cdlGamma m l f P ξ j b c ψ t x‖ ≤ 1 := by
  rw [cdlGamma, norm_mul, norm_mul, norm_mul, norm_ephase, norm_ephase, mul_one, mul_one]
  refine ((mul_le_of_le_one_left (norm_nonneg _) (norm_dirCube_le (hf1 0) _ _ _ _)).trans ?_)
  exact (Finset.norm_prod_le _ _).trans
    (Finset.prod_le_one₀ (fun _ _ => norm_nonneg _) fun i _ => norm_dirCube_le (hf1 i) _ _ _ _)

theorem cdlGamma_eq_zero {r : ℕ} {m l : ℕ} {f : ℕ → E3 → ℂ} {C N : ℝ}
    (hfs : ∀ x, x ∉ petBox C N → f 0 x = 0) (P : ℕ → Polynomial ℝ) (ξ : ℕ → E3 → ℝ)
    (j : ℕ → Fin 3) (b c : Fin r → ℝ) (ψ t : ℝ) {x : E3}
    (hx : x + (∑ i, b i) • basisVec (j m) ∉ petBox C N) :
    cdlGamma m l f P ξ j b c ψ t x = 0 := by
  rw [cdlGamma, dirCube_eq_zero (hfs _ hx)]
  ring

theorem measurable_cdlZeta' {r : ℕ} {ξ : E3 → ℝ} (hξ : Measurable ξ) (e : E3) (b c : Fin r → ℝ) :
    Measurable (cdlZeta' ξ e b c) := by
  unfold cdlZeta'
  exact Finset.measurable_sum _ fun ω _ =>
    measurable_const.mul (hξ.comp (measurable_id.add_const _))

theorem measurable_cdlGamma {r : ℕ} {m l : ℕ} {f : ℕ → E3 → ℂ} (hf : ∀ i, Measurable (f i))
    (P : ℕ → Polynomial ℝ) {ξ : ℕ → E3 → ℝ} (hξ : ∀ i, Measurable (ξ i)) (j : ℕ → Fin 3)
    (b c : Fin r → ℝ) :
    Measurable fun q : (ℝ × ℝ) × E3 => cdlGamma m l f P ξ j b c q.1.1 q.1.2 q.2 := by
  unfold cdlGamma
  have hc : Continuous fun x : E3 => x (j m) := continuous_coord (j m)
  refine (((measurable_dirCube (hf 0) _ b c).comp measurable_snd).mul
    (continuous_ephase.measurable.comp (measurable_fst.fst.mul (hc.measurable.comp
      measurable_snd)))).mul ((Finset.measurable_prod _ fun i _ =>
        (measurable_dirCube (hf i) _ b c).comp (measurable_snd.sub
          ((((P i).continuous.measurable.comp measurable_fst.snd)).smul_const _))).mul
      (continuous_ephase.measurable.comp ((Finset.measurable_sum _ fun i _ =>
        ((measurable_cdlZeta' (hξ i) _ b c).comp measurable_snd).mul
          ((P i).continuous.measurable.comp measurable_fst.snd)).sub
        (measurable_fst.fst.mul ((P m).continuous.measurable.comp measurable_fst.snd)))))

/-- A bounded measurable function vanishing off a set of finite measure is integrable. -/
theorem integrable_of_bdd_of_support {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {g : α → ℂ} (hg : Measurable g) {C : ℝ} (hC : ∀ x, ‖g x‖ ≤ C) {s : Set α}
    (hs : μ s ≠ ⊤) (hsupp : ∀ x, x ∉ s → g x = 0) : Integrable g μ :=
  IntegrableOn.integrable_of_forall_notMem_eq_zero
    (Measure.integrableOn_of_bounded (M := C) hs hg.aestronglyMeasurable
      (Eventually.of_forall hC)) hsupp

/-- The transverse box `∏_{i ≠ m} [-C N^{d_i}, C N^{d_i}]`. -/
def transBox (m : Fin 3) (C N : ℝ) : Set (Fin 2 → ℝ) :=
  {y | ∀ i, y i ∈ Set.Icc (-(C * N ^ expo (m.succAbove i))) (C * N ^ expo (m.succAbove i))}

theorem measurableSet_transBox (m : Fin 3) (C N : ℝ) : MeasurableSet (transBox m C N) := by
  have : transBox m C N = ⋂ i, (fun y : Fin 2 → ℝ => y i) ⁻¹'
      Set.Icc (-(C * N ^ expo (m.succAbove i))) (C * N ^ expo (m.succAbove i)) := by
    ext y; simp [transBox]
  rw [this]
  exact MeasurableSet.iInter fun i => (measurable_pi_apply i) measurableSet_Icc

theorem volume_transBox_lt_top (m : Fin 3) (C N : ℝ) : volume (transBox m C N) < ⊤ := by
  have : transBox m C N = Set.univ.pi fun i =>
      Set.Icc (-(C * N ^ expo (m.succAbove i))) (C * N ^ expo (m.succAbove i)) := by
    ext y; simp only [transBox, Set.mem_ofPred_eq, Set.mem_univ_pi]
  rw [this, volume_pi_pi]
  exact ENNReal.prod_lt_top fun i _ => by simp

/-- A point `embT y w + s e_m` of the box has its transverse part in the transverse box and its
`m`-th coordinate in `[-C N^{d_m} - s, C N^{d_m} - s]`. -/
theorem mem_of_embT_mem_petBox {m : Fin 3} {y : Fin 2 → ℝ} {w s C N : ℝ}
    (h : embT m y w + s • basisVec m ∈ petBox C N) :
    y ∈ transBox m C N ∧ w + s ∈ Set.Icc (-(C * N ^ expo m)) (C * N ^ expo m) := by
  rw [embT_add_smul] at h
  refine ⟨fun i => ?_, ?_⟩
  · have := h (m.succAbove i)
    rwa [embT_apply_succAbove] at this
  · have := h m
    rwa [embT_apply_self] at this

set_option maxHeartbeats 1000000 in
-- The four exchanges of integration and the substitution share one context.
/-- **`patch:conditional-degree`, Step 5: the section coefficients are an `MA(m, l)` correlation.**
With `F = E_t F_t` the adjoint-type function, the integral over the transverse variable `y` of
`u(y) ∫ G_{y,b,c}(z) e(ψ(y) z) dz` is exactly the correlation of `patch:ma-correlation` with inputs
`g'_0 = u D^r_{c,b} f_0 e(ψ x_m)`, `g'_i = D^r_{c,b} f_i`, phases `ζ'_m = -ψ`,
`ζ'_i = Σ_ω (-1)^{|ω|} ξ_i(· + s_ω e_m)` and no fixed higher phase. -/
theorem cdl_step5_identity {r : ℕ} (hr : 1 ≤ r) {N : ℝ} (hN : 0 < N) {m l k : ℕ}
    (hml : m ≤ l) {f : ℕ → E3 → ℂ} (hf : ∀ i, Measurable (f i))
    (hf1 : ∀ i x, ‖f i x‖ ≤ 1) {C : ℝ} (hfs : ∀ x, x ∉ petBox C N → f 0 x = 0)
    (P : ℕ → Polynomial ℝ) {ξ : ℕ → E3 → ℝ} (hξ : ∀ i, Measurable (ξ i)) (η : ℕ → ℝ)
    (j : ℕ → Fin 3) (b c : Fin r → ℝ) {ψ : (Fin 2 → ℝ) → ℝ} (hψ : Measurable ψ)
    {u : (Fin 2 → ℝ) → ℂ} (hu : Measurable u) (hu1 : ∀ y, ‖u y‖ ≤ 1) :
    ∫ y, u y * ∫ z, cdlG (unifIcc 0 N) (fun t y z => Set.indicator (Set.Icc 0 N)
        (fun t => cdlPhi m f P (maPhase (m + 1) l k ξ η P) j t (embT (j m) y z)) t) y b c z
        * ephase (ψ y * z)
      = phaseCorr N (m - 1) (cdlGs f (j m) b c ψ u) P
          (maPhase m l k (cdlZs ξ m (j m) b c ψ) (fun _ => 0) P) j := by
  classical
  set e := basisVec (j m) with he
  set I := Set.Icc (0 : ℝ) N with hI
  set Γ : ℝ → (Fin 2 → ℝ) → ℝ → ℂ := fun t y w =>
    cdlGamma m l f P ξ j b c (ψ y) t (embT (j m) y w) with hΓ
  have hΓm : Measurable fun q : ℝ × (Fin 2 → ℝ) × ℝ => Γ q.1 q.2.1 q.2.2 := by
    have h := (measurable_cdlGamma (m := m) (l := l) hf P hξ j b c).comp
      (((hψ.comp measurable_snd.fst).prodMk measurable_fst).prodMk
        ((measurable_embT (j m)).comp measurable_snd))
    exact h
  have hΓ1 : ∀ t y w, ‖Γ t y w‖ ≤ 1 := fun t y w => norm_cdlGamma_le hf1 P ξ j b c _ _ _
  set sb := ∑ i, b i with hsb
  have hΓs : ∀ t y w, (y ∉ transBox (j m) C N ∨
      w + sb ∉ Set.Icc (-(C * N ^ expo (j m))) (C * N ^ expo (j m))) → Γ t y w = 0 := by
    intro t y w h
    refine cdlGamma_eq_zero hfs P ξ j b c _ t ?_
    intro hmem
    obtain ⟨h1, h2⟩ := mem_of_embT_mem_petBox hmem
    rcases h with h | h
    · exact h h1
    · exact h h2
  obtain ⟨MP, hMP⟩ := (isCompact_Icc (a := (0 : ℝ)) (b := N)).exists_bound_of_continuousOn
    (P m).continuous.continuousOn
  set R := C * N ^ expo (j m) + |sb| + |MP| with hR
  -- Step 1: the parameter average, the cube expansion and the substitution
  have hstep1 : ∀ y z, cdlG (unifIcc 0 N) (fun t y z => Set.indicator I
      (fun t => cdlPhi m f P (maPhase (m + 1) l k ξ η P) j t (embT (j m) y z)) t) y b c z
      * ephase (ψ y * z)
      = (N : ℂ)⁻¹ * ∫ t, Set.indicator I (fun t => Γ t y (z + (P m).eval t)) t := by
    intro y z
    rw [cdlG, integral_unifIcc (by linarith : (0 : ℝ) < N), sub_zero, mul_assoc,
      ← integral_mul_const, ← integral_indicator (measurableSet_Icc)]
    congr 1
    refine integral_congr_ae (Eventually.of_forall fun t => ?_)
    by_cases ht : t ∈ I
    · have hcube : cubeProdSel (fun β => Set.indicator I (fun t => cdlPhi m f P
          (maPhase (m + 1) l k ξ η P) j t (embT (j m) y (z + ∑ i, β i))) t) b c
          = cubeProdSel (fun β => cdlPhi m f P (maPhase (m + 1) l k ξ η P) j t
            (embT (j m) y (z + ∑ i, β i))) b c := by
        congr 1; funext β; rw [Set.indicator_of_mem ht]
      rw [Set.indicator_of_mem ht, Set.indicator_of_mem ht, hcube, cube_cdlPhi hr f P ξ η j b c t
        y z (ψ y), hΓ]
      simp only [cdlGamma, embT_apply_self]
    · rw [Set.indicator_of_notMem ht, Set.indicator_of_notMem ht]
  simp_rw [hstep1]
  -- Step 2: exchange `z` and `t`, and translate
  have hstep2 : ∀ y, (∫ z, (N : ℂ)⁻¹ * ∫ t, Set.indicator I (fun t => Γ t y (z + (P m).eval t)) t)
      = (N : ℂ)⁻¹ * ∫ t, Set.indicator I (fun t => ∫ w, Γ t y w) t := by
    intro y
    rw [integral_const_mul]
    congr 1
    have hm2 : Measurable (Function.uncurry fun (z t : ℝ) =>
        Set.indicator I (fun t => Γ t y (z + (P m).eval t)) t) := by
      have h1 : Measurable fun q : ℝ × ℝ => Γ q.2 y (q.1 + (P m).eval q.2) := by
        have h := hΓm.comp (measurable_snd.prodMk ((measurable_const (a := y)).prodMk
          (measurable_fst.add ((P m).continuous.measurable.comp measurable_snd))))
        exact h
      have h2 := h1.indicator (measurable_snd measurableSet_Icc :
        MeasurableSet (Prod.snd ⁻¹' I : Set (ℝ × ℝ)))
      have e : (Function.uncurry fun (z t : ℝ) =>
          Set.indicator I (fun t => Γ t y (z + (P m).eval t)) t)
          = (Prod.snd ⁻¹' I).indicator fun q : ℝ × ℝ => Γ q.2 y (q.1 + (P m).eval q.2) := by
        funext q
        simp only [Function.uncurry, Set.indicator, Set.mem_preimage]
      rw [e]
      exact h2
    have hi2 : Integrable (Function.uncurry fun (z t : ℝ) =>
        Set.indicator I (fun t => Γ t y (z + (P m).eval t)) t)
        ((volume : Measure ℝ).prod volume) := by
      refine integrable_of_bdd_of_support hm2 (C := 1) (s := Set.Icc (-(2 * R)) (2 * R) ×ˢ I)
        (fun q => ?_) ?_ (fun q hq => ?_)
      · simp only [Function.uncurry]
        by_cases ht : q.2 ∈ I
        · rw [Set.indicator_of_mem ht]; exact hΓ1 _ _ _
        · rw [Set.indicator_of_notMem ht, norm_zero]; exact zero_le_one
      · rw [Measure.prod_prod]; exact ENNReal.mul_ne_top (by simp) (by simp [hI])
      · simp only [Function.uncurry]
        by_cases ht : q.2 ∈ I
        · rw [Set.indicator_of_mem ht]
          refine hΓs _ _ _ (Or.inr fun hw => hq ⟨?_, ht⟩)
          have hPt := hMP q.2 ht
          rw [Real.norm_eq_abs] at hPt
          have hsb := le_abs_self sb
          have hsb' := neg_abs_le sb
          have hMP' := le_abs_self MP
          have hP1 := (abs_le.mp hPt).1
          have hP2 := (abs_le.mp hPt).2
          have hw1 := hw.1
          have hw2 := hw.2
          have hCN : 0 ≤ C * N ^ expo (j m) := by linarith
          constructor <;> linarith
        · rw [Set.indicator_of_notMem ht]
    rw [integral_integral_swap hi2]
    refine integral_congr_ae (Eventually.of_forall fun t => ?_)
    beta_reduce
    by_cases ht : t ∈ I
    · simp only [Set.indicator_of_mem ht]
      exact integral_add_right_eq_self (fun w => Γ t y w) ((P m).eval t)
    · simp only [Set.indicator_of_notMem ht, integral_zero]
  simp_rw [hstep2]
  -- the support of the integrand in `ℝ³`
  set Sx : Set E3 := {x | projT (j m) x ∈ transBox (j m) C N ∧
    x (j m) ∈ Set.Icc (-(C * N ^ expo (j m)) - sb) (C * N ^ expo (j m) - sb)} with hSx
  have hSxm : MeasurableSet Sx :=
    ((measurable_projT (j m)) (measurableSet_transBox (j m) C N)).inter
      ((continuous_coord (j m)).measurable measurableSet_Icc)
  have hSxμ : volume Sx ≠ ⊤ := by
    have hpre : Sx = (splitT (j m)) ⁻¹'
        (Set.Icc (-(C * N ^ expo (j m)) - sb) (C * N ^ expo (j m) - sb)
        ×ˢ transBox (j m) C N) := by
      ext x
      simp only [hSx, Set.mem_ofPred_eq, Set.mem_preimage, Set.mem_prod]
      constructor
      · rintro ⟨h1, h2⟩; exact ⟨h2, h1⟩
      · rintro ⟨h2, h1⟩; exact ⟨h1, h2⟩
    rw [hpre, (measurePreserving_splitT (j m)).measure_preimage
      ((measurableSet_Icc.prod (measurableSet_transBox (j m) C N)).nullMeasurableSet),
      Measure.volume_eq_prod, Measure.prod_prod]
    exact ENNReal.mul_ne_top (by simp) (volume_transBox_lt_top (j m) C N).ne
  have hGx : ∀ t x, x ∉ Sx → cdlGamma m l f P ξ j b c (ψ (projT (j m) x)) t x = 0 := by
    intro t x hx
    have h := hΓs t (projT (j m) x) (x (j m))
    rw [hΓ] at h
    simp only [embT_projT] at h
    refine h ?_
    by_contra hcon
    push Not at hcon
    obtain ⟨h1, h2⟩ := hcon
    exact hx ⟨h1, by constructor <;> linarith [h2.1, h2.2]⟩
  -- Step 3: exchange the transverse variable and the parameter
  have hwm : Measurable fun q : (Fin 2 → ℝ) × ℝ => ∫ w, Γ q.2 q.1 w := by
    have h := (hΓm.comp ((measurable_fst.snd.prodMk (measurable_fst.fst.prodMk measurable_snd))
      : Measurable fun s : ((Fin 2 → ℝ) × ℝ) × ℝ => ((s.1.2, s.1.1, s.2) :
        ℝ × (Fin 2 → ℝ) × ℝ))).stronglyMeasurable.integral_prod_right' (ν := volume)
    exact h.measurable
  have hwb : ∀ t y, ‖∫ w, Γ t y w‖ ≤ 2 * |C * N ^ expo (j m)| := by
    intro t y
    have hi : Integrable (Set.indicator
        (Set.Icc (-(C * N ^ expo (j m)) - sb) (C * N ^ expo (j m) - sb))
        fun _ => (1 : ℝ)) :=
      (continuous_const.integrableOn_Icc).integrable_indicator measurableSet_Icc
    refine (norm_integral_le_of_norm_le hi (Eventually.of_forall fun w => ?_)).trans ?_
    · by_cases hw : w ∈ Set.Icc (-(C * N ^ expo (j m)) - sb) (C * N ^ expo (j m) - sb)
      · rw [Set.indicator_of_mem hw]; exact hΓ1 _ _ _
      · rw [Set.indicator_of_notMem hw, hΓs t y w (Or.inr fun h => hw
          ⟨by linarith [h.1], by linarith [h.2]⟩), norm_zero]
    · rw [integral_indicator measurableSet_Icc, setIntegral_const, Real.volume_real_Icc,
        smul_eq_mul, mul_one]
      rcases le_total 0 (C * N ^ expo (j m)) with h | h
      · rw [abs_of_nonneg h, max_eq_left (by linarith)]; linarith
      · rw [max_eq_right (by linarith)]; positivity
  have hstep3 : (∫ y, u y * ((N : ℂ)⁻¹ * ∫ t, Set.indicator I (fun t => ∫ w, Γ t y w) t))
      = (N : ℂ)⁻¹ * ∫ t, Set.indicator I (fun t => ∫ y, u y * ∫ w, Γ t y w) t := by
    have hm3 : Measurable (Function.uncurry fun (y : Fin 2 → ℝ) (t : ℝ) =>
        u y * Set.indicator I (fun t => ∫ w, Γ t y w) t) := by
      have h1 := (hu.comp measurable_fst).mul (hwm.indicator
        (measurable_snd measurableSet_Icc : MeasurableSet (Prod.snd ⁻¹' I :
          Set ((Fin 2 → ℝ) × ℝ))))
      have e : (Function.uncurry fun (y : Fin 2 → ℝ) (t : ℝ) =>
          u y * Set.indicator I (fun t => ∫ w, Γ t y w) t)
          = fun q => u q.1 * (Prod.snd ⁻¹' I).indicator (fun q => ∫ w, Γ q.2 q.1 w) q := by
        funext q; simp only [Function.uncurry, Set.indicator, Set.mem_preimage]
      rw [e]; exact h1
    have hi3 : Integrable (Function.uncurry fun (y : Fin 2 → ℝ) (t : ℝ) =>
        u y * Set.indicator I (fun t => ∫ w, Γ t y w) t) ((volume : Measure (Fin 2 → ℝ)).prod
          volume) := by
      refine integrable_of_bdd_of_support hm3 (C := 2 * |C * N ^ expo (j m)|)
        (s := transBox (j m) C N ×ˢ I) (fun q => ?_) ?_ (fun q hq => ?_)
      · simp only [Function.uncurry, norm_mul]
        by_cases ht : q.2 ∈ I
        · rw [Set.indicator_of_mem ht]
          exact (mul_le_of_le_one_left (norm_nonneg _) (hu1 _)).trans (hwb _ _)
        · rw [Set.indicator_of_notMem ht, norm_zero, mul_zero]; positivity
      · rw [Measure.prod_prod]
        exact ENNReal.mul_ne_top (volume_transBox_lt_top (j m) C N).ne (by simp [hI])
      · simp only [Function.uncurry]
        by_cases ht : q.2 ∈ I
        · rw [Set.indicator_of_mem ht]
          have hy : q.1 ∉ transBox (j m) C N := fun hy => hq ⟨hy, ht⟩
          have : (∫ w, Γ q.2 q.1 w) = 0 := by
            rw [integral_congr_ae (Eventually.of_forall fun w => hΓs q.2 q.1 w (Or.inl hy))]
            simp
          rw [this, mul_zero]
        · rw [Set.indicator_of_notMem ht, mul_zero]
    have hA : ∀ y : Fin 2 → ℝ, u y * ((N : ℂ)⁻¹ * ∫ t, Set.indicator I (fun t => ∫ w, Γ t y w) t)
        = (N : ℂ)⁻¹ * ∫ t, u y * Set.indicator I (fun t => ∫ w, Γ t y w) t := fun y => by
      rw [integral_const_mul]; ring
    simp_rw [hA]
    rw [integral_const_mul, integral_integral_swap hi3]
    congr 1
    refine integral_congr_ae (Eventually.of_forall fun t => ?_)
    beta_reduce
    by_cases ht : t ∈ I
    · simp only [Set.indicator_of_mem ht]
    · simp only [Set.indicator_of_notMem ht, mul_zero, integral_zero]
  rw [hstep3]
  -- Step 4: the transverse Fubini theorem, and Step 5: the pointwise identification
  have hpoint : ∀ (t : ℝ) (x : E3), u (projT (j m) x)
      * cdlGamma m l f P ξ j b c (ψ (projT (j m) x)) t x
      = cdlGs f (j m) b c ψ u 0 x * phaseProd (m - 1) (cdlGs f (j m) b c ψ u) P
          (maPhase m l k (cdlZs ξ m (j m) b c ψ) (fun _ => 0) P) j x t := by
    intro t x
    simp only [cdlGs, ite_true, cdlG0, phaseProd, cdlGamma]
    rw [expPhase_eq_ephase, maPhase_eval]
    simp only [zero_mul, Finset.sum_const_zero, add_zero]
    have hIcc : Finset.Icc m l = insert m (Finset.Icc (m + 1) l) := by
      ext i; simp only [Finset.mem_Icc, Finset.mem_insert]; omega
    rw [hIcc, Finset.sum_insert (by simp)]
    have hZm : cdlZs ξ m (j m) b c ψ m x = -ψ (projT (j m) x) := by simp [cdlZs]
    have hZi : ∀ i ∈ Finset.Icc (m + 1) l, cdlZs ξ m (j m) b c ψ i x
        = cdlZeta' (ξ i) (basisVec (j m)) b c x := by
      intro i hi
      have : i ≠ m := by rw [Finset.mem_Icc] at hi; omega
      simp [cdlZs, this]
    have hsum : ∑ i ∈ Finset.Icc (m + 1) l, cdlZs ξ m (j m) b c ψ i x * (P i).eval t
        = ∑ i ∈ Finset.Icc (m + 1) l, cdlZeta' (ξ i) (basisVec (j m)) b c x * (P i).eval t :=
      Finset.sum_congr rfl fun i hi => by rw [hZi i hi]
    rw [hZm, hsum]
    have hprod : ∏ i ∈ Finset.Icc 1 (m - 1), (if i = 0 then cdlG0 (f 0) (j m) b c ψ u
        else dirCube (f i) (basisVec (j m)) b c) (x - (P i).eval t • basisVec (j i))
        = ∏ i ∈ Finset.Icc 1 (m - 1), dirCube (f i) (basisVec (j m)) b c
          (x - (P i).eval t • basisVec (j i)) := by
      refine Finset.prod_congr rfl fun i hi => ?_
      have : i ≠ 0 := by rw [Finset.mem_Icc] at hi; omega
      simp [this]
    rw [hprod]
    have hph : ephase (∑ i ∈ Finset.Icc (m + 1) l, cdlZeta' (ξ i) (basisVec (j m)) b c x
        * (P i).eval t - ψ (projT (j m) x) * (P m).eval t)
        = ephase (-ψ (projT (j m) x) * (P m).eval t + ∑ i ∈ Finset.Icc (m + 1) l,
          cdlZeta' (ξ i) (basisVec (j m)) b c x * (P i).eval t) := by
      congr 1; ring
    rw [hph]
    ring
  have hstep4 : ∀ t, (∫ y, u y * ∫ w, Γ t y w)
      = ∫ x, cdlGs f (j m) b c ψ u 0 x * phaseProd (m - 1) (cdlGs f (j m) b c ψ u) P
          (maPhase m l k (cdlZs ξ m (j m) b c ψ) (fun _ => 0) P) j x t := by
    intro t
    set g : E3 → ℂ := fun x => u (projT (j m) x) * cdlGamma m l f P ξ j b c (ψ (projT (j m) x)) t x
      with hg
    have hgm : Measurable g := by
      have hmap : Measurable fun x : E3 => (((ψ (projT (j m) x), t) : ℝ × ℝ), x) :=
        ((hψ.comp (measurable_projT (j m))).prodMk (measurable_const (a := t))).prodMk measurable_id
      have h := (hu.comp (measurable_projT (j m))).mul ((measurable_cdlGamma (m := m) (l := l) hf P
        hξ j b c).comp hmap)
      exact h
    have hgi : Integrable g := by
      refine integrable_of_bdd_of_support hgm (C := 1) (fun x => ?_) hSxμ (fun x hx => ?_)
      · rw [hg, norm_mul]
        exact ((mul_le_of_le_one_left (norm_nonneg _) (hu1 _)).trans (norm_cdlGamma_le hf1 P ξ j b
          c _ _ _))
      · rw [hg]; simp only; rw [hGx t x hx, mul_zero]
    have h4 := integral_embT (j m) hgi
    have e1 : (∫ y, u y * ∫ w, Γ t y w) = ∫ y : Fin 2 → ℝ, ∫ z : ℝ, g (embT (j m) y z) := by
      refine integral_congr_ae (Eventually.of_forall fun y => ?_)
      beta_reduce
      rw [← integral_const_mul]
      refine integral_congr_ae (Eventually.of_forall fun w => ?_)
      simp only [hg, hΓ, projT_embT]
    rw [e1, ← h4]
    exact integral_congr_ae (Eventually.of_forall fun x => hpoint t x)
  simp_rw [hstep4]
  -- Step 6: exchange the parameter and the point
  set K : E3 → ℝ → ℂ := fun x t => u (projT (j m) x)
    * cdlGamma m l f P ξ j b c (ψ (projT (j m) x)) t x with hK
  have hKm : Measurable (Function.uncurry fun (t : ℝ) (x : E3) => K x t) := by
    have hmap : Measurable fun q : ℝ × E3 => (((ψ (projT (j m) q.2), q.1) : ℝ × ℝ), q.2) :=
      ((hψ.comp ((measurable_projT (j m)).comp measurable_snd)).prodMk measurable_fst).prodMk
        measurable_snd
    have h := (hu.comp ((measurable_projT (j m)).comp measurable_snd)).mul
      ((measurable_cdlGamma (m := m) (l := l) hf P hξ j b c).comp hmap)
    exact h
  have hK1 : ∀ x t, ‖K x t‖ ≤ 1 := fun x t => by
    rw [hK]; simp only [norm_mul]
    exact ((mul_le_of_le_one_left (norm_nonneg _) (hu1 _)).trans (norm_cdlGamma_le hf1 P ξ j b c _
      _ _))
  have hKs : ∀ x t, x ∉ Sx → K x t = 0 := fun x t hx => by
    rw [hK]; simp only; rw [hGx t x hx, mul_zero]
  have hint : Integrable (Function.uncurry fun (t : ℝ) (x : E3) =>
      Set.indicator I (fun t => K x t) t) ((volume : Measure ℝ).prod volume) := by
    have hm : Measurable (Function.uncurry fun (t : ℝ) (x : E3) =>
        Set.indicator I (fun t => K x t) t) := by
      have h := hKm.indicator (measurable_fst measurableSet_Icc :
        MeasurableSet (Prod.fst ⁻¹' I : Set (ℝ × E3)))
      have e : (Function.uncurry fun (t : ℝ) (x : E3) => Set.indicator I (fun t => K x t) t)
          = (Prod.fst ⁻¹' I).indicator (Function.uncurry fun (t : ℝ) (x : E3) => K x t) := by
        funext q; simp only [Function.uncurry, Set.indicator, Set.mem_preimage]
      rw [e]; exact h
    refine integrable_of_bdd_of_support hm (C := 1) (s := I ×ˢ Sx) (fun q => ?_) ?_
      (fun q hq => ?_)
    · simp only [Function.uncurry]
      by_cases ht : q.1 ∈ I
      · rw [Set.indicator_of_mem ht]; exact hK1 _ _
      · rw [Set.indicator_of_notMem ht, norm_zero]; exact zero_le_one
    · rw [Measure.prod_prod]; exact ENNReal.mul_ne_top (by simp [hI]) hSxμ
    · simp only [Function.uncurry]
      by_cases ht : q.1 ∈ I
      · rw [Set.indicator_of_mem ht]; exact hKs _ _ fun hx => hq ⟨ht, hx⟩
      · rw [Set.indicator_of_notMem ht]
  have hL : ∀ t, Set.indicator I (fun t => ∫ x, cdlGs f (j m) b c ψ u 0 x * phaseProd (m - 1)
      (cdlGs f (j m) b c ψ u) P (maPhase m l k (cdlZs ξ m (j m) b c ψ) (fun _ => 0) P) j x t) t
      = ∫ x, Set.indicator I (fun t => K x t) t := by
    intro t
    by_cases ht : t ∈ I
    · simp only [Set.indicator_of_mem ht, hK, hpoint]
    · simp only [Set.indicator_of_notMem ht, integral_zero]
  simp_rw [hL]
  rw [integral_integral_swap hint, phaseCorr, ← integral_const_mul]
  refine integral_congr_ae (Eventually.of_forall fun x => ?_)
  beta_reduce
  rw [integral_indicator measurableSet_Icc, integral_Icc_eq_integral_Ioc,
    ← intervalIntegral.integral_of_le hN.le, ← intervalIntegral.integral_const_mul]
  have hKx : ∀ t, K x t = cdlGs f (j m) b c ψ u 0 x * phaseProd (m - 1) (cdlGs f (j m) b c ψ u) P
      (maPhase m l k (cdlZs ξ m (j m) b c ψ) (fun _ => 0) P) j x t := fun t => hpoint t x
  simp_rw [hKx]
  rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul]
  ring

end

/-! ### `patch:conditional-degree`, Step 5: the application of `MA(m, l)` -/

section
open Filter Topology MeasureTheory

theorem sum_expo_succAbove (m : Fin 3) : ∑ i : Fin 2, expo (m.succAbove i) = 6 - expo m := by
  fin_cases m <;> simp [expo, Fin.sum_univ_two, Fin.succAbove]

/-- The volume of the transverse box: `(2C)² N^{6 - d_m}`. -/
theorem volume_transBox (m : Fin 3) {C N : ℝ} (hC : 0 ≤ C) (hN : 0 ≤ N) :
    (volume (transBox m C N)).toReal = (2 * C) ^ 2 * N ^ (6 - expo m) := by
  have : transBox m C N = Set.univ.pi fun i =>
      Set.Icc (-(C * N ^ expo (m.succAbove i))) (C * N ^ expo (m.succAbove i)) := by
    ext y; simp only [transBox, Set.mem_ofPred_eq, Set.mem_univ_pi]
  rw [this, volume_pi_pi, ENNReal.toReal_prod]
  simp only [Real.volume_Icc, sub_neg_eq_add]
  rw [Finset.prod_congr rfl fun i _ => ENNReal.toReal_ofReal (by positivity)]
  rw [← sum_expo_succAbove m, ← Finset.prod_pow_eq_pow_sum, Fin.prod_univ_two, Fin.prod_univ_two]
  ring

/-- The normalized Lebesgue measure on the transverse box. -/
noncomputable def transMeas (m : Fin 3) (C N : ℝ) : Measure (Fin 2 → ℝ) :=
  (volume (transBox m C N))⁻¹ • volume.restrict (transBox m C N)

theorem isProbabilityMeasure_transMeas (m : Fin 3) {C N : ℝ} (hC : 0 < C) (hN : 0 < N) :
    IsProbabilityMeasure (transMeas m C N) := by
  constructor
  have hpos : volume (transBox m C N) ≠ 0 := by
    intro h0
    have := volume_transBox m hC.le hN.le
    rw [h0, ENNReal.toReal_zero] at this
    have : 0 < (2 * C) ^ 2 * N ^ (6 - expo m) := by positivity
    linarith
  rw [transMeas, Measure.smul_apply, Measure.restrict_apply MeasurableSet.univ, Set.univ_inter,
    smul_eq_mul, ENNReal.inv_mul_cancel hpos (volume_transBox_lt_top m C N).ne]

theorem integral_transMeas (m : Fin 3) {C N : ℝ} (g : (Fin 2 → ℝ) → ℂ) :
    ∫ y, g y ∂transMeas m C N
      = ((volume (transBox m C N)).toReal : ℂ)⁻¹ * ∫ y in transBox m C N, g y := by
  rw [transMeas, integral_smul_measure, ENNReal.toReal_inv, Complex.real_smul, Complex.ofReal_inv]

theorem measure_transMeas (m : Fin 3) {C N : ℝ} {A : Set (Fin 2 → ℝ)} (hA : MeasurableSet A) :
    (transMeas m C N A).toReal
      = (volume (A ∩ transBox m C N)).toReal / (volume (transBox m C N)).toReal := by
  rw [transMeas, Measure.smul_apply, Measure.restrict_apply hA, smul_eq_mul, ENNReal.toReal_mul,
    ENNReal.toReal_inv, div_eq_inv_mul]

/-- The unit scalar `u` with `u z = |z|`. -/
noncomputable def unitOf (z : ℂ) : ℂ := if z = 0 then 1 else (starRingEnd ℂ) z / (‖z‖ : ℂ)

theorem unitOf_mul (z : ℂ) : unitOf z * z = (‖z‖ : ℂ) := by
  unfold unitOf
  split_ifs with h
  · simp [h]
  · have hn : (‖z‖ : ℂ) ≠ 0 := by exact_mod_cast norm_ne_zero_iff.mpr h
    rw [div_mul_eq_mul_div, Complex.conj_mul', div_eq_iff hn]
    ring

theorem norm_unitOf_le (z : ℂ) : ‖unitOf z‖ ≤ 1 := by
  unfold unitOf
  split_ifs with h
  · simp
  · rw [norm_div, RCLike.norm_conj, Complex.norm_real, Real.norm_of_nonneg (norm_nonneg _),
      div_self (norm_ne_zero_iff.mpr h)]

theorem measurable_unitOf : Measurable unitOf := by
  unfold unitOf
  exact Measurable.ite (measurableSet_singleton 0) measurable_const
    (Complex.continuous_conj.measurable.div (Complex.measurable_ofReal.comp measurable_norm))

theorem maPhase_natDegree_le' {m l k : ℕ} {ζ : ℕ → E3 → ℝ} {θ : ℕ → ℝ}
    {P : ℕ → Polynomial ℝ} (hP : ∀ i ∈ Finset.Icc m k, (P i).natDegree ≤ 3) (hml : m ≤ l + 1)
    (hlk : l ≤ k) (x : E3) : (maPhase m l k ζ θ P x).natDegree ≤ 3 := by
  unfold maPhase
  refine (Polynomial.natDegree_add_le _ _).trans (max_le ?_ ?_)
  · refine Polynomial.natDegree_sum_le_of_forall_le _ _ fun i hi => ?_
    have hi' : i ∈ Finset.Icc m k := by
      rw [Finset.mem_Icc] at hi ⊢; exact ⟨hi.1, hi.2.trans hlk⟩
    exact (Polynomial.natDegree_C_mul_le _ _).trans (hP i hi')
  · refine Polynomial.natDegree_sum_le_of_forall_le _ _ fun i hi => ?_
    have hi' : i ∈ Finset.Icc m k := by
      rw [Finset.mem_Icc] at hi ⊢; exact ⟨by omega, hi.2⟩
    exact (Polynomial.natDegree_C_mul_le _ _).trans (hP i hi')

/-- The section integrand `F_t(y, z)` of `patch:conditional-degree`, cut off to `t ∈ [0, N]`. -/
noncomputable def cdlFt (N : ℝ) (m l k : ℕ) (f : ℕ → E3 → ℂ) (P : ℕ → Polynomial ℝ)
    (ξ : ℕ → E3 → ℝ) (η : ℕ → ℝ) (j : ℕ → Fin 3) (t : ℝ) (y : Fin 2 → ℝ) (z : ℝ) : ℂ :=
  Set.indicator (Set.Icc 0 N)
    (fun t => cdlPhi m f P (maPhase (m + 1) l k ξ η P) j t (embT (j m) y z)) t

theorem measurable_cdlFt {N : ℝ} {m l k : ℕ} (hml : m ≤ l) (hlk : l ≤ k) {f : ℕ → E3 → ℂ}
    (hf : ∀ i, Measurable (f i)) {P : ℕ → Polynomial ℝ}
    (hP3 : ∀ i ∈ Finset.Icc (m + 1) k, (P i).natDegree ≤ 3) {ξ : ℕ → E3 → ℝ}
    (hξ : ∀ i, Measurable (ξ i)) (η : ℕ → ℝ) (j : ℕ → Fin 3) :
    Measurable fun q : ℝ × (Fin 2 → ℝ) × ℝ => cdlFt N m l k f P ξ η j q.1 q.2.1 q.2.2 := by
  have hpp := measurable_phaseProd (m := m - 1) hf P
    (p := maPhase (m + 1) l k ξ η P)
    (fun x => maPhase_natDegree_le' hP3 (by omega) hlk x) (measurable_maPhase_coeff hξ η P) j
  have hx : Measurable fun q : ℝ × (Fin 2 → ℝ) × ℝ =>
      embT (j m) q.2.1 q.2.2 + (P m).eval q.1 • basisVec (j m) :=
    ((measurable_embT (j m)).comp measurable_snd).add
      (((P m).continuous.measurable.comp measurable_fst).smul_const _)
  have hphi : Measurable fun q : ℝ × (Fin 2 → ℝ) × ℝ =>
      cdlPhi m f P (maPhase (m + 1) l k ξ η P) j q.1 (embT (j m) q.2.1 q.2.2) := by
    have h := ((hf 0).comp hx).mul (hpp.comp (hx.prodMk measurable_fst))
    exact h
  have e : (fun q : ℝ × (Fin 2 → ℝ) × ℝ => cdlFt N m l k f P ξ η j q.1 q.2.1 q.2.2)
      = (Prod.fst ⁻¹' Set.Icc 0 N).indicator fun q : ℝ × (Fin 2 → ℝ) × ℝ =>
        cdlPhi m f P (maPhase (m + 1) l k ξ η P) j q.1 (embT (j m) q.2.1 q.2.2) := by
    funext q; simp only [cdlFt, Set.indicator, Set.mem_preimage]
  rw [e]
  exact hphi.indicator (measurable_fst measurableSet_Icc)

theorem norm_cdlFt_le {N : ℝ} {m l k : ℕ} {f : ℕ → E3 → ℂ} (hf1 : ∀ i x, ‖f i x‖ ≤ 1)
    (P : ℕ → Polynomial ℝ) (ξ : ℕ → E3 → ℝ) (η : ℕ → ℝ) (j : ℕ → Fin 3) (t : ℝ)
    (y : Fin 2 → ℝ) (z : ℝ) : ‖cdlFt N m l k f P ξ η j t y z‖ ≤ 1 := by
  rw [cdlFt]
  by_cases ht : t ∈ Set.Icc 0 N
  · rw [Set.indicator_of_mem ht, cdlPhi, norm_mul]
    exact ((mul_le_of_le_one_left (norm_nonneg _) (hf1 0 _)).trans (norm_phaseProd_le _ hf1 _ _ _
      _ _))
  · rw [Set.indicator_of_notMem ht, norm_zero]; exact zero_le_one

/-- The section integrand vanishes off the transverse box of the first input. -/
theorem cdlFt_eq_zero_of_trans {N C : ℝ} {m l k : ℕ} {f : ℕ → E3 → ℂ}
    (hfs : ∀ x, x ∉ petBox C N → f 0 x = 0) (P : ℕ → Polynomial ℝ) (ξ : ℕ → E3 → ℝ)
    (η : ℕ → ℝ) (j : ℕ → Fin 3) (t : ℝ) {y : Fin 2 → ℝ} (hy : y ∉ transBox (j m) C N) (z : ℝ) :
    cdlFt N m l k f P ξ η j t y z = 0 := by
  rw [cdlFt]
  by_cases ht : t ∈ Set.Icc 0 N
  · rw [Set.indicator_of_mem ht, cdlPhi, hfs _ (fun h => hy (mem_of_embT_mem_petBox h).1),
      zero_mul]
  · rw [Set.indicator_of_notMem ht]

/-- The section integrand vanishes off `|z| ≤ 5 u N^{d_m}`. -/
theorem cdlFt_eq_zero_of_far {N : ℝ} (hN : 1 ≤ N) {c : ℕ} (hc : 1 ≤ c) {δ : ℝ} (hδ0 : 0 < δ)
    {m l k : ℕ} {f : ℕ → E3 → ℂ} (hfs : ∀ x, x ∉ petBox (budHi c δ) N → f 0 x = 0)
    {P : ℕ → Polynomial ℝ} {j : ℕ → Fin 3} (hdm : expo (j m) ≤ 3)
    (hPm : AdmissiblePoly c δ N (expo (j m)) (P m)) (ξ : ℕ → E3 → ℝ) (η : ℕ → ℝ) (t : ℝ)
    (y : Fin 2 → ℝ) {z : ℝ}
    (hz : z ∉ Set.Icc (-(5 * budHi c δ * N ^ expo (j m)))
      (-(5 * budHi c δ * N ^ expo (j m)) + 10 * budHi c δ * N ^ expo (j m))) :
    cdlFt N m l k f P ξ η j t y z = 0 := by
  rw [cdlFt]
  by_cases ht : t ∈ Set.Icc 0 N
  · rw [Set.indicator_of_mem ht, cdlPhi]
    have hP := abs_eval_le_of_admissible hN hdm hPm hc hδ0 ht
    rw [hfs _ (fun h => hz ?_), zero_mul]
    have h2 := (mem_of_embT_mem_petBox h).2
    have hP1 := (abs_le.mp hP).1
    have hP2 := (abs_le.mp hP).2
    constructor <;> linarith [h2.1, h2.2]
  · rw [Set.indicator_of_notMem ht]

/-- The part of `MA(m, l)` after the choice of the output budget: the conclusion for the input
budget `c₁` and the output budget `C` at fixed `δ, N`. -/
def MAAt (k : ℕ) (j : ℕ → Fin 3) (m l c₁ C : ℕ) (δ N : ℝ) : Prop :=
  ∀ (P : ℕ → Polynomial ℝ) (g : ℕ → E3 → ℂ) (ζ : ℕ → E3 → ℝ) (θ : ℕ → ℝ),
    (∀ i ∈ Finset.Icc 1 k, AdmissiblePoly c₁ δ N (expo (j i)) (P i)) →
    (∀ i, Measurable (g i)) → (∀ i y, ‖g i y‖ ≤ 1) →
    (∀ i y, y ∉ petBox (budHi c₁ δ) N → g i y = 0) →
    (∀ i, Measurable (ζ i)) →
    budLo c₁ δ * N ^ (6 : ℕ) ≤ ‖phaseCorr N (m - 1) g P (maPhase m l k ζ θ P) j‖ →
    budLo C δ * N ^ (6 : ℕ) ≤ (volume (maSet m l k j C δ N ζ θ)).toReal

/-- The paired cubes of a function supported in `petBox u N` are supported in `petBox u' N` when the
shifts along `e_m` are at most `(u' - u) N^{d_m}`. -/
theorem dirCube_eq_zero_of_box {r : ℕ} {f : E3 → ℂ} {u u' N : ℝ} (hN : 0 ≤ N)
    (hfs : ∀ x, x ∉ petBox u N → f x = 0) {jm : Fin 3} {b c : Fin r → ℝ}
    (hb : 0 ≤ ∑ i, b i) (hbu : ∑ i, b i ≤ (u' - u) * N ^ expo jm) (huu : u ≤ u') {x : E3}
    (hx : x ∉ petBox u' N) : dirCube f (basisVec jm) b c x = 0 := by
  refine dirCube_eq_zero (hfs _ fun h => hx fun i => ?_)
  have hi := h i
  have hNi : 0 ≤ N ^ expo i := pow_nonneg hN _
  by_cases hij : i = jm
  · subst hij
    simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, basisVec_apply_self, mul_one] at hi
    constructor
    · nlinarith [hi.1]
    · nlinarith [hi.2]
  · simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, basisVec_apply_ne hij, mul_zero,
      add_zero] at hi
    constructor
    · nlinarith [hi.1]
    · nlinarith [hi.2]

set_option maxHeartbeats 1000000 in
-- The unit phase, the identity of Step 5 and the projection of the canonical set share one context.
/-- **`patch:conditional-degree`, Step 5: the application of `MA(m, l)`.** A lower bound `thr` for
`E_y |S⁻¹ ∫ G_{y,b,c}(z) e(ψ(y) z) dz|` over the normalized transverse box gives, through
`MA(m, l)` applied to the correlation of `Auto.cdl_step5_identity` (with `ψ` replaced by `B + 1` off
the box), a lower bound for the measure of `{|ψ| ≤ u_C(δ) N^{-d_m}}`. -/
theorem cdl_step5 {r : ℕ} (hr : 1 ≤ r) {N : ℝ} (hN : 1 ≤ N) {δ : ℝ} (hδ0 : 0 < δ)
    (hδ1 : δ ≤ 1) {k m l : ℕ} (hm : 1 ≤ m) (hml : m ≤ l) (hlk : l ≤ k) {j : ℕ → Fin 3}
    {c c₁ C : ℕ} (hc : 1 ≤ c) (hcc : c ≤ c₁) (hC : 1 ≤ C)
    (hMA : MAAt k j m l c₁ C δ N) {f : ℕ → E3 → ℂ} (hf : ∀ i, Measurable (f i))
    (hf1 : ∀ i x, ‖f i x‖ ≤ 1) (hfs : ∀ i x, x ∉ petBox (budHi c δ) N → f i x = 0)
    {P : ℕ → Polynomial ℝ} (hadm : ∀ i ∈ Finset.Icc 1 k, AdmissiblePoly c δ N (expo (j i)) (P i))
    {ξ : ℕ → E3 → ℝ} (hξ : ∀ i, Measurable (ξ i)) (η : ℕ → ℝ) {H S : ℝ} (hS : 0 < S)
    (hH : H ≤ budHi c δ * N ^ expo (j m))
    (hbox : (1 + r) * budHi c δ ≤ budHi c₁ δ) (b c' : Fin r → ℝ) (hb : ∀ i, b i ∈ Set.Icc 0 H)
    {thr : ℝ} (hthr0 : budLo c₁ δ * N ^ (6 : ℕ)
      ≤ (volume (transBox (j m) (budHi c δ) N)).toReal * S * thr)
    (ψ : (Fin 2 → ℝ) → ℝ) (hψ : Measurable ψ)
    (hint : thr ≤ ∫ y, ‖cdlCoef S (cdlG (unifIcc 0 N) (cdlFt N m l k f P ξ η j) y b c') (ψ y)‖
      ∂(transMeas (j m) (budHi c δ) N)) :
    budLo C δ * N ^ (6 : ℕ) / (2 * budHi C δ * N ^ expo (j m)
        * (volume (transBox (j m) (budHi c δ) N)).toReal)
      ≤ (transMeas (j m) (budHi c δ) N {y | |ψ y| ≤ budHi C δ / N ^ expo (j m)}).toReal := by
  classical
  have hN0 : 0 < N := by linarith
  have hCin : 0 < budHi c δ := budHi_pos hδ0 hc
  have := isProbabilityMeasure_transMeas (j m) hCin hN0
  set Yin := transBox (j m) (budHi c δ) N with hYin
  set μY := transMeas (j m) (budHi c δ) N with hμY
  set B := budHi C δ / N ^ expo (j m) with hB
  have hNd : 0 < N ^ expo (j m) := pow_pos hN0 _
  have hB0 : 0 < B := div_pos (budHi_pos hδ0 hC) hNd
  set ψ' : (Fin 2 → ℝ) → ℝ := fun y => if y ∈ Yin then ψ y else B + 1 with hψ'
  have hψ'm : Measurable ψ' := Measurable.ite (measurableSet_transBox _ _ _) hψ measurable_const
  set Ft := cdlFt N m l k f P ξ η j with hFt
  have hP3 : ∀ i ∈ Finset.Icc (m + 1) k, (P i).natDegree ≤ 3 := by
    intro i hi
    rw [(hadm i (by rw [Finset.mem_Icc] at hi ⊢; omega)).natDegree_eq]
    exact Nat.succ_le_of_lt (Fin.is_lt _)
  have hFtm := measurable_cdlFt (N := N) hml hlk hf hP3 hξ η j
  have hGm : Measurable (Function.uncurry fun (y : Fin 2 → ℝ) (z : ℝ) =>
      cdlG (unifIcc 0 N) Ft y b c' z) := by
    have hmap : Measurable fun q : (Fin 2 → ℝ) × ℝ =>
        (((q.1, (b, c')) : (Fin 2 → ℝ) × ((Fin r → ℝ) × (Fin r → ℝ))), q.2) :=
      (measurable_fst.prodMk measurable_const).prodMk measurable_snd
    have h := (measurable_cdlG (ν := unifIcc 0 N) hFtm r).comp hmap
    exact h
  set coef : (Fin 2 → ℝ) → ℂ := fun y => cdlCoef S (cdlG (unifIcc 0 N) Ft y b c') (ψ' y)
    with hcoef
  have hcoefm : Measurable coef := by
    have h := (measurable_coef_param hGm hψ'm).const_mul ((S : ℂ)⁻¹)
    exact h
  set u : (Fin 2 → ℝ) → ℂ := fun y => unitOf (coef y) with hu
  have hum : Measurable u := measurable_unitOf.comp hcoefm
  have hu1 : ∀ y, ‖u y‖ ≤ 1 := fun y => norm_unitOf_le _
  -- the sections vanish off the transverse box
  have hG0 : ∀ y, y ∉ Yin → ∀ z, cdlG (unifIcc 0 N) Ft y b c' z = 0 := by
    intro y hy z
    rw [cdlG, integral_congr_ae (Eventually.of_forall fun t => cubeProdSel_eq_zero_of_head
      (v := fun β => Ft t y (z + ∑ i, β i)) (cdlFt_eq_zero_of_trans (hfs 0) P ξ η j t hy _))]
    simp
  have hcoef0 : ∀ y, y ∉ Yin → coef y = 0 := by
    intro y hy
    simp only [hcoef, cdlCoef]
    rw [integral_congr_ae (Eventually.of_forall fun z => by rw [hG0 y hy z, zero_mul])]
    simp
  -- the identity of Step 5
  have hid := cdl_step5_identity (k := k) hr hN0 hml hf hf1 (hfs 0) P hξ η j b c' hψ'm hum hu1
  have hS0 : (S : ℂ) ≠ 0 := by exact_mod_cast hS.ne'
  have hinner : ∀ y, (∫ z, cdlG (unifIcc 0 N) Ft y b c' z * ephase (ψ' y * z))
      = (S : ℂ) * coef y := by
    intro y
    simp only [hcoef, cdlCoef]
    rw [← mul_assoc, mul_inv_cancel₀ hS0, one_mul]
  have hL : (∫ y, u y * ∫ z, cdlG (unifIcc 0 N) (fun t y z => Set.indicator (Set.Icc 0 N)
      (fun t => cdlPhi m f P (maPhase (m + 1) l k ξ η P) j t (embT (j m) y z)) t) y b c' z
      * ephase (ψ' y * z)) = ((S * ∫ y, ‖coef y‖ : ℝ) : ℂ) := by
    have e1 : ∀ y, u y * (∫ z, cdlG (unifIcc 0 N) (fun t y z => Set.indicator (Set.Icc 0 N)
        (fun t => cdlPhi m f P (maPhase (m + 1) l k ξ η P) j t (embT (j m) y z)) t) y b c' z
        * ephase (ψ' y * z)) = ((S * ‖coef y‖ : ℝ) : ℂ) := by
      intro y
      change u y * (∫ z, cdlG (unifIcc 0 N) Ft y b c' z * ephase (ψ' y * z)) = _
      rw [hinner y, mul_left_comm, hu]
      simp only
      rw [unitOf_mul]
      push_cast
      ring
    simp_rw [e1]
    rw [integral_complex_ofReal, integral_const_mul]
  rw [hL] at hid
  -- the measure normalization
  have hvolY := volume_transBox (j m) hCin.le hN0.le
  set V := (volume Yin).toReal with hV
  have hVpos : 0 < V := by
    have h : V = (2 * budHi c δ) ^ 2 * N ^ (6 - expo (j m)) := hvolY
    rw [h]; positivity
  have hcoefY : (∫ y, ‖coef y‖) = V * ∫ y, ‖coef y‖ ∂μY := by
    have h1 : (∫ y, ‖coef y‖) = ∫ y in Yin, ‖coef y‖ :=
      (setIntegral_eq_integral_of_forall_compl_eq_zero fun y hy => by
        rw [hcoef0 y hy, norm_zero]).symm
    rw [h1, hμY, transMeas, integral_smul_measure, ENNReal.toReal_inv, smul_eq_mul, ← hV,
      ← mul_assoc, mul_inv_cancel₀ hVpos.ne', one_mul]
  have hψψ' : (∫ y, ‖coef y‖ ∂μY) = ∫ y, ‖cdlCoef S (cdlG (unifIcc 0 N) Ft y b c') (ψ y)‖ ∂μY := by
    have hae : ∀ᵐ y ∂μY, y ∈ Yin := by
      rw [hμY, transMeas]
      exact Measure.smul_absolutelyContinuous.ae_le
        (ae_restrict_mem (measurableSet_transBox _ _ _))
    refine integral_congr_ae (hae.mono fun y hy => ?_)
    simp only [hcoef, hψ', ite_eq_left hy]
  -- the lower bound for the correlation
  have hcorr : budLo c₁ δ * N ^ (6 : ℕ) ≤ ‖phaseCorr N (m - 1) (cdlGs f (j m) b c' ψ' u) P
      (maPhase m l k (cdlZs ξ m (j m) b c' ψ') (fun _ => 0) P) j‖ := by
    rw [← hid, Complex.norm_real, Real.norm_of_nonneg (mul_nonneg hS.le
      (integral_nonneg fun y => norm_nonneg _)), hcoefY, hψψ']
    calc budLo c₁ δ * N ^ (6 : ℕ) ≤ V * S * thr := hthr0
      _ ≤ V * S * ∫ y, ‖cdlCoef S (cdlG (unifIcc 0 N) Ft y b c') (ψ y)‖ ∂μY :=
          mul_le_mul_of_nonneg_left hint (by positivity)
      _ = _ := by ring
  -- the hypotheses of `MA(m, l)`
  have hsb0 : 0 ≤ ∑ i, b i := Finset.sum_nonneg fun i _ => (hb i).1
  have hsbu : ∑ i, b i ≤ (budHi c₁ δ - budHi c δ) * N ^ expo (j m) := by
    calc ∑ i, b i ≤ ∑ _i : Fin r, H := Finset.sum_le_sum fun i _ => (hb i).2
      _ = r * H := by simp
      _ ≤ r * (budHi c δ * N ^ expo (j m)) := mul_le_mul_of_nonneg_left hH (by positivity)
      _ ≤ (budHi c₁ δ - budHi c δ) * N ^ expo (j m) := by
          have : (r : ℝ) * budHi c δ ≤ budHi c₁ δ - budHi c δ := by linarith
          nlinarith
  have hcu : budHi c δ ≤ budHi c₁ δ := by nlinarith [hCin]
  have hgm : ∀ i, Measurable (cdlGs f (j m) b c' ψ' u i) := by
    intro i
    unfold cdlGs
    split_ifs
    · unfold cdlG0
      exact ((hum.comp (measurable_projT _)).mul (measurable_dirCube (hf 0) _ b c')).mul
        (continuous_ephase.measurable.comp ((hψ'm.comp (measurable_projT _)).mul
          (continuous_coord _).measurable))
    · exact measurable_dirCube (hf i) _ b c'
  have hg1 : ∀ i x, ‖cdlGs f (j m) b c' ψ' u i x‖ ≤ 1 := by
    intro i x
    unfold cdlGs
    split_ifs
    · unfold cdlG0
      rw [norm_mul, norm_mul, norm_ephase, mul_one]
      exact ((mul_le_of_le_one_left (norm_nonneg _) (hu1 _)).trans (norm_dirCube_le (hf1 0) _ _ _
        _))
    · exact norm_dirCube_le (hf1 i) _ _ _ _
  have hgs : ∀ i x, x ∉ petBox (budHi c₁ δ) N → cdlGs f (j m) b c' ψ' u i x = 0 := by
    intro i x hx
    have hd : ∀ i', dirCube (f i') (basisVec (j m)) b c' x = 0 := fun i' =>
      dirCube_eq_zero_of_box hN0.le (hfs i') hsb0 hsbu hcu hx
    unfold cdlGs
    split_ifs
    · unfold cdlG0; rw [hd 0]; ring
    · exact hd i
  have hζm : ∀ i, Measurable (cdlZs ξ m (j m) b c' ψ' i) := by
    intro i
    unfold cdlZs
    split_ifs
    · exact (hψ'm.comp (measurable_projT _)).neg
    · exact measurable_cdlZeta' (hξ i) _ b c'
  have hMAc := hMA P (cdlGs f (j m) b c' ψ' u) (cdlZs ξ m (j m) b c' ψ') (fun _ => 0)
    (fun i hi => (hadm i hi).mono hδ0 hδ1 hc hcc hN0.le) hgm hg1 hgs hζm hcorr
  -- the canonical set lies over the small-frequency points of the transverse box
  set A := {y | y ∈ Yin ∧ |ψ y| ≤ B} with hA
  have hAm : MeasurableSet A :=
    (measurableSet_transBox _ _ _).inter (measurableSet_le (continuous_abs.measurable.comp hψ)
      measurable_const)
  set T := {x : E3 | x ∈ petBox (budHi C δ) N ∧ |ψ' (projT (j m) x)| ≤ B} with hT
  have hTm : MeasurableSet T :=
    (isClosed_petBox _ _).measurableSet.inter (measurableSet_le (continuous_abs.measurable.comp
      (hψ'm.comp (measurable_projT _))) measurable_const)
  have hsub : maSet m l k j C δ N (cdlZs ξ m (j m) b c' ψ') (fun _ => 0) ⊆ T := by
    intro x hx
    obtain ⟨hbx, hsize⟩ := hx
    refine ⟨hbx, ?_⟩
    have hmem : m ∈ Finset.Icc m l := Finset.mem_Icc.mpr ⟨le_rfl, hml⟩
    have h1 : N ^ expo (j m) * |cdlZs ξ m (j m) b c' ψ' m x|
        ≤ ∑ i ∈ Finset.Icc m l, N ^ expo (j i) * |cdlZs ξ m (j m) b c' ψ' i x| :=
      Finset.single_le_sum (f := fun i => N ^ expo (j i) * |cdlZs ξ m (j m) b c' ψ' i x|)
        (fun i _ => by positivity) hmem
    have h2 : 0 ≤ ∑ i ∈ Finset.Icc (l + 1) k, N ^ expo (j i) * |(fun _ : ℕ => (0 : ℝ)) i| := by
      simp
    have hzm : cdlZs ξ m (j m) b c' ψ' m x = -ψ' (projT (j m) x) := by simp [cdlZs]
    rw [hzm, abs_neg] at h1
    have h3 : N ^ expo (j m) * |ψ' (projT (j m) x)| ≤ budHi C δ := by
      have := hsize
      simp only [maSize] at this
      linarith
    rw [hB, le_div_iff₀ hNd]
    linarith
  have hTfin : volume T ≠ ⊤ := by
    obtain ⟨R₀, hR₀⟩ := (isBounded_petBox (budHi C δ) N).subset_closedBall (0 : E3)
    exact ne_top_of_le_ne_top (measure_closedBall_lt_top (x := (0 : E3)) (r := R₀)).ne
      (measure_mono fun x hx => hR₀ hx.1)
  have hmass : budLo C δ * N ^ (6 : ℕ) ≤ (volume T).toReal :=
    hMAc.trans (ENNReal.toReal_mono hTfin (measure_mono hsub))
  have hCu : 0 < budHi C δ := budHi_pos hδ0 hC
  have hden : 0 < 2 * budHi C δ * N ^ expo (j m) := mul_pos (mul_pos two_pos hCu) hNd
  have hTA : (volume T).toReal ≤ 2 * budHi C δ * N ^ expo (j m) * (volume A).toReal := by
    have hle : volume T ≤ volume A * ENNReal.ofReal (2 * budHi C δ * N ^ expo (j m)) := by
      rw [← lintegral_indicator_one hTm, lintegral_embT (j m)
        (measurable_one.indicator hTm)]
      calc ∫⁻ y, ∫⁻ z, T.indicator 1 (embT (j m) y z)
          ≤ ∫⁻ y, A.indicator 1 y * ∫⁻ z : ℝ, (Set.Icc (-(budHi C δ * N ^ expo (j m)))
              (budHi C δ * N ^ expo (j m))).indicator 1 z := by
            refine lintegral_mono fun y => ?_
            rw [← lintegral_const_mul _ (measurable_one.indicator measurableSet_Icc)]
            refine lintegral_mono fun z => ?_
            by_cases hz : embT (j m) y z ∈ T
            · obtain ⟨hzb, hzψ⟩ := hz
              rw [projT_embT] at hzψ
              have hyA : y ∈ A := by
                by_cases hy : y ∈ Yin
                · simp only [hψ', ite_eq_left hy] at hzψ; exact ⟨hy, hzψ⟩
                · simp only [hψ', ite_eq_right hy] at hzψ
                  exfalso; rw [abs_of_pos (by linarith)] at hzψ; linarith
              have hzI : z ∈ Set.Icc (-(budHi C δ * N ^ expo (j m)))
                  (budHi C δ * N ^ expo (j m)) := by
                have := (mem_of_embT_mem_petBox (s := 0) (by rw [zero_smul, add_zero]; exact hzb)).2
                simpa using this
              rw [Set.indicator_of_mem (show embT (j m) y z ∈ T from ⟨hzb, by
                rw [projT_embT]; exact hzψ⟩), Set.indicator_of_mem hyA,
                Set.indicator_of_mem hzI]
              simp
            · rw [Set.indicator_of_notMem hz]; exact bot_le
        _ = ∫⁻ y, A.indicator 1 y * ENNReal.ofReal (2 * budHi C δ * N ^ expo (j m)) := by
            refine lintegral_congr fun y => ?_
            rw [lintegral_indicator_one measurableSet_Icc, Real.volume_Icc]
            congr 2; ring
        _ = volume A * ENNReal.ofReal (2 * budHi C δ * N ^ expo (j m)) := by
            rw [lintegral_mul_const _ (measurable_one.indicator hAm), lintegral_indicator_one hAm]
    have hAfin : volume A ≠ ⊤ :=
      ne_top_of_le_ne_top (volume_transBox_lt_top (j m) _ _).ne (measure_mono fun y hy => hy.1)
    have := ENNReal.toReal_mono (ENNReal.mul_ne_top hAfin ENNReal.ofReal_ne_top) hle
    rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal hden.le] at this
    linarith
  have hμA : (μY {y | |ψ y| ≤ B}).toReal = (volume A).toReal / V := by
    rw [hμY, measure_transMeas (j m) (A := {y | |ψ y| ≤ B})
      (measurableSet_le (continuous_abs.measurable.comp hψ) measurable_const)]
    have hset : {y | |ψ y| ≤ B} ∩ transBox (j m) (budHi c δ) N = A := by
      ext y; simp only [hA, hYin, Set.mem_inter_iff, Set.mem_ofPred_eq]; tauto
    rw [hset]
  rw [hμA, div_le_div_iff₀ (mul_pos hden hVpos) hVpos]
  nlinarith

end

/-! ### `patch:conditional-degree`: power bounds for the explicit thresholds -/

section
open Filter Topology MeasureTheory

theorem MonoLow.sqrt {F : ℝ → ℝ} (hF : MonoLow F) : MonoLow fun δ => Real.sqrt (F δ) := by
  obtain ⟨A, hA, a, hFa⟩ := hF
  refine ⟨Real.sqrt A, Real.sqrt_pos.mpr hA, a, fun δ h0 h1 => ?_⟩
  have hda : δ ^ a ≤ 1 := pow_le_one₀ h0.le h1
  have hd0 : 0 ≤ δ ^ a := pow_nonneg h0.le a
  calc Real.sqrt A * δ ^ a ≤ Real.sqrt A * Real.sqrt (δ ^ a) := by
        refine mul_le_mul_of_nonneg_left ?_ (Real.sqrt_nonneg _)
        rw [Real.le_sqrt hd0 hd0]
        nlinarith
    _ = Real.sqrt (A * δ ^ a) := (Real.sqrt_mul hA.le _).symm
    _ ≤ Real.sqrt (F δ) := Real.sqrt_le_sqrt (hFa δ h0 h1)

theorem MonoLow.mul_const {F : ℝ → ℝ} (hF : MonoLow F) {c : ℝ} (hc : 0 < c) :
    MonoLow fun δ => F δ * c := hF.mul (monoLow_const hc)

theorem MonoHigh.mul_const {F : ℝ → ℝ} (hF : MonoHigh F) {c : ℝ} (hc : 0 < c) :
    MonoHigh fun δ => F δ * c := hF.mul (monoHigh_const hc)

/-- The explicit lower bound for `Auto.cdlThr` in terms of `a ≥ aL`, `hL ≤ H/S ≤ hH`. -/
noncomputable def cdlThrLow (aL hL hH : ℝ) (r : ℕ) : ℝ :=
  let bL := hL / 2 * Real.sqrt (aL / 2)
  let TH := 1 + r * hH
  let dL := (bL ^ 2 * (aL / 4)) ^ (2 ^ r) / TH ^ (2 * (2 ^ r - 1))
  aL / 4 * (dL / 2) / 2 * Real.sqrt (dL / 2)

/-- The explicit lower bound for `Auto.cdlOut` in terms of `a ≥ aL`, `hL ≤ H/S ≤ hH`,
`(|c| + S + rH)/S ≤ κ`, `B S ≤ β` and `ρ ≥ ρL`. -/
noncomputable def cdlOutLow (aL hL hH κ β ρL : ℝ) (r : ℕ) : ℝ :=
  let bL := hL / 2 * Real.sqrt (aL / 2)
  let TH := 1 + r * hH
  let dL := (bL ^ 2 * (aL / 4)) ^ (2 ^ r) / TH ^ (2 * (2 ^ r - 1))
  let mL := aL / 4 * (dL / 2) / 4 * ρL / (4 * Real.pi * β * κ / bL + 2)
  mL / 2 * (((bL / 2) ^ 2 * (mL / 2)) ^ (2 ^ r) / (TH ^ (2 * (2 ^ r - 1)) * (1 + hH)))

theorem cdlB0_ge {a H S aL hL : ℝ} (hS : 0 < S) (ha : aL ≤ a) (hhL : 0 ≤ hL)
    (hh : hL ≤ H / S) : hL / 2 * Real.sqrt (aL / 2) ≤ cdlB0 a H S := by
  unfold cdlB0
  have : H / (2 * S) = H / S / 2 := by field_simp
  rw [this]
  exact mul_le_mul (div_le_div_of_nonneg_right hh (by norm_num))
    (Real.sqrt_le_sqrt (by linarith)) (Real.sqrt_nonneg _) (by
      have : 0 ≤ H / S := hhL.trans hh
      positivity)

theorem cdlT_le {H S hH : ℝ} (hS : 0 < S) (r : ℕ) (hh : H / S ≤ hH) :
    cdlT H S r ≤ 1 + r * hH := by
  unfold cdlT
  have hS' : (S + r * H) / S = 1 + r * (H / S) := by field_simp
  rw [hS']
  have : (0 : ℝ) ≤ r := Nat.cast_nonneg r
  nlinarith

theorem cdlD_ge {a H S aL hL hH : ℝ} (hS : 0 < S) (hH0 : 0 < H) (haL : 0 < aL) (ha : aL ≤ a)
    (hhL : 0 < hL) (hh : hL ≤ H / S) (hh' : H / S ≤ hH) (r : ℕ) :
    ((hL / 2 * Real.sqrt (aL / 2)) ^ 2 * (aL / 4)) ^ (2 ^ r) / (1 + r * hH) ^ (2 * (2 ^ r - 1))
      ≤ cdlD a H S r := by
  have hb := cdlB0_ge hS ha hhL.le hh
  have hbL : 0 ≤ hL / 2 * Real.sqrt (aL / 2) := by positivity
  have hT := cdlT_le hS r hh'
  have hH0' : 0 < hH := lt_of_lt_of_le (div_pos hH0 hS) hh'
  have hT0 : 0 < cdlT H S r := cdlT_pos hH0 hS r
  unfold cdlD
  refine div_le_div₀ (pow_nonneg (mul_nonneg (sq_nonneg _) (by linarith)) _) ?_ (pow_pos hT0 _)
    (pow_le_pow_left₀ hT0.le hT _)
  exact pow_le_pow_left₀ (by positivity) (mul_le_mul (pow_le_pow_left₀ hbL hb 2)
    (by linarith) (by positivity) (by positivity)) _

theorem cdlThr_ge {a H S aL hL hH : ℝ} (hS : 0 < S) (hH0 : 0 < H) (haL : 0 < aL) (ha : aL ≤ a)
    (hhL : 0 < hL) (hh : hL ≤ H / S) (hh' : H / S ≤ hH) (r : ℕ) :
    cdlThrLow aL hL hH r ≤ cdlThr a H S r := by
  have hd := cdlD_ge hS hH0 haL ha hhL hh hh' r
  have hdL : 0 ≤ ((hL / 2 * Real.sqrt (aL / 2)) ^ 2 * (aL / 4)) ^ (2 ^ r)
      / (1 + r * hH) ^ (2 * (2 ^ r - 1)) := by
    have : 0 ≤ H / S := hhL.le.trans hh
    have : 0 ≤ hH := this.trans hh'
    positivity
  unfold cdlThrLow cdlThr cdlZ0
  simp only
  have ha0 : 0 ≤ a := by linarith
  have h1 : aL / 4 * ((((hL / 2 * Real.sqrt (aL / 2)) ^ 2 * (aL / 4)) ^ (2 ^ r)
      / (1 + r * hH) ^ (2 * (2 ^ r - 1))) / 2) / 2 ≤ a / 4 * (cdlD a H S r / 2) / 2 := by
    gcongr
  have hD := cdlD_pos (lt_of_lt_of_le haL ha) hH0 hS r
  exact mul_le_mul h1 (Real.sqrt_le_sqrt (by linarith)) (Real.sqrt_nonneg _)
    (div_nonneg (mul_nonneg (by linarith) (div_nonneg hD.le two_pos.le)) two_pos.le)

theorem cdlOut_ge {a H S c aL hL hH κ β ρL B ρ : ℝ} (hS : 0 < S) (hH0 : 0 < H) (haL : 0 < aL)
    (ha : aL ≤ a) (hhL : 0 < hL) (hh : hL ≤ H / S) (hh' : H / S ≤ hH) (r : ℕ)
    (hκ : (|c| + S + r * H) / S ≤ κ) (hB : 0 < B) (hβ : B * S ≤ β) (hρL : 0 < ρL)
    (hρ : ρL ≤ ρ) : cdlOutLow aL hL hH κ β ρL r ≤ cdlOut a H S c r B ρ := by
  have hb := cdlB0_ge hS ha hhL.le hh
  have hbL : 0 < hL / 2 * Real.sqrt (aL / 2) := by
    have := Real.sqrt_pos.mpr (by positivity : 0 < aL / 2); positivity
  have hb0 : 0 < cdlB0 a H S := lt_of_lt_of_le hbL hb
  have hT := cdlT_le hS r hh'
  have hT0 : 0 < cdlT H S r := cdlT_pos hH0 hS r
  have hH0' : 0 < hH := lt_of_lt_of_le (div_pos hH0 hS) hh'
  have hd := cdlD_ge hS hH0 haL ha hhL hh hh' r
  have hdL : 0 < ((hL / 2 * Real.sqrt (aL / 2)) ^ 2 * (aL / 4)) ^ (2 ^ r)
      / (1 + r * hH) ^ (2 * (2 ^ r - 1)) := by positivity
  have ha0 : 0 < a := lt_of_lt_of_le haL ha
  have hz : aL / 4 * ((((hL / 2 * Real.sqrt (aL / 2)) ^ 2 * (aL / 4)) ^ (2 ^ r)
      / (1 + r * hH) ^ (2 * (2 ^ r - 1))) / 2) ≤ cdlZ0 a H S r := by
    unfold cdlZ0; gcongr
  have hZ0 : 0 < |c| + S + r * H := by positivity
  have hκ0 : 0 < κ := lt_of_lt_of_le (div_pos hZ0 hS) hκ
  have hβ0 : 0 < β := lt_of_lt_of_le (mul_pos hB hS) hβ
  -- the number of frequency cells
  have hq : ((⌈2 * B / cdlDelta a H S c r⌉₊ + 1 : ℕ) : ℝ)
      ≤ 4 * Real.pi * β * κ / (hL / 2 * Real.sqrt (aL / 2)) + 2 := by
    have hΔ := cdlDelta_pos c ha0 hH0 hS r
    have hx : 0 ≤ 2 * B / cdlDelta a H S c r := by positivity
    have hc1 : (⌈2 * B / cdlDelta a H S c r⌉₊ : ℝ) < 2 * B / cdlDelta a H S c r + 1 :=
      Nat.ceil_lt_add_one hx
    have h2 : 2 * B / cdlDelta a H S c r
        = 4 * Real.pi * (B * S) * ((|c| + S + r * H) / S) / cdlB0 a H S := by
      unfold cdlDelta; field_simp; ring
    have h3 : 4 * Real.pi * (B * S) * ((|c| + S + r * H) / S) / cdlB0 a H S
        ≤ 4 * Real.pi * β * κ / (hL / 2 * Real.sqrt (aL / 2)) := by
      apply div_le_div₀ (by positivity) _ hbL hb
      have : 0 ≤ (|c| + S + r * H) / S := by positivity
      have hπ : 0 < 4 * Real.pi := by positivity
      calc 4 * Real.pi * (B * S) * ((|c| + S + r * H) / S)
          ≤ 4 * Real.pi * β * ((|c| + S + r * H) / S) := by gcongr
        _ ≤ 4 * Real.pi * β * κ := by gcongr
    push_cast
    linarith
  have hqpos : 0 < ((⌈2 * B / cdlDelta a H S c r⌉₊ + 1 : ℕ) : ℝ) := by positivity
  have hm : aL / 4 * ((((hL / 2 * Real.sqrt (aL / 2)) ^ 2 * (aL / 4)) ^ (2 ^ r)
      / (1 + r * hH) ^ (2 * (2 ^ r - 1))) / 2) / 4 * ρL
        / (4 * Real.pi * β * κ / (hL / 2 * Real.sqrt (aL / 2)) + 2)
      ≤ cdlM0 a H S c r B ρ := by
    unfold cdlM0
    have hz0 := cdlZ0_pos ha0 hH0 hS r
    have hρ0 : 0 < ρ := lt_of_lt_of_le hρL hρ
    apply div_le_div₀ (mul_nonneg (div_nonneg hz0.le (by norm_num)) hρ0.le) _ hqpos hq
    exact mul_le_mul (div_le_div_of_nonneg_right hz (by norm_num)) hρ hρL.le
      (div_nonneg hz0.le (by norm_num))
  have hmL : 0 < aL / 4 * ((((hL / 2 * Real.sqrt (aL / 2)) ^ 2 * (aL / 4)) ^ (2 ^ r)
      / (1 + r * hH) ^ (2 * (2 ^ r - 1))) / 2) / 4 * ρL
        / (4 * Real.pi * β * κ / (hL / 2 * Real.sqrt (aL / 2)) + 2) := by positivity
  unfold cdlOutLow cdlOut
  simp only
  have hden : cdlT H S r ^ (2 * (2 ^ r - 1)) * (1 + H / S)
      ≤ (1 + r * hH) ^ (2 * (2 ^ r - 1)) * (1 + hH) := by
    gcongr
  have hden0 : 0 < cdlT H S r ^ (2 * (2 ^ r - 1)) * (1 + H / S) := by
    have : 0 < H / S := div_pos hH0 hS
    positivity
  refine mul_le_mul (by linarith) ?_ (by positivity) (by
    have := cdlM0_pos c ha0 hH0 hS r B (lt_of_lt_of_le hρL hρ); positivity)
  refine div_le_div₀ (by
    have := cdlM0_pos c ha0 hH0 hS r B (lt_of_lt_of_le hρL hρ); positivity) ?_ hden0 hden
  refine pow_le_pow_left₀ (by positivity) ?_ _
  exact mul_le_mul (pow_le_pow_left₀ (by positivity) (by linarith) 2) (by linarith)
    (by positivity) (by positivity)

theorem MonoLow.div_const {F : ℝ → ℝ} (hF : MonoLow F) {c : ℝ} (hc : 0 < c) :
    MonoLow fun δ => F δ / c :=
  (hF.mul (monoLow_const (inv_pos.mpr hc))).mono fun _ _ _ => le_of_eq (div_eq_mul_inv _ _).symm

theorem MonoHigh.add_const {F : ℝ → ℝ} (hF : MonoHigh F) {c : ℝ} (hc : 0 < c) :
    MonoHigh fun δ => F δ + c := hF.add (monoHigh_const hc)

theorem monoLow_cdlThrLow {aL hL : ℝ → ℝ} (ha : MonoLow aL) (hh : MonoLow hL) {hH : ℝ}
    (hH0 : 0 ≤ hH) (r : ℕ) : MonoLow fun δ => cdlThrLow (aL δ) (hL δ) hH r := by
  have hT : 0 < (1 + r * hH) ^ (2 * (2 ^ r - 1)) := by positivity
  have hb : MonoLow fun δ => hL δ / 2 * Real.sqrt (aL δ / 2) :=
    (hh.div_const two_pos).mul (ha.div_const two_pos).sqrt
  have hd : MonoLow fun δ => ((hL δ / 2 * Real.sqrt (aL δ / 2)) ^ 2 * (aL δ / 4)) ^ (2 ^ r)
      / (1 + r * hH) ^ (2 * (2 ^ r - 1)) :=
    (((hb.pow 2).mul (ha.div_const (by norm_num : (0 : ℝ) < 4))).pow _).div_const hT
  have h := (((ha.div_const (by norm_num : (0 : ℝ) < 4)).mul (hd.div_const two_pos)).div_const
    two_pos).mul (hd.div_const two_pos).sqrt
  refine h.mono fun δ _ _ => le_of_eq ?_
  simp only [cdlThrLow]

theorem monoLow_cdlOutLow {aL hL β ρL : ℝ → ℝ} (ha : MonoLow aL) (hh : MonoLow hL)
    (hβ : MonoHigh β) (hρ : MonoLow ρL) {hH κ : ℝ} (hH0 : 0 ≤ hH) (hκ : 0 < κ) (r : ℕ) :
    MonoLow fun δ => cdlOutLow (aL δ) (hL δ) hH κ (β δ) (ρL δ) r := by
  have hT : 0 < (1 + r * hH) ^ (2 * (2 ^ r - 1)) := by positivity
  have hb : MonoLow fun δ => hL δ / 2 * Real.sqrt (aL δ / 2) :=
    (hh.div_const two_pos).mul (ha.div_const two_pos).sqrt
  have hd : MonoLow fun δ => ((hL δ / 2 * Real.sqrt (aL δ / 2)) ^ 2 * (aL δ / 4)) ^ (2 ^ r)
      / (1 + r * hH) ^ (2 * (2 ^ r - 1)) :=
    (((hb.pow 2).mul (ha.div_const (by norm_num : (0 : ℝ) < 4))).pow _).div_const hT
  have hq : MonoHigh fun δ => 4 * Real.pi * β δ * κ / (hL δ / 2 * Real.sqrt (aL δ / 2)) + 2 := by
    have h1 : MonoHigh fun δ => 4 * Real.pi * β δ * κ :=
      ((monoHigh_const (by positivity : (0 : ℝ) < 4 * Real.pi)).mul hβ).mul_const hκ
    exact (h1.div hb).add_const two_pos
  have hm : MonoLow fun δ => aL δ / 4 * ((((hL δ / 2 * Real.sqrt (aL δ / 2)) ^ 2 * (aL δ / 4))
      ^ (2 ^ r) / (1 + r * hH) ^ (2 * (2 ^ r - 1))) / 2) / 4 * ρL δ
        / (4 * Real.pi * β δ * κ / (hL δ / 2 * Real.sqrt (aL δ / 2)) + 2) :=
    ((((ha.div_const (by norm_num : (0 : ℝ) < 4)).mul (hd.div_const two_pos)).div_const
      (by norm_num : (0 : ℝ) < 4)).mul hρ).div hq
  have h := (hm.div_const two_pos).mul
    ((((hb.div_const two_pos).pow 2).mul (hm.div_const two_pos)).pow (2 ^ r) |>.div_const
      (mul_pos hT (by linarith : (0 : ℝ) < 1 + hH)))
  refine h.mono fun δ _ _ => le_of_eq ?_
  simp only [cdlOutLow]

end

/-! ### `patch:conditional-degree`: the lemma on `ℝ³` -/

section
open Filter Topology MeasureTheory

/-- The parameter average of the section integrand is the adjoint-type function. -/
theorem integral_cdlFt {N : ℝ} (hN : 0 < N) (m l k : ℕ) (f : ℕ → E3 → ℂ)
    (P : ℕ → Polynomial ℝ) (ξ : ℕ → E3 → ℝ) (η : ℕ → ℝ) (j : ℕ → Fin 3) (y : Fin 2 → ℝ)
    (z : ℝ) : ∫ t, cdlFt N m l k f P ξ η j t y z ∂unifIcc 0 N
      = cdlF N m f P (maPhase (m + 1) l k ξ η P) j (embT (j m) y z) := by
  rw [integral_unifIcc hN, sub_zero, cdlF]
  congr 1
  rw [intervalIntegral.integral_of_le hN.le, ← integral_Icc_eq_integral_Ioc]
  refine setIntegral_congr_fun measurableSet_Icc fun t ht => ?_
  simp only [cdlFt, Set.indicator_of_mem ht, cdlPhi]

theorem unifPow1_zero_fun (H S : ℝ) (n : ℕ) : unifPow1 H S n (fun _ => (0 : ℂ)) = 0 := by
  have h : ∀ Q : (Fin n → ℝ) × (Fin n → ℝ),
      cubeProdSel (fun _ : Fin n → ℝ => (0 : ℂ)) Q.1 Q.2 = 0 :=
    fun Q => cubeProdSel_eq_zero_of_head rfl
  unfold unifPow1
  simp only [h]
  simp

theorem pow_add_sub_six (N : ℝ) {d : ℕ} (hd : d ≤ 6) : N ^ d * N ^ (6 - d) = N ^ (6 : ℕ) := by
  rw [← pow_add, Nat.add_sub_cancel' hd]

/-- The sections of the adjoint-type function vanish off the transverse box of the first input. -/
theorem cdlF_embT_eq_zero {N C : ℝ} {m : ℕ} {f : ℕ → E3 → ℂ}
    (hfs : ∀ x, x ∉ petBox C N → f 0 x = 0) (P : ℕ → Polynomial ℝ) (p : E3 → Polynomial ℝ)
    (j : ℕ → Fin 3) {y : Fin 2 → ℝ} (hy : y ∉ transBox (j m) C N) (z : ℝ) :
    cdlF N m f P p j (embT (j m) y z) = 0 := by
  rw [cdlF]
  have : ∀ t : ℝ, f 0 (embT (j m) y z + (P m).eval t • basisVec (j m))
      * phaseProd (m - 1) f P p j (embT (j m) y z + (P m).eval t • basisVec (j m)) t = 0 :=
    fun t => by rw [hfs _ (fun h => hy (mem_of_embT_mem_petBox h).1), zero_mul]
  simp_rw [this]
  simp

set_option maxHeartbeats 2000000 in
-- The budget choices and the application of the abstract lemma share one context.
/-- **Lemma `patch:conditional-degree` (conditional structured degree lowering).** Assume
`MA(m, l)` for every budget. For admissible data, the adjoint-type function
`F(x) = E_t f_0(x + P_m(t) e_m) ∏_{i<m} f_i(x - P_i(t) e_i + P_m(t) e_m) e(p_{x + P_m(t)e_m}(t))`
with `p_x = Σ_{i=m+1}^{l} ξ_i(x) P_i + Σ_{i>l} η_i P_i`, and `H` comparable to `N^{d_m}`, a power
lower bound for the order-`(r+2)` powers of the sections of `F` in the direction `e_m` (in units
`N^{6 - d_m}` of the transverse volume, section length `S = 10 u_c(δ) N^{d_m}`) gives a power lower
bound for the order-`(r+1)` powers at the same `H`. -/
theorem conditionalDegreeLowering {k : ℕ} {j : ℕ → Fin 3} {m l : ℕ} (hm : 1 ≤ m) (hml : m ≤ l)
    (hlk : l ≤ k) (hMA : MajorArcProperty k j m l) {r : ℕ} (hr : 1 ≤ r) {c : ℕ} (hc : 1 ≤ c) :
    ∃ C : ℕ, 1 ≤ C ∧ ∀ δ N : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ N →
      ∀ (P : ℕ → Polynomial ℝ) (f : ℕ → E3 → ℂ) (ξ : ℕ → E3 → ℝ) (η : ℕ → ℝ) (H : ℝ),
        (∀ i ∈ Finset.Icc 1 k, AdmissiblePoly c δ N (expo (j i)) (P i)) →
        (∀ i, Measurable (f i)) → (∀ i x, ‖f i x‖ ≤ 1) →
        (∀ i x, x ∉ petBox (budHi c δ) N → f i x = 0) → (∀ i, Measurable (ξ i)) →
        budLo c δ * N ^ expo (j m) ≤ H → H ≤ budHi c δ * N ^ expo (j m) →
        budLo c δ * N ^ (6 - expo (j m)) ≤ ∫ y, unifPow1 H (10 * budHi c δ * N ^ expo (j m))
          (r + 2) (fun z => cdlF N m f P (maPhase (m + 1) l k ξ η P) j (embT (j m) y z)) →
        budLo C δ * N ^ (6 - expo (j m)) ≤ ∫ y, unifPow1 H (10 * budHi c δ * N ^ expo (j m))
          (r + 1) (fun z => cdlF N m f P (maPhase (m + 1) l k ξ η P) j (embT (j m) y z)) := by
  -- the power functions of the input budget
  have hLo : MonoLow (budLo c) := monoLow_budLo hc
  have hHi : MonoHigh (budHi c) := monoHigh_budHi hc
  have haF : MonoLow fun δ => budLo c δ / (4 * budHi c δ ^ 2) :=
    hLo.div ((monoHigh_const (by norm_num : (0 : ℝ) < 4)).mul (hHi.pow 2))
  have hhF : MonoLow fun δ => budLo c δ / (10 * budHi c δ) :=
    hLo.div ((monoHigh_const (by norm_num : (0 : ℝ) < 10)).mul hHi)
  -- the input budget of `MA(m, l)`
  have hF1 : MonoLow fun δ => 40 * budHi c δ ^ 3 * cdlThrLow (budLo c δ / (4 * budHi c δ ^ 2))
      (budLo c δ / (10 * budHi c δ)) (1 / 10) r := by
    have h := monoLow_cdlThrLow haF hhF (hH := 1 / 10) (by norm_num) r
    refine ((monoLow_const (by norm_num : (0 : ℝ) < 40)).mul h).mono fun δ h0 h1 => ?_
    have hu : 1 ≤ budHi c δ := one_le_budHi h0 h1 hc
    have hth : 0 ≤ cdlThrLow (budLo c δ / (4 * budHi c δ ^ 2))
        (budLo c δ / (10 * budHi c δ)) (1 / 10) r := (h.pos h0 h1).le
    have : 1 ≤ budHi c δ ^ 3 := one_le_pow₀ hu
    nlinarith
  obtain ⟨c₁', hc₁', hc₁'b⟩ := hF1.exists_budLo
  set c₁ := max c₁' ((1 + r) * c) with hc₁def
  have hc₁ : 1 ≤ c₁ := le_trans hc₁' (le_max_left _ _)
  have hcc₁ : c ≤ c₁ := le_trans (Nat.le_mul_of_pos_left c (by omega)) (le_max_right _ _)
  obtain ⟨C', hC'c₁, hMAC'⟩ := hMA c₁ hc₁
  have hC' : 1 ≤ C' := le_trans hc₁ hC'c₁
  -- the output budget
  have hLo' : MonoLow (budLo C') := monoLow_budLo hC'
  have hHi' : MonoHigh (budHi C') := monoHigh_budHi hC'
  have hρF : MonoLow fun δ => budLo C' δ / (8 * budHi C' δ * budHi c δ ^ 2) :=
    hLo'.div (((monoHigh_const (by norm_num : (0 : ℝ) < 8)).mul hHi').mul (hHi.pow 2))
  have hβF : MonoHigh fun δ => 10 * budHi c δ * budHi C' δ :=
    ((monoHigh_const (by norm_num : (0 : ℝ) < 10)).mul hHi).mul hHi'
  have hF2 : MonoLow fun δ => 4 * budHi c δ ^ 2 * cdlOutLow (budLo c δ / (4 * budHi c δ ^ 2))
      (budLo c δ / (10 * budHi c δ)) (1 / 10) ((15 + r) / 10) (10 * budHi c δ * budHi C' δ)
      (budLo C' δ / (8 * budHi C' δ * budHi c δ ^ 2)) r := by
    have h := monoLow_cdlOutLow haF hhF hβF hρF (hH := 1 / 10) (κ := (15 + r) / 10)
      (by norm_num) (by positivity) r
    refine ((monoLow_const (by norm_num : (0 : ℝ) < 4)).mul h).mono fun δ h0 h1 => ?_
    have hu : 1 ≤ budHi c δ := one_le_budHi h0 h1 hc
    have hth := (h.pos h0 h1).le
    have : 1 ≤ budHi c δ ^ 2 := one_le_pow₀ hu
    nlinarith
  obtain ⟨C, hC, hCb⟩ := hF2.exists_budLo
  refine ⟨C, hC, ?_⟩
  intro δ N hδ0 hδ1 hN P f ξ η H hadm hf hf1 hfs hξ hH1 hH2 hQ
  have hN0 : 0 < N := by linarith
  set u := budHi c δ with hudef
  have hu1 : 1 ≤ u := one_le_budHi hδ0 hδ1 hc
  have hu0 : 0 < u := by linarith
  have hmk : m ∈ Finset.Icc 1 k := Finset.mem_Icc.mpr ⟨hm, le_trans hml hlk⟩
  have hd3 : expo (j m) ≤ 3 := Nat.succ_le_of_lt (Fin.is_lt _)
  have hNd : 0 < N ^ expo (j m) := pow_pos hN0 _
  set S := 10 * u * N ^ expo (j m) with hSdef
  have hS : 0 < S := by positivity
  set V := (volume (transBox (j m) u N)).toReal with hVdef
  have hV : V = (2 * u) ^ 2 * N ^ (6 - expo (j m)) := volume_transBox (j m) hu0.le hN0.le
  have hVpos : 0 < V := by rw [hV]; positivity
  have hVS : V * S = 40 * u ^ 3 * N ^ (6 : ℕ) := by
    rw [hV, hSdef, ← pow_add_sub_six N (by omega : expo (j m) ≤ 6)]; ring
  have hlo0 : 0 < budLo c δ := budLo_pos hδ0 hc
  have hH0 : 0 < H := lt_of_lt_of_le (mul_pos hlo0 hNd) hH1
  set a := budLo c δ / (4 * u ^ 2) with hadef
  have ha0 : 0 < a := by positivity
  set hL := budLo c δ / (10 * u) with hhLdef
  have hhL0 : 0 < hL := by positivity
  have hhL : hL ≤ H / S := by
    rw [hhLdef, hSdef, le_div_iff₀ (by positivity)]
    calc budLo c δ / (10 * u) * (10 * u * N ^ expo (j m)) = budLo c δ * N ^ expo (j m) := by
          field_simp
      _ ≤ H := hH1
  have hhH : H / S ≤ 1 / 10 := by
    rw [hSdef, div_le_iff₀ (by positivity)]
    calc H ≤ u * N ^ expo (j m) := hH2
      _ = 1 / 10 * (10 * u * N ^ expo (j m)) := by ring
  -- the measure spaces
  have := isProbabilityMeasure_transMeas (j m) hu0 hN0
  have := isProbabilityMeasure_unifIcc (by linarith : (0 : ℝ) < N)
  have hP3 : ∀ i ∈ Finset.Icc (m + 1) k, (P i).natDegree ≤ 3 := by
    intro i hi
    rw [(hadm i (by rw [Finset.mem_Icc] at hi ⊢; omega)).natDegree_eq]
    exact Nat.succ_le_of_lt (Fin.is_lt _)
  have hFm := measurable_cdlFt (N := N) hml hlk hf hP3 hξ η j
  -- sections as averages over the normalized transverse box
  have hsec : ∀ n : ℕ, (∫ y, unifPow1 H S n (fun z => ∫ t, cdlFt N m l k f P ξ η j t y z
      ∂unifIcc 0 N) ∂transMeas (j m) u N)
      = V⁻¹ * ∫ y, unifPow1 H S n
          (fun z => cdlF N m f P (maPhase (m + 1) l k ξ η P) j (embT (j m) y z)) := by
    intro n
    simp_rw [integral_cdlFt hN0]
    rw [transMeas, integral_smul_measure, ENNReal.toReal_inv, smul_eq_mul, ← hVdef]
    congr 1
    refine setIntegral_eq_integral_of_forall_compl_eq_zero fun y hy => ?_
    have h0 : (fun z => cdlF N m f P (maPhase (m + 1) l k ξ η P) j (embT (j m) y z))
        = fun _ => (0 : ℂ) := by
      funext z; exact cdlF_embT_eq_zero (hfs 0) P _ j hy z
    rw [h0, unifPow1_zero_fun]
  have hQ' : a ≤ ∫ y, unifPow1 H S (r + 2) (fun z => ∫ t, cdlFt N m l k f P ξ η j t y z
      ∂unifIcc 0 N) ∂transMeas (j m) u N := by
    rw [hsec]
    have h := hQ
    rw [hadef, hV]
    rw [hV] at hVpos
    calc budLo c δ / (4 * u ^ 2)
        = ((2 * u) ^ 2 * N ^ (6 - expo (j m)))⁻¹ * (budLo c δ * N ^ (6 - expo (j m))) := by
          field_simp; ring
      _ ≤ _ := mul_le_mul_of_nonneg_left h (inv_nonneg.mpr hVpos.le)
  -- the output budget of Step 5
  set B := budHi C' δ / N ^ expo (j m) with hBdef
  have hB0 : 0 < B := div_pos (budHi_pos hδ0 hC') hNd
  set ρ := budLo C' δ * N ^ (6 : ℕ) / (2 * budHi C' δ * N ^ expo (j m) * V) with hρdef
  have hρ0 : 0 < ρ := by
    have := budLo_pos hδ0 hC'; have := budHi_pos hδ0 hC'; positivity
  have hbox : (1 + r) * u ≤ budHi c₁ δ := by
    have h1 := budHi_mul_le hδ0 hδ1 hc (k := 1 + r) (by omega)
    have h2 := budHi_monotone hδ0 hδ1 (Nat.le_trans hc (Nat.le_mul_of_pos_left c (by omega)))
      (le_max_right c₁' ((1 + r) * c) : (1 + r) * c ≤ c₁)
    push_cast at h1
    linarith
  have hthrL : cdlThrLow a hL (1 / 10) r ≤ cdlThr a H S r :=
    cdlThr_ge hS hH0 ha0 le_rfl hhL0 hhL hhH r
  have hthr0 : budLo c₁ δ * N ^ (6 : ℕ) ≤ V * S * cdlThr a H S r := by
    have h1 := hc₁'b δ hδ0 hδ1
    have h2 := budLo_antitone hδ0 hδ1 hc₁' (le_max_left c₁' ((1 + r) * c) : c₁' ≤ c₁)
    rw [hVS]
    have hN6 : 0 < N ^ (6 : ℕ) := by positivity
    calc budLo c₁ δ * N ^ (6 : ℕ) ≤ 40 * u ^ 3 * cdlThrLow a hL (1 / 10) r * N ^ (6 : ℕ) :=
          mul_le_mul_of_nonneg_right (h2.trans h1) hN6.le
      _ ≤ 40 * u ^ 3 * cdlThr a H S r * N ^ (6 : ℕ) := by gcongr
      _ = 40 * u ^ 3 * N ^ (6 : ℕ) * cdlThr a H S r := by ring
  have hMA' : ∀ k' : (Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ), (∀ i, k'.2.1 i ∈ Set.Icc 0 H) →
      (∀ i, k'.2.2 i ∈ Set.Icc 0 H) → ∀ ψ : (Fin 2 → ℝ) → ℝ, Measurable ψ →
      cdlThr a H S r ≤ ∫ y, ‖cdlCoef S (cdlG (unifIcc 0 N) (cdlFt N m l k f P ξ η j) y
        k'.2.1 k'.2.2) (ψ y)‖ ∂transMeas (j m) u N →
      ρ ≤ (transMeas (j m) u N {y | |ψ y| ≤ B}).toReal := by
    intro k' hb _ ψ hψ hint
    exact cdl_step5 hr hN hδ0 hδ1 hm hml hlk hc hcc₁ hC' (hMAC' δ N hδ0 hδ1 hN) hf hf1 hfs
      hadm hξ η hS hH2 hbox k'.2.1 k'.2.2 hb hthr0 ψ hψ hint
  -- the abstract lemma
  have hout := cdl_abstract (μ := transMeas (j m) u N) (ν := unifIcc 0 N) hFm
    (fun t y z => norm_cdlFt_le hf1 P ξ η j t y z) hS hH0
    (c := -(5 * u * N ^ expo (j m)))
    (fun t y z hz => cdlFt_eq_zero_of_far hN hc hδ0 (hfs 0) hd3 (hadm m hmk) ξ η t y (by
      convert hz using 2)) hr ha0 hQ' hB0 hρ0 hMA'
  -- the final budget
  have hκ : (|-(5 * u * N ^ expo (j m))| + S + r * H) / S ≤ (15 + r) / 10 := by
    rw [abs_neg, abs_of_pos (by positivity), div_le_iff₀ hS, hSdef]
    have : (r : ℝ) * H ≤ r * (u * N ^ expo (j m)) := mul_le_mul_of_nonneg_left hH2 (by positivity)
    nlinarith
  have hβ : B * S ≤ 10 * u * budHi C' δ := by
    rw [hBdef, hSdef]; field_simp; exact le_rfl
  have hρeq : ρ = budLo C' δ / (8 * budHi C' δ * u ^ 2) := by
    rw [hρdef, hV]
    have hC'0 := budHi_pos hδ0 hC'
    rw [← pow_add_sub_six N (by omega : expo (j m) ≤ 6)]
    field_simp
    ring
  have hlow := cdlOut_ge hS hH0 ha0 le_rfl hhL0 hhL hhH r hκ hB0 hβ (hρeq ▸ hρ0)
    (le_of_eq hρeq.symm)
  have hC := hCb δ hδ0 hδ1
  have hfinal := hsec (r + 1)
  have hVinv : (∫ y, unifPow1 H S (r + 1)
      (fun z => cdlF N m f P (maPhase (m + 1) l k ξ η P) j (embT (j m) y z)))
      = V * ∫ y, unifPow1 H S (r + 1) (fun z => ∫ t, cdlFt N m l k f P ξ η j t y z
        ∂unifIcc 0 N) ∂transMeas (j m) u N := by
    rw [hfinal, ← mul_assoc, mul_inv_cancel₀ hVpos.ne', one_mul]
  rw [hVinv]
  have hN6d : 0 < N ^ (6 - expo (j m)) := by positivity
  calc budLo C δ * N ^ (6 - expo (j m))
      ≤ 4 * u ^ 2 * cdlOutLow a hL (1 / 10) ((15 + r) / 10) (10 * u * budHi C' δ)
          (budLo C' δ / (8 * budHi C' δ * u ^ 2)) r * N ^ (6 - expo (j m)) :=
        mul_le_mul_of_nonneg_right hC hN6d.le
    _ = V * cdlOutLow a hL (1 / 10) ((15 + r) / 10) (10 * u * budHi C' δ)
          (budLo C' δ / (8 * budHi C' δ * u ^ 2)) r := by rw [hV]; ring
    _ ≤ V * cdlOut a H S (-(5 * u * N ^ expo (j m))) r B ρ :=
        mul_le_mul_of_nonneg_left hlow hVpos.le
    _ ≤ _ := mul_le_mul_of_nonneg_left hout hVpos.le

end

/-! ### `patch:major-arc`, the base case `m = 1` -/

section
open Filter Topology MeasureTheory

/-- A power upper bound is dominated by an upper budget. -/
theorem MonoHigh.exists_budHi {F : ℝ → ℝ} (hF : MonoHigh F) :
    ∃ C : ℕ, 1 ≤ C ∧ ∀ δ : ℝ, 0 < δ → δ ≤ 1 → F δ ≤ budHi C δ := by
  obtain ⟨B, hB, b, hFb⟩ := hF
  obtain ⟨n, hn⟩ := exists_nat_ge B
  refine ⟨max 1 (max n b), le_max_left _ _, fun δ h0 h1 => ?_⟩
  have hC : (B : ℝ) ≤ (max 1 (max n b) : ℕ) := by
    have : n ≤ max 1 (max n b) := le_trans (le_max_left n b) (le_max_right _ _)
    exact hn.trans (by exact_mod_cast this)
  have hb : b ≤ max 1 (max n b) := le_trans (le_max_right n b) (le_max_right _ _)
  refine (hFb δ h0 h1).2.trans ?_
  rw [budHi, div_eq_mul_inv]
  have hδb : (δ ^ b)⁻¹ ≤ (δ ^ (max 1 (max n b)))⁻¹ :=
    inv_anti₀ (pow_pos h0 _) (pow_le_pow_of_le_one h0.le h1 hb)
  exact mul_le_mul hC hδb (by positivity) (by positivity)

theorem sum_Icc_one_eq_range {M : Type*} [AddCommMonoid M] (k : ℕ) (F : ℕ → M) :
    ∑ i ∈ Finset.Icc 1 k, F i = ∑ u ∈ Finset.range k, F (u + 1) := by
  have : Finset.Icc 1 k = Finset.Ico 1 (k + 1) := by
    ext i; simp only [Finset.mem_Icc, Finset.mem_Ico]; omega
  rw [this, Finset.sum_Ico_eq_sum_range]
  simp [add_comm]

theorem sum_Icc_split {M : Type*} [AddCommMonoid M] {l k : ℕ} (hlk : l ≤ k) (F : ℕ → M) :
    ∑ i ∈ Finset.Icc 1 k, F i = ∑ i ∈ Finset.Icc 1 l, F i + ∑ i ∈ Finset.Icc (l + 1) k, F i := by
  have h : Finset.Icc 1 k = Finset.Icc 1 l ∪ Finset.Icc (l + 1) k := by
    ext i; simp only [Finset.mem_Icc, Finset.mem_union]; omega
  rw [h, Finset.sum_union]
  rw [Finset.disjoint_left]
  intro i hi hi'
  simp only [Finset.mem_Icc] at hi hi'
  omega

/-- The coefficient of `P_i` in the phase of `MA(1, l)`. -/
noncomputable def maCoef (l : ℕ) (ζ : ℕ → E3 → ℝ) (θ : ℕ → ℝ) (x : E3) (i : ℕ) : ℝ :=
  if i ≤ l then ζ i x else θ i

theorem maPhase_one_eq {l k : ℕ} (hlk : l ≤ k) (ζ : ℕ → E3 → ℝ) (θ : ℕ → ℝ)
    (P : ℕ → Polynomial ℝ) (x : E3) :
    maPhase 1 l k ζ θ P x
      = ∑ u ∈ Finset.range k, Polynomial.C (maCoef l ζ θ x (u + 1)) * P (u + 1) := by
  rw [← sum_Icc_one_eq_range k (fun i => Polynomial.C (maCoef l ζ θ x i) * P i),
    sum_Icc_split hlk, maPhase]
  congr 1
  · refine Finset.sum_congr rfl fun i hi => ?_
    rw [maCoef, ite_eq_left (Finset.mem_Icc.mp hi).2]
  · refine Finset.sum_congr rfl fun i hi => ?_
    have : ¬ i ≤ l := by rw [Finset.mem_Icc] at hi; omega
    rw [maCoef, ite_eq_right this]

theorem maSize_one_eq {l k : ℕ} (hlk : l ≤ k) (j : ℕ → Fin 3) (N : ℝ) (ζ : ℕ → E3 → ℝ)
    (θ : ℕ → ℝ) (x : E3) :
    maSize 1 l k j N ζ θ x
      = ∑ u ∈ Finset.range k, N ^ expo (j (u + 1)) * |maCoef l ζ θ x (u + 1)| := by
  rw [← sum_Icc_one_eq_range k (fun i => N ^ expo (j i) * |maCoef l ζ θ x i|),
    sum_Icc_split hlk, maSize]
  congr 1
  · refine Finset.sum_congr rfl fun i hi => ?_
    rw [maCoef, ite_eq_left (Finset.mem_Icc.mp hi).2]
  · refine Finset.sum_congr rfl fun i hi => ?_
    have : ¬ i ≤ l := by rw [Finset.mem_Icc] at hi; omega
    rw [maCoef, ite_eq_right this]

set_option maxHeartbeats 1000000 in
-- The popularity argument and the triangular bound share one context.
/-- **Theorem `patch:major-arc`, the base case `m = 1`.** With no active inputs the correlation is
`∫ g_0(x) E_t e(p_x(t)) dx`; on a popular set of `x` the exponential average is large, and
`patch:triangular` bounds the frequencies there. -/
theorem majorArc_base {k : ℕ} {j : ℕ → Fin 3}
    (hjm : ∀ u v, 1 ≤ u → u < v → v ≤ k → expo (j u) < expo (j v)) {l : ℕ} (hl : 1 ≤ l)
    (hlk : l ≤ k) : MajorArcProperty k j 1 l := by
  intro c hc
  obtain ⟨C0, hC0, hosc⟩ := sum_le_of_oscillation_ge 3 (by norm_num)
  have hk : 1 ≤ k := le_trans hl hlk
  have hLo : MonoLow (budLo c) := monoLow_budLo hc
  have hHi : MonoHigh (budHi c) := monoHigh_budHi hc
  have hε : MonoLow fun δ => budLo c δ / (16 * budHi c δ ^ 3) :=
    hLo.div ((monoHigh_const (by norm_num : (0 : ℝ) < 16)).mul (hHi.pow 3))
  have hLoInv : MonoHigh fun δ => (budLo c δ)⁻¹ :=
    ((monoHigh_const one_pos).div hLo).mono (fun δ _ _ => le_of_eq (one_div _).symm)
      (fun δ h0 _ => inv_pos.mpr (budLo_pos h0 hc))
  have hBnd : MonoHigh fun δ => (budLo c δ)⁻¹ * (C0 / (budLo c δ / (16 * budHi c δ ^ 3))) ^ 3
      * k * (1 + (budLo c δ)⁻¹ * budHi c δ) ^ k := by
    have h1 : MonoHigh fun δ => C0 / (budLo c δ / (16 * budHi c δ ^ 3)) :=
      (monoHigh_const (by linarith : (0 : ℝ) < C0)).div hε
    have h2 : MonoHigh fun δ => 1 + (budLo c δ)⁻¹ * budHi c δ :=
      (monoHigh_const one_pos).add (hLoInv.mul hHi)
    exact ((hLoInv.mul (h1.pow 3)).mul_const (by exact_mod_cast hk)).mul (h2.pow k)
  obtain ⟨C1, hC1, hC1b⟩ := hBnd.exists_budHi
  obtain ⟨C2, hC2, hC2b⟩ := (hLo.div_const two_pos).exists_budLo
  set C := max c (max C1 C2) with hCdef
  refine ⟨C, le_max_left _ _, ?_⟩
  intro δ N hδ0 hδ1 hN P g ζ θ hadm hgm hg1 hgs hζ hcorr
  have hN0 : 0 < N := by linarith
  have hC : 1 ≤ C := le_trans hc (le_max_left _ _)
  have hu := budHi_pos hδ0 hc
  have hlo := budLo_pos hδ0 hc
  set ε := budLo c δ / (16 * budHi c δ ^ 3) with hεdef
  have hε0 : 0 < ε := by positivity
  set p := maPhase 1 l k ζ θ P with hp
  have hP3 : ∀ i ∈ Finset.Icc 1 k, (P i).natDegree ≤ 3 := fun i hi => by
    rw [(hadm i hi).natDegree_eq]; exact Nat.succ_le_of_lt (Fin.is_lt _)
  have hp3 : ∀ x, (p x).natDegree ≤ 3 := fun x =>
    maPhase_natDegree_le' (fun i hi => hP3 i hi) (by omega) hlk x
  have hpm := measurable_phaseProd (m := 0) hgm P hp3 (measurable_maPhase_coeff hζ θ P) j
  set A : E3 → ℂ := fun x => (N : ℂ)⁻¹ * ∫ t in (0 : ℝ)..N, phaseProd 0 g P p j x t with hA
  have hAm : Measurable A := by
    have h := (measurable_phaseProdAvg hpm (c := 0) hN0.le).const_mul ((N : ℂ)⁻¹)
    simpa [hA, zero_add] using h
  have hA1 : ∀ x, ‖A x‖ ≤ 1 := by
    intro x
    rw [hA, norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hN0.le]
    have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := N) (C := 1)
      (f := fun t => phaseProd 0 g P p j x t) fun t _ => norm_phaseProd_le 0 hg1 P p j x t
    rw [one_mul, sub_zero, abs_of_pos hN0] at h
    rw [inv_mul_le_iff₀ hN0, mul_one]
    exact h
  -- the popular set
  set box := petBox (budHi c δ) N with hbox
  set X := {x | x ∈ box ∧ ε ≤ ‖A x‖} with hX
  have hXm : MeasurableSet X :=
    (measurableSet_petBox _ _).inter (measurableSet_le measurable_const hAm.norm)
  have hboxμ : (volume box).toReal = 8 * budHi c δ ^ 3 * N ^ 6 := by
    rw [hbox, volume_petBox hu.le hN0.le, ENNReal.toReal_ofReal (by positivity)]
  have hboxfin : volume box ≠ ⊤ := by rw [hbox, volume_petBox hu.le hN0.le]; simp
  have hXfin : volume X ≠ ⊤ := ne_top_of_le_ne_top hboxfin (measure_mono fun x hx => hx.1)
  have hXmass : budLo c δ * N ^ 6 / 2 ≤ (volume X).toReal := by
    have hcorr' : budLo c δ * N ^ (6 : ℕ) ≤ ‖∫ x, g 0 x * A x‖ := hcorr
    have hint : IntegrableOn (fun x => ‖A x‖) box :=
      Measure.integrableOn_of_bounded (M := 1) hboxfin hAm.norm.aestronglyMeasurable
        (Eventually.of_forall fun x => by rw [norm_norm]; exact hA1 x)
    have h1 : ‖∫ x, g 0 x * A x‖ ≤ ∫ x in box, ‖A x‖ := by
      refine (norm_integral_le_integral_norm _).trans ?_
      rw [← integral_indicator (measurableSet_petBox _ _)]
      refine integral_mono_of_nonneg (Eventually.of_forall fun x => norm_nonneg _)
        (hint.integrable_indicator (measurableSet_petBox _ _)) (Eventually.of_forall fun x => ?_)
      change ‖g 0 x * A x‖ ≤ _
      by_cases hx : x ∈ box
      · rw [Set.indicator_of_mem hx, norm_mul]
        exact mul_le_of_le_one_left (norm_nonneg _) (hg1 0 x)
      · rw [Set.indicator_of_notMem hx, hgs 0 x hx, zero_mul, norm_zero]
    have h2 : ∫ x in box, ‖A x‖ ≤ (volume X).toReal + (volume box).toReal * ε := by
      rw [← integral_inter_add_sdiff hXm hint]
      have hbX : box ∩ X = X := Set.inter_eq_right.mpr fun x hx => hx.1
      rw [hbX]
      have h3 : ∫ x in X, ‖A x‖ ≤ (volume X).toReal := by
        calc ∫ x in X, ‖A x‖ ≤ ∫ _x in X, (1 : ℝ) :=
              setIntegral_mono_on (hint.mono_set fun x hx => hx.1)
                (integrableOn_const hXfin) hXm fun x _ => hA1 x
          _ = (volume X).toReal := by rw [setIntegral_const_real]; ring
      have h4 : ∫ x in box \ X, ‖A x‖ ≤ (volume box).toReal * ε := by
        calc ∫ x in box \ X, ‖A x‖ ≤ ∫ _x in box \ X, ε :=
              setIntegral_mono_on (hint.mono_set Set.sdiff_subset)
                (integrableOn_const (ne_top_of_le_ne_top hboxfin (measure_mono Set.sdiff_subset)))
                ((measurableSet_petBox _ _).diff hXm) fun x hx => by
                  have : ¬ (x ∈ box ∧ ε ≤ ‖A x‖) := hx.2
                  push Not at this
                  exact (this hx.1).le
          _ = (volume (box \ X)).toReal * ε := setIntegral_const_real _ _
          _ ≤ (volume box).toReal * ε := mul_le_mul_of_nonneg_right
              (ENNReal.toReal_mono hboxfin (measure_mono Set.sdiff_subset)) hε0.le
      linarith
    rw [hboxμ, hεdef] at h2
    have h5 : 8 * budHi c δ ^ 3 * N ^ 6 * (budLo c δ / (16 * budHi c δ ^ 3))
        = budLo c δ * N ^ 6 / 2 := by field_simp; ring
    rw [h5] at h2
    have : (budLo c δ * N ^ (6 : ℕ) : ℝ) = budLo c δ * N ^ 6 := rfl
    linarith
  -- the frequencies are small on the popular set
  have hsub : X ⊆ maSet 1 l k j C δ N ζ θ := by
    intro x hx
    obtain ⟨hxbox, hxA⟩ := hx
    refine ⟨petBox_mono (budHi_monotone hδ0 hδ1 hc (le_max_left _ _)) hN0.le hxbox, ?_⟩
    rw [maSize_one_eq hlk]
    have hosc' : ε ≤ ‖N⁻¹ • ∫ t in (0 : ℝ)..N, expPhase (fun s => 2 * Real.pi *
        (∑ u ∈ Finset.range k, Polynomial.C (maCoef l ζ θ x (u + 1)) * P (u + 1)).eval s) t‖ := by
      rw [← maPhase_one_eq hlk, Complex.real_smul, Complex.ofReal_inv]
      have : A x = (N : ℂ)⁻¹ * ∫ t in (0 : ℝ)..N, expPhase (fun s => 2 * Real.pi *
          (maPhase 1 l k ζ θ P x).eval s) t := by
        simp only [hA, phaseProd, Finset.Icc_eq_empty_of_lt (by norm_num : 0 < 1),
          Finset.prod_empty, one_mul, hp]
      rw [← this]
      exact hxA
    have h := hosc k N ε (budLo c δ) (budHi c δ) (fun u => expo (j (u + 1))) (fun u => P (u + 1))
      (fun u => maCoef l ζ θ x (u + 1)) hN0 hε0 hlo hu.le (fun u _ => expo_pos _)
      (fun u _ => Nat.succ_le_of_lt (Fin.is_lt _))
      (fun u hu' => (hadm (u + 1) (Finset.mem_Icc.mpr ⟨by omega, by omega⟩)).natDegree_eq)
      (fun u v huv hv => hjm (u + 1) (v + 1) (by omega) (by omega) (by omega))
      (fun u hu' => (hadm (u + 1) (Finset.mem_Icc.mpr ⟨by omega, by omega⟩)).2.1)
      (fun u r hu' hr => (hadm (u + 1) (Finset.mem_Icc.mpr ⟨by omega, by omega⟩)).2.2.2 r hr)
      hosc'
    refine h.trans ((hC1b δ hδ0 hδ1).trans (budHi_monotone hδ0 hδ1 hC1 ?_))
    exact le_trans (le_max_left _ _) (le_max_right _ _)
  have hmfin : volume (maSet 1 l k j C δ N ζ θ) ≠ ⊤ := by
    refine ne_top_of_le_ne_top ?_ (measure_mono fun x hx => hx.1)
    rw [volume_petBox (budHi_pos hδ0 hC).le hN0.le]; simp
  calc budLo C δ * N ^ (6 : ℕ) ≤ budLo c δ / 2 * N ^ 6 := by
        refine mul_le_mul_of_nonneg_right ?_ (by positivity)
        exact (budLo_antitone hδ0 hδ1 hC2 (le_trans (le_max_right _ _) (le_max_right _ _))).trans
          (hC2b δ hδ0 hδ1)
    _ = budLo c δ * N ^ 6 / 2 := by ring
    _ ≤ (volume X).toReal := hXmass
    _ ≤ _ := ENNReal.toReal_mono hmfin (measure_mono hsub)

end

/-! ### `patch:ma-adjoint`: the exact adjoint of the last active input -/

section
open Filter Topology MeasureTheory

theorem maPhase_neg (m l k : ℕ) (ζ : ℕ → E3 → ℝ) (θ : ℕ → ℝ) (P : ℕ → Polynomial ℝ) (x : E3) :
    maPhase m l k (fun i x => -ζ i x) (fun i => -θ i) P x = -maPhase m l k ζ θ P x := by
  simp only [maPhase, Polynomial.C_neg, neg_mul, Finset.sum_neg_distrib, neg_add]

theorem expPhase_neg_eval (q : Polynomial ℝ) (t : ℝ) :
    expPhase (fun s => 2 * Real.pi * (-q).eval s) t
      = conj (expPhase (fun s => 2 * Real.pi * q.eval s) t) := by
  rw [expPhase_eq_ephase, expPhase_eq_ephase, Polynomial.eval_neg, ephase_neg]

/-- **The exact adjoint** of `patch:ma-adjoint`:
`F(y) = E_t conj g_0(y + P_m e_m) ∏_{i<m} conj g_i(y + P_m e_m - P_i e_i)
e(-p_{y + P_m e_m}(t))`. -/
noncomputable def maAdj (N : ℝ) (m l k : ℕ) (g : ℕ → E3 → ℂ) (P : ℕ → Polynomial ℝ)
    (ζ : ℕ → E3 → ℝ) (θ : ℕ → ℝ) (j : ℕ → Fin 3) : E3 → ℂ :=
  cdlF N m (fun i x => conj (g i x)) P (maPhase (m + 1) l k (fun i x => -ζ i x) (fun i => -θ i) P) j

theorem conj_maAdj {N : ℝ} (hN : 0 ≤ N) {m l k : ℕ} (g : ℕ → E3 → ℂ) (P : ℕ → Polynomial ℝ)
    (ζ : ℕ → E3 → ℝ) (θ : ℕ → ℝ) (j : ℕ → Fin 3) (y : E3) :
    conj (maAdj N m l k g P ζ θ j y)
      = (N : ℂ)⁻¹ * ∫ t in (0 : ℝ)..N, g 0 (y + (P m).eval t • basisVec (j m))
        * ((∏ i ∈ Finset.Icc 1 (m - 1),
            g i (y + (P m).eval t • basisVec (j m) - (P i).eval t • basisVec (j i)))
          * expPhase (fun s => 2 * Real.pi * (maPhase (m + 1) l k ζ θ P
              (y + (P m).eval t • basisVec (j m))).eval s) t) := by
  rw [maAdj, cdlF, map_mul, map_inv₀, Complex.conj_ofReal, intervalIntegral.integral_of_le hN,
    intervalIntegral.integral_of_le hN, ← integral_conj]
  congr 1
  refine integral_congr_ae (Eventually.of_forall fun t => ?_)
  simp only [phaseProd, maPhase_neg, expPhase_neg_eval, map_mul, map_prod,
    Complex.conj_conj]

theorem prod_Icc_one_succ_top {m : ℕ} (hm : 1 ≤ m) (F : ℕ → ℂ) :
    ∏ i ∈ Finset.Icc 1 m, F i = (∏ i ∈ Finset.Icc 1 (m - 1), F i) * F m := by
  have h : Finset.Icc 1 m = insert m (Finset.Icc 1 (m - 1)) := by
    ext i; simp only [Finset.mem_Icc, Finset.mem_insert]; omega
  rw [h, Finset.prod_insert (by simp only [Finset.mem_Icc]; omega), mul_comm]

set_option maxHeartbeats 1000000 in
-- The two exchanges and the translation share one context.
/-- **`patch:ma-adjoint`, the exact adjoint**: translation in `x` gives `Γ = ⟨g_m, F⟩`,
`∫ g_0(x) E_t ∏_{i ≤ m} g_i(x - P_i(t) e_i) e(p_x(t)) dx = ∫ g_m(y) conj F(y) dy`. -/
theorem phaseCorr_eq_inner_maAdj {N : ℝ} (hN : 0 < N) {m l k : ℕ} (hm : 1 ≤ m) (hml : m ≤ l)
    (hlk : l ≤ k) {g : ℕ → E3 → ℂ} (hg : ∀ i, Measurable (g i)) (hg1 : ∀ i x, ‖g i x‖ ≤ 1)
    {C : ℝ} (hgs : ∀ i x, x ∉ petBox C N → g i x = 0) {P : ℕ → Polynomial ℝ}
    (hP3 : ∀ i ∈ Finset.Icc (m + 1) k, (P i).natDegree ≤ 3) {ζ : ℕ → E3 → ℝ}
    (hζ : ∀ i, Measurable (ζ i)) (θ : ℕ → ℝ) (j : ℕ → Fin 3) :
    phaseCorr N m g P (maPhase (m + 1) l k ζ θ P) j
      = ∫ y, g m y * conj (maAdj N m l k g P ζ θ j y) := by
  set p := maPhase (m + 1) l k ζ θ P with hp
  have hp3 : ∀ x, (p x).natDegree ≤ 3 := fun x => maPhase_natDegree_le' hP3 (by omega) hlk x
  have hpm := measurable_phaseProd (m := m) hg P hp3 (measurable_maPhase_coeff hζ θ P) j
  set v : ℝ → E3 := fun t => (P m).eval t • basisVec (j m) with hv
  have hvm : Measurable v := ((P m).continuous.measurable).smul_const _
  set I := Set.Ioc (0 : ℝ) N with hI
  have hIfin : volume I ≠ ⊤ := by simp [hI]
  have hboxfin : volume (petBox C N) ≠ ⊤ := by
    obtain ⟨R₀, hR₀⟩ := (isBounded_petBox C N).subset_closedBall (0 : E3)
    exact ne_top_of_le_ne_top (measure_closedBall_lt_top (x := (0 : E3)) (r := R₀)).ne
      (measure_mono hR₀)
  -- the integrand
  set K : E3 → ℝ → ℂ := fun x t => g 0 x * phaseProd m g P p j x t with hK
  have hKm : Measurable (Function.uncurry K) :=
    ((hg 0).comp measurable_fst).mul hpm
  have hK1 : ∀ x t, ‖K x t‖ ≤ 1 := fun x t => by
    rw [hK, norm_mul]
    exact ((mul_le_of_le_one_left (norm_nonneg _) (hg1 0 x)).trans (norm_phaseProd_le m hg1 P p j
      x t))
  have hKs : ∀ x t, x ∉ petBox C N → K x t = 0 := fun x t hx => by rw [hK]; simp [hgs 0 x hx]
  have hKi : Integrable (Function.uncurry K) ((volume : Measure E3).prod (volume.restrict I)) := by
    refine IntegrableOn.integrable_of_forall_notMem_eq_zero (s := petBox C N ×ˢ Set.univ)
      (Measure.integrableOn_of_bounded (M := 1) ?_ hKm.aestronglyMeasurable
        (Eventually.of_forall fun q => hK1 q.1 q.2)) (fun q hq => ?_)
    · rw [Measure.prod_prod]
      exact ENNReal.mul_ne_top hboxfin (by simp [hI])
    · exact hKs q.1 q.2 fun h => hq ⟨h, Set.mem_univ _⟩
  -- the left side as a double integral
  have hL : phaseCorr N m g P p j = (N : ℂ)⁻¹ * ∫ t in I, ∫ x, K x t := by
    rw [phaseCorr]
    simp_rw [intervalIntegral.integral_of_le hN.le, ← mul_assoc, mul_comm (g 0 _) ((N : ℂ)⁻¹),
      mul_assoc]
    rw [integral_const_mul]
    congr 1
    simp_rw [← integral_const_mul]
    exact integral_integral_swap hKi
  -- translate by `v t`
  have htr : ∀ t, ∫ x, K x t = ∫ y, g m y * (g 0 (y + v t) * ((∏ i ∈ Finset.Icc 1 (m - 1),
      g i (y + v t - (P i).eval t • basisVec (j i)))
      * expPhase (fun s => 2 * Real.pi * (p (y + v t)).eval s) t)) := by
    intro t
    rw [← integral_add_right_eq_self (μ := (volume : Measure E3)) (fun x => K x t) (v t)]
    refine integral_congr_ae (Eventually.of_forall fun y => ?_)
    simp only [hK, phaseProd, prod_Icc_one_succ_top hm, hv, add_sub_cancel_right]
    ring
  simp_rw [htr] at hL
  rw [hL]
  -- exchange back
  set K' : E3 → ℝ → ℂ := fun y t => g m y * (g 0 (y + v t) * ((∏ i ∈ Finset.Icc 1 (m - 1),
      g i (y + v t - (P i).eval t • basisVec (j i)))
      * expPhase (fun s => 2 * Real.pi * (p (y + v t)).eval s) t)) with hK'
  have hK'm : Measurable (Function.uncurry K') := by
    have hyv : Measurable fun q : E3 × ℝ => q.1 + v q.2 :=
      measurable_fst.add (hvm.comp measurable_snd)
    have hpp := (measurable_phaseProd (m := m - 1) hg P hp3
      (measurable_maPhase_coeff hζ θ P) j).comp
      (hyv.prodMk measurable_snd)
    have h := ((hg m).comp measurable_fst).mul (((hg 0).comp hyv).mul hpp)
    have e : Function.uncurry K' = fun q : E3 × ℝ => g m q.1 * (g 0 (q.1 + v q.2)
        * phaseProd (m - 1) g P p j (q.1 + v q.2) q.2) := by
      funext q; simp only [hK', Function.uncurry, phaseProd]
    rw [e]; exact h
  have hK'1 : ∀ y t, ‖K' y t‖ ≤ 1 := fun y t => by
    rw [hK', norm_mul, norm_mul, norm_mul, norm_expPhase, mul_one]
    have hp1 : ‖∏ i ∈ Finset.Icc 1 (m - 1), g i (y + v t - (P i).eval t • basisVec (j i))‖ ≤ 1 := by
      rw [norm_prod]
      exact Finset.prod_le_one₀ (fun _ _ => norm_nonneg _) fun i _ => hg1 i _
    exact ((mul_le_of_le_one_left (by positivity) (hg1 m y)).trans (((mul_le_of_le_one_left
      (norm_nonneg _) (hg1 0 _)).trans hp1)))
  have hK'i : Integrable (Function.uncurry K')
      ((volume : Measure E3).prod (volume.restrict I)) := by
    refine IntegrableOn.integrable_of_forall_notMem_eq_zero (s := petBox C N ×ˢ Set.univ)
      (Measure.integrableOn_of_bounded (M := 1) ?_ hK'm.aestronglyMeasurable
        (Eventually.of_forall fun q => hK'1 q.1 q.2)) (fun q hq => ?_)
    · rw [Measure.prod_prod]
      exact ENNReal.mul_ne_top hboxfin (by simp [hI])
    · simp only [Function.uncurry, hK']
      rw [hgs m q.1 fun h => hq ⟨h, Set.mem_univ _⟩, zero_mul]
  rw [← integral_integral_swap hK'i, ← integral_const_mul]
  refine integral_congr_ae (Eventually.of_forall fun y => ?_)
  beta_reduce
  rw [conj_maAdj hN.le, intervalIntegral.integral_of_le hN.le, integral_const_mul]
  simp only [hv, hp]
  rw [← mul_assoc, mul_comm ((N : ℂ)⁻¹) (g m y), mul_assoc]

theorem integrable_real_of_bdd_of_support {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {g : α → ℝ} (hg : Measurable g) {C : ℝ} (hC : ∀ x, |g x| ≤ C) {s : Set α}
    (hs : μ s ≠ ⊤) (hsupp : ∀ x, x ∉ s → g x = 0) : Integrable g μ :=
  IntegrableOn.integrable_of_forall_notMem_eq_zero
    (Measure.integrableOn_of_bounded (M := C) hs hg.aestronglyMeasurable
      (Eventually.of_forall fun x => by rw [Real.norm_eq_abs]; exact hC x)) hsupp

theorem measurable_cdlF {N : ℝ} (hN : 0 ≤ N) {m : ℕ} {f : ℕ → E3 → ℂ} (hf : ∀ i, Measurable (f i))
    (P : ℕ → Polynomial ℝ) {p : E3 → Polynomial ℝ} (hp3 : ∀ x, (p x).natDegree ≤ 3)
    (hpc : ∀ n, Measurable fun x => (p x).coeff n) (j : ℕ → Fin 3) :
    Measurable (cdlF N m f P p j) := by
  have hpp := measurable_phaseProd (m := m - 1) hf P hp3 hpc j
  have hx : Measurable fun q : E3 × ℝ => q.1 + (P m).eval q.2 • basisVec (j m) :=
    measurable_fst.add (((P m).continuous.measurable.comp measurable_snd).smul_const _)
  have h2 : Measurable fun q : E3 × ℝ =>
      phaseProd (m - 1) f P p j (q.1 + (P m).eval q.2 • basisVec (j m)) q.2 := by
    have h := hpp.comp (hx.prodMk measurable_snd)
    exact h
  have hint : Measurable fun q : E3 × ℝ => f 0 (q.1 + (P m).eval q.2 • basisVec (j m))
      * phaseProd (m - 1) f P p j (q.1 + (P m).eval q.2 • basisVec (j m)) q.2 :=
    ((hf 0).comp hx).mul h2
  have h := (hint.stronglyMeasurable.integral_prod_right'
    (ν := volume.restrict (Set.Ioc (0 : ℝ) N))).measurable.const_mul ((N : ℂ)⁻¹)
  have e : cdlF N m f P p j = fun x => (N : ℂ)⁻¹ * ∫ t in Set.Ioc (0 : ℝ) N,
      f 0 (x + (P m).eval t • basisVec (j m))
        * phaseProd (m - 1) f P p j (x + (P m).eval t • basisVec (j m)) t := by
    funext x; rw [cdlF, intervalIntegral.integral_of_le hN]
  rw [e]; exact h

theorem norm_cdlF_le {N : ℝ} (hN : 0 < N) {m : ℕ} {f : ℕ → E3 → ℂ} (hf1 : ∀ i x, ‖f i x‖ ≤ 1)
    (P : ℕ → Polynomial ℝ) (p : E3 → Polynomial ℝ) (j : ℕ → Fin 3) (x : E3) :
    ‖cdlF N m f P p j x‖ ≤ 1 := by
  rw [cdlF, norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hN.le,
    inv_mul_le_iff₀ hN, mul_one]
  have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := N) (C := 1)
    (f := fun t => f 0 (x + (P m).eval t • basisVec (j m))
      * phaseProd (m - 1) f P p j (x + (P m).eval t • basisVec (j m)) t)
    fun t _ => by
      rw [norm_mul]
      exact (mul_le_of_le_one_left (norm_nonneg _) (hf1 0 _)).trans
        (norm_phaseProd_le _ hf1 _ _ _ _ _)
  rwa [one_mul, sub_zero, abs_of_pos hN] at h

/-- The adjoint-type function is supported in the box enlarged by `4 u_c(δ) N^{d_m}` in the
direction `e_m`. -/
theorem cdlF_eq_zero_of_box {N : ℝ} (hN : 1 ≤ N) {c : ℕ} (hc : 1 ≤ c) {δ : ℝ} (hδ0 : 0 < δ)
    {m : ℕ} {f : ℕ → E3 → ℂ} (hfs : ∀ x, x ∉ petBox (budHi c δ) N → f 0 x = 0)
    {P : ℕ → Polynomial ℝ} {j : ℕ → Fin 3} (hdm : expo (j m) ≤ 3)
    (hPm : AdmissiblePoly c δ N (expo (j m)) (P m)) (p : E3 → Polynomial ℝ) {x : E3}
    (hx : x ∉ petBox (5 * budHi c δ) N) : cdlF N m f P p j x = 0 := by
  have hN0 : 0 < N := by linarith
  have hu := budHi_pos hδ0 hc
  rw [cdlF, intervalIntegral.integral_of_le hN0.le]
  rw [setIntegral_congr_fun measurableSet_Ioc (g := fun _ => (0 : ℂ)) fun t ht => ?_]
  · simp
  have hP := abs_eval_le_of_admissible hN hdm hPm hc hδ0 (Set.Ioc_subset_Icc_self ht)
  simp only
  rw [hfs _ (fun h => hx fun i => ?_), zero_mul]
  have hi := h i
  have hNi : 0 ≤ N ^ expo i := pow_nonneg hN0.le _
  by_cases hij : i = j m
  · subst hij
    simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, basisVec_apply_self, mul_one] at hi
    have := abs_le.mp hP
    constructor <;> nlinarith [hi.1, hi.2]
  · simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, basisVec_apply_ne hij, mul_zero,
      add_zero] at hi
    constructor <;> nlinarith [hi.1, hi.2]

/-- **`patch:ma-adjoint`.** For admissible data, the exact adjoint `F` of the last active input is
measurable, one-bounded and supported in the box enlarged by `5`; replacing `g_m` by `F` turns the
correlation into `‖F‖₂²`, and `|Γ|² ≤ V ‖F‖₂²` with `V = 8 u_c(δ)^3 N^6` the volume of the box. -/
theorem ma_adjoint {N : ℝ} (hN : 1 ≤ N) {δ : ℝ} (hδ0 : 0 < δ) {c : ℕ} (hc : 1 ≤ c)
    {m l k : ℕ} (hm : 1 ≤ m) (hml : m ≤ l) (hlk : l ≤ k) {j : ℕ → Fin 3} {g : ℕ → E3 → ℂ}
    (hg : ∀ i, Measurable (g i)) (hg1 : ∀ i x, ‖g i x‖ ≤ 1)
    (hgs : ∀ i x, x ∉ petBox (budHi c δ) N → g i x = 0) {P : ℕ → Polynomial ℝ}
    (hadm : ∀ i ∈ Finset.Icc 1 k, AdmissiblePoly c δ N (expo (j i)) (P i)) {ζ : ℕ → E3 → ℝ}
    (hζ : ∀ i, Measurable (ζ i)) (θ : ℕ → ℝ) :
    Measurable (maAdj N m l k g P ζ θ j) ∧ (∀ y, ‖maAdj N m l k g P ζ θ j y‖ ≤ 1)
      ∧ (∀ y, y ∉ petBox (5 * budHi c δ) N → maAdj N m l k g P ζ θ j y = 0)
      ∧ phaseCorr N m (Function.update g m (maAdj N m l k g P ζ θ j)) P
          (maPhase (m + 1) l k ζ θ P) j = ((∫ y, ‖maAdj N m l k g P ζ θ j y‖ ^ 2 : ℝ) : ℂ)
      ∧ ‖phaseCorr N m g P (maPhase (m + 1) l k ζ θ P) j‖ ^ 2
          ≤ 8 * budHi c δ ^ 3 * N ^ 6 * ∫ y, ‖maAdj N m l k g P ζ θ j y‖ ^ 2 := by
  have hN0 : 0 < N := by linarith
  have hu := budHi_pos hδ0 hc
  have hmk : m ∈ Finset.Icc 1 k := Finset.mem_Icc.mpr ⟨hm, le_trans hml hlk⟩
  have hP3 : ∀ i ∈ Finset.Icc (m + 1) k, (P i).natDegree ≤ 3 := by
    intro i hi
    rw [(hadm i (by rw [Finset.mem_Icc] at hi ⊢; omega)).natDegree_eq]
    exact Nat.succ_le_of_lt (Fin.is_lt _)
  set F := maAdj N m l k g P ζ θ j with hF
  have hζn : ∀ i, Measurable fun x => -ζ i x := fun i => (hζ i).neg
  have hFm : Measurable F := measurable_cdlF hN0.le
    (fun i => Complex.continuous_conj.measurable.comp
    (hg i)) P (fun x => maPhase_natDegree_le' hP3 (by omega) hlk x)
    (measurable_maPhase_coeff hζn _ P) j
  have hF1 : ∀ y, ‖F y‖ ≤ 1 := fun y => norm_cdlF_le hN0 (fun i x => by
    rw [RCLike.norm_conj]; exact hg1 i x) P _ j y
  have hFs : ∀ y, y ∉ petBox (5 * budHi c δ) N → F y = 0 := fun y hy =>
    cdlF_eq_zero_of_box hN hc hδ0 (fun x hx => by simp [hgs 0 x hx])
      (Nat.succ_le_of_lt (Fin.is_lt _)) (hadm m hmk) _ hy
  have hbox : petBox (budHi c δ) N ⊆ petBox (5 * budHi c δ) N :=
    petBox_mono (by linarith) hN0.le
  refine ⟨hFm, hF1, hFs, ?_, ?_⟩
  · -- the replaced correlation is `‖F‖₂²`
    set g' := Function.update g m F with hg'
    have hg'm : ∀ i, Measurable (g' i) := fun i => by
      by_cases hi : i = m
      · subst hi; rw [hg', Function.update_self]; exact hFm
      · rw [hg', Function.update_of_ne hi]; exact hg i
    have hg'1 : ∀ i x, ‖g' i x‖ ≤ 1 := fun i x => by
      by_cases hi : i = m
      · subst hi; rw [hg', Function.update_self]; exact hF1 x
      · rw [hg', Function.update_of_ne hi]; exact hg1 i x
    have hg's : ∀ i x, x ∉ petBox (5 * budHi c δ) N → g' i x = 0 := fun i x hx => by
      by_cases hi : i = m
      · subst hi; rw [hg', Function.update_self]; exact hFs x hx
      · rw [hg', Function.update_of_ne hi]; exact hgs i x fun h => hx (hbox h)
    rw [phaseCorr_eq_inner_maAdj hN0 hm hml hlk hg'm hg'1 hg's hP3 hζ θ j]
    have hadj : maAdj N m l k g' P ζ θ j = F := by
      rw [hF]
      funext x
      simp only [maAdj, cdlF]
      congr 2
      funext t
      have h0 : g' 0 = g 0 := by rw [hg', Function.update_of_ne (by omega)]
      simp only [phaseProd, h0]
      congr 2
      refine Finset.prod_congr rfl fun i hi => ?_
      have : i ≠ m := by rw [Finset.mem_Icc] at hi; omega
      rw [hg', Function.update_of_ne this]
    rw [hadj, ← integral_complex_ofReal]
    refine integral_congr_ae (Eventually.of_forall fun y => ?_)
    change g' m y * conj (F y) = ((‖F y‖ ^ 2 : ℝ) : ℂ)
    rw [hg', Function.update_self, Complex.mul_conj, Complex.normSq_eq_norm_sq,
      Complex.ofReal_pow]
  · -- the Cauchy-Schwarz bound
    rw [phaseCorr_eq_inner_maAdj hN0 hm hml hlk hg hg1 (fun i x hx => hgs i x hx) hP3 hζ θ j]
    have hboxfin : volume (petBox (5 * budHi c δ) N) ≠ ⊤ := by
      rw [volume_petBox (by linarith) hN0.le]; simp
    have hbox1fin : volume (petBox (budHi c δ) N) ≠ ⊤ := by
      rw [volume_petBox hu.le hN0.le]; simp
    have hgm2 : Integrable (fun y => ‖g m y‖ ^ 2) :=
      integrable_real_of_bdd_of_support ((hg m).norm.pow_const 2) (C := 1) (fun y => by
        rw [abs_of_nonneg (by positivity)]; exact pow_le_one₀ (norm_nonneg _) (hg1 m y))
        hbox1fin (fun y hy => by simp [hgs m y hy])
    have hF2 : Integrable (fun y => ‖conj (F y)‖ ^ 2) :=
      integrable_real_of_bdd_of_support
        ((Complex.continuous_conj.measurable.comp hFm).norm.pow_const
        2) (C := 1) (fun y => by
          rw [abs_of_nonneg (by positivity), RCLike.norm_conj]
          exact pow_le_one₀ (norm_nonneg _) (hF1 y)) hboxfin (fun y hy => by simp [hFs y hy])
    have hgF : Integrable (fun y => ‖g m y‖ * ‖conj (F y)‖) :=
      integrable_real_of_bdd_of_support ((hg m).norm.mul
        (Complex.continuous_conj.measurable.comp hFm).norm) (C := 1) (fun y => by
          rw [abs_of_nonneg (by positivity), RCLike.norm_conj]
          exact ((mul_le_of_le_one_left (norm_nonneg _) (hg1 m y)).trans (hF1 y))) hbox1fin
          (fun y hy => by simp [hgs m y hy])
    refine (sq_norm_integral_mul_le hgm2 hF2 hgF).trans ?_
    simp_rw [RCLike.norm_conj]
    have hvol : ∫ y, ‖g m y‖ ^ 2 ≤ 8 * budHi c δ ^ 3 * N ^ 6 := by
      calc ∫ y, ‖g m y‖ ^ 2 ≤ ∫ y, Set.indicator (petBox (budHi c δ) N) (fun _ => (1 : ℝ)) y := by
            have hone : IntegrableOn (fun _ : E3 => (1 : ℝ)) (petBox (budHi c δ) N) :=
              Measure.integrableOn_of_bounded (M := 1) hbox1fin
                measurable_const.aestronglyMeasurable (Eventually.of_forall fun _ => by simp)
            refine integral_mono hgm2 (hone.integrable_indicator (measurableSet_petBox _ _))
              fun y => ?_
            by_cases hy : y ∈ petBox (budHi c δ) N
            · rw [Set.indicator_of_mem hy]; exact pow_le_one₀ (norm_nonneg _) (hg1 m y)
            · rw [Set.indicator_of_notMem hy, hgs m y hy, norm_zero]; norm_num
        _ = 8 * budHi c δ ^ 3 * N ^ 6 := by
            rw [integral_indicator (measurableSet_petBox _ _), setIntegral_const, smul_eq_mul,
              mul_one, Measure.real, volume_petBox hu.le hN0.le,
              ENNReal.toReal_ofReal (by positivity)]
    exact mul_le_mul_of_nonneg_right hvol (integral_nonneg fun y => by positivity)

end

/-! ### Uniform pairs and Fejer densities: the cube identification and the product density -/

section
open Filter Topology MeasureTheory

theorem conjPar_conjPar_add (a b : ℕ) (z : ℂ) : conjPar a (conjPar b z) = conjPar (a + b) z := by
  unfold conjPar
  rcases Nat.even_or_odd a with ha | ha <;> rcases Nat.even_or_odd b with hb | hb
  · simp [ha, hb, ha.add hb]
  · have : ¬ Even (a + b) := Nat.not_even_iff_odd.mpr (ha.add_odd hb)
    simp [ha, Nat.not_even_iff_odd.mpr hb, this]
  · have : ¬ Even (a + b) := Nat.not_even_iff_odd.mpr (ha.add_even hb)
    simp [Nat.not_even_iff_odd.mpr ha, hb, this]
  · have : Even (a + b) := ha.add_odd hb
    simp [Nat.not_even_iff_odd.mpr ha, Nat.not_even_iff_odd.mpr hb, this]

theorem conjPar_congr_parity {a b : ℕ} (h : Even a ↔ Even b) (z : ℂ) :
    conjPar a z = conjPar b z := by
  unfold conjPar
  by_cases ha : Even a
  · rw [ite_eq_left ha, ite_eq_left (h.mp ha)]
  · rw [ite_eq_right ha, ite_eq_right (fun hb => ha (h.mpr hb))]

theorem conjPar_numTrue_eq {s : ℕ} (ω : Fin s → Bool) (z : ℂ) :
    conjPar (numTrue ω) z = conjPar s (conjPar (numFalse ω) z) := by
  rw [conjPar_conjPar_add]
  refine conjPar_congr_parity ?_ z
  have key : ∀ a b n : ℕ, a + b = n → (Even a ↔ Even (n + b)) := by
    intro a b n hn
    subst hn
    rw [add_assoc]
    have : Even (b + b) := ⟨b, rfl⟩
    constructor
    · intro ha; exact ha.add this
    · intro hs; exact (Nat.even_add.mp hs).mpr this
  exact key _ _ _ (numTrue_add_numFalse ω)

theorem sum_cubeSel_eq {s : ℕ} (ω : Fin s → Bool) (b c : Fin s → ℝ) :
    ∑ i, cubeSel ω b c i = ∑ i, b i + cubeShift (c - b) ω := by
  rw [cubeShift, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun i _ => ?_
  by_cases h : ω i <;> simp [cubeSel, h]

/-- **The uniform-pair cube is the iterated difference at the differences of the pairs**:
`D^s_{c,b} G(x) = C^s Δ_{c - b} G(x + Σ b e)`. -/
theorem dirCube_eq_conjPar_fdiffIter {s : ℕ} (G : E3 → ℂ) (e : E3) (b c : Fin s → ℝ) (x : E3) :
    dirCube G e b c x = conjPar s (fdiffIter e s (c - b) G (x + (∑ i, b i) • e)) := by
  rw [dirCube, cubeProdSel, fdiffIter_eq_cubeProd, conjPar_prod]
  refine Finset.prod_congr rfl fun ω _ => ?_
  rw [conjPar_numTrue_eq, sum_cubeSel_eq, add_smul, add_assoc]

/-- **The difference of two independent uniform variables on `[0,H]` has density `κ_H`**, in the
form `E_{b,c} Φ(c - b) = ∫ κ_H Φ`. -/
theorem integral_unif_sub_eq_fejer {H : ℝ} (hH : 0 < H) {Φ : ℝ → ℂ} (hΦ : Measurable Φ) {M : ℝ}
    (hM : ∀ d, ‖Φ d‖ ≤ M) :
    ∫ p : ℝ × ℝ, Φ (p.2 - p.1) ∂((unifMeas H).prod (unifMeas H))
      = ∫ d, ((fejer H d : ℝ) : ℂ) * Φ d := by
  have := isProbabilityMeasure_unifMeas hH
  have hm : Measurable (Function.uncurry fun (b c : ℝ) => Φ (c - b)) :=
    hΦ.comp (measurable_snd.sub measurable_fst)
  rw [integral_prod_of_bdd (f := fun b c => Φ (c - b)) hm (C := M) fun b c => hM _]
  rw [integral_swap_of_bdd hm (C := M) fun b c => hM _]
  have h := integral_double_sub_eq_fejer hH hΦ hM
  simp_rw [intervalIntegral.integral_of_le hH.le, ← integral_Icc_eq_integral_Ioc] at h
  have e1 : ∀ c : ℝ, ∫ b, Φ (c - b) ∂unifMeas H = (H : ℂ)⁻¹ * ∫ b in Set.Icc 0 H, Φ (c - b) :=
    fun c => integral_unifMeas hH _
  simp_rw [e1]
  rw [integral_unifMeas hH, integral_const_mul]
  have h' : (∫ a in Set.Icc (0 : ℝ) H, ∫ x in Set.Icc (0 : ℝ) H, Φ (a - x))
      = (H ^ 2 : ℝ) • ∫ d, fejer H d • Φ d := h
  rw [h', Complex.real_smul]
  simp_rw [Complex.real_smul]
  have hH0 : (H : ℂ) ≠ 0 := by exact_mod_cast hH.ne'
  push_cast
  field_simp

/-- **The `s`-dimensional Fejer density**: for independent uniform `b, c ∈ [0,H]^s`,
`E φ(c - b) = ∫ κ_H^{⊗ s}(h) φ(h) dh`. -/
theorem integral_pi_sub_eq_fejerCube {H : ℝ} (hH : 0 < H) :
    ∀ (s : ℕ) {φ : (Fin s → ℝ) → ℂ}, Measurable φ → ∀ {M : ℝ}, (∀ h, ‖φ h‖ ≤ M) →
      ∫ Q : (Fin s → ℝ) × (Fin s → ℝ), φ (Q.2 - Q.1)
          ∂((Measure.pi fun _ => unifMeas H).prod (Measure.pi fun _ => unifMeas H))
        = ∫ h, ((fejerCube H h : ℝ) : ℂ) * φ h := by
  have := isProbabilityMeasure_unifMeas hH
  intro s
  induction s with
  | zero =>
    intro φ hφ M hM
    have hu : ∀ h : Fin 0 → ℝ, h = fun i => i.elim0 := fun h => funext fun i => i.elim0
    have e1 : ∀ Q : (Fin 0 → ℝ) × (Fin 0 → ℝ), φ (Q.2 - Q.1) = φ (fun i => i.elim0) :=
      fun Q => by rw [hu (Q.2 - Q.1)]
    have e2 : ∀ h : Fin 0 → ℝ, ((fejerCube H h : ℝ) : ℂ) * φ h = φ (fun i => i.elim0) :=
      fun h => by simp [fejerCube, hu h]
    simp_rw [e1, e2]
    rw [integral_const, integral_const]
    simp [volume_pi, Measure.real]
  | succ n ih =>
    intro φ hφ M hM
    set ν := unifMeas H with hν
    have hsnoc : ∀ (c' b' : Fin n → ℝ) (γ β : ℝ),
        (Fin.snoc c' γ : Fin (n + 1) → ℝ) - Fin.snoc b' β = Fin.snoc (c' - b') (γ - β) := by
      intro c' b' γ β
      funext i
      refine Fin.lastCases ?_ (fun i => ?_) i
      · simp
      · simp [Fin.snoc_castSucc]
    have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
    -- the left side, iterated
    have hsub : Measurable fun q : (Fin (n + 1) → ℝ) × (Fin (n + 1) → ℝ) => φ (q.2 - q.1) :=
      hφ.comp (measurable_snd.sub measurable_fst)
    rw [integral_prod_of_bdd (f := fun b c : Fin (n + 1) → ℝ => φ (c - b)) hsub (C := M)
      fun b c => hM _]
    have hin : Measurable fun b : Fin (n + 1) → ℝ => ∫ c, φ (c - b) ∂(Measure.pi fun _ => ν) := by
      have h := (hsub.comp (measurable_fst.prodMk measurable_snd)).stronglyMeasurable
        |>.integral_prod_right' (ν := Measure.pi fun _ : Fin (n + 1) => ν)
      exact h.measurable
    rw [integral_pi_snoc ν hin (C := M) fun b => (norm_integral_le_of_norm_le_const
      (Eventually.of_forall fun c => hM _)).trans (by simp)]
    have hinner : ∀ (b' : Fin n → ℝ) (β : ℝ), ∫ c, φ (c - Fin.snoc b' β) ∂(Measure.pi fun _ => ν)
        = ∫ γ, ∫ c', φ (Fin.snoc (c' - b') (γ - β)) ∂(Measure.pi fun _ : Fin n => ν) ∂ν := by
      intro b' β
      have hmc : Measurable fun c : Fin (n + 1) → ℝ => φ (c - Fin.snoc b' β) :=
        hφ.comp (measurable_id.sub_const _)
      rw [integral_pi_snoc ν hmc (C := M) fun c => hM _]
      simp_rw [hsnoc]
      have hm2 : Measurable (Function.uncurry fun (c' : Fin n → ℝ) (γ : ℝ) =>
          φ (Fin.snoc (c' - b') (γ - β))) :=
        hφ.comp (measurable_snoc.comp ((measurable_fst.sub_const _).prodMk
          (measurable_snd.sub_const _)))
      exact integral_swap_of_bdd hm2 (C := M) fun c' γ => hM _
    simp_rw [hinner]
    -- move the last coordinates outside
    have hF : Measurable (Function.uncurry fun (b' : Fin n → ℝ) (β : ℝ) =>
        ∫ γ, ∫ c', φ (Fin.snoc (c' - b') (γ - β)) ∂(Measure.pi fun _ : Fin n => ν) ∂ν) := by
      have h0 : Measurable fun q : (((Fin n → ℝ) × ℝ) × ℝ) × (Fin n → ℝ) =>
          φ (Fin.snoc (q.2 - q.1.1.1) (q.1.2 - q.1.1.2)) :=
        hφ.comp (measurable_snoc.comp ((measurable_snd.sub measurable_fst.fst.fst).prodMk
          (measurable_fst.snd.sub measurable_fst.fst.snd)))
      have h1 := h0.stronglyMeasurable.integral_prod_right' (ν := (Measure.pi fun _ : Fin n => ν))
      have h2 := h1.integral_prod_right' (ν := ν)
      exact h2.measurable
    have hFb : ∀ b' β, ‖∫ γ, ∫ c', φ (Fin.snoc (c' - b') (γ - β))
        ∂(Measure.pi fun _ : Fin n => ν) ∂ν‖ ≤ M := fun b' β =>
      (norm_integral_le_of_norm_le_const (C := M) (Eventually.of_forall fun γ =>
        (norm_integral_le_of_norm_le_const (C := M) (Eventually.of_forall fun c' => hM _)).trans
          (by simp))).trans (by simp)
    rw [integral_swap_of_bdd hF (C := M) hFb]
    have hswap2 : ∀ β : ℝ, (∫ b', ∫ γ, ∫ c', φ (Fin.snoc (c' - b') (γ - β))
        ∂(Measure.pi fun _ : Fin n => ν) ∂ν ∂(Measure.pi fun _ : Fin n => ν))
        = ∫ γ, ∫ q : (Fin n → ℝ) × (Fin n → ℝ), φ (Fin.snoc (q.2 - q.1) (γ - β))
          ∂((Measure.pi fun _ : Fin n => ν).prod (Measure.pi fun _ : Fin n => ν)) ∂ν := by
      intro β
      have hG : Measurable (Function.uncurry fun (b' : Fin n → ℝ) (γ : ℝ) =>
          ∫ c', φ (Fin.snoc (c' - b') (γ - β)) ∂(Measure.pi fun _ : Fin n => ν)) := by
        have h0 : Measurable fun q : ((Fin n → ℝ) × ℝ) × (Fin n → ℝ) =>
            φ (Fin.snoc (q.2 - q.1.1) (q.1.2 - β)) :=
          hφ.comp (measurable_snoc.comp ((measurable_snd.sub measurable_fst.fst).prodMk
            (measurable_fst.snd.sub_const _)))
        exact (h0.stronglyMeasurable.integral_prod_right'
          (ν := (Measure.pi fun _ : Fin n => ν))).measurable
      rw [integral_swap_of_bdd hG (C := M) fun b' γ =>
        (norm_integral_le_of_norm_le_const (Eventually.of_forall fun c' => hM _)).trans (by simp)]
      refine integral_congr_ae (Eventually.of_forall fun γ => ?_)
      beta_reduce
      have hq : Measurable (Function.uncurry fun (b' c' : Fin n → ℝ) =>
          φ (Fin.snoc (c' - b') (γ - β))) :=
        hφ.comp (measurable_snoc.comp ((measurable_snd.sub measurable_fst).prodMk
          measurable_const))
      rw [integral_prod_of_bdd (f := fun b' c' : Fin n → ℝ => φ (Fin.snoc (c' - b') (γ - β))) hq
        (C := M) fun b' c' => hM _]
    simp_rw [hswap2]
    -- the induction hypothesis in the first `n` coordinates
    have hIH : ∀ d : ℝ, (∫ q : (Fin n → ℝ) × (Fin n → ℝ), φ (Fin.snoc (q.2 - q.1) d)
        ∂((Measure.pi fun _ : Fin n => ν).prod (Measure.pi fun _ : Fin n => ν)))
        = ∫ h', ((fejerCube H h' : ℝ) : ℂ) * φ (Fin.snoc h' d) := by
      intro d
      exact ih (φ := fun h' => φ (Fin.snoc h' d))
        (hφ.comp (measurable_snoc.comp (measurable_id.prodMk measurable_const))) fun h' => hM _
    simp_rw [hIH]
    set Ψ : ℝ → ℂ := fun d => ∫ h', ((fejerCube H h' : ℝ) : ℂ) * φ (Fin.snoc h' d) with hΨ
    have hΨm : Measurable Ψ := by
      have h0 : Measurable fun q : ℝ × (Fin n → ℝ) =>
          ((fejerCube H q.2 : ℝ) : ℂ) * φ (Fin.snoc q.2 q.1) :=
        (Complex.measurable_ofReal.comp ((continuous_fejerCube H n).measurable.comp
          measurable_snd)).mul (hφ.comp (measurable_snoc.comp (measurable_snd.prodMk
            measurable_fst)))
      exact (h0.stronglyMeasurable.integral_prod_right' (ν := volume)).measurable
    have hΨb : ∀ d, ‖Ψ d‖ ≤ M := fun d => by
      simp only [hΨ]
      refine (norm_integral_le_integral_norm _).trans ?_
      calc ∫ h', ‖((fejerCube H h' : ℝ) : ℂ) * φ (Fin.snoc h' d)‖
          ≤ ∫ h', fejerCube H h' * M := by
            refine integral_mono_of_nonneg (Eventually.of_forall fun h' => norm_nonneg _)
              ((integrable_fejerCube hH n).mul_const M) (Eventually.of_forall fun h' => ?_)
            beta_reduce
            rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (fejerCube_nonneg hH h')]
            exact mul_le_mul_of_nonneg_left (hM _) (fejerCube_nonneg hH h')
        _ = M := by rw [integral_mul_const, integral_fejerCube hH n, one_mul]
    have hβγ : Measurable (Function.uncurry fun (β γ : ℝ) => Ψ (γ - β)) :=
      hΨm.comp (measurable_snd.sub measurable_fst)
    rw [← integral_prod_of_bdd (f := fun β γ : ℝ => Ψ (γ - β)) hβγ (C := M) fun β γ => hΨb _,
      integral_unif_sub_eq_fejer hH hΨm hΨb]
    -- reassemble the last coordinate
    rw [MeasureTheory.volume_pi, integral_pi_fin_last (volume : Measure ℝ)]
    have hint : Integrable (fun p : ℝ × (Fin n → ℝ) =>
        ((fejer H p.1 : ℝ) : ℂ) * (((fejerCube H p.2 : ℝ) : ℂ) * φ (Fin.snoc p.2 p.1)))
        ((volume : Measure ℝ).prod volume) := by
      have hm : Measurable fun p : ℝ × (Fin n → ℝ) =>
          ((fejer H p.1 : ℝ) : ℂ) * (((fejerCube H p.2 : ℝ) : ℂ) * φ (Fin.snoc p.2 p.1)) :=
        (Complex.measurable_ofReal.comp (continuous_fejer.measurable.comp measurable_fst)).mul
          ((Complex.measurable_ofReal.comp ((continuous_fejerCube H n).measurable.comp
            measurable_snd)).mul (hφ.comp (measurable_snoc.comp (measurable_snd.prodMk
              measurable_fst))))
      refine Integrable.mono'
        (((integrable_fejer hH).mul_prod (integrable_fejerCube hH n)).mul_const
        M) hm.aestronglyMeasurable (Eventually.of_forall fun p => ?_)
      rw [norm_mul, norm_mul, Complex.norm_real, Complex.norm_real,
        Real.norm_of_nonneg (fejer_nonneg hH _), Real.norm_of_nonneg (fejerCube_nonneg hH _)]
      have := hM (Fin.snoc p.2 p.1)
      have h1 := fejer_nonneg hH p.1
      have h2 := fejerCube_nonneg hH p.2
      calc fejer H p.1 * (fejerCube H p.2 * ‖φ (Fin.snoc p.2 p.1)‖)
          ≤ fejer H p.1 * (fejerCube H p.2 * M) := by gcongr
        _ = fejer H p.1 * fejerCube H p.2 * M := by ring
    rw [← MeasureTheory.volume_pi]
    have hR : (∫ p : ℝ × (Fin n → ℝ), ((fejerCube H (Fin.snoc p.2 p.1 : Fin (n + 1) → ℝ) : ℝ) : ℂ)
        * φ (Fin.snoc p.2 p.1) ∂((volume : Measure ℝ).prod volume))
        = ∫ p : ℝ × (Fin n → ℝ), ((fejer H p.1 : ℝ) : ℂ) * (((fejerCube H p.2 : ℝ) : ℂ)
          * φ (Fin.snoc p.2 p.1)) ∂((volume : Measure ℝ).prod volume) := by
      refine integral_congr_ae (Eventually.of_forall fun p => ?_)
      beta_reduce
      have hK : fejerCube H (Fin.snoc p.2 p.1 : Fin (n + 1) → ℝ)
          = fejerCube H p.2 * fejer H p.1 := by
        simp only [fejerCube, Fin.prod_univ_castSucc, Fin.snoc_castSucc, Fin.snoc_last]
      rw [hK, Complex.ofReal_mul]
      ring
    rw [hR, integral_prod _ hint]
    refine integral_congr_ae (Eventually.of_forall fun d => ?_)
    beta_reduce
    rw [hΨ, ← integral_const_mul]

end

/-! ### The Fejer form of the local uniformity power in section form -/

section
open Filter Topology MeasureTheory

theorem norm_basisVec (i : Fin 3) : ‖basisVec i‖ = 1 := by
  simp [basisVec]

theorem re_conjPar (n : ℕ) (z : ℂ) : (conjPar n z).re = z.re := by
  unfold conjPar; split_ifs <;> simp

theorem integral_conjPar' {α : Type*} [MeasurableSpace α] {μ : Measure α} (n : ℕ) (g : α → ℂ) :
    conjPar n (∫ x, g x ∂μ) = ∫ x, conjPar n (g x) ∂μ := (integral_conjPar n g).symm

set_option maxHeartbeats 1000000 in
-- The exchanges of the point with the shifts and the transverse Fubini theorem share one context.
/-- **The Fejer and the uniform-pair forms of the local uniformity power agree**: for a one-bounded
Borel function supported in a box, `N^6 Re Q^{Fejer}_{s,H}(G) = ∫_y S Q_{s,H,S}(G_y) dy`, the
sections `G_y(z) = G(embT e y z)` being taken along the direction `e_{jm}`. -/
theorem re_locUnifPow_eq_sections {N H : ℝ} (hN : 0 < N) (hH : 0 < H) (jm : Fin 3) (s : ℕ)
    {G : E3 → ℂ} (hG : Measurable G) (hG1 : ∀ x, ‖G x‖ ≤ 1) {C : ℝ}
    (hGs : ∀ x, x ∉ petBox C N → G x = 0) {S : ℝ} (hS : 0 < S) :
    N ^ (6 : ℕ) * (locUnifPow N H jm s G).re
      = ∫ y, S * unifPow1 H S s (fun z => G (embT jm y z)) := by
  have := isProbabilityMeasure_unifMeas hH
  set e := basisVec jm with he
  set πs := Measure.pi fun _ : Fin s => unifMeas H with hπs
  obtain ⟨R₀, hR₀⟩ := (isBounded_petBox C N).subset_closedBall (0 : E3)
  have hR0 : ∀ x, G x ≠ 0 → ‖x‖ ≤ R₀ := fun x hx => by
    by_contra h
    exact hx (hGs x fun hm => h (by simpa using hR₀ hm))
  have hball : volume (Metric.closedBall (0 : E3) R₀) ≠ ⊤ := measure_closedBall_lt_top.ne
  -- the Fejer side
  set I : (Fin s → ℝ) → ℂ := fun h => ∫ x, fdiffIter e s h G x with hI
  have hfd := measurable_fdiffIter_joint e s hG
  have hIm : Measurable I := by
    have h := (hfd.stronglyMeasurable.integral_prod_right' (ν := (volume : Measure E3))).measurable
    exact h
  have hIb : ∀ h, ‖I h‖ ≤ (volume (Metric.closedBall (0 : E3) R₀)).toReal := by
    intro h
    refine (norm_integral_le_integral_norm _).trans ?_
    have hind : Integrable (Set.indicator (Metric.closedBall (0 : E3) R₀) fun _ => (1 : ℝ)) :=
      (Measure.integrableOn_of_bounded (M := 1) hball measurable_const.aestronglyMeasurable
        (Eventually.of_forall fun _ => by simp)).integrable_indicator measurableSet_closedBall
    calc ∫ x, ‖fdiffIter e s h G x‖
        ≤ ∫ x, Set.indicator (Metric.closedBall (0 : E3) R₀) (fun _ => (1 : ℝ)) x := by
          refine integral_mono_of_nonneg (Eventually.of_forall fun x => norm_nonneg _) hind
            (Eventually.of_forall fun x => ?_)
          beta_reduce
          by_cases hx : G x = 0
          · have := norm_fdiffIter_le_self e s h hG1 x
            rw [hx, norm_zero] at this
            rw [le_antisymm this (norm_nonneg _)]
            exact Set.indicator_nonneg (fun _ _ => zero_le_one) _
          · rw [Set.indicator_of_mem (by simpa using hR0 x hx)]
            exact norm_fdiffIter_le e s h hG1 x
      _ = (volume (Metric.closedBall (0 : E3) R₀)).toReal := by
          rw [integral_indicator measurableSet_closedBall, setIntegral_const, smul_eq_mul, mul_one]
          rfl
  have hL : N ^ (6 : ℕ) * (locUnifPow N H jm s G).re
      = (∫ h, ((fejerCube H h : ℝ) : ℂ) * conjPar s (I h)).re := by
    have hK : Measurable fun h : Fin s → ℝ => ((fejerCube H h : ℝ) : ℂ) :=
      Complex.measurable_ofReal.comp (continuous_fejerCube H s).measurable
    have hswap : (∫ x, ∫ h, fdiffIter e s h G x * ∏ l : Fin s, ((fejer H (h l) : ℝ) : ℂ))
        = ∫ h, ((fejerCube H h : ℝ) : ℂ) * I h := by
      have hprod : ∀ h : Fin s → ℝ, ∏ l : Fin s, ((fejer H (h l) : ℝ) : ℂ)
          = ((fejerCube H h : ℝ) : ℂ) := fun h => by rw [fejerCube, Complex.ofReal_prod]
      simp_rw [hprod]
      have hm : Measurable (Function.uncurry fun (x : E3) (h : Fin s → ℝ) =>
          fdiffIter e s h G x * ((fejerCube H h : ℝ) : ℂ)) := by
        have h1 : Measurable fun q : E3 × (Fin s → ℝ) => fdiffIter e s q.2 G q.1 := by
          have h := hfd.comp (measurable_snd.prodMk measurable_fst)
          exact h
        have h2 : Measurable fun q : E3 × (Fin s → ℝ) => ((fejerCube H q.2 : ℝ) : ℂ) :=
          hK.comp measurable_snd
        exact h1.mul h2
      have hi : Integrable (Function.uncurry fun (x : E3) (h : Fin s → ℝ) =>
          fdiffIter e s h G x * ((fejerCube H h : ℝ) : ℂ))
          ((volume : Measure E3).prod volume) := by
        have hind : Integrable (Set.indicator (Metric.closedBall (0 : E3) R₀) fun _ => (1 : ℝ)) :=
          (Measure.integrableOn_of_bounded (M := 1) hball measurable_const.aestronglyMeasurable
            (Eventually.of_forall fun _ => by simp)).integrable_indicator measurableSet_closedBall
        refine Integrable.mono' (hind.mul_prod (integrable_fejerCube hH s))
          hm.aestronglyMeasurable (Eventually.of_forall fun q => ?_)
        simp only [Function.uncurry, norm_mul, Complex.norm_real,
          Real.norm_of_nonneg (fejerCube_nonneg hH _)]
        refine mul_le_mul_of_nonneg_right ?_ (fejerCube_nonneg hH _)
        by_cases hx : G q.1 = 0
        · have := norm_fdiffIter_le_self e s q.2 hG1 q.1
          rw [hx, norm_zero] at this
          rw [le_antisymm this (norm_nonneg _)]
          exact Set.indicator_nonneg (fun _ _ => zero_le_one) _
        · rw [Set.indicator_of_mem (by simpa using hR0 q.1 hx)]
          exact norm_fdiffIter_le e s q.2 hG1 q.1
      rw [integral_integral_swap hi]
      refine integral_congr_ae (Eventually.of_forall fun h => ?_)
      beta_reduce
      rw [integral_mul_const, mul_comm]
    have hN6 : (N : ℂ) ^ (6 : ℕ) ≠ 0 := pow_ne_zero _ (by exact_mod_cast hN.ne')
    rw [locUnifPow, hswap]
    have hcP : (∫ h, ((fejerCube H h : ℝ) : ℂ) * conjPar s (I h))
        = conjPar s (∫ h, ((fejerCube H h : ℝ) : ℂ) * I h) := by
      rw [integral_conjPar']
      refine integral_congr_ae (Eventually.of_forall fun h => ?_)
      beta_reduce
      rw [conjPar_mul]
      congr 1
      unfold conjPar; split_ifs <;> simp [Complex.conj_ofReal]
    rw [hcP, re_conjPar, ← Complex.re_ofReal_mul]
    congr 1
    push_cast
    rw [← mul_assoc, mul_inv_cancel₀ hN6, one_mul]
  rw [hL]
  -- the uniform pairs
  have hφm : Measurable fun h => conjPar s (I h) := (measurable_conjPar s).comp hIm
  have hφb : ∀ h, ‖conjPar s (I h)‖ ≤ (volume (Metric.closedBall (0 : E3) R₀)).toReal :=
    fun h => by rw [norm_conjPar]; exact hIb h
  rw [← integral_pi_sub_eq_fejerCube hH s hφm hφb]
  have hcube : ∀ Q : (Fin s → ℝ) × (Fin s → ℝ), conjPar s (I (Q.2 - Q.1))
      = ∫ x, dirCube G e Q.1 Q.2 x := by
    intro Q
    simp only [hI]
    rw [← integral_add_right_eq_self (μ := (volume : Measure E3))
      (fun x => fdiffIter e s (Q.2 - Q.1) G x) ((∑ i, Q.1 i) • e), integral_conjPar']
    refine integral_congr_ae (Eventually.of_forall fun x => ?_)
    rw [dirCube_eq_conjPar_fdiffIter]
  simp_rw [hcube]
  -- exchange the point and the pairs
  set R := max R₀ 0 + s * H with hR
  have hRnn : 0 ≤ R := add_nonneg (le_max_right _ _) (by positivity)
  have hR₀R : R₀ ≤ max R₀ 0 := le_max_left _ _
  have hsum : ∀ Q : (Fin s → ℝ) × (Fin s → ℝ), (∀ i, Q.1 i ∈ Set.Icc 0 H) →
      ‖(∑ i, Q.1 i) • e‖ ≤ s * H := by
    intro Q hQ
    rw [norm_smul, he, norm_basisVec, mul_one, Real.norm_eq_abs,
      abs_of_nonneg (Finset.sum_nonneg fun i _ => (hQ i).1)]
    calc ∑ i, Q.1 i ≤ ∑ _i : Fin s, H := Finset.sum_le_sum fun i _ => (hQ i).2
      _ = s * H := by simp
  have hdz : ∀ Q : (Fin s → ℝ) × (Fin s → ℝ), (∀ i, Q.1 i ∈ Set.Icc 0 H) → ∀ x : E3,
      R < ‖x‖ → dirCube G e Q.1 Q.2 x = 0 := by
    intro Q hQ x hx
    refine dirCube_eq_zero ?_
    by_contra hne
    have h1 := hR0 _ hne
    have h3 := norm_sub_le (x + (∑ i, Q.1 i) • e) ((∑ i, Q.1 i) • e)
    rw [add_sub_cancel_right] at h3
    linarith [hsum Q hQ]
  have hQae : ∀ᵐ Q ∂(πs.prod πs), ∀ i, Q.1 i ∈ Set.Icc 0 H :=
    Measure.quasiMeasurePreserving_fst.ae (ae_pi_unifMeas_mem (H := H) s)
  have hdcm : Measurable fun q : E3 × ((Fin s → ℝ) × (Fin s → ℝ)) =>
      dirCube G e q.2.1 q.2.2 q.1 := by
    have hv : Measurable (Function.uncurry fun (x : E3) (β : Fin s → ℝ) =>
        G (x + (∑ i, β i) • e)) :=
      hG.comp (measurable_fst.add ((Finset.measurable_sum _ fun i _ =>
        (measurable_pi_apply i).comp measurable_snd).smul_const _))
    have h := measurable_cubeProdSel_param hv
    exact h
  have hballR : volume (Metric.closedBall (0 : E3) R) ≠ ⊤ := measure_closedBall_lt_top.ne
  have hint2 : Integrable (Function.uncurry fun (Q : (Fin s → ℝ) × (Fin s → ℝ)) (x : E3) =>
      dirCube G e Q.1 Q.2 x) ((πs.prod πs).prod volume) := by
    have hind : Integrable (Set.indicator (Metric.closedBall (0 : E3) R) fun _ => (1 : ℝ)) :=
      (Measure.integrableOn_of_bounded (M := 1) hballR measurable_const.aestronglyMeasurable
        (Eventually.of_forall fun _ => by simp)).integrable_indicator measurableSet_closedBall
    have hm : Measurable (Function.uncurry fun (Q : (Fin s → ℝ) × (Fin s → ℝ)) (x : E3) =>
        dirCube G e Q.1 Q.2 x) := by
      have h := hdcm.comp (measurable_snd.prodMk measurable_fst)
      exact h
    refine Integrable.mono' ((integrable_const (1 : ℝ)).mul_prod hind)
      hm.aestronglyMeasurable ?_
    filter_upwards [Measure.quasiMeasurePreserving_fst.ae hQae] with q hq
    simp only [Function.uncurry, one_mul]
    by_cases hx : ‖q.2‖ ≤ R
    · rw [Set.indicator_of_mem (by simpa using hx)]
      exact norm_dirCube_le hG1 e _ _ _
    · rw [Set.indicator_of_notMem (by simpa using hx), hdz q.1 hq q.2 (lt_of_not_ge hx),
        norm_zero]
  rw [integral_integral_swap hint2]
  -- the transverse Fubini theorem
  set g : E3 → ℂ := fun x => ∫ Q, dirCube G e Q.1 Q.2 x ∂(πs.prod πs) with hg
  have hgm : Measurable g := by
    have h := (hdcm.stronglyMeasurable.integral_prod_right' (ν := πs.prod πs)).measurable
    exact h
  have hg1 : ∀ x, ‖g x‖ ≤ 1 := fun x =>
    norm_integral_le_one fun Q => norm_dirCube_le hG1 e _ _ _
  have hgs : ∀ x, R < ‖x‖ → g x = 0 := fun x hx => by
    change ∫ Q, dirCube G e Q.1 Q.2 x ∂(πs.prod πs) = 0
    rw [integral_congr_ae (hQae.mono fun Q hQ => hdz Q hQ x hx)]
    simp
  have hgi : Integrable g := by
    refine IntegrableOn.integrable_of_forall_notMem_eq_zero (s := Metric.closedBall (0 : E3) R)
      (Measure.integrableOn_of_bounded (M := 1) hballR hgm.aestronglyMeasurable
        (Eventually.of_forall hg1)) fun x hx => hgs x (by simpa using hx)
  rw [integral_embT jm hgi]
  -- the real part through the transverse integral
  have hcoord : ∀ (y : Fin 2 → ℝ) (z : ℝ), R < |z| → g (embT jm y z) = 0 := by
    intro y z hz
    refine hgs _ (lt_of_lt_of_le hz ?_)
    have := PiLp.norm_apply_le (embT jm y z) jm
    rwa [embT_apply_self, Real.norm_eq_abs] at this
  have hcoordy : ∀ (y : Fin 2 → ℝ) (z : ℝ), R < ‖y‖ → g (embT jm y z) = 0 := by
    intro y z hy
    refine hgs _ (lt_of_lt_of_le hy ?_)
    refine (pi_norm_le_iff_of_nonneg (norm_nonneg _)).mpr fun i => ?_
    have := PiLp.norm_apply_le (embT jm y z) (jm.succAbove i)
    rwa [embT_apply_succAbove] at this
  have hFm : Measurable fun y : Fin 2 → ℝ => ∫ z, g (embT jm y z) := by
    have h0 : Measurable fun q : (Fin 2 → ℝ) × ℝ => g (embT jm q.1 q.2) :=
      hgm.comp (measurable_embT jm)
    exact (h0.stronglyMeasurable.integral_prod_right' (ν := (volume : Measure ℝ))).measurable
  have hFb : ∀ y : Fin 2 → ℝ, ‖∫ z, g (embT jm y z)‖ ≤ 2 * R + 1 := by
    intro y
    have hind : Integrable (Set.indicator (Set.Icc (-R) R) fun _ => (1 : ℝ)) :=
      (continuous_const.integrableOn_Icc).integrable_indicator measurableSet_Icc
    refine (norm_integral_le_of_norm_le hind (Eventually.of_forall fun z => ?_)).trans ?_
    · by_cases hz : z ∈ Set.Icc (-R) R
      · rw [Set.indicator_of_mem hz]; exact hg1 _
      · rw [Set.indicator_of_notMem hz, hcoord y z (by
          rw [Set.mem_Icc, not_and_or, not_le, not_le] at hz
          rcases hz with h | h
          · rw [abs_of_neg (by linarith)]; linarith
          · rw [abs_of_pos (by linarith)]; exact h), norm_zero]
    · rw [integral_indicator measurableSet_Icc, setIntegral_const, Real.volume_real_Icc,
        smul_eq_mul, mul_one]
      rw [max_eq_left (by linarith)]
      linarith
  have hFi : Integrable fun y : Fin 2 → ℝ => ∫ z, g (embT jm y z) := by
    refine IntegrableOn.integrable_of_forall_notMem_eq_zero
      (s := Metric.closedBall (0 : Fin 2 → ℝ) R)
      (Measure.integrableOn_of_bounded (M := 2 * R + 1) measure_closedBall_lt_top.ne
        hFm.aestronglyMeasurable (Eventually.of_forall hFb)) fun y hy => ?_
    rw [integral_congr_ae (Eventually.of_forall fun z => hcoordy y z (by simpa using hy))]
    simp
  rw [show (∫ y, ∫ z, g (embT jm y z)).re = ∫ y, (∫ z, g (embT jm y z)).re from by
    have h := (Complex.reCLM.integral_comp_comm hFi).symm
    simpa using h]
  refine integral_congr_ae (Eventually.of_forall fun y => ?_)
  beta_reduce
  rw [unifPow1, ← mul_assoc, mul_inv_cancel₀ hS.ne', one_mul]
  congr 1
  refine integral_congr_ae (Eventually.of_forall fun z => ?_)
  beta_reduce
  simp only [hg, dirCube]
  congr 1
  funext Q
  congr 1
  funext β
  rw [embT_add_smul]

end

/-! ### Raising the order of the one-dimensional powers -/

section
open Filter Topology MeasureTheory

/-- The normalization of `Q_{r,H,S}` is only a scalar: `S Q_{r,H,S} = S' Q_{r,H,S'}`. -/
theorem mul_unifPow1_eq {H S S' : ℝ} (hS : S ≠ 0) (hS' : S' ≠ 0) (n : ℕ) (f : ℝ → ℂ) :
    S * unifPow1 H S n f = S' * unifPow1 H S' n f := by
  simp only [unifPow1]
  rw [← mul_assoc, ← mul_assoc, mul_inv_cancel₀ hS, mul_inv_cancel₀ hS']

/-- **Raising the order** (`patch:raise-order`, one-dimensional form, `r ≥ 1`):
`Q_{r,H,S}(f)² ≤ (1 + H/S) Q_{r+1,H,S}(f)` for a one-bounded `f` supported in `[c, c + S]`. -/
theorem sq_unifPow1_le {H S c : ℝ} (hH : 0 < H) (hS : 0 < S) {f : ℝ → ℂ} (hf : Measurable f)
    (hf1 : ∀ x, ‖f x‖ ≤ 1) (hfs : ∀ x, x ∉ Set.Icc c (c + S) → f x = 0) (r : ℕ) :
    unifPow1 H S (r + 1) f ^ 2 ≤ (1 + H / S) * unifPow1 H S (r + 2) f := by
  have := isProbabilityMeasure_unifMeas hH
  set πr := Measure.pi fun _ : Fin (r + 1) => unifMeas H with hπr
  -- `Q_{r+1}` as an average over the pairs of normalized integrals
  set X : (Fin (r + 1) → ℝ) × (Fin (r + 1) → ℝ) → ℂ := fun Q =>
    (S : ℂ)⁻¹ * ∫ x, cubeProdSel (fun β => f (x + ∑ i, β i)) Q.1 Q.2 with hX
  have hcm := measurable_pairedCube hf (r + 1)
  have hXm : Measurable X := by
    have h := ((hcm.comp (measurable_snd.prodMk measurable_fst)).stronglyMeasurable
      |>.integral_prod_right' (ν := (volume : Measure ℝ))).measurable.const_mul ((S : ℂ)⁻¹)
    exact h
  have hX1 : ∀ Q, ‖X Q‖ ≤ 1 := fun Q => by
    have e : X Q = cdlCoef S (fun x => cubeProdSel (fun β => f (x + ∑ i, β i)) Q.1 Q.2) 0 := by
      simp only [hX, cdlCoef]
      congr 1
      refine integral_congr_ae (Eventually.of_forall fun x => ?_)
      simp [ephase]
    rw [e]
    exact norm_cdlCoef_le hS (fun x => norm_cubeProdSel_le (fun β => hf1 _) _ _)
      (fun x hx => pairedCube_support hfs Q.1 Q.2 x hx) 0
  have hQ1 : unifPow1 H S (r + 1) f = (∫ Q, X Q ∂(πr.prod πr)).re := by
    rw [unifPow1]
    have hint : Integrable (Function.uncurry fun (x : ℝ)
        (Q : (Fin (r + 1) → ℝ) × (Fin (r + 1) → ℝ)) =>
          cubeProdSel (fun β => f (x + ∑ i, β i)) Q.1 Q.2) ((volume : Measure ℝ).prod
          (πr.prod πr)) := by
      have hm : Measurable (Function.uncurry fun (x : ℝ)
          (Q : (Fin (r + 1) → ℝ) × (Fin (r + 1) → ℝ)) =>
          cubeProdSel (fun β => f (x + ∑ i, β i)) Q.1 Q.2) := hcm
      have hind : Integrable (Set.indicator (Set.Icc (c - (r + 1) * H) (c + S))
          fun _ => (1 : ℝ)) :=
        (continuous_const.integrableOn_Icc).integrable_indicator measurableSet_Icc
      refine Integrable.mono' (hind.mul_prod (integrable_const (1 : ℝ)))
        hm.aestronglyMeasurable ?_
      have hQae : ∀ᵐ Q ∂(πr.prod πr), ∀ i, Q.1 i ∈ Set.Icc 0 H :=
        Measure.quasiMeasurePreserving_fst.ae (ae_pi_unifMeas_mem (H := H) (r + 1))
      filter_upwards [Measure.quasiMeasurePreserving_snd.ae hQae] with q hq
      simp only [Function.uncurry, mul_one]
      by_cases hx : q.1 ∈ Set.Icc (c - (r + 1) * H) (c + S)
      · rw [Set.indicator_of_mem hx]; exact norm_cubeProdSel_le (fun β => hf1 _) _ _
      · rw [Set.indicator_of_notMem hx]
        have h0 : 0 ≤ ∑ i, q.2.1 i := Finset.sum_nonneg fun i _ => (hq i).1
        have h1 : ∑ i, q.2.1 i ≤ (r + 1) * H := by
          calc ∑ i, q.2.1 i ≤ ∑ _i : Fin (r + 1), H := Finset.sum_le_sum fun i _ => (hq i).2
            _ = (r + 1) * H := by simp
        rw [pairedCube_support hfs q.2.1 q.2.2 q.1 (fun h => hx ⟨by linarith [h.1],
          by linarith [h.2]⟩), norm_zero]
    rw [integral_integral_swap hint]
    simp only [hX]
    rw [integral_const_mul, ← Complex.re_ofReal_mul]
    push_cast
    ring_nf
  -- Jensen, the support Cauchy-Schwarz, and the order raising
  have hJ : unifPow1 H S (r + 1) f ^ 2 ≤ ∫ Q, ‖X Q‖ ^ 2 ∂(πr.prod πr) := by
    rw [hQ1]
    have h1 : (∫ Q, X Q ∂(πr.prod πr)).re ^ 2 ≤ ‖∫ Q, X Q ∂(πr.prod πr)‖ ^ 2 := by
      have := Complex.abs_re_le_norm (∫ Q, X Q ∂(πr.prod πr))
      nlinarith [abs_nonneg (∫ Q, X Q ∂(πr.prod πr)).re, sq_abs (∫ Q, X Q ∂(πr.prod πr)).re]
    refine h1.trans ?_
    have h2 := sq_norm_integral_le_measure_mul (μ := πr.prod πr) MeasurableSet.univ
      (measure_ne_top _ _) (F := X) (fun x hx => absurd (Set.mem_univ x) hx)
      (integrable_of_bdd_finite ((hXm.norm.pow_const 2)) (C := 1) fun Q => by
        rw [abs_of_nonneg (by positivity)]; exact pow_le_one₀ (norm_nonneg _) (hX1 Q))
      (integrable_of_bdd_finite hXm.norm (C := 1) fun Q => by
        rw [abs_of_nonneg (norm_nonneg _)]; exact hX1 Q)
    simpa using h2
  set J : (Fin (r + 1) → ℝ) × (Fin (r + 1) → ℝ) → ℝ := fun Q =>
    ∫ x, ‖avgH H (fun y => cubeProdSel (fun β => f (y + ∑ i, β i)) Q.1 Q.2) x‖ ^ 2 with hJdef
  have hJm : Measurable J := measurable_integral_sq_avgH_pairedCube hf (r + 1)
  have hJb : ∀ Q, |J Q| ≤ S + H := fun Q => by
    rw [abs_of_nonneg (integral_nonneg fun x => by positivity)]
    exact integral_sq_avgH_pairedCube_le hH hS hf1 hfs Q.1 Q.2
  have hpt : ∀ Q, ‖X Q‖ ^ 2 ≤ (1 + H / S) * (S⁻¹ * J Q) := fun Q =>
    sq_norm_integral_le_avgH hH hS (p := c - ∑ i, Q.1 i)
      (measurable_pairedCube_at hf Q.1 Q.2) (fun x => norm_cubeProdSel_le (fun β => hf1 _) _ _)
      (fun y hy => pairedCube_support hfs Q.1 Q.2 y hy)
  have hmono : ∫ Q, ‖X Q‖ ^ 2 ∂(πr.prod πr) ≤ ∫ Q, (1 + H / S) * (S⁻¹ * J Q) ∂(πr.prod πr) :=
    integral_mono (integrable_of_bdd_finite (hXm.norm.pow_const 2) (C := 1) fun Q => by
        rw [abs_of_nonneg (by positivity)]; exact pow_le_one₀ (norm_nonneg _) (hX1 Q))
      (integrable_of_bdd_finite ((hJm.const_mul S⁻¹).const_mul (1 + H / S))
        (C := (1 + H / S) * (S⁻¹ * (S + H))) fun Q => by
          rw [abs_mul, abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ 1 + H / S),
            abs_of_nonneg (inv_nonneg.mpr hS.le)]
          gcongr
          exact hJb Q)
      hpt
  have hsucc := unifPow1_succ_eq hH hS hf hf1 hfs (r + 1)
  have hJi : Integrable J (πr.prod πr) := integrable_of_bdd_finite hJm (C := S + H) hJb
  refine hJ.trans (hmono.trans (le_of_eq ?_))
  rw [integral_const_mul, integral_const_mul, integral_prod _ hJi]
  rw [show (∫ b, ∫ c', J (b, c') ∂πr ∂πr) = S * unifPow1 H S (r + 2) f from hsucc.symm]
  field_simp

/-- **Raising the order over the sections**: if the sections vanish off a set of transverse
volume `V`, then `(∫_y Q_{r+1}(F_y))² ≤ V (1 + H/S) ∫_y Q_{r+2}(F_y)`. -/
theorem sq_integral_unifPow1_le {H S c : ℝ} (hH : 0 < H) (hS : 0 < S) {F : (Fin 2 → ℝ) → ℝ → ℂ}
    (hF : Measurable (Function.uncurry F)) (hF1 : ∀ y z, ‖F y z‖ ≤ 1)
    (hFs : ∀ y z, z ∉ Set.Icc c (c + S) → F y z = 0) {A : Set (Fin 2 → ℝ)}
    (hA : MeasurableSet A) (hAfin : volume A ≠ ⊤) (hFA : ∀ y, y ∉ A → ∀ z, F y z = 0) (r : ℕ) :
    (∫ y, unifPow1 H S (r + 1) (F y)) ^ 2
      ≤ (volume A).toReal * (1 + H / S) * ∫ y, unifPow1 H S (r + 2) (F y) := by
  have hFy : ∀ y, Measurable (F y) := fun y => by
    have h := hF.comp (measurable_prodMk_left (x := y))
    exact h
  have hQm : ∀ n, Measurable fun y => unifPow1 H S n (F y) := fun n =>
    measurable_unifPow1_param hF H S n
  have hQ01 : ∀ n y, unifPow1 H S (n + 1) (F y) ∈ Set.Icc 0 1 := fun n y =>
    unifPow1_mem_Icc hH hS (hFy y) (hF1 y) (hFs y) n
  have hQ0 : ∀ n y, y ∉ A → unifPow1 H S n (F y) = 0 := fun n y hy => by
    have : F y = fun _ => (0 : ℂ) := funext (hFA y hy)
    rw [this, unifPow1_zero_fun]
  have hint : ∀ n, Integrable (fun y => unifPow1 H S (n + 1) (F y)) := fun n =>
    IntegrableOn.integrable_of_forall_notMem_eq_zero (s := A)
      (Measure.integrableOn_of_bounded (M := 1) hAfin (hQm (n + 1)).aestronglyMeasurable
        (Eventually.of_forall fun y => by
          rw [Real.norm_of_nonneg (hQ01 n y).1]; exact (hQ01 n y).2))
      fun y hy => hQ0 (n + 1) y hy
  -- Cauchy-Schwarz on `A`
  have hCS : (∫ y, unifPow1 H S (r + 1) (F y)) ^ 2
      ≤ (volume A).toReal * ∫ y, unifPow1 H S (r + 1) (F y) ^ 2 := by
    have h := sq_norm_integral_le_measure_mul (μ := volume) hA hAfin
      (F := fun y => ((unifPow1 H S (r + 1) (F y) : ℝ) : ℂ))
      (fun y hy => by simp [hQ0 (r + 1) y hy])
      (by
        refine IntegrableOn.integrable_of_forall_notMem_eq_zero (s := A)
          (Measure.integrableOn_of_bounded (M := 1) hAfin
            (((Complex.measurable_ofReal.comp (hQm (r + 1))).norm.pow_const
              2)).aestronglyMeasurable
            (Eventually.of_forall fun y => ?_)) fun y hy => by simp [hQ0 (r + 1) y hy]
        simp only [Complex.norm_real, norm_pow, norm_norm]
        exact pow_le_one₀ (norm_nonneg _) (by
          rw [Real.norm_of_nonneg (hQ01 r y).1]; exact (hQ01 r y).2))
      (by simpa [Complex.norm_real] using (hint r).norm)
    simp only [Complex.norm_real, Real.norm_eq_abs, sq_abs] at h
    rw [integral_complex_ofReal, Complex.norm_real, Real.norm_eq_abs, sq_abs] at h
    exact h
  refine hCS.trans ?_
  rw [mul_assoc]
  refine mul_le_mul_of_nonneg_left ?_ ENNReal.toReal_nonneg
  rw [← integral_const_mul]
  refine integral_mono_of_nonneg (Eventually.of_forall fun y => sq_nonneg _)
    ((hint (r + 1)).const_mul _) (Eventually.of_forall fun y => ?_)
  exact sq_unifPow1_le hH hS (hFy y) (hF1 y) (hFs y) r

end

/-! ### `patch:major-arc`: iterated conditional degree lowering and raising the order -/

section
open Filter Topology MeasureTheory

set_option maxHeartbeats 2000000 in
-- The budget choices and the application of the abstract lemma share one context.
/-- **Lemma `patch:conditional-degree`** with a separate budget `cL` for the lower bound (the
support, coefficient and radius budget `c` fixes the section length). Assume
`MA(m, l)` for every budget. For admissible data, the adjoint-type function
`F(x) = E_t f_0(x + P_m(t) e_m) ∏_{i<m} f_i(x - P_i(t) e_i + P_m(t) e_m) e(p_{x + P_m(t)e_m}(t))`
with `p_x = Σ_{i=m+1}^{l} ξ_i(x) P_i + Σ_{i>l} η_i P_i`, and `H` comparable to `N^{d_m}`, a power
lower bound for the order-`(r+2)` powers of the sections of `F` in the direction `e_m` (in units
`N^{6 - d_m}` of the transverse volume, section length `S = 10 u_c(δ) N^{d_m}`) gives a power lower
bound for the order-`(r+1)` powers at the same `H`. -/
theorem conditionalDegreeLowering' {k : ℕ} {j : ℕ → Fin 3} {m l : ℕ} (hm : 1 ≤ m) (hml : m ≤ l)
    (hlk : l ≤ k) (hMA : MajorArcProperty k j m l) {r : ℕ} (hr : 1 ≤ r) {c : ℕ} (hc : 1 ≤ c)
    {cL : ℕ} (hcL : 1 ≤ cL) :
    ∃ C : ℕ, 1 ≤ C ∧ ∀ δ N : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ N →
      ∀ (P : ℕ → Polynomial ℝ) (f : ℕ → E3 → ℂ) (ξ : ℕ → E3 → ℝ) (η : ℕ → ℝ) (H : ℝ),
        (∀ i ∈ Finset.Icc 1 k, AdmissiblePoly c δ N (expo (j i)) (P i)) →
        (∀ i, Measurable (f i)) → (∀ i x, ‖f i x‖ ≤ 1) →
        (∀ i x, x ∉ petBox (budHi c δ) N → f i x = 0) → (∀ i, Measurable (ξ i)) →
        budLo c δ * N ^ expo (j m) ≤ H → H ≤ budHi c δ * N ^ expo (j m) →
        budLo cL δ * N ^ (6 - expo (j m)) ≤ ∫ y, unifPow1 H (10 * budHi c δ * N ^ expo (j m))
          (r + 2) (fun z => cdlF N m f P (maPhase (m + 1) l k ξ η P) j (embT (j m) y z)) →
        budLo C δ * N ^ (6 - expo (j m)) ≤ ∫ y, unifPow1 H (10 * budHi c δ * N ^ expo (j m))
          (r + 1) (fun z => cdlF N m f P (maPhase (m + 1) l k ξ η P) j (embT (j m) y z)) := by
  -- the power functions of the input budget
  have hLo : MonoLow (budLo c) := monoLow_budLo hc
  have hHi : MonoHigh (budHi c) := monoHigh_budHi hc
  have haF : MonoLow fun δ => budLo cL δ / (4 * budHi c δ ^ 2) :=
    (monoLow_budLo hcL).div ((monoHigh_const (by norm_num : (0 : ℝ) < 4)).mul (hHi.pow 2))
  have hhF : MonoLow fun δ => budLo c δ / (10 * budHi c δ) :=
    hLo.div ((monoHigh_const (by norm_num : (0 : ℝ) < 10)).mul hHi)
  -- the input budget of `MA(m, l)`
  have hF1 : MonoLow fun δ => 40 * budHi c δ ^ 3 * cdlThrLow (budLo cL δ / (4 * budHi c δ ^ 2))
      (budLo c δ / (10 * budHi c δ)) (1 / 10) r := by
    have h := monoLow_cdlThrLow haF hhF (hH := 1 / 10) (by norm_num) r
    refine ((monoLow_const (by norm_num : (0 : ℝ) < 40)).mul h).mono fun δ h0 h1 => ?_
    have hu : 1 ≤ budHi c δ := one_le_budHi h0 h1 hc
    have hth : 0 ≤ cdlThrLow (budLo cL δ / (4 * budHi c δ ^ 2))
        (budLo c δ / (10 * budHi c δ)) (1 / 10) r := (h.pos h0 h1).le
    have : 1 ≤ budHi c δ ^ 3 := one_le_pow₀ hu
    nlinarith
  obtain ⟨c₁', hc₁', hc₁'b⟩ := hF1.exists_budLo
  set c₁ := max c₁' ((1 + r) * c) with hc₁def
  have hc₁ : 1 ≤ c₁ := le_trans hc₁' (le_max_left _ _)
  have hcc₁ : c ≤ c₁ := le_trans (Nat.le_mul_of_pos_left c (by omega)) (le_max_right _ _)
  obtain ⟨C', hC'c₁, hMAC'⟩ := hMA c₁ hc₁
  have hC' : 1 ≤ C' := le_trans hc₁ hC'c₁
  -- the output budget
  have hLo' : MonoLow (budLo C') := monoLow_budLo hC'
  have hHi' : MonoHigh (budHi C') := monoHigh_budHi hC'
  have hρF : MonoLow fun δ => budLo C' δ / (8 * budHi C' δ * budHi c δ ^ 2) :=
    hLo'.div (((monoHigh_const (by norm_num : (0 : ℝ) < 8)).mul hHi').mul (hHi.pow 2))
  have hβF : MonoHigh fun δ => 10 * budHi c δ * budHi C' δ :=
    ((monoHigh_const (by norm_num : (0 : ℝ) < 10)).mul hHi).mul hHi'
  have hF2 : MonoLow fun δ => 4 * budHi c δ ^ 2 * cdlOutLow (budLo cL δ / (4 * budHi c δ ^ 2))
      (budLo c δ / (10 * budHi c δ)) (1 / 10) ((15 + r) / 10) (10 * budHi c δ * budHi C' δ)
      (budLo C' δ / (8 * budHi C' δ * budHi c δ ^ 2)) r := by
    have h := monoLow_cdlOutLow haF hhF hβF hρF (hH := 1 / 10) (κ := (15 + r) / 10)
      (by norm_num) (by positivity) r
    refine ((monoLow_const (by norm_num : (0 : ℝ) < 4)).mul h).mono fun δ h0 h1 => ?_
    have hu : 1 ≤ budHi c δ := one_le_budHi h0 h1 hc
    have hth := (h.pos h0 h1).le
    have : 1 ≤ budHi c δ ^ 2 := one_le_pow₀ hu
    nlinarith
  obtain ⟨C, hC, hCb⟩ := hF2.exists_budLo
  refine ⟨C, hC, ?_⟩
  intro δ N hδ0 hδ1 hN P f ξ η H hadm hf hf1 hfs hξ hH1 hH2 hQ
  have hN0 : 0 < N := by linarith
  set u := budHi c δ with hudef
  have hu1 : 1 ≤ u := one_le_budHi hδ0 hδ1 hc
  have hu0 : 0 < u := by linarith
  have hmk : m ∈ Finset.Icc 1 k := Finset.mem_Icc.mpr ⟨hm, le_trans hml hlk⟩
  have hd3 : expo (j m) ≤ 3 := Nat.succ_le_of_lt (Fin.is_lt _)
  have hNd : 0 < N ^ expo (j m) := pow_pos hN0 _
  set S := 10 * u * N ^ expo (j m) with hSdef
  have hS : 0 < S := by positivity
  set V := (volume (transBox (j m) u N)).toReal with hVdef
  have hV : V = (2 * u) ^ 2 * N ^ (6 - expo (j m)) := volume_transBox (j m) hu0.le hN0.le
  have hVpos : 0 < V := by rw [hV]; positivity
  have hVS : V * S = 40 * u ^ 3 * N ^ (6 : ℕ) := by
    rw [hV, hSdef, ← pow_add_sub_six N (by omega : expo (j m) ≤ 6)]; ring
  have hlo0 : 0 < budLo c δ := budLo_pos hδ0 hc
  have hH0 : 0 < H := lt_of_lt_of_le (mul_pos hlo0 hNd) hH1
  have hloL : 0 < budLo cL δ := budLo_pos hδ0 hcL
  set a := budLo cL δ / (4 * u ^ 2) with hadef
  have ha0 : 0 < a := by positivity
  set hL := budLo c δ / (10 * u) with hhLdef
  have hhL0 : 0 < hL := by positivity
  have hhL : hL ≤ H / S := by
    rw [hhLdef, hSdef, le_div_iff₀ (by positivity)]
    calc budLo c δ / (10 * u) * (10 * u * N ^ expo (j m)) = budLo c δ * N ^ expo (j m) := by
          field_simp
      _ ≤ H := hH1
  have hhH : H / S ≤ 1 / 10 := by
    rw [hSdef, div_le_iff₀ (by positivity)]
    calc H ≤ u * N ^ expo (j m) := hH2
      _ = 1 / 10 * (10 * u * N ^ expo (j m)) := by ring
  -- the measure spaces
  have := isProbabilityMeasure_transMeas (j m) hu0 hN0
  have := isProbabilityMeasure_unifIcc (by linarith : (0 : ℝ) < N)
  have hP3 : ∀ i ∈ Finset.Icc (m + 1) k, (P i).natDegree ≤ 3 := by
    intro i hi
    rw [(hadm i (by rw [Finset.mem_Icc] at hi ⊢; omega)).natDegree_eq]
    exact Nat.succ_le_of_lt (Fin.is_lt _)
  have hFm := measurable_cdlFt (N := N) hml hlk hf hP3 hξ η j
  -- sections as averages over the normalized transverse box
  have hsec : ∀ n : ℕ, (∫ y, unifPow1 H S n (fun z => ∫ t, cdlFt N m l k f P ξ η j t y z
      ∂unifIcc 0 N) ∂transMeas (j m) u N)
      = V⁻¹ * ∫ y, unifPow1 H S n
          (fun z => cdlF N m f P (maPhase (m + 1) l k ξ η P) j (embT (j m) y z)) := by
    intro n
    simp_rw [integral_cdlFt hN0]
    rw [transMeas, integral_smul_measure, ENNReal.toReal_inv, smul_eq_mul, ← hVdef]
    congr 1
    refine setIntegral_eq_integral_of_forall_compl_eq_zero fun y hy => ?_
    have h0 : (fun z => cdlF N m f P (maPhase (m + 1) l k ξ η P) j (embT (j m) y z))
        = fun _ => (0 : ℂ) := by
      funext z; exact cdlF_embT_eq_zero (hfs 0) P _ j hy z
    rw [h0, unifPow1_zero_fun]
  have hQ' : a ≤ ∫ y, unifPow1 H S (r + 2) (fun z => ∫ t, cdlFt N m l k f P ξ η j t y z
      ∂unifIcc 0 N) ∂transMeas (j m) u N := by
    rw [hsec]
    have h := hQ
    rw [hadef, hV]
    rw [hV] at hVpos
    calc budLo cL δ / (4 * u ^ 2)
        = ((2 * u) ^ 2 * N ^ (6 - expo (j m)))⁻¹ * (budLo cL δ * N ^ (6 - expo (j m))) := by
          field_simp; ring
      _ ≤ _ := mul_le_mul_of_nonneg_left h (inv_nonneg.mpr hVpos.le)
  -- the output budget of Step 5
  set B := budHi C' δ / N ^ expo (j m) with hBdef
  have hB0 : 0 < B := div_pos (budHi_pos hδ0 hC') hNd
  set ρ := budLo C' δ * N ^ (6 : ℕ) / (2 * budHi C' δ * N ^ expo (j m) * V) with hρdef
  have hρ0 : 0 < ρ := by
    have := budLo_pos hδ0 hC'; have := budHi_pos hδ0 hC'; positivity
  have hbox : (1 + r) * u ≤ budHi c₁ δ := by
    have h1 := budHi_mul_le hδ0 hδ1 hc (k := 1 + r) (by omega)
    have h2 := budHi_monotone hδ0 hδ1 (Nat.le_trans hc (Nat.le_mul_of_pos_left c (by omega)))
      (le_max_right c₁' ((1 + r) * c) : (1 + r) * c ≤ c₁)
    push_cast at h1
    linarith
  have hthrL : cdlThrLow a hL (1 / 10) r ≤ cdlThr a H S r :=
    cdlThr_ge hS hH0 ha0 le_rfl hhL0 hhL hhH r
  have hthr0 : budLo c₁ δ * N ^ (6 : ℕ) ≤ V * S * cdlThr a H S r := by
    have h1 := hc₁'b δ hδ0 hδ1
    have h2 := budLo_antitone hδ0 hδ1 hc₁' (le_max_left c₁' ((1 + r) * c) : c₁' ≤ c₁)
    rw [hVS]
    have hN6 : 0 < N ^ (6 : ℕ) := by positivity
    calc budLo c₁ δ * N ^ (6 : ℕ) ≤ 40 * u ^ 3 * cdlThrLow a hL (1 / 10) r * N ^ (6 : ℕ) :=
          mul_le_mul_of_nonneg_right (h2.trans h1) hN6.le
      _ ≤ 40 * u ^ 3 * cdlThr a H S r * N ^ (6 : ℕ) := by gcongr
      _ = 40 * u ^ 3 * N ^ (6 : ℕ) * cdlThr a H S r := by ring
  have hMA' : ∀ k' : (Fin r → ℝ) × (Fin r → ℝ) × (Fin r → ℝ), (∀ i, k'.2.1 i ∈ Set.Icc 0 H) →
      (∀ i, k'.2.2 i ∈ Set.Icc 0 H) → ∀ ψ : (Fin 2 → ℝ) → ℝ, Measurable ψ →
      cdlThr a H S r ≤ ∫ y, ‖cdlCoef S (cdlG (unifIcc 0 N) (cdlFt N m l k f P ξ η j) y
        k'.2.1 k'.2.2) (ψ y)‖ ∂transMeas (j m) u N →
      ρ ≤ (transMeas (j m) u N {y | |ψ y| ≤ B}).toReal := by
    intro k' hb _ ψ hψ hint
    exact cdl_step5 hr hN hδ0 hδ1 hm hml hlk hc hcc₁ hC' (hMAC' δ N hδ0 hδ1 hN) hf hf1 hfs
      hadm hξ η hS hH2 hbox k'.2.1 k'.2.2 hb hthr0 ψ hψ hint
  -- the abstract lemma
  have hout := cdl_abstract (μ := transMeas (j m) u N) (ν := unifIcc 0 N) hFm
    (fun t y z => norm_cdlFt_le hf1 P ξ η j t y z) hS hH0
    (c := -(5 * u * N ^ expo (j m)))
    (fun t y z hz => cdlFt_eq_zero_of_far hN hc hδ0 (hfs 0) hd3 (hadm m hmk) ξ η t y (by
      convert hz using 2)) hr ha0 hQ' hB0 hρ0 hMA'
  -- the final budget
  have hκ : (|-(5 * u * N ^ expo (j m))| + S + r * H) / S ≤ (15 + r) / 10 := by
    rw [abs_neg, abs_of_pos (by positivity), div_le_iff₀ hS, hSdef]
    have : (r : ℝ) * H ≤ r * (u * N ^ expo (j m)) := mul_le_mul_of_nonneg_left hH2 (by positivity)
    nlinarith
  have hβ : B * S ≤ 10 * u * budHi C' δ := by
    rw [hBdef, hSdef]; field_simp; exact le_rfl
  have hρeq : ρ = budLo C' δ / (8 * budHi C' δ * u ^ 2) := by
    rw [hρdef, hV]
    have hC'0 := budHi_pos hδ0 hC'
    rw [← pow_add_sub_six N (by omega : expo (j m) ≤ 6)]
    field_simp
    ring
  have hlow := cdlOut_ge hS hH0 ha0 le_rfl hhL0 hhL hhH r hκ hB0 hβ (hρeq ▸ hρ0)
    (le_of_eq hρeq.symm)
  have hC := hCb δ hδ0 hδ1
  have hfinal := hsec (r + 1)
  have hVinv : (∫ y, unifPow1 H S (r + 1)
      (fun z => cdlF N m f P (maPhase (m + 1) l k ξ η P) j (embT (j m) y z)))
      = V * ∫ y, unifPow1 H S (r + 1) (fun z => ∫ t, cdlFt N m l k f P ξ η j t y z
        ∂unifIcc 0 N) ∂transMeas (j m) u N := by
    rw [hfinal, ← mul_assoc, mul_inv_cancel₀ hVpos.ne', one_mul]
  rw [hVinv]
  have hN6d : 0 < N ^ (6 - expo (j m)) := by positivity
  calc budLo C δ * N ^ (6 - expo (j m))
      ≤ 4 * u ^ 2 * cdlOutLow a hL (1 / 10) ((15 + r) / 10) (10 * u * budHi C' δ)
          (budLo C' δ / (8 * budHi C' δ * u ^ 2)) r * N ^ (6 - expo (j m)) :=
        mul_le_mul_of_nonneg_right hC hN6d.le
    _ = V * cdlOutLow a hL (1 / 10) ((15 + r) / 10) (10 * u * budHi C' δ)
          (budLo C' δ / (8 * budHi C' δ * u ^ 2)) r := by rw [hV]; ring
    _ ≤ V * cdlOut a H S (-(5 * u * N ^ expo (j m))) r B ρ :=
        mul_le_mul_of_nonneg_left hlow hVpos.le
    _ ≤ _ := mul_le_mul_of_nonneg_left hout hVpos.le


theorem unifPow1_zero_eq (H S : ℝ) (f : ℝ → ℂ) :
    unifPow1 H S 0 f = S⁻¹ * (∫ x, f x).re := by
  rw [unifPow1]
  congr 2
  refine integral_congr_ae (Eventually.of_forall fun x => ?_)
  beta_reduce
  have h : ∀ Q : (Fin 0 → ℝ) × (Fin 0 → ℝ),
      cubeProdSel (fun β : Fin 0 → ℝ => f (x + ∑ i, β i)) Q.1 Q.2 = f x := fun Q => by
    rw [cubeProdSel_zero]; simp
  simp_rw [h]
  have hp : (Measure.pi fun _ : Fin 0 => unifMeas H) Set.univ = 1 := by
    rw [Measure.pi_of_empty]; simp
  simp only [integral_const, Measure.real]
  rw [← Set.univ_prod_univ, Measure.prod_prod, hp]
  simp

/-- **Raising the order from zero**: `Q_{0,H,S}(f)² ≤ (1 + H/S) Q_{1,H,S}(f)`. -/
theorem sq_unifPow1_zero_le {H S c : ℝ} (hH : 0 < H) (hS : 0 < S) {f : ℝ → ℂ}
    (hf : Measurable f) (hf1 : ∀ x, ‖f x‖ ≤ 1) (hfs : ∀ x, x ∉ Set.Icc c (c + S) → f x = 0) :
    unifPow1 H S 0 f ^ 2 ≤ (1 + H / S) * unifPow1 H S 1 f := by
  have := isProbabilityMeasure_unifMeas hH
  have h1 := unifPow1_succ_eq hH hS hf hf1 hfs 0
  have h0 : ∀ b c' : Fin 0 → ℝ, (∫ x, ‖avgH H (fun y =>
      cubeProdSel (fun β : Fin 0 → ℝ => f (y + ∑ i, β i)) b c') x‖ ^ 2)
      = ∫ x, ‖avgH H f x‖ ^ 2 := fun b c' => by
    congr 1; funext x; congr 3; funext y; rw [cubeProdSel_zero]; simp
  simp_rw [h0] at h1
  simp only [integral_const, probReal_univ, one_smul] at h1
  have hcs := sq_norm_integral_le_avgH hH hS hf hf1 hfs (p := c)
  rw [unifPow1_zero_eq]
  have hre : (S⁻¹ * (∫ x, f x).re) ^ 2 ≤ ‖(S : ℂ)⁻¹ * ∫ x, f x‖ ^ 2 := by
    rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hS.le, mul_pow, mul_pow]
    have := Complex.abs_re_le_norm (∫ x, f x)
    have hsq : (∫ x, f x).re ^ 2 ≤ ‖∫ x, f x‖ ^ 2 := by
      nlinarith [abs_nonneg (∫ x, f x).re, sq_abs (∫ x, f x).re]
    exact mul_le_mul_of_nonneg_left hsq (by positivity)
  refine hre.trans (hcs.trans (le_of_eq ?_))
  rw [← h1]
  field_simp

/-- **One raising step over the sections**, from a pointwise raising inequality. -/
theorem sq_integral_raise {H S c : ℝ} (hH : 0 < H) (hS : 0 < S) {F : (Fin 2 → ℝ) → ℝ → ℂ}
    (hF : Measurable (Function.uncurry F)) (hF1 : ∀ y z, ‖F y z‖ ≤ 1)
    (hFs : ∀ y z, z ∉ Set.Icc c (c + S) → F y z = 0) {A : Set (Fin 2 → ℝ)}
    (hA : MeasurableSet A) (hAfin : volume A ≠ ⊤) (hFA : ∀ y, y ∉ A → ∀ z, F y z = 0) (n : ℕ)
    (hraise : ∀ y, unifPow1 H S n (F y) ^ 2 ≤ (1 + H / S) * unifPow1 H S (n + 1) (F y)) :
    (∫ y, unifPow1 H S n (F y)) ^ 2
      ≤ (volume A).toReal * (1 + H / S) * ∫ y, unifPow1 H S (n + 1) (F y) := by
  have hFy : ∀ y, Measurable (F y) := fun y => by
    have h := hF.comp (measurable_prodMk_left (x := y))
    exact h
  have hQm : ∀ n, Measurable fun y => unifPow1 H S n (F y) := fun n =>
    measurable_unifPow1_param hF H S n
  have hQ0 : ∀ n y, y ∉ A → unifPow1 H S n (F y) = 0 := fun n y hy => by
    have : F y = fun _ => (0 : ℂ) := funext (hFA y hy)
    rw [this, unifPow1_zero_fun]
  have hQb : ∀ n y, |unifPow1 H S n (F y)| ≤ 1 := by
    intro n y
    rcases n with _ | n
    · rw [unifPow1_zero_eq, abs_mul, abs_of_pos (inv_pos.mpr hS)]
      have h := norm_cdlCoef_le (ψ := 0) hS (hF1 y) (hFs y)
      have e : cdlCoef S (F y) 0 = (S : ℂ)⁻¹ * ∫ x, F y x := by
        simp only [cdlCoef]; congr 1
        refine integral_congr_ae (Eventually.of_forall fun x => ?_); simp [ephase]
      rw [e, norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hS.le] at h
      exact (mul_le_mul_of_nonneg_left (Complex.abs_re_le_norm _) (inv_nonneg.mpr hS.le)).trans h
    · have := unifPow1_mem_Icc hH hS (hFy y) (hF1 y) (hFs y) n
      rw [abs_of_nonneg this.1]; exact this.2
  have hint : ∀ n, Integrable (fun y => unifPow1 H S n (F y)) := fun n =>
    IntegrableOn.integrable_of_forall_notMem_eq_zero (s := A)
      (Measure.integrableOn_of_bounded (M := 1) hAfin (hQm n).aestronglyMeasurable
        (Eventually.of_forall fun y => by rw [Real.norm_eq_abs]; exact hQb n y))
      fun y hy => hQ0 n y hy
  have hCS : (∫ y, unifPow1 H S n (F y)) ^ 2
      ≤ (volume A).toReal * ∫ y, unifPow1 H S n (F y) ^ 2 := by
    have h := sq_norm_integral_le_measure_mul (μ := volume) hA hAfin
      (F := fun y => ((unifPow1 H S n (F y) : ℝ) : ℂ))
      (fun y hy => by simp [hQ0 n y hy])
      (by
        refine IntegrableOn.integrable_of_forall_notMem_eq_zero (s := A)
          (Measure.integrableOn_of_bounded (M := 1) hAfin
            (((Complex.measurable_ofReal.comp (hQm n)).norm.pow_const
              2)).aestronglyMeasurable
            (Eventually.of_forall fun y => ?_)) fun y hy => by simp [hQ0 n y hy]
        simp only [Complex.norm_real, norm_pow, norm_norm]
        exact pow_le_one₀ (norm_nonneg _) (by rw [Real.norm_eq_abs]; exact hQb n y))
      (by simpa [Complex.norm_real] using (hint n).norm)
    simp only [Complex.norm_real, Real.norm_eq_abs, sq_abs] at h
    rw [integral_complex_ofReal, Complex.norm_real, Real.norm_eq_abs, sq_abs] at h
    exact h
  refine hCS.trans ?_
  rw [mul_assoc]
  refine mul_le_mul_of_nonneg_left ?_ ENNReal.toReal_nonneg
  rw [← integral_const_mul]
  exact integral_mono_of_nonneg (Eventually.of_forall fun y => sq_nonneg _)
    ((hint (n + 1)).const_mul _) (Eventually.of_forall hraise)

/-- **Iterated conditional degree lowering**: with the section length fixed by the support budget
`c`, a lower bound for the order-`(n+2)` powers gives a lower bound for the order-two powers. -/
theorem cdl_iterate {k : ℕ} {j : ℕ → Fin 3} {m l : ℕ} (hm : 1 ≤ m) (hml : m ≤ l) (hlk : l ≤ k)
    (hMA : MajorArcProperty k j m l) {c : ℕ} (hc : 1 ≤ c) :
    ∀ n : ℕ, ∀ cL : ℕ, 1 ≤ cL → ∃ C : ℕ, 1 ≤ C ∧ ∀ δ N : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ N →
      ∀ (P : ℕ → Polynomial ℝ) (f : ℕ → E3 → ℂ) (ξ : ℕ → E3 → ℝ) (η : ℕ → ℝ) (H : ℝ),
        (∀ i ∈ Finset.Icc 1 k, AdmissiblePoly c δ N (expo (j i)) (P i)) →
        (∀ i, Measurable (f i)) → (∀ i x, ‖f i x‖ ≤ 1) →
        (∀ i x, x ∉ petBox (budHi c δ) N → f i x = 0) → (∀ i, Measurable (ξ i)) →
        budLo c δ * N ^ expo (j m) ≤ H → H ≤ budHi c δ * N ^ expo (j m) →
        budLo cL δ * N ^ (6 - expo (j m)) ≤ ∫ y, unifPow1 H (10 * budHi c δ * N ^ expo (j m))
          (n + 2) (fun z => cdlF N m f P (maPhase (m + 1) l k ξ η P) j (embT (j m) y z)) →
        budLo C δ * N ^ (6 - expo (j m)) ≤ ∫ y, unifPow1 H (10 * budHi c δ * N ^ expo (j m))
          2 (fun z => cdlF N m f P (maPhase (m + 1) l k ξ η P) j (embT (j m) y z)) := by
  intro n
  induction n with
  | zero =>
    intro cL hcL
    exact ⟨cL, hcL, fun δ N _ _ _ P f ξ η H _ _ _ _ _ _ _ h => h⟩
  | succ n ih =>
    intro cL hcL
    obtain ⟨C₁, hC₁, h1⟩ := conditionalDegreeLowering' hm hml hlk hMA (r := n + 1) (by omega)
      hc hcL
    obtain ⟨C, hC, h2⟩ := ih C₁ hC₁
    refine ⟨C, hC, fun δ N hδ0 hδ1 hN P f ξ η H hadm hf hf1 hfs hξ hH1 hH2 hQ => ?_⟩
    exact h2 δ N hδ0 hδ1 hN P f ξ η H hadm hf hf1 hfs hξ hH1 hH2
      (h1 δ N hδ0 hδ1 hN P f ξ η H hadm hf hf1 hfs hξ hH1 hH2 hQ)

end

/-! ### `patch:major-arc`: uniformity and degree lowering using `MA(m, l)` -/

section
open Filter Topology MeasureTheory

/-- **Raising the order of the sections** (`patch:raise-order`, integrated form): for a one-bounded
Borel `G` supported in the box `petBox C N` and a section length `S ≥ 2 C N^{d}`,
`(∫_y Q_{n,H,S}(G_y))² ≤ (2C)² N^{6-d} (1 + H/S) ∫_y Q_{n+1,H,S}(G_y)`. -/
theorem sq_integral_sections_raise {N H S C : ℝ} (hN : 0 < N) (hH : 0 < H) (hC : 0 ≤ C)
    (jm : Fin 3) (hS : 0 < S) (hCS : 2 * C * N ^ expo jm ≤ S) {G : E3 → ℂ} (hG : Measurable G)
    (hG1 : ∀ x, ‖G x‖ ≤ 1) (hGs : ∀ x, x ∉ petBox C N → G x = 0) (n : ℕ) :
    (∫ y, unifPow1 H S n (fun z => G (embT jm y z))) ^ 2
      ≤ (2 * C) ^ 2 * N ^ (6 - expo jm) * (1 + H / S)
        * ∫ y, unifPow1 H S (n + 1) (fun z => G (embT jm y z)) := by
  have hF : Measurable (Function.uncurry fun (y : Fin 2 → ℝ) (z : ℝ) => G (embT jm y z)) := by
    have h := hG.comp (measurable_embT jm)
    exact h
  have hmem : ∀ y z, G (embT jm y z) ≠ 0 →
      y ∈ transBox jm C N ∧ z ∈ Set.Icc (-(C * N ^ expo jm)) (C * N ^ expo jm) := by
    intro y z h
    have hb : embT jm y z + (0 : ℝ) • basisVec jm ∈ petBox C N := by
      rw [zero_smul, add_zero]; by_contra hb; exact h (hGs _ hb)
    have := mem_of_embT_mem_petBox hb
    rw [add_zero] at this
    exact this
  have hFs : ∀ y z, z ∉ Set.Icc (-(C * N ^ expo jm)) (-(C * N ^ expo jm) + S) →
      G (embT jm y z) = 0 := by
    intro y z hz
    by_contra h
    obtain ⟨_, h1, h2⟩ := hmem y z h
    exact hz ⟨h1, by linarith⟩
  have hFA : ∀ y, y ∉ transBox jm C N → ∀ z, G (embT jm y z) = 0 := by
    intro y hy z
    by_contra h
    exact hy (hmem y z h).1
  have hV := volume_transBox jm hC hN.le
  have hA := measurableSet_transBox jm C N
  have hAfin := (volume_transBox_lt_top jm C N).ne
  rcases n with _ | n
  · have hFy : ∀ y, Measurable fun z => G (embT jm y z) := fun y => by
      have h := hF.comp (measurable_prodMk_left (x := y))
      exact h
    have h := sq_integral_raise hH hS hF (fun y z => hG1 _) hFs hA hAfin hFA 0
      (fun y => sq_unifPow1_zero_le hH hS (hFy y) (fun z => hG1 _) (hFs y))
    rwa [hV] at h
  · have h := sq_integral_unifPow1_le hH hS hF (fun y z => hG1 _) hFs hA hAfin hFA n
    rwa [hV] at h

set_option maxHeartbeats 1000000 in
-- The budget choices and the chain of estimates share one context.
/-- **Theorem `patch:major-arc`, the step "obtain uniformity, using only the smaller major-arc
property".**  Assume `MA(m, l)` for every budget.  If the correlation of `MA(m+1, l)` is
power-large, then the exact adjoint `F` of `patch:ma-adjoint` has power-large directional `U²`
powers of its sections in the direction `e_m`, at the radius `H = u_{C₁}(δ) N^{d_m}` and the section
length `S = 10 u_{c'}(δ) N^{d_m}`: `patch:highest-control` gives uniformity of some order `s₀`,
`patch:raise-order` raises it to `s₀ + 2`, and `patch:conditional-degree` lowers it `s₀` times. -/
theorem ma_uniformity {k : ℕ} {j : ℕ → Fin 3} {m l : ℕ} (hm : 1 ≤ m) (hml : m ≤ l)
    (hlk : l ≤ k) (hj : ∀ i ∈ Finset.Icc 1 m, i ≠ m → expo (j i) < expo (j m))
    (hMA : MajorArcProperty k j m l) {c : ℕ} (hc : 1 ≤ c) :
    ∃ C₁ c' C : ℕ, 1 ≤ C₁ ∧ c ≤ c' ∧ 1 ≤ C ∧ ∀ δ N : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ N →
      ∀ (P : ℕ → Polynomial ℝ) (g : ℕ → E3 → ℂ) (ζ : ℕ → E3 → ℝ) (θ : ℕ → ℝ),
        (∀ i ∈ Finset.Icc 1 k, AdmissiblePoly c δ N (expo (j i)) (P i)) →
        (∀ i, Measurable (g i)) → (∀ i y, ‖g i y‖ ≤ 1) →
        (∀ i y, y ∉ petBox (budHi c δ) N → g i y = 0) → (∀ i, Measurable (ζ i)) →
        budLo c δ * N ^ (6 : ℕ) ≤ ‖phaseCorr N m g P (maPhase (m + 1) l k ζ θ P) j‖ →
        budLo C δ * N ^ (6 - expo (j m)) ≤ ∫ y, unifPow1 (budHi C₁ δ * N ^ expo (j m))
          (10 * budHi c' δ * N ^ expo (j m)) 2
          (fun z => maAdj N m l k g P ζ θ j (embT (j m) y z)) := by
  -- the input budget of `patch:highest-control`
  have hLo : MonoLow (budLo c) := monoLow_budLo hc
  have hHi : MonoHigh (budHi c) := monoHigh_budHi hc
  have hA : MonoLow fun δ => budLo c δ ^ 2 / (8 * budHi c δ ^ 3) :=
    (hLo.pow 2).div ((monoHigh_const (by norm_num : (0 : ℝ) < 8)).mul (hHi.pow 3))
  obtain ⟨cA, hcA, hcAb⟩ := hA.exists_budLo
  set c₀ := max (5 * c) cA with hc₀def
  have hc₀ : 1 ≤ c₀ := le_trans hcA (le_max_right _ _)
  have h5c : 5 * c ≤ c₀ := le_max_left _ _
  have hcc₀ : c ≤ c₀ := le_trans (by omega) h5c
  obtain ⟨s₀, C₁, C₂, hC₁, hC₂, hHC⟩ := highestControl m hm j hj c₀ hc₀
  -- the section length budget
  set c' := max c₀ C₁ with hc'def
  have hc₀c' : c₀ ≤ c' := le_max_left _ _
  have hC₁c' : C₁ ≤ c' := le_max_right _ _
  have hcc' : c ≤ c' := le_trans hcc₀ hc₀c'
  have hc' : 1 ≤ c' := le_trans hc hcc'
  -- the lower bound after raising twice
  have hHi' : MonoHigh (budHi c') := monoHigh_budHi hc'
  have hl0 : MonoLow fun δ => budLo C₂ δ / (10 * budHi c' δ) :=
    (monoLow_budLo hC₂).div ((monoHigh_const (by norm_num : (0 : ℝ) < 10)).mul hHi')
  have hden : MonoHigh fun δ => 200 * budHi c δ ^ 2 :=
    (monoHigh_const (by norm_num : (0 : ℝ) < 200)).mul (hHi.pow 2)
  have hl1 : MonoLow fun δ => (budLo C₂ δ / (10 * budHi c' δ)) ^ 2 / (200 * budHi c δ ^ 2) :=
    (hl0.pow 2).div hden
  have hl2 : MonoLow fun δ => ((budLo C₂ δ / (10 * budHi c' δ)) ^ 2 / (200 * budHi c δ ^ 2)) ^ 2
      / (200 * budHi c δ ^ 2) := (hl1.pow 2).div hden
  obtain ⟨cL, hcL, hcLb⟩ := hl2.exists_budLo
  obtain ⟨C, hC, hit⟩ := cdl_iterate hm hml hlk hMA hc' s₀ cL hcL
  refine ⟨C₁, c', C, hC₁, hcc', hC, ?_⟩
  intro δ N hδ0 hδ1 hN P g ζ θ hadm hg hg1 hgs hζ hcorr
  have hN0 : 0 < N := by linarith
  set u := budHi c δ with hudef
  have hu1 : 1 ≤ u := one_le_budHi hδ0 hδ1 hc
  have hu0 : 0 < u := by linarith
  have hlo := budLo_pos hδ0 hc
  obtain ⟨hFm, hF1, hFs, hFcorr, hFsq⟩ := ma_adjoint hN hδ0 hc hm hml hlk hg hg1 hgs hadm hζ θ
  set F := maAdj N m l k g P ζ θ j with hFdef
  set I := ∫ y, ‖F y‖ ^ 2 with hIdef
  have hN6 : 0 < N ^ (6 : ℕ) := by positivity
  -- the replaced correlation is power-large
  have hI : budLo c₀ δ * N ^ (6 : ℕ) ≤ I := by
    have h1 : (budLo c δ * N ^ (6 : ℕ)) ^ 2 ≤ 8 * u ^ 3 * N ^ 6 * I :=
      (pow_le_pow_left₀ (by positivity) hcorr 2).trans hFsq
    have h2 := hcAb δ hδ0 hδ1
    have h3 : budLo c₀ δ ≤ budLo cA δ := budLo_antitone hδ0 hδ1 hcA (le_max_right _ _)
    calc budLo c₀ δ * N ^ (6 : ℕ) ≤ budLo c δ ^ 2 / (8 * u ^ 3) * N ^ (6 : ℕ) :=
          mul_le_mul_of_nonneg_right (h3.trans h2) hN6.le
      _ = (budLo c δ * N ^ (6 : ℕ)) ^ 2 / (8 * u ^ 3 * N ^ 6) := by field_simp
      _ ≤ I := by rw [div_le_iff₀ (by positivity)]; nlinarith [h1]
  -- `patch:highest-control` for the replaced inputs
  have h5 : 5 * u ≤ budHi c₀ δ := by
    have h := budHi_mul_le hδ0 hδ1 hc (k := 5) (by norm_num)
    push_cast at h
    exact h.trans (budHi_monotone hδ0 hδ1 (by omega) h5c)
  have hbox5 : petBox (5 * u) N ⊆ petBox (budHi c₀ δ) N := petBox_mono h5 hN0.le
  have hbox1 : petBox u N ⊆ petBox (5 * u) N := petBox_mono (by linarith) hN0.le
  have hf : ∀ i, Measurable (Function.update g m F i) := fun i => by
    by_cases hi : i = m
    · rw [hi, Function.update_self]; exact hFm
    · rw [Function.update_of_ne hi]; exact hg i
  have hf1 : ∀ i y, ‖Function.update g m F i y‖ ≤ 1 := fun i y => by
    by_cases hi : i = m
    · rw [hi, Function.update_self]; exact hF1 y
    · rw [Function.update_of_ne hi]; exact hg1 i y
  have hfs : ∀ i y, y ∉ petBox (budHi c₀ δ) N → Function.update g m F i y = 0 := fun i y hy => by
    by_cases hi : i = m
    · rw [hi, Function.update_self]; exact hFs y fun h => hy (hbox5 h)
    · rw [Function.update_of_ne hi]; exact hgs i y fun h => hy (hbox5 (hbox1 h))
  have hadm0 : ∀ i ∈ Finset.Icc 1 m, AdmissiblePoly c₀ δ N (expo (j i)) (P i) := fun i hi =>
    (hadm i (by rw [Finset.mem_Icc] at hi ⊢; omega)).mono hδ0 hδ1 hc hcc₀ hN0.le
  have hP3 : ∀ i ∈ Finset.Icc (m + 1) k, (P i).natDegree ≤ 3 := by
    intro i hi
    rw [(hadm i (by rw [Finset.mem_Icc] at hi ⊢; omega)).natDegree_eq]
    exact Nat.succ_le_of_lt (Fin.is_lt _)
  have hcorr0 : budLo c₀ δ * N ^ (6 : ℕ)
      ≤ ‖phaseCorr N m (Function.update g m F) P (maPhase (m + 1) l k ζ θ P) j‖ := by
    rw [hFcorr, Complex.norm_real, Real.norm_of_nonneg (integral_nonneg fun y => by positivity)]
    exact hI
  have hQ := hHC δ N hδ0 hδ1 hN P (Function.update g m F) (maPhase (m + 1) l k ζ θ P) hadm0 hf
    hf1 hfs (fun x => maPhase_natDegree_le' hP3 (by omega) hlk x)
    (measurable_maPhase_coeff hζ θ P) hcorr0
  rw [Function.update_self] at hQ
  -- the Fejer power as an integral of section powers
  set d := expo (j m) with hddef
  have hd6 : d ≤ 6 := by have : d ≤ 3 := Nat.succ_le_of_lt (Fin.is_lt _); omega
  have hNd : 0 < N ^ d := pow_pos hN0 _
  set H := budHi C₁ δ * N ^ d with hHdef
  have hH0 : 0 < H := mul_pos (budHi_pos hδ0 hC₁) hNd
  set S := 10 * budHi c' δ * N ^ d with hSdef
  have hS : 0 < S := mul_pos (mul_pos (by norm_num) (budHi_pos hδ0 hc')) hNd
  set X : ℕ → ℝ := fun n => ∫ y, unifPow1 H S n (fun z => F (embT (j m) y z)) with hXdef
  have hsec := re_locUnifPow_eq_sections hN0 hH0 (j m) s₀ hFm hF1 hFs hS
  rw [integral_const_mul] at hsec
  have hNd6 : 0 < N ^ (6 - d) := pow_pos hN0 _
  have hX0 : budLo C₂ δ / (10 * budHi c' δ) * N ^ (6 - d) ≤ X s₀ := by
    have h1 : N ^ (6 : ℕ) * budLo C₂ δ ≤ S * X s₀ := by
      rw [← hsec]; exact mul_le_mul_of_nonneg_left hQ hN6.le
    have hc'0 := budHi_pos hδ0 hc'
    rw [← pow_add_sub_six N hd6, hSdef] at h1
    rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
    have h2 : 0 < N ^ d := hNd
    nlinarith [h1]
  -- raising the order twice
  have hHS : 1 + H / S ≤ 2 := by
    have h1 : budHi C₁ δ ≤ budHi c' δ := budHi_monotone hδ0 hδ1 hC₁ hC₁c'
    have h2 : H ≤ S := by
      rw [hHdef, hSdef]
      have := budHi_pos hδ0 hc'
      nlinarith
    have : H / S ≤ 1 := (div_le_one hS).mpr h2
    linarith
  have hCS : 2 * (5 * u) * N ^ d ≤ S := by
    have h1 : u ≤ budHi c' δ := budHi_monotone hδ0 hδ1 hc hcc'
    rw [hSdef]; nlinarith
  have hstep : ∀ (n : ℕ) (a : ℝ), 0 ≤ a → a * N ^ (6 - d) ≤ X n →
      a ^ 2 / (200 * u ^ 2) * N ^ (6 - d) ≤ X (n + 1) := by
    intro n a ha h
    have hR := sq_integral_sections_raise hN0 hH0 (C := 5 * u) (by positivity) (j m) hS hCS hFm
      hF1 hFs n
    have hV0 : 0 < (2 * (5 * u)) ^ 2 * N ^ (6 - d) * (1 + H / S) := by positivity
    have hsq : (a * N ^ (6 - d)) ^ 2 ≤ X n ^ 2 := pow_le_pow_left₀ (by positivity) h 2
    have h1 : (a * N ^ (6 - d)) ^ 2 / ((2 * (5 * u)) ^ 2 * N ^ (6 - d) * (1 + H / S))
        ≤ X (n + 1) := by
      rw [div_le_iff₀ hV0]; linarith [hsq, hR]
    refine le_trans ?_ h1
    have h2 : (a * N ^ (6 - d)) ^ 2 / ((2 * (5 * u)) ^ 2 * N ^ (6 - d) * 2)
        ≤ (a * N ^ (6 - d)) ^ 2 / ((2 * (5 * u)) ^ 2 * N ^ (6 - d) * (1 + H / S)) :=
      div_le_div_of_nonneg_left (by positivity) hV0
        (mul_le_mul_of_nonneg_left hHS (by positivity))
    refine le_of_eq_of_le ?_ h2
    field_simp
    ring
  have hl0' : 0 ≤ budLo C₂ δ / (10 * budHi c' δ) :=
    div_nonneg (budLo_pos hδ0 hC₂).le (by have := budHi_pos hδ0 hc'; positivity)
  have hX1 := hstep s₀ _ hl0' hX0
  have hX2 := hstep (s₀ + 1) _ (by positivity) hX1
  have hQ2 : budLo cL δ * N ^ (6 - d) ≤ X (s₀ + 2) :=
    le_trans (mul_le_mul_of_nonneg_right (hcLb δ hδ0 hδ1) hNd6.le) hX2
  -- lowering the order `s₀` times
  have hbox' : petBox u N ⊆ petBox (budHi c' δ) N :=
    petBox_mono (budHi_monotone hδ0 hδ1 hc hcc') hN0.le
  have hH1 : budLo c' δ * N ^ d ≤ H :=
    mul_le_mul_of_nonneg_right ((budLo_le_one hδ0 hδ1 hc').trans
      (one_le_budHi hδ0 hδ1 hC₁)) hNd.le
  have hH2 : H ≤ budHi c' δ * N ^ d :=
    mul_le_mul_of_nonneg_right (budHi_monotone hδ0 hδ1 hC₁ hC₁c') hNd.le
  exact hit δ N hδ0 hδ1 hN P (fun i x => conj (g i x)) (fun i x => -ζ i x) (fun i => -θ i) H
    (fun i hi => (hadm i hi).mono hδ0 hδ1 hc hcc' hN0.le)
    (fun i => Complex.continuous_conj.measurable.comp (hg i))
    (fun i x => by rw [RCLike.norm_conj]; exact hg1 i x)
    (fun i x hx => by simp [hgs i x fun h => hx (hbox' h)])
    (fun i => (hζ i).neg) hH1 hH2 hQ2

end

/-! ### `patch:ma-smaller-pattern`: the smaller pattern -/

section
open Filter Topology MeasureTheory

theorem projT_add_smul (m : Fin 3) (x : E3) (s : ℝ) :
    projT m (x + s • basisVec m) = projT m x := by
  conv_lhs => rw [← embT_projT m x]
  rw [embT_add_smul, projT_embT]

theorem projT_sub_smul (m : Fin 3) (x : E3) (s : ℝ) :
    projT m (x - s • basisVec m) = projT m x := by
  rw [sub_eq_add_neg, ← neg_smul, projT_add_smul]

theorem sub_smul_basisVec_apply_self (m : Fin 3) (x : E3) (s : ℝ) :
    (x - s • basisVec m) m = x m - s := by
  simp only [PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, basisVec_apply_self, mul_one]

/-- The adjoint of the last active input does not involve that input. -/
theorem maAdj_update {N : ℝ} {m l k : ℕ} (hm : 1 ≤ m) (g : ℕ → E3 → ℂ) (h : E3 → ℂ)
    (P : ℕ → Polynomial ℝ) (ζ : ℕ → E3 → ℝ) (θ : ℕ → ℝ) (j : ℕ → Fin 3) :
    maAdj N m l k (Function.update g m h) P ζ θ j = maAdj N m l k g P ζ θ j := by
  funext x
  have h0 : Function.update g m h 0 = g 0 := Function.update_of_ne (by omega) _ _
  have hi : ∀ i ∈ Finset.Icc 1 (m - 1), Function.update g m h i = g i := fun i hi =>
    Function.update_of_ne (by rw [Finset.mem_Icc] at hi; omega) _ _
  simp only [maAdj, cdlF, phaseProd, h0]
  congr 1
  refine intervalIntegral.integral_congr fun t _ => ?_
  rw [Finset.prod_congr rfl fun i hi' => by rw [hi i hi']]

/-- The inputs of the smaller pattern `patch:ma-smaller-pattern`: `g_0` multiplied by
`conj c(x_{≠m}) e(-λ(x_{≠m}) x_m)`, the other inputs unchanged. -/
noncomputable def spIn (g : ℕ → E3 → ℂ) (w : (Fin 2 → ℝ) → ℂ) (lam : (Fin 2 → ℝ) → ℝ)
    (jm : Fin 3) : ℕ → E3 → ℂ :=
  fun i x => if i = 0 then g 0 x * (conj (w (projT jm x)) * ephase (-(lam (projT jm x) * x jm)))
    else g i x

/-- The frequencies of the smaller pattern: `λ(x_{≠m})` at `m`, the old `ζ_i` elsewhere. -/
noncomputable def spFreq (ζ : ℕ → E3 → ℝ) (lam : (Fin 2 → ℝ) → ℝ) (m : ℕ) (jm : Fin 3) :
    ℕ → E3 → ℝ :=
  fun i x => if i = m then lam (projT jm x) else ζ i x

theorem maPhase_spFreq_eval {m l k : ℕ} (hml : m ≤ l) (ζ : ℕ → E3 → ℝ)
    (lam : (Fin 2 → ℝ) → ℝ) (jm : Fin 3) (θ : ℕ → ℝ) (P : ℕ → Polynomial ℝ) (x : E3) (t : ℝ) :
    (maPhase m l k (spFreq ζ lam m jm) θ P x).eval t
      = lam (projT jm x) * (P m).eval t + (maPhase (m + 1) l k ζ θ P x).eval t := by
  rw [maPhase_eval, maPhase_eval]
  have hI : Finset.Icc m l = insert m (Finset.Icc (m + 1) l) := by
    ext i; simp only [Finset.mem_Icc, Finset.mem_insert]; omega
  rw [hI, Finset.sum_insert (by simp), add_assoc]
  congr 1
  · simp [spFreq]
  · congr 1
    refine Finset.sum_congr rfl fun i hi => ?_
    simp only [Finset.mem_Icc] at hi
    simp [spFreq, show i ≠ m by omega]

theorem measurable_spIn {g : ℕ → E3 → ℂ} (hg : ∀ i, Measurable (g i)) {w : (Fin 2 → ℝ) → ℂ}
    (hw : Measurable w) {lam : (Fin 2 → ℝ) → ℝ} (hlam : Measurable lam) (jm : Fin 3) (i : ℕ) :
    Measurable (spIn g w lam jm i) := by
  unfold spIn
  by_cases hi : i = 0
  · simp only [hi, ite_true]
    have hp := measurable_projT jm
    have hx : Measurable fun x : E3 => x jm := (EuclideanSpace.proj jm).continuous.measurable
    exact (hg 0).mul ((Complex.continuous_conj.measurable.comp (hw.comp hp)).mul
      (continuous_ephase.measurable.comp ((hlam.comp hp).mul hx).neg))
  · simp only [hi, ite_false]; exact hg i

theorem norm_spIn_le {g : ℕ → E3 → ℂ} (hg1 : ∀ i x, ‖g i x‖ ≤ 1) {w : (Fin 2 → ℝ) → ℂ}
    (hw1 : ∀ y, ‖w y‖ ≤ 1) (lam : (Fin 2 → ℝ) → ℝ) (jm : Fin 3) (i : ℕ) (x : E3) :
    ‖spIn g w lam jm i x‖ ≤ 1 := by
  unfold spIn
  split_ifs
  · rw [norm_mul, norm_mul, RCLike.norm_conj, norm_ephase, mul_one]
    exact ((mul_le_of_le_one_left (norm_nonneg _) (hg1 0 x)).trans (hw1 _))
  · exact hg1 i x

theorem spIn_eq_zero {g : ℕ → E3 → ℂ} {C N : ℝ} (hgs : ∀ i x, x ∉ petBox C N → g i x = 0)
    (w : (Fin 2 → ℝ) → ℂ) (lam : (Fin 2 → ℝ) → ℝ) (jm : Fin 3) (i : ℕ) {x : E3}
    (hx : x ∉ petBox C N) : spIn g w lam jm i x = 0 := by
  unfold spIn
  split_ifs
  · rw [hgs 0 x hx, zero_mul]
  · exact hgs i x hx

theorem measurable_spFreq {ζ : ℕ → E3 → ℝ} (hζ : ∀ i, Measurable (ζ i))
    {lam : (Fin 2 → ℝ) → ℝ} (hlam : Measurable lam) (m : ℕ) (jm : Fin 3) (i : ℕ) :
    Measurable (spFreq ζ lam m jm i) := by
  unfold spFreq
  by_cases hi : i = m
  · simp only [hi, ite_true]; exact hlam.comp (measurable_projT jm)
  · simp only [hi, ite_false]; exact hζ i

open scoped Classical in
/-- **The smaller pattern, pointwise form**: replacing `g_m` by the conjugated modulation
`conj(c(x_{≠m}) e(λ(x_{≠m}) x_m))` (cut off to the enlarged box) turns the `MA(m+1, l)` correlation
into the `MA(m, l)` correlation of `patch:ma-smaller-pattern`, with the new variable phase
`λ(x_{≠m}) P_m(t)`. -/
theorem phaseCorr_update_eq_sp {N : ℝ} (hN : 1 ≤ N) {δ : ℝ} (hδ0 : 0 < δ) {c : ℕ} (hc : 1 ≤ c)
    {m l k : ℕ} (hm : 1 ≤ m) (hml : m ≤ l) (hlk : l ≤ k) {j : ℕ → Fin 3} {g : ℕ → E3 → ℂ}
    (hgs : ∀ i x, x ∉ petBox (budHi c δ) N → g i x = 0) {P : ℕ → Polynomial ℝ}
    (hadm : ∀ i ∈ Finset.Icc 1 k, AdmissiblePoly c δ N (expo (j i)) (P i)) (ζ : ℕ → E3 → ℝ)
    (θ : ℕ → ℝ) (w : (Fin 2 → ℝ) → ℂ) (lam : (Fin 2 → ℝ) → ℝ) :
    phaseCorr N m (Function.update g m (fun x => if x ∈ petBox (5 * budHi c δ) N then
        conj (w (projT (j m) x) * ephase (lam (projT (j m) x) * x (j m))) else 0)) P
        (maPhase (m + 1) l k ζ θ P) j
      = phaseCorr N (m - 1) (spIn g w lam (j m)) P
          (maPhase m l k (spFreq ζ lam m (j m)) θ P) j := by
  have hN0 : 0 < N := by linarith
  have hu := budHi_pos hδ0 hc
  have hmk : m ∈ Finset.Icc 1 k := Finset.mem_Icc.mpr ⟨hm, le_trans hml hlk⟩
  have hdm : expo (j m) ≤ 3 := Nat.succ_le_of_lt (Fin.is_lt _)
  rw [phaseCorr, phaseCorr]
  refine integral_congr_ae (Eventually.of_forall fun x => ?_)
  beta_reduce
  rw [Function.update_of_ne (by omega : (0 : ℕ) ≠ m)]
  have hsp0 : spIn g w lam (j m) 0 x = g 0 x * (conj (w (projT (j m) x))
      * ephase (-(lam (projT (j m) x) * x (j m)))) := by simp [spIn]
  rw [hsp0]
  by_cases hx : x ∈ petBox (budHi c δ) N
  swap
  · rw [hgs 0 x hx]; simp
  rw [mul_assoc (g 0 x)]
  congr 1
  rw [mul_left_comm _ ((N : ℂ)⁻¹), ← intervalIntegral.integral_const_mul
    (conj (w (projT (j m) x)) * ephase (-(lam (projT (j m) x) * x (j m))))]
  congr 1
  refine intervalIntegral.integral_congr fun t ht => ?_
  rw [Set.uIcc_of_le hN0.le] at ht
  have hP := abs_eval_le_of_admissible hN hdm (hadm m hmk) hc hδ0 ht
  have hbox : x - (P m).eval t • basisVec (j m) ∈ petBox (5 * budHi c δ) N := by
    intro i
    have hi := hx i
    have hNi : 0 ≤ N ^ expo i := pow_nonneg hN0.le _
    by_cases hij : i = j m
    · subst hij
      simp only [PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, basisVec_apply_self, mul_one]
      have := abs_le.mp hP
      constructor <;> nlinarith [hi.1, hi.2]
    · simp only [PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, basisVec_apply_ne hij, mul_zero,
        sub_zero]
      constructor <;> nlinarith [hi.1, hi.2]
  simp only [phaseProd]
  rw [prod_Icc_one_succ_top hm]
  simp only [Function.update_self]
  rw [ite_eq_left hbox, projT_sub_smul, sub_smul_basisVec_apply_self]
  have hL : ∏ i ∈ Finset.Icc 1 (m - 1), Function.update g m (fun x => if x ∈ petBox (5 * budHi c
    δ) N
      then conj (w (projT (j m) x) * ephase (lam (projT (j m) x) * x (j m))) else 0) i
        (x - (P i).eval t • basisVec (j i))
      = ∏ i ∈ Finset.Icc 1 (m - 1), g i (x - (P i).eval t • basisVec (j i)) :=
    Finset.prod_congr rfl fun i hi => by
      rw [Function.update_of_ne (by rw [Finset.mem_Icc] at hi; omega)]
  have hR : ∏ i ∈ Finset.Icc 1 (m - 1), spIn g w lam (j m) i (x - (P i).eval t • basisVec (j i))
      = ∏ i ∈ Finset.Icc 1 (m - 1), g i (x - (P i).eval t • basisVec (j i)) :=
    Finset.prod_congr rfl fun i hi => by
      simp only [spIn, show i ≠ 0 by rw [Finset.mem_Icc] at hi; omega, ite_false]
  rw [hL, hR, expPhase_eq_ephase, expPhase_eq_ephase, maPhase_spFreq_eval hml, ephase_add,
    map_mul, ← ephase_neg]
  have e1 : ephase (-(lam (projT (j m) x) * (x (j m) - (P m).eval t)))
      = ephase (-(lam (projT (j m) x) * x (j m))) * ephase (lam (projT (j m) x) * (P m).eval t) :=
        by
    rw [← ephase_add]; congr 1; ring
  rw [e1]
  ring

open scoped Classical in
/-- **The smaller pattern `patch:ma-smaller-pattern`**: for a measurable frequency `λ` and a
measurable scalar `c` bounded by one on the transverse plane,
`|∫_y c(y) ∫_z F(y, z) e(λ(y) z) dz dy|` is the modulus of the `MA(m, l)` correlation of the inputs
`spIn` with the frequencies `spFreq`. -/
theorem norm_sections_eq_sp {N : ℝ} (hN : 1 ≤ N) {δ : ℝ} (hδ0 : 0 < δ) {c : ℕ} (hc : 1 ≤ c)
    {m l k : ℕ} (hm : 1 ≤ m) (hml : m ≤ l) (hlk : l ≤ k) {j : ℕ → Fin 3} {g : ℕ → E3 → ℂ}
    (hg : ∀ i, Measurable (g i)) (hg1 : ∀ i x, ‖g i x‖ ≤ 1)
    (hgs : ∀ i x, x ∉ petBox (budHi c δ) N → g i x = 0) {P : ℕ → Polynomial ℝ}
    (hadm : ∀ i ∈ Finset.Icc 1 k, AdmissiblePoly c δ N (expo (j i)) (P i)) {ζ : ℕ → E3 → ℝ}
    (hζ : ∀ i, Measurable (ζ i)) (θ : ℕ → ℝ) {w : (Fin 2 → ℝ) → ℂ} (hw : Measurable w)
    (hw1 : ∀ y, ‖w y‖ ≤ 1) {lam : (Fin 2 → ℝ) → ℝ} (hlam : Measurable lam) :
    ‖∫ y, w y * ∫ z, maAdj N m l k g P ζ θ j (embT (j m) y z) * ephase (lam y * z)‖
      = ‖phaseCorr N (m - 1) (spIn g w lam (j m)) P
          (maPhase m l k (spFreq ζ lam m (j m)) θ P) j‖ := by
  have hN0 : 0 < N := by linarith
  have hu := budHi_pos hδ0 hc
  obtain ⟨hFm, hF1, hFs, -, -⟩ := ma_adjoint hN hδ0 hc hm hml hlk hg hg1 hgs hadm hζ θ
  set F := maAdj N m l k g P ζ θ j with hFdef
  set A : E3 → ℂ := fun x => w (projT (j m) x) * ephase (lam (projT (j m) x) * x (j m))
    with hAdef
  have hp := measurable_projT (j m)
  have hxm : Measurable fun x : E3 => x (j m) := (EuclideanSpace.proj (j m)).continuous.measurable
  have hAm : Measurable A :=
    (hw.comp hp).mul (continuous_ephase.measurable.comp ((hlam.comp hp).mul hxm))
  have hA1 : ∀ x, ‖A x‖ ≤ 1 := fun x => by
    rw [hAdef]; simp only; rw [norm_mul, norm_ephase, mul_one]; exact hw1 _
  have hboxfin : volume (petBox (5 * budHi c δ) N) ≠ ⊤ := (isBounded_petBox _ _).measure_lt_top.ne
  have hint : Integrable (fun x => A x * F x) :=
    IntegrableOn.integrable_of_forall_notMem_eq_zero (s := petBox (5 * budHi c δ) N)
      (Measure.integrableOn_of_bounded (M := 1) hboxfin (hAm.mul hFm).aestronglyMeasurable
        (Eventually.of_forall fun x => by
          rw [norm_mul]; exact ((mul_le_of_le_one_left (norm_nonneg _) (hA1 x)).trans (hF1 x))))
      (fun x hx => by rw [hFs x hx, mul_zero])
  have hL : ∫ y, w y * ∫ z, F (embT (j m) y z) * ephase (lam y * z) = ∫ x, A x * F x := by
    rw [integral_embT (j m) hint]
    refine integral_congr_ae (Eventually.of_forall fun y => ?_)
    beta_reduce
    rw [← integral_const_mul]
    refine integral_congr_ae (Eventually.of_forall fun z => ?_)
    simp only [hAdef, projT_embT, embT_apply_self]
    ring
  obtain ⟨h, hhdef⟩ : ∃ h : E3 → ℂ, h = fun x => if x ∈ petBox (5 * budHi c δ) N then
      conj (w (projT (j m) x) * ephase (lam (projT (j m) x) * x (j m))) else 0 := ⟨_, rfl⟩
  have hhm : Measurable h := by
    rw [hhdef]
    exact Measurable.ite (measurableSet_petBox _ _) (Complex.continuous_conj.measurable.comp hAm)
      measurable_const
  have hh1 : ∀ x, ‖h x‖ ≤ 1 := fun x => by
    rw [hhdef]; simp only
    split_ifs
    · rw [RCLike.norm_conj]; exact hA1 x
    · simp
  have hhs : ∀ x, x ∉ petBox (5 * budHi c δ) N → h x = 0 := fun x hx => by
    rw [hhdef]; simp only [ite_eq_right hx]
  have hbox : petBox (budHi c δ) N ⊆ petBox (5 * budHi c δ) N := petBox_mono (by linarith) hN0.le
  have hGm : ∀ i, Measurable (Function.update g m h i) := fun i => by
    by_cases hi : i = m
    · rw [hi, Function.update_self]; exact hhm
    · rw [Function.update_of_ne hi]; exact hg i
  have hG1 : ∀ i x, ‖Function.update g m h i x‖ ≤ 1 := fun i x => by
    by_cases hi : i = m
    · rw [hi, Function.update_self]; exact hh1 x
    · rw [Function.update_of_ne hi]; exact hg1 i x
  have hGs : ∀ i x, x ∉ petBox (5 * budHi c δ) N → Function.update g m h i x = 0 :=
    fun i x hx => by
      by_cases hi : i = m
      · rw [hi, Function.update_self]; exact hhs x hx
      · rw [Function.update_of_ne hi]; exact hgs i x fun h' => hx (hbox h')
  have hP3 : ∀ i ∈ Finset.Icc (m + 1) k, (P i).natDegree ≤ 3 := by
    intro i hi
    rw [(hadm i (by rw [Finset.mem_Icc] at hi ⊢; omega)).natDegree_eq]
    exact Nat.succ_le_of_lt (Fin.is_lt _)
  have hinner := phaseCorr_eq_inner_maAdj hN0 hm hml hlk hGm hG1 hGs hP3 hζ θ j
  have hsp := phaseCorr_update_eq_sp hN hδ0 hc hm hml hlk hgs hadm ζ θ w lam
  rw [← hhdef] at hsp
  rw [maAdj_update hm, Function.update_self, ← hFdef, hsp] at hinner
  have hconj : ∫ y, h y * conj (F y) = conj (∫ x, A x * F x) := by
    rw [← integral_conj]
    refine integral_congr_ae (Eventually.of_forall fun y => ?_)
    beta_reduce
    rw [hhdef]
    simp only
    split_ifs with hy
    · simp only [hAdef, map_mul]
    · rw [hFs y hy]; simp
  rw [hL, hinner, hconj, RCLike.norm_conj]

end

/-! ### `patch:ma-smaller-pattern`: Fourier selection on the popular sections -/

section
open Filter Topology MeasureTheory

/-- A section point at which a box-supported function does not vanish lies over the transverse box,
at a coordinate in the box's range. -/
theorem mem_of_embT_ne_zero {G : E3 → ℂ} {C N : ℝ} (hGs : ∀ x, x ∉ petBox C N → G x = 0)
    (jm : Fin 3) {y : Fin 2 → ℝ} {z : ℝ} (h : G (embT jm y z) ≠ 0) :
    y ∈ transBox jm C N ∧ z ∈ Set.Icc (-(C * N ^ expo jm)) (C * N ^ expo jm) := by
  have hb : embT jm y z + (0 : ℝ) • basisVec jm ∈ petBox C N := by
    rw [zero_smul, add_zero]; by_contra hb; exact h (hGs _ hb)
  have := mem_of_embT_mem_petBox hb
  rw [add_zero] at this
  exact this

/-- A unit scalar turning a complex number into its modulus. -/
noncomputable def unitScalar (b : ℂ) : ℂ := if b = 0 then 0 else conj b / (‖b‖ : ℂ)

theorem unitScalar_mul (b : ℂ) : unitScalar b * b = ((‖b‖ : ℝ) : ℂ) := by
  unfold unitScalar
  split_ifs with h
  · simp [h]
  · have hn : (‖b‖ : ℂ) ≠ 0 := by exact_mod_cast norm_ne_zero_iff.mpr h
    rw [div_mul_eq_mul_div, Complex.conj_mul', div_eq_iff hn]
    ring

theorem norm_unitScalar_le (b : ℂ) : ‖unitScalar b‖ ≤ 1 := by
  unfold unitScalar
  split_ifs with h
  · simp
  · rw [norm_div, RCLike.norm_conj, Complex.norm_real, Real.norm_of_nonneg (norm_nonneg _),
      div_self (norm_ne_zero_iff.mpr h)]

theorem measurable_unitScalar : Measurable unitScalar := by
  unfold unitScalar
  exact Measurable.ite (measurableSet_eq_fun measurable_id measurable_const) measurable_const
    (Complex.continuous_conj.measurable.div (Complex.measurable_ofReal.comp measurable_norm))

set_option maxHeartbeats 1000000 in
-- The selection, the popularity estimate and the budgets share one context.
/-- **`patch:ma-smaller-pattern`, Fourier selection and the smaller pattern.** Assume `MA(m, l)`
for every budget. If the correlation of `MA(m+1, l)` is power-large, then there are a measurable
frequency `λ` and a measurable scalar `c` of modulus at most one on the transverse plane such that
the `MA(m, l)` correlation `patch:ma-smaller-pattern` of `spIn` with the frequencies `spFreq` is
power-large: `patch:u2-fourier-selection` on a popular set of sections, then the smaller pattern. -/
theorem ma_smaller_pattern {k : ℕ} {j : ℕ → Fin 3} {m l : ℕ} (hm : 1 ≤ m) (hml : m ≤ l)
    (hlk : l ≤ k) (hj : ∀ i ∈ Finset.Icc 1 m, i ≠ m → expo (j i) < expo (j m))
    (hMA : MajorArcProperty k j m l) {c : ℕ} (hc : 1 ≤ c) :
    ∃ C : ℕ, 1 ≤ C ∧ ∀ δ N : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ N →
      ∀ (P : ℕ → Polynomial ℝ) (g : ℕ → E3 → ℂ) (ζ : ℕ → E3 → ℝ) (θ : ℕ → ℝ),
        (∀ i ∈ Finset.Icc 1 k, AdmissiblePoly c δ N (expo (j i)) (P i)) →
        (∀ i, Measurable (g i)) → (∀ i y, ‖g i y‖ ≤ 1) →
        (∀ i y, y ∉ petBox (budHi c δ) N → g i y = 0) → (∀ i, Measurable (ζ i)) →
        budLo c δ * N ^ (6 : ℕ) ≤ ‖phaseCorr N m g P (maPhase (m + 1) l k ζ θ P) j‖ →
        ∃ (w : (Fin 2 → ℝ) → ℂ) (lam : (Fin 2 → ℝ) → ℝ), Measurable w ∧ (∀ y, ‖w y‖ ≤ 1) ∧
          Measurable lam ∧ budLo C δ * N ^ (6 : ℕ)
            ≤ ‖phaseCorr N (m - 1) (spIn g w lam (j m)) P
                (maPhase m l k (spFreq ζ lam m (j m)) θ P) j‖ := by
  obtain ⟨C₁, c', C0, hC₁, hcc', hC0, hU⟩ := ma_uniformity hm hml hlk hj hMA hc
  have hc' : 1 ≤ c' := le_trans hc hcc'
  have hden : MonoHigh fun δ => 200 * budHi c δ ^ 2 :=
    (monoHigh_const (by norm_num : (0 : ℝ) < 200)).mul ((monoHigh_budHi hc).pow 2)
  have hB : MonoLow fun δ =>
      budLo C0 δ * Real.sqrt (budLo C0 δ / (200 * budHi c δ ^ 2)) / 4 :=
    ((monoLow_budLo hC0).mul (((monoLow_budLo hC0).div hden).sqrt)).div_const (by norm_num)
  obtain ⟨C, hC, hCb⟩ := hB.exists_budLo
  refine ⟨C, hC, ?_⟩
  intro δ N hδ0 hδ1 hN P g ζ θ hadm hg hg1 hgs hζ hcorr
  have hN0 : 0 < N := by linarith
  set u := budHi c δ with hudef
  have hu1 : 1 ≤ u := one_le_budHi hδ0 hδ1 hc
  have hu0 : 0 < u := by linarith
  obtain ⟨hFm, hF1, hFs, -, -⟩ := ma_adjoint hN hδ0 hc hm hml hlk hg hg1 hgs hadm hζ θ
  have hX := hU δ N hδ0 hδ1 hN P g ζ θ hadm hg hg1 hgs hζ hcorr
  set F := maAdj N m l k g P ζ θ j with hFdef
  set d := expo (j m) with hddef
  have hd6 : d ≤ 6 := by have : d ≤ 3 := Nat.succ_le_of_lt (Fin.is_lt _); omega
  have hNd : 0 < N ^ d := pow_pos hN0 _
  have hNd6 : 0 < N ^ (6 - d) := pow_pos hN0 _
  set H := budHi C₁ δ * N ^ d with hHdef
  have hH0 : 0 < H := mul_pos (budHi_pos hδ0 hC₁) hNd
  have hHN : N ^ d ≤ H := le_mul_of_one_le_left hNd.le (one_le_budHi hδ0 hδ1 hC₁)
  set S := 10 * budHi c' δ * N ^ d with hSdef
  have hS : 0 < S := mul_pos (mul_pos (by norm_num) (budHi_pos hδ0 hc')) hNd
  have hCS : 10 * u * N ^ d ≤ S := by
    have h1 : u ≤ budHi c' δ := budHi_monotone hδ0 hδ1 hc hcc'
    rw [hSdef]; nlinarith
  set b := budLo C0 δ with hbdef
  have hb0 : 0 < b := budLo_pos hδ0 hC0
  -- the sections
  set Fy : (Fin 2 → ℝ) → ℝ → ℂ := fun y z => F (embT (j m) y z) with hFydef
  have hFym : Measurable (Function.uncurry Fy) := by
    have h := hFm.comp (measurable_embT (j m))
    exact h
  have hFy1 : ∀ y z, ‖Fy y z‖ ≤ 1 := fun y z => hF1 _
  have hFys : ∀ y z, z ∉ Set.Icc (-(5 * u * N ^ d)) (-(5 * u * N ^ d) + S) → Fy y z = 0 := by
    intro y z hz
    by_contra h
    obtain ⟨_, h1, h2⟩ := mem_of_embT_ne_zero hFs (j m) h
    exact hz ⟨h1, by linarith⟩
  set A := transBox (j m) (5 * u) N with hAdef
  have hA : MeasurableSet A := measurableSet_transBox _ _ _
  have hAfin : volume A ≠ ⊤ := (volume_transBox_lt_top _ _ _).ne
  have hV : (volume A).toReal = (2 * (5 * u)) ^ 2 * N ^ (6 - d) :=
    volume_transBox (j m) (by positivity) hN0.le
  have hFyA : ∀ y, y ∉ A → ∀ z, Fy y z = 0 := fun y hy z => by
    by_contra h
    exact hy (mem_of_embT_ne_zero hFs (j m) h).1
  have hFyy : ∀ y, Measurable (Fy y) := fun y => by
    have h := hFym.comp (measurable_prodMk_left (x := y))
    exact h
  -- the `U²` powers of the sections
  set Q : (Fin 2 → ℝ) → ℝ := fun y => unifPow1 H S 2 (Fy y) with hQdef
  have hQm : Measurable Q := measurable_unifPow1_param hFym H S 2
  have hQ01 : ∀ y, Q y ∈ Set.Icc 0 1 := fun y =>
    unifPow1_mem_Icc hH0 hS (hFyy y) (hFy1 y) (hFys y) 1
  have hQ0 : ∀ y, y ∉ A → Q y = 0 := fun y hy => by
    have : Fy y = fun _ => (0 : ℂ) := funext (hFyA y hy)
    simp only [hQdef]; rw [this, unifPow1_zero_fun]
  have hQi : Integrable Q :=
    IntegrableOn.integrable_of_forall_notMem_eq_zero (s := A)
      (Measure.integrableOn_of_bounded (M := 1) hAfin hQm.aestronglyMeasurable
        (Eventually.of_forall fun y => by
          rw [Real.norm_of_nonneg (hQ01 y).1]; exact (hQ01 y).2)) hQ0
  have hXQ : b * N ^ (6 - d) ≤ ∫ y, Q y := hX
  -- the popular sections
  set η := b / (200 * u ^ 2) with hηdef
  have hη0 : 0 < η := by positivity
  set Y := {y | η ≤ Q y} with hYdef
  have hY : MeasurableSet Y := measurableSet_le measurable_const hQm
  have hYA : Y ⊆ A := fun y hy => by
    by_contra h
    have : η ≤ Q y := hy
    rw [hQ0 y h] at this
    linarith
  have hYfin : volume Y ≠ ⊤ := ne_top_of_le_ne_top hAfin (measure_mono hYA)
  have hind : ∀ {s : Set (Fin 2 → ℝ)}, MeasurableSet s → volume s ≠ ⊤ →
      Integrable (s.indicator fun _ => (1 : ℝ)) := fun hs hsf =>
    (Measure.integrableOn_of_bounded (M := 1) hsf measurable_const.aestronglyMeasurable
      (Eventually.of_forall fun _ => by simp)).integrable_indicator hs
  have hpt : ∀ y, Q y ≤ η * A.indicator (fun _ => (1 : ℝ)) y + Y.indicator (fun _ => (1 : ℝ)) y :=
    by
    intro y
    by_cases hy : y ∈ Y
    · rw [Set.indicator_of_mem hy, Set.indicator_of_mem (hYA hy)]
      have := (hQ01 y).2; linarith
    · rw [Set.indicator_of_notMem hy]
      have hlt : Q y < η := lt_of_not_ge hy
      by_cases hyA : y ∈ A
      · rw [Set.indicator_of_mem hyA]; linarith
      · rw [Set.indicator_of_notMem hyA, hQ0 y hyA]; simp
  have hvolY : b * N ^ (6 - d) / 2 ≤ (volume Y).toReal := by
    have h1 : ∫ y, Q y ≤ ∫ y, (η * A.indicator (fun _ => (1 : ℝ)) y
        + Y.indicator (fun _ => (1 : ℝ)) y) :=
      integral_mono hQi (((hind hA hAfin).const_mul η).add (hind hY hYfin)) hpt
    rw [integral_add ((hind hA hAfin).const_mul η) (hind hY hYfin), integral_const_mul,
      integral_indicator_const _ hA, integral_indicator_const _ hY, smul_eq_mul, smul_eq_mul,
      mul_one, mul_one, measureReal_def, measureReal_def, hV] at h1
    have h2 : η * ((2 * (5 * u)) ^ 2 * N ^ (6 - d)) = b * N ^ (6 - d) / 2 := by
      rw [hηdef]; field_simp; ring
    linarith
  -- the measurable frequency
  obtain ⟨ξ, hξm, hξ⟩ := exists_measurable_freq_unifPow1 hFym hFy1 hH0 hS hFys hη0
  set lam : (Fin 2 → ℝ) → ℝ := fun y => -ξ y with hlamdef
  have hlamm : Measurable lam := hξm.neg
  set B : (Fin 2 → ℝ) → ℂ := fun y => ∫ z, Fy y z * ephase (lam y * z) with hBdef
  have hBF : ∀ y, B y = 𝓕 (Fy y) (ξ y) := fun y => by
    rw [fourier_eq_integral_ephase]
  have hBm : Measurable B := by
    have hjm : Measurable fun q : (Fin 2 → ℝ) × ℝ => Fy q.1 q.2 * ephase (lam q.1 * q.2) :=
      hFym.mul (continuous_ephase.measurable.comp ((hlamm.comp measurable_fst).mul measurable_snd))
    have h := (hjm.stronglyMeasurable.integral_prod_right' (ν := (volume : Measure ℝ))).measurable
    exact h
  have hB0 : ∀ y, y ∉ A → B y = 0 := fun y hy => by
    simp only [hBdef, hFyA y hy, zero_mul, integral_zero]
  have hBb : ∀ y, ‖B y‖ ≤ S := fun y => by
    have e : B y = ∫ z in Set.Icc (-(5 * u * N ^ d)) (-(5 * u * N ^ d) + S),
        Fy y z * ephase (lam y * z) := by
      rw [setIntegral_eq_integral_of_forall_compl_eq_zero fun z hz => by rw [hFys y z hz, zero_mul]]
    rw [e]
    have h := norm_setIntegral_le_of_norm_le_const (μ := volume)
      (s := Set.Icc (-(5 * u * N ^ d)) (-(5 * u * N ^ d) + S)) (C := 1)
      (f := fun z => Fy y z * ephase (lam y * z)) (by simp [Real.volume_Icc])
      (fun z _ => by rw [norm_mul, norm_ephase, mul_one]; exact hFy1 y z)
    refine h.trans (le_of_eq ?_)
    rw [measureReal_def, Real.volume_Icc, ENNReal.toReal_ofReal (by linarith)]; ring
  have hBi : Integrable fun y => ‖B y‖ :=
    IntegrableOn.integrable_of_forall_notMem_eq_zero (s := A)
      (Measure.integrableOn_of_bounded (M := S) hAfin hBm.norm.aestronglyMeasurable
        (Eventually.of_forall fun y => by rw [norm_norm]; exact hBb y))
      fun y hy => by simp [hB0 y hy]
  -- the unit scalar and the smaller pattern
  set w : (Fin 2 → ℝ) → ℂ := fun y => unitScalar (B y) with hwdef
  have hwm : Measurable w := measurable_unitScalar.comp hBm
  have hw1 : ∀ y, ‖w y‖ ≤ 1 := fun y => norm_unitScalar_le _
  refine ⟨w, lam, hwm, hw1, hlamm, ?_⟩
  have key := norm_sections_eq_sp hN hδ0 hc hm hml hlk hg hg1 hgs hadm hζ θ hwm hw1 hlamm
  have hint_eq : ∫ y, w y * ∫ z, maAdj N m l k g P ζ θ j (embT (j m) y z) * ephase (lam y * z)
      = ((∫ y, ‖B y‖ : ℝ) : ℂ) := by
    rw [← integral_complex_ofReal]
    refine integral_congr_ae (Eventually.of_forall fun y => ?_)
    exact unitScalar_mul (B y)
  rw [← key, hint_eq, Complex.norm_real, Real.norm_of_nonneg (integral_nonneg fun y => norm_nonneg
    _)]
  -- the lower bound
  have hlow : ∀ y, Y.indicator (fun _ => H * Real.sqrt η / 2) y ≤ ‖B y‖ := fun y => by
    by_cases hy : y ∈ Y
    · rw [Set.indicator_of_mem hy, hBF]; exact (hξ y hy).le
    · rw [Set.indicator_of_notMem hy]; exact norm_nonneg _
  have hindY : Integrable (Y.indicator fun _ => H * Real.sqrt η / 2) :=
    (Measure.integrableOn_of_bounded (M := H * Real.sqrt η / 2) hYfin
      measurable_const.aestronglyMeasurable
      (Eventually.of_forall fun _ => by
        rw [Real.norm_of_nonneg (by positivity)])).integrable_indicator hY
  have h1 := integral_mono hindY hBi hlow
  rw [integral_indicator_const _ hY, smul_eq_mul, measureReal_def] at h1
  have hsq : 0 ≤ Real.sqrt η := Real.sqrt_nonneg _
  have h2 : b * N ^ (6 - d) / 2 * (N ^ d * Real.sqrt η / 2)
      ≤ (volume Y).toReal * (H * Real.sqrt η / 2) :=
    mul_le_mul hvolY (by gcongr) (by positivity) ENNReal.toReal_nonneg
  have h3 : b * N ^ (6 - d) / 2 * (N ^ d * Real.sqrt η / 2)
      = b * Real.sqrt (b / (200 * u ^ 2)) / 4 * N ^ (6 : ℕ) := by
    rw [← pow_add_sub_six N hd6, hηdef]; ring
  have h4 := hCb δ hδ0 hδ1
  calc budLo C δ * N ^ (6 : ℕ)
      ≤ b * Real.sqrt (b / (200 * u ^ 2)) / 4 * N ^ (6 : ℕ) :=
        mul_le_mul_of_nonneg_right h4 (by positivity)
    _ ≤ ∫ y, ‖B y‖ := by rw [← h3]; exact h2.trans h1

end

/-! ### `patch:major-arc`: the induction step and the theorem -/

section
open Filter Topology MeasureTheory

/-- Dropping the nonnegative term `N^{d_m} |λ|` of the smaller pattern's frequency size. -/
theorem maSize_succ_le_spFreq {m l k : ℕ} (hml : m ≤ l) (j : ℕ → Fin 3) {N : ℝ} (hN : 0 ≤ N)
    (ζ : ℕ → E3 → ℝ) (lam : (Fin 2 → ℝ) → ℝ) (θ : ℕ → ℝ) (x : E3) :
    maSize (m + 1) l k j N ζ θ x ≤ maSize m l k j N (spFreq ζ lam m (j m)) θ x := by
  unfold maSize
  have hI : Finset.Icc m l = insert m (Finset.Icc (m + 1) l) := by
    ext i; simp only [Finset.mem_Icc, Finset.mem_insert]; omega
  rw [hI, Finset.sum_insert (by simp)]
  have hs : ∑ i ∈ Finset.Icc (m + 1) l, N ^ expo (j i) * |spFreq ζ lam m (j m) i x|
      = ∑ i ∈ Finset.Icc (m + 1) l, N ^ expo (j i) * |ζ i x| :=
    Finset.sum_congr rfl fun i hi => by
      simp only [Finset.mem_Icc] at hi
      simp [spFreq, show i ≠ m by omega]
  rw [hs]
  have : 0 ≤ N ^ expo (j m) * |spFreq ζ lam m (j m) m x| := by positivity
  linarith

/-- The canonical set of the smaller pattern is contained in that of `MA(m+1, l)`. -/
theorem maSet_sp_subset {m l k : ℕ} (hml : m ≤ l) (j : ℕ → Fin 3) (C : ℕ) (δ : ℝ) {N : ℝ}
    (hN : 0 ≤ N) (ζ : ℕ → E3 → ℝ) (lam : (Fin 2 → ℝ) → ℝ) (θ : ℕ → ℝ) :
    maSet m l k j C δ N (spFreq ζ lam m (j m)) θ ⊆ maSet (m + 1) l k j C δ N ζ θ :=
  fun x hx => ⟨hx.1, (maSize_succ_le_spFreq hml j hN ζ lam θ x).trans hx.2⟩

/-- **Theorem `patch:major-arc`, the induction step**: `MA(m, l)` for every budget implies
`MA(m+1, l)` for every budget. The smaller pattern of `patch:ma-smaller-pattern` is an `MA(m, l)`
correlation on all of `ℝ³` (the coordinate `x_m` is passive for it), so the induction hypothesis
applies to it directly; its canonical set lies in that of `MA(m+1, l)`. -/
theorem majorArc_step {k : ℕ} {j : ℕ → Fin 3} {m l : ℕ} (hm : 1 ≤ m) (hml : m ≤ l)
    (hlk : l ≤ k) (hj : ∀ i ∈ Finset.Icc 1 m, i ≠ m → expo (j i) < expo (j m))
    (hMA : MajorArcProperty k j m l) : MajorArcProperty k j (m + 1) l := by
  intro c hc
  obtain ⟨C, hC, hSP⟩ := ma_smaller_pattern hm hml hlk hj hMA hc
  set c₂ := max C c with hc₂def
  have hc₂ : 1 ≤ c₂ := le_trans hc (le_max_right _ _)
  have hcc₂ : c ≤ c₂ := le_max_right _ _
  obtain ⟨C', hc₂C', hMA'⟩ := hMA c₂ hc₂
  refine ⟨C', le_trans hcc₂ hc₂C', ?_⟩
  intro δ N hδ0 hδ1 hN P g ζ θ hadm hg hg1 hgs hζ hcorr
  have hN0 : 0 < N := by linarith
  rw [Nat.add_sub_cancel] at hcorr
  obtain ⟨w, lam, hwm, hw1, hlamm, hlow⟩ := hSP δ N hδ0 hδ1 hN P g ζ θ hadm hg hg1 hgs hζ hcorr
  have hbox : petBox (budHi c δ) N ⊆ petBox (budHi c₂ δ) N :=
    petBox_mono (budHi_monotone hδ0 hδ1 hc hcc₂) hN0.le
  have hlow' : budLo c₂ δ * N ^ (6 : ℕ) ≤ ‖phaseCorr N (m - 1) (spIn g w lam (j m)) P
      (maPhase m l k (spFreq ζ lam m (j m)) θ P) j‖ :=
    le_trans (mul_le_mul_of_nonneg_right (budLo_antitone hδ0 hδ1 hC (le_max_left _ _))
      (by positivity)) hlow
  have hvol := hMA' δ N hδ0 hδ1 hN P (spIn g w lam (j m)) (spFreq ζ lam m (j m)) θ
    (fun i hi => (hadm i hi).mono hδ0 hδ1 hc hcc₂ hN0.le)
    (measurable_spIn hg hwm hlamm (j m)) (norm_spIn_le hg1 hw1 lam (j m))
    (fun i x hx => spIn_eq_zero hgs w lam (j m) i fun h => hx (hbox h))
    (measurable_spFreq hζ hlamm m (j m)) hlow'
  refine hvol.trans (ENNReal.toReal_mono ?_ (measure_mono (maSet_sp_subset hml j C' δ hN0.le ζ lam
    θ)))
  refine ne_top_of_le_ne_top (isBounded_petBox (budHi C' δ) N).measure_lt_top.ne
    (measure_mono fun x hx => hx.1)

/-- **Theorem `patch:major-arc` (real major-arc property).** For an increasing degree list
`d_1 < ⋯ < d_k` in `{1, 2, 3}` and every `1 ≤ m ≤ l ≤ k`, the property `MA(m, l)` holds, with
output budgets depending only on the input budget and the degree list. The induction on `m` is
noncircular: `MA(m, l) ⟹ ConditionalDL(m, l) ⟹ MA(m+1, l)`. -/
theorem majorArc {k : ℕ} {j : ℕ → Fin 3}
    (hjm : ∀ u v, 1 ≤ u → u < v → v ≤ k → expo (j u) < expo (j v)) {l : ℕ} (hl : 1 ≤ l)
    (hlk : l ≤ k) : ∀ m, 1 ≤ m → m ≤ l → MajorArcProperty k j m l := by
  intro m hm
  induction m, hm using Nat.le_induction with
  | base => intro _; exact majorArc_base hjm hl hlk
  | succ m hm ih =>
    intro hml
    refine majorArc_step hm (by omega) hlk (fun i hi him => ?_) (ih (by omega))
    rw [Finset.mem_Icc] at hi
    exact hjm i m hi.1 (lt_of_le_of_ne hi.2 him) (by omega)

end

