/-- A phase polynomial of degree at most three with Borel coefficients evaluates measurably. -/
theorem measurable_eval_phase {p : E3 → Polynomial ℝ} (hp3 : ∀ x, (p x).natDegree ≤ 3)
    (hpc : ∀ k, Measurable fun x => (p x).coeff k) :
    Measurable fun q : E3 × ℝ => (p q.1).eval q.2 := by
  have h : (fun q : E3 × ℝ => (p q.1).eval q.2)
      = fun q => ∑ k ∈ Finset.range 4, (p q.1).coeff k * q.2 ^ k := by
    funext q
    exact Polynomial.eval_eq_sum_range' (by have := hp3 q.1; omega) q.2
  rw [h]
  exact Finset.measurable_sum _ fun k _ =>
    ((hpc k).comp measurable_fst).mul (measurable_snd.pow_const k)

