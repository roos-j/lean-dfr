        Set.Icc (-(C * N ^ expo i) - winWidth H j i) (C * N ^ expo i)) := by
  ext x
  simp only [petBoxWin, Set.mem_ofPred_eq, Set.mem_preimage, Set.mem_pi, Set.mem_univ,
    forall_const, Set.mem_Icc]

