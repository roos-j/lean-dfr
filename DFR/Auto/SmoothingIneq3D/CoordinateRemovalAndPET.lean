  rw [← ENNReal.ofReal_mul (hnn 0),
    ← ENNReal.ofReal_mul (mul_nonneg (hnn 0) (hnn 1))]
  refine ENNReal.ofReal_le_ofReal ?_
  fin_cases j <;>
    simp [winWidth, expo] at hHS ⊢ <;>
    nlinarith [hHS, hC, hN, hH,
      mul_nonneg (sub_nonneg.mpr hHS) (by positivity : (0 : ℝ) ≤ C ^ 2 * N ^ 5),
