  have hRHS : (∫ a : ℝ, ((fejer L a : ℝ) : ℂ) * locUnifPowMixed N Lv j (fdiff (basisVec j) a f))
      = ((N ^ (6 : ℕ))⁻¹ : ℂ) * ∫ a : ℝ, ((fejer L a : ℝ) : ℂ)
