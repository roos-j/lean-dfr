/-- **The widened box has volume `|B_N| (1 + H/S)`**, and in particular at most `2 |B_N|` once
`H` is at most the `j`-th side length `S = 2 C N^{d_j}`. -/
theorem volume_petBoxWin_le {C N H : ℝ} (hC : 0 ≤ C) (hN : 0 ≤ N) (hH : 0 ≤ H) (j : Fin 3)
    (hHS : H ≤ 2 * (C * N ^ expo j)) :
    volume (petBoxWin C N H j) ≤ ENNReal.ofReal (16 * C ^ 3 * N ^ 6) := by
  have hnn : ∀ i : Fin 3, (0 : ℝ) ≤ 2 * (C * N ^ expo i) + winWidth H j i := fun i =>
    add_nonneg (by positivity) (winWidth_nonneg hH j i)
  have hm : MeasurableSet (Set.univ.pi fun i : Fin 3 =>
      Set.Icc (-(C * N ^ expo i) - winWidth H j i) (C * N ^ expo i)) :=
    MeasurableSet.univ_pi fun _ => measurableSet_Icc
  rw [petBoxWin_eq_preimage,
    (PiLp.volume_preserving_ofLp (Fin 3)).measure_preimage hm.nullMeasurableSet, volume_pi_pi]
  have hfac : ∀ i : Fin 3,
      volume (Set.Icc (-(C * N ^ expo i) - winWidth H j i) (C * N ^ expo i))
        = ENNReal.ofReal (2 * (C * N ^ expo i) + winWidth H j i) := by
    intro i
    rw [Real.volume_Icc]
    congr 1
    ring
