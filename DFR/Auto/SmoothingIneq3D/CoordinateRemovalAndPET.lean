/-- The window average inherits the bound of its input. -/
theorem norm_winAvg_le {H : ℝ} (hH : 0 < H) (v : E3) {f : E3 → ℂ} {M : ℝ}
    (hM : ∀ y, ‖f y‖ ≤ M) (x : E3) : ‖winAvg H v f x‖ ≤ M := by
