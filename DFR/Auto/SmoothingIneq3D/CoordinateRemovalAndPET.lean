open MeasureTheory in
/-- Splitting both cube variables at their last coordinate. -/
theorem integral_cubeProdSel_snoc_aux1 {B : Type*} [MeasurableSpace B] {ν : Measure B}
    [IsProbabilityMeasure ν] {r : ℕ} {w : (Fin (r + 1) → B) → ℂ} (hw : Measurable w)
    (hwb : ∀ x, ‖w x‖ ≤ 1) :
    (∫ c0, (∫ c1, cubeProdSel w c0 c1 ∂(Measure.pi fun _ : Fin (r + 1) => ν))
        ∂(Measure.pi fun _ : Fin (r + 1) => ν))
      = ∫ b0, (∫ β0, (∫ b1, (∫ β1, cubeProdSel w (Fin.snoc b0 β0) (Fin.snoc b1 β1) ∂ν)
            ∂(Measure.pi fun _ : Fin r => ν)) ∂ν) ∂(Measure.pi fun _ : Fin r => ν) := by
  have hcb : ∀ c0 c1 : Fin (r + 1) → B, ‖cubeProdSel w c0 c1‖ ≤ 1 := fun c0 c1 =>
    norm_cubeProdSel_le hwb c0 c1
  have hm1 : Measurable fun c0 : Fin (r + 1) → B =>
      ∫ c1, cubeProdSel w c0 c1 ∂(Measure.pi fun _ : Fin (r + 1) => ν) :=
    ((measurable_cubeProdSel hw).stronglyMeasurable.integral_prod_right'
      (ν := Measure.pi fun _ : Fin (r + 1) => ν)).measurable
  rw [integral_pi_snoc ν
    (f := fun c0 => ∫ c1, cubeProdSel w c0 c1 ∂(Measure.pi fun _ : Fin (r + 1) => ν))
    hm1 (C := 1) fun c0 => norm_integral_le_one fun c1 => hcb _ _]
  refine integral_congr_ae (Filter.Eventually.of_forall fun b0 => ?_)
  change (∫ β0, (∫ c1, cubeProdSel w (Fin.snoc b0 β0) c1
        ∂(Measure.pi fun _ : Fin (r + 1) => ν)) ∂ν)
      = ∫ β0, (∫ b1, (∫ β1, cubeProdSel w (Fin.snoc b0 β0) (Fin.snoc b1 β1) ∂ν)
        ∂(Measure.pi fun _ : Fin r => ν)) ∂ν
  refine integral_congr_ae (Filter.Eventually.of_forall fun β0 => ?_)
  change (∫ c1, cubeProdSel w (Fin.snoc b0 β0) c1 ∂(Measure.pi fun _ : Fin (r + 1) => ν))
      = ∫ b1, (∫ β1, cubeProdSel w (Fin.snoc b0 β0) (Fin.snoc b1 β1) ∂ν)
        ∂(Measure.pi fun _ : Fin r => ν)
  exact integral_pi_snoc ν (f := fun c1 => cubeProdSel w (Fin.snoc b0 β0) c1)
    (measurable_cubeProdSel_right hw (Fin.snoc b0 β0)) (C := 1) fun c1 => hcb _ _

open MeasureTheory in
/-- Moving the two peeled coordinates past the second cube variable and pairing them. -/
theorem integral_cubeProdSel_snoc_aux2 {B : Type*} [MeasurableSpace B] {ν : Measure B}
    [IsProbabilityMeasure ν] {r : ℕ} {w : (Fin (r + 1) → B) → ℂ} (hw : Measurable w)
    (hwb : ∀ x, ‖w x‖ ≤ 1) :
    (∫ b0, (∫ β0, (∫ b1, (∫ β1, cubeProdSel w (Fin.snoc b0 β0) (Fin.snoc b1 β1) ∂ν)
          ∂(Measure.pi fun _ : Fin r => ν)) ∂ν) ∂(Measure.pi fun _ : Fin r => ν))
      = ∫ b0, (∫ b1, (∫ p : B × B, cubeProdSel w (Fin.snoc b0 p.1) (Fin.snoc b1 p.2)
            ∂(ν.prod ν)) ∂(Measure.pi fun _ : Fin r => ν))
          ∂(Measure.pi fun _ : Fin r => ν) := by
  have hcb : ∀ c0 c1 : Fin (r + 1) → B, ‖cubeProdSel w c0 c1‖ ≤ 1 := fun c0 c1 =>
    norm_cubeProdSel_le hwb c0 c1
  refine integral_congr_ae (Filter.Eventually.of_forall fun b0 => ?_)
  change (∫ β0, (∫ b1, (∫ β1, cubeProdSel w (Fin.snoc b0 β0) (Fin.snoc b1 β1) ∂ν)
          ∂(Measure.pi fun _ : Fin r => ν)) ∂ν)
      = ∫ b1, (∫ p : B × B, cubeProdSel w (Fin.snoc b0 p.1) (Fin.snoc b1 p.2) ∂(ν.prod ν))
          ∂(Measure.pi fun _ : Fin r => ν)
  rw [integral_swap_of_bdd
    (f := fun (β0 : B) (b1 : Fin r → B) =>
      ∫ β1, cubeProdSel w (Fin.snoc b0 β0) (Fin.snoc b1 β1) ∂ν)
    (((measurable_cubeProdSel_snocPair_fixFst hw b0).stronglyMeasurable.integral_prod_right'
      (ν := ν)).measurable) (C := 1)
    fun β0 b1 => norm_integral_le_one fun β1 => hcb _ _]
  refine integral_congr_ae (Filter.Eventually.of_forall fun b1 => ?_)
  change (∫ β0, (∫ β1, cubeProdSel w (Fin.snoc b0 β0) (Fin.snoc b1 β1) ∂ν) ∂ν)
      = ∫ p : B × B, cubeProdSel w (Fin.snoc b0 p.1) (Fin.snoc b1 p.2) ∂(ν.prod ν)
  exact (integral_prod_of_bdd
    (f := fun (β0 β1 : B) => cubeProdSel w (Fin.snoc b0 β0) (Fin.snoc b1 β1))
    (measurable_cubeProdSel_snocPair_fixBoth hw b0 b1) (C := 1) fun β0 β1 => hcb _ _).symm

open MeasureTheory in
/-- Pairing the two surviving cube variables and moving the peeled pair outside. -/
theorem integral_cubeProdSel_snoc_aux3 {B : Type*} [MeasurableSpace B] {ν : Measure B}
    [IsProbabilityMeasure ν] {r : ℕ} {w : (Fin (r + 1) → B) → ℂ} (hw : Measurable w)
    (hwb : ∀ x, ‖w x‖ ≤ 1) :
    (∫ b0, (∫ b1, (∫ p : B × B, cubeProdSel w (Fin.snoc b0 p.1) (Fin.snoc b1 p.2)
          ∂(ν.prod ν)) ∂(Measure.pi fun _ : Fin r => ν))
        ∂(Measure.pi fun _ : Fin r => ν))
      = ∫ p : B × B, (∫ q : (Fin r → B) × (Fin r → B),
            cubeProdSel w (Fin.snoc q.1 p.1) (Fin.snoc q.2 p.2)
            ∂((Measure.pi fun _ : Fin r => ν).prod (Measure.pi fun _ : Fin r => ν)))
          ∂(ν.prod ν) := by
  have hcb : ∀ c0 c1 : Fin (r + 1) → B, ‖cubeProdSel w c0 c1‖ ≤ 1 := fun c0 c1 =>
    norm_cubeProdSel_le hwb c0 c1
  have g5 := measurable_cubeProdSel_snocPair hw
  have g5m : Measurable fun t : (Fin r → B) × (Fin r → B) =>
      ∫ p : B × B, cubeProdSel w (Fin.snoc t.1 p.1) (Fin.snoc t.2 p.2) ∂(ν.prod ν) :=
    (g5.stronglyMeasurable.integral_prod_right' (ν := ν.prod ν)).measurable
  rw [← integral_prod_of_bdd
    (f := fun (b0 b1 : Fin r → B) =>
      ∫ p : B × B, cubeProdSel w (Fin.snoc b0 p.1) (Fin.snoc b1 p.2) ∂(ν.prod ν))
    g5m (C := 1) fun b0 b1 => norm_integral_le_one fun p => hcb _ _]
  exact integral_swap_of_bdd
    (f := fun (q : (Fin r → B) × (Fin r → B)) (p : B × B) =>
      cubeProdSel w (Fin.snoc q.1 p.1) (Fin.snoc q.2 p.2))
    g5 (C := 1) fun q p => hcb _ _

open MeasureTheory in
/-- **The cube integral one order up, with the doubled coordinate pulled outside.**

Both copies of the cube variable are split at their last coordinate and the resulting pair
`(beta0, beta1)` is moved to the outside, which is where the induction of `patch:cylinder` puts the
coordinate it has just doubled. -/
theorem integral_cubeProdSel_snoc {B : Type*} [MeasurableSpace B] {ν : Measure B}
    [IsProbabilityMeasure ν] {r : ℕ} {w : (Fin (r + 1) → B) → ℂ} (hw : Measurable w)
    (hwb : ∀ x, ‖w x‖ ≤ 1) :
    (∫ c0, (∫ c1, cubeProdSel w c0 c1 ∂(Measure.pi fun _ : Fin (r + 1) => ν))
        ∂(Measure.pi fun _ : Fin (r + 1) => ν))
      = ∫ p : B × B, (∫ q : (Fin r → B) × (Fin r → B),
            cubeProdSel w (Fin.snoc q.1 p.1) (Fin.snoc q.2 p.2)
            ∂((Measure.pi fun _ : Fin r => ν).prod (Measure.pi fun _ : Fin r => ν)))
          ∂(ν.prod ν) :=
  (integral_cubeProdSel_snoc_aux1 hw hwb).trans
    ((integral_cubeProdSel_snoc_aux2 hw hwb).trans (integral_cubeProdSel_snoc_aux3 hw hwb))


open MeasureTheory in
/-- The cube is jointly measurable in the auxiliary parameter and the two cube variables. -/
theorem measurable_cubeProdSel_param {Z B : Type*} [MeasurableSpace Z] [MeasurableSpace B]
    {r : ℕ} {v : Z → (Fin r → B) → ℂ} (hv : Measurable (Function.uncurry v)) :
    Measurable fun t : Z × ((Fin r → B) × (Fin r → B)) => cubeProdSel (v t.1) t.2.1 t.2.2 := by
  refine Finset.measurable_prod _ fun ω _ => ?_
  by_cases hEven : Even (numTrue ω)
  · simp only [conjPar, ite_eq_left hEven]
    exact hv.comp (Measurable.prodMk measurable_fst ((measurable_cubeSel ω).comp measurable_snd))
  · simp only [conjPar, ite_eq_right hEven]
    exact Complex.continuous_conj.measurable.comp
      (hv.comp (Measurable.prodMk measurable_fst ((measurable_cubeSel ω).comp measurable_snd)))

/-- One rung of the tower of squares: `X^2 <= J` and `J^(2^k) <= R` give `X^(2^(k+1)) <= R`.
This is how the induction of `patch:cylinder` converts a single Cauchy-Schwarz step into the
doubling of the exponent. No sign hypothesis on `X` is needed, because the square is what gets
raised to the power. -/
theorem pow_two_pow_step {X J R : ℝ} {k : ℕ} (h1 : X ^ 2 ≤ J) (h2 : J ^ (2 ^ k) ≤ R) :
    X ^ (2 ^ (k + 1)) ≤ R := by
  have hexp : 2 ^ (k + 1) = 2 * 2 ^ k := by ring
  calc X ^ (2 ^ (k + 1)) = (X ^ 2) ^ (2 ^ k) := by rw [hexp, pow_mul]
    _ ≤ J ^ (2 ^ k) := by gcongr
    _ ≤ R := h2

open MeasureTheory in
/-- **The cube of the doubled function, integrated, is the cube one order up, integrated.**

This is the right-hand side half of the induction step of `patch:cylinder`: what the induction
hypothesis delivers for `Auto.cylStep v` over the enlarged auxiliary space is literally the
statement's own right-hand side for `v` one order up. -/
theorem integral_cube_cylStep {Z B : Type*} [MeasurableSpace Z] [MeasurableSpace B]
    {μ : Measure Z} [IsProbabilityMeasure μ] {ν : Measure B} [IsProbabilityMeasure ν]
    {r : ℕ} {v : Z → (Fin (r + 1) → B) → ℂ} (hvm : Measurable (Function.uncurry v))
    (hv : ∀ z b, ‖v z b‖ ≤ 1) :
    (∫ y : Z × B × B, (∫ q : (Fin r → B) × (Fin r → B), cubeProdSel (cylStep v y) q.1 q.2
          ∂((Measure.pi fun _ : Fin r => ν).prod (Measure.pi fun _ : Fin r => ν)))
        ∂(μ.prod (ν.prod ν)))
      = ∫ z, (∫ Q : (Fin (r + 1) → B) × (Fin (r + 1) → B), cubeProdSel (v z) Q.1 Q.2
          ∂((Measure.pi fun _ : Fin (r + 1) => ν).prod (Measure.pi fun _ : Fin (r + 1) => ν)))
        ∂μ := by
  have hvz : ∀ z : Z, Measurable (v z) := fun z =>
    hvm.comp (Measurable.prodMk measurable_const measurable_id)
  have hcylb : ∀ (y : Z × B × B) (b' : Fin r → B), ‖cylStep v y b'‖ ≤ 1 := norm_cylStep_le hv
  have hcubeb : ∀ (y : Z × B × B) (q0 q1 : Fin r → B), ‖cubeProdSel (cylStep v y) q0 q1‖ ≤ 1 :=
    fun y q0 q1 => norm_cubeProdSel_le (hcylb y) q0 q1
  have hOm : Measurable fun y : Z × B × B =>
      ∫ q : (Fin r → B) × (Fin r → B), cubeProdSel (cylStep v y) q.1 q.2
        ∂((Measure.pi fun _ : Fin r => ν).prod (Measure.pi fun _ : Fin r => ν)) :=
    ((measurable_cubeProdSel_param (measurable_cylStep hvm)).stronglyMeasurable.integral_prod_right'
      (ν := (Measure.pi fun _ : Fin r => ν).prod (Measure.pi fun _ : Fin r => ν))).measurable
  have hO : (∫ y : Z × B × B, (∫ q : (Fin r → B) × (Fin r → B), cubeProdSel (cylStep v y) q.1 q.2
          ∂((Measure.pi fun _ : Fin r => ν).prod (Measure.pi fun _ : Fin r => ν)))
        ∂(μ.prod (ν.prod ν)))
      = ∫ z, (∫ p : B × B, (∫ q : (Fin r → B) × (Fin r → B),
              cubeProdSel (cylStep v (z, p)) q.1 q.2
              ∂((Measure.pi fun _ : Fin r => ν).prod (Measure.pi fun _ : Fin r => ν)))
            ∂(ν.prod ν)) ∂μ :=
    integral_prod_of_bdd
      (f := fun (z : Z) (p : B × B) => ∫ q : (Fin r → B) × (Fin r → B),
        cubeProdSel (cylStep v (z, p)) q.1 q.2
        ∂((Measure.pi fun _ : Fin r => ν).prod (Measure.pi fun _ : Fin r => ν)))
      hOm (C := 1) fun z p => norm_integral_le_one fun q => hcubeb _ _ _
  rw [hO]
  refine integral_congr_ae (Filter.Eventually.of_forall fun z => ?_)
  change (∫ p : B × B, (∫ q : (Fin r → B) × (Fin r → B), cubeProdSel (cylStep v (z, p)) q.1 q.2
          ∂((Measure.pi fun _ : Fin r => ν).prod (Measure.pi fun _ : Fin r => ν)))
        ∂(ν.prod ν))
      = ∫ Q : (Fin (r + 1) → B) × (Fin (r + 1) → B), cubeProdSel (v z) Q.1 Q.2
          ∂((Measure.pi fun _ : Fin (r + 1) => ν).prod (Measure.pi fun _ : Fin (r + 1) => ν))
  have hcong : (∫ p : B × B, (∫ q : (Fin r → B) × (Fin r → B),
          cubeProdSel (cylStep v (z, p)) q.1 q.2
          ∂((Measure.pi fun _ : Fin r => ν).prod (Measure.pi fun _ : Fin r => ν)))
        ∂(ν.prod ν))
      = ∫ p : B × B, (∫ q : (Fin r → B) × (Fin r → B),
            cubeProdSel (v z) (Fin.snoc q.1 p.1) (Fin.snoc q.2 p.2)
            ∂((Measure.pi fun _ : Fin r => ν).prod (Measure.pi fun _ : Fin r => ν)))
          ∂(ν.prod ν) := by
    refine integral_congr_ae (Filter.Eventually.of_forall fun p => ?_)
    change (∫ q : (Fin r → B) × (Fin r → B), cubeProdSel (cylStep v (z, p)) q.1 q.2
          ∂((Measure.pi fun _ : Fin r => ν).prod (Measure.pi fun _ : Fin r => ν)))
        = ∫ q : (Fin r → B) × (Fin r → B),
            cubeProdSel (v z) (Fin.snoc q.1 p.1) (Fin.snoc q.2 p.2)
            ∂((Measure.pi fun _ : Fin r => ν).prod (Measure.pi fun _ : Fin r => ν))
    refine integral_congr_ae (Filter.Eventually.of_forall fun q => ?_)
    change cubeProdSel (cylStep v (z, p)) q.1 q.2
        = cubeProdSel (v z) (Fin.snoc q.1 p.1) (Fin.snoc q.2 p.2)
    exact cubeProdSel_cylStep v z p.1 p.2 q.1 q.2
  rw [hcong, ← integral_cubeProdSel_snoc (hvz z) (fun x => hv z x)]
  exact (integral_prod_of_bdd (f := fun c0 c1 => cubeProdSel (v z) c0 c1)
    (measurable_cubeProdSel (hvz z)) (C := 1)
    fun c0 c1 => norm_cubeProdSel_le (fun x => hv z x) c0 c1).symm


open MeasureTheory in
/-- **Cylinder Cauchy-Schwarz with its explicit state** (`patch:cylinder`).

For a `1`-bounded outer factor `U` on an auxiliary probability space and a `1`-bounded jointly
measurable `v` of `r+1` independent coordinates,

`‖E_z U(z) E_b v(z,b)‖^(2^(r+1)) ≤ Re E_z E_{b⁰,b¹} ∏_ω C^{|ω|} v(z, b^ω)`.

The auxiliary space is universally quantified inside the statement, which is what makes the
induction go: each doubling replaces `Z` by `Z x B x B` and `v` by `Auto.cylStep v`, and
`Auto.cubeProdSel_cylStep` identifies the cube of the doubled function with the cube one order up.
The auxiliary space and the coordinate space are kept in the same universe so that `Z x B x B` can
be fed back into the statement. -/
theorem sq_norm_pow_le_integral_cubeProdSel {B : Type u} [MeasurableSpace B] {ν : Measure B}
    [IsProbabilityMeasure ν] :
    ∀ (r : ℕ) {Z : Type u} [MeasurableSpace Z] (μ : Measure Z) [IsProbabilityMeasure μ]
      {U : Z → ℂ} {v : Z → (Fin (r + 1) → B) → ℂ}, Measurable U → (∀ z, ‖U z‖ ≤ 1) →
      Measurable (Function.uncurry v) → (∀ z b, ‖v z b‖ ≤ 1) →
      ‖∫ z, U z * (∫ b, v z b ∂(Measure.pi fun _ : Fin (r + 1) => ν)) ∂μ‖ ^ (2 ^ (r + 1))
        ≤ (∫ z, (∫ Q : (Fin (r + 1) → B) × (Fin (r + 1) → B), cubeProdSel (v z) Q.1 Q.2
              ∂((Measure.pi fun _ : Fin (r + 1) => ν).prod
                (Measure.pi fun _ : Fin (r + 1) => ν))) ∂μ).re := by
  intro r
  induction r with
  | zero =>
      intro Z _ μ _ U v hUm hU hvm hv
      change ‖∫ z, U z * (∫ b, v z b ∂(Measure.pi fun _ : Fin 1 => ν)) ∂μ‖ ^ 2
          ≤ (∫ z, (∫ Q : (Fin 1 → B) × (Fin 1 → B), cubeProdSel (v z) Q.1 Q.2
              ∂((Measure.pi fun _ : Fin 1 => ν).prod (Measure.pi fun _ : Fin 1 => ν))) ∂μ).re
      have hvz : ∀ z : Z, Measurable (v z) := fun z =>
        hvm.comp (Measurable.prodMk measurable_const measurable_id)
      have hΦm : Measurable fun z : Z => ∫ b, v z b ∂(Measure.pi fun _ : Fin 1 => ν) :=
        (hvm.stronglyMeasurable.integral_prod_right'
          (ν := Measure.pi fun _ : Fin 1 => ν)).measurable
      have hΦ : ∀ z : Z, ‖∫ b, v z b ∂(Measure.pi fun _ : Fin 1 => ν)‖ ≤ 1 := fun z =>
        norm_integral_le_one fun b => hv z b
      have hQm : Measurable fun z : Z =>
          ∫ Q : (Fin 1 → B) × (Fin 1 → B), cubeProdSel (v z) Q.1 Q.2
            ∂((Measure.pi fun _ : Fin 1 => ν).prod (Measure.pi fun _ : Fin 1 => ν)) :=
        ((measurable_cubeProdSel_param hvm).stronglyMeasurable.integral_prod_right'
          (ν := (Measure.pi fun _ : Fin 1 => ν).prod
            (Measure.pi fun _ : Fin 1 => ν))).measurable
      have hQb : ∀ z : Z, ‖∫ Q : (Fin 1 → B) × (Fin 1 → B), cubeProdSel (v z) Q.1 Q.2
            ∂((Measure.pi fun _ : Fin 1 => ν).prod (Measure.pi fun _ : Fin 1 => ν))‖ ≤ 1 :=
        fun z => norm_integral_le_one fun Q => norm_cubeProdSel_le (hv z) Q.1 Q.2
      have hcube : ∀ z : Z,
          (∫ b0, (∫ b1, v z b0 * (starRingEnd ℂ) (v z b1) ∂(Measure.pi fun _ : Fin 1 => ν))
              ∂(Measure.pi fun _ : Fin 1 => ν))
            = ∫ Q : (Fin 1 → B) × (Fin 1 → B), cubeProdSel (v z) Q.1 Q.2
                ∂((Measure.pi fun _ : Fin 1 => ν).prod (Measure.pi fun _ : Fin 1 => ν)) := by
        intro z
        rw [integral_prod_of_bdd (f := fun c0 c1 => cubeProdSel (v z) c0 c1)
          (measurable_cubeProdSel (hvz z)) (C := 1)
          fun c0 c1 => norm_cubeProdSel_le (hv z) c0 c1]
        refine integral_congr_ae (Filter.Eventually.of_forall fun b0 => ?_)
        change (∫ b1, v z b0 * (starRingEnd ℂ) (v z b1) ∂(Measure.pi fun _ : Fin 1 => ν))
            = ∫ b1, cubeProdSel (v z) b0 b1 ∂(Measure.pi fun _ : Fin 1 => ν)
        refine integral_congr_ae (Filter.Eventually.of_forall fun b1 => ?_)
        change v z b0 * (starRingEnd ℂ) (v z b1) = cubeProdSel (v z) b0 b1
        exact (cubeProdSel_one (v z) b0 b1).symm
      refine (sq_norm_integral_mul_inner_le hUm hU hΦm hΦ).trans (le_of_eq ?_)
      calc (∫ z, (∫ b0, (∫ b1, v z b0 * (starRingEnd ℂ) (v z b1)
              ∂(Measure.pi fun _ : Fin 1 => ν)) ∂(Measure.pi fun _ : Fin 1 => ν)).re ∂μ)
          = ∫ z, (∫ Q : (Fin 1 → B) × (Fin 1 → B), cubeProdSel (v z) Q.1 Q.2
                ∂((Measure.pi fun _ : Fin 1 => ν).prod
                  (Measure.pi fun _ : Fin 1 => ν))).re ∂μ := by
            refine integral_congr_ae (Filter.Eventually.of_forall fun z => ?_)
            change (∫ b0, (∫ b1, v z b0 * (starRingEnd ℂ) (v z b1)
                  ∂(Measure.pi fun _ : Fin 1 => ν)) ∂(Measure.pi fun _ : Fin 1 => ν)).re
                = (∫ Q : (Fin 1 → B) × (Fin 1 → B), cubeProdSel (v z) Q.1 Q.2
                  ∂((Measure.pi fun _ : Fin 1 => ν).prod
                    (Measure.pi fun _ : Fin 1 => ν))).re
            rw [hcube z]
        _ = _ := integral_re_of_bdd hQm (C := 1) hQb
  | succ r ih =>
      intro Z _ μ _ U v hUm hU hvm hv
      have hsnocm : Measurable fun q : (Z × (Fin (r + 1) → B)) × B =>
          v q.1.1 (Fin.snoc q.1.2 q.2) :=
        hvm.comp (Measurable.prodMk measurable_fst.fst
          (measurable_snoc.comp (Measurable.prodMk measurable_fst.snd measurable_snd)))
      have hU'm : Measurable fun w : Z × (Fin (r + 1) → B) => U w.1 := hUm.comp measurable_fst
      have hΦm : Measurable fun w : Z × (Fin (r + 1) → B) =>
          ∫ β, v w.1 (Fin.snoc w.2 β) ∂ν :=
        (hsnocm.stronglyMeasurable.integral_prod_right' (ν := ν)).measurable
      have hΦ : ∀ w : Z × (Fin (r + 1) → B), ‖∫ β, v w.1 (Fin.snoc w.2 β) ∂ν‖ ≤ 1 := fun w =>
        norm_integral_le_one fun β => hv _ _
      have hCS := sq_norm_integral_mul_inner_le
        (μ := μ.prod (Measure.pi fun _ : Fin (r + 1) => ν)) (ν := ν)
        (U := fun w : Z × (Fin (r + 1) → B) => U w.1) hU'm (fun w => hU w.1)
        (v := fun (w : Z × (Fin (r + 1) → B)) (β : B) => v w.1 (Fin.snoc w.2 β)) hΦm hΦ
      have hEq := integral_re_doubled_eq_cylStep (μ := μ) (ν := ν) (r := r + 1) hvm hv
      have hNonneg := integral_re_doubled_nonneg
        (μ := μ.prod (Measure.pi fun _ : Fin (r + 1) => ν)) (ν := ν)
        (fun (w : Z × (Fin (r + 1) → B)) (β : B) => v w.1 (Fin.snoc w.2 β))
      have hIH := ih (Z := Z × B × B) (μ.prod (ν.prod ν)) (U := fun _ => (1 : ℂ))
        (v := cylStep v) measurable_const (fun _ => by norm_num)
        (measurable_cylStep hvm) (norm_cylStep_le hv)
      simp only [one_mul] at hIH
      rw [integral_mul_pi_snoc hUm hU hvm hv]
      refine pow_two_pow_step (k := r + 1) (hCS.trans (le_of_eq hEq)) ?_
      refine le_trans ?_ (le_trans hIH (le_of_eq (congrArg Complex.re
        (integral_cube_cylStep (r := r + 1) hvm hv))))
      refine pow_le_pow_left₀ ?_ (Complex.re_le_norm _) _
      rw [← hEq]
      exact hNonneg


/-- The doubled function of a product is the product of the doubled functions. This is what lets
the family `u_i` of `patch:cylinder` be carried through a doubling step one factor at a time. -/
theorem cylStep_mul {Z B : Type*} {r : ℕ} (f g : Z → (Fin (r + 1) → B) → ℂ)
    (y : Z × B × B) (b : Fin r → B) :
    cylStep (fun z x => f z x * g z x) y b = cylStep f y b * cylStep g y b := by
  simp only [cylStep, map_mul]
  ring

/-- **Independence of a coordinate is inherited by the doubled function.** If `f` does not depend
on the coordinate `j.castSucc`, then `Auto.cylStep f` does not depend on the coordinate `j` of the
shortened tuple, which is the hypothesis the next round of the induction needs. -/
theorem cylStep_indep {Z B : Type*} {r : ℕ} {f : Z → (Fin (r + 1) → B) → ℂ} {j : Fin r}
    (hf : ∀ z b β, f z (Function.update b j.castSucc β) = f z b)
    (y : Z × B × B) (b : Fin r → B) (β : B) :
    cylStep f y (Function.update b j β) = cylStep f y b := by
  simp only [cylStep, Fin.snoc_update, hf]

open MeasureTheory in
/-- **A factor independent of the last coordinate is its own average over it.**

This is how the removed block of one step of `patch:cylinder` is exhibited as a function of the
outer variable alone, without having to choose a point of the coordinate space. -/
theorem eq_integral_of_indep_last {Z B : Type*} [MeasurableSpace B] {ν : Measure B}
    [IsProbabilityMeasure ν] {n : ℕ} {f : Z → (Fin (n + 1) → B) → ℂ}
    (hf : ∀ z b β, f z (Function.update b (Fin.last n) β) = f z b)
    (z : Z) (b' : Fin n → B) (β : B) :
    f z (Fin.snoc b' β) = ∫ γ, f z (Fin.snoc b' γ) ∂ν := by
  have hconst : ∀ γ : B, f z (Fin.snoc b' γ) = f z (Fin.snoc b' β) := by
    intro γ
    have h1 : (Fin.snoc b' γ : Fin (n + 1) → B)
        = Function.update (Fin.snoc b' β) (Fin.last n) γ := by
      rw [Fin.update_snoc_last]
    rw [h1, hf]
  rw [integral_congr_ae (Filter.Eventually.of_forall hconst), integral_const]
  simp


/-- **Doubling distributes over the whole family.** The doubled function of `v * prod u_i` is
`cylStep v` times the product of the `cylStep u_i`, which is precisely the shape the next round of
the induction of `patch:cylinder` consumes. -/
theorem cylStep_prod {Z B : Type*} {r m : ℕ} (f : Z → (Fin (r + 1) → B) → ℂ)
    (h : Fin m → Z → (Fin (r + 1) → B) → ℂ) (y : Z × B × B) (b : Fin r → B) :
    cylStep (fun z x => f z x * ∏ j, h j z x) y b
      = cylStep f y b * ∏ j, cylStep (h j) y b := by
  simp only [cylStep, map_mul, map_prod, Finset.prod_mul_distrib]
  ring

open MeasureTheory in
/-- **One step of the induction, with the removed block carried.**

The factor `p` is independent of the last coordinate, so it comes out of the average over that
coordinate as a function of the outer variable `(z, b')`; `Auto.eq_integral_of_indep_last` exhibits
it as its own average, which avoids having to choose a point of `B`. The result is exactly the
shape `Auto.sq_norm_integral_mul_inner_le` consumes. -/
theorem integral_mul_indep_pi_snoc {Z B : Type*} [MeasurableSpace Z] [MeasurableSpace B]
    {μ : Measure Z} [IsProbabilityMeasure μ] {ν : Measure B} [IsProbabilityMeasure ν]
    {n : ℕ} {g : Z → (Fin (n + 1) → B) → ℂ} (hgm : Measurable (Function.uncurry g))
    (hg : ∀ z b, ‖g z b‖ ≤ 1)
    {p : Z → (Fin (n + 1) → B) → ℂ} (hpm : Measurable (Function.uncurry p))
    (hp : ∀ z b, ‖p z b‖ ≤ 1)
    (hpi : ∀ z b β, p z (Function.update b (Fin.last n) β) = p z b) :
    (∫ z, (∫ b, g z b * p z b ∂(Measure.pi fun _ : Fin (n + 1) => ν)) ∂μ)
      = ∫ w : Z × (Fin n → B),
          (∫ γ, p w.1 (Fin.snoc w.2 γ) ∂ν) * (∫ β, g w.1 (Fin.snoc w.2 β) ∂ν)
          ∂(μ.prod (Measure.pi fun _ : Fin n => ν)) := by
  have hgz : ∀ z : Z, Measurable (g z) := fun z =>
    hgm.comp (Measurable.prodMk measurable_const measurable_id)
  have hpz : ∀ z : Z, Measurable (p z) := fun z =>
    hpm.comp (Measurable.prodMk measurable_const measurable_id)
  have hgsnoc : Measurable fun q : (Z × (Fin n → B)) × B => g q.1.1 (Fin.snoc q.1.2 q.2) :=
    hgm.comp (Measurable.prodMk measurable_fst.fst
      (measurable_snoc.comp (Measurable.prodMk measurable_fst.snd measurable_snd)))
  have hpsnoc : Measurable fun q : (Z × (Fin n → B)) × B => p q.1.1 (Fin.snoc q.1.2 q.2) :=
    hpm.comp (Measurable.prodMk measurable_fst.fst
      (measurable_snoc.comp (Measurable.prodMk measurable_fst.snd measurable_snd)))
  have hGm : Measurable fun w : Z × (Fin n → B) => ∫ β, g w.1 (Fin.snoc w.2 β) ∂ν :=
    (hgsnoc.stronglyMeasurable.integral_prod_right' (ν := ν)).measurable
  have hPm : Measurable fun w : Z × (Fin n → B) => ∫ γ, p w.1 (Fin.snoc w.2 γ) ∂ν :=
    (hpsnoc.stronglyMeasurable.integral_prod_right' (ν := ν)).measurable
  have hGb : ∀ w : Z × (Fin n → B), ‖∫ β, g w.1 (Fin.snoc w.2 β) ∂ν‖ ≤ 1 := fun w =>
    norm_integral_le_one fun β => hg _ _
  have hPb : ∀ w : Z × (Fin n → B), ‖∫ γ, p w.1 (Fin.snoc w.2 γ) ∂ν‖ ≤ 1 := fun w =>
    norm_integral_le_one fun γ => hp _ _
  have hfin : (∫ w : Z × (Fin n → B),
        (∫ γ, p w.1 (Fin.snoc w.2 γ) ∂ν) * (∫ β, g w.1 (Fin.snoc w.2 β) ∂ν)
        ∂(μ.prod (Measure.pi fun _ : Fin n => ν)))
      = ∫ z, (∫ b', (∫ γ, p z (Fin.snoc b' γ) ∂ν) * (∫ β, g z (Fin.snoc b' β) ∂ν)
          ∂(Measure.pi fun _ : Fin n => ν)) ∂μ :=
    integral_prod_of_bdd
      (f := fun (z : Z) (b' : Fin n → B) =>
        (∫ γ, p z (Fin.snoc b' γ) ∂ν) * (∫ β, g z (Fin.snoc b' β) ∂ν))
      (hPm.mul hGm) (C := 1) (fun z b' => by
        rw [norm_mul]
        calc ‖∫ γ, p z (Fin.snoc b' γ) ∂ν‖ * ‖∫ β, g z (Fin.snoc b' β) ∂ν‖ ≤ 1 * 1 :=
              mul_le_mul (hPb (z, b')) (hGb (z, b')) (norm_nonneg _) zero_le_one
          _ = 1 := one_mul 1)
  rw [hfin]
  refine integral_congr_ae (Filter.Eventually.of_forall fun z => ?_)
  change (∫ b, g z b * p z b ∂(Measure.pi fun _ : Fin (n + 1) => ν))
      = ∫ b', (∫ γ, p z (Fin.snoc b' γ) ∂ν) * (∫ β, g z (Fin.snoc b' β) ∂ν)
          ∂(Measure.pi fun _ : Fin n => ν)
  rw [integral_pi_snoc ν (f := fun b => g z b * p z b) ((hgz z).mul (hpz z)) (C := 1)
    (fun b => by
      rw [norm_mul]
      calc ‖g z b‖ * ‖p z b‖ ≤ 1 * 1 := mul_le_mul (hg z b) (hp z b) (norm_nonneg _) zero_le_one
        _ = 1 := one_mul 1)]
  refine integral_congr_ae (Filter.Eventually.of_forall fun b' => ?_)
  change (∫ β, g z (Fin.snoc b' β) * p z (Fin.snoc b' β) ∂ν)
      = (∫ γ, p z (Fin.snoc b' γ) ∂ν) * (∫ β, g z (Fin.snoc b' β) ∂ν)
  have hrep : ∀ β : B, g z (Fin.snoc b' β) * p z (Fin.snoc b' β)
      = (∫ γ, p z (Fin.snoc b' γ) ∂ν) * g z (Fin.snoc b' β) := by
    intro β
    rw [← eq_integral_of_indep_last (ν := ν) hpi z b' β]
    ring
  rw [integral_congr_ae (Filter.Eventually.of_forall hrep), integral_const_mul]


open MeasureTheory in
/-- **Cylinder Cauchy-Schwarz with its explicit state** (`patch:cylinder`), in full: with the
family `u_i`, each `1`-bounded and independent of its own coordinate `b_i`, carried inside the
average.

`‖E_z E_b v(z,b) ∏_i u_i(z,b)‖^(2^(r+1)) ≤ Re E_z E_{b⁰,b¹} ∏_ω C^{|ω|} v(z, b^ω)`.

The proof is the blueprint's: at each step the removed block is `u_last`, which is independent of
the only coordinate being doubled, so it plays the role of the outer factor of
`Auto.sq_norm_integral_mul_inner_le`; `Auto.eq_integral_of_indep_last` exhibits it as a function of
the outer variable without choosing a point of `B`; `Auto.cylStep_prod` shows the doubled function
is again of the same shape, and `Auto.cylStep_indep` that the surviving factors keep their
independence. The base case is `Auto.sq_norm_pow_le_integral_cubeProdSel`, because for one
coordinate a `u_0` independent of `b_0` is exactly an outer factor. -/
theorem sq_norm_pow_le_integral_cubeProdSel_prod {B : Type u} [MeasurableSpace B] {ν : Measure B}
    [IsProbabilityMeasure ν] :
    ∀ (r : ℕ) {Z : Type u} [MeasurableSpace Z] (μ : Measure Z) [IsProbabilityMeasure μ]
      {v : Z → (Fin (r + 1) → B) → ℂ} {u : Fin (r + 1) → Z → (Fin (r + 1) → B) → ℂ},
      Measurable (Function.uncurry v) → (∀ z b, ‖v z b‖ ≤ 1) →
      (∀ i, Measurable (Function.uncurry (u i))) → (∀ i z b, ‖u i z b‖ ≤ 1) →
      (∀ i z b β, u i z (Function.update b i β) = u i z b) →
      ‖∫ z, (∫ b, v z b * ∏ i, u i z b ∂(Measure.pi fun _ : Fin (r + 1) => ν)) ∂μ‖ ^ (2 ^ (r + 1))
        ≤ (∫ z, (∫ Q : (Fin (r + 1) → B) × (Fin (r + 1) → B), cubeProdSel (v z) Q.1 Q.2
              ∂((Measure.pi fun _ : Fin (r + 1) => ν).prod
                (Measure.pi fun _ : Fin (r + 1) => ν))) ∂μ).re := by
  intro r
  induction r with
  | zero =>
      intro Z _ μ _ v u hvm hv hum hu hindep
      have hone : ∀ (z : Z) (b : Fin (0 + 1) → B), (∏ i, u i z b) = u 0 z b := by
        intro z b
        simp
      have hconst : ∀ (z : Z) (b b' : Fin (0 + 1) → B), u 0 z b' = u 0 z b := by
        intro z b b'
        have h1 : b' = Function.update b 0 (b' 0) := by
          funext i
          have hi : i = 0 := by
            refine Fin.ext ?_
            have := i.isLt
            omega
          subst hi
          simp
        rw [h1, hindep]
      have hUeq : ∀ (z : Z) (b : Fin (0 + 1) → B),
          u 0 z b = ∫ c, u 0 z c ∂(Measure.pi fun _ : Fin (0 + 1) => ν) := by
        intro z b
        have h2 : (∫ c, u 0 z c ∂(Measure.pi fun _ : Fin (0 + 1) => ν)) = u 0 z b := by
          rw [integral_congr_ae (Filter.Eventually.of_forall fun c => hconst z b c),
            integral_const]
          simp
        exact h2.symm
      have hUm : Measurable fun z : Z => ∫ c, u 0 z c ∂(Measure.pi fun _ : Fin (0 + 1) => ν) :=
        ((hum 0).stronglyMeasurable.integral_prod_right'
          (ν := Measure.pi fun _ : Fin (0 + 1) => ν)).measurable
      have hUb : ∀ z : Z, ‖∫ c, u 0 z c ∂(Measure.pi fun _ : Fin (0 + 1) => ν)‖ ≤ 1 := fun z =>
        norm_integral_le_one fun c => hu 0 z c
      have hstep : ∀ z : Z,
          (∫ b, v z b * ∏ i, u i z b ∂(Measure.pi fun _ : Fin (0 + 1) => ν))
            = (∫ c, u 0 z c ∂(Measure.pi fun _ : Fin (0 + 1) => ν))
              * ∫ b, v z b ∂(Measure.pi fun _ : Fin (0 + 1) => ν) := by
        intro z
        rw [← integral_const_mul]
        refine integral_congr_ae (Filter.Eventually.of_forall fun b => ?_)
        change v z b * (∏ i, u i z b)
            = (∫ c, u 0 z c ∂(Measure.pi fun _ : Fin (0 + 1) => ν)) * v z b
        rw [hone z b, hUeq z b]
        ring
      have hcongr : (∫ z, (∫ b, v z b * ∏ i, u i z b
            ∂(Measure.pi fun _ : Fin (0 + 1) => ν)) ∂μ)
          = ∫ z, (∫ c, u 0 z c ∂(Measure.pi fun _ : Fin (0 + 1) => ν))
              * (∫ b, v z b ∂(Measure.pi fun _ : Fin (0 + 1) => ν)) ∂μ :=
        integral_congr_ae (Filter.Eventually.of_forall hstep)
      rw [hcongr]
      exact sq_norm_pow_le_integral_cubeProdSel 0 μ hUm hUb hvm hv
  | succ r ih =>
      intro Z _ μ _ v u hvm hv hum hu hindep
      have hgm : Measurable (Function.uncurry fun (z : Z) (b : Fin (r + 1 + 1) → B) =>
          v z b * ∏ j : Fin (r + 1), u j.castSucc z b) :=
        hvm.mul (Finset.measurable_prod _ fun j _ => hum j.castSucc)
      have hgb : ∀ (z : Z) (b : Fin (r + 1 + 1) → B),
          ‖v z b * ∏ j : Fin (r + 1), u j.castSucc z b‖ ≤ 1 := by
        intro z b
        rw [norm_mul, norm_prod]
        have h1 : (∏ j : Fin (r + 1), ‖u j.castSucc z b‖) ≤ 1 :=
          Finset.prod_le_one₀ (fun j _ => norm_nonneg _) fun j _ => hu _ _ _
        calc ‖v z b‖ * ∏ j : Fin (r + 1), ‖u j.castSucc z b‖ ≤ 1 * 1 :=
              mul_le_mul (hv z b) h1 (Finset.prod_nonneg fun j _ => norm_nonneg _) zero_le_one
          _ = 1 := one_mul 1
      have hre1 : (∫ z, (∫ b, v z b * ∏ i, u i z b
            ∂(Measure.pi fun _ : Fin (r + 1 + 1) => ν)) ∂μ)
          = ∫ z, (∫ b, (v z b * ∏ j : Fin (r + 1), u j.castSucc z b)
              * u (Fin.last (r + 1)) z b ∂(Measure.pi fun _ : Fin (r + 1 + 1) => ν)) ∂μ := by
        refine integral_congr_ae (Filter.Eventually.of_forall fun z => ?_)
        change (∫ b, v z b * ∏ i, u i z b ∂(Measure.pi fun _ : Fin (r + 1 + 1) => ν))
            = ∫ b, (v z b * ∏ j : Fin (r + 1), u j.castSucc z b)
              * u (Fin.last (r + 1)) z b ∂(Measure.pi fun _ : Fin (r + 1 + 1) => ν)
        refine integral_congr_ae (Filter.Eventually.of_forall fun b => ?_)
        change v z b * (∏ i, u i z b)
            = (v z b * ∏ j : Fin (r + 1), u j.castSucc z b) * u (Fin.last (r + 1)) z b
        rw [Fin.prod_univ_castSucc]
        ring
      have hre2 : (∫ z, (∫ b, (v z b * ∏ j : Fin (r + 1), u j.castSucc z b)
            * u (Fin.last (r + 1)) z b ∂(Measure.pi fun _ : Fin (r + 1 + 1) => ν)) ∂μ)
          = ∫ w : Z × (Fin (r + 1) → B),
              (∫ γ, u (Fin.last (r + 1)) w.1 (Fin.snoc w.2 γ) ∂ν)
                * (∫ β, (v w.1 (Fin.snoc w.2 β)
                    * ∏ j : Fin (r + 1), u j.castSucc w.1 (Fin.snoc w.2 β)) ∂ν)
              ∂(μ.prod (Measure.pi fun _ : Fin (r + 1) => ν)) :=
        integral_mul_indep_pi_snoc (μ := μ) (ν := ν)
          (g := fun (z : Z) (b : Fin (r + 1 + 1) → B) =>
            v z b * ∏ j : Fin (r + 1), u j.castSucc z b) hgm hgb
          (p := u (Fin.last (r + 1))) (hum _) (fun z b => hu _ z b)
          (hindep (Fin.last (r + 1)))
      have hgsnocm : Measurable fun q : (Z × (Fin (r + 1) → B)) × B =>
          v q.1.1 (Fin.snoc q.1.2 q.2)
            * ∏ j : Fin (r + 1), u j.castSucc q.1.1 (Fin.snoc q.1.2 q.2) :=
        hgm.comp (Measurable.prodMk measurable_fst.fst
          (measurable_snoc.comp (Measurable.prodMk measurable_fst.snd measurable_snd)))
      have hpsnocm : Measurable fun q : (Z × (Fin (r + 1) → B)) × B =>
          u (Fin.last (r + 1)) q.1.1 (Fin.snoc q.1.2 q.2) :=
        (hum _).comp (Measurable.prodMk measurable_fst.fst
          (measurable_snoc.comp (Measurable.prodMk measurable_fst.snd measurable_snd)))
      have hΦm : Measurable fun w : Z × (Fin (r + 1) → B) =>
          ∫ β, (v w.1 (Fin.snoc w.2 β)
            * ∏ j : Fin (r + 1), u j.castSucc w.1 (Fin.snoc w.2 β)) ∂ν :=
        (hgsnocm.stronglyMeasurable.integral_prod_right' (ν := ν)).measurable
      have hΦ : ∀ w : Z × (Fin (r + 1) → B),
          ‖∫ β, (v w.1 (Fin.snoc w.2 β)
            * ∏ j : Fin (r + 1), u j.castSucc w.1 (Fin.snoc w.2 β)) ∂ν‖ ≤ 1 := fun w =>
        norm_integral_le_one fun β => hgb _ _
      have hUm2 : Measurable fun w : Z × (Fin (r + 1) → B) =>
          ∫ γ, u (Fin.last (r + 1)) w.1 (Fin.snoc w.2 γ) ∂ν :=
        (hpsnocm.stronglyMeasurable.integral_prod_right' (ν := ν)).measurable
      have hUb2 : ∀ w : Z × (Fin (r + 1) → B),
          ‖∫ γ, u (Fin.last (r + 1)) w.1 (Fin.snoc w.2 γ) ∂ν‖ ≤ 1 := fun w =>
        norm_integral_le_one fun γ => hu _ _ _
      have hCS := sq_norm_integral_mul_inner_le
        (μ := μ.prod (Measure.pi fun _ : Fin (r + 1) => ν)) (ν := ν)
        (U := fun w : Z × (Fin (r + 1) → B) =>
          ∫ γ, u (Fin.last (r + 1)) w.1 (Fin.snoc w.2 γ) ∂ν) hUm2 hUb2
        (v := fun (w : Z × (Fin (r + 1) → B)) (β : B) =>
          v w.1 (Fin.snoc w.2 β) * ∏ j : Fin (r + 1), u j.castSucc w.1 (Fin.snoc w.2 β))
        hΦm hΦ
      have hEq := integral_re_doubled_eq_cylStep (μ := μ) (ν := ν) (r := r + 1)
        (v := fun (z : Z) (b : Fin (r + 1 + 1) → B) =>
          v z b * ∏ j : Fin (r + 1), u j.castSucc z b) hgm hgb
      have hNonneg := integral_re_doubled_nonneg
        (μ := μ.prod (Measure.pi fun _ : Fin (r + 1) => ν)) (ν := ν)
        (fun (w : Z × (Fin (r + 1) → B)) (β : B) =>
          v w.1 (Fin.snoc w.2 β) * ∏ j : Fin (r + 1), u j.castSucc w.1 (Fin.snoc w.2 β))
      have hIH := ih (Z := Z × B × B) (μ.prod (ν.prod ν))
        (v := cylStep v) (u := fun j => cylStep (u j.castSucc))
        (measurable_cylStep hvm) (norm_cylStep_le hv)
        (fun j => measurable_cylStep (hum j.castSucc))
        (fun j y b => norm_cylStep_le (hu j.castSucc) y b)
        (fun j y b β => cylStep_indep (hindep j.castSucc) y b β)
      have hW : (∫ y : Z × B × B, (∫ b',
            cylStep (fun (z : Z) (b : Fin (r + 1 + 1) → B) =>
              v z b * ∏ j : Fin (r + 1), u j.castSucc z b) y b'
            ∂(Measure.pi fun _ : Fin (r + 1) => ν)) ∂(μ.prod (ν.prod ν)))
          = ∫ y : Z × B × B, (∫ b',
              cylStep v y b' * ∏ j : Fin (r + 1), cylStep (u j.castSucc) y b'
              ∂(Measure.pi fun _ : Fin (r + 1) => ν)) ∂(μ.prod (ν.prod ν)) := by
        refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
        change (∫ b', cylStep (fun (z : Z) (b : Fin (r + 1 + 1) → B) =>
              v z b * ∏ j : Fin (r + 1), u j.castSucc z b) y b'
            ∂(Measure.pi fun _ : Fin (r + 1) => ν))
            = ∫ b', cylStep v y b' * ∏ j : Fin (r + 1), cylStep (u j.castSucc) y b'
              ∂(Measure.pi fun _ : Fin (r + 1) => ν)
        refine integral_congr_ae (Filter.Eventually.of_forall fun b' => ?_)
        exact cylStep_prod v (fun j => u j.castSucc) y b'
      rw [hre1, hre2]
      refine pow_two_pow_step (k := r + 1) (hCS.trans (le_of_eq hEq)) ?_
      refine le_trans (pow_le_pow_left₀ ?_ (Complex.re_le_norm _) _) ?_
      · rw [← hEq]
        exact hNonneg
      · rw [hW]
        exact le_trans hIH (le_of_eq (congrArg Complex.re
          (integral_cube_cylStep (r := r + 1) hvm hv)))


open MeasureTheory in
/-- **The right-hand side of `patch:cylinder` is nonnegative**, which the patch asserts alongside
the inequality. It is the inequality itself applied with the trivial outer factor: the cube
average dominates a power of a modulus. -/
theorem integral_cubeProdSel_re_nonneg {B : Type u} [MeasurableSpace B] {ν : Measure B}
    [IsProbabilityMeasure ν] (r : ℕ) {Z : Type u} [MeasurableSpace Z] (μ : Measure Z)
    [IsProbabilityMeasure μ] {v : Z → (Fin (r + 1) → B) → ℂ}
    (hvm : Measurable (Function.uncurry v)) (hv : ∀ z b, ‖v z b‖ ≤ 1) :
    0 ≤ (∫ z, (∫ Q : (Fin (r + 1) → B) × (Fin (r + 1) → B), cubeProdSel (v z) Q.1 Q.2
          ∂((Measure.pi fun _ : Fin (r + 1) => ν).prod
            (Measure.pi fun _ : Fin (r + 1) => ν))) ∂μ).re :=
  le_trans (pow_nonneg (norm_nonneg _) _)
    (sq_norm_pow_le_integral_cubeProdSel r μ (U := fun _ => (1 : ℂ)) measurable_const
      (fun _ => by norm_num) hvm hv)


open MeasureTheory in
/-- **The spatially integrated correlation of `patch:signed-vdc`.**

`corrLine mu F t h = ∫ F(x, t+h) conj(F(x,t)) dx`. The patch bounds exactly this by `V`, using
Cauchy-Schwarz in `x` from `∫ |F(x,s)|^2 dx <= V`, and its cut-off replacement moves the `t`-range
between `I` and `I ∩ (I - h)`. -/
noncomputable def corrLine {α : Type*} [MeasurableSpace α] (μ : Measure α) (F : α → ℝ → ℂ)
    (t h : ℝ) : ℂ := ∫ x, F x (t + h) * (starRingEnd ℂ) (F x t) ∂μ

open MeasureTheory in
/-- The correlation is measurable in the parameter. -/
theorem measurable_corrLine {α : Type*} [MeasurableSpace α] {μ : Measure α} [SFinite μ]
    {F : α → ℝ → ℂ} (hFm : Measurable (Function.uncurry F)) (h : ℝ) :
    Measurable fun t : ℝ => corrLine μ F t h := by
  have h1 : Measurable fun p : ℝ × α => F p.2 (p.1 + h) :=
    hFm.comp (Measurable.prodMk measurable_snd (measurable_fst.add_const h))
  have h2 : Measurable fun p : ℝ × α => F p.2 p.1 :=
    hFm.comp (Measurable.prodMk measurable_snd measurable_fst)
  have hj : Measurable fun p : ℝ × α => F p.2 (p.1 + h) * (starRingEnd ℂ) (F p.2 p.1) :=
    h1.mul (Complex.continuous_conj.measurable.comp h2)
  exact (hj.stronglyMeasurable.integral_prod_right' (ν := μ)).measurable

open MeasureTheory in
/-- **The patch's Cauchy-Schwarz bound on the correlation.** From `∫ |F(x,s)|^2 dx <= V` at the
two relevant parameter values, `‖corrLine mu F t h‖ <= V`. This is
`Auto.norm_integral_mul_conj_le_of_sq_le` in the shape `patch:signed-vdc` uses it. -/
theorem norm_corrLine_le {α : Type*} [MeasurableSpace α] {μ : Measure α} {F : α → ℝ → ℂ}
    (hsq : ∀ s : ℝ, Integrable (fun x => ‖F x s‖ ^ 2) μ)
    (hcross : ∀ s s' : ℝ, Integrable (fun x => ‖F x s‖ * ‖F x s'‖) μ)
    {V : ℝ} (hV : 0 ≤ V) (hFV : ∀ s : ℝ, (∫ x, ‖F x s‖ ^ 2 ∂μ) ≤ V) (t h : ℝ) :
    ‖corrLine μ F t h‖ ≤ V :=
  norm_integral_mul_conj_le_of_sq_le (hsq (t + h)) (hsq t) (hcross (t + h) t) hV
    (hFV (t + h)) (hFV t)

open MeasureTheory in
/-- **The cut-off cost of `patch:signed-vdc`, before normalization.**

Replacing the parameter range `I ∩ (I - h)` by `I` in the spatially integrated correlation costs at
most `V |h|`, because the symmetric difference has length at most `|h|` and the integrand is
bounded by `V`. Divided by `V N`, this is the patch's `|h|/N`. -/
theorem norm_corrIntegral_sub_capCorr_le {α : Type*} [MeasurableSpace α] {μ : Measure α}
    [SFinite μ] {F : α → ℝ → ℂ} (hFm : Measurable (Function.uncurry F))
    (hsq : ∀ s : ℝ, Integrable (fun x => ‖F x s‖ ^ 2) μ)
    (hcross : ∀ s s' : ℝ, Integrable (fun x => ‖F x s‖ * ‖F x s'‖) μ)
    {V : ℝ} (hV : 0 ≤ V) (hFV : ∀ s : ℝ, (∫ x, ‖F x s‖ ^ 2 ∂μ) ≤ V)
    {N : ℝ} (hN : 0 ≤ N) (c h : ℝ) :
    ‖(∫ t in c..(c + N), corrLine μ F t h)
        - ∫ t in capSet c N h, corrLine μ F t h‖ ≤ V * |h| := by
  have hgm : Measurable fun t : ℝ => corrLine μ F t h := measurable_corrLine hFm h
  have hgb : ∀ t : ℝ, ‖corrLine μ F t h‖ ≤ V := fun t =>
    norm_corrLine_le hsq hcross hV hFV t h
  have hgi : ∀ p q : ℝ, IntervalIntegrable (fun t : ℝ => corrLine μ F t h) volume p q :=
    fun p q => intervalIntegrable_of_bdd' hgm hgb p q
  rcases le_or_gt |h| N with hcase | hcase
  · have hcap : (∫ t in capSet c N h, corrLine μ F t h)
        = ∫ t in capLeft c h..capRight c N h, corrLine μ F t h := by
      rw [capSet_eq_Ioc, intervalIntegral.integral_of_le (capLeft_le_capRight hcase c)]
    rw [hcap]
    refine le_trans (norm_integral_sub_integral_le' hgi hgb c (c + N)
      (capLeft c h) (capRight c N h)) ?_
    rw [capLeft, capRight]
    have e1 : |c - (c + max 0 (-h))| = max 0 (-h) := by
      rw [show c - (c + max 0 (-h)) = -max 0 (-h) by ring, abs_neg,
        abs_of_nonneg (le_max_left _ _)]
    have e2 : |c + N - (c + N - max 0 h)| = max 0 h := by
      rw [show c + N - (c + N - max 0 h) = max 0 h by ring, abs_of_nonneg (le_max_left _ _)]
    rw [e1, e2, add_comm]
    exact le_of_eq (by rw [max_zero_add_max_zero_neg h])
  · have hlt : capRight c N h < capLeft c h := by
      rw [capLeft, capRight]
      have hsum := max_zero_add_max_zero_neg h
      linarith
    have hempty : (∫ t in capSet c N h, corrLine μ F t h) = 0 := by
      rw [capSet_eq_Ioc, Set.Ioc_eq_empty (not_lt.mpr hlt.le), setIntegral_empty]
    rw [hempty, sub_zero]
    have hb := intervalIntegral.norm_integral_le_of_norm_le_const (C := V) (a := c) (b := c + N)
      (f := fun t : ℝ => corrLine μ F t h) fun t _ => hgb t
    have hNle : N ≤ |h| := hcase.le
    calc ‖∫ t in c..(c + N), corrLine μ F t h‖ ≤ V * |c + N - c| := hb
      _ = V * N := by rw [show c + N - c = N by ring, abs_of_nonneg hN]
      _ ≤ V * |h| := mul_le_mul_of_nonneg_left hNle hV


open MeasureTheory in
/-- The real part commutes with the integral of an integrable complex function. The companion of
`Auto.integral_re_of_bdd` for the places where integrability, not boundedness, is what is
available. -/
theorem integral_re_of_integrable {X : Type*} [MeasurableSpace X] {μ : Measure X} {f : X → ℂ}
    (hf : Integrable f μ) : (∫ x, (f x).re ∂μ) = (∫ x, f x ∂μ).re := by
  simpa using Complex.reCLM.integral_comp_comm hf

open MeasureTheory in
/-- The correlation is jointly measurable in the shift and the parameter. -/
theorem measurable_corrLine_pair {α : Type*} [MeasurableSpace α] {μ : Measure α} [SFinite μ]
    {F : α → ℝ → ℂ} (hFm : Measurable (Function.uncurry F)) :
    Measurable fun p : ℝ × ℝ => corrLine μ F p.2 p.1 := by
  have h1 : Measurable fun q : (ℝ × ℝ) × α => F q.2 (q.1.2 + q.1.1) :=
    hFm.comp (Measurable.prodMk measurable_snd (measurable_fst.snd.add measurable_fst.fst))
  have h2 : Measurable fun q : (ℝ × ℝ) × α => F q.2 q.1.2 :=
    hFm.comp (Measurable.prodMk measurable_snd measurable_fst.snd)
  have hj : Measurable fun q : (ℝ × ℝ) × α =>
      F q.2 (q.1.2 + q.1.1) * (starRingEnd ℂ) (F q.2 q.1.2) :=
    h1.mul (Complex.continuous_conj.measurable.comp h2)
  exact (hj.stronglyMeasurable.integral_prod_right' (ν := μ)).measurable

open MeasureTheory in
/-- The correlation integrated over the fixed parameter interval is measurable in the shift. -/
theorem measurable_barCorrInt {α : Type*} [MeasurableSpace α] {μ : Measure α} [SFinite μ]
    {F : α → ℝ → ℂ} (hFm : Measurable (Function.uncurry F)) {N : ℝ} (hN : 0 ≤ N) (c : ℝ) :
    Measurable fun h : ℝ => ∫ t in c..(c + N), corrLine μ F t h := by
  have hc : c ≤ c + N := by linarith
  have h1 : Measurable fun h : ℝ => ∫ t in Set.Ioc c (c + N), corrLine μ F t h :=
    measurable_varSetIntegral (g := fun h t => corrLine μ F t h) (measurable_corrLine_pair hFm)
      measurable_const measurable_const
  simp_rw [intervalIntegral.integral_of_le hc]
  exact h1

open MeasureTheory in
/-- The correlation integrated over the moving intersection is measurable in the shift. -/
theorem measurable_capCorrInt {α : Type*} [MeasurableSpace α] {μ : Measure α} [SFinite μ]
    {F : α → ℝ → ℂ} (hFm : Measurable (Function.uncurry F)) (c N : ℝ) :
    Measurable fun h : ℝ => ∫ t in capSet c N h, corrLine μ F t h := by
  have hu : Measurable fun h : ℝ => capLeft c h := by
    simp only [capLeft]
    exact (continuous_const.add (continuous_const.max continuous_neg)).measurable
  have hv : Measurable fun h : ℝ => capRight c N h := by
    simp only [capRight]
    exact (continuous_const.sub (continuous_const.max continuous_id')).measurable
  simp only [capSet_eq_Ioc]
  exact measurable_varSetIntegral (g := fun h t => corrLine μ F t h)
    (measurable_corrLine_pair hFm) hu hv

open MeasureTheory in
/-- **The spatial variable past the parameter variable**, the first of the two Fubini exchanges
`patch:signed-vdc` needs. The integrability is taken as an explicit hypothesis, in the house style
of `Auto.integral_sq_norm_le_fejer_autocorr`: the patch supplies it "in applications, by bounded
factors and their finite-support envelopes". -/
theorem integral_capPair_eq_setIntegral_corrLine {α : Type*} [MeasurableSpace α] {μ : Measure α}
    [SFinite μ] {F : α → ℝ → ℂ} {c N h : ℝ}
    (hint : Integrable
      (Function.uncurry fun (x : α) (t : ℝ) => F x (t + h) * (starRingEnd ℂ) (F x t))
      (μ.prod (volume.restrict (capSet c N h)))) :
    (∫ x, capPair (F x) c N h ∂μ) = ∫ t in capSet c N h, corrLine μ F t h :=
  integral_integral_swap hint

open MeasureTheory in
/-- **The spatial variable past the Fejer variable**, the second exchange. Again the integrability
is an explicit hypothesis. -/
theorem integral_fejer_autocorr_swap {α : Type*} [MeasurableSpace α] {μ : Measure α} [SFinite μ]
    {W : α → ℝ → ℂ} {H : ℝ}
    (hint : Integrable
      (Function.uncurry fun (x : α) (h : ℝ) => fejer H h • autocorr (W x) h) (μ.prod volume)) :
    (∫ x, (∫ h : ℝ, fejer H h • autocorr (W x) h) ∂μ)
      = ∫ h : ℝ, fejer H h • (∫ x, autocorr (W x) h ∂μ) := by
  rw [integral_integral_swap hint]
  refine integral_congr_ae (Filter.Eventually.of_forall fun h => ?_)
  change (∫ x, fejer H h • autocorr (W x) h ∂μ) = fejer H h • ∫ x, autocorr (W x) h ∂μ
  exact integral_smul _ _


open MeasureTheory in
/-- **`patch:signed-vdc`, first half: the removal and the window, with the normalizations in
place.**

`|A|^2 <= 2 V^{-1} N^{-1} Re ∫_x ∫_h kappa_H(h) A_{W_x}(h)`, where `A = V^{-1} ∫ g(x) E_{t in I}
F(x,t) dx` and `W_x` is `F(x, .)` cut off to `I`. This is `Auto.sq_norm_normalized_pairing_le`
followed by `Auto.integral_sq_norm_le_fejer_autocorr`, with the `N^{-2}` of the two averages pulled
out and `(N + H)/N <= 2` used, which is where `H <= N/4` enters. The averaged correlation is
nonnegative because the left-hand side of the window inequality is an integrated square; that is
what lets `(N + H)/N` be relaxed to `2`. -/
theorem sq_norm_signed_vdc_mid {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {c N H V : ℝ} (hN : 0 < N) (hH : 0 < H) (hHN : H ≤ N / 4) (hV : 0 < V)
    {g : α → ℂ} {F : α → ℝ → ℂ}
    (hFm : Measurable (Function.uncurry F)) {M : ℝ} (hM : 0 ≤ M) (hFb : ∀ x t, ‖F x t‖ ≤ M)
    (hg2 : Integrable (fun x => ‖g x‖ ^ 2) μ) (hgV : (∫ x, ‖g x‖ ^ 2 ∂μ) ≤ V)
    (hΦ2 : Integrable (fun x => ‖(N⁻¹ : ℝ) • ∫ t in c..(c + N), F x t‖ ^ 2) μ)
    (hgΦ : Integrable (fun x => ‖g x‖ * ‖(N⁻¹ : ℝ) • ∫ t in c..(c + N), F x t‖) μ)
    (hLi : Integrable (fun x => ‖∫ u : ℝ, (Set.Ioc c (c + N)).indicator (F x) u‖ ^ 2) μ)
    (hRi : Integrable (fun x =>
      (∫ h : ℝ, fejer H h • autocorr ((Set.Ioc c (c + N)).indicator (F x)) h).re) μ) :
    ‖(V⁻¹ : ℝ) • ∫ x, g x * ((N⁻¹ : ℝ) • ∫ t in c..(c + N), F x t) ∂μ‖ ^ 2
      ≤ 2 * (V⁻¹ * N⁻¹ * ∫ x,
          (∫ h : ℝ, fejer H h • autocorr ((Set.Ioc c (c + N)).indicator (F x)) h).re ∂μ) := by
  have hcN : c ≤ c + N := by linarith
  have hFx : ∀ x, Measurable (F x) := fun x =>
    hFm.comp (Measurable.prodMk measurable_const measurable_id)
  have hWm : ∀ x, Measurable ((Set.Ioc c (c + N)).indicator (F x)) := fun x =>
    (hFx x).indicator measurableSet_Ioc
  have hWb : ∀ (x : α) (t : ℝ), ‖(Set.Ioc c (c + N)).indicator (F x) t‖ ≤ M := by
    intro x t
    by_cases ht : t ∈ Set.Ioc c (c + N)
    · rw [Set.indicator_of_mem ht]
      exact hFb x t
    · rw [Set.indicator_of_notMem ht, norm_zero]
      exact hM
  have hsupp : ∀ (x : α) (t : ℝ), t ∉ Set.Ioc c (c + N) →
      (Set.Ioc c (c + N)).indicator (F x) t = 0 := fun x t ht => Set.indicator_of_notMem ht _
  have hIW : ∀ x, (∫ t in c..(c + N), F x t)
      = ∫ u : ℝ, (Set.Ioc c (c + N)).indicator (F x) u := by
    intro x
    rw [integral_indicator measurableSet_Ioc, intervalIntegral.integral_of_le hcN]
  have hnormsq : ∀ x, ‖(N⁻¹ : ℝ) • ∫ t in c..(c + N), F x t‖ ^ 2
      = N⁻¹ ^ 2 * ‖∫ u : ℝ, (Set.Ioc c (c + N)).indicator (F x) u‖ ^ 2 := by
    intro x
    rw [hIW x, norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hN), mul_pow]
  set L : ℝ := ∫ x, ‖∫ u : ℝ, (Set.Ioc c (c + N)).indicator (F x) u‖ ^ 2 ∂μ with hLdef
  set R : ℝ := ∫ x,
    (∫ h : ℝ, fejer H h • autocorr ((Set.Ioc c (c + N)).indicator (F x)) h).re ∂μ with hRdef
  have h3 : L ≤ (N + H) * R :=
    integral_sq_norm_le_fejer_autocorr hN hH hWm hWb hsupp hLi hRi
  have hL0 : 0 ≤ L := by
    rw [hLdef]
    exact integral_nonneg fun x => by positivity
  have hR0 : 0 ≤ R := by
    by_contra hcon
    have hlt : R < 0 := not_le.mp hcon
    have hNH : 0 < N + H := by linarith
    have hneg : (N + H) * R < 0 := mul_neg_of_pos_of_neg hNH hlt
    linarith
  have h2 : (∫ x, ‖(N⁻¹ : ℝ) • ∫ t in c..(c + N), F x t‖ ^ 2 ∂μ) = N⁻¹ ^ 2 * L := by
    rw [hLdef, ← integral_const_mul]
    exact integral_congr_ae (Filter.Eventually.of_forall hnormsq)
  have hstep1 : ‖(V⁻¹ : ℝ) • ∫ x, g x * ((N⁻¹ : ℝ) • ∫ t in c..(c + N), F x t) ∂μ‖ ^ 2
      ≤ V⁻¹ * ∫ x, ‖(N⁻¹ : ℝ) • ∫ t in c..(c + N), F x t‖ ^ 2 ∂μ :=
    sq_norm_normalized_pairing_le hg2 hΦ2 hgΦ hV hgV
  have hVN : 0 ≤ V⁻¹ * N⁻¹ ^ 2 := by positivity
  have hnn : 0 ≤ V⁻¹ * N⁻¹ * R := by positivity
  have hle : (N + H) * N⁻¹ ≤ 2 := by
    rw [← div_eq_mul_inv, div_le_iff₀ hN]
    linarith
  calc ‖(V⁻¹ : ℝ) • ∫ x, g x * ((N⁻¹ : ℝ) • ∫ t in c..(c + N), F x t) ∂μ‖ ^ 2
      ≤ V⁻¹ * ∫ x, ‖(N⁻¹ : ℝ) • ∫ t in c..(c + N), F x t‖ ^ 2 ∂μ := hstep1
    _ = V⁻¹ * (N⁻¹ ^ 2 * L) := by rw [h2]
    _ ≤ V⁻¹ * (N⁻¹ ^ 2 * ((N + H) * R)) := by nlinarith [h3, hVN]
    _ = (V⁻¹ * N⁻¹ * R) * ((N + H) * N⁻¹) := by ring
    _ ≤ (V⁻¹ * N⁻¹ * R) * 2 := mul_le_mul_of_nonneg_left hle hnn
    _ = 2 * (V⁻¹ * N⁻¹ * R) := by ring


open MeasureTheory in
/-- **The Fejer-averaged cut-off cost of `patch:signed-vdc`.**

Moving the parameter range from `I ∩ (I - h)` to `I` inside the Fejer average costs at most `V H`:
pointwise the cost is `V |h|` by `Auto.norm_corrIntegral_sub_capCorr_le`, and
`Auto.integral_fejer_abs_le` averages `|h|` against the kernel to at most `H`. Divided by `V N`
this is the patch's `H/N`. -/
theorem norm_integral_fejer_capCorr_sub_le {α : Type*} [MeasurableSpace α] {μ : Measure α}
    [SFinite μ] {c N H V : ℝ} (hN : 0 < N) (hH : 0 < H) (hV : 0 ≤ V)
    {F : α → ℝ → ℂ} (hFm : Measurable (Function.uncurry F))
    (hsq : ∀ s : ℝ, Integrable (fun x => ‖F x s‖ ^ 2) μ)
    (hcross : ∀ s s' : ℝ, Integrable (fun x => ‖F x s‖ * ‖F x s'‖) μ)
    (hFV : ∀ s : ℝ, (∫ x, ‖F x s‖ ^ 2 ∂μ) ≤ V) :
    ‖(∫ h : ℝ, fejer H h • ∫ t in capSet c N h, corrLine μ F t h)
        - ∫ h : ℝ, fejer H h • ∫ t in c..(c + N), corrLine μ F t h‖ ≤ V * H := by
  have hgb : ∀ t h : ℝ, ‖corrLine μ F t h‖ ≤ V := fun t h =>
    norm_corrLine_le hsq hcross hV hFV t h
  have hbarm : Measurable fun h : ℝ => ∫ t in c..(c + N), corrLine μ F t h :=
    measurable_barCorrInt hFm hN.le c
  have hcapm : Measurable fun h : ℝ => ∫ t in capSet c N h, corrLine μ F t h :=
    measurable_capCorrInt hFm c N
  have hbarb : ∀ h : ℝ, ‖∫ t in c..(c + N), corrLine μ F t h‖ ≤ V * N := by
    intro h
    have hb := intervalIntegral.norm_integral_le_of_norm_le_const (C := V) (a := c) (b := c + N)
      (f := fun t : ℝ => corrLine μ F t h) fun t _ => hgb t h
    calc ‖∫ t in c..(c + N), corrLine μ F t h‖ ≤ V * |c + N - c| := hb
      _ = V * N := by rw [show c + N - c = N by ring, abs_of_nonneg hN.le]
  have hdiff : ∀ h : ℝ, ‖(∫ t in c..(c + N), corrLine μ F t h)
      - ∫ t in capSet c N h, corrLine μ F t h‖ ≤ V * |h| := fun h =>
    norm_corrIntegral_sub_capCorr_le hFm hsq hcross hV hFV hN.le c h
  have hcapb : ∀ h : ℝ, ‖∫ t in capSet c N h, corrLine μ F t h‖ ≤ V * N + V * |h| := by
    intro h
    have h1 : (∫ t in capSet c N h, corrLine μ F t h)
        = (∫ t in c..(c + N), corrLine μ F t h)
          - ((∫ t in c..(c + N), corrLine μ F t h)
            - ∫ t in capSet c N h, corrLine μ F t h) := by ring
    rw [h1]
    exact le_trans (norm_sub_le _ _) (add_le_add (hbarb h) (hdiff h))
  have hfm : Measurable (fejer H) := (continuous_fejer (H := H)).measurable
  have hint_bar : Integrable fun h : ℝ => fejer H h • ∫ t in c..(c + N), corrLine μ F t h := by
    refine Integrable.mono' ((integrable_fejer hH).mul_const (V * N))
      ((hfm.smul hbarm).aestronglyMeasurable) (Filter.Eventually.of_forall fun h => ?_)
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (fejer_nonneg hH h)]
    exact mul_le_mul_of_nonneg_left (hbarb h) (fejer_nonneg hH h)
  have hint_cap : Integrable fun h : ℝ => fejer H h • ∫ t in capSet c N h, corrLine μ F t h := by
    refine Integrable.mono' (((integrable_fejer hH).mul_const (V * N)).add
        ((integrable_fejer_abs hH).const_mul V))
      ((hfm.smul hcapm).aestronglyMeasurable) (Filter.Eventually.of_forall fun h => ?_)
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (fejer_nonneg hH h)]
    calc fejer H h * ‖∫ t in capSet c N h, corrLine μ F t h‖
        ≤ fejer H h * (V * N + V * |h|) :=
          mul_le_mul_of_nonneg_left (hcapb h) (fejer_nonneg hH h)
      _ = fejer H h * (V * N) + V * (fejer H h * |h|) := by ring
  have hptw : ∀ h : ℝ, ‖fejer H h • (∫ t in capSet c N h, corrLine μ F t h)
      - fejer H h • ∫ t in c..(c + N), corrLine μ F t h‖ ≤ V * (fejer H h * |h|) := by
    intro h
    rw [← smul_sub, norm_smul, Real.norm_eq_abs, abs_of_nonneg (fejer_nonneg hH h),
      norm_sub_rev]
    calc fejer H h * ‖(∫ t in c..(c + N), corrLine μ F t h)
          - ∫ t in capSet c N h, corrLine μ F t h‖
        ≤ fejer H h * (V * |h|) := mul_le_mul_of_nonneg_left (hdiff h) (fejer_nonneg hH h)
      _ = V * (fejer H h * |h|) := by ring
  rw [← integral_sub hint_cap hint_bar]
  refine le_trans (norm_integral_le_integral_norm _) ?_
  calc (∫ h : ℝ, ‖fejer H h • (∫ t in capSet c N h, corrLine μ F t h)
        - fejer H h • ∫ t in c..(c + N), corrLine μ F t h‖)
      ≤ ∫ h : ℝ, V * (fejer H h * |h|) :=
        integral_mono (hint_cap.sub hint_bar).norm ((integrable_fejer_abs hH).const_mul V) hptw
    _ = V * ∫ h : ℝ, fejer H h * |h| := by rw [integral_const_mul]
    _ ≤ V * H := mul_le_mul_of_nonneg_left (integral_fejer_abs_le hH) hV


open MeasureTheory in
/-- **`patch:signed-vdc`: signed integrated removal.**

With `I` of length `N > 0`, `0 < H <= N/4`, `V > 0`, `∫ |g|^2 <= V` and `∫ |F(x,s)|^2 dx <= V` at
every parameter value, and `A = V^{-1} ∫ g(x) E_{t in I} F(x,t) dx`,
    |A|^2 <= 2 Re ∫ kappa_H(h) (V N)^{-1} ∫_I (∫ F(x,t+h) conj(F(x,t)) dx) dt dh + 2H/N.

The three moves are the patch's own: `Auto.sq_norm_normalized_pairing_le` removes `g`, which is
independent of the parameter; `Auto.integral_sq_norm_le_fejer_autocorr` is the window construction
with `x` retained, giving `(1 + H/N) <= 2` times the averaged cut-off correlation, which is
nonnegative because it came from an integrated square; and
`Auto.norm_integral_fejer_capCorr_sub_le` pays `H/N` for replacing `I ∩ (I - h)` by `I`. The two
Fubini exchanges are `Auto.integral_fejer_autocorr_swap` and
`Auto.integral_capPair_eq_setIntegral_corrLine`.

This is emphatically not obtained by deleting an absolute value from `Auto.fejer_vdc'`: the right
hand side is a real part, and the inequality is one-sided from the start.

The integrability hypotheses are explicit, in the house style of
`Auto.integral_sq_norm_le_fejer_autocorr`; the patch supplies them "in applications, by bounded
factors and their finite-support envelopes". -/
theorem sq_norm_signed_vdc {α : Type*} [MeasurableSpace α] {μ : Measure α} [SFinite μ]
    {c N H V : ℝ} (hN : 0 < N) (hH : 0 < H) (hHN : H ≤ N / 4) (hV : 0 < V)
    {g : α → ℂ} {F : α → ℝ → ℂ}
    (hFm : Measurable (Function.uncurry F)) {M : ℝ} (hM : 0 ≤ M) (hFb : ∀ x t, ‖F x t‖ ≤ M)
    (hsq : ∀ s : ℝ, Integrable (fun x => ‖F x s‖ ^ 2) μ)
    (hcross : ∀ s s' : ℝ, Integrable (fun x => ‖F x s‖ * ‖F x s'‖) μ)
    (hFV : ∀ s : ℝ, (∫ x, ‖F x s‖ ^ 2 ∂μ) ≤ V)
    (hg2 : Integrable (fun x => ‖g x‖ ^ 2) μ) (hgV : (∫ x, ‖g x‖ ^ 2 ∂μ) ≤ V)
    (hΦ2 : Integrable (fun x => ‖(N⁻¹ : ℝ) • ∫ t in c..(c + N), F x t‖ ^ 2) μ)
    (hgΦ : Integrable (fun x => ‖g x‖ * ‖(N⁻¹ : ℝ) • ∫ t in c..(c + N), F x t‖) μ)
    (hLi : Integrable (fun x => ‖∫ u : ℝ, (Set.Ioc c (c + N)).indicator (F x) u‖ ^ 2) μ)
    (hRi : Integrable (fun x =>
      (∫ h : ℝ, fejer H h • autocorr ((Set.Ioc c (c + N)).indicator (F x)) h).re) μ)
    (hRc : Integrable (fun x =>
      ∫ h : ℝ, fejer H h • autocorr ((Set.Ioc c (c + N)).indicator (F x)) h) μ)
    (hswapH : Integrable (Function.uncurry fun (x : α) (h : ℝ) =>
      fejer H h • autocorr ((Set.Ioc c (c + N)).indicator (F x)) h) (μ.prod volume))
    (hswapT : ∀ h : ℝ, Integrable
      (Function.uncurry fun (x : α) (t : ℝ) => F x (t + h) * (starRingEnd ℂ) (F x t))
      (μ.prod (volume.restrict (capSet c N h)))) :
    ‖(V⁻¹ : ℝ) • ∫ x, g x * ((N⁻¹ : ℝ) • ∫ t in c..(c + N), F x t) ∂μ‖ ^ 2
      ≤ 2 * (V⁻¹ * N⁻¹ * (∫ h : ℝ, fejer H h • ∫ t in c..(c + N), corrLine μ F t h).re)
        + 2 * H / N := by
  have hmid := sq_norm_signed_vdc_mid hN hH hHN hV hFm hM hFb hg2 hgV hΦ2 hgΦ hLi hRi
  have hR1 : (∫ x, (∫ h : ℝ, fejer H h • autocorr ((Set.Ioc c (c + N)).indicator (F x)) h).re ∂μ)
      = (∫ h : ℝ, fejer H h • ∫ t in capSet c N h, corrLine μ F t h).re := by
    rw [integral_re_of_integrable hRc, integral_fejer_autocorr_swap hswapH]
    congr 1
    refine integral_congr_ae (Filter.Eventually.of_forall fun h => ?_)
    change fejer H h • (∫ x, autocorr ((Set.Ioc c (c + N)).indicator (F x)) h ∂μ)
        = fejer H h • ∫ t in capSet c N h, corrLine μ F t h
    congr 1
    have hae : (∫ x, autocorr ((Set.Ioc c (c + N)).indicator (F x)) h ∂μ)
        = ∫ x, capPair (F x) c N h ∂μ :=
      integral_congr_ae (Filter.Eventually.of_forall fun x =>
        autocorr_indicator_eq_capPair (F x) c N h)
    rw [hae]
    exact integral_capPair_eq_setIntegral_corrLine (hswapT h)
  have hcost := norm_integral_fejer_capCorr_sub_le (c := c) hN hH hV.le hFm hsq hcross hFV
  have hre : (∫ h : ℝ, fejer H h • ∫ t in capSet c N h, corrLine μ F t h).re
      ≤ (∫ h : ℝ, fejer H h • ∫ t in c..(c + N), corrLine μ F t h).re + V * H := by
    have hb : ((∫ h : ℝ, fejer H h • ∫ t in capSet c N h, corrLine μ F t h)
        - ∫ h : ℝ, fejer H h • ∫ t in c..(c + N), corrLine μ F t h).re ≤ V * H :=
      le_trans (Complex.re_le_norm _) hcost
    rw [Complex.sub_re] at hb
    linarith
  have hscalar : (2 : ℝ) * (V⁻¹ * N⁻¹ * (V * H)) = 2 * H / N := by
    have hVne : V ≠ 0 := hV.ne'
    field_simp
  rw [hR1] at hmid
  calc ‖(V⁻¹ : ℝ) • ∫ x, g x * ((N⁻¹ : ℝ) • ∫ t in c..(c + N), F x t) ∂μ‖ ^ 2
      ≤ 2 * (V⁻¹ * N⁻¹ * (∫ h : ℝ, fejer H h • ∫ t in capSet c N h, corrLine μ F t h).re) :=
        hmid
    _ ≤ 2 * (V⁻¹ * N⁻¹
          * ((∫ h : ℝ, fejer H h • ∫ t in c..(c + N), corrLine μ F t h).re + V * H)) :=
        mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_left hre (by positivity : (0 : ℝ) ≤ V⁻¹ * N⁻¹))
          (by norm_num : (0 : ℝ) ≤ 2)
    _ = 2 * (V⁻¹ * N⁻¹ * (∫ h : ℝ, fejer H h • ∫ t in c..(c + N), corrLine μ F t h).re)
          + 2 * (V⁻¹ * N⁻¹ * (V * H)) := by ring
    _ = 2 * (V⁻¹ * N⁻¹ * (∫ h : ℝ, fejer H h • ∫ t in c..(c + N), corrLine μ F t h).re)
          + 2 * H / N := by rw [hscalar]


/-! ## `blueprints/task_2_patch_3_updated.tex`, stage 2: the triangular frequency bound

`patch:triangular` descends through the degrees: with `a_r` the coefficients of the combined phase
and `z_i = N^{d_i} |xi_i|`, the exact identity
`xi_i lc(P_i) = a_{d_i} - sum_{u > i} xi_u [t^{d_i}] P_u` gives
`z_i <= u_c(delta) { M + u_c(delta) sum_{u > i} z_u }`, and the patch says to "apply
`patch:budgets` to this explicit recursion".  This section supplies the recursion itself, as a
statement about real numbers with no polynomials in it. -/

/-- **The triangular recursion of `patch:triangular`.**

If each `z i` is bounded by `A` plus `B` times the sum of the later ones, then the tail sums grow
at most geometrically.  Descending induction on the length of the tail; the patch's "at most three
steps" is the case `k <= 3`, but nothing here needs `k` bounded.  Nonnegativity of the `z i` is not
needed: the recursion alone carries the bound. -/
theorem sum_Ico_le_of_triangular {k : ℕ} {z : ℕ → ℝ} {A B : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hrec : ∀ i, i < k → z i ≤ A + B * ∑ u ∈ Finset.Ico (i + 1) k, z u) :
    ∀ n i : ℕ, i + n = k → (∑ u ∈ Finset.Ico i k, z u) ≤ A * n * (1 + B) ^ n := by
  intro n
  induction n with
  | zero =>
      intro i hi
      have hik : i = k := by omega
      subst hik
      simp
  | succ n ih =>
      intro i hi
      have hik : i < k := by omega
      have hnext : i + 1 + n = k := by omega
      have hS := ih (i + 1) hnext
      have hsplit : (∑ u ∈ Finset.Ico i k, z u)
          = z i + ∑ u ∈ Finset.Ico (i + 1) k, z u :=
        Finset.sum_eq_sum_Ico_succ_bot hik z
      have hzi := hrec i hik
      have h0 : (0 : ℝ) ≤ 1 + B := by linarith
      have hmul := mul_le_mul_of_nonneg_left hS h0
      have hone : (1 : ℝ) ≤ (1 + B) ^ (n + 1) := one_le_pow₀ (by linarith)
      have hAle : A ≤ A * (1 + B) ^ (n + 1) := le_mul_of_one_le_right hA hone
      calc (∑ u ∈ Finset.Ico i k, z u) = z i + ∑ u ∈ Finset.Ico (i + 1) k, z u := hsplit
        _ ≤ (A + B * ∑ u ∈ Finset.Ico (i + 1) k, z u)
              + ∑ u ∈ Finset.Ico (i + 1) k, z u := by linarith
        _ = A + (1 + B) * ∑ u ∈ Finset.Ico (i + 1) k, z u := by ring
        _ ≤ A + (1 + B) * (A * n * (1 + B) ^ n) := by linarith
        _ = A + A * n * (1 + B) ^ (n + 1) := by ring
        _ ≤ A * (1 + B) ^ (n + 1) + A * n * (1 + B) ^ (n + 1) := by linarith
        _ = A * ((n + 1 : ℕ) : ℝ) * (1 + B) ^ (n + 1) := by push_cast; ring

/-- The form `patch:triangular` uses: the whole sum is bounded by `A k (1 + B)^k`. -/
theorem sum_range_le_of_triangular {k : ℕ} {z : ℕ → ℝ} {A B : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hrec : ∀ i, i < k → z i ≤ A + B * ∑ u ∈ Finset.Ico (i + 1) k, z u) :
    (∑ u ∈ Finset.range k, z u) ≤ A * k * (1 + B) ^ k := by
  have h := sum_Ico_le_of_triangular hA hB hrec k 0 (by omega)
  rw [Finset.range_eq_Ico]
  exact h


open MeasureTheory in
/-- **The closing sentence of `lem:real-polynomial-oscillation`**, which `patch:triangular`
consumes: a lower bound `eps` for the oscillatory average bounds every nonconstant coefficient by
`|a_r| N^r <= (C_d/eps)^d`.

This is the contrapositive of `Auto.real_polynomial_oscillation` applied with `A` the largest of
the `|a_m| N^m`, together with the identity `(A^{1/d})^d = A`. -/
theorem coeff_bound_of_oscillation_ge (d : ℕ) (hd : 1 ≤ d) : ∃ C : ℝ, 1 ≤ C ∧
    ∀ (a : ℕ → ℝ) (N ε : ℝ), 0 < N → 0 < ε →
      ε ≤ ‖N⁻¹ • ∫ t in (0 : ℝ)..N,
          expPhase (fun s => 2 * Real.pi * ∑ m ∈ Finset.Icc 1 d, a m * s ^ m) t‖ →
      ∀ r, 1 ≤ r → r ≤ d → |a r| * N ^ r ≤ (C / ε) ^ d := by
  obtain ⟨C, hC1, hC⟩ := real_polynomial_oscillation d
  refine ⟨C, hC1, ?_⟩
  intro a N ε hN hε hlow r hr1 hrd
  have hC0 : (0 : ℝ) < C := lt_of_lt_of_le zero_lt_one hC1
  have hCε : (0 : ℝ) < C / ε := div_pos hC0 hε
  obtain ⟨m₀, hm₀mem, hm₀max⟩ :=
    Finset.exists_max_image (Finset.Icc 1 d) (fun m => |a m| * N ^ m)
      (Finset.nonempty_Icc.mpr hd)
  have hrmem : r ∈ Finset.Icc 1 d := Finset.mem_Icc.mpr ⟨hr1, hrd⟩
  have hrle : |a r| * N ^ r ≤ |a m₀| * N ^ m₀ := hm₀max r hrmem
  have hA0 : (0 : ℝ) ≤ |a m₀| * N ^ m₀ :=
    mul_nonneg (abs_nonneg _) (pow_nonneg hN.le _)
  rcases eq_or_lt_of_le hA0 with heq | hApos
  · refine le_trans hrle ?_
    rw [← heq]
    exact pow_nonneg hCε.le d
  · obtain ⟨hm₀1, hm₀d⟩ := Finset.mem_Icc.mp hm₀mem
    have hosc := hC a N (|a m₀| * N ^ m₀) hN hApos
      (fun m hm1 hmd => hm₀max m (Finset.mem_Icc.mpr ⟨hm1, hmd⟩))
      ⟨m₀, hm₀1, hm₀d, le_rfl⟩
    have hu : (0 : ℝ) < (|a m₀| * N ^ m₀) ^ ((1 : ℝ) / d) := Real.rpow_pos_of_pos hApos _
    have hinv : (|a m₀| * N ^ m₀) ^ (-(1 : ℝ) / d)
        = ((|a m₀| * N ^ m₀) ^ ((1 : ℝ) / d))⁻¹ := by
      rw [neg_div, Real.rpow_neg hApos.le]
    have hεle : ε ≤ C * ((|a m₀| * N ^ m₀) ^ ((1 : ℝ) / d))⁻¹ := by
      refine le_trans hlow (le_trans hosc ?_)
      rw [← hinv]
      exact mul_le_mul_of_nonneg_left (min_le_right _ _) hC0.le
    have hule : (|a m₀| * N ^ m₀) ^ ((1 : ℝ) / d) ≤ C / ε := by
      rw [le_div_iff₀ hε]
      have h1 : ε * ((|a m₀| * N ^ m₀) ^ ((1 : ℝ) / d))
          ≤ C * ((|a m₀| * N ^ m₀) ^ ((1 : ℝ) / d))⁻¹
            * ((|a m₀| * N ^ m₀) ^ ((1 : ℝ) / d)) :=
        mul_le_mul_of_nonneg_right hεle hu.le
      rw [inv_mul_cancel_right₀ hu.ne'] at h1
      linarith
    have hdne : (d : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
    have hAeq : ((|a m₀| * N ^ m₀) ^ ((1 : ℝ) / d)) ^ d = |a m₀| * N ^ m₀ := by
      rw [← Real.rpow_natCast ((|a m₀| * N ^ m₀) ^ ((1 : ℝ) / d)) d,
        ← Real.rpow_mul hApos.le, one_div, inv_mul_cancel₀ hdne, Real.rpow_one]
    calc |a r| * N ^ r ≤ |a m₀| * N ^ m₀ := hrle
      _ = ((|a m₀| * N ^ m₀) ^ ((1 : ℝ) / d)) ^ d := hAeq.symm
      _ ≤ (C / ε) ^ d := pow_le_pow_left₀ hu.le hule d


/-- The two budgets are reciprocal: `l_c(delta)^{-1} = u_c(delta)`. This is what turns the
division by `|lc P_i|` in `patch:triangular` back into a budget. -/
theorem budLo_inv (c : ℕ) (δ : ℝ) : (budLo c δ)⁻¹ = budHi c δ := by
  rw [budLo, budHi, mul_inv, inv_inv]

/-- **The exact leading-coefficient identity of `patch:triangular`.**

`[t^{d_i}] (sum_u xi_u P_u) = xi_i lc(P_i) + sum_{u > i} xi_u [t^{d_i}] P_u`, because the degrees
are strictly increasing: for `u < i` the polynomial `P_u` has degree `d_u < d_i`, so it contributes
nothing, and `[t^{d_i}] P_i` is the leading coefficient. -/
theorem coeff_sum_smul_eq {k : ℕ} (d : ℕ → ℕ) (P : ℕ → Polynomial ℝ) (ξ : ℕ → ℝ)
    (hdeg : ∀ u, u < k → (P u).natDegree = d u)
    (hmono : ∀ u v, u < v → v < k → d u < d v)
    (i : ℕ) (hi : i < k) :
    (∑ u ∈ Finset.range k, Polynomial.C (ξ u) * P u).coeff (d i)
      = ξ i * (P i).leadingCoeff
        + ∑ u ∈ Finset.Ico (i + 1) k, ξ u * (P u).coeff (d i) := by
  classical
  have hlead : (P i).coeff (d i) = (P i).leadingCoeff := by
    rw [Polynomial.leadingCoeff, hdeg i hi]
  rw [Polynomial.finsetSum_coeff]
  simp only [Polynomial.coeff_C_mul]
  rw [Finset.range_eq_Ico,
    ← Finset.sum_Ico_consecutive (fun u => ξ u * (P u).coeff (d i)) (Nat.zero_le i) hi.le,
    Finset.sum_eq_sum_Ico_succ_bot hi]
  have hzero : (∑ u ∈ Finset.Ico 0 i, ξ u * (P u).coeff (d i)) = 0 := by
    refine Finset.sum_eq_zero fun u hu => ?_
    obtain ⟨_, hui⟩ := Finset.mem_Ico.mp hu
    have huk : u < k := lt_trans hui hi
    have hlt : (P u).natDegree < d i := by
      rw [hdeg u huk]
      exact hmono u i hui hi
    rw [Polynomial.coeff_eq_zero_of_natDegree_lt hlt, mul_zero]
  rw [hzero, zero_add, hlead]


/-- **The descending step of `patch:triangular`.**

From the exact identity `Auto.coeff_sum_smul_eq`, the admissibility bounds on the leading
coefficient and on the lower coefficients, and a bound `M` on `N^{d_i} |a_{d_i}|`, the quantities
`z_i = N^{d_i} |xi_i|` obey the triangular recursion
    z_i <= Lo^{-1} M + (Lo^{-1} Hi) * sum_{u > i} z_u.

The powers of `N` cancel exactly: `|[t^{d_i}] P_u| <= Hi N^{d_u - d_i}` and
`N^{d_i} N^{d_u - d_i} = N^{d_u}`, which is where `d_i < d_u` is used. -/
theorem triangular_step {k : ℕ} {N M Lo Hi : ℝ} (hN : 0 < N) (hLo : 0 < Lo)
    (d : ℕ → ℕ) (P : ℕ → Polynomial ℝ) (ξ : ℕ → ℝ)
    (hdeg : ∀ u, u < k → (P u).natDegree = d u)
    (hmono : ∀ u v, u < v → v < k → d u < d v)
    (hlc : ∀ u, u < k → Lo ≤ |(P u).leadingCoeff|)
    (hcoeff : ∀ u r, u < k → r < d u → |(P u).coeff r| ≤ Hi * N ^ (d u - r))
    (hM : ∀ i, i < k →
      N ^ d i * |(∑ u ∈ Finset.range k, Polynomial.C (ξ u) * P u).coeff (d i)| ≤ M)
    (i : ℕ) (hi : i < k) :
    N ^ d i * |ξ i|
      ≤ Lo⁻¹ * M + Lo⁻¹ * Hi * ∑ u ∈ Finset.Ico (i + 1) k, N ^ d u * |ξ u| := by
  classical
  have hLone : Lo ≠ 0 := hLo.ne'
  have hNpow : (0 : ℝ) < N ^ d i := pow_pos hN _
  have hid := coeff_sum_smul_eq d P ξ hdeg hmono i hi
  have hsplit : ξ i * (P i).leadingCoeff
      = (∑ u ∈ Finset.range k, Polynomial.C (ξ u) * P u).coeff (d i)
        - ∑ u ∈ Finset.Ico (i + 1) k, ξ u * (P u).coeff (d i) := by
    rw [hid]
    ring
  have h1 : |ξ i * (P i).leadingCoeff|
      ≤ |(∑ u ∈ Finset.range k, Polynomial.C (ξ u) * P u).coeff (d i)|
        + |∑ u ∈ Finset.Ico (i + 1) k, ξ u * (P u).coeff (d i)| := by
    rw [hsplit, sub_eq_add_neg]
    refine le_trans (abs_add_le _ _) ?_
    rw [abs_neg]
  have h2 : |∑ u ∈ Finset.Ico (i + 1) k, ξ u * (P u).coeff (d i)|
      ≤ ∑ u ∈ Finset.Ico (i + 1) k, |ξ u| * |(P u).coeff (d i)| := by
    refine le_trans (Finset.abs_sum_le_sum_abs _ _) ?_
    exact Finset.sum_le_sum fun u _ => le_of_eq (abs_mul _ _)
  rw [abs_mul] at h1
  have habs : |ξ i| * |(P i).leadingCoeff|
      ≤ |(∑ u ∈ Finset.range k, Polynomial.C (ξ u) * P u).coeff (d i)|
        + ∑ u ∈ Finset.Ico (i + 1) k, |ξ u| * |(P u).coeff (d i)| := by linarith
  have hmul : N ^ d i * (|ξ i| * |(P i).leadingCoeff|)
      ≤ N ^ d i * |(∑ u ∈ Finset.range k, Polynomial.C (ξ u) * P u).coeff (d i)|
        + ∑ u ∈ Finset.Ico (i + 1) k, N ^ d i * (|ξ u| * |(P u).coeff (d i)|) := by
    have h := mul_le_mul_of_nonneg_left habs hNpow.le
    rw [mul_add, Finset.mul_sum] at h
    exact h
  have hterm : ∀ u ∈ Finset.Ico (i + 1) k,
      N ^ d i * (|ξ u| * |(P u).coeff (d i)|) ≤ Hi * (N ^ d u * |ξ u|) := by
    intro u hu
    obtain ⟨hiu, huk⟩ := Finset.mem_Ico.mp hu
    have hiu' : i < u := by omega
    have hdlt : d i < d u := hmono i u hiu' huk
    have hcu := hcoeff u (d i) huk hdlt
    have hpow : N ^ d i * N ^ (d u - d i) = N ^ d u := by
      rw [← pow_add]
      congr 1
      omega
    calc N ^ d i * (|ξ u| * |(P u).coeff (d i)|)
        ≤ N ^ d i * (|ξ u| * (Hi * N ^ (d u - d i))) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hcu (abs_nonneg _)) hNpow.le
      _ = Hi * ((N ^ d i * N ^ (d u - d i)) * |ξ u|) := by ring
      _ = Hi * (N ^ d u * |ξ u|) := by rw [hpow]
  have hsum : (∑ u ∈ Finset.Ico (i + 1) k, N ^ d i * (|ξ u| * |(P u).coeff (d i)|))
      ≤ Hi * ∑ u ∈ Finset.Ico (i + 1) k, N ^ d u * |ξ u| := by
    refine le_trans (Finset.sum_le_sum hterm) ?_
    rw [Finset.mul_sum]
  have hz0 : (0 : ℝ) ≤ N ^ d i * |ξ i| := by positivity
  have hstep : N ^ d i * |ξ i| * Lo ≤ N ^ d i * (|ξ i| * |(P i).leadingCoeff|) :=
    le_trans (mul_le_mul_of_nonneg_left (hlc i hi) hz0) (le_of_eq (by ring))
  have hkey : N ^ d i * |ξ i| * Lo
      ≤ M + Hi * ∑ u ∈ Finset.Ico (i + 1) k, N ^ d u * |ξ u| := by
    have hMi := hM i hi
    linarith
  have hfin := mul_le_mul_of_nonneg_left hkey (le_of_lt (inv_pos.mpr hLo))
  have hleft : Lo⁻¹ * (N ^ d i * |ξ i| * Lo) = N ^ d i * |ξ i| := by
    field_simp
  rw [hleft, mul_add, ← mul_assoc] at hfin
  exact hfin


/-- A polynomial of degree at most `D` is its constant term plus its nonconstant part. This is
what lets `patch:triangular` feed the combined phase to `Auto.coeff_bound_of_oscillation_ge`,
whose phase has no constant term. -/
theorem eval_eq_const_add_sum_Icc {D : ℕ} (Q : Polynomial ℝ) (hQ : Q.natDegree ≤ D) (t : ℝ) :
    Q.eval t = Q.coeff 0 + ∑ m ∈ Finset.Icc 1 D, Q.coeff m * t ^ m := by
  rw [Polynomial.eval_eq_sum_range' (Nat.lt_succ_of_le hQ), Finset.range_eq_Ico,
    Finset.sum_eq_sum_Ico_succ_bot (Nat.succ_pos D)]
  have hIco : Finset.Ico (0 + 1) D.succ = Finset.Icc 1 D := by
    ext m
    simp [Finset.mem_Ico, Finset.mem_Icc]
  rw [hIco]
  simp

open MeasureTheory in
/-- **A constant in the phase does not change the modulus of the average.** `e(c + p) = e(c) e(p)`
and `|e(c)| = 1`, so the constant term of the combined polynomial can be dropped. -/
theorem norm_integral_expPhase_const_add (c : ℝ) (φ : ℝ → ℝ) (N : ℝ) :
    ‖N⁻¹ • ∫ t in (0 : ℝ)..N, expPhase (fun s => c + φ s) t‖
      = ‖N⁻¹ • ∫ t in (0 : ℝ)..N, expPhase φ t‖ := by
  have hpt : ∀ t : ℝ, expPhase (fun s => c + φ s) t
      = Complex.exp ((c : ℂ) * Complex.I) * expPhase φ t := by
    intro t
    rw [expPhase, expPhase, ← Complex.exp_add]
    congr 1
    push_cast
    ring
  simp_rw [hpt]
  rw [intervalIntegral.integral_const_mul, norm_smul, norm_smul, norm_mul,
    Complex.norm_exp_ofReal_mul_I, one_mul]


/-- **The triangular bound, from the recursion.** `Auto.triangular_step` fed to
`Auto.sum_range_le_of_triangular`. -/
theorem sum_triangular_le {k : ℕ} {N M Lo Hi : ℝ} (hN : 0 < N) (hLo : 0 < Lo)
    (hM0 : 0 ≤ M) (hHi0 : 0 ≤ Hi)
    (d : ℕ → ℕ) (P : ℕ → Polynomial ℝ) (ξ : ℕ → ℝ)
    (hdeg : ∀ u, u < k → (P u).natDegree = d u)
    (hmono : ∀ u v, u < v → v < k → d u < d v)
    (hlc : ∀ u, u < k → Lo ≤ |(P u).leadingCoeff|)
    (hcoeff : ∀ u r, u < k → r < d u → |(P u).coeff r| ≤ Hi * N ^ (d u - r))
    (hM : ∀ i, i < k →
      N ^ d i * |(∑ u ∈ Finset.range k, Polynomial.C (ξ u) * P u).coeff (d i)| ≤ M) :
    (∑ i ∈ Finset.range k, N ^ d i * |ξ i|)
      ≤ Lo⁻¹ * M * k * (1 + Lo⁻¹ * Hi) ^ k :=
  sum_range_le_of_triangular (mul_nonneg (inv_nonneg.mpr hLo.le) hM0)
    (mul_nonneg (inv_nonneg.mpr hLo.le) hHi0)
    fun i hi => triangular_step hN hLo d P ξ hdeg hmono hlc hcoeff hM i hi

open MeasureTheory in
/-- **`patch:triangular`: distinct degrees give a triangular frequency bound.**

For polynomials of strictly increasing degrees `d_1 < ... < d_k <= D`, with leading coefficients at
least `Lo` and lower coefficients at most `Hi N^{d_i - r}` -- the patch's admissibility, with
`Lo = l_c(delta)` and `Hi = u_c(delta)` -- a lower bound `eps` on the oscillatory average of the
combined phase forces
    sum_i N^{d_i} |xi_i| <= Lo^{-1} (C_D/eps)^D k (1 + Lo^{-1} Hi)^k.

With the budgets in place, `Lo^{-1} = u_c(delta)` by `Auto.budLo_inv`, `eps` a power of `delta`,
and `k <= 3`, the right-hand side is a power of `delta^{-1}`: this is the patch's `delta^{-O(1)}`.

The route is the patch's: `Auto.coeff_bound_of_oscillation_ge` bounds every `N^r |a_r|` of the
combined polynomial, the constant term is dropped by `Auto.norm_integral_expPhase_const_add`
because it only rotates the average, and `Auto.sum_triangular_le` descends. -/
theorem sum_le_of_oscillation_ge (D : ℕ) (hD : 1 ≤ D) : ∃ C : ℝ, 1 ≤ C ∧
    ∀ (k : ℕ) (N ε Lo Hi : ℝ) (d : ℕ → ℕ) (P : ℕ → Polynomial ℝ) (ξ : ℕ → ℝ),
      0 < N → 0 < ε → 0 < Lo → 0 ≤ Hi →
      (∀ u, u < k → 1 ≤ d u) → (∀ u, u < k → d u ≤ D) →
      (∀ u, u < k → (P u).natDegree = d u) →
      (∀ u v, u < v → v < k → d u < d v) →
      (∀ u, u < k → Lo ≤ |(P u).leadingCoeff|) →
      (∀ u r, u < k → r < d u → |(P u).coeff r| ≤ Hi * N ^ (d u - r)) →
      ε ≤ ‖N⁻¹ • ∫ t in (0 : ℝ)..N, expPhase (fun s => 2 * Real.pi *
          (∑ u ∈ Finset.range k, Polynomial.C (ξ u) * P u).eval s) t‖ →
      (∑ i ∈ Finset.range k, N ^ d i * |ξ i|)
        ≤ Lo⁻¹ * (C / ε) ^ D * k * (1 + Lo⁻¹ * Hi) ^ k := by
  obtain ⟨C, hC1, hC⟩ := coeff_bound_of_oscillation_ge D hD
  refine ⟨C, hC1, ?_⟩
  intro k N ε Lo Hi d P ξ hN hε hLo hHi0 hd1 hdD hdeg hmono hlc hcoeff hosc
  have hC0 : (0 : ℝ) < C := lt_of_lt_of_le zero_lt_one hC1
  have hM0 : (0 : ℝ) ≤ (C / ε) ^ D := pow_nonneg (div_pos hC0 hε).le D
  have hQdeg : (∑ u ∈ Finset.range k, Polynomial.C (ξ u) * P u).natDegree ≤ D := by
    refine Polynomial.natDegree_sum_le_of_forall_le _ _ fun u hu => ?_
    have huk : u < k := Finset.mem_range.mp hu
    refine le_trans (Polynomial.natDegree_C_mul_le (ξ u) (P u)) ?_
    rw [hdeg u huk]
    exact hdD u huk
  have hphase : (fun s : ℝ => 2 * Real.pi
        * (∑ u ∈ Finset.range k, Polynomial.C (ξ u) * P u).eval s)
      = fun s : ℝ => 2 * Real.pi * (∑ u ∈ Finset.range k, Polynomial.C (ξ u) * P u).coeff 0
        + 2 * Real.pi * ∑ m ∈ Finset.Icc 1 D,
            (∑ u ∈ Finset.range k, Polynomial.C (ξ u) * P u).coeff m * s ^ m := by
    funext s
    rw [eval_eq_const_add_sum_Icc _ hQdeg s]
    ring
  rw [hphase, norm_integral_expPhase_const_add] at hosc
  have hcb := hC (fun m => (∑ u ∈ Finset.range k, Polynomial.C (ξ u) * P u).coeff m) N ε hN hε hosc
  have hM : ∀ i, i < k →
      N ^ d i * |(∑ u ∈ Finset.range k, Polynomial.C (ξ u) * P u).coeff (d i)| ≤ (C / ε) ^ D := by
    intro i hi
    have h := hcb (d i) (hd1 i hi) (hdD i hi)
    calc N ^ d i * |(∑ u ∈ Finset.range k, Polynomial.C (ξ u) * P u).coeff (d i)|
        = |(∑ u ∈ Finset.range k, Polynomial.C (ξ u) * P u).coeff (d i)| * N ^ d i := by ring
      _ ≤ (C / ε) ^ D := h
  exact sum_triangular_le hN hLo hM0 hHi0 d P ξ hdeg hmono hlc hcoeff hM


/-! ## `blueprints/task_2_patch_3_updated.tex`, stage 3: the labelled PET update

`patch:pet-update` is a statement about a symbolic state -- an ordered list of vector polynomials
with function blocks and a leading-coefficient invariant. Its proof rests on three purely
algebraic facts about the finite difference `delta_u Q = Q(t+u) - Q(t)`, which are independent of
all the state bookkeeping and are proved here first:

* `delta_u Q` has degree one less than `Q`, with leading coefficient `d u lc(Q)`;
* the displayed comparison `[Q_1(t+u) - Q_p(t)] - [Q_i(t) - Q_p(t)] = delta_u Q_1 + (Q_1 - Q_i)`;
* a leading coefficient of the form `a + b u` with `b` nonzero cannot vanish, because `u` is a
  fresh indeterminate.

The state itself, the pivot rule and the well-founded termination bound are not in this section. -/

open Polynomial in
/-- **The finite difference kills the top coefficient.** `Q(t+u) - Q(t)` has degree at most
`deg Q - 1`. -/
theorem natDegree_taylor_sub_self_le {R : Type*} [CommRing R] (Q : Polynomial R) (u : R) {e : ℕ}
    (hQ : Q.natDegree = e + 1) : ((taylor u) Q - Q).natDegree ≤ e := by
  refine Polynomial.natDegree_le_iff_coeff_eq_zero.mpr fun m hm => ?_
  have hle := natDegree_hasseDeriv_le Q m
  have hzero : (hasseDeriv m Q).natDegree < 1 := by omega
  have hconst : (hasseDeriv m Q).eval u = (hasseDeriv m Q).coeff 0 := by
    rw [Polynomial.eval_eq_sum_range' hzero]
    simp
  rw [coeff_sub, taylor_coeff, hconst, hasseDeriv_coeff]
  simp

open Polynomial in
/-- **The leading coefficient of the finite difference is `d u lc(Q)`**, the computation the proof
of `patch:pet-update` opens with. -/
theorem coeff_taylor_sub_self {R : Type*} [CommRing R] (Q : Polynomial R) (u : R) {e : ℕ}
    (hQ : Q.natDegree = e + 1) :
    ((taylor u) Q - Q).coeff e = ((e : R) + 1) * u * Q.leadingCoeff := by
  have hle := natDegree_hasseDeriv_le Q e
  have hdeg : (hasseDeriv e Q).natDegree < 2 := by omega
  have heval : (hasseDeriv e Q).eval u
      = (hasseDeriv e Q).coeff 0 + (hasseDeriv e Q).coeff 1 * u := by
    rw [Polynomial.eval_eq_sum_range' hdeg, Finset.sum_range_succ, Finset.sum_range_succ,
      Finset.sum_range_zero]
    ring
  have hc0 : (hasseDeriv e Q).coeff 0 = Q.coeff e := by
    rw [hasseDeriv_coeff]
    simp
  have hc1 : (hasseDeriv e Q).coeff 1 = ((e : R) + 1) * Q.coeff (e + 1) := by
    rw [hasseDeriv_coeff, show 1 + e = e + 1 from Nat.add_comm 1 e,
      Nat.choose_succ_self_right]
    push_cast
    ring
  have hlead : Q.coeff (e + 1) = Q.leadingCoeff := by
    rw [← hQ]
    exact Polynomial.coeff_natDegree
  rw [coeff_sub, taylor_coeff, heval, hc0, hc1, hlead]
  ring

open Polynomial in
/-- **The displayed comparison of `patch:pet-update`.** The shifted head minus an unshifted child
is the finite difference of the head plus the old difference of the two polynomials -- the pivot
cancels. -/
theorem taylor_sub_pivot_sub {R : Type*} [CommRing R] (Q1 Qi Qp : Polynomial R) (u : R) :
    ((taylor u) Q1 - Qp) - (Qi - Qp) = ((taylor u) Q1 - Q1) + (Q1 - Qi) := by
  ring

/-- **A leading coefficient linear in the fresh indeterminate cannot vanish.** This is the step
"it cannot vanish because `u` is a fresh indeterminate": the coefficient is `a + b u` with `b` the
nonzero old leading polynomial times `d`. -/
theorem linear_in_fresh_ne_zero {R : Type*} [CommRing R] {a b : R} (hb : b ≠ 0) :
    Polynomial.C a + Polynomial.C b * Polynomial.X ≠ 0 := by
  intro h
  have hc : (Polynomial.C a + Polynomial.C b * Polynomial.X).coeff 1 = 0 := by
    rw [h]
    simp
  simp only [Polynomial.coeff_add, Polynomial.coeff_C, Polynomial.coeff_C_mul,
    Polynomial.coeff_X_one, mul_one, ite_eq_right (one_ne_zero), zero_add] at hc
  exact hb hc


open MvPolynomial in
/-- **The new leading polynomial is homogeneous of the asserted degree.**

In `patch:pet-update` the leading coefficient of the compared children is
`p_{Q_1 - Q_i} + d u p_{Q_1}`, with `p_{Q_1 - Q_i}` homogeneous of degree `k+1` and `p_{Q_1}`
homogeneous of degree `k`; multiplying by the fresh variable raises the degree by one, so the sum
is homogeneous of degree `k+1`, which is `D - deg_t` one lower. -/
theorem isHomogeneous_add_X_mul {σ : Type*} {k : ℕ} (i : σ) {p q : MvPolynomial σ ℤ}
    (hp : p.IsHomogeneous (k + 1)) (hq : q.IsHomogeneous k) :
    (p + X i * q).IsHomogeneous (k + 1) := by
  have h := (isHomogeneous_X ℤ i).mul hq
  rw [Nat.add_comm 1 k] at h
  exact hp.add h

open MvPolynomial in
/-- **Freshness: the new leading polynomial cannot vanish.**

"It cannot vanish because `u` is a fresh indeterminate": the variable `i` does not occur in the old
part `p`, so the coefficient of any monomial of `q` shifted by `i` is exactly that of `q`. -/
theorem add_X_mul_ne_zero {σ : Type*} {i : σ} {p q : MvPolynomial σ ℤ}
    (hp : i ∉ p.vars) (hq : q ≠ 0) : p + X i * q ≠ 0 := by
  classical
  intro h
  obtain ⟨m, hm⟩ := MvPolynomial.ne_zero_iff.mp hq
  have hzero : (p + X i * q).coeff (Finsupp.single i 1 + m) = 0 := by
    rw [h]
    simp
  rw [AddMonoidAlgebra.coeff_add, Finsupp.add_apply, coeff_X_mul] at hzero
  have hp0 : p.coeff (Finsupp.single i 1 + m) = 0 := by
    by_contra hne
    have hmem : (Finsupp.single i 1 + m) ∈ p.support :=
      MvPolynomial.mem_support_iff.mpr hne
    have hval := MvPolynomial.mem_support_notMem_vars_zero hmem hp
    simp [Finsupp.single_eq_same] at hval
  rw [hp0, zero_add] at hzero
  exact hm hzero


open MvPolynomial in
/-- **`patch:lead-invariant` survives a labelled update.**

The patch's sentence "The sum is still `a` times a nonzero integer multilinear polynomial with the
asserted homogeneous degree", in the only case that needs an argument: the two compared children
have equal degree, so the new leading polynomial is `p_R + d u p_S` with `p_R` homogeneous of
degree `k+1`, `p_S` homogeneous of degree `k`, both multilinear, and `u` a variable occurring in
neither. The conclusion is the full invariant for the sum: nonzero, homogeneous of degree `k+1`,
multilinear.

Nonvanishing is `Auto.add_X_mul_ne_zero` -- it is exactly where freshness of `u` is used, and it
is the reason the patch insists `u` is a fresh indeterminate rather than a number. Multilinearity
in `u` needs freshness too: `deg_u (u p_S) = 1 + deg_u p_S = 1` only because `p_S` does not
involve `u`. -/
theorem petLead_add_fresh {r : ℕ} {k d : ℕ} {iu : Fin r} {pR pS : MvPolynomial (Fin r) ℤ}
    (hd : d ≠ 0) (hRhom : pR.IsHomogeneous (k + 1)) (hRml : ∀ i, pR.degreeOf i ≤ 1)
    (hSne : pS ≠ 0) (hShom : pS.IsHomogeneous k) (hSml : ∀ i, pS.degreeOf i ≤ 1)
    (hfR : iu ∉ pR.vars) (hfS : iu ∉ pS.vars) :
    (pR + C (d : ℤ) * X iu * pS) ≠ 0
      ∧ (pR + C (d : ℤ) * X iu * pS).IsHomogeneous (k + 1)
      ∧ ∀ i, (pR + C (d : ℤ) * X iu * pS).degreeOf i ≤ 1 := by
  classical
  have hdS : pS.degreeOf iu = 0 := by
    have h : pS.degreeOf iu < 1 := by
      rw [MvPolynomial.degreeOf_lt_iff Nat.one_pos]
      intro mm hmm
      have hz := MvPolynomial.mem_support_notMem_vars_zero hmm hfS
      omega
    omega
  have hCd : (C (d : ℤ) : MvPolynomial (Fin r) ℤ) ≠ 0 := by
    intro hC
    exact (Int.natCast_ne_zero.mpr hd) (MvPolynomial.C_eq_zero.mp hC)
  refine ⟨?_, ?_, ?_⟩
  · have hcomm : pR + C (d : ℤ) * X iu * pS = pR + X iu * (C (d : ℤ) * pS) := by ring
    rw [hcomm]
    exact add_X_mul_ne_zero hfR (mul_ne_zero hCd hSne)
  · refine hRhom.add ?_
    have h0 := ((MvPolynomial.isHomogeneous_C (Fin r) (d : ℤ)).mul
      (MvPolynomial.isHomogeneous_X ℤ iu)).mul hShom
    have hidx : 0 + 1 + k = k + 1 := by omega
    rw [hidx] at h0
    exact h0
  · intro i
    have hmid : (C (d : ℤ) * X iu * pS : MvPolynomial (Fin r) ℤ).degreeOf i ≤ 1 := by
      have h1 : (C (d : ℤ) * X iu * pS : MvPolynomial (Fin r) ℤ).degreeOf i
          ≤ (X iu * pS : MvPolynomial (Fin r) ℤ).degreeOf i := by
        rw [mul_assoc]
        exact MvPolynomial.degreeOf_C_mul_le _ i _
      have h2 : (X iu * pS : MvPolynomial (Fin r) ℤ).degreeOf i
          ≤ (X iu : MvPolynomial (Fin r) ℤ).degreeOf i + pS.degreeOf i :=
        MvPolynomial.degreeOf_mul_le i _ _
      by_cases hiu : i = iu
      · subst hiu
        rw [MvPolynomial.degreeOf_X_self] at h2
        omega
      · rw [MvPolynomial.degreeOf_X_of_ne hiu] at h2
        have h3 := hSml i
        omega
    exact le_trans (MvPolynomial.degreeOf_add_le i _ _) (max_le (hRml i) hmid)


open Polynomial in
/-- **The unshifted-child comparison of `patch:pet-update`, packaged.**

The new head minus an unshifted child has degree at most `d - 1`. -/
theorem natDegree_petChild_unshifted_le {R : Type*} [CommRing R] (Q1 Qi Qp : Polynomial R)
    (u : R) {e : ℕ} (hQ1 : Q1.natDegree = e + 1) (hQi : (Q1 - Qi).natDegree ≤ e) :
    (((taylor u) Q1 - Qp) - (Qi - Qp)).natDegree ≤ e := by
  rw [taylor_sub_pivot_sub]
  exact le_trans (natDegree_add_le _ _)
    (max_le (natDegree_taylor_sub_self_le Q1 u hQ1) hQi)

open Polynomial in
/-- Its coefficient there is `lc(Q_1 - Q_i) + d u lc(Q_1)`: the patch's "the leading coefficient is
the sum of an old polynomial in `h` and `d u` times another nonzero old polynomial". -/
theorem coeff_petChild_unshifted {R : Type*} [CommRing R] (Q1 Qi Qp : Polynomial R) (u : R)
    {e : ℕ} (hQ1 : Q1.natDegree = e + 1) :
    (((taylor u) Q1 - Qp) - (Qi - Qp)).coeff e
      = (Q1 - Qi).coeff e + ((e : R) + 1) * u * Q1.leadingCoeff := by
  rw [taylor_sub_pivot_sub, coeff_add, coeff_taylor_sub_self Q1 u hQ1]
  ring

open Polynomial in
/-- **The shifted-child comparison.**  "For a shifted child the difference is simply
`(Q_1 - Q_i)(t+u)`": the pivot cancels and the shift factors out. -/
theorem petChild_shifted {R : Type*} [CommRing R] (Q1 Qi Qp : Polynomial R) (u : R) :
    ((taylor u) Q1 - Qp) - ((taylor u) Qi - Qp) = (taylor u) (Q1 - Qi) := by
  rw [map_sub]
  ring

open Polynomial in
/-- "whose leading coefficient is unchanged": a shift preserves both the degree and the leading
coefficient. -/
theorem leadingCoeff_taylor {R : Type*} [CommRing R] (P : Polynomial R) (u : R) :
    ((taylor u) P).leadingCoeff = P.leadingCoeff := by
  have hle := natDegree_hasseDeriv_le P P.natDegree
  have hzero : (hasseDeriv P.natDegree P).natDegree < 1 := by omega
  simp only [Polynomial.leadingCoeff, natDegree_taylor, taylor_coeff]
  rw [Polynomial.eval_eq_sum_range' hzero]
  simp [hasseDeriv_coeff]


open Polynomial in
/-- **The child with its constant term removed.** `patch:pet-update` subtracts each child's
constant term in `t` and absorbs it as a translation of the attached function; this is the
polynomial side of that step, and it is what puts the new state back into the normal form
`Q_i(0, h) = 0`. -/
noncomputable def petSubConst {R : Type*} [CommRing R] (P : Polynomial R) : Polynomial R :=
  P - Polynomial.C (P.coeff 0)

open Polynomial in
/-- The normalized child vanishes at `t = 0`, which is the normal-state condition. -/
theorem petSubConst_coeff_zero {R : Type*} [CommRing R] (P : Polynomial R) :
    (petSubConst P).coeff 0 = 0 := by
  simp [petSubConst]

open Polynomial in
/-- **"Subtracting constants does not change these nonconstant leading terms."** -/
theorem petSubConst_coeff {R : Type*} [CommRing R] (P : Polynomial R) {n : ℕ} (hn : n ≠ 0) :
    (petSubConst P).coeff n = P.coeff n := by
  simp [petSubConst, Polynomial.coeff_C, hn]

open Polynomial in
theorem natDegree_petSubConst_le {R : Type*} [CommRing R] (P : Polynomial R) :
    (petSubConst P).natDegree ≤ P.natDegree := by
  change (P - Polynomial.C (P.coeff 0)).natDegree ≤ P.natDegree
  refine le_trans (natDegree_sub_le _ _) ?_
  simp

open Polynomial in
/-- On a nonconstant child the degree is unchanged. -/
theorem natDegree_petSubConst {R : Type*} [CommRing R] {P : Polynomial R}
    (hP : 1 ≤ P.natDegree) : (petSubConst P).natDegree = P.natDegree := by
  refine le_antisymm (natDegree_petSubConst_le P) ?_
  refine le_natDegree_of_ne_zero ?_
  rw [petSubConst_coeff P (by omega : P.natDegree ≠ 0)]
  intro hzero
  have hP0 : P ≠ 0 := fun h => by simp [h] at hP
  exact (Polynomial.leadingCoeff_ne_zero.mpr hP0) hzero

open Polynomial in
/-- And so is the leading coefficient. -/
theorem leadingCoeff_petSubConst {R : Type*} [CommRing R] {P : Polynomial R}
    (hP : 1 ≤ P.natDegree) : (petSubConst P).leadingCoeff = P.leadingCoeff := by
  simp only [Polynomial.leadingCoeff, natDegree_petSubConst hP]
  exact petSubConst_coeff P (by omega : P.natDegree ≠ 0)

open Polynomial in
/-- Normalizing two children changes their difference only by a constant, so every nonconstant
coefficient of the difference -- in particular its leading one -- is untouched. -/
theorem petSubConst_sub_coeff {R : Type*} [CommRing R] (P Q : Polynomial R) {n : ℕ} (hn : n ≠ 0) :
    (petSubConst P - petSubConst Q).coeff n = (P - Q).coeff n := by
  rw [coeff_sub, coeff_sub, petSubConst_coeff P hn, petSubConst_coeff Q hn]


/-! ### The vector layer of `patch:lead-invariant`

The invariant says `lc_t R = a p_R(h) e_m`. In Lean the leading coefficient lives in
`Fin n -> MvPolynomial (Fin r) R`, so `a p(h) e_m` is `Pi.single m (C a * p)`. These lemmas move
the scalar statements of the previous section across that layer. -/

/-- Multiplying a coordinate vector by a constant vector stays a coordinate vector. This is how
the factor `d u` of the finite difference passes through `e_m`. -/
theorem pi_const_mul_single {n : ℕ} {K : Type*} [CommRing K] (c : K) (m : Fin n) (x : K) :
    ((fun _ => c : Fin n → K)) * Pi.single m x = Pi.single m (c * x) := by
  funext j
  by_cases h : j = m
  · subst h
    simp
  · simp [Pi.single_eq_of_ne h]

/-- Coordinate vectors at the same coordinate add coordinatewise. -/
theorem pi_single_add' {n : ℕ} {K : Type*} [CommRing K] (m : Fin n) (x y : K) :
    (Pi.single m x : Fin n → K) + Pi.single m y = Pi.single m (x + y) := by
  funext j
  by_cases h : j = m
  · subst h
    simp
  · simp [Pi.single_eq_of_ne h]

/-- **The invariant's vector is nonzero.** `a p(h) e_m` vanishes only if `p` does, because `a` is
nonzero and `Z -> R` is injective. -/
theorem leadVec_ne_zero {r n : ℕ} {a : ℝ} (ha : a ≠ 0) (m : Fin n)
    {p : MvPolynomial (Fin r) ℤ} (hp : p ≠ 0) :
    (Pi.single m (MvPolynomial.C a * p.map (Int.castRingHom ℝ))
      : Fin n → MvPolynomial (Fin r) ℝ) ≠ 0 := by
  intro hz
  have hcomp := congrFun hz m
  rw [Pi.single_eq_same, Pi.zero_apply] at hcomp
  have hCa : (MvPolynomial.C a : MvPolynomial (Fin r) ℝ) ≠ 0 := by
    intro hC
    exact ha (MvPolynomial.C_eq_zero.mp hC)
  have hinj : Function.Injective (Int.castRingHom ℝ) := fun x y hxy => Int.cast_injective hxy
  have hmap : p.map (Int.castRingHom ℝ) ≠ 0 := by
    intro h
    refine hp (MvPolynomial.map_injective (Int.castRingHom ℝ) hinj ?_)
    simpa using h
  exact (mul_ne_zero hCa hmap) hcomp

/-- Two polynomials with a differing coefficient are distinct -- the form in which
`patch:pet-update` concludes that "the head differs nontrivially from every other child". -/
theorem ne_of_sub_coeff_ne_zero {R : Type*} [CommRing R] {A B : Polynomial R} {n : ℕ}
    (h : (A - B).coeff n ≠ 0) : A ≠ B := by
  intro hAB
  rw [hAB, sub_self] at h
  simp at h


/-- **The invariant, computed for the new head minus an unshifted child.**

With the old invariant data `lc(Q_1 - Q_i) = a p_R e_m` and `lc(Q_1) = a p_S e_m`, the coefficient
of the compared children at the new head degree is `a (p_R + d u p_S) e_m` -- the new leading
polynomial the patch describes. Here `u` is the fresh indeterminate `X iu`, embedded in the
coefficient ring as the constant vector, which is what shifting the scalar variable `t` by `u`
means. -/
theorem coeff_petChild_unshifted_vec {r n : ℕ} {a : ℝ} {m : Fin n} {iu : Fin r} {e : ℕ}
    {Q1 Qi Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)}
    {pR pS : MvPolynomial (Fin r) ℤ}
    (hQ1 : Q1.natDegree = e + 1)
    (hR : (Q1 - Qi).coeff e
      = Pi.single m (MvPolynomial.C a * pR.map (Int.castRingHom ℝ)))
    (hS : Q1.leadingCoeff
      = Pi.single m (MvPolynomial.C a * pS.map (Int.castRingHom ℝ))) :
    (((Polynomial.taylor (fun _ => MvPolynomial.X iu :
          Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qp) - (Qi - Qp)).coeff e
      = Pi.single m (MvPolynomial.C a
          * ((pR + MvPolynomial.C ((e + 1 : ℕ) : ℤ) * MvPolynomial.X iu * pS).map
              (Int.castRingHom ℝ))) := by
  classical
  have hnat : ((e : MvPolynomial (Fin r) ℝ) + 1) = MvPolynomial.C ((e : ℝ) + 1) := by
    rw [map_add, map_one, map_natCast]
  have hcast : (Int.castRingHom ℝ) ((e + 1 : ℕ) : ℤ) = (e : ℝ) + 1 := by
    simp only [eq_intCast]
    push_cast
    ring
  have hmapeq : ((pR + MvPolynomial.C ((e + 1 : ℕ) : ℤ) * MvPolynomial.X iu * pS).map
        (Int.castRingHom ℝ))
      = pR.map (Int.castRingHom ℝ)
        + MvPolynomial.C ((e : ℝ) + 1) * MvPolynomial.X iu
          * pS.map (Int.castRingHom ℝ) := by
    rw [map_add, map_mul, map_mul, MvPolynomial.map_C, MvPolynomial.map_X, hcast]
  have hc : ((e : Fin n → MvPolynomial (Fin r) ℝ) + 1)
        * (fun _ => MvPolynomial.X iu : Fin n → MvPolynomial (Fin r) ℝ)
      = (fun _ => ((e : MvPolynomial (Fin r) ℝ) + 1) * MvPolynomial.X iu) := by
    funext j
    simp
  rw [coeff_petChild_unshifted Q1 Qi Qp _ hQ1, hR, hS, hc, pi_const_mul_single, pi_single_add']
  congr 1
  rw [hnat, hmapeq]
  ring

/-- **"The head differs nontrivially from every other child."**

The coefficient computed above is `a` times a nonzero integer polynomial, by
`Auto.petLead_add_fresh`, hence nonzero by `Auto.leadVec_ne_zero`; so the two children are
distinct. This is the step of `patch:pet-update` that guarantees grouping never multiplies
another factor into the protected head, and it is exactly where the fresh indeterminate earns its
keep. -/
theorem petHead_ne_child {r n : ℕ} {a : ℝ} (ha : a ≠ 0) {m : Fin n} {k : ℕ} {iu : Fin r} {e : ℕ}
    {Q1 Qi Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)}
    {pR pS : MvPolynomial (Fin r) ℤ}
    (hQ1 : Q1.natDegree = e + 1)
    (hR : (Q1 - Qi).coeff e
      = Pi.single m (MvPolynomial.C a * pR.map (Int.castRingHom ℝ)))
    (hS : Q1.leadingCoeff
      = Pi.single m (MvPolynomial.C a * pS.map (Int.castRingHom ℝ)))
    (hRhom : pR.IsHomogeneous (k + 1)) (hRml : ∀ i, pR.degreeOf i ≤ 1) (hfR : iu ∉ pR.vars)
    (hSne : pS ≠ 0) (hShom : pS.IsHomogeneous k) (hSml : ∀ i, pS.degreeOf i ≤ 1)
    (hfS : iu ∉ pS.vars) :
    ((Polynomial.taylor (fun _ => MvPolynomial.X iu :
        Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qp) ≠ (Qi - Qp) := by
  refine ne_of_sub_coeff_ne_zero (n := e) ?_
  rw [coeff_petChild_unshifted_vec hQ1 hR hS]
  obtain ⟨hne, -, -⟩ :=
    petLead_add_fresh (d := e + 1) (by omega) hRhom hRml hSne hShom hSml hfR hfS
  exact leadVec_ne_zero ha m hne


/-! ### The Lean state of `patch:pet-update`

The patch fixes the representation itself, in its paragraph "Lean state": *"Use an outer polynomial
in `t` with coefficients in a multivariate polynomial ring in the shift variables. A factor
carries its origin index, conjugation flag, and constant-translation polynomial. Normalization
groups function lists; it does not discard duplicate factors. The head list has length one.
Polynomial equality can be handled classically."*  The names below are the patch's own Lean nodes.

"The head list has length one" is encoded in the type rather than asserted, so that the update's
conclusion "its head block is a singleton of origin `f`" is partly structural, as the patch
intends. -/

/-- A factor of a block: its origin index, its conjugation flag, and its constant translation. -/
structure PetFactor (r n : ℕ) (ι : Type*) where
  /-- Which input this factor is a copy of. -/
  origin : ι
  /-- Whether the factor is conjugated. -/
  isConj : Bool
  /-- The constant translation absorbed into the factor. -/
  transl : Fin n → MvPolynomial (Fin r) ℝ

/-- Conjugating a factor: what a shifted child does to its function. -/
def PetFactor.starFac {r n : ℕ} {ι : Type*} (F : PetFactor r n ι) : PetFactor r n ι :=
  { F with isConj := !F.isConj }

/-- Absorbing a constant translation into a factor, which is what subtracting a child's constant
term in `t` does to the attached function. -/
noncomputable def PetFactor.shiftFac {r n : ℕ} {ι : Type*} (F : PetFactor r n ι)
    (c : Fin n → MvPolynomial (Fin r) ℝ) : PetFactor r n ι :=
  { F with transl := F.transl + c }

/-- **"Translation by its constant term preserves origin"**. -/
@[simp] theorem PetFactor.origin_shiftFac {r n : ℕ} {ι : Type*} (F : PetFactor r n ι)
    (c : Fin n → MvPolynomial (Fin r) ℝ) : (F.shiftFac c).origin = F.origin := rfl

/-- Conjugation likewise leaves the origin alone, so a shifted child is still a copy of the same
input. -/
@[simp] theorem PetFactor.origin_starFac {r n : ℕ} {ι : Type*} (F : PetFactor r n ι) :
    F.starFac.origin = F.origin := rfl

/-- **`NormalPETState`.** An ordered list of nonzero distinct vector polynomials vanishing at
`t = 0`, with the head of maximum degree; a function block for each, and a spatial block. The head
block is a singleton of origin the protected input `f`. -/
structure NormalPETState (r n : ℕ) (ι : Type*) (f : ι) where
  /-- The spatial block `g_0`. -/
  spatial : List (PetFactor r n ι)
  /-- The head polynomial `Q_1`. -/
  headPoly : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)
  /-- The single factor of the head block `g_1`. -/
  headFactor : PetFactor r n ι
  /-- The remaining polynomials with their blocks. -/
  rest : List (Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι))
  /-- The head block is a copy of the protected input. -/
  head_origin : headFactor.origin = f
  /-- The head polynomial is nonzero. -/
  headPoly_ne_zero : headPoly ≠ 0
  /-- Every polynomial vanishes at `t = 0`. -/
  headPoly_vanish : headPoly.coeff 0 = 0
  /-- The other polynomials are nonzero. -/
  rest_ne_zero : ∀ QB ∈ rest, QB.1 ≠ 0
  /-- The other polynomials vanish at `t = 0`. -/
  rest_vanish : ∀ QB ∈ rest, QB.1.coeff 0 = 0
  /-- They are distinct from the head. -/
  rest_ne_head : ∀ QB ∈ rest, QB.1 ≠ headPoly
  /-- They are distinct from each other. -/
  rest_nodup : (rest.map Prod.fst).Nodup
  /-- The head has maximum degree. -/
  head_max : ∀ QB ∈ rest, QB.1.natDegree ≤ headPoly.natDegree

/-- **`ProtectedLeadingInvariant`**, the patch's `patch:lead-invariant`:
`lc_t R = a p_R(h) e_m` with `p_R` a nonzero integer polynomial, multilinear and homogeneous of
degree `D - deg_t R`. -/
def ProtectedLeadingInvariant {r n : ℕ} (a : ℝ) (m : Fin n) (D : ℕ)
    (R : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)) : Prop :=
  ∃ p : MvPolynomial (Fin r) ℤ, p ≠ 0 ∧ p.IsHomogeneous (D - R.natDegree) ∧
    (∀ i, p.degreeOf i ≤ 1) ∧
    R.leadingCoeff = Pi.single m (MvPolynomial.C a * p.map (Int.castRingHom ℝ))

/-- **"Subtracting constants does not change these nonconstant leading terms"**, at the level of
the invariant: removing a nonconstant polynomial's constant term preserves
`ProtectedLeadingInvariant`. -/
theorem ProtectedLeadingInvariant.subConst {r n : ℕ} {a : ℝ} {m : Fin n} {D : ℕ}
    {R : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)} (hR : 1 ≤ R.natDegree)
    (h : ProtectedLeadingInvariant a m D R) :
    ProtectedLeadingInvariant a m D (petSubConst R) := by
  obtain ⟨p, hp0, hphom, hpml, hlead⟩ := h
  refine ⟨p, hp0, ?_, hpml, ?_⟩
  · rw [natDegree_petSubConst hR]
    exact hphom
  · rw [leadingCoeff_petSubConst hR]
    exact hlead


/-- **The two children of a factor.**  The patch: "The two children of a factor `(g_i, Q_i)` are
exactly `(conj g_i, Q_i(t+u) - Q_p(t))`, `(g_i, Q_i(t) - Q_p(t))`", with the shifted one first. -/
noncomputable def petChildren {r n : ℕ} {ι : Type*}
    (u : Fin n → MvPolynomial (Fin r) ℝ)
    (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    (item : Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι)) :
    List (Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι)) :=
  [((Polynomial.taylor u) item.1 - Qp, item.2.map PetFactor.starFac),
    (item.1 - Qp, item.2)]

/-- **Normalizing a child**: subtract its constant term in `t` and absorb that constant as a
translation of every factor of its block. -/
noncomputable def petNormalizeItem {r n : ℕ} {ι : Type*}
    (item : Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι)) :
    Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι) :=
  (petSubConst item.1, item.2.map fun F => F.shiftFac (item.1.coeff 0))

/-- Conjugating a block leaves every origin alone. -/
@[simp] theorem map_origin_starFac {r n : ℕ} {ι : Type*} (l : List (PetFactor r n ι)) :
    (l.map PetFactor.starFac).map PetFactor.origin = l.map PetFactor.origin := by
  simp [List.map_map, Function.comp_def]

/-- Normalization leaves block lengths alone, so a singleton head block stays a singleton. -/
@[simp] theorem length_petNormalizeItem {r n : ℕ} {ι : Type*}
    (item : Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι)) :
    (petNormalizeItem item).2.length = item.2.length := by
  simp [petNormalizeItem]

/-- Normalization preserves every origin, so the head block stays a copy of the protected input. -/
@[simp] theorem origin_petNormalizeItem {r n : ℕ} {ι : Type*}
    (item : Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι)) :
    (petNormalizeItem item).2.map PetFactor.origin = item.2.map PetFactor.origin := by
  simp [petNormalizeItem, List.map_map, Function.comp_def]

/-- The normalized child vanishes at `t = 0`: the normal-state condition is restored. -/
@[simp] theorem petNormalizeItem_coeff_zero {r n : ℕ} {ι : Type*}
    (item : Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι)) :
    (petNormalizeItem item).1.coeff 0 = 0 :=
  petSubConst_coeff_zero _

/-- **The new head differs from every normalized unshifted child.**

This is `Auto.petHead_ne_child` after the constant terms have been removed, which is legitimate
because removing constants does not touch the coefficient at `e = d - 1`; that needs `e` nonzero,
which is exactly the patch's standing hypothesis that the current head degree is `d >= 2`. -/
theorem petNewHead_ne_child {r n : ℕ} {a : ℝ} (ha : a ≠ 0) {m : Fin n} {k : ℕ} {iu : Fin r}
    {e : ℕ} (he : e ≠ 0)
    {Q1 Qi Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)}
    {pR pS : MvPolynomial (Fin r) ℤ}
    (hQ1 : Q1.natDegree = e + 1)
    (hR : (Q1 - Qi).coeff e
      = Pi.single m (MvPolynomial.C a * pR.map (Int.castRingHom ℝ)))
    (hS : Q1.leadingCoeff
      = Pi.single m (MvPolynomial.C a * pS.map (Int.castRingHom ℝ)))
    (hRhom : pR.IsHomogeneous (k + 1)) (hRml : ∀ i, pR.degreeOf i ≤ 1) (hfR : iu ∉ pR.vars)
    (hSne : pS ≠ 0) (hShom : pS.IsHomogeneous k) (hSml : ∀ i, pS.degreeOf i ≤ 1)
    (hfS : iu ∉ pS.vars) :
    petSubConst ((Polynomial.taylor (fun _ => MvPolynomial.X iu :
        Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qp) ≠ petSubConst (Qi - Qp) := by
  refine ne_of_sub_coeff_ne_zero (n := e) ?_
  rw [petSubConst_sub_coeff _ _ he, coeff_petChild_unshifted_vec hQ1 hR hS]
  obtain ⟨hne, -, -⟩ :=
    petLead_add_fresh (d := e + 1) (by omega) hRhom hRml hSne hShom hSml hfR hfS
  exact leadVec_ne_zero ha m hne


/-- The state's items as one list, head first. -/
noncomputable def petAllItems {r n : ℕ} {ι : Type*} {f : ι} (S : NormalPETState r n ι f) :
    List (Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι)) :=
  (S.headPoly, [S.headFactor]) :: S.rest

/-- All children of all items, the shifted head first. -/
noncomputable def petRawChildren {r n : ℕ} {ι : Type*} {f : ι}
    (u : Fin n → MvPolynomial (Fin r) ℝ) (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    (S : NormalPETState r n ι f) :
    List (Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι)) :=
  (petAllItems S).flatMap (petChildren u Qp)

/-- The children after constants have been subtracted and absorbed. -/
noncomputable def petNormalized {r n : ℕ} {ι : Type*} {f : ι}
    (u : Fin n → MvPolynomial (Fin r) ℝ) (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    (S : NormalPETState r n ι f) :
    List (Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι)) :=
  (petRawChildren u Qp S).map petNormalizeItem

open scoped Classical in
/-- **"The old spatial block was removed by the Cauchy-Schwarz inequality; constant children form
the new spatial block."** -/
noncomputable def petNewSpatial {r n : ℕ} {ι : Type*} {f : ι}
    (u : Fin n → MvPolynomial (Fin r) ℝ) (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    (S : NormalPETState r n ι f) : List (PetFactor r n ι) :=
  ((petNormalized u Qp S).filter fun it => decide (it.1 = 0)).flatMap Prod.snd

/-- **The new head**: the shifted head child, normalized.  "putting the shifted head first". -/
noncomputable def petNewHead {r n : ℕ} {ι : Type*} {f : ι}
    (u : Fin n → MvPolynomial (Fin r) ℝ) (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    (S : NormalPETState r n ι f) :
    Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι) :=
  petNormalizeItem ((Polynomial.taylor u) S.headPoly - Qp, [S.headFactor.starFac])

/-- **"its head block is a singleton"**, by construction. -/
@[simp] theorem petNewHead_block_length {r n : ℕ} {ι : Type*} {f : ι}
    (u : Fin n → MvPolynomial (Fin r) ℝ) (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    (S : NormalPETState r n ι f) : (petNewHead u Qp S).2.length = 1 := by
  simp [petNewHead]

/-- **"of origin `f`"**: conjugating and translating leave the origin alone. -/
@[simp] theorem petNewHead_block_origin {r n : ℕ} {ι : Type*} {f : ι}
    (u : Fin n → MvPolynomial (Fin r) ℝ) (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    (S : NormalPETState r n ι f) :
    (petNewHead u Qp S).2.map PetFactor.origin = [f] := by
  simp [petNewHead, petNormalizeItem, S.head_origin]

/-- The new head vanishes at `t = 0`. -/
@[simp] theorem petNewHead_coeff_zero {r n : ℕ} {ι : Type*} {f : ι}
    (u : Fin n → MvPolynomial (Fin r) ℝ) (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    (S : NormalPETState r n ι f) : (petNewHead u Qp S).1.coeff 0 = 0 :=
  petNormalizeItem_coeff_zero _

/-- Every normalized child vanishes at `t = 0`. -/
theorem petNormalized_coeff_zero {r n : ℕ} {ι : Type*} {f : ι}
    (u : Fin n → MvPolynomial (Fin r) ℝ) (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    (S : NormalPETState r n ι f) :
    ∀ it ∈ petNormalized u Qp S, it.1.coeff 0 = 0 := by
  intro it hit
  rw [petNormalized, List.mem_map] at hit
  obtain ⟨jt, -, rfl⟩ := hit
  exact petNormalizeItem_coeff_zero _


/-- **Grouping identical polynomials.**  The patch: "Normalization groups *function lists*; it does
not discard duplicate factors."  Items sharing a polynomial are merged by concatenating their
blocks, so multiplicities are retained. Equality of polynomials is decided classically at the use
site, as the patch allows. -/
noncomputable def petGroup {r n : ℕ} {ι : Type*}
    [DecidableEq (Polynomial (Fin n → MvPolynomial (Fin r) ℝ))]
    (l : List (Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι))) :
    List (Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι)) :=
  (l.map Prod.fst).dedup.map fun k =>
    (k, (l.filter fun it => decide (it.1 = k)).flatMap Prod.snd)

theorem petGroup_keys {r n : ℕ} {ι : Type*}
    [DecidableEq (Polynomial (Fin n → MvPolynomial (Fin r) ℝ))]
    (l : List (Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι))) :
    (petGroup l).map Prod.fst = (l.map Prod.fst).dedup := by
  simp [petGroup, List.map_map, Function.comp_def]

/-- The grouped list has distinct polynomials, which is the normal-state condition that grouping
exists to restore. -/
theorem petGroup_nodup {r n : ℕ} {ι : Type*}
    [DecidableEq (Polynomial (Fin n → MvPolynomial (Fin r) ℝ))]
    (l : List (Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι))) :
    ((petGroup l).map Prod.fst).Nodup := by
  rw [petGroup_keys]
  exact List.nodup_dedup _

/-- If two polynomials differ by something nonconstant, they still differ after their constant
terms are removed. -/
theorem petSubConst_ne_of_natDegree_pos {R : Type*} [CommRing R] {A B : Polynomial R}
    (h : 1 ≤ (A - B).natDegree) : petSubConst A ≠ petSubConst B := by
  refine ne_of_sub_coeff_ne_zero (n := (A - B).natDegree) ?_
  rw [petSubConst_sub_coeff _ _ (by omega : (A - B).natDegree ≠ 0)]
  have hne : A - B ≠ 0 := by
    intro h0
    rw [h0] at h
    simp at h
  exact Polynomial.leadingCoeff_ne_zero.mpr hne

open Polynomial in
/-- **The new head differs from every other shifted child.**  "For a shifted child the difference
is simply `(Q_1 - Q_i)(t+u)`": the shift is injective, and a nonzero polynomial vanishing at
`t = 0` is nonconstant, so the difference survives the removal of constant terms. -/
theorem petNewHead_ne_shiftedChild {r n : ℕ}
    (u : Fin n → MvPolynomial (Fin r) ℝ) (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    {Q1 Qi : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)}
    (h1 : Q1.coeff 0 = 0) (hi : Qi.coeff 0 = 0) (hne : Q1 ≠ Qi) :
    petSubConst ((taylor u) Q1 - Qp) ≠ petSubConst ((taylor u) Qi - Qp) := by
  have hd : Q1 - Qi ≠ 0 := sub_ne_zero.mpr hne
  have hc0 : (Q1 - Qi).coeff 0 = 0 := by
    rw [Polynomial.coeff_sub, h1, hi, sub_zero]
  have hdeg : 1 ≤ (Q1 - Qi).natDegree := by
    by_contra hcon
    have h0 : (Q1 - Qi).natDegree = 0 := by omega
    have heq := Polynomial.eq_C_of_natDegree_eq_zero h0
    rw [hc0] at heq
    simp only [map_zero] at heq
    exact hd heq
  refine petSubConst_ne_of_natDegree_pos ?_
  rw [petChild_shifted, Polynomial.natDegree_taylor]
  exact hdeg


/-- Every polynomial surviving the grouping was already one of the input polynomials. -/
theorem petGroup_fst_mem {r n : ℕ} {ι : Type*}
    [DecidableEq (Polynomial (Fin n → MvPolynomial (Fin r) ℝ))]
    {l : List (Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι))}
    {QB : Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι)}
    (h : QB ∈ petGroup l) : QB.1 ∈ l.map Prod.fst := by
  rw [petGroup, List.mem_map] at h
  obtain ⟨k, hk, rfl⟩ := h
  exact List.mem_dedup.mp hk

/-- Consequently any property of the input polynomials transports to the grouped ones. This is
what makes every normal-state condition survive "multiplying the function lists attached to
identical remaining polynomials": grouping changes blocks, never polynomials. -/
theorem petGroup_property {r n : ℕ} {ι : Type*}
    [DecidableEq (Polynomial (Fin n → MvPolynomial (Fin r) ℝ))]
    {l : List (Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι))}
    (P : Polynomial (Fin n → MvPolynomial (Fin r) ℝ) → Prop) (h : ∀ it ∈ l, P it.1) :
    ∀ QB ∈ petGroup l, P QB.1 := by
  intro QB hQB
  obtain ⟨it, hit, hEq⟩ := List.mem_map.mp (petGroup_fst_mem hQB)
  rw [← hEq]
  exact h it hit

/-- **Assembling a normal state from a head and a list of candidate children.**

This is the bookkeeping half of `patch:pet-update`: given a head and a list of children that are
nonzero, vanish at `t = 0`, differ from the head, and have degree at most the head's, grouping
produces a `NormalPETState`. All the analytic content -- that the actual children of an update do
satisfy those four conditions -- is supplied separately; here nothing is assumed about where the
list came from. -/
noncomputable def petAssemble {r n : ℕ} {ι : Type*} {f : ι}
    [DecidableEq (Polynomial (Fin n → MvPolynomial (Fin r) ℝ))]
    (spat : List (PetFactor r n ι))
    (hdPoly : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)) (hdFac : PetFactor r n ι)
    (l : List (Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι)))
    (horigin : hdFac.origin = f)
    (hd0 : hdPoly ≠ 0) (hdv : hdPoly.coeff 0 = 0)
    (hl0 : ∀ it ∈ l, it.1 ≠ 0) (hlv : ∀ it ∈ l, it.1.coeff 0 = 0)
    (hlh : ∀ it ∈ l, it.1 ≠ hdPoly)
    (hlm : ∀ it ∈ l, it.1.natDegree ≤ hdPoly.natDegree) :
    NormalPETState r n ι f where
  spatial := spat
  headPoly := hdPoly
  headFactor := hdFac
  rest := petGroup l
  head_origin := horigin
  headPoly_ne_zero := hd0
  headPoly_vanish := hdv
  rest_ne_zero := petGroup_property (fun x => x ≠ 0) hl0
  rest_vanish := petGroup_property (fun x => x.coeff 0 = 0) hlv
  rest_ne_head := petGroup_property (fun x => x ≠ hdPoly) hlh
  rest_nodup := petGroup_nodup l
  head_max := petGroup_property (fun x => x.natDegree ≤ hdPoly.natDegree) hlm


/-- The single factor of the new head block: the old head factor, conjugated by the shift and
translated by the constant term that was subtracted. -/
noncomputable def petNewHeadFactor {r n : ℕ} {ι : Type*} {f : ι}
    (u : Fin n → MvPolynomial (Fin r) ℝ) (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    (S : NormalPETState r n ι f) : PetFactor r n ι :=
  (S.headFactor.starFac).shiftFac (((Polynomial.taylor u) S.headPoly - Qp).coeff 0)

/-- It is still a copy of the protected input. -/
@[simp] theorem petNewHeadFactor_origin {r n : ℕ} {ι : Type*} {f : ι}
    (u : Fin n → MvPolynomial (Fin r) ℝ) (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    (S : NormalPETState r n ι f) : (petNewHeadFactor u Qp S).origin = f := by
  simp [petNewHeadFactor, S.head_origin]

open scoped Classical in
/-- The children that remain in the list: everything but the new head, with the constant ones
already removed into the spatial block. -/
noncomputable def petNonConstChildren {r n : ℕ} {ι : Type*} {f : ι}
    (u : Fin n → MvPolynomial (Fin r) ℝ) (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    (S : NormalPETState r n ι f) :
    List (Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι)) :=
  ((petNormalized u Qp S).tail).filter fun it => decide (it.1 ≠ 0)

theorem petNonConstChildren_ne_zero {r n : ℕ} {ι : Type*} {f : ι}
    (u : Fin n → MvPolynomial (Fin r) ℝ) (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    (S : NormalPETState r n ι f) : ∀ it ∈ petNonConstChildren u Qp S, it.1 ≠ 0 := by
  intro it hit
  rw [petNonConstChildren, List.mem_filter] at hit
  exact of_decide_eq_true hit.2

theorem petNonConstChildren_coeff_zero {r n : ℕ} {ι : Type*} {f : ι}
    (u : Fin n → MvPolynomial (Fin r) ℝ) (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    (S : NormalPETState r n ι f) :
    ∀ it ∈ petNonConstChildren u Qp S, it.1.coeff 0 = 0 := by
  intro it hit
  rw [petNonConstChildren, List.mem_filter] at hit
  exact petNormalized_coeff_zero u Qp S it (List.mem_of_mem_tail hit.1)

/-- **`petUpdate_protected`, the bookkeeping half.**

Under the patch's hypothesis that the shifted head has maximum degree -- and that it is nonzero and
differs from the other children, which the invariant supplies -- the update returns a
`NormalPETState` whose head is the shifted head, whose spatial block is the constant children, and
whose remaining list is the grouping of the rest.

"its head block is a singleton of origin `f`" is structural: the state type carries a single
`headFactor`, and `Auto.petNewHeadFactor_origin` is the origin claim. -/
theorem petUpdate_protected {r n : ℕ} {ι : Type*} {f : ι}
    [DecidableEq (Polynomial (Fin n → MvPolynomial (Fin r) ℝ))]
    (u : Fin n → MvPolynomial (Fin r) ℝ) (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    (S : NormalPETState r n ι f)
    (hd0 : (petNewHead u Qp S).1 ≠ 0)
    (hne : ∀ it ∈ petNonConstChildren u Qp S, it.1 ≠ (petNewHead u Qp S).1)
    (hmax : ∀ it ∈ petNonConstChildren u Qp S,
      it.1.natDegree ≤ (petNewHead u Qp S).1.natDegree) :
    ∃ S' : NormalPETState r n ι f,
      S'.spatial = petNewSpatial u Qp S ∧
      S'.headPoly = (petNewHead u Qp S).1 ∧
      S'.headFactor = petNewHeadFactor u Qp S ∧
      S'.rest = petGroup (petNonConstChildren u Qp S) :=
  ⟨petAssemble (petNewSpatial u Qp S) ((petNewHead u Qp S).1) (petNewHeadFactor u Qp S)
      (petNonConstChildren u Qp S) (petNewHeadFactor_origin u Qp S) hd0
      (petNewHead_coeff_zero u Qp S)
      (petNonConstChildren_ne_zero u Qp S) (petNonConstChildren_coeff_zero u Qp S) hne hmax,
    rfl, rfl, rfl, rfl⟩


/-- The children list after the new head has been taken off the front: the unshifted head child,
then both children of every other item.  "putting the shifted head first" is what makes the tail
exactly this. -/
theorem petNormalized_tail_eq {r n : ℕ} {ι : Type*} {f : ι}
    (u : Fin n → MvPolynomial (Fin r) ℝ) (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    (S : NormalPETState r n ι f) :
    (petNormalized u Qp S).tail
      = petNormalizeItem (S.headPoly - Qp, [S.headFactor])
          :: (S.rest.flatMap (petChildren u Qp)).map petNormalizeItem := by
  simp [petNormalized, petRawChildren, petAllItems, petChildren]

/-- **Every remaining child is one of three explicit things.** This is the case analysis the
distinctness argument of `patch:pet-update` runs over: the unshifted head child, a shifted child of
another item, or an unshifted child of another item. -/
theorem mem_petNonConstChildren {r n : ℕ} {ι : Type*} {f : ι}
    (u : Fin n → MvPolynomial (Fin r) ℝ) (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    (S : NormalPETState r n ι f)
    {it : Polynomial (Fin n → MvPolynomial (Fin r) ℝ) × List (PetFactor r n ι)}
    (h : it ∈ petNonConstChildren u Qp S) :
    it = petNormalizeItem (S.headPoly - Qp, [S.headFactor]) ∨
      ∃ jt ∈ S.rest,
        (it = petNormalizeItem ((Polynomial.taylor u) jt.1 - Qp,
              jt.2.map PetFactor.starFac)
          ∨ it = petNormalizeItem (jt.1 - Qp, jt.2)) := by
  rw [petNonConstChildren, List.mem_filter] at h
  have h1 := h.1
  rw [petNormalized_tail_eq, List.mem_cons] at h1
  rcases h1 with h1 | h1
  · exact Or.inl h1
  · rw [List.mem_map] at h1
    obtain ⟨ct, hct, rfl⟩ := h1
    rw [List.mem_flatMap] at hct
    obtain ⟨jt, hjt, hct2⟩ := hct
    refine Or.inr ⟨jt, hjt, ?_⟩
    rw [petChildren, List.mem_cons] at hct2
    rcases hct2 with h2 | h2
    · exact Or.inl (by rw [h2])
    · rw [List.mem_cons] at h2
      rcases h2 with h3 | h3
      · exact Or.inr (by rw [h3])
      · simp at h3


/-- **The invariant's data with the fresh indeterminate excluded.**

`patch:lead-invariant` itself says nothing about the update's new variable: freshness is a property
of the *step*, not of the state. So the update's hypotheses need the invariant in a form that
exposes the witness, with `iu` avoided. Nonvanishing of the witness is not required here -- the
differences `Q_1 - Q_i` may legitimately have a zero witness, and
`Auto.petLead_add_fresh` never needed one. -/
def PetLeadData {r n : ℕ} (a : ℝ) (m : Fin n) (iu : Fin r) (k : ℕ)
    (v : Fin n → MvPolynomial (Fin r) ℝ) : Prop :=
  ∃ p : MvPolynomial (Fin r) ℤ, p.IsHomogeneous k ∧ (∀ i, p.degreeOf i ≤ 1) ∧
    iu ∉ p.vars ∧ v = Pi.single m (MvPolynomial.C a * p.map (Int.castRingHom ℝ))

/-- The zero vector carries the data, with witness `0`. This is what covers both the patch's
`p = 1` case -- where the compared child is the head itself, so the difference is zero -- and every
child whose difference from the head has degree below `d - 1`. -/
theorem petLeadData_zero {r n : ℕ} (a : ℝ) (m : Fin n) (iu : Fin r) (k : ℕ) :
    PetLeadData a m iu k (0 : Fin n → MvPolynomial (Fin r) ℝ) := by
  refine ⟨0, MvPolynomial.isHomogeneous_zero _ _ _, fun i => ?_, ?_, ?_⟩
  · simp
  · simp
  · simp

open Polynomial in
/-- **The case "the degrees of the two summands differ, take the larger".**

If the old difference `Q_1 - Q_i` already has the head's degree, then it dominates the finite
difference, the compared children differ at degree `d`, and no invariant data is needed. -/
theorem petNewHead_ne_child_highDeg {r n : ℕ}
    (u : Fin n → MvPolynomial (Fin r) ℝ) (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    {Q1 Qi : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)} {e : ℕ}
    (hQ1 : Q1.natDegree = e + 1) (hdiff : (Q1 - Qi).natDegree = e + 1) :
    petSubConst ((taylor u) Q1 - Qp) ≠ petSubConst (Qi - Qp) := by
  have hne0 : Q1 - Qi ≠ 0 := by
    intro h0
    rw [h0] at hdiff
    simp at hdiff
  have hc : (((taylor u) Q1 - Qp) - (Qi - Qp)).coeff (e + 1)
      = (Q1 - Qi).coeff (e + 1) := by
    rw [taylor_sub_pivot_sub, Polynomial.coeff_add,
      Polynomial.coeff_eq_zero_of_natDegree_lt
        (lt_of_le_of_lt (natDegree_taylor_sub_self_le Q1 u hQ1) (Nat.lt_succ_self e)),
      zero_add]
  have hnz : (((taylor u) Q1 - Qp) - (Qi - Qp)).coeff (e + 1) ≠ 0 := by
    rw [hc, ← hdiff]
    exact Polynomial.leadingCoeff_ne_zero.mpr hne0
  refine petSubConst_ne_of_natDegree_pos ?_
  have hle := Polynomial.le_natDegree_of_ne_zero hnz
  omega

open Polynomial in
/-- **The head differs from every unshifted child, with no case left out.**

The two branches are the patch's: if the old difference already has the head's degree, the larger
summand wins and nothing else is needed; otherwise the leading coefficients add and the fresh
indeterminate keeps the sum nonzero. -/
theorem petNewHead_ne_child_full {r n : ℕ} {a : ℝ} (ha : a ≠ 0) {m : Fin n} {k : ℕ} {iu : Fin r}
    {e : ℕ} (he : e ≠ 0)
    {Q1 Qi Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)}
    (hQ1 : Q1.natDegree = e + 1)
    (hheadData : ∃ pS : MvPolynomial (Fin r) ℤ, pS ≠ 0 ∧ pS.IsHomogeneous k ∧
      (∀ i, pS.degreeOf i ≤ 1) ∧ iu ∉ pS.vars ∧
      Q1.leadingCoeff = Pi.single m (MvPolynomial.C a * pS.map (Int.castRingHom ℝ)))
    (hdiffData : (Q1 - Qi).natDegree ≠ e + 1 →
      PetLeadData a m iu (k + 1) ((Q1 - Qi).coeff e)) :
    petSubConst ((taylor (fun _ => MvPolynomial.X iu :
        Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qp) ≠ petSubConst (Qi - Qp) := by
  by_cases hdeg : (Q1 - Qi).natDegree = e + 1
  · exact petNewHead_ne_child_highDeg _ Qp hQ1 hdeg
  · obtain ⟨pR, hRhom, hRml, hfR, hReq⟩ := hdiffData hdeg
    obtain ⟨pS, hSne, hShom, hSml, hfS, hSeq⟩ := hheadData
    exact petNewHead_ne_child ha he hQ1 hReq hSeq hRhom hRml hfR hSne hShom hSml hfS


theorem petSubConst_zero {R : Type*} [CommRing R] : petSubConst (0 : Polynomial R) = 0 := by
  simp [petSubConst]

open Polynomial in
/-- **The new head is nonzero.** Compare it with the child of the pivot itself, whose polynomial
is `Q_p - Q_p = 0`: the same argument that separates the head from every child separates it from
zero.  This is why the patch's invariant is retained "for every nonzero `Q_1 - Q_i`, including
`Q_0 = 0`" -- the pivot's own difference is one of the cases. -/
theorem petNewHead_ne_zero {r n : ℕ} {ι : Type*} {f : ι} {a : ℝ} (ha : a ≠ 0) {m : Fin n} {k : ℕ}
    {iu : Fin r} {e : ℕ} (he : e ≠ 0)
    (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)) (S : NormalPETState r n ι f)
    (hQ1 : S.headPoly.natDegree = e + 1)
    (hheadData : ∃ pS : MvPolynomial (Fin r) ℤ, pS ≠ 0 ∧ pS.IsHomogeneous k ∧
      (∀ i, pS.degreeOf i ≤ 1) ∧ iu ∉ pS.vars ∧
      S.headPoly.leadingCoeff = Pi.single m (MvPolynomial.C a * pS.map (Int.castRingHom ℝ)))
    (hpivotData : (S.headPoly - Qp).natDegree ≠ e + 1 →
      PetLeadData a m iu (k + 1) ((S.headPoly - Qp).coeff e)) :
    (petNewHead (fun _ => MvPolynomial.X iu : Fin n → MvPolynomial (Fin r) ℝ) Qp S).1 ≠ 0 := by
  have h := petNewHead_ne_child_full (Qi := Qp) (Qp := Qp) ha he hQ1 hheadData hpivotData
  rw [sub_self, petSubConst_zero] at h
  exact h

open Polynomial in
/-- **The head differs from every remaining child.**

The patch derives this rather than assuming it, and so does this: `Auto.mem_petNonConstChildren`
splits an arbitrary remaining child into the three cases, and the three distinctness lemmas cover
them -- `Auto.petNewHead_ne_child_full` for the unshifted head child (with witness `0`, the
patch's `p = 1` case) and for the unshifted children of other items, and
`Auto.petNewHead_ne_shiftedChild` for the shifted ones. -/
theorem petNewHead_ne_all {r n : ℕ} {ι : Type*} {f : ι} {a : ℝ} (ha : a ≠ 0) {m : Fin n} {k : ℕ}
    {iu : Fin r} {e : ℕ} (he : e ≠ 0)
    (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)) (S : NormalPETState r n ι f)
    (hQ1 : S.headPoly.natDegree = e + 1)
    (hheadData : ∃ pS : MvPolynomial (Fin r) ℤ, pS ≠ 0 ∧ pS.IsHomogeneous k ∧
      (∀ i, pS.degreeOf i ≤ 1) ∧ iu ∉ pS.vars ∧
      S.headPoly.leadingCoeff = Pi.single m (MvPolynomial.C a * pS.map (Int.castRingHom ℝ)))
    (hdiffData : ∀ jt ∈ S.rest, (S.headPoly - jt.1).natDegree ≠ e + 1 →
      PetLeadData a m iu (k + 1) ((S.headPoly - jt.1).coeff e)) :
    ∀ it ∈ petNonConstChildren (fun _ => MvPolynomial.X iu :
        Fin n → MvPolynomial (Fin r) ℝ) Qp S,
      it.1 ≠ (petNewHead (fun _ => MvPolynomial.X iu :
        Fin n → MvPolynomial (Fin r) ℝ) Qp S).1 := by
  intro it hit
  rcases mem_petNonConstChildren _ Qp S hit with hcase | ⟨jt, hjt, hcase⟩
  · subst hcase
    refine Ne.symm ?_
    refine petNewHead_ne_child_full ha he hQ1 hheadData ?_
    intro _
    simpa using petLeadData_zero a m iu (k + 1)
  · rcases hcase with hcase | hcase
    · subst hcase
      refine Ne.symm ?_
      exact petNewHead_ne_shiftedChild _ Qp S.headPoly_vanish (S.rest_vanish jt hjt)
        (Ne.symm (S.rest_ne_head jt hjt))
    · subst hcase
      refine Ne.symm ?_
      exact petNewHead_ne_child_full ha he hQ1 hheadData (hdiffData jt hjt)

open Polynomial in
/-- **`patch:pet-update` in full.**

"Suppose the current head degree is `d >= 2` ... If the shifted head has maximum degree, the new
state is normal, its head block is a singleton of origin `f`, and `patch:lead-invariant` is
preserved."

The only hypothesis besides the invariant data and `d >= 2` is the patch's own: that the shifted
head has maximum degree. Nonvanishing of the new head and its distinctness from every child are
derived, not assumed. -/
theorem petUpdate_protected_of_invariant {r n : ℕ} {ι : Type*} {f : ι}
    [DecidableEq (Polynomial (Fin n → MvPolynomial (Fin r) ℝ))]
    {a : ℝ} (ha : a ≠ 0) {m : Fin n} {k : ℕ} {iu : Fin r} {e : ℕ} (he : e ≠ 0)
    (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)) (S : NormalPETState r n ι f)
    (hQ1 : S.headPoly.natDegree = e + 1)
    (hheadData : ∃ pS : MvPolynomial (Fin r) ℤ, pS ≠ 0 ∧ pS.IsHomogeneous k ∧
      (∀ i, pS.degreeOf i ≤ 1) ∧ iu ∉ pS.vars ∧
      S.headPoly.leadingCoeff = Pi.single m (MvPolynomial.C a * pS.map (Int.castRingHom ℝ)))
    (hpivotData : (S.headPoly - Qp).natDegree ≠ e + 1 →
      PetLeadData a m iu (k + 1) ((S.headPoly - Qp).coeff e))
    (hdiffData : ∀ jt ∈ S.rest, (S.headPoly - jt.1).natDegree ≠ e + 1 →
      PetLeadData a m iu (k + 1) ((S.headPoly - jt.1).coeff e))
    (hmax : ∀ it ∈ petNonConstChildren (fun _ => MvPolynomial.X iu :
        Fin n → MvPolynomial (Fin r) ℝ) Qp S,
      it.1.natDegree ≤ (petNewHead (fun _ => MvPolynomial.X iu :
        Fin n → MvPolynomial (Fin r) ℝ) Qp S).1.natDegree) :
    ∃ S' : NormalPETState r n ι f,
      S'.spatial = petNewSpatial (fun _ => MvPolynomial.X iu :
          Fin n → MvPolynomial (Fin r) ℝ) Qp S ∧
      S'.headPoly = (petNewHead (fun _ => MvPolynomial.X iu :
          Fin n → MvPolynomial (Fin r) ℝ) Qp S).1 ∧
      S'.headFactor = petNewHeadFactor (fun _ => MvPolynomial.X iu :
          Fin n → MvPolynomial (Fin r) ℝ) Qp S ∧
      S'.rest = petGroup (petNonConstChildren (fun _ => MvPolynomial.X iu :
          Fin n → MvPolynomial (Fin r) ℝ) Qp S) :=
  petUpdate_protected _ Qp S
    (petNewHead_ne_zero ha he Qp S hQ1 hheadData hpivotData)
    (petNewHead_ne_all ha he Qp S hQ1 hheadData hdiffData) hmax


open Polynomial in
/-- Removing constant terms cannot raise the degree of a difference. -/
theorem natDegree_petSubConst_sub_le {R : Type*} [CommRing R] (A B : Polynomial R) :
    (petSubConst A - petSubConst B).natDegree ≤ (A - B).natDegree := by
  have h : petSubConst A - petSubConst B
      = (A - B) - Polynomial.C (A.coeff 0 - B.coeff 0) := by
    rw [petSubConst, petSubConst, map_sub]
    ring
  rw [h]
  refine le_trans (Polynomial.natDegree_sub_le _ _) ?_
  simp

open Polynomial in
/-- **`patch:lead-invariant` is preserved.**

The third conclusion of `patch:pet-update`. In the case where the old difference does not already
have the head's degree, the new difference has degree exactly `d - 1`, and its leading coefficient
is `a (p_R + d u p_S) e_m` -- a nonzero integer multilinear polynomial, homogeneous of degree
`D - (d - 1)`, by `Auto.petLead_add_fresh`. The degree bookkeeping is exact: the old head carries
homogeneity `k = D - d`, and the new difference carries `k + 1 = D - (d - 1)`. -/
theorem petUpdate_invariant_diff {r n : ℕ} {a : ℝ} (ha : a ≠ 0) {m : Fin n} {k : ℕ} {iu : Fin r}
    {e : ℕ} (he : e ≠ 0)
    {Q1 Qi Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)}
    (hQ1 : Q1.natDegree = e + 1) (hdegle : (Q1 - Qi).natDegree ≤ e)
    {pR pS : MvPolynomial (Fin r) ℤ}
    (hR : (Q1 - Qi).coeff e
      = Pi.single m (MvPolynomial.C a * pR.map (Int.castRingHom ℝ)))
    (hS : Q1.leadingCoeff
      = Pi.single m (MvPolynomial.C a * pS.map (Int.castRingHom ℝ)))
    (hRhom : pR.IsHomogeneous (k + 1)) (hRml : ∀ i, pR.degreeOf i ≤ 1) (hfR : iu ∉ pR.vars)
    (hSne : pS ≠ 0) (hShom : pS.IsHomogeneous k) (hSml : ∀ i, pS.degreeOf i ≤ 1)
    (hfS : iu ∉ pS.vars) :
    ProtectedLeadingInvariant a m (k + e + 1)
      (petSubConst ((taylor (fun _ => MvPolynomial.X iu :
          Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qp) - petSubConst (Qi - Qp)) := by
  have hcoeff : (petSubConst ((taylor (fun _ => MvPolynomial.X iu :
          Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qp) - petSubConst (Qi - Qp)).coeff e
      = Pi.single m (MvPolynomial.C a
          * ((pR + MvPolynomial.C ((e + 1 : ℕ) : ℤ) * MvPolynomial.X iu * pS).map
              (Int.castRingHom ℝ))) := by
    rw [petSubConst_sub_coeff _ _ he]
    exact coeff_petChild_unshifted_vec hQ1 hR hS
  obtain ⟨hne, hhom, hml⟩ :=
    petLead_add_fresh (d := e + 1) (by omega) hRhom hRml hSne hShom hSml hfR hfS
  have hnz : (petSubConst ((taylor (fun _ => MvPolynomial.X iu :
          Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qp) - petSubConst (Qi - Qp)).coeff e ≠ 0 := by
    rw [hcoeff]
    exact leadVec_ne_zero ha m hne
  have hle := le_trans (natDegree_petSubConst_sub_le
      ((taylor (fun _ => MvPolynomial.X iu : Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qp)
      (Qi - Qp))
    (natDegree_petChild_unshifted_le Q1 Qi Qp _ hQ1 hdegle)
  have hge := Polynomial.le_natDegree_of_ne_zero hnz
  have hdeg : (petSubConst ((taylor (fun _ => MvPolynomial.X iu :
      Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qp) - petSubConst (Qi - Qp)).natDegree = e :=
    le_antisymm hle hge
  refine ⟨pR + MvPolynomial.C ((e + 1 : ℕ) : ℤ) * MvPolynomial.X iu * pS, hne, ?_, hml, ?_⟩
  · rw [hdeg, show k + e + 1 - e = k + 1 by omega]
    exact hhom
  · simp only [Polynomial.leadingCoeff, hdeg]
    exact hcoeff

open Polynomial in
/-- The new head's own invariant is the case of the pivot's child, whose polynomial is zero. -/
theorem petUpdate_invariant_head {r n : ℕ} {a : ℝ} (ha : a ≠ 0) {m : Fin n} {k : ℕ} {iu : Fin r}
    {e : ℕ} (he : e ≠ 0)
    {Q1 Qpiv : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)}
    (hQ1 : Q1.natDegree = e + 1) (hdegle : (Q1 - Qpiv).natDegree ≤ e)
    {pR pS : MvPolynomial (Fin r) ℤ}
    (hR : (Q1 - Qpiv).coeff e
      = Pi.single m (MvPolynomial.C a * pR.map (Int.castRingHom ℝ)))
    (hS : Q1.leadingCoeff
      = Pi.single m (MvPolynomial.C a * pS.map (Int.castRingHom ℝ)))
    (hRhom : pR.IsHomogeneous (k + 1)) (hRml : ∀ i, pR.degreeOf i ≤ 1) (hfR : iu ∉ pR.vars)
    (hSne : pS ≠ 0) (hShom : pS.IsHomogeneous k) (hSml : ∀ i, pS.degreeOf i ≤ 1)
    (hfS : iu ∉ pS.vars) :
    ProtectedLeadingInvariant a m (k + e + 1)
      (petSubConst ((taylor (fun _ => MvPolynomial.X iu :
          Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qpiv)) := by
  have h := petUpdate_invariant_diff (Qi := Qpiv) (Qp := Qpiv) ha he hQ1 hdegle hR hS hRhom hRml
    hfR hSne hShom hSml hfS
  rwa [sub_self, petSubConst_zero, sub_zero] at h


open Polynomial in
/-- **`patch:lead-invariant` is preserved, the other branch.**

"If the degrees of the two summands differ, take the larger."  When the old difference already has
the head's degree it dominates the finite difference, the new difference has the same degree, and
the old witness carries over unchanged -- with the same homogeneity, since the degree did not
move. -/
theorem petUpdate_invariant_diff_highDeg {r n : ℕ} {a : ℝ} (ha : a ≠ 0) {m : Fin n} {k : ℕ}
    {iu : Fin r} {e : ℕ}
    {Q1 Qi Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)}
    (hQ1 : Q1.natDegree = e + 1) (hdeg : (Q1 - Qi).natDegree = e + 1)
    {pR : MvPolynomial (Fin r) ℤ}
    (hR : (Q1 - Qi).leadingCoeff
      = Pi.single m (MvPolynomial.C a * pR.map (Int.castRingHom ℝ)))
    (hRne : pR ≠ 0) (hRhom : pR.IsHomogeneous k) (hRml : ∀ i, pR.degreeOf i ≤ 1) :
    ProtectedLeadingInvariant a m (k + e + 1)
      (petSubConst ((taylor (fun _ => MvPolynomial.X iu :
          Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qp) - petSubConst (Qi - Qp)) := by
  have hlead : (Q1 - Qi).coeff (e + 1) = (Q1 - Qi).leadingCoeff := by
    simp only [Polynomial.leadingCoeff, hdeg]
  have hcoeff : (petSubConst ((taylor (fun _ => MvPolynomial.X iu :
          Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qp) - petSubConst (Qi - Qp)).coeff (e + 1)
      = (Q1 - Qi).coeff (e + 1) := by
    rw [petSubConst_sub_coeff _ _ (Nat.succ_ne_zero e), taylor_sub_pivot_sub,
      Polynomial.coeff_add,
      Polynomial.coeff_eq_zero_of_natDegree_lt
        (lt_of_le_of_lt (natDegree_taylor_sub_self_le Q1 _ hQ1) (Nat.lt_succ_self e)),
      zero_add]
  have hnz : (petSubConst ((taylor (fun _ => MvPolynomial.X iu :
          Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qp) - petSubConst (Qi - Qp)).coeff (e + 1)
      ≠ 0 := by
    rw [hcoeff, hlead, hR]
    exact leadVec_ne_zero ha m hRne
  have hle : (petSubConst ((taylor (fun _ => MvPolynomial.X iu :
      Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qp) - petSubConst (Qi - Qp)).natDegree ≤ e + 1 := by
    refine le_trans (natDegree_petSubConst_sub_le _ _) ?_
    rw [taylor_sub_pivot_sub]
    refine le_trans (Polynomial.natDegree_add_le _ _) ?_
    rw [hdeg]
    exact max_le (le_trans (natDegree_taylor_sub_self_le Q1 _ hQ1) (Nat.le_succ e)) le_rfl
  have hge := Polynomial.le_natDegree_of_ne_zero hnz
  have hdeg' : (petSubConst ((taylor (fun _ => MvPolynomial.X iu :
      Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qp) - petSubConst (Qi - Qp)).natDegree = e + 1 :=
    le_antisymm hle hge
  refine ⟨pR, hRne, ?_, hRml, ?_⟩
  · rw [hdeg', show k + e + 1 - (e + 1) = k by omega]
    exact hRhom
  · simp only [Polynomial.leadingCoeff, hdeg']
    rw [hcoeff, hlead, hR]


/-! ## `blueprints/task_2_patch_3_updated.tex`, stage 3: accumulation of the removal losses

`patch:cs-loss` is a scalar statement: a chain of `T` Cauchy-Schwarz steps, each squaring and
losing `2H/N`, ends at a nonnegative cube power `Q`, and the accumulated loss is `c_T (Q + T H/N)`
with `c_T = 2^(2^T - 1)`. The map being iterated is `phi(x) = x^2/2`; the whole content is that
`phi` is monotone and `1`-Lipschitz on `[0,1]`, so the per-step errors add rather than compound. -/

/-- The map iterated by `patch:cs-loss`. -/
noncomputable def csPhi (x : ℝ) : ℝ := x ^ 2 / 2

theorem csPhi_nonneg (x : ℝ) : 0 ≤ csPhi x := by
  rw [csPhi]
  positivity

theorem csPhi_le_one {x : ℝ} (hx0 : 0 ≤ x) (hx1 : x ≤ 1) : csPhi x ≤ 1 := by
  rw [csPhi]
  nlinarith

theorem csPhi_mono {x y : ℝ} (hx : 0 ≤ x) (h : x ≤ y) : csPhi x ≤ csPhi y := by
  rw [csPhi, csPhi]
  nlinarith

/-- **`phi` is `1`-Lipschitz on `[0,1]`**, the patch's "`|phi(x) - phi(y)| <= |x-y|`", proved in
the one-sided form the induction uses via `(x^2 - y^2)/2 = (x-y)(x+y)/2`. Nonnegativity of the
arguments is not needed: only that they are at most one. -/
theorem csPhi_lipschitz {x y : ℝ} (hx1 : x ≤ 1) (hy1 : y ≤ 1) (h : y ≤ x) :
    csPhi x - csPhi y ≤ x - y := by
  rw [csPhi, csPhi]
  nlinarith

theorem csPhi_iter_nonneg (r : ℕ) {x : ℝ} (hx : 0 ≤ x) : 0 ≤ csPhi^[r] x := by
  induction r with
  | zero => simpa using hx
  | succ r ih =>
      rw [Function.iterate_succ_apply']
      exact csPhi_nonneg _

theorem csPhi_iter_le_one (r : ℕ) {x : ℝ} (hx0 : 0 ≤ x) (hx1 : x ≤ 1) : csPhi^[r] x ≤ 1 := by
  induction r with
  | zero => simpa using hx1
  | succ r ih =>
      rw [Function.iterate_succ_apply']
      exact csPhi_le_one (csPhi_iter_nonneg r hx0) ih


/-- **`phi^T(x) = x^(2^T)/c_T`** with `c_T = 2^(2^T - 1)`, written as `2^(2^T)/2` so that no
natural subtraction appears. -/
theorem csPhi_iter_eq (r : ℕ) (x : ℝ) : csPhi^[r] x = 2 * x ^ (2 ^ r) / 2 ^ (2 ^ r) := by
  induction r with
  | zero => simp
  | succ r ih =>
      rw [Function.iterate_succ_apply', ih, csPhi]
      have hne : ((2 : ℝ) ^ (2 ^ r)) ≠ 0 := by positivity
      have he : (2 : ℕ) ^ (r + 1) = 2 ^ r + 2 ^ r := by ring
      rw [he, pow_add, pow_add]
      field_simp

/-- **`patch:cs-loss`: explicit accumulation of the removal losses.**

A chain of `T` steps with `phi(M_r) <= M_{r+1} + delta` and all `M_r` in `[0,1]`, ending at
`M_T <= Q`, satisfies
    M_0 ^ (2^T) <= c_T (Q + T delta), c_T = 2^(2^T) / 2 = 2^(2^T - 1).

The patch's `delta` is `H/N`, its per-step error `2H/N` being `phi`'s form of the same thing. The
whole content is that `phi` is monotone and `1`-Lipschitz on `[0,1]`, so the `T` errors add rather
than compound; the proof is the patch's own "split into `phi^r(M_0) <= M_r` or its reverse". -/
theorem csLoss {T : ℕ} {M : ℕ → ℝ} {δ Q : ℝ} (hδ : 0 ≤ δ)
    (hM0 : ∀ r, 0 ≤ M r) (hM1 : ∀ r, M r ≤ 1)
    (hrec : ∀ r, r < T → csPhi (M r) ≤ M (r + 1) + δ)
    (hlast : M T ≤ Q) :
    M 0 ^ (2 ^ T) ≤ 2 ^ (2 ^ T) / 2 * (Q + T * δ) := by
  have key : ∀ r, r ≤ T → csPhi^[r] (M 0) ≤ M r + r * δ := by
    intro r
    induction r with
    | zero =>
        intro _
        simp
    | succ r ih =>
        intro hr
        have hstep := ih (by omega)
        have h0 : 0 ≤ csPhi^[r] (M 0) := csPhi_iter_nonneg r (hM0 0)
        have h1 : csPhi^[r] (M 0) ≤ 1 := csPhi_iter_le_one r (hM0 0) (hM1 0)
        have hrc := hrec r (by omega)
        have hrδ : 0 ≤ (r : ℝ) * δ := by positivity
        rw [Function.iterate_succ_apply']
        rcases le_total (csPhi^[r] (M 0)) (M r) with hc | hc
        · have hmono := csPhi_mono h0 hc
          push_cast
          linarith
        · have hlip := csPhi_lipschitz h1 (hM1 r) hc
          push_cast
          linarith
  have hT := key T le_rfl
  rw [csPhi_iter_eq] at hT
  have h2 : (0 : ℝ) < 2 ^ (2 ^ T) := by positivity
  rw [div_le_iff₀ h2] at hT
  have hQ : M T + (T : ℝ) * δ ≤ Q + (T : ℝ) * δ := by linarith
  have hstep2 : (M T + (T : ℝ) * δ) * 2 ^ (2 ^ T) ≤ (Q + (T : ℝ) * δ) * 2 ^ (2 ^ T) :=
    mul_le_mul_of_nonneg_right hQ h2.le
  linarith


/-! ## `blueprints/task_2_patch_3_updated.tex`, stage 3: the sublevel estimate

`patch:multiaffine-sublevel` bounds `Pr{|p(u)| <= eps}` by `4 sqrt eps` for a nonzero multilinear
integer polynomial of degree at most two, the coordinates of `u` independent with density
`kappa_1`. Its proof rests on one one-dimensional fact used twice: an affine function with a
nonzero leading coefficient has a small sublevel set, and the Fejer density is at most one
(`Auto.fejer_le_inv` at `H = 1`), so the probability is at most the length. -/

open MeasureTheory in
/-- **The sublevel set of an affine function is an interval of length `2 eps / |c|`.**

This is the patch's "the sublevel interval has length at most `2 eps`" in its quantitative form;
the division by `|c|` is what makes the quadratic case work, where `c` is the value of the linear
factor `A` and is bounded below by `sqrt eps` off a small set. -/
theorem volume_abs_affine {c b ε : ℝ} (hc : c ≠ 0) :
    volume {t : ℝ | |c * t + b| ≤ ε} = ENNReal.ofReal (2 * ε / |c|) := by
  have hset : {t : ℝ | |c * t + b| ≤ ε}
      = (fun t : ℝ => c * t) ⁻¹' ((fun x : ℝ => b + x) ⁻¹' (Set.Icc (-ε) ε)) := by
    ext t
    simp only [Set.mem_ofPred_eq, Set.mem_preimage, Set.mem_Icc, abs_le]
    constructor
    · rintro ⟨h1, h2⟩
      exact ⟨by linarith, by linarith⟩
    · rintro ⟨h1, h2⟩
      exact ⟨by linarith, by linarith⟩
  rw [hset, Real.volume_preimage_mul_left hc, measure_preimage_add, Real.volume_Icc,
    ← ENNReal.ofReal_mul (abs_nonneg _)]
  congr 1
  rw [abs_inv]
  field_simp
  ring

open MeasureTheory in
/-- **The one-dimensional sublevel bound against the Fejer density.**

`int kappa_1(t) 1[|c t + b| <= eps] dt <= 2 eps / |c|`: the density is at most one, so the
integral is at most the length of the sublevel interval. Used twice in
`patch:multiaffine-sublevel` -- once for the linear case and once, with `c = A(u')`, for the
conditional probability in the quadratic case. -/
theorem integral_fejer_indicator_abs_affine_le {c b ε : ℝ} (hc : c ≠ 0) (hε : 0 ≤ ε) :
    (∫ t : ℝ, Set.indicator {t : ℝ | |c * t + b| ≤ ε} (fun t => fejer 1 t) t)
      ≤ 2 * ε / |c| := by
  have hmeas : MeasurableSet {t : ℝ | |c * t + b| ≤ ε} := by
    have hcont : Continuous fun t : ℝ => |c * t + b| :=
      ((continuous_const.mul continuous_id).add continuous_const).abs
    exact (isClosed_le hcont continuous_const).measurableSet
  have hfin : volume {t : ℝ | |c * t + b| ≤ ε} ≠ ⊤ := by
    rw [volume_abs_affine hc]
    exact ENNReal.ofReal_ne_top
  have hbound : ∀ t : ℝ, Set.indicator {t : ℝ | |c * t + b| ≤ ε} (fun t => fejer 1 t) t
      ≤ Set.indicator {t : ℝ | |c * t + b| ≤ ε} (fun _ => (1 : ℝ)) t := by
    intro t
    by_cases ht : t ∈ {t : ℝ | |c * t + b| ≤ ε}
    · rw [Set.indicator_of_mem ht, Set.indicator_of_mem ht]
      simpa using fejer_le_inv one_pos t
    · rw [Set.indicator_of_notMem ht, Set.indicator_of_notMem ht]
  have hint1 : Integrable (Set.indicator {t : ℝ | |c * t + b| ≤ ε} fun t => fejer 1 t) :=
    (integrable_fejer one_pos).indicator hmeas
  have hint2 : Integrable (Set.indicator {t : ℝ | |c * t + b| ≤ ε} fun _ : ℝ => (1 : ℝ)) := by
    rw [integrable_indicator_iff hmeas]
    exact Measure.integrableOn_of_bounded (M := 1) hfin aestronglyMeasurable_const
      (Filter.Eventually.of_forall fun x => by norm_num)
  calc (∫ t : ℝ, Set.indicator {t : ℝ | |c * t + b| ≤ ε} (fun t => fejer 1 t) t)
      ≤ ∫ t : ℝ, Set.indicator {t : ℝ | |c * t + b| ≤ ε} (fun _ => (1 : ℝ)) t :=
        integral_mono hint1 hint2 hbound
    _ = 2 * ε / |c| := by
        rw [integral_indicator hmeas, setIntegral_const, smul_eq_mul, mul_one]
        have hreal : volume.real {t : ℝ | |c * t + b| ≤ ε}
            = (volume {t : ℝ | |c * t + b| ≤ ε}).toReal := rfl
        rw [hreal, volume_abs_affine hc, ENNReal.toReal_ofReal (by positivity)]


/-- The sublevel set of an affine function is closed, hence measurable. -/
theorem measurableSet_abs_affine (c b ε : ℝ) : MeasurableSet {t : ℝ | |c * t + b| ≤ ε} := by
  have hcont : Continuous fun t : ℝ => |c * t + b| :=
    ((continuous_const.mul continuous_id).add continuous_const).abs
  exact (isClosed_le hcont continuous_const).measurableSet

open MeasureTheory in
/-- **The Fejer distribution `kappa_1`**, the law of each coordinate of `u` in
`patch:multiaffine-sublevel`. -/
noncomputable def fejerMeasure : Measure ℝ :=
  volume.withDensity fun t => ENNReal.ofReal (fejer 1 t)

open MeasureTheory in
theorem fejerMeasure_apply {s : Set ℝ} (hs : MeasurableSet s) :
    fejerMeasure s = ∫⁻ t in s, ENNReal.ofReal (fejer 1 t) :=
  withDensity_apply _ hs

open MeasureTheory in
instance isProbabilityMeasure_fejerMeasure : IsProbabilityMeasure fejerMeasure := by
  constructor
  rw [fejerMeasure, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ,
    ← ofReal_integral_eq_lintegral_ofReal (integrable_fejer one_pos)
      (Filter.Eventually.of_forall (fejer_nonneg one_pos)), integral_fejer one_pos]
  simp

open MeasureTheory in
/-- **"`kappa_1 <= 1`"**: the Fejer law is dominated by Lebesgue measure, so a probability is at
most a length. This is the step that makes the sublevel estimate elementary. -/
theorem fejerMeasure_le_volume {s : Set ℝ} (hs : MeasurableSet s) :
    fejerMeasure s ≤ volume s := by
  rw [fejerMeasure_apply hs]
  calc (∫⁻ t in s, ENNReal.ofReal (fejer 1 t)) ≤ ∫⁻ _ in s, 1 := by
        refine lintegral_mono fun t => ?_
        have h := fejer_le_inv one_pos t
        rw [inv_one] at h
        exact ENNReal.ofReal_le_one.mpr h
    _ = volume s := by simp

open MeasureTheory in
/-- **The sublevel estimate for one affine function**, in the probabilistic form
`patch:multiaffine-sublevel` uses: `Pr{|c u + b| <= eps} <= 2 eps / |c|`. -/
theorem fejerMeasure_abs_affine_le {c b ε : ℝ} (hc : c ≠ 0) :
    fejerMeasure {t : ℝ | |c * t + b| ≤ ε} ≤ ENNReal.ofReal (2 * ε / |c|) := by
  calc fejerMeasure {t : ℝ | |c * t + b| ≤ ε}
      ≤ volume {t : ℝ | |c * t + b| ≤ ε} := fejerMeasure_le_volume (measurableSet_abs_affine c b ε)
    _ = ENNReal.ofReal (2 * ε / |c|) := volume_abs_affine hc


/-- `2 eps / sqrt eps = 2 sqrt eps`, the step that turns the conditional bound `2 eps / |A|` of
`patch:multiaffine-sublevel` into `2 sqrt eps` on the event `|A| >= sqrt eps`. -/
theorem two_mul_div_sqrt {ε : ℝ} (hε : 0 < ε) :
    2 * ε / Real.sqrt ε = 2 * Real.sqrt ε := by
  have hs : Real.sqrt ε ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr hε)
  have hsq : Real.sqrt ε * Real.sqrt ε = ε := Real.mul_self_sqrt hε.le
  field_simp
  linarith [hsq]

open MeasureTheory in
/-- **Splitting a product measure at the last coordinate, for sets.**

The measure counterpart of `Auto.integral_pi_fin_last`: the measure of a set of `Fin (n+1)`-tuples
is the product measure of its `Fin.snoc` description. This is what turns
`patch:multiaffine-sublevel`'s conditioning on all but one coordinate into Fubini. -/
theorem measure_pi_fin_last {B : Type*} [MeasurableSpace B] (ν : Measure B) [SigmaFinite ν]
    {n : ℕ} (s : Set (Fin (n + 1) → B)) :
    (Measure.pi fun _ : Fin (n + 1) => ν) s
      = (ν.prod (Measure.pi fun _ : Fin n => ν))
          {p : B × (Fin n → B) | (Fin.snoc p.2 p.1 : Fin (n + 1) → B) ∈ s} := by
  have hsymm : ∀ p : B × (Fin n → B),
      (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => B) (Fin.last n)).symm p
        = (Fin.snoc p.2 p.1 : Fin (n + 1) → B) := by
    intro p
    simp [MeasurableEquiv.piFinSuccAbove]
    rfl
  have h := (MeasurePreserving.symm _ (measurePreserving_piFinLast ν n)).measure_preimage_emb
    (MeasurableEquiv.measurableEmbedding _) s
  rw [← h]
  congr 1
  ext p
  simp only [Set.mem_preimage, Set.mem_ofPred_eq, hsymm]


open MeasureTheory in
/-- **The conditioning step of `patch:multiaffine-sublevel`.**

"The probability `|A| <= sqrt eps` is at most `2 sqrt eps` by the linear case.  On its complement,
the conditional sublevel probability in `u_r` is at most `2 eps / |A| <= 2 sqrt eps`."

Stated with the good event `G` and the lower bound `K` on `|A|` abstract, so that the linear case
supplies `G = {|A| > sqrt eps}`, `K = sqrt eps` and `q = 2 sqrt eps`. The conclusion is then
`2 sqrt eps + 2 eps / sqrt eps = 4 sqrt eps` by `Auto.two_mul_div_sqrt`. -/
theorem fejerPi_snoc_sublevel_le {r : ℕ} {A B : (Fin r → ℝ) → ℝ}
    (hA : Measurable A) (hB : Measurable B) {ε K q : ℝ} (hε : 0 ≤ ε) (hK : 0 < K)
    {G : Set (Fin r → ℝ)} (hG : MeasurableSet G)
    (hAK : ∀ u' ∈ G, K ≤ |A u'|)
    (hq : (Measure.pi fun _ : Fin r => fejerMeasure) Gᶜ ≤ ENNReal.ofReal q) :
    (Measure.pi fun _ : Fin (r + 1) => fejerMeasure)
        {u : Fin (r + 1) → ℝ |
          |A (fun j => u j.castSucc) * u (Fin.last r) + B (fun j => u j.castSucc)| ≤ ε}
      ≤ ENNReal.ofReal q + ENNReal.ofReal (2 * ε / K) := by
  classical
  rw [measure_pi_fin_last]
  have hset : {p : ℝ × (Fin r → ℝ) |
      (Fin.snoc p.2 p.1 : Fin (r + 1) → ℝ) ∈
        {u : Fin (r + 1) → ℝ |
          |A (fun j => u j.castSucc) * u (Fin.last r) + B (fun j => u j.castSucc)| ≤ ε}}
      = {p : ℝ × (Fin r → ℝ) | |A p.2 * p.1 + B p.2| ≤ ε} := by
    ext p
    simp
  rw [hset]
  have hm0 : Measurable fun p : ℝ × (Fin r → ℝ) => A p.2 * p.1 + B p.2 :=
    ((hA.comp measurable_snd).mul measurable_fst).add (hB.comp measurable_snd)
  have hm1 : Measurable fun p : ℝ × (Fin r → ℝ) => |A p.2 * p.1 + B p.2| := by
    simpa [Real.norm_eq_abs] using hm0.norm
  have hmeas : MeasurableSet {p : ℝ × (Fin r → ℝ) | |A p.2 * p.1 + B p.2| ≤ ε} :=
    hm1 measurableSet_Iic
  rw [Measure.prod_apply_symm hmeas]
  have hptw : ∀ u' : Fin r → ℝ,
      fejerMeasure ((fun β : ℝ => (β, u')) ⁻¹'
          {p : ℝ × (Fin r → ℝ) | |A p.2 * p.1 + B p.2| ≤ ε})
        ≤ Set.indicator Gᶜ (fun _ => (1 : ℝ≥0∞)) u' + ENNReal.ofReal (2 * ε / K) := by
    intro u'
    have hpre : ((fun β : ℝ => (β, u')) ⁻¹'
        {p : ℝ × (Fin r → ℝ) | |A p.2 * p.1 + B p.2| ≤ ε})
        = {β : ℝ | |A u' * β + B u'| ≤ ε} := rfl
    rw [hpre]
    by_cases hu : u' ∈ G
    · have hnot : u' ∉ Gᶜ := by simpa using hu
      rw [Set.indicator_of_notMem hnot, zero_add]
      have hKA := hAK u' hu
      have hA0 : A u' ≠ 0 := by
        intro h0
        rw [h0] at hKA
        simp at hKA
        linarith
      refine le_trans (fejerMeasure_abs_affine_le hA0) (ENNReal.ofReal_le_ofReal ?_)
      exact div_le_div_of_nonneg_left (by linarith) hK hKA
    · have hmem : u' ∈ Gᶜ := hu
      rw [Set.indicator_of_mem hmem]
      exact le_trans prob_le_one le_self_add
  refine le_trans (lintegral_mono hptw) ?_
  rw [lintegral_add_right _ measurable_const, lintegral_indicator_const hG.compl,
    lintegral_const, measure_univ, mul_one, one_mul]
  exact add_le_add hq le_rfl


open MeasureTheory in
/-- **The linear case of `patch:multiaffine-sublevel`**, at the last coordinate.

"For a nonconstant linear polynomial, fix all but a coordinate with a nonzero integer coefficient.
The sublevel interval has length at most `2 eps`, and `kappa_1 <= 1`."  This is
`Auto.fejerPi_snoc_sublevel_le` with the leading coefficient constant and the good event
everything. -/
theorem fejerPi_linear_sublevel_le {r : ℕ} (a : Fin (r + 1) → ℝ) (b : ℝ)
    (ha : a (Fin.last r) ≠ 0) {ε : ℝ} (hε : 0 ≤ ε) :
    (Measure.pi fun _ : Fin (r + 1) => fejerMeasure)
        {u : Fin (r + 1) → ℝ | |(∑ i, a i * u i) + b| ≤ ε}
      ≤ ENNReal.ofReal (2 * ε / |a (Fin.last r)|) := by
  classical
  have hK : 0 < |a (Fin.last r)| := abs_pos.mpr ha
  have hB : Measurable fun u' : Fin r → ℝ => (∑ j : Fin r, a j.castSucc * u' j) + b := by
    refine Measurable.add ?_ measurable_const
    exact Finset.measurable_sum _ fun j _ => (measurable_pi_apply j).const_mul _
  have hset : {u : Fin (r + 1) → ℝ | |(∑ i, a i * u i) + b| ≤ ε}
      = {u : Fin (r + 1) → ℝ |
          |(fun _ : Fin r → ℝ => a (Fin.last r)) (fun j => u j.castSucc) * u (Fin.last r)
            + (fun u' : Fin r → ℝ => (∑ j : Fin r, a j.castSucc * u' j) + b)
                (fun j => u j.castSucc)| ≤ ε} := by
    ext u
    have hsum : (∑ i, a i * u i) + b
        = a (Fin.last r) * u (Fin.last r)
          + ((∑ j : Fin r, a j.castSucc * u j.castSucc) + b) := by
      rw [Fin.sum_univ_castSucc]
      ring
    simp only [Set.mem_ofPred_eq, hsum]
  rw [hset]
  have h := fejerPi_snoc_sublevel_le (A := fun _ : Fin r → ℝ => a (Fin.last r))
    (B := fun u' : Fin r → ℝ => (∑ j : Fin r, a j.castSucc * u' j) + b)
    measurable_const hB hε hK (G := Set.univ) MeasurableSet.univ
    (fun u' _ => le_rfl) (q := 0) (by simp)
  simpa using h


open MeasureTheory in
/-- **Splitting a product measure at an arbitrary coordinate, for sets.**

The generalization of `Auto.measure_pi_fin_last` needed because the patch's "a coordinate with a
nonzero integer coefficient" is not in general the last one.  At a general index the inverse of
`MeasurableEquiv.piFinSuccAbove` is `Fin.insertNth` definitionally, so no rewriting is needed. -/
theorem measure_pi_fin_succAbove {B : Type*} [MeasurableSpace B] (ν : Measure B) [SigmaFinite ν]
    {n : ℕ} (i : Fin (n + 1)) (s : Set (Fin (n + 1) → B)) :
    (Measure.pi fun _ : Fin (n + 1) => ν) s
      = (ν.prod (Measure.pi fun _ : Fin n => ν))
          {p : B × (Fin n → B) | (i.insertNth p.1 p.2 : Fin (n + 1) → B) ∈ s} := by
  have h := (MeasurePreserving.symm _
      (measurePreserving_piFinSuccAbove (fun _ : Fin (n + 1) => ν) i)).measure_preimage_emb
    (MeasurableEquiv.measurableEmbedding _) s
  rw [← h]
  rfl

open MeasureTheory in
/-- **The conditioning step at an arbitrary coordinate.** `Auto.fejerPi_snoc_sublevel_le` with the
distinguished variable at position `i` rather than last. -/
theorem fejerPi_succAbove_sublevel_le {r : ℕ} (i : Fin (r + 1)) {A B : (Fin r → ℝ) → ℝ}
    (hA : Measurable A) (hB : Measurable B) {ε K q : ℝ} (hε : 0 ≤ ε) (hK : 0 < K)
    {G : Set (Fin r → ℝ)} (hG : MeasurableSet G)
    (hAK : ∀ u' ∈ G, K ≤ |A u'|)
    (hq : (Measure.pi fun _ : Fin r => fejerMeasure) Gᶜ ≤ ENNReal.ofReal q) :
    (Measure.pi fun _ : Fin (r + 1) => fejerMeasure)
        {u : Fin (r + 1) → ℝ |
          |A (fun j => u (i.succAbove j)) * u i + B (fun j => u (i.succAbove j))| ≤ ε}
      ≤ ENNReal.ofReal q + ENNReal.ofReal (2 * ε / K) := by
  classical
  rw [measure_pi_fin_succAbove _ i]
  have hset : {p : ℝ × (Fin r → ℝ) |
      (i.insertNth p.1 p.2 : Fin (r + 1) → ℝ) ∈
        {u : Fin (r + 1) → ℝ |
          |A (fun j => u (i.succAbove j)) * u i + B (fun j => u (i.succAbove j))| ≤ ε}}
      = {p : ℝ × (Fin r → ℝ) | |A p.2 * p.1 + B p.2| ≤ ε} := by
    ext p
    simp
  rw [hset]
  have hm0 : Measurable fun p : ℝ × (Fin r → ℝ) => A p.2 * p.1 + B p.2 :=
    ((hA.comp measurable_snd).mul measurable_fst).add (hB.comp measurable_snd)
  have hm1 : Measurable fun p : ℝ × (Fin r → ℝ) => |A p.2 * p.1 + B p.2| := by
    simpa [Real.norm_eq_abs] using hm0.norm
  have hmeas : MeasurableSet {p : ℝ × (Fin r → ℝ) | |A p.2 * p.1 + B p.2| ≤ ε} :=
    hm1 measurableSet_Iic
  rw [Measure.prod_apply_symm hmeas]
  have hptw : ∀ u' : Fin r → ℝ,
      fejerMeasure ((fun β : ℝ => (β, u')) ⁻¹'
          {p : ℝ × (Fin r → ℝ) | |A p.2 * p.1 + B p.2| ≤ ε})
        ≤ Set.indicator Gᶜ (fun _ => (1 : ℝ≥0∞)) u' + ENNReal.ofReal (2 * ε / K) := by
    intro u'
    have hpre : ((fun β : ℝ => (β, u')) ⁻¹'
        {p : ℝ × (Fin r → ℝ) | |A p.2 * p.1 + B p.2| ≤ ε})
        = {β : ℝ | |A u' * β + B u'| ≤ ε} := rfl
    rw [hpre]
    by_cases hu : u' ∈ G
    · have hnot : u' ∉ Gᶜ := by simpa using hu
      rw [Set.indicator_of_notMem hnot, zero_add]
      have hKA := hAK u' hu
      have hA0 : A u' ≠ 0 := by
        intro h0
        rw [h0] at hKA
        simp at hKA
        linarith
      refine le_trans (fejerMeasure_abs_affine_le hA0) (ENNReal.ofReal_le_ofReal ?_)
      exact div_le_div_of_nonneg_left (by linarith) hK hKA
    · have hmem : u' ∈ Gᶜ := hu
      rw [Set.indicator_of_mem hmem]
      exact le_trans prob_le_one le_self_add
  refine le_trans (lintegral_mono hptw) ?_
  rw [lintegral_add_right _ measurable_const, lintegral_indicator_const hG.compl,
    lintegral_const, measure_univ, mul_one, one_mul]
  exact add_le_add hq le_rfl


/-- **A multilinear polynomial of degree at most two, as explicit integer data**: a constant, a
linear coefficient vector, and a quadratic coefficient matrix with zero diagonal. Every
multilinear integer polynomial of degree at most two is of this form, and
`patch:multiaffine-sublevel` is about exactly these. -/
noncomputable def multiAff {n : ℕ} (c : ℤ) (a : Fin n → ℤ) (b : Fin n → Fin n → ℤ)
    (u : Fin n → ℝ) : ℝ :=
  (c : ℝ) + (∑ k, (a k : ℝ) * u k) + ∑ k, ∑ l, (b k l : ℝ) * (u k * u l)

/-- The leading factor in the variable `u i`: `a i + sum_j (b i j + b j i) u_j`, linear in the
other variables. -/
noncomputable def multiAffLead {n : ℕ} (a : Fin (n + 1) → ℤ)
    (b : Fin (n + 1) → Fin (n + 1) → ℤ) (i : Fin (n + 1)) (u' : Fin n → ℝ) : ℝ :=
  (a i : ℝ) + ∑ j, ((b i (i.succAbove j) : ℝ) + (b (i.succAbove j) i : ℝ)) * u' j

/-- **Splitting off one variable.** With zero diagonal the polynomial is affine in each variable
separately; at the coordinate `i` the leading factor is `Auto.multiAffLead` and the remainder is
again of the same form in the other variables. This is the patch's
`p = A(u') u_r + B(u')`. -/
theorem multiAff_split {n : ℕ} (c : ℤ) (a : Fin (n + 1) → ℤ)
    (b : Fin (n + 1) → Fin (n + 1) → ℤ) (hb : ∀ k, b k k = 0) (i : Fin (n + 1))
    (u : Fin (n + 1) → ℝ) :
    multiAff c a b u
      = multiAffLead a b i (fun j => u (i.succAbove j)) * u i
        + multiAff c (fun j => a (i.succAbove j))
            (fun j l => b (i.succAbove j) (i.succAbove l))
            (fun j => u (i.succAbove j)) := by
  classical
  have hlin : (∑ k, (a k : ℝ) * u k)
      = (a i : ℝ) * u i + ∑ j, (a (i.succAbove j) : ℝ) * u (i.succAbove j) :=
    Fin.sum_univ_succAbove (fun k => (a k : ℝ) * u k) i
  have hrow : (∑ l, (b i l : ℝ) * (u i * u l))
      = ∑ j, (b i (i.succAbove j) : ℝ) * (u i * u (i.succAbove j)) := by
    rw [Fin.sum_univ_succAbove (fun l => (b i l : ℝ) * (u i * u l)) i, hb i]
    simp
  have hinner : ∀ j : Fin n, (∑ l, (b (i.succAbove j) l : ℝ) * (u (i.succAbove j) * u l))
      = (b (i.succAbove j) i : ℝ) * (u (i.succAbove j) * u i)
        + ∑ l, (b (i.succAbove j) (i.succAbove l) : ℝ)
            * (u (i.succAbove j) * u (i.succAbove l)) :=
    fun j => Fin.sum_univ_succAbove
      (fun l => (b (i.succAbove j) l : ℝ) * (u (i.succAbove j) * u l)) i
  have hquad : (∑ k, ∑ l, (b k l : ℝ) * (u k * u l))
      = (∑ j, (b i (i.succAbove j) : ℝ) * (u i * u (i.succAbove j)))
        + ((∑ j, (b (i.succAbove j) i : ℝ) * (u (i.succAbove j) * u i))
          + ∑ j, ∑ l, (b (i.succAbove j) (i.succAbove l) : ℝ)
              * (u (i.succAbove j) * u (i.succAbove l))) := by
    rw [Fin.sum_univ_succAbove (fun k => ∑ l, (b k l : ℝ) * (u k * u l)) i, hrow]
    congr 1
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun j _ => hinner j
  have hlead : multiAffLead a b i (fun j => u (i.succAbove j)) * u i
      = (a i : ℝ) * u i
        + ((∑ j, (b i (i.succAbove j) : ℝ) * (u i * u (i.succAbove j)))
          + ∑ j, (b (i.succAbove j) i : ℝ) * (u (i.succAbove j) * u i)) := by
    rw [multiAffLead, add_mul, Finset.sum_mul, ← Finset.sum_add_distrib]
    congr 1
    exact Finset.sum_congr rfl fun j _ => by ring
  rw [multiAff, multiAff, hlin, hquad, hlead]
  ring


open MeasureTheory in
/-- **The linear case at an arbitrary coordinate.**  The patch's "fix all but a coordinate with a
nonzero integer coefficient" -- the coordinate is wherever the nonzero coefficient happens to be. -/
theorem fejerPi_linear_sublevel_le' {r : ℕ} (i : Fin (r + 1)) (a : Fin (r + 1) → ℝ) (b : ℝ)
    (ha : a i ≠ 0) {ε : ℝ} (hε : 0 ≤ ε) :
    (Measure.pi fun _ : Fin (r + 1) => fejerMeasure)
        {u : Fin (r + 1) → ℝ | |(∑ k, a k * u k) + b| ≤ ε}
      ≤ ENNReal.ofReal (2 * ε / |a i|) := by
  classical
  have hK : 0 < |a i| := abs_pos.mpr ha
  have hB : Measurable fun u' : Fin r → ℝ => (∑ j : Fin r, a (i.succAbove j) * u' j) + b := by
    refine Measurable.add ?_ measurable_const
    exact Finset.measurable_sum _ fun j _ => (measurable_pi_apply j).const_mul _
  have hset : {u : Fin (r + 1) → ℝ | |(∑ k, a k * u k) + b| ≤ ε}
      = {u : Fin (r + 1) → ℝ |
          |(fun _ : Fin r → ℝ => a i) (fun j => u (i.succAbove j)) * u i
            + (fun u' : Fin r → ℝ => (∑ j : Fin r, a (i.succAbove j) * u' j) + b)
                (fun j => u (i.succAbove j))| ≤ ε} := by
    ext u
    have hsum : (∑ k, a k * u k) + b
        = a i * u i + ((∑ j : Fin r, a (i.succAbove j) * u (i.succAbove j)) + b) := by
      rw [Fin.sum_univ_succAbove (fun k => a k * u k) i]
      ring
    simp only [Set.mem_ofPred_eq, hsum]
  rw [hset]
  have h := fejerPi_succAbove_sublevel_le i (A := fun _ : Fin r → ℝ => a i)
    (B := fun u' : Fin r → ℝ => (∑ j : Fin r, a (i.succAbove j) * u' j) + b)
    measurable_const hB hε hK (G := Set.univ) MeasurableSet.univ
    (fun u' _ => le_rfl) (q := 0) (by simp)
  simpa using h

/-- The multilinear form is measurable. -/
theorem measurable_multiAff {n : ℕ} (c : ℤ) (a : Fin n → ℤ) (b : Fin n → Fin n → ℤ) :
    Measurable fun u : Fin n → ℝ => multiAff c a b u := by
  simp only [multiAff]
  refine (measurable_const.add ?_).add ?_
  · exact Finset.measurable_sum _ fun k _ => (measurable_pi_apply k).const_mul _
  · refine Finset.measurable_sum _ fun k _ => Finset.measurable_sum _ fun l _ => ?_
    exact ((measurable_pi_apply k).mul (measurable_pi_apply l)).const_mul _

/-- Its leading factor at a coordinate is measurable. -/
theorem measurable_multiAffLead {n : ℕ} (a : Fin (n + 1) → ℤ)
    (b : Fin (n + 1) → Fin (n + 1) → ℤ) (i : Fin (n + 1)) :
    Measurable fun u' : Fin n → ℝ => multiAffLead a b i u' := by
  simp only [multiAffLead]
  refine measurable_const.add ?_
  exact Finset.measurable_sum _ fun j _ => (measurable_pi_apply j).const_mul _


/-- A nonzero integer has modulus at least one -- the fact that makes the patch's coefficients
"integer" do real work: the sublevel bound is `2 eps` rather than `2 eps / |coefficient|`. -/
theorem one_le_abs_intCast {z : ℤ} (hz : z ≠ 0) : (1 : ℝ) ≤ |(z : ℝ)| := by
  have h1 : (1 : ℤ) ≤ |z| := by
    rcases lt_trichotomy z 0 with h | h | h
    · rw [abs_of_neg h]
      omega
    · exact absurd h hz
    · rw [abs_of_pos h]
      omega
  have h2 : ((1 : ℤ) : ℝ) ≤ ((|z| : ℤ) : ℝ) := by exact_mod_cast h1
  simpa [Int.cast_abs] using h2

/-- **The constant case**: with no linear and no quadratic coefficients the form is its constant.
"A nonzero constant has modulus at least one." -/
theorem multiAff_eq_const {n : ℕ} (c : ℤ) (a : Fin n → ℤ) (b : Fin n → Fin n → ℤ)
    (ha : ∀ k, a k = 0) (hbz : ∀ k l, b k l = 0) (u : Fin n → ℝ) :
    multiAff c a b u = (c : ℝ) := by
  simp [multiAff, ha, hbz]

open MeasureTheory in
/-- **The linear case of `patch:multiaffine-sublevel`, for the explicit form.**

No quadratic coefficients, some nonzero linear one: the form is affine in that coordinate with a
nonzero integer leading coefficient, so the sublevel probability is at most `2 eps`. -/
theorem multiAff_sublevel_le_of_b_zero {n : ℕ} (c : ℤ) (a : Fin (n + 1) → ℤ)
    (b : Fin (n + 1) → Fin (n + 1) → ℤ) (hbz : ∀ k l, b k l = 0)
    {k : Fin (n + 1)} (hak : a k ≠ 0) {ε : ℝ} (hε : 0 ≤ ε) :
    (Measure.pi fun _ : Fin (n + 1) => fejerMeasure)
        {u : Fin (n + 1) → ℝ | |multiAff c a b u| ≤ ε}
      ≤ ENNReal.ofReal (2 * ε) := by
  classical
  have hbk : ∀ j, b j j = 0 := fun j => hbz j j
  have hlead : ∀ u' : Fin n → ℝ, multiAffLead a b k u' = (a k : ℝ) := by
    intro u'
    simp [multiAffLead, hbz]
  have hAK : ∀ u' ∈ (Set.univ : Set (Fin n → ℝ)), (1 : ℝ) ≤ |multiAffLead a b k u'| := by
    intro u' _
    rw [hlead u']
    exact one_le_abs_intCast hak
  have hset : {u : Fin (n + 1) → ℝ | |multiAff c a b u| ≤ ε}
      = {u : Fin (n + 1) → ℝ |
          |multiAffLead a b k (fun j => u (k.succAbove j)) * u k
            + multiAff c (fun j => a (k.succAbove j))
                (fun j l => b (k.succAbove j) (k.succAbove l))
                (fun j => u (k.succAbove j))| ≤ ε} := by
    ext u
    simp only [Set.mem_ofPred_eq, multiAff_split c a b hbk k u]
  rw [hset]
  have h := fejerPi_succAbove_sublevel_le k
    (A := fun u' => multiAffLead a b k u')
    (B := fun u' => multiAff c (fun j => a (k.succAbove j))
        (fun j l => b (k.succAbove j) (k.succAbove l)) u')
    (measurable_multiAffLead a b k) (measurable_multiAff _ _ _) hε one_pos
    MeasurableSet.univ hAK (q := 0) (by simp)
  simpa using h


open MeasureTheory in
/-- **The quadratic case of `patch:multiaffine-sublevel`, for the explicit form.**

"If a quadratic term is present, write `p = A(u') u_r + B(u')` where `A` is linear and has a
nonzero integer coefficient. The probability `|A| <= sqrt eps` is at most `2 sqrt eps` by the
linear case. On its complement, the conditional sublevel probability in `u_r` is at most
`2 eps / |A| <= 2 sqrt eps`." -/
theorem multiAff_sublevel_le_of_quad {n : ℕ} (c : ℤ) (a : Fin (n + 1) → ℤ)
    (b : Fin (n + 1) → Fin (n + 1) → ℤ) (hbu : ∀ k l, ¬ (k < l) → b k l = 0)
    {k l : Fin (n + 1)} (hbkl : b k l ≠ 0) {ε : ℝ} (hε0 : 0 < ε) :
    (Measure.pi fun _ : Fin (n + 1) => fejerMeasure)
        {u : Fin (n + 1) → ℝ | |multiAff c a b u| ≤ ε}
      ≤ ENNReal.ofReal (4 * Real.sqrt ε) := by
  classical
  have hkl : k < l := by
    by_contra h
    exact hbkl (hbu k l h)
  have hlk : b l k = 0 := hbu l k (not_lt.mpr hkl.le)
  have hne : l ≠ k := ne_of_gt hkl
  have hbk : ∀ j, b j j = 0 := fun j => hbu j j (lt_irrefl j)
  rcases n with _ | m
  · exfalso
    have h1 := k.isLt
    have h2 := l.isLt
    rw [Fin.lt_def] at hkl
    omega
  obtain ⟨j0, hj0⟩ := Fin.exists_succAbove_eq hne
  have hsqrt : 0 ≤ Real.sqrt ε := Real.sqrt_nonneg ε
  have hsqrtpos : 0 < Real.sqrt ε := Real.sqrt_pos.mpr hε0
  have hAform : ∀ u' : Fin (m + 1) → ℝ,
      multiAffLead a b k u'
        = (∑ j, ((b k (k.succAbove j) : ℝ) + (b (k.succAbove j) k : ℝ)) * u' j)
          + (a k : ℝ) := by
    intro u'
    rw [multiAffLead]
    ring
  have hc1 : (1 : ℝ) ≤ |(b k (k.succAbove j0) : ℝ) + (b (k.succAbove j0) k : ℝ)| := by
    rw [hj0, hlk]
    simpa using one_le_abs_intCast hbkl
  have hcpos : (0 : ℝ) < |(b k (k.succAbove j0) : ℝ) + (b (k.succAbove j0) k : ℝ)| := by
    linarith
  have hc0 : ((b k (k.succAbove j0) : ℝ) + (b (k.succAbove j0) k : ℝ)) ≠ 0 := by
    intro h0
    rw [h0] at hcpos
    simp at hcpos
  have hbad : (Measure.pi fun _ : Fin (m + 1) => fejerMeasure)
      {u' : Fin (m + 1) → ℝ | |multiAffLead a b k u'| ≤ Real.sqrt ε}
      ≤ ENNReal.ofReal (2 * Real.sqrt ε) := by
    have hset : {u' : Fin (m + 1) → ℝ | |multiAffLead a b k u'| ≤ Real.sqrt ε}
        = {u' : Fin (m + 1) → ℝ |
            |(∑ j, ((b k (k.succAbove j) : ℝ) + (b (k.succAbove j) k : ℝ)) * u' j)
              + (a k : ℝ)| ≤ Real.sqrt ε} := by
      ext u'
      simp only [Set.mem_ofPred_eq, hAform u']
    rw [hset]
    refine le_trans (fejerPi_linear_sublevel_le' j0 _ _ hc0 hsqrt) ?_
    refine ENNReal.ofReal_le_ofReal ?_
    rw [div_le_iff₀ hcpos]
    nlinarith [hsqrt, hc1]
  have hGmeas : MeasurableSet
      {u' : Fin (m + 1) → ℝ | Real.sqrt ε < |multiAffLead a b k u'|} := by
    have hm : Measurable fun u' : Fin (m + 1) → ℝ => |multiAffLead a b k u'| := by
      simpa [Real.norm_eq_abs] using (measurable_multiAffLead a b k).norm
    exact measurableSet_lt measurable_const hm
  have hGc : ({u' : Fin (m + 1) → ℝ | Real.sqrt ε < |multiAffLead a b k u'|})ᶜ
      = {u' : Fin (m + 1) → ℝ | |multiAffLead a b k u'| ≤ Real.sqrt ε} := by
    ext u'
    simp [not_lt]
  have hset2 : {u : Fin (m + 1 + 1) → ℝ | |multiAff c a b u| ≤ ε}
      = {u : Fin (m + 1 + 1) → ℝ |
          |multiAffLead a b k (fun j => u (k.succAbove j)) * u k
            + multiAff c (fun j => a (k.succAbove j))
                (fun j l => b (k.succAbove j) (k.succAbove l))
                (fun j => u (k.succAbove j))| ≤ ε} := by
    ext u
    simp only [Set.mem_ofPred_eq, multiAff_split c a b hbk k u]
  rw [hset2]
  have h := fejerPi_succAbove_sublevel_le k
    (A := fun u' => multiAffLead a b k u')
    (B := fun u' => multiAff c (fun j => a (k.succAbove j))
        (fun j l => b (k.succAbove j) (k.succAbove l)) u')
    (measurable_multiAffLead a b k) (measurable_multiAff _ _ _) hε0.le hsqrtpos
    hGmeas (fun u' hu => le_of_lt hu) (q := 2 * Real.sqrt ε) (by rw [hGc]; exact hbad)
  refine le_trans h ?_
  rw [two_mul_div_sqrt hε0, ← ENNReal.ofReal_add (by positivity) (by positivity)]
  refine ENNReal.ofReal_le_ofReal ?_
  linarith


open MeasureTheory in
/-- **`patch:multiaffine-sublevel`**, for the explicit multilinear form.

"Let `p` be a nonzero multilinear integer polynomial of degree at most two.  If the coordinates of
`u` are independently distributed with density `kappa_1`, then for `0 < eps < 1`,
`Pr{|p(u)| <= eps} <= 4 sqrt eps`."

The three cases are the patch's: a nonzero constant has modulus at least one, so the sublevel set
is empty; a nonconstant linear polynomial gives `2 eps`; and a genuine quadratic gives
`2 sqrt eps + 2 sqrt eps`. -/
theorem multiAff_sublevel_le {n : ℕ} (c : ℤ) (a : Fin (n + 1) → ℤ)
    (b : Fin (n + 1) → Fin (n + 1) → ℤ) (hbu : ∀ k l, ¬ (k < l) → b k l = 0)
    (hne : c ≠ 0 ∨ (∃ k, a k ≠ 0) ∨ (∃ k l, b k l ≠ 0))
    {ε : ℝ} (hε0 : 0 < ε) (hε1 : ε < 1) :
    (Measure.pi fun _ : Fin (n + 1) => fejerMeasure)
        {u : Fin (n + 1) → ℝ | |multiAff c a b u| ≤ ε}
      ≤ ENNReal.ofReal (4 * Real.sqrt ε) := by
  classical
  have hs1 : Real.sqrt ε ≤ 1 := by
    rw [show (1 : ℝ) = Real.sqrt 1 by simp]
    exact Real.sqrt_le_sqrt hε1.le
  have hsq : Real.sqrt ε * Real.sqrt ε = ε := Real.mul_self_sqrt hε0.le
  have hs0 : 0 ≤ Real.sqrt ε := Real.sqrt_nonneg ε
  by_cases hb : ∃ k l, b k l ≠ 0
  · obtain ⟨k, l, hkl⟩ := hb
    exact multiAff_sublevel_le_of_quad c a b hbu hkl hε0
  · have hb0 : ∀ k l, b k l = 0 := by
      intro k l
      by_contra h
      exact hb ⟨k, l, h⟩
    by_cases ha : ∃ k, a k ≠ 0
    · obtain ⟨k, hak⟩ := ha
      refine le_trans (multiAff_sublevel_le_of_b_zero c a b hb0 hak hε0.le) ?_
      refine ENNReal.ofReal_le_ofReal ?_
      nlinarith
    · have ha0 : ∀ k, a k = 0 := by
        intro k
        by_contra h
        exact ha ⟨k, h⟩
      have hc : c ≠ 0 := by
        rcases hne with h | h | h
        · exact h
        · obtain ⟨k, hk⟩ := h
          exact absurd (ha0 k) hk
        · obtain ⟨k, l, hk⟩ := h
          exact absurd (hb0 k l) hk
      have hempty : {u : Fin (n + 1) → ℝ | |multiAff c a b u| ≤ ε} = ∅ := by
        ext u
        simp only [Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false, not_le]
        rw [multiAff_eq_const c a b ha0 hb0 u]
        have h1 := one_le_abs_intCast hc
        linarith
      rw [hempty]
      simp


open MvPolynomial in
/-- **The monomials of a multilinear polynomial of degree at most two.**

Every exponent vector in the support has all entries at most one and total at most two, so its
support has at most two elements: the monomial is `1`, a single variable, or a product of two
distinct variables. This is what makes the explicit form `Auto.multiAff` exhaustive. -/
theorem multilinear_support_cases {n : ℕ} {p : MvPolynomial (Fin n) ℤ}
    (hml : ∀ i, p.degreeOf i ≤ 1) (hdeg : p.totalDegree ≤ 2)
    {d : Fin n →₀ ℕ} (hd : d ∈ p.support) :
    d = 0 ∨ (∃ k, d = Finsupp.single k 1)
      ∨ (∃ k l, k ≠ l ∧ d = Finsupp.single k 1 + Finsupp.single l 1) := by
  classical
  have hle1 : ∀ i, d i ≤ 1 := fun i =>
    le_trans (MvPolynomial.monomial_le_degreeOf i hd) (hml i)
  have hone : ∀ i ∈ d.support, d i = 1 := by
    intro i hi
    have h0 : d i ≠ 0 := Finsupp.mem_support_iff.mp hi
    have h1 := hle1 i
    omega
  have hcard : d.support.card ≤ 2 := by
    have hsum : (∑ i ∈ d.support, d i) = d.support.card := by
      rw [Finset.sum_congr rfl hone]
      simp
    have hle := MvPolynomial.le_totalDegree hd
    rw [Finsupp.sum] at hle
    omega
  rcases Nat.lt_or_ge d.support.card 1 with hc | hc
  · left
    have hemp : d.support = ∅ := Finset.card_eq_zero.mp (by omega)
    exact Finsupp.support_eq_empty.mp hemp
  rcases Nat.lt_or_ge d.support.card 2 with hc2 | hc2
  · right; left
    obtain ⟨k, hk⟩ := Finset.card_eq_one.mp (by omega : d.support.card = 1)
    refine ⟨k, ?_⟩
    ext i
    by_cases hik : i = k
    · subst hik
      have hi : i ∈ d.support := by rw [hk]; simp
      rw [hone i hi]
      simp
    · have hns : i ∉ d.support := by
        rw [hk]
        simpa using hik
      rw [Finsupp.notMem_support_iff.mp hns]
      simp [hik]
  · right; right
    obtain ⟨k, l, hkl, hs⟩ := Finset.card_eq_two.mp (by omega : d.support.card = 2)
    refine ⟨k, l, hkl, ?_⟩
    ext i
    by_cases hik : i = k
    · subst hik
      have hi : i ∈ d.support := by rw [hs]; simp
      rw [hone i hi]
      simp [hkl]
    · by_cases hil : i = l
      · subst hil
        have hi : i ∈ d.support := by rw [hs]; simp
        rw [hone i hi]
        simp [hik]
      · have hns : i ∉ d.support := by
          rw [hs]
          simp [hik, hil]
        rw [Finsupp.notMem_support_iff.mp hns]
        simp [hik, hil]


/-- The monomial attached to an exponent vector, at a real point. -/
noncomputable def monTerm {n : ℕ} (d : Fin n →₀ ℕ) (u : Fin n → ℝ) : ℝ := ∏ i, u i ^ d i

@[simp] theorem monTerm_zero {n : ℕ} (u : Fin n → ℝ) :
    monTerm (0 : Fin n →₀ ℕ) u = 1 := by
  simp [monTerm]

@[simp] theorem monTerm_single {n : ℕ} (k : Fin n) (u : Fin n → ℝ) :
    monTerm (Finsupp.single k 1) u = u k := by
  classical
  rw [monTerm]
  rw [Finset.prod_eq_single k]
  · simp
  · intro i _ hik
    rw [Finsupp.single_apply, ite_eq_right (fun h => hik h.symm), pow_zero]
  · intro hk
    exact absurd (Finset.mem_univ k) hk

/-- The monomial of a product of two variables factors, whether or not they are distinct; the
distinctness is only needed to know the exponents are one, which is already recorded in the
exponent vector. -/
theorem monTerm_add {n : ℕ} (d e : Fin n →₀ ℕ) (u : Fin n → ℝ) :
    monTerm (d + e) u = monTerm d u * monTerm e u := by
  simp only [monTerm, Finsupp.add_apply, pow_add]
  exact Finset.prod_mul_distrib

theorem monTerm_pair {n : ℕ} (k l : Fin n) (u : Fin n → ℝ) :
    monTerm (Finsupp.single k 1 + Finsupp.single l 1) u = u k * u l := by
  rw [monTerm_add, monTerm_single, monTerm_single]



/-! ## `blueprints/task_2_patch_3_updated.tex`, stage 3: mixed radii to one radius

`patch:uniformize` rests on one pointwise comparison: "Since `L_i <= L/2`, pointwise
`kappa_{L_i}(z_i) <= (2L/L_i) kappa_L(z_i)`", applied "only to the nonnegative `P`, after Jensen".
The comparison is elementary and is proved here; the surrounding statement also needs a
mixed-radius cube quantity, which the file does not yet have. -/

/-- **The Fejer density comparison of `patch:uniformize`.**

For `L_i <= L/2` the narrow density is dominated by `2L/L_i` times the wide one. Off the narrow
support the left side vanishes; on it the wide density is at least `(2L)^{-1}`, because the point
is then within `L/2` of the origin and the wide kernel has not decayed below half its peak. -/
theorem fejer_le_scaled {Li L z : ℝ} (hLi : 0 < Li) (hL : 0 < L) (h : Li ≤ L / 2) :
    fejer Li z ≤ (2 * L / Li) * fejer L z := by
  have hkL : 0 ≤ fejer L z := fejer_nonneg hL z
  rcases le_or_gt Li |z| with hz | hz
  · rw [fejer_eq_zero_of_le hLi hz]
    positivity
  · have hzL : |z| ≤ L / 2 := le_trans hz.le h
    have hfrac : |z| / L ≤ 1 / 2 := by
      rw [div_le_div_iff₀ hL (by norm_num : (0 : ℝ) < 2)]
      linarith
    have hmax : max (1 - |z| / L) 0 = 1 - |z| / L := max_eq_left (by linarith)
    have h2 : (2 * L)⁻¹ ≤ fejer L z := by
      rw [fejer, hmax]
      have hinv : (0 : ℝ) < L⁻¹ := inv_pos.mpr hL
      have hrw : (2 * L)⁻¹ = L⁻¹ * (1 / 2) := by
        rw [mul_inv]
        ring
      rw [hrw]
      exact mul_le_mul_of_nonneg_left (by linarith) hinv.le
    have h1 : fejer Li z ≤ Li⁻¹ := fejer_le_inv hLi z
    have hscale : (0 : ℝ) < 2 * L / Li := by positivity
    have h3 : Li⁻¹ ≤ (2 * L / Li) * fejer L z := by
      have hstep : Li⁻¹ = (2 * L / Li) * (2 * L)⁻¹ := by
        field_simp
      rw [hstep]
      exact mul_le_mul_of_nonneg_left h2 hscale.le
    linarith

/-- The same comparison on a whole cube of increments, which is the form `patch:uniformize` uses:
all `s` mixed radii are replaced by the single radius `L` at the stated cost. -/
theorem fejerCube_le_scaled {s : ℕ} {L : ℝ} (hL : 0 < L) (Li : Fin s → ℝ)
    (hLi : ∀ i, 0 < Li i) (h : ∀ i, Li i ≤ L / 2) (z : Fin s → ℝ) :
    (∏ i, fejer (Li i) (z i)) ≤ (∏ i, 2 * L / Li i) * ∏ i, fejer L (z i) := by
  rw [← Finset.prod_mul_distrib]
  refine Finset.prod_le_prod₀ (fun i _ => fejer_nonneg (hLi i) (z i)) fun i _ => ?_
  exact fejer_le_scaled (hLi i) hL (h i)



/-! ### Mixed radii: one Fejer radius per cube coordinate

`patch:uniformize` compares a cube quantity whose `s` coordinates carry *different* radii `L_i`
with the one whose coordinates all carry the single radius `L`. `Auto.locUnifPow` carries one
scalar radius, so the mixed-radius quantity is introduced here; at a constant radius vector it is
the old one on the nose. -/

/-- The product of Fejer kernels with one radius per coordinate. -/
noncomputable def fejerCubeMixed {s : ℕ} (H h : Fin s → ℝ) : ℝ := ∏ l : Fin s, fejer (H l) (h l)

theorem fejerCubeMixed_const {s : ℕ} (H : ℝ) (h : Fin s → ℝ) :
    fejerCubeMixed (fun _ => H) h = fejerCube H h := rfl

theorem fejerCubeMixed_nonneg {s : ℕ} {H : Fin s → ℝ} (hH : ∀ l, 0 < H l) (h : Fin s → ℝ) :
    0 ≤ fejerCubeMixed H h :=
  Finset.prod_nonneg fun l _ => fejer_nonneg (hH l) (h l)

/-- **The comparison of `patch:uniformize` at the level of the cube.** Provided every mixed radius
is at most half the common one, the mixed product is dominated by `prod_l (2L/H_l)` times the
product at the common radius. -/
theorem fejerCubeMixed_le_scaled {s : ℕ} {L : ℝ} (hL : 0 < L) (H : Fin s → ℝ)
    (hH : ∀ l, 0 < H l) (hhalf : ∀ l, H l ≤ L / 2) (h : Fin s → ℝ) :
    fejerCubeMixed H h ≤ (∏ l : Fin s, 2 * L / H l) * fejerCube L h := by
  change (∏ l : Fin s, fejer (H l) (h l))
      ≤ (∏ l : Fin s, 2 * L / H l) * ∏ l : Fin s, fejer L (h l)
  exact fejerCube_le_scaled hL H hH hhalf h

open MeasureTheory in
/-- The mixed-radius analogue of `Auto.locUnifPow`: the cube average of the iterated Fejer
difference weighted by one Fejer kernel per coordinate, with its own radius. -/
noncomputable def locUnifPowMixed (N : ℝ) {s : ℕ} (H : Fin s → ℝ) (j : Fin 3) (f : E3 → ℂ) : ℂ :=
  ((N ^ (6 : ℕ))⁻¹ : ℂ) * ∫ x : E3, ∫ h : Fin s → ℝ,
    fdiffIter (basisVec j) s h f x * ∏ l : Fin s, ((fejer (H l) (h l) : ℝ) : ℂ)

/-- At a constant radius vector the mixed quantity is the scalar one. -/
theorem locUnifPowMixed_const (N H : ℝ) (j : Fin 3) (s : ℕ) (f : E3 → ℂ) :
    locUnifPowMixed N (fun _ : Fin s => H) j f = locUnifPow N H j s f := rfl



open MeasureTheory in
/-- **The comparison of `patch:uniformize`, integrated.**

The patch applies the density comparison "only to the nonnegative `P`, after Jensen".  This is that
application: against a nonnegative weight the mixed-radius average is dominated by
`prod_l (2L/H_l)` times the average at the single radius `L`. Nonnegativity of `P` is what makes
the pointwise comparison survive multiplication, and is the reason the patch insists on reaching a
nonnegative quantity before comparing. -/
theorem integral_fejerCubeMixed_le_scaled {s : ℕ} {L : ℝ} (hL : 0 < L) (H : Fin s → ℝ)
    (hH : ∀ l, 0 < H l) (hhalf : ∀ l, H l ≤ L / 2) (P : (Fin s → ℝ) → ℝ) (hP : ∀ h, 0 ≤ P h)
    (h1 : Integrable fun h => P h * fejerCubeMixed H h)
    (h2 : Integrable fun h => P h * fejerCube L h) :
    (∫ h, P h * fejerCubeMixed H h) ≤ (∏ l : Fin s, 2 * L / H l) * ∫ h, P h * fejerCube L h := by
  have key : ∀ h, P h * fejerCubeMixed H h
      ≤ (∏ l : Fin s, 2 * L / H l) * (P h * fejerCube L h) := by
    intro h
    have hcmp := fejerCubeMixed_le_scaled hL H hH hhalf h
    have hmul := mul_le_mul_of_nonneg_left hcmp (hP h)
    calc P h * fejerCubeMixed H h
        ≤ P h * ((∏ l : Fin s, 2 * L / H l) * fejerCube L h) := hmul
      _ = (∏ l : Fin s, 2 * L / H l) * (P h * fejerCube L h) := by ring
  calc (∫ h, P h * fejerCubeMixed H h)
      ≤ ∫ h, (∏ l : Fin s, 2 * L / H l) * (P h * fejerCube L h) :=
        integral_mono h1 (h2.const_mul _) key
    _ = (∏ l : Fin s, 2 * L / H l) * ∫ h, P h * fejerCube L h := integral_const_mul _ _



open MeasureTheory in
/-- **The zero-vertex step of `patch:uniformize`, normalized by the box volume.**

"The zero vertex supports `u_z` on the original box, so `|V^{-1} int u_z|^2 <= (1 + L/S) P(z)`."
The smoothed function is supported on the box enlarged by `L` in the `j`-th direction, whose volume
is `V (1 + L/S)`; Cauchy-Schwarz against that support (`Auto.sq_norm_integral_le_measure_mul`) and
division by `V^2` give the bound, with the normalized square integral `V^{-1} int |F|^2` on the
right. That quantity is the patch's `P(z)`, and it is manifestly nonnegative -- which is what lets
the density comparison be applied to it afterwards. -/
theorem sq_norm_avg_le_enlarged {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {S : Set α} (hSm : MeasurableSet S) (hSfin : μ S ≠ ⊤)
    {V L Sj : ℝ} (hV : 0 < V) (hmeas : (μ S).toReal ≤ V * (1 + L / Sj))
    {F : α → ℂ} (hsupp : ∀ x, x ∉ S → F x = 0)
    (hF2 : Integrable (fun x : α => ‖F x‖ ^ 2) μ)
    (hFn : Integrable (fun x : α => ‖F x‖) μ) :
    ‖((V : ℂ))⁻¹ * ∫ x : α, F x ∂μ‖ ^ 2
      ≤ (1 + L / Sj) * (V⁻¹ * ∫ x : α, ‖F x‖ ^ 2 ∂μ) := by
  have hCS := sq_norm_integral_le_measure_mul hSm hSfin hsupp hF2 hFn
  have hnn : 0 ≤ ∫ x : α, ‖F x‖ ^ 2 ∂μ := integral_nonneg fun x => by positivity
  have hnorm : ‖((V : ℂ))⁻¹ * ∫ x : α, F x ∂μ‖ ^ 2
      = V⁻¹ ^ 2 * ‖∫ x : α, F x ∂μ‖ ^ 2 := by
    rw [norm_mul, mul_pow, norm_inv, Complex.norm_real, Real.norm_of_nonneg hV.le]
  rw [hnorm]
  have hstep : V⁻¹ ^ 2 * ‖∫ x : α, F x ∂μ‖ ^ 2
      ≤ V⁻¹ ^ 2 * ((μ S).toReal * ∫ x : α, ‖F x‖ ^ 2 ∂μ) :=
    mul_le_mul_of_nonneg_left hCS (by positivity)
  refine le_trans hstep ?_
  have hmul : (μ S).toReal * ∫ x : α, ‖F x‖ ^ 2 ∂μ
      ≤ (V * (1 + L / Sj)) * ∫ x : α, ‖F x‖ ^ 2 ∂μ :=
    mul_le_mul_of_nonneg_right hmeas hnn
  refine le_trans (mul_le_mul_of_nonneg_left hmul (by positivity)) ?_
  have hVne : (V : ℝ) ≠ 0 := ne_of_gt hV
  have hid : V⁻¹ ^ 2 * ((V * (1 + L / Sj)) * ∫ x : α, ‖F x‖ ^ 2 ∂μ)
      = (1 + L / Sj) * (V⁻¹ * ∫ x : α, ‖F x‖ ^ 2 ∂μ) := by
    field_simp
  rw [hid]



/-! ### The mixed-radius cube: basic properties

Ports of the scalar-radius facts about `Auto.fejerCube` needed before the cube-successor identity
can be re-proved with mixed radii. Each proof is the scalar one with the constant radius replaced
by the radius at the coordinate; nothing about the argument changes, because the cube weight was
already a product over coordinates. -/
theorem continuous_fejerCubeMixed {s : ℕ} (H : Fin s → ℝ) :
    Continuous fun h : Fin s → ℝ => fejerCubeMixed H h := by
  refine continuous_finsetProd _ fun l _ => ?_
  exact continuous_fejer.comp (continuous_apply l)

open MeasureTheory in
theorem integrable_fejerCubeMixed {s : ℕ} {H : Fin s → ℝ} (hH : ∀ l, 0 < H l) :
    Integrable (fun h : Fin s → ℝ => fejerCubeMixed H h) :=
  MeasureTheory.Integrable.fin_nat_prod (fun l => integrable_fejer (hH l))

open MeasureTheory in
theorem integral_fejerCubeMixed {s : ℕ} {H : Fin s → ℝ} (hH : ∀ l, 0 < H l) :
    (∫ h : Fin s → ℝ, fejerCubeMixed H h) = 1 := by
  simp only [fejerCubeMixed]
  rw [MeasureTheory.integral_fin_nat_prod_volume_eq_prod (fun l : Fin s => fejer (H l))]
  refine Finset.prod_eq_one fun l _ => ?_
  exact integral_fejer (hH l)

/-- Splitting off the first coordinate of a mixed-radius cube. The split coordinate keeps its own
radius; this is the shape in which `patch:uniformize` appends the coordinate carrying the common
radius `L` to the `s` coordinates carrying the `L_i`. -/
theorem fejerCubeMixed_cons {s : ℕ} (L : ℝ) (Lv : Fin s → ℝ) (h : Fin (s + 1) → ℝ) :
    fejerCubeMixed (Fin.cons L Lv) h
      = fejer L (h 0) * fejerCubeMixed Lv (fun i => h i.succ) := by
  simp only [fejerCubeMixed, Fin.prod_univ_succ, Fin.cons_zero, Fin.cons_succ]



open MeasureTheory in
/-- Mixed-radius port of `Auto.integrable_locUnif_integrand`. -/
theorem integrable_locUnifMixed_integrand {s : ℕ} {H : Fin s → ℝ} (hH : ∀ l, 0 < H l) (v : E3)
    {f : E3 → ℂ} (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) :
    Integrable (fun p : E3 × (Fin s → ℝ) =>
      fdiffIter v s p.2 f p.1 * ((fejerCubeMixed H p.2 : ℝ) : ℂ)) (volume.prod volume) := by
  have hdom : Integrable (fun p : E3 × (Fin s → ℝ) => ‖f p.1‖ * fejerCubeMixed H p.2)
      (volume.prod volume) :=
    MeasureTheory.Integrable.mul_prod hf.2.1.norm (integrable_fejerCubeMixed hH)
  refine Integrable.mono' hdom ?_ (Filter.Eventually.of_forall fun p => ?_)
  · refine (continuous_fdiffIter_uncurry v s hf.1).aestronglyMeasurable.mul ?_
    exact ((Complex.continuous_ofReal.comp
      ((continuous_fejerCubeMixed H).comp continuous_snd))).aestronglyMeasurable
  · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (fejerCubeMixed_nonneg hH p.2)]
    have h1 : ‖fdiffIter v s p.2 f p.1‖ ≤ ‖f p.1‖ := norm_fdiffIter_le_self v s p.2 hf1 p.1
    have h2 : (0 : ℝ) ≤ fejerCubeMixed H p.2 := fejerCubeMixed_nonneg hH p.2
    exact mul_le_mul_of_nonneg_right h1 h2

open MeasureTheory in
/-- Mixed-radius port of `Auto.locUnifPow_swap`: the cube of shifts outside. -/
theorem locUnifPowMixed_swap {N : ℝ} {s : ℕ} {H : Fin s → ℝ} (hH : ∀ l, 0 < H l) (j : Fin 3)
    {f : E3 → ℂ} (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) :
    locUnifPowMixed N H j f
      = ((N ^ (6 : ℕ))⁻¹ : ℂ) * ∫ h : Fin s → ℝ,
          ((fejerCubeMixed H h : ℝ) : ℂ) * ∫ x : E3, fdiffIter (basisVec j) s h f x := by
  rw [locUnifPowMixed]
  congr 1
  have hint := integrable_locUnifMixed_integrand hH (basisVec j) hf hf1
  have hcongr : (∫ x : E3, ∫ h : Fin s → ℝ,
        fdiffIter (basisVec j) s h f x * ∏ l : Fin s, ((fejer (H l) (h l) : ℝ) : ℂ))
      = ∫ x : E3, ∫ h : Fin s → ℝ,
        fdiffIter (basisVec j) s h f x * ((fejerCubeMixed H h : ℝ) : ℂ) := by
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    refine integral_congr_ae (Filter.Eventually.of_forall fun h => ?_)
    simp only [fejerCubeMixed, Complex.ofReal_prod]
  rw [hcongr, integral_integral_swap hint]
  refine integral_congr_ae (Filter.Eventually.of_forall fun h => ?_)
  change (∫ x : E3, fdiffIter (basisVec j) s h f x * ((fejerCubeMixed H h : ℝ) : ℂ))
      = ((fejerCubeMixed H h : ℝ) : ℂ) * ∫ x : E3, fdiffIter (basisVec j) s h f x
  rw [integral_mul_const, mul_comm]



open MeasureTheory in
/-- Mixed-radius port of `Auto.integrable_split_integrand`. The split coordinate carries the
common radius `L`, the remaining cube the mixed radii. -/
theorem integrable_split_integrand_mixed {s : ℕ} {L : ℝ} (hL : 0 < L) {H : Fin s → ℝ}
    (hH : ∀ l, 0 < H l) (v : E3) {f : E3 → ℂ} (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) :
    Integrable (fun p : ℝ × (Fin s → ℝ) =>
      ((fejer L p.1 : ℝ) : ℂ) * (((fejerCubeMixed H p.2 : ℝ) : ℂ)
        * pairAvg v (fdiffIter v s p.2 f) p.1)) (volume.prod volume) := by
  set M : ℝ := ∫ x : E3, ‖f x‖ with hM
  have hM0 : 0 ≤ M := integral_nonneg fun x => norm_nonneg _
  have hdom : Integrable (fun p : ℝ × (Fin s → ℝ) =>
      (fejer L p.1 * M) * fejerCubeMixed H p.2) (volume.prod volume) :=
    MeasureTheory.Integrable.mul_prod ((integrable_fejer hL).mul_const M)
      (integrable_fejerCubeMixed hH)
  refine Integrable.mono' hdom ?_ (Filter.Eventually.of_forall fun p => ?_)
  · refine AEStronglyMeasurable.mul ?_ (AEStronglyMeasurable.mul ?_ ?_)
    · exact ((Complex.continuous_ofReal.comp
        (continuous_fejer.comp continuous_fst))).aestronglyMeasurable
    · exact ((Complex.continuous_ofReal.comp
        ((continuous_fejerCubeMixed H).comp continuous_snd))).aestronglyMeasurable
    · exact (stronglyMeasurable_pairAvg_cube v s hf.1).aestronglyMeasurable
  · have hb : ∀ y, ‖fdiffIter v s p.2 f y‖ ≤ 1 := norm_fdiffIter_le v s p.2 hf1
    have hpair : ‖pairAvg v (fdiffIter v s p.2 f) p.1‖ ≤ M := by
      refine le_trans (norm_pairAvg_le v (nice_fdiffIter v s p.2 hf) hb p.1) ?_
      rw [one_mul, hM]
      refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun x => norm_nonneg _)
        hf.2.1.norm (Filter.Eventually.of_forall fun x => ?_)
      exact norm_fdiffIter_le_self v s p.2 hf1 x
    have hnorm : ‖((fejer L p.1 : ℝ) : ℂ) * (((fejerCubeMixed H p.2 : ℝ) : ℂ)
          * pairAvg v (fdiffIter v s p.2 f) p.1)‖
        = fejer L p.1 * (fejerCubeMixed H p.2 * ‖pairAvg v (fdiffIter v s p.2 f) p.1‖) := by
      rw [norm_mul, norm_mul, Complex.norm_real, Complex.norm_real, Real.norm_eq_abs,
        Real.norm_eq_abs, abs_of_nonneg (fejer_nonneg hL p.1),
        abs_of_nonneg (fejerCubeMixed_nonneg hH p.2)]
    rw [hnorm]
    calc fejer L p.1 * (fejerCubeMixed H p.2 * ‖pairAvg v (fdiffIter v s p.2 f) p.1‖)
        ≤ fejer L p.1 * (fejerCubeMixed H p.2 * M) := by
          refine mul_le_mul_of_nonneg_left ?_ (fejer_nonneg hL p.1)
          exact mul_le_mul_of_nonneg_left hpair (fejerCubeMixed_nonneg hH p.2)
      _ = fejer L p.1 * M * fejerCubeMixed H p.2 := by ring



/-- Positivity of a mixed radius vector with one extra coordinate prepended. -/
theorem pos_fin_cons {s : ℕ} {L : ℝ} (hL : 0 < L) {Lv : Fin s → ℝ} (hLv : ∀ l, 0 < Lv l) :
    ∀ l : Fin (s + 1), 0 < (Fin.cons L Lv : Fin (s + 1) → ℝ) l := by
  intro l
  refine Fin.cases ?_ ?_ l
  · simpa using hL
  · intro i
    simpa using hLv i

