/-- Mixed-radius port of `Auto.integrable_fejerCube_innerFejer`. -/
theorem integrable_fejerCubeMixed_innerFejer {s : ℕ} {L : ℝ} (hL : 0 < L) {H : Fin s → ℝ}
    (hH : ∀ l, 0 < H l) (v : E3) {f : E3 → ℂ} (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) :
