    Measurable fun t : ((Fin r → B) × (Fin r → B)) × (B × B) =>
      cubeProdSel w (Fin.snoc t.1.1 t.2.1) (Fin.snoc t.1.2 t.2.2) :=
  (measurable_cubeProdSel hw).comp (Measurable.prodMk
    (measurable_snoc.comp (Measurable.prodMk measurable_fst.fst measurable_snd.fst))
    (measurable_snoc.comp (Measurable.prodMk measurable_fst.snd measurable_snd.snd)))

open MeasureTheory in
