/-- The window average of a function supported in `I_N(C)` is supported in the widened box. -/
theorem winAvg_eq_zero_of_notMem_petBoxWin {C N H : ℝ} (hH : 0 ≤ H) (j : Fin 3) {f : E3 → ℂ}
