  refine winAvg_eq_zero_of_forall hH _ f fun a ha => ?_
  obtain ⟨ha0, haH⟩ := ha
  refine hsupp _ fun hmem => hx fun i => ?_
  have hco : (x + a • basisVec j) i = x i + (if i = j then a else 0) := by
    rw [PiLp.add_apply, smul_basisVec_apply]
  obtain ⟨h1, h2⟩ := hmem i
