theorem measurableSet_petBoxWin (C N H : ℝ) (j : Fin 3) : MeasurableSet (petBoxWin C N H j) := by
  have hEq : petBoxWin C N H j
      = ⋂ i : Fin 3, (fun x : E3 => x i) ⁻¹'
          Set.Icc (-(C * N ^ expo i) - winWidth H j i) (C * N ^ expo i) := by
    ext x
    simp [petBoxWin, Set.mem_iInter]
