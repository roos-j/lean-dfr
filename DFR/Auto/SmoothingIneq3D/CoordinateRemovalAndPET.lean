open MeasureTheory in
/-- **The window average preserves the integral**: `∫ T_{H,v} u = ∫ u`. -/
theorem integral_winAvg {H : ℝ} (hH : 0 < H) (v : E3) {f : E3 → ℂ} (hf : Nice f) :
    (∫ x : E3, winAvg H v f x) = ∫ x : E3, f x := by
  have hL : (∫ x : E3, winAvg H v f x)
      = (H : ℂ)⁻¹ * ∫ x : E3, ∫ a in (0 : ℝ)..H, f (x + a • v) := by
    rw [← integral_const_mul]
    exact integral_congr_ae (Filter.Eventually.of_forall fun x => rfl)
  have hswap : (∫ x : E3, ∫ a in (0 : ℝ)..H, f (x + a • v))
      = ∫ a in (0 : ℝ)..H, ∫ x : E3, f (x + a • v) :=
    integral_swap_interval hH _ (integrable_shift_prod v hf)
  have hinner : ∀ a : ℝ, (∫ x : E3, f (x + a • v)) = ∫ x : E3, f x :=
    fun a => integral_add_right_eq_self f (a • v)
  rw [hL, hswap]
  simp_rw [hinner]
  rw [intervalIntegral.integral_const, sub_zero, Complex.real_smul, ← mul_assoc,
    inv_mul_cancel₀ (Complex.ofReal_ne_zero.mpr hH.ne'), one_mul]

/-- The window average vanishes where every point of the window misses the support. -/
theorem winAvg_eq_zero_of_forall {H : ℝ} (hH : 0 ≤ H) (v : E3) (f : E3 → ℂ) {x : E3}
    (hx : ∀ a ∈ Set.Icc (0 : ℝ) H, f (x + a • v) = 0) : winAvg H v f x = 0 := by
  have heq : Set.EqOn (fun a : ℝ => f (x + a • v)) (fun _ => (0 : ℂ)) (Set.uIcc (0 : ℝ) H) := by
    intro a ha
    rw [Set.uIcc_of_le hH] at ha
    exact hx a ha
  rw [winAvg, intervalIntegral.integral_congr heq, intervalIntegral.integral_zero, mul_zero]

theorem smul_basisVec_apply (a : ℝ) (j i : Fin 3) :
    (a • basisVec j) i = if i = j then a else 0 := by
  simp only [basisVec, PiLp.smul_apply, PiLp.single_apply, smul_eq_mul, mul_ite, mul_one, mul_zero]


/-- The one-coordinate widening used by the window average: `H` in the direction `j`, nothing in
the others. -/
def winWidth (H : ℝ) (j i : Fin 3) : ℝ := if i = j then H else 0

theorem winWidth_nonneg {H : ℝ} (hH : 0 ≤ H) (j i : Fin 3) : 0 ≤ winWidth H j i := by
  rw [winWidth]
  split_ifs
  · exact hH
  · exact le_rfl

theorem winWidth_le {H : ℝ} (hH : 0 ≤ H) (j i : Fin 3) : winWidth H j i ≤ H := by
  rw [winWidth]
  split_ifs
  · exact le_rfl
  · exact hH

/-- `I_N(C)` widened by `H` on the lower side of the `j`-th coordinate. This is where
`T_{H,e_j} u` lives when `u` lives in `I_N(C)`; task_2_patch_3_updated `patch:energy-to-u2`,
where its
volume is the `V_H = |B_N| (1 + H/S)` of the support Cauchy-Schwarz. -/
def petBoxWin (C N H : ℝ) (j : Fin 3) : Set E3 :=
  {x | ∀ i : Fin 3,
    x i ∈ Set.Icc (-(C * N ^ expo i) - winWidth H j i) (C * N ^ expo i)}

theorem petBoxWin_eq_preimage (C N H : ℝ) (j : Fin 3) :
    petBoxWin C N H j = (WithLp.ofLp : E3 → (Fin 3 → ℝ)) ⁻¹'
