/-- **The mixed-radius cube-successor identity.**

This is `patch:cube-succ` in the form `patch:uniformize` needs it: "square expansion of `P` appends
one cube coordinate".  The appended coordinate carries the common radius `L` and the `s` older ones
keep their own radii `L_i`, so the whole statement is the scalar
`Auto.locUnifPow_succ_eq` with the cube weight replaced by `Auto.fejerCubeMixed`. The inner factor
`Auto.innerFejer L` is reused unchanged: it only ever saw the radius of the split coordinate. -/
theorem locUnifPowMixed_succ_eq {N : ℝ} {s : ℕ} {L : ℝ} (hL : 0 < L) {Lv : Fin s → ℝ}
    (hLv : ∀ l, 0 < Lv l) (j : Fin 3) {f : E3 → ℂ} (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) :
    locUnifPowMixed N (Fin.cons L Lv) j f
      = ((N ^ (6 : ℕ))⁻¹ : ℂ) * ∫ h : Fin s → ℝ,
          ((fejerCubeMixed Lv h : ℝ) : ℂ) * innerFejer L (basisVec j) s f h := by
  rw [locUnifPowMixed_swap (pos_fin_cons hL hLv) j hf hf1]
  congr 1
  have hstep : ∀ h : Fin (s + 1) → ℝ,
      ((fejerCubeMixed (Fin.cons L Lv) h : ℝ) : ℂ)
          * ∫ x : E3, fdiffIter (basisVec j) (s + 1) h f x
        = ((fejer L (h 0) : ℝ) : ℂ) * ((((fejerCubeMixed Lv (fun i => h i.succ)) : ℝ) : ℂ)
            * pairAvg (basisVec j) (fdiffIter (basisVec j) s (fun i => h i.succ) f) (h 0)) := by
    intro h
    rw [integral_fdiffIter_succ, fejerCubeMixed_cons, Complex.ofReal_mul]
    ring
  rw [integral_congr_ae (Filter.Eventually.of_forall hstep), integral_pi_fin_succ]
  have hsimp : ∀ p : ℝ × (Fin s → ℝ),
      ((fejer L ((Fin.cons p.1 p.2 : Fin (s + 1) → ℝ) 0) : ℝ) : ℂ)
        * ((((fejerCubeMixed Lv (fun i => (Fin.cons p.1 p.2 : Fin (s + 1) → ℝ) i.succ)) : ℝ) : ℂ)
          * pairAvg (basisVec j) (fdiffIter (basisVec j) s
              (fun i => (Fin.cons p.1 p.2 : Fin (s + 1) → ℝ) i.succ) f)
              ((Fin.cons p.1 p.2 : Fin (s + 1) → ℝ) 0))
      = ((fejer L p.1 : ℝ) : ℂ) * (((fejerCubeMixed Lv p.2 : ℝ) : ℂ)
          * pairAvg (basisVec j) (fdiffIter (basisVec j) s p.2 f) p.1) := by
    intro p
    have h2 : (fun i => (Fin.cons p.1 p.2 : Fin (s + 1) → ℝ) i.succ) = p.2 := by
      funext i
      exact Fin.cons_succ _ _ _
    rw [Fin.cons_zero, h2]
  rw [integral_congr_ae (Filter.Eventually.of_forall hsimp),
    MeasureTheory.Measure.volume_eq_prod,
    integral_prod_symm _ (integrable_split_integrand_mixed hL hLv (basisVec j) hf hf1)]
  refine integral_congr_ae (Filter.Eventually.of_forall fun h => ?_)
  simp only [innerFejer]
  rw [← integral_const_mul]
  refine integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
  ring



