    rw [← integral_const_mul]
    refine integral_congr_ae (Filter.Eventually.of_forall fun a => ?_)
    change ((fejer L a : ℝ) : ℂ) * locUnifPowMixed N Lv j (fdiff (basisVec j) a f)
