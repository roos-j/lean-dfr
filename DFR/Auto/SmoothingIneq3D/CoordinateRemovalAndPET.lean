  exact ENNReal.toReal_le_of_le_ofReal (by positivity) (volume_petBoxWin_le hC hN hH.le j hHS)

open MeasureTheory in
/-- The same statement for the paired integral, the shape `patch:energy-to-u2` uses. -/
theorem sq_norm_pairAvg_le {C N H : ℝ} (hH : 0 < H) (hC : 0 ≤ C) (hN : 0 ≤ N) (j : Fin 3)
    (hHS : H ≤ 2 * (C * N ^ expo j)) {f : E3 → ℂ} (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1)
    (hsupp : ∀ y, y ∉ petBox C N → f y = 0) (z : ℝ) :
    ‖pairAvg (basisVec j) f z‖ ^ 2
      ≤ 16 * C ^ 3 * N ^ 6
        * ∫ x : E3, ‖winAvg H (basisVec j) (fdiff (basisVec j) z f) x‖ ^ 2 := by
  have hgsupp : ∀ y, y ∉ petBox C N → fdiff (basisVec j) z f y = 0 := by
    intro y hy
    rw [fdiff, hsupp y hy, map_zero, mul_zero]
  have hp : pairAvg (basisVec j) f z = ∫ x : E3, fdiff (basisVec j) z f x := rfl
  rw [hp]
  exact sq_norm_integral_le_winAvg hH hC hN j hHS (nice_fdiff _ z hf)
    (fun y => norm_fdiff_le _ z hf1 y) hgsupp

open MeasureTheory in
/-- The order-zero power at a shifted difference is the normalized paired integral. -/
theorem re_locUnifPow_zero_fdiff {N H : ℝ} (j : Fin 3) (f : E3 → ℂ) (z : ℝ) :
    (locUnifPow N H j 0 (fdiff (basisVec j) z f)).re
      = (N ^ (6 : ℕ))⁻¹ * (pairAvg (basisVec j) f z).re := by
  have hp : (∫ x : E3, fdiff (basisVec j) z f x) = pairAvg (basisVec j) f z := rfl
  rw [locUnifPow_zero, hp]
  have hcast : ((N : ℂ) ^ (6 : ℕ))⁻¹ = (((N ^ (6 : ℕ))⁻¹ : ℝ) : ℂ) := by push_cast; ring
  rw [hcast, Complex.re_ofReal_mul]

open MeasureTheory in
/-- **`patch:raise-order`, the base case**: `(Q_0)^2 <= (1 + H/S) Q_1`. -/
theorem sq_re_locUnifPow_zero_le {C N H : ℝ} (hH : 0 < H) (hC : 0 ≤ C) (hN : 0 < N) (j : Fin 3)
    (hHS : H ≤ 2 * (C * N ^ expo j)) {g : E3 → ℂ} (hg : Nice g) (hg1 : ∀ y, ‖g y‖ ≤ 1)
    (hsupp : ∀ y, y ∉ petBox C N → g y = 0) :
    (locUnifPow N H j 0 g).re ^ 2 ≤ 16 * C ^ 3 * (locUnifPow N H j 1 g).re := by
  have hcast : ((N : ℂ) ^ (6 : ℕ))⁻¹ = (((N ^ (6 : ℕ))⁻¹ : ℝ) : ℂ) := by push_cast; ring
  have h0 : (locUnifPow N H j 0 g).re = (N ^ (6 : ℕ))⁻¹ * (∫ x : E3, g x).re := by
    rw [locUnifPow_zero, hcast, Complex.re_ofReal_mul]
  have h1 : (locUnifPow N H j 1 g).re
      = (N ^ (6 : ℕ))⁻¹ * ∫ x : E3, ‖winAvg H (basisVec j) g x‖ ^ 2 := by
    rw [locUnifPow_one_eq hH hN.ne' j hg hg1, hcast, Complex.re_ofReal_mul, Complex.ofReal_re]
  have hsq : (∫ x : E3, g x).re ^ 2 ≤ ‖∫ x : E3, g x‖ ^ 2 := by
    rw [← sq_abs]
    exact pow_le_pow_left₀ (abs_nonneg _) (Complex.abs_re_le_norm _) 2
  have hchain := hsq.trans (sq_norm_integral_le_winAvg hH hC hN.le j hHS hg hg1 hsupp)
  rw [h0, h1, mul_pow]
  calc ((N ^ (6 : ℕ))⁻¹) ^ 2 * (∫ x : E3, g x).re ^ 2
      ≤ ((N ^ (6 : ℕ))⁻¹) ^ 2 * (16 * C ^ 3 * N ^ 6
          * ∫ x : E3, ‖winAvg H (basisVec j) g x‖ ^ 2) :=
        mul_le_mul_of_nonneg_left hchain (by positivity)
    _ = 16 * C ^ 3 * ((N ^ (6 : ℕ))⁻¹ * ∫ x : E3, ‖winAvg H (basisVec j) g x‖ ^ 2) := by
        field_simp

open MeasureTheory in
/-- **`patch:raise-order`** of `blueprints/task_2_patch_3_updated.tex`, at every order:
    (Q_s)^2 <= (1 + H/S) Q_{s+1},

in the file's normalization, where `(1 + H/S) |B_N| / N^6 <= 16 C^3`.

Induction on `s`. The base case is the support Cauchy-Schwarz `Auto.sq_re_locUnifPow_zero_le`.
The step splits both sides over the first shift with `Auto.re_locUnifPow_succ_split`, applies the
induction hypothesis to the one-difference function -- which is again `Auto.Nice`, one-bounded and
supported in the same box -- and closes with Jensen for the Fejer density
(`Auto.sq_integral_fejer_le`). -/
theorem sq_re_locUnifPow_le {C N H : ℝ} (hH : 0 < H) (hC : 0 ≤ C) (hN : 0 < N) (j : Fin 3)
    (hHS : H ≤ 2 * (C * N ^ expo j)) :
    ∀ (s : ℕ) {f : E3 → ℂ}, Nice f → (∀ y, ‖f y‖ ≤ 1) → (∀ y, y ∉ petBox C N → f y = 0) →
      (locUnifPow N H j s f).re ^ 2 ≤ 16 * C ^ 3 * (locUnifPow N H j (s + 1) f).re := by
  intro s
  induction s with
  | zero =>
      intro f hf hf1 hsupp
      exact sq_re_locUnifPow_zero_le hH hC hN j hHS hf hf1 hsupp
  | succ s ih =>
      intro f hf hf1 hsupp
      have hNne : N ≠ 0 := hN.ne'
      have hwm : Measurable fun z : ℝ => (locUnifPow N H j s (fdiff (basisVec j) z f)).re :=
        measurable_locUnifPow_fdiff hH j s hf hf1
      have hum : Measurable fun z : ℝ =>
          (locUnifPow N H j (s + 1) (fdiff (basisVec j) z f)).re :=
        measurable_locUnifPow_fdiff hH j (s + 1) hf hf1
      have hMw : ∀ z : ℝ, |(locUnifPow N H j s (fdiff (basisVec j) z f)).re|
          ≤ |((N : ℝ) ^ (6 : ℕ))⁻¹| * ∫ x : E3, ‖f x‖ := fun z =>
        le_trans (Complex.abs_re_le_norm _) (norm_locUnifPow_fdiff_le hH j s hf hf1 z)
      have hMu : ∀ z : ℝ, |(locUnifPow N H j (s + 1) (fdiff (basisVec j) z f)).re|
          ≤ |((N : ℝ) ^ (6 : ℕ))⁻¹| * ∫ x : E3, ‖f x‖ := fun z =>
        le_trans (Complex.abs_re_le_norm _) (norm_locUnifPow_fdiff_le hH j (s + 1) hf hf1 z)
      have hptw : ∀ z : ℝ, (locUnifPow N H j s (fdiff (basisVec j) z f)).re ^ 2
          ≤ 16 * C ^ 3 * (locUnifPow N H j (s + 1) (fdiff (basisVec j) z f)).re := by
        intro z
        refine ih (nice_fdiff _ z hf) (fun y => norm_fdiff_le _ z hf1 y) ?_
        intro y hy
        rw [fdiff, hsupp y hy, map_zero, mul_zero]
      calc (locUnifPow N H j (s + 1) f).re ^ 2
          = (∫ z : ℝ, fejer H z * (locUnifPow N H j s (fdiff (basisVec j) z f)).re) ^ 2 := by
            rw [re_locUnifPow_succ_split hH hNne j s hf hf1]
        _ ≤ ∫ z : ℝ, fejer H z * (locUnifPow N H j s (fdiff (basisVec j) z f)).re ^ 2 :=
            sq_integral_fejer_le hH hwm hMw
        _ ≤ ∫ z : ℝ, fejer H z
              * (16 * C ^ 3 * (locUnifPow N H j (s + 1) (fdiff (basisVec j) z f)).re) := by
            refine integral_mono ?_ ?_ fun z =>
              mul_le_mul_of_nonneg_left (hptw z) (fejer_nonneg hH z)
            · refine integrable_fejer_mul hH (hwm.pow_const 2)
                (M := (|((N : ℝ) ^ (6 : ℕ))⁻¹| * ∫ x : E3, ‖f x‖) ^ 2) fun t => ?_
              rw [abs_pow]
              exact pow_le_pow_left₀ (abs_nonneg _) (hMw t) 2
            · refine integrable_fejer_mul hH (measurable_const.mul hum)
                (M := 16 * C ^ 3 * (|((N : ℝ) ^ (6 : ℕ))⁻¹| * ∫ x : E3, ‖f x‖)) fun t => ?_
              rw [abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ 16 * C ^ 3)]
              exact mul_le_mul_of_nonneg_left (hMu t) (by positivity)
        _ = 16 * C ^ 3 * ∫ z : ℝ, fejer H z
              * (locUnifPow N H j (s + 1) (fdiff (basisVec j) z f)).re := by
            rw [← integral_const_mul]
            exact integral_congr_ae (Filter.Eventually.of_forall fun z => by ring)
        _ = 16 * C ^ 3 * (locUnifPow N H j (s + 1 + 1) f).re := by
            rw [re_locUnifPow_succ_split hH hNne j (s + 1) hf hf1]

open MeasureTheory in
/-- The order-one instance, which is the one `patch:energy-to-u2` uses. -/
theorem sq_re_locUnifPow_one_le {C N H : ℝ} (hH : 0 < H) (hC : 0 ≤ C) (hN : 0 < N) (j : Fin 3)
    (hHS : H ≤ 2 * (C * N ^ expo j)) {f : E3 → ℂ} (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1)
    (hsupp : ∀ y, y ∉ petBox C N → f y = 0) :
    (locUnifPow N H j 1 f).re ^ 2 ≤ 16 * C ^ 3 * (locUnifPow N H j 2 f).re :=
  sq_re_locUnifPow_le hH hC hN j hHS 1 hf hf1 hsupp


open MeasureTheory in
/-- The order-`s` power is bounded by the normalized `L^1` norm of the input: the zero vertex of the
cube dominates the integrand, and the Fejer cube is a probability density. This is the
`fdiff`-free companion of `Auto.norm_locUnifPow_fdiff_le`. -/
theorem norm_locUnifPow_le_L1 {N H : ℝ} (hH : 0 < H) (j : Fin 3) (s : ℕ) {f : E3 → ℂ}
    (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) :
    ‖locUnifPow N H j s f‖ ≤ |((N : ℝ) ^ (6 : ℕ))⁻¹| * ∫ x : E3, ‖f x‖ := by
  set L : ℝ := ∫ x : E3, ‖f x‖ with hL
  have hL0 : 0 ≤ L := integral_nonneg fun _ => norm_nonneg _
  have hcube : ∀ h' : Fin s → ℝ, ‖∫ x : E3, fdiffIter (basisVec j) s h' f x‖ ≤ L := by
    intro h'
    refine le_trans (norm_integral_le_integral_norm _) ?_
    rw [hL]
    exact integral_mono_of_nonneg (Filter.Eventually.of_forall fun x => norm_nonneg _)
      hf.integrable.norm
      (Filter.Eventually.of_forall fun x => norm_fdiffIter_le_self _ s h' hf1 x)
  have hint : ‖∫ h' : Fin s → ℝ, ((fejerCube H h' : ℝ) : ℂ)
      * ∫ x : E3, fdiffIter (basisVec j) s h' f x‖ ≤ L := by
    refine le_trans (norm_integral_le_integral_norm _) ?_
    have hmono : (∫ h' : Fin s → ℝ, ‖((fejerCube H h' : ℝ) : ℂ)
        * ∫ x : E3, fdiffIter (basisVec j) s h' f x‖)
        ≤ ∫ h' : Fin s → ℝ, fejerCube H h' * L := by
      refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun h' => norm_nonneg _)
        ((integrable_fejerCube hH s).mul_const L)
        (Filter.Eventually.of_forall fun h' => ?_)
      change ‖((fejerCube H h' : ℝ) : ℂ) * ∫ x : E3, fdiffIter (basisVec j) s h' f x‖
          ≤ fejerCube H h' * L
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (fejerCube_nonneg hH h')]
      exact mul_le_mul_of_nonneg_left (hcube h') (fejerCube_nonneg hH h')
    refine le_trans hmono (le_of_eq ?_)
    rw [integral_mul_const, integral_fejerCube hH s, one_mul]
  rw [locUnifPow_swap hH j s hf hf1, norm_mul]
  refine (mul_le_mul_of_nonneg_left hint (norm_nonneg _)).trans (le_of_eq ?_)
  congr 1
  rw [← Complex.ofReal_pow, ← Complex.ofReal_inv, Complex.norm_real, Real.norm_eq_abs]

open MeasureTheory in
/-- A one-bounded function supported in `I_N(C)` has `L^1` norm at most the volume of the box. -/
theorem integral_norm_le_of_petBox {C N : ℝ} (hC : 0 ≤ C) (hN : 0 ≤ N) {f : E3 → ℂ}
    (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) (hsupp : ∀ y, y ∉ petBox C N → f y = 0) :
    (∫ x : E3, ‖f x‖) ≤ 8 * C ^ 3 * N ^ 6 := by
  have hz : ∀ x : E3, x ∉ petBox C N → ‖f x‖ = 0 := fun x hx => by rw [hsupp x hx, norm_zero]
  have hvol : volume (petBox C N) = ENNReal.ofReal (8 * C ^ 3 * N ^ 6) := volume_petBox hC hN
  have : IsFiniteMeasure (volume.restrict (petBox C N)) := by
    constructor
    rw [Measure.restrict_apply_univ, hvol]
    exact ENNReal.ofReal_lt_top
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero hz]
  calc (∫ x in petBox C N, ‖f x‖)
      ≤ ∫ _x in petBox C N, (1 : ℝ) :=
        setIntegral_mono_on hf.integrable.norm.integrableOn (integrable_const 1)
          (measurableSet_petBox C N) fun x _ => hf1 x
    _ = (volume (petBox C N)).toReal := by
        rw [setIntegral_const]
        simp [MeasureTheory.Measure.real]
    _ = 8 * C ^ 3 * N ^ 6 := by rw [hvol, ENNReal.toReal_ofReal (by positivity)]

open MeasureTheory in
/-- **`patch:fejer-squares`, the bounds**: for a one-bounded input supported in `I_N(C)`,
every order-`s` power satisfies `0 <= Q_s <= |B_N|/N^6 = 8 C^3`.

The lower bound is `Auto.locUnifPow_re_nonneg` -- positivity coming from the integrated square, as
the patch insists, before any kernel is compared with another. The upper bound is the zero vertex
of the cube together with the Fejer cube being a probability density. -/
theorem re_locUnifPow_nonneg_le {C N H : ℝ} (hH : 0 < H) (hC : 0 ≤ C) (hN : 0 < N) (j : Fin 3)
    (s : ℕ) {f : E3 → ℂ} (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1)
    (hsupp : ∀ y, y ∉ petBox C N → f y = 0) :
    0 ≤ (locUnifPow N H j (s + 1) f).re ∧ (locUnifPow N H j s f).re ≤ 8 * C ^ 3 := by
  refine ⟨locUnifPow_re_nonneg hH hN j s hf hf1, ?_⟩
  have hNne : N ≠ 0 := hN.ne'
  refine le_trans (le_trans (le_abs_self _) (Complex.abs_re_le_norm _)) ?_
  refine le_trans (norm_locUnifPow_le_L1 hH j s hf hf1) ?_
  rw [abs_of_nonneg (by positivity : (0 : ℝ) ≤ ((N : ℝ) ^ (6 : ℕ))⁻¹)]
  calc ((N : ℝ) ^ (6 : ℕ))⁻¹ * ∫ x : E3, ‖f x‖
      ≤ ((N : ℝ) ^ (6 : ℕ))⁻¹ * (8 * C ^ 3 * N ^ 6) :=
        mul_le_mul_of_nonneg_left (integral_norm_le_of_petBox hC hN.le hf hf1 hsupp)
          (by positivity)
    _ = 8 * C ^ 3 := by field_simp


open MeasureTheory in
/-- The inner Fejer average at a fixed cube parameter is the `L^2` norm of a window average, hence
a real number. This is `Auto.integral_fejer_pairAvg_eq_sq` applied to the iterated difference. -/
theorem innerFejer_eq_ofReal {H : ℝ} (hH : 0 < H) (v : E3) (s : ℕ) {f : E3 → ℂ} (hf : Nice f)
    (h : Fin s → ℝ) :
    innerFejer H v s f h
      = ((∫ x : E3, ‖winAvg H v (fdiffIter v s h f) x‖ ^ 2 : ℝ) : ℂ) := by
  rw [innerFejer]
  have hcongr : (∫ t : ℝ, ((fejer H t : ℝ) : ℂ) * pairAvg v (fdiffIter v s h f) t)
      = ∫ t : ℝ, fejer H t • pairAvg v (fdiffIter v s h f) t := by
    refine integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
    change ((fejer H t : ℝ) : ℂ) * pairAvg v (fdiffIter v s h f) t
        = fejer H t • pairAvg v (fdiffIter v s h f) t
    rw [Complex.real_smul]
  rw [hcongr, integral_fejer_pairAvg_eq_sq hH v (nice_fdiffIter v s h hf)]

open MeasureTheory in
/-- **`patch:fejer-squares`, reality**: every order-`s` power with `s >= 1` is a real number.
Together with `Auto.locUnifPow_re_nonneg` this is the patch's "every order-`s` cube power above is
real and nonnegative", and it is established from the integrated square, before any comparison of
kernels. -/
theorem im_locUnifPow_succ {N H : ℝ} (hH : 0 < H) (j : Fin 3) (s : ℕ) {f : E3 → ℂ}
    (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) :
    (locUnifPow N H j (s + 1) f).im = 0 := by
  have hcast : ((N ^ (6 : ℕ))⁻¹ : ℂ) = (((N ^ (6 : ℕ))⁻¹ : ℝ) : ℂ) := by push_cast; ring
  have hint : (∫ h : Fin s → ℝ, ((fejerCube H h : ℝ) : ℂ) * innerFejer H (basisVec j) s f h)
      = ((∫ h : Fin s → ℝ, fejerCube H h
          * ∫ x : E3, ‖winAvg H (basisVec j) (fdiffIter (basisVec j) s h f) x‖ ^ 2 : ℝ) : ℂ) := by
    rw [← integral_complex_ofReal]
    refine integral_congr_ae (Filter.Eventually.of_forall fun h => ?_)
    change ((fejerCube H h : ℝ) : ℂ) * innerFejer H (basisVec j) s f h
        = ((fejerCube H h
            * ∫ x : E3, ‖winAvg H (basisVec j) (fdiffIter (basisVec j) s h f) x‖ ^ 2 : ℝ) : ℂ)
    rw [innerFejer_eq_ofReal hH _ s hf h]
    push_cast
    ring
  rw [locUnifPow_succ_eq hH j s hf hf1, hcast, hint, ← Complex.ofReal_mul, Complex.ofReal_im]


/-! ## `blueprints/task_2_patch_3_updated.tex`, stage 1: budget arithmetic and popularity

`patch:budgets` fixes what the patch's `delta^{O(1)}` notation means -- a returned integer `c`,
  never
an asymptotic statement -- and records the composition rules that let every budget in the proof be
assembled from finitely many of them. The patch is explicit that the integers are to be retained
rather than replaced by asymptotic notation, so the two budget functions are named here and the
composition rules are stated as inequalities between them.

The second half of the lemma is the measure-theoretic content: a function with a lower bound on its
integral is large on a set of controlled measure, deleting a small set costs little, and a finite
partition has a heavy cell. -/

/-- The patch's lower budget `ell_c(delta) = c^{-1} delta^c`. -/
noncomputable def budLo (c : ℕ) (δ : ℝ) : ℝ := ((c : ℝ))⁻¹ * δ ^ c

/-- The patch's upper budget `u_c(delta) = c delta^{-c}`. -/
noncomputable def budHi (c : ℕ) (δ : ℝ) : ℝ := (c : ℝ) * (δ ^ c)⁻¹

theorem budLo_pos {δ : ℝ} (hδ : 0 < δ) {c : ℕ} (hc : 1 ≤ c) : 0 < budLo c δ := by
  have hc0 : (0 : ℝ) < (c : ℝ) := by exact_mod_cast hc
  rw [budLo]
  positivity

theorem budHi_pos {δ : ℝ} (hδ : 0 < δ) {c : ℕ} (hc : 1 ≤ c) : 0 < budHi c δ := by
  have hc0 : (0 : ℝ) < (c : ℝ) := by exact_mod_cast hc
  rw [budHi]
  positivity

/-- Enlarging the budget weakens a lower bound. -/
theorem budLo_antitone {δ : ℝ} (hδ0 : 0 < δ) (hδ1 : δ ≤ 1) {c c' : ℕ} (hc : 1 ≤ c)
    (hcc : c ≤ c') : budLo c' δ ≤ budLo c δ := by
  have hc0 : (0 : ℝ) < (c : ℝ) := by exact_mod_cast hc
  have hc0' : (0 : ℝ) < (c' : ℝ) := by exact_mod_cast le_trans hc hcc
  refine mul_le_mul ?_ (pow_le_pow_of_le_one hδ0.le hδ1 hcc) (by positivity) (by positivity)
  exact (inv_le_inv₀ hc0' hc0).mpr (by exact_mod_cast hcc)

/-- Enlarging the budget weakens an upper bound. -/
theorem budHi_monotone {δ : ℝ} (hδ0 : 0 < δ) (hδ1 : δ ≤ 1) {c c' : ℕ} (hc : 1 ≤ c)
    (hcc : c ≤ c') : budHi c δ ≤ budHi c' δ := by
  have hc0 : (0 : ℝ) < (c : ℝ) := by exact_mod_cast hc
  have hc0' : (0 : ℝ) < (c' : ℝ) := by exact_mod_cast le_trans hc hcc
  have hpow : (0 : ℝ) < δ ^ c' := by positivity
  have hpow' : (0 : ℝ) < δ ^ c := by positivity
  refine mul_le_mul (by exact_mod_cast hcc) ?_ (by positivity) (by positivity)
  exact (inv_le_inv₀ hpow' hpow).mpr (pow_le_pow_of_le_one hδ0.le hδ1 hcc)

/-- **A product of two lower budgets is a lower budget**, with the patch's recipe
`c >= max (a b) (a + b)`. -/
theorem budLo_mul {δ : ℝ} (hδ0 : 0 < δ) (hδ1 : δ ≤ 1) {a b c : ℕ} (ha : 1 ≤ a) (hb : 1 ≤ b)
    (hc1 : a * b ≤ c) (hc2 : a + b ≤ c) : budLo c δ ≤ budLo a δ * budLo b δ := by
  have ha0 : (0 : ℝ) < (a : ℝ) := by exact_mod_cast ha
  have hb0 : (0 : ℝ) < (b : ℝ) := by exact_mod_cast hb
  have hab0 : (0 : ℝ) < (a : ℝ) * (b : ℝ) := by positivity
  have hc0 : (0 : ℝ) < (c : ℝ) := by
    have : 1 ≤ c := le_trans ha (le_trans (Nat.le_mul_of_pos_right a hb) hc1)
    exact_mod_cast this
  have heq : budLo a δ * budLo b δ = ((a : ℝ) * (b : ℝ))⁻¹ * δ ^ (a + b) := by
    rw [budLo, budLo, pow_add, mul_inv]
    ring
  rw [heq, budLo]
  refine mul_le_mul ?_ (pow_le_pow_of_le_one hδ0.le hδ1 hc2) (by positivity) (by positivity)
  refine (inv_le_inv₀ hc0 hab0).mpr ?_
  calc (a : ℝ) * (b : ℝ) = ((a * b : ℕ) : ℝ) := by push_cast; ring
    _ ≤ (c : ℝ) := by exact_mod_cast hc1

/-- **A fixed natural power of a lower budget is a lower budget**, with the patch's recipe
`c >= max (a^r) (r a)`. -/
theorem budLo_pow {δ : ℝ} (hδ0 : 0 < δ) (hδ1 : δ ≤ 1) {a c r : ℕ} (ha : 1 ≤ a) (hr : 1 ≤ r)
    (hc1 : a ^ r ≤ c) (hc2 : r * a ≤ c) : budLo c δ ≤ budLo a δ ^ r := by
  have ha0 : (0 : ℝ) < (a : ℝ) := by exact_mod_cast ha
  have har : (0 : ℝ) < (a : ℝ) ^ r := by positivity
  have hc0 : (0 : ℝ) < (c : ℝ) := by
    have : 1 ≤ c := le_trans ha (le_trans (Nat.le_mul_of_pos_left a hr) hc2)
    exact_mod_cast this
  have heq : budLo a δ ^ r = ((a : ℝ) ^ r)⁻¹ * δ ^ (r * a) := by
    rw [budLo, mul_pow, ← pow_mul, inv_pow]
    ring_nf
  rw [heq, budLo]
  refine mul_le_mul ?_ (pow_le_pow_of_le_one hδ0.le hδ1 hc2) (by positivity) (by positivity)
  refine (inv_le_inv₀ hc0 har).mpr ?_
  calc (a : ℝ) ^ r = ((a ^ r : ℕ) : ℝ) := by push_cast; ring
    _ ≤ (c : ℝ) := by exact_mod_cast hc1

open MeasureTheory in
/-- The integral of a constant over a set, in the form the budget estimates use. -/
theorem setIntegral_const_real {α : Type*} [MeasurableSpace α] {μ : Measure α} (S : Set α)
    (c : ℝ) : (∫ _x in S, c ∂μ) = (μ S).toReal * c := by
  rw [setIntegral_const, smul_eq_mul]
  rfl

open MeasureTheory in
/-- **Deleting a small set costs little**: if `0 <= F <= B` then removing `S` loses at most
`B * mu S`. -/
theorem le_setIntegral_compl_add {α : Type*} [MeasurableSpace α] {μ : Measure α}
    [IsFiniteMeasure μ] {F : α → ℝ} (hFm : Measurable F) (hF0 : ∀ x, 0 ≤ F x) {B : ℝ}
    (hFB : ∀ x, F x ≤ B) {S : Set α} (hS : MeasurableSet S) :
    (∫ x, F x ∂μ) ≤ (∫ x in Sᶜ, F x ∂μ) + (μ S).toReal * B := by
  have hFi : Integrable F μ :=
    Integrable.mono' (integrable_const B) hFm.aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => by
        rw [Real.norm_eq_abs, abs_of_nonneg (hF0 x)]; exact hFB x)
  have hsplit : (∫ x, F x ∂μ) = (∫ x in S, F x ∂μ) + ∫ x in Sᶜ, F x ∂μ :=
    (integral_add_compl hS hFi).symm
  have hle : (∫ x in S, F x ∂μ) ≤ (μ S).toReal * B := by
    calc (∫ x in S, F x ∂μ) ≤ ∫ _x in S, B ∂μ :=
          setIntegral_mono_on hFi.integrableOn (integrable_const B) hS fun x _ => hFB x
      _ = (μ S).toReal * B := setIntegral_const_real S B
  rw [hsplit]
  linarith

open MeasureTheory in
/-- **Popularity**, the second half of `patch:budgets`: if `mu` has total mass at most `M`,
`0 <= F <= B`, and `int F >= a > 0`, then `F >= a/(2M)` on a set of measure at least `a/(2B)`. -/
theorem measure_popular_ge {α : Type*} [MeasurableSpace α] {μ : Measure α} [IsFiniteMeasure μ]
    {F : α → ℝ} (hFm : Measurable F) (hF0 : ∀ x, 0 ≤ F x) {B : ℝ} (hFB : ∀ x, F x ≤ B)
    {M : ℝ} (hM : 0 < M) (hMμ : (μ Set.univ).toReal ≤ M) {a : ℝ} (ha : 0 < a)
    (hint : a ≤ ∫ x, F x ∂μ) :
    a / (2 * B) ≤ (μ {x | a / (2 * M) ≤ F x}).toReal := by
  have hFi : Integrable F μ :=
    Integrable.mono' (integrable_const B) hFm.aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => by
        rw [Real.norm_eq_abs, abs_of_nonneg (hF0 x)]; exact hFB x)
  have hEm : MeasurableSet {x | a / (2 * M) ≤ F x} := measurableSet_le measurable_const hFm
  have hBpos : 0 < B := by
    by_contra hcon
    push Not at hcon
    have hzero : ∀ x, F x = 0 := fun x => le_antisymm (le_trans (hFB x) hcon) (hF0 x)
    have hz : (∫ x, F x ∂μ) = 0 := by simp [hzero]
    linarith
  have hsplit : (∫ x, F x ∂μ)
      = (∫ x in {x | a / (2 * M) ≤ F x}, F x ∂μ)
        + ∫ x in {x | a / (2 * M) ≤ F x}ᶜ, F x ∂μ :=
    (integral_add_compl hEm hFi).symm
  have hEle : (∫ x in {x | a / (2 * M) ≤ F x}, F x ∂μ)
      ≤ (μ {x | a / (2 * M) ≤ F x}).toReal * B := by
    calc (∫ x in {x | a / (2 * M) ≤ F x}, F x ∂μ)
        ≤ ∫ _x in {x | a / (2 * M) ≤ F x}, B ∂μ :=
          setIntegral_mono_on hFi.integrableOn (integrable_const B) hEm fun x _ => hFB x
      _ = (μ {x | a / (2 * M) ≤ F x}).toReal * B := setIntegral_const_real _ B
  have hCle : (∫ x in {x | a / (2 * M) ≤ F x}ᶜ, F x ∂μ) ≤ a / 2 := by
    have hpt : ∀ x ∈ {x | a / (2 * M) ≤ F x}ᶜ, F x ≤ a / (2 * M) := by
      intro x hx
      exact le_of_not_ge fun hcon => hx hcon
    have hmass : (μ {x | a / (2 * M) ≤ F x}ᶜ).toReal ≤ M :=
      le_trans (ENNReal.toReal_mono (measure_ne_top μ _) (measure_mono (Set.subset_univ _))) hMμ
    have hcoef : (0 : ℝ) ≤ a / (2 * M) := by positivity
    calc (∫ x in {x | a / (2 * M) ≤ F x}ᶜ, F x ∂μ)
        ≤ ∫ _x in {x | a / (2 * M) ≤ F x}ᶜ, a / (2 * M) ∂μ :=
          setIntegral_mono_on hFi.integrableOn (integrable_const _) hEm.compl hpt
      _ = (μ {x | a / (2 * M) ≤ F x}ᶜ).toReal * (a / (2 * M)) := setIntegral_const_real _ _
      _ ≤ M * (a / (2 * M)) := mul_le_mul_of_nonneg_right hmass hcoef
      _ = a / 2 := by field_simp
  rw [div_le_iff₀ (by positivity : (0 : ℝ) < 2 * B)]
  rw [hsplit] at hint
  linarith

/-- **A finite partition has a heavy cell**: if a nonnegative family on a nonempty finite index set
has total mass at least `T`, some member is at least `T / K`. -/
theorem exists_cell_ge {ι : Type*} {s : Finset ι} (hs : s.Nonempty) {g : ι → ℝ} {T : ℝ}
    (hT : T ≤ ∑ i ∈ s, g i) : ∃ i ∈ s, T / (s.card : ℝ) ≤ g i := by
  by_contra hcon
  push Not at hcon
  have hcard : (0 : ℝ) < (s.card : ℝ) := by exact_mod_cast Finset.card_pos.mpr hs
  have hsum : ∑ i ∈ s, g i < ∑ _i ∈ s, T / (s.card : ℝ) :=
    Finset.sum_lt_sum_of_nonempty hs fun i hi => hcon i hi
  rw [Finset.sum_const, nsmul_eq_mul, mul_div_cancel₀ _ hcard.ne'] at hsum
  linarith


/-! ## `patch:energy-to-u2`, the last step: the multiplier of the window average

The remaining step of `patch:energy-to-u2` is `‖P_L^{(j)} f‖_2 <= c ‖T_{H,j} f‖_2`. The route taken
here avoids `L^2` Fourier theory entirely -- see `automation/ErrorReport.md` at 2026-09-16T03:05 --
and its first ingredient is the multiplier of the window average,
    m_H(v) = H^{-1} ∫_0^H e(v a) da,

together with the elementary fact that it stays away from zero at low frequency. With the patch's
choice `H = 1/(8L)` and `|v| <= L/2` the hypotheses below read `2 pi |v| H <= pi/8 <= 1` and
`2 pi H |v| <= pi/8 <= 1/2`, so both are satisfied with room to spare. -/

/-- The Fourier multiplier of the window average `Auto.winAvg`. -/
noncomputable def winMult (H v : ℝ) : ℂ :=
  (H : ℂ)⁻¹ * ∫ a in (0 : ℝ)..H, Complex.exp (((2 * Real.pi * v * a : ℝ) : ℂ) * Complex.I)

open MeasureTheory in
/-- **The multiplier is close to one at low frequency**: `|m_H(v) - 1| <= 2 pi H |v|`. -/
theorem norm_winMult_sub_one_le {H : ℝ} (hH : 0 < H) {v : ℝ}
    (hsmall : 2 * Real.pi * |v| * H ≤ 1) :
    ‖winMult H v - 1‖ ≤ 2 * Real.pi * H * |v| := by
  have hone : ((H : ℂ))⁻¹ * ∫ _a in (0 : ℝ)..H, (1 : ℂ) = 1 := by
    rw [intervalIntegral.integral_const, sub_zero, Complex.real_smul, ← mul_assoc,
      inv_mul_cancel₀ (Complex.ofReal_ne_zero.mpr hH.ne'), one_mul]
  have hsplit : (∫ a in (0 : ℝ)..H,
        (Complex.exp (((2 * Real.pi * v * a : ℝ) : ℂ) * Complex.I) - 1))
      = (∫ a in (0 : ℝ)..H, Complex.exp (((2 * Real.pi * v * a : ℝ) : ℂ) * Complex.I))
        - ∫ _a in (0 : ℝ)..H, (1 : ℂ) :=
    intervalIntegral.integral_sub (Continuous.intervalIntegrable (by fun_prop) _ _)
      intervalIntegrable_const
  have hsub : winMult H v - 1
      = ((H : ℂ))⁻¹ * ∫ a in (0 : ℝ)..H,
          (Complex.exp (((2 * Real.pi * v * a : ℝ) : ℂ) * Complex.I) - 1) := by
    rw [hsplit, mul_sub, hone, winMult]
  have hpt : ∀ a ∈ Set.Icc (0 : ℝ) H,
      ‖Complex.exp (((2 * Real.pi * v * a : ℝ) : ℂ) * Complex.I) - 1‖
        ≤ 2 * (2 * Real.pi * |v| * a) := by
    intro a ha
    have hnorm : ‖((2 * Real.pi * v * a : ℝ) : ℂ) * Complex.I‖ = 2 * Real.pi * |v| * a := by
      rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs,
        abs_mul, abs_mul, abs_of_nonneg ha.1,
        abs_of_nonneg (by positivity : (0 : ℝ) ≤ 2 * Real.pi)]
    have hle1 : ‖((2 * Real.pi * v * a : ℝ) : ℂ) * Complex.I‖ ≤ 1 := by
      rw [hnorm]
      exact le_trans (mul_le_mul_of_nonneg_left ha.2 (by positivity)) hsmall
    have h := Complex.norm_exp_sub_one_le hle1
    rwa [hnorm] at h
  have hgint : (∫ a in (0 : ℝ)..H, 2 * (2 * Real.pi * |v| * a))
      = 2 * Real.pi * |v| * H ^ 2 := by
    have hfun : (fun a : ℝ => 2 * (2 * Real.pi * |v| * a))
        = fun a : ℝ => (4 * Real.pi * |v|) * a := by
      funext a
      ring
    rw [hfun, intervalIntegral.integral_const_mul, integral_id]
    ring
  have hfinal : ‖∫ a in (0 : ℝ)..H,
      (Complex.exp (((2 * Real.pi * v * a : ℝ) : ℂ) * Complex.I) - 1)‖
      ≤ 2 * Real.pi * |v| * H ^ 2 := by
    refine le_trans (intervalIntegral.norm_integral_le_integral_norm hH.le) ?_
    exact le_trans (intervalIntegral.integral_mono_on hH.le
      (Continuous.intervalIntegrable (by fun_prop) _ _)
      (Continuous.intervalIntegrable (by fun_prop) _ _) hpt) (le_of_eq hgint)
  rw [hsub, norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hH.le]
  calc H⁻¹ * ‖∫ a in (0 : ℝ)..H,
        (Complex.exp (((2 * Real.pi * v * a : ℝ) : ℂ) * Complex.I) - 1)‖
      ≤ H⁻¹ * (2 * Real.pi * |v| * H ^ 2) :=
        mul_le_mul_of_nonneg_left hfinal (by positivity)
    _ = 2 * Real.pi * H * |v| := by field_simp

/-- **The multiplier stays away from zero at low frequency.** This is the plateau estimate that
makes `eta(./L) / m_H` a bounded smooth function. -/
theorem half_le_norm_winMult {H : ℝ} (hH : 0 < H) {v : ℝ}
    (hsmall : 2 * Real.pi * |v| * H ≤ 1) (hhalf : 2 * Real.pi * H * |v| ≤ 1 / 2) :
    1 / 2 ≤ ‖winMult H v‖ := by
  have htri : ‖(1 : ℂ)‖ ≤ ‖winMult H v‖ + ‖winMult H v - 1‖ := by
    have h := norm_sub_le (winMult H v) (winMult H v - 1)
    simpa using h
  rw [norm_one] at htri
  linarith [norm_winMult_sub_one_le hH hsmall]


/-! ### The window average as a convolution, and its multiplier

To compare `P_L^{(j)}` with `T_{H,j}` through kernels rather than through `L^2` Fourier theory, the
window average has to be presented the way `Auto.P` already is: as convolution in the `j`-th
coordinate with an `L^1` kernel. That kernel is the normalized indicator of `(-H, 0]`, and its
Fourier transform is `Auto.winMult`. -/

/-- The convolution kernel of the window average: `H^{-1} 1_{(-H, 0]}`. -/
noncomputable def winKer (H : ℝ) (u : ℝ) : ℂ :=
  (H : ℂ)⁻¹ * (Set.Ioc (-H) (0 : ℝ)).indicator (fun _ => (1 : ℂ)) u

open MeasureTheory in
theorem winKer_integrable (H : ℝ) : Integrable (winKer H) := by
  have hbase : Integrable ((Set.Ioc (-H) (0 : ℝ)).indicator fun _ => (1 : ℂ)) :=
    (integrable_indicator_iff measurableSet_Ioc).mpr (integrable_const 1)
  exact hbase.const_mul _

open MeasureTheory in
/-- The reflection `u = -a` that turns the forward window `[0, H]` into the kernel window
`(-H, 0]`. -/
theorem integral_Ioc_neg_window {H : ℝ} (hH : 0 < H) (G : ℝ → ℂ) :
    (∫ u in Set.Ioc (-H) (0 : ℝ), G u) = ∫ a in (0 : ℝ)..H, G (-a) := by
  have h1 := intervalIntegral.integral_comp_neg (a := (0 : ℝ)) (b := H) (f := G)
  rw [neg_zero] at h1
  rw [h1, intervalIntegral.integral_of_le (by linarith : (-H : ℝ) ≤ 0)]

open MeasureTheory in
/-- **The window average is a convolution**, in the same shape as `Auto.P`. -/
theorem winAvg_eq_kernel {H : ℝ} (hH : 0 < H) (v : E3) (f : E3 → ℂ) (x : E3) :
    winAvg H v f x = ∫ u : ℝ, winKer H u * f (x - u • v) := by
  have hpt : ∀ u : ℝ, winKer H u * f (x - u • v)
      = (H : ℂ)⁻¹ * (Set.Ioc (-H) (0 : ℝ)).indicator (fun w : ℝ => f (x - w • v)) u := by
    intro u
    rw [winKer]
    by_cases hu : u ∈ Set.Ioc (-H) (0 : ℝ)
    · rw [Set.indicator_of_mem hu, Set.indicator_of_mem hu]
      ring
    · rw [Set.indicator_of_notMem hu, Set.indicator_of_notMem hu]
      ring
  rw [integral_congr_ae (Filter.Eventually.of_forall hpt), integral_const_mul,
    integral_indicator measurableSet_Ioc,
    integral_Ioc_neg_window hH (fun u : ℝ => f (x - u • v)), winAvg]
  refine congrArg _ (intervalIntegral.integral_congr fun a _ => ?_)
  simp [neg_smul, sub_neg_eq_add]

open MeasureTheory in
/-- **The transform of the kernel is the multiplier.** -/
theorem fourier_winKer {H : ℝ} (hH : 0 < H) (v : ℝ) : 𝓕 (winKer H) v = winMult H v := by
  rw [Real.fourier_real_eq_integral_exp_smul]
  have hpt : ∀ u : ℝ,
      Complex.exp (((-2 * Real.pi * u * v : ℝ) : ℂ) * Complex.I) • winKer H u
        = (H : ℂ)⁻¹ * (Set.Ioc (-H) (0 : ℝ)).indicator
            (fun w : ℝ => Complex.exp (((-2 * Real.pi * w * v : ℝ) : ℂ) * Complex.I)) u := by
    intro u
    rw [smul_eq_mul, winKer]
    by_cases hu : u ∈ Set.Ioc (-H) (0 : ℝ)
    · rw [Set.indicator_of_mem hu, Set.indicator_of_mem hu]
      ring
    · rw [Set.indicator_of_notMem hu, Set.indicator_of_notMem hu]
      ring
  rw [integral_congr_ae (Filter.Eventually.of_forall hpt), integral_const_mul,
    integral_indicator measurableSet_Ioc,
    integral_Ioc_neg_window hH
      (fun w : ℝ => Complex.exp (((-2 * Real.pi * w * v : ℝ) : ℂ) * Complex.I)),
    winMult]
  refine congrArg _ (intervalIntegral.integral_congr fun a _ => ?_)
  have harg : ((-2 * Real.pi * (-a) * v : ℝ) : ℂ) = ((2 * Real.pi * v * a : ℝ) : ℂ) := by
    push_cast
    ring
  rw [harg]


open MeasureTheory in
/-- A one-bounded function supported in `I_N(C)` has `L^1` norm at most the volume of the box. -/
theorem integral_norm_le_volume_petBox {C N : ℝ} (hC : 0 ≤ C) (hN : 0 ≤ N) {f : E3 → ℂ}
    (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1) (hsupp : ∀ y, y ∉ petBox C N → f y = 0) :
    (∫ x : E3, ‖f x‖) ≤ 8 * C ^ 3 * N ^ 6 := by
  have hvol : volume (petBox C N) = ENNReal.ofReal (8 * C ^ 3 * N ^ 6) := volume_petBox hC hN
  have : IsFiniteMeasure (volume.restrict (petBox C N)) := by
    constructor
    rw [Measure.restrict_apply_univ, hvol]
    exact ENNReal.ofReal_lt_top
  have hind : Integrable ((petBox C N).indicator fun _ : E3 => (1 : ℝ)) :=
    (integrable_indicator_iff (measurableSet_petBox C N)).mpr (integrable_const 1)
  have hle : ∀ x : E3, ‖f x‖ ≤ (petBox C N).indicator (fun _ : E3 => (1 : ℝ)) x := by
    intro x
    by_cases hx : x ∈ petBox C N
    · rw [Set.indicator_of_mem hx]
      exact hf1 x
    · rw [Set.indicator_of_notMem hx, hsupp x hx, norm_zero]
  calc (∫ x : E3, ‖f x‖)
      ≤ ∫ x : E3, (petBox C N).indicator (fun _ : E3 => (1 : ℝ)) x :=
        integral_mono hf.integrable.norm hind hle
    _ = (volume (petBox C N)).toReal := by
        rw [integral_indicator (measurableSet_petBox C N), setIntegral_const_real, mul_one]
    _ = 8 * C ^ 3 * N ^ 6 := by
        rw [hvol, ENNReal.toReal_ofReal (by positivity)]

open MeasureTheory in
/-- **`patch:fejer-squares`, the range of the cube power.** The patch normalizes by the support
volume `V` and states `0 <= Q_s <= 1`; the file normalizes by `N^6`, so the upper bound is the ratio
`|B_N| / N^6 = 8 C^3`. Its source is the zero vertex of the cube: `|C_s(f; x, h)| <= 1_B(x)`. -/
theorem norm_locUnifPow_le_box {C N H : ℝ} (hH : 0 < H) (hC : 0 ≤ C) (hN : 0 < N) (j : Fin 3)
    (s : ℕ) {f : E3 → ℂ} (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1)
    (hsupp : ∀ y, y ∉ petBox C N → f y = 0) :
    ‖locUnifPow N H j s f‖ ≤ 8 * C ^ 3 := by
  have hN6 : (0 : ℝ) < N ^ (6 : ℕ) := by positivity
  have h1 := norm_locUnifPow_le_L1 (N := N) hH j s hf hf1
  rw [abs_of_pos (by positivity : (0 : ℝ) < ((N : ℝ) ^ (6 : ℕ))⁻¹)] at h1
  calc ‖locUnifPow N H j s f‖ ≤ ((N : ℝ) ^ (6 : ℕ))⁻¹ * ∫ x : E3, ‖f x‖ := h1
    _ ≤ ((N : ℝ) ^ (6 : ℕ))⁻¹ * (8 * C ^ 3 * N ^ 6) :=
        mul_le_mul_of_nonneg_left (integral_norm_le_volume_petBox hC hN.le hf hf1 hsupp)
          (by positivity)
    _ = 8 * C ^ 3 := by field_simp

open MeasureTheory in
/-- The real part of the cube power lies in `[0, 8 C^3]`: nonnegative because it is an integrated
square (`Auto.locUnifPow_re_nonneg`), bounded by the zero vertex. -/
theorem re_locUnifPow_mem_range {C N H : ℝ} (hH : 0 < H) (hC : 0 ≤ C) (hN : 0 < N) (j : Fin 3)
    (s : ℕ) {f : E3 → ℂ} (hf : Nice f) (hf1 : ∀ y, ‖f y‖ ≤ 1)
    (hsupp : ∀ y, y ∉ petBox C N → f y = 0) :
    0 ≤ (locUnifPow N H j (s + 1) f).re ∧ (locUnifPow N H j (s + 1) f).re ≤ 8 * C ^ 3 :=
  ⟨locUnifPow_re_nonneg hH hN j s hf hf1,
    le_trans (le_trans (le_abs_self _) (Complex.abs_re_le_norm _))
      (norm_locUnifPow_le_box hH hC hN j (s + 1) hf hf1 hsupp)⟩


/-! ## `blueprints/task_2_patch_3_updated.tex`, stage 2: signed integrated removal

`patch:signed-vdc` is the van der Corput step with the spatial variable retained, so that what comes
out is a *real part* of an averaged correlation rather than its modulus -- the patch is explicit
that it "is not obtained by deleting an absolute value from `fejer_vdc'`".

Its first move is the one recorded here: the factor `g`, which does not depend on the averaging
variable, is removed by Cauchy-Schwarz in `x` alone. The pairing inequality itself is already in
the file as `Auto.sq_norm_integral_mul_le`; what is added is its normalized form, with the patch's
`V` in place. -/

open MeasureTheory in
/-- **The removal of the parameter-free factor**, the first move of `patch:signed-vdc`:
with `∫ ‖g‖^2 <= V`, the normalized pairing obeys `|A|^2 <= V^{-1} ∫ ‖Φ‖^2`. -/
theorem sq_norm_normalized_pairing_le {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {g Φ : α → ℂ} (hg2 : Integrable (fun x => ‖g x‖ ^ 2) μ)
    (hΦ2 : Integrable (fun x => ‖Φ x‖ ^ 2) μ) (hgΦ : Integrable (fun x => ‖g x‖ * ‖Φ x‖) μ)
    {V : ℝ} (hV : 0 < V) (hgV : (∫ x, ‖g x‖ ^ 2 ∂μ) ≤ V) :
    ‖(V⁻¹ : ℝ) • ∫ x, g x * Φ x ∂μ‖ ^ 2 ≤ V⁻¹ * ∫ x, ‖Φ x‖ ^ 2 ∂μ := by
  have hΦ0 : 0 ≤ ∫ x, ‖Φ x‖ ^ 2 ∂μ := integral_nonneg fun _ => by positivity
  have hnorm : ‖(V⁻¹ : ℝ) • ∫ x, g x * Φ x ∂μ‖ ^ 2
      = (V⁻¹) ^ 2 * ‖∫ x, g x * Φ x ∂μ‖ ^ 2 := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hV), mul_pow]
  rw [hnorm]
  calc (V⁻¹) ^ 2 * ‖∫ x, g x * Φ x ∂μ‖ ^ 2
      ≤ (V⁻¹) ^ 2 * ((∫ x, ‖g x‖ ^ 2 ∂μ) * ∫ x, ‖Φ x‖ ^ 2 ∂μ) :=
        mul_le_mul_of_nonneg_left (sq_norm_integral_mul_le hg2 hΦ2 hgΦ) (by positivity)
    _ ≤ (V⁻¹) ^ 2 * (V * ∫ x, ‖Φ x‖ ^ 2 ∂μ) := by
        refine mul_le_mul_of_nonneg_left ?_ (by positivity)
        exact mul_le_mul_of_nonneg_right hgV hΦ0
    _ = V⁻¹ * ∫ x, ‖Φ x‖ ^ 2 ∂μ := by
        field_simp


/-! ### `patch:signed-vdc`: the window keeps the mass, on the line

This unparks the lemma left aside on 2026-09-15: `int_R S_u du = int_I F_t dt`, the statement that
the window average does not change the total integral. It is the one-dimensional twin of
`Auto.integral_winAvg`, and `patch:signed-vdc` uses it exactly as `patch:energy-to-u2` uses that
one -- to know that the Cauchy-Schwarz on the window's support still sees the full mass. -/

open MeasureTheory in
/-- Joint integrability of `(u, s) ↦ W (u + s)` over the line times the window. -/
theorem integrable_shift_prod_line {H : ℝ} (_hH : 0 < H) {W : ℝ → ℂ} (hWm : Measurable W)
    (hWi : Integrable W) :
    Integrable (Function.uncurry fun (u s : ℝ) => W (u + s))
      ((volume : Measure ℝ).prod (volume.restrict (Set.Ioc (0 : ℝ) H))) := by
  have hmeas : Measurable (Function.uncurry fun (u s : ℝ) => W (u + s)) :=
    hWm.comp (measurable_fst.add measurable_snd)
  have hne : (∫⁻ u : ℝ, ‖W u‖ₑ) ≠ ⊤ := hWi.hasFiniteIntegral.ne
  refine ⟨hmeas.aestronglyMeasurable, ?_⟩
  rw [hasFiniteIntegral_iff_enorm]
  simp only [Function.uncurry]
  have hstep : (∫⁻ z : ℝ × ℝ, ‖W (z.1 + z.2)‖ₑ
        ∂((volume : Measure ℝ).prod (volume.restrict (Set.Ioc (0 : ℝ) H))))
      = ∫⁻ _s in Set.Ioc (0 : ℝ) H, ∫⁻ u : ℝ, ‖W u‖ₑ := by
    rw [lintegral_prod_symm' _ (by fun_prop)]
    refine lintegral_congr fun s => ?_
    exact lintegral_add_right_eq_self (fun u : ℝ => ‖W u‖ₑ) s
  rw [hstep, setLIntegral_const, Real.volume_Ioc]
  exact ENNReal.mul_lt_top (lt_top_iff_ne_top.mpr hne) ENNReal.ofReal_lt_top

open MeasureTheory in
/-- **The window average keeps the mass**: `∫ S = ∫ W`. -/
theorem integral_windowAvg {H : ℝ} (hH : 0 < H) {W : ℝ → ℂ} (hWm : Measurable W)
    (hWi : Integrable W) : (∫ u : ℝ, windowAvg H W u) = ∫ u : ℝ, W u := by
  have hL : (∫ u : ℝ, windowAvg H W u)
      = (H⁻¹ : ℂ) * ∫ u : ℝ, ∫ s in (0 : ℝ)..H, W (u + s) := by
    rw [← integral_const_mul]
    exact integral_congr_ae (Filter.Eventually.of_forall fun u => rfl)
  have hswap : (∫ u : ℝ, ∫ s in (0 : ℝ)..H, W (u + s))
      = ∫ s in (0 : ℝ)..H, ∫ u : ℝ, W (u + s) := by
    simp_rw [intervalIntegral.integral_of_le hH.le]
    exact integral_integral_swap (integrable_shift_prod_line hH hWm hWi)
  have hinner : ∀ s : ℝ, (∫ u : ℝ, W (u + s)) = ∫ u : ℝ, W u :=
    fun s => integral_add_right_eq_self W s
  rw [hL, hswap]
  simp_rw [hinner]
  rw [intervalIntegral.integral_const, sub_zero, Complex.real_smul, ← mul_assoc,
    show (H⁻¹ : ℂ) * (H : ℂ) = 1 by
      have hHne : (H : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hH.ne'
      field_simp,
    one_mul]


/-! ### `patch:signed-vdc`: the exchanges on the line

The square expansion with the spatial variable retained needs the same three exchanges the file
already carries for `E3` (`Auto.integral_swap_interval`, `Auto.integrable_shift_pair_prod`,
`Auto.integral_swap_double`), but with the line in place of `E3` and with `Auto.Nice` replaced by
"measurable, integrable and bounded" -- the class `patch:signed-vdc` actually supplies. -/

open MeasureTheory in
/-- **Exchanging an integral over the line with an integral over the window.** -/
theorem integral_swap_interval_line {H : ℝ} (hH : 0 < H) (F : ℝ → ℝ → ℂ)
    (hint : Integrable (Function.uncurry F)
      ((volume : Measure ℝ).prod (volume.restrict (Set.Ioc (0 : ℝ) H)))) :
    (∫ u : ℝ, ∫ a in (0 : ℝ)..H, F u a) = ∫ a in (0 : ℝ)..H, ∫ u : ℝ, F u a := by
  simp_rw [intervalIntegral.integral_of_le hH.le]
  exact integral_integral_swap hint

open MeasureTheory in
/-- Joint integrability of the shifted pair, the second shift held fixed. -/
theorem integrable_shift_pair_prod_line {H : ℝ} (hH : 0 < H) {W : ℝ → ℂ} (hWm : Measurable W)
    (hWi : Integrable W) {M : ℝ} (hWb : ∀ t, ‖W t‖ ≤ M) (b : ℝ) :
    Integrable (Function.uncurry fun (u a : ℝ) => W (u + a) * (starRingEnd ℂ) (W (u + b)))
      ((volume : Measure ℝ).prod (volume.restrict (Set.Ioc (0 : ℝ) H))) := by
  have hM0 : 0 ≤ M := le_trans (norm_nonneg _) (hWb 0)
  have hbase := (integrable_shift_prod_line hH hWm hWi).norm.const_mul M
  have hmeas : Measurable (Function.uncurry fun (u a : ℝ) =>
      W (u + a) * (starRingEnd ℂ) (W (u + b))) :=
    (hWm.comp (measurable_fst.add measurable_snd)).mul
      (Complex.continuous_conj.measurable.comp (hWm.comp (measurable_fst.add measurable_const)))
  refine Integrable.mono' hbase hmeas.aestronglyMeasurable
    (Filter.Eventually.of_forall fun z => ?_)
  change ‖W (z.1 + z.2) * (starRingEnd ℂ) (W (z.1 + b))‖ ≤ M * ‖W (z.1 + z.2)‖
  rw [norm_mul, RCLike.norm_conj, mul_comm]
  exact mul_le_mul_of_nonneg_right (hWb _) (norm_nonneg _)

open MeasureTheory in
/-- Joint integrability of the shifted pair, the first shift held fixed. -/
theorem integrable_shift_pair_prod_line' {H : ℝ} (hH : 0 < H) {W : ℝ → ℂ} (hWm : Measurable W)
    (hWi : Integrable W) {M : ℝ} (hWb : ∀ t, ‖W t‖ ≤ M) (a : ℝ) :
    Integrable (Function.uncurry fun (u b : ℝ) => W (u + a) * (starRingEnd ℂ) (W (u + b)))
      ((volume : Measure ℝ).prod (volume.restrict (Set.Ioc (0 : ℝ) H))) := by
  have hM0 : 0 ≤ M := le_trans (norm_nonneg _) (hWb 0)
  have hbase := (integrable_shift_prod_line hH hWm hWi).norm.const_mul M
  have hmeas : Measurable (Function.uncurry fun (u b : ℝ) =>
      W (u + a) * (starRingEnd ℂ) (W (u + b))) :=
    (hWm.comp (measurable_fst.add measurable_const)).mul
      (Complex.continuous_conj.measurable.comp (hWm.comp (measurable_fst.add measurable_snd)))
  refine Integrable.mono' hbase hmeas.aestronglyMeasurable
    (Filter.Eventually.of_forall fun z => ?_)
  change ‖W (z.1 + a) * (starRingEnd ℂ) (W (z.1 + z.2))‖ ≤ M * ‖W (z.1 + z.2)‖
  rw [norm_mul, RCLike.norm_conj]
  exact mul_le_mul_of_nonneg_right (hWb _) (norm_nonneg _)

open MeasureTheory in
/-- **The paired integral on the line depends only on the difference of the shifts.** -/
theorem integral_shift_pair_line (W : ℝ → ℂ) (a b : ℝ) :
    (∫ u : ℝ, W (u + a) * (starRingEnd ℂ) (W (u + b)))
      = ∫ u : ℝ, W (u + (a - b)) * (starRingEnd ℂ) (W u) := by
  rw [← integral_add_right_eq_self
    (fun u : ℝ => W (u + (a - b)) * (starRingEnd ℂ) (W u)) b]
  refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
  change W (u + a) * (starRingEnd ℂ) (W (u + b))
      = W (u + b + (a - b)) * (starRingEnd ℂ) (W (u + b))
  have hu : u + b + (a - b) = u + a := by ring
  rw [hu]

open MeasureTheory in
/-- The paired integral on the line is `Auto.autocorr` at the difference of the shifts. -/
theorem autocorr_eq_shift_pair (W : ℝ → ℂ) (a b : ℝ) :
    autocorr W (a - b) = ∫ u : ℝ, W (u + a) * (starRingEnd ℂ) (W (u + b)) :=
  (integral_shift_pair_line W a b).symm


/-! ### `patch:signed-vdc`: the double exchange on the line -/

open MeasureTheory in
theorem norm_shiftAvg_line_le {W : ℝ → ℂ} {M : ℝ} (hW : ∀ t, ‖W t‖ ≤ M) {H : ℝ} (hH : 0 ≤ H)
    (u : ℝ) : ‖∫ a in (0 : ℝ)..H, W (u + a)‖ ≤ M * H := by
  have hb := intervalIntegral.norm_integral_le_of_norm_le_const
    (C := M) (a := (0 : ℝ)) (b := H) (f := fun a => W (u + a)) fun a _ => hW _
  simpa [abs_of_nonneg hH] using hb

open MeasureTheory in
/-- The inner shift integral, carried out. -/
theorem integral_inner_shift_line (W : ℝ → ℂ) (H a u : ℝ) :
    (∫ b in (0 : ℝ)..H, W (u + a) * (starRingEnd ℂ) (W (u + b)))
      = W (u + a) * (starRingEnd ℂ) (∫ b in (0 : ℝ)..H, W (u + b)) := by
  rw [intervalIntegral.integral_const_mul]
  congr 1
  simp only [intervalIntegral, map_sub, ← integral_conj]

open MeasureTheory in
/-- **The exchange in the second shift**, on the line. -/
theorem integral_swap_shift_line' {H : ℝ} (hH : 0 < H) {W : ℝ → ℂ} (hWm : Measurable W)
    (hWi : Integrable W) {M : ℝ} (hWb : ∀ t, ‖W t‖ ≤ M) (a : ℝ) :
    (∫ u : ℝ, ∫ b in (0 : ℝ)..H, W (u + a) * (starRingEnd ℂ) (W (u + b)))
      = ∫ b in (0 : ℝ)..H, ∫ u : ℝ, W (u + a) * (starRingEnd ℂ) (W (u + b)) :=
  integral_swap_interval_line hH _ (integrable_shift_pair_prod_line' hH hWm hWi hWb a)

open MeasureTheory in
/-- **The exchange in the first shift**, the second having been carried out. -/
theorem integral_swap_outer_line {H : ℝ} (hH : 0 < H) {W : ℝ → ℂ} (hWm : Measurable W)
    (hWi : Integrable W) {M : ℝ} (hWb : ∀ t, ‖W t‖ ≤ M) :
    (∫ a in (0 : ℝ)..H, ∫ u : ℝ, ∫ b in (0 : ℝ)..H,
        W (u + a) * (starRingEnd ℂ) (W (u + b)))
      = ∫ u : ℝ, ∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H,
        W (u + a) * (starRingEnd ℂ) (W (u + b)) := by
  have hM0 : 0 ≤ M := le_trans (norm_nonneg _) (hWb 0)
  have hSmeas : StronglyMeasurable fun u : ℝ => ∫ b in (0 : ℝ)..H, W (u + b) :=
    stronglyMeasurable_shiftAvg' hWm hH.le
  have hmeasU : Measurable (Function.uncurry fun (u a : ℝ) => W (u + a)) :=
    hWm.comp (measurable_fst.add measurable_snd)
  have hmeasG : AEStronglyMeasurable (Function.uncurry fun (u a : ℝ) =>
      W (u + a) * (starRingEnd ℂ) (∫ b in (0 : ℝ)..H, W (u + b)))
      ((volume : Measure ℝ).prod (volume.restrict (Set.Ioc (0 : ℝ) H))) :=
    hmeasU.aestronglyMeasurable.mul
      (Complex.continuous_conj.comp_aestronglyMeasurable
        (hSmeas.aestronglyMeasurable.comp_fst))
  have hdom : Integrable (fun p : ℝ × ℝ => M * H * ‖W (p.1 + p.2)‖)
      ((volume : Measure ℝ).prod (volume.restrict (Set.Ioc (0 : ℝ) H))) :=
    ((integrable_shift_prod_line hH hWm hWi).norm).const_mul (M * H)
  have hintG : Integrable (Function.uncurry fun (u a : ℝ) =>
      W (u + a) * (starRingEnd ℂ) (∫ b in (0 : ℝ)..H, W (u + b)))
      ((volume : Measure ℝ).prod (volume.restrict (Set.Ioc (0 : ℝ) H))) := by
    refine hdom.mono' hmeasG (Filter.Eventually.of_forall fun p => ?_)
    rw [Function.uncurry_apply_pair, norm_mul, RCLike.norm_conj, mul_comm (M * H)]
    exact mul_le_mul_of_nonneg_left (norm_shiftAvg_line_le hWb hH.le p.1) (norm_nonneg _)
  simp_rw [integral_inner_shift_line W H]
  exact (integral_swap_interval_line hH _ hintG).symm

open MeasureTheory in
/-- **The double exchange**, on the line. -/
theorem integral_swap_double_line {H : ℝ} (hH : 0 < H) {W : ℝ → ℂ} (hWm : Measurable W)
    (hWi : Integrable W) {M : ℝ} (hWb : ∀ t, ‖W t‖ ≤ M) :
    (∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H, ∫ u : ℝ,
        W (u + a) * (starRingEnd ℂ) (W (u + b)))
      = ∫ u : ℝ, ∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H,
        W (u + a) * (starRingEnd ℂ) (W (u + b)) := by
  have h1 : ∀ a : ℝ,
      (∫ b in (0 : ℝ)..H, ∫ u : ℝ, W (u + a) * (starRingEnd ℂ) (W (u + b)))
        = ∫ u : ℝ, ∫ b in (0 : ℝ)..H, W (u + a) * (starRingEnd ℂ) (W (u + b)) :=
    fun a => (integral_swap_shift_line' hH hWm hWi hWb a).symm
  simp_rw [h1]
  exact integral_swap_outer_line hH hWm hWi hWb


open MeasureTheory in
/-- The autocorrelation on the line is strongly measurable. -/
theorem stronglyMeasurable_autocorr {W : ℝ → ℂ} (hWm : Measurable W) :
    StronglyMeasurable (autocorr W) := by
  have hjoint : StronglyMeasurable fun z : ℝ × ℝ => W (z.2 + z.1) * (starRingEnd ℂ) (W z.2) :=
    ((hWm.comp (measurable_snd.add measurable_fst)).mul
      (Complex.continuous_conj.measurable.comp (hWm.comp measurable_snd))).stronglyMeasurable
  exact hjoint.integral_prod_right'

open MeasureTheory in
/-- The autocorrelation is bounded by `M ‖W‖_1`. -/
theorem norm_autocorr_le {W : ℝ → ℂ} (hWm : Measurable W) (hWi : Integrable W) {M : ℝ}
    (hWb : ∀ t, ‖W t‖ ≤ M) (h : ℝ) : ‖autocorr W h‖ ≤ M * ∫ t : ℝ, ‖W t‖ := by
  have hM0 : 0 ≤ M := le_trans (norm_nonneg _) (hWb 0)
  have hdom : Integrable fun t : ℝ => M * ‖W t‖ := hWi.norm.const_mul M
  have hmeas : Measurable fun t : ℝ => ‖W (t + h) * (starRingEnd ℂ) (W t)‖ :=
    ((hWm.comp (measurable_id.add measurable_const)).mul
      (Complex.continuous_conj.measurable.comp hWm)).norm
  have hptw : ∀ t : ℝ, ‖W (t + h) * (starRingEnd ℂ) (W t)‖ ≤ M * ‖W t‖ := by
    intro t
    rw [norm_mul, RCLike.norm_conj]
    exact mul_le_mul_of_nonneg_right (hWb _) (norm_nonneg _)
  have hint : Integrable fun t : ℝ => W (t + h) * (starRingEnd ℂ) (W t) := by
    refine Integrable.mono' hdom
      (((hWm.comp (measurable_id.add measurable_const)).mul
        (Complex.continuous_conj.measurable.comp hWm))).aestronglyMeasurable
      (Filter.Eventually.of_forall hptw)
  calc ‖autocorr W h‖ ≤ ∫ t : ℝ, ‖W (t + h) * (starRingEnd ℂ) (W t)‖ :=
        norm_integral_le_integral_norm _
    _ ≤ ∫ t : ℝ, M * ‖W t‖ :=
        integral_mono (hint.norm.congr (Filter.Eventually.of_forall fun t => rfl)) hdom
          (fun t => by simpa using hptw t)
    _ = M * ∫ t : ℝ, ‖W t‖ := integral_const_mul _ _

theorem norm_windowAvg_sq {H : ℝ} (hH : 0 < H) (W : ℝ → ℂ) (u : ℝ) :
    ‖windowAvg H W u‖ ^ 2 = (H ^ 2)⁻¹ * ‖∫ s in (0 : ℝ)..H, W (u + s)‖ ^ 2 := by
  rw [windowAvg, norm_mul, mul_pow]
  congr 1
  rw [show ((H⁻¹ : ℂ)) = ((H : ℂ))⁻¹ by ring, norm_inv, Complex.norm_real,
    Real.norm_of_nonneg hH.le, inv_pow]

open MeasureTheory in
/-- **The Fejer square identity on the line**: `patch:fejer-squares` in ambient dimension one. -/
theorem integral_fejer_autocorr_eq_sq {H : ℝ} (hH : 0 < H) {W : ℝ → ℂ} (hWm : Measurable W)
    (hWi : Integrable W) {M : ℝ} (hWb : ∀ t, ‖W t‖ ≤ M) :
    (∫ h : ℝ, fejer H h • autocorr W h)
      = ((∫ u : ℝ, ‖windowAvg H W u‖ ^ 2 : ℝ) : ℂ) := by
  have hdouble := integral_double_sub_eq_fejer hH (stronglyMeasurable_autocorr hWm).measurable
    (norm_autocorr_le hWm hWi hWb)
  have hL : (∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H, autocorr W (a - b))
      = ((∫ u : ℝ, ‖∫ s in (0 : ℝ)..H, W (u + s)‖ ^ 2 : ℝ) : ℂ) := by
    simp_rw [autocorr_eq_shift_pair]
    rw [integral_swap_double_line hH hWm hWi hWb, ← integral_complex_ofReal]
    refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
    change (∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H,
          W (u + a) * (starRingEnd ℂ) (W (u + b)))
        = ((‖∫ s in (0 : ℝ)..H, W (u + s)‖ ^ 2 : ℝ) : ℂ)
    rw [← integral_mul_conj_integral (fun a => W (u + a)), Complex.mul_conj,
      Complex.normSq_eq_norm_sq]
  rw [hL] at hdouble
  have hsmul : ((∫ u : ℝ, ‖windowAvg H W u‖ ^ 2 : ℝ) : ℂ)
      = ((H ^ 2)⁻¹ : ℝ) • ((∫ u : ℝ, ‖∫ s in (0 : ℝ)..H, W (u + s)‖ ^ 2 : ℝ) : ℂ) := by
    rw [Complex.real_smul, ← Complex.ofReal_mul]
    congr 1
    rw [← integral_const_mul]
    exact integral_congr_ae (Filter.Eventually.of_forall fun u => norm_windowAvg_sq hH W u)
  rw [hsmul, hdouble, smul_smul, inv_mul_cancel₀ (by positivity : (H : ℝ) ^ 2 ≠ 0), one_smul]


open MeasureTheory in
/-- The window average of a bounded function carried
  by an interval lies in every `L^p`, `p >= 1`. -/
theorem integrable_norm_pow_windowAvg {c N H M : ℝ} (hH : 0 < H) {W : ℝ → ℂ}
    (hWi : Integrable W) (hWb : ∀ t, ‖W t‖ ≤ M)
    (hsupp : ∀ t, t ∉ Set.Ioc c (c + N) → W t = 0) (p : ℕ) :
    Integrable fun u : ℝ => ‖windowAvg H W u‖ ^ (p + 1) := by
  have hM0 : 0 ≤ M := le_trans (norm_nonneg _) (hWb 0)
  have hSm : MeasurableSet (Set.Ioc (c - H) (c + N)) := measurableSet_Ioc
  have : IsFiniteMeasure (volume.restrict (Set.Ioc (c - H) (c + N))) := by
    constructor
    rw [Measure.restrict_apply_univ, Real.volume_Ioc]
    exact ENNReal.ofReal_lt_top
  have hmeas : Measurable fun u : ℝ => ‖windowAvg H W u‖ ^ (p + 1) :=
    ((measurable_windowAvg fun r s => hWi.intervalIntegrable).norm).pow_const _
  refine Integrable.mono' (g := Set.indicator (Set.Ioc (c - H) (c + N)) fun _ => M ^ (p + 1)) ?_
    hmeas.aestronglyMeasurable (Filter.Eventually.of_forall fun u => ?_)
  · exact (integrable_indicator_iff hSm).mpr (integrable_const _)
  · by_cases hu : u ∈ Set.Ioc (c - H) (c + N)
    · rw [Set.indicator_of_mem hu, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
      exact pow_le_pow_left₀ (norm_nonneg _) (norm_windowAvg_le hH hWb u) _
    · rw [Set.indicator_of_notMem hu, windowAvg_eq_zero_of_notMem hH.le hsupp hu, norm_zero,
        zero_pow (Nat.succ_ne_zero p), norm_zero]

open MeasureTheory in
theorem integrable_norm_windowAvg {c N H M : ℝ} (hH : 0 < H) {W : ℝ → ℂ}
    (hWi : Integrable W) (hWb : ∀ t, ‖W t‖ ≤ M)
    (hsupp : ∀ t, t ∉ Set.Ioc c (c + N) → W t = 0) :
    Integrable fun u : ℝ => ‖windowAvg H W u‖ :=
  (integrable_norm_pow_windowAvg hH hWi hWb hsupp 0).congr
    (Filter.Eventually.of_forall fun _u => pow_one _)

open MeasureTheory in
/-- **The support Cauchy-Schwarz on the window**, the third move of `patch:signed-vdc`.

The window average has the same integral as `W` and is carried by an interval of length `N + H`, so
Cauchy-Schwarz on that interval bounds `|∫ W|^2` by `(N + H)` times its `L^2` norm -- which, by
`Auto.integral_fejer_autocorr_eq_sq`, is the Fejer average of the autocorrelation. The right-hand
side is real because it came from an integrated square. -/
theorem sq_norm_integral_le_fejer_autocorr {c N H : ℝ} (hN : 0 < N) (hH : 0 < H) {W : ℝ → ℂ}
    (hWm : Measurable W) {M : ℝ} (hWb : ∀ t, ‖W t‖ ≤ M)
    (hsupp : ∀ t, t ∉ Set.Ioc c (c + N) → W t = 0) :
    ‖∫ u : ℝ, W u‖ ^ 2 ≤ (N + H) * (∫ h : ℝ, fejer H h • autocorr W h).re := by
  have hWi : Integrable W := integrable_of_bdd_support hWm hWb hsupp
  have hSm : MeasurableSet (Set.Ioc (c - H) (c + N)) := measurableSet_Ioc
  have hvol : volume (Set.Ioc (c - H) (c + N)) = ENNReal.ofReal (N + H) := by
    rw [Real.volume_Ioc]
    congr 1
    ring
  have hfin : volume (Set.Ioc (c - H) (c + N)) ≠ ⊤ := by
    rw [hvol]
    exact ENNReal.ofReal_ne_top
  have hCS := sq_norm_integral_le_measure_mul hSm hfin
    (F := fun u : ℝ => windowAvg H W u)
    (fun u hu => windowAvg_eq_zero_of_notMem hH.le hsupp hu)
    (integrable_norm_pow_windowAvg hH hWi hWb hsupp 1)
    (integrable_norm_windowAvg hH hWi hWb hsupp)
  rw [integral_windowAvg hH hWm hWi] at hCS
  have hsq : (∫ h : ℝ, fejer H h • autocorr W h).re
      = ∫ u : ℝ, ‖windowAvg H W u‖ ^ 2 := by
    rw [integral_fejer_autocorr_eq_sq hH hWm hWi hWb, Complex.ofReal_re]
  have hlen : (volume (Set.Ioc (c - H) (c + N))).toReal = N + H := by
    rw [hvol, ENNReal.toReal_ofReal (by linarith : (0 : ℝ) ≤ N + H)]
  rw [hsq]
  rw [hlen] at hCS
  exact hCS


open MeasureTheory in
theorem measurableSet_capSet (c N h : ℝ) : MeasurableSet (capSet c N h) :=
  measurableSet_Ioc.inter measurableSet_Ioc

open MeasureTheory in
/-- **The cut-off window is the intersected interval.** With `W = 1_I F`, the autocorrelation of
`W` is exactly the paired integral over `I ∩ (I - h)`, so `Auto.capPair` and `Auto.autocorr` are the
same object seen from the two sides of `patch:signed-vdc`. -/
theorem autocorr_indicator_eq_capPair (F : ℝ → ℂ) (c N h : ℝ) :
    autocorr ((Set.Ioc c (c + N)).indicator F) h = capPair F c N h := by
  rw [autocorr, capPair, ← integral_indicator (measurableSet_capSet c N h)]
  refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
  change (Set.Ioc c (c + N)).indicator F (u + h)
        * (starRingEnd ℂ) ((Set.Ioc c (c + N)).indicator F u)
      = (capSet c N h).indicator (fun t => F (t + h) * (starRingEnd ℂ) (F t)) u
  by_cases hu : u ∈ capSet c N h
  · obtain ⟨hu1, hu2⟩ := hu
    have hsh : u + h ∈ Set.Ioc c (c + N) := by
      obtain ⟨h1, h2⟩ := hu2
      exact ⟨by linarith, by linarith⟩
    rw [Set.indicator_of_mem hsh, Set.indicator_of_mem hu1,
      Set.indicator_of_mem (show u ∈ capSet c N h from ⟨hu1, hu2⟩)]
  · rw [Set.indicator_of_notMem hu]
    by_cases hu1 : u ∈ Set.Ioc c (c + N)
    · have hsh : u + h ∉ Set.Ioc c (c + N) := by
        intro hcon
        obtain ⟨h1, h2⟩ := hcon
        exact hu ⟨hu1, ⟨by linarith, by linarith⟩⟩
      rw [Set.indicator_of_notMem hsh, zero_mul]
    · rw [Set.indicator_of_notMem hu1, map_zero, mul_zero]

open MeasureTheory in
/-- **The cut-off replacement**, the last move of `patch:signed-vdc`: replacing `I ∩ (I - h)` by `I`
costs at most `|h|`, in the file's one-bounded normalization. -/
theorem norm_pairIntegral_sub_autocorr_le {F : ℝ → ℂ} (hFm : Measurable F)
    (hF : ∀ t, ‖F t‖ ≤ 1) {N : ℝ} (hN : 0 ≤ N) (c h : ℝ) :
    ‖(∫ t in c..(c + N), F (t + h) * (starRingEnd ℂ) (F t))
        - autocorr ((Set.Ioc c (c + N)).indicator F) h‖ ≤ |h| := by
  rw [autocorr_indicator_eq_capPair]
  exact norm_pairIntegral_sub_capPair_le' hFm hF hN c h


open MeasureTheory in
/-- **`patch:signed-vdc`, the support Cauchy-Schwarz with the parameter retained.**

The patch applies its window construction "with `x` retained and integrates in `x`".  Since
`Auto.sq_norm_integral_le_fejer_autocorr` holds for each parameter value separately, retaining the
parameter is integration of that inequality -- the integrability in `x` being, as the patch puts it,
"supplied, in applications, by bounded factors and their finite-support envelopes", so it is taken
here as an explicit hypothesis rather than reconstructed. -/
theorem integral_sq_norm_le_fejer_autocorr {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {c N H : ℝ} (hN : 0 < N) (hH : 0 < H) {W : α → ℝ → ℂ}
    (hWm : ∀ x, Measurable (W x)) {M : ℝ} (hWb : ∀ x t, ‖W x t‖ ≤ M)
    (hsupp : ∀ x t, t ∉ Set.Ioc c (c + N) → W x t = 0)
    (hL : Integrable (fun x => ‖∫ u : ℝ, W x u‖ ^ 2) μ)
    (hR : Integrable (fun x => (∫ h : ℝ, fejer H h • autocorr (W x) h).re) μ) :
    (∫ x, ‖∫ u : ℝ, W x u‖ ^ 2 ∂μ)
      ≤ (N + H) * ∫ x, (∫ h : ℝ, fejer H h • autocorr (W x) h).re ∂μ := by
  rw [← integral_const_mul]
  refine integral_mono hL (hR.const_mul _) fun x => ?_
  exact sq_norm_integral_le_fejer_autocorr hN hH (hWm x) (hWb x) (hsupp x)

open MeasureTheory in
/-- The same with the parameter's normalization `V` in place, which is the form
`patch:signed-vdc` chains onto its first move `Auto.sq_norm_normalized_pairing_le`. -/
theorem normalized_sq_norm_le_fejer_autocorr {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {c N H : ℝ} (hN : 0 < N) (hH : 0 < H) {W : α → ℝ → ℂ}
    (hWm : ∀ x, Measurable (W x)) {M : ℝ} (hWb : ∀ x t, ‖W x t‖ ≤ M)
    (hsupp : ∀ x t, t ∉ Set.Ioc c (c + N) → W x t = 0)
    (hL : Integrable (fun x => ‖∫ u : ℝ, W x u‖ ^ 2) μ)
    (hR : Integrable (fun x => (∫ h : ℝ, fejer H h • autocorr (W x) h).re) μ)
    {V : ℝ} (hV : 0 < V) :
    V⁻¹ * ∫ x, ‖∫ u : ℝ, W x u‖ ^ 2 ∂μ
      ≤ (N + H) * (V⁻¹ * ∫ x, (∫ h : ℝ, fejer H h • autocorr (W x) h).re ∂μ) := by
  have hstep := integral_sq_norm_le_fejer_autocorr hN hH hWm hWb hsupp hL hR
  calc V⁻¹ * ∫ x, ‖∫ u : ℝ, W x u‖ ^ 2 ∂μ
      ≤ V⁻¹ * ((N + H) * ∫ x, (∫ h : ℝ, fejer H h • autocorr (W x) h).re ∂μ) :=
        mul_le_mul_of_nonneg_left hstep (by positivity)
    _ = (N + H) * (V⁻¹ * ∫ x, (∫ h : ℝ, fejer H h • autocorr (W x) h).re ∂μ) := by ring


open MeasureTheory in
/-- **The Cauchy-Schwarz behind the cut-off cost of `patch:signed-vdc`.**

The patch justifies its `|h|/N` by "`∫ |F(x,t) conj(F(x,t+h))| dx <= V` by Cauchy-Schwarz", from the
hypothesis `∫ |F(x,s)|^2 dx <= V` at each parameter value. That step is this lemma, applied with
`G = F(., t+h)` and `K = F(., t)`. -/
theorem integral_mul_norm_le_of_sq_le {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {G K : α → ℂ} (hG2 : Integrable (fun x => ‖G x‖ ^ 2) μ)
    (hK2 : Integrable (fun x => ‖K x‖ ^ 2) μ) (hGK : Integrable (fun x => ‖G x‖ * ‖K x‖) μ)
    {V : ℝ} (hV : 0 ≤ V) (hGV : (∫ x, ‖G x‖ ^ 2 ∂μ) ≤ V) (hKV : (∫ x, ‖K x‖ ^ 2 ∂μ) ≤ V) :
    (∫ x, ‖G x‖ * ‖K x‖ ∂μ) ≤ V := by
  have hK0 : 0 ≤ ∫ x, ‖K x‖ ^ 2 ∂μ := integral_nonneg fun _ => by positivity
  have hprod : (∫ x, ‖G x‖ ^ 2 ∂μ) * (∫ x, ‖K x‖ ^ 2 ∂μ) ≤ V * V :=
    mul_le_mul hGV hKV hK0 hV
  have hsq : (∫ x, ‖G x‖ * ‖K x‖ ∂μ) ^ 2 ≤ V * V :=
    le_trans (sq_integral_mul_le hG2 hK2 hGK) hprod
  have hnn : 0 ≤ ∫ x, ‖G x‖ * ‖K x‖ ∂μ := integral_nonneg fun _ => by positivity
  nlinarith [hsq, hnn, hV]

open MeasureTheory in
/-- The same conclusion for the complex pairing: `‖∫ G conj K‖ <= V`. -/
theorem norm_integral_mul_conj_le_of_sq_le {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {G K : α → ℂ} (hG2 : Integrable (fun x => ‖G x‖ ^ 2) μ)
    (hK2 : Integrable (fun x => ‖K x‖ ^ 2) μ) (hGK : Integrable (fun x => ‖G x‖ * ‖K x‖) μ)
    {V : ℝ} (hV : 0 ≤ V) (hGV : (∫ x, ‖G x‖ ^ 2 ∂μ) ≤ V) (hKV : (∫ x, ‖K x‖ ^ 2 ∂μ) ≤ V) :
    ‖∫ x, G x * (starRingEnd ℂ) (K x) ∂μ‖ ≤ V := by
  refine le_trans (norm_integral_le_integral_norm _) ?_
  have hpt : (∫ x, ‖G x * (starRingEnd ℂ) (K x)‖ ∂μ) = ∫ x, ‖G x‖ * ‖K x‖ ∂μ := by
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    change ‖G x * (starRingEnd ℂ) (K x)‖ = ‖G x‖ * ‖K x‖
    rw [norm_mul, RCLike.norm_conj]
  rw [hpt]
  exact integral_mul_norm_le_of_sq_le hG2 hK2 hGK hV hGV hKV


open MeasureTheory in
/-- The Fejer kernel against the shift size is integrable: on the kernel's support the product is at
most `H^{-1} * H = 1`. -/
theorem integrable_fejer_abs {H : ℝ} (hH : 0 < H) :
    Integrable fun h : ℝ => fejer H h * |h| := by
  have hfin : IsFiniteMeasure (volume.restrict (Set.Ioc (-H) H)) := by
    constructor
    rw [Measure.restrict_apply_univ, Real.volume_Ioc]
    exact ENNReal.ofReal_lt_top
  have hmeas : Measurable fun h : ℝ => fejer H h * |h| :=
    continuous_fejer.measurable.mul continuous_abs.measurable
  refine Integrable.mono' (g := Set.indicator (Set.Ioc (-H) H) fun _ => (1 : ℝ)) ?_
    hmeas.aestronglyMeasurable (Filter.Eventually.of_forall fun h => ?_)
  · exact (integrable_indicator_iff measurableSet_Ioc).mpr (integrable_const 1)
  · by_cases hin : h ∈ Set.Ioc (-H) H
    · obtain ⟨h1, h2⟩ := hin
      have habs : |h| ≤ H := abs_le.mpr ⟨by linarith, h2⟩
      rw [Set.indicator_of_mem (Set.mem_Ioc.mpr ⟨h1, h2⟩), Real.norm_eq_abs,
        abs_of_nonneg (mul_nonneg (fejer_nonneg hH h) (abs_nonneg h))]
      calc fejer H h * |h| ≤ H⁻¹ * H :=
            mul_le_mul (fejer_le_inv hH h) habs (abs_nonneg h) (by positivity)
        _ = 1 := inv_mul_cancel₀ hH.ne'
    · rw [Set.indicator_of_notMem hin, fejer_eq_zero_off hH hin, zero_mul, norm_zero]

open MeasureTheory in
/-- **The Fejer average of the shift size is at most `H`.** This is what turns the per-shift
cut-off cost `|h|` of `Auto.norm_pairIntegral_sub_autocorr_le` into the patch's `H/N`. -/
theorem integral_fejer_abs_le {H : ℝ} (hH : 0 < H) : (∫ h : ℝ, fejer H h * |h|) ≤ H := by
  have hptw : ∀ h : ℝ, fejer H h * |h| ≤ fejer H h * H := by
    intro h
    rcases le_or_gt |h| H with hle | hgt
    · exact mul_le_mul_of_nonneg_left hle (fejer_nonneg hH h)
    · rw [fejer_eq_zero_of_le hH hgt.le, zero_mul, zero_mul]
  calc (∫ h : ℝ, fejer H h * |h|) ≤ ∫ h : ℝ, fejer H h * H :=
        integral_mono (integrable_fejer_abs hH) ((integrable_fejer hH).mul_const H) hptw
    _ = H := by rw [integral_mul_const, integral_fejer hH, one_mul]


/-! ## `blueprints/task_2_patch_3_updated.tex`, stage 2: the cylinder Cauchy-Schwarz

`patch:cylinder` is the reusable Gowers-Cauchy-Schwarz induction, stated *with its state*: after `a`
steps the variables `b_1, ..., b_a` have been doubled into pairs `b_i^0, b_i^1`, and the running
quantity is
    J_a = E [ ∏_{ω ∈ {0,1}^a} C^{|ω|} v(z, b^ω) * ∏_{i > a} u_{i,a} ],
    b_i^ω = (1 - ω_i) b_i^0 + ω_i b_i^1.

This section supplies the selection `b^ω` and its structure. The conjugation parity `Auto.conjPar`
and the vertex bookkeeping `Auto.numTrue`, `Auto.numFalse`, `Auto.consBoolEquiv` are already in the
file, built for the Fejer cube of `def:local-uniformity`, and are reused here unchanged. -/

/-- **The cube selection of `patch:cylinder`**: `b^ω i` is `c i` where `ω i` holds and `b i`
elsewhere. With `b = b^0` and `c = b^1` this is the patch's
`b_i^ω = (1 - ω_i) b_i + ω_i c_i`. -/
def cubeSel {B : Type*} {r : ℕ} (ω : Fin r → Bool) (b c : Fin r → B) : Fin r → B :=
  fun i => if ω i then c i else b i

theorem cubeSel_apply {B : Type*} {r : ℕ} (ω : Fin r → Bool) (b c : Fin r → B) (i : Fin r) :
    cubeSel ω b c i = if ω i then c i else b i := rfl

@[simp] theorem cubeSel_const_false {B : Type*} {r : ℕ} (b c : Fin r → B) :
    cubeSel (fun _ => false) b c = b := by
  funext i
  simp [cubeSel]

@[simp] theorem cubeSel_const_true {B : Type*} {r : ℕ} (b c : Fin r → B) :
    cubeSel (fun _ => true) b c = c := by
  funext i
  simp [cubeSel]

/-- Selecting from a single family is that family. -/
@[simp] theorem cubeSel_self {B : Type*} {r : ℕ} (ω : Fin r → Bool) (b : Fin r → B) :
    cubeSel ω b b = b := by
  funext i
  rw [cubeSel_apply]
  cases hω : ω i <;> simp

/-- The selection splits off the last coordinate, which is how the induction of `patch:cylinder`
doubles one variable at a time. -/
theorem cubeSel_snoc {B : Type*} {r : ℕ} (σ : Fin r → Bool) (β : Bool)
    (b c : Fin (r + 1) → B) :
    cubeSel (Fin.snoc σ β) b c
      = Fin.snoc (cubeSel σ (fun i => b i.castSucc) (fun i => c i.castSucc))
          (if β then c (Fin.last r) else b (Fin.last r)) := by
  funext i
  refine Fin.lastCases ?_ ?_ i
  · simp [cubeSel_apply]
  · intro j
    simp [cubeSel_apply]

open MeasureTheory in
theorem measurable_cubeSel {B : Type*} [MeasurableSpace B] {r : ℕ} (ω : Fin r → Bool) :
    Measurable fun p : (Fin r → B) × (Fin r → B) => cubeSel ω p.1 p.2 := by
  refine Measurable.of_eval fun i => ?_
  have h1 : Measurable fun p : (Fin r → B) × (Fin r → B) => p.1 i :=
    (measurable_pi_apply i).comp measurable_fst
  have h2 : Measurable fun p : (Fin r → B) × (Fin r → B) => p.2 i :=
    (measurable_pi_apply i).comp measurable_snd
  cases hω : ω i
  · simpa [cubeSel_apply, hω] using h1
  · simpa [cubeSel_apply, hω] using h2


open MeasureTheory in
theorem measurePreserving_fst_self {B : Type*} [MeasurableSpace B] (ν : Measure B)
    [IsProbabilityMeasure ν] : MeasurePreserving (Prod.fst : B × B → B) (ν.prod ν) ν :=
  ⟨measurable_fst, by rw [Measure.map_fst_prod, measure_univ, one_smul]⟩

open MeasureTheory in
theorem measurePreserving_snd_self {B : Type*} [MeasurableSpace B] (ν : Measure B)
    [IsProbabilityMeasure ν] : MeasurePreserving (Prod.snd : B × B → B) (ν.prod ν) ν :=
  ⟨measurable_snd, by rw [Measure.map_snd_prod, measure_univ, one_smul]⟩

open MeasureTheory in
/-- **The doubling of `patch:cylinder` is measure preserving.**

Selecting the coordinates of a vertex `ω` from the doubled family returns the original product
measure. This is what makes each step of the induction an identity between expectations rather than
merely an inequality, and it is the reason the patch can say the doubled average "is precisely the
displayed next state". -/
theorem measurePreserving_cubeSel {B : Type*} [MeasurableSpace B] (ν : Measure B)
    [IsProbabilityMeasure ν] {r : ℕ} (ω : Fin r → Bool) :
    MeasurePreserving (fun p : (Fin r → B) × (Fin r → B) => cubeSel ω p.1 p.2)
      ((Measure.pi fun _ : Fin r => ν).prod (Measure.pi fun _ : Fin r => ν))
      (Measure.pi fun _ : Fin r => ν) := by
  have hcoord : ∀ i : Fin r,
      MeasurePreserving (fun q : B × B => if ω i then q.2 else q.1) (ν.prod ν) ν := by
    intro i
    cases hω : ω i
    · simpa [hω] using measurePreserving_fst_self ν
    · simpa [hω] using measurePreserving_snd_self ν
  have hpi := measurePreserving_pi (fun _ : Fin r => ν.prod ν) (fun _ : Fin r => ν) hcoord
  have harrow :=
    (measurePreserving_arrowProdEquivProdArrow B B (Fin r) (fun _ => ν) (fun _ => ν)).symm
      (MeasurableEquiv.arrowProdEquivProdArrow B B (Fin r))
  exact hpi.comp harrow


open MeasureTheory in
/-- A bounded measurable real function on a finite measure space is integrable. -/
theorem integrable_of_bdd_finite {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    [IsFiniteMeasure μ] {f : Ω → ℝ} (hfm : Measurable f) {C : ℝ} (hf : ∀ w, |f w| ≤ C) :
    Integrable f μ :=
  Integrable.mono' (integrable_const C) hfm.aestronglyMeasurable
    (Filter.Eventually.of_forall fun w => by
      rw [Real.norm_eq_abs]
      exact hf w)

open MeasureTheory in
/-- **The square of an average is a doubled average**, for a measure rather than an interval:
`(∫ F) conj (∫ F) = ∫∫ F(b⁰) conj (F(b¹))`. This is the step of `patch:cylinder` that turns the
inner square into the two independent copies `b⁰, b¹` of the doubled variable. -/
theorem integral_mul_conj_integral_measure {B : Type*} [MeasurableSpace B] {ν : Measure B}
    (F : B → ℂ) :
    (∫ b, F b ∂ν) * (starRingEnd ℂ) (∫ b, F b ∂ν)
      = ∫ b0, ∫ b1, F b0 * (starRingEnd ℂ) (F b1) ∂ν ∂ν := by
  have h1 : ∀ b0 : B, (∫ b1, F b0 * (starRingEnd ℂ) (F b1) ∂ν)
      = F b0 * ∫ b1, (starRingEnd ℂ) (F b1) ∂ν := fun b0 => integral_const_mul _ _
  rw [integral_congr_ae (Filter.Eventually.of_forall h1), integral_mul_const, integral_conj]

open MeasureTheory in
/-- **The Cauchy-Schwarz of one doubling step**, in the form `patch:cylinder` uses it: the block
`U` that does not depend on the variable about to be doubled is removed, at no cost because it is
one-bounded and the outer space carries a probability measure. -/
theorem sq_norm_integral_mul_le_sq {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    [IsProbabilityMeasure μ] {U : Ω → ℂ} (hUm : Measurable U) (hU : ∀ w, ‖U w‖ ≤ 1)
    {Φ : Ω → ℂ} (hΦm : Measurable Φ) {M : ℝ} (hΦ : ∀ w, ‖Φ w‖ ≤ M) :
    ‖∫ w, U w * Φ w ∂μ‖ ^ 2 ≤ ∫ w, ‖Φ w‖ ^ 2 ∂μ := by
  have hU2 : Integrable (fun w => ‖U w‖ ^ 2) μ :=
    integrable_of_bdd_finite (hUm.norm.pow_const 2) (C := 1) fun w => by
      rw [abs_of_nonneg (by positivity)]
      simpa using pow_le_pow_left₀ (norm_nonneg _) (hU w) 2
  have hΦ2 : Integrable (fun w => ‖Φ w‖ ^ 2) μ :=
    integrable_of_bdd_finite (hΦm.norm.pow_const 2) (C := M ^ 2) fun w => by
      rw [abs_of_nonneg (by positivity)]
      exact pow_le_pow_left₀ (norm_nonneg _) (hΦ w) 2
  have hUΦ : Integrable (fun w => ‖U w‖ * ‖Φ w‖) μ :=
    integrable_of_bdd_finite (hUm.norm.mul hΦm.norm) (C := M) fun w => by
      rw [abs_of_nonneg (by positivity)]
      calc ‖U w‖ * ‖Φ w‖ ≤ 1 * M := mul_le_mul (hU w) (hΦ w) (norm_nonneg _) zero_le_one
        _ = M := one_mul M
  have hone : (∫ w, ‖U w‖ ^ 2 ∂μ) ≤ 1 := by
    have hle : (∫ w, ‖U w‖ ^ 2 ∂μ) ≤ ∫ _w, (1 : ℝ) ∂μ := by
      refine integral_mono hU2 (integrable_const 1) fun w => ?_
      simpa using pow_le_pow_left₀ (norm_nonneg _) (hU w) 2
    simpa using hle
  have hΦ0 : 0 ≤ ∫ w, ‖Φ w‖ ^ 2 ∂μ := integral_nonneg fun _ => by positivity
  calc ‖∫ w, U w * Φ w ∂μ‖ ^ 2
      ≤ (∫ w, ‖U w‖ ^ 2 ∂μ) * ∫ w, ‖Φ w‖ ^ 2 ∂μ := sq_norm_integral_mul_le hU2 hΦ2 hUΦ
    _ ≤ 1 * ∫ w, ‖Φ w‖ ^ 2 ∂μ := mul_le_mul_of_nonneg_right hone hΦ0
    _ = ∫ w, ‖Φ w‖ ^ 2 ∂μ := one_mul _


/-- **The cylinder cube state of `patch:cylinder`**: the product over the vertices of `{0,1}^r` of
the parity-conjugated values of `v` at the selected families,
`∏_{ω} C^{|ω|} v(b^ω)`. The parity `Auto.conjPar` and the vertex weight `Auto.numTrue` are the ones
already used by the Fejer cube. -/
noncomputable def cubeProdSel {B : Type*} {r : ℕ} (v : (Fin r → B) → ℂ) (b c : Fin r → B) : ℂ :=
  ∏ ω : Fin r → Bool, conjPar (numTrue ω) (v (cubeSel ω b c))

/-- With no coordinates doubled the cube is the single value -- the base of the induction. -/
theorem cubeProdSel_zero {B : Type*} (v : (Fin 0 → B) → ℂ) (b c : Fin 0 → B) :
    cubeProdSel v b c = v b := by
  have hnum : ∀ ω : Fin 0 → Bool, numTrue ω = 0 := fun ω => by simp [numTrue]
  rw [cubeProdSel, Finset.univ_unique, Finset.prod_singleton, hnum, conjPar_zero]
  congr 1
  exact Subsingleton.elim _ _

theorem norm_cubeProdSel_le {B : Type*} {r : ℕ} {v : (Fin r → B) → ℂ}
    (hv : ∀ x, ‖v x‖ ≤ 1) (b c : Fin r → B) : ‖cubeProdSel v b c‖ ≤ 1 := by
  rw [cubeProdSel, norm_prod]
  refine Finset.prod_le_one₀ (fun ω _ => norm_nonneg _) fun ω _ => ?_
  rw [norm_conjPar]
  exact hv _

open MeasureTheory in
theorem measurable_cubeProdSel {B : Type*} [MeasurableSpace B] {r : ℕ} {v : (Fin r → B) → ℂ}
    (hv : Measurable v) :
    Measurable fun p : (Fin r → B) × (Fin r → B) => cubeProdSel v p.1 p.2 := by
  refine Finset.measurable_prod _ fun ω _ => ?_
  by_cases hEven : Even (numTrue ω)
  · simp only [conjPar, ite_eq_left hEven]
    exact hv.comp (measurable_cubeSel ω)
  · simp only [conjPar, ite_eq_right hEven]
    exact Complex.continuous_conj.measurable.comp (hv.comp (measurable_cubeSel ω))


/-- **The snoc recursion of the cylinder cube.** Doubling one more coordinate multiplies the cube
by the conjugate of the cube of the shifted function -- exactly the shape that one application of
`Auto.sq_norm_integral_mul_le_sq` produces.

The reindexing uses the file's own `Auto.snocBoolEquiv` and `Auto.numTrue_snoc`, built for the cube
expansion of `Auto.headBlock`; only `Auto.cubeSel_snoc` is new. -/
theorem cubeProdSel_succ {B : Type*} {r : ℕ} (v : (Fin (r + 1) → B) → ℂ)
    (b c : Fin (r + 1) → B) :
    cubeProdSel v b c
      = cubeProdSel (fun x : Fin r → B => v (Fin.snoc x (b (Fin.last r))))
            (fun i => b i.castSucc) (fun i => c i.castSucc)
        * (starRingEnd ℂ) (cubeProdSel (fun x : Fin r → B => v (Fin.snoc x (c (Fin.last r))))
            (fun i => b i.castSucc) (fun i => c i.castSucc)) := by
  classical
  rw [cubeProdSel, cubeProdSel, cubeProdSel, map_prod, ← Finset.prod_mul_distrib,
    ← (snocBoolEquiv r).prod_comp fun ω => conjPar (numTrue ω) (v (cubeSel ω b c)),
    Fintype.prod_prod_type]
  refine Finset.prod_congr rfl fun σ _ => ?_
  rw [Fintype.prod_bool]
  simp only [snocBoolEquiv, Equiv.coe_fn_mk]
  have hfalse : numTrue (Fin.snoc σ false) = numTrue σ := by
    rw [numTrue_snoc]
    simp
  have htrue : numTrue (Fin.snoc σ true) = numTrue σ + 1 := by
    rw [numTrue_snoc]
    simp
  have hsf : cubeSel (Fin.snoc σ false) b c
      = Fin.snoc (cubeSel σ (fun i => b i.castSucc) (fun i => c i.castSucc))
          (b (Fin.last r)) := by
    rw [cubeSel_snoc]
    simp
  have hst : cubeSel (Fin.snoc σ true) b c
      = Fin.snoc (cubeSel σ (fun i => b i.castSucc) (fun i => c i.castSucc))
          (c (Fin.last r)) := by
    rw [cubeSel_snoc]
    simp
  rw [hfalse, htrue, hsf, hst, conjPar_succ]
  ring


open MeasureTheory in
/-- **One step of the cylinder induction**, `patch:cylinder`.

The block `U`, which does not depend on the variable `b` about to be doubled, is removed by
Cauchy-Schwarz in the outer variables; the inner square is then expanded into two independent copies
`b⁰, b¹` of that variable. The right-hand side is real because it came from a square, which is why
the state stays a genuine cube average rather than a modulus. -/
theorem sq_norm_integral_mul_inner_le {Ω B : Type*} [MeasurableSpace Ω] [MeasurableSpace B]
    {μ : Measure Ω} [IsProbabilityMeasure μ] {ν : Measure B}
    {U : Ω → ℂ} (hUm : Measurable U) (hU : ∀ w, ‖U w‖ ≤ 1)
    {v : Ω → B → ℂ} (hΦm : Measurable fun w => ∫ b, v w b ∂ν)
    {M : ℝ} (hΦ : ∀ w, ‖∫ b, v w b ∂ν‖ ≤ M) :
    ‖∫ w, U w * (∫ b, v w b ∂ν) ∂μ‖ ^ 2
      ≤ ∫ w, (∫ b0, ∫ b1, v w b0 * (starRingEnd ℂ) (v w b1) ∂ν ∂ν).re ∂μ := by
  refine (sq_norm_integral_mul_le_sq hUm hU hΦm hΦ).trans (le_of_eq ?_)
  refine integral_congr_ae (Filter.Eventually.of_forall fun w => ?_)
  change ‖∫ b, v w b ∂ν‖ ^ 2
      = (∫ b0, ∫ b1, v w b0 * (starRingEnd ℂ) (v w b1) ∂ν ∂ν).re
  rw [← integral_mul_conj_integral_measure (v w), Complex.mul_conj, Complex.ofReal_re,
    Complex.normSq_eq_norm_sq]


/-- **The chain of squarings of `patch:cylinder`.**

The induction of the patch produces one inequality `|J_a|^2 <= J_{a+1}` per doubled variable.
Chaining them gives the `2^r`-th power in the statement of the lemma. This is the purely numerical
half, separated so the measure-theoretic half does not have to carry it.

Nonnegativity of the intermediate states is not needed: the squaring step only uses that the
quantity being raised is itself a power of the nonnegative `x`. -/
theorem pow_two_pow_le_of_sq_chain {J : ℕ → ℝ} {x : ℝ} (hx : 0 ≤ x)
    (h0 : x ^ 2 ≤ J 1) (hstep : ∀ a, 1 ≤ a → J a ^ 2 ≤ J (a + 1)) :
    ∀ r : ℕ, 1 ≤ r → x ^ (2 ^ r) ≤ J r := by
  intro r
  induction r with
  | zero =>
      intro hr
      exact absurd hr (by norm_num)
  | succ a ih =>
      intro _
      rcases Nat.eq_zero_or_pos a with ha | ha
      · subst ha
        simpa using h0
      · calc x ^ (2 ^ (a + 1)) = (x ^ (2 ^ a)) ^ 2 := by rw [pow_succ, pow_mul]
          _ ≤ J a ^ 2 := pow_le_pow_left₀ (pow_nonneg hx _) (ih ha) 2
          _ ≤ J (a + 1) := hstep a ha


/-- **The cylinder cube at one doubled variable**: `v(b) conj(v(c))`.

This is the `r = 1` instance of `Auto.cubeProdSel`, and it is what
`Auto.sq_norm_integral_mul_inner_le` produces on its right-hand side, so the combinatorial and the
analytic halves of `patch:cylinder` meet here. -/
theorem cubeProdSel_one {B : Type*} (v : (Fin 1 → B) → ℂ) (b c : Fin 1 → B) :
    cubeProdSel v b c = v b * (starRingEnd ℂ) (v c) := by
  have hlast : ∀ i : Fin (0 + 1), i = Fin.last 0 := by
    intro i
    have h := i.isLt
    refine Fin.ext ?_
    simp only [Fin.val_last]
    omega
  have hsnoc : ∀ x : B, Fin.snoc (fun i : Fin 0 => b i.castSucc) x = fun _ : Fin 1 => x := by
    intro x
    funext i
    rw [hlast i]
    exact Fin.snoc_last _ _
  have hb : (fun _ : Fin 1 => b (Fin.last 0)) = b := by
    funext i
    rw [hlast i]
  have hc : (fun _ : Fin 1 => c (Fin.last 0)) = c := by
    funext i
    rw [hlast i]
  rw [cubeProdSel_succ, cubeProdSel_zero, cubeProdSel_zero, hsnoc, hsnoc, hb, hc]


open MeasureTheory in
/-- **Splitting off the last coordinate of a product measure.**

The assembly of `patch:cylinder` doubles the last remaining variable at each step, so the ambient
product has to be split there. This is Mathlib's `measurePreserving_piFinSuccAbove` at the index
`Fin.last n`, where `succAbove` is `castSucc` and the constant family makes the target measure the
plain product. -/
theorem measurePreserving_piFinLast {B : Type*} [MeasurableSpace B] (ν : Measure B)
    [SigmaFinite ν] (n : ℕ) :
    MeasurePreserving (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => B) (Fin.last n))
      (Measure.pi fun _ : Fin (n + 1) => ν)
      (ν.prod (Measure.pi fun _ : Fin n => ν)) :=
  measurePreserving_piFinSuccAbove (α := fun _ : Fin (n + 1) => B) (fun _ => ν) (Fin.last n)

open MeasureTheory in
/-- **The integral form of the splitting**, in the `Fin.snoc` shape the cylinder induction uses:
an integral over `Fin (n+1) -> B` is an integral over the last coordinate and the rest. -/
theorem integral_pi_fin_last {B : Type*} [MeasurableSpace B] (ν : Measure B) [SigmaFinite ν]
    {n : ℕ} (f : (Fin (n + 1) → B) → ℂ) :
    (∫ b, f b ∂(Measure.pi fun _ : Fin (n + 1) => ν))
      = ∫ p : B × (Fin n → B), f (Fin.snoc p.2 p.1)
          ∂(ν.prod (Measure.pi fun _ : Fin n => ν)) := by
  have h := (measurePreserving_piFinLast ν n).integral_comp
    (MeasurableEquiv.measurableEmbedding _)
    (fun p : B × (Fin n → B) => f (Fin.snoc p.2 p.1))
  simpa [Fin.snoc_init_self] using h


open MeasureTheory in
/-- **The inner square is the doubled average**, pointwise in the outer variable:
`‖∫ f‖^2 = Re ∫∫ f(b⁰) conj (f(b¹))`. Extracted from the proof of
`Auto.sq_norm_integral_mul_inner_le` so that the assembly of `patch:cylinder` can use it on its own,
where the state has to be recognized rather than merely bounded. -/
theorem sq_norm_integral_eq_re_doubled {B : Type*} [MeasurableSpace B] {ν : Measure B}
    (f : B → ℂ) :
    ‖∫ b, f b ∂ν‖ ^ 2 = (∫ b0, ∫ b1, f b0 * (starRingEnd ℂ) (f b1) ∂ν ∂ν).re := by
  rw [← integral_mul_conj_integral_measure f, Complex.mul_conj, Complex.ofReal_re,
    Complex.normSq_eq_norm_sq]

open MeasureTheory in
/-- **Every state of the cylinder induction from the first on is nonnegative**, because it is an
integrated square. This is what lets `Auto.pow_two_pow_le_of_sq_chain` be applied to the states
themselves rather than to their moduli. -/
theorem integral_re_doubled_nonneg {Ω B : Type*} [MeasurableSpace Ω] [MeasurableSpace B]
    {μ : Measure Ω} {ν : Measure B} (v : Ω → B → ℂ) :
    0 ≤ ∫ w, (∫ b0, ∫ b1, v w b0 * (starRingEnd ℂ) (v w b1) ∂ν ∂ν).re ∂μ := by
  refine integral_nonneg fun w => ?_
  rw [← sq_norm_integral_eq_re_doubled (v w)]
  positivity


open MeasureTheory in
/-- Appending a coordinate is measurable in the pair. -/
theorem measurable_snoc {B : Type*} [MeasurableSpace B] {r : ℕ} :
    Measurable fun q : (Fin r → B) × B => (Fin.snoc q.1 q.2 : Fin (r + 1) → B) := by
  refine Measurable.of_eval fun i => ?_
  refine Fin.lastCases ?_ ?_ i
  · simpa using measurable_snd
  · intro j
    simpa [Function.comp_def] using (measurable_pi_apply j).comp measurable_fst

/-- **The doubled function of one cylinder step.**

After doubling the last coordinate, the auxiliary variable grows from `z` to `(z, beta⁰, beta¹)` and
the function is replaced by the two-vertex cube. This is the object the induction of
`patch:cylinder` recurses on, and `Auto.cubeProdSel_succ` is what identifies its cube with the full
cube one order up. -/
noncomputable def cylStep {Z B : Type*} {r : ℕ} (v : Z → (Fin (r + 1) → B) → ℂ)
    (p : Z × B × B) (b : Fin r → B) : ℂ :=
  v p.1 (Fin.snoc b p.2.1) * (starRingEnd ℂ) (v p.1 (Fin.snoc b p.2.2))

theorem norm_cylStep_le {Z B : Type*} {r : ℕ} {v : Z → (Fin (r + 1) → B) → ℂ}
    (hv : ∀ z b, ‖v z b‖ ≤ 1) (p : Z × B × B) (b : Fin r → B) : ‖cylStep v p b‖ ≤ 1 := by
  rw [cylStep, norm_mul, RCLike.norm_conj]
  calc ‖v p.1 (Fin.snoc b p.2.1)‖ * ‖v p.1 (Fin.snoc b p.2.2)‖ ≤ 1 * 1 :=
        mul_le_mul (hv _ _) (hv _ _) (norm_nonneg _) zero_le_one
    _ = 1 := one_mul 1

open MeasureTheory in
theorem measurable_cylStep {Z B : Type*} [MeasurableSpace Z] [MeasurableSpace B] {r : ℕ}
    {v : Z → (Fin (r + 1) → B) → ℂ} (hv : Measurable (Function.uncurry v)) :
    Measurable (Function.uncurry (cylStep v)) := by
  have hsnoc0 : Measurable fun q : (Z × B × B) × (Fin r → B) =>
      (Fin.snoc q.2 q.1.2.1 : Fin (r + 1) → B) :=
    measurable_snoc.comp (Measurable.prodMk measurable_snd measurable_fst.snd.fst)
  have hsnoc1 : Measurable fun q : (Z × B × B) × (Fin r → B) =>
      (Fin.snoc q.2 q.1.2.2 : Fin (r + 1) → B) :=
    measurable_snoc.comp (Measurable.prodMk measurable_snd measurable_fst.snd.snd)
  have h1 : Measurable fun q : (Z × B × B) × (Fin r → B) =>
      v q.1.1 (Fin.snoc q.2 q.1.2.1) :=
    hv.comp (Measurable.prodMk measurable_fst.fst hsnoc0)
  have h2 : Measurable fun q : (Z × B × B) × (Fin r → B) =>
      v q.1.1 (Fin.snoc q.2 q.1.2.2) :=
    hv.comp (Measurable.prodMk measurable_fst.fst hsnoc1)
  exact h1.mul (Complex.continuous_conj.measurable.comp h2)


open MeasureTheory in
/-- The complex companion of `Auto.integrable_of_bdd_finite`: a bounded measurable complex function
is integrable against a finite measure. Every integrand of the cylinder induction is of this
shape, since all its functions are `1`-bounded and all its measures are probability measures. -/
theorem integrable_of_bdd_finite' {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    [IsFiniteMeasure μ] {f : Ω → ℂ} (hfm : Measurable f) {C : ℝ} (hf : ∀ w, ‖f w‖ ≤ C) :
    Integrable f μ :=
  Integrable.mono' (integrable_const C) hfm.aestronglyMeasurable
    (Filter.Eventually.of_forall hf)

open MeasureTheory in
/-- **Peeling the last coordinate of a product integral, keeping it innermost.**

`Auto.integral_pi_fin_last` splits the product measure; this puts the two factors in the order the
cylinder induction needs, namely the surviving coordinates outside and the coordinate about to be
doubled inside. The swap is Fubini, which the boundedness hypothesis supplies. -/
theorem integral_pi_snoc {B : Type*} [MeasurableSpace B] (ν : Measure B) [IsProbabilityMeasure ν]
    {n : ℕ} {f : (Fin (n + 1) → B) → ℂ} (hfm : Measurable f) {C : ℝ} (hf : ∀ b, ‖f b‖ ≤ C) :
    (∫ b, f b ∂(Measure.pi fun _ : Fin (n + 1) => ν))
      = ∫ b', (∫ β, f (Fin.snoc b' β) ∂ν) ∂(Measure.pi fun _ : Fin n => ν) := by
  have hgm : Measurable fun p : B × (Fin n → B) => f (Fin.snoc p.2 p.1) :=
    hfm.comp (measurable_snoc.comp (measurable_snd.prodMk measurable_fst))
  have hint : Integrable (Function.uncurry fun (β : B) (b' : Fin n → B) => f (Fin.snoc b' β))
      (ν.prod (Measure.pi fun _ : Fin n => ν)) :=
    integrable_of_bdd_finite' hgm (C := C) fun p => hf _
  have h1 : (∫ p : B × (Fin n → B), f (Fin.snoc p.2 p.1)
        ∂(ν.prod (Measure.pi fun _ : Fin n => ν)))
      = ∫ β, (∫ b', f (Fin.snoc b' β) ∂(Measure.pi fun _ : Fin n => ν)) ∂ν :=
    integral_prod _ hint
  rw [integral_pi_fin_last ν f, h1]
  exact integral_integral_swap hint


open MeasureTheory in
/-- The average of a `1`-bounded function against a probability measure is `1`-bounded. -/
theorem norm_integral_le_one {B : Type*} [MeasurableSpace B] {ν : Measure B}
    [IsProbabilityMeasure ν] {f : B → ℂ} (hf : ∀ b, ‖f b‖ ≤ 1) : ‖∫ b, f b ∂ν‖ ≤ 1 := by
  have h := norm_integral_le_of_norm_le_const (μ := ν) (C := 1)
    (Filter.Eventually.of_forall hf)
  simpa using h

open MeasureTheory in
/-- **One step of the cylinder induction, on the side of the averages.**

The average over `Fin (n+1)` coordinates with an outer factor `U` is rewritten as an average over
the enlarged outer space `Z x (Fin n -> B)` of `U` times an average over the single coordinate that
is about to be doubled. This is exactly the shape consumed by
`Auto.sq_norm_integral_mul_inner_le`, whose outer space is arbitrary. -/
theorem integral_mul_pi_snoc {Z B : Type*} [MeasurableSpace Z] [MeasurableSpace B]
    {μ : Measure Z} [IsProbabilityMeasure μ] {ν : Measure B} [IsProbabilityMeasure ν]
    {n : ℕ} {U : Z → ℂ} (hUm : Measurable U) (hU : ∀ z, ‖U z‖ ≤ 1)
    {v : Z → (Fin (n + 1) → B) → ℂ} (hvm : Measurable (Function.uncurry v))
    (hv : ∀ z b, ‖v z b‖ ≤ 1) :
    (∫ z, U z * (∫ b, v z b ∂(Measure.pi fun _ : Fin (n + 1) => ν)) ∂μ)
      = ∫ w : Z × (Fin n → B), U w.1 * (∫ β, v w.1 (Fin.snoc w.2 β) ∂ν)
          ∂(μ.prod (Measure.pi fun _ : Fin n => ν)) := by
  have hgm : Measurable fun q : (Z × (Fin n → B)) × B => v q.1.1 (Fin.snoc q.1.2 q.2) :=
    hvm.comp (Measurable.prodMk measurable_fst.fst
      (measurable_snoc.comp (Measurable.prodMk measurable_fst.snd measurable_snd)))
  have hinner : Measurable fun w : Z × (Fin n → B) => ∫ β, v w.1 (Fin.snoc w.2 β) ∂ν :=
    (hgm.stronglyMeasurable.integral_prod_right' (ν := ν)).measurable
  have hFm : Measurable fun w : Z × (Fin n → B) => U w.1 * (∫ β, v w.1 (Fin.snoc w.2 β) ∂ν) :=
    (hUm.comp measurable_fst).mul hinner
  have hFb : ∀ w : Z × (Fin n → B), ‖U w.1 * (∫ β, v w.1 (Fin.snoc w.2 β) ∂ν)‖ ≤ 1 := by
    intro w
    rw [norm_mul]
    calc ‖U w.1‖ * ‖∫ β, v w.1 (Fin.snoc w.2 β) ∂ν‖ ≤ 1 * 1 :=
          mul_le_mul (hU _) (norm_integral_le_one fun β => hv _ _) (norm_nonneg _) zero_le_one
      _ = 1 := one_mul 1
  have hint : Integrable (fun w : Z × (Fin n → B) => U w.1 * (∫ β, v w.1 (Fin.snoc w.2 β) ∂ν))
      (μ.prod (Measure.pi fun _ : Fin n => ν)) :=
    integrable_of_bdd_finite' hFm (C := 1) hFb
  have h2 : (∫ w : Z × (Fin n → B), U w.1 * (∫ β, v w.1 (Fin.snoc w.2 β) ∂ν)
        ∂(μ.prod (Measure.pi fun _ : Fin n => ν)))
      = ∫ z, (∫ b', U z * (∫ β, v z (Fin.snoc b' β) ∂ν) ∂(Measure.pi fun _ : Fin n => ν)) ∂μ :=
    integral_prod _ hint
  rw [h2]
  refine integral_congr_ae (Filter.Eventually.of_forall fun z => ?_)
  change U z * (∫ b, v z b ∂(Measure.pi fun _ : Fin (n + 1) => ν))
      = ∫ b', U z * (∫ β, v z (Fin.snoc b' β) ∂ν) ∂(Measure.pi fun _ : Fin n => ν)
  have hvz : Measurable (v z) := hvm.comp (Measurable.prodMk measurable_const measurable_id)
  rw [integral_const_mul, integral_pi_snoc ν hvz (C := 1) fun b => hv z b]


theorem conjPar_mul (n : ℕ) (a b : ℂ) : conjPar n (a * b) = conjPar n a * conjPar n b := by
  by_cases h : Even n <;> simp [conjPar, h]

theorem conjPar_conj (n : ℕ) (z : ℂ) :
    conjPar n ((starRingEnd ℂ) z) = (starRingEnd ℂ) (conjPar n z) := by
  by_cases h : Even n <;> simp [conjPar, h]

/-- **The cube of a doubled function splits.** Since `conjPar` is a ring hom in each parity, the
cube of `f * conj g` is the cube of `f` times the conjugate of the cube of `g`. -/
theorem cubeProdSel_mul_conj {B : Type*} {r : ℕ} (f g : (Fin r → B) → ℂ) (b c : Fin r → B) :
    cubeProdSel (fun x => f x * (starRingEnd ℂ) (g x)) b c
      = cubeProdSel f b c * (starRingEnd ℂ) (cubeProdSel g b c) := by
  rw [cubeProdSel, cubeProdSel, cubeProdSel, map_prod, ← Finset.prod_mul_distrib]
  refine Finset.prod_congr rfl fun ω _ => ?_
  change conjPar (numTrue ω) (f (cubeSel ω b c) * (starRingEnd ℂ) (g (cubeSel ω b c)))
      = conjPar (numTrue ω) (f (cubeSel ω b c))
        * (starRingEnd ℂ) (conjPar (numTrue ω) (g (cubeSel ω b c)))
  rw [conjPar_mul, conjPar_conj]

/-- **The cube of the doubled function is the full cube one order up.**

This is the identification that closes the induction of `patch:cylinder`: the cube over
`{0,1}^r` of `Auto.cylStep v (z, beta0, beta1)` is the cube over `{0,1}^(r+1)` of `v z`, with the
new bit carried by the two copies `beta0, beta1` of the doubled coordinate. -/
theorem cubeProdSel_cylStep {Z B : Type*} {r : ℕ} (v : Z → (Fin (r + 1) → B) → ℂ)
    (z : Z) (β0 β1 : B) (b c : Fin r → B) :
    cubeProdSel (cylStep v (z, β0, β1)) b c
      = cubeProdSel (v z) (Fin.snoc b β0) (Fin.snoc c β1) := by
  rw [cubeProdSel_succ (v z) (Fin.snoc b β0) (Fin.snoc c β1)]
  simp only [Fin.snoc_last, Fin.snoc_castSucc]
  exact cubeProdSel_mul_conj (fun x => v z (Fin.snoc x β0)) (fun x => v z (Fin.snoc x β1)) b c


open MeasureTheory in
/-- Fubini for a bounded measurable complex function of two variables on finite measures. All the
reorderings of the cylinder induction are instances of this: every function there is `1`-bounded
and every measure is a probability measure. -/
theorem integral_swap_of_bdd {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    {μ : Measure X} [IsFiniteMeasure μ] {ν : Measure Y} [IsFiniteMeasure ν]
    {f : X → Y → ℂ} (hf : Measurable (Function.uncurry f)) {C : ℝ} (hb : ∀ x y, ‖f x y‖ ≤ C) :
    (∫ x, (∫ y, f x y ∂ν) ∂μ) = ∫ y, (∫ x, f x y ∂μ) ∂ν :=
  integral_integral_swap (integrable_of_bdd_finite' hf (C := C) fun p => hb p.1 p.2)

open MeasureTheory in
/-- Splitting a product integral of a bounded measurable complex function. -/
theorem integral_prod_of_bdd {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    {μ : Measure X} [IsFiniteMeasure μ] {ν : Measure Y} [IsFiniteMeasure ν]
    {f : X → Y → ℂ} (hf : Measurable (Function.uncurry f)) {C : ℝ} (hb : ∀ x y, ‖f x y‖ ≤ C) :
    (∫ p : X × Y, f p.1 p.2 ∂(μ.prod ν)) = ∫ x, (∫ y, f x y ∂ν) ∂μ :=
  integral_prod _ (integrable_of_bdd_finite' hf (C := C) fun p => hb p.1 p.2)

open MeasureTheory in
/-- The real part commutes with the integral of a bounded measurable complex function. This is
what lets the states of the cylinder induction be handled as one complex integral and only taken
real at the end. -/
theorem integral_re_of_bdd {X : Type*} [MeasurableSpace X] {μ : Measure X} [IsFiniteMeasure μ]
    {f : X → ℂ} (hf : Measurable f) {C : ℝ} (hb : ∀ x, ‖f x‖ ≤ C) :
    (∫ x, (f x).re ∂μ) = (∫ x, f x ∂μ).re := by
  simpa using Complex.reCLM.integral_comp_comm (integrable_of_bdd_finite' hf (C := C) hb)


open MeasureTheory in
/-- **Regrouping the doubled pair from the inner to the outer variable.**

One Cauchy-Schwarz step of `patch:cylinder` produces an average over the old outer variable of an
average over the new pair `(beta0, beta1)`; the induction hypothesis wants the pair adjoined to the
auxiliary variable instead, with the surviving coordinates innermost. This is that regrouping, and
it is pure Fubini: nothing here knows that `W` is a coordinate product. -/
theorem integral_regroup_prod {Z B W : Type*} [MeasurableSpace Z] [MeasurableSpace B]
    [MeasurableSpace W] {μ : Measure Z} [IsProbabilityMeasure μ] {ν : Measure B}
    [IsProbabilityMeasure ν] {π : Measure W} [IsProbabilityMeasure π]
    {g : Z × B × B → W → ℂ} (hg : Measurable (Function.uncurry g)) {C : ℝ}
    (hb : ∀ y w, ‖g y w‖ ≤ C) :
    (∫ q : Z × W, (∫ p : B × B, g (q.1, p) q.2 ∂(ν.prod ν)) ∂(μ.prod π))
      = ∫ y : Z × B × B, (∫ w, g y w ∂π) ∂(μ.prod (ν.prod ν)) := by
  have hI : ∀ (z : Z) (w : W), ‖∫ p : B × B, g (z, p) w ∂(ν.prod ν)‖ ≤ C := by
    intro z w
    simpa using norm_integral_le_of_norm_le_const (μ := ν.prod ν) (C := C)
      (Filter.Eventually.of_forall fun p => hb (z, p) w)
  have hJ : ∀ (z : Z) (p : B × B), ‖∫ w, g (z, p) w ∂π‖ ≤ C := by
    intro z p
    simpa using norm_integral_le_of_norm_le_const (μ := π) (C := C)
      (Filter.Eventually.of_forall fun w => hb (z, p) w)
  have h1 : Measurable fun q : (Z × W) × (B × B) => g (q.1.1, q.2) q.1.2 :=
    hg.comp (Measurable.prodMk (Measurable.prodMk measurable_fst.fst measurable_snd)
      measurable_fst.snd)
  have hFm : Measurable fun q : Z × W => ∫ p : B × B, g (q.1, p) q.2 ∂(ν.prod ν) :=
    (h1.stronglyMeasurable.integral_prod_right' (ν := ν.prod ν)).measurable
  have step1 : (∫ q : Z × W, (∫ p : B × B, g (q.1, p) q.2 ∂(ν.prod ν)) ∂(μ.prod π))
      = ∫ z, (∫ w, (∫ p : B × B, g (z, p) w ∂(ν.prod ν)) ∂π) ∂μ :=
    integral_prod_of_bdd (f := fun (z : Z) (w : W) => ∫ p : B × B, g (z, p) w ∂(ν.prod ν))
      hFm (C := C) hI
  have hGm : Measurable fun y : Z × B × B => ∫ w, g y w ∂π :=
    (hg.stronglyMeasurable.integral_prod_right' (ν := π)).measurable
  have step3 : (∫ y : Z × B × B, (∫ w, g y w ∂π) ∂(μ.prod (ν.prod ν)))
      = ∫ z, (∫ p : B × B, (∫ w, g (z, p) w ∂π) ∂(ν.prod ν)) ∂μ :=
    integral_prod_of_bdd (f := fun (z : Z) (p : B × B) => ∫ w, g (z, p) w ∂π) hGm (C := C) hJ
  rw [step1, step3]
  refine integral_congr_ae (Filter.Eventually.of_forall fun z => ?_)
  change (∫ w, (∫ p : B × B, g (z, p) w ∂(ν.prod ν)) ∂π)
      = ∫ p : B × B, (∫ w, g (z, p) w ∂π) ∂(ν.prod ν)
  have hgm2 : Measurable fun q : W × (B × B) => g (z, q.2) q.1 :=
    hg.comp (Measurable.prodMk (Measurable.prodMk measurable_const measurable_snd) measurable_fst)
  exact integral_swap_of_bdd (f := fun (w : W) (p : B × B) => g (z, p) w) hgm2 (C := C)
    fun w p => hb (z, p) w


open MeasureTheory in
/-- **The output of one Cauchy-Schwarz step is the next state of the induction.**

`Auto.sq_norm_integral_mul_inner_le`, applied with outer space `Z x (Fin r -> B)` and doubled
variable the last coordinate, produces the left-hand side here. The right-hand side is the same
average read as an average over the enlarged auxiliary space `Z x B x B` of the doubled function
`Auto.cylStep v` -- which is the shape the induction hypothesis consumes. -/
theorem integral_re_doubled_eq_cylStep {Z B : Type*} [MeasurableSpace Z] [MeasurableSpace B]
    {μ : Measure Z} [IsProbabilityMeasure μ] {ν : Measure B} [IsProbabilityMeasure ν]
    {r : ℕ} {v : Z → (Fin (r + 1) → B) → ℂ} (hvm : Measurable (Function.uncurry v))
    (hv : ∀ z b, ‖v z b‖ ≤ 1) :
    (∫ w : Z × (Fin r → B),
        (∫ β0, ∫ β1, v w.1 (Fin.snoc w.2 β0) * (starRingEnd ℂ) (v w.1 (Fin.snoc w.2 β1)) ∂ν ∂ν).re
        ∂(μ.prod (Measure.pi fun _ : Fin r => ν)))
      = (∫ y : Z × B × B, (∫ b', cylStep v y b' ∂(Measure.pi fun _ : Fin r => ν))
          ∂(μ.prod (ν.prod ν))).re := by
  have hcyl : Measurable (Function.uncurry (cylStep v)) := measurable_cylStep hvm
  have hb : ∀ (y : Z × B × B) (b' : Fin r → B), ‖cylStep v y b'‖ ≤ 1 := norm_cylStep_le hv
  have hinner : ∀ w : Z × (Fin r → B),
      (∫ β0, ∫ β1, v w.1 (Fin.snoc w.2 β0) * (starRingEnd ℂ) (v w.1 (Fin.snoc w.2 β1)) ∂ν ∂ν)
        = ∫ p : B × B, cylStep v (w.1, p) w.2 ∂(ν.prod ν) := by
    intro w
    have m0 : Measurable fun q : B × B => v w.1 (Fin.snoc w.2 q.1) :=
      hvm.comp (Measurable.prodMk measurable_const
        (measurable_snoc.comp (Measurable.prodMk measurable_const measurable_fst)))
    have m1 : Measurable fun q : B × B => v w.1 (Fin.snoc w.2 q.2) :=
      hvm.comp (Measurable.prodMk measurable_const
        (measurable_snoc.comp (Measurable.prodMk measurable_const measurable_snd)))
    have hm : Measurable (Function.uncurry fun (β0 β1 : B) =>
        v w.1 (Fin.snoc w.2 β0) * (starRingEnd ℂ) (v w.1 (Fin.snoc w.2 β1))) :=
      m0.mul (Complex.continuous_conj.measurable.comp m1)
    exact (integral_prod_of_bdd hm (C := 1)
      fun β0 β1 => norm_cylStep_le hv (w.1, β0, β1) w.2).symm
  have hstep : (∫ w : Z × (Fin r → B),
        (∫ β0, ∫ β1, v w.1 (Fin.snoc w.2 β0) * (starRingEnd ℂ) (v w.1 (Fin.snoc w.2 β1)) ∂ν ∂ν).re
        ∂(μ.prod (Measure.pi fun _ : Fin r => ν)))
      = ∫ w : Z × (Fin r → B), (∫ p : B × B, cylStep v (w.1, p) w.2 ∂(ν.prod ν)).re
          ∂(μ.prod (Measure.pi fun _ : Fin r => ν)) := by
    refine integral_congr_ae (Filter.Eventually.of_forall fun w => ?_)
    change (∫ β0, ∫ β1, v w.1 (Fin.snoc w.2 β0) * (starRingEnd ℂ) (v w.1 (Fin.snoc w.2 β1))
          ∂ν ∂ν).re
        = (∫ p : B × B, cylStep v (w.1, p) w.2 ∂(ν.prod ν)).re
    rw [hinner w]
  have h1 : Measurable fun q : (Z × (Fin r → B)) × (B × B) => cylStep v (q.1.1, q.2) q.1.2 :=
    hcyl.comp (Measurable.prodMk (Measurable.prodMk measurable_fst.fst measurable_snd)
      measurable_fst.snd)
  have hFm : Measurable fun w : Z × (Fin r → B) =>
      ∫ p : B × B, cylStep v (w.1, p) w.2 ∂(ν.prod ν) :=
    (h1.stronglyMeasurable.integral_prod_right' (ν := ν.prod ν)).measurable
  have hFb : ∀ w : Z × (Fin r → B), ‖∫ p : B × B, cylStep v (w.1, p) w.2 ∂(ν.prod ν)‖ ≤ 1 :=
    fun w => norm_integral_le_one fun p => hb _ _
  rw [hstep, integral_re_of_bdd hFm (C := 1) hFb,
    integral_regroup_prod (g := cylStep v) hcyl (C := 1) hb]


open MeasureTheory in
/-- The cube in its second argument alone is measurable. -/
theorem measurable_cubeProdSel_right {B : Type*} [MeasurableSpace B] {r : ℕ}
    {w : (Fin r → B) → ℂ} (hw : Measurable w) (c0 : Fin r → B) :
    Measurable fun c1 : Fin r → B => cubeProdSel w c0 c1 :=
  (measurable_cubeProdSel hw).comp (Measurable.prodMk measurable_const measurable_id)

open MeasureTheory in
/-- **The cube with both arguments split at their last coordinate**, as a measurable function of
the four pieces. The reindexing of `patch:cylinder` needs this and its two partially fixed forms;
each is proved directly from `Auto.measurable_cubeProdSel`, because deriving one from another by
composing with a projection makes the elaborator unfold `Fin.snoc` under a composition and time
out. -/
theorem measurable_cubeProdSel_snocPair {B : Type*} [MeasurableSpace B] {r : ℕ}
