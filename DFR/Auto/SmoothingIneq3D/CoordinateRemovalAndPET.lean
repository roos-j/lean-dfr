  calc H⁻¹ * ‖∫ b in (0 : ℝ)..H, f (x + b • v)‖
      ≤ H⁻¹ * (M * H) :=
        mul_le_mul_of_nonneg_left (norm_shiftAvg_le hH.le v hM x) (by positivity)
    _ = M := by field_simp

