theorem integrable_scaled_fejer_mul_re_windowSpace {H : ℝ} (hH : 0 < H) (r m : ℕ)
    {f : ℕ → E3 → ℂ} {P : ℕ → Polynomial ℝ} {p : E3 → Polynomial ℝ} {j : ℕ → Fin 3}
