open Filter Topology MeasureTheory

/-- **The sublevel exclusion after blueprint `patch:multiaffine-sublevel`**: if `0 ≤ F ≤ 1` has
mean at least `κ > 0` against a probability measure and the bad set `B` has measure at most
`κ / 4`, then some point outside `B` has `F ≥ κ / 2`. -/
theorem exists_notMem_ge_of_mean {α : Type*} [MeasurableSpace α] {μ : Measure α}
    [IsProbabilityMeasure μ] {F : α → ℝ} (hFm : AEStronglyMeasurable F μ)
    (hF0 : ∀ x, 0 ≤ F x) (hF1 : ∀ x, F x ≤ 1) {κ : ℝ} (hκ : 0 < κ)
    (hmean : κ ≤ ∫ x, F x ∂μ) {B : Set α} (hBm : MeasurableSet B) (hB : μ.real B ≤ κ / 4) :
    ∃ x, x ∉ B ∧ κ / 2 ≤ F x := by
  by_contra hcon
  simp only [not_exists, not_and, not_le] at hcon
  have hle : ∀ x, F x ≤ B.indicator (fun _ => (1 : ℝ)) x + κ / 2 := by
    intro x
    by_cases hx : x ∈ B
    · rw [Set.indicator_of_mem hx]; linarith [hF1 x]
    · rw [Set.indicator_of_notMem hx]; linarith [hcon x hx]
  have hFi : Integrable F μ :=
    Integrable.of_bound (C := 1) hFm (.of_forall fun x => by
      rw [Real.norm_eq_abs, abs_of_nonneg (hF0 x)]; exact hF1 x)
  have hGi : Integrable (fun x => B.indicator (fun _ => (1 : ℝ)) x + κ / 2) μ :=
    ((integrable_const (1 : ℝ)).indicator hBm).add (integrable_const _)
  have hint := integral_mono hFi hGi hle
  rw [integral_add ((integrable_const (1 : ℝ)).indicator hBm) (integrable_const _),
    integral_indicator hBm, setIntegral_const, integral_const] at hint
  simp only [smul_eq_mul, mul_one, probReal_univ, one_mul] at hint
  linarith

end

section
open Filter Topology MeasureTheory

theorem monTerm_smul {n : ℕ} (d : Fin n →₀ ℕ) (H : ℝ) (u : Fin n → ℝ) :
    monTerm d (fun i => H * u i) = H ^ (d.sum fun _ e => e) * monTerm d u := by
  classical
  simp only [monTerm, mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum]
  congr 1
  rw [Finsupp.sum, ← Finset.sum_subset (Finset.subset_univ d.support)]
  intro i _ hi
  exact Finsupp.notMem_support_iff.mp hi

/-- **Homogeneity of the gap polynomials**, used in blueprint `patch:pet-physical-radii`:
`p(H u) = H^k p(u)` for an integer polynomial homogeneous of degree `k`. -/
theorem aeval_smul_of_isHomogeneous {n k : ℕ} {p : MvPolynomial (Fin n) ℤ}
    (hp : p.IsHomogeneous k) (H : ℝ) (u : Fin n → ℝ) :
    MvPolynomial.aeval (fun i => H * u i) p = H ^ k * MvPolynomial.aeval u p := by
  rw [aeval_eq_sum_monTerm, aeval_eq_sum_monTerm, Finset.mul_sum]
  refine Finset.sum_congr rfl fun d hd => ?_
  rw [monTerm_smul]
  have hdeg : (d.sum fun _ e => e) = k := by
    have := hp (MvPolynomial.mem_support_iff.mp hd)
    simpa [Finsupp.weight_apply, Finsupp.sum] using this
  rw [hdeg]; ring

/-- **Blueprint `patch:pet-physical-radii`**: at old shifts `h = H u` outside the bad sublevel
set, the Fejer radii `L_i = |a p_i(h)| H` of the changed increments are two-sided power bounded:
`A_lo ε H^{k+1} ≤ L_i ≤ A_hi M₁ H^{k+1}` when `A_lo ≤ |a| ≤ A_hi` and `ε ≤ |p_i(u)| ≤ M₁`. -/
theorem petPhysicalRadius_bounds {n k : ℕ} {p : MvPolynomial (Fin n) ℤ}
    (hp : p.IsHomogeneous k) {a H A_lo A_hi ε M₁ : ℝ} (hH : 0 < H)
    (ha_lo : A_lo ≤ |a|) (ha_hi : |a| ≤ A_hi) (hA_lo : 0 ≤ A_lo) (hε0 : 0 ≤ ε)
    {u : Fin n → ℝ} (hε : ε ≤ |MvPolynomial.aeval u p|) (hM : |MvPolynomial.aeval u p| ≤ M₁) :
    A_lo * ε * H ^ (k + 1)
        ≤ |a * MvPolynomial.aeval (fun i => H * u i) p| * H
      ∧ |a * MvPolynomial.aeval (fun i => H * u i) p| * H ≤ A_hi * M₁ * H ^ (k + 1) := by
  rw [aeval_smul_of_isHomogeneous hp, abs_mul, abs_mul, abs_of_pos (pow_pos hH k), pow_succ]
  have hHk : 0 < H ^ k := pow_pos hH k
  constructor
  · have h1 : A_lo * ε ≤ |a| * |MvPolynomial.aeval u p| :=
      mul_le_mul ha_lo hε hε0 (abs_nonneg _)
    nlinarith [mul_pos hHk hH]
  · have h1 : |a| * |MvPolynomial.aeval u p| ≤ A_hi * M₁ :=
      mul_le_mul ha_hi hM (abs_nonneg _) (hA_lo.trans (ha_lo.trans ha_hi))
    nlinarith [mul_pos hHk hH]

end

section
open Filter Topology MeasureTheory

/-- A bounded a.e.-strongly-measurable function on `E3` vanishing off a ball is integrable. -/
theorem integrable_of_bdd_ball {E : Type*} [NormedAddCommGroup E] {f : E3 → E}
    (hf : AEStronglyMeasurable f volume) {C R : ℝ} (hC : ∀ x, ‖f x‖ ≤ C)
    (hR : ∀ x, R < ‖x‖ → f x = 0) : Integrable f := by
  have hi : IntegrableOn f (Metric.closedBall (0 : E3) R) := by
    refine Measure.integrableOn_of_bounded (M := C) ?_ ?_ ?_
    · exact measure_closedBall_lt_top.ne
    · exact hf
    · exact .of_forall hC
  have heq : f = (Metric.closedBall (0 : E3) R).indicator f := by
    funext x
    by_cases hx : x ∈ Metric.closedBall (0 : E3) R
    · rw [Set.indicator_of_mem hx]
    · rw [Set.indicator_of_notMem hx, hR x (by simpa using hx)]
  rw [heq]
  exact hi.integrable_indicator measurableSet_closedBall

/-- A bounded measurable function on `E3 × ℝ` vanishing off `ball × window`-type sets is
integrable against `volume × ν` for a finite measure `ν`. -/
theorem integrable_prod_of_bdd_ball {ν : Measure ℝ} [IsFiniteMeasure ν] {f : E3 × ℝ → ℂ}
    (hf : AEStronglyMeasurable f ((volume : Measure E3).prod ν)) {C R : ℝ}
    (hC : ∀ z, ‖f z‖ ≤ C) (hR : ∀ z, R < ‖z.1‖ → f z = 0) :
    Integrable f ((volume : Measure E3).prod ν) := by
  have hC0 : 0 ≤ C := (norm_nonneg _).trans (hC ((0 : E3), (0 : ℝ)))
  set g : E3 → ℝ := (Metric.closedBall (0 : E3) R).indicator (fun _ => C) with hgdef
  have hI : Integrable g := integrable_of_bdd_ball
    ((measurable_const.indicator measurableSet_closedBall).aestronglyMeasurable)
    (C := C) (R := R) (fun x => by
      by_cases hx : x ∈ Metric.closedBall (0 : E3) R
      · rw [hgdef, Set.indicator_of_mem hx, Real.norm_eq_abs, abs_of_nonneg hC0]
      · rw [hgdef, Set.indicator_of_notMem hx, norm_zero]; exact hC0)
    (fun x hx => Set.indicator_of_notMem (by simpa using hx) _)
  have hg := Integrable.mul_prod (μ := (volume : Measure E3)) (ν := ν) hI (integrable_const (1 : ℝ))
  refine hg.mono' hf (.of_forall fun z => ?_)
  simp only [mul_one]
  by_cases hz : z.1 ∈ Metric.closedBall (0 : E3) R
  · rw [hgdef, Set.indicator_of_mem hz]; exact hC z
  · rw [hR z (by simpa using hz), norm_zero, hgdef, Set.indicator_of_notMem hz]

/-- The same on `volume × volume.restrict S` for a finite-measure window `S`, when the vanishing is
only asserted over `S`. -/
theorem integrable_prod_restrict_of_bdd_ball {S : Set ℝ} (hS : MeasurableSet S)
    (hSfin : volume S ≠ ⊤) {f : E3 × ℝ → ℂ}
    (hf : AEStronglyMeasurable f ((volume : Measure E3).prod (volume.restrict S))) {C R : ℝ}
    (hC : ∀ z, ‖f z‖ ≤ C) (hR : ∀ z, z.2 ∈ S → R < ‖z.1‖ → f z = 0) :
    Integrable f ((volume : Measure E3).prod (volume.restrict S)) := by
  have : IsFiniteMeasure (volume.restrict S) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact hSfin.lt_top⟩
  have hae : ∀ᵐ z ∂((volume : Measure E3).prod (volume.restrict S)), z.2 ∈ S := by
    have h0 : ((volume : Measure E3).prod (volume.restrict S)) (Set.univ ×ˢ Sᶜ) = 0 := by
      rw [Measure.prod_prod, Measure.restrict_apply hS.compl, Set.compl_inter_self,
        measure_empty, mul_zero]
    refine measure_mono_null (fun z hz => ?_) h0
    exact ⟨Set.mem_univ _, hz⟩
  set g : E3 × ℝ → ℂ := fun z => S.indicator (fun _ => (1 : ℂ)) z.2 * f z with hgdef
  have hg : Integrable g ((volume : Measure E3).prod (volume.restrict S)) := by
    refine integrable_prod_of_bdd_ball ?_ (C := C) (R := R) (fun z => ?_) (fun z hz => ?_)
    · exact (((measurable_const.indicator hS).comp measurable_snd).aestronglyMeasurable).mul hf
    · simp only [hgdef]
      by_cases h2 : z.2 ∈ S
      · rw [Set.indicator_of_mem h2, one_mul]; exact hC z
      · rw [Set.indicator_of_notMem h2, zero_mul, norm_zero]
        exact (norm_nonneg _).trans (hC z)
    · simp only [hgdef]
      by_cases h2 : z.2 ∈ S
      · rw [hR z h2 hz, mul_zero]
      · rw [Set.indicator_of_notMem h2, zero_mul]
  refine hg.congr ?_
  filter_upwards [hae] with z hz
  simp [hgdef, Set.indicator_of_mem hz]

/-- The window average of a bounded measurable family vanishing off a ball for parameters in the
window: measurable, bounded, vanishing off the ball. -/
theorem windowAvg_facts {F : E3 → ℝ → ℂ} (hFm : Measurable (Function.uncurry F))
    (hF1 : ∀ x t, ‖F x t‖ ≤ 1) {c N R : ℝ} (hN : 0 < N)
    (hR : ∀ x t, t ∈ Set.Icc c (c + N) → R < ‖x‖ → F x t = 0) :
    Measurable (fun x => ∫ t in c..(c + N), F x t)
      ∧ (∀ x, ‖∫ t in c..(c + N), F x t‖ ≤ N)
      ∧ (∀ x, R < ‖x‖ → ∫ t in c..(c + N), F x t = 0) := by
  have hle : c ≤ c + N := by linarith
  refine ⟨?_, fun x => ?_, fun x hx => ?_⟩
  · simp_rw [intervalIntegral.integral_of_le hle]
    exact (hFm.stronglyMeasurable.integral_prod_right'
      (ν := volume.restrict (Set.Ioc c (c + N)))).measurable
  · have := intervalIntegral.norm_integral_le_of_norm_le_const (a := c) (b := c + N)
      (C := 1) (f := F x) (fun t _ => hF1 x t)
    simpa [abs_of_pos hN] using this
  · refine intervalIntegral.integral_zero_ae (.of_forall fun t ht => hR x t ?_ hx)
    rw [Set.uIoc_of_le hle] at ht
    exact ⟨le_of_lt ht.1, ht.2⟩

/-- The windowed autocorrelation of a bounded measurable family vanishing off a ball for
parameters in the window: jointly measurable, bounded by `N`, vanishing off the ball. -/
theorem windowAutocorr_facts {F : E3 → ℝ → ℂ} (hFm : Measurable (Function.uncurry F))
    (hF1 : ∀ x t, ‖F x t‖ ≤ 1) {c N R : ℝ} (hN : 0 < N)
    (hR : ∀ x t, t ∈ Set.Icc c (c + N) → R < ‖x‖ → F x t = 0) :
    Measurable (fun z : E3 × ℝ => autocorr ((Set.Ioc c (c + N)).indicator (F z.1)) z.2)
      ∧ (∀ x h, ‖autocorr ((Set.Ioc c (c + N)).indicator (F x)) h‖ ≤ N)
      ∧ (∀ x h, R < ‖x‖ → autocorr ((Set.Ioc c (c + N)).indicator (F x)) h = 0) := by
  have hI : MeasurableSet (Set.Ioc c (c + N)) := measurableSet_Ioc
  set K : (E3 × ℝ) × ℝ → ℂ := fun w =>
    (Set.Ioc c (c + N)).indicator (F w.1.1) (w.2 + w.1.2)
      * (starRingEnd ℂ) ((Set.Ioc c (c + N)).indicator (F w.1.1) w.2) with hK
  have hind : ∀ {a : (E3 × ℝ) × ℝ → E3} {b : (E3 × ℝ) × ℝ → ℝ}, Measurable a → Measurable b →
      Measurable fun w => (Set.Ioc c (c + N)).indicator (F (a w)) (b w) := by
    intro a b ha hb
    have : (fun w => (Set.Ioc c (c + N)).indicator (F (a w)) (b w))
        = fun w => (Set.Ioc c (c + N)).indicator (fun _ => (1 : ℂ)) (b w) * F (a w) (b w) := by
      funext w
      by_cases hw : b w ∈ Set.Ioc c (c + N)
      · simp [Set.indicator_of_mem hw]
      · simp [Set.indicator_of_notMem hw]
    rw [this]
    exact ((measurable_const.indicator hI).comp hb).mul (hFm.comp (ha.prodMk hb))
  have hKm : Measurable K :=
    (hind (measurable_fst.comp measurable_fst) (measurable_snd.add
      (measurable_snd.comp measurable_fst))).mul
      (Complex.continuous_conj.measurable.comp
        (hind (measurable_fst.comp measurable_fst) measurable_snd))
  refine ⟨?_, fun x h => ?_, fun x h hx => ?_⟩
  · exact (hKm.stronglyMeasurable.integral_prod_right' (ν := volume)).measurable
  · unfold autocorr
    have hb : ∀ t, ‖(Set.Ioc c (c + N)).indicator (F x) (t + h)
        * (starRingEnd ℂ) ((Set.Ioc c (c + N)).indicator (F x) t)‖
        ≤ (Set.Ioc c (c + N)).indicator (fun _ => (1 : ℝ)) t := fun t => by
      rw [norm_mul, RCLike.norm_conj]
      by_cases ht : t ∈ Set.Ioc c (c + N)
      · rw [Set.indicator_of_mem ht, Set.indicator_of_mem ht]
        have h1 : ‖(Set.Ioc c (c + N)).indicator (F x) (t + h)‖ ≤ 1 := by
          by_cases ht' : t + h ∈ Set.Ioc c (c + N)
          · rw [Set.indicator_of_mem ht']; exact hF1 _ _
          · rw [Set.indicator_of_notMem ht', norm_zero]; exact zero_le_one
        exact ((mul_le_of_le_one_left (norm_nonneg _) h1).trans (hF1 x t))
      · rw [Set.indicator_of_notMem ht, Set.indicator_of_notMem ht, norm_zero, mul_zero]
    refine (norm_integral_le_of_norm_le
      ((continuous_const.integrableOn_Ioc (μ := volume)).integrable_indicator hI)
      (.of_forall hb)).trans (le_of_eq ?_)
    rw [integral_indicator hI, setIntegral_const, Real.volume_real_Ioc_of_le (by linarith),
      smul_eq_mul, mul_one]
    ring
  · unfold autocorr
    refine integral_eq_zero_of_ae (.of_forall fun t => ?_)
    simp only [Pi.zero_apply]
    by_cases ht : t ∈ Set.Ioc c (c + N)
    · rw [Set.indicator_of_mem ht, hR x t ⟨le_of_lt ht.1, ht.2⟩ hx, map_zero, mul_zero]
    · rw [Set.indicator_of_notMem ht, map_zero, mul_zero]

/-- **Blueprint `patch:signed-vdc`, for bounded families of bounded support**: the signed
integrated removal of `Auto.sq_norm_signed_vdc` on `E3`, with all its integrability side conditions
discharged from `|F| ≤ 1`, `|g| ≤ 1`, measurability, and vanishing off a fixed ball for parameters
in the window. -/
theorem sq_norm_signed_vdc_bdd {c N H V R : ℝ} (hN : 0 < N) (hH : 0 < H) (hHN : H ≤ N / 4)
    (hV : 0 < V) {g : E3 → ℂ} {F : E3 → ℝ → ℂ}
    (hFm : Measurable (Function.uncurry F)) (hF1 : ∀ x t, ‖F x t‖ ≤ 1)
    (hFR : ∀ x t, t ∈ Set.Icc c (c + N) → R < ‖x‖ → F x t = 0)
    (hsq : ∀ s : ℝ, Integrable (fun x => ‖F x s‖ ^ 2))
    (hcross : ∀ s s' : ℝ, Integrable (fun x => ‖F x s‖ * ‖F x s'‖))
    (hFV : ∀ s : ℝ, (∫ x, ‖F x s‖ ^ 2) ≤ V)
    (hgm : Measurable g) (hg1 : ∀ x, ‖g x‖ ≤ 1) (hgR : ∀ x, R < ‖x‖ → g x = 0)
    (hgV : (∫ x, ‖g x‖ ^ 2) ≤ V) :
    ‖(V⁻¹ : ℝ) • ∫ x, g x * ((N⁻¹ : ℝ) • ∫ t in c..(c + N), F x t)‖ ^ 2
      ≤ 2 * (V⁻¹ * N⁻¹ * (∫ h : ℝ, fejer H h • ∫ t in c..(c + N),
          corrLine (volume : Measure E3) F t h).re) + 2 * H / N := by
  obtain ⟨hAm, hAb, hAR⟩ := windowAvg_facts hFm hF1 hN hFR
  obtain ⟨hCm, hCb, hCR⟩ := windowAutocorr_facts hFm hF1 hN hFR
  have hNinv : 0 < N⁻¹ := inv_pos.mpr hN
  have hscal : ∀ x, ‖(N⁻¹ : ℝ) • ∫ t in c..(c + N), F x t‖ ≤ 1 := fun x => by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hNinv]
    calc N⁻¹ * ‖∫ t in c..(c + N), F x t‖ ≤ N⁻¹ * N := by gcongr; exact hAb x
      _ = 1 := inv_mul_cancel₀ hN.ne'
  have hind : ∀ x, (∫ u : ℝ, (Set.Ioc c (c + N)).indicator (F x) u)
      = ∫ t in c..(c + N), F x t := fun x => by
    rw [integral_indicator measurableSet_Ioc, intervalIntegral.integral_of_le (by linarith)]
  have hfejm : Measurable fun z : E3 × ℝ =>
      fejer H z.2 • autocorr ((Set.Ioc c (c + N)).indicator (F z.1)) z.2 :=
    (continuous_fejer.measurable.comp measurable_snd).smul hCm
  have hRcm : Measurable fun x : E3 => ∫ h : ℝ, fejer H h •
      autocorr ((Set.Ioc c (c + N)).indicator (F x)) h :=
    (hfejm.stronglyMeasurable.integral_prod_right' (ν := volume)).measurable
  have hRcb : ∀ x, ‖∫ h : ℝ, fejer H h • autocorr ((Set.Ioc c (c + N)).indicator (F x)) h‖
      ≤ N := fun x => by
    calc _ ≤ ∫ h : ℝ, fejer H h * N := by
          refine norm_integral_le_of_norm_le ((integrable_fejer hH).mul_const N)
            (.of_forall fun h => ?_)
          rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (fejer_nonneg hH h)]
          exact mul_le_mul_of_nonneg_left (hCb x h) (fejer_nonneg hH h)
      _ = N := by rw [integral_mul_const, integral_fejer hH, one_mul]
  have hRcR : ∀ x, R < ‖x‖ → (∫ h : ℝ, fejer H h •
      autocorr ((Set.Ioc c (c + N)).indicator (F x)) h) = 0 := fun x hx => by
    refine integral_eq_zero_of_ae (.of_forall fun h => ?_)
    simp [hCR x h hx]
  refine sq_norm_signed_vdc hN hH hHN hV hFm zero_le_one hF1 hsq hcross hFV ?_ hgV ?_ ?_ ?_ ?_ ?_
    ?_ ?_
  · -- hg2
    refine integrable_of_bdd_ball ((hgm.norm.pow_const 2).aestronglyMeasurable) (C := 1) (R := R)
      (fun x => ?_) (fun x hx => by simp [hgR x hx])
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    exact pow_le_one₀ (norm_nonneg _) (hg1 x)
  · -- hΦ2
    refine integrable_of_bdd_ball
      ((((hAm.const_smul (N⁻¹ : ℝ)).norm).pow_const 2).aestronglyMeasurable)
      (C := 1) (R := R) (fun x => ?_) (fun x hx => by simp [hAR x hx])
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    exact pow_le_one₀ (norm_nonneg _) (hscal x)
  · -- hgΦ
    refine integrable_of_bdd_ball
      ((hgm.norm.mul (hAm.const_smul (N⁻¹ : ℝ)).norm).aestronglyMeasurable)
      (C := 1) (R := R) (fun x => ?_) (fun x hx => by simp [hgR x hx])
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    exact ((mul_le_of_le_one_left (norm_nonneg _) (hg1 x)).trans (hscal x))
  · -- hLi
    simp_rw [hind]
    refine integrable_of_bdd_ball ((hAm.norm.pow_const 2).aestronglyMeasurable) (C := N ^ 2)
      (R := R) (fun x => ?_) (fun x hx => by simp [hAR x hx])
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    exact pow_le_pow_left₀ (norm_nonneg _) (hAb x) 2
  · -- hRi
    refine integrable_of_bdd_ball ((Complex.measurable_re.comp hRcm).aestronglyMeasurable)
      (C := N) (R := R) (fun x => ?_) (fun x hx => by
        change (∫ h : ℝ, fejer H h • autocorr ((Set.Ioc c (c + N)).indicator (F x)) h).re = 0
        rw [hRcR x hx, Complex.zero_re])
    exact (RCLike.norm_re_le_norm _).trans (hRcb x)
  · -- hRc
    exact integrable_of_bdd_ball hRcm.aestronglyMeasurable (C := N) (R := R) hRcb hRcR
  · -- hswapH
    set gb : E3 → ℝ := (Metric.closedBall (0 : E3) R).indicator (fun _ => N) with hgb
    have hgbi : Integrable gb := integrable_of_bdd_ball
      ((measurable_const.indicator measurableSet_closedBall).aestronglyMeasurable)
      (C := N) (R := R) (fun x => by
        by_cases hx : x ∈ Metric.closedBall (0 : E3) R
        · rw [hgb, Set.indicator_of_mem hx, Real.norm_eq_abs, abs_of_pos hN]
        · rw [hgb, Set.indicator_of_notMem hx, norm_zero]; exact hN.le)
      (fun x hx => Set.indicator_of_notMem (by simpa using hx) _)
    refine (hgbi.mul_prod (integrable_fejer hH)).mono' hfejm.aestronglyMeasurable
      (.of_forall fun z => ?_)
    simp only [Function.uncurry]
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (fejer_nonneg hH _), mul_comm]
    by_cases hz : z.1 ∈ Metric.closedBall (0 : E3) R
    · rw [hgb, Set.indicator_of_mem hz]
      exact mul_le_mul_of_nonneg_right (hCb _ _) (fejer_nonneg hH _)
    · rw [hCR z.1 z.2 (by simpa using hz), norm_zero, zero_mul, hgb,
        Set.indicator_of_notMem hz, zero_mul]
  · -- hswapT
    intro h
    refine integrable_prod_restrict_of_bdd_ball (measurableSet_capSet c N h)
      ((measure_mono Set.inter_subset_left).trans_lt measure_Ioc_lt_top).ne ?_ (C := 1) (R := R)
      (fun z => ?_) (fun z hz hzR => ?_)
    · exact ((hFm.comp (measurable_fst.prodMk (measurable_snd.add_const h))).mul
        (Complex.continuous_conj.measurable.comp hFm)).aestronglyMeasurable
    · simp only [Function.uncurry]
      rw [norm_mul, RCLike.norm_conj]
      exact ((mul_le_of_le_one_left (norm_nonneg _) (hF1 _ _)).trans (hF1 _ _))
    · simp only [Function.uncurry]
      have ht : z.2 ∈ Set.Icc c (c + N) := ⟨le_of_lt hz.1.1, hz.1.2⟩
      rw [hFR z.1 z.2 ht hzR, map_zero, mul_zero]

end

section
open Filter Topology MeasureTheory

/-- A PET family: blocks with vector-valued shifts. -/
abbrev PetFam := List ((E3 → ℂ) × (ℝ → E3))

/-- The product `∏ G_b (x + Q_b(t))` over a PET family. -/
noncomputable def vecProd (L : PetFam) (x : E3) (t : ℝ) : ℂ :=
  (L.map fun b => b.1 (x + b.2 t)).prod

/-- The children of a PET family under a pivot shift `Q_p` and a new shift `u`, blueprint
`patch:pet-update`: each block `(G, Q)` gives `(G, Q(· + u) - Q_p)` and `(conj G, Q - Q_p)`. -/
noncomputable def vecChildren (L : PetFam) (Qp : ℝ → E3) (u : ℝ) : PetFam :=
  L.flatMap fun b => [(b.1, fun t => b.2 (t + u) - Qp t),
    (fun y => conj (b.1 y), fun t => b.2 t - Qp t)]

@[simp] theorem vecProd_nil (x : E3) (t : ℝ) : vecProd [] x t = 1 := rfl

theorem vecProd_cons (b : (E3 → ℂ) × (ℝ → E3)) (L : PetFam) (x : E3) (t : ℝ) :
    vecProd (b :: L) x t = b.1 (x + b.2 t) * vecProd L x t := rfl

/-- The correlation integrand, translated by the pivot, is the product over the children. -/
theorem vecProd_children (L : PetFam) (Qp : ℝ → E3) (x : E3) (t u : ℝ) :
    vecProd L (x - Qp t) (t + u) * conj (vecProd L (x - Qp t) t)
      = vecProd (vecChildren L Qp u) x t := by
  induction L with
  | nil => simp [vecChildren]
  | cons b L ih =>
    have hc : vecChildren (b :: L) Qp u = (b.1, fun t => b.2 (t + u) - Qp t)
        :: (fun y => conj (b.1 y), fun t => b.2 t - Qp t) :: vecChildren L Qp u := by
      simp [vecChildren]
    rw [hc, vecProd_cons, vecProd_cons, vecProd_cons, vecProd_cons, map_mul, ← ih]
    simp only
    have h1 : x - Qp t + b.2 (t + u) = x + (b.2 (t + u) - Qp t) := by abel
    have h2 : x - Qp t + b.2 t = x + (b.2 t - Qp t) := by abel
    rw [h1, h2]
    ring

/-- **The correlation line of a PET family is the integrated child family**, the patch's
identification of the two children of each factor. -/
theorem corrLine_vecProd (L : PetFam) (Qp : ℝ → E3) (t u : ℝ) :
    corrLine (volume : Measure E3) (vecProd L) t u = ∫ x, vecProd (vecChildren L Qp u) x t := by
  unfold corrLine
  rw [← integral_sub_right_eq_self _ (Qp t)]
  exact integral_congr_ae (.of_forall fun x => vecProd_children L Qp x t u)

theorem norm_vecProd_le {L : PetFam} (hL : ∀ b ∈ L, ∀ y, ‖b.1 y‖ ≤ 1) (x : E3) (t : ℝ) :
    ‖vecProd L x t‖ ≤ 1 := by
  induction L with
  | nil => simp
  | cons b L ih =>
    rw [vecProd_cons, norm_mul]
    exact ((mul_le_of_le_one_left (norm_nonneg _) (hL b (by simp) _)).trans (ih fun b' hb' => hL
      b' (List.mem_cons_of_mem _ hb')))

theorem measurable_vecProd {L : PetFam} (hL : ∀ b ∈ L, Measurable b.1 ∧ Continuous b.2) :
    Measurable (Function.uncurry (vecProd L)) := by
  induction L with
  | nil => exact measurable_const
  | cons b L ih =>
    have hb := hL b (by simp)
    have : Function.uncurry (vecProd (b :: L))
        = fun z : E3 × ℝ => b.1 (z.1 + b.2 z.2) * Function.uncurry (vecProd L) z := by
      funext z; rfl
    rw [this]
    exact (hb.1.comp (measurable_fst.add (hb.2.measurable.comp measurable_snd))).mul
      (ih fun b' hb' => hL b' (List.mem_cons_of_mem _ hb'))

/-- A nonempty family with a first block vanishing off a ball vanishes when the translated point
leaves it. -/
theorem vecProd_eq_zero_of_head {b : (E3 → ℂ) × (ℝ → E3)} {L : PetFam} {R₀ : ℝ}
    (hb : ∀ y, R₀ < ‖y‖ → b.1 y = 0) {x : E3} {t : ℝ} (hx : R₀ < ‖x + b.2 t‖) :
    vecProd (b :: L) x t = 0 := by
  rw [vecProd_cons, hb _ hx, zero_mul]

/-- **Blueprint `patch:pet-analytic-step`, for vector shifts**: for a PET family of measurable
one-bounded blocks with continuous shifts, whose first block vanishes off the ball of radius `R₀`
(with `|B_{R₀}| ≤ V`), and a spatial block `g` as in `patch:signed-vdc`,
`|A|^2 ≤ 2 Re E_{u ~ κ_H} A'(u) + 2H/N`, where `A'(u)` is the state of the children under any
pivot shift `Q_p`. -/
theorem vecStep {c N H V R₀ Rg : ℝ} (hN : 0 < N) (hH : 0 < H) (hHN : H ≤ N / 4) (hV : 0 < V)
    {b : (E3 → ℂ) × (ℝ → E3)} {L : PetFam}
    (hL : ∀ b' ∈ b :: L, Measurable b'.1 ∧ Continuous b'.2)
    (hL1 : ∀ b' ∈ b :: L, ∀ y, ‖b'.1 y‖ ≤ 1)
    (hb : ∀ y, R₀ < ‖y‖ → b.1 y = 0)
    (hVR : (volume (Metric.closedBall (0 : E3) R₀)).toReal ≤ V)
    {g : E3 → ℂ} (hgm : Measurable g) (hg1 : ∀ x, ‖g x‖ ≤ 1) (hgR : ∀ x, Rg < ‖x‖ → g x = 0)
    (hgV : (∫ x, ‖g x‖ ^ 2) ≤ V) (Qp : ℝ → E3) :
    ‖(V⁻¹ : ℝ) • ∫ x, g x * ((N⁻¹ : ℝ) • ∫ t in c..(c + N), vecProd (b :: L) x t)‖ ^ 2
      ≤ 2 * (V⁻¹ * N⁻¹ * (∫ h : ℝ, fejer H h • ∫ t in c..(c + N),
          ∫ x, vecProd (vecChildren (b :: L) Qp h) x t).re) + 2 * H / N := by
  have hFm := measurable_vecProd hL
  have hF1 := norm_vecProd_le hL1
  have hb2 := (hL b (by simp)).2
  obtain ⟨B, hB⟩ : ∃ B, ∀ t ∈ Set.Icc c (c + N), ‖b.2 t‖ ≤ B :=
    (isCompact_Icc.image_of_continuousOn hb2.continuousOn).isBounded.exists_norm_le.imp
      fun B hB t ht => hB _ ⟨t, ht, rfl⟩
  have hR0 : 0 ≤ (volume (Metric.closedBall (0 : E3) R₀)).toReal := ENNReal.toReal_nonneg
  -- per-parameter support and square-integrability
  have hsec : ∀ s x, ‖vecProd (b :: L) x s‖
      ≤ (Metric.closedBall (0 : E3) R₀).indicator (fun _ => (1 : ℝ)) (x + b.2 s) := by
    intro s x
    by_cases hx : x + b.2 s ∈ Metric.closedBall (0 : E3) R₀
    · rw [Set.indicator_of_mem hx]; exact hF1 x s
    · rw [Set.indicator_of_notMem hx, vecProd_eq_zero_of_head hb (by simpa using hx), norm_zero]
  have hsecR : ∀ s x, R₀ + ‖b.2 s‖ < ‖x‖ → vecProd (b :: L) x s = 0 := by
    intro s x hx
    refine vecProd_eq_zero_of_head hb ?_
    have := norm_sub_norm_le x (-(b.2 s))
    rw [norm_neg, sub_neg_eq_add] at this
    linarith
  have hmeas_s : ∀ s, Measurable fun x => vecProd (b :: L) x s := fun s =>
    hFm.comp (measurable_id.prodMk measurable_const)
  have hsq : ∀ s : ℝ, Integrable (fun x => ‖vecProd (b :: L) x s‖ ^ 2) := fun s =>
    integrable_of_bdd_ball (((hmeas_s s).norm.pow_const 2).aestronglyMeasurable) (C := 1)
      (R := R₀ + ‖b.2 s‖) (fun x => by
        rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
        exact pow_le_one₀ (norm_nonneg _) (hF1 x s))
      (fun x hx => by simp [hsecR s x hx])
  have hcross : ∀ s s' : ℝ, Integrable (fun x => ‖vecProd (b :: L) x s‖
      * ‖vecProd (b :: L) x s'‖) := fun s s' =>
    integrable_of_bdd_ball (((hmeas_s s).norm.mul (hmeas_s s').norm).aestronglyMeasurable)
      (C := 1) (R := R₀ + ‖b.2 s‖) (fun x => by
        rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
        exact ((mul_le_of_le_one_left (norm_nonneg _) (hF1 x s)).trans (hF1 x s')))
      (fun x hx => by simp [hsecR s x hx])
  have hFV : ∀ s : ℝ, (∫ x, ‖vecProd (b :: L) x s‖ ^ 2) ≤ V := by
    intro s
    refine le_trans ?_ hVR
    have hind : Integrable fun x : E3 =>
        (Metric.closedBall (0 : E3) R₀).indicator (fun _ => (1 : ℝ)) (x + b.2 s) := by
      have h0 : Integrable ((Metric.closedBall (0 : E3) R₀).indicator fun _ => (1 : ℝ)) :=
        integrable_of_bdd_ball ((measurable_const.indicator
          measurableSet_closedBall).aestronglyMeasurable) (C := 1) (R := R₀)
          (fun x => by
            by_cases hx : x ∈ Metric.closedBall (0 : E3) R₀
            · rw [Set.indicator_of_mem hx]; simp
            · rw [Set.indicator_of_notMem hx]; simp)
          (fun x hx => Set.indicator_of_notMem (by simpa using hx) _)
      exact h0.comp_add_right (b.2 s)
    calc (∫ x, ‖vecProd (b :: L) x s‖ ^ 2)
        ≤ ∫ x, (Metric.closedBall (0 : E3) R₀).indicator (fun _ => (1 : ℝ)) (x + b.2 s) := by
          refine integral_mono (hsq s) hind fun x => ?_
          have h1 := hsec s x
          have h2 : ‖vecProd (b :: L) x s‖ ^ 2 ≤ ‖vecProd (b :: L) x s‖ :=
            by nlinarith [norm_nonneg (vecProd (b :: L) x s), hF1 x s]
          exact h2.trans h1
      _ = (volume (Metric.closedBall (0 : E3) R₀)).toReal := by
          rw [integral_add_right_eq_self (fun x => (Metric.closedBall (0 : E3) R₀).indicator
            (fun _ => (1 : ℝ)) x) (b.2 s), integral_indicator measurableSet_closedBall,
            setIntegral_const, smul_eq_mul, mul_one, Measure.real]
  have hFR : ∀ x t, t ∈ Set.Icc c (c + N) → max (R₀ + B) Rg < ‖x‖ → vecProd (b :: L) x t = 0 :=
    fun x t ht hx => hsecR t x (lt_of_le_of_lt (add_le_add_right (hB t ht) R₀)
      (lt_of_le_of_lt (le_max_left _ _) hx))
  have key := sq_norm_signed_vdc_bdd (R := max (R₀ + B) Rg) hN hH hHN hV hFm hF1 hFR hsq
    hcross hFV hgm hg1 (fun x hx => hgR x (lt_of_le_of_lt (le_max_right _ _) hx)) hgV
  have hcl : ∀ h : ℝ, (∫ t in c..(c + N), corrLine (volume : Measure E3) (vecProd (b :: L)) t h)
      = ∫ t in c..(c + N), ∫ x, vecProd (vecChildren (b :: L) Qp h) x t := fun h =>
    intervalIntegral.integral_congr fun t _ => corrLine_vecProd (b :: L) Qp t h
  simp_rw [hcl] at key
  exact key

end

section
open Filter Topology MeasureTheory

/-- The phase factor of the children: `φ(x - Q_p(t), t + u) conj φ(x - Q_p(t), t)`. -/
noncomputable def phaseChild (φ : E3 → ℝ → ℂ) (Qp : ℝ → E3) (u : ℝ) (x : E3) (t : ℝ) : ℂ :=
  φ (x - Qp t) (t + u) * conj (φ (x - Qp t) t)

theorem corrLine_vecProd_phase (L : PetFam) (φ : E3 → ℝ → ℂ) (Qp : ℝ → E3) (t u : ℝ) :
    corrLine (volume : Measure E3) (fun x s => vecProd L x s * φ x s) t u
      = ∫ x, vecProd (vecChildren L Qp u) x t * phaseChild φ Qp u x t := by
  unfold corrLine
  rw [← integral_sub_right_eq_self _ (Qp t)]
  refine integral_congr_ae (.of_forall fun x => ?_)
  simp only
  rw [← vecProd_children L Qp x t u, phaseChild, map_mul]
  ring

/-- **Blueprint `patch:pet-analytic-step` with a phase**, in the form iterated along the chain:
for a PET family of measurable one-bounded blocks with continuous shifts, times a measurable
one-bounded phase `φ`, whose first block vanishes off a bounded measurable set `K` with `|K| ≤ V`,
and a spatial block `g` vanishing off a bounded set with `∫ |g|^2 ≤ V`,
`|A|^2 ≤ 2 Re E_{u ~ κ_H} A'(u) + 2H/N`, `A'(u)` being the state of the children under any pivot
shift `Q_p` (with `Q_p = 0` for the phase steps). -/
theorem vecStep_phase {c N H V : ℝ} (hN : 0 < N) (hH : 0 < H) (hHN : H ≤ N / 4) (hV : 0 < V)
    {b : (E3 → ℂ) × (ℝ → E3)} {L : PetFam}
    (hL : ∀ b' ∈ b :: L, Measurable b'.1 ∧ Continuous b'.2)
    (hL1 : ∀ b' ∈ b :: L, ∀ y, ‖b'.1 y‖ ≤ 1)
    {φ : E3 → ℝ → ℂ} (hφm : Measurable (Function.uncurry φ)) (hφ1 : ∀ x t, ‖φ x t‖ ≤ 1)
    {K : Set E3} (hKm : MeasurableSet K) (hKb : Bornology.IsBounded K)
    (hb : ∀ y, y ∉ K → b.1 y = 0) (hKV : (volume K).toReal ≤ V)
    {g : E3 → ℂ} (hgm : Measurable g) (hg1 : ∀ x, ‖g x‖ ≤ 1) {Rg : ℝ}
    (hgR : ∀ x, Rg < ‖x‖ → g x = 0) (hgV : (∫ x, ‖g x‖ ^ 2) ≤ V) (Qp : ℝ → E3) :
    ‖(V⁻¹ : ℝ) • ∫ x, g x * ((N⁻¹ : ℝ) • ∫ t in c..(c + N), vecProd (b :: L) x t * φ x t)‖ ^ 2
      ≤ 2 * (V⁻¹ * N⁻¹ * (∫ h : ℝ, fejer H h • ∫ t in c..(c + N),
          ∫ x, vecProd (vecChildren (b :: L) Qp h) x t * phaseChild φ Qp h x t).re)
        + 2 * H / N := by
  let F : E3 → ℝ → ℂ := fun x s => vecProd (b :: L) x s * φ x s
  have hFdef : ∀ x s, F x s = vecProd (b :: L) x s * φ x s := fun _ _ => rfl
  have hFm : Measurable (Function.uncurry F) := (measurable_vecProd hL).mul hφm
  have hF1 : ∀ x t, ‖F x t‖ ≤ 1 := fun x t => by
    rw [hFdef x t, norm_mul]
    exact (mul_le_of_le_one_left (norm_nonneg _) (norm_vecProd_le hL1 x t)).trans (hφ1 x t)
  have hb2 := (hL b (by simp)).2
  obtain ⟨R₀, hR₀⟩ := (hKb.subset_closedBall (0 : E3))
  obtain ⟨B, hB⟩ : ∃ B, ∀ t ∈ Set.Icc c (c + N), ‖b.2 t‖ ≤ B :=
    (isCompact_Icc.image_of_continuousOn hb2.continuousOn).isBounded.exists_norm_le.imp
      fun B hB t ht => hB _ ⟨t, ht, rfl⟩
  have hFzero : ∀ s x, x + b.2 s ∉ K → F x s = 0 := fun s x hx => by
    rw [hFdef x s, vecProd_cons, hb _ hx, zero_mul, zero_mul]
  have hsecR : ∀ s x, R₀ + ‖b.2 s‖ < ‖x‖ → F x s = 0 := by
    intro s x hx
    refine hFzero s x fun hK => ?_
    have h1 := hR₀ hK
    rw [Metric.mem_closedBall, dist_zero_right] at h1
    have := norm_sub_norm_le x (-(b.2 s))
    rw [norm_neg, sub_neg_eq_add] at this
    linarith
  have hsec : ∀ s x, ‖F x s‖ ≤ K.indicator (fun _ => (1 : ℝ)) (x + b.2 s) := by
    intro s x
    by_cases hx : x + b.2 s ∈ K
    · rw [Set.indicator_of_mem hx]; exact hF1 x s
    · rw [Set.indicator_of_notMem hx, hFzero s x hx, norm_zero]
  have hmeas_s : ∀ s, Measurable fun x => F x s := fun s => by
    have h1 : Measurable fun x => vecProd (b :: L) x s :=
      (measurable_vecProd hL).comp (measurable_id.prodMk measurable_const)
    have h2 : Measurable fun x => φ x s := hφm.comp (measurable_id.prodMk measurable_const)
    exact h1.mul h2
  have hsq : ∀ s : ℝ, Integrable (fun x => ‖F x s‖ ^ 2) := fun s =>
    integrable_of_bdd_ball (((hmeas_s s).norm.pow_const 2).aestronglyMeasurable) (C := 1)
      (R := R₀ + ‖b.2 s‖) (fun x => by
        rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
        exact pow_le_one₀ (norm_nonneg _) (hF1 x s))
      (fun x hx => by simp [hsecR s x hx])
  have hcross : ∀ s s' : ℝ, Integrable (fun x => ‖F x s‖ * ‖F x s'‖) := fun s s' =>
    integrable_of_bdd_ball (((hmeas_s s).norm.mul (hmeas_s s').norm).aestronglyMeasurable)
      (C := 1) (R := R₀ + ‖b.2 s‖) (fun x => by
        rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
        exact ((mul_le_of_le_one_left (norm_nonneg _) (hF1 x s)).trans (hF1 x s')))
      (fun x hx => by simp [hsecR s x hx])
  have hKfin : volume K ≠ ⊤ := (hKb.measure_lt_top).ne
  have hind0 : Integrable (K.indicator fun _ => (1 : ℝ)) :=
    integrable_of_bdd_ball ((measurable_const.indicator hKm).aestronglyMeasurable) (C := 1)
      (R := R₀) (fun x => by
        by_cases hx : x ∈ K
        · rw [Set.indicator_of_mem hx]; simp
        · rw [Set.indicator_of_notMem hx]; simp)
      (fun x hx => Set.indicator_of_notMem (fun hK => by
        have h1 := hR₀ hK
        rw [Metric.mem_closedBall, dist_zero_right] at h1
        linarith) _)
  have hFV : ∀ s : ℝ, (∫ x, ‖F x s‖ ^ 2) ≤ V := by
    intro s
    refine le_trans ?_ hKV
    calc (∫ x, ‖F x s‖ ^ 2)
        ≤ ∫ x, K.indicator (fun _ => (1 : ℝ)) (x + b.2 s) := by
          refine integral_mono (hsq s) (hind0.comp_add_right (b.2 s)) fun x => ?_
          have h2 : ‖F x s‖ ^ 2 ≤ ‖F x s‖ := by nlinarith [norm_nonneg (F x s), hF1 x s]
          exact h2.trans (hsec s x)
      _ = (volume K).toReal := by
          rw [integral_add_right_eq_self (fun x => K.indicator (fun _ => (1 : ℝ)) x) (b.2 s),
            integral_indicator hKm, setIntegral_const, smul_eq_mul, mul_one, Measure.real]
  have hFR : ∀ x t, t ∈ Set.Icc c (c + N) → max (R₀ + B) Rg < ‖x‖ → F x t = 0 :=
    fun x t ht hx => hsecR t x (lt_of_le_of_lt (add_le_add_right (hB t ht) R₀)
      (lt_of_le_of_lt (le_max_left _ _) hx))
  have key := sq_norm_signed_vdc_bdd (R := max (R₀ + B) Rg) hN hH hHN hV hFm hF1 hFR hsq
    hcross hFV hgm hg1 (fun x hx => hgR x (lt_of_le_of_lt (le_max_right _ _) hx)) hgV
  have hcl : ∀ h : ℝ, (∫ t in c..(c + N), corrLine (volume : Measure E3) F t h)
      = ∫ t in c..(c + N), ∫ x, vecProd (vecChildren (b :: L) Qp h) x t
          * phaseChild φ Qp h x t := fun h =>
    intervalIntegral.integral_congr fun t _ => corrLine_vecProd_phase (b :: L) φ Qp t h
  simp_rw [hcl] at key
  exact key

end

section
open Filter Topology MeasureTheory

/-- The polynomials in the first `s` shift variables. -/
noncomputable abbrev petVarAlg (r s : ℕ) : Subalgebra ℝ (MvPolynomial (Fin r) ℝ) :=
  MvPolynomial.supported ℝ {v : Fin r | v.val < s}

/-- A vector polynomial whose coefficients use only the first `s` shift variables. -/
def PetPolyBelow {r n : ℕ} (s : ℕ) (Q : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)) : Prop :=
  ∀ q k, Q.coeff q k ∈ petVarAlg r s

theorem PetPolyBelow.mono {r n s s' : ℕ} (hs : s ≤ s')
    {Q : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)} (h : PetPolyBelow s Q) :
    PetPolyBelow s' Q := by
  intro q k
  have hsub : {v : Fin r | v.val < s} ⊆ {v : Fin r | v.val < s'} := by
    intro v hv
    simp only [Set.mem_ofPred_eq] at hv ⊢
    omega
  exact MvPolynomial.supported_mono hsub (h q k)

theorem PetPolyBelow.sub {r n s : ℕ} {Q R : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)}
    (hQ : PetPolyBelow s Q) (hR : PetPolyBelow s R) : PetPolyBelow s (Q - R) := fun q k => by
  rw [Polynomial.coeff_sub, Pi.sub_apply]; exact sub_mem (hQ q k) (hR q k)

theorem petPolyBelow_zero {r n s : ℕ} :
    PetPolyBelow s (0 : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)) := fun q k => by
  simp only [Polynomial.coeff_zero, Pi.zero_apply]; exact zero_mem _

theorem PetPolyBelow.petSubConst {r n s : ℕ} {Q : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)}
    (hQ : PetPolyBelow s Q) : PetPolyBelow s (petSubConst Q) := fun q k => by
  by_cases hq : q = 0
  · subst hq; rw [petSubConst_coeff_zero]; exact zero_mem _
  · rw [petSubConst_coeff _ hq]; exact hQ q k

/-- The constant term of a bounded polynomial is bounded. -/
theorem PetPolyBelow.coeff_mem {r n s : ℕ} {Q : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)}
    (hQ : PetPolyBelow s Q) (q : ℕ) (k : Fin n) : Q.coeff q k ∈ petVarAlg r s := hQ q k

/-- **The shift `t ↦ t + X_s` introduces only the variable `s`.** -/
theorem PetPolyBelow.taylor {r n s : ℕ} {Q : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)}
    (hQ : PetPolyBelow s Q) (iu : Fin r) (hiu : iu.val = s) :
    PetPolyBelow (s + 1) (Polynomial.taylor (fun _ => MvPolynomial.X iu :
      Fin n → MvPolynomial (Fin r) ℝ) Q) := by
  intro q k
  have hX : MvPolynomial.X iu ∈ petVarAlg r (s + 1) :=
    MvPolynomial.mem_supported.mpr (by
      rw [MvPolynomial.vars_X]; intro v hv
      simp only [Finset.coe_singleton, Set.mem_singleton_iff] at hv
      subst hv; simp [hiu])
  have hQ' := hQ.mono (Nat.le_succ s)
  rw [Polynomial.taylor_coeff, Polynomial.eval_eq_sum_range, Finset.sum_apply]
  refine Subalgebra.sum_mem _ fun j _ => ?_
  rw [Pi.mul_apply, Pi.pow_apply, Polynomial.hasseDeriv_coeff]
  refine mul_mem ?_ (pow_mem hX _)
  have : (((j + q).choose q : ℕ) * Q.coeff (j + q) : Fin n → MvPolynomial (Fin r) ℝ) k
      = ((j + q).choose q : ℕ) • Q.coeff (j + q) k := by
    simp [nsmul_eq_mul]
  rw [this]
  exact nsmul_mem (hQ' _ k) _

/-- **Freshness from the variable bound**: a witness of the invariant for a leading coefficient
using only the first `s` variables uses only those variables. -/
theorem vars_lt_of_lead {r n s : ℕ} {a : ℝ} (ha : a ≠ 0) {m : Fin n} {p : MvPolynomial (Fin r) ℤ}
    {v : Fin n → MvPolynomial (Fin r) ℝ} (hv : v m ∈ petVarAlg r s)
    (hp : v = Pi.single m (MvPolynomial.C a * p.map (Int.castRingHom ℝ))) :
    ∀ i ∈ p.vars, i.val < s := by
  intro i hi
  rw [hp, Pi.single_eq_same] at hv
  have hsub := MvPolynomial.mem_supported.mp hv
  rw [MvPolynomial.vars_C_mul a ha, MvPolynomial.vars_map_of_injective _
    (RingHom.injective_int (Int.castRingHom ℝ))] at hsub
  exact hsub hi

/-- **The invariant carried along the PET run** (blueprint `patch:lead-invariant` together with the
bookkeeping the update needs): the head's leading coefficient is `a p_S e_m` with `p_S` a nonzero
multilinear integer polynomial homogeneous of degree `D - deg Q_1`; every difference `Q_1 - Q_i`
satisfies `patch:lead-invariant`; all polynomials use only the first `s` shift variables; and the
head degree is at most `D`. -/
def PetRunInv {r n : ℕ} {ι : Type*} {f : ι} (a : ℝ) (m : Fin n) (D s : ℕ)
    (S : NormalPETState r n ι f) : Prop :=
  ProtectedLeadingInvariant a m D S.headPoly
    ∧ (∀ jt ∈ S.rest, ProtectedLeadingInvariant a m D (S.headPoly - jt.1))
    ∧ PetPolyBelow s S.headPoly ∧ (∀ jt ∈ S.rest, PetPolyBelow s jt.1)
    ∧ S.headPoly.natDegree ≤ D

/-- A nonzero polynomial vanishing at `0` has positive degree. -/
theorem one_le_natDegree_of_coeff_zero {R : Type*} [CommRing R] {P : Polynomial R}
    (hP : P ≠ 0) (h0 : P.coeff 0 = 0) : 1 ≤ P.natDegree := by
  by_contra h
  push Not at h
  have : P.natDegree = 0 := by omega
  exact hP (by rw [Polynomial.eq_C_of_natDegree_eq_zero this, h0, map_zero])

/-- The head data the update needs, from the invariant, with the fresh variable avoided. -/
theorem PetRunInv.headData {r n : ℕ} {ι : Type*} {f : ι} {a : ℝ} (ha : a ≠ 0) {m : Fin n}
    {D s : ℕ} {S : NormalPETState r n ι f} (h : PetRunInv a m D s S) {iu : Fin r}
    (hiu : iu.val = s) :
    ∃ pS : MvPolynomial (Fin r) ℤ, pS ≠ 0 ∧ pS.IsHomogeneous (D - S.headPoly.natDegree) ∧
      (∀ i, pS.degreeOf i ≤ 1) ∧ iu ∉ pS.vars ∧
      S.headPoly.leadingCoeff = Pi.single m (MvPolynomial.C a * pS.map (Int.castRingHom ℝ)) := by
  obtain ⟨pS, hne, hhom, hml, hlc⟩ := h.1
  refine ⟨pS, hne, hhom, hml, fun hmem => ?_, hlc⟩
  have hv := vars_lt_of_lead ha ((h.2.2.1) _ m) hlc iu hmem
  omega

/-- The difference data the update needs: for a difference of degree below the head's, the
coefficient at `deg Q_1 - 1` carries the invariant's form with the fresh variable avoided. -/
theorem PetRunInv.diffData {r n : ℕ} {ι : Type*} {f : ι} {a : ℝ} (ha : a ≠ 0) {m : Fin n}
    {D s : ℕ} {S : NormalPETState r n ι f} (h : PetRunInv a m D s S) {iu : Fin r}
    (hiu : iu.val = s) {e : ℕ} (he : S.headPoly.natDegree = e + 1) :
    ∀ jt ∈ S.rest, (S.headPoly - jt.1).natDegree ≠ e + 1 →
      PetLeadData a m iu (D - (e + 1) + 1) ((S.headPoly - jt.1).coeff e) := by
  intro jt hjt hne
  have hle : (S.headPoly - jt.1).natDegree ≤ e + 1 := by
    refine le_trans (Polynomial.natDegree_sub_le _ _) (max_le (le_of_eq he) ?_)
    rw [← he]; exact S.head_max jt hjt
  rcases lt_or_eq_of_le (Nat.lt_succ_iff.mp (lt_of_le_of_ne hle hne)) with hlt | heq
  · rw [Polynomial.coeff_eq_zero_of_natDegree_lt hlt]
    exact petLeadData_zero a m iu _
  · obtain ⟨p, hp0, hhom, hml, hlc⟩ := h.2.1 jt hjt
    have hbelow : PetPolyBelow s (S.headPoly - jt.1) := h.2.2.1.sub (h.2.2.2.1 jt hjt)
    have hcoeff : (S.headPoly - jt.1).coeff e = (S.headPoly - jt.1).leadingCoeff := by
      rw [Polynomial.leadingCoeff, heq]
    refine ⟨p, ?_, hml, fun hmem => ?_, hcoeff.trans hlc⟩
    · rw [heq] at hhom
      convert hhom using 1
      have : e + 1 ≤ D := he ▸ h.2.2.2.2
      omega
    · have hv := vars_lt_of_lead ha (hbelow (S.headPoly - jt.1).natDegree m)
        (by rw [← Polynomial.leadingCoeff]; exact hlc) iu hmem
      omega

/-- **The pivot rule of blueprint `patch:pet-producer`**, as an existence statement: a pivot of
minimum degree `l`, with (A) `l < d` and the pivot among the other items, or (B) `l = d` and the
pivot another item whose leading coefficient differs from the head's, or (C) the head itself, all
items then sharing its degree and leading coefficient. -/
theorem exists_petPivot {r n : ℕ} {ι : Type*} {f : ι} (S : NormalPETState r n ι f) :
    ∃ Qp ∈ (petAllItems S).map Prod.fst,
      (∀ P ∈ (petAllItems S).map Prod.fst, Qp.natDegree ≤ P.natDegree) ∧
      ((Qp ∈ S.rest.map Prod.fst ∧ Qp.natDegree < S.headPoly.natDegree)
        ∨ (Qp ∈ S.rest.map Prod.fst ∧ Qp.natDegree = S.headPoly.natDegree
            ∧ Qp.leadingCoeff ≠ S.headPoly.leadingCoeff)
        ∨ (Qp = S.headPoly ∧ ∀ P ∈ (petAllItems S).map Prod.fst,
            P.natDegree = S.headPoly.natDegree ∧ P.leadingCoeff = S.headPoly.leadingCoeff)) := by
  classical
  set L := (petAllItems S).map Prod.fst with hL
  have hne : L ≠ [] := by simp [hL, petAllItems]
  obtain ⟨Q0, hQ0, hmin⟩ : ∃ Q0 ∈ L, ∀ P ∈ L, Q0.natDegree ≤ P.natDegree := by
    obtain ⟨Q0, hQ0, h⟩ := L.toFinset.exists_min_image (fun P => P.natDegree)
      (List.toFinset_nonempty_iff L |>.mpr hne)
    exact ⟨Q0, List.mem_toFinset.mp hQ0, fun P hP => h P (List.mem_toFinset.mpr hP)⟩
  have hmaxd : ∀ P ∈ L, P.natDegree ≤ S.headPoly.natDegree := by
    intro P hP
    simp only [hL, petAllItems, List.map_cons, List.mem_cons, List.mem_map] at hP
    rcases hP with hP | ⟨jt, hjt, rfl⟩
    · rw [hP]
    · exact S.head_max jt hjt
  have hhead : S.headPoly ∈ L := by simp [hL, petAllItems]
  have hrest : ∀ P ∈ L, P ≠ S.headPoly → P ∈ S.rest.map Prod.fst := by
    intro P hP hPh
    simp only [hL, petAllItems, List.map_cons, List.mem_cons] at hP
    rcases hP with hP | hP
    · exact absurd hP hPh
    · exact hP
  by_cases hlt : Q0.natDegree < S.headPoly.natDegree
  · refine ⟨Q0, hQ0, hmin, Or.inl ⟨hrest Q0 hQ0 fun h => by rw [h] at hlt; exact lt_irrefl _ hlt,
      hlt⟩⟩
  · have hall : ∀ P ∈ L, P.natDegree = S.headPoly.natDegree := fun P hP =>
      le_antisymm (hmaxd P hP) (le_trans (not_lt.mp hlt) (hmin P hP))
    by_cases hB : ∃ P ∈ L, P.leadingCoeff ≠ S.headPoly.leadingCoeff
    · obtain ⟨P, hP, hPlc⟩ := hB
      refine ⟨P, hP, fun P' hP' => by rw [hall P hP, hall P' hP'], Or.inr (Or.inl ⟨?_, hall P hP,
        hPlc⟩)⟩
      exact hrest P hP fun h => hPlc (by rw [h])
    · push Not at hB
      refine ⟨S.headPoly, hhead, fun P hP => by rw [hall P hP], Or.inr (Or.inr ⟨rfl,
        fun P hP => ⟨hall P hP, hB P hP⟩⟩)⟩

open Polynomial in
/-- In cases (A) and (B) of the pivot rule the shifted head keeps degree `d`. -/
theorem natDegree_petNewHead_AB {r n : ℕ} {ι : Type*} {f : ι}
    (u : Fin n → MvPolynomial (Fin r) ℝ) (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    (S : NormalPETState r n ι f) (hd : 1 ≤ S.headPoly.natDegree)
    (hQp : Qp.natDegree < S.headPoly.natDegree
      ∨ (Qp.natDegree = S.headPoly.natDegree ∧ Qp.leadingCoeff ≠ S.headPoly.leadingCoeff)) :
    (petNewHead u Qp S).1.natDegree = S.headPoly.natDegree := by
  set d := S.headPoly.natDegree
  have hcoeff : ((taylor u) S.headPoly - Qp).coeff d ≠ 0 := by
    rw [coeff_sub]
    have ht : ((taylor u) S.headPoly).coeff d = S.headPoly.leadingCoeff := by
      rw [← leadingCoeff_taylor S.headPoly u, leadingCoeff, natDegree_taylor]
    rw [ht]
    rcases hQp with hlt | ⟨heq, hlc⟩
    · rw [coeff_eq_zero_of_natDegree_lt hlt, sub_zero]
      exact leadingCoeff_ne_zero.mpr S.headPoly_ne_zero
    · rw [← heq, ← leadingCoeff]
      exact sub_ne_zero.mpr (Ne.symm hlc)
  have hle : ((taylor u) S.headPoly - Qp).natDegree ≤ d := by
    refine le_trans (natDegree_sub_le _ _) (max_le (by rw [natDegree_taylor]) ?_)
    rcases hQp with hlt | ⟨heq, -⟩
    · exact hlt.le
    · exact heq.le
  have hdeg : ((taylor u) S.headPoly - Qp).natDegree = d :=
    le_antisymm hle (le_natDegree_of_ne_zero hcoeff)
  change (petSubConst ((taylor u) S.headPoly - Qp)).natDegree = d
  rw [natDegree_petSubConst (by rw [hdeg]; exact hd), hdeg]

open Polynomial in
/-- In case (C) the shifted head drops to degree `d - 1`, because its leading coefficient
`d X_u lc(Q_1)` is nonzero. -/
theorem natDegree_petNewHead_C {r n : ℕ} {ι : Type*} {f : ι} {a : ℝ} (ha : a ≠ 0) {m : Fin n}
    (iu : Fin r) (S : NormalPETState r n ι f) {e : ℕ} (he : 1 ≤ e)
    (hQ1 : S.headPoly.natDegree = e + 1) {pS : MvPolynomial (Fin r) ℤ} (hpS : pS ≠ 0)
    (hlc : S.headPoly.leadingCoeff = Pi.single m (MvPolynomial.C a * pS.map (Int.castRingHom ℝ))) :
    (petNewHead (fun _ => MvPolynomial.X iu : Fin n → MvPolynomial (Fin r) ℝ)
      S.headPoly S).1.natDegree = e := by
  set u : Fin n → MvPolynomial (Fin r) ℝ := fun _ => MvPolynomial.X iu
  have hcoeff : ((taylor u) S.headPoly - S.headPoly).coeff e ≠ 0 := by
    rw [coeff_taylor_sub_self _ _ hQ1, hlc]
    intro h0
    have hm := congrFun h0 m
    simp only [Pi.mul_apply, Pi.add_apply, Pi.one_apply, Pi.single_eq_same, Pi.zero_apply,
      u] at hm
    have hpm : pS.map (Int.castRingHom ℝ) ≠ 0 := by
      intro h
      exact hpS ((MvPolynomial.map_injective _ (RingHom.injective_int _)) (by rw [h, map_zero]))
    have h1 : ((e : Fin n → MvPolynomial (Fin r) ℝ) m + 1) = ((e : ℝ) + 1 : ℝ) • 1 := by
      simp [Algebra.smul_def]
    have hX : (MvPolynomial.X iu : MvPolynomial (Fin r) ℝ) ≠ 0 := MvPolynomial.X_ne_zero iu
    have hC : (MvPolynomial.C a : MvPolynomial (Fin r) ℝ) ≠ 0 := by
      simpa using ha
    have hE : ((e : Fin n → MvPolynomial (Fin r) ℝ) m + 1) ≠ 0 := by
      rw [h1]
      exact smul_ne_zero (by positivity) one_ne_zero
    exact mul_ne_zero (mul_ne_zero hE hX) (mul_ne_zero hC hpm) hm
  have hdeg : ((taylor u) S.headPoly - S.headPoly).natDegree = e :=
    le_antisymm (natDegree_taylor_sub_self_le _ _ hQ1) (le_natDegree_of_ne_zero hcoeff)
  change (petSubConst ((taylor u) S.headPoly - S.headPoly)).natDegree = e
  rw [natDegree_petSubConst (by rw [hdeg]; exact he), hdeg]

open Polynomial in
/-- Every remaining child has degree at most the head's, when the pivot does. -/
theorem petNonConstChildren_natDegree_le {r n : ℕ} {ι : Type*} {f : ι}
    (u : Fin n → MvPolynomial (Fin r) ℝ) (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    (S : NormalPETState r n ι f) (hQp : Qp.natDegree ≤ S.headPoly.natDegree) :
    ∀ it ∈ petNonConstChildren u Qp S, it.1.natDegree ≤ S.headPoly.natDegree := by
  intro it hit
  rcases mem_petNonConstChildren u Qp S hit with h | ⟨jt, hjt, h | h⟩ <;> subst h <;>
    refine le_trans (natDegree_petSubConst_le _) (le_trans (natDegree_sub_le _ _) (max_le ?_ hQp))
  · exact le_rfl
  · rw [natDegree_taylor]; exact S.head_max jt hjt
  · exact S.head_max jt hjt

open Polynomial in
/-- In case (C) every remaining child has degree below the head's. -/
theorem petNonConstChildren_natDegree_le_C {r n : ℕ} {ι : Type*} {f : ι}
    (u : Fin n → MvPolynomial (Fin r) ℝ) (S : NormalPETState r n ι f) {e : ℕ}
    (hQ1 : S.headPoly.natDegree = e + 1)
    (hall : ∀ P ∈ (petAllItems S).map Prod.fst,
      P.natDegree = S.headPoly.natDegree ∧ P.leadingCoeff = S.headPoly.leadingCoeff) :
    ∀ it ∈ petNonConstChildren u S.headPoly S, it.1.natDegree ≤ e := by
  intro it hit
  have hjt : ∀ jt ∈ S.rest, jt.1.natDegree = e + 1 ∧ jt.1.leadingCoeff = S.headPoly.leadingCoeff :=
    fun jt hjt => by
      have := hall jt.1 (List.mem_map.mpr ⟨jt, List.mem_cons_of_mem _ hjt, rfl⟩)
      rw [hQ1] at this; exact this
  rcases mem_petNonConstChildren u S.headPoly S hit with h | ⟨jt, hjt', h | h⟩ <;> subst h <;>
    refine le_trans (natDegree_petSubConst_le _) ?_
  · simp
  · have := natDegree_sub_lt_of_leadingCoeff_eq ((taylor u) jt.1) S.headPoly (l := e + 1)
      (by omega) (by rw [natDegree_taylor]; exact (hjt jt hjt').1) hQ1
      (by rw [leadingCoeff_taylor, (hjt jt hjt').2, sub_self])
    exact Nat.lt_succ_iff.mp this
  · have := natDegree_sub_lt_of_leadingCoeff_eq jt.1 S.headPoly (l := e + 1)
      (by omega) (hjt jt hjt').1 hQ1 (by rw [(hjt jt hjt').2, sub_self])
    exact Nat.lt_succ_iff.mp this

open Polynomial in
theorem petSubConst_sub {R : Type*} [CommRing R] (P Q : Polynomial R) :
    petSubConst P - petSubConst Q = petSubConst (P - Q) := by
  simp only [petSubConst, coeff_sub, map_sub]; ring

open Polynomial in
/-- `patch:lead-invariant` is preserved by a shift in `t` followed by removing the constant term:
the shifted children differ from the new head by the shifted old difference. -/
theorem ProtectedLeadingInvariant.taylor_subConst {r n : ℕ} {a : ℝ} {m : Fin n} {D : ℕ}
    {R : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)} (hR : 1 ≤ R.natDegree)
    (h : ProtectedLeadingInvariant a m D R) (u : Fin n → MvPolynomial (Fin r) ℝ) :
    ProtectedLeadingInvariant a m D (petSubConst ((taylor u) R)) := by
  refine ProtectedLeadingInvariant.subConst (by rw [natDegree_taylor]; exact hR) ?_
  obtain ⟨p, hp0, hhom, hml, hlc⟩ := h
  exact ⟨p, hp0, by rw [natDegree_taylor]; exact hhom, hml, by rw [leadingCoeff_taylor]; exact hlc⟩

/-- **The new head satisfies `patch:lead-invariant`.** For a pivot among the other items the
shifted head has the head's degree and its leading coefficient is that of `Q_1 - Q_p`; for the
head itself as pivot (case C) it is the finite difference, with leading coefficient
`d X_u lc(Q_1)`. -/
theorem petNewHead_invariant {r n : ℕ} {ι : Type*} {f : ι} {a : ℝ} (ha : a ≠ 0) {m : Fin n}
    {D s : ℕ} {S : NormalPETState r n ι f} (hinv : PetRunInv a m D s S) {iu : Fin r}
    (hiu : iu.val = s) {e : ℕ} (he : e ≠ 0) (hQ1 : S.headPoly.natDegree = e + 1)
    (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    (hcase : Qp = S.headPoly ∨ (∃ jt ∈ S.rest, jt.1 = Qp)
      ∧ (S.headPoly - Qp).natDegree = e + 1) :
    ProtectedLeadingInvariant a m D
      (petNewHead (fun _ => MvPolynomial.X iu : Fin n → MvPolynomial (Fin r) ℝ) Qp S).1 := by
  obtain ⟨pS, hSne, hShom, hSml, hfS, hSlc⟩ := hinv.headData ha hiu
  have hD : e + 1 ≤ D := hQ1 ▸ hinv.2.2.2.2
  have hDk : D = (D - (e + 1)) + e + 1 := by omega
  rw [hQ1] at hShom
  change ProtectedLeadingInvariant a m D (petSubConst ((Polynomial.taylor
    (fun _ => MvPolynomial.X iu : Fin n → MvPolynomial (Fin r) ℝ)) S.headPoly - Qp))
  rcases hcase with rfl | ⟨⟨jt, hjt, hjtQ⟩, hdeg⟩
  · have h := petUpdate_invariant_head (k := D - (e + 1)) (Qpiv := S.headPoly) (pR := 0) ha he hQ1
      (by simp) (by simp) hSlc (MvPolynomial.isHomogeneous_zero _ _ _) (by simp) (by simp)
      hSne hShom hSml hfS
    rwa [← hDk] at h
  · obtain ⟨pR, hRne, hRhom, hRml, hRlc⟩ := hinv.2.1 jt hjt
    rw [hjtQ, hdeg] at hRhom
    rw [hjtQ] at hRlc
    have h := petUpdate_invariant_diff_highDeg (k := D - (e + 1)) (iu := iu) (Qi := Qp) (Qp := Qp)
      ha hQ1 hdeg hRlc hRne hRhom hRml
    rw [sub_self, petSubConst_zero, sub_zero, ← hDk] at h
    exact h

/-- **Every new difference satisfies `patch:lead-invariant`.** -/
theorem petNewRest_invariant {r n : ℕ} {ι : Type*} {f : ι} {a : ℝ} (ha : a ≠ 0) {m : Fin n}
    {D s : ℕ} {S : NormalPETState r n ι f} (hinv : PetRunInv a m D s S) {iu : Fin r}
    (hiu : iu.val = s) {e : ℕ} (he : e ≠ 0) (hQ1 : S.headPoly.natDegree = e + 1)
    (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)) :
    ∀ it ∈ petNonConstChildren (fun _ => MvPolynomial.X iu : Fin n → MvPolynomial (Fin r) ℝ)
        Qp S,
      ProtectedLeadingInvariant a m D
        ((petNewHead (fun _ => MvPolynomial.X iu : Fin n → MvPolynomial (Fin r) ℝ) Qp S).1
          - it.1) := by
  obtain ⟨pS, hSne, hShom, hSml, hfS, hSlc⟩ := hinv.headData ha hiu
  have hD : e + 1 ≤ D := hQ1 ▸ hinv.2.2.2.2
  have hDk : D = (D - (e + 1)) + e + 1 := by omega
  rw [hQ1] at hShom
  intro it hit
  rcases mem_petNonConstChildren _ Qp S hit with h | ⟨jt, hjt, h | h⟩ <;> subst h
  · -- the unshifted child of the head
    have h := petUpdate_invariant_diff (k := D - (e + 1)) (Qi := S.headPoly) (Qp := Qp)
      (pR := 0) ha he hQ1 (by simp) (by simp) hSlc (MvPolynomial.isHomogeneous_zero _ _ _)
      (by simp) (by simp) hSne hShom hSml hfS
    rw [← hDk] at h
    exact h
  · -- a shifted child
    change ProtectedLeadingInvariant a m D (petSubConst ((Polynomial.taylor _) S.headPoly - Qp)
      - petSubConst ((Polynomial.taylor _) jt.1 - Qp))
    rw [petSubConst_sub, show (Polynomial.taylor (fun _ => MvPolynomial.X iu :
        Fin n → MvPolynomial (Fin r) ℝ)) S.headPoly - Qp
        - ((Polynomial.taylor (fun _ => MvPolynomial.X iu :
        Fin n → MvPolynomial (Fin r) ℝ)) jt.1 - Qp)
        = (Polynomial.taylor (fun _ => MvPolynomial.X iu :
        Fin n → MvPolynomial (Fin r) ℝ)) (S.headPoly - jt.1) by rw [map_sub]; ring]
    have hne : S.headPoly - jt.1 ≠ 0 := sub_ne_zero.mpr (Ne.symm (S.rest_ne_head jt hjt))
    have h0 : (S.headPoly - jt.1).coeff 0 = 0 := by
      rw [Polynomial.coeff_sub, S.headPoly_vanish, S.rest_vanish jt hjt, sub_zero]
    exact (hinv.2.1 jt hjt).taylor_subConst (one_le_natDegree_of_coeff_zero hne h0) _
  · -- an unshifted child
    change ProtectedLeadingInvariant a m D (petSubConst ((Polynomial.taylor _) S.headPoly - Qp)
      - petSubConst (jt.1 - Qp))
    by_cases hdeg : (S.headPoly - jt.1).natDegree = e + 1
    · obtain ⟨pR, hRne, hRhom, hRml, hRlc⟩ := hinv.2.1 jt hjt
      rw [hdeg] at hRhom
      have h := petUpdate_invariant_diff_highDeg (k := D - (e + 1)) (iu := iu) (Qp := Qp)
        ha hQ1 hdeg hRlc hRne hRhom hRml
      rwa [← hDk] at h
    · obtain ⟨pR, hRhom, hRml, hfR, hReq⟩ := hinv.diffData ha hiu hQ1 jt hjt hdeg
      have hle : (S.headPoly - jt.1).natDegree ≤ e := by
        have h1 : (S.headPoly - jt.1).natDegree ≤ e + 1 := by
          refine le_trans (Polynomial.natDegree_sub_le _ _) (max_le (le_of_eq hQ1) ?_)
          rw [← hQ1]; exact S.head_max jt hjt
        omega
      have hk : D - (e + 1) + 1 = D - (e + 1) + 1 := rfl
      have h := petUpdate_invariant_diff (k := D - (e + 1)) (Qp := Qp) ha he hQ1 hle hReq hSlc
        hRhom hRml hfR hSne hShom hSml hfS
      rwa [← hDk] at h

open scoped Classical in
/-- The class count at a degree realized in the state is positive. -/
theorem petStateClasses_pos {r n : ℕ} {ι : Type*} {f : ι} (S : NormalPETState r n ι f)
    {Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)} (hQp : Qp ∈ (petAllItems S).map Prod.fst) :
    1 ≤ petStateClasses Qp.natDegree S := by
  rw [petStateClasses]
  refine List.length_pos_of_mem (a := Qp.leadingCoeff) ?_
  rw [List.mem_dedup, List.mem_map]
  exact ⟨Qp, List.mem_filter.mpr ⟨hQp, by simp⟩, rfl⟩

/-- Every polynomial of a state has degree between `1` and the head's. -/
theorem natDegree_mem_petAllItems {r n : ℕ} {ι : Type*} {f : ι} (S : NormalPETState r n ι f)
    {P : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)} (hP : P ∈ (petAllItems S).map Prod.fst) :
    1 ≤ P.natDegree ∧ P.natDegree ≤ S.headPoly.natDegree := by
  simp only [petAllItems, List.map_cons, List.mem_cons, List.mem_map] at hP
  rcases hP with rfl | ⟨jt, hjt, rfl⟩
  · exact ⟨one_le_natDegree_of_coeff_zero S.headPoly_ne_zero S.headPoly_vanish, le_rfl⟩
  · exact ⟨one_le_natDegree_of_coeff_zero (S.rest_ne_zero jt hjt) (S.rest_vanish jt hjt),
      S.head_max jt hjt⟩

open scoped Classical in
/-- **One step of the PET run** (blueprint `patch:pet-update` with the pivot rule of
`patch:pet-producer`): from a state satisfying the run invariant at step `s` with head degree
`d ≥ 2`, the update with the fresh variable `s` gives a state satisfying the invariant at
`s + 1`, whose type makes an admissible move of the pivot recursion, and whose length at most
doubles. -/
theorem petRunStep {r n : ℕ} {ι : Type*} {f : ι} {a : ℝ} (ha : a ≠ 0) {m : Fin n}
    {D s : ℕ} (hD3 : D ≤ 3) {S : NormalPETState r n ι f} (hinv : PetRunInv a m D s S)
    {iu : Fin r} (hiu : iu.val = s) (hd : 2 ≤ S.headPoly.natDegree) :
    ∃ Qp ∈ (petAllItems S).map Prod.fst, ∃ S' : NormalPETState r n ι f,
      S'.spatial = petNewSpatial (fun _ => MvPolynomial.X iu) Qp S
      ∧ S'.headPoly = (petNewHead (fun _ => MvPolynomial.X iu) Qp S).1
      ∧ S'.headFactor = petNewHeadFactor (fun _ => MvPolynomial.X iu) Qp S
      ∧ S'.rest = petGroup (petNonConstChildren (fun _ => MvPolynomial.X iu) Qp S)
      ∧ PetRunInv a m D (s + 1) S'
      ∧ petTypeStep (petAllItems S).length (petStateType S) (petStateType S')
      ∧ (petAllItems S').length ≤ 2 * (petAllItems S).length
      ∧ (Qp = S.headPoly ∨ (∃ jt ∈ S.rest, jt.1 = Qp)
          ∧ (S.headPoly - Qp).natDegree = S.headPoly.natDegree) := by
  set U : Fin n → MvPolynomial (Fin r) ℝ := fun _ => MvPolynomial.X iu with hU
  obtain ⟨e, he1⟩ : ∃ e, S.headPoly.natDegree = e + 1 := ⟨S.headPoly.natDegree - 1, by omega⟩
  have he : e ≠ 0 := by omega
  obtain ⟨Qp, hQpmem, hmin, hcase⟩ := exists_petPivot S
  refine ⟨Qp, hQpmem, ?_⟩
  obtain ⟨pS, hSne, hShom, hSml, hfS, hSlc⟩ := hinv.headData ha hiu
  have hQpdeg := natDegree_mem_petAllItems S hQpmem
  have hheadData : ∃ pS : MvPolynomial (Fin r) ℤ, pS ≠ 0 ∧ pS.IsHomogeneous (D - (e + 1)) ∧
      (∀ i, pS.degreeOf i ≤ 1) ∧ iu ∉ pS.vars ∧
      S.headPoly.leadingCoeff = Pi.single m (MvPolynomial.C a * pS.map (Int.castRingHom ℝ)) :=
    ⟨pS, hSne, he1 ▸ hShom, hSml, hfS, hSlc⟩
  have hdiffData := hinv.diffData ha hiu he1
  have hQpin : Qp ≠ S.headPoly → ∃ jt ∈ S.rest, jt.1 = Qp := by
    intro hQh
    have : Qp ∈ S.rest.map Prod.fst := by
      simp only [petAllItems, List.map_cons, List.mem_cons] at hQpmem
      exact hQpmem.resolve_left hQh
    exact List.mem_map.mp this
  have hpivotData : (S.headPoly - Qp).natDegree ≠ e + 1 →
      PetLeadData a m iu (D - (e + 1) + 1) ((S.headPoly - Qp).coeff e) := by
    intro hne
    by_cases hQh : Qp = S.headPoly
    · rw [hQh, sub_self, Polynomial.coeff_zero]; exact petLeadData_zero a m iu _
    · obtain ⟨jt, hjt, rfl⟩ := hQpin hQh
      exact hdiffData jt hjt hne
  have hd0 := petNewHead_ne_zero ha he Qp S he1 hheadData hpivotData
  have hlh := petNewHead_ne_all ha he Qp S he1 hheadData hdiffData
  have hAB_or_C : (Qp.natDegree < S.headPoly.natDegree
      ∨ (Qp.natDegree = S.headPoly.natDegree ∧ Qp.leadingCoeff ≠ S.headPoly.leadingCoeff))
      ∨ (Qp = S.headPoly ∧ ∀ P ∈ (petAllItems S).map Prod.fst,
            P.natDegree = S.headPoly.natDegree ∧ P.leadingCoeff = S.headPoly.leadingCoeff) := by
    rcases hcase with ⟨-, h⟩ | ⟨-, h1, h2⟩ | h
    · exact Or.inl (Or.inl h)
    · exact Or.inl (Or.inr ⟨h1, h2⟩)
    · exact Or.inr h
  have hlm : ∀ it ∈ petNonConstChildren U Qp S,
      it.1.natDegree ≤ (petNewHead U Qp S).1.natDegree := by
    rcases hAB_or_C with hAB | ⟨rfl, hall⟩
    · rw [natDegree_petNewHead_AB U Qp S (by omega) hAB]
      exact petNonConstChildren_natDegree_le U Qp S hQpdeg.2
    · rw [natDegree_petNewHead_C ha iu S (by omega) he1 hSne hSlc]
      exact petNonConstChildren_natDegree_le_C U S he1 hall
  have hcaseOut : Qp = S.headPoly ∨ (∃ jt ∈ S.rest, jt.1 = Qp)
      ∧ (S.headPoly - Qp).natDegree = e + 1 := by
    rcases hAB_or_C with hAB | ⟨h, -⟩
    · right
      have hQh : Qp ≠ S.headPoly := by
        intro h
        rw [h] at hAB
        rcases hAB with h1 | ⟨-, h2⟩
        · exact lt_irrefl _ h1
        · exact h2 rfl
      refine ⟨hQpin hQh, ?_⟩
      rcases hAB with hlt | ⟨heq, hlc⟩
      · rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt hlt, he1]
      · have hc : (S.headPoly - Qp).coeff (e + 1) ≠ 0 := by
          rw [Polynomial.coeff_sub, ← he1, ← Polynomial.leadingCoeff, ← heq,
            ← Polynomial.leadingCoeff]
          exact sub_ne_zero.mpr (Ne.symm hlc)
        refine le_antisymm ?_ (Polynomial.le_natDegree_of_ne_zero hc)
        refine le_trans (Polynomial.natDegree_sub_le _ _) (max_le (le_of_eq he1) ?_)
        rw [heq, he1]
    · exact Or.inl h
  let S' := petAssemble (f := f) (petNewSpatial U Qp S) (petNewHead U Qp S).1
    (petNewHeadFactor U Qp S) (petNonConstChildren U Qp S) (petNewHeadFactor_origin U Qp S) hd0
    (petNewHead_coeff_zero U Qp S) (petNonConstChildren_ne_zero U Qp S)
    (petNonConstChildren_coeff_zero U Qp S) hlh hlm
  refine ⟨S', rfl, rfl, rfl, rfl, ?_, ?_, ?_, by rw [he1]; exact hcaseOut⟩
  · have hQpbelow : PetPolyBelow s Qp := by
      by_cases hQh : Qp = S.headPoly
      · rw [hQh]; exact hinv.2.2.1
      · obtain ⟨jt, hjt, rfl⟩ := hQpin hQh; exact hinv.2.2.2.1 jt hjt
    have hheadBelow : PetPolyBelow (s + 1) (petNewHead U Qp S).1 :=
      ((hinv.2.2.1.taylor iu hiu).sub (hQpbelow.mono (Nat.le_succ s))).petSubConst
    refine ⟨?_, ?_, hheadBelow, ?_, ?_⟩
    · exact petNewHead_invariant ha hinv hiu he he1 Qp hcaseOut
    · exact petGroup_property
        (fun P => ProtectedLeadingInvariant a m D ((petNewHead U Qp S).1 - P))
        (petNewRest_invariant ha hinv hiu he he1 Qp)
    · refine petGroup_property (fun P => PetPolyBelow (s + 1) P) ?_
      intro it hit
      rcases mem_petNonConstChildren U Qp S hit with h | ⟨jt, hjt, h | h⟩ <;> subst h
      · exact ((hinv.2.2.1.mono (Nat.le_succ s)).sub
          (hQpbelow.mono (Nat.le_succ s))).petSubConst
      · exact (((hinv.2.2.2.1 jt hjt).taylor iu hiu).sub
          (hQpbelow.mono (Nat.le_succ s))).petSubConst
      · exact (((hinv.2.2.2.1 jt hjt).mono (Nat.le_succ s)).sub
          (hQpbelow.mono (Nat.le_succ s))).petSubConst
    · change (petNewHead U Qp S).1.natDegree ≤ D
      rcases hAB_or_C with hAB | ⟨rfl, -⟩
      · rw [natDegree_petNewHead_AB U Qp S (by omega) hAB]; exact hinv.2.2.2.2
      · rw [natDegree_petNewHead_C ha iu S (by omega) he1 hSne hSlc]
        have := hinv.2.2.2.2; omega
  · have hl1 : 1 ≤ Qp.natDegree := hQpdeg.1
    have hl3 : Qp.natDegree ≤ 3 := le_trans hQpdeg.2 (le_trans hinv.2.2.2.2 hD3)
    have hdrop := petStateClasses_update_at_pivot U Qp S hl1 rfl hQpmem hmin
      (petNewSpatial U Qp S) (petNewHeadFactor U Qp S) (petNewHeadFactor_origin U Qp S) hd0
      (petNewHead_coeff_zero U Qp S) (petNonConstChildren_ne_zero U Qp S)
      (petNonConstChildren_coeff_zero U Qp S) hlh hlm
    have hhigh : ∀ q, Qp.natDegree < q → petStateClasses q S' = petStateClasses q S :=
      fun q hq => petStateClasses_update_high U Qp S rfl hmin hq
        (petNewSpatial U Qp S) (petNewHeadFactor U Qp S) (petNewHeadFactor_origin U Qp S) hd0
        (petNewHead_coeff_zero U Qp S) (petNonConstChildren_ne_zero U Qp S)
        (petNonConstChildren_coeff_zero U Qp S) hlh hlm
    have hle : ∀ q, petStateClasses q S' ≤ 2 * (petAllItems S).length := fun q =>
      petStateClasses_update_le q U Qp S (petNewSpatial U Qp S) (petNewHead U Qp S).1
        (petNewHeadFactor U Qp S) (petNewHeadFactor_origin U Qp S) hd0
        (petNewHead_coeff_zero U Qp S) (petNonConstChildren_ne_zero U Qp S)
        (petNonConstChildren_coeff_zero U Qp S) hlh hlm
    have hpos := petStateClasses_pos S hQpmem
    have hdrop' : petStateClasses Qp.natDegree S' < petStateClasses Qp.natDegree S := by
      have h' : petStateClasses Qp.natDegree S' = petStateClasses Qp.natDegree S - 1 := hdrop
      omega
    unfold petTypeStep petStateType
    obtain h1 | h2 | h3 : Qp.natDegree = 1 ∨ Qp.natDegree = 2 ∨ Qp.natDegree = 3 := by omega
    · rw [h1] at hdrop'
      exact Or.inr (Or.inr ⟨hhigh 3 (by omega), hhigh 2 (by omega), hdrop'⟩)
    · rw [h2] at hdrop'
      exact Or.inr (Or.inl ⟨hhigh 3 (by omega), hdrop', hle 1⟩)
    · rw [h3] at hdrop'
      exact Or.inl ⟨hdrop', hle 2, hle 1⟩
  · exact length_petAllItems_update_le U Qp S (petNewSpatial U Qp S) (petNewHead U Qp S).1
      (petNewHeadFactor U Qp S) (petNewHeadFactor_origin U Qp S) hd0
      (petNewHead_coeff_zero U Qp S) (petNonConstChildren_ne_zero U Qp S)
      (petNonConstChildren_coeff_zero U Qp S) hlh hlm

end

section
open Filter Topology MeasureTheory

/-- A uniform bound for an integer polynomial on the unit cube. -/
def EvalBd {r : ℕ} (B : ℝ) (p : MvPolynomial (Fin r) ℤ) : Prop :=
  ∀ u : Fin r → ℝ, (∀ i, |u i| ≤ 1) → |MvPolynomial.aeval u p| ≤ B

theorem evalBd_zero {r : ℕ} {B : ℝ} (hB : 0 ≤ B) : EvalBd B (0 : MvPolynomial (Fin r) ℤ) :=
  fun u _ => by simpa using hB

theorem evalBd_one {r : ℕ} : EvalBd 1 (1 : MvPolynomial (Fin r) ℤ) :=
  fun u _ => by simp

theorem EvalBd.mono {r : ℕ} {B B' : ℝ} (h : B ≤ B') {p : MvPolynomial (Fin r) ℤ}
    (hp : EvalBd B p) : EvalBd B' p := fun u hu => (hp u hu).trans h

/-- The witness of the update, `p_R + (e+1) X_u p_S`, is bounded by `(e + 2) B`. -/
theorem EvalBd.fresh {r : ℕ} {B : ℝ} {pR pS : MvPolynomial (Fin r) ℤ} (hR : EvalBd B pR)
    (hS : EvalBd B pS) (e : ℕ) (iu : Fin r) :
    EvalBd ((e + 2) * B)
      (pR + MvPolynomial.C ((e + 1 : ℕ) : ℤ) * MvPolynomial.X iu * pS) := by
  intro u hu
  rw [map_add, map_mul, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X]
  simp only [algebraMap_int_eq, eq_intCast, Int.cast_natCast]
  calc |MvPolynomial.aeval u pR + ((e + 1 : ℕ) : ℝ) * u iu * MvPolynomial.aeval u pS|
      ≤ |MvPolynomial.aeval u pR| + ((e + 1 : ℕ) : ℝ) * |u iu| * |MvPolynomial.aeval u pS| := by
        refine (abs_add_le _ _).trans ?_
        rw [abs_mul, abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ ((e + 1 : ℕ) : ℝ))]
    _ ≤ B + ((e + 1 : ℕ) : ℝ) * 1 * B := by
        gcongr
        · exact hR u hu
        · exact hu iu
        · exact hS u hu
    _ = ((e : ℝ) + 2) * B := by push_cast; ring

/-- **The invariant's witness is determined by the leading coefficient.** -/
theorem lead_witness_unique {r n : ℕ} {a : ℝ} (ha : a ≠ 0) {m : Fin n}
    {p q : MvPolynomial (Fin r) ℤ}
    (h : Pi.single m (MvPolynomial.C a * p.map (Int.castRingHom ℝ))
      = (Pi.single m (MvPolynomial.C a * q.map (Int.castRingHom ℝ)) :
          Fin n → MvPolynomial (Fin r) ℝ)) : p = q := by
  have hm := congrFun h m
  simp only [Pi.single_eq_same] at hm
  have hC : (MvPolynomial.C a : MvPolynomial (Fin r) ℝ) ≠ 0 := by simpa using ha
  have := mul_left_cancel₀ hC hm
  exact MvPolynomial.map_injective _ (RingHom.injective_int _) this

/-- `patch:lead-invariant` with a uniform bound for the witness on the unit cube. -/
def ProtectedLeadingInvariantB {r n : ℕ} (a : ℝ) (m : Fin n) (D : ℕ) (B : ℝ)
    (R : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)) : Prop :=
  ∃ p : MvPolynomial (Fin r) ℤ, p ≠ 0 ∧ p.IsHomogeneous (D - R.natDegree) ∧
    (∀ i, p.degreeOf i ≤ 1) ∧
    R.leadingCoeff = Pi.single m (MvPolynomial.C a * p.map (Int.castRingHom ℝ)) ∧ EvalBd B p

theorem ProtectedLeadingInvariantB.toPLI {r n : ℕ} {a : ℝ} {m : Fin n} {D : ℕ} {B : ℝ}
    {R : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)} (h : ProtectedLeadingInvariantB a m D B R) :
    ProtectedLeadingInvariant a m D R := by
  obtain ⟨p, h1, h2, h3, h4, -⟩ := h
  exact ⟨p, h1, h2, h3, h4⟩

/-- Upgrading `patch:lead-invariant` by a bound, once the leading coefficient is known. -/
theorem ProtectedLeadingInvariant.toB {r n : ℕ} {a : ℝ} (ha : a ≠ 0) {m : Fin n} {D : ℕ}
    {B : ℝ} {R : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)}
    (h : ProtectedLeadingInvariant a m D R) {w : MvPolynomial (Fin r) ℤ}
    (hw : R.leadingCoeff = Pi.single m (MvPolynomial.C a * w.map (Int.castRingHom ℝ)))
    (hwB : EvalBd B w) : ProtectedLeadingInvariantB a m D B R := by
  obtain ⟨p, h1, h2, h3, h4⟩ := h
  have hpw : p = w := lead_witness_unique ha (h4.symm.trans hw)
  exact ⟨p, h1, h2, h3, h4, hpw ▸ hwB⟩

theorem ProtectedLeadingInvariantB.mono {r n : ℕ} {a : ℝ} {m : Fin n} {D : ℕ} {B B' : ℝ}
    (hB : B ≤ B') {R : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)}
    (h : ProtectedLeadingInvariantB a m D B R) : ProtectedLeadingInvariantB a m D B' R := by
  obtain ⟨p, h1, h2, h3, h4, h5⟩ := h
  exact ⟨p, h1, h2, h3, h4, h5.mono hB⟩

open Polynomial in
/-- **The leading coefficient of an unshifted-child difference** in the case of degree drop: it is
`a (p_R + d X_u p_S) e_m`, at degree `d - 1`. -/
theorem leadingCoeff_petChild_unshifted_diff {r n : ℕ} {a : ℝ} (ha : a ≠ 0) {m : Fin n} {k : ℕ}
    {iu : Fin r} {e : ℕ} (he : e ≠ 0)
    {Q1 Qi Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)}
    (hQ1 : Q1.natDegree = e + 1) (hdegle : (Q1 - Qi).natDegree ≤ e)
    {pR pS : MvPolynomial (Fin r) ℤ}
    (hR : (Q1 - Qi).coeff e = Pi.single m (MvPolynomial.C a * pR.map (Int.castRingHom ℝ)))
    (hS : Q1.leadingCoeff = Pi.single m (MvPolynomial.C a * pS.map (Int.castRingHom ℝ)))
    (hRhom : pR.IsHomogeneous (k + 1)) (hRml : ∀ i, pR.degreeOf i ≤ 1) (hfR : iu ∉ pR.vars)
    (hSne : pS ≠ 0) (hShom : pS.IsHomogeneous k) (hSml : ∀ i, pS.degreeOf i ≤ 1)
    (hfS : iu ∉ pS.vars) :
    (petSubConst ((taylor (fun _ => MvPolynomial.X iu :
          Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qp) - petSubConst (Qi - Qp)).leadingCoeff
      = Pi.single m (MvPolynomial.C a
          * ((pR + MvPolynomial.C ((e + 1 : ℕ) : ℤ) * MvPolynomial.X iu * pS).map
              (Int.castRingHom ℝ))) := by
  have hcoeff : (petSubConst ((taylor (fun _ => MvPolynomial.X iu :
          Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qp) - petSubConst (Qi - Qp)).coeff e
      = Pi.single m (MvPolynomial.C a
          * ((pR + MvPolynomial.C ((e + 1 : ℕ) : ℤ) * MvPolynomial.X iu * pS).map
              (Int.castRingHom ℝ))) := by
    rw [petSubConst_sub_coeff _ _ he]
    exact coeff_petChild_unshifted_vec hQ1 hR hS
  obtain ⟨hne, -, -⟩ :=
    petLead_add_fresh (d := e + 1) (by omega) hRhom hRml hSne hShom hSml hfR hfS
  have hnz : (petSubConst ((taylor (fun _ => MvPolynomial.X iu :
          Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qp) - petSubConst (Qi - Qp)).coeff e ≠ 0 := by
    rw [hcoeff]
    exact leadVec_ne_zero ha m hne
  have hle := le_trans (natDegree_petSubConst_sub_le
      ((taylor (fun _ => MvPolynomial.X iu : Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qp)
      (Qi - Qp))
    (natDegree_petChild_unshifted_le Q1 Qi Qp _ hQ1 hdegle)
  have hdeg := le_antisymm hle (Polynomial.le_natDegree_of_ne_zero hnz)
  simp only [Polynomial.leadingCoeff, hdeg]
  exact hcoeff

open Polynomial in
/-- In the high-degree case the leading coefficient of the new difference is the old one. -/
theorem leadingCoeff_petChild_unshifted_highDeg {r n : ℕ} {iu : Fin r} {e : ℕ}
    {Q1 Qi Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)}
    (hQ1 : Q1.natDegree = e + 1) (hdeg : (Q1 - Qi).natDegree = e + 1)
    (hne : (Q1 - Qi).leadingCoeff ≠ 0) :
    (petSubConst ((taylor (fun _ => MvPolynomial.X iu :
          Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qp) - petSubConst (Qi - Qp)).leadingCoeff
      = (Q1 - Qi).leadingCoeff := by
  have hlead : (Q1 - Qi).coeff (e + 1) = (Q1 - Qi).leadingCoeff := by
    simp only [Polynomial.leadingCoeff, hdeg]
  have hcoeff : (petSubConst ((taylor (fun _ => MvPolynomial.X iu :
          Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qp) - petSubConst (Qi - Qp)).coeff (e + 1)
      = (Q1 - Qi).coeff (e + 1) := by
    rw [petSubConst_sub_coeff _ _ (Nat.succ_ne_zero e), taylor_sub_pivot_sub,
      Polynomial.coeff_add,
      Polynomial.coeff_eq_zero_of_natDegree_lt
        (lt_of_le_of_lt (natDegree_taylor_sub_self_le Q1 _ hQ1) (Nat.lt_succ_self e)),
      zero_add]
  have hnz : (petSubConst ((taylor (fun _ => MvPolynomial.X iu :
          Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qp) - petSubConst (Qi - Qp)).coeff (e + 1)
      ≠ 0 := by rw [hcoeff, hlead]; exact hne
  have hle : (petSubConst ((taylor (fun _ => MvPolynomial.X iu :
      Fin n → MvPolynomial (Fin r) ℝ)) Q1 - Qp) - petSubConst (Qi - Qp)).natDegree ≤ e + 1 := by
    refine le_trans (natDegree_petSubConst_sub_le _ _) ?_
    rw [taylor_sub_pivot_sub]
    refine le_trans (Polynomial.natDegree_add_le _ _) ?_
    rw [hdeg]
    exact max_le (le_trans (natDegree_taylor_sub_self_le Q1 _ hQ1) (Nat.le_succ e)) le_rfl
  have hdeg' := le_antisymm hle (Polynomial.le_natDegree_of_ne_zero hnz)
  rw [Polynomial.leadingCoeff, hdeg', hcoeff, hlead]

/-- Every witness of the leading coefficient of `R` is bounded by `B` on the unit cube. -/
def PetWitBd {r n : ℕ} (a : ℝ) (m : Fin n) (B : ℝ)
    (R : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)) : Prop :=
  ∀ p : MvPolynomial (Fin r) ℤ,
    R.leadingCoeff = Pi.single m (MvPolynomial.C a * p.map (Int.castRingHom ℝ)) → EvalBd B p

theorem PetWitBd.of_eq {r n : ℕ} {a : ℝ} (ha : a ≠ 0) {m : Fin n} {B : ℝ}
    {R : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)} {w : MvPolynomial (Fin r) ℤ}
    (hw : R.leadingCoeff = Pi.single m (MvPolynomial.C a * w.map (Int.castRingHom ℝ)))
    (hwB : EvalBd B w) : PetWitBd a m B R := fun _ hp =>
  (lead_witness_unique ha (hp.symm.trans hw)) ▸ hwB

theorem PetWitBd.of_lc_eq {r n : ℕ} {a : ℝ} {m : Fin n} {B : ℝ}
    {R R' : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)} (h : R'.leadingCoeff = R.leadingCoeff)
    (hR : PetWitBd a m B R) : PetWitBd a m B R' := fun p hp => hR p (h ▸ hp)

theorem PetWitBd.mono {r n : ℕ} {a : ℝ} {m : Fin n} {B B' : ℝ} (hB : B ≤ B')
    {R : Polynomial (Fin n → MvPolynomial (Fin r) ℝ)} (h : PetWitBd a m B R) :
    PetWitBd a m B' R := fun p hp => (h p hp).mono hB

/-- The witness bounds of a state: for the head and for every difference with the head. -/
def PetRunBd {r n : ℕ} {ι : Type*} {f : ι} (a : ℝ) (m : Fin n) (B : ℝ)
    (S : NormalPETState r n ι f) : Prop :=
  PetWitBd a m B S.headPoly ∧ ∀ jt ∈ S.rest, PetWitBd a m B (S.headPoly - jt.1)

open Polynomial in
/-- **The witness bounds survive one step, with the factor `D + 2`** (the numerical part of
blueprint `patch:pet-producer`, "Full coefficient and translation bounds": each update at most
multiplies the witness bound by `d + 1`). -/
theorem petRunBd_step {r n : ℕ} {ι : Type*} {f : ι} {a : ℝ} (ha : a ≠ 0) {m : Fin n}
    {D s : ℕ} {B : ℝ} (hB : 0 ≤ B) {S : NormalPETState r n ι f} (hinv : PetRunInv a m D s S)
    (hbd : PetRunBd a m B S) {iu : Fin r} (hiu : iu.val = s) {e : ℕ} (he : e ≠ 0)
    (hQ1 : S.headPoly.natDegree = e + 1)
    (Qp : Polynomial (Fin n → MvPolynomial (Fin r) ℝ))
    (hcase : Qp = S.headPoly ∨ (∃ jt ∈ S.rest, jt.1 = Qp)
      ∧ (S.headPoly - Qp).natDegree = e + 1)
    {S' : NormalPETState r n ι f}
    (hhead : S'.headPoly = (petNewHead (fun _ => MvPolynomial.X iu) Qp S).1)
    (hrest : S'.rest = petGroup (petNonConstChildren (fun _ => MvPolynomial.X iu) Qp S)) :
    PetRunBd a m ((D + 2) * B) S' := by
  classical
  obtain ⟨pS, hSne, hShom, hSml, hfS, hSlc⟩ := hinv.headData ha hiu
  have hD : e + 1 ≤ D := hQ1 ▸ hinv.2.2.2.2
  rw [hQ1] at hShom
  have hSB : EvalBd B pS := hbd.1 pS hSlc
  have hfac : ((e : ℝ) + 2) * B ≤ ((D : ℝ) + 2) * B := by
    gcongr; exact_mod_cast (by omega : e ≤ D)
  -- the explicit witness `(e+1) X_u p_S` of a comparison with the head's own unshifted child
  have hself : ∀ Qp' : Polynomial (Fin n → MvPolynomial (Fin r) ℝ),
      PetWitBd a m ((D + 2) * B)
        (petSubConst ((taylor (fun _ => MvPolynomial.X iu :
          Fin n → MvPolynomial (Fin r) ℝ)) S.headPoly - Qp') - petSubConst (S.headPoly - Qp')) := by
    intro Qp'
    have hlc := leadingCoeff_petChild_unshifted_diff (k := D - (e + 1)) (Qi := S.headPoly)
      (Qp := Qp') (pR := 0) ha he hQ1 (by simp) (by simp) hSlc
      (MvPolynomial.isHomogeneous_zero _ _ _) (by simp) (by simp) hSne hShom hSml hfS
    exact (PetWitBd.of_eq ha hlc (EvalBd.fresh (evalBd_zero hB) hSB e iu)).mono hfac
  have hheadB : PetWitBd a m ((D + 2) * B) S'.headPoly := by
    rw [hhead]
    change PetWitBd a m _ (petSubConst ((taylor (fun _ => MvPolynomial.X iu :
      Fin n → MvPolynomial (Fin r) ℝ)) S.headPoly - Qp))
    rcases hcase with rfl | ⟨⟨jt, hjt, rfl⟩, hdeg⟩
    · have h := hself S.headPoly
      rwa [sub_self, petSubConst_zero, sub_zero] at h
    · have hne : (S.headPoly - jt.1).leadingCoeff ≠ 0 :=
        leadingCoeff_ne_zero.mpr (by intro h0; rw [h0, natDegree_zero] at hdeg; omega)
      have hlc := leadingCoeff_petChild_unshifted_highDeg (iu := iu) (Qi := jt.1) (Qp := jt.1)
        hQ1 hdeg hne
      rw [sub_self, petSubConst_zero, sub_zero] at hlc
      exact ((hbd.2 jt hjt).of_lc_eq hlc).mono (le_mul_of_one_le_left hB (by
        have : (0 : ℝ) ≤ D := Nat.cast_nonneg D; linarith))
  refine ⟨hheadB, ?_⟩
  rw [hrest, hhead]
  refine petGroup_property (fun P => PetWitBd a m ((D + 2) * B)
    ((petNewHead (fun _ => MvPolynomial.X iu) Qp S).1 - P)) ?_
  intro it hit
  have hBle : B ≤ (D + 2) * B := le_mul_of_one_le_left hB (by
    have : (0 : ℝ) ≤ D := Nat.cast_nonneg D; linarith)
  rcases mem_petNonConstChildren _ Qp S hit with h | ⟨jt, hjt, h | h⟩ <;> subst h
  · exact hself Qp
  · change PetWitBd a m _ (petSubConst ((taylor _) S.headPoly - Qp)
      - petSubConst ((taylor _) jt.1 - Qp))
    rw [petSubConst_sub, show (taylor (fun _ => MvPolynomial.X iu :
        Fin n → MvPolynomial (Fin r) ℝ)) S.headPoly - Qp
        - ((taylor (fun _ => MvPolynomial.X iu :
        Fin n → MvPolynomial (Fin r) ℝ)) jt.1 - Qp)
        = (taylor (fun _ => MvPolynomial.X iu :
        Fin n → MvPolynomial (Fin r) ℝ)) (S.headPoly - jt.1) by rw [map_sub]; ring]
    have hne : S.headPoly - jt.1 ≠ 0 := sub_ne_zero.mpr (Ne.symm (S.rest_ne_head jt hjt))
    have h0 : (S.headPoly - jt.1).coeff 0 = 0 := by
      rw [coeff_sub, S.headPoly_vanish, S.rest_vanish jt hjt, sub_zero]
    have h1 := one_le_natDegree_of_coeff_zero hne h0
    have hlc : (petSubConst ((taylor (fun _ => MvPolynomial.X iu :
        Fin n → MvPolynomial (Fin r) ℝ)) (S.headPoly - jt.1))).leadingCoeff
        = (S.headPoly - jt.1).leadingCoeff := by
      rw [leadingCoeff_petSubConst (by rw [natDegree_taylor]; exact h1), leadingCoeff_taylor]
    exact ((hbd.2 jt hjt).of_lc_eq hlc).mono hBle
  · change PetWitBd a m _ (petSubConst ((taylor _) S.headPoly - Qp) - petSubConst (jt.1 - Qp))
    by_cases hdeg : (S.headPoly - jt.1).natDegree = e + 1
    · have hne : (S.headPoly - jt.1).leadingCoeff ≠ 0 :=
        leadingCoeff_ne_zero.mpr (by intro h0; rw [h0, natDegree_zero] at hdeg; omega)
      exact ((hbd.2 jt hjt).of_lc_eq (leadingCoeff_petChild_unshifted_highDeg
        (iu := iu) (Qp := Qp) hQ1 hdeg hne)).mono hBle
    · have hle : (S.headPoly - jt.1).natDegree ≤ e := by
        have h1 : (S.headPoly - jt.1).natDegree ≤ e + 1 := by
          refine le_trans (natDegree_sub_le _ _) (max_le (le_of_eq hQ1) ?_)
          rw [← hQ1]; exact S.head_max jt hjt
        omega
      obtain ⟨pR, hRhom, hRml, hfR, hReq⟩ := hinv.diffData ha hiu hQ1 jt hjt hdeg
      have hRB : EvalBd B pR := by
        rcases lt_or_eq_of_le hle with hlt | heq
        · have h0 : (S.headPoly - jt.1).coeff e = 0 := coeff_eq_zero_of_natDegree_lt hlt
          rw [h0] at hReq
          have : pR = 0 := lead_witness_unique ha (by rw [← hReq]; simp)
          rw [this]; exact evalBd_zero hB
        · have hcl : (S.headPoly - jt.1).leadingCoeff = (S.headPoly - jt.1).coeff e := by
            rw [leadingCoeff, heq]
          exact hbd.2 jt hjt pR (hcl.trans hReq)
      have hlc := leadingCoeff_petChild_unshifted_diff (k := D - (e + 1)) (Qp := Qp) ha he hQ1
        hle hReq hSlc hRhom hRml hfR hSne hShom hSml hfS
      exact (PetWitBd.of_eq ha hlc (EvalBd.fresh hRB hSB e iu)).mono hfac

end

section
open Filter Topology MeasureTheory

variable {r n : ℕ} {ι : Type*} {f : ι}

/-- A state of the run at step `k`, with its invariant and witness bound. -/
def PetRunState (a : ℝ) (m : Fin n) (D s0 : ℕ) (B0 : ℝ) (k : ℕ) :=
  {S : NormalPETState r n ι f // PetRunInv a m D (s0 + k) S ∧ PetRunBd a m (B0 * (D + 2) ^ k) S}

theorem PetRunInv.mono_step {a : ℝ} {m : Fin n} {D s : ℕ} {S : NormalPETState r n ι f}
    (h : PetRunInv a m D s S) : PetRunInv a m D (s + 1) S :=
  ⟨h.1, h.2.1, h.2.2.1.mono (Nat.le_succ s), fun jt hjt => (h.2.2.2.1 jt hjt).mono
    (Nat.le_succ s), h.2.2.2.2⟩

theorem PetRunBd.mono {a : ℝ} {m : Fin n} {B B' : ℝ} (hB : B ≤ B')
    {S : NormalPETState r n ι f} (h : PetRunBd a m B S) : PetRunBd a m B' S :=
  ⟨h.1.mono hB, fun jt hjt => (h.2 jt hjt).mono hB⟩

open scoped Classical in
/-- **One step of the run with witness bounds**: `Auto.petRunStep` together with
`Auto.petRunBd_step`. -/
theorem petRunStepBd {a : ℝ} (ha : a ≠ 0) {m : Fin n} {D s : ℕ} (hD3 : D ≤ 3) {B : ℝ}
    (hB : 0 ≤ B) {S : NormalPETState r n ι f} (hinv : PetRunInv a m D s S)
    (hbd : PetRunBd a m B S) {iu : Fin r} (hiu : iu.val = s) (hd : 2 ≤ S.headPoly.natDegree) :
    ∃ Qp ∈ (petAllItems S).map Prod.fst, ∃ S' : NormalPETState r n ι f,
      S'.spatial = petNewSpatial (fun _ => MvPolynomial.X iu) Qp S
      ∧ S'.headPoly = (petNewHead (fun _ => MvPolynomial.X iu) Qp S).1
      ∧ S'.headFactor = petNewHeadFactor (fun _ => MvPolynomial.X iu) Qp S
      ∧ S'.rest = petGroup (petNonConstChildren (fun _ => MvPolynomial.X iu) Qp S)
      ∧ PetRunInv a m D (s + 1) S' ∧ PetRunBd a m ((D + 2) * B) S'
      ∧ petTypeStep (petAllItems S).length (petStateType S) (petStateType S')
      ∧ (petAllItems S').length ≤ 2 * (petAllItems S).length := by
  obtain ⟨Qp, hQp, S', h1, h2, h3, h4, h5, h6, h7, h8⟩ := petRunStep ha hD3 hinv hiu hd
  obtain ⟨e, he1⟩ : ∃ e, S.headPoly.natDegree = e + 1 := ⟨S.headPoly.natDegree - 1, by omega⟩
  rw [he1] at h8
  exact ⟨Qp, hQp, S', h1, h2, h3, h4, h5,
    petRunBd_step ha hB hinv hbd hiu (by omega) he1 Qp h8 h2 h4, h6, h7⟩

theorem petRunBd_factor {D : ℕ} {B0 : ℝ} (hB0 : 0 ≤ B0) (k : ℕ) :
    B0 * (D + 2) ^ k ≤ B0 * (D + 2) ^ (k + 1) := by
  rw [pow_succ]
  have h1 : (1 : ℝ) ≤ D + 2 := by have : (0 : ℝ) ≤ D := Nat.cast_nonneg D; linarith
  have h2 : 0 ≤ B0 * (D + 2) ^ k := mul_nonneg hB0 (by positivity)
  nlinarith

/-- **One move of the run**: the update when the head degree is at least `2` and a fresh variable
is available, and the state itself otherwise. -/
noncomputable def petRunMove {a : ℝ} (ha : a ≠ 0) {m : Fin n} {D s0 : ℕ} (hD3 : D ≤ 3) {B0 : ℝ}
    (hB0 : 0 ≤ B0) (k : ℕ) (x : PetRunState (ι := ι) (f := f) (r := r) a m D s0 B0 k) :
    NormalPETState r n ι f :=
  if h : 2 ≤ x.1.headPoly.natDegree ∧ s0 + k < r then
    Classical.choose (Classical.choose_spec (petRunStepBd ha hD3 (mul_nonneg hB0 (by positivity))
      x.2.1 x.2.2 (iu := ⟨s0 + k, h.2⟩) rfl h.1)).2
  else x.1

theorem petRunMove_pos {a : ℝ} (ha : a ≠ 0) {m : Fin n} {D s0 : ℕ} (hD3 : D ≤ 3) {B0 : ℝ}
    (hB0 : 0 ≤ B0) (k : ℕ) (x : PetRunState (ι := ι) (f := f) (r := r) a m D s0 B0 k)
    (h : 2 ≤ x.1.headPoly.natDegree ∧ s0 + k < r) :
    petRunMove ha hD3 hB0 k x
      = Classical.choose (Classical.choose_spec (petRunStepBd ha hD3
          (mul_nonneg hB0 (by positivity)) x.2.1 x.2.2 (iu := ⟨s0 + k, h.2⟩) rfl h.1)).2 := by
  unfold petRunMove
  rw [dite_eq_left h]

theorem petRunMove_neg {a : ℝ} (ha : a ≠ 0) {m : Fin n} {D s0 : ℕ} (hD3 : D ≤ 3) {B0 : ℝ}
    (hB0 : 0 ≤ B0) (k : ℕ) (x : PetRunState (ι := ι) (f := f) (r := r) a m D s0 B0 k)
    (h : ¬ (2 ≤ x.1.headPoly.natDegree ∧ s0 + k < r)) :
    petRunMove ha hD3 hB0 k x = x.1 := by
  unfold petRunMove
  rw [dite_eq_right h]

/-- When a move is made, the next state is the update at some pivot, with the invariant, the
bound, the type move and the length doubling. -/
theorem petRunMove_spec {a : ℝ} (ha : a ≠ 0) {m : Fin n} {D s0 : ℕ} (hD3 : D ≤ 3) {B0 : ℝ}
    (hB0 : 0 ≤ B0) (k : ℕ) (x : PetRunState (ι := ι) (f := f) (r := r) a m D s0 B0 k)
    (h : 2 ≤ x.1.headPoly.natDegree ∧ s0 + k < r) :
    ∃ Qp ∈ (petAllItems x.1).map Prod.fst,
      (petRunMove ha hD3 hB0 k x).spatial
          = petNewSpatial (fun _ => MvPolynomial.X (⟨s0 + k, h.2⟩ : Fin r)) Qp x.1
      ∧ (petRunMove ha hD3 hB0 k x).headPoly
          = (petNewHead (fun _ => MvPolynomial.X (⟨s0 + k, h.2⟩ : Fin r)) Qp x.1).1
      ∧ (petRunMove ha hD3 hB0 k x).headFactor
          = petNewHeadFactor (fun _ => MvPolynomial.X (⟨s0 + k, h.2⟩ : Fin r)) Qp x.1
      ∧ (petRunMove ha hD3 hB0 k x).rest
          = petGroup (petNonConstChildren (fun _ => MvPolynomial.X (⟨s0 + k, h.2⟩ : Fin r)) Qp x.1)
      ∧ PetRunInv a m D (s0 + k + 1) (petRunMove ha hD3 hB0 k x)
      ∧ PetRunBd a m ((D + 2) * (B0 * (D + 2) ^ k)) (petRunMove ha hD3 hB0 k x)
      ∧ petTypeStep (petAllItems x.1).length (petStateType x.1)
          (petStateType (petRunMove ha hD3 hB0 k x))
      ∧ (petAllItems (petRunMove ha hD3 hB0 k x)).length ≤ 2 * (petAllItems x.1).length := by
  rw [petRunMove_pos ha hD3 hB0 k x h]
  have hstep := petRunStepBd ha hD3 (mul_nonneg hB0 (by positivity)) x.2.1 x.2.2
    (iu := ⟨s0 + k, h.2⟩) rfl h.1
  exact ⟨Classical.choose hstep, (Classical.choose_spec hstep).1,
    Classical.choose_spec (Classical.choose_spec hstep).2⟩

theorem petRunMove_inv {a : ℝ} (ha : a ≠ 0) {m : Fin n} {D s0 : ℕ} (hD3 : D ≤ 3) {B0 : ℝ}
    (hB0 : 0 ≤ B0) (k : ℕ) (x : PetRunState (ι := ι) (f := f) (r := r) a m D s0 B0 k) :
    PetRunInv a m D (s0 + (k + 1)) (petRunMove ha hD3 hB0 k x)
      ∧ PetRunBd a m (B0 * (D + 2) ^ (k + 1)) (petRunMove ha hD3 hB0 k x) := by
  by_cases h : 2 ≤ x.1.headPoly.natDegree ∧ s0 + k < r
  · obtain ⟨-, -, -, -, -, -, h5, h6, -, -⟩ := petRunMove_spec ha hD3 hB0 k x h
    refine ⟨by rw [← Nat.add_assoc]; exact h5, ?_⟩
    rw [pow_succ, ← mul_assoc, mul_comm (B0 * _)]; exact h6
  · rw [petRunMove_neg ha hD3 hB0 k x h]
    exact ⟨by rw [← Nat.add_assoc]; exact x.2.1.mono_step, x.2.2.mono (petRunBd_factor hB0 k)⟩

/-- The run as a sequence of states. -/
noncomputable def petRunSeq {a : ℝ} (ha : a ≠ 0) {m : Fin n} {D s0 : ℕ} (hD3 : D ≤ 3) {B0 : ℝ}
    (hB0 : 0 ≤ B0) (S0 : NormalPETState r n ι f) (hinv0 : PetRunInv a m D s0 S0)
    (hbd0 : PetRunBd a m B0 S0) :
    (k : ℕ) → PetRunState (ι := ι) (f := f) (r := r) a m D s0 B0 k
  | 0 => ⟨S0, by simpa using hinv0, by simpa using hbd0⟩
  | k + 1 => ⟨petRunMove ha hD3 hB0 k (petRunSeq ha hD3 hB0 S0 hinv0 hbd0 k),
      petRunMove_inv ha hD3 hB0 k _⟩

theorem petRunSeq_succ {a : ℝ} (ha : a ≠ 0) {m : Fin n} {D s0 : ℕ} (hD3 : D ≤ 3) {B0 : ℝ}
    (hB0 : 0 ≤ B0) (S0 : NormalPETState r n ι f) (hinv0 : PetRunInv a m D s0 S0)
    (hbd0 : PetRunBd a m B0 S0) (k : ℕ) :
    (petRunSeq ha hD3 hB0 S0 hinv0 hbd0 (k + 1)).1
      = petRunMove ha hD3 hB0 k (petRunSeq ha hD3 hB0 S0 hinv0 hbd0 k) := rfl

theorem petTypeStep_mono {L L' : ℕ} (hL : L ≤ L') {w w' : ℕ × ℕ × ℕ} (h : petTypeStep L w w') :
    petTypeStep L' w w' := by
  unfold petTypeStep at *
  rcases h with ⟨h1, h2, h3⟩ | ⟨h1, h2, h3⟩ | h
  · exact Or.inl ⟨h1, by omega, by omega⟩
  · exact Or.inr (Or.inl ⟨h1, h2, by omega⟩)
  · exact Or.inr (Or.inr h)

/-- **The run terminates within a uniform number of steps** (blueprint `patch:pet-producer`, "This
proves uniform complexity"): for every initial type `w` and length budget `L` there is `R` such
that every run from a state of that type and length at most `L`, with enough fresh variables,
reaches head degree at most one after `T ≤ R` moves, all earlier moves being genuine. -/
theorem petRun_terminates (w : ℕ × ℕ × ℕ) (L : ℕ) : ∃ R : ℕ, ∀ {r n : ℕ} {ι : Type*} {f : ι}
    {a : ℝ} (ha : a ≠ 0) {m : Fin n} {D s0 : ℕ} (hD3 : D ≤ 3) {B0 : ℝ} (hB0 : 0 ≤ B0)
    (S0 : NormalPETState r n ι f) (hinv0 : PetRunInv a m D s0 S0) (hbd0 : PetRunBd a m B0 S0),
    petStateType S0 = w → (petAllItems S0).length ≤ L → s0 + R < r →
    ∃ T ≤ R, (petRunSeq ha hD3 hB0 S0 hinv0 hbd0 T).1.headPoly.natDegree ≤ 1
      ∧ ∀ k < T, 2 ≤ (petRunSeq ha hD3 hB0 S0 hinv0 hbd0 k).1.headPoly.natDegree := by
  obtain ⟨R, hR⟩ := petRun_bounded w.1 w.2.1 w.2.2 L
  refine ⟨R, ?_⟩
  intro r n ι f a ha m D s0 hD3 B0 hB0 S0 hinv0 hbd0 hw hL hr
  set seq := petRunSeq ha hD3 hB0 S0 hinv0 hbd0 with hseq
  have hex : ∃ T, (seq T).1.headPoly.natDegree ≤ 1 := by
    by_contra hno
    push Not at hno
    have hmove : ∀ k, k ≤ R → 2 ≤ (seq k).1.headPoly.natDegree ∧ s0 + k < r :=
      fun k hk => ⟨hno k, by omega⟩
    have hstepk : ∀ k, k ≤ R →
        petTypeStep (petAllItems (seq k).1).length (petStateType (seq k).1)
          (petStateType (seq (k + 1)).1)
        ∧ (petAllItems (seq (k + 1)).1).length ≤ 2 * (petAllItems (seq k).1).length := by
      intro k hk
      obtain ⟨Qp, -, -, -, -, -, -, -, h5, h6⟩ := petRunMove_spec ha hD3 hB0 k (seq k) (hmove k hk)
      exact ⟨h5, h6⟩
    have hlen : ∀ k, k ≤ R + 1 → (petAllItems (seq k).1).length ≤ L * 2 ^ k := by
      intro k
      induction k with
      | zero => intro _; simpa [hseq, petRunSeq] using hL
      | succ k ih =>
        intro hk
        have h1 := (hstepk k (by omega)).2
        have h2 := ih (by omega)
        calc (petAllItems (seq (k + 1)).1).length ≤ 2 * (petAllItems (seq k).1).length := h1
          _ ≤ 2 * (L * 2 ^ k) := by omega
          _ = L * 2 ^ (k + 1) := by ring
    have hbound := hR (fun k => petStateType (seq k).1) (fun k => L * 2 ^ k) (R + 1)
      (by simpa [hseq, petRunSeq] using hw) (by simp) (fun k => by ring)
      (fun k hk => petTypeStep_mono (hlen k (by omega)) (hstepk k (by omega)).1)
    omega
  classical
  let T := Nat.find hex
  have hTspec : (seq T).1.headPoly.natDegree ≤ 1 := Nat.find_spec hex
  have hTmin : ∀ k < T, 2 ≤ (seq k).1.headPoly.natDegree := fun k hk => by
    have := Nat.find_min hex hk
    omega
  refine ⟨T, ?_, hTspec, hTmin⟩
  by_contra hTR
  push Not at hTR
  have hmove : ∀ k, k ≤ R → 2 ≤ (seq k).1.headPoly.natDegree ∧ s0 + k < r :=
    fun k hk => ⟨hTmin k (by omega), by omega⟩
  have hstepk : ∀ k, k ≤ R →
      petTypeStep (petAllItems (seq k).1).length (petStateType (seq k).1)
        (petStateType (seq (k + 1)).1)
      ∧ (petAllItems (seq (k + 1)).1).length ≤ 2 * (petAllItems (seq k).1).length := by
    intro k hk
    obtain ⟨Qp, -, -, -, -, -, -, -, h5, h6⟩ := petRunMove_spec ha hD3 hB0 k (seq k) (hmove k hk)
    exact ⟨h5, h6⟩
  have hlen : ∀ k, k ≤ R + 1 → (petAllItems (seq k).1).length ≤ L * 2 ^ k := by
    intro k
    induction k with
    | zero => intro _; simpa [hseq, petRunSeq] using hL
    | succ k ih =>
      intro hk
      have h1 := (hstepk k (by omega)).2
      have h2 := ih (by omega)
      calc (petAllItems (seq (k + 1)).1).length ≤ 2 * (petAllItems (seq k).1).length := h1
        _ ≤ 2 * (L * 2 ^ k) := by omega
        _ = L * 2 ^ (k + 1) := by ring
  have hbound := hR (fun k => petStateType (seq k).1) (fun k => L * 2 ^ k) (R + 1)
    (by simpa [hseq, petRunSeq] using hw) (by simp) (fun k => by ring)
    (fun k hk => petTypeStep_mono (hlen k (by omega)) (hstepk k (by omega)).1)
  omega

end

