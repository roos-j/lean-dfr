        * phaseAmp (r + 1) m f P p j g V N (Fin.cons q.1 q.2) := by
  have hfun : (fun q : ℝ × (Fin r → ℝ) =>
        (∏ l : Fin (r + 1), fejer H ((Fin.cons q.1 q.2 : Fin (r + 1) → ℝ) l))
          * phaseAmp (r + 1) m f P p j g V N (Fin.cons q.1 q.2))
