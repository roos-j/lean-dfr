theorem integrable_prod_fejer_mul_phaseAmp_sq {H : ℝ} (hH : 0 < H) (r m : ℕ) {f : ℕ → E3 → ℂ}
    {P : ℕ → Polynomial ℝ} {p : E3 → Polynomial ℝ} {j : ℕ → Fin 3} {g : E3 → ℂ} {V N : ℝ}
