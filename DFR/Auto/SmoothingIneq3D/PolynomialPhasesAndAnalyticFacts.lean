    have hf0 : 0 ≤ fejer H q.2 := fejer_nonneg hH q.2
    have hB0 : 0 ≤ phaseAmp (r + 1) m f P p j g V N (Fin.cons q.2 q.1) :=
      phaseAmp_nonneg (r + 1) m f P p j g V N _
