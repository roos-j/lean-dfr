measurable there. -/
theorem stronglyMeasurable_phaseAmp (r m : ℕ) {f : ℕ → E3 → ℂ} {P : ℕ → Polynomial ℝ}
    {p : E3 → Polynomial ℝ} {j : ℕ → Fin 3} {g : E3 → ℂ} {V N : ℝ}
