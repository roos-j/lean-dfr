theorem norm_integral_phaseProdIter_x_le (r m : ℕ) {f : ℕ → E3 → ℂ} {P : ℕ → Polynomial ℝ}
    {p : E3 → Polynomial ℝ} {j : ℕ → Fin 3} {C K N : ℝ} (hCK : 0 ≤ C + K) (hN0 : 0 ≤ N)
