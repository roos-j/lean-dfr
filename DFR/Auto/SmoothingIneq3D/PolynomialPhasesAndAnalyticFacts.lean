    ‖∫ t in (0 : ℝ)..(0 + N), ∫ x : E3, phaseProdIter (r + 1) m f P p j x k t‖
      ≤ (volume (petBox (C + K) N)).toReal * N := by
  have hptw : ∀ t ∈ Set.uIoc (0 : ℝ) (0 + N),
      ‖∫ x : E3, phaseProdIter (r + 1) m f P p j x k t‖
