  have hZ := stronglyMeasurable_windowSpace r m hCK hN0 hN1 hK hm hf hsupp hbd hFm h
  have hre0 : StronglyMeasurable (Complex.re ∘ fun u : ℝ => ∫ t in (0 : ℝ)..(0 + N),
