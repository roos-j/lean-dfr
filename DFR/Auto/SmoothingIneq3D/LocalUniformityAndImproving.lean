/-- The noncritical set of the flow of `w^(1)`. -/
def ndSet1 : Set E6 :=
  {s : E6 | s 1 ≠ s 2 ∧ (s 0 - s 3) * (s 3 - s 4) ≠ 0 ∧ s 0 ≠ s 4}

open MeasureTheory in
theorem measurableSet_ndSet1 : MeasurableSet ndSet1 := by
  have h12 : MeasurableSet {s : E6 | s 1 ≠ s 2} :=
    (measurableSet_eq_fun (continuous_E6_coord 1).measurable
      (continuous_E6_coord 2).measurable).compl
  have h04 : MeasurableSet {s : E6 | s 0 ≠ s 4} :=
    (measurableSet_eq_fun (continuous_E6_coord 0).measurable
      (continuous_E6_coord 4).measurable).compl
  have hmul : MeasurableSet {s : E6 | (s 0 - s 3) * (s 3 - s 4) ≠ 0} := by
    have hc : Measurable fun s : E6 => (s 0 - s 3) * (s 3 - s 4) :=
      (((continuous_E6_coord 0).sub (continuous_E6_coord 3)).mul
        ((continuous_E6_coord 3).sub (continuous_E6_coord 4))).measurable
    exact (measurableSet_eq_fun hc measurable_const).compl
  exact h12.inter (hmul.inter h04)

theorem absDet_flowDeriv1_eq_zero {s : E6} (h : s ∉ ndSet1) :
    |LinearMap.det ((flowDeriv1 s : E6 →L[ℝ] E6) : E6 →ₗ[ℝ] E6)| = 0 := by
  rw [abs_det_flowDeriv1]
  rw [ndSet1, Set.mem_ofPred_eq] at h
  rcases not_and_or.mp h with h1 | h2
  · rw [not_not] at h1
    rw [abs_eq_zero.mpr (sub_eq_zero.mpr h1)]
    ring
  · rcases not_and_or.mp h2 with h3 | h4
    · rw [not_not] at h3
      rcases mul_eq_zero.mp h3 with h5 | h6
      · rw [abs_eq_zero.mpr h5]
        ring
      · rw [abs_eq_zero.mpr h6]
        ring
    · rw [not_not] at h4
      rw [abs_eq_zero.mpr (sub_eq_zero.mpr h4)]
      ring

open MeasureTheory in
theorem lintegral_absDet1_eq_ndSet1 (N : ℝ) {G : ℕ → Set E6} {Gi : ℕ → Fin 3 → Set E6}
    (hGm : ∀ k, MeasurableSet (G k)) (hGim : ∀ k i, MeasurableSet (Gi k i)) (r : ℕ) (z : E6) :
    ∫⁻ s in flowParamSet N G Gi r word1 z,
        ENNReal.ofReal |LinearMap.det ((flowDeriv1 s : E6 →L[ℝ] E6) : E6 →ₗ[ℝ] E6)|
      = ∫⁻ s in flowParamSet N G Gi r word1 z ∩ ndSet1,
        ENNReal.ofReal |LinearMap.det ((flowDeriv1 s : E6 →L[ℝ] E6) : E6 →ₗ[ℝ] E6)| := by
  have hmd : MeasurableSet (flowParamSet N G Gi r word1 z \ ndSet1) :=
    (measurableSet_flowParamSet N hGm hGim r word1 z).diff measurableSet_ndSet1
  have hle : ∫⁻ s in flowParamSet N G Gi r word1 z \ ndSet1,
      ENNReal.ofReal |LinearMap.det ((flowDeriv1 s : E6 →L[ℝ] E6) : E6 →ₗ[ℝ] E6)|
        ≤ ∫⁻ _s in flowParamSet N G Gi r word1 z \ ndSet1, (0 : ℝ≥0∞) :=
    setLIntegral_mono' hmd fun s hs => by
      rw [absDet_flowDeriv1_eq_zero hs.2, ENNReal.ofReal_zero]
  have hzero : ∫⁻ s in flowParamSet N G Gi r word1 z \ ndSet1,
      ENNReal.ofReal |LinearMap.det ((flowDeriv1 s : E6 →L[ℝ] E6) : E6 →ₗ[ℝ] E6)| = 0 := by
    simpa using hle
  rw [← lintegral_inter_add_sdiff _ _ measurableSet_ndSet1, hzero, add_zero]

open MeasureTheory in
/-- **Patch 1 `lem:integrated` for `w^(1)`: the terminal set is large.** -/
theorem measure_terminal_ge_word1 (N : ℝ) {G : ℕ → Set E6} {Gi : ℕ → Fin 3 → Set E6}
    (hGm : ∀ k, MeasurableSet (G k)) (hGim : ∀ k i, MeasurableSet (Gi k i))
    (hGdec : ∀ k, G (k + 1) ⊆ G k) (hGidec : ∀ k i, Gi (k + 1) i ⊆ Gi k i)
    {c₀ : ℝ≥0∞} {c : Fin 3 → ℝ≥0∞} {r : ℕ} (hr : 6 ≤ r)
    (hfwd : ∀ k, k < r → ∀ x ∈ G (k + 1), c₀ ≤ incidFwd N (Gi k) x)
    (hadj : ∀ k, k < r → ∀ i, ∀ y ∈ Gi (k + 1) i, c i ≤ incidAdj N (G k) (Gi k) i y)
    {z : E6} (hz : z ∈ cfg4 (G r) (Gi r) (word1 0))
    {a : ℕ → ℝ} (ha : ∀ l, 0 ≤ a l * N)
    (hf1 : ENNReal.ofReal (a 0 * N) ≤ volume (towA1 N G Gi r word1 z))
    (hf2 : ∀ x ∈ towA1 N G Gi r word1 z,
      ENNReal.ofReal (a 1 * N) ≤ volume (towA2 N G Gi r word1 z x))
    (hf3 : ∀ x ∈ towA1 N G Gi r word1 z, ∀ y ∈ towA2 N G Gi r word1 z x,
      ENNReal.ofReal (a 2 * N) ≤ volume (towA3 N G Gi r word1 z x y))
    (hf4 : ∀ x ∈ towA1 N G Gi r word1 z, ∀ y ∈ towA2 N G Gi r word1 z x,
      ∀ u ∈ towA3 N G Gi r word1 z x y,
      ENNReal.ofReal (a 3 * N) ≤ volume (towA4 N G Gi r word1 z x y u))
    (hf5 : ∀ x ∈ towA1 N G Gi r word1 z, ∀ y ∈ towA2 N G Gi r word1 z x,
      ∀ u ∈ towA3 N G Gi r word1 z x y, ∀ v ∈ towA4 N G Gi r word1 z x y u,
      ENNReal.ofReal (a 4 * N) ≤ volume (towA5 N G Gi r word1 z x y u v))
    (hf6 : ∀ x ∈ towA1 N G Gi r word1 z, ∀ y ∈ towA2 N G Gi r word1 z x,
      ∀ u ∈ towA3 N G Gi r word1 z x y, ∀ v ∈ towA4 N G Gi r word1 z x y u,
      ∀ t ∈ towA5 N G Gi r word1 z x y u v,
      ENNReal.ofReal (a 5 * N) ≤ volume (towA6 N G Gi r word1 z x y u v t)) :
    ENNReal.ofReal (2⁻¹ * (a 0 * N)) * ENNReal.ofReal (2⁻¹ * (a 1 * N))
        * ENNReal.ofReal (2⁻¹ * (8 : ℝ)⁻¹ * (a 2 * N) ^ 2)
        * ENNReal.ofReal (2⁻¹ * (8 : ℝ)⁻¹ * (a 3 * N) ^ 2)
        * ENNReal.ofReal (2⁻¹ * ((8 : ℝ)⁻¹) ^ 2 * (a 4 * N) ^ 3)
        * ENNReal.ofReal (2⁻¹ * (a 5 * N))
      ≤ 2 * volume (cfg4 (G 0) (Gi 0) (word1 6)) := by
  obtain ⟨-, -, -, -, harea⟩ :=
    real_flow_jacobian_word1 N hGm hGim hGdec hGidec hr hfwd hadj hz
  refine le_trans (lintegral_absDet1_flowParamSet_ge N hGm hGim r z ha hf1 hf2 hf3 hf4 hf5 hf6) ?_
  rw [lintegral_absDet1_eq_ndSet1 N hGm hGim r z]
  exact harea (flowParamSet N G Gi r word1 z ∩ ndSet1) Set.inter_subset_left
    ((measurableSet_flowParamSet N hGm hGim r word1 z).inter measurableSet_ndSet1)
