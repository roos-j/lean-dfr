open MeasureTheory in
/-- **Blueprint `prop:restricted-improving-vertex`, the descent inequality.** The sixtieth power
of the pairing of the average with a test set, against the measures of the four sets. -/
theorem lintegral_enorm_A_pow_sixty_le {N : ℝ} (hN : 0 < N) {S : Set E3} (hS : MeasurableSet S)
    (hS0 : volume S ≠ 0) (hSt : volume S ≠ ⊤)
    {F : Fin 3 → Set E3} (hF : ∀ i, MeasurableSet (F i))
    (hF0 : ∀ i, volume (F i) ≠ 0) (hFt : ∀ i, volume (F i) ≠ ⊤)
    {m j k : Fin 3} (hjm : j ≠ m) (hkm : k ≠ m) (hjk : j ≠ k) :
    ENNReal.ofReal N ^ (6 : ℕ) * (∫⁻ y in S, ‖A N (indicators F) y‖ₑ) ^ (60 : ℕ)
      ≤ 2 ^ (19 : ℕ) * 8 ^ (51 : ℕ) * 16 ^ (360 : ℕ)
        * (volume S ^ (10 : ℕ) * volume (F j) ^ (30 : ℕ) * volume (F m) ^ (11 : ℕ)
          * volume (F k) ^ (10 : ℕ)) := by
  have hν0 : ENNReal.ofReal N ≠ 0 := (ENNReal.ofReal_pos.mpr hN).ne'
  have hνt : ENNReal.ofReal N ≠ ⊤ := ENNReal.ofReal_ne_top
  have hLt : (∫⁻ y in S, ‖A N (indicators F) y‖ₑ) ≠ ⊤ := lintegral_enorm_A_ne_top hN hSt hF
  have hE₀m : MeasurableSet (proj6 ⁻¹' S ∩ innerBox N) :=
    (hS.preimage measurable_proj6).inter (measurableSet_innerBox N)
  have hEm : ∀ i, MeasurableSet (proj6 ⁻¹' (F i) ∩ boxSet N) := fun i =>
    ((hF i).preimage measurable_proj6).inter (measurableSet_boxSet N)
  have hpow4 : ENNReal.ofReal (N ^ 4) = ENNReal.ofReal N ^ (4 : ℕ) :=
    ENNReal.ofReal_pow hN.le 4
  have h8 : ENNReal.ofReal (8 * N ^ 4) = 8 * ENNReal.ofReal N ^ (4 : ℕ) := by
    rw [ENNReal.ofReal_mul (by norm_num), hpow4]
    norm_num
  have hvE₀ : volume (proj6 ⁻¹' S ∩ innerBox N) = volume S * ENNReal.ofReal N ^ (4 : ℕ) := by
    rw [volume_lifted_inner hN.le hS, hpow4]
  have hvE : ∀ i, volume (proj6 ⁻¹' (F i) ∩ boxSet N)
      = volume (F i) * (8 * ENNReal.ofReal N ^ (4 : ℕ)) := by
    intro i
    rw [volume_lifted_set hN.le (hF i), h8]
  have h₀0 : volume (proj6 ⁻¹' S ∩ innerBox N) ≠ 0 := by
    rw [hvE₀]
    exact mul_ne_zero hS0 (pow_ne_zero _ hν0)
  have h₀t : volume (proj6 ⁻¹' S ∩ innerBox N) ≠ ⊤ := by
    rw [hvE₀]
    exact ENNReal.mul_ne_top hSt (ENNReal.pow_ne_top hνt)
  have hi0 : ∀ i, volume (proj6 ⁻¹' (F i) ∩ boxSet N) ≠ 0 := by
    intro i
    rw [hvE i]
    exact mul_ne_zero (hF0 i) (mul_ne_zero (by norm_num) (pow_ne_zero _ hν0))
  have hit : ∀ i, volume (proj6 ⁻¹' (F i) ∩ boxSet N) ≠ ⊤ := by
    intro i
    rw [hvE i]
    exact ENNReal.mul_ne_top (hFt i)
      (ENNReal.mul_ne_top (by norm_num) (ENNReal.pow_ne_top hνt))
  set K : ℝ≥0∞ :=
    (∫⁻ y in S, ‖A N (indicators F) y‖ₑ) * ENNReal.ofReal N ^ (4 : ℕ) / 16 ^ (6 : ℕ) with hK
  have h16_0 : (16 : ℝ≥0∞) ^ (6 : ℕ) ≠ 0 := by norm_num
  have h16_t : (16 : ℝ≥0∞) ^ (6 : ℕ) ≠ ⊤ := by norm_num
  have hKmul : 16 ^ (6 : ℕ) * K
      = (∫⁻ y in S, ‖A N (indicators F) y‖ₑ) * ENNReal.ofReal N ^ (4 : ℕ) :=
    ENNReal.mul_div_cancel' (fun h => absurd h h16_0) (fun h => absurd h h16_t)
  have hKt : K ≠ ⊤ := by
    rw [hK]
    exact ENNReal.div_ne_top (ENNReal.mul_ne_top hLt (ENNReal.pow_ne_top hνt)) h16_0
  have hlow : 16 ^ (6 : ℕ) * (K * ENNReal.ofReal N)
      ≤ incid N (proj6 ⁻¹' S ∩ innerBox N) (fun i => proj6 ⁻¹' (F i) ∩ boxSet N) := by
    have hN5 : ENNReal.ofReal (N ^ 5) = ENNReal.ofReal N ^ (5 : ℕ) := ENNReal.ofReal_pow hN.le 5
    rw [incid_lift_eq hN hS hF, ← mul_assoc, hKmul, hN5]
    refine le_of_eq ?_
    ring
  have hmain := K_pow_sixty_incid hN hE₀m hEm h₀0 h₀t hi0 hit (le_refl 6) hKt hlow hjm hkm hjk
  simp only [hvE₀, hvE] at hmain
  have hc19 : ENNReal.ofReal (((2 : ℝ) ^ (19 : ℕ))⁻¹) = ((2 : ℝ≥0∞) ^ (19 : ℕ))⁻¹ := by
    rw [ENNReal.ofReal_inv_of_pos (by positivity), ENNReal.ofReal_pow (by norm_num)]
    norm_num
  rw [hc19, mul_assoc] at hmain
  have hstep1 : ENNReal.ofReal N ^ (10 : ℕ) * K ^ (60 : ℕ)
      ≤ 2 ^ (19 : ℕ) * ((volume S * ENNReal.ofReal N ^ (4 : ℕ)) ^ (10 : ℕ)
          * (volume (F j) * (8 * ENNReal.ofReal N ^ (4 : ℕ))) ^ (30 : ℕ)
          * (volume (F m) * (8 * ENNReal.ofReal N ^ (4 : ℕ))) ^ (11 : ℕ)
          * (volume (F k) * (8 * ENNReal.ofReal N ^ (4 : ℕ))) ^ (10 : ℕ)) :=
    enn_le_mul_of_inv_mul_le (by norm_num) (by norm_num) hmain
  have hstep2 := mul_le_mul' (le_refl ((16 : ℝ≥0∞) ^ (360 : ℕ))) hstep1
  have hLHS : (16 : ℝ≥0∞) ^ (360 : ℕ) * (ENNReal.ofReal N ^ (10 : ℕ) * K ^ (60 : ℕ))
      = ENNReal.ofReal N ^ (244 : ℕ)
        * (ENNReal.ofReal N ^ (6 : ℕ) * (∫⁻ y in S, ‖A N (indicators F) y‖ₑ) ^ (60 : ℕ)) := by
    calc (16 : ℝ≥0∞) ^ (360 : ℕ) * (ENNReal.ofReal N ^ (10 : ℕ) * K ^ (60 : ℕ))
        = ((16 : ℝ≥0∞) ^ (6 : ℕ)) ^ (60 : ℕ) * K ^ (60 : ℕ)
            * ENNReal.ofReal N ^ (10 : ℕ) := by
          rw [← pow_mul]
          ring
      _ = ((16 : ℝ≥0∞) ^ (6 : ℕ) * K) ^ (60 : ℕ) * ENNReal.ofReal N ^ (10 : ℕ) := by
          rw [mul_pow]
      _ = ((∫⁻ y in S, ‖A N (indicators F) y‖ₑ) * ENNReal.ofReal N ^ (4 : ℕ)) ^ (60 : ℕ)
            * ENNReal.ofReal N ^ (10 : ℕ) := by rw [hKmul]
      _ = ENNReal.ofReal N ^ (244 : ℕ)
            * (ENNReal.ofReal N ^ (6 : ℕ)
              * (∫⁻ y in S, ‖A N (indicators F) y‖ₑ) ^ (60 : ℕ)) := by
          rw [mul_pow, ← pow_mul]
          ring
  have hRHS : (16 : ℝ≥0∞) ^ (360 : ℕ) * (2 ^ (19 : ℕ)
        * ((volume S * ENNReal.ofReal N ^ (4 : ℕ)) ^ (10 : ℕ)
          * (volume (F j) * (8 * ENNReal.ofReal N ^ (4 : ℕ))) ^ (30 : ℕ)
          * (volume (F m) * (8 * ENNReal.ofReal N ^ (4 : ℕ))) ^ (11 : ℕ)
          * (volume (F k) * (8 * ENNReal.ofReal N ^ (4 : ℕ))) ^ (10 : ℕ)))
      = ENNReal.ofReal N ^ (244 : ℕ) * (2 ^ (19 : ℕ) * 8 ^ (51 : ℕ) * 16 ^ (360 : ℕ)
          * (volume S ^ (10 : ℕ) * volume (F j) ^ (30 : ℕ) * volume (F m) ^ (11 : ℕ)
            * volume (F k) ^ (10 : ℕ))) := by
    simp only [mul_pow, ← pow_mul]
    ring
  rw [hLHS, hRHS] at hstep2
  exact enn_le_of_mul_le_mul (pow_ne_zero _ hν0) (ENNReal.pow_ne_top hνt) hstep2


/-! ### Blueprint `prop:restricted-improving-vertex`: measurability and the `L^1` bound

The average of indicators is measurable and its integral over the whole space is at most the
measure of any one of the three sets, so all its level sets at a positive height have finite
measure. This is what the restricted weak estimate needs in order to be tested on level sets. -/

open MeasureTheory in
theorem measurable_prod_indicator_shift {F : Fin 3 → Set E3} (hF : ∀ i, MeasurableSet (F i)) :
    Measurable fun p : E3 × ℝ =>
      ∏ i, Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (p.1 + curve i p.2) :=
  Finset.measurable_prod _ fun i _ =>
    (measurable_const.indicator (hF i)).comp
      (measurable_fst.add ((continuous_curve i).measurable.comp measurable_snd))

open MeasureTheory in
/-- **The modulus of the average of indicators is measurable.** -/
theorem measurable_enorm_A_indicators {N : ℝ} (hN : 0 < N) {F : Fin 3 → Set E3}
    (hF : ∀ i, MeasurableSet (F i)) : Measurable fun x => ‖A N (indicators F) x‖ₑ := by
  have heq : (fun x => ‖A N (indicators F) x‖ₑ)
      = fun x => ENNReal.ofReal N⁻¹ * ∫⁻ t in Set.Ioc (0 : ℝ) N,
          ∏ i, Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (x + curve i t) :=
    funext fun x => enorm_A_indicators hN hF x
  rw [heq]
  exact measurable_const.mul ((measurable_prod_indicator_shift hF).lintegral_prod_right')

open MeasureTheory in
/-- **The `L^1` bound.** The average of indicators integrates to at most the measure of any one
of the three sets. -/
theorem lintegral_enorm_A_le_volume {N : ℝ} (hN : 0 < N) {F : Fin 3 → Set E3}
    (hF : ∀ i, MeasurableSet (F i)) (i : Fin 3) :
    (∫⁻ x, ‖A N (indicators F) x‖ₑ) ≤ volume (F i) := by
  have hfib : ∀ t : ℝ, (∫⁻ x, ∏ i, Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (x + curve i t))
      ≤ volume (F i) := by
    intro t
    calc (∫⁻ x, ∏ i', Set.indicator (F i') (fun _ => (1 : ℝ≥0∞)) (x + curve i' t))
        ≤ ∫⁻ x, Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (x + curve i t) := by
          refine lintegral_mono fun x => ?_
          rw [← Finset.mul_prod_erase Finset.univ
            (fun i' => Set.indicator (F i') (fun _ => (1 : ℝ≥0∞)) (x + curve i' t))
            (Finset.mem_univ i)]
          calc Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (x + curve i t)
                * ∏ i' ∈ Finset.univ.erase i,
                  Set.indicator (F i') (fun _ => (1 : ℝ≥0∞)) (x + curve i' t)
              ≤ Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (x + curve i t) * 1 :=
                mul_le_mul' le_rfl
                  (Finset.prod_le_one fun i' _ => indicator_one_le_one3 (F i') _)
            _ = Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (x + curve i t) := mul_one _
      _ = volume (F i) := by
          rw [lintegral_add_right_eq_self
            (fun x => Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) x) (curve i t),
            lintegral_indicator (hF i) _, setLIntegral_one]
  have hswap : (∫⁻ x, ‖A N (indicators F) x‖ₑ)
      = ENNReal.ofReal N⁻¹ * ∫⁻ t in Set.Ioc (0 : ℝ) N,
          ∫⁻ x, ∏ i, Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (x + curve i t) := by
    have hS : (MeasurableSet (Set.univ : Set E3)) := MeasurableSet.univ
    have h := lintegral_enorm_A_eq (S := Set.univ) hN hF
    simpa using h
  rw [hswap]
  calc ENNReal.ofReal N⁻¹ * ∫⁻ t in Set.Ioc (0 : ℝ) N,
        ∫⁻ x, ∏ i, Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (x + curve i t)
      ≤ ENNReal.ofReal N⁻¹ * ∫⁻ _t in Set.Ioc (0 : ℝ) N, volume (F i) :=
        mul_le_mul' le_rfl (lintegral_mono hfib)
    _ = ENNReal.ofReal N⁻¹ * (volume (F i) * ENNReal.ofReal N) := by
        rw [setLIntegral_const, Real.volume_Ioc, sub_zero]
    _ = volume (F i) := by
        rw [mul_comm (volume (F i)) (ENNReal.ofReal N), ← mul_assoc,
          ← ENNReal.ofReal_mul (by positivity), inv_mul_cancel₀ hN.ne',
          ENNReal.ofReal_one, one_mul]

open MeasureTheory in
/-- The level sets of the average of indicators, at a positive height, have finite measure. -/
theorem volume_level_A_ne_top {N : ℝ} (hN : 0 < N) {F : Fin 3 → Set E3}
    (hF : ∀ i, MeasurableSet (F i)) (hFt : ∀ i, volume (F i) ≠ ⊤) (lam : ℝ≥0∞) (hlam : lam ≠ 0) :
    volume {x : E3 | lam < ‖A N (indicators F) x‖ₑ} ≠ ⊤ := by
  intro htop
  have hSm : MeasurableSet {x : E3 | lam < ‖A N (indicators F) x‖ₑ} :=
    measurableSet_lt measurable_const (measurable_enorm_A_indicators hN hF)
  have hlow : lam * volume {x : E3 | lam < ‖A N (indicators F) x‖ₑ}
      ≤ ∫⁻ x, ‖A N (indicators F) x‖ₑ := by
    calc lam * volume {x : E3 | lam < ‖A N (indicators F) x‖ₑ}
        = ∫⁻ _x in {x : E3 | lam < ‖A N (indicators F) x‖ₑ}, lam := (setLIntegral_const _ _).symm
      _ ≤ ∫⁻ x in {x : E3 | lam < ‖A N (indicators F) x‖ₑ}, ‖A N (indicators F) x‖ₑ :=
          setLIntegral_mono' hSm fun x hx => le_of_lt hx
      _ ≤ ∫⁻ x, ‖A N (indicators F) x‖ₑ := setLIntegral_le_lintegral _ _
  rw [htop, ENNReal.mul_top hlam] at hlow
  exact (hFt 0) (top_le_iff.mp (le_trans hlow (lintegral_enorm_A_le_volume hN hF 0)))


/-! ### Blueprint `prop:restricted-improving-vertex`: the statement

"Taking the sixtieth root is exactly the restricted weak estimate."  The descent inequality is
homogeneous of degree `60`, so its sixtieth root is the pairing bound that the level-set test turns
into the weak quasi-norm estimate at the improving vertex, with constant `C N^{-1/10}`. -/

set_option exponentiation.threshold 400 in
/-- The constant of the improving vertex. -/
noncomputable def improvingConst : ℝ≥0∞ :=
  ((2 : ℝ≥0∞) ^ (19 : ℕ) * 8 ^ (51 : ℕ) * 16 ^ (360 : ℕ)) ^ ((60 : ℝ)⁻¹)

/-- The exponent vector of the improving vertex: `j` carries `L^{2,1}`, the terminal index
`m` carries `L^{60/11,1}`, and the remaining index carries `L^{6,1}`. -/
noncomputable def improvingExp (j m : Fin 3) : Fin 3 → ℝ :=
  fun i => if i = j then 1 / 2 else if i = m then 11 / 60 else 1 / 6

open MeasureTheory in
theorem prod_improvingExp {m j k : Fin 3} (hjm : j ≠ m) (hkm : k ≠ m) (hjk : j ≠ k)
    (F : Fin 3 → Set E3) :
    ∏ i, volume (F i) ^ improvingExp j m i
      = volume (F j) ^ ((1 : ℝ) / 2) * volume (F m) ^ ((11 : ℝ) / 60)
        * volume (F k) ^ ((1 : ℝ) / 6) := by
  fin_cases j <;> fin_cases m <;> fin_cases k <;>
    simp_all [improvingExp, Fin.prod_univ_three] <;> ring

set_option exponentiation.threshold 400 in
open MeasureTheory in
/-- **Blueprint `prop:restricted-improving-vertex`.** The restricted weak estimate
`L^{2,1} x L^{60/11,1} x L^{6,1} -> L^{6/5,infinity}` for the average `A_N`, with constant
`C N^{-1/10}`. -/
theorem restrictedWeak_A_improving {N : ℝ} (hN : 0 < N) {m j k : Fin 3}
    (hjm : j ≠ m) (hkm : k ≠ m) (hjk : j ≠ k) :
    RestrictedWeak (A N) (improvingExp j m) (6 / 5)
      (improvingConst * ENNReal.ofReal N ^ (-(1 : ℝ) / 10)) := by
  intro F hF hF0 hFt
  have hν0 : ENNReal.ofReal N ≠ 0 := (ENNReal.ofReal_pos.mpr hN).ne'
  have hνt : ENNReal.ofReal N ≠ ⊤ := ENNReal.ofReal_ne_top
  have hz : (0 : ℝ) ≤ (60 : ℝ)⁻¹ := by norm_num
  refine wnorm_le_of_setLIntegral (by norm_num) (measurable_enorm_A_indicators hN hF)
    (volume_level_A_ne_top hN hF hFt) ?_
  intro S hS hSt
  have hexp : (1 : ℝ) - 1 / (6 / 5) = 1 / 6 := by norm_num
  rw [hexp, prod_improvingExp hjm hkm hjk]
  rcases eq_or_ne (volume S) 0 with h0 | h0
  · rw [setLIntegral_measure_zero _ _ h0]
    simp
  have hkey := lintegral_enorm_A_pow_sixty_le hN hS h0 hSt hF hF0 hFt hjm hkm hjk
  have hroot := ENNReal.rpow_le_rpow hkey hz
  have e6 : ((6 : ℕ) : ℝ) * (60 : ℝ)⁻¹ = (1 : ℝ) / 10 := by norm_num
  have e60 : ((60 : ℕ) : ℝ) * (60 : ℝ)⁻¹ = (1 : ℝ) := by norm_num
  have e10 : ((10 : ℕ) : ℝ) * (60 : ℝ)⁻¹ = (1 : ℝ) / 6 := by norm_num
  have e30 : ((30 : ℕ) : ℝ) * (60 : ℝ)⁻¹ = (1 : ℝ) / 2 := by norm_num
  have e11 : ((11 : ℕ) : ℝ) * (60 : ℝ)⁻¹ = (11 : ℝ) / 60 := by norm_num
  have hLHS : (ENNReal.ofReal N ^ (6 : ℕ)
        * (∫⁻ y in S, ‖A N (indicators F) y‖ₑ) ^ (60 : ℕ)) ^ ((60 : ℝ)⁻¹)
      = ENNReal.ofReal N ^ ((1 : ℝ) / 10) * ∫⁻ y in S, ‖A N (indicators F) y‖ₑ := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ hz,
      ← ENNReal.rpow_natCast (ENNReal.ofReal N) 6, ← ENNReal.rpow_mul,
      ← ENNReal.rpow_natCast (∫⁻ y in S, ‖A N (indicators F) y‖ₑ) 60, ← ENNReal.rpow_mul,
      e6, e60, ENNReal.rpow_one]
  have hP : (volume S ^ (10 : ℕ) * volume (F j) ^ (30 : ℕ) * volume (F m) ^ (11 : ℕ)
        * volume (F k) ^ (10 : ℕ)) ^ ((60 : ℝ)⁻¹)
      = volume S ^ ((1 : ℝ) / 6) * volume (F j) ^ ((1 : ℝ) / 2)
        * volume (F m) ^ ((11 : ℝ) / 60) * volume (F k) ^ ((1 : ℝ) / 6) := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ hz, ENNReal.mul_rpow_of_nonneg _ _ hz,
      ENNReal.mul_rpow_of_nonneg _ _ hz,
      ← ENNReal.rpow_natCast (volume S) 10, ← ENNReal.rpow_mul,
      ← ENNReal.rpow_natCast (volume (F j)) 30, ← ENNReal.rpow_mul,
      ← ENNReal.rpow_natCast (volume (F m)) 11, ← ENNReal.rpow_mul,
      ← ENNReal.rpow_natCast (volume (F k)) 10, ← ENNReal.rpow_mul,
      e10, e30, e11]
  have hRHS : ((2 : ℝ≥0∞) ^ (19 : ℕ) * 8 ^ (51 : ℕ) * 16 ^ (360 : ℕ)
        * (volume S ^ (10 : ℕ) * volume (F j) ^ (30 : ℕ) * volume (F m) ^ (11 : ℕ)
          * volume (F k) ^ (10 : ℕ))) ^ ((60 : ℝ)⁻¹)
      = improvingConst * (volume S ^ ((1 : ℝ) / 6) * volume (F j) ^ ((1 : ℝ) / 2)
          * volume (F m) ^ ((11 : ℝ) / 60) * volume (F k) ^ ((1 : ℝ) / 6)) := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ hz, hP]
    rfl
  rw [hLHS, hRHS] at hroot
  have hmul := mul_le_mul' (le_refl (ENNReal.ofReal N ^ (-(1 : ℝ) / 10))) hroot
  have e0 : -(1 : ℝ) / 10 + (1 : ℝ) / 10 = 0 := by norm_num
  have hcan : ENNReal.ofReal N ^ (-(1 : ℝ) / 10)
      * (ENNReal.ofReal N ^ ((1 : ℝ) / 10) * ∫⁻ y in S, ‖A N (indicators F) y‖ₑ)
      = ∫⁻ y in S, ‖A N (indicators F) y‖ₑ := by
    rw [← mul_assoc, ← ENNReal.rpow_add _ _ hν0 hνt, e0, ENNReal.rpow_zero, one_mul]
  rw [hcan] at hmul
  calc (∫⁻ y in S, ‖A N (indicators F) y‖ₑ)
      ≤ ENNReal.ofReal N ^ (-(1 : ℝ) / 10)
        * (improvingConst * (volume S ^ ((1 : ℝ) / 6) * volume (F j) ^ ((1 : ℝ) / 2)
          * volume (F m) ^ ((11 : ℝ) / 60) * volume (F k) ^ ((1 : ℝ) / 6))) := hmul
    _ = improvingConst * ENNReal.ofReal N ^ (-(1 : ℝ) / 10)
        * (volume (F j) ^ ((1 : ℝ) / 2) * volume (F m) ^ ((11 : ℝ) / 60)
          * volume (F k) ^ ((1 : ℝ) / 6)) * volume S ^ ((1 : ℝ) / 6) := by ring


/-! ### Blueprint `thm:strong-real-improving`: the vertices available for the interpolation

The finite Marcinkiewicz lemma consumes restricted strong estimates at the eight cone vectors
around the target. Those are produced from the vertex estimates by convex combination, so the
first thing needed is the whole simplex of `L^1` vertices, and the monotonicity of a restricted
estimate in its constant. -/
theorem RestrictedStrong.mono_const {T : (Fin 3 → E3 → ℂ) → E3 → ℂ} {r : Fin 3 → ℝ} {q : ℝ}
    {C C' : ℝ≥0∞} (h : RestrictedStrong T r q C) (hC : C ≤ C') :
    RestrictedStrong T r q C' :=
  fun E hE hE0 hEtop => le_trans (h E hE hE0 hEtop) (mul_le_mul' hC le_rfl)

theorem RestrictedWeak.mono_const {T : (Fin 3 → E3 → ℂ) → E3 → ℂ} {r : Fin 3 → ℝ} {q : ℝ}
    {C C' : ℝ≥0∞} (h : RestrictedWeak T r q C) (hC : C ≤ C') :
    RestrictedWeak T r q C' :=
  fun E hE hE0 hEtop => le_trans (h E hE hE0 hEtop) (mul_le_mul' hC le_rfl)

open MeasureTheory in
/-- **The restricted strong `L^1` estimate at every point of the simplex.** The three trivial
vertices `L^1 x L^infinity x L^infinity -> L^1` convex-combine to any nonnegative weight vector of
total mass one, with constant `1`. -/
theorem restrictedStrong_A_simplex {N : ℝ} (hN : 0 < N) {w : Fin 3 → ℝ}
    (hw : ∀ i, 0 ≤ w i) (hsum : w 0 + w 1 + w 2 = 1) :
    RestrictedStrong (A N) w 1 1 := by
  set t : ℝ := w 1 + w 2 with ht
  have ht0 : 0 ≤ t := add_nonneg (hw 1) (hw 2)
  have ht1 : t ≤ 1 := by
    rw [ht]
    linarith [hw 0, hsum]
  rcases eq_or_lt_of_le ht0 with hteq | htpos
  · have hw1 : w 1 = 0 := by
      have h : w 1 + w 2 = 0 := by rw [← ht, ← hteq]
      linarith [hw 1, hw 2]
    have hw2 : w 2 = 0 := by
      have h : w 1 + w 2 = 0 := by rw [← ht, ← hteq]
      linarith [hw 1, hw 2]
    have hw0 : w 0 = 1 := by linarith [hsum]
    refine (restrictedStrong_A_one hN 0).congr ?_ rfl
    funext i
    fin_cases i <;> simp [trivialVertex] <;> linarith
  · set s : ℝ := w 2 / t with hs
    have hs0 : 0 ≤ s := div_nonneg (hw 2) htpos.le
    have hs1 : s ≤ 1 := by
      rw [hs, div_le_one htpos, ht]
      linarith [hw 1]
    have hw2t : s * t = w 2 := by
      rw [hs]
      field_simp
    have hw1t : (1 - s) * t = w 1 := by
      have hexp : (1 - s) * t = t - s * t := by ring
      rw [hexp, hw2t, ht]
      ring
    have h12 := restrictedStrong_combine (T := A N) (θ := s) hs0 hs1
      (restrictedStrong_A_one hN 1) (restrictedStrong_A_one hN 2)
    have h := restrictedStrong_combine (T := A N) (θ := t) ht0 ht1
      (restrictedStrong_A_one hN 0) h12
    refine h.congr ?_ (by simp)
    funext i
    fin_cases i <;> simp [trivialVertex] <;> linarith


/-! ### Blueprint `thm:strong-real-improving`: the average is admissible

The interpolation lemma is stated for an abstract operator satisfying `Auto.Admissible`. The
average `A_N` satisfies it: trilinearity on bounded measurable slots, monotonicity, the null slot,
measurability, monotone limits, and the domination of a complex input by its modulus. -/
theorem prodShift_update (g : Fin 3 → E3 → ℂ) (i : Fin 3) (h : E3 → ℂ) (x : E3) (t : ℝ) :
    prodShift (Function.update g i h) x t
      = h (x + curve i t) * ∏ l ∈ Finset.univ.erase i, g l (x + curve l t) := by
  rw [prodShift, ← Finset.mul_prod_erase Finset.univ
    (fun l => Function.update g i h l (x + curve l t)) (Finset.mem_univ i),
    Function.update_self]
  congr 1
  refine Finset.prod_congr rfl fun l hl => ?_
  rw [Function.update_of_ne (Finset.ne_of_mem_erase hl)]

open MeasureTheory in
/-- A bounded measurable slot against the remaining ones is interval integrable. -/
theorem intervalIntegrable_slot {g : Fin 3 → E3 → ℂ} (hg : ∀ l, BddMeasC (g l))
    {u : E3 → ℂ} (hu : BddMeasC u) (i : Fin 3) (x : E3) (a b : ℝ) :
    IntervalIntegrable (fun t => u (x + curve i t)
      * ∏ l ∈ Finset.univ.erase i, g l (x + curve l t)) volume a b := by
  classical
  obtain ⟨hum, Cu, hCu⟩ := hu
  choose Cg hCg using fun l : Fin 3 => (hg l).2
  have hmeas : Measurable fun t => u (x + curve i t)
      * ∏ l ∈ Finset.univ.erase i, g l (x + curve l t) := by
    refine (hum.comp (measurable_const.add (continuous_curve i).measurable)).mul ?_
    exact Finset.measurable_prod _ fun l _ =>
      (hg l).1.comp (measurable_const.add (continuous_curve l).measurable)
  have hb : ∀ t : ℝ, ‖u (x + curve i t)
      * ∏ l ∈ Finset.univ.erase i, g l (x + curve l t)‖
        ≤ Cu * ∏ l ∈ Finset.univ.erase i, Cg l := by
    intro t
    rw [norm_mul, norm_prod]
    refine mul_le_mul (hCu _)
      (Finset.prod_le_prod₀ (fun l _ => norm_nonneg _) fun l _ => hCg l _)
      (Finset.prod_nonneg fun l _ => norm_nonneg _)
      (le_trans (norm_nonneg _) (hCu (x + curve i 0)))
  rw [intervalIntegrable_iff]
  exact Measure.integrableOn_of_bounded measure_Ioc_lt_top.ne hmeas.aestronglyMeasurable
    (Filter.Eventually.of_forall fun t => hb t)

open MeasureTheory in
/-- **The average is trilinear on bounded measurable slots.** -/
theorem trilin_A (N : ℝ) : Trilin (A N) := by
  classical
  intro i g u v c hg hu hv
  funext x
  simp only [A]
  simp_rw [prodShift_update]
  have hring : ∀ t : ℝ, (c * u (x + curve i t) + v (x + curve i t))
        * ∏ l ∈ Finset.univ.erase i, g l (x + curve l t)
      = c * (u (x + curve i t) * ∏ l ∈ Finset.univ.erase i, g l (x + curve l t))
        + v (x + curve i t) * ∏ l ∈ Finset.univ.erase i, g l (x + curve l t) := by
    intro t
    ring
  simp_rw [hring]
  rw [intervalIntegral.integral_add ((intervalIntegrable_slot hg hu i x 0 N).const_mul c)
    (intervalIntegrable_slot hg hv i x 0 N), intervalIntegral.integral_const_mul]
  ring

open MeasureTheory in
/-- **A complex input is dominated by its modulus.** -/
theorem modC_A {N : ℝ} (hN : 0 ≤ N) (f : Fin 3 → E3 → ℂ) (x : E3) :
    ‖A N f x‖ ≤ ‖A N (fun i y => ((‖f i y‖ : ℝ) : ℂ)) x‖ := by
  set w : Fin 3 → E3 → ℝ := fun i y => ‖f i y‖ with hw
  have hnn : ∀ (i : Fin 3) (y : E3), 0 ≤ w i y := fun i y => norm_nonneg _
  have hnorm : ∀ t : ℝ, ‖prodShift f x t‖ = prodShiftR w x t := by
    intro t
    rw [prodShift, prodShiftR, norm_prod]
  have hI0 : 0 ≤ ∫ t in (0 : ℝ)..N, prodShiftR w x t :=
    intervalIntegral.integral_nonneg hN fun t _ => prodShiftR_nonneg hnn x t
  have hle : ‖∫ t in (0 : ℝ)..N, prodShift f x t‖ ≤ ∫ t in (0 : ℝ)..N, prodShiftR w x t := by
    refine le_trans (intervalIntegral.norm_integral_le_integral_norm hN) (le_of_eq ?_)
    exact intervalIntegral.integral_congr fun t _ => hnorm t
  rw [A, A_ofReal, norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hI0]
  exact mul_le_mul_of_nonneg_left hle (norm_nonneg _)


open MeasureTheory in
/-- The average of measurable data is measurable: the parameter integral of a jointly measurable
integrand. -/
theorem measurable_intervalIntegral_prodShiftR {N : ℝ} (hN : 0 ≤ N) {u : Fin 3 → E3 → ℝ}
    (hu : ∀ i, Measurable (u i)) :
    Measurable fun x => ∫ t in (0 : ℝ)..N, prodShiftR u x t := by
  have hm : Measurable fun p : E3 × ℝ => prodShiftR u p.1 p.2 := by
    simp only [prodShiftR]
    exact Finset.measurable_prod _ fun i _ =>
      (hu i).comp (measurable_fst.add ((continuous_curve i).measurable.comp measurable_snd))
  have heq : (fun x => ∫ t in (0 : ℝ)..N, prodShiftR u x t)
      = fun x => ∫ t in Set.Ioc (0 : ℝ) N, prodShiftR u x t := by
    funext x
    exact intervalIntegral.integral_of_le hN
  rw [heq]
  exact hm.stronglyMeasurable.integral_prod_right'.measurable

open MeasureTheory in
/-- **The average of measurable nonnegative data is measurable.** -/
theorem measFun_A {N : ℝ} (hN : 0 ≤ N) (u : Fin 3 → E3 → ℝ) (hum : ∀ i, Measurable (u i)) :
    Measurable (A N fun i y => ((u i y : ℝ) : ℂ)) := by
  have heq : (A N fun i y => ((u i y : ℝ) : ℂ))
      = fun x => (N : ℂ)⁻¹ * ((∫ t in (0 : ℝ)..N, prodShiftR u x t : ℝ) : ℂ) := by
    funext x
    exact A_ofReal u x
  rw [heq]
  exact measurable_const.mul
    (Complex.measurable_ofReal.comp (measurable_intervalIntegral_prodShiftR hN hum))

open MeasureTheory in
/-- **The average of indicators of measurable sets is measurable.** -/
theorem measInd_A {N : ℝ} (hN : 0 ≤ N) (E : Fin 3 → Set E3) (hE : ∀ i, MeasurableSet (E i)) :
    AEStronglyMeasurable (A N (indicators E)) volume := by
  rw [indicators_eq_ofReal]
  exact (measFun_A hN _ fun i => measurable_const.indicator (hE i)).aestronglyMeasurable

open MeasureTheory in
/-- **A null slot kills the average.** The fibre of a null set over almost every point is null,
so the product of indicators vanishes almost everywhere on the parameter interval. -/
theorem null3_A {N : ℝ} (hN : 0 ≤ N) : Null3 (A N) := by
  intro E hE
  obtain ⟨i, hi⟩ := hE
  obtain ⟨F, hEF, hFm, hF0⟩ := exists_measurable_superset_of_null hi
  have hjoint : Measurable fun p : E3 × ℝ =>
      Set.indicator F (fun _ => (1 : ℝ≥0∞)) (p.1 + curve i p.2) :=
    (measurable_const.indicator hFm).comp
      (measurable_fst.add ((continuous_curve i).measurable.comp measurable_snd))
  have hslice : ∀ t : ℝ, (∫⁻ x, Set.indicator F (fun _ => (1 : ℝ≥0∞)) (x + curve i t)) = 0 := by
    intro t
    rw [lintegral_add_right_eq_self (fun x => Set.indicator F (fun _ => (1 : ℝ≥0∞)) x)
      (curve i t), lintegral_indicator hFm _, setLIntegral_one, hF0]
  have htot : (∫⁻ x, ∫⁻ t in Set.Ioc (0 : ℝ) N,
      Set.indicator F (fun _ => (1 : ℝ≥0∞)) (x + curve i t)) = 0 := by
    rw [lintegral_lintegral_swap hjoint.aemeasurable]
    simp only [hslice]
    simp
  have hae := (lintegral_eq_zero_iff hjoint.lintegral_prod_right').mp htot
  filter_upwards [hae] with x hx
  have hx0 : (fun t => Set.indicator F (fun _ => (1 : ℝ≥0∞)) (x + curve i t))
      =ᵐ[volume.restrict (Set.Ioc (0 : ℝ) N)] 0 :=
    (lintegral_eq_zero_iff (hjoint.comp (measurable_const.prodMk measurable_id))).mp hx
  have hzero : ∀ᵐ t ∂(volume.restrict (Set.Ioc (0 : ℝ) N)),
      prodShift (indicators E) x t = 0 := by
    filter_upwards [hx0] with t ht
    have hnot : x + curve i t ∉ F := by
      intro hmem
      rw [Set.indicator_of_mem hmem] at ht
      exact one_ne_zero ht
    have hzeroi : indicators E i (x + curve i t) = 0 := by
      rw [indicators, Set.indicator_of_notMem fun hc => hnot (hEF hc)]
    rw [prodShift, Finset.prod_eq_zero (Finset.mem_univ i) hzeroi]
  have hI : (∫ t in (0 : ℝ)..N, prodShift (indicators E) x t) = 0 := by
    rw [intervalIntegral.integral_of_le hN]
    exact integral_eq_zero_of_ae hzero
  rw [Pi.zero_apply, A, hI, mul_zero]

open MeasureTheory in
/-- **Monotone limits.** Where the limiting integrand is integrable this is dominated
convergence; where it is not, the average of the limit vanishes by the convention on
non-integrable Bochner integrals, which is the second alternative of `Auto.Lim3`. -/
theorem lim3_A {N : ℝ} (hN : 0 ≤ N) : Lim3 (A N) := by
  intro uu v huu hvm hvn hle htend x
  have huun : ∀ (k : ℕ) (i : Fin 3) (y : E3), 0 ≤ uu k i y := fun k i y => (huu k i).2.1 y
  by_cases hint : IntervalIntegrable (prodShiftR v x) volume 0 N
  · left
    have hcast : ∀ u : Fin 3 → E3 → ℝ, (A N fun i y => ((u i y : ℝ) : ℂ)) x
        = (N : ℂ)⁻¹ * ((∫ t in (0 : ℝ)..N, prodShiftR u x t : ℝ) : ℂ) := fun u => A_ofReal u x
    simp only [hcast]
    refine Filter.Tendsto.const_mul _ (Complex.continuous_ofReal.continuousAt.tendsto.comp ?_)
    rw [intervalIntegral.integral_of_le hN]
    have hdom : Integrable (prodShiftR v x) (volume.restrict (Set.Ioc (0 : ℝ) N)) :=
      (intervalIntegrable_iff_integrableOn_Ioc_of_le hN).mp hint
    have hmeask : ∀ k, AEStronglyMeasurable (prodShiftR (uu k) x)
        (volume.restrict (Set.Ioc (0 : ℝ) N)) := fun k =>
      (measurable_prodShiftR (fun i => (huu k i).1) x).aestronglyMeasurable
    have hbound : ∀ k, ∀ᵐ t ∂(volume.restrict (Set.Ioc (0 : ℝ) N)),
        ‖prodShiftR (uu k) x t‖ ≤ prodShiftR v x t := by
      intro k
      refine Filter.Eventually.of_forall fun t => ?_
      rw [Real.norm_eq_abs, abs_of_nonneg (prodShiftR_nonneg (huun k) x t)]
      exact Finset.prod_le_prod₀ (fun l _ => huun k l _) fun l _ => hle k l _
    have hlim : ∀ᵐ t ∂(volume.restrict (Set.Ioc (0 : ℝ) N)),
        Filter.Tendsto (fun k => prodShiftR (uu k) x t) Filter.atTop
          (nhds (prodShiftR v x t)) := by
      refine Filter.Eventually.of_forall fun t => ?_
      simp only [prodShiftR]
      exact tendsto_finsetProd _ fun l _ => htend l _
    have := MeasureTheory.tendsto_integral_of_dominated_convergence _ hmeask hdom hbound hlim
    simpa [intervalIntegral.integral_of_le hN] using this
  · right
    rw [A_ofReal v x, intervalIntegral.integral_undef hint]
    simp

open MeasureTheory in
/-- **The average is admissible.** This discharges the hypothesis of
`Auto.finite_marcinkiewicz` for `A_N`. -/
theorem admissible_A {N : ℝ} (hN : 0 ≤ N) : Admissible (A N) where
  lin := trilin_A N
  mono := mono3_A hN
  null := null3_A hN
  measInd := measInd_A hN
  measFun := fun u hum _ => measFun_A hN u hum
  limit := lim3_A hN
  measComplex := fun _ hf => measurable_A hN hf
  modC := fun f _ x => modC_A hN f x


/-! ### Blueprint `thm:strong-real-improving`: one chain at `N = 1`

The interpolation is run at `N = 1`, where every constant is absolute; the factor `N^{-1/20}` is
recovered afterwards by the anisotropic dilation. Each cone vector is written as a chain: a weight
vector of the `L^1` simplex, the improving vertex, and the `L^infinity` vertex. -/
theorem improvingVertex_base_ne_top :
    ((2 : ℝ≥0∞) ^ (19 : ℕ) * 8 ^ (51 : ℕ) * 16 ^ (360 : ℕ)) ≠ ⊤ :=
  ENNReal.mul_ne_top (ENNReal.mul_ne_top (ENNReal.pow_ne_top (by norm_num))
    (ENNReal.pow_ne_top (by norm_num))) (ENNReal.pow_ne_top (by norm_num))

theorem improvingVertex_base_ne_zero :
    ((2 : ℝ≥0∞) ^ (19 : ℕ) * 8 ^ (51 : ℕ) * 16 ^ (360 : ℕ)) ≠ 0 :=
  mul_ne_zero (mul_ne_zero (pow_ne_zero _ (by norm_num)) (pow_ne_zero _ (by norm_num)))
    (pow_ne_zero _ (by norm_num))

theorem improvingConst_ne_top : improvingConst ≠ ⊤ :=
  ENNReal.rpow_ne_top_of_nonneg (by norm_num) improvingVertex_base_ne_top

theorem improvingConst_ne_zero : improvingConst ≠ 0 :=
  (ENNReal.rpow_pos (pos_iff_ne_zero.mpr improvingVertex_base_ne_zero)
    improvingVertex_base_ne_top).ne'

/-- The improving exponent vector with `j = 0` and terminal index `1` is `improvingVertex`. -/
theorem improvingExp_zero_one : improvingExp 0 1 = improvingVertex := by
  funext i
  fin_cases i <;> simp [improvingExp, improvingVertex]

/-- The constant produced by one chain at `N = 1`. -/
noncomputable def chainConst (θ qm : ℝ) : ℝ≥0∞ :=
  ENNReal.ofReal ((6 / 5) / ((6 : ℝ) / 5 - qm)) ^ (1 / ((6 : ℝ) / 5))
    * ((ENNReal.ofReal (qm / (qm - 1) + qm / ((6 : ℝ) / 5 - qm)) ^ (1 / qm)
        * ((1 : ℝ≥0∞) ^ (1 - θ) * improvingConst ^ θ)) ^ (qm / ((6 : ℝ) / 5))
      * (1 : ℝ≥0∞) ^ (((6 : ℝ) / 5 - qm) / ((6 : ℝ) / 5)))

theorem chainConst_ne_top {θ qm : ℝ} (hθ0 : 0 ≤ θ) (hqm0 : 1 < qm) :
    chainConst θ qm ≠ ⊤ := by
  have hqmpos : (0 : ℝ) < qm := by linarith
  rw [chainConst]
  refine ENNReal.mul_ne_top
    (ENNReal.rpow_ne_top_of_nonneg (by norm_num) ENNReal.ofReal_ne_top) ?_
  refine ENNReal.mul_ne_top ?_ (by simp)
  refine ENNReal.rpow_ne_top_of_nonneg (by positivity) ?_
  refine ENNReal.mul_ne_top
    (ENNReal.rpow_ne_top_of_nonneg (by positivity) ENNReal.ofReal_ne_top) ?_
  exact ENNReal.mul_ne_top (by simp) (ENNReal.rpow_ne_top_of_nonneg hθ0 improvingConst_ne_top)

