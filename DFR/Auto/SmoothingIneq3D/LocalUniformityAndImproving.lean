/-! ## Blueprint `def:local-uniformity`: Fejer differences

The Fejer kernel `kappa_H(h) = H⁻¹ (1 - |h|/H)_+` and the difference operator
`Delta_{h;v} f(x) = f(x + h v) * conj (f x)`.  The blueprint's "the Fejer kernel is nonnegative and
has integral one" is proved here; it is what makes the local uniformity norms averages against a
probability density. -/

/-- The Fejer kernel of `def:local-uniformity`. -/
noncomputable def fejer (H h : ℝ) : ℝ := H⁻¹ * max (1 - |h| / H) 0

theorem fejer_nonneg {H : ℝ} (hH : 0 < H) (h : ℝ) : 0 ≤ fejer H h := by
  refine mul_nonneg (le_of_lt (inv_pos.mpr hH)) (le_max_right _ _)

/-- The kernel vanishes outside the interval of length `2H`. -/
theorem fejer_eq_zero_of_le {H h : ℝ} (hH : 0 < H) (hh : H ≤ |h|) : fejer H h = 0 := by
  have : 1 - |h| / H ≤ 0 := by
    rw [sub_nonpos, le_div_iff₀ hH]
    linarith
  rw [fejer, max_eq_right this, mul_zero]

theorem continuous_fejer {H : ℝ} : Continuous (fejer H) := by
  refine continuous_const.mul (Continuous.max ?_ continuous_const)
  exact continuous_const.sub (continuous_abs.div_const H)

/-- On the interval of its support the kernel is the linear tent. -/
theorem fejer_eq_of_mem {H h : ℝ} (hH : 0 < H) (hh : |h| ≤ H) :
    fejer H h = H⁻¹ * (1 - |h| / H) := by
  have : 0 ≤ 1 - |h| / H := by
    rw [sub_nonneg, div_le_one hH]
    exact hh
  rw [fejer, max_eq_left this]

open MeasureTheory in
theorem integral_affine (c d a b : ℝ) :
    (∫ x in a..b, (c + d * x)) = c * (b - a) + d * ((b ^ 2 - a ^ 2) / 2) := by
  have h1 : IntervalIntegrable (fun _ : ℝ => c) volume a b := intervalIntegrable_const
  have h2 : IntervalIntegrable (fun x : ℝ => d * x) volume a b :=
    (continuous_const.mul continuous_id).intervalIntegrable _ _
  rw [intervalIntegral.integral_add h1 h2, intervalIntegral.integral_const,
    intervalIntegral.integral_const_mul, integral_id, smul_eq_mul]
  ring

open MeasureTheory in
/-- **The Fejer kernel has integral one.** -/
theorem integral_fejer {H : ℝ} (hH : 0 < H) : ∫ h : ℝ, fejer H h = 1 := by
  have hne : H ≠ 0 := hH.ne'
  have hzero : ∀ h : ℝ, h ∉ Set.Ioc (-H) H → fejer H h = 0 := by
    intro h hh
    refine fejer_eq_zero_of_le hH ?_
    rcases le_or_gt (0 : ℝ) h with hpos | hneg
    · rw [abs_of_nonneg hpos]
      by_contra hcon
      exact hh ⟨by linarith, by linarith⟩
    · rw [abs_of_neg hneg]
      by_contra hcon
      exact hh ⟨by linarith, by linarith⟩
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero hzero,
    ← intervalIntegral.integral_of_le (by linarith : (-H : ℝ) ≤ H)]
  have hsplit : (∫ h in (-H)..H, fejer H h)
      = (∫ h in (-H)..(0 : ℝ), fejer H h) + ∫ h in (0 : ℝ)..H, fejer H h :=
    (intervalIntegral.integral_add_adjacent_intervals
      (continuous_fejer.intervalIntegrable _ _) (continuous_fejer.intervalIntegrable _ _)).symm
  have hleft : (∫ h in (-H)..(0 : ℝ), fejer H h) = 1 / 2 := by
    have hcongr : Set.EqOn (fejer H) (fun h => H⁻¹ + H⁻¹ * H⁻¹ * h) (Set.uIcc (-H) (0 : ℝ)) := by
      intro h hh
      rw [Set.uIcc_of_le (by linarith : (-H : ℝ) ≤ 0)] at hh
      have habs : |h| = -h := abs_of_nonpos hh.2
      rw [fejer_eq_of_mem hH (by rw [habs]; linarith [hh.1]), habs]
      field_simp
      ring
    rw [intervalIntegral.integral_congr hcongr, integral_affine]
    field_simp
    ring
  have hright : (∫ h in (0 : ℝ)..H, fejer H h) = 1 / 2 := by
    have hcongr : Set.EqOn (fejer H) (fun h => H⁻¹ + -(H⁻¹ * H⁻¹) * h) (Set.uIcc (0 : ℝ) H) := by
      intro h hh
      rw [Set.uIcc_of_le hH.le] at hh
      have habs : |h| = h := abs_of_nonneg hh.1
      rw [fejer_eq_of_mem hH (by rw [habs]; linarith [hh.2]), habs]
      field_simp
      ring
    rw [intervalIntegral.integral_congr hcongr, integral_affine]
    field_simp
    ring
  rw [hsplit, hleft, hright]
  norm_num

/-! ### The difference operator -/

/-- The Fejer difference `Delta_{h;v} f (x) = f (x + h v) * conj (f x)`. -/
noncomputable def fdiff (v : E3) (h : ℝ) (f : E3 → ℂ) (x : E3) : ℂ :=
  f (x + h • v) * (starRingEnd ℂ) (f x)

theorem fdiff_zero_shift (v : E3) (f : E3 → ℂ) (x : E3) :
    fdiff v 0 f x = f x * (starRingEnd ℂ) (f x) := by
  rw [fdiff, zero_smul, add_zero]

theorem norm_fdiff_le (v : E3) (h : ℝ) {f : E3 → ℂ} (hf : ∀ y, ‖f y‖ ≤ 1) (x : E3) :
    ‖fdiff v h f x‖ ≤ 1 := by
  rw [fdiff, norm_mul, RCLike.norm_conj]
  exact ((mul_le_of_le_one_left (norm_nonneg _) (hf _)).trans (hf x))

/-- The iterated Fejer difference `Delta_{h_1;v} ... Delta_{h_s;v} f`. -/
noncomputable def fdiffIter (v : E3) : ∀ s : ℕ, (Fin s → ℝ) → (E3 → ℂ) → E3 → ℂ
  | 0, _, f => f
  | (s + 1), h, f => fdiff v (h 0) (fdiffIter v s (fun i => h i.succ) f)

theorem fdiffIter_zero (v : E3) (h : Fin 0 → ℝ) (f : E3 → ℂ) :
    fdiffIter v 0 h f = f := rfl

theorem fdiffIter_succ (v : E3) (s : ℕ) (h : Fin (s + 1) → ℝ) (f : E3 → ℂ) :
    fdiffIter v (s + 1) h f = fdiff v (h 0) (fdiffIter v s (fun i => h i.succ) f) := rfl

theorem norm_fdiffIter_le (v : E3) : ∀ (s : ℕ) (h : Fin s → ℝ) {f : E3 → ℂ},
    (∀ y, ‖f y‖ ≤ 1) → ∀ x, ‖fdiffIter v s h f x‖ ≤ 1
  | 0, _, _, hf, x => hf x
  | (s + 1), h, f, hf, x => by
      rw [fdiffIter_succ]
      exact norm_fdiff_le v (h 0) (fun y => norm_fdiffIter_le v s _ hf y) x


/-! ### Blueprint `def:local-uniformity`: the cube expansion

"Repeatedly expanding `Delta_{h;v}` shows that the last integrand is
`prod over omega in {0,1}^s of C^|omega| f(x + (omega . h) e_j)`."  With the convention
`Delta_{h;v} f (x) = f (x + h v) * conj (f x)` of `Auto.fdiff`, the conjugation sits on the
vertices where `omega` is zero rather than where it is one, so the product below is the
complementary labelling of the blueprint's; the two are complex conjugates of each other, and both
enter only through the fact that the integral is real. -/

/-- Conjugate when the count is odd. -/
noncomputable def conjPar (n : ℕ) (z : ℂ) : ℂ := if Even n then z else (starRingEnd ℂ) z

theorem conjPar_zero (z : ℂ) : conjPar 0 z = z := by simp [conjPar]

theorem conjPar_succ (n : ℕ) (z : ℂ) : conjPar (n + 1) z = (starRingEnd ℂ) (conjPar n z) := by
  by_cases h : Even n
  · simp [conjPar, h, Nat.even_add_one]
  · simp [conjPar, h, Nat.even_add_one]

theorem norm_conjPar (n : ℕ) (z : ℂ) : ‖conjPar n z‖ = ‖z‖ := by
  by_cases h : Even n <;> simp [conjPar, h]

/-- The number of zero coordinates of a vertex of the cube. -/
def numFalse {s : ℕ} (ω : Fin s → Bool) : ℕ := ∑ i, if ω i then 0 else 1

/-- The shift attached to a vertex of the cube. -/
def cubeShift {s : ℕ} (h : Fin s → ℝ) (ω : Fin s → Bool) : ℝ := ∑ i, if ω i then h i else 0

theorem numFalse_cons {s : ℕ} (b : Bool) (σ : Fin s → Bool) :
    numFalse (Fin.cons b σ) = (if b then 0 else 1) + numFalse σ := by
  rw [numFalse, numFalse, Fin.sum_univ_succ]
  simp

theorem cubeShift_cons {s : ℕ} (h : Fin (s + 1) → ℝ) (b : Bool) (σ : Fin s → Bool) :
    cubeShift h (Fin.cons b σ) = (if b then h 0 else 0) + cubeShift (fun i => h i.succ) σ := by
  rw [cubeShift, cubeShift, Fin.sum_univ_succ]
  simp

/-- Splitting a vertex of the `(s+1)`-cube into its first coordinate and the rest. -/
def consBoolEquiv (s : ℕ) : Bool × (Fin s → Bool) ≃ (Fin (s + 1) → Bool) where
  toFun p := Fin.cons p.1 p.2
  invFun ω := (ω 0, fun i => ω i.succ)
  left_inv p := by
    ext <;> simp
  right_inv ω := by
    funext i
    induction i using Fin.cases with
    | zero => simp
    | succ j => simp

/-- **The cube expansion of the iterated Fejer difference.** -/
theorem fdiffIter_eq_cubeProd (v : E3) : ∀ (s : ℕ) (h : Fin s → ℝ) (f : E3 → ℂ) (x : E3),
    fdiffIter v s h f x
      = ∏ ω : Fin s → Bool, conjPar (numFalse ω) (f (x + cubeShift h ω • v))
  | 0, h, f, x => by
      rw [fdiffIter_zero, Fintype.prod_unique]
      simp [numFalse, cubeShift, conjPar]
  | (s + 1), h, f, x => by
      have ih := fun y : E3 => fdiffIter_eq_cubeProd v s (fun i => h i.succ) f y
      rw [fdiffIter_succ, fdiff, ih (x + h 0 • v), ih x, map_prod, ← Finset.prod_mul_distrib,
        ← (consBoolEquiv s).prod_comp
          fun ω => conjPar (numFalse ω) (f (x + cubeShift h ω • v)),
        Fintype.prod_prod_type, Fintype.prod_bool, ← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl fun σ _ => ?_
      have hct : numFalse (Fin.cons true σ) = numFalse σ := by
        rw [numFalse_cons]
        simp
      have hcf : numFalse (Fin.cons false σ) = numFalse σ + 1 := by
        rw [numFalse_cons]
        simp [add_comm]
      have hst : cubeShift h (Fin.cons true σ) = h 0 + cubeShift (fun i => h i.succ) σ := by
        rw [cubeShift_cons]
        simp
      have hsf : cubeShift h (Fin.cons false σ) = cubeShift (fun i => h i.succ) σ := by
        rw [cubeShift_cons]
        simp
      simp only [consBoolEquiv, Equiv.coe_fn_mk, hct, hcf, hst, hsf, conjPar_succ, add_smul,
        ← add_assoc]


/-! ### Blueprint `def:local-uniformity`: the local uniformity norms

The `2^s`-th power of the norm is the average of the iterated Fejer difference against the product
of Fejer kernels, normalized by the volume `N^6` of the anisotropic box. -/

open MeasureTheory in
/-- The `2^s`-th power of the local uniformity norm `U^s_{j,H}(f)`. -/
noncomputable def locUnifPow (N H : ℝ) (j : Fin 3) (s : ℕ) (f : E3 → ℂ) : ℂ :=
  ((N ^ (6 : ℕ))⁻¹ : ℂ) * ∫ x : E3, ∫ h : Fin s → ℝ,
    fdiffIter (basisVec j) s h f x * ∏ l : Fin s, ((fejer H (h l) : ℝ) : ℂ)

/-- The product of Fejer kernels is nonnegative. -/
theorem prod_fejer_nonneg {H : ℝ} (hH : 0 < H) {s : ℕ} (h : Fin s → ℝ) :
    0 ≤ ∏ l : Fin s, fejer H (h l) :=
  Finset.prod_nonneg fun l _ => fejer_nonneg hH (h l)

/-- The complex product of Fejer kernels has modulus the real product. -/
theorem norm_prod_fejer {H : ℝ} (hH : 0 < H) {s : ℕ} (h : Fin s → ℝ) :
    ‖∏ l : Fin s, ((fejer H (h l) : ℝ) : ℂ)‖ = ∏ l : Fin s, fejer H (h l) := by
  rw [← Complex.ofReal_prod, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (prod_fejer_nonneg hH h)]

/-- **The integrand of the local uniformity norm is dominated by the product of Fejer kernels**
when the function has modulus at most one. This is what makes the definition an average against a
probability density. -/
theorem norm_locUnif_integrand_le {H : ℝ} (hH : 0 < H) (v : E3) (s : ℕ) (h : Fin s → ℝ)
    {f : E3 → ℂ} (hf : ∀ y, ‖f y‖ ≤ 1) (x : E3) :
    ‖fdiffIter v s h f x * ∏ l : Fin s, ((fejer H (h l) : ℝ) : ℂ)‖
      ≤ ∏ l : Fin s, fejer H (h l) := by
  rw [norm_mul, norm_prod_fejer hH]
  calc ‖fdiffIter v s h f x‖ * ∏ l : Fin s, fejer H (h l)
      ≤ 1 * ∏ l : Fin s, fejer H (h l) := by
        gcongr
        · exact prod_fejer_nonneg hH h
        · exact norm_fdiffIter_le v s h hf x
    _ = ∏ l : Fin s, fejer H (h l) := one_mul _

/-- The cube expansion written out for the local uniformity norm's integrand. -/
theorem locUnif_integrand_eq (v : E3) (s : ℕ) (h : Fin s → ℝ) (f : E3 → ℂ) (x : E3) :
    fdiffIter v s h f x
      = ∏ ω : Fin s → Bool, conjPar (numFalse ω) (f (x + cubeShift h ω • v)) :=
  fdiffIter_eq_cubeProd v s h f x


/-! ### Blueprint `def:local-uniformity`: the Fejer kernel as a convolution square

The blueprint's `lem:fejer-vdc` changes variables "from the two shift variables to their
difference" and says "the density of that difference is `kappa_H`".  That is the following
identity: the overlap of `(0, H]` with its translate by `h` has length `(H - |h|)_+`, so `kappa_H`
is `H^{-2}` times that overlap. It is also what exhibits the local uniformity integral as a
square, and so as nonnegative. -/

open MeasureTheory in
/-- **The overlap of `(0, H]` with its translate by `h` has length `(H - |h|)_+`.** -/
theorem integral_indicator_shift_Ioc {H : ℝ} (hH : 0 < H) (h : ℝ) :
    (∫ a in (0 : ℝ)..H, Set.indicator (Set.Ioc (0 : ℝ) H) (fun _ => (1 : ℝ)) (a - h))
      = max (H - |h|) 0 := by
  have hset : (fun a : ℝ => Set.indicator (Set.Ioc (0 : ℝ) H) (fun _ => (1 : ℝ)) (a - h))
      = Set.indicator (Set.Ioc h (H + h)) fun _ => (1 : ℝ) := by
    funext a
    by_cases ha : a - h ∈ Set.Ioc (0 : ℝ) H
    · have ha' : a ∈ Set.Ioc h (H + h) := ⟨by linarith [ha.1], by linarith [ha.2]⟩
      rw [Set.indicator_of_mem ha, Set.indicator_of_mem ha']
    · have ha' : a ∉ Set.Ioc h (H + h) := by
        intro hmem
        exact ha ⟨by linarith [hmem.1], by linarith [hmem.2]⟩
      rw [Set.indicator_of_notMem ha, Set.indicator_of_notMem ha']
  rw [hset, intervalIntegral.integral_of_le hH.le, setIntegral_indicator measurableSet_Ioc,
    Set.Ioc_inter_Ioc, setIntegral_const, smul_eq_mul, mul_one, Real.volume_real_Ioc]
  congr 1
  rcases le_or_gt 0 h with hpos | hneg
  · rw [abs_of_nonneg hpos, min_eq_left (by linarith : H ≤ H + h),
      max_eq_right hpos]
  · rw [abs_of_neg hneg, min_eq_right (by linarith : H + h ≤ H),
      max_eq_left hneg.le]
    ring

/-- **The Fejer kernel is `H^{-2}` times that overlap**, which is the density of the difference of
two independent uniform variables on `(0, H]`. -/
theorem fejer_eq_overlap {H : ℝ} (hH : 0 < H) (h : ℝ) :
    fejer H h = H⁻¹ * H⁻¹ *
      ∫ a in (0 : ℝ)..H, Set.indicator (Set.Ioc (0 : ℝ) H) (fun _ => (1 : ℝ)) (a - h) := by
  have hinv : (0 : ℝ) ≤ H⁻¹ := le_of_lt (inv_pos.mpr hH)
  rw [integral_indicator_shift_Ioc hH, fejer, mul_assoc,
    mul_max_of_nonneg (H - |h|) 0 hinv, mul_zero]
  congr 2
  field_simp


/-! ### Blueprint `def:local-uniformity`: the two steps of the positivity

"Pairing every vertex with its opposite and applying Cauchy-Schwarz shows that its integral is real
and nonnegative."  The two ingredients are recorded here: an interval integral times its conjugate
is the double integral of the paired integrand, and the integral in `x` of such a pair depends only
on the difference of the two shifts. Together with `Auto.fejer_eq_overlap`, which turns the Fejer
weight into exactly such a pair of shifts, they exhibit the integral as a square. -/

open MeasureTheory in
/-- **An interval integral times its conjugate is a double integral.** -/
theorem integral_mul_conj_integral {H : ℝ} (F : ℝ → ℂ) :
    (∫ a in (0 : ℝ)..H, F a) * (starRingEnd ℂ) (∫ b in (0 : ℝ)..H, F b)
      = ∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H, F a * (starRingEnd ℂ) (F b) := by
  have hconj : (starRingEnd ℂ) (∫ b in (0 : ℝ)..H, F b)
      = ∫ b in (0 : ℝ)..H, (starRingEnd ℂ) (F b) := by
    simp only [intervalIntegral, map_sub, ← integral_conj]
  rw [hconj]
  simp_rw [intervalIntegral.integral_const_mul]
  rw [intervalIntegral.integral_mul_const]

open MeasureTheory in
/-- **The integral in `x` of a shifted pair depends only on the difference of the shifts.** -/
theorem integral_shift_pair (v : E3) (f : E3 → ℂ) (a b : ℝ) :
    (∫ x : E3, f (x + a • v) * (starRingEnd ℂ) (f (x + b • v)))
      = ∫ x : E3, f (x + (a - b) • v) * (starRingEnd ℂ) (f x) := by
  rw [← integral_add_right_eq_self
    (fun x : E3 => f (x + (a - b) • v) * (starRingEnd ℂ) (f x)) (b • v)]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
  have hx : x + b • v + (a - b) • v = x + a • v := by
    rw [add_assoc, ← add_smul]
    congr 2
    ring
  simp only [hx]


/-! ### Blueprint `lem:fejer-vdc`: the change of variables in the shift variables

"Change variables from the two shift variables to their difference."  On an interval the inner
substitution `b = a - y` turns the second shift into the difference, moving the interval of
integration; on the whole line it leaves the integral unchanged, Lebesgue measure being invariant
under reflection and translation. -/

open MeasureTheory in
/-- The inner substitution, on an interval. -/
theorem integral_comp_sub_interval (G : ℝ → ℂ) (H a : ℝ) :
    (∫ b in (0 : ℝ)..H, G (a - b)) = ∫ y in (a - H)..a, G y := by
  rw [intervalIntegral.integral_comp_sub_left, sub_zero]

open MeasureTheory in
/-- The inner substitution, on the whole line. -/
theorem integral_comp_sub_full (G : ℝ → ℂ) (a : ℝ) :
    (∫ b : ℝ, G (a - b)) = ∫ y : ℝ, G y :=
  integral_sub_left_eq_self G volume a

open MeasureTheory in
/-- The two shifts of `Auto.integral_shift_pair`, written through the difference variable. -/
theorem integral_shift_pair_interval (v : E3) (f : E3 → ℂ) (H a : ℝ) :
    (∫ b in (0 : ℝ)..H, ∫ x : E3, f (x + a • v) * (starRingEnd ℂ) (f (x + b • v)))
      = ∫ y in (a - H)..a, ∫ x : E3, f (x + y • v) * (starRingEnd ℂ) (f x) := by
  have hstep : ∀ b : ℝ, (∫ x : E3, f (x + a • v) * (starRingEnd ℂ) (f (x + b • v)))
      = (fun c : ℝ => ∫ x : E3, f (x + c • v) * (starRingEnd ℂ) (f x)) (a - b) := by
    intro b
    exact integral_shift_pair v f a b
  simp_rw [hstep]
  exact integral_comp_sub_interval
    (fun c : ℝ => ∫ x : E3, f (x + c • v) * (starRingEnd ℂ) (f x)) H a


/-! ### Blueprint `def:local-uniformity`: the positivity, reduced to a swap

The blueprint's "pairing every vertex with its opposite and applying Cauchy-Schwarz shows that its
integral is real and nonnegative" is, at one difference, the following: after the change of
variables the integral is a double integral in the two shifts, and exchanging it with the integral
in `x` turns the integrand into the square of the shifted average. The exchange is Fubini, whose
integrability hypothesis the blueprint does not discuss; it is carried explicitly here. -/

open MeasureTheory in
/-- **Exchanging an integral over `R^3` with an integral over an interval.** -/
theorem integral_swap_interval {H : ℝ} (hH : 0 < H) (F : E3 → ℝ → ℂ)
    (hint : Integrable (Function.uncurry F)
      ((volume : Measure E3).prod (volume.restrict (Set.Ioc (0 : ℝ) H)))) :
    (∫ x : E3, ∫ a in (0 : ℝ)..H, F x a) = ∫ a in (0 : ℝ)..H, ∫ x : E3, F x a := by
  simp_rw [intervalIntegral.integral_of_le hH.le]
  exact integral_integral_swap hint

open MeasureTheory in
/-- **An integral of `z * conj z` is real and nonnegative.** -/
theorem re_integral_mul_conj_nonneg (F : E3 → ℂ) :
    0 ≤ (∫ x : E3, F x * (starRingEnd ℂ) (F x)).re := by
  have hpt : ∀ x : E3, F x * (starRingEnd ℂ) (F x) = ((‖F x‖ ^ 2 : ℝ) : ℂ) := by
    intro x
    rw [Complex.mul_conj, Complex.normSq_eq_norm_sq]
  simp_rw [hpt]
  rw [integral_complex_ofReal, Complex.ofReal_re]
  exact integral_nonneg fun x => by positivity

open MeasureTheory in
/-- **The positivity at one difference.** Once the two shift integrals are exchanged with the
integral in `x`, the integrand is a square, so the integral is real and nonnegative. -/
theorem re_integral_shift_pair_nonneg {H : ℝ} (v : E3) (f : E3 → ℂ)
    (hswap : (∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H,
          ∫ x : E3, f (x + a • v) * (starRingEnd ℂ) (f (x + b • v)))
        = ∫ x : E3, ∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H,
          f (x + a • v) * (starRingEnd ℂ) (f (x + b • v))) :
    0 ≤ (∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H,
        ∫ x : E3, f (x + a • v) * (starRingEnd ℂ) (f (x + b • v))).re := by
  rw [hswap]
  have hpt : ∀ x : E3, (∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H,
      f (x + a • v) * (starRingEnd ℂ) (f (x + b • v)))
      = (∫ a in (0 : ℝ)..H, f (x + a • v))
        * (starRingEnd ℂ) (∫ b in (0 : ℝ)..H, f (x + b • v)) := fun x =>
    (integral_mul_conj_integral fun a => f (x + a • v)).symm
  simp_rw [hpt]
  exact re_integral_mul_conj_nonneg _


/-! ### Blueprint `def:local-uniformity`: the integrability the exchange needs

For inputs of the class `Auto.Nice` -- continuous, integrable and bounded -- the integrand of the
exchange is dominated by a bound of the shape `C * ‖f (x + b v)‖`, which is integrable in `x` and
constant in the shift, the shift ranging over a bounded interval. -/

open MeasureTheory in
theorem integrable_shift_pair_prod {H : ℝ} (_hH : 0 < H) (v : E3) {f : E3 → ℂ} (hf : Nice f)
    (b : ℝ) :
    Integrable (Function.uncurry fun (x : E3) (a : ℝ) =>
        f (x + a • v) * (starRingEnd ℂ) (f (x + b • v)))
      ((volume : Measure E3).prod (volume.restrict (Set.Ioc (0 : ℝ) H))) := by
  obtain ⟨hcont, hint, C, hC⟩ := hf
  have : IsFiniteMeasure (volume.restrict (Set.Ioc (0 : ℝ) H)) := by
    constructor
    rw [Measure.restrict_apply_univ, Real.volume_Ioc]
    exact ENNReal.ofReal_lt_top
  have hcontU : Continuous (Function.uncurry fun (x : E3) (a : ℝ) =>
      f (x + a • v) * (starRingEnd ℂ) (f (x + b • v))) := by
    refine Continuous.mul ?_ ?_
    · exact hcont.comp (continuous_fst.add (continuous_snd.smul continuous_const))
    · exact Complex.continuous_conj.comp (hcont.comp (continuous_fst.add continuous_const))
  have hdom : Integrable (fun p : E3 × ℝ => C * ‖f (p.1 + b • v)‖)
      ((volume : Measure E3).prod (volume.restrict (Set.Ioc (0 : ℝ) H))) :=
    Integrable.comp_fst (((hint.comp_add_right (b • v)).norm).const_mul C) _
  refine hdom.mono' hcontU.aestronglyMeasurable (Filter.Eventually.of_forall fun p => ?_)
  rw [Function.uncurry_apply_pair, norm_mul, RCLike.norm_conj]
  exact mul_le_mul_of_nonneg_right (hC _) (norm_nonneg _)

open MeasureTheory in
/-- **The exchange, for inputs of the class `Auto.Nice`.** -/
theorem integral_swap_shift_nice {H : ℝ} (hH : 0 < H) (v : E3) {f : E3 → ℂ} (hf : Nice f)
    (b : ℝ) :
    (∫ x : E3, ∫ a in (0 : ℝ)..H, f (x + a • v) * (starRingEnd ℂ) (f (x + b • v)))
      = ∫ a in (0 : ℝ)..H, ∫ x : E3, f (x + a • v) * (starRingEnd ℂ) (f (x + b • v)) :=
  integral_swap_interval hH _ (integrable_shift_pair_prod hH v hf b)


/-! ### Blueprint `def:local-uniformity`: joint integrability of a shifted input

Every exchange in the argument needs the shifted input to be integrable jointly in the point and
the shift. It is, for inputs of the class `Auto.Nice`: for each fixed shift the translate is
integrable with the same norm, and the shift ranges over an interval of finite measure. -/

open MeasureTheory in
theorem integrable_shift_prod {H : ℝ} (v : E3) {f : E3 → ℂ} (hf : Nice f) :
    Integrable (Function.uncurry fun (x : E3) (a : ℝ) => f (x + a • v))
      ((volume : Measure E3).prod (volume.restrict (Set.Ioc (0 : ℝ) H))) := by
  obtain ⟨hcont, hint, C, hC⟩ := hf
  have : IsFiniteMeasure (volume.restrict (Set.Ioc (0 : ℝ) H)) := by
    constructor
    rw [Measure.restrict_apply_univ, Real.volume_Ioc]
    exact ENNReal.ofReal_lt_top
  have hcontU : Continuous (Function.uncurry fun (x : E3) (a : ℝ) => f (x + a • v)) :=
    hcont.comp (continuous_fst.add (continuous_snd.smul continuous_const))
  refine (integrable_prod_iff' hcontU.aestronglyMeasurable).mpr ⟨?_, ?_⟩
  · exact Filter.Eventually.of_forall fun a => hint.comp_add_right (a • v)
  · have hconst : ∀ a : ℝ,
        (∫ x : E3, ‖Function.uncurry (fun (x : E3) (a : ℝ) => f (x + a • v)) (x, a)‖)
          = ∫ x : E3, ‖f x‖ := by
      intro a
      exact integral_add_right_eq_self (fun x : E3 => ‖f x‖) (a • v)
    simp_rw [hconst]
    exact integrable_const _

open MeasureTheory in
/-- The companion of `Auto.integrable_shift_pair_prod` with the roles of the two shifts
exchanged. -/
theorem integrable_shift_pair_prod' {H : ℝ} (v : E3) {f : E3 → ℂ} (hf : Nice f) (a : ℝ) :
    Integrable (Function.uncurry fun (x : E3) (b : ℝ) =>
        f (x + a • v) * (starRingEnd ℂ) (f (x + b • v)))
      ((volume : Measure E3).prod (volume.restrict (Set.Ioc (0 : ℝ) H))) := by
  obtain ⟨hcont, hint, C, hC⟩ := hf
  have : IsFiniteMeasure (volume.restrict (Set.Ioc (0 : ℝ) H)) := by
    constructor
    rw [Measure.restrict_apply_univ, Real.volume_Ioc]
    exact ENNReal.ofReal_lt_top
  have hcontU : Continuous (Function.uncurry fun (x : E3) (b : ℝ) =>
      f (x + a • v) * (starRingEnd ℂ) (f (x + b • v))) := by
    refine Continuous.mul ?_ ?_
    · exact hcont.comp (continuous_fst.add continuous_const)
    · exact Complex.continuous_conj.comp
        (hcont.comp (continuous_fst.add (continuous_snd.smul continuous_const)))
  have hdom : Integrable (fun p : E3 × ℝ => ‖f (p.1 + a • v)‖ * C)
      ((volume : Measure E3).prod (volume.restrict (Set.Ioc (0 : ℝ) H))) :=
    Integrable.comp_fst (((hint.comp_add_right (a • v)).norm).mul_const C) _
  refine hdom.mono' hcontU.aestronglyMeasurable (Filter.Eventually.of_forall fun p => ?_)
  rw [Function.uncurry_apply_pair, norm_mul, RCLike.norm_conj]
  exact mul_le_mul_of_nonneg_left (hC _) (norm_nonneg _)

open MeasureTheory in
/-- **The exchange in the second shift.** -/
theorem integral_swap_shift_nice' {H : ℝ} (hH : 0 < H) (v : E3) {f : E3 → ℂ} (hf : Nice f)
    (a : ℝ) :
    (∫ x : E3, ∫ b in (0 : ℝ)..H, f (x + a • v) * (starRingEnd ℂ) (f (x + b • v)))
      = ∫ b in (0 : ℝ)..H, ∫ x : E3, f (x + a • v) * (starRingEnd ℂ) (f (x + b • v)) :=
  integral_swap_interval hH _ (integrable_shift_pair_prod' v hf a)


/-! ### Blueprint `def:local-uniformity`: the double exchange

Both shift integrals are moved past the integral in the point, one at a time. For the second the
inner shift integral has already been carried out, so the integrand is the input times the
conjugate of its shifted average, and the average is bounded and strongly measurable. -/

open MeasureTheory in
/-- The inner shift integral, carried out. -/
theorem integral_inner_shift (v : E3) (f : E3 → ℂ) (H a : ℝ) (x : E3) :
    (∫ b in (0 : ℝ)..H, f (x + a • v) * (starRingEnd ℂ) (f (x + b • v)))
      = f (x + a • v) * (starRingEnd ℂ) (∫ b in (0 : ℝ)..H, f (x + b • v)) := by
  rw [intervalIntegral.integral_const_mul, intervalIntegral_conj]

open MeasureTheory in
/-- The shifted average is strongly measurable. -/
theorem stronglyMeasurable_shiftAvg {H : ℝ} (hH : 0 ≤ H) (v : E3) {f : E3 → ℂ} (hf : Nice f) :
    StronglyMeasurable fun x : E3 => ∫ b in (0 : ℝ)..H, f (x + b • v) := by
  have h1 : StronglyMeasurable fun p : E3 × ℝ => f (p.1 + p.2 • v) :=
    (hf.1.comp (continuous_fst.add (continuous_snd.smul continuous_const))).stronglyMeasurable
  have h2 := h1.integral_prod_right' (ν := volume.restrict (Set.Ioc (0 : ℝ) H))
  simp only [intervalIntegral.integral_of_le hH]
  exact h2

open MeasureTheory in
/-- The shifted average is bounded. -/
theorem norm_shiftAvg_le {H : ℝ} (hH : 0 ≤ H) (v : E3) {f : E3 → ℂ} {C : ℝ}
    (hC : ∀ y, ‖f y‖ ≤ C) (x : E3) :
    ‖∫ b in (0 : ℝ)..H, f (x + b • v)‖ ≤ C * H := by
  have h := intervalIntegral.norm_integral_le_of_norm_le_const
    (C := C) (a := (0 : ℝ)) (b := H) (f := fun b => f (x + b • v)) fun b _ => hC _
  simpa [abs_of_nonneg hH] using h

open MeasureTheory in
/-- **The exchange in the first shift**, the second having been carried out. -/
theorem integral_swap_outer {H : ℝ} (hH : 0 < H) (v : E3) {f : E3 → ℂ} (hf : Nice f) :
    (∫ a in (0 : ℝ)..H, ∫ x : E3, ∫ b in (0 : ℝ)..H,
        f (x + a • v) * (starRingEnd ℂ) (f (x + b • v)))
      = ∫ x : E3, ∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H,
        f (x + a • v) * (starRingEnd ℂ) (f (x + b • v)) := by
  obtain ⟨C, hC⟩ := hf.2.2
  have hSmeas : StronglyMeasurable fun x : E3 => ∫ b in (0 : ℝ)..H, f (x + b • v) :=
    stronglyMeasurable_shiftAvg hH.le v hf
  have hcontU : Continuous fun p : E3 × ℝ => f (p.1 + p.2 • v) :=
    hf.1.comp (continuous_fst.add (continuous_snd.smul continuous_const))
  have hmeasG : AEStronglyMeasurable (Function.uncurry fun (x : E3) (a : ℝ) =>
      f (x + a • v) * (starRingEnd ℂ) (∫ b in (0 : ℝ)..H, f (x + b • v)))
      ((volume : Measure E3).prod (volume.restrict (Set.Ioc (0 : ℝ) H))) :=
    hcontU.aestronglyMeasurable.mul
      (Complex.continuous_conj.comp_aestronglyMeasurable
        (hSmeas.aestronglyMeasurable.comp_fst))
  have hdom : Integrable (fun p : E3 × ℝ => C * H * ‖f (p.1 + p.2 • v)‖)
      ((volume : Measure E3).prod (volume.restrict (Set.Ioc (0 : ℝ) H))) :=
    ((integrable_shift_prod (H := H) v hf).norm).const_mul (C * H)
  have hintG : Integrable (Function.uncurry fun (x : E3) (a : ℝ) =>
      f (x + a • v) * (starRingEnd ℂ) (∫ b in (0 : ℝ)..H, f (x + b • v)))
      ((volume : Measure E3).prod (volume.restrict (Set.Ioc (0 : ℝ) H))) := by
    refine hdom.mono' hmeasG (Filter.Eventually.of_forall fun p => ?_)
    rw [Function.uncurry_apply_pair, norm_mul, RCLike.norm_conj, mul_comm (C * H)]
    exact mul_le_mul_of_nonneg_left (norm_shiftAvg_le hH.le v hC p.1) (norm_nonneg _)
  simp_rw [integral_inner_shift v f H]
  exact (integral_swap_interval hH _ hintG).symm

open MeasureTheory in
/-- **The double exchange.** -/
theorem integral_swap_double {H : ℝ} (hH : 0 < H) (v : E3) {f : E3 → ℂ} (hf : Nice f) :
    (∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H,
        ∫ x : E3, f (x + a • v) * (starRingEnd ℂ) (f (x + b • v)))
      = ∫ x : E3, ∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H,
        f (x + a • v) * (starRingEnd ℂ) (f (x + b • v)) := by
  have h1 : ∀ a : ℝ,
      (∫ b in (0 : ℝ)..H, ∫ x : E3, f (x + a • v) * (starRingEnd ℂ) (f (x + b • v)))
        = ∫ x : E3, ∫ b in (0 : ℝ)..H, f (x + a • v) * (starRingEnd ℂ) (f (x + b • v)) :=
    fun a => (integral_swap_shift_nice' hH v hf a).symm
  simp_rw [h1]
  exact integral_swap_outer hH v hf

open MeasureTheory in
/-- **The positivity at one difference, unconditionally for inputs of class `Auto.Nice`.** -/
theorem re_integral_shift_pair_nonneg_nice {H : ℝ} (hH : 0 < H) (v : E3) {f : E3 → ℂ}
    (hf : Nice f) :
    0 ≤ (∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H,
        ∫ x : E3, f (x + a • v) * (starRingEnd ℂ) (f (x + b • v))).re :=
  re_integral_shift_pair_nonneg v f (integral_swap_double hH v hf)


/-! ### Blueprint `lem:fejer-vdc`: the two shift variables and their difference

"Change variables from the two shift variables to their difference.  The density of that difference
is `kappa_H`."  With `Auto.fejer_eq_overlap` identifying the density, the identity is a Fubini
exchange together with the substitution `b = a - h` in the inner variable. -/

/-- The indicator of the shift interval. -/
noncomputable def shiftInd (H : ℝ) : ℝ → ℝ := Set.indicator (Set.Ioc (0 : ℝ) H) fun _ => (1 : ℝ)

theorem measurable_shiftInd (H : ℝ) : Measurable (shiftInd H) :=
  measurable_const.indicator measurableSet_Ioc

theorem shiftInd_nonneg (H : ℝ) (y : ℝ) : 0 ≤ shiftInd H y :=
  Set.indicator_nonneg (fun _ _ => zero_le_one) y

theorem shiftInd_le_one (H : ℝ) (y : ℝ) : shiftInd H y ≤ 1 := by
  rw [shiftInd]
  by_cases hy : y ∈ Set.Ioc (0 : ℝ) H
  · rw [Set.indicator_of_mem hy]
  · rw [Set.indicator_of_notMem hy]
    exact zero_le_one

open MeasureTheory in
theorem integral_shiftInd_shift {H : ℝ} (hH : 0 < H) (h : ℝ) :
    (∫ a in (0 : ℝ)..H, shiftInd H (a - h)) = max (H - |h|) 0 :=
  integral_indicator_shift_Ioc hH h

open MeasureTheory in
/-- The inner substitution `b = a - h`. -/
theorem integral_inner_sub {H : ℝ} (hH : 0 ≤ H) (a : ℝ) (G : ℝ → ℂ) :
    (∫ b in (0 : ℝ)..H, G (a - b)) = ∫ h : ℝ, shiftInd H (a - h) • G h := by
  have hind : (fun b : ℝ => shiftInd H b • G (a - b))
      = Set.indicator (Set.Ioc (0 : ℝ) H) fun b => G (a - b) := by
    funext b
    by_cases hb : b ∈ Set.Ioc (0 : ℝ) H
    · rw [shiftInd, Set.indicator_of_mem hb, Set.indicator_of_mem hb, one_smul]
    · rw [shiftInd, Set.indicator_of_notMem hb, Set.indicator_of_notMem hb, zero_smul]
  have hsub := integral_sub_left_eq_self (fun h : ℝ => shiftInd H (a - h) • G h) volume a
  simp only [sub_sub_cancel] at hsub
  calc (∫ b in (0 : ℝ)..H, G (a - b))
      = ∫ b in Set.Ioc (0 : ℝ) H, G (a - b) := intervalIntegral.integral_of_le hH
    _ = ∫ b : ℝ, Set.indicator (Set.Ioc (0 : ℝ) H) (fun b => G (a - b)) b :=
        (integral_indicator measurableSet_Ioc).symm
    _ = ∫ b : ℝ, shiftInd H b • G (a - b) := by rw [hind]
    _ = ∫ h : ℝ, shiftInd H (a - h) • G h := hsub

open MeasureTheory in
theorem integrable_shiftInd_prod {H : ℝ} (hH : 0 < H) {G : ℝ → ℂ} (hGm : Measurable G)
    {M : ℝ} (hM : ∀ y, ‖G y‖ ≤ M) :
    Integrable (Function.uncurry fun (a h : ℝ) => shiftInd H (a - h) • G h)
      ((volume.restrict (Set.Ioc (0 : ℝ) H)).prod volume) := by
  have hmeas : AEStronglyMeasurable
      (Function.uncurry fun (a h : ℝ) => shiftInd H (a - h) • G h)
      ((volume.restrict (Set.Ioc (0 : ℝ) H)).prod volume) := by
    have h1 : Measurable fun p : ℝ × ℝ => shiftInd H (p.1 - p.2) :=
      (measurable_shiftInd H).comp (measurable_fst.sub measurable_snd)
    have h2 : Measurable fun p : ℝ × ℝ => G p.2 := hGm.comp measurable_snd
    exact (h1.smul h2).aestronglyMeasurable
  refine (integrable_prod_iff' hmeas).mpr ⟨?_, ?_⟩
  · refine Filter.Eventually.of_forall fun h => ?_
    refine Measure.integrableOn_of_bounded (M := M) measure_Ioc_lt_top.ne ?_ ?_
    · have hm : Measurable fun a : ℝ => shiftInd H (a - h) • G h :=
        ((measurable_shiftInd H).comp (measurable_id.sub measurable_const)).smul
          (measurable_const : Measurable fun _ : ℝ => G h)
      exact hm.aestronglyMeasurable
    · refine Filter.Eventually.of_forall fun a => ?_
      rw [Function.uncurry_apply_pair, norm_smul, Real.norm_eq_abs,
        abs_of_nonneg (shiftInd_nonneg H _)]
      calc shiftInd H (a - h) * ‖G h‖ ≤ 1 * ‖G h‖ :=
            mul_le_mul_of_nonneg_right (shiftInd_le_one H _) (norm_nonneg _)
        _ = ‖G h‖ := one_mul _
        _ ≤ M := hM h
  · have hval : ∀ h : ℝ,
        (∫ a : ℝ, ‖Function.uncurry (fun (a h : ℝ) => shiftInd H (a - h) • G h) (a, h)‖
          ∂(volume.restrict (Set.Ioc (0 : ℝ) H)))
          = max (H - |h|) 0 * ‖G h‖ := by
      intro h
      have hnorm : ∀ a : ℝ,
          ‖Function.uncurry (fun (a h : ℝ) => shiftInd H (a - h) • G h) (a, h)‖
            = shiftInd H (a - h) * ‖G h‖ := by
        intro a
        rw [Function.uncurry_apply_pair, norm_smul, Real.norm_eq_abs,
          abs_of_nonneg (shiftInd_nonneg H _)]
      simp_rw [hnorm]
      rw [integral_mul_const, ← intervalIntegral.integral_of_le hH.le,
        integral_shiftInd_shift hH]
    simp_rw [hval]
    have hzero : ∀ x : ℝ, x ∉ Set.Icc (-H) H → max (H - |x|) 0 * ‖G x‖ = 0 := by
      intro x hx
      have hx' : H - |x| ≤ 0 := by
        rcases le_or_gt 0 x with hpos | hneg
        · rw [abs_of_nonneg hpos]
          by_contra hcon
          exact hx ⟨by linarith, by linarith⟩
        · rw [abs_of_neg hneg]
          by_contra hcon
          exact hx ⟨by linarith, by linarith⟩
      rw [max_eq_right hx', zero_mul]
    have hmeas' : Measurable fun x : ℝ => max (H - |x|) 0 * ‖G x‖ :=
      ((measurable_const.sub continuous_abs.measurable).max measurable_const).mul hGm.norm
    have hind : (fun x : ℝ => max (H - |x|) 0 * ‖G x‖)
        = Set.indicator (Set.Icc (-H) H) fun x => max (H - |x|) 0 * ‖G x‖ := by
      funext x
      by_cases hx : x ∈ Set.Icc (-H) H
      · rw [Set.indicator_of_mem hx]
      · rw [Set.indicator_of_notMem hx, hzero x hx]
    rw [hind, integrable_indicator_iff measurableSet_Icc]
    refine Measure.integrableOn_of_bounded (M := H * M) measure_Icc_lt_top.ne
      hmeas'.aestronglyMeasurable (Filter.Eventually.of_forall fun x => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (le_max_right _ _) (norm_nonneg _))]
    exact mul_le_mul (max_le (by linarith [abs_nonneg x]) hH.le) (hM x) (norm_nonneg _)
      hH.le

open MeasureTheory in
/-- **The two shift variables and their difference.** -/
theorem integral_double_sub_eq_fejer {H : ℝ} (hH : 0 < H) {G : ℝ → ℂ} (hGm : Measurable G)
    {M : ℝ} (hM : ∀ y, ‖G y‖ ≤ M) :
    (∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H, G (a - b))
      = (H ^ 2 : ℝ) • ∫ h : ℝ, fejer H h • G h := by
  have hne : H ≠ 0 := hH.ne'
  have hstep1 : ∀ a : ℝ, (∫ b in (0 : ℝ)..H, G (a - b)) = ∫ h : ℝ, shiftInd H (a - h) • G h :=
    fun a => integral_inner_sub hH.le a G
  simp_rw [hstep1]
  rw [intervalIntegral.integral_of_le hH.le,
    integral_integral_swap (integrable_shiftInd_prod hH hGm hM)]
  have hinner : ∀ h : ℝ, (∫ a in Set.Ioc (0 : ℝ) H, shiftInd H (a - h) • G h)
      = (max (H - |h|) 0) • G h := by
    intro h
    rw [integral_smul_const, ← intervalIntegral.integral_of_le hH.le,
      integral_shiftInd_shift hH]
  simp_rw [hinner]
  rw [← integral_smul]
  refine integral_congr_ae (Filter.Eventually.of_forall fun h => ?_)
  simp only [smul_smul]
  congr 1
  rw [fejer_eq_overlap hH, integral_indicator_shift_Ioc hH]
  field_simp


/-! ### Blueprint `def:local-uniformity`: the Fejer-weighted integral at one difference

With the change of variables in hand, the Fejer-weighted integral of the paired average is a
positive multiple of the double integral over the two shifts, which was shown nonnegative. This is
the blueprint's positivity statement in the form its definition uses it. -/

open MeasureTheory in
/-- The paired average, as a function of the difference. -/
noncomputable def pairAvg (v : E3) (f : E3 → ℂ) (h : ℝ) : ℂ :=
  ∫ x : E3, f (x + h • v) * (starRingEnd ℂ) (f x)

open MeasureTheory in
theorem norm_pairAvg_le (v : E3) {f : E3 → ℂ} (hf : Nice f) {C : ℝ} (hC : ∀ y, ‖f y‖ ≤ C)
    (h : ℝ) : ‖pairAvg v f h‖ ≤ C * ∫ x : E3, ‖f x‖ := by
  refine le_trans (norm_integral_le_integral_norm _) ?_
  rw [← integral_const_mul]
  refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun x => norm_nonneg _)
    (hf.2.1.norm.const_mul C) (Filter.Eventually.of_forall fun x => ?_)
  simp only [norm_mul, RCLike.norm_conj]
  exact mul_le_mul_of_nonneg_right (hC _) (norm_nonneg _)

open MeasureTheory in
theorem continuous_pairAvg (v : E3) {f : E3 → ℂ} (hf : Nice f) {C : ℝ} (hC : ∀ y, ‖f y‖ ≤ C) :
    Continuous (pairAvg v f) := by
  refine continuous_of_dominated
    (F := fun (h : ℝ) (x : E3) => f (x + h • v) * (starRingEnd ℂ) (f x))
    (bound := fun x : E3 => C * ‖f x‖) ?_ ?_ ?_ ?_
  · intro h
    exact ((hf.1.comp (continuous_id.add continuous_const)).mul
      (Complex.continuous_conj.comp hf.1)).aestronglyMeasurable
  · intro h
    refine Filter.Eventually.of_forall fun x => ?_
    simp only [norm_mul, RCLike.norm_conj]
    exact mul_le_mul_of_nonneg_right (hC _) (norm_nonneg _)
  · exact hf.2.1.norm.const_mul C
  · refine Filter.Eventually.of_forall fun x => ?_
    exact (hf.1.comp (continuous_const.add (continuous_id.smul continuous_const))).mul
      continuous_const

open MeasureTheory in
/-- **The Fejer-weighted integral at one difference is real and nonnegative.** -/
theorem re_fejer_pairAvg_nonneg {H : ℝ} (hH : 0 < H) (v : E3) {f : E3 → ℂ} (hf : Nice f) :
    0 ≤ (∫ h : ℝ, fejer H h • pairAvg v f h).re := by
  obtain ⟨C, hC⟩ := hf.2.2
  have hpair : ∀ a b : ℝ, pairAvg v f (a - b)
      = ∫ x : E3, f (x + a • v) * (starRingEnd ℂ) (f (x + b • v)) := by
    intro a b
    exact (integral_shift_pair v f a b).symm
  have hdouble := integral_double_sub_eq_fejer hH (continuous_pairAvg v hf hC).measurable
    (norm_pairAvg_le v hf hC)
  have hnn : 0 ≤ ((H ^ 2 : ℝ) • ∫ h : ℝ, fejer H h • pairAvg v f h).re := by
    rw [← hdouble]
    simp_rw [hpair]
    exact re_integral_shift_pair_nonneg_nice hH v hf
  have hre : ((H ^ 2 : ℝ) • ∫ h : ℝ, fejer H h • pairAvg v f h).re
      = H ^ 2 * (∫ h : ℝ, fejer H h • pairAvg v f h).re := by
    rw [Complex.real_smul, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul,
      sub_zero]
  rw [hre] at hnn
  have hpos : (0 : ℝ) < H ^ 2 := by positivity
  by_contra hcon
  push Not at hcon
  have hneg : H ^ 2 * (∫ h : ℝ, fejer H h • pairAvg v f h).re < 0 :=
    mul_neg_of_pos_of_neg hpos hcon
  linarith


/-! ### Blueprint `def:local-uniformity`: the positivity at every order

The difference operator preserves the class `Auto.Nice`, so the iterated difference of a `Nice`
input is again `Nice`, and the positivity of the previous entry applies to it. That is the
inductive step: the iterated difference of order `s + 1` is one difference applied to the iterated
difference of order `s`, by `Auto.fdiffIter_succ`. -/

open MeasureTheory in
/-- The difference operator preserves the class `Auto.Nice`. -/
theorem nice_fdiff (v : E3) (t : ℝ) {f : E3 → ℂ} (hf : Nice f) : Nice (fdiff v t f) := by
  obtain ⟨hcont, hint, C, hC⟩ := hf
  have hshift : Continuous fun x : E3 => f (x + t • v) :=
    hcont.comp (continuous_id.add continuous_const)
  have hcontd : Continuous (fdiff v t f) :=
    hshift.mul (Complex.continuous_conj.comp hcont)
  have h1 : Integrable (fun x : E3 => f (x + t • v)) volume := hint.comp_add_right (t • v)
  refine ⟨hcontd, ?_, ⟨C * C, ?_⟩⟩
  · refine Integrable.mono' (h1.norm.const_mul C) hcontd.aestronglyMeasurable ?_
    refine Filter.Eventually.of_forall fun x => ?_
    simp only [fdiff, norm_mul, RCLike.norm_conj]
    rw [mul_comm C]
    exact mul_le_mul_of_nonneg_left (hC x) (norm_nonneg _)
  · intro x
    simp only [fdiff, norm_mul, RCLike.norm_conj]
    exact mul_le_mul (hC (x + t • v)) (hC x) (norm_nonneg (f x))
      (le_trans (norm_nonneg (f x)) (hC x))

/-- The iterated difference of a `Auto.Nice` input is `Auto.Nice`. -/
theorem nice_fdiffIter (v : E3) : ∀ (s : ℕ) (h : Fin s → ℝ) {f : E3 → ℂ}, Nice f →
    Nice (fdiffIter v s h f)
  | 0, _, _, hf => hf
  | (s + 1), h, f, hf => by
      rw [fdiffIter_succ]
      exact nice_fdiff v (h 0) (nice_fdiffIter v s (fun i => h i.succ) hf)

open MeasureTheory in
/-- **The positivity at every order.** At each order the innermost Fejer-weighted difference is
real and nonnegative, the iterated difference it is applied to being again of class `Auto.Nice`. -/
theorem re_fejer_fdiffIter_nonneg {H : ℝ} (hH : 0 < H) (v : E3) (s : ℕ) (h : Fin s → ℝ)
    {f : E3 → ℂ} (hf : Nice f) :
    0 ≤ (∫ t : ℝ, fejer H t • pairAvg v (fdiffIter v s h f) t).re :=
  re_fejer_pairAvg_nonneg hH v (nice_fdiffIter v s h hf)


/-! ## Blueprint `lem:fejer-vdc`: the boundary estimate

"Write the average of `F` as the average of `(1/H) int_0^H F(t+h) dh` up to the two boundary
intervals, whose total normalized contribution is at most `2H/N`."  Shifting the interval by `h`
changes the integral by the two boundary pieces, each of length `h`, on which the integrand has
modulus at most one. See `automation/ErrorReport.md` for the missing operator in the lemma's
display. -/

open MeasureTheory in
/-- **Shifting the interval changes the integral by at most `2h`.** -/
theorem norm_integral_shift_sub_le {F : ℝ → ℂ}
    (hFi : ∀ c d : ℝ, IntervalIntegrable F volume c d) (hF : ∀ t, ‖F t‖ ≤ 1)
    (c N h : ℝ) (hh : 0 ≤ h) :
    ‖(∫ t in c..(c + N), F t) - ∫ t in c..(c + N), F (t + h)‖ ≤ 2 * h := by
  have hshift : (∫ t in c..(c + N), F (t + h)) = ∫ u in (c + h)..(c + N + h), F u :=
    intervalIntegral.integral_comp_add_right F h
  have hsplit1 : (∫ t in c..(c + h), F t) + (∫ t in (c + h)..(c + N), F t)
      = ∫ t in c..(c + N), F t :=
    intervalIntegral.integral_add_adjacent_intervals (hFi _ _) (hFi _ _)
  have hsplit2 : (∫ t in (c + h)..(c + N), F t) + (∫ t in (c + N)..(c + N + h), F t)
      = ∫ t in (c + h)..(c + N + h), F t :=
    intervalIntegral.integral_add_adjacent_intervals (hFi _ _) (hFi _ _)
  have hdiff : (∫ t in c..(c + N), F t) - ∫ t in c..(c + N), F (t + h)
      = (∫ t in c..(c + h), F t) - ∫ t in (c + N)..(c + N + h), F t := by
    rw [hshift, ← hsplit1, ← hsplit2]
    ring
  have hb1 : ‖∫ t in c..(c + h), F t‖ ≤ h := by
    have hb := intervalIntegral.norm_integral_le_of_norm_le_const
      (C := 1) (a := c) (b := c + h) (f := F) fun t _ => hF t
    simpa [abs_of_nonneg hh] using hb
  have hb2 : ‖∫ t in (c + N)..(c + N + h), F t‖ ≤ h := by
    have hb := intervalIntegral.norm_integral_le_of_norm_le_const
      (C := 1) (a := c + N) (b := c + N + h) (f := F) fun t _ => hF t
    simpa [abs_of_nonneg hh] using hb
  rw [hdiff]
  calc ‖(∫ t in c..(c + h), F t) - ∫ t in (c + N)..(c + N + h), F t‖
      ≤ ‖∫ t in c..(c + h), F t‖ + ‖∫ t in (c + N)..(c + N + h), F t‖ := norm_sub_le _ _
    _ ≤ h + h := add_le_add hb1 hb2
    _ = 2 * h := by ring


/-! ### Blueprint `lem:fejer-vdc`: the averaged boundary estimate

Averaging the shift over `[0, H]` costs at most `2H`, by the pointwise estimate. The average is
legitimate because the shifted integral is measurable in the shift -- as the parametric integral of
a jointly measurable function -- and bounded by the length of the interval. -/

open MeasureTheory in
theorem stronglyMeasurable_shiftIntegral {F : ℝ → ℂ} (hFm : Measurable F) {N : ℝ} (hN : 0 ≤ N)
    (c : ℝ) : StronglyMeasurable fun h : ℝ => ∫ t in c..(c + N), F (t + h) := by
  have h1 : StronglyMeasurable fun p : ℝ × ℝ => F (p.2 + p.1) :=
    (hFm.comp (measurable_snd.add measurable_fst)).stronglyMeasurable
  have h2 := h1.integral_prod_right' (ν := volume.restrict (Set.Ioc c (c + N)))
  simp only [intervalIntegral.integral_of_le (by linarith : c ≤ c + N)]
  exact h2

open MeasureTheory in
theorem norm_shiftIntegral_le {F : ℝ → ℂ} (hF : ∀ t, ‖F t‖ ≤ 1) {N : ℝ} (hN : 0 ≤ N) (c h : ℝ) :
    ‖∫ t in c..(c + N), F (t + h)‖ ≤ N := by
  have hb := intervalIntegral.norm_integral_le_of_norm_le_const
    (C := 1) (a := c) (b := c + N) (f := fun t => F (t + h)) fun t _ => hF _
  simpa [abs_of_nonneg hN] using hb

open MeasureTheory in
theorem intervalIntegrable_shiftIntegral {F : ℝ → ℂ} (hFm : Measurable F) (hF : ∀ t, ‖F t‖ ≤ 1)
    {N : ℝ} (hN : 0 ≤ N) {H : ℝ} (hH : 0 ≤ H) (c : ℝ) :
    IntervalIntegrable (fun h : ℝ => ∫ t in c..(c + N), F (t + h)) volume 0 H := by
  rw [intervalIntegrable_iff_integrableOn_Ioc_of_le hH]
  refine Measure.integrableOn_of_bounded (M := N) measure_Ioc_lt_top.ne
    (stronglyMeasurable_shiftIntegral hFm hN c).aestronglyMeasurable ?_
  exact Filter.Eventually.of_forall fun h => norm_shiftIntegral_le hF hN c h

open MeasureTheory in
/-- **The averaged boundary estimate.** -/
theorem norm_integral_avg_sub_le {F : ℝ → ℂ} (hFm : Measurable F)
    (hFi : ∀ c d : ℝ, IntervalIntegrable F volume c d) (hF : ∀ t, ‖F t‖ ≤ 1)
    {N : ℝ} (hN : 0 ≤ N) {H : ℝ} (hH : 0 < H) (c : ℝ) :
    ‖(∫ t in c..(c + N), F t)
        - H⁻¹ • ∫ h in (0 : ℝ)..H, ∫ t in c..(c + N), F (t + h)‖ ≤ 2 * H := by
  have hAint : IntervalIntegrable (fun _ : ℝ => ∫ t in c..(c + N), F t) volume 0 H :=
    intervalIntegrable_const
  have hBint := intervalIntegrable_shiftIntegral hFm hF hN hH.le c
  have key : (∫ t in c..(c + N), F t) - H⁻¹ • ∫ h in (0 : ℝ)..H, ∫ t in c..(c + N), F (t + h)
      = H⁻¹ • ∫ h in (0 : ℝ)..H,
        ((∫ t in c..(c + N), F t) - ∫ t in c..(c + N), F (t + h)) := by
    rw [intervalIntegral.integral_sub hAint hBint, smul_sub, intervalIntegral.integral_const,
      sub_zero, smul_smul, inv_mul_cancel₀ hH.ne', one_smul]
  have hb : ‖∫ h in (0 : ℝ)..H,
      ((∫ t in c..(c + N), F t) - ∫ t in c..(c + N), F (t + h))‖ ≤ 2 * H * H := by
    have hb' := intervalIntegral.norm_integral_le_of_norm_le_const
      (C := 2 * H) (a := (0 : ℝ)) (b := H)
      (f := fun h => (∫ t in c..(c + N), F t) - ∫ t in c..(c + N), F (t + h)) ?_
    · simpa [abs_of_nonneg hH.le] using hb'
    · intro h hmem
      rw [Set.uIoc_of_le hH.le] at hmem
      refine le_trans (norm_integral_shift_sub_le hFi hF c N h hmem.1.le) ?_
      linarith [hmem.2]
  rw [key, norm_smul, norm_inv, Real.norm_eq_abs, abs_of_nonneg hH.le]
  calc H⁻¹ * ‖∫ h in (0 : ℝ)..H,
        ((∫ t in c..(c + N), F t) - ∫ t in c..(c + N), F (t + h))‖
      ≤ H⁻¹ * (2 * H * H) := by
        refine mul_le_mul_of_nonneg_left hb (le_of_lt (inv_pos.mpr hH))
    _ = 2 * H := by field_simp


/-! ### Blueprint `lem:fejer-vdc`: the Cauchy-Schwarz step

"Apply Cauchy-Schwarz, expand the square."  On an interval of length `N` the square of an integral
is at most `N` times the integral of the square. The proof is the discriminant argument: the
integral of `(u - lam)^2` is nonnegative for every `lam`, and at `lam` the mean of `u` it is the
difference of the two sides. -/

open MeasureTheory in
/-- **Cauchy-Schwarz on an interval, for a real integrand.** -/
theorem sq_integral_le {u : ℝ → ℝ} {c N : ℝ} (hN : 0 < N)
    (hu : IntervalIntegrable u volume c (c + N))
    (hu2 : IntervalIntegrable (fun t => u t ^ 2) volume c (c + N)) :
    (∫ t in c..(c + N), u t) ^ 2 ≤ N * ∫ t in c..(c + N), u t ^ 2 := by
  have hle : c ≤ c + N := by linarith
  have hexp : ∀ lam : ℝ, (∫ t in c..(c + N), (u t - lam) ^ 2)
      = (∫ t in c..(c + N), u t ^ 2) - 2 * lam * (∫ t in c..(c + N), u t) + lam ^ 2 * N := by
    intro lam
    have hpt : ∀ t : ℝ, (u t - lam) ^ 2 = u t ^ 2 - 2 * lam * u t + lam ^ 2 := by
      intro t
      ring
    simp_rw [hpt]
    rw [intervalIntegral.integral_add (hu2.sub (hu.const_mul (2 * lam)))
        intervalIntegrable_const,
      intervalIntegral.integral_sub hu2 (hu.const_mul (2 * lam)),
      intervalIntegral.integral_const_mul, intervalIntegral.integral_const, smul_eq_mul]
    ring_nf
  have hnn : (0 : ℝ) ≤ ∫ t in c..(c + N),
      (u t - (∫ t in c..(c + N), u t) / N) ^ 2 :=
    intervalIntegral.integral_nonneg hle fun t _ => sq_nonneg _
  rw [hexp] at hnn
  have hNne : N ≠ 0 := hN.ne'
  field_simp at hnn
  nlinarith [hnn, hN]

open MeasureTheory in
/-- **Cauchy-Schwarz on an interval, for a complex integrand.** -/
theorem sq_norm_integral_le {g : ℝ → ℂ} {c N : ℝ} (hN : 0 < N)
    (hg : IntervalIntegrable g volume c (c + N))
    (hg2 : IntervalIntegrable (fun t => ‖g t‖ ^ 2) volume c (c + N)) :
    ‖∫ t in c..(c + N), g t‖ ^ 2 ≤ N * ∫ t in c..(c + N), ‖g t‖ ^ 2 := by
  have hle : c ≤ c + N := by linarith
  have h1 : ‖∫ t in c..(c + N), g t‖ ≤ ∫ t in c..(c + N), ‖g t‖ :=
    intervalIntegral.norm_integral_le_integral_norm hle
  calc ‖∫ t in c..(c + N), g t‖ ^ 2 ≤ (∫ t in c..(c + N), ‖g t‖) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) h1 2
    _ ≤ N * ∫ t in c..(c + N), ‖g t‖ ^ 2 := sq_integral_le hN hg.norm hg2


