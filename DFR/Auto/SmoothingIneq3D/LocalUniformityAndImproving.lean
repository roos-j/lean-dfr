/-! ### Blueprint `prop:restricted-improving-vertex`: the image measure bound

"The area formula and the multiplicity bound in `lem:real-flow-jacobian` therefore imply
`|E_{j'}| >= c (alpha_0 alpha_1 alpha_2 alpha_3 N)^10`."

With the six fibre densities written as `c_* alpha_{w l}`, the product of the per-step bounds is
`2^{-18} c_*^{10} N^{10} prod_i alpha_i^{e_i}`, and the exponent trade replaces the `e_i` by the
symmetric tenth power. -/
theorem ofReal_prod_six {x1 x2 x3 x4 x5 x6 : ℝ} (h1 : 0 ≤ x1) (h2 : 0 ≤ x2) (h3 : 0 ≤ x3)
    (h4 : 0 ≤ x4) (h5 : 0 ≤ x5) :
    ENNReal.ofReal (x1 * x2 * x3 * x4 * x5 * x6)
      = ENNReal.ofReal x1 * ENNReal.ofReal x2 * ENNReal.ofReal x3 * ENNReal.ofReal x4
        * ENNReal.ofReal x5 * ENNReal.ofReal x6 := by
  have p5 : (0 : ℝ) ≤ x1 * x2 * x3 * x4 * x5 := by positivity
  have p4 : (0 : ℝ) ≤ x1 * x2 * x3 * x4 := by positivity
  have p3 : (0 : ℝ) ≤ x1 * x2 * x3 := by positivity
  have p2 : (0 : ℝ) ≤ x1 * x2 := by positivity
  rw [ENNReal.ofReal_mul p5, ENNReal.ofReal_mul p4, ENNReal.ofReal_mul p3,
    ENNReal.ofReal_mul p2, ENNReal.ofReal_mul h1]

