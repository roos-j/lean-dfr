  have w0 : word3 0 = 1 := rfl
  have w1 : word3 1 = 0 := rfl
  have w2 : word3 2 = 2 := rfl
  have w3 : word3 3 = 0 := rfl
  have w4 : word3 4 = 3 := rfl
  have w5 : word3 5 = 0 := rfl
