  have e1 := flowMap2_coord t t' heq 1
  have e2 := flowMap2_coord t t' heq 2
  have e3 := flowMap2_coord t t' heq 3
  have e4 := flowMap2_coord t t' heq 4
  have e5 := flowMap2_coord t t' heq 5
  simp only [flowPi2_zero, flowPi2_one, flowPi2_two] at e0 e1 e2
  simp only [flowPi2_three, flowPi2_four, flowPi2_five] at e3 e4 e5
  have h0 : t 0 = t' 0 := by linarith
  rw [h0] at e3 e4 e5
  obtain ⟨hsum, hprod, hb⟩ :=
    flowBlock3_pair (a := t 1) (b := t 2) (c := t 3) (a' := t' 1) (b' := t' 2) (c' := t' 3)
      hco3 (by linarith) (by linarith) (by linarith)
  obtain ⟨h3, h1⟩ :=
    pair_eq_of_sum_prod hord hord' (by linarith) (by rw [mul_comm, hprod, mul_comm])
  rw [h3] at e1 e2
  obtain ⟨h4, h5⟩ := flowBlock2_injective (u := t 4) (v := t 5) (u' := t' 4) (v' := t' 5)
    h45 (by linarith) (by linarith)
  ext k
  fin_cases k
  · exact h0
  · exact h1
  · exact hb
  · exact h3
  · exact h4
  · exact h5

/-- **Patch 1 `lem:multiplicity` for `w^(2)`: the two-piece measurable injective cover.** -/
theorem flowMap2_injective_cover {S : Set E6} (hSm : MeasurableSet S)
    (hS : ∀ t ∈ S, t 4 ≠ t 5 ∧ (t 1 - t 2) * (t 2 - t 3) ≠ 0 ∧ t 1 ≠ t 3) :
    ∃ P : Fin 2 → Set E6, (∀ k, MeasurableSet (P k)) ∧ (∀ k, P k ⊆ S) ∧
      S ⊆ ⋃ k, P k ∧ ∀ k, Set.InjOn flowMap2 (P k) := by
  have hlt : MeasurableSet {t : E6 | t 1 < t 3} :=
    (isOpen_lt (continuous_E6_coord 1) (continuous_E6_coord 3)).measurableSet
  have hgt : MeasurableSet {t : E6 | t 3 < t 1} :=
    (isOpen_lt (continuous_E6_coord 3) (continuous_E6_coord 1)).measurableSet
  refine ⟨![S ∩ {t : E6 | t 1 < t 3}, S ∩ {t : E6 | t 3 < t 1}], ?_, ?_, ?_, ?_⟩
  · intro k
    fin_cases k
    · exact hSm.inter hlt
    · exact hSm.inter hgt
  · intro k
    fin_cases k
    · exact Set.inter_subset_left
    · exact Set.inter_subset_left
  · intro t ht
    rcases lt_or_gt_of_ne (hS t ht).2.2 with h | h
    · exact Set.mem_iUnion.mpr ⟨0, by exact ⟨ht, h⟩⟩
    · exact Set.mem_iUnion.mpr ⟨1, by exact ⟨ht, h⟩⟩
  · intro k
    fin_cases k
    · exact flowMap2_injOn fun t ht => ⟨(hS t ht.1).1, (hS t ht.1).2.1, ht.2⟩
    · exact flowMap2_injOn' fun t ht => ⟨(hS t ht.1).1, (hS t ht.1).2.1, ht.2⟩


/-! ### Patch 1 `lem:real-flow-jacobian-fixed`: the parameter set and the area bound

"`P := {t in [0,N]^6 : t_l in I_l(t_1,...,t_{l-1}) for l = 1,...,6}`."

The parameters are read off a point of the lift, so `P` is a subset of the lift; it is measurable
because each fibre condition is the preimage of a measurable set under a continuous map of the
parameters. The area bound is the injective change of variables applied to the two pieces of the
cover, which is exactly the patch's `|E_{j'}| >= (1/2) int_P |det D Phi|`. -/

/-- The six parameters read off a point of the lift. -/
noncomputable def toSeq (s : E6) : ℕ → ℝ := fun l => if h : l < 6 then s ⟨l, h⟩ else 0

theorem continuous_curve4 (a : Fin 4) : Continuous (curve4 a) := by
  rcases Fin.eq_zero_or_eq_succ a with rfl | ⟨i, rfl⟩
  · exact continuous_const
  · exact continuous_liftCurve i

theorem continuous_toSeq_apply (m : ℕ) : Continuous fun s : E6 => toSeq s m := by
  by_cases h : m < 6
  · simp only [toSeq, dite_eq_left h]
    exact continuous_E6_coord _
  · simp only [toSeq, dite_eq_right h]
    exact continuous_const

theorem continuous_flowPt (w : ℕ → Fin 4) (z : E6) :
    ∀ m : ℕ, Continuous fun s : E6 => flowPt w z (toSeq s) m := by
  intro m
  induction m with
  | zero => exact continuous_const
  | succ n ih =>
      simp only [flowPt_succ]
      exact (ih.add ((continuous_curve4 (w (n + 1))).comp (continuous_toSeq_apply n))).sub
        ((continuous_curve4 (w n)).comp (continuous_toSeq_apply n))

/-- **Patch 1 `def:flow`: the parameter set of the tower**, as a subset of the lift. -/
def flowParamSet (N : ℝ) (G : ℕ → Set E6) (Gi : ℕ → Fin 3 → Set E6) (r : ℕ)
    (w : ℕ → Fin 4) (z : E6) : Set E6 :=
  {s : E6 | ∀ m < 6, toSeq s m ∈ flowFibre N G Gi r w z (toSeq s) m}

open MeasureTheory in
theorem measurableSet_flowParamSet (N : ℝ) {G : ℕ → Set E6} {Gi : ℕ → Fin 3 → Set E6}
    (hGm : ∀ k, MeasurableSet (G k)) (hGim : ∀ k i, MeasurableSet (Gi k i)) (r : ℕ)
    (w : ℕ → Fin 4) (z : E6) : MeasurableSet (flowParamSet N G Gi r w z) := by
  have hcfg : ∀ (k : ℕ) (b : Fin 4), MeasurableSet (cfg4 (G k) (Gi k) b) := by
    intro k b
    rcases Fin.eq_zero_or_eq_succ b with rfl | ⟨i, rfl⟩
    · exact hGm k
    · exact hGim k i
  have hpiece : ∀ m : ℕ,
      MeasurableSet {s : E6 | toSeq s m ∈ flowFibre N G Gi r w z (toSeq s) m} := by
    intro m
    have hIoc : MeasurableSet {s : E6 | toSeq s m ∈ Set.Ioc (0 : ℝ) N} :=
      (continuous_toSeq_apply m).measurable measurableSet_Ioc
    have hstep : ∀ b : Fin 4, MeasurableSet
        {s : E6 | flowPt w z (toSeq s) m + curve4 b (toSeq s m) - curve4 (w m) (toSeq s m)
          ∈ cfg4 (G (r - m - 1)) (Gi (r - m - 1)) b} := by
      intro b
      refine (Continuous.measurable ?_) (hcfg (r - m - 1) b)
      exact ((continuous_flowPt w z m).add
        ((continuous_curve4 b).comp (continuous_toSeq_apply m))).sub
        ((continuous_curve4 (w m)).comp (continuous_toSeq_apply m))
    have hrw : {s : E6 | toSeq s m ∈ flowFibre N G Gi r w z (toSeq s) m}
        = {s : E6 | toSeq s m ∈ Set.Ioc (0 : ℝ) N} ∩
          ⋂ b : Fin 4, ⋂ _ : b ≠ w m,
            {s : E6 | flowPt w z (toSeq s) m + curve4 b (toSeq s m) - curve4 (w m) (toSeq s m)
              ∈ cfg4 (G (r - m - 1)) (Gi (r - m - 1)) b} := by
      ext s
      simp [flowFibre, transSet]
    rw [hrw]
    exact hIoc.inter (MeasurableSet.iInter fun b =>
      MeasurableSet.iInter fun _ => hstep b)
  have hrw2 : flowParamSet N G Gi r w z
      = ⋂ m : ℕ, ⋂ _ : m < 6, {s : E6 | toSeq s m ∈ flowFibre N G Gi r w z (toSeq s) m} := by
    ext s
    simp [flowParamSet]
  rw [hrw2]
  exact MeasurableSet.iInter fun m => MeasurableSet.iInter fun _ => hpiece m

open MeasureTheory in
/-- **The area bound with the factor `1/2`.** A map with a two-piece injective cover has
`int_S |det Df| <= 2 |f(S)|`, and the image is contained in the terminal set. -/
theorem lintegral_abs_det_le_two_mul {f : E6 → E6} {f' : E6 → E6 →L[ℝ] E6} {S T : Set E6}
    (hf' : ∀ x, HasFDerivAt f (f' x) x)
    (hcov : ∃ P : Fin 2 → Set E6, (∀ k, MeasurableSet (P k)) ∧ (∀ k, P k ⊆ S) ∧
      S ⊆ ⋃ k, P k ∧ ∀ k, Set.InjOn f (P k))
    (himg : f '' S ⊆ T) :
    (∫⁻ x in S, ENNReal.ofReal |(f' x).det|) ≤ 2 * volume T := by
  obtain ⟨P, hPm, hsub, hcover, hinj⟩ := hcov
  refine le_trans (lintegral_abs_det_fderiv_le_card_mul_image volume hPm hcover hsub
    (fun x _ => (hf' x).hasFDerivWithinAt) hinj) ?_
  have hle : volume (f '' S) ≤ volume T := measure_mono himg
  have hcast : ((2 : ℕ) : ℝ≥0∞) = (2 : ℝ≥0∞) := by norm_num
  rw [hcast]
  exact mul_le_mul' le_rfl hle

/-- A translate of a map is injective wherever the map is. -/
theorem injOn_const_add {f : E6 → E6} {P : Set E6} (z : E6) (h : Set.InjOn f P) :
    Set.InjOn (fun s => z + f s) P := by
  intro a ha b hb hab
  exact h ha hb (by simpa using hab)


/-! ### Patch 1 `lem:real-flow-jacobian-fixed`

"(i) `P` is measurable and its fibres satisfy `|I_l| >= 2^{-240} alpha_{w_{l-1}} N`;
(ii) `Phi(P) subseteq E_{j'}`; (iii) `D Phi` is block lower triangular, with diagonal blocks the
derivatives of `Phi_1, Phi_2, Phi_3`, and `|det D Phi| = 12 |u-v| |a-b| |a-c| |b-c|`; (iv) every
point has at most `2` preimages under `Phi` restricted to `P^circ`, hence at most `12`; and
`|E_{j'}| >= (1/2) int_P |det D Phi|`."

The four items, for each of the three words. Item (iii) is block *diagonal* for `w^(3)` and
`w^(1)` and block lower triangular but not diagonal for `w^(2)`
(`Auto.flowMatrix2_not_blockDiagonal`), which is the correction the patch makes to the blueprint's
statement. -/

open MeasureTheory in
/-- **Patch 1 `lem:real-flow-jacobian-fixed`, for the word `w^(3)`.** -/
theorem real_flow_jacobian_word3 (N : ℝ) {G : ℕ → Set E6} {Gi : ℕ → Fin 3 → Set E6}
    (hGm : ∀ k, MeasurableSet (G k)) (hGim : ∀ k i, MeasurableSet (Gi k i))
    (hGdec : ∀ k, G (k + 1) ⊆ G k) (hGidec : ∀ k i, Gi (k + 1) i ⊆ Gi k i)
    {c₀ : ℝ≥0∞} {c : Fin 3 → ℝ≥0∞} {r : ℕ} (hr : 6 ≤ r)
    (hfwd : ∀ k, k < r → ∀ x ∈ G (k + 1), c₀ ≤ incidFwd N (Gi k) x)
    (hadj : ∀ k, k < r → ∀ i, ∀ y ∈ Gi (k + 1) i, c i ≤ incidAdj N (G k) (Gi k) i y)
    {z : E6} (hz : z ∈ cfg4 (G r) (Gi r) (word3 0)) :
    MeasurableSet (flowParamSet N G Gi r word3 z) ∧
    (∀ s ∈ flowParamSet N G Gi r word3 z, ∀ l < 6,
      dens4 c₀ c (word3 l) ≤ volume (flowFibre N G Gi r word3 z (toSeq s) l)) ∧
    (∀ s ∈ flowParamSet N G Gi r word3 z, z + flowMap3 s ∈ cfg4 (G 0) (Gi 0) (word3 6)) ∧
    (∀ s : E6, |LinearMap.det ((flowDeriv3 s : E6 →L[ℝ] E6) : E6 →ₗ[ℝ] E6)|
      = 12 * |s 1 - s 2| * |s 3 - s 4| * |s 3 - s 5| * |s 4 - s 5|) ∧
    (∀ S : Set E6, S ⊆ flowParamSet N G Gi r word3 z → MeasurableSet S →
      (∀ t ∈ S, t 1 ≠ t 2 ∧ (t 3 - t 4) * (t 4 - t 5) ≠ 0 ∧ t 3 ≠ t 5) →
      (∫⁻ s in S, ENNReal.ofReal
          |LinearMap.det ((flowDeriv3 s : E6 →L[ℝ] E6) : E6 →ₗ[ℝ] E6)|)
        ≤ 2 * volume (cfg4 (G 0) (Gi 0) (word3 6))) := by
  have hland : ∀ s ∈ flowParamSet N G Gi r word3 z,
      z + flowMap3 s ∈ cfg4 (G 0) (Gi 0) (word3 6) := by
    intro s hs
    rw [← flowPt_word3_eq]
    exact flowPt_six_mem N hGdec hGidec word3_isItinerary hz hs
  refine ⟨measurableSet_flowParamSet N hGm hGim r word3 z, ?_, hland,
    abs_det_flowDeriv3, ?_⟩
  · intro s hs l hl
    exact volume_flowFibre_ge N hGm hGim hr hfwd hadj hl
      (flowPt_mem N word3_isItinerary hz hs l hl.le)
  · intro S hSsub hSm hnd
    refine lintegral_abs_det_le_two_mul (f := fun s => z + flowMap3 s)
      (fun x => (hasFDerivAt_flowMap3 x).const_add z) ?_ ?_
    · obtain ⟨P, hPm, hsub, hcover, hinj⟩ := flowMap3_injective_cover hSm hnd
      exact ⟨P, hPm, hsub, hcover, fun k => injOn_const_add z (hinj k)⟩
    · rintro y ⟨s, hs, rfl⟩
      exact hland s (hSsub hs)


