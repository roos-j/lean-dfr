        = a0 * ai 0 * ai 1 * ai 2 * ENNReal.ofReal N := by
      calc a0 * ai j * ai m * ai k * ENNReal.ofReal N
          = a0 * (ai j * ai m * ai k) * ENNReal.ofReal N := by ring
        _ = a0 * (ai 0 * ai 1 * ai 2) * ENNReal.ofReal N := by rw [hperm]
        _ = a0 * ai 0 * ai 1 * ai 2 * ENNReal.ofReal N := by ring
    rw [hQ]
    rw [hc18, mul_assoc] at hterm2
    exact hcan2 _ _ hterm2
  exact K_pow_sixty_le_of_symmetric ha0mul (haimul j) (haimul m) (haimul k)
    (K_le_of_alpha_le_one (haimul j) (hai1 j)) hsym

