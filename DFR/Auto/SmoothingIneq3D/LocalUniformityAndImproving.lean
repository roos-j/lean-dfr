theorem flowMap2_injOn' {S : Set E6}
    (hS : ∀ t ∈ S, t 4 ≠ t 5 ∧ (t 1 - t 2) * (t 2 - t 3) ≠ 0 ∧ t 3 < t 1) :
    Set.InjOn flowMap2 S := by
  intro t ht t' ht' heq
  obtain ⟨h45, hco3, hord⟩ := hS t ht
  obtain ⟨_, _, hord'⟩ := hS t' ht'
