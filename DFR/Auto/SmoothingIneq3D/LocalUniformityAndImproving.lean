"Expand the square."  The squared modulus of the shifted average is the double integral of the
paired integrand over the two shifts, and that double integral may be exchanged with the integral
over the interval, both domains being bounded and the integrand bounded. -/

open MeasureTheory in
/-- **The square of the shifted average, expanded.** -/
theorem sq_norm_shiftAvg_eq (F : ℝ → ℂ) (H t : ℝ) :
    ((‖∫ a in (0 : ℝ)..H, F (t + a)‖ ^ 2 : ℝ) : ℂ)
      = ∫ a in (0 : ℝ)..H, ∫ b in (0 : ℝ)..H, F (t + a) * (starRingEnd ℂ) (F (t + b)) := by
  rw [← integral_mul_conj_integral fun a => F (t + a), Complex.mul_conj,
    Complex.normSq_eq_norm_sq]

open MeasureTheory in
theorem integrable_pair_prod_bdd {F : ℝ → ℂ} (hFm : Measurable F) (hF : ∀ t, ‖F t‖ ≤ 1)
    {N H : ℝ} (c a : ℝ) :
    Integrable (Function.uncurry fun (t b : ℝ) => F (t + a) * (starRingEnd ℂ) (F (t + b)))
