  rw [w0] at b1
  rw [w1] at b2
  rw [w2] at b3
  rw [w3] at b4
  rw [w4] at b5
  rw [w5] at b6
  exact measure_terminal_ge_symmetric_word2 N cst hGm hGim hGdec hGidec hr hfwd hadj hz
    hα0 hα1 hcN b1 b2 b3 b4 b5 b6


/-! ### Blueprint `prop:restricted-improving-vertex`: the measure of a lifted set

"Lift a function `g` on `R^3` by composing it with the three last-coordinate projections and
multiplying by the indicators ... in the unused coordinates ... The product of their measures is
comparable to `N^{D'} = N^4`."

Under the coordinate split the lifted set is a rectangle: the used coordinates carry the original
set and the unused ones the cutoff box, so its measure is the product. -/

open MeasureTheory in
/-- **The measure of a lifted set.** Lifting multiplies the measure by that of the cutoff box,
`8 N^4`. -/
theorem volume_lifted_set {N : ℝ} (hN : 0 ≤ N) {A : Set E3} (hA : MeasurableSet A) :
    volume (proj6 ⁻¹' A ∩ boxSet N) = volume A * ENNReal.ofReal (8 * N ^ 4) := by
  have hBm : MeasurableSet ((WithLp.toLp 2 : (Fin 3 → ℝ) → E3) ⁻¹' A) :=
    (PiLp.volume_preserving_toLp (Fin 3)).measurable hA
  have hUm : MeasurableSet (unusedBox N) :=
    MeasurableSet.univ_pi fun _ => measurableSet_Icc
  have hrect : proj6 ⁻¹' A ∩ boxSet N
      = splitE6 ⁻¹' (((WithLp.toLp 2 : (Fin 3 → ℝ) → E3) ⁻¹' A) ×ˢ unusedBox N) := by
    ext x
    simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_prod, proj6_eq_splitE6,
      boxSet_eq_preimage]
  rw [hrect, measurePreserving_splitE6.measure_preimage (hBm.prod hUm).nullMeasurableSet,
    Measure.volume_eq_prod, Measure.prod_prod,
    (PiLp.volume_preserving_toLp (Fin 3)).measure_preimage hA.nullMeasurableSet,
    volume_unusedBox hN]


/-! ### Blueprint `prop:restricted-improving-vertex`: a lifted set inside the inner box

The inner box is the half of the cutoff box on which every translation of the average stays inside
the cutoff box, so it is where the lifted average equals the original one. In the unused
coordinates it is the product of the lower halves, of measure `N^4`. -/

/-- The inner box, seen in the unused coordinate space. -/
def innerUnusedBox (N : ℝ) : Set (Fin 3 → ℝ) :=
  Set.univ.pi fun k => Set.Icc (-(![N, N, N ^ 2] k)) 0

theorem innerBox_eq_preimage (N : ℝ) :
    innerBox N = (fun x : E6 => (splitE6 x).2) ⁻¹' innerUnusedBox N := by
  ext x
  constructor
  · rintro ⟨h1, h3, h4⟩ k -
    fin_cases k <;> simp only [splitE6_snd] <;> assumption
  · intro h
    have h0 := h 0 (Set.mem_univ _)
    have h1 := h 1 (Set.mem_univ _)
    have h2 := h 2 (Set.mem_univ _)
    simp only [splitE6_snd] at h0 h1 h2
    exact ⟨h0, h1, h2⟩

open MeasureTheory in
theorem volume_innerUnusedBox {N : ℝ} (hN : 0 ≤ N) :
    volume (innerUnusedBox N) = ENNReal.ofReal (N ^ 4) := by
  rw [innerUnusedBox, volume_pi_pi]
  simp only [Real.volume_Icc]
  rw [Fin.prod_univ_three]
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_two,
    Matrix.tail_cons]
  rw [← ENNReal.ofReal_mul (by nlinarith), ← ENNReal.ofReal_mul (by nlinarith)]
  congr 1
  ring

open MeasureTheory in
/-- **The measure of a lifted set inside the inner box**: the factor is `N^4`. -/
theorem volume_lifted_inner {N : ℝ} (hN : 0 ≤ N) {A : Set E3} (hA : MeasurableSet A) :
    volume (proj6 ⁻¹' A ∩ innerBox N) = volume A * ENNReal.ofReal (N ^ 4) := by
  have hBm : MeasurableSet ((WithLp.toLp 2 : (Fin 3 → ℝ) → E3) ⁻¹' A) :=
    (PiLp.volume_preserving_toLp (Fin 3)).measurable hA
  have hUm : MeasurableSet (innerUnusedBox N) :=
    MeasurableSet.univ_pi fun _ => measurableSet_Icc
  have hrect : proj6 ⁻¹' A ∩ innerBox N
      = splitE6 ⁻¹' (((WithLp.toLp 2 : (Fin 3 → ℝ) → E3) ⁻¹' A) ×ˢ innerUnusedBox N) := by
    ext x
    simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_prod, proj6_eq_splitE6,
      innerBox_eq_preimage]
  rw [hrect, measurePreserving_splitE6.measure_preimage (hBm.prod hUm).nullMeasurableSet,
    Measure.volume_eq_prod, Measure.prod_prod,
    (PiLp.volume_preserving_toLp (Fin 3)).measure_preimage hA.nullMeasurableSet,
    volume_innerUnusedBox hN]


/-! ### Blueprint `prop:restricted-improving-vertex`: integrating a lifted function

A function of the used coordinates only, integrated over a lifted set, separates: the used
coordinates give the original integral and the unused ones give the measure of their box. This is
the Fubini step behind the blueprint's "the product of their measures is comparable to `N^{D'}`". -/

open MeasureTheory in
theorem measurable_toLp3 : Measurable (WithLp.toLp 2 : (Fin 3 → ℝ) → E3) :=
  (PiLp.volume_preserving_toLp (Fin 3)).measurable

open MeasureTheory in
/-- **Integrating a function of the used coordinates over a lifted set inside the inner box.** -/
theorem lintegral_lifted_inner {N : ℝ} {S : Set E3} (hS : MeasurableSet S)
    {h : E3 → ℝ≥0∞} (hh : Measurable h) :
    ∫⁻ x in proj6 ⁻¹' S ∩ innerBox N, h (proj6 x)
      = (∫⁻ y in S, h y) * volume (innerUnusedBox N) := by
  set B : Set (Fin 3 → ℝ) := (WithLp.toLp 2 : (Fin 3 → ℝ) → E3) ⁻¹' S with hB
  set U : Set (Fin 3 → ℝ) := innerUnusedBox N with hU
  have hBm : MeasurableSet B := measurable_toLp3 hS
  have hUm : MeasurableSet U := MeasurableSet.univ_pi fun _ => measurableSet_Icc
  have hgm : Measurable fun p : (Fin 3 → ℝ) × (Fin 3 → ℝ) => h (WithLp.toLp 2 p.1) :=
    hh.comp (measurable_toLp3.comp measurable_fst)
  have hrect : proj6 ⁻¹' S ∩ innerBox N = splitE6 ⁻¹' (B ×ˢ U) := by
    ext x
    simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_prod, proj6_eq_splitE6,
      innerBox_eq_preimage]
    exact Iff.rfl
  have hstep : ∫⁻ x in proj6 ⁻¹' S ∩ innerBox N, h (proj6 x)
      = ∫⁻ p in B ×ˢ U, h (WithLp.toLp 2 p.1) := by
    rw [hrect]
    have hcomp := measurePreserving_splitE6.setLIntegral_comp_preimage (hBm.prod hUm) hgm
    simpa [proj6_eq_splitE6] using hcomp
  rw [hstep, ← lintegral_indicator (hBm.prod hUm)]
  have hind : ∀ p : (Fin 3 → ℝ) × (Fin 3 → ℝ),
      Set.indicator (B ×ˢ U) (fun p => h (WithLp.toLp 2 p.1)) p
        = Set.indicator B (fun a => h (WithLp.toLp 2 a)) p.1
          * Set.indicator U (fun _ => (1 : ℝ≥0∞)) p.2 := by
    intro p
    by_cases h1 : p.1 ∈ B <;> by_cases h2 : p.2 ∈ U <;>
      simp [Set.mem_prod, h1, h2]
  simp_rw [hind]
  rw [Measure.volume_eq_prod,
    lintegral_prod_mul (f := Set.indicator B fun a => h (WithLp.toLp 2 a))
      (g := Set.indicator U fun _ => (1 : ℝ≥0∞))
      ((hh.comp measurable_toLp3).indicator hBm).aemeasurable
      (measurable_const.indicator hUm).aemeasurable,
    lintegral_indicator hBm, lintegral_indicator hUm, setLIntegral_one]
  congr 1
  exact (PiLp.volume_preserving_toLp (Fin 3)).setLIntegral_comp_preimage hS hh


/-! ### Blueprint `prop:restricted-improving-vertex`: the incidence integral of lifted data

On the inner box every translation of the average stays inside the cutoff box, so the indicator of
a lifted set, evaluated at a translated point, is the indicator of the original set at the
translated projection. The incidence integral of the lifted configuration is therefore the
incidence integral on `R^3` times the measure of the inner box in the unused coordinates. -/

open MeasureTheory in
theorem measurable_proj6 : Measurable proj6 := by
  have heq : (proj6 : E6 → E3) = fun x => WithLp.toLp 2 (splitE6 x).1 := by
    funext x
    exact proj6_eq_splitE6 x
  rw [heq]
  exact measurable_toLp3.comp (measurable_fst.comp measurePreserving_splitE6.measurable)

open MeasureTheory in
theorem measurableSet_innerBox (N : ℝ) : MeasurableSet (innerBox N) := by
  rw [innerBox_eq_preimage]
  exact (MeasurableSet.univ_pi fun _ => measurableSet_Icc).preimage
    (measurable_snd.comp measurePreserving_splitE6.measurable)

open MeasureTheory in
theorem measurableSet_boxSet (N : ℝ) : MeasurableSet (boxSet N) := by
  rw [boxSet_eq_preimage]
  exact (MeasurableSet.univ_pi fun _ => measurableSet_Icc).preimage
    (measurable_snd.comp measurePreserving_splitE6.measurable)

theorem indicator_lifted_shift {N : ℝ} (hN : 0 ≤ N) {F : Set E3} {x : E6}
    (hx : x ∈ innerBox N) {t : ℝ} (ht : t ∈ Set.Icc (0 : ℝ) N) (i : Fin 3) :
    Set.indicator (proj6 ⁻¹' F ∩ boxSet N) (fun _ => (1 : ℝ≥0∞)) (x + liftCurve i t)
      = Set.indicator F (fun _ => (1 : ℝ≥0∞)) (proj6 x + curve i t) := by
  have hbox : x + liftCurve i t ∈ boxSet N := mem_boxSet_of_innerBox hN hx ht i
  have hproj : proj6 (x + liftCurve i t) = proj6 x + curve i t := by
    rw [proj6_add, proj6_liftCurve]
  by_cases hmem : proj6 x + curve i t ∈ F
  · rw [Set.indicator_of_mem, Set.indicator_of_mem hmem]
    exact ⟨by rw [Set.mem_preimage, hproj]; exact hmem, hbox⟩
  · rw [Set.indicator_of_notMem, Set.indicator_of_notMem hmem]
    intro hc
    exact hmem (by rw [← hproj]; exact hc.1)

open MeasureTheory in
/-- **The incidence integral of lifted data.** It is the incidence integral on `R^3` times the
measure of the inner box in the unused coordinates. -/
theorem incid_lifted {N : ℝ} (hN : 0 ≤ N) {S : Set E3} (hS : MeasurableSet S)
    {F : Fin 3 → Set E3} (hF : ∀ i, MeasurableSet (F i)) :
    incid N (proj6 ⁻¹' S ∩ innerBox N) (fun i => proj6 ⁻¹' (F i) ∩ boxSet N)
      = (∫⁻ t in Set.Ioc (0 : ℝ) N,
          ∫⁻ y in S, ∏ i, Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (y + curve i t))
        * volume (innerUnusedBox N) := by
  have hcne : volume (innerUnusedBox N) ≠ ⊤ := by
    rw [volume_innerUnusedBox hN]
    exact ENNReal.ofReal_ne_top
  have hTm : MeasurableSet (proj6 ⁻¹' S ∩ innerBox N) :=
    (hS.preimage measurable_proj6).inter (measurableSet_innerBox N)
  rw [incid]
  conv_rhs => rw [← lintegral_mul_const' _ _ hcne]
  refine setLIntegral_congr_fun measurableSet_Ioc fun t ht => ?_
  have htI : t ∈ Set.Icc (0 : ℝ) N := ⟨le_of_lt ht.1, ht.2⟩
  have hh : Measurable fun y : E3 =>
      ∏ i, Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (y + curve i t) :=
    Finset.measurable_prod _ fun i _ =>
      (measurable_const.indicator (hF i)).comp (measurable_id.add_const _)
  have hptw : ∀ x : E6,
      Set.indicator (proj6 ⁻¹' S ∩ innerBox N) (fun _ => (1 : ℝ≥0∞)) x *
          ∏ i, Set.indicator (proj6 ⁻¹' (F i) ∩ boxSet N) (fun _ => (1 : ℝ≥0∞))
            (x + liftCurve i t)
        = Set.indicator (proj6 ⁻¹' S ∩ innerBox N)
            (fun x => ∏ i, Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (proj6 x + curve i t)) x := by
    intro x
    by_cases hx : x ∈ proj6 ⁻¹' S ∩ innerBox N
    · rw [Set.indicator_of_mem hx, Set.indicator_of_mem hx, one_mul]
      exact Finset.prod_congr rfl fun i _ => indicator_lifted_shift hN hx.2 htI i
    · rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem hx, zero_mul]
  calc (∫⁻ x : E6, Set.indicator (proj6 ⁻¹' S ∩ innerBox N) (fun _ => (1 : ℝ≥0∞)) x *
        ∏ i, Set.indicator (proj6 ⁻¹' (F i) ∩ boxSet N) (fun _ => (1 : ℝ≥0∞))
          (x + liftCurve i t))
      = ∫⁻ x in proj6 ⁻¹' S ∩ innerBox N,
          ∏ i, Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (proj6 x + curve i t) := by
        simp_rw [hptw]
        exact lintegral_indicator hTm _
    _ = (∫⁻ y in S, ∏ i, Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (y + curve i t))
          * volume (innerUnusedBox N) := lintegral_lifted_inner hS hh


/-! ### Blueprint `prop:restricted-improving-vertex`: the average as a fibre integral

The modulus of the average of indicators is `N⁻¹` times the measure of the set of parameters for
which all three translates land in their sets. Integrating over a test set and exchanging gives
the incidence integral on `R^3`, which the descent identity ties to the one on the lift. -/

open MeasureTheory in
theorem ofReal_prodShiftR_indicator {F : Fin 3 → Set E3} (x : E3) (t : ℝ) :
    ENNReal.ofReal (prodShiftR (fun i => Set.indicator (F i) fun _ => (1 : ℝ)) x t)
      = ∏ i, Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (x + curve i t) := by
  rw [prodShiftR,
    ENNReal.ofReal_prod_of_nonneg fun i _ =>
      Set.indicator_nonneg (fun _ _ => zero_le_one) _]
  exact Finset.prod_congr rfl fun i _ => ofReal_indicator_enn (F i) _

open MeasureTheory in
/-- **The average of indicators, as a fibre measure.** -/
theorem enorm_A_indicators {N : ℝ} (hN : 0 < N) {F : Fin 3 → Set E3}
    (hF : ∀ i, MeasurableSet (F i)) (x : E3) :
    ‖A N (indicators F) x‖ₑ
      = ENNReal.ofReal N⁻¹ * ∫⁻ t in Set.Ioc (0 : ℝ) N,
          ∏ i, Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (x + curve i t) := by
  set ind : Fin 3 → E3 → ℝ := fun i => Set.indicator (F i) fun _ => (1 : ℝ) with hind
  have hbm : ∀ i, BddMeas (ind i) := fun i => bddMeas_indicator (hF i)
  have hnn : ∀ (i : Fin 3) (y : E3), 0 ≤ ind i y := fun i y => (hbm i).2.1 y
  have hI0 : 0 ≤ ∫ t in (0 : ℝ)..N, prodShiftR ind x t :=
    intervalIntegral.integral_nonneg hN.le fun t _ => prodShiftR_nonneg hnn x t
  have hr : ‖A N (indicators F) x‖ = N⁻¹ * ∫ t in (0 : ℝ)..N, prodShiftR ind x t := by
    rw [indicators_eq_ofReal, A_ofReal, norm_mul, norm_inv, Complex.norm_real,
      Complex.norm_real, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg hN.le,
      abs_of_nonneg hI0]
  have hlin : ENNReal.ofReal (∫ t in (0 : ℝ)..N, prodShiftR ind x t)
      = ∫⁻ t in Set.Ioc (0 : ℝ) N,
          ∏ i, Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (x + curve i t) := by
    rw [intervalIntegral.integral_of_le hN.le,
      ofReal_integral_eq_lintegral_ofReal (intervalIntegrable_prodShiftR hbm x 0 N).1
        (Filter.Eventually.of_forall fun t => prodShiftR_nonneg hnn x t)]
    exact lintegral_congr fun t => ofReal_prodShiftR_indicator x t
  rw [← ofReal_norm, hr, ENNReal.ofReal_mul (by positivity), hlin]


open MeasureTheory in
/-- **The pairing of the average with a test set is the incidence integral on `R^3`.** -/
theorem lintegral_enorm_A_eq {N : ℝ} (hN : 0 < N) {S : Set E3}
    {F : Fin 3 → Set E3} (hF : ∀ i, MeasurableSet (F i)) :
    ∫⁻ y in S, ‖A N (indicators F) y‖ₑ
      = ENNReal.ofReal N⁻¹ * ∫⁻ t in Set.Ioc (0 : ℝ) N,
          ∫⁻ y in S, ∏ i, Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (y + curve i t) := by
  have hjoint : Measurable fun p : E3 × ℝ =>
      ∏ i, Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (p.1 + curve i p.2) :=
    Finset.measurable_prod _ fun i _ =>
      (measurable_const.indicator (hF i)).comp
        (measurable_fst.add ((continuous_curve i).measurable.comp measurable_snd))
  simp_rw [enorm_A_indicators hN hF]
  rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  congr 1
  exact lintegral_lintegral_swap hjoint.aemeasurable


/-! ### Blueprint `prop:restricted-improving-vertex`: the symmetric inequality on the lift

Everything upstream is now available: the refinement tower produces a configuration in which every
set carries the density bound of its own stage, the flow of the itinerary `w^(3)` sends the
resulting parameter tower into the terminal set, and the area formula turns the integrated Jacobian
into the measure of that terminal set. Feeding this into `K_pow_sixty_le_of_symmetric` gives the
symmetric restricted inequality for the four sets of the lift. -/

/-- A product over the three indices, taken in any order. -/
theorem prod_three_perm {j j' k : Fin 3} (hjj' : j ≠ j') (hjk : j ≠ k) (hj'k : j' ≠ k)
    (f : Fin 3 → ℝ≥0∞) : f j * f j' * f k = f 0 * f 1 * f 2 := by
  fin_cases j <;> fin_cases j' <;> fin_cases k <;> simp_all <;> ring

open MeasureTheory in
/-- **Blueprint `prop:restricted-improving-vertex`, the symmetric inequality on the lift.** The
terminal index `m` is the one supplied by the itinerary `wrd`, whose conclusion enters as the
hypothesis `hword`. Here `K` is any lower bound for the normalized incidence integral divided by
`16^r`. -/
theorem K_pow_sixty_incid_of_word {N : ℝ} (hN : 0 < N) {E₀ : Set E6} {E : Fin 3 → Set E6}
    (hE₀m : MeasurableSet E₀) (hEm : ∀ i, MeasurableSet (E i))
    (h₀0 : volume E₀ ≠ 0) (h₀t : volume E₀ ≠ ⊤)
    (hi0 : ∀ i, volume (E i) ≠ 0) (hit : ∀ i, volume (E i) ≠ ⊤)
    {r : ℕ} {K : ℝ≥0∞} (hKt : K ≠ ⊤)
    (hlow : 16 ^ r * (K * ENNReal.ofReal N) ≤ incid N E₀ E)
    {wrd : ℕ → Fin 4} {m j k : Fin 3} (hwm : wrd 6 = m.succ)
    (hjm : j ≠ m) (hkm : k ≠ m) (hjk : j ≠ k)
    (hword : ∀ (G : ℕ → Set E6) (Gi : ℕ → Fin 3 → Set E6),
      (∀ n, MeasurableSet (G n)) → (∀ n i, MeasurableSet (Gi n i)) →
      (∀ n, G (n + 1) ⊆ G n) → (∀ n i, Gi (n + 1) i ⊆ Gi n i) →
      ∀ α : Fin 4 → ℝ, (∀ a, 0 ≤ α a) → (∀ a, α a ≤ 1) → (∀ a, 0 ≤ 1 * α a * N) →
      (∀ n, n < r → ∀ x ∈ G (n + 1), ENNReal.ofReal (1 * α 0 * N) ≤ incidFwd N (Gi n) x) →
      (∀ n, n < r → ∀ i, ∀ y ∈ Gi (n + 1) i,
        ENNReal.ofReal (1 * α i.succ * N) ≤ incidAdj N (G n) (Gi n) i y) →
      ∀ z ∈ cfg4 (G r) (Gi r) (wrd 0),
        ENNReal.ofReal (((2 : ℝ) ^ (18 : ℕ))⁻¹ * (1 : ℝ) ^ (10 : ℕ)
            * (α 0 * α 1 * α 2 * α 3 * N) ^ (10 : ℕ))
          ≤ 2 * volume (cfg4 (G 0) (Gi 0) (wrd 6))) :
    ENNReal.ofReal (((2 : ℝ) ^ (19 : ℕ))⁻¹) * ENNReal.ofReal N ^ (10 : ℕ) * K ^ (60 : ℕ)
      ≤ volume E₀ ^ (10 : ℕ) * volume (E j) ^ (30 : ℕ) * volume (E m) ^ (11 : ℕ)
        * volume (E k) ^ (10 : ℕ) := by
  rcases eq_or_ne K 0 with rfl | hK0
  · simp
  have hNne : ENNReal.ofReal N ≠ 0 := (ENNReal.ofReal_pos.mpr hN).ne'
  have hcan2 : ∀ x y : ℝ≥0∞, 2 * x ≤ 2 * y → x ≤ y := by
    intro x y h
    have h3 := mul_le_mul' (le_refl (2⁻¹ : ℝ≥0∞)) h
    rwa [← mul_assoc, ← mul_assoc,
      ENNReal.inv_mul_cancel (by norm_num) (by norm_num), one_mul, one_mul] at h3
  have hcancel : ∀ m : ℝ≥0∞, K * ENNReal.ofReal N ≤ ENNReal.ofReal N * m → K ≤ m := by
    intro m hm
    have h2 : ENNReal.ofReal N * K ≤ ENNReal.ofReal N * m := by
      rwa [mul_comm (ENNReal.ofReal N) K]
    have h3 := mul_le_mul' (le_refl (ENNReal.ofReal N)⁻¹) h2
    rwa [← mul_assoc, ← mul_assoc,
      ENNReal.inv_mul_cancel hNne ENNReal.ofReal_ne_top, one_mul, one_mul] at h3
  have hBt : K * ENNReal.ofReal N ≠ ⊤ := ENNReal.mul_ne_top hKt ENNReal.ofReal_ne_top
  have hB : K * ENNReal.ofReal N ≤ incid N E₀ E :=
    le_trans (le_mul_of_one_le_left' (one_le_pow_sixteen r)) hlow
  obtain ⟨hv0, hvi⟩ := volume_ge_of_incid_ge N hE₀m hEm hB
  have hK₀ : K ≤ volume E₀ := hcancel _ hv0
  have hKi : ∀ i, K ≤ volume (E i) := fun i => hcancel _ (hvi i)
  set a0 : ℝ≥0∞ := K / volume E₀ with ha0def
  set ai : Fin 3 → ℝ≥0∞ := fun i => K / volume (E i) with haidef
  have ha0mul : a0 * volume E₀ = K := ENNReal.div_mul_cancel h₀0 h₀t
  have haimul : ∀ i, ai i * volume (E i) = K := fun i => ENNReal.div_mul_cancel (hi0 i) (hit i)
  have ha0t : a0 ≠ ⊤ := ENNReal.div_ne_top hKt h₀0
  have hait : ∀ i, ai i ≠ ⊤ := fun i => ENNReal.div_ne_top hKt (hi0 i)
  have ha01 : a0 ≤ 1 := ENNReal.div_le_of_le_mul (by rw [one_mul]; exact hK₀)
  have hai1 : ∀ i, ai i ≤ 1 := fun i => ENNReal.div_le_of_le_mul (by rw [one_mul]; exact hKi i)
  have hd0 : dens4 a0 ai 0 = a0 := rfl
  have hd1 : dens4 a0 ai 1 = ai 0 := rfl
  have hd2 : dens4 a0 ai 2 = ai 1 := rfl
  have hd3 : dens4 a0 ai 3 = ai 2 := rfl
  set α : Fin 4 → ℝ := fun a => (dens4 a0 ai a).toReal with hαdef
  have hαd : ∀ a, ENNReal.ofReal (α a) = dens4 a0 ai a := by
    intro a
    rcases Fin.eq_zero_or_eq_succ a with rfl | ⟨i, rfl⟩
    · exact ENNReal.ofReal_toReal ha0t
    · exact ENNReal.ofReal_toReal (hait i)
  have hα0 : ∀ a, 0 ≤ α a := fun _ => ENNReal.toReal_nonneg
  have hα1 : ∀ a, α a ≤ 1 := by
    intro a
    have hle : dens4 a0 ai a ≤ 1 := by
      rcases Fin.eq_zero_or_eq_succ a with rfl | ⟨i, rfl⟩
      · rw [hd0]; exact ha01
      · exact hai1 i
    have hmt := ENNReal.toReal_mono ENNReal.one_ne_top hle
    simpa [hαdef] using hmt
  have hcN : ∀ a, 0 ≤ 1 * α a * N := fun a =>
    mul_nonneg (by rw [one_mul]; exact hα0 a) hN.le
  have hdens : ∀ a, ENNReal.ofReal (1 * α a * N) = dens4 a0 ai a * ENNReal.ofReal N := by
    intro a
    rw [one_mul, ENNReal.ofReal_mul (hα0 a), hαd a]
  have h1 : ENNReal.ofReal (1 * α 0 * N) * volume E₀ ≤ K * ENNReal.ofReal N := by
    refine le_of_eq ?_
    rw [hdens 0, hd0]
    calc a0 * ENNReal.ofReal N * volume E₀ = a0 * volume E₀ * ENNReal.ofReal N := by ring
      _ = K * ENNReal.ofReal N := by rw [ha0mul]
  have h2 : ∀ i : Fin 3,
      ENNReal.ofReal (1 * α i.succ * N) * volume (E i) ≤ K * ENNReal.ofReal N := by
    intro i
    refine le_of_eq ?_
    rw [hdens i.succ]
    have hdsucc : dens4 a0 ai i.succ = ai i := rfl
    rw [hdsucc]
    calc ai i * ENNReal.ofReal N * volume (E i) = ai i * volume (E i) * ENNReal.ofReal N := by
          ring
      _ = K * ENNReal.ofReal N := by rw [haimul i]
  obtain ⟨G, Gi, hG0, hGi0, hGm, hGim, hGdec, hGidec, hfwd, hadj, hinc⟩ :=
    refinement_tower N hBt (c₀ := ENNReal.ofReal (1 * α 0 * N))
      (c := fun i => ENNReal.ofReal (1 * α i.succ * N)) r E₀ E hE₀m hEm h1 h2 hlow
  have hincr := hinc r le_rfl
  rw [Nat.sub_self, pow_zero, one_mul] at hincr
  obtain ⟨hn0, hni⟩ :=
    nonempty_of_incid_ge N (hGm r) (hGim r) (mul_ne_zero hK0 hNne) hincr
  have hzne : (cfg4 (G r) (Gi r) (wrd 0)).Nonempty := by
    rcases Fin.eq_zero_or_eq_succ (wrd 0) with hw | ⟨i, hw⟩
    · rw [hw]
      exact hn0
    · rw [hw]
      exact hni i
  obtain ⟨z, hz⟩ := hzne
  have hterm := hword G Gi hGm hGim hGdec hGidec α hα0 hα1 hcN hfwd hadj z hz
  rw [hG0, hGi0] at hterm
  have hcfg6 : cfg4 E₀ E (wrd 6) = E m := by
    rw [hwm]
    simp [cfg4]
  rw [hcfg6, one_pow, mul_one] at hterm
  have hPeq : ENNReal.ofReal (α 0 * α 1 * α 2 * α 3 * N)
      = a0 * ai 0 * ai 1 * ai 2 * ENNReal.ofReal N := by
    have n0 : (0 : ℝ) ≤ α 0 * α 1 * α 2 * α 3 :=
      mul_nonneg (mul_nonneg (mul_nonneg (hα0 0) (hα0 1)) (hα0 2)) (hα0 3)
    have n1 : (0 : ℝ) ≤ α 0 * α 1 * α 2 := mul_nonneg (mul_nonneg (hα0 0) (hα0 1)) (hα0 2)
    have n2 : (0 : ℝ) ≤ α 0 * α 1 := mul_nonneg (hα0 0) (hα0 1)
    rw [ENNReal.ofReal_mul n0, ENNReal.ofReal_mul n1, ENNReal.ofReal_mul n2,
      ENNReal.ofReal_mul (hα0 0), hαd 0, hαd 1, hαd 2, hαd 3, hd0, hd1, hd2, hd3]
  have hterm2 : ENNReal.ofReal (((2 : ℝ) ^ (18 : ℕ))⁻¹)
        * (a0 * ai 0 * ai 1 * ai 2 * ENNReal.ofReal N) ^ (10 : ℕ)
      ≤ 2 * volume (E m) := by
    rw [← hPeq, ← ENNReal.ofReal_pow (by positivity),
      ← ENNReal.ofReal_mul (by positivity)]
    exact hterm
  have hc18 : ENNReal.ofReal (((2 : ℝ) ^ (18 : ℕ))⁻¹)
      = 2 * ENNReal.ofReal (((2 : ℝ) ^ (19 : ℕ))⁻¹) := by
    have hr19 : ((2 : ℝ) ^ (18 : ℕ))⁻¹ = 2 * ((2 : ℝ) ^ (19 : ℕ))⁻¹ := by norm_num
    rw [hr19, ENNReal.ofReal_mul (by norm_num)]
    norm_num
  have hperm : ai j * ai m * ai k = ai 0 * ai 1 * ai 2 :=
    prod_three_perm hjm hjk (Ne.symm hkm) ai
  have hsym : ENNReal.ofReal (((2 : ℝ) ^ (19 : ℕ))⁻¹)
        * (a0 * ai j * ai m * ai k * ENNReal.ofReal N) ^ (10 : ℕ)
      ≤ volume (E m) := by
