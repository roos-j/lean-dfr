/-! ### Blueprint `prop:restricted-improving-vertex`: the descent to `R^3`

The incidence integral of the lifted configuration is the pairing of the average on `R^3` with the
test set, times `N^5`: one factor `N` from the normalization of the average and four from the
inner box in the unused coordinates. -/

open MeasureTheory in
/-- **The incidence integral of the lifted configuration**, in terms of the pairing of the average
on `R^3` with the test set. -/
theorem incid_lift_eq {N : ℝ} (hN : 0 < N) {S : Set E3} (hS : MeasurableSet S)
    {F : Fin 3 → Set E3} (hF : ∀ i, MeasurableSet (F i)) :
    incid N (proj6 ⁻¹' S ∩ innerBox N) (fun i => proj6 ⁻¹' (F i) ∩ boxSet N)
      = (∫⁻ y in S, ‖A N (indicators F) y‖ₑ) * ENNReal.ofReal (N ^ 5) := by
  have hI : ENNReal.ofReal N * ∫⁻ y in S, ‖A N (indicators F) y‖ₑ
      = ∫⁻ t in Set.Ioc (0 : ℝ) N, ∫⁻ y in S,
          ∏ i, Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (y + curve i t) := by
    rw [lintegral_enorm_A_eq hN hF, ← mul_assoc, ← ENNReal.ofReal_mul hN.le,
      mul_inv_cancel₀ hN.ne', ENNReal.ofReal_one, one_mul]
  have hN5 : (N : ℝ) ^ 5 = N * N ^ 4 := by ring
  rw [incid_lifted hN.le hS hF, volume_innerUnusedBox hN.le, ← hI, hN5,
    ENNReal.ofReal_mul hN.le]
  ring

/-- The indicator of one is at most one, on `E3`. -/
theorem indicator_one_le_one3 (S : Set E3) (y : E3) :
    Set.indicator S (fun _ => (1 : ℝ≥0∞)) y ≤ 1 := by
  by_cases hy : y ∈ S
  · rw [Set.indicator_of_mem hy]
  · rw [Set.indicator_of_notMem hy]
    exact zero_le_one

open MeasureTheory in
/-- The average of indicators has modulus at most one. -/
theorem enorm_A_indicators_le_one {N : ℝ} (hN : 0 < N) {F : Fin 3 → Set E3}
    (hF : ∀ i, MeasurableSet (F i)) (y : E3) : ‖A N (indicators F) y‖ₑ ≤ 1 := by
  have hfib : (∫⁻ t in Set.Ioc (0 : ℝ) N,
      ∏ i, Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (y + curve i t)) ≤ ENNReal.ofReal N := by
    calc (∫⁻ t in Set.Ioc (0 : ℝ) N,
          ∏ i, Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (y + curve i t))
        ≤ ∫⁻ _ in Set.Ioc (0 : ℝ) N, (1 : ℝ≥0∞) :=
          lintegral_mono fun t => Finset.prod_le_one fun i _ => indicator_one_le_one3 (F i) _
      _ = ENNReal.ofReal N := by
          rw [setLIntegral_one, Real.volume_Ioc, sub_zero]
  rw [enorm_A_indicators hN hF]
  calc ENNReal.ofReal N⁻¹ * ∫⁻ t in Set.Ioc (0 : ℝ) N,
        ∏ i, Set.indicator (F i) (fun _ => (1 : ℝ≥0∞)) (y + curve i t)
      ≤ ENNReal.ofReal N⁻¹ * ENNReal.ofReal N := mul_le_mul' le_rfl hfib
    _ = 1 := by
        rw [← ENNReal.ofReal_mul (by positivity), inv_mul_cancel₀ hN.ne', ENNReal.ofReal_one]

open MeasureTheory in
/-- The pairing of the average with a test set of finite measure is finite. -/
theorem lintegral_enorm_A_ne_top {N : ℝ} (hN : 0 < N) {S : Set E3} (hSt : volume S ≠ ⊤)
    {F : Fin 3 → Set E3} (hF : ∀ i, MeasurableSet (F i)) :
    (∫⁻ y in S, ‖A N (indicators F) y‖ₑ) ≠ ⊤ := by
  refine ne_top_of_le_ne_top hSt ?_
  calc (∫⁻ y in S, ‖A N (indicators F) y‖ₑ) ≤ ∫⁻ _ in S, (1 : ℝ≥0∞) :=
        lintegral_mono fun y => enorm_A_indicators_le_one hN hF y
    _ = volume S := setLIntegral_one _


/-! ### Blueprint `prop:restricted-improving-vertex`: the descent inequality

Lifting the test set and the three input sets, applying the symmetric inequality on the lift, and
undoing the measures of the boxes gives the sixtieth power of the pairing on `R^3`. The powers of
`N` are `250` on the left and `244` on the right, leaving the promised `N^6`. -/
theorem enn_le_of_mul_le_mul {c x y : ℝ≥0∞} (hc0 : c ≠ 0) (hct : c ≠ ⊤) (h : c * x ≤ c * y) :
    x ≤ y := by
  have h3 := mul_le_mul' (le_refl c⁻¹) h
  rwa [← mul_assoc, ← mul_assoc, ENNReal.inv_mul_cancel hc0 hct, one_mul, one_mul] at h3

theorem enn_le_mul_of_inv_mul_le {c x y : ℝ≥0∞} (hc0 : c ≠ 0) (hct : c ≠ ⊤)
    (h : c⁻¹ * x ≤ y) : x ≤ c * y := by
  have h3 := mul_le_mul' (le_refl c) h
  rwa [← mul_assoc, ENNReal.mul_inv_cancel hc0 hct, one_mul] at h3

