  exact ((mul_le_of_le_one_left (norm_nonneg _) (hF _)).trans (hF _))

open MeasureTheory in
/-- **Exchanging the interval integral with the second shift integral.** -/
theorem integral_swap_interval_pair {F : ℝ → ℂ} (hFm : Measurable F) (hF : ∀ t, ‖F t‖ ≤ 1)
    {N H : ℝ} (hN : 0 ≤ N) (hH : 0 ≤ H) (c a : ℝ) :
    (∫ t in c..(c + N), ∫ b in (0 : ℝ)..H, F (t + a) * (starRingEnd ℂ) (F (t + b)))
      = ∫ b in (0 : ℝ)..H, ∫ t in c..(c + N), F (t + a) * (starRingEnd ℂ) (F (t + b)) := by
  have hle : c ≤ c + N := by linarith
  simp_rw [intervalIntegral.integral_of_le hle, intervalIntegral.integral_of_le hH]
