    {Gi : ℕ → Fin 3 → Set E6}
    (hGm : ∀ k, MeasurableSet (G k)) (hGim : ∀ k i, MeasurableSet (Gi k i))
    (hGdec : ∀ k, G (k + 1) ⊆ G k) (hGidec : ∀ k i, Gi (k + 1) i ⊆ Gi k i)
    {r : ℕ} (hr : 6 ≤ r) {α : Fin 4 → ℝ} (hα0 : ∀ i, 0 ≤ α i) (hα1 : ∀ i, α i ≤ 1)
    (hcN : ∀ i, 0 ≤ cst * α i * N)
    (hfwd : ∀ k, k < r → ∀ x ∈ G (k + 1),
      ENNReal.ofReal (cst * α 0 * N) ≤ incidFwd N (Gi k) x)
    (hadj : ∀ k, k < r → ∀ i, ∀ y ∈ Gi (k + 1) i,
      ENNReal.ofReal (cst * α i.succ * N) ≤ incidAdj N (G k) (Gi k) i y)
    {z : E6} (hz : z ∈ cfg4 (G r) (Gi r) (word3 0)) :
    ENNReal.ofReal (((2 : ℝ) ^ (18 : ℕ))⁻¹ * cst ^ (10 : ℕ)
        * (α 0 * α 1 * α 2 * α 3 * N) ^ (10 : ℕ))
      ≤ 2 * volume (cfg4 (G 0) (Gi 0) (word3 6)) := by
  obtain ⟨b1, b2, b3, b4, b5, b6⟩ :=
    towA_fibre_bounds N hGm hGim hr hfwd hadj word3_isItinerary hz
