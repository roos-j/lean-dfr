/-! ### Patch 1 `lem:integrated` for `w^(2)`

`w^(2) = (1,3,0,3,2,0,2)` has blocks `B_1 = {0}`, `B_3 = {1,2,3}`, `B_2 = {4,5}`, so the moves
carrying Vandermonde factors are `2` (one), `3` (two) and `5` (one), and
`(m_l + 1) = (1,1,2,3,1,2)` as `Auto.mCount_word2_values` computes. This is the word whose
derivative is block lower triangular but not block diagonal; the integration does not see the
difference, since only the diagonal blocks enter the determinant. -/
noncomputable def mg1 : ℝ → ℝ≥0∞ := fun _ => 1
noncomputable def mg2 : ℝ → ℝ → ℝ≥0∞ := fun _ _ => 1
noncomputable def mg3 : ℝ → ℝ → ℝ → ℝ≥0∞ := fun _ b c => ENNReal.ofReal |c - b|
noncomputable def mg4 : ℝ → ℝ → ℝ → ℝ → ℝ≥0∞ :=
  fun _ b c d => ENNReal.ofReal |d - b| * ENNReal.ofReal |d - c|
noncomputable def mg5 : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ≥0∞ := fun _ _ _ _ _ => 1
noncomputable def mg6 : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ≥0∞ :=
  fun _ _ _ _ e f => ENNReal.ofReal |f - e|

/-- **The six per-move factors of `w^(2)` are dominated by its Jacobian.** -/
theorem jacWeight2_le (s : E6) :
    mg1 (s 0) * (mg2 (s 0) (s 1) * (mg3 (s 0) (s 1) (s 2) * (mg4 (s 0) (s 1) (s 2) (s 3) *
      (mg5 (s 0) (s 1) (s 2) (s 3) (s 4) * mg6 (s 0) (s 1) (s 2) (s 3) (s 4) (s 5)))))
      ≤ ENNReal.ofReal |LinearMap.det ((flowDeriv2 s : E6 →L[ℝ] E6) : E6 →ₗ[ℝ] E6)| := by
  rw [abs_det_flowDeriv2]
  simp only [mg1, mg2, mg3, mg4, mg5, mg6, one_mul]
  have p1 : (0 : ℝ) ≤ |s 2 - s 1| * |s 3 - s 1| * |s 3 - s 2| := by positivity
  have p2 : (0 : ℝ) ≤ |s 2 - s 1| * |s 3 - s 1| := by positivity
  have hL : ENNReal.ofReal |s 2 - s 1| * (ENNReal.ofReal |s 3 - s 1| * ENNReal.ofReal |s 3 - s 2|
      * ENNReal.ofReal |s 5 - s 4|)
      = ENNReal.ofReal (|s 2 - s 1| * |s 3 - s 1| * |s 3 - s 2| * |s 5 - s 4|) := by
    rw [ENNReal.ofReal_mul p1, ENNReal.ofReal_mul p2, ENNReal.ofReal_mul (abs_nonneg _)]
    ring
  rw [hL]
  refine ENNReal.ofReal_le_ofReal ?_
  have h1 : |s 2 - s 1| = |s 1 - s 2| := abs_sub_comm _ _
  have h2 : |s 3 - s 1| = |s 1 - s 3| := abs_sub_comm _ _
  have h3 : |s 3 - s 2| = |s 2 - s 3| := abs_sub_comm _ _
  have h4 : |s 5 - s 4| = |s 4 - s 5| := abs_sub_comm _ _
  rw [h1, h2, h3, h4]
  nlinarith [abs_nonneg (s 1 - s 2), abs_nonneg (s 1 - s 3), abs_nonneg (s 2 - s 3),
    abs_nonneg (s 4 - s 5),
    mul_nonneg (mul_nonneg (mul_nonneg (abs_nonneg (s 4 - s 5)) (abs_nonneg (s 1 - s 2)))
      (abs_nonneg (s 1 - s 3))) (abs_nonneg (s 2 - s 3))]

open MeasureTheory in
/-- **Patch 1 `lem:integrated` for `w^(2)`: the six steps composed.** -/
theorem lintegral_jacWeight2_flowTower_ge (N : ℝ) {G : ℕ → Set E6} {Gi : ℕ → Fin 3 → Set E6}
    (hGm : ∀ k, MeasurableSet (G k)) (hGim : ∀ k i, MeasurableSet (Gi k i)) (r : ℕ) (z : E6)
    {a : ℕ → ℝ} (ha : ∀ l, 0 ≤ a l * N)
    (hf1 : ENNReal.ofReal (a 0 * N) ≤ volume (towA1 N G Gi r word2 z))
    (hf2 : ∀ x ∈ towA1 N G Gi r word2 z,
      ENNReal.ofReal (a 1 * N) ≤ volume (towA2 N G Gi r word2 z x))
    (hf3 : ∀ x ∈ towA1 N G Gi r word2 z, ∀ y ∈ towA2 N G Gi r word2 z x,
      ENNReal.ofReal (a 2 * N) ≤ volume (towA3 N G Gi r word2 z x y))
    (hf4 : ∀ x ∈ towA1 N G Gi r word2 z, ∀ y ∈ towA2 N G Gi r word2 z x,
      ∀ u ∈ towA3 N G Gi r word2 z x y,
      ENNReal.ofReal (a 3 * N) ≤ volume (towA4 N G Gi r word2 z x y u))
    (hf5 : ∀ x ∈ towA1 N G Gi r word2 z, ∀ y ∈ towA2 N G Gi r word2 z x,
      ∀ u ∈ towA3 N G Gi r word2 z x y, ∀ v ∈ towA4 N G Gi r word2 z x y u,
      ENNReal.ofReal (a 4 * N) ≤ volume (towA5 N G Gi r word2 z x y u v))
    (hf6 : ∀ x ∈ towA1 N G Gi r word2 z, ∀ y ∈ towA2 N G Gi r word2 z x,
      ∀ u ∈ towA3 N G Gi r word2 z x y, ∀ v ∈ towA4 N G Gi r word2 z x y u,
      ∀ t ∈ towA5 N G Gi r word2 z x y u v,
      ENNReal.ofReal (a 5 * N) ≤ volume (towA6 N G Gi r word2 z x y u v t)) :
    ENNReal.ofReal (2⁻¹ * (a 0 * N)) * ENNReal.ofReal (2⁻¹ * (a 1 * N))
        * ENNReal.ofReal (2⁻¹ * (8 : ℝ)⁻¹ * (a 2 * N) ^ 2)
        * ENNReal.ofReal (2⁻¹ * ((8 : ℝ)⁻¹) ^ 2 * (a 3 * N) ^ 3)
        * ENNReal.ofReal (2⁻¹ * (a 4 * N))
        * ENNReal.ofReal (2⁻¹ * (8 : ℝ)⁻¹ * (a 5 * N) ^ 2)
      ≤ ∫⁻ p in flowTower N G Gi r word2 z,
        mg1 p.1 * (mg2 p.1 p.2.1 * (mg3 p.1 p.2.1 p.2.2.1 *
          (mg4 p.1 p.2.1 p.2.2.1 p.2.2.2.1 * (mg5 p.1 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2.1 *
            mg6 p.1 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2.1 p.2.2.2.2.2)))) := by
  obtain ⟨hA1, hA2, hA3, hA4, hA5, hA6⟩ := measurableSet_towA N hGm hGim r word2 z
  have h1 : ENNReal.ofReal (2⁻¹ * (a 0 * N))
      ≤ ∫⁻ x in towA1 N G Gi r word2 z, mg1 x := by
    have h := lintegral_prod_dist_ge hA1 hf1 (m := 0) (by norm_num) ![] (ha 0)
    simpa [mg1] using h
  have h2 : ∀ x ∈ towA1 N G Gi r word2 z, ENNReal.ofReal (2⁻¹ * (a 1 * N))
      ≤ ∫⁻ y in towA2 N G Gi r word2 z x, mg2 x y := by
    intro x hx
    have h := lintegral_prod_dist_ge (hA2 x) (hf2 x hx) (m := 0) (by norm_num) ![] (ha 1)
    simpa [mg2] using h
  have h3 : ∀ x ∈ towA1 N G Gi r word2 z, ∀ y ∈ towA2 N G Gi r word2 z x,
      ENNReal.ofReal (2⁻¹ * (8 : ℝ)⁻¹ * (a 2 * N) ^ 2)
        ≤ ∫⁻ c in towA3 N G Gi r word2 z x y, mg3 x y c := by
    intro x hx y hy
    have h := lintegral_prod_dist_ge (hA3 x y) (hf3 x hx y hy) (m := 1) (by norm_num) ![y] (ha 2)
    simpa [mg3, Fin.prod_univ_one] using h
  have h4 : ∀ x ∈ towA1 N G Gi r word2 z, ∀ y ∈ towA2 N G Gi r word2 z x,
      ∀ c ∈ towA3 N G Gi r word2 z x y,
      ENNReal.ofReal (2⁻¹ * ((8 : ℝ)⁻¹) ^ 2 * (a 3 * N) ^ 3)
        ≤ ∫⁻ d in towA4 N G Gi r word2 z x y c, mg4 x y c d := by
    intro x hx y hy c hc
    have h := lintegral_prod_dist_ge (hA4 x y c) (hf4 x hx y hy c hc)
      (m := 2) le_rfl ![y, c] (ha 3)
    simpa [mg4, Fin.prod_univ_two] using h
  have h5 : ∀ x ∈ towA1 N G Gi r word2 z, ∀ y ∈ towA2 N G Gi r word2 z x,
      ∀ c ∈ towA3 N G Gi r word2 z x y, ∀ d ∈ towA4 N G Gi r word2 z x y c,
      ENNReal.ofReal (2⁻¹ * (a 4 * N))
        ≤ ∫⁻ e in towA5 N G Gi r word2 z x y c d, mg5 x y c d e := by
    intro x hx y hy c hc d hd
    have h := lintegral_prod_dist_ge (hA5 x y c d) (hf5 x hx y hy c hc d hd)
      (m := 0) (by norm_num) ![] (ha 4)
    simpa [mg5] using h
  have h6 : ∀ x ∈ towA1 N G Gi r word2 z, ∀ y ∈ towA2 N G Gi r word2 z x,
      ∀ c ∈ towA3 N G Gi r word2 z x y, ∀ d ∈ towA4 N G Gi r word2 z x y c,
      ∀ e ∈ towA5 N G Gi r word2 z x y c d,
      ENNReal.ofReal (2⁻¹ * (8 : ℝ)⁻¹ * (a 5 * N) ^ 2)
        ≤ ∫⁻ f in towA6 N G Gi r word2 z x y c d e, mg6 x y c d e f := by
    intro x hx y hy c hc d hd e he
    have h := lintegral_prod_dist_ge (hA6 x y c d e) (hf6 x hx y hy c hc d hd e he)
      (m := 1) (by norm_num) ![e]
      (ha 5)
    simpa [mg6, Fin.prod_univ_one] using h
  exact lintegral_tower6_ge ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top
    ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top hA1 hA2 hA3 hA4 hA5
    (fun x y c d => measurableSet_towerCons5 N hGm hGim r word2 z x y c d)
    (fun x y c => measurableSet_towerCons4 N hGm hGim r word2 z x y c)
    (fun x y => measurableSet_towerCons3 N hGm hGim r word2 z x y)
    (fun x => measurableSet_towerCons2 N hGm hGim r word2 z x)
    (measurableSet_flowTower N hGm hGim r word2 z)
    (fun x y c d => by simp only [mg5, mg6]; fun_prop)
    (fun x y c => by simp only [mg4, mg5, mg6]; fun_prop)
    (fun x y => by simp only [mg3, mg4, mg5, mg6]; fun_prop)
    (fun x => by simp only [mg2, mg3, mg4, mg5, mg6]; fun_prop)
    (by simp only [mg1, mg2, mg3, mg4, mg5, mg6]; fun_prop)
    h1 h2 h3 h4 h5 h6


/-! ### Patch 1 `lem:integrated` for `w^(2)`: the bound on the lift and the terminal set -/

open MeasureTheory in
/-- The integral of the Jacobian of `w^(2)` over its parameter set is at least the product of the
six per-step bounds. -/
theorem lintegral_absDet2_flowParamSet_ge (N : ℝ) {G : ℕ → Set E6} {Gi : ℕ → Fin 3 → Set E6}
    (hGm : ∀ k, MeasurableSet (G k)) (hGim : ∀ k i, MeasurableSet (Gi k i)) (r : ℕ) (z : E6)
    {a : ℕ → ℝ} (ha : ∀ l, 0 ≤ a l * N)
    (hf1 : ENNReal.ofReal (a 0 * N) ≤ volume (towA1 N G Gi r word2 z))
    (hf2 : ∀ x ∈ towA1 N G Gi r word2 z,
      ENNReal.ofReal (a 1 * N) ≤ volume (towA2 N G Gi r word2 z x))
    (hf3 : ∀ x ∈ towA1 N G Gi r word2 z, ∀ y ∈ towA2 N G Gi r word2 z x,
      ENNReal.ofReal (a 2 * N) ≤ volume (towA3 N G Gi r word2 z x y))
    (hf4 : ∀ x ∈ towA1 N G Gi r word2 z, ∀ y ∈ towA2 N G Gi r word2 z x,
      ∀ u ∈ towA3 N G Gi r word2 z x y,
      ENNReal.ofReal (a 3 * N) ≤ volume (towA4 N G Gi r word2 z x y u))
    (hf5 : ∀ x ∈ towA1 N G Gi r word2 z, ∀ y ∈ towA2 N G Gi r word2 z x,
      ∀ u ∈ towA3 N G Gi r word2 z x y, ∀ v ∈ towA4 N G Gi r word2 z x y u,
      ENNReal.ofReal (a 4 * N) ≤ volume (towA5 N G Gi r word2 z x y u v))
    (hf6 : ∀ x ∈ towA1 N G Gi r word2 z, ∀ y ∈ towA2 N G Gi r word2 z x,
      ∀ u ∈ towA3 N G Gi r word2 z x y, ∀ v ∈ towA4 N G Gi r word2 z x y u,
      ∀ t ∈ towA5 N G Gi r word2 z x y u v,
      ENNReal.ofReal (a 5 * N) ≤ volume (towA6 N G Gi r word2 z x y u v t)) :
    ENNReal.ofReal (2⁻¹ * (a 0 * N)) * ENNReal.ofReal (2⁻¹ * (a 1 * N))
        * ENNReal.ofReal (2⁻¹ * (8 : ℝ)⁻¹ * (a 2 * N) ^ 2)
        * ENNReal.ofReal (2⁻¹ * ((8 : ℝ)⁻¹) ^ 2 * (a 3 * N) ^ 3)
        * ENNReal.ofReal (2⁻¹ * (a 4 * N))
        * ENNReal.ofReal (2⁻¹ * (8 : ℝ)⁻¹ * (a 5 * N) ^ 2)
      ≤ ∫⁻ s in flowParamSet N G Gi r word2 z,
        ENNReal.ofReal |LinearMap.det ((flowDeriv2 s : E6 →L[ℝ] E6) : E6 →ₗ[ℝ] E6)| := by
  have hwm : Measurable fun p : ℝ × ℝ × ℝ × ℝ × ℝ × ℝ =>
      mg1 p.1 * (mg2 p.1 p.2.1 * (mg3 p.1 p.2.1 p.2.2.1 *
        (mg4 p.1 p.2.1 p.2.2.1 p.2.2.2.1 * (mg5 p.1 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2.1 *
          mg6 p.1 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2.1 p.2.2.2.2.2)))) := by
    simp only [mg1, mg2, mg3, mg4, mg5, mg6]
    fun_prop
  refine le_trans (lintegral_jacWeight2_flowTower_ge N hGm hGim r z ha hf1 hf2 hf3 hf4 hf5 hf6) ?_
  rw [← lintegral_e6ToProd_preimage (measurableSet_flowTower N hGm hGim r word2 z) hwm,
    preimage_flowTower]
  exact setLIntegral_mono' (measurableSet_flowParamSet N hGm hGim r word2 z)
    fun s _ => jacWeight2_le s

/-- The noncritical set of the flow of `w^(2)`. -/
def ndSet2 : Set E6 :=
  {s : E6 | s 4 ≠ s 5 ∧ (s 1 - s 2) * (s 2 - s 3) ≠ 0 ∧ s 1 ≠ s 3}

open MeasureTheory in
theorem measurableSet_ndSet2 : MeasurableSet ndSet2 := by
  have h45 : MeasurableSet {s : E6 | s 4 ≠ s 5} :=
    (measurableSet_eq_fun (continuous_E6_coord 4).measurable
      (continuous_E6_coord 5).measurable).compl
  have h13 : MeasurableSet {s : E6 | s 1 ≠ s 3} :=
    (measurableSet_eq_fun (continuous_E6_coord 1).measurable
      (continuous_E6_coord 3).measurable).compl
  have hmul : MeasurableSet {s : E6 | (s 1 - s 2) * (s 2 - s 3) ≠ 0} := by
    have hc : Measurable fun s : E6 => (s 1 - s 2) * (s 2 - s 3) :=
      (((continuous_E6_coord 1).sub (continuous_E6_coord 2)).mul
        ((continuous_E6_coord 2).sub (continuous_E6_coord 3))).measurable
    exact (measurableSet_eq_fun hc measurable_const).compl
  exact h45.inter (hmul.inter h13)

theorem absDet_flowDeriv2_eq_zero {s : E6} (h : s ∉ ndSet2) :
    |LinearMap.det ((flowDeriv2 s : E6 →L[ℝ] E6) : E6 →ₗ[ℝ] E6)| = 0 := by
  rw [abs_det_flowDeriv2]
  rw [ndSet2, Set.mem_ofPred_eq] at h
  rcases not_and_or.mp h with h1 | h2
  · rw [not_not] at h1
    rw [abs_eq_zero.mpr (sub_eq_zero.mpr h1)]
    ring
  · rcases not_and_or.mp h2 with h3 | h4
    · rw [not_not] at h3
      rcases mul_eq_zero.mp h3 with h5 | h6
      · rw [abs_eq_zero.mpr h5]
        ring
      · rw [abs_eq_zero.mpr h6]
        ring
    · rw [not_not] at h4
      rw [abs_eq_zero.mpr (sub_eq_zero.mpr h4)]
      ring

open MeasureTheory in
theorem lintegral_absDet2_eq_ndSet2 (N : ℝ) {G : ℕ → Set E6} {Gi : ℕ → Fin 3 → Set E6}
    (hGm : ∀ k, MeasurableSet (G k)) (hGim : ∀ k i, MeasurableSet (Gi k i)) (r : ℕ) (z : E6) :
    ∫⁻ s in flowParamSet N G Gi r word2 z,
        ENNReal.ofReal |LinearMap.det ((flowDeriv2 s : E6 →L[ℝ] E6) : E6 →ₗ[ℝ] E6)|
      = ∫⁻ s in flowParamSet N G Gi r word2 z ∩ ndSet2,
        ENNReal.ofReal |LinearMap.det ((flowDeriv2 s : E6 →L[ℝ] E6) : E6 →ₗ[ℝ] E6)| := by
  have hmd : MeasurableSet (flowParamSet N G Gi r word2 z \ ndSet2) :=
    (measurableSet_flowParamSet N hGm hGim r word2 z).diff measurableSet_ndSet2
  have hle : ∫⁻ s in flowParamSet N G Gi r word2 z \ ndSet2,
      ENNReal.ofReal |LinearMap.det ((flowDeriv2 s : E6 →L[ℝ] E6) : E6 →ₗ[ℝ] E6)|
        ≤ ∫⁻ _s in flowParamSet N G Gi r word2 z \ ndSet2, (0 : ℝ≥0∞) :=
    setLIntegral_mono' hmd fun s hs => by
      rw [absDet_flowDeriv2_eq_zero hs.2, ENNReal.ofReal_zero]
  have hzero : ∫⁻ s in flowParamSet N G Gi r word2 z \ ndSet2,
      ENNReal.ofReal |LinearMap.det ((flowDeriv2 s : E6 →L[ℝ] E6) : E6 →ₗ[ℝ] E6)| = 0 := by
    simpa using hle
  rw [← lintegral_inter_add_sdiff _ _ measurableSet_ndSet2, hzero, add_zero]

open MeasureTheory in
/-- **Patch 1 `lem:integrated` for `w^(2)`: the terminal set is large.** With this the patch's
`lem:integrated` holds for all three terminal indices. -/
theorem measure_terminal_ge_word2 (N : ℝ) {G : ℕ → Set E6} {Gi : ℕ → Fin 3 → Set E6}
    (hGm : ∀ k, MeasurableSet (G k)) (hGim : ∀ k i, MeasurableSet (Gi k i))
    (hGdec : ∀ k, G (k + 1) ⊆ G k) (hGidec : ∀ k i, Gi (k + 1) i ⊆ Gi k i)
    {c₀ : ℝ≥0∞} {c : Fin 3 → ℝ≥0∞} {r : ℕ} (hr : 6 ≤ r)
    (hfwd : ∀ k, k < r → ∀ x ∈ G (k + 1), c₀ ≤ incidFwd N (Gi k) x)
