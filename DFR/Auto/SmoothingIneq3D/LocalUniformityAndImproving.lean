    (hf3 : ∀ x ∈ towA1 N G Gi r word2 z, ∀ y ∈ towA2 N G Gi r word2 z x,
      ENNReal.ofReal (cst * α 0 * N) ≤ volume (towA3 N G Gi r word2 z x y))
    (hf4 : ∀ x ∈ towA1 N G Gi r word2 z, ∀ y ∈ towA2 N G Gi r word2 z x,
      ∀ u ∈ towA3 N G Gi r word2 z x y,
      ENNReal.ofReal (cst * α 3 * N) ≤ volume (towA4 N G Gi r word2 z x y u))
    (hf5 : ∀ x ∈ towA1 N G Gi r word2 z, ∀ y ∈ towA2 N G Gi r word2 z x,
      ∀ u ∈ towA3 N G Gi r word2 z x y, ∀ v ∈ towA4 N G Gi r word2 z x y u,
      ENNReal.ofReal (cst * α 2 * N) ≤ volume (towA5 N G Gi r word2 z x y u v))
    (hf6 : ∀ x ∈ towA1 N G Gi r word2 z, ∀ y ∈ towA2 N G Gi r word2 z x,
      ∀ u ∈ towA3 N G Gi r word2 z x y, ∀ v ∈ towA4 N G Gi r word2 z x y u,
      ∀ t ∈ towA5 N G Gi r word2 z x y u v,
      ENNReal.ofReal (cst * α 0 * N) ≤ volume (towA6 N G Gi r word2 z x y u v t)) :
    ENNReal.ofReal (((2 : ℝ) ^ (18 : ℕ))⁻¹ * cst ^ (10 : ℕ)
        * (α 0 * α 1 * α 2 * α 3 * N) ^ (10 : ℕ))
      ≤ 2 * volume (cfg4 (G 0) (Gi 0) (word2 6)) := by
  have key := measure_terminal_ge_word2 N hGm hGim hGdec hGidec hr hfwd hadj hz
    (a := fun l => cst * α (word2 l)) (fun l => hcN (word2 l)) hf1 hf2 hf3 hf4 hf5 hf6
  refine le_trans ?_ key
  have w0 : word2 0 = 1 := rfl
  have w1 : word2 1 = 3 := rfl
  have w2 : word2 2 = 0 := rfl
  have w3 : word2 3 = 3 := rfl
  have w4 : word2 4 = 2 := rfl
  have w5 : word2 5 = 0 := rfl
  rw [w0, w1, w2, w3, w4, w5]
  have hx1 : (0 : ℝ) ≤ 2⁻¹ * (cst * α 1 * N) := by linarith [hcN 1]
  have hx2 : (0 : ℝ) ≤ 2⁻¹ * (cst * α 3 * N) := by linarith [hcN 3]
  have hx3 : (0 : ℝ) ≤ 2⁻¹ * (8 : ℝ)⁻¹ * (cst * α 0 * N) ^ 2 := by positivity
  have hx4 : (0 : ℝ) ≤ 2⁻¹ * ((8 : ℝ)⁻¹) ^ 2 * (cst * α 3 * N) ^ 3 :=
    mul_nonneg (by norm_num) (pow_nonneg (hcN 3) 3)
  have hx5 : (0 : ℝ) ≤ 2⁻¹ * (cst * α 2 * N) := by linarith [hcN 2]
  rw [← ofReal_prod_six hx1 hx2 hx3 hx4 hx5]
  exact ENNReal.ofReal_le_ofReal (prod_six_word2_ge cst N hα0 hα1)


/-! ### Blueprint `prop:restricted-improving-vertex`: the symmetric restricted inequality

"Because `0 < alpha_i <= 1`, this stronger symmetric inequality implies, with
`s_1 = s_2 = s_3 = 10` and `S = 30`,
`K^60 <= C N^{-10} |E_0|^10 |E_j|^30 |E_{j'}|^11 |E_k|^10`."

The densities are `alpha_i = K / |E_i|`, which is written here without division as
`alpha_i * |E_i| = K`; then the symmetric bound multiplied by `(|E_0||E_j||E_{j'}||E_k|)^10` reads
`c N^10 K^40 <= |E_{j'}| (|E_0||E_j||E_{j'}||E_k|)^10`. The step from `K^40` to `K^60` is the one
the patch's `rem:statement-correction` isolates: the index `j` carrying the exponent `S = 30` enters
only through `alpha_j <= 1`, that is `K <= |E_j|`. -/

/-- `alpha_i <= 1` in division-free form. -/
theorem K_le_of_alpha_le_one {K m a : ℝ≥0∞} (h : a * m = K) (ha : a ≤ 1) : K ≤ m := by
  rw [← h]
  calc a * m ≤ 1 * m := mul_le_mul' ha le_rfl
    _ = m := one_mul m

/-- The four densities and the four measures multiply to `K^40` in the tenth power. -/
theorem alpha_prod_mul {K m0 m1 m2 m3 a0 a1 a2 a3 : ℝ≥0∞}
    (h0 : a0 * m0 = K) (h1 : a1 * m1 = K) (h2 : a2 * m2 = K) (h3 : a3 * m3 = K) :
    (a0 * a1 * a2 * a3) ^ (10 : ℕ) * (m0 * m1 * m2 * m3) ^ (10 : ℕ) = K ^ (40 : ℕ) := by
  have hfour : (a0 * a1 * a2 * a3) * (m0 * m1 * m2 * m3) = K ^ (4 : ℕ) := by
    calc (a0 * a1 * a2 * a3) * (m0 * m1 * m2 * m3)
        = (a0 * m0) * (a1 * m1) * (a2 * m2) * (a3 * m3) := by ring
      _ = K ^ (4 : ℕ) := by rw [h0, h1, h2, h3]; ring
  rw [← mul_pow, hfour, ← pow_mul]

/-- **Blueprint `prop:restricted-improving-vertex`, the symmetric restricted inequality.** -/
theorem K_pow_sixty_le_of_symmetric {K N cc m0 mj mj' mk a0 aj aj' ak : ℝ≥0∞}
    (h0 : a0 * m0 = K) (hj : aj * mj = K) (hj' : aj' * mj' = K) (hk : ak * mk = K)
    (hKj : K ≤ mj)
    (hsym : cc * (a0 * aj * aj' * ak * N) ^ (10 : ℕ) ≤ mj') :
    cc * N ^ (10 : ℕ) * K ^ (60 : ℕ)
      ≤ m0 ^ (10 : ℕ) * mj ^ (30 : ℕ) * mj' ^ (11 : ℕ) * mk ^ (10 : ℕ) := by
  have hbridge : (a0 * aj * aj' * ak) ^ (10 : ℕ) * (m0 * mj * mj' * mk) ^ (10 : ℕ)
      = K ^ (40 : ℕ) := alpha_prod_mul h0 hj hj' hk
  have hstep : cc * N ^ (10 : ℕ) * K ^ (40 : ℕ)
      ≤ mj' * (m0 * mj * mj' * mk) ^ (10 : ℕ) := by
    calc cc * N ^ (10 : ℕ) * K ^ (40 : ℕ)
        = cc * (a0 * aj * aj' * ak * N) ^ (10 : ℕ) * (m0 * mj * mj' * mk) ^ (10 : ℕ) := by
          rw [← hbridge]; ring
      _ ≤ mj' * (m0 * mj * mj' * mk) ^ (10 : ℕ) := mul_le_mul' hsym le_rfl
  have h20 : K ^ (20 : ℕ) ≤ mj ^ (20 : ℕ) := pow_le_pow_left' hKj 20
  calc cc * N ^ (10 : ℕ) * K ^ (60 : ℕ)
      = cc * N ^ (10 : ℕ) * K ^ (40 : ℕ) * K ^ (20 : ℕ) := by ring
    _ ≤ mj' * (m0 * mj * mj' * mk) ^ (10 : ℕ) * mj ^ (20 : ℕ) := mul_le_mul' hstep h20
    _ = m0 ^ (10 : ℕ) * mj ^ (30 : ℕ) * mj' ^ (11 : ℕ) * mk ^ (10 : ℕ) := by ring

/-- **Blueprint `prop:restricted-improving-vertex`, the exponent arithmetic.**
"Since `-1/6 + 4(1/p - 1/q) = -1/10`, the asserted estimate follows", with `1/p = 17/20` and
`1/q = 5/6`. -/
theorem exponent_arithmetic :
    -(1 : ℝ) / 6 + 4 * ((17 : ℝ) / 20 - (5 : ℝ) / 6) = -((1 : ℝ) / 10) := by
  norm_num

/-- The descent exponent itself: `1/p - 1/q = 1/60`. -/
theorem descent_exponent : (17 : ℝ) / 20 - (5 : ℝ) / 6 = (1 : ℝ) / 60 := by norm_num


/-! ### Blueprint `prop:restricted-improving-vertex`: the restricted weak estimate from the pairing

"Taking the sixtieth root is exactly the restricted weak estimate
`L_N : L^{2,1} x L^{60/11,1} x L^{6,1} -> L^{6/5,infinity}`."

What the sixtieth root gives is a bound on the pairing of the output with the indicator of a set,
and the weak quasi-norm follows from that by testing on the level sets: on `{lam < |F|}` the
pairing is at least `lam` times the measure, so the hypothesis at that set is exactly the weak
bound after cancelling the common power. -/

open MeasureTheory in
/-- **A restricted weak bound from the dual pairing.** If the integral of `|F|` over every set of
finite measure is at most `C` times the measure to the power `1 - 1/q`, then the weak `L^q`
quasi-norm of `F` is at most `C`. -/
theorem wnorm_le_of_setLIntegral {q : ℝ} (hq : 0 < q) {F : E3 → ℂ}
    (hF : Measurable fun x => ‖F x‖ₑ)
    {C : ℝ≥0∞}
    (hfin : ∀ lam : ℝ≥0∞, lam ≠ 0 → volume {x : E3 | lam < ‖F x‖ₑ} ≠ ⊤)
    (h : ∀ S : Set E3, MeasurableSet S → volume S ≠ ⊤ →
      ∫⁻ x in S, ‖F x‖ₑ ≤ C * volume S ^ (1 - 1 / q)) :
    wnorm volume q F ≤ C := by
  refine wnorm_le fun lam => ?_
  rcases eq_or_ne lam 0 with rfl | hlam
  · simp
  set S : Set E3 := {x : E3 | lam < ‖F x‖ₑ} with hS
  have hSm : MeasurableSet S := measurableSet_lt measurable_const hF
  have hSfin : volume S ≠ ⊤ := hfin lam hlam
  rcases eq_or_ne (volume S) 0 with h0 | h0
  · rw [h0, ENNReal.zero_rpow_of_pos (one_div_pos.mpr hq), mul_zero]
    simp
  have hlow : lam * volume S ≤ ∫⁻ x in S, ‖F x‖ₑ := by
    calc lam * volume S = ∫⁻ _x in S, lam := (setLIntegral_const _ _).symm
      _ ≤ ∫⁻ x in S, ‖F x‖ₑ := setLIntegral_mono' hSm fun x hx => le_of_lt hx
  have hkey : lam * volume S ≤ C * volume S ^ (1 - 1 / q) :=
    le_trans hlow (h S hSm hSfin)
  have hne0 : volume S ^ (1 - 1 / q) ≠ 0 := rpow_ne_zero_of_ne_zero h0 hSfin _
  have hnetop : volume S ^ (1 - 1 / q) ≠ ⊤ := rpow_ne_top_of_ne_top h0 hSfin _
  have hsplit : volume S = volume S ^ (1 - 1 / q) * volume S ^ (1 / q) := by
    rw [← ENNReal.rpow_add _ _ h0 hSfin, show 1 - 1 / q + 1 / q = (1 : ℝ) by ring,
      ENNReal.rpow_one]
  have hchain : lam * volume S ^ (1 / q) * volume S ^ (1 - 1 / q)
      ≤ C * volume S ^ (1 - 1 / q) := by
    calc lam * volume S ^ (1 / q) * volume S ^ (1 - 1 / q)
        = lam * (volume S ^ (1 - 1 / q) * volume S ^ (1 / q)) := by ring
      _ = lam * volume S := by rw [← hsplit]
      _ ≤ C * volume S ^ (1 - 1 / q) := hkey
  exact (ENNReal.mul_le_mul_iff_left hne0 hnetop).mp hchain


/-! ### The fibre bounds of the tower, along the tower

`Auto.flowPt_mem` establishes the invariant of the tower from the memberships at every level, but
the succ step uses only the membership at the previous level: the landing property of
`Auto.transSet` is unconditional, so one move suffices. Isolating that gives the six fibre bounds
in exactly the restricted form the integration lemmas ask for. -/
theorem flowPt_mem_succ (N : ℝ) {G : ℕ → Set E6} {Gi : ℕ → Fin 3 → Set E6} {r : ℕ}
    {w : ℕ → Fin 4} (hw : IsItinerary w) {z : E6} {t : ℕ → ℝ} {n : ℕ} (hn : n < 6)
    (ht : t n ∈ flowFibre N G Gi r w z t n) :
    flowPt w z t (n + 1) ∈ cfg4 (G (r - (n + 1))) (Gi (r - (n + 1))) (w (n + 1)) := by
  have hmem := mem_cfg4_of_mem_transSet ht (w (n + 1)) fun hc => hw n hn hc.symm
  have harith : r - n - 1 = r - (n + 1) := by omega
  rw [flowPt_succ]
  rw [harith] at hmem
  exact hmem

open MeasureTheory in
/-- **The six fibre bounds of the tower, in the restricted form.** Each holds at every point of
the preceding fibres. -/
theorem towA_fibre_bounds (N : ℝ) {G : ℕ → Set E6} {Gi : ℕ → Fin 3 → Set E6}
    (hGm : ∀ k, MeasurableSet (G k)) (hGim : ∀ k i, MeasurableSet (Gi k i))
    {c₀ : ℝ≥0∞} {c : Fin 3 → ℝ≥0∞} {r : ℕ} (hr : 6 ≤ r)
    (hfwd : ∀ k, k < r → ∀ x ∈ G (k + 1), c₀ ≤ incidFwd N (Gi k) x)
    (hadj : ∀ k, k < r → ∀ i, ∀ y ∈ Gi (k + 1) i, c i ≤ incidAdj N (G k) (Gi k) i y)
    {w : ℕ → Fin 4} (hw : IsItinerary w) {z : E6} (hz : z ∈ cfg4 (G r) (Gi r) (w 0)) :
    dens4 c₀ c (w 0) ≤ volume (towA1 N G Gi r w z) ∧
    (∀ x ∈ towA1 N G Gi r w z,
      dens4 c₀ c (w 1) ≤ volume (towA2 N G Gi r w z x)) ∧
    (∀ x ∈ towA1 N G Gi r w z, ∀ y ∈ towA2 N G Gi r w z x,
      dens4 c₀ c (w 2) ≤ volume (towA3 N G Gi r w z x y)) ∧
    (∀ x ∈ towA1 N G Gi r w z, ∀ y ∈ towA2 N G Gi r w z x,
      ∀ u ∈ towA3 N G Gi r w z x y,
      dens4 c₀ c (w 3) ≤ volume (towA4 N G Gi r w z x y u)) ∧
    (∀ x ∈ towA1 N G Gi r w z, ∀ y ∈ towA2 N G Gi r w z x,
      ∀ u ∈ towA3 N G Gi r w z x y, ∀ v ∈ towA4 N G Gi r w z x y u,
      dens4 c₀ c (w 4) ≤ volume (towA5 N G Gi r w z x y u v)) ∧
    (∀ x ∈ towA1 N G Gi r w z, ∀ y ∈ towA2 N G Gi r w z x,
      ∀ u ∈ towA3 N G Gi r w z x y, ∀ v ∈ towA4 N G Gi r w z x y u,
      ∀ t ∈ towA5 N G Gi r w z x y u v,
      dens4 c₀ c (w 5) ≤ volume (towA6 N G Gi r w z x y u v t)) := by
  have base : ∀ (s : ℕ → ℝ) (l : ℕ), l < 6 →
      flowPt w z s l ∈ cfg4 (G (r - l)) (Gi (r - l)) (w l) →
      dens4 c₀ c (w l) ≤ volume (flowFibre N G Gi r w z s l) := by
    intro s l hl hinv
    exact volume_flowFibre_ge N hGm hGim hr hfwd hadj hl hinv
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact base (seqOf (0, 0, 0, 0, 0, 0)) 0 (by omega)
      (by rw [Nat.sub_zero, flowPt_zero]; exact hz)
  · intro x hx
    refine base (seqOf (x, 0, 0, 0, 0, 0)) 1 (by omega) ?_
    refine flowPt_mem_succ N hw (n := 0) (by omega) ?_
    exact hx
  · intro x hx y hy
    refine base (seqOf (x, y, 0, 0, 0, 0)) 2 (by omega) ?_
    refine flowPt_mem_succ N hw (n := 1) (by omega) ?_
    refine (flowFibre_congr N G Gi r w z 1 ?_) ▸ hy
    intro m hm
    interval_cases m
    rfl
  · intro x hx y hy u hu
    refine base (seqOf (x, y, u, 0, 0, 0)) 3 (by omega) ?_
    refine flowPt_mem_succ N hw (n := 2) (by omega) ?_
    refine (flowFibre_congr N G Gi r w z 2 ?_) ▸ hu
    intro m hm
    interval_cases m <;> rfl
  · intro x hx y hy u hu v hv
    refine base (seqOf (x, y, u, v, 0, 0)) 4 (by omega) ?_
    refine flowPt_mem_succ N hw (n := 3) (by omega) ?_
    refine (flowFibre_congr N G Gi r w z 3 ?_) ▸ hv
    intro m hm
    interval_cases m <;> rfl
  · intro x hx y hy u hu v hv t ht
    refine base (seqOf (x, y, u, v, t, 0)) 5 (by omega) ?_
    refine flowPt_mem_succ N hw (n := 4) (by omega) ?_
    refine (flowFibre_congr N G Gi r w z 4 ?_) ▸ ht
    intro m hm
    interval_cases m <;> rfl


/-! ### The image measure bound from the refinement tower alone

Taking the four density constants of the tower to be `ofReal (c_* alpha_i N)` turns the six fibre
bounds of `Auto.towA_fibre_bounds` into exactly the hypotheses of the symmetric measure bound, so
the latter follows from the refinement tower with no further input. -/
theorem dens4_ofReal (cst N : ℝ) (α : Fin 4 → ℝ) (a : Fin 4) :
    dens4 (ENNReal.ofReal (cst * α 0 * N)) (fun i => ENNReal.ofReal (cst * α i.succ * N)) a
      = ENNReal.ofReal (cst * α a * N) := by
  rcases Fin.eq_zero_or_eq_succ a with rfl | ⟨i, rfl⟩ <;> rfl

open MeasureTheory in
/-- **The image measure bound for `w^(3)`, from the refinement tower.** -/
