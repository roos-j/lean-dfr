/-! ### Blueprint `thm:strong-real-improving`: the scaling transfer from `N = 1`

The anisotropic dilation carries the estimate at `N = 1` to every `N`, and the mismatch between the
output exponent and the input exponents appears as a power of `N`. For the target vertex it is
`6/q - sum 6/p_i = 5 - 101/20 = -1/20`. -/

open MeasureTheory in
@[fun_prop] theorem measurable_S {ρ : ℝ} {f : E3 → ℂ} (hf : Measurable f) : Measurable (S ρ f) :=
  hf.comp (continuous_D ρ⁻¹).measurable

open MeasureTheory in
/-- **The scaling transfer.** An estimate for `A_1` with an arbitrary exponent vector gives the
estimate for `A_N` with the factor `N^{6/q - sum 6/p_i}`. -/
theorem eLpNorm_A_of_scale_one {q : ℝ} (hq : 0 < q) {pv : Fin 3 → ℝ} (hpv : ∀ i, 0 < pv i)
    {C : ℝ≥0∞}
    (hscale1 : ∀ g : Fin 3 → E3 → ℂ, (∀ i, Measurable (g i)) →
      eLpNorm (A 1 g) (ENNReal.ofReal q) volume
        ≤ C * ∏ i, eLpNorm (g i) (ENNReal.ofReal (pv i)) volume)
    {N : ℝ} (hN : 0 < N) (f : Fin 3 → E3 → ℂ) (hf : ∀ i, Measurable (f i)) :
    eLpNorm (A N f) (ENNReal.ofReal q) volume
      ≤ ENNReal.ofReal (N ^ (6 / q) * ∏ i, (N⁻¹ : ℝ) ^ (6 / pv i))
        * (C * ∏ i, eLpNorm (f i) (ENNReal.ofReal (pv i)) volume) := by
  have hp0 : ENNReal.ofReal q ≠ 0 := (ENNReal.ofReal_pos.mpr hq).ne'
  have hq' : (ENNReal.ofReal q).toReal = q := ENNReal.toReal_ofReal hq.le
  set g : Fin 3 → E3 → ℂ := fun i => S N⁻¹ (f i) with hg
  have hgm : ∀ i, Measurable (g i) := fun i => measurable_S (hf i)
  have hAt : A N f = S N (A 1 g) := by
    funext x
    have h := A_S_D (ρ := N⁻¹) (inv_ne_zero hN.ne') N f x
    rw [inv_mul_cancel₀ hN.ne', B_eq_smul_A, ← mul_assoc,
      inv_mul_cancel₀ (by exact_mod_cast hN.ne' : (N : ℂ) ≠ 0), one_mul] at h
    exact h.symm
  have h2 : ∀ i, eLpNorm (g i) (ENNReal.ofReal (pv i)) volume
      = ENNReal.ofReal ((N⁻¹ : ℝ) ^ (6 / pv i))
        * eLpNorm (f i) (ENNReal.ofReal (pv i)) volume := by
    intro i
    have h := eLpNorm_S (ρ := N⁻¹) (by positivity) (hf i)
      (p := ENNReal.ofReal (pv i)) (ENNReal.ofReal_pos.mpr (hpv i)).ne' ENNReal.ofReal_ne_top
    rwa [ENNReal.toReal_ofReal (hpv i).le] at h
  rw [hAt, eLpNorm_S hN (measurable_A zero_le_one hgm) hp0 ENNReal.ofReal_ne_top, hq']
  calc ENNReal.ofReal (N ^ (6 / q)) * eLpNorm (A 1 g) (ENNReal.ofReal q) volume
      ≤ ENNReal.ofReal (N ^ (6 / q))
        * (C * ∏ i, eLpNorm (g i) (ENNReal.ofReal (pv i)) volume) := by
        gcongr
        exact hscale1 g hgm
    _ = ENNReal.ofReal (N ^ (6 / q) * ∏ i, (N⁻¹ : ℝ) ^ (6 / pv i))
        * (C * ∏ i, eLpNorm (f i) (ENNReal.ofReal (pv i)) volume) := by
        have hprodg : (∏ i, eLpNorm (g i) (ENNReal.ofReal (pv i)) volume)
            = ENNReal.ofReal (∏ i, (N⁻¹ : ℝ) ^ (6 / pv i))
              * ∏ i, eLpNorm (f i) (ENNReal.ofReal (pv i)) volume := by
          rw [ENNReal.ofReal_prod_of_nonneg (fun i _ => Real.rpow_nonneg (by positivity) _),
            ← Finset.prod_mul_distrib]
          exact Finset.prod_congr rfl fun i _ => h2 i
        rw [hprodg, ENNReal.ofReal_mul (Real.rpow_nonneg hN.le _)]
        ring

/-- The scaling factor of `thm:strong-real-improving` is `N^{-1/20}`. -/
theorem strong_real_improving_scale_factor {N : ℝ} (hN : 0 < N) :
    N ^ (6 / (6 / 5 : ℝ)) * ∏ i, (N⁻¹ : ℝ) ^ (6 / (targetVertex i)⁻¹)
      = N ^ (-(1 : ℝ) / 20) := by
  have hinv : ∀ z : ℝ, (N⁻¹ : ℝ) ^ z = N ^ (-z) := by
    intro z
    rw [Real.inv_rpow hN.le, ← Real.rpow_neg hN.le]
  simp only [hinv, Fin.prod_univ_three, targetVertex, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_two, Matrix.tail_cons]
  rw [← Real.rpow_add hN, ← Real.rpow_add hN, ← Real.rpow_add hN]
  norm_num


/-! ### Blueprint `thm:strong-real-improving`: from normalized to arbitrary inputs

`Auto.finite_marcinkiewicz` bounds the output for inputs of norm at most one. Scaling each slot by
a constant scales the output by the product of the constants, so the general estimate follows, with
the degenerate cases handled by the vanishing of the average when a slot vanishes. -/
theorem A_smul_slots (N : ℝ) (c : Fin 3 → ℂ) (f : Fin 3 → E3 → ℂ) (x : E3) :
    A N (fun i y => c i * f i y) x = (∏ i, c i) * A N f x := by
  have h : ∀ t : ℝ, prodShift (fun i y => c i * f i y) x t = (∏ i, c i) * prodShift f x t := by
    intro t
    rw [prodShift, prodShift, ← Finset.prod_mul_distrib]
  rw [A, A]
  simp_rw [h]
  rw [intervalIntegral.integral_const_mul]
  ring

open MeasureTheory in
/-- **A slot that vanishes almost everywhere kills the average.** The complex form of
`Auto.null3_A`. -/
theorem A_ae_zero_of_slot_ae_zero {N : ℝ} (hN : 0 ≤ N) {f : Fin 3 → E3 → ℂ} {i : Fin 3}
    (hfm : ∀ l, Measurable (f l)) (hi : f i =ᵐ[volume] 0) : A N f =ᵐ[volume] 0 := by
  have hZm : MeasurableSet {y : E3 | f i y ≠ 0} := by
    have h : MeasurableSet {y : E3 | f i y = 0} := (hfm i) (measurableSet_singleton (0 : ℂ))
    have h2 := h.compl
    rwa [Set.compl_ofPred] at h2
  have hZ0 : volume {y : E3 | f i y ≠ 0} = 0 := by
    have h := hi
    rw [Filter.EventuallyEq, ae_iff] at h
    simpa using h
  have hjoint : Measurable fun q : E3 × ℝ =>
      Set.indicator {y : E3 | f i y ≠ 0} (fun _ => (1 : ℝ≥0∞)) (q.1 + curve i q.2) :=
    (measurable_const.indicator hZm).comp
      (measurable_fst.add ((continuous_curve i).measurable.comp measurable_snd))
  have hslice : ∀ t : ℝ, (∫⁻ x, Set.indicator {y : E3 | f i y ≠ 0}
      (fun _ => (1 : ℝ≥0∞)) (x + curve i t)) = 0 := by
    intro t
    rw [lintegral_add_right_eq_self
      (fun x => Set.indicator {y : E3 | f i y ≠ 0} (fun _ => (1 : ℝ≥0∞)) x) (curve i t),
      lintegral_indicator hZm _, setLIntegral_one, hZ0]
  have htot : (∫⁻ x, ∫⁻ t in Set.Ioc (0 : ℝ) N,
      Set.indicator {y : E3 | f i y ≠ 0} (fun _ => (1 : ℝ≥0∞)) (x + curve i t)) = 0 := by
    rw [lintegral_lintegral_swap hjoint.aemeasurable]
    simp only [hslice]
    simp
  have hae := (lintegral_eq_zero_iff hjoint.lintegral_prod_right').mp htot
  filter_upwards [hae] with x hx
  have hx0 : (fun t => Set.indicator {y : E3 | f i y ≠ 0} (fun _ => (1 : ℝ≥0∞))
      (x + curve i t)) =ᵐ[volume.restrict (Set.Ioc (0 : ℝ) N)] 0 :=
    (lintegral_eq_zero_iff (hjoint.comp (measurable_const.prodMk measurable_id))).mp hx
  have hzero : ∀ᵐ t ∂(volume.restrict (Set.Ioc (0 : ℝ) N)), prodShift f x t = 0 := by
    filter_upwards [hx0] with t ht
    have hnot : x + curve i t ∉ {y : E3 | f i y ≠ 0} := by
      intro hmem
      rw [Set.indicator_of_mem hmem] at ht
      exact one_ne_zero ht
    have hzeroi : f i (x + curve i t) = 0 := by simpa using hnot
    rw [prodShift, Finset.prod_eq_zero (Finset.mem_univ i) hzeroi]
  have hI : (∫ t in (0 : ℝ)..N, prodShift f x t) = 0 := by
    rw [intervalIntegral.integral_of_le hN]
    exact integral_eq_zero_of_ae hzero
  rw [Pi.zero_apply, A, hI, mul_zero]

open MeasureTheory in
/-- **The estimate for arbitrary inputs from the estimate for normalized ones.** -/
theorem eLpNorm_A_one_le {C : ℝ≥0∞} (hC0 : C ≠ 0) {q : ℝ} {p : Fin 3 → ℝ} (hp : ∀ i, 0 < p i)
    (hmain : ∀ g : Fin 3 → E3 → ℂ, (∀ i, Measurable (g i)) →
      (∀ i, eLpNorm (g i) (ENNReal.ofReal (p i)) volume ≤ 1) →
      eLpNorm (A 1 g) (ENNReal.ofReal q) volume ≤ C)
    (f : Fin 3 → E3 → ℂ) (hf : ∀ i, Measurable (f i)) :
    eLpNorm (A 1 f) (ENNReal.ofReal q) volume
      ≤ C * ∏ i, eLpNorm (f i) (ENNReal.ofReal (p i)) volume := by
  classical
  have hpne : ∀ i, ENNReal.ofReal (p i) ≠ 0 := fun i => (ENNReal.ofReal_pos.mpr (hp i)).ne'
  by_cases hzero : ∃ i, eLpNorm (f i) (ENNReal.ofReal (p i)) volume = 0
  · obtain ⟨i, hi⟩ := hzero
    have hfi : f i =ᵐ[volume] 0 :=
      (eLpNorm_eq_zero_iff (hpne i)).mp hi
    rw [eLpNorm_congr_ae (A_ae_zero_of_slot_ae_zero zero_le_one hf hfi)]
    simp
  push Not at hzero
  by_cases htop : ∃ i, eLpNorm (f i) (ENNReal.ofReal (p i)) volume = ⊤
  · obtain ⟨i, hi⟩ := htop
    have hprod : (∏ j, eLpNorm (f j) (ENNReal.ofReal (p j)) volume) = ⊤ := by
      rw [Fin.prod_univ_three]
      match i with
      | 0 => rw [hi, ENNReal.top_mul (hzero 1), ENNReal.top_mul (hzero 2)]
      | 1 => rw [hi, ENNReal.mul_top (hzero 0), ENNReal.top_mul (hzero 2)]
      | 2 => rw [hi, ENNReal.mul_top (mul_ne_zero (hzero 0) (hzero 1))]
    rw [hprod, ENNReal.mul_top hC0]
    exact le_top
  push Not at htop
  have hrpos : ∀ i, 0 < (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal := fun i =>
    ENNReal.toReal_pos (hzero i) (htop i)
  have hra : ∀ i, ENNReal.ofReal (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal
      = eLpNorm (f i) (ENNReal.ofReal (p i)) volume := fun i => ENNReal.ofReal_toReal (htop i)
  have hgm : ∀ i, Measurable fun y =>
      (((eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹ : ℝ) : ℂ) * f i y :=
    fun i => measurable_const.mul (hf i)
  have hgnorm : ∀ i, eLpNorm (fun y =>
      (((eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹ : ℝ) : ℂ) * f i y)
        (ENNReal.ofReal (p i)) volume = 1 := by
    intro i
    have hc : ‖((((eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹ : ℝ)) : ℂ)‖ₑ
        = ENNReal.ofReal (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹ := by
      rw [← ofReal_norm, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (by positivity : (0 : ℝ)
          ≤ (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹)]
    have hstep : ENNReal.ofReal (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹
        = (eLpNorm (f i) (ENNReal.ofReal (p i)) volume)⁻¹ := by
      rw [ENNReal.ofReal_inv_of_pos (hrpos i), hra i]
    rw [eLpNorm_const_mul', hc, hstep, ENNReal.inv_mul_cancel (hzero i) (htop i)]
  have hkey := hmain _ hgm fun i => le_of_eq (hgnorm i)
  have hAg : (A 1 fun i y =>
      (((eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹ : ℝ) : ℂ) * f i y)
      = fun x => (∏ i, (((eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹ : ℝ) : ℂ))
        * A 1 f x := by
    funext x
    exact A_smul_slots 1 _ f x
  have hnormc : ‖(∏ i, (((eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹ : ℝ) : ℂ))‖ₑ
      = ENNReal.ofReal (∏ i, (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹) := by
    rw [← ofReal_norm, norm_prod]
    congr 1
    refine Finset.prod_congr rfl fun i _ => ?_
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by positivity : (0 : ℝ)
      ≤ (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹)]
  rw [hAg, eLpNorm_const_mul', hnormc] at hkey
  have hmul := mul_le_mul'
    (le_refl (ENNReal.ofReal (∏ i, (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal))) hkey
  have hone : ENNReal.ofReal (∏ i, (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal)
      * ENNReal.ofReal (∏ i, (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹) = 1 := by
    have hcan : (∏ i, (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal)
        * (∏ i, (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal⁻¹) = 1 := by
      rw [← Finset.prod_mul_distrib]
      exact Finset.prod_eq_one fun i _ => mul_inv_cancel₀ (hrpos i).ne'
    rw [← ENNReal.ofReal_mul (Finset.prod_nonneg fun i _ => (hrpos i).le), hcan,
      ENNReal.ofReal_one]
  rw [← mul_assoc, hone, one_mul] at hmul
  have hprodr : ENNReal.ofReal (∏ i, (eLpNorm (f i) (ENNReal.ofReal (p i)) volume).toReal)
      = ∏ i, eLpNorm (f i) (ENNReal.ofReal (p i)) volume := by
    rw [ENNReal.ofReal_prod_of_nonneg fun i _ => (hrpos i).le]
    exact Finset.prod_congr rfl fun i _ => hra i
  rw [hprodr, mul_comm] at hmul
  exact hmul


/-! ### Blueprint `thm:strong-real-improving`: the strong estimate

Everything is in place: the eight cone vectors at `N = 1`, the finite Marcinkiewicz lemma, the
normalization, and the anisotropic dilation. -/
theorem one_sub_ofReal_rpow_inv_ne_top {c : ℝ} (hc : 0 < c) :
    ((1 : ℝ≥0∞) - ENNReal.ofReal ((2 : ℝ) ^ (-c)))⁻¹ ≠ ⊤ := by
  have h1 : ENNReal.ofReal ((2 : ℝ) ^ (-c)) < 1 := by
    rw [ENNReal.ofReal_lt_one]
    exact Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  exact ENNReal.inv_ne_top.mpr (tsub_pos_of_lt h1).ne'

open MeasureTheory in
/-- **Blueprint `thm:strong-real-improving`.** The strong estimate
`L^2 x L^{40/7} x L^6 -> L^{6/5}` for `A_N`, with constant `C N^{-1/20}`. -/
theorem strong_real_improving :
    ∃ C : ℝ≥0∞, C ≠ ⊤ ∧ ∀ N : ℝ, 0 < N → ∀ f : Fin 3 → E3 → ℂ, (∀ i, Measurable (f i)) →
      eLpNorm (A N f) (ENNReal.ofReal (6 / 5)) volume
        ≤ ENNReal.ofReal (N ^ (-(1 : ℝ) / 20))
          * (C * ∏ i, eLpNorm (f i) (ENNReal.ofReal ((targetVertex i)⁻¹)) volume) := by
  obtain ⟨Ccone, hCtop, hcone⟩ := exists_restrictedStrong_A_cone
  have hppos : ∀ i : Fin 3, 0 < (targetVertex i)⁻¹ := by
    intro i
    fin_cases i <;> norm_num [targetVertex]
  have hrecip : (fun i : Fin 3 => 1 / (targetVertex i)⁻¹) = targetVertex := by
    funext i
    fin_cases i <;> norm_num [targetVertex]
  have hdl : (0 : ℝ) < 1 / 400 := by norm_num
  have hdl' : ∀ i : Fin 3, (1 : ℝ) / 400 ≤ 1 / (targetVertex i)⁻¹ := by
    intro i
    fin_cases i <;> norm_num [targetVertex]
  have hrest : ∀ n : Fin 3 → ℤ,
      RestrictedStrong (A 1)
        (coneVec (fun i => 1 / (targetVertex i)⁻¹) (1 / 400) n) (6 / 5) Ccone := by
    intro n
    rw [hrecip]
    exact hcone n
  set B : ℝ≥0∞ := 64 * (8 * Ccone
      * ((2 * (1 - ENNReal.ofReal ((2 : ℝ) ^ (-((targetVertex 0)⁻¹ * (1 / 400)))))⁻¹)
        * (2 * (1 - ENNReal.ofReal ((2 : ℝ) ^ (-((targetVertex 1)⁻¹ * (1 / 400)))))⁻¹)
        * (2 * (1 - ENNReal.ofReal ((2 : ℝ) ^ (-((targetVertex 2)⁻¹ * (1 / 400)))))⁻¹))) with hB
  have hBtop : B ≠ ⊤ := by
    have hfac : ∀ i : Fin 3,
        (2 : ℝ≥0∞) * (1 - ENNReal.ofReal ((2 : ℝ) ^ (-((targetVertex i)⁻¹ * (1 / 400)))))⁻¹
          ≠ ⊤ := fun i =>
      ENNReal.mul_ne_top (by norm_num)
        (one_sub_ofReal_rpow_inv_ne_top (mul_pos (hppos i) (by norm_num)))
    rw [hB]
    exact ENNReal.mul_ne_top (by norm_num)
      (ENNReal.mul_ne_top (ENNReal.mul_ne_top (by norm_num) hCtop)
        (ENNReal.mul_ne_top (ENNReal.mul_ne_top (hfac 0) (hfac 1)) (hfac 2)))
  have hmain : ∀ g : Fin 3 → E3 → ℂ, (∀ i, Measurable (g i)) →
      (∀ i, eLpNorm (g i) (ENNReal.ofReal ((targetVertex i)⁻¹)) volume ≤ 1) →
      eLpNorm (A 1 g) (ENNReal.ofReal (6 / 5)) volume ≤ B ⊔ 1 := by
    intro g hgm hgn
    exact le_trans (finite_marcinkiewicz (admissible_A zero_le_one) (by norm_num) hppos hdl hdl'
      hrest hgm hgn) le_sup_left
  have hone : ∀ f : Fin 3 → E3 → ℂ, (∀ i, Measurable (f i)) →
      eLpNorm (A 1 f) (ENNReal.ofReal (6 / 5)) volume
        ≤ (B ⊔ 1) * ∏ i, eLpNorm (f i) (ENNReal.ofReal ((targetVertex i)⁻¹)) volume :=
    fun f hf => eLpNorm_A_one_le (lt_of_lt_of_le zero_lt_one le_sup_right).ne' hppos hmain f hf
  refine ⟨B ⊔ 1, ?_, ?_⟩
  · refine lt_top_iff_ne_top.mp (max_lt (lt_top_iff_ne_top.mpr hBtop) ?_)
    exact lt_top_iff_ne_top.mpr ENNReal.one_ne_top
  intro N hNpos f hf
  have h := eLpNorm_A_of_scale_one (q := 6 / 5) (by norm_num) hppos hone hNpos f hf
  rwa [strong_real_improving_scale_factor hNpos] at h

end Auto
