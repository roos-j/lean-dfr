open MeasureTheory in
/-- The integral of the Jacobian of `w^(1)` over its parameter set is at least the product of the
six per-step bounds. -/
theorem lintegral_absDet1_flowParamSet_ge (N : ℝ) {G : ℕ → Set E6} {Gi : ℕ → Fin 3 → Set E6}
    (hGm : ∀ k, MeasurableSet (G k)) (hGim : ∀ k i, MeasurableSet (Gi k i)) (r : ℕ) (z : E6)
    {a : ℕ → ℝ} (ha : ∀ l, 0 ≤ a l * N)
