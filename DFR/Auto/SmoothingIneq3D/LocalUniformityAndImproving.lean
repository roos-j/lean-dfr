/-! ### Patch 1 `lem:integrated`: one fibre integration

"Apply `lem:fibre-separation` to `E = I_l` with `a = c_* alpha_{w_{l-1}}` and the `m_l <= 2` points
`u_{l'} = t_{l'}`: it produces `I'_l subseteq I_l` with `|I'_l| >= (1/2) c_* alpha_{w_{l-1}} N` and
`|t_l - t_{l'}| >= (1/(4 m_l)) c_* alpha_{w_{l-1}} N >= 2^{-3} c_* alpha_{w_{l-1}} N`. Hence
`int_{I_l} prod |t_l - t_{l'}| >= 2^{-1} (2^{-3})^{m_l} (c_* alpha_{w_{l-1}} N)^{m_l+1}`."

Here `m_l` is the number of earlier parameters of the same block, so at most two. -/

open MeasureTheory in
/-- **Patch 1 `lem:integrated`, one step.** Integrating the Vandermonde factors that a new
parameter contributes costs only a power of two, because the separated subset is half the fibre and
every distance on it is at least an eighth of the fibre's length. -/
theorem lintegral_prod_dist_ge {N a : ℝ} {E : Set ℝ} (hEm : MeasurableSet E)
    (hE : ENNReal.ofReal (a * N) ≤ volume E) {m : ℕ} (hm2 : m ≤ 2)
    (u : Fin m → ℝ) (ha : 0 ≤ a * N) :
    ENNReal.ofReal (2⁻¹ * ((8 : ℝ)⁻¹) ^ m * (a * N) ^ (m + 1))
      ≤ ∫⁻ v in E, ∏ l : Fin m, ENNReal.ofReal |v - u l| := by
  obtain ⟨E', hE'm, hE'sub, hE'vol, hE'sep⟩ := exists_separated_subset hEm hE u ha
  have hdist : ∀ v ∈ E', ∀ l : Fin m, a * N / 8 ≤ |v - u l| := by
    intro v hv l
    refine le_trans ?_ (hE'sep v hv l)
    have hm1 : 1 ≤ m := Nat.one_le_iff_ne_zero.mpr (by rintro rfl; exact l.elim0)
    have hmR : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm1
    have hmR2 : (m : ℝ) ≤ 2 := by exact_mod_cast hm2
    have h4m : (0 : ℝ) < 4 * m := by linarith
    have hle : (4 : ℝ) * m ≤ 8 := by linarith
    gcongr
  have hpt : ∀ v ∈ E', ENNReal.ofReal (a * N / 8) ^ m
      ≤ ∏ l : Fin m, ENNReal.ofReal |v - u l| := by
    intro v hv
    have hconst : ENNReal.ofReal (a * N / 8) ^ m
        = ∏ _l : Fin m, ENNReal.ofReal (a * N / 8) := by simp
    rw [hconst]
    exact Finset.prod_le_prod fun l _ => ENNReal.ofReal_le_ofReal (hdist v hv l)
  have hstep : ENNReal.ofReal (a * N / 8) ^ m * volume E'
      ≤ ∫⁻ v in E, ∏ l : Fin m, ENNReal.ofReal |v - u l| := by
    calc ENNReal.ofReal (a * N / 8) ^ m * volume E'
        = ∫⁻ _ in E', ENNReal.ofReal (a * N / 8) ^ m := (setLIntegral_const _ _).symm
      _ ≤ ∫⁻ v in E', ∏ l : Fin m, ENNReal.ofReal |v - u l| :=
          setLIntegral_mono_ae (by fun_prop) (Filter.Eventually.of_forall fun v => hpt v)
      _ ≤ ∫⁻ v in E, ∏ l : Fin m, ENNReal.ofReal |v - u l| := lintegral_mono_set hE'sub
  refine le_trans (le_of_eq ?_) (le_trans (mul_le_mul' (le_refl _) hE'vol) hstep)
  rw [← ENNReal.ofReal_pow (by positivity), ← ENNReal.ofReal_mul (by positivity)]
  congr 1
  have h8 : (a * N / 8) ^ m = ((8 : ℝ)⁻¹) ^ m * (a * N) ^ m := by
    rw [← mul_pow]
    congr 1
    ring
  rw [h8]
  ring


/-! ### Patch 1 `lem:integrated`: one move of the tower with a weighted outer variable

"We integrate `|det D Phi|` over `P` in the order `t_6, t_5, ..., t_1`, i.e. innermost variable
first ... At the `l`-th step the integrand contains exactly the `m_l` factors `|t_l - t_{l'}|`,
`l' < l`, in block `i(l)`, times a quantity independent of `t_l`."

`Auto.lintegral_towerCons_ge` moves one variable with the outer one contributing only its measure.
That is not enough here: the outer variable of each step carries the Vandermonde factors joining it
to the earlier parameters of its own block, so it contributes a *weighted* integral. The lemmas
below are that refinement; with the weight `1` they specialize to the existing ones. -/

open MeasureTheory in
/-- A weighted refinement of `Auto.mul_measure_le_setLIntegral`. -/
theorem mul_lintegral_le_setLIntegral {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {A : Set α} (hA : MeasurableSet A) {f g : α → ℝ≥0∞} {γ : ℝ≥0∞} (hγ : γ ≠ ⊤)
    (h : ∀ x ∈ A, γ * g x ≤ f x) :
    γ * (∫⁻ x in A, g x ∂μ) ≤ ∫⁻ x in A, f x ∂μ := by
  calc γ * (∫⁻ x in A, g x ∂μ) = ∫⁻ x in A, γ * g x ∂μ := (lintegral_const_mul' γ _ hγ).symm
    _ ≤ ∫⁻ x in A, f x ∂μ := setLIntegral_mono' hA h

open MeasureTheory in
/-- A weighted refinement of `Auto.lintegral_prod_ge_of_fibres`: when the fibre bound is `γ`
times a weight carried by the outer variable, the outer variable contributes the integral of that
weight rather than the measure of its set. -/
theorem lintegral_prod_ge_of_fibres' {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]
    {μ : Measure α} {ν : Measure β} [SFinite μ] [SFinite ν]
    {T : Set (α × β)} (hT : MeasurableSet T) {w : α × β → ℝ≥0∞} (hw : Measurable w)
    {A : Set α} (hA : MeasurableSet A) {g : α → ℝ≥0∞} {γ : ℝ≥0∞} (hγ : γ ≠ ⊤)
    (h : ∀ a ∈ A, γ * g a ≤ ∫⁻ b in Prod.mk a ⁻¹' T, w (a, b) ∂ν) :
    γ * (∫⁻ a in A, g a ∂μ) ≤ ∫⁻ p in T, w p ∂(μ.prod ν) := by
  have hind : Measurable (T.indicator w) := hw.indicator hT
  have hsplit : (∫⁻ p in T, w p ∂(μ.prod ν))
      = ∫⁻ a, ∫⁻ b, T.indicator w (a, b) ∂ν ∂μ := by
    rw [← lintegral_indicator hT]
    exact lintegral_prod _ hind.aemeasurable
  have hfib : ∀ a : α, (∫⁻ b, T.indicator w (a, b) ∂ν)
      = ∫⁻ b in Prod.mk a ⁻¹' T, w (a, b) ∂ν := by
    intro a
    have hpre : MeasurableSet (Prod.mk a ⁻¹' T) := measurable_prodMk_left hT
    rw [← lintegral_indicator hpre]
    refine lintegral_congr fun b => ?_
    by_cases hb : (a, b) ∈ T
    · rw [Set.indicator_of_mem hb, Set.indicator_of_mem (show b ∈ Prod.mk a ⁻¹' T from hb)]
    · rw [Set.indicator_of_notMem hb, Set.indicator_of_notMem (show b ∉ Prod.mk a ⁻¹' T from hb)]
  rw [hsplit]
  simp only [hfib]
  calc γ * (∫⁻ a in A, g a ∂μ)
      ≤ ∫⁻ a in A, ∫⁻ b in Prod.mk a ⁻¹' T, w (a, b) ∂ν ∂μ :=
        mul_lintegral_le_setLIntegral hA hγ h
    _ ≤ ∫⁻ a, ∫⁻ b in Prod.mk a ⁻¹' T, w (a, b) ∂ν ∂μ := setLIntegral_le_lintegral _ _

open MeasureTheory in
/-- **One move of the parameter tower, with the outer variable weighted.** This is the step the
patch's successive integration of the Jacobian actually performs. -/
theorem lintegral_towerCons_ge' {X : Type*} [MeasureSpace X] [SFinite (volume : Measure X)]
    {A : Set ℝ} (hA : MeasurableSet A) {T : ℝ → Set X}
    (hmeas : MeasurableSet (towerCons A T)) {w : ℝ × X → ℝ≥0∞} (hw : Measurable w)
    {g : ℝ → ℝ≥0∞} {β γ : ℝ≥0∞} (hγ : γ ≠ ⊤)
    (hβ : β ≤ ∫⁻ a in A, g a)
    (hfib : ∀ a ∈ A, γ * g a ≤ ∫⁻ x in T a, w (a, x)) :
    γ * β ≤ ∫⁻ p in towerCons A T, w p := by
  have hfib' : ∀ a ∈ A, γ * g a ≤ ∫⁻ x in Prod.mk a ⁻¹' towerCons A T, w (a, x) := by
    intro a ha
    rw [preimage_towerCons ha]
    exact hfib a ha
  calc γ * β ≤ γ * ∫⁻ a in A, g a := by gcongr
    _ ≤ ∫⁻ p in towerCons A T, w p ∂(volume.prod volume) :=
        lintegral_prod_ge_of_fibres' hmeas hw hA hγ hfib'
    _ = ∫⁻ p in towerCons A T, w p := by rw [← Measure.volume_eq_prod]


/-! ### Patch 1 `lem:integrated`: six successive fibre integrations

"Multiplying the six steps and using `sum_l (m_l + 1) = 10`."

The weight is a product of six factors, the `l`-th depending on the `l`-th parameter and the
earlier ones, and each factor is integrated against its own fibre. Six applications of the step
below therefore give the product of the six per-step bounds. No factor has to be finite: a factor
is only ever pulled out of an inner integral in the direction `c * int f <= int (c * f)`, which
holds in `ℝ≥0∞` without hypotheses. -/

open MeasureTheory in
/-- **One move of the tower when the weight splits off a factor carried by the outer variable.** -/
theorem lintegral_towerCons_ge_mul {X : Type*} [MeasureSpace X] [SFinite (volume : Measure X)]
    {A : Set ℝ} (hA : MeasurableSet A) {T : ℝ → Set X}
    (hmeas : MeasurableSet (towerCons A T)) {g : ℝ → ℝ≥0∞} {v : ℝ → X → ℝ≥0∞}
    (hw : Measurable fun p : ℝ × X => g p.1 * v p.1 p.2)
    {β γ : ℝ≥0∞} (hγ : γ ≠ ⊤) (hβ : β ≤ ∫⁻ a in A, g a)
    (hinner : ∀ a ∈ A, γ ≤ ∫⁻ x in T a, v a x) :
    γ * β ≤ ∫⁻ p in towerCons A T, g p.1 * v p.1 p.2 := by
  refine lintegral_towerCons_ge' hA hmeas hw hγ hβ fun a ha => ?_
  calc γ * g a = g a * γ := mul_comm _ _
    _ ≤ g a * ∫⁻ x in T a, v a x := mul_le_mul' le_rfl (hinner a ha)
    _ ≤ ∫⁻ x in T a, g a * v a x := lintegral_const_mul_le _ _

open MeasureTheory in
/-- **Patch 1 `lem:integrated`, the six successive fibre integrations.** The product of the six
per-step bounds is a lower bound for the integral of the weight over the tower. -/
theorem lintegral_tower6_ge
    {A1 : Set ℝ} {A2 : ℝ → Set ℝ} {A3 : ℝ → ℝ → Set ℝ} {A4 : ℝ → ℝ → ℝ → Set ℝ}
    {A5 : ℝ → ℝ → ℝ → ℝ → Set ℝ} {A6 : ℝ → ℝ → ℝ → ℝ → ℝ → Set ℝ}
    {g1 : ℝ → ℝ≥0∞} {g2 : ℝ → ℝ → ℝ≥0∞} {g3 : ℝ → ℝ → ℝ → ℝ≥0∞}
    {g4 : ℝ → ℝ → ℝ → ℝ → ℝ≥0∞} {g5 : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ≥0∞}
    {g6 : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ≥0∞}
    {β1 β2 β3 β4 β5 β6 : ℝ≥0∞}
    (hβ2 : β2 ≠ ⊤) (hβ3 : β3 ≠ ⊤) (hβ4 : β4 ≠ ⊤) (hβ5 : β5 ≠ ⊤) (hβ6 : β6 ≠ ⊤)
    (hA1 : MeasurableSet A1) (hA2 : ∀ a, MeasurableSet (A2 a))
    (hA3 : ∀ a b, MeasurableSet (A3 a b)) (hA4 : ∀ a b c, MeasurableSet (A4 a b c))
    (hA5 : ∀ a b c d, MeasurableSet (A5 a b c d))
    (hm5 : ∀ a b c d, MeasurableSet (towerCons (A5 a b c d) fun e => A6 a b c d e))
    (hm4 : ∀ a b c, MeasurableSet (towerCons (A4 a b c) fun d =>
      towerCons (A5 a b c d) fun e => A6 a b c d e))
    (hm3 : ∀ a b, MeasurableSet (towerCons (A3 a b) fun c =>
      towerCons (A4 a b c) fun d => towerCons (A5 a b c d) fun e => A6 a b c d e))
    (hm2 : ∀ a, MeasurableSet (towerCons (A2 a) fun b => towerCons (A3 a b) fun c =>
      towerCons (A4 a b c) fun d => towerCons (A5 a b c d) fun e => A6 a b c d e))
    (hm1 : MeasurableSet (towerCons A1 fun a => towerCons (A2 a) fun b =>
      towerCons (A3 a b) fun c => towerCons (A4 a b c) fun d =>
        towerCons (A5 a b c d) fun e => A6 a b c d e))
    (hw5 : ∀ a b c d, Measurable fun p : ℝ × ℝ => g5 a b c d p.1 * g6 a b c d p.1 p.2)
    (hw4 : ∀ a b c, Measurable fun p : ℝ × ℝ × ℝ =>
      g4 a b c p.1 * (g5 a b c p.1 p.2.1 * g6 a b c p.1 p.2.1 p.2.2))
    (hw3 : ∀ a b, Measurable fun p : ℝ × ℝ × ℝ × ℝ => g3 a b p.1 *
      (g4 a b p.1 p.2.1 * (g5 a b p.1 p.2.1 p.2.2.1 * g6 a b p.1 p.2.1 p.2.2.1 p.2.2.2)))
    (hw2 : ∀ a, Measurable fun p : ℝ × ℝ × ℝ × ℝ × ℝ => g2 a p.1 * (g3 a p.1 p.2.1 *
      (g4 a p.1 p.2.1 p.2.2.1 * (g5 a p.1 p.2.1 p.2.2.1 p.2.2.2.1 *
        g6 a p.1 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2))))
    (hw1 : Measurable fun p : ℝ × ℝ × ℝ × ℝ × ℝ × ℝ => g1 p.1 * (g2 p.1 p.2.1 *
      (g3 p.1 p.2.1 p.2.2.1 * (g4 p.1 p.2.1 p.2.2.1 p.2.2.2.1 *
        (g5 p.1 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2.1 *
          g6 p.1 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2.1 p.2.2.2.2.2)))))
    (h1 : β1 ≤ ∫⁻ a in A1, g1 a)
    (h2 : ∀ a ∈ A1, β2 ≤ ∫⁻ b in A2 a, g2 a b)
    (h3 : ∀ a ∈ A1, ∀ b ∈ A2 a, β3 ≤ ∫⁻ c in A3 a b, g3 a b c)
    (h4 : ∀ a ∈ A1, ∀ b ∈ A2 a, ∀ c ∈ A3 a b, β4 ≤ ∫⁻ d in A4 a b c, g4 a b c d)
    (h5 : ∀ a ∈ A1, ∀ b ∈ A2 a, ∀ c ∈ A3 a b, ∀ d ∈ A4 a b c,
      β5 ≤ ∫⁻ e in A5 a b c d, g5 a b c d e)
    (h6 : ∀ a ∈ A1, ∀ b ∈ A2 a, ∀ c ∈ A3 a b, ∀ d ∈ A4 a b c, ∀ e ∈ A5 a b c d,
      β6 ≤ ∫⁻ f in A6 a b c d e, g6 a b c d e f) :
    β1 * β2 * β3 * β4 * β5 * β6
      ≤ ∫⁻ p in (towerCons A1 fun a => towerCons (A2 a) fun b =>
          towerCons (A3 a b) fun c => towerCons (A4 a b c) fun d =>
            towerCons (A5 a b c d) fun e => A6 a b c d e),
        g1 p.1 * (g2 p.1 p.2.1 * (g3 p.1 p.2.1 p.2.2.1 *
          (g4 p.1 p.2.1 p.2.2.1 p.2.2.2.1 * (g5 p.1 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2.1 *
            g6 p.1 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2.1 p.2.2.2.2.2)))) := by
  have hfin4 : β6 * β5 ≠ ⊤ := ENNReal.mul_ne_top hβ6 hβ5
  have hfin3 : β6 * β5 * β4 ≠ ⊤ := ENNReal.mul_ne_top hfin4 hβ4
  have hfin2 : β6 * β5 * β4 * β3 ≠ ⊤ := ENNReal.mul_ne_top hfin3 hβ3
  have hfin1 : β6 * β5 * β4 * β3 * β2 ≠ ⊤ := ENNReal.mul_ne_top hfin2 hβ2
  have key : β6 * β5 * β4 * β3 * β2 * β1
      ≤ ∫⁻ p in (towerCons A1 fun a => towerCons (A2 a) fun b =>
          towerCons (A3 a b) fun c => towerCons (A4 a b c) fun d =>
            towerCons (A5 a b c d) fun e => A6 a b c d e),
        g1 p.1 * (g2 p.1 p.2.1 * (g3 p.1 p.2.1 p.2.2.1 *
          (g4 p.1 p.2.1 p.2.2.1 p.2.2.2.1 * (g5 p.1 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2.1 *
            g6 p.1 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2.1 p.2.2.2.2.2)))) := by
    refine lintegral_towerCons_ge_mul hA1 hm1 (g := g1)
      (v := fun a x => g2 a x.1 * (g3 a x.1 x.2.1 * (g4 a x.1 x.2.1 x.2.2.1 *
        (g5 a x.1 x.2.1 x.2.2.1 x.2.2.2.1 * g6 a x.1 x.2.1 x.2.2.1 x.2.2.2.1 x.2.2.2.2))))
      hw1 hfin1 h1 fun a ha => ?_
    refine lintegral_towerCons_ge_mul (hA2 a) (hm2 a) (g := g2 a)
      (v := fun b y => g3 a b y.1 * (g4 a b y.1 y.2.1 *
        (g5 a b y.1 y.2.1 y.2.2.1 * g6 a b y.1 y.2.1 y.2.2.1 y.2.2.2)))
      (hw2 a) hfin2 (h2 a ha) fun b hb => ?_
    refine lintegral_towerCons_ge_mul (hA3 a b) (hm3 a b) (g := g3 a b)
      (v := fun c y => g4 a b c y.1 * (g5 a b c y.1 y.2.1 * g6 a b c y.1 y.2.1 y.2.2))
      (hw3 a b) hfin3 (h3 a ha b hb) fun c hc => ?_
    refine lintegral_towerCons_ge_mul (hA4 a b c) (hm4 a b c) (g := g4 a b c)
      (v := fun d y => g5 a b c d y.1 * g6 a b c d y.1 y.2)
      (hw4 a b c) hfin4 (h4 a ha b hb c hc) fun d hd => ?_
    exact lintegral_towerCons_ge_mul (hA5 a b c d) (hm5 a b c d) (g := g5 a b c d)
      (v := fun e f => g6 a b c d e f)
      (hw5 a b c d) hβ6 (h5 a ha b hb c hc d hd) fun e he => h6 a ha b hb c hc d hd e he
  calc β1 * β2 * β3 * β4 * β5 * β6 = β6 * β5 * β4 * β3 * β2 * β1 := by ring
    _ ≤ _ := key


/-! ### Patch 1 `lem:integrated`: the exponent bookkeeping

"`m_l = #{l' in B_{i(l)} : l' < l}`, and in particular `m_l <= 2` ... Every Vandermonde factor is
counted exactly once in this way, and `sum_{l=1}^{6} (m_l + 1) = sum_i sum_{m=1}^{d_i} m =
sum_i d_i (d_i + 1) / 2 = D^* = 10`."

For each of the three block assignments this is a finite computation. -/

/-- The number of earlier moves in the same block as the move `l`. -/
def mCount (blk : ℕ → Fin 3) (l : ℕ) : ℕ :=
  ∑ l' ∈ Finset.range l, if blk l' = blk l then 1 else 0

/-- **Each move is joined to at most two earlier moves of its own block**, since the largest block
has three elements. -/
theorem mCount_le_two_word3 : ∀ l < 6, mCount blk3 l ≤ 2 := by decide
theorem mCount_le_two_word1 : ∀ l < 6, mCount blk1 l ≤ 2 := by decide
theorem mCount_le_two_word2 : ∀ l < 6, mCount blk2 l ≤ 2 := by decide

/-- **The exponent `D* = 1 + 3 + 6 = 10`.** For each word the six exponents `m_l + 1` sum to
ten, which is the `10` of the blueprint's `def:real-lift`. -/
theorem sum_mCount_word3 : ∑ l ∈ Finset.range 6, (mCount blk3 l + 1) = 10 := by decide
theorem sum_mCount_word1 : ∑ l ∈ Finset.range 6, (mCount blk1 l + 1) = 10 := by decide
theorem sum_mCount_word2 : ∑ l ∈ Finset.range 6, (mCount blk2 l + 1) = 10 := by decide

/-- The six exponents of each word, as the patch's remark lists them. -/
theorem mCount_word3_values :
    (mCount blk3 0 + 1, mCount blk3 1 + 1, mCount blk3 2 + 1,
      mCount blk3 3 + 1, mCount blk3 4 + 1, mCount blk3 5 + 1) = (1, 1, 2, 1, 2, 3) := by decide

theorem mCount_word2_values :
    (mCount blk2 0 + 1, mCount blk2 1 + 1, mCount blk2 2 + 1,
      mCount blk2 3 + 1, mCount blk2 4 + 1, mCount blk2 5 + 1) = (1, 1, 2, 3, 1, 2) := by decide

theorem mCount_word1_values :
    (mCount blk1 0 + 1, mCount blk1 1 + 1, mCount blk1 2 + 1,
      mCount blk1 3 + 1, mCount blk1 4 + 1, mCount blk1 5 + 1) = (1, 1, 2, 2, 3, 1) := by decide


/-! ### Patch 1 `lem:integrated`: the constants

"Multiplying the six steps and using `sum_l (m_l + 1) = 10`,
`int_P |det D Phi| >= 12 * 2^{-54} c_*^{10} N^{10} prod_l alpha_{w_{l-1}}^{m_l+1}
 >= 2^{-54} 2^{-2400} N^{10} prod_i alpha_i^{e_i}`, where `e_i := sum_{l : w_{l-1} = i} (m_l + 1)`
and `sum_i e_i = 10`. Since `0 < alpha_i <= 1` and `e_i <= 10` we have
`alpha_i^{e_i} >= alpha_i^{10}`."

Every numerical constant is an explicit power of two, as the patch's scope section promises. -/

/-- The per-step constant of `Auto.lintegral_prod_dist_ge` is at least `2^{-9}` whenever the new
parameter meets at most two earlier ones of its block. -/
theorem step_const_ge {m : ℕ} (hm : m ≤ 2) : ((2 : ℝ) ^ (9 : ℕ))⁻¹ ≤ 2⁻¹ * ((8 : ℝ)⁻¹) ^ m := by
  interval_cases m <;> norm_num

/-- Six steps cost `2^{-54}`. -/
theorem six_step_const : (((2 : ℝ) ^ (9 : ℕ))⁻¹) ^ (6 : ℕ) = ((2 : ℝ) ^ (54 : ℕ))⁻¹ := by
  rw [inv_pow, ← pow_mul]

/-- The tenth power of `c_* = 2^{-240}` is `2^{-2400}`. -/
theorem cstar_pow_ten : ((((2 : ℝ) ^ (240 : ℕ))⁻¹) ^ (10 : ℕ)) = ((2 : ℝ) ^ (2400 : ℕ))⁻¹ := by
  rw [inv_pow, ← pow_mul]

/-- **The constant of the patch's `lem:integrated`.** The six steps, the tenth power of `c_*` and
the factor `1/2` of the area bound multiply to `2^{-2455}`. -/
theorem two_pow_const :
    (2 : ℝ)⁻¹ * ((2 : ℝ) ^ (54 : ℕ))⁻¹ * ((((2 : ℝ) ^ (240 : ℕ))⁻¹) ^ (10 : ℕ))
      = ((2 : ℝ) ^ (2455 : ℕ))⁻¹ := by
  rw [cstar_pow_ten, ← mul_inv, ← mul_inv]
  congr 1
  rw [← pow_succ', ← pow_add]

/-- **Patch 1 `lem:integrated`, the exponent trade.** With each `alpha_i` in `(0,1]` and each
exponent at most ten, the product `prod_i alpha_i^{e_i}` dominates `(prod_i alpha_i)^{10}`. -/
theorem prod_alpha_pow_ge {α : Fin 4 → ℝ} (hα0 : ∀ i, 0 ≤ α i) (hα1 : ∀ i, α i ≤ 1)
    {e : Fin 4 → ℕ} (he : ∀ i, e i ≤ 10) :
    (∏ i : Fin 4, α i) ^ (10 : ℕ) ≤ ∏ i : Fin 4, α i ^ e i := by
  rw [← Finset.prod_pow]
  refine Finset.prod_le_prod₀ (fun i _ => by positivity) fun i _ => ?_
  exact pow_le_pow_of_le_one (hα0 i) (hα1 i) (he i)

/-- The same, written out for the four labels. -/
theorem prod_alpha_pow_ge' {α : Fin 4 → ℝ} (hα0 : ∀ i, 0 ≤ α i) (hα1 : ∀ i, α i ≤ 1)
    {e : Fin 4 → ℕ} (he : ∀ i, e i ≤ 10) :
    (α 0 * α 1 * α 2 * α 3) ^ (10 : ℕ) ≤ ∏ i : Fin 4, α i ^ e i := by
  refine le_trans (le_of_eq ?_) (prod_alpha_pow_ge hα0 hα1 he)
  congr 1
  simp [Fin.prod_univ_four]


/-! ### Patch 1 `lem:integrated`: the lift as the six-fold product of the line

The tower of `Auto.towerCons` lives in the right-nested product `ℝ × ℝ × ℝ × ℝ × ℝ × ℝ`, while the
flow and its Jacobian live on the lift. Peeling one coordinate at a time, with
`Auto.measurePreserving_E6_prod` for the first and `Auto.measurePreserving_piFinSucc` for the rest,
identifies the two measure-preservingly; the resulting map is the tuple of the six coordinates. -/

open MeasureTheory in
/-- The six coordinates of a point of the lift, as a point of the six-fold product. -/
noncomputable def e6ToProd (s : E6) : ℝ × ℝ × ℝ × ℝ × ℝ × ℝ := (s 0, s 1, s 2, s 3, s 4, s 5)

open MeasureTheory in
/-- **The lift is measure-preservingly the six-fold product of the line.** -/
theorem measurePreserving_e6ToProd :
    MeasurePreserving e6ToProd (volume : Measure E6)
      (volume : Measure (ℝ × ℝ × ℝ × ℝ × ℝ × ℝ)) := by
  have hid : MeasurePreserving (id : ℝ → ℝ) volume volume := MeasurePreserving.id _
  have prodStep : ∀ {X Y : Type} [MeasureSpace X] [MeasureSpace Y]
      [SFinite (volume : Measure X)] [SFinite (volume : Measure Y)] (f : X → Y),
      MeasurePreserving f volume volume →
      MeasurePreserving (Prod.map (id : ℝ → ℝ) f) (volume : Measure (ℝ × X))
        (volume : Measure (ℝ × Y)) := by
    intro X Y _ _ _ _ f hf
    rw [Measure.volume_eq_prod, Measure.volume_eq_prod]
    exact hid.prod hf
  have hu : MeasurePreserving (MeasurableEquiv.funUnique (Fin 1) ℝ)
      (volume : Measure (Fin 1 → ℝ)) (volume : Measure ℝ) := volume_preserving_funUnique (Fin 1) ℝ
  have s0 := prodStep _ (prodStep _ (prodStep _ (prodStep _ (prodStep _ hu))))
  have s1 := prodStep _ (prodStep _ (prodStep _ (prodStep _ (measurePreserving_piFinSucc 1))))
  have s2 := prodStep _ (prodStep _ (prodStep _ (measurePreserving_piFinSucc 2)))
  have s3 := prodStep _ (prodStep _ (measurePreserving_piFinSucc 3))
  have s4 := prodStep _ (measurePreserving_piFinSucc 4)
  exact s0.comp (s1.comp (s2.comp (s3.comp (s4.comp measurePreserving_E6_prod))))

open MeasureTheory in
/-- Transport of a set from the six-fold product to the lift. -/
theorem measure_e6ToProd_preimage {S : Set (ℝ × ℝ × ℝ × ℝ × ℝ × ℝ)} (hS : MeasurableSet S) :
    volume (e6ToProd ⁻¹' S) = volume S :=
  measurePreserving_e6ToProd.measure_preimage hS.nullMeasurableSet

open MeasureTheory in
/-- Transport of a weighted integral from the six-fold product to the lift. -/
theorem lintegral_e6ToProd_preimage {S : Set (ℝ × ℝ × ℝ × ℝ × ℝ × ℝ)} (hS : MeasurableSet S)
    {w : ℝ × ℝ × ℝ × ℝ × ℝ × ℝ → ℝ≥0∞} (hw : Measurable w) :
    ∫⁻ s in e6ToProd ⁻¹' S, w (e6ToProd s) = ∫⁻ p in S, w p :=
  measurePreserving_e6ToProd.setLIntegral_comp_preimage hS hw


/-! ### Patch 1 `lem:integrated`: the fibres depend only on the earlier parameters

`x_l(t_1, ..., t_l)` reads only the first `l` parameters, so the fibre `I_l` of the `l`-th move is a
function of `t_1, ..., t_{l-1}` alone. That is what lets the parameter set be written as the nested
tower the integration lemma expects. -/

/-- The point after `l` moves reads only the first `l` parameters. -/
theorem flowPt_congr (w : ℕ → Fin 4) (z : E6) {t t' : ℕ → ℝ} :
    ∀ l : ℕ, (∀ m, m < l → t m = t' m) → flowPt w z t l = flowPt w z t' l := by
  intro l
  induction l with
  | zero => intro _; rfl
  | succ n ih =>
      intro h
      rw [flowPt_succ, flowPt_succ, ih (fun m hm => h m (by omega)), h n (by omega)]

/-- The fibre of the `l`-th move reads only the first `l` parameters. -/
theorem flowFibre_congr (N : ℝ) (G : ℕ → Set E6) (Gi : ℕ → Fin 3 → Set E6) (r : ℕ)
    (w : ℕ → Fin 4) (z : E6) {t t' : ℕ → ℝ} (l : ℕ) (h : ∀ m, m < l → t m = t' m) :
    flowFibre N G Gi r w z t l = flowFibre N G Gi r w z t' l := by
  rw [flowFibre, flowFibre, flowPt_congr w z l h]

/-- The sequence of six parameters read off a tuple. -/
noncomputable def seqOf (p : ℝ × ℝ × ℝ × ℝ × ℝ × ℝ) : ℕ → ℝ :=
  fun l => if l = 0 then p.1 else if l = 1 then p.2.1 else if l = 2 then p.2.2.1
    else if l = 3 then p.2.2.2.1 else if l = 4 then p.2.2.2.2.1
    else if l = 5 then p.2.2.2.2.2 else 0

theorem seqOf_e6ToProd (s : E6) : seqOf (e6ToProd s) = toSeq s := by
  funext l
  rcases l with _ | _ | _ | _ | _ | _ | n
  · rfl
  · rfl
  · rfl
  · rfl
  · rfl
  · rfl
  · simp [seqOf, toSeq]


/-! ### Patch 1 `lem:integrated`: the parameter set as a nested tower

"`P := {t in [0,N]^6 : t_l in I_l(t_1, ..., t_{l-1}) for l = 1, ..., 6}`."

Because the `l`-th fibre reads only the first `l` parameters, it is a function of the first `l`
coordinates of a tuple, and the parameter set is the nested `Auto.towerCons` built from those six
functions, pulled back to the lift along `Auto.e6ToProd`. -/

/-- The fibre of the first move. -/
noncomputable def towA1 (N : ℝ) (G : ℕ → Set E6) (Gi : ℕ → Fin 3 → Set E6) (r : ℕ)
    (w : ℕ → Fin 4) (z : E6) : Set ℝ :=
  flowFibre N G Gi r w z (seqOf (0, 0, 0, 0, 0, 0)) 0

/-- The fibre of the second move, as a function of the first parameter. -/
noncomputable def towA2 (N : ℝ) (G : ℕ → Set E6) (Gi : ℕ → Fin 3 → Set E6) (r : ℕ)
    (w : ℕ → Fin 4) (z : E6) (a : ℝ) : Set ℝ :=
  flowFibre N G Gi r w z (seqOf (a, 0, 0, 0, 0, 0)) 1

/-- The fibre of the third move. -/
noncomputable def towA3 (N : ℝ) (G : ℕ → Set E6) (Gi : ℕ → Fin 3 → Set E6) (r : ℕ)
    (w : ℕ → Fin 4) (z : E6) (a b : ℝ) : Set ℝ :=
  flowFibre N G Gi r w z (seqOf (a, b, 0, 0, 0, 0)) 2

/-- The fibre of the fourth move. -/
noncomputable def towA4 (N : ℝ) (G : ℕ → Set E6) (Gi : ℕ → Fin 3 → Set E6) (r : ℕ)
    (w : ℕ → Fin 4) (z : E6) (a b c : ℝ) : Set ℝ :=
  flowFibre N G Gi r w z (seqOf (a, b, c, 0, 0, 0)) 3

/-- The fibre of the fifth move. -/
noncomputable def towA5 (N : ℝ) (G : ℕ → Set E6) (Gi : ℕ → Fin 3 → Set E6) (r : ℕ)
    (w : ℕ → Fin 4) (z : E6) (a b c d : ℝ) : Set ℝ :=
  flowFibre N G Gi r w z (seqOf (a, b, c, d, 0, 0)) 4

/-- The fibre of the sixth move. -/
noncomputable def towA6 (N : ℝ) (G : ℕ → Set E6) (Gi : ℕ → Fin 3 → Set E6) (r : ℕ)
    (w : ℕ → Fin 4) (z : E6) (a b c d e : ℝ) : Set ℝ :=
  flowFibre N G Gi r w z (seqOf (a, b, c, d, e, 0)) 5

/-- **The tower of the six fibres.** -/
noncomputable def flowTower (N : ℝ) (G : ℕ → Set E6) (Gi : ℕ → Fin 3 → Set E6) (r : ℕ)
    (w : ℕ → Fin 4) (z : E6) : Set (ℝ × ℝ × ℝ × ℝ × ℝ × ℝ) :=
  towerCons (towA1 N G Gi r w z) fun a =>
    towerCons (towA2 N G Gi r w z a) fun b =>
      towerCons (towA3 N G Gi r w z a b) fun c =>
        towerCons (towA4 N G Gi r w z a b c) fun d =>
          towerCons (towA5 N G Gi r w z a b c d) fun e =>
            towA6 N G Gi r w z a b c d e

/-- **The parameter set of the flow is the tower, pulled back to the lift.** -/
theorem preimage_flowTower (N : ℝ) (G : ℕ → Set E6) (Gi : ℕ → Fin 3 → Set E6) (r : ℕ)
    (w : ℕ → Fin 4) (z : E6) :
    e6ToProd ⁻¹' flowTower N G Gi r w z = flowParamSet N G Gi r w z := by
  ext s
  have e0 : flowFibre N G Gi r w z (toSeq s) 0 = towA1 N G Gi r w z :=
    flowFibre_congr N G Gi r w z 0 fun m hm => absurd hm (Nat.not_lt_zero m)
  have e1 : flowFibre N G Gi r w z (toSeq s) 1 = towA2 N G Gi r w z (s 0) :=
    flowFibre_congr N G Gi r w z 1 (by intro m hm; interval_cases m; rfl)
  have e2 : flowFibre N G Gi r w z (toSeq s) 2 = towA3 N G Gi r w z (s 0) (s 1) :=
    flowFibre_congr N G Gi r w z 2 (by intro m hm; interval_cases m <;> rfl)
  have e3 : flowFibre N G Gi r w z (toSeq s) 3 = towA4 N G Gi r w z (s 0) (s 1) (s 2) :=
    flowFibre_congr N G Gi r w z 3 (by intro m hm; interval_cases m <;> rfl)
  have e4 : flowFibre N G Gi r w z (toSeq s) 4 = towA5 N G Gi r w z (s 0) (s 1) (s 2) (s 3) :=
    flowFibre_congr N G Gi r w z 4 (by intro m hm; interval_cases m <;> rfl)
  have e5 : flowFibre N G Gi r w z (toSeq s) 5
      = towA6 N G Gi r w z (s 0) (s 1) (s 2) (s 3) (s 4) :=
    flowFibre_congr N G Gi r w z 5 (by intro m hm; interval_cases m <;> rfl)
  constructor
  · rintro ⟨h0, h1, h2, h3, h4, h5⟩
    intro m hm
    interval_cases m
    · rw [e0]; exact h0
    · rw [e1]; exact h1
    · rw [e2]; exact h2
    · rw [e3]; exact h3
    · rw [e4]; exact h4
    · rw [e5]; exact h5
  · intro h
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
    · have hh := h 0 (by omega); rw [e0] at hh; exact hh
    · have hh := h 1 (by omega); rw [e1] at hh; exact hh
    · have hh := h 2 (by omega); rw [e2] at hh; exact hh
    · have hh := h 3 (by omega); rw [e3] at hh; exact hh
    · have hh := h 4 (by omega); rw [e4] at hh; exact hh
    · have hh := h 5 (by omega); rw [e5] at hh; exact hh


/-! ### Patch 1 `lem:integrated`: the Jacobian as a product of per-move factors

"At the `l`-th step the integrand contains exactly the `m_l` factors `|t_l - t_{l'}|`, `l' < l`, in
block `i(l)`, times a quantity independent of `t_l`."

For `w^(3)` the blocks are `B_1 = {0}`, `B_2 = {1,2}`, `B_3 = {3,4,5}` in the zero-based numbering,
so the moves `2`, `4` and `5` carry respectively one, one and two Vandermonde factors, and the
moves `0`, `1`, `3` carry none. The six factors multiply to the Jacobian divided by `12`. -/

/-- The factor carried by the first move of `w^(3)`: none. -/
noncomputable def jg1 : ℝ → ℝ≥0∞ := fun _ => 1

/-- The factor carried by the second move of `w^(3)`: none. -/
noncomputable def jg2 : ℝ → ℝ → ℝ≥0∞ := fun _ _ => 1

/-- The third move closes the degree-two block. -/
noncomputable def jg3 : ℝ → ℝ → ℝ → ℝ≥0∞ := fun _ b c => ENNReal.ofReal |c - b|

/-- The fourth move opens the degree-three block. -/
noncomputable def jg4 : ℝ → ℝ → ℝ → ℝ → ℝ≥0∞ := fun _ _ _ _ => 1

/-- The fifth move meets one earlier parameter of the degree-three block. -/
noncomputable def jg5 : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ≥0∞ := fun _ _ _ d e => ENNReal.ofReal |e - d|

/-- The sixth move meets two earlier parameters of the degree-three block. -/
noncomputable def jg6 : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ≥0∞ :=
  fun _ _ _ d e f => ENNReal.ofReal |f - d| * ENNReal.ofReal |f - e|

/-- **The six per-move factors are dominated by the Jacobian of the flow of `w^(3)`.** They
multiply to the Jacobian divided by `12`. -/
theorem jacWeight3_le (s : E6) :
    jg1 (s 0) * (jg2 (s 0) (s 1) * (jg3 (s 0) (s 1) (s 2) * (jg4 (s 0) (s 1) (s 2) (s 3) *
      (jg5 (s 0) (s 1) (s 2) (s 3) (s 4) * jg6 (s 0) (s 1) (s 2) (s 3) (s 4) (s 5)))))
      ≤ ENNReal.ofReal |LinearMap.det ((flowDeriv3 s : E6 →L[ℝ] E6) : E6 →ₗ[ℝ] E6)| := by
  rw [abs_det_flowDeriv3]
  simp only [jg1, jg2, jg3, jg4, jg5, jg6, one_mul]
  rw [← ENNReal.ofReal_mul (abs_nonneg _), ← ENNReal.ofReal_mul (abs_nonneg _),
    ← ENNReal.ofReal_mul (abs_nonneg _)]
  refine ENNReal.ofReal_le_ofReal ?_
  have h1 : |s 2 - s 1| = |s 1 - s 2| := abs_sub_comm _ _
  have h2 : |s 4 - s 3| = |s 3 - s 4| := abs_sub_comm _ _
  have h3 : |s 5 - s 3| = |s 3 - s 5| := abs_sub_comm _ _
  have h4 : |s 5 - s 4| = |s 4 - s 5| := abs_sub_comm _ _
  rw [h1, h2, h3, h4]
  nlinarith [abs_nonneg (s 1 - s 2), abs_nonneg (s 3 - s 4), abs_nonneg (s 3 - s 5),
    abs_nonneg (s 4 - s 5),
    mul_nonneg (mul_nonneg (mul_nonneg (abs_nonneg (s 1 - s 2)) (abs_nonneg (s 3 - s 4)))
      (abs_nonneg (s 3 - s 5))) (abs_nonneg (s 4 - s 5))]


/-! ### Patch 1 `lem:integrated`: measurability in the tower coordinates

The six fibre conditions, read on a tuple rather than on a point of the lift. Each is the preimage
of a measurable set under a continuous map, exactly as in `Auto.measurableSet_flowParamSet`, and
the intermediate towers of the integration are preimages of intersections of these under the
continuous map that fixes the earlier parameters. -/
theorem continuous_seqOf_apply (m : ℕ) :
    Continuous fun p : ℝ × ℝ × ℝ × ℝ × ℝ × ℝ => seqOf p m := by
  match m with
  | 0 => exact continuous_fst
  | 1 => exact continuous_fst.comp continuous_snd
  | 2 => exact continuous_fst.comp (continuous_snd.comp continuous_snd)
  | 3 => exact continuous_fst.comp (continuous_snd.comp (continuous_snd.comp continuous_snd))
  | 4 => exact continuous_fst.comp (continuous_snd.comp (continuous_snd.comp
      (continuous_snd.comp continuous_snd)))
  | 5 => exact continuous_snd.comp (continuous_snd.comp (continuous_snd.comp
      (continuous_snd.comp continuous_snd)))
  | (n + 6) =>
      have h : (fun p : ℝ × ℝ × ℝ × ℝ × ℝ × ℝ => seqOf p (n + 6)) = fun _ => 0 := by
        funext p
        simp [seqOf]
      rw [h]
      exact continuous_const

theorem continuous_flowPt_seqOf (w : ℕ → Fin 4) (z : E6) :
    ∀ m : ℕ, Continuous fun p : ℝ × ℝ × ℝ × ℝ × ℝ × ℝ => flowPt w z (seqOf p) m := by
  intro m
  induction m with
  | zero => exact continuous_const
  | succ n ih =>
      simp only [flowPt_succ]
      exact (ih.add ((continuous_curve4 (w (n + 1))).comp (continuous_seqOf_apply n))).sub
        ((continuous_curve4 (w n)).comp (continuous_seqOf_apply n))

/-- The `l`-th fibre condition, read on a tuple. -/
def towCond (N : ℝ) (G : ℕ → Set E6) (Gi : ℕ → Fin 3 → Set E6) (r : ℕ)
    (w : ℕ → Fin 4) (z : E6) (l : ℕ) : Set (ℝ × ℝ × ℝ × ℝ × ℝ × ℝ) :=
  {p | seqOf p l ∈ flowFibre N G Gi r w z (seqOf p) l}

open MeasureTheory in
theorem measurableSet_towCond (N : ℝ) {G : ℕ → Set E6} {Gi : ℕ → Fin 3 → Set E6}
    (hGm : ∀ k, MeasurableSet (G k)) (hGim : ∀ k i, MeasurableSet (Gi k i)) (r : ℕ)
    (w : ℕ → Fin 4) (z : E6) (l : ℕ) : MeasurableSet (towCond N G Gi r w z l) := by
  have hcfg : ∀ (k : ℕ) (b : Fin 4), MeasurableSet (cfg4 (G k) (Gi k) b) := by
    intro k b
    rcases Fin.eq_zero_or_eq_succ b with rfl | ⟨i, rfl⟩
    · exact hGm k
    · exact hGim k i
  have hIoc : MeasurableSet {p : ℝ × ℝ × ℝ × ℝ × ℝ × ℝ | seqOf p l ∈ Set.Ioc (0 : ℝ) N} :=
    (continuous_seqOf_apply l).measurable measurableSet_Ioc
  have hstep : ∀ b : Fin 4, MeasurableSet
      {p : ℝ × ℝ × ℝ × ℝ × ℝ × ℝ | flowPt w z (seqOf p) l + curve4 b (seqOf p l)
        - curve4 (w l) (seqOf p l) ∈ cfg4 (G (r - l - 1)) (Gi (r - l - 1)) b} := by
    intro b
    refine (Continuous.measurable ?_) (hcfg (r - l - 1) b)
    exact ((continuous_flowPt_seqOf w z l).add
      ((continuous_curve4 b).comp (continuous_seqOf_apply l))).sub
      ((continuous_curve4 (w l)).comp (continuous_seqOf_apply l))
  have hrw : towCond N G Gi r w z l
      = {p : ℝ × ℝ × ℝ × ℝ × ℝ × ℝ | seqOf p l ∈ Set.Ioc (0 : ℝ) N} ∩
        ⋂ b : Fin 4, ⋂ _ : b ≠ w l,
          {p : ℝ × ℝ × ℝ × ℝ × ℝ × ℝ | flowPt w z (seqOf p) l + curve4 b (seqOf p l)
            - curve4 (w l) (seqOf p l) ∈ cfg4 (G (r - l - 1)) (Gi (r - l - 1)) b} := by
    ext p
    simp [towCond, flowFibre, transSet]
  rw [hrw]
  exact hIoc.inter (MeasurableSet.iInter fun b => MeasurableSet.iInter fun _ => hstep b)


/-! ### Patch 1 `lem:integrated`: the towers of the integration are measurable

The full tower is the intersection of the six fibre conditions, and each intermediate tower of the
integration is the preimage of an intersection of the later ones under the continuous map that
fixes the earlier parameters. Measurability follows from `Auto.measurableSet_towCond`. -/
theorem flowTower_eq (N : ℝ) (G : ℕ → Set E6) (Gi : ℕ → Fin 3 → Set E6) (r : ℕ)
    (w : ℕ → Fin 4) (z : E6) :
    flowTower N G Gi r w z
      = towCond N G Gi r w z 0 ∩ (towCond N G Gi r w z 1 ∩ (towCond N G Gi r w z 2 ∩
          (towCond N G Gi r w z 3 ∩ (towCond N G Gi r w z 4 ∩ towCond N G Gi r w z 5)))) := by
  ext p
  have e0 : flowFibre N G Gi r w z (seqOf p) 0 = towA1 N G Gi r w z :=
    flowFibre_congr N G Gi r w z 0 fun m hm => absurd hm (Nat.not_lt_zero m)
  have e1 : flowFibre N G Gi r w z (seqOf p) 1 = towA2 N G Gi r w z p.1 :=
    flowFibre_congr N G Gi r w z 1 (by intro m hm; interval_cases m; rfl)
  have e2 : flowFibre N G Gi r w z (seqOf p) 2 = towA3 N G Gi r w z p.1 p.2.1 :=
    flowFibre_congr N G Gi r w z 2 (by intro m hm; interval_cases m <;> rfl)
  have e3 : flowFibre N G Gi r w z (seqOf p) 3 = towA4 N G Gi r w z p.1 p.2.1 p.2.2.1 :=
    flowFibre_congr N G Gi r w z 3 (by intro m hm; interval_cases m <;> rfl)
  have e4 : flowFibre N G Gi r w z (seqOf p) 4
      = towA5 N G Gi r w z p.1 p.2.1 p.2.2.1 p.2.2.2.1 :=
    flowFibre_congr N G Gi r w z 4 (by intro m hm; interval_cases m <;> rfl)
  have e5 : flowFibre N G Gi r w z (seqOf p) 5
      = towA6 N G Gi r w z p.1 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2.1 :=
    flowFibre_congr N G Gi r w z 5 (by intro m hm; interval_cases m <;> rfl)
  simp only [flowTower, towerCons, towCond, Set.mem_ofPred_eq, Set.mem_inter_iff, e0, e1, e2, e3,
    e4, e5]
  tauto

open MeasureTheory in
theorem measurableSet_flowTower (N : ℝ) {G : ℕ → Set E6} {Gi : ℕ → Fin 3 → Set E6}
    (hGm : ∀ k, MeasurableSet (G k)) (hGim : ∀ k i, MeasurableSet (Gi k i)) (r : ℕ)
    (w : ℕ → Fin 4) (z : E6) : MeasurableSet (flowTower N G Gi r w z) := by
  rw [flowTower_eq]
  exact (measurableSet_towCond N hGm hGim r w z 0).inter
    ((measurableSet_towCond N hGm hGim r w z 1).inter
      ((measurableSet_towCond N hGm hGim r w z 2).inter
        ((measurableSet_towCond N hGm hGim r w z 3).inter
          ((measurableSet_towCond N hGm hGim r w z 4).inter
            (measurableSet_towCond N hGm hGim r w z 5)))))

theorem towerCons5_eq (N : ℝ) (G : ℕ → Set E6) (Gi : ℕ → Fin 3 → Set E6) (r : ℕ)
    (w : ℕ → Fin 4) (z : E6) (a b c d : ℝ) :
    towerCons (towA5 N G Gi r w z a b c d) (fun e => towA6 N G Gi r w z a b c d e)
      = (fun q : ℝ × ℝ => ((a, b, c, d, q.1, q.2) : ℝ × ℝ × ℝ × ℝ × ℝ × ℝ)) ⁻¹'
        (towCond N G Gi r w z 4 ∩ towCond N G Gi r w z 5) := by
  ext q
  have e4 : flowFibre N G Gi r w z (seqOf (a, b, c, d, q.1, q.2)) 4
      = towA5 N G Gi r w z a b c d :=
    flowFibre_congr N G Gi r w z 4 (by intro m hm; interval_cases m <;> rfl)
  have e5 : flowFibre N G Gi r w z (seqOf (a, b, c, d, q.1, q.2)) 5
      = towA6 N G Gi r w z a b c d q.1 :=
    flowFibre_congr N G Gi r w z 5 (by intro m hm; interval_cases m <;> rfl)
  simp only [towerCons, towCond, Set.mem_ofPred_eq, Set.mem_preimage, Set.mem_inter_iff, e4, e5]
  tauto

theorem towerCons4_eq (N : ℝ) (G : ℕ → Set E6) (Gi : ℕ → Fin 3 → Set E6) (r : ℕ)
    (w : ℕ → Fin 4) (z : E6) (a b c : ℝ) :
    towerCons (towA4 N G Gi r w z a b c) (fun d =>
        towerCons (towA5 N G Gi r w z a b c d) fun e => towA6 N G Gi r w z a b c d e)
      = (fun q : ℝ × ℝ × ℝ => ((a, b, c, q.1, q.2.1, q.2.2) : ℝ × ℝ × ℝ × ℝ × ℝ × ℝ)) ⁻¹'
        (towCond N G Gi r w z 3 ∩ (towCond N G Gi r w z 4 ∩ towCond N G Gi r w z 5)) := by
  ext q
  have e3 : flowFibre N G Gi r w z (seqOf (a, b, c, q.1, q.2.1, q.2.2)) 3
      = towA4 N G Gi r w z a b c :=
    flowFibre_congr N G Gi r w z 3 (by intro m hm; interval_cases m <;> rfl)
  have e4 : flowFibre N G Gi r w z (seqOf (a, b, c, q.1, q.2.1, q.2.2)) 4
      = towA5 N G Gi r w z a b c q.1 :=
    flowFibre_congr N G Gi r w z 4 (by intro m hm; interval_cases m <;> rfl)
  have e5 : flowFibre N G Gi r w z (seqOf (a, b, c, q.1, q.2.1, q.2.2)) 5
      = towA6 N G Gi r w z a b c q.1 q.2.1 :=
    flowFibre_congr N G Gi r w z 5 (by intro m hm; interval_cases m <;> rfl)
  simp only [towerCons, towCond, Set.mem_ofPred_eq, Set.mem_preimage, Set.mem_inter_iff, e3, e4, e5]
  tauto

theorem towerCons3_eq (N : ℝ) (G : ℕ → Set E6) (Gi : ℕ → Fin 3 → Set E6) (r : ℕ)
    (w : ℕ → Fin 4) (z : E6) (a b : ℝ) :
    towerCons (towA3 N G Gi r w z a b) (fun c =>
        towerCons (towA4 N G Gi r w z a b c) fun d =>
          towerCons (towA5 N G Gi r w z a b c d) fun e => towA6 N G Gi r w z a b c d e)
      = (fun q : ℝ × ℝ × ℝ × ℝ =>
          ((a, b, q.1, q.2.1, q.2.2.1, q.2.2.2) : ℝ × ℝ × ℝ × ℝ × ℝ × ℝ)) ⁻¹'
        (towCond N G Gi r w z 2 ∩ (towCond N G Gi r w z 3 ∩
          (towCond N G Gi r w z 4 ∩ towCond N G Gi r w z 5))) := by
  ext q
  have e2 : flowFibre N G Gi r w z (seqOf (a, b, q.1, q.2.1, q.2.2.1, q.2.2.2)) 2
      = towA3 N G Gi r w z a b :=
    flowFibre_congr N G Gi r w z 2 (by intro m hm; interval_cases m <;> rfl)
  have e3 : flowFibre N G Gi r w z (seqOf (a, b, q.1, q.2.1, q.2.2.1, q.2.2.2)) 3
      = towA4 N G Gi r w z a b q.1 :=
    flowFibre_congr N G Gi r w z 3 (by intro m hm; interval_cases m <;> rfl)
  have e4 : flowFibre N G Gi r w z (seqOf (a, b, q.1, q.2.1, q.2.2.1, q.2.2.2)) 4
      = towA5 N G Gi r w z a b q.1 q.2.1 :=
    flowFibre_congr N G Gi r w z 4 (by intro m hm; interval_cases m <;> rfl)
  have e5 : flowFibre N G Gi r w z (seqOf (a, b, q.1, q.2.1, q.2.2.1, q.2.2.2)) 5
      = towA6 N G Gi r w z a b q.1 q.2.1 q.2.2.1 :=
    flowFibre_congr N G Gi r w z 5 (by intro m hm; interval_cases m <;> rfl)
  simp only [towerCons, towCond, Set.mem_ofPred_eq, Set.mem_preimage, Set.mem_inter_iff, e2, e3, e4,
    e5]
  tauto

theorem towerCons2_eq (N : ℝ) (G : ℕ → Set E6) (Gi : ℕ → Fin 3 → Set E6) (r : ℕ)
    (w : ℕ → Fin 4) (z : E6) (a : ℝ) :
    towerCons (towA2 N G Gi r w z a) (fun b =>
        towerCons (towA3 N G Gi r w z a b) fun c =>
          towerCons (towA4 N G Gi r w z a b c) fun d =>
            towerCons (towA5 N G Gi r w z a b c d) fun e => towA6 N G Gi r w z a b c d e)
      = (fun q : ℝ × ℝ × ℝ × ℝ × ℝ =>
          ((a, q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2) : ℝ × ℝ × ℝ × ℝ × ℝ × ℝ)) ⁻¹'
        (towCond N G Gi r w z 1 ∩ (towCond N G Gi r w z 2 ∩ (towCond N G Gi r w z 3 ∩
          (towCond N G Gi r w z 4 ∩ towCond N G Gi r w z 5)))) := by
  ext q
  have e1 : flowFibre N G Gi r w z (seqOf (a, q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2)) 1
      = towA2 N G Gi r w z a :=
    flowFibre_congr N G Gi r w z 1 (by intro m hm; interval_cases m; rfl)
  have e2 : flowFibre N G Gi r w z (seqOf (a, q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2)) 2
      = towA3 N G Gi r w z a q.1 :=
    flowFibre_congr N G Gi r w z 2 (by intro m hm; interval_cases m <;> rfl)
  have e3 : flowFibre N G Gi r w z (seqOf (a, q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2)) 3
      = towA4 N G Gi r w z a q.1 q.2.1 :=
    flowFibre_congr N G Gi r w z 3 (by intro m hm; interval_cases m <;> rfl)
  have e4 : flowFibre N G Gi r w z (seqOf (a, q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2)) 4
      = towA5 N G Gi r w z a q.1 q.2.1 q.2.2.1 :=
    flowFibre_congr N G Gi r w z 4 (by intro m hm; interval_cases m <;> rfl)
  have e5 : flowFibre N G Gi r w z (seqOf (a, q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2)) 5
      = towA6 N G Gi r w z a q.1 q.2.1 q.2.2.1 q.2.2.2.1 :=
    flowFibre_congr N G Gi r w z 5 (by intro m hm; interval_cases m <;> rfl)
  simp only [towerCons, towCond, Set.mem_ofPred_eq, Set.mem_preimage, Set.mem_inter_iff, e1, e2, e3,
    e4, e5]
  tauto


