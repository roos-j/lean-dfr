open MeasureTheory in
/-- The six fibre sets of the tower are measurable. -/
theorem measurableSet_towA (N : ℝ) {G : ℕ → Set E6} {Gi : ℕ → Fin 3 → Set E6}
    (hGm : ∀ k, MeasurableSet (G k)) (hGim : ∀ k i, MeasurableSet (Gi k i)) (r : ℕ)
    (w : ℕ → Fin 4) (z : E6) :
    MeasurableSet (towA1 N G Gi r w z) ∧
    (∀ a, MeasurableSet (towA2 N G Gi r w z a)) ∧
    (∀ a b, MeasurableSet (towA3 N G Gi r w z a b)) ∧
    (∀ a b c, MeasurableSet (towA4 N G Gi r w z a b c)) ∧
    (∀ a b c d, MeasurableSet (towA5 N G Gi r w z a b c d)) ∧
    (∀ a b c d e, MeasurableSet (towA6 N G Gi r w z a b c d e)) :=
  ⟨measurableSet_transSet N (hGm _) (hGim _) _ _,
    fun _ => measurableSet_transSet N (hGm _) (hGim _) _ _,
    fun _ _ => measurableSet_transSet N (hGm _) (hGim _) _ _,
    fun _ _ _ => measurableSet_transSet N (hGm _) (hGim _) _ _,
    fun _ _ _ _ => measurableSet_transSet N (hGm _) (hGim _) _ _,
    fun _ _ _ _ _ => measurableSet_transSet N (hGm _) (hGim _) _ _⟩


/-! ### Patch 1 `lem:integrated` for `w^(3)`: the six steps composed

Each of the six fibre bounds of `Auto.volume_flowFibre_ge` feeds `Auto.lintegral_prod_dist_ge`, and
`Auto.lintegral_tower6_ge` multiplies the results. The exponents are the `(m_l + 1)` of
`Auto.mCount_word3_values`, namely `1, 1, 2, 1, 2, 3`, summing to `D* = 10`. -/

open MeasureTheory in
/-- **Patch 1 `lem:integrated` for `w^(3)`.** The integral of the per-move Vandermonde weight over
the tower is at least the product of the six per-step bounds. -/
theorem lintegral_jacWeight3_flowTower_ge (N : ℝ) {G : ℕ → Set E6} {Gi : ℕ → Fin 3 → Set E6}
    (hGm : ∀ k, MeasurableSet (G k)) (hGim : ∀ k i, MeasurableSet (Gi k i)) (r : ℕ) (z : E6)
    {a : ℕ → ℝ} (ha : ∀ l, 0 ≤ a l * N)
    (hf1 : ENNReal.ofReal (a 0 * N) ≤ volume (towA1 N G Gi r word3 z))
    (hf2 : ∀ x ∈ towA1 N G Gi r word3 z,
      ENNReal.ofReal (a 1 * N) ≤ volume (towA2 N G Gi r word3 z x))
    (hf3 : ∀ x ∈ towA1 N G Gi r word3 z, ∀ y ∈ towA2 N G Gi r word3 z x,
      ENNReal.ofReal (a 2 * N) ≤ volume (towA3 N G Gi r word3 z x y))
    (hf4 : ∀ x ∈ towA1 N G Gi r word3 z, ∀ y ∈ towA2 N G Gi r word3 z x,
      ∀ u ∈ towA3 N G Gi r word3 z x y,
      ENNReal.ofReal (a 3 * N) ≤ volume (towA4 N G Gi r word3 z x y u))
    (hf5 : ∀ x ∈ towA1 N G Gi r word3 z, ∀ y ∈ towA2 N G Gi r word3 z x,
      ∀ u ∈ towA3 N G Gi r word3 z x y, ∀ v ∈ towA4 N G Gi r word3 z x y u,
      ENNReal.ofReal (a 4 * N) ≤ volume (towA5 N G Gi r word3 z x y u v))
    (hf6 : ∀ x ∈ towA1 N G Gi r word3 z, ∀ y ∈ towA2 N G Gi r word3 z x,
      ∀ u ∈ towA3 N G Gi r word3 z x y, ∀ v ∈ towA4 N G Gi r word3 z x y u,
      ∀ t ∈ towA5 N G Gi r word3 z x y u v,
      ENNReal.ofReal (a 5 * N) ≤ volume (towA6 N G Gi r word3 z x y u v t)) :
    ENNReal.ofReal (2⁻¹ * (a 0 * N)) * ENNReal.ofReal (2⁻¹ * (a 1 * N))
        * ENNReal.ofReal (2⁻¹ * (8 : ℝ)⁻¹ * (a 2 * N) ^ 2)
        * ENNReal.ofReal (2⁻¹ * (a 3 * N))
        * ENNReal.ofReal (2⁻¹ * (8 : ℝ)⁻¹ * (a 4 * N) ^ 2)
        * ENNReal.ofReal (2⁻¹ * ((8 : ℝ)⁻¹) ^ 2 * (a 5 * N) ^ 3)
      ≤ ∫⁻ p in flowTower N G Gi r word3 z,
        jg1 p.1 * (jg2 p.1 p.2.1 * (jg3 p.1 p.2.1 p.2.2.1 *
          (jg4 p.1 p.2.1 p.2.2.1 p.2.2.2.1 * (jg5 p.1 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2.1 *
            jg6 p.1 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2.1 p.2.2.2.2.2)))) := by
  obtain ⟨hA1, hA2, hA3, hA4, hA5, hA6⟩ := measurableSet_towA N hGm hGim r word3 z
  have h1 : ENNReal.ofReal (2⁻¹ * (a 0 * N))
      ≤ ∫⁻ x in towA1 N G Gi r word3 z, jg1 x := by
    have h := lintegral_prod_dist_ge hA1 hf1 (m := 0) (by norm_num) ![] (ha 0)
    simpa [jg1] using h
  have h2 : ∀ x ∈ towA1 N G Gi r word3 z, ENNReal.ofReal (2⁻¹ * (a 1 * N))
      ≤ ∫⁻ y in towA2 N G Gi r word3 z x, jg2 x y := by
    intro x hx
    have h := lintegral_prod_dist_ge (hA2 x) (hf2 x hx) (m := 0) (by norm_num) ![] (ha 1)
    simpa [jg2] using h
  have h3 : ∀ x ∈ towA1 N G Gi r word3 z, ∀ y ∈ towA2 N G Gi r word3 z x,
      ENNReal.ofReal (2⁻¹ * (8 : ℝ)⁻¹ * (a 2 * N) ^ 2)
        ≤ ∫⁻ c in towA3 N G Gi r word3 z x y, jg3 x y c := by
    intro x hx y hy
    have h := lintegral_prod_dist_ge (hA3 x y) (hf3 x hx y hy) (m := 1) (by norm_num) ![y] (ha 2)
    simpa [jg3, Fin.prod_univ_one] using h
  have h4 : ∀ x ∈ towA1 N G Gi r word3 z, ∀ y ∈ towA2 N G Gi r word3 z x,
      ∀ c ∈ towA3 N G Gi r word3 z x y, ENNReal.ofReal (2⁻¹ * (a 3 * N))
        ≤ ∫⁻ d in towA4 N G Gi r word3 z x y c, jg4 x y c d := by
    intro x hx y hy c hc
    have h := lintegral_prod_dist_ge (hA4 x y c) (hf4 x hx y hy c hc)
      (m := 0) (by norm_num) ![] (ha 3)
    simpa [jg4] using h
  have h5 : ∀ x ∈ towA1 N G Gi r word3 z, ∀ y ∈ towA2 N G Gi r word3 z x,
      ∀ c ∈ towA3 N G Gi r word3 z x y, ∀ d ∈ towA4 N G Gi r word3 z x y c,
      ENNReal.ofReal (2⁻¹ * (8 : ℝ)⁻¹ * (a 4 * N) ^ 2)
        ≤ ∫⁻ e in towA5 N G Gi r word3 z x y c d, jg5 x y c d e := by
    intro x hx y hy c hc d hd
    have h := lintegral_prod_dist_ge (hA5 x y c d) (hf5 x hx y hy c hc d hd)
      (m := 1) (by norm_num) ![d] (ha 4)
    simpa [jg5, Fin.prod_univ_one] using h
  have h6 : ∀ x ∈ towA1 N G Gi r word3 z, ∀ y ∈ towA2 N G Gi r word3 z x,
      ∀ c ∈ towA3 N G Gi r word3 z x y, ∀ d ∈ towA4 N G Gi r word3 z x y c,
      ∀ e ∈ towA5 N G Gi r word3 z x y c d,
      ENNReal.ofReal (2⁻¹ * ((8 : ℝ)⁻¹) ^ 2 * (a 5 * N) ^ 3)
        ≤ ∫⁻ f in towA6 N G Gi r word3 z x y c d e, jg6 x y c d e f := by
    intro x hx y hy c hc d hd e he
    have h := lintegral_prod_dist_ge (hA6 x y c d e) (hf6 x hx y hy c hc d hd e he)
      (m := 2) le_rfl ![d, e]
      (ha 5)
    simpa [jg6, Fin.prod_univ_two] using h
  exact lintegral_tower6_ge ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top
    ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top hA1 hA2 hA3 hA4 hA5
    (fun x y c d => measurableSet_towerCons5 N hGm hGim r word3 z x y c d)
    (fun x y c => measurableSet_towerCons4 N hGm hGim r word3 z x y c)
    (fun x y => measurableSet_towerCons3 N hGm hGim r word3 z x y)
    (fun x => measurableSet_towerCons2 N hGm hGim r word3 z x)
    (measurableSet_flowTower N hGm hGim r word3 z)
    (fun x y c d => by simp only [jg5, jg6]; fun_prop)
    (fun x y c => by simp only [jg4, jg5, jg6]; fun_prop)
    (fun x y => by simp only [jg3, jg4, jg5, jg6]; fun_prop)
    (fun x => by simp only [jg2, jg3, jg4, jg5, jg6]; fun_prop)
    (by simp only [jg1, jg2, jg3, jg4, jg5, jg6]; fun_prop)
    h1 h2 h3 h4 h5 h6


/-! ### Patch 1 `lem:integrated` for `w^(3)`: the bound on the lift

Transporting the tower bound back to the lift along `Auto.e6ToProd` and dominating the per-move
weight by the Jacobian gives the patch's `int_P |det D Phi| >= ...`. -/

open MeasureTheory in
/-- **Patch 1 `lem:integrated` for `w^(3)`: the integral of the Jacobian over the parameter set is
at least the product of the six per-step bounds.** -/
theorem lintegral_absDet_flowParamSet_ge (N : ℝ) {G : ℕ → Set E6} {Gi : ℕ → Fin 3 → Set E6}
    (hGm : ∀ k, MeasurableSet (G k)) (hGim : ∀ k i, MeasurableSet (Gi k i)) (r : ℕ) (z : E6)
    {a : ℕ → ℝ} (ha : ∀ l, 0 ≤ a l * N)
    (hf1 : ENNReal.ofReal (a 0 * N) ≤ volume (towA1 N G Gi r word3 z))
    (hf2 : ∀ x ∈ towA1 N G Gi r word3 z,
      ENNReal.ofReal (a 1 * N) ≤ volume (towA2 N G Gi r word3 z x))
    (hf3 : ∀ x ∈ towA1 N G Gi r word3 z, ∀ y ∈ towA2 N G Gi r word3 z x,
      ENNReal.ofReal (a 2 * N) ≤ volume (towA3 N G Gi r word3 z x y))
    (hf4 : ∀ x ∈ towA1 N G Gi r word3 z, ∀ y ∈ towA2 N G Gi r word3 z x,
      ∀ u ∈ towA3 N G Gi r word3 z x y,
      ENNReal.ofReal (a 3 * N) ≤ volume (towA4 N G Gi r word3 z x y u))
    (hf5 : ∀ x ∈ towA1 N G Gi r word3 z, ∀ y ∈ towA2 N G Gi r word3 z x,
      ∀ u ∈ towA3 N G Gi r word3 z x y, ∀ v ∈ towA4 N G Gi r word3 z x y u,
      ENNReal.ofReal (a 4 * N) ≤ volume (towA5 N G Gi r word3 z x y u v))
    (hf6 : ∀ x ∈ towA1 N G Gi r word3 z, ∀ y ∈ towA2 N G Gi r word3 z x,
      ∀ u ∈ towA3 N G Gi r word3 z x y, ∀ v ∈ towA4 N G Gi r word3 z x y u,
      ∀ t ∈ towA5 N G Gi r word3 z x y u v,
      ENNReal.ofReal (a 5 * N) ≤ volume (towA6 N G Gi r word3 z x y u v t)) :
    ENNReal.ofReal (2⁻¹ * (a 0 * N)) * ENNReal.ofReal (2⁻¹ * (a 1 * N))
        * ENNReal.ofReal (2⁻¹ * (8 : ℝ)⁻¹ * (a 2 * N) ^ 2)
        * ENNReal.ofReal (2⁻¹ * (a 3 * N))
        * ENNReal.ofReal (2⁻¹ * (8 : ℝ)⁻¹ * (a 4 * N) ^ 2)
        * ENNReal.ofReal (2⁻¹ * ((8 : ℝ)⁻¹) ^ 2 * (a 5 * N) ^ 3)
      ≤ ∫⁻ s in flowParamSet N G Gi r word3 z,
        ENNReal.ofReal |LinearMap.det ((flowDeriv3 s : E6 →L[ℝ] E6) : E6 →ₗ[ℝ] E6)| := by
  have hwm : Measurable fun p : ℝ × ℝ × ℝ × ℝ × ℝ × ℝ =>
      jg1 p.1 * (jg2 p.1 p.2.1 * (jg3 p.1 p.2.1 p.2.2.1 *
        (jg4 p.1 p.2.1 p.2.2.1 p.2.2.2.1 * (jg5 p.1 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2.1 *
          jg6 p.1 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2.1 p.2.2.2.2.2)))) := by
    simp only [jg1, jg2, jg3, jg4, jg5, jg6]
    fun_prop
  refine le_trans (lintegral_jacWeight3_flowTower_ge N hGm hGim r z ha hf1 hf2 hf3 hf4 hf5 hf6) ?_
  rw [← lintegral_e6ToProd_preimage (measurableSet_flowTower N hGm hGim r word3 z) hwm,
    preimage_flowTower]
  exact setLIntegral_mono' (measurableSet_flowParamSet N hGm hGim r word3 z)
    fun s _ => jacWeight3_le s


/-! ### Patch 1 `lem:integrated` for `w^(3)`: the noncritical part and the area bound

"`int_P |det D Phi| = int_{P^circ} |det D Phi|`, since the integrand vanishes off `P^circ`."

The noncritical set is where the four Vandermonde factors are nonzero, which is exactly the
hypothesis of the injective cover, so the area bound of `Auto.real_flow_jacobian_word3` applies to
it and gives the patch's `|E_{j'}| >= (1/2) int_P |det D Phi|`. -/

/-- The noncritical set of the flow of `w^(3)`: where its Jacobian does not vanish. -/
def ndSet3 : Set E6 :=
  {s : E6 | s 1 ≠ s 2 ∧ (s 3 - s 4) * (s 4 - s 5) ≠ 0 ∧ s 3 ≠ s 5}

open MeasureTheory in
theorem measurableSet_ndSet3 : MeasurableSet ndSet3 := by
  have h12 : MeasurableSet {s : E6 | s 1 ≠ s 2} :=
    (measurableSet_eq_fun (continuous_E6_coord 1).measurable
      (continuous_E6_coord 2).measurable).compl
  have h35 : MeasurableSet {s : E6 | s 3 ≠ s 5} :=
    (measurableSet_eq_fun (continuous_E6_coord 3).measurable
      (continuous_E6_coord 5).measurable).compl
  have hmul : MeasurableSet {s : E6 | (s 3 - s 4) * (s 4 - s 5) ≠ 0} := by
    have hc : Measurable fun s : E6 => (s 3 - s 4) * (s 4 - s 5) :=
      (((continuous_E6_coord 3).sub (continuous_E6_coord 4)).mul
        ((continuous_E6_coord 4).sub (continuous_E6_coord 5))).measurable
    exact (measurableSet_eq_fun hc measurable_const).compl
  exact h12.inter (hmul.inter h35)

/-- Off the noncritical set the Jacobian vanishes. -/
theorem absDet_flowDeriv3_eq_zero {s : E6} (h : s ∉ ndSet3) :
    |LinearMap.det ((flowDeriv3 s : E6 →L[ℝ] E6) : E6 →ₗ[ℝ] E6)| = 0 := by
  rw [abs_det_flowDeriv3]
  rw [ndSet3, Set.mem_ofPred_eq] at h
  rcases not_and_or.mp h with h1 | h2
  · rw [not_not] at h1
    rw [abs_eq_zero.mpr (sub_eq_zero.mpr h1)]
    ring
  · rcases not_and_or.mp h2 with h3 | h4
    · rw [not_not] at h3
      rcases mul_eq_zero.mp h3 with h5 | h6
      · rw [abs_eq_zero.mpr h5]
        ring
      · rw [abs_eq_zero.mpr h6]
        ring
    · rw [not_not] at h4
      rw [abs_eq_zero.mpr (sub_eq_zero.mpr h4)]
      ring

open MeasureTheory in
/-- The Jacobian integral is carried by the noncritical part of the parameter set. -/
theorem lintegral_absDet_eq_ndSet3 (N : ℝ) {G : ℕ → Set E6} {Gi : ℕ → Fin 3 → Set E6}
    (hGm : ∀ k, MeasurableSet (G k)) (hGim : ∀ k i, MeasurableSet (Gi k i)) (r : ℕ) (z : E6) :
    ∫⁻ s in flowParamSet N G Gi r word3 z,
        ENNReal.ofReal |LinearMap.det ((flowDeriv3 s : E6 →L[ℝ] E6) : E6 →ₗ[ℝ] E6)|
      = ∫⁻ s in flowParamSet N G Gi r word3 z ∩ ndSet3,
        ENNReal.ofReal |LinearMap.det ((flowDeriv3 s : E6 →L[ℝ] E6) : E6 →ₗ[ℝ] E6)| := by
  have hmd : MeasurableSet (flowParamSet N G Gi r word3 z \ ndSet3) :=
    (measurableSet_flowParamSet N hGm hGim r word3 z).diff measurableSet_ndSet3
  have hle : ∫⁻ s in flowParamSet N G Gi r word3 z \ ndSet3,
      ENNReal.ofReal |LinearMap.det ((flowDeriv3 s : E6 →L[ℝ] E6) : E6 →ₗ[ℝ] E6)|
        ≤ ∫⁻ _s in flowParamSet N G Gi r word3 z \ ndSet3, (0 : ℝ≥0∞) :=
    setLIntegral_mono' hmd fun s hs => by
      rw [absDet_flowDeriv3_eq_zero hs.2, ENNReal.ofReal_zero]
  have hzero : ∫⁻ s in flowParamSet N G Gi r word3 z \ ndSet3,
      ENNReal.ofReal |LinearMap.det ((flowDeriv3 s : E6 →L[ℝ] E6) : E6 →ₗ[ℝ] E6)| = 0 := by
    simpa using hle
  rw [← lintegral_inter_add_sdiff _ _ measurableSet_ndSet3, hzero, add_zero]

open MeasureTheory in
/-- **Patch 1 `lem:integrated` for `w^(3)`: the terminal set is large.** This is the patch's
`|E_{j'}| >= (1/2) int_P |det D Phi|`, with the six per-step bounds on the right. -/
theorem measure_terminal_ge_word3 (N : ℝ) {G : ℕ → Set E6} {Gi : ℕ → Fin 3 → Set E6}
    (hGm : ∀ k, MeasurableSet (G k)) (hGim : ∀ k i, MeasurableSet (Gi k i))
    (hGdec : ∀ k, G (k + 1) ⊆ G k) (hGidec : ∀ k i, Gi (k + 1) i ⊆ Gi k i)
    {c₀ : ℝ≥0∞} {c : Fin 3 → ℝ≥0∞} {r : ℕ} (hr : 6 ≤ r)
    (hfwd : ∀ k, k < r → ∀ x ∈ G (k + 1), c₀ ≤ incidFwd N (Gi k) x)
    (hadj : ∀ k, k < r → ∀ i, ∀ y ∈ Gi (k + 1) i, c i ≤ incidAdj N (G k) (Gi k) i y)
    {z : E6} (hz : z ∈ cfg4 (G r) (Gi r) (word3 0))
    {a : ℕ → ℝ} (ha : ∀ l, 0 ≤ a l * N)
    (hf1 : ENNReal.ofReal (a 0 * N) ≤ volume (towA1 N G Gi r word3 z))
    (hf2 : ∀ x ∈ towA1 N G Gi r word3 z,
      ENNReal.ofReal (a 1 * N) ≤ volume (towA2 N G Gi r word3 z x))
    (hf3 : ∀ x ∈ towA1 N G Gi r word3 z, ∀ y ∈ towA2 N G Gi r word3 z x,
      ENNReal.ofReal (a 2 * N) ≤ volume (towA3 N G Gi r word3 z x y))
    (hf4 : ∀ x ∈ towA1 N G Gi r word3 z, ∀ y ∈ towA2 N G Gi r word3 z x,
      ∀ u ∈ towA3 N G Gi r word3 z x y,
      ENNReal.ofReal (a 3 * N) ≤ volume (towA4 N G Gi r word3 z x y u))
    (hf5 : ∀ x ∈ towA1 N G Gi r word3 z, ∀ y ∈ towA2 N G Gi r word3 z x,
      ∀ u ∈ towA3 N G Gi r word3 z x y, ∀ v ∈ towA4 N G Gi r word3 z x y u,
      ENNReal.ofReal (a 4 * N) ≤ volume (towA5 N G Gi r word3 z x y u v))
    (hf6 : ∀ x ∈ towA1 N G Gi r word3 z, ∀ y ∈ towA2 N G Gi r word3 z x,
      ∀ u ∈ towA3 N G Gi r word3 z x y, ∀ v ∈ towA4 N G Gi r word3 z x y u,
      ∀ t ∈ towA5 N G Gi r word3 z x y u v,
      ENNReal.ofReal (a 5 * N) ≤ volume (towA6 N G Gi r word3 z x y u v t)) :
    ENNReal.ofReal (2⁻¹ * (a 0 * N)) * ENNReal.ofReal (2⁻¹ * (a 1 * N))
        * ENNReal.ofReal (2⁻¹ * (8 : ℝ)⁻¹ * (a 2 * N) ^ 2)
        * ENNReal.ofReal (2⁻¹ * (a 3 * N))
        * ENNReal.ofReal (2⁻¹ * (8 : ℝ)⁻¹ * (a 4 * N) ^ 2)
        * ENNReal.ofReal (2⁻¹ * ((8 : ℝ)⁻¹) ^ 2 * (a 5 * N) ^ 3)
      ≤ 2 * volume (cfg4 (G 0) (Gi 0) (word3 6)) := by
  obtain ⟨-, -, -, -, harea⟩ :=
    real_flow_jacobian_word3 N hGm hGim hGdec hGidec hr hfwd hadj hz
  refine le_trans (lintegral_absDet_flowParamSet_ge N hGm hGim r z ha hf1 hf2 hf3 hf4 hf5 hf6) ?_
  rw [lintegral_absDet_eq_ndSet3 N hGm hGim r z]
  exact harea (flowParamSet N G Gi r word3 z ∩ ndSet3) Set.inter_subset_left
    ((measurableSet_flowParamSet N hGm hGim r word3 z).inter measurableSet_ndSet3)
    fun t ht => ht.2


/-! ### Patch 1 `lem:integrated` for `w^(1)`

`w^(1) = (3,0,2,0,3,0,1)` has blocks `B_3 = {0,3,4}`, `B_2 = {1,2}`, `B_1 = {5}` in the zero-based
numbering, so the moves carrying Vandermonde factors are `2` (one), `3` (one) and `4` (two), and
`(m_l + 1) = (1,1,2,2,3,1)` as `Auto.mCount_word1_values` computes. The machinery is the one used
for `w^(3)`; only the placement of the factors changes. -/
noncomputable def kg1 : ℝ → ℝ≥0∞ := fun _ => 1
noncomputable def kg2 : ℝ → ℝ → ℝ≥0∞ := fun _ _ => 1
noncomputable def kg3 : ℝ → ℝ → ℝ → ℝ≥0∞ := fun _ b c => ENNReal.ofReal |c - b|
noncomputable def kg4 : ℝ → ℝ → ℝ → ℝ → ℝ≥0∞ := fun a _ _ d => ENNReal.ofReal |d - a|
noncomputable def kg5 : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ≥0∞ :=
  fun a _ _ d e => ENNReal.ofReal |e - a| * ENNReal.ofReal |e - d|
noncomputable def kg6 : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ≥0∞ := fun _ _ _ _ _ _ => 1

/-- **The six per-move factors of `w^(1)` are dominated by its Jacobian.** -/
theorem jacWeight1_le (s : E6) :
    kg1 (s 0) * (kg2 (s 0) (s 1) * (kg3 (s 0) (s 1) (s 2) * (kg4 (s 0) (s 1) (s 2) (s 3) *
      (kg5 (s 0) (s 1) (s 2) (s 3) (s 4) * kg6 (s 0) (s 1) (s 2) (s 3) (s 4) (s 5)))))
      ≤ ENNReal.ofReal |LinearMap.det ((flowDeriv1 s : E6 →L[ℝ] E6) : E6 →ₗ[ℝ] E6)| := by
  rw [abs_det_flowDeriv1]
  simp only [kg1, kg2, kg3, kg4, kg5, kg6, one_mul, mul_one]
  rw [← ENNReal.ofReal_mul (abs_nonneg _), ← ENNReal.ofReal_mul (abs_nonneg _),
    ← ENNReal.ofReal_mul (abs_nonneg _)]
  refine ENNReal.ofReal_le_ofReal ?_
  have h1 : |s 2 - s 1| = |s 1 - s 2| := abs_sub_comm _ _
  have h2 : |s 3 - s 0| = |s 0 - s 3| := abs_sub_comm _ _
  have h3 : |s 4 - s 0| = |s 0 - s 4| := abs_sub_comm _ _
  have h4 : |s 4 - s 3| = |s 3 - s 4| := abs_sub_comm _ _
  rw [h1, h2, h3, h4]
  nlinarith [abs_nonneg (s 1 - s 2), abs_nonneg (s 0 - s 3), abs_nonneg (s 0 - s 4),
    abs_nonneg (s 3 - s 4),
    mul_nonneg (mul_nonneg (mul_nonneg (abs_nonneg (s 1 - s 2)) (abs_nonneg (s 0 - s 3)))
      (abs_nonneg (s 0 - s 4))) (abs_nonneg (s 3 - s 4))]

open MeasureTheory in
/-- **Patch 1 `lem:integrated` for `w^(1)`: the six steps composed.** -/
theorem lintegral_jacWeight1_flowTower_ge (N : ℝ) {G : ℕ → Set E6} {Gi : ℕ → Fin 3 → Set E6}
    (hGm : ∀ k, MeasurableSet (G k)) (hGim : ∀ k i, MeasurableSet (Gi k i)) (r : ℕ) (z : E6)
    {a : ℕ → ℝ} (ha : ∀ l, 0 ≤ a l * N)
    (hf1 : ENNReal.ofReal (a 0 * N) ≤ volume (towA1 N G Gi r word1 z))
    (hf2 : ∀ x ∈ towA1 N G Gi r word1 z,
      ENNReal.ofReal (a 1 * N) ≤ volume (towA2 N G Gi r word1 z x))
    (hf3 : ∀ x ∈ towA1 N G Gi r word1 z, ∀ y ∈ towA2 N G Gi r word1 z x,
      ENNReal.ofReal (a 2 * N) ≤ volume (towA3 N G Gi r word1 z x y))
    (hf4 : ∀ x ∈ towA1 N G Gi r word1 z, ∀ y ∈ towA2 N G Gi r word1 z x,
      ∀ u ∈ towA3 N G Gi r word1 z x y,
      ENNReal.ofReal (a 3 * N) ≤ volume (towA4 N G Gi r word1 z x y u))
    (hf5 : ∀ x ∈ towA1 N G Gi r word1 z, ∀ y ∈ towA2 N G Gi r word1 z x,
      ∀ u ∈ towA3 N G Gi r word1 z x y, ∀ v ∈ towA4 N G Gi r word1 z x y u,
      ENNReal.ofReal (a 4 * N) ≤ volume (towA5 N G Gi r word1 z x y u v))
    (hf6 : ∀ x ∈ towA1 N G Gi r word1 z, ∀ y ∈ towA2 N G Gi r word1 z x,
      ∀ u ∈ towA3 N G Gi r word1 z x y, ∀ v ∈ towA4 N G Gi r word1 z x y u,
      ∀ t ∈ towA5 N G Gi r word1 z x y u v,
      ENNReal.ofReal (a 5 * N) ≤ volume (towA6 N G Gi r word1 z x y u v t)) :
    ENNReal.ofReal (2⁻¹ * (a 0 * N)) * ENNReal.ofReal (2⁻¹ * (a 1 * N))
        * ENNReal.ofReal (2⁻¹ * (8 : ℝ)⁻¹ * (a 2 * N) ^ 2)
        * ENNReal.ofReal (2⁻¹ * (8 : ℝ)⁻¹ * (a 3 * N) ^ 2)
        * ENNReal.ofReal (2⁻¹ * ((8 : ℝ)⁻¹) ^ 2 * (a 4 * N) ^ 3)
        * ENNReal.ofReal (2⁻¹ * (a 5 * N))
      ≤ ∫⁻ p in flowTower N G Gi r word1 z,
        kg1 p.1 * (kg2 p.1 p.2.1 * (kg3 p.1 p.2.1 p.2.2.1 *
          (kg4 p.1 p.2.1 p.2.2.1 p.2.2.2.1 * (kg5 p.1 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2.1 *
            kg6 p.1 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2.1 p.2.2.2.2.2)))) := by
  obtain ⟨hA1, hA2, hA3, hA4, hA5, hA6⟩ := measurableSet_towA N hGm hGim r word1 z
  have h1 : ENNReal.ofReal (2⁻¹ * (a 0 * N))
      ≤ ∫⁻ x in towA1 N G Gi r word1 z, kg1 x := by
    have h := lintegral_prod_dist_ge hA1 hf1 (m := 0) (by norm_num) ![] (ha 0)
    simpa [kg1] using h
  have h2 : ∀ x ∈ towA1 N G Gi r word1 z, ENNReal.ofReal (2⁻¹ * (a 1 * N))
      ≤ ∫⁻ y in towA2 N G Gi r word1 z x, kg2 x y := by
    intro x hx
    have h := lintegral_prod_dist_ge (hA2 x) (hf2 x hx) (m := 0) (by norm_num) ![] (ha 1)
    simpa [kg2] using h
  have h3 : ∀ x ∈ towA1 N G Gi r word1 z, ∀ y ∈ towA2 N G Gi r word1 z x,
      ENNReal.ofReal (2⁻¹ * (8 : ℝ)⁻¹ * (a 2 * N) ^ 2)
        ≤ ∫⁻ c in towA3 N G Gi r word1 z x y, kg3 x y c := by
    intro x hx y hy
    have h := lintegral_prod_dist_ge (hA3 x y) (hf3 x hx y hy) (m := 1) (by norm_num) ![y] (ha 2)
    simpa [kg3, Fin.prod_univ_one] using h
  have h4 : ∀ x ∈ towA1 N G Gi r word1 z, ∀ y ∈ towA2 N G Gi r word1 z x,
      ∀ c ∈ towA3 N G Gi r word1 z x y,
      ENNReal.ofReal (2⁻¹ * (8 : ℝ)⁻¹ * (a 3 * N) ^ 2)
        ≤ ∫⁻ d in towA4 N G Gi r word1 z x y c, kg4 x y c d := by
    intro x hx y hy c hc
    have h := lintegral_prod_dist_ge (hA4 x y c) (hf4 x hx y hy c hc)
      (m := 1) (by norm_num) ![x] (ha 3)
    simpa [kg4, Fin.prod_univ_one] using h
  have h5 : ∀ x ∈ towA1 N G Gi r word1 z, ∀ y ∈ towA2 N G Gi r word1 z x,
      ∀ c ∈ towA3 N G Gi r word1 z x y, ∀ d ∈ towA4 N G Gi r word1 z x y c,
      ENNReal.ofReal (2⁻¹ * ((8 : ℝ)⁻¹) ^ 2 * (a 4 * N) ^ 3)
        ≤ ∫⁻ e in towA5 N G Gi r word1 z x y c d, kg5 x y c d e := by
    intro x hx y hy c hc d hd
    have h := lintegral_prod_dist_ge (hA5 x y c d) (hf5 x hx y hy c hc d hd)
      (m := 2) le_rfl ![x, d] (ha 4)
    simpa [kg5, Fin.prod_univ_two] using h
  have h6 : ∀ x ∈ towA1 N G Gi r word1 z, ∀ y ∈ towA2 N G Gi r word1 z x,
      ∀ c ∈ towA3 N G Gi r word1 z x y, ∀ d ∈ towA4 N G Gi r word1 z x y c,
      ∀ e ∈ towA5 N G Gi r word1 z x y c d, ENNReal.ofReal (2⁻¹ * (a 5 * N))
        ≤ ∫⁻ f in towA6 N G Gi r word1 z x y c d e, kg6 x y c d e f := by
    intro x hx y hy c hc d hd e he
    have h := lintegral_prod_dist_ge (hA6 x y c d e) (hf6 x hx y hy c hc d hd e he)
      (m := 0) (by norm_num)
      ![] (ha 5)
    simpa [kg6] using h
  exact lintegral_tower6_ge ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top
    ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top hA1 hA2 hA3 hA4 hA5
    (fun x y c d => measurableSet_towerCons5 N hGm hGim r word1 z x y c d)
    (fun x y c => measurableSet_towerCons4 N hGm hGim r word1 z x y c)
    (fun x y => measurableSet_towerCons3 N hGm hGim r word1 z x y)
    (fun x => measurableSet_towerCons2 N hGm hGim r word1 z x)
    (measurableSet_flowTower N hGm hGim r word1 z)
    (fun x y c d => by simp only [kg5, kg6]; fun_prop)
    (fun x y c => by simp only [kg4, kg5, kg6]; fun_prop)
    (fun x y => by simp only [kg3, kg4, kg5, kg6]; fun_prop)
    (fun x => by simp only [kg2, kg3, kg4, kg5, kg6]; fun_prop)
    (by simp only [kg1, kg2, kg3, kg4, kg5, kg6]; fun_prop)
    h1 h2 h3 h4 h5 h6


