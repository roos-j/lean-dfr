/-- **Corollary `patch:structured-degree` (unconditional degree lowering for structured adjoints).**
For an increasing degree list, the `l`-th adjoint `F_l` of the modulated average with active inputs
`1, …, l` and the fixed phase `e(Σ_{i>l} η_i P_i(t))` (here `cdlF` with `m = l`; the variable
frequencies `ξ` do not occur) satisfies: a power-large order-`(r+2)` power of its sections in the
direction `e_l` at `H ≍ N^{d_l}` gives a power-large order-`(r+1)` power at the same `H`. The
passive coordinates are the transverse coordinates of the sections; `MA(l, l)` is
`Auto.majorArc`. -/
theorem structuredDegree {k : ℕ} {j : ℕ → Fin 3}
    (hjm : ∀ u v, 1 ≤ u → u < v → v ≤ k → expo (j u) < expo (j v)) {l : ℕ} (hl : 1 ≤ l)
    (hlk : l ≤ k) {r : ℕ} (hr : 1 ≤ r) {c : ℕ} (hc : 1 ≤ c) :
    ∃ C : ℕ, 1 ≤ C ∧ ∀ δ N : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ N →
      ∀ (P : ℕ → Polynomial ℝ) (f : ℕ → E3 → ℂ) (ξ : ℕ → E3 → ℝ) (η : ℕ → ℝ) (H : ℝ),
        (∀ i ∈ Finset.Icc 1 k, AdmissiblePoly c δ N (expo (j i)) (P i)) →
        (∀ i, Measurable (f i)) → (∀ i x, ‖f i x‖ ≤ 1) →
        (∀ i x, x ∉ petBox (budHi c δ) N → f i x = 0) → (∀ i, Measurable (ξ i)) →
        budLo c δ * N ^ expo (j l) ≤ H → H ≤ budHi c δ * N ^ expo (j l) →
        budLo c δ * N ^ (6 - expo (j l)) ≤ ∫ y, unifPow1 H (10 * budHi c δ * N ^ expo (j l))
          (r + 2) (fun z => cdlF N l f P (maPhase (l + 1) l k ξ η P) j (embT (j l) y z)) →
        budLo C δ * N ^ (6 - expo (j l)) ≤ ∫ y, unifPow1 H (10 * budHi c δ * N ^ expo (j l))
          (r + 1) (fun z => cdlF N l f P (maPhase (l + 1) l k ξ η P) j (embT (j l) y z)) :=
  conditionalDegreeLowering hl le_rfl hlk (majorArc hjm hl hlk l hl le_rfl) hr hc

/-- **`patch:structured-degree`, the form used in `patch:remove-high-inputs`**: for an increasing
degree list, a power-large correlation `Γ_l` with the fixed higher phase `e(Σ_{i>l} θ_i P_i(t))`
gives power-large directional `U²` powers of the sections of the exact adjoint `F_l`, at a radius
`H = u_{C₁}(δ) N^{d_l}` and section length `S = 10 u_{c'}(δ) N^{d_l}`
(`patch:highest-control`, then `patch:structured-degree` a bounded number of times). -/
theorem structured_uniformity {k : ℕ} {j : ℕ → Fin 3}
    (hjm : ∀ u v, 1 ≤ u → u < v → v ≤ k → expo (j u) < expo (j v)) {l : ℕ} (hl : 1 ≤ l)
    (hlk : l ≤ k) {c : ℕ} (hc : 1 ≤ c) :
    ∃ C₁ c' C : ℕ, 1 ≤ C₁ ∧ c ≤ c' ∧ 1 ≤ C ∧ ∀ δ N : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ N →
      ∀ (P : ℕ → Polynomial ℝ) (g : ℕ → E3 → ℂ) (ζ : ℕ → E3 → ℝ) (θ : ℕ → ℝ),
        (∀ i ∈ Finset.Icc 1 k, AdmissiblePoly c δ N (expo (j i)) (P i)) →
        (∀ i, Measurable (g i)) → (∀ i y, ‖g i y‖ ≤ 1) →
        (∀ i y, y ∉ petBox (budHi c δ) N → g i y = 0) → (∀ i, Measurable (ζ i)) →
        budLo c δ * N ^ (6 : ℕ) ≤ ‖phaseCorr N l g P (maPhase (l + 1) l k ζ θ P) j‖ →
        budLo C δ * N ^ (6 - expo (j l)) ≤ ∫ y, unifPow1 (budHi C₁ δ * N ^ expo (j l))
          (10 * budHi c' δ * N ^ expo (j l)) 2
          (fun z => maAdj N l l k g P ζ θ j (embT (j l) y z)) :=
  ma_uniformity hl le_rfl hlk
    (fun i hi hil => by
      rw [Finset.mem_Icc] at hi
      exact hjm i l hi.1 (lt_of_le_of_ne hi.2 hil) hlk)
    (majorArc hjm hl hlk l hl le_rfl) hc

end

