  rw [hint_eq, Complex.norm_real, Real.norm_of_nonneg (integral_nonneg fun y => norm_nonneg _)]
    at key
  have hlow : ∀ y, Y.indicator (fun _ => H * Real.sqrt η / 2) y ≤ ‖B y‖ := fun y => by
    by_cases hy : y ∈ Y
    · rw [Set.indicator_of_mem hy, hBY y hy]; exact (hYB y hy).le
    · rw [Set.indicator_of_notMem hy]; exact norm_nonneg _
  have hindY : Integrable (Y.indicator fun _ => H * Real.sqrt η / 2) :=
    (Measure.integrableOn_of_bounded (M := H * Real.sqrt η / 2) hYfin
      measurable_const.aestronglyMeasurable
      (Eventually.of_forall fun _ => by
        rw [Real.norm_of_nonneg (by positivity)])).integrable_indicator hY
  have h1 := integral_mono hindY hBi hlow
  rw [integral_indicator_const _ hY, smul_eq_mul, measureReal_def] at h1
  have hsp : budLo cM δ * N ^ (6 : ℕ) ≤ ‖phaseCorr N (l - 1) (spIn g w lam (j l)) P
      (maPhase l l k (spFreq ζ lam l (j l)) θ P) j‖ := by
    rw [← key]
    have h2 : b * N ^ (6 - d) / 2 * (N ^ d * Real.sqrt η / 2)
        ≤ (volume Y).toReal * (H * Real.sqrt η / 2) :=
      mul_le_mul hvolY (by gcongr) (by positivity) ENNReal.toReal_nonneg
    have h3 : b * N ^ (6 - d) / 2 * (N ^ d * Real.sqrt η / 2)
        = b * Real.sqrt (b / (200 * u ^ 2)) / 4 * N ^ (6 : ℕ) := by
      rw [← pow_add_sub_six N hd6, hηdef]; ring
    have h4 := (budLo_antitone hδ0 hδ1 hcA (le_max_left _ _ : cA ≤ cM)).trans (hcAb δ hδ0 hδ1)
    calc budLo cM δ * N ^ (6 : ℕ)
        ≤ b * Real.sqrt (b / (200 * u ^ 2)) / 4 * N ^ (6 : ℕ) :=
          mul_le_mul_of_nonneg_right h4 (by positivity)
      _ ≤ ∫ y, ‖B y‖ := by rw [← h3]; exact h2.trans h1
  -- `MA(l, l)` on the smaller pattern
  have hbox : petBox (budHi c δ) N ⊆ petBox (budHi cM δ) N :=
    petBox_mono (budHi_monotone hδ0 hδ1 hc hccM) hN0.le
  have hvol := hMA' δ N hδ0 hδ1 hN P (spIn g w lam (j l)) (spFreq ζ lam l (j l)) θ
    (fun i hi => (hadm i hi).mono hδ0 hδ1 hc hccM hN0.le)
    (measurable_spIn hg hwm hlamm (j l)) (norm_spIn_le hg1 hw1 lam (j l))
    (fun i x hx => spIn_eq_zero hgs w lam (j l) i fun h => hx (hbox h))
    (measurable_spFreq hζ hlamm l (j l)) hsp
  -- every point of the canonical set lies over a selected section with a small frequency
  set u' := budHi C' δ with hu'def
  have hu'0 : 0 < u' := budHi_pos hδ0 hC'
  set Y' := Y ∩ {y | N ^ d * |ξ y| ≤ u'} with hY'def
  have hY' : MeasurableSet Y' :=
    hY.inter (measurableSet_le (measurable_const.mul (continuous_abs.measurable.comp hξm))
      measurable_const)
  set R := u' * N ^ d with hRdef
  have hsub : maSet l l k j C' δ N (spFreq ζ lam l (j l)) θ
      ⊆ {x : E3 | x (j l) ∈ Set.Icc (-R) R ∧ projT (j l) x ∈ Y'} := by
    intro x hx
    obtain ⟨hxb, hxs⟩ := hx
    rw [maSize_self_eq] at hxs
    have htail : 0 ≤ ∑ i ∈ Finset.Icc (l + 1) k, N ^ expo (j i) * |θ i| :=
      Finset.sum_nonneg fun i _ => by positivity
    have hlx : N ^ d * |lam (projT (j l) x)| ≤ u' := by
      have : spFreq ζ lam l (j l) l x = lam (projT (j l) x) := by simp [spFreq]
      rw [this] at hxs; linarith
    have hyY : projT (j l) x ∈ Y := by
      by_contra hn
      simp only [hlamdef, ite_eq_right hn, hΛdef] at hlx
      rw [abs_of_pos (by positivity), mul_div_cancel₀ _ hNd.ne'] at hlx
      linarith
    simp only [hlamdef, ite_eq_left hyY, abs_neg] at hlx
    exact ⟨hxb (j l), hyY, hlx⟩
  have hcyl := volume_cyl (j l) (measurableSet_Icc (a := -R) (b := R)) hY'
  have hY'fin : volume Y' ≠ ⊤ := ne_top_of_le_ne_top hYfin (measure_mono Set.inter_subset_left)
  have hvol' : budLo C' δ * N ^ (6 : ℕ) ≤ 2 * R * (volume Y').toReal := by
    refine hvol.trans ?_
    have hm := ENNReal.toReal_mono (by rw [hcyl]; exact ENNReal.mul_ne_top (by simp) hY'fin)
      (measure_mono hsub)
    have hR0 : 0 ≤ R := (mul_pos hu'0 hNd).le
    rw [hcyl, ENNReal.toReal_mul, Real.volume_Icc, ENNReal.toReal_ofReal (by linarith)] at hm
    refine hm.trans (le_of_eq ?_)
    ring
  refine ⟨ξ, hξm, Y', hY', Set.inter_subset_left.trans hYA, ?_, fun y hy => ⟨?_, ?_⟩⟩
  · have hCa' := (budLo_antitone hδ0 hδ1 hCa
      (le_trans (le_max_left _ _) (le_max_right _ _) : Ca ≤ C)).trans (hCab δ hδ0 hδ1)
    have hR : 2 * R = 2 * u' * N ^ d := by rw [hRdef]; ring
    rw [hR, ← pow_add_sub_six N hd6] at hvol'
    have hk : budLo C' δ / (2 * u') * N ^ (6 - d) ≤ (volume Y').toReal := by
      rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
      nlinarith [hvol']
    exact le_trans (mul_le_mul_of_nonneg_right hCa' hNd6.le) hk
  · exact hy.2.trans (budHi_monotone hδ0 hδ1 hC' (le_max_left _ _))
  · have hCb' := (budLo_antitone hδ0 hδ1 hCb
      (le_trans (le_max_right _ _) (le_max_right _ _) : Cb ≤ C)).trans (hCbb δ hδ0 hδ1)
    refine lt_of_le_of_lt ?_ (hYB y hy.1)
    calc budLo C δ * N ^ d ≤ Real.sqrt η / 2 * N ^ d :=
          mul_le_mul_of_nonneg_right hCb' hNd.le
      _ ≤ H * Real.sqrt η / 2 := by nlinarith

end

/-! ### `patch:remove-high-inputs`: the constant frequency and the backward step -/

section
open Filter Topology MeasureTheory

/-- With a constant frequency `λ₀` the smaller pattern's phase is the fixed phase of `Γ_{l-1}` with
`ζ_l = λ₀`. -/
theorem maPhase_spFreq_const {l k : ℕ} (hl : 1 ≤ l) (hlk : l ≤ k) (ζ : ℕ → E3 → ℝ) (lam0 : ℝ)
    (jm : Fin 3) (θ : ℕ → ℝ) (P : ℕ → Polynomial ℝ) (ζ' : ℕ → E3 → ℝ) :
    maPhase l l k (spFreq ζ (fun _ => lam0) l jm) θ P
      = maPhase l (l - 1) k ζ' (Function.update θ l lam0) P := by
  funext x
  have hl' : l - 1 + 1 = l := by omega
  have hI : Finset.Icc l (l - 1) = ∅ := Finset.Icc_eq_empty (by omega)
  have hJ : Finset.Icc l k = insert l (Finset.Icc (l + 1) k) := by
    ext i; simp only [Finset.mem_Icc, Finset.mem_insert]; omega
  simp only [maPhase, Finset.Icc_self, Finset.sum_singleton, hl', hI, Finset.sum_empty, zero_add,
    spFreq, ite_true]
  rw [hJ, Finset.sum_insert (by simp), Function.update_self]
  congr 1
  refine Finset.sum_congr rfl fun i hi => ?_
  simp only [Finset.mem_Icc] at hi
  rw [Function.update_of_ne (by omega)]

theorem spIn_eq_update (g : ℕ → E3 → ℂ) (w : (Fin 2 → ℝ) → ℂ) (lam : (Fin 2 → ℝ) → ℝ)
    (jm : Fin 3) : spIn g w lam jm = Function.update g 0 (spIn g w lam jm 0) := by
  funext i x
  by_cases hi : i = 0
  · subst hi; rw [Function.update_self]
  · rw [Function.update_of_ne hi]; simp [spIn, hi]

set_option maxHeartbeats 2000000 in
-- The cell selection, the phase removal and the budgets share one context.
open scoped Classical in
/-- **`patch:remove-high-inputs`, the constant frequency and the backward step.** For an increasing
degree list and `2 ≤ l ≤ k`, a power-large `Γ_l(g_0; g_1, …, g_l; θ_{>l})` gives a measurable
`g'_0` with `|g'_0| ≤ |g_0|` and a frequency vector `θ'` agreeing with `θ` above `l` such that
`Γ_{l-1}(g'_0; g_1, …, g_{l-1}; θ'_{≥l})` is power-large, the lower inputs being unchanged. The
small selected frequencies are frozen to one centre `λ₀` of a heavy cell of width `τ N^{-d_l}`, and
the phase-removed coefficient integral is the smaller pattern with `ζ_l = λ₀`. -/
theorem removeHigh_step {k : ℕ} {j : ℕ → Fin 3}
    (hjm : ∀ u v, 1 ≤ u → u < v → v ≤ k → expo (j u) < expo (j v)) {l : ℕ} (hl : 2 ≤ l)
    (hlk : l ≤ k) {c : ℕ} (hc : 1 ≤ c) :
    ∃ C : ℕ, 1 ≤ C ∧ ∀ δ N : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ N →
      ∀ (P : ℕ → Polynomial ℝ) (g : ℕ → E3 → ℂ) (ζ : ℕ → E3 → ℝ) (θ : ℕ → ℝ),
        (∀ i ∈ Finset.Icc 1 k, AdmissiblePoly c δ N (expo (j i)) (P i)) →
        (∀ i, Measurable (g i)) → (∀ i y, ‖g i y‖ ≤ 1) →
        (∀ i y, y ∉ petBox (budHi c δ) N → g i y = 0) → (∀ i, Measurable (ζ i)) →
        budLo c δ * N ^ (6 : ℕ) ≤ ‖phaseCorr N l g P (maPhase (l + 1) l k ζ θ P) j‖ →
        ∃ (g₀ : E3 → ℂ) (θ' : ℕ → ℝ), Measurable g₀ ∧ (∀ x, ‖g₀ x‖ ≤ ‖g 0 x‖) ∧
          (∀ i, l < i → θ' i = θ i) ∧ budLo C δ * N ^ (6 : ℕ)
            ≤ ‖phaseCorr N (l - 1) (Function.update g 0 g₀) P
                (maPhase l (l - 1) k ζ θ' P) j‖ := by
  have hl1 : 1 ≤ l := by omega
  obtain ⟨C0, hC0, hsmall⟩ := removeHigh_small hjm hl1 hlk hc
  have hLo0 : MonoLow (budLo C0) := monoLow_budLo hC0
  have hHi0 : MonoHigh (budHi C0) := monoHigh_budHi hC0
  have hHic : MonoHigh (budHi c) := monoHigh_budHi hc
  -- the number of cells is power-bounded
  have hq : MonoHigh fun δ => 200 * Real.pi * budHi c δ ^ 2 * budHi C0 δ / budLo C0 δ + 2 :=
    (((((monoHigh_const (by positivity : (0 : ℝ) < 200 * Real.pi)).mul (hHic.pow 2)).mul
      hHi0).div hLo0).add_const (c := 2) (by norm_num)).mono (fun δ _ _ => le_of_eq (by ring))
      (fun δ h0 h1 => by
        have := budHi_pos h0 hc; have := budHi_pos h0 hC0; have := budLo_pos h0 hC0
        positivity)
  have hF : MonoLow fun δ => budLo C0 δ / (200 * Real.pi * budHi c δ ^ 2 * budHi C0 δ
      / budLo C0 δ + 2) * (budLo C0 δ / 2) := (hLo0.div hq).mul (hLo0.div_const two_pos)
  obtain ⟨C, hC, hCb⟩ := hF.exists_budLo
  refine ⟨C, hC, ?_⟩
  intro δ N hδ0 hδ1 hN P g ζ θ hadm hg hg1 hgs hζ hcorr
  have hN0 : 0 < N := by linarith
  set u := budHi c δ with hudef
  have hu1 : 1 ≤ u := one_le_budHi hδ0 hδ1 hc
  have hu0 : 0 < u := by linarith
  obtain ⟨hFm, hF1, hFs, -, -⟩ := ma_adjoint hN hδ0 hc hl1 le_rfl hlk hg hg1 hgs hadm hζ θ
  obtain ⟨ξ, hξm, Y, hY, hYA, hvolY, hYB⟩ :=
    hsmall δ N hδ0 hδ1 hN P g ζ θ hadm hg hg1 hgs hζ hcorr
  set F := maAdj N l l k g P ζ θ j with hFdef
  set d := expo (j l) with hddef
  have hd6 : d ≤ 6 := by have : d ≤ 3 := Nat.succ_le_of_lt (Fin.is_lt _); omega
  have hNd : 0 < N ^ d := pow_pos hN0 _
  have hNd6 : 0 < N ^ (6 - d) := pow_pos hN0 _
  set b := budLo C0 δ with hbdef
  have hb0 : 0 < b := budLo_pos hδ0 hC0
  set v := budHi C0 δ with hvdef
  have hv0 : 0 < v := budHi_pos hδ0 hC0
  -- the sections
  set S := 10 * u * N ^ d with hSdef
  have hS : 0 < S := by positivity
  set Fy : (Fin 2 → ℝ) → ℝ → ℂ := fun y z => F (embT (j l) y z) with hFydef
  have hFym : Measurable (Function.uncurry Fy) := by
    have h := hFm.comp (measurable_embT (j l))
    exact h
  have hFyy : ∀ y, Measurable (Fy y) := fun y => by
    have h := hFym.comp (measurable_prodMk_left (x := y))
    exact h
  have hFy1 : ∀ y z, ‖Fy y z‖ ≤ 1 := fun y z => hF1 _
  have hFys : ∀ y z, z ∉ Set.Icc (-(5 * u * N ^ d)) (-(5 * u * N ^ d) + S) → Fy y z = 0 := by
    intro y z hz
    by_contra h
    obtain ⟨_, h1, h2⟩ := mem_of_embT_ne_zero hFs (j l) h
    exact hz ⟨h1, by rw [hSdef]; linarith⟩
  set A := transBox (j l) (5 * u) N with hAdef
  have hAfin : volume A ≠ ⊤ := (volume_transBox_lt_top _ _ _).ne
  have hFyA : ∀ y, y ∉ A → ∀ z, Fy y z = 0 := fun y hy z => by
    by_contra h
    exact hy (mem_of_embT_ne_zero hFs (j l) h).1
  -- the heavy cell
  set Δ := b / (100 * Real.pi * u ^ 2 * N ^ d) with hΔdef
  have hΔ : 0 < Δ := by positivity
  set ψ : (Fin 2 → ℝ) → ℝ := fun y => -ξ y with hψdef
  have hψm : Measurable ψ := hξm.neg
  have : IsFiniteMeasure (volume.restrict A) := isFiniteMeasure_restrict.mpr hAfin
  obtain ⟨lam0, W, hW, hWY, hWψ, hWvol⟩ := exists_heavy_cell (μ := volume.restrict A) hY hψm
    (B := v / N ^ d) hΔ (fun y hy => by
      rw [hψdef, abs_neg, le_div_iff₀ hNd, mul_comm]; exact (hYB y hy).1)
  rw [Measure.restrict_apply hY, Set.inter_eq_left.mpr hYA, Measure.restrict_apply hW,
    Set.inter_eq_left.mpr (hWY.trans hYA)] at hWvol
  have hq2 : ((⌈2 * (v / N ^ d) / Δ⌉₊ + 1 : ℕ) : ℝ)
      ≤ 200 * Real.pi * u ^ 2 * v / b + 2 := by
    have h1 : 2 * (v / N ^ d) / Δ = 200 * Real.pi * u ^ 2 * v / b := by
      rw [hΔdef]; field_simp; ring
    push_cast
    rw [h1]
    have := Nat.ceil_lt_add_one (by positivity : (0 : ℝ) ≤ 200 * Real.pi * u ^ 2 * v / b)
    linarith
  have hqpos : (0 : ℝ) < ((⌈2 * (v / N ^ d) / Δ⌉₊ + 1 : ℕ) : ℝ) := by positivity
  have hWvol' : b / (200 * Real.pi * u ^ 2 * v / b + 2) * N ^ (6 - d) ≤ (volume W).toReal := by
    refine le_trans ?_ hWvol
    rw [div_mul_eq_mul_div, le_div_iff₀ hqpos]
    calc b * N ^ (6 - d) / (200 * Real.pi * u ^ 2 * v / b + 2)
          * ((⌈2 * (v / N ^ d) / Δ⌉₊ + 1 : ℕ) : ℝ)
        ≤ b * N ^ (6 - d) / (200 * Real.pi * u ^ 2 * v / b + 2)
          * (200 * Real.pi * u ^ 2 * v / b + 2) := by gcongr
      _ = b * N ^ (6 - d) := by field_simp
      _ ≤ (volume Y).toReal := hvolY
  -- the coefficient at the centre is still power-large on the cell
  have hcoef : ∀ y φ, ∫ z, Fy y z * ephase (φ * z) = (S : ℂ) * cdlCoef S (Fy y) φ := by
    intro y φ
    rw [cdlCoef, ← mul_assoc, mul_inv_cancel₀ (by exact_mod_cast hS.ne'), one_mul]
  have hZ : Set.Icc (-(5 * u * N ^ d)) (-(5 * u * N ^ d) + S)
      ⊆ Set.Icc (-(5 * u * N ^ d)) (5 * u * N ^ d) :=
    Set.Icc_subset_Icc le_rfl (by rw [hSdef]; linarith)
  set B0 : (Fin 2 → ℝ) → ℂ := fun y => ∫ z, Fy y z * ephase (lam0 * z) with hB0def
  have hWB : ∀ y ∈ W, b * N ^ d / 2 ≤ ‖B0 y‖ := by
    intro y hy
    have hyY := hWY hy
    have h1 : b * N ^ d < ‖(S : ℂ) * cdlCoef S (Fy y) (ψ y)‖ := by
      rw [← hcoef]; exact (hYB y hyY).2
    have h2 := norm_cdlCoef_sub_le hS (hFyy y) (hFy1 y) (hFys y) hZ (ψ y) lam0
    have h3 := hWψ y hy
    rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg hS.le] at h1
    have h4 : ‖B0 y‖ = S * ‖cdlCoef S (Fy y) lam0‖ := by
      rw [hB0def]; simp only; rw [hcoef, norm_mul, Complex.norm_real, Real.norm_of_nonneg hS.le]
    have h5 : ‖cdlCoef S (Fy y) (ψ y)‖ - ‖cdlCoef S (Fy y) lam0‖
        ≤ ‖cdlCoef S (Fy y) (ψ y) - cdlCoef S (Fy y) lam0‖ := norm_sub_norm_le _ _
    have h6 : S * (2 * Real.pi * (5 * u * N ^ d) * (Δ / 2)) = b * N ^ d / 2 := by
      rw [hSdef, hΔdef]; field_simp; ring
    have h7 : S * ‖cdlCoef S (Fy y) (ψ y) - cdlCoef S (Fy y) lam0‖
        ≤ S * (2 * Real.pi * (5 * u * N ^ d) * (Δ / 2)) := by
      refine mul_le_mul_of_nonneg_left (h2.trans ?_) hS.le
      exact mul_le_mul_of_nonneg_left h3 (by positivity)
    rw [h4]
    nlinarith
  have hB0m : Measurable B0 := by
    have hjm' : Measurable fun q : (Fin 2 → ℝ) × ℝ => Fy q.1 q.2 * ephase (lam0 * q.2) :=
      hFym.mul (continuous_ephase.measurable.comp (measurable_const.mul measurable_snd))
    have h := (hjm'.stronglyMeasurable.integral_prod_right' (ν := (volume : Measure ℝ))).measurable
    exact h
  have hB0b : ∀ y, ‖B0 y‖ ≤ S := fun y => by
    rw [hB0def]; simp only; rw [hcoef, norm_mul, Complex.norm_real, Real.norm_of_nonneg hS.le]
    exact mul_le_of_le_one_right hS.le (norm_cdlCoef_le hS (hFy1 y) (hFys y) lam0)
  -- the dualizing scalar, zero off the cell
  set w : (Fin 2 → ℝ) → ℂ := fun y => if y ∈ W then unitScalar (B0 y) else 0 with hwdef
  have hwm : Measurable w := Measurable.ite hW (measurable_unitScalar.comp hB0m) measurable_const
  have hw1 : ∀ y, ‖w y‖ ≤ 1 := fun y => by
    rw [hwdef]; simp only
    split_ifs
    · exact norm_unitScalar_le _
    · simp
  have hWfin : volume W ≠ ⊤ :=
    ne_top_of_le_ne_top hAfin (measure_mono (hWY.trans hYA))
  have hWi : Integrable (W.indicator fun y => ‖B0 y‖) :=
    (Measure.integrableOn_of_bounded (M := S) hWfin hB0m.norm.aestronglyMeasurable
      (Eventually.of_forall fun y => by rw [norm_norm]; exact hB0b y)).integrable_indicator hW
  have key := norm_sections_eq_sp hN hδ0 hc hl1 le_rfl hlk hg hg1 hgs hadm hζ θ hwm hw1
    (measurable_const (a := lam0))
  have hint_eq : ∫ y, w y * ∫ z, maAdj N l l k g P ζ θ j (embT (j l) y z)
      * ephase ((fun _ => lam0) y * z) = ((∫ y, W.indicator (fun y => ‖B0 y‖) y : ℝ) : ℂ) := by
    rw [← integral_complex_ofReal]
    refine integral_congr_ae (Eventually.of_forall fun y => ?_)
    by_cases hy : y ∈ W
    · simp only [hwdef, ite_eq_left hy, Set.indicator_of_mem hy]
      exact unitScalar_mul (B0 y)
    · simp only [hwdef, ite_eq_right hy, Set.indicator_of_notMem hy, zero_mul, Complex.ofReal_zero]
  rw [hint_eq, Complex.norm_real, Real.norm_of_nonneg (integral_nonneg fun y =>
    Set.indicator_nonneg (fun y _ => norm_nonneg _) y), spIn_eq_update,
    maPhase_spFreq_const hl1 hlk ζ lam0 (j l) θ P ζ] at key
  refine ⟨spIn g w (fun _ => lam0) (j l) 0, Function.update θ l lam0,
    measurable_spIn hg hwm measurable_const (j l) 0, fun x => ?_,
    fun i hi => Function.update_of_ne (by omega) _ _, ?_⟩
  · simp only [spIn, ite_true, norm_mul, RCLike.norm_conj, norm_ephase, mul_one]
    exact mul_le_of_le_one_right (norm_nonneg _) (hw1 _)
  rw [← key]
  -- the lower bound
  have hindW : Integrable (W.indicator fun _ => b * N ^ d / 2) :=
    (Measure.integrableOn_of_bounded (M := b * N ^ d / 2) hWfin
      measurable_const.aestronglyMeasurable
      (Eventually.of_forall fun _ => by
        rw [Real.norm_of_nonneg (by positivity)])).integrable_indicator hW
  have h1 := integral_mono hindW hWi fun y => by
    by_cases hy : y ∈ W
    · rw [Set.indicator_of_mem hy, Set.indicator_of_mem hy]; exact hWB y hy
    · rw [Set.indicator_of_notMem hy, Set.indicator_of_notMem hy]
  rw [integral_indicator_const _ hW, smul_eq_mul, measureReal_def] at h1
  have h2 : b / (200 * Real.pi * u ^ 2 * v / b + 2) * N ^ (6 - d) * (b * N ^ d / 2)
      ≤ (volume W).toReal * (b * N ^ d / 2) :=
    mul_le_mul_of_nonneg_right hWvol' (by positivity)
  have h3 : b / (200 * Real.pi * u ^ 2 * v / b + 2) * N ^ (6 - d) * (b * N ^ d / 2)
      = b / (200 * Real.pi * u ^ 2 * v / b + 2) * (b / 2) * N ^ (6 : ℕ) := by
    rw [← pow_add_sub_six N hd6]; ring
  have h4 := hCb δ hδ0 hδ1
  calc budLo C δ * N ^ (6 : ℕ)
      ≤ b / (200 * Real.pi * u ^ 2 * v / b + 2) * (b / 2) * N ^ (6 : ℕ) :=
        mul_le_mul_of_nonneg_right h4 (by positivity)
    _ ≤ _ := by rw [← h3]; exact h2.trans h1

/-- **Lemma `patch:remove-high-inputs` (backward elimination of higher inputs).** For an increasing
degree list, a power-large `Γ_l(g_0; g_1, …, g_l; θ_{>l})` produces a measurable `g'_0` with
`|g'_0| ≤ |g_0|` and a frequency vector `θ'` agreeing with `θ` above `l` such that
`Γ_1(g'_0; g_1; θ'_{>1})` is power-large; the input `g_1` is the original one. Backward induction
on `l`, one application of `Auto.removeHigh_step` per step. -/
theorem removeHighInputs {k : ℕ} {j : ℕ → Fin 3}
    (hjm : ∀ u v, 1 ≤ u → u < v → v ≤ k → expo (j u) < expo (j v)) :
    ∀ l, 1 ≤ l → l ≤ k → ∀ c : ℕ, 1 ≤ c → ∃ C : ℕ, 1 ≤ C ∧ ∀ δ N : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ N →
      ∀ (P : ℕ → Polynomial ℝ) (g : ℕ → E3 → ℂ) (ζ : ℕ → E3 → ℝ) (θ : ℕ → ℝ),
        (∀ i ∈ Finset.Icc 1 k, AdmissiblePoly c δ N (expo (j i)) (P i)) →
        (∀ i, Measurable (g i)) → (∀ i y, ‖g i y‖ ≤ 1) →
        (∀ i y, y ∉ petBox (budHi c δ) N → g i y = 0) → (∀ i, Measurable (ζ i)) →
        budLo c δ * N ^ (6 : ℕ) ≤ ‖phaseCorr N l g P (maPhase (l + 1) l k ζ θ P) j‖ →
        ∃ (g₀ : E3 → ℂ) (θ' : ℕ → ℝ), Measurable g₀ ∧ (∀ x, ‖g₀ x‖ ≤ ‖g 0 x‖) ∧
          (∀ i, l < i → θ' i = θ i) ∧ budLo C δ * N ^ (6 : ℕ)
            ≤ ‖phaseCorr N 1 (Function.update g 0 g₀) P (maPhase 2 1 k ζ θ' P) j‖ := by
  intro l hl
  induction l, hl using Nat.le_induction with
  | base =>
    intro _ c hc
    refine ⟨c, hc, fun δ N _ _ _ P g ζ θ _ hg _ _ _ hcorr => ⟨g 0, θ, hg 0, fun x => le_rfl,
      fun i _ => rfl, ?_⟩⟩
    rw [Function.update_eq_self]
    exact hcorr
  | succ l hl ih =>
    intro hlk c hc
    obtain ⟨C₁, hC₁, hstep⟩ := removeHigh_step hjm (by omega : 2 ≤ l + 1) hlk hc
    set C₂ := max C₁ c with hC₂def
    have hC₂ : 1 ≤ C₂ := le_trans hc (le_max_right _ _)
    have hcC₂ : c ≤ C₂ := le_max_right _ _
    obtain ⟨C, hC, hih⟩ := ih (by omega) C₂ hC₂
    refine ⟨C, hC, ?_⟩
    intro δ N hδ0 hδ1 hN P g ζ θ hadm hg hg1 hgs hζ hcorr
    have hN0 : 0 < N := by linarith
    obtain ⟨g₁, θ₁, hg₁m, hg₁, hθ₁, hΓ⟩ := hstep δ N hδ0 hδ1 hN P g ζ θ hadm hg hg1 hgs hζ hcorr
    rw [Nat.add_sub_cancel] at hΓ
    have hbox : petBox (budHi c δ) N ⊆ petBox (budHi C₂ δ) N :=
      petBox_mono (budHi_monotone hδ0 hδ1 hc hcC₂) hN0.le
    have hG : ∀ i, Measurable (Function.update g 0 g₁ i) := fun i => by
      by_cases hi : i = 0
      · rw [hi, Function.update_self]; exact hg₁m
      · rw [Function.update_of_ne hi]; exact hg i
    have hG1 : ∀ i y, ‖Function.update g 0 g₁ i y‖ ≤ 1 := fun i y => by
      by_cases hi : i = 0
      · rw [hi, Function.update_self]; exact (hg₁ y).trans (hg1 0 y)
      · rw [Function.update_of_ne hi]; exact hg1 i y
    have hGs : ∀ i y, y ∉ petBox (budHi C₂ δ) N → Function.update g 0 g₁ i y = 0 :=
      fun i y hy => by
        have hy' : y ∉ petBox (budHi c δ) N := fun h => hy (hbox h)
        by_cases hi : i = 0
        · rw [hi, Function.update_self]
          have := hg₁ y
          rw [hgs 0 y hy', norm_zero] at this
          exact norm_le_zero_iff.mp this
        · rw [Function.update_of_ne hi]; exact hgs i y hy'
    have hΓ' : budLo C₂ δ * N ^ (6 : ℕ)
        ≤ ‖phaseCorr N l (Function.update g 0 g₁) P (maPhase (l + 1) l k ζ θ₁ P) j‖ :=
      le_trans (mul_le_mul_of_nonneg_right (budLo_antitone hδ0 hδ1 hC₁ (le_max_left _ _))
        (by positivity)) hΓ
    obtain ⟨g₀, θ', hg₀m, hg₀, hθ', hΓ₁⟩ := hih δ N hδ0 hδ1 hN P (Function.update g 0 g₁) ζ θ₁
      (fun i hi => (hadm i hi).mono hδ0 hδ1 hc hcC₂ hN0.le) hG hG1 hGs hζ hΓ'
    refine ⟨g₀, θ', hg₀m, fun x => ?_, fun i hi => ?_, ?_⟩
    · have := hg₀ x
      rw [Function.update_self] at this
      exact this.trans (hg₁ x)
    · rw [hθ' i (by omega), hθ₁ i hi]
    · rwa [Function.update_idem] at hΓ₁

end

/-! ### `patch:lowest-energy` -/

section
open Filter Topology MeasureTheory

/-- `Γ_1` with a phase independent of `x` is the pairing of `g_0` with the modulated average
`T f_1(x) = E_t e(q(t)) f_1(x - P_1(t) e_1)`. -/
theorem phaseCorr_one_eq_avg {N : ℝ} (hN : 0 < N) (f : ℕ → E3 → ℂ) (P : ℕ → Polynomial ℝ)
    (q : Polynomial ℝ) (j : ℕ → Fin 3) :
    phaseCorr N 1 f P (fun _ => q) j = ∫ x, f 0 x * avgTranslate (unifIcc 0 N)
      (fun t => ephase (q.eval t)) (fun t => (P 1).eval t • basisVec (j 1)) (f 1) x := by
  rw [phaseCorr]
  refine integral_congr_ae (Eventually.of_forall fun x => ?_)
  simp only [avgTranslate]
  congr 1
  rw [integral_unifIcc hN, sub_zero, intervalIntegral.integral_of_le hN.le,
    integral_Icc_eq_integral_Ioc]
  congr 1
  refine integral_congr_ae (Eventually.of_forall fun t => ?_)
  simp only [phaseProd, Finset.Icc_self, Finset.prod_singleton, expPhase_eq_ephase]
  ring

/-- The multiplier of that average: `m(ξ) = E_t e(q(t) - ξ_1 P_1(t))`. -/
theorem avgMultiplier_one_eq {N : ℝ} (hN : 0 < N) (P : ℕ → Polynomial ℝ) (q : Polynomial ℝ)
    (j : ℕ → Fin 3) (ξ : E3) :
    avgMultiplier (unifIcc 0 N) (fun t => ephase (q.eval t))
        (fun t => (P 1).eval t • basisVec (j 1)) ξ
      = (N : ℂ)⁻¹ * ∫ t in (0 : ℝ)..N, ephase (q.eval t - ξ (j 1) * (P 1).eval t) := by
  rw [avgMultiplier, integral_unifIcc hN, sub_zero, intervalIntegral.integral_of_le hN.le,
    integral_Icc_eq_integral_Ioc]
  congr 1
  refine integral_congr_ae (Eventually.of_forall fun t => ?_)
  simp only
  rw [inner_smul_basisVec, ephase_eq_fourierChar, ← ephase_add]
  congr 1
  ring

theorem maPhase_two_one_eval {k : ℕ} (ζ : ℕ → E3 → ℝ) (θ : ℕ → ℝ) (P : ℕ → Polynomial ℝ)
    (x : E3) (t : ℝ) :
    (maPhase 2 1 k ζ θ P x).eval t = ∑ i ∈ Finset.Icc 2 k, θ i * (P i).eval t := by
  rw [maPhase_eval, Finset.Icc_eq_empty (by norm_num : ¬ (2 : ℕ) ≤ 1), Finset.sum_empty, zero_add]

theorem maPhase_one_one_eval {k : ℕ} (a : ℝ) (θ : ℕ → ℝ) (P : ℕ → Polynomial ℝ)
    (x : E3) (t : ℝ) :
    (maPhase 1 1 k (fun _ _ => a) θ P x).eval t
      = a * (P 1).eval t + ∑ i ∈ Finset.Icc 2 k, θ i * (P i).eval t := by
  rw [maPhase_eval, Finset.Icc_self, Finset.sum_singleton]

set_option maxHeartbeats 2000000 in
-- The elimination, Cauchy-Schwarz, Plancherel, the oscillation bound and the budgets share one
-- context.
/-- **Theorem `patch:lowest-energy` (lowest-input positive Fourier energy).** Fix an increasing
degree list `d_1 < ⋯ < d_k` and an input budget `c`. There is a structural integer `C` such that a
power-large correlation `Γ_k(g_0; g_1, …, g_k)` implies
`⟨g_1, P_L^{(1)} g_1⟩ = ∫ η(ξ_1 / L) |ĝ_1(ξ)|² dξ ≥ ℓ_C(δ) N^6` at `L = u_C(δ) N^{-d_1}`, the
coordinate `ξ_1` being the one of the direction `e_{j 1}`. Proof: `patch:remove-high-inputs`,
Cauchy-Schwarz with the supported output factor, `new:average-multiplier` with
`new:integral-plancherel`, and `patch:triangular` for the multiplier. -/
theorem lowestEnergy {k : ℕ} {j : ℕ → Fin 3}
    (hjm : ∀ u v, 1 ≤ u → u < v → v ≤ k → expo (j u) < expo (j v)) (hk : 1 ≤ k) {c : ℕ}
    (hc : 1 ≤ c) :
    ∃ C : ℕ, 1 ≤ C ∧ ∀ δ N : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ N →
      ∀ (P : ℕ → Polynomial ℝ) (g : ℕ → E3 → ℂ) (ζ : ℕ → E3 → ℝ) (θ : ℕ → ℝ),
        (∀ i ∈ Finset.Icc 1 k, AdmissiblePoly c δ N (expo (j i)) (P i)) →
        (∀ i, Measurable (g i)) → (∀ i y, ‖g i y‖ ≤ 1) →
        (∀ i y, y ∉ petBox (budHi c δ) N → g i y = 0) → (∀ i, Measurable (ζ i)) →
        budLo c δ * N ^ (6 : ℕ) ≤ ‖phaseCorr N k g P (maPhase (k + 1) k k ζ θ P) j‖ →
        budLo C δ * N ^ (6 : ℕ)
          ≤ ∫ ξ, eta (ξ (j 1) / (budHi C δ * (N ^ expo (j 1))⁻¹)) * ‖𝓕 (g 1) ξ‖ ^ 2 := by
  obtain ⟨C₁, hC₁, hrem⟩ := removeHighInputs hjm k hk le_rfl c hc
  obtain ⟨C0, hC0, hosc⟩ := sum_le_of_oscillation_ge 3 (by norm_num)
  have hLoc : MonoLow (budLo c) := monoLow_budLo hc
  have hHic : MonoHigh (budHi c) := monoHigh_budHi hc
  have hκ : MonoLow fun δ => budLo C₁ δ ^ 2 / (8 * budHi c δ ^ 3) :=
    ((monoLow_budLo hC₁).pow 2).div ((monoHigh_const (by norm_num : (0 : ℝ) < 8)).mul (hHic.pow 3))
  set εF : ℝ → ℝ := fun δ => Real.sqrt (budLo C₁ δ ^ 2 / (8 * budHi c δ ^ 3)
      / (32 * budHi c δ ^ 3)) with hεFdef
  have hε : MonoLow εF :=
    (hκ.div ((monoHigh_const (by norm_num : (0 : ℝ) < 32)).mul (hHic.pow 3))).sqrt
  have hLoInv : MonoHigh fun δ => (budLo c δ)⁻¹ :=
    ((monoHigh_const one_pos).div hLoc).mono (fun δ _ _ => le_of_eq (one_div _).symm)
      (fun δ h0 _ => inv_pos.mpr (budLo_pos h0 hc))
  have hRb : MonoHigh fun δ => (budLo c δ)⁻¹ * (C0 / εF δ) ^ 3 * k
      * (1 + (budLo c δ)⁻¹ * budHi c δ) ^ k := by
    have h1 : MonoHigh fun δ => C0 / εF δ :=
      (monoHigh_const (by linarith : (0 : ℝ) < C0)).div hε
    have h2 : MonoHigh fun δ => 1 + (budLo c δ)⁻¹ * budHi c δ :=
      (monoHigh_const one_pos).add (hLoInv.mul hHic)
    exact ((hLoInv.mul (h1.pow 3)).mul_const (by exact_mod_cast hk)).mul (h2.pow k)
  obtain ⟨Ch, hCh, hChb⟩ := (hRb.mul_const (by norm_num : (0 : ℝ) < 4)).exists_budHi
  obtain ⟨Cl, hCl, hClb⟩ := (hκ.div_const (by norm_num : (0 : ℝ) < 2)).exists_budLo
  set C := max Ch Cl with hCdef
  have hC : 1 ≤ C := le_trans hCh (le_max_left _ _)
  refine ⟨C, hC, ?_⟩
  intro δ N hδ0 hδ1 hN P g ζ θ hadm hg hg1 hgs hζ hcorr
  have hN0 : 0 < N := by linarith
  set u := budHi c δ with hudef
  have hu1 : 1 ≤ u := one_le_budHi hδ0 hδ1 hc
  have hu0 : 0 < u := by linarith
  obtain ⟨g₀, θ', hg₀m, hg₀, -, hΓ⟩ := hrem δ N hδ0 hδ1 hN P g ζ θ hadm hg hg1 hgs hζ hcorr
  -- `Γ_1` as a pairing with the modulated average
  set q := maPhase 2 1 k ζ θ' P 0 with hqdef
  have hp : maPhase 2 1 k ζ θ' P = fun _ => q := by
    funext x
    simp only [hqdef, maPhase, Finset.Icc_eq_empty (by norm_num : ¬ (2 : ℕ) ≤ 1),
      Finset.sum_empty, zero_add]
  rw [hp, phaseCorr_one_eq_avg hN0, Function.update_self,
    Function.update_of_ne (by norm_num : (1 : ℕ) ≠ 0)] at hΓ
  set b : ℝ → ℂ := fun t => ephase (q.eval t) with hbdef
  set v : ℝ → E3 := fun t => (P 1).eval t • basisVec (j 1) with hvdef
  have hbm : Measurable b := continuous_ephase.measurable.comp q.continuous.measurable
  have hb1 : ∀ t, ‖b t‖ ≤ 1 := fun t => (norm_ephase _).le
  have hvm : Measurable v := ((P 1).continuous.measurable).smul_const _
  have := isProbabilityMeasure_unifIcc hN0
  set T := avgTranslate (unifIcc 0 N) b v (g 1) with hTdef
  have hTm : Measurable T := measurable_avgTranslate hbm hvm (hg 1)
  have hT1 : ∀ x, ‖T x‖ ≤ 1 := fun x => by
    have h := norm_integral_le_of_norm_le_const (μ := unifIcc 0 N) (C := 1)
      (f := fun t => b t * g 1 (x - v t)) (Eventually.of_forall fun t => by
        rw [norm_mul]; exact ((mul_le_of_le_one_left (norm_nonneg _) (hb1 t)).trans (hg1 1 _)))
    rwa [probReal_univ, mul_one] at h
  -- the input `g_1`
  set box := petBox u N with hboxdef
  have hboxfin : volume box ≠ ⊤ := (isBounded_petBox _ _).measure_lt_top.ne
  have hboxμ : (volume box).toReal = 8 * u ^ 3 * N ^ 6 := by
    rw [hboxdef, volume_petBox hu0.le hN0.le, ENNReal.toReal_ofReal (by positivity)]
  have hfi : Integrable (g 1) :=
    integrable_of_bdd_support_box hu0.le hN0.le (hg 1) (hg1 1) (hgs 1)
  obtain ⟨R₀, hR₀⟩ := (isBounded_petBox u N).subset_closedBall (0 : E3)
  have hf2 : MemLp (g 1) 2 := memLp_of_bdd_of_ball (hg 1) (hg1 1) (M := R₀) (fun x hx => by
    refine hgs 1 x fun h => ?_
    have := hR₀ h
    rw [Metric.mem_closedBall, dist_zero_right] at this
    linarith) 2
  -- Cauchy-Schwarz with the supported output factor
  have hg₀s : ∀ x, x ∉ box → g₀ x = 0 := fun x hx => by
    have := hg₀ x
    rw [hgs 0 x hx, norm_zero] at this
    exact norm_le_zero_iff.mp this
  have hT2 : Integrable fun x => ‖T x‖ ^ 2 :=
    (memLp_avgTranslate (ν := unifIcc 0 N) (p := 2) hbm hb1 hvm (hg 1) (by norm_num) (by simp)
      hf2).integrable_norm_pow (by norm_num)
  have hCS := sq_norm_integral_le_measure_mul (μ := volume) (measurableSet_petBox u N) hboxfin
    (F := fun x => g₀ x * T x) (fun x hx => by rw [hg₀s x hx, zero_mul])
    (integrable_of_bdd_support_box_real (M := 1) hu0.le hN0.le
      ((hg₀m.mul hTm).norm.pow_const 2) (fun x => by
        rw [Real.norm_of_nonneg (by positivity), norm_mul, mul_pow]
        exact ((mul_le_of_le_one_left (by positivity) (pow_le_one₀ (norm_nonneg _) ((hg₀ x).trans
          (hg1 0 x)))).trans (pow_le_one₀ (norm_nonneg _) (hT1 x))))
      (fun x hx => by rw [hg₀s x hx, zero_mul, norm_zero]; norm_num))
    (integrable_of_bdd_support_box_real (M := 1) hu0.le hN0.le (hg₀m.mul hTm).norm (fun x => by
        rw [norm_norm, norm_mul]
        exact ((mul_le_of_le_one_left (norm_nonneg _) ((hg₀ x).trans (hg1 0 x))).trans (hT1 x)))
      (fun x hx => by rw [hg₀s x hx, zero_mul, norm_zero]))
  have hFT : ∫ x, ‖g₀ x * T x‖ ^ 2 ≤ ∫ x, ‖T x‖ ^ 2 := by
    refine integral_mono_of_nonneg (Eventually.of_forall fun x => by positivity) hT2
      (Eventually.of_forall fun x => ?_)
    simp only
    rw [norm_mul, mul_pow]
    exact mul_le_of_le_one_left (by positivity)
      (pow_le_one₀ (norm_nonneg _) ((hg₀ x).trans (hg1 0 x)))
  rw [integral_norm_sq_avgTranslate hbm hb1 hvm (hg 1) hfi hf2] at hFT
  set m := avgMultiplier (unifIcc 0 N) b v with hmdef
  set X := ∫ ξ, ‖m ξ‖ ^ 2 * ‖𝓕 (g 1) ξ‖ ^ 2 with hXdef
  set κ := budLo C₁ δ ^ 2 / (8 * u ^ 3) with hκdef
  have hN6 : 0 < N ^ (6 : ℕ) := by positivity
  have hX : κ * N ^ (6 : ℕ) ≤ X := by
    have h1 : (budLo C₁ δ * N ^ (6 : ℕ)) ^ 2 ≤ 8 * u ^ 3 * N ^ 6 * X := by
      have := (pow_le_pow_left₀ (by have := budLo_pos hδ0 hC₁; positivity) hΓ 2).trans hCS
      rw [hboxμ] at this
      exact this.trans (mul_le_mul_of_nonneg_left hFT (by positivity))
    have h2 : κ * N ^ (6 : ℕ) = (budLo C₁ δ * N ^ (6 : ℕ)) ^ 2 / (8 * u ^ 3 * N ^ 6) := by
      rw [hκdef]; field_simp
    rw [h2, div_le_iff₀ (by positivity)]
    nlinarith [h1]
  -- the multiplier is small off a band `|ξ_1| ≤ R`
  set ε := εF δ with hεdef
  have hε0 : 0 < ε := hε.pos hδ0 hδ1
  have hεsq : ε ^ 2 = κ / (32 * u ^ 3) := by
    rw [hεdef, hεFdef]
    exact Real.sq_sqrt (by positivity)
  set Rb := (budLo c δ)⁻¹ * (C0 / ε) ^ 3 * k * (1 + (budLo c δ)⁻¹ * u) ^ k with hRbdef
  set band := {ξ : E3 | N ^ expo (j 1) * |ξ (j 1)| ≤ Rb} with hbanddef
  have hxj : Measurable fun ξ : E3 => ξ (j 1) := (EuclideanSpace.proj (j 1)).continuous.measurable
  have hband : MeasurableSet band :=
    measurableSet_le (measurable_const.mul (continuous_abs.measurable.comp hxj)) measurable_const
  have hm1 : ∀ ξ, ‖m ξ‖ ≤ 1 := fun ξ => by
    have h := norm_integral_le_of_norm_le_const (μ := unifIcc 0 N) (C := 1)
      (f := fun t => b t * ((𝐞 (-(inner ℝ (v t) ξ)) : Circle) : ℂ))
      (Eventually.of_forall fun t => by
        rw [norm_mul, Circle.norm_coe, mul_one]; exact hb1 t)
    rwa [probReal_univ, mul_one] at h
  have hk0 : 0 ∈ Finset.range k := Finset.mem_range.mpr (by omega)
  have hmband : ∀ ξ, ε ≤ ‖m ξ‖ → ξ ∈ band := by
    intro ξ hξ
    set a := -ξ (j 1) with hadef
    have hosc' : ε ≤ ‖N⁻¹ • ∫ t in (0 : ℝ)..N, expPhase (fun s => 2 * Real.pi *
        (∑ u ∈ Finset.range k, Polynomial.C (maCoef 1 (fun _ _ => a) θ' 0 (u + 1))
          * P (u + 1)).eval s) t‖ := by
      rw [← maPhase_one_eq hk, Complex.real_smul, Complex.ofReal_inv]
      have e : m ξ = (N : ℂ)⁻¹ * ∫ t in (0 : ℝ)..N, expPhase (fun s => 2 * Real.pi *
          (maPhase 1 1 k (fun _ _ => a) θ' P 0).eval s) t := by
        rw [hmdef, avgMultiplier_one_eq hN0]
        congr 1
        refine intervalIntegral.integral_congr fun t _ => ?_
        simp only
        rw [expPhase_eq_ephase, maPhase_one_one_eval, hqdef, maPhase_two_one_eval, hadef]
        congr 1
        ring
      rw [← e]; exact hξ
    have h := hosc k N ε (budLo c δ) u (fun u => expo (j (u + 1))) (fun u => P (u + 1))
      (fun u => maCoef 1 (fun _ _ => a) θ' 0 (u + 1)) hN0 hε0 (budLo_pos hδ0 hc) hu0.le
      (fun u _ => expo_pos _) (fun u _ => Nat.succ_le_of_lt (Fin.is_lt _))
      (fun u hu' => (hadm (u + 1) (Finset.mem_Icc.mpr ⟨by omega, by omega⟩)).natDegree_eq)
      (fun u v huv hv => hjm (u + 1) (v + 1) (by omega) (by omega) (by omega))
      (fun u hu' => (hadm (u + 1) (Finset.mem_Icc.mpr ⟨by omega, by omega⟩)).2.1)
      (fun u r hu' hr => (hadm (u + 1) (Finset.mem_Icc.mpr ⟨by omega, by omega⟩)).2.2.2 r hr)
      hosc'
    have h0 := Finset.single_le_sum (f := fun u => N ^ expo (j (u + 1))
      * |maCoef 1 (fun _ _ => a) θ' 0 (u + 1)|) (fun u _ => by positivity) hk0
    simp only [maCoef, le_refl, ite_true, zero_add, hadef, abs_neg] at h0
    change N ^ expo (j 1) * |ξ (j 1)| ≤ Rb
    exact h0.trans h
  -- the energy in the band
  have hF2 : Integrable fun ξ => ‖𝓕 (g 1) ξ‖ ^ 2 :=
    (memLp_two_fourier hfi hf2).integrable_norm_pow (by norm_num)
  have hmm : Measurable m := by
    have hjoint : Measurable fun q : E3 × ℝ => b q.2 * ((𝐞 (-(inner ℝ (v q.2) q.1)) : Circle) : ℂ)
      := by
      refine (hbm.comp measurable_snd).mul ?_
      have : Continuous fun q : E3 × ℝ => ((𝐞 (-(inner ℝ (v q.2) q.1)) : Circle) : ℂ) := by
        have hv' : Continuous v := (P 1).continuous.smul continuous_const
        fun_prop
      exact this.measurable
    have h := (hjoint.stronglyMeasurable.integral_prod_right'
      (ν := unifIcc 0 N)).measurable
    exact h
  have hXi : Integrable fun ξ => ‖m ξ‖ ^ 2 * ‖𝓕 (g 1) ξ‖ ^ 2 :=
    hF2.bdd_mul (c := 1) (hmm.norm.pow_const 2).aestronglyMeasurable
      (Eventually.of_forall fun ξ => by
        rw [Real.norm_of_nonneg (by positivity)]
        exact pow_le_one₀ (norm_nonneg _) (hm1 ξ))
  have hpt : ∀ ξ, ‖m ξ‖ ^ 2 * ‖𝓕 (g 1) ξ‖ ^ 2
      ≤ band.indicator (fun ξ => ‖𝓕 (g 1) ξ‖ ^ 2) ξ + ε ^ 2 * ‖𝓕 (g 1) ξ‖ ^ 2 := by
    intro ξ
    by_cases hξ : ξ ∈ band
    · rw [Set.indicator_of_mem hξ]
      have : ‖m ξ‖ ^ 2 ≤ 1 := pow_le_one₀ (norm_nonneg _) (hm1 ξ)
      nlinarith [sq_nonneg (‖𝓕 (g 1) ξ‖), sq_nonneg ε]
    · rw [Set.indicator_of_notMem hξ, zero_add]
      have hlt : ‖m ξ‖ < ε := lt_of_not_ge fun h => hξ (hmband ξ h)
      have : ‖m ξ‖ ^ 2 ≤ ε ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hlt.le 2
      exact mul_le_mul_of_nonneg_right this (sq_nonneg _)
  have hXle : X ≤ (∫ ξ, band.indicator (fun ξ => ‖𝓕 (g 1) ξ‖ ^ 2) ξ)
      + ε ^ 2 * ∫ ξ, ‖𝓕 (g 1) ξ‖ ^ 2 := by
    refine (integral_mono hXi ((hF2.indicator hband).add (hF2.const_mul (ε ^ 2))) hpt).trans
      (le_of_eq ?_)
    simp only [Pi.add_apply]
    rw [integral_add (hF2.indicator hband) (hF2.const_mul (ε ^ 2)), integral_const_mul]
  have hL2 : ∫ ξ, ‖𝓕 (g 1) ξ‖ ^ 2 ≤ 8 * u ^ 3 * N ^ 6 := by
    rw [integral_norm_sq_fourier hfi hf2, ← hboxμ]
    have hind := (integrableOn_const (C := (1 : ℝ)) hboxfin).integrable_indicator
      (measurableSet_petBox u N)
    calc ∫ x, ‖g 1 x‖ ^ 2 ≤ ∫ x, box.indicator (fun _ => (1 : ℝ)) x := by
          refine integral_mono_of_nonneg (Eventually.of_forall fun x => by positivity) hind
            (Eventually.of_forall fun x => ?_)
          beta_reduce
          by_cases hx : x ∈ box
          · rw [Set.indicator_of_mem hx]; exact pow_le_one₀ (norm_nonneg _) (hg1 1 x)
          · rw [Set.indicator_of_notMem hx, hgs 1 x hx, norm_zero]; norm_num
      _ = (volume box).toReal := by
          rw [integral_indicator_const _ (measurableSet_petBox u N), smul_eq_mul, mul_one,
            measureReal_def]
  have hbandE : κ / 2 * N ^ (6 : ℕ) ≤ ∫ ξ, band.indicator (fun ξ => ‖𝓕 (g 1) ξ‖ ^ 2) ξ := by
    have h1 : ε ^ 2 * ∫ ξ, ‖𝓕 (g 1) ξ‖ ^ 2 ≤ κ / 4 * N ^ (6 : ℕ) := by
      calc ε ^ 2 * ∫ ξ, ‖𝓕 (g 1) ξ‖ ^ 2 ≤ ε ^ 2 * (8 * u ^ 3 * N ^ 6) :=
            mul_le_mul_of_nonneg_left hL2 (sq_nonneg _)
        _ = κ / 4 * N ^ (6 : ℕ) := by rw [hεsq]; field_simp; ring
    have hκN : 0 ≤ κ * N ^ (6 : ℕ) := by positivity
    linarith [hX, hXle, h1]
  -- the cutoff is one on the band
  have hNd : 0 < N ^ expo (j 1) := pow_pos hN0 _
  have hChC : budHi Ch δ ≤ budHi C δ := budHi_monotone hδ0 hδ1 hCh (le_max_left _ _)
  have hRb4 : Rb * 4 ≤ budHi C δ := (hChb δ hδ0 hδ1).trans hChC
  have hCpos : 0 < budHi C δ := budHi_pos hδ0 hC
  have hEt : ∀ ξ, band.indicator (fun ξ => ‖𝓕 (g 1) ξ‖ ^ 2) ξ
      ≤ eta (ξ (j 1) / (budHi C δ * (N ^ expo (j 1))⁻¹)) * ‖𝓕 (g 1) ξ‖ ^ 2 := by
    intro ξ
    by_cases hξ : ξ ∈ band
    · rw [Set.indicator_of_mem hξ, eta_eq_one, one_mul]
      have hb' : N ^ expo (j 1) * |ξ (j 1)| ≤ Rb := hξ
      rw [abs_div, abs_of_pos (by positivity : 0 < budHi C δ * (N ^ expo (j 1))⁻¹),
        div_le_iff₀ (by positivity)]
      have : |ξ (j 1)| * N ^ expo (j 1) ≤ budHi C δ / 4 := by linarith
      calc |ξ (j 1)| = |ξ (j 1)| * N ^ expo (j 1) * (N ^ expo (j 1))⁻¹ := by
            field_simp
        _ ≤ budHi C δ / 4 * (N ^ expo (j 1))⁻¹ :=
            mul_le_mul_of_nonneg_right this (by positivity)
        _ = 1 / 4 * (budHi C δ * (N ^ expo (j 1))⁻¹) := by ring
    · rw [Set.indicator_of_notMem hξ]
      exact mul_nonneg (eta_nonneg _) (sq_nonneg _)
  have hEi : Integrable fun ξ => eta (ξ (j 1) / (budHi C δ * (N ^ expo (j 1))⁻¹))
      * ‖𝓕 (g 1) ξ‖ ^ 2 :=
    hF2.bdd_mul (c := 1) ((eta_continuous.comp (show Continuous fun ξ : E3 =>
        ξ (j 1) / (budHi C δ * (N ^ expo (j 1))⁻¹) by fun_prop)).aestronglyMeasurable)
      (Eventually.of_forall fun ξ => by
        rw [Real.norm_eq_abs, abs_of_nonneg (eta_nonneg _)]; exact eta_le_one _)
  have hClC : budLo C δ ≤ budLo Cl δ := budLo_antitone hδ0 hδ1 hCl (le_max_right _ _)
  calc budLo C δ * N ^ (6 : ℕ) ≤ κ / 2 * N ^ (6 : ℕ) :=
        mul_le_mul_of_nonneg_right (hClC.trans (hClb δ hδ0 hδ1)) hN6.le
    _ ≤ _ := hbandE.trans (integral_mono (hF2.indicator hband) hEi hEt)

end

/-! ### `patch:energy-core`, step 1: replacing the first input and smoothing its adjoint -/

section
open Filter Topology MeasureTheory

/-- **The correlation does not depend on the order of the inputs**: relabelling the inputs
`1, …, k` together with their polynomials and directions by a bijection of `{1, …, k}` leaves
`Γ_k` unchanged. -/
theorem phaseCorr_comp_perm {N : ℝ} {k : ℕ} (σ : ℕ → ℕ) (h0 : σ 0 = 0)
    (hmap : ∀ i ∈ Finset.Icc 1 k, σ i ∈ Finset.Icc 1 k)
    (hinj : Set.InjOn σ (Finset.Icc 1 k : Set ℕ))
    (hsurj : Set.SurjOn σ (Finset.Icc 1 k : Set ℕ) (Finset.Icc 1 k : Set ℕ))
    (g : ℕ → E3 → ℂ) (P : ℕ → Polynomial ℝ) (p : E3 → Polynomial ℝ) (j : ℕ → Fin 3) :
    phaseCorr N k (fun i => g (σ i)) (fun i => P (σ i)) p (fun i => j (σ i))
      = phaseCorr N k g P p j := by
  simp only [phaseCorr, phaseProd, h0]
  refine integral_congr_ae (Eventually.of_forall fun x => ?_)
  simp only
  congr 2
  refine intervalIntegral.integral_congr fun t _ => ?_
  congr 1
  exact Finset.prod_nbij σ hmap hinj hsurj (fun i _ => rfl)

/-- The rotation `1 ↦ k`, `i ↦ i - 1` of the labels (as the relabelling `i ↦ rot k i` of the
inputs: the new input `k` is the old input `1`, the new input `i < k` is the old input `i + 1`). -/
def rot (k i : ℕ) : ℕ := if i = 0 then 0 else if i < k then i + 1 else if i = k then 1 else i

theorem rot_zero (k : ℕ) : rot k 0 = 0 := by simp [rot]

theorem rot_self {k : ℕ} (hk : 1 ≤ k) : rot k k = 1 := by
  simp [rot, show k ≠ 0 by omega]

theorem rot_of_lt {k i : ℕ} (hi : 1 ≤ i) (hik : i < k) : rot k i = i + 1 := by
  simp [rot, show i ≠ 0 by omega, hik]

theorem rot_mem {k : ℕ} (hk : 1 ≤ k) : ∀ i ∈ Finset.Icc 1 k, rot k i ∈ Finset.Icc 1 k := by
  intro i hi
  rw [Finset.mem_Icc] at hi ⊢
  unfold rot
  split_ifs <;> omega

theorem rot_injOn {k : ℕ} : Set.InjOn (rot k) (Finset.Icc 1 k : Set ℕ) := by
  intro a ha b hb hab
  simp only [Finset.coe_Icc, Set.mem_Icc] at ha hb
  unfold rot at hab
  split_ifs at hab <;> omega

theorem rot_surjOn {k : ℕ} (hk : 1 ≤ k) :
    Set.SurjOn (rot k) (Finset.Icc 1 k : Set ℕ) (Finset.Icc 1 k : Set ℕ) := by
  intro b hb
  simp only [Finset.coe_Icc, Set.mem_Icc] at hb
  by_cases hb1 : b = 1
  · exact ⟨k, by simp [Finset.coe_Icc]; omega, by rw [rot_self hk, hb1]⟩
  · refine ⟨b - 1, by simp [Finset.coe_Icc]; omega, ?_⟩
    rw [rot_of_lt (by omega) (by omega)]; omega

theorem rot_eq_one_iff {k i : ℕ} (hk : 1 ≤ k) (hi : i ∈ Finset.Icc 1 k) : rot k i = 1 ↔ i = k := by
  rw [Finset.mem_Icc] at hi
  unfold rot
  split_ifs <;> omega

/-- `Γ_k` with its inputs rotated. -/
theorem phaseCorr_rot {N : ℝ} {k : ℕ} (hk : 1 ≤ k) (g : ℕ → E3 → ℂ) (P : ℕ → Polynomial ℝ)
    (p : E3 → Polynomial ℝ) (j : ℕ → Fin 3) :
    phaseCorr N k (fun i => g (rot k i)) (fun i => P (rot k i)) p (fun i => j (rot k i))
      = phaseCorr N k g P p j :=
  phaseCorr_comp_perm (rot k) (rot_zero k) (rot_mem hk) rot_injOn (rot_surjOn hk) g P p j

/-- Updating the rotated first input is updating the new last input. -/
theorem update_comp_rot {k : ℕ} (hk : 1 ≤ k) (g : ℕ → E3 → ℂ) (h : E3 → ℂ) :
    (fun i => Function.update g 1 h (rot k i)) = Function.update (fun i => g (rot k i)) k h := by
  funext i
  by_cases hik : i = k
  · subst hik; rw [rot_self hk, Function.update_self, Function.update_self]
  · rw [Function.update_of_ne hik, Function.update_of_ne]
    unfold rot
    split_ifs <;> omega

/-- The phase of `MA(k+1, k)` is zero. -/
theorem maPhase_empty (k : ℕ) (ζ : ℕ → E3 → ℝ) (θ : ℕ → ℝ) (P : ℕ → Polynomial ℝ) :
    maPhase (k + 1) k k ζ θ P = fun _ => 0 := by
  funext x
  simp [maPhase]

/-- A one-bounded Borel function supported in a box is integrable and square integrable. -/
theorem integrable_memLp_of_box {f : E3 → ℂ} (hf : Measurable f) (hf1 : ∀ x, ‖f x‖ ≤ 1)
    {C N : ℝ} (hC : 0 ≤ C) (hN : 0 ≤ N) (hfs : ∀ x, x ∉ petBox C N → f x = 0) :
    Integrable f ∧ MemLp f 2 := by
  refine ⟨integrable_of_bdd_support_box hC hN hf hf1 hfs, ?_⟩
  obtain ⟨R₀, hR₀⟩ := (isBounded_petBox C N).subset_closedBall (0 : E3)
  exact memLp_of_bdd_of_ball hf hf1 (M := R₀) (fun x hx => by
    refine hfs x fun h => ?_
    have := hR₀ h
    rw [Metric.mem_closedBall, dist_zero_right] at this
    linarith) 2

set_option maxHeartbeats 2000000 in
-- The reordering, the adjoint, the lowest-input energy and the smoothing share one context.
open scoped Classical in
/-- **`patch:energy-core`, step 1: replace the first input, and smooth that adjoint.** For an
increasing degree list and `k ≥ 2`, a power-large unmodulated `Γ_k(g_0; g_1, …, g_k)` gives a
measurable one-bounded `G` (the normalized smoothing `M⁻¹ P_{L_1}^{(1)} F_1` of the exact adjoint
`F_1` of the first input) with the Lipschitz bound `|G(x + v e_1) - G(x)| ≤ u_C(δ) N^{-d_1} |v|`,
such that the correlation with first input `G` (cut off to the enlarged box) and the other inputs
unchanged is power-large. `F_1` is `Auto.maAdj` for the inputs rotated so that the first comes
last (`Auto.phaseCorr_rot`); the lower bound is `⟨G, F_1⟩ = M⁻¹ ⟨F_1, P_{L_1} F_1⟩` and
`patch:lowest-energy` for the correlation with first input `F_1`. -/
theorem energyCore_step1 {k : ℕ} {j : ℕ → Fin 3}
    (hjm : ∀ u v, 1 ≤ u → u < v → v ≤ k → expo (j u) < expo (j v)) (hk : 1 ≤ k) {c : ℕ}
    (hc : 1 ≤ c) :
    ∃ C : ℕ, 1 ≤ C ∧ ∀ δ N : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ N →
      ∀ (P : ℕ → Polynomial ℝ) (g : ℕ → E3 → ℂ),
        (∀ i ∈ Finset.Icc 1 k, AdmissiblePoly c δ N (expo (j i)) (P i)) →
        (∀ i, Measurable (g i)) → (∀ i y, ‖g i y‖ ≤ 1) →
        (∀ i y, y ∉ petBox (budHi c δ) N → g i y = 0) →
        budLo c δ * N ^ (6 : ℕ) ≤ ‖phaseCorr N k g P (fun _ => 0) j‖ →
        ∃ G : E3 → ℂ, Measurable G ∧ (∀ x, ‖G x‖ ≤ 1) ∧
          (∀ x v, ‖G (x + v • basisVec (j 1)) - G x‖
            ≤ budHi C δ * (N ^ expo (j 1))⁻¹ * |v|) ∧
          budLo C δ * N ^ (6 : ℕ) ≤ ‖phaseCorr N k (Function.update g 1
            (fun x => if x ∈ petBox (5 * budHi c δ) N then G x else 0)) P (fun _ => 0) j‖ := by
  have hA : MonoLow fun δ => budLo c δ ^ 2 / (8 * budHi c δ ^ 3) :=
    ((monoLow_budLo hc).pow 2).div ((monoHigh_const (by norm_num : (0 : ℝ) < 8)).mul
      ((monoHigh_budHi hc).pow 3))
  obtain ⟨cA, hcA, hcAb⟩ := hA.exists_budLo
  set c₅ := max (5 * c) cA with hc₅def
  have hc₅ : 1 ≤ c₅ := le_trans hcA (le_max_right _ _)
  have h5c : 5 * c ≤ c₅ := le_max_left _ _
  have hcc₅ : c ≤ c₅ := le_trans (by omega) h5c
  obtain ⟨Cle, hCle, hLE⟩ := lowestEnergy hjm hk hc₅
  set M' := max 1 etaKerL1 with hM'def
  have hM'1 : 1 ≤ M' := le_max_left _ _
  have hM'0 : 0 < M' := by linarith
  obtain ⟨Cl, hCl, hClb⟩ := ((monoLow_budLo hCle).div_const hM'0).exists_budLo
  obtain ⟨Ch, hCh, hChb⟩ := ((monoHigh_budHi hCle).mul_const
    (by have := etaKerDerivL1_nonneg; linarith : (0 : ℝ) < etaKerDerivL1 + 1)).exists_budHi
  set C := max Cl Ch with hCdef
  have hC : 1 ≤ C := le_trans hCl (le_max_left _ _)
  refine ⟨C, hC, ?_⟩
  intro δ N hδ0 hδ1 hN P g hadm hg hg1 hgs hcorr
  have hN0 : 0 < N := by linarith
  set u := budHi c δ with hudef
  have hu1 : 1 ≤ u := one_le_budHi hδ0 hδ1 hc
  have hu0 : 0 < u := by linarith
  have hN6 : 0 < N ^ (6 : ℕ) := by positivity
  -- rotate the first input to the end
  set g' : ℕ → E3 → ℂ := fun i => g (rot k i) with hg'def
  set P' : ℕ → Polynomial ℝ := fun i => P (rot k i) with hP'def
  set j' : ℕ → Fin 3 := fun i => j (rot k i) with hj'def
  have hadm' : ∀ i ∈ Finset.Icc 1 k, AdmissiblePoly c δ N (expo (j' i)) (P' i) :=
    fun i hi => hadm (rot k i) (rot_mem hk i hi)
  have hg'm : ∀ i, Measurable (g' i) := fun i => hg _
  have hg'1 : ∀ i x, ‖g' i x‖ ≤ 1 := fun i x => hg1 _ x
  have hg's : ∀ i x, x ∉ petBox u N → g' i x = 0 := fun i x hx => hgs _ x hx
  obtain ⟨hFm, hF1, hFs, hFcorr, hFsq⟩ := ma_adjoint hN hδ0 hc hk le_rfl le_rfl hg'm hg'1 hg's
    hadm' (ζ := fun _ _ => 0) (fun _ => measurable_const) (fun _ => 0)
  set F := maAdj N k k k g' P' (fun _ _ => 0) (fun _ => 0) j' with hFdef
  rw [maPhase_empty] at hFcorr hFsq
  have hΓrot : phaseCorr N k g' P' (fun _ => 0) j' = phaseCorr N k g P (fun _ => 0) j :=
    phaseCorr_rot hk g P _ j
  rw [hΓrot] at hFsq
  -- the replaced correlation is `‖F‖₂²`, and it is power-large
  have hI : budLo c₅ δ * N ^ (6 : ℕ) ≤ ∫ y, ‖F y‖ ^ 2 := by
    have h1 : (budLo c δ * N ^ (6 : ℕ)) ^ 2 ≤ 8 * u ^ 3 * N ^ 6 * ∫ y, ‖F y‖ ^ 2 :=
      (pow_le_pow_left₀ (by have := budLo_pos hδ0 hc; positivity) hcorr 2).trans hFsq
    have h2 := hcAb δ hδ0 hδ1
    have h3 : budLo c₅ δ ≤ budLo cA δ := budLo_antitone hδ0 hδ1 hcA (le_max_right _ _)
    calc budLo c₅ δ * N ^ (6 : ℕ) ≤ budLo c δ ^ 2 / (8 * u ^ 3) * N ^ (6 : ℕ) :=
          mul_le_mul_of_nonneg_right (h3.trans h2) hN6.le
      _ = (budLo c δ * N ^ (6 : ℕ)) ^ 2 / (8 * u ^ 3 * N ^ 6) := by field_simp
      _ ≤ _ := by rw [div_le_iff₀ (by positivity)]; nlinarith [h1]
  have hupd : ∀ h : E3 → ℂ, phaseCorr N k (Function.update g 1 h) P (fun _ => 0) j
      = phaseCorr N k (Function.update g' k h) P' (fun _ => 0) j' := fun h => by
    rw [← phaseCorr_rot hk (Function.update g 1 h) P _ j, update_comp_rot hk]
  -- `patch:lowest-energy` for the correlation with first input `F`
  have h5 : 5 * u ≤ budHi c₅ δ := by
    have h := budHi_mul_le hδ0 hδ1 hc (k := 5) (by norm_num)
    push_cast at h
    exact h.trans (budHi_monotone hδ0 hδ1 (by omega) h5c)
  have hbox5 : petBox (5 * u) N ⊆ petBox (budHi c₅ δ) N := petBox_mono h5 hN0.le
  have hbox1 : petBox u N ⊆ petBox (5 * u) N := petBox_mono (by linarith) hN0.le
  have hEm : ∀ i, Measurable (Function.update g 1 F i) := fun i => by
    by_cases hi : i = 1
    · rw [hi, Function.update_self]; exact hFm
    · rw [Function.update_of_ne hi]; exact hg i
  have hE1 : ∀ i y, ‖Function.update g 1 F i y‖ ≤ 1 := fun i y => by
    by_cases hi : i = 1
    · rw [hi, Function.update_self]; exact hF1 y
    · rw [Function.update_of_ne hi]; exact hg1 i y
  have hEs : ∀ i y, y ∉ petBox (budHi c₅ δ) N → Function.update g 1 F i y = 0 := fun i y hy => by
    by_cases hi : i = 1
    · rw [hi, Function.update_self]; exact hFs y fun h => hy (hbox5 h)
    · rw [Function.update_of_ne hi]; exact hgs i y fun h => hy (hbox5 (hbox1 h))
  have hEcorr : budLo c₅ δ * N ^ (6 : ℕ) ≤ ‖phaseCorr N k (Function.update g 1 F) P
      (maPhase (k + 1) k k (fun _ _ => 0) (fun _ => 0) P) j‖ := by
    rw [maPhase_empty, hupd, hFcorr, Complex.norm_real,
      Real.norm_of_nonneg (integral_nonneg fun y => by positivity)]
    exact hI
  have hEn := hLE δ N hδ0 hδ1 hN P (Function.update g 1 F) (fun _ _ => 0) (fun _ => 0)
    (fun i hi => (hadm i hi).mono hδ0 hδ1 hc hcc₅ hN0.le) hEm hE1 hEs
    (fun _ => measurable_const) hEcorr
  rw [Function.update_self] at hEn
  -- the smoothed adjoint
  have hNd : 0 < N ^ expo (j 1) := pow_pos hN0 _
  set L₁ := budHi Cle δ * (N ^ expo (j 1))⁻¹ with hL₁def
  have hL₁ : 0 < L₁ := mul_pos (budHi_pos hδ0 hCle) (inv_pos.mpr hNd)
  set G₀ := Auto.P L₁ (j 1) F with hG₀def
  set G : E3 → ℂ := fun x => ((M' : ℂ))⁻¹ * G₀ x with hGdef
  have hGm : Measurable G := measurable_const.mul (measurable_P (j 1) hFm)
  have hG1 : ∀ x, ‖G x‖ ≤ 1 := fun x => by
    rw [hGdef]; simp only
    rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hM'0.le, inv_mul_le_iff₀ hM'0,
      mul_one]
    exact (norm_P_le_of_norm_le_one hL₁ (j 1) hF1 x).trans (le_max_right _ _)
  have hGlip : ∀ x v, ‖G (x + v • basisVec (j 1)) - G x‖
      ≤ budHi C δ * (N ^ expo (j 1))⁻¹ * |v| := by
    intro x v
    have h := norm_P_add_sub_le hL₁ (j 1) hFm hF1 x v
    rw [hGdef]; simp only
    rw [← mul_sub, norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hM'0.le]
    have hB1 := etaKerDerivL1_nonneg
    have hC' : budHi Cle δ * (etaKerDerivL1 + 1) ≤ budHi C δ :=
      (hChb δ hδ0 hδ1).trans (budHi_monotone hδ0 hδ1 hCh (le_max_right _ _))
    have hinv : M'⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hM'1
    calc M'⁻¹ * ‖G₀ (x + v • basisVec (j 1)) - G₀ x‖
        ≤ 1 * (L₁ * etaKerDerivL1 * |v|) :=
          mul_le_mul hinv h (norm_nonneg _) zero_le_one
      _ ≤ budHi C δ * (N ^ expo (j 1))⁻¹ * |v| := by
          rw [one_mul, hL₁def]
          have : budHi Cle δ * etaKerDerivL1 ≤ budHi C δ := by
            have := budHi_pos hδ0 hCle; nlinarith
          have hv := abs_nonneg v
          have hNi : 0 ≤ (N ^ expo (j 1))⁻¹ := by positivity
          calc budHi Cle δ * (N ^ expo (j 1))⁻¹ * etaKerDerivL1 * |v|
              = budHi Cle δ * etaKerDerivL1 * ((N ^ expo (j 1))⁻¹ * |v|) := by ring
            _ ≤ budHi C δ * ((N ^ expo (j 1))⁻¹ * |v|) :=
                mul_le_mul_of_nonneg_right this (by positivity)
            _ = budHi C δ * (N ^ expo (j 1))⁻¹ * |v| := by ring
  refine ⟨G, hGm, hG1, hGlip, ?_⟩
  -- the correlation with first input `G` is `M⁻¹ ⟨F, P_{L_1} F⟩`
  set H : E3 → ℂ := fun x => if x ∈ petBox (5 * u) N then G x else 0 with hHdef
  have hHm : Measurable H := Measurable.ite (measurableSet_petBox _ _) hGm measurable_const
  have hH1 : ∀ x, ‖H x‖ ≤ 1 := fun x => by
    rw [hHdef]; simp only; split_ifs
    · exact hG1 x
    · simp
  have hHs : ∀ x, x ∉ petBox (5 * u) N → H x = 0 := fun x hx => by
    rw [hHdef]; simp only [ite_eq_right hx]
  have hUm : ∀ i, Measurable (Function.update g' k H i) := fun i => by
    by_cases hi : i = k
    · rw [hi, Function.update_self]; exact hHm
    · rw [Function.update_of_ne hi]; exact hg'm i
  have hU1 : ∀ i x, ‖Function.update g' k H i x‖ ≤ 1 := fun i x => by
    by_cases hi : i = k
    · rw [hi, Function.update_self]; exact hH1 x
    · rw [Function.update_of_ne hi]; exact hg'1 i x
  have hUs : ∀ i x, x ∉ petBox (5 * u) N → Function.update g' k H i x = 0 := fun i x hx => by
    by_cases hi : i = k
    · rw [hi, Function.update_self]; exact hHs x hx
    · rw [Function.update_of_ne hi]; exact hg's i x fun h => hx (hbox1 h)
  have hP3 : ∀ i ∈ Finset.Icc (k + 1) k, (P' i).natDegree ≤ 3 := fun i hi => by
    simp at hi
  have hinner := phaseCorr_eq_inner_maAdj hN0 hk le_rfl le_rfl hUm hU1 hUs hP3
    (ζ := fun _ _ => 0) (fun _ => measurable_const) (fun _ => 0) j'
  rw [maPhase_empty, maAdj_update hk, Function.update_self, ← hFdef] at hinner
  obtain ⟨hFi, hF2⟩ := integrable_memLp_of_box hFm hF1 (by positivity) hN0.le hFs
  have hHF : ∫ y, H y * conj (F y) = ((M' : ℂ))⁻¹ * ∫ y, G₀ y * conj (F y) := by
    rw [← integral_const_mul]
    refine integral_congr_ae (Eventually.of_forall fun y => ?_)
    rw [hHdef, hGdef]; simp only
    split_ifs with hy
    · ring
    · rw [hFs y hy]; simp
  have hPF : ∫ y, G₀ y * conj (F y) = ((∫ ξ, eta (ξ (j 1) / L₁) * ‖𝓕 F ξ‖ ^ 2 : ℝ) : ℂ) := by
    rw [hG₀def, integral_P_mul_conj_eq hL₁ (j 1) hFm hFi hF2 hFm hFi hF2,
      integral_mul_conj_P_eq hL₁ (j 1) hFm hFi hF2]
  have hgoal := hupd H
  rw [hinner] at hgoal
  change budLo C δ * N ^ (6 : ℕ) ≤ ‖phaseCorr N k (Function.update g 1 H) P (fun _ => 0) j‖
  rw [hgoal, hHF, hPF, norm_mul, norm_inv, Complex.norm_real, Complex.norm_real,
    Real.norm_of_nonneg hM'0.le,
    Real.norm_of_nonneg (integral_eta_mul_norm_sq_nonneg _ _ _)]
  have hClC : budLo C δ ≤ budLo Cl δ := budLo_antitone hδ0 hδ1 hCl (le_max_left _ _)
  calc budLo C δ * N ^ (6 : ℕ) ≤ budLo Cle δ / M' * N ^ (6 : ℕ) :=
        mul_le_mul_of_nonneg_right (hClC.trans (hClb δ hδ0 hδ1)) hN6.le
    _ = M'⁻¹ * (budLo Cle δ * N ^ (6 : ℕ)) := by ring
    _ ≤ M'⁻¹ * ∫ ξ, eta (ξ (j 1) / L₁) * ‖𝓕 F ξ‖ ^ 2 :=
        mul_le_mul_of_nonneg_left hEn (by positivity)

end

/-! ### `patch:energy-core`, step 2: freezing on one of `K` intervals -/

section
open Filter Topology MeasureTheory

/-- **The increments of an admissible polynomial on `[0, N]`**:
`|P(t) - P(a)| ≤ 12 u_c(δ) N^{d-1} |t - a|` for `d ≤ 3`. -/
theorem abs_eval_sub_le_of_admissible {c : ℕ} {δ N : ℝ} (hN : 1 ≤ N) {d : ℕ} (hd : d ≤ 3)
    {P : Polynomial ℝ} (hP : AdmissiblePoly c δ N d P) (hc : 1 ≤ c) (hδ0 : 0 < δ) {t a : ℝ}
    (ht : t ∈ Set.Icc 0 N) (ha : a ∈ Set.Icc 0 N) :
    |P.eval t - P.eval a| ≤ 12 * budHi c δ * N ^ (d - 1) * |t - a| := by
  have hN0 : 0 ≤ N := by linarith
  have hu := (budHi_pos hδ0 hc).le
  obtain ⟨hdeg, _, hlc, hco⟩ := hP
  rw [Polynomial.eval_eq_sum_range, Polynomial.eval_eq_sum_range, hdeg, ← Finset.sum_sub_distrib]
  have hterm : ∀ r ∈ Finset.range (d + 1), |P.coeff r * t ^ r - P.coeff r * a ^ r|
      ≤ 3 * budHi c δ * N ^ (d - 1) * |t - a| := by
    intro r hr
    have hr' : r ≤ d := Nat.lt_succ_iff.mp (Finset.mem_range.mp hr)
    rw [← mul_sub, abs_mul]
    have hpow : |t ^ r - a ^ r| ≤ |t - a| * r * N ^ (r - 1) := by
      have hmax : max |t| |a| ≤ N :=
        max_le (by rw [abs_of_nonneg ht.1]; exact ht.2) (by rw [abs_of_nonneg ha.1]; exact ha.2)
      have h := abs_pow_sub_pow_le t a r
      exact h.trans (mul_le_mul_of_nonneg_left
        (pow_le_pow_left₀ (le_max_of_le_left (abs_nonneg _)) hmax _) (by positivity))
    have hcr : |P.coeff r| ≤ budHi c δ * N ^ (d - r) := by
      rcases eq_or_lt_of_le hr' with h | h
      · subst h
        rw [Nat.sub_self, pow_zero, mul_one,
          show P.coeff r = P.leadingCoeff by rw [Polynomial.leadingCoeff, hdeg]]
        exact hlc
      · exact hco r h
    rcases Nat.eq_zero_or_pos r with h0 | h0
    · subst h0; simp only [pow_zero, sub_self, abs_zero, mul_zero]; positivity
    · have hexp : N ^ (d - r) * N ^ (r - 1) = N ^ (d - 1) := by
        rw [← pow_add]; congr 1; omega
      have hr3 : (r : ℝ) ≤ 3 := by exact_mod_cast hr'.trans hd
      calc |P.coeff r| * |t ^ r - a ^ r|
          ≤ budHi c δ * N ^ (d - r) * (|t - a| * r * N ^ (r - 1)) :=
            mul_le_mul hcr hpow (abs_nonneg _) (by positivity)
        _ = r * budHi c δ * (N ^ (d - r) * N ^ (r - 1)) * |t - a| := by ring
        _ = r * budHi c δ * N ^ (d - 1) * |t - a| := by rw [hexp]
        _ ≤ 3 * budHi c δ * N ^ (d - 1) * |t - a| := by gcongr
  refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
  refine (Finset.sum_le_sum hterm).trans ?_
  rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  have hd4 : ((d + 1 : ℕ) : ℝ) ≤ 4 := by exact_mod_cast (by omega : d + 1 ≤ 4)
  have : 0 ≤ 3 * budHi c δ * N ^ (d - 1) * |t - a| := by positivity
  nlinarith

/-- The frozen polynomials `Q_i(u) = P_{i+1}(a + u) - P_{i+1}(a)` of `patch:frozen-correlation`
(relabelled so that the remaining inputs are `1, …, k-1`). -/
noncomputable def frozenPoly (P : ℕ → Polynomial ℝ) (a : ℝ) : ℕ → Polynomial ℝ :=
  fun i => (P (i + 1)).comp (Polynomial.X + Polynomial.C a) - Polynomial.C ((P (i + 1)).eval a)

theorem frozenPoly_eval (P : ℕ → Polynomial ℝ) (a : ℝ) (i : ℕ) (u : ℝ) :
    (frozenPoly P a i).eval u = (P (i + 1)).eval (u + a) - (P (i + 1)).eval a := by
  simp [frozenPoly, Polynomial.eval_comp]

/-- The frozen inputs of `patch:frozen-correlation`: `g_0^a = g_0 G(· - P_1(a) e_1)` and
`f_i^a = f_{i+1}(· - P_{i+1}(a) e_{i+1})`, relabelled. -/
noncomputable def frozenIn (g : ℕ → E3 → ℂ) (G : E3 → ℂ) (P : ℕ → Polynomial ℝ)
    (j : ℕ → Fin 3) (a : ℝ) : ℕ → E3 → ℂ :=
  fun i x => if i = 0 then g 0 x * G (x - (P 1).eval a • basisVec (j 1))
    else g (i + 1) (x - (P (i + 1)).eval a • basisVec (j (i + 1)))

/-- **`patch:frozen-correlation`, the identity**: the frozen normalized correlation on `[a, a + n]`
is exactly the correlation `Γ_{k-1}` of the frozen inputs and polynomials at scale `n`. -/
theorem phaseCorr_frozen (n : ℝ) {k : ℕ} (hk : 1 ≤ k) (g : ℕ → E3 → ℂ)
    (G : E3 → ℂ) (P : ℕ → Polynomial ℝ) (j : ℕ → Fin 3) (a : ℝ) :
    phaseCorr n (k - 1) (frozenIn g G P j a) (frozenPoly P a) (fun _ => 0) (fun i => j (i + 1))
      = ∫ x, g 0 x * G (x - (P 1).eval a • basisVec (j 1)) * ((n : ℂ)⁻¹
          * ∫ t in a..a + n, ∏ i ∈ Finset.Icc 2 k, g i (x - (P i).eval t • basisVec (j i))) := by
  rw [phaseCorr]
  refine integral_congr_ae (Eventually.of_forall fun x => ?_)
  simp only [frozenIn, ite_true, mul_assoc]
  congr 2
  have e : ∀ u, phaseProd (k - 1) (frozenIn g G P j a) (frozenPoly P a) (fun _ => 0)
      (fun i => j (i + 1)) x u
      = ∏ i ∈ Finset.Icc 2 k, g i (x - (P i).eval (u + a) • basisVec (j i)) := by
    intro u
    simp only [phaseProd, Polynomial.eval_zero]
    rw [show expPhase (fun s => 2 * Real.pi * 0) u = 1 by simp [expPhase], mul_one]
    refine Finset.prod_nbij (· + 1) (fun i hi => by simp at hi ⊢; omega)
      (fun a _ b _ h => by simpa using h) (fun b hb => ⟨b - 1, by simp at hb ⊢; omega,
        by simp at hb ⊢; omega⟩) (fun i hi => ?_)
    have hi0 : i ≠ 0 := by simp at hi; omega
    simp only [frozenIn, ite_eq_right hi0, frozenPoly_eval]
    congr 1
    rw [sub_sub, ← add_smul]
    congr 2
    ring
  simp_rw [e]
  rw [intervalIntegral.integral_comp_add_right (fun t =>
    ∏ i ∈ Finset.Icc 2 k, g i (x - (P i).eval t • basisVec (j i))) a, zero_add, add_comm n a]

/-- A point of the box moved by an admissible polynomial of `t ∈ [0, N]` stays in the box enlarged
by `5`. -/
theorem sub_eval_smul_mem_petBox {N : ℝ} (hN : 1 ≤ N) {δ : ℝ} (hδ0 : 0 < δ) {c : ℕ} (hc : 1 ≤ c)
    {m : Fin 3} {Q : Polynomial ℝ} (hQ : AdmissiblePoly c δ N (expo m) Q) {x : E3}
    (hx : x ∈ petBox (budHi c δ) N) {t : ℝ} (ht : t ∈ Set.Icc 0 N) :
    x - Q.eval t • basisVec m ∈ petBox (5 * budHi c δ) N := by
  have hN0 : 0 < N := by linarith
  have hu := budHi_pos hδ0 hc
  have hP : |Q.eval t| ≤ 4 * budHi c δ * N ^ expo m :=
    abs_eval_le_of_admissible hN (Nat.succ_le_of_lt (Fin.is_lt _)) hQ hc hδ0 ht
  intro i
  have hi := hx i
  have hNi : 0 ≤ N ^ expo i := pow_nonneg hN0.le _
  by_cases hij : i = m
  · subst hij
    simp only [PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, basisVec_apply_self, mul_one]
    have := abs_le.mp hP
    have hp := mul_pos hu (pow_pos hN0 (expo i))
    constructor <;> nlinarith [hi.1, hi.2]
  · simp only [PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, basisVec_apply_ne hij, mul_zero,
      sub_zero]
    have hp := mul_pos hu (pow_pos hN0 (expo i))
    constructor <;> nlinarith [hi.1, hi.2]

/-- Measurability of a parameter integral over an interval. -/
theorem measurable_intervalIntegral_param {F : E3 → ℝ → ℂ} (hF : Measurable (Function.uncurry F))
    {a b : ℝ} (hab : a ≤ b) : Measurable fun x => ∫ t in a..b, F x t := by
  have h := (hF.stronglyMeasurable.integral_prod_right'
    (ν := volume.restrict (Set.Ioc a b))).measurable
  have e : (fun x => ∫ t in a..b, F x t) = fun x => ∫ t in Set.Ioc a b, F x t := by
    funext x; rw [intervalIntegral.integral_of_le hab]
  rw [e]; exact h

theorem intervalIntegrable_of_norm_le_one {f : ℝ → ℂ} (hf : Measurable f) (hf1 : ∀ t, ‖f t‖ ≤ 1)
    (a b : ℝ) : IntervalIntegrable f volume a b :=
  (intervalIntegrable_const (c := (1 : ℝ))).mono_fun' hf.aestronglyMeasurable
    (Eventually.of_forall hf1)

set_option maxHeartbeats 2000000 in
-- The decomposition of `[0, N]`, the pointwise freezing error and the pigeonhole share one context.
open scoped Classical in
/-- **`patch:energy-core`, step 2: freezing on one of `K` equal intervals.** If the correlation
with a smoothed first input `G` (one-bounded, Lipschitz with constant `Λ` along `e_1`) is at least
`κ N^6`, and `192 u^4 Λ N^{d_1} ≤ κ K`, then on one of the `K` intervals `[a, a + n]`,
`n = N/K`, `a = r n`, freezing `G(x - P_1(t) e_1)` at `t = a` leaves a scalar of modulus at least
`κ N^6 / 2`; that scalar is the frozen correlation `Γ_{k-1}` of `patch:frozen-correlation`. -/
theorem energyCore_freeze {k : ℕ} (hk : 2 ≤ k) {j : ℕ → Fin 3} {c : ℕ} (hc : 1 ≤ c) {δ N : ℝ}
    (hδ0 : 0 < δ) (hN : 1 ≤ N) {P : ℕ → Polynomial ℝ}
    (hadm : ∀ i ∈ Finset.Icc 1 k, AdmissiblePoly c δ N (expo (j i)) (P i))
    {g : ℕ → E3 → ℂ} (hg : ∀ i, Measurable (g i)) (hg1 : ∀ i x, ‖g i x‖ ≤ 1)
    (hgs : ∀ i x, x ∉ petBox (budHi c δ) N → g i x = 0) {G : E3 → ℂ} (hGm : Measurable G)
    (hG1 : ∀ x, ‖G x‖ ≤ 1) {Λ : ℝ} (hΛ : 0 ≤ Λ)
    (hGlip : ∀ x v, ‖G (x + v • basisVec (j 1)) - G x‖ ≤ Λ * |v|) {κ : ℝ}
    (hΓ : κ * N ^ (6 : ℕ) ≤ ‖phaseCorr N k (Function.update g 1
      (fun x => if x ∈ petBox (5 * budHi c δ) N then G x else 0)) P (fun _ => 0) j‖)
    {K : ℕ} (hK : 1 ≤ K) (hKΛ : 192 * budHi c δ ^ 4 * Λ * N ^ expo (j 1) ≤ κ * K) :
    ∃ r : ℕ, r < K ∧ κ / 2 * N ^ (6 : ℕ) ≤ ‖phaseCorr (N / K) (k - 1)
      (frozenIn g G P j (r * (N / K))) (frozenPoly P (r * (N / K))) (fun _ => 0)
      (fun i => j (i + 1))‖ := by
  have hN0 : 0 < N := by linarith
  set u := budHi c δ with hudef
  have hu0 : 0 < u := budHi_pos hδ0 hc
  have hK0 : (0 : ℝ) < K := by exact_mod_cast hK
  set n := N / K with hndef
  have hn0 : 0 < n := div_pos hN0 hK0
  have hNn : N = K * n := by rw [hndef]; field_simp
  set a : ℕ → ℝ := fun r => r * n with hadef
  set d := expo (j 1) with hddef
  have hd3 : d ≤ 3 := Nat.succ_le_of_lt (Fin.is_lt _)
  have h1k : 1 ∈ Finset.Icc 1 k := Finset.mem_Icc.mpr ⟨le_rfl, by omega⟩
  set Hc : E3 → ℂ := fun x => if x ∈ petBox (5 * u) N then G x else 0 with hHcdef
  have hHcm : Measurable Hc := Measurable.ite (measurableSet_petBox _ _) hGm measurable_const
  have hHc1 : ∀ x, ‖Hc x‖ ≤ 1 := fun x => by
    rw [hHcdef]; simp only; split_ifs
    · exact hG1 x
    · simp
  -- the product of the remaining inputs
  set Pr : E3 → ℝ → ℂ := fun x t => ∏ i ∈ Finset.Icc 2 k, g i (x - (P i).eval t • basisVec (j i))
    with hPrdef
  have hPrm : Measurable (Function.uncurry Pr) := by
    refine Finset.measurable_prod _ fun i _ => ?_
    exact (hg i).comp (measurable_fst.sub (((P i).continuous.measurable.comp
      measurable_snd).smul_const _))
  have hPr1 : ∀ x t, ‖Pr x t‖ ≤ 1 := fun x t => by
    rw [hPrdef]; simp only; rw [norm_prod]
    exact Finset.prod_le_one₀ (fun _ _ => norm_nonneg _) fun i _ => hg1 i _
  have hv1m : Measurable fun q : E3 × ℝ => q.1 - (P 1).eval q.2 • basisVec (j 1) :=
    measurable_fst.sub (((P 1).continuous.measurable.comp measurable_snd).smul_const _)
  have hLm : ∀ x, Measurable fun t => Hc (x - (P 1).eval t • basisVec (j 1)) * Pr x t :=
    fun x => by
      have h := ((hHcm.comp hv1m).mul hPrm).comp
        (measurable_const.prodMk measurable_id : Measurable fun t : ℝ => (x, t))
      exact h
  have hPrx : ∀ x, Measurable fun t => Pr x t := fun x => by
    have h := hPrm.comp (measurable_const.prodMk measurable_id : Measurable fun t : ℝ => (x, t))
    exact h
  have hL1 : ∀ x t, ‖Hc (x - (P 1).eval t • basisVec (j 1)) * Pr x t‖ ≤ 1 := fun x t => by
    rw [norm_mul]; exact ((mul_le_of_le_one_left (norm_nonneg _) (hHc1 _)).trans (hPr1 x t))
  -- `Γ` and the frozen scalars as integrals over `x`
  set A : E3 → ℂ := fun x => (N : ℂ)⁻¹ * ∫ t in (0 : ℝ)..N,
    Hc (x - (P 1).eval t • basisVec (j 1)) * Pr x t with hAdef
  set B : ℕ → E3 → ℂ := fun r x => G (x - (P 1).eval (a r) • basisVec (j 1))
    * ((n : ℂ)⁻¹ * ∫ t in a r..a r + n, Pr x t) with hBdef
  have hΓeq : phaseCorr N k (Function.update g 1 Hc) P (fun _ => 0) j = ∫ x, g 0 x * A x := by
    rw [phaseCorr]
    refine integral_congr_ae (Eventually.of_forall fun x => ?_)
    simp only [hAdef]
    rw [Function.update_of_ne (by norm_num : (0 : ℕ) ≠ 1)]
    congr 2
    refine intervalIntegral.integral_congr fun t _ => ?_
    simp only [phaseProd, Polynomial.eval_zero]
    rw [show expPhase (fun s => 2 * Real.pi * 0) t = 1 by simp [expPhase], mul_one]
    have hI : Finset.Icc 1 k = insert 1 (Finset.Icc 2 k) := by
      ext i; simp only [Finset.mem_Icc, Finset.mem_insert]; omega
    rw [hI, Finset.prod_insert (by simp), Function.update_self]
    congr 1
    refine Finset.prod_congr rfl fun i hi => ?_
    rw [Function.update_of_ne (by simp at hi; omega)]
  have hfr : ∀ r, phaseCorr n (k - 1) (frozenIn g G P j (a r)) (frozenPoly P (a r)) (fun _ => 0)
      (fun i => j (i + 1)) = ∫ x, g 0 x * B r x := fun r => by
    rw [phaseCorr_frozen n (by omega) g G P j (a r)]
    refine integral_congr_ae (Eventually.of_forall fun x => ?_)
    simp only [hBdef, hPrdef]; ring
  -- integrability
  have hbox := measurableSet_petBox u N
  have hboxfin : volume (petBox u N) ≠ ⊤ := (isBounded_petBox _ _).measure_lt_top.ne
  have hAm : Measurable A := by
    have hF : Measurable (Function.uncurry fun (x : E3) (t : ℝ) =>
        Hc (x - (P 1).eval t • basisVec (j 1)) * Pr x t) := (hHcm.comp hv1m).mul hPrm
    exact measurable_const.mul (measurable_intervalIntegral_param hF hN0.le)
  have hA1 : ∀ x, ‖A x‖ ≤ 1 := fun x => by
    rw [hAdef]; simp only
    rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hN0.le, inv_mul_le_iff₀ hN0,
      mul_one]
    have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := N) (C := 1)
      (f := fun t => Hc (x - (P 1).eval t • basisVec (j 1)) * Pr x t) fun t _ => by
        rw [norm_mul]; exact ((mul_le_of_le_one_left (norm_nonneg _) (hHc1 _)).trans (hPr1 x t))
    rwa [one_mul, sub_zero, abs_of_pos hN0] at h
  have hBm : ∀ r, Measurable (B r) := fun r => by
    have hG' : Measurable fun x : E3 => G (x - (P 1).eval (a r) • basisVec (j 1)) :=
      hGm.comp (measurable_id.sub_const _)
    exact hG'.mul (measurable_const.mul (measurable_intervalIntegral_param hPrm
      (by linarith : a r ≤ a r + n)))
  have hB1 : ∀ r x, ‖B r x‖ ≤ 1 := fun r x => by
    rw [hBdef]; simp only
    rw [norm_mul]
    refine ((mul_le_of_le_one_left (norm_nonneg _) (hG1 _)).trans ?_)
    rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hn0.le, inv_mul_le_iff₀ hn0,
      mul_one]
    have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := a r) (b := a r + n) (C := 1)
      (f := fun t => Pr x t) fun t _ => hPr1 x t
    rwa [one_mul, add_sub_cancel_left, abs_of_pos hn0] at h
  have hint : ∀ {f : E3 → ℂ}, Measurable f → (∀ x, ‖f x‖ ≤ 1) →
      Integrable fun x => g 0 x * f x := fun {f} hf hf1 =>
    integrable_of_bdd_support_box hu0.le hN0.le ((hg 0).mul hf)
      (fun x => by
        rw [norm_mul]
        exact (mul_le_of_le_one_left (norm_nonneg _) (hg1 0 x)).trans (hf1 x))
      (fun x hx => by rw [hgs 0 x hx, zero_mul])
  -- the pointwise freezing error
  set E := 12 * u * N ^ (d - 1) * n * Λ with hEdef
  have hE0 : 0 ≤ E := by positivity
  have hpt : ∀ x ∈ petBox u N,
      ‖A x - (K : ℂ)⁻¹ * ∑ r ∈ Finset.range K, B r x‖ ≤ E := by
    intro x hx
    have hsplit : ∫ t in (0 : ℝ)..N, Hc (x - (P 1).eval t • basisVec (j 1)) * Pr x t
        = ∑ r ∈ Finset.range K, ∫ t in a r..a r + n,
            Hc (x - (P 1).eval t • basisVec (j 1)) * Pr x t := by
      have h := intervalIntegral.sum_integral_adjacent_intervals (a := a) (n := K)
        (f := fun t => Hc (x - (P 1).eval t • basisVec (j 1)) * Pr x t) (μ := volume)
        (fun r _ => intervalIntegrable_of_norm_le_one (hLm x) (hL1 x) _ _)
      have ha0 : a 0 = 0 := by simp [hadef]
      have haK : a K = N := by simp only [hadef]; rw [hNn]
      rw [ha0, haK] at h
      rw [← h]
      refine Finset.sum_congr rfl fun r _ => ?_
      congr 1
      simp only [hadef]; push_cast; ring
    have hdiff : ∀ r ∈ Finset.range K, ‖(∫ t in a r..a r + n,
        Hc (x - (P 1).eval t • basisVec (j 1)) * Pr x t)
          - G (x - (P 1).eval (a r) • basisVec (j 1)) * ∫ t in a r..a r + n, Pr x t‖
        ≤ E * n := by
      intro r hr
      have hrK : (r : ℝ) + 1 ≤ K := by exact_mod_cast Finset.mem_range.mp hr
      have har0 : 0 ≤ a r := by simp only [hadef]; positivity
      have harN : a r + n ≤ N := by
        simp only [hadef]; rw [hNn]; nlinarith
      have hGPm : Measurable fun t => G (x - (P 1).eval (a r) • basisVec (j 1)) * Pr x t :=
        measurable_const.mul (hPrx x)
      have hGP1 : ∀ t, ‖G (x - (P 1).eval (a r) • basisVec (j 1)) * Pr x t‖ ≤ 1 := fun t => by
        rw [norm_mul]; exact ((mul_le_of_le_one_left (norm_nonneg _) (hG1 _)).trans (hPr1 x t))
      rw [← intervalIntegral.integral_const_mul, ← intervalIntegral.integral_sub
        (intervalIntegrable_of_norm_le_one (hLm x) (hL1 x) _ _)
        (intervalIntegrable_of_norm_le_one hGPm hGP1 _ _)]
      have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := a r) (b := a r + n)
        (C := E) (f := fun t => Hc (x - (P 1).eval t • basisVec (j 1)) * Pr x t
          - G (x - (P 1).eval (a r) • basisVec (j 1)) * Pr x t) fun t ht => by
        rw [Set.uIoc_of_le (by linarith)] at ht
        have ht' : t ∈ Set.Icc 0 N := ⟨by linarith [ht.1], by linarith [ht.2]⟩
        have har' : a r ∈ Set.Icc 0 N := ⟨har0, by linarith⟩
        have hmem : x - (P 1).eval t • basisVec (j 1) ∈ petBox (5 * u) N :=
          sub_eval_smul_mem_petBox hN hδ0 hc (hadm 1 h1k) hx ht'
        simp only [hHcdef, ite_eq_left hmem]
        rw [← sub_mul, norm_mul]
        refine le_trans (mul_le_of_le_one_right (norm_nonneg _) (hPr1 x t)) ?_
        have e : x - (P 1).eval t • basisVec (j 1)
            = (x - (P 1).eval (a r) • basisVec (j 1))
              + ((P 1).eval (a r) - (P 1).eval t) • basisVec (j 1) := by
          rw [sub_smul]; abel
        rw [e]
        refine (hGlip _ _).trans ?_
        have hinc := abs_eval_sub_le_of_admissible hN hd3 (hadm 1 h1k) hc hδ0 har' ht'
        have htr : |a r - t| ≤ n := by
          rw [abs_sub_comm, abs_of_nonneg (by linarith [ht.1])]; linarith [ht.2]
        calc Λ * |(P 1).eval (a r) - (P 1).eval t|
            ≤ Λ * (12 * u * N ^ (d - 1) * |a r - t|) := mul_le_mul_of_nonneg_left hinc hΛ
          _ ≤ Λ * (12 * u * N ^ (d - 1) * n) := by gcongr
          _ = E := by rw [hEdef]; ring
      rwa [add_sub_cancel_left, abs_of_pos hn0] at h
    simp only [hAdef, hBdef]
    rw [hsplit]
    have hNK : (N : ℂ)⁻¹ = (K : ℂ)⁻¹ * (n : ℂ)⁻¹ := by
      rw [hNn]; push_cast; rw [mul_inv]
    rw [hNK, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib]
    have hterm : ∀ r ∈ Finset.range K, ‖(K : ℂ)⁻¹ * (n : ℂ)⁻¹ * (∫ t in a r..a r + n,
        Hc (x - (P 1).eval t • basisVec (j 1)) * Pr x t)
        - (K : ℂ)⁻¹ * (G (x - (P 1).eval (a r) • basisVec (j 1))
          * ((n : ℂ)⁻¹ * ∫ t in a r..a r + n, Pr x t))‖ ≤ E / K := by
      intro r hr
      have e : (K : ℂ)⁻¹ * (n : ℂ)⁻¹ * (∫ t in a r..a r + n,
          Hc (x - (P 1).eval t • basisVec (j 1)) * Pr x t)
          - (K : ℂ)⁻¹ * (G (x - (P 1).eval (a r) • basisVec (j 1))
            * ((n : ℂ)⁻¹ * ∫ t in a r..a r + n, Pr x t))
          = (K : ℂ)⁻¹ * (n : ℂ)⁻¹ * ((∫ t in a r..a r + n,
            Hc (x - (P 1).eval t • basisVec (j 1)) * Pr x t)
            - G (x - (P 1).eval (a r) • basisVec (j 1)) * ∫ t in a r..a r + n, Pr x t) := by
        ring
      rw [e, norm_mul, norm_mul, norm_inv, norm_inv, Complex.norm_natCast, Complex.norm_real,
        Real.norm_of_nonneg hn0.le]
      calc (K : ℝ)⁻¹ * n⁻¹ * ‖(∫ t in a r..a r + n,
            Hc (x - (P 1).eval t • basisVec (j 1)) * Pr x t)
            - G (x - (P 1).eval (a r) • basisVec (j 1)) * ∫ t in a r..a r + n, Pr x t‖
          ≤ (K : ℝ)⁻¹ * n⁻¹ * (E * n) :=
            mul_le_mul_of_nonneg_left (hdiff r hr) (by positivity)
        _ = E / K := by field_simp
    refine (norm_sum_le _ _).trans ((Finset.sum_le_sum hterm).trans (le_of_eq ?_))
    rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    field_simp
  -- integrate the error
  have hdiffint : ‖(∫ x, g 0 x * A x) - (K : ℂ)⁻¹ * ∑ r ∈ Finset.range K, ∫ x, g 0 x * B r x‖
      ≤ 8 * u ^ 3 * N ^ 6 * E := by
    have e : (∫ x, g 0 x * A x) - (K : ℂ)⁻¹ * ∑ r ∈ Finset.range K, ∫ x, g 0 x * B r x
        = ∫ x, g 0 x * (A x - (K : ℂ)⁻¹ * ∑ r ∈ Finset.range K, B r x) := by
      rw [← integral_finsetSum _ fun r _ => hint (hBm r) (hB1 r), ← integral_const_mul,
        ← integral_sub (hint hAm hA1)
          ((integrable_finsetSum _ fun r _ => hint (hBm r) (hB1 r)).const_mul _)]
      refine integral_congr_ae (Eventually.of_forall fun x => ?_)
      simp only [Finset.mul_sum]
      rw [mul_sub, Finset.mul_sum]
      congr 1
      refine Finset.sum_congr rfl fun r _ => ?_
      ring
    rw [e]
    have hind : Integrable ((petBox u N).indicator fun _ => E) :=
      (integrableOn_const (C := E) hboxfin).integrable_indicator hbox
    refine (norm_integral_le_of_norm_le hind (Eventually.of_forall fun x => ?_)).trans
      (le_of_eq ?_)
    · by_cases hx : x ∈ petBox u N
      · rw [Set.indicator_of_mem hx, norm_mul]
        exact (mul_le_of_le_one_left (norm_nonneg _) (hg1 0 x)).trans (hpt x hx)
      · rw [Set.indicator_of_notMem hx, hgs 0 x hx, zero_mul, norm_zero]
    · rw [integral_indicator_const _ hbox, smul_eq_mul, measureReal_def,
        volume_petBox hu0.le hN0.le, ENNReal.toReal_ofReal (by positivity)]
  -- the error is at most `κ N^6 / 2`
  have hEb : 8 * u ^ 3 * N ^ 6 * E ≤ κ / 2 * N ^ (6 : ℕ) := by
    have hNd : N ^ (d - 1) * n = N ^ d / K := by
      rcases Nat.eq_zero_or_pos d with h0 | h0
      · exact absurd h0 (Nat.pos_iff_ne_zero.mp (expo_pos _))
      · rw [hndef, ← pow_sub_one_mul (by omega : d ≠ 0) N]; field_simp
    have : 8 * u ^ 3 * N ^ 6 * E = 96 * u ^ 4 * Λ * N ^ d / K * N ^ 6 := by
      rw [hEdef]
      calc 8 * u ^ 3 * N ^ 6 * (12 * u * N ^ (d - 1) * n * Λ)
          = 96 * u ^ 4 * Λ * (N ^ (d - 1) * n) * N ^ 6 := by ring
        _ = _ := by rw [hNd]; ring
    rw [this]
    have hK' : 96 * u ^ 4 * Λ * N ^ d / K ≤ κ / 2 := by
      rw [div_le_iff₀ hK0]; linarith
    exact mul_le_mul_of_nonneg_right hK' (by positivity)
  -- pigeonhole
  rw [hΓeq] at hΓ
  have hsum : κ / 2 * N ^ (6 : ℕ)
      ≤ ‖(K : ℂ)⁻¹ * ∑ r ∈ Finset.range K, ∫ x, g 0 x * B r x‖ := by
    have := norm_sub_norm_le (∫ x, g 0 x * A x)
      ((K : ℂ)⁻¹ * ∑ r ∈ Finset.range K, ∫ x, g 0 x * B r x)
    linarith
  by_contra hcon
  push Not at hcon
  have hlt : ∀ r ∈ Finset.range K, ‖∫ x, g 0 x * B r x‖ < κ / 2 * N ^ (6 : ℕ) := fun r hr => by
    have := hcon r (Finset.mem_range.mp hr)
    rwa [hfr r] at this
  have hne : (Finset.range K).Nonempty := ⟨0, Finset.mem_range.mpr (by omega)⟩
  have h1 : ‖∑ r ∈ Finset.range K, ∫ x, g 0 x * B r x‖ < K * (κ / 2 * N ^ (6 : ℕ)) := by
    calc ‖∑ r ∈ Finset.range K, ∫ x, g 0 x * B r x‖
        ≤ ∑ r ∈ Finset.range K, ‖∫ x, g 0 x * B r x‖ := norm_sum_le _ _
      _ < ∑ _r ∈ Finset.range K, κ / 2 * N ^ (6 : ℕ) := Finset.sum_lt_sum_of_nonempty hne hlt
      _ = K * (κ / 2 * N ^ (6 : ℕ)) := by rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  rw [norm_mul, norm_inv, Complex.norm_natCast] at hsum
  have : (K : ℝ)⁻¹ * ‖∑ r ∈ Finset.range K, ∫ x, g 0 x * B r x‖ < κ / 2 * N ^ (6 : ℕ) := by
    rw [inv_mul_lt_iff₀ hK0]; exact h1
  linarith

end

/-! ### `patch:energy-core`, step 3: the lower-dimensional polynomial family -/

section
open Filter Topology MeasureTheory

/-- Every coefficient of an admissible polynomial is bounded by `u_c(δ) N^{d-s}`. -/
theorem abs_coeff_le_of_admissible {c : ℕ} {δ N : ℝ} {d : ℕ} {P : Polynomial ℝ}
    (hP : AdmissiblePoly c δ N d P) {s : ℕ} (hs : s ≤ d) :
    |P.coeff s| ≤ budHi c δ * N ^ (d - s) := by
  obtain ⟨hdeg, _, hlc, hco⟩ := hP
  rcases eq_or_lt_of_le hs with h | h
  · subst h
    rw [Nat.sub_self, pow_zero, mul_one,
      show P.coeff s = P.leadingCoeff by rw [Polynomial.leadingCoeff, hdeg]]
    exact hlc
  · exact hco s h

/-- **The binomial formula for the frozen polynomials**: the Taylor shift by `a ∈ [0, N]` of an
admissible polynomial of degree `d ≤ 3` has coefficients bounded by `32 u_c(δ) N^{d-r}`. -/
theorem abs_coeff_taylor_le {c : ℕ} {δ N : ℝ} (hN : 1 ≤ N) {d : ℕ} (hd : d ≤ 3)
    {P : Polynomial ℝ} (hP : AdmissiblePoly c δ N d P) (hc : 1 ≤ c) (hδ0 : 0 < δ) {a : ℝ}
    (ha : a ∈ Set.Icc 0 N) {r : ℕ} (hr : r ≤ d) :
    |(Polynomial.taylor a P).coeff r| ≤ 32 * budHi c δ * N ^ (d - r) := by
  have hN0 : 0 ≤ N := by linarith
  have hu := (budHi_pos hδ0 hc).le
  have hdeg := hP.natDegree_eq
  rw [Polynomial.taylor_coeff]
  have hlt : (Polynomial.hasseDeriv r P).natDegree < d - r + 1 := by
    have := Polynomial.natDegree_hasseDeriv_le P r
    rw [hdeg] at this; omega
  rw [Polynomial.eval_eq_sum_range' hlt]
  have hterm : ∀ m ∈ Finset.range (d - r + 1),
      |(Polynomial.hasseDeriv r P).coeff m * a ^ m| ≤ 8 * budHi c δ * N ^ (d - r) := by
    intro m hm
    have hm' : m + r ≤ d := by have := Finset.mem_range.mp hm; omega
    rw [Polynomial.hasseDeriv_coeff, abs_mul, abs_mul]
    have hch : |((m + r).choose r : ℝ)| ≤ 8 := by
      rw [abs_of_nonneg (by positivity)]
      have h1 : (m + r).choose r ≤ 2 ^ (m + r) := Nat.choose_le_two_pow _ _
      have h2 : 2 ^ (m + r) ≤ 2 ^ 3 := Nat.pow_le_pow_right (by norm_num) (hm'.trans hd)
      exact_mod_cast h1.trans h2
    have hco := abs_coeff_le_of_admissible hP hm'
    have ham : |a ^ m| ≤ N ^ m := by
      rw [abs_of_nonneg (pow_nonneg ha.1 m)]; exact pow_le_pow_left₀ ha.1 ha.2 m
    have hexp : N ^ (d - (m + r)) * N ^ m = N ^ (d - r) := by
      rw [← pow_add]; congr 1; omega
    calc |((m + r).choose r : ℝ)| * |P.coeff (m + r)| * |a ^ m|
        ≤ 8 * (budHi c δ * N ^ (d - (m + r))) * N ^ m := by
          gcongr
      _ = 8 * budHi c δ * N ^ (d - r) := by rw [← hexp]; ring
  refine (Finset.abs_sum_le_sum_abs _ _).trans ((Finset.sum_le_sum hterm).trans ?_)
  rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  have h4 : ((d - r + 1 : ℕ) : ℝ) ≤ 4 := by exact_mod_cast (by omega : d - r + 1 ≤ 4)
  have : 0 ≤ 8 * budHi c δ * N ^ (d - r) := by positivity
  nlinarith

/-- A point of the box moved by an admissible polynomial of `t ∈ [0, N]` stays in the box enlarged
by `5` (the translation in the positive direction). -/
theorem add_eval_smul_mem_petBox {N : ℝ} (hN : 1 ≤ N) {δ : ℝ} (hδ0 : 0 < δ) {c : ℕ} (hc : 1 ≤ c)
    {m : Fin 3} {Q : Polynomial ℝ} (hQ : AdmissiblePoly c δ N (expo m) Q) {x : E3}
    (hx : x ∈ petBox (budHi c δ) N) {t : ℝ} (ht : t ∈ Set.Icc 0 N) :
    x + Q.eval t • basisVec m ∈ petBox (5 * budHi c δ) N := by
  have hN0 : 0 < N := by linarith
  have hu := budHi_pos hδ0 hc
  have hP : |Q.eval t| ≤ 4 * budHi c δ * N ^ expo m :=
    abs_eval_le_of_admissible hN (Nat.succ_le_of_lt (Fin.is_lt _)) hQ hc hδ0 ht
  intro i
  have hi := hx i
  have hNi : 0 ≤ N ^ expo i := pow_nonneg hN0.le _
  by_cases hij : i = m
  · subst hij
    simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, basisVec_apply_self, mul_one]
    have := abs_le.mp hP
    have hp := mul_pos hu (pow_pos hN0 (expo i))
    constructor <;> nlinarith [hi.1, hi.2]
  · simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, basisVec_apply_ne hij, mul_zero,
      add_zero]
    have hp := mul_pos hu (pow_pos hN0 (expo i))
    constructor <;> nlinarith [hi.1, hi.2]

/-- The box at scale `N` lies in the box at scale `N / K` with the budget multiplied by `K_b^3`. -/
theorem petBox_subset_scale {C N : ℝ} (hC : 0 ≤ C) (hN : 0 ≤ N) {K : ℕ} (hK : 1 ≤ K) {Kb : ℝ}
    (hKb : (K : ℝ) ≤ Kb) : petBox C N ⊆ petBox (C * Kb ^ 3) (N / K) := by
  intro x hx i
  have hK1 : (1 : ℝ) ≤ K := by exact_mod_cast hK
  have hK0 : (0 : ℝ) < K := by linarith
  have hi := hx i
  have hd : expo i ≤ 3 := Nat.succ_le_of_lt (Fin.is_lt _)
  have e : N ^ expo i = (K : ℝ) ^ expo i * (N / K) ^ expo i := by
    rw [← mul_pow]; congr 1; field_simp
  have hKd : (K : ℝ) ^ expo i ≤ Kb ^ 3 :=
    (pow_le_pow_right₀ hK1 hd).trans (pow_le_pow_left₀ (by linarith) hKb 3)
  have hnd : 0 ≤ (N / K) ^ expo i := by positivity
  have hb : C * N ^ expo i ≤ C * Kb ^ 3 * (N / K) ^ expo i := by
    rw [e, ← mul_assoc]
    exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hKd hC) hnd
  exact ⟨by linarith [hi.1], by linarith [hi.2]⟩

/-- The correlation `Γ_m` depends only on the inputs `0, …, m`. -/
theorem phaseCorr_congr_inputs {N : ℝ} {m : ℕ} {f f' : ℕ → E3 → ℂ} (h : ∀ i ≤ m, f i = f' i)
    (P : ℕ → Polynomial ℝ) (p : E3 → Polynomial ℝ) (j : ℕ → Fin 3) :
    phaseCorr N m f P p j = phaseCorr N m f' P p j := by
  simp only [phaseCorr, phaseProd, h 0 (Nat.zero_le _)]
  refine integral_congr_ae (Eventually.of_forall fun x => ?_)
  simp only
  congr 2
  refine intervalIntegral.integral_congr fun t _ => ?_
  congr 1
  exact Finset.prod_congr rfl fun i hi => by rw [h i (Finset.mem_Icc.mp hi).2]

/-- The frozen inputs cut off above `k - 1` (the correlation `Γ_{k-1}` does not see them). -/
noncomputable def frozenCut (k : ℕ) (g : ℕ → E3 → ℂ) (G : E3 → ℂ) (P : ℕ → Polynomial ℝ)
    (j : ℕ → Fin 3) (a : ℝ) : ℕ → E3 → ℂ :=
  fun i x => if i ≤ k - 1 then frozenIn g G P j a i x else 0

theorem phaseCorr_frozenCut (n : ℝ) (k : ℕ) (g : ℕ → E3 → ℂ) (G : E3 → ℂ)
    (P : ℕ → Polynomial ℝ) (j : ℕ → Fin 3) (a : ℝ) (Q : ℕ → Polynomial ℝ)
    (p : E3 → Polynomial ℝ) (j' : ℕ → Fin 3) :
    phaseCorr n (k - 1) (frozenCut k g G P j a) Q p j'
      = phaseCorr n (k - 1) (frozenIn g G P j a) Q p j' :=
  phaseCorr_congr_inputs (fun i hi => by funext x; simp [frozenCut, hi]) Q p j'

/-- **`patch:energy-core`, step 3: the lower-dimensional polynomial family.** For `a ∈ [0, N]`,
`n = N/K` with `1 ≤ K ≤ K_b`, and a budget `c' ≥ c` with `32 u_c(δ) K_b^3 ≤ u_{c'}(δ)`, the frozen
polynomials `Q_i(u) = P_{i+1}(a + u) - P_{i+1}(a)` are admissible at scale `n` with budget `c'`
(same degrees and leading coefficients, binomial bounds for the rest, no constant term), and the
frozen inputs (cut off above `k - 1`) are measurable, one-bounded and supported in the budget-`c'`
box at scale `n`. -/
theorem energyCore_frozen {k : ℕ} (hk : 2 ≤ k) {j : ℕ → Fin 3} {c : ℕ} (hc : 1 ≤ c) {δ N : ℝ}
    (hδ0 : 0 < δ) (hδ1 : δ ≤ 1) (hN : 1 ≤ N) {P : ℕ → Polynomial ℝ}
    (hadm : ∀ i ∈ Finset.Icc 1 k, AdmissiblePoly c δ N (expo (j i)) (P i))
    {g : ℕ → E3 → ℂ} (hg : ∀ i, Measurable (g i)) (hg1 : ∀ i x, ‖g i x‖ ≤ 1)
    (hgs : ∀ i x, x ∉ petBox (budHi c δ) N → g i x = 0) {G : E3 → ℂ} (hGm : Measurable G)
    (hG1 : ∀ x, ‖G x‖ ≤ 1) {K : ℕ} (hK : 1 ≤ K) {Kb : ℝ} (hKb : (K : ℝ) ≤ Kb) {c' : ℕ}
    (hcc' : c ≤ c') (hc'b : 32 * budHi c δ * Kb ^ 3 ≤ budHi c' δ) {a : ℝ}
    (ha : a ∈ Set.Icc 0 N) :
    (∀ i ∈ Finset.Icc 1 (k - 1),
        AdmissiblePoly c' δ (N / K) (expo (j (i + 1))) (frozenPoly P a i)) ∧
      (∀ i, Measurable (frozenCut k g G P j a i)) ∧ (∀ i x, ‖frozenCut k g G P j a i x‖ ≤ 1) ∧
      (∀ i x, x ∉ petBox (budHi c' δ) (N / K) → frozenCut k g G P j a i x = 0) := by
  have hN0 : 0 < N := by linarith
  set u := budHi c δ with hudef
  have hu0 : 0 < u := budHi_pos hδ0 hc
  have hK1 : (1 : ℝ) ≤ K := by exact_mod_cast hK
  have hK0 : (0 : ℝ) < K := by linarith
  have hKb1 : 1 ≤ Kb := hK1.trans hKb
  set n := N / K with hndef
  have hn0 : 0 < n := div_pos hN0 hK0
  have hNn : N = K * n := by rw [hndef]; field_simp
  refine ⟨fun i hi => ?_, fun i => ?_, fun i x => ?_, fun i x hx => ?_⟩
  · -- admissibility at scale `n`
    have hi' : i + 1 ∈ Finset.Icc 1 k := by rw [Finset.mem_Icc] at hi ⊢; omega
    have hP := hadm (i + 1) hi'
    set d := expo (j (i + 1)) with hddef
    have hd3 : d ≤ 3 := Nat.succ_le_of_lt (Fin.is_lt _)
    have hd1 : 1 ≤ d := expo_pos _
    have hQ : frozenPoly P a i = Polynomial.taylor a (P (i + 1))
        - Polynomial.C ((P (i + 1)).eval a) := by
      rw [frozenPoly, Polynomial.taylor_apply]
    have hdegQ : (frozenPoly P a i).natDegree = d := by
      rw [hQ, Polynomial.natDegree_sub_C, Polynomial.natDegree_taylor, hP.natDegree_eq]
    have hcoeff : ∀ r, (frozenPoly P a i).coeff r
        = if r = 0 then 0 else (Polynomial.taylor a (P (i + 1))).coeff r := by
      intro r
      rw [hQ, Polynomial.coeff_sub, Polynomial.coeff_C]
      split_ifs with h
      · subst h; rw [Polynomial.taylor_coeff_zero, sub_self]
      · rw [sub_zero]
    have hlc : (frozenPoly P a i).leadingCoeff = (P (i + 1)).leadingCoeff := by
      rw [Polynomial.leadingCoeff, hdegQ, hcoeff, ite_eq_right (by omega),
        ← hP.natDegree_eq, ← Polynomial.natDegree_taylor (P (i + 1)) a]
      exact leadingCoeff_taylor (P (i + 1)) a
    obtain ⟨_, hlo, hhi, _⟩ := hP
    refine ⟨hdegQ, ?_, ?_, fun r hr => ?_⟩
    · rw [hlc]; exact (budLo_antitone hδ0 hδ1 hc hcc').trans hlo
    · rw [hlc]; exact hhi.trans (budHi_monotone hδ0 hδ1 hc hcc')
    · rw [hcoeff]
      split_ifs with h0
      · rw [abs_zero]; exact mul_nonneg (budHi_pos hδ0 (le_trans hc hcc')).le (by positivity)
      · have hb := abs_coeff_taylor_le hN hd3 (hadm (i + 1) hi') hc hδ0 ha hr.le
        refine hb.trans ?_
        have e : N ^ (d - r) = (K : ℝ) ^ (d - r) * n ^ (d - r) := by rw [hNn, mul_pow]
        have hKd : (K : ℝ) ^ (d - r) ≤ Kb ^ 3 :=
          (pow_le_pow_right₀ hK1 (by omega)).trans (pow_le_pow_left₀ (by linarith) hKb 3)
        rw [e]
        calc 32 * u * ((K : ℝ) ^ (d - r) * n ^ (d - r))
            ≤ 32 * u * (Kb ^ 3 * n ^ (d - r)) := by gcongr
          _ = 32 * u * Kb ^ 3 * n ^ (d - r) := by ring
          _ ≤ budHi c' δ * n ^ (d - r) := by gcongr
  · -- measurability
    unfold frozenCut frozenIn
    by_cases hik : i ≤ k - 1
    · simp only [hik, ite_true]
      by_cases hi : i = 0
      · simp only [hi, ite_true]
        exact (hg 0).mul (hGm.comp (measurable_id.sub_const _))
      · simp only [hi, ite_false]
        exact (hg (i + 1)).comp (measurable_id.sub_const _)
    · simp only [hik, ite_false]; exact measurable_const
  · -- bounds
    unfold frozenCut frozenIn
    split_ifs
    · rw [norm_mul]; exact ((mul_le_of_le_one_left (norm_nonneg _) (hg1 0 x)).trans (hG1 _))
    · exact hg1 _ _
    · simp
  · -- supports
    have hsc : petBox (5 * u) N ⊆ petBox (budHi c' δ) n := by
      refine (petBox_subset_scale (by positivity) hN0.le hK hKb).trans
        (petBox_mono ?_ hn0.le)
      have : 1 ≤ Kb ^ 3 := one_le_pow₀ hKb1
      nlinarith
    have hbox1 : petBox u N ⊆ petBox (5 * u) N := petBox_mono (by linarith) hN0.le
    unfold frozenCut frozenIn
    split_ifs with hik hi
    · rw [hgs 0 x fun h => hx (hsc (hbox1 h)), zero_mul]
    · refine hgs (i + 1) _ fun h => hx (hsc ?_)
      have hi' : i + 1 ∈ Finset.Icc 1 k := by rw [Finset.mem_Icc]; omega
      have := add_eval_smul_mem_petBox hN hδ0 hc (hadm (i + 1) hi') h ha
      rwa [sub_add_cancel] at this
    · rfl

end

/-! ### `patch:energy-core`, steps 4-5 and the theorem -/

section
open Filter Topology MeasureTheory

/-- Translation does not change the modulus of the Fourier transform. -/
theorem norm_fourier_comp_sub (f : E3 → ℂ) (v ξ : E3) :
    ‖𝓕 (fun x => f (x - v)) ξ‖ = ‖𝓕 f ξ‖ := by
  rw [fourier_comp_sub, Circle.smul_def, smul_eq_mul, norm_mul, Circle.norm_coe, one_mul]

/-- Enlarging the cutoff radius by a factor at least two only increases the positive energy. -/
theorem energy_raise {f : E3 → ℂ} (hfi : Integrable f) (hf2 : MemLp f 2) (j₀ : Fin 3)
    {L L' lo : ℝ} (hL : 0 < L) (hLL : 2 * L ≤ L')
    (hlo : lo ≤ ∫ ξ, eta (ξ j₀ / L) * ‖𝓕 f ξ‖ ^ 2) :
    lo ≤ ∫ ξ, eta (ξ j₀ / L') * ‖𝓕 f ξ‖ ^ 2 :=
  hlo.trans (integral_eta_mul_norm_sq_mono hL hLL j₀ hfi hf2)

/-- The frozen input `i - 1` is the translate `g_i(· - P_i(a) e_i)`. -/
theorem frozenCut_pred {k i : ℕ} (hi : i ∈ Finset.Icc 2 k) (g : ℕ → E3 → ℂ) (G : E3 → ℂ)
    (P : ℕ → Polynomial ℝ) (j : ℕ → Fin 3) (a : ℝ) :
    frozenCut k g G P j a (i - 1) = fun x => g i (x - (P i).eval a • basisVec (j i)) := by
  rw [Finset.mem_Icc] at hi
  funext x
  have h1 : i - 1 ≤ k - 1 := by omega
  have h2 : i - 1 ≠ 0 := by omega
  have h3 : i - 1 + 1 = i := by omega
  simp only [frozenCut, frozenIn, h1, h2, ite_true, ite_false, h3]

set_option maxHeartbeats 4000000 in
-- The induction on the number of inputs and all budget choices share one context.
/-- **Theorem `patch:energy-core` (every-input positive energy, independently proved).** Fix an
increasing degree list `d_1 < ⋯ < d_k` (the degrees of the directions `j i`) and an input budget
`c ≥ 1`. There is `C ≥ c` such that for `0 < δ ≤ 1`, `N ≥ u_C(δ)`, admissible `P_i`, and
one-bounded Borel `g_0, …, g_k` supported in the budget-`c` box, a lower bound
`|Γ_k(g_0; g_1, …, g_k)| ≥ ℓ_c(δ) N^6` gives, for every `j ∈ {1, …, k}`,
`⟨g_j, P_{L_j}^{(j)} g_j⟩ = ∫ η(ξ_j / L_j) |ĝ_j|² ≥ ℓ_C(δ) N^6` at `L_j = u_C(δ) N^{-d_j}`.
Induction on `k`: `patch:lowest-energy` for `j = 1`; otherwise steps 1-3 (`Auto.energyCore_step1`,
`Auto.energyCore_freeze`, `Auto.energyCore_frozen`), then the induction hypothesis on the frozen
correlation `Γ_{k-1}` on `ℝ³` (step 4 needs no section selection there, the coordinate `x_1` being
passive), and translation invariance of the energy (step 5). -/
theorem energyCore : ∀ k : ℕ, 1 ≤ k → ∀ j : ℕ → Fin 3,
    (∀ u v, 1 ≤ u → u < v → v ≤ k → expo (j u) < expo (j v)) → ∀ c : ℕ, 1 ≤ c →
    ∃ C : ℕ, c ≤ C ∧ ∀ δ N : ℝ, 0 < δ → δ ≤ 1 → budHi C δ ≤ N →
      ∀ (P : ℕ → Polynomial ℝ) (g : ℕ → E3 → ℂ),
        (∀ i ∈ Finset.Icc 1 k, AdmissiblePoly c δ N (expo (j i)) (P i)) →
        (∀ i, Measurable (g i)) → (∀ i y, ‖g i y‖ ≤ 1) →
        (∀ i y, y ∉ petBox (budHi c δ) N → g i y = 0) →
        budLo c δ * N ^ (6 : ℕ) ≤ ‖phaseCorr N k g P (fun _ => 0) j‖ →
        ∀ i ∈ Finset.Icc 1 k, budLo C δ * N ^ (6 : ℕ)
          ≤ ∫ ξ, eta (ξ (j i) / (budHi C δ * (N ^ expo (j i))⁻¹)) * ‖𝓕 (g i) ξ‖ ^ 2 := by
  intro k hk
  induction k, hk using Nat.le_induction with
  | base =>
    intro j hjm c hc
    obtain ⟨Cle, hCle, hLE⟩ := lowestEnergy hjm le_rfl hc
    set C := max c (2 * Cle) with hCdef
    refine ⟨C, le_max_left _ _, ?_⟩
    intro δ N hδ0 hδ1 hNC P g hadm hg hg1 hgs hcorr i hi
    have hC : 1 ≤ C := le_trans hc (le_max_left _ _)
    have hN : 1 ≤ N := (one_le_budHi hδ0 hδ1 hC).trans hNC
    have hN0 : 0 < N := by linarith
    have hi1 : i = 1 := by simp at hi; omega
    subst hi1
    have h := hLE δ N hδ0 hδ1 hN P g (fun _ _ => 0) (fun _ => 0) hadm hg hg1 hgs
      (fun _ => measurable_const) (by rw [maPhase_empty]; exact hcorr)
    obtain ⟨hfi, hf2⟩ := integrable_memLp_of_box (hg 1) (hg1 1) (budHi_pos hδ0 hc).le hN0.le
      (hgs 1)
    have hNd : 0 < N ^ expo (j 1) := pow_pos hN0 _
    have h2C : 2 * budHi Cle δ ≤ budHi C δ := by
      have h := budHi_mul_le hδ0 hδ1 hCle (k := 2) (by norm_num)
      push_cast at h
      exact h.trans (budHi_monotone hδ0 hδ1 (by omega) (le_max_right _ _))
    refine energy_raise hfi hf2 (j 1) (by have := budHi_pos hδ0 hCle; positivity) ?_
      (le_trans (mul_le_mul_of_nonneg_right (budLo_antitone hδ0 hδ1 hCle
        (le_trans (by omega) (le_max_right _ _))) (by positivity)) h)
    rw [← mul_assoc]
    exact mul_le_mul_of_nonneg_right h2C (by positivity)
  | succ k hk ih =>
    intro j hjm c hc
    have hjm' : ∀ u v, 1 ≤ u → u < v → v ≤ k → expo (j (u + 1)) < expo (j (v + 1)) :=
      fun u v hu huv hv => hjm (u + 1) (v + 1) (by omega) (by omega) (by omega)
    obtain ⟨Cle, hCle, hLE⟩ := lowestEnergy hjm (by omega) hc
    obtain ⟨C1, hC1, hS1⟩ := energyCore_step1 hjm (by omega) hc
    have hHic := monoHigh_budHi hc
    have hKf : MonoHigh fun δ => 192 * budHi c δ ^ 4 * budHi C1 δ / budLo C1 δ :=
      (((monoHigh_const (by norm_num : (0 : ℝ) < 192)).mul (hHic.pow 4)).mul
        (monoHigh_budHi hC1)).div (monoLow_budLo hC1)
    set KbF : ℝ → ℝ := fun δ => 192 * budHi c δ ^ 4 * budHi C1 δ / budLo C1 δ + 2 with hKbFdef
    have hKb : MonoHigh KbF := hKf.add_const (by norm_num)
    obtain ⟨cH, hcH, hcHb⟩ :=
      (((monoHigh_const (by norm_num : (0 : ℝ) < 32)).mul hHic).mul (hKb.pow 3)).exists_budHi
    obtain ⟨cL, hcL, hcLb⟩ := ((monoLow_budLo hC1).div_const two_pos).exists_budLo
    set c'' := max c (max cH cL) with hc''def
    have hc'' : 1 ≤ c'' := le_trans hc (le_max_left _ _)
    have hcc'' : c ≤ c'' := le_max_left _ _
    obtain ⟨C'', hc''C'', hIH⟩ := ih (fun i => j (i + 1)) hjm' c'' hc''
    have hC'' : 1 ≤ C'' := le_trans hc'' hc''C''
    have hHi'' := monoHigh_budHi hC''
    obtain ⟨Ch, hCh, hChb⟩ := (((hKb.mul hHi'').add
      (((monoHigh_const (by norm_num : (0 : ℝ) < 2)).mul hHi'').mul (hKb.pow 3))).add
      ((monoHigh_const (by norm_num : (0 : ℝ) < 2)).mul (monoHigh_budHi hCle))).exists_budHi
    obtain ⟨Cl, hCl, hClb⟩ := ((monoLow_budLo hC'').div (hKb.pow 6)).exists_budLo
    set C := max c (max Ch (max Cl Cle)) with hCdef
    refine ⟨C, le_max_left _ _, ?_⟩
    intro δ N hδ0 hδ1 hNC P g hadm hg hg1 hgs hcorr i hi
    have hC : 1 ≤ C := le_trans hc (le_max_left _ _)
    have hN : 1 ≤ N := (one_le_budHi hδ0 hδ1 hC).trans hNC
    have hN0 : 0 < N := by linarith
    set u := budHi c δ with hudef
    have hu0 : 0 < u := budHi_pos hδ0 hc
    have hChC : budHi Ch δ ≤ budHi C δ :=
      budHi_monotone hδ0 hδ1 hCh (le_trans (le_max_left _ _) (le_max_right _ _))
    have hFb := (hChb δ hδ0 hδ1).trans hChC
    have hKb1 : 2 ≤ KbF δ := by
      have : 0 ≤ 192 * budHi c δ ^ 4 * budHi C1 δ / budLo C1 δ := by
        have := budHi_pos hδ0 hC1; have := budLo_pos hδ0 hC1; positivity
      simp only [hKbFdef]; linarith
    have hB'' := budHi_pos hδ0 hC''
    have hBle := budHi_pos hδ0 hCle
    have hKb3 : 1 ≤ KbF δ ^ 3 := one_le_pow₀ (by linarith)
    by_cases hi1 : i = 1
    · -- the first input: `patch:lowest-energy`
      subst hi1
      have h := hLE δ N hδ0 hδ1 hN P g (fun _ _ => 0) (fun _ => 0) hadm hg hg1 hgs
        (fun _ => measurable_const) (by rw [maPhase_empty]; exact hcorr)
      obtain ⟨hfi, hf2⟩ := integrable_memLp_of_box (hg 1) (hg1 1) hu0.le hN0.le (hgs 1)
      have hNd : 0 < N ^ expo (j 1) := pow_pos hN0 _
      have h2C : 2 * budHi Cle δ ≤ budHi C δ := by
        refine le_trans ?_ hFb
        have : 0 ≤ KbF δ * budHi C'' δ + 2 * budHi C'' δ * KbF δ ^ 3 := by positivity
        linarith
      refine energy_raise hfi hf2 (j 1) (by positivity) ?_
        (le_trans (mul_le_mul_of_nonneg_right (budLo_antitone hδ0 hδ1 hCle
          (le_trans (le_max_right _ _) (le_trans (le_max_right _ _) (le_max_right _ _))))
          (by positivity)) h)
      rw [← mul_assoc]
      exact mul_le_mul_of_nonneg_right h2C (by positivity)
    -- a later input: steps 1-5
    have hi2 : i ∈ Finset.Icc 2 (k + 1) := by rw [Finset.mem_Icc] at hi ⊢; omega
    obtain ⟨G, hGm, hG1, hGlip, hΓ⟩ := hS1 δ N hδ0 hδ1 hN P g hadm hg hg1 hgs hcorr
    set Kn : ℕ := ⌈192 * u ^ 4 * budHi C1 δ / budLo C1 δ⌉₊ + 1 with hKndef
    have hKn1 : 1 ≤ Kn := by omega
    have hKn0 : (0 : ℝ) < Kn := by exact_mod_cast hKn1
    have hKnb : (Kn : ℝ) ≤ KbF δ := by
      have := Nat.ceil_lt_add_one (by
        have := budHi_pos hδ0 hC1; have := budLo_pos hδ0 hC1; positivity :
          (0 : ℝ) ≤ 192 * u ^ 4 * budHi C1 δ / budLo C1 δ)
      simp only [hKndef, hKbFdef]; push_cast; linarith
    have hNd1 : 0 < N ^ expo (j 1) := pow_pos hN0 _
    have hKΛ : 192 * budHi c δ ^ 4 * (budHi C1 δ * (N ^ expo (j 1))⁻¹) * N ^ expo (j 1)
        ≤ budLo C1 δ * Kn := by
      have e : 192 * budHi c δ ^ 4 * (budHi C1 δ * (N ^ expo (j 1))⁻¹) * N ^ expo (j 1)
          = 192 * u ^ 4 * budHi C1 δ := by field_simp; rw [hudef]; ring
      rw [e]
      have hlo := budLo_pos hδ0 hC1
      have h1 : 192 * u ^ 4 * budHi C1 δ / budLo C1 δ ≤ Kn := by
        simp only [hKndef]; push_cast
        exact (Nat.le_ceil _).trans (by linarith)
      rw [div_le_iff₀ hlo] at h1
      linarith
    obtain ⟨r, hr, hfr⟩ := energyCore_freeze (k := k + 1) (by omega) hc hδ0 hN hadm hg hg1 hgs
      hGm hG1 (by have := budHi_pos hδ0 hC1; positivity) hGlip hΓ hKn1 hKΛ
    set n := N / Kn with hndef
    have hn0 : 0 < n := div_pos hN0 hKn0
    set a := (r : ℝ) * n with hadef
    have ha : a ∈ Set.Icc 0 N := by
      refine ⟨by positivity, ?_⟩
      have hrK : (r : ℝ) + 1 ≤ Kn := by exact_mod_cast hr
      have : a ≤ Kn * n := by rw [hadef]; nlinarith
      rwa [hndef, mul_div_cancel₀ _ hKn0.ne'] at this
    have hcH' : 32 * u * KbF δ ^ 3 ≤ budHi c'' δ :=
      (hcHb δ hδ0 hδ1).trans (budHi_monotone hδ0 hδ1 hcH
        (le_trans (le_max_left _ _) (le_max_right _ _)))
    obtain ⟨hQadm, hFm', hF1', hFs'⟩ := energyCore_frozen (k := k + 1) (by omega) hc hδ0 hδ1 hN
      hadm hg hg1 hgs hGm hG1 hKn1 hKnb hcc'' hcH' ha
    rw [Nat.add_sub_cancel] at hQadm
    rw [← phaseCorr_frozenCut n (k + 1) g G P j a] at hfr
    rw [Nat.add_sub_cancel] at hfr
    -- the induction hypothesis on the frozen correlation
    have hthr : budHi C'' δ ≤ n := by
      rw [hndef, le_div_iff₀ hKn0]
      have : KbF δ * budHi C'' δ ≤ N := by
        refine le_trans ?_ (hFb.trans hNC)
        have : 0 ≤ 2 * budHi C'' δ * KbF δ ^ 3 + 2 * budHi Cle δ := by positivity
        linarith
      nlinarith
    have hnN : n ≤ N := by
      rw [hndef]; exact div_le_self hN0.le (by exact_mod_cast hKn1)
    have hcorr'' : budLo c'' δ * n ^ (6 : ℕ) ≤ ‖phaseCorr n k (frozenCut (k + 1) g G P j a)
        (frozenPoly P a) (fun _ => 0) (fun i => j (i + 1))‖ := by
      refine le_trans ?_ hfr
      have h1 : budLo c'' δ ≤ budLo C1 δ / 2 :=
        (budLo_antitone hδ0 hδ1 hcL (le_trans (le_max_right _ _) (le_max_right _ _))).trans
          (hcLb δ hδ0 hδ1)
      have h2 : n ^ (6 : ℕ) ≤ N ^ (6 : ℕ) := pow_le_pow_left₀ hn0.le hnN 6
      exact mul_le_mul h1 h2 (by positivity) (by have := budLo_pos hδ0 hC1; positivity)
    have hi' : i - 1 ∈ Finset.Icc 1 k := by rw [Finset.mem_Icc] at hi ⊢; omega
    have hE := hIH δ n hδ0 hδ1 hthr (frozenPoly P a) (frozenCut (k + 1) g G P j a) hQadm hFm'
      hF1' hFs' hcorr'' (i - 1) hi'
    have hi1' : i - 1 + 1 = i := by have := Finset.mem_Icc.mp hi; omega
    simp only [hi1', frozenCut_pred hi2 g G P j a, norm_fourier_comp_sub] at hE
    -- translation invariance, the radius and the lower bound
    obtain ⟨hfi, hf2⟩ := integrable_memLp_of_box (hg i) (hg1 i) hu0.le hN0.le (hgs i)
    set d := expo (j i) with hddef
    have hd3 : d ≤ 3 := Nat.succ_le_of_lt (Fin.is_lt _)
    have hNd : 0 < N ^ d := pow_pos hN0 _
    have hnd : 0 < n ^ d := pow_pos hn0 _
    have hKd : (Kn : ℝ) ^ d ≤ KbF δ ^ 3 :=
      (pow_le_pow_right₀ (by exact_mod_cast hKn1) hd3).trans
        (pow_le_pow_left₀ (by positivity) hKnb 3)
    have hL : budHi C'' δ * (n ^ d)⁻¹ = budHi C'' δ * (Kn : ℝ) ^ d * (N ^ d)⁻¹ := by
      rw [hndef, div_pow]; field_simp
    have hLL : 2 * (budHi C'' δ * (n ^ d)⁻¹) ≤ budHi C δ * (N ^ d)⁻¹ := by
      rw [hL, ← mul_assoc, ← mul_assoc]
      refine mul_le_mul_of_nonneg_right ?_ (by positivity)
      refine le_trans ?_ hFb
      have : 2 * budHi C'' δ * (Kn : ℝ) ^ d ≤ 2 * budHi C'' δ * KbF δ ^ 3 :=
        mul_le_mul_of_nonneg_left hKd (by positivity)
      have : 0 ≤ KbF δ * budHi C'' δ + 2 * budHi Cle δ := by positivity
      linarith
    refine energy_raise hfi hf2 (j i) (by positivity) hLL (le_trans ?_ hE)
    -- `ℓ_C(δ) N^6 ≤ ℓ_{C''}(δ) n^6`
    have hClC : budLo C δ ≤ budLo C'' δ / KbF δ ^ 6 :=
      (budLo_antitone hδ0 hδ1 hCl (le_trans (le_max_left _ _)
        (le_trans (le_max_right _ _) (le_max_right _ _)))).trans (hClb δ hδ0 hδ1)
    have hn6 : N ^ (6 : ℕ) / KbF δ ^ 6 ≤ n ^ (6 : ℕ) := by
      rw [hndef, div_pow]
      exact div_le_div_of_nonneg_left (by positivity) (by positivity)
        (pow_le_pow_left₀ hKn0.le hKnb 6)
    calc budLo C δ * N ^ (6 : ℕ) ≤ budLo C'' δ / KbF δ ^ 6 * N ^ (6 : ℕ) :=
          mul_le_mul_of_nonneg_right hClC (by positivity)
      _ = budLo C'' δ * (N ^ (6 : ℕ) / KbF δ ^ 6) := by ring
      _ ≤ budLo C'' δ * n ^ (6 : ℕ) :=
          mul_le_mul_of_nonneg_left hn6 (budLo_pos hδ0 hC'').le

end

/-! ### `new:monomial-inverse` -/

section
open Filter Topology MeasureTheory

/-- The directions of the monomial average: input `i ∈ {1, 2, 3}` moves along `e_{i-1}`. -/
def monoDir (i : ℕ) : Fin 3 := ⟨min (i - 1) 2, by omega⟩

/-- The polynomials of the monomial average, `P_i(t) = -t^i`, so that `x - P_i(t) e = x + t^i e`. -/
noncomputable def monoPoly (i : ℕ) : Polynomial ℝ := -Polynomial.X ^ i

/-- The inputs of `Λ_N(f_0; f)` as a correlation: `g_0 = conj f_0`, `g_i = f_{i-1}`. -/
noncomputable def monoIn (f0 : E3 → ℂ) (f : Fin 3 → E3 → ℂ) (i : ℕ) : E3 → ℂ :=
  if i = 0 then fun x => conj (f0 x) else f (monoDir i)

theorem expo_monoDir {i : ℕ} (hi : i ∈ Finset.Icc 1 3) : expo (monoDir i) = i := by
  rw [Finset.mem_Icc] at hi
  simp only [expo, monoDir]; omega

theorem monoDir_succ (j : Fin 3) : monoDir (j + 1) = j := by
  ext; simp only [monoDir]; omega

theorem monoDir_increasing :
    ∀ u v, 1 ≤ u → u < v → v ≤ 3 → expo (monoDir u) < expo (monoDir v) := by
  intro u v hu huv hv
  rw [expo_monoDir (Finset.mem_Icc.mpr ⟨hu, by omega⟩),
    expo_monoDir (Finset.mem_Icc.mpr ⟨by omega, hv⟩)]
  exact huv

theorem admissible_monoPoly {c : ℕ} (hc : 1 ≤ c) {δ N : ℝ} (hδ0 : 0 < δ) (hδ1 : δ ≤ 1)
    (hN : 0 ≤ N) {i : ℕ} (hi : i ∈ Finset.Icc 1 3) :
    AdmissiblePoly c δ N (expo (monoDir i)) (monoPoly i) := by
  rw [expo_monoDir hi]
  have hdeg : (monoPoly i).natDegree = i := by
    simp [monoPoly, Polynomial.natDegree_neg]
  have hlc : (monoPoly i).leadingCoeff = -1 := by
    simp [monoPoly, Polynomial.leadingCoeff_neg]
  refine ⟨hdeg, ?_, ?_, fun r hr => ?_⟩
  · rw [hlc, abs_neg, abs_one]; exact budLo_le_one hδ0 hδ1 hc
  · rw [hlc, abs_neg, abs_one]; exact one_le_budHi hδ0 hδ1 hc
  · have : (monoPoly i).coeff r = 0 := by
      simp [monoPoly, Polynomial.coeff_X_pow, show r ≠ i by omega]
    rw [this, abs_zero]
    exact mul_nonneg (budHi_pos hδ0 hc).le (pow_nonneg hN _)

/-- **The four-linear form as a correlation**: `Λ_N(f_0; f_1, f_2, f_3) = Γ_3(conj f_0; f)` with
`P_i(t) = -t^i` along `e_{i-1}`. -/
theorem Lambda_eq_phaseCorr (N : ℝ) (f0 : E3 → ℂ) (f : Fin 3 → E3 → ℂ) :
    Lambda N f0 f = phaseCorr N 3 (monoIn f0 f) monoPoly (fun _ => 0) monoDir := by
  rw [Lambda, phaseCorr]
  refine integral_congr_ae (Eventually.of_forall fun x => ?_)
  simp only [monoIn, ite_true, A]
  rw [mul_comm]
  congr 2
  refine intervalIntegral.integral_congr fun t _ => ?_
  simp only [phaseProd, Polynomial.eval_zero]
  rw [show expPhase (fun s => 2 * Real.pi * 0) t = 1 by simp [expPhase], mul_one]
  rw [show Finset.Icc 1 3 = {1, 2, 3} by decide, prodShift, Fin.prod_univ_three]
  simp [monoIn, monoPoly, monoDir, curve, expo, Finset.prod_insert, mul_assoc]

/-- **Theorem `new:monomial-inverse`** (the precise inverse statement used in the adjoint
argument). For every `C₀ ≥ 1` there is an integer `A ≥ 1` such that for `0 < δ ≤ 1`,
`N ≥ A δ^{-A}` and Borel `f_0, f_1, f_2, f_3` bounded by one and supported in `B_N(C₀)`, the
bound `|⟨A_N(f_1, f_2, f_3), f_0⟩| ≥ δ N^6` implies, for every `j`,
`⟨f_j, P^{(j)}_{A δ^{-A} N^{-j}} f_j⟩ = E_j` with `E_j ≥ A^{-1} δ^A N^6` real. The witness is
`h_j = f_j`. This is `Auto.energyCore` for the degree list `(1, 2, 3)`. -/
theorem monomialInverse {C₀ : ℝ} (hC₀ : 1 ≤ C₀) :
    ∃ A : ℕ, 1 ≤ A ∧ ∀ δ N : ℝ, 0 < δ → δ ≤ 1 → A * (δ ^ A)⁻¹ ≤ N →
      ∀ (f0 : E3 → ℂ) (f : Fin 3 → E3 → ℂ), Measurable f0 → (∀ i, Measurable (f i)) →
        (∀ x, ‖f0 x‖ ≤ 1) → (∀ i x, ‖f i x‖ ≤ 1) → (∀ x, x ∉ petBox C₀ N → f0 x = 0) →
        (∀ i x, x ∉ petBox C₀ N → f i x = 0) → δ * N ^ (6 : ℕ) ≤ ‖Lambda N f0 f‖ →
        ∀ j : Fin 3, ∃ E : ℝ, ∫ x, f j x * conj (P (A * (δ ^ A)⁻¹ * (N ^ expo j)⁻¹) j (f j) x)
          = E ∧ (A : ℝ)⁻¹ * δ ^ A * N ^ (6 : ℕ) ≤ E := by
  set c := ⌈C₀⌉₊ with hcdef
  have hc : 1 ≤ c := by
    have : (1 : ℝ) ≤ ⌈C₀⌉₊ := hC₀.trans (Nat.le_ceil _)
    exact_mod_cast this
  obtain ⟨C, hcC, hE⟩ := energyCore 3 (by norm_num) monoDir monoDir_increasing c hc
  have hC : 1 ≤ C := le_trans hc hcC
  refine ⟨C, hC, ?_⟩
  intro δ N hδ0 hδ1 hNA f0 f hf0 hf hf01 hf1 hf0s hfs hΛ j
  have hbudC : budHi C δ = C * (δ ^ C)⁻¹ := rfl
  have hNC : budHi C δ ≤ N := by rw [hbudC]; exact hNA
  have hN : 1 ≤ N := (one_le_budHi hδ0 hδ1 hC).trans hNC
  have hN0 : 0 < N := by linarith
  -- the input budget
  have hC₀c : C₀ ≤ budHi c δ := by
    have h1 : C₀ ≤ c := Nat.le_ceil _
    have h2 : (c : ℝ) ≤ budHi c δ := by
      rw [budHi]
      have : 1 ≤ (δ ^ c)⁻¹ := one_le_inv₀ (by positivity) |>.mpr (pow_le_one₀ hδ0.le hδ1)
      have hc0 : (0 : ℝ) ≤ c := by positivity
      nlinarith
    linarith
  have hbox : petBox C₀ N ⊆ petBox (budHi c δ) N := petBox_mono hC₀c hN0.le
  have hlo : budLo c δ ≤ δ := by
    rw [budLo]
    have h1 : (c : ℝ)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (by exact_mod_cast hc)
    have h2 : δ ^ c ≤ δ := pow_le_of_le_one hδ0.le hδ1 (by omega)
    calc (c : ℝ)⁻¹ * δ ^ c ≤ 1 * δ := mul_le_mul h1 h2 (by positivity) zero_le_one
      _ = δ := one_mul δ
  have hgm : ∀ i, Measurable (monoIn f0 f i) := fun i => by
    unfold monoIn; split_ifs
    · exact Complex.continuous_conj.measurable.comp hf0
    · exact hf _
  have hg1 : ∀ i x, ‖monoIn f0 f i x‖ ≤ 1 := fun i x => by
    unfold monoIn; split_ifs
    · rw [RCLike.norm_conj]; exact hf01 x
    · exact hf1 _ x
  have hgs : ∀ i x, x ∉ petBox (budHi c δ) N → monoIn f0 f i x = 0 := fun i x hx => by
    have hx' : x ∉ petBox C₀ N := fun h => hx (hbox h)
    unfold monoIn; split_ifs
    · simp [hf0s x hx']
    · exact hfs _ x hx'
  have hcorr : budLo c δ * N ^ (6 : ℕ)
      ≤ ‖phaseCorr N 3 (monoIn f0 f) monoPoly (fun _ => 0) monoDir‖ := by
    rw [← Lambda_eq_phaseCorr]
    exact le_trans (mul_le_mul_of_nonneg_right hlo (by positivity)) hΛ
  have hj : (j : ℕ) + 1 ∈ Finset.Icc 1 3 := Finset.mem_Icc.mpr ⟨by omega, by omega⟩
  have hEj := hE δ N hδ0 hδ1 hNC monoPoly (monoIn f0 f)
    (fun i hi => admissible_monoPoly hc hδ0 hδ1 hN0.le hi) hgm hg1 hgs hcorr _ hj
  simp only [monoDir_succ, monoIn, show (j : ℕ) + 1 ≠ 0 by omega, ite_false] at hEj
  obtain ⟨hfi, hf2⟩ := integrable_memLp_of_box (hf j) (hf1 j) (by linarith) hN0.le (hfs j)
  have hL : 0 < C * (δ ^ C)⁻¹ * (N ^ expo j)⁻¹ := by
    have : (1 : ℝ) ≤ C := by exact_mod_cast hC
    positivity
  refine ⟨∫ ξ, eta (ξ j / (C * (δ ^ C)⁻¹ * (N ^ expo j)⁻¹)) * ‖𝓕 (f j) ξ‖ ^ 2,
    integral_mul_conj_P_eq hL j (hf j) hfi hf2, ?_⟩
  rw [hbudC] at hEj
  have hlo' : budLo C δ = (C : ℝ)⁻¹ * δ ^ C := rfl
  rw [hlo'] at hEj
  exact hEj

end

/-! ### `new:adjoint-basic` -/

section
open Filter Topology MeasureTheory

theorem measurable_adjShift (j : Fin 3) {f0 : E3 → ℂ} (hf0 : Measurable f0)
    {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Measurable (f i)) :
    Measurable fun z : E3 × ℝ => adjShift j f0 f z.1 z.2 := by
  have hcm : Measurable (curve j) := (continuous_curve j).measurable
  simp only [adjShift]
  have hc0 : Measurable fun z : E3 × ℝ => z.1 - curve j z.2 :=
    measurable_fst.sub (hcm.comp measurable_snd)
  refine (hf0.comp hc0).mul (Finset.measurable_prod _ fun i _ => ?_)
  exact Complex.continuous_conj.measurable.comp ((hf i).comp
    (hc0.add (((continuous_curve i).measurable).comp measurable_snd)))

/-- **`new:adjoint-basic`, support and `|G| ≤ 1`**: for inputs bounded by one with `g_0`
supported in `B_N(C₀)`, `|A_N^{*j}(g)| ≤ 1` and `A_N^{*j}(g)` is supported in `B_N(C₀ + 1)`. -/
theorem Astar_basic {N : ℝ} (hN : 0 < N) (j : Fin 3) {C₀ : ℝ} {g0 : E3 → ℂ}
    {f : Fin 3 → E3 → ℂ} (hg01 : ∀ x, ‖g0 x‖ ≤ 1) (hf1 : ∀ i x, ‖f i x‖ ≤ 1)
    (hg0s : ∀ x, x ∉ petBox C₀ N → g0 x = 0) :
    (∀ y, ‖Astar N j g0 f y‖ ≤ 1) ∧ (∀ y, y ∉ petBox (C₀ + 1) N → Astar N j g0 f y = 0) := by
  have hadj1 : ∀ y t, ‖adjShift j g0 f y t‖ ≤ 1 := fun y t => by
    rw [adjShift, norm_mul, norm_prod]
    exact ((mul_le_of_le_one_left (by positivity) (hg01 _)).trans (Finset.prod_le_one₀ (fun _ _ =>
      norm_nonneg _) fun i _ => by
        rw [RCLike.norm_conj]; exact hf1 i _))
  refine ⟨fun y => ?_, fun y hy => ?_⟩
  · rw [Astar, norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hN.le,
      inv_mul_le_iff₀ hN, mul_one]
    have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := N) (C := 1)
      (f := fun t => adjShift j g0 f y t) fun t _ => hadj1 y t
    rwa [one_mul, sub_zero, abs_of_pos hN] at h
  · rw [Astar]
    have h0 : ∀ t ∈ Set.uIcc (0 : ℝ) N, adjShift j g0 f y t = 0 := by
      intro t ht
      rw [Set.uIcc_of_le hN.le] at ht
      rw [adjShift, hg0s _ (fun hm => hy fun i => ?_), zero_mul]
      have hi := hm i
      have hNi : 0 ≤ N ^ expo i := pow_nonneg hN.le _
      by_cases hij : i = j
      · subst hij
        have ht1 : 0 ≤ t ^ expo i := pow_nonneg ht.1 _
        have ht2 : t ^ expo i ≤ N ^ expo i := pow_le_pow_left₀ ht.1 ht.2 _
        simp only [curve, PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, basisVec,
          PiLp.single_apply, ite_true, mul_one] at hi
        constructor <;> nlinarith [hi.1, hi.2]
      · simp only [curve, PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, basisVec,
          PiLp.single_apply, ite_eq_right hij, mul_zero, sub_zero] at hi
        constructor <;> nlinarith [hi.1, hi.2]
    rw [intervalIntegral.integral_congr h0]
    simp

/-- The integrand of the adjoint as a product over the three positions. -/
theorem adjShift_eq_prod (j : Fin 3) (g0 : E3 → ℂ) (f : Fin 3 → E3 → ℂ) (y : E3) (t : ℝ) :
    adjShift j g0 f y t = ∏ k : Fin 3, (if k = j then g0 (y - curve j t)
      else conj (f k (y - curve j t + curve k t))) := by
  rw [adjShift, ← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ j), ite_eq_left rfl]
  congr 1
  exact Finset.prod_congr rfl fun k hk => by rw [ite_eq_right (Finset.ne_of_mem_erase hk)]

/-- **`new:adjoint-basic`, the crude `L^r` bound**: for exponents with
`1/r = 1/r₀ + Σ_{i ≠ j} 1/r_i` and `1 ≤ r < ∞`,
`‖A_N^{*j}(g)‖_r ≤ ‖g₀‖_{r₀} ∏_{i ≠ j} ‖g_i‖_{r_i}` (Minkowski, Hoelder, translation
invariance). -/
theorem eLpNorm_Astar_le {N : ℝ} (hN : 0 < N) (j : Fin 3) {g0 : E3 → ℂ} (hg0 : Measurable g0)
    {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Measurable (f i)) {p : Fin 3 → ℝ≥0∞} {r : ℝ≥0∞}
    (hr1 : 1 ≤ r) (hrtop : r ≠ ⊤) (hpr : ∑ k, (p k)⁻¹ = r⁻¹) :
    eLpNorm (Astar N j g0 f) r volume
      ≤ eLpNorm g0 (p j) volume * ∏ i ∈ Finset.univ.erase j, eLpNorm (f i) (p i) volume := by
  have hadjm := measurable_adjShift j hg0 hf
  set ν := volume.restrict (Set.Ioc (0 : ℝ) N) with hνdef
  have hA : Astar N j g0 f = fun y => (N : ℂ)⁻¹ * ∫ t, adjShift j g0 f y t ∂ν := by
    funext y; rw [Astar, intervalIntegral.integral_of_le hN.le]
  -- each time slice
  have hslice : ∀ t, eLpNorm (fun y => adjShift j g0 f y t) r volume
      ≤ eLpNorm g0 (p j) volume * ∏ i ∈ Finset.univ.erase j, eLpNorm (f i) (p i) volume := by
    intro t
    simp_rw [adjShift_eq_prod]
    refine (eLpNorm_prod_le Finset.univ (fun k _ => ?_) hpr).trans (le_of_eq ?_)
    · split_ifs
      · exact (hg0.comp (measurable_id.sub_const _)).aestronglyMeasurable
      · exact (Complex.continuous_conj.measurable.comp
          ((hf k).comp ((measurable_id.sub_const _).add_const _))).aestronglyMeasurable
    · rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ j)]
      congr 1
      · simp only [ite_true]
        have h := eLpNorm_comp_add_right_of_aestronglyMeasurable (μ := (volume : Measure E3))
          hg0.aestronglyMeasurable (-curve j t) (p j)
        simpa [sub_eq_add_neg] using h
      · refine Finset.prod_congr rfl fun k hk => ?_
        simp only [ite_eq_right (Finset.ne_of_mem_erase hk)]
        have h := eLpNorm_comp_add_right_of_aestronglyMeasurable (μ := (volume : Measure E3))
          (hf k).aestronglyMeasurable (-curve j t + curve k t) (p k)
        have e : (fun y => conj (f k (y - curve j t + curve k t)))
            = fun y => conj (f k (y + (-curve j t + curve k t))) := by
          funext y; congr 2; abel
        rw [e]
        rw [← h]
        exact MeasureTheory.eLpNorm_conj _ _ _
  -- Minkowski
  rw [hA]
  have hsm : eLpNorm (fun y => (N : ℂ)⁻¹ * ∫ t, adjShift j g0 f y t ∂ν) r volume
      = ‖(N : ℂ)⁻¹‖ₑ * eLpNorm (fun y => ∫ t, adjShift j g0 f y t ∂ν) r volume := by
    exact eLpNorm_const_smul (μ := (volume : Measure E3)) (p := r) ((N : ℂ)⁻¹)
      (fun y => ∫ t, adjShift j g0 f y t ∂ν)
  rw [hsm]
  have hmink := eLpNorm_integral_le_lintegral (μ := (volume : Measure E3)) (ν := ν) hr1 hrtop
    (F := fun t y => adjShift j g0 f y t) (by
      have h := hadjm.comp (measurable_snd.prodMk measurable_fst)
      exact h)
  have hnorm : ‖(N : ℂ)⁻¹‖ₑ = (ENNReal.ofReal N)⁻¹ := by
    rw [enorm_inv (by exact_mod_cast hN.ne'), ← ofReal_norm, Complex.norm_real,
      Real.norm_of_nonneg hN.le]
  have hNne : ENNReal.ofReal N ≠ 0 := by simpa using hN
  have hνN : ν Set.univ = ENNReal.ofReal N := by
    rw [hνdef, Measure.restrict_apply MeasurableSet.univ, Set.univ_inter, Real.volume_Ioc,
      sub_zero]
  calc ‖(N : ℂ)⁻¹‖ₑ * eLpNorm (fun y => ∫ t, adjShift j g0 f y t ∂ν) r volume
      ≤ ‖(N : ℂ)⁻¹‖ₑ * ∫⁻ t, eLpNorm ((fun t y => adjShift j g0 f y t) t) r volume ∂ν :=
        mul_le_mul_of_nonneg_left hmink bot_le
    _ ≤ ‖(N : ℂ)⁻¹‖ₑ * ∫⁻ _t, eLpNorm g0 (p j) volume
          * ∏ i ∈ Finset.univ.erase j, eLpNorm (f i) (p i) volume ∂ν :=
        mul_le_mul_of_nonneg_left (lintegral_mono fun t => hslice t) bot_le
    _ = eLpNorm g0 (p j) volume * ∏ i ∈ Finset.univ.erase j, eLpNorm (f i) (p i) volume := by
        rw [lintegral_const, hνN, hnorm, mul_comm _ (ENNReal.ofReal N), ← mul_assoc,
          ENNReal.inv_mul_cancel hNne ENNReal.ofReal_ne_top, one_mul]

/-- `‖k_R‖_1 = B_0` as an extended norm. -/
theorem eLpNorm_projKernel {R : ℝ} (hR : 0 < R) :
    eLpNorm (projKernel R) 1 volume = ENNReal.ofReal etaKerL1 := by
  rw [eLpNorm_one_eq_lintegral_enorm (by fun_prop), ← ofReal_integral_norm_eq_lintegral_enorm
    (projKernel_integrable hR), projKernel_L1 hR]

/-- `‖P_R^{(j)} G‖_r ≤ B_0 ‖G‖_r`. -/
theorem eLpNorm_P_le_of_measurable {R : ℝ} (hR : 0 < R) (j : Fin 3) {G : E3 → ℂ}
    (hG : Measurable G)
    {r : ℝ≥0∞} (hr1 : 1 ≤ r) (hrtop : r ≠ ⊤) :
    eLpNorm (P R j G) r volume ≤ ENNReal.ofReal etaKerL1 * eLpNorm G r volume := by
  have h := eLpNorm_integral_smul_translate_le (μ := (volume : Measure E3)) hr1 hrtop
    (projKernel_continuous R).measurable hG (basisVec j)
  rw [eLpNorm_projKernel hR] at h
  exact h

/-- **`new:adjoint-basic`, the crude bound for the high-frequency part**:
`‖(I - P_R^{(j)}) G‖_r ≤ (1 + B_0) ‖G‖_r`. -/
theorem eLpNorm_sub_P_le {R : ℝ} (hR : 0 < R) (j : Fin 3) {G : E3 → ℂ} (hG : Measurable G)
    {r : ℝ≥0∞} (hr1 : 1 ≤ r) (hrtop : r ≠ ⊤) :
    eLpNorm (fun y => G y - P R j G y) r volume
      ≤ (1 + ENNReal.ofReal etaKerL1) * eLpNorm G r volume := by
  have h := eLpNorm_sub_le (μ := (volume : Measure E3)) (f := G) (g := P R j G)
     hr1
  refine le_trans (le_of_eq rfl) (h.trans ?_)
  rw [add_mul, one_mul]
  exact add_le_add le_rfl (eLpNorm_P_le_of_measurable hR j hG hr1 hrtop)

/-- **`new:adjoint-basic`, both crude bounds for the adjoint**. -/
theorem eLpNorm_Astar_sub_P_le {N R : ℝ} (hN : 0 < N) (hR : 0 < R) (j : Fin 3)
    {g0 : E3 → ℂ} (hg0 : Measurable g0) {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Measurable (f i))
    {p : Fin 3 → ℝ≥0∞} {r : ℝ≥0∞} (hr1 : 1 ≤ r) (hrtop : r ≠ ⊤) (hpr : ∑ k, (p k)⁻¹ = r⁻¹) :
    eLpNorm (fun y => Astar N j g0 f y - P R j (Astar N j g0 f) y) r volume
      ≤ (1 + ENNReal.ofReal etaKerL1)
        * (eLpNorm g0 (p j) volume * ∏ i ∈ Finset.univ.erase j, eLpNorm (f i) (p i) volume) :=
  (eLpNorm_sub_P_le hR j (measurable_Astar j hg0 hf) hr1 hrtop).trans
    (mul_le_mul_of_nonneg_left (eLpNorm_Astar_le hN j hg0 hf hr1 hrtop hpr) bot_le)

end

/-! ### `new:compact-highpass`: the high-frequency energy and the tail -/

section
open Filter Topology MeasureTheory

theorem norm_sub_sq_eq (a b : ℂ) : ‖a - b‖ ^ 2 = ‖a‖ ^ 2 - 2 * (a * conj b).re + ‖b‖ ^ 2 := by
  rw [← Complex.normSq_eq_norm_sq, ← Complex.normSq_eq_norm_sq, ← Complex.normSq_eq_norm_sq,
    Complex.normSq_sub]
  simp only [Complex.mul_re, Complex.conj_re, Complex.conj_im]
  ring

/-- **`new:compact-highpass`, the high-frequency part and its energy**: for a one-bounded Borel
`G` supported in a box, `H = (I - P_R^{(j)}) G` satisfies
`∫ H conj G = ∫ (1 - η(ξ_j/R)) |Ĝ|²`, a real number, and `‖H‖₂² ≤ ∫ H conj G`. -/
theorem highpass_energy {N C R : ℝ} (hN : 0 ≤ N) (hC : 0 ≤ C) (hR : 0 < R) (j : Fin 3)
    {G : E3 → ℂ} (hGm : Measurable G) (hG1 : ∀ x, ‖G x‖ ≤ 1)
    (hGs : ∀ x, x ∉ petBox C N → G x = 0) :
    ∃ E : ℝ, ∫ x, (G x - P R j G x) * conj (G x) = E ∧
      ∫ x, ‖G x - P R j G x‖ ^ 2 ≤ E ∧ E ≤ ∫ x, ‖G x‖ ^ 2 := by
  obtain ⟨hGi, hG2⟩ := integrable_memLp_of_box hGm hG1 hC hN hGs
  have hPm := measurable_P (R := R) j hGm
  have hPi := integrable_P_of_measurable hR j hGm hGi
  have hP2 := memLp_two_P hR j hGm hG2
  have hPb : ∀ x, ‖P R j G x‖ ≤ etaKerL1 := norm_P_le_of_norm_le_one hR j hG1
  set E0 := ∫ x, ‖G x‖ ^ 2 with hE0
  set E1 := ∫ ξ, eta (ξ j / R) * ‖𝓕 G ξ‖ ^ 2 with hE1
  set E2 := ∫ ξ, eta (ξ j / R) ^ 2 * ‖𝓕 G ξ‖ ^ 2 with hE2
  have hF2 : Integrable fun ξ => ‖𝓕 G ξ‖ ^ 2 :=
    (memLp_two_fourier hGi hG2).integrable_norm_pow (by norm_num)
  have hetac : Continuous fun ξ : E3 => eta (ξ j / R) :=
    eta_continuous.comp (by fun_prop)
  -- the pairings
  have hGG : ∫ x, G x * conj (G x) = (E0 : ℂ) := by
    rw [hE0, ← integral_complex_ofReal]
    refine integral_congr_ae (Eventually.of_forall fun x => ?_)
    simp only
    rw [Complex.mul_conj, Complex.normSq_eq_norm_sq]
  have hGP : ∫ x, G x * conj (P R j G x) = (E1 : ℂ) := integral_mul_conj_P_eq hR j hGm hGi hG2
  have hPG : ∫ x, P R j G x * conj (G x) = (E1 : ℂ) := by
    rw [integral_P_mul_conj_eq hR j hGm hGi hG2 hGm hGi hG2, hGP]
  have hPP : ∫ x, ‖P R j G x‖ ^ 2 = E2 := by
    rw [← integral_norm_sq_fourier hPi hP2]
    refine integral_congr_ae (Eventually.of_forall fun ξ => ?_)
    simp only
    rw [fourier_P_of_measurable hR j hGm hGi, norm_mul, Complex.norm_real,
      Real.norm_of_nonneg (eta_nonneg _), mul_pow]
  -- integrability
  have hbox : ∀ {f : E3 → ℂ}, Measurable f → (∀ x, ‖f x‖ ≤ 1 + etaKerL1) →
      Integrable fun x => f x * conj (G x) := fun {f} hf hf1 =>
    integrable_of_bdd_support_box hC hN (hf.mul (Complex.continuous_conj.measurable.comp hGm))
      (fun x => by
        rw [norm_mul, RCLike.norm_conj]
        exact mul_le_mul (hf1 x) (hG1 x) (norm_nonneg _) (by
          have := etaKerL1_nonneg; linarith))
      (fun x hx => by rw [hGs x hx, map_zero, mul_zero])
  have hB0 := etaKerL1_nonneg
  have hGint : Integrable fun x => G x * conj (G x) :=
    hbox hGm fun x => (hG1 x).trans (by linarith)
  have hPint : Integrable fun x => P R j G x * conj (G x) :=
    hbox hPm fun x => (hPb x).trans (by linarith)
  refine ⟨E0 - E1, ?_, ?_, ?_⟩
  · simp_rw [sub_mul]
    rw [integral_sub hGint hPint, hGG, hPG]; push_cast; ring
  rotate_left
  · linarith [integral_eta_mul_norm_sq_nonneg R j G]
  · -- `‖H‖₂² = E0 - 2 E1 + E2 ≤ E0 - E1`
    have hGsq : Integrable fun x => ‖G x‖ ^ 2 := hG2.integrable_norm_pow (by norm_num)
    have hPsq : Integrable fun x => ‖P R j G x‖ ^ 2 := hP2.integrable_norm_pow (by norm_num)
    have hGPint : Integrable fun x => G x * conj (P R j G x) :=
      integrable_of_bdd_support_box hC hN
        (hGm.mul (Complex.continuous_conj.measurable.comp hPm))
        (fun x => by
          rw [norm_mul, RCLike.norm_conj]
          exact mul_le_mul (hG1 x) (hPb x) (norm_nonneg _) zero_le_one)
        (fun x hx => by rw [hGs x hx, zero_mul])
    have hre : Integrable fun x => (G x * conj (P R j G x)).re := hGPint.re
    have e : (fun x => ‖G x - P R j G x‖ ^ 2)
        = fun x => ‖G x‖ ^ 2 - 2 * (G x * conj (P R j G x)).re + ‖P R j G x‖ ^ 2 := by
      funext x; exact norm_sub_sq_eq _ _
    have hi1 : Integrable fun x => ‖G x‖ ^ 2 - 2 * (G x * conj (P R j G x)).re :=
      hGsq.sub (hre.const_mul 2)
    rw [e, integral_add hi1 hPsq, integral_sub hGsq (hre.const_mul 2),
      integral_const_mul, ← hE0, hPP]
    have hre' : ∫ x, (G x * conj (P R j G x)).re = E1 := by
      have h : (∫ x, (G x * conj (P R j G x)).re) = (∫ x, G x * conj (P R j G x)).re :=
        integral_re hGPint
      rw [h, hGP, Complex.ofReal_re]
    rw [hre']
    have hE21 : E2 ≤ E1 := by
      rw [hE2, hE1]
      refine integral_mono ((hF2.bdd_mul (c := 1) ((hetac.pow 2).aestronglyMeasurable)
        (Eventually.of_forall fun ξ => by
          rw [Real.norm_of_nonneg (by positivity)]
          exact pow_le_one₀ (eta_nonneg _) (eta_le_one _))))
        (hF2.bdd_mul (c := 1) hetac.aestronglyMeasurable (Eventually.of_forall fun ξ => by
          rw [Real.norm_of_nonneg (eta_nonneg _)]; exact eta_le_one _)) fun ξ => ?_
      have h0 := eta_nonneg (ξ j / R)
      have h1 := eta_le_one (ξ j / R)
      have : eta (ξ j / R) ^ 2 ≤ eta (ξ j / R) := by nlinarith
      exact mul_le_mul_of_nonneg_right this (sq_nonneg _)
    linarith

/-- **`new:compact-highpass`, the tail bound**: if `G` vanishes off `B_N(C)`, then off
`B_N(C + 1)` the high-frequency part is `-P_R G`, which only sees the kernel at `|u| ≥ N^{d_j}`:
`‖1_{B_N(C+1)^c} (I - P_R) G‖₂ ≤ B^{tail}_2 (R N^{d_j})^{-2} ‖G‖₂`. -/
theorem highpass_tail {N C R : ℝ} (hN : 0 < N) (hR : 0 < R) (j : Fin 3)
    {G : E3 → ℂ} (hGm : Measurable G) (hGs : ∀ x, x ∉ petBox C N → G x = 0) :
    eLpNorm ((petBox (C + 1) N)ᶜ.indicator fun x => G x - P R j G x) 2 volume
      ≤ ENNReal.ofReal (etaKerMom 2 / (R * N ^ expo j) ^ 2) * eLpNorm G 2 volume := by
  set a := N ^ expo j with hadef
  have ha : 0 < a := pow_pos hN _
  set S : Set ℝ := {u | a ≤ |u|} with hSdef
  have hS : MeasurableSet S := measurableSet_le measurable_const continuous_abs.measurable
  set Kt : ℝ → ℂ := S.indicator (projKernel R) with hKtdef
  have hKtm : Measurable Kt := (projKernel_continuous R).measurable.indicator hS
  have hbox : petBox C N ⊆ petBox (C + 1) N := petBox_mono (by linarith) hN.le
  have hpt : ((petBox (C + 1) N)ᶜ.indicator fun x => G x - P R j G x)
      = (petBox (C + 1) N)ᶜ.indicator fun x => -∫ u, Kt u * G (x - u • basisVec j) := by
    funext x
    by_cases hx : x ∈ petBox (C + 1) N
    · simp [Set.indicator_of_notMem (Set.notMem_compl_iff.mpr hx)]
    · rw [Set.indicator_of_mem (Set.mem_compl hx), Set.indicator_of_mem (Set.mem_compl hx),
        hGs x fun h => hx (hbox h), zero_sub, P]
      congr 1
      refine integral_congr_ae (Eventually.of_forall fun u => ?_)
      simp only [hKtdef]
      by_cases hu : u ∈ S
      · rw [Set.indicator_of_mem hu]
      · rw [Set.indicator_of_notMem hu, zero_mul]
        have hu' : |u| < a := lt_of_not_ge hu
        suffices hG0 : G (x - u • basisVec j) = 0 by rw [hG0, mul_zero]
        refine hGs _ fun hm => hx fun i => ?_
        have hi := hm i
        have hNi : 0 ≤ N ^ expo i := pow_nonneg hN.le _
        by_cases hij : i = j
        · subst hij
          simp only [PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, basisVec_apply_self,
            mul_one] at hi
          have := abs_lt.mp hu'
          constructor <;> nlinarith [hi.1, hi.2]
        · simp only [PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, basisVec_apply_ne hij,
            mul_zero, sub_zero] at hi
          constructor <;> nlinarith [hi.1, hi.2]
  rw [hpt]
  refine (eLpNorm_indicator_le _ (measurableSet_petBox (C + 1) N).compl).trans ?_
  rw [show (fun x => -∫ u, Kt u * G (x - u • basisVec j))
      = -fun x => ∫ u, Kt u * G (x - u • basisVec j) from rfl, eLpNorm_neg]
  refine (eLpNorm_integral_smul_translate_le (μ := (volume : Measure E3)) (by norm_num)
    (by simp) hKtm hGm (basisVec j)).trans ?_
  refine mul_le_mul_of_nonneg_right ?_ bot_le
  have hKti : Integrable Kt := (projKernel_integrable hR).indicator hS
  rw [eLpNorm_one_eq_lintegral_enorm (by fun_prop), ← ofReal_integral_norm_eq_lintegral_enorm hKti]
  refine ENNReal.ofReal_le_ofReal ?_
  have htail := integral_projKernel_tail_le' hR ha.le 2
  have hRa : 0 < (R * a) ^ 2 := by positivity
  have e : ∫ u, ‖Kt u‖ = ∫ u in S, ‖projKernel R u‖ := by
    rw [← integral_indicator hS]
    refine integral_congr_ae (Eventually.of_forall fun u => ?_)
    simp only [hKtdef, norm_indicator_eq_indicator_norm]
  rw [e, le_div_iff₀ hRa]
  exact htail

end

/-! ### `new:compact-highpass`: the contradiction -/

section
open Filter Topology MeasureTheory

theorem integrable_fourier_integrand {f : E3 → ℂ} (hf : Integrable f) (w : E3) :
    Integrable fun v => (𝐞 (-⟪v, w⟫) : ℂ) * f v :=
  hf.bdd_mul (c := 1) ((continuous_subtype_val.comp
    (Real.continuous_fourierChar.comp ((continuous_id.inner
      continuous_const).neg))).aestronglyMeasurable)
    (Eventually.of_forall fun v => by rw [Circle.norm_coe])

/-- The Fourier transform is additive on integrable functions. -/
theorem fourier_sub_of_integrable {f g : E3 → ℂ} (hf : Integrable f) (hg : Integrable g)
    (w : E3) : 𝓕 (fun x => f x - g x) w = 𝓕 f w - 𝓕 g w := by
  simp only [Real.fourier_eq, Circle.smul_def, smul_eq_mul]
  rw [← integral_sub (integrable_fourier_integrand hf w) (integrable_fourier_integrand hg w)]
  congr 1; funext v; ring

theorem fourier_const_mul (c : ℂ) (f : E3 → ℂ) (w : E3) :
    𝓕 (fun x => c * f x) w = c * 𝓕 f w := by
  simp only [Real.fourier_eq, Circle.smul_def, smul_eq_mul]
  rw [← integral_const_mul]
  congr 1; funext v; ring

/-- `‖f‖₂ ≤ c ‖g‖₂` in square-integral form. -/
theorem integral_sq_le_of_eLpNorm_le {f g : E3 → ℂ} (hf : MemLp f 2) (hg : MemLp g 2) {c : ℝ}
    (hc : 0 ≤ c) (h : eLpNorm f 2 volume ≤ ENNReal.ofReal c * eLpNorm g 2 volume) :
    ∫ x, ‖f x‖ ^ 2 ≤ c ^ 2 * ∫ x, ‖g x‖ ^ 2 := by
  have e : ∀ {u : E3 → ℂ}, MemLp u 2 → eLpNorm u 2 volume
      = ENNReal.ofReal (Real.sqrt (∫ x, ‖u x‖ ^ 2)) := fun {u} hu => by
    rw [hu.eLpNorm_eq_integral_rpow_norm (by norm_num) (by simp)]
    congr 1
    simp only [ENNReal.toReal_ofNat]
    rw [Real.sqrt_eq_rpow]
    congr 1
    · refine integral_congr_ae (Eventually.of_forall fun x => ?_)
      simp only
      rw [Real.rpow_two]
    · norm_num
  rw [e hf, e hg, ← ENNReal.ofReal_mul hc, ENNReal.ofReal_le_ofReal_iff (by positivity)] at h
  have hX : 0 ≤ ∫ x, ‖f x‖ ^ 2 := integral_nonneg fun x => sq_nonneg _
  have hY : 0 ≤ ∫ x, ‖g x‖ ^ 2 := integral_nonneg fun x => sq_nonneg _
  have h2 := pow_le_pow_left₀ (Real.sqrt_nonneg _) h 2
  rwa [Real.sq_sqrt hX, mul_pow, Real.sq_sqrt hY] at h2

/-- For `δ = μ^{1/(2A)}`, `δ^A = √μ`. -/
theorem rpow_inv_two_mul_pow {μ : ℝ} (hμ : 0 ≤ μ) {A : ℕ} (hA : 1 ≤ A) :
    (μ ^ (1 / (2 * (A : ℝ)))) ^ A = Real.sqrt μ := by
  rw [← Real.rpow_natCast, ← Real.rpow_mul hμ, Real.sqrt_eq_rpow]
  congr 1
  have : (A : ℝ) ≠ 0 := by have : (1 : ℝ) ≤ A := by exact_mod_cast hA
                           linarith
  field_simp

/-- A one-bounded function supported in `B_N(C)` has `‖f‖₂² ≤ 8 C³ N^6`. -/
theorem integral_sq_le_box {f : E3 → ℂ} (hf1 : ∀ x, ‖f x‖ ≤ 1) {C N : ℝ} (hC : 0 ≤ C)
    (hN : 0 ≤ N) (hfs : ∀ x, x ∉ petBox C N → f x = 0) :
    ∫ x, ‖f x‖ ^ 2 ≤ 8 * C ^ 3 * N ^ 6 := by
  have hbox := measurableSet_petBox C N
  have hfin : volume (petBox C N) ≠ ⊤ := (isBounded_petBox _ _).measure_lt_top.ne
  have hind := (integrableOn_const (C := (1 : ℝ)) hfin).integrable_indicator hbox
  calc ∫ x, ‖f x‖ ^ 2 ≤ ∫ x, (petBox C N).indicator (fun _ => (1 : ℝ)) x := by
        refine integral_mono_of_nonneg (Eventually.of_forall fun x => by positivity) hind
          (Eventually.of_forall fun x => ?_)
        beta_reduce
        by_cases hx : x ∈ petBox C N
        · rw [Set.indicator_of_mem hx]; exact pow_le_one₀ (norm_nonneg _) (hf1 x)
        · rw [Set.indicator_of_notMem hx, hfs x hx, norm_zero]; norm_num
    _ = 8 * C ^ 3 * N ^ 6 := by
        rw [integral_indicator_const _ hbox, smul_eq_mul, mul_one, measureReal_def,
          volume_petBox hC hN, ENNReal.toReal_ofReal (by positivity)]

set_option maxHeartbeats 4000000 in
-- The contradiction with the inverse theorem and all constants share one context.
open scoped Classical in
/-- **Theorem `new:compact-highpass`** (compact bounded-input high-frequency estimate). Fix
`C₀ ≥ 1` and `j`. There are `a ∈ (0, 1)`, `K₀ ≥ 1` and `C₁ ≥ 1` such that for `0 < μ ≤ 1`,
`N ≥ K₀ μ^{-K₀}` and Borel inputs bounded by one and supported in `B_N(C₀)`,
`‖(I - P_R^{(j)}) A_N^{*j}(g)‖₂ ≤ C₁ μ^a N^3` with `R = N^{-j} μ^{-2}` (in square-integral form).
Small `μ`: if `‖H‖₂² > M δ N^6` with `δ = μ^{1/(2A)}`, the pairing `⟨h, A_N^{*j}(g)⟩` with
`h = M⁻¹ 1_{B'} H` is the four-linear form with `j`-th input `h`, `patch:monomial-inverse` gives
`⟨h, P_L h⟩ ≥ A⁻¹ √μ N^6`, while `Ĥ = 0` on the support of `η(ξ_j / L)` leaves only the tail,
`⟨h, P_L h⟩ ≤ M^{-2} (B^{tail}_2 μ^4)² ‖G‖₂²`. -/
theorem compactHighpass (j : Fin 3) {C₀ : ℝ} (hC₀ : 1 ≤ C₀) :
    ∃ a K₀ C₁ : ℝ, 0 < a ∧ a < 1 ∧ 1 ≤ K₀ ∧ 1 ≤ C₁ ∧
      ∀ μ N : ℝ, 0 < μ → μ ≤ 1 → K₀ * μ ^ (-K₀) ≤ N →
        ∀ (g0 : E3 → ℂ) (g : Fin 3 → E3 → ℂ), Measurable g0 → (∀ i, Measurable (g i)) →
          (∀ x, ‖g0 x‖ ≤ 1) → (∀ i x, ‖g i x‖ ≤ 1) → (∀ x, x ∉ petBox C₀ N → g0 x = 0) →
          (∀ i x, x ∉ petBox C₀ N → g i x = 0) →
          ∫ x, ‖Astar N j g0 g x - P ((N ^ expo j)⁻¹ * (μ ^ 2)⁻¹) j (Astar N j g0 g) x‖ ^ 2
            ≤ (C₁ * μ ^ a * N ^ 3) ^ 2 := by
  obtain ⟨A, hA1, hMI⟩ := monomialInverse (C₀ := C₀ + 2) (by linarith)
  have hA1' : (1 : ℝ) ≤ A := by exact_mod_cast hA1
  have hA0 : (0 : ℝ) < A := by linarith
  set B0 := etaKerL1 with hB0def
  have hB0 : 0 ≤ B0 := etaKerL1_nonneg
  set M := 1 + B0 with hMdef
  have hM1 : 1 ≤ M := by linarith
  have hM0 : 0 < M := by linarith
  set V1 := 8 * (C₀ + 1) ^ 3 with hV1def
  have hV1 : 0 < V1 := by positivity
  set T := etaKerMom 2 with hTdef
  have hT : 0 ≤ T := etaKerMom_nonneg 2
  set C2 := T ^ 2 * V1 / M ^ 2 with hC2def
  have hC2 : 0 ≤ C2 := by positivity
  set ε := 1 / (2 * A * (1 + C2)) with hεdef
  have hε0 : 0 < ε := by positivity
  set μ0 := ε ^ 2 with hμ0def
  have hμ00 : 0 < μ0 := by positivity
  set a := 1 / (4 * (A : ℝ)) with hadef
  have ha0 : 0 < a := by positivity
  set C₁ := max (max (Real.sqrt M) (Real.sqrt V1 * μ0 ^ (-a))) 1 with hC₁def
  refine ⟨a, 2 * A, C₁, ha0, ?_, by linarith, le_max_right _ _, ?_⟩
  · rw [hadef, div_lt_one (by positivity)]; linarith
  intro μ N hμ0 hμ1 hNK g0 g hg0m hgm hg01 hg1 hg0s hgs
  have hμK : 1 ≤ μ ^ (-(2 * (A : ℝ))) :=
    Real.one_le_rpow_of_pos_of_le_one_of_nonpos hμ0 hμ1 (by linarith)
  have hN2 : 2 * (A : ℝ) ≤ N := by nlinarith
  have hN0 : 0 < N := by linarith
  have hNe : 0 < N ^ expo j := pow_pos hN0 _
  set s := Real.sqrt μ with hsdef
  have hs0 : 0 < s := Real.sqrt_pos.mpr hμ0
  have hs1 : s ≤ 1 := Real.sqrt_le_one.mpr hμ1
  have hμs : μ = s ^ 2 := (Real.sq_sqrt hμ0.le).symm
  set R := (N ^ expo j)⁻¹ * (μ ^ 2)⁻¹ with hRdef
  have hR : 0 < R := by positivity
  set G := Astar N j g0 g with hGdef
  have hGm : Measurable G := measurable_Astar j hg0m hgm
  obtain ⟨hG1, hGs⟩ := Astar_basic hN0 j hg01 hg1 hg0s
  rw [← hGdef] at hG1 hGs
  obtain ⟨E, hEeq, hHE, hEG⟩ := highpass_energy hN0.le (C := C₀ + 1) (by linarith) hR j hGm hG1
    hGs
  have hGL2 : ∫ x, ‖G x‖ ^ 2 ≤ V1 * N ^ 6 := integral_sq_le_box hG1 (by linarith) hN0.le hGs
  have hC₁M : Real.sqrt M ≤ C₁ := le_trans (le_max_left _ _) (le_max_left _ _)
  have hC₁V : Real.sqrt V1 * μ0 ^ (-a) ≤ C₁ := le_trans (le_max_right _ _) (le_max_left _ _)
  have hμa : 0 < μ ^ a := Real.rpow_pos_of_pos hμ0 a
  by_cases hμμ0 : μ0 < μ
  · -- large `μ`: the crude bound
    have h1 : μ0 ^ a ≤ μ ^ a := Real.rpow_le_rpow hμ00.le hμμ0.le ha0.le
    have h2 : Real.sqrt V1 ≤ C₁ * μ ^ a := by
      have e : Real.sqrt V1 = Real.sqrt V1 * μ0 ^ (-a) * μ0 ^ a := by
        rw [mul_assoc, ← Real.rpow_add hμ00, neg_add_cancel, Real.rpow_zero, mul_one]
      rw [e]
      exact mul_le_mul hC₁V h1 (Real.rpow_nonneg hμ00.le _) (by positivity)
    calc ∫ x, ‖G x - P R j G x‖ ^ 2 ≤ V1 * N ^ 6 := hHE.trans (hEG.trans hGL2)
      _ = (Real.sqrt V1 * N ^ 3) ^ 2 := by rw [mul_pow, Real.sq_sqrt hV1.le]; ring
      _ ≤ (C₁ * μ ^ a * N ^ 3) ^ 2 := by
          gcongr
  -- small `μ`
  push Not at hμμ0
  have hsε : s ≤ ε := by
    rw [hsdef, show ε = Real.sqrt (ε ^ 2) from (Real.sqrt_sq hε0.le).symm]
    exact Real.sqrt_le_sqrt hμμ0
  set δ := μ ^ (1 / (2 * (A : ℝ))) with hδdef
  have hδA : δ ^ A = s := rpow_inv_two_mul_pow hμ0.le hA1
  have hδ0 : 0 < δ := Real.rpow_pos_of_pos hμ0 _
  have hδ1 : δ ≤ 1 := Real.rpow_le_one hμ0.le hμ1 (by positivity)
  have hδa : δ = (μ ^ a) ^ 2 := by
    rw [hδdef, ← Real.rpow_natCast, ← Real.rpow_mul hμ0.le, hadef]
    congr 1; push_cast; field_simp; ring
  by_cases hsmall : ∫ x, ‖G x - P R j G x‖ ^ 2 ≤ M * δ * N ^ 6
  · calc ∫ x, ‖G x - P R j G x‖ ^ 2 ≤ M * δ * N ^ 6 := hsmall
      _ = (Real.sqrt M * μ ^ a * N ^ 3) ^ 2 := by
          rw [hδa, mul_pow, mul_pow, Real.sq_sqrt hM0.le]; ring
      _ ≤ (C₁ * μ ^ a * N ^ 3) ^ 2 := by gcongr
  exfalso
  push Not at hsmall
  -- the test function `h`
  set H : E3 → ℂ := fun x => G x - P R j G x with hHdef
  have hPb : ∀ x, ‖P R j G x‖ ≤ B0 := norm_P_le_of_norm_le_one hR j hG1
  have hHb : ∀ x, ‖H x‖ ≤ M := fun x => by
    rw [hHdef]; simp only
    exact (norm_sub_le _ _).trans (add_le_add (hG1 x) (hPb x))
  have hHm : Measurable H := hGm.sub (measurable_P j hGm)
  set h : E3 → ℂ := fun x => if x ∈ petBox (C₀ + 2) N then (M : ℂ)⁻¹ * H x else 0 with hhdef
  have hhm : Measurable h :=
    Measurable.ite (measurableSet_petBox _ _) (measurable_const.mul hHm) measurable_const
  have hh1 : ∀ x, ‖h x‖ ≤ 1 := fun x => by
    rw [hhdef]; simp only; split_ifs
    · rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hM0.le,
        inv_mul_le_iff₀ hM0, mul_one]
      exact hHb x
    · simp
  have hhs : ∀ x, x ∉ petBox (C₀ + 2) N → h x = 0 := fun x hx => by
    rw [hhdef]; simp only [ite_eq_right hx]
  have hbox01 : petBox C₀ N ⊆ petBox (C₀ + 2) N := petBox_mono (by linarith) hN0.le
  have hbox12 : petBox (C₀ + 1) N ⊆ petBox (C₀ + 2) N := petBox_mono (by linarith) hN0.le
  -- the pairing `⟨h, G⟩ = M⁻¹ E`
  have hpair : ∫ x, h x * conj (G x) = ((M⁻¹ * E : ℝ) : ℂ) := by
    have e : ∫ x, h x * conj (G x) = (M : ℂ)⁻¹ * ∫ x, H x * conj (G x) := by
      rw [← integral_const_mul]
      refine integral_congr_ae (Eventually.of_forall fun x => ?_)
      rw [hhdef]; simp only
      split_ifs with hx
      · ring
      · rw [hGs x fun h' => hx (hbox12 h')]; simp
    rw [e, hEeq]; push_cast; ring
  -- the four-linear form with `j`-th input `h`
  set f := Function.update g j h with hfdef
  have hfm : ∀ i, Measurable (f i) := fun i => by
    by_cases hi : i = j
    · rw [hi, hfdef, Function.update_self]; exact hhm
    · rw [hfdef, Function.update_of_ne hi]; exact hgm i
  have hf1 : ∀ i x, ‖f i x‖ ≤ 1 := fun i x => by
    by_cases hi : i = j
    · rw [hi, hfdef, Function.update_self]; exact hh1 x
    · rw [hfdef, Function.update_of_ne hi]; exact hg1 i x
  have hfs : ∀ i x, x ∉ petBox (C₀ + 2) N → f i x = 0 := fun i x hx => by
    by_cases hi : i = j
    · rw [hi, hfdef, Function.update_self]; exact hhs x hx
    · rw [hfdef, Function.update_of_ne hi]; exact hgs i x fun h' => hx (hbox01 h')
  have hAstar : Astar N j g0 f = G := by
    funext y
    simp only [hGdef, Astar, hfdef, adjShift_update]
  have hint1 : Integrable (Function.uncurry fun (x : E3) (t : ℝ) =>
      prodShift f x t * conj (g0 x)) ((volume : Measure E3).prod
        (volume.restrict (Set.Ioc (0 : ℝ) N))) := by
    have hm : Measurable (Function.uncurry fun (x : E3) (t : ℝ) =>
        prodShift f x t * conj (g0 x)) := by
      refine (Finset.measurable_prod _ fun i _ => ?_).mul
        (Complex.continuous_conj.measurable.comp (hg0m.comp measurable_fst))
      exact (hfm i).comp (measurable_fst.add (((continuous_curve i).measurable).comp
        measurable_snd))
    have hfin : ((volume : Measure E3).prod (volume.restrict (Set.Ioc (0 : ℝ) N)))
        (petBox C₀ N ×ˢ Set.univ) ≠ ⊤ := by
      rw [Measure.prod_prod]
      exact ENNReal.mul_ne_top (isBounded_petBox _ _).measure_lt_top.ne (by simp)
    refine IntegrableOn.integrable_of_forall_notMem_eq_zero (s := petBox C₀ N ×ˢ Set.univ)
      (Measure.integrableOn_of_bounded (M := 1) hfin hm.aestronglyMeasurable
        (Eventually.of_forall fun q => ?_)) (fun q hq => ?_)
    · simp only [Function.uncurry, prodShift]
      rw [norm_mul, norm_prod, RCLike.norm_conj]
      exact ((mul_le_of_le_one_left (norm_nonneg _) (Finset.prod_le_one₀ (fun _ _ => norm_nonneg
        _) fun i _ => hf1 i _)).trans (hg01 _))
    · simp only [Function.uncurry]
      rw [hg0s q.1 fun h' => hq ⟨h', Set.mem_univ _⟩, map_zero, mul_zero]
  have hΛ : Lambda N g0 f = ((M⁻¹ * E : ℝ) : ℂ) := by
    rw [adjoint_identity_of_integrable hN0 j hg0m hfm hint1, hAstar, hfdef,
      Function.update_self, hpair]
  have hΛb : δ * N ^ (6 : ℕ) ≤ ‖Lambda N g0 f‖ := by
    have hI0 : 0 ≤ ∫ x, ‖G x - P R j G x‖ ^ 2 := integral_nonneg fun x => sq_nonneg _
    rw [hΛ, Complex.norm_real, Real.norm_of_nonneg
      (mul_nonneg (inv_nonneg.mpr hM0.le) (le_trans hI0 hHE))]
    rw [inv_mul_eq_div, le_div_iff₀ hM0]
    nlinarith
  -- the inverse theorem
  have hthr : (A : ℝ) * (δ ^ A)⁻¹ ≤ N := by
    rw [hδA]
    have h1 : s⁻¹ ≤ μ ^ (-(2 * (A : ℝ))) := by
      rw [hsdef, Real.sqrt_eq_rpow, ← Real.rpow_neg hμ0.le]
      exact Real.rpow_le_rpow_of_exponent_ge hμ0 hμ1 (by linarith)
    have h2 : (A : ℝ) * s⁻¹ ≤ 2 * A * μ ^ (-(2 * (A : ℝ))) := by nlinarith
    linarith
  obtain ⟨E', hE'eq, hE'lo⟩ := hMI δ N hδ0 hδ1 hthr g0 f hg0m hfm hg01 hf1
    (fun x hx => hg0s x fun h' => hx (hbox01 h')) hfs hΛb j
  rw [hfdef, Function.update_self, hδA] at hE'eq
  rw [hδA] at hE'lo
  -- the upper bound through the tail
  set L := (A : ℝ) * s⁻¹ * (N ^ expo j)⁻¹ with hLdef
  have hL : 0 < L := by positivity
  have hLR : 2 * L ≤ R := by
    rw [hLdef, hRdef, hμs]
    have hs3 : 2 * A * s ^ 3 ≤ 1 := by
      have h1 : s ^ 3 ≤ s := by nlinarith [pow_le_one₀ hs0.le hs1 (n := 2)]
      have h2 : 2 * A * s ≤ 1 := by
        have : 2 * A * ε ≤ 1 := by
          rw [hεdef, mul_one_div, div_le_one (by positivity)]; nlinarith
        nlinarith
      nlinarith
    rw [← pow_mul, show 2 * 2 = 4 by norm_num]
    have : 2 * (A * s⁻¹ * (N ^ expo j)⁻¹) = (2 * A * s ^ 3) * ((N ^ expo j)⁻¹ * (s ^ 4)⁻¹) := by
      field_simp
    rw [this]
    exact mul_le_of_le_one_left (by positivity) hs3
  obtain ⟨hGi, hG2⟩ := integrable_memLp_of_box hGm hG1 (by linarith) hN0.le hGs
  have hPi := integrable_P_of_measurable hR j hGm hGi
  have hP2 := memLp_two_P hR j hGm hG2
  have hHi : Integrable H := hGi.sub hPi
  have hH2 : MemLp H 2 := hG2.sub hP2
  set Tt := (petBox (C₀ + 2) N)ᶜ.indicator H with hTtdef
  have hTti : Integrable Tt := hHi.indicator (measurableSet_petBox _ _).compl
  have hTt2 : MemLp Tt 2 := hH2.indicator (measurableSet_petBox _ _).compl
  obtain ⟨hhi, hh2⟩ := integrable_memLp_of_box hhm hh1 (by linarith) hN0.le hhs
  have hhT : h = fun x => (M : ℂ)⁻¹ * (H x - Tt x) := by
    funext x
    rw [hhdef, hTtdef]; simp only
    by_cases hx : x ∈ petBox (C₀ + 2) N
    · rw [ite_eq_left hx, Set.indicator_of_notMem (Set.notMem_compl_iff.mpr hx), sub_zero]
    · rw [ite_eq_right hx, Set.indicator_of_mem (Set.mem_compl hx), sub_self, mul_zero]
  have hFh : ∀ ξ, 𝓕 h ξ = (M : ℂ)⁻¹ * (𝓕 G ξ - (eta (ξ j / R) : ℂ) * 𝓕 G ξ - 𝓕 Tt ξ) := by
    intro ξ
    rw [hhT, fourier_const_mul, fourier_sub_of_integrable hHi hTti,
      show H = fun x => G x - P R j G x from rfl, fourier_sub_of_integrable hGi hPi,
      fourier_P_of_measurable hR j hGm hGi]
  have hpt : ∀ ξ, eta (ξ j / L) * ‖𝓕 h ξ‖ ^ 2 ≤ (M ^ 2)⁻¹ * ‖𝓕 Tt ξ‖ ^ 2 := by
    intro ξ
    by_cases he : eta (ξ j / L) = 0
    · rw [he, zero_mul]; positivity
    · have h1 := eta_div_eq_one_of_eta_ne_zero hL hLR he
      rw [hFh, h1, Complex.ofReal_one, one_mul, sub_self, zero_sub, norm_mul, norm_neg,
        norm_inv, Complex.norm_real, Real.norm_of_nonneg hM0.le, mul_pow, inv_pow]
      have := eta_le_one (ξ j / L)
      have h0 : 0 ≤ (M ^ 2)⁻¹ * ‖𝓕 Tt ξ‖ ^ 2 := by positivity
      nlinarith
  have hE'up : E' ≤ (M ^ 2)⁻¹ * ∫ x, ‖Tt x‖ ^ 2 := by
    have e := integral_mul_conj_P_eq hL j hhm hhi hh2
    rw [hE'eq] at e
    have hE'real : E' = ∫ ξ, eta (ξ j / L) * ‖𝓕 h ξ‖ ^ 2 := by exact_mod_cast e
    rw [hE'real, ← integral_norm_sq_fourier hTti hTt2, ← integral_const_mul]
    have hFT2 : Integrable fun ξ => ‖𝓕 Tt ξ‖ ^ 2 :=
      (memLp_two_fourier hTti hTt2).integrable_norm_pow (by norm_num)
    have hFh2 : Integrable fun ξ => ‖𝓕 h ξ‖ ^ 2 :=
      (memLp_two_fourier hhi hh2).integrable_norm_pow (by norm_num)
    refine integral_mono (hFh2.bdd_mul (c := 1) ((eta_continuous.comp (show Continuous
        fun ξ : E3 => ξ j / L by fun_prop)).aestronglyMeasurable)
      (Eventually.of_forall fun ξ => by
        rw [Real.norm_of_nonneg (eta_nonneg _)]; exact eta_le_one _))
      (hFT2.const_mul _) hpt
  have htail := highpass_tail hN0 hR j (C := C₀ + 1) hGm hGs
  rw [show C₀ + 1 + 1 = C₀ + 2 by ring] at htail
  have hRNe : R * N ^ expo j = (s ^ 4)⁻¹ := by
    rw [hRdef, hμs, ← pow_mul]; field_simp
  rw [hRNe] at htail
  have htail2 := integral_sq_le_of_eLpNorm_le hTt2 hG2 (by positivity) htail
  have hTs : T / ((s ^ 4)⁻¹) ^ 2 = T * s ^ 8 := by field_simp
  rw [hTs] at htail2
  -- the contradiction
  have hchain : (A : ℝ)⁻¹ * s * N ^ (6 : ℕ) ≤ C2 * s ^ 16 * N ^ (6 : ℕ) := by
    refine hE'lo.trans (hE'up.trans ?_)
    calc (M ^ 2)⁻¹ * ∫ x, ‖Tt x‖ ^ 2 ≤ (M ^ 2)⁻¹ * ((T * s ^ 8) ^ 2 * (V1 * N ^ 6)) := by
          gcongr
          exact htail2.trans (mul_le_mul_of_nonneg_left hGL2 (by positivity))
      _ = C2 * s ^ 16 * N ^ (6 : ℕ) := by rw [hC2def]; field_simp
  have hN6 : 0 < N ^ (6 : ℕ) := by positivity
  have h1 : (A : ℝ)⁻¹ * s ≤ C2 * s ^ 16 := le_of_mul_le_mul_right hchain hN6
  have h2 : 1 ≤ A * C2 * s ^ 15 := by
    have : (A : ℝ)⁻¹ * s * (A * s⁻¹) ≤ C2 * s ^ 16 * (A * s⁻¹) :=
      mul_le_mul_of_nonneg_right h1 (by positivity)
    have e1 : (A : ℝ)⁻¹ * s * (A * s⁻¹) = 1 := by field_simp
    have e2 : C2 * s ^ 16 * (A * s⁻¹) = A * C2 * s ^ 15 := by field_simp
    linarith
  have h3 : A * C2 * s ^ 15 ≤ A * C2 * ε := by
    have : s ^ 15 ≤ s := pow_le_of_le_one hs0.le hs1 (by norm_num)
    have : s ^ 15 ≤ ε := this.trans hsε
    exact mul_le_mul_of_nonneg_left this (by positivity)
  have h4 : A * C2 * ε < 1 := by
    rw [hεdef]
    rw [mul_one_div, div_lt_one (by positivity)]
    nlinarith
  linarith

end

/-! ### `new:compact-decaying-point`: the adjoint as a trilinear form -/

section
open Filter Topology MeasureTheory

/-- The translations of the three slots of the adjoint: slot `0` carries `g_0(y - t^j e_j)`,
slots `1, 2` carry the inputs `j + 1`, `j + 2` at `y - t^j e_j + t^i e_i`. -/
noncomputable def adjVec (j k : Fin 3) (t : ℝ) : E3 :=
  if k = 0 then -curve j t else -curve j t + curve (j + k) t

theorem continuous_adjVec (j k : Fin 3) : Continuous (adjVec j k) := by
  unfold adjVec
  split_ifs
  · exact (continuous_curve j).neg
  · exact (continuous_curve j).neg.add (continuous_curve _)

/-- **The adjoint as a trilinear form**: `adjT N j g (y) = E_t ∏_k g_k(y + adjVec j k t)`. -/
noncomputable def adjT (N : ℝ) (j : Fin 3) (g : Fin 3 → E3 → ℂ) (y : E3) : ℂ :=
  (N : ℂ)⁻¹ * ∫ t in (0 : ℝ)..N, ∏ k : Fin 3, g k (y + adjVec j k t)

/-- The inputs of `A_N^{*j}` realizing `adjT` (the conjugations of the adjoint undone). -/
noncomputable def adjIn (j : Fin 3) (g : Fin 3 → E3 → ℂ) : Fin 3 → E3 → ℂ :=
  fun i => if i = j + 1 then fun x => conj (g 1 x)
    else if i = j + 2 then fun x => conj (g 2 x) else fun _ => 0

theorem univ_erase_eq (j : Fin 3) : Finset.univ.erase j = {j + 1, j + 2} := by
  fin_cases j <;> decide

theorem Astar_adjIn (N : ℝ) (j : Fin 3) (g : Fin 3 → E3 → ℂ) :
    Astar N j (g 0) (adjIn j g) = adjT N j g := by
  funext y
  rw [Astar, adjT]
  congr 1
  refine intervalIntegral.integral_congr fun t _ => ?_
  have h12 : j + 1 ≠ j + 2 := by fin_cases j <;> decide
  have h1 : j + 1 ≠ j + 2 := h12
  rw [adjShift, univ_erase_eq, Finset.prod_pair h12, Fin.prod_univ_three]
  simp only [adjIn, adjVec, ite_eq_right h1,
    show (1 : Fin 3) ≠ 0 by decide, show (2 : Fin 3) ≠ 0 by decide, ite_false]
  have h2 : ¬ (j + 2 = j + 1) := fun h => h12 h.symm
  simp only [ite_eq_right h2, ite_true, Complex.conj_conj, sub_eq_add_neg, add_assoc]
  ring

theorem measurable_adjT {N : ℝ} (hN : 0 ≤ N) (j : Fin 3) {g : Fin 3 → E3 → ℂ}
    (hg : ∀ k, Measurable (g k)) : Measurable (adjT N j g) := by
  have hm : Measurable (Function.uncurry fun (y : E3) (t : ℝ) =>
      ∏ k : Fin 3, g k (y + adjVec j k t)) :=
    Finset.measurable_prod _ fun k _ => (hg k).comp (measurable_fst.add
      ((continuous_adjVec j k).measurable.comp measurable_snd))
  exact measurable_const.mul (measurable_intervalIntegral_param hm hN)

theorem norm_adjT_le {N : ℝ} (hN : 0 < N) (j : Fin 3) {g : Fin 3 → E3 → ℂ} {b : Fin 3 → ℝ}
    (hb : ∀ k x, ‖g k x‖ ≤ b k) (y : E3) : ‖adjT N j g y‖ ≤ ∏ k, b k := by
  have hb0 : ∀ k, 0 ≤ b k := fun k => (norm_nonneg _).trans (hb k 0)
  rw [adjT, norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hN.le,
    inv_mul_le_iff₀ hN]
  have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := N)
    (C := ∏ k, b k) (f := fun t => ∏ k : Fin 3, g k (y + adjVec j k t)) fun t _ => by
      rw [norm_prod]; exact Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _) fun k _ => hb k _
  rw [sub_zero, abs_of_pos hN] at h
  linarith

theorem prod_update_fin3 {g : Fin 3 → E3 → ℂ} (i : Fin 3) (w : E3 → ℂ) (x : Fin 3 → E3) :
    ∏ k : Fin 3, Function.update g i w k (x k)
      = w (x i) * ∏ k ∈ Finset.univ.erase i, g k (x k) := by
  rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ i), Function.update_self]
  congr 1
  exact Finset.prod_congr rfl fun k hk => by rw [Function.update_of_ne (Finset.ne_of_mem_erase hk)]

theorem intervalIntegrable_of_norm_le {f : ℝ → ℂ} (hf : Measurable f) {C : ℝ}
    (hC : ∀ t, ‖f t‖ ≤ C) (a b : ℝ) : IntervalIntegrable f volume a b :=
  (intervalIntegrable_const (c := C)).mono_fun' hf.aestronglyMeasurable (Eventually.of_forall hC)

theorem intervalIntegrable_adjT_slot {j : Fin 3} {g : Fin 3 → E3 → ℂ}
    (hg : ∀ l, BddMeasC (g l)) {u : E3 → ℂ} (hu : BddMeasC u) (i : Fin 3) (y : E3) (a b : ℝ) :
    IntervalIntegrable (fun t => u (y + adjVec j i t)
      * ∏ k ∈ Finset.univ.erase i, g k (y + adjVec j k t)) volume a b := by
  obtain ⟨hum, Cu, hCu⟩ := hu
  choose Cg hCg using fun l : Fin 3 => (hg l).2
  have hmeas : Measurable fun t => u (y + adjVec j i t)
      * ∏ k ∈ Finset.univ.erase i, g k (y + adjVec j k t) :=
    (hum.comp (measurable_const.add (continuous_adjVec j i).measurable)).mul
      (Finset.measurable_prod _ fun k _ =>
        (hg k).1.comp (measurable_const.add (continuous_adjVec j k).measurable))
  exact intervalIntegrable_of_norm_le hmeas (C := Cu * ∏ k ∈ Finset.univ.erase i, Cg k)
    (fun t => by
      rw [norm_mul, norm_prod]
      exact mul_le_mul (hCu _) (Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _)
        fun k _ => hCg k _) (Finset.prod_nonneg fun _ _ => norm_nonneg _)
        ((norm_nonneg _).trans (hCu (y + adjVec j i 0)))) a b

theorem prod_update_adjVec (j i : Fin 3) (g : Fin 3 → E3 → ℂ) (w : E3 → ℂ) (y : E3) (t : ℝ) :
    ∏ k : Fin 3, Function.update g i w k (y + adjVec j k t)
      = w (y + adjVec j i t) * ∏ k ∈ Finset.univ.erase i, g k (y + adjVec j k t) :=
  prod_update_fin3 (g := g) i w (fun k => y + adjVec j k t)

/-- **The adjoint form is trilinear** on bounded measurable slots. -/
theorem trilin_adjT (N : ℝ) (j : Fin 3) : Trilin (adjT N j) := by
  intro i g u v c hg hu hv
  funext y
  simp only [adjT]
  simp_rw [prod_update_adjVec]
  have hring : ∀ t : ℝ, (c * u (y + adjVec j i t) + v (y + adjVec j i t))
        * ∏ k ∈ Finset.univ.erase i, g k (y + adjVec j k t)
      = c * (u (y + adjVec j i t) * ∏ k ∈ Finset.univ.erase i, g k (y + adjVec j k t))
        + v (y + adjVec j i t) * ∏ k ∈ Finset.univ.erase i, g k (y + adjVec j k t) := by
    intro t; ring
  simp_rw [hring]
  rw [intervalIntegral.integral_add ((intervalIntegrable_adjT_slot hg hu i y 0 N).const_mul c)
    (intervalIntegrable_adjT_slot hg hv i y 0 N), intervalIntegral.integral_const_mul]
  ring

theorem integrable_projKernel_mul_bdd {R : ℝ} (hR : 0 < R) (j : Fin 3) {f : E3 → ℂ}
    (hf : BddMeasC f) (x : E3) : Integrable fun u : ℝ => projKernel R u * f (x - u • basisVec j)
      := by
  obtain ⟨hfm, C, hC⟩ := hf
  have h := integrable_projKernel_mul_of_bdd hR j hfm hC x 0
  simpa using h

/-- `P_R^{(j)}` is linear on bounded measurable functions. -/
theorem P_linear {R : ℝ} (hR : 0 < R) (j : Fin 3) {F F' : E3 → ℂ} (hF : BddMeasC F)
    (hF' : BddMeasC F') (c : ℂ) :
    P R j (fun x => c * F x + F' x) = fun x => c * P R j F x + P R j F' x := by
  funext x
  simp only [P]
  have e : ∀ u : ℝ, projKernel R u * (c * F (x - u • basisVec j) + F' (x - u • basisVec j))
      = c * (projKernel R u * F (x - u • basisVec j)) + projKernel R u * F' (x - u • basisVec j) :=
    fun u => by ring
  simp_rw [e]
  rw [integral_add ((integrable_projKernel_mul_bdd hR j hF x).const_mul c)
    (integrable_projKernel_mul_bdd hR j hF' x), integral_const_mul]

theorem bddMeasC_adjT {N : ℝ} (hN : 0 < N) (j : Fin 3) {g : Fin 3 → E3 → ℂ}
    (hg : ∀ k, BddMeasC (g k)) : BddMeasC (adjT N j g) := by
  choose hgm C hC using hg
  exact ⟨measurable_adjT hN.le j hgm, ∏ k, C k, norm_adjT_le hN j hC⟩

/-- The high-frequency part of the adjoint form, `(I - P_R^{(j)}) adjT`. -/
noncomputable def hpAdj (N R : ℝ) (j : Fin 3) (g : Fin 3 → E3 → ℂ) (y : E3) : ℂ :=
  adjT N j g y - P R j (adjT N j g) y

/-- **`(I - P_R) A_N^{*j}` is trilinear** after undoing the conjugations. -/
theorem trilin_hpAdj {N R : ℝ} (hN : 0 < N) (hR : 0 < R) (j : Fin 3) : Trilin (hpAdj N R j) := by
  intro i g u v c hg hu hv
  have hA := trilin_adjT N j i g u v c hg hu hv
  have hbu := bddMeasC_adjT hN j (bddMeasC_update hg i hu)
  have hbv := bddMeasC_adjT hN j (bddMeasC_update hg i hv)
  funext y
  simp only [hpAdj]
  rw [hA, P_linear hR j hbu hbv c]
  ring

theorem measurable_hpAdj {N R : ℝ} (hN : 0 ≤ N) (j : Fin 3) {g : Fin 3 → E3 → ℂ}
    (hg : ∀ k, Measurable (g k)) : Measurable (hpAdj N R j g) :=
  (measurable_adjT hN j hg).sub (measurable_P j (measurable_adjT hN j hg))

/-- **a.e.-equal inputs give a.e.-equal adjoint forms.** -/
theorem adjT_ae_congr {N : ℝ} (hN : 0 ≤ N) (j : Fin 3) {g g' : Fin 3 → E3 → ℂ}
    (h : ∀ k, g k =ᵐ[volume] g' k) : adjT N j g =ᵐ[volume] adjT N j g' := by
  have hk : ∀ k, ∀ᵐ y ∂(volume : Measure E3), ∀ᵐ t ∂(volume.restrict (Set.Ioc (0 : ℝ) N)),
      g k (y + adjVec j k t) = g' k (y + adjVec j k t) := fun k =>
    ae_ae_comp_add_eq (continuous_adjVec j k).measurable (h k)
  filter_upwards [hk 0, hk 1, hk 2] with y h0 h1 h2
  rw [adjT, adjT, intervalIntegral.integral_of_le hN, intervalIntegral.integral_of_le hN]
  congr 1
  refine integral_congr_ae ?_
  filter_upwards [h0, h1, h2] with t e0 e1 e2
  rw [Fin.prod_univ_three, Fin.prod_univ_three, e0, e1, e2]

/-- **a.e.-equal inputs give a.e.-equal smoothings.** -/
theorem P_ae_congr (R : ℝ) (j : Fin 3) {F F' : E3 → ℂ} (h : F =ᵐ[volume] F') :
    P R j F =ᵐ[volume] P R j F' := by
  have hv : Measurable fun u : ℝ => -(u • basisVec j) := (measurable_id.smul_const _).neg
  have h' := ae_ae_comp_add_eq (ν := (volume : Measure ℝ)) hv h
  filter_upwards [h'] with x hx
  simp only [P]
  refine integral_congr_ae ?_
  filter_upwards [hx] with u hu
  simp only [sub_eq_add_neg]
  rw [hu]

theorem hpAdj_ae_congr {N : ℝ} (hN : 0 ≤ N) (R : ℝ) (j : Fin 3) {g g' : Fin 3 → E3 → ℂ}
    (h : ∀ k, g k =ᵐ[volume] g' k) : hpAdj N R j g =ᵐ[volume] hpAdj N R j g' := by
  have h1 := adjT_ae_congr hN j h
  have h2 := P_ae_congr R j h1
  filter_upwards [h1, h2] with y e1 e2
  simp only [hpAdj]
  rw [e1, e2]

end

/-! ### `new:compact-decaying-point`: the two endpoints -/

section
open Filter Topology MeasureTheory

theorem eLpNorm_two_eq_sqrt {u : E3 → ℂ} (hu : MemLp u 2) :
    eLpNorm u 2 volume = ENNReal.ofReal (Real.sqrt (∫ x, ‖u x‖ ^ 2)) := by
  rw [hu.eLpNorm_eq_integral_rpow_norm (by norm_num) (by simp)]
  congr 1
  simp only [ENNReal.toReal_ofNat]
  rw [Real.sqrt_eq_rpow]
  congr 1
  · refine integral_congr_ae (Eventually.of_forall fun x => ?_)
    simp only
    rw [Real.rpow_two]
  · norm_num

theorem P_const_mul (R : ℝ) (j : Fin 3) (c : ℂ) (F : E3 → ℂ) :
    P R j (fun x => c * F x) = fun x => c * P R j F x := by
  funext x
  simp only [P]
  rw [← integral_const_mul]
  congr 1; funext u; ring

/-- **`I - P_R^{(j)}` is an `L²` contraction** on bounded box-supported functions. -/
theorem integral_sq_sub_P_le {N C R : ℝ} (hN : 0 ≤ N) (hC : 0 ≤ C) (hR : 0 < R) (j : Fin 3)
    {G : E3 → ℂ} (hGm : Measurable G) {B : ℝ} (hGB : ∀ x, ‖G x‖ ≤ B)
    (hGs : ∀ x, x ∉ petBox C N → G x = 0) :
    ∫ x, ‖G x - P R j G x‖ ^ 2 ≤ ∫ x, ‖G x‖ ^ 2 := by
  have hB0 : 0 ≤ B := (norm_nonneg _).trans (hGB 0)
  rcases eq_or_lt_of_le hB0 with hB | hB
  · have hG0 : G = fun _ => 0 := funext fun x => norm_le_zero_iff.mp (hB ▸ hGB x)
    subst hG0
    simp [P]
  set G' : E3 → ℂ := fun x => (B : ℂ)⁻¹ * G x with hG'def
  have hG'1 : ∀ x, ‖G' x‖ ≤ 1 := fun x => by
    rw [hG'def]; simp only
    rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hB0, inv_mul_le_iff₀ hB,
      mul_one]
    exact hGB x
  obtain ⟨E, _, hHE, hEG⟩ := highpass_energy hN hC hR j (G := G')
    (measurable_const.mul hGm) hG'1
    (fun x hx => by rw [hG'def]; simp only; rw [hGs x hx, mul_zero])
  rw [hG'def, P_const_mul] at hHE
  rw [hG'def] at hEG
  have e1 : ∀ x, ‖(B : ℂ)⁻¹ * G x - (B : ℂ)⁻¹ * P R j G x‖ ^ 2
      = (B ^ 2)⁻¹ * ‖G x - P R j G x‖ ^ 2 := fun x => by
    rw [← mul_sub, norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hB0, mul_pow,
      inv_pow]
  have e2 : ∀ x, ‖(B : ℂ)⁻¹ * G x‖ ^ 2 = (B ^ 2)⁻¹ * ‖G x‖ ^ 2 := fun x => by
    rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hB0, mul_pow, inv_pow]
  simp_rw [e1] at hHE
  simp_rw [e2] at hEG
  rw [integral_const_mul] at hHE hEG
  have h := hHE.trans hEG
  have hB2 : 0 < (B ^ 2)⁻¹ := by positivity
  exact le_of_mul_le_mul_left h hB2

/-- The adjoint form vanishes off `B_N(C + 1)` when its slot `0` vanishes off `B_N(C)`. -/
theorem adjT_eq_zero {N C : ℝ} (hN : 0 < N) (j : Fin 3) {g : Fin 3 → E3 → ℂ}
    (hgs : ∀ x, x ∉ petBox C N → g 0 x = 0) {y : E3} (hy : y ∉ petBox (C + 1) N) :
    adjT N j g y = 0 := by
  rw [adjT]
  have h0 : ∀ t ∈ Set.uIcc (0 : ℝ) N, ∏ k : Fin 3, g k (y + adjVec j k t) = 0 := by
    intro t ht
    rw [Set.uIcc_of_le hN.le] at ht
    rw [Fin.prod_univ_three]
    simp only [adjVec, ite_true]
    rw [hgs _ (fun hm => hy fun i => ?_), zero_mul, zero_mul]
    have hi := hm i
    have hNi : 0 ≤ N ^ expo i := pow_nonneg hN.le _
    by_cases hij : i = j
    · subst hij
      have ht1 : 0 ≤ t ^ expo i := pow_nonneg ht.1 _
      have ht2 : t ^ expo i ≤ N ^ expo i := pow_le_pow_left₀ ht.1 ht.2 _
      simp only [curve, PiLp.add_apply, PiLp.neg_apply, PiLp.smul_apply, smul_eq_mul, basisVec,
        PiLp.single_apply, ite_true, mul_one] at hi
      constructor <;> nlinarith [hi.1, hi.2]
    · simp only [curve, PiLp.add_apply, PiLp.neg_apply, PiLp.smul_apply, smul_eq_mul, basisVec,
        PiLp.single_apply, ite_eq_right hij, mul_zero, neg_zero, add_zero] at hi
      constructor <;> nlinarith [hi.1, hi.2]
  rw [intervalIntegral.integral_congr h0]
  simp

theorem memLp_of_box {f : E3 → ℂ} (hf : Measurable f) {b : ℝ} (hb : ∀ x, ‖f x‖ ≤ b)
    {C N : ℝ} (hfs : ∀ x, x ∉ petBox C N → f x = 0) (p : ℝ≥0∞) : MemLp f p volume := by
  obtain ⟨R₀, hR₀⟩ := (isBounded_petBox C N).subset_closedBall (0 : E3)
  exact memLp_of_bdd_of_ball hf hb (M := R₀) (fun x hx => by
    refine hfs x fun h => ?_
    have := hR₀ h
    rw [Metric.mem_closedBall, dist_zero_right] at this
    linarith) p

theorem measurable_adjIn (j : Fin 3) {g : Fin 3 → E3 → ℂ} (hg : ∀ k, Measurable (g k)) (i : Fin 3) :
    Measurable (adjIn j g i) := by
  unfold adjIn
  split_ifs
  · exact Complex.continuous_conj.measurable.comp (hg 1)
  · exact Complex.continuous_conj.measurable.comp (hg 2)
  · exact measurable_const

theorem eLpNorm_conj_eq (f : E3 → ℂ) (p : ℝ≥0∞) :
    eLpNorm (fun x => conj (f x)) p volume = eLpNorm f p volume :=
  MeasureTheory.eLpNorm_conj _ _ _

theorem hpAdj_eLpNorm_le_adjT {N R C₀ : ℝ} (hN : 0 < N) (hR : 0 < R) (hC₀ : 0 ≤ C₀) (j : Fin 3)
    {g : Fin 3 → E3 → ℂ} (hgm : ∀ k, Measurable (g k)) {b : Fin 3 → ℝ}
    (hb : ∀ k x, ‖g k x‖ ≤ b k) (hgs : ∀ x, x ∉ petBox C₀ N → g 0 x = 0) :
    eLpNorm (hpAdj N R j g) 2 volume ≤ eLpNorm (adjT N j g) 2 volume := by
  have hGm := measurable_adjT hN.le j hgm
  have hGB := norm_adjT_le hN j hb
  have hGs : ∀ y, y ∉ petBox (C₀ + 1) N → adjT N j g y = 0 := fun y hy =>
    adjT_eq_zero hN j hgs hy
  have hG2 := memLp_of_box hGm hGB hGs 2
  have hH2 : MemLp (hpAdj N R j g) 2 volume := hG2.sub (memLp_two_P hR j hGm hG2)
  rw [eLpNorm_two_eq_sqrt hH2, eLpNorm_two_eq_sqrt hG2]
  exact ENNReal.ofReal_le_ofReal (Real.sqrt_le_sqrt
    (integral_sq_sub_P_le hN.le (by linarith) hR j hGm hGB hGs))

/-- **The improving endpoint for `(I - P_R) A_N^{*j}`**: `‖hpAdj(g)‖₂ ≤ C N^{-1/20}
‖g_0‖_6 ‖g_1‖_{40/7} ‖g_2‖_6` for bounded box-supported inputs (`patch:improving` composed with
the `L²` contraction `I - P_R`). -/
theorem hpAdj_improving (j : Fin 3) : ∃ C : ℝ, 0 ≤ C ∧ ∀ N R C₀ : ℝ, 0 < N → 0 < R → 0 ≤ C₀ →
    ∀ g : Fin 3 → E3 → ℂ, (∀ k, Measurable (g k)) → (∀ k, ∃ b : ℝ, ∀ x, ‖g k x‖ ≤ b) →
      (∀ k x, x ∉ petBox C₀ N → g k x = 0) →
      eLpNorm (hpAdj N R j g) (ENNReal.ofReal 2) volume
        ≤ ENNReal.ofReal (C * N ^ (-(1 : ℝ) / 20))
          * ∏ k, eLpNorm (g k) (ENNReal.ofReal (![6, 40 / 7, 6] k)) volume := by
  have h1 : j ≠ j + 1 := by fin_cases j <;> decide
  have h2 : j + 2 ≠ j + 1 := by fin_cases j <;> decide
  have h3 : j ≠ j + 2 := by fin_cases j <;> decide
  obtain ⟨Ck, hCk, hK⟩ := kosz53_of_memLp h1 h2 h3
  refine ⟨Ck.toReal, ENNReal.toReal_nonneg, ?_⟩
  intro N R C₀ hN hR hC₀ g hgm hgb hgs
  choose b hb using hgb
  have hmem : ∀ k p, MemLp (g k) p volume := fun k p => memLp_of_box (hgm k) (hb k) (hgs k) p
  have hconj : ∀ k p, MemLp (fun x => conj (g k x)) p volume := fun k p =>
    memLp_of_box (f := fun x => conj (g k x)) (Complex.continuous_conj.measurable.comp (hgm k))
      (fun x => by rw [RCLike.norm_conj]; exact hb k x)
      (fun x hx => by rw [hgs k x hx, map_zero]) p
  have hA1 : adjIn j g (j + 1) = fun x => conj (g 1 x) := by simp [adjIn]
  have hA2 : adjIn j g (j + 2) = fun x => conj (g 2 x) := by simp [adjIn, h2]
  have hk := hK N hN (g 0) (hgm 0) (adjIn j g) (measurable_adjIn j hgm) (hmem 0 _)
    (by rw [hA1]; exact hconj 1 _) (by rw [hA2]; exact hconj 2 _)
  rw [hA1, hA2, eLpNorm_conj_eq, eLpNorm_conj_eq, Astar_adjIn] at hk
  have e2 : ENNReal.ofReal 2 = 2 := ENNReal.ofReal_ofNat 2
  calc eLpNorm (hpAdj N R j g) (ENNReal.ofReal 2) volume
      = eLpNorm (hpAdj N R j g) 2 volume := by rw [e2]
    _ ≤ eLpNorm (adjT N j g) 2 volume := hpAdj_eLpNorm_le_adjT hN hR hC₀ j hgm hb (hgs 0)
    _ = eLpNorm (adjT N j g) (ENNReal.ofReal 2) volume := by rw [e2]
    _ ≤ _ := hk
    _ = _ := ?_
  rw [Fin.prod_univ_three, ENNReal.ofReal_mul ENNReal.toReal_nonneg, ENNReal.ofReal_toReal hCk]
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
    Matrix.tail_cons]
  ring

theorem eLpNorm_const_mul_fun (c : ℂ) (f : E3 → ℂ) (p : ℝ≥0∞) :
    eLpNorm (fun y => c * f y) p volume = ‖c‖ₑ * eLpNorm f p volume :=
  eLpNorm_const_smul c f p volume

theorem hpAdj_smul (N R : ℝ) (j : Fin 3) (c : Fin 3 → ℂ) (g : Fin 3 → E3 → ℂ) :
    hpAdj N R j (fun k x => c k * g k x) = fun y => (∏ k, c k) * hpAdj N R j g y := by
  have hA : adjT N j (fun k x => c k * g k x) = fun y => (∏ k, c k) * adjT N j g y := by
    funext y
    simp only [adjT, Finset.prod_mul_distrib]
    rw [intervalIntegral.integral_const_mul]; ring
  funext y
  simp only [hpAdj]
  rw [hA, P_const_mul]; ring

theorem hpAdj_eq_zero_of_slot {N R : ℝ} (j : Fin 3) {g : Fin 3 → E3 → ℂ} {k : Fin 3}
    (hk : g k = fun _ => 0) : hpAdj N R j g = fun _ => 0 := by
  have hA : adjT N j g = fun _ => 0 := by
    funext y
    simp only [adjT]
    rw [intervalIntegral.integral_congr (g := fun _ => (0 : ℂ)) fun t _ =>
      Finset.prod_eq_zero (Finset.mem_univ k) (by rw [hk])]
    simp
  funext y
  simp [hpAdj, hA, P]

set_option maxHeartbeats 1000000 in
-- The null-set modification, the scaling and the normalized bound share one context.
/-- **The bounded endpoint for `(I - P_R) A_N^{*j}` in `L^∞` form**: from
`Auto.compactHighpass` by removing null sets and scaling. -/
theorem hpAdj_bounded (j : Fin 3) {C₀ : ℝ} (hC₀ : 1 ≤ C₀) :
    ∃ a K₀ C₁ : ℝ, 0 < a ∧ a < 1 ∧ 1 ≤ K₀ ∧ 1 ≤ C₁ ∧
      ∀ μ N : ℝ, 0 < μ → μ ≤ 1 → K₀ * μ ^ (-K₀) ≤ N →
        ∀ g : Fin 3 → E3 → ℂ, (∀ k, Measurable (g k)) → (∀ k, ∃ b : ℝ, ∀ x, ‖g k x‖ ≤ b) →
          (∀ k x, x ∉ petBox C₀ N → g k x = 0) →
          eLpNorm (hpAdj N ((N ^ expo j)⁻¹ * (μ ^ 2)⁻¹) j g) (ENNReal.ofReal 2) volume
            ≤ ENNReal.ofReal (C₁ * μ ^ a * N ^ 3) * ∏ k, eLpNorm (g k) ⊤ volume := by
  obtain ⟨a, K₀, C₁, ha0, ha1, hK₀, hC₁, hHP⟩ := compactHighpass j hC₀
  refine ⟨a, K₀, C₁, ha0, ha1, hK₀, hC₁, ?_⟩
  intro μ N hμ0 hμ1 hNK g hgm hgb hgs
  have hμK : 1 ≤ μ ^ (-K₀) := Real.one_le_rpow_of_pos_of_le_one_of_nonpos hμ0 hμ1 (by linarith)
  have hN0 : 0 < N := by nlinarith
  set R := (N ^ expo j)⁻¹ * (μ ^ 2)⁻¹ with hRdef
  have hR : 0 < R := by positivity
  choose b hb using hgb
  have htop : ∀ k, eLpNorm (g k) ⊤ volume ≠ ⊤ := fun k =>
    (memLp_of_box (hgm k) (hb k) (hgs k) ⊤).eLpNorm_ne_top
  set β : Fin 3 → ℝ := fun k => (eLpNorm (g k) ⊤ volume).toReal with hβdef
  have hβ0 : ∀ k, 0 ≤ β k := fun k => ENNReal.toReal_nonneg
  have hae : ∀ k, ∀ᵐ x ∂(volume : Measure E3), ‖g k x‖ ≤ β k := fun k => by
    filter_upwards [ae_le_eLpNormEssSup (f := g k) (μ := volume)] with x hx
    rw [← eLpNorm_exponent_top (hgm k).aestronglyMeasurable] at hx
    rw [hβdef]; simp only
    rw [← ENNReal.ofReal_le_iff_le_toReal (htop k), ofReal_norm]
    exact hx
  -- the null-set modification
  set g' : Fin 3 → E3 → ℂ := fun k x => if ‖g k x‖ ≤ β k then g k x else 0 with hg'def
  have hg'm : ∀ k, Measurable (g' k) := fun k =>
    Measurable.ite (measurableSet_le (hgm k).norm measurable_const) (hgm k) measurable_const
  have hg'b : ∀ k x, ‖g' k x‖ ≤ β k := fun k x => by
    rw [hg'def]; simp only; split_ifs with h
    · exact h
    · simpa using hβ0 k
  have hg's : ∀ k x, x ∉ petBox C₀ N → g' k x = 0 := fun k x hx => by
    rw [hg'def]; simp only [hgs k x hx]; simp
  have hgg' : ∀ k, g k =ᵐ[volume] g' k := fun k => by
    filter_upwards [hae k] with x hx
    rw [hg'def]; simp only [ite_eq_left hx]
  rw [eLpNorm_congr_ae (hpAdj_ae_congr hN0.le R j hgg')]
  by_cases hz : ∃ k, β k = 0
  · obtain ⟨k, hk⟩ := hz
    have h0 : g' k = fun _ => 0 := funext fun x => norm_le_zero_iff.mp (hk ▸ hg'b k x)
    rw [hpAdj_eq_zero_of_slot j h0]
    simp
  push Not at hz
  have hβpos : ∀ k, 0 < β k := fun k => lt_of_le_of_ne (hβ0 k) (hz k).symm
  set g'' : Fin 3 → E3 → ℂ := fun k x => ((β k : ℂ))⁻¹ * g' k x with hg''def
  have hg''1 : ∀ k x, ‖g'' k x‖ ≤ 1 := fun k x => by
    rw [hg''def]; simp only
    rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg (hβ0 k),
      inv_mul_le_iff₀ (hβpos k), mul_one]
    exact hg'b k x
  have hg''m : ∀ k, Measurable (g'' k) := fun k => measurable_const.mul (hg'm k)
  have hg''s : ∀ k x, x ∉ petBox C₀ N → g'' k x = 0 := fun k x hx => by
    rw [hg''def]; simp only [hg's k x hx, mul_zero]
  have hscale : g' = fun k x => (β k : ℂ) * g'' k x := by
    funext k x
    rw [hg''def]; simp only
    rw [← mul_assoc, mul_inv_cancel₀ (by exact_mod_cast (hz k)), one_mul]
  rw [hscale, hpAdj_smul]
  -- the normalized bound
  have hadj : ∀ i x, ‖adjIn j g'' i x‖ ≤ 1 := fun i x => by
    unfold adjIn; split_ifs
    · rw [RCLike.norm_conj]; exact hg''1 1 x
    · rw [RCLike.norm_conj]; exact hg''1 2 x
    · simp
  have hadjs : ∀ i x, x ∉ petBox C₀ N → adjIn j g'' i x = 0 := fun i x hx => by
    unfold adjIn; split_ifs
    · simp [hg''s 1 x hx]
    · simp [hg''s 2 x hx]
    · rfl
  have hI := hHP μ N hμ0 hμ1 hNK (g'' 0) (adjIn j g'') (hg''m 0) (measurable_adjIn j hg''m)
    (hg''1 0) hadj (hg''s 0) hadjs
  rw [Astar_adjIn] at hI
  have hGm := measurable_adjT hN0.le j hg''m
  have hG2 := memLp_of_box hGm (norm_adjT_le hN0 j hg''1)
    (fun y hy => adjT_eq_zero hN0 j (hg''s 0) hy) 2
  have hH2 : MemLp (hpAdj N R j g'') 2 volume := hG2.sub (memLp_two_P hR j hGm hG2)
  have hb2 : eLpNorm (hpAdj N R j g'') 2 volume ≤ ENNReal.ofReal (C₁ * μ ^ a * N ^ 3) := by
    rw [eLpNorm_two_eq_sqrt hH2]
    refine ENNReal.ofReal_le_ofReal ?_
    rw [Real.sqrt_le_left (by positivity)]
    exact hI
  have e2 : ENNReal.ofReal 2 = 2 := ENNReal.ofReal_ofNat 2
  rw [e2]
  rw [eLpNorm_const_mul_fun]
  have hprod : ‖∏ k, (β k : ℂ)‖ₑ = ∏ k, eLpNorm (g k) ⊤ volume := by
    rw [Fin.prod_univ_three, Fin.prod_univ_three, enorm_mul, enorm_mul]
    have e : ∀ k, ‖(β k : ℂ)‖ₑ = eLpNorm (g k) ⊤ volume := fun k => by
      rw [← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg (hβ0 k), hβdef]
      exact ENNReal.ofReal_toReal (htop k)
    rw [e 0, e 1, e 2]
  rw [hprod, mul_comm]
  exact mul_le_mul_of_nonneg_right hb2 bot_le

end

/-! ### `new:compact-decaying-point`: the interpolation -/

section
open Filter Topology MeasureTheory

theorem SimpleOn.bounded {B : Set E3} {u : E3 → ℂ} (hu : SimpleOn B u) :
    ∃ b : ℝ, ∀ x, ‖u x‖ ≤ b := by
  obtain ⟨b, hb⟩ := (hu.2.1.image (fun z : ℂ => ‖z‖)).bddAbove
  exact ⟨b, fun x => hb ⟨u x, ⟨x, rfl⟩, rfl⟩⟩

theorem SimpleOn.eq_zero {B : Set E3} {u : E3 → ℂ} (hu : SimpleOn B u) {x : E3} (hx : x ∉ B) :
    u x = 0 := by
  by_contra h
  exact hx (hu.2.2 h)

/-- The exponents of `new:compact-decaying-point`: `1/u_0 = 10/61`, `1/u_b = 21/122`,
`1/u_c = 10/61`. -/
noncomputable def cdpExp : Fin 3 → ℝ := ![61 / 10, 122 / 21, 61 / 10]

theorem N_rpow_cancel {N : ℝ} (hN : 0 < N) :
    (N ^ (3 : ℕ)) ^ (1 / 61 : ℝ) * (N ^ (-(1 : ℝ) / 20)) ^ (60 / 61 : ℝ) = 1 := by
  rw [← Real.rpow_natCast, ← Real.rpow_mul hN.le, ← Real.rpow_mul hN.le,
    ← Real.rpow_add hN]
  norm_num

/-- **Theorem `new:compact-decaying-point`** on finite-valued inputs supported in `B_N(C₀)`:
`‖(I - P_R^{(j)}) A_N^{*j}(g)‖₂ ≤ C₃ μ^{a₁} ∏ ‖g_i‖_{u_i}` with `R = N^{-j} μ^{-2}` and
`(u_0, u_b, u_c) = (61/10, 122/21, 61/10)`, by `new:interpolation` with weight `60/61` on the
improving endpoint and `1/61` on the bounded one; the powers of `N` cancel. -/
theorem compactDecaying (j : Fin 3) {C₀ : ℝ} (hC₀ : 1 ≤ C₀) :
    ∃ a₁ K₀ C₃ : ℝ, 0 < a₁ ∧ a₁ < 1 ∧ 1 ≤ K₀ ∧ 0 ≤ C₃ ∧
      ∀ μ N : ℝ, 0 < μ → μ ≤ 1 → K₀ * μ ^ (-K₀) ≤ N →
        ∀ g : Fin 3 → E3 → ℂ, (∀ k, SimpleOn (petBox C₀ N) (g k)) →
          eLpNorm (hpAdj N ((N ^ expo j)⁻¹ * (μ ^ 2)⁻¹) j g) (ENNReal.ofReal 2) volume
            ≤ ENNReal.ofReal (C₃ * μ ^ a₁)
              * ∏ k, eLpNorm (g k) (ENNReal.ofReal (cdpExp k)) volume := by
  obtain ⟨a, K₀, C₁, ha0, ha1, hK₀, hC₁, hbd⟩ := hpAdj_bounded j hC₀
  obtain ⟨Ci, hCi, himp⟩ := hpAdj_improving j
  refine ⟨a / 61, K₀, C₁ ^ (1 / 61 : ℝ) * Ci ^ (60 / 61 : ℝ), by positivity, by
    rw [div_lt_one (by norm_num)]; linarith, hK₀, by positivity, ?_⟩
  intro μ N hμ0 hμ1 hNK g hg
  have hμK : 1 ≤ μ ^ (-K₀) := Real.one_le_rpow_of_pos_of_le_one_of_nonpos hμ0 hμ1 (by linarith)
  have hN0 : 0 < N := by nlinarith
  set R := (N ^ expo j)⁻¹ * (μ ^ 2)⁻¹ with hRdef
  have hR : 0 < R := by positivity
  have hθ : (60 / 61 : ℝ) ∈ Set.Ioo (0 : ℝ) 1 := ⟨by norm_num, by norm_num⟩
  have h := interpolate_trilin_simple (T := hpAdj N R j) (trilin_hpAdj hN0 hR j)
    (fun g hg => measurable_hpAdj hN0.le j fun k => (hg k).1) (B := petBox C₀ N)
    (p₀ := fun _ => 0) (p₁ := ![6, 40 / 7, 6]) (p := cdpExp) (q₀ := 2) (q₁ := 2) (q := 2)
    (M₀ := C₁ * μ ^ a * N ^ 3) (M₁ := Ci * N ^ (-(1 : ℝ) / 20)) (θ := 60 / 61)
    (fun _ => le_rfl) (fun i => by fin_cases i <;> norm_num)
    (fun i => by fin_cases i <;> norm_num [cdpExp]) (by norm_num) (by norm_num) (by norm_num)
    (by positivity) (by positivity) hθ
    (fun i => by fin_cases i <;> norm_num [cdpExp]) (by norm_num)
    (fun g hg => by
      refine le_of_le_of_eq (hbd μ N hμ0 hμ1 hNK g (fun k => (hg k).1) (fun k => (hg k).bounded)
        (fun k x hx => (hg k).eq_zero hx)) ?_
      simp [eIn])
    (fun g hg => by
      refine le_of_le_of_eq (himp N R C₀ hN0 hR (by linarith) g (fun k => (hg k).1)
        (fun k => (hg k).bounded) (fun k x hx => (hg k).eq_zero hx)) ?_
      congr 1
      refine Finset.prod_congr rfl fun i _ => ?_
      fin_cases i <;> simp [eIn])
    g hg
  refine h.trans (le_of_eq ?_)
  congr 2
  rw [show (1 : ℝ) - 60 / 61 = 1 / 61 by norm_num,
    Real.mul_rpow (by positivity) (by positivity), Real.mul_rpow (by positivity) (by positivity),
    Real.mul_rpow (by positivity) (by positivity), ← Real.rpow_mul hμ0.le]
  have hc := N_rpow_cancel hN0
  calc C₁ ^ (1 / 61 : ℝ) * μ ^ (a * (1 / 61)) * (N ^ (3 : ℕ)) ^ (1 / 61 : ℝ)
        * (Ci ^ (60 / 61 : ℝ) * (N ^ (-(1 : ℝ) / 20)) ^ (60 / 61 : ℝ))
      = C₁ ^ (1 / 61 : ℝ) * Ci ^ (60 / 61 : ℝ) * μ ^ (a * (1 / 61))
        * ((N ^ (3 : ℕ)) ^ (1 / 61 : ℝ) * (N ^ (-(1 : ℝ) / 20)) ^ (60 / 61 : ℝ)) := by ring
    _ = C₁ ^ (1 / 61 : ℝ) * Ci ^ (60 / 61 : ℝ) * μ ^ (a / 61) := by
        rw [hc, mul_one, mul_one_div]

end

/-! ### `new:global-decaying-point`: cubes and the exact input decomposition -/

section
open Filter Topology MeasureTheory

/-- The index of the cube `Q_ν = D_N(ν + [0,1)^3)` containing a point. -/
noncomputable def boxIdx (N : ℝ) (x : E3) : Fin 3 → ℤ := fun i => ⌊x i / N ^ expo i⌋

theorem measurable_boxIdx (N : ℝ) : Measurable (boxIdx N) := by
  refine Measurable.of_eval fun i => ?_
  have h : Measurable fun x : E3 => x i / N ^ expo i :=
    ((EuclideanSpace.proj i).continuous.measurable).div_const _
  have hfl : Measurable (Int.floor : ℝ → ℤ) := measurable_to_countable fun n => by
    simpa only [Int.preimage_floor_singleton] using measurableSet_Ico
  exact hfl.comp h

/-- The restriction `1_{Q_ν} g`. -/
noncomputable def boxRes (N : ℝ) (ν : Fin 3 → ℤ) (g : E3 → ℂ) : E3 → ℂ :=
  fun x => if boxIdx N x = ν then g x else 0

theorem measurable_boxRes (N : ℝ) (ν : Fin 3 → ℤ) {g : E3 → ℂ} (hg : Measurable g) :
    Measurable (boxRes N ν g) :=
  Measurable.ite (measurableSet_eq_fun (measurable_boxIdx N) measurable_const) hg
    measurable_const

theorem floor_add_mem {a b : ℝ} (hb0 : 0 ≤ b) (hb1 : b ≤ 1) :
    ⌊a + b⌋ = ⌊a⌋ ∨ ⌊a + b⌋ = ⌊a⌋ + 1 := by
  have h1 : ⌊a⌋ ≤ ⌊a + b⌋ := Int.floor_le_floor (by linarith)
  have h2 : ⌊a + b⌋ ≤ ⌊a⌋ + 1 := by
    rw [← Int.floor_add_one]; exact Int.floor_le_floor (by linarith)
  omega

/-- **Moving by at most one side length in one coordinate** changes the cube index by `0` or by
`e_m`. -/
theorem boxIdx_add_smul {N : ℝ} (hN : 0 < N) (z : E3) (m : Fin 3) {s : ℝ} (hs0 : 0 ≤ s)
    (hs1 : s ≤ N ^ expo m) :
    boxIdx N (z + s • basisVec m) = boxIdx N z
      ∨ boxIdx N (z + s • basisVec m) = boxIdx N z + Pi.single m 1 := by
  have hNm : 0 < N ^ expo m := pow_pos hN _
  have hoff : ∀ i, i ≠ m → boxIdx N (z + s • basisVec m) i = boxIdx N z i := fun i hi => by
    simp [boxIdx, basisVec_apply_ne hi]
  have hm : boxIdx N (z + s • basisVec m) m = ⌊z m / N ^ expo m + s / N ^ expo m⌋ := by
    simp only [boxIdx, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, basisVec_apply_self,
      mul_one, add_div]
  rcases floor_add_mem (a := z m / N ^ expo m) (div_nonneg hs0 hNm.le)
    ((div_le_one hNm).mpr hs1) with h | h
  · left
    funext i
    by_cases hi : i = m
    · subst hi; rw [hm, h]; rfl
    · exact hoff i hi
  · right
    funext i
    by_cases hi : i = m
    · subst hi; rw [hm, h]; simp [boxIdx]
    · rw [hoff i hi]; simp [hi]

/-- The offset `ε e_m` of a neighbouring cube. -/
def offV (m : Fin 3) (ε : Fin 2) : Fin 3 → ℤ := ((ε : ℕ) : ℤ) • Pi.single m 1

/-- The pieces `(g_{0,ν}, g_{b,ν+ε e_b}, g_{c,ν+ε' e_c})` of the exact input decomposition. -/
noncomputable def piece (N : ℝ) (j : Fin 3) (ν : Fin 3 → ℤ) (ε ε' : Fin 2)
    (g : Fin 3 → E3 → ℂ) : Fin 3 → E3 → ℂ :=
  ![boxRes N ν (g 0), boxRes N (ν + offV (j + 1) ε) (g 1), boxRes N (ν + offV (j + 2) ε') (g 2)]

theorem offV_zero (m : Fin 3) : offV m 0 = 0 := by simp [offV]

theorem offV_one (m : Fin 3) : offV m 1 = Pi.single m 1 := by simp [offV]

theorem adjVec_succ (j : Fin 3) (k : Fin 3) (hk : k ≠ 0) (t : ℝ) (y : E3) :
    y + adjVec j k t = (y + adjVec j 0 t) + (t ^ expo (j + k)) • basisVec (j + k) := by
  simp [adjVec, hk, curve, add_assoc]

/-- **The exact input decomposition, pointwise**: for `t ∈ [0, N]`, the adjoint integrand is the
sum over the cubes `ν ∈ S` (containing the support of `g_0`) and the offsets `ε, ε' ∈ {0, 1}` of
the integrands of the pieces; exactly one term is nonzero. -/
theorem prod_decomp {N : ℝ} (hN : 0 < N) (j : Fin 3) (g : Fin 3 → E3 → ℂ)
    (S : Finset (Fin 3 → ℤ)) (hS : ∀ x, g 0 x ≠ 0 → boxIdx N x ∈ S) (y : E3) {t : ℝ}
    (ht : t ∈ Set.Icc 0 N) :
    ∏ k : Fin 3, g k (y + adjVec j k t)
      = ∑ ε : Fin 2, ∑ ε' : Fin 2, ∑ ν ∈ S,
          ∏ k : Fin 3, piece N j ν ε ε' g k (y + adjVec j k t) := by
  simp only [Fin.prod_univ_three, piece, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons, boxRes, Fin.sum_univ_two, offV_zero,
    offV_one]
  set z := y + adjVec j 0 t with hz
  have h1 := adjVec_succ j 1 (by decide) t y
  have h2 := adjVec_succ j 2 (by decide) t y
  rw [← hz] at h1 h2
  set z1 := y + adjVec j 1 t with hz1
  set z2 := y + adjVec j 2 t with hz2
  have hs : ∀ m : Fin 3, 0 ≤ t ^ expo m ∧ t ^ expo m ≤ N ^ expo m := fun m =>
    ⟨pow_nonneg ht.1 _, pow_le_pow_left₀ ht.1 ht.2 _⟩
  have hb1 := boxIdx_add_smul hN z (j + 1) (hs _).1 (hs _).2
  have hb2 := boxIdx_add_smul hN z (j + 2) (hs _).1 (hs _).2
  rw [← h1] at hb1
  rw [← h2] at hb2
  have hne : ∀ m : Fin 3, ∀ ν : Fin 3 → ℤ, ν ≠ ν + Pi.single m 1 := fun m ν h => by
    have := congrFun h m
    simp at this
  have hne' : ∀ m : Fin 3, ∀ ν : Fin 3 → ℤ, ν + Pi.single m 1 ≠ ν := fun m ν h =>
    hne m ν h.symm
  by_cases h0 : g 0 z = 0
  · rw [h0, zero_mul, zero_mul]
    simp
  have hν : boxIdx N z ∈ S := hS z h0
  have hsum : ∀ (c1 c2 : Fin 3 → ℤ),
      (∑ ν ∈ S, (if boxIdx N z = ν then g 0 z else 0)
        * (if boxIdx N z1 = ν + c1 then g 1 z1 else 0)
        * (if boxIdx N z2 = ν + c2 then g 2 z2 else 0))
      = (if boxIdx N z1 = boxIdx N z + c1 then g 1 z1 else 0) * g 0 z
        * (if boxIdx N z2 = boxIdx N z + c2 then g 2 z2 else 0) := by
    intro c1 c2
    rw [Finset.sum_eq_single (boxIdx N z)]
    · rw [ite_eq_left rfl]; ring
    · intro ν _ hν'
      rw [ite_eq_right (Ne.symm hν'), zero_mul, zero_mul]
    · intro h; exact absurd hν h
  rw [hsum, hsum, hsum, hsum]
  rcases hb1 with e1 | e1 <;> rcases hb2 with e2 | e2 <;>
    simp only [e1, e2, add_zero, hne, hne', ite_true, ite_false, zero_mul, mul_zero,
      zero_add] <;> ring

end

/-! ### `new:global-decaying-point`: the decomposition of the adjoint -/

section
open Filter Topology MeasureTheory

theorem bddMeasC_boxRes (N : ℝ) (ν : Fin 3 → ℤ) {g : E3 → ℂ} (hg : BddMeasC g) :
    BddMeasC (boxRes N ν g) := by
  obtain ⟨hgm, C, hC⟩ := hg
  refine ⟨measurable_boxRes N ν hgm, max C 0, fun x => ?_⟩
  unfold boxRes; split_ifs
  · exact (hC x).trans (le_max_left _ _)
  · simp

theorem bddMeasC_piece (N : ℝ) (j : Fin 3) (ν : Fin 3 → ℤ) (ε ε' : Fin 2)
    {g : Fin 3 → E3 → ℂ} (hg : ∀ k, BddMeasC (g k)) (k : Fin 3) :
    BddMeasC (piece N j ν ε ε' g k) := by
  fin_cases k
  · exact bddMeasC_boxRes N ν (hg 0)
  · exact bddMeasC_boxRes N _ (hg 1)
  · exact bddMeasC_boxRes N _ (hg 2)

theorem norm_boxRes_le (N : ℝ) (ν : Fin 3 → ℤ) (g : E3 → ℂ) (x : E3) :
    ‖boxRes N ν g x‖ ≤ ‖g x‖ := by
  unfold boxRes; split_ifs
  · exact le_rfl
  · simp

theorem norm_piece_le (N : ℝ) (j : Fin 3) (ν : Fin 3 → ℤ) (ε ε' : Fin 2) (g : Fin 3 → E3 → ℂ)
    (k : Fin 3) (x : E3) : ‖piece N j ν ε ε' g k x‖ ≤ ‖g k x‖ := by
  fin_cases k
  · exact norm_boxRes_le N ν (g 0) x
  · exact norm_boxRes_le N _ (g 1) x
  · exact norm_boxRes_le N _ (g 2) x

theorem intervalIntegrable_prod_adjVec {j : Fin 3} {g : Fin 3 → E3 → ℂ}
    (hg : ∀ k, BddMeasC (g k)) (y : E3) (a b : ℝ) :
    IntervalIntegrable (fun t => ∏ k : Fin 3, g k (y + adjVec j k t)) volume a b := by
  choose hgm C hC using hg
  refine intervalIntegrable_of_norm_le (C := ∏ k, C k)
    (Finset.measurable_prod _ fun k _ =>
      (hgm k).comp (measurable_const.add (continuous_adjVec j k).measurable)) (fun t => ?_) a b
  rw [norm_prod]
  exact Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _) fun k _ => hC k _

/-- **The exact input decomposition of the adjoint form.** -/
theorem adjT_decomp {N : ℝ} (hN : 0 < N) (j : Fin 3) {g : Fin 3 → E3 → ℂ}
    (hg : ∀ k, BddMeasC (g k)) (S : Finset (Fin 3 → ℤ))
    (hS : ∀ x, g 0 x ≠ 0 → boxIdx N x ∈ S) :
    adjT N j g = fun y => ∑ ε : Fin 2, ∑ ε' : Fin 2, ∑ ν ∈ S,
      adjT N j (piece N j ν ε ε' g) y := by
  funext y
  simp only [adjT]
  rw [intervalIntegral.integral_congr (g := fun t => ∑ ε : Fin 2, ∑ ε' : Fin 2, ∑ ν ∈ S,
      ∏ k : Fin 3, piece N j ν ε ε' g k (y + adjVec j k t)) fun t ht => by
    rw [Set.uIcc_of_le hN.le] at ht
    exact prod_decomp hN j g S hS y ht]
  choose hgm C hC using hg
  set B : ℝ := ∏ k, max (C k) 0 with hBdef
  have hpm : ∀ ν ε ε', Measurable fun t => ∏ k : Fin 3, piece N j ν ε ε' g k (y + adjVec j k t) :=
    fun ν ε ε' => Finset.measurable_prod _ fun k _ =>
      (bddMeasC_piece N j ν ε ε' (fun k => ⟨hgm k, C k, hC k⟩) k).1.comp
        (measurable_const.add (continuous_adjVec j k).measurable)
  have hpb : ∀ ν ε ε' t, ‖∏ k : Fin 3, piece N j ν ε ε' g k (y + adjVec j k t)‖ ≤ B := by
    intro ν ε ε' t
    rw [norm_prod, hBdef]
    refine Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _) fun k _ => ?_
    exact (norm_piece_le N j ν ε ε' g k _).trans ((hC k _).trans (le_max_left _ _))
  have hB0 : 0 ≤ B := Finset.prod_nonneg fun k _ => le_max_right _ _
  have hI3 : ∀ ε ε', IntervalIntegrable (fun t => ∑ ν ∈ S,
      ∏ k : Fin 3, piece N j ν ε ε' g k (y + adjVec j k t)) volume 0 N := fun ε ε' =>
    intervalIntegrable_of_norm_le (C := S.card * B) (Finset.measurable_sum _ fun ν _ => hpm ν ε ε')
      (fun t => (norm_sum_le _ _).trans (by
        rw [← nsmul_eq_mul, ← Finset.sum_const]; exact Finset.sum_le_sum fun ν _ => hpb ν ε ε' t))
      0 N
  have hI2 : ∀ ε, IntervalIntegrable (fun t => ∑ ε' : Fin 2, ∑ ν ∈ S,
      ∏ k : Fin 3, piece N j ν ε ε' g k (y + adjVec j k t)) volume 0 N := fun ε =>
    intervalIntegrable_of_norm_le (C := 2 * (S.card * B))
      (Finset.measurable_sum _ fun ε' _ => Finset.measurable_sum _ fun ν _ => hpm ν ε ε')
      (fun t => (norm_sum_le _ _).trans (by
        refine (Finset.sum_le_sum fun ε' _ => (norm_sum_le _ _).trans
          (Finset.sum_le_sum fun ν _ => hpb ν ε ε' t)).trans (le_of_eq ?_)
        simp)) 0 N
  rw [intervalIntegral.integral_finsetSum (s := Finset.univ)
    (f := fun ε t => ∑ ε' : Fin 2, ∑ ν ∈ S, ∏ k : Fin 3, piece N j ν ε ε' g k (y + adjVec j k t))
    fun ε _ => hI2 ε]
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun ε _ => ?_
  rw [intervalIntegral.integral_finsetSum (s := Finset.univ)
    (f := fun ε' t => ∑ ν ∈ S, ∏ k : Fin 3, piece N j ν ε ε' g k (y + adjVec j k t))
    fun ε' _ => hI3 ε ε']
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun ε' _ => ?_
  rw [intervalIntegral.integral_finsetSum (s := S)
    (f := fun ν t => ∏ k : Fin 3, piece N j ν ε ε' g k (y + adjVec j k t))
    fun ν _ => intervalIntegrable_of_norm_le (hpm ν ε ε') (hpb ν ε ε') 0 N]
  rw [Finset.mul_sum]

/-- `P_R^{(j)}` commutes with finite sums of bounded measurable functions. -/
theorem P_finset_sum {R : ℝ} (hR : 0 < R) (j : Fin 3) {ι : Type*} (s : Finset ι)
    {F : ι → E3 → ℂ} (hF : ∀ i, BddMeasC (F i)) :
    P R j (fun x => ∑ i ∈ s, F i x) = fun x => ∑ i ∈ s, P R j (F i) x := by
  funext x
  simp only [P, Finset.mul_sum]
  exact integral_finsetSum _ fun i _ => integrable_projKernel_mul_bdd hR j (hF i) x

theorem bddMeasC_finsetSum' {ι : Type*} (s : Finset ι) {F : ι → E3 → ℂ}
    (hF : ∀ i, BddMeasC (F i)) : BddMeasC fun x => ∑ i ∈ s, F i x := by
  choose hm C hC using hF
  refine ⟨Finset.measurable_sum _ fun i _ => hm i, ∑ i ∈ s, C i, fun x => ?_⟩
  exact (norm_sum_le _ _).trans (Finset.sum_le_sum fun i _ => hC i x)

/-- **The exact input decomposition of `(I - P_R) A_N^{*j}`**, one sum per offset. -/
theorem hpAdj_decomp {N R : ℝ} (hN : 0 < N) (hR : 0 < R) (j : Fin 3) {g : Fin 3 → E3 → ℂ}
    (hg : ∀ k, BddMeasC (g k)) (S : Finset (Fin 3 → ℤ))
    (hS : ∀ x, g 0 x ≠ 0 → boxIdx N x ∈ S) :
    hpAdj N R j g = fun y => ∑ ε : Fin 2, ∑ ε' : Fin 2, ∑ ν ∈ S,
      hpAdj N R j (piece N j ν ε ε' g) y := by
  have hb : ∀ ν ε ε', BddMeasC (adjT N j (piece N j ν ε ε' g)) := fun ν ε ε' =>
    bddMeasC_adjT hN j (bddMeasC_piece N j ν ε ε' hg)
  have hP : P R j (adjT N j g) = fun y => ∑ ε : Fin 2, ∑ ε' : Fin 2, ∑ ν ∈ S,
      P R j (adjT N j (piece N j ν ε ε' g)) y := by
    rw [adjT_decomp hN j hg S hS, P_finset_sum hR j _ fun ε =>
      bddMeasC_finsetSum' _ fun ε' => bddMeasC_finsetSum' _ fun ν => hb ν ε ε']
    funext y
    refine Finset.sum_congr rfl fun ε _ => ?_
    rw [P_finset_sum hR j _ fun ε' => bddMeasC_finsetSum' _ fun ν => hb ν ε ε']
    refine Finset.sum_congr rfl fun ε' _ => ?_
    rw [P_finset_sum hR j _ fun ν => hb ν ε ε']
  funext y
  simp only [hpAdj]
  rw [hP, adjT_decomp hN j hg S hS]
  simp only [← Finset.sum_sub_distrib]

end

/-! ### `new:global-decaying-point`: translation and the bound for each piece -/

section
open Filter Topology MeasureTheory

/-- The corner `D_N ν` of the cube `Q_ν`. -/
noncomputable def cornerVec (N : ℝ) (ν : Fin 3 → ℤ) : E3 :=
  ∑ i, ((ν i : ℝ) * N ^ expo i) • basisVec i

theorem cornerVec_apply (N : ℝ) (ν : Fin 3 → ℤ) (m : Fin 3) :
    cornerVec N ν m = (ν m : ℝ) * N ^ expo m := by
  simp [cornerVec, basisVec_apply, Finset.sum_apply]

theorem boxIdx_add_corner {N : ℝ} (hN : 0 < N) (x : E3) (ν : Fin 3 → ℤ) :
    boxIdx N (x + cornerVec N ν) = boxIdx N x + ν := by
  funext i
  have hNi : 0 < N ^ expo i := pow_pos hN _
  simp only [boxIdx, PiLp.add_apply, cornerVec_apply, Pi.add_apply, add_div,
    mul_div_cancel_right₀ _ hNi.ne']
  exact Int.floor_add_intCast _ _

theorem adjT_translate (N : ℝ) (j : Fin 3) (g : Fin 3 → E3 → ℂ) (v : E3) :
    adjT N j (fun k x => g k (x + v)) = fun y => adjT N j g (y + v) := by
  funext y
  simp only [adjT]
  congr 2
  funext t
  refine Finset.prod_congr rfl fun k _ => ?_
  congr 1; abel

theorem P_translate (R : ℝ) (j : Fin 3) (F : E3 → ℂ) (v : E3) :
    P R j (fun x => F (x + v)) = fun y => P R j F (y + v) := by
  funext y
  simp only [P]
  congr 1; funext u; congr 2; abel

theorem hpAdj_translate (N R : ℝ) (j : Fin 3) (g : Fin 3 → E3 → ℂ) (v : E3) :
    hpAdj N R j (fun k x => g k (x + v)) = fun y => hpAdj N R j g (y + v) := by
  funext y
  simp only [hpAdj]
  rw [adjT_translate, P_translate]

theorem eLpNorm_translate {f : E3 → ℂ} (hf : Measurable f) (v : E3) (p : ℝ≥0∞) :
    eLpNorm (fun x => f (x + v)) p volume = eLpNorm f p volume :=
  eLpNorm_comp_add_right_of_aestronglyMeasurable hf.aestronglyMeasurable v p

theorem offV_mem (m : Fin 3) (ε : Fin 2) (i : Fin 3) : 0 ≤ offV m ε i ∧ offV m ε i ≤ 1 := by
  fin_cases ε <;> simp [offV, Pi.single_apply]; split_ifs <;> simp

/-- A function vanishing off `Q_{ν + c}` with `0 ≤ c ≤ 1` has its translate by `-D_N ν`
supported in `B_N(2)`. -/
theorem mem_petBox_two {N : ℝ} (hN : 0 < N) {x : E3} {c : Fin 3 → ℤ} (hc : ∀ i, 0 ≤ c i ∧ c i ≤ 1)
    (hx : boxIdx N x = c) : x ∈ petBox 2 N := by
  intro i
  have hNi : 0 < N ^ expo i := pow_pos hN _
  have h := congrFun hx i
  simp only [boxIdx] at h
  have h1 := Int.floor_le (x i / N ^ expo i)
  have h2 := Int.lt_floor_add_one (x i / N ^ expo i)
  rw [h] at h1 h2
  have hc0 : (0 : ℝ) ≤ c i := by exact_mod_cast (hc i).1
  have hc1 : (c i : ℝ) ≤ 1 := by exact_mod_cast (hc i).2
  rw [le_div_iff₀ hNi] at h1
  rw [div_lt_iff₀ hNi] at h2
  constructor <;> nlinarith

theorem simpleOn_piece_translate {N : ℝ} (hN : 0 < N) (j : Fin 3) (ν : Fin 3 → ℤ) (ε ε' : Fin 2)
    {g : Fin 3 → E3 → ℂ} (hgm : ∀ k, Measurable (g k)) (hgr : ∀ k, (Set.range (g k)).Finite)
    (k : Fin 3) :
    SimpleOn (petBox 2 N) (fun x => piece N j ν ε ε' g k (x + cornerVec N ν)) := by
  have hc : ∀ k : Fin 3, ∃ c : Fin 3 → ℤ, (∀ i, 0 ≤ c i ∧ c i ≤ 1) ∧
      piece N j ν ε ε' g k = boxRes N (ν + c) (g k) := by
    intro k
    fin_cases k
    · exact ⟨0, fun i => by simp, by simp [piece]⟩
    · exact ⟨offV (j + 1) ε, offV_mem _ _, by simp [piece]⟩
    · exact ⟨offV (j + 2) ε', offV_mem _ _, by simp [piece]⟩
  obtain ⟨c, hc01, hck⟩ := hc k
  rw [hck]
  refine ⟨(measurable_boxRes N _ (hgm k)).comp (measurable_id.add_const _), ?_, ?_⟩
  · refine ((hgr k).insert 0).subset ?_
    rintro _ ⟨x, rfl⟩
    unfold boxRes; beta_reduce; split_ifs
    · exact Set.mem_insert_of_mem _ ⟨_, rfl⟩
    · exact Set.mem_insert _ _
  · intro x hx
    simp only [Function.mem_support, boxRes] at hx
    split_ifs at hx with h
    · rw [boxIdx_add_corner hN, add_comm, add_left_cancel_iff] at h
      exact mem_petBox_two hN hc01 h
    · exact absurd rfl hx

/-- **The compact decaying point for each piece** of the exact input decomposition. -/
theorem piece_bound (j : Fin 3) :
    ∃ a₁ K₀ C₃ : ℝ, 0 < a₁ ∧ a₁ < 1 ∧ 1 ≤ K₀ ∧ 0 ≤ C₃ ∧
      ∀ μ N : ℝ, 0 < μ → μ ≤ 1 → K₀ * μ ^ (-K₀) ≤ N →
        ∀ g : Fin 3 → E3 → ℂ, (∀ k, Measurable (g k)) → (∀ k, (Set.range (g k)).Finite) →
        ∀ (ν : Fin 3 → ℤ) (ε ε' : Fin 2),
          eLpNorm (hpAdj N ((N ^ expo j)⁻¹ * (μ ^ 2)⁻¹) j (piece N j ν ε ε' g))
              (ENNReal.ofReal 2) volume
            ≤ ENNReal.ofReal (C₃ * μ ^ a₁)
              * ∏ k, eLpNorm (piece N j ν ε ε' g k) (ENNReal.ofReal (cdpExp k)) volume := by
  obtain ⟨a₁, K₀, C₃, ha0, ha1, hK0, hC3, hcd⟩ := compactDecaying j (C₀ := 2) (by norm_num)
  refine ⟨a₁, K₀, C₃, ha0, ha1, hK0, hC3, ?_⟩
  intro μ N hμ0 hμ1 hNK g hgm hgr ν ε ε'
  have hμK : 1 ≤ μ ^ (-K₀) := Real.one_le_rpow_of_pos_of_le_one_of_nonpos hμ0 hμ1 (by linarith)
  have hN0 : 0 < N := by nlinarith
  set v := cornerVec N ν with hvdef
  have h := hcd μ N hμ0 hμ1 hNK (fun k x => piece N j ν ε ε' g k (x + v))
    (simpleOn_piece_translate hN0 j ν ε ε' hgm hgr)
  rw [hpAdj_translate] at h
  have hpm : ∀ k, Measurable (piece N j ν ε ε' g k) := fun k => by
    fin_cases k
    · exact measurable_boxRes N _ (hgm 0)
    · exact measurable_boxRes N _ (hgm 1)
    · exact measurable_boxRes N _ (hgm 2)
  rw [eLpNorm_translate (measurable_hpAdj hN0.le j hpm)] at h
  simp_rw [eLpNorm_translate (hpm _)] at h
  exact h

end

/-! ### `new:global-decaying-point`: the off-diagonal tail -/

section
open Filter Topology MeasureTheory

/-- The tail-weighted kernel `K̃(u) = (|u|/a) |K_R(u)| 1_{|u| ≥ a}`. -/
noncomputable def tailKer (R a : ℝ) (u : ℝ) : ℝ :=
  if a ≤ |u| then |u| / a * ‖projKernel R u‖ else 0

theorem tailKer_nonneg {R a : ℝ} (ha : 0 < a) (u : ℝ) : 0 ≤ tailKer R a u := by
  unfold tailKer; split_ifs <;> positivity

theorem tailKer_le {R a : ℝ} (hR : 0 < R) (ha : 0 < a) (u : ℝ) :
    tailKer R a u ≤ ((R * a) ^ 2)⁻¹ * ((1 + R * |u|) ^ 2 * ‖projKernel R u‖) := by
  unfold tailKer
  split_ifs with h
  · have hx : 1 ≤ |u| / a := (one_le_div ha).mpr h
    have h1 : |u| / a ≤ ((R * a) ^ 2)⁻¹ * (1 + R * |u|) ^ 2 := by
      calc |u| / a ≤ (|u| / a) ^ 2 := by nlinarith
        _ = (R * |u|) ^ 2 / (R * a) ^ 2 := by field_simp
        _ ≤ (1 + R * |u|) ^ 2 / (R * a) ^ 2 := by
            gcongr
            linarith
        _ = ((R * a) ^ 2)⁻¹ * (1 + R * |u|) ^ 2 := by ring
    calc |u| / a * ‖projKernel R u‖
        ≤ ((R * a) ^ 2)⁻¹ * (1 + R * |u|) ^ 2 * ‖projKernel R u‖ :=
          mul_le_mul_of_nonneg_right h1 (norm_nonneg _)
      _ = _ := by ring
  · positivity

theorem measurable_tailKer (R a : ℝ) : Measurable (tailKer R a) := by
  unfold tailKer
  exact Measurable.ite (measurableSet_le measurable_const continuous_abs.measurable)
    ((continuous_abs.measurable.div_const _).mul (projKernel_continuous R).measurable.norm)
    measurable_const

theorem integrable_tailKer {R a : ℝ} (hR : 0 < R) (ha : 0 < a) : Integrable (tailKer R a) :=
  ((integrable_projKernel_mom hR 2).const_mul _).mono' (measurable_tailKer R a).aestronglyMeasurable
    (Eventually.of_forall fun u => by
      rw [Real.norm_of_nonneg (tailKer_nonneg ha u)]; exact tailKer_le hR ha u)

theorem integral_tailKer_le {R a : ℝ} (hR : 0 < R) (ha : 0 < a) :
    ∫ u, tailKer R a u ≤ etaKerMom 2 / (R * a) ^ 2 := by
  calc ∫ u, tailKer R a u ≤ ∫ u, ((R * a) ^ 2)⁻¹ * ((1 + R * |u|) ^ 2 * ‖projKernel R u‖) :=
        integral_mono (integrable_tailKer hR ha) ((integrable_projKernel_mom hR 2).const_mul _)
          (tailKer_le hR ha)
    _ = etaKerMom 2 / (R * a) ^ 2 := by
        rw [integral_const_mul, integral_projKernel_mom hR 2, inv_mul_eq_div]

/-- The `j`-distance in cubes between a point and the cube column of `ν`. -/
noncomputable def cubeDist (N : ℝ) (j : Fin 3) (ν : Fin 3 → ℤ) (y : E3) : ℝ :=
  ((boxIdx N y j - ν j : ℤ) : ℝ)

theorem measurable_cubeDist (N : ℝ) (j : Fin 3) (ν : Fin 3 → ℤ) :
    Measurable (cubeDist N j ν) := by
  have h : Measurable fun y => boxIdx N y j := (measurable_pi_apply j).comp (measurable_boxIdx N)
  exact measurable_from_top.comp ((h.sub measurable_const))

/-- The far-off-diagonal comparison: if `G(y - u e_j) ≠ 0` for a `G` living in the cube columns
`ν_j, ν_j + 1`, and `y` is `ℓ ≥ 4` cubes away, then `1 ≤ (2/|ℓ|)(|u|/a)` and `|u| ≥ a`. -/
theorem far_u_bound {N : ℝ} (hN : 0 < N) (j : Fin 3) (ν : Fin 3 → ℤ) {y : E3} {u : ℝ}
    (hℓ : 4 ≤ |cubeDist N j ν y|)
    (hu : boxIdx N (y - u • basisVec j) j = ν j ∨ boxIdx N (y - u • basisVec j) j = ν j + 1) :
    N ^ expo j ≤ |u| ∧ 1 ≤ 2 / |cubeDist N j ν y| * (|u| / N ^ expo j) := by
  set a := N ^ expo j with hadef
  have ha : 0 < a := pow_pos hN _
  set ℓ := cubeDist N j ν y with hℓdef
  have hy1 := Int.floor_le (y j / a)
  have hy2 := Int.lt_floor_add_one (y j / a)
  have hz1 := Int.floor_le ((y j - u) / a)
  have hz2 := Int.lt_floor_add_one ((y j - u) / a)
  have hyl : (⌊y j / a⌋ : ℝ) = ν j + ℓ := by
    rw [hℓdef, cubeDist, boxIdx]; push_cast; ring
  have hzj : (y - u • basisVec j) j = y j - u := by
    simp [basisVec_apply_self]
  have hz : (⌊(y j - u) / a⌋ : ℝ) = ν j ∨ (⌊(y j - u) / a⌋ : ℝ) = ν j + 1 := by
    simp only [boxIdx, hzj] at hu
    rcases hu with h | h
    · left; exact_mod_cast h
    · right; exact_mod_cast h
  have hdiv : y j / a - (y j - u) / a = u / a := by ring
  have hbound : 2 * a ≤ |u| * (|ℓ| / 2) * (2 / |ℓ|) * 1 ∧ |ℓ| / 2 ≤ |u| / a := by
    have hℓ0 : 0 < |ℓ| := by linarith
    rw [hyl] at hy1 hy2
    have key : |ℓ| / 2 ≤ |u| / a := by
      rcases hz with h | h <;> rw [h] at hz1 hz2 <;>
      rcases le_or_gt 0 ℓ with hl | hl
      all_goals
        first
        | (rw [abs_of_nonneg hl] at hℓ ⊢
           have : u / a ≤ |u| / a := div_le_div_of_nonneg_right (le_abs_self u) ha.le
           linarith)
        | (rw [abs_of_neg hl] at hℓ ⊢
           have : -(u / a) ≤ |u| / a := by
             rw [← neg_div]; exact div_le_div_of_nonneg_right (neg_le_abs u) ha.le
           linarith)
    refine ⟨?_, key⟩
    have : |u| * (|ℓ| / 2) * (2 / |ℓ|) * 1 = |u| := by field_simp
    rw [this]
    rw [le_div_iff₀ ha] at key
    nlinarith
  obtain ⟨h1, h2⟩ := hbound
  have hℓ0 : 0 < |ℓ| := by linarith
  refine ⟨?_, ?_⟩
  · have : |u| * (|ℓ| / 2) * (2 / |ℓ|) * 1 = |u| := by field_simp
    rw [this] at h1; linarith
  · rw [le_div_iff₀ ha] at h2
    rw [div_mul_div_comm, le_div_iff₀ (by positivity)]
    nlinarith

set_option maxHeartbeats 1000000 in
-- The near/far split, the far-field domination and Young's inequality share one context.
/-- **`new:global-decaying-point`, the off-diagonal tail in weighted form**: for a bounded
box-supported `G` living in the cube columns `ν_j, ν_j + 1` along `e_j`, with `H = (I - P_R) G`,
`∫ (1 + ℓ²) |H|² ≤ 10 ‖H‖₂² + 5 (B^{tail}_2 (R N^{d_j})^{-2})² ‖G‖₂²`, `ℓ` the cube distance. -/
theorem weighted_tail {N R C B : ℝ} (hN : 0 < N) (hR : 0 < R) (j : Fin 3) (ν : Fin 3 → ℤ)
    {G : E3 → ℂ} (hGm : Measurable G) (hGb : ∀ y, ‖G y‖ ≤ B)
    (hGs : ∀ y, y ∉ petBox C N → G y = 0)
    (hsupp : ∀ y, G y ≠ 0 → boxIdx N y j = ν j ∨ boxIdx N y j = ν j + 1) :
    Integrable (fun y => (1 + cubeDist N j ν y ^ 2) * ‖G y - P R j G y‖ ^ 2) ∧
    ∫ y, (1 + cubeDist N j ν y ^ 2) * ‖G y - P R j G y‖ ^ 2
      ≤ 10 * (∫ y, ‖G y - P R j G y‖ ^ 2)
        + 5 * (etaKerMom 2 / (R * N ^ expo j) ^ 2) ^ 2 * ∫ y, ‖G y‖ ^ 2 := by
  set a := N ^ expo j with hadef
  have ha : 0 < a := pow_pos hN _
  have hG2 := memLp_of_box hGm hGb hGs 2
  have hH2 : MemLp (fun y => G y - P R j G y) 2 volume := hG2.sub (memLp_two_P hR j hGm hG2)
  have hHm : Measurable fun y => G y - P R j G y := hGm.sub (measurable_P j hGm)
  set F : E3 → ℝ := fun y => ∫ u, tailKer R a u * ‖G (y - u • basisVec j)‖ with hFdef
  -- integrability in `u`
  have hGu : ∀ y, Measurable fun u : ℝ => G (y - u • basisVec j) := fun y =>
    hGm.comp (measurable_const.sub (measurable_id.smul_const _))
  have hKi : ∀ y, Integrable fun u => ‖projKernel R u‖ * ‖G (y - u • basisVec j)‖ := fun y =>
    (projKernel_integrable hR).norm.mul_bdd (c := B) (hGu y).norm.aestronglyMeasurable
      (Eventually.of_forall fun u => by rw [norm_norm]; exact hGb _)
  have hTi : ∀ y, Integrable fun u => tailKer R a u * ‖G (y - u • basisVec j)‖ := fun y =>
    (integrable_tailKer hR ha).mul_bdd (c := B) (hGu y).norm.aestronglyMeasurable
      (Eventually.of_forall fun u => by rw [norm_norm]; exact hGb _)
  have hF0 : ∀ y, 0 ≤ F y := fun y =>
    integral_nonneg fun u => mul_nonneg (tailKer_nonneg ha u) (norm_nonneg _)
  -- the pointwise bound
  have hpt : ∀ y, (1 + cubeDist N j ν y ^ 2) * ‖G y - P R j G y‖ ^ 2
      ≤ 10 * ‖G y - P R j G y‖ ^ 2 + 5 * F y ^ 2 := by
    intro y
    by_cases hℓ : |cubeDist N j ν y| ≤ 3
    · have : cubeDist N j ν y ^ 2 ≤ 9 := by
        have := sq_abs (cubeDist N j ν y); nlinarith [abs_nonneg (cubeDist N j ν y)]
      have h5 : 0 ≤ 5 * F y ^ 2 := by positivity
      nlinarith [sq_nonneg ‖G y - P R j G y‖]
    push Not at hℓ
    have hℓ4 : 4 ≤ |cubeDist N j ν y| := by
      have h : (3 : ℝ) < |cubeDist N j ν y| := hℓ
      simp only [cubeDist] at h ⊢
      have h' : (3 : ℤ) < |boxIdx N y j - ν j| := by exact_mod_cast h
      have : (4 : ℤ) ≤ |boxIdx N y j - ν j| := by omega
      exact_mod_cast this
    have hGy : G y = 0 := by
      by_contra h
      rcases hsupp y h with e | e
      · simp [cubeDist, e] at hℓ4; norm_num at hℓ4
      · simp [cubeDist, e] at hℓ4
    rw [hGy, zero_sub, norm_neg]
    have hPy : ‖P R j G y‖ ≤ 2 / |cubeDist N j ν y| * F y := by
      rw [P]
      refine (norm_integral_le_integral_norm _).trans ?_
      rw [hFdef, ← integral_const_mul]
      refine integral_mono (by simpa [norm_mul] using hKi y) ((hTi y).const_mul _) fun u => ?_
      simp only [norm_mul]
      by_cases hGu0 : G (y - u • basisVec j) = 0
      · rw [hGu0]; simp
      · obtain ⟨hua, h1⟩ := far_u_bound hN j ν hℓ4 (hsupp _ hGu0)
        rw [← hadef] at hua h1
        simp only [tailKer, ite_eq_left hua]
        have := mul_le_mul_of_nonneg_right h1 (mul_nonneg (norm_nonneg (projKernel R u))
          (norm_nonneg (G (y - u • basisVec j))))
        calc ‖projKernel R u‖ * ‖G (y - u • basisVec j)‖
            ≤ (2 / |cubeDist N j ν y| * (|u| / a)) * (‖projKernel R u‖
              * ‖G (y - u • basisVec j)‖) := by linarith
          _ = _ := by ring
    have hℓ0 : 0 < |cubeDist N j ν y| := by linarith
    have hsq : ‖P R j G y‖ ^ 2 ≤ (2 / |cubeDist N j ν y| * F y) ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg _) hPy 2
    have hw : (1 + cubeDist N j ν y ^ 2) * (2 / |cubeDist N j ν y|) ^ 2 ≤ 5 := by
      rw [div_pow, ← sq_abs (cubeDist N j ν y)]
      have hsq16 : 16 ≤ |cubeDist N j ν y| ^ 2 := by nlinarith
      rw [mul_div_assoc', div_le_iff₀ (by positivity)]
      nlinarith
    calc (1 + cubeDist N j ν y ^ 2) * ‖P R j G y‖ ^ 2
        ≤ (1 + cubeDist N j ν y ^ 2) * (2 / |cubeDist N j ν y| * F y) ^ 2 :=
          mul_le_mul_of_nonneg_left hsq (by positivity)
      _ = ((1 + cubeDist N j ν y ^ 2) * (2 / |cubeDist N j ν y|) ^ 2) * F y ^ 2 := by ring
      _ ≤ 5 * F y ^ 2 := mul_le_mul_of_nonneg_right hw (sq_nonneg _)
      _ ≤ 10 * ‖P R j G y‖ ^ 2 + 5 * F y ^ 2 := by nlinarith [sq_nonneg ‖P R j G y‖]
  -- `F ∈ L²` by Young's inequality
  set Fc : E3 → ℂ := fun y =>
    ∫ u, ((tailKer R a u : ℝ) : ℂ) * ((‖G (y - u • basisVec j)‖ : ℝ) : ℂ) with hFcdef
  have hFcF : ∀ y, Fc y = (F y : ℂ) := fun y => by
    rw [hFcdef, hFdef]; simp only
    rw [← integral_complex_ofReal]; push_cast; rfl
  have hGn : Measurable fun x => ((‖G x‖ : ℝ) : ℂ) := Complex.measurable_ofReal.comp hGm.norm
  have hY := eLpNorm_integral_smul_translate_le (μ := (volume : Measure E3)) (p := 2)
    (by norm_num) (by simp) (Complex.measurable_ofReal.comp (measurable_tailKer R a)) hGn
    (basisVec j)
  have hK1 : eLpNorm (fun u => ((tailKer R a u : ℝ) : ℂ)) 1 volume
      ≤ ENNReal.ofReal (etaKerMom 2 / (R * a) ^ 2) := by
    rw [eLpNorm_one_eq_lintegral_enorm
      (Complex.continuous_ofReal.comp_aestronglyMeasurable (integrable_tailKer hR
        ha).aestronglyMeasurable)]
    have e : ∫⁻ u, ‖((tailKer R a u : ℝ) : ℂ)‖ₑ = ENNReal.ofReal (∫ u, tailKer R a u) := by
      rw [ofReal_integral_eq_lintegral_ofReal (integrable_tailKer hR ha)
        (Eventually.of_forall fun u => tailKer_nonneg ha u)]
      refine lintegral_congr fun u => ?_
      rw [← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg (tailKer_nonneg ha u)]
    rw [e]
    exact ENNReal.ofReal_le_ofReal (integral_tailKer_le hR ha)
  have hGn2 : eLpNorm (fun x => ((‖G x‖ : ℝ) : ℂ)) 2 volume = eLpNorm G 2 volume :=
    eLpNorm_congr_norm_ae (by fun_prop) (by fun_prop) (Eventually.of_forall fun x => by simp)
  rw [hGn2] at hY
  have hY2 : eLpNorm Fc 2 volume
      ≤ ENNReal.ofReal (etaKerMom 2 / (R * a) ^ 2) * eLpNorm G 2 volume :=
    hY.trans (mul_le_mul_of_nonneg_right hK1 bot_le)
  have hFcm : Measurable Fc := by
    have hj : Measurable fun q : E3 × ℝ => ((tailKer R a q.2 : ℝ) : ℂ)
        * ((‖G (q.1 - q.2 • basisVec j)‖ : ℝ) : ℂ) :=
      (Complex.measurable_ofReal.comp ((measurable_tailKer R a).comp measurable_snd)).mul
        (Complex.measurable_ofReal.comp (hGm.comp (measurable_fst.sub
          (measurable_snd.smul_const _))).norm)
    exact (hj.stronglyMeasurable.integral_prod_right' (ν := (volume : Measure ℝ))).measurable
  have hFc2 : MemLp Fc 2 volume :=
    hY2.trans_lt (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hG2.eLpNorm_lt_top)
  have hFsq := integral_sq_le_of_eLpNorm_le hFc2 hG2
    (div_nonneg (etaKerMom_nonneg 2) (by positivity)) hY2
  have hFF : ∫ y, ‖Fc y‖ ^ 2 = ∫ y, F y ^ 2 := by
    refine integral_congr_ae (Eventually.of_forall fun y => ?_)
    simp only
    rw [hFcF, Complex.norm_real, Real.norm_of_nonneg (hF0 y)]
  rw [hFF] at hFsq
  -- integrate
  have hHsq : Integrable fun y => ‖G y - P R j G y‖ ^ 2 := hH2.integrable_norm_pow (by norm_num)
  have hFsqi : Integrable fun y => F y ^ 2 := by
    have := hFc2.integrable_norm_pow (by norm_num : (2 : ℕ) ≠ 0)
    refine this.congr (Eventually.of_forall fun y => ?_)
    simp only
    rw [hFcF, Complex.norm_real, Real.norm_of_nonneg (hF0 y)]
  have hRHS : Integrable fun y => 10 * ‖G y - P R j G y‖ ^ 2 + 5 * F y ^ 2 :=
    (hHsq.const_mul 10).add (hFsqi.const_mul 5)
  have hLHSm : Measurable fun y => (1 + cubeDist N j ν y ^ 2) * ‖G y - P R j G y‖ ^ 2 :=
    (measurable_const.add ((measurable_cubeDist N j ν).pow_const 2)).mul (hHm.norm.pow_const 2)
  have hLHS : Integrable fun y => (1 + cubeDist N j ν y ^ 2) * ‖G y - P R j G y‖ ^ 2 :=
    hRHS.mono' hLHSm.aestronglyMeasurable (Eventually.of_forall fun y => by
      rw [Real.norm_of_nonneg (by positivity)]; exact hpt y)
  refine ⟨hLHS, (integral_mono hLHS hRHS hpt).trans ?_⟩
  rw [integral_add (hHsq.const_mul 10) (hFsqi.const_mul 5), integral_const_mul,
    integral_const_mul]
  have h5 : 5 * ∫ y, F y ^ 2 ≤ 5 * ((etaKerMom 2 / (R * a) ^ 2) ^ 2 * ∫ y, ‖G y‖ ^ 2) :=
    mul_le_mul_of_nonneg_left hFsq (by norm_num)
  linarith

end

/-! ### `new:global-decaying-point`: weights, Cauchy-Schwarz and discrete Hoelder -/

section
open Filter Topology MeasureTheory

theorem inv_one_add_sq_le (n : ℕ) :
    (1 + (n : ℝ) ^ 2)⁻¹ ≤ 3 * (1 / ((n : ℝ) + 1) - 1 / ((n : ℝ) + 2)) := by
  have h : (1 : ℝ) / ((n : ℝ) + 1) - 1 / ((n : ℝ) + 2) = 1 / (((n : ℝ) + 1) * ((n : ℝ) + 2)) := by
    field_simp; ring
  rw [h, ← one_div, mul_one_div, div_le_div_iff₀ (by positivity) (by positivity)]
  have : (0 : ℝ) ≤ (2 * n - 1) * (n - 1) := by
    rcases Nat.eq_zero_or_pos n with h0 | h0
    · subst h0; norm_num
    · have : (1 : ℝ) ≤ n := by exact_mod_cast h0
      nlinarith
  nlinarith

theorem sum_range_inv_one_add_sq_le (L : ℕ) :
    ∑ n ∈ Finset.range L, (1 + (n : ℝ) ^ 2)⁻¹ ≤ 3 := by
  have htel : ∑ n ∈ Finset.range L, 3 * (1 / ((n : ℝ) + 1) - 1 / (n + 2)) = 3 * (1 - 1 / (L + 1))
    := by
    induction L with
    | zero => simp
    | succ L ih =>
      rw [Finset.sum_range_succ, ih]; push_cast; field_simp; ring
  calc ∑ n ∈ Finset.range L, (1 + (n : ℝ) ^ 2)⁻¹
      ≤ ∑ n ∈ Finset.range L, 3 * (1 / ((n : ℝ) + 1) - 1 / (n + 2)) :=
        Finset.sum_le_sum fun n _ => inv_one_add_sq_le n
    _ = 3 * (1 - 1 / (L + 1)) := htel
    _ ≤ 3 := by
        have : 0 ≤ 1 / ((L : ℝ) + 1) := by positivity
        linarith

/-- **The weights are summable uniformly**: for a finite set of integers,
`∑_{m ∈ F} 1/(1 + (k - m)²) ≤ 6`. -/
theorem sum_inv_one_add_sq_int_le (F : Finset ℤ) (k : ℤ) :
    ∑ m ∈ F, (1 + ((k - m : ℤ) : ℝ) ^ 2)⁻¹ ≤ 6 := by
  set L := (F.image fun m => (|k - m|).toNat).sup id + 1 with hL
  have hmem : ∀ m ∈ F, (|k - m|).toNat < L := fun m hm => by
    have : (|k - m|).toNat ≤ (F.image fun m => (|k - m|).toNat).sup id :=
      Finset.le_sup (f := id) (Finset.mem_image_of_mem _ hm)
    omega
  have hsplit : ∑ m ∈ F, (1 + ((k - m : ℤ) : ℝ) ^ 2)⁻¹
      = ∑ m ∈ F.filter (fun m => m ≤ k), (1 + ((k - m : ℤ) : ℝ) ^ 2)⁻¹
        + ∑ m ∈ F.filter (fun m => ¬ m ≤ k), (1 + ((k - m : ℤ) : ℝ) ^ 2)⁻¹ :=
    (Finset.sum_filter_add_sum_filter_not _ _ _).symm
  have hpart : ∀ (P : ℤ → Prop) [DecidablePred P], (∀ m, P m → ∀ m', P m' →
      (|k - m|).toNat = (|k - m'|).toNat → m = m') →
      ∑ m ∈ F.filter P, (1 + ((k - m : ℤ) : ℝ) ^ 2)⁻¹ ≤ 3 := by
    intro P _ hinj
    have e : ∀ m, (1 + ((k - m : ℤ) : ℝ) ^ 2)⁻¹ = (1 + (((|k - m|).toNat : ℕ) : ℝ) ^ 2)⁻¹ := by
      intro m
      congr 2
      have h1 : (((|k - m|).toNat : ℕ) : ℤ) = |k - m| := Int.toNat_of_nonneg (abs_nonneg _)
      have h2 : (((|k - m|).toNat : ℕ) : ℝ) = ((|k - m| : ℤ) : ℝ) := by exact_mod_cast h1
      rw [h2, Int.cast_abs, sq_abs]
    simp_rw [e]
    rw [← Finset.sum_image (f := fun n : ℕ => (1 + (n : ℝ) ^ 2)⁻¹)
      (fun m hm m' hm' h => hinj m (Finset.mem_filter.mp hm).2 m' (Finset.mem_filter.mp hm').2 h)]
    refine le_trans (Finset.sum_le_sum_of_subset_of_nonneg ?_ fun _ _ _ => by positivity)
      (sum_range_inv_one_add_sq_le L)
    intro n hn
    obtain ⟨m, hm, rfl⟩ := Finset.mem_image.mp hn
    exact Finset.mem_range.mpr (hmem m (Finset.mem_filter.mp hm).1)
  rw [hsplit]
  have h1 := hpart (fun m => m ≤ k) (fun m hm m' hm' h => by
    have a1 : |k - m| = k - m := abs_of_nonneg (by omega)
    have a2 : |k - m'| = k - m' := abs_of_nonneg (by omega)
    rw [a1, a2] at h; omega)
  have h2 := hpart (fun m => ¬ m ≤ k) (fun m hm m' hm' h => by
    have a1 : |k - m| = m - k := by rw [abs_of_neg (by omega)]; ring
    have a2 : |k - m'| = m' - k := by rw [abs_of_neg (by omega)]; ring
    rw [a1, a2] at h; omega)
  linarith

/-- **Weighted Cauchy-Schwarz** for a finite sum whose nonzero terms lie in `T`. -/
theorem sq_norm_sum_le_weighted {ι : Type*} (S T : Finset ι) (hTS : T ⊆ S) (a : ι → ℂ)
    (w : ι → ℝ) (hw : ∀ i, 0 < w i) (hT : ∀ i ∈ S, a i ≠ 0 → i ∈ T) :
    ‖∑ i ∈ S, a i‖ ^ 2 ≤ (∑ i ∈ T, (w i)⁻¹) * ∑ i ∈ S, w i * ‖a i‖ ^ 2 := by
  have hST : ∑ i ∈ S, a i = ∑ i ∈ T, a i := by
    refine (Finset.sum_subset hTS fun i hi hiT => ?_).symm
    by_contra h; exact hiT (hT i hi h)
  rw [hST]
  have h1 : ‖∑ i ∈ T, a i‖ ≤ ∑ i ∈ T, Real.sqrt (w i)⁻¹ * (Real.sqrt (w i) * ‖a i‖) := by
    refine (norm_sum_le _ _).trans (le_of_eq (Finset.sum_congr rfl fun i _ => ?_))
    rw [← mul_assoc, ← Real.sqrt_mul (inv_nonneg.mpr (hw i).le), inv_mul_cancel₀ (hw i).ne',
      Real.sqrt_one, one_mul]
  have h2 := Finset.sum_mul_sq_le_sq_mul_sq T (fun i => Real.sqrt (w i)⁻¹)
    (fun i => Real.sqrt (w i) * ‖a i‖)
  have h3 : ∑ i ∈ T, (Real.sqrt (w i) * ‖a i‖) ^ 2 ≤ ∑ i ∈ S, w i * ‖a i‖ ^ 2 := by
    refine le_trans (le_of_eq (Finset.sum_congr rfl fun i _ => ?_))
      (Finset.sum_le_sum_of_subset_of_nonneg hTS fun i _ _ => by
        have := hw i; positivity)
    rw [mul_pow, Real.sq_sqrt (hw i).le]
  have h4 : ∑ i ∈ T, Real.sqrt (w i)⁻¹ ^ 2 = ∑ i ∈ T, (w i)⁻¹ :=
    Finset.sum_congr rfl fun i _ => Real.sq_sqrt (inv_nonneg.mpr (hw i).le)
  rw [h4] at h2
  calc ‖∑ i ∈ T, a i‖ ^ 2
      ≤ (∑ i ∈ T, Real.sqrt (w i)⁻¹ * (Real.sqrt (w i) * ‖a i‖)) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) h1 2
    _ ≤ _ := h2
    _ ≤ _ := mul_le_mul_of_nonneg_left h3 (Finset.sum_nonneg fun i _ => by
        have := hw i; positivity)

/-- **Discrete Hoelder for three factors**: `∑ x y z ≤ ‖x‖_p ‖y‖_q ‖z‖_r` for nonnegative
sequences and `1/p + 1/q + 1/r = 1`, by the weighted arithmetic-geometric mean inequality. -/
theorem sum_mul3_le_holder {ι : Type*} (S : Finset ι) {x y z : ι → ℝ} (hx : ∀ i, 0 ≤ x i)
    (hy : ∀ i, 0 ≤ y i) (hz : ∀ i, 0 ≤ z i) {p q r : ℝ} (hp : 0 < p) (hq : 0 < q) (hr : 0 < r)
    (hpqr : 1 / p + 1 / q + 1 / r = 1) :
    ∑ i ∈ S, x i * y i * z i
      ≤ (∑ i ∈ S, x i ^ p) ^ (1 / p) * (∑ i ∈ S, y i ^ q) ^ (1 / q)
        * (∑ i ∈ S, z i ^ r) ^ (1 / r) := by
  set X := ∑ i ∈ S, x i ^ p with hX
  set Y := ∑ i ∈ S, y i ^ q with hY
  set Z := ∑ i ∈ S, z i ^ r with hZ
  have hX0 : 0 ≤ X := Finset.sum_nonneg fun i _ => Real.rpow_nonneg (hx i) _
  have hY0 : 0 ≤ Y := Finset.sum_nonneg fun i _ => Real.rpow_nonneg (hy i) _
  have hZ0 : 0 ≤ Z := Finset.sum_nonneg fun i _ => Real.rpow_nonneg (hz i) _
  -- a vanishing norm forces a vanishing sequence
  have hzero : ∀ {f : ι → ℝ} {s : ℝ}, 0 < s → (∀ i, 0 ≤ f i) → ∑ i ∈ S, f i ^ s = 0 →
      ∀ i ∈ S, f i = 0 := fun {f s} hs hf h i hi => by
    have := (Finset.sum_eq_zero_iff_of_nonneg fun i _ => Real.rpow_nonneg (hf i) s).mp h i hi
    exact (Real.rpow_eq_zero (hf i) hs.ne').mp this
  by_cases h0 : X = 0 ∨ Y = 0 ∨ Z = 0
  · have hlhs : ∑ i ∈ S, x i * y i * z i = 0 := by
      refine Finset.sum_eq_zero fun i hi => ?_
      rcases h0 with h | h | h
      · rw [hzero hp hx h i hi]; ring
      · rw [hzero hq hy h i hi]; ring
      · rw [hzero hr hz h i hi]; ring
    rw [hlhs]; positivity
  push Not at h0
  obtain ⟨hXn, hYn, hZn⟩ := h0
  have hXp : 0 < X := lt_of_le_of_ne hX0 (Ne.symm hXn)
  have hYp : 0 < Y := lt_of_le_of_ne hY0 (Ne.symm hYn)
  have hZp : 0 < Z := lt_of_le_of_ne hZ0 (Ne.symm hZn)
  set A := X ^ (1 / p) with hA
  set B := Y ^ (1 / q) with hB
  set C := Z ^ (1 / r) with hC
  have hA0 : 0 < A := Real.rpow_pos_of_pos hXp _
  have hB0 : 0 < B := Real.rpow_pos_of_pos hYp _
  have hC0 : 0 < C := Real.rpow_pos_of_pos hZp _
  have hAp : A ^ p = X := by
    rw [hA, ← Real.rpow_mul hX0, one_div, inv_mul_cancel₀ hp.ne', Real.rpow_one]
  have hBq : B ^ q = Y := by
    rw [hB, ← Real.rpow_mul hY0, one_div, inv_mul_cancel₀ hq.ne', Real.rpow_one]
  have hCr : C ^ r = Z := by
    rw [hC, ← Real.rpow_mul hZ0, one_div, inv_mul_cancel₀ hr.ne', Real.rpow_one]
  -- the pointwise weighted AM-GM
  have hpt : ∀ i, x i / A * (y i / B) * (z i / C)
      ≤ 1 / p * (x i / A) ^ p + 1 / q * (y i / B) ^ q + 1 / r * (z i / C) ^ r := by
    intro i
    have ha := div_nonneg (hx i) hA0.le
    have hb := div_nonneg (hy i) hB0.le
    have hc := div_nonneg (hz i) hC0.le
    have h := Real.geom_mean_le_arith_mean3_weighted (w₁ := 1 / p) (w₂ := 1 / q) (w₃ := 1 / r)
      (p₁ := (x i / A) ^ p) (p₂ := (y i / B) ^ q) (p₃ := (z i / C) ^ r) (by positivity)
      (by positivity) (by positivity) (Real.rpow_nonneg ha _) (Real.rpow_nonneg hb _)
      (Real.rpow_nonneg hc _) hpqr
    rwa [← Real.rpow_mul ha, ← Real.rpow_mul hb, ← Real.rpow_mul hc, mul_one_div_cancel hp.ne',
      mul_one_div_cancel hq.ne', mul_one_div_cancel hr.ne', Real.rpow_one, Real.rpow_one,
      Real.rpow_one] at h
  have hsum : ∀ {f : ι → ℝ} {s D : ℝ}, (∀ i, 0 ≤ f i) → 0 < D → D ^ s = ∑ i ∈ S, f i ^ s →
      ∑ i ∈ S, (f i / D) ^ s = 1 := fun {f s D} hf hD hDs => by
    simp_rw [Real.div_rpow (hf _) hD.le]
    rw [← Finset.sum_div, ← hDs, div_self (Real.rpow_pos_of_pos hD s).ne']
  have htot : ∑ i ∈ S, x i / A * (y i / B) * (z i / C) ≤ 1 := by
    calc ∑ i ∈ S, x i / A * (y i / B) * (z i / C)
        ≤ ∑ i ∈ S, (1 / p * (x i / A) ^ p + 1 / q * (y i / B) ^ q + 1 / r * (z i / C) ^ r) :=
          Finset.sum_le_sum fun i _ => hpt i
      _ = 1 / p * ∑ i ∈ S, (x i / A) ^ p + 1 / q * ∑ i ∈ S, (y i / B) ^ q
          + 1 / r * ∑ i ∈ S, (z i / C) ^ r := by
          rw [Finset.sum_add_distrib, Finset.sum_add_distrib, Finset.mul_sum, Finset.mul_sum,
            Finset.mul_sum]
      _ = 1 := by
          rw [hsum (f := x) hx hA0 (by rw [hAp]), hsum (f := y) hy hB0 (by rw [hBq]),
            hsum (f := z) hz hC0 (by rw [hCr])]
          linarith
  have e : ∑ i ∈ S, x i * y i * z i = A * B * C * ∑ i ∈ S, x i / A * (y i / B) * (z i / C) := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    field_simp
  rw [e]
  calc A * B * C * ∑ i ∈ S, x i / A * (y i / B) * (z i / C) ≤ A * B * C * 1 :=
        mul_le_mul_of_nonneg_left htot (by positivity)
    _ = A * B * C := mul_one _

/-- **The cubes partition the space**: `∑_{ν ∈ S} ∫ |1_{Q_{ν+c}} g|^u ≤ ∫ |g|^u`. -/
theorem sum_integral_boxRes_le (N : ℝ) (S : Finset (Fin 3 → ℤ)) (c : Fin 3 → ℤ) {g : E3 → ℂ}
    (hg : Measurable g) {u : ℝ} (hu : 0 < u) (hgi : Integrable fun x => ‖g x‖ ^ u) :
    ∑ ν ∈ S, ∫ x, ‖boxRes N (ν + c) g x‖ ^ u ≤ ∫ x, ‖g x‖ ^ u := by
  have hint : ∀ ν, Integrable fun x => ‖boxRes N (ν + c) g x‖ ^ u := fun ν =>
    hgi.mono' ((measurable_boxRes N _ hg).norm.pow_const u).aestronglyMeasurable
      (Eventually.of_forall fun x => by
        rw [Real.norm_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)]
        exact Real.rpow_le_rpow (norm_nonneg _) (norm_boxRes_le N _ g x) hu.le)
  rw [← integral_finsetSum _ fun ν _ => hint ν]
  refine integral_mono (integrable_finsetSum _ fun ν _ => hint ν) hgi fun x => ?_
  have e : ∀ ν, ‖boxRes N (ν + c) g x‖ ^ u = if ν = boxIdx N x - c then ‖g x‖ ^ u else 0 := by
    intro ν
    unfold boxRes
    by_cases h : boxIdx N x = ν + c
    · rw [ite_eq_left h, ite_eq_left (by rw [h]; abel)]
    · rw [ite_eq_right h, ite_eq_right (fun h' => h (by rw [h']; abel)), norm_zero,
        Real.zero_rpow hu.ne']
  simp only [e, Finset.sum_ite_eq']
  split_ifs
  · exact le_rfl
  · exact Real.rpow_nonneg (norm_nonneg _) _

end

/-! ### `new:global-decaying-point`: supports of the pieces -/

section
open Filter Topology MeasureTheory

/-- The adjoint of a piece lives in the cube column of `ν` along `e_j`, two cubes long. -/
theorem adjT_piece_support {N : ℝ} (hN : 0 < N) (j : Fin 3) (ν : Fin 3 → ℤ) (ε ε' : Fin 2)
    (g : Fin 3 → E3 → ℂ) {y : E3} (hy : adjT N j (piece N j ν ε ε' g) y ≠ 0) :
    (∀ i, i ≠ j → boxIdx N y i = ν i) ∧ (boxIdx N y j = ν j ∨ boxIdx N y j = ν j + 1) := by
  have : ∃ t ∈ Set.Icc (0 : ℝ) N, boxIdx N (y + adjVec j 0 t) = ν := by
    by_contra hcon
    push Not at hcon
    apply hy
    rw [adjT]
    rw [intervalIntegral.integral_congr (g := fun _ => (0 : ℂ)) fun t ht => by
      rw [Set.uIcc_of_le hN.le] at ht
      refine Finset.prod_eq_zero (Finset.mem_univ 0) ?_
      simp [piece, boxRes, hcon t ht]]
    simp
  obtain ⟨t, ht, hν⟩ := this
  have hs0 : 0 ≤ t ^ expo j := pow_nonneg ht.1 _
  have hs1 : t ^ expo j ≤ N ^ expo j := pow_le_pow_left₀ ht.1 ht.2 _
  have hy' : y = (y + adjVec j 0 t) + t ^ expo j • basisVec j := by
    simp [adjVec, curve]
  have hb := boxIdx_add_smul hN (y + adjVec j 0 t) j hs0 hs1
  rw [← hy', hν] at hb
  refine ⟨fun i hi => ?_, ?_⟩
  · rcases hb with h | h
    · rw [h]
    · rw [h]; simp [hi]
  · rcases hb with h | h
    · left; rw [h]
    · right; rw [h]; simp

/-- `P_R^{(j)}` preserves the cube row in the directions other than `e_j`. -/
theorem P_passive {R N : ℝ} (j : Fin 3) {F : E3 → ℂ} {ν : Fin 3 → ℤ}
    (hF : ∀ y, F y ≠ 0 → ∀ i, i ≠ j → boxIdx N y i = ν i) {y : E3}
    (hy : P R j F y ≠ 0) : ∀ i, i ≠ j → boxIdx N y i = ν i := by
  intro i hi
  by_contra hne
  apply hy
  rw [P]
  have h0 : ∀ u : ℝ, projKernel R u * F (y - u • basisVec j) = 0 := fun u => by
    by_cases hFu : F (y - u • basisVec j) = 0
    · rw [hFu, mul_zero]
    · have := hF _ hFu i hi
      simp only [boxIdx, PiLp.sub_apply, PiLp.smul_apply, basisVec_apply_ne hi, smul_eq_mul,
        mul_zero, sub_zero] at this
      exact absurd this hne
  simp [h0]

theorem hpAdj_piece_passive {N R : ℝ} (hN : 0 < N) (j : Fin 3) (ν : Fin 3 → ℤ) (ε ε' : Fin 2)
    (g : Fin 3 → E3 → ℂ) {y : E3} (hy : hpAdj N R j (piece N j ν ε ε' g) y ≠ 0) :
    ∀ i, i ≠ j → boxIdx N y i = ν i := by
  have hG : ∀ y, adjT N j (piece N j ν ε ε' g) y ≠ 0 → ∀ i, i ≠ j → boxIdx N y i = ν i :=
    fun y h => (adjT_piece_support hN j ν ε ε' g h).1
  by_cases h1 : adjT N j (piece N j ν ε ε' g) y = 0
  · have h2 : P R j (adjT N j (piece N j ν ε ε' g)) y ≠ 0 := by
      intro h2; apply hy; simp [hpAdj, h1, h2]
    exact P_passive j hG h2
  · exact hG y h1

end

/-! ### `new:global-decaying-point`: one offset -/

section
open Filter Topology MeasureTheory

theorem sum_inv_weight_le {N : ℝ} (j : Fin 3) (y : E3) (S : Finset (Fin 3 → ℤ)) :
    ∑ ν ∈ S.filter (fun ν => ∀ i, i ≠ j → ν i = boxIdx N y i), (1 + cubeDist N j ν y ^ 2)⁻¹
      ≤ 6 := by
  set T := S.filter (fun ν => ∀ i, i ≠ j → ν i = boxIdx N y i) with hTdef
  have hinj : Set.InjOn (fun ν : Fin 3 → ℤ => ν j) (T : Set (Fin 3 → ℤ)) := by
    intro ν hν ν' hν' h
    simp only [hTdef, Finset.coe_filter, Set.mem_ofPred_eq] at hν hν'
    funext i
    by_cases hi : i = j
    · subst hi; exact h
    · rw [hν.2 i hi, hν'.2 i hi]
  have e : ∑ ν ∈ T, (1 + cubeDist N j ν y ^ 2)⁻¹
      = ∑ m ∈ T.image (fun ν => ν j), (1 + ((boxIdx N y j - m : ℤ) : ℝ) ^ 2)⁻¹ := by
    rw [Finset.sum_image hinj]
    rfl
  rw [e]
  exact sum_inv_one_add_sq_int_le _ _

set_option maxHeartbeats 1000000 in
-- The pointwise Cauchy-Schwarz and the integration share one context.
/-- **`new:global-decaying-point`, one offset**: the pieces `H_ν` with passive-row supports and
the weighted tail bounds satisfy `‖∑_ν H_ν‖₂² ≤ 6 (10 c² + 5 T²) ∑_ν Π_ν²`. -/
theorem offset_bound {N : ℝ} (j : Fin 3) (S : Finset (Fin 3 → ℤ))
    (H G : (Fin 3 → ℤ) → E3 → ℂ) (Pi : (Fin 3 → ℤ) → ℝ) {c₀ T : ℝ}
    (hH2 : ∀ ν, MemLp (H ν) 2 volume)
    (hpass : ∀ ν y, H ν y ≠ 0 → ∀ i, i ≠ j → boxIdx N y i = ν i)
    (hw : ∀ ν, Integrable (fun y => (1 + cubeDist N j ν y ^ 2) * ‖H ν y‖ ^ 2) ∧
      ∫ y, (1 + cubeDist N j ν y ^ 2) * ‖H ν y‖ ^ 2
        ≤ 10 * (∫ y, ‖H ν y‖ ^ 2) + 5 * T ^ 2 * ∫ y, ‖G ν y‖ ^ 2)
    (hHb : ∀ ν, ∫ y, ‖H ν y‖ ^ 2 ≤ c₀ ^ 2 * Pi ν ^ 2)
    (hGb : ∀ ν, ∫ y, ‖G ν y‖ ^ 2 ≤ Pi ν ^ 2) :
    ∫ y, ‖∑ ν ∈ S, H ν y‖ ^ 2 ≤ 6 * (10 * c₀ ^ 2 + 5 * T ^ 2) * ∑ ν ∈ S, Pi ν ^ 2 := by
  have hwpos : ∀ ν y, 0 < 1 + cubeDist N j ν y ^ 2 := fun ν y => by positivity
  have hpt : ∀ y, ‖∑ ν ∈ S, H ν y‖ ^ 2
      ≤ 6 * ∑ ν ∈ S, (1 + cubeDist N j ν y ^ 2) * ‖H ν y‖ ^ 2 := by
    intro y
    have h := sq_norm_sum_le_weighted S (S.filter (fun ν => ∀ i, i ≠ j → ν i = boxIdx N y i))
      (Finset.filter_subset _ _) (fun ν => H ν y) (fun ν => 1 + cubeDist N j ν y ^ 2)
      (fun ν => hwpos ν y) (fun ν hν hne => Finset.mem_filter.mpr
        ⟨hν, fun i hi => (hpass ν y hne i hi).symm⟩)
    refine h.trans (mul_le_mul_of_nonneg_right (sum_inv_weight_le j y S)
      (Finset.sum_nonneg fun ν _ => by have := hwpos ν y; positivity))
  have hsum2 : MemLp (fun y => ∑ ν ∈ S, H ν y) 2 volume := by
    have := memLp_finsetSum' S fun ν _ => hH2 ν
    convert this using 1
    funext y; simp [Finset.sum_apply]
  have hLi : Integrable fun y => ‖∑ ν ∈ S, H ν y‖ ^ 2 := hsum2.integrable_norm_pow (by norm_num)
  have hRi : Integrable fun y => 6 * ∑ ν ∈ S, (1 + cubeDist N j ν y ^ 2) * ‖H ν y‖ ^ 2 :=
    (integrable_finsetSum _ fun ν _ => (hw ν).1).const_mul 6
  refine (integral_mono hLi hRi hpt).trans ?_
  rw [integral_const_mul, integral_finsetSum _ fun ν _ => (hw ν).1, mul_assoc,
    Finset.mul_sum S (fun ν => Pi ν ^ 2) (10 * c₀ ^ 2 + 5 * T ^ 2)]
  gcongr with ν hν
  have h1 := (hw ν).2
  have h2 := hHb ν
  have h3 := hGb ν
  have hT2 : 0 ≤ 5 * T ^ 2 := by positivity
  nlinarith [mul_le_mul_of_nonneg_left h3 hT2]

end

/-! ### `new:global-decaying-point`: norms, the crude bound and Hoelder over the cubes -/

section
open Filter Topology MeasureTheory

theorem toReal_eLpNorm_rpow {f : E3 → ℂ} {u : ℝ} (hu : 0 < u)
    (hf : MemLp f (ENNReal.ofReal u) volume) :
    (eLpNorm f (ENNReal.ofReal u) volume).toReal ^ u = ∫ x, ‖f x‖ ^ u := by
  rw [hf.eLpNorm_eq_integral_rpow_norm (by simpa using hu) ENNReal.ofReal_ne_top,
    ENNReal.toReal_ofReal hu.le,
    ENNReal.toReal_ofReal (Real.rpow_nonneg (integral_nonneg fun x => by positivity) _)]
  exact Real.rpow_inv_rpow (integral_nonneg fun x => by positivity) hu.ne'

theorem cdpExp_zero : cdpExp 0 = 61 / 10 := by simp [cdpExp]
theorem cdpExp_one : cdpExp 1 = 122 / 21 := by simp [cdpExp]
theorem cdpExp_two : cdpExp 2 = 61 / 10 := by simp [cdpExp]

theorem cdpExp_pos (k : Fin 3) : 0 < cdpExp k := by
  fin_cases k
  · rw [show ((⟨0, by norm_num⟩ : Fin 3)) = 0 from rfl, cdpExp_zero]; norm_num
  · rw [show ((⟨1, by norm_num⟩ : Fin 3)) = 1 from rfl, cdpExp_one]; norm_num
  · rw [show ((⟨2, by norm_num⟩ : Fin 3)) = 2 from rfl, cdpExp_two]; norm_num

theorem measurable_piece (N : ℝ) (j : Fin 3) (ν : Fin 3 → ℤ) (ε ε' : Fin 2)
    {g : Fin 3 → E3 → ℂ} (hg : ∀ k, Measurable (g k)) (k : Fin 3) :
    Measurable (piece N j ν ε ε' g k) := by
  fin_cases k
  · exact measurable_boxRes N _ (hg 0)
  · exact measurable_boxRes N _ (hg 1)
  · exact measurable_boxRes N _ (hg 2)

/-- The exponents of the adjoint slots: `g_0` at slot `j`, the inputs `1, 2` at `j + 1, j + 2`. -/
noncomputable def adjExp (j : Fin 3) (i : Fin 3) : ℝ≥0∞ :=
  if i = j then ENNReal.ofReal (cdpExp 0) else if i = j + 1 then ENNReal.ofReal (cdpExp 1)
    else ENNReal.ofReal (cdpExp 2)

theorem sum_inv_adjExp (j : Fin 3) : ∑ i, (adjExp j i)⁻¹ = (2 : ℝ≥0∞)⁻¹ := by
  have e : ∑ i, (adjExp j i)⁻¹ = (ENNReal.ofReal (cdpExp 0))⁻¹ + (ENNReal.ofReal (cdpExp 1))⁻¹
      + (ENNReal.ofReal (cdpExp 2))⁻¹ := by
    fin_cases j <;> simp [adjExp, Fin.sum_univ_three] <;> ring
  have i0 : (ENNReal.ofReal (61 / 10 : ℝ))⁻¹ = ENNReal.ofReal (10 / 61) := by
    rw [← ENNReal.ofReal_inv_of_pos (by norm_num)]; norm_num
  have i1 : (ENNReal.ofReal (122 / 21 : ℝ))⁻¹ = ENNReal.ofReal (21 / 122) := by
    rw [← ENNReal.ofReal_inv_of_pos (by norm_num)]; norm_num
  have i2 : (2 : ℝ≥0∞)⁻¹ = ENNReal.ofReal (1 / 2) := by
    rw [one_div, ENNReal.ofReal_inv_of_pos (by norm_num), ENNReal.ofReal_ofNat]
  rw [e, cdpExp_zero, cdpExp_one, cdpExp_two, i0, i1, i2,
    ← ENNReal.ofReal_add (by norm_num : (0 : ℝ) ≤ 10 / 61) (by norm_num : (0 : ℝ) ≤ 21 / 122),
    ← ENNReal.ofReal_add (by norm_num : (0 : ℝ) ≤ 10 / 61 + 21 / 122)
      (by norm_num : (0 : ℝ) ≤ 10 / 61)]
  norm_num

/-- **The crude bound for the adjoint of a finite-valued input triple**:
`‖adjT(g)‖₂ ≤ ∏ ‖g_k‖_{u_k}` (`new:adjoint-basic` with `∑ 1/u_k = 1/2`). -/
theorem eLpNorm_adjT_le {N : ℝ} (hN : 0 < N) (j : Fin 3) {g : Fin 3 → E3 → ℂ}
    (hg : ∀ k, Measurable (g k)) :
    eLpNorm (adjT N j g) 2 volume ≤ ∏ k, eLpNorm (g k) (ENNReal.ofReal (cdpExp k)) volume := by
  have h := eLpNorm_Astar_le hN j (hg 0) (measurable_adjIn j hg) (r := 2) (by norm_num)
    (by simp) (sum_inv_adjExp j)
  rw [Astar_adjIn] at h
  refine h.trans (le_of_eq ?_)
  have h12 : j + 1 ≠ j + 2 := by fin_cases j <;> decide
  have h1 : j + 1 ≠ j := by fin_cases j <;> decide
  have h2 : j + 2 ≠ j := by fin_cases j <;> decide
  rw [univ_erase_eq, Finset.prod_pair h12, Fin.prod_univ_three]
  have hA1 : adjIn j g (j + 1) = fun x => conj (g 1 x) := by simp [adjIn]
  have hA2 : adjIn j g (j + 2) = fun x => conj (g 2 x) := by simp [adjIn, h12.symm]
  rw [hA1, hA2, eLpNorm_conj_eq, eLpNorm_conj_eq]
  simp only [adjExp, ite_true, ite_eq_right h1, ite_eq_right h2, ite_eq_right h12.symm]
  ring

/-- The cube offsets of the three slots of a piece. -/
def pieceOff (j : Fin 3) (ε ε' : Fin 2) : Fin 3 → Fin 3 → ℤ :=
  ![0, offV (j + 1) ε, offV (j + 2) ε']

theorem piece_eq_boxRes (N : ℝ) (j : Fin 3) (ν : Fin 3 → ℤ) (ε ε' : Fin 2) (g : Fin 3 → E3 → ℂ)
    (k : Fin 3) : piece N j ν ε ε' g k = boxRes N (ν + pieceOff j ε ε' k) (g k) := by
  fin_cases k <;> simp [piece, pieceOff]

/-- **Discrete Hoelder over the cubes**: `∑_ν (∏_k ‖g_{k,ν}‖_{u_k})² ≤ (∏_k ‖g_k‖_{u_k})²`,
since `∑_k 2/u_k = 1` and the cubes of each slot are disjoint. -/
theorem holder_cubes (N : ℝ) (S : Finset (Fin 3 → ℤ)) (j : Fin 3) (ε ε' : Fin 2)
    {g : Fin 3 → E3 → ℂ} (hg : ∀ k, Measurable (g k))
    (hgp : ∀ k, MemLp (g k) (ENNReal.ofReal (cdpExp k)) volume) :
    ∑ ν ∈ S, (∏ k, (eLpNorm (piece N j ν ε ε' g k) (ENNReal.ofReal (cdpExp k)) volume).toReal) ^ 2
      ≤ (∏ k, (eLpNorm (g k) (ENNReal.ofReal (cdpExp k)) volume).toReal) ^ 2 := by
  set L : Fin 3 → (Fin 3 → ℤ) → ℝ := fun k ν =>
    (eLpNorm (piece N j ν ε ε' g k) (ENNReal.ofReal (cdpExp k)) volume).toReal with hLdef
  set Lg : Fin 3 → ℝ := fun k => (eLpNorm (g k) (ENNReal.ofReal (cdpExp k)) volume).toReal
    with hLgdef
  have hL0 : ∀ k ν, 0 ≤ L k ν := fun k ν => ENNReal.toReal_nonneg
  have hLg0 : ∀ k, 0 ≤ Lg k := fun k => ENNReal.toReal_nonneg
  have hpp : ∀ k ν, MemLp (piece N j ν ε ε' g k) (ENNReal.ofReal (cdpExp k)) volume := by
    intro k ν
    rw [piece_eq_boxRes]
    exact (hgp k).mono (measurable_boxRes N _ (hg k)).aestronglyMeasurable
      (Eventually.of_forall fun x => norm_boxRes_le N _ _ x)
  -- `∑_ν L_k(ν)^{u_k} ≤ Lg_k^{u_k}`
  have hpart : ∀ k, ∑ ν ∈ S, L k ν ^ cdpExp k ≤ Lg k ^ cdpExp k := by
    intro k
    have hu := cdpExp_pos k
    simp only [hLdef, hLgdef]
    rw [toReal_eLpNorm_rpow hu (hgp k)]
    simp_rw [toReal_eLpNorm_rpow hu (hpp k _), piece_eq_boxRes]
    have hgi : Integrable fun x => ‖g k x‖ ^ cdpExp k := by
      have := (hgp k).integrable_norm_rpow (by simpa using hu) ENNReal.ofReal_ne_top
      simpa [ENNReal.toReal_ofReal hu.le] using this
    exact sum_integral_boxRes_le N S (pieceOff j ε ε' k) (hg k) hu hgi
  -- the exponents `p_k = u_k / 2`
  have hp : ∀ k, 0 < cdpExp k / 2 := fun k => by have := cdpExp_pos k; positivity
  have hsum : 1 / (cdpExp 0 / 2) + 1 / (cdpExp 1 / 2) + 1 / (cdpExp 2 / 2) = 1 := by
    rw [cdpExp_zero, cdpExp_one, cdpExp_two]; norm_num
  have hsq : ∀ k ν, (L k ν ^ 2) ^ (cdpExp k / 2) = L k ν ^ cdpExp k := fun k ν => by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (hL0 k ν)]; congr 1; push_cast; ring
  have hroot : ∀ k, (∑ ν ∈ S, L k ν ^ cdpExp k) ^ (1 / (cdpExp k / 2)) ≤ Lg k ^ 2 := fun k => by
    have hu := cdpExp_pos k
    calc (∑ ν ∈ S, L k ν ^ cdpExp k) ^ (1 / (cdpExp k / 2))
        ≤ (Lg k ^ cdpExp k) ^ (1 / (cdpExp k / 2)) :=
          Real.rpow_le_rpow (Finset.sum_nonneg fun ν _ => Real.rpow_nonneg (hL0 k ν) _)
            (hpart k) (by positivity)
      _ = Lg k ^ 2 := by
          rw [← Real.rpow_mul (hLg0 k), show cdpExp k * (1 / (cdpExp k / 2)) = 2 by
            field_simp]
          exact_mod_cast Real.rpow_natCast (Lg k) 2
  have hH := sum_mul3_le_holder S (x := fun ν => L 0 ν ^ 2) (y := fun ν => L 1 ν ^ 2)
    (z := fun ν => L 2 ν ^ 2) (fun ν => sq_nonneg _) (fun ν => sq_nonneg _) (fun ν => sq_nonneg _)
    (hp 0) (hp 1) (hp 2) hsum
  simp_rw [hsq] at hH
  calc ∑ ν ∈ S, (∏ k, L k ν) ^ 2 = ∑ ν ∈ S, L 0 ν ^ 2 * L 1 ν ^ 2 * L 2 ν ^ 2 := by
        refine Finset.sum_congr rfl fun ν _ => ?_
        rw [Fin.prod_univ_three]; ring
    _ ≤ _ := hH
    _ ≤ Lg 0 ^ 2 * Lg 1 ^ 2 * Lg 2 ^ 2 := by
        gcongr
        exacts [hroot 0, hroot 1, hroot 2]
    _ = (∏ k, Lg k) ^ 2 := by rw [Fin.prod_univ_three]; ring

end

/-! ### `new:global-decaying-point`: the theorem -/

section
open Filter Topology MeasureTheory

/-- The finitely many cubes meeting `B_N(C)`. -/
noncomputable def coverSet (C : ℝ) : Finset (Fin 3 → ℤ) :=
  Fintype.piFinset fun _ => Finset.Icc (-(⌈C⌉ + 1)) (⌈C⌉ + 1)

theorem boxIdx_mem_coverSet {N C : ℝ} (hN : 0 < N) {x : E3} (hx : x ∈ petBox C N) :
    boxIdx N x ∈ coverSet C := by
  rw [coverSet, Fintype.mem_piFinset]
  intro i
  have hNi : 0 < N ^ expo i := pow_pos hN _
  have hi := hx i
  have h1 : -C ≤ x i / N ^ expo i := by rw [le_div_iff₀ hNi]; linarith [hi.1]
  have h2 : x i / N ^ expo i ≤ C := by rw [div_le_iff₀ hNi]; linarith [hi.2]
  have hf1 := Int.floor_le (x i / N ^ expo i)
  have hf2 := Int.lt_floor_add_one (x i / N ^ expo i)
  have hc := Int.le_ceil C
  rw [Finset.mem_Icc]
  simp only [boxIdx]
  constructor
  · have : (-(⌈C⌉ + 1 : ℤ) : ℝ) < (⌊x i / N ^ expo i⌋ : ℝ) + 1 := by push_cast; linarith
    have : -(⌈C⌉ + 1) < ⌊x i / N ^ expo i⌋ + 1 := by exact_mod_cast this
    omega
  · have : (⌊x i / N ^ expo i⌋ : ℝ) ≤ ((⌈C⌉ + 1 : ℤ) : ℝ) := by push_cast; linarith
    exact_mod_cast this

theorem eLpNorm_add4_le {f₁ f₂ f₃ f₄ : E3 → ℂ} :
    eLpNorm (fun y => f₁ y + f₂ y + (f₃ y + f₄ y)) 2 volume
      ≤ eLpNorm f₁ 2 volume + eLpNorm f₂ 2 volume + (eLpNorm f₃ 2 volume
        + eLpNorm f₄ 2 volume) := by
  have e : (fun y => f₁ y + f₂ y + (f₃ y + f₄ y)) = (f₁ + f₂) + (f₃ + f₄) := rfl
  rw [e]
  refine (eLpNorm_add_le
    (by norm_num)).trans (add_le_add ?_ ?_)
  · exact eLpNorm_add_le (by norm_num)
  · exact eLpNorm_add_le (by norm_num)

set_option maxHeartbeats 4000000 in
-- The decomposition, the four offsets and all constants share one context.
/-- **Theorem `new:global-decaying-point`** (global decaying `L²` estimate) on finite-valued inputs
of bounded support: `‖(I - P_R^{(j)}) A_N^{*j}(g)‖₂ ≤ C₄ μ^{a₁} ∏ ‖g_i‖_{u_i}` with no support
restriction, `R = N^{-j} μ^{-2}`. The inputs are decomposed along the cubes `Q_ν`
(`Auto.hpAdj_decomp`); each piece obeys the compact bound after translation
(`Auto.piece_bound`) and the weighted tail bound (`Auto.weighted_tail`); the weighted
Cauchy-Schwarz inequality with the summable weights `(1 + ℓ²)⁻¹` and discrete Hoelder over the
cubes (`Auto.offset_bound`, `Auto.holder_cubes`) sum the pieces. -/
theorem globalDecaying (j : Fin 3) :
    ∃ a₁ K₀ C₄ : ℝ, 0 < a₁ ∧ a₁ < 1 ∧ 1 ≤ K₀ ∧ 0 ≤ C₄ ∧
      ∀ μ N : ℝ, 0 < μ → μ ≤ 1 → K₀ * μ ^ (-K₀) ≤ N →
        ∀ (C : ℝ) (g : Fin 3 → E3 → ℂ), 0 ≤ C → (∀ k, SimpleOn (petBox C N) (g k)) →
          eLpNorm (hpAdj N ((N ^ expo j)⁻¹ * (μ ^ 2)⁻¹) j g) (ENNReal.ofReal 2) volume
            ≤ ENNReal.ofReal (C₄ * μ ^ a₁)
              * ∏ k, eLpNorm (g k) (ENNReal.ofReal (cdpExp k)) volume := by
  obtain ⟨a₁, K₀, C₃, ha0, ha1, hK0, hC3, hpb⟩ := piece_bound j
  set T0 := etaKerMom 2 with hT0def
  have hT0 : 0 ≤ T0 := etaKerMom_nonneg 2
  set D := 6 * (10 * C₃ ^ 2 + 5 * T0 ^ 2) with hDdef
  have hD : 0 ≤ D := by positivity
  refine ⟨a₁, K₀, 4 * Real.sqrt D, ha0, ha1, hK0, by positivity, ?_⟩
  intro μ N hμ0 hμ1 hNK C g hC hg
  have hμK : 1 ≤ μ ^ (-K₀) := Real.one_le_rpow_of_pos_of_le_one_of_nonpos hμ0 hμ1 (by linarith)
  have hN0 : 0 < N := by nlinarith
  set R := (N ^ expo j)⁻¹ * (μ ^ 2)⁻¹ with hRdef
  have hR : 0 < R := by positivity
  have hgm : ∀ k, Measurable (g k) := fun k => (hg k).1
  have hgr : ∀ k, (Set.range (g k)).Finite := fun k => (hg k).2.1
  choose b hb using fun k => (hg k).bounded
  have hgs : ∀ k x, x ∉ petBox C N → g k x = 0 := fun k x hx => (hg k).eq_zero hx
  have hgB : ∀ k, BddMeasC (g k) := fun k => ⟨hgm k, b k, hb k⟩
  have hgp : ∀ k, MemLp (g k) (ENNReal.ofReal (cdpExp k)) volume := fun k =>
    memLp_of_box (hgm k) (hb k) (hgs k) _
  set S := coverSet C with hSdef
  have hS : ∀ x, g 0 x ≠ 0 → boxIdx N x ∈ S := fun x hx =>
    boxIdx_mem_coverSet hN0 (by by_contra h; exact hx (hgs 0 x h))
  -- the real norms
  set Lg : Fin 3 → ℝ := fun k => (eLpNorm (g k) (ENNReal.ofReal (cdpExp k)) volume).toReal
    with hLgdef
  have hLg0 : ∀ k, 0 ≤ Lg k := fun k => ENNReal.toReal_nonneg
  have hRN : R * N ^ expo j = (μ ^ 2)⁻¹ := by
    rw [hRdef]; field_simp
  set Tt := etaKerMom 2 / (R * N ^ expo j) ^ 2 with hTtdef
  have hTt : Tt = T0 * μ ^ 4 := by
    rw [hTtdef, hRN, hT0def]; field_simp
  have hμ8 : μ ^ 8 ≤ (μ ^ a₁) ^ 2 := by
    rw [← Real.rpow_natCast, ← Real.rpow_natCast (μ ^ a₁), ← Real.rpow_mul hμ0.le]
    exact Real.rpow_le_rpow_of_exponent_ge hμ0 hμ1 (by push_cast; linarith)
  -- one offset
  have hoff : ∀ ε ε' : Fin 2,
      eLpNorm (fun y => ∑ ν ∈ S, hpAdj N R j (piece N j ν ε ε' g) y) 2 volume
        ≤ ENNReal.ofReal (Real.sqrt D * μ ^ a₁ * ∏ k, Lg k) := by
    intro ε ε'
    set L : (Fin 3 → ℤ) → Fin 3 → ℝ := fun ν k =>
      (eLpNorm (piece N j ν ε ε' g k) (ENNReal.ofReal (cdpExp k)) volume).toReal with hLdef
    have hpm : ∀ ν k, Measurable (piece N j ν ε ε' g k) := fun ν =>
      measurable_piece N j ν ε ε' hgm
    have hpbd : ∀ ν k x, ‖piece N j ν ε ε' g k x‖ ≤ b k := fun ν k x =>
      (norm_piece_le N j ν ε ε' g k x).trans (hb k x)
    have hps : ∀ ν k x, x ∉ petBox C N → piece N j ν ε ε' g k x = 0 := fun ν k x hx => by
      rw [piece_eq_boxRes]; unfold boxRes; split_ifs
      · exact hgs k x hx
      · rfl
    have hpfin : ∀ ν k, eLpNorm (piece N j ν ε ε' g k) (ENNReal.ofReal (cdpExp k)) volume ≠ ⊤ :=
      fun ν k => (memLp_of_box (hpm ν k) (hpbd ν k) (hps ν k) _).eLpNorm_ne_top
    have hprodL : ∀ ν, ∏ k, eLpNorm (piece N j ν ε ε' g k) (ENNReal.ofReal (cdpExp k)) volume
        = ENNReal.ofReal (∏ k, L ν k) := fun ν => by
      rw [ENNReal.ofReal_prod_of_nonneg fun k _ => ENNReal.toReal_nonneg]
      exact Finset.prod_congr rfl fun k _ => (ENNReal.ofReal_toReal (hpfin ν k)).symm
    have hGm : ∀ ν, Measurable (adjT N j (piece N j ν ε ε' g)) := fun ν =>
      measurable_adjT hN0.le j (hpm ν)
    have hGb : ∀ ν y, ‖adjT N j (piece N j ν ε ε' g) y‖ ≤ ∏ k, b k := fun ν =>
      norm_adjT_le hN0 j (hpbd ν)
    have hGs : ∀ ν y, y ∉ petBox (C + 1) N → adjT N j (piece N j ν ε ε' g) y = 0 := fun ν y hy =>
      adjT_eq_zero hN0 j (hps ν 0) hy
    have hG2 : ∀ ν, MemLp (adjT N j (piece N j ν ε ε' g)) 2 volume := fun ν =>
      memLp_of_box (hGm ν) (hGb ν) (hGs ν) 2
    have hH2 : ∀ ν, MemLp (hpAdj N R j (piece N j ν ε ε' g)) 2 volume := fun ν =>
      (hG2 ν).sub (memLp_two_P hR j (hGm ν) (hG2 ν))
    -- the compact bound per piece
    have hLnn : ∀ ν, 0 ≤ ∏ k, L ν k := fun ν => Finset.prod_nonneg fun k _ => ENNReal.toReal_nonneg
    have hcμ : 0 ≤ C₃ * μ ^ a₁ := mul_nonneg hC3 (Real.rpow_pos_of_pos hμ0 a₁).le
    have hHb : ∀ ν, ∫ y, ‖hpAdj N R j (piece N j ν ε ε' g) y‖ ^ 2
        ≤ (C₃ * μ ^ a₁) ^ 2 * (∏ k, L ν k) ^ 2 := fun ν => by
      have h := hpb μ N hμ0 hμ1 hNK g hgm hgr ν ε ε'
      rw [hprodL ν, ← ENNReal.ofReal_mul hcμ] at h
      have e2 : ENNReal.ofReal 2 = 2 := ENNReal.ofReal_ofNat 2
      rw [e2, eLpNorm_two_eq_sqrt (hH2 ν),
        ENNReal.ofReal_le_ofReal_iff (mul_nonneg hcμ (hLnn ν))] at h
      rw [← mul_pow]
      exact (Real.sqrt_le_left (mul_nonneg hcμ (hLnn ν))).mp h
    -- the crude bound per piece
    have hGb2 : ∀ ν, ∫ y, ‖adjT N j (piece N j ν ε ε' g) y‖ ^ 2 ≤ (∏ k, L ν k) ^ 2 := fun ν => by
      have h := eLpNorm_adjT_le hN0 j (hpm ν)
      rw [hprodL, eLpNorm_two_eq_sqrt (hG2 ν),
        ENNReal.ofReal_le_ofReal_iff (Finset.prod_nonneg fun k _ => ENNReal.toReal_nonneg)] at h
      exact (Real.sqrt_le_left (Finset.prod_nonneg fun k _ => ENNReal.toReal_nonneg)).mp h
    -- the weighted tail per piece
    have hw := fun ν => weighted_tail hN0 hR j ν (hGm ν) (hGb ν) (hGs ν)
      (fun y hy => (adjT_piece_support hN0 j ν ε ε' g hy).2)
    have hsum := offset_bound (N := N) j S (fun ν => hpAdj N R j (piece N j ν ε ε' g))
      (fun ν => adjT N j (piece N j ν ε ε' g)) (fun ν => ∏ k, L ν k) (c₀ := C₃ * μ ^ a₁)
      (T := Tt) hH2 (fun ν y hy => hpAdj_piece_passive hN0 j ν ε ε' g hy) hw hHb hGb2
    have hhold := holder_cubes N S j ε ε' hgm hgp
    have hbound : ∫ y, ‖∑ ν ∈ S, hpAdj N R j (piece N j ν ε ε' g) y‖ ^ 2
        ≤ (Real.sqrt D * μ ^ a₁ * ∏ k, Lg k) ^ 2 := by
      refine hsum.trans ?_
      have hTt2 : Tt ^ 2 ≤ T0 ^ 2 * (μ ^ a₁) ^ 2 := by
        rw [hTt, mul_pow, ← pow_mul]
        exact mul_le_mul_of_nonneg_left hμ8 (sq_nonneg _)
      have hcoef : 6 * (10 * (C₃ * μ ^ a₁) ^ 2 + 5 * Tt ^ 2) ≤ D * (μ ^ a₁) ^ 2 := by
        rw [hDdef]; nlinarith
      calc 6 * (10 * (C₃ * μ ^ a₁) ^ 2 + 5 * Tt ^ 2) * ∑ ν ∈ S, (∏ k, L ν k) ^ 2
          ≤ D * (μ ^ a₁) ^ 2 * (∏ k, Lg k) ^ 2 := by
            refine mul_le_mul hcoef hhold (Finset.sum_nonneg fun ν _ => sq_nonneg _)
              (by positivity)
        _ = (Real.sqrt D * μ ^ a₁ * ∏ k, Lg k) ^ 2 := by
            rw [mul_pow, mul_pow, Real.sq_sqrt hD]
    have hsum2 : MemLp (fun y => ∑ ν ∈ S, hpAdj N R j (piece N j ν ε ε' g) y) 2 volume := by
      have := memLp_finsetSum' S fun ν _ => hH2 ν
      convert this using 1
      funext y; simp [Finset.sum_apply]
    have hnn : 0 ≤ Real.sqrt D * μ ^ a₁ * ∏ k, Lg k :=
      mul_nonneg (mul_nonneg (Real.sqrt_nonneg _) (Real.rpow_pos_of_pos hμ0 a₁).le)
        (Finset.prod_nonneg fun k _ => hLg0 k)
    rw [eLpNorm_two_eq_sqrt hsum2]
    exact ENNReal.ofReal_le_ofReal ((Real.sqrt_le_left hnn).mpr hbound)
  -- the four offsets
  rw [hpAdj_decomp hN0 hR j hgB S hS]
  simp only [Fin.sum_univ_two]
  have hmeas : ∀ ε ε' : Fin 2, Measurable fun y => ∑ ν ∈ S, hpAdj N R j (piece N j ν ε ε' g) y :=
    fun ε ε' => Finset.measurable_sum _ fun ν _ =>
      measurable_hpAdj hN0.le j (measurable_piece N j ν ε ε' hgm)
  rw [ENNReal.ofReal_ofNat]
  refine (eLpNorm_add4_le ).trans ?_
  refine (add_le_add (add_le_add (hoff 0 0) (hoff 0 1)) (add_le_add (hoff 1 0) (hoff 1 1))).trans
    (le_of_eq ?_)
  have hprod : ∏ k, eLpNorm (g k) (ENNReal.ofReal (cdpExp k)) volume
      = ENNReal.ofReal (∏ k, Lg k) := by
    rw [ENNReal.ofReal_prod_of_nonneg fun k _ => hLg0 k]
    exact Finset.prod_congr rfl fun k _ => (ENNReal.ofReal_toReal (hgp k).eLpNorm_ne_top).symm
  have hpos : 0 ≤ Real.sqrt D * μ ^ a₁ * ∏ k, Lg k := by
    have := Real.rpow_pos_of_pos hμ0 a₁
    exact mul_nonneg (by positivity) (Finset.prod_nonneg fun k _ => hLg0 k)
  rw [hprod, ← ENNReal.ofReal_mul (by have := Real.rpow_pos_of_pos hμ0 a₁; positivity),
    ← ENNReal.ofReal_add hpos hpos,
    ← ENNReal.ofReal_add (add_nonneg hpos hpos) (add_nonneg hpos hpos)]
  congr 1
  ring

end

/-! ### `new:adjoint-all-exponents`: the convex completion and the interpolation -/

section
open Filter Topology MeasureTheory

/-- The exponents of the adjoint slots for slot exponents `e`: `e 0` at `j`, `e 1` at `j + 1`,
`e 2` at `j + 2`. -/
noncomputable def slotExp (j : Fin 3) (e : Fin 3 → ℝ) (i : Fin 3) : ℝ≥0∞ :=
  if i = j then ENNReal.ofReal (e 0) else if i = j + 1 then ENNReal.ofReal (e 1)
    else ENNReal.ofReal (e 2)

theorem sum_inv_slotExp (j : Fin 3) {e : Fin 3 → ℝ} (he : ∀ k, 0 < e k) :
    ∑ i, (slotExp j e i)⁻¹ = ENNReal.ofReal (∑ k, (e k)⁻¹) := by
  have h : ∑ i, (slotExp j e i)⁻¹ = (ENNReal.ofReal (e 0))⁻¹ + (ENNReal.ofReal (e 1))⁻¹
      + (ENNReal.ofReal (e 2))⁻¹ := by
    fin_cases j <;> simp [slotExp, Fin.sum_univ_three] <;> ring
  rw [h, Fin.sum_univ_three, ← ENNReal.ofReal_inv_of_pos (he 0),
    ← ENNReal.ofReal_inv_of_pos (he 1), ← ENNReal.ofReal_inv_of_pos (he 2),
    ← ENNReal.ofReal_add (inv_nonneg.mpr (he 0).le) (inv_nonneg.mpr (he 1).le),
    ← ENNReal.ofReal_add (add_nonneg (inv_nonneg.mpr (he 0).le) (inv_nonneg.mpr (he 1).le))
      (inv_nonneg.mpr (he 2).le)]

/-- **The crude endpoint for `hpAdj`** (`new:adjoint-basic`) with slot exponents `e`,
`∑ 1/e_k = 1/r`, `1 ≤ r < ∞`. -/
theorem eLpNorm_hpAdj_crude {N R : ℝ} (hN : 0 < N) (hR : 0 < R) (j : Fin 3)
    {g : Fin 3 → E3 → ℂ} (hg : ∀ k, Measurable (g k)) {e : Fin 3 → ℝ} (he : ∀ k, 0 < e k)
    {r : ℝ} (hr1 : 1 ≤ r) (hsum : ∑ k, (e k)⁻¹ = r⁻¹) :
    eLpNorm (hpAdj N R j g) (ENNReal.ofReal r) volume
      ≤ ENNReal.ofReal (1 + etaKerL1) * ∏ k, eLpNorm (g k) (ENNReal.ofReal (e k)) volume := by
  have hr0 : 0 < r := by linarith
  have hsE : ∑ i, (slotExp j e i)⁻¹ = (ENNReal.ofReal r)⁻¹ := by
    rw [sum_inv_slotExp j he, hsum, ENNReal.ofReal_inv_of_pos hr0]
  have h := eLpNorm_Astar_sub_P_le hN hR j (hg 0) (measurable_adjIn j hg)
    (r := ENNReal.ofReal r) (by simpa using hr1) ENNReal.ofReal_ne_top hsE
  rw [Astar_adjIn] at h
  refine le_of_le_of_eq h ?_
  have h12 : j + 1 ≠ j + 2 := by fin_cases j <;> decide
  have h1 : j + 1 ≠ j := by fin_cases j <;> decide
  have h2 : j + 2 ≠ j := by fin_cases j <;> decide
  rw [univ_erase_eq, Finset.prod_pair h12, Fin.prod_univ_three]
  have hA1 : adjIn j g (j + 1) = fun x => conj (g 1 x) := by simp [adjIn]
  have hA2 : adjIn j g (j + 2) = fun x => conj (g 2 x) := by simp [adjIn, h12.symm]
  rw [hA1, hA2, eLpNorm_conj_eq, eLpNorm_conj_eq,
    ENNReal.ofReal_add zero_le_one etaKerL1_nonneg, ENNReal.ofReal_one]
  simp only [slotExp, ite_true, ite_eq_right h1, ite_eq_right h2, ite_eq_right h12.symm]
  ring

