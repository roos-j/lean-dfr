/-- The volume of a cylinder `{x : x_m ∈ I, x_{≠m} ∈ T}` is `|I| |T|`. -/
theorem volume_cyl (m : Fin 3) {I : Set ℝ} (hI : MeasurableSet I) {T : Set (Fin 2 → ℝ)}
    (hT : MeasurableSet T) :
    volume {x : E3 | x m ∈ I ∧ projT m x ∈ T} = volume I * volume T := by
  have e : {x : E3 | x m ∈ I ∧ projT m x ∈ T} = (splitT m) ⁻¹' (I ×ˢ T) := by
    ext x; rfl
  rw [e, (measurePreserving_splitT m).measure_preimage (hI.prod hT).nullMeasurableSet,
    Measure.volume_eq_prod, Measure.prod_prod]

theorem maSize_self_eq {l k : ℕ} (j : ℕ → Fin 3) (N : ℝ) (ζ : ℕ → E3 → ℝ) (θ : ℕ → ℝ) (x : E3) :
    maSize l l k j N ζ θ x
      = N ^ expo (j l) * |ζ l x| + ∑ i ∈ Finset.Icc (l + 1) k, N ^ expo (j i) * |θ i| := by
  simp [maSize]

