    (hamp : ∀ k : Fin (r + 1) → ℝ, phaseAmp (r + 1) m f P p j g V N k ≤ 1) :
    (∫ h : Fin r → ℝ, ∫ u : ℝ, (∏ l : Fin r, fejer H (h l))
        * (fejer H u * phaseAmp (r + 1) m f P p j g V N (Fin.cons u h)))
      = ∫ u : ℝ, ∫ h : Fin r → ℝ, (∏ l : Fin r, fejer H (h l))
        * (fejer H u * phaseAmp (r + 1) m f P p j g V N (Fin.cons u h)) :=
