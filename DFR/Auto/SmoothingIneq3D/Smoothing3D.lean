/-- **Blueprint `lem:fejer-vdc` on a fixed interval.** -/
theorem fejer_vdc' {F : ℝ → ℂ} (hFm : Measurable F) (hF : ∀ t, ‖F t‖ ≤ 1)
    {N H : ℝ} (hN : 0 < N) (hH : 0 < H) (hHN : H ≤ N / 4) (c : ℝ) :
    ‖N⁻¹ • ∫ t in c..(c + N), F t‖ ^ 2
      ≤ 4 * (∫ h : ℝ, fejer H h *
          ‖N⁻¹ • ∫ t in c..(c + N), F (t + h) * (starRingEnd ℂ) (F t)‖) + 12 * H / N := by
  have hinv : (0 : ℝ) < N⁻¹ := inv_pos.mpr hN
  have hcst : Measurable fun _ : ℝ => (N⁻¹ : ℝ) := measurable_const
  have hP0 : Measurable fun h : ℝ => N⁻¹ • capPair F c N h :=
    hcst.smul (measurable_capPair hFm c N)
  have hQ0 : Measurable fun h : ℝ => N⁻¹ • ∫ t in c..(c + N), F (t + h) * (starRingEnd ℂ) (F t) :=
    hcst.smul (stronglyMeasurable_pairIntegral hFm hN.le c).measurable
  have hPb : ∀ h : ℝ, ‖N⁻¹ • capPair F c N h‖ ≤ 1 := by
    intro h
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hinv.le]
    calc N⁻¹ * ‖capPair F c N h‖ ≤ N⁻¹ * N :=
          mul_le_mul_of_nonneg_left (norm_capPair_le hF hN.le c h) hinv.le
      _ = 1 := inv_mul_cancel₀ hN.ne'
  have hQb : ∀ h : ℝ,
      ‖N⁻¹ • ∫ t in c..(c + N), F (t + h) * (starRingEnd ℂ) (F t)‖ ≤ 1 := by
    intro h
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hinv.le]
    calc N⁻¹ * ‖∫ t in c..(c + N), F (t + h) * (starRingEnd ℂ) (F t)‖ ≤ N⁻¹ * N :=
          mul_le_mul_of_nonneg_left (norm_pairIntegral_le hF hN.le c h) hinv.le
      _ = 1 := inv_mul_cancel₀ hN.ne'
  have hint1 : Integrable fun h : ℝ => fejer H h * ‖N⁻¹ • capPair F c N h‖ :=
    integrable_fejer_mul hH hP0.norm fun t => by
      rw [abs_of_nonneg (norm_nonneg _)]; exact hPb t
  have hint2 : Integrable fun h : ℝ =>
      fejer H h * ‖N⁻¹ • ∫ t in c..(c + N), F (t + h) * (starRingEnd ℂ) (F t)‖ :=
    integrable_fejer_mul hH hQ0.norm fun t => by
      rw [abs_of_nonneg (norm_nonneg _)]; exact hQb t
  have hint3 : Integrable fun h : ℝ => fejer H h * (H / N) :=
    integrable_fejer_mul hH measurable_const (M := H / N) fun _ =>
      le_of_eq (abs_of_nonneg (by positivity))
  have hmono : ∀ h : ℝ, fejer H h * ‖N⁻¹ • capPair F c N h‖
      ≤ fejer H h * ‖N⁻¹ • ∫ t in c..(c + N), F (t + h) * (starRingEnd ℂ) (F t)‖
        + fejer H h * (H / N) := by
    intro h
    rcases le_or_gt H |h| with hbig | hsmall
    · rw [fejer_eq_zero_of_le hH hbig, zero_mul, zero_mul, zero_mul, add_zero]
    · have hXY : ‖capPair F c N h‖
          ≤ ‖∫ t in c..(c + N), F (t + h) * (starRingEnd ℂ) (F t)‖ + |h| := by
        have h1 := norm_sub_norm_le (capPair F c N h)
          (∫ t in c..(c + N), F (t + h) * (starRingEnd ℂ) (F t))
        rw [norm_sub_rev] at h1
        linarith [norm_pairIntegral_sub_capPair_le' hFm hF hN.le c h]
      have hle2 : ‖N⁻¹ • capPair F c N h‖
          ≤ ‖N⁻¹ • ∫ t in c..(c + N), F (t + h) * (starRingEnd ℂ) (F t)‖ + H / N := by
        rw [norm_smul, norm_smul, Real.norm_eq_abs, abs_of_nonneg hinv.le]
        have hmul : N⁻¹ * ‖capPair F c N h‖
            ≤ N⁻¹ * (‖∫ t in c..(c + N), F (t + h) * (starRingEnd ℂ) (F t)‖ + |h|) :=
          mul_le_mul_of_nonneg_left hXY hinv.le
        have habs : N⁻¹ * |h| ≤ N⁻¹ * H := mul_le_mul_of_nonneg_left hsmall.le hinv.le
        have hdiv : H / N = N⁻¹ * H := div_eq_inv_mul H N
        nlinarith [hmul, habs, hdiv]
      calc fejer H h * ‖N⁻¹ • capPair F c N h‖
          ≤ fejer H h * (‖N⁻¹ • ∫ t in c..(c + N), F (t + h) * (starRingEnd ℂ) (F t)‖ + H / N) :=
