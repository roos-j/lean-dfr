/-! ### Patch 1 `lem:multiplicity`: at most two preimages

"We recover `t` block by block in the visiting order, using lower triangularity: when we come to
block `i`, all parameters of earlier blocks are already known, so the block-`i` component of `y`
determines the value of the diagonal map at the parameters of `B_i`."

For `w^(3)` and `w^(1)` the visiting order is irrelevant, the derivative being block diagonal; for
`w^(2)` it is `1, 3, 2`, and the unwinding really does proceed in that order: the block-`1`
parameter is read off first, then the block-`3` parameters after subtracting it, then the block-`2`
parameters after subtracting the block-`3` one.  In each case the degree-three block determines the
unordered outer pair, so the parameter set splits into the two pieces on which that pair is ordered,
and the flow is injective on each. -/

theorem flowMap3_coord (t t' : E6) (h : flowMap3 t = flowMap3 t') (k : Fin 6) :
    flowPi3 (WithLp.ofLp t) k = flowPi3 (WithLp.ofLp t') k := by
  have hc := congrArg (fun z : E6 => WithLp.ofLp z k) h
  simpa [flowMap3] using hc

theorem flowMap1_coord (t t' : E6) (h : flowMap1 t = flowMap1 t') (k : Fin 6) :
    flowPi1 (WithLp.ofLp t) k = flowPi1 (WithLp.ofLp t') k := by
  have hc := congrArg (fun z : E6 => WithLp.ofLp z k) h
  simpa [flowMap1] using hc

theorem flowMap2_coord (t t' : E6) (h : flowMap2 t = flowMap2 t') (k : Fin 6) :
    flowPi2 (WithLp.ofLp t) k = flowPi2 (WithLp.ofLp t') k := by
  have hc := congrArg (fun z : E6 => WithLp.ofLp z k) h
  simpa [flowMap2] using hc

/-- Injectivity of the flow of `w^(3)` where the outer pair of the degree-three block is ordered. -/
theorem flowMap3_injOn {S : Set E6}
    (hS : ∀ t ∈ S, t 1 ≠ t 2 ∧ (t 3 - t 4) * (t 4 - t 5) ≠ 0 ∧ t 3 < t 5) :
    Set.InjOn flowMap3 S := by
  intro t ht t' ht' heq
  obtain ⟨h12, hco3, hord⟩ := hS t ht
  obtain ⟨_, _, hord'⟩ := hS t' ht'
  have e0 := flowMap3_coord t t' heq 0
  have e1 := flowMap3_coord t t' heq 1
  have e2 := flowMap3_coord t t' heq 2
  have e3 := flowMap3_coord t t' heq 3
  have e4 := flowMap3_coord t t' heq 4
  have e5 := flowMap3_coord t t' heq 5
  simp only [flowPi3_zero, flowPi3_one, flowPi3_two] at e0 e1 e2
  simp only [flowPi3_three, flowPi3_four, flowPi3_five] at e3 e4 e5
  have h0 : t 0 = t' 0 := by linarith
  obtain ⟨h1, h2⟩ := flowBlock2_injective h12 e1 e2
  obtain ⟨hsum, hprod, hb⟩ :=
    flowBlock3_pair (a := t 3) (b := t 4) (c := t 5) (a' := t' 3) (b' := t' 4) (c' := t' 5)
      hco3 e3 e4 e5
  obtain ⟨h3, h5⟩ := pair_eq_of_sum_prod hord hord' hsum hprod
  ext k
  fin_cases k
  · exact h0
  · exact h1
  · exact h2
  · exact h3
  · exact hb
  · exact h5

theorem flowMap3_injOn' {S : Set E6}
    (hS : ∀ t ∈ S, t 1 ≠ t 2 ∧ (t 3 - t 4) * (t 4 - t 5) ≠ 0 ∧ t 5 < t 3) :
    Set.InjOn flowMap3 S := by
  intro t ht t' ht' heq
  obtain ⟨h12, hco3, hord⟩ := hS t ht
  obtain ⟨_, _, hord'⟩ := hS t' ht'
  have e0 := flowMap3_coord t t' heq 0
  have e1 := flowMap3_coord t t' heq 1
  have e2 := flowMap3_coord t t' heq 2
  have e3 := flowMap3_coord t t' heq 3
  have e4 := flowMap3_coord t t' heq 4
  have e5 := flowMap3_coord t t' heq 5
  simp only [flowPi3_zero, flowPi3_one, flowPi3_two] at e0 e1 e2
  simp only [flowPi3_three, flowPi3_four, flowPi3_five] at e3 e4 e5
  have h0 : t 0 = t' 0 := by linarith
  obtain ⟨h1, h2⟩ := flowBlock2_injective h12 e1 e2
  obtain ⟨hsum, hprod, hb⟩ :=
    flowBlock3_pair (a := t 3) (b := t 4) (c := t 5) (a' := t' 3) (b' := t' 4) (c' := t' 5)
      hco3 e3 e4 e5
  obtain ⟨h5, h3⟩ :=
