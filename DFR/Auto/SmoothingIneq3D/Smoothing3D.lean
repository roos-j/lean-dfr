  · refine HasFDerivAt.congr_fderiv
      (by simpa [Pi.neg_def, Pi.sub_def, Pi.add_def, Pi.pow_apply] using
        ((hp 1).pow 2).sub ((hp 2).pow 2)) ?_
    ext v
    simp [flowMatrix1, dotProduct, Fin.sum_univ_six]
    ring
  · refine HasFDerivAt.congr_fderiv
      (by simpa [Pi.neg_def, Pi.sub_def, Pi.add_def, Pi.pow_apply] using
        ((hp 0).neg.add (hp 3)).sub (hp 4)) ?_
    ext v
    simp [flowMatrix1, dotProduct, Fin.sum_univ_six]
    ring
  · refine HasFDerivAt.congr_fderiv
      (by simpa [Pi.neg_def, Pi.sub_def, Pi.add_def, Pi.pow_apply] using
        ((((hp 0).pow 2).neg).add ((hp 3).pow 2)).sub ((hp 4).pow 2)) ?_
    ext v
    simp [flowMatrix1, dotProduct, Fin.sum_univ_six]
    ring
  · refine HasFDerivAt.congr_fderiv
      (by simpa [Pi.neg_def, Pi.sub_def, Pi.add_def, Pi.pow_apply] using
        ((((hp 0).pow 3).neg).add ((hp 3).pow 3)).sub ((hp 4).pow 3)) ?_
    ext v
    simp [flowMatrix1, dotProduct, Fin.sum_univ_six]
    ring

/-- **Patch 1 `lem:jacobian`, the derivative of the flow of `w^(1)` on the lift.** -/
theorem hasFDerivAt_flowMap1 (t : E6) : HasFDerivAt flowMap1 (flowDeriv1 t) t := by
  set e : E6 ≃L[ℝ] (Fin 6 → ℝ) := PiLp.continuousLinearEquiv 2 ℝ (fun _ : Fin 6 => ℝ) with hedef
  have he : HasFDerivAt (⇑e) (e : E6 →L[ℝ] (Fin 6 → ℝ)) t :=
    (e : E6 →L[ℝ] (Fin 6 → ℝ)).hasFDerivAt
  have hsym : HasFDerivAt (⇑e.symm) (e.symm : (Fin 6 → ℝ) →L[ℝ] E6) (flowPi1 (e t)) :=
    (e.symm : (Fin 6 → ℝ) →L[ℝ] E6).hasFDerivAt
  have hcomp := hsym.comp t ((hasFDerivAt_flowPi1 (e t)).comp t he)
  refine hcomp.congr_fderiv ?_
  ext v k
