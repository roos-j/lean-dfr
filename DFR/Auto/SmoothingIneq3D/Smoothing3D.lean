/-- **Patch 1 `lem:jacobian`, the derivative of the flow of `w^(2)` on the lift.** -/
theorem hasFDerivAt_flowMap2 (t : E6) : HasFDerivAt flowMap2 (flowDeriv2 t) t := by
  set e : E6 ≃L[ℝ] (Fin 6 → ℝ) := PiLp.continuousLinearEquiv 2 ℝ (fun _ : Fin 6 => ℝ) with hedef
