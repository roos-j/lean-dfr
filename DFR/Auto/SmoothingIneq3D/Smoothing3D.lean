/-- The interpolation step of blueprint `prop:normalized-endpoint`, packaged with the exponent
relations of `lem:endpoint-geometry`.  Unconditional: it is `Auto.interpolate_Tproj_nice`, which
is blueprint `lem:lebesgue-strip` and `thm:gm-internal` for this operator, specialized to the
exponents produced by `lem:endpoint-geometry`. -/
theorem endpoint_interpolate {N R : ℝ} (hN : 0 ≤ N) (hR : 0 < R) (j : Fin 3)
    {bv cv qv : Fin 3 → ℝ} {τ θ M0 M1 : ℝ}
    (hbv : ∀ i, 0 < bv i) (hcv : ∀ i, 0 < cv i) (hqv : ∀ i, 0 < qv i)
    (hSb : 0 < ∑ i, bv i) (hSc : 0 < ∑ i, cv i)
    (hτθ : τ = 1 - θ) (hθ : θ ∈ Set.Ioo (0 : ℝ) 1)
    (hM0 : 0 < M0) (hM1 : 0 < M1)
    (hid : ∀ i, (qv i)⁻¹ = τ * bv i + θ * cv i)
    (hone : τ * (∑ i, bv i) + θ * (∑ i, cv i) = 1)
    (h0 : ∀ h : Fin 3 → E3 → ℂ, (∀ i, Nice (h i)) →
      eLpNorm (Tproj N R j h) (ENNReal.ofReal (∑ i, bv i)⁻¹) volume
        ≤ ENNReal.ofReal M0 * ∏ i, eLpNorm (h i) (ENNReal.ofReal (bv i)⁻¹) volume)
    (h1 : ∀ h : Fin 3 → E3 → ℂ, (∀ i, Nice (h i)) →
      eLpNorm (Tproj N R j h) (ENNReal.ofReal (∑ i, cv i)⁻¹) volume
        ≤ ENNReal.ofReal M1 * ∏ i, eLpNorm (h i) (ENNReal.ofReal (cv i)⁻¹) volume) :
    ∀ h : Fin 3 → E3 → ℂ, (∀ i, Nice (h i)) →
      eLpNorm (Tproj N R j h) 1 volume
        ≤ ENNReal.ofReal (M0 ^ τ * M1 ^ θ)
          * ∏ i, eLpNorm (h i) (ENNReal.ofReal (qv i)) volume := by
  intro h hh
  have hres := interpolate_Tproj_nice hN hR j
    (p₀ := fun i => (bv i)⁻¹) (p₁ := fun i => (cv i)⁻¹) (p := qv)
    (q₀ := (∑ i, bv i)⁻¹) (q₁ := (∑ i, cv i)⁻¹) (q := 1) (M₀ := M0) (M₁ := M1) (θ := θ)
    (fun i => inv_pos.mpr (hbv i)) (fun i => inv_pos.mpr (hcv i)) hqv
    (inv_pos.mpr hSb) (inv_pos.mpr hSc) one_pos hM0.le hM1.le hθ
    (fun i => by rw [inv_inv, inv_inv, hid i, hτθ])
    (by rw [inv_one, inv_inv, inv_inv, ← hτθ]; exact hone.symm)
    (fun g hg => h0 g (fun i => (hg i).nice)) (fun g hg => h1 g (fun i => (hg i).nice)) h hh
  rw [ENNReal.ofReal_one] at hres
  rw [hτθ]
  exact hres
