/-- Blueprint `def:normalized-constants` and `cor:normalized-smoothing`: the two propositions
unified over `p ∈ [1, ∞)`.  The constants of `def:normalized-constants` are the ones produced by
whichever of the two propositions applies, so the corollary is stated as an existence
statement. -/
theorem normalized_smoothing (j : Fin 3) (HA : KoszAdjoint j) (HS : KoszSubunitScaleOne j)
    {p : ℝ} {pv : Fin 3 → ℝ} (hp : 1 ≤ p) (hpv : ∀ i, 1 < pv i)
    (hsum : ∑ i, (pv i)⁻¹ = p⁻¹) :
    ∃ γ C : ℝ, γ ∈ Set.Ioo (0 : ℝ) 1 ∧ 0 < C ∧
      ∀ N μ : ℝ, 0 < N → μ ∈ Set.Ioc (0 : ℝ) 1 →
        ∀ f : Fin 3 → E3 → ℂ, (∀ i, Nice (f i)) →
        Function.support (𝓕 (f j)) ⊆ {ξ : E3 | 2 * ((N ^ expo j)⁻¹ * (μ ^ 2)⁻¹) ≤ |ξ j|} →
        eLpNorm (A N f) (ENNReal.ofReal p) volume
          ≤ ENNReal.ofReal (C * (μ ^ γ + N ^ (-γ)))
            * ∏ i, eLpNorm (f i) (ENNReal.ofReal (pv i)) volume := by
  rcases eq_or_lt_of_le hp with hp1 | hp1
  · -- the endpoint `p = 1`
    obtain ⟨γ, C, hγ, hC, hest⟩ :=
      normalized_endpoint j HA HS hpv (by rw [hsum, ← hp1, inv_one])
    refine ⟨γ, C, hγ, hC, fun N μ hN hμ f hf hsupp => ?_⟩
    have h := hest N μ hN hμ f hf hsupp
    rwa [← hp1, ENNReal.ofReal_one]
  · -- the Banach case `p > 1`
    obtain ⟨γ, C, hγ, hC, hest⟩ := normalized_banach j HA hp1 hpv hsum
    refine ⟨γ, C, hγ, hC, fun N μ hN hμ f hf hsupp => ?_⟩
    refine hest N μ hN hμ f hf ?_
    intro ξ hξ
    have hx := hsupp hξ
    simp only [Set.mem_setOf_eq] at hx ⊢
    have hR0 : (0 : ℝ) < (N ^ expo j)⁻¹ * (μ ^ 2)⁻¹ := by
      have := hμ.1
      positivity
    linarith

