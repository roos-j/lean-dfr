    (locUnifPowMixed N (Fin.cons L Lv) j f).re
      ≤ (∏ l : Fin s, 2 * L / Lv l) * (locUnifPow N L j (s + 1) f).re := by
  rw [re_locUnifPowMixed_eq hL hLv j hf hf1, re_locUnifPow_succ_eq hL j hf hf1]
  have hP : ∀ h : Fin s → ℝ, 0 ≤ (innerFejer L (basisVec j) s f h).re :=
    fun h => re_innerFejer_nonneg hL (basisVec j) s h hf
