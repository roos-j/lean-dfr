/-- Blueprint `prop:normalized-endpoint`: normalized smoothing at scale `N` for `p = 1`.
Conditional on the three imported modules, as the user's decision authorizes. -/
theorem normalized_endpoint (j : Fin 3) (HA : KoszAdjoint j) (HS : KoszSubunitScaleOne j)
    {pv : Fin 3 → ℝ} (hpv : ∀ i, 1 < pv i) (hsum : ∑ i, (pv i)⁻¹ = 1) :
    ∃ γ C : ℝ, γ ∈ Set.Ioo (0 : ℝ) 1 ∧ 0 < C ∧
      ∀ N μ : ℝ, 0 < N → μ ∈ Set.Ioc (0 : ℝ) 1 →
        ∀ f : Fin 3 → E3 → ℂ, (∀ i, Nice (f i)) →
        Function.support (𝓕 (f j)) ⊆ {ξ : E3 | 2 * ((N ^ expo j)⁻¹ * (μ ^ 2)⁻¹) ≤ |ξ j|} →
        eLpNorm (A N f) 1 volume
          ≤ ENNReal.ofReal (C * (μ ^ γ + N ^ (-γ)))
            * ∏ i, eLpNorm (f i) (ENNReal.ofReal (pv i)) volume := by
  classical
  obtain ⟨b, Csub, hb, hbj, hB1, hB2, hCsub, hsubest⟩ := kosz_subunit j HS
  have hpv0 : ∀ i, (0 : ℝ) < pv i := fun i => lt_trans one_pos (hpv i)
  have ha : ∀ i, (pv i)⁻¹ ∈ Set.Ioo (0 : ℝ) 1 := by
    intro i
    refine ⟨inv_pos.mpr (hpv0 i), ?_⟩
    have hm : pv i * (pv i)⁻¹ = 1 := mul_inv_cancel₀ (hpv0 i).ne'
    nlinarith [inv_pos.mpr (hpv0 i), hpv i]
  obtain ⟨hcmem, hcsum, hid⟩ := endpoint_geometry ha hsum hb hB1
  set τ : ℝ := endpointTau (fun i => (pv i)⁻¹) b with hτdef
  set θ : ℝ := endpointTheta (fun i => (pv i)⁻¹) b with hθdef
  set cc : Fin 3 → ℝ := endpointC (fun i => (pv i)⁻¹) b with hccdef
  have hτ0 : 0 < τ := endpointTau_pos ha hb
  obtain ⟨hθhalf, hθ1⟩ := endpointTheta_mem ha hb
  have hθ0 : (0 : ℝ) < θ := by linarith
  have hτθ : τ = 1 - θ := by rw [hθdef, endpointTheta]; ring
  have hSb0 : 0 < ∑ i, b i := by linarith
  have hSc0 : 0 < ∑ i, cc i := by
    rw [Fin.sum_univ_three]
    linarith [(hcmem 0).1, (hcmem 1).1, (hcmem 2).1]
  have hs1 : 1 < (∑ i, cc i)⁻¹ := by
    have hm : (∑ i, cc i) * (∑ i, cc i)⁻¹ = 1 := mul_inv_cancel₀ hSc0.ne'
    nlinarith [inv_pos.mpr hSc0, hcsum]
  have hsv1 : ∀ i, 1 < (cc i)⁻¹ := by
    intro i
    have h := hcmem i
    have hm : cc i * (cc i)⁻¹ = 1 := mul_inv_cancel₀ h.1.ne'
    nlinarith [inv_pos.mpr h.1, h.2]
  have hsvsum : ∑ i, ((cc i)⁻¹)⁻¹ = ((∑ i, cc i)⁻¹)⁻¹ := by
    rw [inv_inv]
    exact Finset.sum_congr rfl fun i _ => by rw [inv_inv]
  obtain ⟨γB, CB, hγB, hCB0, hNB⟩ := normalized_banach j HA hs1 hsv1 hsvsum
  have hCeta0 : (0 : ℝ) < Ceta := lt_of_lt_of_le zero_lt_one one_le_Ceta
  refine ⟨θ * γB, (Ceta * Csub) ^ τ * (Ceta * CB) ^ θ,
    ⟨mul_pos hθ0 hγB.1, ?_⟩, by positivity, ?_⟩
  · nlinarith [hγB.1, hγB.2, hθ1, hθ0]
  intro N μ hN hμ f hf hsupp
  obtain ⟨hμ0, hμ1⟩ := hμ
  set R : ℝ := (N ^ expo j)⁻¹ * (μ ^ 2)⁻¹ with hRdef
  have hR0 : 0 < R := by rw [hRdef]; positivity
  have hμγ : (0 : ℝ) < μ ^ γB := Real.rpow_pos_of_pos hμ0 _
  have hNγ : (0 : ℝ) < N ^ (-γB) := Real.rpow_pos_of_pos hN _
  set M1 : ℝ := Ceta * (CB * (μ ^ γB + N ^ (-γB))) with hM1def
  have hM10 : 0 < M1 := by rw [hM1def]; positivity
  have hend1 : ∀ h : Fin 3 → E3 → ℂ, (∀ i, Nice (h i)) →
      eLpNorm (Tproj N R j h) (ENNReal.ofReal (∑ i, cc i)⁻¹) volume
        ≤ ENNReal.ofReal M1 * ∏ i, eLpNorm (h i) (ENNReal.ofReal (cc i)⁻¹) volume := by
    intro h hh
    have hle := hNB N μ hN ⟨hμ0, hμ1⟩ (Function.update h j (Q R j (h j)))
      (nice_update_Q hR0 j hh) (by simpa [hRdef] using support_fourier_update_Q hR0 j hh)
    refine le_trans hle ?_
    have hP := prod_eLpNorm_update_Q_le hR0 j hh
      (fun i => ENNReal.one_le_ofReal.mpr (hsv1 i).le)
      (fun i => ENNReal.ofReal_ne_top (r := (cc i)⁻¹))
    calc ENNReal.ofReal (CB * (μ ^ γB + N ^ (-γB)))
          * ∏ i, eLpNorm (Function.update h j (Q R j (h j)) i) (ENNReal.ofReal (cc i)⁻¹) volume
        ≤ ENNReal.ofReal (CB * (μ ^ γB + N ^ (-γB)))
          * (ENNReal.ofReal Ceta
            * ∏ i, eLpNorm (h i) (ENNReal.ofReal (cc i)⁻¹) volume) := mul_le_mul' le_rfl hP
      _ = ENNReal.ofReal M1 * ∏ i, eLpNorm (h i) (ENNReal.ofReal (cc i)⁻¹) volume := by
          rw [hM1def, ENNReal.ofReal_mul hCeta0.le]
          ring
  have hend0 : ∀ h : Fin 3 → E3 → ℂ, (∀ i, Nice (h i)) →
      eLpNorm (Tproj N R j h) (ENNReal.ofReal (∑ i, b i)⁻¹) volume
        ≤ ENNReal.ofReal (Ceta * Csub)
          * ∏ i, eLpNorm (h i) (ENNReal.ofReal (b i)⁻¹) volume := by
    intro h hh
    have hle := hsubest N hN (Function.update h j (Q R j (h j)))
      (fun i => (nice_update_Q hR0 j hh i).continuous)
    refine le_trans hle ?_
    have hb1 : ∀ i, (1 : ℝ≥0∞) ≤ ENNReal.ofReal (b i)⁻¹ := by
      intro i
      refine ENNReal.one_le_ofReal.mpr ?_
      have hbi := hb i
      have hm : b i * (b i)⁻¹ = 1 := mul_inv_cancel₀ hbi.1.ne'
      nlinarith [inv_pos.mpr hbi.1, hbi.2]
    have hP := prod_eLpNorm_update_Q_le hR0 j hh hb1
      (fun i => ENNReal.ofReal_ne_top (r := (b i)⁻¹))
    calc ENNReal.ofReal Csub
          * ∏ i, eLpNorm (Function.update h j (Q R j (h j)) i) (ENNReal.ofReal (b i)⁻¹) volume
        ≤ ENNReal.ofReal Csub
          * (ENNReal.ofReal Ceta
            * ∏ i, eLpNorm (h i) (ENNReal.ofReal (b i)⁻¹) volume) := mul_le_mul' le_rfl hP
      _ = ENNReal.ofReal (Ceta * Csub)
            * ∏ i, eLpNorm (h i) (ENNReal.ofReal (b i)⁻¹) volume := by
          rw [ENNReal.ofReal_mul hCeta0.le]
          ring
  have hone : τ * (∑ i, b i) + θ * (∑ i, cc i) = 1 := by
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib, ← hsum]
    exact Finset.sum_congr rfl fun i _ => (hid i).symm
  have hinterp := endpoint_interpolate hN.le hR0 j (bv := b) (cv := cc) (qv := pv)
    (τ := τ) (θ := θ) (M0 := Ceta * Csub) (M1 := M1)
    (fun i => (hb i).1) (fun i => (hcmem i).1) hpv0
    hSb0 hSc0 hτθ ⟨hθ0, hθ1⟩
    (by positivity) hM10 hid hone
    hend0 hend1 f hf
  have hQid : Function.update f j (Q R j (f j)) = f := by
    funext i
    rcases eq_or_ne i j with rfl | hne
    · rw [Function.update_self]
      refine Q_eq_self_of_fourier_support hR0 i (hf i).continuous (hf i).integrable
        ((hf i).bounded.choose_spec) ?_
      intro ξ hξ
      have hx := hsupp hξ
      simpa [hRdef] using hx
    · rw [Function.update_of_ne hne]
  rw [Tproj, hQid] at hinterp
  refine le_trans hinterp ?_
  refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
  have hsplit : M1 ^ θ ≤ (Ceta * CB) ^ θ * (μ ^ (θ * γB) + N ^ (-(θ * γB))) := by
    rw [hM1def, ← mul_assoc, Real.mul_rpow (by positivity) (by positivity)]
    refine mul_le_mul_of_nonneg_left ?_ (by positivity)
    calc (μ ^ γB + N ^ (-γB)) ^ θ ≤ (μ ^ γB) ^ θ + (N ^ (-γB)) ^ θ :=
          add_rpow_le_of_le_one hθ0 hθ1.le hμγ.le hNγ.le
      _ = μ ^ (θ * γB) + N ^ (-(θ * γB)) := by
          rw [← Real.rpow_mul hμ0.le, ← Real.rpow_mul hN.le]
          congr 2 <;> ring
  calc (Ceta * Csub) ^ τ * M1 ^ θ
      ≤ (Ceta * Csub) ^ τ * ((Ceta * CB) ^ θ * (μ ^ (θ * γB) + N ^ (-(θ * γB)))) :=
        mul_le_mul_of_nonneg_left hsplit (by positivity)
    _ = (Ceta * Csub) ^ τ * (Ceta * CB) ^ θ * (μ ^ (θ * γB) + N ^ (-(θ * γB))) := by ring

