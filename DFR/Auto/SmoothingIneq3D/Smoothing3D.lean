    one_ne_zero ENNReal.one_ne_top improvingConst_ne_zero improvingConst_ne_top
    ENNReal.one_ne_top h₀ h₁ h₂



theorem trivialVertexInf_apply (i : Fin 3) : trivialVertexInf i = 0 := by
  fin_cases i <;> simp [trivialVertexInf]

theorem sum_of_perm {j m k : Fin 3} (hjm : j ≠ m) (hkm : k ≠ m) (hjk : j ≠ k) (a b c : ℝ) :
    (if (0 : Fin 3) = j then a else if (0 : Fin 3) = m then b else c)
      + (if (1 : Fin 3) = j then a else if (1 : Fin 3) = m then b else c)
      + (if (2 : Fin 3) = j then a else if (2 : Fin 3) = m then b else c) = a + b + c := by
  fin_cases j <;> fin_cases m <;> fin_cases k <;> simp_all <;> ring

