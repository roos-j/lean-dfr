      = z + liftCurve3 (t 0) - liftCurve1 (t 0) - liftCurve3 (t 1) + liftCurve3 (t 2)
          + liftCurve2 (t 3) - liftCurve3 (t 3) - liftCurve2 (t 4) + liftCurve2 (t 5) := by
