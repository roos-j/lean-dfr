  obtain ⟨hθhalf, hθ1⟩ := endpointTheta_mem ha hb
  have hθ0 : (0 : ℝ) < θ := by linarith
  have hτθ : τ = 1 - θ := by rw [hθdef, endpointTheta]; ring
  have hSb0 : 0 < ∑ i, b i := by linarith
  have hSc0 : 0 < ∑ i, cc i := by
    rw [Fin.sum_univ_three]
    linarith [(hcmem 0).1, (hcmem 1).1, (hcmem 2).1]
  have hs1 : 1 < (∑ i, cc i)⁻¹ := by
    have hm : (∑ i, cc i) * (∑ i, cc i)⁻¹ = 1 := mul_inv_cancel₀ hSc0.ne'
    nlinarith [inv_pos.mpr hSc0, hcsum]
  have hsv1 : ∀ i, 1 < (cc i)⁻¹ := by
    intro i
    have h := hcmem i
    have hm : cc i * (cc i)⁻¹ = 1 := mul_inv_cancel₀ h.1.ne'
    nlinarith [inv_pos.mpr h.1, h.2]
  have hsvsum : ∑ i, ((cc i)⁻¹)⁻¹ = ((∑ i, cc i)⁻¹)⁻¹ := by
    rw [inv_inv]
