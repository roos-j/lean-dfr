          * ∏ i, eLpNorm (h i) (ENNReal.ofReal (b i)⁻¹) volume := by
    intro h hh
    have hle := hsubest N hN (Function.update h j (Q R j (h j)))
      (fun i => (nice_update_Q hR0 j hh i).continuous)
    refine le_trans hle ?_
    have hb1 : ∀ i, (1 : ℝ≥0∞) ≤ ENNReal.ofReal (b i)⁻¹ := by
      intro i
      refine ENNReal.one_le_ofReal.mpr ?_
      have hbi := hb i
      have hm : b i * (b i)⁻¹ = 1 := mul_inv_cancel₀ hbi.1.ne'
      nlinarith [inv_pos.mpr hbi.1, hbi.2]
    have hP := prod_eLpNorm_update_Q_le hR0 j hh hb1
