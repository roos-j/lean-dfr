          * ∏ i, eLpNorm (h i) (ENNReal.ofReal (qv i)) volume := by
  intro h hh
  have hres := interpolate_Tproj_nice hN hR j
    (p₀ := fun i => (bv i)⁻¹) (p₁ := fun i => (cv i)⁻¹) (p := qv)
    (q₀ := (∑ i, bv i)⁻¹) (q₁ := (∑ i, cv i)⁻¹) (q := 1) (M₀ := M0) (M₁ := M1) (θ := θ)
    (fun i => inv_pos.mpr (hbv i)) (fun i => inv_pos.mpr (hcv i)) hqv
    (inv_pos.mpr hSb) (inv_pos.mpr hSc) one_pos hM0.le hM1.le hθ
    (fun i => by rw [inv_inv, inv_inv, hid i, hτθ])
    (by rw [inv_one, inv_inv, inv_inv, ← hτθ]; exact hone.symm)
    (fun g hg => h0 g (fun i => (hg i).nice)) (fun g hg => h1 g (fun i => (hg i).nice)) h hh
  rw [ENNReal.ofReal_one] at hres
  rw [hτθ]
  exact hres
