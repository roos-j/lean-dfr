/-! ## The anisotropic dilation and the scaling identities -/

/-- The anisotropic dilation `D_ρ(x₁, x₂, x₃) = (ρx₁, ρ²x₂, ρ³x₃)`; blueprint `def:dilation`. -/
noncomputable def D (ρ : ℝ) (x : E3) : E3 := WithLp.toLp 2 fun i => ρ ^ expo i * x i

@[simp] theorem D_apply (ρ : ℝ) (x : E3) (i : Fin 3) : D ρ x i = ρ ^ expo i * x i := rfl

@[simp] theorem D_one (x : E3) : D 1 x = x := by
  ext i; simp

theorem D_comp (ρ σ : ℝ) (x : E3) : D ρ (D σ x) = D (ρ * σ) x := by
  ext i; simp [mul_pow]; ring

theorem D_inv_D {ρ : ℝ} (hρ : ρ ≠ 0) (x : E3) : D ρ⁻¹ (D ρ x) = x := by
  rw [D_comp, inv_mul_cancel₀ hρ, D_one]

theorem D_add (ρ : ℝ) (x y : E3) : D ρ (x + y) = D ρ x + D ρ y := by
  ext i; simp [mul_add]

/-- The dilation carries the monomial curve to itself with the parameter rescaled;
this is the computation `D_ρ(tⁿ eₙ) = (ρt)ⁿ eₙ` used throughout blueprint `lem:scaling`. -/
theorem D_curve (ρ : ℝ) (i : Fin 3) (t : ℝ) : D ρ (curve i t) = curve i (ρ * t) := by
  ext j
  rw [D_apply, curve_apply, curve_apply, mul_pow]
  rcases eq_or_ne j i with rfl | h
  · simp
  · simp [h]

/-- The dilated function `S_ρ f = f ∘ D_ρ⁻¹`; blueprint `def:dilation`. -/
noncomputable def S (ρ : ℝ) (f : E3 → ℂ) : E3 → ℂ := fun x => f (D ρ⁻¹ x)

/-- The dilation acts on the average integrand by rescaling the parameter; this is the
pointwise content of the second and third identities of blueprint `lem:scaling`. -/
theorem prodShift_S_D {ρ : ℝ} (hρ : ρ ≠ 0) (f : Fin 3 → E3 → ℂ) (x : E3) (u : ℝ) :
    prodShift (fun i => S ρ (f i)) (D ρ x) u = prodShift f x (u / ρ) := by
  unfold prodShift S
  refine Finset.prod_congr rfl fun i _ => ?_
  change f i (D ρ⁻¹ (D ρ x + curve i u)) = f i (x + curve i (u / ρ))
  rw [D_add, D_inv_D hρ, D_curve, inv_mul_eq_div]

/-- Second identity of blueprint `lem:scaling`:
`A_{ρr}(S_ρ f)(D_ρ x) = r⁻¹ B_r(f)(x)`. -/
theorem A_S_D {ρ : ℝ} (hρ : ρ ≠ 0) (r : ℝ) (f : Fin 3 → E3 → ℂ) (x : E3) :
    A (ρ * r) (fun i => S ρ (f i)) (D ρ x) = (r : ℂ)⁻¹ * B r f x := by
  rcases eq_or_ne r 0 with rfl | hr
  · simp [A, B]
  rw [A, B]
  simp only [prodShift_S_D hρ f x]
  rw [intervalIntegral.integral_comp_div _ hρ]
  have hb : ρ * r / ρ = r := by field_simp
  rw [zero_div, hb, Complex.real_smul]
  push_cast
  have hrC : (r : ℂ) ≠ 0 := by exact_mod_cast hr
  have hρC : (ρ : ℂ) ≠ 0 := by exact_mod_cast hρ
  field_simp

/-- Third identity of blueprint `lem:scaling`:
`Ã_{ρr}(S_ρ f)(D_ρ x) = Ã_r(f)(x)`. -/
theorem Atilde_S_D {ρ : ℝ} (hρ : ρ ≠ 0) (r : ℝ) (f : Fin 3 → E3 → ℂ) (x : E3) :
    Atilde (ρ * r) (fun i => S ρ (f i)) (D ρ x) = Atilde r f x := by
  rw [Atilde, Atilde]
  simp only [prodShift_S_D hρ f x]
  rw [intervalIntegral.integral_comp_div _ hρ]
  have h1 : ρ * r / 2 / ρ = r / 2 := by field_simp
  have h2 : ρ * r / ρ = r := by field_simp
  rw [h1, h2, Complex.real_smul]
  push_cast
  rcases eq_or_ne r 0 with rfl | hr
  · simp
  have hrC : (r : ℂ) ≠ 0 := by exact_mod_cast hr
  have hρC : (ρ : ℂ) ≠ 0 := by exact_mod_cast hρ
  field_simp

/-- The anisotropic dilation as a linear map, so that its determinant is available;
blueprint `def:dilation`. -/
noncomputable def Dlin (ρ : ℝ) : E3 →ₗ[ℝ] E3 where
  toFun := D ρ
  map_add' := D_add ρ
  map_smul' c x := by ext i; simp [mul_left_comm]

@[simp] theorem Dlin_apply (ρ : ℝ) (x : E3) : Dlin ρ x = D ρ x := rfl

/-- `det D_ρ = ρ⁶`; blueprint `def:dilation`. -/
theorem det_Dlin (ρ : ℝ) : LinearMap.det (Dlin ρ) = ρ ^ 6 := by
  classical
  set b := (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis with hb
  have hmat : LinearMap.toMatrix b b (Dlin ρ) = Matrix.diagonal fun i => ρ ^ expo i := by
    ext i j
    rw [LinearMap.toMatrix_apply, Matrix.diagonal_apply]
    have hbj : b j = EuclideanSpace.single j (1 : ℝ) := by
      simp [hb, EuclideanSpace.basisFun_apply]
    rw [hbj]
    have : Dlin ρ (EuclideanSpace.single j (1 : ℝ)) = EuclideanSpace.single j (ρ ^ expo j) := by
      ext k
      rcases eq_or_ne k j with rfl | h
      · simp [Dlin, D, PiLp.single_apply]
      · simp [Dlin, D, PiLp.single_apply, h]
    rw [this]
    rcases eq_or_ne i j with rfl | h
    · simp [hb, OrthonormalBasis.coe_toBasis_repr_apply, EuclideanSpace.basisFun_repr]
    · simp [hb, OrthonormalBasis.coe_toBasis_repr_apply, EuclideanSpace.basisFun_repr, h]
  rw [← LinearMap.det_toMatrix b, hmat, Matrix.det_diagonal]
  simp [expo, Fin.prod_univ_three]
  ring

