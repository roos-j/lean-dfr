/-! ## Section 2: conventions and elementary lemmas -/

/-- The dyadic envelope of `s`, blueprint `def:dyadic-envelope`:
`Dyad s = 2 ^ ⌈log₂ (max 1 s)⌉`. It is an integer power of `2` that dominates `max 1 s`
by a factor strictly less than `2`. -/
noncomputable def Dyad (s : ℝ) : ℝ := (2 : ℝ) ^ (⌈Real.logb 2 (max 1 s)⌉ : ℤ)

/-- `Dyad s` is an integer power of `2`; blueprint `def:dyadic-envelope`. -/
theorem dyad_eq_zpow (s : ℝ) : ∃ m : ℤ, Dyad s = (2 : ℝ) ^ m := ⟨_, rfl⟩

/-- The exponent occurring in `Dyad s` is nonnegative, so `Dyad s` is a nonnegative integer
power of `2`; blueprint `def:dyadic-envelope`. -/
theorem dyad_exponent_nonneg (s : ℝ) : 0 ≤ ⌈Real.logb 2 (max 1 s)⌉ := by
  have h1 : (1 : ℝ) ≤ max 1 s := le_max_left _ _
  have : 0 ≤ Real.logb 2 (max 1 s) := Real.logb_nonneg (by norm_num) h1
  exact Int.ceil_nonneg this

/-- The two defining bounds of the dyadic envelope, blueprint `def:dyadic-envelope`:
`max 1 s ≤ Dyad s < 2 * max 1 s`. -/
theorem dyad_bounds (s : ℝ) : max 1 s ≤ Dyad s ∧ Dyad s < 2 * max 1 s := by
  set u : ℝ := max 1 s with hu
  have hu1 : (1 : ℝ) ≤ u := le_max_left _ _
  have hu0 : (0 : ℝ) < u := lt_of_lt_of_le one_pos hu1
  have hlog : (2 : ℝ) ^ Real.logb 2 u = u := Real.rpow_logb (by norm_num) (by norm_num) hu0
  have hceil_le : Real.logb 2 u ≤ (⌈Real.logb 2 u⌉ : ℝ) := Int.le_ceil _
  have hceil_lt : (⌈Real.logb 2 u⌉ : ℝ) < Real.logb 2 u + 1 := Int.ceil_lt_add_one _
  have hz : Dyad s = (2 : ℝ) ^ ((⌈Real.logb 2 u⌉ : ℤ) : ℝ) := by
    rw [Dyad, ← hu, Real.rpow_intCast]
  constructor
  · calc u = (2 : ℝ) ^ Real.logb 2 u := hlog.symm
      _ ≤ (2 : ℝ) ^ ((⌈Real.logb 2 u⌉ : ℤ) : ℝ) :=
          Real.rpow_le_rpow_left_iff (by norm_num) |>.mpr (by exact_mod_cast hceil_le)
      _ = Dyad s := hz.symm
  · calc Dyad s = (2 : ℝ) ^ ((⌈Real.logb 2 u⌉ : ℤ) : ℝ) := hz
      _ < (2 : ℝ) ^ (Real.logb 2 u + 1) :=
          Real.rpow_lt_rpow_left_iff (by norm_num) |>.mpr (by exact_mod_cast hceil_lt)
      _ = 2 * u := by rw [Real.rpow_add (by norm_num), hlog, Real.rpow_one]; ring

/-- `Dyad s` is positive; blueprint `def:dyadic-envelope`. -/
theorem dyad_pos (s : ℝ) : 0 < Dyad s := by
  rw [Dyad]; exact zpow_pos (by norm_num) _

/-- `Dyad s` is at least `1`; blueprint `def:dyadic-envelope`. -/
theorem one_le_dyad (s : ℝ) : 1 ≤ Dyad s := le_trans (le_max_left _ _) (dyad_bounds s).1

/-- Subadditivity of a subunit power, scalar two-term form; blueprint `lem:subunit-power`. -/
theorem add_rpow_le_of_le_one {q : ℝ} (hq0 : 0 < q) (hq1 : q ≤ 1) {u v : ℝ}
    (hu : 0 ≤ u) (hv : 0 ≤ v) : (u + v) ^ q ≤ u ^ q + v ^ q :=
  Real.rpow_add_le_add_rpow hu hv hq0.le hq1

/-- A `C¹` cutoff supported in `[a, b]` vanishes at both endpoints; blueprint
`lem:cutoff-boundary`. -/
theorem cutoff_boundary {a b : ℝ} (_hab : a < b) {ψ : ℝ → ℝ} (hψ : Continuous ψ)
    (hsupp : Function.support ψ ⊆ Set.Icc a b) : ψ a = 0 ∧ ψ b = 0 := by
  have hlt : Set.EqOn ψ 0 (Set.Iio a) := fun t ht => by
    by_contra h
    exact absurd (hsupp h).1 (not_le.mpr ht)
  have hgt : Set.EqOn ψ 0 (Set.Ioi b) := fun t ht => by
    by_contra h
    exact absurd (hsupp h).2 (not_le.mpr ht)
  refine ⟨?_, ?_⟩
  · have := hlt.closure hψ continuous_const
    simpa using this (by rw [closure_Iio]; exact Set.mem_Iic.mpr le_rfl)
  · have := hgt.closure hψ continuous_const
    simpa using this (by rw [closure_Ioi]; exact Set.mem_Ici.mpr le_rfl)


/-! ## The ambient space, the monomial curve, and the averages -/

/-- The ambient space `ℝ³` of the blueprint, carrying the Euclidean inner product and
Lebesgue measure. With this choice Mathlib's Fourier transform `𝓕` is exactly the
convention of blueprint `def:fourier`. -/
abbrev E3 : Type := EuclideanSpace ℝ (Fin 3)

/-- The exponent attached to the coordinate `i`. The blueprint indexes coordinates by
`{1, 2, 3}` and attaches the monomial `t ^ n` to `e_n`; `Fin 3` indexes them by `{0, 1, 2}`,
so the exponent of coordinate `i` is `i + 1`. -/
def expo (i : Fin 3) : ℕ := (i : ℕ) + 1

theorem expo_pos (i : Fin 3) : 0 < expo i := Nat.succ_pos _

/-- The standard basis vector `e_i` of `ℝ³`. -/
noncomputable def basisVec (i : Fin 3) : E3 := EuclideanSpace.single i (1 : ℝ)

/-- The monomial curve `t ↦ tⁿ eₙ` in the `i`-th coordinate direction, blueprint
`def:averages`. -/
noncomputable def curve (i : Fin 3) (t : ℝ) : E3 := (t ^ expo i) • basisVec i

theorem curve_apply (i : Fin 3) (t : ℝ) (j : Fin 3) :
    curve i t j = if j = i then t ^ expo i else 0 := by
  simp [curve, basisVec, PiLp.single_apply]

theorem continuous_curve (i : Fin 3) : Continuous (curve i) :=
  (continuous_pow _).smul continuous_const

/-- The integrand `∏ₙ fₙ (x + tⁿ eₙ)` of every average in blueprint `def:averages`. -/
noncomputable def prodShift (f : Fin 3 → E3 → ℂ) (x : E3) (t : ℝ) : ℂ :=
  ∏ i : Fin 3, f i (x + curve i t)

theorem continuous_prodShift {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Continuous (f i)) (x : E3) :
    Continuous (prodShift f x) :=
  continuous_finsetProd _ fun i _ =>
    (hf i).comp (continuous_const.add (continuous_curve i))

theorem intervalIntegrable_prodShift {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Continuous (f i))
    (x : E3) (u v : ℝ) : IntervalIntegrable (prodShift f x) MeasureTheory.volume u v :=
  (continuous_prodShift hf x).intervalIntegrable u v

/-- The normalized monomial average `A_N`, blueprint `def:averages`. -/
noncomputable def A (N : ℝ) (f : Fin 3 → E3 → ℂ) (x : E3) : ℂ :=
  (N : ℂ)⁻¹ * ∫ t in (0 : ℝ)..N, prodShift f x t

/-- The upper-half average `Ã_N`, blueprint `def:averages`. -/
noncomputable def Atilde (N : ℝ) (f : Fin 3 → E3 → ℂ) (x : E3) : ℂ :=
  2 * (N : ℂ)⁻¹ * ∫ t in (N / 2 : ℝ)..N, prodShift f x t

/-- The unnormalized average `B_r`, blueprint `def:averages`. -/
noncomputable def B (r : ℝ) (f : Fin 3 → E3 → ℂ) (x : E3) : ℂ :=
  ∫ t in (0 : ℝ)..r, prodShift f x t

/-- The weighted average `𝒜_ψ` appearing in the main theorem; blueprint abstract and
`thm:main`. -/
noncomputable def Apsi (ψ : ℝ → ℝ) (f : Fin 3 → E3 → ℂ) (x : E3) : ℂ :=
  ∫ t : ℝ, (ψ t : ℂ) * prodShift f x t

