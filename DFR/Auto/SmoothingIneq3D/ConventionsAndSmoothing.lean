    intro i
    rw [Real.inv_rpow hN.le, ← Real.rpow_neg hN.le]
  simp only [hinv]
  rw [Fin.prod_univ_three, ← Real.rpow_add hN, ← Real.rpow_add hN, ← Real.rpow_add hN]
  have hs : (6 : ℝ) / q + (-(6 / qv 0) + -(6 / qv 1) + -(6 / qv 2)) = 0 := by
    have h := hsum
    rw [Fin.sum_univ_three] at h
    field_simp at h ⊢
    nlinarith [h, (_hqv 0).ne', (_hqv 1).ne', (_hqv 2).ne', hq.ne']
  rw [hs, Real.rpow_zero]

