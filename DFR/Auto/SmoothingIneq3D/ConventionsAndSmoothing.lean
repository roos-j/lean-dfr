  obtain ⟨γB, CB, hγB, hCB0, hNB⟩ := normalized_banach j HA hs1 hsv1 hsvsum
  have hCeta0 : (0 : ℝ) < Ceta := lt_of_lt_of_le zero_lt_one one_le_Ceta
  refine ⟨θ * γB, (Ceta * Csub) ^ τ * (Ceta * CB) ^ θ,
    ⟨mul_pos hθ0 hγB.1, ?_⟩, by positivity, ?_⟩
