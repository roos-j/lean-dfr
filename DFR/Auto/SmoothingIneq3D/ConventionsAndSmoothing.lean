            * ∏ i, eLpNorm (h i) (ENNReal.ofReal (b i)⁻¹) volume) := mul_le_mul' le_rfl hP
      _ = ENNReal.ofReal (Ceta * Csub)
            * ∏ i, eLpNorm (h i) (ENNReal.ofReal (b i)⁻¹) volume := by
          rw [ENNReal.ofReal_mul hCeta0.le]
