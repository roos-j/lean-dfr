  have hrw : ∀ g : Fin 3 → E3 → ℂ, Tproj N R j g y
      = (N : ℂ)⁻¹ * ∫ t in Set.Ioc (0 : ℝ) N,
          ∏ i, (Function.update g j (Q R j (g j))) i (y + curve i t) := by
    intro g
    simp only [Tproj, A, prodShift]
    rw [intervalIntegral.integral_of_le hN]
