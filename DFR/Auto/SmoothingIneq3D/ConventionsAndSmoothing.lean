    exact hg.smul_measure _
  rw [← MeasureTheory.integral_map (measurable_D ρ).aemeasurable hmap, map_D_volume hρ,
    MeasureTheory.integral_smul_measure, ENNReal.toReal_ofReal (by positivity)]

/-- Fourth identity of blueprint `lem:scaling`: `𝓕(S_ρ f)(ξ) = ρ⁶ 𝓕f(D_ρ ξ)`. -/
theorem fourier_S {ρ : ℝ} (hρ : 0 < ρ) {f : E3 → ℂ} (hf : Continuous f) (ξ : E3) :
    𝓕 (S ρ f) ξ = (ρ ^ 6 : ℝ) • 𝓕 f (D ρ ξ) := by
  have hg : MeasureTheory.AEStronglyMeasurable
      (fun v : E3 => 𝐞 (-⟪v, ξ⟫) • S ρ f v) MeasureTheory.volume := by
    exact (Real.continuous_fourierChar.comp (by fun_prop)).aestronglyMeasurable.smul
      (continuous_S hf).aestronglyMeasurable
  have hcv := integral_comp_D hρ hg
  rw [Real.fourier_eq, Real.fourier_eq]
  have hstep : ∀ y : E3, 𝐞 (-⟪D ρ y, ξ⟫) • S ρ f (D ρ y) = 𝐞 (-⟪y, D ρ ξ⟫) • f y := by
    intro y
    rw [inner_D_left]
    congr 1
    rw [S, D_inv_D hρ.ne']
  calc (∫ v, 𝐞 (-⟪v, ξ⟫) • S ρ f v)
      = (ρ ^ 6 : ℝ) • ∫ y, 𝐞 (-⟪D ρ y, ξ⟫) • S ρ f (D ρ y) := by
        rw [hcv, smul_smul, mul_inv_cancel₀ (by positivity), one_smul]
    _ = (ρ ^ 6 : ℝ) • ∫ y, 𝐞 (-⟪y, D ρ ξ⟫) • f y := by simp_rw [hstep]

/-- Fifth statement of blueprint `lem:scaling`: the dilation moves a one-coordinate
high-frequency support condition by the factor `ρ^{-j}`. -/
theorem support_fourier_S {ρ : ℝ} (hρ : 0 < ρ) {f : E3 → ℂ} (hf : Continuous f) {j : Fin 3}
    {lam : ℝ} (hsupp : Function.support (𝓕 f) ⊆ {ξ : E3 | lam ≤ |ξ j|}) :
    Function.support (𝓕 (S ρ f)) ⊆ {ξ : E3 | (ρ ^ expo j)⁻¹ * lam ≤ |ξ j|} := by
  intro ξ hξ
  by_contra hcon
  simp only [Set.mem_ofPred_eq, not_le] at hcon
  have hpow : (0 : ℝ) < ρ ^ expo j := by positivity
  have hDξ : |(D ρ ξ) j| < lam := by
    rw [D_apply, abs_mul, abs_of_pos hpow]
    calc ρ ^ expo j * |ξ j| < ρ ^ expo j * ((ρ ^ expo j)⁻¹ * lam) :=
          mul_lt_mul_of_pos_left hcon hpow
      _ = lam := by field_simp
  have hzero : 𝓕 f (D ρ ξ) = 0 := by
    by_contra h
    exact absurd (hsupp h) (by simpa using not_le.mpr hDξ)
  exact hξ (by rw [fourier_S hρ hf, hzero, smul_zero])

/-! ## Section 2 continued: the trivial Hölder estimate -/

open MeasureTheory in
/-- The `L^p` seminorm on `ℝ³` is translation invariant. -/
theorem eLpNorm_comp_add_right {f : E3 → ℂ} (hf : Continuous f) (c : E3) (p : ℝ≥0∞) :
    eLpNorm (fun x => f (x + c)) p volume = eLpNorm f p volume :=
  eLpNorm_comp_measurePreserving (g := f) (f := fun x => x + c) hf.aestronglyMeasurable
    (measurePreserving_add_right volume c)

open MeasureTheory in
/-- Hölder's inequality for a product of three functions; blueprint `lem:trivial-holder`. -/
theorem eLpNorm_mul_three_le {f₀ f₁ f₂ : E3 → ℂ} (h₀ : Continuous f₀) (h₁ : Continuous f₁)
    (h₂ : Continuous f₂) {p p₀ p₁ p₂ : ℝ≥0∞} (hp : p₀⁻¹ + p₁⁻¹ + p₂⁻¹ = p⁻¹) :
    eLpNorm (fun x => f₀ x * f₁ x * f₂ x) p volume
      ≤ eLpNorm f₀ p₀ volume * eLpNorm f₁ p₁ volume * eLpNorm f₂ p₂ volume := by
  set s : ℝ≥0∞ := (p₀⁻¹ + p₁⁻¹)⁻¹ with hs
  have hA : ENNReal.HolderTriple p₀ p₁ s := ⟨by rw [hs, inv_inv]⟩
  have hB : ENNReal.HolderTriple s p₂ p := ⟨by rw [hs, inv_inv, ← hp]⟩
  have e1 : (fun x => f₀ x * f₁ x) = f₀ • f₁ := by ext x; simp
  have e2 : (fun x => f₀ x * f₁ x * f₂ x) = (fun x => f₀ x * f₁ x) • f₂ := by ext x; simp
  have hmul : Continuous fun x => f₀ x * f₁ x := h₀.mul h₁
  calc eLpNorm (fun x => f₀ x * f₁ x * f₂ x) p volume
      = eLpNorm ((fun x => f₀ x * f₁ x) • f₂) p volume := by rw [e2]
    _ ≤ eLpNorm (fun x => f₀ x * f₁ x) s volume * eLpNorm f₂ p₂ volume :=
        eLpNorm_smul_le_mul_eLpNorm hmul.aestronglyMeasurable h₂.aestronglyMeasurable
    _ ≤ (eLpNorm f₀ p₀ volume * eLpNorm f₁ p₁ volume) * eLpNorm f₂ p₂ volume := by
        gcongr
        rw [e1]
        exact eLpNorm_smul_le_mul_eLpNorm h₀.aestronglyMeasurable h₁.aestronglyMeasurable
    _ = eLpNorm f₀ p₀ volume * eLpNorm f₁ p₁ volume * eLpNorm f₂ p₂ volume := by ring

open MeasureTheory in
/-- For each fixed parameter `t` the shifted product obeys Hölder's inequality with no loss;
this is the first display in the proof of blueprint `lem:trivial-holder`. -/
theorem eLpNorm_prodShift_le {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Continuous (f i))
    {p : ℝ≥0∞} {pv : Fin 3 → ℝ≥0∞} (hp : (pv 0)⁻¹ + (pv 1)⁻¹ + (pv 2)⁻¹ = p⁻¹) (t : ℝ) :
    eLpNorm (fun x => prodShift f x t) p volume ≤ ∏ i, eLpNorm (f i) (pv i) volume := by
  have hshift : ∀ i : Fin 3, Continuous fun x : E3 => f i (x + curve i t) :=
    fun i => (hf i).comp (continuous_id.add continuous_const)
  have hprod : (fun x => prodShift f x t)
      = fun x => f 0 (x + curve 0 t) * f 1 (x + curve 1 t) * f 2 (x + curve 2 t) := by
    funext x
    simp [prodShift, Fin.prod_univ_three]
  rw [hprod, Fin.prod_univ_three]
  calc eLpNorm (fun x => f 0 (x + curve 0 t) * f 1 (x + curve 1 t) * f 2 (x + curve 2 t))
        p volume
      ≤ eLpNorm (fun x => f 0 (x + curve 0 t)) (pv 0) volume
        * eLpNorm (fun x => f 1 (x + curve 1 t)) (pv 1) volume
        * eLpNorm (fun x => f 2 (x + curve 2 t)) (pv 2) volume :=
        eLpNorm_mul_three_le (hshift 0) (hshift 1) (hshift 2) hp
    _ = eLpNorm (f 0) (pv 0) volume * eLpNorm (f 1) (pv 1) volume
        * eLpNorm (f 2) (pv 2) volume := by
        rw [eLpNorm_comp_add_right (hf 0), eLpNorm_comp_add_right (hf 1),
          eLpNorm_comp_add_right (hf 2)]

open MeasureTheory in
/-- Hölder's inequality in the parameter: for a finite measure `ν` and `1 ≤ P`,
`(∫ h dν)^P ≤ ν(univ)^{P-1} ∫ h^P dν`. -/
theorem lintegral_rpow_le_of_isFiniteMeasure {ν : Measure ℝ} [IsFiniteMeasure ν] {P : ℝ}
    (hP : 1 ≤ P) {h : ℝ → ℝ≥0∞} (hh : AEMeasurable h ν) :
    (∫⁻ t, h t ∂ν) ^ P ≤ (ν Set.univ) ^ (P - 1) * ∫⁻ t, h t ^ P ∂ν := by
  rcases eq_or_lt_of_le hP with hP1 | hP1
  · simp [← hP1]
  have hP0 : 0 < P := lt_trans one_pos hP1
  have hPm : 0 < P - 1 := sub_pos.mpr hP1
  set Q := P / (P - 1) with hQ
  have hQ0 : 0 < Q := div_pos hP0 hPm
  have hconj : Real.HolderConjugate P Q :=
    ⟨by rw [hQ]; field_simp; ring, hP0, hQ0⟩
  have hol := ENNReal.lintegral_mul_le_Lp_mul_Lq ν hconj hh
    (aemeasurable_const (b := (1 : ℝ≥0∞)))
  simp only [Pi.mul_apply, mul_one, ENNReal.one_rpow, lintegral_const, one_mul] at hol
  have hraise := ENNReal.rpow_le_rpow hol hP0.le
  rw [ENNReal.mul_rpow_of_nonneg _ _ hP0.le, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul] at hraise
  rw [one_div, inv_mul_cancel₀ hP0.ne', ENNReal.rpow_one] at hraise
  have hexp : 1 / Q * P = P - 1 := by rw [hQ]; field_simp
  rw [hexp] at hraise
  exact hraise.trans_eq (mul_comm _ _)

open MeasureTheory in
/-- The `L^p` bound for an average over a finite parameter measure. This is the special case of
Minkowski's integral inequality used in blueprint `lem:trivial-holder` and in the proof of
`thm:main`. It is derived here from Hölder's inequality in the parameter together with Tonelli's
theorem; see `automation/ErrorReport.md` for this recorded change of proof route. -/
theorem eLpNorm_le_of_enorm_le_lintegral {ν : Measure ℝ} [IsFiniteMeasure ν] {p : ℝ≥0∞}
    (hp1 : 1 ≤ p) (hptop : p ≠ ⊤) {G : ℝ → E3 → ℂ}
    (hG : Measurable fun z : E3 × ℝ => G z.2 z.1) {F : E3 → ℂ}
    (hFm : AEStronglyMeasurable F volume)
    (hF : ∀ x, ‖F x‖ₑ ≤ ∫⁻ t, ‖G t x‖ₑ ∂ν) {C : ℝ≥0∞}
    (hC : ∀ᵐ t ∂ν, eLpNorm (G t) p volume ≤ C) :
    eLpNorm F p volume ≤ ν Set.univ * C := by
  have hp0 : p ≠ 0 := by
    intro h; rw [h] at hp1; exact absurd hp1 (by simp)
  have hP : 1 ≤ p.toReal := by
    rw [show (1 : ℝ) = (1 : ℝ≥0∞).toReal by simp]
    exact ENNReal.toReal_mono hptop hp1
  set P := p.toReal with hPdef
  have hP0 : 0 < P := lt_of_lt_of_le one_pos hP
  rcases eq_or_ne (ν Set.univ) 0 with hν0 | hν0
  · have hz : ν = 0 := by rwa [← Measure.measure_univ_eq_zero]
    have hFz : F = fun _ => (0 : ℂ) := by
      funext x
      have h := hF x
      rw [hz] at h
      simp only [lintegral_zero_measure, le_zero_iff, enorm_eq_zero] at h
      exact h
    rw [hFz, hν0, zero_mul]
    simp
  have hνtop : ν Set.univ ≠ ⊤ := measure_ne_top ν _
  have hmeas : Measurable fun z : E3 × ℝ => ‖G z.2 z.1‖ₑ ^ P := hG.enorm.pow_const P
  have hconstne : ((ν Set.univ) ^ (P - 1) : ℝ≥0∞) ≠ ⊤ :=
    ENNReal.rpow_ne_top_of_nonneg (by linarith) hνtop
  have key : ∫⁻ x, ‖F x‖ₑ ^ P ∂volume ≤ (ν Set.univ * C) ^ P := by
    calc ∫⁻ x, ‖F x‖ₑ ^ P ∂volume
        ≤ ∫⁻ x, (∫⁻ t, ‖G t x‖ₑ ∂ν) ^ P ∂volume :=
          lintegral_mono fun x => ENNReal.rpow_le_rpow (hF x) hP0.le
      _ ≤ ∫⁻ x, (ν Set.univ) ^ (P - 1) * ∫⁻ t, ‖G t x‖ₑ ^ P ∂ν ∂volume :=
          lintegral_mono fun x => lintegral_rpow_le_of_isFiniteMeasure hP
            (hG.comp (measurable_prodMk_left)).enorm.aemeasurable
      _ = (ν Set.univ) ^ (P - 1) * ∫⁻ x, ∫⁻ t, ‖G t x‖ₑ ^ P ∂ν ∂volume :=
          lintegral_const_mul' _ _ hconstne
      _ = (ν Set.univ) ^ (P - 1) * ∫⁻ t, ∫⁻ x, ‖G t x‖ₑ ^ P ∂volume ∂ν := by
          rw [lintegral_lintegral_swap hmeas.aemeasurable]
      _ ≤ (ν Set.univ) ^ (P - 1) * ∫⁻ _t, C ^ P ∂ν := by
          refine mul_le_mul' le_rfl (lintegral_mono_ae ?_)
          filter_upwards [hC] with t ht
          rw [eLpNorm_eq_eLpNorm' (f := G t) hp0 hptop (hG.comp
            measurable_prodMk_right).aestronglyMeasurable, eLpNorm'] at ht
          have := ENNReal.rpow_le_rpow ht hP0.le
          rwa [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hP0.ne', ENNReal.rpow_one] at this
      _ = (ν Set.univ) ^ (P - 1) * (ν Set.univ * C ^ P) := by
          rw [lintegral_const]; ring
      _ = (ν Set.univ * C) ^ P := by
          have h1 : (ν Set.univ) ^ (P - 1) * ν Set.univ = (ν Set.univ) ^ P := by
            nth_rewrite 2 [← ENNReal.rpow_one (ν Set.univ)]
            rw [← ENNReal.rpow_add _ _ hν0 hνtop]
            congr 1
            ring
          rw [ENNReal.mul_rpow_of_nonneg _ _ hP0.le, ← mul_assoc, h1]
  rw [eLpNorm_eq_eLpNorm' hp0 hptop (by fun_prop), eLpNorm']
  calc (∫⁻ x, ‖F x‖ₑ ^ P ∂volume) ^ (1 / P)
      ≤ ((ν Set.univ * C) ^ P) ^ (1 / P) := ENNReal.rpow_le_rpow key (by positivity)
    _ = ν Set.univ * C := by
        rw [← ENNReal.rpow_mul, mul_one_div, div_self hP0.ne', ENNReal.rpow_one]

open MeasureTheory in
/-- The uniform-bound specialization used for the averages `A_r` and `B_r`. -/
theorem eLpNorm_integral_le {ν : Measure ℝ} [IsFiniteMeasure ν] {p : ℝ≥0∞}
    (hp1 : 1 ≤ p) (hptop : p ≠ ⊤) {G : ℝ → E3 → ℂ}
    (hG : Continuous (Function.uncurry G)) {C : ℝ≥0∞}
    (hC : ∀ t, eLpNorm (G t) p volume ≤ C) :
    eLpNorm (fun x => ∫ t, G t x ∂ν) p volume ≤ ν Set.univ * C :=
  eLpNorm_le_of_enorm_le_lintegral hp1 hptop (hG.comp continuous_swap).measurable
    (show StronglyMeasurable (Function.uncurry fun x t => G t x) from
      (hG.comp continuous_swap).stronglyMeasurable).integral_prod_right.aestronglyMeasurable
    (fun _ => enorm_integral_le_lintegral_enorm _) (Filter.Eventually.of_forall hC)

/-- The average integrand is jointly continuous in the parameter and the point. -/
theorem continuous_uncurry_prodShift {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Continuous (f i)) :
    Continuous (Function.uncurry fun (t : ℝ) (x : E3) => prodShift f x t) := by
  have hrw : (Function.uncurry fun (t : ℝ) (x : E3) => prodShift f x t)
      = fun z : ℝ × E3 => ∏ i : Fin 3, f i (z.2 + curve i z.1) := by
    funext z; simp [Function.uncurry, prodShift]
  rw [hrw]
  exact continuous_finsetProd _ fun i _ =>
    (hf i).comp (continuous_snd.add ((continuous_curve i).comp continuous_fst))

open MeasureTheory in
/-- Blueprint `lem:trivial-holder`, the bound for the unnormalized average:
`‖B_r(f₁,f₂,f₃)‖_{L^p} ≤ r ∏ ‖fₙ‖_{L^{pₙ}}`. -/
theorem eLpNorm_B_le {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Continuous (f i))
    {p : ℝ≥0∞} (hp1 : 1 ≤ p) (hptop : p ≠ ⊤) {pv : Fin 3 → ℝ≥0∞}
    (hp : (pv 0)⁻¹ + (pv 1)⁻¹ + (pv 2)⁻¹ = p⁻¹) {r : ℝ} (hr : 0 ≤ r) :
    eLpNorm (B r f) p volume
      ≤ ENNReal.ofReal r * ∏ i, eLpNorm (f i) (pv i) volume := by
  have : IsFiniteMeasure (volume.restrict (Set.Ioc (0 : ℝ) r)) :=
    ⟨by rw [Measure.restrict_apply_univ, Real.volume_Ioc]; exact ENNReal.ofReal_lt_top⟩
  have hBeq : B r f = fun x => ∫ t, prodShift f x t ∂(volume.restrict (Set.Ioc (0 : ℝ) r)) := by
    funext x
    rw [B, intervalIntegral.integral_of_le hr]
  have huniv : (volume.restrict (Set.Ioc (0 : ℝ) r)) Set.univ = ENNReal.ofReal r := by
    rw [Measure.restrict_apply_univ, Real.volume_Ioc, sub_zero]
  rw [hBeq]
  have := eLpNorm_integral_le (ν := volume.restrict (Set.Ioc (0 : ℝ) r)) hp1 hptop
    (G := fun (t : ℝ) (x : E3) => prodShift f x t) (continuous_uncurry_prodShift hf)
    (C := ∏ i, eLpNorm (f i) (pv i) volume)
    (fun t => eLpNorm_prodShift_le hf hp t)
  rwa [huniv] at this

open MeasureTheory in
/-- Blueprint `lem:trivial-holder`, the bound for the normalized average:
`‖A_N(f₁,f₂,f₃)‖_{L^p} ≤ ∏ ‖fₙ‖_{L^{pₙ}}`. -/
theorem eLpNorm_A_le {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Continuous (f i))
    {p : ℝ≥0∞} (hp1 : 1 ≤ p) (hptop : p ≠ ⊤) {pv : Fin 3 → ℝ≥0∞}
    (hp : (pv 0)⁻¹ + (pv 1)⁻¹ + (pv 2)⁻¹ = p⁻¹) {N : ℝ} (hN : 0 < N) :
    eLpNorm (A N f) p volume ≤ ∏ i, eLpNorm (f i) (pv i) volume := by
  have hAeq : A N f = (N : ℂ)⁻¹ • B N f := rfl
  have hnorm : ‖(N : ℂ)⁻¹‖ₑ = (ENNReal.ofReal N)⁻¹ := by
    rw [enorm_inv (by exact_mod_cast hN.ne'), ← ofReal_norm, Complex.norm_real,
      Real.norm_of_nonneg hN.le]
  have hNne : ENNReal.ofReal N ≠ 0 := by simpa using hN
  have hNtop : ENNReal.ofReal N ≠ ⊤ := ENNReal.ofReal_ne_top
  calc eLpNorm (A N f) p volume
      = (ENNReal.ofReal N)⁻¹ * eLpNorm (B N f) p volume := by
        rw [hAeq, eLpNorm_const_smul, hnorm]
    _ ≤ (ENNReal.ofReal N)⁻¹ * (ENNReal.ofReal N * ∏ i, eLpNorm (f i) (pv i) volume) := by
        gcongr
        exact eLpNorm_B_le hf hp1 hptop hp hN.le
    _ = ∏ i, eLpNorm (f i) (pv i) volume := by
        rw [← mul_assoc, ENNReal.inv_mul_cancel hNne hNtop, one_mul]

/-- The finite dyadic identity of blueprint `lem:dyadic-decomposition`:
`A_N = ∑_{m<M} 2^{-m-1} Ã_{2^{-m}N} + 2^{-M} A_{2^{-M}N}`. -/
theorem A_dyadic_finite {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Continuous (f i))
    {N : ℝ} (hN : N ≠ 0) (x : E3) (M : ℕ) :
    A N f x = (∑ m ∈ Finset.range M, ((2 : ℂ)⁻¹) ^ (m + 1) * Atilde (N / 2 ^ m) f x)
      + ((2 : ℂ)⁻¹) ^ M * A (N / 2 ^ M) f x := by
  induction M with
  | zero => simp
  | succ M ih =>
    have hNM : N / 2 ^ M ≠ 0 := div_ne_zero hN (by positivity)
    have hhalf : (N / 2 ^ M) / 2 = N / 2 ^ (M + 1) := by
      rw [pow_succ]; ring
    rw [Finset.sum_range_succ, ih, A_eq_half_Atilde_add_half_A hf hNM x, hhalf]
    ring

/-- A uniform bound for the normalized averages at every scale below `N`; this supplies the
boundedness used in the limit half of blueprint `lem:dyadic-decomposition`. -/
theorem norm_A_le {f : Fin 3 → E3 → ℂ} (_hf : ∀ i, Continuous (f i)) (x : E3)
    {N K : ℝ} (hK : ∀ t ∈ Set.Icc (0 : ℝ) N, ‖prodShift f x t‖ ≤ K)
    {L : ℝ} (hL0 : 0 < L) (hLN : L ≤ N) : ‖A L f x‖ ≤ K := by
  have hbound : ∀ t ∈ Set.uIoc (0 : ℝ) L, ‖prodShift f x t‖ ≤ K := by
    intro t ht
    rw [Set.uIoc_of_le hL0.le] at ht
    exact hK t ⟨ht.1.le, ht.2.trans hLN⟩
  have hint : ‖∫ t in (0 : ℝ)..L, prodShift f x t‖ ≤ K * |L - 0| :=
    intervalIntegral.norm_integral_le_of_norm_le_const hbound
  rw [A, norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hL0.le]
  rw [sub_zero, abs_of_pos hL0] at hint
  calc L⁻¹ * ‖∫ t in (0 : ℝ)..L, prodShift f x t‖ ≤ L⁻¹ * (K * L) := by
        exact mul_le_mul_of_nonneg_left hint (by positivity)
    _ = K := by field_simp

/-- The pointwise limit in blueprint `lem:dyadic-decomposition`. -/
theorem A_dyadic_tendsto {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Continuous (f i))
    {N : ℝ} (hN : 0 < N) (x : E3) :
    Filter.Tendsto
      (fun M : ℕ => ∑ m ∈ Finset.range M, ((2 : ℂ)⁻¹) ^ (m + 1) * Atilde (N / 2 ^ m) f x)
      Filter.atTop (nhds (A N f x)) := by
  obtain ⟨K, hK⟩ := (isCompact_Icc (a := (0 : ℝ)) (b := N)).exists_bound_of_continuousOn
    (continuous_prodShift hf x).continuousOn
  have hK0 : 0 ≤ K := le_trans (norm_nonneg _) (hK 0 ⟨le_rfl, hN.le⟩)
  have htail : Filter.Tendsto
      (fun M : ℕ => ((2 : ℂ)⁻¹) ^ M * A (N / 2 ^ M) f x) Filter.atTop (nhds 0) := by
    refine squeeze_zero_norm (a := fun M : ℕ => (2 : ℝ)⁻¹ ^ M * K) (fun M => ?_) ?_
    · have hL0 : 0 < N / 2 ^ M := by positivity
      have h2 : (1 : ℝ) ≤ 2 ^ M := one_le_pow₀ (by norm_num)
      have hLN : N / 2 ^ M ≤ N := by
        rw [div_le_iff₀ (by positivity)]
        nlinarith
      calc ‖((2 : ℂ)⁻¹) ^ M * A (N / 2 ^ M) f x‖
          = (2 : ℝ)⁻¹ ^ M * ‖A (N / 2 ^ M) f x‖ := by
            rw [norm_mul, norm_pow, norm_inv, Complex.norm_ofNat]
        _ ≤ (2 : ℝ)⁻¹ ^ M * K := by
            exact mul_le_mul_of_nonneg_left (norm_A_le hf x hK hL0 hLN) (by positivity)
    · have := tendsto_pow_atTop_nhds_zero_of_lt_one
        (r := (2 : ℝ)⁻¹) (by norm_num) (by norm_num)
      simpa using this.mul_const K
  have hsum : ∀ M : ℕ,
      (∑ m ∈ Finset.range M, ((2 : ℂ)⁻¹) ^ (m + 1) * Atilde (N / 2 ^ m) f x)
        = A N f x - ((2 : ℂ)⁻¹) ^ M * A (N / 2 ^ M) f x := by
    intro M
    rw [A_dyadic_finite hf hN.ne' x M]
    ring
  have hlim : Filter.Tendsto (fun M : ℕ => A N f x - ((2 : ℂ)⁻¹) ^ M * A (N / 2 ^ M) f x)
      Filter.atTop (nhds (A N f x)) := by
    simpa using (tendsto_const_nhds (x := A N f x) (f := Filter.atTop (α := ℕ))).sub htail
  exact Filter.Tendsto.congr (fun M => (hsum M).symm) hlim

open intervalIntegral in
/-- Blueprint `lem:weighted-primitive-identity`:
`𝒜_ψ(f₁,f₂,f₃)(x) = -∫_a^b ψ'(u) (B_u(f)(x) - B_a(f)(x)) du`.
The blueprint argues by the fundamental theorem of calculus and Fubini's theorem on the
triangle `a ≤ t ≤ u ≤ b`; the equivalent Lean route used here is a single integration by
parts, whose boundary terms vanish by `cutoff_boundary`. -/
theorem weighted_primitive_identity {a b : ℝ} (hab : a < b)
    {ψ ψ' : ℝ → ℝ} (hψ : ∀ t, HasDerivAt ψ (ψ' t) t) (hψ'c : Continuous ψ')
    (hsupp : Function.support ψ ⊆ Set.Icc a b)
    {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Continuous (f i)) (x : E3) :
    Apsi ψ f x = -∫ u in a..b, (ψ' u : ℂ) * (B u f x - B a f x) := by
  have hψc : Continuous ψ := continuous_iff_continuousAt.mpr fun t => (hψ t).continuousAt
  obtain ⟨hψa, hψb⟩ := cutoff_boundary hab hψc hsupp
  have hFc : Continuous (prodShift f x) := continuous_prodShift hf x
  have hψ'C : Continuous fun t : ℝ => (ψ' t : ℂ) := Complex.continuous_ofReal.comp hψ'c
  have hUderiv : ∀ t : ℝ, HasDerivAt (fun s => (ψ s : ℂ)) ((ψ' t : ℂ)) t :=
    fun t => (hψ t).ofReal_comp
  have hBderiv : ∀ u : ℝ, HasDerivAt (fun s => B s f x) (prodShift f x u) u := fun u =>
    integral_hasDerivAt_right (hFc.intervalIntegrable _ _)
      hFc.aestronglyMeasurable.stronglyMeasurableAtFilter hFc.continuousAt
  have hBc : Continuous fun s => B s f x :=
    continuous_iff_continuousAt.mpr fun s => (hBderiv s).continuousAt
  -- the weighted average is an integral over `[a, b]`
  have hApsi : Apsi ψ f x = ∫ t in a..b, (ψ t : ℂ) * prodShift f x t := by
    rw [Apsi, intervalIntegral.integral_of_le hab.le,
      MeasureTheory.setIntegral_eq_integral_of_forall_compl_eq_zero]
    intro t ht
    have : ψ t = 0 := by
      by_contra h
      obtain ⟨h1, h2⟩ := hsupp h
      exact ht ⟨lt_of_le_of_ne h1 (by rintro rfl; exact h hψa), h2⟩
    simp [this]
  -- integration by parts
  have hIBP := integral_mul_deriv_eq_deriv_mul (a := a) (b := b)
    (u := fun s => (ψ s : ℂ)) (u' := fun t => (ψ' t : ℂ))
    (v := fun s => B s f x) (v' := fun s => prodShift f x s)
    (fun t _ => hUderiv t) (fun s _ => hBderiv s)
    (hψ'C.intervalIntegrable _ _) (hFc.intervalIntegrable _ _)
  rw [hψa, hψb] at hIBP
  -- the `B_a` correction term integrates to zero
  have hzero : ∫ u in a..b, (ψ' u : ℂ) = 0 := by
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hUderiv t)
      (hψ'C.intervalIntegrable _ _), hψa, hψb]
    simp
  have hsplit : (∫ u in a..b, (ψ' u : ℂ) * (B u f x - B a f x))
      = (∫ u in a..b, (ψ' u : ℂ) * B u f x) - B a f x * ∫ u in a..b, (ψ' u : ℂ) := by
    have h1 : ∀ u : ℝ, (ψ' u : ℂ) * (B u f x - B a f x)
        = (ψ' u : ℂ) * B u f x - B a f x * (ψ' u : ℂ) := fun u => by ring
    simp_rw [h1]
    have hi1 : IntervalIntegrable (fun u : ℝ => (ψ' u : ℂ) * B u f x) MeasureTheory.volume a b :=
      (hψ'C.mul hBc).intervalIntegrable _ _
    have hi2 : IntervalIntegrable (fun u : ℝ => B a f x * (ψ' u : ℂ)) MeasureTheory.volume a b :=
      (continuous_const.mul hψ'C).intervalIntegrable _ _
    rw [intervalIntegral.integral_sub hi1 hi2, intervalIntegral.integral_const_mul]
  rw [hApsi, hIBP, hsplit, hzero]
  simp

/-- Finite-sum form of the subunit power inequality for nonnegative reals;
blueprint `lem:subunit-power`. -/
theorem real_sum_rpow_le {q : ℝ} (hq0 : 0 < q) (hq1 : q ≤ 1) {M : ℕ} {y : ℕ → ℝ}
    (hy : ∀ m, 0 ≤ y m) :
    (∑ m ∈ Finset.range M, y m) ^ q ≤ ∑ m ∈ Finset.range M, y m ^ q := by
  induction M with
  | zero => simp [Real.zero_rpow hq0.ne']
  | succ M ih =>
    rw [Finset.sum_range_succ, Finset.sum_range_succ]
    refine le_trans (add_rpow_le_of_le_one hq0 hq1 (Finset.sum_nonneg fun m _ => hy m) (hy M)) ?_
    exact add_le_add ih le_rfl

/-- Scalar form of the subunit power inequality; blueprint `lem:subunit-power`:
`|∑ z_m|^q ≤ ∑ |z_m|^q` for `q ∈ (0, 1]`. -/
theorem norm_sum_rpow_le {q : ℝ} (hq0 : 0 < q) (hq1 : q ≤ 1) {M : ℕ} (z : ℕ → ℂ) :
    ‖∑ m ∈ Finset.range M, z m‖ ^ q ≤ ∑ m ∈ Finset.range M, ‖z m‖ ^ q := by
  refine le_trans (Real.rpow_le_rpow (norm_nonneg _) (norm_sum_le _ _) hq0.le) ?_
  exact real_sum_rpow_le hq0 hq1 (fun m => norm_nonneg (z m))

/-- Finite-sum form of the subunit power inequality in `ℝ≥0∞`. -/
theorem ennreal_sum_rpow_le {q : ℝ} (hq0 : 0 < q) (hq1 : q ≤ 1) {M : ℕ} (z : ℕ → ℝ≥0∞) :
    (∑ m ∈ Finset.range M, z m) ^ q ≤ ∑ m ∈ Finset.range M, z m ^ q := by
  induction M with
  | zero => simp [ENNReal.zero_rpow_of_pos hq0]
  | succ M ih =>
    rw [Finset.sum_range_succ, Finset.sum_range_succ]
    refine le_trans (ENNReal.rpow_add_le_add_rpow _ _ hq0.le hq1) ?_
    exact add_le_add ih le_rfl

open MeasureTheory in
/-- The `L^q` quasi-norm form of blueprint `lem:subunit-power`:
`‖∑ F_m‖_{L^q}^q ≤ ∑ ‖F_m‖_{L^q}^q` for `q ∈ (0, 1]`. -/
theorem eLpNorm'_sum_rpow_le {q : ℝ} (hq0 : 0 < q) (hq1 : q ≤ 1) {M : ℕ}
    {F : ℕ → E3 → ℂ} (hF : ∀ m, AEStronglyMeasurable (F m) volume) :
    eLpNorm' (fun x => ∑ m ∈ Finset.range M, F m x) q volume ^ q
      ≤ ∑ m ∈ Finset.range M, eLpNorm' (F m) q volume ^ q := by
  have hpow : ∀ g : E3 → ℂ, eLpNorm' g q volume ^ q = ∫⁻ x, ‖g x‖ₑ ^ q := by
    intro g
    rw [eLpNorm', ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
  rw [hpow]
  calc ∫⁻ x, ‖∑ m ∈ Finset.range M, F m x‖ₑ ^ q
      ≤ ∫⁻ x, (∑ m ∈ Finset.range M, ‖F m x‖ₑ) ^ q :=
        lintegral_mono fun x => ENNReal.rpow_le_rpow (enorm_sum_le _ _) hq0.le
    _ ≤ ∫⁻ x, ∑ m ∈ Finset.range M, ‖F m x‖ₑ ^ q :=
        lintegral_mono fun x => ennreal_sum_rpow_le hq0 hq1 _
    _ = ∑ m ∈ Finset.range M, ∫⁻ x, ‖F m x‖ₑ ^ q :=
        lintegral_finsetSum' _ fun m _ => ((hF m).enorm.pow_const q)
    _ = ∑ m ∈ Finset.range M, eLpNorm' (F m) q volume ^ q := by
        exact Finset.sum_congr rfl fun m _ => (hpow (F m)).symm

/-! ## Section 3: the one-coordinate low-frequency projection -/

/-- The smooth bump underlying the fixed cutoff of blueprint `def:projection`. -/
noncomputable def etaBump : ContDiffBump (0 : ℝ) :=
  ⟨1 / 4, 1 / 2, by norm_num, by norm_num⟩

/-- The fixed cutoff `η` of blueprint `def:projection`: a real-valued even smooth function
with `1_{[-1/4,1/4]} ≤ η ≤ 1_{(-1/2,1/2)}`. -/
noncomputable def eta : ℝ → ℝ := etaBump

theorem eta_nonneg (t : ℝ) : 0 ≤ eta t := ContDiffBump.nonneg (f := etaBump)

theorem eta_le_one (t : ℝ) : eta t ≤ 1 := ContDiffBump.le_one (f := etaBump)

/-- `η = 1` on `[-1/4, 1/4]`; the lower half of blueprint `def:projection`. -/
theorem eta_eq_one {t : ℝ} (ht : |t| ≤ 1 / 4) : eta t = 1 :=
  ContDiffBump.one_of_mem_closedBall (f := etaBump)
    (by simpa [Real.closedBall_eq_Icc, Set.mem_Icc, abs_le, etaBump] using ht)

/-- `supp η = (-1/2, 1/2)`; the upper half of blueprint `def:projection`. -/
theorem eta_support : Function.support eta = Set.Ioo (-(1 / 2) : ℝ) (1 / 2) := by
  rw [eta, ContDiffBump.support_eq (f := etaBump)]
  simp [Real.ball_eq_Ioo, etaBump]

/-- `η` vanishes outside `(-1/2, 1/2)`. -/
theorem eta_eq_zero {t : ℝ} (ht : 1 / 2 ≤ |t|) : eta t = 0 := by
  by_contra h
  have hmem : t ∈ Function.support eta := h
  rw [eta_support, Set.mem_Ioo] at hmem
  exact absurd ht (not_le.mpr (abs_lt.mpr ⟨hmem.1, hmem.2⟩))

/-- `η` is even; blueprint `def:projection`. -/
theorem eta_even (t : ℝ) : eta (-t) = eta t := ContDiffBump.neg etaBump t

theorem eta_contDiff : ContDiff ℝ (⊤ : ℕ∞) eta := ContDiffBump.contDiff (f := etaBump)

theorem eta_continuous : Continuous eta := eta_contDiff.continuous

theorem eta_hasCompactSupport : HasCompactSupport fun t : ℝ => (eta t : ℂ) := by
  refine HasCompactSupport.intro (isCompact_Icc (a := -(1 / 2 : ℝ)) (b := 1 / 2)) ?_
  intro t ht
  simp only [Set.mem_Icc, not_and_or, not_le] at ht
  have habs : 1 / 2 ≤ |t| := by
    rcases ht with h | h
    · rw [abs_of_neg (by linarith)]; linarith
    · rw [abs_of_pos (by linarith)]; linarith
  simp [eta_eq_zero habs]

theorem eta_contDiff_top : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) fun t : ℝ => (eta t : ℂ) :=
  Complex.ofRealCLM.contDiff.comp (ContDiffBump.contDiff (f := etaBump))

/-- The complexified cutoff as a Schwartz function on `ℝ`; blueprint `def:projection`. -/
noncomputable def etaS : SchwartzMap ℝ ℂ :=
  HasCompactSupport.toSchwartzMap eta_hasCompactSupport eta_contDiff_top

@[simp] theorem etaS_apply (t : ℝ) : etaS t = (eta t : ℂ) := rfl

/-- The inverse Fourier transform `η̌` of the cutoff, as a Schwartz function on `ℝ`.
It is the profile of the convolution kernel in blueprint `lem:projection-properties`. -/
noncomputable def etaKerS : SchwartzMap ℝ ℂ := 𝓕⁻ etaS

/-- `η̌` as an ordinary function. -/
noncomputable def etaKer : ℝ → ℂ := etaKerS

theorem etaKer_integrable : MeasureTheory.Integrable etaKer := etaKerS.integrable

theorem etaKer_continuous : Continuous etaKer := etaKerS.continuous

/-- Fourier inversion for the cutoff: `𝓕 η̌ = η`. This is the identity that makes the
convolution description of `P_R^{(j)}` agree with its multiplier description. -/
theorem fourier_etaKer : 𝓕 etaKer = fun t : ℝ => (eta t : ℂ) := by
  have h : 𝓕 (𝓕⁻ etaS) = etaS := FourierTransform.fourier_fourierInv_eq etaS
  exact congrArg (fun g : SchwartzMap ℝ ℂ => (g : ℝ → ℂ)) h

/-- The `L¹` norm of `η̌`, finite because `η̌` is a Schwartz function. -/
noncomputable def etaKerL1 : ℝ := ∫ u : ℝ, ‖etaKer u‖

theorem etaKerL1_nonneg : 0 ≤ etaKerL1 :=
  MeasureTheory.integral_nonneg fun _ => norm_nonneg _

/-- The dyadic constant `C_η` of blueprint `def:projection`. -/
noncomputable def Ceta : ℝ := Dyad (1 + etaKerL1)

theorem one_le_Ceta : 1 ≤ Ceta := one_le_dyad _

/-- The one-dimensional convolution kernel `k_R(u) = R · η̌(R u)` of blueprint
`lem:projection-properties`. -/
noncomputable def projKernel (R : ℝ) (u : ℝ) : ℂ := (R : ℂ) * etaKer (R * u)

@[fun_prop] theorem projKernel_continuous (R : ℝ) : Continuous (projKernel R) :=
  continuous_const.mul (etaKer_continuous.comp (continuous_const.mul continuous_id))

open MeasureTheory in
/-- The kernel is integrable, with the same `L¹` norm as `η̌`; blueprint
`lem:projection-properties`. This is the substitution `v = R u`. -/
theorem projKernel_integrable {R : ℝ} (hR : 0 < R) : Integrable (projKernel R) := by
  exact (etaKer_integrable.comp_mul_left' hR.ne').const_mul _

open MeasureTheory in
/-- `‖k_R‖_{L¹(ℝ)} = ‖η̌‖_{L¹(ℝ)}`; blueprint `lem:projection-properties`. -/
theorem projKernel_L1 {R : ℝ} (hR : 0 < R) :
    (∫ u : ℝ, ‖projKernel R u‖) = etaKerL1 := by
  have hnorm : ∀ u : ℝ, ‖projKernel R u‖ = R * ‖etaKer (R * u)‖ := by
    intro u
    rw [projKernel, norm_mul, Complex.norm_real, Real.norm_of_nonneg hR.le]
  simp only [hnorm]
  rw [integral_const_mul, Measure.integral_comp_mul_left (fun v => ‖etaKer v‖) R,
    abs_of_pos (inv_pos.mpr hR), smul_eq_mul, ← mul_assoc, mul_inv_cancel₀ hR.ne', one_mul]
  rfl

/-- The one-coordinate low-frequency projection `P_R^{(j)}` of blueprint `def:projection`,
realized as convolution in the `j`-th coordinate with the kernel `k_R`. The agreement with
the multiplier description `𝓕(P_R^{(j)} f) ξ = η(ξ_j / R) 𝓕 f ξ` is `fourier_P` below. -/
noncomputable def P (R : ℝ) (j : Fin 3) (f : E3 → ℂ) (x : E3) : ℂ :=
  ∫ u : ℝ, projKernel R u * f (x - u • basisVec j)

/-- `Q_R^{(j)} = I - P_{4R}^{(j)}`; blueprint `def:projection`. -/
noncomputable def Q (R : ℝ) (j : Fin 3) (f : E3 → ℂ) (x : E3) : ℂ :=
  f x - P (4 * R) j f x

open MeasureTheory in
/-- Weighted Hölder inequality in the parameter: for `1 ≤ P` and a weight `w`,
`(∫ w g)^P ≤ (∫ w)^{P-1} ∫ w g^P`. This is the weighted form of
`lintegral_rpow_le_of_isFiniteMeasure`, needed for the `L^s` bounds of blueprint
`lem:projection-properties`. -/
theorem lintegral_weighted_rpow_le {P : ℝ} (hP : 1 ≤ P) {w g : ℝ → ℝ≥0∞}
    (hw : AEMeasurable w volume) (hg : AEMeasurable g volume) :
    (∫⁻ u, w u * g u) ^ P ≤ (∫⁻ u, w u) ^ (P - 1) * ∫⁻ u, w u * g u ^ P := by
  rcases eq_or_lt_of_le hP with hP1 | hP1
  · simp [← hP1]
  have hP0 : 0 < P := lt_trans one_pos hP1
  have hPm : 0 < P - 1 := sub_pos.mpr hP1
  set Q := P / (P - 1) with hQ
  have hQ0 : 0 < Q := div_pos hP0 hPm
  have hconj : Real.HolderConjugate Q P := ⟨by rw [hQ]; field_simp; ring, hQ0, hP0⟩
  have hinv : 1 / Q + 1 / P = 1 := by rw [hQ]; field_simp; ring
  have hsplit : ∀ u, w u ^ (1 / Q) * (w u ^ (1 / P) * g u) = w u * g u := by
    intro u
    rw [← mul_assoc, ← ENNReal.rpow_add_of_nonneg (1 / Q) (1 / P) (by positivity) (by positivity),
      hinv, ENNReal.rpow_one]
  have hol := ENNReal.lintegral_mul_le_Lp_mul_Lq volume hconj
    (hw.pow_const (1 / Q)) ((hw.pow_const (1 / P)).mul hg)
  simp only [Pi.mul_apply, hsplit] at hol
  have hA : ∫⁻ u, (w u ^ (1 / Q)) ^ Q = ∫⁻ u, w u := by
    congr 1
    funext u
    rw [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hQ0.ne', ENNReal.rpow_one]
  have hB : ∫⁻ u, (w u ^ (1 / P) * g u) ^ P = ∫⁻ u, w u * g u ^ P := by
    congr 1
    funext u
    rw [ENNReal.mul_rpow_of_nonneg _ _ hP0.le, ← ENNReal.rpow_mul, one_div,
      inv_mul_cancel₀ hP0.ne', ENNReal.rpow_one]
  rw [hA, hB] at hol
  have hraise := ENNReal.rpow_le_rpow hol hP0.le
  rw [ENNReal.mul_rpow_of_nonneg _ _ hP0.le, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul] at hraise
  have he1 : 1 / P * P = 1 := by field_simp
  have he2 : 1 / Q * P = P - 1 := by rw [hQ]; field_simp
  rw [he1, he2, ENNReal.rpow_one] at hraise
  exact hraise

open MeasureTheory in
/-- The `L^p` bound for convolution against an integrable one-dimensional kernel:
`‖∫ k(u) G(u, ·) du‖_{L^p} ≤ ‖k‖_{L¹} · sup_u ‖G(u, ·)‖_{L^p}`. This is the form of
Minkowski's integral inequality used for the `L^s` bounds of blueprint
`lem:projection-properties`. -/
theorem eLpNorm_integral_kernel_le {p : ℝ≥0∞} (hp1 : 1 ≤ p) (hptop : p ≠ ⊤)
    {k : ℝ → ℂ} (hk : Integrable k) (hkc : Continuous k)
    {G : ℝ → E3 → ℂ} (hG : Continuous (Function.uncurry G)) {C : ℝ≥0∞}
    (hC : ∀ u, eLpNorm (G u) p volume ≤ C) :
    eLpNorm (fun x => ∫ u : ℝ, k u * G u x) p volume ≤ (∫⁻ u : ℝ, ‖k u‖ₑ) * C := by
  have hIntm : AEStronglyMeasurable (fun x => ∫ u : ℝ, k u * G u x) volume :=
    (show StronglyMeasurable (Function.uncurry fun x u => k u * G u x) from
      ((hkc.comp continuous_snd).mul (hG.comp
        continuous_swap)).stronglyMeasurable).integral_prod_right.aestronglyMeasurable
  have hp0 : p ≠ 0 := by intro h; rw [h] at hp1; exact absurd hp1 (by simp)
  have hP : 1 ≤ p.toReal := by
    rw [show (1 : ℝ) = (1 : ℝ≥0∞).toReal by simp]
    exact ENNReal.toReal_mono hptop hp1
  set P := p.toReal with hPdef
  have hP0 : 0 < P := lt_of_lt_of_le one_pos hP
  set M : ℝ≥0∞ := ∫⁻ u : ℝ, ‖k u‖ₑ with hM
  have hkm : AEMeasurable (fun u : ℝ => ‖k u‖ₑ) volume := hkc.measurable.enorm.aemeasurable
  have hMtop : M ≠ ⊤ := by rw [hM]; exact hk.hasFiniteIntegral.ne
  rcases eq_or_ne M 0 with hM0 | hM0
  · have hk0 : ∀ᵐ u : ℝ, k u = 0 := by
      have h := (lintegral_eq_zero_iff' hkm).mp hM0
      filter_upwards [h] with u hu
      simpa using hu
    have hzero : (fun x : E3 => ∫ u : ℝ, k u * G u x) = fun _ => 0 := by
      funext x
      refine integral_eq_zero_of_ae ?_
      filter_upwards [hk0] with u hu
      simp [hu]
    rw [hzero]
    simp
  rcases eq_or_ne C ⊤ with hCtop | hCtop
  · rw [hCtop, ENNReal.mul_top hM0]; exact le_top
  have hswap : Continuous fun z : E3 × ℝ => G z.2 z.1 := hG.comp continuous_swap
  have hmeas : Measurable fun z : E3 × ℝ => ‖k z.2‖ₑ * ‖G z.2 z.1‖ₑ ^ P :=
    ((hkc.measurable.comp measurable_snd).enorm).mul (hswap.measurable.enorm.pow_const P)
  have hconstne : (M ^ (P - 1) : ℝ≥0∞) ≠ ⊤ :=
    ENNReal.rpow_ne_top_of_nonneg (by linarith) hMtop
  have hCP : (C ^ P : ℝ≥0∞) ≠ ⊤ := ENNReal.rpow_ne_top_of_nonneg hP0.le hCtop
  have key : ∫⁻ x, ‖∫ u : ℝ, k u * G u x‖ₑ ^ P ∂volume ≤ (M * C) ^ P := by
    calc ∫⁻ x, ‖∫ u : ℝ, k u * G u x‖ₑ ^ P ∂volume
        ≤ ∫⁻ x, (∫⁻ u : ℝ, ‖k u‖ₑ * ‖G u x‖ₑ) ^ P ∂volume := by
          refine lintegral_mono fun x => ENNReal.rpow_le_rpow ?_ hP0.le
          refine le_trans (enorm_integral_le_lintegral_enorm _) (le_of_eq ?_)
          exact lintegral_congr fun u => by rw [enorm_mul]
      _ ≤ ∫⁻ x, M ^ (P - 1) * ∫⁻ u : ℝ, ‖k u‖ₑ * ‖G u x‖ₑ ^ P ∂volume :=
          lintegral_mono fun x => lintegral_weighted_rpow_le hP hkm
            ((hswap.measurable.comp measurable_prodMk_left).enorm.aemeasurable)
      _ = M ^ (P - 1) * ∫⁻ x, ∫⁻ u : ℝ, ‖k u‖ₑ * ‖G u x‖ₑ ^ P ∂volume :=
          lintegral_const_mul' _ _ hconstne
      _ = M ^ (P - 1) * ∫⁻ u : ℝ, ∫⁻ x, ‖k u‖ₑ * ‖G u x‖ₑ ^ P ∂volume := by
          rw [lintegral_lintegral_swap hmeas.aemeasurable]
      _ = M ^ (P - 1) * ∫⁻ u : ℝ, ‖k u‖ₑ * ∫⁻ x, ‖G u x‖ₑ ^ P ∂volume := by
          refine congrArg _ (lintegral_congr fun u => ?_)
          exact lintegral_const_mul' _ _ (by simp)
      _ ≤ M ^ (P - 1) * ∫⁻ _u : ℝ, ‖k _u‖ₑ * C ^ P := by
          gcongr with u
          have h1 := hC u
          rw [eLpNorm_eq_eLpNorm' hp0 hptop (by fun_prop), eLpNorm'] at h1
          have h2 := ENNReal.rpow_le_rpow h1 hP0.le
          rwa [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hP0.ne', ENNReal.rpow_one] at h2
      _ = M ^ (P - 1) * (M * C ^ P) := by
          rw [lintegral_mul_const' _ _ hCP]
      _ = (M * C) ^ P := by
          have h1 : M ^ (P - 1) * M = M ^ P := by
            nth_rewrite 2 [← ENNReal.rpow_one M]
            rw [← ENNReal.rpow_add _ _ hM0 hMtop]
            congr 1
            ring
          rw [ENNReal.mul_rpow_of_nonneg _ _ hP0.le, ← mul_assoc, h1]
  rw [eLpNorm_eq_eLpNorm' hp0 hptop (by fun_prop), eLpNorm']
  calc (∫⁻ x, ‖∫ u : ℝ, k u * G u x‖ₑ ^ P ∂volume) ^ (1 / P)
      ≤ ((M * C) ^ P) ^ (1 / P) := ENNReal.rpow_le_rpow key (by positivity)
    _ = M * C := by
        rw [← ENNReal.rpow_mul, mul_one_div, div_self hP0.ne', ENNReal.rpow_one]

open MeasureTheory in
/-- The total mass of the kernel equals `‖η̌‖_{L¹}`, in `ℝ≥0∞` form. -/
theorem lintegral_enorm_projKernel {R : ℝ} (hR : 0 < R) :
    (∫⁻ u : ℝ, ‖projKernel R u‖ₑ) = ENNReal.ofReal etaKerL1 := by
  rw [← ofReal_integral_norm_eq_lintegral_enorm (projKernel_integrable hR), projKernel_L1 hR]

open MeasureTheory in
@[fun_prop] theorem measurable_P {R : ℝ} (j : Fin 3) {f : E3 → ℂ} (hf : Measurable f) :
    Measurable (P R j f) := by
  have hm : Measurable (Function.uncurry fun (x : E3) (u : ℝ) =>
      projKernel R u * f (x - u • basisVec j)) :=
    ((projKernel_continuous R).measurable.comp measurable_snd).mul
      (hf.comp (measurable_fst.sub (measurable_snd.smul measurable_const)))
  exact hm.stronglyMeasurable.integral_prod_right'.measurable

open MeasureTheory in
/-- The projection of a continuous function is strongly measurable. -/
theorem stronglyMeasurable_P (R : ℝ) (j : Fin 3) {f : E3 → ℂ} (hf : Continuous f) :
    StronglyMeasurable (P R j f) := by
  have hcont : Continuous fun z : E3 × ℝ => projKernel R z.2 * f (z.1 - z.2 • basisVec j) :=
    (projKernel_continuous R).comp continuous_snd |>.mul
      (hf.comp (continuous_fst.sub (continuous_snd.smul continuous_const)))
  exact hcont.stronglyMeasurable.integral_prod_right'

open MeasureTheory in
/-- First bound of blueprint `lem:projection-properties`:
`‖P_R^{(j)} f‖_{L^s} ≤ ‖η̌‖_{L¹} ‖f‖_{L^s}`. -/
theorem eLpNorm_P_le {R : ℝ} (hR : 0 < R) (j : Fin 3) {f : E3 → ℂ} (hf : Continuous f)
    {p : ℝ≥0∞} (hp1 : 1 ≤ p) (hptop : p ≠ ⊤) :
    eLpNorm (P R j f) p volume ≤ ENNReal.ofReal etaKerL1 * eLpNorm f p volume := by
  have hGc : Continuous (Function.uncurry fun (u : ℝ) (x : E3) => f (x - u • basisVec j)) :=
    hf.comp (continuous_snd.sub (continuous_fst.smul continuous_const))
  have hC : ∀ u : ℝ, eLpNorm (fun x : E3 => f (x - u • basisVec j)) p volume
      = eLpNorm f p volume := by
    intro u
    have h := eLpNorm_comp_add_right hf (-(u • basisVec j)) p
    simpa [sub_eq_add_neg] using h
  have h := eLpNorm_integral_kernel_le (p := p) hp1 hptop (projKernel_integrable hR)
    (projKernel_continuous R) hGc (C := eLpNorm f p volume) (fun u => (hC u).le)
  rwa [lintegral_enorm_projKernel hR] at h

open MeasureTheory in
/-- Second bound of blueprint `lem:projection-properties`:
`‖Q_R^{(j)} f‖_{L^s} ≤ C_η ‖f‖_{L^s}`. -/
theorem eLpNorm_Q_le {R : ℝ} (hR : 0 < R) (j : Fin 3) {f : E3 → ℂ} (hf : Continuous f)
    {p : ℝ≥0∞} (hp1 : 1 ≤ p) (hptop : p ≠ ⊤) :
    eLpNorm (Q R j f) p volume ≤ ENNReal.ofReal Ceta * eLpNorm f p volume := by
  have h4R : (0 : ℝ) < 4 * R := by linarith
  have hsub : Q R j f = f - P (4 * R) j f := rfl
  have hle : eLpNorm (Q R j f) p volume
      ≤ eLpNorm f p volume + eLpNorm (P (4 * R) j f) p volume := by
    rw [hsub]
    exact eLpNorm_sub_le hp1
  have hCeta : ENNReal.ofReal (1 + etaKerL1) ≤ ENNReal.ofReal Ceta :=
    ENNReal.ofReal_le_ofReal (le_trans (le_max_right 1 (1 + etaKerL1)) (dyad_bounds _).1)
  calc eLpNorm (Q R j f) p volume
      ≤ eLpNorm f p volume + eLpNorm (P (4 * R) j f) p volume := hle
    _ ≤ 1 * eLpNorm f p volume + ENNReal.ofReal etaKerL1 * eLpNorm f p volume := by
        rw [one_mul]
        exact add_le_add le_rfl (eLpNorm_P_le h4R j hf hp1 hptop)
    _ = (1 + ENNReal.ofReal etaKerL1) * eLpNorm f p volume := by rw [add_mul]
    _ = ENNReal.ofReal (1 + etaKerL1) * eLpNorm f p volume := by
        rw [ENNReal.ofReal_add (by norm_num) etaKerL1_nonneg, ENNReal.ofReal_one]
    _ ≤ ENNReal.ofReal Ceta * eLpNorm f p volume := by gcongr


/-- The real inner product on `ℝ` is multiplication. -/
theorem inner_real_eq_mul (a b : ℝ) : (inner ℝ a b : ℝ) = a * b := by
  simp [RCLike.inner_apply, mul_comm]

open MeasureTheory in
/-- The Fourier transform of the kernel is the rescaled cutoff: `𝓕 k_R (v) = η(v / R)`.
This is the identity behind the multiplier description of `P_R^{(j)}` in blueprint
`def:projection`. -/
theorem fourier_projKernel {R : ℝ} (hR : 0 < R) (v : ℝ) :
    𝓕 (projKernel R) v = (eta (v / R) : ℂ) := by
  have hstep : 𝓕 (projKernel R) v
      = ∫ u : ℝ, (fun w : ℝ => (𝐞 (-(w * (v / R))) : Circle) • ((R : ℂ) * etaKer w)) (R * u) := by
    rw [Real.fourier_eq]
    refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
    have harg : R * u * (v / R) = u * v := by field_simp
    simp only [inner_real_eq_mul, projKernel, harg]
  have hinner : ∫ w : ℝ, (𝐞 (-(w * (v / R))) : Circle) • ((R : ℂ) * etaKer w)
      = (R : ℂ) * 𝓕 etaKer (v / R) := by
    rw [Real.fourier_eq, ← integral_const_mul]
    refine integral_congr_ae (Filter.Eventually.of_forall fun w => ?_)
    simp only [inner_real_eq_mul, Circle.smul_def]
    ring
  rw [hstep, Measure.integral_comp_mul_left
      (fun w : ℝ => (𝐞 (-(w * (v / R))) : Circle) • ((R : ℂ) * etaKer w)) R,
    abs_of_pos (inv_pos.mpr hR), hinner, fourier_etaKer, Complex.real_smul]
  push_cast
  have hRC : (R : ℂ) ≠ 0 := by exact_mod_cast hR.ne'
  field_simp

open MeasureTheory in
/-- Translation invariance of the lower Lebesgue integral of `‖f‖`. -/
theorem lintegral_enorm_comp_add_right {f : E3 → ℂ} (hf : Continuous f) (c : E3) :
    (∫⁻ x : E3, ‖f (x + c)‖ₑ) = ∫⁻ x : E3, ‖f x‖ₑ :=
  (measurePreserving_add_right volume c).lintegral_comp hf.measurable.enorm

/-- `⟪u • eⱼ, ξ⟫ = u ξⱼ`. -/
theorem inner_smul_basisVec (u : ℝ) (j : Fin 3) (ξ : E3) :
    (inner ℝ (u • basisVec j) ξ : ℝ) = u * ξ j := by
  have hsingle : (u • basisVec j : E3) = EuclideanSpace.single j u := by
    ext k
    simp [basisVec, PiLp.single_apply]
  rw [hsingle, EuclideanSpace.inner_single_left]
  simp

open MeasureTheory in
/-- The Fourier transform turns a translation into a phase factor. -/
theorem fourier_comp_sub (f : E3 → ℂ) (c ξ : E3) :
    𝓕 (fun x => f (x - c)) ξ = (𝐞 (-(inner ℝ c ξ)) : Circle) • 𝓕 f ξ := by
  have h := VectorFourier.fourierIntegral_comp_add_right (𝐞) (volume : Measure E3)
    (innerₗ E3) f (-c)
  have hfun : (f ∘ fun v : E3 => v + -c) = fun x => f (x - c) := by
    funext x; simp [sub_eq_add_neg]
  rw [hfun] at h
  have h2 := congrFun h ξ
  have harg : ((innerₗ E3) (-c) ξ : ℝ) = -(inner ℝ c ξ) := by simp
  rw [harg] at h2
  exact h2

open MeasureTheory in
/-- Joint integrability of the convolution integrand; this is the hypothesis of Fubini's
theorem in the multiplier identity for `P_R^{(j)}`. -/
theorem integrable_kernel_prod {k : ℝ → ℂ} (hk : Integrable k) (hkc : Continuous k)
    {f : E3 → ℂ} (hf : Continuous f) (hfi : Integrable f) (j : Fin 3) :
    Integrable (Function.uncurry fun (x : E3) (u : ℝ) => k u * f (x - u • basisVec j))
      (volume.prod volume) := by
  have hcont : Continuous (Function.uncurry fun (x : E3) (u : ℝ) =>
      k u * f (x - u • basisVec j)) :=
    (hkc.comp continuous_snd).mul
      (hf.comp (continuous_fst.sub (continuous_snd.smul continuous_const)))
  refine ⟨hcont.aestronglyMeasurable, ?_⟩
  rw [hasFiniteIntegral_iff_enorm]
  have hinner : ∀ u : ℝ, (∫⁻ x : E3, ‖k u‖ₑ * ‖f (x - u • basisVec j)‖ₑ)
      = ‖k u‖ₑ * ∫⁻ x : E3, ‖f x‖ₑ := by
    intro u
    rw [lintegral_const_mul' _ _ (by simp)]
    congr 1
    have h := lintegral_enorm_comp_add_right hf (-(u • basisVec j))
    simpa [sub_eq_add_neg] using h
  have hEq : (∫⁻ z : E3 × ℝ, ‖Function.uncurry
        (fun (x : E3) (u : ℝ) => k u * f (x - u • basisVec j)) z‖ₑ ∂(volume.prod volume))
      = (∫⁻ u : ℝ, ‖k u‖ₑ) * ∫⁻ x : E3, ‖f x‖ₑ := by
    rw [lintegral_prod _ hcont.measurable.enorm.aemeasurable]
    simp only [Function.uncurry_apply_pair, enorm_mul]
    have hm2 : AEMeasurable (Function.uncurry
        fun (x : E3) (u : ℝ) => ‖k u‖ₑ * ‖f (x - u • basisVec j)‖ₑ) (volume.prod volume) := by
      have hrw : (Function.uncurry fun (x : E3) (u : ℝ) => ‖k u‖ₑ * ‖f (x - u • basisVec j)‖ₑ)
          = fun z => ‖Function.uncurry
            (fun (x : E3) (u : ℝ) => k u * f (x - u • basisVec j)) z‖ₑ := by
        funext z; simp [Function.uncurry, enorm_mul]
      rw [hrw]
      exact hcont.measurable.enorm.aemeasurable
    rw [lintegral_lintegral_swap hm2]
    simp only [hinner]
    rw [lintegral_mul_const' _ _ hfi.hasFiniteIntegral.ne]
  rw [hEq]
  exact ENNReal.mul_lt_top hk.hasFiniteIntegral hfi.hasFiniteIntegral

open MeasureTheory in
/-- The multiplier identity behind blueprint `def:projection`:
`𝓕 (P_R^{(j)} f) ξ = η(ξ_j / R) · 𝓕 f ξ`. -/
theorem fourier_P {R : ℝ} (hR : 0 < R) (j : Fin 3) {f : E3 → ℂ} (hf : Continuous f)
    (hfi : Integrable f) (ξ : E3) :
    𝓕 (P R j f) ξ = (eta (ξ j / R) : ℂ) * 𝓕 f ξ := by
  have hkc : Continuous (projKernel R) := projKernel_continuous R
  have hki : Integrable (projKernel R) := projKernel_integrable hR
  have hbase : Continuous fun z : E3 × ℝ => projKernel R z.2 * f (z.1 - z.2 • basisVec j) :=
    (hkc.comp continuous_snd).mul
      (hf.comp (continuous_fst.sub (continuous_snd.smul continuous_const)))
  have hphase : Continuous fun z : E3 × ℝ => (𝐞 (-(inner ℝ z.1 ξ)) : Circle) :=
    Real.continuous_fourierChar.comp (by fun_prop)
  have hcont : Continuous (Function.uncurry fun (x : E3) (u : ℝ) =>
      (𝐞 (-(inner ℝ x ξ)) : Circle) • (projKernel R u * f (x - u • basisVec j))) :=
    hphase.smul hbase
  have hswapint : Integrable (Function.uncurry fun (x : E3) (u : ℝ) =>
      (𝐞 (-(inner ℝ x ξ)) : Circle) • (projKernel R u * f (x - u • basisVec j)))
      (volume.prod volume) := by
    refine ⟨hcont.aestronglyMeasurable,
      (integrable_kernel_prod hki hkc hf hfi j).hasFiniteIntegral.congr' ?_⟩
    filter_upwards with z
    simp [Function.uncurry]
  calc 𝓕 (P R j f) ξ
      = ∫ x : E3, ∫ u : ℝ,
          (𝐞 (-(inner ℝ x ξ)) : Circle) • (projKernel R u * f (x - u • basisVec j)) := by
        rw [Real.fourier_eq]
        refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
        change (𝐞 (-(inner ℝ x ξ)) : Circle) • P R j f x
            = ∫ u : ℝ, (𝐞 (-(inner ℝ x ξ)) : Circle) • (projKernel R u * f (x - u • basisVec j))
        simp only [Circle.smul_def, smul_eq_mul]
        rw [integral_const_mul]
        rfl
    _ = ∫ u : ℝ, ∫ x : E3,
          (𝐞 (-(inner ℝ x ξ)) : Circle) • (projKernel R u * f (x - u • basisVec j)) :=
        integral_integral_swap hswapint
    _ = ∫ u : ℝ, projKernel R u
          * ((𝐞 (-(inner ℝ (u • basisVec j) ξ)) : Circle) • 𝓕 f ξ) := by
        refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
        have hpull : ∀ x : E3,
            (𝐞 (-(inner ℝ x ξ)) : Circle) • (projKernel R u * f (x - u • basisVec j))
              = projKernel R u
                * ((𝐞 (-(inner ℝ x ξ)) : Circle) • f (x - u • basisVec j)) := by
          intro x
          rw [Circle.smul_def, Circle.smul_def]
          ring
        simp only [hpull]
        rw [integral_const_mul]
        congr 1
        rw [← fourier_comp_sub f (u • basisVec j) ξ, Real.fourier_eq]
    _ = (∫ u : ℝ, (𝐞 (-(inner ℝ u (ξ j))) : Circle) • projKernel R u) * 𝓕 f ξ := by
        rw [← integral_mul_const]
        refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
        simp only [inner_smul_basisVec, inner_real_eq_mul, Circle.smul_def]
        ring
    _ = (eta (ξ j / R) : ℂ) * 𝓕 f ξ := by
        rw [← Real.fourier_eq, fourier_projKernel hR]

open MeasureTheory in
/-- The projection of a continuous integrable function is integrable. -/
theorem integrable_P {R : ℝ} (hR : 0 < R) (j : Fin 3) {f : E3 → ℂ} (hf : Continuous f)
    (hfi : Integrable f) : Integrable (P R j f) :=
  (integrable_kernel_prod (projKernel_integrable hR) (projKernel_continuous R)
    hf hfi j).integral_prod_left

open MeasureTheory in
/-- The projection of a bounded continuous function is continuous. Schwartz functions, the
setting of the blueprint, are bounded and continuous. -/
theorem continuous_P {R : ℝ} (hR : 0 < R) (j : Fin 3) {f : E3 → ℂ} (hf : Continuous f)
    {Cf : ℝ} (hfb : ∀ x, ‖f x‖ ≤ Cf) : Continuous (P R j f) := by
  change Continuous fun x : E3 => ∫ u : ℝ, projKernel R u * f (x - u • basisVec j)
  refine continuous_of_dominated (bound := fun u : ℝ => ‖projKernel R u‖ * Cf) ?_ ?_ ?_ ?_
  · intro x
    exact ((projKernel_continuous R).mul
      (hf.comp (continuous_const.sub (continuous_id.smul continuous_const)))).aestronglyMeasurable
  · intro x
    filter_upwards with u
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (hfb _) (norm_nonneg _)
  · exact (projKernel_integrable hR).norm.mul_const Cf
  · filter_upwards with u
    exact continuous_const.mul (hf.comp (continuous_id.sub continuous_const))

open MeasureTheory in
/-- Sharp form of the vanishing statement: the multiplier `η(ξ_j / R)` is supported in
`|ξ_j| < R/2`, so `P_R^{(j)} f = 0` already when `supp 𝓕f ⊆ {|ξ_j| ≥ R/2}`. The blueprint
states the two special cases `P_eq_zero_of_fourier_support` and
`Q_eq_self_of_fourier_support`. -/
theorem P_eq_zero_of_fourier_support_sharp {R : ℝ} (hR : 0 < R) (j : Fin 3) {f : E3 → ℂ}
    (hf : Continuous f) (hfi : Integrable f) {Cf : ℝ} (hfb : ∀ x, ‖f x‖ ≤ Cf)
    (hsupp : Function.support (𝓕 f) ⊆ {ξ : E3 | R / 2 ≤ |ξ j|}) :
    P R j f = 0 := by
  have hzero : 𝓕 (P R j f) = 0 := by
    funext ξ
    rw [fourier_P hR j hf hfi]
    rcases lt_or_ge |ξ j| (R / 2) with hlt | hge
    · have hfz : 𝓕 f ξ = 0 := by
        by_contra h
        exact absurd (hsupp h) (by simpa using not_le.mpr hlt)
      simp [hfz]
    · have hez : eta (ξ j / R) = 0 := by
        refine eta_eq_zero ?_
        rw [abs_div, abs_of_pos hR, le_div_iff₀ hR]
        linarith
      simp [hez]
  have hPc : Continuous (P R j f) := continuous_P hR j hf hfb
  have hPi : Integrable (P R j f) := integrable_P hR j hf hfi
  have hinv := hPc.fourierInv_fourier_eq hPi (by rw [hzero]; exact integrable_zero _ _ _)
  rw [← hinv, hzero]
  funext x
  simp [Real.fourierInv_eq]

open MeasureTheory in
/-- Blueprint `lem:projection-properties`, third statement: if `supp 𝓕f ⊆ {|ξ_j| ≥ R}` then
`P_R^{(j)} f = 0`. -/
theorem P_eq_zero_of_fourier_support {R : ℝ} (hR : 0 < R) (j : Fin 3) {f : E3 → ℂ}
    (hf : Continuous f) (hfi : Integrable f) {Cf : ℝ} (hfb : ∀ x, ‖f x‖ ≤ Cf)
    (hsupp : Function.support (𝓕 f) ⊆ {ξ : E3 | R ≤ |ξ j|}) :
    P R j f = 0 := by
  refine P_eq_zero_of_fourier_support_sharp hR j hf hfi hfb fun ξ hx => ?_
  have h := hsupp hx
  simp only [Set.mem_ofPred_eq] at h ⊢
  linarith

open MeasureTheory in
/-- Blueprint `lem:projection-properties`, fourth statement: if `supp 𝓕f ⊆ {|ξ_j| ≥ 2R}` then
`Q_R^{(j)} f = f`. -/
theorem Q_eq_self_of_fourier_support {R : ℝ} (hR : 0 < R) (j : Fin 3) {f : E3 → ℂ}
    (hf : Continuous f) (hfi : Integrable f) {Cf : ℝ} (hfb : ∀ x, ‖f x‖ ≤ Cf)
    (hsupp : Function.support (𝓕 f) ⊆ {ξ : E3 | 2 * R ≤ |ξ j|}) :
    Q R j f = f := by
  have h4R : (0 : ℝ) < 4 * R := by linarith
  have hP : P (4 * R) j f = 0 := by
    refine P_eq_zero_of_fourier_support_sharp h4R j hf hfi hfb fun ξ hx => ?_
    have h := hsupp hx
    simp only [Set.mem_ofPred_eq] at h ⊢
    linarith
  funext x
  rw [show Q R j f x = f x - P (4 * R) j f x from rfl, hP]
  simp

open MeasureTheory in
/-- The multiplier of `Q_R^{(j)}` is `1 - η(ξ_j / (4R))`. -/
theorem fourier_Q {R : ℝ} (hR : 0 < R) (j : Fin 3) {f : E3 → ℂ} (hf : Continuous f)
    (hfi : Integrable f) (ξ : E3) :
    𝓕 (Q R j f) ξ = (1 - (eta (ξ j / (4 * R)) : ℂ)) * 𝓕 f ξ := by
  have h4R : (0 : ℝ) < 4 * R := by linarith
  have hPi : Integrable (P (4 * R) j f) := integrable_P h4R j hf hfi
  have hsub : 𝓕 (Q R j f) ξ = 𝓕 f ξ - 𝓕 (P (4 * R) j f) ξ := by
    rw [Real.fourier_eq, Real.fourier_eq, Real.fourier_eq,
      ← integral_sub ((Real.fourierIntegral_convergent_iff ξ).2 hfi)
        ((Real.fourierIntegral_convergent_iff ξ).2 hPi)]
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    change (𝐞 (-(inner ℝ x ξ)) : Circle) • Q R j f x
        = (𝐞 (-(inner ℝ x ξ)) : Circle) • f x - (𝐞 (-(inner ℝ x ξ)) : Circle) • P (4 * R) j f x
    rw [show Q R j f x = f x - P (4 * R) j f x from rfl]
    simp only [Circle.smul_def, smul_eq_mul]
    ring
  rw [hsub, fourier_P h4R j hf hfi]
  ring

open MeasureTheory in
/-- Blueprint `lem:projection-properties`, last statement:
`supp 𝓕(Q_R^{(j)} f) ⊆ {|ξ_j| ≥ R}`. -/
theorem support_fourier_Q {R : ℝ} (hR : 0 < R) (j : Fin 3) {f : E3 → ℂ} (hf : Continuous f)
    (hfi : Integrable f) :
    Function.support (𝓕 (Q R j f)) ⊆ {ξ : E3 | R ≤ |ξ j|} := by
  intro ξ hξ
  by_contra hcon
  simp only [Set.mem_ofPred_eq, not_le] at hcon
  have h4R : (0 : ℝ) < 4 * R := by linarith
  have hone : eta (ξ j / (4 * R)) = 1 := by
    refine eta_eq_one ?_
    rw [abs_div, abs_of_pos h4R, div_le_iff₀ h4R]
    linarith
  exact hξ (by rw [fourier_Q hR j hf hfi, hone]; push_cast; ring)

open MeasureTheory in
theorem etaKer_eq_fourierInv : etaKer = 𝓕⁻ fun t : ℝ => (eta t : ℂ) :=
  SchwartzMap.fourierInv_coe etaS

open MeasureTheory in
/-- The kernel profile is Hermitian, because the cutoff `η` is real-valued:
`conj (η̌ w) = η̌ (-w)`. -/
theorem etaKer_hermitian (w : ℝ) : conj (etaKer w) = etaKer (-w) := by
  rw [etaKer_eq_fourierInv, Real.fourierInv_eq, Real.fourierInv_eq, ← integral_conj]
  refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
  simp only [Circle.smul_def, smul_eq_mul, map_mul, Circle.starRingEnd_addChar,
    inner_real_eq_mul, Complex.conj_ofReal]
  congr 2
  congr 1
  ring

/-- The convolution kernel is Hermitian; blueprint `lem:projection-properties`. -/
theorem projKernel_hermitian (R u : ℝ) :
    conj (projKernel R u) = projKernel R (-u) := by
  simp only [projKernel, map_mul, Complex.conj_ofReal, etaKer_hermitian]
  congr 2
  ring

open MeasureTheory in
open MeasureTheory in
/-- Integrability on the product from a bound of the form `‖f y‖ ‖k u‖ C`. -/
theorem integrable_prod_of_bound {F : E3 × ℝ → ℂ}
    (hF : AEStronglyMeasurable F (volume.prod volume))
    {f : E3 → ℂ} (hfi : Integrable f) {k : ℝ → ℂ} (hki : Integrable k) {C : ℝ} (_hC : 0 ≤ C)
    (hbound : ∀ z : E3 × ℝ, ‖F z‖ ≤ ‖f z.1‖ * ‖k z.2‖ * C) :
    Integrable F (volume.prod volume) := by
  refine ⟨hF, ?_⟩
  rw [hasFiniteIntegral_iff_enorm]
  have hmono : ∀ z : E3 × ℝ, ‖F z‖ₑ ≤ ‖f z.1‖ₑ * ‖k z.2‖ₑ * ENNReal.ofReal C := by
    intro z
    rw [← ofReal_norm, ← ofReal_norm, ← ofReal_norm,
      ← ENNReal.ofReal_mul (norm_nonneg _), ← ENNReal.ofReal_mul (by positivity)]
    exact ENNReal.ofReal_le_ofReal (hbound z)
  calc ∫⁻ z : E3 × ℝ, ‖F z‖ₑ ∂(volume.prod volume)
      ≤ ∫⁻ z : E3 × ℝ, ‖f z.1‖ₑ * ‖k z.2‖ₑ * ENNReal.ofReal C ∂(volume.prod volume) :=
        lintegral_mono hmono
    _ = (∫⁻ x : E3, ‖f x‖ₑ) * (∫⁻ u : ℝ, ‖k u‖ₑ) * ENNReal.ofReal C := by
        rw [lintegral_mul_const' _ _ ENNReal.ofReal_ne_top,
          lintegral_prod_mul hfi.aestronglyMeasurable.enorm hki.aestronglyMeasurable.enorm]
    _ < ⊤ :=
        ENNReal.mul_lt_top
          (ENNReal.mul_lt_top hfi.hasFiniteIntegral hki.hasFiniteIntegral) ENNReal.ofReal_lt_top

open MeasureTheory in
/-- The `L²` pairing against `P_R^{(j)} f`, written through the parameter integral. -/
theorem pairing_P_left {R : ℝ} (hR : 0 < R) (j : Fin 3) {f g : E3 → ℂ}
    (hf : Continuous f) (hfi : Integrable f) (hg : Measurable g) {Cg : ℝ}
    (hgb : ∀ x, ‖g x‖ ≤ Cg) :
    (∫ x : E3, P R j f x * conj (g x))
      = ∫ u : ℝ, projKernel R u * ∫ y : E3, f y * conj (g (y + u • basisVec j)) := by
  have hkc : Continuous (projKernel R) := projKernel_continuous R
  have hki : Integrable (projKernel R) := projKernel_integrable hR
  have hCg : 0 ≤ Cg := le_trans (norm_nonneg _) (hgb 0)
  have hint1 : Integrable (Function.uncurry fun (x : E3) (u : ℝ) =>
      projKernel R u * f (x - u • basisVec j) * conj (g x)) (volume.prod volume) := by
    refine Integrable.mono' ((integrable_kernel_prod hki hkc hf hfi j).norm.mul_const Cg)
      (Measurable.aestronglyMeasurable (by fun_prop)) ?_
    filter_upwards with z
    have hz : ‖Function.uncurry (fun (x : E3) (u : ℝ) =>
        projKernel R u * f (x - u • basisVec j) * conj (g x)) z‖
        = ‖Function.uncurry (fun (x : E3) (u : ℝ) =>
            projKernel R u * f (x - u • basisVec j)) z‖ * ‖g z.1‖ := by
      simp [Function.uncurry]
    rw [hz]
    exact mul_le_mul_of_nonneg_left (hgb z.1) (norm_nonneg _)
  calc (∫ x : E3, P R j f x * conj (g x))
      = ∫ x : E3, ∫ u : ℝ, projKernel R u * f (x - u • basisVec j) * conj (g x) := by
        refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
        change P R j f x * conj (g x)
            = ∫ u : ℝ, projKernel R u * f (x - u • basisVec j) * conj (g x)
        rw [show P R j f x = ∫ u : ℝ, projKernel R u * f (x - u • basisVec j) from rfl,
          ← integral_mul_const]
    _ = ∫ u : ℝ, ∫ x : E3, projKernel R u * f (x - u • basisVec j) * conj (g x) :=
        integral_integral_swap hint1
    _ = ∫ u : ℝ, projKernel R u * ∫ y : E3, f y * conj (g (y + u • basisVec j)) := by
        refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
        have hpull : (∫ x : E3, projKernel R u * f (x - u • basisVec j) * conj (g x))
            = projKernel R u * ∫ x : E3, f (x - u • basisVec j) * conj (g x) := by
          rw [← integral_const_mul]
          exact integral_congr_ae (Filter.Eventually.of_forall fun x => by ring)
        change (∫ x : E3, projKernel R u * f (x - u • basisVec j) * conj (g x))
            = projKernel R u * ∫ y : E3, f y * conj (g (y + u • basisVec j))
        rw [hpull]
        congr 1
        have h := integral_add_right_eq_self (μ := (volume : Measure E3))
          (fun x : E3 => f (x - u • basisVec j) * conj (g x)) (u • basisVec j)
        simpa using h.symm

open MeasureTheory in
/-- The `L²` pairing of `f` against `P_R^{(j)} g`, written through the same parameter integral.
This is where the Hermitian symmetry of the kernel enters. -/
theorem pairing_P_right {R : ℝ} (hR : 0 < R) (j : Fin 3) {f g : E3 → ℂ}
    (hf : Continuous f) (hfi : Integrable f) (hg : Measurable g) {Cg : ℝ}
    (hgb : ∀ x, ‖g x‖ ≤ Cg) :
    (∫ y : E3, f y * conj (P R j g y))
      = ∫ u : ℝ, projKernel R u * ∫ y : E3, f y * conj (g (y + u • basisVec j)) := by
  have hkc : Continuous (projKernel R) := projKernel_continuous R
  have hki : Integrable (projKernel R) := projKernel_integrable hR
  have hCg : 0 ≤ Cg := le_trans (norm_nonneg _) (hgb 0)
  have hint2 : Integrable (Function.uncurry fun (y : E3) (u : ℝ) =>
      f y * (conj (projKernel R u) * conj (g (y - u • basisVec j)))) (volume.prod volume) := by
    refine integrable_prod_of_bound (Measurable.aestronglyMeasurable (by fun_prop))
      hfi hki hCg ?_
    intro z
    simp only [Function.uncurry, norm_mul, RCLike.norm_conj]
    rw [← mul_assoc]
    exact mul_le_mul_of_nonneg_left (hgb _) (by positivity)
  calc (∫ y : E3, f y * conj (P R j g y))
      = ∫ y : E3, ∫ u : ℝ,
          f y * (conj (projKernel R u) * conj (g (y - u • basisVec j))) := by
        refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
        change f y * conj (P R j g y)
            = ∫ u : ℝ, f y * (conj (projKernel R u) * conj (g (y - u • basisVec j)))
        rw [integral_const_mul]
        congr 1
        rw [show P R j g y = ∫ u : ℝ, projKernel R u * g (y - u • basisVec j) from rfl,
          ← integral_conj]
        exact integral_congr_ae (Filter.Eventually.of_forall fun u => by simp only [map_mul])
    _ = ∫ u : ℝ, ∫ y : E3,
          f y * (conj (projKernel R u) * conj (g (y - u • basisVec j))) :=
        integral_integral_swap hint2
    _ = ∫ u : ℝ, projKernel R u * ∫ y : E3, f y * conj (g (y + u • basisVec j)) := by
        have hstep : ∀ u : ℝ,
            (∫ y : E3, f y * (conj (projKernel R u) * conj (g (y - u • basisVec j))))
              = projKernel R (-u) * ∫ y : E3, f y * conj (g (y + (-u) • basisVec j)) := by
          intro u
          rw [← projKernel_hermitian, ← integral_const_mul]
          refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
          change f y * (conj (projKernel R u) * conj (g (y - u • basisVec j)))
              = conj (projKernel R u) * (f y * conj (g (y + (-u) • basisVec j)))
          rw [neg_smul, ← sub_eq_add_neg]
          ring
        simp only [hstep]
        exact integral_neg_eq_self (fun v : ℝ => projKernel R v
          * ∫ y : E3, f y * conj (g (y + v • basisVec j))) volume

open MeasureTheory in
/-- Blueprint `lem:projection-properties`, fifth statement: `P_R^{(j)}` is self-adjoint for the
`L²` pairing `⟪u, v⟫ = ∫ u · conj v`. The blueprint derives this from Plancherel and the
real-valuedness of the multiplier; the equivalent Lean route used here is the Hermitian symmetry
of the convolution kernel, `projKernel_hermitian`. -/
theorem P_self_adjoint {R : ℝ} (hR : 0 < R) (j : Fin 3) {f g : E3 → ℂ}
    (hf : Continuous f) (hfi : Integrable f) (hg : Measurable g) {Cg : ℝ}
    (hgb : ∀ x, ‖g x‖ ≤ Cg) :
    (∫ x : E3, P R j f x * conj (g x)) = ∫ x : E3, f x * conj (P R j g x) := by
  rw [pairing_P_left hR j hf hfi hg hgb, pairing_P_right hR j hf hfi hg hgb]

/-! ## The four-linear form and its adjoints -/

open MeasureTheory in
/-- The four-linear form `Λ_N(f₀, f₁, f₂, f₃) = ⟪A_N(f₁,f₂,f₃), f₀⟫_{L²}`;
blueprint `def:adjoint`. -/
noncomputable def Lambda (N : ℝ) (f0 : E3 → ℂ) (f : Fin 3 → E3 → ℂ) : ℂ :=
  ∫ x : E3, A N f x * conj (f0 x)

/-- The integrand of the adjoint `A_N^{*j}`; blueprint `def:adjoint`. -/
noncomputable def adjShift (j : Fin 3) (f0 : E3 → ℂ) (f : Fin 3 → E3 → ℂ) (y : E3) (t : ℝ) : ℂ :=
  f0 (y - curve j t) * ∏ i ∈ Finset.univ.erase j, conj (f i (y - curve j t + curve i t))

/-- The adjoint `A_N^{*j}` of blueprint `def:adjoint`. -/
noncomputable def Astar (N : ℝ) (j : Fin 3) (f0 : E3 → ℂ) (f : Fin 3 → E3 → ℂ) (y : E3) : ℂ :=
  (N : ℂ)⁻¹ * ∫ t in (0 : ℝ)..N, adjShift j f0 f y t

open MeasureTheory in
@[fun_prop] theorem measurable_Astar {N : ℝ} (j : Fin 3) {f0 : E3 → ℂ} (hf0 : Measurable f0)
    {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Measurable (f i)) : Measurable (Astar N j f0 f) := by
  have hcm : Measurable (curve j) := (continuous_curve j).measurable
  have hadjm : Measurable fun z : E3 × ℝ => adjShift j f0 f z.1 z.2 := by
    simp only [adjShift]
    have hc0 : Measurable fun z : E3 × ℝ => z.1 - curve j z.2 :=
      measurable_fst.sub (hcm.comp measurable_snd)
    refine (hf0.comp hc0).mul (Finset.measurable_prod _ fun i _ => ?_)
    exact Complex.continuous_conj.measurable.comp ((hf i).comp
      (hc0.add (((continuous_curve i).measurable).comp measurable_snd)))
  unfold Astar
  refine measurable_const.mul ?_
  simp only [intervalIntegral]
  exact ((hadjm.stronglyMeasurable.integral_prod_right'
    (ν := volume.restrict (Set.Ioc 0 N))).measurable).sub
    ((hadjm.stronglyMeasurable.integral_prod_right'
      (ν := volume.restrict (Set.Ioc N 0))).measurable)

/-- Splitting off the `j`-th factor of the average integrand; this is the algebraic step in the
proof of blueprint `lem:adjoint-identity`. -/
theorem prodShift_eq_mul_erase (f : Fin 3 → E3 → ℂ) (x : E3) (t : ℝ) (j : Fin 3) :
    prodShift f x t
      = f j (x + curve j t) * ∏ i ∈ Finset.univ.erase j, f i (x + curve i t) := by
  rw [prodShift]
  exact (Finset.mul_prod_erase Finset.univ (fun i => f i (x + curve i t))
    (Finset.mem_univ j)).symm

/-- The conjugate of the adjoint integrand, after the translation `y = x + t^j e_j`, recovers
the average integrand paired with `f₀`; blueprint `lem:adjoint-identity`. -/
theorem conj_adjShift_translate (j : Fin 3) (f0 : E3 → ℂ) (f : Fin 3 → E3 → ℂ)
    (x : E3) (t : ℝ) :
    f j (x + curve j t) * conj (adjShift j f0 f (x + curve j t) t)
      = prodShift f x t * conj (f0 x) := by
  have hy : x + curve j t - curve j t = x := by abel
  rw [adjShift, hy, map_mul, map_prod]
  simp only [Complex.conj_conj]
  rw [prodShift_eq_mul_erase f x t j]
  ring

theorem continuous_adjShift {f0 : E3 → ℂ} (hf0 : Continuous f0) {f : Fin 3 → E3 → ℂ}
    (hf : ∀ i, Continuous (f i)) (j : Fin 3) (y : E3) :
    Continuous (adjShift j f0 f y) := by
  refine (hf0.comp (continuous_const.sub (continuous_curve j))).mul ?_
  refine continuous_finsetProd _ fun i _ => ?_
  exact Complex.continuous_conj.comp
    ((hf i).comp ((continuous_const.sub (continuous_curve j)).add (continuous_curve i)))

open MeasureTheory in
/-- Integrability on `ℝ³ × T` for a finite parameter measure, from a bound of the form
`C * ‖f₀ (x - c t)‖` with `f₀` integrable. Taking `c = 0` gives the unshifted bound. -/
theorem integrable_prod_of_bound_shift {ν : Measure ℝ} [IsFiniteMeasure ν] {F : E3 × ℝ → ℂ}
    (hF : AEStronglyMeasurable F (volume.prod ν))
    {f0 : E3 → ℂ} (hf0c : Continuous f0) (hf0 : Integrable f0) {C : ℝ} (hC : 0 ≤ C)
    {c : ℝ → E3} (hc : Continuous c)
    (hbound : ∀ z : E3 × ℝ, ‖F z‖ ≤ C * ‖f0 (z.1 - c z.2)‖) :
    Integrable F (volume.prod ν) := by
  refine ⟨hF, ?_⟩
  rw [hasFiniteIntegral_iff_enorm]
  have hmono : ∀ z : E3 × ℝ, ‖F z‖ₑ ≤ ENNReal.ofReal C * ‖f0 (z.1 - c z.2)‖ₑ := by
    intro z
    rw [← ofReal_norm, ← ofReal_norm, ← ENNReal.ofReal_mul hC]
    exact ENNReal.ofReal_le_ofReal (hbound z)
  have hmeas : Measurable fun z : E3 × ℝ => ‖f0 (z.1 - c z.2)‖ₑ :=
    (hf0c.comp (continuous_fst.sub (hc.comp continuous_snd))).measurable.enorm
  have hswap : (∫⁻ z : E3 × ℝ, ‖f0 (z.1 - c z.2)‖ₑ ∂(volume.prod ν))
      = (∫⁻ x : E3, ‖f0 x‖ₑ) * ν Set.univ := by
    rw [lintegral_prod _ hmeas.aemeasurable, lintegral_lintegral_swap hmeas.aemeasurable]
    have hinner : ∀ t : ℝ, (∫⁻ x : E3, ‖f0 (x - c t)‖ₑ) = ∫⁻ x : E3, ‖f0 x‖ₑ := by
      intro t
      have h := lintegral_enorm_comp_add_right hf0c (-(c t))
      simpa [sub_eq_add_neg] using h
    simp only [hinner]
    rw [lintegral_const]
  calc ∫⁻ z : E3 × ℝ, ‖F z‖ₑ ∂(volume.prod ν)
      ≤ ∫⁻ z : E3 × ℝ, ENNReal.ofReal C * ‖f0 (z.1 - c z.2)‖ₑ ∂(volume.prod ν) :=
        lintegral_mono hmono
    _ = ENNReal.ofReal C * ((∫⁻ x : E3, ‖f0 x‖ₑ) * ν Set.univ) := by
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, hswap]
    _ < ⊤ :=
        ENNReal.mul_lt_top ENNReal.ofReal_lt_top
          (ENNReal.mul_lt_top hf0.hasFiniteIntegral (measure_lt_top ν _))

/-- The average integrand is bounded by the cube of a uniform bound on the factors. -/
theorem norm_prodShift_le {f : Fin 3 → E3 → ℂ} {Cb : ℝ} (hfb : ∀ i x, ‖f i x‖ ≤ Cb)
    (x : E3) (t : ℝ) : ‖prodShift f x t‖ ≤ Cb ^ 3 := by
  rw [prodShift, norm_prod]
  calc ∏ i : Fin 3, ‖f i (x + curve i t)‖ ≤ ∏ _i : Fin 3, Cb :=
        Finset.prod_le_prod₀ (fun i _ => norm_nonneg (f i (x + curve i t)))
          (fun i _ => hfb i _)
    _ = Cb ^ 3 := by simp

/-- The adjoint integrand is bounded by `Cb² ‖f₀ (y - t^j e_j)‖`. -/
theorem norm_adjShift_le {f0 : E3 → ℂ} {f : Fin 3 → E3 → ℂ} {Cb : ℝ}
    (_hCb : 0 ≤ Cb) (hfb : ∀ i x, ‖f i x‖ ≤ Cb) (j : Fin 3) (y : E3) (t : ℝ) :
    ‖adjShift j f0 f y t‖ ≤ Cb ^ 2 * ‖f0 (y - curve j t)‖ := by
  rw [adjShift, norm_mul, norm_prod, mul_comm]
  refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg (f0 (y - curve j t)))
  calc ∏ i ∈ Finset.univ.erase j, ‖conj (f i (y - curve j t + curve i t))‖
      ≤ ∏ _i ∈ Finset.univ.erase j, Cb :=
        Finset.prod_le_prod₀
          (fun i _ => norm_nonneg (conj (f i (y - curve j t + curve i t))))
          (fun i _ => by rw [RCLike.norm_conj]; exact hfb i _)
    _ = Cb ^ 2 := by
        rw [Finset.prod_const, Finset.card_erase_of_mem (Finset.mem_univ j)]
        simp

open MeasureTheory in
/-- Blueprint `lem:adjoint-identity`:
`Λ_N(f₀, f₁, f₂, f₃) = ⟪f_j, A_N^{*j}((f_i)_{i≠j})⟫_{L²}`. -/
theorem adjoint_identity {N : ℝ} (hN : 0 < N) (j : Fin 3) {f0 : E3 → ℂ}
    (hf0 : Continuous f0) (hf0i : Integrable f0) {f : Fin 3 → E3 → ℂ}
    (hf : ∀ i, Continuous (f i)) {Cb : ℝ} (hCb : 0 ≤ Cb) (hfb : ∀ i x, ‖f i x‖ ≤ Cb) :
    Lambda N f0 f = ∫ y : E3, f j y * conj (Astar N j f0 f y) := by
  have : IsFiniteMeasure (volume.restrict (Set.Ioc (0 : ℝ) N)) :=
    ⟨by rw [Measure.restrict_apply_univ, Real.volume_Ioc]; exact ENNReal.ofReal_lt_top⟩
  set ν := volume.restrict (Set.Ioc (0 : ℝ) N) with hν
  have hcont1 : Continuous (Function.uncurry fun (x : E3) (t : ℝ) =>
      prodShift f x t * conj (f0 x)) := by
    have h1 : Continuous fun z : E3 × ℝ => prodShift f z.1 z.2 :=
      (continuous_uncurry_prodShift hf).comp continuous_swap
    exact h1.mul (Complex.continuous_conj.comp (hf0.comp continuous_fst))
  have hc0 : Continuous fun z : E3 × ℝ => z.1 - curve j z.2 :=
    continuous_fst.sub ((continuous_curve j).comp continuous_snd)
  have hadjc : Continuous fun z : E3 × ℝ => adjShift j f0 f z.1 z.2 := by
    simp only [adjShift]
    refine (hf0.comp hc0).mul (continuous_finsetProd _ fun i _ => ?_)
    exact Complex.continuous_conj.comp
      ((hf i).comp (hc0.add ((continuous_curve i).comp continuous_snd)))
  have hcont2 : Continuous (Function.uncurry fun (y : E3) (t : ℝ) =>
      f j y * conj (adjShift j f0 f y t)) :=
    ((hf j).comp continuous_fst).mul (Complex.continuous_conj.comp hadjc)
  have hint1 : Integrable (Function.uncurry fun (x : E3) (t : ℝ) =>
      prodShift f x t * conj (f0 x)) (volume.prod ν) := by
    refine integrable_prod_of_bound_shift hcont1.aestronglyMeasurable hf0 hf0i
      (pow_nonneg hCb 3) (c := fun _ : ℝ => (0 : E3)) continuous_const fun z => ?_
    simp only [Function.uncurry, norm_mul, RCLike.norm_conj, sub_zero]
    exact mul_le_mul_of_nonneg_right (norm_prodShift_le hfb z.1 z.2) (norm_nonneg _)
  have hint2 : Integrable (Function.uncurry fun (y : E3) (t : ℝ) =>
      f j y * conj (adjShift j f0 f y t)) (volume.prod ν) := by
    refine integrable_prod_of_bound_shift hcont2.aestronglyMeasurable hf0 hf0i
      (pow_nonneg hCb 3) (c := fun t : ℝ => curve j t) (continuous_curve j) fun z => ?_
    simp only [Function.uncurry, norm_mul, RCLike.norm_conj]
    calc ‖f j z.1‖ * ‖adjShift j f0 f z.1 z.2‖
        ≤ Cb * (Cb ^ 2 * ‖f0 (z.1 - curve j z.2)‖) :=
          mul_le_mul (hfb j z.1) (norm_adjShift_le hCb hfb j z.1 z.2) (norm_nonneg _) hCb
      _ = Cb ^ 3 * ‖f0 (z.1 - curve j z.2)‖ := by ring
  -- the left-hand side
  have hL : Lambda N f0 f
      = (N : ℂ)⁻¹ * ∫ t : ℝ, ∫ x : E3, prodShift f x t * conj (f0 x) ∂volume ∂ν := by
    have hstep : ∀ x : E3, A N f x * conj (f0 x)
        = (N : ℂ)⁻¹ * ∫ t : ℝ, prodShift f x t * conj (f0 x) ∂ν := by
      intro x
      rw [show A N f x = (N : ℂ)⁻¹ * ∫ t in (0 : ℝ)..N, prodShift f x t from rfl,
        intervalIntegral.integral_of_le hN.le, mul_assoc, ← hν, integral_mul_const]
    rw [Lambda, integral_congr_ae (Filter.Eventually.of_forall hstep), integral_const_mul,
      integral_integral_swap hint1]
  -- the right-hand side
  have hstep2 : ∀ y : E3, f j y * conj (Astar N j f0 f y)
      = (N : ℂ)⁻¹ * ∫ t : ℝ, f j y * conj (adjShift j f0 f y t) ∂ν := by
    intro y
    have hA : conj (Astar N j f0 f y)
        = (N : ℂ)⁻¹ * ∫ t : ℝ, conj (adjShift j f0 f y t) ∂ν := by
      rw [Astar, intervalIntegral.integral_of_le hN.le, ← hν, map_mul, ← integral_conj]
      congr 1
      rw [map_inv₀, Complex.conj_ofReal]
    rw [hA, integral_const_mul]
    ring
  have hR2 : (∫ t : ℝ, ∫ y : E3, f j y * conj (adjShift j f0 f y t) ∂volume ∂ν)
      = ∫ t : ℝ, ∫ x : E3, prodShift f x t * conj (f0 x) ∂volume ∂ν := by
    refine integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
