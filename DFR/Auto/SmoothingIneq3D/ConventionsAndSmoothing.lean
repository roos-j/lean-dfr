theorem normalized_endpoint (j : Fin 3) (HA : KoszAdjoint j) (HS : KoszSubunitScaleOne j)
    {pv : Fin 3 → ℝ} (hpv : ∀ i, 1 < pv i) (hsum : ∑ i, (pv i)⁻¹ = 1) :
    ∃ γ C : ℝ, γ ∈ Set.Ioo (0 : ℝ) 1 ∧ 0 < C ∧
      ∀ N μ : ℝ, 0 < N → μ ∈ Set.Ioc (0 : ℝ) 1 →
        ∀ f : Fin 3 → E3 → ℂ, (∀ i, Nice (f i)) →
        Function.support (𝓕 (f j)) ⊆ {ξ : E3 | 2 * ((N ^ expo j)⁻¹ * (μ ^ 2)⁻¹) ≤ |ξ j|} →
        eLpNorm (A N f) 1 volume
          ≤ ENNReal.ofReal (C * (μ ^ γ + N ^ (-γ)))
            * ∏ i, eLpNorm (f i) (ENNReal.ofReal (pv i)) volume := by
  classical
  obtain ⟨b, Csub, hb, hbj, hB1, hB2, hCsub, hsubest⟩ := kosz_subunit j HS
  have hpv0 : ∀ i, (0 : ℝ) < pv i := fun i => lt_trans one_pos (hpv i)
  have ha : ∀ i, (pv i)⁻¹ ∈ Set.Ioo (0 : ℝ) 1 := by
    intro i
    refine ⟨inv_pos.mpr (hpv0 i), ?_⟩
    have hm : pv i * (pv i)⁻¹ = 1 := mul_inv_cancel₀ (hpv0 i).ne'
    nlinarith [inv_pos.mpr (hpv0 i), hpv i]
  obtain ⟨hcmem, hcsum, hid⟩ := endpoint_geometry ha hsum hb hB1
  set τ : ℝ := endpointTau (fun i => (pv i)⁻¹) b with hτdef
  set θ : ℝ := endpointTheta (fun i => (pv i)⁻¹) b with hθdef
  set cc : Fin 3 → ℝ := endpointC (fun i => (pv i)⁻¹) b with hccdef
