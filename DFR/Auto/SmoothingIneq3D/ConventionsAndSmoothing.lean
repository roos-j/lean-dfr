theorem endpoint_interpolate {N R : ℝ} (hN : 0 ≤ N) (hR : 0 < R) (j : Fin 3)
    {bv cv qv : Fin 3 → ℝ} {τ θ M0 M1 : ℝ}
    (hbv : ∀ i, 0 < bv i) (hcv : ∀ i, 0 < cv i) (hqv : ∀ i, 0 < qv i)
    (hSb : 0 < ∑ i, bv i) (hSc : 0 < ∑ i, cv i)
    (hτθ : τ = 1 - θ) (hθ : θ ∈ Set.Ioo (0 : ℝ) 1)
    (hM0 : 0 < M0) (hM1 : 0 < M1)
    (hid : ∀ i, (qv i)⁻¹ = τ * bv i + θ * cv i)
    (hone : τ * (∑ i, bv i) + θ * (∑ i, cv i) = 1)
    (h0 : ∀ h : Fin 3 → E3 → ℂ, (∀ i, Nice (h i)) →
      eLpNorm (Tproj N R j h) (ENNReal.ofReal (∑ i, bv i)⁻¹) volume
        ≤ ENNReal.ofReal M0 * ∏ i, eLpNorm (h i) (ENNReal.ofReal (bv i)⁻¹) volume)
    (h1 : ∀ h : Fin 3 → E3 → ℂ, (∀ i, Nice (h i)) →
      eLpNorm (Tproj N R j h) (ENNReal.ofReal (∑ i, cv i)⁻¹) volume
        ≤ ENNReal.ofReal M1 * ∏ i, eLpNorm (h i) (ENNReal.ofReal (cv i)⁻¹) volume) :
    ∀ h : Fin 3 → E3 → ℂ, (∀ i, Nice (h i)) →
      eLpNorm (Tproj N R j h) 1 volume
