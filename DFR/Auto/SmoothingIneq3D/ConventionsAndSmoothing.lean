/-! ## Section 4: the endpoint interpolation geometry

Blueprint `lem:endpoint-geometry` is stated there for the specific exponents
`b_i = b_{i, thm:kosz-subunit, j}`. The proof uses only that each `b_i` lies in `(0,1)` and
that their sum exceeds `1`, so it is formalized with those hypotheses; this makes the lemma
independent of the imported module `thm:kosz-subunit`. -/

/-- The parameter `τ` of blueprint `lem:endpoint-geometry`. -/
noncomputable def endpointTau (a b : Fin 3 → ℝ) : ℝ :=
  (1 / 4) * Finset.univ.inf' Finset.univ_nonempty
    fun i : Fin 3 => min 1 (min (a i / b i) ((1 - a i) / (1 - b i)))

/-- The parameter `θ = 1 - τ` of blueprint `lem:endpoint-geometry`. -/
noncomputable def endpointTheta (a b : Fin 3 → ℝ) : ℝ := 1 - endpointTau a b

/-- The exponents `c_i` of blueprint `lem:endpoint-geometry`. -/
noncomputable def endpointC (a b : Fin 3 → ℝ) (i : Fin 3) : ℝ :=
  (a i - endpointTau a b * b i) / endpointTheta a b

theorem endpointTau_le_term (a b : Fin 3 → ℝ) (i : Fin 3) :
    endpointTau a b ≤ (1 / 4) * min 1 (min (a i / b i) ((1 - a i) / (1 - b i))) :=
  mul_le_mul_of_nonneg_left (Finset.inf'_le _ (Finset.mem_univ i)) (by norm_num)

theorem endpointTau_pos {a b : Fin 3 → ℝ} (ha : ∀ i, a i ∈ Set.Ioo (0 : ℝ) 1)
    (hb : ∀ i, b i ∈ Set.Ioo (0 : ℝ) 1) : 0 < endpointTau a b := by
  rw [endpointTau]
  refine mul_pos (by norm_num) ?_
  rw [Finset.lt_inf'_iff]
  intro i _
  refine lt_min (by norm_num) (lt_min (div_pos (ha i).1 (hb i).1) ?_)
  exact div_pos (by linarith [(ha i).2]) (by linarith [(hb i).2])

theorem endpointTau_le_quarter (a b : Fin 3 → ℝ) : endpointTau a b ≤ 1 / 4 := by
  have h := endpointTau_le_term a b 0
  have h1 : min 1 (min (a 0 / b 0) ((1 - a 0) / (1 - b 0))) ≤ 1 := min_le_left _ _
  linarith

theorem endpointTau_mul_b_le {a b : Fin 3 → ℝ} (hb : ∀ i, b i ∈ Set.Ioo (0 : ℝ) 1) (i : Fin 3) :
    endpointTau a b * b i ≤ (1 / 4) * a i := by
  have h2 : endpointTau a b ≤ (1 / 4) * (a i / b i) :=
    le_trans (endpointTau_le_term a b i)
      (mul_le_mul_of_nonneg_left (le_trans (min_le_right _ _) (min_le_left _ _)) (by norm_num))
  have hbi0 : b i ≠ 0 := (hb i).1.ne'
  calc endpointTau a b * b i ≤ (1 / 4) * (a i / b i) * b i :=
        mul_le_mul_of_nonneg_right h2 (hb i).1.le
    _ = (1 / 4) * a i := by field_simp

theorem endpointTau_mul_one_sub_b_le {a b : Fin 3 → ℝ} (hb : ∀ i, b i ∈ Set.Ioo (0 : ℝ) 1)
    (i : Fin 3) : endpointTau a b * (1 - b i) ≤ (1 / 4) * (1 - a i) := by
  have hbi : 0 < 1 - b i := by linarith [(hb i).2]
  have h2 : endpointTau a b ≤ (1 / 4) * ((1 - a i) / (1 - b i)) :=
    le_trans (endpointTau_le_term a b i)
      (mul_le_mul_of_nonneg_left (le_trans (min_le_right _ _) (min_le_right _ _)) (by norm_num))
  calc endpointTau a b * (1 - b i) ≤ (1 / 4) * ((1 - a i) / (1 - b i)) * (1 - b i) :=
        mul_le_mul_of_nonneg_right h2 hbi.le
    _ = (1 / 4) * (1 - a i) := by field_simp

theorem endpointTheta_mem {a b : Fin 3 → ℝ} (ha : ∀ i, a i ∈ Set.Ioo (0 : ℝ) 1)
    (hb : ∀ i, b i ∈ Set.Ioo (0 : ℝ) 1) :
    1 / 2 ≤ endpointTheta a b ∧ endpointTheta a b < 1 := by
  have h1 := endpointTau_pos ha hb
  have h2 := endpointTau_le_quarter a b
  constructor <;> · rw [endpointTheta]; linarith

/-- Blueprint `lem:endpoint-geometry`: the explicit interpolation exponents at the `p = 1`
endpoint. -/
theorem endpoint_geometry {a b : Fin 3 → ℝ} (ha : ∀ i, a i ∈ Set.Ioo (0 : ℝ) 1)
    (hA : ∑ i, a i = 1) (hb : ∀ i, b i ∈ Set.Ioo (0 : ℝ) 1) (hB : 1 < ∑ i, b i) :
    (∀ i, endpointC a b i ∈ Set.Ioo (0 : ℝ) 1) ∧ (∑ i, endpointC a b i) < 1 ∧
      ∀ i, a i = endpointTau a b * b i + endpointTheta a b * endpointC a b i := by
  have hτ := endpointTau_pos ha hb
  have hτ4 := endpointTau_le_quarter a b
  have hθ : 0 < endpointTheta a b := by rw [endpointTheta]; linarith
  refine ⟨fun i => ⟨?_, ?_⟩, ?_, fun i => ?_⟩
  · have h := endpointTau_mul_b_le (a := a) hb i
    have hai := (ha i).1
    rw [endpointC]
    exact div_pos (by linarith) hθ
  · have h := endpointTau_mul_one_sub_b_le (a := a) hb i
    have hai := (ha i).2
    rw [endpointC, div_lt_one hθ, endpointTheta]
    linarith
  · have hsum : (∑ i, endpointC a b i)
        = (1 - endpointTau a b * ∑ i, b i) / endpointTheta a b := by
      simp only [endpointC]
      rw [← Finset.sum_div, Finset.sum_sub_distrib, hA, ← Finset.mul_sum]
    rw [hsum, div_lt_one hθ, endpointTheta]
    nlinarith
  · have hne : (1 : ℝ) - endpointTau a b ≠ 0 := by
      rw [endpointTheta] at hθ; linarith
    rw [endpointC, endpointTheta]
    field_simp
    ring

