theorem scale_factor_cancel {q : ℝ} (hq : 0 < q) {qv : Fin 3 → ℝ} (_hqv : ∀ i, 0 < qv i)
    (hsum : ∑ i, (qv i)⁻¹ = q⁻¹) {N : ℝ} (hN : 0 < N) :
