  have hlim : ∀ᵐ x : E3, Filter.Tendsto (fun M => F M x) Filter.atTop (nhds (A N f x)) :=
    Filter.Eventually.of_forall fun x => A_dyadic_tendsto hf hN x
  refine le_trans (MeasureTheory.Lp.eLpNorm_lim_le_liminf_eLpNorm hFmeas (A N f) (continuous_A hf
    N).aestronglyMeasurable hlim) ?_
  have hlimsup : Filter.liminf (fun M => eLpNorm (F M) p volume) Filter.atTop
      ≤ Filter.liminf (fun _ : ℕ => (r * (1 - r)⁻¹) ^ (1 / q) * D) Filter.atTop :=
    Filter.liminf_le_liminf (Filter.Eventually.of_forall hFbound)
  rw [Filter.liminf_const] at hlimsup
  refine le_trans hlimsup ?_
  -- identify the constant
  rw [hrdef, subunitLoss_eq hq0]

open MeasureTheory in
/-- Blueprint `thm:kosz-subunit`, derived in full from its imported scale-one input
`KoszSubunitScaleOne`. The blueprint proves this step, so only the scale-one estimate is
imported. -/
theorem kosz_subunit (j : Fin 3) (H : KoszSubunitScaleOne j) :
    ∃ b : Fin 3 → ℝ, ∃ C : ℝ,
      (∀ i, b i ∈ Set.Ioo (0 : ℝ) 1) ∧ b j = 1 / 2 ∧
      1 < ∑ i, b i ∧ (∑ i, b i) < 2 ∧ 0 < C ∧
      ∀ N : ℝ, 0 < N → ∀ f : Fin 3 → E3 → ℂ, (∀ i, Continuous (f i)) →
        eLpNorm (A N f) (ENNReal.ofReal (∑ i, b i)⁻¹) volume
          ≤ ENNReal.ofReal C * ∏ i, eLpNorm (f i) (ENNReal.ofReal (b i)⁻¹) volume := by
  obtain ⟨q, qv, Ct, hq, hqv1, hqvj, hsum, hCt, hscale1⟩ := H
  have hq0 : 0 < q := lt_trans (by norm_num) hq.1
  have hq1 : q < 1 := hq.2
  have hqvpos : ∀ i, 0 < qv i := fun i => lt_trans one_pos (hqv1 i)
  refine ⟨fun i => (qv i)⁻¹, subunitLoss q * Ct,
    fun i => ⟨inv_pos.mpr (hqvpos i), ?_⟩, ?_, ?_, ?_,
    mul_pos (subunitLoss_pos hq0) hCt, ?_⟩
  · change (qv i)⁻¹ < 1
    have h := hqv1 i
    have hmul : qv i * (qv i)⁻¹ = 1 := mul_inv_cancel₀ (hqvpos i).ne'
    nlinarith [inv_pos.mpr (hqvpos i)]
  · change (qv j)⁻¹ = 1 / 2
    rw [hqvj]; norm_num
  · rw [hsum]
    have hmul : q * q⁻¹ = 1 := mul_inv_cancel₀ hq0.ne'
    nlinarith [inv_pos.mpr hq0]
  · rw [hsum]
    have hmul : q * q⁻¹ = 1 := mul_inv_cancel₀ hq0.ne'
    nlinarith [inv_pos.mpr hq0, hq.1]
  · intro N hN f hf
    have hD : ∀ M : ℝ, 0 < M →
        eLpNorm (Atilde M f) (ENNReal.ofReal q) volume
          ≤ ENNReal.ofReal Ct * ∏ i, eLpNorm (f i) (ENNReal.ofReal (qv i)) volume :=
      fun M hM => eLpNorm_Atilde_of_scale_one hq0 hqvpos hsum hscale1 hM f hf
    have hmain := eLpNorm_A_of_Atilde_bound hq0 hq1.le hf hN hD
    rw [hsum, inv_inv]
    simp only [inv_inv]
    calc eLpNorm (A N f) (ENNReal.ofReal q) volume
        ≤ ENNReal.ofReal (subunitLoss q)
          * (ENNReal.ofReal Ct * ∏ i, eLpNorm (f i) (ENNReal.ofReal (qv i)) volume) := hmain
      _ = ENNReal.ofReal (subunitLoss q * Ct)
          * ∏ i, eLpNorm (f i) (ENNReal.ofReal (qv i)) volume := by
          rw [ENNReal.ofReal_mul (subunitLoss_pos hq0).le, mul_assoc]

/-! ### Regularity bundle

The blueprint quantifies over Schwartz functions. This development uses only three consequences
of that hypothesis, bundled here for readability. `Nice` is a hypothesis bundle, not a
mathematical definition: no part of any estimate is hidden in it. -/

/-- Continuity, integrability and boundedness: the three consequences of the blueprint's
Schwartz hypothesis that this development uses. -/
def Nice (f : E3 → ℂ) : Prop :=
  Continuous f ∧ MeasureTheory.Integrable f ∧ ∃ C : ℝ, ∀ x, ‖f x‖ ≤ C

theorem Nice.continuous {f : E3 → ℂ} (h : Nice f) : Continuous f := h.1
theorem Nice.integrable {f : E3 → ℂ} (h : Nice f) : MeasureTheory.Integrable f := h.2.1
theorem Nice.bounded {f : E3 → ℂ} (h : Nice f) : ∃ C : ℝ, ∀ x, ‖f x‖ ≤ C := h.2.2

/-- Every Schwartz function is `Nice`, so the blueprint's hypotheses supply everything used. -/
theorem nice_of_schwartz (f : SchwartzMap E3 ℂ) : Nice (f : E3 → ℂ) :=
  ⟨f.continuous, f.integrable, ⟨SchwartzMap.seminorm ℝ 0 0 f, SchwartzMap.norm_le_seminorm ℝ f⟩⟩

/-- Every continuous compactly supported function is `Nice`. -/
theorem nice_of_hasCompactSupport {f : E3 → ℂ} (hc : Continuous f)
    (hs : HasCompactSupport f) : Nice f := by
  obtain ⟨C, hC⟩ := hs.exists_bound_of_continuous hc
  exact ⟨hc, hc.integrable_of_hasCompactSupport hs, ⟨C, hC⟩⟩

/-- `Nice` is a linear subspace of functions. -/
theorem nice_smul_add {u v : E3 → ℂ} (c : ℂ) (hu : Nice u) (hv : Nice v) :
    Nice fun x => c * u x + v x := by
  obtain ⟨huc, hui, Cu, hCu⟩ := hu
  obtain ⟨hvc, hvi, Cv, hCv⟩ := hv
  refine ⟨(continuous_const.mul huc).add hvc, (hui.const_mul c).add hvi,
    ⟨‖c‖ * Cu + Cv, fun x => ?_⟩⟩
  calc ‖c * u x + v x‖ ≤ ‖c * u x‖ + ‖v x‖ := norm_add_le _ _
    _ = ‖c‖ * ‖u x‖ + ‖v x‖ := by rw [norm_mul]
    _ ≤ ‖c‖ * Cu + Cv :=
        add_le_add (mul_le_mul_of_nonneg_left (hCu x) (norm_nonneg c)) (hCv x)

/-! ### `L^p` duality

Mathlib provides no `L^p` duality, so the form needed by blueprint `prop:normalized-banach` is
developed here. In the application the `L^p` norm is already known to be finite by
`eLpNorm_A_le`, so the general truncation argument is unnecessary. -/

/-- The dual function of `F` at exponent `p`. It pairs with `F` to give `‖F‖ ^ p` pointwise and
has `L^{p'}` norm `‖F‖_p ^ (p - 1)`. -/
noncomputable def dualFun (p : ℝ) (F : E3 → ℂ) (x : E3) : ℂ := (‖F x‖ ^ (p - 2) : ℝ) • F x

theorem norm_dualFun {p : ℝ} (hp : 1 < p) (F : E3 → ℂ) (x : E3) :
    ‖dualFun p F x‖ = ‖F x‖ ^ (p - 1) := by
  rcases eq_or_ne (F x) 0 with h | h
  · rw [dualFun, h]
    simp [Real.zero_rpow (by linarith : p - 1 ≠ 0)]
  · have hpos : 0 < ‖F x‖ := norm_pos_iff.mpr h
    rw [dualFun, norm_smul, Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)]
    nth_rewrite 2 [← Real.rpow_one ‖F x‖]
    rw [← Real.rpow_add hpos]
    congr 1
    ring

theorem mul_conj_dualFun {p : ℝ} (hp : 1 < p) (F : E3 → ℂ) (x : E3) :
    F x * conj (dualFun p F x) = ((‖F x‖ ^ p : ℝ) : ℂ) := by
  rcases eq_or_ne (F x) 0 with h | h
  · rw [dualFun, h]
    simp [Real.zero_rpow (by linarith : p ≠ 0)]
  · have hpos : 0 < ‖F x‖ := norm_pos_iff.mpr h
    have hreal : ‖F x‖ ^ (p - 2) * ‖F x‖ ^ (2 : ℕ) = ‖F x‖ ^ p := by
      rw [← Real.rpow_natCast ‖F x‖ 2, ← Real.rpow_add hpos]
      norm_num
    rw [dualFun, Complex.real_smul, map_mul, Complex.conj_ofReal, ← mul_assoc,
      mul_comm (F x), mul_assoc, Complex.mul_conj', ← Complex.ofReal_pow,
      ← Complex.ofReal_mul, hreal]

@[fun_prop] theorem continuous_dualFun {p : ℝ} (hp : 1 < p) {F : E3 → ℂ} (hF : Continuous F) :
    Continuous (dualFun p F) := by
  rw [continuous_iff_continuousAt]
  intro x₀
  have hfc : ContinuousAt (fun x : E3 => ‖F x‖) x₀ := hF.norm.continuousAt
  rcases eq_or_ne (F x₀) 0 with h | h
  · have hval : dualFun p F x₀ = 0 := by rw [dualFun, h]; simp
    have hnorm0 : ‖F x₀‖ = 0 := by rw [h]; simp
    rw [ContinuousAt, hval]
    refine squeeze_zero_norm (a := fun x => ‖F x‖ ^ (p - 1))
      (fun x => (norm_dualFun hp F x).le) ?_
    have hcomp : ContinuousAt (fun x : E3 => ‖F x‖ ^ (p - 1)) x₀ :=
      hfc.rpow_const (Or.inr (by linarith))
    have htend := hcomp.tendsto
    rw [hnorm0, Real.zero_rpow (by linarith : p - 1 ≠ 0)] at htend
    exact htend
  · have hnz : ‖F x₀‖ ≠ 0 := norm_ne_zero_iff.mpr h
    exact (hfc.rpow_const (Or.inl hnz)).smul hF.continuousAt

theorem conj_exponent_facts {p p' : ℝ} (hp : 1 < p) (hconj : p⁻¹ + p'⁻¹ = 1) :
    1 < p' ∧ (p - 1) * p' = p ∧ p / p' = p - 1 := by
  have hp0 : 0 < p := by linarith
  have hmulp : p * p⁻¹ = 1 := mul_inv_cancel₀ hp0.ne'
  have hpinv0 : 0 < p⁻¹ := inv_pos.mpr hp0
  have hpinv1 : p⁻¹ < 1 := by nlinarith [hmulp, hpinv0]
  have hp'inv : p'⁻¹ = 1 - p⁻¹ := by linarith
  have hp'inv0 : 0 < p'⁻¹ := by rw [hp'inv]; linarith
  have hp'inv1 : p'⁻¹ < 1 := by rw [hp'inv]; linarith
  have hp'0 : 0 < p' := inv_pos.mp hp'inv0
  have hmulp' : p' * p'⁻¹ = 1 := mul_inv_cancel₀ hp'0.ne'
  have hp'1 : 1 < p' := by nlinarith [hmulp', hp'inv0, hp'inv1]
  have hkey : p * p'⁻¹ = p - 1 := by rw [hp'inv, mul_sub, mul_one, hmulp]
  refine ⟨hp'1, ?_, ?_⟩
  · calc (p - 1) * p' = p * p'⁻¹ * p' := by rw [hkey]
      _ = p * (p' * p'⁻¹) := by ring
      _ = p := by rw [hmulp', mul_one]
  · rw [div_eq_mul_inv, hkey]


/-- A smooth cutoff equal to `1` on the closed ball of radius `n + 1` and supported in the ball
of radius `n + 2`. It truncates the dual function to a compactly supported one, so that the
duality hypothesis need only be assumed for integrable test functions. -/
noncomputable def cutoffBump (n : ℕ) : ContDiffBump (0 : E3) :=
  ⟨(n : ℝ) + 1, (n : ℝ) + 2, by positivity, by linarith⟩

noncomputable def cutoff (n : ℕ) : E3 → ℝ := cutoffBump n

theorem cutoff_nonneg (n : ℕ) (x : E3) : 0 ≤ cutoff n x := ContDiffBump.nonneg (f := cutoffBump n)

theorem cutoff_le_one (n : ℕ) (x : E3) : cutoff n x ≤ 1 :=
  ContDiffBump.le_one (f := cutoffBump n)

theorem cutoff_continuous (n : ℕ) : Continuous (cutoff n) :=
  ContDiffBump.continuous (f := cutoffBump n)

theorem cutoff_hasCompactSupport (n : ℕ) : HasCompactSupport (cutoff n) := by
  refine HasCompactSupport.intro (isCompact_closedBall (0 : E3) ((n : ℝ) + 2)) ?_
  intro x hx
  have : x ∉ Function.support (cutoff n) := by
    rw [cutoff, ContDiffBump.support_eq (f := cutoffBump n)]
    intro hmem
    exact hx (Metric.ball_subset_closedBall hmem)
  simpa using this

theorem cutoff_eventually_one (x : E3) :
    ∀ᶠ n : ℕ in Filter.atTop, cutoff n x = 1 := by
  filter_upwards [Filter.eventually_ge_atTop ⌈‖x‖⌉₊] with n hn
  refine ContDiffBump.one_of_mem_closedBall (f := cutoffBump n) ?_
  have : ‖x‖ ≤ (n : ℝ) := le_trans (Nat.le_ceil _) (by exact_mod_cast hn)
  simpa [cutoffBump, Metric.mem_closedBall, dist_zero_right] using by linarith
open MeasureTheory in
/-- `L^p` duality in the form used by blueprint `prop:normalized-banach`: a bound on the pairing
of `F` against every continuous integrable function, in terms of the `L^{p'}` norm of that
function, bounds the `L^p` norm of `F`. The finiteness of `‖F‖_{L^p}` is available in the
application through `eLpNorm_A_le`. The dual function need not be integrable, so it is truncated
by the smooth cutoffs `cutoff n` and the bound is passed to the limit. -/
theorem eLpNorm_le_of_pairing_bound {p p' : ℝ} (hp : 1 < p) (hconj : p⁻¹ + p'⁻¹ = 1)
    {F : E3 → ℂ} (hF : Continuous F) (hFfin : eLpNorm F (ENNReal.ofReal p) volume ≠ ⊤)
    {M : ℝ≥0∞}
    (hpair : ∀ g : E3 → ℂ, Nice g →
      ‖∫ x : E3, F x * conj (g x)‖ₑ ≤ M * eLpNorm g (ENNReal.ofReal p') volume) :
    eLpNorm F (ENNReal.ofReal p) volume ≤ M := by
  obtain ⟨hp', hmul, hdiv⟩ := conj_exponent_facts hp hconj
  have hp0 : 0 < p := by linarith
  have hp'0 : 0 < p' := by linarith
  set S : ℝ≥0∞ := eLpNorm F (ENNReal.ofReal p) volume with hS
  rcases eq_or_ne S 0 with h0 | h0
  · rw [h0]; exact zero_le
  have hlint : (∫⁻ x : E3, ‖F x‖ₑ ^ p) = S ^ p := by
    rw [hS, eLpNorm_eq_eLpNorm' (ENNReal.ofReal_pos.mpr hp0).ne' ENNReal.ofReal_ne_top
      (by fun_prop),
      ENNReal.toReal_ofReal hp0.le, eLpNorm', ← ENNReal.rpow_mul, one_div,
      inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one]
  have hlintfin : (∫⁻ x : E3, ‖F x‖ₑ ^ p) ≠ ⊤ := by
    rw [hlint]; exact ENNReal.rpow_ne_top_of_nonneg hp0.le hFfin
  have hdualnorm : eLpNorm (dualFun p F) (ENNReal.ofReal p') volume = S ^ (p - 1) := by
    rw [eLpNorm_eq_eLpNorm' (ENNReal.ofReal_pos.mpr hp'0).ne' ENNReal.ofReal_ne_top (by fun_prop),
      ENNReal.toReal_ofReal hp'0.le, eLpNorm']
    have hpt : ∀ x : E3, ‖dualFun p F x‖ₑ ^ p' = ‖F x‖ₑ ^ p := by
      intro x
      rw [← ofReal_norm, norm_dualFun hp F x, ← ofReal_norm,
        ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by linarith : (0:ℝ) ≤ p - 1),
        ← ENNReal.rpow_mul, hmul]
    simp only [hpt, hlint]
    rw [← ENNReal.rpow_mul]
    congr 1
    field_simp
    linarith [hdiv]
  -- `‖F‖^p` is integrable
  have hintFp : Integrable (fun x : E3 => ‖F x‖ ^ p) volume := by
    refine ⟨(hF.norm.rpow_const (fun _ => Or.inr hp0.le)).aestronglyMeasurable, ?_⟩
    rw [hasFiniteIntegral_iff_enorm]
    have hrw : ∀ x : E3, ‖‖F x‖ ^ p‖ₑ = ‖F x‖ₑ ^ p := by
      intro x
      rw [← ofReal_norm, Real.norm_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _),
        ← ofReal_norm, ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp0.le]
    simp only [hrw]
    exact lt_of_le_of_ne le_top hlintfin
  -- truncated dual functions
  set g : ℕ → E3 → ℂ := fun n x => dualFun p F x * ((cutoff n x : ℝ) : ℂ) with hgdef
  have hgc : ∀ n, Continuous (g n) := fun n =>
    (continuous_dualFun hp hF).mul (Complex.continuous_ofReal.comp (cutoff_continuous n))
  have hgcs : ∀ n, HasCompactSupport (g n) := fun n =>
    HasCompactSupport.mul_left ((cutoff_hasCompactSupport n).comp_left (g := fun r : ℝ => (r : ℂ))
      (by simp))
  have hgi : ∀ n, Integrable (g n) := fun n => (hgc n).integrable_of_hasCompactSupport (hgcs n)
  have hgb : ∀ n, ∃ C : ℝ, ∀ x, ‖g n x‖ ≤ C := by
    intro n
    obtain ⟨x₀, hx₀⟩ := (hgc n).norm.exists_forall_ge_of_hasCompactSupport (hgcs n).norm
    exact ⟨‖g n x₀‖, hx₀⟩
  have hgnorm : ∀ n, eLpNorm (g n) (ENNReal.ofReal p') volume ≤ S ^ (p - 1) := by
    intro n
    rw [← hdualnorm]
    refine eLpNorm_mono (by fun_prop) fun x => ?_
    rw [hgdef, norm_mul, Complex.norm_real, Real.norm_of_nonneg (cutoff_nonneg n x)]
    calc ‖dualFun p F x‖ * cutoff n x ≤ ‖dualFun p F x‖ * 1 :=
          mul_le_mul_of_nonneg_left (cutoff_le_one n x) (norm_nonneg _)
      _ = ‖dualFun p F x‖ := mul_one _
  have hpairing : ∀ n, (∫ x : E3, F x * conj (g n x))
      = ((∫ x : E3, ‖F x‖ ^ p * cutoff n x : ℝ) : ℂ) := by
    intro n
    rw [← _root_.integral_complex_ofReal]
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    change F x * conj (dualFun p F x * ((cutoff n x : ℝ) : ℂ))
        = ((‖F x‖ ^ p * cutoff n x : ℝ) : ℂ)
    rw [map_mul, Complex.conj_ofReal, ← mul_assoc, mul_conj_dualFun hp F x]
    push_cast
    ring
  -- the truncated bounds
  have hbound : ∀ n, ENNReal.ofReal (∫ x : E3, ‖F x‖ ^ p * cutoff n x) ≤ M * S ^ (p - 1) := by
    intro n
    have h1 := hpair (g n) ⟨hgc n, hgi n, hgb n⟩
    rw [hpairing n, ← ofReal_norm, Complex.norm_real,
      Real.norm_of_nonneg (integral_nonneg fun x => by
        exact mul_nonneg (Real.rpow_nonneg (norm_nonneg _) _) (cutoff_nonneg n x))] at h1
    exact le_trans h1 (by gcongr; exact hgnorm n)
  -- pass to the limit
  have htend : Filter.Tendsto (fun n => ∫ x : E3, ‖F x‖ ^ p * cutoff n x) Filter.atTop
      (nhds (∫ x : E3, ‖F x‖ ^ p)) := by
    refine tendsto_integral_of_dominated_convergence (fun x : E3 => ‖F x‖ ^ p) ?_ hintFp ?_ ?_
    · intro n
      exact ((hF.norm.rpow_const (fun _ => Or.inr hp0.le)).mul
        (cutoff_continuous n)).aestronglyMeasurable
    · intro n
      filter_upwards with x
      rw [Real.norm_of_nonneg (mul_nonneg (Real.rpow_nonneg (norm_nonneg _) _)
        (cutoff_nonneg n x))]
      calc ‖F x‖ ^ p * cutoff n x ≤ ‖F x‖ ^ p * 1 :=
            mul_le_mul_of_nonneg_left (cutoff_le_one n x)
              (Real.rpow_nonneg (norm_nonneg _) _)
        _ = ‖F x‖ ^ p := mul_one _
    · filter_upwards with x
      refine Filter.Tendsto.congr' ?_ tendsto_const_nhds
      filter_upwards [cutoff_eventually_one x] with n hn
      rw [hn, mul_one]
  have hSp : ENNReal.ofReal (∫ x : E3, ‖F x‖ ^ p) ≤ M * S ^ (p - 1) := by
    refine le_of_tendsto (ENNReal.tendsto_ofReal htend) ?_
    filter_upwards with n using hbound n
  have hval : ENNReal.ofReal (∫ x : E3, ‖F x‖ ^ p) = S ^ p := by
    rw [ofReal_integral_eq_lintegral_ofReal hintFp
      (Filter.Eventually.of_forall fun x => Real.rpow_nonneg (norm_nonneg _) _)]
    have hrw : ∀ x : E3, ENNReal.ofReal (‖F x‖ ^ p) = ‖F x‖ₑ ^ p := by
      intro x
      rw [← ofReal_norm, ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp0.le]
    simp only [hrw, hlint]
  rw [hval] at hSp
  have hSfin : S ≠ ⊤ := hFfin
  have hpow0 : S ^ (p - 1) ≠ 0 := (ENNReal.rpow_pos h0.bot_lt hSfin).ne'
  have hpowtop : S ^ (p - 1) ≠ ⊤ := ENNReal.rpow_ne_top_of_nonneg (by linarith) hSfin
  have hsplit : S ^ p = S ^ (p - 1) * S := by
    nth_rewrite 3 [← ENNReal.rpow_one S]
    rw [← ENNReal.rpow_add _ _ h0 hSfin]
    congr 1
    ring
  rw [hsplit, mul_comm (S ^ (p - 1)) S] at hSp
  have hfin := (ENNReal.le_div_iff_mul_le (Or.inl hpow0) (Or.inl hpowtop)).mpr hSp
  rwa [mul_div_assoc, ENNReal.div_self hpow0 hpowtop, mul_one] at hfin



open MeasureTheory in
theorem eLpNorm_conj (G : E3 → ℂ) (b : ℝ≥0∞) :
    eLpNorm (fun x => conj (G x)) b volume = eLpNorm G b volume :=
  MeasureTheory.eLpNorm_conj G b volume

open MeasureTheory in
/-- Hölder's inequality for the `L²`-type pairing; this is the step "apply Hölder's inequality
with exponents `p_j` and `p_j'`" in the proof of blueprint `prop:normalized-banach`. -/
theorem enorm_integral_mul_conj_le {a b : ℝ≥0∞} (hab : a⁻¹ + b⁻¹ = 1)
    {F G : E3 → ℂ} (hF : AEStronglyMeasurable F volume) (hG : AEStronglyMeasurable G volume) :
    ‖∫ x : E3, F x * conj (G x)‖ₑ ≤ eLpNorm F a volume * eLpNorm G b volume := by
  have : ENNReal.HolderTriple a b 1 := ⟨by simpa using hab⟩
  have hsmul : (fun x : E3 => F x * conj (G x)) = F • fun x : E3 => conj (G x) := by
    funext x; simp
  calc ‖∫ x : E3, F x * conj (G x)‖ₑ
      ≤ ∫⁻ x : E3, ‖F x * conj (G x)‖ₑ := enorm_integral_le_lintegral_enorm _
    _ = eLpNorm (fun x : E3 => F x * conj (G x)) 1 volume :=
        (eLpNorm_one_eq_lintegral_enorm (hF.mul (Complex.continuous_conj.comp_aestronglyMeasurable
          hG))).symm
    _ ≤ eLpNorm F a volume * eLpNorm (fun x : E3 => conj (G x)) b volume := by
        have hGc : AEStronglyMeasurable (fun x : E3 => conj (G x)) volume :=
          Complex.continuous_conj.comp_aestronglyMeasurable hG
        rw [hsmul]
        exact eLpNorm_smul_le_mul_eLpNorm hF hGc
    _ = eLpNorm F a volume * eLpNorm G b volume := by rw [eLpNorm_conj]

/-- A single bound serving all three factors. -/
theorem exists_uniform_bound {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Nice (f i)) :
    ∃ Cb : ℝ, 0 ≤ Cb ∧ ∀ i x, ‖f i x‖ ≤ Cb := by
  choose C hC using fun i => (hf i).bounded
  refine ⟨max 0 (max (C 0) (max (C 1) (C 2))), le_max_left _ _, fun i x => ?_⟩
  fin_cases i
  · exact le_trans (hC 0 x) (le_max_of_le_right (le_max_left _ _))
  · exact le_trans (hC 1 x) (le_max_of_le_right (le_max_of_le_right (le_max_left _ _)))
  · exact le_trans (hC 2 x) (le_max_of_le_right (le_max_of_le_right (le_max_right _ _)))

theorem continuous_uncurry_adjShift {f0 : E3 → ℂ} (hf0 : Continuous f0)
    {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Continuous (f i)) (j : Fin 3) :
    Continuous (Function.uncurry fun (y : E3) (t : ℝ) => adjShift j f0 f y t) := by
  have hc0 : Continuous fun z : E3 × ℝ => z.1 - curve j z.2 :=
    continuous_fst.sub ((continuous_curve j).comp continuous_snd)
  simp only [adjShift]
  refine (hf0.comp hc0).mul (continuous_finsetProd _ fun i _ => ?_)
  exact Complex.continuous_conj.comp
    ((hf i).comp (hc0.add ((continuous_curve i).comp continuous_snd)))

@[fun_prop] theorem continuous_Astar (N : ℝ) (j : Fin 3) {f0 : E3 → ℂ} (hf0 : Continuous f0)
    {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Continuous (f i)) : Continuous (Astar N j f0 f) :=
  continuous_const.mul (intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
    (continuous_uncurry_adjShift hf0 hf j) 0 N)

theorem norm_Astar_le {N : ℝ} (hN : 0 < N) (j : Fin 3) {f0 : E3 → ℂ} {C0 : ℝ}
    (hf0b : ∀ x, ‖f0 x‖ ≤ C0) {f : Fin 3 → E3 → ℂ} {Cb : ℝ} (hCb : 0 ≤ Cb)
    (hfb : ∀ i x, ‖f i x‖ ≤ Cb) (y : E3) :
    ‖Astar N j f0 f y‖ ≤ Cb ^ 2 * C0 := by
  have hbd : ∀ t ∈ Set.uIoc (0 : ℝ) N, ‖adjShift j f0 f y t‖ ≤ Cb ^ 2 * C0 := fun t _ =>
    le_trans (norm_adjShift_le hCb hfb j y t)
      (mul_le_mul_of_nonneg_left (hf0b _) (by positivity))
  have hint : ‖∫ t in (0 : ℝ)..N, adjShift j f0 f y t‖ ≤ Cb ^ 2 * C0 * |N - 0| :=
    intervalIntegral.norm_integral_le_of_norm_le_const hbd
  rw [sub_zero, abs_of_pos hN] at hint
  rw [Astar, norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hN.le]
  calc N⁻¹ * ‖∫ t in (0 : ℝ)..N, adjShift j f0 f y t‖ ≤ N⁻¹ * (Cb ^ 2 * C0 * N) :=
        mul_le_mul_of_nonneg_left hint (by positivity)
    _ = Cb ^ 2 * C0 := by field_simp

theorem ennreal_exponent_sum {p : ℝ} {pv : Fin 3 → ℝ} (hp : 0 < p) (hpv : ∀ i, 0 < pv i)
    (hsum : ∑ i, (pv i)⁻¹ = p⁻¹) :
    (ENNReal.ofReal (pv 0))⁻¹ + (ENNReal.ofReal (pv 1))⁻¹ + (ENNReal.ofReal (pv 2))⁻¹
      = (ENNReal.ofReal p)⁻¹ := by
  rw [← ENNReal.ofReal_inv_of_pos (hpv 0), ← ENNReal.ofReal_inv_of_pos (hpv 1),
    ← ENNReal.ofReal_inv_of_pos (hpv 2), ← ENNReal.ofReal_inv_of_pos hp,
    ← ENNReal.ofReal_add (inv_nonneg.mpr (hpv 0).le) (inv_nonneg.mpr (hpv 1).le),
    ← ENNReal.ofReal_add (add_nonneg (inv_nonneg.mpr (hpv 0).le) (inv_nonneg.mpr (hpv 1).le))
      (inv_nonneg.mpr (hpv 2).le)]
  congr 1
  rw [← hsum, Fin.sum_univ_three]

open MeasureTheory in
/-- A `Nice` function lies in every `L^p` with `p ∈ [1, ∞)`: it is integrable and bounded. -/
theorem Nice.eLpNorm_ne_top {f : E3 → ℂ} (hf : Nice f) {p : ℝ} (hp : 1 ≤ p) :
    eLpNorm f (ENNReal.ofReal p) volume ≠ ⊤ := by
  obtain ⟨hc, hi, C, hC⟩ := hf
  have hp0 : 0 < p := by linarith
  have hC0 : 0 ≤ C := le_trans (norm_nonneg _) (hC 0)
  rw [eLpNorm_eq_eLpNorm' (ENNReal.ofReal_pos.mpr hp0).ne' ENNReal.ofReal_ne_top (by fun_prop),
    ENNReal.toReal_ofReal hp0.le, eLpNorm']
  refine ENNReal.rpow_ne_top_of_nonneg (by positivity) ?_
  have hreal : ∀ x : E3, ‖f x‖ ^ p ≤ C ^ (p - 1) * ‖f x‖ := by
    intro x
    rcases eq_or_lt_of_le (norm_nonneg (f x)) with h | h
    · rw [← h, Real.zero_rpow hp0.ne']
      positivity
    · calc ‖f x‖ ^ p = ‖f x‖ ^ (p - 1) * ‖f x‖ := by
            nth_rewrite 3 [← Real.rpow_one ‖f x‖]
            rw [← Real.rpow_add h]
            congr 1
            ring
        _ ≤ C ^ (p - 1) * ‖f x‖ :=
            mul_le_mul_of_nonneg_right
              (Real.rpow_le_rpow (norm_nonneg _) (hC x) (by linarith)) (norm_nonneg _)
  have hbound : ∀ x : E3, ‖f x‖ₑ ^ p ≤ ENNReal.ofReal (C ^ (p - 1)) * ‖f x‖ₑ := by
    intro x
    rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp0.le,
      ← ENNReal.ofReal_mul (Real.rpow_nonneg hC0 _)]
    exact ENNReal.ofReal_le_ofReal (hreal x)
  refine ne_of_lt (lt_of_le_of_lt (lintegral_mono hbound) ?_)
  rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top hi.hasFiniteIntegral

open MeasureTheory in
/-- A `Nice` function belongs to every `L^p` with `p ∈ [1, ∞)`. -/
theorem Nice.memLp {f : E3 → ℂ} (hf : Nice f) {p : ℝ} (hp : 1 ≤ p) :
    MemLp f (ENNReal.ofReal p) volume :=
  lt_top_iff_ne_top.mpr (hf.eLpNorm_ne_top hp)

open MeasureTheory in
/-- `Nice` functions are dense in every `L^p` with `p ∈ [1, ∞)`, the density being supplied by
the continuous compactly supported functions. -/
theorem nice_dense {p : ℝ} {g : E3 → ℂ} (hg : MemLp g (ENNReal.ofReal p) volume)
    {ε : ℝ≥0∞} (hε : ε ≠ 0) :
    ∃ u : E3 → ℂ, Nice u ∧ eLpNorm (g - u) (ENNReal.ofReal p) volume ≤ ε := by
  obtain ⟨u, husupp, hule, hucont, _⟩ :=
    hg.exists_hasCompactSupport_eLpNorm_sub_le ENNReal.ofReal_ne_top hε
  exact ⟨u, nice_of_hasCompactSupport hucont husupp, hule⟩

open MeasureTheory in
/-- A pointwise bound for the projection of a bounded function. -/
theorem norm_P_le {R : ℝ} (hR : 0 < R) (j : Fin 3) {h : E3 → ℂ} {Ch : ℝ}
    (hhb : ∀ x, ‖h x‖ ≤ Ch) (y : E3) : ‖P R j h y‖ ≤ etaKerL1 * Ch := by
  have hbd : ∀ u : ℝ, ‖projKernel R u * h (y - u • basisVec j)‖ ≤ ‖projKernel R u‖ * Ch :=
    fun u => by
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_left (hhb _) (norm_nonneg _)
  have hle := norm_integral_le_of_norm_le
    ((projKernel_integrable hR).norm.mul_const Ch) (Filter.Eventually.of_forall hbd)
  calc ‖P R j h y‖ ≤ ∫ u : ℝ, ‖projKernel R u‖ * Ch := hle
    _ = etaKerL1 * Ch := by rw [integral_mul_const, projKernel_L1 hR]

theorem ennreal_conj_exponent {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a⁻¹ + b⁻¹ = 1) :
    (ENNReal.ofReal a)⁻¹ + (ENNReal.ofReal b)⁻¹ = 1 := by
  rw [← ENNReal.ofReal_inv_of_pos ha, ← ENNReal.ofReal_inv_of_pos hb,
    ← ENNReal.ofReal_add (inv_nonneg.mpr ha.le) (inv_nonneg.mpr hb.le), hab, ENNReal.ofReal_one]

open MeasureTheory in
/-- The main case of blueprint `prop:normalized-banach`: whenever the adjoint estimate is
available at the given scale and frequency threshold, duality yields the bound on `A_N`. This
is the part of the blueprint proof that runs "by `lem:adjoint-identity`, ... duality between
`L^p` and `L^{p'}` gives ...". -/
theorem normalized_banach_case_one (j : Fin 3)
    {p p' : ℝ} {pv pv' : Fin 3 → ℝ}
    (hp : 1 < p) (hpconj : p⁻¹ + p'⁻¹ = 1)
    (hpv : ∀ i, 1 < pv i) (hpvconj : (pv j)⁻¹ + (pv' j)⁻¹ = 1)
    (hsum : ∑ i, (pv i)⁻¹ = p⁻¹)
    {N : ℝ} (hN : 0 < N) {R : ℝ} (hR : 0 < R)
    {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Nice (f i))
    (hsupp : Function.support (𝓕 (f j)) ⊆ {ξ : E3 | R ≤ |ξ j|})
    {B : ℝ≥0∞}
    (hadj : ∀ h : E3 → ℂ, Continuous h →
      eLpNorm (fun y : E3 => Astar N j h f y - P R j (Astar N j h f) y)
          (ENNReal.ofReal (pv' j)) volume
        ≤ B * (eLpNorm h (ENNReal.ofReal p') volume
          * ∏ i ∈ Finset.univ.erase j, eLpNorm (f i) (ENNReal.ofReal (pv i)) volume)) :
    eLpNorm (A N f) (ENNReal.ofReal p) volume
      ≤ B * ∏ i, eLpNorm (f i) (ENNReal.ofReal (pv i)) volume := by
  have hfc : ∀ i, Continuous (f i) := fun i => (hf i).continuous
  have hp0 : (0 : ℝ) < p := by linarith
  have hpv0 : ∀ i, (0 : ℝ) < pv i := fun i => lt_trans one_pos (hpv i)
  obtain ⟨hpv'1, _, _⟩ := conj_exponent_facts (hpv j) hpvconj
  have hpv'0 : (0 : ℝ) < pv' j := by linarith
  obtain ⟨Cb, hCb0, hCb⟩ := exists_uniform_bound hf
  have hAfin : eLpNorm (A N f) (ENNReal.ofReal p) volume ≠ ⊤ := by
    have hle := eLpNorm_A_le hfc (p := ENNReal.ofReal p) (ENNReal.one_le_ofReal.mpr hp.le)
      ENNReal.ofReal_ne_top (pv := fun i => ENNReal.ofReal (pv i))
      (ennreal_exponent_sum hp0 hpv0 hsum) hN
    exact ne_top_of_le_ne_top
      (ENNReal.prod_ne_top fun i _ => Nice.eLpNorm_ne_top (hf i) (hpv i).le) hle
  refine eLpNorm_le_of_pairing_bound hp hpconj (continuous_A hfc N) hAfin ?_
  rintro g ⟨hgc, hgi, Cg, hCg⟩
  have hLam : (∫ x : E3, A N f x * conj (g x))
      = ∫ y : E3, f j y * conj (Astar N j g f y) :=
    adjoint_identity hN j hgc hgi hfc hCb0 hCb
  have hPzero : P R j (f j) = 0 :=
    P_eq_zero_of_fourier_support hR j (hf j).continuous (hf j).integrable (hCb j) hsupp
  have hAstarc : Continuous (Astar N j g f) := continuous_Astar N j hgc hfc
  have hAstarb : ∀ y, ‖Astar N j g f y‖ ≤ Cb ^ 2 * Cg := norm_Astar_le hN j hCg hCb0 hCb
  have hPAc : Continuous (P R j (Astar N j g f)) := continuous_P hR j hAstarc hAstarb
  have hsa := P_self_adjoint hR j (hf j).continuous (hf j).integrable hAstarc.measurable
    hAstarb
  rw [hPzero] at hsa
  have hzero : (∫ y : E3, f j y * conj (P R j (Astar N j g f) y)) = 0 := by
    simp only [Pi.zero_apply, zero_mul, integral_zero] at hsa
    exact hsa.symm
  have hint1 : Integrable (fun y : E3 => f j y * conj (Astar N j g f y)) volume :=
    Integrable.mul_bdd (hf j).integrable
      (Complex.continuous_conj.comp hAstarc).aestronglyMeasurable
      (Filter.Eventually.of_forall fun y => by simpa using hAstarb y)
  have hint2 : Integrable (fun y : E3 => f j y * conj (P R j (Astar N j g f) y)) volume :=
    Integrable.mul_bdd (hf j).integrable
      (Complex.continuous_conj.comp hPAc).aestronglyMeasurable
      (Filter.Eventually.of_forall fun y => by
        simpa using norm_P_le hR j hAstarb y)
  have hsub : (∫ y : E3, f j y * conj (Astar N j g f y))
      = ∫ y : E3, f j y * conj (Astar N j g f y - P R j (Astar N j g f) y) := by
    have hexp : ∀ y : E3, f j y * conj (Astar N j g f y - P R j (Astar N j g f) y)
        = f j y * conj (Astar N j g f y) - f j y * conj (P R j (Astar N j g f) y) := by
      intro y; rw [map_sub]; ring
    rw [integral_congr_ae (Filter.Eventually.of_forall hexp), integral_sub hint1 hint2, hzero,
      sub_zero]
  rw [hLam, hsub]
  have hprodsplit : (∏ i, eLpNorm (f i) (ENNReal.ofReal (pv i)) volume)
      = eLpNorm (f j) (ENNReal.ofReal (pv j)) volume
        * ∏ i ∈ Finset.univ.erase j, eLpNorm (f i) (ENNReal.ofReal (pv i)) volume :=
    (Finset.mul_prod_erase Finset.univ
      (fun i => eLpNorm (f i) (ENNReal.ofReal (pv i)) volume) (Finset.mem_univ j)).symm
  calc ‖∫ y : E3, f j y * conj (Astar N j g f y - P R j (Astar N j g f) y)‖ₑ
      ≤ eLpNorm (f j) (ENNReal.ofReal (pv j)) volume
        * eLpNorm (fun y : E3 => Astar N j g f y - P R j (Astar N j g f) y)
            (ENNReal.ofReal (pv' j)) volume :=
        enorm_integral_mul_conj_le (ennreal_conj_exponent (hpv0 j) hpv'0 hpvconj)
          (hf j).continuous.aestronglyMeasurable (hAstarc.sub hPAc).aestronglyMeasurable
    _ ≤ eLpNorm (f j) (ENNReal.ofReal (pv j)) volume
        * (B * (eLpNorm g (ENNReal.ofReal p') volume
          * ∏ i ∈ Finset.univ.erase j, eLpNorm (f i) (ENNReal.ofReal (pv i)) volume)) := by
        gcongr
        exact hadj g hgc
    _ = B * (∏ i, eLpNorm (f i) (ENNReal.ofReal (pv i)) volume)
          * eLpNorm g (ENNReal.ofReal p') volume := by
        rw [hprodsplit]; ring

theorem inv_le_inv_of_le' {a b : ℝ} (ha : 0 < a) (h : a ≤ b) : b⁻¹ ≤ a⁻¹ := by
  simpa [one_div] using one_div_le_one_div_of_le ha h

open MeasureTheory in
/-- Blueprint `prop:normalized-banach`: normalized smoothing at scale `N` for `p > 1`.
Conditional on the imported `KoszAdjoint`, as authorized by the user decision recorded in
`automation/instructions.md`. -/
theorem normalized_banach (j : Fin 3) (HA : KoszAdjoint j)
    {p : ℝ} {pv : Fin 3 → ℝ} (hp : 1 < p) (hpv : ∀ i, 1 < pv i)
    (hsum : ∑ i, (pv i)⁻¹ = p⁻¹) :
    ∃ γ C : ℝ, γ ∈ Set.Ioo (0 : ℝ) 1 ∧ 0 < C ∧
      ∀ N μ : ℝ, 0 < N → μ ∈ Set.Ioc (0 : ℝ) 1 →
        ∀ f : Fin 3 → E3 → ℂ, (∀ i, Nice (f i)) →
        Function.support (𝓕 (f j)) ⊆ {ξ : E3 | (N ^ expo j)⁻¹ * (μ ^ 2)⁻¹ ≤ |ξ j|} →
        eLpNorm (A N f) (ENNReal.ofReal p) volume
          ≤ ENNReal.ofReal (C * (μ ^ γ + N ^ (-γ)))
            * ∏ i, eLpNorm (f i) (ENNReal.ofReal (pv i)) volume := by
  have hp0 : (0 : ℝ) < p := by linarith
  have hpv0 : ∀ i, (0 : ℝ) < pv i := fun i => lt_trans one_pos (hpv i)
  have hpinv0 : (0 : ℝ) < p⁻¹ := inv_pos.mpr hp0
  have hmulp : p * p⁻¹ = 1 := mul_inv_cancel₀ hp0.ne'
  have hpinv1 : p⁻¹ < 1 := by nlinarith [hmulp, hpinv0]
  have hpvinv0 : ∀ i, (0 : ℝ) < (pv i)⁻¹ := fun i => inv_pos.mpr (hpv0 i)
  have hpvinv1 : ∀ i, (pv i)⁻¹ < 1 := by
    intro i
    have hm : pv i * (pv i)⁻¹ = 1 := mul_inv_cancel₀ (hpv0 i).ne'
    nlinarith [hm, hpvinv0 i, hpv i]
  -- the exponent data
  set p' : ℝ := (1 - p⁻¹)⁻¹ with hp'def
  set pv' : Fin 3 → ℝ := fun i => (1 - (pv i)⁻¹)⁻¹ with hpv'def
  have hp'conj : p⁻¹ + p'⁻¹ = 1 := by
    rw [hp'def, inv_inv]; ring
  have hpv'conj : ∀ i, (pv i)⁻¹ + (pv' i)⁻¹ = 1 := by
    intro i
    rw [hpv'def, inv_inv]; ring
  -- instantiate the imported adjoint estimate
  obtain ⟨c, K, CA, hc, hK, hCA, hadj⟩ :=
    HA (1 - p⁻¹) (fun i => (pv i)⁻¹) ⟨by linarith, by linarith⟩
      (fun i => ⟨hpvinv0 i, hpvinv1 i⟩) (by rw [hsum]; ring)
  have hc0 : (0 : ℝ) < c := hc.1
  have hc1 : c < 1 := hc.2
  have hK0 : (0 : ℝ) < K := by linarith
  have hCA0 : (0 : ℝ) < CA := by linarith
  refine ⟨c / K, 4 * CA * K, ⟨by positivity, ?_⟩, by positivity, ?_⟩
  · have hle : c / K ≤ c := by
      rw [div_le_iff₀ hK0]
      nlinarith
    linarith
  intro N μ hN hμ f hf hsupp
  obtain ⟨hμ0, hμ1⟩ := hμ
  set γ : ℝ := c / K with hγdef
  have hγ0 : (0 : ℝ) < γ := by positivity
  have hγc : γ ≤ c := by
    rw [hγdef, div_le_iff₀ hK0]
    nlinarith
  have hγ1 : γ ≤ 1 := le_trans hγc hc1.le
  -- the common application of the case-one estimate
  have hcase : ∀ ν : ℝ, 0 < ν → ν ≤ 1 → K * ν ^ (-K) ≤ N →
      Function.support (𝓕 (f j)) ⊆ {ξ : E3 | (N ^ expo j)⁻¹ * (ν ^ 2)⁻¹ ≤ |ξ j|} →
      eLpNorm (A N f) (ENNReal.ofReal p) volume
        ≤ ENNReal.ofReal (CA * ν ^ c) * ∏ i, eLpNorm (f i) (ENNReal.ofReal (pv i)) volume := by
    intro ν hν0 hν1 hνN hνsupp
    refine normalized_banach_case_one j hp hp'conj hpv (hpv'conj j) hsum hN
      (R := (N ^ expo j)⁻¹ * (ν ^ 2)⁻¹) (by positivity) hf hνsupp ?_
    intro h hh
    have := hadj ν N ⟨hν0, hν1⟩ hνN h f hh (fun i => (hf i).continuous)
    simpa only [inv_inv, hp'def, hpv'def] using this
  rcases le_or_gt (K * μ ^ (-K)) N with hcase1 | hcase2
  · -- Case 1: the adjoint estimate applies directly at `μ`
    refine le_trans (hcase μ hμ0 hμ1 hcase1 hsupp)
      (mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl)
    have hstep : μ ^ c ≤ μ ^ γ := Real.rpow_le_rpow_of_exponent_ge hμ0 hμ1 hγc
    calc CA * μ ^ c ≤ CA * μ ^ γ := mul_le_mul_of_nonneg_left hstep hCA0.le
      _ ≤ 4 * CA * K * μ ^ γ := by
          have hX : (0 : ℝ) < μ ^ γ := Real.rpow_pos_of_pos hμ0 γ
          have h4K : (0 : ℝ) ≤ 4 * K - 1 := by linarith
          nlinarith [mul_nonneg (mul_pos hCA0 hX).le h4K]
      _ ≤ 4 * CA * K * (μ ^ γ + N ^ (-γ)) := by
          have hY : (0 : ℝ) < N ^ (-γ) := Real.rpow_pos_of_pos hN (-γ)
          have hc4 : (0 : ℝ) ≤ 4 * CA * K := by nlinarith
          nlinarith [mul_nonneg hc4 hY.le]
  rcases le_or_gt K N with hcase2a | hcase3
  · -- Case 2: rescale `μ` to `ν = (K/N)^{1/K}`
    set ν : ℝ := (K / N) ^ (1 / K) with hνdef
    have hKN0 : (0 : ℝ) < K / N := by positivity
    have hν0 : (0 : ℝ) < ν := Real.rpow_pos_of_pos hKN0 _
    have hKN1 : K / N ≤ 1 := by rw [div_le_one hN]; exact hcase2a
    have hν1 : ν ≤ 1 := by
      rw [hνdef]
      exact Real.rpow_le_one hKN0.le hKN1 (by positivity)
    have hνpow : ν ^ K = K / N := by
      rw [hνdef, ← Real.rpow_mul hKN0.le, one_div, inv_mul_cancel₀ hK0.ne', Real.rpow_one]
    have hνN : K * ν ^ (-K) = N := by
      rw [Real.rpow_neg hν0.le, hνpow]
      field_simp
    have hμν : μ < ν := by
      by_contra hcon
      push Not at hcon
      have h1 : ν ^ K ≤ μ ^ K := Real.rpow_le_rpow hν0.le hcon (by positivity)
      rw [hνpow] at h1
      have h2 : K * μ ^ (-K) ≤ N := by
        rw [Real.rpow_neg hμ0.le]
        rw [div_le_iff₀ hN] at h1
        have hμK : (0 : ℝ) < μ ^ K := Real.rpow_pos_of_pos hμ0 _
        rw [mul_inv_le_iff₀ hμK]
        nlinarith
      linarith
    have hνsupp : Function.support (𝓕 (f j)) ⊆ {ξ : E3 | (N ^ expo j)⁻¹ * (ν ^ 2)⁻¹ ≤ |ξ j|} := by
      intro ξ hξ
      have h := hsupp hξ
      simp only [Set.mem_ofPred_eq] at h ⊢
      refine le_trans ?_ h
      have hNj : (0 : ℝ) < N ^ expo j := by positivity
      have hinv : (ν ^ 2)⁻¹ ≤ (μ ^ 2)⁻¹ :=
        inv_le_inv_of_le' (by positivity) (by nlinarith)
      exact mul_le_mul_of_nonneg_left hinv (by positivity)
    refine le_trans (hcase ν hν0 hν1 (le_of_eq hνN) hνsupp)
      (mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl)
    have hνc : ν ^ c = K ^ γ * N ^ (-γ) := by
      rw [hνdef, ← Real.rpow_mul hKN0.le, one_div, Real.div_rpow hK0.le hN.le,
        Real.rpow_neg hN.le, div_eq_mul_inv]
      congr 2 <;> rw [hγdef] <;> ring
    have hKγ : K ^ γ ≤ K := by
      nth_rewrite 2 [← Real.rpow_one K]
      exact Real.rpow_le_rpow_of_exponent_le hK hγ1
    rw [hνc]
    calc CA * (K ^ γ * N ^ (-γ)) ≤ CA * (K * N ^ (-γ)) := by
          refine mul_le_mul_of_nonneg_left ?_ hCA0.le
          exact mul_le_mul_of_nonneg_right hKγ (Real.rpow_pos_of_pos hN _).le
      _ ≤ 4 * CA * K * (μ ^ γ + N ^ (-γ)) := by
          have hX : (0 : ℝ) < μ ^ γ := Real.rpow_pos_of_pos hμ0 γ
          have hY : (0 : ℝ) < N ^ (-γ) := Real.rpow_pos_of_pos hN (-γ)
          have hc4 : (0 : ℝ) ≤ CA * K := by nlinarith
          nlinarith [mul_nonneg hc4 hX.le, mul_nonneg hc4 hY.le]
  · -- Case 3: the trivial Hölder bound
    have htriv := eLpNorm_A_le (fun i => (hf i).continuous) (p := ENNReal.ofReal p)
      (ENNReal.one_le_ofReal.mpr hp.le) ENNReal.ofReal_ne_top
      (pv := fun i => ENNReal.ofReal (pv i)) (ennreal_exponent_sum hp0 hpv0 hsum) hN
    refine le_trans htriv ?_
    have hone : (1 : ℝ) ≤ 4 * CA * K * (μ ^ γ + N ^ (-γ)) := by
      have hNγ : K ^ (-γ) ≤ N ^ (-γ) := by
        have hNK : N ^ γ ≤ K ^ γ := Real.rpow_le_rpow hN.le hcase3.le hγ0.le
        rw [Real.rpow_neg hN.le, Real.rpow_neg hK0.le]
        exact inv_le_inv_of_le' (Real.rpow_pos_of_pos hN _) hNK
      have hKinv : K⁻¹ ≤ K ^ (-γ) := by
        rw [Real.rpow_neg hK0.le]
        refine inv_le_inv_of_le' (Real.rpow_pos_of_pos hK0 _) ?_
        nth_rewrite 2 [← Real.rpow_one K]
        exact Real.rpow_le_rpow_of_exponent_le hK hγ1
      have hKN : K⁻¹ ≤ N ^ (-γ) := le_trans hKinv hNγ
      calc (1 : ℝ) ≤ 4 * CA := by linarith
        _ = 4 * CA * K * K⁻¹ := by field_simp
        _ ≤ 4 * CA * K * N ^ (-γ) := mul_le_mul_of_nonneg_left hKN (by positivity)
        _ ≤ 4 * CA * K * (μ ^ γ + N ^ (-γ)) := by
            have hX : (0 : ℝ) < μ ^ γ := Real.rpow_pos_of_pos hμ0 γ
            have hc4 : (0 : ℝ) ≤ 4 * CA * K := by nlinarith
            nlinarith [mul_nonneg hc4 hX.le]
    calc (∏ i, eLpNorm (f i) (ENNReal.ofReal (pv i)) volume)
        = 1 * ∏ i, eLpNorm (f i) (ENNReal.ofReal (pv i)) volume := (one_mul _).symm
      _ ≤ ENNReal.ofReal (4 * CA * K * (μ ^ γ + N ^ (-γ)))
          * ∏ i, eLpNorm (f i) (ENNReal.ofReal (pv i)) volume := by
          gcongr
          simpa using ENNReal.one_le_ofReal.mpr hone

/-! ### Section 4: the endpoint `p = 1` -/
theorem nice_P {R : ℝ} (hR : 0 < R) (j : Fin 3) {f : E3 → ℂ} (hf : Nice f) :
    Nice (P R j f) := by
  obtain ⟨hc, hi, C, hC⟩ := hf
  exact ⟨continuous_P hR j hc hC, integrable_P hR j hc hi,
    ⟨etaKerL1 * C, norm_P_le hR j hC⟩⟩

theorem nice_Q {R : ℝ} (hR : 0 < R) (j : Fin 3) {f : E3 → ℂ} (hf : Nice f) :
    Nice (Q R j f) := by
  have h4R : (0 : ℝ) < 4 * R := by linarith
  obtain ⟨hc, hi, C, hC⟩ := hf
  refine ⟨hc.sub (continuous_P h4R j hc hC), hi.sub (integrable_P h4R j hc hi),
    ⟨C + etaKerL1 * C, fun x => ?_⟩⟩
  calc ‖Q R j f x‖ = ‖f x - P (4 * R) j f x‖ := rfl
    _ ≤ ‖f x‖ + ‖P (4 * R) j f x‖ := norm_sub_le _ _
    _ ≤ C + etaKerL1 * C := add_le_add (hC x) (norm_P_le h4R j hC x)

/-- The operator `T_{N,μ,j}` of blueprint `prop:normalized-endpoint`: the normalized average
with the `j`-th argument replaced by its high-frequency part. -/
noncomputable def Tproj (N R : ℝ) (j : Fin 3) (g : Fin 3 → E3 → ℂ) : E3 → ℂ :=
  A N (Function.update g j (Q R j (g j)))

open MeasureTheory in
@[fun_prop] theorem measurable_Q {R : ℝ} (j : Fin 3) {f : E3 → ℂ}
    (hf : Measurable f) : Measurable (Q R j f) :=
  hf.sub (measurable_P j hf)

open MeasureTheory in
@[fun_prop] theorem measurable_Tproj {N R : ℝ} (hN : 0 ≤ N) (j : Fin 3)
    {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Measurable (f i)) : Measurable (Tproj N R j f) := by
  apply measurable_A hN
  intro i
  by_cases hi : i = j
  · subst i
    simpa only [Function.update_self] using measurable_Q j (hf j)
  · simpa only [Function.update_of_ne hi] using hf i

theorem nice_update_Q {R : ℝ} (hR : 0 < R) (j : Fin 3) {g : Fin 3 → E3 → ℂ}
    (hg : ∀ i, Nice (g i)) : ∀ i, Nice (Function.update g j (Q R j (g j)) i) := by
  intro i
  rcases eq_or_ne i j with rfl | h
  · rw [Function.update_self]
    exact nice_Q hR i (hg i)
  · rw [Function.update_of_ne h]
    exact hg i


/-! ### Trilinearity of the interpolated operator

Blueprint `thm:quasi-interpolation` carries a trilinearity hypothesis. The present proof of
`lem:lebesgue-strip` does not use it -- the analyticity of the composed family is obtained from
the explicit kernel instead -- but the fact is part of the blueprint and is recorded here. -/

open MeasureTheory in
/-- The convolution integrand of `P` is integrable for a `Nice` function. -/
theorem integrable_projKernel_mul {R : ℝ} (hR : 0 < R) (j : Fin 3) {f : E3 → ℂ}
    (hf : Nice f) (x : E3) :
    Integrable fun u : ℝ => projKernel R u * f (x - u • basisVec j) := by
  obtain ⟨hc, _, C, hC⟩ := hf
  refine (projKernel_integrable hR).mul_bdd (c := C) ?_
    (Filter.Eventually.of_forall fun u => hC _)
  exact (hc.comp (continuous_const.sub (continuous_id.smul continuous_const))).aestronglyMeasurable

open MeasureTheory in
/-- `P_R^{(j)}` is linear on `Nice` functions. -/
theorem P_smul_add {R : ℝ} (hR : 0 < R) (j : Fin 3) {u v : E3 → ℂ} (c : ℂ)
    (hu : Nice u) (hv : Nice v) :
    P R j (fun x => c * u x + v x) = fun x => c * P R j u x + P R j v x := by
  funext x
  change (∫ w : ℝ, projKernel R w * (c * u (x - w • basisVec j) + v (x - w • basisVec j)))
    = c * P R j u x + P R j v x
  have hsplit : (fun w : ℝ =>
        projKernel R w * (c * u (x - w • basisVec j) + v (x - w • basisVec j)))
      = fun w : ℝ => c * (projKernel R w * u (x - w • basisVec j))
          + projKernel R w * v (x - w • basisVec j) := by
    funext w; ring
  rw [hsplit, integral_add ((integrable_projKernel_mul hR j hu x).const_mul c)
    (integrable_projKernel_mul hR j hv x), integral_const_mul]
  rfl

/-- `Q_R^{(j)}` is linear on `Nice` functions. -/
theorem Q_smul_add {R : ℝ} (hR : 0 < R) (j : Fin 3) {u v : E3 → ℂ} (c : ℂ)
    (hu : Nice u) (hv : Nice v) :
    Q R j (fun x => c * u x + v x) = fun x => c * Q R j u x + Q R j v x := by
  have h4R : (0 : ℝ) < 4 * R := by linarith
  have hP := P_smul_add h4R j c hu hv
  funext x
  simp only [Q, hP]
  ring

/-- The product in the definition of `A_N` is linear in each slot. -/
theorem prodShift_update_smul_add (g : Fin 3 → E3 → ℂ) (i : Fin 3) (u v : E3 → ℂ) (c : ℂ)
    (x : E3) (t : ℝ) :
    prodShift (Function.update g i fun y => c * u y + v y) x t
      = c * prodShift (Function.update g i u) x t + prodShift (Function.update g i v) x t := by
  simp only [prodShift, Fin.prod_univ_three, Function.update_apply]
  fin_cases i <;> norm_num [Fin.ext_iff] <;> ring

open MeasureTheory in
/-- `A_N` is linear in each slot, on continuous families. -/
theorem A_smul_add {N : ℝ} (g : Fin 3 → E3 → ℂ) (i : Fin 3) {u v : E3 → ℂ} (c : ℂ)
    (hg : ∀ k, Continuous (g k)) (hu : Continuous u) (hv : Continuous v) :
    A N (Function.update g i fun y => c * u y + v y)
      = fun x => c * A N (Function.update g i u) x + A N (Function.update g i v) x := by
  have hupd : ∀ w : E3 → ℂ, Continuous w → ∀ k, Continuous (Function.update g i w k) := by
    intro w hw k
    rcases eq_or_ne k i with rfl | h
    · rwa [Function.update_self]
    · rw [Function.update_of_ne h]; exact hg k
  funext x
  have hfun : (fun t : ℝ => prodShift (Function.update g i fun y => c * u y + v y) x t)
      = fun t : ℝ => c * prodShift (Function.update g i u) x t
        + prodShift (Function.update g i v) x t :=
    funext fun t => prodShift_update_smul_add g i u v c x t
  simp only [A]
  rw [hfun, intervalIntegral.integral_add
      (((continuous_prodShift (hupd u hu) x).intervalIntegrable 0 N).const_mul c)
      ((continuous_prodShift (hupd v hv) x).intervalIntegrable 0 N),
    intervalIntegral.integral_const_mul]
  ring

open MeasureTheory in
/-- The interpolated operator is trilinear on `Nice` triples; blueprint
`thm:quasi-interpolation`. -/
theorem Tproj_trilinear {N R : ℝ} (hR : 0 < R) (j i : Fin 3)
    (g : Fin 3 → E3 → ℂ) (u v : E3 → ℂ) (c : ℂ)
    (hg : ∀ k, Nice (g k)) (hu : Nice u) (hv : Nice v) :
    Tproj N R j (Function.update g i fun y => c * u y + v y)
      = fun x => c * Tproj N R j (Function.update g i u) x
        + Tproj N R j (Function.update g i v) x := by
  rcases eq_or_ne i j with rfl | hij
  · -- the modified slot is the projected one
    have h1 : Tproj N R i (Function.update g i fun y => c * u y + v y)
        = A N (Function.update g i (Q R i (fun y => c * u y + v y))) := by
      rw [Tproj, Function.update_self, Function.update_idem]
    have h2 : ∀ w : E3 → ℂ, Tproj N R i (Function.update g i w)
        = A N (Function.update g i (Q R i w)) := by
      intro w; rw [Tproj, Function.update_self, Function.update_idem]
    rw [h1, Q_smul_add hR i c hu hv, h2 u, h2 v]
    exact A_smul_add g i c (fun k => (hg k).continuous) (nice_Q hR i hu).continuous
      (nice_Q hR i hv).continuous
  · -- the modified slot is untouched by the projection
    have hji : j ≠ i := hij.symm
    have hbase : ∀ w : E3 → ℂ, Tproj N R j (Function.update g i w)
        = A N (Function.update (Function.update g j (Q R j (g j))) i w) := by
      intro w
      rw [Tproj, Function.update_of_ne hji, Function.update_comm hij]
    rw [hbase, hbase u, hbase v]
    exact A_smul_add _ i c (fun k => (nice_update_Q hR j hg k).continuous)
      hu.continuous hv.continuous
theorem eLpNorm_update_Q_le {R : ℝ} (hR : 0 < R) (j : Fin 3) {g : Fin 3 → E3 → ℂ}
    (hg : ∀ i, Nice (g i)) {pv : Fin 3 → ℝ≥0∞} (hpv1 : ∀ i, 1 ≤ pv i) (hpvtop : ∀ i, pv i ≠ ⊤) :
    ∀ i, MeasureTheory.eLpNorm (Function.update g j (Q R j (g j)) i) (pv i) MeasureTheory.volume
      ≤ ENNReal.ofReal Ceta * MeasureTheory.eLpNorm (g i) (pv i) MeasureTheory.volume := by
  intro i
  rcases eq_or_ne i j with rfl | h
  · rw [Function.update_self]
    exact eLpNorm_Q_le hR i (hg i).continuous (hpv1 i) (hpvtop i)
  · rw [Function.update_of_ne h]
    exact le_mul_of_one_le_left zero_le
      (by simpa using ENNReal.one_le_ofReal.mpr one_le_Ceta)

open MeasureTheory in
/-- Replacing the `j`-th factor by its high-frequency part costs at most the factor `C_η`. -/
theorem prod_eLpNorm_update_Q_le {R : ℝ} (hR : 0 < R) (j : Fin 3) {g : Fin 3 → E3 → ℂ}
    (hg : ∀ i, Nice (g i)) {pv : Fin 3 → ℝ≥0∞} (hpv1 : ∀ i, 1 ≤ pv i) (hpvtop : ∀ i, pv i ≠ ⊤) :
    (∏ i, eLpNorm (Function.update g j (Q R j (g j)) i) (pv i) volume)
      ≤ ENNReal.ofReal Ceta * ∏ i, eLpNorm (g i) (pv i) volume := by
  have herase : (∏ i ∈ Finset.univ.erase j,
        eLpNorm (Function.update g j (Q R j (g j)) i) (pv i) volume)
      = ∏ i ∈ Finset.univ.erase j, eLpNorm (g i) (pv i) volume :=
    Finset.prod_congr rfl fun i hi => by
      rw [Function.update_of_ne (Finset.ne_of_mem_erase hi)]
  rw [← Finset.mul_prod_erase Finset.univ
      (fun i => eLpNorm (Function.update g j (Q R j (g j)) i) (pv i) volume) (Finset.mem_univ j),
    herase,
    ← Finset.mul_prod_erase Finset.univ (fun i => eLpNorm (g i) (pv i) volume)
      (Finset.mem_univ j), ← mul_assoc]
  gcongr
  rw [Function.update_self]
  exact eLpNorm_Q_le hR j (hg j).continuous (hpv1 j) (hpvtop j)

open MeasureTheory in
/-- The `j`-th argument of `T` has its Fourier transform supported in `{|ξ_j| ≥ R}`. -/
theorem support_fourier_update_Q {R : ℝ} (hR : 0 < R) (j : Fin 3) {g : Fin 3 → E3 → ℂ}
    (hg : ∀ i, Nice (g i)) :
    Function.support (𝓕 (Function.update g j (Q R j (g j)) j))
      ⊆ {ξ : E3 | R ≤ |ξ j|} := by
  rw [Function.update_self]
  exact support_fourier_Q hR j (hg j).continuous (hg j).integrable

/-! ### Towards `lem:lebesgue-strip`: the exponent path

The proof of `lem:lebesgue-strip` moves each input along the analytic family
  `F_i (z, x) = ph (f_i x) * exp (a_i z * log |f_i x|)`,
  `a_i z = p_i ((1 - z) / p_{i,0} + z / p_{i,1})`,

so that `F_i` equals `f_i` at `z = θ` and has `L^{p_{i,ℓ}}` norm one on the edge `re z = ℓ`.
Both facts are statements about `re (a_i z)`, recorded here. -/

/-- The exponent path of blueprint `lem:lebesgue-strip`. -/
noncomputable def interpExp (p p₀ p₁ : ℝ) (z : ℂ) : ℂ :=
  (p : ℂ) * ((1 - z) / (p₀ : ℂ) + z / (p₁ : ℂ))

theorem interpExp_re {p p₀ p₁ : ℝ} (hp₀ : p₀ ≠ 0) (hp₁ : p₁ ≠ 0) (z : ℂ) :
    (interpExp p p₀ p₁ z).re = p * ((1 - z.re) / p₀ + z.re / p₁) := by
  have h0 : ((p₀ : ℂ)) ≠ 0 := by exact_mod_cast hp₀
  have h1 : ((p₁ : ℂ)) ≠ 0 := by exact_mod_cast hp₁
  rw [interpExp, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero,
    Complex.add_re, Complex.div_ofReal_re, Complex.div_ofReal_re, Complex.sub_re,
    Complex.one_re]

/-- At the interpolation point the path takes the value one, by the exponent relation. -/
theorem interpExp_at {p p₀ p₁ θ : ℝ} (hp₀ : 0 < p₀) (hp₁ : 0 < p₁) (hp : 0 < p)
    (hrel : p⁻¹ = (1 - θ) * p₀⁻¹ + θ * p₁⁻¹) :
    (interpExp p p₀ p₁ (θ : ℂ)).re = 1 := by
  rw [interpExp_re hp₀.ne' hp₁.ne', Complex.ofReal_re]
  have h : (1 - θ) / p₀ + θ / p₁ = p⁻¹ := by
    rw [hrel]
    field_simp
  rw [h]
  field_simp

/-- On the edge `re z = 0` the path takes the value `p / p₀`. -/
theorem interpExp_re_left {p p₀ p₁ : ℝ} (hp₀ : p₀ ≠ 0) (hp₁ : p₁ ≠ 0) {z : ℂ}
    (hz : z.re = 0) : (interpExp p p₀ p₁ z).re = p / p₀ := by
  rw [interpExp_re hp₀ hp₁, hz]
  field_simp
  ring

/-- On the edge `re z = 1` the path takes the value `p / p₁`. -/
theorem interpExp_re_right {p p₀ p₁ : ℝ} (hp₀ : p₀ ≠ 0) (hp₁ : p₁ ≠ 0) {z : ℂ}
    (hz : z.re = 1) : (interpExp p p₀ p₁ z).re = p / p₁ := by
  rw [interpExp_re hp₀ hp₁, hz]
  field_simp
  ring

theorem differentiable_interpExp (p p₀ p₁ : ℝ) : Differentiable ℂ (interpExp p p₀ p₁) := by
  unfold interpExp
  fun_prop


/-! ### The analytic family of `lem:lebesgue-strip`

With the convention `ph 0 = 0` and `ph w = w / ‖w‖` otherwise, the blueprint's family is
  `F_i (z, x) = ph (f_i x) * exp (a_i z * log ‖f_i x‖)`, `a_i = interpExp p_i p_{i,0} p_{i,1}`.

It vanishes wherever `f_i` does, has modulus `‖f_i x‖ ^ re (a_i z)` elsewhere, is entire in `z`
for each fixed `x`, and equals `f_i` at `z = θ` by the exponent relation. -/

/-- The phase of a complex number, with the convention `ph 0 = 0`. -/
noncomputable def ph (w : ℂ) : ℂ := if w = 0 then 0 else w / (‖w‖ : ℂ)

@[simp] theorem ph_zero : ph 0 = 0 := by simp [ph]

theorem norm_ph_of_ne {w : ℂ} (hw : w ≠ 0) : ‖ph w‖ = 1 := by
  have h : ‖w‖ ≠ 0 := norm_ne_zero_iff.mpr hw
  rw [ph, ite_eq_right hw, norm_div, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (norm_nonneg w)]
  exact div_self h

theorem ph_mul_norm (w : ℂ) : ph w * (‖w‖ : ℂ) = w := by
  by_cases hw : w = 0
  · simp [hw]
  · have h : ((‖w‖ : ℝ) : ℂ) ≠ 0 := by
      exact_mod_cast norm_ne_zero_iff.mpr hw
    rw [ph, ite_eq_right hw]
    field_simp

/-- The analytic family of `lem:lebesgue-strip`. -/
noncomputable def anFam (p p₀ p₁ : ℝ) {α : Type*} (f : α → ℂ) (z : ℂ) (x : α) : ℂ :=
  ph (f x) * Complex.exp (interpExp p p₀ p₁ z * (Real.log ‖f x‖ : ℂ))

theorem anFam_of_eq_zero {p p₀ p₁ : ℝ} {α : Type*} {f : α → ℂ} {z : ℂ} {x : α}
    (hx : f x = 0) : anFam p p₀ p₁ f z x = 0 := by
  simp [anFam, hx]

/-- Off the zero set of `f`, the modulus of the family is a real power of `‖f‖`. -/
theorem norm_anFam {p p₀ p₁ : ℝ} {α : Type*} {f : α → ℂ} (z : ℂ) {x : α} (hx : f x ≠ 0) :
    ‖anFam p p₀ p₁ f z x‖ = ‖f x‖ ^ (interpExp p p₀ p₁ z).re := by
  rw [anFam, norm_mul, norm_ph_of_ne hx, one_mul, Complex.norm_exp,
    Real.rpow_def_of_pos (norm_pos_iff.mpr hx)]
  congr 1
  simp [Complex.mul_re, mul_comm]

theorem interpExp_ofReal (p p₀ p₁ θ : ℝ) :
    interpExp p p₀ p₁ (θ : ℂ) = ((p * ((1 - θ) / p₀ + θ / p₁) : ℝ) : ℂ) := by
  unfold interpExp
  push_cast
  ring

/-- At the interpolation point the exponent path is exactly `1`, not merely of real part one. -/
theorem interpExp_at_eq_one {p p₀ p₁ θ : ℝ} (hp₀ : 0 < p₀) (hp₁ : 0 < p₁) (hp : 0 < p)
    (hrel : p⁻¹ = (1 - θ) * p₀⁻¹ + θ * p₁⁻¹) : interpExp p p₀ p₁ (θ : ℂ) = 1 := by
  rw [interpExp_ofReal]
  norm_cast
  have h : (1 - θ) / p₀ + θ / p₁ = p⁻¹ := by
    rw [hrel]
    field_simp
  rw [h]
  field_simp

/-- The family passes through `f` at `z = θ`. -/
theorem anFam_at {p p₀ p₁ θ : ℝ} (hp₀ : 0 < p₀) (hp₁ : 0 < p₁) (hp : 0 < p)
    (hrel : p⁻¹ = (1 - θ) * p₀⁻¹ + θ * p₁⁻¹) {α : Type*} (f : α → ℂ) (x : α) :
    anFam p p₀ p₁ f (θ : ℂ) x = f x := by
  by_cases hx : f x = 0
  · rw [anFam_of_eq_zero hx, hx]
  · rw [anFam, interpExp_at_eq_one hp₀ hp₁ hp hrel, one_mul, ← Complex.ofReal_exp,
      Real.exp_log (norm_pos_iff.mpr hx)]
    exact ph_mul_norm _

/-- For each fixed point the family is entire in the strip variable. -/
theorem differentiable_anFam (p p₀ p₁ : ℝ) {α : Type*} (f : α → ℂ) (x : α) :
    Differentiable ℂ fun z => anFam p p₀ p₁ f z x := by
  unfold anFam interpExp
  fun_prop

/-- The extended-nonnegative modulus of the family, valid also on the zero set of `f`
because the exponent is positive there. -/
theorem enorm_anFam {p p₀ p₁ : ℝ} {α : Type*} {f : α → ℂ} {z : ℂ} {r : ℝ}
    (hrz : (interpExp p p₀ p₁ z).re = r) (hr : 0 < r) (x : α) :
    ‖anFam p p₀ p₁ f z x‖ₑ = ‖f x‖ₑ ^ r := by
  by_cases hx : f x = 0
  · rw [anFam_of_eq_zero hx, hx]
    simp [ENNReal.zero_rpow_of_pos hr]
  · rw [← ofReal_norm, ← ofReal_norm, norm_anFam z hx, hrz,
      ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hr.le]

open MeasureTheory in
open MeasureTheory in
theorem measurable_ph : Measurable ph := by
  unfold ph
  have hset : MeasurableSet {w : ℂ | w = 0} := by
    simp
  refine Measurable.ite hset measurable_const ?_
  exact measurable_id.div (Complex.measurable_ofReal.comp measurable_norm)

theorem measurable_anFam {p p₀ p₁ : ℝ} {α : Type*} [MeasurableSpace α] {g : α → ℂ}
    (hg : Measurable g) (z : ℂ) : Measurable (anFam p p₀ p₁ g z) := by
  unfold anFam
  refine (measurable_ph.comp hg).mul (Complex.measurable_exp.comp ?_)
  exact measurable_const.mul
    (Complex.measurable_ofReal.comp (Real.measurable_log.comp hg.norm))

open MeasureTheory in
@[fun_prop] theorem aestronglyMeasurable_anFam {α : Type*} [MeasurableSpace α]
    {μ : Measure α} {f : α → ℂ} (hf : AEStronglyMeasurable f μ) (p p₀ p₁ : ℝ) (z : ℂ) :
    AEStronglyMeasurable (anFam p p₀ p₁ f z) μ := by
  have hm : Measurable (fun w : ℂ => ph w * Complex.exp
      (interpExp p p₀ p₁ z * (Real.log ‖w‖ : ℂ))) := by
    exact (measurable_anFam measurable_id z)
  exact (hm.comp_aemeasurable hf.aemeasurable).aestronglyMeasurable

open MeasureTheory in
/-- The Lebesgue norms of the family are powers of a single Lebesgue norm of `f`. -/
theorem eLpNorm_anFam {p p₀ p₁ : ℝ} {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {f : α → ℂ} {z : ℂ} {r P : ℝ} (hrz : (interpExp p p₀ p₁ z).re = r) (hr : 0 < r)
    (hP : 0 < P) (hf : AEStronglyMeasurable f μ) :
    eLpNorm (anFam p p₀ p₁ f z) (ENNReal.ofReal P) μ
      = eLpNorm f (ENNReal.ofReal (r * P)) μ ^ r := by
  have hr0 : r ≠ 0 := hr.ne'
  have hP0 : P ≠ 0 := hP.ne'
  have hrP : 0 < r * P := mul_pos hr hP
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (ENNReal.ofReal_pos.mpr hP).ne' ENNReal.ofReal_ne_top
    (by fun_prop),
    eLpNorm_eq_lintegral_rpow_enorm_toReal (ENNReal.ofReal_pos.mpr hrP).ne' ENNReal.ofReal_ne_top
      (by fun_prop),
    ENNReal.toReal_ofReal hP.le, ENNReal.toReal_ofReal hrP.le]
  have hint : (∫⁻ x, ‖anFam p p₀ p₁ f z x‖ₑ ^ P ∂μ) = ∫⁻ x, ‖f x‖ₑ ^ (r * P) ∂μ := by
    refine lintegral_congr fun x => ?_
    rw [enorm_anFam hrz hr x, ← ENNReal.rpow_mul]
  rw [hint, ← ENNReal.rpow_mul]
  congr 1
  field_simp

open MeasureTheory in
/-- On the left edge of the strip the family has `L^{p₀}` norm `‖f‖_{L^p} ^ (p / p₀)`. -/
theorem eLpNorm_anFam_left {p p₀ p₁ : ℝ} (hp : 0 < p) (hp₀ : 0 < p₀) (hp₁ : 0 < p₁)
    {α : Type*} [MeasurableSpace α] {μ : Measure α} {f : α → ℂ} {z : ℂ} (hz : z.re = 0) (hfm :
      AEStronglyMeasurable f μ) :
    eLpNorm (anFam p p₀ p₁ f z) (ENNReal.ofReal p₀) μ
      = eLpNorm f (ENNReal.ofReal p) μ ^ (p / p₀) := by
  have h := eLpNorm_anFam (μ := μ) (f := f)
    (interpExp_re_left hp₀.ne' hp₁.ne' hz) (div_pos hp hp₀) hp₀ hfm
  rwa [div_mul_cancel₀ _ hp₀.ne'] at h

open MeasureTheory in
/-- On the right edge of the strip the family has `L^{p₁}` norm `‖f‖_{L^p} ^ (p / p₁)`. -/
theorem eLpNorm_anFam_right {p p₀ p₁ : ℝ} (hp : 0 < p) (hp₀ : 0 < p₀) (hp₁ : 0 < p₁)
    {α : Type*} [MeasurableSpace α] {μ : Measure α} {f : α → ℂ} {z : ℂ} (hz : z.re = 1) (hfm :
      AEStronglyMeasurable f μ) :
    eLpNorm (anFam p p₀ p₁ f z) (ENNReal.ofReal p₁) μ
      = eLpNorm f (ENNReal.ofReal p) μ ^ (p / p₁) := by
  have h := eLpNorm_anFam (μ := μ) (f := f)
    (interpExp_re_right hp₀.ne' hp₁.ne' hz) (div_pos hp hp₁) hp₁ hfm
  rwa [div_mul_cancel₀ _ hp₁.ne'] at h

open MeasureTheory in
/-- Normalized inputs stay normalized along both edges. -/
theorem eLpNorm_anFam_left_eq_one {p p₀ p₁ : ℝ} (hp : 0 < p) (hp₀ : 0 < p₀) (hp₁ : 0 < p₁)
    {α : Type*} [MeasurableSpace α] {μ : Measure α} {f : α → ℂ} {z : ℂ} (hz : z.re = 0)
    (hf : eLpNorm f (ENNReal.ofReal p) μ = 1) :
    eLpNorm (anFam p p₀ p₁ f z) (ENNReal.ofReal p₀) μ = 1 := by
  rw [eLpNorm_anFam_left hp hp₀ hp₁ hz (aestronglyMeasurable_of_eLpNorm_ne_top (by
    rw [hf];
    simp)), hf, ENNReal.one_rpow]

open MeasureTheory in
theorem eLpNorm_anFam_right_eq_one {p p₀ p₁ : ℝ} (hp : 0 < p) (hp₀ : 0 < p₀) (hp₁ : 0 < p₁)
    {α : Type*} [MeasurableSpace α] {μ : Measure α} {f : α → ℂ} {z : ℂ} (hz : z.re = 1)
    (hf : eLpNorm f (ENNReal.ofReal p) μ = 1) :
    eLpNorm (anFam p p₀ p₁ f z) (ENNReal.ofReal p₁) μ = 1 := by
  rw [eLpNorm_anFam_right hp hp₀ hp₁ hz (aestronglyMeasurable_of_eLpNorm_ne_top (by
    rw [hf];
    simp)), hf, ENNReal.one_rpow]


/-! ### Blueprint `lem:lebesgue-strip`

The Lebesgue-space strip argument. The analytic family `Auto.anFam` is fed into
`Auto.eLpNorm_le_of_analyticFamily`: it passes through `f` at `z = θ`, its `L^{p_{i,ℓ}}` norm on
the edge `re z = ℓ` is `‖f i‖_{L^{p_i}} ^ (p_i / p_{i,ℓ})`, and the two exponent identities make
the resulting constants collapse to `M₀ ^ (1-θ) M₁ ^ θ ∏ ‖f i‖_{L^{p_i}}`.

Where the blueprint expands `T` on finite-valued simple functions in order to know that
`z ↦ T (F₁ z, F₂ z, F₃ z) (y)` is entire, the hypotheses `hcont`, `hdiff` and `hbdd` below carry
that information instead; see `automation/ErrorReport.md`. The dense class `S` has to be closed
under the analytic family, which is what `hSfam` says. -/
theorem ennreal_rpow_add_one {A : ℝ≥0∞} {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b = 1) :
    A ^ a * A ^ b = A := by
  rw [← ENNReal.rpow_add_of_nonneg _ _ ha hb, hab, ENNReal.rpow_one]

theorem prod_rpow_three {A : Fin 3 → ℝ≥0∞} {c : ℝ} (hc : 0 ≤ c) :
    (∏ i, A i) ^ c = ∏ i, A i ^ c := by
  rw [Fin.prod_univ_three, Fin.prod_univ_three, ENNReal.mul_rpow_of_nonneg _ _ hc,
    ENNReal.mul_rpow_of_nonneg _ _ hc]

open MeasureTheory in
/-- **Blueprint `lem:lebesgue-strip`, together with the conclusion of `thm:gm-internal`.**
A map bounded from the products `∏ L^{p_{i,0}}` into `L^{q₀}` and from `∏ L^{p_{i,1}}` into
`L^{q₁}` on a class `S` closed under the analytic family obeys the interpolated bound on `S`,
provided the composed family is measurable, analytic in the open strip and bounded on the closed
strip. Trilinearity itself is not needed once those three properties are assumed; in the
blueprint it serves only to produce them. -/
theorem interpolate_of_analyticFamily
    {T : (Fin 3 → E3 → ℂ) → E3 → ℂ} {S : (E3 → ℂ) → Prop}
    {p₀ p₁ p : Fin 3 → ℝ} {q₀ q₁ q M₀ M₁ θ : ℝ}
    (hp₀ : ∀ i, 0 < p₀ i) (hp₁ : ∀ i, 0 < p₁ i) (hp : ∀ i, 0 < p i)
    (hq₀ : 0 < q₀) (hq₁ : 0 < q₁) (hq : 0 < q) (hM₀ : 0 ≤ M₀) (hM₁ : 0 ≤ M₁)
    (hθ : θ ∈ Set.Ioo (0 : ℝ) 1)
    (hrel : ∀ i, (p i)⁻¹ = (1 - θ) * (p₀ i)⁻¹ + θ * (p₁ i)⁻¹)
    (hqrel : q⁻¹ = (1 - θ) * q₀⁻¹ + θ * q₁⁻¹)
    (hSfam : ∀ u : E3 → ℂ, S u → ∀ (i : Fin 3) (z : ℂ), z.re ∈ Set.Icc (0 : ℝ) 1 →
      S (anFam (p i) (p₀ i) (p₁ i) u z))
    (f : Fin 3 → E3 → ℂ) (hf : ∀ i, S (f i))
    (hfm : ∀ i, AEStronglyMeasurable (f i) volume)
    (hmeas : AEStronglyMeasurable (T f) volume)
    (hmeas₀ : AEStronglyMeasurable
      (fun w : E3 × ℝ =>
        T (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) ((w.2 : ℂ) * Complex.I)) w.1)
      ((volume : Measure E3).prod (volume : Measure ℝ)))
    (hmeas₁ : AEStronglyMeasurable
      (fun w : E3 × ℝ =>
        T (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) (1 + (w.2 : ℂ) * Complex.I)) w.1)
      ((volume : Measure E3).prod (volume : Measure ℝ)))
    (hcont : ∀ y : E3, ContinuousOn
      (fun z : ℂ => T (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) z) y)
      {z : ℂ | z.re ∈ Set.Icc (0 : ℝ) 1})
    (hdiff : ∀ y : E3, DifferentiableOn ℂ
      (fun z : ℂ => T (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) z) y)
      {z : ℂ | z.re ∈ Set.Ioo (0 : ℝ) 1})
    (hbdd : ∀ y : E3, ∃ C : ℝ, ∀ z : ℂ, z.re ∈ Set.Icc (0 : ℝ) 1 →
      ‖T (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) z) y‖ ≤ C)
    (h0 : ∀ g : Fin 3 → E3 → ℂ, (∀ i, S (g i)) →
      eLpNorm (T g) (ENNReal.ofReal q₀) volume
        ≤ ENNReal.ofReal M₀ * ∏ i, eLpNorm (g i) (ENNReal.ofReal (p₀ i)) volume)
    (h1 : ∀ g : Fin 3 → E3 → ℂ, (∀ i, S (g i)) →
      eLpNorm (T g) (ENNReal.ofReal q₁) volume
        ≤ ENNReal.ofReal M₁ * ∏ i, eLpNorm (g i) (ENNReal.ofReal (p₁ i)) volume) :
    eLpNorm (T f) (ENNReal.ofReal q) volume
      ≤ ENNReal.ofReal (M₀ ^ (1 - θ) * M₁ ^ θ)
        * ∏ i, eLpNorm (f i) (ENNReal.ofReal (p i)) volume := by
  obtain ⟨hθ0, hθ1⟩ := hθ
  have h1θ : (0 : ℝ) < 1 - θ := by linarith
  set A : Fin 3 → ℝ≥0∞ := fun i => eLpNorm (f i) (ENNReal.ofReal (p i)) volume with hAdef
  have hFS : ∀ z : ℂ, z.re ∈ Set.Icc (0 : ℝ) 1 → ∀ i,
      S (anFam (p i) (p₀ i) (p₁ i) (f i) z) := fun z hz i => hSfam (f i) (hf i) i z hz
  have hreL : ∀ t : ℝ, (((t : ℂ) * Complex.I)).re = 0 := by intro t; simp
  have hreR : ∀ t : ℝ, ((1 : ℂ) + (t : ℂ) * Complex.I).re = 1 := by intro t; simp
  have hmemL : ∀ t : ℝ, (((t : ℂ) * Complex.I)).re ∈ Set.Icc (0 : ℝ) 1 := by
    intro t; rw [hreL t]; constructor <;> norm_num
  have hmemR : ∀ t : ℝ, ((1 : ℂ) + (t : ℂ) * Complex.I).re ∈ Set.Icc (0 : ℝ) 1 := by
    intro t; rw [hreR t]; constructor <;> norm_num
  have hb0 : ∀ t : ℝ, eLpNorm
      (fun y : E3 => T (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) ((t : ℂ) * Complex.I)) y)
      (ENNReal.ofReal q₀) volume ≤ ENNReal.ofReal M₀ * ∏ i, A i ^ (p i / p₀ i) := by
    intro t
    have h := h0 (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) ((t : ℂ) * Complex.I))
      (hFS _ (hmemL t))
    have hprod : (∏ i, eLpNorm (anFam (p i) (p₀ i) (p₁ i) (f i) ((t : ℂ) * Complex.I))
        (ENNReal.ofReal (p₀ i)) volume) = ∏ i, A i ^ (p i / p₀ i) :=
      Finset.prod_congr rfl fun i _ => eLpNorm_anFam_left (hp i) (hp₀ i) (hp₁ i) (hreL t) (hfm i)
    rw [hprod] at h
    exact h
  have hb1 : ∀ t : ℝ, eLpNorm
      (fun y : E3 => T (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) (1 + (t : ℂ) * Complex.I)) y)
      (ENNReal.ofReal q₁) volume ≤ ENNReal.ofReal M₁ * ∏ i, A i ^ (p i / p₁ i) := by
    intro t
    have h := h1 (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) (1 + (t : ℂ) * Complex.I))
      (hFS _ (hmemR t))
    have hprod : (∏ i, eLpNorm (anFam (p i) (p₀ i) (p₁ i) (f i) (1 + (t : ℂ) * Complex.I))
        (ENNReal.ofReal (p₁ i)) volume) = ∏ i, A i ^ (p i / p₁ i) :=
      Finset.prod_congr rfl fun i _ => eLpNorm_anFam_right (hp i) (hp₀ i) (hp₁ i) (hreR t) (hfm i)
    rw [hprod] at h
    exact h
  have hFθ : (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) (θ : ℂ)) = f := by
    funext i x
    exact anFam_at (hp₀ i) (hp₁ i) (hp i) (hrel i) (f i) x
  have hmain := eLpNorm_le_of_analyticFamily (μ := (volume : Measure E3))
    (H := fun z y => T (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) z) y)
    ⟨hθ0, hθ1⟩ hq₀ hq₁ hq hqrel (by simpa only [hFθ] using hmeas) hmeas₀ hmeas₁ hcont hdiff hbdd
      hb0 hb1
  rw [hFθ] at hmain
  refine hmain.trans (le_of_eq ?_)
  have hL : (∏ i, A i ^ (p i / p₀ i)) ^ (1 - θ) = ∏ i, A i ^ (p i / p₀ i * (1 - θ)) := by
    rw [prod_rpow_three h1θ.le]
    exact Finset.prod_congr rfl fun i _ => by rw [← ENNReal.rpow_mul]
  have hR : (∏ i, A i ^ (p i / p₁ i)) ^ θ = ∏ i, A i ^ (p i / p₁ i * θ) := by
    rw [prod_rpow_three hθ0.le]
    exact Finset.prod_congr rfl fun i _ => by rw [← ENNReal.rpow_mul]
  have hcomb : (∏ i, A i ^ (p i / p₀ i * (1 - θ))) * (∏ i, A i ^ (p i / p₁ i * θ))
      = ∏ i, A i := by
    rw [← Finset.prod_mul_distrib]
    refine Finset.prod_congr rfl fun i _ => ?_
    have hp₀i : p₀ i ≠ 0 := (hp₀ i).ne'
    have hp₁i : p₁ i ≠ 0 := (hp₁ i).ne'
    have hsum : p i / p₀ i * (1 - θ) + p i / p₁ i * θ = 1 := by
      have he : p i / p₀ i * (1 - θ) + p i / p₁ i * θ
          = p i * ((1 - θ) * (p₀ i)⁻¹ + θ * (p₁ i)⁻¹) := by
        field_simp
      rw [he, ← hrel i, mul_inv_cancel₀ (hp i).ne']
    exact ennreal_rpow_add_one
      (mul_nonneg (div_nonneg (hp i).le (hp₀ i).le) h1θ.le)
      (mul_nonneg (div_nonneg (hp i).le (hp₁ i).le) hθ0.le) hsum
  have hconst : ENNReal.ofReal M₀ ^ (1 - θ) * ENNReal.ofReal M₁ ^ θ
      = ENNReal.ofReal (M₀ ^ (1 - θ) * M₁ ^ θ) := by
    rw [ENNReal.ofReal_rpow_of_nonneg hM₀ h1θ.le, ENNReal.ofReal_rpow_of_nonneg hM₁ hθ0.le,
      ← ENNReal.ofReal_mul (Real.rpow_nonneg hM₀ _)]
  calc (ENNReal.ofReal M₀ * ∏ i, A i ^ (p i / p₀ i)) ^ (1 - θ)
        * (ENNReal.ofReal M₁ * ∏ i, A i ^ (p i / p₁ i)) ^ θ
      = (ENNReal.ofReal M₀ ^ (1 - θ) * (∏ i, A i ^ (p i / p₀ i)) ^ (1 - θ))
        * (ENNReal.ofReal M₁ ^ θ * (∏ i, A i ^ (p i / p₁ i)) ^ θ) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ h1θ.le, ENNReal.mul_rpow_of_nonneg _ _ hθ0.le]
    _ = (ENNReal.ofReal M₀ ^ (1 - θ) * ENNReal.ofReal M₁ ^ θ)
        * ((∏ i, A i ^ (p i / p₀ i * (1 - θ))) * (∏ i, A i ^ (p i / p₁ i * θ))) := by
        rw [hL, hR]; ring
    _ = ENNReal.ofReal (M₀ ^ (1 - θ) * M₁ ^ θ) * ∏ i, A i := by rw [hconst, hcomb]


/-! ### The dense class carried through the strip

`Auto.Nice` is not closed under the analytic family: for an exponent `r < 1` the function
`|u| ^ r` of a bounded integrable `u` need not be integrable. Continuous functions with compact
support are closed under it, are contained in `Auto.Nice`, and are dense in every `L^p`, so they
are the class `S` of `Auto.interpolate_of_analyticFamily` in the application. -/

/-- On the closed strip the exponent path has positive real part. -/
theorem interpExp_re_pos {p p₀ p₁ : ℝ} (hp : 0 < p) (hp₀ : 0 < p₀) (hp₁ : 0 < p₁) {z : ℂ}
    (hz : z.re ∈ Set.Icc (0 : ℝ) 1) : 0 < (interpExp p p₀ p₁ z).re := by
  obtain ⟨h0, h1⟩ := hz
  rw [interpExp_re hp₀.ne' hp₁.ne']
  have hB : 0 ≤ z.re / p₁ := div_nonneg h0 hp₁.le
  have hA : 0 ≤ (1 - z.re) / p₀ := div_nonneg (by linarith) hp₀.le
  rcases lt_or_eq_of_le h1 with h | h
  · have hApos : 0 < (1 - z.re) / p₀ := div_pos (by linarith) hp₀
    exact mul_pos hp (by linarith)
  · have hBpos : 0 < z.re / p₁ := by rw [h]; exact div_pos one_pos hp₁
    exact mul_pos hp (by linarith)

/-- The modulus of the family, valid on the whole space when the exponent is positive. -/
theorem norm_anFam' {p p₀ p₁ : ℝ} {α : Type*} {f : α → ℂ} {z : ℂ}
    (hr : 0 < (interpExp p p₀ p₁ z).re) (x : α) :
    ‖anFam p p₀ p₁ f z x‖ = ‖f x‖ ^ (interpExp p p₀ p₁ z).re := by
  by_cases hx : f x = 0
  · rw [anFam_of_eq_zero hx, hx]
    simp [Real.zero_rpow hr.ne']
  · exact norm_anFam z hx

/-- The family of a continuous function is continuous, including across the zero set, where the
positive power of the modulus forces the limit. -/
theorem continuous_anFam {p p₀ p₁ : ℝ} {α : Type*} [TopologicalSpace α] {f : α → ℂ}
    (hf : Continuous f) {z : ℂ} (hr : 0 < (interpExp p p₀ p₁ z).re) :
    Continuous (anFam p p₀ p₁ f z) := by
  refine continuous_iff_continuousAt.mpr fun x₀ => ?_
  by_cases hx : f x₀ = 0
  · have h1 : Filter.Tendsto (fun x => ‖f x‖) (nhds x₀) (nhds 0) := by
      have h := (hf.norm).continuousAt (x := x₀)
      rwa [ContinuousAt, hx, norm_zero] at h
    have h2 : Filter.Tendsto (fun u : ℝ => u ^ (interpExp p p₀ p₁ z).re) (nhds 0) (nhds 0) := by
      have h := (Real.continuousAt_rpow_const (0 : ℝ) _ (Or.inr hr.le)).tendsto
      rwa [Real.zero_rpow hr.ne'] at h
    have hnorm : Filter.Tendsto (fun x => ‖anFam p p₀ p₁ f z x‖) (nhds x₀) (nhds 0) := by
      have h := h2.comp h1
      simpa only [Function.comp_def, norm_anFam' hr] using h
    rw [ContinuousAt, anFam_of_eq_zero hx]
    exact tendsto_zero_iff_norm_tendsto_zero.mpr hnorm
  · have hUopen : IsOpen {x : α | f x ≠ 0} := isOpen_compl_singleton.preimage hf
    have hmem : {x : α | f x ≠ 0} ∈ nhds x₀ := hUopen.mem_nhds hx
    have hcongr : anFam p p₀ p₁ f z =ᶠ[nhds x₀]
        fun x => f x / ((‖f x‖ : ℝ) : ℂ)
          * Complex.exp (interpExp p p₀ p₁ z * ((Real.log ‖f x‖ : ℝ) : ℂ)) := by
      filter_upwards [hmem] with x hx'
      rw [anFam, ph, ite_eq_right hx']
    have hne : ‖f x₀‖ ≠ 0 := norm_ne_zero_iff.mpr hx
    have h1 : ContinuousAt (fun x => f x / ((‖f x‖ : ℝ) : ℂ)) x₀ := by
      refine hf.continuousAt.div ((Complex.continuous_ofReal.comp hf.norm).continuousAt) ?_
      exact_mod_cast hne
    have hlog : ContinuousAt (fun x => Real.log ‖f x‖) x₀ := (hf.norm.continuousAt).log hne
    have hofR : ContinuousAt (fun x => ((Real.log ‖f x‖ : ℝ) : ℂ)) x₀ := by
      have h : ContinuousAt (Complex.ofReal ∘ fun x => Real.log ‖f x‖) x₀ :=
        Complex.continuous_ofReal.continuousAt.comp hlog
      exact h
    have h2 : ContinuousAt
        (fun x => Complex.exp (interpExp p p₀ p₁ z * ((Real.log ‖f x‖ : ℝ) : ℂ))) x₀ := by
      have h : ContinuousAt
          (Complex.exp ∘ fun x => interpExp p p₀ p₁ z * ((Real.log ‖f x‖ : ℝ) : ℂ)) x₀ :=
        Complex.continuous_exp.continuousAt.comp (continuousAt_const.mul hofR)
      exact h
    exact (h1.mul h2).congr hcongr.symm

theorem hasCompactSupport_anFam {p p₀ p₁ : ℝ} {α : Type*} [TopologicalSpace α] {f : α → ℂ}
    (hf : HasCompactSupport f) (z : ℂ) : HasCompactSupport (anFam p p₀ p₁ f z) := by
  refine IsCompact.of_isClosed_subset hf isClosed_closure (closure_mono fun x hx => ?_)
  simp only [Function.mem_support] at hx ⊢
  intro hfx
  exact hx (anFam_of_eq_zero hfx)

/-- The dense class of `lem:lebesgue-strip`: continuous with compact support. -/
def Ccs (f : E3 → ℂ) : Prop := Continuous f ∧ HasCompactSupport f

theorem Ccs.nice {f : E3 → ℂ} (hf : Ccs f) : Nice f := nice_of_hasCompactSupport hf.1 hf.2

theorem Ccs.continuous {f : E3 → ℂ} (hf : Ccs f) : Continuous f := hf.1

/-- `Ccs` is closed under the analytic family on the whole closed strip. -/
theorem ccs_anFam {p p₀ p₁ : ℝ} (hp : 0 < p) (hp₀ : 0 < p₀) (hp₁ : 0 < p₁)
    {f : E3 → ℂ} (hf : Ccs f) {z : ℂ} (hz : z.re ∈ Set.Icc (0 : ℝ) 1) :
    Ccs (anFam p p₀ p₁ f z) :=
  ⟨continuous_anFam hf.1 (interpExp_re_pos hp hp₀ hp₁ hz), hasCompactSupport_anFam hf.2 z⟩


/-! ### Analyticity of parametric integrals

The remaining operator-side obligation of `lem:lebesgue-strip` is that
`z ↦ Tproj N R j (F z) y` be analytic. `Tproj` is built from two integrals, so what is needed is
that an integral of an entire family with locally uniform integrable bounds is entire. The
derivative bound required by `hasDerivAt_integral_of_dominated_loc_of_deriv_le` is *not* an extra
hypothesis: Cauchy's estimate turns the bound on the values into a bound on the derivative on a
smaller disc. -/

/-- **Cauchy's estimate**, in the form used below: a function holomorphic on the disc of radius
`3δ` about `z₀` and bounded by `C` on the disc of radius `2δ` has derivative bounded by `C / δ`
on the disc of radius `δ`. -/
theorem norm_deriv_le_of_bounded_on_ball {Φ : ℂ → ℂ} {z₀ : ℂ} {δ C : ℝ} (hδ : 0 < δ)
    (hΦ : DifferentiableOn ℂ Φ (Metric.ball z₀ (3 * δ)))
    (hC : ∀ w : ℂ, w ∈ Metric.closedBall z₀ (2 * δ) → ‖Φ w‖ ≤ C)
    {z : ℂ} (hz : z ∈ Metric.closedBall z₀ δ) : ‖deriv Φ z‖ ≤ C / δ := by
  have hzz : dist z z₀ ≤ δ := Metric.mem_closedBall.mp hz
  have hsub : Metric.closedBall z δ ⊆ Metric.closedBall z₀ (2 * δ) := by
    intro w hw
    rw [Metric.mem_closedBall] at hw ⊢
    calc dist w z₀ ≤ dist w z + dist z z₀ := dist_triangle _ _ _
      _ ≤ δ + δ := by linarith
      _ = 2 * δ := by ring
  have hsub3 : Metric.closedBall z δ ⊆ Metric.ball z₀ (3 * δ) := by
    intro w hw
    rw [Metric.mem_ball]
    have hw' : dist w z ≤ δ := Metric.mem_closedBall.mp hw
    calc dist w z₀ ≤ dist w z + dist z z₀ := dist_triangle _ _ _
      _ ≤ δ + δ := by linarith
      _ < 3 * δ := by linarith
  have hclos : closure (Metric.ball z δ) ⊆ Metric.closedBall z δ :=
    Metric.closure_ball_subset_closedBall
  have hdcc : DiffContOnCl ℂ Φ (Metric.ball z δ) := by
    refine ⟨hΦ.mono (fun w hw => hsub3 (Metric.ball_subset_closedBall hw)), ?_⟩
    exact (hΦ.mono (fun w hw => hsub3 (hclos hw))).continuousOn
  have h1 : ∀ w ∈ Metric.sphere z δ, ‖Φ w‖ ≤ C := by
    intro w hw
    exact hC w (hsub (Metric.sphere_subset_closedBall hw))
  have h := Complex.norm_iteratedDeriv_le_of_forall_mem_sphere_norm_le (f := Φ) (c := z)
    (R := δ) 1 hδ hdcc h1
  simpa [iteratedDeriv_one] using h

open MeasureTheory in
/-- The derivative of a family in the parameter is measurable, being the limit of difference
quotients. -/
theorem aestronglyMeasurable_deriv_at {β : Type*} [MeasurableSpace β] {μ : Measure β}
    {Φ : ℂ → β → ℂ} {z₀ : ℂ} (hent : ∀ b, DifferentiableAt ℂ (fun z => Φ z b) z₀)
    (hmeas : ∀ z : ℂ, AEStronglyMeasurable (Φ z) μ) :
    AEStronglyMeasurable (fun b => deriv (fun z => Φ z b) z₀) μ := by
  have hcne : ∀ n : ℕ, ((n : ℂ) + 1) ≠ 0 := fun n => Nat.cast_add_one_ne_zero n
  have hnorm : ∀ n : ℕ, ‖(((n : ℂ) + 1)⁻¹)‖ = 1 / ((n : ℝ) + 1) := by
    intro n
    have h1 : ((n : ℂ) + 1) = ((n + 1 : ℕ) : ℂ) := by push_cast; ring
    rw [norm_inv, h1, Complex.norm_natCast]
    push_cast
    ring
  have hc0 : Filter.Tendsto (fun n : ℕ => ((n : ℂ) + 1)⁻¹) Filter.atTop (nhds 0) := by
    refine tendsto_zero_iff_norm_tendsto_zero.mpr ?_
    simpa only [hnorm] using tendsto_one_div_add_atTop_nhds_zero_nat
  have hz : Filter.Tendsto (fun n : ℕ => z₀ + ((n : ℂ) + 1)⁻¹) Filter.atTop
      (nhdsWithin z₀ {z₀}ᶜ) := by
    rw [tendsto_nhdsWithin_iff]
    constructor
    · simpa using tendsto_const_nhds.add hc0
    · filter_upwards with n
      simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
      intro h
      exact inv_ne_zero (hcne n) (by simpa using h)
  refine aestronglyMeasurable_of_tendsto_ae (u := Filter.atTop)
    (f := fun n : ℕ => fun b => ((n : ℂ) + 1) * (Φ (z₀ + ((n : ℂ) + 1)⁻¹) b - Φ z₀ b)) ?_ ?_
  · intro n
    exact ((hmeas _).sub (hmeas z₀)).const_mul _
  · filter_upwards with b
    have hd : HasDerivAt (fun z => Φ z b) (deriv (fun z => Φ z b) z₀) z₀ := (hent b).hasDerivAt
    have hslope := hasDerivAt_iff_tendsto_slope.mp hd
    have := hslope.comp hz
    simpa [Function.comp_def, slope, inv_inv, smul_eq_mul] using this

open MeasureTheory in
/-- **An integral of a family holomorphic on a disc, with a uniform integrable bound there, is
differentiable at the centre.** The derivative bound needed for differentiation under the
integral sign is supplied by Cauchy's estimate, so only a bound on the values is assumed. -/
theorem differentiableAt_integral_of_bounded {β : Type*} [MeasurableSpace β] {μ : Measure β}
    {Φ : ℂ → β → ℂ} {z₀ : ℂ} {δ : ℝ} {bound : β → ℝ} (hδ : 0 < δ)
    (hent : ∀ b, DifferentiableOn ℂ (fun z => Φ z b) (Metric.ball z₀ (3 * δ)))
    (hmeas : ∀ z : ℂ, AEStronglyMeasurable (Φ z) μ)
    (hbi : Integrable bound μ)
    (hb : ∀ w : ℂ, w ∈ Metric.closedBall z₀ (2 * δ) → ∀ b, ‖Φ w b‖ ≤ bound b) :
    DifferentiableAt ℂ (fun z => ∫ b, Φ z b ∂μ) z₀ := by
  have hballmem : Metric.ball z₀ (3 * δ) ∈ nhds z₀ :=
    Metric.ball_mem_nhds z₀ (by linarith)
  have hdifat : ∀ b, DifferentiableAt ℂ (fun z => Φ z b) z₀ := fun b =>
    ((hent b).differentiableAt hballmem)
  have hz₀mem : z₀ ∈ Metric.closedBall z₀ (2 * δ) := by
    rw [Metric.mem_closedBall, dist_self]
    positivity
  have hint : Integrable (Φ z₀) μ := by
    refine Integrable.mono' hbi (hmeas z₀) ?_
    filter_upwards with b
    exact hb z₀ hz₀mem b
  have hbnd : ∀ᵐ b ∂μ, ∀ z ∈ Metric.ball z₀ δ,
      ‖deriv (fun w => Φ w b) z‖ ≤ bound b / δ := by
    filter_upwards with b
    intro z hzmem
    exact norm_deriv_le_of_bounded_on_ball hδ (hent b) (fun w hw => hb w hw b)
      (Metric.ball_subset_closedBall hzmem)
  have hdif : ∀ᵐ b ∂μ, ∀ z ∈ Metric.ball z₀ δ,
      HasDerivAt (fun w => Φ w b) (deriv (fun w => Φ w b) z) z := by
    filter_upwards with b
    intro z hzmem
    have hnb : Metric.ball z₀ (3 * δ) ∈ nhds z :=
      IsOpen.mem_nhds Metric.isOpen_ball
        (Metric.ball_subset_ball (by linarith) hzmem)
    exact ((hent b).differentiableAt hnb).hasDerivAt
  have hderiv := hasDerivAt_integral_of_dominated_loc_of_deriv_le (𝕜 := ℂ)
    (F := Φ) (x₀ := z₀) (s := Metric.ball z₀ δ)
    (F' := fun z b => deriv (fun w => Φ w b) z)
    (bound := fun b => bound b / δ)
    (Metric.ball_mem_nhds z₀ hδ)
    (Filter.Eventually.of_forall hmeas) hint
    (aestronglyMeasurable_deriv_at hdifat hmeas)
    hbnd (hbi.div_const δ) hdif
  exact hderiv.2.differentiableAt


/-! ### A uniform bound for the analytic family on a complex disc

`Auto.differentiableAt_integral_of_bounded` asks for a bound on the values of the family on a disc.
Since `‖anFam p p₀ p₁ u z x‖ = ‖u x‖ ^ re (a z)` and `re (a z)` is affine in `re z`, a bound on
`‖u‖` and a positive lower and an upper bound for `re (a z)` on the disc suffice. -/

/-- `s ^ r ≤ max 1 (B ^ r₂)` for `0 ≤ s ≤ B` and `0 ≤ r ≤ r₂`. -/
theorem rpow_le_max_one {s B r r₂ : ℝ} (hs : 0 ≤ s) (hsB : s ≤ B) (hr : 0 ≤ r) (hrr : r ≤ r₂) :
    s ^ r ≤ max 1 (B ^ r₂) := by
  rcases le_or_gt s 1 with h | h
  · exact le_trans (Real.rpow_le_one hs h hr) (le_max_left _ _)
  · refine le_trans ?_ (le_max_right _ _)
    calc s ^ r ≤ s ^ r₂ := Real.rpow_le_rpow_of_exponent_le h.le hrr
      _ ≤ B ^ r₂ := Real.rpow_le_rpow hs hsB (le_trans hr hrr)

/-- The real part of the exponent path is Lipschitz in `z`. -/
theorem abs_interpExp_re_sub {p p₀ p₁ : ℝ} (hp₀ : p₀ ≠ 0) (hp₁ : p₁ ≠ 0) (z w : ℂ) :
    |(interpExp p p₀ p₁ z).re - (interpExp p p₀ p₁ w).re|
      ≤ |p * (1 / p₁ - 1 / p₀)| * ‖z - w‖ := by
  rw [interpExp_re hp₀ hp₁, interpExp_re hp₀ hp₁]
  have h : p * ((1 - z.re) / p₀ + z.re / p₁) - p * ((1 - w.re) / p₀ + w.re / p₁)
      = p * (1 / p₁ - 1 / p₀) * (z.re - w.re) := by
    field_simp
    ring
  rw [h, abs_mul]
  refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
  have hre : z.re - w.re = (z - w).re := by simp
  rw [hre]
  exact Complex.abs_re_le_norm _

/-- The modulus of the family under a bound on `‖u‖` and two-sided bounds on the exponent. -/
theorem norm_anFam_le {p p₀ p₁ : ℝ} {α : Type*} {u : α → ℂ} {B r₁ r₂ : ℝ}
    (hu : ∀ x, ‖u x‖ ≤ B) {z : ℂ} (hr₁ : 0 < r₁) (h1 : r₁ ≤ (interpExp p p₀ p₁ z).re)
    (h2 : (interpExp p p₀ p₁ z).re ≤ r₂) (x : α) :
    ‖anFam p p₀ p₁ u z x‖ ≤ max 1 (B ^ r₂) := by
  rw [norm_anFam' (lt_of_lt_of_le hr₁ h1)]
  exact rpow_le_max_one (norm_nonneg _) (hu x) (le_trans hr₁.le h1) h2

/-- Around an interior point of the strip there is a disc on which the exponent stays in a
compact subinterval of `(0, ∞)`, so that the family is uniformly bounded there. -/
theorem exists_disc_bound {p p₀ p₁ : ℝ} (hp₀ : p₀ ≠ 0) (hp₁ : p₁ ≠ 0)
    {z₀ : ℂ} (hr₀pos : 0 < (interpExp p p₀ p₁ z₀).re) :
    ∃ δ r₂ : ℝ, 0 < δ ∧
      ∀ w : ℂ, w ∈ Metric.closedBall z₀ (2 * δ) →
        (interpExp p p₀ p₁ z₀).re / 2 ≤ (interpExp p p₀ p₁ w).re ∧
          (interpExp p p₀ p₁ w).re ≤ r₂ := by
  set r₀ : ℝ := (interpExp p p₀ p₁ z₀).re with hr₀def
  have hr₀ : 0 < r₀ := hr₀pos
  set κ : ℝ := |p * (1 / p₁ - 1 / p₀)| + 1 with hκdef
  have hκ : 0 < κ := by
    rw [hκdef]
    positivity
  refine ⟨r₀ / (4 * κ), r₀ + r₀ / 2, by positivity, fun w hw => ?_⟩
  have hdist : ‖w - z₀‖ ≤ 2 * (r₀ / (4 * κ)) := by
    rw [← Complex.dist_eq]
    exact Metric.mem_closedBall.mp hw
  have hle : |(interpExp p p₀ p₁ w).re - r₀| ≤ r₀ / 2 := by
    refine le_trans (abs_interpExp_re_sub hp₀ hp₁ w z₀) ?_
    have hb : |p * (1 / p₁ - 1 / p₀)| ≤ κ := by
      rw [hκdef]; linarith
    have h1 : |p * (1 / p₁ - 1 / p₀)| * ‖w - z₀‖ ≤ κ * (2 * (r₀ / (4 * κ))) :=
      mul_le_mul hb hdist (norm_nonneg _) hκ.le
    refine le_trans h1 (le_of_eq ?_)
    field_simp
    ring
  have h := abs_le.mp hle
  constructor
  · linarith [h.1]
  · linarith [h.2]


/-! ### Measurability of the analytic family, and analyticity of the projected family -/

open MeasureTheory in
/-- The one-coordinate projection of the analytic family is differentiable in the strip variable
at every interior point of the strip. -/
theorem differentiableAt_P_anFam {R : ℝ} (hR : 0 < R) (j : Fin 3) {p p₀ p₁ : ℝ}
    (hp : 0 < p) (hp₀ : 0 < p₀) (hp₁ : 0 < p₁)
    {g : E3 → ℂ} (hg : Continuous g) {B : ℝ} (hB : ∀ x, ‖g x‖ ≤ B)
    {z₀ : ℂ} (hz₀ : z₀.re ∈ Set.Ioo (0 : ℝ) 1) (x : E3) :
    DifferentiableAt ℂ (fun z => P R j (anFam p p₀ p₁ g z) x) z₀ := by
  obtain ⟨δ, r₂, hδ, hbd⟩ := exists_disc_bound (p := p) hp₀.ne' hp₁.ne'
    (interpExp_re_pos hp hp₀ hp₁ ⟨hz₀.1.le, hz₀.2.le⟩)
  have hr₀ : 0 < (interpExp p p₀ p₁ z₀).re :=
    interpExp_re_pos hp hp₀ hp₁ ⟨hz₀.1.le, hz₀.2.le⟩
  have hshift : Continuous fun u : ℝ => x - u • basisVec j := by fun_prop
  refine differentiableAt_integral_of_bounded (μ := (volume : Measure ℝ))
    (Φ := fun z u => projKernel R u * anFam p p₀ p₁ g z (x - u • basisVec j))
    (δ := δ) (bound := fun u => ‖projKernel R u‖ * max 1 (B ^ r₂)) hδ ?_ ?_ ?_ ?_
  · intro u
    exact ((differentiable_anFam p p₀ p₁ g (x - u • basisVec j)).const_mul _).differentiableOn
  · intro z
    refine ((projKernel_continuous R).aestronglyMeasurable).mul ?_
    exact (((measurable_anFam hg.measurable z).comp hshift.measurable)).aestronglyMeasurable
  · exact (projKernel_integrable hR).norm.mul_const _
  · intro w hw u
    rw [norm_mul]
    refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
    exact norm_anFam_le hB (by linarith : (0 : ℝ) < (interpExp p p₀ p₁ z₀).re / 2)
      (hbd w hw).1 (hbd w hw).2 _


open MeasureTheory in
/-- For every `z`, whether or not the exponent has positive real part, the projected family is
measurable: the Bochner integral of a jointly measurable integrand is measurable in the parameter
even where it fails to converge. -/
theorem stronglyMeasurable_P_anFam (R : ℝ) (j : Fin 3) {p p₀ p₁ : ℝ} {g : E3 → ℂ}
    (hg : Measurable g) (z : ℂ) :
    StronglyMeasurable fun x : E3 => P R j (anFam p p₀ p₁ g z) x := by
  have hjoint : StronglyMeasurable
      (fun w : E3 × ℝ => projKernel R w.2 * anFam p p₀ p₁ g z (w.1 - w.2 • basisVec j)) := by
    refine Measurable.stronglyMeasurable ?_
    refine ((projKernel_continuous R).measurable.comp measurable_snd).mul ?_
    refine (measurable_anFam hg z).comp ?_
    exact (by fun_prop : Continuous fun w : E3 × ℝ => w.1 - w.2 • basisVec j).measurable
  exact hjoint.integral_prod_right'

open MeasureTheory in
/-- The projected family obeys the same kind of uniform bound as the family, with the `L¹` norm
of the kernel as the extra factor. -/
theorem norm_P_anFam_le {R : ℝ} (hR : 0 < R) (j : Fin 3) {p p₀ p₁ : ℝ} {g : E3 → ℂ}
    (hg : Measurable g) {B r₁ r₂ : ℝ} (hB : ∀ x, ‖g x‖ ≤ B) {z : ℂ}
    (hr₁ : 0 < r₁) (h1 : r₁ ≤ (interpExp p p₀ p₁ z).re)
    (h2 : (interpExp p p₀ p₁ z).re ≤ r₂) (x : E3) :
    ‖P R j (anFam p p₀ p₁ g z) x‖ ≤ (∫ u : ℝ, ‖projKernel R u‖) * max 1 (B ^ r₂) := by
  have hbd : ∀ u : ℝ, ‖projKernel R u * anFam p p₀ p₁ g z (x - u • basisVec j)‖
      ≤ ‖projKernel R u‖ * max 1 (B ^ r₂) := by
    intro u
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (norm_anFam_le hB hr₁ h1 h2 _) (norm_nonneg _)
  have hint : Integrable fun u : ℝ => ‖projKernel R u‖ * max 1 (B ^ r₂) :=
    (projKernel_integrable hR).norm.mul_const _
  have hmeas : AEStronglyMeasurable
      (fun u : ℝ => ‖projKernel R u * anFam p p₀ p₁ g z (x - u • basisVec j)‖) volume := by
    refine (Measurable.stronglyMeasurable ?_).aestronglyMeasurable
    refine (((projKernel_continuous R).measurable).mul ?_).norm
    exact (measurable_anFam hg z).comp (by fun_prop : Continuous fun u : ℝ =>
      x - u • basisVec j).measurable
  have hint2 : Integrable
      fun u : ℝ => ‖projKernel R u * anFam p p₀ p₁ g z (x - u • basisVec j)‖ := by
    refine Integrable.mono' hint hmeas (Filter.Eventually.of_forall fun u => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
    exact hbd u
  calc ‖P R j (anFam p p₀ p₁ g z) x‖
      ≤ ∫ u : ℝ, ‖projKernel R u * anFam p p₀ p₁ g z (x - u • basisVec j)‖ :=
        norm_integral_le_integral_norm _
    _ ≤ ∫ u : ℝ, ‖projKernel R u‖ * max 1 (B ^ r₂) := integral_mono hint2 hint hbd
    _ = (∫ u : ℝ, ‖projKernel R u‖) * max 1 (B ^ r₂) := integral_mul_const _ _


open MeasureTheory in
/-- **The composed family is holomorphic in the strip variable.** This is the analyticity
hypothesis of `Auto.interpolate_of_analyticFamily` for the operator `Auto.Tproj`. Each of the
three factors of the averaged product is holomorphic on a disc about an interior point of the
strip and bounded there, and the `t`-average is over a finite interval, so
`Auto.differentiableAt_integral_of_bounded` applies. -/
theorem differentiableAt_Tproj_anFam {N R : ℝ} (hN : 0 ≤ N) (hR : 0 < R) (j : Fin 3)
    {p p₀ p₁ : Fin 3 → ℝ} (hp : ∀ i, 0 < p i) (hp₀ : ∀ i, 0 < p₀ i) (hp₁ : ∀ i, 0 < p₁ i)
    {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Ccs (f i))
    {z₀ : ℂ} (hz₀ : z₀.re ∈ Set.Ioo (0 : ℝ) 1) (y : E3) :
    DifferentiableAt ℂ
      (fun z => Tproj N R j (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) z) y) z₀ := by
  classical
  have hR4 : (0 : ℝ) < 4 * R := by linarith
  -- bounds for the data
  have hexB : ∀ i : Fin 3, ∃ B : ℝ, ∀ x, ‖f i x‖ ≤ B := fun i => (hf i).nice.2.2
  choose Bv hBv using hexB
  -- the exponent stays in a compact subinterval of `(0, ∞)` on a disc
  have hex : ∀ i : Fin 3, ∃ δ r₂ : ℝ, 0 < δ ∧
      ∀ w : ℂ, w ∈ Metric.closedBall z₀ (2 * δ) →
        (interpExp (p i) (p₀ i) (p₁ i) z₀).re / 2 ≤ (interpExp (p i) (p₀ i) (p₁ i) w).re ∧
          (interpExp (p i) (p₀ i) (p₁ i) w).re ≤ r₂ :=
    fun i => exists_disc_bound (hp₀ i).ne' (hp₁ i).ne'
      (interpExp_re_pos (hp i) (hp₀ i) (hp₁ i) ⟨hz₀.1.le, hz₀.2.le⟩)
  choose dv r2v hdv hbdv using hex
  have hr0 : ∀ i : Fin 3, 0 < (interpExp (p i) (p₀ i) (p₁ i) z₀).re / 2 := fun i => by
    have := interpExp_re_pos (hp i) (hp₀ i) (hp₁ i) ⟨hz₀.1.le, hz₀.2.le⟩
    linarith
  set σ : ℝ := min z₀.re (1 - z₀.re) / 4 with hσdef
  have hσ : 0 < σ := by
    have h1 : 0 < min z₀.re (1 - z₀.re) := lt_min hz₀.1 (by linarith [hz₀.2])
    rw [hσdef]; linarith
  set δ : ℝ := min (min (dv 0) (min (dv 1) (dv 2))) σ with hδdef
  have hδ : 0 < δ := by
    rw [hδdef]
    exact lt_min (lt_min (hdv 0) (lt_min (hdv 1) (hdv 2))) hσ
  have hδdv : ∀ i : Fin 3, δ ≤ dv i := by
    intro i
    have hle : δ ≤ min (dv 0) (min (dv 1) (dv 2)) := by rw [hδdef]; exact min_le_left _ _
    fin_cases i
    · exact hle.trans (min_le_left _ _)
    · exact hle.trans ((min_le_right _ _).trans (min_le_left _ _))
    · exact hle.trans ((min_le_right _ _).trans (min_le_right _ _))
  have hδσ : δ ≤ σ := by rw [hδdef]; exact min_le_right _ _
  -- the ball of radius `3δ` stays inside the open strip
  have hstrip : ∀ w : ℂ, w ∈ Metric.ball z₀ (3 * δ) → w.re ∈ Set.Ioo (0 : ℝ) 1 := by
    intro w hw
    have hd : ‖w - z₀‖ < 3 * δ := by rwa [← Complex.dist_eq, ← Metric.mem_ball]
    have hre : |w.re - z₀.re| ≤ ‖w - z₀‖ := by
      have h : w.re - z₀.re = (w - z₀).re := by simp
      rw [h]
      exact Complex.abs_re_le_norm _
    have hm1 : min z₀.re (1 - z₀.re) ≤ z₀.re := min_le_left _ _
    have hm2 : min z₀.re (1 - z₀.re) ≤ 1 - z₀.re := min_le_right _ _
    have hlt : |w.re - z₀.re| < min z₀.re (1 - z₀.re) := by
      have h3 : 3 * δ ≤ 3 * σ := by linarith
      have h4 : 3 * σ < min z₀.re (1 - z₀.re) := by
        rw [hσdef]
        have h1 : 0 < min z₀.re (1 - z₀.re) := lt_min hz₀.1 (by linarith [hz₀.2])
        linarith
      linarith
    have hab := abs_lt.mp hlt
    constructor <;> linarith [hab.1, hab.2]
  -- rewrite the operator as an integral over a finite interval
  have hrw : ∀ z : ℂ, Tproj N R j (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) z) y
      = (N : ℂ)⁻¹ * ∫ t in Set.Ioc (0 : ℝ) N,
          ∏ i, (Function.update (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) z) j
            (Q R j (anFam (p j) (p₀ j) (p₁ j) (f j) z))) i (y + curve i t) := by
    intro z
    simp only [Tproj, A, prodShift]
    rw [intervalIntegral.integral_of_le hN]
  simp only [hrw]
  refine DifferentiableAt.const_mul ?_ _
  -- the constants
  set Cb : Fin 3 → ℝ := fun i =>
    if i = j then max 1 (Bv j ^ r2v j) * (1 + ∫ u : ℝ, ‖projKernel (4 * R) u‖)
    else max 1 (Bv i ^ r2v i) with hCbdef
  have hKnn : (0 : ℝ) ≤ ∫ u : ℝ, ‖projKernel (4 * R) u‖ :=
    integral_nonneg fun u => norm_nonneg _
  have hCb0 : ∀ i, 0 ≤ Cb i := by
    intro i
    rw [hCbdef]
    by_cases h : i = j
    · simp only [h]
      have : (0 : ℝ) ≤ max 1 (Bv j ^ r2v j) := le_trans zero_le_one (le_max_left _ _)
      positivity
    · simp only [ite_eq_right h]
      exact le_trans zero_le_one (le_max_left _ _)
  -- the factorwise bound
  have hfac : ∀ w : ℂ, w ∈ Metric.closedBall z₀ (2 * δ) → ∀ (t : ℝ) (i : Fin 3),
      ‖(Function.update (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) w) j
        (Q R j (anFam (p j) (p₀ j) (p₁ j) (f j) w))) i (y + curve i t)‖ ≤ Cb i := by
    intro w hw t i
    have hwi : ∀ k : Fin 3, w ∈ Metric.closedBall z₀ (2 * dv k) := fun k =>
      Metric.closedBall_subset_closedBall (by linarith [hδdv k]) hw
    by_cases h : i = j
    · subst h
      rw [Function.update_self, hCbdef]
      simp only []
      have h1 : ‖anFam (p i) (p₀ i) (p₁ i) (f i) w (y + curve i t)‖ ≤ max 1 (Bv i ^ r2v i) :=
        norm_anFam_le (hBv i) (hr0 i) (hbdv i w (hwi i)).1 (hbdv i w (hwi i)).2 _
      have h2 : ‖P (4 * R) i (anFam (p i) (p₀ i) (p₁ i) (f i) w) (y + curve i t)‖
          ≤ (∫ u : ℝ, ‖projKernel (4 * R) u‖) * max 1 (Bv i ^ r2v i) :=
        norm_P_anFam_le hR4 i (hf i).1.measurable (hBv i) (hr0 i)
          (hbdv i w (hwi i)).1 (hbdv i w (hwi i)).2 _
      calc ‖Q R i (anFam (p i) (p₀ i) (p₁ i) (f i) w) (y + curve i t)‖
          ≤ ‖anFam (p i) (p₀ i) (p₁ i) (f i) w (y + curve i t)‖
            + ‖P (4 * R) i (anFam (p i) (p₀ i) (p₁ i) (f i) w) (y + curve i t)‖ := by
            rw [Q]
            exact norm_sub_le _ _
        _ ≤ max 1 (Bv i ^ r2v i) + (∫ u : ℝ, ‖projKernel (4 * R) u‖) * max 1 (Bv i ^ r2v i) := by
            linarith
        _ = max 1 (Bv i ^ r2v i) * (1 + ∫ u : ℝ, ‖projKernel (4 * R) u‖) := by ring
    · rw [Function.update_of_ne h, hCbdef]
      simp only [ite_eq_right h]
      exact norm_anFam_le (hBv i) (hr0 i) (hbdv i w (hwi i)).1 (hbdv i w (hwi i)).2 _
  refine differentiableAt_integral_of_bounded (μ := volume.restrict (Set.Ioc (0 : ℝ) N))
    (δ := δ) (bound := fun _ => ∏ i, Cb i) hδ ?_ ?_ ?_ ?_
  · -- holomorphy of the integrand
    intro t
    refine DifferentiableOn.fun_finsetProd (𝕜 := ℂ) (fun i _ => ?_)
    by_cases h : i = j
    · subst h
      simp only [Function.update_self, Q]
      refine DifferentiableOn.sub ?_ ?_
      · exact ((differentiable_anFam (p i) (p₀ i) (p₁ i) (f i) (y + curve i t))).differentiableOn
      · intro w hw
        exact (differentiableAt_P_anFam hR4 i (hp i) (hp₀ i) (hp₁ i) (hf i).1 (hBv i)
          (hstrip w hw) (y + curve i t)).differentiableWithinAt
    · simp only [Function.update_of_ne h]
      exact ((differentiable_anFam (p i) (p₀ i) (p₁ i) (f i) (y + curve i t))).differentiableOn
  · -- measurability of the integrand
    intro z
    refine AEStronglyMeasurable.restrict ?_
    refine (Measurable.stronglyMeasurable ?_).aestronglyMeasurable
    refine Finset.measurable_prod _ (fun i _ => ?_)
    by_cases h : i = j
    · subst h
      simp only [Function.update_self, Q]
      refine Measurable.sub ?_ ?_
      · exact (measurable_anFam (hf i).1.measurable z).comp
          (continuous_const.add (continuous_curve i)).measurable
      · exact ((stronglyMeasurable_P_anFam (4 * R) i (hf i).1.measurable z).measurable).comp
          (continuous_const.add (continuous_curve i)).measurable
    · simp only [Function.update_of_ne h]
      exact (measurable_anFam (hf i).1.measurable z).comp
        (continuous_const.add (continuous_curve i)).measurable
  · exact integrable_const _
  · -- the uniform bound
    intro w hw t
    refine le_trans (Finset.norm_prod_le _ _) ?_
    exact Finset.prod_le_prod₀ (fun i _ => norm_nonneg _) (fun i _ => hfac w hw t i)


/-! ### Uniform bounds and continuity on the closed strip

`Auto.interpolate_of_analyticFamily` also asks for continuity of the composed family on the
*closed* strip and a bound there. On the closed strip the exponent `re (a z)` is an affine
function of `re z` lying between `p * min p₀⁻¹ p₁⁻¹ > 0` and `p * (p₀⁻¹ + p₁⁻¹)`, so the bound of
`Auto.norm_anFam_le` holds with constants that do not depend on `z`. -/
theorem interpExp_re_ge {p p₀ p₁ : ℝ} (hp : 0 < p) (hp₀ : 0 < p₀) (hp₁ : 0 < p₁) {z : ℂ}
    (hz : z.re ∈ Set.Icc (0 : ℝ) 1) : p * min p₀⁻¹ p₁⁻¹ ≤ (interpExp p p₀ p₁ z).re := by
  obtain ⟨h0, h1⟩ := hz
  rw [interpExp_re hp₀.ne' hp₁.ne']
  refine mul_le_mul_of_nonneg_left ?_ hp.le
  have e1 : (1 - z.re) / p₀ = (1 - z.re) * p₀⁻¹ := by ring
  have e2 : z.re / p₁ = z.re * p₁⁻¹ := by ring
  rw [e1, e2]
  have hA : (1 - z.re) * min p₀⁻¹ p₁⁻¹ ≤ (1 - z.re) * p₀⁻¹ :=
    mul_le_mul_of_nonneg_left (min_le_left _ _) (by linarith)
  have hB : z.re * min p₀⁻¹ p₁⁻¹ ≤ z.re * p₁⁻¹ :=
    mul_le_mul_of_nonneg_left (min_le_right _ _) h0
  have key : (1 - z.re) * min p₀⁻¹ p₁⁻¹ + z.re * min p₀⁻¹ p₁⁻¹ = min p₀⁻¹ p₁⁻¹ := by ring
  linarith

theorem interpExp_re_le {p p₀ p₁ : ℝ} (hp : 0 < p) (hp₀ : 0 < p₀) (hp₁ : 0 < p₁) {z : ℂ}
    (hz : z.re ∈ Set.Icc (0 : ℝ) 1) : (interpExp p p₀ p₁ z).re ≤ p * (p₀⁻¹ + p₁⁻¹) := by
  obtain ⟨h0, h1⟩ := hz
  rw [interpExp_re hp₀.ne' hp₁.ne']
  refine mul_le_mul_of_nonneg_left ?_ hp.le
  have e1 : (1 - z.re) / p₀ = (1 - z.re) * p₀⁻¹ := by ring
  have e2 : z.re / p₁ = z.re * p₁⁻¹ := by ring
  rw [e1, e2]
  have hA : (1 - z.re) * p₀⁻¹ ≤ 1 * p₀⁻¹ :=
    mul_le_mul_of_nonneg_right (by linarith) (inv_pos.mpr hp₀).le
  have hB : z.re * p₁⁻¹ ≤ 1 * p₁⁻¹ :=
    mul_le_mul_of_nonneg_right h1 (inv_pos.mpr hp₁).le
  linarith

theorem interpExp_re_pos_strip {p p₀ p₁ : ℝ} (hp : 0 < p) (hp₀ : 0 < p₀) (hp₁ : 0 < p₁) :
    0 < p * min p₀⁻¹ p₁⁻¹ :=
  mul_pos hp (lt_min (inv_pos.mpr hp₀) (inv_pos.mpr hp₁))

/-- A bound for the family that is uniform over the whole closed strip. -/
theorem norm_anFam_strip_le {p p₀ p₁ : ℝ} (hp : 0 < p) (hp₀ : 0 < p₀) (hp₁ : 0 < p₁)
    {α : Type*} {u : α → ℂ} {B : ℝ} (hu : ∀ x, ‖u x‖ ≤ B)
    {z : ℂ} (hz : z.re ∈ Set.Icc (0 : ℝ) 1) (x : α) :
    ‖anFam p p₀ p₁ u z x‖ ≤ max 1 (B ^ (p * (p₀⁻¹ + p₁⁻¹))) :=
  norm_anFam_le hu (interpExp_re_pos_strip hp hp₀ hp₁) (interpExp_re_ge hp hp₀ hp₁ hz)
    (interpExp_re_le hp hp₀ hp₁ hz) x

/-- The same for the projected family. -/
theorem norm_P_anFam_strip_le {R : ℝ} (hR : 0 < R) (j : Fin 3) {p p₀ p₁ : ℝ}
    (hp : 0 < p) (hp₀ : 0 < p₀) (hp₁ : 0 < p₁) {g : E3 → ℂ} (hg : Measurable g) {B : ℝ}
    (hB : ∀ x, ‖g x‖ ≤ B) {z : ℂ} (hz : z.re ∈ Set.Icc (0 : ℝ) 1) (x : E3) :
    ‖P R j (anFam p p₀ p₁ g z) x‖
      ≤ (∫ u : ℝ, ‖projKernel R u‖) * max 1 (B ^ (p * (p₀⁻¹ + p₁⁻¹))) :=
  norm_P_anFam_le hR j hg hB (interpExp_re_pos_strip hp hp₀ hp₁)
    (interpExp_re_ge hp hp₀ hp₁ hz) (interpExp_re_le hp hp₀ hp₁ hz) x

open MeasureTheory in
/-- The projected family is continuous in the strip variable wherever the exponent has positive
real part, in particular on a neighbourhood of the closed strip. -/
theorem continuousAt_P_anFam {R : ℝ} (hR : 0 < R) (j : Fin 3) {p p₀ p₁ : ℝ}
    (hp₀ : 0 < p₀) (hp₁ : 0 < p₁) {g : E3 → ℂ} (hg : Continuous g) {B : ℝ}
    (hB : ∀ x, ‖g x‖ ≤ B) {z₀ : ℂ} (hr₀ : 0 < (interpExp p p₀ p₁ z₀).re) (x : E3) :
    ContinuousAt (fun z => P R j (anFam p p₀ p₁ g z) x) z₀ := by
  obtain ⟨δ, r₂, hδ, hbd⟩ := exists_disc_bound hp₀.ne' hp₁.ne' hr₀
  have hshift : Continuous fun u : ℝ => x - u • basisVec j := by fun_prop
  refine continuousAt_of_dominated
    (F := fun z u => projKernel R u * anFam p p₀ p₁ g z (x - u • basisVec j))
    (bound := fun u => ‖projKernel R u‖ * max 1 (B ^ r₂)) ?_ ?_ ?_ ?_
  · filter_upwards with z
    refine ((projKernel_continuous R).aestronglyMeasurable).mul ?_
    exact (((measurable_anFam hg.measurable z).comp hshift.measurable)).aestronglyMeasurable
  · filter_upwards [Metric.closedBall_mem_nhds z₀ (by linarith : (0 : ℝ) < 2 * δ)] with z hz
    filter_upwards with u
    rw [norm_mul]
    refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
    exact norm_anFam_le hB (by linarith : (0 : ℝ) < (interpExp p p₀ p₁ z₀).re / 2)
      (hbd z hz).1 (hbd z hz).2 _
  · exact (projKernel_integrable hR).norm.mul_const _
  · filter_upwards with u
    exact ContinuousAt.const_mul
      ((differentiable_anFam p p₀ p₁ g (x - u • basisVec j)).continuous.continuousAt) _


open MeasureTheory in
/-- **The composed family is bounded on the closed strip, uniformly in the output point.** This
is the boundedness hypothesis of `Auto.interpolate_of_analyticFamily`. -/
theorem exists_bound_Tproj_anFam {N R : ℝ} (hR : 0 < R) (j : Fin 3)
    {p p₀ p₁ : Fin 3 → ℝ} (hp : ∀ i, 0 < p i) (hp₀ : ∀ i, 0 < p₀ i) (hp₁ : ∀ i, 0 < p₁ i)
    {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Ccs (f i)) :
    ∃ C : ℝ, ∀ (y : E3) (z : ℂ), z.re ∈ Set.Icc (0 : ℝ) 1 →
      ‖Tproj N R j (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) z) y‖ ≤ C := by
  classical
  have hR4 : (0 : ℝ) < 4 * R := by linarith
  have hexB : ∀ i : Fin 3, ∃ B : ℝ, ∀ x, ‖f i x‖ ≤ B := fun i => (hf i).nice.2.2
  choose Bv hBv using hexB
  set e : Fin 3 → ℝ := fun i => p i * ((p₀ i)⁻¹ + (p₁ i)⁻¹) with hedef
  set Cb : Fin 3 → ℝ := fun i =>
    if i = j then max 1 (Bv j ^ e j) * (1 + ∫ u : ℝ, ‖projKernel (4 * R) u‖)
    else max 1 (Bv i ^ e i) with hCbdef
  have hKnn : (0 : ℝ) ≤ ∫ u : ℝ, ‖projKernel (4 * R) u‖ := integral_nonneg fun u => norm_nonneg _
  refine ⟨‖(N : ℂ)⁻¹‖ * ((∏ i, Cb i) * |N|), fun y z hz => ?_⟩
  have hfac : ∀ (t : ℝ) (i : Fin 3),
      ‖(Function.update (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) z) j
        (Q R j (anFam (p j) (p₀ j) (p₁ j) (f j) z))) i (y + curve i t)‖ ≤ Cb i := by
    intro t i
    by_cases h : i = j
    · subst h
      rw [Function.update_self, hCbdef]
      simp only []
      have h1 : ‖anFam (p i) (p₀ i) (p₁ i) (f i) z (y + curve i t)‖ ≤ max 1 (Bv i ^ e i) :=
        norm_anFam_strip_le (hp i) (hp₀ i) (hp₁ i) (hBv i) hz _
      have h2 : ‖P (4 * R) i (anFam (p i) (p₀ i) (p₁ i) (f i) z) (y + curve i t)‖
          ≤ (∫ u : ℝ, ‖projKernel (4 * R) u‖) * max 1 (Bv i ^ e i) :=
        norm_P_anFam_strip_le hR4 i (hp i) (hp₀ i) (hp₁ i) (hf i).1.measurable (hBv i) hz _
      calc ‖Q R i (anFam (p i) (p₀ i) (p₁ i) (f i) z) (y + curve i t)‖
          ≤ ‖anFam (p i) (p₀ i) (p₁ i) (f i) z (y + curve i t)‖
            + ‖P (4 * R) i (anFam (p i) (p₀ i) (p₁ i) (f i) z) (y + curve i t)‖ := by
            rw [Q]
            exact norm_sub_le _ _
        _ ≤ max 1 (Bv i ^ e i) + (∫ u : ℝ, ‖projKernel (4 * R) u‖) * max 1 (Bv i ^ e i) := by
            linarith
        _ = max 1 (Bv i ^ e i) * (1 + ∫ u : ℝ, ‖projKernel (4 * R) u‖) := by ring
    · rw [Function.update_of_ne h, hCbdef]
      simp only [ite_eq_right h]
      exact norm_anFam_strip_le (hp i) (hp₀ i) (hp₁ i) (hBv i) hz _
  have hprod : ∀ t : ℝ,
      ‖prodShift (Function.update (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) z) j
        (Q R j (anFam (p j) (p₀ j) (p₁ j) (f j) z))) y t‖ ≤ ∏ i, Cb i := by
    intro t
    rw [prodShift]
    refine le_trans (Finset.norm_prod_le _ _) ?_
    exact Finset.prod_le_prod₀ (fun i _ => norm_nonneg _) (fun i _ => hfac t i)
  rw [Tproj, A, norm_mul]
  refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
  have hb := intervalIntegral.norm_integral_le_of_norm_le_const
    (a := (0 : ℝ)) (b := N) (C := ∏ i, Cb i) (fun t _ => hprod t)
  simpa using hb

open MeasureTheory in
/-- **The composed family is continuous on the closed strip.** This is the continuity hypothesis
of `Auto.interpolate_of_analyticFamily`; the bound is taken on a disc about the point, which for a
point of an edge sticks out of the strip, so `Auto.exists_disc_bound` is used rather than the
uniform bound of `Auto.norm_anFam_strip_le`. -/
theorem continuousAt_Tproj_anFam {N R : ℝ} (hN : 0 ≤ N) (hR : 0 < R) (j : Fin 3)
    {p p₀ p₁ : Fin 3 → ℝ} (hp : ∀ i, 0 < p i) (hp₀ : ∀ i, 0 < p₀ i) (hp₁ : ∀ i, 0 < p₁ i)
    {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Ccs (f i))
    {z₀ : ℂ} (hz₀ : z₀.re ∈ Set.Icc (0 : ℝ) 1) (y : E3) :
    ContinuousAt (fun z => Tproj N R j (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) z) y) z₀ := by
  classical
  have hR4 : (0 : ℝ) < 4 * R := by linarith
  have hexB : ∀ i : Fin 3, ∃ B : ℝ, ∀ x, ‖f i x‖ ≤ B := fun i => (hf i).nice.2.2
  choose Bv hBv using hexB
  have hr0 : ∀ i : Fin 3, 0 < (interpExp (p i) (p₀ i) (p₁ i) z₀).re := fun i =>
    interpExp_re_pos (hp i) (hp₀ i) (hp₁ i) hz₀
  have hex : ∀ i : Fin 3, ∃ δ r₂ : ℝ, 0 < δ ∧
      ∀ w : ℂ, w ∈ Metric.closedBall z₀ (2 * δ) →
        (interpExp (p i) (p₀ i) (p₁ i) z₀).re / 2 ≤ (interpExp (p i) (p₀ i) (p₁ i) w).re ∧
          (interpExp (p i) (p₀ i) (p₁ i) w).re ≤ r₂ :=
    fun i => exists_disc_bound (hp₀ i).ne' (hp₁ i).ne' (hr0 i)
  choose dv r2v hdv hbdv using hex
  set δ : ℝ := min (dv 0) (min (dv 1) (dv 2)) with hδdef
  have hδ : 0 < δ := by
    rw [hδdef]
    exact lt_min (hdv 0) (lt_min (hdv 1) (hdv 2))
  have hδdv : ∀ i : Fin 3, δ ≤ dv i := by
    intro i
    fin_cases i
    · rw [hδdef]; exact min_le_left _ _
    · rw [hδdef]; exact (min_le_right _ _).trans (min_le_left _ _)
    · rw [hδdef]; exact (min_le_right _ _).trans (min_le_right _ _)
  set Cb : Fin 3 → ℝ := fun i =>
    if i = j then max 1 (Bv j ^ r2v j) * (1 + ∫ u : ℝ, ‖projKernel (4 * R) u‖)
    else max 1 (Bv i ^ r2v i) with hCbdef
  have hKnn : (0 : ℝ) ≤ ∫ u : ℝ, ‖projKernel (4 * R) u‖ := integral_nonneg fun u => norm_nonneg _
  have hfac : ∀ w : ℂ, w ∈ Metric.closedBall z₀ (2 * δ) → ∀ (t : ℝ) (i : Fin 3),
      ‖(Function.update (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) w) j
        (Q R j (anFam (p j) (p₀ j) (p₁ j) (f j) w))) i (y + curve i t)‖ ≤ Cb i := by
    intro w hw t i
    have hwi : ∀ k : Fin 3, w ∈ Metric.closedBall z₀ (2 * dv k) := fun k =>
      Metric.closedBall_subset_closedBall (by linarith [hδdv k]) hw
    have hpos : ∀ k : Fin 3, (0 : ℝ) < (interpExp (p k) (p₀ k) (p₁ k) z₀).re / 2 := fun k => by
      linarith [hr0 k]
    by_cases h : i = j
    · subst h
      rw [Function.update_self, hCbdef]
      simp only []
      have h1 : ‖anFam (p i) (p₀ i) (p₁ i) (f i) w (y + curve i t)‖ ≤ max 1 (Bv i ^ r2v i) :=
        norm_anFam_le (hBv i) (hpos i) (hbdv i w (hwi i)).1 (hbdv i w (hwi i)).2 _
      have h2 : ‖P (4 * R) i (anFam (p i) (p₀ i) (p₁ i) (f i) w) (y + curve i t)‖
          ≤ (∫ u : ℝ, ‖projKernel (4 * R) u‖) * max 1 (Bv i ^ r2v i) :=
        norm_P_anFam_le hR4 i (hf i).1.measurable (hBv i) (hpos i)
          (hbdv i w (hwi i)).1 (hbdv i w (hwi i)).2 _
      calc ‖Q R i (anFam (p i) (p₀ i) (p₁ i) (f i) w) (y + curve i t)‖
          ≤ ‖anFam (p i) (p₀ i) (p₁ i) (f i) w (y + curve i t)‖
            + ‖P (4 * R) i (anFam (p i) (p₀ i) (p₁ i) (f i) w) (y + curve i t)‖ := by
            rw [Q]
            exact norm_sub_le _ _
        _ ≤ max 1 (Bv i ^ r2v i) + (∫ u : ℝ, ‖projKernel (4 * R) u‖) * max 1 (Bv i ^ r2v i) := by
            linarith
        _ = max 1 (Bv i ^ r2v i) * (1 + ∫ u : ℝ, ‖projKernel (4 * R) u‖) := by ring
    · rw [Function.update_of_ne h, hCbdef]
      simp only [ite_eq_right h]
      exact norm_anFam_le (hBv i) (hpos i) (hbdv i w (hwi i)).1 (hbdv i w (hwi i)).2 _
  have hrw : ∀ z : ℂ, Tproj N R j (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) z) y
      = (N : ℂ)⁻¹ * ∫ t in Set.Ioc (0 : ℝ) N,
          ∏ i, (Function.update (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) z) j
            (Q R j (anFam (p j) (p₀ j) (p₁ j) (f j) z))) i (y + curve i t) := by
    intro z
    simp only [Tproj, A, prodShift]
    rw [intervalIntegral.integral_of_le hN]
  simp only [hrw]
  refine ContinuousAt.const_mul ?_ _
  refine continuousAt_of_dominated (bound := fun _ => ∏ i, Cb i) ?_ ?_ ?_ ?_
  · filter_upwards with z
    refine AEStronglyMeasurable.restrict ?_
    refine (Measurable.stronglyMeasurable ?_).aestronglyMeasurable
    refine Finset.measurable_prod _ (fun i _ => ?_)
    by_cases h : i = j
    · subst h
      simp only [Function.update_self, Q]
      refine Measurable.sub ?_ ?_
      · exact (measurable_anFam (hf i).1.measurable z).comp
          (continuous_const.add (continuous_curve i)).measurable
      · exact ((stronglyMeasurable_P_anFam (4 * R) i (hf i).1.measurable z).measurable).comp
          (continuous_const.add (continuous_curve i)).measurable
    · simp only [Function.update_of_ne h]
      exact (measurable_anFam (hf i).1.measurable z).comp
        (continuous_const.add (continuous_curve i)).measurable
  · filter_upwards [Metric.closedBall_mem_nhds z₀ (by linarith : (0 : ℝ) < 2 * δ)] with w hw
    filter_upwards with t
    refine le_trans (Finset.norm_prod_le _ _) ?_
    exact Finset.prod_le_prod₀ (fun i _ => norm_nonneg _) (fun i _ => hfac w hw t i)
  · exact integrable_const _
  · filter_upwards with t
    refine tendsto_finsetProd _ (fun i _ => ?_)
    by_cases h : i = j
    · subst h
      simp only [Function.update_self, Q]
      refine ContinuousAt.sub ?_ ?_
      · exact ((differentiable_anFam (p i) (p₀ i) (p₁ i) (f i)
          (y + curve i t)).continuous.continuousAt)
      · exact continuousAt_P_anFam hR4 i (hp₀ i) (hp₁ i) (hf i).1 (hBv i) (hr0 i) _
    · simp only [Function.update_of_ne h]
      exact ((differentiable_anFam (p i) (p₀ i) (p₁ i) (f i)
        (y + curve i t)).continuous.continuousAt)



/-! ### Joint measurability of the composed family

The last hypothesis of `Auto.interpolate_of_analyticFamily` is joint measurability in the output
point and the boundary parameter. It is obtained from joint measurability of `Auto.anFam` in
`(z, x)`, which holds for every `z`, and from
`MeasureTheory.StronglyMeasurable.integral_prod_right'`, which needs no integrability. -/
theorem measurable_anFam_uncurry {p p₀ p₁ : ℝ} {α : Type*} [MeasurableSpace α] {g : α → ℂ}
    (hg : Measurable g) : Measurable fun w : ℂ × α => anFam p p₀ p₁ g w.1 w.2 := by
  unfold anFam
  refine ((measurable_ph.comp hg).comp measurable_snd).mul (Complex.measurable_exp.comp ?_)
  refine Measurable.mul ?_ ?_
  · exact ((differentiable_interpExp p p₀ p₁).continuous.measurable).comp measurable_fst
  · exact Complex.measurable_ofReal.comp
      ((Real.measurable_log.comp hg.norm).comp measurable_snd)

open MeasureTheory in
theorem stronglyMeasurable_P_anFam_uncurry (R : ℝ) (j : Fin 3) {p p₀ p₁ : ℝ} {g : E3 → ℂ}
    (hg : Measurable g) :
    StronglyMeasurable fun w : ℂ × E3 => P R j (anFam p p₀ p₁ g w.1) w.2 := by
  have hmap : Measurable
      fun q : (ℂ × E3) × ℝ => ((q.1.1, q.1.2 - q.2 • basisVec j) : ℂ × E3) := by
    refine Measurable.prodMk (measurable_fst.comp measurable_fst) ?_
    exact (by fun_prop : Continuous fun q : (ℂ × E3) × ℝ => q.1.2 - q.2 • basisVec j).measurable
  have hcomp : Measurable ((fun w : ℂ × E3 => anFam p p₀ p₁ g w.1 w.2)
      ∘ fun q : (ℂ × E3) × ℝ => ((q.1.1, q.1.2 - q.2 • basisVec j) : ℂ × E3)) :=
    (measurable_anFam_uncurry hg).comp hmap
  have hjoint : StronglyMeasurable
      (fun q : (ℂ × E3) × ℝ =>
        projKernel R q.2 * anFam p p₀ p₁ g q.1.1 (q.1.2 - q.2 • basisVec j)) := by
    refine Measurable.stronglyMeasurable ?_
    exact ((projKernel_continuous R).measurable.comp measurable_snd).mul hcomp
  exact hjoint.integral_prod_right'

open MeasureTheory in
/-- Joint measurability of the composed family along a continuous path in the strip variable;
applied with `edge t = i t` and with `edge t = 1 + i t`. -/
theorem aestronglyMeasurable_Tproj_anFam {N R : ℝ} (hN : 0 ≤ N) (j : Fin 3)
    {p p₀ p₁ : Fin 3 → ℝ} {f : Fin 3 → E3 → ℂ} (hf : ∀ i, Measurable (f i))
    {edge : ℝ → ℂ} (hedge : Continuous edge) :
    AEStronglyMeasurable
      (fun w : E3 × ℝ => Tproj N R j (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) (edge w.2)) w.1)
      ((volume : Measure E3).prod (volume : Measure ℝ)) := by
  classical
  have hrw : ∀ w : E3 × ℝ,
      Tproj N R j (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) (edge w.2)) w.1
      = (N : ℂ)⁻¹ * ∫ s in Set.Ioc (0 : ℝ) N,
          ∏ i, (Function.update (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) (edge w.2)) j
            (Q R j (anFam (p j) (p₀ j) (p₁ j) (f j) (edge w.2)))) i (w.1 + curve i s) := by
    intro w
    simp only [Tproj, A, prodShift]
    rw [intervalIntegral.integral_of_le hN]
  simp only [hrw]
  refine StronglyMeasurable.aestronglyMeasurable ?_
  refine StronglyMeasurable.const_mul ?_ _
  refine StronglyMeasurable.integral_prod_right' (ν := volume.restrict (Set.Ioc (0 : ℝ) N))
    (f := fun q : (E3 × ℝ) × ℝ =>
      ∏ i, (Function.update (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) (edge q.1.2)) j
        (Q R j (anFam (p j) (p₀ j) (p₁ j) (f j) (edge q.1.2)))) i (q.1.1 + curve i q.2)) ?_
  refine Measurable.stronglyMeasurable ?_
  refine Finset.measurable_prod _ (fun i _ => ?_)
  have hmap : Measurable
      fun q : (E3 × ℝ) × ℝ => ((edge q.1.2, q.1.1 + curve i q.2) : ℂ × E3) := by
    refine Measurable.prodMk (hedge.measurable.comp (measurable_snd.comp measurable_fst)) ?_
    exact (measurable_fst.comp measurable_fst).add
      ((continuous_curve i).measurable.comp measurable_snd)
  have hA : Measurable ((fun w : ℂ × E3 => anFam (p i) (p₀ i) (p₁ i) (f i) w.1 w.2)
      ∘ fun q : (E3 × ℝ) × ℝ => ((edge q.1.2, q.1.1 + curve i q.2) : ℂ × E3)) :=
    (measurable_anFam_uncurry (hf i)).comp hmap
  have hP : Measurable ((fun w : ℂ × E3 => P (4 * R) i (anFam (p i) (p₀ i) (p₁ i) (f i) w.1) w.2)
      ∘ fun q : (E3 × ℝ) × ℝ => ((edge q.1.2, q.1.1 + curve i q.2) : ℂ × E3)) :=
    ((stronglyMeasurable_P_anFam_uncurry (4 * R) i (hf i)).measurable).comp hmap
  by_cases h : i = j
  · subst h
    simp only [Function.update_self, Q]
    exact hA.sub hP
  · simp only [Function.update_of_ne h]
    exact hA



open MeasureTheory in
/-- **The interpolation bound for `Auto.Tproj`, on continuous compactly supported triples.**
All the hypotheses of `Auto.interpolate_of_analyticFamily` are now discharged for this operator:
`Auto.Ccs` is closed under the analytic family, the composed family is jointly measurable,
continuous on the closed strip, holomorphic inside it, and bounded there. -/
theorem interpolate_Tproj {N R : ℝ} (hN : 0 ≤ N) (hR : 0 < R) (j : Fin 3)
    {p₀ p₁ p : Fin 3 → ℝ} {q₀ q₁ q M₀ M₁ θ : ℝ}
    (hp₀ : ∀ i, 0 < p₀ i) (hp₁ : ∀ i, 0 < p₁ i) (hp : ∀ i, 0 < p i)
    (hq₀ : 0 < q₀) (hq₁ : 0 < q₁) (hq : 0 < q) (hM₀ : 0 ≤ M₀) (hM₁ : 0 ≤ M₁)
    (hθ : θ ∈ Set.Ioo (0 : ℝ) 1)
    (hrel : ∀ i, (p i)⁻¹ = (1 - θ) * (p₀ i)⁻¹ + θ * (p₁ i)⁻¹)
    (hqrel : q⁻¹ = (1 - θ) * q₀⁻¹ + θ * q₁⁻¹)
    (h0 : ∀ g : Fin 3 → E3 → ℂ, (∀ i, Ccs (g i)) →
      eLpNorm (Tproj N R j g) (ENNReal.ofReal q₀) volume
        ≤ ENNReal.ofReal M₀ * ∏ i, eLpNorm (g i) (ENNReal.ofReal (p₀ i)) volume)
    (h1 : ∀ g : Fin 3 → E3 → ℂ, (∀ i, Ccs (g i)) →
      eLpNorm (Tproj N R j g) (ENNReal.ofReal q₁) volume
        ≤ ENNReal.ofReal M₁ * ∏ i, eLpNorm (g i) (ENNReal.ofReal (p₁ i)) volume)
    (f : Fin 3 → E3 → ℂ) (hf : ∀ i, Ccs (f i)) :
    eLpNorm (Tproj N R j f) (ENNReal.ofReal q) volume
      ≤ ENNReal.ofReal (M₀ ^ (1 - θ) * M₁ ^ θ)
        * ∏ i, eLpNorm (f i) (ENNReal.ofReal (p i)) volume := by
  have hfm : ∀ i, Measurable (f i) := fun i => (hf i).1.measurable
  have hm₀ : AEStronglyMeasurable
      (fun w : E3 × ℝ =>
        Tproj N R j (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) ((w.2 : ℂ) * Complex.I)) w.1)
      ((volume : Measure E3).prod (volume : Measure ℝ)) :=
    aestronglyMeasurable_Tproj_anFam (N := N) (R := R) (p := p) (p₀ := p₀) (p₁ := p₁) (f := f)
      (edge := fun t : ℝ => ((t : ℂ) * Complex.I)) hN j hfm
      (Complex.continuous_ofReal.mul continuous_const)
  have hm₁ : AEStronglyMeasurable
      (fun w : E3 × ℝ =>
        Tproj N R j (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) (1 + (w.2 : ℂ) * Complex.I)) w.1)
      ((volume : Measure E3).prod (volume : Measure ℝ)) :=
    aestronglyMeasurable_Tproj_anFam (N := N) (R := R) (p := p) (p₀ := p₀) (p₁ := p₁) (f := f)
      (edge := fun t : ℝ => (1 + (t : ℂ) * Complex.I)) hN j hfm
      (continuous_const.add (Complex.continuous_ofReal.mul continuous_const))
  have hc : ∀ y : E3, ContinuousOn
      (fun z : ℂ => Tproj N R j (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) z) y)
      {z : ℂ | z.re ∈ Set.Icc (0 : ℝ) 1} := fun y z hz =>
    (continuousAt_Tproj_anFam hN hR j hp hp₀ hp₁ hf hz y).continuousWithinAt
  have hd : ∀ y : E3, DifferentiableOn ℂ
      (fun z : ℂ => Tproj N R j (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) z) y)
      {z : ℂ | z.re ∈ Set.Ioo (0 : ℝ) 1} := fun y z hz =>
    (differentiableAt_Tproj_anFam hN hR j hp hp₀ hp₁ hf hz y).differentiableWithinAt
  have hb : ∀ y : E3, ∃ C : ℝ, ∀ z : ℂ, z.re ∈ Set.Icc (0 : ℝ) 1 →
      ‖Tproj N R j (fun i => anFam (p i) (p₀ i) (p₁ i) (f i) z) y‖ ≤ C := by
    obtain ⟨C, hC⟩ := exists_bound_Tproj_anFam hR j hp hp₀ hp₁ hf
    exact fun y => ⟨C, fun z hz => hC y z hz⟩
  exact interpolate_of_analyticFamily (T := Tproj N R j) (S := Ccs)
    hp₀ hp₁ hp hq₀ hq₁ hq hM₀ hM₁ hθ hrel hqrel
    (fun u hu i z hz => ccs_anFam (hp i) (hp₀ i) (hp₁ i) hu hz) f hf (fun i => (hf
      i).1.aestronglyMeasurable) (by fun_prop) hm₀ hm₁ hc hd hb h0 h1


/-! ### From compact support back to `Nice`

`Auto.interpolate_Tproj` bounds `Tproj` on continuous compactly supported triples. The passage
to `Auto.Nice` triples is by truncation: multiplying by a cutoff keeps every `L^p` norm from
increasing, and `Tproj` of the truncations converges **pointwise** to `Tproj` of the original
triple, because the operator is an average over a compact interval of a product of one-coordinate
convolutions. No convergence in any `L^p` norm is needed; Fatou's lemma then preserves the
bound. -/

open MeasureTheory Filter in
/-- Fatou's lemma for `eLpNorm` along a pointwise convergent sequence with a uniform bound. -/
theorem eLpNorm_le_of_tendsto {α : Type*} [MeasurableSpace α] {μ : Measure α} {q : ℝ} (hq : 0 < q)
    {F : ℕ → α → ℂ} {G : α → ℂ} {K : ℝ≥0∞}
    (hFm : ∀ n, Measurable (F n))
    (hconv : ∀ x, Filter.Tendsto (fun n => F n x) Filter.atTop (nhds (G x)))
    (hb : ∀ n, eLpNorm (F n) (ENNReal.ofReal q) μ ≤ K) :
    eLpNorm G (ENNReal.ofReal q) μ ≤ K := by
  have hGm := (measurable_of_tendsto_metrizable hFm (tendsto_pi_nhds.mpr
    hconv)).aestronglyMeasurable (μ := μ)
  have hqne : ENNReal.ofReal q ≠ 0 := (ENNReal.ofReal_pos.mpr hq).ne'
  have hpow : ∀ (c : ℂ), ‖c‖ₑ ^ q = ENNReal.ofReal (‖c‖ ^ q) := fun c => by
    rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hq.le]
  have hlim : ∀ x, Filter.Tendsto (fun n => ‖F n x‖ₑ ^ q) Filter.atTop (nhds (‖G x‖ₑ ^ q)) := by
    intro x
    have h1 : Filter.Tendsto (fun n => ‖F n x‖) Filter.atTop (nhds ‖G x‖) := (hconv x).norm
    have h2 : Filter.Tendsto (fun n => ‖F n x‖ ^ q) Filter.atTop (nhds (‖G x‖ ^ q)) := by
      have h := ((Real.continuousAt_rpow_const ‖G x‖ q (Or.inr hq.le)).tendsto).comp h1
      simpa [Function.comp_def] using h
    have h3 := ENNReal.tendsto_ofReal h2
    simpa only [hpow] using h3
  have hn : ∀ n, ∫⁻ x, ‖F n x‖ₑ ^ q ∂μ ≤ K ^ q := by
    intro n
    have h1 : (∫⁻ x, ‖F n x‖ₑ ^ q ∂μ) = eLpNorm' (F n) q μ ^ q :=
      lintegral_rpow_enorm_eq_rpow_eLpNorm' hq
    have h2 : eLpNorm' (F n) q μ = eLpNorm (F n) (ENNReal.ofReal q) μ := by
      rw [eLpNorm_eq_eLpNorm' hqne ENNReal.ofReal_ne_top (by fun_prop), ENNReal.toReal_ofReal hq.le]
    rw [h1, h2]
    exact ENNReal.rpow_le_rpow (hb n) hq.le
  have hint : ∫⁻ x, ‖G x‖ₑ ^ q ∂μ ≤ K ^ q := by
    have h1 : (∫⁻ x, ‖G x‖ₑ ^ q ∂μ)
        = ∫⁻ x, Filter.liminf (fun n => ‖F n x‖ₑ ^ q) Filter.atTop ∂μ :=
      lintegral_congr fun x => ((hlim x).liminf_eq).symm
    rw [h1]
    refine le_trans (lintegral_liminf_le (fun n => ((hFm n).enorm.pow_const q))) ?_
    calc Filter.liminf (fun n => ∫⁻ x, ‖F n x‖ₑ ^ q ∂μ) Filter.atTop
        ≤ Filter.liminf (fun _ : ℕ => K ^ q) Filter.atTop :=
          Filter.liminf_le_liminf (Filter.Eventually.of_forall hn)
      _ = K ^ q := Filter.liminf_const _
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hqne ENNReal.ofReal_ne_top (by fun_prop),
    ENNReal.toReal_ofReal hq.le]
  calc (∫⁻ x, ‖G x‖ₑ ^ q ∂μ) ^ (1 / q) ≤ (K ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hint (by positivity)
    _ = K := by rw [← ENNReal.rpow_mul, mul_one_div, div_self hq.ne', ENNReal.rpow_one]

open MeasureTheory in
/-- **Fatou with a degenerate alternative.** Where the limit is not attained the limit function is
required to vanish, which is exactly what an operator given by an integral does at a point where
the integral of the limit diverges. This is the form `Auto.Lim3` supplies. -/
theorem eLpNorm_le_of_tendsto_or_zero {α : Type*} [MeasurableSpace α] {μ : Measure α} {q : ℝ}
    (hq : 0 < q) {F : ℕ → α → ℂ} {G : α → ℂ} {K : ℝ≥0∞}
    (hFm : ∀ n, Measurable (F n))
    (hGm : AEStronglyMeasurable G μ)
    (hconv : ∀ x, Filter.Tendsto (fun n => F n x) Filter.atTop (nhds (G x)) ∨ G x = 0)
    (hb : ∀ n, eLpNorm (F n) (ENNReal.ofReal q) μ ≤ K) :
    eLpNorm G (ENNReal.ofReal q) μ ≤ K := by
  have hqne : ENNReal.ofReal q ≠ 0 := (ENNReal.ofReal_pos.mpr hq).ne'
  have hpow : ∀ c : ℂ, ‖c‖ₑ ^ q = ENNReal.ofReal (‖c‖ ^ q) := fun c => by
    rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hq.le]
  have hlim : ∀ x, ‖G x‖ₑ ^ q ≤ Filter.liminf (fun n => ‖F n x‖ₑ ^ q) Filter.atTop := by
    intro x
    rcases hconv x with hx | hx
    · have h1 : Filter.Tendsto (fun n => ‖F n x‖) Filter.atTop (nhds ‖G x‖) := hx.norm
      have h2 : Filter.Tendsto (fun n => ‖F n x‖ ^ q) Filter.atTop (nhds (‖G x‖ ^ q)) := by
        have h := ((Real.continuousAt_rpow_const ‖G x‖ q (Or.inr hq.le)).tendsto).comp h1
        simpa [Function.comp_def] using h
      have h3 := ENNReal.tendsto_ofReal h2
      have h4 : Filter.Tendsto (fun n => ‖F n x‖ₑ ^ q) Filter.atTop (nhds (‖G x‖ₑ ^ q)) := by
        simpa only [hpow] using h3
      exact le_of_eq h4.liminf_eq.symm
    · rw [hx]
      simp [ENNReal.zero_rpow_of_pos hq]
  have hn : ∀ n, ∫⁻ x, ‖F n x‖ₑ ^ q ∂μ ≤ K ^ q := by
    intro n
    have h1 : (∫⁻ x, ‖F n x‖ₑ ^ q ∂μ) = eLpNorm' (F n) q μ ^ q :=
      lintegral_rpow_enorm_eq_rpow_eLpNorm' hq
    have h2 : eLpNorm' (F n) q μ = eLpNorm (F n) (ENNReal.ofReal q) μ := by
      rw [eLpNorm_eq_eLpNorm' hqne ENNReal.ofReal_ne_top (by fun_prop), ENNReal.toReal_ofReal hq.le]
    rw [h1, h2]
    exact ENNReal.rpow_le_rpow (hb n) hq.le
  have hint : ∫⁻ x, ‖G x‖ₑ ^ q ∂μ ≤ K ^ q := by
    refine le_trans (lintegral_mono hlim) ?_
    refine le_trans (lintegral_liminf_le fun n => ((hFm n).enorm.pow_const q)) ?_
    calc Filter.liminf (fun n => ∫⁻ x, ‖F n x‖ₑ ^ q ∂μ) Filter.atTop
        ≤ Filter.liminf (fun _ : ℕ => K ^ q) Filter.atTop :=
          Filter.liminf_le_liminf (Filter.Eventually.of_forall hn)
      _ = K ^ q := Filter.liminf_const _
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hqne ENNReal.ofReal_ne_top (by fun_prop),
    ENNReal.toReal_ofReal hq.le]
  calc (∫⁻ x, ‖G x‖ₑ ^ q ∂μ) ^ (1 / q) ≤ (K ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hint (by positivity)
    _ = K := by rw [← ENNReal.rpow_mul, mul_one_div, div_self hq.ne', ENNReal.rpow_one]

/-- The truncations of a `Nice` function by the cutoffs of `Auto.cutoff`. -/
noncomputable def trunc (n : ℕ) (g : E3 → ℂ) : E3 → ℂ := fun x => g x * (cutoff n x : ℂ)

theorem ccs_trunc {g : E3 → ℂ} (hg : Continuous g) (n : ℕ) : Ccs (trunc n g) := by
  refine ⟨hg.mul (Complex.continuous_ofReal.comp (cutoff_continuous n)), ?_⟩
  refine HasCompactSupport.intro (isCompact_closedBall (0 : E3) ((n : ℝ) + 2)) ?_
  intro x hx
  have hz : cutoff n x = 0 := by
    have hnot : x ∉ Function.support (cutoff n) := by
      rw [cutoff, ContDiffBump.support_eq (f := cutoffBump n)]
      intro hmem
      exact hx (Metric.ball_subset_closedBall hmem)
    simpa using hnot
  simp [trunc, hz]

theorem norm_trunc_le {g : E3 → ℂ} (n : ℕ) (x : E3) : ‖trunc n g x‖ ≤ ‖g x‖ := by
  rw [trunc, norm_mul, Complex.norm_real, Real.norm_of_nonneg (cutoff_nonneg n x)]
  calc ‖g x‖ * cutoff n x ≤ ‖g x‖ * 1 :=
