/-- Summing a finite, atom-dependent family of output layers costs only its
cardinality.  This is the variable-cutoff analogue of
`scratch_finite_outputLayer_sum_le_card_mul`. -/
theorem scratch_variable_outputLayer_sum_le_card_mul
    {ι κ ξ ω : Type*} (s : Finset ι) (t : Finset κ) (u : Finset ξ)
    (L : ι → κ → ξ → Finset ω)
    (M : ι → κ → ξ → ℝ) (W : ω → ι → κ → ξ → ℝ)
    (P : ι → κ → ξ → ℝ)
    (hdecomp : ∀ i ∈ s, ∀ j ∈ t, ∀ k ∈ u,
      M i j k ≤ ∑ ell ∈ L i j k, W ell i j k)
    (hlayer : ∀ i ∈ s, ∀ j ∈ t, ∀ k ∈ u, ∀ ell ∈ L i j k,
      W ell i j k ≤ P i j k) :
    ∀ i ∈ s, ∀ j ∈ t, ∀ k ∈ u,
      M i j k ≤ ((L i j k).card : ℝ) * P i j k := by
  intro i hi j hj k hk
  calc
    M i j k ≤ ∑ ell ∈ L i j k, W ell i j k := hdecomp i hi j hj k hk
    _ ≤ ∑ _ell ∈ L i j k, P i j k := by
      apply Finset.sum_le_sum
      intro ell hell
      exact hlayer i hi j hj k hk ell hell
    _ = ((L i j k).card : ℝ) * P i j k := by
      simp [Finset.sum_const, nsmul_eq_mul]

