        (∏ a, Y a ^ θ a) * (∏ a, Z a ^ θ a) := by
  have hfactor (a : Fin 4) :
      (C a * X a * Y a * Z a) ^ θ a =
        C a ^ θ a * X a ^ θ a * Y a ^ θ a * Z a ^ θ a := by
    rcases hnonneg a with ⟨hC, hX, hY, hZ⟩
    rw [Real.mul_rpow (mul_nonneg (mul_nonneg hC hX) hY) hZ]
    rw [Real.mul_rpow (mul_nonneg hC hX) hY]
    rw [Real.mul_rpow hC hX]
  have hgroup :
      (∏ a, (C a * X a * Y a * Z a) ^ θ a) =
        (∏ a, C a ^ θ a) * (∏ a, X a ^ θ a) *
          (∏ a, Y a ^ θ a) * (∏ a, Z a ^ θ a) := by
    calc
      (∏ a, (C a * X a * Y a * Z a) ^ θ a) =
