      _ = (∏ a, C a ^ θ a * X a ^ θ a) *
          (∏ a, Y a ^ θ a * Z a ^ θ a) := by
            rw [Finset.prod_mul_distrib]
      _ = ((∏ a, C a ^ θ a) * (∏ a, X a ^ θ a)) *
          ((∏ a, Y a ^ θ a) * (∏ a, Z a ^ θ a)) := by
            rw [Finset.prod_mul_distrib, Finset.prod_mul_distrib]
      _ = (∏ a, C a ^ θ a) * (∏ a, X a ^ θ a) *
          (∏ a, Y a ^ θ a) * (∏ a, Z a ^ θ a) := by ring
