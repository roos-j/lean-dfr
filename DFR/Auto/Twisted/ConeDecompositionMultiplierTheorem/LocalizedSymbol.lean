/-- The diagonal anisotropic dilation `D_t`. -/
def dilate (α : Anisotropy) (t : ℝ) (x : E3) : E3 :=
  WithLp.toLp 2 fun i ↦ t ^ α.weight i * x i

/-- The linear map underlying `dilate`. -/
def dilateLinear (α : Anisotropy) (t : ℝ) : E3 →ₗ[ℝ] E3 :=
  Matrix.toLpLin 2 2 (Matrix.diagonal fun i ↦ t ^ α.weight i)

theorem dilateLinear_apply (α : Anisotropy) (t : ℝ) (x : E3) :
    α.dilateLinear t x = α.dilate t x := by
  ext i
  simp only [dilateLinear, Matrix.toLpLin_apply, dilate]
  exact Matrix.mulVec_diagonal _ _ _

theorem det_dilateLinear (α : Anisotropy) (t : ℝ) :
    LinearMap.det (α.dilateLinear t) = t ^ α.homogeneousDimension := by
  simp [dilateLinear, homogeneousDimension, Finset.prod_pow_eq_pow_sum]

@[simp]
theorem dilate_one (α : Anisotropy) (x : E3) : α.dilate 1 x = x := by
  ext i
  simp [dilate]

@[simp]
theorem dilate_zero (α : Anisotropy) (x : E3) : α.dilate 0 x = 0 := by
  ext i
  simp [dilate, Nat.ne_of_gt (α.weight_pos i)]

theorem dilate_comp (α : Anisotropy) (s t : ℝ) (x : E3) :
    α.dilate s (α.dilate t x) = α.dilate (s * t) x := by
  ext i
  simp only [dilate, PiLp.toLp_apply, mul_pow]
  ring

theorem dilate_inv_apply (α : Anisotropy) {t : ℝ} (ht : t ≠ 0) (x : E3) :
    α.dilate t⁻¹ (α.dilate t x) = x := by
  rw [α.dilate_comp]
  simp [ht]

theorem dilate_apply_inv (α : Anisotropy) {t : ℝ} (ht : t ≠ 0) (x : E3) :
    α.dilate t (α.dilate t⁻¹ x) = x := by
  rw [α.dilate_comp]
  simp [ht]

theorem radius_dilate (α : Anisotropy) {t : ℝ} (ht : 0 < t) (x : E3) :
    α.radius (α.dilate t x) = t * α.radius x := by
  simp only [radius]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  rw [dilate, PiLp.toLp_apply, abs_mul, abs_of_pos (pow_pos ht _)]
  rw [Real.mul_rpow (pow_nonneg ht.le _) (abs_nonneg _)]
  rw [Real.pow_rpow_inv_natCast ht.le (Nat.ne_of_gt (α.weight_pos i))]

