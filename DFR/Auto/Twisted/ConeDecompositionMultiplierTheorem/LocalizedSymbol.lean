/-- The Section 7 `2^5` estimate for the literal complex model form from a
uniform real product estimate at translation exponent `100`. -/
theorem norm_LiteralModelFullForm_le_weight100
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (C : ℝ) (hC : 0 ≤ C) (p : Fin 4 → ℝ)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, ‖c t‖ ≤ 1)
    (hreal : ∀ (d : ℝ → ℝ), Measurable d → (∀ t : ℝ, |d t| ≤ 1) →
      ∀ G : ModelSchwartzInput,
        |ModelFullForm α u d G| ≤ C * sourceWeight u ^ 100 *
