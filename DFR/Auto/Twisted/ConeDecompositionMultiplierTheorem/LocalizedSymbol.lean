/-- At active coordinate three, the active literal complex spatial integrand
is the canonical literal complex spatial integrand. -/
theorem LiteralActiveModelSpatialIntegrand_two
    (α : Anisotropy) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (x : E3) :
    LiteralActiveModelSpatialIntegrand α 2 u F t x =
      LiteralModelSpatialIntegrand α u F t x := by
  simpa only [LiteralActiveModelSpatialIntegrand] using
    LiteralComplexActiveInternal.scratch_LiteralActiveModelSpatialIntegrand_two
      α u F t x

/-- The full literal complex active-coordinate model is exactly transported to
the canonical literal complex model by any permutation taking coordinate three
to the active coordinate. -/
theorem LiteralActiveModelFullForm_permute_to_third
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (c : ℝ → ℂ) (F : ModelComplexSchwartzInput)
    (hσ : σ 2 = i) :
    LiteralActiveModelFullForm α i u c F =
      LiteralModelFullForm (permutedAnisotropy α σ)
        (coordinatePermutation σ u) c (complexPermutedModelInput σ F) := by
  simpa only [LiteralActiveModelFullForm, complexPermutedModelInput] using
    LiteralComplexActiveInternal.scratch_LiteralActiveModelFullForm_permute_to_third
      α σ i u c F hσ

/-- Complex `L^p` norms are invariant under the active-coordinate input
permutation. -/
theorem lpNorm_complexPermutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelComplexSchwartzInput)
    (j : Fin 4) (p : ℝ≥0∞) :
    lpNorm (complexPermutedModelInput σ F j : E3 → ℂ) p volume =
      lpNorm (F (modelInputIndex σ j) : E3 → ℂ) p volume := by
  simpa only [complexPermutedModelInput] using
    LiteralComplexActiveInternal.scratch_lpNorm_complexPermutedModelInput σ F j p

/-- The product of the four complex input norms is invariant under the full
active-coordinate input/exponent relabeling. -/
theorem prod_lpNorm_complexPermutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelComplexSchwartzInput)
    (q : Fin 4 → ℝ) :
    (∏ j : Fin 4,
      lpNorm (complexPermutedModelInput σ F j : E3 → ℂ)
        (ENNReal.ofReal (permutedModelExponent σ q j)) volume) =
      ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (q j)) volume := by
  simpa only [complexPermutedModelInput] using
    LiteralComplexActiveInternal.scratch_prod_lpNorm_complexPermutedModelInput
      σ F q

/-! ## Section 9 anisotropic derivative transport -/

/-- A diagonal anisotropic dilation acts on a coordinate direction by the
corresponding anisotropic power. -/
theorem dilateLinear_coordinateDirection
    (α : Anisotropy) (t : ℝ) (j : Fin 3) :
    α.dilateLinear t (Anisotropy.coordinateDirection j) =
      t ^ α.weight j • Anisotropy.coordinateDirection j := by
  ext k
  rw [Anisotropy.dilateLinear_apply]
  simp [Anisotropy.dilate, coordinateDirection_apply]
  split_ifs with h
  · subst k
    simp
  · simp

/-- Away from the origin, anisotropic diagonal precomposition transports an
ordered coordinate derivative by applying the same diagonal map to every
input vector. -/
theorem iteratedFDeriv_dilate_comp_coordinate
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    {t : ℝ} (ht : 0 < t) (η : E3) (k : ℕ) (hk : k ≤ 110)
    (σ : Fin k → Fin 3) (hη : η ≠ 0) :
    (iteratedFDeriv ℝ k (fun z : E3 ↦ m (α.dilate t⁻¹ z)) η)
        (fun r ↦ Anisotropy.coordinateDirection (σ r)) =
      (iteratedFDeriv ℝ k m (α.dilate t⁻¹ η))
        (fun r ↦ α.dilateLinear t⁻¹ (Anisotropy.coordinateDirection (σ r))) := by
  let S : Set E3 := ({0}ᶜ : Set E3)
  let L : E3 →L[ℝ] E3 :=
    { α.dilateLinear t⁻¹ with
      cont := LinearMap.continuous_of_finiteDimensional (α.dilateLinear t⁻¹) }
  let S' : Set E3 := L ⁻¹' S
  have hLapply (z : E3) : L z = α.dilate t⁻¹ z := by
    change (α.dilateLinear t⁻¹) z = α.dilate t⁻¹ z
    exact α.dilateLinear_apply t⁻¹ z
  have hLη : L η = α.dilate t⁻¹ η := hLapply η
  have hLηne : L η ≠ 0 := by
    rw [hLη]
    intro hzero
    have hrecover := α.dilate_apply_inv ht.ne' η
    rw [hzero] at hrecover
    apply hη
    change α.dilate t (0 : E3) = η at hrecover
    have hzeroDilate : α.dilate t (0 : E3) = 0 := by
      rw [← α.dilateLinear_apply]
      exact (α.dilateLinear t).map_zero
    rw [hzeroDilate] at hrecover
    exact hrecover.symm
  have hηS' : η ∈ S' := by
    change L η ∈ S
    simpa [S] using hLηne
  have hLS : L η ∈ S := by
    simpa [S] using hLηne
  have hSopen : IsOpen S := by
    simpa only [S] using (isOpen_compl_singleton : IsOpen ({0}ᶜ : Set E3))
  have hS'open : IsOpen S' := hSopen.preimage L.continuous
  have hSunique : UniqueDiffOn ℝ S := hSopen.uniqueDiffOn
  have hS'unique : UniqueDiffOn ℝ S' := hS'open.uniqueDiffOn
  have hmAt : ContDiffAt ℝ 110 m (L η) :=
    hm.2.2.2.1.contDiffAt (hSopen.mem_nhds hLS)
  have hcompOn : ContDiffOn ℝ 110 (m ∘ L) S' :=
    hm.2.2.2.1.comp_continuousLinearMap L
  have hcompAt : ContDiffAt ℝ 110 (m ∘ L) η :=
    hcompOn.contDiffAt (hS'open.mem_nhds hηS')
  have hwithin := L.iteratedFDerivWithin_comp_right hm.2.2.2.1
    hSunique hS'unique hLS (show (k : WithTop ℕ∞) ≤ 110 by exact_mod_cast hk)
  have hleft : iteratedFDeriv ℝ k (m ∘ L) η =
      iteratedFDerivWithin ℝ k (m ∘ L) S' η := by
    symm
    exact iteratedFDerivWithin_eq_iteratedFDeriv hS'unique
      (hcompAt.of_le (by exact_mod_cast hk)) hηS'
  have hright : iteratedFDerivWithin ℝ k m S (L η) =
      iteratedFDeriv ℝ k m (L η) :=
    iteratedFDerivWithin_eq_iteratedFDeriv hSunique
      (hmAt.of_le (by exact_mod_cast hk)) hLS
  have hfun : (fun z : E3 ↦ m (α.dilate t⁻¹ z)) = m ∘ L := by
    funext z
    exact congrArg m (hLapply z).symm
  calc
    (iteratedFDeriv ℝ k (fun z : E3 ↦ m (α.dilate t⁻¹ z)) η)
        (fun r ↦ Anisotropy.coordinateDirection (σ r)) =
        (iteratedFDeriv ℝ k (m ∘ L) η)
          (fun r ↦ Anisotropy.coordinateDirection (σ r)) := by rw [hfun]
    _ = (iteratedFDerivWithin ℝ k (m ∘ L) S' η)
          (fun r ↦ Anisotropy.coordinateDirection (σ r)) := by rw [hleft]
    _ = ((iteratedFDerivWithin ℝ k m S (L η)).compContinuousLinearMap
          (fun _ ↦ L)) (fun r ↦ Anisotropy.coordinateDirection (σ r)) := by
          rw [hwithin]
    _ = (iteratedFDeriv ℝ k m (L η))
          (fun r ↦ L (Anisotropy.coordinateDirection (σ r))) := by
          rw [hright]
          simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    _ = (iteratedFDeriv ℝ k m (α.dilate t⁻¹ η))
          (fun r ↦ α.dilateLinear t⁻¹ (Anisotropy.coordinateDirection (σ r))) := by
          rw [hLη]
          rfl

/-- The anisotropic radius is strictly positive off the origin. -/
theorem radius_pos_of_ne_zero (α : Anisotropy) {x : E3} (hx : x ≠ 0) :
    0 < α.radius x := by
  obtain ⟨i, hi⟩ : ∃ i : Fin 3, x i ≠ 0 := by
    by_contra h
    push Not at h
    apply hx
    ext j
    exact h j
  have hterm : 0 < |x i| ^ ((α.weight i : ℝ)⁻¹) := by
    exact Real.rpow_pos_of_pos (abs_pos.mpr hi) _
  unfold Anisotropy.radius
  exact lt_of_lt_of_le hterm
    (Finset.single_le_sum (s := Finset.univ)
      (fun j _ ↦ Real.rpow_nonneg (abs_nonneg (x j)) ((α.weight j : ℝ)⁻¹))
      (Finset.mem_univ i))

/-- The exact coordinate derivative factor of the rescaled multiplier. -/
theorem dilate_coordinate_derivative_factor
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    {t : ℝ} (ht : 0 < t) (η : E3) (k : ℕ) (hk : k ≤ 110)
    (σ : Fin k → Fin 3) (hη : η ≠ 0) :
    (iteratedFDeriv ℝ k (fun z : E3 ↦ m (α.dilate t⁻¹ z)) η)
        (fun r ↦ Anisotropy.coordinateDirection (σ r)) =
      (t⁻¹) ^ α.derivativeWeight σ •
        (iteratedFDeriv ℝ k m (α.dilate t⁻¹ η))
          (fun r ↦ Anisotropy.coordinateDirection (σ r)) := by
  rw [iteratedFDeriv_dilate_comp_coordinate α M m hm ht η k hk σ hη]
  have hvec : (fun r ↦ α.dilateLinear t⁻¹
      (Anisotropy.coordinateDirection (σ r))) =
      (fun r ↦ (t⁻¹) ^ α.weight (σ r) •
        Anisotropy.coordinateDirection (σ r)) := by
    funext r
    exact dilateLinear_coordinateDirection α t⁻¹ (σ r)
  rw [hvec, ContinuousMultilinearMap.map_smul_univ]
  congr 1
  unfold Anisotropy.derivativeWeight
  rw [Finset.prod_pow_eq_pow_sum]

/-- The scale powers in the multiplier derivative bound cancel exactly under
anisotropic precomposition. -/
theorem anisotropic_derivative_scalar_cancel
    (M t r : ℝ) (ht : 0 < t) (hr : 0 < r) (d : ℕ) :
    (t⁻¹) ^ d * (M * (t⁻¹ * r) ^ (-((d : ℕ) : ℝ))) =
      M * r ^ (-((d : ℕ) : ℝ)) := by
  have hti : 0 < t⁻¹ := inv_pos.mpr ht
  rw [Real.mul_rpow hti.le hr.le]
  rw [← Real.rpow_natCast]
  calc
    t⁻¹ ^ (d : ℝ) * (M * (t⁻¹ ^ (-(d : ℝ)) * r ^ (-(d : ℝ)))) =
        M * (t⁻¹ ^ (d : ℝ) * t⁻¹ ^ (-(d : ℝ))) * r ^ (-(d : ℝ)) := by ring
    _ = M * t⁻¹ ^ ((d : ℝ) + -(d : ℝ)) * r ^ (-(d : ℝ)) := by
      rw [Real.rpow_add hti]
    _ = M * r ^ (-(d : ℝ)) := by norm_num

/-- The anisotropic multiplier hypothesis is uniform under the diagonal
rescaling used in localized symbols when tested on ordered coordinate
directions. -/
theorem dilate_coordinate_derivative_bound
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    {t : ℝ} (ht : 0 < t) (η : E3) (k : ℕ) (hk : k ≤ 110)
    (σ : Fin k → Fin 3) (hη : η ≠ 0) :
    ‖(iteratedFDeriv ℝ k (fun z : E3 ↦ m (α.dilate t⁻¹ z)) η)
        (fun r ↦ Anisotropy.coordinateDirection (σ r))‖ ≤
      M * (α.radius η) ^ (-((α.derivativeWeight σ : ℕ) : ℝ)) := by
  rw [dilate_coordinate_derivative_factor α M m hm ht η k hk σ hη]
  have hDη : α.dilate t⁻¹ η ≠ 0 := by
    intro hzero
    have hrecover := α.dilate_apply_inv ht.ne' η
    rw [hzero] at hrecover
    apply hη
    change α.dilate t (0 : E3) = η at hrecover
    have hzeroDilate : α.dilate t (0 : E3) = 0 := by
      rw [← α.dilateLinear_apply]
      exact (α.dilateLinear t).map_zero
    rw [hzeroDilate] at hrecover
    exact hrecover.symm
  have hsource := hm.2.2.2.2 k hk (α.dilate t⁻¹ η) hDη σ
  have hpow_nonneg : 0 ≤ (t⁻¹) ^ α.derivativeWeight σ := by positivity
  rw [norm_smul, Real.norm_eq_abs,
    abs_of_pos (pow_pos (inv_pos.mpr ht) _)]
  calc
    (t⁻¹) ^ α.derivativeWeight σ *
        ‖(iteratedFDeriv ℝ k m (α.dilate t⁻¹ η))
          (fun r ↦ Anisotropy.coordinateDirection (σ r))‖ ≤
        (t⁻¹) ^ α.derivativeWeight σ *
          (M * (α.radius (α.dilate t⁻¹ η)) ^
            (-((α.derivativeWeight σ : ℕ) : ℝ))) :=
      mul_le_mul_of_nonneg_left hsource hpow_nonneg
    _ = M * (α.radius η) ^ (-((α.derivativeWeight σ : ℕ) : ℝ)) := by
      rw [α.radius_dilate (inv_pos.mpr ht)]
      exact anisotropic_derivative_scalar_cancel M t (α.radius η) ht
        (radius_pos_of_ne_zero α hη) (α.derivativeWeight σ)

/-! ## Compact cone-localization cutoffs

These are the source's auxiliary `\widetilde\Phi` and
`\widetilde\Psi`, realized directly through `ContDiffBump`. The chosen
inner and outer radii give exactly the plateau and support margins used by
the localized-symbol/Fourier-series step.
-/

/-- A smooth low-frequency cutoff equal to one on `[-2,2]` and zero outside
`(-3,3)`. -/
noncomputable def localConePhi (x : ℝ) : ℝ :=
  (⟨(2 : ℝ), 3, by norm_num, by norm_num⟩ : ContDiffBump (0 : ℝ)) x

/-- One positive annular cutoff, equal to one on `[1,2]` and supported in
`(1/2,5/2)`. -/
noncomputable def localConePsiPos (x : ℝ) : ℝ :=
  (⟨(1 / 2 : ℝ), 1, by norm_num, by norm_num⟩ : ContDiffBump (3 / 2 : ℝ)) x

/-- The corresponding negative annular cutoff. -/
noncomputable def localConePsiNeg (x : ℝ) : ℝ :=
  (⟨(1 / 2 : ℝ), 1, by norm_num, by norm_num⟩ : ContDiffBump (-3 / 2 : ℝ)) x

/-- A smooth even annular cutoff equal to one on
`[-2,-1] ∪ [1,2]` and zero on `[-1/2,1/2]` and outside
`(-5/2,5/2)`. -/
noncomputable def localConePsi (x : ℝ) : ℝ :=
  localConePsiPos x + localConePsiNeg x

private theorem localConePhi_apply (x : ℝ) :
    localConePhi x =
      (⟨(2 : ℝ), 3, by norm_num, by norm_num⟩ : ContDiffBump (0 : ℝ)) x := by
  rfl

private theorem localConePsiPos_apply (x : ℝ) :
    localConePsiPos x =
      (⟨(1 / 2 : ℝ), 1, by norm_num, by norm_num⟩ :
        ContDiffBump (3 / 2 : ℝ)) x := by
  rfl

private theorem localConePsiNeg_apply (x : ℝ) :
    localConePsiNeg x =
      (⟨(1 / 2 : ℝ), 1, by norm_num, by norm_num⟩ :
        ContDiffBump (-3 / 2 : ℝ)) x := by
  rfl

theorem localConePhi_nonneg (x : ℝ) : 0 ≤ localConePhi x := by
  rw [localConePhi_apply]
  exact ContDiffBump.nonneg' _ _

theorem localConePhi_le_one (x : ℝ) : localConePhi x ≤ 1 := by
  rw [localConePhi_apply]
  exact ContDiffBump.le_one _

theorem localConePhi_eq_one {x : ℝ} (hx : |x| ≤ 2) :
    localConePhi x = 1 := by
  rw [localConePhi_apply]
  apply ContDiffBump.one_of_mem_closedBall
  rw [Metric.mem_closedBall, Real.dist_eq]
  simpa using hx

theorem localConePhi_eq_zero {x : ℝ} (hx : 3 ≤ |x|) :
    localConePhi x = 0 := by
  rw [localConePhi_apply]
  apply ContDiffBump.zero_of_le_dist
  rw [Real.dist_eq]
  simpa using hx

theorem localConePhi_contDiff :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) localConePhi := by
  rw [show localConePhi =
      (⟨(2 : ℝ), 3, by norm_num, by norm_num⟩ : ContDiffBump (0 : ℝ)) by rfl]
  exact (⟨(2 : ℝ), 3, by norm_num, by norm_num⟩ : ContDiffBump (0 : ℝ)).contDiff

theorem localConePsiPos_nonneg (x : ℝ) :
    0 ≤ localConePsiPos x := by
  rw [localConePsiPos_apply]
  exact ContDiffBump.nonneg' _ _

theorem localConePsiNeg_nonneg (x : ℝ) :
    0 ≤ localConePsiNeg x := by
  rw [localConePsiNeg_apply]
  exact ContDiffBump.nonneg' _ _

theorem localConePsiPos_eq_one {x : ℝ}
    (hx : |x - 3 / 2| ≤ 1 / 2) : localConePsiPos x = 1 := by
  rw [localConePsiPos_apply]
  apply ContDiffBump.one_of_mem_closedBall
  rw [Metric.mem_closedBall, Real.dist_eq]
  simpa using hx

theorem localConePsiNeg_eq_one {x : ℝ}
    (hx : |x + 3 / 2| ≤ 1 / 2) : localConePsiNeg x = 1 := by
  rw [localConePsiNeg_apply]
  apply ContDiffBump.one_of_mem_closedBall
  rw [Metric.mem_closedBall, Real.dist_eq]
  convert hx using 1 ; ring

theorem localConePsiPos_eq_zero {x : ℝ}
    (hx : 1 ≤ |x - 3 / 2|) : localConePsiPos x = 0 := by
  rw [localConePsiPos_apply]
  apply ContDiffBump.zero_of_le_dist
  rw [Real.dist_eq]
  simpa using hx

theorem localConePsiNeg_eq_zero {x : ℝ}
    (hx : 1 ≤ |x + 3 / 2|) : localConePsiNeg x = 0 := by
  rw [localConePsiNeg_apply]
  apply ContDiffBump.zero_of_le_dist
  rw [Real.dist_eq]
  convert hx using 1 ; ring

theorem localConePsi_nonneg (x : ℝ) : 0 ≤ localConePsi x :=
  add_nonneg (localConePsiPos_nonneg x) (localConePsiNeg_nonneg x)

theorem localConePsi_eq_one_of_one_le {x : ℝ}
    (hlo : 1 ≤ x) (hhi : x ≤ 2) : localConePsi x = 1 := by
  unfold localConePsi
  have hpos : |x - 3 / 2| ≤ 1 / 2 := by
    rw [abs_le]
    constructor <;> linarith
  have hneg : 1 ≤ |x + 3 / 2| := by
    rw [abs_of_nonneg (by linarith)]
    linarith
  rw [localConePsiPos_eq_one hpos, localConePsiNeg_eq_zero hneg]
  ring

theorem localConePsi_eq_one_of_neg {x : ℝ}
    (hlo : -2 ≤ x) (hhi : x ≤ -1) : localConePsi x = 1 := by
  unfold localConePsi
  have hneg : |x + 3 / 2| ≤ 1 / 2 := by
    rw [abs_le]
    constructor <;> linarith
  have hpos : 1 ≤ |x - 3 / 2| := by
    rw [abs_of_nonpos (by linarith)]
    linarith
  rw [localConePsiNeg_eq_one hneg, localConePsiPos_eq_zero hpos]
  ring

theorem localConePsi_eq_zero_of_abs_le_half {x : ℝ}
    (hx : |x| ≤ 1 / 2) : localConePsi x = 0 := by
  unfold localConePsi
  have hpos : 1 ≤ |x - 3 / 2| := by
    rw [abs_of_nonpos (by
      have := (abs_le.mp hx).2
      linarith)]
    have h := (abs_le.mp hx).2
    linarith
  have hneg : 1 ≤ |x + 3 / 2| := by
    rw [abs_of_nonneg (by
      have := (abs_le.mp hx).1
      linarith)]
    have h := (abs_le.mp hx).1
    linarith
  rw [localConePsiPos_eq_zero hpos, localConePsiNeg_eq_zero hneg]
  ring

theorem localConePsi_eq_zero_of_five_halves_le_abs {x : ℝ}
    (hx : 5 / 2 ≤ |x|) : localConePsi x = 0 := by
  unfold localConePsi
  rcases le_total 0 x with hx0 | hx0
  · have hx' : 5 / 2 ≤ x := by
      rwa [abs_of_nonneg hx0] at hx
    have hpos : 1 ≤ |x - 3 / 2| := by
      rw [abs_of_nonneg (by linarith)]
      linarith
    have hneg : 1 ≤ |x + 3 / 2| := by
      rw [abs_of_nonneg (by linarith)]
      linarith
    rw [localConePsiPos_eq_zero hpos, localConePsiNeg_eq_zero hneg]
    ring
  · have hx' : x ≤ -5 / 2 := by
      rw [abs_of_nonpos hx0] at hx
      linarith
    have hpos : 1 ≤ |x - 3 / 2| := by
      rw [abs_of_nonpos (by linarith)]
      linarith
    have hneg : 1 ≤ |x + 3 / 2| := by
      rw [abs_of_nonpos (by linarith)]
      linarith
    rw [localConePsiPos_eq_zero hpos, localConePsiNeg_eq_zero hneg]
    ring

theorem localConePsi_contDiff :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) localConePsi := by
  unfold localConePsi
  apply ContDiff.add
  · rw [show localConePsiPos =
      (⟨(1 / 2 : ℝ), 1, by norm_num, by norm_num⟩ :
        ContDiffBump (3 / 2 : ℝ)) by rfl]
    exact (⟨(1 / 2 : ℝ), 1, by norm_num, by norm_num⟩ :
      ContDiffBump (3 / 2 : ℝ)).contDiff
  · rw [show localConePsiNeg =
      (⟨(1 / 2 : ℝ), 1, by norm_num, by norm_num⟩ :
        ContDiffBump (-3 / 2 : ℝ)) by rfl]
    exact (⟨(1 / 2 : ℝ), 1, by norm_num, by norm_num⟩ :
      ContDiffBump (-3 / 2 : ℝ)).contDiff

/-- The auxiliary low cutoff is identically one wherever the original
Calderón low cutoff can be nonzero. -/
theorem localConePhi_eq_one_of_conePhi_ne_zero {x : ℝ}
    (hx : conePhi x ≠ 0) : localConePhi x = 1 := by
  apply localConePhi_eq_one
  apply le_of_lt
  apply lt_of_not_ge
  intro hlarge
  exact hx (conePhi_eq_zero_of_two_le_abs hlarge)

/-- The auxiliary annular cutoff is identically one wherever the original
Calderón annular cutoff can be nonzero. -/
theorem localConePsi_eq_one_of_conePsi_ne_zero {x : ℝ}
    (hx : conePsi x ≠ 0) : localConePsi x = 1 := by
  have hlow : 1 < |x| := by
    apply lt_of_not_ge
    intro hsmall
    exact hx (conePsi_eq_zero_of_abs_le_one hsmall)
  have hhigh : |x| < 2 := by
    apply lt_of_not_ge
    intro hlarge
    exact hx (conePsi_eq_zero_of_two_le_abs hlarge)
  rcases le_total 0 x with hx0 | hx0
  · have hlow' : 1 < x := by rwa [abs_of_nonneg hx0] at hlow
    have hhigh' : x < 2 := by rwa [abs_of_nonneg hx0] at hhigh
    exact localConePsi_eq_one_of_one_le hlow'.le hhigh'.le
  · apply localConePsi_eq_one_of_neg
      (by
        rw [abs_of_nonpos hx0] at hhigh
        linarith)
      (by
        rw [abs_of_nonpos hx0] at hlow
        linarith)

/-- The real auxiliary localization factor used to divide out the passive
Gaussians on the three cones. -/
noncomputable def localizedCutoff (i : Fin 3) (η : E3) : ℝ :=
  localConePsi (η i) *
    ∏ j : Fin 3,
      if j = i then 1 else localConePhi (η j) / gaussian (η j)

/-- The complex localized multiplier before periodic extension. -/
noncomputable def localizedSymbol
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) (η : E3) : ℂ :=
  m (α.dilate t⁻¹ η) * localizedCutoff i η

@[simp] theorem localizedSymbol_apply
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) (η : E3) :
    localizedSymbol α m i t η =
      m (α.dilate t⁻¹ η) * localizedCutoff i η := rfl

/-- A nonzero localized cutoff is separated from the singular origin by its
active annular coordinate. -/
theorem abs_active_gt_half_of_localizedCutoff_ne_zero
    (i : Fin 3) (η : E3) (hη : localizedCutoff i η ≠ 0) :
    1 / 2 < |η i| := by
  apply lt_of_not_ge
  intro hsmall
  have hpsi : localConePsi (η i) = 0 :=
    localConePsi_eq_zero_of_abs_le_half hsmall
  apply hη
  simp [localizedCutoff, hpsi]

theorem localizedCutoff_ne_zero_implies_ne_zero
    (i : Fin 3) (η : E3) (hη : localizedCutoff i η ≠ 0) : η ≠ 0 := by
  intro hzero
  have hactive := abs_active_gt_half_of_localizedCutoff_ne_zero i η hη
  rw [hzero] at hactive
  norm_num at hactive

/-- The cutoff is identically zero on a fixed ball around the singular
frequency origin. -/
theorem localizedCutoff_eq_zero_of_norm_lt_half
    (i : Fin 3) (η : E3) (hη : ‖η‖ < 1 / 2) :
    localizedCutoff i η = 0 := by
  have hcoord : |η i| ≤ ‖η‖ := by
    simpa only [Real.norm_eq_abs] using PiLp.norm_apply_le η i
  have hpsi : localConePsi (η i) = 0 :=
    localConePsi_eq_zero_of_abs_le_half (by linarith)
  simp [localizedCutoff, hpsi]

theorem localizedSymbol_eq_zero_of_norm_lt_half
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) (η : E3)
    (hη : ‖η‖ < 1 / 2) : localizedSymbol α m i t η = 0 := by
  simp [localizedSymbol,
    localizedCutoff_eq_zero_of_norm_lt_half i η hη]

/-- On the source cone factors, the auxiliary cutoff divides out precisely
the passive Gaussian factors. -/
theorem localizedCutoff_eq_passiveGaussianInv
    (i : Fin 3) (η : E3)
    (hpsi : conePsi (η i) ≠ 0)
    (hphi : ∀ j : Fin 3, j ≠ i → conePhi (η j) ≠ 0) :
    localizedCutoff i η =
      ∏ j : Fin 3, if j = i then 1 else (gaussian (η j))⁻¹ := by
  unfold localizedCutoff
  rw [localConePsi_eq_one_of_conePsi_ne_zero hpsi]
  simp only [one_mul]
  apply Finset.prod_congr rfl
  intro j _
  by_cases hji : j = i
  · simp [hji]
  · rw [ite_eq_right hji]
    rw [localConePhi_eq_one_of_conePhi_ne_zero (hphi j hji)]
    rw [one_div]
    simp only [ite_eq_right hji]

/-- Each coordinate outside the auxiliary box kills the localized cutoff.
The active coordinate has the slightly smaller annular support, while a
passive coordinate is killed by the low cutoff. -/
theorem localizedCutoff_eq_zero_of_coordinate_large
    (i j : Fin 3) (η : E3)
    (hj : 3 ≤ |η j|) : localizedCutoff i η = 0 := by
  by_cases hji : j = i
  · subst j
    have hpsi : localConePsi (η i) = 0 :=
      localConePsi_eq_zero_of_five_halves_le_abs (by linarith)
    simp [localizedCutoff, hpsi]
  · have hphi : localConePhi (η j) = 0 :=
      localConePhi_eq_zero hj
    unfold localizedCutoff
    have hterm : (if j = i then 1 else
        localConePhi (η j) / gaussian (η j)) = 0 := by
      simp [hji, hphi]
    have hprod :
        (∏ k : Fin 3, if k = i then (1 : ℝ) else
          localConePhi (η k) / gaussian (η k)) = 0 := by
      exact Finset.prod_eq_zero (Finset.mem_univ j) hterm
    simp [hprod]

/-- The auxiliary cone cutoff has compact support in the fixed frequency
box. This gives uniform derivative bounds after differentiating it. -/
theorem localizedCutoff_hasCompactSupport (i : Fin 3) :
    HasCompactSupport (localizedCutoff i) := by
  apply HasCompactSupport.intro (isCompact_closedBall (0 : E3) 9)
  intro η hη
  have hnorm : 9 < ‖η‖ := by
    simpa only [Metric.mem_closedBall, dist_zero_right, not_le] using hη
  have hlarge : ∃ j : Fin 3, 3 < |η j| := by
    by_contra h
    push Not at h
    have hsum : |η 0| + |η 1| + |η 2| ≤ 9 := by
      nlinarith [h 0, h 1, h 2]
    linarith [norm_le_sum_abs η]
  obtain ⟨j, hj⟩ := hlarge
  exact localizedCutoff_eq_zero_of_coordinate_large i j η hj.le

/-- Smoothness of the fixed localized cutoff. The Gaussian never vanishes,
so dividing it out in passive coordinates preserves smoothness. -/
theorem localizedCutoff_contDiff (i : Fin 3) :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (localizedCutoff i) := by
  have hpsi : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞)
      (fun η : E3 ↦ localConePsi (η i)) :=
    localConePsi_contDiff.comp (coordinateProjection i).contDiff
  have hfactor : ∀ j : Fin 3, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞)
      (fun η : E3 ↦ if j = i then 1 else
        localConePhi (η j) / gaussian (η j)) := by
    intro j
    by_cases hji : j = i
    · subst j
      simpa using
        (contDiff_const : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞)
          (fun _ : E3 ↦ (1 : ℝ)))
    · simp only [ite_eq_right hji]
      exact
        (localConePhi_contDiff.comp (coordinateProjection j).contDiff).div
          (gaussian_contDiff.comp (coordinateProjection j).contDiff)
          (fun η ↦ ne_of_gt (gaussian_pos (η j)))
  unfold localizedCutoff
  exact hpsi.mul (contDiff_prod (fun j _ ↦ hfactor j))

/-- A single constant bounds all localized-cutoff derivatives through any
fixed order. It is independent of the cone, frequency point, multiplier,
and dilation scale. -/
theorem exists_localizedCutoff_derivative_bound
    (i : Fin 3) (N : ℕ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ n ≤ N, ∀ η : E3,
      ‖iteratedFDeriv ℝ n (localizedCutoff i) η‖ ≤ C := by
  have hb : ∀ n : ℕ, ∃ C : ℝ, ∀ η : E3,
      ‖iteratedFDeriv ℝ n (localizedCutoff i) η‖ ≤ C := by
    intro n
    exact ((localizedCutoff_hasCompactSupport i).iteratedFDeriv n).exists_bound_of_continuous
      ((localizedCutoff_contDiff i).continuous_iteratedFDeriv
        (by exact_mod_cast le_top))
  choose C hC using hb
  have hnn : (0 : ℝ) ≤ ∑ n ∈ Finset.range (N + 1), |C n| :=
    Finset.sum_nonneg (fun n _ ↦ abs_nonneg _)
  refine ⟨1 + ∑ n ∈ Finset.range (N + 1), |C n|, by linarith, ?_⟩
  intro n hn η
  refine le_trans (hC n η) ?_
  have hmem : n ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
  have hle : |C n| ≤ ∑ m ∈ Finset.range (N + 1), |C m| :=
    Finset.single_le_sum (f := fun m ↦ |C m|) (fun m _ ↦ abs_nonneg _) hmem
  linarith [le_abs_self (C n)]

/-- Despite the multiplier only being smooth off zero, multiplication by the
localized cutoff gives a globally smooth localized symbol: the cutoff is
identically zero in a neighborhood of the only singular point. -/
theorem localizedSymbol_contDiff
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t) :
    ContDiff ℝ 110 (localizedSymbol α m i t) := by
  rw [contDiff_iff_contDiffAt]
  intro η
  by_cases hη : η = 0
  · subst η
    refine (contDiffAt_const : ContDiffAt ℝ 110 (fun _ : E3 ↦ (0 : ℂ)) 0).congr_of_eventuallyEq ?_
    filter_upwards [Metric.ball_mem_nhds (0 : E3) (by norm_num : (0 : ℝ) < 1 / 2)] with z hz
    have hnorm : ‖z‖ < 1 / 2 := by
      simpa only [Metric.mem_ball, dist_zero_right] using hz
    exact localizedSymbol_eq_zero_of_norm_lt_half α m i t z hnorm
  · let L : E3 →L[ℝ] E3 :=
      { α.dilateLinear t⁻¹ with
        cont := LinearMap.continuous_of_finiteDimensional (α.dilateLinear t⁻¹) }
    have hLapply (z : E3) : L z = α.dilate t⁻¹ z := by
      change (α.dilateLinear t⁻¹) z = α.dilate t⁻¹ z
      exact α.dilateLinear_apply t⁻¹ z
    have hLηne : L η ≠ 0 := by
      rw [hLapply]
      intro hzero
      have hrecover := α.dilate_apply_inv ht.ne' η
      rw [hzero] at hrecover
      apply hη
      change α.dilate t (0 : E3) = η at hrecover
      have hzeroDilate : α.dilate t (0 : E3) = 0 := by
        rw [← α.dilateLinear_apply]
        exact (α.dilateLinear t).map_zero
      rw [hzeroDilate] at hrecover
      exact hrecover.symm
    have hopen : IsOpen ({0}ᶜ : Set E3) := by
      simp
    have hcompOn : ContDiffOn ℝ 110 (m ∘ L) (L ⁻¹' ({0}ᶜ : Set E3)) :=
      hm.2.2.2.1.comp_continuousLinearMap L
    have hcompAt : ContDiffAt ℝ 110 (m ∘ L) η :=
      hcompOn.contDiffAt ((hopen.preimage L.continuous).mem_nhds (by
        simpa using hLηne))
    have hcutAt : ContDiffAt ℝ 110 (localizedCutoff i) η :=
      ((localizedCutoff_contDiff i).of_le
        (show (110 : WithTop ℕ∞) ≤ ((↑(⊤ : ℕ∞)) : WithTop ℕ∞) by
          exact WithTop.coe_le_coe.mpr (show (110 : ℕ∞) ≤ ⊤ by exact le_top))).contDiffAt
    have hcutAtC : ContDiffAt ℝ 110
        (fun z : E3 ↦ (localizedCutoff i z : ℂ)) η := by
      have hglobal : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞)
          (Complex.ofRealCLM ∘ localizedCutoff i) :=
        Complex.ofRealCLM.contDiff.comp (localizedCutoff_contDiff i)
      exact ((hglobal.of_le
        (show (110 : WithTop ℕ∞) ≤ ((↑(⊤ : ℕ∞)) : WithTop ℕ∞) by
          exact WithTop.coe_le_coe.mpr (show (110 : ℕ∞) ≤ ⊤ by exact le_top))).contDiffAt)
    have heq : localizedSymbol α m i t =
        fun z : E3 ↦ (m ∘ L) z * localizedCutoff i z := by
      funext z
      simp only [localizedSymbol, Function.comp_apply]
      rw [hLapply]
    rw [heq]
    exact hcompAt.mul hcutAtC

/-- The standard Euclidean coordinate directions give the usual basis
expansion of `E3`. -/
theorem coordinateDirection_sum_repr (v : E3) :
    (∑ j : Fin 3, v j • Anisotropy.coordinateDirection j) = v := by
  simpa only [Anisotropy.coordinateDirection, EuclideanSpace.basisFun_repr] using
    (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr v

/-- A coordinatewise bound for a continuous multilinear map controls its
operator norm. This is the finite-dimensional bridge from the blueprint's
multi-index estimates to Mathlib's Fréchet-derivative norm estimates. -/
theorem continuousMultilinearMap_norm_le_coordinateBound
    (k : ℕ) (F : ContinuousMultilinearMap ℝ (fun _ : Fin k ↦ E3) ℂ)
    (B : ℝ) (hB : 0 ≤ B)
    (hcoord : ∀ σ : Fin k → Fin 3,
      ‖F (fun r ↦ Anisotropy.coordinateDirection (σ r))‖ ≤ B) :
    ‖F‖ ≤ (3 : ℝ) ^ k * B := by
  apply F.opNorm_le_bound
  · positivity
  intro v
  have hv : v =
      (fun r ↦ ∑ j : Fin 3, v r j • Anisotropy.coordinateDirection j) := by
    funext r
    exact (coordinateDirection_sum_repr (v r)).symm
  conv_lhs => rw [hv]
  rw [F.map_sum]
  rw [show (fun (σ : Fin k → Fin 3) ↦
      F (fun r ↦ v r (σ r) • Anisotropy.coordinateDirection (σ r))) =
      (fun σ ↦ (∏ r : Fin k, v r (σ r)) •
        F (fun r ↦ Anisotropy.coordinateDirection (σ r))) by
      funext σ
      exact F.map_smul_univ (fun r ↦ v r (σ r))
        (fun r ↦ Anisotropy.coordinateDirection (σ r))]
  calc
    ‖∑ σ : Fin k → Fin 3,
        (∏ r : Fin k, v r (σ r)) •
          F (fun r ↦ Anisotropy.coordinateDirection (σ r))‖ ≤
        ∑ σ : Fin k → Fin 3,
          ‖(∏ r : Fin k, v r (σ r)) •
            F (fun r ↦ Anisotropy.coordinateDirection (σ r))‖ :=
      norm_sum_le Finset.univ _
    _ ≤ ∑ _σ : Fin k → Fin 3, B * ∏ r : Fin k, ‖v r‖ := by
      apply Finset.sum_le_sum
      intro σ _
      rw [norm_smul, Real.norm_eq_abs]
      have hcoeff : |∏ r : Fin k, v r (σ r)| ≤ ∏ r : Fin k, ‖v r‖ := by
        rw [Finset.abs_prod]
        apply Finset.prod_le_prod₀
        · intro r _
          exact abs_nonneg _
        · intro r _
          simpa only [Real.norm_eq_abs] using PiLp.norm_apply_le (v r) (σ r)
      calc
        |∏ r : Fin k, v r (σ r)| *
            ‖F (fun r ↦ Anisotropy.coordinateDirection (σ r))‖ ≤
            (∏ r : Fin k, ‖v r‖) * B :=
          mul_le_mul hcoeff (hcoord σ) (norm_nonneg _) (Finset.prod_nonneg
            (fun r _ ↦ norm_nonneg (v r)))
        _ = B * ∏ r : Fin k, ‖v r‖ := by ring
    _ = (3 : ℝ) ^ k * B * ∏ r : Fin k, ‖v r‖ := by
      rw [Finset.sum_const, nsmul_eq_mul, Finset.card_univ]
      simp only [Fintype.card_fun, Fintype.card_fin, Nat.cast_pow]
      ring

/-- The coordinate-form multiplier hypothesis supplies an explicit full
Fréchet-derivative norm bound after anisotropic rescaling. The finite sum is
deliberately retained, avoiding any hidden norm-equivalence constant. -/
theorem dilate_iteratedFDeriv_norm_le_coordinateSum
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    {t : ℝ} (ht : 0 < t) (η : E3) (k : ℕ) (hk : k ≤ 110)
    (hη : η ≠ 0) :
    ‖iteratedFDeriv ℝ k (fun z : E3 ↦ m (α.dilate t⁻¹ z)) η‖ ≤
      (3 : ℝ) ^ k * ∑ σ : Fin k → Fin 3,
        M * (α.radius η) ^ (-((α.derivativeWeight σ : ℕ) : ℝ)) := by
  let B : ℝ := ∑ σ : Fin k → Fin 3,
    M * (α.radius η) ^ (-((α.derivativeWeight σ : ℕ) : ℝ))
  have hterm_nonneg (σ : Fin k → Fin 3) :
      0 ≤ M * (α.radius η) ^ (-((α.derivativeWeight σ : ℕ) : ℝ)) :=
    mul_nonneg hm.nonneg (Real.rpow_nonneg (radius_pos_of_ne_zero α hη).le _)
  have hB : 0 ≤ B := Finset.sum_nonneg (fun σ _ ↦ hterm_nonneg σ)
  apply (continuousMultilinearMap_norm_le_coordinateBound
    k (iteratedFDeriv ℝ k (fun z : E3 ↦ m (α.dilate t⁻¹ z)) η) B hB)
  intro σ
  have hpoint := dilate_coordinate_derivative_bound α M m hm ht η k hk σ hη
  refine hpoint.trans ?_
  exact Finset.single_le_sum (fun τ _ ↦ hterm_nonneg τ) (Finset.mem_univ σ)

/-- Every point outside the fixed half-ball used by the localized cutoff has
anisotropic radius at least `1/6`. This deliberately crude constant is
uniform in the anisotropy. -/
theorem radius_ge_one_sixth_of_norm_ge_half
    (α : Anisotropy) (η : E3) (hη : 1 / 2 ≤ ‖η‖) :
    1 / 6 ≤ α.radius η := by
  obtain ⟨i, hi⟩ : ∃ i : Fin 3, 1 / 6 ≤ |η i| := by
    by_contra h
    push Not at h
    have hsum : |η 0| + |η 1| + |η 2| < 1 / 2 := by
      nlinarith [h 0, h 1, h 2]
    linarith [norm_le_sum_abs η]
  have hwi : (1 : ℝ) ≤ α.weight i := by
    exact_mod_cast (α.weight_pos i)
  have hinv : (α.weight i : ℝ)⁻¹ ≤ 1 :=
    inv_le_one_of_one_le₀ hwi
  have hbase : (1 / 6 : ℝ) ^ ((α.weight i : ℝ)⁻¹) ≤
      |η i| ^ ((α.weight i : ℝ)⁻¹) :=
    Real.rpow_le_rpow (by norm_num) hi (inv_nonneg.mpr (by positivity))
  have hpow : (1 / 6 : ℝ) ≤ (1 / 6 : ℝ) ^ ((α.weight i : ℝ)⁻¹) :=
    Real.self_le_rpow_of_le_one (by norm_num) (by norm_num) hinv
  unfold Anisotropy.radius
  exact le_trans (le_trans hpow hbase)
    (Finset.single_le_sum (s := Finset.univ)
      (fun j _ ↦ Real.rpow_nonneg (abs_nonneg (η j)) ((α.weight j : ℝ)⁻¹))
      (Finset.mem_univ i))

/-- On the region where a localized symbol can have nonzero derivatives, the
rescaled multiplier's full derivative norm has a scale-independent finite
bound obtained directly from the source coordinate estimates. -/
theorem dilate_iteratedFDeriv_norm_le_uniform_on_half_compl
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    {t : ℝ} (ht : 0 < t) (η : E3) (k : ℕ) (hk : k ≤ 110)
    (hη : 1 / 2 ≤ ‖η‖) :
    ‖iteratedFDeriv ℝ k (fun z : E3 ↦ m (α.dilate t⁻¹ z)) η‖ ≤
      (3 : ℝ) ^ k * ∑ σ : Fin k → Fin 3,
        M * (6 : ℝ) ^ (α.derivativeWeight σ) := by
  have hηne : η ≠ 0 := by
    intro hz
    rw [hz] at hη
    norm_num at hη
  have hradius : 1 / 6 ≤ α.radius η :=
    radius_ge_one_sixth_of_norm_ge_half α η hη
  have hsource := dilate_iteratedFDeriv_norm_le_coordinateSum
    α M m hm ht η k hk hηne
  refine hsource.trans ?_
  apply mul_le_mul_of_nonneg_left
  · apply Finset.sum_le_sum
    intro σ _
    have hpow : (α.radius η) ^ (-((α.derivativeWeight σ : ℕ) : ℝ)) ≤
        (1 / 6 : ℝ) ^ (-((α.derivativeWeight σ : ℕ) : ℝ)) :=
      Real.rpow_le_rpow_of_nonpos (by norm_num) hradius (by simp)
    calc
      M * (α.radius η) ^ (-((α.derivativeWeight σ : ℕ) : ℝ)) ≤
          M * (1 / 6 : ℝ) ^ (-((α.derivativeWeight σ : ℕ) : ℝ)) :=
        mul_le_mul_of_nonneg_left hpow hm.nonneg
      _ = M * (6 : ℝ) ^ (α.derivativeWeight σ) := by
        rw [← Real.rpow_natCast, Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 1 / 6)]
        congr 1
        rw [← Real.inv_rpow (by norm_num : (0 : ℝ) ≤ 1 / 6)]
        norm_num
  · positivity

/-- A localized symbol has zero iterated derivative in the ball on which it
is identically zero. -/
theorem iteratedFDeriv_localizedSymbol_eq_zero_of_norm_lt_half
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    (η : E3) (hη : ‖η‖ < 1 / 2) (k : ℕ) :
    iteratedFDeriv ℝ k (localizedSymbol α m i t) η = 0 := by
  have hball : Metric.ball η (1 / 2 - ‖η‖) ∈ 𝓝 η :=
    Metric.ball_mem_nhds η (sub_pos.mpr hη)
  have hlocal : localizedSymbol α m i t =ᶠ[𝓝 η]
      fun _ : E3 ↦ (0 : ℂ) := by
    filter_upwards [hball] with z hz
    have hdist : ‖z - η‖ < 1 / 2 - ‖η‖ := by
      simpa only [Metric.mem_ball, dist_eq_norm] using hz
    have hnorm : ‖z‖ < 1 / 2 := by
      calc
        ‖z‖ = ‖(z - η) + η‖ := by congr 1 ; abel
        _ ≤ ‖z - η‖ + ‖η‖ := norm_add_le (z - η) η
        _ < 1 / 2 := by linarith
    exact localizedSymbol_eq_zero_of_norm_lt_half α m i t z hnorm
  have hderiv := (hlocal.iteratedFDeriv ℝ k).eq_of_nhds
  rw [hderiv, iteratedFDeriv_fun_zero]
  rfl

/-- Leibniz estimate for the localized symbol away from its zero neighborhood.
All terms are expressed using the scale-independent full derivative bound for
the rescaled multiplier and an arbitrary cutoff-derivative bound. -/
theorem norm_iteratedFDeriv_localizedSymbol_le_half_compl
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t)
    (C : ℝ)
    (hcut : ∀ n ≤ 110, ∀ η : E3,
      ‖iteratedFDeriv ℝ n (fun z : E3 ↦ (localizedCutoff i z : ℂ)) η‖ ≤ C)
    (η : E3) (k : ℕ) (hk : k ≤ 110) (hη : 1 / 2 ≤ ‖η‖) :
    ‖iteratedFDeriv ℝ k (localizedSymbol α m i t) η‖ ≤
      ∑ n ∈ Finset.range (k + 1),
        (k.choose n : ℝ) *
          ((3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
            M * (6 : ℝ) ^ (α.derivativeWeight σ)) * C := by
  let L : E3 →L[ℝ] E3 :=
    { α.dilateLinear t⁻¹ with
      cont := LinearMap.continuous_of_finiteDimensional (α.dilateLinear t⁻¹) }
  let S : Set E3 := L ⁻¹' ({0}ᶜ : Set E3)
  let f : E3 → ℂ := m ∘ L
  let g : E3 → ℂ := fun z ↦ (localizedCutoff i z : ℂ)
  have hLapply (z : E3) : L z = α.dilate t⁻¹ z := by
    change (α.dilateLinear t⁻¹) z = α.dilate t⁻¹ z
    exact α.dilateLinear_apply t⁻¹ z
  have hηne : η ≠ 0 := by
    intro hzero
    rw [hzero] at hη
    norm_num at hη
  have hLηne : L η ≠ 0 := by
    rw [hLapply]
    intro hzero
    have hrecover := α.dilate_apply_inv ht.ne' η
    rw [hzero] at hrecover
    apply hηne
    change α.dilate t (0 : E3) = η at hrecover
    have hzeroDilate : α.dilate t (0 : E3) = 0 := by
      rw [← α.dilateLinear_apply]
      exact (α.dilateLinear t).map_zero
    rw [hzeroDilate] at hrecover
    exact hrecover.symm
  have hopen : IsOpen S := by
    exact (isOpen_compl_singleton : IsOpen ({0}ᶜ : Set E3)).preimage L.continuous
  have hηS : η ∈ S := by simpa [S] using hLηne
  have hSunique : UniqueDiffOn ℝ S := hopen.uniqueDiffOn
  have hfOn : ContDiffOn ℝ 110 f S := by
    simpa only [f, S] using hm.2.2.2.1.comp_continuousLinearMap L
  have hgGlobal : ContDiff ℝ 110 g := by
    have htop : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞)
        (Complex.ofRealCLM ∘ localizedCutoff i) :=
      Complex.ofRealCLM.contDiff.comp (localizedCutoff_contDiff i)
    change ContDiff ℝ 110 (fun z : E3 ↦ (localizedCutoff i z : ℂ))
    exact htop.of_le
      (show (110 : WithTop ℕ∞) ≤ ((↑(⊤ : ℕ∞)) : WithTop ℕ∞) by
        exact WithTop.coe_le_coe.mpr (show (110 : ℕ∞) ≤ ⊤ by exact le_top))
  have hgOn : ContDiffOn ℝ 110 g S := hgGlobal.contDiffOn
  have hproduct : localizedSymbol α m i t = fun z ↦ f z * g z := by
    funext z
    simp only [localizedSymbol, f, g, Function.comp_apply]
    rw [hLapply]
  have hprodWithin : iteratedFDerivWithin ℝ k (fun z ↦ f z * g z) S η =
      iteratedFDeriv ℝ k (fun z ↦ f z * g z) η :=
    iteratedFDerivWithin_eq_iteratedFDeriv hSunique
      (((hfOn.contDiffAt (hopen.mem_nhds hηS)).mul
        (hgOn.contDiffAt (hopen.mem_nhds hηS))).of_le
          (by exact_mod_cast hk)) hηS
  have hfWithin (n : ℕ) (hn : n ≤ 110) :
      iteratedFDerivWithin ℝ n f S η = iteratedFDeriv ℝ n f η :=
    iteratedFDerivWithin_eq_iteratedFDeriv hSunique
      ((hfOn.contDiffAt (hopen.mem_nhds hηS)).of_le
        (by exact_mod_cast hn)) hηS
  have hgWithin (n : ℕ) (hn : n ≤ 110) :
      iteratedFDerivWithin ℝ n g S η = iteratedFDeriv ℝ n g η :=
    iteratedFDerivWithin_eq_iteratedFDeriv hSunique
      ((hgOn.contDiffAt (hopen.mem_nhds hηS)).of_le
        (by exact_mod_cast hn)) hηS
  have hle := norm_iteratedFDerivWithin_mul_le hfOn hgOn hSunique hηS
    (show (k : WithTop ℕ∞) ≤ 110 by exact_mod_cast hk)
  rw [hproduct]
  rw [← hprodWithin]
  refine hle.trans ?_
  apply Finset.sum_le_sum
  intro n hn
  have hnle : n ≤ k := Nat.le_of_lt_succ (Finset.mem_range.mp hn)
  have hsub : k - n ≤ 110 := le_trans (Nat.sub_le _ _) hk
  rw [hfWithin n (le_trans hnle hk), hgWithin (k - n) hsub]
  have hfbound := dilate_iteratedFDeriv_norm_le_uniform_on_half_compl
    α M m hm ht η n (le_trans hnle hk) hη
  have hfbound' : ‖iteratedFDeriv ℝ n f η‖ ≤
      (3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
        M * (6 : ℝ) ^ (α.derivativeWeight σ) := by
    have hfun : (fun z : E3 ↦ m (α.dilate t⁻¹ z)) = f := by
      funext z
      simp only [f, Function.comp_apply]
      rw [hLapply]
    rw [hfun] at hfbound
    exact hfbound
  have hgbound : ‖iteratedFDeriv ℝ (k - n) g η‖ ≤ C :=
    hcut (k - n) hsub η
  have hBnonneg : 0 ≤ (3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
      M * (6 : ℝ) ^ (α.derivativeWeight σ) := by
    apply mul_nonneg
    · positivity
    · apply Finset.sum_nonneg
      intro σ _
      exact mul_nonneg hm.nonneg (by positivity)
  calc
    (k.choose n : ℝ) * ‖iteratedFDeriv ℝ n f η‖ *
        ‖iteratedFDeriv ℝ (k - n) g η‖ =
        (k.choose n : ℝ) *
          (‖iteratedFDeriv ℝ n f η‖ * ‖iteratedFDeriv ℝ (k - n) g η‖) := by ring
    _ ≤ (k.choose n : ℝ) *
        ((3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
          M * (6 : ℝ) ^ (α.derivativeWeight σ)) *
          ‖iteratedFDeriv ℝ (k - n) g η‖ := by
      rw [mul_assoc]
      exact mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_right hfbound' (norm_nonneg _)) (by positivity)
    _ ≤ (k.choose n : ℝ) *
        ((3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
          M * (6 : ℝ) ^ (α.derivativeWeight σ)) * C := by
      have hchoose : 0 ≤ (k.choose n : ℝ) := by positivity
      have hinner :
          ((3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
            M * (6 : ℝ) ^ (α.derivativeWeight σ)) *
              ‖iteratedFDeriv ℝ (k - n) g η‖ ≤
          ((3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
            M * (6 : ℝ) ^ (α.derivativeWeight σ)) * C :=
        mul_le_mul_of_nonneg_left hgbound hBnonneg
      calc
        (k.choose n : ℝ) *
            ((3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
              M * (6 : ℝ) ^ (α.derivativeWeight σ)) *
            ‖iteratedFDeriv ℝ (k - n) g η‖ =
            (k.choose n : ℝ) *
              (((3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
                M * (6 : ℝ) ^ (α.derivativeWeight σ)) *
                ‖iteratedFDeriv ℝ (k - n) g η‖) := by ring
        _ ≤ (k.choose n : ℝ) *
            (((3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
              M * (6 : ℝ) ^ (α.derivativeWeight σ)) * C) :=
          mul_le_mul_of_nonneg_left hinner hchoose
        _ = (k.choose n : ℝ) *
            ((3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
              M * (6 : ℝ) ^ (α.derivativeWeight σ)) * C := by ring

/-- The complex-valued auxiliary cutoff has a single global derivative bound
through any prescribed finite order. -/
theorem exists_complexLocalizedCutoff_derivative_bound
    (i : Fin 3) (N : ℕ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ n ≤ N, ∀ η : E3,
      ‖iteratedFDeriv ℝ n
        (fun z : E3 ↦ (localizedCutoff i z : ℂ)) η‖ ≤ C := by
  have hsupport : HasCompactSupport
      (Complex.ofRealCLM ∘ localizedCutoff i) :=
    (localizedCutoff_hasCompactSupport i).comp_left rfl
  have htop : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞)
      (Complex.ofRealCLM ∘ localizedCutoff i) :=
    Complex.ofRealCLM.contDiff.comp (localizedCutoff_contDiff i)
  have hb : ∀ n : ℕ, ∃ C : ℝ, ∀ η : E3,
      ‖iteratedFDeriv ℝ n
        (fun z : E3 ↦ (localizedCutoff i z : ℂ)) η‖ ≤ C := by
    intro n
    have hbound := (hsupport.iteratedFDeriv n).exists_bound_of_continuous
      (htop.continuous_iteratedFDeriv (by exact_mod_cast le_top))
    have hfun : (Complex.ofRealCLM ∘ localizedCutoff i) =
        (fun z : E3 ↦ (localizedCutoff i z : ℂ)) := by
      rfl
    rw [hfun] at hbound
    exact hbound
  choose C hC using hb
  have hnn : (0 : ℝ) ≤ ∑ n ∈ Finset.range (N + 1), |C n| :=
    Finset.sum_nonneg (fun n _ ↦ abs_nonneg _)
  refine ⟨1 + ∑ n ∈ Finset.range (N + 1), |C n|, by linarith, ?_⟩
  intro n hn η
  refine le_trans (hC n η) ?_
  have hmem : n ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
  have hle : |C n| ≤ ∑ m ∈ Finset.range (N + 1), |C m| :=
    Finset.single_le_sum (f := fun m ↦ |C m|) (fun m _ ↦ abs_nonneg _) hmem
  linarith [le_abs_self (C n)]

/-- For every derivative order used in the multiplier hypothesis, the
localized symbol has a scale-uniform bound with the required linear factor
`M`. The constant may depend on the order and the fixed cone. -/
theorem exists_localizedSymbol_derivative_bound
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t) :
    ∀ k : ℕ, k ≤ 110 → ∃ C : ℝ, 0 ≤ C ∧ ∀ η : E3,
      ‖iteratedFDeriv ℝ k (localizedSymbol α m i t) η‖ ≤ C * M := by
  rcases exists_complexLocalizedCutoff_derivative_bound i 110 with
    ⟨D, hD, hcut⟩
  intro k hk
  let Ck : ℝ := ∑ n ∈ Finset.range (k + 1),
    (k.choose n : ℝ) *
      ((3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
        (6 : ℝ) ^ (α.derivativeWeight σ)) * D
  have hDnonneg : 0 ≤ D := le_trans (by norm_num) hD
  have hCknonneg : 0 ≤ Ck := by
    dsimp [Ck]
    apply Finset.sum_nonneg
    intro n hn
    apply mul_nonneg
    · apply mul_nonneg
      · positivity
      · apply mul_nonneg
        · positivity
        · apply Finset.sum_nonneg
          intro σ _
          positivity
    · exact hDnonneg
  refine ⟨Ck, hCknonneg, ?_⟩
  intro η
  by_cases hη : ‖η‖ < 1 / 2
  · rw [iteratedFDeriv_localizedSymbol_eq_zero_of_norm_lt_half
      α m i t η hη k]
    simp only [norm_zero]
    exact mul_nonneg hCknonneg hm.nonneg
  · have hhalf : 1 / 2 ≤ ‖η‖ := le_of_not_gt hη
    have hbound := norm_iteratedFDeriv_localizedSymbol_le_half_compl
      α M m hm i ht D hcut η k hk hhalf
    refine hbound.trans ?_
    have hfactor :
        (∑ n ∈ Finset.range (k + 1),
          (k.choose n : ℝ) *
            ((3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
              M * (6 : ℝ) ^ (α.derivativeWeight σ)) * D) = Ck * M := by
      dsimp [Ck]
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro n hn
      rw [← Finset.mul_sum]
      ring
    exact le_of_eq hfactor

/-- The auxiliary localized cutoff exactly cancels the passive Gaussian
factors on a cone. This is the scalar algebra behind insertion of the
Fourier expansion into the Calderón cone identity. -/
theorem localizedCutoff_cone_factor_identity
    (i : Fin 3) (η : E3) :
    localizedCutoff i η * conePsi (η i) * gaussianDeriv (η i) ^ 2 *
        (∏ j : Fin 3, if j = i then 1 else gaussian (η j) * conePhi (η j)) =
      conePsi (η i) * gaussianDeriv (η i) ^ 2 *
        ∏ j : Fin 3, if j = i then 1 else conePhi (η j) := by
  by_cases hpsi : conePsi (η i) = 0
  · simp [hpsi]
  by_cases hall : ∀ j : Fin 3, j ≠ i → conePhi (η j) ≠ 0
  · rw [localizedCutoff_eq_passiveGaussianInv i η hpsi hall]
    fin_cases i <;> simp [Fin.prod_univ_succ]
    all_goals
      have hg0 : gaussian (η 0) ≠ 0 := (gaussian_pos _).ne'
      have hg1 : gaussian (η 1) ≠ 0 := (gaussian_pos _).ne'
      have hg2 : gaussian (η 2) ≠ 0 := (gaussian_pos _).ne'
      field_simp [hg0, hg1, hg2]
  · push Not at hall
    obtain ⟨j, hji, hphi⟩ := hall
    have hleft :
        (∏ k : Fin 3, if k = i then 1 else gaussian (η k) * conePhi (η k)) = 0 := by
      apply Finset.prod_eq_zero (Finset.mem_univ j)
      simp [hji, hphi]
    have hright :
        (∏ k : Fin 3, if k = i then 1 else conePhi (η k)) = 0 := by
      apply Finset.prod_eq_zero (Finset.mem_univ j)
      simp [hji, hphi]
    rw [hleft, hright]
    ring

/-- The same cancellation identity after multiplying by the rescaled complex
symbol. -/
theorem localizedSymbol_cone_factor_identity
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) (η : E3) :
    localizedSymbol α m i t η *
        (conePsi (η i) * gaussianDeriv (η i) ^ 2 : ℂ) *
        (∏ j : Fin 3,
          if j = i then 1 else (gaussian (η j) * conePhi (η j) : ℂ)) =
      m (α.dilate t⁻¹ η) *
        (conePsi (η i) * gaussianDeriv (η i) ^ 2 : ℂ) *
        ∏ j : Fin 3, if j = i then 1 else (conePhi (η j) : ℂ) := by
  rw [localizedSymbol_apply]
  have hreal := localizedCutoff_cone_factor_identity i η
  have hprodL :
      ((∏ j : Fin 3, if j = i then (1 : ℝ) else
        gaussian (η j) * conePhi (η j) : ℝ) : ℂ) =
      ∏ j : Fin 3, if j = i then 1 else
        (gaussian (η j) * conePhi (η j) : ℂ) := by
    fin_cases i <;> simp [Fin.prod_univ_succ]
  have hprodR :
      ((∏ j : Fin 3, if j = i then (1 : ℝ) else conePhi (η j) : ℝ) : ℂ) =
      ∏ j : Fin 3, if j = i then 1 else (conePhi (η j) : ℂ) := by
    fin_cases i <;> simp [Fin.prod_univ_succ]
  calc
    (m (α.dilate t⁻¹ η) * (localizedCutoff i η : ℂ)) *
        (conePsi (η i) * gaussianDeriv (η i) ^ 2 : ℂ) *
        (∏ j : Fin 3,
          if j = i then 1 else (gaussian (η j) * conePhi (η j) : ℂ)) =
      m (α.dilate t⁻¹ η) *
        ((localizedCutoff i η * conePsi (η i) *
          gaussianDeriv (η i) ^ 2 *
          ∏ j : Fin 3, if j = i then 1 else
            gaussian (η j) * conePhi (η j) : ℝ) : ℂ) := by
          rw [← hprodL]
          push_cast
          ring
    _ = m (α.dilate t⁻¹ η) *
        ((conePsi (η i) * gaussianDeriv (η i) ^ 2 *
          ∏ j : Fin 3, if j = i then 1 else conePhi (η j) : ℝ) : ℂ) := by
          rw [hreal]
    _ = _ := by
      rw [← hprodR]
      push_cast
      ring

/-- The cone-factor identity in the source variables `η = D_t ξ`. Thus the
rescaled localized symbol supplies the original multiplier on every cone term
before Fourier expansion. -/
theorem localizedSymbol_dilate_cone_factor_identity
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) {t : ℝ} (ht : 0 < t)
    (ξ : E3) :
    localizedSymbol α m i t (α.dilate t ξ) *
        (conePsi (α.dilate t ξ i) * gaussianDeriv (α.dilate t ξ i) ^ 2 : ℂ) *
        (∏ j : Fin 3, if j = i then 1 else
          (gaussian (α.dilate t ξ j) * conePhi (α.dilate t ξ j) : ℂ)) =
      m ξ *
        (conePsi (α.dilate t ξ i) * gaussianDeriv (α.dilate t ξ i) ^ 2 : ℂ) *
        ∏ j : Fin 3, if j = i then 1 else (conePhi (α.dilate t ξ j) : ℂ) := by
  rw [localizedSymbol_cone_factor_identity]
  rw [α.dilate_inv_apply ht.ne']

/-- The localized complex symbol inherits the fixed compact support of its
auxiliary cutoff. -/
theorem localizedSymbol_hasCompactSupport
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) :
    HasCompactSupport (localizedSymbol α m i t) := by
  have hcut : HasCompactSupport (fun η : E3 ↦ (localizedCutoff i η : ℂ)) :=
    HasCompactSupport.comp_left (localizedCutoff_hasCompactSupport i)
      (g := fun x : ℝ ↦ (x : ℂ)) (by norm_num)
  have hprod : HasCompactSupport
      ((fun η : E3 ↦ m (α.dilate t⁻¹ η)) *
        fun η : E3 ↦ (localizedCutoff i η : ℂ)) :=
    hcut.mul_left
  change HasCompactSupport
    ((fun η : E3 ↦ m (α.dilate t⁻¹ η)) *
      fun η : E3 ↦ (localizedCutoff i η : ℂ))
  exact hprod

/-- Each coordinate outside the fixed auxiliary box kills the complex
localized symbol. -/
theorem localizedSymbol_eq_zero_of_coordinate_large
    (α : Anisotropy) (m : E3 → ℂ) (i j : Fin 3) (t : ℝ) (η : E3)
    (hj : 3 ≤ |η j|) : localizedSymbol α m i t η = 0 := by
  rw [localizedSymbol_apply, localizedCutoff_eq_zero_of_coordinate_large i j η hj]
  simp

/-! ### Period-eight Fourier extension of the localized symbol -/

/-- The auxiliary period-eight additive circle used for the compactly
supported localized multiplier. -/
abbrev PeriodEightCircle := AddCircle (8 : ℝ)

local instance : Fact (0 < (8 : ℝ)) := ⟨by norm_num⟩

/-- A parameterized lift from one real coordinate to the period-eight
additive circle. -/
noncomputable def periodEightLift {X : Type*}
    (f : ℝ → X → ℂ) : PeriodEightCircle → X → ℂ :=
  fun q x ↦ AddCircle.liftIco 8 (-4) (fun r : ℝ ↦ f r x) q

theorem continuous_periodEightLift
    {X : Type*} [TopologicalSpace X] [LocallyCompactSpace X]
    (f : ℝ → X → ℂ)
    (hboundary : ∀ x : X, f (-4) x = f 4 x)
    (hcont : Continuous (fun p : ℝ × X ↦ f p.1 p.2)) :
    Continuous (fun p : PeriodEightCircle × X ↦ periodEightLift f p.1 p.2) := by
  let F : C(ℝ × X, ℂ) := ⟨fun p ↦ f p.1 p.2, hcont⟩
  let G : C(ℝ, C(X, ℂ)) := ContinuousMap.curry F
  have hGboundary : G (-4) = G 4 := by
    ext x
    exact hboundary x
  let H : C(PeriodEightCircle, C(X, ℂ)) :=
    ⟨AddCircle.liftIco 8 (-4) G,
      AddCircle.liftIco_continuous (by
        norm_num
        exact hGboundary) G.continuous.continuousOn⟩
  have hunc : Continuous (fun p : PeriodEightCircle × X ↦ H p.1 p.2) :=
    ContinuousMap.continuous_uncurry_of_continuous H
  refine hunc.congr ?_
  intro p
  rfl

theorem periodEightLift_eq_zero
    {X : Type*} (f : ℝ → X → ℂ) (q : PeriodEightCircle) (x : X)
    (hzero : ∀ r : ℝ, f r x = 0) : periodEightLift f q x = 0 := by
  unfold periodEightLift
  change f (↑(AddCircle.equivIco 8 (-4) q) : ℝ) x = 0
  exact hzero _

theorem periodEightLift_coe
    {X : Type*} (f : ℝ → X → ℂ) {r : ℝ}
    (hr : r ∈ Set.Ico (-4 : ℝ) 4) (x : X) :
    periodEightLift f (r : PeriodEightCircle) x = f r x := by
  have hr' : r ∈ Set.Ico (-4 : ℝ) ((-4 : ℝ) + 8) := by
    norm_num
    exact hr
  unfold periodEightLift
  exact AddCircle.liftIco_coe_apply hr'

/-- The localized symbol in ordinary three scalar coordinates. -/
noncomputable def localizedSymbolRaw
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t x y z : ℝ) : ℂ :=
  localizedSymbol α m i t (frequencyAssemble3 x y z)

@[simp]
theorem localizedSymbolRaw_apply
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t x y z : ℝ) :
    localizedSymbolRaw α m i t x y z =
      localizedSymbol α m i t (frequencyAssemble3 x y z) := rfl

theorem continuous_localizedSymbolRaw
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t) :
    Continuous (fun p : ℝ × (ℝ × ℝ) ↦
      localizedSymbolRaw α m i t p.1 p.2.1 p.2.2) := by
  have hcoordinates : Continuous (fun p : ℝ × (ℝ × ℝ) ↦
      frequencyAssemble3 p.1 p.2.1 p.2.2) := by
    change Continuous (WithLp.toLp 2 ∘ fun p : ℝ × (ℝ × ℝ) ↦
      ![p.1, p.2.1, p.2.2])
    apply (PiLp.continuous_toLp 2 (fun _ : Fin 3 ↦ ℝ)).comp
    apply continuous_pi
    intro j
    fin_cases j <;> fun_prop
  exact (localizedSymbol_contDiff α M m hm i ht).continuous.comp hcoordinates

theorem localizedSymbolRaw_eq_zero_of_coordinate_large
    (α : Anisotropy) (m : E3 → ℂ) (i j : Fin 3) (t x y z : ℝ)
    (hj : 3 ≤ |![x, y, z] j|) :
    localizedSymbolRaw α m i t x y z = 0 := by
  rw [localizedSymbolRaw_apply]
  apply localizedSymbol_eq_zero_of_coordinate_large α m i j t
  simpa only [frequencyAssemble3_apply] using hj

theorem localizedSymbolRaw_zero_first_neg
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t y z : ℝ) :
    localizedSymbolRaw α m i t (-4) y z = 0 := by
  apply localizedSymbolRaw_eq_zero_of_coordinate_large α m i 0 t
  norm_num

theorem localizedSymbolRaw_zero_first_pos
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t y z : ℝ) :
    localizedSymbolRaw α m i t 4 y z = 0 := by
  apply localizedSymbolRaw_eq_zero_of_coordinate_large α m i 0 t
  norm_num

theorem localizedSymbolRaw_zero_second_neg
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t x z : ℝ) :
    localizedSymbolRaw α m i t x (-4) z = 0 := by
  apply localizedSymbolRaw_eq_zero_of_coordinate_large α m i 1 t
  norm_num

theorem localizedSymbolRaw_zero_second_pos
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t x z : ℝ) :
    localizedSymbolRaw α m i t x 4 z = 0 := by
  apply localizedSymbolRaw_eq_zero_of_coordinate_large α m i 1 t
  norm_num

theorem localizedSymbolRaw_zero_third_neg
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t x y : ℝ) :
    localizedSymbolRaw α m i t x y (-4) = 0 := by
  apply localizedSymbolRaw_eq_zero_of_coordinate_large α m i 2 t
  change 3 ≤ |(-4 : ℝ)|
  norm_num

theorem localizedSymbolRaw_zero_third_pos
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t x y : ℝ) :
    localizedSymbolRaw α m i t x y 4 = 0 := by
  apply localizedSymbolRaw_eq_zero_of_coordinate_large α m i 2 t
  change 3 ≤ |(4 : ℝ)|
  norm_num

/-- The first coordinate of the compactly supported localized symbol lifted
to the period-eight circle. -/
noncomputable def periodizedLocalizedFirst
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) :
    PeriodEightCircle → ℝ → ℝ → ℂ :=
  fun q y z ↦ periodEightLift
    (fun x (yz : ℝ × ℝ) ↦ localizedSymbolRaw α m i t x yz.1 yz.2)
    q (y, z)

theorem continuous_periodizedLocalizedFirst
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t) :
    Continuous (fun p : PeriodEightCircle × (ℝ × ℝ) ↦
      periodizedLocalizedFirst α m i t p.1 p.2.1 p.2.2) := by
  simpa only [periodizedLocalizedFirst] using
    (continuous_periodEightLift
      (fun x (yz : ℝ × ℝ) ↦ localizedSymbolRaw α m i t x yz.1 yz.2)
      (by
        intro yz
        rw [localizedSymbolRaw_zero_first_neg,
          localizedSymbolRaw_zero_first_pos])
      (continuous_localizedSymbolRaw α M m hm i ht))

theorem periodizedLocalizedFirst_zero_second_neg
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    (q : PeriodEightCircle) (z : ℝ) :
    periodizedLocalizedFirst α m i t q (-4) z = 0 := by
  unfold periodizedLocalizedFirst
  apply periodEightLift_eq_zero
  intro x
  exact localizedSymbolRaw_zero_second_neg α m i t x z

theorem periodizedLocalizedFirst_zero_second_pos
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    (q : PeriodEightCircle) (z : ℝ) :
    periodizedLocalizedFirst α m i t q 4 z = 0 := by
  unfold periodizedLocalizedFirst
  apply periodEightLift_eq_zero
  intro x
  exact localizedSymbolRaw_zero_second_pos α m i t x z

theorem periodizedLocalizedFirst_zero_third_neg
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    (q : PeriodEightCircle) (y : ℝ) :
    periodizedLocalizedFirst α m i t q y (-4) = 0 := by
  unfold periodizedLocalizedFirst
  apply periodEightLift_eq_zero
  intro x
  exact localizedSymbolRaw_zero_third_neg α m i t x y

theorem periodizedLocalizedFirst_zero_third_pos
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    (q : PeriodEightCircle) (y : ℝ) :
    periodizedLocalizedFirst α m i t q y 4 = 0 := by
  unfold periodizedLocalizedFirst
  apply periodEightLift_eq_zero
  intro x
  exact localizedSymbolRaw_zero_third_pos α m i t x y

theorem periodizedLocalizedFirst_coe
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) {x : ℝ}
    (hx : x ∈ Set.Ico (-4 : ℝ) 4) (y z : ℝ) :
    periodizedLocalizedFirst α m i t (x : PeriodEightCircle) y z =
      localizedSymbolRaw α m i t x y z := by
  unfold periodizedLocalizedFirst
  exact periodEightLift_coe
    (fun x (yz : ℝ × ℝ) ↦ localizedSymbolRaw α m i t x yz.1 yz.2)
    hx (y, z)

/-- The first two coordinates of the localized symbol lifted to period-eight
circles, ordered as `(y, x)`. -/
noncomputable def periodizedLocalizedSecond
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) :
    PeriodEightCircle → PeriodEightCircle → ℝ → ℂ :=
  fun qy qx z ↦ periodEightLift
    (fun y (qxz : PeriodEightCircle × ℝ) ↦
      periodizedLocalizedFirst α m i t qxz.1 y qxz.2)
    qy (qx, z)

theorem continuous_periodizedLocalizedSecond
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t) :
    Continuous (fun p : PeriodEightCircle × (PeriodEightCircle × ℝ) ↦
      periodizedLocalizedSecond α m i t p.1 p.2.1 p.2.2) := by
  have hfirst : Continuous (fun p : PeriodEightCircle × (ℝ × ℝ) ↦
      periodizedLocalizedFirst α m i t p.1 p.2.1 p.2.2) :=
    continuous_periodizedLocalizedFirst α M m hm i ht
  have hreordered : Continuous (fun p : ℝ × (PeriodEightCircle × ℝ) ↦
      periodizedLocalizedFirst α m i t p.2.1 p.1 p.2.2) := by
    exact hfirst.comp
      (continuous_snd.fst.prodMk (continuous_fst.prodMk continuous_snd.snd))
  simpa only [periodizedLocalizedSecond] using
    (continuous_periodEightLift
      (fun y (qxz : PeriodEightCircle × ℝ) ↦
        periodizedLocalizedFirst α m i t qxz.1 y qxz.2)
      (by
        intro qxz
        rw [periodizedLocalizedFirst_zero_second_neg,
          periodizedLocalizedFirst_zero_second_pos])
      hreordered)

theorem periodizedLocalizedSecond_zero_third_neg
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    (qy qx : PeriodEightCircle) :
    periodizedLocalizedSecond α m i t qy qx (-4) = 0 := by
  unfold periodizedLocalizedSecond
  apply periodEightLift_eq_zero
  intro y
  exact periodizedLocalizedFirst_zero_third_neg α m i t qx y

theorem periodizedLocalizedSecond_zero_third_pos
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    (qy qx : PeriodEightCircle) :
    periodizedLocalizedSecond α m i t qy qx 4 = 0 := by
  unfold periodizedLocalizedSecond
  apply periodEightLift_eq_zero
  intro y
  exact periodizedLocalizedFirst_zero_third_pos α m i t qx y

theorem periodizedLocalizedSecond_coe
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    {x y : ℝ} (hx : x ∈ Set.Ico (-4 : ℝ) 4)
    (hy : y ∈ Set.Ico (-4 : ℝ) 4) (z : ℝ) :
    periodizedLocalizedSecond α m i t (y : PeriodEightCircle) (x : PeriodEightCircle) z =
      localizedSymbolRaw α m i t x y z := by
  unfold periodizedLocalizedSecond
  rw [periodEightLift_coe
    (fun y (qxz : PeriodEightCircle × ℝ) ↦
      periodizedLocalizedFirst α m i t qxz.1 y qxz.2) hy]
  exact periodizedLocalizedFirst_coe α m i t hx y z

/-- All three coordinates of the localized symbol lifted to period-eight
circles, ordered as `(z, y, x)`. -/
noncomputable def periodizedLocalizedThird
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) :
    PeriodEightCircle → PeriodEightCircle → PeriodEightCircle → ℂ :=
  fun qz qy qx ↦ periodEightLift
    (fun z (qyqx : PeriodEightCircle × PeriodEightCircle) ↦
      periodizedLocalizedSecond α m i t qyqx.1 qyqx.2 z)
    qz (qy, qx)

theorem continuous_periodizedLocalizedThird
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t) :
    Continuous (fun p : PeriodEightCircle × (PeriodEightCircle × PeriodEightCircle) ↦
      periodizedLocalizedThird α m i t p.1 p.2.1 p.2.2) := by
  have hsecond : Continuous (fun p : PeriodEightCircle × (PeriodEightCircle × ℝ) ↦
      periodizedLocalizedSecond α m i t p.1 p.2.1 p.2.2) :=
    continuous_periodizedLocalizedSecond α M m hm i ht
  have hreordered : Continuous (fun p : ℝ × (PeriodEightCircle × PeriodEightCircle) ↦
      periodizedLocalizedSecond α m i t p.2.1 p.2.2 p.1) := by
    let reorder : ℝ × (PeriodEightCircle × PeriodEightCircle) →
        PeriodEightCircle × (PeriodEightCircle × ℝ) :=
      fun p ↦ (p.2.1, (p.2.2, p.1))
    have horder : Continuous reorder := by
      exact (continuous_snd.fst).prodMk
        ((continuous_snd.snd).prodMk continuous_fst)
    change Continuous
      ((fun q : PeriodEightCircle × (PeriodEightCircle × ℝ) ↦
        periodizedLocalizedSecond α m i t q.1 q.2.1 q.2.2) ∘ reorder)
    exact hsecond.comp horder
  change Continuous (fun p : PeriodEightCircle × (PeriodEightCircle × PeriodEightCircle) ↦
    periodEightLift
      (fun z (qyqx : PeriodEightCircle × PeriodEightCircle) ↦
        periodizedLocalizedSecond α m i t qyqx.1 qyqx.2 z)
      p.1 (p.2.1, p.2.2))
  exact continuous_periodEightLift
    (fun z (qyqx : PeriodEightCircle × PeriodEightCircle) ↦
      periodizedLocalizedSecond α m i t qyqx.1 qyqx.2 z)
    (by
      intro qyqx
      rw [periodizedLocalizedSecond_zero_third_neg,
        periodizedLocalizedSecond_zero_third_pos])
    hreordered

theorem periodizedLocalizedThird_coe
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    {x y z : ℝ} (hx : x ∈ Set.Ico (-4 : ℝ) 4)
    (hy : y ∈ Set.Ico (-4 : ℝ) 4) (hz : z ∈ Set.Ico (-4 : ℝ) 4) :
    periodizedLocalizedThird α m i t (z : PeriodEightCircle)
      (y : PeriodEightCircle) (x : PeriodEightCircle) =
      localizedSymbolRaw α m i t x y z := by
  unfold periodizedLocalizedThird
  rw [periodEightLift_coe
    (fun z (qyqx : PeriodEightCircle × PeriodEightCircle) ↦
      periodizedLocalizedSecond α m i t qyqx.1 qyqx.2 z) hz]
  exact periodizedLocalizedSecond_coe α m i t hx hy z

/-- The period-eight extension with natural `(x, y, z)` coordinate order. -/
noncomputable def periodizedLocalizedSymbol
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) :
    PeriodEightCircle × (PeriodEightCircle × PeriodEightCircle) → ℂ :=
  fun p ↦ periodizedLocalizedThird α m i t p.2.2 p.2.1 p.1

theorem continuous_periodizedLocalizedSymbol
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t) :
    Continuous (periodizedLocalizedSymbol α m i t) := by
  have hthird : Continuous (fun p : PeriodEightCircle ×
      (PeriodEightCircle × PeriodEightCircle) ↦
      periodizedLocalizedThird α m i t p.1 p.2.1 p.2.2) :=
    continuous_periodizedLocalizedThird α M m hm i ht
  let reorder : PeriodEightCircle × (PeriodEightCircle × PeriodEightCircle) →
      PeriodEightCircle × (PeriodEightCircle × PeriodEightCircle) :=
    fun p ↦ (p.2.2, (p.2.1, p.1))
  have horder : Continuous reorder := by
    exact (continuous_snd.snd).prodMk
      ((continuous_snd.fst).prodMk continuous_fst)
  change Continuous
    ((fun q : PeriodEightCircle × (PeriodEightCircle × PeriodEightCircle) ↦
      periodizedLocalizedThird α m i t q.1 q.2.1 q.2.2) ∘ reorder)
  exact hthird.comp horder

theorem periodizedLocalizedSymbol_coe
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    {x y z : ℝ} (hx : x ∈ Set.Ico (-4 : ℝ) 4)
    (hy : y ∈ Set.Ico (-4 : ℝ) 4) (hz : z ∈ Set.Ico (-4 : ℝ) 4) :
    periodizedLocalizedSymbol α m i t
      ((x : PeriodEightCircle), ((y : PeriodEightCircle), (z : PeriodEightCircle))) =
      localizedSymbolRaw α m i t x y z := by
  unfold periodizedLocalizedSymbol
  exact periodizedLocalizedThird_coe α m i t hx hy hz

/-- Rescale the unit additive circle to the period-eight circle. -/
noncomputable def unitToPeriodEightCircle : UnitAddCircle ≃ₜ PeriodEightCircle :=
  (AddCircle.homeomorphAddCircle (8 : ℝ) 1 (by norm_num) (by norm_num)).symm

theorem unitToPeriodEightCircle_coe_div (x : ℝ) :
    unitToPeriodEightCircle ((x / 8 : ℝ) : UnitAddCircle) =
      (x : PeriodEightCircle) := by
  change (AddCircle.homeomorphAddCircle (8 : ℝ) 1 (by norm_num) (by norm_num)).symm
    ((x / 8 : ℝ) : UnitAddCircle) = (x : PeriodEightCircle)
  rw [AddCircle.homeomorphAddCircle_symm_apply_mk]
  norm_num

/-- The period-eight localized symbol as a continuous function on the
standard unit additive three-torus. -/
noncomputable def unitTorusLocalizedSymbol
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) :
    UnitAddTorus (Fin 3) → ℂ :=
  fun u ↦ periodizedLocalizedSymbol α m i t
    (unitToPeriodEightCircle (u 0),
      (unitToPeriodEightCircle (u 1), unitToPeriodEightCircle (u 2)))

theorem continuous_unitTorusLocalizedSymbol
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t) :
    Continuous (unitTorusLocalizedSymbol α m i t) := by
  have hperiod : Continuous (periodizedLocalizedSymbol α m i t) :=
    continuous_periodizedLocalizedSymbol α M m hm i ht
  have h0 : Continuous (fun u : UnitAddTorus (Fin 3) ↦
      unitToPeriodEightCircle (u 0)) :=
    unitToPeriodEightCircle.continuous.comp (continuous_apply 0)
  have h1 : Continuous (fun u : UnitAddTorus (Fin 3) ↦
      unitToPeriodEightCircle (u 1)) :=
    unitToPeriodEightCircle.continuous.comp (continuous_apply 1)
  have h2 : Continuous (fun u : UnitAddTorus (Fin 3) ↦
      unitToPeriodEightCircle (u 2)) :=
    unitToPeriodEightCircle.continuous.comp (continuous_apply 2)
  let coordinates : UnitAddTorus (Fin 3) →
      PeriodEightCircle × (PeriodEightCircle × PeriodEightCircle) :=
    fun u ↦ (unitToPeriodEightCircle (u 0),
      (unitToPeriodEightCircle (u 1), unitToPeriodEightCircle (u 2)))
  have hcoordinates : Continuous coordinates := h0.prodMk (h1.prodMk h2)
  change Continuous (periodizedLocalizedSymbol α m i t ∘ coordinates)
  exact hperiod.comp hcoordinates

noncomputable def unitTorusPoint (x y z : ℝ) : UnitAddTorus (Fin 3) :=
  fun j ↦ ((![x / 8, y / 8, z / 8] j : ℝ) : UnitAddCircle)

theorem unitTorusLocalizedSymbol_coe_div
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    {x y z : ℝ} (hx : x ∈ Set.Ico (-4 : ℝ) 4)
    (hy : y ∈ Set.Ico (-4 : ℝ) 4) (hz : z ∈ Set.Ico (-4 : ℝ) 4) :
    unitTorusLocalizedSymbol α m i t (unitTorusPoint x y z) =
      localizedSymbolRaw α m i t x y z := by
  have hx' : unitToPeriodEightCircle (unitTorusPoint x y z 0) =
      (x : PeriodEightCircle) := by
    change unitToPeriodEightCircle ((x / 8 : ℝ) : UnitAddCircle) =
      (x : PeriodEightCircle)
    exact unitToPeriodEightCircle_coe_div x
  have hy' : unitToPeriodEightCircle (unitTorusPoint x y z 1) =
      (y : PeriodEightCircle) := by
    change unitToPeriodEightCircle ((y / 8 : ℝ) : UnitAddCircle) =
      (y : PeriodEightCircle)
    exact unitToPeriodEightCircle_coe_div y
  have hz' : unitToPeriodEightCircle (unitTorusPoint x y z 2) =
      (z : PeriodEightCircle) := by
    change unitToPeriodEightCircle ((z / 8 : ℝ) : UnitAddCircle) =
      (z : PeriodEightCircle)
    exact unitToPeriodEightCircle_coe_div z
  change periodizedLocalizedSymbol α m i t
    (unitToPeriodEightCircle (unitTorusPoint x y z 0),
      (unitToPeriodEightCircle (unitTorusPoint x y z 1),
        unitToPeriodEightCircle (unitTorusPoint x y z 2))) = _
  rw [hx', hy', hz']
  exact periodizedLocalizedSymbol_coe α m i t hx hy hz

/-! ## Fourier multipliers of the literal mode kernels

This scratch isolates the physical-to-frequency calculation behind the
Fourier-mode step in the cone decomposition. In particular, the real model
kernels are first complexified and then identified with translated
convolutions, so the signs are exposed rather than absorbed into a
coefficient. -/

/-- Fourier transform of the real spatial low-frequency cutoff after its
canonical complexification. -/
theorem fourier_conePhiPhysicalReal :
    (𝓕 fun x : ℝ ↦ (conePhiPhysicalReal x : ℂ)) =
      fun ξ : ℝ ↦ (conePhi ξ : ℂ) := by
  have hfun : (fun x : ℝ ↦ (conePhiPhysicalReal x : ℂ)) =
      (conePhiPhysical : ℝ → ℂ) := by
    funext x
    exact conePhiPhysical_eq_ofReal x
  rw [hfun, ← SchwartzMap.fourier_coe, schwartzFourier_conePhiPhysical]
  rfl

/-- Fourier transform of the real spatial annular cutoff after its canonical
complexification. -/
theorem fourier_conePsiPhysicalReal :
    (𝓕 fun x : ℝ ↦ (conePsiPhysicalReal x : ℂ)) =
      fun ξ : ℝ ↦ (conePsi ξ : ℂ) := by
  have hfun : (fun x : ℝ ↦ (conePsiPhysicalReal x : ℂ)) =
      (conePsiPhysical : ℝ → ℂ) := by
    funext x
    exact conePsiPhysical_eq_ofReal x
  rw [hfun, ← SchwartzMap.fourier_coe, schwartzFourier_conePsiPhysical]
  rfl

/-- Translation on the physical side gives the expected Fourier character.
This version intentionally has no integrability hypothesis: the change of
variables is valid for the totalized Lebesgue integral as well. -/
theorem fourier_translate_sub
    (f : ℝ → ℂ) (a : ℝ) :
    (𝓕 fun x : ℝ ↦ f (x - a)) =
      fun ξ : ℝ ↦ (Real.fourierChar (-(a * ξ)) : ℂ) * (𝓕 f) ξ := by
  change VectorFourier.fourierIntegral Real.fourierChar volume (innerₗ ℝ)
      (fun x : ℝ ↦ f (x - a)) =
    fun ξ : ℝ ↦ (Real.fourierChar (-(a * ξ)) : ℂ) *
      VectorFourier.fourierIntegral Real.fourierChar volume (innerₗ ℝ) f ξ
  have hcomp : f ∘ (fun v : ℝ ↦ v + -a) = fun x : ℝ ↦ f (x - a) := by
    funext x
    rfl
  have htranslate := VectorFourier.fourierIntegral_comp_add_right
    Real.fourierChar volume (innerₗ ℝ) f (-a)
  rw [hcomp] at htranslate
  simpa only [Function.comp_apply, sub_eq_add_neg, innerₗ_apply_apply, Real.inner_apply,
    Circle.smul_def, smul_eq_mul, neg_mul] using
    htranslate

/-- A positive mass-normalized physical dilation evaluates the Fourier
multiplier at the correspondingly dilated frequency. -/
theorem fourier_kernelDilate
    (f : ℝ → ℂ) (s : ℝ) (hs : 0 < s) :
    (𝓕 fun x : ℝ ↦ kernelDilate f s x) =
      fun ξ : ℝ ↦ (𝓕 f) (s * ξ) := by
  funext ξ
  let G : ℝ → ℂ := fun y ↦
    (Real.fourierChar (-(y * (s * ξ))) : ℂ) * f y
  have hkernel (x : ℝ) :
      kernelDilate f s x = (s⁻¹ : ℂ) * f (x / s) := by
    simp [kernelDilate]
  have hphase (x : ℝ) :
      (Real.fourierChar (-(x * ξ)) : ℂ) *
        ((s⁻¹ : ℂ) * f (x / s)) =
      (s⁻¹ : ℂ) * G (x / s) := by
    dsimp [G]
    have hs0 : s ≠ 0 := hs.ne'
    rw [show -((x / s) * (s * ξ)) = -(x * ξ) by field_simp]
    ring
  have hchange :
      (∫ x : ℝ, (Real.fourierChar (-(x * ξ)) : ℂ) *
        ((s⁻¹ : ℂ) * f (x / s))) = ∫ y : ℝ, G y := by
    calc
      (∫ x : ℝ, (Real.fourierChar (-(x * ξ)) : ℂ) *
          ((s⁻¹ : ℂ) * f (x / s))) =
          ∫ x : ℝ, (s⁻¹ : ℂ) * G (x / s) := by
            apply integral_congr_ae
            filter_upwards [] with x
            exact hphase x
      _ = (s⁻¹ : ℂ) * ∫ x : ℝ, G (x / s) := by
            rw [integral_const_mul]
      _ = (s⁻¹ : ℂ) * (|s| • ∫ y : ℝ, G y) := by
            rw [Measure.integral_comp_div]
      _ = ∫ y : ℝ, G y := by
            rw [abs_of_pos hs]
            rw [Complex.real_smul]
            field_simp [Complex.ofReal_ne_zero.mpr hs.ne']
  rw [Real.fourier_real_eq]
  change (∫ x : ℝ, (Real.fourierChar (-(x * ξ)) : ℂ) *
    kernelDilate f s x) = _
  rw [show (fun x : ℝ ↦
      (Real.fourierChar (-(x * ξ)) : ℂ) * kernelDilate f s x) =
        fun x ↦ (Real.fourierChar (-(x * ξ)) : ℂ) *
          ((s⁻¹ : ℂ) * f (x / s)) by
            funext x
            rw [hkernel]]
  rw [hchange]
  have hGfourier : (∫ y : ℝ, G y) = (𝓕 f) (s * ξ) := by
    rw [Real.fourier_real_eq]
    change (∫ y : ℝ, G y) =
      ∫ y : ℝ, (Real.fourierChar (-(y * (s * ξ))) : ℂ) * f y
    apply integral_congr_ae
    filter_upwards [] with y
    rfl
  exact hGfourier

/-- The complexification of the low model kernel is the convolution of the
Gaussian with the physical low cutoff, translated by `u`. -/
theorem complex_ModelLowKernel_eq_convolution_translate
    (u w : ℝ) :
    (ModelLowKernel u w : ℂ) =
      ((fun z : ℝ ↦ (gaussian z : ℂ))
        ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (fun z : ℝ ↦ (conePhiPhysicalReal z : ℂ))) (w - u) := by
  rw [convolution_mul]
  unfold ModelLowKernel
  rw [← integral_complex_ofReal]
  apply integral_congr_ae
  filter_upwards [] with z
  push_cast
  congr 1
  ring_nf

/-- Exact Fourier multiplier of the translated low model kernel. At a
negative frequency this will become the positive Fourier-series phase from
the source mode calculation. -/
theorem fourier_ModelLowKernel (u : ℝ) :
    (𝓕 fun w : ℝ ↦ (ModelLowKernel u w : ℂ)) =
      fun ξ : ℝ ↦ (Real.fourierChar (-(u * ξ)) : ℂ) *
        ((gaussian ξ : ℂ) * (conePhi ξ : ℂ)) := by
  let G : ℝ → ℂ := fun z ↦ (gaussian z : ℂ)
  let P : ℝ → ℂ := fun z ↦ (conePhiPhysicalReal z : ℂ)
  let K : ℝ → ℂ := G ⋆[ContinuousLinearMap.mul ℂ ℂ] P
  have hG : Integrable G := by
    change Integrable (fun z : ℝ ↦ Complex.ofReal (gaussian z))
    exact integrable_gaussian.ofReal
  have hP : Integrable P := by
    change Integrable (fun z : ℝ ↦ Complex.ofReal (conePhiPhysicalReal z))
    exact conePhiPhysicalReal.integrable.ofReal
  have hGfourier : (𝓕 G) = fun ξ : ℝ ↦ (gaussian ξ : ℂ) := by
    simpa only [G] using fourier_gaussian
  have hPfourier : (𝓕 P) = fun ξ : ℝ ↦ (conePhi ξ : ℂ) := by
    simpa only [P] using fourier_conePhiPhysicalReal
  have hkernel : (fun w : ℝ ↦ (ModelLowKernel u w : ℂ)) =
      fun w ↦ K (w - u) := by
    funext w
    dsimp only [K, G, P]
    exact complex_ModelLowKernel_eq_convolution_translate u w
  calc
    (𝓕 fun w : ℝ ↦ (ModelLowKernel u w : ℂ)) =
        𝓕 (fun w : ℝ ↦ K (w - u)) := by rw [hkernel]
    _ = fun ξ : ℝ ↦ (Real.fourierChar (-(u * ξ)) : ℂ) * (𝓕 K) ξ :=
      fourier_translate_sub K u
    _ = fun ξ : ℝ ↦ (Real.fourierChar (-(u * ξ)) : ℂ) *
        ((𝓕 G) ξ * (𝓕 P) ξ) := by
      funext ξ
      rw [show K = G ⋆[ContinuousLinearMap.mul ℂ ℂ] P by rfl,
        Real.fourier_mul_convolution_eq hG hP]
    _ = fun ξ : ℝ ↦ (Real.fourierChar (-(u * ξ)) : ℂ) *
        ((gaussian ξ : ℂ) * (conePhi ξ : ℂ)) := by
      rw [hGfourier, hPfourier]

/-- Evaluating the low model multiplier at `-η` produces exactly the positive
mode phase used in the localized Fourier series. -/
theorem fourier_ModelLowKernel_neg (u η : ℝ) :
    (𝓕 fun w : ℝ ↦ (ModelLowKernel u w : ℂ)) (-η) =
      (gaussian η : ℂ) * (conePhi η : ℂ) *
        (Real.fourierChar (u * η) : ℂ) := by
  rw [fourier_ModelLowKernel]
  change (Real.fourierChar (-(u * (-η)) : ℝ) : ℂ) *
      ((gaussian (-η) : ℂ) * (conePhi (-η) : ℂ)) = _
  rw [show -(u * -η) = u * η by ring, gaussian_even, conePhi_even]
  ring

/-- Complexification commutes pointwise with the scalar convolution used by
the real model kernels. -/
theorem ofReal_convolution
    (f g : ℝ → ℝ) (w : ℝ) :
    ((f ⋆[ContinuousLinearMap.mul ℝ ℝ] g) w : ℂ) =
      ((fun z : ℝ ↦ (f z : ℂ))
        ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (fun z : ℝ ↦ (g z : ℂ))) w := by
  rw [convolution_mul, convolution_mul, ← integral_complex_ofReal]
  apply integral_congr_ae
  filter_upwards [] with z
  push_cast
  rfl

/-- The complexification of the third model kernel is the translated double
Gaussian-derivative/annular convolution. -/
theorem complex_ModelThirdKernel_eq_convolution_translate
    (u w : ℝ) :
    (ModelThirdKernel u w : ℂ) =
      ((fun z : ℝ ↦ (gaussianDeriv z : ℂ))
        ⋆[ContinuousLinearMap.mul ℂ ℂ]
        ((fun z : ℝ ↦ (gaussianDeriv z : ℂ))
          ⋆[ContinuousLinearMap.mul ℂ ℂ]
          (fun z : ℝ ↦ (conePsiPhysicalReal z : ℂ)))) (w - u) := by
  rw [ModelThirdKernel_eq_convolution_translate]
  rw [ofReal_convolution]
  congr 1
  funext z
  exact ofReal_convolution gaussianDeriv conePsiPhysicalReal z

/-- Exact Fourier multiplier of the translated third model kernel. The minus
sign is the product of the two `-I` Gaussian-derivative multipliers. -/
theorem fourier_ModelThirdKernel (u : ℝ) :
    (𝓕 fun w : ℝ ↦ (ModelThirdKernel u w : ℂ)) =
      fun ξ : ℝ ↦ (Real.fourierChar (-(u * ξ)) : ℂ) *
        (-((gaussianDeriv ξ : ℂ) ^ 2 * (conePsi ξ : ℂ))) := by
  let H : ℝ → ℂ := fun z ↦ (gaussianDeriv z : ℂ)
  let P : ℝ → ℂ := fun z ↦ (conePsiPhysicalReal z : ℂ)
  let J : ℝ → ℂ := H ⋆[ContinuousLinearMap.mul ℂ ℂ] P
  let K : ℝ → ℂ := H ⋆[ContinuousLinearMap.mul ℂ ℂ] J
  have hH : Integrable H := by
    change Integrable (fun z : ℝ ↦ Complex.ofReal (gaussianDeriv z))
    exact integrable_gaussianDeriv.ofReal
  have hP : Integrable P := by
    change Integrable (fun z : ℝ ↦ Complex.ofReal (conePsiPhysicalReal z))
    exact conePsiPhysicalReal.integrable.ofReal
  have hJ : Integrable J := by
    change Integrable (H ⋆[ContinuousLinearMap.mul ℂ ℂ] P)
    exact hH.integrable_convolution (ContinuousLinearMap.mul ℂ ℂ) hP
  have hHfourier : (𝓕 H) = fun ξ : ℝ ↦
      -Complex.I * (gaussianDeriv ξ : ℂ) := by
    simpa only [H] using fourier_gaussianDeriv
  have hPfourier : (𝓕 P) = fun ξ : ℝ ↦ (conePsi ξ : ℂ) := by
    simpa only [P] using fourier_conePsiPhysicalReal
  have hJfourier : (𝓕 J) = fun ξ : ℝ ↦
      (-Complex.I * (gaussianDeriv ξ : ℂ)) * (conePsi ξ : ℂ) := by
    funext ξ
    rw [show J = H ⋆[ContinuousLinearMap.mul ℂ ℂ] P by rfl,
      Real.fourier_mul_convolution_eq hH hP, hHfourier, hPfourier]
  have hKfourier : (𝓕 K) = fun ξ : ℝ ↦
      -((gaussianDeriv ξ : ℂ) ^ 2 * (conePsi ξ : ℂ)) := by
    funext ξ
    rw [show K = H ⋆[ContinuousLinearMap.mul ℂ ℂ] J by rfl,
      Real.fourier_mul_convolution_eq hH hJ, hHfourier, hJfourier]
    ring_nf
    rw [Complex.I_sq]
    ring
  have hkernel : (fun w : ℝ ↦ (ModelThirdKernel u w : ℂ)) =
      fun w ↦ K (w - u) := by
    funext w
    dsimp only [K, H, J, P]
    exact complex_ModelThirdKernel_eq_convolution_translate u w
  calc
    (𝓕 fun w : ℝ ↦ (ModelThirdKernel u w : ℂ)) =
        𝓕 (fun w : ℝ ↦ K (w - u)) := by rw [hkernel]
    _ = fun ξ : ℝ ↦ (Real.fourierChar (-(u * ξ)) : ℂ) * (𝓕 K) ξ :=
      fourier_translate_sub K u
    _ = fun ξ : ℝ ↦ (Real.fourierChar (-(u * ξ)) : ℂ) *
        (-((gaussianDeriv ξ : ℂ) ^ 2 * (conePsi ξ : ℂ))) := by
      rw [hKfourier]

/-- At a negative frequency the third model multiplier has the source's
single explicit minus sign and the positive mode phase. -/
theorem fourier_ModelThirdKernel_neg (u η : ℝ) :
    (𝓕 fun w : ℝ ↦ (ModelThirdKernel u w : ℂ)) (-η) =
      (-((gaussianDeriv η : ℂ) ^ 2 * (conePsi η : ℂ))) *
        (Real.fourierChar (u * η) : ℂ) := by
  rw [fourier_ModelThirdKernel]
  change (Real.fourierChar (-(u * (-η)) : ℝ) : ℂ) *
      (-((gaussianDeriv (-η) : ℂ) ^ 2 * (conePsi (-η) : ℂ))) = _
  rw [show -(u * -η) = u * η by ring, gaussianDeriv_neg, conePsi_even]
  rw [Complex.ofReal_neg, neg_sq]
  ring

/-- The first/second-coordinate mode multiplier at the literal source
translation `ν / 8`. -/
theorem fourier_ModelLowKernel_standardMode_neg
    (ν : standardModeLattice) (j : Fin 3) (η : ℝ) :
    (𝓕 fun w : ℝ ↦ (ModelLowKernel (standardModeTranslate ν j) w : ℂ)) (-η) =
      (gaussian η : ℂ) * (conePhi η : ℂ) *
        (Real.fourierChar ((8 : ℝ)⁻¹ * (ν : E3) j * η) : ℂ) := by
  simpa only [standardModeTranslate_apply] using
    fourier_ModelLowKernel_neg (standardModeTranslate ν j) η

/-- The active-coordinate mode multiplier at the literal source translation
`ν / 8`, including the single sign absorbed by the Fourier coefficient in
the cone decomposition. -/
theorem fourier_ModelThirdKernel_standardMode_neg
    (ν : standardModeLattice) (j : Fin 3) (η : ℝ) :
    (𝓕 fun w : ℝ ↦ (ModelThirdKernel (standardModeTranslate ν j) w : ℂ)) (-η) =
      (-((gaussianDeriv η : ℂ) ^ 2 * (conePsi η : ℂ))) *
        (Real.fourierChar ((8 : ℝ)⁻¹ * (ν : E3) j * η) : ℂ) := by
  simpa only [standardModeTranslate_apply] using
    fourier_ModelThirdKernel_neg (standardModeTranslate ν j) η

/-- The low model kernel at a positive model scale has precisely the scaled
low-cone multiplier and mode phase. -/
theorem fourier_kernelDilate_ModelLowKernel_neg
    (u s η : ℝ) (hs : 0 < s) :
    (𝓕 fun w : ℝ ↦ ((kernelDilate (ModelLowKernel u) s w : ℝ) : ℂ)) (-η) =
      (gaussian (s * η) : ℂ) * (conePhi (s * η) : ℂ) *
        (Real.fourierChar (u * (s * η)) : ℂ) := by
  have hdilate : (fun w : ℝ ↦
      ((kernelDilate (ModelLowKernel u) s w : ℝ) : ℂ)) =
      fun w ↦ kernelDilate (fun r : ℝ ↦ (ModelLowKernel u r : ℂ)) s w := by
    funext w
    simp [kernelDilate]
  rw [hdilate, fourier_kernelDilate _ s hs]
  change (𝓕 fun r : ℝ ↦ (ModelLowKernel u r : ℂ)) (s * (-η)) = _
  rw [show s * -η = -(s * η) by ring]
  exact fourier_ModelLowKernel_neg u (s * η)

/-- The active third model kernel at a positive scale has the scaled annular
multiplier, the positive mode phase, and exactly one minus sign. -/
theorem fourier_kernelDilate_ModelThirdKernel_neg
    (u s η : ℝ) (hs : 0 < s) :
    (𝓕 fun w : ℝ ↦ ((kernelDilate (ModelThirdKernel u) s w : ℝ) : ℂ)) (-η) =
      (-((gaussianDeriv (s * η) : ℂ) ^ 2 * (conePsi (s * η) : ℂ))) *
        (Real.fourierChar (u * (s * η)) : ℂ) := by
  have hdilate : (fun w : ℝ ↦
      ((kernelDilate (ModelThirdKernel u) s w : ℝ) : ℂ)) =
      fun w ↦ kernelDilate (fun r : ℝ ↦ (ModelThirdKernel u r : ℂ)) s w := by
    funext w
    simp [kernelDilate]
  rw [hdilate, fourier_kernelDilate _ s hs]
  change (𝓕 fun r : ℝ ↦ (ModelThirdKernel u r : ℂ)) (s * (-η)) = _
  rw [show s * -η = -(s * η) by ring]
  exact fourier_ModelThirdKernel_neg u (s * η)

/-- The scaled first/second-coordinate multiplier at the literal source
translation `ν / 8`. -/
theorem fourier_kernelDilate_ModelLowKernel_standardMode_neg
    (ν : standardModeLattice) (j : Fin 3) (s η : ℝ) (hs : 0 < s) :
    (𝓕 fun w : ℝ ↦
      ((kernelDilate (ModelLowKernel (standardModeTranslate ν j)) s w : ℝ) : ℂ)) (-η) =
      (gaussian (s * η) : ℂ) * (conePhi (s * η) : ℂ) *
        (Real.fourierChar ((8 : ℝ)⁻¹ * (ν : E3) j * (s * η)) : ℂ) := by
  simpa only [standardModeTranslate_apply] using
    fourier_kernelDilate_ModelLowKernel_neg
      (standardModeTranslate ν j) s η hs

/-- The scaled active-coordinate multiplier at the literal source translation
`ν / 8`, with its coefficient-absorbed Fourier sign visible. -/
theorem fourier_kernelDilate_ModelThirdKernel_standardMode_neg
    (ν : standardModeLattice) (j : Fin 3) (s η : ℝ) (hs : 0 < s) :
    (𝓕 fun w : ℝ ↦
      ((kernelDilate (ModelThirdKernel (standardModeTranslate ν j)) s w : ℝ) : ℂ)) (-η) =
      (-((gaussianDeriv (s * η) : ℂ) ^ 2 * (conePsi (s * η) : ℂ))) *
        (Real.fourierChar ((8 : ℝ)⁻¹ * (ν : E3) j * (s * η)) : ℂ) := by
  simpa only [standardModeTranslate_apply] using
    fourier_kernelDilate_ModelThirdKernel_neg
      (standardModeTranslate ν j) s η hs

/-- The product of the three scalar Fourier phases is the character of their
sum, in the exact convention used by the source Fourier series. -/
theorem fourierChar_three (a b c : ℝ) :
    (Real.fourierChar a : ℂ) * (Real.fourierChar b : ℂ) *
      (Real.fourierChar c : ℂ) =
        (Real.fourierChar (a + b + c) : ℂ) := by
  calc
    (Real.fourierChar a : ℂ) * (Real.fourierChar b : ℂ) *
        (Real.fourierChar c : ℂ) =
        (Real.fourierChar (a + b) : ℂ) * (Real.fourierChar c : ℂ) := by
          simp only [Real.fourierChar.map_add_eq_mul, Circle.coe_mul]
    _ = (Real.fourierChar (a + b + c) : ℂ) := by
      simp only [Real.fourierChar.map_add_eq_mul, Circle.coe_mul]

/-- The literal product multiplier for the third active coordinate. This is
the frequency-side model kernel at arbitrary positive coordinate scales,
before specializing `s_j = t^{α_j}` and `u = ν / 8`. -/
theorem fourier_ModelKernelProduct_third_neg
    (u s η : E3) (hs : ∀ j : Fin 3, 0 < s j) :
    (𝓕 fun w : ℝ ↦
      ((kernelDilate (ModelLowKernel (u 0)) (s 0) w : ℝ) : ℂ)) (-(η 0)) *
      (𝓕 fun w : ℝ ↦
        ((kernelDilate (ModelLowKernel (u 1)) (s 1) w : ℝ) : ℂ)) (-(η 1)) *
      (𝓕 fun w : ℝ ↦
        ((kernelDilate (ModelThirdKernel (u 2)) (s 2) w : ℝ) : ℂ)) (-(η 2)) =
      -(((gaussian (s 0 * η 0) : ℂ) * (conePhi (s 0 * η 0) : ℂ)) *
          ((gaussian (s 1 * η 1) : ℂ) * (conePhi (s 1 * η 1) : ℂ)) *
          ((gaussianDeriv (s 2 * η 2) : ℂ) ^ 2 *
            (conePsi (s 2 * η 2) : ℂ))) *
        (Real.fourierChar
          (u 0 * (s 0 * η 0) + u 1 * (s 1 * η 1) + u 2 * (s 2 * η 2)) : ℂ) := by
  have h0 := fourier_kernelDilate_ModelLowKernel_neg
    (u 0) (s 0) (η 0) (hs 0)
  have h1 := fourier_kernelDilate_ModelLowKernel_neg
    (u 1) (s 1) (η 1) (hs 1)
  have h2 := fourier_kernelDilate_ModelThirdKernel_neg
    (u 2) (s 2) (η 2) (hs 2)
  rw [h0, h1, h2]
  rw [← fourierChar_three]
  ring

/-- The literal three-coordinate mode product at the source translation
`ν / 8`. This is the exact kernel-multiplier/sign calculation needed before
the localized-symbol Fourier coefficients are inserted. -/
theorem fourier_ModelKernelProduct_third_standardMode_neg
    (ν : standardModeLattice) (s η : E3) (hs : ∀ j : Fin 3, 0 < s j) :
    (𝓕 fun w : ℝ ↦
      ((kernelDilate (ModelLowKernel (standardModeTranslate ν 0)) (s 0) w : ℝ) : ℂ))
        (-(η 0)) *
      (𝓕 fun w : ℝ ↦
        ((kernelDilate (ModelLowKernel (standardModeTranslate ν 1)) (s 1) w : ℝ) : ℂ))
        (-(η 1)) *
      (𝓕 fun w : ℝ ↦
        ((kernelDilate (ModelThirdKernel (standardModeTranslate ν 2)) (s 2) w : ℝ) : ℂ))
        (-(η 2)) =
      -(((gaussian (s 0 * η 0) : ℂ) * (conePhi (s 0 * η 0) : ℂ)) *
          ((gaussian (s 1 * η 1) : ℂ) * (conePhi (s 1 * η 1) : ℂ)) *
          ((gaussianDeriv (s 2 * η 2) : ℂ) ^ 2 *
            (conePsi (s 2 * η 2) : ℂ))) *
        (Real.fourierChar
          ((8 : ℝ)⁻¹ * (ν : E3) 0 * (s 0 * η 0) +
            (8 : ℝ)⁻¹ * (ν : E3) 1 * (s 1 * η 1) +
            (8 : ℝ)⁻¹ * (ν : E3) 2 * (s 2 * η 2)) : ℂ) := by
  simpa only [standardModeTranslate_apply] using
    fourier_ModelKernelProduct_third_neg
      (standardModeTranslate ν) s η hs

/-- The finite-scale third-active-coordinate kernel product, evaluated at the
three diagonal frequencies in the literal `E9` formula. The vector
`-frequencyDiagonal ζ` is precisely the source variable
`ξ_j = -ζ^{(j)}_j`; consequently the Fourier transforms on the left are
evaluated at the three input-frequency coordinates themselves. -/
theorem fourier_ModelKernelProduct_third_standardMode_frequencyDiagonal
    (ν : standardModeLattice) (s : E3) (hs : ∀ j : Fin 3, 0 < s j)
    (ζ : Frequency9) :
    (𝓕 fun w : ℝ ↦
      ((kernelDilate (ModelLowKernel (standardModeTranslate ν 0)) (s 0) w : ℝ) : ℂ))
        (frequencyDiagonal ζ 0) *
      (𝓕 fun w : ℝ ↦
        ((kernelDilate (ModelLowKernel (standardModeTranslate ν 1)) (s 1) w : ℝ) : ℂ))
        (frequencyDiagonal ζ 1) *
      (𝓕 fun w : ℝ ↦
        ((kernelDilate (ModelThirdKernel (standardModeTranslate ν 2)) (s 2) w : ℝ) : ℂ))
        (frequencyDiagonal ζ 2) =
      -(((gaussian (s 0 * (-(frequencyDiagonal ζ 0))) : ℂ) *
          (conePhi (s 0 * (-(frequencyDiagonal ζ 0))) : ℂ)) *
          ((gaussian (s 1 * (-(frequencyDiagonal ζ 1))) : ℂ) *
            (conePhi (s 1 * (-(frequencyDiagonal ζ 1))) : ℂ)) *
          ((gaussianDeriv (s 2 * (-(frequencyDiagonal ζ 2))) : ℂ) ^ 2 *
            (conePsi (s 2 * (-(frequencyDiagonal ζ 2))) : ℂ))) *
        (Real.fourierChar
          ((8 : ℝ)⁻¹ * (ν : E3) 0 * (s 0 * (-(frequencyDiagonal ζ 0))) +
            (8 : ℝ)⁻¹ * (ν : E3) 1 * (s 1 * (-(frequencyDiagonal ζ 1))) +
            (8 : ℝ)⁻¹ * (ν : E3) 2 * (s 2 * (-(frequencyDiagonal ζ 2))) : ℝ) : ℂ) := by
  simpa using fourier_ModelKernelProduct_third_standardMode_neg
    ν s (-frequencyDiagonal ζ) hs

/-- The source anisotropic vector of positive one-dimensional model scales at
time `t`. It records the three factors `t^{α_j}` without choosing a
coordinate-dependent notation outside the ambient Euclidean carrier. -/
noncomputable def modelScaleVector (α : Anisotropy) (t : ℝ) : E3 :=
  WithLp.toLp 2 fun j ↦ t ^ α.weight j

@[simp] theorem modelScaleVector_apply
    (α : Anisotropy) (t : ℝ) (j : Fin 3) :
    modelScaleVector α t j = t ^ α.weight j := by
  simp [modelScaleVector]

/-- The literal source finite-scale, third-active-coordinate Fourier
multiplier at an `E9` frequency point. This is the exact pointwise kernel
calculation used after inserting a Fourier mode into the `t`-scale integrand
of the frequency representation; its sole sign is the active derivative
multiplier. -/
theorem fourier_ModelKernelProduct_third_standardMode_frequencyDiagonal_scale
    (α : Anisotropy) (ν : standardModeLattice) (t : ℝ) (ht : 0 < t)
    (ζ : Frequency9) :
    (𝓕 fun w : ℝ ↦
      ((kernelDilate (ModelLowKernel (standardModeTranslate ν 0))
        (t ^ α.weight 0) w : ℝ) : ℂ)) (frequencyDiagonal ζ 0) *
      (𝓕 fun w : ℝ ↦
        ((kernelDilate (ModelLowKernel (standardModeTranslate ν 1))
          (t ^ α.weight 1) w : ℝ) : ℂ)) (frequencyDiagonal ζ 1) *
      (𝓕 fun w : ℝ ↦
        ((kernelDilate (ModelThirdKernel (standardModeTranslate ν 2))
          (t ^ α.weight 2) w : ℝ) : ℂ)) (frequencyDiagonal ζ 2) =
      -(((gaussian (t ^ α.weight 0 * (-(frequencyDiagonal ζ 0))) : ℂ) *
          (conePhi (t ^ α.weight 0 * (-(frequencyDiagonal ζ 0))) : ℂ)) *
          ((gaussian (t ^ α.weight 1 * (-(frequencyDiagonal ζ 1))) : ℂ) *
            (conePhi (t ^ α.weight 1 * (-(frequencyDiagonal ζ 1))) : ℂ)) *
          ((gaussianDeriv (t ^ α.weight 2 * (-(frequencyDiagonal ζ 2))) : ℂ) ^ 2 *
            (conePsi (t ^ α.weight 2 * (-(frequencyDiagonal ζ 2))) : ℂ))) *
        (Real.fourierChar
          ((8 : ℝ)⁻¹ * (ν : E3) 0 *
              (t ^ α.weight 0 * (-(frequencyDiagonal ζ 0))) +
            (8 : ℝ)⁻¹ * (ν : E3) 1 *
              (t ^ α.weight 1 * (-(frequencyDiagonal ζ 1))) +
            (8 : ℝ)⁻¹ * (ν : E3) 2 *
              (t ^ α.weight 2 * (-(frequencyDiagonal ζ 2))) : ℝ) : ℂ) := by
  let s : E3 := modelScaleVector α t
  have hs : ∀ j : Fin 3, 0 < s j := by
    intro j
    simp only [s, modelScaleVector_apply]
    exact pow_pos ht _
  simpa only [s, modelScaleVector_apply] using
    fourier_ModelKernelProduct_third_standardMode_frequencyDiagonal
      ν s hs ζ

/-- The Fourier-side product of the three literal spatial model kernels at a
single positive scale, written on the `E9` carrier of `frequencyForm`. -/
noncomputable def thirdModeKernelFourierProduct
    (α : Anisotropy) (ν : standardModeLattice) (t : ℝ) (ζ : Frequency9) : ℂ :=
  (𝓕 fun w : ℝ ↦
    ((kernelDilate (ModelLowKernel (standardModeTranslate ν 0))
      (t ^ α.weight 0) w : ℝ) : ℂ)) (frequencyDiagonal ζ 0) *
    (𝓕 fun w : ℝ ↦
      ((kernelDilate (ModelLowKernel (standardModeTranslate ν 1))
        (t ^ α.weight 1) w : ℝ) : ℂ)) (frequencyDiagonal ζ 1) *
    (𝓕 fun w : ℝ ↦
      ((kernelDilate (ModelThirdKernel (standardModeTranslate ν 2))
        (t ^ α.weight 2) w : ℝ) : ℂ)) (frequencyDiagonal ζ 2)

/-- The positive cone-cutoff multiplier carried by one Fourier mode in the
third active coordinate. Its argument is the source diagonal variable
`ξ=-frequencyDiagonal ζ`, and the leading negative sign from the physical
third kernel is deliberately absent: it is absorbed by the model coefficient
in the source proof. -/
noncomputable def thirdModeFrequencySymbol
    (α : Anisotropy) (ν : standardModeLattice) (t : ℝ) (ξ : E3) : ℂ :=
  ((gaussian (t ^ α.weight 0 * ξ 0) : ℂ) *
      (conePhi (t ^ α.weight 0 * ξ 0) : ℂ)) *
    ((gaussian (t ^ α.weight 1 * ξ 1) : ℂ) *
      (conePhi (t ^ α.weight 1 * ξ 1) : ℂ)) *
    ((gaussianDeriv (t ^ α.weight 2 * ξ 2) : ℂ) ^ 2 *
      (conePsi (t ^ α.weight 2 * ξ 2) : ℂ)) *
    (Real.fourierChar
      ((8 : ℝ)⁻¹ * (ν : E3) 0 * (t ^ α.weight 0 * ξ 0) +
        (8 : ℝ)⁻¹ * (ν : E3) 1 * (t ^ α.weight 1 * ξ 1) +
        (8 : ℝ)⁻¹ * (ν : E3) 2 * (t ^ α.weight 2 * ξ 2) : ℝ) : ℂ)

/-- At an `E9` frequency point, the product of the literal third-active
spatial kernel multipliers is the negative of the corresponding localized
Fourier-mode symbol. This is the exact sign bridge used in
`thm:cone`, lines 2998--3015. -/
theorem thirdModeKernelFourierProduct_eq_neg_frequencySymbol
    (α : Anisotropy) (ν : standardModeLattice) (t : ℝ) (ht : 0 < t)
    (ζ : Frequency9) :
    thirdModeKernelFourierProduct α ν t ζ =
      -thirdModeFrequencySymbol α ν t (-frequencyDiagonal ζ) := by
  unfold thirdModeKernelFourierProduct thirdModeFrequencySymbol
  rw [fourier_ModelKernelProduct_third_standardMode_frequencyDiagonal_scale
    α ν t ht ζ]
  simp only [PiLp.neg_apply]
  ring

/-- The finite-scale `E9` frequency integral associated with one third-active
Fourier mode. This is intentionally expressed through the existing
`frequencyForm`, so its relationship with `multiplierForm` is available once
the localized symbol's multiplier hypotheses are supplied. -/
noncomputable def thirdModeFrequencyForm
    (α : Anisotropy) (ν : standardModeLattice) (t : ℝ)
    (F : ModelComplexSchwartzInput) : ℂ :=
  frequencyForm (thirdModeFrequencySymbol α ν t)
    (F 0) (F 1) (F 2) (F 3)

/-- The `E9` frequency form of one finite-scale third-active mode equals the
frequency integral obtained by placing the literal spatial kernel product
beside the four-input frequency kernel. This is an exact pointwise-to-
integral bridge; no Fubini interchange is hidden in the statement. -/
theorem thirdModeFrequencyForm_eq_kernelProductIntegral
    (α : Anisotropy) (ν : standardModeLattice) (t : ℝ) (ht : 0 < t)
    (F : ModelComplexSchwartzInput) :
    thirdModeFrequencyForm α ν t F =
      ∫ ζ : Frequency9,
        (-thirdModeKernelFourierProduct α ν t ζ) *
          frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ
        ∂frequencyMeasure := by
  unfold thirdModeFrequencyForm frequencyForm
  apply integral_congr_ae
  filter_upwards [] with ζ
  rw [thirdModeKernelFourierProduct_eq_neg_frequencySymbol
    α ν t ht ζ]
  ring

/-- Conditional `multiplierForm` version of the finite-scale bridge. The
only remaining analytic premise is the already standard multiplier condition
for the compact localized mode symbol; under it, the existing
`multiplierForm_eq_frequencyForm` theorem turns the literal multiplier form
into the exact `E9` kernel-product integral above. -/
theorem multiplierForm_thirdModeFrequencySymbol_eq_kernelProductIntegral
    (α : Anisotropy) (M : ℝ) (ν : standardModeLattice) (t : ℝ) (ht : 0 < t)
    (hm : Anisotropy.IsAnisotropicMultiplier α M
      (thirdModeFrequencySymbol α ν t))
    (F : ModelComplexSchwartzInput) :
    multiplierForm (thirdModeFrequencySymbol α ν t)
      (F 0) (F 1) (F 2) (F 3) =
      ∫ ζ : Frequency9,
        (-thirdModeKernelFourierProduct α ν t ζ) *
          frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ
        ∂frequencyMeasure := by
  calc
    multiplierForm (thirdModeFrequencySymbol α ν t)
        (F 0) (F 1) (F 2) (F 3) =
        frequencyForm (thirdModeFrequencySymbol α ν t)
          (F 0) (F 1) (F 2) (F 3) :=
      multiplierForm_eq_frequencyForm α M
        (thirdModeFrequencySymbol α ν t) hm (F 0) (F 1) (F 2) (F 3)
    _ = thirdModeFrequencyForm α ν t F := rfl
    _ = ∫ ζ : Frequency9,
        (-thirdModeKernelFourierProduct α ν t ζ) *
          frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ
        ∂frequencyMeasure :=
      thirdModeFrequencyForm_eq_kernelProductIntegral α ν t ht F

/-- The phase in the `E3` kernel integral splits into the three scalar
Fourier characters at the diagonal frequency coordinates. -/
theorem frequencyPhase_neg_coordinate_expand
    (ζ : Frequency9) (r : E3) :
    frequencyPhase (frequencyDiagonal ζ) (-r) =
      (Real.fourierChar (-(r 0 * frequencyDiagonal ζ 0)) : ℂ) *
        ((Real.fourierChar (-(r 1 * frequencyDiagonal ζ 1)) : ℂ) *
          (Real.fourierChar (-(r 2 * frequencyDiagonal ζ 2)) : ℂ)) := by
  have h0 : frequencyDiagonal ζ 0 = ζ.1.1 0 := by
    rw [frequencyDiagonal_apply]
    simp [coordinateDirection_apply]
  have h1 : frequencyDiagonal ζ 1 = ζ.1.2 1 := by
    rw [frequencyDiagonal_apply]
    simp [coordinateDirection_apply]
  have h2 : frequencyDiagonal ζ 2 = ζ.2 2 := by
    rw [frequencyDiagonal_apply]
    simp [coordinateDirection_apply]
  unfold frequencyPhase
  rw [inner_frequencyDiagonal]
  simp only [PiLp.neg_apply]
  rw [mul_neg, mul_neg, mul_neg]
  rw [← Circle.coe_mul, ← Circle.coe_mul]
  rw [← AddChar.map_add_eq_mul, ← AddChar.map_add_eq_mul]
  rw [h0, h1, h2]
  apply congrArg (fun a : ℝ ↦ (Real.fourierChar a : ℂ))
  ring

/-- Integrating a product of three one-dimensional kernels against the
negative translated-product phase gives the product of their scalar Fourier
multipliers at the three diagonal frequency coordinates. This is the kernel
half of the spatial/Fourier Fubini bridge, with no integrability side
condition because all integrals use Lean's totalized convention. -/
theorem threeKernel_phaseIntegral_eq_fourierProduct
    (k₀ k₁ k₂ : ℝ → ℂ) (ζ : Frequency9) :
    (∫ r : E3,
      (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
        frequencyPhase (frequencyDiagonal ζ) (-r)) =
      (𝓕 k₀) (frequencyDiagonal ζ 0) *
        ((𝓕 k₁) (frequencyDiagonal ζ 1) *
          (𝓕 k₂) (frequencyDiagonal ζ 2)) := by
  let R : ℂ := (𝓕 k₀) (frequencyDiagonal ζ 0) *
    ((𝓕 k₁) (frequencyDiagonal ζ 1) *
      (𝓕 k₂) (frequencyDiagonal ζ 2))
  change (∫ r : E3,
    (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
      frequencyPhase (frequencyDiagonal ζ) (-r)) = R
  let A : ℝ → ℂ := fun r ↦
    (Real.fourierChar (-(r * frequencyDiagonal ζ 0)) : ℂ) * k₀ r
  let B : ℝ → ℂ := fun r ↦
    (Real.fourierChar (-(r * frequencyDiagonal ζ 1)) : ℂ) * k₁ r
  let C : ℝ → ℂ := fun r ↦
    (Real.fourierChar (-(r * frequencyDiagonal ζ 2)) : ℂ) * k₂ r
  let e : E3 ≃ᵐ ℝ × (ℝ × ℝ) := e3Coordinates
  have hmp : MeasurePreserving e (volume : Measure E3)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    simpa only [e] using e3Coordinates_measurePreserving
  have hA : (∫ r : ℝ, A r) = (𝓕 k₀) (frequencyDiagonal ζ 0) := by
    rw [Real.fourier_real_eq]
    change (∫ r : ℝ,
      (Real.fourierChar (-(r * frequencyDiagonal ζ 0)) : ℂ) * k₀ r) = _
    rfl
  have hB : (∫ r : ℝ, B r) = (𝓕 k₁) (frequencyDiagonal ζ 1) := by
    rw [Real.fourier_real_eq]
    change (∫ r : ℝ,
      (Real.fourierChar (-(r * frequencyDiagonal ζ 1)) : ℂ) * k₁ r) = _
    rfl
  have hC : (∫ r : ℝ, C r) = (𝓕 k₂) (frequencyDiagonal ζ 2) := by
    rw [Real.fourier_real_eq]
    change (∫ r : ℝ,
      (Real.fourierChar (-(r * frequencyDiagonal ζ 2)) : ℂ) * k₂ r) = _
    rfl
  calc
    (∫ r : E3,
      (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
        frequencyPhase (frequencyDiagonal ζ) (-r)) =
        ∫ z : ℝ × (ℝ × ℝ),
          ((k₀ ((e.symm z) 0) * k₁ ((e.symm z) 1)) * k₂ ((e.symm z) 2) *
            frequencyPhase (frequencyDiagonal ζ) (-(e.symm z)))
          ∂((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
            exact (MeasurePreserving.symm e hmp).integral_comp
              e.symm.measurableEmbedding _ |>.symm
    _ = ∫ z : ℝ × (ℝ × ℝ), A z.1 * (B z.2.1 * C z.2.2)
          ∂((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
            apply integral_congr_ae
            filter_upwards [] with z
            have heq := e.apply_symm_apply z
            have h0 : (e.symm z) 0 = z.1 := by
              simpa only [e, e3Coordinates_apply] using congrArg Prod.fst heq
            have h1 : (e.symm z) 1 = z.2.1 := by
              simpa only [e, e3Coordinates_apply] using
                congrArg (fun q : ℝ × (ℝ × ℝ) ↦ q.2.1) heq
            have h2 : (e.symm z) 2 = z.2.2 := by
              simpa only [e, e3Coordinates_apply] using
                congrArg (fun q : ℝ × (ℝ × ℝ) ↦ q.2.2) heq
            rw [frequencyPhase_neg_coordinate_expand, h0, h1, h2]
            dsimp only [A, B, C]
            ring
    _ = (∫ r : ℝ, A r) * ((∫ r : ℝ, B r) * ∫ r : ℝ, C r) := by
            rw [integral_prod_mul (μ := volume)
              (ν := (volume : Measure ℝ).prod volume) A
              (fun q : ℝ × ℝ ↦ B q.1 * C q.2)]
            rw [integral_prod_mul (μ := volume) (ν := volume) B C]
    _ = (𝓕 k₀) (frequencyDiagonal ζ 0) *
        ((∫ r : ℝ, B r) * ∫ r : ℝ, C r) := by
            exact congrArg (fun a : ℂ ↦ a *
              ((∫ r : ℝ, B r) * ∫ r : ℝ, C r)) hA
    _ = (𝓕 k₀) (frequencyDiagonal ζ 0) *
        ((𝓕 k₁) (frequencyDiagonal ζ 1) * ∫ r : ℝ, C r) := by
            exact congrArg (fun b : ℂ ↦
              (𝓕 k₀) (frequencyDiagonal ζ 0) *
                (b * ∫ r : ℝ, C r)) hB
    _ = R := by
            change (𝓕 k₀) (frequencyDiagonal ζ 0) *
              ((𝓕 k₁) (frequencyDiagonal ζ 1) * ∫ r : ℝ, C r) =
                (𝓕 k₀) (frequencyDiagonal ζ 0) *
                  ((𝓕 k₁) (frequencyDiagonal ζ 1) *
                    (𝓕 k₂) (frequencyDiagonal ζ 2))
            rw [hC]

/-- Products of three integrable one-dimensional kernels are integrable on
the `E3` kernel-variable space. The coordinate transport is explicit so
that this can be reused in the subsequent Fubini step. -/
theorem threeKernel_integrable
    (k₀ k₁ k₂ : ℝ → ℂ)
    (hk₀ : Integrable k₀) (hk₁ : Integrable k₁) (hk₂ : Integrable k₂) :
    Integrable (fun r : E3 ↦
      (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2)) := by
  let L : ℝ × (ℝ × ℝ) → ℂ := fun z ↦
    k₀ z.1 * (k₁ z.2.1 * k₂ z.2.2)
  have hL : Integrable L
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    exact hk₀.mul_prod (hk₁.mul_prod hk₂)
  let e : E3 ≃ᵐ ℝ × (ℝ × ℝ) := e3Coordinates
  have hmp : MeasurePreserving e (volume : Measure E3)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    simpa only [e] using e3Coordinates_measurePreserving
  have htransport : Integrable (L ∘ e) :=
    hmp.integrable_comp_of_integrable hL
  apply htransport.congr
  filter_upwards [] with r
  simp only [Function.comp_apply, L, e, e3Coordinates_apply]
  ring

/-- The phase factor on the product of the kernel and source-frequency
variables is continuous and has norm one. -/
theorem kernelFrequencyPhase_continuous :
    Continuous (fun p : E3 × Frequency9 ↦
      frequencyPhase (frequencyDiagonal p.2) (-p.1)) := by
  unfold frequencyPhase
  exact continuous_subtype_val.comp
    (Real.continuous_fourierChar.comp
      (continuous_inner.comp
        ((frequencyDiagonal.continuous.comp continuous_snd).prodMk
          (continuous_neg.comp continuous_fst))))

/-- The kernel/frequency integrand used in the Fubini bridge is integrable
whenever all three scalar kernels are integrable. -/
theorem jointKernelFrequency_integrable
    (f₀ f₁ f₂ f₃ : Schwartz3) (k₀ k₁ k₂ : ℝ → ℂ)
    (hk₀ : Integrable k₀) (hk₁ : Integrable k₁) (hk₂ : Integrable k₂) :
    Integrable (Function.uncurry (fun r : E3 ↦ fun ζ : Frequency9 ↦
      ((k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
        frequencyPhase (frequencyDiagonal ζ) (-r)) *
          frequencyKernel f₀ f₁ f₂ f₃ ζ)) := by
  let : (volume : Measure (E3 × E3)).IsAddHaarMeasure :=
    Measure.prod.instIsAddHaarMeasure volume volume
  let : (volume : Measure Frequency9).IsAddHaarMeasure :=
    Measure.prod.instIsAddHaarMeasure (volume : Measure (E3 × E3)) volume
  let K : E3 → ℂ := fun r ↦ (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2)
  let H : Frequency9 → ℂ := frequencyKernel f₀ f₁ f₂ f₃
  have hK : Integrable K := by
    simpa only [K] using threeKernel_integrable k₀ k₁ k₂ hk₀ hk₁ hk₂
  have hH : Integrable H := by
    exact (frequencyKernel f₀ f₁ f₂ f₃).integrable
  have hbase : Integrable (fun p : E3 × Frequency9 ↦ K p.1 * H p.2) := by
    simpa only [Measure.volume_eq_prod] using hK.mul_prod hH
  have hphase : AEStronglyMeasurable (fun p : E3 × Frequency9 ↦
      frequencyPhase (frequencyDiagonal p.2) (-p.1)) :=
    kernelFrequencyPhase_continuous.aestronglyMeasurable
  have hphaseNorm : ∀ᵐ p : E3 × Frequency9,
      ‖frequencyPhase (frequencyDiagonal p.2) (-p.1)‖ ≤ (1 : ℝ) :=
    Filter.Eventually.of_forall fun p ↦ by
      rw [norm_frequencyPhase]
  have hmul := hbase.mul_bdd hphase hphaseNorm
  apply hmul.congr
  filter_upwards [] with p
  change (K p.1 * H p.2) *
    frequencyPhase (frequencyDiagonal p.2) (-p.1) =
      K p.1 * frequencyPhase (frequencyDiagonal p.2) (-p.1) * H p.2
  ring

/-- The exact Fubini interface between a joint spatial kernel integral and
the source `E9` frequency integral. The sole analytic hypothesis is stated
at the one place where Fubini is used; the phase/product calculation itself
is supplied by `threeKernel_phaseIntegral_eq_fourierProduct`.

The spatial factor is `twistedProduct` evaluated at `-r`, which is exactly
what results after opening the three coordinate convolutions with kernel
variables `r₀,r₁,r₂`. -/
theorem jointKernelIntegral_eq_frequencyKernelIntegral
    (f₀ f₁ f₂ f₃ : Schwartz3) (k₀ k₁ k₂ : ℝ → ℂ)
    (hQ : Integrable (Function.uncurry (fun r : E3 ↦ fun ζ : Frequency9 ↦
      ((k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
        frequencyPhase (frequencyDiagonal ζ) (-r)) *
          frequencyKernel f₀ f₁ f₂ f₃ ζ))) :
    (∫ r : E3,
      (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
        twistedProduct f₀ f₁ f₂ f₃ (-r)) =
      ∫ ζ : Frequency9,
        ((𝓕 k₀) (frequencyDiagonal ζ 0) *
          ((𝓕 k₁) (frequencyDiagonal ζ 1) *
            (𝓕 k₂) (frequencyDiagonal ζ 2))) *
          frequencyKernel f₀ f₁ f₂ f₃ ζ := by
  let R : ℂ := ∫ ζ : Frequency9,
    ((𝓕 k₀) (frequencyDiagonal ζ 0) *
      ((𝓕 k₁) (frequencyDiagonal ζ 1) *
        (𝓕 k₂) (frequencyDiagonal ζ 2))) *
      frequencyKernel f₀ f₁ f₂ f₃ ζ
  change (∫ r : E3,
    (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
      twistedProduct f₀ f₁ f₂ f₃ (-r)) = R
  let Q : E3 → Frequency9 → ℂ := fun r ζ ↦
    ((k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
      frequencyPhase (frequencyDiagonal ζ) (-r)) *
        frequencyKernel f₀ f₁ f₂ f₃ ζ
  have hQ' : Integrable (Function.uncurry Q) := by
    simpa only [Q] using hQ
  calc
    (∫ r : E3,
      (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
        twistedProduct f₀ f₁ f₂ f₃ (-r)) =
        ∫ r : E3, ∫ ζ : Frequency9, Q r ζ := by
          apply integral_congr_ae
          filter_upwards [] with r
          rw [← frequencyKernel_phase_integral_eq_twistedProduct]
          rw [← integral_const_mul]
          apply integral_congr_ae
          filter_upwards [] with ζ
          dsimp only [Q]
          ring
    _ = ∫ ζ : Frequency9, ∫ r : E3, Q r ζ :=
      integral_integral_swap hQ'
    _ = R := by
      change (∫ ζ : Frequency9, ∫ r : E3,
        ((k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
          frequencyPhase (frequencyDiagonal ζ) (-r)) *
            frequencyKernel f₀ f₁ f₂ f₃ ζ) = _
      apply integral_congr_ae
      filter_upwards [] with ζ
      change (∫ r : E3,
        ((k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
          frequencyPhase (frequencyDiagonal ζ) (-r)) *
            frequencyKernel f₀ f₁ f₂ f₃ ζ) = _
      rw [integral_mul_const,
        threeKernel_phaseIntegral_eq_fourierProduct]

/-- The joint spatial kernel integral and the source frequency integral agree
for any three integrable one-dimensional complex kernels. This packages the
fully justified Fubini step, so later model-kernel specializations only need
to provide their scalar integrability. -/
theorem jointKernelIntegral_eq_frequencyKernelIntegral_of_integrable
    (f₀ f₁ f₂ f₃ : Schwartz3) (k₀ k₁ k₂ : ℝ → ℂ)
    (hk₀ : Integrable k₀) (hk₁ : Integrable k₁) (hk₂ : Integrable k₂) :
    (∫ r : E3,
      (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
        twistedProduct f₀ f₁ f₂ f₃ (-r)) =
      ∫ ζ : Frequency9,
        ((𝓕 k₀) (frequencyDiagonal ζ 0) *
          ((𝓕 k₁) (frequencyDiagonal ζ 1) *
            (𝓕 k₂) (frequencyDiagonal ζ 2))) *
          frequencyKernel f₀ f₁ f₂ f₃ ζ := by
  apply jointKernelIntegral_eq_frequencyKernelIntegral
    f₀ f₁ f₂ f₃ k₀ k₁ k₂
  exact jointKernelFrequency_integrable
    f₀ f₁ f₂ f₃ k₀ k₁ k₂ hk₀ hk₁ hk₂

/-- Opening the three independent coordinate kernel integrals is exactly an
integral over the Euclidean kernel-vector `r : E3`. This is a pointwise
product-measure identity and therefore needs no convergence assumption. -/
theorem threeCoordinateKernelIntegral_eq_productIntegrals
    (f₁ f₂ f₃ : E3 → ℂ) (k₀ k₁ k₂ : ℝ → ℂ) (x : E3) :
    (∫ r : E3,
      (f₁ (x - r 0 • Anisotropy.coordinateDirection 0) * k₀ (r 0)) *
        ((f₂ (x - r 1 • Anisotropy.coordinateDirection 1) * k₁ (r 1)) *
          (f₃ (x - r 2 • Anisotropy.coordinateDirection 2) * k₂ (r 2)))) =
      (∫ r : ℝ, f₁ (x - r • Anisotropy.coordinateDirection 0) * k₀ r) *
        ((∫ r : ℝ, f₂ (x - r • Anisotropy.coordinateDirection 1) * k₁ r) *
          ∫ r : ℝ, f₃ (x - r • Anisotropy.coordinateDirection 2) * k₂ r) := by
  let A : ℝ → ℂ := fun r ↦
    f₁ (x - r • Anisotropy.coordinateDirection 0) * k₀ r
  let B : ℝ → ℂ := fun r ↦
    f₂ (x - r • Anisotropy.coordinateDirection 1) * k₁ r
  let C : ℝ → ℂ := fun r ↦
    f₃ (x - r • Anisotropy.coordinateDirection 2) * k₂ r
  let R : ℂ := (∫ r : ℝ, A r) *
    ((∫ r : ℝ, B r) * ∫ r : ℝ, C r)
  change (∫ r : E3,
    (f₁ (x - r 0 • Anisotropy.coordinateDirection 0) * k₀ (r 0)) *
      ((f₂ (x - r 1 • Anisotropy.coordinateDirection 1) * k₁ (r 1)) *
        (f₃ (x - r 2 • Anisotropy.coordinateDirection 2) * k₂ (r 2)))) = R
  let e : E3 ≃ᵐ ℝ × (ℝ × ℝ) := e3Coordinates
  have hmp : MeasurePreserving e (volume : Measure E3)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    simpa only [e] using e3Coordinates_measurePreserving
  calc
    (∫ r : E3,
      (f₁ (x - r 0 • Anisotropy.coordinateDirection 0) * k₀ (r 0)) *
        ((f₂ (x - r 1 • Anisotropy.coordinateDirection 1) * k₁ (r 1)) *
          (f₃ (x - r 2 • Anisotropy.coordinateDirection 2) * k₂ (r 2)))) =
        ∫ z : ℝ × (ℝ × ℝ), A z.1 * (B z.2.1 * C z.2.2)
          ∂((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
      calc
        (∫ r : E3,
          (f₁ (x - r 0 • Anisotropy.coordinateDirection 0) * k₀ (r 0)) *
            ((f₂ (x - r 1 • Anisotropy.coordinateDirection 1) * k₁ (r 1)) *
              (f₃ (x - r 2 • Anisotropy.coordinateDirection 2) * k₂ (r 2)))) =
            ∫ z : ℝ × (ℝ × ℝ),
              (f₁ (x - (e.symm z) 0 • Anisotropy.coordinateDirection 0) *
                k₀ ((e.symm z) 0)) *
                ((f₂ (x - (e.symm z) 1 • Anisotropy.coordinateDirection 1) *
                  k₁ ((e.symm z) 1)) *
                  (f₃ (x - (e.symm z) 2 • Anisotropy.coordinateDirection 2) *
                    k₂ ((e.symm z) 2)))
              ∂((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
                exact (MeasurePreserving.symm e hmp).integral_comp
                  e.symm.measurableEmbedding _ |>.symm
        _ = ∫ z : ℝ × (ℝ × ℝ), A z.1 * (B z.2.1 * C z.2.2)
              ∂((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
                apply integral_congr_ae
                filter_upwards [] with z
                have heq := e.apply_symm_apply z
                have h0 : (e.symm z) 0 = z.1 := by
                  simpa only [e, e3Coordinates_apply] using congrArg Prod.fst heq
                have h1 : (e.symm z) 1 = z.2.1 := by
                  simpa only [e, e3Coordinates_apply] using
                    congrArg (fun q : ℝ × (ℝ × ℝ) ↦ q.2.1) heq
                have h2 : (e.symm z) 2 = z.2.2 := by
                  simpa only [e, e3Coordinates_apply] using
                    congrArg (fun q : ℝ × (ℝ × ℝ) ↦ q.2.2) heq
                rw [h0, h1, h2]
    _ = R := by
      rw [integral_prod_mul (μ := volume)
        (ν := (volume : Measure ℝ).prod volume) A
        (fun q : ℝ × ℝ ↦ B q.1 * C q.2)]
      rw [integral_prod_mul (μ := volume) (ν := volume) B C]

/-- Subject only to the displayed joint-integrability hypothesis, the literal
three-coordinate spatial convolution integral is the joint kernel integral
against `twistedProduct`. This is the spatial half of the model/Fourier
bridge; the previous theorem supplies the product-measure opening of the
three coordinate convolutions. -/
theorem threeCoordinateSpatialIntegral_eq_jointKernelIntegral
    (f₀ f₁ f₂ f₃ : Schwartz3) (k₀ k₁ k₂ : ℝ → ℂ)
    (hJ : Integrable (Function.uncurry (fun x : E3 ↦ fun r : E3 ↦
      f₀ x *
        ((f₁ (x - r 0 • Anisotropy.coordinateDirection 0) * k₀ (r 0)) *
          ((f₂ (x - r 1 • Anisotropy.coordinateDirection 1) * k₁ (r 1)) *
            (f₃ (x - r 2 • Anisotropy.coordinateDirection 2) * k₂ (r 2))))))) :
    (∫ x : E3, f₀ x *
      ((∫ r : ℝ, f₁ (x - r • Anisotropy.coordinateDirection 0) * k₀ r) *
        ((∫ r : ℝ, f₂ (x - r • Anisotropy.coordinateDirection 1) * k₁ r) *
          ∫ r : ℝ, f₃ (x - r • Anisotropy.coordinateDirection 2) * k₂ r))) =
      ∫ r : E3,
        (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
          twistedProduct f₀ f₁ f₂ f₃ (-r) := by
  let Q : E3 → E3 → ℂ := fun x r ↦
    f₀ x *
      ((f₁ (x - r 0 • Anisotropy.coordinateDirection 0) * k₀ (r 0)) *
        ((f₂ (x - r 1 • Anisotropy.coordinateDirection 1) * k₁ (r 1)) *
          (f₃ (x - r 2 • Anisotropy.coordinateDirection 2) * k₂ (r 2))))
  have hQ : Integrable (Function.uncurry Q) := by
    simpa only [Q] using hJ
  calc
    (∫ x : E3, f₀ x *
      ((∫ r : ℝ, f₁ (x - r • Anisotropy.coordinateDirection 0) * k₀ r) *
        ((∫ r : ℝ, f₂ (x - r • Anisotropy.coordinateDirection 1) * k₁ r) *
          ∫ r : ℝ, f₃ (x - r • Anisotropy.coordinateDirection 2) * k₂ r))) =
        ∫ x : E3, ∫ r : E3, Q x r := by
      apply integral_congr_ae
      filter_upwards [] with x
      rw [← threeCoordinateKernelIntegral_eq_productIntegrals
        (f₁ : E3 → ℂ) (f₂ : E3 → ℂ) (f₃ : E3 → ℂ) k₀ k₁ k₂ x]
      rw [← integral_const_mul]
    _ = ∫ r : E3, ∫ x : E3, Q x r :=
      integral_integral_swap hQ
    _ = ∫ r : E3,
        (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
          twistedProduct f₀ f₁ f₂ f₃ (-r) := by
      apply integral_congr_ae
      filter_upwards [] with r
      rw [twistedProduct_apply, ← integral_const_mul]
      apply integral_congr_ae
      filter_upwards [] with x
      dsimp only [Q]
      simp only [PiLp.neg_apply, neg_smul, sub_eq_add_neg]
      ring

/-- The spatial joint integrand is integrable for Schwartz inputs and three
integrable scalar kernels. The proof uses one integrable Schwartz factor,
the integrable kernel triple, and uniform bounds for the other three
Schwartz factors. -/
theorem threeCoordinateSpatialJoint_integrable
    (f₀ f₁ f₂ f₃ : Schwartz3) (k₀ k₁ k₂ : ℝ → ℂ)
    (hk₀ : Integrable k₀) (hk₁ : Integrable k₁) (hk₂ : Integrable k₂) :
    Integrable (Function.uncurry (fun x : E3 ↦ fun r : E3 ↦
      f₀ x *
        ((f₁ (x - r 0 • Anisotropy.coordinateDirection 0) * k₀ (r 0)) *
          ((f₂ (x - r 1 • Anisotropy.coordinateDirection 1) * k₁ (r 1)) *
            (f₃ (x - r 2 • Anisotropy.coordinateDirection 2) * k₂ (r 2)))))) := by
  rcases schwartz_continuous_bounded f₁ with ⟨hcont₁, C₁, hC₁, hbound₁⟩
  rcases schwartz_continuous_bounded f₂ with ⟨hcont₂, C₂, hC₂, hbound₂⟩
  rcases schwartz_continuous_bounded f₃ with ⟨hcont₃, C₃, hC₃, hbound₃⟩
  let K : E3 → ℂ := fun r ↦ (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2)
  let P : E3 × E3 → ℂ := fun p ↦
    f₁ (p.1 - p.2 0 • Anisotropy.coordinateDirection 0) *
      (f₂ (p.1 - p.2 1 • Anisotropy.coordinateDirection 1) *
        f₃ (p.1 - p.2 2 • Anisotropy.coordinateDirection 2))
  have hK : Integrable K := by
    simpa only [K] using threeKernel_integrable k₀ k₁ k₂ hk₀ hk₁ hk₂
  have hbase : Integrable (fun p : E3 × E3 ↦ f₀ p.1 * K p.2) := by
    simpa only [Measure.volume_eq_prod] using f₀.integrable.mul_prod hK
  have hPcont : Continuous P := by
    dsimp only [P]
    fun_prop
  have hPbound : ∀ p : E3 × E3, ‖P p‖ ≤ C₁ * (C₂ * C₃) := by
    intro p
    dsimp only [P]
    rw [norm_mul, norm_mul]
    gcongr
    · exact hbound₁ _
    · exact hbound₂ _
    · exact hbound₃ _
  have hmul := hbase.mul_bdd hPcont.aestronglyMeasurable
    (Filter.Eventually.of_forall hPbound)
  apply hmul.congr
  filter_upwards [] with p
  change (f₀ p.1 * K p.2) * P p =
    Function.uncurry (fun x : E3 ↦ fun r : E3 ↦
      f₀ x *
        ((f₁ (x - r 0 • Anisotropy.coordinateDirection 0) * k₀ (r 0)) *
          ((f₂ (x - r 1 • Anisotropy.coordinateDirection 1) * k₁ (r 1)) *
            (f₃ (x - r 2 • Anisotropy.coordinateDirection 2) * k₂ (r 2))))) p
  dsimp only [K, P, Function.uncurry]
  ring

/-- Fully justified spatial-to-frequency bridge for three coordinate
convolutions with integrable scalar kernels. The left side is the literal
fixed-scale spatial model pattern; the right side is precisely the source
`E9` frequency kernel with the three scalar Fourier multipliers inserted. -/
theorem threeCoordinateSpatialIntegral_eq_frequencyKernelIntegral
    (f₀ f₁ f₂ f₃ : Schwartz3) (k₀ k₁ k₂ : ℝ → ℂ)
    (hk₀ : Integrable k₀) (hk₁ : Integrable k₁) (hk₂ : Integrable k₂) :
    (∫ x : E3, f₀ x *
      ((∫ r : ℝ, f₁ (x - r • Anisotropy.coordinateDirection 0) * k₀ r) *
        ((∫ r : ℝ, f₂ (x - r • Anisotropy.coordinateDirection 1) * k₁ r) *
          ∫ r : ℝ, f₃ (x - r • Anisotropy.coordinateDirection 2) * k₂ r))) =
      ∫ ζ : Frequency9,
        ((𝓕 k₀) (frequencyDiagonal ζ 0) *
          ((𝓕 k₁) (frequencyDiagonal ζ 1) *
            (𝓕 k₂) (frequencyDiagonal ζ 2))) *
          frequencyKernel f₀ f₁ f₂ f₃ ζ := by
  let R : ℂ := ∫ ζ : Frequency9,
    ((𝓕 k₀) (frequencyDiagonal ζ 0) *
      ((𝓕 k₁) (frequencyDiagonal ζ 1) *
        (𝓕 k₂) (frequencyDiagonal ζ 2))) *
      frequencyKernel f₀ f₁ f₂ f₃ ζ
  change (∫ x : E3, f₀ x *
    ((∫ r : ℝ, f₁ (x - r • Anisotropy.coordinateDirection 0) * k₀ r) *
      ((∫ r : ℝ, f₂ (x - r • Anisotropy.coordinateDirection 1) * k₁ r) *
        ∫ r : ℝ, f₃ (x - r • Anisotropy.coordinateDirection 2) * k₂ r))) = R
  calc
    (∫ x : E3, f₀ x *
      ((∫ r : ℝ, f₁ (x - r • Anisotropy.coordinateDirection 0) * k₀ r) *
        ((∫ r : ℝ, f₂ (x - r • Anisotropy.coordinateDirection 1) * k₁ r) *
          ∫ r : ℝ, f₃ (x - r • Anisotropy.coordinateDirection 2) * k₂ r))) =
        ∫ r : E3,
          (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
            twistedProduct f₀ f₁ f₂ f₃ (-r) :=
      threeCoordinateSpatialIntegral_eq_jointKernelIntegral
        f₀ f₁ f₂ f₃ k₀ k₁ k₂
        (threeCoordinateSpatialJoint_integrable
          f₀ f₁ f₂ f₃ k₀ k₁ k₂ hk₀ hk₁ hk₂)
    _ = R := by
      change (∫ r : E3,
        (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
          twistedProduct f₀ f₁ f₂ f₃ (-r)) =
        ∫ ζ : Frequency9,
          ((𝓕 k₀) (frequencyDiagonal ζ 0) *
            ((𝓕 k₁) (frequencyDiagonal ζ 1) *
              (𝓕 k₂) (frequencyDiagonal ζ 2))) *
            frequencyKernel f₀ f₁ f₂ f₃ ζ
      exact jointKernelIntegral_eq_frequencyKernelIntegral_of_integrable
        f₀ f₁ f₂ f₃ k₀ k₁ k₂ hk₀ hk₁ hk₂

/-- The complexified positive-scale low model kernel, in the literal spatial
convolution convention. -/
noncomputable def complexDilatedModelLowKernel (u s : ℝ) : ℝ → ℂ :=
  fun r ↦ ((kernelDilate (ModelLowKernel u) s r : ℝ) : ℂ)

/-- The complexified positive-scale third model kernel, in the literal
spatial convolution convention. -/
noncomputable def complexDilatedModelThirdKernel (u s : ℝ) : ℝ → ℂ :=
  fun r ↦ ((kernelDilate (ModelThirdKernel u) s r : ℝ) : ℂ)

theorem integrable_complexDilatedModelLowKernel
    (u s : ℝ) (hs : 0 < s) :
    Integrable (complexDilatedModelLowKernel u s) := by
  change Integrable (fun r : ℝ ↦
    ((kernelDilate (ModelLowKernel u) s r : ℝ) : ℂ))
  exact (integrable_ModelLowKernel_dilate u s hs).ofReal

theorem integrable_complexDilatedModelThirdKernel
    (u s : ℝ) (hs : 0 < s) :
    Integrable (complexDilatedModelThirdKernel u s) := by
  change Integrable (fun r : ℝ ↦
    ((kernelDilate (ModelThirdKernel u) s r : ℝ) : ℂ))
  exact (integrable_ModelThirdKernel_dilate u s hs).ofReal

/-- At a fixed positive scale, the literal complex source spatial profile is
exactly the `E9` frequency integral carrying the three actual scalar Fourier
kernel multipliers. This is the spatial/Fubini interface needed before the
mode multiplier identities substitute their explicit cone symbols. -/
theorem LiteralModelSpatialProfile_eq_frequencyKernelIntegral
    (α : Anisotropy) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (ht : 0 < t) :
    LiteralModelSpatialProfile α u F t =
      ∫ ζ : Frequency9,
        ((𝓕 (complexDilatedModelLowKernel (u 0)
          (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
          ((𝓕 (complexDilatedModelLowKernel (u 1)
            (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
            (𝓕 (complexDilatedModelThirdKernel (u 2)
              (t ^ α.weight 2))) (frequencyDiagonal ζ 2))) *
          frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ := by
  have hs₀ : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs₁ : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs₂ : 0 < t ^ α.weight 2 := pow_pos ht _
  have hk₀ : Integrable
      (complexDilatedModelLowKernel (u 0) (t ^ α.weight 0)) :=
    integrable_complexDilatedModelLowKernel (u 0) (t ^ α.weight 0) hs₀
  have hk₁ : Integrable
      (complexDilatedModelLowKernel (u 1) (t ^ α.weight 1)) :=
    integrable_complexDilatedModelLowKernel (u 1) (t ^ α.weight 1) hs₁
  have hk₂ : Integrable
      (complexDilatedModelThirdKernel (u 2) (t ^ α.weight 2)) :=
    integrable_complexDilatedModelThirdKernel (u 2) (t ^ α.weight 2) hs₂
  calc
    LiteralModelSpatialProfile α u F t =
        ∫ x : E3, F 0 x *
          ((∫ r : ℝ, F 1 (x - r • Anisotropy.coordinateDirection 0) *
              complexDilatedModelLowKernel (u 0) (t ^ α.weight 0) r) *
            ((∫ r : ℝ, F 2 (x - r • Anisotropy.coordinateDirection 1) *
                complexDilatedModelLowKernel (u 1) (t ^ α.weight 1) r) *
              ∫ r : ℝ, F 3 (x - r • Anisotropy.coordinateDirection 2) *
                complexDilatedModelThirdKernel (u 2)
                  (t ^ α.weight 2) r)) := by
          unfold LiteralModelSpatialProfile
            LiteralComplexInternal.scratch_LiteralModelSpatialProfile
            LiteralComplexInternal.scratch_LiteralModelSpatialIntegrand
            LiteralComplexInternal.scratch_LiteralModelCoordinateConvolution
            complexDilatedModelLowKernel
            complexDilatedModelThirdKernel
          apply integral_congr_ae
          filter_upwards [] with x
          ring
    _ = ∫ ζ : Frequency9,
        ((𝓕 (complexDilatedModelLowKernel (u 0)
          (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
          ((𝓕 (complexDilatedModelLowKernel (u 1)
            (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
            (𝓕 (complexDilatedModelThirdKernel (u 2)
              (t ^ α.weight 2))) (frequencyDiagonal ζ 2))) *
          frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ :=
      threeCoordinateSpatialIntegral_eq_frequencyKernelIntegral
        (F 0) (F 1) (F 2) (F 3)
        (complexDilatedModelLowKernel (u 0) (t ^ α.weight 0))
        (complexDilatedModelLowKernel (u 1) (t ^ α.weight 1))
        (complexDilatedModelThirdKernel (u 2) (t ^ α.weight 2))
        hk₀ hk₁ hk₂

/-- The fixed-scale Fourier multiplier whose value at `-η` is the product of
the three literal spatial kernel multipliers at `η`. -/
noncomputable def literalModelScaleKernelSymbol
    (α : Anisotropy) (u : E3) (t : ℝ) : E3 → ℂ := fun ξ ↦
  (𝓕 (complexDilatedModelLowKernel (u 0)
    (t ^ α.weight 0))) (-(ξ 0)) *
    ((𝓕 (complexDilatedModelLowKernel (u 1)
      (t ^ α.weight 1))) (-(ξ 1)) *
      (𝓕 (complexDilatedModelThirdKernel (u 2)
        (t ^ α.weight 2))) (-(ξ 2)))

/-- Evaluation of the fixed-scale kernel symbol at the source diagonal
variable exposes the three Fourier multipliers in the spatial bridge. -/
theorem literalModelScaleKernelSymbol_neg_frequencyDiagonal
    (α : Anisotropy) (u : E3) (t : ℝ) (ζ : Frequency9) :
    literalModelScaleKernelSymbol α u t (-frequencyDiagonal ζ) =
      (𝓕 (complexDilatedModelLowKernel (u 0)
        (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
        ((𝓕 (complexDilatedModelLowKernel (u 1)
          (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
          (𝓕 (complexDilatedModelThirdKernel (u 2)
            (t ^ α.weight 2))) (frequencyDiagonal ζ 2)) := by
  unfold literalModelScaleKernelSymbol
  simp only [PiLp.neg_apply, neg_neg]

/-- Fixed-scale literal spatial profile as the project's existing
`frequencyForm`. This eliminates the remaining notational gap between the
literal convolution formula and the source's `E9` multiplier representation. -/
theorem LiteralModelSpatialProfile_eq_frequencyForm
    (α : Anisotropy) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (ht : 0 < t) :
    LiteralModelSpatialProfile α u F t =
      frequencyForm (literalModelScaleKernelSymbol α u t)
        (F 0) (F 1) (F 2) (F 3) := by
  let R : ℂ := frequencyForm (literalModelScaleKernelSymbol α u t)
    (F 0) (F 1) (F 2) (F 3)
  change LiteralModelSpatialProfile α u F t = R
  calc
    LiteralModelSpatialProfile α u F t =
        ∫ ζ : Frequency9,
          ((𝓕 (complexDilatedModelLowKernel (u 0)
            (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
            ((𝓕 (complexDilatedModelLowKernel (u 1)
              (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
              (𝓕 (complexDilatedModelThirdKernel (u 2)
                (t ^ α.weight 2))) (frequencyDiagonal ζ 2))) *
            frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ :=
      LiteralModelSpatialProfile_eq_frequencyKernelIntegral α u F t ht
    _ = R := by
      change (∫ ζ : Frequency9,
        ((𝓕 (complexDilatedModelLowKernel (u 0)
          (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
          ((𝓕 (complexDilatedModelLowKernel (u 1)
            (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
            (𝓕 (complexDilatedModelThirdKernel (u 2)
              (t ^ α.weight 2))) (frequencyDiagonal ζ 2))) *
          frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ) =
          frequencyForm (literalModelScaleKernelSymbol α u t)
            (F 0) (F 1) (F 2) (F 3)
      unfold frequencyForm
      rw [frequencyMeasure_eq_volume]
      apply integral_congr_ae
      filter_upwards [] with ζ
      rw [literalModelScaleKernelSymbol_neg_frequencyDiagonal]

/-- Conditional `multiplierForm` version of the fixed-scale literal spatial
identity. The only external premise is the standard anisotropic-multiplier
certificate for the compact fixed-scale kernel symbol. -/
theorem LiteralModelSpatialProfile_eq_multiplierForm
    (α : Anisotropy) (M : ℝ) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (ht : 0 < t)
    (hm : Anisotropy.IsAnisotropicMultiplier α M
      (literalModelScaleKernelSymbol α u t)) :
    LiteralModelSpatialProfile α u F t =
      multiplierForm (literalModelScaleKernelSymbol α u t)
        (F 0) (F 1) (F 2) (F 3) := by
  calc
    LiteralModelSpatialProfile α u F t =
        frequencyForm (literalModelScaleKernelSymbol α u t)
          (F 0) (F 1) (F 2) (F 3) :=
      LiteralModelSpatialProfile_eq_frequencyForm α u F t ht
    _ = multiplierForm (literalModelScaleKernelSymbol α u t)
          (F 0) (F 1) (F 2) (F 3) :=
      (multiplierForm_eq_frequencyForm α M
        (literalModelScaleKernelSymbol α u t) hm
        (F 0) (F 1) (F 2) (F 3)).symm

/-- The complexified scaled kernel in an arbitrary active-coordinate model. -/
noncomputable def complexDilatedActiveModelKernel
    (i j : Fin 3) (u : E3) (s : ℝ) : ℝ → ℂ :=
  fun r ↦ ((kernelDilate (activeModelKernel i j u) s r : ℝ) : ℂ)

theorem integrable_complexDilatedActiveModelKernel
    (i j : Fin 3) (u : E3) (s : ℝ) (hs : 0 < s) :
    Integrable (complexDilatedActiveModelKernel i j u s) := by
  change Integrable (fun r : ℝ ↦
    ((kernelDilate (activeModelKernel i j u) s r : ℝ) : ℂ))
  exact (integrable_kernelDilate (integrable_activeModelKernel i j u) hs.ne').ofReal

/-- Fixed-scale spatial/Fourier bridge for the literal complex model with an
arbitrary active annular coordinate. -/
theorem LiteralActiveModelSpatialProfile_eq_frequencyKernelIntegral
    (α : Anisotropy) (i : Fin 3) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (ht : 0 < t) :
    LiteralActiveModelSpatialProfile α i u F t =
      ∫ ζ : Frequency9,
        ((𝓕 (complexDilatedActiveModelKernel i 0 u
          (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
          ((𝓕 (complexDilatedActiveModelKernel i 1 u
            (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
            (𝓕 (complexDilatedActiveModelKernel i 2 u
              (t ^ α.weight 2))) (frequencyDiagonal ζ 2))) *
          frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ := by
  have hs₀ : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs₁ : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs₂ : 0 < t ^ α.weight 2 := pow_pos ht _
  have hk₀ : Integrable
      (complexDilatedActiveModelKernel i 0 u (t ^ α.weight 0)) :=
    integrable_complexDilatedActiveModelKernel i 0 u
      (t ^ α.weight 0) hs₀
  have hk₁ : Integrable
      (complexDilatedActiveModelKernel i 1 u (t ^ α.weight 1)) :=
    integrable_complexDilatedActiveModelKernel i 1 u
      (t ^ α.weight 1) hs₁
  have hk₂ : Integrable
      (complexDilatedActiveModelKernel i 2 u (t ^ α.weight 2)) :=
    integrable_complexDilatedActiveModelKernel i 2 u
      (t ^ α.weight 2) hs₂
  calc
    LiteralActiveModelSpatialProfile α i u F t =
        ∫ x : E3, F 0 x *
          ((∫ r : ℝ, F 1 (x - r • Anisotropy.coordinateDirection 0) *
              complexDilatedActiveModelKernel i 0 u
                (t ^ α.weight 0) r) *
            ((∫ r : ℝ, F 2 (x - r • Anisotropy.coordinateDirection 1) *
                complexDilatedActiveModelKernel i 1 u
                  (t ^ α.weight 1) r) *
              ∫ r : ℝ, F 3 (x - r • Anisotropy.coordinateDirection 2) *
                complexDilatedActiveModelKernel i 2 u
                  (t ^ α.weight 2) r)) := by
          unfold LiteralActiveModelSpatialProfile
            LiteralComplexActiveInternal.scratch_LiteralActiveModelSpatialProfile
            LiteralComplexActiveInternal.scratch_LiteralActiveModelSpatialIntegrand
            LiteralModelCoordinateConvolution
            LiteralComplexInternal.scratch_LiteralModelCoordinateConvolution
            complexDilatedActiveModelKernel
          simp only [Fin.prod_univ_succ]
          apply integral_congr_ae
          filter_upwards [] with x
          simp
    _ = ∫ ζ : Frequency9,
        ((𝓕 (complexDilatedActiveModelKernel i 0 u
          (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
          ((𝓕 (complexDilatedActiveModelKernel i 1 u
            (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
            (𝓕 (complexDilatedActiveModelKernel i 2 u
              (t ^ α.weight 2))) (frequencyDiagonal ζ 2))) *
          frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ :=
      threeCoordinateSpatialIntegral_eq_frequencyKernelIntegral
        (F 0) (F 1) (F 2) (F 3)
        (complexDilatedActiveModelKernel i 0 u (t ^ α.weight 0))
        (complexDilatedActiveModelKernel i 1 u (t ^ α.weight 1))
        (complexDilatedActiveModelKernel i 2 u (t ^ α.weight 2))
        hk₀ hk₁ hk₂

/-- Fixed-scale kernel multiplier for the literal model with active coordinate
`i`, expressed so that evaluation at `-η` returns the three spatial Fourier
kernel factors at `η`. -/
noncomputable def literalActiveModelScaleKernelSymbol
    (α : Anisotropy) (i : Fin 3) (u : E3) (t : ℝ) : E3 → ℂ := fun ξ ↦
  (𝓕 (complexDilatedActiveModelKernel i 0 u
    (t ^ α.weight 0))) (-(ξ 0)) *
    ((𝓕 (complexDilatedActiveModelKernel i 1 u
      (t ^ α.weight 1))) (-(ξ 1)) *
      (𝓕 (complexDilatedActiveModelKernel i 2 u
        (t ^ α.weight 2))) (-(ξ 2)))

theorem literalActiveModelScaleKernelSymbol_neg_frequencyDiagonal
    (α : Anisotropy) (i : Fin 3) (u : E3) (t : ℝ) (ζ : Frequency9) :
    literalActiveModelScaleKernelSymbol α i u t (-frequencyDiagonal ζ) =
      (𝓕 (complexDilatedActiveModelKernel i 0 u
        (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
        ((𝓕 (complexDilatedActiveModelKernel i 1 u
          (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
          (𝓕 (complexDilatedActiveModelKernel i 2 u
            (t ^ α.weight 2))) (frequencyDiagonal ζ 2)) := by
  unfold literalActiveModelScaleKernelSymbol
  simp only [PiLp.neg_apply, neg_neg]

/-- The arbitrary-active literal spatial profile is exactly the existing
`frequencyForm` of its fixed-scale kernel multiplier. -/
theorem LiteralActiveModelSpatialProfile_eq_frequencyForm
    (α : Anisotropy) (i : Fin 3) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (ht : 0 < t) :
    LiteralActiveModelSpatialProfile α i u F t =
      frequencyForm (literalActiveModelScaleKernelSymbol α i u t)
        (F 0) (F 1) (F 2) (F 3) := by
  let R : ℂ := frequencyForm (literalActiveModelScaleKernelSymbol α i u t)
    (F 0) (F 1) (F 2) (F 3)
  change LiteralActiveModelSpatialProfile α i u F t = R
  calc
    LiteralActiveModelSpatialProfile α i u F t =
        ∫ ζ : Frequency9,
          ((𝓕 (complexDilatedActiveModelKernel i 0 u
            (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
            ((𝓕 (complexDilatedActiveModelKernel i 1 u
              (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
              (𝓕 (complexDilatedActiveModelKernel i 2 u
                (t ^ α.weight 2))) (frequencyDiagonal ζ 2))) *
            frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ :=
      LiteralActiveModelSpatialProfile_eq_frequencyKernelIntegral
        α i u F t ht
    _ = R := by
      change (∫ ζ : Frequency9,
        ((𝓕 (complexDilatedActiveModelKernel i 0 u
          (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
          ((𝓕 (complexDilatedActiveModelKernel i 1 u
            (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
            (𝓕 (complexDilatedActiveModelKernel i 2 u
              (t ^ α.weight 2))) (frequencyDiagonal ζ 2))) *
          frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ) =
          frequencyForm (literalActiveModelScaleKernelSymbol α i u t)
            (F 0) (F 1) (F 2) (F 3)
      unfold frequencyForm
      rw [frequencyMeasure_eq_volume]
      apply integral_congr_ae
      filter_upwards [] with ζ
      rw [literalActiveModelScaleKernelSymbol_neg_frequencyDiagonal]

/-- Conditional multiplier-form version of the arbitrary-active fixed-scale
literal spatial identity. -/
theorem LiteralActiveModelSpatialProfile_eq_multiplierForm
    (α : Anisotropy) (M : ℝ) (i : Fin 3) (u : E3)
    (F : ModelComplexSchwartzInput) (t : ℝ) (ht : 0 < t)
    (hm : Anisotropy.IsAnisotropicMultiplier α M
      (literalActiveModelScaleKernelSymbol α i u t)) :
    LiteralActiveModelSpatialProfile α i u F t =
      multiplierForm (literalActiveModelScaleKernelSymbol α i u t)
        (F 0) (F 1) (F 2) (F 3) := by
  calc
    LiteralActiveModelSpatialProfile α i u F t =
        frequencyForm (literalActiveModelScaleKernelSymbol α i u t)
          (F 0) (F 1) (F 2) (F 3) :=
      LiteralActiveModelSpatialProfile_eq_frequencyForm α i u F t ht
    _ = multiplierForm (literalActiveModelScaleKernelSymbol α i u t)
          (F 0) (F 1) (F 2) (F 3) :=
      (multiplierForm_eq_frequencyForm α M
        (literalActiveModelScaleKernelSymbol α i u t) hm
        (F 0) (F 1) (F 2) (F 3)).symm

/-- At active coordinate three, the public literal active spatial profile is
the base literal spatial profile. -/
theorem LiteralActiveModelSpatialProfile_two
    (α : Anisotropy) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) :
    LiteralActiveModelSpatialProfile α 2 u F t =
      LiteralModelSpatialProfile α u F t := by
  unfold LiteralActiveModelSpatialProfile
    LiteralComplexActiveInternal.scratch_LiteralActiveModelSpatialProfile
    LiteralModelSpatialProfile
    LiteralComplexInternal.scratch_LiteralModelSpatialProfile
  apply integral_congr_ae
  filter_upwards [] with x
  exact LiteralActiveModelSpatialIntegrand_two α u F t x

/-- The public active-coordinate spatial profile obeys the existing
coordinate-permutation transport. -/
theorem LiteralActiveModelSpatialProfile_permute_to_two
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (F : ModelComplexSchwartzInput) (hσ : σ 2 = i)
    (t : ℝ) :
    LiteralActiveModelSpatialProfile α i u F t =
      LiteralActiveModelSpatialProfile (permutedAnisotropy α σ) 2
        (coordinatePermutation σ u) (complexPermutedModelInput σ F) t := by
  simpa only [LiteralActiveModelSpatialProfile, complexPermutedModelInput] using
    LiteralComplexActiveInternal.scratch_LiteralActiveModelSpatialProfile_permute_to_two
      α σ i u F hσ t

/-- Negating a multiplier negates its four-linear frequency form. -/
theorem frequencyForm_neg
    (m : E3 → ℂ) (f₀ f₁ f₂ f₃ : SchwartzMap E3 ℂ) :
    frequencyForm (fun ξ ↦ -m ξ) f₀ f₁ f₂ f₃ =
      -frequencyForm m f₀ f₁ f₂ f₃ := by
  unfold frequencyForm
  rw [← integral_neg]
  apply integral_congr_ae
  filter_upwards [] with ζ
  ring

/-- For the source translation `ν / 8`, the literal spatial kernel symbol
is the negative of the positive localized third-coordinate Fourier-mode
symbol. The one physical minus sign comes from the third kernel. -/
theorem literalModelScaleKernelSymbol_standardMode_eq_neg_thirdModeFrequencySymbol
    (α : Anisotropy) (ν : standardModeLattice) (t : ℝ) (ht : 0 < t) :
    literalModelScaleKernelSymbol α (standardModeTranslate ν) t =
      fun ξ ↦ -thirdModeFrequencySymbol α ν t ξ := by
  funext ξ
  unfold literalModelScaleKernelSymbol thirdModeFrequencySymbol
    complexDilatedModelLowKernel complexDilatedModelThirdKernel
  have h₀ := fourier_kernelDilate_ModelLowKernel_standardMode_neg
    ν 0 (t ^ α.weight 0) (ξ 0) (pow_pos ht _)
  have h₁ := fourier_kernelDilate_ModelLowKernel_standardMode_neg
    ν 1 (t ^ α.weight 1) (ξ 1) (pow_pos ht _)
  have h₂ := fourier_kernelDilate_ModelThirdKernel_standardMode_neg
    ν 2 (t ^ α.weight 2) (ξ 2) (pow_pos ht _)
  rw [h₀, h₁, h₂]
  rw [← fourierChar_three]
  ring

/-- The positive source Fourier-mode form equals the negative of the literal
third-active spatial profile. -/
theorem thirdModeFrequencyForm_eq_neg_LiteralActiveModelSpatialProfile
    (α : Anisotropy) (ν : standardModeLattice) (t : ℝ) (ht : 0 < t)
    (F : ModelComplexSchwartzInput) :
    thirdModeFrequencyForm α ν t F =
      -LiteralActiveModelSpatialProfile α 2 (standardModeTranslate ν) F t := by
  calc
    thirdModeFrequencyForm α ν t F =
        frequencyForm (thirdModeFrequencySymbol α ν t)
          (F 0) (F 1) (F 2) (F 3) := rfl
    _ = -frequencyForm
        (fun ξ ↦ -thirdModeFrequencySymbol α ν t ξ)
        (F 0) (F 1) (F 2) (F 3) := by
      rw [frequencyForm_neg]
      ring
    _ = -frequencyForm
        (literalModelScaleKernelSymbol α (standardModeTranslate ν) t)
        (F 0) (F 1) (F 2) (F 3) := by
      rw [literalModelScaleKernelSymbol_standardMode_eq_neg_thirdModeFrequencySymbol
        α ν t ht]
    _ = -LiteralModelSpatialProfile α (standardModeTranslate ν) F t := by
      rw [← LiteralModelSpatialProfile_eq_frequencyForm α
        (standardModeTranslate ν) F t ht]
    _ = -LiteralActiveModelSpatialProfile α 2 (standardModeTranslate ν) F t := by
      rw [LiteralActiveModelSpatialProfile_two]

/-- The one-mode spatial/Fourier sign bridge in any active coordinate, after
the standard source permutation has moved that coordinate to the third slot. -/
theorem thirdModeFrequencyForm_eq_neg_LiteralActiveModelSpatialProfile_permuted
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (hσ : σ 2 = i) (ν : standardModeLattice) (t : ℝ) (ht : 0 < t)
    (F : ModelComplexSchwartzInput) :
    thirdModeFrequencyForm (permutedAnisotropy α σ) ν t
      (complexPermutedModelInput σ F) =
      -LiteralActiveModelSpatialProfile α i
        ((coordinatePermutation σ).symm (standardModeTranslate ν)) F t := by
  calc
    thirdModeFrequencyForm (permutedAnisotropy α σ) ν t
        (complexPermutedModelInput σ F) =
        -LiteralActiveModelSpatialProfile (permutedAnisotropy α σ) 2
          (standardModeTranslate ν) (complexPermutedModelInput σ F) t :=
      thirdModeFrequencyForm_eq_neg_LiteralActiveModelSpatialProfile
        (permutedAnisotropy α σ) ν t ht (complexPermutedModelInput σ F)
    _ = -LiteralActiveModelSpatialProfile α i
        ((coordinatePermutation σ).symm (standardModeTranslate ν)) F t := by
      rw [LiteralActiveModelSpatialProfile_permute_to_two α σ i
        ((coordinatePermutation σ).symm (standardModeTranslate ν)) F hσ]
      simp

/-- One localized positive Fourier mode with coefficient `a` is exactly the
literal third-active spatial mode with coefficient `-a`. This is the sign
absorption in the coefficient `c_{i,ν}` of the source proof. -/
theorem thirdModeFrequencyMode_eq_LiteralActiveSpatialMode
    (α : Anisotropy) (ν : standardModeLattice) (t : ℝ) (ht : 0 < t)
    (a : ℂ) (F : ModelComplexSchwartzInput) :
    a * thirdModeFrequencyForm α ν t F =
      (-a) * LiteralActiveModelSpatialProfile α 2 (standardModeTranslate ν) F t := by
  rw [thirdModeFrequencyForm_eq_neg_LiteralActiveModelSpatialProfile
    α ν t ht F]
  ring

/-- The scale-integrated positive Fourier mode before passing through the
anisotropic-multiplier API. -/
noncomputable def thirdModeFrequencyFullForm
    (α : Anisotropy) (ν : standardModeLattice) (a : ℝ → ℂ)
    (F : ModelComplexSchwartzInput) : ℂ :=
  ∫ t in Set.Ioi (0 : ℝ), a t * thirdModeFrequencyForm α ν t F
    ∂((volume : Measure ℝ).withDensity cubeScaleDensity)

/-- A complete localized positive Fourier mode is exactly a literal
third-active model form with the negated coefficient. Thus the source
coefficient `c_{i,ν}` is obtained from a Fourier coefficient by precisely
this sign change (and its stated positive normalization). -/
theorem thirdModeFrequencyFullForm_eq_LiteralActiveModelFullForm
    (α : Anisotropy) (ν : standardModeLattice) (a : ℝ → ℂ)
    (F : ModelComplexSchwartzInput) :
    thirdModeFrequencyFullForm α ν a F =
      LiteralActiveModelFullForm α 2 (standardModeTranslate ν) (-a) F := by
  unfold thirdModeFrequencyFullForm LiteralActiveModelFullForm
    LiteralComplexActiveInternal.scratch_LiteralActiveModelFullForm
  apply setIntegral_congr_fun measurableSet_Ioi
  intro t ht
  change a t * thirdModeFrequencyForm α ν t F =
    (-a) t * LiteralActiveModelSpatialProfile α 2 (standardModeTranslate ν) F t
  simpa only [Pi.neg_apply] using
    thirdModeFrequencyMode_eq_LiteralActiveSpatialMode α ν t ht (a t) F

/-- The scale-integrated one-mode bridge in any active coordinate. The mode
is written in the permuted coordinates in which that active coordinate is
the third coordinate. -/
theorem thirdModeFrequencyFullForm_eq_LiteralActiveModelFullForm_permuted
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (hσ : σ 2 = i) (ν : standardModeLattice) (a : ℝ → ℂ)
    (F : ModelComplexSchwartzInput) :
    thirdModeFrequencyFullForm (permutedAnisotropy α σ) ν a
      (complexPermutedModelInput σ F) =
      LiteralActiveModelFullForm α i
        ((coordinatePermutation σ).symm (standardModeTranslate ν)) (-a) F := by
  calc
    thirdModeFrequencyFullForm (permutedAnisotropy α σ) ν a
        (complexPermutedModelInput σ F) =
        LiteralActiveModelFullForm (permutedAnisotropy α σ) 2
          (standardModeTranslate ν) (-a) (complexPermutedModelInput σ F) :=
      thirdModeFrequencyFullForm_eq_LiteralActiveModelFullForm
        (permutedAnisotropy α σ) ν a (complexPermutedModelInput σ F)
    _ = LiteralModelFullForm (permutedAnisotropy α σ)
        (standardModeTranslate ν) (-a) (complexPermutedModelInput σ F) :=
      LiteralActiveModelFullForm_two (permutedAnisotropy α σ)
        (standardModeTranslate ν) (-a) (complexPermutedModelInput σ F)
    _ = LiteralActiveModelFullForm α i
        ((coordinatePermutation σ).symm (standardModeTranslate ν)) (-a) F := by
      simpa using
        (LiteralActiveModelFullForm_permute_to_third α σ i
          ((coordinatePermutation σ).symm (standardModeTranslate ν)) (-a) F hσ).symm

/-- Conditional `multiplierForm` version of the one-mode spatial bridge.
The sole additional premise is the standard anisotropic multiplier certificate
for the localized mode symbol; Section 8's derivative package is intended to
supply this certificate. -/
theorem thirdModeMultiplier_eq_LiteralActiveSpatialMode
    (α : Anisotropy) (M : ℝ) (ν : standardModeLattice) (t : ℝ) (ht : 0 < t)
    (hm : Anisotropy.IsAnisotropicMultiplier α M
      (thirdModeFrequencySymbol α ν t))
    (a : ℂ) (F : ModelComplexSchwartzInput) :
    a * multiplierForm (thirdModeFrequencySymbol α ν t)
      (F 0) (F 1) (F 2) (F 3) =
      (-a) * LiteralActiveModelSpatialProfile α 2 (standardModeTranslate ν) F t := by
  rw [multiplierForm_eq_frequencyForm α M
    (thirdModeFrequencySymbol α ν t) hm (F 0) (F 1) (F 2) (F 3)]
  exact thirdModeFrequencyMode_eq_LiteralActiveSpatialMode α ν t ht a F

/-- The scale-integrated localized mode expressed via the existing
`multiplierForm` interface. -/
noncomputable def thirdModeMultiplierFullForm
    (α : Anisotropy) (ν : standardModeLattice) (a : ℝ → ℂ)
    (F : ModelComplexSchwartzInput) : ℂ :=
  ∫ t in Set.Ioi (0 : ℝ), a t *
      multiplierForm (thirdModeFrequencySymbol α ν t)
        (F 0) (F 1) (F 2) (F 3)
    ∂((volume : Measure ℝ).withDensity cubeScaleDensity)

/-- Conditional source-facing one-mode bridge through `multiplierForm`.
The only premise is a uniform localized multiplier certificate at positive
scales; no spatial/Fourier interchange remains. -/
theorem thirdModeMultiplierFullForm_eq_LiteralActiveModelFullForm
    (α : Anisotropy) (M : ℝ) (ν : standardModeLattice) (a : ℝ → ℂ)
    (F : ModelComplexSchwartzInput)
    (hm : ∀ t : ℝ, 0 < t → Anisotropy.IsAnisotropicMultiplier α M
      (thirdModeFrequencySymbol α ν t)) :
    thirdModeMultiplierFullForm α ν a F =
      LiteralActiveModelFullForm α 2 (standardModeTranslate ν) (-a) F := by
  unfold thirdModeMultiplierFullForm LiteralActiveModelFullForm
    LiteralComplexActiveInternal.scratch_LiteralActiveModelFullForm
  apply setIntegral_congr_fun measurableSet_Ioi
  intro t ht
  change a t * multiplierForm (thirdModeFrequencySymbol α ν t)
      (F 0) (F 1) (F 2) (F 3) =
    (-a) t * LiteralActiveModelSpatialProfile α 2 (standardModeTranslate ν) F t
  simpa only [Pi.neg_apply] using
    thirdModeMultiplier_eq_LiteralActiveSpatialMode α M ν t ht (hm t ht) (a t) F

/-- Conditional any-active-coordinate version of the source-facing
one-mode `multiplierForm` bridge. -/
theorem thirdModeMultiplierFullForm_eq_LiteralActiveModelFullForm_permuted
    (α : Anisotropy) (M : ℝ) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (hσ : σ 2 = i) (ν : standardModeLattice) (a : ℝ → ℂ)
    (F : ModelComplexSchwartzInput)
    (hm : ∀ t : ℝ, 0 < t → Anisotropy.IsAnisotropicMultiplier
