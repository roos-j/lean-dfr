/-- The four strictly positive barycentric weights associated to an interior
simplex point.  The displayed identities are exactly the four interpolation
vertices `b`, `b + b₀ e₁`, `b + b₀ e₂`, and `b + b₀ e₃`. -/
theorem exponentSimplex_has_barycentricWeights
    {β0 β1 β2 β3 : ℝ} (b : ExponentSimplex β0 β1 β2 β3) :
    ∃ θ0 θ1 θ2 θ3 : ℝ,
      0 < θ0 ∧ 0 < θ1 ∧ 0 < θ2 ∧ 0 < θ3 ∧
      θ0 + θ1 + θ2 + θ3 = 1 ∧
      β0 = θ0 * b.b0 ∧
      β1 = θ0 * b.b1 + θ1 * (b.b1 + b.b0) + θ2 * b.b1 + θ3 * b.b1 ∧
      β2 = θ0 * b.b2 + θ1 * b.b2 + θ2 * (b.b2 + b.b0) + θ3 * b.b2 ∧
      β3 = θ0 * b.b3 + θ1 * b.b3 + θ2 * b.b3 + θ3 * (b.b3 + b.b0) ∧
      1 - β0 = θ0 * (1 - b.b0) + θ1 + θ2 + θ3 := by
  let θ0 : ℝ := β0 / b.b0
  let θ1 : ℝ := (β1 - b.b1) / b.b0
  let θ2 : ℝ := (β2 - b.b2) / b.b0
  let θ3 : ℝ := (β3 - b.b3) / b.b0
  have hb0ne : b.b0 ≠ 0 := ne_of_gt b.b0_pos
  have hθ0 : 0 < θ0 := by
    dsimp [θ0]
    exact div_pos b.beta0_pos b.b0_pos
  have hθ1 : 0 < θ1 := by
    dsimp [θ1]
    exact div_pos (sub_pos.mpr b.b1_lt) b.b0_pos
  have hθ2 : 0 < θ2 := by
    dsimp [θ2]
    exact div_pos (sub_pos.mpr b.b2_lt) b.b0_pos
  have hθ3 : 0 < θ3 := by
    dsimp [θ3]
    exact div_pos (sub_pos.mpr b.b3_lt) b.b0_pos
  have hnum : β0 + (β1 - b.b1) + (β2 - b.b2) + (β3 - b.b3) = b.b0 := by
    linarith [b.sum_eq_one, b.beta_sum_eq_one]
  refine ⟨θ0, θ1, θ2, θ3, hθ0, hθ1, hθ2, hθ3, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · dsimp [θ0, θ1, θ2, θ3]
    field_simp
    exact hnum
  · dsimp [θ0]
    field_simp
  · dsimp [θ0, θ1, θ2, θ3]
    field_simp
    linear_combination -b.b1 * hnum
  · dsimp [θ0, θ1, θ2, θ3]
    field_simp
    linear_combination -b.b2 * hnum
  · dsimp [θ0, θ1, θ2, θ3]
    field_simp
    linear_combination -b.b3 * hnum
  · dsimp [θ0, θ1, θ2, θ3]
    field_simp
    linarith [b.sum_eq_one, b.beta_sum_eq_one]


/-- The exponent hypotheses in `thm:main` imply the reciprocal region used
by the extended model theorem in the active third coordinate. -/
theorem mainExponentRegion
    {p0 p1 p2 p3 : ℝ}
    (hp0 : 4 < p0)
    (hp1low : 1 < p1) (hp1high : p1 < 4)
    (hp2low : 1 < p2) (hp2high : p2 < 4)
    (hp3low : 1 < p3) (hp3high : p3 < 4)
    (hsum : p0⁻¹ + p1⁻¹ + p2⁻¹ + p3⁻¹ = 1) :
    ExtendedModelRegion p0⁻¹ p1⁻¹ p2⁻¹ p3⁻¹ := by
  have hp0pos : 0 < p0 := by linarith
  have hp1pos : 0 < p1 := by linarith
  have hp2pos : 0 < p2 := by linarith
  have hp3pos : 0 < p3 := by linarith
  have h0small : p0⁻¹ < 1 / 4 := by
    simpa [one_div] using
      (one_div_lt_one_div_of_lt (show (0 : ℝ) < 4 by norm_num) hp0)
  have h1large : 1 / 4 < p1⁻¹ := by
    simpa [one_div] using one_div_lt_one_div_of_lt hp1pos hp1high
  have h2large : 1 / 4 < p2⁻¹ := by
    simpa [one_div] using one_div_lt_one_div_of_lt hp2pos hp2high
  have h3large : 1 / 4 < p3⁻¹ := by
    simpa [one_div] using one_div_lt_one_div_of_lt hp3pos hp3high
  exact extendedModelRegion_of_mainInequalities
    (inv_pos.mpr hp0pos) h1large h2large h3large hsum h0small

/-- The reciprocal region used by the extended model theorem is invariant
under relabeling the three active input coordinates. -/
theorem mainExponentRegion_permuted
    {p0 : ℝ} (p : Fin 3 → ℝ)
    (hp0 : 4 < p0)
    (hplow : ∀ i, 1 < p i) (hphigh : ∀ i, p i < 4)
    (hsum : p0⁻¹ + ∑ i : Fin 3, (p i)⁻¹ = 1)
    (σ : Equiv.Perm (Fin 3)) :
    ExtendedModelRegion p0⁻¹ (p (σ 0))⁻¹ (p (σ 1))⁻¹ (p (σ 2))⁻¹ := by
  have hp0pos : 0 < p0 := by linarith
  have h0small : p0⁻¹ < 1 / 4 := by
    simpa [one_div] using
      (one_div_lt_one_div_of_lt (show (0 : ℝ) < 4 by norm_num) hp0)
  have hlarge (i : Fin 3) : 1 / 4 < (p i)⁻¹ := by
    have hpos : 0 < p i := by linarith [hplow i]
    simpa [one_div] using one_div_lt_one_div_of_lt hpos (hphigh i)
  have hsum' : p0⁻¹ + (p (σ 0))⁻¹ + (p (σ 1))⁻¹ +
      (p (σ 2))⁻¹ = 1 := by
    calc
      p0⁻¹ + (p (σ 0))⁻¹ + (p (σ 1))⁻¹ + (p (σ 2))⁻¹ =
          p0⁻¹ + ∑ i : Fin 3, (p (σ i))⁻¹ := by
            simp [Fin.sum_univ_three]
            ring
      _ = p0⁻¹ + ∑ i : Fin 3, (p i)⁻¹ := by
        congr 1
        exact Equiv.sum_comp σ (fun i ↦ (p i)⁻¹)
      _ = 1 := hsum
  exact extendedModelRegion_of_mainInequalities
    (inv_pos.mpr hp0pos) (hlarge (σ 0)) (hlarge (σ 1))
    (hlarge (σ 2)) hsum' h0small


/-- The one-dimensional Calderón mass of the source-normalized Gaussian
derivative.  This is the scalar constant behind the factor `π / α₃` in the
fiber square-function identity. -/
theorem integral_gaussianDeriv_sq_div_Ioi :
    ∫ x : ℝ in Set.Ioi (0 : ℝ), gaussianDeriv x ^ 2 / x = Real.pi := by
  let P : ℝ → ℝ := fun x ↦ -Real.pi * Real.exp (-2 * Real.pi * x ^ 2)
  have hmatch (x : ℝ) :
      gaussianDeriv x ^ 2 / x =
        4 * Real.pi ^ 2 * (x * Real.exp (-(2 * Real.pi) * x ^ 2)) := by
    by_cases hx : x = 0
    · subst x
      simp [gaussianDeriv]
    · have hexp : Real.exp (-Real.pi * x ^ 2) ^ 2 =
        Real.exp (-(2 * Real.pi) * x ^ 2) := by
        rw [← Real.exp_nat_mul]
        congr 1
        ring
      simp only [gaussianDeriv, gaussian]
      calc
        (-2 * Real.pi * x * Real.exp (-Real.pi * x ^ 2)) ^ 2 / x =
            ((-2 * Real.pi * x) ^ 2 * Real.exp (-Real.pi * x ^ 2) ^ 2) / x := by
              ring
        _ = 4 * Real.pi ^ 2 * (x * Real.exp (-(2 * Real.pi) * x ^ 2)) := by
              rw [hexp]
              field_simp [hx]
              ring
  have hderiv (x : ℝ) : HasDerivAt P (gaussianDeriv x ^ 2 / x) x := by
    have hpow : HasDerivAt (fun y : ℝ ↦ y ^ 2) (2 * x) x := by
      simpa [pow_two, two_mul] using (hasDerivAt_pow 2 x)
    have hinner : HasDerivAt (fun y : ℝ ↦ -2 * Real.pi * y ^ 2)
        (-4 * Real.pi * x) x := by
      convert! HasDerivAt.const_mul (-2 * Real.pi) hpow using 1
      all_goals ring
    have hP : HasDerivAt P
        ((-Real.pi) * (Real.exp (-2 * Real.pi * x ^ 2) *
          (-4 * Real.pi * x))) x := by
      exact (Real.hasDerivAt_exp (-2 * Real.pi * x ^ 2)).comp x hinner |>.const_mul
        (-Real.pi)
    have hcoef : (-Real.pi) * (Real.exp (-2 * Real.pi * x ^ 2) *
        (-4 * Real.pi * x)) = gaussianDeriv x ^ 2 / x := by
      rw [show -2 * Real.pi * x ^ 2 = -(2 * Real.pi) * x ^ 2 by ring]
      rw [hmatch]
      ring
    rwa [hcoef] at hP
  have hint : Integrable (fun x : ℝ ↦
      4 * Real.pi ^ 2 * (x * Real.exp (-(2 * Real.pi) * x ^ 2))) := by
    convert
      (integrable_mul_exp_neg_mul_sq (show 0 < 2 * Real.pi by positivity)).const_mul
        (4 * Real.pi ^ 2) using 1
  have hlim : Tendsto P atTop (nhds (0 : ℝ)) := by
    have he : Tendsto (fun x : ℝ ↦ Real.exp (-2 * Real.pi * x ^ 2)) atTop
        (nhds (0 : ℝ)) :=
      Real.tendsto_exp_atBot.comp
        ((tendsto_pow_atTop two_ne_zero).const_mul_atTop_of_neg
          (by nlinarith [Real.pi_pos] : -2 * Real.pi < 0))
    simpa [P, neg_mul] using
      ((tendsto_const_nhds : Tendsto (fun _ : ℝ ↦ -Real.pi) atTop
        (nhds (-Real.pi))).mul he)
  have hderivIoi : ∀ x ∈ Set.Ici (0 : ℝ),
      HasDerivAt P (gaussianDeriv x ^ 2 / x) x := fun x _ ↦ hderiv x
  have hcalc := integral_Ioi_of_hasDerivAt_of_tendsto'
    hderivIoi (hint.congr (Filter.Eventually.of_forall fun x ↦ (hmatch x).symm)).integrableOn
    hlim
  convert hcalc using 1
  all_goals simp [P]

/-- Dilation of the one-dimensional Calderón density has the same mass at
every positive frequency. -/
theorem integral_gaussianDeriv_sq_div_mul_Ioi
    (ξ : ℝ) (hξ : 0 < ξ) :
    ∫ s : ℝ in Set.Ioi (0 : ℝ), gaussianDeriv (s * ξ) ^ 2 / s = Real.pi := by
  let k : ℝ → ℝ := fun r ↦ gaussianDeriv r ^ 2 / r
  have hpoint (s : ℝ) (hs : s ∈ Set.Ioi (0 : ℝ)) :
      gaussianDeriv (s * ξ) ^ 2 / s = ξ * k (ξ * s) := by
    dsimp [k]
    rw [mul_comm s ξ]
    field_simp [hξ.ne']
  calc
    ∫ s : ℝ in Set.Ioi (0 : ℝ), gaussianDeriv (s * ξ) ^ 2 / s =
        ∫ s : ℝ in Set.Ioi (0 : ℝ), ξ * k (ξ * s) := by
          apply setIntegral_congr_fun measurableSet_Ioi
          intro s hs
          exact hpoint s hs
    _ = ξ * ∫ s : ℝ in Set.Ioi (0 : ℝ), k (ξ * s) := by
      rw [← integral_const_mul]
    _ = ξ * (ξ⁻¹ * ∫ r : ℝ in Set.Ioi (0 : ℝ), k r) := by
      rw [integral_comp_mul_left_Ioi k 0 hξ]
      simp [smul_eq_mul]
    _ = Real.pi := by
      rw [show (∫ r : ℝ in Set.Ioi (0 : ℝ), k r) = Real.pi by
        exact integral_gaussianDeriv_sq_div_Ioi]
      field_simp

/-- The power-change-of-variables form of the Calderón identity.  It is the
exact scalar formula before rewriting the Jacobian as the scale density
`dt / t`. -/
theorem integral_gaussianDeriv_sq_rpow_weighted_Ioi
    (p ξ : ℝ) (hp : 0 < p) (hξ : 0 < ξ) :
    ∫ t : ℝ in Set.Ioi (0 : ℝ),
      (p * t ^ (p - 1)) * (gaussianDeriv (t ^ p * ξ) ^ 2 / t ^ p) =
        Real.pi := by
  let g : ℝ → ℝ := fun s ↦ gaussianDeriv (s * ξ) ^ 2 / s
  calc
    ∫ t : ℝ in Set.Ioi (0 : ℝ),
        (p * t ^ (p - 1)) * (gaussianDeriv (t ^ p * ξ) ^ 2 / t ^ p) =
        ∫ t : ℝ in Set.Ioi (0 : ℝ), (p * t ^ (p - 1)) • g (t ^ p) := by
          apply setIntegral_congr_fun measurableSet_Ioi
          intro t ht
          simp [g, smul_eq_mul]
    _ = ∫ s : ℝ in Set.Ioi (0 : ℝ), g s :=
      integral_comp_rpow_Ioi_of_pos hp
    _ = Real.pi := integral_gaussianDeriv_sq_div_mul_Ioi ξ hξ

/-- In the natural-power convention used by `Anisotropy`, the preceding
identity becomes the `dt/t` Calderón mass `π / n`. -/
theorem integral_gaussianDeriv_sq_nat_scale_Ioi
    (n : ℕ) (hn : 0 < n) (ξ : ℝ) (hξ : 0 < ξ) :
    ∫ t : ℝ in Set.Ioi (0 : ℝ),
      gaussianDeriv (t ^ n * ξ) ^ 2 / t = Real.pi / (n : ℝ) := by
  let N : ℝ := n
  have hN : 0 < N := by
    simpa [N] using (Nat.cast_pos.mpr hn : (0 : ℝ) < n)
  have hweighted := integral_gaussianDeriv_sq_rpow_weighted_Ioi
    N ξ hN hξ
  have hpoint (t : ℝ) (ht : t ∈ Set.Ioi (0 : ℝ)) :
      (N * t ^ (N - 1)) * (gaussianDeriv (t ^ N * ξ) ^ 2 / t ^ N) =
        N * (gaussianDeriv (t ^ n * ξ) ^ 2 / t) := by
    have htpos : 0 < t := ht
    have hratio : t ^ (N - 1) / t ^ N = t⁻¹ := by
      calc
        t ^ (N - 1) / t ^ N = t ^ ((N - 1) - N) :=
          (Real.rpow_sub htpos _ _).symm
        _ = t ^ (-1 : ℝ) := by congr 1; ring
        _ = t⁻¹ := by rw [Real.rpow_neg htpos.le, Real.rpow_one]
    calc
      (N * t ^ (N - 1)) * (gaussianDeriv (t ^ N * ξ) ^ 2 / t ^ N) =
          (N * gaussianDeriv (t ^ N * ξ) ^ 2) * (t ^ (N - 1) / t ^ N) := by
            ring
      _ = (N * gaussianDeriv (t ^ N * ξ) ^ 2) * t⁻¹ := by rw [hratio]
      _ = N * (gaussianDeriv (t ^ N * ξ) ^ 2 / t) := by
            field_simp [htpos.ne']
      _ = N * (gaussianDeriv (t ^ n * ξ) ^ 2 / t) := by
            rw [Real.rpow_natCast]
  have hmul : N * (∫ t : ℝ in Set.Ioi (0 : ℝ),
      gaussianDeriv (t ^ n * ξ) ^ 2 / t) = Real.pi := by
    calc
      N * (∫ t : ℝ in Set.Ioi (0 : ℝ),
          gaussianDeriv (t ^ n * ξ) ^ 2 / t) =
          ∫ t : ℝ in Set.Ioi (0 : ℝ),
            N * (gaussianDeriv (t ^ n * ξ) ^ 2 / t) := by
              rw [integral_const_mul]
      _ = ∫ t : ℝ in Set.Ioi (0 : ℝ),
          (N * t ^ (N - 1)) *
            (gaussianDeriv (t ^ N * ξ) ^ 2 / t ^ N) := by
              apply setIntegral_congr_fun measurableSet_Ioi
              intro t ht
              exact (hpoint t ht).symm
      _ = Real.pi := hweighted
  apply (eq_div_iff hN.ne').2
  simpa [mul_comm] using hmul

/-- The scalar Calderón mass is insensitive to the sign of the nonzero
frequency, as required for the Fourier-side square-function calculation. -/
theorem integral_gaussianDeriv_sq_nat_scale_Ioi_of_ne_zero
    (n : ℕ) (hn : 0 < n) (ξ : ℝ) (hξ : ξ ≠ 0) :
    ∫ t : ℝ in Set.Ioi (0 : ℝ),
      gaussianDeriv (t ^ n * ξ) ^ 2 / t = Real.pi / (n : ℝ) := by
  rcases lt_or_gt_of_ne hξ with hneg | hpos
  · have hpos' : 0 < -ξ := neg_pos.mpr hneg
    calc
      ∫ t : ℝ in Set.Ioi (0 : ℝ),
          gaussianDeriv (t ^ n * ξ) ^ 2 / t =
          ∫ t : ℝ in Set.Ioi (0 : ℝ),
            gaussianDeriv (t ^ n * (-ξ)) ^ 2 / t := by
              apply setIntegral_congr_fun measurableSet_Ioi
              intro t ht
              change gaussianDeriv (t ^ n * ξ) ^ 2 / t =
                gaussianDeriv (t ^ n * (-ξ)) ^ 2 / t
              rw [show t ^ n * (-ξ) = -(t ^ n * ξ) by ring,
                gaussianDeriv_neg]
              ring
      _ = Real.pi / (n : ℝ) :=
        integral_gaussianDeriv_sq_nat_scale_Ioi n hn (-ξ) hpos'
  · exact integral_gaussianDeriv_sq_nat_scale_Ioi n hn ξ hpos

/-- The exceptional zero frequency is null for Lebesgue measure, so the
Calderón mass holds almost everywhere on the Fourier side. -/
theorem ae_integral_gaussianDeriv_sq_nat_scale_Ioi
    (n : ℕ) (hn : 0 < n) :
    ∀ᵐ ξ : ℝ,
      ∫ t : ℝ in Set.Ioi (0 : ℝ),
        gaussianDeriv (t ^ n * ξ) ^ 2 / t = Real.pi / (n : ℝ) := by
  filter_upwards [show ∀ᵐ ξ : ℝ, ξ ≠ 0 by
    simp [ae_iff, measure_singleton]] with ξ hξ
  exact integral_gaussianDeriv_sq_nat_scale_Ioi_of_ne_zero n hn ξ hξ

/-- Abstract Fubini contraction for the scalar Calderón multiplier.  The
only analytic input is joint integrability; the Fourier calculation supplies
the almost-everywhere inner scale identity separately. -/
theorem calderon_fubini_of_ae_scale_mass
    (n : ℕ) (M : ℝ → ℝ)
    (hjoint : Integrable (fun q : ℝ × ℝ ↦
      M q.2 * (gaussianDeriv (q.1 ^ n * q.2) ^ 2 / q.1))
      ((volume.restrict (Set.Ioi (0 : ℝ))).prod volume))
    (hscale : ∀ᵐ ξ : ℝ,
      ∫ t : ℝ in Set.Ioi (0 : ℝ),
        gaussianDeriv (t ^ n * ξ) ^ 2 / t = Real.pi / (n : ℝ)) :
    ∫ t : ℝ in Set.Ioi (0 : ℝ),
      ∫ ξ : ℝ, M ξ * (gaussianDeriv (t ^ n * ξ) ^ 2 / t) =
        (Real.pi / (n : ℝ)) * ∫ ξ : ℝ, M ξ := by
  let K : ℝ → ℝ → ℝ := fun t ξ ↦
    M ξ * (gaussianDeriv (t ^ n * ξ) ^ 2 / t)
  have hK : Integrable (Function.uncurry K)
      ((volume.restrict (Set.Ioi (0 : ℝ))).prod volume) := by
    apply hjoint.congr
    filter_upwards [] with q
    rcases q with ⟨t, ξ⟩
    rfl
  have hinter : ∀ᵐ ξ : ℝ,
      (∫ t : ℝ in Set.Ioi (0 : ℝ), K t ξ) =
        M ξ * (Real.pi / (n : ℝ)) := by
    filter_upwards [hscale] with ξ hξ
    dsimp only [K]
    rw [integral_const_mul, hξ]
  change (∫ t : ℝ in Set.Ioi (0 : ℝ), ∫ ξ : ℝ, K t ξ) = _
  rw [integral_integral_swap hK]
  calc
    (∫ ξ : ℝ, ∫ t : ℝ in Set.Ioi (0 : ℝ), K t ξ) =
        ∫ ξ : ℝ, M ξ * (Real.pi / (n : ℝ)) :=
      integral_congr_ae hinter
    _ = (Real.pi / (n : ℝ)) * ∫ ξ : ℝ, M ξ := by
      rw [integral_mul_const]
      ring

/-- The one-dimensional square-function conclusion once fixed-scale
Plancherel has identified the fiber `L²` norm with its Fourier multiplier.
This isolates exactly the convolution/Plancherel extension from the
subsequent Tonelli and scalar calculations. -/
theorem fiberSquare_identity_of_fixedScalePlancherel
    (n : ℕ) (H : ℝ → ℝ → ℝ) (M : ℝ → ℝ)
    (hfixed : ∀ᵐ t : ℝ ∂(volume.restrict (Set.Ioi (0 : ℝ))),
      (∫ q : ℝ, H t q) =
        ∫ ξ : ℝ, M ξ * (gaussianDeriv (t ^ n * ξ) ^ 2 / t))
    (hjoint : Integrable (fun q : ℝ × ℝ ↦
      M q.2 * (gaussianDeriv (q.1 ^ n * q.2) ^ 2 / q.1))
      ((volume.restrict (Set.Ioi (0 : ℝ))).prod volume))
    (hscale : ∀ᵐ ξ : ℝ,
      ∫ t : ℝ in Set.Ioi (0 : ℝ),
        gaussianDeriv (t ^ n * ξ) ^ 2 / t = Real.pi / (n : ℝ)) :
    ∫ t : ℝ in Set.Ioi (0 : ℝ), ∫ q : ℝ, H t q =
      (Real.pi / (n : ℝ)) * ∫ ξ : ℝ, M ξ := by
  calc
    (∫ t : ℝ in Set.Ioi (0 : ℝ), ∫ q : ℝ, H t q) =
        ∫ t : ℝ in Set.Ioi (0 : ℝ),
          ∫ ξ : ℝ, M ξ * (gaussianDeriv (t ^ n * ξ) ^ 2 / t) :=
      integral_congr_ae hfixed
    _ = (Real.pi / (n : ℝ)) * ∫ ξ : ℝ, M ξ :=
      calderon_fubini_of_ae_scale_mass n M hjoint hscale

/-- A ready-to-use natural-power form of the preceding fiber square identity.
The scalar almost-everywhere multiplier calculation is now internal. -/
theorem fiberSquare_identity_of_fixedScalePlancherel_nat
    (n : ℕ) (hn : 0 < n) (H : ℝ → ℝ → ℝ) (M : ℝ → ℝ)
    (hfixed : ∀ᵐ t : ℝ ∂(volume.restrict (Set.Ioi (0 : ℝ))),
      (∫ q : ℝ, H t q) =
        ∫ ξ : ℝ, M ξ * (gaussianDeriv (t ^ n * ξ) ^ 2 / t))
    (hjoint : Integrable (fun q : ℝ × ℝ ↦
      M q.2 * (gaussianDeriv (q.1 ^ n * q.2) ^ 2 / q.1))
      ((volume.restrict (Set.Ioi (0 : ℝ))).prod volume)) :
    ∫ t : ℝ in Set.Ioi (0 : ℝ), ∫ q : ℝ, H t q =
      (Real.pi / (n : ℝ)) * ∫ ξ : ℝ, M ξ := by
  apply fiberSquare_identity_of_fixedScalePlancherel n H M hfixed hjoint
  exact ae_integral_gaussianDeriv_sq_nat_scale_Ioi n hn


/-- The exact Fourier multiplier of a positive normalized Gaussian-derivative
dilation.  This is the physical-to-frequency bridge at one fixed scale. -/
theorem fourier_gaussianDerivAt_zero
    (s : ℝ) (hs : 0 < s) :
    (𝓕 fun x : ℝ ↦ (gaussianDerivAt s 0 x : ℂ)) =
      fun ξ : ℝ ↦ -Complex.I * (gaussianDeriv (s * ξ) : ℂ) := by
  funext ξ
  let G : ℝ → ℂ := fun y ↦
    (Real.fourierChar (-(y * (s * ξ))) : ℂ) * (gaussianDeriv y : ℂ)
  have hkernel (x : ℝ) :
      (gaussianDerivAt s 0 x : ℂ) =
        (s⁻¹ : ℂ) * (gaussianDeriv (x / s) : ℂ) := by
    simp [gaussianDerivAt, kernelAt, kernelDilate, smul_eq_mul]
  have hphase (x : ℝ) :
      (Real.fourierChar (-(x * ξ)) : ℂ) *
        ((s⁻¹ : ℂ) * (gaussianDeriv (x / s) : ℂ)) =
      (s⁻¹ : ℂ) * G (x / s) := by
    dsimp [G]
    have hs0 : s ≠ 0 := hs.ne'
    rw [show -((x / s) * (s * ξ)) = -(x * ξ) by
      field_simp]
    ring
  have hchange :
      (∫ x : ℝ, (Real.fourierChar (-(x * ξ)) : ℂ) *
        ((s⁻¹ : ℂ) * (gaussianDeriv (x / s) : ℂ))) = ∫ y : ℝ, G y := by
    calc
      (∫ x : ℝ, (Real.fourierChar (-(x * ξ)) : ℂ) *
          ((s⁻¹ : ℂ) * (gaussianDeriv (x / s) : ℂ))) =
          ∫ x : ℝ, (s⁻¹ : ℂ) * G (x / s) := by
            apply integral_congr_ae
            filter_upwards [] with x
            exact hphase x
      _ = (s⁻¹ : ℂ) * ∫ x : ℝ, G (x / s) := by
            rw [integral_const_mul]
      _ = (s⁻¹ : ℂ) * (|s| • ∫ y : ℝ, G y) := by
            rw [Measure.integral_comp_div]
      _ = ∫ y : ℝ, G y := by
            rw [abs_of_pos hs]
            rw [Complex.real_smul]
            field_simp [Complex.ofReal_ne_zero.mpr hs.ne']
  rw [Real.fourier_real_eq]
  change (∫ x : ℝ, (Real.fourierChar (-(x * ξ)) : ℂ) *
    (gaussianDerivAt s 0 x : ℂ)) = _
  rw [show (fun x : ℝ ↦
      (Real.fourierChar (-(x * ξ)) : ℂ) * (gaussianDerivAt s 0 x : ℂ)) =
      fun x : ℝ ↦ (Real.fourierChar (-(x * ξ)) : ℂ) *
        ((s⁻¹ : ℂ) * (gaussianDeriv (x / s) : ℂ)) by
          funext x
          rw [hkernel]]
  rw [hchange]
  have hGfourier : (∫ y : ℝ, G y) =
      𝓕 (fun y : ℝ ↦ (gaussianDeriv y : ℂ)) (s * ξ) := by
    rw [Real.fourier_real_eq]
    change (∫ y : ℝ, G y) =
      ∫ y : ℝ, (Real.fourierChar (-(y * (s * ξ))) : ℂ) *
        (gaussianDeriv y : ℂ)
    apply integral_congr_ae
    filter_upwards [] with y
    dsimp [G]
  rw [hGfourier, fourier_gaussianDeriv]

/-- Translation contributes only the expected unimodular Fourier phase to a
positive Gaussian-derivative dilation. -/
theorem fourier_gaussianDerivAt
    (s a : ℝ) (hs : 0 < s) :
    (𝓕 fun x : ℝ ↦ (gaussianDerivAt s a x : ℂ)) =
      fun ξ : ℝ ↦ (Real.fourierChar (-(a * ξ)) : ℂ) *
        (-Complex.I * (gaussianDeriv (s * ξ) : ℂ)) := by
  funext ξ
  let H : ℝ → ℂ := fun y ↦
    (Real.fourierChar (-(y * ξ)) : ℂ) * (gaussianDerivAt s 0 y : ℂ)
  have htranslate (x : ℝ) :
      (gaussianDerivAt s a x : ℂ) = (gaussianDerivAt s 0 (x - a) : ℂ) := by
    simp [gaussianDerivAt, kernelAt]
  have hphase (x : ℝ) :
      (Real.fourierChar (-(x * ξ)) : ℂ) =
        (Real.fourierChar (-(a * ξ)) : ℂ) *
          (Real.fourierChar (-((x - a) * ξ)) : ℂ) := by
    simp only [Real.fourierChar_apply]
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  rw [Real.fourier_real_eq]
  change (∫ x : ℝ, (Real.fourierChar (-(x * ξ)) : ℂ) *
    (gaussianDerivAt s a x : ℂ)) = _
  calc
    (∫ x : ℝ, (Real.fourierChar (-(x * ξ)) : ℂ) *
        (gaussianDerivAt s a x : ℂ)) =
        ∫ x : ℝ, (Real.fourierChar (-(a * ξ)) : ℂ) * H (x - a) := by
          apply integral_congr_ae
          filter_upwards [] with x
          rw [hphase x, htranslate x]
          dsimp [H]
          ring
    _ = (Real.fourierChar (-(a * ξ)) : ℂ) * ∫ x : ℝ, H (x - a) := by
      rw [integral_const_mul]
    _ = (Real.fourierChar (-(a * ξ)) : ℂ) * ∫ y : ℝ, H y := by
      congr 1
      exact integral_sub_right_eq_self H a
    _ = (Real.fourierChar (-(a * ξ)) : ℂ) *
        𝓕 (fun y : ℝ ↦ (gaussianDerivAt s 0 y : ℂ)) ξ := by
          congr 1
          rw [Real.fourier_real_eq]
          change (∫ y : ℝ, H y) =
            ∫ y : ℝ, (Real.fourierChar (-(y * ξ)) : ℂ) *
              (gaussianDerivAt s 0 y : ℂ)
          apply integral_congr_ae
          filter_upwards [] with y
          rfl
    _ = (Real.fourierChar (-(a * ξ)) : ℂ) *
        (-Complex.I * (gaussianDeriv (s * ξ) : ℂ)) := by
          rw [fourier_gaussianDerivAt_zero s hs]

/-- The translated Gaussian-derivative multiplier has the literal real
square modulus used by the fixed-scale Plancherel calculation. -/
theorem norm_sq_fourier_gaussianDerivAt
    (s a ξ : ℝ) (hs : 0 < s) :
    ‖𝓕 (fun x : ℝ ↦ (gaussianDerivAt s a x : ℂ)) ξ‖ ^ 2 =
      gaussianDeriv (s * ξ) ^ 2 := by
  rw [fourier_gaussianDerivAt s a hs]
  simp only [norm_mul, Circle.norm_coe, Complex.norm_real, Real.norm_eq_abs]
  rw [norm_neg, Complex.norm_I]
  simp only [one_mul, sq_abs]

/-- Finite unions of literal box collections become ordinary unions of their
center--scale regions. -/
theorem collectionRegion_union (α : Anisotropy)
    (S T : BoxCollection α) :
    collectionRegion α (S ∪ T) =
      collectionRegion α S ∪ collectionRegion α T := by
  ext z
  constructor
  · intro hz
    rw [collectionRegion] at hz
    rcases Set.mem_iUnion.1 hz with ⟨q, hz⟩
    rcases Set.mem_iUnion.1 hz with ⟨hq, hz⟩
    rw [Finset.mem_union] at hq
    rcases hq with hq | hq
    · left
      rw [collectionRegion]
      exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hq, hz⟩⟩
    · right
      rw [collectionRegion]
      exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hq, hz⟩⟩
  · intro hz
    rw [collectionRegion]
    rcases hz with hz | hz
    · rw [collectionRegion] at hz
      rcases Set.mem_iUnion.1 hz with ⟨q, hz⟩
      rcases Set.mem_iUnion.1 hz with ⟨hq, hz⟩
      exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2
        ⟨Finset.mem_union_left _ hq, hz⟩⟩
    · rw [collectionRegion] at hz
      rcases Set.mem_iUnion.1 hz with ⟨q, hz⟩
      rcases Set.mem_iUnion.1 hz with ⟨hq, hz⟩
      exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2
        ⟨Finset.mem_union_right _ hq, hz⟩⟩

/-- Disjoint finite box collections have disjoint center--scale regions. -/
theorem disjoint_collectionRegion_of_disjoint (α : Anisotropy)
    (S T : BoxCollection α) (hST : Disjoint S T) :
    Disjoint (collectionRegion α S) (collectionRegion α T) := by
  rw [Set.disjoint_left]
  intro z hzS hzT
  rw [collectionRegion] at hzS hzT
  rcases Set.mem_iUnion.1 hzS with ⟨q, hzS⟩
  rcases Set.mem_iUnion.1 hzS with ⟨hqS, hzq⟩
  rcases Set.mem_iUnion.1 hzT with ⟨r, hzT⟩
  rcases Set.mem_iUnion.1 hzT with ⟨hrT, hzr⟩
  by_cases hqr : q = r
  · subst r
    exact (Finset.disjoint_left.1 hST hqS hrT).elim
  · exact (Set.disjoint_left.1 (boxScaleRegion_disjoint_of_ne α hqr) hzq hzr).elim

/-- The expanded local form is additive over a finite disjoint union whenever
the outer signed integrand is integrable on the union. -/
theorem expandedModelLocalForm_union_of_integrable
    (α : Anisotropy) (S T : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (hST : Disjoint S T)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict (collectionRegion α (S ∪ T)))) :
    expandedModelLocalForm α (S ∪ T) u c f =
      expandedModelLocalForm α S u c f +
        expandedModelLocalForm α T u c f := by
  let g : E3 × ℝ → ℝ := fun pt ↦
    c pt.2 * (∫ z : ModelE5,
      modelFirstFiber α f pt.1 pt.2 z *
        modelSecondFiber α (f 3) pt.1 pt.2 z *
          modelSignedDensity α u pt.1 pt.2 z)
  have hregion : collectionRegion α (S ∪ T) =
      collectionRegion α S ∪ collectionRegion α T :=
    collectionRegion_union α S T
  have hdisj : Disjoint (collectionRegion α S) (collectionRegion α T) :=
    disjoint_collectionRegion_of_disjoint α S T hST
  have hSint : Integrable g
      (cubeScaleMeasure.restrict (collectionRegion α S)) := by
    apply hint.mono_measure
    rw [hregion]
    exact Measure.restrict_mono (Set.subset_union_left) le_rfl
  have hTint : Integrable g
      (cubeScaleMeasure.restrict (collectionRegion α T)) := by
    apply hint.mono_measure
    rw [hregion]
    exact Measure.restrict_mono (Set.subset_union_right) le_rfl
  unfold expandedModelLocalForm
  change -(∫ pt, g pt ∂(cubeScaleMeasure.restrict
      (collectionRegion α (S ∪ T)))) =
    -(∫ pt, g pt ∂(cubeScaleMeasure.restrict (collectionRegion α S))) +
      -(∫ pt, g pt ∂(cubeScaleMeasure.restrict (collectionRegion α T)))
  rw [hregion, setIntegral_union hdisj
    (measurableSet_collectionRegion α T) hSint hTint]
  ring

/-- Fixed-scale Plancherel for a Schwartz fiber convolved with the centered
Gaussian derivative.  The right-hand side is the exact multiplier square
needed before integrating over scales. -/
theorem integral_norm_sq_gaussianDeriv_convolution
    (F : SchwartzMap ℝ ℂ) (s : ℝ) (hs : 0 < s) :
    (∫ q : ℝ, ‖((F : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (fun v : ℝ ↦ (gaussianDerivAt s 0 v : ℂ))) q‖ ^ 2) =
      ∫ ξ : ℝ, ‖𝓕 (F : ℝ → ℂ) ξ‖ ^ 2 * gaussianDeriv (s * ξ) ^ 2 := by
  let K : ℝ → ℂ := fun v ↦ (gaussianDerivAt s 0 v : ℂ)
  change (∫ q : ℝ, ‖((F : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] K) q‖ ^ 2) = _
  have hK : Integrable K := by
    change Integrable (fun v : ℝ ↦ Complex.ofReal (gaussianDerivAt s 0 v))
    exact (integrable_gaussianDerivAt hs 0).ofReal
  have hconv : Integrable ((F : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] K) :=
    F.integrable.integrable_convolution (ContinuousLinearMap.mul ℂ ℂ) hK
  have hconvcont : Continuous ((F : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] K) :=
    (bddAbove_norm_complex_gaussianDerivAt s 0).continuous_convolution_right_of_integrable
      (ContinuousLinearMap.mul ℂ ℂ) F.integrable
      (continuous_complex_gaussianDerivAt s 0)
  have hfourier_conv :
      𝓕 ((F : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] K) =
        fun ξ : ℝ ↦ -Complex.I *
          (𝓕 (F : ℝ → ℂ) ξ * (gaussianDeriv (s * ξ) : ℂ)) := by
    funext ξ
    rw [Real.fourier_mul_convolution_eq F.integrable hK]
    change 𝓕 (F : ℝ → ℂ) ξ * 𝓕 K ξ = _
    rw [show K = fun v : ℝ ↦ (gaussianDerivAt s 0 v : ℂ) by rfl,
      fourier_gaussianDerivAt_zero s hs]
    ring
  have hfourier_int : Integrable (𝓕 ((F : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] K)) := by
    rw [hfourier_conv]
    exact (integrable_fourier_schwartz_mul_gaussianDeriv F s).const_mul (-Complex.I)
  have hplancherel :=
    integral_norm_sq_fourier_eq_of_integrable hconvcont hconv hfourier_int
  calc
    (∫ q : ℝ, ‖((F : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] K) q‖ ^ 2) =
        ∫ ξ : ℝ, ‖𝓕 ((F : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] K) ξ‖ ^ 2 :=
      hplancherel.symm
    _ = ∫ ξ : ℝ, ‖𝓕 (F : ℝ → ℂ) ξ‖ ^ 2 * gaussianDeriv (s * ξ) ^ 2 := by
      apply integral_congr_ae
      filter_upwards [] with ξ
      rw [hfourier_conv]
      simp only [norm_mul, norm_neg, Complex.norm_I, one_mul, Complex.norm_real,
        Real.norm_eq_abs]
      rw [mul_pow, sq_abs]

/-- The fixed-scale identity in the source fiber convention: the centered
derivative integral has exactly the Gaussian multiplier-square energy. -/
theorem integral_norm_sq_gaussianDeriv_fiber
    (F : SchwartzMap ℝ ℂ) (s : ℝ) (hs : 0 < s) :
    (∫ q : ℝ, ‖∫ v : ℝ, F v * (gaussianDerivAt s q v : ℂ)‖ ^ 2) =
      ∫ ξ : ℝ, ‖𝓕 (F : ℝ → ℂ) ξ‖ ^ 2 * gaussianDeriv (s * ξ) ^ 2 := by
  let K : ℝ → ℂ := fun v ↦ (gaussianDerivAt s 0 v : ℂ)
  calc
    (∫ q : ℝ, ‖∫ v : ℝ, F v * (gaussianDerivAt s q v : ℂ)‖ ^ 2) =
        ∫ q : ℝ, ‖-((F : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] K) q‖ ^ 2 := by
      apply integral_congr_ae
      filter_upwards [] with q
      rw [gaussianDerivAt_fiber_eq_neg_convolution]
    _ = ∫ q : ℝ, ‖((F : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] K) q‖ ^ 2 := by
      apply integral_congr_ae
      filter_upwards [] with q
      rw [norm_neg]
    _ = ∫ ξ : ℝ, ‖𝓕 (F : ℝ → ℂ) ξ‖ ^ 2 * gaussianDeriv (s * ξ) ^ 2 := by
      exact integral_norm_sq_gaussianDeriv_convolution F s hs

/-- The complete one-dimensional scale-square-function calculation for a
Schwartz fiber, conditional only on the stated joint-integrability gateway.
The condition is precisely the one required to exchange its nonnegative
scale and frequency integrals. -/
theorem schwartz_fiber_square_function_of_jointIntegrable
    (F : SchwartzMap ℝ ℂ) (n : ℕ) (hn : 0 < n)
    (hjoint : Integrable (fun z : ℝ × ℝ ↦
      ‖𝓕 (F : ℝ → ℂ) z.2‖ ^ 2 *
        (gaussianDeriv (z.1 ^ n * z.2) ^ 2 / z.1))
      ((volume.restrict (Set.Ioi (0 : ℝ))).prod volume)) :
    (∫ t : ℝ in Set.Ioi (0 : ℝ), ∫ q : ℝ,
      ‖∫ v : ℝ, F v * (gaussianDerivAt (t ^ n) q v : ℂ)‖ ^ 2 / t) =
      (Real.pi / (n : ℝ)) * ∫ v : ℝ, ‖F v‖ ^ 2 := by
  let H : ℝ → ℝ → ℝ := fun t q ↦
    ‖∫ v : ℝ, F v * (gaussianDerivAt (t ^ n) q v : ℂ)‖ ^ 2 / t
  let M : ℝ → ℝ := fun ξ ↦ ‖𝓕 (F : ℝ → ℂ) ξ‖ ^ 2
  have hfixed : ∀ᵐ t : ℝ ∂(volume.restrict (Set.Ioi (0 : ℝ))),
      (∫ q : ℝ, H t q) =
        ∫ ξ : ℝ, M ξ * (gaussianDeriv (t ^ n * ξ) ^ 2 / t) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    have hscale : 0 < t ^ n := pow_pos ht n
    rw [show (∫ q : ℝ, H t q) =
        (∫ q : ℝ, ‖∫ v : ℝ,
          F v * (gaussianDerivAt (t ^ n) q v : ℂ)‖ ^ 2) / t by
      rw [integral_div]
      ]
    rw [integral_norm_sq_gaussianDeriv_fiber F (t ^ n) hscale]
    rw [← integral_div]
    apply integral_congr_ae
    filter_upwards [] with ξ
    dsimp only [M]
    ring
  have hmain := fiberSquare_identity_of_fixedScalePlancherel_nat n hn H M hfixed (by
    simpa only [M] using hjoint)
  have hschwartz_plancherel :
      (∫ ξ : ℝ, ‖𝓕 (F : ℝ → ℂ) ξ‖ ^ 2) = ∫ v : ℝ, ‖F v‖ ^ 2 := by
    simpa only [SchwartzMap.fourier_coe] using SchwartzMap.integral_norm_sq_fourier F
  calc
    (∫ t : ℝ in Set.Ioi (0 : ℝ), ∫ q : ℝ,
      ‖∫ v : ℝ, F v * (gaussianDerivAt (t ^ n) q v : ℂ)‖ ^ 2 / t) =
        ∫ t : ℝ in Set.Ioi (0 : ℝ), ∫ q : ℝ, H t q := by rfl
    _ = (Real.pi / (n : ℝ)) * ∫ ξ : ℝ, M ξ := hmain
    _ = (Real.pi / (n : ℝ)) * ∫ v : ℝ, ‖F v‖ ^ 2 := by
      rw [show (∫ ξ : ℝ, M ξ) = ∫ ξ : ℝ, ‖𝓕 (F : ℝ → ℂ) ξ‖ ^ 2 by rfl,
        hschwartz_plancherel]

/-- The nonnegative Calderón kernel is jointly integrable whenever its
frequency weight is nonnegative and integrable.  This supplies the Fubini
hypothesis in the Schwartz square-function calculation without an `L²`
extension argument. -/
theorem integrable_calderon_joint_of_integrable
    (n : ℕ) (hn : 0 < n) (M : ℝ → ℝ)
    (hM : Integrable M) (hMnonneg : ∀ ξ : ℝ, 0 ≤ M ξ) :
    Integrable (fun z : ℝ × ℝ ↦
      M z.2 * (gaussianDeriv (z.1 ^ n * z.2) ^ 2 / z.1))
      ((volume.restrict (Set.Ioi (0 : ℝ))).prod volume) := by
  let μ : Measure ℝ := volume.restrict (Set.Ioi (0 : ℝ))
  let K : ℝ × ℝ → ℝ := fun z ↦
    M z.2 * (gaussianDeriv (z.1 ^ n * z.2) ^ 2 / z.1)
  have hargcont : Continuous (fun z : ℝ × ℝ ↦ z.1 ^ n * z.2) :=
    (continuous_fst.pow n).mul continuous_snd
  have hfactor_meas : Measurable (fun z : ℝ × ℝ ↦
      gaussianDeriv (z.1 ^ n * z.2) ^ 2 / z.1) :=
    ((continuous_gaussianDeriv.comp hargcont).measurable.pow_const 2).div
      continuous_fst.measurable
  have hKmeas : AEStronglyMeasurable K (μ.prod volume) := by
    dsimp only [K]
    exact hM.aestronglyMeasurable.comp_snd.mul hfactor_meas.aestronglyMeasurable
  apply (integrable_prod_iff' hKmeas).mpr
  constructor
  · filter_upwards [show ∀ᵐ ξ : ℝ, ξ ≠ 0 by
      simp [ae_iff, measure_singleton]] with ξ hξ
    have hmass := integral_gaussianDeriv_sq_nat_scale_Ioi_of_ne_zero n hn ξ hξ
    have hbase : Integrable (fun t : ℝ ↦
        gaussianDeriv (t ^ n * ξ) ^ 2 / t) μ := by
      by_contra hnot
      have hzero : (∫ t : ℝ, gaussianDeriv (t ^ n * ξ) ^ 2 / t ∂μ) = 0 :=
        integral_undef hnot
      have hpos : 0 < Real.pi / (n : ℝ) :=
        div_pos Real.pi_pos (Nat.cast_pos.mpr hn)
      rw [show (∫ t : ℝ, gaussianDeriv (t ^ n * ξ) ^ 2 / t ∂μ) =
          ∫ t : ℝ in Set.Ioi (0 : ℝ),
            gaussianDeriv (t ^ n * ξ) ^ 2 / t by rfl,
        hzero] at hmass
      linarith
    change Integrable (fun t : ℝ ↦
      M ξ * (gaussianDeriv (t ^ n * ξ) ^ 2 / t)) μ
    exact hbase.const_mul (M ξ)
  · have hMscaled : Integrable (fun ξ : ℝ ↦ M ξ * (Real.pi / (n : ℝ))) :=
      hM.mul_const (Real.pi / (n : ℝ))
    apply hMscaled.congr
    filter_upwards [show ∀ᵐ ξ : ℝ, ξ ≠ 0 by
      simp [ae_iff, measure_singleton]] with ξ hξ
    have hmass := integral_gaussianDeriv_sq_nat_scale_Ioi_of_ne_zero n hn ξ hξ
    have hnonneg : ∀ᵐ t : ℝ ∂μ,
        0 ≤ K (t, ξ) := by
      filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
      dsimp only [K]
      exact mul_nonneg (hMnonneg ξ)
        (div_nonneg (sq_nonneg _) ht.le)
    calc
      M ξ * (Real.pi / (n : ℝ)) =
          ∫ t : ℝ, ‖K (t, ξ)‖ ∂μ := by
        symm
        calc
          (∫ t : ℝ, ‖K (t, ξ)‖ ∂μ) = ∫ t : ℝ, K (t, ξ) ∂μ := by
            apply integral_congr_ae
            filter_upwards [hnonneg] with t ht
            rw [Real.norm_eq_abs, abs_of_nonneg ht]
          _ = M ξ * (∫ t : ℝ,
              gaussianDeriv (t ^ n * ξ) ^ 2 / t ∂μ) := by
            dsimp only [K]
            rw [integral_const_mul]
          _ = M ξ * (Real.pi / (n : ℝ)) := by
            rw [show (∫ t : ℝ, gaussianDeriv (t ^ n * ξ) ^ 2 / t ∂μ) =
                ∫ t : ℝ in Set.Ioi (0 : ℝ),
                  gaussianDeriv (t ^ n * ξ) ^ 2 / t by rfl,
              hmass]

/-- The full one-dimensional square-function identity for every complex
Schwartz fiber, now with the Fubini condition discharged. -/
theorem schwartz_fiber_square_function
    (F : SchwartzMap ℝ ℂ) (n : ℕ) (hn : 0 < n) :
    (∫ t : ℝ in Set.Ioi (0 : ℝ), ∫ q : ℝ,
      ‖∫ v : ℝ, F v * (gaussianDerivAt (t ^ n) q v : ℂ)‖ ^ 2 / t) =
      (Real.pi / (n : ℝ)) * ∫ v : ℝ, ‖F v‖ ^ 2 := by
  apply schwartz_fiber_square_function_of_jointIntegrable F n hn
  refine integrable_calderon_joint_of_integrable n hn
    (fun ξ : ℝ ↦ ‖𝓕 (F : ℝ → ℂ) ξ‖ ^ 2) ?_ ?_
  · have hmem : MemLp (𝓕 F : SchwartzMap ℝ ℂ) 2 (volume : Measure ℝ) :=
      (𝓕 F).memLp 2 volume
    have hsq : Integrable (fun ξ : ℝ ↦ ‖(𝓕 F : SchwartzMap ℝ ℂ) ξ‖ ^ 2) :=
      (memLp_two_iff_integrable_sq_norm
        (𝓕 F : SchwartzMap ℝ ℂ).continuous.aestronglyMeasurable).mp hmem
    simpa only [SchwartzMap.fourier_coe] using hsq
  · intro ξ
    positivity

/-- The one-dimensional scale square function for a real fiber whose
complexification is Schwartz. -/
theorem real_schwartz_fiber_square_function
    (F : SchwartzMap ℝ ℂ) (g : ℝ → ℝ) (hF : ∀ v : ℝ, F v = (g v : ℂ))
    (n : ℕ) (hn : 0 < n) :
    (∫ t : ℝ in Set.Ioi (0 : ℝ), ∫ q : ℝ,
      (∫ v : ℝ, g v * gaussianDerivAt (t ^ n) q v) ^ 2 / t) =
      (Real.pi / (n : ℝ)) * ∫ v : ℝ, g v ^ 2 := by
  have hcomplex := schwartz_fiber_square_function F n hn
  have hleft :
      (∫ t : ℝ in Set.Ioi (0 : ℝ), ∫ q : ℝ,
        ‖∫ v : ℝ, F v * (gaussianDerivAt (t ^ n) q v : ℂ)‖ ^ 2 / t) =
      ∫ t : ℝ in Set.Ioi (0 : ℝ), ∫ q : ℝ,
        (∫ v : ℝ, g v * gaussianDerivAt (t ^ n) q v) ^ 2 / t := by
    apply setIntegral_congr_fun measurableSet_Ioi
    intro t ht
    apply integral_congr_ae
    filter_upwards [] with q
    rw [complexFiberIntegral_eq_real F g hF]
    simp
  have hright : (∫ v : ℝ, ‖F v‖ ^ 2) = ∫ v : ℝ, g v ^ 2 := by
    apply integral_congr_ae
    filter_upwards [] with v
    rw [hF v]
    simp
  rw [hleft, hright] at hcomplex
  exact hcomplex

/-- The source's third-coordinate square function for a real global input
with a complex Schwartz realization. -/
theorem modelThird_square_function_of_schwartz
    (α : Anisotropy) (F : SchwartzMap E3 ℂ) (f : E3 → ℝ)
    (hF : ∀ x : E3, F x = (f x : ℂ)) (x₁ x₂ : ℝ) :
    (∫ t : ℝ in Set.Ioi (0 : ℝ), ∫ q : ℝ,
      (∫ v : ℝ, f (modelPoint x₁ x₂ v) *
        gaussianDerivAt (t ^ α.weight 2) q v) ^ 2 / t) =
      (Real.pi / (α.weight 2 : ℝ)) * ∫ v : ℝ,
        f (modelPoint x₁ x₂ v) ^ 2 := by
  apply real_schwartz_fiber_square_function
    (modelThirdSchwartzFiber F x₁ x₂)
    (fun v : ℝ ↦ f (modelPoint x₁ x₂ v)) ?_ (α.weight 2)
    (α.weight_pos 2)
  intro v
  rw [modelThirdSchwartzFiber_apply, hF]

/-- The source's third-coordinate square function for every real Schwartz
input. -/
theorem modelThird_square_function_of_real_schwartz
    (α : Anisotropy) (f : SchwartzMap E3 ℝ) (x₁ x₂ : ℝ) :
    (∫ t : ℝ in Set.Ioi (0 : ℝ), ∫ q : ℝ,
      (∫ v : ℝ, f (modelPoint x₁ x₂ v) *
        gaussianDerivAt (t ^ α.weight 2) q v) ^ 2 / t) =
      (Real.pi / (α.weight 2 : ℝ)) * ∫ v : ℝ,
        f (modelPoint x₁ x₂ v) ^ 2 := by
  apply modelThird_square_function_of_schwartz α
    (complexifyRealSchwartz f) f ?_ x₁ x₂
  intro x
  simp


/-- On the entire positive half-line, the model scale density is literally
the logarithmic measure `dt / t`. -/
theorem integral_Ioi_withDensity_cubeScaleDensity_eq
    (f : ℝ → ℝ) :
    (∫ t : ℝ in Set.Ioi (0 : ℝ), f t
      ∂((volume : Measure ℝ).withDensity cubeScaleDensity)) =
      ∫ t : ℝ in Set.Ioi (0 : ℝ), f t / t := by
  have htop : ∀ᵐ t ∂(volume.restrict (Set.Ioi (0 : ℝ))),
      cubeScaleDensity t < ∞ := by
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    rw [cubeScaleDensity_eq_of_pos ht]
    exact ENNReal.ofReal_lt_top
  rw [setIntegral_withDensity_eq_setIntegral_toReal_smul
    measurable_cubeScaleDensity htop f measurableSet_Ioi]
  apply setIntegral_congr_fun measurableSet_Ioi
  intro t ht
  change (cubeScaleDensity t).toReal * f t = f t / t
  rw [cubeScaleDensity_eq_of_pos ht,
    ENNReal.toReal_ofReal (inv_pos.mpr ht).le]
  rw [div_eq_mul_inv]
  ring


theorem ae_modelEnergyTwoOuter_nonneg_of_subset_positive
    (α : Anisotropy) (V : Set (E3 × ℝ)) (u : E3) (f : E3 → ℝ)
    (hVmeas : MeasurableSet V)
    (hVpos : V ⊆ Set.univ ×ˢ Set.Ioi (0 : ℝ)) :
    0 ≤ᵐ[cubeScaleMeasure.restrict V] modelEnergyTwoOuter α u f := by
  filter_upwards [ae_restrict_mem hVmeas] with pt hpt
  exact modelEnergyTwoOuter_nonneg α u f pt (hVpos hpt).2.le
theorem modelEnergyTwoOn_le_global_of_integrable
    (α : Anisotropy) (V : Set (E3 × ℝ)) (u : E3) (f : E3 → ℝ)
    (hV : V ⊆ Set.univ ×ˢ Set.Ioi (0 : ℝ))
    (hglobal : Integrable (modelEnergyTwoOuter α u f)
      (cubeScaleMeasure.restrict (Set.univ ×ˢ Set.Ioi (0 : ℝ))) ) :
    modelEnergyTwoOn α V u f ≤
      modelEnergyTwoOn α (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f := by
  apply modelEnergyTwoOn_mono_of_integrable α V
    (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f hV
  · exact ae_modelEnergyTwoOuter_nonneg_of_subset_positive
      α (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f
      (MeasurableSet.univ.prod measurableSet_Ioi) (by intro pt hpt; exact hpt)
  · exact hglobal
theorem integral_abs_modelPhiAt_center {s : ℝ} (hs : 0 < s)
    (c x : ℝ) :
    ∫ p : ℝ, |modelPhiAt s (p + c) x| =
      ∫ y : ℝ, |conePhiPhysicalReal y| := by
  have hpoint (p : ℝ) :
      |modelPhiAt s (p + c) x| = |modelPhiAt s (x - c) p| := by
    unfold modelPhiAt kernelAt kernelDilate
    simp only [smul_eq_mul, abs_mul]
    congr 1
    rw [show (x - (p + c)) / s = -((p - (x - c)) / s) by ring]
    rw [conePhiPhysicalReal_even]
  calc
    ∫ p : ℝ, |modelPhiAt s (p + c) x| =
        ∫ p : ℝ, |modelPhiAt s (x - c) p| := by
          apply integral_congr_ae
          filter_upwards [] with p
          exact hpoint p
    _ = ∫ y : ℝ, |conePhiPhysicalReal y| :=
      integral_abs_modelPhiAt hs (x - c)

/-- The Gaussian auxiliary variable has mass one, so a center/Gaussian pair
contributes only the absolute `φ` mass. -/
theorem integral_modelPhiAt_gaussian_pair {s : ℝ} (hs : 0 < s)
    (c x : ℝ) :
    (∫ p : ℝ, ∫ y : ℝ,
      |modelPhiAt s (p + c) x| * gaussianAt s p y) =
      ∫ w : ℝ, |conePhiPhysicalReal w| := by
  calc
    (∫ p : ℝ, ∫ y : ℝ,
      |modelPhiAt s (p + c) x| * gaussianAt s p y) =
        ∫ p : ℝ, |modelPhiAt s (p + c) x| := by
          apply integral_congr_ae
          filter_upwards [] with p
          rw [integral_const_mul, integral_gaussianAt hs p]
          ring
    _ = ∫ w : ℝ, |conePhiPhysicalReal w| :=
      integral_abs_modelPhiAt_center hs c x

/-- The preceding center/Gaussian pair remains valid after multiplication by
any scalar independent of the pair variables. -/
theorem integral_modelPhiAt_gaussian_pair_const {s : ℝ} (hs : 0 < s)
    (c x C : ℝ) :
    (∫ p : ℝ, ∫ y : ℝ,
      C * |modelPhiAt s (p + c) x| * gaussianAt s p y) =
      C * ∫ w : ℝ, |conePhiPhysicalReal w| := by
  calc
    (∫ p : ℝ, ∫ y : ℝ,
      C * |modelPhiAt s (p + c) x| * gaussianAt s p y) =
        ∫ p : ℝ, C *
          (∫ y : ℝ, |modelPhiAt s (p + c) x| * gaussianAt s p y) := by
          apply integral_congr_ae
          filter_upwards [] with p
          rw [← integral_const_mul]
          congr 1
          funext y
          ring
    _ = C * (∫ p : ℝ, ∫ y : ℝ,
      |modelPhiAt s (p + c) x| * gaussianAt s p y) := by
          rw [integral_const_mul]
    _ = C * ∫ w : ℝ, |conePhiPhysicalReal w| := by
          rw [integral_modelPhiAt_gaussian_pair hs c x]

/-- The two independent low-frequency/Gaussian pairs contribute the square
of the absolute `φ` mass.  The nesting is chosen to match the scalar order
after the global-energy coordinate reordering. -/
theorem integral_two_modelPhi_gaussian_pairs
    {s₀ s₁ : ℝ} (hs₀ : 0 < s₀) (hs₁ : 0 < s₁)
    (c₀ c₁ x₀ x₁ C : ℝ) :
    (∫ p₀ : ℝ, ∫ y₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ,
      C * |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀ *
        |modelPhiAt s₁ (p₁ + c₁) x₁| * gaussianAt s₁ p₁ y₁) =
      C * (∫ w : ℝ, |conePhiPhysicalReal w|) ^ 2 := by
  let P : ℝ := ∫ w : ℝ, |conePhiPhysicalReal w|
  have hinner (p₀ y₀ : ℝ) :
      (∫ p₁ : ℝ, ∫ y₁ : ℝ,
        C * |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀ *
          |modelPhiAt s₁ (p₁ + c₁) x₁| * gaussianAt s₁ p₁ y₁) =
        (C * |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀) * P := by
    rw [show (fun p₁ : ℝ ↦ ∫ y₁ : ℝ,
      C * |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀ *
        |modelPhiAt s₁ (p₁ + c₁) x₁| * gaussianAt s₁ p₁ y₁) =
      fun p₁ : ℝ ↦ ∫ y₁ : ℝ,
        (C * |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀) *
          |modelPhiAt s₁ (p₁ + c₁) x₁| * gaussianAt s₁ p₁ y₁ by
        funext p₁
        apply integral_congr_ae
        filter_upwards [] with y₁
        ring]
    rw [integral_modelPhiAt_gaussian_pair_const hs₁ c₁ x₁
      (C * |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀)]
  calc
    (∫ p₀ : ℝ, ∫ y₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ,
      C * |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀ *
        |modelPhiAt s₁ (p₁ + c₁) x₁| * gaussianAt s₁ p₁ y₁) =
        ∫ p₀ : ℝ, ∫ y₀ : ℝ,
          (C * |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀) * P := by
          apply integral_congr_ae
          filter_upwards [] with p₀
          apply integral_congr_ae
          filter_upwards [] with y₀
          exact hinner p₀ y₀
    _ = ∫ p₀ : ℝ, ∫ y₀ : ℝ,
        (C * P) * |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀ := by
          apply integral_congr_ae
          filter_upwards [] with p₀
          apply integral_congr_ae
          filter_upwards [] with y₀
          ring
    _ = (C * P) * P :=
      integral_modelPhiAt_gaussian_pair_const hs₀ c₀ x₀ (C * P)
    _ = C * (∫ w : ℝ, |conePhiPhysicalReal w|) ^ 2 := by
      dsimp [P]
      ring

/-- The same two-pair calculation in the literal nested order
`p₀,p₁,y₀,y₁` supplied by `ScratchModelEnergyInner`. -/
theorem integral_two_modelPhi_gaussian_pairs_source_order
    {s₀ s₁ : ℝ} (hs₀ : 0 < s₀) (hs₁ : 0 < s₁)
    (c₀ c₁ x₀ x₁ C : ℝ) :
    (∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₀ : ℝ, ∫ y₁ : ℝ,
      C * |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀ *
        |modelPhiAt s₁ (p₁ + c₁) x₁| * gaussianAt s₁ p₁ y₁) =
      C * (∫ w : ℝ, |conePhiPhysicalReal w|) ^ 2 := by
  let φ₀ : ℝ → ℝ := fun p ↦ |modelPhiAt s₀ (p + c₀) x₀|
  let φ₁ : ℝ → ℝ := fun p ↦ |modelPhiAt s₁ (p + c₁) x₁|
  let γ₀ : ℝ → ℝ → ℝ := fun p y ↦ gaussianAt s₀ p y
  let γ₁ : ℝ → ℝ → ℝ := fun p y ↦ gaussianAt s₁ p y
  let P : ℝ := ∫ w : ℝ, |conePhiPhysicalReal w|
  have hφ₀ : (∫ p : ℝ, φ₀ p) = P := by
    dsimp [φ₀, P]
    exact integral_abs_modelPhiAt_center hs₀ c₀ x₀
  have hφ₁ : (∫ p : ℝ, φ₁ p) = P := by
    dsimp [φ₁, P]
    exact integral_abs_modelPhiAt_center hs₁ c₁ x₁
  have hγ₀ (p : ℝ) : (∫ y : ℝ, γ₀ p y) = 1 := by
    dsimp [γ₀]
    exact integral_gaussianAt hs₀ p
  have hγ₁ (p : ℝ) : (∫ y : ℝ, γ₁ p y) = 1 := by
    dsimp [γ₁]
    exact integral_gaussianAt hs₁ p
  change (∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₀ : ℝ, ∫ y₁ : ℝ,
      C * φ₀ p₀ * γ₀ p₀ y₀ * φ₁ p₁ * γ₁ p₁ y₁) = C * P ^ 2
  calc
    (∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₀ : ℝ, ∫ y₁ : ℝ,
      C * φ₀ p₀ * γ₀ p₀ y₀ * φ₁ p₁ * γ₁ p₁ y₁) =
        ∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₀ : ℝ,
          C * φ₀ p₀ * γ₀ p₀ y₀ * φ₁ p₁ := by
          apply integral_congr_ae
          filter_upwards [] with p₀
          apply integral_congr_ae
          filter_upwards [] with p₁
          apply integral_congr_ae
          filter_upwards [] with y₀
          rw [show (fun y₁ : ℝ ↦
            C * φ₀ p₀ * γ₀ p₀ y₀ * φ₁ p₁ * γ₁ p₁ y₁) =
              fun y₁ : ℝ ↦ (C * φ₀ p₀ * γ₀ p₀ y₀ * φ₁ p₁) * γ₁ p₁ y₁ by
                funext y₁
                ring, integral_const_mul, hγ₁]
          ring
    _ = ∫ p₀ : ℝ, ∫ p₁ : ℝ, C * φ₀ p₀ * φ₁ p₁ := by
          apply integral_congr_ae
          filter_upwards [] with p₀
          apply integral_congr_ae
          filter_upwards [] with p₁
          rw [show (fun y₀ : ℝ ↦ C * φ₀ p₀ * γ₀ p₀ y₀ * φ₁ p₁) =
            fun y₀ : ℝ ↦ (C * φ₀ p₀ * φ₁ p₁) * γ₀ p₀ y₀ by
              funext y₀
              ring, integral_const_mul, hγ₀]
          ring
    _ = ∫ p₀ : ℝ, C * φ₀ p₀ * P := by
          apply integral_congr_ae
          filter_upwards [] with p₀
          rw [show (fun p₁ : ℝ ↦ C * φ₀ p₀ * φ₁ p₁) =
            fun p₁ : ℝ ↦ (C * φ₀ p₀) * φ₁ p₁ by
              funext p₁
              ring, integral_const_mul, hφ₁]
    _ = (C * P) * P := by
          rw [show (fun p₀ : ℝ ↦ C * φ₀ p₀ * P) =
            fun p₀ : ℝ ↦ (C * P) * φ₀ p₀ by
              funext p₀
              ring, integral_const_mul, hφ₀]
    _ = C * P ^ 2 := by ring

/-- Integrating the translated center variable removes the `r t^{α₃}`
shift from a square function; the remaining annular mass is exactly
`‖ψ‖₁`.  This is the last scalar step in the global second-energy reduction. -/
theorem integral_shifted_square_with_conePsi
    (B : ℝ → ℝ) (s u : ℝ) :
    (∫ r : ℝ, |conePsiPhysicalReal (r + u)| *
      (∫ p : ℝ, B (p + r * s) ^ 2)) =
      conePsiPhysicalRealL1 * ∫ q : ℝ, B q ^ 2 := by
  have hshift (r : ℝ) :
      (∫ p : ℝ, B (p + r * s) ^ 2) = ∫ q : ℝ, B q ^ 2 := by
    exact integral_add_right_eq_self (μ := volume)
      (fun q : ℝ ↦ B q ^ 2) (r * s)
  calc
    (∫ r : ℝ, |conePsiPhysicalReal (r + u)| *
      (∫ p : ℝ, B (p + r * s) ^ 2)) =
        ∫ r : ℝ, |conePsiPhysicalReal (r + u)| * (∫ q : ℝ, B q ^ 2) := by
          apply integral_congr_ae
          filter_upwards [] with r
          rw [hshift r]
    _ = (∫ r : ℝ, |conePsiPhysicalReal (r + u)|) *
        ∫ q : ℝ, B q ^ 2 := by
          rw [integral_mul_const]
    _ = conePsiPhysicalRealL1 * ∫ q : ℝ, B q ^ 2 := by
          rw [integral_abs_conePsiPhysicalReal_add]

/-- Coordinate relabeling intertwines the two anisotropic dilations. -/
theorem coordinatePermutation_dilate
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (t : ℝ) (x : E3) :
    coordinatePermutation σ (α.dilate t x) =
      (permutedAnisotropy α σ).dilate t
        (coordinatePermutation σ x) := by
  ext i
  simp [Anisotropy.dilate]

/-- Permuting coordinate labels does not alter the homogeneous dimension. -/
theorem permutedAnisotropy_homogeneousDimension
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) :
    (permutedAnisotropy α σ).homogeneousDimension =
      α.homogeneousDimension := by
  unfold Anisotropy.homogeneousDimension permutedAnisotropy
  exact Equiv.sum_comp σ (fun i ↦ α.weight i)

/-- The homogeneous radius is invariant under simultaneous permutation of
the anisotropy and the spatial coordinates. -/
theorem permutedAnisotropy_radius
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (x : E3) :
    (permutedAnisotropy α σ).radius (coordinatePermutation σ x) =
      α.radius x := by
  unfold Anisotropy.radius permutedAnisotropy
  change (∑ i : Fin 3, |x (σ i)| ^ ((α.weight (σ i) : ℝ)⁻¹)) = _
  exact Equiv.sum_comp σ (fun i ↦ |x i| ^ ((α.weight i : ℝ)⁻¹))

/-- The `p₂,r` scalar calculation in the source order.  Joint integrability
is exactly the Fubini condition needed to exchange these two variables. -/
theorem integral_square_shifted_with_conePsi_of_integrable
    (B : ℝ → ℝ) (s u : ℝ)
    (hB : Integrable (fun z : ℝ × ℝ ↦
      B (z.1 + z.2 * s) ^ 2 * |conePsiPhysicalReal (z.2 + u)|)
      ((volume : Measure ℝ).prod volume)) :
    (∫ p : ℝ, ∫ r : ℝ,
      B (p + r * s) ^ 2 * |conePsiPhysicalReal (r + u)|) =
      conePsiPhysicalRealL1 * ∫ q : ℝ, B q ^ 2 := by
  calc
    (∫ p : ℝ, ∫ r : ℝ,
      B (p + r * s) ^ 2 * |conePsiPhysicalReal (r + u)|) =
        ∫ r : ℝ, ∫ p : ℝ,
          B (p + r * s) ^ 2 * |conePsiPhysicalReal (r + u)| := by
          exact integral_integral_swap hB
    _ = ∫ r : ℝ, |conePsiPhysicalReal (r + u)| *
        (∫ p : ℝ, B (p + r * s) ^ 2) := by
          apply integral_congr_ae
          filter_upwards [] with r
          rw [show (fun p : ℝ ↦
            B (p + r * s) ^ 2 * |conePsiPhysicalReal (r + u)|) =
              fun p : ℝ ↦ B (p + r * s) ^ 2 *
                |conePsiPhysicalReal (r + u)| by rfl,
            integral_mul_const]
          ring
    _ = conePsiPhysicalRealL1 * ∫ q : ℝ, B q ^ 2 :=
      integral_shifted_square_with_conePsi B s u

/-- The four scalar `φ`/Gaussian variables can be integrated while retaining
an arbitrary innermost scalar tail.  This is the literal `p₀,p₁,y₁,y₂,r`
order of the reordered model energy. -/
theorem integral_two_modelPhi_gaussian_pairs_source_order_with_tail
    {s₀ s₁ : ℝ} (hs₀ : 0 < s₀) (hs₁ : 0 < s₁)
    (c₀ c₁ x₀ x₁ : ℝ) (H : ℝ → ℝ) :
    (∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₀ : ℝ, ∫ y₁ : ℝ, ∫ r : ℝ,
      |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀ *
        |modelPhiAt s₁ (p₁ + c₁) x₁| * gaussianAt s₁ p₁ y₁ * H r) =
      (∫ r : ℝ, H r) * (∫ w : ℝ, |conePhiPhysicalReal w|) ^ 2 := by
  let R : ℝ := ∫ r : ℝ, H r
  calc
    (∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₀ : ℝ, ∫ y₁ : ℝ, ∫ r : ℝ,
      |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀ *
        |modelPhiAt s₁ (p₁ + c₁) x₁| * gaussianAt s₁ p₁ y₁ * H r) =
        ∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₀ : ℝ, ∫ y₁ : ℝ,
          |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀ *
            |modelPhiAt s₁ (p₁ + c₁) x₁| * gaussianAt s₁ p₁ y₁ * R := by
          apply integral_congr_ae
          filter_upwards [] with p₀
          apply integral_congr_ae
          filter_upwards [] with p₁
          apply integral_congr_ae
          filter_upwards [] with y₀
          apply integral_congr_ae
          filter_upwards [] with y₁
          rw [show (fun r : ℝ ↦
            |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀ *
              |modelPhiAt s₁ (p₁ + c₁) x₁| * gaussianAt s₁ p₁ y₁ * H r) =
              fun r : ℝ ↦
                (|modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀ *
                  |modelPhiAt s₁ (p₁ + c₁) x₁| * gaussianAt s₁ p₁ y₁) * H r by
                funext r
                ring,
            integral_const_mul]
    _ = ∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₀ : ℝ, ∫ y₁ : ℝ,
        R * |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀ *
          |modelPhiAt s₁ (p₁ + c₁) x₁| * gaussianAt s₁ p₁ y₁ := by
          apply integral_congr_ae
          filter_upwards [] with p₀
          apply integral_congr_ae
          filter_upwards [] with p₁
          apply integral_congr_ae
          filter_upwards [] with y₀
          apply integral_congr_ae
          filter_upwards [] with y₁
          ring
    _ = R * (∫ w : ℝ, |conePhiPhysicalReal w|) ^ 2 :=
      integral_two_modelPhi_gaussian_pairs_source_order hs₀ hs₁ c₀ c₁ x₀ x₁ R
    _ = (∫ r : ℝ, H r) * (∫ w : ℝ, |conePhiPhysicalReal w|) ^ 2 := by
      rfl

/-- The inner scalar variables in the reordered second-energy integrand
collapse to the remaining translated third-coordinate square function. -/
theorem modelEnergy_reordered_inner_scalar_reduction
    (α : Anisotropy) (u : E3) (f : E3 → ℝ)
    (x₁ x₂ p₂ t : ℝ) (ht : 0 < t) :
    (∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
      (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
        modelEnergyDensityReordered α u x₁ x₂ t p₀ p₁ y₁ y₂ r) =
      (∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
        (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2) *
        (∫ w : ℝ, |conePhiPhysicalReal w|) ^ 2 := by
  let s₀ : ℝ := t ^ α.weight 0
  let s₁ : ℝ := t ^ α.weight 1
  have hs₀ : 0 < s₀ := by
    dsimp [s₀]
    exact pow_pos ht _
  have hs₁ : 0 < s₁ := by
    dsimp [s₁]
    exact pow_pos ht _
  calc
    (∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
      (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
        modelEnergyDensityReordered α u x₁ x₂ t p₀ p₁ y₁ y₂ r) =
        ∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
          |modelPhiAt s₀ (p₀ + s₀ * u 0) x₁| * gaussianAt s₀ p₀ y₁ *
            |modelPhiAt s₁ (p₁ + s₁ * u 1) x₂| * gaussianAt s₁ p₁ y₂ *
              (|conePsiPhysicalReal (r + u 2)| *
                (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2) := by
          apply integral_congr_ae
          filter_upwards [] with p₀
          apply integral_congr_ae
          filter_upwards [] with p₁
          apply integral_congr_ae
          filter_upwards [] with y₁
          apply integral_congr_ae
          filter_upwards [] with y₂
          apply integral_congr_ae
          filter_upwards [] with r
          dsimp [s₀, s₁]
          unfold modelEnergyDensityReordered
          ring
    _ = (∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
        (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2) *
        (∫ w : ℝ, |conePhiPhysicalReal w|) ^ 2 := by
          exact integral_two_modelPhi_gaussian_pairs_source_order_with_tail
            hs₀ hs₁ (s₀ * u 0) (s₁ * u 1) x₁ x₂
            (fun r : ℝ ↦ |conePsiPhysicalReal (r + u 2)| *
              (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2)

/-- After the scalar inner variables have been removed, Fubini in `(p₂,r)`
and translation reduce the remainder to the centered one-dimensional fiber
square function. -/
theorem modelSecondFiberReduced_p2_r_reduction
    (α : Anisotropy) (u : E3) (f : E3 → ℝ) (x₁ x₂ t : ℝ)
    (hpr : Integrable (fun z : ℝ × ℝ ↦
      (modelSecondFiberReduced α f x₁ x₂ z.1 t z.2) ^ 2 *
        |conePsiPhysicalReal (z.2 + u 2)|)
      ((volume : Measure ℝ).prod volume)) :
    (∫ p₂ : ℝ, ∫ r : ℝ,
      (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
        |conePsiPhysicalReal (r + u 2)|) =
      conePsiPhysicalRealL1 * ∫ q : ℝ,
        (∫ v : ℝ, f (modelPoint x₁ x₂ v) *
          gaussianDerivAt (t ^ α.weight 2) q v) ^ 2 := by
  let B : ℝ → ℝ := fun q ↦ ∫ v : ℝ,
    f (modelPoint x₁ x₂ v) * gaussianDerivAt (t ^ α.weight 2) q v
  have hB : Integrable (fun z : ℝ × ℝ ↦
      B (z.1 + z.2 * t ^ α.weight 2) ^ 2 *
        |conePsiPhysicalReal (z.2 + u 2)|)
      ((volume : Measure ℝ).prod volume) := by
    apply hpr.congr
    filter_upwards [] with z
    rcases z with ⟨p₂, r⟩
    rfl
  simpa only [B, modelSecondFiberReduced] using
    (integral_square_shifted_with_conePsi_of_integrable B
      (t ^ α.weight 2) (u 2) hB)


/-- Fubini in the exact five-variable nesting of `ScratchModelEnergyInner`.
This is the bridge from the coordinate reordering's product measure to the
scalar calculation in `integral_modelEnergy_reordered_inner_scalar_reduction`. -/
theorem integral_ScratchModelEnergyInner_eq_nested
    (H : ScratchModelEnergyInner → ℝ)
    (hH : Integrable H
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))) :
    (∫ z : ScratchModelEnergyInner, H z
      ∂(((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))) =
      ∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
        H ((p₀, p₁), (y₁, (y₂, r))) := by
  let μ₀₁ : Measure (ℝ × ℝ) := (volume : Measure ℝ).prod volume
  let μ₁₂r : Measure (ℝ × (ℝ × ℝ)) :=
    (volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)
  let K : ℝ × ℝ → ℝ := fun a ↦
    ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ, H (a, (y₁, (y₂, r)))
  have htriple (a : ℝ × ℝ)
      (ha : Integrable (fun b : ℝ × (ℝ × ℝ) ↦ H (a, b)) μ₁₂r) :
      (∫ b : ℝ × (ℝ × ℝ), H (a, b) ∂μ₁₂r) = K a := by
    calc
      (∫ b : ℝ × (ℝ × ℝ), H (a, b) ∂μ₁₂r) =
          ∫ y₁ : ℝ, ∫ q : ℝ × ℝ, H (a, (y₁, q)) := by
            exact integral_prod _ ha
      _ = ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
          H (a, (y₁, (y₂, r))) := by
            apply integral_congr_ae
            filter_upwards [ha.prod_right_ae] with y₁ hy₁
            exact integral_prod _ hy₁
      _ = K a := by rfl
  have hK : Integrable K μ₀₁ := by
    have hleft := hH.integral_prod_left
    apply hleft.congr
    filter_upwards [hH.prod_right_ae] with a ha
    exact htriple a ha
  calc
    (∫ z : ScratchModelEnergyInner, H z ∂(μ₀₁.prod μ₁₂r)) =
        ∫ a : ℝ × ℝ, ∫ b : ℝ × (ℝ × ℝ), H (a, b) ∂μ₁₂r :=
      integral_prod _ hH
    _ = ∫ a : ℝ × ℝ, K a := by
      apply integral_congr_ae
      filter_upwards [hH.prod_right_ae] with a ha
      exact htriple a ha
    _ = ∫ p₀ : ℝ, ∫ p₁ : ℝ, K (p₀, p₁) :=
      integral_prod _ hK
    _ = ∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
        H ((p₀, p₁), (y₁, (y₂, r))) := by rfl

/-- The analogous four-variable Fubini expansion for the outer coordinates
`(x₁,x₂,p₂,t)`, retaining an arbitrary scale measure. -/
theorem integral_ScratchModelEnergyOuter_eq_nested
    (ν : Measure ℝ) [SFinite ν] (H : ScratchModelEnergyOuter → ℝ)
    (hH : Integrable H
      (((volume : Measure ℝ).prod volume).prod ((volume : Measure ℝ).prod ν))) :
    (∫ z : ScratchModelEnergyOuter, H z
      ∂(((volume : Measure ℝ).prod volume).prod ((volume : Measure ℝ).prod ν))) =
      ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ p₂ : ℝ, ∫ t : ℝ,
        H ((x₁, x₂), (p₂, t)) ∂ν := by
  let μx : Measure (ℝ × ℝ) := (volume : Measure ℝ).prod volume
  let μpt : Measure (ℝ × ℝ) := (volume : Measure ℝ).prod ν
  let K : ℝ × ℝ → ℝ := fun x ↦
    ∫ p₂ : ℝ, ∫ t : ℝ, H (x, (p₂, t)) ∂ν
  have hpair (x : ℝ × ℝ)
      (hx : Integrable (fun pt : ℝ × ℝ ↦ H (x, pt)) μpt) :
      (∫ pt : ℝ × ℝ, H (x, pt) ∂μpt) = K x := by
    calc
      (∫ pt : ℝ × ℝ, H (x, pt) ∂μpt) =
          ∫ p₂ : ℝ, ∫ t : ℝ, H (x, (p₂, t)) ∂ν :=
        integral_prod _ hx
      _ = K x := by rfl
  have hK : Integrable K μx := by
    have hleft := hH.integral_prod_left
    apply hleft.congr
    filter_upwards [hH.prod_right_ae] with x hx
    exact hpair x hx
  calc
    (∫ z : ScratchModelEnergyOuter, H z ∂(μx.prod μpt)) =
        ∫ x : ℝ × ℝ, ∫ pt : ℝ × ℝ, H (x, pt) ∂μpt :=
      integral_prod _ hH
    _ = ∫ x : ℝ × ℝ, K x := by
      apply integral_congr_ae
      filter_upwards [hH.prod_right_ae] with x hx
      exact hpair x hx
    _ = ∫ x₁ : ℝ, ∫ x₂ : ℝ, K (x₁, x₂) :=
      integral_prod _ hK
    _ = ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ p₂ : ℝ, ∫ t : ℝ,
        H ((x₁, x₂), (p₂, t)) ∂ν := by rfl

/-- Joint integrability transports the global second energy to the literal
nine scalar coordinates.  This is the exact Tonelli bridge before the
scalar mass and one-dimensional square-function reductions. -/
theorem modelEnergyTwoOn_eq_reordered_nested
    (α : Anisotropy) (u : E3) (f : E3 → ℝ)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyTwoIntegrand α u f q.1 q.2)
      ((cubeScaleMeasure.restrict (Set.univ ×ˢ Set.Ioi (0 : ℝ))).prod volume)) :
    modelEnergyTwoOn α (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f =
      ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ p₂ : ℝ,
        ∫ t : ℝ in Set.Ioi (0 : ℝ),
          (∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
            (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
              modelEnergyDensityReordered α u x₁ x₂ t p₀ p₁ y₁ y₂ r
          ) ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
  let ν : Measure ℝ :=
    (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
      (Set.Ioi (0 : ℝ)))
  let G : (E3 × ℝ) × ModelE5 → ℝ := fun q ↦
    modelEnergyTwoIntegrand α u f q.1 q.2
  let μouter : Measure ScratchModelEnergyOuter :=
    ((volume : Measure ℝ).prod volume).prod ((volume : Measure ℝ).prod ν)
  let μinner : Measure ScratchModelEnergyInner :=
    ((volume : Measure ℝ).prod volume).prod
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))
  have hjoint' : Integrable G (((volume : Measure E3).prod ν).prod volume) := by
    simpa only [G, ν, cubeScaleMeasure_restrict_global_eq] using hjoint
  have htrans : Integrable (fun w : ScratchModelEnergyOuter × ScratchModelEnergyInner ↦
      G (modelEnergyCoordinateReorder.symm w)) (μouter.prod μinner) := by
    have hmp := modelEnergyCoordinateReorder_measurePreserving_scale ν
    exact (MeasurePreserving.symm modelEnergyCoordinateReorder hmp).integrable_comp_of_integrable
      hjoint'
  let K : ScratchModelEnergyOuter → ℝ := fun w ↦
    ∫ v : ScratchModelEnergyInner,
      G (modelEnergyCoordinateReorder.symm (w, v)) ∂μinner
  have hK : Integrable K μouter := by
    exact htrans.integral_prod_left
  let L : ScratchModelEnergyOuter → ℝ := fun w ↦
    ∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
      (modelSecondFiberReduced α f w.1.1 w.1.2 w.2.1 w.2.2 r) ^ 2 *
        modelEnergyDensityReordered α u w.1.1 w.1.2 w.2.2
          p₀ p₁ y₁ y₂ r
  have hKL : K =ᵐ[μouter] L := by
    filter_upwards [htrans.prod_right_ae] with w hw
    dsimp [K, L]
    calc
      (∫ v : ScratchModelEnergyInner,
        G (modelEnergyCoordinateReorder.symm (w, v)) ∂μinner) =
          ∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
            G (modelEnergyCoordinateReorder.symm
              (w, ((p₀, p₁), (y₁, (y₂, r))))) := by
              exact integral_ScratchModelEnergyInner_eq_nested _ hw
      _ = ∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
          (modelSecondFiberReduced α f w.1.1 w.1.2 w.2.1 w.2.2 r) ^ 2 *
            modelEnergyDensityReordered α u w.1.1 w.1.2 w.2.2
              p₀ p₁ y₁ y₂ r := by
            apply integral_congr_ae
            filter_upwards [] with p₀
            apply integral_congr_ae
            filter_upwards [] with p₁
            apply integral_congr_ae
            filter_upwards [] with y₁
            apply integral_congr_ae
            filter_upwards [] with y₂
            apply integral_congr_ae
            filter_upwards [] with r
            rcases w with ⟨⟨x₁, x₂⟩, ⟨p₂, t⟩⟩
            exact modelEnergyTwoIntegrand_reorder_symm
              α u f x₁ x₂ p₂ t p₀ p₁ y₁ y₂ r
  have hL : Integrable L μouter := hK.congr hKL
  calc
    modelEnergyTwoOn α (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f =
        ∫ q : (E3 × ℝ) × ModelE5, G q
          ∂(((volume : Measure E3).prod ν).prod volume) := by
            rw [modelEnergyTwoOn_eq_jointIntegral_of_integrable α
              (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f hjoint]
            simp only [G, ν, cubeScaleMeasure_restrict_global_eq]
    _ = ∫ w : ScratchModelEnergyOuter, K w ∂μouter := by
          exact integral_modelEnergyCoordinateReorder_fubini ν G hjoint'
    _ = ∫ w : ScratchModelEnergyOuter, L w ∂μouter := by
          exact integral_congr_ae hKL
    _ = ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ p₂ : ℝ,
        ∫ t : ℝ, L ((x₁, x₂), (p₂, t)) ∂ν := by
          exact integral_ScratchModelEnergyOuter_eq_nested ν L hL
    _ = ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ p₂ : ℝ,
        ∫ t : ℝ in Set.Ioi (0 : ℝ),
          (∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
            (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
              modelEnergyDensityReordered α u x₁ x₂ t p₀ p₁ y₁ y₂ r
          ) ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
          dsimp [ν, L]

/-- After the harmless scalar variables have been removed, the remaining
positive-scale integral is the global third-coordinate square function.
The two hypotheses are precisely the product-Fubini condition and the
fixed-fiber translation condition used by the scalar reductions. -/
theorem reordered_scalar_energy_eq_global_L2
    (α : Anisotropy) (u : E3) (f : SchwartzMap E3 ℝ)
    (hscalar : Integrable (fun w : ScratchModelEnergyOuter ↦
      (∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
        (modelSecondFiberReduced α f w.1.1 w.1.2 w.2.1 w.2.2 r) ^ 2) *
        (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2)
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod
          (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
            (Set.Ioi (0 : ℝ))))))
    (hpr : ∀ (x₁ x₂ t : ℝ), 0 < t → Integrable (fun z : ℝ × ℝ ↦
      (modelSecondFiberReduced α f x₁ x₂ z.1 t z.2) ^ 2 *
        |conePsiPhysicalReal (z.2 + u 2)|)
      ((volume : Measure ℝ).prod volume)) :
    (∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ p₂ : ℝ,
      ∫ t : ℝ in Set.Ioi (0 : ℝ),
        ((∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
          (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2) *
          (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2)
        ∂((volume : Measure ℝ).withDensity cubeScaleDensity)) =
      (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 *
        conePsiPhysicalRealL1 * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ x : E3, f x ^ 2 := by
  let ν : Measure ℝ :=
    ((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
      (Set.Ioi (0 : ℝ))
  let A : ℝ := (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2
  let P : ℝ := conePsiPhysicalRealL1
  let Q : ℝ → ℝ → ℝ → ℝ := fun x₁ x₂ t ↦
    ∫ q : ℝ, (∫ v : ℝ, f (modelPoint x₁ x₂ v) *
      gaussianDerivAt (t ^ α.weight 2) q v) ^ 2
  let H : ScratchModelEnergyOuter → ℝ := fun w ↦
    A * ∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
      (modelSecondFiberReduced α f w.1.1 w.1.2 w.2.1 w.2.2 r) ^ 2
  have hH : Integrable H
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ν)) := by
    apply hscalar.congr
    filter_upwards [] with w
    dsimp [H, A]
    ring
  have hswap (x : ℝ × ℝ)
      (hx : Integrable (fun pt : ℝ × ℝ ↦ H (x, pt))
        ((volume : Measure ℝ).prod ν)) :
      (∫ p₂ : ℝ, ∫ t : ℝ, H (x, (p₂, t)) ∂ν) =
        ∫ t : ℝ, (∫ p₂ : ℝ, H (x, (p₂, t))) ∂ν := by
    have hx' : Integrable (Function.uncurry
        (fun p₂ : ℝ ↦ fun t : ℝ ↦ H (x, (p₂, t))))
        ((volume : Measure ℝ).prod ν) := by
      apply hx.congr
      filter_upwards [] with pt
      rcases pt with ⟨p₂, t⟩
      rfl
    simpa only using (integral_integral_swap hx')
  let J : ℝ × ℝ → ℝ := fun x ↦
    ∫ t : ℝ, (∫ p₂ : ℝ, H (x, (p₂, t))) ∂ν
  have hJ : Integrable J ((volume : Measure ℝ).prod volume) := by
    have hleft := hH.integral_prod_left
    apply hleft.congr
    filter_upwards [hH.prod_right_ae] with x hx
    calc
      (∫ pt : ℝ × ℝ, H (x, pt) ∂((volume : Measure ℝ).prod ν)) =
          ∫ p₂ : ℝ, ∫ t : ℝ, H (x, (p₂, t)) ∂ν :=
        integral_prod _ hx
      _ = J x := hswap x hx
  have hJvalue (x₁ x₂ : ℝ) :
      J (x₁, x₂) =
        A * P * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ v : ℝ, f (modelPoint x₁ x₂ v) ^ 2 := by
    dsimp [J, ν]
    change (∫ t : ℝ in Set.Ioi (0 : ℝ),
      (∫ p₂ : ℝ, H ((x₁, x₂), (p₂, t)))
      ∂((volume : Measure ℝ).withDensity cubeScaleDensity)) = _
    calc
      (∫ t : ℝ in Set.Ioi (0 : ℝ),
        (∫ p₂ : ℝ, H ((x₁, x₂), (p₂, t)))
        ∂((volume : Measure ℝ).withDensity cubeScaleDensity)) =
          ∫ t : ℝ in Set.Ioi (0 : ℝ), A * (P * Q x₁ x₂ t)
            ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
            apply setIntegral_congr_fun measurableSet_Ioi
            intro t ht
            dsimp [H]
            rw [integral_const_mul]
            calc
              A * ∫ p₂ : ℝ, ∫ r : ℝ,
                |conePsiPhysicalReal (r + u 2)| *
                  (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 =
                  A * ∫ p₂ : ℝ, ∫ r : ℝ,
                    (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
                      |conePsiPhysicalReal (r + u 2)| := by
                        congr 1
                        apply integral_congr_ae
                        filter_upwards [] with p₂
                        apply integral_congr_ae
                        filter_upwards [] with r
                        ring
              _ = A * (P * Q x₁ x₂ t) := by
                    rw [show (∫ p₂ : ℝ, ∫ r : ℝ,
                      (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
                        |conePsiPhysicalReal (r + u 2)|) = P * Q x₁ x₂ t by
                      dsimp [P, Q]
                      exact modelSecondFiberReduced_p2_r_reduction α u f x₁ x₂ t
                        (hpr x₁ x₂ t ht)]
      _ = ∫ t : ℝ in Set.Ioi (0 : ℝ),
          (A * P * Q x₁ x₂ t)
            ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
            apply setIntegral_congr_fun measurableSet_Ioi
            intro t ht
            ring
      _ = ∫ t : ℝ in Set.Ioi (0 : ℝ),
          (A * P * Q x₁ x₂ t) / t := by
            exact integral_Ioi_withDensity_cubeScaleDensity_eq
              (fun t : ℝ ↦ A * P * Q x₁ x₂ t)
      _ = A * P * ∫ t : ℝ in Set.Ioi (0 : ℝ), Q x₁ x₂ t / t := by
            rw [show (fun t : ℝ ↦ (A * P * Q x₁ x₂ t) / t) =
              fun t : ℝ ↦ (A * P) * (Q x₁ x₂ t / t) by
                funext t
                ring,
              integral_const_mul]
      _ = A * P * ((Real.pi / (α.weight 2 : ℝ)) *
          ∫ v : ℝ, f (modelPoint x₁ x₂ v) ^ 2) := by
            rw [show (∫ t : ℝ in Set.Ioi (0 : ℝ), Q x₁ x₂ t / t) =
              ∫ t : ℝ in Set.Ioi (0 : ℝ), ∫ q : ℝ,
                (∫ v : ℝ, f (modelPoint x₁ x₂ v) *
                  gaussianDerivAt (t ^ α.weight 2) q v) ^ 2 / t by
                apply setIntegral_congr_fun measurableSet_Ioi
                intro t ht
                dsimp [Q]
                rw [integral_div],
              modelThird_square_function_of_real_schwartz α f x₁ x₂]
      _ = A * P * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ v : ℝ, f (modelPoint x₁ x₂ v) ^ 2 := by ring
  have hfsq : Integrable (fun x : E3 ↦ f x ^ 2) := by
    exact (memLp_two_iff_integrable_sq
      f.continuous.aestronglyMeasurable).mp (f.memLp 2 volume)
  calc
    (∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ p₂ : ℝ,
      ∫ t : ℝ in Set.Ioi (0 : ℝ),
        ((∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
          (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2) *
          (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2)
        ∂((volume : Measure ℝ).withDensity cubeScaleDensity)) =
        ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ p₂ : ℝ,
          ∫ t : ℝ in Set.Ioi (0 : ℝ),
            H ((x₁, x₂), (p₂, t))
            ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
            dsimp [H, A, ν]
            apply integral_congr_ae
            filter_upwards [] with x₁
            apply integral_congr_ae
            filter_upwards [] with x₂
            apply integral_congr_ae
            filter_upwards [] with p₂
            apply integral_congr_ae
            filter_upwards [] with t
            ring
    _ = ∫ w : ScratchModelEnergyOuter, H w
        ∂(((volume : Measure ℝ).prod volume).prod
          ((volume : Measure ℝ).prod ν)) := by
          exact (integral_ScratchModelEnergyOuter_eq_nested ν H hH).symm
    _ = ∫ x : ℝ × ℝ, ∫ pt : ℝ × ℝ, H (x, pt)
        ∂((volume : Measure ℝ).prod ν) := by
          exact integral_prod _ hH
    _ = ∫ x : ℝ × ℝ, J x := by
          apply integral_congr_ae
          filter_upwards [hH.prod_right_ae] with x hx
          calc
            (∫ pt : ℝ × ℝ, H (x, pt)
              ∂((volume : Measure ℝ).prod ν)) =
                ∫ p₂ : ℝ, ∫ t : ℝ, H (x, (p₂, t)) ∂ν :=
              integral_prod _ hx
            _ = J x := hswap x hx
    _ = ∫ x₁ : ℝ, ∫ x₂ : ℝ, J (x₁, x₂) := by
          exact integral_prod _ hJ
    _ = ∫ x₁ : ℝ, ∫ x₂ : ℝ,
        A * P * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ v : ℝ, f (modelPoint x₁ x₂ v) ^ 2 := by
          apply integral_congr_ae
          filter_upwards [] with x₁
          apply integral_congr_ae
          filter_upwards [] with x₂
          exact hJvalue x₁ x₂
    _ = A * P * (Real.pi / (α.weight 2 : ℝ)) *
        ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ v : ℝ,
          f (modelPoint x₁ x₂ v) ^ 2 := by
          let C : ℝ := A * P * (Real.pi / (α.weight 2 : ℝ))
          calc
            (∫ x₁ : ℝ, ∫ x₂ : ℝ,
              A * P * (Real.pi / (α.weight 2 : ℝ)) *
                ∫ v : ℝ, f (modelPoint x₁ x₂ v) ^ 2) =
                ∫ x₁ : ℝ, ∫ x₂ : ℝ,
                  C * ∫ v : ℝ, f (modelPoint x₁ x₂ v) ^ 2 := by
                    apply integral_congr_ae
                    filter_upwards [] with x₁
                    apply integral_congr_ae
                    filter_upwards [] with x₂
                    rfl
            _ = ∫ x₁ : ℝ, C * (∫ x₂ : ℝ, ∫ v : ℝ,
                f (modelPoint x₁ x₂ v) ^ 2) := by
                  apply integral_congr_ae
                  filter_upwards [] with x₁
                  rw [integral_const_mul]
            _ = C * ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ v : ℝ,
                f (modelPoint x₁ x₂ v) ^ 2 := by
                  rw [integral_const_mul]
            _ = A * P * (Real.pi / (α.weight 2 : ℝ)) *
                ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ v : ℝ,
                  f (modelPoint x₁ x₂ v) ^ 2 := by
                    rfl
    _ = A * P * (Real.pi / (α.weight 2 : ℝ)) *
        ∫ x : E3, f x ^ 2 := by
          rw [integral_modelPoint_sq_eq f hfsq]
    _ = (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 *
        conePsiPhysicalRealL1 * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ x : E3, f x ^ 2 := by
          rfl

/-- Conditional full form of the blueprint's global second-energy identity
for a real Schwartz input.  The hypotheses are exactly the two unresolved
global integrability discharges: the original joint density and the scalar
post-Tonelli `(x₁,x₂,p₂,t)` density. -/
theorem modelEnergyTwoOn_global_eq_of_real_schwartz
    (α : Anisotropy) (u : E3) (f : SchwartzMap E3 ℝ)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyTwoIntegrand α u f q.1 q.2)
      ((cubeScaleMeasure.restrict (Set.univ ×ˢ Set.Ioi (0 : ℝ))).prod volume))
    (hscalar : Integrable (fun w : ScratchModelEnergyOuter ↦
      (∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
        (modelSecondFiberReduced α f w.1.1 w.1.2 w.2.1 w.2.2 r) ^ 2) *
        (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2)
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod
          (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
            (Set.Ioi (0 : ℝ))))))
    (hpr : ∀ (x₁ x₂ t : ℝ), 0 < t → Integrable (fun z : ℝ × ℝ ↦
      (modelSecondFiberReduced α f x₁ x₂ z.1 t z.2) ^ 2 *
        |conePsiPhysicalReal (z.2 + u 2)|)
      ((volume : Measure ℝ).prod volume)) :
    modelEnergyTwoOn α (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f =
      (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 *
        conePsiPhysicalRealL1 * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ x : E3, f x ^ 2 := by
  calc
    modelEnergyTwoOn α (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f =
      ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ p₂ : ℝ,
        ∫ t : ℝ in Set.Ioi (0 : ℝ),
          (∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
            (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
              modelEnergyDensityReordered α u x₁ x₂ t p₀ p₁ y₁ y₂ r)
          ∂((volume : Measure ℝ).withDensity cubeScaleDensity) :=
      modelEnergyTwoOn_eq_reordered_nested α u f hjoint
    _ = ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ p₂ : ℝ,
        ∫ t : ℝ in Set.Ioi (0 : ℝ),
          ((∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
            (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2) *
            (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2)
          ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
            apply integral_congr_ae
            filter_upwards [] with x₁
            apply integral_congr_ae
            filter_upwards [] with x₂
            apply integral_congr_ae
            filter_upwards [] with p₂
            apply setIntegral_congr_fun measurableSet_Ioi
            intro t ht
            exact modelEnergy_reordered_inner_scalar_reduction
              α u f x₁ x₂ p₂ t ht
    _ = (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 *
        conePsiPhysicalRealL1 * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ x : E3, f x ^ 2 :=
      reordered_scalar_energy_eq_global_L2 α u f hscalar hpr

/-- The post-scalar outer density is integrable whenever the original global
joint energy density is integrable.  Thus the only genuinely new analytic
condition in the terminal square-function calculation is the fixed-fiber
translation integrability. -/
theorem integrable_reordered_scalar_of_joint
    (α : Anisotropy) (u : E3) (f : E3 → ℝ)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyTwoIntegrand α u f q.1 q.2)
      ((cubeScaleMeasure.restrict (Set.univ ×ˢ Set.Ioi (0 : ℝ))).prod volume)) :
    Integrable (fun w : ScratchModelEnergyOuter ↦
      (∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
        (modelSecondFiberReduced α f w.1.1 w.1.2 w.2.1 w.2.2 r) ^ 2) *
        (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2)
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod
          (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
            (Set.Ioi (0 : ℝ))))) := by
  let ν : Measure ℝ :=
    ((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
      (Set.Ioi (0 : ℝ))
  let G : (E3 × ℝ) × ModelE5 → ℝ := fun q ↦
    modelEnergyTwoIntegrand α u f q.1 q.2
  let μouter : Measure ScratchModelEnergyOuter :=
    ((volume : Measure ℝ).prod volume).prod ((volume : Measure ℝ).prod ν)
  let μinner : Measure ScratchModelEnergyInner :=
    ((volume : Measure ℝ).prod volume).prod
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))
  have hjoint' : Integrable G (((volume : Measure E3).prod ν).prod volume) := by
    simpa only [G, ν, cubeScaleMeasure_restrict_global_eq] using hjoint
  have htrans : Integrable (fun w : ScratchModelEnergyOuter × ScratchModelEnergyInner ↦
      G (modelEnergyCoordinateReorder.symm w)) (μouter.prod μinner) := by
    have hmp := modelEnergyCoordinateReorder_measurePreserving_scale ν
    exact (MeasurePreserving.symm modelEnergyCoordinateReorder hmp).integrable_comp_of_integrable
      hjoint'
  let K : ScratchModelEnergyOuter → ℝ := fun w ↦
    ∫ v : ScratchModelEnergyInner,
      G (modelEnergyCoordinateReorder.symm (w, v)) ∂μinner
  have hK : Integrable K μouter := htrans.integral_prod_left
  have htν : ∀ᵐ t : ℝ ∂ν, 0 < t := by
    dsimp [ν]
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    exact ht
  have htpt : ∀ᵐ pt : ℝ × ℝ ∂((volume : Measure ℝ).prod ν), 0 < pt.2 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [] with p₂
      exact htν
    · exact measurableSet_Ioi.preimage measurable_snd
  have htouter : ∀ᵐ w : ScratchModelEnergyOuter ∂μouter, 0 < w.2.2 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [] with x
      exact htpt
    · exact measurableSet_Ioi.preimage (measurable_snd.comp measurable_snd)
  let H : ScratchModelEnergyOuter → ℝ := fun w ↦
    (∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
      (modelSecondFiberReduced α f w.1.1 w.1.2 w.2.1 w.2.2 r) ^ 2) *
        (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2
  have hKH : K =ᵐ[μouter] H := by
    filter_upwards [htrans.prod_right_ae, htouter] with w hw ht
    dsimp [K, H]
    calc
      (∫ v : ScratchModelEnergyInner,
        G (modelEnergyCoordinateReorder.symm (w, v)) ∂μinner) =
          ∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
            G (modelEnergyCoordinateReorder.symm
              (w, ((p₀, p₁), (y₁, (y₂, r))))) := by
              exact integral_ScratchModelEnergyInner_eq_nested _ hw
      _ = ∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
          (modelSecondFiberReduced α f w.1.1 w.1.2 w.2.1 w.2.2 r) ^ 2 *
            modelEnergyDensityReordered α u w.1.1 w.1.2 w.2.2
              p₀ p₁ y₁ y₂ r := by
            apply integral_congr_ae
            filter_upwards [] with p₀
            apply integral_congr_ae
            filter_upwards [] with p₁
            apply integral_congr_ae
            filter_upwards [] with y₁
            apply integral_congr_ae
            filter_upwards [] with y₂
            apply integral_congr_ae
            filter_upwards [] with r
            rcases w with ⟨⟨x₁, x₂⟩, ⟨p₂, t⟩⟩
            exact modelEnergyTwoIntegrand_reorder_symm
              α u f x₁ x₂ p₂ t p₀ p₁ y₁ y₂ r
      _ = (∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
          (modelSecondFiberReduced α f w.1.1 w.1.2 w.2.1 w.2.2 r) ^ 2) *
          (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 := by
            rcases w with ⟨⟨x₁, x₂⟩, ⟨p₂, t⟩⟩
            exact modelEnergy_reordered_inner_scalar_reduction
              α u f x₁ x₂ p₂ t ht
  simpa only [H, ν] using hK.congr hKH
/-- Source-facing conditional global second-energy identity.  All Tonelli
and scalar-mass side conditions are discharged from `hjoint`; only the
fixed-fiber translation integrability remains as an explicit analytic
hypothesis. -/
theorem modelEnergyTwoOn_global_eq_of_joint_and_fixedFiber
    (α : Anisotropy) (u : E3) (f : SchwartzMap E3 ℝ)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyTwoIntegrand α u f q.1 q.2)
      ((cubeScaleMeasure.restrict (Set.univ ×ˢ Set.Ioi (0 : ℝ))).prod volume))
    (hpr : ∀ (x₁ x₂ t : ℝ), 0 < t → Integrable (fun z : ℝ × ℝ ↦
      (modelSecondFiberReduced α f x₁ x₂ z.1 t z.2) ^ 2 *
        |conePsiPhysicalReal (z.2 + u 2)|)
      ((volume : Measure ℝ).prod volume)) :
    modelEnergyTwoOn α (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f =
      (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 *
        conePsiPhysicalRealL1 * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ x : E3, f x ^ 2 := by
  exact modelEnergyTwoOn_global_eq_of_real_schwartz α u f hjoint
    (integrable_reordered_scalar_of_joint α u f hjoint) hpr

/-- The standard integer lattice in the three frequency coordinates. -/
def standardModeLattice : Submodule ℤ E3 :=
  Submodule.span ℤ (Set.range (PiLp.basisFun 2 ℝ (Fin 3)))

local instance : DiscreteTopology standardModeLattice := by
  change DiscreteTopology (Submodule.span ℤ
    (Set.range (PiLp.basisFun 2 ℝ (Fin 3))))
  infer_instance

local instance : IsZLattice ℝ standardModeLattice := by
  change IsZLattice ℝ (Submodule.span ℤ
    (Set.range (PiLp.basisFun 2 ℝ (Fin 3))))
  infer_instance

theorem standardModeLattice_rank :
    Module.finrank ℤ standardModeLattice = 3 := by
  rw [ZLattice.rank ℝ]
  exact finrank_euclideanSpace_fin

theorem summable_standardMode_norm_inv :
    Summable (fun z : standardModeLattice ↦
      if z = 0 then (1 : ℝ) else ‖(z : E3)‖⁻¹ ^ (10 : ℕ)) := by
  have hbase := ZLattice.summable_norm_pow_inv standardModeLattice 10 (by
    rw [standardModeLattice_rank]
    norm_num)
  have hdelta : Summable (fun z : standardModeLattice ↦
      if z = 0 then (1 : ℝ) else 0) := by
    apply summable_of_hasFiniteSupport
    rw [Function.HasFiniteSupport]
    refine (Set.finite_singleton (0 : standardModeLattice)).subset ?_
    intro z hz
    rw [Set.mem_singleton_iff]
    by_contra hzero
    simp [Function.mem_support, hzero] at hz
  refine (hdelta.add hbase).congr ?_
  intro z
  by_cases hz : z = 0
  · simp [hz]
  · simp [hz]

theorem summable_standardMode_one_add_norm_inv :
    Summable (fun z : standardModeLattice ↦
      (1 + ‖(z : E3)‖)⁻¹ ^ (10 : ℕ)) := by
  apply summable_standardMode_norm_inv.of_nonneg_of_le
  · intro z
    positivity
  · intro z
    by_cases hz : z = 0
    · subst z
      simp
    · rw [if_neg hz]
      have hnorm : 0 < ‖(z : E3)‖ := by
        apply norm_pos_iff.mpr
        intro hzero
        apply hz
        exact Subtype.ext hzero
      have hinv : (1 + ‖(z : E3)‖)⁻¹ ≤ ‖(z : E3)‖⁻¹ := by
        exact (inv_le_inv₀ (by linarith) hnorm).mpr (by linarith)
      exact pow_le_pow_left₀ (by positivity) hinv _

theorem norm_le_coordinate_l1 (x : E3) :
    ‖x‖ ≤ |x 0| + |x 1| + |x 2| := by
  have hdir (i : Fin 3) : ‖Anisotropy.coordinateDirection i‖ = 1 := by
    simpa only [Anisotropy.coordinateDirection] using
      (EuclideanSpace.basisFun (Fin 3) ℝ).norm_eq_one i
  have hdecomp : x =
      x 0 • Anisotropy.coordinateDirection 0 +
        x 1 • Anisotropy.coordinateDirection 1 +
          x 2 • Anisotropy.coordinateDirection 2 := by
    ext i
    fin_cases i <;> simp [coordinateDirection_apply]
  calc
    ‖x‖ = ‖x 0 • Anisotropy.coordinateDirection 0 +
        x 1 • Anisotropy.coordinateDirection 1 +
          x 2 • Anisotropy.coordinateDirection 2‖ := congrArg norm hdecomp
    _ ≤
        ‖x 0 • Anisotropy.coordinateDirection 0‖ +
          ‖x 1 • Anisotropy.coordinateDirection 1‖ +
            ‖x 2 • Anisotropy.coordinateDirection 2‖ := by
      exact norm_add_le_of_le (norm_add_le _ _) (le_refl _)
    _ = |x 0| + |x 1| + |x 2| := by
      simp only [norm_smul, hdir, mul_one, Real.norm_eq_abs]

theorem one_add_norm_le_sourceWeight (x : E3) :
    1 + ‖x‖ ≤ sourceWeight x := by
  unfold sourceWeight
  linarith [norm_le_coordinate_l1 x]

theorem summable_standardMode_sourceWeight_inv :
    Summable (fun z : standardModeLattice ↦
      (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ)) := by
  apply summable_standardMode_one_add_norm_inv.of_nonneg_of_le
  · intro z
    positivity
  · intro z
    have hweight : 1 + ‖(z : E3)‖ ≤ sourceWeight (z : E3) :=
      one_add_norm_le_sourceWeight (z : E3)
    have hposNorm : 0 < 1 + ‖(z : E3)‖ := by positivity
    have hposWeight : 0 < sourceWeight (z : E3) := by
      unfold sourceWeight
      positivity
    have hinv : (sourceWeight (z : E3))⁻¹ ≤ (1 + ‖(z : E3)‖)⁻¹ := by
      exact (inv_le_inv₀ hposWeight hposNorm).mpr hweight
    exact pow_le_pow_left₀ (by positivity) hinv _

/-- The low-frequency Calderón cutoff is nonnegative. -/
theorem conePhi_nonneg (x : ℝ) :
    0 ≤ conePhi x := by
  by_cases hx : |x| ≤ 2
  · rw [conePhi_eq_tail]
    exact intervalIntegral.integral_nonneg hx fun y hy ↦
      coneWeight_nonneg_of_nonneg (le_trans (abs_nonneg x) hy.1)
  · have hx' : 2 ≤ |x| := le_of_lt (lt_of_not_ge hx)
    rw [conePhi_eq_zero_of_two_le_abs hx']

/-- The low-frequency cutoff never exceeds its positive Calderón mass. -/
theorem conePhi_le_cPsi (x : ℝ) :
    conePhi x ≤ cPsi := by
  by_cases hx : |x| ≤ 2
  · rw [conePhi_eq_tail, cPsi]
    apply intervalIntegral.integral_mono_interval (c := (0 : ℝ)) (d := 2)
      (by positivity) hx (by norm_num) ?_
      (coneWeight_contDiff.continuous.intervalIntegrable _ _)
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with y hy
    exact coneWeight_nonneg_of_nonneg hy.1.le
  · have hx' : 2 ≤ |x| := le_of_lt (lt_of_not_ge hx)
    rw [conePhi_eq_zero_of_two_le_abs hx']
    exact le_of_lt cPsi_pos

/-- The smooth primitive differentiates to the Calderón density. -/
theorem hasDerivAt_conePrimitive (x : ℝ) :
    HasDerivAt conePrimitive (coneWeight x) x := by
  unfold conePrimitive
  exact intervalIntegral.integral_hasDerivAt_right
    (coneWeight_contDiff.continuous.intervalIntegrable _ _)
    coneWeight_contDiff.continuous.aestronglyMeasurable.stronglyMeasurableAtFilter
    coneWeight_contDiff.continuous.continuousAt

/-- The derivative of the low-frequency cutoff is the negative Calderón
density, including at the removable origin. -/
theorem hasDerivAt_conePhi (x : ℝ) :
    HasDerivAt conePhi (-coneWeight x) x := by
  unfold conePhi
  have hfun : (fun y : ℝ ↦ cPsi - conePrimitive y) =
      (fun _ : ℝ ↦ cPsi) - conePrimitive := by
    funext y
    rfl
  rw [hfun]
  simpa using (hasDerivAt_const x cPsi).sub (hasDerivAt_conePrimitive x)

theorem deriv_conePhi (x : ℝ) :
    deriv conePhi x = -coneWeight x :=
  (hasDerivAt_conePhi x).deriv

/-- The one-dimensional differential Calderón identity at an anisotropic
natural scale. -/
theorem neg_mul_deriv_conePhi_nat_scale
    (n : ℕ) (hn : 0 < n) (ξ t : ℝ) (hξ : ξ ≠ 0) (ht : 0 < t) :
    -t * deriv (fun s : ℝ ↦ conePhi (s ^ n * ξ)) t =
      (n : ℝ) * conePsi (t ^ n * ξ) * gaussianDeriv (t ^ n * ξ) ^ 2 := by
  have hpow : HasDerivAt (fun s : ℝ ↦ s ^ n * ξ)
      ((n : ℝ) * t ^ (n - 1) * ξ) t := by
    convert (hasDerivAt_pow n t).mul_const ξ using 1
  have hcomp := (hasDerivAt_conePhi (t ^ n * ξ)).comp t hpow
  have hderiv : deriv (fun s : ℝ ↦ conePhi (s ^ n * ξ)) t =
      (-coneWeight (t ^ n * ξ)) * ((n : ℝ) * t ^ (n - 1) * ξ) :=
    hcomp.deriv
  rw [hderiv]
  have htn : t ^ n * ξ ≠ 0 := mul_ne_zero (pow_ne_zero _ ht.ne') hξ
  have hpow' : t * t ^ (n - 1) = t ^ n := by
    calc
      t * t ^ (n - 1) = t ^ (n - 1) * t := by ring
      _ = t ^ ((n - 1) + 1) := (pow_succ t (n - 1)).symm
      _ = t ^ n := by congr 1 ; omega
  rw [coneWeight_eq_source_integrand htn]
  field_simp
  calc
    t * conePsi (t ^ n * ξ) * gaussianDeriv (t ^ n * ξ) ^ 2 * t ^ (n - 1) =
        (t * t ^ (n - 1)) * conePsi (t ^ n * ξ) * gaussianDeriv (t ^ n * ξ) ^ 2 := by
          ring
    _ = _ := by rw [hpow']

/-- A translated square times an integrable absolute tail is integrable on
the two-variable product space.  This is the analytic Fubini fact needed to
discharge the fixed `(p₂,r)` condition in the global-energy identity. -/
theorem integrable_square_shifted_mul_abs
    (B ψ : ℝ → ℝ) (s u : ℝ)
    (hBcont : Continuous B)
    (hBsq : Integrable (fun q : ℝ ↦ B q ^ 2))
    (hψcont : Continuous ψ)
    (hψ : Integrable (fun r : ℝ ↦ |ψ (r + u)|)) :
    Integrable (fun z : ℝ × ℝ ↦
      B (z.1 + z.2 * s) ^ 2 * |ψ (z.2 + u)|)
      ((volume : Measure ℝ).prod volume) := by
  let G : ℝ × ℝ → ℝ := fun z ↦
    B (z.2 + z.1 * s) ^ 2 * |ψ (z.1 + u)|
  have hGcont : Continuous G := by
    apply Continuous.mul
    · exact (hBcont.comp
        ((continuous_snd.add (continuous_fst.mul continuous_const)))).pow 2
    · exact (hψcont.comp (continuous_fst.add continuous_const)).abs
  have hGin : ∀ᵐ r : ℝ,
      Integrable (fun p : ℝ ↦ G (r, p)) := by
    filter_upwards [] with r
    have hshift : Integrable (fun p : ℝ ↦ B (p + r * s) ^ 2) := by
      simpa only using hBsq.comp_add_right (r * s)
    simpa only [G] using hshift.mul_const |ψ (r + u)|
  have hGnorm : Integrable (fun r : ℝ ↦ ∫ p : ℝ, ‖G (r, p)‖) := by
    have hconst : Integrable (fun r : ℝ ↦
        (∫ q : ℝ, B q ^ 2) * |ψ (r + u)|) := hψ.const_mul _
    apply hconst.congr
    filter_upwards [] with r
    have hBnonneg (q : ℝ) : 0 ≤ B q ^ 2 := sq_nonneg _
    have htailnonneg : 0 ≤ |ψ (r + u)| := abs_nonneg _
    symm
    calc
      (∫ p : ℝ, ‖G (r, p)‖) =
          ∫ p : ℝ, B (p + r * s) ^ 2 * |ψ (r + u)| := by
            apply integral_congr_ae
            filter_upwards [] with p
            dsimp [G]
            exact abs_of_nonneg (mul_nonneg (hBnonneg _) htailnonneg)
      _ = (∫ p : ℝ, B (p + r * s) ^ 2) * |ψ (r + u)| := by
            rw [integral_mul_const]
      _ = (∫ q : ℝ, B q ^ 2) * |ψ (r + u)| := by
            exact congrArg (fun x : ℝ ↦ x * |ψ (r + u)|)
              (integral_add_right_eq_self (μ := volume)
                (fun q : ℝ ↦ B q ^ 2) (r * s))
  have hG : Integrable G ((volume : Measure ℝ).prod volume) := by
    exact (integrable_prod_iff hGcont.aestronglyMeasurable).mpr ⟨hGin, hGnorm⟩
  have hswap : Integrable (G ∘ Prod.swap)
      ((volume : Measure ℝ).prod volume) := hG.swap
  apply hswap.congr
  filter_upwards [] with z
  rfl

/-- An integrable real function with a uniform absolute bound has integrable
square. -/
theorem integrable_sq_of_integrable_bounded
    (B : ℝ → ℝ) (hB : Integrable B)
    (C : ℝ) (hC : 0 ≤ C) (hbound : ∀ q : ℝ, |B q| ≤ C) :
    Integrable (fun q : ℝ ↦ B q ^ 2) := by
  have hmajor : Integrable (fun q : ℝ ↦ C * |B q|) :=
    hB.norm.const_mul C
  apply Integrable.mono hmajor
    (hB.aestronglyMeasurable.pow 2)
  filter_upwards [] with q
  have hBnonneg : 0 ≤ |B q| := abs_nonneg _
  change |B q ^ 2| ≤ abs (C * |B q|)
  rw [abs_of_nonneg (sq_nonneg _),
    abs_of_nonneg (mul_nonneg hC hBnonneg)]
  rw [← sq_abs]
  nlinarith [hbound q]

/-- A real Schwartz third-coordinate fiber satisfies the fixed-scale
`(p₂,r)` integrability required by the global second-energy reduction. -/
theorem integrable_modelSecondFiberReduced_p2_r_of_real_schwartz
    (α : Anisotropy) (u : E3) (f : SchwartzMap E3 ℝ)
    (x₁ x₂ t : ℝ) (ht : 0 < t) :
    Integrable (fun z : ℝ × ℝ ↦
      (modelSecondFiberReduced α f x₁ x₂ z.1 t z.2) ^ 2 *
        |conePsiPhysicalReal (z.2 + u 2)|)
      ((volume : Measure ℝ).prod volume) := by
  let F : SchwartzMap ℝ ℂ :=
    modelThirdSchwartzFiber (complexifyRealSchwartz f) x₁ x₂
  let g : ℝ → ℝ := fun v ↦ f (modelPoint x₁ x₂ v)
  let s : ℝ := t ^ α.weight 2
  let K : ℝ → ℂ := fun v ↦ (gaussianDerivAt s 0 v : ℂ)
  let Cfun : ℝ → ℂ := fun q ↦
    ∫ v : ℝ, F v * (gaussianDerivAt s q v : ℂ)
  let B : ℝ → ℝ := fun q ↦
    ∫ v : ℝ, g v * gaussianDerivAt s q v
  have hs : 0 < s := by
    dsimp [s]
    exact pow_pos ht _
  have hFreal (v : ℝ) : F v = (g v : ℂ) := by
    dsimp [F, g]
    simp
  have hK : Integrable K := by
    dsimp [K]
    exact (integrable_gaussianDerivAt hs 0).ofReal
  have hconv : Integrable ((F : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] K) :=
    F.integrable.integrable_convolution (ContinuousLinearMap.mul ℂ ℂ) hK
  have hCfun_eq (q : ℝ) : Cfun q =
      -((F : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] K) q := by
    dsimp [Cfun, K]
    exact gaussianDerivAt_fiber_eq_neg_convolution F s q
  have hCfun : Integrable Cfun := by
    apply hconv.neg.congr
    filter_upwards [] with q
    symm
    exact hCfun_eq q
  have hconvcont : Continuous ((F : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] K) :=
    (bddAbove_norm_complex_gaussianDerivAt s 0).continuous_convolution_right_of_integrable
        (ContinuousLinearMap.mul ℂ ℂ) F.integrable
        (continuous_complex_gaussianDerivAt s 0)
  have hCfuncont : Continuous Cfun := by
    apply hconvcont.neg.congr
    intro q
    symm
    exact hCfun_eq q
  obtain ⟨C, hC⟩ := bddAbove_norm_complex_gaussianDerivAt s 0
  have hKbound (v : ℝ) : ‖K v‖ ≤ C := by
    exact hC ⟨v, rfl⟩
  have hCfunbound (q : ℝ) : ‖Cfun q‖ ≤ (∫ v : ℝ, ‖F v‖) * C := by
    have hmajor : Integrable (fun v : ℝ ↦ ‖F v‖ * C) :=
      F.integrable.norm.mul_const C
    calc
      ‖Cfun q‖ ≤ ∫ v : ℝ,
          ‖F v * (gaussianDerivAt s q v : ℂ)‖ :=
        norm_integral_le_integral_norm _
      _ ≤ ∫ v : ℝ, ‖F v‖ * C := by
        apply MeasureTheory.integral_mono_of_nonneg
        · filter_upwards [] with v
          exact norm_nonneg _
        · exact hmajor
        filter_upwards [] with v
        rw [norm_mul]
        apply mul_le_mul_of_nonneg_left
        · rw [gaussianDerivAt_reflect]
          push_cast
          simpa [K, Complex.norm_real, Real.norm_eq_abs] using hKbound (q - v)
        · exact norm_nonneg _
      _ = (∫ v : ℝ, ‖F v‖) * C := by
        rw [integral_mul_const]
  have hB_eq (q : ℝ) : Cfun q = (B q : ℂ) := by
    dsimp [Cfun, B]
    exact complexFiberIntegral_eq_real F g hFreal s q
  have hB : Integrable B := by
    apply hCfun.re.congr
    filter_upwards [] with q
    exact congrArg Complex.re (hB_eq q)
  have hBcont : Continuous B := by
    apply (Complex.continuous_re.comp hCfuncont).congr
    intro q
    exact congrArg Complex.re (hB_eq q)
  have hDnonneg : 0 ≤ (∫ v : ℝ, ‖F v‖) * C := by
    exact (norm_nonneg (Cfun 0)).trans (hCfunbound 0)
  have hBbound (q : ℝ) : |B q| ≤ (∫ v : ℝ, ‖F v‖) * C := by
    calc
      |B q| = ‖(B q : ℂ)‖ := by simp
      _ = ‖Cfun q‖ := by rw [hB_eq q]
      _ ≤ _ := hCfunbound q
  have hBsq : Integrable (fun q : ℝ ↦ B q ^ 2) :=
    integrable_sq_of_integrable_bounded B hB
      ((∫ v : ℝ, ‖F v‖) * C) hDnonneg hBbound
  have htail : Integrable (fun r : ℝ ↦
      |conePsiPhysicalReal (r + u 2)|) :=
    integrable_abs_conePsiPhysicalReal.comp_add_right (u 2)
  have hmain := integrable_square_shifted_mul_abs
    B conePsiPhysicalReal s (u 2) hBcont hBsq
    conePsiPhysicalReal.continuous htail
  apply hmain.congr
  filter_upwards [] with z
  dsimp [B, g, s]
  rfl

/-- For a real Schwartz input, all post-Tonelli scalar and fixed-fiber
integrability conditions in the global second-energy identity are automatic.
The original joint density is the sole remaining global Fubini hypothesis. -/
theorem modelEnergyTwoOn_global_eq_of_real_schwartz_of_joint
    (α : Anisotropy) (u : E3) (f : SchwartzMap E3 ℝ)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyTwoIntegrand α u f q.1 q.2)
      ((cubeScaleMeasure.restrict (Set.univ ×ˢ Set.Ioi (0 : ℝ))).prod volume)) :
    modelEnergyTwoOn α (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f =
      (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 *
        conePsiPhysicalRealL1 * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ x : E3, f x ^ 2 := by
  apply modelEnergyTwoOn_global_eq_of_joint_and_fixedFiber α u f hjoint
  intro x₁ x₂ t ht
  exact integrable_modelSecondFiberReduced_p2_r_of_real_schwartz
    α u f x₁ x₂ t ht

/-- Integrating the differential identity gives the finite-scale Calderón
telescoping formula. -/
theorem calderon_interval_nat_scale
    (n : ℕ) (hn : 0 < n) (ξ a b : ℝ) (hξ : ξ ≠ 0)
    (ha : 0 < a) (hab : a ≤ b) :
    ∫ t in a..b,
      (n : ℝ) * conePsi (t ^ n * ξ) * gaussianDeriv (t ^ n * ξ) ^ 2 / t =
        conePhi (a ^ n * ξ) - conePhi (b ^ n * ξ) := by
  let F : ℝ → ℝ :=
    (fun _ : ℝ ↦ cPsi) - conePrimitive ∘ (fun s : ℝ ↦ s ^ n * ξ)
  let F' : ℝ → ℝ := fun s ↦
    (-coneWeight (s ^ n * ξ)) * ((n : ℝ) * s ^ (n - 1) * ξ)
  have hpowcont : Continuous (fun s : ℝ ↦ s ^ n * ξ) :=
    (continuous_pow n).mul continuous_const
  have hFcont : Continuous F := by
    dsimp [F]
    exact continuous_const.sub (conePrimitive_contDiff.continuous.comp hpowcont)
  have hF'cont : Continuous F' := by
    dsimp [F']
    exact (coneWeight_contDiff.continuous.comp hpowcont).neg.mul
      ((continuous_const.mul (continuous_pow (n - 1))).mul continuous_const)
  have hFderiv (s : ℝ) : HasDerivAt F (F' s) s := by
    have hpow : HasDerivAt (fun y : ℝ ↦ y ^ n * ξ)
        ((n : ℝ) * s ^ (n - 1) * ξ) s := by
      convert (hasDerivAt_pow n s).mul_const ξ using 1
    have hprim := (hasDerivAt_conePrimitive (s ^ n * ξ)).comp s hpow
    have h := (hasDerivAt_const s cPsi).sub hprim
    simpa only [F, F', Pi.sub_apply, Pi.zero_apply, zero_sub, neg_mul] using h
  have hFTC := intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le hab
    hFcont.continuousOn (fun s _ ↦ hFderiv s) (hF'cont.intervalIntegrable _ _)
  have hneg : (∫ t in a..b, -F' t) = F a - F b := by
    rw [intervalIntegral.integral_neg, hFTC]
    ring
  have hpoint (t : ℝ) (ht : t ∈ Set.Icc a b) :
      (n : ℝ) * conePsi (t ^ n * ξ) * gaussianDeriv (t ^ n * ξ) ^ 2 / t =
        -F' t := by
    have htpos : 0 < t := lt_of_lt_of_le ha ht.1
    change (n : ℝ) * conePsi (t ^ n * ξ) * gaussianDeriv (t ^ n * ξ) ^ 2 / t =
      -F' t
    dsimp [F']
    have htn : t ^ n * ξ ≠ 0 := mul_ne_zero (pow_ne_zero _ htpos.ne') hξ
    have hpow' : t * t ^ (n - 1) = t ^ n := by
      calc
        t * t ^ (n - 1) = t ^ (n - 1) * t := by ring
        _ = t ^ ((n - 1) + 1) := (pow_succ t (n - 1)).symm
        _ = t ^ n := by congr 1 ; omega
    rw [coneWeight_eq_source_integrand htn]
    field_simp
    rw [← hpow']
    ring
  calc
    ∫ t in a..b,
        (n : ℝ) * conePsi (t ^ n * ξ) * gaussianDeriv (t ^ n * ξ) ^ 2 / t =
        ∫ t in a..b, -F' t := by
          apply intervalIntegral.integral_congr
          rw [Set.uIcc_of_le hab]
          exact fun t ht ↦ hpoint t ht
    _ = F a - F b := hneg
    _ = conePhi (a ^ n * ξ) - conePhi (b ^ n * ξ) := by
      have hFapply (s : ℝ) : F s = conePhi (s ^ n * ξ) := by
        dsimp [F, conePhi]
      rw [hFapply a, hFapply b]

theorem hasDerivAt_conePhi_nat_scale
    (n : ℕ) (ξ s : ℝ) :
    HasDerivAt (conePhi ∘ fun y : ℝ ↦ y ^ n * ξ)
      ((-coneWeight (s ^ n * ξ)) * ((n : ℝ) * s ^ (n - 1) * ξ)) s := by
  have hpow : HasDerivAt (fun y : ℝ ↦ y ^ n * ξ)
      ((n : ℝ) * s ^ (n - 1) * ξ) s := by
    convert (hasDerivAt_pow n s).mul_const ξ using 1
  exact (hasDerivAt_conePhi (s ^ n * ξ)).comp s hpow

/-- The product of the three anisotropically scaled low-frequency cutoffs. -/
noncomputable def coneProduct (α : Anisotropy) (ξ : E3) : ℝ → ℝ :=
  ((conePhi ∘ fun t : ℝ ↦ t ^ (α.weight 0) * ξ 0) *
    (conePhi ∘ fun t : ℝ ↦ t ^ (α.weight 1) * ξ 1)) *
      (conePhi ∘ fun t : ℝ ↦ t ^ (α.weight 2) * ξ 2)

/-- Product-rule form of the finite-scale three-cone identity. -/
theorem hasDerivAt_coneProduct
    (α : Anisotropy) (ξ : E3) (t : ℝ) :
    let A : ℝ → ℝ := conePhi ∘ fun s : ℝ ↦ s ^ (α.weight 0) * ξ 0
    let B : ℝ → ℝ := conePhi ∘ fun s : ℝ ↦ s ^ (α.weight 1) * ξ 1
    let C : ℝ → ℝ := conePhi ∘ fun s : ℝ ↦ s ^ (α.weight 2) * ξ 2
    let d0 : ℝ := -coneWeight (t ^ (α.weight 0) * ξ 0) *
      ((α.weight 0 : ℝ) * t ^ (α.weight 0 - 1) * ξ 0)
    let d1 : ℝ := -coneWeight (t ^ (α.weight 1) * ξ 1) *
      ((α.weight 1 : ℝ) * t ^ (α.weight 1 - 1) * ξ 1)
    let d2 : ℝ := -coneWeight (t ^ (α.weight 2) * ξ 2) *
      ((α.weight 2 : ℝ) * t ^ (α.weight 2 - 1) * ξ 2)
    HasDerivAt ((A * B) * C)
      ((d0 * B t + A t * d1) * C t + (A * B) t * d2) t := by
  dsimp only
  exact
    ((hasDerivAt_conePhi_nat_scale (α.weight 0) (ξ 0) t).mul
      (hasDerivAt_conePhi_nat_scale (α.weight 1) (ξ 1) t)).mul
      (hasDerivAt_conePhi_nat_scale (α.weight 2) (ξ 2) t)

/-- The differentiated product is the three-cone Calderón integrand, with
the identity continuing across the coordinate planes. -/
theorem neg_mul_deriv_coneProduct
    (α : Anisotropy) (ξ : E3) (t : ℝ) :
    -t * deriv (coneProduct α ξ) t =
      ((α.weight 0 : ℝ) * conePsi (t ^ (α.weight 0) * ξ 0) *
          gaussianDeriv (t ^ (α.weight 0) * ξ 0) ^ 2) *
        conePhi (t ^ (α.weight 1) * ξ 1) *
          conePhi (t ^ (α.weight 2) * ξ 2) +
      conePhi (t ^ (α.weight 0) * ξ 0) *
        ((α.weight 1 : ℝ) * conePsi (t ^ (α.weight 1) * ξ 1) *
          gaussianDeriv (t ^ (α.weight 1) * ξ 1) ^ 2) *
          conePhi (t ^ (α.weight 2) * ξ 2) +
      conePhi (t ^ (α.weight 0) * ξ 0) *
        conePhi (t ^ (α.weight 1) * ξ 1) *
          ((α.weight 2 : ℝ) * conePsi (t ^ (α.weight 2) * ξ 2) *
            gaussianDeriv (t ^ (α.weight 2) * ξ 2) ^ 2) := by
  let A : ℝ → ℝ := conePhi ∘ fun s : ℝ ↦ s ^ (α.weight 0) * ξ 0
  let B : ℝ → ℝ := conePhi ∘ fun s : ℝ ↦ s ^ (α.weight 1) * ξ 1
  let C : ℝ → ℝ := conePhi ∘ fun s : ℝ ↦ s ^ (α.weight 2) * ξ 2
  let d0 : ℝ := -coneWeight (t ^ (α.weight 0) * ξ 0) *
    ((α.weight 0 : ℝ) * t ^ (α.weight 0 - 1) * ξ 0)
  let d1 : ℝ := -coneWeight (t ^ (α.weight 1) * ξ 1) *
    ((α.weight 1 : ℝ) * t ^ (α.weight 1 - 1) * ξ 1)
  let d2 : ℝ := -coneWeight (t ^ (α.weight 2) * ξ 2) *
    ((α.weight 2 : ℝ) * t ^ (α.weight 2 - 1) * ξ 2)
  let g0 : ℝ := (α.weight 0 : ℝ) * conePsi (t ^ (α.weight 0) * ξ 0) *
    gaussianDeriv (t ^ (α.weight 0) * ξ 0) ^ 2
  let g1 : ℝ := (α.weight 1 : ℝ) * conePsi (t ^ (α.weight 1) * ξ 1) *
    gaussianDeriv (t ^ (α.weight 1) * ξ 1) ^ 2
  let g2 : ℝ := (α.weight 2 : ℝ) * conePsi (t ^ (α.weight 2) * ξ 2) *
    gaussianDeriv (t ^ (α.weight 2) * ξ 2) ^ 2
  have hderiv : deriv ((A * B) * C) t =
      (d0 * B t + A t * d1) * C t + (A * B) t * d2 :=
    (hasDerivAt_coneProduct α ξ t).deriv
  have h0 : -t * d0 = g0 := by
    dsimp [d0, g0, coneWeight, gaussianDeriv]
    have hpow : t * t ^ (α.weight 0 - 1) = t ^ (α.weight 0) := by
      calc
        t * t ^ (α.weight 0 - 1) = t ^ (α.weight 0 - 1) * t := by ring
        _ = t ^ ((α.weight 0 - 1) + 1) := (pow_succ t (α.weight 0 - 1)).symm
        _ = t ^ (α.weight 0) := by
          have hpos : 0 < α.weight 0 := α.weight_pos 0
          congr 1
          omega
    rw [← hpow]
    ring
  have h1 : -t * d1 = g1 := by
    dsimp [d1, g1, coneWeight, gaussianDeriv]
    have hpow : t * t ^ (α.weight 1 - 1) = t ^ (α.weight 1) := by
      calc
        t * t ^ (α.weight 1 - 1) = t ^ (α.weight 1 - 1) * t := by ring
        _ = t ^ ((α.weight 1 - 1) + 1) := (pow_succ t (α.weight 1 - 1)).symm
        _ = t ^ (α.weight 1) := by
          have hpos : 0 < α.weight 1 := α.weight_pos 1
          congr 1
          omega
    rw [← hpow]
    ring
  have h2 : -t * d2 = g2 := by
    dsimp [d2, g2, coneWeight, gaussianDeriv]
    have hpow : t * t ^ (α.weight 2 - 1) = t ^ (α.weight 2) := by
      calc
        t * t ^ (α.weight 2 - 1) = t ^ (α.weight 2 - 1) * t := by ring
        _ = t ^ ((α.weight 2 - 1) + 1) := (pow_succ t (α.weight 2 - 1)).symm
        _ = t ^ (α.weight 2) := by
          have hpos : 0 < α.weight 2 := α.weight_pos 2
          congr 1
          omega
    rw [← hpow]
    ring
  change -t * deriv ((A * B) * C) t =
    g0 * B t * C t + A t * g1 * C t + A t * B t * g2
  rw [hderiv]
  have h0' : t * d0 = -g0 := by linarith
  have h1' : t * d1 = -g1 := by linarith
  have h2' : t * d2 = -g2 := by linarith
  calc
    -t * ((d0 * B t + A t * d1) * C t + (A * B) t * d2) =
        (-t * d0) * B t * C t + A t * (-t * d1) * C t +
          A t * B t * (-t * d2) := by
            simp only [Pi.mul_apply]
            ring
    _ = _ := by rw [h0, h1, h2]

/-- Finite-scale telescoping for the three-cone product.  It is valid without
excluding coordinate planes, because the smooth cone weight fills the
removable zero identically. -/
theorem calderon_coneProduct_interval
    (α : Anisotropy) (ξ : E3) (a b : ℝ)
    (ha : 0 < a) (hab : a ≤ b) :
    ∫ t in a..b,
      (((α.weight 0 : ℝ) * conePsi (t ^ (α.weight 0) * ξ 0) *
          gaussianDeriv (t ^ (α.weight 0) * ξ 0) ^ 2) *
        conePhi (t ^ (α.weight 1) * ξ 1) *
          conePhi (t ^ (α.weight 2) * ξ 2) +
      conePhi (t ^ (α.weight 0) * ξ 0) *
        ((α.weight 1 : ℝ) * conePsi (t ^ (α.weight 1) * ξ 1) *
          gaussianDeriv (t ^ (α.weight 1) * ξ 1) ^ 2) *
          conePhi (t ^ (α.weight 2) * ξ 2) +
      conePhi (t ^ (α.weight 0) * ξ 0) *
        conePhi (t ^ (α.weight 1) * ξ 1) *
          ((α.weight 2 : ℝ) * conePsi (t ^ (α.weight 2) * ξ 2) *
            gaussianDeriv (t ^ (α.weight 2) * ξ 2) ^ 2)) / t =
      coneProduct α ξ a - coneProduct α ξ b := by
  let A : ℝ → ℝ := conePhi ∘ fun s : ℝ ↦ s ^ (α.weight 0) * ξ 0
  let B : ℝ → ℝ := conePhi ∘ fun s : ℝ ↦ s ^ (α.weight 1) * ξ 1
  let C : ℝ → ℝ := conePhi ∘ fun s : ℝ ↦ s ^ (α.weight 2) * ξ 2
  let F : ℝ → ℝ := (A * B) * C
  let G : ℝ → ℝ := fun t ↦
    ((α.weight 0 : ℝ) * conePsi (t ^ (α.weight 0) * ξ 0) *
        gaussianDeriv (t ^ (α.weight 0) * ξ 0) ^ 2) *
      conePhi (t ^ (α.weight 1) * ξ 1) *
        conePhi (t ^ (α.weight 2) * ξ 2) +
    conePhi (t ^ (α.weight 0) * ξ 0) *
      ((α.weight 1 : ℝ) * conePsi (t ^ (α.weight 1) * ξ 1) *
        gaussianDeriv (t ^ (α.weight 1) * ξ 1) ^ 2) *
        conePhi (t ^ (α.weight 2) * ξ 2) +
    conePhi (t ^ (α.weight 0) * ξ 0) *
      conePhi (t ^ (α.weight 1) * ξ 1) *
        ((α.weight 2 : ℝ) * conePsi (t ^ (α.weight 2) * ξ 2) *
          gaussianDeriv (t ^ (α.weight 2) * ξ 2) ^ 2)
  have hA : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) A := by
    dsimp [A]
    exact conePhi_contDiff.comp
      ((contDiff_id.pow (α.weight 0)).mul contDiff_const)
  have hB : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) B := by
    dsimp [B]
    exact conePhi_contDiff.comp
      ((contDiff_id.pow (α.weight 1)).mul contDiff_const)
  have hC : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) C := by
    dsimp [C]
    exact conePhi_contDiff.comp
      ((contDiff_id.pow (α.weight 2)).mul contDiff_const)
  have hF : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) F := hA.mul hB |>.mul hC
  have hInt : IntervalIntegrable (deriv F) volume a b :=
    (hF.continuous_deriv (by norm_num)).intervalIntegrable a b
  have hFTC := intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le hab
    hF.continuous.continuousOn
    (fun s _ ↦ (hF.differentiable (by norm_num) s).hasDerivAt)
    hInt
  have hpoint (t : ℝ) (ht : t ∈ Set.Icc a b) : G t / t = -deriv F t := by
    have htpos : 0 < t := lt_of_lt_of_le ha ht.1
    have hderiv := neg_mul_deriv_coneProduct α ξ t
    change G t / t = -deriv F t
    rw [div_eq_iff htpos.ne']
    calc
      G t = -t * deriv (coneProduct α ξ) t := hderiv.symm
      _ = -deriv F t * t := by
        change -t * deriv F t = -deriv F t * t
        ring
  change (∫ t in a..b, G t / t) = F a - F b
  calc
    ∫ t in a..b, G t / t = ∫ t in a..b, -deriv F t := by
      apply intervalIntegral.integral_congr
      rw [Set.uIcc_of_le hab]
      exact fun t ht ↦ hpoint t ht
    _ = -(∫ t in a..b, deriv F t) := by
      rw [intervalIntegral.integral_neg]
    _ = F a - F b := by rw [hFTC]; ring

/-- At a scale at which every coordinate lies in the low-frequency plateau,
the three-cone product has its full Calderón mass. -/
theorem coneProduct_eq_cPsi_pow_of_small
    (α : Anisotropy) (ξ : E3) (t : ℝ)
    (h : ∀ i : Fin 3, |t ^ (α.weight i) * ξ i| ≤ 1) :
    coneProduct α ξ t = cPsi ^ 3 := by
  change (conePhi (t ^ (α.weight 0) * ξ 0) *
      conePhi (t ^ (α.weight 1) * ξ 1)) *
        conePhi (t ^ (α.weight 2) * ξ 2) = cPsi ^ 3
  rw [conePhi_eq_cPsi_of_abs_le_one (h 0),
    conePhi_eq_cPsi_of_abs_le_one (h 1),
    conePhi_eq_cPsi_of_abs_le_one (h 2)]
  ring

/-- If one coordinate lies outside the high-frequency support, the product
cutoff vanishes. -/
theorem coneProduct_eq_zero_of_large
    (α : Anisotropy) (ξ : E3) (t : ℝ)
    (h : ∃ i : Fin 3, 2 ≤ |t ^ (α.weight i) * ξ i|) :
    coneProduct α ξ t = 0 := by
  rcases h with ⟨i, hi⟩
  fin_cases i
  · have hi' : 2 ≤ |t ^ (α.weight 0) * ξ 0| := by simpa using hi
    change (conePhi (t ^ (α.weight 0) * ξ 0) *
      conePhi (t ^ (α.weight 1) * ξ 1)) *
        conePhi (t ^ (α.weight 2) * ξ 2) = 0
    rw [conePhi_eq_zero_of_two_le_abs hi']
    ring
  · have hi' : 2 ≤ |t ^ (α.weight 1) * ξ 1| := by simpa using hi
    change (conePhi (t ^ (α.weight 0) * ξ 0) *
      conePhi (t ^ (α.weight 1) * ξ 1)) *
        conePhi (t ^ (α.weight 2) * ξ 2) = 0
    rw [conePhi_eq_zero_of_two_le_abs hi']
    ring
  · have hi' : 2 ≤ |t ^ (α.weight 2) * ξ 2| := by simpa using hi
    change (conePhi (t ^ (α.weight 0) * ξ 0) *
      conePhi (t ^ (α.weight 1) * ξ 1)) *
        conePhi (t ^ (α.weight 2) * ξ 2) = 0
    rw [conePhi_eq_zero_of_two_le_abs hi']
    ring

/-- The finite interval form of the cone identity once its natural endpoints
have been chosen. -/
theorem calderon_coneProduct_interval_of_endpoints
    (α : Anisotropy) (ξ : E3) (a b : ℝ)
    (ha : 0 < a) (hab : a ≤ b)
    (hsmall : coneProduct α ξ a = cPsi ^ 3)
    (hlarge : coneProduct α ξ b = 0) :
    ∫ t in a..b,
      (((α.weight 0 : ℝ) * conePsi (t ^ (α.weight 0) * ξ 0) *
          gaussianDeriv (t ^ (α.weight 0) * ξ 0) ^ 2) *
        conePhi (t ^ (α.weight 1) * ξ 1) *
          conePhi (t ^ (α.weight 2) * ξ 2) +
      conePhi (t ^ (α.weight 0) * ξ 0) *
        ((α.weight 1 : ℝ) * conePsi (t ^ (α.weight 1) * ξ 1) *
          gaussianDeriv (t ^ (α.weight 1) * ξ 1) ^ 2) *
          conePhi (t ^ (α.weight 2) * ξ 2) +
      conePhi (t ^ (α.weight 0) * ξ 0) *
        conePhi (t ^ (α.weight 1) * ξ 1) *
          ((α.weight 2 : ℝ) * conePsi (t ^ (α.weight 2) * ξ 2) *
            gaussianDeriv (t ^ (α.weight 2) * ξ 2) ^ 2)) / t = cPsi ^ 3 := by
  rw [calderon_coneProduct_interval α ξ a b ha hab, hsmall, hlarge]
  ring

/-- Every nonzero three-frequency has positive finite scales at which the
three-cone product respectively equals its full mass and vanishes. -/
theorem exists_coneProduct_endpoints
    (α : Anisotropy) (ξ : E3) (hξ : ξ ≠ 0) :
    ∃ a b : ℝ, 0 < a ∧ a ≤ b ∧
      coneProduct α ξ a = cPsi ^ 3 ∧ coneProduct α ξ b = 0 := by
  obtain ⟨i, hξi⟩ : ∃ i : Fin 3, ξ i ≠ 0 := by
    by_contra h
    apply hξ
    ext j
    apply not_ne_iff.mp
    intro hj
    exact h ⟨j, hj⟩
  let R : ℝ := max |ξ 0| (max |ξ 1| |ξ 2|)
  have hRnonneg : 0 ≤ R := by
    dsimp [R]
    positivity
  have hR (j : Fin 3) : |ξ j| ≤ R := by
    fin_cases j
    · exact le_max_left _ _
    · exact (le_max_left _ _).trans (le_max_right _ _)
    · exact (le_max_right _ _).trans (le_max_right _ _)
  let a : ℝ := 1 / (1 + R)
  have hden : 0 < 1 + R := by linarith
  have ha : 0 < a := by
    dsimp [a]
    exact div_pos zero_lt_one hden
  have haone : a ≤ 1 := by
    dsimp [a]
    apply (div_le_iff₀ hden).mpr
    linarith
  have haR : a * R ≤ 1 := by
    calc
      a * R = R / (1 + R) := by
        dsimp [a]
        ring
      _ ≤ 1 := (div_le_iff₀ hden).mpr (by linarith)
  have hsmall : ∀ j : Fin 3, |a ^ (α.weight j) * ξ j| ≤ 1 := by
    intro j
    have hpow : a ^ (α.weight j) ≤ a :=
      pow_le_of_le_one ha.le haone (Nat.ne_zero_of_lt (α.weight_pos j))
    rw [abs_mul, abs_of_nonneg (pow_nonneg ha.le _)]
    calc
      a ^ (α.weight j) * |ξ j| ≤ a * |ξ j| :=
        mul_le_mul_of_nonneg_right hpow (abs_nonneg _)
      _ ≤ a * R := mul_le_mul_of_nonneg_left (hR j) ha.le
      _ ≤ 1 := haR
  let b : ℝ := max 1 (2 / |ξ i|)
  have hb_one : 1 ≤ b := le_max_left _ _
  have hb : 0 < b := lt_of_lt_of_le zero_lt_one hb_one
  have hab : a ≤ b := haone.trans hb_one
  have habs : 0 < |ξ i| := abs_pos.mpr hξi
  have hpowb : b ≤ b ^ (α.weight i) :=
    by
      simpa only [pow_one] using
        (pow_le_pow_right₀ hb_one
          (Nat.one_le_iff_ne_zero.mpr (Nat.ne_zero_of_lt (α.weight_pos i))))
  have hlargei : 2 ≤ |b ^ (α.weight i) * ξ i| := by
    rw [abs_mul, abs_of_nonneg (pow_nonneg hb.le _)]
    calc
      2 ≤ b * |ξ i| :=
        (div_le_iff₀ habs).mp (le_max_right _ _)
      _ ≤ b ^ (α.weight i) * |ξ i| :=
        mul_le_mul_of_nonneg_right hpowb (abs_nonneg _)
  refine ⟨a, b, ha, hab,
    coneProduct_eq_cPsi_pow_of_small α ξ a hsmall, ?_⟩
  exact coneProduct_eq_zero_of_large α ξ b ⟨i, hlargei⟩

/-- The finite positive scale interval can always be chosen to recover the
entire three-cone Calderón mass at a nonzero frequency. -/
theorem exists_calderon_coneProduct_interval
    (α : Anisotropy) (ξ : E3) (hξ : ξ ≠ 0) :
    ∃ a b : ℝ, 0 < a ∧ a ≤ b ∧
      ∫ t in a..b,
        (((α.weight 0 : ℝ) * conePsi (t ^ (α.weight 0) * ξ 0) *
            gaussianDeriv (t ^ (α.weight 0) * ξ 0) ^ 2) *
          conePhi (t ^ (α.weight 1) * ξ 1) *
            conePhi (t ^ (α.weight 2) * ξ 2) +
        conePhi (t ^ (α.weight 0) * ξ 0) *
          ((α.weight 1 : ℝ) * conePsi (t ^ (α.weight 1) * ξ 1) *
            gaussianDeriv (t ^ (α.weight 1) * ξ 1) ^ 2) *
            conePhi (t ^ (α.weight 2) * ξ 2) +
        conePhi (t ^ (α.weight 0) * ξ 0) *
          conePhi (t ^ (α.weight 1) * ξ 1) *
            ((α.weight 2 : ℝ) * conePsi (t ^ (α.weight 2) * ξ 2) *
              gaussianDeriv (t ^ (α.weight 2) * ξ 2) ^ 2)) / t = cPsi ^ 3 := by
  obtain ⟨a, b, ha, hab, hsmall, hlarge⟩ :=
    exists_coneProduct_endpoints α ξ hξ
  exact ⟨a, b, ha, hab,
    calderon_coneProduct_interval_of_endpoints
      α ξ a b ha hab hsmall hlarge⟩

/-- The zero multiplier scale forces the multiplier itself to vanish, so the
zero case in the cone decomposition does not need any division by `M`. -/
theorem multiplier_eq_zero_of_M_eq_zero
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m) (hM : M = 0) :
    m = 0 := by
  funext ξ
  apply norm_eq_zero.mp
  apply le_antisymm
  · calc
      ‖m ξ‖ ≤ M := hm.norm_le_all ξ
      _ = 0 := hM
  · exact norm_nonneg _

/-- Consequently the literal multiplier form is zero in the zero-scale
case. -/
theorem multiplierForm_eq_zero_of_M_eq_zero
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m) (hM : M = 0)
    (f₀ f₁ f₂ f₃ : Schwartz3) :
    multiplierForm m f₀ f₁ f₂ f₃ = 0 := by
  rw [multiplier_eq_zero_of_M_eq_zero α M m hm hM]
  simp [multiplierForm]

/-- A mode family with the coefficient decay produced by the Fourier-series
step is absolutely summable on the standard three-dimensional lattice. -/
theorem summable_standardMode_of_sourceWeight_decay
    {E : Type*} [NormedAddCommGroup E] [CompleteSpace E]
    (F : standardModeLattice → E) (C : ℝ)
    (hF : ∀ z : standardModeLattice,
      ‖F z‖ ≤ C * (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ)) :
    Summable F := by
  apply Summable.of_norm_bounded
  · exact (summable_standardMode_sourceWeight_inv).mul_left C
  · intro z
    exact hF z

/-- The three active-coordinate mode sums remain summable under a common
degree-ten coefficient bound. -/
theorem summable_threeCoordinateModes_of_sourceWeight_decay
    {E : Type*} [NormedAddCommGroup E] [CompleteSpace E]
    (F : Fin 3 → standardModeLattice → E) (C : ℝ)
    (hF : ∀ i z, ‖F i z‖ ≤ C * (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ)) :
    Summable (fun z ↦ F 0 z + F 1 z + F 2 z) := by
  let g : standardModeLattice → ℝ := fun z ↦
    (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ)
  apply Summable.of_norm_bounded ((summable_standardMode_sourceWeight_inv).mul_left (3 * C))
  intro z
  change ‖F 0 z + F 1 z + F 2 z‖ ≤ (3 * C) * g z
  calc
    ‖F 0 z + F 1 z + F 2 z‖ ≤ ‖F 0 z + F 1 z‖ + ‖F 2 z‖ := norm_add_le _ _
    _ ≤ (‖F 0 z‖ + ‖F 1 z‖) + ‖F 2 z‖ := by
      gcongr
      exact norm_add_le _ _
    _ ≤ (C * g z + C * g z) + C * g z := by
      gcongr
      · exact hF 0 z
      · exact hF 1 z
      · exact hF 2 z
    _ = (3 * C) * g z := by ring

/-- Coefficient decay of order 110 and model growth of order 100 leave the
summable order-10 lattice tail required in the final cone summation. -/
theorem summable_threeCoordinateModeProducts_of_decay
    (a b : Fin 3 → standardModeLattice → ℂ) (C D : ℝ)
    (hC : 0 ≤ C) (_hD : 0 ≤ D)
    (ha : ∀ i z, ‖a i z‖ ≤
      C * (sourceWeight (z : E3))⁻¹ ^ (110 : ℕ))
    (hb : ∀ i z, ‖b i z‖ ≤
      D * sourceWeight (z : E3) ^ (100 : ℕ)) :
    Summable (fun z ↦ ∑ i : Fin 3, a i z * b i z) := by
  let g : standardModeLattice → ℝ := fun z ↦
    (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ)
  apply Summable.of_norm_bounded
    ((summable_standardMode_sourceWeight_inv).mul_left (3 * C * D))
  intro z
  have hwpos : 0 < sourceWeight (z : E3) := sourceWeight_pos _
  have hwne : sourceWeight (z : E3) ≠ 0 := hwpos.ne'
  have hpow :
      (sourceWeight (z : E3))⁻¹ ^ (110 : ℕ) *
          sourceWeight (z : E3) ^ (100 : ℕ) = g z := by
    dsimp [g]
    field_simp [hwne]
  have hterm (i : Fin 3) :
      ‖a i z * b i z‖ ≤ C * D * g z := by
    rw [norm_mul]
    calc
      ‖a i z‖ * ‖b i z‖ ≤
          (C * (sourceWeight (z : E3))⁻¹ ^ (110 : ℕ)) *
            (D * sourceWeight (z : E3) ^ (100 : ℕ)) := by
              apply mul_le_mul (ha i z) (hb i z) (norm_nonneg _)
              exact mul_nonneg hC (pow_nonneg (inv_nonneg.mpr hwpos.le) _)
      _ = C * D *
          ((sourceWeight (z : E3))⁻¹ ^ (110 : ℕ) *
            sourceWeight (z : E3) ^ (100 : ℕ)) := by ring
      _ = C * D * g z := by rw [hpow]
  calc
    ‖∑ i : Fin 3, a i z * b i z‖ ≤ ∑ i : Fin 3, ‖a i z * b i z‖ :=
      by simpa using
        (norm_sum_le (Finset.univ : Finset (Fin 3)) (fun i ↦ a i z * b i z))
    _ ≤ ∑ _i : Fin 3, C * D * g z := by
      exact Finset.sum_le_sum fun i hi ↦ hterm i
    _ = (3 * C * D) * g z := by
      simp
      ring

/-- The preceding absolutely convergent mode sum has the explicit final
majorant needed after a Fourier-series form decomposition. -/
theorem norm_tsum_threeCoordinateModeProducts_le_of_decay
    (a b : Fin 3 → standardModeLattice → ℂ) (C D : ℝ)
    (hC : 0 ≤ C) (hD : 0 ≤ D)
    (ha : ∀ i z, ‖a i z‖ ≤
      C * (sourceWeight (z : E3))⁻¹ ^ (110 : ℕ))
    (hb : ∀ i z, ‖b i z‖ ≤
      D * sourceWeight (z : E3) ^ (100 : ℕ)) :
    ‖∑' z, ∑ i : Fin 3, a i z * b i z‖ ≤
      (3 * C * D) * ∑' z : standardModeLattice,
        (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ) := by
  let F : standardModeLattice → ℂ := fun z ↦ ∑ i : Fin 3, a i z * b i z
  let g : standardModeLattice → ℝ := fun z ↦
    (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ)
  have hF : Summable F := by
    exact summable_threeCoordinateModeProducts_of_decay
      a b C D hC hD ha hb
  have hg : Summable g := by
    exact summable_standardMode_sourceWeight_inv
  have hpoint (z : standardModeLattice) : ‖F z‖ ≤ (3 * C * D) * g z := by
    dsimp only [F, g]
    have hwpos : 0 < sourceWeight (z : E3) := sourceWeight_pos _
    have hwne : sourceWeight (z : E3) ≠ 0 := hwpos.ne'
    have hpow :
        (sourceWeight (z : E3))⁻¹ ^ (110 : ℕ) *
            sourceWeight (z : E3) ^ (100 : ℕ) =
          (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ) := by
      field_simp [hwne]
    have hterm (i : Fin 3) :
        ‖a i z * b i z‖ ≤ C * D *
          (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ) := by
      rw [norm_mul]
      calc
        ‖a i z‖ * ‖b i z‖ ≤
            (C * (sourceWeight (z : E3))⁻¹ ^ (110 : ℕ)) *
              (D * sourceWeight (z : E3) ^ (100 : ℕ)) := by
                apply mul_le_mul (ha i z) (hb i z) (norm_nonneg _)
                exact mul_nonneg hC (pow_nonneg (inv_nonneg.mpr hwpos.le) _)
        _ = C * D *
            ((sourceWeight (z : E3))⁻¹ ^ (110 : ℕ) *
              sourceWeight (z : E3) ^ (100 : ℕ)) := by ring
        _ = _ := by rw [hpow]
    calc
      ‖∑ i : Fin 3, a i z * b i z‖ ≤ ∑ i : Fin 3, ‖a i z * b i z‖ :=
        by simpa using
          (norm_sum_le (Finset.univ : Finset (Fin 3)) (fun i ↦ a i z * b i z))
      _ ≤ ∑ _i : Fin 3, C * D *
          (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ) := by
        exact Finset.sum_le_sum fun i hi ↦ hterm i
      _ = (3 * C * D) *
          (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ) := by
        simp
        ring
  calc
    ‖∑' z, ∑ i : Fin 3, a i z * b i z‖ = ‖∑' z, F z‖ := by rfl
    _ ≤ ∑' z, ‖F z‖ := norm_tsum_le_tsum_norm hF.norm
    _ ≤ ∑' z, (3 * C * D) * g z :=
      hF.norm.tsum_le_tsum hpoint (hg.mul_left _)
    _ = (3 * C * D) * ∑' z, g z := hg.tsum_mul_left _

/-- The preceding center--Gaussian pair has the scale-independent mass of
the absolute low-frequency kernel. -/
theorem integral_modelPhi_gaussian_pair
    (s c x : ℝ) (hs : 0 < s) :
    (∫ z : ℝ × ℝ,
      |modelPhiAt s (z.1 + c) x| * gaussianAt s z.1 z.2) =
      ∫ w : ℝ, |conePhiPhysicalReal w| := by
  let G : ℝ × ℝ → ℝ := fun z ↦
    |modelPhiAt s (z.1 + c) x| * gaussianAt s z.1 z.2
  have hG : Integrable G ((volume : Measure ℝ).prod volume) :=
    integrable_modelPhi_gaussian_pair s c x hs
  calc
    (∫ z : ℝ × ℝ, |modelPhiAt s (z.1 + c) x| * gaussianAt s z.1 z.2) =
        ∫ p : ℝ, ∫ y : ℝ, G (p, y) := by
          exact integral_prod G hG
    _ = ∫ p : ℝ, |modelPhiAt s (p + c) x| := by
          apply integral_congr_ae
          filter_upwards [] with p
          dsimp [G]
          rw [show (fun y : ℝ ↦
            |modelPhiAt s (p + c) x| * gaussianAt s p y) =
              fun y : ℝ ↦ |modelPhiAt s (p + c) x| * gaussianAt s p y by rfl,
            integral_const_mul, integral_gaussianAt hs p]
          ring
    _ = ∫ w : ℝ, |conePhiPhysicalReal w| :=
      integral_abs_modelPhiAt_center hs c x

/-- At every positive scale, the physical Gaussian-derivative transform of
a Schwartz fiber has an integrable squared norm. -/
theorem integrable_norm_sq_gaussianDeriv_fiber
    (F : SchwartzMap ℝ ℂ) (s : ℝ) (hs : 0 < s) :
    Integrable (fun q : ℝ ↦
      ‖∫ v : ℝ, F v * (gaussianDerivAt s q v : ℂ)‖ ^ 2) := by
  let K : ℝ → ℂ := fun v ↦ (gaussianDerivAt s 0 v : ℂ)
  let Cfun : ℝ → ℂ := fun q ↦
    ∫ v : ℝ, F v * (gaussianDerivAt s q v : ℂ)
  have hK : Integrable K := by
    dsimp [K]
    exact (integrable_gaussianDerivAt hs 0).ofReal
  have hconv : Integrable ((F : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] K) :=
    F.integrable.integrable_convolution (ContinuousLinearMap.mul ℂ ℂ) hK
  have hCfun_eq (q : ℝ) : Cfun q =
      -((F : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] K) q := by
    dsimp [Cfun, K]
    exact gaussianDerivAt_fiber_eq_neg_convolution F s q
  have hCfun : Integrable Cfun := by
    apply hconv.neg.congr
    filter_upwards [] with q
    symm
    exact hCfun_eq q
  have hconvcont : Continuous ((F : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] K) :=
    (bddAbove_norm_complex_gaussianDerivAt s 0).continuous_convolution_right_of_integrable
      (ContinuousLinearMap.mul ℂ ℂ) F.integrable
      (continuous_complex_gaussianDerivAt s 0)
  have hCfuncont : Continuous Cfun := by
    apply hconvcont.neg.congr
    intro q
    symm
    exact hCfun_eq q
  obtain ⟨C, hC⟩ := bddAbove_norm_complex_gaussianDerivAt s 0
  have hKbound (v : ℝ) : ‖K v‖ ≤ C := hC ⟨v, rfl⟩
  have hCfunbound (q : ℝ) : ‖Cfun q‖ ≤ (∫ v : ℝ, ‖F v‖) * C := by
    have hmajor : Integrable (fun v : ℝ ↦ ‖F v‖ * C) :=
      F.integrable.norm.mul_const C
    calc
      ‖Cfun q‖ ≤ ∫ v : ℝ,
          ‖F v * (gaussianDerivAt s q v : ℂ)‖ :=
        norm_integral_le_integral_norm _
      _ ≤ ∫ v : ℝ, ‖F v‖ * C := by
        apply MeasureTheory.integral_mono_of_nonneg
        · filter_upwards [] with v
          exact norm_nonneg _
        · exact hmajor
        filter_upwards [] with v
        rw [norm_mul]
        apply mul_le_mul_of_nonneg_left
        · rw [gaussianDerivAt_reflect]
          push_cast
          simpa [K, Complex.norm_real, Real.norm_eq_abs] using hKbound (q - v)
        · exact norm_nonneg _
      _ = (∫ v : ℝ, ‖F v‖) * C := by
        rw [integral_mul_const]
  have hDnonneg : 0 ≤ (∫ v : ℝ, ‖F v‖) * C := by
    exact (norm_nonneg (Cfun 0)).trans (hCfunbound 0)
  have hnormsq : Integrable (fun q : ℝ ↦ ‖Cfun q‖ ^ 2) :=
    integrable_sq_of_integrable_bounded (fun q ↦ ‖Cfun q‖) hCfun.norm
      ((∫ v : ℝ, ‖F v‖) * C) hDnonneg (by
        intro q
        simpa only [abs_norm] using hCfunbound q)
  simpa only [Cfun] using hnormsq

/-- The physical one-dimensional square function of every complex Schwartz
fiber is jointly integrable in positive scale and center. -/
theorem integrable_schwartz_fiber_physical_square
    (F : SchwartzMap ℝ ℂ) (n : ℕ) (hn : 0 < n) :
    Integrable (fun z : ℝ × ℝ ↦
      ‖∫ v : ℝ, F v * (gaussianDerivAt (z.1 ^ n) z.2 v : ℂ)‖ ^ 2 / z.1)
      ((volume.restrict (Set.Ioi (0 : ℝ))).prod volume) := by
  let μ : Measure ℝ := volume.restrict (Set.Ioi (0 : ℝ))
  let J : ℝ × ℝ → ℂ := fun z ↦
    ∫ v : ℝ, F v * (gaussianDerivAt (z.1 ^ n) z.2 v : ℂ)
  let H : ℝ × ℝ → ℝ := fun z ↦ ‖J z‖ ^ 2 / z.1
  let M : ℝ → ℝ := fun ξ ↦ ‖𝓕 (F : ℝ → ℂ) ξ‖ ^ 2
  have hkernel_meas : Measurable (fun qv : (ℝ × ℝ) × ℝ ↦
      F qv.2 * (gaussianDerivAt (qv.1.1 ^ n) qv.1.2 qv.2 : ℂ)) := by
    have ht : Measurable (fun qv : (ℝ × ℝ) × ℝ ↦ qv.1.1 ^ n) :=
      (measurable_fst.comp measurable_fst).pow_const _
    have hq : Measurable (fun qv : (ℝ × ℝ) × ℝ ↦ qv.1.2) :=
      measurable_snd.comp measurable_fst
    have hv : Measurable (fun qv : (ℝ × ℝ) × ℝ ↦ qv.2) := measurable_snd
    have hderiv : Measurable gaussianDeriv := by
      unfold gaussianDeriv
      exact (measurable_const.mul measurable_id).mul
        gaussian_contDiff.continuous.measurable
    have hkernel : Measurable (fun qv : (ℝ × ℝ) × ℝ ↦
        gaussianDerivAt (qv.1.1 ^ n) qv.1.2 qv.2) :=
      measurable_kernelAt gaussianDeriv hderiv
        _ _ _ ht hq hv
    exact (F.continuous.measurable.comp hv).mul
      (Complex.continuous_ofReal.measurable.comp hkernel)
  have hJmeas : AEStronglyMeasurable J (μ.prod volume) := by
    have hfull : AEStronglyMeasurable (fun qv : (ℝ × ℝ) × ℝ ↦
        F qv.2 * (gaussianDerivAt (qv.1.1 ^ n) qv.1.2 qv.2 : ℂ))
        ((μ.prod volume).prod volume) := hkernel_meas.aestronglyMeasurable
    simpa only [J] using hfull.integral_prod_right'
  have hHmeas : AEStronglyMeasurable H (μ.prod volume) := by
    dsimp [H]
    have hmul := (hJmeas.norm.pow 2).mul
      ((measurable_fst : Measurable fun z : ℝ × ℝ ↦ z.1).inv.aestronglyMeasurable)
    apply hmul.congr
    filter_upwards [] with z
    rfl
  have hM : Integrable M := by
    have hmem : MemLp (𝓕 F : SchwartzMap ℝ ℂ) 2 (volume : Measure ℝ) :=
      (𝓕 F).memLp 2 volume
    have hsq : Integrable (fun ξ : ℝ ↦
        ‖(𝓕 F : SchwartzMap ℝ ℂ) ξ‖ ^ 2) :=
      (memLp_two_iff_integrable_sq_norm
        (𝓕 F : SchwartzMap ℝ ℂ).continuous.aestronglyMeasurable).mp hmem
    simpa only [M, SchwartzMap.fourier_coe] using hsq
  have hfreq : Integrable (fun z : ℝ × ℝ ↦
      M z.2 * (gaussianDeriv (z.1 ^ n * z.2) ^ 2 / z.1)) (μ.prod volume) := by
    exact integrable_calderon_joint_of_integrable n hn M hM
      (fun ξ ↦ sq_nonneg _)
  have hfreqOuter : Integrable (fun t : ℝ ↦
      ∫ ξ : ℝ, ‖M ξ * (gaussianDeriv (t ^ n * ξ) ^ 2 / t)‖) μ :=
    (integrable_prod_iff hfreq.aestronglyMeasurable).mp hfreq |>.2
  have hfixed : ∀ᵐ t : ℝ ∂μ,
      (∫ q : ℝ, H (t, q)) =
        ∫ ξ : ℝ, M ξ * (gaussianDeriv (t ^ n * ξ) ^ 2 / t) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    have hscale : 0 < t ^ n := pow_pos ht n
    dsimp [H, J]
    rw [show (∫ q : ℝ,
      ‖∫ v : ℝ, F v * (gaussianDerivAt (t ^ n) q v : ℂ)‖ ^ 2 / t) =
        (∫ q : ℝ,
          ‖∫ v : ℝ, F v * (gaussianDerivAt (t ^ n) q v : ℂ)‖ ^ 2) / t by
      rw [integral_div],
      integral_norm_sq_gaussianDeriv_fiber F (t ^ n) hscale,
      ← integral_div]
    apply integral_congr_ae
    filter_upwards [] with ξ
    dsimp only [M]
    ring
  have hsections : ∀ᵐ t : ℝ ∂μ, Integrable (fun q : ℝ ↦ H (t, q)) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    have hscale : 0 < t ^ n := pow_pos ht n
    have hsq := integrable_norm_sq_gaussianDeriv_fiber F (t ^ n) hscale
    simpa only [H, J] using hsq.div_const t
  have houter : Integrable (fun t : ℝ ↦ ∫ q : ℝ, ‖H (t, q)‖) μ := by
    apply hfreqOuter.congr
    filter_upwards [ae_restrict_mem measurableSet_Ioi, hfixed] with t ht hfixed
    have hHnonneg (q : ℝ) : 0 ≤ H (t, q) := by
      dsimp [H]
      exact div_nonneg (sq_nonneg _) ht.le
    have hKnonneg (ξ : ℝ) :
        0 ≤ M ξ * (gaussianDeriv (t ^ n * ξ) ^ 2 / t) := by
      exact mul_nonneg (sq_nonneg _)
        (div_nonneg (sq_nonneg _) ht.le)
    symm
    calc
      (∫ q : ℝ, ‖H (t, q)‖) = ∫ q : ℝ, H (t, q) := by
        apply integral_congr_ae
        filter_upwards [] with q
        rw [Real.norm_eq_abs, abs_of_nonneg (hHnonneg q)]
      _ = ∫ ξ : ℝ, M ξ * (gaussianDeriv (t ^ n * ξ) ^ 2 / t) := hfixed
      _ = ∫ ξ : ℝ, ‖M ξ * (gaussianDeriv (t ^ n * ξ) ^ 2 / t)‖ := by
        symm
        apply integral_congr_ae
        filter_upwards [] with ξ
        rw [Real.norm_eq_abs, abs_of_nonneg (hKnonneg ξ)]
  have hmain : Integrable H (μ.prod volume) :=
    (integrable_prod_iff hHmeas).mpr ⟨hsections, houter⟩
  simpa only [H, J, μ] using hmain

/-- Passing from `dt/t` to the literal `cubeScaleDensity` measure preserves
integrability of a positive-scale scalar square function. -/
theorem integrable_with_cubeScaleDensity_of_integrable_div
    (B : ℝ × ℝ → ℝ)
    (hB : Integrable (fun z : ℝ × ℝ ↦ B z / z.1)
      ((volume.restrict (Set.Ioi (0 : ℝ))).prod volume)) :
    Integrable B
      ((((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))).prod volume) := by
  let μ : Measure ℝ := volume.restrict (Set.Ioi (0 : ℝ))
  have hpos : ∀ᵐ z : ℝ × ℝ ∂(μ.prod volume), 0 < z.1 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
      exact Filter.Eventually.of_forall fun _ ↦ ht
    · exact measurableSet_Ioi.preimage measurable_fst
  have htop : ∀ᵐ z : ℝ × ℝ ∂(μ.prod volume),
      cubeScaleDensity z.1 < ∞ := by
    filter_upwards [hpos] with z hz
    rw [cubeScaleDensity_eq_of_pos hz]
    exact ENNReal.ofReal_lt_top
  change Integrable B (((volume.withDensity cubeScaleDensity).restrict
    (Set.Ioi (0 : ℝ))).prod volume)
  rw [restrict_withDensity measurableSet_Ioi,
    prod_withDensity_left measurable_cubeScaleDensity]
  change Integrable B ((μ.prod volume).withDensity (cubeScaleDensity ∘ Prod.fst))
  rw [integrable_withDensity_iff
    (measurable_cubeScaleDensity.comp measurable_fst) htop]
  apply hB.congr
  filter_upwards [hpos] with z hz
  change B z / z.1 = B z * (cubeScaleDensity z.1).toReal
  rw [cubeScaleDensity_eq_of_pos hz,
    ENNReal.toReal_ofReal (inv_pos.mpr hz).le]
  ring

/-- The preceding physical square-function integrability in the real fiber
convention, obtained by complexifying its Schwartz realization. -/
theorem integrable_real_schwartz_fiber_physical_square
    (F : SchwartzMap ℝ ℂ) (g : ℝ → ℝ)
    (hF : ∀ v : ℝ, F v = (g v : ℂ)) (n : ℕ) (hn : 0 < n) :
    Integrable (fun z : ℝ × ℝ ↦
      (∫ v : ℝ, g v * gaussianDerivAt (z.1 ^ n) z.2 v) ^ 2 / z.1)
      ((volume.restrict (Set.Ioi (0 : ℝ))).prod volume) := by
  apply (integrable_schwartz_fiber_physical_square F n hn).congr
  filter_upwards [] with z
  rw [complexFiberIntegral_eq_real F g hF]
  simp

/-- The real Schwartz fiber square function is integrable for the literal
positive logarithmic scale measure. -/
theorem integrable_real_schwartz_fiber_with_cubeScaleDensity
    (F : SchwartzMap ℝ ℂ) (g : ℝ → ℝ)
    (hF : ∀ v : ℝ, F v = (g v : ℂ)) (n : ℕ) (hn : 0 < n) :
    Integrable (fun z : ℝ × ℝ ↦
      (∫ v : ℝ, g v * gaussianDerivAt (z.1 ^ n) z.2 v) ^ 2)
      ((((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))).prod volume) := by
  apply integrable_with_cubeScaleDensity_of_integrable_div
  exact integrable_real_schwartz_fiber_physical_square F g hF n hn

/-- The reduced third-coordinate square function of a real Schwartz input
is jointly integrable in its two transverse coordinates, center, and the
literal logarithmic scale measure. -/
theorem integrable_modelThirdSquare_global_of_real_schwartz
    (α : Anisotropy) (f : SchwartzMap E3 ℝ) :
    Integrable (fun z : (ℝ × ℝ) × (ℝ × ℝ) ↦
      (∫ v : ℝ, f (modelPoint z.1.1 z.1.2 v) *
        gaussianDerivAt (z.2.2 ^ α.weight 2) z.2.1 v) ^ 2)
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod
          (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
            (Set.Ioi (0 : ℝ))))) := by
  let ν : Measure ℝ :=
    ((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
      (Set.Ioi (0 : ℝ))
  let G : (ℝ × ℝ) × (ℝ × ℝ) → ℝ := fun z ↦
    (∫ v : ℝ, f (modelPoint z.1.1 z.1.2 v) *
      gaussianDerivAt (z.2.2 ^ α.weight 2) z.2.1 v) ^ 2
  have hkernel_meas : Measurable (fun qv : ((ℝ × ℝ) × (ℝ × ℝ)) × ℝ ↦
      f (modelPoint qv.1.1.1 qv.1.1.2 qv.2) *
        gaussianDerivAt (qv.1.2.2 ^ α.weight 2) qv.1.2.1 qv.2) := by
    have hx₁ : Measurable (fun qv : ((ℝ × ℝ) × (ℝ × ℝ)) × ℝ ↦ qv.1.1.1) :=
      measurable_fst.comp (measurable_fst.comp measurable_fst)
    have hx₂ : Measurable (fun qv : ((ℝ × ℝ) × (ℝ × ℝ)) × ℝ ↦ qv.1.1.2) :=
      measurable_snd.comp (measurable_fst.comp measurable_fst)
    have ht : Measurable (fun qv : ((ℝ × ℝ) × (ℝ × ℝ)) × ℝ ↦
        qv.1.2.2 ^ α.weight 2) :=
      (measurable_snd.comp (measurable_snd.comp measurable_fst)).pow_const _
    have hp : Measurable (fun qv : ((ℝ × ℝ) × (ℝ × ℝ)) × ℝ ↦ qv.1.2.1) :=
      measurable_fst.comp (measurable_snd.comp measurable_fst)
    have hv : Measurable (fun qv : ((ℝ × ℝ) × (ℝ × ℝ)) × ℝ ↦ qv.2) :=
      measurable_snd
    have hinput : Measurable (fun qv : ((ℝ × ℝ) × (ℝ × ℝ)) × ℝ ↦
        f (modelPoint qv.1.1.1 qv.1.1.2 qv.2)) :=
      f.continuous.measurable.comp
        (measurable_modelPoint _ _ _ hx₁ hx₂ hv)
    have hderiv : Measurable gaussianDeriv := by
      unfold gaussianDeriv
      exact (measurable_const.mul measurable_id).mul
        gaussian_contDiff.continuous.measurable
    have hkernel : Measurable (fun qv : ((ℝ × ℝ) × (ℝ × ℝ)) × ℝ ↦
        gaussianDerivAt (qv.1.2.2 ^ α.weight 2) qv.1.2.1 qv.2) :=
      measurable_kernelAt gaussianDeriv hderiv _ _ _ ht hp hv
    exact hinput.mul hkernel
  have hGmeas : AEStronglyMeasurable G
      ((((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ν))) := by
    have hpre : AEStronglyMeasurable (fun z : (ℝ × ℝ) × (ℝ × ℝ) ↦
        ∫ v : ℝ, f (modelPoint z.1.1 z.1.2 v) *
          gaussianDerivAt (z.2.2 ^ α.weight 2) z.2.1 v)
        ((((volume : Measure ℝ).prod volume).prod
          ((volume : Measure ℝ).prod ν))) := by
      have hfull : AEStronglyMeasurable (fun qv :
          ((ℝ × ℝ) × (ℝ × ℝ)) × ℝ ↦
          f (modelPoint qv.1.1.1 qv.1.1.2 qv.2) *
            gaussianDerivAt (qv.1.2.2 ^ α.weight 2) qv.1.2.1 qv.2)
          (((((volume : Measure ℝ).prod volume).prod
            ((volume : Measure ℝ).prod ν)).prod volume)) :=
        hkernel_meas.aestronglyMeasurable
      exact hfull.integral_prod_right'
    have hsq := hpre.pow 2
    apply hsq.congr
    filter_upwards [] with z
    rfl
  have hsections_all (x : ℝ × ℝ) : Integrable (fun pt : ℝ × ℝ ↦ G (x, pt))
      ((volume : Measure ℝ).prod ν) := by
    let F : SchwartzMap ℝ ℂ :=
      modelThirdSchwartzFiber (complexifyRealSchwartz f) x.1 x.2
    let g : ℝ → ℝ := fun v ↦ f (modelPoint x.1 x.2 v)
    have hF (v : ℝ) : F v = (g v : ℂ) := by
      dsimp [F, g]
      simp
    have hdensity : Integrable (fun z : ℝ × ℝ ↦
        (∫ v : ℝ, g v * gaussianDerivAt (z.1 ^ α.weight 2) z.2 v) ^ 2)
        (ν.prod volume) := by
      simpa only [ν] using
        integrable_real_schwartz_fiber_with_cubeScaleDensity
          F g hF (α.weight 2) (α.weight_pos 2)
    have hswap := hdensity.swap
    apply hswap.congr
    filter_upwards [] with pt
    rcases pt with ⟨p₂, t⟩
    rfl
  have hfsq : Integrable (fun y : E3 ↦ f y ^ 2) :=
    (memLp_two_iff_integrable_sq f.continuous.aestronglyMeasurable).mp
      (f.memLp 2 volume)
  let R : (ℝ × ℝ) × ℝ → ℝ := fun z ↦
    f (modelPoint z.1.1 z.1.2 z.2) ^ 2
  have hR : Integrable R (((volume : Measure ℝ).prod volume).prod volume) := by
    let e : E3 ≃ᵐ ℝ × (ℝ × ℝ) := e3Coordinates
    let R' : ℝ × (ℝ × ℝ) → ℝ := fun z ↦
      f (modelPoint z.1 z.2.1 z.2.2) ^ 2
    have hmp : MeasurePreserving e (volume : Measure E3)
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
      simpa only [e] using e3Coordinates_measurePreserving
    have hR' : Integrable R'
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
      have htrans := (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hfsq
      apply htrans.congr
      filter_upwards [] with z
      rcases z with ⟨x₁, x₂, v⟩
      simp only [Function.comp_apply, R', e]
      congr 2
      apply e.injective
      simp only [e, e3Coordinates_apply]
      exact Prod.ext rfl (Prod.ext rfl rfl)
    have hassoc := measurePreserving_prodAssoc
      (volume : Measure ℝ) (volume : Measure ℝ) (volume : Measure ℝ)
    have htrans := hassoc.integrable_comp_of_integrable hR'
    apply htrans.congr
    filter_upwards [] with z
    rcases z with ⟨⟨x₁, x₂⟩, v⟩
    rfl
  let L : ℝ × ℝ → ℝ := fun x ↦
    ∫ v : ℝ, f (modelPoint x.1 x.2 v) ^ 2
  have hL : Integrable L ((volume : Measure ℝ).prod volume) := by
    have houter := (integrable_prod_iff hR.aestronglyMeasurable).mp hR |>.2
    apply houter.congr
    filter_upwards [] with x
    dsimp [L, R]
    apply integral_congr_ae
    filter_upwards [] with v
    rw [abs_of_nonneg (sq_nonneg _)]
  let C : ℝ := Real.pi / (α.weight 2 : ℝ)
  have hinner_value (x : ℝ × ℝ) :
      (∫ pt : ℝ × ℝ, G (x, pt) ∂((volume : Measure ℝ).prod ν)) =
        C * L x := by
    have hx := hsections_all x
    calc
      (∫ pt : ℝ × ℝ, G (x, pt) ∂((volume : Measure ℝ).prod ν)) =
          ∫ p₂ : ℝ, (∫ t : ℝ, G (x, (p₂, t)) ∂ν) :=
        integral_prod _ hx
      _ = ∫ t : ℝ, (∫ p₂ : ℝ, G (x, (p₂, t))) ∂ν := by
        exact integral_integral_swap hx
      _ = ∫ t : ℝ in Set.Ioi (0 : ℝ), (∫ p₂ : ℝ,
          (∫ v : ℝ, f (modelPoint x.1 x.2 v) *
            gaussianDerivAt (t ^ α.weight 2) p₂ v) ^ 2)
          ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
            dsimp [G, ν]
      _ = ∫ t : ℝ in Set.Ioi (0 : ℝ),
          (∫ p₂ : ℝ,
            (∫ v : ℝ, f (modelPoint x.1 x.2 v) *
              gaussianDerivAt (t ^ α.weight 2) p₂ v) ^ 2) / t := by
            exact integral_Ioi_withDensity_cubeScaleDensity_eq
              (fun t : ℝ ↦ ∫ p₂ : ℝ,
                (∫ v : ℝ, f (modelPoint x.1 x.2 v) *
                  gaussianDerivAt (t ^ α.weight 2) p₂ v) ^ 2)
      _ = ∫ t : ℝ in Set.Ioi (0 : ℝ), ∫ p₂ : ℝ,
          (∫ v : ℝ, f (modelPoint x.1 x.2 v) *
            gaussianDerivAt (t ^ α.weight 2) p₂ v) ^ 2 / t := by
            apply setIntegral_congr_fun measurableSet_Ioi
            intro t ht
            change (∫ p₂ : ℝ,
              (∫ v : ℝ, f (modelPoint x.1 x.2 v) *
                gaussianDerivAt (t ^ α.weight 2) p₂ v) ^ 2) / t =
              ∫ p₂ : ℝ,
                (∫ v : ℝ, f (modelPoint x.1 x.2 v) *
                  gaussianDerivAt (t ^ α.weight 2) p₂ v) ^ 2 / t
            rw [← integral_div]
      _ = C * L x := by
            dsimp [C, L]
            exact modelThird_square_function_of_real_schwartz α f x.1 x.2
  have houter : Integrable (fun x : ℝ × ℝ ↦
      ∫ pt : ℝ × ℝ, ‖G (x, pt)‖ ∂((volume : Measure ℝ).prod ν))
      ((volume : Measure ℝ).prod volume) := by
    have hmajor : Integrable (fun x : ℝ × ℝ ↦ C * L x) := hL.const_mul C
    apply hmajor.congr
    filter_upwards [] with x
    symm
    calc
      (∫ pt : ℝ × ℝ, ‖G (x, pt)‖ ∂((volume : Measure ℝ).prod ν)) =
          ∫ pt : ℝ × ℝ, G (x, pt) ∂((volume : Measure ℝ).prod ν) := by
            apply integral_congr_ae
            filter_upwards [] with pt
            rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
      _ = C * L x := hinner_value x
  have hmain : Integrable G
      (((volume : Measure ℝ).prod volume).prod ((volume : Measure ℝ).prod ν)) :=
    (integrable_prod_iff hGmeas).mpr
      ⟨Filter.Eventually.of_forall hsections_all, houter⟩
  simpa only [G, ν] using hmain

/-- Regroup the reduced-tail variables from `((x,t),(p,r))` to
`((x,(p,t)),r)`, retaining the literal product measures. -/
noncomputable def tailReorder
    (X : Type*) [MeasurableSpace X] :
    ((X × ℝ) × (ℝ × ℝ)) ≃ᵐ ((X × (ℝ × ℝ)) × ℝ) :=
  (((MeasurableEquiv.prodAssoc :
      (X × ℝ) × (ℝ × ℝ) ≃ᵐ X × (ℝ × (ℝ × ℝ))).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl X)
      (swapMiddle ℝ ℝ ℝ))).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl X)
      (MeasurableEquiv.prodAssoc.symm :
        ℝ × (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) × ℝ))).trans
    (MeasurableEquiv.prodAssoc.symm :
      X × ((ℝ × ℝ) × ℝ) ≃ᵐ (X × (ℝ × ℝ)) × ℝ)

@[simp] theorem tailReorder_apply
    (X : Type*) [MeasurableSpace X] (x : X) (t p r : ℝ) :
    tailReorder X ((x, t), (p, r)) = ((x, (p, t)), r) := by
  simp [tailReorder, swapMiddle,
    MeasurableEquiv.prodAssoc, MeasurableEquiv.prodComm,
    MeasurableEquiv.prodCongr]

/-- The tail regrouping is measure preserving for arbitrary sigma-finite
outer and scale measures. -/
theorem tailReorder_measurePreserving
    (X : Type*) [MeasurableSpace X] (μX : Measure X) (ν : Measure ℝ)
    [SFinite μX] [SFinite ν] :
    MeasurePreserving (tailReorder X)
      ((μX.prod ν).prod ((volume : Measure ℝ).prod volume))
      ((μX.prod ((volume : Measure ℝ).prod ν)).prod volume) := by
  let h₁ : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        (X × ℝ) × (ℝ × ℝ) ≃ᵐ X × (ℝ × (ℝ × ℝ)))
      ((μX.prod ν).prod ((volume : Measure ℝ).prod volume))
      (μX.prod (ν.prod ((volume : Measure ℝ).prod volume))) :=
    measurePreserving_prodAssoc μX ν ((volume : Measure ℝ).prod volume)
  let h₂ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl X)
        (swapMiddle ℝ ℝ ℝ))
      (μX.prod (ν.prod ((volume : Measure ℝ).prod volume)))
      (μX.prod ((volume : Measure ℝ).prod (ν.prod volume))) :=
    (MeasurePreserving.id μX).prod
      (swapMiddle_measurePreserving ℝ ℝ ℝ ν volume volume)
  let h₃ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl X)
        (MeasurableEquiv.prodAssoc.symm :
          ℝ × (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) × ℝ))
      (μX.prod ((volume : Measure ℝ).prod (ν.prod volume)))
      (μX.prod (((volume : Measure ℝ).prod ν).prod volume)) :=
    (MeasurePreserving.id μX).prod
      (measurePreserving_prodAssoc (volume : Measure ℝ) ν volume).symm
  let h₄ : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        X × ((ℝ × ℝ) × ℝ) ≃ᵐ (X × (ℝ × ℝ)) × ℝ)
      (μX.prod (((volume : Measure ℝ).prod ν).prod volume))
      ((μX.prod ((volume : Measure ℝ).prod ν)).prod volume) :=
    (measurePreserving_prodAssoc μX ((volume : Measure ℝ).prod ν) volume).symm
  simpa only [tailReorder] using ((h₁.trans h₂).trans h₃).trans h₄

/-- The reduced square-tail density is a.e.-strongly measurable on every
product measure for a continuous real input. -/
theorem aestronglyMeasurable_reducedTail
    (α : Anisotropy) (u : E3) (f : E3 → ℝ) (hf : Continuous f)
    (μ : Measure (((ℝ × ℝ) × ℝ) × (ℝ × ℝ))) :
    AEStronglyMeasurable (fun z : ((ℝ × ℝ) × ℝ) × (ℝ × ℝ) ↦
      (modelSecondFiberReduced α f z.1.1.1 z.1.1.2 z.2.1 z.1.2 z.2.2) ^ 2 *
        |conePsiPhysicalReal (z.2.2 + u 2)|) μ := by
  have hx₁ : Measurable (fun qv : (((ℝ × ℝ) × ℝ) × (ℝ × ℝ)) × ℝ ↦
      qv.1.1.1.1) :=
    measurable_fst.comp (measurable_fst.comp
      (measurable_fst.comp measurable_fst))
  have hx₂ : Measurable (fun qv : (((ℝ × ℝ) × ℝ) × (ℝ × ℝ)) × ℝ ↦
      qv.1.1.1.2) :=
    measurable_snd.comp (measurable_fst.comp
      (measurable_fst.comp measurable_fst))
  have ht : Measurable (fun qv : (((ℝ × ℝ) × ℝ) × (ℝ × ℝ)) × ℝ ↦
      qv.1.1.2 ^ α.weight 2) :=
    (measurable_snd.comp (measurable_fst.comp measurable_fst)).pow_const _
  have hp : Measurable (fun qv : (((ℝ × ℝ) × ℝ) × (ℝ × ℝ)) × ℝ ↦
      qv.1.2.1) :=
    measurable_fst.comp (measurable_snd.comp measurable_fst)
  have hr : Measurable (fun qv : (((ℝ × ℝ) × ℝ) × (ℝ × ℝ)) × ℝ ↦
      qv.1.2.2) :=
    measurable_snd.comp (measurable_snd.comp measurable_fst)
  have hv : Measurable (fun qv : (((ℝ × ℝ) × ℝ) × (ℝ × ℝ)) × ℝ ↦
      qv.2) := measurable_snd
  have hinput : Measurable (fun qv : (((ℝ × ℝ) × ℝ) × (ℝ × ℝ)) × ℝ ↦
      f (modelPoint qv.1.1.1.1 qv.1.1.1.2 qv.2)) :=
    hf.measurable.comp (measurable_modelPoint _ _ _ hx₁ hx₂ hv)
  have hderiv : Measurable gaussianDeriv := by
    unfold gaussianDeriv
    exact (measurable_const.mul measurable_id).mul
      gaussian_contDiff.continuous.measurable
  have hcenter : Measurable (fun qv : (((ℝ × ℝ) × ℝ) × (ℝ × ℝ)) × ℝ ↦
      qv.1.2.1 + qv.1.2.2 * qv.1.1.2 ^ α.weight 2) :=
    hp.add (hr.mul ht)
  have hkernel : Measurable (fun qv : (((ℝ × ℝ) × ℝ) × (ℝ × ℝ)) × ℝ ↦
      gaussianDerivAt (qv.1.1.2 ^ α.weight 2)
        (qv.1.2.1 + qv.1.2.2 * qv.1.1.2 ^ α.weight 2) qv.2) :=
    measurable_kernelAt gaussianDeriv hderiv _ _ _ ht hcenter hv
  have hpre : AEStronglyMeasurable (fun z : ((ℝ × ℝ) × ℝ) × (ℝ × ℝ) ↦
      ∫ v : ℝ, f (modelPoint z.1.1.1 z.1.1.2 v) *
        gaussianDerivAt (z.1.2 ^ α.weight 2)
          (z.2.1 + z.2.2 * z.1.2 ^ α.weight 2) v) μ := by
    have hfull : AEStronglyMeasurable (fun qv :
        (((ℝ × ℝ) × ℝ) × (ℝ × ℝ)) × ℝ ↦
        f (modelPoint qv.1.1.1.1 qv.1.1.1.2 qv.2) *
          gaussianDerivAt (qv.1.1.2 ^ α.weight 2)
            (qv.1.2.1 + qv.1.2.2 * qv.1.1.2 ^ α.weight 2) qv.2)
        (μ.prod volume) := (hinput.mul hkernel).aestronglyMeasurable
    exact hfull.integral_prod_right'
  have htail : AEStronglyMeasurable (fun z : ((ℝ × ℝ) × ℝ) × (ℝ × ℝ) ↦
      |conePsiPhysicalReal (z.2.2 + u 2)|) μ := by
    have hmeas : Measurable (fun z : ((ℝ × ℝ) × ℝ) × (ℝ × ℝ) ↦
        conePsiPhysicalReal (z.2.2 + u 2)) :=
      conePsiPhysicalReal.continuous.measurable.comp
        ((measurable_snd.comp measurable_snd).add measurable_const)
    simpa only [Real.norm_eq_abs] using hmeas.aestronglyMeasurable.norm
  have hsq := hpre.pow 2
  have hmul := hsq.mul htail
  apply hmul.congr
  filter_upwards [] with z
  rfl

/-- The reduced translation tail is jointly integrable over all transverse
coordinates, third-coordinate centers, positive scales, and translations for
a real Schwartz input. -/
theorem integrable_reducedTail_global_of_real_schwartz
    (α : Anisotropy) (u : E3) (f : SchwartzMap E3 ℝ) :
    Integrable (fun z : ((ℝ × ℝ) × (ℝ × ℝ)) × ℝ ↦
      (modelSecondFiberReduced α f z.1.1.1 z.1.1.2 z.1.2.1 z.1.2.2 z.2) ^ 2 *
        |conePsiPhysicalReal (z.2 + u 2)|)
      ((((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod
          (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
            (Set.Ioi (0 : ℝ))))).prod volume) := by
  let ν : Measure ℝ :=
    ((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
      (Set.Ioi (0 : ℝ))
  let μX : Measure (ℝ × ℝ) := (volume : Measure ℝ).prod volume
  let K : ((ℝ × ℝ) × ℝ) × (ℝ × ℝ) → ℝ := fun z ↦
    (modelSecondFiberReduced α f z.1.1.1 z.1.1.2 z.2.1 z.1.2 z.2.2) ^ 2 *
      |conePsiPhysicalReal (z.2.2 + u 2)|
  have hKmeas : AEStronglyMeasurable K
      ((μX.prod ν).prod ((volume : Measure ℝ).prod volume)) := by
    simpa only [K] using aestronglyMeasurable_reducedTail α u f
      f.continuous ((μX.prod ν).prod ((volume : Measure ℝ).prod volume))
  have htpos : ∀ᵐ a : (ℝ × ℝ) × ℝ ∂(μX.prod ν), 0 < a.2 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [] with x
      filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
      exact ht
    · exact measurableSet_Ioi.preimage measurable_snd
  have hsection_of_pos (a : (ℝ × ℝ) × ℝ) (ha : 0 < a.2) :
      Integrable (fun pr : ℝ × ℝ ↦ K (a, pr))
        ((volume : Measure ℝ).prod volume) := by
    exact integrable_modelSecondFiberReduced_p2_r_of_real_schwartz
      α u f a.1.1 a.1.2 a.2 ha
  have hsections : ∀ᵐ a : (ℝ × ℝ) × ℝ ∂(μX.prod ν),
      Integrable (fun pr : ℝ × ℝ ↦ K (a, pr))
        ((volume : Measure ℝ).prod volume) := by
    filter_upwards [htpos] with a ha
    exact hsection_of_pos a ha
  let G : (ℝ × ℝ) × (ℝ × ℝ) → ℝ := fun z ↦
    (∫ v : ℝ, f (modelPoint z.1.1 z.1.2 v) *
      gaussianDerivAt (z.2.2 ^ α.weight 2) z.2.1 v) ^ 2
  have hG : Integrable G (μX.prod ((volume : Measure ℝ).prod ν)) := by
    simpa only [G, μX, ν] using
      integrable_modelThirdSquare_global_of_real_schwartz α f
  let e : (ℝ × ℝ) × (ℝ × ℝ) ≃ᵐ ((ℝ × ℝ) × ℝ) × ℝ :=
    (swapMiddle (ℝ × ℝ) ℝ ℝ).trans MeasurableEquiv.prodComm
  have hmp : MeasurePreserving e (μX.prod ((volume : Measure ℝ).prod ν))
      ((μX.prod ν).prod volume) := by
    let h₁ : MeasurePreserving (swapMiddle (ℝ × ℝ) ℝ ℝ)
        (μX.prod ((volume : Measure ℝ).prod ν))
        ((volume : Measure ℝ).prod (μX.prod ν)) :=
      swapMiddle_measurePreserving (ℝ × ℝ) ℝ ℝ μX volume ν
    let h₂ : MeasurePreserving (MeasurableEquiv.prodComm :
        ℝ × ((ℝ × ℝ) × ℝ) ≃ᵐ ((ℝ × ℝ) × ℝ) × ℝ)
        ((volume : Measure ℝ).prod (μX.prod ν))
        ((μX.prod ν).prod volume) :=
      Measure.measurePreserving_swap
    simpa only [e] using h₁.trans h₂
  have hGswap_raw :=
    (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hG
  have hGswap : Integrable (fun a : ((ℝ × ℝ) × ℝ) × ℝ ↦
      (∫ v : ℝ, f (modelPoint a.1.1.1 a.1.1.2 v) *
        gaussianDerivAt (a.1.2 ^ α.weight 2) a.2 v) ^ 2)
      ((μX.prod ν).prod volume) := by
    apply hGswap_raw.congr
    filter_upwards [] with a
    rcases a with ⟨⟨⟨x₁, x₂⟩, t⟩, p₂⟩
    rfl
  have hQ : Integrable (fun a : (ℝ × ℝ) × ℝ ↦
      ∫ p₂ : ℝ, (∫ v : ℝ, f (modelPoint a.1.1 a.1.2 v) *
        gaussianDerivAt (a.2 ^ α.weight 2) p₂ v) ^ 2)
      (μX.prod ν) := hGswap.integral_prod_left
  have houter : Integrable (fun a : (ℝ × ℝ) × ℝ ↦
      ∫ pr : ℝ × ℝ, ‖K (a, pr)‖)
      (μX.prod ν) := by
    have hmajor : Integrable (fun a : (ℝ × ℝ) × ℝ ↦
        conePsiPhysicalRealL1 *
          ∫ p₂ : ℝ, (∫ v : ℝ, f (modelPoint a.1.1 a.1.2 v) *
            gaussianDerivAt (a.2 ^ α.weight 2) p₂ v) ^ 2)
        (μX.prod ν) := hQ.const_mul conePsiPhysicalRealL1
    apply hmajor.congr
    filter_upwards [htpos] with a ha
    have hsection := hsection_of_pos a ha
    symm
    calc
      (∫ pr : ℝ × ℝ, ‖K (a, pr)‖) =
          ∫ pr : ℝ × ℝ, K (a, pr) := by
            apply integral_congr_ae
            filter_upwards [] with pr
            rw [Real.norm_eq_abs, abs_of_nonneg]
            exact mul_nonneg (sq_nonneg _) (abs_nonneg _)
      _ = ∫ p₂ : ℝ, ∫ r : ℝ, K (a, (p₂, r)) :=
        integral_prod _ hsection
      _ = conePsiPhysicalRealL1 *
          ∫ q : ℝ, (∫ v : ℝ, f (modelPoint a.1.1 a.1.2 v) *
            gaussianDerivAt (a.2 ^ α.weight 2) q v) ^ 2 := by
            exact modelSecondFiberReduced_p2_r_reduction α u f a.1.1 a.1.2 a.2
              hsection
  have hK : Integrable K
      ((μX.prod ν).prod ((volume : Measure ℝ).prod volume)) :=
    (integrable_prod_iff hKmeas).mpr ⟨hsections, houter⟩
  let D : ((ℝ × ℝ) × (ℝ × ℝ)) × ℝ → ℝ := fun z ↦
    (modelSecondFiberReduced α f z.1.1.1 z.1.1.2 z.1.2.1 z.1.2.2 z.2) ^ 2 *
      |conePsiPhysicalReal (z.2 + u 2)|
  have htailmp := tailReorder_measurePreserving (ℝ × ℝ) μX ν
  have hD_raw :=
    (MeasurePreserving.symm (tailReorder (ℝ × ℝ)) htailmp).integrable_comp_of_integrable hK
  apply hD_raw.congr
  filter_upwards [] with z
  rcases z with ⟨⟨⟨x₁, x₂⟩, ⟨p₂, t⟩⟩, r⟩
  rfl

/-- The post-scalar density in the global second-energy calculation is
integrable for every real Schwartz input. -/
theorem integrable_reordered_scalar_of_real_schwartz
    (α : Anisotropy) (u : E3) (f : SchwartzMap E3 ℝ) :
    Integrable (fun w : ScratchModelEnergyOuter ↦
      (∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
        (modelSecondFiberReduced α f w.1.1 w.1.2 w.2.1 w.2.2 r) ^ 2) *
        (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2)
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod
          (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
            (Set.Ioi (0 : ℝ)))) ) := by
  let ν : Measure ℝ :=
    ((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
      (Set.Ioi (0 : ℝ))
  let D : ScratchModelEnergyOuter × ℝ → ℝ := fun z ↦
    (modelSecondFiberReduced α f z.1.1.1 z.1.1.2 z.1.2.1 z.1.2.2 z.2) ^ 2 *
      |conePsiPhysicalReal (z.2 + u 2)|
  have hD : Integrable D
      ((((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ν)).prod volume) := by
    simpa only [D, ν] using
      integrable_reducedTail_global_of_real_schwartz α u f
  have hS : Integrable (fun w : ScratchModelEnergyOuter ↦
      ∫ r : ℝ, D (w, r))
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ν)) := hD.integral_prod_left
  have hmain := hS.mul_const ((∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2)
  apply hmain.congr
  filter_upwards [] with w
  dsimp [D]
  apply congrArg (fun q : ℝ ↦ q * (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2)
  apply integral_congr_ae
  filter_upwards [] with r
  ring

/-- The literal three-cone Calderón density.  Naming it makes the passage
from a scalar identity to a complex multiplier identity explicit. -/
noncomputable def coneProductCalderonIntegrand
    (α : Anisotropy) (ξ : E3) (t : ℝ) : ℝ :=
  (((α.weight 0 : ℝ) * conePsi (t ^ (α.weight 0) * ξ 0) *
      gaussianDeriv (t ^ (α.weight 0) * ξ 0) ^ 2) *
    conePhi (t ^ (α.weight 1) * ξ 1) *
      conePhi (t ^ (α.weight 2) * ξ 2) +
    conePhi (t ^ (α.weight 0) * ξ 0) *
      ((α.weight 1 : ℝ) * conePsi (t ^ (α.weight 1) * ξ 1) *
        gaussianDeriv (t ^ (α.weight 1) * ξ 1) ^ 2) *
        conePhi (t ^ (α.weight 2) * ξ 2) +
    conePhi (t ^ (α.weight 0) * ξ 0) *
      conePhi (t ^ (α.weight 1) * ξ 1) *
        ((α.weight 2 : ℝ) * conePsi (t ^ (α.weight 2) * ξ 2) *
          gaussianDeriv (t ^ (α.weight 2) * ξ 2) ^ 2)) / t

theorem integral_coneProductCalderonIntegrand
    (α : Anisotropy) (ξ : E3) (a b : ℝ)
    (ha : 0 < a) (hab : a ≤ b)
    (hsmall : coneProduct α ξ a = cPsi ^ 3)
    (hlarge : coneProduct α ξ b = 0) :
    ∫ t in a..b, coneProductCalderonIntegrand α ξ t = cPsi ^ 3 := by
  simpa only [coneProductCalderonIntegrand] using
    calderon_coneProduct_interval_of_endpoints α ξ a b ha hab hsmall hlarge

/-- The finite cone-product Calderón identity may be multiplied by an
arbitrary complex symbol value before the Fourier-side calculation. -/
theorem multiplier_coneProduct_interval
    (α : Anisotropy) (m : E3 → ℂ) (ξ : E3) (a b : ℝ)
    (ha : 0 < a) (hab : a ≤ b)
    (hsmall : coneProduct α ξ a = cPsi ^ 3)
    (hlarge : coneProduct α ξ b = 0) :
    m ξ = ((cPsi : ℂ) ^ 3)⁻¹ *
      ∫ t in a..b, m ξ * (coneProductCalderonIntegrand α ξ t : ℂ) := by
  have hscalar := integral_coneProductCalderonIntegrand
    α ξ a b ha hab hsmall hlarge
  have hscalarC :
      (∫ t in a..b, (coneProductCalderonIntegrand α ξ t : ℂ)) =
        (cPsi : ℂ) ^ 3 := by
    rw [intervalIntegral.integral_ofReal]
    norm_cast
  have hfactor :
      (∫ t in a..b, m ξ * (coneProductCalderonIntegrand α ξ t : ℂ)) =
        m ξ * ∫ t in a..b, (coneProductCalderonIntegrand α ξ t : ℂ) := by
    rw [intervalIntegral.integral_const_mul]
  rw [hfactor, hscalarC]
  have hc : (cPsi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr cPsi_pos.ne'
  field_simp [hc]

/-- Every nonzero frequency admits a finite cone interval giving the exact
multiplier-valued Calderón identity. -/
theorem exists_multiplier_coneProduct_interval
    (α : Anisotropy) (m : E3 → ℂ) (ξ : E3) (hξ : ξ ≠ 0) :
    ∃ a b : ℝ, 0 < a ∧ a ≤ b ∧
      m ξ = ((cPsi : ℂ) ^ 3)⁻¹ *
        ∫ t in a..b, m ξ *
          (coneProductCalderonIntegrand α ξ t : ℂ) := by
  obtain ⟨a, b, ha, hab, hsmall, hlarge⟩ :=
    exists_coneProduct_endpoints α ξ hξ
  exact ⟨a, b, ha, hab,
    multiplier_coneProduct_interval α m ξ a b ha hab hsmall hlarge⟩

/-- Group the two low-frequency/Gaussian pairs in the five scalar inner
variables, leaving the translation tail last. -/
noncomputable def innerPairReorder :
    ScratchModelEnergyInner ≃ᵐ (ℝ × ℝ) × ((ℝ × ℝ) × ℝ) :=
  ((((MeasurableEquiv.prodAssoc :
      (ℝ × ℝ) × (ℝ × (ℝ × ℝ)) ≃ᵐ ℝ × (ℝ × (ℝ × (ℝ × ℝ)))).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
      (swapMiddle ℝ ℝ (ℝ × ℝ)))).trans
    (MeasurableEquiv.prodAssoc.symm :
      ℝ × (ℝ × (ℝ × (ℝ × ℝ))) ≃ᵐ
        (ℝ × ℝ) × (ℝ × (ℝ × ℝ)))).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (ℝ × ℝ))
      (MeasurableEquiv.prodAssoc.symm :
        ℝ × (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) × ℝ)))

@[simp] theorem innerPairReorder_apply
    (p₀ p₁ y₁ y₂ r : ℝ) :
    innerPairReorder ((p₀, p₁), (y₁, (y₂, r))) =
      ((p₀, y₁), ((p₁, y₂), r)) := by
  simp [innerPairReorder, swapMiddle,
    MeasurableEquiv.prodAssoc, MeasurableEquiv.prodComm,
    MeasurableEquiv.prodCongr]

/-- The inner pair regrouping preserves the literal fivefold Lebesgue
product measure. -/
theorem innerPairReorder_measurePreserving :
    MeasurePreserving innerPairReorder
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))
      (((volume : Measure ℝ).prod volume).prod
        (((volume : Measure ℝ).prod volume).prod volume)) := by
  let h₁ : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        (ℝ × ℝ) × (ℝ × (ℝ × ℝ)) ≃ᵐ ℝ × (ℝ × (ℝ × (ℝ × ℝ))))
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))
      ((volume : Measure ℝ).prod
        ((volume : Measure ℝ).prod
          ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))) :=
    measurePreserving_prodAssoc volume volume
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))
  let h₂ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
        (swapMiddle ℝ ℝ (ℝ × ℝ)))
      ((volume : Measure ℝ).prod
        ((volume : Measure ℝ).prod
          ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))))
      ((volume : Measure ℝ).prod
        ((volume : Measure ℝ).prod
          ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))) :=
    (MeasurePreserving.id (volume : Measure ℝ)).prod
      (swapMiddle_measurePreserving ℝ ℝ (ℝ × ℝ)
        volume volume ((volume : Measure ℝ).prod volume))
  let h₃ : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        ℝ × (ℝ × (ℝ × (ℝ × ℝ))) ≃ᵐ
          (ℝ × ℝ) × (ℝ × (ℝ × ℝ)))
      ((volume : Measure ℝ).prod
        ((volume : Measure ℝ).prod
          ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))))
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) :=
    (measurePreserving_prodAssoc volume volume
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))).symm
  let h₄ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (ℝ × ℝ))
        (MeasurableEquiv.prodAssoc.symm :
          ℝ × (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) × ℝ))
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))
      (((volume : Measure ℝ).prod volume).prod
        (((volume : Measure ℝ).prod volume).prod volume)) :=
    (MeasurePreserving.id ((volume : Measure ℝ).prod volume)).prod
      (measurePreserving_prodAssoc (volume : Measure ℝ)
        (volume : Measure ℝ) (volume : Measure ℝ)).symm
  simpa only [innerPairReorder] using ((h₁.trans h₂).trans h₃).trans h₄

/-- Two independent low-frequency/Gaussian pairs may be multiplied with any
integrable translation tail on the literal fivefold product space. -/
theorem integrable_two_modelPhi_gaussian_pairs_mul_tail
    (s₀ s₁ c₀ c₁ x₀ x₁ : ℝ) (hs₀ : 0 < s₀) (hs₁ : 0 < s₁)
    (T : ℝ → ℝ) (hT : Integrable T) :
    Integrable (fun z : (ℝ × ℝ) × ((ℝ × ℝ) × ℝ) ↦
      (|modelPhiAt s₀ (z.1.1 + c₀) x₀| * gaussianAt s₀ z.1.1 z.1.2) *
        ((|modelPhiAt s₁ (z.2.1.1 + c₁) x₁| *
          gaussianAt s₁ z.2.1.1 z.2.1.2) * T z.2.2))
      (((volume : Measure ℝ).prod volume).prod
        (((volume : Measure ℝ).prod volume).prod volume)) := by
  let P₀ : ℝ × ℝ → ℝ := fun z ↦
    |modelPhiAt s₀ (z.1 + c₀) x₀| * gaussianAt s₀ z.1 z.2
  let P₁ : ℝ × ℝ → ℝ := fun z ↦
    |modelPhiAt s₁ (z.1 + c₁) x₁| * gaussianAt s₁ z.1 z.2
  have hP₀ : Integrable P₀ ((volume : Measure ℝ).prod volume) := by
    simpa only [P₀] using integrable_modelPhi_gaussian_pair
      s₀ c₀ x₀ hs₀
  have hP₁ : Integrable P₁ ((volume : Measure ℝ).prod volume) := by
    simpa only [P₁] using integrable_modelPhi_gaussian_pair
      s₁ c₁ x₁ hs₁
  have hP₁T : Integrable (fun z : (ℝ × ℝ) × ℝ ↦ P₁ z.1 * T z.2)
      (((volume : Measure ℝ).prod volume).prod volume) :=
    hP₁.mul_prod hT
  have hmain := hP₀.mul_prod hP₁T
  simpa only [P₀, P₁] using hmain

/-- The exact scalar mass of the two pair factors is the square of the
absolute low-frequency kernel mass. -/
theorem integral_two_modelPhi_gaussian_pairs_mul_tail
    (s₀ s₁ c₀ c₁ x₀ x₁ : ℝ) (hs₀ : 0 < s₀) (hs₁ : 0 < s₁)
    (T : ℝ → ℝ) :
    (∫ z : (ℝ × ℝ) × ((ℝ × ℝ) × ℝ),
      (|modelPhiAt s₀ (z.1.1 + c₀) x₀| * gaussianAt s₀ z.1.1 z.1.2) *
        ((|modelPhiAt s₁ (z.2.1.1 + c₁) x₁| *
          gaussianAt s₁ z.2.1.1 z.2.1.2) * T z.2.2) ∂
          (((volume : Measure ℝ).prod volume).prod
            (((volume : Measure ℝ).prod volume).prod volume))) =
      (∫ r : ℝ, T r) * (∫ w : ℝ, |conePhiPhysicalReal w|) ^ 2 := by
  let P₀ : ℝ × ℝ → ℝ := fun z ↦
    |modelPhiAt s₀ (z.1 + c₀) x₀| * gaussianAt s₀ z.1 z.2
  let P₁ : ℝ × ℝ → ℝ := fun z ↦
    |modelPhiAt s₁ (z.1 + c₁) x₁| * gaussianAt s₁ z.1 z.2
  let A : ℝ := ∫ w : ℝ, |conePhiPhysicalReal w|
  calc
    (∫ z : (ℝ × ℝ) × ((ℝ × ℝ) × ℝ),
      (|modelPhiAt s₀ (z.1.1 + c₀) x₀| * gaussianAt s₀ z.1.1 z.1.2) *
        ((|modelPhiAt s₁ (z.2.1.1 + c₁) x₁| *
          gaussianAt s₁ z.2.1.1 z.2.1.2) * T z.2.2) ∂
          (((volume : Measure ℝ).prod volume).prod
            (((volume : Measure ℝ).prod volume).prod volume))) =
        (∫ a : ℝ × ℝ, P₀ a ∂((volume : Measure ℝ).prod volume)) *
          ∫ b : (ℝ × ℝ) × ℝ, P₁ b.1 * T b.2 ∂
            (((volume : Measure ℝ).prod volume).prod volume) := by
            simpa only [P₀, P₁] using
              integral_prod_mul (μ := (volume : Measure ℝ).prod volume)
                (ν := ((volume : Measure ℝ).prod volume).prod volume)
                P₀ (fun b : (ℝ × ℝ) × ℝ ↦ P₁ b.1 * T b.2)
    _ = A * (A * ∫ r : ℝ, T r) := by
          rw [show (∫ a : ℝ × ℝ, P₀ a ∂((volume : Measure ℝ).prod volume)) = A by
            dsimp [P₀, A]
            exact integral_modelPhi_gaussian_pair s₀ c₀ x₀ hs₀,
            show (∫ b : (ℝ × ℝ) × ℝ, P₁ b.1 * T b.2 ∂
                (((volume : Measure ℝ).prod volume).prod volume)) =
              (∫ b : ℝ × ℝ, P₁ b ∂((volume : Measure ℝ).prod volume)) * ∫ r : ℝ, T r by
                exact integral_prod_mul (μ := (volume : Measure ℝ).prod volume)
                  (ν := (volume : Measure ℝ)) P₁ T,
            show (∫ b : ℝ × ℝ, P₁ b ∂((volume : Measure ℝ).prod volume)) = A by
              dsimp [P₁, A]
              exact integral_modelPhi_gaussian_pair s₁ c₁ x₁ hs₁]
    _ = (∫ r : ℝ, T r) * (∫ w : ℝ, |conePhiPhysicalReal w|) ^ 2 := by
          dsimp [A]
          ring

/-- Once the reduced translation tail is integrable, the literal five scalar
variables in a reordered second-energy fiber are jointly integrable. -/
theorem integrable_reordered_inner_of_tail
    (α : Anisotropy) (u : E3) (f : E3 → ℝ)
    (x₁ x₂ p₂ t : ℝ) (ht : 0 < t)
    (T : ℝ → ℝ)
    (hT : ∀ r : ℝ, T r =
      (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
        |conePsiPhysicalReal (r + u 2)|)
    (hTint : Integrable T) :
    Integrable (fun v : ScratchModelEnergyInner ↦
      (modelSecondFiberReduced α f x₁ x₂ p₂ t v.2.2.2) ^ 2 *
        modelEnergyDensityReordered α u x₁ x₂ t
          v.1.1 v.1.2 v.2.1 v.2.2.1 v.2.2.2)
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) := by
  let s₀ : ℝ := t ^ α.weight 0
  let s₁ : ℝ := t ^ α.weight 1
  have hs₀ : 0 < s₀ := by
    dsimp [s₀]
    exact pow_pos ht _
  have hs₁ : 0 < s₁ := by
    dsimp [s₁]
    exact pow_pos ht _
  let H : (ℝ × ℝ) × ((ℝ × ℝ) × ℝ) → ℝ := fun z ↦
    (|modelPhiAt s₀ (z.1.1 + s₀ * u 0) x₁| * gaussianAt s₀ z.1.1 z.1.2) *
      ((|modelPhiAt s₁ (z.2.1.1 + s₁ * u 1) x₂| *
        gaussianAt s₁ z.2.1.1 z.2.1.2) * T z.2.2)
  have hH : Integrable H
      (((volume : Measure ℝ).prod volume).prod
        (((volume : Measure ℝ).prod volume).prod volume)) := by
    simpa only [H] using
      integrable_two_modelPhi_gaussian_pairs_mul_tail
        s₀ s₁ (s₀ * u 0) (s₁ * u 1) x₁ x₂ hs₀ hs₁ T hTint
  have hcomp := innerPairReorder_measurePreserving
    |>.integrable_comp_of_integrable hH
  apply hcomp.congr
  filter_upwards [] with v
  rcases v with ⟨⟨p₀, p₁⟩, ⟨y₁, ⟨y₂, r⟩⟩⟩
  dsimp [H, s₀, s₁]
  rw [innerPairReorder_apply, hT r]
  unfold modelEnergyDensityReordered
  ring

/-- The norm integral of a reordered scalar fiber is exactly its reduced
translation-tail mass times the square of the two low-frequency masses. -/
theorem integral_norm_reordered_inner_of_tail
    (α : Anisotropy) (u : E3) (f : E3 → ℝ)
    (x₁ x₂ p₂ t : ℝ) (ht : 0 < t)
    (T : ℝ → ℝ)
    (hT : ∀ r : ℝ, T r =
      (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
        |conePsiPhysicalReal (r + u 2)|)
    (hTint : Integrable T) :
    (∫ v : ScratchModelEnergyInner,
      ‖(modelSecondFiberReduced α f x₁ x₂ p₂ t v.2.2.2) ^ 2 *
        modelEnergyDensityReordered α u x₁ x₂ t
          v.1.1 v.1.2 v.2.1 v.2.2.1 v.2.2.2‖ ∂
        (((volume : Measure ℝ).prod volume).prod
          ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))) =
      (∫ r : ℝ, T r) * (∫ w : ℝ, |conePhiPhysicalReal w|) ^ 2 := by
  let H : ScratchModelEnergyInner → ℝ := fun v ↦
    (modelSecondFiberReduced α f x₁ x₂ p₂ t v.2.2.2) ^ 2 *
      modelEnergyDensityReordered α u x₁ x₂ t
        v.1.1 v.1.2 v.2.1 v.2.2.1 v.2.2.2
  have hH : Integrable H
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) := by
    exact integrable_reordered_inner_of_tail
      α u f x₁ x₂ p₂ t ht T hT hTint
  have hgauss (s p y : ℝ) (hs : 0 < s) : 0 ≤ gaussianAt s p y := by
    unfold gaussianAt kernelAt kernelDilate
    exact mul_nonneg (inv_pos.mpr hs).le (gaussian_nonneg _)
  have hHnonneg (v : ScratchModelEnergyInner) : 0 ≤ H v := by
    rcases v with ⟨⟨p₀, p₁⟩, ⟨y₁, ⟨y₂, r⟩⟩⟩
    dsimp [H]
    unfold modelEnergyDensityReordered
    exact mul_nonneg (sq_nonneg _)
      (mul_nonneg
        (mul_nonneg
          (mul_nonneg
            (mul_nonneg (abs_nonneg _)
              (hgauss (t ^ α.weight 0) p₀ y₁ (pow_pos ht _)))
            (abs_nonneg _))
          (hgauss (t ^ α.weight 1) p₁ y₂ (pow_pos ht _)))
        (abs_nonneg _))
  calc
    (∫ v : ScratchModelEnergyInner, ‖H v‖ ∂
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))) =
        ∫ v : ScratchModelEnergyInner, H v ∂
          (((volume : Measure ℝ).prod volume).prod
            ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) := by
          apply integral_congr_ae
          filter_upwards [] with v
          rw [Real.norm_eq_abs, abs_of_nonneg (hHnonneg v)]
    _ = ∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
        H ((p₀, p₁), (y₁, (y₂, r))) := by
          exact integral_ScratchModelEnergyInner_eq_nested H hH
    _ = (∫ r : ℝ, T r) * (∫ w : ℝ, |conePhiPhysicalReal w|) ^ 2 := by
          change (∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
            (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
              modelEnergyDensityReordered α u x₁ x₂ t p₀ p₁ y₁ y₂ r) = _
          rw [modelEnergy_reordered_inner_scalar_reduction α u f x₁ x₂ p₂ t ht]
          congr 1
          apply integral_congr_ae
          filter_upwards [] with r
          rw [hT r]
          ring

/-- The global positive-scale second-energy density of a real Schwartz input
is jointly integrable.  This discharges the final Fubini hypothesis in the
global second-energy identity. -/
theorem integrable_modelEnergyTwoIntegrand_global_of_real_schwartz
    (α : Anisotropy) (u : E3) (f : SchwartzMap E3 ℝ) :
    Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyTwoIntegrand α u f q.1 q.2)
      ((cubeScaleMeasure.restrict (Set.univ ×ˢ Set.Ioi (0 : ℝ))).prod volume) := by
  let ν : Measure ℝ :=
    ((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
      (Set.Ioi (0 : ℝ))
  let μouter : Measure ScratchModelEnergyOuter :=
    ((volume : Measure ℝ).prod volume).prod ((volume : Measure ℝ).prod ν)
  let μinner : Measure ScratchModelEnergyInner :=
    ((volume : Measure ℝ).prod volume).prod
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))
  let G : (E3 × ℝ) × ModelE5 → ℝ := fun q ↦
    modelEnergyTwoIntegrand α u f q.1 q.2
  let H : ScratchModelEnergyOuter × ScratchModelEnergyInner → ℝ := fun wv ↦
    G (modelEnergyCoordinateReorder.symm wv)
  let D : ScratchModelEnergyOuter × ℝ → ℝ := fun wr ↦
    (modelSecondFiberReduced α f wr.1.1.1 wr.1.1.2 wr.1.2.1 wr.1.2.2 wr.2) ^ 2 *
      |conePsiPhysicalReal (wr.2 + u 2)|
  let S : ScratchModelEnergyOuter → ℝ := fun w ↦
    (∫ r : ℝ, D (w, r)) * (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2
  have hmp := modelEnergyCoordinateReorder_measurePreserving_scale ν
  have hGmeas : AEStronglyMeasurable G
      (((volume : Measure E3).prod ν).prod (volume : Measure ModelE5)) := by
    dsimp [G]
    exact (aestronglyMeasurable_modelSecondFiber α f f.continuous _).pow 2 |>.mul
      (aestronglyMeasurable_modelEnergyDensity α u _)
  have hHmeas : AEStronglyMeasurable H (μouter.prod μinner) := by
    change AEStronglyMeasurable (G ∘ modelEnergyCoordinateReorder.symm)
      (μouter.prod μinner)
    exact hGmeas.comp_quasiMeasurePreserving
      (MeasurePreserving.symm modelEnergyCoordinateReorder hmp).quasiMeasurePreserving
  have hD : Integrable D (μouter.prod volume) := by
    simpa only [D, μouter, ν] using
      integrable_reducedTail_global_of_real_schwartz α u f
  have hDsections : ∀ᵐ w : ScratchModelEnergyOuter ∂μouter,
      Integrable (fun r : ℝ ↦ D (w, r)) := hD.prod_right_ae
  have htν : ∀ᵐ t : ℝ ∂ν, 0 < t := by
    dsimp [ν]
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    exact ht
  have htpt : ∀ᵐ pt : ℝ × ℝ ∂((volume : Measure ℝ).prod ν), 0 < pt.2 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [] with p₂
      exact htν
    · exact measurableSet_Ioi.preimage measurable_snd
  have htouter : ∀ᵐ w : ScratchModelEnergyOuter ∂μouter, 0 < w.2.2 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [] with x
      exact htpt
    · exact measurableSet_Ioi.preimage (measurable_snd.comp measurable_snd)
  have hS : Integrable S μouter := by
    have hscalar := integrable_reordered_scalar_of_real_schwartz α u f
    apply hscalar.congr
    filter_upwards [] with w
    dsimp [S, D]
    congr 1
    apply integral_congr_ae
    filter_upwards [] with r
    ring
  have hsections : ∀ᵐ w : ScratchModelEnergyOuter ∂μouter,
      Integrable (fun v : ScratchModelEnergyInner ↦ H (w, v)) μinner := by
    filter_upwards [hDsections, htouter] with w hw ht
    rcases w with ⟨⟨x₁, x₂⟩, ⟨p₂, t⟩⟩
    have hT : ∀ r : ℝ, D (((x₁, x₂), (p₂, t)), r) =
        (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
          |conePsiPhysicalReal (r + u 2)| := by
      intro r
      rfl
    have hinner := integrable_reordered_inner_of_tail
      α u f x₁ x₂ p₂ t ht (fun r : ℝ ↦ D (((x₁, x₂), (p₂, t)), r)) hT hw
    apply hinner.congr
    filter_upwards [] with v
    rcases v with ⟨⟨p₀, p₁⟩, ⟨y₁, ⟨y₂, r⟩⟩⟩
    dsimp [H, G]
    symm
    exact modelEnergyTwoIntegrand_reorder_symm
      α u f x₁ x₂ p₂ t p₀ p₁ y₁ y₂ r
  have houter : Integrable (fun w : ScratchModelEnergyOuter ↦
      ∫ v : ScratchModelEnergyInner, ‖H (w, v)‖ ∂μinner) μouter := by
    apply hS.congr
    filter_upwards [hDsections, htouter] with w hw ht
    rcases w with ⟨⟨x₁, x₂⟩, ⟨p₂, t⟩⟩
    have hT : ∀ r : ℝ, D (((x₁, x₂), (p₂, t)), r) =
        (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
          |conePsiPhysicalReal (r + u 2)| := by
      intro r
      rfl
    symm
    calc
      (∫ v : ScratchModelEnergyInner, ‖H (((x₁, x₂), (p₂, t)), v)‖ ∂μinner) =
          ∫ v : ScratchModelEnergyInner,
            ‖(modelSecondFiberReduced α f x₁ x₂ p₂ t v.2.2.2) ^ 2 *
              modelEnergyDensityReordered α u x₁ x₂ t
                v.1.1 v.1.2 v.2.1 v.2.2.1 v.2.2.2‖ ∂μinner := by
            apply integral_congr_ae
            filter_upwards [] with v
            rcases v with ⟨⟨p₀, p₁⟩, ⟨y₁, ⟨y₂, r⟩⟩⟩
            dsimp [H, G]
            rw [modelEnergyTwoIntegrand_reorder_symm]
      _ = (∫ r : ℝ, D (((x₁, x₂), (p₂, t)), r)) *
          (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 := by
            exact integral_norm_reordered_inner_of_tail
              α u f x₁ x₂ p₂ t ht
                (fun r : ℝ ↦ D (((x₁, x₂), (p₂, t)), r)) hT hw
      _ = S ((x₁, x₂), (p₂, t)) := rfl
  have hH : Integrable H (μouter.prod μinner) :=
    (integrable_prod_iff hHmeas).mpr ⟨hsections, houter⟩
  have hback := hmp.integrable_comp_of_integrable hH
  have hG : Integrable G
      (((volume : Measure E3).prod ν).prod (volume : Measure ModelE5)) := by
    apply hback.congr
    filter_upwards [] with q
    dsimp [H]
    simp only [MeasurableEquiv.symm_apply_apply]
  simpa only [G, ν, cubeScaleMeasure_restrict_global_eq] using hG

/-- Unconditional real-Schwartz form of the blueprint's global second-energy
identity. -/
theorem modelEnergyTwoOn_global_eq_of_real_schwartz_unconditional
    (α : Anisotropy) (u : E3) (f : SchwartzMap E3 ℝ) :
    modelEnergyTwoOn α (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f =
      (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 *
        conePsiPhysicalRealL1 * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ x : E3, f x ^ 2 := by
  exact modelEnergyTwoOn_global_eq_of_real_schwartz_of_joint α u f
    (integrable_modelEnergyTwoIntegrand_global_of_real_schwartz α u f)

/-- The global outer second-energy density is integrable for a real Schwartz
input. -/
theorem integrable_modelEnergyTwoOuter_global_of_real_schwartz
    (α : Anisotropy) (u : E3) (f : SchwartzMap E3 ℝ) :
    Integrable (modelEnergyTwoOuter α u f)
      (cubeScaleMeasure.restrict (Set.univ ×ˢ Set.Ioi (0 : ℝ))) := by
  have hjoint :=
    integrable_modelEnergyTwoIntegrand_global_of_real_schwartz α u f
  change Integrable (fun pt : E3 × ℝ ↦
    ∫ z : ModelE5, modelEnergyTwoIntegrand α u f pt z)
    (cubeScaleMeasure.restrict (Set.univ ×ˢ Set.Ioi (0 : ℝ)))
  exact hjoint.integral_prod_left

/-- Every positive-scale restriction of the second energy is bounded by the
explicit global real-Schwartz energy. -/
theorem modelEnergyTwoOn_le_global_of_real_schwartz
    (α : Anisotropy) (V : Set (E3 × ℝ)) (u : E3) (f : SchwartzMap E3 ℝ)
    (hV : V ⊆ Set.univ ×ˢ Set.Ioi (0 : ℝ)) :
    modelEnergyTwoOn α V u f ≤
      (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 *
        conePsiPhysicalRealL1 * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ x : E3, f x ^ 2 := by
  calc
    modelEnergyTwoOn α V u f ≤
        modelEnergyTwoOn α (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f :=
      modelEnergyTwoOn_le_global_of_integrable α V u f hV
        (integrable_modelEnergyTwoOuter_global_of_real_schwartz α u f)
    _ = _ := modelEnergyTwoOn_global_eq_of_real_schwartz_unconditional α u f

/-- Restricting the globally integrable outer energy to any positive-scale
region preserves integrability. -/
theorem integrable_modelEnergyTwoOuter_on_of_real_schwartz
    (α : Anisotropy) (V : Set (E3 × ℝ)) (u : E3) (f : SchwartzMap E3 ℝ)
    (hV : V ⊆ Set.univ ×ˢ Set.Ioi (0 : ℝ)) :
    Integrable (modelEnergyTwoOuter α u f) (cubeScaleMeasure.restrict V) := by
  apply (integrable_modelEnergyTwoOuter_global_of_real_schwartz α u f).mono_measure
  exact Measure.restrict_mono hV le_rfl

/-- Additivity of the real-Schwartz second energy on disjoint positive-scale
regions follows without any residual integrability assumption. -/
theorem modelEnergyTwoOn_union_of_real_schwartz
    (α : Anisotropy) (V W : Set (E3 × ℝ)) (u : E3) (f : SchwartzMap E3 ℝ)
    (hdisj : Disjoint V W) (hWmeas : MeasurableSet W)
    (hVpos : V ⊆ Set.univ ×ˢ Set.Ioi (0 : ℝ))
    (hWpos : W ⊆ Set.univ ×ˢ Set.Ioi (0 : ℝ)) :
    modelEnergyTwoOn α (V ∪ W) u f =
      modelEnergyTwoOn α V u f + modelEnergyTwoOn α W u f := by
  exact modelEnergyTwoOn_union_of_integrable α V W u f hdisj hWmeas
    (integrable_modelEnergyTwoOuter_on_of_real_schwartz α V u f hVpos)
    (integrable_modelEnergyTwoOuter_on_of_real_schwartz α W u f hWpos)

/-- The global real-Schwartz energy bound applies in particular to every
finite box collection. -/
theorem modelEnergyTwo_collection_le_global_of_real_schwartz
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : SchwartzMap E3 ℝ) :
    modelEnergyTwo α S u f ≤
      (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 *
        conePsiPhysicalRealL1 * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ x : E3, f x ^ 2 := by
  unfold modelEnergyTwo
  apply modelEnergyTwoOn_le_global_of_real_schwartz α
    (collectionRegion α S) u f
  intro pt hpt
  exact ⟨Set.mem_univ _, pos_of_mem_collectionRegion α S hpt⟩

/-- The source spatial model integrand with an arbitrary active coordinate.
The outer input remains input zero; the three convolved inputs are paired
with their matching spatial coordinates. -/
noncomputable def activeModelSpatialIntegrand
    (α : Anisotropy) (i : Fin 3) (u : E3) (F : ModelSchwartzInput)
    (t : ℝ) (x : E3) : ℝ :=
  F 0 x * ∏ j : Fin 3,
    ModelCoordinateConvolution j (F j.succ)
      (activeModelKernel i j u) (t ^ α.weight j) x

/-- The finite-scale model form in an arbitrary active coordinate, faithful
to Definition `def:permuted_model`. -/
noncomputable def activeModelScaleTruncation
    (α : Anisotropy) (i : Fin 3) (u : E3) (c : ℝ → ℝ)
    (F : ModelSchwartzInput) (N : ℕ) : ℝ :=
  ∫ t in truncationScaleSet N,
    c t * (∫ x : E3, activeModelSpatialIntegrand α i u F t x)
      ∂((volume : Measure ℝ).withDensity cubeScaleDensity)

/-- The literal full-scale form with arbitrary active coordinate.  This is
the integral version of the source limit once the usual model convergence
theorem has identified the limit with the full scale integral. -/
noncomputable def activeModelFullForm
    (α : Anisotropy) (i : Fin 3) (u : E3) (c : ℝ → ℝ)
    (F : ModelSchwartzInput) : ℝ :=
  ∫ t in Set.Ioi (0 : ℝ),
    c t * (∫ x : E3, activeModelSpatialIntegrand α i u F t x)
      ∂((volume : Measure ℝ).withDensity cubeScaleDensity)

/-- At active coordinate three, the general finite-scale integrand is the
already formalized third-coordinate model integrand. -/
theorem activeModelSpatialIntegrand_two
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput)
    (t : ℝ) (x : E3) :
    activeModelSpatialIntegrand α 2 u F t x =
      ModelSpatialIntegrand α u F t x := by
  unfold activeModelSpatialIntegrand ModelSpatialIntegrand
  simp only [Fin.prod_univ_succ]
  simp [activeModelKernel]
  ring

/-- At active coordinate three, the generic finite-scale form is exactly the
canonical scale truncation. -/
theorem activeModelScaleTruncation_two
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ)
  (F : ModelSchwartzInput) (N : ℕ) :
    activeModelScaleTruncation α 2 u c F N =
      ModelScaleTruncation α u c F N := by
  unfold activeModelScaleTruncation ModelScaleTruncation
  apply integral_congr_ae
  filter_upwards [] with t
  congr 1
  unfold ModelSpatialProfile
  apply integral_congr_ae
  filter_upwards [] with x
  exact activeModelSpatialIntegrand_two α u F t x

/-- At active coordinate three, the arbitrary-coordinate full form is the
canonical full model form. -/
theorem activeModelFullForm_two
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ)
    (F : ModelSchwartzInput) :
    activeModelFullForm α 2 u c F = ModelFullForm α u c F := by
  unfold activeModelFullForm ModelFullForm
  apply integral_congr_ae
  filter_upwards [] with t
  congr 1
  unfold ModelSpatialProfile
  apply integral_congr_ae
  filter_upwards [] with x
  exact activeModelSpatialIntegrand_two α u F t x

/-- The arbitrary-active-coordinate spatial integrand becomes the
active-third-coordinate integrand after permuting all three spatial labels. -/
theorem activeModelSpatialIntegrand_permute_to_two
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (F : ModelSchwartzInput) (hσ : σ 2 = i)
    (t : ℝ) (x : E3) :
    activeModelSpatialIntegrand α i u F t x =
      activeModelSpatialIntegrand (permutedAnisotropy α σ) 2
        (coordinatePermutation σ u) (permutedModelInput σ F)
        t (coordinatePermutation σ x) := by
  unfold activeModelSpatialIntegrand
  rw [permutedModelInput_zero_coordinatePermutation]
  have hprod :
      (∏ j : Fin 3,
        ModelCoordinateConvolution j (permutedModelInput σ F j.succ)
          (activeModelKernel 2 j (coordinatePermutation σ u))
          (t ^ (permutedAnisotropy α σ).weight j)
          (coordinatePermutation σ x)) =
        ∏ k : Fin 3,
          ModelCoordinateConvolution k (F k.succ)
            (activeModelKernel i k u) (t ^ α.weight k) x := by
    calc
      (∏ j : Fin 3,
        ModelCoordinateConvolution j (permutedModelInput σ F j.succ)
          (activeModelKernel 2 j (coordinatePermutation σ u))
          (t ^ (permutedAnisotropy α σ).weight j)
          (coordinatePermutation σ x)) =
          ∏ j : Fin 3,
            ModelCoordinateConvolution (σ j) (F (σ j).succ)
              (activeModelKernel i (σ j) u)
              (t ^ α.weight (σ j)) x := by
            apply Finset.prod_congr rfl
            intro j _
            exact activeModelCoordinateFactor_permute_to_two α σ i u F
              hσ t x j
      _ = ∏ k : Fin 3,
          ModelCoordinateConvolution k (F k.succ)
            (activeModelKernel i k u) (t ^ α.weight k) x :=
        by
          simpa using (Equiv.prod_comp σ (fun k : Fin 3 ↦
            ModelCoordinateConvolution k (F k.succ)
              (activeModelKernel i k u) (t ^ α.weight k) x))
  rw [hprod]

/-- The spatial integral in an arbitrary active coordinate is transported
to the active-third spatial integral by the measure-preserving relabeling. -/
theorem activeModelSpatialProfile_permute_to_two
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (F : ModelSchwartzInput) (hσ : σ 2 = i)
    (t : ℝ) :
    (∫ x : E3, activeModelSpatialIntegrand α i u F t x) =
      ∫ y : E3,
        activeModelSpatialIntegrand (permutedAnisotropy α σ) 2
          (coordinatePermutation σ u) (permutedModelInput σ F) t y := by
  calc
    (∫ x : E3, activeModelSpatialIntegrand α i u F t x) =
        ∫ x : E3,
          activeModelSpatialIntegrand (permutedAnisotropy α σ) 2
            (coordinatePermutation σ u) (permutedModelInput σ F)
            t (coordinatePermutation σ x) := by
          apply integral_congr_ae
          filter_upwards [] with x
          exact activeModelSpatialIntegrand_permute_to_two α σ i u F
            hσ t x
    _ = ∫ y : E3,
        activeModelSpatialIntegrand (permutedAnisotropy α σ) 2
          (coordinatePermutation σ u) (permutedModelInput σ F) t y :=
      by
        have hmp : MeasurePreserving (coordinatePermutation σ).toMeasurableEquiv
            volume volume := by
          simpa using coordinatePermutation_measurePreserving σ
        simpa using hmp.integral_comp'
          (activeModelSpatialIntegrand (permutedAnisotropy α σ) 2
            (coordinatePermutation σ u) (permutedModelInput σ F) t)

/-- Finite scale truncations transport exactly to the canonical
active-third-coordinate model form under a permutation sending coordinate
three to the desired active coordinate. -/
theorem activeModelScaleTruncation_permute_to_third
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput) (N : ℕ)
    (hσ : σ 2 = i) :
    activeModelScaleTruncation α i u c F N =
      ModelScaleTruncation (permutedAnisotropy α σ)
        (coordinatePermutation σ u) c (permutedModelInput σ F) N := by
  rw [← activeModelScaleTruncation_two
    (permutedAnisotropy α σ) (coordinatePermutation σ u) c
    (permutedModelInput σ F) N]
  unfold activeModelScaleTruncation
  apply integral_congr_ae
  filter_upwards [] with t
  congr 1
  exact activeModelSpatialProfile_permute_to_two α σ i u F hσ t

/-- The full-scale arbitrary-coordinate model form transports exactly to the
canonical active-third form. -/
theorem activeModelFullForm_permute_to_third
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (hσ : σ 2 = i) :
    activeModelFullForm α i u c F =
      ModelFullForm (permutedAnisotropy α σ)
        (coordinatePermutation σ u) c (permutedModelInput σ F) := by
  rw [← activeModelFullForm_two
    (permutedAnisotropy α σ) (coordinatePermutation σ u) c
    (permutedModelInput σ F)]
  unfold activeModelFullForm
  apply integral_congr_ae
  filter_upwards [] with t
  congr 1
  exact activeModelSpatialProfile_permute_to_two α σ i u F hσ t

/-- The strict real initial range holds uniformly for every choice of the
active annular coordinate.  The hypotheses use fourth-power thresholds for
the outer and passive inputs and the second-power threshold for the active
convolved input. -/
theorem activeModelFullForm_bound_weight100
    (α : Anisotropy) (i : Fin 3) (u : E3) (c : ℝ → ℝ)
    (F : ModelSchwartzInput) (q : Fin 4 → ℝ)
    (hq : ∀ j : Fin 4, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j : Fin 4, activeSourceStoppingExponent i j < q j)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1) :
    ∃ C : ℝ, 0 ≤ C ∧
      |activeModelFullForm α i u c F| ≤ C * sourceWeight u ^ 100 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
  rcases exists_coordinatePermutation_to_active i with ⟨σ, hσ⟩
  let q' : Fin 4 → ℝ := permutedModelExponent σ q
  have hq' : ∀ j : Fin 4, 0 < q' j := by
    simpa only [q'] using permutedModelExponent_pos σ q hq
  have hsum' : ∑ j : Fin 4, (q' j)⁻¹ = 1 := by
    calc
      (∑ j : Fin 4, (q' j)⁻¹) = ∑ j : Fin 4, (q j)⁻¹ := by
        simpa only [q'] using sum_inv_permutedModelExponent σ q
      _ = 1 := hsum
  have hqs' : ∀ j : Fin 4, sourceStoppingExponent j < q' j := by
    simpa only [q'] using
      permutedModelExponent_stoppingThreshold σ i q hσ hqs
  obtain ⟨C, hC, hbound⟩ := initialModelFullForm_bound
    (permutedAnisotropy α σ) (coordinatePermutation σ u) c
    (permutedModelInput σ F) q' hq' hsum' hqs' hcmeas hc
  refine ⟨C, hC, ?_⟩
  rw [activeModelFullForm_permute_to_third α σ i u c F hσ]
  have hbound' :
      |ModelFullForm (permutedAnisotropy α σ) (coordinatePermutation σ u)
          c (permutedModelInput σ F)| ≤
        C * sourceWeight (coordinatePermutation σ u) ^ 75 *
          ∏ j : Fin 4,
            lpNorm (permutedModelInput σ F j : E3 → ℝ)
              (ENNReal.ofReal (permutedModelExponent σ q j)) volume := by
    simpa only [q'] using hbound
  rw [sourceWeight_coordinatePermutation σ u,
    prod_lpNorm_permutedModelInput σ F q] at hbound'
  have hweight : 1 ≤ sourceWeight u := by
    unfold sourceWeight
    linarith [abs_nonneg (u 0), abs_nonneg (u 1), abs_nonneg (u 2)]
  have hpow : sourceWeight u ^ 75 ≤ sourceWeight u ^ 100 :=
    pow_le_pow_right₀ hweight (by norm_num)
  have hprod : 0 ≤ ∏ j : Fin 4,
      lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
    exact Finset.prod_nonneg fun j _ ↦ lpNorm_nonneg
  calc
    |ModelFullForm (permutedAnisotropy α σ) (coordinatePermutation σ u)
        c (permutedModelInput σ F)| ≤
        C * sourceWeight u ^ 75 *
          ∏ j : Fin 4,
            lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := hbound'
    _ = (C * ∏ j : Fin 4,
          lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume) *
          sourceWeight u ^ 75 := by ring
    _ ≤ (C * ∏ j : Fin 4,
          lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume) *
          sourceWeight u ^ 100 :=
      mul_le_mul_of_nonneg_left hpow (mul_nonneg hC hprod)
    _ = C * sourceWeight u ^ 100 *
        ∏ j : Fin 4,
          lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by ring

/-! ## Uniform active-coordinate range and mode summation -/

/-- The uniform strict model constant transports to every active coordinate.
Unlike the earlier pointwise formulation, its constant is chosen before the
translation, coefficient, and input tuple; this is the form consumed by the
complexification and lattice-mode stages. -/
theorem exists_uniform_activeModelFullForm_bound_weight100
    (α : Anisotropy) (i : Fin 3) (q : Fin 4 → ℝ)
    (hq : ∀ j : Fin 4, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j : Fin 4, activeSourceStoppingExponent i j < q j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (c : ℝ → ℝ)
      (F : ModelSchwartzInput),
      Measurable c → (∀ t : ℝ, |c t| ≤ 1) →
      |activeModelFullForm α i u c F| ≤ C * sourceWeight u ^ 100 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
  rcases exists_coordinatePermutation_to_active i with ⟨σ, hσ⟩
  let q' : Fin 4 → ℝ := permutedModelExponent σ q
  have hq' : ∀ j : Fin 4, 0 < q' j := by
    simpa only [q'] using permutedModelExponent_pos σ q hq
  have hsum' : ∑ j : Fin 4, (q' j)⁻¹ = 1 := by
    calc
      (∑ j : Fin 4, (q' j)⁻¹) = ∑ j : Fin 4, (q j)⁻¹ := by
        simpa only [q'] using sum_inv_permutedModelExponent σ q
      _ = 1 := hsum
  have hqs' : ∀ j : Fin 4, sourceStoppingExponent j < q' j := by
    simpa only [q'] using
      permutedModelExponent_stoppingThreshold σ i q hσ hqs
  rcases exists_uniform_initialModelFullForm_bound_weight100
    (permutedAnisotropy α σ) q' hq' hsum' hqs' with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u c F hcmeas hc
  rw [activeModelFullForm_permute_to_third α σ i u c F hσ]
  have hbound' := hbound (coordinatePermutation σ u) c
    (permutedModelInput σ F) hcmeas hc
  rw [sourceWeight_coordinatePermutation σ u,
    prod_lpNorm_permutedModelInput σ F q] at hbound'
  simpa only [q'] using hbound'

/-- The translation parameter attached to a Fourier mode.  The source uses
`ν / 8`; scalar multiplication keeps the standard lattice embedding available
to the summability package. -/
noncomputable def standardModeTranslate (z : standardModeLattice) : E3 :=
  (8 : ℝ)⁻¹ • (z : E3)

@[simp] theorem standardModeTranslate_apply
    (z : standardModeLattice) (j : Fin 3) :
    standardModeTranslate z j = (8 : ℝ)⁻¹ * (z : E3) j := by
  rfl

/-- Dividing a mode vector by the source period does not enlarge its
translation weight. -/
theorem sourceWeight_standardModeTranslate_le
    (z : standardModeLattice) :
    sourceWeight (standardModeTranslate z) ≤ sourceWeight (z : E3) := by
  unfold standardModeTranslate sourceWeight
  simp only [PiLp.smul_apply, smul_eq_mul]
  have h0 : |(8 : ℝ)⁻¹ * (z : E3) 0| ≤ |(z : E3) 0| := by
    rw [abs_mul]
    nlinarith [abs_nonneg ((z : E3) 0)]
  have h1 : |(8 : ℝ)⁻¹ * (z : E3) 1| ≤ |(z : E3) 1| := by
    rw [abs_mul]
    nlinarith [abs_nonneg ((z : E3) 1)]
  have h2 : |(8 : ℝ)⁻¹ * (z : E3) 2| ≤ |(z : E3) 2| := by
    rw [abs_mul]
    nlinarith [abs_nonneg ((z : E3) 2)]
  linarith

/-- The weight-100 model factor at the translated Fourier mode is dominated
by the weight-100 factor already used by the degree-ten lattice tail. -/
theorem sourceWeight_standardModeTranslate_pow_le
    (z : standardModeLattice) :
    sourceWeight (standardModeTranslate z) ^ (100 : ℕ) ≤
      sourceWeight (z : E3) ^ (100 : ℕ) := by
  exact pow_le_pow_left₀ (sourceWeight_nonneg _)
    (sourceWeight_standardModeTranslate_le z) _

/-- The degree-110 coefficient decay and degree-100 active-model bound are
summable after the source mode translation `ν ↦ ν / 8`.  This is the literal
lattice-summation consumer used after the cone/Fourier expansion identifies
its individual terms. -/
theorem summable_activeModelFullForm_modeTerms_of_decay
    (α : Anisotropy) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (a : Fin 3 → standardModeLattice → ℂ) (C D : ℝ)
    (hC : 0 ≤ C) (hD : 0 ≤ D)
    (ha : ∀ i z, ‖a i z‖ ≤
      C * (sourceWeight (z : E3))⁻¹ ^ (110 : ℕ))
    (hactive : ∀ i z,
      ‖(activeModelFullForm α i (standardModeTranslate z) c F : ℂ)‖ ≤
        D * sourceWeight (standardModeTranslate z) ^ (100 : ℕ)) :
    Summable (fun z : standardModeLattice ↦
      ∑ i : Fin 3, a i z *
        (activeModelFullForm α i (standardModeTranslate z) c F : ℂ)) := by
  let b : Fin 3 → standardModeLattice → ℂ := fun i z ↦
    (activeModelFullForm α i (standardModeTranslate z) c F : ℂ)
  have hb : ∀ i z, ‖b i z‖ ≤
      D * sourceWeight (z : E3) ^ (100 : ℕ) := by
    intro i z
    dsimp only [b]
    exact (hactive i z).trans
      (mul_le_mul_of_nonneg_left
        (sourceWeight_standardModeTranslate_pow_le z) hD)
  simpa only [b] using
    (summable_threeCoordinateModeProducts_of_decay a b C D hC hD ha hb)

/-- The preceding absolutely convergent cone-mode sum has its explicit
degree-ten lattice majorant. -/
theorem norm_tsum_activeModelFullForm_modeTerms_le_of_decay
    (α : Anisotropy) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (a : Fin 3 → standardModeLattice → ℂ) (C D : ℝ)
    (hC : 0 ≤ C) (hD : 0 ≤ D)
    (ha : ∀ i z, ‖a i z‖ ≤
      C * (sourceWeight (z : E3))⁻¹ ^ (110 : ℕ))
    (hactive : ∀ i z,
      ‖(activeModelFullForm α i (standardModeTranslate z) c F : ℂ)‖ ≤
        D * sourceWeight (standardModeTranslate z) ^ (100 : ℕ)) :
    ‖∑' z : standardModeLattice, ∑ i : Fin 3, a i z *
      (activeModelFullForm α i (standardModeTranslate z) c F : ℂ)‖ ≤
      (3 * C * D) * ∑' z : standardModeLattice,
        (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ) := by
  let b : Fin 3 → standardModeLattice → ℂ := fun i z ↦
    (activeModelFullForm α i (standardModeTranslate z) c F : ℂ)
  have hb : ∀ i z, ‖b i z‖ ≤
      D * sourceWeight (z : E3) ^ (100 : ℕ) := by
    intro i z
    dsimp only [b]
    exact (hactive i z).trans
      (mul_le_mul_of_nonneg_left
        (sourceWeight_standardModeTranslate_pow_le z) hD)
  simpa only [b] using
    (norm_tsum_threeCoordinateModeProducts_le_of_decay a b C D hC hD ha hb)

namespace LiteralComplexInternal

/-- The exact `2^5` Section 7 estimate for the literal complex model form,
obtained by transporting the already-proved algebraic complexification bound
through the literal expansion identity. -/
theorem scratch_norm_LiteralModelFullForm_le_weight100
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (C : ℝ) (hC : 0 ≤ C) (p : Fin 4 → ℝ)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, ‖c t‖ ≤ 1)
    (hreal : ∀ (d : ℝ → ℝ), Measurable d → (∀ t : ℝ, |d t| ≤ 1) →
      ∀ G : ModelSchwartzInput,
        |ModelFullForm α u d G| ≤ C * sourceWeight u ^ 100 *
          ∏ j : Fin 4, lpNorm (G j : E3 → ℝ)
            (ENNReal.ofReal (p j)) volume)
    (F : ScratchModelComplexSchwartzInput) :
    ‖scratch_LiteralModelFullForm α u c F‖ ≤
      32 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
  rw [scratch_LiteralModelFullForm_eq_complexCoefficientComplexified
    α u c F hcmeas hc]
  exact scratch_norm_ModelFullFormComplexCoefficientComplexified_le_weight100
    α u c C hC p hcmeas hc hreal F

end LiteralComplexInternal

/-- The literal complex spatial profile before scale integration. -/
noncomputable def LiteralModelSpatialProfile
    (α : Anisotropy) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) : ℂ :=
  LiteralComplexInternal.scratch_LiteralModelSpatialProfile α u F t

/-- The Section 7 `2^5` estimate for the literal complex model form from a
uniform real product estimate at translation exponent `100`. -/
theorem norm_LiteralModelFullForm_le_weight100
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (C : ℝ) (hC : 0 ≤ C) (p : Fin 4 → ℝ)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, ‖c t‖ ≤ 1)
    (hreal : ∀ (d : ℝ → ℝ), Measurable d → (∀ t : ℝ, |d t| ≤ 1) →
      ∀ G : ModelSchwartzInput,
        |ModelFullForm α u d G| ≤ C * sourceWeight u ^ 100 *
          ∏ j : Fin 4, lpNorm (G j : E3 → ℝ)
            (ENNReal.ofReal (p j)) volume)
    (F : ModelComplexSchwartzInput) :
    ‖LiteralModelFullForm α u c F‖ ≤
      32 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
  simpa only [LiteralModelFullForm] using
    LiteralComplexInternal.scratch_norm_LiteralModelFullForm_le_weight100
      α u c C hC p hcmeas hc hreal F

/-- Simultaneously permute spatial coordinates and the four complex Schwartz
inputs in the active-coordinate model. -/
noncomputable def complexPermutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelComplexSchwartzInput) :
    ModelComplexSchwartzInput :=
  LiteralComplexActiveInternal.scratch_complexPermutedModelInput σ F

@[simp] theorem complexPermutedModelInput_apply
    (σ : Equiv.Perm (Fin 3)) (F : ModelComplexSchwartzInput)
    (j : Fin 4) (x : E3) :
    complexPermutedModelInput σ F j x =
      F (modelInputIndex σ j) ((coordinatePermutation σ).symm x) := by
  simpa only [complexPermutedModelInput] using
    LiteralComplexActiveInternal.scratch_complexPermutedModelInput_apply σ F j x

/-- Literal complex coordinate convolution commutes with a coordinate
permutation. -/
theorem LiteralModelCoordinateConvolution_coordinatePermutation
    (σ : Equiv.Perm (Fin 3)) (j : Fin 3)
    (f : E3 → ℂ) (k : ℝ → ℝ) (s : ℝ) (x : E3) :
    LiteralModelCoordinateConvolution j
      (complexCoordinatePullback σ f) k s
      (coordinatePermutation σ x) =
      LiteralModelCoordinateConvolution (σ j) f k s x := by
  simpa only [complexCoordinatePullback] using
    LiteralComplexActiveInternal.scratch_LiteralModelCoordinateConvolution_coordinatePermutation
      σ j f k s x

/-- The literal complex active-coordinate spatial integrand. -/
noncomputable def LiteralActiveModelSpatialIntegrand
    (α : Anisotropy) (i : Fin 3) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (x : E3) : ℂ :=
  LiteralComplexActiveInternal.scratch_LiteralActiveModelSpatialIntegrand
    α i u F t x

/-- The literal complex active-coordinate spatial profile. -/
noncomputable def LiteralActiveModelSpatialProfile
    (α : Anisotropy) (i : Fin 3) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) : ℂ :=
  LiteralComplexActiveInternal.scratch_LiteralActiveModelSpatialProfile
    α i u F t

/-- At active coordinate three, the active literal complex spatial integrand
is the canonical literal complex spatial integrand. -/
theorem LiteralActiveModelSpatialIntegrand_two
    (α : Anisotropy) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (x : E3) :
    LiteralActiveModelSpatialIntegrand α 2 u F t x =
      LiteralModelSpatialIntegrand α u F t x := by
  simpa only [LiteralActiveModelSpatialIntegrand] using
    LiteralComplexActiveInternal.scratch_LiteralActiveModelSpatialIntegrand_two
      α u F t x

/-- The full literal complex active-coordinate model is exactly transported to
the canonical literal complex model by any permutation taking coordinate three
to the active coordinate. -/
theorem LiteralActiveModelFullForm_permute_to_third
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (c : ℝ → ℂ) (F : ModelComplexSchwartzInput)
    (hσ : σ 2 = i) :
    LiteralActiveModelFullForm α i u c F =
      LiteralModelFullForm (permutedAnisotropy α σ)
        (coordinatePermutation σ u) c (complexPermutedModelInput σ F) := by
  simpa only [LiteralActiveModelFullForm, complexPermutedModelInput] using
    LiteralComplexActiveInternal.scratch_LiteralActiveModelFullForm_permute_to_third
      α σ i u c F hσ

/-- Complex `L^p` norms are invariant under the active-coordinate input
permutation. -/
theorem lpNorm_complexPermutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelComplexSchwartzInput)
    (j : Fin 4) (p : ℝ≥0∞) :
    lpNorm (complexPermutedModelInput σ F j : E3 → ℂ) p volume =
      lpNorm (F (modelInputIndex σ j) : E3 → ℂ) p volume := by
  simpa only [complexPermutedModelInput] using
    LiteralComplexActiveInternal.scratch_lpNorm_complexPermutedModelInput σ F j p

/-- The product of the four complex input norms is invariant under the full
active-coordinate input/exponent relabeling. -/
theorem prod_lpNorm_complexPermutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelComplexSchwartzInput)
    (q : Fin 4 → ℝ) :
    (∏ j : Fin 4,
      lpNorm (complexPermutedModelInput σ F j : E3 → ℂ)
        (ENNReal.ofReal (permutedModelExponent σ q j)) volume) =
      ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (q j)) volume := by
  simpa only [complexPermutedModelInput] using
    LiteralComplexActiveInternal.scratch_prod_lpNorm_complexPermutedModelInput
      σ F q

/-! ## Section 9 anisotropic derivative transport -/

/-- A diagonal anisotropic dilation acts on a coordinate direction by the
corresponding anisotropic power. -/
theorem dilateLinear_coordinateDirection
    (α : Anisotropy) (t : ℝ) (j : Fin 3) :
    α.dilateLinear t (Anisotropy.coordinateDirection j) =
      t ^ α.weight j • Anisotropy.coordinateDirection j := by
  ext k
  rw [Anisotropy.dilateLinear_apply]
  simp [Anisotropy.dilate, coordinateDirection_apply]
  split_ifs with h
  · subst k
    simp
  · simp

/-- Away from the origin, anisotropic diagonal precomposition transports an
ordered coordinate derivative by applying the same diagonal map to every
input vector. -/
theorem iteratedFDeriv_dilate_comp_coordinate
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    {t : ℝ} (ht : 0 < t) (η : E3) (k : ℕ) (hk : k ≤ 110)
    (σ : Fin k → Fin 3) (hη : η ≠ 0) :
    (iteratedFDeriv ℝ k (fun z : E3 ↦ m (α.dilate t⁻¹ z)) η)
        (fun r ↦ Anisotropy.coordinateDirection (σ r)) =
      (iteratedFDeriv ℝ k m (α.dilate t⁻¹ η))
        (fun r ↦ α.dilateLinear t⁻¹ (Anisotropy.coordinateDirection (σ r))) := by
  let S : Set E3 := ({0}ᶜ : Set E3)
  let L : E3 →L[ℝ] E3 :=
    { α.dilateLinear t⁻¹ with
      cont := LinearMap.continuous_of_finiteDimensional (α.dilateLinear t⁻¹) }
  let S' : Set E3 := L ⁻¹' S
  have hLapply (z : E3) : L z = α.dilate t⁻¹ z := by
    change (α.dilateLinear t⁻¹) z = α.dilate t⁻¹ z
    exact α.dilateLinear_apply t⁻¹ z
  have hLη : L η = α.dilate t⁻¹ η := hLapply η
  have hLηne : L η ≠ 0 := by
    rw [hLη]
    intro hzero
    have hrecover := α.dilate_apply_inv ht.ne' η
    rw [hzero] at hrecover
    apply hη
    change α.dilate t (0 : E3) = η at hrecover
    have hzeroDilate : α.dilate t (0 : E3) = 0 := by
      rw [← α.dilateLinear_apply]
      exact (α.dilateLinear t).map_zero
    rw [hzeroDilate] at hrecover
    exact hrecover.symm
  have hηS' : η ∈ S' := by
    change L η ∈ S
    simpa [S] using hLηne
  have hLS : L η ∈ S := by
    simpa [S] using hLηne
  have hSopen : IsOpen S := by
    simpa only [S] using (isOpen_compl_singleton : IsOpen ({0}ᶜ : Set E3))
  have hS'open : IsOpen S' := hSopen.preimage L.continuous
  have hSunique : UniqueDiffOn ℝ S := hSopen.uniqueDiffOn
  have hS'unique : UniqueDiffOn ℝ S' := hS'open.uniqueDiffOn
  have hmAt : ContDiffAt ℝ 110 m (L η) :=
    hm.2.2.2.1.contDiffAt (hSopen.mem_nhds hLS)
  have hcompOn : ContDiffOn ℝ 110 (m ∘ L) S' :=
    hm.2.2.2.1.comp_continuousLinearMap L
  have hcompAt : ContDiffAt ℝ 110 (m ∘ L) η :=
    hcompOn.contDiffAt (hS'open.mem_nhds hηS')
  have hwithin := L.iteratedFDerivWithin_comp_right hm.2.2.2.1
    hSunique hS'unique hLS (show (k : WithTop ℕ∞) ≤ 110 by exact_mod_cast hk)
  have hleft : iteratedFDeriv ℝ k (m ∘ L) η =
      iteratedFDerivWithin ℝ k (m ∘ L) S' η := by
    symm
    exact iteratedFDerivWithin_eq_iteratedFDeriv hS'unique
      (hcompAt.of_le (by exact_mod_cast hk)) hηS'
  have hright : iteratedFDerivWithin ℝ k m S (L η) =
      iteratedFDeriv ℝ k m (L η) :=
    iteratedFDerivWithin_eq_iteratedFDeriv hSunique
      (hmAt.of_le (by exact_mod_cast hk)) hLS
  have hfun : (fun z : E3 ↦ m (α.dilate t⁻¹ z)) = m ∘ L := by
    funext z
    exact congrArg m (hLapply z).symm
  calc
    (iteratedFDeriv ℝ k (fun z : E3 ↦ m (α.dilate t⁻¹ z)) η)
        (fun r ↦ Anisotropy.coordinateDirection (σ r)) =
        (iteratedFDeriv ℝ k (m ∘ L) η)
          (fun r ↦ Anisotropy.coordinateDirection (σ r)) := by rw [hfun]
    _ = (iteratedFDerivWithin ℝ k (m ∘ L) S' η)
          (fun r ↦ Anisotropy.coordinateDirection (σ r)) := by rw [hleft]
    _ = ((iteratedFDerivWithin ℝ k m S (L η)).compContinuousLinearMap
          (fun _ ↦ L)) (fun r ↦ Anisotropy.coordinateDirection (σ r)) := by
          rw [hwithin]
    _ = (iteratedFDeriv ℝ k m (L η))
          (fun r ↦ L (Anisotropy.coordinateDirection (σ r))) := by
          rw [hright]
          simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    _ = (iteratedFDeriv ℝ k m (α.dilate t⁻¹ η))
          (fun r ↦ α.dilateLinear t⁻¹ (Anisotropy.coordinateDirection (σ r))) := by
          rw [hLη]
          rfl

/-- The anisotropic radius is strictly positive off the origin. -/
theorem radius_pos_of_ne_zero (α : Anisotropy) {x : E3} (hx : x ≠ 0) :
    0 < α.radius x := by
  obtain ⟨i, hi⟩ : ∃ i : Fin 3, x i ≠ 0 := by
    by_contra h
    push Not at h
    apply hx
    ext j
    exact h j
  have hterm : 0 < |x i| ^ ((α.weight i : ℝ)⁻¹) := by
    exact Real.rpow_pos_of_pos (abs_pos.mpr hi) _
  unfold Anisotropy.radius
  exact lt_of_lt_of_le hterm
    (Finset.single_le_sum (s := Finset.univ)
      (fun j _ ↦ Real.rpow_nonneg (abs_nonneg (x j)) ((α.weight j : ℝ)⁻¹))
      (Finset.mem_univ i))

/-- The exact coordinate derivative factor of the rescaled multiplier. -/
theorem dilate_coordinate_derivative_factor
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    {t : ℝ} (ht : 0 < t) (η : E3) (k : ℕ) (hk : k ≤ 110)
    (σ : Fin k → Fin 3) (hη : η ≠ 0) :
    (iteratedFDeriv ℝ k (fun z : E3 ↦ m (α.dilate t⁻¹ z)) η)
        (fun r ↦ Anisotropy.coordinateDirection (σ r)) =
      (t⁻¹) ^ α.derivativeWeight σ •
        (iteratedFDeriv ℝ k m (α.dilate t⁻¹ η))
          (fun r ↦ Anisotropy.coordinateDirection (σ r)) := by
  rw [iteratedFDeriv_dilate_comp_coordinate α M m hm ht η k hk σ hη]
  have hvec : (fun r ↦ α.dilateLinear t⁻¹
      (Anisotropy.coordinateDirection (σ r))) =
      (fun r ↦ (t⁻¹) ^ α.weight (σ r) •
        Anisotropy.coordinateDirection (σ r)) := by
    funext r
    exact dilateLinear_coordinateDirection α t⁻¹ (σ r)
  rw [hvec, ContinuousMultilinearMap.map_smul_univ]
  congr 1
  unfold Anisotropy.derivativeWeight
  rw [Finset.prod_pow_eq_pow_sum]

/-- The scale powers in the multiplier derivative bound cancel exactly under
anisotropic precomposition. -/
theorem anisotropic_derivative_scalar_cancel
    (M t r : ℝ) (ht : 0 < t) (hr : 0 < r) (d : ℕ) :
    (t⁻¹) ^ d * (M * (t⁻¹ * r) ^ (-((d : ℕ) : ℝ))) =
      M * r ^ (-((d : ℕ) : ℝ)) := by
  have hti : 0 < t⁻¹ := inv_pos.mpr ht
  rw [Real.mul_rpow hti.le hr.le]
  rw [← Real.rpow_natCast]
  calc
    t⁻¹ ^ (d : ℝ) * (M * (t⁻¹ ^ (-(d : ℝ)) * r ^ (-(d : ℝ)))) =
        M * (t⁻¹ ^ (d : ℝ) * t⁻¹ ^ (-(d : ℝ))) * r ^ (-(d : ℝ)) := by ring
    _ = M * t⁻¹ ^ ((d : ℝ) + -(d : ℝ)) * r ^ (-(d : ℝ)) := by
      rw [Real.rpow_add hti]
    _ = M * r ^ (-(d : ℝ)) := by norm_num

/-- The anisotropic multiplier hypothesis is uniform under the diagonal
rescaling used in localized symbols when tested on ordered coordinate
directions. -/
theorem dilate_coordinate_derivative_bound
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    {t : ℝ} (ht : 0 < t) (η : E3) (k : ℕ) (hk : k ≤ 110)
    (σ : Fin k → Fin 3) (hη : η ≠ 0) :
    ‖(iteratedFDeriv ℝ k (fun z : E3 ↦ m (α.dilate t⁻¹ z)) η)
        (fun r ↦ Anisotropy.coordinateDirection (σ r))‖ ≤
      M * (α.radius η) ^ (-((α.derivativeWeight σ : ℕ) : ℝ)) := by
  rw [dilate_coordinate_derivative_factor α M m hm ht η k hk σ hη]
  have hDη : α.dilate t⁻¹ η ≠ 0 := by
    intro hzero
    have hrecover := α.dilate_apply_inv ht.ne' η
    rw [hzero] at hrecover
    apply hη
    change α.dilate t (0 : E3) = η at hrecover
    have hzeroDilate : α.dilate t (0 : E3) = 0 := by
      rw [← α.dilateLinear_apply]
      exact (α.dilateLinear t).map_zero
    rw [hzeroDilate] at hrecover
    exact hrecover.symm
  have hsource := hm.2.2.2.2 k hk (α.dilate t⁻¹ η) hDη σ
  have hpow_nonneg : 0 ≤ (t⁻¹) ^ α.derivativeWeight σ := by positivity
  rw [norm_smul, Real.norm_eq_abs,
    abs_of_pos (pow_pos (inv_pos.mpr ht) _)]
  calc
    (t⁻¹) ^ α.derivativeWeight σ *
        ‖(iteratedFDeriv ℝ k m (α.dilate t⁻¹ η))
          (fun r ↦ Anisotropy.coordinateDirection (σ r))‖ ≤
        (t⁻¹) ^ α.derivativeWeight σ *
          (M * (α.radius (α.dilate t⁻¹ η)) ^
            (-((α.derivativeWeight σ : ℕ) : ℝ))) :=
      mul_le_mul_of_nonneg_left hsource hpow_nonneg
    _ = M * (α.radius η) ^ (-((α.derivativeWeight σ : ℕ) : ℝ)) := by
      rw [α.radius_dilate (inv_pos.mpr ht)]
      exact anisotropic_derivative_scalar_cancel M t (α.radius η) ht
        (radius_pos_of_ne_zero α hη) (α.derivativeWeight σ)

/-! ## Compact cone-localization cutoffs

These are the source's auxiliary `\widetilde\Phi` and
`\widetilde\Psi`, realized directly through `ContDiffBump`. The chosen
inner and outer radii give exactly the plateau and support margins used by
the localized-symbol/Fourier-series step.
-/

/-- A smooth low-frequency cutoff equal to one on `[-2,2]` and zero outside
`(-3,3)`. -/
noncomputable def localConePhi (x : ℝ) : ℝ :=
  (⟨(2 : ℝ), 3, by norm_num, by norm_num⟩ : ContDiffBump (0 : ℝ)) x

/-- One positive annular cutoff, equal to one on `[1,2]` and supported in
`(1/2,5/2)`. -/
noncomputable def localConePsiPos (x : ℝ) : ℝ :=
  (⟨(1 / 2 : ℝ), 1, by norm_num, by norm_num⟩ : ContDiffBump (3 / 2 : ℝ)) x

/-- The corresponding negative annular cutoff. -/
noncomputable def localConePsiNeg (x : ℝ) : ℝ :=
  (⟨(1 / 2 : ℝ), 1, by norm_num, by norm_num⟩ : ContDiffBump (-3 / 2 : ℝ)) x

/-- A smooth even annular cutoff equal to one on
`[-2,-1] ∪ [1,2]` and zero on `[-1/2,1/2]` and outside
`(-5/2,5/2)`. -/
noncomputable def localConePsi (x : ℝ) : ℝ :=
  localConePsiPos x + localConePsiNeg x

private theorem localConePhi_apply (x : ℝ) :
    localConePhi x =
      (⟨(2 : ℝ), 3, by norm_num, by norm_num⟩ : ContDiffBump (0 : ℝ)) x := by
  rfl

private theorem localConePsiPos_apply (x : ℝ) :
    localConePsiPos x =
      (⟨(1 / 2 : ℝ), 1, by norm_num, by norm_num⟩ :
        ContDiffBump (3 / 2 : ℝ)) x := by
  rfl

private theorem localConePsiNeg_apply (x : ℝ) :
    localConePsiNeg x =
      (⟨(1 / 2 : ℝ), 1, by norm_num, by norm_num⟩ :
        ContDiffBump (-3 / 2 : ℝ)) x := by
  rfl

theorem localConePhi_nonneg (x : ℝ) : 0 ≤ localConePhi x := by
  rw [localConePhi_apply]
  exact ContDiffBump.nonneg' _ _

theorem localConePhi_le_one (x : ℝ) : localConePhi x ≤ 1 := by
  rw [localConePhi_apply]
  exact ContDiffBump.le_one _

theorem localConePhi_eq_one {x : ℝ} (hx : |x| ≤ 2) :
    localConePhi x = 1 := by
  rw [localConePhi_apply]
  apply ContDiffBump.one_of_mem_closedBall
  rw [Metric.mem_closedBall, Real.dist_eq]
  simpa using hx

theorem localConePhi_eq_zero {x : ℝ} (hx : 3 ≤ |x|) :
    localConePhi x = 0 := by
  rw [localConePhi_apply]
  apply ContDiffBump.zero_of_le_dist
  rw [Real.dist_eq]
  simpa using hx

theorem localConePhi_contDiff :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) localConePhi := by
  rw [show localConePhi =
      (⟨(2 : ℝ), 3, by norm_num, by norm_num⟩ : ContDiffBump (0 : ℝ)) by rfl]
  exact (⟨(2 : ℝ), 3, by norm_num, by norm_num⟩ : ContDiffBump (0 : ℝ)).contDiff

theorem localConePsiPos_nonneg (x : ℝ) :
    0 ≤ localConePsiPos x := by
  rw [localConePsiPos_apply]
  exact ContDiffBump.nonneg' _ _

theorem localConePsiNeg_nonneg (x : ℝ) :
    0 ≤ localConePsiNeg x := by
  rw [localConePsiNeg_apply]
  exact ContDiffBump.nonneg' _ _

theorem localConePsiPos_eq_one {x : ℝ}
    (hx : |x - 3 / 2| ≤ 1 / 2) : localConePsiPos x = 1 := by
  rw [localConePsiPos_apply]
  apply ContDiffBump.one_of_mem_closedBall
  rw [Metric.mem_closedBall, Real.dist_eq]
  simpa using hx

theorem localConePsiNeg_eq_one {x : ℝ}
    (hx : |x + 3 / 2| ≤ 1 / 2) : localConePsiNeg x = 1 := by
  rw [localConePsiNeg_apply]
  apply ContDiffBump.one_of_mem_closedBall
  rw [Metric.mem_closedBall, Real.dist_eq]
  convert hx using 1 ; ring

theorem localConePsiPos_eq_zero {x : ℝ}
    (hx : 1 ≤ |x - 3 / 2|) : localConePsiPos x = 0 := by
  rw [localConePsiPos_apply]
  apply ContDiffBump.zero_of_le_dist
  rw [Real.dist_eq]
  simpa using hx

theorem localConePsiNeg_eq_zero {x : ℝ}
    (hx : 1 ≤ |x + 3 / 2|) : localConePsiNeg x = 0 := by
  rw [localConePsiNeg_apply]
  apply ContDiffBump.zero_of_le_dist
  rw [Real.dist_eq]
  convert hx using 1 ; ring

theorem localConePsi_nonneg (x : ℝ) : 0 ≤ localConePsi x :=
  add_nonneg (localConePsiPos_nonneg x) (localConePsiNeg_nonneg x)

theorem localConePsi_eq_one_of_one_le {x : ℝ}
    (hlo : 1 ≤ x) (hhi : x ≤ 2) : localConePsi x = 1 := by
  unfold localConePsi
  have hpos : |x - 3 / 2| ≤ 1 / 2 := by
    rw [abs_le]
    constructor <;> linarith
  have hneg : 1 ≤ |x + 3 / 2| := by
    rw [abs_of_nonneg (by linarith)]
    linarith
  rw [localConePsiPos_eq_one hpos, localConePsiNeg_eq_zero hneg]
  ring

theorem localConePsi_eq_one_of_neg {x : ℝ}
    (hlo : -2 ≤ x) (hhi : x ≤ -1) : localConePsi x = 1 := by
  unfold localConePsi
  have hneg : |x + 3 / 2| ≤ 1 / 2 := by
    rw [abs_le]
    constructor <;> linarith
  have hpos : 1 ≤ |x - 3 / 2| := by
    rw [abs_of_nonpos (by linarith)]
    linarith
  rw [localConePsiNeg_eq_one hneg, localConePsiPos_eq_zero hpos]
  ring

theorem localConePsi_eq_zero_of_abs_le_half {x : ℝ}
    (hx : |x| ≤ 1 / 2) : localConePsi x = 0 := by
  unfold localConePsi
  have hpos : 1 ≤ |x - 3 / 2| := by
    rw [abs_of_nonpos (by
      have := (abs_le.mp hx).2
      linarith)]
    have h := (abs_le.mp hx).2
    linarith
  have hneg : 1 ≤ |x + 3 / 2| := by
    rw [abs_of_nonneg (by
      have := (abs_le.mp hx).1
      linarith)]
    have h := (abs_le.mp hx).1
    linarith
  rw [localConePsiPos_eq_zero hpos, localConePsiNeg_eq_zero hneg]
  ring

theorem localConePsi_eq_zero_of_five_halves_le_abs {x : ℝ}
    (hx : 5 / 2 ≤ |x|) : localConePsi x = 0 := by
  unfold localConePsi
  rcases le_total 0 x with hx0 | hx0
  · have hx' : 5 / 2 ≤ x := by
      rwa [abs_of_nonneg hx0] at hx
    have hpos : 1 ≤ |x - 3 / 2| := by
      rw [abs_of_nonneg (by linarith)]
      linarith
    have hneg : 1 ≤ |x + 3 / 2| := by
      rw [abs_of_nonneg (by linarith)]
      linarith
    rw [localConePsiPos_eq_zero hpos, localConePsiNeg_eq_zero hneg]
    ring
  · have hx' : x ≤ -5 / 2 := by
      rw [abs_of_nonpos hx0] at hx
      linarith
    have hpos : 1 ≤ |x - 3 / 2| := by
      rw [abs_of_nonpos (by linarith)]
      linarith
    have hneg : 1 ≤ |x + 3 / 2| := by
      rw [abs_of_nonpos (by linarith)]
      linarith
    rw [localConePsiPos_eq_zero hpos, localConePsiNeg_eq_zero hneg]
    ring

theorem localConePsi_contDiff :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) localConePsi := by
  unfold localConePsi
  apply ContDiff.add
  · rw [show localConePsiPos =
      (⟨(1 / 2 : ℝ), 1, by norm_num, by norm_num⟩ :
        ContDiffBump (3 / 2 : ℝ)) by rfl]
    exact (⟨(1 / 2 : ℝ), 1, by norm_num, by norm_num⟩ :
      ContDiffBump (3 / 2 : ℝ)).contDiff
  · rw [show localConePsiNeg =
      (⟨(1 / 2 : ℝ), 1, by norm_num, by norm_num⟩ :
        ContDiffBump (-3 / 2 : ℝ)) by rfl]
    exact (⟨(1 / 2 : ℝ), 1, by norm_num, by norm_num⟩ :
      ContDiffBump (-3 / 2 : ℝ)).contDiff

/-- The auxiliary low cutoff is identically one wherever the original
Calderón low cutoff can be nonzero. -/
theorem localConePhi_eq_one_of_conePhi_ne_zero {x : ℝ}
    (hx : conePhi x ≠ 0) : localConePhi x = 1 := by
  apply localConePhi_eq_one
  apply le_of_lt
  apply lt_of_not_ge
  intro hlarge
  exact hx (conePhi_eq_zero_of_two_le_abs hlarge)

/-- The auxiliary annular cutoff is identically one wherever the original
Calderón annular cutoff can be nonzero. -/
theorem localConePsi_eq_one_of_conePsi_ne_zero {x : ℝ}
    (hx : conePsi x ≠ 0) : localConePsi x = 1 := by
  have hlow : 1 < |x| := by
    apply lt_of_not_ge
    intro hsmall
    exact hx (conePsi_eq_zero_of_abs_le_one hsmall)
  have hhigh : |x| < 2 := by
    apply lt_of_not_ge
    intro hlarge
    exact hx (conePsi_eq_zero_of_two_le_abs hlarge)
  rcases le_total 0 x with hx0 | hx0
  · have hlow' : 1 < x := by rwa [abs_of_nonneg hx0] at hlow
    have hhigh' : x < 2 := by rwa [abs_of_nonneg hx0] at hhigh
    exact localConePsi_eq_one_of_one_le hlow'.le hhigh'.le
  · apply localConePsi_eq_one_of_neg
      (by
        rw [abs_of_nonpos hx0] at hhigh
        linarith)
      (by
        rw [abs_of_nonpos hx0] at hlow
        linarith)

/-- The real auxiliary localization factor used to divide out the passive
Gaussians on the three cones. -/
noncomputable def localizedCutoff (i : Fin 3) (η : E3) : ℝ :=
  localConePsi (η i) *
    ∏ j : Fin 3,
      if j = i then 1 else localConePhi (η j) / gaussian (η j)

/-- The complex localized multiplier before periodic extension. -/
noncomputable def localizedSymbol
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) (η : E3) : ℂ :=
  m (α.dilate t⁻¹ η) * localizedCutoff i η

@[simp] theorem localizedSymbol_apply
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) (η : E3) :
    localizedSymbol α m i t η =
      m (α.dilate t⁻¹ η) * localizedCutoff i η := rfl

/-- A nonzero localized cutoff is separated from the singular origin by its
active annular coordinate. -/
theorem abs_active_gt_half_of_localizedCutoff_ne_zero
    (i : Fin 3) (η : E3) (hη : localizedCutoff i η ≠ 0) :
    1 / 2 < |η i| := by
  apply lt_of_not_ge
  intro hsmall
  have hpsi : localConePsi (η i) = 0 :=
    localConePsi_eq_zero_of_abs_le_half hsmall
  apply hη
  simp [localizedCutoff, hpsi]

theorem localizedCutoff_ne_zero_implies_ne_zero
    (i : Fin 3) (η : E3) (hη : localizedCutoff i η ≠ 0) : η ≠ 0 := by
  intro hzero
  have hactive := abs_active_gt_half_of_localizedCutoff_ne_zero i η hη
  rw [hzero] at hactive
  norm_num at hactive

/-- The cutoff is identically zero on a fixed ball around the singular
frequency origin. -/
theorem localizedCutoff_eq_zero_of_norm_lt_half
    (i : Fin 3) (η : E3) (hη : ‖η‖ < 1 / 2) :
    localizedCutoff i η = 0 := by
  have hcoord : |η i| ≤ ‖η‖ := by
    simpa only [Real.norm_eq_abs] using PiLp.norm_apply_le η i
  have hpsi : localConePsi (η i) = 0 :=
    localConePsi_eq_zero_of_abs_le_half (by linarith)
  simp [localizedCutoff, hpsi]

theorem localizedSymbol_eq_zero_of_norm_lt_half
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) (η : E3)
    (hη : ‖η‖ < 1 / 2) : localizedSymbol α m i t η = 0 := by
  simp [localizedSymbol,
    localizedCutoff_eq_zero_of_norm_lt_half i η hη]

/-- On the source cone factors, the auxiliary cutoff divides out precisely
the passive Gaussian factors. -/
theorem localizedCutoff_eq_passiveGaussianInv
    (i : Fin 3) (η : E3)
    (hpsi : conePsi (η i) ≠ 0)
    (hphi : ∀ j : Fin 3, j ≠ i → conePhi (η j) ≠ 0) :
    localizedCutoff i η =
      ∏ j : Fin 3, if j = i then 1 else (gaussian (η j))⁻¹ := by
  unfold localizedCutoff
  rw [localConePsi_eq_one_of_conePsi_ne_zero hpsi]
  simp only [one_mul]
  apply Finset.prod_congr rfl
  intro j _
  by_cases hji : j = i
  · simp [hji]
  · rw [if_neg hji]
    rw [localConePhi_eq_one_of_conePhi_ne_zero (hphi j hji)]
    rw [one_div]
    simp only [if_neg hji]

/-- Each coordinate outside the auxiliary box kills the localized cutoff.
The active coordinate has the slightly smaller annular support, while a
passive coordinate is killed by the low cutoff. -/
theorem localizedCutoff_eq_zero_of_coordinate_large
    (i j : Fin 3) (η : E3)
    (hj : 3 ≤ |η j|) : localizedCutoff i η = 0 := by
  by_cases hji : j = i
  · subst j
    have hpsi : localConePsi (η i) = 0 :=
      localConePsi_eq_zero_of_five_halves_le_abs (by linarith)
    simp [localizedCutoff, hpsi]
  · have hphi : localConePhi (η j) = 0 :=
      localConePhi_eq_zero hj
    unfold localizedCutoff
    have hterm : (if j = i then 1 else
        localConePhi (η j) / gaussian (η j)) = 0 := by
      simp [hji, hphi]
    have hprod :
        (∏ k : Fin 3, if k = i then (1 : ℝ) else
          localConePhi (η k) / gaussian (η k)) = 0 := by
      exact Finset.prod_eq_zero (Finset.mem_univ j) hterm
    simp [hprod]

/-- The auxiliary cone cutoff has compact support in the fixed frequency
box. This gives uniform derivative bounds after differentiating it. -/
theorem localizedCutoff_hasCompactSupport (i : Fin 3) :
    HasCompactSupport (localizedCutoff i) := by
  apply HasCompactSupport.intro (isCompact_closedBall (0 : E3) 9)
  intro η hη
  have hnorm : 9 < ‖η‖ := by
    simpa only [Metric.mem_closedBall, dist_zero_right, not_le] using hη
  have hlarge : ∃ j : Fin 3, 3 < |η j| := by
    by_contra h
    push Not at h
    have hsum : |η 0| + |η 1| + |η 2| ≤ 9 := by
      nlinarith [h 0, h 1, h 2]
    linarith [norm_le_sum_abs η]
  obtain ⟨j, hj⟩ := hlarge
  exact localizedCutoff_eq_zero_of_coordinate_large i j η hj.le

/-- Smoothness of the fixed localized cutoff. The Gaussian never vanishes,
so dividing it out in passive coordinates preserves smoothness. -/
theorem localizedCutoff_contDiff (i : Fin 3) :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (localizedCutoff i) := by
  have hpsi : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞)
      (fun η : E3 ↦ localConePsi (η i)) :=
    localConePsi_contDiff.comp (coordinateProjection i).contDiff
  have hfactor : ∀ j : Fin 3, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞)
      (fun η : E3 ↦ if j = i then 1 else
        localConePhi (η j) / gaussian (η j)) := by
    intro j
    by_cases hji : j = i
    · subst j
      simpa using
        (contDiff_const : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞)
          (fun _ : E3 ↦ (1 : ℝ)))
    · simp only [if_neg hji]
      exact
        (localConePhi_contDiff.comp (coordinateProjection j).contDiff).div
          (gaussian_contDiff.comp (coordinateProjection j).contDiff)
          (fun η ↦ ne_of_gt (gaussian_pos (η j)))
  unfold localizedCutoff
  exact hpsi.mul (contDiff_prod (fun j _ ↦ hfactor j))

/-- A single constant bounds all localized-cutoff derivatives through any
fixed order. It is independent of the cone, frequency point, multiplier,
and dilation scale. -/
theorem exists_localizedCutoff_derivative_bound
    (i : Fin 3) (N : ℕ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ n ≤ N, ∀ η : E3,
      ‖iteratedFDeriv ℝ n (localizedCutoff i) η‖ ≤ C := by
  have hb : ∀ n : ℕ, ∃ C : ℝ, ∀ η : E3,
      ‖iteratedFDeriv ℝ n (localizedCutoff i) η‖ ≤ C := by
    intro n
    exact ((localizedCutoff_hasCompactSupport i).iteratedFDeriv n).exists_bound_of_continuous
      ((localizedCutoff_contDiff i).continuous_iteratedFDeriv
        (by exact_mod_cast le_top))
  choose C hC using hb
  have hnn : (0 : ℝ) ≤ ∑ n ∈ Finset.range (N + 1), |C n| :=
    Finset.sum_nonneg (fun n _ ↦ abs_nonneg _)
  refine ⟨1 + ∑ n ∈ Finset.range (N + 1), |C n|, by linarith, ?_⟩
  intro n hn η
  refine le_trans (hC n η) ?_
  have hmem : n ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
  have hle : |C n| ≤ ∑ m ∈ Finset.range (N + 1), |C m| :=
    Finset.single_le_sum (f := fun m ↦ |C m|) (fun m _ ↦ abs_nonneg _) hmem
  linarith [le_abs_self (C n)]

/-- Despite the multiplier only being smooth off zero, multiplication by the
localized cutoff gives a globally smooth localized symbol: the cutoff is
identically zero in a neighborhood of the only singular point. -/
theorem localizedSymbol_contDiff
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t) :
    ContDiff ℝ 110 (localizedSymbol α m i t) := by
  rw [contDiff_iff_contDiffAt]
  intro η
  by_cases hη : η = 0
  · subst η
    refine (contDiffAt_const : ContDiffAt ℝ 110 (fun _ : E3 ↦ (0 : ℂ)) 0).congr_of_eventuallyEq ?_
    filter_upwards [Metric.ball_mem_nhds (0 : E3) (by norm_num : (0 : ℝ) < 1 / 2)] with z hz
    have hnorm : ‖z‖ < 1 / 2 := by
      simpa only [Metric.mem_ball, dist_zero_right] using hz
    exact localizedSymbol_eq_zero_of_norm_lt_half α m i t z hnorm
  · let L : E3 →L[ℝ] E3 :=
      { α.dilateLinear t⁻¹ with
        cont := LinearMap.continuous_of_finiteDimensional (α.dilateLinear t⁻¹) }
    have hLapply (z : E3) : L z = α.dilate t⁻¹ z := by
      change (α.dilateLinear t⁻¹) z = α.dilate t⁻¹ z
      exact α.dilateLinear_apply t⁻¹ z
    have hLηne : L η ≠ 0 := by
      rw [hLapply]
      intro hzero
      have hrecover := α.dilate_apply_inv ht.ne' η
      rw [hzero] at hrecover
      apply hη
      change α.dilate t (0 : E3) = η at hrecover
      have hzeroDilate : α.dilate t (0 : E3) = 0 := by
        rw [← α.dilateLinear_apply]
        exact (α.dilateLinear t).map_zero
      rw [hzeroDilate] at hrecover
      exact hrecover.symm
    have hopen : IsOpen ({0}ᶜ : Set E3) := by
      simp
    have hcompOn : ContDiffOn ℝ 110 (m ∘ L) (L ⁻¹' ({0}ᶜ : Set E3)) :=
      hm.2.2.2.1.comp_continuousLinearMap L
    have hcompAt : ContDiffAt ℝ 110 (m ∘ L) η :=
      hcompOn.contDiffAt ((hopen.preimage L.continuous).mem_nhds (by
        simpa using hLηne))
    have hcutAt : ContDiffAt ℝ 110 (localizedCutoff i) η :=
      ((localizedCutoff_contDiff i).of_le
        (show (110 : WithTop ℕ∞) ≤ ((↑(⊤ : ℕ∞)) : WithTop ℕ∞) by
          exact WithTop.coe_le_coe.mpr (show (110 : ℕ∞) ≤ ⊤ by exact le_top))).contDiffAt
    have hcutAtC : ContDiffAt ℝ 110
        (fun z : E3 ↦ (localizedCutoff i z : ℂ)) η := by
      have hglobal : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞)
          (Complex.ofRealCLM ∘ localizedCutoff i) :=
        Complex.ofRealCLM.contDiff.comp (localizedCutoff_contDiff i)
      exact ((hglobal.of_le
        (show (110 : WithTop ℕ∞) ≤ ((↑(⊤ : ℕ∞)) : WithTop ℕ∞) by
          exact WithTop.coe_le_coe.mpr (show (110 : ℕ∞) ≤ ⊤ by exact le_top))).contDiffAt)
    have heq : localizedSymbol α m i t =
        fun z : E3 ↦ (m ∘ L) z * localizedCutoff i z := by
      funext z
      simp only [localizedSymbol, Function.comp_apply]
      rw [hLapply]
    rw [heq]
    exact hcompAt.mul hcutAtC

/-- The standard Euclidean coordinate directions give the usual basis
expansion of `E3`. -/
theorem coordinateDirection_sum_repr (v : E3) :
    (∑ j : Fin 3, v j • Anisotropy.coordinateDirection j) = v := by
  simpa only [Anisotropy.coordinateDirection, EuclideanSpace.basisFun_repr] using
    (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr v

/-- A coordinatewise bound for a continuous multilinear map controls its
operator norm.  This is the finite-dimensional bridge from the blueprint's
multi-index estimates to Mathlib's Fréchet-derivative norm estimates. -/
theorem continuousMultilinearMap_norm_le_coordinateBound
    (k : ℕ) (F : ContinuousMultilinearMap ℝ (fun _ : Fin k ↦ E3) ℂ)
    (B : ℝ) (hB : 0 ≤ B)
    (hcoord : ∀ σ : Fin k → Fin 3,
      ‖F (fun r ↦ Anisotropy.coordinateDirection (σ r))‖ ≤ B) :
    ‖F‖ ≤ (3 : ℝ) ^ k * B := by
  apply F.opNorm_le_bound
  · positivity
  intro v
  have hv : v =
      (fun r ↦ ∑ j : Fin 3, v r j • Anisotropy.coordinateDirection j) := by
    funext r
    exact (coordinateDirection_sum_repr (v r)).symm
  conv_lhs => rw [hv]
  rw [F.map_sum]
  rw [show (fun (σ : Fin k → Fin 3) ↦
      F (fun r ↦ v r (σ r) • Anisotropy.coordinateDirection (σ r))) =
      (fun σ ↦ (∏ r : Fin k, v r (σ r)) •
        F (fun r ↦ Anisotropy.coordinateDirection (σ r))) by
      funext σ
      exact F.map_smul_univ (fun r ↦ v r (σ r))
        (fun r ↦ Anisotropy.coordinateDirection (σ r))]
  calc
    ‖∑ σ : Fin k → Fin 3,
        (∏ r : Fin k, v r (σ r)) •
          F (fun r ↦ Anisotropy.coordinateDirection (σ r))‖ ≤
        ∑ σ : Fin k → Fin 3,
          ‖(∏ r : Fin k, v r (σ r)) •
            F (fun r ↦ Anisotropy.coordinateDirection (σ r))‖ :=
      norm_sum_le Finset.univ _
    _ ≤ ∑ _σ : Fin k → Fin 3, B * ∏ r : Fin k, ‖v r‖ := by
      apply Finset.sum_le_sum
      intro σ _
      rw [norm_smul, Real.norm_eq_abs]
      have hcoeff : |∏ r : Fin k, v r (σ r)| ≤ ∏ r : Fin k, ‖v r‖ := by
        rw [Finset.abs_prod]
        apply Finset.prod_le_prod
        · intro r _
          exact abs_nonneg _
        · intro r _
          simpa only [Real.norm_eq_abs] using PiLp.norm_apply_le (v r) (σ r)
      calc
        |∏ r : Fin k, v r (σ r)| *
            ‖F (fun r ↦ Anisotropy.coordinateDirection (σ r))‖ ≤
            (∏ r : Fin k, ‖v r‖) * B :=
          mul_le_mul hcoeff (hcoord σ) (norm_nonneg _) (Finset.prod_nonneg
            (fun r _ ↦ norm_nonneg (v r)))
        _ = B * ∏ r : Fin k, ‖v r‖ := by ring
    _ = (3 : ℝ) ^ k * B * ∏ r : Fin k, ‖v r‖ := by
      rw [Finset.sum_const, nsmul_eq_mul, Finset.card_univ]
      simp only [Fintype.card_fun, Fintype.card_fin, Nat.cast_pow]
      ring

/-- The coordinate-form multiplier hypothesis supplies an explicit full
Fréchet-derivative norm bound after anisotropic rescaling.  The finite sum is
deliberately retained, avoiding any hidden norm-equivalence constant. -/
theorem dilate_iteratedFDeriv_norm_le_coordinateSum
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    {t : ℝ} (ht : 0 < t) (η : E3) (k : ℕ) (hk : k ≤ 110)
    (hη : η ≠ 0) :
    ‖iteratedFDeriv ℝ k (fun z : E3 ↦ m (α.dilate t⁻¹ z)) η‖ ≤
      (3 : ℝ) ^ k * ∑ σ : Fin k → Fin 3,
        M * (α.radius η) ^ (-((α.derivativeWeight σ : ℕ) : ℝ)) := by
  let B : ℝ := ∑ σ : Fin k → Fin 3,
    M * (α.radius η) ^ (-((α.derivativeWeight σ : ℕ) : ℝ))
  have hterm_nonneg (σ : Fin k → Fin 3) :
      0 ≤ M * (α.radius η) ^ (-((α.derivativeWeight σ : ℕ) : ℝ)) :=
    mul_nonneg hm.nonneg (Real.rpow_nonneg (radius_pos_of_ne_zero α hη).le _)
  have hB : 0 ≤ B := Finset.sum_nonneg (fun σ _ ↦ hterm_nonneg σ)
  apply (continuousMultilinearMap_norm_le_coordinateBound
    k (iteratedFDeriv ℝ k (fun z : E3 ↦ m (α.dilate t⁻¹ z)) η) B hB)
  intro σ
  have hpoint := dilate_coordinate_derivative_bound α M m hm ht η k hk σ hη
  refine hpoint.trans ?_
  exact Finset.single_le_sum (fun τ _ ↦ hterm_nonneg τ) (Finset.mem_univ σ)

/-- Every point outside the fixed half-ball used by the localized cutoff has
anisotropic radius at least `1/6`.  This deliberately crude constant is
uniform in the anisotropy. -/
theorem radius_ge_one_sixth_of_norm_ge_half
    (α : Anisotropy) (η : E3) (hη : 1 / 2 ≤ ‖η‖) :
    1 / 6 ≤ α.radius η := by
  obtain ⟨i, hi⟩ : ∃ i : Fin 3, 1 / 6 ≤ |η i| := by
    by_contra h
    push Not at h
    have hsum : |η 0| + |η 1| + |η 2| < 1 / 2 := by
      nlinarith [h 0, h 1, h 2]
    linarith [norm_le_sum_abs η]
  have hwi : (1 : ℝ) ≤ α.weight i := by
    exact_mod_cast (α.weight_pos i)
  have hinv : (α.weight i : ℝ)⁻¹ ≤ 1 :=
    inv_le_one_of_one_le₀ hwi
  have hbase : (1 / 6 : ℝ) ^ ((α.weight i : ℝ)⁻¹) ≤
      |η i| ^ ((α.weight i : ℝ)⁻¹) :=
    Real.rpow_le_rpow (by norm_num) hi (inv_nonneg.mpr (by positivity))
  have hpow : (1 / 6 : ℝ) ≤ (1 / 6 : ℝ) ^ ((α.weight i : ℝ)⁻¹) :=
    Real.self_le_rpow_of_le_one (by norm_num) (by norm_num) hinv
  unfold Anisotropy.radius
  exact le_trans (le_trans hpow hbase)
    (Finset.single_le_sum (s := Finset.univ)
      (fun j _ ↦ Real.rpow_nonneg (abs_nonneg (η j)) ((α.weight j : ℝ)⁻¹))
      (Finset.mem_univ i))

/-- On the region where a localized symbol can have nonzero derivatives, the
rescaled multiplier's full derivative norm has a scale-independent finite
bound obtained directly from the source coordinate estimates. -/
theorem dilate_iteratedFDeriv_norm_le_uniform_on_half_compl
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    {t : ℝ} (ht : 0 < t) (η : E3) (k : ℕ) (hk : k ≤ 110)
    (hη : 1 / 2 ≤ ‖η‖) :
    ‖iteratedFDeriv ℝ k (fun z : E3 ↦ m (α.dilate t⁻¹ z)) η‖ ≤
      (3 : ℝ) ^ k * ∑ σ : Fin k → Fin 3,
        M * (6 : ℝ) ^ (α.derivativeWeight σ) := by
  have hηne : η ≠ 0 := by
    intro hz
    rw [hz] at hη
    norm_num at hη
  have hradius : 1 / 6 ≤ α.radius η :=
    radius_ge_one_sixth_of_norm_ge_half α η hη
  have hsource := dilate_iteratedFDeriv_norm_le_coordinateSum
    α M m hm ht η k hk hηne
  refine hsource.trans ?_
  apply mul_le_mul_of_nonneg_left
  · apply Finset.sum_le_sum
    intro σ _
    have hpow : (α.radius η) ^ (-((α.derivativeWeight σ : ℕ) : ℝ)) ≤
        (1 / 6 : ℝ) ^ (-((α.derivativeWeight σ : ℕ) : ℝ)) :=
      Real.rpow_le_rpow_of_nonpos (by norm_num) hradius (by simp)
    calc
      M * (α.radius η) ^ (-((α.derivativeWeight σ : ℕ) : ℝ)) ≤
          M * (1 / 6 : ℝ) ^ (-((α.derivativeWeight σ : ℕ) : ℝ)) :=
        mul_le_mul_of_nonneg_left hpow hm.nonneg
      _ = M * (6 : ℝ) ^ (α.derivativeWeight σ) := by
        rw [← Real.rpow_natCast, Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 1 / 6)]
        congr 1
        rw [← Real.inv_rpow (by norm_num : (0 : ℝ) ≤ 1 / 6)]
        norm_num
  · positivity

/-- A localized symbol has zero iterated derivative in the ball on which it
is identically zero. -/
theorem iteratedFDeriv_localizedSymbol_eq_zero_of_norm_lt_half
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    (η : E3) (hη : ‖η‖ < 1 / 2) (k : ℕ) :
    iteratedFDeriv ℝ k (localizedSymbol α m i t) η = 0 := by
  have hball : Metric.ball η (1 / 2 - ‖η‖) ∈ 𝓝 η :=
    Metric.ball_mem_nhds η (sub_pos.mpr hη)
  have hlocal : localizedSymbol α m i t =ᶠ[𝓝 η]
      fun _ : E3 ↦ (0 : ℂ) := by
    filter_upwards [hball] with z hz
    have hdist : ‖z - η‖ < 1 / 2 - ‖η‖ := by
      simpa only [Metric.mem_ball, dist_eq_norm] using hz
    have hnorm : ‖z‖ < 1 / 2 := by
      calc
        ‖z‖ = ‖(z - η) + η‖ := by congr 1 ; abel
        _ ≤ ‖z - η‖ + ‖η‖ := norm_add_le (z - η) η
        _ < 1 / 2 := by linarith
    exact localizedSymbol_eq_zero_of_norm_lt_half α m i t z hnorm
  have hderiv := (hlocal.iteratedFDeriv ℝ k).eq_of_nhds
  rw [hderiv, iteratedFDeriv_fun_zero]
  rfl

/-- Leibniz estimate for the localized symbol away from its zero neighborhood.
All terms are expressed using the scale-independent full derivative bound for
the rescaled multiplier and an arbitrary cutoff-derivative bound. -/
theorem norm_iteratedFDeriv_localizedSymbol_le_half_compl
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t)
    (C : ℝ)
    (hcut : ∀ n ≤ 110, ∀ η : E3,
      ‖iteratedFDeriv ℝ n (fun z : E3 ↦ (localizedCutoff i z : ℂ)) η‖ ≤ C)
    (η : E3) (k : ℕ) (hk : k ≤ 110) (hη : 1 / 2 ≤ ‖η‖) :
    ‖iteratedFDeriv ℝ k (localizedSymbol α m i t) η‖ ≤
      ∑ n ∈ Finset.range (k + 1),
        (k.choose n : ℝ) *
          ((3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
            M * (6 : ℝ) ^ (α.derivativeWeight σ)) * C := by
  let L : E3 →L[ℝ] E3 :=
    { α.dilateLinear t⁻¹ with
      cont := LinearMap.continuous_of_finiteDimensional (α.dilateLinear t⁻¹) }
  let S : Set E3 := L ⁻¹' ({0}ᶜ : Set E3)
  let f : E3 → ℂ := m ∘ L
  let g : E3 → ℂ := fun z ↦ (localizedCutoff i z : ℂ)
  have hLapply (z : E3) : L z = α.dilate t⁻¹ z := by
    change (α.dilateLinear t⁻¹) z = α.dilate t⁻¹ z
    exact α.dilateLinear_apply t⁻¹ z
  have hηne : η ≠ 0 := by
    intro hzero
    rw [hzero] at hη
    norm_num at hη
  have hLηne : L η ≠ 0 := by
    rw [hLapply]
    intro hzero
    have hrecover := α.dilate_apply_inv ht.ne' η
    rw [hzero] at hrecover
    apply hηne
    change α.dilate t (0 : E3) = η at hrecover
    have hzeroDilate : α.dilate t (0 : E3) = 0 := by
      rw [← α.dilateLinear_apply]
      exact (α.dilateLinear t).map_zero
    rw [hzeroDilate] at hrecover
    exact hrecover.symm
  have hopen : IsOpen S := by
    exact (isOpen_compl_singleton : IsOpen ({0}ᶜ : Set E3)).preimage L.continuous
  have hηS : η ∈ S := by simpa [S] using hLηne
  have hSunique : UniqueDiffOn ℝ S := hopen.uniqueDiffOn
  have hfOn : ContDiffOn ℝ 110 f S := by
    simpa only [f, S] using hm.2.2.2.1.comp_continuousLinearMap L
  have hgGlobal : ContDiff ℝ 110 g := by
    have htop : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞)
        (Complex.ofRealCLM ∘ localizedCutoff i) :=
      Complex.ofRealCLM.contDiff.comp (localizedCutoff_contDiff i)
    change ContDiff ℝ 110 (fun z : E3 ↦ (localizedCutoff i z : ℂ))
    exact htop.of_le
      (show (110 : WithTop ℕ∞) ≤ ((↑(⊤ : ℕ∞)) : WithTop ℕ∞) by
        exact WithTop.coe_le_coe.mpr (show (110 : ℕ∞) ≤ ⊤ by exact le_top))
  have hgOn : ContDiffOn ℝ 110 g S := hgGlobal.contDiffOn
  have hproduct : localizedSymbol α m i t = fun z ↦ f z * g z := by
    funext z
    simp only [localizedSymbol, f, g, Function.comp_apply]
    rw [hLapply]
  have hprodWithin : iteratedFDerivWithin ℝ k (fun z ↦ f z * g z) S η =
      iteratedFDeriv ℝ k (fun z ↦ f z * g z) η :=
    iteratedFDerivWithin_eq_iteratedFDeriv hSunique
      (((hfOn.contDiffAt (hopen.mem_nhds hηS)).mul
        (hgOn.contDiffAt (hopen.mem_nhds hηS))).of_le
          (by exact_mod_cast hk)) hηS
  have hfWithin (n : ℕ) (hn : n ≤ 110) :
      iteratedFDerivWithin ℝ n f S η = iteratedFDeriv ℝ n f η :=
    iteratedFDerivWithin_eq_iteratedFDeriv hSunique
      ((hfOn.contDiffAt (hopen.mem_nhds hηS)).of_le
        (by exact_mod_cast hn)) hηS
  have hgWithin (n : ℕ) (hn : n ≤ 110) :
      iteratedFDerivWithin ℝ n g S η = iteratedFDeriv ℝ n g η :=
    iteratedFDerivWithin_eq_iteratedFDeriv hSunique
      ((hgOn.contDiffAt (hopen.mem_nhds hηS)).of_le
        (by exact_mod_cast hn)) hηS
  have hle := norm_iteratedFDerivWithin_mul_le hfOn hgOn hSunique hηS
    (show (k : WithTop ℕ∞) ≤ 110 by exact_mod_cast hk)
  rw [hproduct]
  rw [← hprodWithin]
  refine hle.trans ?_
  apply Finset.sum_le_sum
  intro n hn
  have hnle : n ≤ k := Nat.le_of_lt_succ (Finset.mem_range.mp hn)
  have hsub : k - n ≤ 110 := le_trans (Nat.sub_le _ _) hk
  rw [hfWithin n (le_trans hnle hk), hgWithin (k - n) hsub]
  have hfbound := dilate_iteratedFDeriv_norm_le_uniform_on_half_compl
    α M m hm ht η n (le_trans hnle hk) hη
  have hfbound' : ‖iteratedFDeriv ℝ n f η‖ ≤
      (3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
        M * (6 : ℝ) ^ (α.derivativeWeight σ) := by
    have hfun : (fun z : E3 ↦ m (α.dilate t⁻¹ z)) = f := by
      funext z
      simp only [f, Function.comp_apply]
      rw [hLapply]
    rw [hfun] at hfbound
    exact hfbound
  have hgbound : ‖iteratedFDeriv ℝ (k - n) g η‖ ≤ C :=
    hcut (k - n) hsub η
  have hBnonneg : 0 ≤ (3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
      M * (6 : ℝ) ^ (α.derivativeWeight σ) := by
    apply mul_nonneg
    · positivity
    · apply Finset.sum_nonneg
      intro σ _
      exact mul_nonneg hm.nonneg (by positivity)
  calc
    (k.choose n : ℝ) * ‖iteratedFDeriv ℝ n f η‖ *
        ‖iteratedFDeriv ℝ (k - n) g η‖ =
        (k.choose n : ℝ) *
          (‖iteratedFDeriv ℝ n f η‖ * ‖iteratedFDeriv ℝ (k - n) g η‖) := by ring
    _ ≤ (k.choose n : ℝ) *
        ((3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
          M * (6 : ℝ) ^ (α.derivativeWeight σ)) *
          ‖iteratedFDeriv ℝ (k - n) g η‖ := by
      rw [mul_assoc]
      exact mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_right hfbound' (norm_nonneg _)) (by positivity)
    _ ≤ (k.choose n : ℝ) *
        ((3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
          M * (6 : ℝ) ^ (α.derivativeWeight σ)) * C := by
      have hchoose : 0 ≤ (k.choose n : ℝ) := by positivity
      have hinner :
          ((3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
            M * (6 : ℝ) ^ (α.derivativeWeight σ)) *
              ‖iteratedFDeriv ℝ (k - n) g η‖ ≤
          ((3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
            M * (6 : ℝ) ^ (α.derivativeWeight σ)) * C :=
        mul_le_mul_of_nonneg_left hgbound hBnonneg
      calc
        (k.choose n : ℝ) *
            ((3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
              M * (6 : ℝ) ^ (α.derivativeWeight σ)) *
            ‖iteratedFDeriv ℝ (k - n) g η‖ =
            (k.choose n : ℝ) *
              (((3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
                M * (6 : ℝ) ^ (α.derivativeWeight σ)) *
                ‖iteratedFDeriv ℝ (k - n) g η‖) := by ring
        _ ≤ (k.choose n : ℝ) *
            (((3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
              M * (6 : ℝ) ^ (α.derivativeWeight σ)) * C) :=
          mul_le_mul_of_nonneg_left hinner hchoose
        _ = (k.choose n : ℝ) *
            ((3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
              M * (6 : ℝ) ^ (α.derivativeWeight σ)) * C := by ring

/-- The complex-valued auxiliary cutoff has a single global derivative bound
through any prescribed finite order. -/
theorem exists_complexLocalizedCutoff_derivative_bound
    (i : Fin 3) (N : ℕ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ n ≤ N, ∀ η : E3,
      ‖iteratedFDeriv ℝ n
        (fun z : E3 ↦ (localizedCutoff i z : ℂ)) η‖ ≤ C := by
  have hsupport : HasCompactSupport
      (Complex.ofRealCLM ∘ localizedCutoff i) :=
    (localizedCutoff_hasCompactSupport i).comp_left rfl
  have htop : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞)
      (Complex.ofRealCLM ∘ localizedCutoff i) :=
    Complex.ofRealCLM.contDiff.comp (localizedCutoff_contDiff i)
  have hb : ∀ n : ℕ, ∃ C : ℝ, ∀ η : E3,
      ‖iteratedFDeriv ℝ n
        (fun z : E3 ↦ (localizedCutoff i z : ℂ)) η‖ ≤ C := by
    intro n
    have hbound := (hsupport.iteratedFDeriv n).exists_bound_of_continuous
      (htop.continuous_iteratedFDeriv (by exact_mod_cast le_top))
    have hfun : (Complex.ofRealCLM ∘ localizedCutoff i) =
        (fun z : E3 ↦ (localizedCutoff i z : ℂ)) := by
      rfl
    rw [hfun] at hbound
    exact hbound
  choose C hC using hb
  have hnn : (0 : ℝ) ≤ ∑ n ∈ Finset.range (N + 1), |C n| :=
    Finset.sum_nonneg (fun n _ ↦ abs_nonneg _)
  refine ⟨1 + ∑ n ∈ Finset.range (N + 1), |C n|, by linarith, ?_⟩
  intro n hn η
  refine le_trans (hC n η) ?_
  have hmem : n ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
  have hle : |C n| ≤ ∑ m ∈ Finset.range (N + 1), |C m| :=
    Finset.single_le_sum (f := fun m ↦ |C m|) (fun m _ ↦ abs_nonneg _) hmem
  linarith [le_abs_self (C n)]

/-- For every derivative order used in the multiplier hypothesis, the
localized symbol has a scale-uniform bound with the required linear factor
`M`.  The constant may depend on the order and the fixed cone. -/
theorem exists_localizedSymbol_derivative_bound
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t) :
    ∀ k : ℕ, k ≤ 110 → ∃ C : ℝ, 0 ≤ C ∧ ∀ η : E3,
      ‖iteratedFDeriv ℝ k (localizedSymbol α m i t) η‖ ≤ C * M := by
  rcases exists_complexLocalizedCutoff_derivative_bound i 110 with
    ⟨D, hD, hcut⟩
  intro k hk
  let Ck : ℝ := ∑ n ∈ Finset.range (k + 1),
    (k.choose n : ℝ) *
      ((3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
        (6 : ℝ) ^ (α.derivativeWeight σ)) * D
  have hDnonneg : 0 ≤ D := le_trans (by norm_num) hD
  have hCknonneg : 0 ≤ Ck := by
    dsimp [Ck]
    apply Finset.sum_nonneg
    intro n hn
    apply mul_nonneg
    · apply mul_nonneg
      · positivity
      · apply mul_nonneg
        · positivity
        · apply Finset.sum_nonneg
          intro σ _
          positivity
    · exact hDnonneg
  refine ⟨Ck, hCknonneg, ?_⟩
  intro η
  by_cases hη : ‖η‖ < 1 / 2
  · rw [iteratedFDeriv_localizedSymbol_eq_zero_of_norm_lt_half
      α m i t η hη k]
    simp only [norm_zero]
    exact mul_nonneg hCknonneg hm.nonneg
  · have hhalf : 1 / 2 ≤ ‖η‖ := le_of_not_gt hη
    have hbound := norm_iteratedFDeriv_localizedSymbol_le_half_compl
      α M m hm i ht D hcut η k hk hhalf
    refine hbound.trans ?_
    have hfactor :
        (∑ n ∈ Finset.range (k + 1),
          (k.choose n : ℝ) *
            ((3 : ℝ) ^ n * ∑ σ : Fin n → Fin 3,
              M * (6 : ℝ) ^ (α.derivativeWeight σ)) * D) = Ck * M := by
      dsimp [Ck]
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro n hn
      rw [← Finset.mul_sum]
      ring
    exact le_of_eq hfactor

/-- The auxiliary localized cutoff exactly cancels the passive Gaussian
factors on a cone. This is the scalar algebra behind insertion of the
Fourier expansion into the Calderón cone identity. -/
theorem localizedCutoff_cone_factor_identity
    (i : Fin 3) (η : E3) :
    localizedCutoff i η * conePsi (η i) * gaussianDeriv (η i) ^ 2 *
        (∏ j : Fin 3, if j = i then 1 else gaussian (η j) * conePhi (η j)) =
      conePsi (η i) * gaussianDeriv (η i) ^ 2 *
        ∏ j : Fin 3, if j = i then 1 else conePhi (η j) := by
  by_cases hpsi : conePsi (η i) = 0
  · simp [hpsi]
  by_cases hall : ∀ j : Fin 3, j ≠ i → conePhi (η j) ≠ 0
  · rw [localizedCutoff_eq_passiveGaussianInv i η hpsi hall]
    fin_cases i <;> simp [Fin.prod_univ_succ]
    all_goals
      have hg0 : gaussian (η 0) ≠ 0 := (gaussian_pos _).ne'
      have hg1 : gaussian (η 1) ≠ 0 := (gaussian_pos _).ne'
      have hg2 : gaussian (η 2) ≠ 0 := (gaussian_pos _).ne'
      field_simp [hg0, hg1, hg2]
  · push Not at hall
    obtain ⟨j, hji, hphi⟩ := hall
    have hleft :
        (∏ k : Fin 3, if k = i then 1 else gaussian (η k) * conePhi (η k)) = 0 := by
      apply Finset.prod_eq_zero (Finset.mem_univ j)
      simp [hji, hphi]
    have hright :
        (∏ k : Fin 3, if k = i then 1 else conePhi (η k)) = 0 := by
      apply Finset.prod_eq_zero (Finset.mem_univ j)
      simp [hji, hphi]
    rw [hleft, hright]
    ring

/-- The same cancellation identity after multiplying by the rescaled complex
symbol. -/
theorem localizedSymbol_cone_factor_identity
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) (η : E3) :
    localizedSymbol α m i t η *
        (conePsi (η i) * gaussianDeriv (η i) ^ 2 : ℂ) *
        (∏ j : Fin 3,
          if j = i then 1 else (gaussian (η j) * conePhi (η j) : ℂ)) =
      m (α.dilate t⁻¹ η) *
        (conePsi (η i) * gaussianDeriv (η i) ^ 2 : ℂ) *
        ∏ j : Fin 3, if j = i then 1 else (conePhi (η j) : ℂ) := by
  rw [localizedSymbol_apply]
  have hreal := localizedCutoff_cone_factor_identity i η
  have hprodL :
      ((∏ j : Fin 3, if j = i then (1 : ℝ) else
        gaussian (η j) * conePhi (η j) : ℝ) : ℂ) =
      ∏ j : Fin 3, if j = i then 1 else
        (gaussian (η j) * conePhi (η j) : ℂ) := by
    fin_cases i <;> simp [Fin.prod_univ_succ]
  have hprodR :
      ((∏ j : Fin 3, if j = i then (1 : ℝ) else conePhi (η j) : ℝ) : ℂ) =
      ∏ j : Fin 3, if j = i then 1 else (conePhi (η j) : ℂ) := by
    fin_cases i <;> simp [Fin.prod_univ_succ]
  calc
    (m (α.dilate t⁻¹ η) * (localizedCutoff i η : ℂ)) *
        (conePsi (η i) * gaussianDeriv (η i) ^ 2 : ℂ) *
        (∏ j : Fin 3,
          if j = i then 1 else (gaussian (η j) * conePhi (η j) : ℂ)) =
      m (α.dilate t⁻¹ η) *
        ((localizedCutoff i η * conePsi (η i) *
          gaussianDeriv (η i) ^ 2 *
          ∏ j : Fin 3, if j = i then 1 else
            gaussian (η j) * conePhi (η j) : ℝ) : ℂ) := by
          rw [← hprodL]
          push_cast
          ring
    _ = m (α.dilate t⁻¹ η) *
        ((conePsi (η i) * gaussianDeriv (η i) ^ 2 *
          ∏ j : Fin 3, if j = i then 1 else conePhi (η j) : ℝ) : ℂ) := by
          rw [hreal]
    _ = _ := by
      rw [← hprodR]
      push_cast
      ring

/-- The cone-factor identity in the source variables `η = D_t ξ`. Thus the
rescaled localized symbol supplies the original multiplier on every cone term
before Fourier expansion. -/
theorem localizedSymbol_dilate_cone_factor_identity
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) {t : ℝ} (ht : 0 < t)
    (ξ : E3) :
    localizedSymbol α m i t (α.dilate t ξ) *
        (conePsi (α.dilate t ξ i) * gaussianDeriv (α.dilate t ξ i) ^ 2 : ℂ) *
        (∏ j : Fin 3, if j = i then 1 else
          (gaussian (α.dilate t ξ j) * conePhi (α.dilate t ξ j) : ℂ)) =
      m ξ *
        (conePsi (α.dilate t ξ i) * gaussianDeriv (α.dilate t ξ i) ^ 2 : ℂ) *
        ∏ j : Fin 3, if j = i then 1 else (conePhi (α.dilate t ξ j) : ℂ) := by
  rw [localizedSymbol_cone_factor_identity]
  rw [α.dilate_inv_apply ht.ne']

/-- The localized complex symbol inherits the fixed compact support of its
auxiliary cutoff. -/
theorem localizedSymbol_hasCompactSupport
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) :
    HasCompactSupport (localizedSymbol α m i t) := by
  have hcut : HasCompactSupport (fun η : E3 ↦ (localizedCutoff i η : ℂ)) :=
    HasCompactSupport.comp_left (localizedCutoff_hasCompactSupport i)
      (g := fun x : ℝ ↦ (x : ℂ)) (by norm_num)
  have hprod : HasCompactSupport
      ((fun η : E3 ↦ m (α.dilate t⁻¹ η)) *
        fun η : E3 ↦ (localizedCutoff i η : ℂ)) :=
    hcut.mul_left
  change HasCompactSupport
    ((fun η : E3 ↦ m (α.dilate t⁻¹ η)) *
      fun η : E3 ↦ (localizedCutoff i η : ℂ))
  exact hprod

/-- Each coordinate outside the fixed auxiliary box kills the complex
localized symbol. -/
theorem localizedSymbol_eq_zero_of_coordinate_large
    (α : Anisotropy) (m : E3 → ℂ) (i j : Fin 3) (t : ℝ) (η : E3)
    (hj : 3 ≤ |η j|) : localizedSymbol α m i t η = 0 := by
  rw [localizedSymbol_apply, localizedCutoff_eq_zero_of_coordinate_large i j η hj]
  simp

/-! ### Period-eight Fourier extension of the localized symbol -/

/-- The auxiliary period-eight additive circle used for the compactly
supported localized multiplier. -/
abbrev PeriodEightCircle := AddCircle (8 : ℝ)

local instance : Fact (0 < (8 : ℝ)) := ⟨by norm_num⟩

/-- A parameterized lift from one real coordinate to the period-eight
additive circle. -/
noncomputable def periodEightLift {X : Type*}
    (f : ℝ → X → ℂ) : PeriodEightCircle → X → ℂ :=
  fun q x ↦ AddCircle.liftIco 8 (-4) (fun r : ℝ ↦ f r x) q

theorem continuous_periodEightLift
    {X : Type*} [TopologicalSpace X] [LocallyCompactSpace X]
    (f : ℝ → X → ℂ)
    (hboundary : ∀ x : X, f (-4) x = f 4 x)
    (hcont : Continuous (fun p : ℝ × X ↦ f p.1 p.2)) :
    Continuous (fun p : PeriodEightCircle × X ↦ periodEightLift f p.1 p.2) := by
  let F : C(ℝ × X, ℂ) := ⟨fun p ↦ f p.1 p.2, hcont⟩
  let G : C(ℝ, C(X, ℂ)) := ContinuousMap.curry F
  have hGboundary : G (-4) = G 4 := by
    ext x
    exact hboundary x
  let H : C(PeriodEightCircle, C(X, ℂ)) :=
    ⟨AddCircle.liftIco 8 (-4) G,
      AddCircle.liftIco_continuous (by
        norm_num
        exact hGboundary) G.continuous.continuousOn⟩
  have hunc : Continuous (fun p : PeriodEightCircle × X ↦ H p.1 p.2) :=
    ContinuousMap.continuous_uncurry_of_continuous H
  refine hunc.congr ?_
  intro p
  rfl

theorem periodEightLift_eq_zero
    {X : Type*} (f : ℝ → X → ℂ) (q : PeriodEightCircle) (x : X)
    (hzero : ∀ r : ℝ, f r x = 0) : periodEightLift f q x = 0 := by
  unfold periodEightLift
  change f (↑(AddCircle.equivIco 8 (-4) q) : ℝ) x = 0
  exact hzero _

theorem periodEightLift_coe
    {X : Type*} (f : ℝ → X → ℂ) {r : ℝ}
    (hr : r ∈ Set.Ico (-4 : ℝ) 4) (x : X) :
    periodEightLift f (r : PeriodEightCircle) x = f r x := by
  have hr' : r ∈ Set.Ico (-4 : ℝ) ((-4 : ℝ) + 8) := by
    norm_num
    exact hr
  unfold periodEightLift
  exact AddCircle.liftIco_coe_apply hr'

/-- The localized symbol in ordinary three scalar coordinates. -/
noncomputable def localizedSymbolRaw
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t x y z : ℝ) : ℂ :=
  localizedSymbol α m i t (frequencyAssemble3 x y z)

@[simp]
theorem localizedSymbolRaw_apply
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t x y z : ℝ) :
    localizedSymbolRaw α m i t x y z =
      localizedSymbol α m i t (frequencyAssemble3 x y z) := rfl

theorem continuous_localizedSymbolRaw
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t) :
    Continuous (fun p : ℝ × (ℝ × ℝ) ↦
      localizedSymbolRaw α m i t p.1 p.2.1 p.2.2) := by
  have hcoordinates : Continuous (fun p : ℝ × (ℝ × ℝ) ↦
      frequencyAssemble3 p.1 p.2.1 p.2.2) := by
    change Continuous (WithLp.toLp 2 ∘ fun p : ℝ × (ℝ × ℝ) ↦
      ![p.1, p.2.1, p.2.2])
    apply (PiLp.continuous_toLp 2 (fun _ : Fin 3 ↦ ℝ)).comp
    apply continuous_pi
    intro j
    fin_cases j <;> fun_prop
  exact (localizedSymbol_contDiff α M m hm i ht).continuous.comp hcoordinates

theorem localizedSymbolRaw_eq_zero_of_coordinate_large
    (α : Anisotropy) (m : E3 → ℂ) (i j : Fin 3) (t x y z : ℝ)
    (hj : 3 ≤ |![x, y, z] j|) :
    localizedSymbolRaw α m i t x y z = 0 := by
  rw [localizedSymbolRaw_apply]
  apply localizedSymbol_eq_zero_of_coordinate_large α m i j t
  simpa only [frequencyAssemble3_apply] using hj

theorem localizedSymbolRaw_zero_first_neg
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t y z : ℝ) :
    localizedSymbolRaw α m i t (-4) y z = 0 := by
  apply localizedSymbolRaw_eq_zero_of_coordinate_large α m i 0 t
  norm_num

theorem localizedSymbolRaw_zero_first_pos
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t y z : ℝ) :
    localizedSymbolRaw α m i t 4 y z = 0 := by
  apply localizedSymbolRaw_eq_zero_of_coordinate_large α m i 0 t
  norm_num

theorem localizedSymbolRaw_zero_second_neg
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t x z : ℝ) :
    localizedSymbolRaw α m i t x (-4) z = 0 := by
  apply localizedSymbolRaw_eq_zero_of_coordinate_large α m i 1 t
  norm_num

theorem localizedSymbolRaw_zero_second_pos
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t x z : ℝ) :
    localizedSymbolRaw α m i t x 4 z = 0 := by
  apply localizedSymbolRaw_eq_zero_of_coordinate_large α m i 1 t
  norm_num

theorem localizedSymbolRaw_zero_third_neg
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t x y : ℝ) :
    localizedSymbolRaw α m i t x y (-4) = 0 := by
  apply localizedSymbolRaw_eq_zero_of_coordinate_large α m i 2 t
  change 3 ≤ |(-4 : ℝ)|
  norm_num

theorem localizedSymbolRaw_zero_third_pos
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t x y : ℝ) :
    localizedSymbolRaw α m i t x y 4 = 0 := by
  apply localizedSymbolRaw_eq_zero_of_coordinate_large α m i 2 t
  change 3 ≤ |(4 : ℝ)|
  norm_num

/-- The first coordinate of the compactly supported localized symbol lifted
to the period-eight circle. -/
noncomputable def periodizedLocalizedFirst
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) :
    PeriodEightCircle → ℝ → ℝ → ℂ :=
  fun q y z ↦ periodEightLift
    (fun x (yz : ℝ × ℝ) ↦ localizedSymbolRaw α m i t x yz.1 yz.2)
    q (y, z)

theorem continuous_periodizedLocalizedFirst
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t) :
    Continuous (fun p : PeriodEightCircle × (ℝ × ℝ) ↦
      periodizedLocalizedFirst α m i t p.1 p.2.1 p.2.2) := by
  simpa only [periodizedLocalizedFirst] using
    (continuous_periodEightLift
      (fun x (yz : ℝ × ℝ) ↦ localizedSymbolRaw α m i t x yz.1 yz.2)
      (by
        intro yz
        rw [localizedSymbolRaw_zero_first_neg,
          localizedSymbolRaw_zero_first_pos])
      (continuous_localizedSymbolRaw α M m hm i ht))

theorem periodizedLocalizedFirst_zero_second_neg
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    (q : PeriodEightCircle) (z : ℝ) :
    periodizedLocalizedFirst α m i t q (-4) z = 0 := by
  unfold periodizedLocalizedFirst
  apply periodEightLift_eq_zero
  intro x
  exact localizedSymbolRaw_zero_second_neg α m i t x z

theorem periodizedLocalizedFirst_zero_second_pos
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    (q : PeriodEightCircle) (z : ℝ) :
    periodizedLocalizedFirst α m i t q 4 z = 0 := by
  unfold periodizedLocalizedFirst
  apply periodEightLift_eq_zero
  intro x
  exact localizedSymbolRaw_zero_second_pos α m i t x z

theorem periodizedLocalizedFirst_zero_third_neg
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    (q : PeriodEightCircle) (y : ℝ) :
    periodizedLocalizedFirst α m i t q y (-4) = 0 := by
  unfold periodizedLocalizedFirst
  apply periodEightLift_eq_zero
  intro x
  exact localizedSymbolRaw_zero_third_neg α m i t x y

theorem periodizedLocalizedFirst_zero_third_pos
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    (q : PeriodEightCircle) (y : ℝ) :
    periodizedLocalizedFirst α m i t q y 4 = 0 := by
  unfold periodizedLocalizedFirst
  apply periodEightLift_eq_zero
  intro x
  exact localizedSymbolRaw_zero_third_pos α m i t x y

theorem periodizedLocalizedFirst_coe
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) {x : ℝ}
    (hx : x ∈ Set.Ico (-4 : ℝ) 4) (y z : ℝ) :
    periodizedLocalizedFirst α m i t (x : PeriodEightCircle) y z =
      localizedSymbolRaw α m i t x y z := by
  unfold periodizedLocalizedFirst
  exact periodEightLift_coe
    (fun x (yz : ℝ × ℝ) ↦ localizedSymbolRaw α m i t x yz.1 yz.2)
    hx (y, z)

/-- The first two coordinates of the localized symbol lifted to period-eight
circles, ordered as `(y, x)`. -/
noncomputable def periodizedLocalizedSecond
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) :
    PeriodEightCircle → PeriodEightCircle → ℝ → ℂ :=
  fun qy qx z ↦ periodEightLift
    (fun y (qxz : PeriodEightCircle × ℝ) ↦
      periodizedLocalizedFirst α m i t qxz.1 y qxz.2)
    qy (qx, z)

theorem continuous_periodizedLocalizedSecond
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t) :
    Continuous (fun p : PeriodEightCircle × (PeriodEightCircle × ℝ) ↦
      periodizedLocalizedSecond α m i t p.1 p.2.1 p.2.2) := by
  have hfirst : Continuous (fun p : PeriodEightCircle × (ℝ × ℝ) ↦
      periodizedLocalizedFirst α m i t p.1 p.2.1 p.2.2) :=
    continuous_periodizedLocalizedFirst α M m hm i ht
  have hreordered : Continuous (fun p : ℝ × (PeriodEightCircle × ℝ) ↦
      periodizedLocalizedFirst α m i t p.2.1 p.1 p.2.2) := by
    exact hfirst.comp
      (continuous_snd.fst.prodMk (continuous_fst.prodMk continuous_snd.snd))
  simpa only [periodizedLocalizedSecond] using
    (continuous_periodEightLift
      (fun y (qxz : PeriodEightCircle × ℝ) ↦
        periodizedLocalizedFirst α m i t qxz.1 y qxz.2)
      (by
        intro qxz
        rw [periodizedLocalizedFirst_zero_second_neg,
          periodizedLocalizedFirst_zero_second_pos])
      hreordered)

theorem periodizedLocalizedSecond_zero_third_neg
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    (qy qx : PeriodEightCircle) :
    periodizedLocalizedSecond α m i t qy qx (-4) = 0 := by
  unfold periodizedLocalizedSecond
  apply periodEightLift_eq_zero
  intro y
  exact periodizedLocalizedFirst_zero_third_neg α m i t qx y

theorem periodizedLocalizedSecond_zero_third_pos
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    (qy qx : PeriodEightCircle) :
    periodizedLocalizedSecond α m i t qy qx 4 = 0 := by
  unfold periodizedLocalizedSecond
  apply periodEightLift_eq_zero
  intro y
  exact periodizedLocalizedFirst_zero_third_pos α m i t qx y

theorem periodizedLocalizedSecond_coe
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    {x y : ℝ} (hx : x ∈ Set.Ico (-4 : ℝ) 4)
    (hy : y ∈ Set.Ico (-4 : ℝ) 4) (z : ℝ) :
    periodizedLocalizedSecond α m i t (y : PeriodEightCircle) (x : PeriodEightCircle) z =
      localizedSymbolRaw α m i t x y z := by
  unfold periodizedLocalizedSecond
  rw [periodEightLift_coe
    (fun y (qxz : PeriodEightCircle × ℝ) ↦
      periodizedLocalizedFirst α m i t qxz.1 y qxz.2) hy]
  exact periodizedLocalizedFirst_coe α m i t hx y z

/-- All three coordinates of the localized symbol lifted to period-eight
circles, ordered as `(z, y, x)`. -/
noncomputable def periodizedLocalizedThird
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) :
    PeriodEightCircle → PeriodEightCircle → PeriodEightCircle → ℂ :=
  fun qz qy qx ↦ periodEightLift
    (fun z (qyqx : PeriodEightCircle × PeriodEightCircle) ↦
      periodizedLocalizedSecond α m i t qyqx.1 qyqx.2 z)
    qz (qy, qx)

theorem continuous_periodizedLocalizedThird
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t) :
    Continuous (fun p : PeriodEightCircle × (PeriodEightCircle × PeriodEightCircle) ↦
      periodizedLocalizedThird α m i t p.1 p.2.1 p.2.2) := by
  have hsecond : Continuous (fun p : PeriodEightCircle × (PeriodEightCircle × ℝ) ↦
      periodizedLocalizedSecond α m i t p.1 p.2.1 p.2.2) :=
    continuous_periodizedLocalizedSecond α M m hm i ht
  have hreordered : Continuous (fun p : ℝ × (PeriodEightCircle × PeriodEightCircle) ↦
      periodizedLocalizedSecond α m i t p.2.1 p.2.2 p.1) := by
    let reorder : ℝ × (PeriodEightCircle × PeriodEightCircle) →
        PeriodEightCircle × (PeriodEightCircle × ℝ) :=
      fun p ↦ (p.2.1, (p.2.2, p.1))
    have horder : Continuous reorder := by
      exact (continuous_snd.fst).prodMk
        ((continuous_snd.snd).prodMk continuous_fst)
    change Continuous
      ((fun q : PeriodEightCircle × (PeriodEightCircle × ℝ) ↦
        periodizedLocalizedSecond α m i t q.1 q.2.1 q.2.2) ∘ reorder)
    exact hsecond.comp horder
  change Continuous (fun p : PeriodEightCircle × (PeriodEightCircle × PeriodEightCircle) ↦
    periodEightLift
      (fun z (qyqx : PeriodEightCircle × PeriodEightCircle) ↦
        periodizedLocalizedSecond α m i t qyqx.1 qyqx.2 z)
      p.1 (p.2.1, p.2.2))
  exact continuous_periodEightLift
    (fun z (qyqx : PeriodEightCircle × PeriodEightCircle) ↦
      periodizedLocalizedSecond α m i t qyqx.1 qyqx.2 z)
    (by
      intro qyqx
      rw [periodizedLocalizedSecond_zero_third_neg,
        periodizedLocalizedSecond_zero_third_pos])
    hreordered

theorem periodizedLocalizedThird_coe
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    {x y z : ℝ} (hx : x ∈ Set.Ico (-4 : ℝ) 4)
    (hy : y ∈ Set.Ico (-4 : ℝ) 4) (hz : z ∈ Set.Ico (-4 : ℝ) 4) :
    periodizedLocalizedThird α m i t (z : PeriodEightCircle)
      (y : PeriodEightCircle) (x : PeriodEightCircle) =
      localizedSymbolRaw α m i t x y z := by
  unfold periodizedLocalizedThird
  rw [periodEightLift_coe
    (fun z (qyqx : PeriodEightCircle × PeriodEightCircle) ↦
      periodizedLocalizedSecond α m i t qyqx.1 qyqx.2 z) hz]
  exact periodizedLocalizedSecond_coe α m i t hx hy z

/-- The period-eight extension with natural `(x, y, z)` coordinate order. -/
noncomputable def periodizedLocalizedSymbol
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) :
    PeriodEightCircle × (PeriodEightCircle × PeriodEightCircle) → ℂ :=
  fun p ↦ periodizedLocalizedThird α m i t p.2.2 p.2.1 p.1

theorem continuous_periodizedLocalizedSymbol
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t) :
    Continuous (periodizedLocalizedSymbol α m i t) := by
  have hthird : Continuous (fun p : PeriodEightCircle ×
      (PeriodEightCircle × PeriodEightCircle) ↦
      periodizedLocalizedThird α m i t p.1 p.2.1 p.2.2) :=
    continuous_periodizedLocalizedThird α M m hm i ht
  let reorder : PeriodEightCircle × (PeriodEightCircle × PeriodEightCircle) →
      PeriodEightCircle × (PeriodEightCircle × PeriodEightCircle) :=
    fun p ↦ (p.2.2, (p.2.1, p.1))
  have horder : Continuous reorder := by
    exact (continuous_snd.snd).prodMk
      ((continuous_snd.fst).prodMk continuous_fst)
  change Continuous
    ((fun q : PeriodEightCircle × (PeriodEightCircle × PeriodEightCircle) ↦
      periodizedLocalizedThird α m i t q.1 q.2.1 q.2.2) ∘ reorder)
  exact hthird.comp horder

theorem periodizedLocalizedSymbol_coe
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    {x y z : ℝ} (hx : x ∈ Set.Ico (-4 : ℝ) 4)
    (hy : y ∈ Set.Ico (-4 : ℝ) 4) (hz : z ∈ Set.Ico (-4 : ℝ) 4) :
    periodizedLocalizedSymbol α m i t
      ((x : PeriodEightCircle), ((y : PeriodEightCircle), (z : PeriodEightCircle))) =
      localizedSymbolRaw α m i t x y z := by
  unfold periodizedLocalizedSymbol
  exact periodizedLocalizedThird_coe α m i t hx hy hz

/-- Rescale the unit additive circle to the period-eight circle. -/
noncomputable def unitToPeriodEightCircle : UnitAddCircle ≃ₜ PeriodEightCircle :=
  (AddCircle.homeomorphAddCircle (8 : ℝ) 1 (by norm_num) (by norm_num)).symm

theorem unitToPeriodEightCircle_coe_div (x : ℝ) :
    unitToPeriodEightCircle ((x / 8 : ℝ) : UnitAddCircle) =
      (x : PeriodEightCircle) := by
  change (AddCircle.homeomorphAddCircle (8 : ℝ) 1 (by norm_num) (by norm_num)).symm
    ((x / 8 : ℝ) : UnitAddCircle) = (x : PeriodEightCircle)
  rw [AddCircle.homeomorphAddCircle_symm_apply_mk]
  norm_num

/-- The period-eight localized symbol as a continuous function on the
standard unit additive three-torus. -/
noncomputable def unitTorusLocalizedSymbol
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) :
    UnitAddTorus (Fin 3) → ℂ :=
  fun u ↦ periodizedLocalizedSymbol α m i t
    (unitToPeriodEightCircle (u 0),
      (unitToPeriodEightCircle (u 1), unitToPeriodEightCircle (u 2)))

theorem continuous_unitTorusLocalizedSymbol
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t) :
    Continuous (unitTorusLocalizedSymbol α m i t) := by
  have hperiod : Continuous (periodizedLocalizedSymbol α m i t) :=
    continuous_periodizedLocalizedSymbol α M m hm i ht
  have h0 : Continuous (fun u : UnitAddTorus (Fin 3) ↦
      unitToPeriodEightCircle (u 0)) :=
    unitToPeriodEightCircle.continuous.comp (continuous_apply 0)
  have h1 : Continuous (fun u : UnitAddTorus (Fin 3) ↦
      unitToPeriodEightCircle (u 1)) :=
    unitToPeriodEightCircle.continuous.comp (continuous_apply 1)
  have h2 : Continuous (fun u : UnitAddTorus (Fin 3) ↦
      unitToPeriodEightCircle (u 2)) :=
    unitToPeriodEightCircle.continuous.comp (continuous_apply 2)
  let coordinates : UnitAddTorus (Fin 3) →
      PeriodEightCircle × (PeriodEightCircle × PeriodEightCircle) :=
    fun u ↦ (unitToPeriodEightCircle (u 0),
      (unitToPeriodEightCircle (u 1), unitToPeriodEightCircle (u 2)))
  have hcoordinates : Continuous coordinates := h0.prodMk (h1.prodMk h2)
  change Continuous (periodizedLocalizedSymbol α m i t ∘ coordinates)
  exact hperiod.comp hcoordinates

noncomputable def unitTorusPoint (x y z : ℝ) : UnitAddTorus (Fin 3) :=
  fun j ↦ ((![x / 8, y / 8, z / 8] j : ℝ) : UnitAddCircle)

theorem unitTorusLocalizedSymbol_coe_div
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    {x y z : ℝ} (hx : x ∈ Set.Ico (-4 : ℝ) 4)
    (hy : y ∈ Set.Ico (-4 : ℝ) 4) (hz : z ∈ Set.Ico (-4 : ℝ) 4) :
    unitTorusLocalizedSymbol α m i t (unitTorusPoint x y z) =
      localizedSymbolRaw α m i t x y z := by
  have hx' : unitToPeriodEightCircle (unitTorusPoint x y z 0) =
      (x : PeriodEightCircle) := by
    change unitToPeriodEightCircle ((x / 8 : ℝ) : UnitAddCircle) =
      (x : PeriodEightCircle)
    exact unitToPeriodEightCircle_coe_div x
  have hy' : unitToPeriodEightCircle (unitTorusPoint x y z 1) =
      (y : PeriodEightCircle) := by
    change unitToPeriodEightCircle ((y / 8 : ℝ) : UnitAddCircle) =
      (y : PeriodEightCircle)
    exact unitToPeriodEightCircle_coe_div y
  have hz' : unitToPeriodEightCircle (unitTorusPoint x y z 2) =
      (z : PeriodEightCircle) := by
    change unitToPeriodEightCircle ((z / 8 : ℝ) : UnitAddCircle) =
      (z : PeriodEightCircle)
    exact unitToPeriodEightCircle_coe_div z
  change periodizedLocalizedSymbol α m i t
    (unitToPeriodEightCircle (unitTorusPoint x y z 0),
      (unitToPeriodEightCircle (unitTorusPoint x y z 1),
        unitToPeriodEightCircle (unitTorusPoint x y z 2))) = _
  rw [hx', hy', hz']
  exact periodizedLocalizedSymbol_coe α m i t hx hy hz

/-! ## Fourier multipliers of the literal mode kernels

This scratch isolates the physical-to-frequency calculation behind the
Fourier-mode step in the cone decomposition.  In particular, the real model
kernels are first complexified and then identified with translated
convolutions, so the signs are exposed rather than absorbed into a
coefficient. -/

/-- Fourier transform of the real spatial low-frequency cutoff after its
canonical complexification. -/
theorem fourier_conePhiPhysicalReal :
    (𝓕 fun x : ℝ ↦ (conePhiPhysicalReal x : ℂ)) =
      fun ξ : ℝ ↦ (conePhi ξ : ℂ) := by
  have hfun : (fun x : ℝ ↦ (conePhiPhysicalReal x : ℂ)) =
      (conePhiPhysical : ℝ → ℂ) := by
    funext x
    exact conePhiPhysical_eq_ofReal x
  rw [hfun, ← SchwartzMap.fourier_coe, schwartzFourier_conePhiPhysical]
  rfl

/-- Fourier transform of the real spatial annular cutoff after its canonical
complexification. -/
theorem fourier_conePsiPhysicalReal :
    (𝓕 fun x : ℝ ↦ (conePsiPhysicalReal x : ℂ)) =
      fun ξ : ℝ ↦ (conePsi ξ : ℂ) := by
  have hfun : (fun x : ℝ ↦ (conePsiPhysicalReal x : ℂ)) =
      (conePsiPhysical : ℝ → ℂ) := by
    funext x
    exact conePsiPhysical_eq_ofReal x
  rw [hfun, ← SchwartzMap.fourier_coe, schwartzFourier_conePsiPhysical]
  rfl

/-- Translation on the physical side gives the expected Fourier character.
This version intentionally has no integrability hypothesis: the change of
variables is valid for the totalized Lebesgue integral as well. -/
theorem fourier_translate_sub
    (f : ℝ → ℂ) (a : ℝ) :
    (𝓕 fun x : ℝ ↦ f (x - a)) =
      fun ξ : ℝ ↦ (Real.fourierChar (-(a * ξ)) : ℂ) * (𝓕 f) ξ := by
  change VectorFourier.fourierIntegral Real.fourierChar volume (innerₗ ℝ)
      (fun x : ℝ ↦ f (x - a)) =
    fun ξ : ℝ ↦ (Real.fourierChar (-(a * ξ)) : ℂ) *
      VectorFourier.fourierIntegral Real.fourierChar volume (innerₗ ℝ) f ξ
  have hcomp : f ∘ (fun v : ℝ ↦ v + -a) = fun x : ℝ ↦ f (x - a) := by
    funext x
    rfl
  have htranslate := VectorFourier.fourierIntegral_comp_add_right
    Real.fourierChar volume (innerₗ ℝ) f (-a)
  rw [hcomp] at htranslate
  simpa only [Function.comp_apply, sub_eq_add_neg, innerₗ_apply_apply, Real.inner_apply,
    Circle.smul_def, smul_eq_mul, neg_mul] using
    htranslate

/-- A positive mass-normalized physical dilation evaluates the Fourier
multiplier at the correspondingly dilated frequency. -/
theorem fourier_kernelDilate
    (f : ℝ → ℂ) (s : ℝ) (hs : 0 < s) :
    (𝓕 fun x : ℝ ↦ kernelDilate f s x) =
      fun ξ : ℝ ↦ (𝓕 f) (s * ξ) := by
  funext ξ
  let G : ℝ → ℂ := fun y ↦
    (Real.fourierChar (-(y * (s * ξ))) : ℂ) * f y
  have hkernel (x : ℝ) :
      kernelDilate f s x = (s⁻¹ : ℂ) * f (x / s) := by
    simp [kernelDilate]
  have hphase (x : ℝ) :
      (Real.fourierChar (-(x * ξ)) : ℂ) *
        ((s⁻¹ : ℂ) * f (x / s)) =
      (s⁻¹ : ℂ) * G (x / s) := by
    dsimp [G]
    have hs0 : s ≠ 0 := hs.ne'
    rw [show -((x / s) * (s * ξ)) = -(x * ξ) by field_simp]
    ring
  have hchange :
      (∫ x : ℝ, (Real.fourierChar (-(x * ξ)) : ℂ) *
        ((s⁻¹ : ℂ) * f (x / s))) = ∫ y : ℝ, G y := by
    calc
      (∫ x : ℝ, (Real.fourierChar (-(x * ξ)) : ℂ) *
          ((s⁻¹ : ℂ) * f (x / s))) =
          ∫ x : ℝ, (s⁻¹ : ℂ) * G (x / s) := by
            apply integral_congr_ae
            filter_upwards [] with x
            exact hphase x
      _ = (s⁻¹ : ℂ) * ∫ x : ℝ, G (x / s) := by
            rw [integral_const_mul]
      _ = (s⁻¹ : ℂ) * (|s| • ∫ y : ℝ, G y) := by
            rw [Measure.integral_comp_div]
      _ = ∫ y : ℝ, G y := by
            rw [abs_of_pos hs]
            rw [Complex.real_smul]
            field_simp [Complex.ofReal_ne_zero.mpr hs.ne']
  rw [Real.fourier_real_eq]
  change (∫ x : ℝ, (Real.fourierChar (-(x * ξ)) : ℂ) *
    kernelDilate f s x) = _
  rw [show (fun x : ℝ ↦
      (Real.fourierChar (-(x * ξ)) : ℂ) * kernelDilate f s x) =
        fun x ↦ (Real.fourierChar (-(x * ξ)) : ℂ) *
          ((s⁻¹ : ℂ) * f (x / s)) by
            funext x
            rw [hkernel]]
  rw [hchange]
  have hGfourier : (∫ y : ℝ, G y) = (𝓕 f) (s * ξ) := by
    rw [Real.fourier_real_eq]
    change (∫ y : ℝ, G y) =
      ∫ y : ℝ, (Real.fourierChar (-(y * (s * ξ))) : ℂ) * f y
    apply integral_congr_ae
    filter_upwards [] with y
    rfl
  exact hGfourier

/-- The complexification of the low model kernel is the convolution of the
Gaussian with the physical low cutoff, translated by `u`. -/
theorem complex_ModelLowKernel_eq_convolution_translate
    (u w : ℝ) :
    (ModelLowKernel u w : ℂ) =
      ((fun z : ℝ ↦ (gaussian z : ℂ))
        ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (fun z : ℝ ↦ (conePhiPhysicalReal z : ℂ))) (w - u) := by
  rw [convolution_mul]
  unfold ModelLowKernel
  rw [← integral_complex_ofReal]
  apply integral_congr_ae
  filter_upwards [] with z
  push_cast
  congr 1
  ring_nf

/-- Exact Fourier multiplier of the translated low model kernel.  At a
negative frequency this will become the positive Fourier-series phase from
the source mode calculation. -/
theorem fourier_ModelLowKernel (u : ℝ) :
    (𝓕 fun w : ℝ ↦ (ModelLowKernel u w : ℂ)) =
      fun ξ : ℝ ↦ (Real.fourierChar (-(u * ξ)) : ℂ) *
        ((gaussian ξ : ℂ) * (conePhi ξ : ℂ)) := by
  let G : ℝ → ℂ := fun z ↦ (gaussian z : ℂ)
  let P : ℝ → ℂ := fun z ↦ (conePhiPhysicalReal z : ℂ)
  let K : ℝ → ℂ := G ⋆[ContinuousLinearMap.mul ℂ ℂ] P
  have hG : Integrable G := by
    change Integrable (fun z : ℝ ↦ Complex.ofReal (gaussian z))
    exact integrable_gaussian.ofReal
  have hP : Integrable P := by
    change Integrable (fun z : ℝ ↦ Complex.ofReal (conePhiPhysicalReal z))
    exact conePhiPhysicalReal.integrable.ofReal
  have hGfourier : (𝓕 G) = fun ξ : ℝ ↦ (gaussian ξ : ℂ) := by
    simpa only [G] using fourier_gaussian
  have hPfourier : (𝓕 P) = fun ξ : ℝ ↦ (conePhi ξ : ℂ) := by
    simpa only [P] using fourier_conePhiPhysicalReal
  have hkernel : (fun w : ℝ ↦ (ModelLowKernel u w : ℂ)) =
      fun w ↦ K (w - u) := by
    funext w
    dsimp only [K, G, P]
    exact complex_ModelLowKernel_eq_convolution_translate u w
  calc
    (𝓕 fun w : ℝ ↦ (ModelLowKernel u w : ℂ)) =
        𝓕 (fun w : ℝ ↦ K (w - u)) := by rw [hkernel]
    _ = fun ξ : ℝ ↦ (Real.fourierChar (-(u * ξ)) : ℂ) * (𝓕 K) ξ :=
      fourier_translate_sub K u
    _ = fun ξ : ℝ ↦ (Real.fourierChar (-(u * ξ)) : ℂ) *
        ((𝓕 G) ξ * (𝓕 P) ξ) := by
      funext ξ
      rw [show K = G ⋆[ContinuousLinearMap.mul ℂ ℂ] P by rfl,
        Real.fourier_mul_convolution_eq hG hP]
    _ = fun ξ : ℝ ↦ (Real.fourierChar (-(u * ξ)) : ℂ) *
        ((gaussian ξ : ℂ) * (conePhi ξ : ℂ)) := by
      rw [hGfourier, hPfourier]

/-- Evaluating the low model multiplier at `-η` produces exactly the positive
mode phase used in the localized Fourier series. -/
theorem fourier_ModelLowKernel_neg (u η : ℝ) :
    (𝓕 fun w : ℝ ↦ (ModelLowKernel u w : ℂ)) (-η) =
      (gaussian η : ℂ) * (conePhi η : ℂ) *
        (Real.fourierChar (u * η) : ℂ) := by
  rw [fourier_ModelLowKernel]
  change (Real.fourierChar (-(u * (-η)) : ℝ) : ℂ) *
      ((gaussian (-η) : ℂ) * (conePhi (-η) : ℂ)) = _
  rw [show -(u * -η) = u * η by ring, gaussian_even, conePhi_even]
  ring

/-- Complexification commutes pointwise with the scalar convolution used by
the real model kernels. -/
theorem ofReal_convolution
    (f g : ℝ → ℝ) (w : ℝ) :
    ((f ⋆[ContinuousLinearMap.mul ℝ ℝ] g) w : ℂ) =
      ((fun z : ℝ ↦ (f z : ℂ))
        ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (fun z : ℝ ↦ (g z : ℂ))) w := by
  rw [convolution_mul, convolution_mul, ← integral_complex_ofReal]
  apply integral_congr_ae
  filter_upwards [] with z
  push_cast
  rfl

/-- The complexification of the third model kernel is the translated double
Gaussian-derivative/annular convolution. -/
theorem complex_ModelThirdKernel_eq_convolution_translate
    (u w : ℝ) :
    (ModelThirdKernel u w : ℂ) =
      ((fun z : ℝ ↦ (gaussianDeriv z : ℂ))
        ⋆[ContinuousLinearMap.mul ℂ ℂ]
        ((fun z : ℝ ↦ (gaussianDeriv z : ℂ))
          ⋆[ContinuousLinearMap.mul ℂ ℂ]
          (fun z : ℝ ↦ (conePsiPhysicalReal z : ℂ)))) (w - u) := by
  rw [ModelThirdKernel_eq_convolution_translate]
  rw [ofReal_convolution]
  congr 1
  funext z
  exact ofReal_convolution gaussianDeriv conePsiPhysicalReal z

/-- Exact Fourier multiplier of the translated third model kernel.  The minus
sign is the product of the two `-I` Gaussian-derivative multipliers. -/
theorem fourier_ModelThirdKernel (u : ℝ) :
    (𝓕 fun w : ℝ ↦ (ModelThirdKernel u w : ℂ)) =
      fun ξ : ℝ ↦ (Real.fourierChar (-(u * ξ)) : ℂ) *
        (-((gaussianDeriv ξ : ℂ) ^ 2 * (conePsi ξ : ℂ))) := by
  let H : ℝ → ℂ := fun z ↦ (gaussianDeriv z : ℂ)
  let P : ℝ → ℂ := fun z ↦ (conePsiPhysicalReal z : ℂ)
  let J : ℝ → ℂ := H ⋆[ContinuousLinearMap.mul ℂ ℂ] P
  let K : ℝ → ℂ := H ⋆[ContinuousLinearMap.mul ℂ ℂ] J
  have hH : Integrable H := by
    change Integrable (fun z : ℝ ↦ Complex.ofReal (gaussianDeriv z))
    exact integrable_gaussianDeriv.ofReal
  have hP : Integrable P := by
    change Integrable (fun z : ℝ ↦ Complex.ofReal (conePsiPhysicalReal z))
    exact conePsiPhysicalReal.integrable.ofReal
  have hJ : Integrable J := by
    change Integrable (H ⋆[ContinuousLinearMap.mul ℂ ℂ] P)
    exact hH.integrable_convolution (ContinuousLinearMap.mul ℂ ℂ) hP
  have hHfourier : (𝓕 H) = fun ξ : ℝ ↦
      -Complex.I * (gaussianDeriv ξ : ℂ) := by
    simpa only [H] using fourier_gaussianDeriv
  have hPfourier : (𝓕 P) = fun ξ : ℝ ↦ (conePsi ξ : ℂ) := by
    simpa only [P] using fourier_conePsiPhysicalReal
  have hJfourier : (𝓕 J) = fun ξ : ℝ ↦
      (-Complex.I * (gaussianDeriv ξ : ℂ)) * (conePsi ξ : ℂ) := by
    funext ξ
    rw [show J = H ⋆[ContinuousLinearMap.mul ℂ ℂ] P by rfl,
      Real.fourier_mul_convolution_eq hH hP, hHfourier, hPfourier]
  have hKfourier : (𝓕 K) = fun ξ : ℝ ↦
      -((gaussianDeriv ξ : ℂ) ^ 2 * (conePsi ξ : ℂ)) := by
    funext ξ
    rw [show K = H ⋆[ContinuousLinearMap.mul ℂ ℂ] J by rfl,
      Real.fourier_mul_convolution_eq hH hJ, hHfourier, hJfourier]
    ring_nf
    rw [Complex.I_sq]
    ring
  have hkernel : (fun w : ℝ ↦ (ModelThirdKernel u w : ℂ)) =
      fun w ↦ K (w - u) := by
    funext w
    dsimp only [K, H, J, P]
    exact complex_ModelThirdKernel_eq_convolution_translate u w
  calc
    (𝓕 fun w : ℝ ↦ (ModelThirdKernel u w : ℂ)) =
        𝓕 (fun w : ℝ ↦ K (w - u)) := by rw [hkernel]
    _ = fun ξ : ℝ ↦ (Real.fourierChar (-(u * ξ)) : ℂ) * (𝓕 K) ξ :=
      fourier_translate_sub K u
    _ = fun ξ : ℝ ↦ (Real.fourierChar (-(u * ξ)) : ℂ) *
        (-((gaussianDeriv ξ : ℂ) ^ 2 * (conePsi ξ : ℂ))) := by
      rw [hKfourier]

/-- At a negative frequency the third model multiplier has the source's
single explicit minus sign and the positive mode phase. -/
theorem fourier_ModelThirdKernel_neg (u η : ℝ) :
    (𝓕 fun w : ℝ ↦ (ModelThirdKernel u w : ℂ)) (-η) =
      (-((gaussianDeriv η : ℂ) ^ 2 * (conePsi η : ℂ))) *
        (Real.fourierChar (u * η) : ℂ) := by
  rw [fourier_ModelThirdKernel]
  change (Real.fourierChar (-(u * (-η)) : ℝ) : ℂ) *
      (-((gaussianDeriv (-η) : ℂ) ^ 2 * (conePsi (-η) : ℂ))) = _
  rw [show -(u * -η) = u * η by ring, gaussianDeriv_neg, conePsi_even]
  rw [Complex.ofReal_neg, neg_sq]
  ring

/-- The first/second-coordinate mode multiplier at the literal source
translation `ν / 8`. -/
theorem fourier_ModelLowKernel_standardMode_neg
    (ν : standardModeLattice) (j : Fin 3) (η : ℝ) :
    (𝓕 fun w : ℝ ↦ (ModelLowKernel (standardModeTranslate ν j) w : ℂ)) (-η) =
      (gaussian η : ℂ) * (conePhi η : ℂ) *
        (Real.fourierChar ((8 : ℝ)⁻¹ * (ν : E3) j * η) : ℂ) := by
  simpa only [standardModeTranslate_apply] using
    fourier_ModelLowKernel_neg (standardModeTranslate ν j) η

/-- The active-coordinate mode multiplier at the literal source translation
`ν / 8`, including the single sign absorbed by the Fourier coefficient in
the cone decomposition. -/
theorem fourier_ModelThirdKernel_standardMode_neg
    (ν : standardModeLattice) (j : Fin 3) (η : ℝ) :
    (𝓕 fun w : ℝ ↦ (ModelThirdKernel (standardModeTranslate ν j) w : ℂ)) (-η) =
      (-((gaussianDeriv η : ℂ) ^ 2 * (conePsi η : ℂ))) *
        (Real.fourierChar ((8 : ℝ)⁻¹ * (ν : E3) j * η) : ℂ) := by
  simpa only [standardModeTranslate_apply] using
    fourier_ModelThirdKernel_neg (standardModeTranslate ν j) η

/-- The low model kernel at a positive model scale has precisely the scaled
low-cone multiplier and mode phase. -/
theorem fourier_kernelDilate_ModelLowKernel_neg
    (u s η : ℝ) (hs : 0 < s) :
    (𝓕 fun w : ℝ ↦ ((kernelDilate (ModelLowKernel u) s w : ℝ) : ℂ)) (-η) =
      (gaussian (s * η) : ℂ) * (conePhi (s * η) : ℂ) *
        (Real.fourierChar (u * (s * η)) : ℂ) := by
  have hdilate : (fun w : ℝ ↦
      ((kernelDilate (ModelLowKernel u) s w : ℝ) : ℂ)) =
      fun w ↦ kernelDilate (fun r : ℝ ↦ (ModelLowKernel u r : ℂ)) s w := by
    funext w
    simp [kernelDilate]
  rw [hdilate, fourier_kernelDilate _ s hs]
  change (𝓕 fun r : ℝ ↦ (ModelLowKernel u r : ℂ)) (s * (-η)) = _
  rw [show s * -η = -(s * η) by ring]
  exact fourier_ModelLowKernel_neg u (s * η)

/-- The active third model kernel at a positive scale has the scaled annular
multiplier, the positive mode phase, and exactly one minus sign. -/
theorem fourier_kernelDilate_ModelThirdKernel_neg
    (u s η : ℝ) (hs : 0 < s) :
    (𝓕 fun w : ℝ ↦ ((kernelDilate (ModelThirdKernel u) s w : ℝ) : ℂ)) (-η) =
      (-((gaussianDeriv (s * η) : ℂ) ^ 2 * (conePsi (s * η) : ℂ))) *
        (Real.fourierChar (u * (s * η)) : ℂ) := by
  have hdilate : (fun w : ℝ ↦
      ((kernelDilate (ModelThirdKernel u) s w : ℝ) : ℂ)) =
      fun w ↦ kernelDilate (fun r : ℝ ↦ (ModelThirdKernel u r : ℂ)) s w := by
    funext w
    simp [kernelDilate]
  rw [hdilate, fourier_kernelDilate _ s hs]
  change (𝓕 fun r : ℝ ↦ (ModelThirdKernel u r : ℂ)) (s * (-η)) = _
  rw [show s * -η = -(s * η) by ring]
  exact fourier_ModelThirdKernel_neg u (s * η)

/-- The scaled first/second-coordinate multiplier at the literal source
translation `ν / 8`. -/
theorem fourier_kernelDilate_ModelLowKernel_standardMode_neg
    (ν : standardModeLattice) (j : Fin 3) (s η : ℝ) (hs : 0 < s) :
    (𝓕 fun w : ℝ ↦
      ((kernelDilate (ModelLowKernel (standardModeTranslate ν j)) s w : ℝ) : ℂ)) (-η) =
      (gaussian (s * η) : ℂ) * (conePhi (s * η) : ℂ) *
        (Real.fourierChar ((8 : ℝ)⁻¹ * (ν : E3) j * (s * η)) : ℂ) := by
  simpa only [standardModeTranslate_apply] using
    fourier_kernelDilate_ModelLowKernel_neg
      (standardModeTranslate ν j) s η hs

/-- The scaled active-coordinate multiplier at the literal source translation
`ν / 8`, with its coefficient-absorbed Fourier sign visible. -/
theorem fourier_kernelDilate_ModelThirdKernel_standardMode_neg
    (ν : standardModeLattice) (j : Fin 3) (s η : ℝ) (hs : 0 < s) :
    (𝓕 fun w : ℝ ↦
      ((kernelDilate (ModelThirdKernel (standardModeTranslate ν j)) s w : ℝ) : ℂ)) (-η) =
      (-((gaussianDeriv (s * η) : ℂ) ^ 2 * (conePsi (s * η) : ℂ))) *
        (Real.fourierChar ((8 : ℝ)⁻¹ * (ν : E3) j * (s * η)) : ℂ) := by
  simpa only [standardModeTranslate_apply] using
    fourier_kernelDilate_ModelThirdKernel_neg
      (standardModeTranslate ν j) s η hs

/-- The product of the three scalar Fourier phases is the character of their
sum, in the exact convention used by the source Fourier series. -/
theorem fourierChar_three (a b c : ℝ) :
    (Real.fourierChar a : ℂ) * (Real.fourierChar b : ℂ) *
      (Real.fourierChar c : ℂ) =
        (Real.fourierChar (a + b + c) : ℂ) := by
  calc
    (Real.fourierChar a : ℂ) * (Real.fourierChar b : ℂ) *
        (Real.fourierChar c : ℂ) =
        (Real.fourierChar (a + b) : ℂ) * (Real.fourierChar c : ℂ) := by
          simp only [Real.fourierChar.map_add_eq_mul, Circle.coe_mul]
    _ = (Real.fourierChar (a + b + c) : ℂ) := by
      simp only [Real.fourierChar.map_add_eq_mul, Circle.coe_mul]

/-- The literal product multiplier for the third active coordinate.  This is
the frequency-side model kernel at arbitrary positive coordinate scales,
before specializing `s_j = t^{α_j}` and `u = ν / 8`. -/
theorem fourier_ModelKernelProduct_third_neg
    (u s η : E3) (hs : ∀ j : Fin 3, 0 < s j) :
    (𝓕 fun w : ℝ ↦
      ((kernelDilate (ModelLowKernel (u 0)) (s 0) w : ℝ) : ℂ)) (-(η 0)) *
      (𝓕 fun w : ℝ ↦
        ((kernelDilate (ModelLowKernel (u 1)) (s 1) w : ℝ) : ℂ)) (-(η 1)) *
      (𝓕 fun w : ℝ ↦
        ((kernelDilate (ModelThirdKernel (u 2)) (s 2) w : ℝ) : ℂ)) (-(η 2)) =
      -(((gaussian (s 0 * η 0) : ℂ) * (conePhi (s 0 * η 0) : ℂ)) *
          ((gaussian (s 1 * η 1) : ℂ) * (conePhi (s 1 * η 1) : ℂ)) *
          ((gaussianDeriv (s 2 * η 2) : ℂ) ^ 2 *
            (conePsi (s 2 * η 2) : ℂ))) *
        (Real.fourierChar
          (u 0 * (s 0 * η 0) + u 1 * (s 1 * η 1) + u 2 * (s 2 * η 2)) : ℂ) := by
  have h0 := fourier_kernelDilate_ModelLowKernel_neg
    (u 0) (s 0) (η 0) (hs 0)
  have h1 := fourier_kernelDilate_ModelLowKernel_neg
    (u 1) (s 1) (η 1) (hs 1)
  have h2 := fourier_kernelDilate_ModelThirdKernel_neg
    (u 2) (s 2) (η 2) (hs 2)
  rw [h0, h1, h2]
  rw [← fourierChar_three]
  ring

/-- The literal three-coordinate mode product at the source translation
`ν / 8`.  This is the exact kernel-multiplier/sign calculation needed before
the localized-symbol Fourier coefficients are inserted. -/
theorem fourier_ModelKernelProduct_third_standardMode_neg
    (ν : standardModeLattice) (s η : E3) (hs : ∀ j : Fin 3, 0 < s j) :
    (𝓕 fun w : ℝ ↦
      ((kernelDilate (ModelLowKernel (standardModeTranslate ν 0)) (s 0) w : ℝ) : ℂ))
        (-(η 0)) *
      (𝓕 fun w : ℝ ↦
        ((kernelDilate (ModelLowKernel (standardModeTranslate ν 1)) (s 1) w : ℝ) : ℂ))
        (-(η 1)) *
      (𝓕 fun w : ℝ ↦
        ((kernelDilate (ModelThirdKernel (standardModeTranslate ν 2)) (s 2) w : ℝ) : ℂ))
        (-(η 2)) =
      -(((gaussian (s 0 * η 0) : ℂ) * (conePhi (s 0 * η 0) : ℂ)) *
          ((gaussian (s 1 * η 1) : ℂ) * (conePhi (s 1 * η 1) : ℂ)) *
          ((gaussianDeriv (s 2 * η 2) : ℂ) ^ 2 *
            (conePsi (s 2 * η 2) : ℂ))) *
        (Real.fourierChar
          ((8 : ℝ)⁻¹ * (ν : E3) 0 * (s 0 * η 0) +
            (8 : ℝ)⁻¹ * (ν : E3) 1 * (s 1 * η 1) +
            (8 : ℝ)⁻¹ * (ν : E3) 2 * (s 2 * η 2)) : ℂ) := by
  simpa only [standardModeTranslate_apply] using
    fourier_ModelKernelProduct_third_neg
      (standardModeTranslate ν) s η hs

/-- The finite-scale third-active-coordinate kernel product, evaluated at the
three diagonal frequencies in the literal `E9` formula.  The vector
`-frequencyDiagonal ζ` is precisely the source variable
`ξ_j = -ζ^{(j)}_j`; consequently the Fourier transforms on the left are
evaluated at the three input-frequency coordinates themselves. -/
theorem fourier_ModelKernelProduct_third_standardMode_frequencyDiagonal
    (ν : standardModeLattice) (s : E3) (hs : ∀ j : Fin 3, 0 < s j)
    (ζ : Frequency9) :
    (𝓕 fun w : ℝ ↦
      ((kernelDilate (ModelLowKernel (standardModeTranslate ν 0)) (s 0) w : ℝ) : ℂ))
        (frequencyDiagonal ζ 0) *
      (𝓕 fun w : ℝ ↦
        ((kernelDilate (ModelLowKernel (standardModeTranslate ν 1)) (s 1) w : ℝ) : ℂ))
        (frequencyDiagonal ζ 1) *
      (𝓕 fun w : ℝ ↦
        ((kernelDilate (ModelThirdKernel (standardModeTranslate ν 2)) (s 2) w : ℝ) : ℂ))
        (frequencyDiagonal ζ 2) =
      -(((gaussian (s 0 * (-(frequencyDiagonal ζ 0))) : ℂ) *
          (conePhi (s 0 * (-(frequencyDiagonal ζ 0))) : ℂ)) *
          ((gaussian (s 1 * (-(frequencyDiagonal ζ 1))) : ℂ) *
            (conePhi (s 1 * (-(frequencyDiagonal ζ 1))) : ℂ)) *
          ((gaussianDeriv (s 2 * (-(frequencyDiagonal ζ 2))) : ℂ) ^ 2 *
            (conePsi (s 2 * (-(frequencyDiagonal ζ 2))) : ℂ))) *
        (Real.fourierChar
          ((8 : ℝ)⁻¹ * (ν : E3) 0 * (s 0 * (-(frequencyDiagonal ζ 0))) +
            (8 : ℝ)⁻¹ * (ν : E3) 1 * (s 1 * (-(frequencyDiagonal ζ 1))) +
            (8 : ℝ)⁻¹ * (ν : E3) 2 * (s 2 * (-(frequencyDiagonal ζ 2))) : ℝ) : ℂ) := by
  simpa using fourier_ModelKernelProduct_third_standardMode_neg
    ν s (-frequencyDiagonal ζ) hs

/-- The source anisotropic vector of positive one-dimensional model scales at
time `t`.  It records the three factors `t^{α_j}` without choosing a
coordinate-dependent notation outside the ambient Euclidean carrier. -/
noncomputable def modelScaleVector (α : Anisotropy) (t : ℝ) : E3 :=
  WithLp.toLp 2 fun j ↦ t ^ α.weight j

@[simp] theorem modelScaleVector_apply
    (α : Anisotropy) (t : ℝ) (j : Fin 3) :
    modelScaleVector α t j = t ^ α.weight j := by
  simp [modelScaleVector]

/-- The literal source finite-scale, third-active-coordinate Fourier
multiplier at an `E9` frequency point.  This is the exact pointwise kernel
calculation used after inserting a Fourier mode into the `t`-scale integrand
of the frequency representation; its sole sign is the active derivative
multiplier. -/
theorem fourier_ModelKernelProduct_third_standardMode_frequencyDiagonal_scale
    (α : Anisotropy) (ν : standardModeLattice) (t : ℝ) (ht : 0 < t)
    (ζ : Frequency9) :
    (𝓕 fun w : ℝ ↦
      ((kernelDilate (ModelLowKernel (standardModeTranslate ν 0))
        (t ^ α.weight 0) w : ℝ) : ℂ)) (frequencyDiagonal ζ 0) *
      (𝓕 fun w : ℝ ↦
        ((kernelDilate (ModelLowKernel (standardModeTranslate ν 1))
          (t ^ α.weight 1) w : ℝ) : ℂ)) (frequencyDiagonal ζ 1) *
      (𝓕 fun w : ℝ ↦
        ((kernelDilate (ModelThirdKernel (standardModeTranslate ν 2))
          (t ^ α.weight 2) w : ℝ) : ℂ)) (frequencyDiagonal ζ 2) =
      -(((gaussian (t ^ α.weight 0 * (-(frequencyDiagonal ζ 0))) : ℂ) *
          (conePhi (t ^ α.weight 0 * (-(frequencyDiagonal ζ 0))) : ℂ)) *
          ((gaussian (t ^ α.weight 1 * (-(frequencyDiagonal ζ 1))) : ℂ) *
            (conePhi (t ^ α.weight 1 * (-(frequencyDiagonal ζ 1))) : ℂ)) *
          ((gaussianDeriv (t ^ α.weight 2 * (-(frequencyDiagonal ζ 2))) : ℂ) ^ 2 *
            (conePsi (t ^ α.weight 2 * (-(frequencyDiagonal ζ 2))) : ℂ))) *
        (Real.fourierChar
          ((8 : ℝ)⁻¹ * (ν : E3) 0 *
              (t ^ α.weight 0 * (-(frequencyDiagonal ζ 0))) +
            (8 : ℝ)⁻¹ * (ν : E3) 1 *
              (t ^ α.weight 1 * (-(frequencyDiagonal ζ 1))) +
            (8 : ℝ)⁻¹ * (ν : E3) 2 *
              (t ^ α.weight 2 * (-(frequencyDiagonal ζ 2))) : ℝ) : ℂ) := by
  let s : E3 := modelScaleVector α t
  have hs : ∀ j : Fin 3, 0 < s j := by
    intro j
    simp only [s, modelScaleVector_apply]
    exact pow_pos ht _
  simpa only [s, modelScaleVector_apply] using
    fourier_ModelKernelProduct_third_standardMode_frequencyDiagonal
      ν s hs ζ

/-- The Fourier-side product of the three literal spatial model kernels at a
single positive scale, written on the `E9` carrier of `frequencyForm`. -/
noncomputable def thirdModeKernelFourierProduct
    (α : Anisotropy) (ν : standardModeLattice) (t : ℝ) (ζ : Frequency9) : ℂ :=
  (𝓕 fun w : ℝ ↦
    ((kernelDilate (ModelLowKernel (standardModeTranslate ν 0))
      (t ^ α.weight 0) w : ℝ) : ℂ)) (frequencyDiagonal ζ 0) *
    (𝓕 fun w : ℝ ↦
      ((kernelDilate (ModelLowKernel (standardModeTranslate ν 1))
        (t ^ α.weight 1) w : ℝ) : ℂ)) (frequencyDiagonal ζ 1) *
    (𝓕 fun w : ℝ ↦
      ((kernelDilate (ModelThirdKernel (standardModeTranslate ν 2))
        (t ^ α.weight 2) w : ℝ) : ℂ)) (frequencyDiagonal ζ 2)

/-- The positive cone-cutoff multiplier carried by one Fourier mode in the
third active coordinate.  Its argument is the source diagonal variable
`ξ=-frequencyDiagonal ζ`, and the leading negative sign from the physical
third kernel is deliberately absent: it is absorbed by the model coefficient
in the source proof. -/
noncomputable def thirdModeFrequencySymbol
    (α : Anisotropy) (ν : standardModeLattice) (t : ℝ) (ξ : E3) : ℂ :=
  ((gaussian (t ^ α.weight 0 * ξ 0) : ℂ) *
      (conePhi (t ^ α.weight 0 * ξ 0) : ℂ)) *
    ((gaussian (t ^ α.weight 1 * ξ 1) : ℂ) *
      (conePhi (t ^ α.weight 1 * ξ 1) : ℂ)) *
    ((gaussianDeriv (t ^ α.weight 2 * ξ 2) : ℂ) ^ 2 *
      (conePsi (t ^ α.weight 2 * ξ 2) : ℂ)) *
    (Real.fourierChar
      ((8 : ℝ)⁻¹ * (ν : E3) 0 * (t ^ α.weight 0 * ξ 0) +
        (8 : ℝ)⁻¹ * (ν : E3) 1 * (t ^ α.weight 1 * ξ 1) +
        (8 : ℝ)⁻¹ * (ν : E3) 2 * (t ^ α.weight 2 * ξ 2) : ℝ) : ℂ)

/-- At an `E9` frequency point, the product of the literal third-active
spatial kernel multipliers is the negative of the corresponding localized
Fourier-mode symbol.  This is the exact sign bridge used in
`thm:cone`, lines 2998--3015. -/
theorem thirdModeKernelFourierProduct_eq_neg_frequencySymbol
    (α : Anisotropy) (ν : standardModeLattice) (t : ℝ) (ht : 0 < t)
    (ζ : Frequency9) :
    thirdModeKernelFourierProduct α ν t ζ =
      -thirdModeFrequencySymbol α ν t (-frequencyDiagonal ζ) := by
  unfold thirdModeKernelFourierProduct thirdModeFrequencySymbol
  rw [fourier_ModelKernelProduct_third_standardMode_frequencyDiagonal_scale
    α ν t ht ζ]
  simp only [PiLp.neg_apply]
  ring

/-- The finite-scale `E9` frequency integral associated with one third-active
Fourier mode.  This is intentionally expressed through the existing
`frequencyForm`, so its relationship with `multiplierForm` is available once
the localized symbol's multiplier hypotheses are supplied. -/
noncomputable def thirdModeFrequencyForm
    (α : Anisotropy) (ν : standardModeLattice) (t : ℝ)
    (F : ModelComplexSchwartzInput) : ℂ :=
  frequencyForm (thirdModeFrequencySymbol α ν t)
    (F 0) (F 1) (F 2) (F 3)

/-- The `E9` frequency form of one finite-scale third-active mode equals the
frequency integral obtained by placing the literal spatial kernel product
beside the four-input frequency kernel.  This is an exact pointwise-to-
integral bridge; no Fubini interchange is hidden in the statement. -/
theorem thirdModeFrequencyForm_eq_kernelProductIntegral
    (α : Anisotropy) (ν : standardModeLattice) (t : ℝ) (ht : 0 < t)
    (F : ModelComplexSchwartzInput) :
    thirdModeFrequencyForm α ν t F =
      ∫ ζ : Frequency9,
        (-thirdModeKernelFourierProduct α ν t ζ) *
          frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ
        ∂frequencyMeasure := by
  unfold thirdModeFrequencyForm frequencyForm
  apply integral_congr_ae
  filter_upwards [] with ζ
  rw [thirdModeKernelFourierProduct_eq_neg_frequencySymbol
    α ν t ht ζ]
  ring

/-- Conditional `multiplierForm` version of the finite-scale bridge.  The
only remaining analytic premise is the already standard multiplier condition
for the compact localized mode symbol; under it, the existing
`multiplierForm_eq_frequencyForm` theorem turns the literal multiplier form
into the exact `E9` kernel-product integral above. -/
theorem multiplierForm_thirdModeFrequencySymbol_eq_kernelProductIntegral
    (α : Anisotropy) (M : ℝ) (ν : standardModeLattice) (t : ℝ) (ht : 0 < t)
    (hm : Anisotropy.IsAnisotropicMultiplier α M
      (thirdModeFrequencySymbol α ν t))
    (F : ModelComplexSchwartzInput) :
    multiplierForm (thirdModeFrequencySymbol α ν t)
      (F 0) (F 1) (F 2) (F 3) =
      ∫ ζ : Frequency9,
        (-thirdModeKernelFourierProduct α ν t ζ) *
          frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ
        ∂frequencyMeasure := by
  calc
    multiplierForm (thirdModeFrequencySymbol α ν t)
        (F 0) (F 1) (F 2) (F 3) =
        frequencyForm (thirdModeFrequencySymbol α ν t)
          (F 0) (F 1) (F 2) (F 3) :=
      multiplierForm_eq_frequencyForm α M
        (thirdModeFrequencySymbol α ν t) hm (F 0) (F 1) (F 2) (F 3)
    _ = thirdModeFrequencyForm α ν t F := rfl
    _ = ∫ ζ : Frequency9,
        (-thirdModeKernelFourierProduct α ν t ζ) *
          frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ
        ∂frequencyMeasure :=
      thirdModeFrequencyForm_eq_kernelProductIntegral α ν t ht F

/-- The phase in the `E3` kernel integral splits into the three scalar
Fourier characters at the diagonal frequency coordinates. -/
theorem frequencyPhase_neg_coordinate_expand
    (ζ : Frequency9) (r : E3) :
    frequencyPhase (frequencyDiagonal ζ) (-r) =
      (Real.fourierChar (-(r 0 * frequencyDiagonal ζ 0)) : ℂ) *
        ((Real.fourierChar (-(r 1 * frequencyDiagonal ζ 1)) : ℂ) *
          (Real.fourierChar (-(r 2 * frequencyDiagonal ζ 2)) : ℂ)) := by
  have h0 : frequencyDiagonal ζ 0 = ζ.1.1 0 := by
    rw [frequencyDiagonal_apply]
    simp [coordinateDirection_apply]
  have h1 : frequencyDiagonal ζ 1 = ζ.1.2 1 := by
    rw [frequencyDiagonal_apply]
    simp [coordinateDirection_apply]
  have h2 : frequencyDiagonal ζ 2 = ζ.2 2 := by
    rw [frequencyDiagonal_apply]
    simp [coordinateDirection_apply]
  unfold frequencyPhase
  rw [inner_frequencyDiagonal]
  simp only [PiLp.neg_apply]
  rw [mul_neg, mul_neg, mul_neg]
  rw [← Circle.coe_mul, ← Circle.coe_mul]
  rw [← AddChar.map_add_eq_mul, ← AddChar.map_add_eq_mul]
  rw [h0, h1, h2]
  apply congrArg (fun a : ℝ ↦ (Real.fourierChar a : ℂ))
  ring

/-- Integrating a product of three one-dimensional kernels against the
negative translated-product phase gives the product of their scalar Fourier
multipliers at the three diagonal frequency coordinates.  This is the kernel
half of the spatial/Fourier Fubini bridge, with no integrability side
condition because all integrals use Lean's totalized convention. -/
theorem threeKernel_phaseIntegral_eq_fourierProduct
    (k₀ k₁ k₂ : ℝ → ℂ) (ζ : Frequency9) :
    (∫ r : E3,
      (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
        frequencyPhase (frequencyDiagonal ζ) (-r)) =
      (𝓕 k₀) (frequencyDiagonal ζ 0) *
        ((𝓕 k₁) (frequencyDiagonal ζ 1) *
          (𝓕 k₂) (frequencyDiagonal ζ 2)) := by
  let R : ℂ := (𝓕 k₀) (frequencyDiagonal ζ 0) *
    ((𝓕 k₁) (frequencyDiagonal ζ 1) *
      (𝓕 k₂) (frequencyDiagonal ζ 2))
  change (∫ r : E3,
    (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
      frequencyPhase (frequencyDiagonal ζ) (-r)) = R
  let A : ℝ → ℂ := fun r ↦
    (Real.fourierChar (-(r * frequencyDiagonal ζ 0)) : ℂ) * k₀ r
  let B : ℝ → ℂ := fun r ↦
    (Real.fourierChar (-(r * frequencyDiagonal ζ 1)) : ℂ) * k₁ r
  let C : ℝ → ℂ := fun r ↦
    (Real.fourierChar (-(r * frequencyDiagonal ζ 2)) : ℂ) * k₂ r
  let e : E3 ≃ᵐ ℝ × (ℝ × ℝ) := e3Coordinates
  have hmp : MeasurePreserving e (volume : Measure E3)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    simpa only [e] using e3Coordinates_measurePreserving
  have hA : (∫ r : ℝ, A r) = (𝓕 k₀) (frequencyDiagonal ζ 0) := by
    rw [Real.fourier_real_eq]
    change (∫ r : ℝ,
      (Real.fourierChar (-(r * frequencyDiagonal ζ 0)) : ℂ) * k₀ r) = _
    rfl
  have hB : (∫ r : ℝ, B r) = (𝓕 k₁) (frequencyDiagonal ζ 1) := by
    rw [Real.fourier_real_eq]
    change (∫ r : ℝ,
      (Real.fourierChar (-(r * frequencyDiagonal ζ 1)) : ℂ) * k₁ r) = _
    rfl
  have hC : (∫ r : ℝ, C r) = (𝓕 k₂) (frequencyDiagonal ζ 2) := by
    rw [Real.fourier_real_eq]
    change (∫ r : ℝ,
      (Real.fourierChar (-(r * frequencyDiagonal ζ 2)) : ℂ) * k₂ r) = _
    rfl
  calc
    (∫ r : E3,
      (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
        frequencyPhase (frequencyDiagonal ζ) (-r)) =
        ∫ z : ℝ × (ℝ × ℝ),
          ((k₀ ((e.symm z) 0) * k₁ ((e.symm z) 1)) * k₂ ((e.symm z) 2) *
            frequencyPhase (frequencyDiagonal ζ) (-(e.symm z)))
          ∂((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
            exact (MeasurePreserving.symm e hmp).integral_comp
              e.symm.measurableEmbedding _ |>.symm
    _ = ∫ z : ℝ × (ℝ × ℝ), A z.1 * (B z.2.1 * C z.2.2)
          ∂((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
            apply integral_congr_ae
            filter_upwards [] with z
            have heq := e.apply_symm_apply z
            have h0 : (e.symm z) 0 = z.1 := by
              simpa only [e, e3Coordinates_apply] using congrArg Prod.fst heq
            have h1 : (e.symm z) 1 = z.2.1 := by
              simpa only [e, e3Coordinates_apply] using
                congrArg (fun q : ℝ × (ℝ × ℝ) ↦ q.2.1) heq
            have h2 : (e.symm z) 2 = z.2.2 := by
              simpa only [e, e3Coordinates_apply] using
                congrArg (fun q : ℝ × (ℝ × ℝ) ↦ q.2.2) heq
            rw [frequencyPhase_neg_coordinate_expand, h0, h1, h2]
            dsimp only [A, B, C]
            ring
    _ = (∫ r : ℝ, A r) * ((∫ r : ℝ, B r) * ∫ r : ℝ, C r) := by
            rw [integral_prod_mul (μ := volume)
              (ν := (volume : Measure ℝ).prod volume) A
              (fun q : ℝ × ℝ ↦ B q.1 * C q.2)]
            rw [integral_prod_mul (μ := volume) (ν := volume) B C]
    _ = (𝓕 k₀) (frequencyDiagonal ζ 0) *
        ((∫ r : ℝ, B r) * ∫ r : ℝ, C r) := by
            exact congrArg (fun a : ℂ ↦ a *
              ((∫ r : ℝ, B r) * ∫ r : ℝ, C r)) hA
    _ = (𝓕 k₀) (frequencyDiagonal ζ 0) *
        ((𝓕 k₁) (frequencyDiagonal ζ 1) * ∫ r : ℝ, C r) := by
            exact congrArg (fun b : ℂ ↦
              (𝓕 k₀) (frequencyDiagonal ζ 0) *
                (b * ∫ r : ℝ, C r)) hB
    _ = R := by
            change (𝓕 k₀) (frequencyDiagonal ζ 0) *
              ((𝓕 k₁) (frequencyDiagonal ζ 1) * ∫ r : ℝ, C r) =
                (𝓕 k₀) (frequencyDiagonal ζ 0) *
                  ((𝓕 k₁) (frequencyDiagonal ζ 1) *
                    (𝓕 k₂) (frequencyDiagonal ζ 2))
            rw [hC]

/-- Products of three integrable one-dimensional kernels are integrable on
the `E3` kernel-variable space.  The coordinate transport is explicit so
that this can be reused in the subsequent Fubini step. -/
theorem threeKernel_integrable
    (k₀ k₁ k₂ : ℝ → ℂ)
    (hk₀ : Integrable k₀) (hk₁ : Integrable k₁) (hk₂ : Integrable k₂) :
    Integrable (fun r : E3 ↦
      (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2)) := by
  let L : ℝ × (ℝ × ℝ) → ℂ := fun z ↦
    k₀ z.1 * (k₁ z.2.1 * k₂ z.2.2)
  have hL : Integrable L
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    exact hk₀.mul_prod (hk₁.mul_prod hk₂)
  let e : E3 ≃ᵐ ℝ × (ℝ × ℝ) := e3Coordinates
  have hmp : MeasurePreserving e (volume : Measure E3)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    simpa only [e] using e3Coordinates_measurePreserving
  have htransport : Integrable (L ∘ e) :=
    hmp.integrable_comp_of_integrable hL
  apply htransport.congr
  filter_upwards [] with r
  simp only [Function.comp_apply, L, e, e3Coordinates_apply]
  ring

/-- The phase factor on the product of the kernel and source-frequency
variables is continuous and has norm one. -/
theorem kernelFrequencyPhase_continuous :
    Continuous (fun p : E3 × Frequency9 ↦
      frequencyPhase (frequencyDiagonal p.2) (-p.1)) := by
  unfold frequencyPhase
  exact continuous_subtype_val.comp
    (Real.continuous_fourierChar.comp
      (continuous_inner.comp
        ((frequencyDiagonal.continuous.comp continuous_snd).prodMk
          (continuous_neg.comp continuous_fst))))

/-- The kernel/frequency integrand used in the Fubini bridge is integrable
whenever all three scalar kernels are integrable. -/
theorem jointKernelFrequency_integrable
    (f₀ f₁ f₂ f₃ : Schwartz3) (k₀ k₁ k₂ : ℝ → ℂ)
    (hk₀ : Integrable k₀) (hk₁ : Integrable k₁) (hk₂ : Integrable k₂) :
    Integrable (Function.uncurry (fun r : E3 ↦ fun ζ : Frequency9 ↦
      ((k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
        frequencyPhase (frequencyDiagonal ζ) (-r)) *
          frequencyKernel f₀ f₁ f₂ f₃ ζ)) := by
  letI : (volume : Measure (E3 × E3)).IsAddHaarMeasure :=
    Measure.prod.instIsAddHaarMeasure volume volume
  letI : (volume : Measure Frequency9).IsAddHaarMeasure :=
    Measure.prod.instIsAddHaarMeasure (volume : Measure (E3 × E3)) volume
  let K : E3 → ℂ := fun r ↦ (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2)
  let H : Frequency9 → ℂ := frequencyKernel f₀ f₁ f₂ f₃
  have hK : Integrable K := by
    simpa only [K] using threeKernel_integrable k₀ k₁ k₂ hk₀ hk₁ hk₂
  have hH : Integrable H := by
    exact (frequencyKernel f₀ f₁ f₂ f₃).integrable
  have hbase : Integrable (fun p : E3 × Frequency9 ↦ K p.1 * H p.2) := by
    simpa only [Measure.volume_eq_prod] using hK.mul_prod hH
  have hphase : AEStronglyMeasurable (fun p : E3 × Frequency9 ↦
      frequencyPhase (frequencyDiagonal p.2) (-p.1)) :=
    kernelFrequencyPhase_continuous.aestronglyMeasurable
  have hphaseNorm : ∀ᵐ p : E3 × Frequency9,
      ‖frequencyPhase (frequencyDiagonal p.2) (-p.1)‖ ≤ (1 : ℝ) :=
    Filter.Eventually.of_forall fun p ↦ by
      rw [norm_frequencyPhase]
  have hmul := hbase.mul_bdd hphase hphaseNorm
  apply hmul.congr
  filter_upwards [] with p
  change (K p.1 * H p.2) *
    frequencyPhase (frequencyDiagonal p.2) (-p.1) =
      K p.1 * frequencyPhase (frequencyDiagonal p.2) (-p.1) * H p.2
  ring

/-- The exact Fubini interface between a joint spatial kernel integral and
the source `E9` frequency integral.  The sole analytic hypothesis is stated
at the one place where Fubini is used; the phase/product calculation itself
is supplied by `threeKernel_phaseIntegral_eq_fourierProduct`.

The spatial factor is `twistedProduct` evaluated at `-r`, which is exactly
what results after opening the three coordinate convolutions with kernel
variables `r₀,r₁,r₂`. -/
theorem jointKernelIntegral_eq_frequencyKernelIntegral
    (f₀ f₁ f₂ f₃ : Schwartz3) (k₀ k₁ k₂ : ℝ → ℂ)
    (hQ : Integrable (Function.uncurry (fun r : E3 ↦ fun ζ : Frequency9 ↦
      ((k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
        frequencyPhase (frequencyDiagonal ζ) (-r)) *
          frequencyKernel f₀ f₁ f₂ f₃ ζ))) :
    (∫ r : E3,
      (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
        twistedProduct f₀ f₁ f₂ f₃ (-r)) =
      ∫ ζ : Frequency9,
        ((𝓕 k₀) (frequencyDiagonal ζ 0) *
          ((𝓕 k₁) (frequencyDiagonal ζ 1) *
            (𝓕 k₂) (frequencyDiagonal ζ 2))) *
          frequencyKernel f₀ f₁ f₂ f₃ ζ := by
  let R : ℂ := ∫ ζ : Frequency9,
    ((𝓕 k₀) (frequencyDiagonal ζ 0) *
      ((𝓕 k₁) (frequencyDiagonal ζ 1) *
        (𝓕 k₂) (frequencyDiagonal ζ 2))) *
      frequencyKernel f₀ f₁ f₂ f₃ ζ
  change (∫ r : E3,
    (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
      twistedProduct f₀ f₁ f₂ f₃ (-r)) = R
  let Q : E3 → Frequency9 → ℂ := fun r ζ ↦
    ((k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
      frequencyPhase (frequencyDiagonal ζ) (-r)) *
        frequencyKernel f₀ f₁ f₂ f₃ ζ
  have hQ' : Integrable (Function.uncurry Q) := by
    simpa only [Q] using hQ
  calc
    (∫ r : E3,
      (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
        twistedProduct f₀ f₁ f₂ f₃ (-r)) =
        ∫ r : E3, ∫ ζ : Frequency9, Q r ζ := by
          apply integral_congr_ae
          filter_upwards [] with r
          rw [← frequencyKernel_phase_integral_eq_twistedProduct]
          rw [← integral_const_mul]
          apply integral_congr_ae
          filter_upwards [] with ζ
          dsimp only [Q]
          ring
    _ = ∫ ζ : Frequency9, ∫ r : E3, Q r ζ :=
      integral_integral_swap hQ'
    _ = R := by
      change (∫ ζ : Frequency9, ∫ r : E3,
        ((k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
          frequencyPhase (frequencyDiagonal ζ) (-r)) *
            frequencyKernel f₀ f₁ f₂ f₃ ζ) = _
      apply integral_congr_ae
      filter_upwards [] with ζ
      change (∫ r : E3,
        ((k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
          frequencyPhase (frequencyDiagonal ζ) (-r)) *
            frequencyKernel f₀ f₁ f₂ f₃ ζ) = _
      rw [integral_mul_const,
        threeKernel_phaseIntegral_eq_fourierProduct]

/-- The joint spatial kernel integral and the source frequency integral agree
for any three integrable one-dimensional complex kernels.  This packages the
fully justified Fubini step, so later model-kernel specializations only need
to provide their scalar integrability. -/
theorem jointKernelIntegral_eq_frequencyKernelIntegral_of_integrable
    (f₀ f₁ f₂ f₃ : Schwartz3) (k₀ k₁ k₂ : ℝ → ℂ)
    (hk₀ : Integrable k₀) (hk₁ : Integrable k₁) (hk₂ : Integrable k₂) :
    (∫ r : E3,
      (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
        twistedProduct f₀ f₁ f₂ f₃ (-r)) =
      ∫ ζ : Frequency9,
        ((𝓕 k₀) (frequencyDiagonal ζ 0) *
          ((𝓕 k₁) (frequencyDiagonal ζ 1) *
            (𝓕 k₂) (frequencyDiagonal ζ 2))) *
          frequencyKernel f₀ f₁ f₂ f₃ ζ := by
  apply jointKernelIntegral_eq_frequencyKernelIntegral
    f₀ f₁ f₂ f₃ k₀ k₁ k₂
  exact jointKernelFrequency_integrable
    f₀ f₁ f₂ f₃ k₀ k₁ k₂ hk₀ hk₁ hk₂

/-- Opening the three independent coordinate kernel integrals is exactly an
integral over the Euclidean kernel-vector `r : E3`.  This is a pointwise
product-measure identity and therefore needs no convergence assumption. -/
theorem threeCoordinateKernelIntegral_eq_productIntegrals
    (f₁ f₂ f₃ : E3 → ℂ) (k₀ k₁ k₂ : ℝ → ℂ) (x : E3) :
    (∫ r : E3,
      (f₁ (x - r 0 • Anisotropy.coordinateDirection 0) * k₀ (r 0)) *
        ((f₂ (x - r 1 • Anisotropy.coordinateDirection 1) * k₁ (r 1)) *
          (f₃ (x - r 2 • Anisotropy.coordinateDirection 2) * k₂ (r 2)))) =
      (∫ r : ℝ, f₁ (x - r • Anisotropy.coordinateDirection 0) * k₀ r) *
        ((∫ r : ℝ, f₂ (x - r • Anisotropy.coordinateDirection 1) * k₁ r) *
          ∫ r : ℝ, f₃ (x - r • Anisotropy.coordinateDirection 2) * k₂ r) := by
  let A : ℝ → ℂ := fun r ↦
    f₁ (x - r • Anisotropy.coordinateDirection 0) * k₀ r
  let B : ℝ → ℂ := fun r ↦
    f₂ (x - r • Anisotropy.coordinateDirection 1) * k₁ r
  let C : ℝ → ℂ := fun r ↦
    f₃ (x - r • Anisotropy.coordinateDirection 2) * k₂ r
  let R : ℂ := (∫ r : ℝ, A r) *
    ((∫ r : ℝ, B r) * ∫ r : ℝ, C r)
  change (∫ r : E3,
    (f₁ (x - r 0 • Anisotropy.coordinateDirection 0) * k₀ (r 0)) *
      ((f₂ (x - r 1 • Anisotropy.coordinateDirection 1) * k₁ (r 1)) *
        (f₃ (x - r 2 • Anisotropy.coordinateDirection 2) * k₂ (r 2)))) = R
  let e : E3 ≃ᵐ ℝ × (ℝ × ℝ) := e3Coordinates
  have hmp : MeasurePreserving e (volume : Measure E3)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    simpa only [e] using e3Coordinates_measurePreserving
  calc
    (∫ r : E3,
      (f₁ (x - r 0 • Anisotropy.coordinateDirection 0) * k₀ (r 0)) *
        ((f₂ (x - r 1 • Anisotropy.coordinateDirection 1) * k₁ (r 1)) *
          (f₃ (x - r 2 • Anisotropy.coordinateDirection 2) * k₂ (r 2)))) =
        ∫ z : ℝ × (ℝ × ℝ), A z.1 * (B z.2.1 * C z.2.2)
          ∂((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
      calc
        (∫ r : E3,
          (f₁ (x - r 0 • Anisotropy.coordinateDirection 0) * k₀ (r 0)) *
            ((f₂ (x - r 1 • Anisotropy.coordinateDirection 1) * k₁ (r 1)) *
              (f₃ (x - r 2 • Anisotropy.coordinateDirection 2) * k₂ (r 2)))) =
            ∫ z : ℝ × (ℝ × ℝ),
              (f₁ (x - (e.symm z) 0 • Anisotropy.coordinateDirection 0) *
                k₀ ((e.symm z) 0)) *
                ((f₂ (x - (e.symm z) 1 • Anisotropy.coordinateDirection 1) *
                  k₁ ((e.symm z) 1)) *
                  (f₃ (x - (e.symm z) 2 • Anisotropy.coordinateDirection 2) *
                    k₂ ((e.symm z) 2)))
              ∂((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
                exact (MeasurePreserving.symm e hmp).integral_comp
                  e.symm.measurableEmbedding _ |>.symm
        _ = ∫ z : ℝ × (ℝ × ℝ), A z.1 * (B z.2.1 * C z.2.2)
              ∂((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
                apply integral_congr_ae
                filter_upwards [] with z
                have heq := e.apply_symm_apply z
                have h0 : (e.symm z) 0 = z.1 := by
                  simpa only [e, e3Coordinates_apply] using congrArg Prod.fst heq
                have h1 : (e.symm z) 1 = z.2.1 := by
                  simpa only [e, e3Coordinates_apply] using
                    congrArg (fun q : ℝ × (ℝ × ℝ) ↦ q.2.1) heq
                have h2 : (e.symm z) 2 = z.2.2 := by
                  simpa only [e, e3Coordinates_apply] using
                    congrArg (fun q : ℝ × (ℝ × ℝ) ↦ q.2.2) heq
                rw [h0, h1, h2]
    _ = R := by
      rw [integral_prod_mul (μ := volume)
        (ν := (volume : Measure ℝ).prod volume) A
        (fun q : ℝ × ℝ ↦ B q.1 * C q.2)]
      rw [integral_prod_mul (μ := volume) (ν := volume) B C]

/-- Subject only to the displayed joint-integrability hypothesis, the literal
three-coordinate spatial convolution integral is the joint kernel integral
against `twistedProduct`.  This is the spatial half of the model/Fourier
bridge; the previous theorem supplies the product-measure opening of the
three coordinate convolutions. -/
theorem threeCoordinateSpatialIntegral_eq_jointKernelIntegral
    (f₀ f₁ f₂ f₃ : Schwartz3) (k₀ k₁ k₂ : ℝ → ℂ)
    (hJ : Integrable (Function.uncurry (fun x : E3 ↦ fun r : E3 ↦
      f₀ x *
        ((f₁ (x - r 0 • Anisotropy.coordinateDirection 0) * k₀ (r 0)) *
          ((f₂ (x - r 1 • Anisotropy.coordinateDirection 1) * k₁ (r 1)) *
            (f₃ (x - r 2 • Anisotropy.coordinateDirection 2) * k₂ (r 2))))))) :
    (∫ x : E3, f₀ x *
      ((∫ r : ℝ, f₁ (x - r • Anisotropy.coordinateDirection 0) * k₀ r) *
        ((∫ r : ℝ, f₂ (x - r • Anisotropy.coordinateDirection 1) * k₁ r) *
          ∫ r : ℝ, f₃ (x - r • Anisotropy.coordinateDirection 2) * k₂ r))) =
      ∫ r : E3,
        (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
          twistedProduct f₀ f₁ f₂ f₃ (-r) := by
  let Q : E3 → E3 → ℂ := fun x r ↦
    f₀ x *
      ((f₁ (x - r 0 • Anisotropy.coordinateDirection 0) * k₀ (r 0)) *
        ((f₂ (x - r 1 • Anisotropy.coordinateDirection 1) * k₁ (r 1)) *
          (f₃ (x - r 2 • Anisotropy.coordinateDirection 2) * k₂ (r 2))))
  have hQ : Integrable (Function.uncurry Q) := by
    simpa only [Q] using hJ
  calc
    (∫ x : E3, f₀ x *
      ((∫ r : ℝ, f₁ (x - r • Anisotropy.coordinateDirection 0) * k₀ r) *
        ((∫ r : ℝ, f₂ (x - r • Anisotropy.coordinateDirection 1) * k₁ r) *
          ∫ r : ℝ, f₃ (x - r • Anisotropy.coordinateDirection 2) * k₂ r))) =
        ∫ x : E3, ∫ r : E3, Q x r := by
      apply integral_congr_ae
      filter_upwards [] with x
      rw [← threeCoordinateKernelIntegral_eq_productIntegrals
        (f₁ : E3 → ℂ) (f₂ : E3 → ℂ) (f₃ : E3 → ℂ) k₀ k₁ k₂ x]
      rw [← integral_const_mul]
    _ = ∫ r : E3, ∫ x : E3, Q x r :=
      integral_integral_swap hQ
    _ = ∫ r : E3,
        (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
          twistedProduct f₀ f₁ f₂ f₃ (-r) := by
      apply integral_congr_ae
      filter_upwards [] with r
      rw [twistedProduct_apply, ← integral_const_mul]
      apply integral_congr_ae
      filter_upwards [] with x
      dsimp only [Q]
      simp only [PiLp.neg_apply, neg_smul, sub_eq_add_neg]
      ring

/-- The spatial joint integrand is integrable for Schwartz inputs and three
integrable scalar kernels.  The proof uses one integrable Schwartz factor,
the integrable kernel triple, and uniform bounds for the other three
Schwartz factors. -/
theorem threeCoordinateSpatialJoint_integrable
    (f₀ f₁ f₂ f₃ : Schwartz3) (k₀ k₁ k₂ : ℝ → ℂ)
    (hk₀ : Integrable k₀) (hk₁ : Integrable k₁) (hk₂ : Integrable k₂) :
    Integrable (Function.uncurry (fun x : E3 ↦ fun r : E3 ↦
      f₀ x *
        ((f₁ (x - r 0 • Anisotropy.coordinateDirection 0) * k₀ (r 0)) *
          ((f₂ (x - r 1 • Anisotropy.coordinateDirection 1) * k₁ (r 1)) *
            (f₃ (x - r 2 • Anisotropy.coordinateDirection 2) * k₂ (r 2)))))) := by
  rcases schwartz_continuous_bounded f₁ with ⟨hcont₁, C₁, hC₁, hbound₁⟩
  rcases schwartz_continuous_bounded f₂ with ⟨hcont₂, C₂, hC₂, hbound₂⟩
  rcases schwartz_continuous_bounded f₃ with ⟨hcont₃, C₃, hC₃, hbound₃⟩
  let K : E3 → ℂ := fun r ↦ (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2)
  let P : E3 × E3 → ℂ := fun p ↦
    f₁ (p.1 - p.2 0 • Anisotropy.coordinateDirection 0) *
      (f₂ (p.1 - p.2 1 • Anisotropy.coordinateDirection 1) *
        f₃ (p.1 - p.2 2 • Anisotropy.coordinateDirection 2))
  have hK : Integrable K := by
    simpa only [K] using threeKernel_integrable k₀ k₁ k₂ hk₀ hk₁ hk₂
  have hbase : Integrable (fun p : E3 × E3 ↦ f₀ p.1 * K p.2) := by
    simpa only [Measure.volume_eq_prod] using f₀.integrable.mul_prod hK
  have hPcont : Continuous P := by
    dsimp only [P]
    fun_prop
  have hPbound : ∀ p : E3 × E3, ‖P p‖ ≤ C₁ * (C₂ * C₃) := by
    intro p
    dsimp only [P]
    rw [norm_mul, norm_mul]
    gcongr
    · exact hbound₁ _
    · exact hbound₂ _
    · exact hbound₃ _
  have hmul := hbase.mul_bdd hPcont.aestronglyMeasurable
    (Filter.Eventually.of_forall hPbound)
  apply hmul.congr
  filter_upwards [] with p
  change (f₀ p.1 * K p.2) * P p =
    Function.uncurry (fun x : E3 ↦ fun r : E3 ↦
      f₀ x *
        ((f₁ (x - r 0 • Anisotropy.coordinateDirection 0) * k₀ (r 0)) *
          ((f₂ (x - r 1 • Anisotropy.coordinateDirection 1) * k₁ (r 1)) *
            (f₃ (x - r 2 • Anisotropy.coordinateDirection 2) * k₂ (r 2))))) p
  dsimp only [K, P, Function.uncurry]
  ring

/-- Fully justified spatial-to-frequency bridge for three coordinate
convolutions with integrable scalar kernels.  The left side is the literal
fixed-scale spatial model pattern; the right side is precisely the source
`E9` frequency kernel with the three scalar Fourier multipliers inserted. -/
theorem threeCoordinateSpatialIntegral_eq_frequencyKernelIntegral
    (f₀ f₁ f₂ f₃ : Schwartz3) (k₀ k₁ k₂ : ℝ → ℂ)
    (hk₀ : Integrable k₀) (hk₁ : Integrable k₁) (hk₂ : Integrable k₂) :
    (∫ x : E3, f₀ x *
      ((∫ r : ℝ, f₁ (x - r • Anisotropy.coordinateDirection 0) * k₀ r) *
        ((∫ r : ℝ, f₂ (x - r • Anisotropy.coordinateDirection 1) * k₁ r) *
          ∫ r : ℝ, f₃ (x - r • Anisotropy.coordinateDirection 2) * k₂ r))) =
      ∫ ζ : Frequency9,
        ((𝓕 k₀) (frequencyDiagonal ζ 0) *
          ((𝓕 k₁) (frequencyDiagonal ζ 1) *
            (𝓕 k₂) (frequencyDiagonal ζ 2))) *
          frequencyKernel f₀ f₁ f₂ f₃ ζ := by
  let R : ℂ := ∫ ζ : Frequency9,
    ((𝓕 k₀) (frequencyDiagonal ζ 0) *
      ((𝓕 k₁) (frequencyDiagonal ζ 1) *
        (𝓕 k₂) (frequencyDiagonal ζ 2))) *
      frequencyKernel f₀ f₁ f₂ f₃ ζ
  change (∫ x : E3, f₀ x *
    ((∫ r : ℝ, f₁ (x - r • Anisotropy.coordinateDirection 0) * k₀ r) *
      ((∫ r : ℝ, f₂ (x - r • Anisotropy.coordinateDirection 1) * k₁ r) *
        ∫ r : ℝ, f₃ (x - r • Anisotropy.coordinateDirection 2) * k₂ r))) = R
  calc
    (∫ x : E3, f₀ x *
      ((∫ r : ℝ, f₁ (x - r • Anisotropy.coordinateDirection 0) * k₀ r) *
        ((∫ r : ℝ, f₂ (x - r • Anisotropy.coordinateDirection 1) * k₁ r) *
          ∫ r : ℝ, f₃ (x - r • Anisotropy.coordinateDirection 2) * k₂ r))) =
        ∫ r : E3,
          (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
            twistedProduct f₀ f₁ f₂ f₃ (-r) :=
      threeCoordinateSpatialIntegral_eq_jointKernelIntegral
        f₀ f₁ f₂ f₃ k₀ k₁ k₂
        (threeCoordinateSpatialJoint_integrable
          f₀ f₁ f₂ f₃ k₀ k₁ k₂ hk₀ hk₁ hk₂)
    _ = R := by
      change (∫ r : E3,
        (k₀ (r 0) * k₁ (r 1)) * k₂ (r 2) *
          twistedProduct f₀ f₁ f₂ f₃ (-r)) =
        ∫ ζ : Frequency9,
          ((𝓕 k₀) (frequencyDiagonal ζ 0) *
            ((𝓕 k₁) (frequencyDiagonal ζ 1) *
              (𝓕 k₂) (frequencyDiagonal ζ 2))) *
            frequencyKernel f₀ f₁ f₂ f₃ ζ
      exact jointKernelIntegral_eq_frequencyKernelIntegral_of_integrable
        f₀ f₁ f₂ f₃ k₀ k₁ k₂ hk₀ hk₁ hk₂

/-- The complexified positive-scale low model kernel, in the literal spatial
convolution convention. -/
noncomputable def complexDilatedModelLowKernel (u s : ℝ) : ℝ → ℂ :=
  fun r ↦ ((kernelDilate (ModelLowKernel u) s r : ℝ) : ℂ)

/-- The complexified positive-scale third model kernel, in the literal
spatial convolution convention. -/
noncomputable def complexDilatedModelThirdKernel (u s : ℝ) : ℝ → ℂ :=
  fun r ↦ ((kernelDilate (ModelThirdKernel u) s r : ℝ) : ℂ)

theorem integrable_complexDilatedModelLowKernel
    (u s : ℝ) (hs : 0 < s) :
    Integrable (complexDilatedModelLowKernel u s) := by
  change Integrable (fun r : ℝ ↦
    ((kernelDilate (ModelLowKernel u) s r : ℝ) : ℂ))
  exact (integrable_ModelLowKernel_dilate u s hs).ofReal

theorem integrable_complexDilatedModelThirdKernel
    (u s : ℝ) (hs : 0 < s) :
    Integrable (complexDilatedModelThirdKernel u s) := by
  change Integrable (fun r : ℝ ↦
    ((kernelDilate (ModelThirdKernel u) s r : ℝ) : ℂ))
  exact (integrable_ModelThirdKernel_dilate u s hs).ofReal

/-- At a fixed positive scale, the literal complex source spatial profile is
exactly the `E9` frequency integral carrying the three actual scalar Fourier
kernel multipliers.  This is the spatial/Fubini interface needed before the
mode multiplier identities substitute their explicit cone symbols. -/
theorem LiteralModelSpatialProfile_eq_frequencyKernelIntegral
    (α : Anisotropy) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (ht : 0 < t) :
    LiteralModelSpatialProfile α u F t =
      ∫ ζ : Frequency9,
        ((𝓕 (complexDilatedModelLowKernel (u 0)
          (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
          ((𝓕 (complexDilatedModelLowKernel (u 1)
            (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
            (𝓕 (complexDilatedModelThirdKernel (u 2)
              (t ^ α.weight 2))) (frequencyDiagonal ζ 2))) *
          frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ := by
  have hs₀ : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs₁ : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs₂ : 0 < t ^ α.weight 2 := pow_pos ht _
  have hk₀ : Integrable
      (complexDilatedModelLowKernel (u 0) (t ^ α.weight 0)) :=
    integrable_complexDilatedModelLowKernel (u 0) (t ^ α.weight 0) hs₀
  have hk₁ : Integrable
      (complexDilatedModelLowKernel (u 1) (t ^ α.weight 1)) :=
    integrable_complexDilatedModelLowKernel (u 1) (t ^ α.weight 1) hs₁
  have hk₂ : Integrable
      (complexDilatedModelThirdKernel (u 2) (t ^ α.weight 2)) :=
    integrable_complexDilatedModelThirdKernel (u 2) (t ^ α.weight 2) hs₂
  calc
    LiteralModelSpatialProfile α u F t =
        ∫ x : E3, F 0 x *
          ((∫ r : ℝ, F 1 (x - r • Anisotropy.coordinateDirection 0) *
              complexDilatedModelLowKernel (u 0) (t ^ α.weight 0) r) *
            ((∫ r : ℝ, F 2 (x - r • Anisotropy.coordinateDirection 1) *
                complexDilatedModelLowKernel (u 1) (t ^ α.weight 1) r) *
              ∫ r : ℝ, F 3 (x - r • Anisotropy.coordinateDirection 2) *
                complexDilatedModelThirdKernel (u 2)
                  (t ^ α.weight 2) r)) := by
          unfold LiteralModelSpatialProfile
            LiteralComplexInternal.scratch_LiteralModelSpatialProfile
            LiteralComplexInternal.scratch_LiteralModelSpatialIntegrand
            LiteralComplexInternal.scratch_LiteralModelCoordinateConvolution
            complexDilatedModelLowKernel
            complexDilatedModelThirdKernel
          apply integral_congr_ae
          filter_upwards [] with x
          ring
    _ = ∫ ζ : Frequency9,
        ((𝓕 (complexDilatedModelLowKernel (u 0)
          (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
          ((𝓕 (complexDilatedModelLowKernel (u 1)
            (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
            (𝓕 (complexDilatedModelThirdKernel (u 2)
              (t ^ α.weight 2))) (frequencyDiagonal ζ 2))) *
          frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ :=
      threeCoordinateSpatialIntegral_eq_frequencyKernelIntegral
        (F 0) (F 1) (F 2) (F 3)
        (complexDilatedModelLowKernel (u 0) (t ^ α.weight 0))
        (complexDilatedModelLowKernel (u 1) (t ^ α.weight 1))
        (complexDilatedModelThirdKernel (u 2) (t ^ α.weight 2))
        hk₀ hk₁ hk₂

/-- The fixed-scale Fourier multiplier whose value at `-η` is the product of
the three literal spatial kernel multipliers at `η`. -/
noncomputable def literalModelScaleKernelSymbol
    (α : Anisotropy) (u : E3) (t : ℝ) : E3 → ℂ := fun ξ ↦
  (𝓕 (complexDilatedModelLowKernel (u 0)
    (t ^ α.weight 0))) (-(ξ 0)) *
    ((𝓕 (complexDilatedModelLowKernel (u 1)
      (t ^ α.weight 1))) (-(ξ 1)) *
      (𝓕 (complexDilatedModelThirdKernel (u 2)
        (t ^ α.weight 2))) (-(ξ 2)))

/-- Evaluation of the fixed-scale kernel symbol at the source diagonal
variable exposes the three Fourier multipliers in the spatial bridge. -/
theorem literalModelScaleKernelSymbol_neg_frequencyDiagonal
    (α : Anisotropy) (u : E3) (t : ℝ) (ζ : Frequency9) :
    literalModelScaleKernelSymbol α u t (-frequencyDiagonal ζ) =
      (𝓕 (complexDilatedModelLowKernel (u 0)
        (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
        ((𝓕 (complexDilatedModelLowKernel (u 1)
          (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
          (𝓕 (complexDilatedModelThirdKernel (u 2)
            (t ^ α.weight 2))) (frequencyDiagonal ζ 2)) := by
  unfold literalModelScaleKernelSymbol
  simp only [PiLp.neg_apply, neg_neg]

/-- Fixed-scale literal spatial profile as the project's existing
`frequencyForm`.  This eliminates the remaining notational gap between the
literal convolution formula and the source's `E9` multiplier representation. -/
theorem LiteralModelSpatialProfile_eq_frequencyForm
    (α : Anisotropy) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (ht : 0 < t) :
    LiteralModelSpatialProfile α u F t =
      frequencyForm (literalModelScaleKernelSymbol α u t)
        (F 0) (F 1) (F 2) (F 3) := by
  let R : ℂ := frequencyForm (literalModelScaleKernelSymbol α u t)
    (F 0) (F 1) (F 2) (F 3)
  change LiteralModelSpatialProfile α u F t = R
  calc
    LiteralModelSpatialProfile α u F t =
        ∫ ζ : Frequency9,
          ((𝓕 (complexDilatedModelLowKernel (u 0)
            (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
            ((𝓕 (complexDilatedModelLowKernel (u 1)
              (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
              (𝓕 (complexDilatedModelThirdKernel (u 2)
                (t ^ α.weight 2))) (frequencyDiagonal ζ 2))) *
            frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ :=
      LiteralModelSpatialProfile_eq_frequencyKernelIntegral α u F t ht
    _ = R := by
      change (∫ ζ : Frequency9,
        ((𝓕 (complexDilatedModelLowKernel (u 0)
          (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
          ((𝓕 (complexDilatedModelLowKernel (u 1)
            (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
            (𝓕 (complexDilatedModelThirdKernel (u 2)
              (t ^ α.weight 2))) (frequencyDiagonal ζ 2))) *
          frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ) =
          frequencyForm (literalModelScaleKernelSymbol α u t)
            (F 0) (F 1) (F 2) (F 3)
      unfold frequencyForm
      rw [frequencyMeasure_eq_volume]
      apply integral_congr_ae
      filter_upwards [] with ζ
      rw [literalModelScaleKernelSymbol_neg_frequencyDiagonal]

/-- Conditional `multiplierForm` version of the fixed-scale literal spatial
identity.  The only external premise is the standard anisotropic-multiplier
certificate for the compact fixed-scale kernel symbol. -/
theorem LiteralModelSpatialProfile_eq_multiplierForm
    (α : Anisotropy) (M : ℝ) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (ht : 0 < t)
    (hm : Anisotropy.IsAnisotropicMultiplier α M
      (literalModelScaleKernelSymbol α u t)) :
    LiteralModelSpatialProfile α u F t =
      multiplierForm (literalModelScaleKernelSymbol α u t)
        (F 0) (F 1) (F 2) (F 3) := by
  calc
    LiteralModelSpatialProfile α u F t =
        frequencyForm (literalModelScaleKernelSymbol α u t)
          (F 0) (F 1) (F 2) (F 3) :=
      LiteralModelSpatialProfile_eq_frequencyForm α u F t ht
    _ = multiplierForm (literalModelScaleKernelSymbol α u t)
          (F 0) (F 1) (F 2) (F 3) :=
      (multiplierForm_eq_frequencyForm α M
        (literalModelScaleKernelSymbol α u t) hm
        (F 0) (F 1) (F 2) (F 3)).symm

/-- The complexified scaled kernel in an arbitrary active-coordinate model. -/
noncomputable def complexDilatedActiveModelKernel
    (i j : Fin 3) (u : E3) (s : ℝ) : ℝ → ℂ :=
  fun r ↦ ((kernelDilate (activeModelKernel i j u) s r : ℝ) : ℂ)

theorem integrable_complexDilatedActiveModelKernel
    (i j : Fin 3) (u : E3) (s : ℝ) (hs : 0 < s) :
    Integrable (complexDilatedActiveModelKernel i j u s) := by
  change Integrable (fun r : ℝ ↦
    ((kernelDilate (activeModelKernel i j u) s r : ℝ) : ℂ))
  exact (integrable_kernelDilate (integrable_activeModelKernel i j u) hs.ne').ofReal

/-- Fixed-scale spatial/Fourier bridge for the literal complex model with an
arbitrary active annular coordinate. -/
theorem LiteralActiveModelSpatialProfile_eq_frequencyKernelIntegral
    (α : Anisotropy) (i : Fin 3) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (ht : 0 < t) :
    LiteralActiveModelSpatialProfile α i u F t =
      ∫ ζ : Frequency9,
        ((𝓕 (complexDilatedActiveModelKernel i 0 u
          (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
          ((𝓕 (complexDilatedActiveModelKernel i 1 u
            (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
            (𝓕 (complexDilatedActiveModelKernel i 2 u
              (t ^ α.weight 2))) (frequencyDiagonal ζ 2))) *
          frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ := by
  have hs₀ : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs₁ : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs₂ : 0 < t ^ α.weight 2 := pow_pos ht _
  have hk₀ : Integrable
      (complexDilatedActiveModelKernel i 0 u (t ^ α.weight 0)) :=
    integrable_complexDilatedActiveModelKernel i 0 u
      (t ^ α.weight 0) hs₀
  have hk₁ : Integrable
      (complexDilatedActiveModelKernel i 1 u (t ^ α.weight 1)) :=
    integrable_complexDilatedActiveModelKernel i 1 u
      (t ^ α.weight 1) hs₁
  have hk₂ : Integrable
      (complexDilatedActiveModelKernel i 2 u (t ^ α.weight 2)) :=
    integrable_complexDilatedActiveModelKernel i 2 u
      (t ^ α.weight 2) hs₂
  calc
    LiteralActiveModelSpatialProfile α i u F t =
        ∫ x : E3, F 0 x *
          ((∫ r : ℝ, F 1 (x - r • Anisotropy.coordinateDirection 0) *
              complexDilatedActiveModelKernel i 0 u
                (t ^ α.weight 0) r) *
            ((∫ r : ℝ, F 2 (x - r • Anisotropy.coordinateDirection 1) *
                complexDilatedActiveModelKernel i 1 u
                  (t ^ α.weight 1) r) *
              ∫ r : ℝ, F 3 (x - r • Anisotropy.coordinateDirection 2) *
                complexDilatedActiveModelKernel i 2 u
                  (t ^ α.weight 2) r)) := by
          unfold LiteralActiveModelSpatialProfile
            LiteralComplexActiveInternal.scratch_LiteralActiveModelSpatialProfile
            LiteralComplexActiveInternal.scratch_LiteralActiveModelSpatialIntegrand
            LiteralModelCoordinateConvolution
            LiteralComplexInternal.scratch_LiteralModelCoordinateConvolution
            complexDilatedActiveModelKernel
          simp only [Fin.prod_univ_succ]
          apply integral_congr_ae
          filter_upwards [] with x
          simp
    _ = ∫ ζ : Frequency9,
        ((𝓕 (complexDilatedActiveModelKernel i 0 u
          (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
          ((𝓕 (complexDilatedActiveModelKernel i 1 u
            (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
            (𝓕 (complexDilatedActiveModelKernel i 2 u
              (t ^ α.weight 2))) (frequencyDiagonal ζ 2))) *
          frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ :=
      threeCoordinateSpatialIntegral_eq_frequencyKernelIntegral
        (F 0) (F 1) (F 2) (F 3)
        (complexDilatedActiveModelKernel i 0 u (t ^ α.weight 0))
        (complexDilatedActiveModelKernel i 1 u (t ^ α.weight 1))
        (complexDilatedActiveModelKernel i 2 u (t ^ α.weight 2))
        hk₀ hk₁ hk₂

/-- Fixed-scale kernel multiplier for the literal model with active coordinate
`i`, expressed so that evaluation at `-η` returns the three spatial Fourier
kernel factors at `η`. -/
noncomputable def literalActiveModelScaleKernelSymbol
    (α : Anisotropy) (i : Fin 3) (u : E3) (t : ℝ) : E3 → ℂ := fun ξ ↦
  (𝓕 (complexDilatedActiveModelKernel i 0 u
    (t ^ α.weight 0))) (-(ξ 0)) *
    ((𝓕 (complexDilatedActiveModelKernel i 1 u
      (t ^ α.weight 1))) (-(ξ 1)) *
      (𝓕 (complexDilatedActiveModelKernel i 2 u
        (t ^ α.weight 2))) (-(ξ 2)))

theorem literalActiveModelScaleKernelSymbol_neg_frequencyDiagonal
    (α : Anisotropy) (i : Fin 3) (u : E3) (t : ℝ) (ζ : Frequency9) :
    literalActiveModelScaleKernelSymbol α i u t (-frequencyDiagonal ζ) =
      (𝓕 (complexDilatedActiveModelKernel i 0 u
        (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
        ((𝓕 (complexDilatedActiveModelKernel i 1 u
          (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
          (𝓕 (complexDilatedActiveModelKernel i 2 u
            (t ^ α.weight 2))) (frequencyDiagonal ζ 2)) := by
  unfold literalActiveModelScaleKernelSymbol
  simp only [PiLp.neg_apply, neg_neg]

/-- The arbitrary-active literal spatial profile is exactly the existing
`frequencyForm` of its fixed-scale kernel multiplier. -/
theorem LiteralActiveModelSpatialProfile_eq_frequencyForm
    (α : Anisotropy) (i : Fin 3) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (ht : 0 < t) :
    LiteralActiveModelSpatialProfile α i u F t =
      frequencyForm (literalActiveModelScaleKernelSymbol α i u t)
        (F 0) (F 1) (F 2) (F 3) := by
  let R : ℂ := frequencyForm (literalActiveModelScaleKernelSymbol α i u t)
    (F 0) (F 1) (F 2) (F 3)
  change LiteralActiveModelSpatialProfile α i u F t = R
  calc
    LiteralActiveModelSpatialProfile α i u F t =
        ∫ ζ : Frequency9,
          ((𝓕 (complexDilatedActiveModelKernel i 0 u
            (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
            ((𝓕 (complexDilatedActiveModelKernel i 1 u
              (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
              (𝓕 (complexDilatedActiveModelKernel i 2 u
                (t ^ α.weight 2))) (frequencyDiagonal ζ 2))) *
            frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ :=
      LiteralActiveModelSpatialProfile_eq_frequencyKernelIntegral
        α i u F t ht
    _ = R := by
      change (∫ ζ : Frequency9,
        ((𝓕 (complexDilatedActiveModelKernel i 0 u
          (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
          ((𝓕 (complexDilatedActiveModelKernel i 1 u
            (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
            (𝓕 (complexDilatedActiveModelKernel i 2 u
              (t ^ α.weight 2))) (frequencyDiagonal ζ 2))) *
          frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ) =
          frequencyForm (literalActiveModelScaleKernelSymbol α i u t)
            (F 0) (F 1) (F 2) (F 3)
      unfold frequencyForm
      rw [frequencyMeasure_eq_volume]
      apply integral_congr_ae
      filter_upwards [] with ζ
      rw [literalActiveModelScaleKernelSymbol_neg_frequencyDiagonal]

/-- Conditional multiplier-form version of the arbitrary-active fixed-scale
literal spatial identity. -/
theorem LiteralActiveModelSpatialProfile_eq_multiplierForm
    (α : Anisotropy) (M : ℝ) (i : Fin 3) (u : E3)
    (F : ModelComplexSchwartzInput) (t : ℝ) (ht : 0 < t)
    (hm : Anisotropy.IsAnisotropicMultiplier α M
      (literalActiveModelScaleKernelSymbol α i u t)) :
    LiteralActiveModelSpatialProfile α i u F t =
      multiplierForm (literalActiveModelScaleKernelSymbol α i u t)
        (F 0) (F 1) (F 2) (F 3) := by
  calc
    LiteralActiveModelSpatialProfile α i u F t =
        frequencyForm (literalActiveModelScaleKernelSymbol α i u t)
          (F 0) (F 1) (F 2) (F 3) :=
      LiteralActiveModelSpatialProfile_eq_frequencyForm α i u F t ht
    _ = multiplierForm (literalActiveModelScaleKernelSymbol α i u t)
          (F 0) (F 1) (F 2) (F 3) :=
      (multiplierForm_eq_frequencyForm α M
        (literalActiveModelScaleKernelSymbol α i u t) hm
        (F 0) (F 1) (F 2) (F 3)).symm

/-- At active coordinate three, the public literal active spatial profile is
the base literal spatial profile. -/
theorem LiteralActiveModelSpatialProfile_two
    (α : Anisotropy) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) :
    LiteralActiveModelSpatialProfile α 2 u F t =
      LiteralModelSpatialProfile α u F t := by
  unfold LiteralActiveModelSpatialProfile
    LiteralComplexActiveInternal.scratch_LiteralActiveModelSpatialProfile
    LiteralModelSpatialProfile
    LiteralComplexInternal.scratch_LiteralModelSpatialProfile
  apply integral_congr_ae
  filter_upwards [] with x
  exact LiteralActiveModelSpatialIntegrand_two α u F t x

/-- The public active-coordinate spatial profile obeys the existing
coordinate-permutation transport. -/
theorem LiteralActiveModelSpatialProfile_permute_to_two
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (F : ModelComplexSchwartzInput) (hσ : σ 2 = i)
    (t : ℝ) :
    LiteralActiveModelSpatialProfile α i u F t =
      LiteralActiveModelSpatialProfile (permutedAnisotropy α σ) 2
        (coordinatePermutation σ u) (complexPermutedModelInput σ F) t := by
  simpa only [LiteralActiveModelSpatialProfile, complexPermutedModelInput] using
    LiteralComplexActiveInternal.scratch_LiteralActiveModelSpatialProfile_permute_to_two
      α σ i u F hσ t

/-- Negating a multiplier negates its four-linear frequency form. -/
theorem frequencyForm_neg
    (m : E3 → ℂ) (f₀ f₁ f₂ f₃ : SchwartzMap E3 ℂ) :
    frequencyForm (fun ξ ↦ -m ξ) f₀ f₁ f₂ f₃ =
      -frequencyForm m f₀ f₁ f₂ f₃ := by
  unfold frequencyForm
  rw [← integral_neg]
  apply integral_congr_ae
  filter_upwards [] with ζ
  ring

/-- For the source translation `ν / 8`, the literal spatial kernel symbol
is the negative of the positive localized third-coordinate Fourier-mode
symbol.  The one physical minus sign comes from the third kernel. -/
theorem literalModelScaleKernelSymbol_standardMode_eq_neg_thirdModeFrequencySymbol
    (α : Anisotropy) (ν : standardModeLattice) (t : ℝ) (ht : 0 < t) :
    literalModelScaleKernelSymbol α (standardModeTranslate ν) t =
      fun ξ ↦ -thirdModeFrequencySymbol α ν t ξ := by
  funext ξ
  unfold literalModelScaleKernelSymbol thirdModeFrequencySymbol
    complexDilatedModelLowKernel complexDilatedModelThirdKernel
  have h₀ := fourier_kernelDilate_ModelLowKernel_standardMode_neg
    ν 0 (t ^ α.weight 0) (ξ 0) (pow_pos ht _)
  have h₁ := fourier_kernelDilate_ModelLowKernel_standardMode_neg
    ν 1 (t ^ α.weight 1) (ξ 1) (pow_pos ht _)
  have h₂ := fourier_kernelDilate_ModelThirdKernel_standardMode_neg
    ν 2 (t ^ α.weight 2) (ξ 2) (pow_pos ht _)
  rw [h₀, h₁, h₂]
  rw [← fourierChar_three]
  ring

/-- The positive source Fourier-mode form equals the negative of the literal
third-active spatial profile. -/
theorem thirdModeFrequencyForm_eq_neg_LiteralActiveModelSpatialProfile
    (α : Anisotropy) (ν : standardModeLattice) (t : ℝ) (ht : 0 < t)
    (F : ModelComplexSchwartzInput) :
    thirdModeFrequencyForm α ν t F =
      -LiteralActiveModelSpatialProfile α 2 (standardModeTranslate ν) F t := by
  calc
    thirdModeFrequencyForm α ν t F =
        frequencyForm (thirdModeFrequencySymbol α ν t)
          (F 0) (F 1) (F 2) (F 3) := rfl
    _ = -frequencyForm
        (fun ξ ↦ -thirdModeFrequencySymbol α ν t ξ)
        (F 0) (F 1) (F 2) (F 3) := by
      rw [frequencyForm_neg]
      ring
    _ = -frequencyForm
        (literalModelScaleKernelSymbol α (standardModeTranslate ν) t)
        (F 0) (F 1) (F 2) (F 3) := by
      rw [literalModelScaleKernelSymbol_standardMode_eq_neg_thirdModeFrequencySymbol
        α ν t ht]
    _ = -LiteralModelSpatialProfile α (standardModeTranslate ν) F t := by
      rw [← LiteralModelSpatialProfile_eq_frequencyForm α
        (standardModeTranslate ν) F t ht]
    _ = -LiteralActiveModelSpatialProfile α 2 (standardModeTranslate ν) F t := by
      rw [LiteralActiveModelSpatialProfile_two]

/-- The one-mode spatial/Fourier sign bridge in any active coordinate, after
the standard source permutation has moved that coordinate to the third slot. -/
theorem thirdModeFrequencyForm_eq_neg_LiteralActiveModelSpatialProfile_permuted
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (hσ : σ 2 = i) (ν : standardModeLattice) (t : ℝ) (ht : 0 < t)
    (F : ModelComplexSchwartzInput) :
    thirdModeFrequencyForm (permutedAnisotropy α σ) ν t
      (complexPermutedModelInput σ F) =
      -LiteralActiveModelSpatialProfile α i
        ((coordinatePermutation σ).symm (standardModeTranslate ν)) F t := by
  calc
    thirdModeFrequencyForm (permutedAnisotropy α σ) ν t
        (complexPermutedModelInput σ F) =
        -LiteralActiveModelSpatialProfile (permutedAnisotropy α σ) 2
          (standardModeTranslate ν) (complexPermutedModelInput σ F) t :=
      thirdModeFrequencyForm_eq_neg_LiteralActiveModelSpatialProfile
        (permutedAnisotropy α σ) ν t ht (complexPermutedModelInput σ F)
    _ = -LiteralActiveModelSpatialProfile α i
        ((coordinatePermutation σ).symm (standardModeTranslate ν)) F t := by
      rw [LiteralActiveModelSpatialProfile_permute_to_two α σ i
        ((coordinatePermutation σ).symm (standardModeTranslate ν)) F hσ]
      simp

/-- One localized positive Fourier mode with coefficient `a` is exactly the
literal third-active spatial mode with coefficient `-a`.  This is the sign
absorption in the coefficient `c_{i,ν}` of the source proof. -/
theorem thirdModeFrequencyMode_eq_LiteralActiveSpatialMode
    (α : Anisotropy) (ν : standardModeLattice) (t : ℝ) (ht : 0 < t)
    (a : ℂ) (F : ModelComplexSchwartzInput) :
    a * thirdModeFrequencyForm α ν t F =
      (-a) * LiteralActiveModelSpatialProfile α 2 (standardModeTranslate ν) F t := by
  rw [thirdModeFrequencyForm_eq_neg_LiteralActiveModelSpatialProfile
    α ν t ht F]
  ring

/-- The scale-integrated positive Fourier mode before passing through the
anisotropic-multiplier API. -/
noncomputable def thirdModeFrequencyFullForm
    (α : Anisotropy) (ν : standardModeLattice) (a : ℝ → ℂ)
    (F : ModelComplexSchwartzInput) : ℂ :=
  ∫ t in Set.Ioi (0 : ℝ), a t * thirdModeFrequencyForm α ν t F
    ∂((volume : Measure ℝ).withDensity cubeScaleDensity)

/-- A complete localized positive Fourier mode is exactly a literal
third-active model form with the negated coefficient.  Thus the source
coefficient `c_{i,ν}` is obtained from a Fourier coefficient by precisely
this sign change (and its stated positive normalization). -/
theorem thirdModeFrequencyFullForm_eq_LiteralActiveModelFullForm
    (α : Anisotropy) (ν : standardModeLattice) (a : ℝ → ℂ)
    (F : ModelComplexSchwartzInput) :
    thirdModeFrequencyFullForm α ν a F =
      LiteralActiveModelFullForm α 2 (standardModeTranslate ν) (-a) F := by
  unfold thirdModeFrequencyFullForm LiteralActiveModelFullForm
    LiteralComplexActiveInternal.scratch_LiteralActiveModelFullForm
  apply setIntegral_congr_fun measurableSet_Ioi
  intro t ht
  change a t * thirdModeFrequencyForm α ν t F =
    (-a) t * LiteralActiveModelSpatialProfile α 2 (standardModeTranslate ν) F t
  simpa only [Pi.neg_apply] using
    thirdModeFrequencyMode_eq_LiteralActiveSpatialMode α ν t ht (a t) F

/-- The scale-integrated one-mode bridge in any active coordinate.  The mode
is written in the permuted coordinates in which that active coordinate is
the third coordinate. -/
theorem thirdModeFrequencyFullForm_eq_LiteralActiveModelFullForm_permuted
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (hσ : σ 2 = i) (ν : standardModeLattice) (a : ℝ → ℂ)
    (F : ModelComplexSchwartzInput) :
    thirdModeFrequencyFullForm (permutedAnisotropy α σ) ν a
      (complexPermutedModelInput σ F) =
      LiteralActiveModelFullForm α i
        ((coordinatePermutation σ).symm (standardModeTranslate ν)) (-a) F := by
  calc
    thirdModeFrequencyFullForm (permutedAnisotropy α σ) ν a
        (complexPermutedModelInput σ F) =
        LiteralActiveModelFullForm (permutedAnisotropy α σ) 2
          (standardModeTranslate ν) (-a) (complexPermutedModelInput σ F) :=
      thirdModeFrequencyFullForm_eq_LiteralActiveModelFullForm
        (permutedAnisotropy α σ) ν a (complexPermutedModelInput σ F)
    _ = LiteralModelFullForm (permutedAnisotropy α σ)
        (standardModeTranslate ν) (-a) (complexPermutedModelInput σ F) :=
      LiteralActiveModelFullForm_two (permutedAnisotropy α σ)
        (standardModeTranslate ν) (-a) (complexPermutedModelInput σ F)
    _ = LiteralActiveModelFullForm α i
        ((coordinatePermutation σ).symm (standardModeTranslate ν)) (-a) F := by
      simpa using
        (LiteralActiveModelFullForm_permute_to_third α σ i
          ((coordinatePermutation σ).symm (standardModeTranslate ν)) (-a) F hσ).symm

/-- Conditional `multiplierForm` version of the one-mode spatial bridge.
The sole additional premise is the standard anisotropic multiplier certificate
for the localized mode symbol; Section 8's derivative package is intended to
supply this certificate. -/
theorem thirdModeMultiplier_eq_LiteralActiveSpatialMode
    (α : Anisotropy) (M : ℝ) (ν : standardModeLattice) (t : ℝ) (ht : 0 < t)
    (hm : Anisotropy.IsAnisotropicMultiplier α M
      (thirdModeFrequencySymbol α ν t))
    (a : ℂ) (F : ModelComplexSchwartzInput) :
    a * multiplierForm (thirdModeFrequencySymbol α ν t)
      (F 0) (F 1) (F 2) (F 3) =
      (-a) * LiteralActiveModelSpatialProfile α 2 (standardModeTranslate ν) F t := by
  rw [multiplierForm_eq_frequencyForm α M
    (thirdModeFrequencySymbol α ν t) hm (F 0) (F 1) (F 2) (F 3)]
  exact thirdModeFrequencyMode_eq_LiteralActiveSpatialMode α ν t ht a F

/-- The scale-integrated localized mode expressed via the existing
`multiplierForm` interface. -/
noncomputable def thirdModeMultiplierFullForm
    (α : Anisotropy) (ν : standardModeLattice) (a : ℝ → ℂ)
    (F : ModelComplexSchwartzInput) : ℂ :=
  ∫ t in Set.Ioi (0 : ℝ), a t *
      multiplierForm (thirdModeFrequencySymbol α ν t)
        (F 0) (F 1) (F 2) (F 3)
    ∂((volume : Measure ℝ).withDensity cubeScaleDensity)

/-- Conditional source-facing one-mode bridge through `multiplierForm`.
The only premise is a uniform localized multiplier certificate at positive
scales; no spatial/Fourier interchange remains. -/
theorem thirdModeMultiplierFullForm_eq_LiteralActiveModelFullForm
    (α : Anisotropy) (M : ℝ) (ν : standardModeLattice) (a : ℝ → ℂ)
    (F : ModelComplexSchwartzInput)
    (hm : ∀ t : ℝ, 0 < t → Anisotropy.IsAnisotropicMultiplier α M
      (thirdModeFrequencySymbol α ν t)) :
    thirdModeMultiplierFullForm α ν a F =
      LiteralActiveModelFullForm α 2 (standardModeTranslate ν) (-a) F := by
  unfold thirdModeMultiplierFullForm LiteralActiveModelFullForm
    LiteralComplexActiveInternal.scratch_LiteralActiveModelFullForm
  apply setIntegral_congr_fun measurableSet_Ioi
  intro t ht
  change a t * multiplierForm (thirdModeFrequencySymbol α ν t)
      (F 0) (F 1) (F 2) (F 3) =
    (-a) t * LiteralActiveModelSpatialProfile α 2 (standardModeTranslate ν) F t
  simpa only [Pi.neg_apply] using
    thirdModeMultiplier_eq_LiteralActiveSpatialMode α M ν t ht (hm t ht) (a t) F

/-- Conditional any-active-coordinate version of the source-facing
one-mode `multiplierForm` bridge. -/
theorem thirdModeMultiplierFullForm_eq_LiteralActiveModelFullForm_permuted
    (α : Anisotropy) (M : ℝ) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (hσ : σ 2 = i) (ν : standardModeLattice) (a : ℝ → ℂ)
    (F : ModelComplexSchwartzInput)
    (hm : ∀ t : ℝ, 0 < t → Anisotropy.IsAnisotropicMultiplier
      (permutedAnisotropy α σ) M
      (thirdModeFrequencySymbol (permutedAnisotropy α σ) ν t)) :
    thirdModeMultiplierFullForm (permutedAnisotropy α σ) ν a
      (complexPermutedModelInput σ F) =
      LiteralActiveModelFullForm α i
        ((coordinatePermutation σ).symm (standardModeTranslate ν)) (-a) F := by
  calc
    thirdModeMultiplierFullForm (permutedAnisotropy α σ) ν a
        (complexPermutedModelInput σ F) =
        LiteralActiveModelFullForm (permutedAnisotropy α σ) 2
          (standardModeTranslate ν) (-a) (complexPermutedModelInput σ F) :=
      thirdModeMultiplierFullForm_eq_LiteralActiveModelFullForm
        (permutedAnisotropy α σ) M ν a (complexPermutedModelInput σ F) hm
    _ = LiteralModelFullForm (permutedAnisotropy α σ)
        (standardModeTranslate ν) (-a) (complexPermutedModelInput σ F) :=
      LiteralActiveModelFullForm_two (permutedAnisotropy α σ)
        (standardModeTranslate ν) (-a) (complexPermutedModelInput σ F)
    _ = LiteralActiveModelFullForm α i
        ((coordinatePermutation σ).symm (standardModeTranslate ν)) (-a) F := by
      simpa using
        (LiteralActiveModelFullForm_permute_to_third α σ i
          ((coordinatePermutation σ).symm (standardModeTranslate ν)) (-a) F hσ).symm

/-! ## Literal unit-torus Fourier coefficients

This package is the source-facing bridge from the periodized localized symbol
to its literal compact raw cube, followed by coordinatewise Fourier decay.
The internal one-dimensional estimate is stated first. -/

theorem scratch_fourierCoeffOn_of_hasDerivAt_zeroBoundary
    {a b : ℝ} (hab : a < b) {f f' : ℝ → ℂ} {n : ℤ} (hn : n ≠ 0)
    (hf : ∀ x ∈ Set.uIcc a b, HasDerivAt f (f' x) x)
    (hf' : IntervalIntegrable f' volume a b)
    (hboundary : f b = f a) :
    fourierCoeffOn hab f n =
      -(1 / (-2 * Real.pi * Complex.I * n)) *
        ((b - a) * fourierCoeffOn hab f' n) := by
  rw [fourierCoeffOn_of_hasDerivAt hab hn hf hf', hboundary, sub_self, mul_zero, zero_sub]
  ring_nf

theorem scratch_norm_fourierCoeffOn_of_hasDerivAt_zeroBoundary
    {a b : ℝ} (hab : a < b) {f f' : ℝ → ℂ} {n : ℤ} (hn : n ≠ 0)
    (hf : ∀ x ∈ Set.uIcc a b, HasDerivAt f (f' x) x)
    (hf' : IntervalIntegrable f' volume a b)
    (hboundary : f b = f a) :
    ‖fourierCoeffOn hab f n‖ =
      ‖1 / (-2 * Real.pi * Complex.I * n)‖ * |b - a| * ‖fourierCoeffOn hab f' n‖ := by
  rw [scratch_fourierCoeffOn_of_hasDerivAt_zeroBoundary hab hn hf hf' hboundary]
  simp only [norm_neg, norm_mul]
  have hcast : (↑b : ℂ) - ↑a = ↑(b - a) := by push_cast; ring
  rw [hcast, Complex.norm_real, Real.norm_eq_abs]
  ring

theorem scratch_norm_fourierCoeffOn_le_of_norm_le
    {a b C : ℝ} (hab : a < b) {f : ℝ → ℂ} (n : ℤ)
    (hf : ∀ x ∈ Set.uIoc a b, ‖f x‖ ≤ C) :
    ‖fourierCoeffOn hab f n‖ ≤ C := by
  have hperiod : Fact (0 < b - a) := ⟨by linarith⟩
  letI : Fact (0 < b - a) := hperiod
  rw [fourierCoeffOn_eq_integral]
  have hint : ‖∫ x in a..b,
      fourier (-n) (x : AddCircle (b - a)) • f x‖ ≤ C * |b - a| := by
    apply intervalIntegral.norm_integral_le_of_norm_le_const
    intro x hx
    have hfourier : ‖fourier (-n) (x : AddCircle (b - a))‖ = 1 := Circle.norm_coe _
    rw [norm_smul, hfourier, one_mul]
    exact hf x hx
  rw [norm_smul, Real.norm_eq_abs]
  calc
    |1 / (b - a)| * ‖∫ x in a..b,
        fourier (-n) (x : AddCircle (b - a)) • f x‖ ≤
        |1 / (b - a)| * (C * |b - a|) :=
      mul_le_mul_of_nonneg_left hint (abs_nonneg _)
    _ = C := by
      rw [abs_of_pos (by positivity : 0 < b - a)]
      rw [abs_of_pos (by positivity : 0 < 1 / (b - a))]
      calc
        1 / (b - a) * (C * (b - a)) =
            C * ((b - a)⁻¹ * (b - a)) := by rw [one_div]; ring
        _ = C := by rw [inv_mul_cancel₀ (ne_of_gt (sub_pos.mpr hab)), mul_one]

theorem scratch_norm_fourier_antideriv_factor (n : ℤ) :
    ‖1 / (-2 * Real.pi * Complex.I * n)‖ =
      (2 * Real.pi * |(n : ℝ)|)⁻¹ := by
  rw [one_div, norm_inv, norm_mul, norm_mul, norm_mul]
  have htwoC : ‖(2 : ℂ)‖ = (2 : ℝ) := by norm_num
  rw [norm_neg, htwoC, Complex.norm_real, Complex.norm_I, Complex.norm_intCast]
  simp only [Real.norm_eq_abs]
  rw [abs_of_pos Real.pi_pos]
  simp

theorem scratch_norm_fourierCoeffOn_le_of_deriv_bound
    {a b C : ℝ} (hab : a < b) {f f' : ℝ → ℂ} {n : ℤ} (hn : n ≠ 0)
    (hf : ∀ x ∈ Set.uIcc a b, HasDerivAt f (f' x) x)
    (hf' : IntervalIntegrable f' volume a b)
    (hboundary : f b = f a)
    (hbound : ∀ x ∈ Set.uIoc a b, ‖f' x‖ ≤ C) :
    ‖fourierCoeffOn hab f n‖ ≤
      (2 * Real.pi * |(n : ℝ)|)⁻¹ * |b - a| * C := by
  rw [scratch_norm_fourierCoeffOn_of_hasDerivAt_zeroBoundary
    hab hn hf hf' hboundary, scratch_norm_fourier_antideriv_factor]
  exact mul_le_mul_of_nonneg_left
    (scratch_norm_fourierCoeffOn_le_of_norm_le hab n hbound)
    (mul_nonneg (inv_nonneg.mpr (by positivity)) (abs_nonneg _))

theorem scratch_norm_fourierCoeffOn_le_of_four_deriv_bound
    {a b C : ℝ} (hab : a < b) {f0 f1 f2 f3 f4 : ℝ → ℂ} {n : ℤ} (hn : n ≠ 0)
    (h0 : ∀ x ∈ Set.uIcc a b, HasDerivAt f0 (f1 x) x)
    (h1 : ∀ x ∈ Set.uIcc a b, HasDerivAt f1 (f2 x) x)
    (h2 : ∀ x ∈ Set.uIcc a b, HasDerivAt f2 (f3 x) x)
    (h3 : ∀ x ∈ Set.uIcc a b, HasDerivAt f3 (f4 x) x)
    (hi1 : IntervalIntegrable f1 volume a b)
    (hi2 : IntervalIntegrable f2 volume a b)
    (hi3 : IntervalIntegrable f3 volume a b)
    (hi4 : IntervalIntegrable f4 volume a b)
    (hb0 : f0 b = f0 a) (hb1 : f1 b = f1 a)
    (hb2 : f2 b = f2 a) (hb3 : f3 b = f3 a)
    (hbound : ∀ x ∈ Set.uIoc a b, ‖f4 x‖ ≤ C) :
    ‖fourierCoeffOn hab f0 n‖ ≤
      ((2 * Real.pi * |(n : ℝ)|)⁻¹ * |b - a|) ^ 4 * C := by
  let d : ℝ := (2 * Real.pi * |(n : ℝ)|)⁻¹ * |b - a|
  have hd : 0 ≤ d := mul_nonneg (inv_nonneg.mpr (by positivity)) (abs_nonneg _)
  have h4 : ‖fourierCoeffOn hab f4 n‖ ≤ C :=
    scratch_norm_fourierCoeffOn_le_of_norm_le hab n hbound
  have heq3 : ‖fourierCoeffOn hab f3 n‖ = d * ‖fourierCoeffOn hab f4 n‖ := by
    rw [show d = ‖1 / (-2 * Real.pi * Complex.I * n)‖ * |b - a| by
      rw [scratch_norm_fourier_antideriv_factor]]
    exact scratch_norm_fourierCoeffOn_of_hasDerivAt_zeroBoundary hab hn h3 hi4 hb3
  have h3bound : ‖fourierCoeffOn hab f3 n‖ ≤ d * C := by
    rw [heq3]
    exact mul_le_mul_of_nonneg_left h4 hd
  have heq2 : ‖fourierCoeffOn hab f2 n‖ = d * ‖fourierCoeffOn hab f3 n‖ := by
    rw [show d = ‖1 / (-2 * Real.pi * Complex.I * n)‖ * |b - a| by
      rw [scratch_norm_fourier_antideriv_factor]]
    exact scratch_norm_fourierCoeffOn_of_hasDerivAt_zeroBoundary hab hn h2 hi3 hb2
  have h2bound : ‖fourierCoeffOn hab f2 n‖ ≤ d * (d * C) := by
    rw [heq2]
    exact mul_le_mul_of_nonneg_left h3bound hd
  have heq1 : ‖fourierCoeffOn hab f1 n‖ = d * ‖fourierCoeffOn hab f2 n‖ := by
    rw [show d = ‖1 / (-2 * Real.pi * Complex.I * n)‖ * |b - a| by
      rw [scratch_norm_fourier_antideriv_factor]]
    exact scratch_norm_fourierCoeffOn_of_hasDerivAt_zeroBoundary hab hn h1 hi2 hb1
  have h1bound : ‖fourierCoeffOn hab f1 n‖ ≤ d * (d * (d * C)) := by
    rw [heq1]
    exact mul_le_mul_of_nonneg_left h2bound hd
  have heq0 : ‖fourierCoeffOn hab f0 n‖ = d * ‖fourierCoeffOn hab f1 n‖ := by
    rw [show d = ‖1 / (-2 * Real.pi * Complex.I * n)‖ * |b - a| by
      rw [scratch_norm_fourier_antideriv_factor]]
    exact scratch_norm_fourierCoeffOn_of_hasDerivAt_zeroBoundary hab hn h0 hi1 hb0
  rw [heq0]
  calc
    d * ‖fourierCoeffOn hab f1 n‖ ≤ d * (d * (d * (d * C))) :=
      mul_le_mul_of_nonneg_left h1bound hd
    _ = d ^ 4 * C := by ring

/-- The open representative of the unit Fourier fundamental cube. -/
def scratch_unitOpenCube : Set (Fin 3 → ℝ) :=
  Set.pi Set.univ (fun _ : Fin 3 ↦ Set.Ioo (-(1 / 2 : ℝ)) (1 / 2 : ℝ))

/-- The half-open representative selected by the torus Fourier API. -/
def scratch_unitIocCube : Set (Fin 3 → ℝ) :=
  Set.pi Set.univ (fun _ : Fin 3 ↦ Set.Ioc (-(1 / 2 : ℝ)) (1 / 2 : ℝ))

theorem scratch_unitOpenCube_measurable : MeasurableSet scratch_unitOpenCube := by
  unfold scratch_unitOpenCube
  exact MeasurableSet.univ_pi fun _ ↦ measurableSet_Ioo

theorem scratch_unitIocCube_measurable : MeasurableSet scratch_unitIocCube := by
  unfold scratch_unitIocCube
  exact MeasurableSet.univ_pi fun _ ↦ measurableSet_Ioc

theorem scratch_unitOpenCube_ae_eq_unitIocCube :
    scratch_unitOpenCube =ᵐ[volume] scratch_unitIocCube := by
  unfold scratch_unitOpenCube scratch_unitIocCube
  rw [volume_pi]
  exact Measure.pi_Ioo_ae_eq_pi_Ioc

/-- On the open unit cube, the unit-torus periodization is exactly the
localized raw symbol under the visible scale-eight map. -/
theorem scratch_unitTorusLocalizedSymbol_coe_scaled_openCube
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    (u : Fin 3 → ℝ)
    (hu : ∀ j : Fin 3, u j ∈ Set.Ioo (-(1 / 2 : ℝ)) (1 / 2 : ℝ)) :
    unitTorusLocalizedSymbol α m i t (fun j ↦ (u j : UnitAddCircle)) =
      localizedSymbolRaw α m i t (8 * u 0) (8 * u 1) (8 * u 2) := by
  have hu₀ : 8 * u 0 ∈ Set.Ico (-4 : ℝ) 4 := by
    constructor <;> nlinarith [(hu 0).1, (hu 0).2]
  have hu₁ : 8 * u 1 ∈ Set.Ico (-4 : ℝ) 4 := by
    constructor <;> nlinarith [(hu 1).1, (hu 1).2]
  have hu₂ : 8 * u 2 ∈ Set.Ico (-4 : ℝ) 4 := by
    constructor <;> nlinarith [(hu 2).1, (hu 2).2]
  have hpoint : (fun j ↦ (u j : UnitAddCircle)) =
      unitTorusPoint (8 * u 0) (8 * u 1) (8 * u 2) := by
    unfold unitTorusPoint
    funext j
    change (u j : UnitAddCircle) =
      ((![8 * u 0 / 8, 8 * u 1 / 8, 8 * u 2 / 8] j : ℝ) : UnitAddCircle)
    have hvec : (![8 * u 0 / 8, 8 * u 1 / 8, 8 * u 2 / 8] : Fin 3 → ℝ) = u := by
      funext k
      fin_cases k <;> simp
    rw [hvec]
  rw [hpoint]
  exact unitTorusLocalizedSymbol_coe_div α m i t hu₀ hu₁ hu₂

theorem scratch_ae_unitTorusLocalizedSymbol_coe_scaled
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ) :
    ∀ᵐ u : Fin 3 → ℝ ∂volume.restrict scratch_unitIocCube,
      unitTorusLocalizedSymbol α m i t (fun j ↦ (u j : UnitAddCircle)) =
        localizedSymbolRaw α m i t (8 * u 0) (8 * u 1) (8 * u 2) := by
  rw [← Measure.restrict_congr_set scratch_unitOpenCube_ae_eq_unitIocCube]
  refine ae_restrict_of_forall_mem scratch_unitOpenCube_measurable fun u hu ↦ ?_
  apply scratch_unitTorusLocalizedSymbol_coe_scaled_openCube
  intro j
  exact hu j (Set.mem_univ j)

theorem scratch_mFourierCoeff_unitTorusLocalizedSymbol_eq_unitCube
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    (ν : Fin 3 → ℤ) :
    UnitAddTorus.mFourierCoeff (unitTorusLocalizedSymbol α m i t) ν =
      ∫ u : Fin 3 → ℝ in
        {u : Fin 3 → ℝ | ∀ j : Fin 3,
          u j ∈ Set.Ioc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)},
        UnitAddTorus.mFourier (-ν) (fun j ↦ (u j : UnitAddCircle)) •
          unitTorusLocalizedSymbol α m i t (fun j ↦ (u j : UnitAddCircle)) := by
  have hendpoint : -(1 / 2 : ℝ) + 1 = 1 / 2 := by norm_num
  simpa only [hendpoint] using
    UnitAddTorus.mFourierCoeff_eq_integral
      (unitTorusLocalizedSymbol α m i t) ν (fun _ : Fin 3 ↦ -(1 / 2 : ℝ))

/-- Exact raw half-open cube formula for a torus coefficient. -/
theorem scratch_mFourierCoeff_unitTorusLocalizedSymbol_eq_raw_unitCube
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t : ℝ)
    (ν : Fin 3 → ℤ) :
    UnitAddTorus.mFourierCoeff (unitTorusLocalizedSymbol α m i t) ν =
      ∫ u : Fin 3 → ℝ in scratch_unitIocCube,
        UnitAddTorus.mFourier (-ν) (fun j ↦ (u j : UnitAddCircle)) •
          localizedSymbolRaw α m i t (8 * u 0) (8 * u 1) (8 * u 2) := by
  rw [scratch_mFourierCoeff_unitTorusLocalizedSymbol_eq_unitCube]
  have hcube : scratch_unitIocCube =
      {u : Fin 3 → ℝ | ∀ j : Fin 3,
        u j ∈ Set.Ioc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)} := by
    ext u
    simp [scratch_unitIocCube, Set.pi]
  rw [← hcube]
  change ∫ u : Fin 3 → ℝ in scratch_unitIocCube,
      UnitAddTorus.mFourier (-ν) (fun j ↦ (u j : UnitAddCircle)) •
        unitTorusLocalizedSymbol α m i t (fun j ↦ (u j : UnitAddCircle)) = _
  refine setIntegral_congr_ae scratch_unitIocCube_measurable ?_
  refine (ae_restrict_iff' scratch_unitIocCube_measurable).mp ?_
  filter_upwards [scratch_ae_unitTorusLocalizedSymbol_coe_scaled α m i t] with u hu
  rw [hu]

theorem scratch_iteratedDeriv_eq_zero_on_open
    (f : ℝ → ℂ) (U : Set ℝ) (hU : IsOpen U)
    (hzero : ∀ x ∈ U, f x = 0) :
    ∀ n : ℕ, ∀ x ∈ U, iteratedDeriv n f x = 0 := by
  intro n
  induction n with
  | zero =>
      intro x hx
      simpa using hzero x hx
  | succ n hn =>
      intro x hx
      rw [iteratedDeriv_succ]
      apply deriv_zero_of_frequently_const
      have hmem : ∀ᶠ y in 𝓝 x, y ∈ U := hU.mem_nhds hx
      have hmem' : ∀ᶠ y in 𝓝[≠] x, y ∈ U :=
        hmem.filter_mono nhdsWithin_le_nhds
      exact (hmem'.mono fun y hy ↦ hn y hy).frequently

theorem scratch_iteratedDeriv_eq_zero_unitBoundary_of_contDiff
    (N k : ℕ) (f : ℝ → ℂ) (hf : ContDiff ℝ N f) (hk : k ≤ N)
    (hzero : ∀ x : ℝ, (1 / 2 : ℝ) < |x| → f x = 0) :
    iteratedDeriv k f (-(1 / 2 : ℝ)) = 0 ∧
      iteratedDeriv k f (1 / 2 : ℝ) = 0 := by
  let U : Set ℝ := {x : ℝ | (1 / 2 : ℝ) < |x|}
  have hU : IsOpen U := by
    exact isOpen_lt continuous_const continuous_abs
  have hzeroU : ∀ x ∈ U, f x = 0 := by
    intro x hx
    exact hzero x hx
  have hiter : ∀ x ∈ U, iteratedDeriv k f x = 0 :=
    scratch_iteratedDeriv_eq_zero_on_open f U hU hzeroU k
  have hcont : Continuous (iteratedDeriv k f) :=
    hf.continuous_iteratedDeriv k (by exact_mod_cast hk)
  have hclosed : IsClosed ((iteratedDeriv k f) ⁻¹' ({0} : Set ℂ)) :=
    isClosed_singleton.preimage hcont
  have hsubset : U ⊆ (iteratedDeriv k f) ⁻¹' ({0} : Set ℂ) := by
    intro x hx
    simpa using hiter x hx
  have hpos : (1 / 2 : ℝ) ∈ closure U := by
    have hIoi : Set.Ioi (1 / 2 : ℝ) ⊆ U := by
      intro x hx
      exact lt_of_lt_of_le hx (le_abs_self x)
    apply (closure_mono hIoi)
    rw [closure_Ioi]
    exact Set.mem_Ici.mpr le_rfl
  have hneg : (-(1 / 2 : ℝ)) ∈ closure U := by
    have hIio : Set.Iio (-(1 / 2 : ℝ)) ⊆ U := by
      intro x hx
      change x < -(1 / 2 : ℝ) at hx
      have hminus : (1 / 2 : ℝ) < -x := by linarith
      exact lt_of_lt_of_le hminus (neg_le_abs x)
    apply (closure_mono hIio)
    rw [closure_Iio]
    exact Set.mem_Iic.mpr le_rfl
  have hclosure : closure U ⊆ (iteratedDeriv k f) ⁻¹' ({0} : Set ℂ) :=
    closure_minimal hsubset hclosed
  constructor
  · simpa using hclosure hneg
  · simpa using hclosure hpos

theorem scratch_contDiff_raw_first_scaled
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t) (y z : ℝ) :
    ContDiff ℝ 110 (fun x : ℝ ↦
      localizedSymbolRaw α m i t (8 * x) y z) := by
  change ContDiff ℝ 110
    (localizedSymbol α m i t ∘ fun x : ℝ ↦ frequencyAssemble3 (8 * x) y z)
  let L : ℝ →L[ℝ] E3 :=
    (ContinuousLinearMap.id ℝ ℝ).smulRight (Anisotropy.coordinateDirection 0)
  have hslice : (fun x : ℝ ↦ frequencyAssemble3 (8 * x) y z) =
      fun x : ℝ ↦ L (8 * x) + frequencyAssemble3 0 y z := by
    funext x
    ext j
    fin_cases j <;>
      simp [L, frequencyAssemble3_apply, coordinateDirection_apply]
  rw [hslice]
  apply (localizedSymbol_contDiff α M m hm i ht).comp
  fun_prop

theorem scratch_raw_first_scaled_eq_zero_of_abs_ge_half
    (α : Anisotropy) (m : E3 → ℂ) (i : Fin 3) (t y z x : ℝ)
    (hx : (1 / 2 : ℝ) ≤ |x|) :
    localizedSymbolRaw α m i t (8 * x) y z = 0 := by
  apply localizedSymbolRaw_eq_zero_of_coordinate_large α m i 0 t
  change 3 ≤ |8 * x|
  rw [abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 8)]
  nlinarith

theorem scratch_iteratedDeriv_raw_first_scaled_unitBoundary
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t) (y z : ℝ) (k : ℕ) (hk : k ≤ 110) :
    iteratedDeriv k (fun x : ℝ ↦
      localizedSymbolRaw α m i t (8 * x) y z) (-(1 / 2 : ℝ)) = 0 ∧
      iteratedDeriv k (fun x : ℝ ↦
        localizedSymbolRaw α m i t (8 * x) y z) (1 / 2 : ℝ) = 0 := by
  apply scratch_iteratedDeriv_eq_zero_unitBoundary_of_contDiff 110 k
  · exact scratch_contDiff_raw_first_scaled α M m hm i ht y z
  · exact hk
  · intro x hx
    exact scratch_raw_first_scaled_eq_zero_of_abs_ge_half α m i t y z x (le_of_lt hx)

theorem scratch_norm_fourierCoeffOn_raw_first_scaled_le_of_fourth_bound
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t) (y z C : ℝ)
    (n : ℤ) (hn : n ≠ 0)
    (hbound : ∀ x ∈ Set.Ioc (-(1 / 2 : ℝ)) (1 / 2 : ℝ),
      ‖iteratedDeriv 4 (fun r : ℝ ↦
        localizedSymbolRaw α m i t (8 * r) y z) x‖ ≤ C) :
    ‖fourierCoeffOn (by norm_num : -(1 / 2 : ℝ) < 1 / 2)
      (fun r : ℝ ↦ localizedSymbolRaw α m i t (8 * r) y z) n‖ ≤
      (2 * Real.pi * |(n : ℝ)|)⁻¹ ^ 4 * C := by
  let f : ℝ → ℂ := fun r ↦ localizedSymbolRaw α m i t (8 * r) y z
  have hf : ContDiff ℝ 110 f :=
    scratch_contDiff_raw_first_scaled α M m hm i ht y z
