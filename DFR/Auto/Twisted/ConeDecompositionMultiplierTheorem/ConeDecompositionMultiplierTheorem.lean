/-- Every point in the extended region has the strictly interior simplex
used by the four endpoint estimates. -/
theorem exists_exponentSimplex
    {β0 β1 β2 β3 : ℝ}
    (h : ExtendedModelRegion β0 β1 β2 β3) :
    Nonempty (ExponentSimplex β0 β1 β2 β3) := by
  rcases h with ⟨h0, h1, h2, h3, hsum, h0small, h3large,
    h12, h13, h23⟩
  let c1 : ℝ := min β1 (1 / 4)
  let c2 : ℝ := min β2 (1 / 4)
  let c3 : ℝ := min β3 (1 / 2)
  let S : ℝ := c1 + c2 + c3
  have hc1pos : 0 < c1 := by
    dsimp [c1]
    exact lt_min h1 (by norm_num)
  have hc2pos : 0 < c2 := by
    dsimp [c2]
    exact lt_min h2 (by norm_num)
  have hc3pos : 0 < c3 := by
    dsimp [c3]
    exact lt_min h3 (by norm_num)
  have hSgt : 3 / 4 < S := by
    dsimp [S, c1, c2, c3]
    exact cappedExponentSum_gt_three_quarters
      ⟨h0, h1, h2, h3, hsum, h0small, h3large, h12, h13, h23⟩
  have hc1le : c1 ≤ β1 := by
    dsimp [c1]
    exact min_le_left _ _
  have hc2le : c2 ≤ β2 := by
    dsimp [c2]
    exact min_le_left _ _
  have hc3le : c3 ≤ β3 := by
    dsimp [c3]
    exact min_le_left _ _
  have hSlt : S < 1 := by
    dsimp [S]
    linarith
  let δ : ℝ := min c1 (min c2 (min c3 ((S - 3 / 4) / 3)))
  have hδpos : 0 < δ := by
    dsimp [δ]
    refine lt_min hc1pos ?_
    refine lt_min hc2pos ?_
    refine lt_min hc3pos ?_
    linarith
  let ε : ℝ := δ / 2
  have hεpos : 0 < ε := by
    dsimp [ε]
    linarith
  have hεc1 : ε < c1 := by
    have hδc1 : δ ≤ c1 := by
      dsimp [δ]
      exact min_le_left _ _
    dsimp [ε]
    linarith
  have hεc2 : ε < c2 := by
    have hδc2 : δ ≤ c2 := by
      dsimp [δ]
      exact le_trans (min_le_right _ _) (min_le_left _ _)
    dsimp [ε]
    linarith
  have hεc3 : ε < c3 := by
    have hδc3 : δ ≤ c3 := by
      dsimp [δ]
      exact le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
    dsimp [ε]
    linarith
  have hthreeε : 3 * ε < S - 3 / 4 := by
    have hδgap : δ ≤ (S - 3 / 4) / 3 := by
      dsimp [δ]
      exact le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _))
    dsimp [ε]
    linarith
  let b1 : ℝ := c1 - ε
  let b2 : ℝ := c2 - ε
  let b3 : ℝ := c3 - ε
  let b0 : ℝ := 1 - (b1 + b2 + b3)
  have hb1pos : 0 < b1 := by dsimp [b1]; linarith
  have hb2pos : 0 < b2 := by dsimp [b2]; linarith
  have hb3pos : 0 < b3 := by dsimp [b3]; linarith
  have hsum_b123 : b1 + b2 + b3 = S - 3 * ε := by
    dsimp [b1, b2, b3, S]
    ring
  have hb0eq : b0 = 1 - S + 3 * ε := by
    dsimp [b0]
    rw [hsum_b123]
    ring
  have hb0gt : β0 < b0 := by
    rw [hb0eq]
    linarith
  have hb0lt : b0 < 1 / 4 := by
    rw [hb0eq]
    linarith
  have hb0pos : 0 < b0 := by linarith
  have hb1lt : b1 < β1 := by
    dsimp [b1]
    linarith
  have hb1quarter : b1 < 1 / 4 := by
    have hc1quarter : c1 ≤ 1 / 4 := by
      dsimp [c1]
      exact min_le_right _ _
    dsimp [b1]
    linarith
  have hb2lt : b2 < β2 := by
    dsimp [b2]
    linarith
  have hb2quarter : b2 < 1 / 4 := by
    have hc2quarter : c2 ≤ 1 / 4 := by
      dsimp [c2]
      exact min_le_right _ _
    dsimp [b2]
    linarith
  have hb3lt : b3 < β3 := by
    dsimp [b3]
    linarith
  have hb3half : b3 < 1 / 2 := by
    have hc3half : c3 ≤ 1 / 2 := by
      dsimp [c3]
      exact min_le_right _ _
    dsimp [b3]
    linarith
  have hsum_b0 : b0 + b1 + b2 + b3 = 1 := by
    dsimp [b0]
    ring
  have hb3quarter : 1 / 4 < b3 := by
    linarith
  exact ⟨⟨b0, b1, b2, b3, hb0pos, hb0gt, hb0lt,
    hb1pos, hb1lt, hb1quarter, hb2pos, hb2lt, hb2quarter,
