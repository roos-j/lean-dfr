/-- Public uniform first-coordinate degree-four Fourier coefficient decay. -/
theorem exists_mFourierCoeff_unitTorusLocalizedSymbol_first_fourth_decay
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
