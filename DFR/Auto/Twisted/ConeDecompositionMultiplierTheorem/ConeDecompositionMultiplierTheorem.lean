      ‖UnitAddTorus.mFourierCoeff (unitTorusLocalizedSymbol α m i t) ν‖ ≤
        (2 * Real.pi * |((ν 0 : ℤ) : ℝ)|)⁻¹ ^ 4 * (C * M) := by
  rcases scratch_exists_raw_first_scaled_fourth_deriv_bound α M m hm i ht with
    ⟨C, hC, hraw⟩
