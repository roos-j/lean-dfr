/-- The scale-eight last-coordinate raw slice is smooth through order 110. -/
theorem scratch_contDiff_raw_last_scaled
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t) (x y : ℝ) :
