    UnitAddTorus.mFourierCoeff (unitTorusLocalizedSymbol α m i t) ν =
      scratch_nestedRawUnitFourierCoeff α m i t ν :=
  scratch_mFourierCoeff_unitTorusLocalizedSymbol_eq_nestedRaw α M m hm i ht ν

/-- Public uniform first-coordinate degree-four Fourier coefficient decay. -/
theorem exists_mFourierCoeff_unitTorusLocalizedSymbol_first_fourth_decay
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
