theorem scratch_iteratedDeriv_raw_first_scaled_eq_iteratedFDeriv
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (i : Fin 3) {t : ℝ} (ht : 0 < t) (y z r : ℝ) :
