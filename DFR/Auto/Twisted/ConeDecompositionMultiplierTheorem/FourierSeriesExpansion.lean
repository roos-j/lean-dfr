        apply hfinish 1 C1 hC1 hC1D h1 hmax
        simpa only [scratch_intModeAbs] using hmiddle t ht ν h1
      · have h12 : scratch_intModeAbs ν 1 ≤ scratch_intModeAbs ν 2 :=
