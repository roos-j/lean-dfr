        have h02 : scratch_intModeAbs ν 0 ≤ scratch_intModeAbs ν 2 := h01.trans h12
        have hmax : ∀ k : Fin 3,
            scratch_intModeAbs ν k ≤ scratch_intModeAbs ν 2 := by
