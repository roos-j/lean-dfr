/-- The fixed-scale comparison behind the source's ancestor-size lower
bound: every point of a box sees at least the stated fraction of its
centered bracket kernel. -/
theorem scratch_boxCenterKernel_le_anisotropicBracketKernel
    (α : Anisotropy) (q : AnisoBox α) {p : E3}
    (hp : p ∈ boxClosedSet α q) (y : E3) :
    (2 / 3 : ℝ) ^ 30 *
        anisotropicBracketKernel α (boxLength q) (boxCenter α q) y ≤
      anisotropicBracketKernel α (boxLength q) p y := by
  have hfactor (i : Fin 3) :
      bracketKernelAt (boxLength q ^ α.weight i) (boxCenter α q i) (y i) ≤
        (3 / 2 : ℝ) ^ 10 *
          bracketKernelAt (boxLength q ^ α.weight i) (p i) (y i) := by
    have hcenter : |boxCenter α q i - p i| ≤ boxLength q ^ α.weight i / 2 := by
      rw [abs_sub_comm]
      simpa only [boxSide_eq_length_pow] using
        abs_sub_boxCenter_le_half_side α q hp i
    simpa using bracketKernelAt_le_of_scale_center
      (s := boxLength q ^ α.weight i)
      (L := boxLength q ^ α.weight i) (b := 1)
      (p := boxCenter α q i) (c := p i) (y := y i)
      (pow_pos (boxLength_pos q) _) (pow_pos (boxLength_pos q) _)
      (by simp) le_rfl hcenter
  have hprod :
      anisotropicBracketKernel α (boxLength q) (boxCenter α q) y ≤
        (3 / 2 : ℝ) ^ 30 *
          anisotropicBracketKernel α (boxLength q) p y := by
    unfold anisotropicBracketKernel
    calc
      (∏ i : Fin 3,
          bracketKernelAt (boxLength q ^ α.weight i) (boxCenter α q i) (y i)) ≤
          ∏ i : Fin 3, (3 / 2 : ℝ) ^ 10 *
            bracketKernelAt (boxLength q ^ α.weight i) (p i) (y i) := by
        apply Finset.prod_le_prod
        · intro i _
          exact bracketKernelAt_nonneg (pow_pos (boxLength_pos q) _).le
        · intro i _
          exact hfactor i
      _ = (3 / 2 : ℝ) ^ 30 *
          ∏ i : Fin 3,
            bracketKernelAt (boxLength q ^ α.weight i) (p i) (y i) := by
        rw [Finset.prod_mul_distrib]
        norm_num [Finset.prod_const, ← pow_mul]
  calc
    (2 / 3 : ℝ) ^ 30 *
        anisotropicBracketKernel α (boxLength q) (boxCenter α q) y ≤
        (2 / 3 : ℝ) ^ 30 *
          ((3 / 2 : ℝ) ^ 30 *
            anisotropicBracketKernel α (boxLength q) p y) :=
      mul_le_mul_of_nonneg_left hprod (pow_nonneg (by norm_num) _)
    _ = anisotropicBracketKernel α (boxLength q) p y := by
      norm_num
      ring

/-- The exponent-two local power of a box is controlled from below by the
same-scale bracket average at every point of that box. -/
theorem scratch_boxLocalPower_two_le_cubeSecondMoment
    (α : Anisotropy) (q : AnisoBox α) {p : E3}
    (hp : p ∈ boxClosedSet α q) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) :
    (2 / 3 : ℝ) ^ 30 * boxLocalPower α 2 f q ≤
      cubeSecondMoment α (boxLength q) p f := by
  rw [← cubeSecondMoment_at_box_eq_boxLocalPower_two α q f]
  let K₀ : E3 → ℝ :=
    anisotropicBracketKernel α (boxLength q) (boxCenter α q)
  let Kp : E3 → ℝ := anisotropicBracketKernel α (boxLength q) p
  have hleft : Integrable (fun y : E3 ↦
      (2 / 3 : ℝ) ^ 30 * (f y ^ 2 * K₀ y)) := by
    exact (integrable_cubeSecondMoment_integrand α (boxLength_pos q)
      (boxCenter α q) f hfcont hfbound).const_mul _
  have hright : Integrable (fun y : E3 ↦ f y ^ 2 * Kp y) := by
    exact integrable_cubeSecondMoment_integrand α (boxLength_pos q)
      p f hfcont hfbound
  have hpointwise (y : E3) :
      (2 / 3 : ℝ) ^ 30 * (f y ^ 2 * K₀ y) ≤ f y ^ 2 * Kp y := by
    have hkernel : (2 / 3 : ℝ) ^ 30 * K₀ y ≤ Kp y := by
      exact scratch_boxCenterKernel_le_anisotropicBracketKernel α q hp y
    calc
      (2 / 3 : ℝ) ^ 30 * (f y ^ 2 * K₀ y) =
          f y ^ 2 * ((2 / 3 : ℝ) ^ 30 * K₀ y) := by ring
      _ ≤ f y ^ 2 * Kp y :=
        mul_le_mul_of_nonneg_left hkernel (sq_nonneg _)
  change (2 / 3 : ℝ) ^ 30 *
      (∫ y : E3, f y ^ 2 * K₀ y) ≤ ∫ y : E3, f y ^ 2 * Kp y
  rw [← MeasureTheory.integral_const_mul]
  exact MeasureTheory.integral_mono_ae hleft hright
    (Filter.Eventually.of_forall hpointwise)

/-- The literal exponent-two anisotropic maximal power, before taking the
square root in the maximal size. -/
noncomputable def scratch_anisotropicMaximalTwoPower
    (α : Anisotropy) (f : E3 → ℝ) (p : E3) : ℝ :=
  sSup {a : ℝ | ∃ t : ℝ, 0 < t ∧ a = cubeSecondMoment α t p f}

noncomputable def scratch_anisotropicMaximalTwo
    (α : Anisotropy) (f : E3 → ℝ) (p : E3) : ℝ :=
  √(scratch_anisotropicMaximalTwoPower α f p)

/-- Bounded continuous inputs make the real supremum defining the local
maximal power bounded above. -/
theorem scratch_bddAbove_anisotropicMaximalTwoPower
    (α : Anisotropy) (f : E3 → ℝ) (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f y| ≤ B) (p : E3) :
    BddAbove {a : ℝ | ∃ t : ℝ, 0 < t ∧ a = cubeSecondMoment α t p f} := by
  refine ⟨B ^ 2 * (2 / 9 : ℝ) ^ 3, ?_⟩
  rintro a ⟨t, ht, rfl⟩
  let K : E3 → ℝ := anisotropicBracketKernel α t p
  have hleft : Integrable (fun y : E3 ↦ f y ^ 2 * K y) := by
    exact integrable_cubeSecondMoment_integrand α ht p f hfcont
      ⟨B, hB, hfB⟩
  have hright : Integrable (fun y : E3 ↦ B ^ 2 * K y) := by
    exact (integrable_anisotropicBracketKernel α ht p).const_mul _
  have hpointwise (y : E3) : f y ^ 2 * K y ≤ B ^ 2 * K y := by
    have hK : 0 ≤ K y := anisotropicBracketKernel_nonneg α ht.le p y
    have hf2 : f y ^ 2 ≤ B ^ 2 := by
      rw [← sq_abs]
      exact pow_le_pow_left₀ (abs_nonneg _) (hfB y) 2
    exact mul_le_mul_of_nonneg_right hf2 hK
  calc
    cubeSecondMoment α t p f = ∫ y : E3, f y ^ 2 * K y := by rfl
    _ ≤ ∫ y : E3, B ^ 2 * K y :=
      MeasureTheory.integral_mono_ae hleft hright
        (Filter.Eventually.of_forall hpointwise)
    _ = B ^ 2 * ∫ y : E3, K y := by
      rw [MeasureTheory.integral_const_mul]
    _ = B ^ 2 * (2 / 9 : ℝ) ^ 3 := by
      rw [integral_anisotropicBracketKernel α ht p]

theorem scratch_cubeSecondMoment_le_anisotropicMaximalTwoPower
    (α : Anisotropy) (f : E3 → ℝ) (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f y| ≤ B)
    (p : E3) {t : ℝ} (ht : 0 < t) :
    cubeSecondMoment α t p f ≤ scratch_anisotropicMaximalTwoPower α f p := by
  unfold scratch_anisotropicMaximalTwoPower
  apply le_csSup (scratch_bddAbove_anisotropicMaximalTwoPower
    α f hfcont B hB hfB p)
  exact ⟨t, ht, rfl⟩

/-- The source ancestor-size estimate in exponent-two power form. -/
theorem scratch_boxLocalPower_two_le_anisotropicMaximalTwoPower
    (α : Anisotropy) (q : AnisoBox α) {p : E3}
    (hp : p ∈ boxSet α q) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f y| ≤ B) :
    (2 / 3 : ℝ) ^ 30 * boxLocalPower α 2 f q ≤
      scratch_anisotropicMaximalTwoPower α f p := by
  exact (scratch_boxLocalPower_two_le_cubeSecondMoment α q
    (boxSet_subset_boxClosedSet α q hp) f hfcont ⟨B, hB, hfB⟩).trans
      (scratch_cubeSecondMoment_le_anisotropicMaximalTwoPower α f hfcont
        B hB hfB p (boxLength_pos q))

/-- The exponent-two maximal-size estimate in the exact square-root form
of `lem:maximal_size`. -/
theorem scratch_boxLocalSize_two_le_anisotropicMaximalTwo
    (α : Anisotropy) (q : AnisoBox α) {p : E3}
    (hp : p ∈ boxSet α q) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f y| ≤ B) :
    (2 / 3 : ℝ) ^ 15 * boxLocalSize α 2 f q ≤
      scratch_anisotropicMaximalTwo α f p := by
  have hsize : 0 ≤ boxLocalSize α 2 f q := by
    unfold boxLocalSize
    exact Real.rpow_nonneg (by
      unfold boxLocalPower
      apply integral_nonneg
      intro y
      exact mul_nonneg (Real.rpow_nonneg (abs_nonneg _) _)
        (anisotropicBracketKernel_nonneg α (boxLength_pos q).le
          (boxCenter α q) y)) _
  have hmax : 0 ≤ scratch_anisotropicMaximalTwoPower α f p := by
    calc
      0 ≤ cubeSecondMoment α 1 p f :=
        cubeSecondMoment_nonneg α (by norm_num) p f
      _ ≤ scratch_anisotropicMaximalTwoPower α f p :=
        scratch_cubeSecondMoment_le_anisotropicMaximalTwoPower α f hfcont
          B hB hfB p (by norm_num)
  apply (sq_le_sq₀
    (mul_nonneg (pow_nonneg (by norm_num) _) hsize)
    (Real.sqrt_nonneg _)).mp
  rw [Real.sq_sqrt hmax]
  calc
    ((2 / 3 : ℝ) ^ 15 * boxLocalSize α 2 f q) ^ 2 =
        (2 / 3 : ℝ) ^ 30 * boxLocalSize α 2 f q ^ 2 := by
      rw [mul_pow]
      norm_num [← pow_mul]
    _ = (2 / 3 : ℝ) ^ 30 * boxLocalPower α 2 f q := by
      rw [boxLocalSize_two_sq_eq_boxLocalPower]
    _ ≤ scratch_anisotropicMaximalTwoPower α f p :=
      scratch_boxLocalPower_two_le_anisotropicMaximalTwoPower α q hp f
        hfcont B hB hfB

end

