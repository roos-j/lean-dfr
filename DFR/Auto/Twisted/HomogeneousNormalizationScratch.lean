  have haPos : 0 < ∏ j : Fin 4, a j := by
    apply Finset.prod_pos
    intro j _
    dsimp only [a]
    exact inv_pos.mpr (hpos j)
  have haP : P * ∏ j : Fin 4, a j = 1 := by
    dsimp only [P, a]
