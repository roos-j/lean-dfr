/-- First expose the five passive model coordinates and then move the two
active fiber variables next to them.  This is the measure-theoretic core of
the remaining center-translation transport. -/
noncomputable def scratch_modelFiberPassiveActiveReorder :
    ((E3 × ℝ) × ModelE5) × (ℝ × ℝ) ≃ᵐ
      (((E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2)) ×
        (ℝ × ℝ)) × ℝ :=
  by
    let eInner : ModelE5 × (ℝ × ℝ) ≃ᵐ
        ((TransverseSpace 2 × TransverseSpace 2) × (ℝ × ℝ)) × ℝ :=
      (((MeasurableEquiv.prodCongr modelFirstPassiveCoordinates
          (MeasurableEquiv.refl (ℝ × ℝ))).trans
        (MeasurableEquiv.prodAssoc :
          ((TransverseSpace 2 × TransverseSpace 2) × ℝ) × (ℝ × ℝ) ≃ᵐ
            (TransverseSpace 2 × TransverseSpace 2) × (ℝ × (ℝ × ℝ)))).trans
        (MeasurableEquiv.prodCongr
          (MeasurableEquiv.refl (TransverseSpace 2 × TransverseSpace 2))
          (MeasurableEquiv.prodComm : ℝ × (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) × ℝ))).trans
        (MeasurableEquiv.prodAssoc.symm :
          (TransverseSpace 2 × TransverseSpace 2) × ((ℝ × ℝ) × ℝ) ≃ᵐ
            ((TransverseSpace 2 × TransverseSpace 2) × (ℝ × ℝ)) × ℝ)
    let e₀ : ((E3 × ℝ) × ModelE5) × (ℝ × ℝ) ≃ᵐ
        (E3 × ℝ) ×
          (((TransverseSpace 2 × TransverseSpace 2) × (ℝ × ℝ)) × ℝ) :=
      (MeasurableEquiv.prodAssoc :
        ((E3 × ℝ) × ModelE5) × (ℝ × ℝ) ≃ᵐ
          (E3 × ℝ) × (ModelE5 × (ℝ × ℝ))).trans
        (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (E3 × ℝ)) eInner)
    let e₁ : ((E3 × ℝ) × ModelE5) × (ℝ × ℝ) ≃ᵐ
        ((E3 × ℝ) × ((TransverseSpace 2 × TransverseSpace 2) ×
          (ℝ × ℝ))) × ℝ :=
      e₀.trans (MeasurableEquiv.prodAssoc.symm :
        (E3 × ℝ) × (((TransverseSpace 2 × TransverseSpace 2) ×
          (ℝ × ℝ)) × ℝ) ≃ᵐ
          ((E3 × ℝ) × ((TransverseSpace 2 × TransverseSpace 2) ×
            (ℝ × ℝ))) × ℝ)
    exact e₁.trans (MeasurableEquiv.prodCongr
      (MeasurableEquiv.prodAssoc.symm :
        (E3 × ℝ) × ((TransverseSpace 2 × TransverseSpace 2) × (ℝ × ℝ)) ≃ᵐ
          ((E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2)) × (ℝ × ℝ))
      (MeasurableEquiv.refl ℝ))

@[simp] theorem scratch_modelFiberPassiveActiveReorder_apply
    (pt : E3 × ℝ) (z : ModelE5) (v w : ℝ) :
    scratch_modelFiberPassiveActiveReorder ((pt, z), (v, w)) =
      (((pt, modelFirstPassivePair (z 0) (z 1) (z 2) (z 3)), (v, w)), z 4) := by
  simp [scratch_modelFiberPassiveActiveReorder, modelFirstPassiveCoordinates_apply,
    MeasurableEquiv.prodAssoc, MeasurableEquiv.prodComm,
    MeasurableEquiv.prodCongr]

/-- The preceding passive/active reordering preserves the literal product
measure for any sigma-finite center--scale measure. -/
theorem scratch_modelFiberPassiveActiveReorder_measurePreserving
    (μ : Measure (E3 × ℝ)) [SFinite μ] :
    MeasurePreserving scratch_modelFiberPassiveActiveReorder
      ((μ.prod (volume : Measure ModelE5)).prod
        ((volume : Measure ℝ).prod volume))
      ((((μ.prod ((volume : Measure (TransverseSpace 2)).prod volume)).prod
          ((volume : Measure ℝ).prod volume)).prod volume)) := by
  let κ : Measure (TransverseSpace 2 × TransverseSpace 2) :=
    (volume : Measure (TransverseSpace 2)).prod volume
  let ρ : Measure (ℝ × ℝ) := (volume : Measure ℝ).prod volume
  let h₁ : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        ((E3 × ℝ) × ModelE5) × (ℝ × ℝ) ≃ᵐ
          (E3 × ℝ) × (ModelE5 × (ℝ × ℝ)))
      ((μ.prod (volume : Measure ModelE5)).prod ρ)
      (μ.prod ((volume : Measure ModelE5).prod ρ)) :=
    measurePreserving_prodAssoc μ volume ρ
  let h₂a : MeasurePreserving
      (MeasurableEquiv.prodCongr modelFirstPassiveCoordinates
        (MeasurableEquiv.refl (ℝ × ℝ)))
      ((volume : Measure ModelE5).prod ρ)
      ((κ.prod (volume : Measure ℝ)).prod ρ) := by
    convert modelFirstPassiveCoordinates_measurePreserving.prod
      (MeasurePreserving.id ρ) using 1 <;> rfl
  let h₂b : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        ((TransverseSpace 2 × TransverseSpace 2) × ℝ) × (ℝ × ℝ) ≃ᵐ
          (TransverseSpace 2 × TransverseSpace 2) × (ℝ × (ℝ × ℝ)))
      ((κ.prod (volume : Measure ℝ)).prod ρ)
      (κ.prod ((volume : Measure ℝ).prod ρ)) :=
    measurePreserving_prodAssoc κ volume ρ
  let h₂c : MeasurePreserving
      (MeasurableEquiv.prodCongr
        (MeasurableEquiv.refl (TransverseSpace 2 × TransverseSpace 2))
        (MeasurableEquiv.prodComm : ℝ × (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) × ℝ))
      (κ.prod ((volume : Measure ℝ).prod ρ))
      (κ.prod (ρ.prod (volume : Measure ℝ))) := by
    exact (MeasurePreserving.id κ).prod Measure.measurePreserving_swap
  let h₂d : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        (TransverseSpace 2 × TransverseSpace 2) × ((ℝ × ℝ) × ℝ) ≃ᵐ
          ((TransverseSpace 2 × TransverseSpace 2) × (ℝ × ℝ)) × ℝ)
      (κ.prod (ρ.prod (volume : Measure ℝ)))
      ((κ.prod ρ).prod (volume : Measure ℝ)) :=
    (measurePreserving_prodAssoc κ ρ volume).symm
  let eInner : ModelE5 × (ℝ × ℝ) ≃ᵐ
      ((TransverseSpace 2 × TransverseSpace 2) × (ℝ × ℝ)) × ℝ :=
    (((MeasurableEquiv.prodCongr modelFirstPassiveCoordinates
        (MeasurableEquiv.refl (ℝ × ℝ))).trans
      (MeasurableEquiv.prodAssoc :
        ((TransverseSpace 2 × TransverseSpace 2) × ℝ) × (ℝ × ℝ) ≃ᵐ
          (TransverseSpace 2 × TransverseSpace 2) × (ℝ × (ℝ × ℝ)))).trans
      (MeasurableEquiv.prodCongr
        (MeasurableEquiv.refl (TransverseSpace 2 × TransverseSpace 2))
        (MeasurableEquiv.prodComm : ℝ × (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) × ℝ))).trans
      (MeasurableEquiv.prodAssoc.symm :
        (TransverseSpace 2 × TransverseSpace 2) × ((ℝ × ℝ) × ℝ) ≃ᵐ
          ((TransverseSpace 2 × TransverseSpace 2) × (ℝ × ℝ)) × ℝ)
  let h₂ : MeasurePreserving eInner
      ((volume : Measure ModelE5).prod ρ)
      ((κ.prod ρ).prod (volume : Measure ℝ)) := by
    dsimp only [eInner]
    exact ((h₂a.trans h₂b).trans h₂c).trans h₂d
  let h₃ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (E3 × ℝ)) eInner)
      (μ.prod ((volume : Measure ModelE5).prod ρ))
      (μ.prod ((κ.prod ρ).prod (volume : Measure ℝ))) :=
    (MeasurePreserving.id μ).prod h₂
  let h₄ : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        (E3 × ℝ) × (((TransverseSpace 2 × TransverseSpace 2) ×
          (ℝ × ℝ)) × ℝ) ≃ᵐ
          ((E3 × ℝ) × ((TransverseSpace 2 × TransverseSpace 2) ×
            (ℝ × ℝ))) × ℝ)
      (μ.prod ((κ.prod ρ).prod (volume : Measure ℝ)))
      ((μ.prod (κ.prod ρ)).prod (volume : Measure ℝ)) :=
    (measurePreserving_prodAssoc μ (κ.prod ρ) volume).symm
  let h₅ : MeasurePreserving
      (MeasurableEquiv.prodCongr
        (MeasurableEquiv.prodAssoc.symm :
          (E3 × ℝ) × ((TransverseSpace 2 × TransverseSpace 2) × (ℝ × ℝ)) ≃ᵐ
            ((E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2)) × (ℝ × ℝ))
        (MeasurableEquiv.refl ℝ))
      ((μ.prod (κ.prod ρ)).prod (volume : Measure ℝ))
      (((μ.prod κ).prod ρ).prod (volume : Measure ℝ)) := by
    exact (measurePreserving_prodAssoc μ κ ρ).symm.prod
      (MeasurePreserving.id (volume : Measure ℝ))
  simpa only [scratch_modelFiberPassiveActiveReorder, κ, ρ, eInner] using
    (((h₁.trans h₃).trans h₄).trans h₅)

/-- The remaining harmless reordering moves the scale to the outside, keeps
the translation last, and places the two sampled points before the center. -/
noncomputable def scratch_modelFiberCenterFinalReorder :
    ((E3 × ℝ) × (E3 × E3)) × ℝ ≃ᵐ
      ℝ × (((E3 × E3) × E3) × ℝ) :=
  by
    let e₀ : ((E3 × ℝ) × (E3 × E3)) × ℝ ≃ᵐ
        E3 × (ℝ × ((E3 × E3) × ℝ)) :=
      (MeasurableEquiv.prodAssoc :
        ((E3 × ℝ) × (E3 × E3)) × ℝ ≃ᵐ
          (E3 × ℝ) × ((E3 × E3) × ℝ)).trans
        (MeasurableEquiv.prodAssoc :
          (E3 × ℝ) × ((E3 × E3) × ℝ) ≃ᵐ
            E3 × (ℝ × ((E3 × E3) × ℝ)))
    let e₁ : ((E3 × ℝ) × (E3 × E3)) × ℝ ≃ᵐ
        ℝ × (E3 × ((E3 × E3) × ℝ)) :=
      e₀.trans (swapMiddle E3 ℝ ((E3 × E3) × ℝ))
    let e₂ : ((E3 × ℝ) × (E3 × E3)) × ℝ ≃ᵐ
        ℝ × ((E3 × (E3 × E3)) × ℝ) :=
      e₁.trans (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
        (MeasurableEquiv.prodAssoc.symm :
          E3 × ((E3 × E3) × ℝ) ≃ᵐ (E3 × (E3 × E3)) × ℝ))
    exact e₂.trans (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
      (MeasurableEquiv.prodCongr
        (MeasurableEquiv.prodComm : E3 × (E3 × E3) ≃ᵐ (E3 × E3) × E3)
        (MeasurableEquiv.refl ℝ)))

@[simp] theorem scratch_modelFiberCenterFinalReorder_apply
    (p x y : E3) (t r : ℝ) :
    scratch_modelFiberCenterFinalReorder (((p, t), (x, y)), r) =
      (t, (((x, y), p), r)) := by
  simp [scratch_modelFiberCenterFinalReorder, swapMiddle,
    MeasurableEquiv.prodAssoc, MeasurableEquiv.prodComm,
    MeasurableEquiv.prodCongr]

/-- The final scale/center/translation permutation is measure preserving for
an arbitrary sigma-finite scale measure. -/
theorem scratch_modelFiberCenterFinalReorder_measurePreserving
    (ν : Measure ℝ) [SFinite ν] :
    MeasurePreserving scratch_modelFiberCenterFinalReorder
      ((((volume : Measure E3).prod ν).prod
        ((volume : Measure E3).prod volume)).prod volume)
      (ν.prod ((((volume : Measure E3).prod volume).prod
        (volume : Measure E3)).prod volume)) := by
  let κ : Measure (E3 × E3) := (volume : Measure E3).prod volume
  let h₁ : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        ((E3 × ℝ) × (E3 × E3)) × ℝ ≃ᵐ
          (E3 × ℝ) × ((E3 × E3) × ℝ))
      (((((volume : Measure E3).prod ν).prod κ).prod volume))
      (((volume : Measure E3).prod ν).prod (κ.prod volume)) :=
    measurePreserving_prodAssoc ((volume : Measure E3).prod ν) κ volume
  let h₂ : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        (E3 × ℝ) × ((E3 × E3) × ℝ) ≃ᵐ
          E3 × (ℝ × ((E3 × E3) × ℝ)))
      (((volume : Measure E3).prod ν).prod (κ.prod volume))
      ((volume : Measure E3).prod (ν.prod (κ.prod volume))) :=
    measurePreserving_prodAssoc volume ν (κ.prod volume)
  let h₃ : MeasurePreserving
      (swapMiddle E3 ℝ ((E3 × E3) × ℝ))
      ((volume : Measure E3).prod (ν.prod (κ.prod volume)))
      (ν.prod ((volume : Measure E3).prod (κ.prod volume))) :=
    swapMiddle_measurePreserving E3 ℝ ((E3 × E3) × ℝ)
      volume ν (κ.prod volume)
  let h₄ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
        (MeasurableEquiv.prodAssoc.symm :
          E3 × ((E3 × E3) × ℝ) ≃ᵐ (E3 × (E3 × E3)) × ℝ))
      (ν.prod ((volume : Measure E3).prod (κ.prod volume)))
      (ν.prod (((volume : Measure E3).prod κ).prod volume)) := by
    exact (MeasurePreserving.id ν).prod
      (measurePreserving_prodAssoc volume κ volume).symm
  let h₅ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
        (MeasurableEquiv.prodCongr
          (MeasurableEquiv.prodComm : E3 × (E3 × E3) ≃ᵐ (E3 × E3) × E3)
          (MeasurableEquiv.refl ℝ)))
      (ν.prod (((volume : Measure E3).prod κ).prod volume))
      (ν.prod ((κ.prod (volume : Measure E3)).prod volume)) := by
    exact (MeasurePreserving.id ν).prod
      ((Measure.measurePreserving_swap : MeasurePreserving Prod.swap
        ((volume : Measure E3).prod κ) (κ.prod (volume : Measure E3))).prod
        (MeasurePreserving.id (volume : Measure ℝ)))
  simpa only [scratch_modelFiberCenterFinalReorder, κ] using
    (((h₁.trans h₂).trans h₃).trans h₄).trans h₅

/-- The full product-space coordinate transport.  It converts the opened
model-fiber variables into the scale, two sampled points, center, and
translation variable used by the center-expanded local form. -/
noncomputable def scratch_modelFiberCenterReorder :
    ((E3 × ℝ) × ModelE5) × (ℝ × ℝ) ≃ᵐ
      ℝ × (((E3 × E3) × E3) × ℝ) :=
  scratch_modelFiberPassiveActiveReorder.trans
    ((MeasurableEquiv.prodCongr (cubeCenterActivePassiveSplit 2).symm
      (MeasurableEquiv.refl ℝ)).trans
      ((MeasurableEquiv.prodCongr
        (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (E3 × ℝ))
          cubeFalseTrueSplit)
        (MeasurableEquiv.refl ℝ)).trans
        scratch_modelFiberCenterFinalReorder))

/-- The full coordinate transport preserves the literal center--scale,
model-fiber, and opened-active-variable product measures. -/
theorem scratch_modelFiberCenterReorder_measurePreserving
    (ν : Measure ℝ) [SFinite ν] :
    MeasurePreserving scratch_modelFiberCenterReorder
      (((((volume : Measure E3).prod ν).prod
        (volume : Measure ModelE5)).prod ((volume : Measure ℝ).prod volume)))
      (ν.prod ((((volume : Measure E3).prod volume).prod
        (volume : Measure E3)).prod volume)) := by
  let μ : Measure (E3 × ℝ) := (volume : Measure E3).prod ν
  let κ : Measure (TransverseSpace 2 × TransverseSpace 2) :=
    (volume : Measure (TransverseSpace 2)).prod volume
  letI : SFinite μ := by
    dsimp only [μ]
    infer_instance
  letI : SFinite κ := by
    dsimp only [κ]
    infer_instance
  letI : SFinite ((volume : Measure ℝ).prod (volume : Measure ℝ)) := by
    infer_instance
  letI : SFinite (μ.prod κ) := by infer_instance
  letI : SFinite ((μ.prod κ).prod
      ((volume : Measure ℝ).prod (volume : Measure ℝ))) := by
    infer_instance
  letI : SFinite (μ.prod (volume : Measure E6)) := by infer_instance
  let h₁ := scratch_modelFiberPassiveActiveReorder_measurePreserving μ
  let h₂ : MeasurePreserving
      (MeasurableEquiv.prodCongr (cubeCenterActivePassiveSplit 2).symm
        (MeasurableEquiv.refl ℝ))
      (((μ.prod κ).prod ((volume : Measure ℝ).prod volume)).prod volume)
      ((μ.prod (volume : Measure E6)).prod volume) := by
    exact (MeasurePreserving.symm (cubeCenterActivePassiveSplit 2)
      (cubeCenterActivePassiveSplit_measurePreserving 2 μ)).prod
        (MeasurePreserving.id (volume : Measure ℝ))
  let h₃ : MeasurePreserving
      (MeasurableEquiv.prodCongr
        (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (E3 × ℝ))
          cubeFalseTrueSplit)
        (MeasurableEquiv.refl ℝ))
      ((μ.prod (volume : Measure E6)).prod volume)
      ((μ.prod ((volume : Measure E3).prod volume)).prod volume) := by
    exact ((MeasurePreserving.id μ).prod cubeFalseTrueSplit_measurePreserving).prod
      (MeasurePreserving.id (volume : Measure ℝ))
  let h₄ := scratch_modelFiberCenterFinalReorder_measurePreserving ν
  convert ((h₁.trans h₂).trans h₃).trans h₄ using 1
  funext q
  rfl

/-- Reassembling the third-active cube coordinates gives the two literal
sampled points used by the model fibers. -/
theorem scratch_cubeFalseTrueSplit_centerActivePassive_symm
    (p : E3) (t a b c d v w : ℝ) :
    cubeFalseTrueSplit
      ((cubeCenterActivePassiveSplit 2).symm
        (((p, t), modelFirstPassivePair a b c d), (v, w))).2 =
      (modelPoint a b v, modelPoint c d w) := by
  let x : E3 := modelPoint a b v
  let y : E3 := modelPoint c d w
  let ξ : E6 := cubeFalseTrueSplit.symm (x, y)
  have hξ : cubeFalseTrueSplit ξ = (x, y) :=
    cubeFalseTrueSplit.apply_symm_apply (x, y)
  have hfalse : cubeProjection (fun _ ↦ false) ξ = x := by
    have hξ' := hξ
    rw [cubeFalseTrueSplit_apply] at hξ'
    exact congrArg Prod.fst hξ'
  have htrue : cubeProjection (fun _ ↦ true) ξ = y := by
    have hξ' := hξ
    rw [cubeFalseTrueSplit_apply] at hξ'
    exact congrArg Prod.snd hξ'
  have hx : coordinateSplit 2 x =
      (v, (modelFirstPassivePair a b c d).1) := by
    apply Prod.ext
    · simp [coordinateSplit, x]
    · ext j
      rcases j with ⟨j, hj⟩
      fin_cases j
      · simp [coordinateSplit, x, modelFirstPassivePair]
      · simp [coordinateSplit, x, modelFirstPassivePair]
      · exact False.elim (hj rfl)
  have hy : coordinateSplit 2 y =
      (w, (modelFirstPassivePair a b c d).2) := by
    apply Prod.ext
    · simp [coordinateSplit, y]
    · ext j
      rcases j with ⟨j, hj⟩
      fin_cases j
      · simp [coordinateSplit, y, modelFirstPassivePair]
      · simp [coordinateSplit, y, modelFirstPassivePair]
      · exact False.elim (hj rfl)
  have hsplit : cubeCenterActivePassiveSplit 2 ((p, t), ξ) =
      (((p, t), modelFirstPassivePair a b c d), (v, w)) := by
    rw [cubeCenterActivePassiveSplit_apply]
    apply Prod.ext
    · apply Prod.ext
      · rfl
      · apply Prod.ext
        · rw [show coordinateSplit 2 (cubeProjection (fun _ ↦ false) ξ) =
            coordinateSplit 2 x by rw [hfalse], hx]
        · rw [show coordinateSplit 2 (cubeProjection (fun _ ↦ true) ξ) =
            coordinateSplit 2 y by rw [htrue], hy]
    · apply Prod.ext
      · have h := congrArg (fun q : E3 ↦ q 2) hfalse
        simpa [x, cubeProjection] using h
      · have h := congrArg (fun q : E3 ↦ q 2) htrue
        simpa [y, cubeProjection] using h
  have hinv : (cubeCenterActivePassiveSplit 2).symm
      (((p, t), modelFirstPassivePair a b c d), (v, w)) = ((p, t), ξ) := by
    apply (cubeCenterActivePassiveSplit 2).injective
    rw [MeasurableEquiv.apply_symm_apply, hsplit]
  rw [hinv]
  exact hξ

/-- Pointwise coordinate formula for the full transport. -/
@[simp] theorem scratch_modelFiberCenterReorder_apply
    (p : E3) (t : ℝ) (z : ModelE5) (v w : ℝ) :
    scratch_modelFiberCenterReorder (((p, t), z), (v, w)) =
      (t, (((modelPoint (z 0) (z 1) v,
        modelPoint (z 2) (z 3) w), p), z 4)) := by
  simp only [scratch_modelFiberCenterReorder, MeasurableEquiv.trans_apply,
    MeasurableEquiv.prodCongr, scratch_modelFiberPassiveActiveReorder_apply]
  change scratch_modelFiberCenterFinalReorder
      (((p, t), cubeFalseTrueSplit
        ((cubeCenterActivePassiveSplit 2).symm
          (((p, t), modelFirstPassivePair (z 0) (z 1) (z 2) (z 3)),
            (v, w))).2), z 4) = _
  rw [scratch_cubeFalseTrueSplit_centerActivePassive_symm
    p t (z 0) (z 1) (z 2) (z 3) v w]
  exact scratch_modelFiberCenterFinalReorder_apply p
    (modelPoint (z 0) (z 1) v) (modelPoint (z 2) (z 3) w) t (z 4)

