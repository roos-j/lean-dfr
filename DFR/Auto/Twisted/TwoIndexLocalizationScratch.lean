    exact e₂.trans (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
      (MeasurableEquiv.prodCongr
        (MeasurableEquiv.prodComm : E3 × (E3 × E3) ≃ᵐ (E3 × E3) × E3)
        (MeasurableEquiv.refl ℝ)))

@[simp] theorem scratch_modelFiberCenterFinalReorder_apply
    (p x y : E3) (t r : ℝ) :
    scratch_modelFiberCenterFinalReorder (((p, t), (x, y)), r) =
