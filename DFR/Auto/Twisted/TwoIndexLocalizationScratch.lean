    measurePreserving_prodAssoc volume ν (κ.prod volume)
  let h₃ : MeasurePreserving
      (swapMiddle E3 ℝ ((E3 × E3) × ℝ))
      ((volume : Measure E3).prod (ν.prod (κ.prod volume)))
      (ν.prod ((volume : Measure E3).prod (κ.prod volume))) :=
    swapMiddle_measurePreserving E3 ℝ ((E3 × E3) × ℝ)
      volume ν (κ.prod volume)
  let h₄ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
        (MeasurableEquiv.prodAssoc.symm :
