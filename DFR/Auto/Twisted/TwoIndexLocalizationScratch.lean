    dsimp only [s₀]
    exact pow_pos ht _
  have hs₁ : 0 < s₁ := by
    dsimp only [s₁]
    exact pow_pos ht _
  have hs₂ : 0 < s₂ := by
    dsimp only [s₂]
    exact pow_pos ht _
  let C : ℝ := B₁ * B₂ * B₃
