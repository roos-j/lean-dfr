/-- A uniform weight-one-hundred bound for the active model forms at the
exponents `q`. -/
def UniformActiveModelBound (α : Anisotropy) (q : Fin 4 → ℝ) : Prop :=
  ∀ i : Fin 3, ∃ B : ℝ, 0 ≤ B ∧ ∀ (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput),
