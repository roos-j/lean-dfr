    {T : (Fin 3 → (X → ℝ)) → (X → ℝ)} (hT : FourVertexMarcinkiewicz μ T)
    (β b : Fin 3 → ℝ) (β₀ b₀ : ℝ)
    (hb : ∀ j, 0 < b j) (hb₀ : 0 < b₀)
    (hbsum : b₀ = 1 - ∑ j : Fin 3, b j)
    (hβ₀ : 0 < β₀) (hβsum : β₀ = 1 - ∑ j : Fin 3, β j)
    (hlt : ∀ m, b m < β m)
    (p : Fin 3 → ℝ) (hp : ∀ j, (p j)⁻¹ = β j)
    (R : ℝ)
    (hR : R⁻¹ = ∑ a : Fin 4,
      simplexWeight β b β₀ b₀ a * (simplexVertexOutput b b₀ a)⁻¹)
    (hR1 : 1 < R)
    (A : Fin 4 → ℝ) (hA : ∀ a, 0 ≤ A a)
