/-- Square-integrable square-root weighted factors make the signed product
absolutely integrable whenever the signed density is dominated by the weight.
This is the Fubini input accompanying the weighted Cauchy--Schwarz bound. -/
theorem integrable_signedDensity_of_weighted
    {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (a b c σ w : X → ℝ)
    (hprodmeas : AEStronglyMeasurable (fun x ↦ c x * (a x * b x * σ x)) μ)
    (hameas : AEStronglyMeasurable (fun x ↦ |a x| * √(w x)) μ)
    (hbmeas : AEStronglyMeasurable (fun x ↦ |b x| * √(w x)) μ)
    (haint : Integrable (fun x ↦ (|a x| * √(w x)) ^ 2) μ)
    (hbint : Integrable (fun x ↦ (|b x| * √(w x)) ^ 2) μ)
    (hc : ∀ᵐ x ∂μ, |c x| ≤ 1)
    (hw : ∀ᵐ x ∂μ, 0 ≤ w x)
    (hσ : ∀ᵐ x ∂μ, |σ x| = w x) :
    Integrable (fun x ↦ c x * (a x * b x * σ x)) μ := by
  let A : X → ℝ := fun x ↦ |a x| * √(w x)
  let B : X → ℝ := fun x ↦ |b x| * √(w x)
  have hAmeas : AEStronglyMeasurable A μ := by
    simpa only [A] using hameas
  have hBmeas : AEStronglyMeasurable B μ := by
    simpa only [B] using hbmeas
  have hAint : Integrable (fun x ↦ A x ^ 2) μ := by
    simpa only [A] using haint
  have hBint : Integrable (fun x ↦ B x ^ 2) μ := by
    simpa only [B] using hbint
  have hABint : Integrable (fun x ↦ A x * B x) μ := by
    exact ((memLp_two_iff_integrable_sq hAmeas).2 hAint).integrable_mul
      ((memLp_two_iff_integrable_sq hBmeas).2 hBint)
  refine hABint.mono' hprodmeas ?_
  filter_upwards [hc, hw, hσ] with x hcx hw' hσ'
  have hab : 0 ≤ |a x| * |b x| * w x := by positivity
  calc
    ‖c x * (a x * b x * σ x)‖ = |c x| * |a x| * |b x| * w x := by
      rw [Real.norm_eq_abs, abs_mul, abs_mul, abs_mul, hσ']
      ring
    _ = |c x| * (|a x| * |b x| * w x) := by ring
    _ ≤ 1 * (|a x| * |b x| * w x) :=
      mul_le_mul_of_nonneg_right hcx hab
    _ = |a x| * |b x| * w x := by ring
    _ = A x * B x := by
      dsimp only [A, B]
      calc
        |a x| * |b x| * w x =
            |a x| * |b x| * (√(w x) * √(w x)) := by
          rw [Real.mul_self_sqrt hw']
        _ = |a x| * √(w x) * (|b x| * √(w x)) := by ring

/-- A uniform bound on a fiber and integrability of a nonnegative density
give the square-integrability of its square-root weighted version. -/
theorem squareRootWeighted_integrable_of_ae_bound
    {X : Type*} [MeasurableSpace X] (μ : Measure X) (a w : X → ℝ)
    (ha : AEStronglyMeasurable a μ)
    (hwmeas : AEStronglyMeasurable w μ)
    (hwint : Integrable w μ)
    (hw : ∀ᵐ x ∂μ, 0 ≤ w x)
    (M : ℝ) (hM : 0 ≤ M)
    (hbound : ∀ᵐ x ∂μ, |a x| ≤ M) :
    AEStronglyMeasurable (fun x ↦ |a x| * √(w x)) μ ∧
      Integrable (fun x ↦ (|a x| * √(w x)) ^ 2) μ := by
  have hsqrt : AEStronglyMeasurable (fun x ↦ √(w x)) μ :=
    (hwmeas.aemeasurable.sqrt).aestronglyMeasurable
  have hmeas : AEStronglyMeasurable (fun x ↦ |a x| * √(w x)) μ :=
    ha.norm.mul hsqrt
  have hmajor : Integrable (fun x ↦ M ^ 2 * w x) μ := by
    simpa only using hwint.const_mul (M ^ 2)
  refine ⟨hmeas, hmajor.mono' (hmeas.pow 2) ?_⟩
  filter_upwards [hw, hbound] with x hw' hbound'
  rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
  have hsq : |a x| ^ 2 ≤ M ^ 2 :=
    (sq_le_sq₀ (abs_nonneg _) hM).2 hbound'
  calc
    (|a x| * √(w x)) ^ 2 = |a x| ^ 2 * w x := by
      rw [mul_pow, Real.sq_sqrt hw']
    _ ≤ M ^ 2 * w x := mul_le_mul_of_nonneg_right hsq hw'

/-- Cauchy--Schwarz for a signed density whose absolute value is a positive
weight.  The square-root weighted factors are kept explicit: this makes the
lemma applicable before any particular parameter-integral measurability
package has been chosen. -/
theorem signedDensity_weighted_cauchySchwarz
    {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (a b c σ w : X → ℝ)
    (hprodmeas : AEStronglyMeasurable (fun x ↦ c x * (a x * b x * σ x)) μ)
    (hameas : AEStronglyMeasurable (fun x ↦ |a x| * √(w x)) μ)
    (hbmeas : AEStronglyMeasurable (fun x ↦ |b x| * √(w x)) μ)
    (haint : Integrable (fun x ↦ (|a x| * √(w x)) ^ 2) μ)
    (hbint : Integrable (fun x ↦ (|b x| * √(w x)) ^ 2) μ)
    (hc : ∀ᵐ x ∂μ, |c x| ≤ 1)
    (hw : ∀ᵐ x ∂μ, 0 ≤ w x)
    (hσ : ∀ᵐ x ∂μ, |σ x| = w x) :
    |∫ x, c x * (a x * b x * σ x) ∂μ| ^ 2 ≤
      (∫ x, (|a x| * √(w x)) ^ 2 ∂μ) *
        ∫ x, (|b x| * √(w x)) ^ 2 ∂μ := by
  let A : X → ℝ := fun x ↦ |a x| * √(w x)
  let B : X → ℝ := fun x ↦ |b x| * √(w x)
  have hAmeas : AEStronglyMeasurable A μ := by
    simpa only [A] using hameas
  have hBmeas : AEStronglyMeasurable B μ := by
    simpa only [B] using hbmeas
  have hAint : Integrable (fun x ↦ A x ^ 2) μ := by
    simpa only [A] using haint
  have hBint : Integrable (fun x ↦ B x ^ 2) μ := by
    simpa only [B] using hbint
  have hABint : Integrable (fun x ↦ A x * B x) μ := by
    exact ((memLp_two_iff_integrable_sq hAmeas).2 hAint).integrable_mul
      ((memLp_two_iff_integrable_sq hBmeas).2 hBint)
  have hdom : ∀ᵐ x ∂μ,
      |c x * (a x * b x * σ x)| ≤ A x * B x := by
    filter_upwards [hc, hw, hσ] with x hcx hw' hσ'
    have hab : 0 ≤ |a x| * |b x| * w x := by positivity
    calc
      |c x * (a x * b x * σ x)| = |c x| * |a x| * |b x| * w x := by
        rw [abs_mul, abs_mul, abs_mul, hσ']
        ring
      _ = |c x| * (|a x| * |b x| * w x) := by ring
      _ ≤ 1 * (|a x| * |b x| * w x) :=
        mul_le_mul_of_nonneg_right hcx hab
      _ = |a x| * |b x| * w x := by ring
      _ = A x * B x := by
        dsimp only [A, B]
        calc
          |a x| * |b x| * w x =
              |a x| * |b x| * (√(w x) * √(w x)) := by
            rw [Real.mul_self_sqrt hw']
          _ = |a x| * √(w x) * (|b x| * √(w x)) := by ring
  have hsignedAbsInt : Integrable (fun x ↦ |c x * (a x * b x * σ x)|) μ := by
    refine hABint.mono' hprodmeas.norm ?_
    simpa only [Real.norm_eq_abs, abs_abs] using hdom
  have hbound : |∫ x, c x * (a x * b x * σ x) ∂μ| ≤
      √(∫ x, A x ^ 2 ∂μ) * √(∫ x, B x ^ 2 ∂μ) := by
    calc
      |∫ x, c x * (a x * b x * σ x) ∂μ| ≤
          ∫ x, |c x * (a x * b x * σ x)| ∂μ :=
        MeasureTheory.abs_integral_le_integral_abs
      _ ≤ ∫ x, A x * B x ∂μ :=
        integral_mono_ae hsignedAbsInt hABint hdom
      _ ≤ √(∫ x, A x ^ 2 ∂μ) * √(∫ x, B x ^ 2 ∂μ) :=
        integral_mul_le_sqrt_integral_sq μ A B hAmeas hBmeas
          (Filter.Eventually.of_forall fun x ↦ by positivity)
          (Filter.Eventually.of_forall fun x ↦ by positivity) hAint hBint
  have hAnonnneg : 0 ≤ ∫ x, A x ^ 2 ∂μ :=
    integral_nonneg fun x ↦ sq_nonneg (A x)
  have hBnonnneg : 0 ≤ ∫ x, B x ^ 2 ∂μ :=
    integral_nonneg fun x ↦ sq_nonneg (B x)
  have hright : 0 ≤ √(∫ x, A x ^ 2 ∂μ) * √(∫ x, B x ^ 2 ∂μ) :=
    mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
  calc
    |∫ x, c x * (a x * b x * σ x) ∂μ| ^ 2 ≤
        (√(∫ x, A x ^ 2 ∂μ) * √(∫ x, B x ^ 2 ∂μ)) ^ 2 :=
      (sq_le_sq₀ (abs_nonneg _) hright).2 hbound
    _ = (∫ x, A x ^ 2 ∂μ) * ∫ x, B x ^ 2 ∂μ := by
      rw [mul_pow, Real.sq_sqrt hAnonnneg, Real.sq_sqrt hBnonnneg]
    _ = (∫ x, (|a x| * √(w x)) ^ 2 ∂μ) *
        ∫ x, (|b x| * √(w x)) ^ 2 ∂μ := by
      rfl

/-- The first square-root weighted factor on the joint local-model space. -/
noncomputable def modelFirstWeightedFactor
    (α : Anisotropy) (u : E3) (f : ModelRealInput)
    (q : (E3 × ℝ) × ModelE5) : ℝ :=
  |modelFirstFiber α f q.1.1 q.1.2 q.2| *
    √(modelEnergyDensity α u q.1.1 q.1.2 q.2)

/-- The second square-root weighted factor on the joint local-model space. -/
noncomputable def modelSecondWeightedFactor
    (α : Anisotropy) (u : E3) (f : E3 → ℝ)
    (q : (E3 × ℝ) × ModelE5) : ℝ :=
  |modelSecondFiber α f q.1.1 q.1.2 q.2| *
    √(modelEnergyDensity α u q.1.1 q.1.2 q.2)

/-- The signed joint integrand whose iterated integral defines the expanded
local model form. -/
noncomputable def modelSignedIntegrand
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (q : (E3 × ℝ) × ModelE5) : ℝ :=
  c q.1.2 *
    (modelFirstFiber α f q.1.1 q.1.2 q.2 *
      modelSecondFiber α (f 3) q.1.1 q.1.2 q.2 *
        modelSignedDensity α u q.1.1 q.1.2 q.2)

/-- The joint integrand defining the first local energy. -/
noncomputable def modelEnergyOneIntegrand
    (α : Anisotropy) (u : E3) (f : ModelRealInput)
    (q : (E3 × ℝ) × ModelE5) : ℝ :=
  (modelFirstFiber α f q.1.1 q.1.2 q.2) ^ 2 *
    modelEnergyDensity α u q.1.1 q.1.2 q.2

/-- The joint integrand defining the second local energy. -/
noncomputable def modelEnergyTwoJointIntegrand
    (α : Anisotropy) (u : E3) (f : E3 → ℝ)
    (q : (E3 × ℝ) × ModelE5) : ℝ :=
  (modelSecondFiber α f q.1.1 q.1.2 q.2) ^ 2 *
    modelEnergyDensity α u q.1.1 q.1.2 q.2

/-- Continuous real inputs and a measurable multiplier make the signed local
model product a.e.-strongly measurable on every joint measure. -/
theorem aestronglyMeasurable_modelSignedIntegrand
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (hcmeas : Measurable c) (hfcont : ∀ j, Continuous (f j))
    (μ : Measure ((E3 × ℝ) × ModelE5)) :
    AEStronglyMeasurable (modelSignedIntegrand α u c f) μ := by
  have hc : AEStronglyMeasurable (fun q : (E3 × ℝ) × ModelE5 ↦ c q.1.2) μ :=
    (hcmeas.comp (measurable_snd.comp measurable_fst)).aestronglyMeasurable
  have hfirst := aestronglyMeasurable_modelFirstFiber α f hfcont μ
  have hsecond := aestronglyMeasurable_modelSecondFiber α (f 3)
    (hfcont 3) μ
  have hdensity := aestronglyMeasurable_modelSignedDensity α u μ
  unfold modelSignedIntegrand
  exact hc.mul ((hfirst.mul hsecond).mul hdensity)

/-- The first square-root weighted factor is a.e.-strongly measurable for
continuous inputs on every joint measure. -/
theorem aestronglyMeasurable_modelFirstWeightedFactor
    (α : Anisotropy) (u : E3) (f : ModelRealInput)
    (hfcont : ∀ j, Continuous (f j))
    (μ : Measure ((E3 × ℝ) × ModelE5)) :
    AEStronglyMeasurable (modelFirstWeightedFactor α u f) μ := by
  have hfirst := aestronglyMeasurable_modelFirstFiber α f hfcont μ
  have hweight := aestronglyMeasurable_modelEnergyDensity α u μ
  unfold modelFirstWeightedFactor
  exact hfirst.norm.mul (hweight.aemeasurable.sqrt).aestronglyMeasurable

/-- The second square-root weighted factor is a.e.-strongly measurable for a
continuous input on every joint measure. -/
theorem aestronglyMeasurable_modelSecondWeightedFactor
    (α : Anisotropy) (u : E3) (f : E3 → ℝ) (hfcont : Continuous f)
    (μ : Measure ((E3 × ℝ) × ModelE5)) :
    AEStronglyMeasurable (modelSecondWeightedFactor α u f) μ := by
  have hsecond := aestronglyMeasurable_modelSecondFiber α f hfcont μ
  have hweight := aestronglyMeasurable_modelEnergyDensity α u μ
  unfold modelSecondWeightedFactor
  exact hsecond.norm.mul (hweight.aemeasurable.sqrt).aestronglyMeasurable

/-- The joint center--scale/fiber measure of a finite collection is supported
on strictly positive scales. -/
theorem ae_pos_scale_modelJoint
    (α : Anisotropy) (S : BoxCollection α) :
    ∀ᵐ q ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
      (volume : Measure ModelE5)), 0 < q.1.2 := by
  let μpt : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  have hpt : ∀ᵐ pt ∂μpt, 0 < pt.2 := by
    dsimp [μpt]
    filter_upwards [ae_restrict_mem (measurableSet_collectionRegion α S)]
      with pt hpt
    exact pos_of_mem_closure_collectionRegion α S (subset_closure hpt)
  have hmeas : MeasurableSet {q : (E3 × ℝ) × ModelE5 | 0 < q.1.2} := by
    change MeasurableSet ((fun q : (E3 × ℝ) × ModelE5 ↦ q.1.2) ⁻¹'
      Set.Ioi 0)
    exact measurableSet_preimage (measurable_snd.comp measurable_fst)
      measurableSet_Ioi
  change ∀ᵐ q ∂μpt.prod volume, 0 < q.1.2
  apply (Measure.ae_prod_iff_ae_ae hmeas).2
  filter_upwards [hpt] with pt hpt
  exact Filter.Eventually.of_forall fun _ ↦ hpt

/-- The literal energy density is a.e. nonnegative on the joint local-model
measure. -/
theorem ae_modelEnergyDensity_nonneg_collection
    (α : Anisotropy) (S : BoxCollection α) (u : E3) :
    ∀ᵐ q ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
      (volume : Measure ModelE5)),
      0 ≤ modelEnergyDensity α u q.1.1 q.1.2 q.2 := by
  filter_upwards [ae_pos_scale_modelJoint α S] with q hq
  exact modelEnergyDensity_nonneg α u q.1.1 hq.le q.2

/-- On the same joint measure, the signed density has absolute value exactly
the energy density. -/
theorem ae_abs_modelSignedDensity_collection
    (α : Anisotropy) (S : BoxCollection α) (u : E3) :
    ∀ᵐ q ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
      (volume : Measure ModelE5)),
      |modelSignedDensity α u q.1.1 q.1.2 q.2| =
        modelEnergyDensity α u q.1.1 q.1.2 q.2 := by
  filter_upwards [ae_pos_scale_modelJoint α S] with q hq
  exact abs_modelSignedDensity α u q.1.1 hq.le q.2

/-- Squaring the first weighted factor recovers the first energy density on
the positive-scale local joint measure. -/
theorem ae_modelFirstWeightedFactor_sq
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : ModelRealInput) :
    ∀ᵐ q ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
      (volume : Measure ModelE5)),
      (modelFirstWeightedFactor α u f q) ^ 2 =
        modelEnergyOneIntegrand α u f q := by
  filter_upwards [ae_modelEnergyDensity_nonneg_collection α S u]
    with q hq
  unfold modelFirstWeightedFactor modelEnergyOneIntegrand
  rw [mul_pow, sq_abs, Real.sq_sqrt hq]

/-- Squaring the second weighted factor recovers the second energy density on
the positive-scale local joint measure. -/
theorem ae_modelSecondWeightedFactor_sq
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : E3 → ℝ) :
    ∀ᵐ q ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
      (volume : Measure ModelE5)),
      (modelSecondWeightedFactor α u f q) ^ 2 =
        modelEnergyTwoJointIntegrand α u f q := by
  filter_upwards [ae_modelEnergyDensity_nonneg_collection α S u]
    with q hq
  unfold modelSecondWeightedFactor modelEnergyTwoJointIntegrand
  rw [mul_pow, sq_abs, Real.sq_sqrt hq]

/-- The positive-scale support of a finite collection promotes the fixed-scale
first-fiber estimate to the full local joint measure. -/
theorem ae_abs_modelFirstFiber_le_collection
    (α : Anisotropy) (S : BoxCollection α) (f : ModelRealInput)
    (hfcont : ∀ j, Continuous (f j))
    (B0 B1 B2 : ℝ) (hB0 : 0 ≤ B0) (hB1 : 0 ≤ B1) (hB2 : 0 ≤ B2)
    (hf0 : ∀ y, |f 0 y| ≤ B0) (hf1 : ∀ y, |f 1 y| ≤ B1)
    (hf2 : ∀ y, |f 2 y| ≤ B2) :
    ∀ᵐ q ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
      (volume : Measure ModelE5)),
      |modelFirstFiber α f q.1.1 q.1.2 q.2| ≤
        (B0 * B1 * B2) * ∫ v : ℝ, |gaussianDeriv v| := by
  filter_upwards [ae_pos_scale_modelJoint α S] with q hq
  exact abs_modelFirstFiber_le α f q.1.1 q.2 hfcont B0 B1 B2 hB0 hB1 hB2
    hf0 hf1 hf2 hq

/-- The analogous uniform second-fiber estimate on the full local joint
measure. -/
theorem ae_abs_modelSecondFiber_le_collection
    (α : Anisotropy) (S : BoxCollection α) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hf : ∀ y, |f y| ≤ B) :
    ∀ᵐ q ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
      (volume : Measure ModelE5)),
      |modelSecondFiber α f q.1.1 q.1.2 q.2| ≤
        B * ∫ v : ℝ, |gaussianDeriv v| := by
  filter_upwards [ae_pos_scale_modelJoint α S] with q hq
  exact abs_modelSecondFiber_le α f q.1.1 q.2 hfcont B hB hf hq

/-- Once the positive local density is jointly integrable, the first
square-root weighted fiber is square-integrable under the literal uniform
bounded-continuous hypotheses. -/
theorem integrable_modelFirstWeightedFactor_sq_of_density
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : ModelRealInput)
    (hfcont : ∀ j, Continuous (f j))
    (B0 B1 B2 : ℝ) (hB0 : 0 ≤ B0) (hB1 : 0 ≤ B1) (hB2 : 0 ≤ B2)
    (hf0 : ∀ y, |f 0 y| ≤ B0) (hf1 : ∀ y, |f 1 y| ≤ B1)
    (hf2 : ∀ y, |f 2 y| ≤ B2)
    (hweightint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5))) :
    Integrable (fun q ↦ (modelFirstWeightedFactor α u f q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)) := by
  let μ : Measure ((E3 × ℝ) × ModelE5) :=
    (cubeScaleMeasure.restrict (collectionRegion α S)).prod volume
  let A : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelFirstFiber α f q.1.1 q.1.2 q.2
  let W : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelEnergyDensity α u q.1.1 q.1.2 q.2
  let M : ℝ := (B0 * B1 * B2) * ∫ v : ℝ, |gaussianDeriv v|
  have hM : 0 ≤ M := by
    dsimp only [M]
    exact mul_nonneg (mul_nonneg (mul_nonneg hB0 hB1) hB2)
      (integral_nonneg fun v ↦ abs_nonneg (gaussianDeriv v))
  have hAmeas : AEStronglyMeasurable A μ := by
    simpa only [A] using
      aestronglyMeasurable_modelFirstFiber α f hfcont μ
  have hWmeas : AEStronglyMeasurable W μ := by
    simpa only [W] using aestronglyMeasurable_modelEnergyDensity α u μ
  have hWint : Integrable W μ := by
    simpa only [μ, W] using hweightint
  have hWnonneg : ∀ᵐ q ∂μ, 0 ≤ W q := by
    simpa only [μ, W] using
      ae_modelEnergyDensity_nonneg_collection α S u
  have hAbound : ∀ᵐ q ∂μ, |A q| ≤ M := by
    simpa only [μ, A, M] using
      ae_abs_modelFirstFiber_le_collection α S f hfcont B0 B1 B2
        hB0 hB1 hB2 hf0 hf1 hf2
  have hweighted := squareRootWeighted_integrable_of_ae_bound
    μ A W hAmeas hWmeas hWint hWnonneg M hM hAbound
  change Integrable (fun q ↦ (|A q| * √(W q)) ^ 2) μ
  exact hweighted.2

/-- The corresponding density-to-square-integrability step for the second
weighted fiber. -/
theorem integrable_modelSecondWeightedFactor_sq_of_density
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : E3 → ℝ)
    (hfcont : Continuous f) (B : ℝ) (hB : 0 ≤ B) (hf : ∀ y, |f y| ≤ B)
    (hweightint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5))) :
    Integrable (fun q ↦ (modelSecondWeightedFactor α u f q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)) := by
  let μ : Measure ((E3 × ℝ) × ModelE5) :=
    (cubeScaleMeasure.restrict (collectionRegion α S)).prod volume
  let A : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelSecondFiber α f q.1.1 q.1.2 q.2
  let W : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelEnergyDensity α u q.1.1 q.1.2 q.2
  let M : ℝ := B * ∫ v : ℝ, |gaussianDeriv v|
  have hM : 0 ≤ M := by
    dsimp only [M]
    exact mul_nonneg hB (integral_nonneg fun v ↦ abs_nonneg (gaussianDeriv v))
  have hAmeas : AEStronglyMeasurable A μ := by
    simpa only [A] using
      aestronglyMeasurable_modelSecondFiber α f hfcont μ
  have hWmeas : AEStronglyMeasurable W μ := by
    simpa only [W] using aestronglyMeasurable_modelEnergyDensity α u μ
  have hWint : Integrable W μ := by
    simpa only [μ, W] using hweightint
  have hWnonneg : ∀ᵐ q ∂μ, 0 ≤ W q := by
    simpa only [μ, W] using
      ae_modelEnergyDensity_nonneg_collection α S u
  have hAbound : ∀ᵐ q ∂μ, |A q| ≤ M := by
    simpa only [μ, A, M] using
      ae_abs_modelSecondFiber_le_collection α S f hfcont B hB hf
  have hweighted := squareRootWeighted_integrable_of_ae_bound
    μ A W hAmeas hWmeas hWint hWnonneg M hM hAbound
  change Integrable (fun q ↦ (|A q| * √(W q)) ^ 2) μ
  exact hweighted.2

/-- Fubini turns the literal iterated signed-density local form into its
single product-space integral, once absolute integrability is available. -/
theorem expandedModelLocalForm_eq_neg_jointIntegral_of_integrable
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      c q.1.2 *
        (modelFirstFiber α f q.1.1 q.1.2 q.2 *
          modelSecondFiber α (f 3) q.1.1 q.1.2 q.2 *
            modelSignedDensity α u q.1.1 q.1.2 q.2))
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)) :
    expandedModelLocalForm α S u c f =
      -(∫ q : (E3 × ℝ) × ModelE5,
        c q.1.2 *
          (modelFirstFiber α f q.1.1 q.1.2 q.2 *
            modelSecondFiber α (f 3) q.1.1 q.1.2 q.2 *
              modelSignedDensity α u q.1.1 q.1.2 q.2)
        ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)) := by
  letI : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  unfold expandedModelLocalForm
  calc
    -(∫ pt : E3 × ℝ,
        c pt.2 * (∫ z : ModelE5,
          modelFirstFiber α f pt.1 pt.2 z *
            modelSecondFiber α (f 3) pt.1 pt.2 z *
              modelSignedDensity α u pt.1 pt.2 z)
        ∂(cubeScaleMeasure.restrict (collectionRegion α S))) =
        -(∫ pt : E3 × ℝ,
          (∫ z : ModelE5,
            c pt.2 *
              (modelFirstFiber α f pt.1 pt.2 z *
                modelSecondFiber α (f 3) pt.1 pt.2 z *
                  modelSignedDensity α u pt.1 pt.2 z))
          ∂(cubeScaleMeasure.restrict (collectionRegion α S))) := by
      congr 1
      apply integral_congr_ae
      filter_upwards [] with pt
      rw [← integral_const_mul]
    _ = _ := by
      simpa only using congrArg Neg.neg (MeasureTheory.integral_prod _ hjoint).symm

/-- The first energy is the corresponding product-space integral under the
joint integrability hypothesis supplied by localization. -/
theorem modelEnergyOne_eq_jointIntegral_of_integrable
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : ModelRealInput)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      (modelFirstFiber α f q.1.1 q.1.2 q.2) ^ 2 *
        modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)) :
    modelEnergyOne α S u f =
      ∫ q : (E3 × ℝ) × ModelE5,
        (modelFirstFiber α f q.1.1 q.1.2 q.2) ^ 2 *
          modelEnergyDensity α u q.1.1 q.1.2 q.2
        ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume) := by
  letI : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  unfold modelEnergyOne
  simpa only using (MeasureTheory.integral_prod _ hjoint).symm

/-- The second finite-collection energy has the same joint-integral form. -/
theorem modelEnergyTwo_eq_jointIntegral_of_integrable
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : E3 → ℝ)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      (modelSecondFiber α f q.1.1 q.1.2 q.2) ^ 2 *
        modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)) :
    modelEnergyTwo α S u f =
      ∫ q : (E3 × ℝ) × ModelE5,
        (modelSecondFiber α f q.1.1 q.1.2 q.2) ^ 2 *
          modelEnergyDensity α u q.1.1 q.1.2 q.2
        ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume) := by
  letI : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  unfold modelEnergyTwo modelEnergyTwoOn
  simpa only using (MeasureTheory.integral_prod _ hjoint).symm

/-- The literal first local Cauchy--Schwarz inequality.  Its hypotheses are
precisely the joint measurability and square-integrability assertions supplied
by the bounded-continuous localization package; no Fubini equality is left as
an assumption. -/
theorem expandedModelLocalForm_cauchySchwarz_of_weightedIntegrable
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput)
    (hsignedmeas : AEStronglyMeasurable
      (modelSignedIntegrand α u c f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hfirstmeas : AEStronglyMeasurable
      (modelFirstWeightedFactor α u f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hsecondmeas : AEStronglyMeasurable
      (modelSecondWeightedFactor α u (f 3))
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hfirstint : Integrable
      (fun q ↦ (modelFirstWeightedFactor α u f q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hsecondint : Integrable
      (fun q ↦ (modelSecondWeightedFactor α u (f 3) q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    |expandedModelLocalForm α S u c f| ^ 2 ≤
      modelEnergyOne α S u f * modelEnergyTwo α S u (f 3) := by
  letI : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  let μ : Measure ((E3 × ℝ) × ModelE5) :=
    (cubeScaleMeasure.restrict (collectionRegion α S)).prod volume
  let A : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelFirstFiber α f q.1.1 q.1.2 q.2
  let B : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelSecondFiber α (f 3) q.1.1 q.1.2 q.2
  let C : (E3 × ℝ) × ModelE5 → ℝ := fun q ↦ c q.1.2
  let σ : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelSignedDensity α u q.1.1 q.1.2 q.2
  let W : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelEnergyDensity α u q.1.1 q.1.2 q.2
  have hW : ∀ᵐ q ∂μ, 0 ≤ W q := by
    simpa only [μ, W] using
      ae_modelEnergyDensity_nonneg_collection α S u
  have hσ : ∀ᵐ q ∂μ, |σ q| = W q := by
    simpa only [μ, σ, W] using
      ae_abs_modelSignedDensity_collection α S u
  have hC : ∀ᵐ q ∂μ, |C q| ≤ 1 :=
    Filter.Eventually.of_forall fun q ↦ hc q.1.2
  have hsignedmeas' : AEStronglyMeasurable
      (fun q ↦ C q * (A q * B q * σ q)) μ := by
    change AEStronglyMeasurable (modelSignedIntegrand α u c f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)
    exact hsignedmeas
  have hfirstmeas' : AEStronglyMeasurable
      (fun q ↦ |A q| * √(W q)) μ := by
    change AEStronglyMeasurable (modelFirstWeightedFactor α u f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)
    exact hfirstmeas
  have hsecondmeas' : AEStronglyMeasurable
      (fun q ↦ |B q| * √(W q)) μ := by
    change AEStronglyMeasurable (modelSecondWeightedFactor α u (f 3))
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)
    exact hsecondmeas
  have hfirstint' : Integrable (fun q ↦ (|A q| * √(W q)) ^ 2) μ := by
    change Integrable (fun q ↦ (modelFirstWeightedFactor α u f q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)
    exact hfirstint
  have hsecondint' : Integrable (fun q ↦ (|B q| * √(W q)) ^ 2) μ := by
    change Integrable
      (fun q ↦ (modelSecondWeightedFactor α u (f 3) q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)
    exact hsecondint
  have hsignedint' : Integrable (fun q ↦ C q * (A q * B q * σ q)) μ :=
    integrable_signedDensity_of_weighted μ A B C σ W hsignedmeas'
      hfirstmeas' hsecondmeas' hfirstint' hsecondint' hC hW hσ
  have hfirstEnergyInt : Integrable
      (modelEnergyOneIntegrand α u f) μ := by
    exact hfirstint.congr (ae_modelFirstWeightedFactor_sq α S u f)
  have hsecondEnergyInt : Integrable
      (modelEnergyTwoJointIntegrand α u (f 3)) μ := by
    exact hsecondint.congr
      (ae_modelSecondWeightedFactor_sq α S u (f 3))
  have hform : expandedModelLocalForm α S u c f =
      -(∫ q : (E3 × ℝ) × ModelE5,
        C q * (A q * B q * σ q) ∂μ) := by
    simpa [μ, A, B, C, σ, modelSignedIntegrand] using
      expandedModelLocalForm_eq_neg_jointIntegral_of_integrable α S u c f
        (by simpa [μ, A, B, C, σ, modelSignedIntegrand]
          using hsignedint')
  have henergyOne : modelEnergyOne α S u f =
      ∫ q : (E3 × ℝ) × ModelE5,
        modelEnergyOneIntegrand α u f q ∂μ := by
    unfold modelEnergyOne
    change (∫ pt : E3 × ℝ,
      (∫ z : ModelE5,
        modelEnergyOneIntegrand α u f (pt, z))
      ∂(cubeScaleMeasure.restrict (collectionRegion α S))) =
        ∫ q : (E3 × ℝ) × ModelE5,
          modelEnergyOneIntegrand α u f q ∂μ
    simpa only [μ] using
      (MeasureTheory.integral_prod (modelEnergyOneIntegrand α u f)
        hfirstEnergyInt).symm
  have henergyTwo : modelEnergyTwo α S u (f 3) =
      ∫ q : (E3 × ℝ) × ModelE5,
        modelEnergyTwoJointIntegrand α u (f 3) q ∂μ := by
    unfold modelEnergyTwo modelEnergyTwoOn
    change (∫ pt : E3 × ℝ,
      (∫ z : ModelE5,
        modelEnergyTwoJointIntegrand α u (f 3) (pt, z))
      ∂(cubeScaleMeasure.restrict (collectionRegion α S))) =
        ∫ q : (E3 × ℝ) × ModelE5,
          modelEnergyTwoJointIntegrand α u (f 3) q ∂μ
    simpa only [μ] using
      (MeasureTheory.integral_prod (modelEnergyTwoJointIntegrand α u (f 3))
        hsecondEnergyInt).symm
  have hcs := signedDensity_weighted_cauchySchwarz μ A B C σ W
    hsignedmeas' hfirstmeas' hsecondmeas' hfirstint' hsecondint' hC hW hσ
  have hfirstSquare :
      (∫ q : (E3 × ℝ) × ModelE5,
        (modelFirstWeightedFactor α u f q) ^ 2 ∂μ) =
      ∫ q : (E3 × ℝ) × ModelE5,
        modelEnergyOneIntegrand α u f q ∂μ := by
    exact integral_congr_ae (ae_modelFirstWeightedFactor_sq α S u f)
  have hsecondSquare :
      (∫ q : (E3 × ℝ) × ModelE5,
        (modelSecondWeightedFactor α u (f 3) q) ^ 2 ∂μ) =
      ∫ q : (E3 × ℝ) × ModelE5,
        modelEnergyTwoJointIntegrand α u (f 3) q ∂μ := by
    exact integral_congr_ae
      (ae_modelSecondWeightedFactor_sq α S u (f 3))
  calc
    |expandedModelLocalForm α S u c f| ^ 2 =
        |∫ q : (E3 × ℝ) × ModelE5, C q * (A q * B q * σ q) ∂μ| ^ 2 := by
      rw [hform, abs_neg]
    _ ≤ (∫ q : (E3 × ℝ) × ModelE5,
          (modelFirstWeightedFactor α u f q) ^ 2 ∂μ) *
        ∫ q : (E3 × ℝ) × ModelE5,
          (modelSecondWeightedFactor α u (f 3) q) ^ 2 ∂μ := by
      simpa only [A, B, W, modelFirstWeightedFactor,
        modelSecondWeightedFactor] using hcs
    _ = (∫ q : (E3 × ℝ) × ModelE5,
          modelEnergyOneIntegrand α u f q ∂μ) *
        ∫ q : (E3 × ℝ) × ModelE5,
          modelEnergyTwoJointIntegrand α u (f 3) q ∂μ := by
      rw [hfirstSquare, hsecondSquare]
    _ = modelEnergyOne α S u f * modelEnergyTwo α S u (f 3) := by
      rw [← henergyOne, ← henergyTwo]


/-- All measurability premises of the literal local Cauchy--Schwarz step
follow from continuous inputs and a measurable multiplier. -/
theorem expandedModelLocalForm_cauchySchwarz_of_continuous_weighted
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (hcmeas : Measurable c)
    (hfcont : ∀ j, Continuous (f j))
    (hfirstint : Integrable
      (fun q ↦ (modelFirstWeightedFactor α u f q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hsecondint : Integrable
      (fun q ↦ (modelSecondWeightedFactor α u (f 3) q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    |expandedModelLocalForm α S u c f| ^ 2 ≤
      modelEnergyOne α S u f * modelEnergyTwo α S u (f 3) := by
  exact expandedModelLocalForm_cauchySchwarz_of_weightedIntegrable
    α S u c f
    (aestronglyMeasurable_modelSignedIntegrand α u c f hcmeas hfcont
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume))
    (aestronglyMeasurable_modelFirstWeightedFactor α u f hfcont
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume))
    (aestronglyMeasurable_modelSecondWeightedFactor α u (f 3)
      (hfcont 3) ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume))
    hfirstint hsecondint hc

/-- Bounded continuous inputs turn joint density integrability into the
square-integrability demanded by the literal first local Cauchy--Schwarz
argument. -/
theorem expandedModelLocalForm_cauchySchwarz_of_boundedContinuous_of_density
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (hcmeas : Measurable c)
    (hfcont : ∀ j, Continuous (f j))
    (B0 B1 B2 B3 : ℝ)
    (hB0 : 0 ≤ B0) (hB1 : 0 ≤ B1) (hB2 : 0 ≤ B2) (hB3 : 0 ≤ B3)
    (hf0 : ∀ y, |f 0 y| ≤ B0) (hf1 : ∀ y, |f 1 y| ≤ B1)
    (hf2 : ∀ y, |f 2 y| ≤ B2) (hf3 : ∀ y, |f 3 y| ≤ B3)
    (hweightint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    |expandedModelLocalForm α S u c f| ^ 2 ≤
      modelEnergyOne α S u f * modelEnergyTwo α S u (f 3) := by
  apply expandedModelLocalForm_cauchySchwarz_of_continuous_weighted
    α S u c f hcmeas hfcont
  · exact integrable_modelFirstWeightedFactor_sq_of_density
      α S u f hfcont B0 B1 B2 hB0 hB1 hB2 hf0 hf1 hf2 hweightint
  · exact integrable_modelSecondWeightedFactor_sq_of_density
      α S u (f 3) (hfcont 3) B3 hB3 hf3 hweightint
  · exact hc

/-- The usual existential uniform bounds are sufficient for the local
Cauchy--Schwarz conclusion once the positive density has been localized. -/
theorem expandedModelLocalForm_cauchySchwarz_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (hcmeas : Measurable c)
    (hfcont : ∀ j, Continuous (f j))
    (hfbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hweightint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    |expandedModelLocalForm α S u c f| ^ 2 ≤
      modelEnergyOne α S u f * modelEnergyTwo α S u (f 3) := by
  rcases hfbound 0 with ⟨B0, hB0, hf0⟩
  rcases hfbound 1 with ⟨B1, hB1, hf1⟩
  rcases hfbound 2 with ⟨B2, hB2, hf2⟩
  rcases hfbound 3 with ⟨B3, hB3, hf3⟩
  exact expandedModelLocalForm_cauchySchwarz_of_boundedContinuous_of_density
    α S u c f hcmeas hfcont B0 B1 B2 B3 hB0 hB1 hB2 hB3
      hf0 hf1 hf2 hf3 hweightint hc

/-- A square-form local estimate and two nonnegative energy estimates combine
without choosing square roots of the implicit constants. -/
theorem abs_le_of_square_energy_bounds
    {L E₁ E₂ A B C₁ C₂ : ℝ}
    (hcs : |L| ^ 2 ≤ E₁ * E₂)
    (_hE₁ : 0 ≤ E₁) (hE₂ : 0 ≤ E₂)
    (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hC₁ : 0 ≤ C₁) (hC₂ : 0 ≤ C₂)
    (hbound₁ : E₁ ≤ C₁ * A ^ 2)
    (hbound₂ : E₂ ≤ C₂ * B ^ 2) :
    |L| ≤ (C₁ * C₂ + 1) * A * B := by
  have hC : 0 ≤ C₁ * C₂ := mul_nonneg hC₁ hC₂
  have hAB : 0 ≤ A * B := mul_nonneg hA hB
  have hright : 0 ≤ (C₁ * C₂ + 1) * A * B := by positivity
  have hfirstBound : 0 ≤ C₁ * A ^ 2 :=
    mul_nonneg hC₁ (sq_nonneg A)
  have hsecondBound : 0 ≤ C₂ * B ^ 2 :=
    mul_nonneg hC₂ (sq_nonneg B)
  have hprod : E₁ * E₂ ≤ (C₁ * A ^ 2) * (C₂ * B ^ 2) := by
    exact mul_le_mul hbound₁ hbound₂ hE₂ hfirstBound
  have hcoeff : C₁ * C₂ ≤ (C₁ * C₂ + 1) ^ 2 := by nlinarith
  have hsq : |L| ^ 2 ≤ ((C₁ * C₂ + 1) * A * B) ^ 2 := by
    calc
      |L| ^ 2 ≤ E₁ * E₂ := hcs
      _ ≤ (C₁ * A ^ 2) * (C₂ * B ^ 2) := hprod
      _ = (C₁ * C₂) * (A * B) ^ 2 := by ring
      _ ≤ (C₁ * C₂ + 1) ^ 2 * (A * B) ^ 2 :=
        mul_le_mul_of_nonneg_right hcoeff (sq_nonneg _)
      _ = ((C₁ * C₂ + 1) * A * B) ^ 2 := by ring
  exact (sq_le_sq₀ (abs_nonneg L) hright).mp hsq


/-- The finite ancestor family used in the stopping datum of Section 6. -/
noncomputable def stoppingAncestors
    (α : Anisotropy) (S : BoxCollection α) (q : AnisoBox α) :
    BoxCollection α := by
  classical
  exact S.filter fun r ↦ boxSet α q ⊆ boxSet α r

/-- The stopping datum `a(Q)`: the largest one-box local size among the
ancestors of `Q` which remain in the ambient finite collection. -/
noncomputable def stoppingData
    (α : Anisotropy) (S : BoxCollection α) (s : ℝ) (f : E3 → ℝ)
    (q : AnisoBox α) : ℝ :=
  if h : (stoppingAncestors α S q).Nonempty then
    (stoppingAncestors α S q).sup' h (boxLocalSize α s f)
  else 0

theorem mem_stoppingAncestors
    (α : Anisotropy) (S : BoxCollection α) {q : AnisoBox α}
    (hq : q ∈ S) : q ∈ stoppingAncestors α S q := by
  simp [stoppingAncestors, hq]

theorem stoppingAncestors_nonempty
    (α : Anisotropy) (S : BoxCollection α) {q : AnisoBox α}
    (hq : q ∈ S) : (stoppingAncestors α S q).Nonempty :=
  ⟨q, mem_stoppingAncestors α S hq⟩

theorem stoppingData_eq_sup'
    (α : Anisotropy) (S : BoxCollection α) (s : ℝ) (f : E3 → ℝ)
    {q : AnisoBox α} (hq : q ∈ S) :
    stoppingData α S s f q =
      (stoppingAncestors α S q).sup'
        (stoppingAncestors_nonempty α S hq) (boxLocalSize α s f) := by
  simp only [stoppingData]
  rw [dif_pos (stoppingAncestors_nonempty α S hq)]

theorem stoppingAncestors_antitone
    (α : Anisotropy) (S : BoxCollection α) {q r : AnisoBox α}
    (hqr : boxSet α q ⊆ boxSet α r) :
    stoppingAncestors α S r ⊆ stoppingAncestors α S q := by
  classical
  intro w hw
  rw [stoppingAncestors, Finset.mem_filter] at hw ⊢
  exact ⟨hw.1, hqr.trans hw.2⟩

/-- Ancestor maxima decrease as boxes get larger. -/
theorem stoppingData_antitone
    (α : Anisotropy) (S : BoxCollection α) (s : ℝ) (f : E3 → ℝ)
    {q r : AnisoBox α} (hq : q ∈ S) (hr : r ∈ S)
    (hqr : boxSet α q ⊆ boxSet α r) :
    stoppingData α S s f r ≤ stoppingData α S s f q := by
  rw [stoppingData_eq_sup' α S s f hq,
    stoppingData_eq_sup' α S s f hr]
  apply Finset.sup'_le
  intro w hw
  exact Finset.le_sup' (boxLocalSize α s f)
    (stoppingAncestors_antitone α S hqr hw)

/-- The finite dyadic stopping level indexed by a vector of integer levels.
It is exactly the source interval `(2^(n_j-1), 2^n_j]` applied to each
ancestor maximum. -/
noncomputable def stoppingLevel {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) : BoxCollection α := by
  classical
  exact S.filter fun q ↦ ∀ j,
    (2 : ℝ) ^ (n j - 1) < stoppingData α S (s j) (f j) q ∧
      stoppingData α S (s j) (f j) q ≤ (2 : ℝ) ^ n j

theorem mem_stoppingLevel_iff {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) (q : AnisoBox α) :
    q ∈ stoppingLevel α S s f n ↔ q ∈ S ∧ ∀ j,
      (2 : ℝ) ^ (n j - 1) < stoppingData α S (s j) (f j) q ∧
        stoppingData α S (s j) (f j) q ≤ (2 : ℝ) ^ n j := by
  simp [stoppingLevel]

/-- The maximal members of one finite stopping level. -/
noncomputable def stoppingRoots {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) : BoxCollection α := by
  classical
  let L := stoppingLevel α S s f n
  exact L.filter fun q ↦ ∀ r ∈ L, boxSet α q ⊆ boxSet α r → r = q

theorem mem_stoppingRoots_iff {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) (q : AnisoBox α) :
    q ∈ stoppingRoots α S s f n ↔
      q ∈ stoppingLevel α S s f n ∧
        ∀ r ∈ stoppingLevel α S s f n,
          boxSet α q ⊆ boxSet α r → r = q := by
  classical
  simp [stoppingRoots]

/-- The boxes of the stopping tree below one designated stopping root. -/
noncomputable def stoppingTreeBoxes {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) (Q : AnisoBox α) :
    BoxCollection α := by
  classical
  exact (stoppingLevel α S s f n).filter fun q ↦
    boxSet α q ⊆ boxSet α Q

theorem mem_stoppingTreeBoxes_iff {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ)
    (Q q : AnisoBox α) :
    q ∈ stoppingTreeBoxes α S s f n Q ↔
      q ∈ stoppingLevel α S s f n ∧ boxSet α q ⊆ boxSet α Q := by
  classical
  simp [stoppingTreeBoxes]

/-- Each stopping level is convex in the anisotropic dyadic grid. -/
theorem isConvexCollection_stoppingLevel {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (s : Fin d → ℝ) (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) :
    IsConvexCollection α (stoppingLevel α S s f n) := by
  intro q r w hq hr hqw hwr
  rw [mem_stoppingLevel_iff] at hq hr ⊢
  have hwS : w ∈ S := hS (q := q) (r := r) (w := w) hq.1 hr.1 hqw hwr
  refine ⟨hwS, ?_⟩
  intro j
  have hwq : stoppingData α S (s j) (f j) w ≤
      stoppingData α S (s j) (f j) q :=
    stoppingData_antitone (q := q) (r := w) α S (s j) (f j)
      hq.1 hwS hqw
  have hrw : stoppingData α S (s j) (f j) r ≤
      stoppingData α S (s j) (f j) w :=
    stoppingData_antitone (q := w) (r := r) α S (s j) (f j)
      hwS hr.1 hwr
  exact ⟨lt_of_lt_of_le (hr.2 j).1 hrw,
    le_trans hwq (hq.2 j).2⟩

/-- Package the boxes below a maximal stopping root as the literal finite
convex tree used in the forest estimate. -/
noncomputable def stoppingTree {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ)
    (hconvex : IsConvexCollection α (stoppingLevel α S s f n))
    (Q : AnisoBox α) (hQ : Q ∈ stoppingRoots α S s f n) :
    FiniteConvexTree α := by
  let L := stoppingLevel α S s f n
  let U := stoppingTreeBoxes α S s f n Q
  have hQL : Q ∈ L := (mem_stoppingRoots_iff α S s f n Q).mp hQ |>.1
  have hQU : Q ∈ U := by
    rw [mem_stoppingTreeBoxes_iff]
    exact ⟨hQL, Set.Subset.rfl⟩
  exact
    { boxes := U
      nonempty := ⟨Q, hQU⟩
      root := Q
      root_mem := hQU
      convex := by
        intro q r w hq hr hqw hwr
        rw [mem_stoppingTreeBoxes_iff] at hq hr ⊢
        refine ⟨hconvex hq.1 hr.1 hqw hwr, ?_⟩
        exact hwr.trans hr.2
      below_root := by
        intro q hq
        exact (mem_stoppingTreeBoxes_iff α S s f n Q q).mp hq |>.2 }

theorem stoppingTree_boxes {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ)
    (hconvex : IsConvexCollection α (stoppingLevel α S s f n))
    (Q : AnisoBox α) (hQ : Q ∈ stoppingRoots α S s f n) :
    (stoppingTree α S s f n hconvex Q hQ).boxes =
      stoppingTreeBoxes α S s f n Q := rfl

theorem stoppingTree_root {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ)
    (hconvex : IsConvexCollection α (stoppingLevel α S s f n))
    (Q : AnisoBox α) (hQ : Q ∈ stoppingRoots α S s f n) :
    (stoppingTree α S s f n hconvex Q hQ).root = Q := rfl

/-- The two local-energy bounds with powers `50` and `100` give the source
local-model estimate with translation power `75`.  All analytic content stays
in the two displayed energy hypotheses; this lemma only records their exact
positive algebraic synthesis. -/
theorem localModelEstimate_of_energyBounds
    (α : Anisotropy) (T : FiniteConvexTree α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (C₁ C₂ : ℝ)
    (hC₁ : 0 ≤ C₁) (hC₂ : 0 ≤ C₂)
    (hcs : |expandedModelLocalForm α T.boxes u c f| ^ 2 ≤
      modelEnergyOne α T.boxes u f * modelEnergyTwo α T.boxes u (f 3))
    (hE₁ : modelEnergyOne α T.boxes u f ≤
      C₁ * sourceWeight u ^ 50 * boxMass α T.root *
        (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
          treeLocalSize T 4 (f 2)) ^ 2)
    (hE₂ : modelEnergyTwo α T.boxes u (f 3) ≤
      C₂ * sourceWeight u ^ 100 * boxMass α T.root *
        treeLocalSize T 2 (f 3) ^ 2) :
    |expandedModelLocalForm α T.boxes u c f| ≤
      (C₁ * C₂ + 1) * sourceWeight u ^ 75 * boxMass α T.root *
        (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
          treeLocalSize T 4 (f 2)) * treeLocalSize T 2 (f 3) := by
  let P : ℝ := treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
    treeLocalSize T 4 (f 2)
  let M : ℝ := treeLocalSize T 2 (f 3)
  let A : ℝ := sourceWeight u ^ 25 * √(boxMass α T.root) * P
  let B : ℝ := sourceWeight u ^ 50 * √(boxMass α T.root) * M
  have hU : 0 ≤ sourceWeight u := sourceWeight_nonneg u
  have hmass : 0 ≤ boxMass α T.root := (boxMass_pos α T.root).le
  have hP : 0 ≤ P := by
    dsimp [P]
    exact mul_nonneg
      (mul_nonneg (treeLocalSize_four_nonneg T (f 0))
        (treeLocalSize_four_nonneg T (f 1)))
      (treeLocalSize_four_nonneg T (f 2))
  have hM : 0 ≤ M := by
    dsimp [M]
    exact treeLocalSize_two_nonneg T (f 3)
  have hA : 0 ≤ A := by
    dsimp [A]
    positivity
  have hB : 0 ≤ B := by
    dsimp [B]
    positivity
  have hA_sq : A ^ 2 = sourceWeight u ^ 50 * boxMass α T.root * P ^ 2 := by
    dsimp [A]
    rw [mul_pow, mul_pow, ← pow_mul, show 25 * 2 = 50 by norm_num,
      Real.sq_sqrt hmass]
  have hB_sq : B ^ 2 = sourceWeight u ^ 100 * boxMass α T.root * M ^ 2 := by
    dsimp [B]
    rw [mul_pow, mul_pow, ← pow_mul, show 50 * 2 = 100 by norm_num,
      Real.sq_sqrt hmass]
  have hbound₁ : modelEnergyOne α T.boxes u f ≤ C₁ * A ^ 2 := by
    rw [hA_sq]
    calc
      modelEnergyOne α T.boxes u f ≤
          C₁ * sourceWeight u ^ 50 * boxMass α T.root * P ^ 2 := by
            simpa only [P] using hE₁
      _ = C₁ * (sourceWeight u ^ 50 * boxMass α T.root * P ^ 2) := by ring
  have hbound₂ : modelEnergyTwo α T.boxes u (f 3) ≤ C₂ * B ^ 2 := by
    rw [hB_sq]
    calc
      modelEnergyTwo α T.boxes u (f 3) ≤
          C₂ * sourceWeight u ^ 100 * boxMass α T.root * M ^ 2 := by
            simpa only [M] using hE₂
      _ = C₂ * (sourceWeight u ^ 100 * boxMass α T.root * M ^ 2) := by ring
  have hmain := abs_le_of_square_energy_bounds hcs
    (modelEnergyOne_nonneg α T.boxes u f)
    (modelEnergyTwo_nonneg α T.boxes u (f 3)) hA hB hC₁ hC₂ hbound₁ hbound₂
  calc
    |expandedModelLocalForm α T.boxes u c f| ≤ (C₁ * C₂ + 1) * A * B := hmain
    _ = (C₁ * C₂ + 1) * sourceWeight u ^ 75 * boxMass α T.root * P * M := by
      dsimp [A, B]
      calc
        (C₁ * C₂ + 1) *
            (sourceWeight u ^ 25 * √(boxMass α T.root) * P) *
            (sourceWeight u ^ 50 * √(boxMass α T.root) * M) =
            (C₁ * C₂ + 1) *
              (sourceWeight u ^ 25 * sourceWeight u ^ 50) *
              (√(boxMass α T.root) * √(boxMass α T.root)) * P * M := by ring
        _ = _ := by
          rw [← pow_add, show 25 + 50 = 75 by norm_num,
            Real.mul_self_sqrt hmass]
    _ = _ := by rfl

/-- A raw one-dimensional Plancherel identity on the elementary inversion
domain.  This is deliberately stated with the exact `L¹` hypotheses needed by
Mathlib's Fourier inversion theorem, so it can be applied to a Schwartz fiber
after the physical convolution calculation. -/
theorem integral_norm_sq_fourier_eq_of_integrable
    {f : ℝ → ℂ} (hfcont : Continuous f) (hf : Integrable f)
    (hfourier : Integrable (𝓕 f)) :
    (∫ ξ : ℝ, ‖𝓕 f ξ‖ ^ 2) = ∫ x : ℝ, ‖f x‖ ^ 2 := by
  have hinv : 𝓕⁻ (𝓕 f) = f :=
    hfcont.fourierInv_fourier_eq hf hfourier
  have hsesq := VectorFourier.integral_sesq_fourierIntegral_eq_neg_flip
    (μ := (volume : Measure ℝ)) (ν := (volume : Measure ℝ))
    (L := innerₗ ℝ) (e := Real.fourierChar) (f := f) (g := 𝓕 f)
    (innerSL ℂ) Real.continuous_fourierChar continuous_inner hf hfourier
  have hfourier_apply (x : ℝ) :
      VectorFourier.fourierIntegral 𝐞 volume (innerₗ ℝ) f x = 𝓕 f x := rfl
  have hfourierInv_apply (x : ℝ) :
      VectorFourier.fourierIntegral 𝐞 volume (-(innerₗ ℝ).flip) (𝓕 f) x =
        𝓕⁻ (𝓕 f) x := by
    rw [flip_innerₗ]
    rfl
  simp_rw [hfourier_apply, hfourierInv_apply] at hsesq
  rw [hinv] at hsesq
  change (∫ ξ : ℝ, ‖𝓕 f ξ‖ ^ 2) = ∫ x : ℝ, ‖f x‖ ^ 2
  apply Complex.ofRealLI.injective
  simpa [← LinearIsometry.integral_comp_comm, inner_self_eq_norm_sq_to_K] using hsesq

/-- The source stopping exponents for the initial model range: three fourth
local sizes and one second local size. -/
def sourceStoppingExponent : Fin 4 → ℝ :=
  fun j ↦ if j = 3 then 2 else 4

theorem sourceStopping_treeLocalSize_product
    (α : Anisotropy) (T : FiniteConvexTree α) (f : ModelRealInput) :
    (∏ j : Fin 4, treeLocalSize T (sourceStoppingExponent j) (f j)) =
      (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
        treeLocalSize T 4 (f 2)) * treeLocalSize T 2 (f 3) := by
  simp [Fin.prod_univ_succ, sourceStoppingExponent]
  ring

/-- A single source stopping tree satisfies the local-model bound in exactly
the weighted form summed by the stopping-forest estimate. -/
theorem stoppingTree_localModel_bound_of_energyBounds
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (f : ModelRealInput) (C₁ C₂ : ℝ)
    (hC₁ : 0 ≤ C₁) (hC₂ : 0 ≤ C₂)
    (n : Fin 4 → ℤ)
    (Q : {Q : AnisoBox α // Q ∈ stoppingRoots α S sourceStoppingExponent f n})
    (hcs : |expandedModelLocalForm α
      (stoppingTree α S sourceStoppingExponent f n
        (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
        Q.1 Q.2).boxes u c f| ^ 2 ≤
      modelEnergyOne α
        (stoppingTree α S sourceStoppingExponent f n
          (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
          Q.1 Q.2).boxes u f *
        modelEnergyTwo α
          (stoppingTree α S sourceStoppingExponent f n
            (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
            Q.1 Q.2).boxes u (f 3))
    (hE₁ : modelEnergyOne α
      (stoppingTree α S sourceStoppingExponent f n
        (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
        Q.1 Q.2).boxes u f ≤
      C₁ * sourceWeight u ^ 50 *
        boxMass α
          (stoppingTree α S sourceStoppingExponent f n
            (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
            Q.1 Q.2).root *
        (treeLocalSize
            (stoppingTree α S sourceStoppingExponent f n
              (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
              Q.1 Q.2)
            4 (f 0) *
          treeLocalSize
            (stoppingTree α S sourceStoppingExponent f n
              (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
              Q.1 Q.2)
            4 (f 1) *
          treeLocalSize
            (stoppingTree α S sourceStoppingExponent f n
              (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
              Q.1 Q.2)
            4 (f 2)) ^ 2)
    (hE₂ : modelEnergyTwo α
      (stoppingTree α S sourceStoppingExponent f n
        (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
        Q.1 Q.2).boxes u (f 3) ≤
      C₂ * sourceWeight u ^ 100 *
        boxMass α
          (stoppingTree α S sourceStoppingExponent f n
            (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
            Q.1 Q.2).root *
        treeLocalSize
          (stoppingTree α S sourceStoppingExponent f n
            (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
            Q.1 Q.2)
          2 (f 3) ^ 2) :
    |expandedModelLocalForm α
        (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f| ≤
      (C₁ * C₂ + 1) * sourceWeight u ^ 75 * boxMass α Q.1 *
        (∏ j : Fin 4,
          treeLocalSize
            (stoppingTree α S sourceStoppingExponent f n
              (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
              Q.1 Q.2)
            (sourceStoppingExponent j) (f j)) := by
  let T := stoppingTree α S sourceStoppingExponent f n
    (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
    Q.1 Q.2
  have hmain := localModelEstimate_of_energyBounds α T u c f C₁ C₂ hC₁ hC₂
    hcs hE₁ hE₂
  calc
    |expandedModelLocalForm α
        (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f| =
        |expandedModelLocalForm α T.boxes u c f| := by
      rw [stoppingTree_boxes]
    _ ≤ (C₁ * C₂ + 1) * sourceWeight u ^ 75 * boxMass α T.root *
        (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
          treeLocalSize T 4 (f 2)) * treeLocalSize T 2 (f 3) := hmain
    _ = (C₁ * C₂ + 1) * sourceWeight u ^ 75 * boxMass α Q.1 *
        (∏ j : Fin 4, treeLocalSize T (sourceStoppingExponent j) (f j)) := by
      rw [stoppingTree_root]
      calc
        (C₁ * C₂ + 1) * sourceWeight u ^ 75 * boxMass α Q.1 *
              (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
                treeLocalSize T 4 (f 2)) * treeLocalSize T 2 (f 3) =
            (C₁ * C₂ + 1) * sourceWeight u ^ 75 * boxMass α Q.1 *
              ((treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
                treeLocalSize T 4 (f 2)) * treeLocalSize T 2 (f 3)) := by ring
        _ = _ := by
          rw [← sourceStopping_treeLocalSize_product α T f]

/-! ### The literal full-scale spatial model profile -/

/-- A real Schwartz four-tuple for the full model form. -/
abbrev ModelSchwartzInput := Fin 4 → SchwartzMap E3 ℝ

/-- The unscaled first and second coordinate kernel
`\(\mathsf g * \varphi_{1,u}\)`. -/
noncomputable def ModelLowKernel (u w : ℝ) : ℝ :=
  ∫ z : ℝ, gaussian z * conePhiPhysicalReal (w - z - u)

/-- The unscaled third coordinate kernel
`\(\mathsf h * \mathsf h * \psi_{1,u}\)`. -/
noncomputable def ModelThirdKernel (u w : ℝ) : ℝ :=
  ∫ z : ℝ, gaussianDeriv z * modelThirdKernel (-u) 1 0 (w - z)

/-- One coordinate convolution in the source convention, written after the
change from the sampled coordinate to its displacement from `x`. -/
noncomputable def ModelCoordinateConvolution
    (i : Fin 3) (f : E3 → ℝ) (k : ℝ → ℝ) (s : ℝ) (x : E3) : ℝ :=
  ∫ r : ℝ, f (x - r • Anisotropy.coordinateDirection i) * kernelDilate k s r

/-- The spatial integrand in the source's unexpanded model form at one
positive scale.  The three coordinate kernels are exactly the kernels in
Definition `def:model`; the scale coefficient is deliberately not included. -/
noncomputable def ModelSpatialIntegrand
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput)
    (t : ℝ) (x : E3) : ℝ :=
  F 0 x *
    ModelCoordinateConvolution 0 (F 1)
      (ModelLowKernel (u 0)) (t ^ α.weight 0) x *
    ModelCoordinateConvolution 1 (F 2)
      (ModelLowKernel (u 1)) (t ^ α.weight 1) x *
    ModelCoordinateConvolution 2 (F 3)
      (ModelThirdKernel (u 2)) (t ^ α.weight 2) x

@[simp] theorem faceInsert_zero_coordinateSplit_modelPoint
    (a b c x : ℝ) :
    faceInsert 0 x (coordinateSplit 0 (modelPoint a b c)).2 =
      modelPoint x b c := by
  ext j
  fin_cases j <;> simp [faceInsert, coordinateSplit, modelPoint]

@[simp] theorem faceInsert_one_coordinateSplit_modelPoint
    (a b c x : ℝ) :
    faceInsert 1 x (coordinateSplit 1 (modelPoint a b c)).2 =
      modelPoint a x c := by
  ext j
  fin_cases j <;> simp [faceInsert, coordinateSplit, modelPoint]

@[simp] theorem faceInsert_two_coordinateSplit_modelPoint
    (a b c x : ℝ) :
    faceInsert 2 x (coordinateSplit 2 (modelPoint a b c)).2 =
      modelPoint a b x := by
  ext j
  fin_cases j <;> simp [faceInsert, coordinateSplit, modelPoint]

local instance : Fact (0 < (8 : ℝ)) := ⟨by norm_num⟩


/-- **`lem:localization`** (Localization sign and integrability).

The local forms and energies are finite on bounded continuous inputs for
finite collections.  On Schwartz inputs, replacing the region in `L` by
`E_3 × (a,b)` gives exactly `Λ^{a,b}_{u,c}`.

This is the signed expansion of the local form as a joint integral. -/
theorem lem_localization
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      c q.1.2 *
        (modelFirstFiber α f q.1.1 q.1.2 q.2 *
          modelSecondFiber α (f 3) q.1.1 q.1.2 q.2 *
            modelSignedDensity α u q.1.1 q.1.2 q.2))
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)) :
    expandedModelLocalForm α S u c f =
      -(∫ q : (E3 × ℝ) × ModelE5,
        c q.1.2 *
          (modelFirstFiber α f q.1.1 q.1.2 q.2 *
            modelSecondFiber α (f 3) q.1.1 q.1.2 q.2 *
              modelSignedDensity α u q.1.1 q.1.2 q.2)
        ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)) :=
  expandedModelLocalForm_eq_neg_jointIntegral_of_integrable α S u c f hjoint

/-- **`lem:local_cs`** (First local Cauchy--Schwarz).

For real inputs and possibly complex `c`,
`|L_{Q,u,c}(f)|^2 ≤ E_{1,Q,u}(f_0,f_1,f_2) E_{2,Q,u}(f_3)`. -/
theorem lem_local_cs
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (hcmeas : Measurable c)
    (hfcont : ∀ j, Continuous (f j))
    (hfbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hweightint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    |expandedModelLocalForm α S u c f| ^ 2 ≤
      modelEnergyOne α S u f * modelEnergyTwo α S u (f 3) :=
  expandedModelLocalForm_cauchySchwarz_of_boundedContinuous α S u c f hcmeas hfcont hfbound hweightint hc

/-- **`lem:global_energy`** (Global second energy).

For real `f ∈ L^2(E_3)`,
`E_{2,E_3×(0,∞),u}(f) = ‖φ‖_1^2 ‖ψ‖_1 (π/α_3) ‖f‖_2^2`; the energies add over
disjoint regions.

This is the joint-integral form of the second energy on a region, which is
what the additivity is read from. -/
theorem lem_global_energy
    (α : Anisotropy) (V : Set (E3 × ℝ)) (u : E3) (f : E3 → ℝ)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyTwoIntegrand α u f q.1 q.2)
      ((cubeScaleMeasure.restrict V).prod volume)) :
    modelEnergyTwoOn α V u f =
      ∫ q : (E3 × ℝ) × ModelE5,
        modelEnergyTwoIntegrand α u f q.1 q.2
        ∂((cubeScaleMeasure.restrict V).prod volume) :=
  modelEnergyTwoOn_eq_jointIntegral_of_integrable α V u f hjoint

/-- **`cor:local_model`** (Local model estimate).

`|L_{T,u,c}(f)| ≤ C U(u)^{75} |Q_T| (∏_{j=0}^2 M_{T,4}(f_j)) M_{T,2}(f_3)`. -/
theorem cor_local_model
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (f : ModelRealInput) (C₁ C₂ : ℝ)
    (hC₁ : 0 ≤ C₁) (hC₂ : 0 ≤ C₂)
    (n : Fin 4 → ℤ)
    (Q : {Q : AnisoBox α // Q ∈ stoppingRoots α S sourceStoppingExponent f n})
    (hcs : |expandedModelLocalForm α
      (stoppingTree α S sourceStoppingExponent f n
        (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
        Q.1 Q.2).boxes u c f| ^ 2 ≤
      modelEnergyOne α
        (stoppingTree α S sourceStoppingExponent f n
          (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
          Q.1 Q.2).boxes u f *
        modelEnergyTwo α
          (stoppingTree α S sourceStoppingExponent f n
            (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
            Q.1 Q.2).boxes u (f 3))
    (hE₁ : modelEnergyOne α
      (stoppingTree α S sourceStoppingExponent f n
        (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
        Q.1 Q.2).boxes u f ≤
      C₁ * sourceWeight u ^ 50 *
        boxMass α
          (stoppingTree α S sourceStoppingExponent f n
            (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
            Q.1 Q.2).root *
        (treeLocalSize
            (stoppingTree α S sourceStoppingExponent f n
              (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
              Q.1 Q.2)
            4 (f 0) *
          treeLocalSize
            (stoppingTree α S sourceStoppingExponent f n
              (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
              Q.1 Q.2)
            4 (f 1) *
          treeLocalSize
            (stoppingTree α S sourceStoppingExponent f n
              (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
              Q.1 Q.2)
            4 (f 2)) ^ 2)
    (hE₂ : modelEnergyTwo α
      (stoppingTree α S sourceStoppingExponent f n
        (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
        Q.1 Q.2).boxes u (f 3) ≤
      C₂ * sourceWeight u ^ 100 *
        boxMass α
          (stoppingTree α S sourceStoppingExponent f n
            (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
            Q.1 Q.2).root *
        treeLocalSize
          (stoppingTree α S sourceStoppingExponent f n
            (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
            Q.1 Q.2)
          2 (f 3) ^ 2) :
    |expandedModelLocalForm α
        (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f| ≤
      (C₁ * C₂ + 1) * sourceWeight u ^ 75 * boxMass α Q.1 *
        (∏ j : Fin 4,
          treeLocalSize
            (stoppingTree α S sourceStoppingExponent f n
              (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
              Q.1 Q.2)
            (sourceStoppingExponent j) (f j)) :=
  stoppingTree_localModel_bound_of_energyBounds α S hS u c f C₁ C₂ hC₁ hC₂ n Q hcs hE₁ hE₂

