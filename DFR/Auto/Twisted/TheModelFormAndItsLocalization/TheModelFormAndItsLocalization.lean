  unfold modelEnergyTwo
  apply modelEnergyTwoOn_nonneg
  · exact measurableSet_collectionRegion α S
  intro pt hpt
  exact pos_of_mem_closure_collectionRegion α S (subset_closure hpt)


/-- The nonnegative-energy integrand before integration in the five fiber
variables.  Naming it isolates all measure-theoretic region arguments from
the later Fourier calculation. -/
noncomputable def modelEnergyTwoIntegrand
    (α : Anisotropy) (u : E3) (f : E3 → ℝ)
    (pt : E3 × ℝ) (z : ModelE5) : ℝ :=
  (modelSecondFiber α f pt.1 pt.2 z) ^ 2 *
    modelEnergyDensity α u pt.1 pt.2 z

/-- The outer fiber integral defining the second model energy. -/
noncomputable def modelEnergyTwoOuter
    (α : Anisotropy) (u : E3) (f : E3 → ℝ) (pt : E3 × ℝ) : ℝ :=
  ∫ z : ModelE5, modelEnergyTwoIntegrand α u f pt z

theorem modelEnergyTwoOn_eq_integral_outer
    (α : Anisotropy) (V : Set (E3 × ℝ)) (u : E3) (f : E3 → ℝ) :
    modelEnergyTwoOn α V u f =
      ∫ pt : E3 × ℝ, modelEnergyTwoOuter α u f pt
        ∂(cubeScaleMeasure.restrict V) := by
  rfl

/-- At a nonnegative scale, the literal second-energy joint integrand is
nonnegative. -/
theorem modelEnergyTwoIntegrand_nonneg
    (α : Anisotropy) (u : E3) (f : E3 → ℝ)
    (pt : E3 × ℝ) (ht : 0 ≤ pt.2) (z : ModelE5) :
    0 ≤ modelEnergyTwoIntegrand α u f pt z := by
  unfold modelEnergyTwoIntegrand
  exact mul_nonneg (sq_nonneg _) (modelEnergyDensity_nonneg α u pt.1 ht z)

/-- The outer fiber integral is nonnegative at a nonnegative scale. -/
theorem modelEnergyTwoOuter_nonneg
    (α : Anisotropy) (u : E3) (f : E3 → ℝ)
    (pt : E3 × ℝ) (ht : 0 ≤ pt.2) :
    0 ≤ modelEnergyTwoOuter α u f pt := by
  unfold modelEnergyTwoOuter
  exact integral_nonneg fun z ↦
    modelEnergyTwoIntegrand_nonneg α u f pt ht z

