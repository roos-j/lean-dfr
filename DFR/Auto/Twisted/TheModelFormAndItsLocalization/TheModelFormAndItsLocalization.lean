/-- Positive normalized dilation and translation preserve the `L¹` mass of
the absolute Gaussian derivative. -/
theorem integral_abs_gaussianDerivAt {s : ℝ} (hs : 0 < s) (a : ℝ) :
    ∫ x : ℝ, |gaussianDerivAt s a x| = ∫ x : ℝ, |gaussianDeriv x| := by
  unfold gaussianDerivAt kernelAt kernelDilate
  have hinv : 0 ≤ s⁻¹ := (inv_pos.mpr hs).le
  calc
    (∫ x : ℝ, |s⁻¹ • gaussianDeriv ((x - a) / s)|) =
        ∫ x : ℝ, s⁻¹ • |gaussianDeriv ((x - a) / s)| := by
          apply integral_congr_ae
          filter_upwards [] with x
          simp only [smul_eq_mul, abs_mul, abs_of_nonneg hinv]
    _ = s⁻¹ • ∫ x : ℝ, |gaussianDeriv ((x - a) / s)| := by
          rw [integral_smul]
    _ = _ := by
      rw [integral_sub_right_eq_self (μ := volume)
        (fun x : ℝ ↦ |gaussianDeriv (x / s)|) a]
      rw [Measure.integral_comp_div (fun x : ℝ ↦ |gaussianDeriv x|) s]
      simp [smul_eq_mul, abs_of_pos hs, hs.ne']

/-- The absolute Gaussian-derivative mass is finite. -/
theorem integrable_abs_gaussianDerivAt {s : ℝ} (hs : 0 < s) (a : ℝ) :
    Integrable (fun x : ℝ ↦ |gaussianDerivAt s a x|) := by
  have hbase : Integrable (fun x : ℝ ↦ |gaussianDeriv x|) := by
    simpa only [Real.norm_eq_abs] using integrable_gaussianDeriv.norm
  unfold gaussianDerivAt kernelAt kernelDilate
  refine (((hbase.comp_div hs.ne').comp_sub_right a).smul (s⁻¹ : ℝ)).congr ?_
  filter_upwards [] with x
  simp only [Pi.smul_apply, smul_eq_mul, abs_mul,
    abs_of_pos (inv_pos.mpr hs)]

/-- A single varying coordinate of `modelPoint` is continuous. -/
theorem continuous_modelPoint_third (a b : ℝ) :
    Continuous (fun v : ℝ ↦ modelPoint a b v) := by
  have hcoords : Continuous (fun v : ℝ ↦ fun i : Fin 3 ↦
      if i = 0 then a else if i = 1 then b else v) := by
    apply continuous_pi
    intro i
    fin_cases i
    · exact continuous_const
    · exact continuous_const
    · exact continuous_id
  change Continuous (WithLp.toLp 2 ∘ fun v : ℝ ↦ fun i : Fin 3 ↦
    if i = 0 then a else if i = 1 then b else v)
  exact (PiLp.continuous_toLp 2 (fun _ : Fin 3 ↦ ℝ)).comp hcoords

/-- The integrand of the first fiber is integrable under uniform continuous
input bounds. -/
theorem integrable_modelFirstFiber_integrand
    (α : Anisotropy) (f : ModelRealInput) (p : E3) {t : ℝ} (z : ModelE5)
    (hfcont : ∀ j, Continuous (f j))
    (B0 B1 B2 : ℝ) (hB0 : 0 ≤ B0) (hB1 : 0 ≤ B1) (_hB2 : 0 ≤ B2)
    (hf0 : ∀ y, |f 0 y| ≤ B0) (hf1 : ∀ y, |f 1 y| ≤ B1)
    (hf2 : ∀ y, |f 2 y| ≤ B2)
    (ht : 0 < t) :
    Integrable (fun v : ℝ ↦
      f 0 (modelPoint (z 0) (z 1) v) *
      f 1 (modelPoint (z 2) (z 1) v) *
      f 2 (modelPoint (z 0) (z 3) v) *
      gaussianDerivAt (t ^ α.weight 2) (p 2) v) := by
  have hs : 0 < t ^ α.weight 2 := pow_pos ht _
  have hk := integrable_abs_gaussianDerivAt hs (p 2)
  have h0 : Continuous (fun v : ℝ ↦ f 0 (modelPoint (z 0) (z 1) v)) :=
    (hfcont 0).comp (continuous_modelPoint_third _ _)
  have h1 : Continuous (fun v : ℝ ↦ f 1 (modelPoint (z 2) (z 1) v)) :=
    (hfcont 1).comp (continuous_modelPoint_third _ _)
  have h2 : Continuous (fun v : ℝ ↦ f 2 (modelPoint (z 0) (z 3) v)) :=
    (hfcont 2).comp (continuous_modelPoint_third _ _)
  have hkmeas : AEStronglyMeasurable
      (fun v : ℝ ↦ gaussianDerivAt (t ^ α.weight 2) (p 2) v) volume :=
    (integrable_gaussianDerivAt hs (p 2)).aestronglyMeasurable
  have hmeas : AEStronglyMeasurable (fun v : ℝ ↦
      f 0 (modelPoint (z 0) (z 1) v) *
      f 1 (modelPoint (z 2) (z 1) v) *
      f 2 (modelPoint (z 0) (z 3) v) *
      gaussianDerivAt (t ^ α.weight 2) (p 2) v) volume :=
    (((h0.aestronglyMeasurable.mul h1.aestronglyMeasurable).mul
      h2.aestronglyMeasurable).mul hkmeas)
  apply Integrable.mono' (hk.const_mul (B0 * B1 * B2)) hmeas
  filter_upwards [] with v
  rw [Real.norm_eq_abs]
  rw [abs_mul, abs_mul, abs_mul]
  apply mul_le_mul_of_nonneg_right
  · gcongr
    · exact hf0 _
    · exact hf1 _
    · exact hf2 _
  · exact abs_nonneg _

/-- The one-input integrand defining the second fiber is integrable under a
uniform continuous input bound. -/
theorem integrable_modelSecondFiber_integrand
    (α : Anisotropy) (f : E3 → ℝ) (p : E3) {t : ℝ} (z : ModelE5)
    (hfcont : Continuous f)
    (B : ℝ) (_hB : 0 ≤ B) (hf : ∀ y, |f y| ≤ B)
    (ht : 0 < t) :
    Integrable (fun v : ℝ ↦
      f (modelPoint (z 0) (z 1) v) *
        gaussianDerivAt (t ^ α.weight 2)
          (p 2 + z 4 * t ^ α.weight 2) v) := by
  have hs : 0 < t ^ α.weight 2 := pow_pos ht _
  have hk := integrable_abs_gaussianDerivAt hs
    (p 2 + z 4 * t ^ α.weight 2)
  have hfm : Continuous (fun v : ℝ ↦ f (modelPoint (z 0) (z 1) v)) :=
    hfcont.comp (continuous_modelPoint_third _ _)
  have hkmeas : AEStronglyMeasurable
      (fun v : ℝ ↦ gaussianDerivAt (t ^ α.weight 2)
        (p 2 + z 4 * t ^ α.weight 2) v) volume :=
    (integrable_gaussianDerivAt hs _).aestronglyMeasurable
  have hmeas : AEStronglyMeasurable (fun v : ℝ ↦
      f (modelPoint (z 0) (z 1) v) *
        gaussianDerivAt (t ^ α.weight 2)
          (p 2 + z 4 * t ^ α.weight 2) v) volume :=
    hfm.aestronglyMeasurable.mul hkmeas
  apply Integrable.mono' (hk.const_mul B) hmeas
  filter_upwards [] with v
  rw [Real.norm_eq_abs, abs_mul]
  exact mul_le_mul_of_nonneg_right (hf _) (abs_nonneg _)

/-- Uniform boundedness controls the absolute value of the first fiber by the
fixed `L¹` mass of the Gaussian derivative. -/
theorem abs_modelFirstFiber_le
    (α : Anisotropy) (f : ModelRealInput) (p : E3) {t : ℝ} (z : ModelE5)
    (hfcont : ∀ j, Continuous (f j))
    (B0 B1 B2 : ℝ) (hB0 : 0 ≤ B0) (hB1 : 0 ≤ B1) (hB2 : 0 ≤ B2)
    (hf0 : ∀ y, |f 0 y| ≤ B0) (hf1 : ∀ y, |f 1 y| ≤ B1)
    (hf2 : ∀ y, |f 2 y| ≤ B2)
    (ht : 0 < t) :
    |modelFirstFiber α f p t z| ≤
      (B0 * B1 * B2) * ∫ v : ℝ, |gaussianDeriv v| := by
  let G : ℝ → ℝ := fun v ↦
    f 0 (modelPoint (z 0) (z 1) v) *
    f 1 (modelPoint (z 2) (z 1) v) *
    f 2 (modelPoint (z 0) (z 3) v) *
    gaussianDerivAt (t ^ α.weight 2) (p 2) v
  have hG : Integrable G := integrable_modelFirstFiber_integrand
    α f p z hfcont B0 B1 B2 hB0 hB1 hB2 hf0 hf1 hf2 ht
  have hGabs : Integrable (fun v ↦ |G v|) := by
    simpa only [Real.norm_eq_abs] using hG.norm
  have hs : 0 < t ^ α.weight 2 := pow_pos ht _
  have hkernel := integrable_abs_gaussianDerivAt hs (p 2)
  have hupper : Integrable (fun v : ℝ ↦
      (B0 * B1 * B2) * |gaussianDerivAt (t ^ α.weight 2) (p 2) v|) :=
    hkernel.const_mul _
  have hpoint (v : ℝ) : |G v| ≤
      (B0 * B1 * B2) * |gaussianDerivAt (t ^ α.weight 2) (p 2) v| := by
    dsimp [G]
    rw [abs_mul, abs_mul, abs_mul]
    apply mul_le_mul_of_nonneg_right
    · gcongr
      · exact hf0 _
      · exact hf1 _
      · exact hf2 _
    · exact abs_nonneg _
  unfold modelFirstFiber
  change |∫ v : ℝ, G v| ≤ _
  calc
    |∫ v : ℝ, G v| ≤ ∫ v : ℝ, |G v| :=
      MeasureTheory.abs_integral_le_integral_abs
    _ ≤ ∫ v : ℝ,
        (B0 * B1 * B2) * |gaussianDerivAt (t ^ α.weight 2) (p 2) v| :=
      integral_mono hGabs hupper hpoint
    _ = (B0 * B1 * B2) * ∫ v : ℝ, |gaussianDeriv v| := by
      rw [integral_const_mul, integral_abs_gaussianDerivAt hs (p 2)]

/-- Uniform boundedness controls the absolute value of the second fiber by
the same fixed Gaussian-derivative mass. -/
theorem abs_modelSecondFiber_le
    (α : Anisotropy) (f : E3 → ℝ) (p : E3) {t : ℝ} (z : ModelE5)
    (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hf : ∀ y, |f y| ≤ B)
    (ht : 0 < t) :
    |modelSecondFiber α f p t z| ≤ B * ∫ v : ℝ, |gaussianDeriv v| := by
  let G : ℝ → ℝ := fun v ↦
    f (modelPoint (z 0) (z 1) v) *
      gaussianDerivAt (t ^ α.weight 2)
        (p 2 + z 4 * t ^ α.weight 2) v
  have hG : Integrable G := integrable_modelSecondFiber_integrand
    α f p z hfcont B hB hf ht
  have hGabs : Integrable (fun v ↦ |G v|) := by
    simpa only [Real.norm_eq_abs] using hG.norm
  have hs : 0 < t ^ α.weight 2 := pow_pos ht _
  have hkernel := integrable_abs_gaussianDerivAt hs
    (p 2 + z 4 * t ^ α.weight 2)
  have hupper : Integrable (fun v : ℝ ↦
      B * |gaussianDerivAt (t ^ α.weight 2)
        (p 2 + z 4 * t ^ α.weight 2) v|) := hkernel.const_mul _
  have hpoint (v : ℝ) : |G v| ≤ B *
      |gaussianDerivAt (t ^ α.weight 2)
        (p 2 + z 4 * t ^ α.weight 2) v| := by
    dsimp [G]
    rw [abs_mul]
    exact mul_le_mul_of_nonneg_right (hf _) (abs_nonneg _)
  unfold modelSecondFiber
  change |∫ v : ℝ, G v| ≤ _
  calc
    |∫ v : ℝ, G v| ≤ ∫ v : ℝ, |G v| :=
      MeasureTheory.abs_integral_le_integral_abs
    _ ≤ ∫ v : ℝ, B * |gaussianDerivAt (t ^ α.weight 2)
        (p 2 + z 4 * t ^ α.weight 2) v| :=
      integral_mono hGabs hupper hpoint
    _ = B * ∫ v : ℝ, |gaussianDeriv v| := by
      rw [integral_const_mul,
        integral_abs_gaussianDerivAt hs
          (p 2 + z 4 * t ^ α.weight 2)]

theorem measurable_modelPoint
    {X : Type*} [MeasurableSpace X] (a b c : X → ℝ)
    (ha : Measurable a) (hb : Measurable b) (hc : Measurable c) :
    Measurable (fun x ↦ modelPoint (a x) (b x) (c x)) := by
  unfold modelPoint
  apply (PiLp.continuous_toLp 2 (fun _ : Fin 3 ↦ ℝ)).measurable.comp
  apply measurable_pi_lambda
  intro i
  fin_cases i
  · simpa using ha
  · simpa using hb
  · simpa using hc

/-- A measurable version of a normalized translated kernel when all three
parameters vary measurably. -/
theorem measurable_kernelAt
    {X : Type*} [MeasurableSpace X] (k : ℝ → ℝ)
    (hk : Measurable k) (s a x : X → ℝ)
    (hs : Measurable s) (ha : Measurable a) (hx : Measurable x) :
    Measurable (fun q ↦ kernelAt k (s q) (a q) (x q)) := by
  unfold kernelAt kernelDilate
  change Measurable (s⁻¹ * (k ∘ ((x - a) / s)))
  exact hs.inv.mul (hk.comp ((hx.sub ha).div hs))

/-- The parameter-and-fiber integrand defining the first model fiber is
Borel measurable for continuous inputs. -/
theorem measurable_modelFirstFiber_integrand
    (α : Anisotropy) (f : ModelRealInput) (hfcont : ∀ j, Continuous (f j)) :
    Measurable (fun qv : ((E3 × ℝ) × ModelE5) × ℝ ↦
      f 0 (modelPoint (qv.1.2 0) (qv.1.2 1) qv.2) *
      f 1 (modelPoint (qv.1.2 2) (qv.1.2 1) qv.2) *
      f 2 (modelPoint (qv.1.2 0) (qv.1.2 3) qv.2) *
      gaussianDerivAt (qv.1.1.2 ^ α.weight 2) (qv.1.1.1 2) qv.2) := by
  have ht : Measurable (fun qv : ((E3 × ℝ) × ModelE5) × ℝ ↦
      qv.1.1.2 ^ α.weight 2) :=
    (measurable_snd.comp (measurable_fst.comp measurable_fst)).pow_const _
  have hp : Measurable (fun qv : ((E3 × ℝ) × ModelE5) × ℝ ↦ qv.1.1.1 2) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) 2).measurable.comp
      (measurable_fst.comp (measurable_fst.comp measurable_fst))
  have hz (i : Fin 5) : Measurable
      (fun qv : ((E3 × ℝ) × ModelE5) × ℝ ↦ qv.1.2 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 5 ↦ ℝ) i).measurable.comp
      (measurable_snd.comp measurable_fst)
  have hv : Measurable (fun qv : ((E3 × ℝ) × ModelE5) × ℝ ↦ qv.2) :=
    measurable_snd
  have hinput0 : Measurable (fun qv : ((E3 × ℝ) × ModelE5) × ℝ ↦
      f 0 (modelPoint (qv.1.2 0) (qv.1.2 1) qv.2)) :=
    (hfcont 0).measurable.comp
      (measurable_modelPoint _ _ _ (hz 0) (hz 1) hv)
  have hinput1 : Measurable (fun qv : ((E3 × ℝ) × ModelE5) × ℝ ↦
      f 1 (modelPoint (qv.1.2 2) (qv.1.2 1) qv.2)) :=
    (hfcont 1).measurable.comp
      (measurable_modelPoint _ _ _ (hz 2) (hz 1) hv)
  have hinput2 : Measurable (fun qv : ((E3 × ℝ) × ModelE5) × ℝ ↦
      f 2 (modelPoint (qv.1.2 0) (qv.1.2 3) qv.2)) :=
    (hfcont 2).measurable.comp
      (measurable_modelPoint _ _ _ (hz 0) (hz 3) hv)
  have hderiv : Measurable gaussianDeriv := by
    unfold gaussianDeriv
    exact (measurable_const.mul measurable_id).mul
      gaussian_contDiff.continuous.measurable
  have hkernel : Measurable (fun qv : ((E3 × ℝ) × ModelE5) × ℝ ↦
      gaussianDerivAt (qv.1.1.2 ^ α.weight 2) (qv.1.1.1 2) qv.2) :=
    measurable_kernelAt gaussianDeriv hderiv _ _ _ ht hp hv
  exact ((hinput0.mul hinput1).mul hinput2).mul hkernel

/-- Parameter integration preserves a.e.-strong measurability of the first
fiber on every outer measure. -/
theorem aestronglyMeasurable_modelFirstFiber
    (α : Anisotropy) (f : ModelRealInput) (hfcont : ∀ j, Continuous (f j))
    (μ : Measure ((E3 × ℝ) × ModelE5)) :
    AEStronglyMeasurable (fun q ↦ modelFirstFiber α f q.1.1 q.1.2 q.2) μ := by
  have hmeas := measurable_modelFirstFiber_integrand α f hfcont
  have hjoint : AEStronglyMeasurable
      (fun qv : ((E3 × ℝ) × ModelE5) × ℝ ↦
        f 0 (modelPoint (qv.1.2 0) (qv.1.2 1) qv.2) *
        f 1 (modelPoint (qv.1.2 2) (qv.1.2 1) qv.2) *
        f 2 (modelPoint (qv.1.2 0) (qv.1.2 3) qv.2) *
        gaussianDerivAt (qv.1.1.2 ^ α.weight 2) (qv.1.1.1 2) qv.2)
      (μ.prod volume) := hmeas.aestronglyMeasurable
  simpa only [modelFirstFiber] using hjoint.integral_prod_right'

/-- The parameter-and-fiber integrand defining the second model fiber is
Borel measurable for a continuous input. -/
theorem measurable_modelSecondFiber_integrand
    (α : Anisotropy) (f : E3 → ℝ) (hfcont : Continuous f) :
    Measurable (fun qv : ((E3 × ℝ) × ModelE5) × ℝ ↦
      f (modelPoint (qv.1.2 0) (qv.1.2 1) qv.2) *
      gaussianDerivAt (qv.1.1.2 ^ α.weight 2)
        (qv.1.1.1 2 + qv.1.2 4 * qv.1.1.2 ^ α.weight 2) qv.2) := by
  have ht : Measurable (fun qv : ((E3 × ℝ) × ModelE5) × ℝ ↦
      qv.1.1.2 ^ α.weight 2) :=
    (measurable_snd.comp (measurable_fst.comp measurable_fst)).pow_const _
  have hp : Measurable (fun qv : ((E3 × ℝ) × ModelE5) × ℝ ↦ qv.1.1.1 2) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) 2).measurable.comp
      (measurable_fst.comp (measurable_fst.comp measurable_fst))
  have hz (i : Fin 5) : Measurable
      (fun qv : ((E3 × ℝ) × ModelE5) × ℝ ↦ qv.1.2 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 5 ↦ ℝ) i).measurable.comp
      (measurable_snd.comp measurable_fst)
  have hv : Measurable (fun qv : ((E3 × ℝ) × ModelE5) × ℝ ↦ qv.2) :=
    measurable_snd
  have hinput : Measurable (fun qv : ((E3 × ℝ) × ModelE5) × ℝ ↦
      f (modelPoint (qv.1.2 0) (qv.1.2 1) qv.2)) :=
    hfcont.measurable.comp
      (measurable_modelPoint _ _ _ (hz 0) (hz 1) hv)
  have hderiv : Measurable gaussianDeriv := by
    unfold gaussianDeriv
    exact (measurable_const.mul measurable_id).mul
      gaussian_contDiff.continuous.measurable
  have ha : Measurable (fun qv : ((E3 × ℝ) × ModelE5) × ℝ ↦
      qv.1.1.1 2 + qv.1.2 4 * qv.1.1.2 ^ α.weight 2) :=
    hp.add ((hz 4).mul ht)
  have hkernel : Measurable (fun qv : ((E3 × ℝ) × ModelE5) × ℝ ↦
      gaussianDerivAt (qv.1.1.2 ^ α.weight 2)
        (qv.1.1.1 2 + qv.1.2 4 * qv.1.1.2 ^ α.weight 2) qv.2) :=
    measurable_kernelAt gaussianDeriv hderiv _ _ _ ht ha hv
  exact hinput.mul hkernel

/-- Parameter integration preserves a.e.-strong measurability of the second
fiber on every outer measure. -/
theorem aestronglyMeasurable_modelSecondFiber
    (α : Anisotropy) (f : E3 → ℝ) (hfcont : Continuous f)
    (μ : Measure ((E3 × ℝ) × ModelE5)) :
    AEStronglyMeasurable (fun q ↦ modelSecondFiber α f q.1.1 q.1.2 q.2) μ := by
  have hmeas := measurable_modelSecondFiber_integrand α f hfcont
  have hjoint : AEStronglyMeasurable
      (fun qv : ((E3 × ℝ) × ModelE5) × ℝ ↦
        f (modelPoint (qv.1.2 0) (qv.1.2 1) qv.2) *
        gaussianDerivAt (qv.1.1.2 ^ α.weight 2)
          (qv.1.1.1 2 + qv.1.2 4 * qv.1.1.2 ^ α.weight 2) qv.2)
      (μ.prod volume) := hmeas.aestronglyMeasurable
  simpa only [modelSecondFiber] using hjoint.integral_prod_right'

/-- The signed five-variable density is Borel measurable jointly in center,
scale, and fiber coordinates. -/
theorem measurable_modelSignedDensity
    (α : Anisotropy) (u : E3) :
    Measurable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelSignedDensity α u q.1.1 q.1.2 q.2) := by
  have ht (i : Fin 3) : Measurable (fun q : (E3 × ℝ) × ModelE5 ↦
      q.1.2 ^ α.weight i) :=
    (measurable_snd.comp measurable_fst).pow_const _
  have hp (i : Fin 3) : Measurable (fun q : (E3 × ℝ) × ModelE5 ↦ q.1.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp
      (measurable_fst.comp measurable_fst)
  have hz (i : Fin 5) : Measurable
      (fun q : (E3 × ℝ) × ModelE5 ↦ q.2 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 5 ↦ ℝ) i).measurable.comp
      measurable_snd
  have hphi0 : Measurable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelPhiAt (q.1.2 ^ α.weight 0)
        (q.1.1 0 + q.1.2 ^ α.weight 0 * u 0) (q.2 0)) := by
    unfold modelPhiAt
    apply measurable_kernelAt conePhiPhysicalReal
      conePhiPhysicalReal.continuous.measurable
    · exact ht 0
    · exact (hp 0).add ((ht 0).mul measurable_const)
    · exact hz 0
  have hg0 : Measurable (fun q : (E3 × ℝ) × ModelE5 ↦
      gaussianAt (q.1.2 ^ α.weight 0) (q.1.1 0) (q.2 2)) := by
    unfold gaussianAt
    apply measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable
    · exact ht 0
    · exact hp 0
    · exact hz 2
  have hphi1 : Measurable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelPhiAt (q.1.2 ^ α.weight 1)
        (q.1.1 1 + q.1.2 ^ α.weight 1 * u 1) (q.2 1)) := by
    unfold modelPhiAt
    apply measurable_kernelAt conePhiPhysicalReal
      conePhiPhysicalReal.continuous.measurable
    · exact ht 1
    · exact (hp 1).add ((ht 1).mul measurable_const)
    · exact hz 1
  have hg1 : Measurable (fun q : (E3 × ℝ) × ModelE5 ↦
      gaussianAt (q.1.2 ^ α.weight 1) (q.1.1 1) (q.2 3)) := by
    unfold gaussianAt
    apply measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable
    · exact ht 1
    · exact hp 1
    · exact hz 3
  have hpsi : Measurable (fun q : (E3 × ℝ) × ModelE5 ↦
      conePsiPhysicalReal (q.2 4 + u 2)) :=
    conePsiPhysicalReal.continuous.measurable.comp ((hz 4).add measurable_const)
  exact ((((hphi0.mul hg0).mul hphi1).mul hg1).mul hpsi)

/-- The positive five-variable energy density is Borel measurable jointly in
center, scale, and fiber coordinates. -/
