      (fun q : (E3 × ℝ) × ModelE5 ↦ q.2 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 5 ↦ ℝ) i).measurable.comp
      measurable_snd
  have hphi0 : Measurable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelPhiAt (q.1.2 ^ α.weight 0)
        (q.1.1 0 + q.1.2 ^ α.weight 0 * u 0) (q.2 0)) := by
    unfold modelPhiAt
    apply measurable_kernelAt conePhiPhysicalReal
      conePhiPhysicalReal.continuous.measurable
    · exact ht 0
    · exact (hp 0).add ((ht 0).mul measurable_const)
    · exact hz 0
  have hg0 : Measurable (fun q : (E3 × ℝ) × ModelE5 ↦
      gaussianAt (q.1.2 ^ α.weight 0) (q.1.1 0) (q.2 2)) := by
    unfold gaussianAt
    apply measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable
    · exact ht 0
    · exact hp 0
    · exact hz 2
  have hphi1 : Measurable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelPhiAt (q.1.2 ^ α.weight 1)
        (q.1.1 1 + q.1.2 ^ α.weight 1 * u 1) (q.2 1)) := by
    unfold modelPhiAt
