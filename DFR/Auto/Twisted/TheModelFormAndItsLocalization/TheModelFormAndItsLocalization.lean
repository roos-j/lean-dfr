    (hVint : Integrable (modelEnergyTwoOuter α u f)
      (cubeScaleMeasure.restrict V))
    (hWint : Integrable (modelEnergyTwoOuter α u f)
      (cubeScaleMeasure.restrict W)) :
    modelEnergyTwoOn α (V ∪ W) u f =
