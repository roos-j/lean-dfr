/-- Integrating a low-frequency model factor in its center parameter gives
its unscaled absolute mass. -/
theorem scratch_integral_abs_modelPhiAt_center {s : ℝ} (hs : 0 < s)
    (c x : ℝ) :
    ∫ p : ℝ, |modelPhiAt s (p + c) x| =
      ∫ y : ℝ, |conePhiPhysicalReal y| := by
  have hpoint (p : ℝ) :
      |modelPhiAt s (p + c) x| = |modelPhiAt s (x - c) p| := by
    unfold modelPhiAt kernelAt kernelDilate
    simp only [smul_eq_mul, abs_mul]
    congr 1
    rw [show (x - (p + c)) / s = -((p - (x - c)) / s) by ring]
    rw [conePhiPhysicalReal_even]
  calc
    ∫ p : ℝ, |modelPhiAt s (p + c) x| =
        ∫ p : ℝ, |modelPhiAt s (x - c) p| := by
          apply integral_congr_ae
          filter_upwards [] with p
          exact hpoint p
    _ = ∫ y : ℝ, |conePhiPhysicalReal y| :=
      integral_abs_modelPhiAt hs (x - c)

/-- The Gaussian auxiliary variable has mass one, so a center/Gaussian pair
contributes only the absolute `φ` mass. -/
theorem scratch_integral_modelPhiAt_gaussian_pair {s : ℝ} (hs : 0 < s)
    (c x : ℝ) :
    (∫ p : ℝ, ∫ y : ℝ,
      |modelPhiAt s (p + c) x| * gaussianAt s p y) =
      ∫ w : ℝ, |conePhiPhysicalReal w| := by
  calc
    (∫ p : ℝ, ∫ y : ℝ,
      |modelPhiAt s (p + c) x| * gaussianAt s p y) =
        ∫ p : ℝ, |modelPhiAt s (p + c) x| := by
          apply integral_congr_ae
          filter_upwards [] with p
          rw [integral_const_mul, integral_gaussianAt hs p]
          ring
    _ = ∫ w : ℝ, |conePhiPhysicalReal w| :=
      scratch_integral_abs_modelPhiAt_center hs c x

/-- The preceding center/Gaussian pair remains valid after multiplication by
any scalar independent of the pair variables. -/
theorem scratch_integral_modelPhiAt_gaussian_pair_const {s : ℝ} (hs : 0 < s)
    (c x C : ℝ) :
    (∫ p : ℝ, ∫ y : ℝ,
      C * |modelPhiAt s (p + c) x| * gaussianAt s p y) =
      C * ∫ w : ℝ, |conePhiPhysicalReal w| := by
  calc
    (∫ p : ℝ, ∫ y : ℝ,
      C * |modelPhiAt s (p + c) x| * gaussianAt s p y) =
        ∫ p : ℝ, C *
          (∫ y : ℝ, |modelPhiAt s (p + c) x| * gaussianAt s p y) := by
          apply integral_congr_ae
          filter_upwards [] with p
          rw [← integral_const_mul]
          congr 1
          funext y
          ring
    _ = C * (∫ p : ℝ, ∫ y : ℝ,
      |modelPhiAt s (p + c) x| * gaussianAt s p y) := by
          rw [integral_const_mul]
    _ = C * ∫ w : ℝ, |conePhiPhysicalReal w| := by
          rw [scratch_integral_modelPhiAt_gaussian_pair hs c x]

/-- The two independent low-frequency/Gaussian pairs contribute the square
of the absolute `φ` mass.  The nesting is chosen to match the scalar order
after the global-energy coordinate reordering. -/
theorem scratch_integral_two_modelPhi_gaussian_pairs
    {s₀ s₁ : ℝ} (hs₀ : 0 < s₀) (hs₁ : 0 < s₁)
    (c₀ c₁ x₀ x₁ C : ℝ) :
    (∫ p₀ : ℝ, ∫ y₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ,
      C * |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀ *
        |modelPhiAt s₁ (p₁ + c₁) x₁| * gaussianAt s₁ p₁ y₁) =
      C * (∫ w : ℝ, |conePhiPhysicalReal w|) ^ 2 := by
  let P : ℝ := ∫ w : ℝ, |conePhiPhysicalReal w|
  have hinner (p₀ y₀ : ℝ) :
      (∫ p₁ : ℝ, ∫ y₁ : ℝ,
        C * |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀ *
          |modelPhiAt s₁ (p₁ + c₁) x₁| * gaussianAt s₁ p₁ y₁) =
        (C * |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀) * P := by
    rw [show (fun p₁ : ℝ ↦ ∫ y₁ : ℝ,
      C * |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀ *
        |modelPhiAt s₁ (p₁ + c₁) x₁| * gaussianAt s₁ p₁ y₁) =
      fun p₁ : ℝ ↦ ∫ y₁ : ℝ,
        (C * |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀) *
          |modelPhiAt s₁ (p₁ + c₁) x₁| * gaussianAt s₁ p₁ y₁ by
        funext p₁
        apply integral_congr_ae
        filter_upwards [] with y₁
        ring]
    rw [scratch_integral_modelPhiAt_gaussian_pair_const hs₁ c₁ x₁
      (C * |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀)]
  calc
    (∫ p₀ : ℝ, ∫ y₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ,
      C * |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀ *
        |modelPhiAt s₁ (p₁ + c₁) x₁| * gaussianAt s₁ p₁ y₁) =
        ∫ p₀ : ℝ, ∫ y₀ : ℝ,
          (C * |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀) * P := by
          apply integral_congr_ae
          filter_upwards [] with p₀
          apply integral_congr_ae
          filter_upwards [] with y₀
          exact hinner p₀ y₀
    _ = ∫ p₀ : ℝ, ∫ y₀ : ℝ,
        (C * P) * |modelPhiAt s₀ (p₀ + c₀) x₀| * gaussianAt s₀ p₀ y₀ := by
          apply integral_congr_ae
          filter_upwards [] with p₀
          apply integral_congr_ae
          filter_upwards [] with y₀
          ring
    _ = (C * P) * P :=
      scratch_integral_modelPhiAt_gaussian_pair_const hs₀ c₀ x₀ (C * P)
    _ = C * (∫ w : ℝ, |conePhiPhysicalReal w|) ^ 2 := by
      dsimp [P]
