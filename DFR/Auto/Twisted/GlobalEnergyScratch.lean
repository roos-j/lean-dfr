      (A × B) × (C × D) ≃ᵐ A × (B × (C × D))).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl A)
      (scratch_swapMiddle B C D))).trans
    (scratch_swapMiddle A C (B × D))).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl C)
      (scratch_swapMiddle A B D))).trans
    (MeasurableEquiv.prodAssoc.symm :
      C × (B × (A × D)) ≃ᵐ (C × B) × (A × D))

