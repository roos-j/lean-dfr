    (A B C : Type*) [MeasurableSpace A] [MeasurableSpace B] [MeasurableSpace C]
    (μA : Measure A) (μB : Measure B) (μC : Measure C)
    [SFinite μA] [SFinite μB] [SFinite μC] :
    MeasurePreserving (scratch_swapMiddle A B C)
      (μA.prod (μB.prod μC)) (μB.prod (μA.prod μC)) := by
  let h₁ : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        A × (B × C) ≃ᵐ (A × B) × C)
      (μA.prod (μB.prod μC)) ((μA.prod μB).prod μC) :=
    (measurePreserving_prodAssoc μA μB μC).symm
  let h₂ : MeasurePreserving
      (MeasurableEquiv.prodCongr
        (MeasurableEquiv.prodComm : A × B ≃ᵐ B × A)
        (MeasurableEquiv.refl C))
      ((μA.prod μB).prod μC) ((μB.prod μA).prod μC) :=
