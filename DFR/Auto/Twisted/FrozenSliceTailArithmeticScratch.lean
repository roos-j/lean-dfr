/-- Chord slopes strictly increase as the active reciprocal exponent moves
to the right.  This is the exact obstruction to using one power threshold
for both supplied tails of a frozen non-diagonal source/output slice. -/
theorem scratch_frozenSlice_chordSlope_strict
    {a b x e : ℝ} (ha : 0 < a) (hb : 0 < b) (hx : 0 < x) (he : 0 < e)
    (hbx : b < x) (hxe : x < e) :
    (((a + b)⁻¹ - (a + x)⁻¹) / (b⁻¹ - x⁻¹)) <
      (((a + x)⁻¹ - (a + e)⁻¹) / (x⁻¹ - e⁻¹)) := by
  rw [scratch_frozenSlice_chordSlope ha hb hx (by linarith),
    scratch_frozenSlice_chordSlope ha hx he (by linarith)]
