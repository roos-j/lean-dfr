  have hax : 0 < a + x := add_pos ha hx
  have hae : 0 < a + e := add_pos ha he
  have hleft : 0 < (a + b) * (a + x) := mul_pos hab hax
  have hright : 0 < (a + x) * (a + e) := mul_pos hax hae
  rw [div_lt_div_iff₀ hleft hright]
