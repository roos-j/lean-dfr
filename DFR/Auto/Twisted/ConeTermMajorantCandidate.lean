    (∫ t in a..b, coneActiveTerm α ξ t i / t) ≤ cPsi ^ 3 := by
  have hcPsi := cPsi_pos
  by_cases hξ : ξ i = 0
  · have hzero : (∫ t in a..b, coneActiveTerm α ξ t i / t) = 0 := by
      have : (fun t : ℝ ↦ coneActiveTerm α ξ t i / t) = fun _ : ℝ ↦ (0 : ℝ) := by
