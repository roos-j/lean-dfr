      = ∑' ν : Fin 3 → ℤ,
          ∫ t in Ioi (0 : ℝ),
            (UnitAddTorus.mFourierCoeff (unitTorusLocalizedSymbol α m 2 t) ν *
              thirdModeFrequencyForm α (standardModeOfInt ν) t F) / (t : ℂ) := by
  rw [integral_coneMultiplierForm_two_eq_tsum α M m hm F]
  have hcongr : (∫ t in Ioi (0 : ℝ),
