/-! ## Finite two-sided output layer-cake

This is the scalar output step needed by the four-vertex interpolation
argument. A weak-one estimate controls the dyadic layers below a chosen
crossover height, while the base strong `R₀` estimate controls those above
it. For `1 < R < R₀`, both resulting finite geometric sums are uniform.

The parameter `A` is the weak-one distribution scale and `B` is the
`R₀`-moment distribution scale (thus, in an analytic application, it is
typically a strong norm bound raised to the `R₀` power). The first version
uses crossover height one; an atom-dependent crossover is reduced to it by
rescaling the scalar output before applying the lemma.
-/

/-- A finite family of nonnegative-index geometric majorants is bounded by
the full geometric sum. -/
theorem scratch_finset_geometric_layer_sum_le
    (A rho : ℝ) (hA : 0 ≤ A) (hrho0 : 0 ≤ rho) (hrho1 : rho < 1)
    (S : Finset ℕ) (X : ℕ → ℝ)
    (hX : ∀ n ∈ S, X n ≤ A * rho ^ n) :
    (∑ n ∈ S, X n) ≤ A * (1 - rho)⁻¹ := by
  have hsumrho : (∑ n ∈ S, rho ^ n) ≤ ∑' n : ℕ, rho ^ n :=
    (summable_geometric_of_lt_one hrho0 hrho1).sum_le_tsum S
      (fun n _ => pow_nonneg hrho0 n)
  calc
    (∑ n ∈ S, X n) ≤ ∑ n ∈ S, A * rho ^ n := by
      apply Finset.sum_le_sum
      intro n hn
      exact hX n hn
    _ = A * (∑ n ∈ S, rho ^ n) := by rw [Finset.mul_sum]
    _ ≤ A * (∑' n : ℕ, rho ^ n) :=
      mul_le_mul_of_nonneg_left hsumrho hA
    _ = A * (1 - rho)⁻¹ := by
      rw [tsum_geometric_of_lt_one hrho0 hrho1]

/-- The low output layers are summable at every target moment exponent
strictly above one. Here `D n` is the distribution mass at height `2^{-n}`
and `hweak` is precisely its weak-one estimate. -/
theorem scratch_lowWeakOne_dyadicLayers_targetMoment_le
    (R A : ℝ) (hR : 1 < R) (hA : 0 ≤ A)
    (S : Finset ℕ) (D : ℕ → ℝ)
    (hweak : ∀ n ∈ S,
      (2 : ℝ) ^ (-(n : ℝ)) * D n ≤ A) :
    (∑ n ∈ S, (2 : ℝ) ^ (-(R * (n : ℝ))) * D n) ≤
      A * (1 - (2 : ℝ) ^ (-(R - 1)))⁻¹ := by
  let rho : ℝ := (2 : ℝ) ^ (-(R - 1))
  have hrho0 : 0 ≤ rho := by
    dsimp only [rho]
    exact Real.rpow_nonneg (by norm_num) _
  have hrho1 : rho < 1 := by
    dsimp only [rho]
    apply Real.rpow_lt_one_of_one_lt_of_neg
    · norm_num
    · linarith
  apply scratch_finset_geometric_layer_sum_le A rho hA hrho0 hrho1 S
    (fun n => (2 : ℝ) ^ (-(R * (n : ℝ))) * D n)
  intro n hn
  have hfactor : (2 : ℝ) ^ (-(R * (n : ℝ))) * D n =
      ((2 : ℝ) ^ (-(n : ℝ)) * D n) * rho ^ n := by
    dsimp only [rho]
    rw [← Real.rpow_natCast]
    rw [← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
    have hpow : (2 : ℝ) ^ (-(R * (n : ℝ))) =
        (2 : ℝ) ^ (-(n : ℝ)) *
          (2 : ℝ) ^ (-(R - 1) * (n : ℝ)) := by
      rw [← Real.rpow_add (by norm_num : (0 : ℝ) < 2)]
      congr 1
      ring
    rw [hpow]
    ring
  rw [hfactor]
  exact mul_le_mul_of_nonneg_right (hweak n hn) (pow_nonneg hrho0 n)

/-- The high output layers are summable at every target moment exponent
strictly below the base strong exponent `R₀`. Here `D n` is the distribution
mass at height `2^n`, and `hstrong` is the Chebyshev distribution estimate
coming from the base `L^{R₀}` bound. -/
theorem scratch_highStrong_dyadicLayers_targetMoment_le
    (R R0 B : ℝ) (hRR0 : R < R0) (hB : 0 ≤ B)
    (S : Finset ℕ) (D : ℕ → ℝ)
    (hstrong : ∀ n ∈ S,
      (2 : ℝ) ^ (R0 * (n : ℝ)) * D n ≤ B) :
    (∑ n ∈ S, (2 : ℝ) ^ (R * (n : ℝ)) * D n) ≤
      B * (1 - (2 : ℝ) ^ (-(R0 - R)))⁻¹ := by
  let rho : ℝ := (2 : ℝ) ^ (-(R0 - R))
  have hrho0 : 0 ≤ rho := by
    dsimp only [rho]
    exact Real.rpow_nonneg (by norm_num) _
  have hrho1 : rho < 1 := by
    dsimp only [rho]
    apply Real.rpow_lt_one_of_one_lt_of_neg
    · norm_num
    · linarith
  apply scratch_finset_geometric_layer_sum_le B rho hB hrho0 hrho1 S
    (fun n => (2 : ℝ) ^ (R * (n : ℝ)) * D n)
  intro n hn
  have hfactor : (2 : ℝ) ^ (R * (n : ℝ)) * D n =
      ((2 : ℝ) ^ (R0 * (n : ℝ)) * D n) * rho ^ n := by
    dsimp only [rho]
    rw [← Real.rpow_natCast]
    rw [← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
    have hpow : (2 : ℝ) ^ (R * (n : ℝ)) =
        (2 : ℝ) ^ (R0 * (n : ℝ)) *
          (2 : ℝ) ^ (-(R0 - R) * (n : ℝ)) := by
      rw [← Real.rpow_add (by norm_num : (0 : ℝ) < 2)]
      congr 1
      ring
    rw [hpow]
    ring
  rw [hfactor]
  exact mul_le_mul_of_nonneg_right (hstrong n hn) (pow_nonneg hrho0 n)

/-- The finite two-sided output-layer terminal. It combines a weak-one
bound below the crossover and a base strong `R₀` distribution bound above it
into the desired `R`-moment bound. -/
theorem scratch_twoSided_dyadicOutputLayers_targetMoment_le
    (R R0 A B : ℝ) (hR : 1 < R) (hRR0 : R < R0)
    (hA : 0 ≤ A) (hB : 0 ≤ B)
    (Slow Shigh : Finset ℕ) (Dlow Dhigh : ℕ → ℝ)
    (hweak : ∀ n ∈ Slow,
      (2 : ℝ) ^ (-(n : ℝ)) * Dlow n ≤ A)
    (hstrong : ∀ n ∈ Shigh,
      (2 : ℝ) ^ (R0 * (n : ℝ)) * Dhigh n ≤ B) :
    (∑ n ∈ Slow, (2 : ℝ) ^ (-(R * (n : ℝ))) * Dlow n) +
      (∑ n ∈ Shigh, (2 : ℝ) ^ (R * (n : ℝ)) * Dhigh n) ≤
        A * (1 - (2 : ℝ) ^ (-(R - 1)))⁻¹ +
          B * (1 - (2 : ℝ) ^ (-(R0 - R)))⁻¹ := by
  exact add_le_add
    (scratch_lowWeakOne_dyadicLayers_targetMoment_le R A hR hA Slow Dlow hweak)
    (scratch_highStrong_dyadicLayers_targetMoment_le R R0 B hRR0 hB
      Shigh Dhigh hstrong)

end
