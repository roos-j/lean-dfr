    simpa using hquad true true true
  have h110 : ‖B fpos gpos hneg‖ ≤ K true true false := by
    simpa using hquad true true false
  have h101 : ‖B fpos gneg hpos‖ ≤ K true false true := by
    simpa using hquad true false true
  have h100 : ‖B fpos gneg hneg‖ ≤ K true false false := by
    simpa using hquad true false false
  have h011 : ‖B fneg gpos hpos‖ ≤ K false true true := by
    simpa using hquad false true true
  have h010 : ‖B fneg gpos hneg‖ ≤ K false true false := by
    simpa using hquad false true false
  have h001 : ‖B fneg gneg hpos‖ ≤ K false false true := by
    simpa using hquad false false true
  have h000 : ‖B fneg gneg hneg‖ ≤ K false false false := by
    simpa using hquad false false false
