        (if e₃ then hpos else hneg)‖ ≤ K e₁ e₂ e₃) :
    ‖B (fpos + fneg) (gpos + gneg) (hpos + hneg)‖ ≤
      K true true true + K true true false +
        K true false true + K true false false +
