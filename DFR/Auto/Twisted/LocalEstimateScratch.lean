/-- The explicit scalar expression for the scale derivative of one endpoint
coordinate factor.  Keeping it as a function of both scale and center makes
the compact positive-band continuity argument below literal. -/
noncomputable def scratch_cubeCoordinateDdotFormula
    (α : Anisotropy) (i : Fin 3) (lam r t : ℝ) (p : E3) (x : E6) : ℝ :=
  by
    let μ : ℝ := cubeWidth i lam
    let σ : ℝ := cubeCenterShift i r
    let n : ℕ := α.weight i
    exact -(n : ℝ) / t *
      (2 * scalarD μ σ n t (p i) (x (i, false)) (x (i, true)) +
        (scalarZ μ σ n t (p i) (x (i, false)) + σ / μ) *
            scalarH μ σ n t (p i) (x (i, false)) *
              scalarG μ σ n t (p i) (x (i, true)) +
        (scalarZ μ σ n t (p i) (x (i, true)) + σ / μ) *
            scalarG μ σ n t (p i) (x (i, false)) *
              scalarH μ σ n t (p i) (x (i, true)))

/-- On positive scale, the explicit formula is the actual scale derivative. -/
theorem scratch_deriv_cubeCoordinateD_eq_dotFormula
    (α : Anisotropy) (i : Fin 3) (lam r t : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t =
      scratch_cubeCoordinateDdotFormula α i lam r t p x := by
  have hμ : cubeWidth i lam ≠ 0 :=
    (cubeWidth_pos_of_one_le i hlam).ne'
  unfold scratch_cubeCoordinateDdotFormula
  simpa only [cubeCoordinateD_eq_scalarD] using
    (hasDerivAt_scalarD_scale
      (mu := cubeWidth i lam) (sig := cubeCenterShift i r)
      (n := α.weight i) (t := t) (p := p i)
      (u0 := x (i, false)) (u1 := x (i, true)) hμ ht.ne').deriv

/-- The coordinate derivative formula is jointly continuous on the open
positive scale half-space. -/
theorem scratch_continuousOn_cubeCoordinateDdotFormula_center_scale
    (α : Anisotropy) (i : Fin 3) (lam r : ℝ) (x : E6)
    (hlam : 1 ≤ lam) :
    ContinuousOn (fun z : ℝ × E3 ↦
      scratch_cubeCoordinateDdotFormula α i lam r z.1 z.2 x)
      (Set.Ioi 0 ×ˢ Set.univ) := by
  intro z hz
  have ht : z.1 ≠ 0 := ne_of_gt hz.1
  have hμ : cubeWidth i lam ≠ 0 :=
    (cubeWidth_pos_of_one_le i hlam).ne'
  have hscale : cubeWidth i lam * z.1 ^ α.weight i ≠ 0 :=
    mul_ne_zero hμ (pow_ne_zero _ ht)
  apply ContinuousAt.continuousWithinAt
  unfold scratch_cubeCoordinateDdotFormula
  fun_prop (disch := assumption) [scalarD, scalarG, scalarH, scalarZ,
    gaussianAt, gaussianDerivAt, kernelAt, kernelDilate, gaussian, gaussianDeriv]

/-- A coordinate endpoint factor is jointly continuous on positive scale and
arbitrary center. -/
theorem scratch_continuousOn_cubeCoordinateD_center_scale
    (α : Anisotropy) (i : Fin 3) (lam r : ℝ) (x : E6)
    (hlam : 1 ≤ lam) :
    ContinuousOn (fun z : ℝ × E3 ↦
      cubeCoordinateD α i lam r z.1 z.2 x)
      (Set.Ioi 0 ×ˢ Set.univ) := by
  intro z hz
  have ht : z.1 ≠ 0 := ne_of_gt hz.1
  have hμ : cubeWidth i lam ≠ 0 :=
    (cubeWidth_pos_of_one_le i hlam).ne'
  have hscale : cubeWidth i lam * z.1 ^ α.weight i ≠ 0 :=
    mul_ne_zero hμ (pow_ne_zero _ ht)
  apply ContinuousAt.continuousWithinAt
  unfold cubeCoordinateD cubeGaussianKernel gaussianAt kernelAt kernelDilate
  fun_prop (disch := assumption) [gaussian]

/-- A continuous positive-scale extension of the endpoint scale integrand. -/
noncomputable def scratch_endpointScaleIntegrandFormula
    (α : Anisotropy) (lam r : ℝ) (x : E6) (t : ℝ) (p : E3) : ℝ :=
  ∑ i : Fin 3,
    (-scratch_cubeCoordinateDdotFormula α i lam r t p x) *
      ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x

/-- The positive-scale endpoint derivative quotient equals its continuous
three-coordinate product-rule formula. -/
theorem scratch_endpointScaleIntegrand_eq_formula
    (α : Anisotropy) (lam r t : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    (-t * deriv (fun s : ℝ ↦ cubeEndpointKernel α lam r s p x) t) / t =
      scratch_endpointScaleIntegrandFormula α lam r x t p := by
  rw [cubeEndpointKernel_scale_derivative α lam r t p x hlam ht,
    Finset.sum_div]
  unfold scratch_endpointScaleIntegrandFormula
  apply Finset.sum_congr rfl
  intro i hi
  rw [scratch_deriv_cubeCoordinateD_eq_dotFormula α i lam r t p x hlam ht]
  field_simp [ht.ne']

/-- Joint continuity of the endpoint derivative formula on positive scale. -/
theorem scratch_continuousOn_endpointScaleIntegrandFormula
    (α : Anisotropy) (lam r : ℝ) (x : E6)
    (hlam : 1 ≤ lam) :
    ContinuousOn (fun z : ℝ × E3 ↦
      scratch_endpointScaleIntegrandFormula α lam r x z.1 z.2)
      (Set.Ioi 0 ×ˢ Set.univ) := by
  unfold scratch_endpointScaleIntegrandFormula
  apply continuousOn_finsetSum Finset.univ
  intro i hi
  apply (scratch_continuousOn_cubeCoordinateDdotFormula_center_scale
    α i lam r x hlam).neg.mul
  apply continuousOn_finsetProd (Finset.univ.erase i)
  intro m hm
  exact scratch_continuousOn_cubeCoordinateD_center_scale α m lam r x hlam

/-- The endpoint scale-derivative quotient is integrable on the literal
Lebesgue scale-band times center-box product required by the single-box FTC
Fubini step. -/
theorem scratch_integrable_endpointScaleDerivative_boxScaleBand
    (α : Anisotropy) (Q : AnisoBox α) (lam r : ℝ) (x : E6)
    (hlam : 1 ≤ lam) :
    Integrable (Function.uncurry (fun t : ℝ ↦ fun p : E3 ↦
      (-t * deriv (fun s : ℝ ↦ cubeEndpointKernel α lam r s p x) t) / t))
      ((volume.restrict (Set.Ioc (boxLength Q / 2) (boxLength Q))).prod
        (volume.restrict (boxSet α Q))) := by
  let L : ℝ := boxLength Q
  let K : Set (ℝ × E3) := Set.Icc (L / 2) L ×ˢ boxClosedSet α Q
  let s : Set (ℝ × E3) := Set.Ioc (L / 2) L ×ˢ boxSet α Q
  have hL : 0 < L := boxLength_pos Q
  have hhalf : 0 < L / 2 := div_pos hL (by norm_num)
  have hKcompact : IsCompact K := by
    dsimp only [K]
    exact isCompact_Icc.prod (isCompact_boxClosedSet α Q)
  have hsmeas : MeasurableSet s := by
    dsimp only [s]
    exact measurableSet_Ioc.prod (measurableSet_boxSet α Q)
  have hsK : s ⊆ K := by
    rintro ⟨t, p⟩ ⟨ht, hp⟩
    exact ⟨Set.Ioc_subset_Icc_self ht, boxSet_subset_boxClosedSet α Q hp⟩
  have hKpositive : K ⊆ Set.Ioi 0 ×ˢ Set.univ := by
    rintro ⟨t, p⟩ ⟨ht, hp⟩
    exact ⟨lt_of_lt_of_le hhalf ht.1, Set.mem_univ _⟩
  have hcont : ContinuousOn (fun z : ℝ × E3 ↦
      scratch_endpointScaleIntegrandFormula α lam r x z.1 z.2) K :=
    (scratch_continuousOn_endpointScaleIntegrandFormula α lam r x hlam).mono
      hKpositive
  have hformula : Integrable (fun z : ℝ × E3 ↦
      scratch_endpointScaleIntegrandFormula α lam r x z.1 z.2)
      ((volume.restrict (Set.Ioc (boxLength Q / 2) (boxLength Q))).prod
        (volume.restrict (boxSet α Q))) := by
    rw [Measure.prod_restrict]
    change IntegrableOn (fun z : ℝ × E3 ↦
      scratch_endpointScaleIntegrandFormula α lam r x z.1 z.2) s (volume.prod volume)
    rw [← Measure.volume_eq_prod]
    have hKfinite : (volume : Measure (ℝ × E3)) K ≠ ∞ :=
      hKcompact.measure_ne_top
    have hsfinite : (volume : Measure (ℝ × E3)) s ≠ ∞ :=
      ne_of_lt (lt_of_le_of_lt (measure_mono hsK)
        (lt_top_iff_ne_top.mpr hKfinite))
    exact hcont.integrableOn_of_subset_isCompact hKcompact hsmeas hsK
      hsfinite
  have htband : ∀ᵐ t : ℝ ∂(volume.restrict (Set.Ioc (boxLength Q / 2) (boxLength Q))),
      t ∈ Set.Ioc (boxLength Q / 2) (boxLength Q) :=
    ae_restrict_mem measurableSet_Ioc
  have htband' : ∀ᵐ z : ℝ × E3 ∂
      ((volume.restrict (Set.Ioc (boxLength Q / 2) (boxLength Q))).prod
        (volume.restrict (boxSet α Q))),
      z.1 ∈ Set.Ioc (boxLength Q / 2) (boxLength Q) :=
    (Measure.quasiMeasurePreserving_fst
      (μ := volume.restrict (Set.Ioc (boxLength Q / 2) (boxLength Q)))
      (ν := volume.restrict (boxSet α Q))).ae htband
  have heq : Function.uncurry (fun t : ℝ ↦ fun p : E3 ↦
      (-t * deriv (fun s : ℝ ↦ cubeEndpointKernel α lam r s p x) t) / t) =ᵐ[
      (volume.restrict (Set.Ioc (boxLength Q / 2) (boxLength Q))).prod
        (volume.restrict (boxSet α Q))]
      (fun z : ℝ × E3 ↦ scratch_endpointScaleIntegrandFormula α lam r x z.1 z.2) := by
    filter_upwards [htband'] with z hz
    have htz : 0 < z.1 := lt_trans hhalf hz.1
    exact scratch_endpointScaleIntegrand_eq_formula α lam r z.1 z.2 x hlam htz
  exact hformula.congr heq.symm

/-- Every fixed endpoint kernel is integrable over a literal finite source
box; this supplies the two endpoint assumptions in the single-box scale FTC. -/
theorem scratch_integrableOn_cubeEndpointKernel_boxSet
    (α : Anisotropy) (Q : AnisoBox α) (lam r t : ℝ) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    IntegrableOn (fun p : E3 ↦ cubeEndpointKernel α lam r t p x)
      (boxSet α Q) := by
  have hcont : Continuous (fun p : E3 ↦ cubeEndpointKernel α lam r t p x) := by
    unfold cubeEndpointKernel
    apply continuous_finsetProd Finset.univ
    intro i hi
    exact continuous_cubeCoordinateD_center α i r x hlam ht
  exact integrableOn_boxSet_of_continuous hcont Q

/-- The complete analytic hypothesis package for the single-box endpoint
scale FTC, at one fixed six-dimensional spatial point. -/
theorem scratch_singleBox_endpointScaleFTC_integrability
    (α : Anisotropy) (Q : AnisoBox α) (lam r : ℝ) (x : E6)
    (hlam : 1 ≤ lam) :
    IntegrableOn
      (fun p : E3 ↦ cubeEndpointKernel α lam r (boxLength Q / 2) p x)
      (boxSet α Q) ∧
    IntegrableOn
      (fun p : E3 ↦ cubeEndpointKernel α lam r (boxLength Q) p x)
      (boxSet α Q) ∧
    Integrable (Function.uncurry (fun t : ℝ ↦ fun p : E3 ↦
      (-t * deriv (fun s : ℝ ↦ cubeEndpointKernel α lam r s p x) t) / t))
      ((volume.restrict (Set.Ioc (boxLength Q / 2) (boxLength Q))).prod
        (volume.restrict (boxSet α Q))) := by
  exact ⟨scratch_integrableOn_cubeEndpointKernel_boxSet
      α Q lam r (boxLength Q / 2) x hlam
        (div_pos (boxLength_pos Q) (by norm_num)),
    scratch_integrableOn_cubeEndpointKernel_boxSet α Q lam r (boxLength Q) x hlam
      (boxLength_pos Q),
    scratch_integrable_endpointScaleDerivative_boxScaleBand α Q lam r x hlam⟩

/-- An integrable bracket weight stays integrable after adjoining any finite
passive parameter measure.  This is the common majorant for both box and
face scale cells. -/
theorem scratch_integrable_lift_right_cubeBracketWeight
    {X : Type*} [MeasurableSpace X] (μ : Measure X)
    [IsFiniteMeasure μ] (α : Anisotropy) (q : AnisoBox α) :
    Integrable (fun z : X × E6 ↦
      cubeBracketWeight α (boxLength q) (boxCenter α q) z.2) (μ.prod volume) := by
  have hbase : Integrable (cubeBracketWeight α (boxLength q) (boxCenter α q)) :=
    integrable_cubeBracketWeight α (boxLength_pos q) (boxCenter α q)
  have hmeas : AEStronglyMeasurable (fun z : X × E6 ↦
      cubeBracketWeight α (boxLength q) (boxCenter α q) z.2) (μ.prod volume) :=
    ((continuous_cubeBracketWeight α (boxLength_pos q) (boxCenter α q)).measurable.comp
      measurable_snd).aestronglyMeasurable
  refine (integrable_prod_iff hmeas).mpr ⟨?_, ?_⟩
  · filter_upwards [] with z
    exact hbase
  · have hconst : (fun z : X ↦
        ∫ x : E6, ‖cubeBracketWeight α (boxLength q) (boxCenter α q) x‖) =
          fun _ ↦ (2 / 9 : ℝ) ^ 6 := by
      funext z
      rw [show (fun x : E6 ↦
          ‖cubeBracketWeight α (boxLength q) (boxCenter α q) x‖) =
          cubeBracketWeight α (boxLength q) (boxCenter α q) by
            funext x
            rw [Real.norm_eq_abs, abs_of_nonneg]
            exact cubeBracketWeight_nonneg α (boxLength_pos q).le
              (boxCenter α q) x]
      exact integral_cubeBracketWeight α (boxLength_pos q) (boxCenter α q)
    rw [hconst]
    exact integrable_const _

/-- Each closed oriented source face lies in the compact closed source box. -/
theorem scratch_boxFaceSet_subset_boxClosedSet
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) (o : FaceOrientation) :
    boxFaceSet α q i o ⊆ boxClosedSet α q := by
  intro p hp
  refine ⟨WithLp.ofLp p, ?_, ?_⟩
  · rw [Set.mem_pi]
    intro j hj
    rw [boxFaceSet] at hp
    by_cases hji : j = i
    · subst j
      change p i ∈ Set.Icc ((q.index i : ℝ) * boxSide α q i)
        (((q.index i + 1 : ℤ) : ℝ) * boxSide α q i)
      cases o
      · rw [boxFaceCoordinate] at hp
        rw [hp.1]
        exact ⟨le_rfl, boxFaceCoordinate_lower_le_upper α q i⟩
      · rw [boxFaceCoordinate] at hp
        rw [hp.1]
        exact ⟨boxFaceCoordinate_lower_le_upper α q i, le_rfl⟩
    · exact hp.2 j hji
  · simp

/-- A transverse source point inserted at either oriented face belongs to the
compact closed ambient source box. -/
theorem scratch_faceInsert_mem_boxClosedSet
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) (o : FaceOrientation)
    (y : TransverseSpace i) (hy : y ∈ transverseRectangle α q i) :
    faceInsert i (boxFaceCoordinate α q i o) y ∈ boxClosedSet α q := by
  apply scratch_boxFaceSet_subset_boxClosedSet α q i o
  apply faceInsert_transverseRectangle_subset_boxFaceSet α q i o
  exact ⟨y, hy, rfl⟩

/-- The literal half-open source box is dense in its coordinatewise closed
box.  This supplies the reverse containment missing from the compactness-only
local-integrability interface. -/
theorem scratch_boxClosedSet_subset_closure_boxSet
    (α : Anisotropy) (q : AnisoBox α) :
    boxClosedSet α q ⊆ closure (boxSet α q) := by
  intro p hp
  rcases hp with ⟨u, hu, hup⟩
  let K : Set (Fin 3 → ℝ) := Set.pi Set.univ (fun i ↦ boxInterval α q i)
  have hucl : u ∈ closure K := by
    rw [closure_pi_set]
    rw [Set.mem_pi]
    intro i hi
    unfold boxInterval
    rw [closure_Ico]
    · exact hu i hi
    · apply ne_of_lt
      apply mul_lt_mul_of_pos_right
      · have hindex : (q.index i : ℝ) < ((q.index i + 1 : ℤ) : ℝ) := by
          exact_mod_cast (show q.index i < q.index i + 1 by omega)
        exact hindex
      · exact boxSide_pos α q i
  have himage : (WithLp.toLp 2) '' K = boxSet α q := by
    ext z
    constructor
    · rintro ⟨v, hv, rfl⟩
      rw [boxSet, Set.mem_preimage, Set.mem_pi]
      intro i hi
      have hvi : v i ∈ boxInterval α q i := hv i hi
      simpa using hvi
    · intro hz
      refine ⟨WithLp.ofLp z, ?_, ?_⟩
      · rw [boxSet, Set.mem_preimage, Set.mem_pi] at hz
        exact hz
      · simp
  have hmap : WithLp.toLp 2 u ∈ closure ((WithLp.toLp 2) '' K) :=
    image_closure_subset_closure_image (PiLp.continuous_toLp 2 _) ⟨u, hucl, rfl⟩
  rw [himage] at hmap
  simpa only [hup] using hmap

/-- A closed spatial point and a closed scale point of a surviving box lie in
the closure of that box's literal center--scale cell. -/
theorem scratch_mem_closure_boxScaleRegion_of_mem_boxClosedSet
    (α : Anisotropy) (q : AnisoBox α) {p : E3} {t : ℝ}
    (hp : p ∈ boxClosedSet α q)
    (ht : t ∈ Set.Icc (boxLength q / 2) (boxLength q)) :
    (p, t) ∈ closure (boxScaleRegion α q) := by
  rw [boxScaleRegion, closure_prod_eq]
  constructor
  · exact scratch_boxClosedSet_subset_closure_boxSet α q hp
  · unfold boxScaleBand
    rw [closure_Ioc]
    · exact ht
    · exact ne_of_lt (div_lt_self (boxLength_pos q) (by norm_num))

/-- The preceding closed-cell point belongs to the closure of every collection
which contains its box. -/
theorem scratch_mem_closure_collectionRegion_of_mem_boxClosedSet
    (α : Anisotropy) (S : BoxCollection α) (q : AnisoBox α) {p : E3} {t : ℝ}
    (hq : q ∈ S) (hp : p ∈ boxClosedSet α q)
    (ht : t ∈ Set.Icc (boxLength q / 2) (boxLength q)) :
    (p, t) ∈ closure (collectionRegion α S) := by
  apply (closure_mono ?_) (scratch_mem_closure_boxScaleRegion_of_mem_boxClosedSet α q hp ht)
  intro z hz
  rw [collectionRegion]
  exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hq, hz⟩⟩

/-- In particular, every transverse point on an oriented face of a surviving
box is available to the closure-based tree local-size estimate. -/
theorem scratch_mem_closure_collectionRegion_face
    (α : Anisotropy) (S : BoxCollection α) (q : AnisoBox α)
    (i : Fin 3) (o : FaceOrientation) {y : TransverseSpace i} {t : ℝ}
    (hq : q ∈ S) (hy : y ∈ transverseRectangle α q i)
    (ht : t ∈ Set.Icc (boxLength q / 2) (boxLength q)) :
    (faceInsert i (boxFaceCoordinate α q i o) y, t) ∈
      closure (collectionRegion α S) := by
  apply scratch_mem_closure_collectionRegion_of_mem_boxClosedSet α S q hq
    (scratch_faceInsert_mem_boxClosedSet α q i o y hy) ht

/-- Positivity of the local-size quantities at the fourth-moment exponent,
recorded for assembling a nonnegative uniform remainder constant. -/
theorem scratch_treeLocalSize_four_nonneg
    (T : FiniteConvexTree α) (f : E3 → ℝ) :
    0 ≤ treeLocalSize T 4 f := by
  unfold treeLocalSize collectionLocalSize
  split_ifs with hT
  · rcases hT with ⟨q, hq⟩
    exact (show 0 ≤ boxLocalSize α 4 f q by
      unfold boxLocalSize boxLocalPower
      apply Real.rpow_nonneg
      apply MeasureTheory.integral_nonneg
      intro y
      exact mul_nonneg (Real.rpow_nonneg (abs_nonneg (f y)) _)
        (anisotropicBracketKernel_nonneg α (boxLength_pos q).le (boxCenter α q) y)).trans
      (Finset.le_sup' (boxLocalSize α 4 f) hq)
  · norm_num

/-- The product of the eight fourth local sizes is nonnegative. -/
theorem scratch_treeLocalSize_product_four_nonneg
    (T : FiniteConvexTree α) (F : CubeVertex → E3 → ℝ) :
    0 ≤ ∏ j : CubeVertex, treeLocalSize T 4 (F j) := by
  exact Finset.prod_nonneg fun j _ ↦ scratch_treeLocalSize_four_nonneg T (F j)

/-- The weighted face-scale integrand is jointly integrable in scale,
transverse face coordinate, and all six spatial variables on one source box.
The power is exactly the source factor `t^(α_i - 1)`. -/
theorem scratch_integrable_cubeFaceScaleIntegrand
    (α : Anisotropy) (Q : AnisoBox α) (i : Fin 3) (o : FaceOrientation)
    (lam r : ℝ) (F : CubeVertex → E3 → ℝ)
    (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B)
    (hlam : 1 ≤ lam) :
    Integrable (Function.uncurry
      (fun ty : ℝ × TransverseSpace i ↦ fun x : E6 ↦
        ty.1 ^ (α.weight i - 1) *
          (cubeSignedInputProduct F x * cubeFaceKernel α i lam r ty.1
            (faceInsert i (boxFaceCoordinate α Q i o) ty.2) x)))
      (((volume.restrict (Set.Ioc (boxLength Q / 2) (boxLength Q))).prod
        (volume.restrict (transverseRectangle α Q i))).prod volume) := by
  let n : ℕ := α.weight i - 1
  let μ : Measure (ℝ × TransverseSpace i) :=
    (volume.restrict (Set.Ioc (boxLength Q / 2) (boxLength Q))).prod
      (volume.restrict (transverseRectangle α Q i))
  letI : IsFiniteMeasure (volume.restrict (transverseRectangle α Q i)) := by
    constructor
    rw [Measure.restrict_apply_univ]
    exact lt_top_iff_ne_top.mpr (volume_transverseRectangle_ne_top α Q i)
  letI : IsFiniteMeasure μ := by
    dsimp only [μ]
    infer_instance
  let c : ℝ := boxFaceCoordinate α Q i o
  let φ : ((ℝ × TransverseSpace i) × E6) → ((E3 × ℝ) × E6) :=
    fun z ↦ ((faceInsert i c z.1.2, z.1.1), z.2)
  have hφcont : Continuous φ := by
    dsimp only [φ]
    exact
      (((faceInsert_continuous i c).comp (continuous_snd.comp continuous_fst)).prodMk
        (continuous_fst.comp continuous_fst)).prodMk continuous_snd
  have hcore : AEStronglyMeasurable (fun z : (ℝ × TransverseSpace i) × E6 ↦
      cubeSignedInputProduct F z.2 *
        cubeFaceKernel α i lam r z.1.1 (faceInsert i c z.1.2) z.2) (μ.prod volume) := by
    have hsource := scratch_aestronglyMeasurable_cubeSignedInputProduct_mul_cubeFaceKernel
      α i lam r F hFcont (Measure.map φ (μ.prod volume))
    simpa only [φ, Function.comp_def] using hsource.comp_measurable hφcont.measurable
  have hpow : AEStronglyMeasurable (fun z : (ℝ × TransverseSpace i) × E6 ↦
      z.1.1 ^ n) (μ.prod volume) :=
    ((measurable_fst.comp measurable_fst).pow_const n).aestronglyMeasurable
  have hmeas : AEStronglyMeasurable (fun z : (ℝ × TransverseSpace i) × E6 ↦
      z.1.1 ^ n *
        (cubeSignedInputProduct F z.2 *
          cubeFaceKernel α i lam r z.1.1 (faceInsert i c z.1.2) z.2))
      (μ.prod volume) := hpow.mul hcore
  rcases scratch_exists_bound_cubeSignedInputProduct F hFbound with ⟨B, hB, hinput⟩
  rcases cubeFaceKernel_domination α with ⟨C, hC, hdom⟩
  let D : ℝ := C * lam ^ 37 * translationWeight r ^ 21
  have hD : 0 ≤ D := by
    dsimp only [D]
    have hlam0 : 0 ≤ lam := by linarith
    have hR : 0 ≤ translationWeight r := by
      unfold translationWeight
      positivity
    exact mul_nonneg (mul_nonneg hC (pow_nonneg hlam0 _))
      (pow_nonneg hR _)
  let A : ℝ := scratch_boxScaleComparisonConstant α
  have hA : 0 ≤ A := scratch_boxScaleComparisonConstant_nonneg α
  have hmajor : Integrable (fun z : (ℝ × TransverseSpace i) × E6 ↦
      (B * D * A * boxLength Q ^ n) *
        cubeBracketWeight α (boxLength Q) (boxCenter α Q) z.2) (μ.prod volume) := by
    simpa only [smul_eq_mul] using
      (scratch_integrable_lift_right_cubeBracketWeight μ α Q).const_mul
        (B * D * A * boxLength Q ^ n)
  have hcell : ∀ᵐ ty : ℝ × TransverseSpace i ∂μ,
      ty ∈ Set.Ioc (boxLength Q / 2) (boxLength Q) ×ˢ
        transverseRectangle α Q i := by
    dsimp only [μ]
    rw [Measure.ae_prod_mem_iff_ae_ae_mem
      (measurableSet_Ioc.prod (measurableSet_transverseRectangle α Q i))]
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    filter_upwards [ae_restrict_mem (measurableSet_transverseRectangle α Q i)] with y hy
    exact ⟨ht, hy⟩
  have hcell' : ∀ᵐ z : (ℝ × TransverseSpace i) × E6 ∂(μ.prod volume),
      z.1 ∈ Set.Ioc (boxLength Q / 2) (boxLength Q) ×ˢ
        transverseRectangle α Q i :=
    (Measure.quasiMeasurePreserving_fst (μ := μ) (ν := volume)).ae hcell
  have hLhalf : 0 < boxLength Q / 2 :=
    div_pos (boxLength_pos Q) (by norm_num)
  have hraw : Integrable (fun z : (ℝ × TransverseSpace i) × E6 ↦
      z.1.1 ^ n *
        (cubeSignedInputProduct F z.2 *
          cubeFaceKernel α i lam r z.1.1 (faceInsert i c z.1.2) z.2))
      (μ.prod volume) := by
    refine hmajor.mono hmeas ?_
    filter_upwards [hcell'] with z hz
    change z.1.1 ∈ Set.Ioc (boxLength Q / 2) (boxLength Q) ∧
      z.1.2 ∈ transverseRectangle α Q i at hz
    rcases hz with ⟨htband, hy⟩
    have htpos : 0 < z.1.1 := lt_trans hLhalf htband.1
    have hpclosed : faceInsert i c z.1.2 ∈ boxClosedSet α Q := by
      dsimp only [c]
      exact scratch_faceInsert_mem_boxClosedSet α Q i o z.1.2 hy
    have hweight := scratch_cubeBracketWeight_le_boxCenterWeight α Q hpclosed
      htpos htband.1.le htband.2 z.2
    have hkernel := hdom i lam r z.1.1 (faceInsert i c z.1.2) z.2 hlam htpos
    have hpowle : z.1.1 ^ n ≤ boxLength Q ^ n :=
      pow_le_pow_left₀ htpos.le htband.2 n
    have hpow0 : 0 ≤ z.1.1 ^ n := pow_nonneg htpos.le _
    have hinner0 : 0 ≤ B * (D *
        cubeBracketWeight α z.1.1 (faceInsert i c z.1.2) z.2) := by
      exact mul_nonneg hB (mul_nonneg hD
        (cubeBracketWeight_nonneg α htpos.le (faceInsert i c z.1.2) z.2))
    have hfixed0 : 0 ≤ B * (D * (A *
        cubeBracketWeight α (boxLength Q) (boxCenter α Q) z.2)) := by
      exact mul_nonneg hB (mul_nonneg hD (mul_nonneg hA
        (cubeBracketWeight_nonneg α (boxLength_pos Q).le (boxCenter α Q) z.2)))
    have hmajor0 : 0 ≤ (B * D * A * boxLength Q ^ n) *
        cubeBracketWeight α (boxLength Q) (boxCenter α Q) z.2 := by
      exact mul_nonneg
        (mul_nonneg (mul_nonneg (mul_nonneg hB hD) hA)
          (pow_nonneg (boxLength_pos Q).le _))
        (cubeBracketWeight_nonneg α (boxLength_pos Q).le (boxCenter α Q) z.2)
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul,
      abs_of_nonneg hpow0, abs_mul, abs_of_nonneg hmajor0]
    calc
      z.1.1 ^ n *
          (|cubeSignedInputProduct F z.2| *
            |cubeFaceKernel α i lam r z.1.1 (faceInsert i c z.1.2) z.2|) ≤
          z.1.1 ^ n * (B * (D *
            cubeBracketWeight α z.1.1 (faceInsert i c z.1.2) z.2)) :=
        mul_le_mul_of_nonneg_left
          (mul_le_mul (hinput z.2) hkernel (abs_nonneg _) hB) hpow0
      _ ≤ z.1.1 ^ n * (B * (D * (A *
          cubeBracketWeight α (boxLength Q) (boxCenter α Q) z.2))) := by
        exact mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_left hweight hD) hB) hpow0
      _ ≤ boxLength Q ^ n * (B * (D * (A *
          cubeBracketWeight α (boxLength Q) (boxCenter α Q) z.2))) :=
        mul_le_mul hpowle le_rfl hfixed0
          (pow_nonneg (boxLength_pos Q).le _)
      _ = (B * D * A * boxLength Q ^ n) *
          cubeBracketWeight α (boxLength Q) (boxCenter α Q) z.2 := by ring
  change Integrable (fun z : (ℝ × TransverseSpace i) × E6 ↦
      z.1.1 ^ n *
        (cubeSignedInputProduct F z.2 *
          cubeFaceKernel α i lam r z.1.1 (faceInsert i c z.1.2) z.2))
      (μ.prod volume)
  exact hraw

/-- The face triple-integrability estimate supplies precisely the weighted
scale integrability of the source face integral used in the remainder. -/
theorem scratch_integrableOn_cubeFaceIntegral_scale
    (α : Anisotropy) (Q : AnisoBox α) (i : Fin 3) (o : FaceOrientation)
    (lam r : ℝ) (F : CubeVertex → E3 → ℝ)
    (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B)
    (hlam : 1 ≤ lam) :
    IntegrableOn (fun t : ℝ ↦
      t ^ (α.weight i - 1) * cubeFaceIntegral α i ⟨Q, o⟩ lam r t F)
      (Set.Ioc (boxLength Q / 2) (boxLength Q)) := by
  let μT : Measure ℝ :=
    volume.restrict (Set.Ioc (boxLength Q / 2) (boxLength Q))
  let μY : Measure (TransverseSpace i) :=
    volume.restrict (transverseRectangle α Q i)
  let g : (ℝ × TransverseSpace i) → E6 → ℝ := fun ty x ↦
    ty.1 ^ (α.weight i - 1) *
      (cubeSignedInputProduct F x * cubeFaceKernel α i lam r ty.1
        (faceInsert i (boxFaceCoordinate α Q i o) ty.2) x)
  have h : Integrable (Function.uncurry g) ((μT.prod μY).prod volume) := by
    simpa only [g, μT, μY] using
      scratch_integrable_cubeFaceScaleIntegrand α Q i o lam r F hFcont hFbound hlam
  have hT : Integrable (fun t : ℝ ↦
      ∫ y : TransverseSpace i, ∫ x : E6, g (t, y) x ∂volume ∂μY) μT :=
    h.integral_prod_left.integral_prod_left
  change Integrable (fun t : ℝ ↦
      t ^ (α.weight i - 1) * cubeFaceIntegral α i ⟨Q, o⟩ lam r t F) μT
  refine hT.congr ?_
  filter_upwards [] with t
  dsimp only [g]
  unfold cubeFaceIntegral
  rw [show (fun y : TransverseSpace i ↦
      ∫ x : E6, t ^ (α.weight i - 1) *
        (cubeSignedInputProduct F x * cubeFaceKernel α i lam r t
          (faceInsert i (boxFaceCoordinate α Q i o) y) x) ∂volume) =
      (fun y : TransverseSpace i ↦ t ^ (α.weight i - 1) *
        ∫ x : E6, cubeSignedInputProduct F x * cubeFaceKernel α i lam r t
          (faceInsert i (boxFaceCoordinate α Q i o) y) x) by
        funext y
        rw [MeasureTheory.integral_const_mul],
    MeasureTheory.integral_const_mul]

/-- The one-cell local-kernel integrability package with the spatial input
removed.  This is useful for a.e. fixed-spatial-point Fubini sections. -/
theorem scratch_integrable_localCubeKernel_boxScaleCell
    (α : Anisotropy) (Q : AnisoBox α) (i : Fin 3) (lam r : ℝ)
    (hlam : 1 ≤ lam) :
    Integrable (fun z : (E3 × ℝ) × E6 ↦
      localCubeKernel α i lam r z.1.2 z.1.1 z.2)
      (((volume.restrict (boxSet α Q)).prod
        ((volume.withDensity cubeScaleDensity).restrict (boxScaleBand Q))).prod volume) := by
  let F₁ : CubeVertex → E3 → ℝ := fun _ _ ↦ 1
  have h := scratch_integrable_cubeSignedInputProduct_mul_localCubeKernel_boxScaleCell
    α Q i lam r F₁ (fun _ ↦ continuous_const)
      (fun _ ↦ ⟨1, by norm_num, fun _ ↦ by norm_num⟩) hlam
  simpa only [F₁, cubeSignedInputProduct, Finset.prod_const_one, one_mul] using h

/-- The corresponding bare endpoint-kernel cell integrability statement. -/
theorem scratch_integrable_cubeEndpointKernel_boxScaleCell
    (α : Anisotropy) (Q : AnisoBox α) (lam r : ℝ) (hlam : 1 ≤ lam) :
    Integrable (fun z : (E3 × ℝ) × E6 ↦
      cubeEndpointKernel α lam r z.1.2 z.1.1 z.2)
      (((volume.restrict (boxSet α Q)).prod
        ((volume.withDensity cubeScaleDensity).restrict (boxScaleBand Q))).prod volume) := by
  let F₁ : CubeVertex → E3 → ℝ := fun _ _ ↦ 1
  have h := scratch_integrable_cubeSignedInputProduct_mul_cubeEndpointKernel_boxScaleCell
    α Q lam r F₁ (fun _ ↦ continuous_const)
      (fun _ ↦ ⟨1, by norm_num, fun _ ↦ by norm_num⟩) hlam
  simpa only [F₁, cubeSignedInputProduct, Finset.prod_const_one, one_mul] using h

/-- The corresponding bare face-kernel cell integrability statement. -/
theorem scratch_integrable_cubeFaceKernel_boxScaleCell
    (α : Anisotropy) (Q : AnisoBox α) (i : Fin 3) (lam r : ℝ)
    (hlam : 1 ≤ lam) :
    Integrable (fun z : (E3 × ℝ) × E6 ↦
      cubeFaceKernel α i lam r z.1.2 z.1.1 z.2)
      (((volume.restrict (boxSet α Q)).prod
        ((volume.withDensity cubeScaleDensity).restrict (boxScaleBand Q))).prod volume) := by
  let F₁ : CubeVertex → E3 → ℝ := fun _ _ ↦ 1
  have h := scratch_integrable_cubeSignedInputProduct_mul_cubeFaceKernel_boxScaleCell
    α Q i lam r F₁ (fun _ ↦ continuous_const)
      (fun _ ↦ ⟨1, by norm_num, fun _ ↦ by norm_num⟩) hlam
  simpa only [F₁, cubeSignedInputProduct, Finset.prod_const_one, one_mul] using h

/-- The unweighted scale--face--space package obtained by putting every cube
input equal to one. -/
theorem scratch_integrable_cubeFaceScaleKernel
    (α : Anisotropy) (Q : AnisoBox α) (i : Fin 3) (o : FaceOrientation)
    (lam r : ℝ) (hlam : 1 ≤ lam) :
    Integrable (Function.uncurry
      (fun ty : ℝ × TransverseSpace i ↦ fun x : E6 ↦
        ty.1 ^ (α.weight i - 1) *
          cubeFaceKernel α i lam r ty.1
            (faceInsert i (boxFaceCoordinate α Q i o) ty.2) x))
      (((volume.restrict (Set.Ioc (boxLength Q / 2) (boxLength Q))).prod
        (volume.restrict (transverseRectangle α Q i))).prod volume) := by
  let F₁ : CubeVertex → E3 → ℝ := fun _ _ ↦ 1
  have h := scratch_integrable_cubeFaceScaleIntegrand α Q i o lam r F₁
    (fun _ ↦ continuous_const)
    (fun _ ↦ ⟨1, by norm_num, fun _ ↦ by norm_num⟩) hlam
  simpa only [F₁, cubeSignedInputProduct, Finset.prod_const_one, one_mul] using h

/-- The bounded-continuous finite-tree remainder estimate.  The constant
depends only on the anisotropy; the analytic powers are the exact endpoint
and face losses `λ^36 R^20` and `λ^37 R^21`, absorbed into the latter. -/
theorem scratch_cubeTreeRemainder_bound_of_boundedContinuous
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α) (lam r : ℝ)
      (F : CubeVertex → E3 → ℝ),
      (∀ j, Continuous (F j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B) →
      1 ≤ lam →
      |cubeTreeRemainder α T lam r F| ≤
        C * lam ^ 37 * translationWeight r ^ 21 *
          (∏ j : CubeVertex, treeLocalSize T 4 (F j)) * boxMass α T.root := by
  rcases abs_integral_cubeEndpointKernel_le_treeLocalSize_product_of_mem_closure α
    with ⟨CE, hCE, hEndpoint⟩
  rcases abs_integral_cubeFaceKernel_le_treeLocalSize_product_of_mem_closure α
    with ⟨CF, hCF, hFace⟩
  refine ⟨2 * Real.pi * CE + 24 * Real.pi * CF, ?_, ?_⟩
  · exact add_nonneg
      (mul_nonneg (mul_nonneg (by norm_num) Real.pi_pos.le) hCE)
      (mul_nonneg (mul_nonneg (by norm_num) Real.pi_pos.le) hCF)
  · intro T lam r F hFcont hFbound hlam
    have hFmeas : ∀ j, Measurable (F j) := fun j ↦ (hFcont j).measurable
    let P : ℝ := ∏ j : CubeVertex, treeLocalSize T 4 (F j)
    let DE : ℝ := CE * lam ^ 36 * translationWeight r ^ 20 * P
    let DF : ℝ := CF * lam ^ 37 * translationWeight r ^ 21 * P
    have hP : 0 ≤ P := by
      dsimp only [P]
      exact scratch_treeLocalSize_product_four_nonneg T F
    have hlam0 : 0 ≤ lam := by linarith
    have hR0 : 0 ≤ translationWeight r := by
      unfold translationWeight
      positivity
    have hDF : 0 ≤ DF := by
      dsimp only [DF]
      exact mul_nonneg
        (mul_nonneg
          (mul_nonneg hCF (pow_nonneg hlam0 _))
          (pow_nonneg hR0 _)) hP
    have hLeafInt : ∀ q ∈ treeLeaves T,
        IntegrableOn (cubeEndpointIntegrand α lam r (boxLength q) F)
          (boxSet α q) := by
      intro q hq
      exact integrableOn_cubeEndpointIntegrand_boxSet α q lam r (boxLength q) F
        hFcont hFbound hlam (boxLength_pos q)
    have hLeafBound : ∀ q ∈ treeLeaves T, ∀ p ∈ boxSet α q,
        |cubeEndpointIntegrand α lam r (boxLength q) F p| ≤ DE := by
      intro q hq p hp
      change |∫ x : E6, cubeSignedInputProduct F x *
        cubeEndpointKernel α lam r (boxLength q) p x| ≤ DE
      exact hEndpoint T lam r (boxLength q) p F hFcont hFmeas hFbound hlam
        (mem_closure_collectionRegion_of_mem_leaf_boxSet_fullScale α T q hq hp)
    have hRootInt : IntegrableOn
        (cubeEndpointIntegrand α lam r (boxLength T.root) F)
        (boxSet α T.root) :=
      integrableOn_cubeEndpointIntegrand_boxSet α T.root lam r (boxLength T.root) F
        hFcont hFbound hlam (boxLength_pos T.root)
    have hRootBound : ∀ p ∈ boxSet α T.root,
        |cubeEndpointIntegrand α lam r (boxLength T.root) F p| ≤ DE := by
      intro p hp
      change |∫ x : E6, cubeSignedInputProduct F x *
        cubeEndpointKernel α lam r (boxLength T.root) p x| ≤ DE
      exact hEndpoint T lam r (boxLength T.root) p F hFcont hFmeas hFbound hlam
        (mem_closure_collectionRegion_of_mem_boxSet_fullScale α T T.root T.root_mem hp)
    have hFaceInt : ∀ (i : Fin 3) (S : OrientedFace α),
        S ∈ survivingFacesAll T i →
        IntegrableOn (fun t : ℝ ↦ t ^ (α.weight i - 1) *
          cubeFaceIntegral α i S lam r t F)
          (Set.Ioc (boxLength S.box / 2) (boxLength S.box)) := by
      intro i S hS
      simpa only using integrableOn_cubeFaceIntegral_scale α S.box i S.orientation
        lam r F hFcont hFbound hlam
    have hFaceBound : ∀ (i : Fin 3) (S : OrientedFace α),
        S ∈ survivingFacesAll T i →
        ∀ t ∈ Set.Ioc (boxLength S.box / 2) (boxLength S.box),
          |cubeFaceIntegral α i S lam r t F| ≤ DF * transverseArea α S.box i := by
      intro i S hS t ht
      let g : TransverseSpace i → ℝ := fun y ↦ ∫ x : E6,
        cubeSignedInputProduct F x * cubeFaceKernel α i lam r t
          (faceInsert i (boxFaceCoordinate α S.box i S.orientation) y) x
      have htpos : 0 < t := by
        exact lt_trans (div_pos (boxLength_pos S.box) (by norm_num)) ht.1
      have hg : IntegrableOn g (transverseRectangle α S.box i) := by
        dsimp only [g]
        exact integrable_cubeFaceKernel_face_outer α S.box i
          (boxFaceCoordinate α S.box i S.orientation) lam r t F
          hFcont hFbound hlam htpos
      have hbox : S.box ∈ T.boxes := (mem_survivingFacesAll_iff T i S).mp hS |>.1
      have hgy : ∀ y ∈ transverseRectangle α S.box i, |g y| ≤ DF := by
        intro y hy
        dsimp only [g, DF]
        exact hFace T i lam r t
          (faceInsert i (boxFaceCoordinate α S.box i S.orientation) y) F
          hFcont hFmeas hFbound hlam
          (mem_closure_collectionRegion_face α T.boxes S.box i S.orientation
            hbox hy (Set.Ioc_subset_Icc_self ht))
      simpa only [cubeFaceIntegral, g] using
        abs_integral_transverseRectangle_le_const_mul_area α S.box i g hg DF hgy
    have hrem := abs_cubeTreeRemainder_le_of_uniform_bounds α T lam r F DE DF hDF
      hLeafInt hLeafBound hRootInt hRootBound hFaceInt hFaceBound
    have hlam36 : lam ^ 36 ≤ lam ^ 37 := by
      calc
        lam ^ 36 = lam ^ 36 * 1 := by ring
        _ ≤ lam ^ 36 * lam :=
          mul_le_mul_of_nonneg_left hlam (pow_nonneg hlam0 _)
        _ = lam ^ 37 := by ring
    have hRone : 1 ≤ translationWeight r := by
      unfold translationWeight
      linarith [abs_nonneg r]
    have hR20 : translationWeight r ^ 20 ≤ translationWeight r ^ 21 := by
      calc
        translationWeight r ^ 20 = translationWeight r ^ 20 * 1 := by ring
        _ ≤ translationWeight r ^ 20 * translationWeight r :=
          mul_le_mul_of_nonneg_left hRone (pow_nonneg hR0 _)
        _ = translationWeight r ^ 21 := by ring
    have hscale : lam ^ 36 * translationWeight r ^ 20 ≤
        lam ^ 37 * translationWeight r ^ 21 :=
      mul_le_mul hlam36 hR20 (pow_nonneg hR0 _) (pow_nonneg hlam0 _)
    have hDE : DE ≤ CE * lam ^ 37 * translationWeight r ^ 21 * P := by
      dsimp only [DE]
      calc
        CE * lam ^ 36 * translationWeight r ^ 20 * P =
            (CE * (lam ^ 36 * translationWeight r ^ 20)) * P := by ring
        _ ≤ (CE * (lam ^ 37 * translationWeight r ^ 21)) * P :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left hscale hCE) hP
        _ = CE * lam ^ 37 * translationWeight r ^ 21 * P := by ring
    have hcoef : 0 ≤ 2 * Real.pi := by positivity
    have hterm : 2 * Real.pi * DE ≤
        2 * Real.pi * (CE * lam ^ 37 * translationWeight r ^ 21 * P) :=
      mul_le_mul_of_nonneg_left hDE hcoef
    have hsum :
        2 * Real.pi * DE + 24 * Real.pi * DF ≤
          2 * Real.pi * (CE * lam ^ 37 * translationWeight r ^ 21 * P) +
            24 * Real.pi * (CF * lam ^ 37 * translationWeight r ^ 21 * P) := by
      apply add_le_add hterm
      exact le_rfl
    calc
      |cubeTreeRemainder α T lam r F| ≤
          (2 * Real.pi * DE + 24 * Real.pi * DF) * boxMass α T.root := hrem
      _ ≤ (2 * Real.pi * (CE * lam ^ 37 * translationWeight r ^ 21 * P) +
            24 * Real.pi * (CF * lam ^ 37 * translationWeight r ^ 21 * P)) *
            boxMass α T.root :=
        mul_le_mul_of_nonneg_right hsum (boxMass_pos α T.root).le
      _ = (2 * Real.pi * CE + 24 * Real.pi * CF) * lam ^ 37 *
            translationWeight r ^ 21 * P * boxMass α T.root := by ring
      _ = (2 * Real.pi * CE + 24 * Real.pi * CF) * lam ^ 37 *
            translationWeight r ^ 21 *
            (∏ j : CubeVertex, treeLocalSize T 4 (F j)) * boxMass α T.root := by
        rfl

/-- The exact finite-tree telescope turns the remainder estimate into the
corresponding weighted sum of local cube forms. -/
theorem scratch_cubeTreeTelescope_bound_of_boundedContinuous
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α) (lam r : ℝ)
      (F : CubeVertex → E3 → ℝ),
      (∀ j, Continuous (F j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B) →
      1 ≤ lam →
      |∑ i : Fin 3, (α.weight i : ℝ) *
        localCubeForm α T.boxes i lam r F| ≤
        C * lam ^ 37 * translationWeight r ^ 21 *
          (∏ j : CubeVertex, treeLocalSize T 4 (F j)) * boxMass α T.root := by
  rcases scratch_cubeTreeRemainder_bound_of_boundedContinuous α with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro T lam r F hFcont hFbound hlam
  rw [cubeTree_telescope_of_boundedContinuous α T lam r F hFcont hFbound hlam]
  exact hbound T lam r F hFcont hFbound hlam

/-- The edge tuple used in the Section 4 specialization: precisely the
vertices `000` and `001` carry `f`.  Defining it through its first two bits
makes its invariance under the third-coordinate copies definitional. -/
noncomputable def scratch_edgeCubeTuple (f : E3 → ℝ) : CubeVertex → E3 → ℝ :=
  fun j ↦ if j 0 = false ∧ j 1 = false then f else fun _ ↦ 1

theorem scratch_edgeCubeTuple_at_000 (f : E3 → ℝ) :
    scratch_edgeCubeTuple f (cubePairVertex false false) = f := by
  funext x
  simp [scratch_edgeCubeTuple, cubePairVertex]

theorem scratch_edgeCubeTuple_at_001 (f : E3 → ℝ) :
    scratch_edgeCubeTuple f (cubePairVertex false true) = f := by
  funext x
  simp [scratch_edgeCubeTuple, cubePairVertex]

theorem scratch_edgeCubeTuple_at_other (f : E3 → ℝ) (j : CubeVertex)
    (hj : ¬ (j 0 = false ∧ j 1 = false)) :
    scratch_edgeCubeTuple f j = fun _ ↦ 1 := by
  funext x
  simp [scratch_edgeCubeTuple, hj]

/-- Copying the edge tuple in its active third coordinate leaves it fixed. -/
theorem scratch_cubeCoordinateCopy_two_edgeCubeTuple
    (f : E3 → ℝ) (b : Bool) :
    cubeCoordinateCopy 2 b (scratch_edgeCubeTuple f) = scratch_edgeCubeTuple f := by
  funext j x
  simp only [cubeCoordinateCopy, scratch_edgeCubeTuple]
  by_cases h0 : j 0 = false <;> by_cases h1 : j 1 = false <;>
    simp [cubeVertexReplace, h0, h1]

/-- The elementary continuity package for the two-active-slot edge tuple. -/
theorem scratch_continuous_edgeCubeTuple (f : E3 → ℝ) (hf : Continuous f) :
    ∀ j, Continuous (scratch_edgeCubeTuple f j) := by
  intro j
  by_cases hj : j 0 = false ∧ j 1 = false
  · simpa [scratch_edgeCubeTuple, hj] using hf
  · simpa [scratch_edgeCubeTuple, hj] using
      (continuous_const : Continuous (fun _ : E3 ↦ (1 : ℝ)))

/-- The elementary boundedness package for the two-active-slot edge tuple. -/
theorem scratch_bounded_edgeCubeTuple (f : E3 → ℝ)
    (hf : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) :
    ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |scratch_edgeCubeTuple f j y| ≤ B := by
  intro j
  rcases hf with ⟨B, hB, hfB⟩
  by_cases hj : j 0 = false ∧ j 1 = false
  · exact ⟨B, hB, by simpa [scratch_edgeCubeTuple, hj] using hfB⟩
  · refine ⟨1, zero_le_one, ?_⟩
    intro y
    simp [scratch_edgeCubeTuple, hj]

/-- The signed input product for the edge tuple has exactly its two source
factors; the other six slots are literal ones. -/
theorem scratch_cubeSignedInputProduct_edgeCubeTuple (f : E3 → ℝ) (x : E6) :
    cubeSignedInputProduct (scratch_edgeCubeTuple f) x =
      f (cubeProjection (cubePairVertex false false) x) *
        f (cubeProjection (cubePairVertex false true) x) := by
  have hactive : Finset.univ.filter (fun j : CubeVertex ↦
      j 0 = false ∧ j 1 = false) =
      {cubePairVertex false false, cubePairVertex false true} := by
    ext j
    simp only [Finset.mem_filter, Finset.mem_univ, true_and,
      Finset.mem_insert, Finset.mem_singleton]
    constructor
    · rintro ⟨h0, h1⟩
      have hj : j = cubePairVertex false (j 2) := by
        funext k
        fin_cases k <;> simp [cubePairVertex, h0, h1]
      rw [hj]
      cases j 2 <;> simp [cubePairVertex]
    · intro hj
      rcases hj with hj | hj
      · subst j
        simp [cubePairVertex]
      · subst j
        simp [cubePairVertex]
  rw [cubeSignedInputProduct]
  simp_rw [scratch_edgeCubeTuple]
  change (∏ j : CubeVertex,
    if j 0 = false ∧ j 1 = false then f (cubeProjection j x) else 1) = _
  rw [Finset.prod_ite]
  rw [hactive]
  simp [cubePairVertex]

/-- The unsigned cube input for the edge tuple retains the same two active
slots, now with absolute values. -/
theorem scratch_cubeInputProduct_edgeCubeTuple (f : E3 → ℝ) (x : E6) :
    cubeInputProduct (scratch_edgeCubeTuple f) x =
      |f (cubeProjection (cubePairVertex false false) x)| *
        |f (cubeProjection (cubePairVertex false true) x)| := by
  rw [← scratch_abs_cubeSignedInputProduct_eq_cubeInputProduct,
    scratch_cubeSignedInputProduct_edgeCubeTuple, abs_mul]

/-- The full positive cube bracket average for the edge tuple is exactly the
two-slot edge average with absolute-valued data. -/
theorem scratch_cubeBracketAverage_edgeCubeTuple_eq_edgeBracketAverage
    (α : Anisotropy) (t : ℝ) (p : E3) (f : E3 → ℝ) :
    cubeBracketAverage α t p (scratch_edgeCubeTuple f) =
      cubeEdgeBracketAverage α t p (fun y ↦ |f y|) (fun y ↦ |f y|) := by
  unfold cubeBracketAverage cubeEdgeBracketAverage
  apply integral_congr_ae
  filter_upwards [] with x
  rw [scratch_cubeInputProduct_edgeCubeTuple]

/-- A local form vanishes as soon as its fixed center--scale spatial
integral vanishes.  This isolates the outer `dp dt/t` bookkeeping from the
one-dimensional cancellation used by the edge specialization. -/
theorem scratch_localCubeForm_eq_zero_of_spatial_zero
    (α : Anisotropy) (S : BoxCollection α) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ)
    (hzero : ∀ z : E3 × ℝ,
      (∫ x : E6, cubeSignedInputProduct F x *
        localCubeKernel α i lam r z.2 z.1 x) = 0) :
    localCubeForm α S i lam r F = 0 := by
  unfold localCubeForm
  apply integral_eq_zero_of_ae
  filter_upwards [] with z
  exact hzero z

/-- The exact outer-form interface for the first edge cancellation.  Its
hypothesis is precisely the fixed-`(p,t)` Fubini conclusion obtained by
integrating the unused `x₁¹` derivative Gaussian. -/
theorem scratch_edge_localCubeForm_zero_zero_of_spatial_cancellation
    (α : Anisotropy) (S : BoxCollection α) (lam r : ℝ) (f : E3 → ℝ)
    (hzero : ∀ z : E3 × ℝ,
      (∫ x : E6, cubeSignedInputProduct (scratch_edgeCubeTuple f) x *
        localCubeKernel α 0 lam r z.2 z.1 x) = 0) :
    localCubeForm α S 0 lam r (scratch_edgeCubeTuple f) = 0 :=
  scratch_localCubeForm_eq_zero_of_spatial_zero α S 0 lam r
    (scratch_edgeCubeTuple f) hzero

/-- The exact outer-form interface for the second edge cancellation.  Its
hypothesis is the corresponding Fubini conclusion for `x₂¹`. -/
theorem scratch_edge_localCubeForm_zero_one_of_spatial_cancellation
    (α : Anisotropy) (S : BoxCollection α) (lam r : ℝ) (f : E3 → ℝ)
    (hzero : ∀ z : E3 × ℝ,
      (∫ x : E6, cubeSignedInputProduct (scratch_edgeCubeTuple f) x *
        localCubeKernel α 1 lam r z.2 z.1 x) = 0) :
    localCubeForm α S 1 lam r (scratch_edgeCubeTuple f) = 0 :=
  scratch_localCubeForm_eq_zero_of_spatial_zero α S 1 lam r
    (scratch_edgeCubeTuple f) hzero

/-- The third-coordinate edge form is nonnegative once its Fubini square
representation is available.  The equality uses the actual edge tuple;
`scratch_cubeCoordinateCopy_two_edgeCubeTuple` is the slot-level bridge to
the general cubical-copy positivity statement. -/
theorem scratch_edge_localCubeForm_two_nonneg_of_square
    (α : Anisotropy) (S : BoxCollection α) (lam r : ℝ) (f : E3 → ℝ)
    {X : Type*} [MeasurableSpace X] (μ : Measure X) (A : X → ℝ)
    (hsquare : localCubeForm α S 2 lam r (scratch_edgeCubeTuple f) =
      ∫ x, A x ^ 2 ∂μ) :
    0 ≤ localCubeForm α S 2 lam r (scratch_edgeCubeTuple f) := by
  rw [hsquare]
  exact integral_nonneg fun x ↦ sq_nonneg (A x)

/-- Slot-level conversion of copied-form positivity into positivity of the
edge form itself.  This is the exact one-line consumer of the generic
cube-Cauchy--Schwarz positivity lemma. -/
theorem scratch_edge_localCubeForm_two_nonneg_of_copy
    (α : Anisotropy) (S : BoxCollection α) (lam r : ℝ) (f : E3 → ℝ)
    (b : Bool)
    (hcopy : 0 ≤ localCubeForm α S 2 lam r
      (cubeCoordinateCopy 2 b (scratch_edgeCubeTuple f))) :
    0 ≤ localCubeForm α S 2 lam r (scratch_edgeCubeTuple f) := by
  rw [scratch_cubeCoordinateCopy_two_edgeCubeTuple] at hcopy
  exact hcopy

/-- At a designated box center and scale, the edge second moment is exactly
the local power with exponent two. -/
theorem scratch_cubeSecondMoment_at_box_eq_boxLocalPower_two
    (α : Anisotropy) (q : AnisoBox α) (f : E3 → ℝ) :
    cubeSecondMoment α (boxLength q) (boxCenter α q) f =
      boxLocalPower α 2 f q := by
  unfold cubeSecondMoment boxLocalPower
  apply integral_congr_ae
  filter_upwards [] with y
  rw [← sq_abs]
  norm_num [Real.rpow_natCast]

/-- The square of the exponent-two local size recovers its local power. -/
theorem scratch_boxLocalSize_two_sq_eq_boxLocalPower
    (α : Anisotropy) (q : AnisoBox α) (f : E3 → ℝ) :
    boxLocalSize α 2 f q ^ 2 = boxLocalPower α 2 f q := by
  have hpower : 0 ≤ boxLocalPower α 2 f q := by
    unfold boxLocalPower
    apply integral_nonneg
    intro y
    exact mul_nonneg (Real.rpow_nonneg (abs_nonneg (f y)) _)
      (anisotropicBracketKernel_nonneg α (boxLength_pos q).le (boxCenter α q) y)
  unfold boxLocalSize
  convert Real.rpow_inv_natCast_pow hpower (by norm_num : (2 : ℕ) ≠ 0) using 1 <;>
    norm_num

/-- Therefore the edge second moment at a tree box is the square of its
exponent-two local size. -/
theorem scratch_cubeSecondMoment_at_box_eq_boxLocalSize_two_sq
    (α : Anisotropy) (q : AnisoBox α) (f : E3 → ℝ) :
    cubeSecondMoment α (boxLength q) (boxCenter α q) f =
      boxLocalSize α 2 f q ^ 2 := by
  rw [scratch_cubeSecondMoment_at_box_eq_boxLocalPower_two]
  exact (scratch_boxLocalSize_two_sq_eq_boxLocalPower α q f).symm

/-- The exponent-two tree local size is nonnegative. -/
theorem scratch_treeLocalSize_two_nonneg
    (T : FiniteConvexTree α) (f : E3 → ℝ) :
    0 ≤ treeLocalSize T 2 f := by
  unfold treeLocalSize collectionLocalSize
  split_ifs with hT
  · rcases hT with ⟨q, hq⟩
    exact (show 0 ≤ boxLocalSize α 2 f q by
      unfold boxLocalSize boxLocalPower
      apply Real.rpow_nonneg
      apply integral_nonneg
      intro y
      exact mul_nonneg (Real.rpow_nonneg (abs_nonneg (f y)) _)
        (anisotropicBracketKernel_nonneg α (boxLength_pos q).le
          (boxCenter α q) y)).trans
      (Finset.le_sup' (boxLocalSize α 2 f) hq)
  · norm_num

/-- The edge second moment at a tree box is controlled by the square of the
exponent-two tree local size. -/
theorem scratch_cubeSecondMoment_at_box_le_treeLocalSize_two_sq
    {α : Anisotropy} (T : FiniteConvexTree α) {q : AnisoBox α}
    (hq : q ∈ T.boxes) (f : E3 → ℝ) :
    cubeSecondMoment α (boxLength q) (boxCenter α q) f ≤
      treeLocalSize T 2 f ^ 2 := by
  rw [scratch_cubeSecondMoment_at_box_eq_boxLocalSize_two_sq]
  apply pow_le_pow_left₀
  · unfold boxLocalSize boxLocalPower
    apply Real.rpow_nonneg
    apply integral_nonneg
    intro y
    exact mul_nonneg (Real.rpow_nonneg (abs_nonneg (f y)) _)
      (anisotropicBracketKernel_nonneg α (boxLength_pos q).le (boxCenter α q) y)
  · change boxLocalSize α 2 f q ≤ collectionLocalSize α T.boxes 2 f
    exact boxLocalSize_le_collectionLocalSize T.boxes hq 2 f

/-- Absolute values do not change the second moment. -/
theorem scratch_cubeSecondMoment_abs_eq
    (α : Anisotropy) (t : ℝ) (p : E3) (f : E3 → ℝ) :
    cubeSecondMoment α t p (fun y ↦ |f y|) = cubeSecondMoment α t p f := by
  unfold cubeSecondMoment
  apply integral_congr_ae
  filter_upwards [] with y
  rw [sq_abs]

/-- The positive edge bracket average with the same edge input twice is
bounded by its second moment. -/
theorem scratch_cubeEdgeBracketAverage_abs_self_le_secondMoment
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3) (f : E3 → ℝ)
    (hfmeas : Measurable f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) :
    cubeEdgeBracketAverage α t p (fun y ↦ |f y|) (fun y ↦ |f y|) ≤
      cubeSecondMoment α t p f := by
  rcases hfbound with ⟨B, hB, hfB⟩
  have habsmeas : Measurable (fun y ↦ |f y|) :=
    continuous_abs.measurable.comp hfmeas
  have habsnonneg : ∀ y, 0 ≤ |f y| := fun y ↦ abs_nonneg _
  have habsbound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f y| ≤ C :=
    ⟨B, hB, hfB⟩
  have hedge := cubeEdgeBracketAverage_le_product_secondMoments α ht p
    (fun y ↦ |f y|) (fun y ↦ |f y|) habsmeas habsmeas habsnonneg habsnonneg
    habsbound habsbound
  have hsecond : cubeSecondMoment α t p (fun y ↦ |f y|) =
      cubeSecondMoment α t p f := scratch_cubeSecondMoment_abs_eq α t p f
  have hnonneg : 0 ≤ cubeSecondMoment α t p f :=
    cubeSecondMoment_nonneg α ht.le p f
  calc
    cubeEdgeBracketAverage α t p (fun y ↦ |f y|) (fun y ↦ |f y|) ≤
        √(cubeSecondMoment α t p (fun y ↦ |f y|)) *
          √(cubeSecondMoment α t p (fun y ↦ |f y|)) := hedge
    _ = √(cubeSecondMoment α t p f) * √(cubeSecondMoment α t p f) := by
      rw [hsecond]
    _ = cubeSecondMoment α t p f := by
      rw [← sq, Real.sq_sqrt hnonneg]

/-- The three-coordinate comparison constant needed for second moments on a
closed box-scale cell. -/
noncomputable def scratch_edgeBoxScaleComparisonConstant (α : Anisotropy) : ℝ :=
  ∏ i : Fin 3, (2 : ℝ) ^ α.weight i * (3 / 2 : ℝ) ^ 10

theorem scratch_edgeBoxScaleComparisonConstant_nonneg (α : Anisotropy) :
    0 ≤ scratch_edgeBoxScaleComparisonConstant α := by
  unfold scratch_edgeBoxScaleComparisonConstant
  apply Finset.prod_nonneg
  intro i _
  positivity

/-- On a closed source cell, the threefold bracket kernel has the same
scale/center comparison as the sixfold kernel, with one factor per ambient
coordinate. -/
theorem scratch_anisotropicBracketKernel_le_boxCenterKernel
    (α : Anisotropy) (q : AnisoBox α) {p : E3} {t : ℝ}
    (hp : p ∈ boxClosedSet α q)
    (ht : 0 < t) (hlower : boxLength q / 2 ≤ t)
    (hupper : t ≤ boxLength q) (y : E3) :
    anisotropicBracketKernel α t p y ≤
      scratch_edgeBoxScaleComparisonConstant α *
        anisotropicBracketKernel α (boxLength q) (boxCenter α q) y := by
  have hfactor (i : Fin 3) :
      bracketKernelAt (t ^ α.weight i) (p i) (y i) ≤
        ((2 : ℝ) ^ α.weight i * (3 / 2 : ℝ) ^ 10) *
          bracketKernelAt (boxLength q ^ α.weight i) (boxCenter α q i) (y i) := by
    have hpow := pow_scale_bounds (boxLength_pos q) ht hlower hupper (α.weight i)
    have hcenter : |p i - boxCenter α q i| ≤ boxLength q ^ α.weight i / 2 := by
      simpa only [boxSide_eq_length_pow] using
        abs_sub_boxCenter_le_half_side α q hp i
    exact bracketKernelAt_le_of_scale_center
      (pow_pos ht _) (pow_pos (boxLength_pos q) _) hpow.1 hpow.2 hcenter
  unfold anisotropicBracketKernel scratch_edgeBoxScaleComparisonConstant
  calc
    (∏ i : Fin 3, bracketKernelAt (t ^ α.weight i) (p i) (y i)) ≤
        ∏ i : Fin 3,
          ((2 : ℝ) ^ α.weight i * (3 / 2 : ℝ) ^ 10) *
            bracketKernelAt (boxLength q ^ α.weight i)
              (boxCenter α q i) (y i) := by
      apply Finset.prod_le_prod
      · intro i _
        exact bracketKernelAt_nonneg (pow_pos ht _).le
      · intro i _
        exact hfactor i
    _ = (∏ i : Fin 3, (2 : ℝ) ^ α.weight i * (3 / 2 : ℝ) ^ 10) *
        ∏ i : Fin 3,
          bracketKernelAt (boxLength q ^ α.weight i)
            (boxCenter α q i) (y i) := by
      rw [Finset.prod_mul_distrib]

/-- Bounded continuous data have an integrable second-moment integrand at
every positive center-scale point. -/
theorem scratch_integrable_cubeSecondMoment_integrand
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) :
    Integrable (fun y ↦ f y ^ 2 * anisotropicBracketKernel α t p y) := by
  rcases hfbound with ⟨B, hB, hfB⟩
  have hmajor : Integrable (fun y ↦ B ^ 2 * anisotropicBracketKernel α t p y) := by
    simpa only [smul_eq_mul] using
      (integrable_anisotropicBracketKernel α ht p).const_mul (B ^ 2)
  have hmeas : AEStronglyMeasurable
      (fun y ↦ f y ^ 2 * anisotropicBracketKernel α t p y) volume :=
    ((hfcont.pow 2).mul (continuous_anisotropicBracketKernel α ht p)).aestronglyMeasurable
  refine hmajor.mono hmeas (Filter.Eventually.of_forall ?_)
  intro y
  have hkernel : 0 ≤ anisotropicBracketKernel α t p y :=
    anisotropicBracketKernel_nonneg α ht.le p y
  have hf2 : f y ^ 2 ≤ B ^ 2 := by
    rw [← sq_abs]
    exact pow_le_pow_left₀ (abs_nonneg _) (hfB y) 2
  have hleft : 0 ≤ f y ^ 2 * anisotropicBracketKernel α t p y :=
    mul_nonneg (sq_nonneg _) hkernel
  have hright : 0 ≤ B ^ 2 * anisotropicBracketKernel α t p y :=
    mul_nonneg (pow_nonneg hB _) hkernel
  simpa only [Real.norm_eq_abs, abs_of_nonneg hleft, abs_of_nonneg hright] using
    (mul_le_mul_of_nonneg_right hf2 hkernel)

/-- A second moment on a closed cell is controlled by the corresponding
second moment at that cell's designated box center and scale. -/
theorem scratch_cubeSecondMoment_le_boxCenterSecondMoment
    (α : Anisotropy) (q : AnisoBox α) {p : E3} {t : ℝ} (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B)
    (hp : p ∈ boxClosedSet α q)
    (ht : 0 < t) (hlower : boxLength q / 2 ≤ t)
    (hupper : t ≤ boxLength q) :
    cubeSecondMoment α t p f ≤
      scratch_edgeBoxScaleComparisonConstant α *
        cubeSecondMoment α (boxLength q) (boxCenter α q) f := by
  let C : ℝ := scratch_edgeBoxScaleComparisonConstant α
  let g : E3 → ℝ := fun y ↦ f y ^ 2 * anisotropicBracketKernel α t p y
  let h : E3 → ℝ := fun y ↦ C *
    (f y ^ 2 * anisotropicBracketKernel α (boxLength q) (boxCenter α q) y)
  have hg : Integrable g := by
    dsimp only [g]
    exact scratch_integrable_cubeSecondMoment_integrand α ht p f hfcont hfbound
  have hbase : Integrable (fun y ↦ f y ^ 2 *
      anisotropicBracketKernel α (boxLength q) (boxCenter α q) y) :=
    scratch_integrable_cubeSecondMoment_integrand α (boxLength_pos q)
      (boxCenter α q) f hfcont hfbound
  have hh : Integrable h := by
    simpa only [h, smul_eq_mul] using hbase.const_mul C
  have hpointwise (y : E3) : g y ≤ h y := by
    have hkernel := scratch_anisotropicBracketKernel_le_boxCenterKernel α q hp ht
      hlower hupper y
    have hf2 : 0 ≤ f y ^ 2 := sq_nonneg _
    change f y ^ 2 * anisotropicBracketKernel α t p y ≤
      C * (f y ^ 2 * anisotropicBracketKernel α (boxLength q) (boxCenter α q) y)
    calc
      f y ^ 2 * anisotropicBracketKernel α t p y ≤
          f y ^ 2 * (C * anisotropicBracketKernel α (boxLength q)
            (boxCenter α q) y) := mul_le_mul_of_nonneg_left hkernel hf2
      _ = C * (f y ^ 2 * anisotropicBracketKernel α (boxLength q)
            (boxCenter α q) y) := by ring
  calc
    cubeSecondMoment α t p f = ∫ y : E3, g y := by rfl
    _ ≤ ∫ y : E3, h y :=
      MeasureTheory.integral_mono_ae hg hh (Filter.Eventually.of_forall hpointwise)
    _ = C * cubeSecondMoment α (boxLength q) (boxCenter α q) f := by
      rw [show h = fun y : E3 ↦ C *
        (f y ^ 2 * anisotropicBracketKernel α (boxLength q) (boxCenter α q) y) by rfl,
        cubeSecondMoment, MeasureTheory.integral_const_mul]
    _ = _ := rfl

/-- The edge second moment is uniformly controlled on a tree region by the
square of the exponent-two tree local size. -/
theorem scratch_cubeSecondMoment_le_treeLocalSize_two_sq_of_mem_closure
    {α : Anisotropy} (T : FiniteConvexTree α) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B)
    {p : E3} {t : ℝ}
    (hpt : (p, t) ∈ closure (collectionRegion α T.boxes)) :
    cubeSecondMoment α t p f ≤
      scratch_edgeBoxScaleComparisonConstant α * treeLocalSize T 2 f ^ 2 := by
  rcases mem_closure_collectionRegion_exists_bounds α T.boxes hpt with
    ⟨q, hq, hp, hlower, hupper⟩
  have ht : 0 < t := by
    exact lt_of_lt_of_le (div_pos (boxLength_pos q) (by norm_num)) hlower
  have hcell := scratch_cubeSecondMoment_le_boxCenterSecondMoment α q f
    hfcont hfbound hp ht hlower hupper
  have hsize := scratch_cubeSecondMoment_at_box_le_treeLocalSize_two_sq T hq f
  exact hcell.trans (mul_le_mul_of_nonneg_left hsize
    (scratch_edgeBoxScaleComparisonConstant_nonneg α))

/-- The edge Brascamp--Lieb average is uniformly bounded on the closure of a
tree region by the square of the exponent-two tree local size. -/
theorem scratch_cubeEdgeBracketAverage_abs_self_le_treeLocalSize_two_sq_of_mem_closure
    {α : Anisotropy} (T : FiniteConvexTree α) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B)
    {p : E3} {t : ℝ}
    (hpt : (p, t) ∈ closure (collectionRegion α T.boxes)) :
    cubeEdgeBracketAverage α t p (fun y ↦ |f y|) (fun y ↦ |f y|) ≤
      scratch_edgeBoxScaleComparisonConstant α * treeLocalSize T 2 f ^ 2 := by
  have ht : 0 < t := pos_of_mem_closure_collectionRegion α T.boxes hpt
  have hedge := scratch_cubeEdgeBracketAverage_abs_self_le_secondMoment α ht p f
    hfcont.measurable hfbound
  have hsize := scratch_cubeSecondMoment_le_treeLocalSize_two_sq_of_mem_closure
    T f hfcont hfbound hpt
  exact hedge.trans hsize

/-- The ordinary positive cube bracket average of the edge tuple has the
same exponent-two tree-size bound. -/
theorem scratch_cubeBracketAverage_edgeCubeTuple_le_treeLocalSize_two_sq_of_mem_closure
    {α : Anisotropy} (T : FiniteConvexTree α) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B)
    {p : E3} {t : ℝ}
    (hpt : (p, t) ∈ closure (collectionRegion α T.boxes)) :
    cubeBracketAverage α t p (scratch_edgeCubeTuple f) ≤
      scratch_edgeBoxScaleComparisonConstant α * treeLocalSize T 2 f ^ 2 := by
  rw [scratch_cubeBracketAverage_edgeCubeTuple_eq_edgeBracketAverage]
  exact scratch_cubeEdgeBracketAverage_abs_self_le_treeLocalSize_two_sq_of_mem_closure
    T f hfcont hfbound hpt

/-- Uniform local-kernel estimate for the two-active-slot edge tuple, with
the exact `λ^36 R(r)^20` loss and the exponent-two tree size. -/
theorem scratch_abs_integral_localCubeKernel_edge_le_treeLocalSize_two_sq_of_mem_closure
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α) (i : Fin 3)
      (lam r t : ℝ) (p : E3) (f : E3 → ℝ),
      Continuous f →
      (∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) →
      1 ≤ lam →
      (p, t) ∈ closure (collectionRegion α T.boxes) →
      |∫ x : E6, cubeSignedInputProduct (scratch_edgeCubeTuple f) x *
        localCubeKernel α i lam r t p x| ≤
        C * lam ^ 36 * translationWeight r ^ 20 * treeLocalSize T 2 f ^ 2 := by
  rcases abs_integral_localCubeKernel_le_bracketAverage α with ⟨C, hC, hlocal⟩
  let S : ℝ := scratch_edgeBoxScaleComparisonConstant α
  refine ⟨C ^ 6 * S,
    mul_nonneg (pow_nonneg hC _) (scratch_edgeBoxScaleComparisonConstant_nonneg α), ?_⟩
  intro T i lam r t p f hfcont hfbound hlam hpt
  have ht : 0 < t := pos_of_mem_closure_collectionRegion α T.boxes hpt
  have hlocal' := hlocal i lam r t p (scratch_edgeCubeTuple f)
    (scratch_continuous_edgeCubeTuple f hfcont)
    (scratch_bounded_edgeCubeTuple f hfbound) hlam ht
  have hsize := scratch_cubeBracketAverage_edgeCubeTuple_le_treeLocalSize_two_sq_of_mem_closure
    T f hfcont hfbound hpt
  have hfac : 0 ≤ C ^ 6 * lam ^ 36 * translationWeight r ^ 20 := by
    have hlam0 : 0 ≤ lam := by linarith
    have hR : 0 ≤ translationWeight r := by
      unfold translationWeight
      positivity
    change 0 ≤ (C ^ (6 : ℕ) * lam ^ (36 : ℕ)) * translationWeight r ^ (20 : ℕ)
    exact mul_nonneg
      (mul_nonneg (pow_nonneg hC _) (pow_nonneg hlam0 _))
      (pow_nonneg hR _)
  calc
    |∫ x : E6, cubeSignedInputProduct (scratch_edgeCubeTuple f) x *
        localCubeKernel α i lam r t p x| ≤
        C ^ 6 * lam ^ 36 * translationWeight r ^ 20 *
          cubeBracketAverage α t p (scratch_edgeCubeTuple f) := hlocal'
    _ ≤ C ^ 6 * lam ^ 36 * translationWeight r ^ 20 *
        (S * treeLocalSize T 2 f ^ 2) :=
      mul_le_mul_of_nonneg_left hsize hfac
    _ = (C ^ 6 * S) * lam ^ 36 * translationWeight r ^ 20 *
        treeLocalSize T 2 f ^ 2 := by ring

/-- Uniform endpoint-kernel estimate for the edge tuple. -/
theorem scratch_abs_integral_cubeEndpointKernel_edge_le_treeLocalSize_two_sq_of_mem_closure
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α)
      (lam r t : ℝ) (p : E3) (f : E3 → ℝ),
      Continuous f →
      (∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) →
