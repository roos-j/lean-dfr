theorem scratch_mem_closure_collectionRegion_exists_bounds
    (α : Anisotropy) (S : BoxCollection α) {p : E3} {t : ℝ}
    (hpt : (p, t) ∈ closure (collectionRegion α S)) :
    ∃ q ∈ S, p ∈ boxClosedSet α q ∧
      boxLength q / 2 ≤ t ∧ t ≤ boxLength q := by
  rw [collectionRegion, Finset.closure_biUnion] at hpt
  rcases Set.mem_iUnion₂.mp hpt with ⟨q, hq, hqpt⟩
  exact ⟨q, hq, scratch_mem_closure_boxScaleRegion_bounds α q hqpt⟩

/-- Raising a scale in `[L/2,L]` to an integral anisotropic weight gives the
precise factor `2^n` used in the one-coordinate bracket comparison. -/
theorem scratch_pow_scale_bounds {L t : ℝ} (hL : 0 < L) (ht : 0 < t)
    (hlower : L / 2 ≤ t) (hupper : t ≤ L) (n : ℕ) :
    L ^ n ≤ (2 : ℝ) ^ n * t ^ n ∧ t ^ n ≤ L ^ n := by
  have hdouble : L ≤ 2 * t := by linarith
  constructor
  · calc
      L ^ n ≤ (2 * t) ^ n := pow_le_pow_left₀ hL.le hdouble n
      _ = (2 : ℝ) ^ n * t ^ n := by rw [mul_pow]
  · exact pow_le_pow_left₀ ht.le hupper n

/-- The product of the six elementary scale-and-center comparison constants.
It depends only on the fixed anisotropy. -/
noncomputable def scratch_boxScaleComparisonConstant (α : Anisotropy) : ℝ :=
  ∏ u : Fin 3 × Bool,
    (2 : ℝ) ^ α.weight u.1 * (3 / 2 : ℝ) ^ 10

theorem scratch_boxScaleComparisonConstant_nonneg (α : Anisotropy) :
    0 ≤ scratch_boxScaleComparisonConstant α := by
  unfold scratch_boxScaleComparisonConstant
  apply Finset.prod_nonneg
  intro u _
  positivity

/-- On the closure of one box-scale cell, the sixfold comparison weight is
controlled by the box-center comparison weight with an anisotropy-only
constant. -/
theorem scratch_cubeBracketWeight_le_boxCenterWeight
    (α : Anisotropy) (q : AnisoBox α) {p : E3} {t : ℝ}
    (hp : p ∈ boxClosedSet α q)
    (ht : 0 < t) (hlower : boxLength q / 2 ≤ t)
    (hupper : t ≤ boxLength q) (x : E6) :
    cubeBracketWeight α t p x ≤
      scratch_boxScaleComparisonConstant α *
        cubeBracketWeight α (boxLength q) (boxCenter α q) x := by
  have hfactor (u : Fin 3 × Bool) :
      bracketKernelAt (t ^ α.weight u.1) (p u.1) (x u) ≤
        ((2 : ℝ) ^ α.weight u.1 * (3 / 2 : ℝ) ^ 10) *
          bracketKernelAt (boxLength q ^ α.weight u.1)
            (boxCenter α q u.1) (x u) := by
    have hpow := scratch_pow_scale_bounds (boxLength_pos q) ht hlower hupper
      (α.weight u.1)
    have hcenter : |p u.1 - boxCenter α q u.1| ≤
        boxLength q ^ α.weight u.1 / 2 := by
      simpa only [boxSide_eq_length_pow] using
        scratch_abs_sub_boxCenter_le_half_side α q hp u.1
    exact bracketKernelAt_le_of_scale_center
      (pow_pos ht _) (pow_pos (boxLength_pos q) _)
      hpow.1 hpow.2 hcenter
  unfold cubeBracketWeight scratch_boxScaleComparisonConstant
  calc
    (∏ u : Fin 3 × Bool,
        bracketKernelAt (t ^ α.weight u.1) (p u.1) (x u)) ≤
        ∏ u : Fin 3 × Bool,
          ((2 : ℝ) ^ α.weight u.1 * (3 / 2 : ℝ) ^ 10) *
            bracketKernelAt (boxLength q ^ α.weight u.1)
              (boxCenter α q u.1) (x u) := by
      apply Finset.prod_le_prod
      · intro u hu
        exact bracketKernelAt_nonneg (pow_pos ht _).le
      · intro u hu
        exact hfactor u
    _ = (∏ u : Fin 3 × Bool,
          (2 : ℝ) ^ α.weight u.1 * (3 / 2 : ℝ) ^ 10) *
        ∏ u : Fin 3 × Bool,
          bracketKernelAt (boxLength q ^ α.weight u.1)
            (boxCenter α q u.1) (x u) := by
      rw [Finset.prod_mul_distrib]

/-- The source cube bracket average at any center-scale point in one closed
cell is controlled by the average at that box's designated center and scale. -/
theorem scratch_cubeBracketAverage_le_boxCenterAverage
    (α : Anisotropy) (q : AnisoBox α) {p : E3} {t : ℝ}
    (F : CubeVertex → E3 → ℝ)
    (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B)
    (hp : p ∈ boxClosedSet α q)
    (ht : 0 < t) (hlower : boxLength q / 2 ≤ t)
    (hupper : t ≤ boxLength q) :
    cubeBracketAverage α t p F ≤
      scratch_boxScaleComparisonConstant α *
        cubeBracketAverage α (boxLength q) (boxCenter α q) F := by
  let C : ℝ := scratch_boxScaleComparisonConstant α
  let f : E6 → ℝ := fun x ↦
    cubeInputProduct F x * cubeBracketWeight α t p x
  let g : E6 → ℝ := fun x ↦
    C * (cubeInputProduct F x *
      cubeBracketWeight α (boxLength q) (boxCenter α q) x)
  have hf : Integrable f :=
    scratch_integrable_cubeInputProduct_mul_cubeBracketWeight
      α t p F hFcont hFbound ht
  have hbase : Integrable (fun x : E6 ↦
      cubeInputProduct F x *
        cubeBracketWeight α (boxLength q) (boxCenter α q) x) :=
    scratch_integrable_cubeInputProduct_mul_cubeBracketWeight
      α (boxLength q) (boxCenter α q) F hFcont hFbound (boxLength_pos q)
  have hg : Integrable g := by
    simpa only [g, smul_eq_mul] using hbase.const_mul C
  have hpointwise (x : E6) : f x ≤ g x := by
    have hweight := scratch_cubeBracketWeight_le_boxCenterWeight α q hp ht
      hlower hupper x
    have hinput : 0 ≤ cubeInputProduct F x := cubeInputProduct_nonneg F x
    change cubeInputProduct F x * cubeBracketWeight α t p x ≤
      C * (cubeInputProduct F x *
        cubeBracketWeight α (boxLength q) (boxCenter α q) x)
    calc
      cubeInputProduct F x * cubeBracketWeight α t p x ≤
          cubeInputProduct F x *
            (C * cubeBracketWeight α (boxLength q) (boxCenter α q) x) :=
        mul_le_mul_of_nonneg_left hweight hinput
      _ = C * (cubeInputProduct F x *
        cubeBracketWeight α (boxLength q) (boxCenter α q) x) := by ring
  calc
    cubeBracketAverage α t p F = ∫ x : E6, f x := by rfl
    _ ≤ ∫ x : E6, g x :=
      MeasureTheory.integral_mono_ae hf hg (Filter.Eventually.of_forall hpointwise)
    _ = C * cubeBracketAverage α (boxLength q) (boxCenter α q) F := by
      rw [show g = fun x : E6 ↦ C *
        (cubeInputProduct F x *
          cubeBracketWeight α (boxLength q) (boxCenter α q) x) by rfl,
        cubeBracketAverage, MeasureTheory.integral_const_mul]
    _ = _ := rfl

/-- The local Brascamp--Lieb average on the closure of a finite tree region
is bounded by an anisotropy-only constant times the product of the tree's
eight fourth local sizes.  This is the source `lem:size`/`lem:bl` bridge used
in the remainder estimate. -/
theorem scratch_cubeBracketAverage_le_treeLocalSize_product_of_mem_closure
    {α : Anisotropy} (T : FiniteConvexTree α) (F : CubeVertex → E3 → ℝ)
    (hFcont : ∀ j, Continuous (F j))
    (hFmeas : ∀ j, Measurable (F j))
    (hFbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B)
    {p : E3} {t : ℝ} (hpt : (p, t) ∈ closure (collectionRegion α T.boxes)) :
    cubeBracketAverage α t p F ≤
      scratch_boxScaleComparisonConstant α *
        ∏ j : CubeVertex, treeLocalSize T 4 (F j) := by
  rcases scratch_mem_closure_collectionRegion_exists_bounds α T.boxes hpt with
    ⟨q, hq, hp, hlower, hupper⟩
  have ht : 0 < t := by
    have hhalf : 0 < boxLength q / 2 :=
      div_pos (boxLength_pos q) (by norm_num)
    exact lt_of_lt_of_le hhalf hlower
  have hcell := scratch_cubeBracketAverage_le_boxCenterAverage
    α q F hFcont hFbound hp ht hlower hupper
  have hsize := cubeBracketAverage_at_box_le_treeLocalSize_product
    T hq F hFmeas hFbound
  exact hcell.trans
    (mul_le_mul_of_nonneg_left hsize
      (scratch_boxScaleComparisonConstant_nonneg α))

/-- Every point of the closure of a nonempty finite box-scale region has
strictly positive scale. -/
theorem scratch_pos_of_mem_closure_collectionRegion
    (α : Anisotropy) (S : BoxCollection α) {p : E3} {t : ℝ}
    (hpt : (p, t) ∈ closure (collectionRegion α S)) :
    0 < t := by
  rcases scratch_mem_closure_collectionRegion_exists_bounds α S hpt with
    ⟨q, hq, hp, hlower, hupper⟩
  exact lt_of_lt_of_le (div_pos (boxLength_pos q) (by norm_num)) hlower

/-- The fixed-parameter local cube spatial integral is controlled uniformly
on the closure of a tree region by the product of tree-local fourth sizes. -/
theorem scratch_abs_integral_localCubeKernel_le_treeLocalSize_product_of_mem_closure
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α) (i : Fin 3)
      (lam r t : ℝ) (p : E3) (F : CubeVertex → E3 → ℝ),
      (∀ j, Continuous (F j)) →
      (∀ j, Measurable (F j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B) →
      1 ≤ lam →
      (p, t) ∈ closure (collectionRegion α T.boxes) →
      |∫ x : E6, cubeSignedInputProduct F x *
        localCubeKernel α i lam r t p x| ≤
        C * lam ^ 36 * translationWeight r ^ 20 *
          ∏ j : CubeVertex, treeLocalSize T 4 (F j) := by
  rcases scratch_abs_integral_localCubeKernel_le_bracketAverage α with
    ⟨C, hC, hlocal⟩
  let S : ℝ := scratch_boxScaleComparisonConstant α
  refine ⟨C ^ 6 * S,
    mul_nonneg (pow_nonneg hC _) (scratch_boxScaleComparisonConstant_nonneg α), ?_⟩
  intro T i lam r t p F hFcont hFmeas hFbound hlam hpt
  have ht : 0 < t := scratch_pos_of_mem_closure_collectionRegion α T.boxes hpt
  have hlocal' := hlocal i lam r t p F hFcont hFbound hlam ht
  have hsize := scratch_cubeBracketAverage_le_treeLocalSize_product_of_mem_closure
    T F hFcont hFmeas hFbound hpt
  have hfac : 0 ≤ C ^ 6 * lam ^ 36 * translationWeight r ^ 20 := by
    have hlam0 : 0 ≤ lam := by linarith
    have hR : 0 ≤ translationWeight r := by
      unfold translationWeight
      positivity
    change 0 ≤ (C ^ (6 : ℕ) * lam ^ (36 : ℕ)) * translationWeight r ^ (20 : ℕ)
    exact mul_nonneg
      (mul_nonneg (pow_nonneg hC _) (pow_nonneg hlam0 _))
      (pow_nonneg hR _)
  calc
    |∫ x : E6, cubeSignedInputProduct F x *
        localCubeKernel α i lam r t p x| ≤
        C ^ 6 * lam ^ 36 * translationWeight r ^ 20 *
          cubeBracketAverage α t p F := hlocal'
    _ ≤ C ^ 6 * lam ^ 36 * translationWeight r ^ 20 *
        (S * ∏ j : CubeVertex, treeLocalSize T 4 (F j)) :=
      mul_le_mul_of_nonneg_left hsize hfac
    _ = (C ^ 6 * S) * lam ^ 36 * translationWeight r ^ 20 *
        ∏ j : CubeVertex, treeLocalSize T 4 (F j) := by ring

/-- The endpoint spatial integral is controlled uniformly on the closure of
a tree region by the product of tree-local fourth sizes. -/
theorem scratch_abs_integral_cubeEndpointKernel_le_treeLocalSize_product_of_mem_closure
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α)
      (lam r t : ℝ) (p : E3) (F : CubeVertex → E3 → ℝ),
      (∀ j, Continuous (F j)) →
      (∀ j, Measurable (F j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B) →
      1 ≤ lam →
      (p, t) ∈ closure (collectionRegion α T.boxes) →
      |∫ x : E6, cubeSignedInputProduct F x *
        cubeEndpointKernel α lam r t p x| ≤
        C * lam ^ 36 * translationWeight r ^ 20 *
          ∏ j : CubeVertex, treeLocalSize T 4 (F j) := by
  rcases scratch_abs_integral_cubeEndpointKernel_le_bracketAverage α with
    ⟨C, hC, hendpoint⟩
  let S : ℝ := scratch_boxScaleComparisonConstant α
  refine ⟨C ^ 6 * S,
    mul_nonneg (pow_nonneg hC _) (scratch_boxScaleComparisonConstant_nonneg α), ?_⟩
  intro T lam r t p F hFcont hFmeas hFbound hlam hpt
  have ht : 0 < t := scratch_pos_of_mem_closure_collectionRegion α T.boxes hpt
  have hendpoint' := hendpoint lam r t p F hFcont hFbound hlam ht
  have hsize := scratch_cubeBracketAverage_le_treeLocalSize_product_of_mem_closure
    T F hFcont hFmeas hFbound hpt
  have hfac : 0 ≤ C ^ 6 * lam ^ 36 * translationWeight r ^ 20 := by
    have hlam0 : 0 ≤ lam := by linarith
    have hR : 0 ≤ translationWeight r := by
      unfold translationWeight
      positivity
    change 0 ≤ (C ^ (6 : ℕ) * lam ^ (36 : ℕ)) * translationWeight r ^ (20 : ℕ)
    exact mul_nonneg
      (mul_nonneg (pow_nonneg hC _) (pow_nonneg hlam0 _))
      (pow_nonneg hR _)
  calc
    |∫ x : E6, cubeSignedInputProduct F x *
        cubeEndpointKernel α lam r t p x| ≤
        C ^ 6 * lam ^ 36 * translationWeight r ^ 20 *
          cubeBracketAverage α t p F := hendpoint'
    _ ≤ C ^ 6 * lam ^ 36 * translationWeight r ^ 20 *
        (S * ∏ j : CubeVertex, treeLocalSize T 4 (F j)) :=
      mul_le_mul_of_nonneg_left hsize hfac
    _ = (C ^ 6 * S) * lam ^ 36 * translationWeight r ^ 20 *
        ∏ j : CubeVertex, treeLocalSize T 4 (F j) := by ring

/-- The face spatial integral is controlled uniformly on the closure of a
tree region by the product of tree-local fourth sizes. -/
theorem scratch_abs_integral_cubeFaceKernel_le_treeLocalSize_product_of_mem_closure
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α) (i : Fin 3)
      (lam r t : ℝ) (p : E3) (F : CubeVertex → E3 → ℝ),
      (∀ j, Continuous (F j)) →
      (∀ j, Measurable (F j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B) →
