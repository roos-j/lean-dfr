    change 0 ≤ (C * lam ^ (37 : ℕ)) * translationWeight r ^ (21 : ℕ)
    exact mul_nonneg
      (mul_nonneg hC (pow_nonneg hlam0 _))
      (pow_nonneg hR _)
  calc
    |∫ x : E6, cubeSignedInputProduct (scratch_edgeCubeTuple f) x *
        cubeFaceKernel α i lam r t p x| ≤
        C * lam ^ 37 * translationWeight r ^ 21 *
          cubeBracketAverage α t p (scratch_edgeCubeTuple f) := hface'
