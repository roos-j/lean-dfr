import Auto.Twisted.Twisted

/-! ### Measurable choice from a countable family

The fibre Calderón--Zygmund construction has only countably many possible
finite dyadic families.  This elementary selector is the mechanism for
turning pointwise existence of a suitable finite family into a measurable
family, once the suitability predicate has been proved measurable.
-/

namespace Auto.Twisted

open MeasureTheory
open scoped ENNReal

noncomputable section

/-- A nonempty countable collection of measurable candidate predicates admits
a measurable first-success selector. -/
theorem scratch_exists_measurable_countable_selector
    {X A : Type*} [MeasurableSpace X] [MeasurableSpace A]
    [Countable A] [Nonempty A] (P : X → A → Prop)
    (hP : ∀ a : A, MeasurableSet {x : X | P x a})
    (hexists : ∀ x : X, ∃ a : A, P x a) :
    ∃ choose : X → A, Measurable choose ∧ ∀ x : X, P x (choose x) := by
  classical
  obtain ⟨enumerate, henumerate⟩ := exists_surjective_nat A
  let p : X → ℕ → Prop := fun x n => P x (enumerate n)
  have hp_exists (x : X) : ∃ n : ℕ, p x n := by
    obtain ⟨a, ha⟩ := hexists x
    obtain ⟨n, hn⟩ := henumerate a
    exact ⟨n, by simpa only [p, hn] using ha⟩
  let first : X → ℕ := fun x => Nat.find (hp_exists x)
  have hfirst : Measurable first := by
    dsimp only [first]
    apply measurable_find hp_exists
    intro n
    simpa only [p] using hP (enumerate n)
  refine ⟨fun x => enumerate (first x), ?_, ?_⟩
  · exact measurable_from_nat.comp hfirst
  · intro x
    exact Nat.find_spec (hp_exists x)

/-- The same selector specialized to finite subsets of a countable index
type.  This is the exact carrier used by finite one-dimensional dyadic
Calderón--Zygmund families. -/
theorem scratch_exists_measurable_finite_selector
    {X ι : Type*} [MeasurableSpace X] [Countable ι]
    (P : X → Finset ι → Prop)
    (hP : ∀ U : Finset ι, MeasurableSet {x : X | P x U})
    (hexists : ∀ x : X, ∃ U : Finset ι, P x U) :
    ∃ choose : X → Finset ι, Measurable choose ∧
      ∀ x : X, P x (choose x) := by
  exact scratch_exists_measurable_countable_selector P hP hexists

/-- A fixed measurable fibre set has a measurable parameterized lower
integral.  This is the basic measurable datum needed for the finite dyadic
family suitability predicate. -/
theorem scratch_measurable_section_lintegral_indicator
    {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    (ν : Measure Y) [SFinite ν] (F : X × Y → ℝ≥0∞)
    (hF : Measurable F) (s : Set Y) (hs : MeasurableSet s) :
    Measurable (fun x : X => ∫⁻ y in s, F (x, y) ∂ν) := by
  classical
  let H : X → Y → ℝ≥0∞ := fun x y => s.indicator (fun y => F (x, y)) y
  have hH : Measurable (Function.uncurry H) := by
    have hH' := hF.indicator (MeasurableSet.preimage hs measurable_snd)
    rw [show Function.uncurry H = (Prod.snd ⁻¹' s).indicator F by
      ext q
      rcases q with ⟨x, y⟩
      change (if y ∈ s then F (x, y) else 0) =
        (if y ∈ s then F (x, y) else 0)
      rfl]
    exact hH'
  simpa only [H, MeasureTheory.lintegral_indicator hs] using
    hH.lintegral_prod_right

/-- The preceding fact applied to the norm of a complex-valued fiber. -/
theorem scratch_measurable_section_lintegral_norm_indicator
    {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    (ν : Measure Y) [SFinite ν] (F : X × Y → ℂ)
    (hF : Measurable F) (s : Set Y) (hs : MeasurableSet s) :
    Measurable (fun x : X => ∫⁻ y in s, ENNReal.ofReal ‖F (x, y)‖ ∂ν) := by
  apply scratch_measurable_section_lintegral_indicator ν
    (fun q => ENNReal.ofReal ‖F q‖)
  · exact hF.norm.ennreal_ofReal
  · exact hs

end

