      scratch_dyadicBracketShellConstant * coordinateDyadicBallMaximal i g p := by
  have hfbound : ∀ x, ‖f x‖ ≤ B := fun x ↦ (hfg x).trans (hgbound x)
  calc
    scratch_coordinateBracketConvolution i f r p ≤
        scratch_dyadicBracketShellConstant * coordinateDyadicBallMaximal i f p :=
      scratch_coordinateBracketConvolution_le_shell_dyadic
        i f hf B hB hfbound r p hr
    _ ≤ scratch_dyadicBracketShellConstant * coordinateDyadicBallMaximal i g p :=
      mul_le_mul_of_nonneg_left
        (coordinateDyadicBallMaximal_mono_of_norm_le
          i f g B hB hgbound hfg p)
        scratch_dyadicBracketShellConstant_nonneg

/- Three literal positive coordinate bracket convolutions are dominated by
the shell-scaled three-coordinate dyadic maximal operator.  The proof keeps
the shell constant after every stage, matching the operator's definition.
theorem scratch_integral_norm_mul_anisotropicBracketKernel_le_scaledDyadic
    (α : Anisotropy) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ y, ‖f y‖ ≤ A)
    {t : ℝ} (ht : 0 < t) (p : E3) :
    (∫ y : E3, ‖f y‖ * anisotropicBracketKernel α t p y) ≤
      ‖scaledIteratedCoordinateDyadicBallMaximal
        scratch_dyadicBracketShellConstant f p‖ := by
  let K : ℝ := scratch_dyadicBracketShellConstant
  let r₀ : ℝ := t ^ α.weight 0
  let r₁ : ℝ := t ^ α.weight 1
  let r₂ : ℝ := t ^ α.weight 2
  let h₀ : E3 → ℂ := fun q ↦
    (scratch_coordinateBracketConvolution 0 f r₀ q : ℂ)
  let f₀ : E3 → ℂ := coordinateDyadicBallMaximalComplex 0 f
  let g₀ : E3 → ℂ := (K : ℂ) • f₀
  let h₁ : E3 → ℂ := fun q ↦
    (scratch_coordinateBracketConvolution 1 h₀ r₁ q : ℂ)
  let f₁ : E3 → ℂ := coordinateDyadicBallMaximalComplex 1 g₀
  let g₁ : E3 → ℂ := (K : ℂ) • f₁
  have hK : 0 ≤ K := by
    dsimp only [K]
    exact scratch_dyadicBracketShellConstant_nonneg
  have hr₀ : 0 < r₀ := by
    dsimp only [r₀]
    exact pow_pos ht _
  have hr₁ : 0 < r₁ := by
    dsimp only [r₁]
    exact pow_pos ht _
  have hr₂ : 0 < r₂ := by
    dsimp only [r₂]
    exact pow_pos ht _
  have hh₀meas : Measurable h₀ := by
    dsimp only [h₀]
    exact Complex.continuous_ofReal.measurable.comp
      (scratch_coordinateBracketConvolution_measurable 0 f hf r₀)
  have hf₀meas : Measurable f₀ := by
    dsimp only [f₀]
    exact coordinateDyadicBallMaximalComplex_measurable 0 f hf
  have hg₀meas : Measurable g₀ := by
    dsimp only [g₀]
    exact hf₀meas.const_smul (K : ℂ)
  have hg₀bound : ∀ q, ‖g₀ q‖ ≤ K * A := by
    intro q
    rw [show ‖g₀ q‖ = K * coordinateDyadicBallMaximal 0 f q by
      dsimp only [g₀, f₀]
      exact scratch_norm_shell_smul_coordinateDyadicBallMaximalComplex K hK 0 f q]
    exact mul_le_mul_of_nonneg_left
      (coordinateDyadicBallMaximal_top_bound 0 f A hA hbound q) hK
  have hh₀bound : ∀ q, ‖h₀ q‖ ≤ K * A := by
    intro q
    rw [show ‖h₀ q‖ = scratch_coordinateBracketConvolution 0 f r₀ q by
      dsimp only [h₀]
      exact scratch_norm_complex_coordinateBracketConvolution 0 f r₀ q hr₀.le]
    exact scratch_coordinateBracketConvolution_bound 0 f hf A hA hbound r₀ q hr₀
  have hh₀le : ∀ q, ‖h₀ q‖ ≤ ‖g₀ q‖ := by
    intro q
    rw [show ‖h₀ q‖ = scratch_coordinateBracketConvolution 0 f r₀ q by
      dsimp only [h₀]
      exact scratch_norm_complex_coordinateBracketConvolution 0 f r₀ q hr₀.le,
      show ‖g₀ q‖ = K * coordinateDyadicBallMaximal 0 f q by
        dsimp only [g₀, f₀]
        exact scratch_norm_shell_smul_coordinateDyadicBallMaximalComplex K hK 0 f q]
    dsimp only [K]
    exact scratch_coordinateBracketConvolution_le_shell_dyadic
      0 f hf A hA hbound r₀ q hr₀
  have hh₁meas : Measurable h₁ := by
    dsimp only [h₁]
    exact Complex.continuous_ofReal.measurable.comp
      (scratch_coordinateBracketConvolution_measurable 1 h₀ hh₀meas r₁)
  have hf₁meas : Measurable f₁ := by
    dsimp only [f₁]
    exact coordinateDyadicBallMaximalComplex_measurable 1 g₀ hg₀meas
  have hg₁meas : Measurable g₁ := by
    dsimp only [g₁]
    exact hf₁meas.const_smul (K : ℂ)
  have hKA : 0 ≤ K * A := mul_nonneg hK hA
  have hg₁bound : ∀ q, ‖g₁ q‖ ≤ K * (K * A) := by
    intro q
    rw [show ‖g₁ q‖ = K * coordinateDyadicBallMaximal 1 g₀ q by
      dsimp only [g₁, f₁]
      exact scratch_norm_shell_smul_coordinateDyadicBallMaximalComplex K hK 1 g₀ q]
    exact mul_le_mul_of_nonneg_left
      (coordinateDyadicBallMaximal_top_bound 1 g₀ (K * A) hKA hg₀bound q) hK
  have hh₁bound : ∀ q, ‖h₁ q‖ ≤ K * (K * A) := by
    intro q
    rw [show ‖h₁ q‖ = scratch_coordinateBracketConvolution 1 h₀ r₁ q by
      dsimp only [h₁]
      exact scratch_norm_complex_coordinateBracketConvolution 1 h₀ r₁ q hr₁.le]
    exact scratch_coordinateBracketConvolution_bound
      1 h₀ hh₀meas (K * A) hKA hg₀bound r₁ q hr₁
  have hh₁le : ∀ q, ‖h₁ q‖ ≤ ‖g₁ q‖ := by
    intro q
    rw [show ‖h₁ q‖ = scratch_coordinateBracketConvolution 1 h₀ r₁ q by
      dsimp only [h₁]
      exact scratch_norm_complex_coordinateBracketConvolution 1 h₀ r₁ q hr₁.le,
      show ‖g₁ q‖ = K * coordinateDyadicBallMaximal 1 g₀ q by
        dsimp only [g₁, f₁]
        exact scratch_norm_shell_smul_coordinateDyadicBallMaximalComplex K hK 1 g₀ q]
    exact scratch_coordinateBracketConvolution_le_shell_dyadic_of_norm_le
      1 h₀ g₀ hh₀meas (K * A) hKA hg₀bound hh₀le r₁ q hr₁
  have hfinal :
      scratch_coordinateBracketConvolution 2 h₁ r₂ p ≤
        K * coordinateDyadicBallMaximal 2 g₁ p :=
    scratch_coordinateBracketConvolution_le_shell_dyadic_of_norm_le
      2 h₁ g₁ hh₁meas (K * (K * A))
        (mul_nonneg hK hKA) hg₁bound hh₁le r₂ p hr₂
  calc
    (∫ y : E3, ‖f y‖ * anisotropicBracketKernel α t p y) =
        scratch_coordinateBracketConvolution 2 h₁ r₂ p := by
      rw [scratch_integral_norm_mul_anisotropicBracketKernel_eq_iterated
        α f hf A hA hbound ht p]
    _ ≤ K * coordinateDyadicBallMaximal 2 g₁ p := hfinal
    _ = ‖scaledIteratedCoordinateDyadicBallMaximal K f p‖ := by
      change K * coordinateDyadicBallMaximal 2 g₁ p =
        ‖(K : ℂ) • coordinateDyadicBallMaximalComplex 2 g₁ p‖
      rw [scratch_norm_shell_smul_coordinateDyadicBallMaximalComplex K hK]

-/

/-- The anisotropic bracket average is the literal composition of its three
one-coordinate positive bracket convolutions, in the canonical `0,1,2`
order. -/
theorem scratch_integral_norm_mul_anisotropicBracketKernel_eq_iterated
    (α : Anisotropy) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ y, ‖f y‖ ≤ A)
    {t : ℝ} (ht : 0 < t) (p : E3) :
    (∫ y : E3, ‖f y‖ * anisotropicBracketKernel α t p y) =
      scratch_coordinateBracketConvolution 2
        (fun q ↦ (scratch_coordinateBracketConvolution 1
          (fun q ↦ (scratch_coordinateBracketConvolution 0 f
            (t ^ α.weight 0) q : ℂ))
          (t ^ α.weight 1) q : ℂ))
        (t ^ α.weight 2) p := by
  rw [scratch_integral_norm_mul_anisotropicBracketKernel_eq_reverse_nested
    α f hf A hA hbound ht p]
  conv_rhs => rw [← modelPoint_components p]
  change
    (∫ y₂ : ℝ, ∫ y₁ : ℝ, ∫ y₀ : ℝ,
      ‖f (modelPoint y₀ y₁ y₂)‖ *
        bracketKernelAt (t ^ α.weight 0) (p 0) y₀ *
        bracketKernelAt (t ^ α.weight 1) (p 1) y₁ *
        bracketKernelAt (t ^ α.weight 2) (p 2) y₂) =
      ∫ y₂ : ℝ,
        ‖(scratch_coordinateBracketConvolution 1
          (fun q ↦ (scratch_coordinateBracketConvolution 0 f
            (t ^ α.weight 0) q : ℂ))
          (t ^ α.weight 1)
          (faceInsert 2 y₂
            (coordinateSplit 2 (modelPoint (p 0) (p 1) (p 2))).2) : ℂ)‖ *
          bracketKernelAt (t ^ α.weight 2)
            ((modelPoint (p 0) (p 1) (p 2)) 2) y₂
  apply integral_congr_ae
  filter_upwards [] with y₂
  rw [scratch_faceInsert_two_coordinateSplit_modelPoint, modelPoint_two,
    scratch_norm_complex_coordinateBracketConvolution 1
      (fun q ↦ (scratch_coordinateBracketConvolution 0 f
        (t ^ α.weight 0) q : ℂ))
      (t ^ α.weight 1) (modelPoint (p 0) (p 1) y₂) (pow_pos ht _).le]
  calc
    (∫ y₁ : ℝ, ∫ y₀ : ℝ,
      ‖f (modelPoint y₀ y₁ y₂)‖ *
        bracketKernelAt (t ^ α.weight 0) (p 0) y₀ *
        bracketKernelAt (t ^ α.weight 1) (p 1) y₁ *
        bracketKernelAt (t ^ α.weight 2) (p 2) y₂) =
        ∫ y₁ : ℝ,
          (∫ y₀ : ℝ,
            ‖f (modelPoint y₀ y₁ y₂)‖ *
              bracketKernelAt (t ^ α.weight 0) (p 0) y₀ *
              bracketKernelAt (t ^ α.weight 1) (p 1) y₁) *
            bracketKernelAt (t ^ α.weight 2) (p 2) y₂ := by
          apply integral_congr_ae
          filter_upwards [] with y₁
          rw [← integral_mul_const]
    _ = (∫ y₁ : ℝ, ∫ y₀ : ℝ,
          ‖f (modelPoint y₀ y₁ y₂)‖ *
            bracketKernelAt (t ^ α.weight 0) (p 0) y₀ *
            bracketKernelAt (t ^ α.weight 1) (p 1) y₁) *
          bracketKernelAt (t ^ α.weight 2) (p 2) y₂ := by
      rw [integral_mul_const]
    _ = scratch_coordinateBracketConvolution 1
          (fun q ↦ (scratch_coordinateBracketConvolution 0 f
            (t ^ α.weight 0) q : ℂ))
          (t ^ α.weight 1) (modelPoint (p 0) (p 1) y₂) *
          bracketKernelAt (t ^ α.weight 2) (p 2) y₂ := by
      congr 1
      change (∫ y₁ : ℝ, ∫ y₀ : ℝ,
        ‖f (modelPoint y₀ y₁ y₂)‖ *
          bracketKernelAt (t ^ α.weight 0) (p 0) y₀ *
          bracketKernelAt (t ^ α.weight 1) (p 1) y₁) =
        ∫ y₁ : ℝ,
          ‖(scratch_coordinateBracketConvolution 0 f
            (t ^ α.weight 0)
            (faceInsert 1 y₁
              (coordinateSplit 1 (modelPoint (p 0) (p 1) y₂)).2) : ℂ)‖ *
            bracketKernelAt (t ^ α.weight 1)
              ((modelPoint (p 0) (p 1) y₂) 1) y₁
      apply integral_congr_ae
      filter_upwards [] with y₁
      rw [scratch_faceInsert_one_coordinateSplit_modelPoint, modelPoint_one,
        scratch_norm_complex_coordinateBracketConvolution 0 f
          (t ^ α.weight 0) (modelPoint (p 0) y₁ y₂) (pow_pos ht _).le]
      change (∫ y₀ : ℝ,
        ‖f (modelPoint y₀ y₁ y₂)‖ *
          bracketKernelAt (t ^ α.weight 0) (p 0) y₀ *
          bracketKernelAt (t ^ α.weight 1) (p 1) y₁) =
        (∫ y₀ : ℝ,
          ‖f (faceInsert 0 y₀
            (coordinateSplit 0 (modelPoint (p 0) y₁ y₂)).2)‖ *
            bracketKernelAt (t ^ α.weight 0)
              ((modelPoint (p 0) y₁ y₂) 0) y₀) *
          bracketKernelAt (t ^ α.weight 1) (p 1) y₁
      rw [← integral_mul_const]
      apply integral_congr_ae
      filter_upwards [] with y₀
      rw [scratch_faceInsert_zero_coordinateSplit_modelPoint, modelPoint_zero]

/-- Three literal positive coordinate bracket convolutions are dominated by
the shell-scaled three-coordinate dyadic maximal operator.  The proof keeps
