  exact contDiff_const.sub conePrimitive_contDiff

theorem conePrimitive_even (x : ℝ) : conePrimitive (-x) = conePrimitive x := by
  have hcomp : (∫ t in (0 : ℝ)..x, coneWeight (-t)) = ∫ t in -x..0, coneWeight t := by
    simp [intervalIntegral.integral_comp_neg]
  have hrel : (∫ t in -x..0, coneWeight t) = -(∫ t in (0 : ℝ)..x, coneWeight t) := by
    rw [← hcomp]
    rw [show (fun t : ℝ ↦ coneWeight (-t)) = fun t ↦ -coneWeight t by
      funext t
      exact coneWeight_neg t]
    rw [intervalIntegral.integral_neg]
  unfold conePrimitive
  rw [intervalIntegral.integral_symm (-x) 0, hrel]
  ring

theorem conePhi_even (x : ℝ) : conePhi (-x) = conePhi x := by
  unfold conePhi
  rw [conePrimitive_even x]

theorem conePrimitive_eq_zero_of_abs_le_one {x : ℝ} (hx : |x| ≤ 1) :
    conePrimitive x = 0 := by
  unfold conePrimitive
  rcases le_total 0 x with hx0 | hx0
  · rw [intervalIntegral.integral_of_le hx0]
    apply integral_eq_zero_of_ae
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with y hy
    apply coneWeight_eq_zero_of_abs_le_one
    rw [abs_of_nonneg (by linarith [hy.1])]
    exact le_trans hy.2 (by nlinarith [le_abs_self x])
  · rw [intervalIntegral.integral_symm x 0]
    have hz : (∫ t in x..0, coneWeight t) = 0 := by
      rw [intervalIntegral.integral_of_le hx0]
      apply integral_eq_zero_of_ae
      filter_upwards [ae_restrict_mem measurableSet_Ioc] with y hy
      apply coneWeight_eq_zero_of_abs_le_one
      rw [abs_of_nonpos (by linarith [hy.2])]
      have hxlo : -1 ≤ x := by nlinarith [neg_le_abs x]
      nlinarith [hy.1]
    rw [hz]
    simp

theorem conePhi_eq_cPsi_of_abs_le_one {x : ℝ} (hx : |x| ≤ 1) :
    conePhi x = cPsi := by
  unfold conePhi
  rw [conePrimitive_eq_zero_of_abs_le_one hx]
  ring

theorem conePrimitive_eq_cPsi_of_two_le {x : ℝ} (hx : 2 ≤ x) :
    conePrimitive x = cPsi := by
  have htail : (∫ t in (2 : ℝ)..x, coneWeight t) = 0 := by
    rw [intervalIntegral.integral_of_le hx]
    apply integral_eq_zero_of_ae
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with y hy
    apply coneWeight_eq_zero_of_two_le_abs
    rw [abs_of_nonneg (by linarith [hy.1])]
    linarith [hy.1]
  unfold conePrimitive cPsi
  rw [← intervalIntegral.integral_add_adjacent_intervals
    (coneWeight_contDiff.continuous.intervalIntegrable (0 : ℝ) 2)
    (coneWeight_contDiff.continuous.intervalIntegrable 2 x), htail, add_zero]

theorem conePhi_eq_zero_of_two_le_abs {x : ℝ} (hx : 2 ≤ |x|) : conePhi x = 0 := by
  have heq : conePrimitive x = cPsi := by
    rcases le_total 0 x with hx0 | hx0
    · rw [abs_of_nonneg hx0] at hx
      exact conePrimitive_eq_cPsi_of_two_le hx
    · have hneg : 2 ≤ -x := by rwa [abs_of_nonpos hx0] at hx
      rw [← conePrimitive_even x]
      exact conePrimitive_eq_cPsi_of_two_le hneg
  unfold conePhi
  rw [heq]
  ring

theorem conePhi_hasCompactSupport : HasCompactSupport conePhi := by
  apply HasCompactSupport.intro (isCompact_closedBall (0 : ℝ) 2)
  intro x hx
  have hx' : 2 < |x| := by
    simpa only [Metric.mem_closedBall, Real.dist_eq, sub_zero, not_le] using hx
  exact conePhi_eq_zero_of_two_le_abs hx'.le

/-- Complex Schwartz realization of the real low-frequency cutoff `\(\Phi\)`. -/
noncomputable def conePhiSchwartz : SchwartzMap ℝ ℂ := by
  let g : ℝ → ℂ := Complex.ofRealCLM ∘ conePhi
  have hcompact : HasCompactSupport g :=
    conePhi_hasCompactSupport.comp_left (g := Complex.ofRealCLM) rfl
  have hsmooth : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) g :=
    Complex.ofRealCLM.contDiff.comp conePhi_contDiff
  exact hcompact.toSchwartzMap hsmooth

@[simp]
theorem conePhiSchwartz_apply (x : ℝ) : conePhiSchwartz x = conePhi x := by
  rfl

noncomputable def conePhiPhysical : SchwartzMap ℝ ℂ := 𝓕⁻ conePhiSchwartz

@[simp]
theorem schwartzFourier_conePhiPhysical :
    𝓕 conePhiPhysical = conePhiSchwartz := by
  simp [conePhiPhysical]

/-- Inverse Fourier transformation sends a real-valued frequency function to
a conjugate-symmetric spatial function. -/
lemma fourierInv_conj_eq_of_real (f : ℝ → ℂ)
    (hreal : ∀ t : ℝ, (starRingEnd ℂ) (f t) = f t) (x : ℝ) :
    (starRingEnd ℂ) (𝓕⁻ f x) = 𝓕⁻ f (-x) := by
  rw [Real.fourierInv_eq, Real.fourierInv_eq, ← integral_conj]
  apply integral_congr_ae
  filter_upwards with t
  simp only [Real.inner_apply, mul_neg]
  change (starRingEnd ℂ) ((↑(𝐞 (t * x)) : ℂ) * f t) =
    (↑(𝐞 (-(t * x))) : ℂ) * f t
  rw [map_mul, hreal]
  rw [← Circle.coe_inv_eq_conj, ← Real.fourierChar.map_neg_eq_inv]

/-- The spatial low-frequency kernel has real values. -/
theorem conePhiPhysical_im_eq_zero (x : ℝ) : (conePhiPhysical x).im = 0 := by
  apply Complex.conj_eq_iff_im.mp
  unfold conePhiPhysical
  rw [SchwartzMap.fourierInv_coe]
  calc
    (starRingEnd ℂ) (𝓕⁻ (conePhiSchwartz : ℝ → ℂ) x) =
        𝓕⁻ (conePhiSchwartz : ℝ → ℂ) (-x) :=
      fourierInv_conj_eq_of_real _ (by
        intro t
        rw [conePhiSchwartz_apply]
        simp) x
    _ = 𝓕⁻ (conePhiSchwartz : ℝ → ℂ) x := by
      have h := Real.fourierInv_comp_linearIsometry
        (LinearIsometryEquiv.neg ℝ (E := ℝ)) (conePhiSchwartz : ℝ → ℂ) x
      change (𝓕⁻ ((conePhiSchwartz : ℝ → ℂ) ∘
        (LinearIsometryEquiv.neg ℝ (E := ℝ))) : ℝ → ℂ) x = _ at h
      rw [show ((conePhiSchwartz : ℝ → ℂ) ∘
        (LinearIsometryEquiv.neg ℝ (E := ℝ))) = conePhiSchwartz by
        funext t
        change conePhiSchwartz (-t) = conePhiSchwartz t
        simpa only [conePhiSchwartz_apply] using
          congrArg Complex.ofReal (conePhi_even t)] at h
      simpa using h.symm

/-- The real Schwartz realization of the low-frequency spatial kernel. -/
noncomputable def conePhiPhysicalReal : SchwartzMap ℝ ℝ :=
  conePhiPhysical.postcompCLM (𝕜 := ℝ) Complex.reCLM

@[simp]
theorem conePhiPhysicalReal_apply (x : ℝ) :
    conePhiPhysicalReal x = (conePhiPhysical x).re := by
  rfl

theorem conePhiPhysical_eq_ofReal (x : ℝ) :
    (conePhiPhysicalReal x : ℂ) = conePhiPhysical x := by
  apply Complex.ext
  · simp [conePhiPhysicalReal_apply]
  · simp [conePhiPhysical_im_eq_zero]

theorem conePhiPhysical_decay (r : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      ‖conePhiPhysical x‖ ≤ C / (1 + |x|) ^ r :=
  schwartz_oneDim_decay conePhiPhysical r

theorem conePhiPhysicalReal_decay (r : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      |conePhiPhysicalReal x| ≤ C / (1 + |x|) ^ r := by
  rcases conePhiPhysical_decay r with ⟨C, hC, h⟩
  refine ⟨C, hC, fun x ↦ ?_⟩
  rw [← Real.norm_eq_abs, ← Complex.norm_real, conePhiPhysical_eq_ofReal]
  exact h x

/-! ### Positive Gaussian superposition

The proof of the third estimate in `lem:domination` only uses a fixed
equivalent norm on the four scalar variables.  We use the coordinate `ℓ¹`
radius below, which makes the source's translation bookkeeping completely
explicit while retaining the same Gaussian superposition on the right.
-/

/-- The coordinate radius used to select the source scale interval. -/
def fourRadius (z : E4) : ℝ :=
  |z 0| + |z 1| + |z 2| + |z 3|

/-- The translated coordinate radius for the two low-frequency slots. -/
def fourRadiusShift (z : E4) (u : E3) : ℝ :=
  |z 0 - u 0| + |z 1| + |z 2 - u 1| + |z 3|

/-- The source translation weight `U(u)`. -/
def sourceWeight (u : E3) : ℝ := 1 + |u 0| + |u 1| + |u 2|

/-- The four input factors in the source superposition estimate. -/
noncomputable def superpositionInput (z : E4) (u : E3) : ℝ :=
  |conePhiPhysicalReal (z 0 - u 0)| * gaussian (z 1) *
    |conePhiPhysicalReal (z 2 - u 1)| * gaussian (z 3)

/-- The positive scale integrand from equation `eq:superposition`, after
collecting the four mass-normalization factors into `s^{-51}`. -/
noncomputable def superpositionIntegrand (z : E4) (s : ℝ) : ℝ :=
  gaussian (z 0 / s) * gaussian (z 1 / s) *
    gaussian (z 2 / s) * gaussian (z 3 / s) * s ^ (-51 : ℝ)

/-- The source's positive Gaussian superposition, written as a set integral. -/
noncomputable def gaussianSuperposition (z : E4) : ℝ :=
  ∫ s in Set.Ici (1 : ℝ), superpositionIntegrand z s

theorem superpositionIntegrand_nonneg {z : E4} {s : ℝ} (hs : 0 ≤ s) :
    0 ≤ superpositionIntegrand z s := by
  unfold superpositionIntegrand
  exact mul_nonneg
    (mul_nonneg
      (mul_nonneg
        (mul_nonneg (gaussian_nonneg _) (gaussian_nonneg _))
        (gaussian_nonneg _))
      (gaussian_nonneg _))
    (Real.rpow_nonneg hs _)

theorem superpositionIntegrand_continuousOn (z : E4) :
    ContinuousOn (superpositionIntegrand z) (Set.Ici (1 : ℝ)) := by
  intro s hs
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hsne : s ≠ 0 := hspos.ne'
  have hg (a : Fin 4) : ContinuousAt (fun t : ℝ ↦ gaussian (z a / t)) s := by
    have hdiv : ContinuousAt (fun t : ℝ ↦ z a / t) s :=
      continuousAt_const.div continuousAt_id hsne
    exact gaussian_contDiff.continuous.continuousAt.comp hdiv
  have hp : ContinuousAt (fun t : ℝ ↦ t ^ (-51 : ℝ)) s :=
    continuousAt_id.rpow_const (Or.inl hsne)
  change ContinuousWithinAt
    (fun t : ℝ ↦ gaussian (z 0 / t) * gaussian (z 1 / t) *
      gaussian (z 2 / t) * gaussian (z 3 / t) * t ^ (-51 : ℝ))
    (Set.Ici 1) s
  exact (((((hg 0).mul (hg 1)).mul (hg 2)).mul (hg 3)).mul hp).continuousWithinAt

theorem integrableOn_superpositionIntegrand (z : E4) :
    IntegrableOn (superpositionIntegrand z) (Set.Ici (1 : ℝ)) := by
  have hbase : IntegrableOn (fun s : ℝ ↦ s ^ (-51 : ℝ)) (Set.Ici (1 : ℝ)) := by
    apply (integrableOn_Ici_iff_integrableOn_Ioi).mpr
    exact integrableOn_Ioi_rpow_of_lt (by norm_num) zero_lt_one
  apply Integrable.mono' hbase
    ((superpositionIntegrand_continuousOn z).aestronglyMeasurable measurableSet_Ici)
  filter_upwards [ae_restrict_mem measurableSet_Ici] with s hs
  have hs0 : 0 ≤ s := le_trans zero_le_one hs
  rw [Real.norm_eq_abs, abs_of_nonneg (superpositionIntegrand_nonneg hs0)]
  unfold superpositionIntegrand
  have hpow : 0 ≤ s ^ (-51 : ℝ) := Real.rpow_nonneg hs0 _
  have hg0 : gaussian (z 0 / s) ≤ 1 := gaussian_le_one _
  have hg1 : gaussian (z 1 / s) ≤ 1 := gaussian_le_one _
  have hg2 : gaussian (z 2 / s) ≤ 1 := gaussian_le_one _
  have hg3 : gaussian (z 3 / s) ≤ 1 := gaussian_le_one _
  have h01 : gaussian (z 0 / s) * gaussian (z 1 / s) ≤ 1 := by
    calc
      gaussian (z 0 / s) * gaussian (z 1 / s) ≤ 1 * 1 :=
        mul_le_mul hg0 hg1 (gaussian_nonneg _) zero_le_one
      _ = 1 := by ring
  have h23 : gaussian (z 2 / s) * gaussian (z 3 / s) ≤ 1 := by
    calc
      gaussian (z 2 / s) * gaussian (z 3 / s) ≤ 1 * 1 :=
        mul_le_mul hg2 hg3 (gaussian_nonneg _) zero_le_one
      _ = 1 := by ring
  have hprod : gaussian (z 0 / s) * gaussian (z 1 / s) *
      gaussian (z 2 / s) * gaussian (z 3 / s) ≤ 1 := by
    calc
      gaussian (z 0 / s) * gaussian (z 1 / s) *
          gaussian (z 2 / s) * gaussian (z 3 / s) =
          (gaussian (z 0 / s) * gaussian (z 1 / s)) *
            (gaussian (z 2 / s) * gaussian (z 3 / s)) := by ring
      _ ≤ 1 * 1 :=
        mul_le_mul h01 h23
          (mul_nonneg (gaussian_nonneg _) (gaussian_nonneg _)) zero_le_one
      _ = 1 := by ring
  simpa using mul_le_mul_of_nonneg_right hprod hpow

theorem abs_coordinate_le_fourRadius (z : E4) (a : Fin 4) :
    |z a| ≤ fourRadius z := by
  fin_cases a
  · change |z 0| ≤ |z 0| + |z 1| + |z 2| + |z 3|
    nlinarith [abs_nonneg (z 1), abs_nonneg (z 2), abs_nonneg (z 3)]
  · change |z 1| ≤ |z 0| + |z 1| + |z 2| + |z 3|
    nlinarith [abs_nonneg (z 0), abs_nonneg (z 2), abs_nonneg (z 3)]
  · change |z 2| ≤ |z 0| + |z 1| + |z 2| + |z 3|
    nlinarith [abs_nonneg (z 0), abs_nonneg (z 1), abs_nonneg (z 3)]
  · change |z 3| ≤ |z 0| + |z 1| + |z 2| + |z 3|
    nlinarith [abs_nonneg (z 0), abs_nonneg (z 1), abs_nonneg (z 2)]

theorem exp_neg_pi_le_gaussian {x : ℝ} (hx : |x| ≤ 1) :
    Real.exp (-Real.pi) ≤ gaussian x := by
  rw [abs_le] at hx
  have hsq : x ^ 2 ≤ 1 := by
    have hprod : 0 ≤ (x + 1) * (1 - x) := by
      exact mul_nonneg (by linarith [hx.1]) (by linarith [hx.2])
    nlinarith
  unfold gaussian
  rw [Real.exp_le_exp]
  nlinarith [Real.pi_pos]

theorem superposition_coordinate_abs_div_le_one (z : E4) {s : ℝ}
    (hs : 1 + fourRadius z ≤ s) :
    ∀ a : Fin 4, |z a / s| ≤ 1 := by
  have hrad : 0 ≤ fourRadius z := by
    unfold fourRadius
    positivity
  have hspos : 0 < s := by linarith
  intro a
  rw [abs_div, abs_of_pos hspos]
  apply (div_le_one₀ hspos).mpr
  exact (abs_coordinate_le_fourRadius z a).trans (by linarith)

/-- A constant lower bound on a compact subinterval transfers to the positive
improper scale integral.  This isolates the interval restriction in the
source proof of `eq:superposition`. -/
theorem setIntegral_lower_of_pointwise
    (A c : ℝ) (hA : 0 ≤ A) (hc : 0 ≤ c) (f : ℝ → ℝ)
    (hfi : IntegrableOn f (Set.Ici (1 : ℝ)))
    (hnonneg : ∀ s ∈ Set.Ici (1 : ℝ), 0 ≤ f s)
    (hf : ∀ s ∈ Set.Icc A (2 * A), c * (2 * A) ^ (-51 : ℝ) ≤ f s)
    (hsub : Set.Icc A (2 * A) ⊆ Set.Ici (1 : ℝ)) :
    c * (2 * A) ^ (-51 : ℝ) * A ≤ ∫ s in Set.Ici (1 : ℝ), f s := by
  let q : ℝ := c * (2 * A) ^ (-51 : ℝ)
  have hq : 0 ≤ q := by
    unfold q
    exact mul_nonneg hc (Real.rpow_nonneg (by positivity) _)
  have hconst : IntegrableOn (fun _ : ℝ ↦ q) (Set.Icc A (2 * A)) := by
    exact integrableOn_const measure_Icc_lt_top.ne (by simp)
  have hmono : (∫ s in Set.Icc A (2 * A), q) ≤ ∫ s in Set.Icc A (2 * A), f s := by
    apply integral_mono_ae hconst (hfi.mono_set hsub)
    filter_upwards [ae_restrict_mem measurableSet_Icc] with s hs
    exact hf s hs
  have hset : (∫ s in Set.Icc A (2 * A), f s) ≤ ∫ s in Set.Ici (1 : ℝ), f s := by
    apply setIntegral_mono_set hfi
    · filter_upwards [ae_restrict_mem measurableSet_Ici] with s hs
      exact hnonneg s hs
    · exact Filter.Eventually.of_forall fun s hs => hsub hs
  calc
    c * (2 * A) ^ (-51 : ℝ) * A = ∫ s in Set.Icc A (2 * A), q := by
      rw [integral_const]
      simp [q]
      rw [max_eq_left (by nlinarith [hA])]
      ring
    _ ≤ ∫ s in Set.Icc A (2 * A), f s := hmono
    _ ≤ ∫ s in Set.Ici (1 : ℝ), f s := hset

theorem superpositionIntegrand_lower_on_scale_interval (z : E4) {s : ℝ}
    (hs : s ∈ Set.Icc (1 + fourRadius z) (2 * (1 + fourRadius z))) :
    Real.exp (-Real.pi) ^ 4 *
        (2 * (1 + fourRadius z)) ^ (-51 : ℝ) ≤
      superpositionIntegrand z s := by
  have hrad : 0 ≤ fourRadius z := by
    unfold fourRadius
    positivity
  have hApos : 0 < 1 + fourRadius z := by linarith
  have hspos : 0 < s := lt_of_lt_of_le hApos hs.1
  have hcoord := superposition_coordinate_abs_div_le_one z hs.1
  have hg0 : Real.exp (-Real.pi) ≤ gaussian (z 0 / s) :=
    exp_neg_pi_le_gaussian (hcoord 0)
  have hg1 : Real.exp (-Real.pi) ≤ gaussian (z 1 / s) :=
    exp_neg_pi_le_gaussian (hcoord 1)
  have hg2 : Real.exp (-Real.pi) ≤ gaussian (z 2 / s) :=
    exp_neg_pi_le_gaussian (hcoord 2)
  have hg3 : Real.exp (-Real.pi) ≤ gaussian (z 3 / s) :=
    exp_neg_pi_le_gaussian (hcoord 3)
  have he : 0 ≤ Real.exp (-Real.pi) := (Real.exp_pos _).le
  have h01 : Real.exp (-Real.pi) * Real.exp (-Real.pi) ≤
      gaussian (z 0 / s) * gaussian (z 1 / s) :=
    mul_le_mul hg0 hg1 he (gaussian_nonneg _)
  have h23 : Real.exp (-Real.pi) * Real.exp (-Real.pi) ≤
      gaussian (z 2 / s) * gaussian (z 3 / s) :=
    mul_le_mul hg2 hg3 he (gaussian_nonneg _)
  have hprod : Real.exp (-Real.pi) ^ 4 ≤
      gaussian (z 0 / s) * gaussian (z 1 / s) *
        gaussian (z 2 / s) * gaussian (z 3 / s) := by
    calc
      Real.exp (-Real.pi) ^ 4 =
          (Real.exp (-Real.pi) * Real.exp (-Real.pi)) *
            (Real.exp (-Real.pi) * Real.exp (-Real.pi)) := by ring
      _ ≤ (gaussian (z 0 / s) * gaussian (z 1 / s)) *
          (gaussian (z 2 / s) * gaussian (z 3 / s)) :=
        mul_le_mul h01 h23 (mul_nonneg he he)
          (mul_nonneg (gaussian_nonneg _) (gaussian_nonneg _))
      _ = gaussian (z 0 / s) * gaussian (z 1 / s) *
          gaussian (z 2 / s) * gaussian (z 3 / s) := by ring
  have hpow : (2 * (1 + fourRadius z)) ^ (-51 : ℝ) ≤ s ^ (-51 : ℝ) :=
    Real.rpow_le_rpow_of_nonpos hspos hs.2 (by norm_num)
  have hprodnonneg : 0 ≤ gaussian (z 0 / s) * gaussian (z 1 / s) *
      gaussian (z 2 / s) * gaussian (z 3 / s) := by
    exact mul_nonneg
      (mul_nonneg
        (mul_nonneg (gaussian_nonneg _) (gaussian_nonneg _))
        (gaussian_nonneg _))
      (gaussian_nonneg _)
  unfold superpositionIntegrand
  calc
    Real.exp (-Real.pi) ^ 4 * (2 * (1 + fourRadius z)) ^ (-51 : ℝ) ≤
        (gaussian (z 0 / s) * gaussian (z 1 / s) *
          gaussian (z 2 / s) * gaussian (z 3 / s)) *
            (2 * (1 + fourRadius z)) ^ (-51 : ℝ) :=
      mul_le_mul_of_nonneg_right hprod (Real.rpow_nonneg (by linarith [hApos]) _)
    _ ≤ (gaussian (z 0 / s) * gaussian (z 1 / s) *
          gaussian (z 2 / s) * gaussian (z 3 / s)) * s ^ (-51 : ℝ) :=
      mul_le_mul_of_nonneg_left hpow hprodnonneg

/-- The positive superposition has the explicit polynomial lower bound used
in the source proof. -/
theorem gaussianSuperposition_lower (z : E4) :
    Real.exp (-Real.pi) ^ 4 *
        (2 * (1 + fourRadius z)) ^ (-51 : ℝ) * (1 + fourRadius z) ≤
      gaussianSuperposition z := by
  have hrad : 0 ≤ fourRadius z := by
    unfold fourRadius
    positivity
  have hA : 0 ≤ 1 + fourRadius z := by linarith
  have hc : 0 ≤ Real.exp (-Real.pi) ^ 4 := pow_nonneg (Real.exp_pos _).le _
  unfold gaussianSuperposition
  exact setIntegral_lower_of_pointwise (1 + fourRadius z) (Real.exp (-Real.pi) ^ 4)
    hA hc (superpositionIntegrand z) (integrableOn_superpositionIntegrand z)
    (fun s hs ↦ superpositionIntegrand_nonneg (le_trans zero_le_one hs))
    (fun s hs ↦ superpositionIntegrand_lower_on_scale_interval z hs)
    (by
      intro s hs
      exact le_trans (by linarith) hs.1)

/-- A convenient order-fifty form of the positive superposition lower bound. -/
theorem gaussianSuperposition_lower_power (z : E4) :
    (2 : ℝ) ^ (-51 : ℝ) * Real.exp (-Real.pi) ^ 4 *
        (1 + fourRadius z) ^ (-50 : ℝ) ≤ gaussianSuperposition z := by
  let A : ℝ := 1 + fourRadius z
  have hApos : 0 < A := by
    dsimp [A]
    unfold fourRadius
    positivity
  have h := gaussianSuperposition_lower z
  have hfactor : (2 * A) ^ (-51 : ℝ) * A =
      (2 : ℝ) ^ (-51 : ℝ) * A ^ (-50 : ℝ) := by
    rw [Real.mul_rpow (by norm_num : (0 : ℝ) ≤ 2) hApos.le]
    calc
      (2 : ℝ) ^ (-51 : ℝ) * A ^ (-51 : ℝ) * A =
          (2 : ℝ) ^ (-51 : ℝ) * (A ^ (-51 : ℝ) * A ^ (1 : ℝ)) := by
        rw [Real.rpow_one]
        ring
      _ = (2 : ℝ) ^ (-51 : ℝ) * A ^ (-50 : ℝ) := by
        rw [← Real.rpow_add hApos]
        norm_num
  change (2 : ℝ) ^ (-51 : ℝ) * Real.exp (-Real.pi) ^ 4 * A ^ (-50 : ℝ) ≤ _
  calc
    (2 : ℝ) ^ (-51 : ℝ) * Real.exp (-Real.pi) ^ 4 * A ^ (-50 : ℝ) =
        Real.exp (-Real.pi) ^ 4 * ((2 * A) ^ (-51 : ℝ) * A) := by
      rw [hfactor]
      ring
    _ ≤ gaussianSuperposition z := by simpa [A, mul_assoc] using h

theorem fourRadius_nonneg (z : E4) : 0 ≤ fourRadius z := by
  unfold fourRadius
  positivity

theorem fourRadiusShift_nonneg (z : E4) (u : E3) : 0 ≤ fourRadiusShift z u := by
  unfold fourRadiusShift
  positivity

theorem sourceWeight_nonneg (u : E3) : 0 ≤ sourceWeight u := by
  unfold sourceWeight
  positivity

/-- The elementary translation comparison used in the source proof. -/
theorem one_add_fourRadius_le_sourceWeight_mul_shift (z : E4) (u : E3) :
    1 + fourRadius z ≤ sourceWeight u * (1 + fourRadiusShift z u) := by
  have hz0 : |z 0| ≤ |z 0 - u 0| + |u 0| := by
    calc
      |z 0| = |(z 0 - u 0) + u 0| := congrArg abs (by ring)
      _ ≤ |z 0 - u 0| + |u 0| := abs_add_le _ _
  have hz2 : |z 2| ≤ |z 2 - u 1| + |u 1| := by
    calc
      |z 2| = |(z 2 - u 1) + u 1| := congrArg abs (by ring)
      _ ≤ |z 2 - u 1| + |u 1| := abs_add_le _ _
  have hcross : 0 ≤ (|u 0| + |u 1| + |u 2|) *
      (|z 0 - u 0| + |z 1| + |z 2 - u 1| + |z 3|) := by
    positivity
  unfold fourRadius fourRadiusShift sourceWeight
  nlinarith [abs_nonneg (u 2)]

theorem one_add_four_nonneg_le_product (a b c d : ℝ)
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) (hd : 0 ≤ d) :
    1 + (a + b + c + d) ≤ (1 + a) * (1 + b) * (1 + c) * (1 + d) := by
  have hab : 1 + a + b ≤ (1 + a) * (1 + b) := by
    nlinarith [mul_nonneg ha hb]
  have hcd : 1 + c + d ≤ (1 + c) * (1 + d) := by
    nlinarith [mul_nonneg hc hd]
  have hgroup : 1 + (a + b) + (c + d) ≤
      (1 + (a + b)) * (1 + (c + d)) := by
    have habnonneg : 0 ≤ a + b := add_nonneg ha hb
    have hcdnonneg : 0 ≤ c + d := add_nonneg hc hd
    nlinarith [mul_nonneg habnonneg hcdnonneg]
  calc
    1 + (a + b + c + d) = 1 + (a + b) + (c + d) := by ring
    _ ≤ (1 + (a + b)) * (1 + (c + d)) := hgroup
    _ = (1 + a + b) * (1 + c + d) := by ring
    _ ≤ ((1 + a) * (1 + b)) * ((1 + c) * (1 + d)) :=
      mul_le_mul hab hcd (by positivity) (by positivity)
    _ = (1 + a) * (1 + b) * (1 + c) * (1 + d) := by ring

theorem one_add_fourRadiusShift_le_product (z : E4) (u : E3) :
    1 + fourRadiusShift z u ≤
      (1 + |z 0 - u 0|) * (1 + |z 1|) *
        (1 + |z 2 - u 1|) * (1 + |z 3|) := by
  unfold fourRadiusShift
  exact one_add_four_nonneg_le_product _ _ _ _ (abs_nonneg _) (abs_nonneg _)
    (abs_nonneg _) (abs_nonneg _)

/-- A fixed algebraic rearrangement kept polymorphic in the exponent so the
kernel never unfolds a large concrete natural power while normalizing it. -/
theorem four_factor_mul_pow_distribute
    (a b c d e f g h : ℝ) (n : ℕ) :
    (a * b * c * d) * (e * f * g * h) ^ n =
      (a * e ^ n) * (b * f ^ n) * (c * g ^ n) * (d * h ^ n) := by
  rw [mul_pow, mul_pow, mul_pow]
  ac_rfl

/-- The four fixed spatial factors have arbitrary polynomial decay in their
joint translated coordinate radius.  Keeping the order as a variable avoids
kernel reduction of a concrete large natural power in the bookkeeping proof. -/
theorem superpositionInput_shift_weighted_decay_at (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (z : E4) (u : E3),
      superpositionInput z u * (1 + fourRadiusShift z u) ^ n ≤ C := by
  rcases conePhiPhysicalReal_decay n with ⟨Cφ, hCφ, hφ⟩
  rcases gaussian_polynomial_decay n with ⟨Cg, hCg, hg⟩
  refine ⟨(Cφ * Cg) * (Cφ * Cg),
    mul_nonneg (mul_nonneg hCφ hCg) (mul_nonneg hCφ hCg), ?_⟩
  intro z u
  have hφ0 : |conePhiPhysicalReal (z 0 - u 0)| * (1 + |z 0 - u 0|) ^ n ≤ Cφ :=
    (le_div_iff₀ (pow_pos (by positivity) _)).mp (hφ (z 0 - u 0))
  have hφ2 : |conePhiPhysicalReal (z 2 - u 1)| * (1 + |z 2 - u 1|) ^ n ≤ Cφ :=
    (le_div_iff₀ (pow_pos (by positivity) _)).mp (hφ (z 2 - u 1))
  have hg1 : gaussian (z 1) * (1 + |z 1|) ^ n ≤ Cg := by
    simpa [mul_comm] using hg (z 1)
  have hg3 : gaussian (z 3) * (1 + |z 3|) ^ n ≤ Cg := by
    simpa [mul_comm] using hg (z 3)
  have hφ0nonneg : 0 ≤ |conePhiPhysicalReal (z 0 - u 0)| *
      (1 + |z 0 - u 0|) ^ n :=
    mul_nonneg (abs_nonneg _) (pow_nonneg (by positivity) _)
  have hφ2nonneg : 0 ≤ |conePhiPhysicalReal (z 2 - u 1)| *
      (1 + |z 2 - u 1|) ^ n :=
    mul_nonneg (abs_nonneg _) (pow_nonneg (by positivity) _)
  have hg1nonneg : 0 ≤ gaussian (z 1) * (1 + |z 1|) ^ n :=
    mul_nonneg (gaussian_nonneg _) (pow_nonneg (by positivity) _)
  have hg3nonneg : 0 ≤ gaussian (z 3) * (1 + |z 3|) ^ n :=
    mul_nonneg (gaussian_nonneg _) (pow_nonneg (by positivity) _)
  have h01 :
      (|conePhiPhysicalReal (z 0 - u 0)| * (1 + |z 0 - u 0|) ^ n) *
        (gaussian (z 1) * (1 + |z 1|) ^ n) ≤ Cφ * Cg :=
    mul_le_mul hφ0 hg1
      hg1nonneg hCφ
  have h23 :
      (|conePhiPhysicalReal (z 2 - u 1)| * (1 + |z 2 - u 1|) ^ n) *
        (gaussian (z 3) * (1 + |z 3|) ^ n) ≤ Cφ * Cg :=
    mul_le_mul hφ2 hg3
      hg3nonneg hCφ
  have hproduct :
      (|conePhiPhysicalReal (z 0 - u 0)| * (1 + |z 0 - u 0|) ^ n) *
        (gaussian (z 1) * (1 + |z 1|) ^ n) *
        (|conePhiPhysicalReal (z 2 - u 1)| * (1 + |z 2 - u 1|) ^ n) *
        (gaussian (z 3) * (1 + |z 3|) ^ n) ≤
          (Cφ * Cg) * (Cφ * Cg) := by
    calc
      (|conePhiPhysicalReal (z 0 - u 0)| * (1 + |z 0 - u 0|) ^ n) *
          (gaussian (z 1) * (1 + |z 1|) ^ n) *
          (|conePhiPhysicalReal (z 2 - u 1)| * (1 + |z 2 - u 1|) ^ n) *
          (gaussian (z 3) * (1 + |z 3|) ^ n) =
          ((|conePhiPhysicalReal (z 0 - u 0)| * (1 + |z 0 - u 0|) ^ n) *
            (gaussian (z 1) * (1 + |z 1|) ^ n)) *
          ((|conePhiPhysicalReal (z 2 - u 1)| * (1 + |z 2 - u 1|) ^ n) *
            (gaussian (z 3) * (1 + |z 3|) ^ n)) := by ac_rfl
      _ ≤ (Cφ * Cg) * (Cφ * Cg) :=
        mul_le_mul h01 h23
          (mul_nonneg hφ2nonneg hg3nonneg)
          (mul_nonneg hCφ hCg)
  have hbase : (1 + fourRadiusShift z u) ^ n ≤
      ((1 + |z 0 - u 0|) * (1 + |z 1|) *
        (1 + |z 2 - u 1|) * (1 + |z 3|)) ^ n :=
    pow_le_pow_left₀ (by linarith [fourRadiusShift_nonneg z u])
      (one_add_fourRadiusShift_le_product z u) n
  have hinputnonneg : 0 ≤ superpositionInput z u := by
    unfold superpositionInput
    exact mul_nonneg
      (mul_nonneg
        (mul_nonneg (abs_nonneg _) (gaussian_nonneg _))
        (abs_nonneg _))
      (gaussian_nonneg _)
  calc
    superpositionInput z u * (1 + fourRadiusShift z u) ^ n ≤
        superpositionInput z u *
          ((1 + |z 0 - u 0|) * (1 + |z 1|) *
            (1 + |z 2 - u 1|) * (1 + |z 3|)) ^ n :=
      mul_le_mul_of_nonneg_left hbase hinputnonneg
    _ = (|conePhiPhysicalReal (z 0 - u 0)| * (1 + |z 0 - u 0|) ^ n) *
        (gaussian (z 1) * (1 + |z 1|) ^ n) *
        (|conePhiPhysicalReal (z 2 - u 1)| * (1 + |z 2 - u 1|) ^ n) *
        (gaussian (z 3) * (1 + |z 3|) ^ n) := by
      simpa only [superpositionInput] using
        four_factor_mul_pow_distribute
          |conePhiPhysicalReal (z 0 - u 0)| (gaussian (z 1))
          |conePhiPhysicalReal (z 2 - u 1)| (gaussian (z 3))
          (1 + |z 0 - u 0|) (1 + |z 1|)
          (1 + |z 2 - u 1|) (1 + |z 3|) n
    _ ≤ (Cφ * Cg) * (Cφ * Cg) := hproduct

/-- The order-fifty instance used by the translated low-frequency estimate. -/
theorem superpositionInput_shift_weighted_decay :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (z : E4) (u : E3),
      superpositionInput z u * (1 + fourRadiusShift z u) ^ 50 ≤ C :=
  superpositionInput_shift_weighted_decay_at 50

/-- Translation of the two low-frequency slots costs exactly the source
weight `U(u)^50`. -/
theorem superpositionInput_weighted_decay :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (z : E4) (u : E3),
      superpositionInput z u * (1 + fourRadius z) ^ 50 ≤
        C * sourceWeight u ^ 50 := by
  rcases superpositionInput_shift_weighted_decay with ⟨C, hC, hshift⟩
  refine ⟨C, hC, ?_⟩
  intro z u
  have hinputnonneg : 0 ≤ superpositionInput z u := by
    unfold superpositionInput
    exact mul_nonneg
      (mul_nonneg
        (mul_nonneg (abs_nonneg _) (gaussian_nonneg _))
        (abs_nonneg _))
      (gaussian_nonneg _)
  have htranslate : (1 + fourRadius z) ^ 50 ≤
      sourceWeight u ^ 50 * (1 + fourRadiusShift z u) ^ 50 := by
    calc
      (1 + fourRadius z) ^ 50 ≤
          (sourceWeight u * (1 + fourRadiusShift z u)) ^ 50 :=
        pow_le_pow_left₀ (by linarith [fourRadius_nonneg z])
          (one_add_fourRadius_le_sourceWeight_mul_shift z u) 50
      _ = sourceWeight u ^ 50 * (1 + fourRadiusShift z u) ^ 50 := by
        rw [mul_pow]
  calc
    superpositionInput z u * (1 + fourRadius z) ^ 50 ≤
        superpositionInput z u *
          (sourceWeight u ^ 50 * (1 + fourRadiusShift z u) ^ 50) :=
      mul_le_mul_of_nonneg_left htranslate hinputnonneg
    _ = sourceWeight u ^ 50 *
        (superpositionInput z u * (1 + fourRadiusShift z u) ^ 50) := by ring
    _ ≤ sourceWeight u ^ 50 * C :=
      mul_le_mul_of_nonneg_left (hshift z u)
        (pow_nonneg (sourceWeight_nonneg u) _)
    _ = C * sourceWeight u ^ 50 := by ring

/-- The third pointwise estimate of `lem:domination`: the two translated
low-frequency factors are controlled by the positive Gaussian superposition. -/
theorem gaussianSuperposition_domination :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (z : E4) (u : E3),
      superpositionInput z u ≤
        C * sourceWeight u ^ 50 * gaussianSuperposition z := by
  rcases superpositionInput_weighted_decay with ⟨C, hC, hinput⟩
  let c : ℝ := (2 : ℝ) ^ (-51 : ℝ) * Real.exp (-Real.pi) ^ 4
  have hcpos : 0 < c := by
    unfold c
    exact mul_pos (Real.rpow_pos_of_pos zero_lt_two _) (pow_pos (Real.exp_pos _) _)
  refine ⟨C * c⁻¹, mul_nonneg hC (inv_nonneg.mpr hcpos.le), ?_⟩
  intro z u
  let A : ℝ := 1 + fourRadius z
  have hApos : 0 < A := by
    dsimp [A]
    linarith [fourRadius_nonneg z]
  have hAinv : (A ^ (50 : ℕ))⁻¹ = A ^ (-50 : ℝ) := by
    rw [← Real.rpow_natCast A 50]
    exact (Real.rpow_neg hApos.le (50 : ℝ)).symm
  have hinputPower : superpositionInput z u ≤
      C * sourceWeight u ^ 50 * A ^ (-50 : ℝ) := by
    calc
      superpositionInput z u ≤ (C * sourceWeight u ^ 50) / A ^ (50 : ℕ) :=
        (le_div_iff₀ (pow_pos hApos _)).mpr (by simpa [A] using hinput z u)
      _ = C * sourceWeight u ^ 50 * A ^ (-50 : ℝ) := by
        rw [div_eq_mul_inv, hAinv]
  have hsuper : c * A ^ (-50 : ℝ) ≤ gaussianSuperposition z := by
    simpa [c, A] using gaussianSuperposition_lower_power z
  have hAtoSuper : A ^ (-50 : ℝ) ≤ c⁻¹ * gaussianSuperposition z := by
    calc
      A ^ (-50 : ℝ) ≤ gaussianSuperposition z / c := by
        apply (le_div_iff₀ hcpos).mpr
        simpa [mul_comm] using hsuper
      _ = c⁻¹ * gaussianSuperposition z := by ring
  have hmult : 0 ≤ C * sourceWeight u ^ 50 :=
    mul_nonneg hC (pow_nonneg (sourceWeight_nonneg u) _)
  calc
    superpositionInput z u ≤ C * sourceWeight u ^ 50 * A ^ (-50 : ℝ) := hinputPower
    _ ≤ C * sourceWeight u ^ 50 * (c⁻¹ * gaussianSuperposition z) :=
      mul_le_mul_of_nonneg_left hAtoSuper hmult
    _ = (C * c⁻¹) * sourceWeight u ^ 50 * gaussianSuperposition z := by ring

local instance : Fact (0 < (8 : ℝ)) := ⟨by norm_num⟩


/-- **`lem:schwartz`** (Schwartz-space toolkit), item 1.

`S(E_d) ⊂ C_b(E_d) ∩ L^p(E_d)` for every `1 ≤ p ≤ ∞`.

This is the `L^p` half; the bounded-continuous half is carried by the type of
`Schwartz3`. -/
theorem lem_schwartz_memLp (f : Schwartz3) (p : ℝ≥0∞) : MemLp f p :=
  schwartz_memLp f p

/-- **`lem:bumps`** (Bump properties).

The standard bump is real, even, and Schwartz; `0 ≤ b ≤ 1`,
`supp b ⊂ [-1,1]`, and `b = 1` on `[-1/2,1/2]`.

This is the normalisation assertion `b = 1` on `[-1/2,1/2]`. -/
theorem lem_bumps_standardFrequencyBump_eq_one {x : ℝ} (hx : |x| ≤ 1 / 2) :
    standardFrequencyBump x = 1 :=
  standardFrequencyBump_eq_one_of_abs_le_half hx

/-- **`lem:bumps`** (Bump properties).

Moreover `c_Ψ > 0`, `Ψ` and `Φ` are real, even and smooth,
`supp Ψ ⊂ [-2,-1] ∪ [1,2]`, `supp Φ ⊂ [-2,2]`, `Φ = c_Ψ` on `[-1,1]`.

This is the positivity of `c_Ψ`. -/
theorem lem_bumps_cPsi_pos : 0 < cPsi :=
  cPsi_pos

/-- **`lem:bumps`** (Bump properties).

`Φ = c_Ψ` on `[-1,1]`. -/
theorem lem_bumps_conePhi_eq_cPsi {x : ℝ} (hx : |x| ≤ 1) :
    conePhi x = cPsi :=
  conePhi_eq_cPsi_of_abs_le_one hx

/-- **`lem:domination`** (Gaussian domination), equation `eq:superposition`.

For `z ∈ E_4`, `u ∈ E_3`,
`|φ(z₁-u₁)| g(z₂) |φ(z₃-u₂)| g(z₄)
   ≤ C U(u)^{50} ∫_1^∞ ∏_{a=1}^4 g_{(λ)}(z_a) λ^{-47} dλ`. -/
theorem lem_domination_gaussianSuperposition :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (z : E4) (u : E3),
      superpositionInput z u ≤
        C * sourceWeight u ^ 50 * gaussianSuperposition z :=
  gaussianSuperposition_domination

