/-! ## Balancing the atom-dependent output crossover

After the two-sided layer split, the low weak-one and high base-strong
contributions have scales `A * s^(R - 1)` and `B * s^(R - R₀)`.
The elementary balance relation below is the exact algebra needed to choose
the crossover height separately for each input atom triple.
-/

/-- If the crossover `s` balances the weak-one scale `A` with the base
`R₀`-moment scale `B`, then its low and high target-moment factors coincide.
-/
theorem scratch_outputCrossover_balance
    (A B s R R0 : ℝ) (hs : 0 < s)
    (hbalance : A * s ^ (R0 - 1) = B) :
    A * s ^ (R - 1) = B * s ^ (R - R0) := by
  calc
    A * s ^ (R - 1) = A * s ^ ((R0 - 1) + (R - R0)) := by
      congr 1
      ring_nf
    _ = A * (s ^ (R0 - 1) * s ^ (R - R0)) := by
      rw [Real.rpow_add hs]
    _ = (A * s ^ (R0 - 1)) * s ^ (R - R0) := by ring
    _ = B * s ^ (R - R0) := by rw [hbalance]

/-- The positive crossover which balances two positive endpoint scales.  Its
explicit formula is useful because the weak and base-strong scales depend on
the selected input atom triple. -/
theorem scratch_exists_outputCrossover_balance
    (A B R0 : ℝ) (hA : 0 < A) (hB : 0 < B) (hR0 : 1 < R0) :
    ∃ s : ℝ, 0 < s ∧ A * s ^ (R0 - 1) = B := by
  have hd : R0 - 1 ≠ 0 := by linarith
  have hratio : 0 ≤ B / A := div_nonneg hB.le hA.le
  have hratioPos : 0 < B / A := div_pos hB hA
  have hpow : ((B / A) ^ (R0 - 1)⁻¹) ^ (R0 - 1) = B / A :=
    Real.rpow_inv_rpow hratio hd
  refine ⟨(B / A) ^ (R0 - 1)⁻¹, ?_, ?_⟩
  · exact Real.rpow_pos_of_pos hratioPos _
  · rw [hpow]
    field_simp

/-- The rescaled two-sided finite layer bound at a balanced crossover.  This
is the scalar endpoint of the low-weak/high-strong layer-cake step before
the four input-amplitude endpoint factors are substituted. -/
theorem scratch_twoSided_rescaledDyadicOutputLayers_balanced_le
