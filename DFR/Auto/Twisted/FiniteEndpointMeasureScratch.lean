    (htheta_sum : ∑ a, theta a = 1)
    (hC : ∀ a, 0 ≤ C a)
    (hq : ∀ a j, 0 ≤ q a j)
    (hamp₁ : ∀ i, 0 ≤ amp₁ i)
    (hamp₂ : ∀ j, 0 ≤ amp₂ j)
    (hamp₃ : ∀ k, 0 ≤ amp₃ k)
    (hm₁ : ∀ i, 0 ≤ m₁ i)
    (hm₂ : ∀ j, 0 ≤ m₂ j)
    (hm₃ : ∀ k, 0 ≤ m₃ k)
