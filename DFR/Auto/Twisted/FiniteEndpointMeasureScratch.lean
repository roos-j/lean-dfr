    mul_nonneg hA (Real.rpow_nonneg hm _)
  have hfirst : (∏ a, A ^ theta a) = A := by
    rw [← Real.rpow_sum_of_nonneg hA]
    · rw [htheta_sum, Real.rpow_one]
    · intro a _
      exact htheta_nonneg a
  have hsecond : (∏ a, (m ^ q a) ^ theta a) =
      m ^ (∑ a, theta a * q a) := by
    calc
      (∏ a, (m ^ q a) ^ theta a) = ∏ a, m ^ (q a * theta a) := by
        apply Finset.prod_congr rfl
        intro a _
        rw [← Real.rpow_mul hm]
      _ = m ^ (∑ a, q a * theta a) := by
        rw [Real.rpow_sum_of_nonneg hm]
        intro a _
        exact mul_nonneg (hq_nonneg a) (htheta_nonneg a)
      _ = m ^ (∑ a, theta a * q a) := by
        have hcomm : (∑ a, q a * theta a) = ∑ a, theta a * q a := by
          apply Finset.sum_congr rfl
          intro a _
          ring
        rw [hcomm]
  calc
    (∏ a, (A * m ^ q a) ^ theta a) =
        ∏ a, (A ^ theta a * (m ^ q a) ^ theta a) := by
          apply Finset.prod_congr rfl
          intro a _
          exact Real.mul_rpow hA (Real.rpow_nonneg hm _)
    _ = (∏ a, A ^ theta a) * (∏ a, (m ^ q a) ^ theta a) := by
      rw [Finset.prod_mul_distrib]
    _ = A * m ^ (∑ a, theta a * q a) := by rw [hfirst, hsecond]

