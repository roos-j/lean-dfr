atoms, which is useful before null atoms are discarded. -/
theorem scratch_barycentric_atom_size
    (A m : ℝ) (hA : 0 ≤ A) (hm : 0 ≤ m)
    (theta q : Fin 4 → ℝ)
    (htheta_nonneg : ∀ a, 0 ≤ theta a)
    (htheta_sum : ∑ a, theta a = 1)
