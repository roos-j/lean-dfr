  · refine mul_le_mul_of_nonneg_right ?_ hw100.le
    rw [hC₁, C_ModelTruncatedOperator_weakNorm_le_one_fiber]
    have := le_max_right (64 * C)
      (Ct * (((α.weight m : ℕ) : ℝ)⁻¹ * (1 / 72)) *
        (4 * 2 ^ (1 / p) *
          C_lpNorm_finset_double_intervalTails_le_of_radius_sum qc) *
