          UnitAddTorus.mFourier (-ν) (fun j ↦ (![x, y, z] j : UnitAddCircle)) *
            localizedSymbolRaw α m i t (8 * x) (8 * y) (8 * z)) =
      scratch_nestedRawUnitFourierCoeff_middle α m i t ν := by
  have hab : -(1 / 2 : ℝ) < 1 / 2 := by norm_num
