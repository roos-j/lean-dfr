    have h1 : ∑ i ∈ T.filter (fun i ↦ i ∈ I), ((2:ℝ) ^ (-(1 / 2 * (i:ℝ))) *
        max (Γ₁ i) ((2:ℝ) ^ (i:ℝ) * Γ₂ i)) ^ R ≤ c₃ ^ R * Cfp := by
      calc ∑ i ∈ T.filter (fun i ↦ i ∈ I), ((2:ℝ) ^ (-(1 / 2 * (i:ℝ))) *
