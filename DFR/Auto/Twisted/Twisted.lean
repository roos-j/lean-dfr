    ∃ C : ℝ, 0 ≤ C ∧ ∀ {Z : Type*} [MeasurableSpace Z]
      (F : ℝ × Z → ℝ) (Zf : Set Z)
      (Astop : FiberDyadicInterval → Z → ℝ) (H : ℝ)
      (z : Z) (T : Finset FiberDyadicInterval)
