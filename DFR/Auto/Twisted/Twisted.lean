      (∀ i, weakNorm μ (v i) r₁ ≤ ENNReal.ofReal (Γ₁ i)) →
      (∀ i, weakNorm μ (v i) r₂ ≤ ENNReal.ofReal (Γ₂ i)) →
      ∀ Bw : ℝ, 0 < Bw →
      (∀ T : Finset ℤ, ∑ i ∈ T, ((2:ℝ) ^ (-(θ * (i:ℝ))) *
