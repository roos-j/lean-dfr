/-- Restriction of a joint Schwartz function to a fixed first-coordinate
fibre.  This is item (4)'s fixed-fibre assertion, obtained from the injective
affine-pullback theorem rather than from an invalid projection pullback. -/
noncomputable def schwartzFixedFiber
    {D E V : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    (F : SchwartzMap (D × E) V) (u : D) : SchwartzMap E V :=
  schwartzAffinePullbackOfInjective (𝕜 := ℂ) (ContinuousLinearMap.inr ℝ D E)
    (by
      intro v w h
      change (0, v) = (0, w) at h
      exact Prod.ext_iff.mp h |>.2)
    (u, 0) F

@[simp]
theorem schwartzFixedFiber_apply
    {D E V : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    (F : SchwartzMap (D × E) V) (u : D) (v : E) :
    schwartzFixedFiber F u v = F (u, v) := by
  simp [schwartzFixedFiber, schwartzAffinePullbackOfInjective]

/-- A joint Schwartz estimate gives a uniform rapid-decay majorant in its
second coordinate.  This is the quantitative domination needed to justify
the parameter integral in item (4) of Lemma `lem:schwartz`. -/
theorem schwartz_uniform_second_decay
    {D E V : Type*}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    (F : SchwartzMap (D × E) V) (r n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ z : D × E,
      ‖iteratedFDeriv ℝ n F z‖ ≤ C / (1 + ‖z.2‖) ^ r := by
  let C : ℝ := 2 ^ r *
    (Finset.Iic (r, n)).sup (fun q ↦ SchwartzMap.seminorm ℂ q.1 q.2) F
  have hC : 0 ≤ C := by
    have h := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℂ)
      (m := (r, n)) le_rfl le_rfl F (0 : D × E)
    have hnonneg : 0 ≤ (1 + ‖(0 : D × E)‖) ^ r *
        ‖iteratedFDeriv ℝ n F (0 : D × E)‖ :=
      mul_nonneg (pow_nonneg (by positivity) _) (norm_nonneg _)
    exact hnonneg.trans (by simpa [C] using h)
  refine ⟨C, hC, fun z ↦ ?_⟩
  apply (le_div_iff₀ (by positivity)).mpr
  rw [mul_comm]
  calc
    (1 + ‖z.2‖) ^ r * ‖iteratedFDeriv ℝ n F z‖ ≤
        (1 + ‖z‖) ^ r * ‖iteratedFDeriv ℝ n F z‖ := by
      gcongr
      rw [Prod.norm_def]
      exact le_max_right _ _
    _ ≤ C := by
      simpa [C] using (SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℂ)
        (m := (r, n)) le_rfl le_rfl F z)

/-- A joint Schwartz estimate with a polynomial weight in the retained
coordinate and rapid decay in the integrated coordinate. -/
theorem schwartz_weighted_second_decay
    {D E V : Type*}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    (F : SchwartzMap (D × E) V) (k r n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ z : D × E,
      ‖z.1‖ ^ k * ‖iteratedFDeriv ℝ n F z‖ ≤ C / (1 + ‖z.2‖) ^ r := by
  let C : ℝ := 2 ^ (k + r) *
    (Finset.Iic (k + r, n)).sup (fun q ↦ SchwartzMap.seminorm ℂ q.1 q.2) F
  have hC : 0 ≤ C := by
    have h := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℂ)
      (m := (k + r, n)) le_rfl le_rfl F (0 : D × E)
    have hnonneg : 0 ≤ (1 + ‖(0 : D × E)‖) ^ (k + r) *
        ‖iteratedFDeriv ℝ n F (0 : D × E)‖ :=
      mul_nonneg (pow_nonneg (by positivity) _) (norm_nonneg _)
    exact hnonneg.trans (by simpa [C] using h)
  refine ⟨C, hC, fun z ↦ ?_⟩
  apply (le_div_iff₀ (by positivity)).mpr
  have hz1 : ‖z.1‖ ≤ 1 + ‖z‖ := by
    rw [Prod.norm_def]
    exact le_trans (le_max_left _ _) (by linarith [norm_nonneg z])
  have hz2 : 1 + ‖z.2‖ ≤ 1 + ‖z‖ := by
    rw [Prod.norm_def]
    gcongr
    exact le_max_right _ _
  calc
    (‖z.1‖ ^ k * ‖iteratedFDeriv ℝ n F z‖) * (1 + ‖z.2‖) ^ r =
        (‖z.1‖ ^ k * (1 + ‖z.2‖) ^ r) * ‖iteratedFDeriv ℝ n F z‖ := by ring
    _ ≤ ((1 + ‖z‖) ^ k * (1 + ‖z‖) ^ r) * ‖iteratedFDeriv ℝ n F z‖ := by
      gcongr
    _ = (1 + ‖z‖) ^ (k + r) * ‖iteratedFDeriv ℝ n F z‖ := by rw [← pow_add]
    _ ≤ C := by
      simpa [C] using (SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℂ)
        (m := (k + r, n)) le_rfl le_rfl F z)

/-- The reciprocal polynomial majorant used for parameter integration is
integrable whenever its exponent is one above the dimension. -/
theorem integrable_second_weight
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
    {μ : Measure E} [μ.IsAddHaarMeasure] (C : ℝ) :
    Integrable (fun v : E ↦ C / (1 + ‖v‖) ^ (Module.finrank ℝ E + 1)) μ := by
  have hr : (Module.finrank ℝ E : ℝ) <
      (↑(Module.finrank ℝ E + 1) : ℝ) := by
    exact_mod_cast Nat.lt_succ_self (Module.finrank ℝ E)
  have h := (integrable_one_add_norm (E := E) (μ := μ) hr).const_mul C
  convert h using 1
  ext v
  rw [Real.rpow_neg (by positivity), ← Real.rpow_natCast]
  ring

/-- The derivative of a joint function in its first coordinate, retained as a
Schwartz function with continuous-linear-map values. -/
noncomputable def schwartzFiberFDeriv
    {D E V : Type*}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    (F : SchwartzMap (D × E) V) : SchwartzMap (D × E) (D →L[ℝ] V) :=
  (SchwartzMap.fderivCLM ℂ (D × E) V F).postcompCLM
    ((ContinuousLinearMap.compL ℝ D (D × E) V).flip (ContinuousLinearMap.inl ℝ D E))

@[simp]
theorem schwartzFiberFDeriv_apply
    {D E V : Type*}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    (F : SchwartzMap (D × E) V) (z : D × E) (h : D) :
    schwartzFiberFDeriv F z h = fderiv ℝ F z (h, 0) := rfl

/-- A first-coordinate slice of a joint Schwartz function has the derivative
obtained by restricting the joint Fréchet derivative to that coordinate. -/
theorem hasFDerivAt_schwartzFiberSlice
    {D E V : Type*}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    (F : SchwartzMap (D × E) V) (u : D) (v : E) :
    HasFDerivAt (fun x : D ↦ F (x, v)) (schwartzFiberFDeriv F (u, v)) u := by
  have hlin : HasFDerivAt (fun x : D ↦ (x, v))
      (ContinuousLinearMap.inl ℝ D E) u := by
    simpa [ContinuousLinearMap.inl_apply] using
      ((ContinuousLinearMap.inl ℝ D E).hasFDerivAt (x := u) |>.add_const (0, v))
  convert (F.hasFDerivAt (u, v)).comp u hlin using 1
  · rfl
  · ext h
    rfl

/-- Integrate a joint Schwartz function in its second variable.  The following
dominated-differentiation theorem supplies its first derivative; the full
Schwartz construction below iterates this identity. -/
noncomputable def schwartzFiberIntegral
    {D E V : Type*}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [MeasurableSpace E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    (μ : Measure E) (F : SchwartzMap (D × E) V) : D → V :=
  fun u ↦ ∫ v, F (u, v) ∂μ

/-- Differentiation under the parameter integral for a joint Schwartz
function.  Its majorant is the explicit dimension-plus-one reciprocal weight
proved above, so no unrecorded Fubini or domination assumption is used. -/
theorem schwartzFiberIntegral_hasFDerivAt
    {D E V : Type*}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    {μ : Measure E} [μ.IsAddHaarMeasure]
    (F : SchwartzMap (D × E) V) (u : D) :
    HasFDerivAt (schwartzFiberIntegral μ F)
      (∫ v, schwartzFiberFDeriv F (u, v) ∂μ) u := by
  obtain ⟨C, hC, hdecay⟩ :=
    schwartz_uniform_second_decay (schwartzFiberFDeriv F)
      (Module.finrank ℝ E + 1) 0
  let bound : E → ℝ := fun v ↦ C / (1 + ‖v‖) ^ (Module.finrank ℝ E + 1)
  have hF_meas : ∀ᶠ x in 𝓝 u, AEStronglyMeasurable (fun v ↦ F (x, v)) μ :=
    Filter.Eventually.of_forall fun x ↦ by
      simpa only [← schwartzFixedFiber_apply] using
        ((schwartzFixedFiber F x).integrable (μ := μ)).aestronglyMeasurable
  have hF_int : Integrable (fun v ↦ F (u, v)) μ := by
    simpa only [← schwartzFixedFiber_apply] using
      (schwartzFixedFiber F u).integrable (μ := μ)
  have hF'_meas : AEStronglyMeasurable
      (fun v ↦ schwartzFiberFDeriv F (u, v)) μ := by
    simpa only [← schwartzFixedFiber_apply] using
      ((schwartzFixedFiber (schwartzFiberFDeriv F) u).integrable (μ := μ)).aestronglyMeasurable
  have hbound : ∀ᵐ v ∂μ, ∀ x ∈ Set.univ,
      ‖schwartzFiberFDeriv F (x, v)‖ ≤ bound v :=
    Filter.Eventually.of_forall fun v x _ ↦ by
      simpa only [bound, norm_iteratedFDeriv_zero] using hdecay (x, v)
  have hbound_int : Integrable bound μ := by
    simpa only [bound] using integrable_second_weight (μ := μ) C
  have hdiff : ∀ᵐ v ∂μ, ∀ x ∈ Set.univ,
      HasFDerivAt (fun y : D ↦ F (y, v)) (schwartzFiberFDeriv F (x, v)) x :=
    Filter.Eventually.of_forall fun v x _ ↦ hasFDerivAt_schwartzFiberSlice F x v
  change HasFDerivAt (fun x : D ↦ ∫ v : E, F (x, v) ∂μ)
    (∫ v, schwartzFiberFDeriv F (u, v) ∂μ) u
  exact hasFDerivAt_integral_of_dominated_of_fderiv_le (s := Set.univ)
    univ_mem hF_meas hF_int hF'_meas hbound hbound_int hdiff

/-- Finite-order smoothness of the fiber integral.  The induction feeds the
Schwartz-valued first-coordinate derivative back into the same dominated
parameter-integral theorem. -/
theorem schwartzFiberIntegral_contDiff_nat
    {D E V : Type u}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    {μ : Measure E} [μ.IsAddHaarMeasure]
    (F : SchwartzMap (D × E) V) (n : ℕ) :
    ContDiff ℝ n (schwartzFiberIntegral μ F) := by
  induction n generalizing V with
  | zero =>
      apply contDiff_zero.2
      have hd : Differentiable ℝ (schwartzFiberIntegral μ F) :=
        fun u ↦ (schwartzFiberIntegral_hasFDerivAt F u).differentiableAt
      exact hd.continuous
  | succ n ih =>
      apply (contDiff_succ_iff_hasFDerivAt (n := n)).2
      refine ⟨schwartzFiberIntegral μ (schwartzFiberFDeriv F), ?_, ?_⟩
      · exact ih (schwartzFiberFDeriv F)
      · intro u
        exact schwartzFiberIntegral_hasFDerivAt F u

/-- The fiber integral is smooth to every finite order. -/
theorem schwartzFiberIntegral_smooth
    {D E V : Type u}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    {μ : Measure E} [μ.IsAddHaarMeasure]
    (F : SchwartzMap (D × E) V) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (schwartzFiberIntegral μ F) := by
  rw [contDiff_infty]
  intro n
  exact schwartzFiberIntegral_contDiff_nat F n

/-- Zeroth-order weighted decay of a fiber integral. -/
theorem schwartzFiberIntegral_decay_zero
    {D E V : Type u}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    {μ : Measure E} [μ.IsAddHaarMeasure]
    (F : SchwartzMap (D × E) V) (k : ℕ) :
    ∃ C : ℝ, ∀ u : D,
      ‖u‖ ^ k * ‖schwartzFiberIntegral μ F u‖ ≤ C := by
  let r : ℕ := Module.finrank ℝ E + 1
  obtain ⟨C, hC, hdecay⟩ := schwartz_weighted_second_decay F k r 0
  let major : E → ℝ := fun v ↦ C / (1 + ‖v‖) ^ r
  have hmajor : Integrable major μ := by
    simpa only [major, r] using integrable_second_weight (μ := μ) C
  refine ⟨∫ v, major v ∂μ, fun u ↦ ?_⟩
  have hFu : Integrable (fun v : E ↦ F (u, v)) μ := by
    simpa only [← schwartzFixedFiber_apply] using
      (schwartzFixedFiber F u).integrable (μ := μ)
  have hnorm : Integrable (fun v : E ↦ ‖u‖ ^ k * ‖F (u, v)‖) μ :=
    hFu.norm.const_mul _
  calc
    ‖u‖ ^ k * ‖schwartzFiberIntegral μ F u‖ =
        ‖u‖ ^ k * ‖∫ v : E, F (u, v) ∂μ‖ := rfl
    _ ≤ ‖u‖ ^ k * ∫ v : E, ‖F (u, v)‖ ∂μ := by
      gcongr
      exact norm_integral_le_integral_norm _
    _ = ∫ v : E, ‖u‖ ^ k * ‖F (u, v)‖ ∂μ := by
      rw [integral_const_mul]
    _ ≤ ∫ v, major v ∂μ := by
      apply integral_mono hnorm hmajor
      intro v
      simpa only [major, norm_iteratedFDeriv_zero] using hdecay (u, v)

/-- Every iterated first-coordinate derivative of the fiber integral has the
required polynomial decay. -/
theorem schwartzFiberIntegral_decay
    {D E V : Type u}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    {μ : Measure E} [μ.IsAddHaarMeasure]
    (F : SchwartzMap (D × E) V) (k n : ℕ) :
    ∃ C : ℝ, ∀ u : D,
      ‖u‖ ^ k * ‖iteratedFDeriv ℝ n (schwartzFiberIntegral μ F) u‖ ≤ C := by
  induction n generalizing V with
  | zero =>
      simpa only [norm_iteratedFDeriv_zero] using schwartzFiberIntegral_decay_zero F k
  | succ n ih =>
      obtain ⟨C, hC⟩ := ih (V := D →L[ℝ] V) (schwartzFiberFDeriv F)
      refine ⟨C, fun u ↦ ?_⟩
      rw [← norm_iteratedFDeriv_fderiv]
      have heq : fderiv ℝ (schwartzFiberIntegral μ F) =
          schwartzFiberIntegral μ (schwartzFiberFDeriv F) := by
        funext u
        exact (schwartzFiberIntegral_hasFDerivAt F u).fderiv
      rw [heq]
      exact hC u

/-- Integration over a fixed Euclidean fiber preserves the Schwartz class.
This packages the smoothness and all weighted derivative estimates above into
item (4) of Lemma `lem:schwartz`. -/
noncomputable def schwartzFiberIntegralMap
    {D E V : Type u}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    {μ : Measure E} [μ.IsAddHaarMeasure]
    (F : SchwartzMap (D × E) V) : SchwartzMap D V where
  toFun := schwartzFiberIntegral μ F
  smooth' := schwartzFiberIntegral_smooth F
  decay' := schwartzFiberIntegral_decay F

@[simp]
theorem schwartzFiberIntegralMap_apply
    {D E V : Type u}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    {μ : Measure E} [μ.IsAddHaarMeasure]
    (F : SchwartzMap (D × E) V) (u : D) :
    schwartzFiberIntegralMap (μ := μ) F u = ∫ v : E, F (u, v) ∂μ := rfl

/-- The absolute fiber integrals of a joint Schwartz function are uniformly
bounded in the retained parameter. -/
theorem schwartz_uniform_fiber_norm_integral
    {D E V : Type u}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    {μ : Measure E} [μ.IsAddHaarMeasure]
    (F : SchwartzMap (D × E) V) :
    ∃ C : ℝ, ∀ u : D, ∫ v : E, ‖F (u, v)‖ ∂μ ≤ C := by
  let r : ℕ := Module.finrank ℝ E + 1
  obtain ⟨C, hC, hdecay⟩ := schwartz_weighted_second_decay F 0 r 0
  let major : E → ℝ := fun v ↦ C / (1 + ‖v‖) ^ r
  have hmajor : Integrable major μ := by
    simpa only [major, r] using integrable_second_weight (μ := μ) C
  refine ⟨∫ v, major v ∂μ, fun u ↦ ?_⟩
  have hFu : Integrable (fun v : E ↦ F (u, v)) μ := by
    simpa only [← schwartzFixedFiber_apply] using
      (schwartzFixedFiber F u).integrable (μ := μ)
  apply integral_mono hFu.norm hmajor
  intro v
  simpa only [major, norm_iteratedFDeriv_zero, pow_zero, one_mul] using hdecay (u, v)

/-- The source's linear coordinate shear `(x,t) ↦ (x - t e_i,t)`. -/
noncomputable def coordinateShear (i : Fin 3) : E3 × ℝ →L[ℝ] E3 × ℝ :=
  (ContinuousLinearMap.fst ℝ E3 ℝ -
      ((ContinuousLinearMap.id ℝ ℝ).smulRight (Anisotropy.coordinateDirection i) ∘L
        ContinuousLinearMap.snd ℝ E3 ℝ)).prod
    (ContinuousLinearMap.snd ℝ E3 ℝ)

@[simp]
theorem coordinateShear_apply (i : Fin 3) (z : E3 × ℝ) :
    coordinateShear i z = (z.1 - z.2 • Anisotropy.coordinateDirection i, z.2) := by
  simp [coordinateShear]

theorem coordinateShear_injective (i : Fin 3) : Function.Injective (coordinateShear i) := by
  intro z w h
  have hsecond : z.2 = w.2 := by
    simpa only [coordinateShear_apply] using congrArg Prod.snd h
  apply Prod.ext
  · have hfirst := congrArg Prod.fst h
    have hfirst' : z.1 - w.2 • Anisotropy.coordinateDirection i =
        w.1 - w.2 • Anisotropy.coordinateDirection i := by
      simpa only [coordinateShear_apply, hsecond] using hfirst
    calc
      z.1 = (z.1 - w.2 • Anisotropy.coordinateDirection i) +
          w.2 • Anisotropy.coordinateDirection i := (sub_add_cancel _ _).symm
      _ = (w.1 - w.2 • Anisotropy.coordinateDirection i) +
          w.2 • Anisotropy.coordinateDirection i := by rw [hfirst']
      _ = w.1 := sub_add_cancel _ _
  · exact hsecond

/-- Convolution of a three-dimensional Schwartz function along one coordinate
with a one-dimensional Schwartz kernel. -/
noncomputable def schwartzCoordinateConvolution
    (i : Fin 3) (f : Schwartz3) (g : SchwartzMap ℝ ℂ) : Schwartz3 :=
  schwartzFiberIntegralMap (μ := volume)
    (schwartzAffinePullbackOfInjective (𝕜 := ℂ) (coordinateShear i)
      (coordinateShear_injective i) 0 (schwartzExternalProduct f g))

@[simp]
theorem schwartzCoordinateConvolution_apply
    (i : Fin 3) (f : Schwartz3) (g : SchwartzMap ℝ ℂ) (x : E3) :
    schwartzCoordinateConvolution i f g x =
      ∫ t : ℝ, f (x - t • Anisotropy.coordinateDirection i) * g t := by
  simp [schwartzCoordinateConvolution]

/-- Evaluation in one Euclidean coordinate as a continuous linear map. -/
def coordinateProjection (i : Fin 3) : E3 →L[ℝ] ℝ where
  toFun := fun x ↦ x i
  map_add' := by
    intro x y
    rfl
  map_smul' := by
    intro c x
    rfl
  cont := PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i

@[simp]
theorem coordinateProjection_apply (i : Fin 3) (x : E3) :
    coordinateProjection i x = x i := rfl

@[simp]
theorem coordinateDirection_apply (i j : Fin 3) :
    Anisotropy.coordinateDirection i j = if j = i then 1 else 0 := by
  simp [Anisotropy.coordinateDirection]

/-- The `i`-th translated copy `x + t_i e_i` on the `(t,x)` parameter
space used in the source definition of `P_f`. -/
noncomputable def twistedShiftedCoordinate (i : Fin 3) : E3 × E3 →L[ℝ] E3 :=
  ContinuousLinearMap.snd ℝ E3 E3 +
    ((coordinateProjection i ∘L ContinuousLinearMap.fst ℝ E3 E3).smulRight
      (Anisotropy.coordinateDirection i))

@[simp]
theorem twistedShiftedCoordinate_apply (i : Fin 3) (z : E3 × E3) :
    twistedShiftedCoordinate i z = z.2 + z.1 i • Anisotropy.coordinateDirection i := by
  simp [twistedShiftedCoordinate]

/-- The injective source map `(t,x) ↦ (x,x+t₀e₀,x+t₁e₁,x+t₂e₂)`, grouped
as two pairs so it can be fed to iterated external products. -/
noncomputable def twistedProductLinear :
    E3 × E3 →L[ℝ] (E3 × E3) × (E3 × E3) :=
  ((ContinuousLinearMap.snd ℝ E3 E3).prod (twistedShiftedCoordinate 0)).prod
    ((twistedShiftedCoordinate 1).prod (twistedShiftedCoordinate 2))

@[simp]
theorem twistedProductLinear_apply (z : E3 × E3) :
    twistedProductLinear z =
      ((z.2, twistedShiftedCoordinate 0 z),
        (twistedShiftedCoordinate 1 z, twistedShiftedCoordinate 2 z)) := by
  simp [twistedProductLinear]

theorem twistedProductLinear_injective : Function.Injective twistedProductLinear := by
  intro z w h
  have hbase : z.2 = w.2 := by
    have h' := congrArg (fun q : (E3 × E3) × (E3 × E3) ↦ q.1.1) h
    simpa only [twistedProductLinear_apply] using h'
  have hshift : ∀ i : Fin 3,
      twistedShiftedCoordinate i z = twistedShiftedCoordinate i w := by
    intro i
    fin_cases i
    · have h' := congrArg (fun q : (E3 × E3) × (E3 × E3) ↦ q.1.2) h
      change twistedShiftedCoordinate 0 z = twistedShiftedCoordinate 0 w
      simpa only [twistedProductLinear_apply] using h'
    · have h' := congrArg (fun q : (E3 × E3) × (E3 × E3) ↦ q.2.1) h
      change twistedShiftedCoordinate 1 z = twistedShiftedCoordinate 1 w
      simpa only [twistedProductLinear_apply] using h'
    · have h' := congrArg (fun q : (E3 × E3) × (E3 × E3) ↦ q.2.2) h
      change twistedShiftedCoordinate 2 z = twistedShiftedCoordinate 2 w
      simpa only [twistedProductLinear_apply] using h'
  apply Prod.ext
  · ext i
    have hi := congrArg (fun q : E3 ↦ q i) (hshift i)
    rw [twistedShiftedCoordinate_apply, twistedShiftedCoordinate_apply, hbase] at hi
    apply add_left_cancel (a := z.2 i)
    simpa [coordinateDirection_apply] using hi
  · exact hbase

/-- The joint Schwartz function whose fiber integral is the source's
translated product `P_f`. -/
noncomputable def schwartzTwistedProductJoint
    (f₀ f₁ f₂ f₃ : Schwartz3) : SchwartzMap (E3 × E3) ℂ :=
  schwartzAffinePullbackOfInjective (𝕜 := ℂ) twistedProductLinear
    twistedProductLinear_injective 0
    (schwartzExternalProduct (schwartzExternalProduct f₀ f₁)
      (schwartzExternalProduct f₂ f₃))

@[simp]
theorem schwartzTwistedProductJoint_apply
    (f₀ f₁ f₂ f₃ : Schwartz3) (z : E3 × E3) :
    schwartzTwistedProductJoint f₀ f₁ f₂ f₃ z =
      (f₀ z.2 * f₁ (z.2 + z.1 0 • Anisotropy.coordinateDirection 0)) *
        (f₂ (z.2 + z.1 1 • Anisotropy.coordinateDirection 1) *
          f₃ (z.2 + z.1 2 • Anisotropy.coordinateDirection 2)) := by
  simp [schwartzTwistedProductJoint]

/-- The translated product `P_f` from Definition `def:multiplier`. -/
noncomputable def twistedProduct
    (f₀ f₁ f₂ f₃ : Schwartz3) : Schwartz3 :=
  schwartzFiberIntegralMap (μ := volume) (schwartzTwistedProductJoint f₀ f₁ f₂ f₃)

@[simp]
theorem twistedProduct_apply
    (f₀ f₁ f₂ f₃ : Schwartz3) (t : E3) :
    twistedProduct f₀ f₁ f₂ f₃ t =
      ∫ x : E3,
        (f₀ x * f₁ (x + t 0 • Anisotropy.coordinateDirection 0)) *
          (f₂ (x + t 1 • Anisotropy.coordinateDirection 1) *
            f₃ (x + t 2 • Anisotropy.coordinateDirection 2)) := by
  simp [twistedProduct]

/-- Precomposition of a Schwartz function with negation. -/
noncomputable def schwartzNegate (f : Schwartz3) : Schwartz3 :=
  schwartzAffinePullbackOfInjective (𝕜 := ℂ) (-(ContinuousLinearMap.id ℝ E3))
    (by
      intro x y h
      change -x = -y at h
      exact neg_injective h)
    0 f

@[simp]
theorem schwartzNegate_apply (f : Schwartz3) (x : E3) :
    schwartzNegate f x = f (-x) := by
  simp [schwartzNegate, schwartzAffinePullbackOfInjective]

/-- The defining Fourier-side integral for the multiplier form in
Definition `def:multiplier`. -/
noncomputable def multiplierForm
    (m : E3 → ℂ) (f₀ f₁ f₂ f₃ : Schwartz3) : ℂ :=
  ∫ ξ : E3, m ξ * schwartzFourier (twistedProduct f₀ f₁ f₂ f₃) (-ξ)

/-- A bounded measurable multiplier can be multiplied against any Schwartz
test function under the Lebesgue integral. -/
theorem multiplier_mul_schwartz_integrable
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m) (f : Schwartz3) :
    Integrable (fun ξ : E3 ↦ m ξ * f ξ) :=
  f.integrable.bdd_mul hm.measurable.aestronglyMeasurable
    (Filter.Eventually.of_forall fun ξ ↦ hm.norm_le_all ξ)

/-- The bounded multiplier as an `L^∞` representative.  Using the `L^∞`
embedding is essential here: the source does not impose global smoothness at
the origin, so the smooth temperate-growth embedding is not applicable. -/
noncomputable def multiplierLp
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m) :
    MeasureTheory.Lp ℂ ⊤ (volume : Measure E3) :=
  (MeasureTheory.memLp_top_of_bound hm.measurable.aestronglyMeasurable M
    (Filter.Eventually.of_forall fun ξ ↦ hm.norm_le_all ξ)).toLp m

/-- The regular tempered distribution defined by the multiplier, including
its behavior at the origin. -/
noncomputable def multiplierRegularDistribution
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m) :
    TemperedDistribution E3 ℂ :=
  (multiplierLp α M m hm : TemperedDistribution E3 ℂ)

@[simp]
theorem multiplierRegularDistribution_apply
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m) (g : Schwartz3) :
    multiplierRegularDistribution α M m hm g = ∫ ξ : E3, g ξ * m ξ := by
  simp only [multiplierRegularDistribution, multiplierLp,
    MeasureTheory.Lp.toTemperedDistribution_apply]
  apply integral_congr_ae
  filter_upwards [MeasureTheory.MemLp.coeFn_toLp
    (MeasureTheory.memLp_top_of_bound hm.measurable.aestronglyMeasurable M
      (Filter.Eventually.of_forall fun ξ ↦ hm.norm_le_all ξ))] with ξ hξ
  simp [hξ]

/-- The inverse Fourier transform of the regular multiplier distribution,
which is the source kernel `K = 𝓕⁻ m`. -/
noncomputable def inverseMultiplierDistribution
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m) :
    TemperedDistribution E3 ℂ :=
  𝓕⁻ (multiplierRegularDistribution α M m hm)

@[simp]
theorem inverseMultiplierDistribution_apply
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m) (P : Schwartz3) :
    inverseMultiplierDistribution α M m hm P =
      ∫ ξ : E3, (𝓕⁻ P : Schwartz3) ξ * m ξ := by
  rw [inverseMultiplierDistribution, TemperedDistribution.fourierInv_apply,
    multiplierRegularDistribution_apply]

/-- The source's distributional identity: evaluating `K = 𝓕⁻m` on a
Schwartz test function is the literal Fourier-side multiplier integral. -/
theorem inverseMultiplierDistribution_apply_eq_multiplierForm
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (f₀ f₁ f₂ f₃ : Schwartz3) :
    inverseMultiplierDistribution α M m hm (twistedProduct f₀ f₁ f₂ f₃) =
      multiplierForm m f₀ f₁ f₂ f₃ := by
  rw [inverseMultiplierDistribution_apply]
  apply integral_congr_ae
  filter_upwards with ξ
  rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq_fourier_neg]
  change (𝓕 (twistedProduct f₀ f₁ f₂ f₃ : E3 → ℂ)) (-ξ) * m ξ =
    m ξ * (𝓕 (twistedProduct f₀ f₁ f₂ f₃ : E3 → ℂ)) (-ξ)
  ring

/-- The nested product carrier used for the source's nine frequency
coordinates.  Product-coordinate identifications are made explicit below. -/
abbrev Frequency9 := (E3 × E3) × E3

/-- The source's `E_9` integral, written with its nested product Lebesgue
measure.  This makes the blueprint's product-coordinate convention explicit
instead of relying on an unmentioned identification. -/
abbrev frequencyMeasure : Measure Frequency9 :=
  ((volume : Measure E3).prod volume).prod volume

@[simp]
theorem frequencyMeasure_eq_volume : (frequencyMeasure : Measure Frequency9) = volume := by
  simp only [frequencyMeasure, Measure.volume_eq_prod]

noncomputable def frequencyFirst : Frequency9 →L[ℝ] E3 :=
  (ContinuousLinearMap.fst ℝ E3 E3).comp
    (ContinuousLinearMap.fst ℝ (E3 × E3) E3)

noncomputable def frequencySecond : Frequency9 →L[ℝ] E3 :=
  (ContinuousLinearMap.snd ℝ E3 E3).comp
    (ContinuousLinearMap.fst ℝ (E3 × E3) E3)

noncomputable def frequencyThird : Frequency9 →L[ℝ] E3 :=
  ContinuousLinearMap.snd ℝ (E3 × E3) E3

noncomputable def frequencySum : Frequency9 →L[ℝ] E3 :=
  frequencyFirst + frequencySecond + frequencyThird

/-- The three diagonal coordinates `η(ζ)` occurring in the source frequency
formula. -/
noncomputable def frequencyDiagonal : Frequency9 →L[ℝ] E3 :=
  ((coordinateProjection 0).comp frequencyFirst).smulRight
      (Anisotropy.coordinateDirection 0) +
    ((coordinateProjection 1).comp frequencySecond).smulRight
      (Anisotropy.coordinateDirection 1) +
    ((coordinateProjection 2).comp frequencyThird).smulRight
      (Anisotropy.coordinateDirection 2)

@[simp]
theorem frequencyDiagonal_apply (ζ : Frequency9) :
    frequencyDiagonal ζ =
      ζ.1.1 0 • Anisotropy.coordinateDirection 0 +
        ζ.1.2 1 • Anisotropy.coordinateDirection 1 +
          ζ.2 2 • Anisotropy.coordinateDirection 2 := by
  simp [frequencyDiagonal, frequencyFirst, frequencySecond, frequencyThird,
    coordinateProjection_apply]

/-- Package the four frequency arguments
`(-ζ¹-ζ²-ζ³, ζ¹, ζ², ζ³)` for the tensor-product Schwartz map. -/
noncomputable def frequencyPackaging :
    Frequency9 →L[ℝ] (E3 × E3) × (E3 × E3) :=
  ((-frequencySum).prod frequencyFirst).prod
    (frequencySecond.prod frequencyThird)

@[simp]
theorem frequencyPackaging_apply (ζ : Frequency9) :
    frequencyPackaging ζ =
      ((-(ζ.1.1 + ζ.1.2 + ζ.2), ζ.1.1), (ζ.1.2, ζ.2)) := by
  simp [frequencyPackaging, frequencySum, frequencyFirst, frequencySecond, frequencyThird]

theorem frequencyPackaging_injective : Function.Injective frequencyPackaging := by
  intro ζ ω h
  have h₁ := congrArg (fun q : (E3 × E3) × (E3 × E3) ↦ q.1.2) h
  have h₂ := congrArg (fun q : (E3 × E3) × (E3 × E3) ↦ q.2.1) h
  have h₃ := congrArg (fun q : (E3 × E3) × (E3 × E3) ↦ q.2.2) h
  change ζ.1.1 = ω.1.1 at h₁
  change ζ.1.2 = ω.1.2 at h₂
  change ζ.2 = ω.2 at h₃
  exact Prod.ext (Prod.ext h₁ h₂) h₃

/-- The Schwartz factor in the source's frequency representation, before
the bounded multiplier is inserted. -/
noncomputable def frequencyKernel
    (f₀ f₁ f₂ f₃ : Schwartz3) : SchwartzMap Frequency9 ℂ :=
  schwartzAffinePullbackOfInjective (𝕜 := ℂ) frequencyPackaging
    frequencyPackaging_injective 0
    (schwartzExternalProduct
      (schwartzExternalProduct (schwartzFourier f₀) (schwartzFourier f₁))
      (schwartzExternalProduct (schwartzFourier f₂) (schwartzFourier f₃)))

@[simp]
theorem frequencyKernel_apply
    (f₀ f₁ f₂ f₃ : Schwartz3) (ζ : Frequency9) :
    frequencyKernel f₀ f₁ f₂ f₃ ζ =
      (schwartzFourier f₀) (-(ζ.1.1 + ζ.1.2 + ζ.2)) *
        (schwartzFourier f₁ ζ.1.1 *
          ((schwartzFourier f₂ ζ.1.2) * schwartzFourier f₃ ζ.2)) := by
  simp [frequencyKernel, schwartzAffinePullbackOfInjective]
  ring

/-- A Euclidean six-dimensional carrier for the six non-diagonal frequency
coordinates. -/
abbrev FrequencyRemainder := WithLp 2 (E3 × E3)

/-- The nine frequency coordinates arranged as `(η, remainder)`.  This is an
honest Euclidean space; the map below records its measure-preserving
identification with the nested source product carrier. -/
abbrev FrequencySplit9 := WithLp 2 (E3 × FrequencyRemainder)

abbrev FrequencyEuclidean9 := EuclideanSpace ℝ (Fin 9)
abbrev FrequencyHilbert9 := WithLp 2 (FrequencyRemainder × E3)

noncomputable def frequencySplit6Hilbert :
    WithLp 2 (Fin 3 ⊕ Fin 3 → ℝ) ≃ₗᵢ[ℝ] FrequencyRemainder :=
  PiLp.sumPiLpEquivProdLpPiLp 2 (fun _ : Fin 3 ⊕ Fin 3 => ℝ)

/-- The standard grouping of nine scalar coordinates into the three source
frequency vectors. -/
noncomputable def frequencyIndexGrouping :
    Fin 9 ≃ Fin 3 ⊕ (Fin 3 ⊕ Fin 3) :=
  (finSumFinEquiv (m := 3) (n := 6)).symm.trans
    (Equiv.sumCongr (Equiv.refl _) (finSumFinEquiv (m := 3) (n := 3)).symm)

/-- The coordinate permutation which puts the three diagonal frequency
coordinates first.  Its explicit inverse makes the subsequent coordinate
calculation reducible. -/
def frequencyIndexPermutation : Fin 9 ≃ Fin 9 where
  toFun i :=
    match i.1 with
    | 0 => 3
    | 1 => 7
    | 2 => 2
    | 3 => 4
    | 4 => 5
    | 5 => 6
    | 6 => 8
    | 7 => 0
    | _ => 1
  invFun i :=
    match i.1 with
    | 0 => 7
    | 1 => 8
    | 2 => 2
    | 3 => 0
    | 4 => 3
    | 5 => 4
    | 6 => 5
    | 7 => 1
    | _ => 6
  left_inv := by intro i; fin_cases i <;> rfl
  right_inv := by intro i; fin_cases i <;> rfl

/-- Regroup scalar coordinates as three Euclidean vectors, with the third
source vector placed last. -/
noncomputable def frequencyEuclideanToHilbert :
    FrequencyEuclidean9 ≃ₗᵢ[ℝ] FrequencyHilbert9 :=
  (LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ frequencyIndexGrouping).trans
    ((PiLp.sumPiLpEquivProdLpPiLp 2
      (fun _ : Fin 3 ⊕ (Fin 3 ⊕ Fin 3) => ℝ)).trans
      ((LinearIsometryEquiv.withLpProdCongr 2
        (LinearIsometryEquiv.refl ℝ E3)
        (PiLp.sumPiLpEquivProdLpPiLp 2 (fun _ : Fin 3 ⊕ Fin 3 => ℝ))).trans
          (LinearIsometryEquiv.withLpProdComm 2 ℝ E3 FrequencyRemainder)))

/-- Flatten the diagonal/remainder Hilbert product to nine scalar coordinates. -/
noncomputable def frequencySplitToEuclidean :
    FrequencySplit9 ≃ₗᵢ[ℝ] FrequencyEuclidean9 :=
  (LinearIsometryEquiv.withLpProdCongr 2 (LinearIsometryEquiv.refl ℝ E3)
    frequencySplit6Hilbert.symm).trans
      ((PiLp.sumPiLpEquivProdLpPiLp 2
        (fun _ : Fin 3 ⊕ (Fin 3 ⊕ Fin 3) => ℝ)).symm.trans
          (LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ frequencyIndexGrouping.symm))

noncomputable def frequencyHilbertReassembly :
    FrequencyEuclidean9 ≃ₗᵢ[ℝ] FrequencyHilbert9 :=
  (LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ frequencyIndexPermutation).trans
    frequencyEuclideanToHilbert

/-- The measurable-equivalence form of the source's nested product
coordinates. -/
noncomputable def frequencyRawEquiv : FrequencyHilbert9 ≃ᵐ Frequency9 :=
  (MeasurableEquiv.toLp 2 (FrequencyRemainder × E3)).symm.trans
    (MeasurableEquiv.prodCongr
      (MeasurableEquiv.toLp 2 (E3 × E3)).symm (MeasurableEquiv.refl E3))

noncomputable def frequencyRawCLE : FrequencyHilbert9 ≃L[ℝ] Frequency9 :=
  (WithLp.prodContinuousLinearEquiv 2 ℝ FrequencyRemainder E3).trans
    (ContinuousLinearEquiv.prodCongr
      (WithLp.prodContinuousLinearEquiv 2 ℝ E3 E3)
      (ContinuousLinearEquiv.refl ℝ E3))

/-- The explicit measure-preserving coordinate reassembly from
`(η, six remaining coordinates)` to the three source frequency vectors. -/
noncomputable def frequencyReassembly : (E3 × FrequencyRemainder) ≃L[ℝ] Frequency9 :=
  (WithLp.prodContinuousLinearEquiv 2 ℝ E3 FrequencyRemainder).symm.trans
    ((frequencySplitToEuclidean.toContinuousLinearEquiv.trans
      frequencyHilbertReassembly.toContinuousLinearEquiv).trans frequencyRawCLE)

noncomputable def frequencyAssemble3 (a b c : ℝ) : E3 :=
  WithLp.toLp 2 ![a, b, c]

@[simp]
theorem frequencyAssemble3_apply (a b c : ℝ) (i : Fin 3) :
    frequencyAssemble3 a b c i = ![a, b, c] i := rfl

@[simp]
theorem frequencyReassembly_apply (η : E3) (r : FrequencyRemainder) :
    frequencyReassembly (η, r) =
      ((frequencyAssemble3 (η 0) (r.fst 0) (r.fst 1),
        frequencyAssemble3 (r.fst 2) (η 1) (r.snd 0)),
        frequencyAssemble3 (r.snd 1) (r.snd 2) (η 2)) := by
  apply Prod.ext
  · apply Prod.ext
    · ext i
      fin_cases i <;> rfl
    · ext i
      fin_cases i <;> rfl
  · ext i
    fin_cases i <;> rfl

theorem frequencyRawEquiv_measurePreserving :
    MeasurePreserving frequencyRawEquiv volume volume := by
  exact (WithLp.volume_preserving_symm_measurableEquiv_toLp_prod FrequencyRemainder E3).trans
    (MeasurePreserving.prod
      (WithLp.volume_preserving_symm_measurableEquiv_toLp_prod E3 E3)
      (MeasurePreserving.id volume))

/-- This verifies the blueprint's product-coordinate convention for the
specific diagonal/remainder ordering used in the frequency proof. -/
theorem frequencyReassembly_measurePreserving :
    MeasurePreserving frequencyReassembly volume volume := by
  have h1 : MeasurePreserving (WithLp.toLp 2)
      (volume : Measure (E3 × FrequencyRemainder))
      (volume : Measure FrequencySplit9) :=
    WithLp.volume_preserving_toLp (U := E3) (V := FrequencyRemainder)
  have h2 : MeasurePreserving frequencySplitToEuclidean
      (volume : Measure FrequencySplit9) (volume : Measure FrequencyEuclidean9) :=
    frequencySplitToEuclidean.measurePreserving
  have h3 : MeasurePreserving frequencyHilbertReassembly
      (volume : Measure FrequencyEuclidean9) (volume : Measure FrequencyHilbert9) :=
    frequencyHilbertReassembly.measurePreserving
  have h4 : MeasurePreserving frequencyRawEquiv
      (volume : Measure FrequencyHilbert9) (volume : Measure Frequency9) :=
    frequencyRawEquiv_measurePreserving
  have h := h4.comp (h3.comp (h2.comp h1))
  convert h using 1
  ext z <;> rfl

@[simp]
theorem frequencyDiagonal_reassembly (η : E3) (r : FrequencyRemainder) :
    frequencyDiagonal (frequencyReassembly (η, r)) = η := by
  ext i
  fin_cases i <;>
    simp [frequencyDiagonal_apply, frequencyReassembly_apply,
      frequencyAssemble3_apply, coordinateDirection_apply]

local instance : (volume : Measure (E3 × FrequencyRemainder)).IsAddHaarMeasure :=
  Measure.prod.instIsAddHaarMeasure volume volume

/-- The source frequency kernel expressed in diagonal/remainder coordinates. -/
noncomputable def frequencyKernelJoint
    (f₀ f₁ f₂ f₃ : Schwartz3) :
    SchwartzMap (E3 × FrequencyRemainder) ℂ :=
  schwartzAffinePullbackOfInjective (𝕜 := ℂ)
    frequencyReassembly.toContinuousLinearMap frequencyReassembly.injective 0
    (frequencyKernel f₀ f₁ f₂ f₃)

@[simp]
theorem frequencyKernelJoint_apply
    (f₀ f₁ f₂ f₃ : Schwartz3) (η : E3) (r : FrequencyRemainder) :
    frequencyKernelJoint f₀ f₁ f₂ f₃ (η, r) =
      frequencyKernel f₀ f₁ f₂ f₃ (frequencyReassembly (η, r)) := by
  simp [frequencyKernelJoint, schwartzAffinePullbackOfInjective]

/-- Integrating the six non-diagonal frequency coordinates gives the
Fourier transform of the translated product. -/
noncomputable def frequencyFiber
    (f₀ f₁ f₂ f₃ : Schwartz3) : Schwartz3 :=
  schwartzFiberIntegralMap (μ := volume) (frequencyKernelJoint f₀ f₁ f₂ f₃)

@[simp]
theorem frequencyFiber_apply
    (f₀ f₁ f₂ f₃ : Schwartz3) (η : E3) :
    frequencyFiber f₀ f₁ f₂ f₃ η =
      ∫ r : FrequencyRemainder, frequencyKernelJoint f₀ f₁ f₂ f₃ (η, r) := rfl

@[simp]
theorem inner_coordinateDirection_left (i : Fin 3) (x : E3) :
    ⟪Anisotropy.coordinateDirection i, x⟫ = x i := by
  simp [Anisotropy.coordinateDirection, EuclideanSpace.inner_single_left]

@[simp]
theorem inner_coordinateDirection_right (x : E3) (i : Fin 3) :
    ⟪x, Anisotropy.coordinateDirection i⟫ = x i := by
  rw [real_inner_comm]
  exact inner_coordinateDirection_left i x

theorem inner_frequencyDiagonal (ζ : Frequency9) (t : E3) :
    ⟪frequencyDiagonal ζ, t⟫ =
      ζ.1.1 0 * t 0 + ζ.1.2 1 * t 1 + ζ.2 2 * t 2 := by
  rw [frequencyDiagonal_apply]
  simp [inner_add_left, inner_smul_left]

/-- The scalar Fourier character, written as a complex number for the
product/Fubini calculation. -/
noncomputable def frequencyPhase (x y : E3) : ℂ :=
  (𝐞 ⟪x, y⟫ : Circle)

@[simp]
theorem norm_frequencyPhase (x y : E3) : ‖frequencyPhase x y‖ = 1 := by
  simp [frequencyPhase, Circle.norm_coe]

theorem frequency_phase_scalar_identity (x t : E3) (ζ : Frequency9) :
    ⟪frequencyDiagonal ζ, t⟫ + ⟪x, ζ.1.1 + ζ.1.2 + ζ.2⟫ =
      ⟪ζ.1.1, x + t 0 • Anisotropy.coordinateDirection 0⟫ +
        (⟪ζ.1.2, x + t 1 • Anisotropy.coordinateDirection 1⟫ +
          ⟪ζ.2, x + t 2 • Anisotropy.coordinateDirection 2⟫) := by
  rw [inner_frequencyDiagonal]
  simp [inner_add_right, inner_smul_right]
  rw [real_inner_comm x ζ.1.1, real_inner_comm x ζ.1.2, real_inner_comm x ζ.2]
  ring

theorem frequency_phase_factorization (x t : E3) (ζ : Frequency9) :
    frequencyPhase (frequencyDiagonal ζ) t *
        frequencyPhase x (ζ.1.1 + ζ.1.2 + ζ.2) =
      frequencyPhase ζ.1.1 (x + t 0 • Anisotropy.coordinateDirection 0) *
        (frequencyPhase ζ.1.2 (x + t 1 • Anisotropy.coordinateDirection 1) *
          frequencyPhase ζ.2 (x + t 2 • Anisotropy.coordinateDirection 2)) := by
  simp only [frequencyPhase]
  rw [← Circle.coe_mul, ← Circle.coe_mul, ← Circle.coe_mul]
  apply congrArg (fun q : Circle ↦ (q : ℂ))
  rw [← AddChar.map_add_eq_mul, frequency_phase_scalar_identity,
    AddChar.map_add_eq_mul, AddChar.map_add_eq_mul]

theorem inverseFourier_schwartzFourier_apply (f : Schwartz3) (x : E3) :
    ∫ ζ : E3, frequencyPhase ζ x * schwartzFourier f ζ = f x := by
  have h := congrArg (fun g : Schwartz3 ↦ g x) (schwartzFourierInv_fourier f)
  rw [schwartzFourierInv, SchwartzMap.fourierInv_coe, Real.fourierInv_eq] at h
  simpa [frequencyPhase, Circle.smul_def] using h

theorem schwartzFourier_neg_apply (f : Schwartz3) (s : E3) :
    schwartzFourier f (-s) = ∫ x : E3, frequencyPhase x s * f x := by
  rw [schwartzFourier, SchwartzMap.fourier_coe, Real.fourier_eq]
  apply integral_congr_ae
  filter_upwards with x
  simp [frequencyPhase, Circle.smul_def, inner_neg_right]

theorem frequency_three_inverse_integral
    (f₁ f₂ f₃ : Schwartz3) (x t : E3) :
    ∫ ζ : Frequency9,
      (frequencyPhase (frequencyDiagonal ζ) t *
        frequencyPhase x (ζ.1.1 + ζ.1.2 + ζ.2)) *
          (schwartzFourier f₁ ζ.1.1 *
            (schwartzFourier f₂ ζ.1.2 * schwartzFourier f₃ ζ.2)) =
      f₁ (x + t 0 • Anisotropy.coordinateDirection 0) *
        (f₂ (x + t 1 • Anisotropy.coordinateDirection 1) *
          f₃ (x + t 2 • Anisotropy.coordinateDirection 2)) := by
  calc
    ∫ ζ : Frequency9,
        (frequencyPhase (frequencyDiagonal ζ) t *
          frequencyPhase x (ζ.1.1 + ζ.1.2 + ζ.2)) *
            (schwartzFourier f₁ ζ.1.1 *
              (schwartzFourier f₂ ζ.1.2 * schwartzFourier f₃ ζ.2)) =
        ∫ ζ : Frequency9,
          (frequencyPhase ζ.1.1 (x + t 0 • Anisotropy.coordinateDirection 0) *
            schwartzFourier f₁ ζ.1.1) *
              ((frequencyPhase ζ.1.2 (x + t 1 • Anisotropy.coordinateDirection 1) *
                schwartzFourier f₂ ζ.1.2) *
                  (frequencyPhase ζ.2 (x + t 2 • Anisotropy.coordinateDirection 2) *
                    schwartzFourier f₃ ζ.2)) := by
          apply integral_congr_ae
          filter_upwards with ζ
          rw [frequency_phase_factorization]
          ring
    _ =
        (∫ ζ₁ : E3,
          frequencyPhase ζ₁ (x + t 0 • Anisotropy.coordinateDirection 0) *
            schwartzFourier f₁ ζ₁) *
          ((∫ ζ₂ : E3,
            frequencyPhase ζ₂ (x + t 1 • Anisotropy.coordinateDirection 1) *
              schwartzFourier f₂ ζ₂) *
            ∫ ζ₃ : E3,
              frequencyPhase ζ₃ (x + t 2 • Anisotropy.coordinateDirection 2) *
                schwartzFourier f₃ ζ₃) := by
          let A : E3 → ℂ := fun ζ₁ ↦
            frequencyPhase ζ₁ (x + t 0 • Anisotropy.coordinateDirection 0) *
              schwartzFourier f₁ ζ₁
          let B : E3 → ℂ := fun ζ₂ ↦
            frequencyPhase ζ₂ (x + t 1 • Anisotropy.coordinateDirection 1) *
              schwartzFourier f₂ ζ₂
          let C : E3 → ℂ := fun ζ₃ ↦
            frequencyPhase ζ₃ (x + t 2 • Anisotropy.coordinateDirection 2) *
              schwartzFourier f₃ ζ₃
          rw [show (volume : Measure Frequency9) =
            (volume : Measure (E3 × E3)).prod (volume : Measure E3) from
              Measure.volume_eq_prod (E3 × E3) E3]
          change
            ∫ ζ : (E3 × E3) × E3, A ζ.1.1 * (B ζ.1.2 * C ζ.2)
              ∂((volume : Measure (E3 × E3)).prod (volume : Measure E3)) =
              (∫ ζ₁ : E3, A ζ₁) * ((∫ ζ₂ : E3, B ζ₂) * ∫ ζ₃ : E3, C ζ₃)
          calc
            ∫ ζ : (E3 × E3) × E3, A ζ.1.1 * (B ζ.1.2 * C ζ.2)
                ∂((volume : Measure (E3 × E3)).prod (volume : Measure E3)) =
                ∫ ζ : (E3 × E3) × E3, (A ζ.1.1 * B ζ.1.2) * C ζ.2
                  ∂((volume : Measure (E3 × E3)).prod (volume : Measure E3)) := by
              apply integral_congr_ae
              filter_upwards with ζ
              ring
            _ = (∫ p : E3 × E3, A p.1 * B p.2) * ∫ ζ₃ : E3, C ζ₃ :=
              integral_prod_mul (μ := (volume : Measure (E3 × E3)))
                (ν := (volume : Measure E3)) (fun p ↦ A p.1 * B p.2) C
            _ = (∫ ζ₁ : E3, A ζ₁) * ((∫ ζ₂ : E3, B ζ₂) * ∫ ζ₃ : E3, C ζ₃) := by
              rw [show (volume : Measure (E3 × E3)) =
                (volume : Measure E3).prod (volume : Measure E3) from
                  Measure.volume_eq_prod E3 E3]
              rw [integral_prod_mul (μ := (volume : Measure E3))
                (ν := (volume : Measure E3)) A B]
              ring
    _ =
        f₁ (x + t 0 • Anisotropy.coordinateDirection 0) *
          (f₂ (x + t 1 • Anisotropy.coordinateDirection 1) *
            f₃ (x + t 2 • Anisotropy.coordinateDirection 2)) := by
          rw [inverseFourier_schwartzFourier_apply,
            inverseFourier_schwartzFourier_apply,
            inverseFourier_schwartzFourier_apply]

/-- Reassembling the diagonal and off-diagonal coordinates converts the
inverse Fourier transform of the frequency fiber into the full source
frequency integral. -/
theorem schwartzFourierInv_frequencyFiber_apply
    (f₀ f₁ f₂ f₃ : Schwartz3) (t : E3) :
    schwartzFourierInv (frequencyFiber f₀ f₁ f₂ f₃) t =
      ∫ ζ : Frequency9,
        frequencyPhase (frequencyDiagonal ζ) t * frequencyKernel f₀ f₁ f₂ f₃ ζ := by
  letI : (volume : Measure (E3 × E3)).IsAddHaarMeasure :=
    Measure.prod.instIsAddHaarMeasure volume volume
  letI : (volume : Measure Frequency9).IsAddHaarMeasure :=
    Measure.prod.instIsAddHaarMeasure (volume : Measure (E3 × E3)) volume
  let g : Frequency9 → ℂ := fun ζ ↦
    frequencyPhase (frequencyDiagonal ζ) t * frequencyKernel f₀ f₁ f₂ f₃ ζ
  have hphase : Continuous (fun ζ : Frequency9 ↦
      frequencyPhase (frequencyDiagonal ζ) t) := by
    unfold frequencyPhase
    exact continuous_subtype_val.comp
      (Real.continuous_fourierChar.comp
        (continuous_inner.comp (frequencyDiagonal.continuous.prodMk continuous_const)))
  have hg : Integrable g (volume : Measure Frequency9) := by
    exact (frequencyKernel f₀ f₁ f₂ f₃).integrable.bdd_mul
      (c := 1) hphase.aestronglyMeasurable
      (Filter.Eventually.of_forall fun ζ ↦ by simp)
  have hpull : Integrable (g ∘ frequencyReassembly) :=
    frequencyReassembly_measurePreserving.integrable_comp_of_integrable hg
  have hjoint : Integrable (fun q : E3 × FrequencyRemainder ↦
      frequencyPhase q.1 t * frequencyKernelJoint f₀ f₁ f₂ f₃ q) := by
    convert hpull using 1
    ext q
    rcases q with ⟨η, r⟩
    change frequencyPhase η t * frequencyKernelJoint f₀ f₁ f₂ f₃ (η, r) =
      frequencyPhase (frequencyDiagonal (frequencyReassembly (η, r))) t *
        frequencyKernel f₀ f₁ f₂ f₃ (frequencyReassembly (η, r))
    rw [frequencyDiagonal_reassembly, ← frequencyKernelJoint_apply]
  calc
    schwartzFourierInv (frequencyFiber f₀ f₁ f₂ f₃) t =
        ∫ η : E3, frequencyPhase η t * frequencyFiber f₀ f₁ f₂ f₃ η := by
      rw [schwartzFourierInv, SchwartzMap.fourierInv_coe, Real.fourierInv_eq]
      apply integral_congr_ae
      filter_upwards with η
      simp [frequencyPhase, Circle.smul_def]
    _ = ∫ η : E3, ∫ r : FrequencyRemainder,
        frequencyPhase η t * frequencyKernelJoint f₀ f₁ f₂ f₃ (η, r) := by
      apply integral_congr_ae
      filter_upwards with η
      rw [frequencyFiber_apply, ← integral_const_mul]
    _ = ∫ q : E3 × FrequencyRemainder,
        frequencyPhase q.1 t * frequencyKernelJoint f₀ f₁ f₂ f₃ q := by
      rw [Measure.volume_eq_prod]
      exact (integral_prod _ hjoint).symm
    _ = ∫ q : E3 × FrequencyRemainder, g (frequencyReassembly q) := by
      apply integral_congr_ae
      filter_upwards with q
      rcases q with ⟨η, r⟩
      change frequencyPhase η t * frequencyKernelJoint f₀ f₁ f₂ f₃ (η, r) =
        frequencyPhase (frequencyDiagonal (frequencyReassembly (η, r))) t *
          frequencyKernel f₀ f₁ f₂ f₃ (frequencyReassembly (η, r))
      rw [frequencyDiagonal_reassembly, ← frequencyKernelJoint_apply]
    _ = ∫ ζ : Frequency9, g ζ :=
      frequencyReassembly_measurePreserving.integral_comp
        frequencyReassembly.toHomeomorph.measurableEmbedding g
    _ = ∫ ζ : Frequency9,
        frequencyPhase (frequencyDiagonal ζ) t * frequencyKernel f₀ f₁ f₂ f₃ ζ := rfl

/-- The full source frequency integral is the translated product.  The only
interchange of integrations is justified by the displayed product majorant
`‖H(ζ)‖ ‖f₀(x)‖`. -/
theorem frequencyKernel_phase_integral_eq_twistedProduct
    (f₀ f₁ f₂ f₃ : Schwartz3) (t : E3) :
    (∫ ζ : Frequency9,
      frequencyPhase (frequencyDiagonal ζ) t * frequencyKernel f₀ f₁ f₂ f₃ ζ) =
      twistedProduct f₀ f₁ f₂ f₃ t := by
  letI : (volume : Measure (E3 × E3)).IsAddHaarMeasure :=
    Measure.prod.instIsAddHaarMeasure volume volume
  letI : (volume : Measure Frequency9).IsAddHaarMeasure :=
    Measure.prod.instIsAddHaarMeasure (volume : Measure (E3 × E3)) volume
  let H : Frequency9 → ℂ := fun ζ ↦
    ((schwartzFourier f₁ ζ.1.1 * schwartzFourier f₂ ζ.1.2) *
      schwartzFourier f₃ ζ.2)
  let Q : Frequency9 → E3 → ℂ := fun ζ x ↦
    (frequencyPhase (frequencyDiagonal ζ) t *
      (frequencyPhase x (ζ.1.1 + ζ.1.2 + ζ.2) * f₀ x)) * H ζ
  have h12 : Integrable (fun z : E3 × E3 ↦
      schwartzFourier f₁ z.1 * schwartzFourier f₂ z.2) :=
    (schwartzFourier f₁).integrable.mul_prod (schwartzFourier f₂).integrable
  have hH : Integrable H := h12.mul_prod (schwartzFourier f₃).integrable
  have hdom : Integrable (fun p : Frequency9 × E3 ↦ ‖H p.1‖ * ‖f₀ p.2‖) :=
    hH.norm.mul_prod f₀.integrable.norm
  have hQcont : Continuous (Function.uncurry Q) := by
    dsimp [Q, H]
    unfold frequencyPhase
    fun_prop
  have hQ : Integrable (Function.uncurry Q) := by
    refine Integrable.mono hdom hQcont.aestronglyMeasurable
      (Filter.Eventually.of_forall ?_)
    rintro ⟨ζ, x⟩
    dsimp [Q, H]
    simp [norm_frequencyPhase]
    ring_nf
    exact le_rfl
  calc
    (∫ ζ : Frequency9,
      frequencyPhase (frequencyDiagonal ζ) t * frequencyKernel f₀ f₁ f₂ f₃ ζ) =
        ∫ ζ : Frequency9, ∫ x : E3, Q ζ x := by
      apply integral_congr_ae
      filter_upwards with ζ
      rw [frequencyKernel_apply, schwartzFourier_neg_apply]
      rw [← integral_mul_const, ← integral_const_mul]
      apply integral_congr_ae
      filter_upwards with x
      dsimp [Q, H]
      ring
    _ = ∫ x : E3, ∫ ζ : Frequency9, Q ζ x :=
      integral_integral_swap hQ
    _ = ∫ x : E3,
        (f₀ x * f₁ (x + t 0 • Anisotropy.coordinateDirection 0)) *
          (f₂ (x + t 1 • Anisotropy.coordinateDirection 1) *
            f₃ (x + t 2 • Anisotropy.coordinateDirection 2)) := by
      apply integral_congr_ae
      filter_upwards with x
      calc
        (∫ ζ : Frequency9, Q ζ x) =
            ∫ ζ : Frequency9,
              f₀ x *
                ((frequencyPhase (frequencyDiagonal ζ) t *
                  frequencyPhase x (ζ.1.1 + ζ.1.2 + ζ.2)) *
                  (schwartzFourier f₁ ζ.1.1 *
                    (schwartzFourier f₂ ζ.1.2 * schwartzFourier f₃ ζ.2))) := by
              apply integral_congr_ae
              filter_upwards with ζ
              dsimp [Q, H]
              ring
        _ = f₀ x * ∫ ζ : Frequency9,
              (frequencyPhase (frequencyDiagonal ζ) t *
                frequencyPhase x (ζ.1.1 + ζ.1.2 + ζ.2)) *
                (schwartzFourier f₁ ζ.1.1 *
                  (schwartzFourier f₂ ζ.1.2 * schwartzFourier f₃ ζ.2)) := by
              rw [integral_const_mul]
        _ = f₀ x *
            (f₁ (x + t 0 • Anisotropy.coordinateDirection 0) *
              (f₂ (x + t 1 • Anisotropy.coordinateDirection 1) *
                f₃ (x + t 2 • Anisotropy.coordinateDirection 2))) := by
              rw [frequency_three_inverse_integral]
        _ =
            (f₀ x * f₁ (x + t 0 • Anisotropy.coordinateDirection 0)) *
              (f₂ (x + t 1 • Anisotropy.coordinateDirection 1) *
                f₃ (x + t 2 • Anisotropy.coordinateDirection 2)) := by
              ring
    _ = twistedProduct f₀ f₁ f₂ f₃ t := (twistedProduct_apply f₀ f₁ f₂ f₃ t).symm

/-- The fiber constructed from the source frequency kernel is precisely the
Fourier transform of the translated product. -/
theorem twistedProduct_eq_schwartzFourierInv_frequencyFiber
    (f₀ f₁ f₂ f₃ : Schwartz3) :
    twistedProduct f₀ f₁ f₂ f₃ =
      schwartzFourierInv (frequencyFiber f₀ f₁ f₂ f₃) := by
  ext t
  rw [schwartzFourierInv_frequencyFiber_apply,
    frequencyKernel_phase_integral_eq_twistedProduct]

theorem schwartzFourier_twistedProduct_eq_frequencyFiber
    (f₀ f₁ f₂ f₃ : Schwartz3) :
    schwartzFourier (twistedProduct f₀ f₁ f₂ f₃) =
      frequencyFiber f₀ f₁ f₂ f₃ := by
  rw [twistedProduct_eq_schwartzFourierInv_frequencyFiber,
    schwartzFourier_fourierInv]

/-- The right-hand side of the source frequency formula. -/
noncomputable def frequencyForm
    (m : E3 → ℂ) (f₀ f₁ f₂ f₃ : Schwartz3) : ℂ :=
  ∫ ζ : Frequency9, m (-frequencyDiagonal ζ) * frequencyKernel f₀ f₁ f₂ f₃ ζ
    ∂frequencyMeasure

/-- Absolute convergence of the source frequency-side integrand. -/
theorem frequencyForm_integrable
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (f₀ f₁ f₂ f₃ : Schwartz3) :
    Integrable (fun ζ : Frequency9 ↦
      m (-frequencyDiagonal ζ) * frequencyKernel f₀ f₁ f₂ f₃ ζ) frequencyMeasure := by
  rw [frequencyMeasure_eq_volume]
  letI : (volume : Measure (E3 × E3)).IsAddHaarMeasure :=
    Measure.prod.instIsAddHaarMeasure volume volume
  letI : (volume : Measure Frequency9).IsAddHaarMeasure :=
    Measure.prod.instIsAddHaarMeasure (volume : Measure (E3 × E3)) volume
  let F : SchwartzMap Frequency9 ℂ := frequencyKernel f₀ f₁ f₂ f₃
  have hFint : Integrable F (volume : Measure Frequency9) := F.integrable
  have hFmeas : AEStronglyMeasurable F volume := F.continuous.aestronglyMeasurable
  have hmmeas : AEStronglyMeasurable (fun ζ : Frequency9 ↦ m (-frequencyDiagonal ζ)) volume :=
    (hm.measurable.comp
      ((continuous_neg.comp frequencyDiagonal.continuous).measurable)).aestronglyMeasurable
  have hmeas : AEStronglyMeasurable
      (fun ζ : Frequency9 ↦ m (-frequencyDiagonal ζ) * F ζ) volume :=
    hmmeas.mul hFmeas
  have hbound : ∀ ζ : Frequency9,
      ‖m (-frequencyDiagonal ζ) * F ζ‖ ≤ M * ‖F ζ‖ := by
    intro ζ
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (hm.norm_le_all _) (norm_nonneg _)
  exact Integrable.mono' (hFint.norm.const_mul M) hmeas
    (Filter.Eventually.of_forall hbound)

/-- Fubini after the explicit coordinate reassembly identifies the source
frequency integral with the diagonal-frequency fiber integral. -/
theorem frequencyForm_eq_fiberIntegral
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (f₀ f₁ f₂ f₃ : Schwartz3) :
    frequencyForm m f₀ f₁ f₂ f₃ =
      ∫ η : E3, m (-η) * frequencyFiber f₀ f₁ f₂ f₃ η := by
  let g : Frequency9 → ℂ := fun ζ ↦
    m (-frequencyDiagonal ζ) * frequencyKernel f₀ f₁ f₂ f₃ ζ
  have hg : Integrable g (volume : Measure Frequency9) := by
    simpa only [g, frequencyMeasure_eq_volume] using
      frequencyForm_integrable α M m hm f₀ f₁ f₂ f₃
  have hpull : Integrable (g ∘ frequencyReassembly) :=
    frequencyReassembly_measurePreserving.integrable_comp_of_integrable hg
  have hjoint : Integrable (fun q : E3 × FrequencyRemainder ↦
      m (-q.1) * frequencyKernelJoint f₀ f₁ f₂ f₃ q) := by
    convert hpull using 1
    ext q
    rcases q with ⟨η, r⟩
    change m (-η) * frequencyKernelJoint f₀ f₁ f₂ f₃ (η, r) =
      m (-frequencyDiagonal (frequencyReassembly (η, r))) *
        frequencyKernel f₀ f₁ f₂ f₃ (frequencyReassembly (η, r))
    rw [frequencyDiagonal_reassembly, ← frequencyKernelJoint_apply]
  calc
    frequencyForm m f₀ f₁ f₂ f₃ = ∫ ζ : Frequency9, g ζ := by
      simp [frequencyForm, g, frequencyMeasure_eq_volume]
    _ = ∫ q : E3 × FrequencyRemainder, g (frequencyReassembly q) :=
      (frequencyReassembly_measurePreserving.integral_comp
        frequencyReassembly.toHomeomorph.measurableEmbedding g).symm
    _ = ∫ q : E3 × FrequencyRemainder,
        m (-q.1) * frequencyKernelJoint f₀ f₁ f₂ f₃ q := by
      apply integral_congr_ae
      filter_upwards with q
      rcases q with ⟨η, r⟩
      change m (-frequencyDiagonal (frequencyReassembly (η, r))) *
          frequencyKernel f₀ f₁ f₂ f₃ (frequencyReassembly (η, r)) =
        m (-η) * frequencyKernelJoint f₀ f₁ f₂ f₃ (η, r)
      rw [frequencyDiagonal_reassembly, ← frequencyKernelJoint_apply]
    _ = ∫ η : E3, ∫ r : FrequencyRemainder,
        m (-η) * frequencyKernelJoint f₀ f₁ f₂ f₃ (η, r) := by
      rw [Measure.volume_eq_prod]
      exact integral_prod _ hjoint
    _ = ∫ η : E3, m (-η) * frequencyFiber f₀ f₁ f₂ f₃ η := by
      apply integral_congr_ae
      filter_upwards with η
      rw [frequencyFiber_apply, integral_const_mul]

/-- The two absolutely convergent formulas in `lem:pairing` agree. -/
theorem multiplierForm_eq_frequencyForm
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (f₀ f₁ f₂ f₃ : Schwartz3) :
    multiplierForm m f₀ f₁ f₂ f₃ = frequencyForm m f₀ f₁ f₂ f₃ := by
  let g : E3 → ℂ := fun ξ ↦
    m ξ * frequencyFiber f₀ f₁ f₂ f₃ (-ξ)
  have hneg : MeasurePreserving (fun ξ : E3 ↦ -ξ) volume volume :=
    Measure.measurePreserving_neg (volume : Measure E3)
  calc
    multiplierForm m f₀ f₁ f₂ f₃ = ∫ ξ : E3, g ξ := by
      unfold multiplierForm
      apply integral_congr_ae
      filter_upwards with ξ
      rw [schwartzFourier_twistedProduct_eq_frequencyFiber]
    _ = ∫ η : E3, g (-η) := by
      symm
      exact hneg.integral_comp (Homeomorph.neg E3).measurableEmbedding g
    _ = ∫ η : E3, m (-η) * frequencyFiber f₀ f₁ f₂ f₃ η := by
      apply integral_congr_ae
      filter_upwards with η
      simp [g]
    _ = frequencyForm m f₀ f₁ f₂ f₃ :=
      (frequencyForm_eq_fiberIntegral α M m hm f₀ f₁ f₂ f₃).symm

/-- The multiplier-form integrand is absolutely integrable.  This is the
analytic well-definedness assertion in Lemma `lem:pairing`; its only use of
the symbol hypothesis is the order-zero uniform bound. -/
theorem multiplierForm_integrable
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (f₀ f₁ f₂ f₃ : Schwartz3) :
    Integrable (fun ξ : E3 ↦
      m ξ * schwartzFourier (twistedProduct f₀ f₁ f₂ f₃) (-ξ)) := by
  let P : Schwartz3 := twistedProduct f₀ f₁ f₂ f₃
  let Q : Schwartz3 := schwartzNegate (schwartzFourier P)
  have hQint : Integrable Q := Q.integrable
  have hQmeas : AEStronglyMeasurable Q volume := Q.continuous.aestronglyMeasurable
  have hmmeas : AEStronglyMeasurable m volume := hm.measurable.aestronglyMeasurable
  have hmeas : AEStronglyMeasurable (fun ξ : E3 ↦ m ξ * Q ξ) volume :=
    hmmeas.mul hQmeas
  have hbound : ∀ ξ : E3, ‖m ξ * Q ξ‖ ≤ M * ‖Q ξ‖ := by
    intro ξ
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (hm.norm_le_all ξ) (norm_nonneg _)
  have hint : Integrable (fun ξ : E3 ↦ m ξ * Q ξ) :=
    Integrable.mono' (hQint.norm.const_mul M) hmeas
      (Filter.Eventually.of_forall hbound)
  simpa only [P, Q, schwartzNegate_apply] using hint

/-! ## Fixed Gaussian and comparison kernels

This begins the source's fixed-kernel block (`def:gaussian`).  The exact
Gaussian normalization is retained, rather than replacing it by an abstract
Schwartz cutoff, because the later Calderón identity uses its Fourier-side
normalization. -/

/-- The one-dimensional Gaussian `\(\mathsf g(x)=e^{-\pi x^2}\)`. -/
noncomputable def gaussian (x : ℝ) : ℝ := Real.exp (-Real.pi * x ^ 2)

/-- Its source-normalized derivative
`\(\mathsf h(x)=-2\pi x\mathsf g(x)\)`. -/
noncomputable def gaussianDeriv (x : ℝ) : ℝ :=
  -2 * Real.pi * x * gaussian x

/-- The positive comparison kernel `\(\theta(x)=(1+|x|)^{-10}\)`. -/
noncomputable def bracketKernel (x : ℝ) : ℝ := (1 + |x|) ^ (-10 : ℤ)

@[simp]
theorem gaussian_pos (x : ℝ) : 0 < gaussian x := by
  exact Real.exp_pos _

@[simp]
theorem gaussian_nonneg (x : ℝ) : 0 ≤ gaussian x := (gaussian_pos x).le

theorem hasDerivAt_gaussian (x : ℝ) :
    HasDerivAt gaussian (gaussianDeriv x) x := by
  have hpow : HasDerivAt (fun y : ℝ ↦ y ^ 2) (2 * x) x := by
    simpa [pow_two, two_mul] using (hasDerivAt_pow 2 x)
  have hinner : HasDerivAt (fun y : ℝ ↦ -Real.pi * y ^ 2)
      (-2 * Real.pi * x) x := by
    convert! HasDerivAt.const_mul (-Real.pi) hpow using 1
    all_goals ring
  change HasDerivAt (Real.exp ∘ fun y : ℝ ↦ -Real.pi * y ^ 2)
    (-2 * Real.pi * x * Real.exp (-Real.pi * x ^ 2)) x
  convert! (Real.hasDerivAt_exp (-Real.pi * x ^ 2)).comp x hinner using 1
  all_goals ring

theorem integral_gaussian : ∫ x : ℝ, gaussian x = 1 := by
  simp only [gaussian]
  rw [_root_.integral_gaussian]
  rw [div_self (ne_of_gt Real.pi_pos), Real.sqrt_one]

theorem integrable_gaussian : Integrable gaussian := by
  simpa only [gaussian] using integrable_exp_neg_mul_sq Real.pi_pos

theorem integrable_gaussianDeriv : Integrable gaussianDeriv := by
  have h : Integrable (fun x : ℝ ↦ x * Real.exp (-Real.pi * x ^ 2)) :=
    integrable_mul_exp_neg_mul_sq Real.pi_pos
  convert h.const_mul (-2 * Real.pi) using 1
  ext x
  simp [gaussianDeriv, gaussian]
  ring

theorem gaussianDeriv_neg (x : ℝ) : gaussianDeriv (-x) = -gaussianDeriv x := by
  simp [gaussianDeriv, gaussian]

theorem integral_gaussianDeriv : ∫ x : ℝ, gaussianDeriv x = 0 := by
  have hneg : MeasurePreserving (fun x : ℝ ↦ -x) volume volume :=
    Measure.measurePreserving_neg (volume : Measure ℝ)
  have hchange := hneg.integral_comp (Homeomorph.neg ℝ).measurableEmbedding gaussianDeriv
  have hodd : (∫ x : ℝ, gaussianDeriv (-x)) = -∫ x : ℝ, gaussianDeriv x := by
    rw [← integral_neg]
    apply integral_congr_ae
    filter_upwards with x
    rw [gaussianDeriv_neg]
  rw [hodd] at hchange
  linarith

/-! ### One-dimensional kernel dilations

These definitions retain the normalization and translation convention fixed
at the start of the blueprint: `v_(s)(x) = s⁻¹ v(x / s)` and
`v_(s,a)(x) = v_(s)(x-a)`. -/

/-- Mass-normalized one-dimensional dilation of a scalar-valued kernel. -/
def kernelDilate {V : Type*} [SMul ℝ V] (v : ℝ → V) (s x : ℝ) : V :=
  s⁻¹ • v (x / s)

/-- The translated, mass-normalized kernel `v_{s,a}`. -/
def kernelAt {V : Type*} [SMul ℝ V] (v : ℝ → V) (s a x : ℝ) : V :=
  kernelDilate v s (x - a)

theorem kernelAt_one (v : ℝ → ℝ) (a x : ℝ) : kernelAt v 1 a x = v (x - a) := by
  simp [kernelAt, kernelDilate]

/-- The precise nested-dilation convention used repeatedly in the source. -/
theorem kernelAt_dilate_translate {V : Type*} [AddCommMonoid V] [Module ℝ V] (v : ℝ → V)
    {s : ℝ} (hs : s ≠ 0) (r a x : ℝ) :
    kernelAt (kernelAt v 1 r) s a x = kernelAt v s (a + s * r) x := by
  simp only [kernelAt, kernelDilate, inv_one, one_smul]
  congr 2
  field_simp
  ring

/-- The source kernels `\(\mathsf g_{s,a}\)`. -/
def gaussianAt (s a x : ℝ) : ℝ := kernelAt gaussian s a x

/-- The source kernels `\(\mathsf h_{s,a}\)`. -/
def gaussianDerivAt (s a x : ℝ) : ℝ := kernelAt gaussianDeriv s a x

theorem integrable_gaussianAt {s : ℝ} (hs : 0 < s) (a : ℝ) :
    Integrable (gaussianAt s a) := by
  unfold gaussianAt kernelAt kernelDilate
  exact ((integrable_gaussian.comp_div hs.ne').comp_sub_right a).const_smul _

theorem integrable_gaussianDerivAt {s : ℝ} (hs : 0 < s) (a : ℝ) :
    Integrable (gaussianDerivAt s a) := by
  unfold gaussianDerivAt kernelAt kernelDilate
  exact ((integrable_gaussianDeriv.comp_div hs.ne').comp_sub_right a).const_smul _

theorem integral_gaussianAt {s : ℝ} (hs : 0 < s) (a : ℝ) :
    ∫ x : ℝ, gaussianAt s a x = 1 := by
  unfold gaussianAt kernelAt kernelDilate
  rw [integral_smul]
  rw [integral_sub_right_eq_self (μ := volume) (fun x : ℝ ↦ gaussian (x / s)) a]
  rw [Measure.integral_comp_div]
  simp [abs_of_pos hs, integral_gaussian, hs.ne']

theorem integral_gaussianDerivAt {s : ℝ} (hs : 0 < s) (a : ℝ) :
    ∫ x : ℝ, gaussianDerivAt s a x = 0 := by
  unfold gaussianDerivAt kernelAt kernelDilate
  rw [integral_smul]
  rw [integral_sub_right_eq_self (μ := volume) (fun x : ℝ ↦ gaussianDeriv (x / s)) a]
  rw [Measure.integral_comp_div]
  simp [abs_of_pos hs, integral_gaussianDeriv]

/-! ### The standard frequency bump

The literal source definition constructs the cutoff through an infinite
convolution product.  The analytic work below and later in the proof uses
only its proved properties.  We therefore package a direct smooth compactly
supported realization with exactly those support and plateau radii; the
source-audit entry records this implementation-level replacement.
-/

/-- A real, even, smooth cutoff with plateau `[-1/2, 1/2]` and support in
`[-1, 1]`.  It realizes the frequency-side bump `b` of `def:bumps`. -/
noncomputable def standardFrequencyBump : ℝ → ℝ :=
  (⟨(1 : ℝ) / 2, 1, by norm_num, by norm_num⟩ : ContDiffBump (0 : ℝ))

private theorem standardFrequencyBump_apply (x : ℝ) :
    standardFrequencyBump x =
      (let b : ContDiffBump (0 : ℝ) :=
        ⟨(1 : ℝ) / 2, 1, by norm_num, by norm_num⟩
       b x) := by
  rfl

theorem standardFrequencyBump_nonneg (x : ℝ) : 0 ≤ standardFrequencyBump x := by
  rw [standardFrequencyBump_apply]
  exact ContDiffBump.nonneg' _ _

theorem standardFrequencyBump_le_one (x : ℝ) : standardFrequencyBump x ≤ 1 := by
  rw [standardFrequencyBump_apply]
  exact ContDiffBump.le_one _

theorem standardFrequencyBump_even (x : ℝ) :
    standardFrequencyBump (-x) = standardFrequencyBump x := by
  rw [standardFrequencyBump_apply, standardFrequencyBump_apply]
  exact ContDiffBump.neg _ _

theorem standardFrequencyBump_eq_one_of_abs_le_half {x : ℝ} (hx : |x| ≤ 1 / 2) :
    standardFrequencyBump x = 1 := by
  rw [standardFrequencyBump_apply]
  let b : ContDiffBump (0 : ℝ) :=
    ⟨(1 : ℝ) / 2, 1, by norm_num, by norm_num⟩
  apply b.one_of_mem_closedBall
  rw [Metric.mem_closedBall, Real.dist_eq]
  simpa [b] using hx

theorem standardFrequencyBump_eq_zero_of_one_le_abs {x : ℝ} (hx : 1 ≤ |x|) :
    standardFrequencyBump x = 0 := by
  rw [standardFrequencyBump_apply]
  let b : ContDiffBump (0 : ℝ) :=
    ⟨(1 : ℝ) / 2, 1, by norm_num, by norm_num⟩
  apply b.zero_of_le_dist
  rw [Real.dist_eq]
  simpa [b] using hx

theorem standardFrequencyBump_contDiff :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) standardFrequencyBump := by
  rw [show standardFrequencyBump =
      (⟨(1 : ℝ) / 2, 1, by norm_num, by norm_num⟩ : ContDiffBump (0 : ℝ)) by rfl]
  exact (⟨(1 : ℝ) / 2, 1, by norm_num, by norm_num⟩ : ContDiffBump (0 : ℝ)).contDiff

theorem standardFrequencyBump_hasCompactSupport :
    HasCompactSupport standardFrequencyBump := by
  rw [show standardFrequencyBump =
      (⟨(1 : ℝ) / 2, 1, by norm_num, by norm_num⟩ : ContDiffBump (0 : ℝ)) by rfl]
  exact ContDiffBump.hasCompactSupport _

/-- The complex Schwartz realization of the real frequency bump. -/
noncomputable def standardFrequencyBumpSchwartz : SchwartzMap ℝ ℂ := by
  let g : ℝ → ℂ := Complex.ofRealCLM ∘ standardFrequencyBump
  have hcompact : HasCompactSupport g :=
    standardFrequencyBump_hasCompactSupport.comp_left (g := Complex.ofRealCLM) rfl
  have hsmooth : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) g :=
    Complex.ofRealCLM.contDiff.comp standardFrequencyBump_contDiff
  exact hcompact.toSchwartzMap hsmooth

@[simp]
theorem standardFrequencyBumpSchwartz_apply (x : ℝ) :
    standardFrequencyBumpSchwartz x = standardFrequencyBump x := by
  rfl

/-- The spatial-side standard bump `\(\mathsf B=\mathcal F^{-1}b\)`. -/
noncomputable def standardBump : SchwartzMap ℝ ℂ :=
  𝓕⁻ standardFrequencyBumpSchwartz

@[simp]
theorem schwartzFourier_standardBump :
    𝓕 standardBump = standardFrequencyBumpSchwartz := by
  simp [standardBump]

/-! ## Anisotropic dyadic boxes

This is the literal integer-level grid from `def:tree`.  In particular,
parents use Euclidean division on `ℤ`; this is the floor operation stipulated
by the source even for negative coordinate indices.
-/

/-- A source dyadic box is determined by an integral scale and three integral
coordinate indices. -/
structure AnisoBox (α : Anisotropy) where
  level : ℤ
  index : Fin 3 → ℤ
  deriving DecidableEq

/-- The number of children in coordinate `i`. -/
def anisoRadix (α : Anisotropy) (i : Fin 3) : ℕ := 2 ^ α.weight i

/-- A coordinatewise child digit. -/
abbrev AnisoDigit (α : Anisotropy) := (i : Fin 3) → Fin (anisoRadix α i)

theorem anisoRadix_pos (α : Anisotropy) (i : Fin 3) : 0 < anisoRadix α i := by
  exact Nat.pow_pos (by norm_num)

/-- The side length in coordinate `i` of an anisotropic box. -/
noncomputable def boxSide (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) : ℝ :=
  (2 : ℝ) ^ (q.level * (α.weight i : ℤ))

/-- The source scale `\(\ell(Q)\)`. -/
noncomputable def boxLength (q : AnisoBox α) : ℝ := (2 : ℝ) ^ q.level

/-- The source volume formula `\(|Q|=2^{kA}\)`, recorded as a positive
grid mass before its Lebesgue-measure identification. -/
noncomputable def boxMass (α : Anisotropy) (q : AnisoBox α) : ℝ :=
  (2 : ℝ) ^ (q.level * (α.homogeneousDimension : ℤ))

theorem boxSide_eq_length_pow (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    boxSide α q i = boxLength q ^ α.weight i := by
  simp only [boxSide, boxLength, ← zpow_natCast, zpow_mul]

theorem prod_boxSide_eq_boxMass (α : Anisotropy) (q : AnisoBox α) :
    (∏ i, boxSide α q i) = boxMass α q := by
  simp_rw [boxSide_eq_length_pow]
  rw [Finset.prod_pow_eq_pow_sum]
  simp only [boxMass, boxLength, Anisotropy.homogeneousDimension, ← zpow_natCast, zpow_mul]

theorem boxSide_pos (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    0 < boxSide α q i := by
  exact zpow_pos (by norm_num) _

theorem boxMass_pos (α : Anisotropy) (q : AnisoBox α) : 0 < boxMass α q := by
  exact zpow_pos (by norm_num) _

/-- The half-open coordinate interval of a box. -/
noncomputable def boxInterval (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    Set ℝ :=
  Set.Ico ((q.index i : ℝ) * boxSide α q i)
    (((q.index i + 1 : ℤ) : ℝ) * boxSide α q i)

/-- The spatial half-open box `Q(k,n)`. -/
noncomputable def boxSet (α : Anisotropy) (q : AnisoBox α) : Set E3 :=
  Set.preimage (WithLp.ofLp : E3 → Fin 3 → ℝ)
    (Set.pi Set.univ (fun i ↦ boxInterval α q i))

/-- The source parent box, using integer floor division coordinatewise. -/
def boxParent (α : Anisotropy) (q : AnisoBox α) : AnisoBox α :=
  ⟨q.level + 1, fun i ↦ q.index i / (anisoRadix α i : ℤ)⟩

/-- The child selected by a coordinatewise digit. -/
def boxChild (α : Anisotropy) (q : AnisoBox α) (v : AnisoDigit α) : AnisoBox α :=
  ⟨q.level - 1, fun i ↦ (anisoRadix α i : ℤ) * q.index i + (v i : ℤ)⟩

/-- The finite family of source children. -/
def boxChildren (α : Anisotropy) (q : AnisoBox α) : Finset (AnisoBox α) :=
  Finset.univ.image (boxChild α q)

theorem boxParent_child (α : Anisotropy) (q : AnisoBox α) (v : AnisoDigit α) :
    boxParent α (boxChild α q v) = q := by
  cases q with
  | mk level index =>
    simp only [boxParent, boxChild, AnisoBox.mk.injEq]
    constructor
    · omega
    · funext i
      rw [Int.mul_add_ediv_left]
      · rw [Int.ediv_eq_zero_of_lt]
        · simp
        · exact_mod_cast Nat.zero_le (v i).val
        · exact_mod_cast (v i).isLt
      · exact_mod_cast (Nat.ne_of_gt (anisoRadix_pos α i))

theorem boxChild_injective (α : Anisotropy) (q : AnisoBox α) :
    Function.Injective (boxChild α q) := by
  intro v w h
  funext i
  have hi := congrFun (congrArg AnisoBox.index h) i
  dsimp [boxChild] at hi
  apply Fin.ext
  have hval : (v i : ℤ) = (w i : ℤ) := by linarith
  exact_mod_cast hval

/-- Every box has exactly `2^A` children, as in `lem:geometry`. -/
theorem card_boxChildren (α : Anisotropy) (q : AnisoBox α) :
    (boxChildren α q).card = 2 ^ α.homogeneousDimension := by
  unfold boxChildren
  rw [Finset.card_image_iff.mpr (boxChild_injective α q).injOn]
  rw [Finset.card_univ, Fintype.card_pi]
  have hc (i : Fin 3) : Fintype.card (Fin (anisoRadix α i)) = anisoRadix α i :=
    Fintype.card_fin _
  simp_rw [hc]
  unfold anisoRadix Anisotropy.homogeneousDimension
  rw [Finset.prod_pow_eq_pow_sum]

theorem measurableSet_boxSet (α : Anisotropy) (q : AnisoBox α) :
    MeasurableSet (boxSet α q) := by
  unfold boxSet
  apply (PiLp.volume_preserving_ofLp (Fin 3)).measurable
  apply MeasurableSet.pi Set.countable_univ
  intro i _
  exact measurableSet_Ico

/-- Lebesgue volume of the literal half-open grid box, before collecting the
coordinate factors into the homogeneous-dimension expression. -/
theorem volume_boxSet (α : Anisotropy) (q : AnisoBox α) :
    volume (boxSet α q) = ∏ i, ENNReal.ofReal (boxSide α q i) := by
  let lo : Fin 3 → ℝ := fun i ↦ (q.index i : ℝ) * boxSide α q i
  let hi : Fin 3 → ℝ := fun i ↦ ((q.index i + 1 : ℤ) : ℝ) * boxSide α q i
  have hmeas : MeasurableSet (Set.pi Set.univ fun i ↦ Set.Ico (lo i) (hi i)) := by
    apply MeasurableSet.pi Set.countable_univ
    intro i _
    exact measurableSet_Ico
  change volume ((WithLp.ofLp : E3 → Fin 3 → ℝ) ⁻¹'
      Set.pi Set.univ (fun i ↦ Set.Ico (lo i) (hi i))) = _
  rw [(PiLp.volume_preserving_ofLp (Fin 3)).measure_preimage hmeas.nullMeasurableSet]
  rw [Real.volume_pi_Ico]
  congr with i
  congr 1
  dsimp [lo, hi]
  push_cast
  ring

theorem volume_boxSet_toReal (α : Anisotropy) (q : AnisoBox α) :
    (volume (boxSet α q)).toReal = boxMass α q := by
  rw [volume_boxSet, ENNReal.toReal_prod]
  have htoReal : ∀ i : Fin 3,
      (ENNReal.ofReal (boxSide α q i)).toReal = boxSide α q i :=
    fun i ↦ ENNReal.toReal_ofReal (boxSide_pos α q i).le
  simp_rw [htoReal]
  exact prod_boxSide_eq_boxMass α q

