/-- **The interpolation kernel is summable, uniformly in the finite set.** -/
theorem exists_kernel_sum_bound {θ : ℝ} (hθ : 0 < θ) (hθ1 : θ < 1) :
    ∃ A : ℝ, 0 < A ∧ ∀ K : Finset ℤ,
      ∑ k ∈ K, ENNReal.ofReal ((2:ℝ) ^ (-(θ * (k:ℝ))) * min 1 ((2:ℝ) ^ (k:ℝ)))
