def derivativeWeight (α : Anisotropy) {k : ℕ} (σ : Fin k → Fin 3) : ℕ :=
  ∑ r, α.weight (σ r)

/-- The standard coordinate direction in `E3`. -/
def coordinateDirection (i : Fin 3) : E3 :=
