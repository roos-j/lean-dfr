/-- **The scale integral exchanges with the mode sum.** -/
theorem integral_tsum_modeScaleIntegrand
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (F : ModelComplexSchwartzInput) :
    (∑' ν : Fin 3 → ℤ,
        ∫ t in Ioi (0 : ℝ),
