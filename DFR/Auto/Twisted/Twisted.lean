  classical
  obtain ⟨Cm, hCm0, hCmb⟩ := hbound
  have hEx : ∀ i : Fin 3, ∃ A : ℝ, 0 ≤ A ∧ ∀ (M : ℝ) (m : E3 → ℂ),
