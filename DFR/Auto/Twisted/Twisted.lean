/-- The fully opened fiber-to-profile equality is unconditional on every
measurable positive scale band for real Schwartz model inputs. -/
theorem truncationFiber_centerFubini_of_fullyExpanded_auto
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (A : Set ℝ) (hA : MeasurableSet A) (hApos : A ⊆ Set.Ioi (0 : ℝ))
    (hfull : Integrable
      (modelFiberFullyExpandedIntegrand α u c (InitialModelRealInput F))
      (((cubeScaleMeasure.restrict (Set.univ ×ˢ A)).prod
        (volume : Measure ModelE5)).prod ((volume : Measure ℝ).prod volume))) :
    (∫ pt in Set.univ ×ˢ A,
      truncationFiberIntegrand α u c (InitialModelRealInput F) pt
        ∂cubeScaleMeasure) =
      ∫ t in A, c t *
        (∫ q : (E3 × E3) × E3,
          ModelCenterExpandedIntegrand α u F t q
          ∂(((volume : Measure E3).prod volume).prod volume))
        ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
  apply truncationFiber_centerFubini_of_fullyExpanded
    α u c F A hA hApos hfull
  filter_upwards [ae_restrict_mem hA] with t ht
  exact integrable_ModelCenterTranslationIntegrand α u F t (hApos ht)

/-- The two-index localization statement with all center-transport and
raw-fiber integrability premises discharged for real Schwartz data. -/
theorem tendsto_expandedModelLocalForm_twoIndex_of_fullyExpanded_auto
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput) (N : ℕ)
    (hfull : Integrable
      (modelFiberFullyExpandedIntegrand α u c (InitialModelRealInput F))
      (((cubeScaleMeasure.restrict
        (Set.univ ×ˢ truncationScaleSet N)).prod
          (volume : Measure ModelE5)).prod
        ((volume : Measure ℝ).prod volume))) :
    Tendsto (fun M ↦ expandedModelLocalForm α (truncationCollection α M) u
      (RestrictScaleCoefficient c (truncationScaleSet N))
      (InitialModelRealInput F)) atTop
      (𝓝 (ModelScaleTruncation α u c F N)) := by
  apply tendsto_expandedModelLocalForm_twoIndex_of_fullyExpanded
    α u c F N hfull
  exact truncationFiber_centerFubini_of_fullyExpanded_auto
    α u c F (truncationScaleSet N) measurableSet_Ioc
      (truncationScaleSet_subset_positive N) hfull

/-- The complete two-index localization consumer: the only remaining
premises are literal full-slab integrability and the finite-forest bound. -/
theorem modelFullForm_bound_of_twoIndex_fullyExpanded_auto_and_uniformForest
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (B : ℝ) (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hfull : ∀ N : ℕ, Integrable
      (modelFiberFullyExpandedIntegrand α u c (InitialModelRealInput F))
      (((cubeScaleMeasure.restrict
        (Set.univ ×ˢ truncationScaleSet N)).prod
          (volume : Measure ModelE5)).prod
        ((volume : Measure ℝ).prod volume)))
    (hforest : ∀ (d : ℝ → ℝ), (∀ t : ℝ, |d t| ≤ 1) → ∀ M : ℕ,
      |expandedModelLocalForm α (truncationCollection α M) u d
        (InitialModelRealInput F)| ≤ B) :
    |ModelFullForm α u c F| ≤ B := by
  apply modelFullForm_bound_of_twoIndex_fullyExpanded_and_uniformForest
    α u c F B hcmeas hc hfull
  · intro N
    exact truncationFiber_centerFubini_of_fullyExpanded_auto
      α u c F (truncationScaleSet N) measurableSet_Ioc
        (truncationScaleSet_subset_positive N) (hfull N)
  · exact hforest


/-- The tree-energy constants can be selected once for a fixed anisotropy,
before the finite collection, the coefficient, and the Schwartz tuple are
chosen.  This is the uniformity needed by the two-index exhaustion. -/
theorem exists_uniform_activeStoppingForest_constant
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (S : BoxCollection α)
      (hS : IsConvexCollection α S) (u : E3) (c : ℝ → ℝ)
      (F : InitialModelSchwartzInput) (q σ : Fin 4 → ℝ)
      (hq : ∀ j, 0 < q j)
      (hpos : ∀ r ∈ S, ∀ j,
        0 < stoppingData α S (sourceStoppingExponent j)
          (InitialModelRealInput F j) r)
      (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1)
      (hfinite : ∀ (j : Fin 4) (m : ℤ),
        volume (sourceStoppingMaximalLevelSetAt α
          (InitialModelRealInput F) j m) ≠ ∞),
      |expandedModelLocalForm α S u c (InitialModelRealInput F)| ≤
        C * sourceWeight u ^ 75 *
          SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F)
            q σ hpos := by
  rcases modelEnergyOne_tree_bound_of_boundedContinuous α with
    ⟨C₁, hC₁, hE₁⟩
  rcases modelEnergyTwo_tree_bound_of_boundedContinuous α with
    ⟨C₂, hC₂, hE₂⟩
  refine ⟨C₁ * C₂ + 1, add_nonneg (mul_nonneg hC₁ hC₂) zero_le_one, ?_⟩
  intro S hS u c F q σ hq hpos hcmeas hc hfinite
  let f : ModelRealInput := InitialModelRealInput F
  have hcont : ∀ j, Continuous (f j) := by
    simpa only [f] using initialModelRealInput_continuous F
  have hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B := by
    simpa only [f] using initialModelRealInput_bounded F
  have hcs : sourceStoppingTreeCS α S hS u c f := by
    exact sourceStoppingTreeCS_of_boundedContinuous
      α S hS u c f hcmeas hcont hbound hc
  have henergy : sourceStoppingTreeEnergyIntegrability α S hS u f := by
    exact sourceStoppingTreeEnergyIntegrability_of_boundedContinuous
      α S hS u f hcont hbound
  have hEone : sourceStoppingTreeEnergyOneBound α S hS u f C₁ := by
    intro n Q
    rcases henergy n Q with ⟨hfirst, hscale, hsecond, hjoint⟩
    exact hE₁ (sourceStoppingTree α S hS f n Q) u f false
      hcont hbound hfirst hscale
  have hEtwo : sourceStoppingTreeEnergyTwoBound α S hS u f C₂ := by
    intro n Q
    rcases henergy n Q with ⟨hfirst, hscale, hsecond, hjoint⟩
    exact hE₂ (sourceStoppingTree α S hS f n Q) u (f 3) false
      (hcont 3) (hbound 3) hsecond hjoint
  have hdomfinite : ∀ n : Fin 4 → ℤ,
      volume (sourceStoppingDominantMaximalLevelSet α f q σ n) ≠ ∞ := by
    exact dominantMaximalLevel_finite_of_coordinateLevel_finite
      α f q σ hfinite
  have hint : Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict (collectionRegion α S)) := by
    simpa only [f] using
      integrable_outerModelSignedFiber_of_initialModelSchwartz
        α S u c F hcmeas hc
  change |expandedModelLocalForm α S u c f| ≤
    (C₁ * C₂ + 1) * sourceWeight u ^ 75 *
      SourceStoppingCoordinateEnvelope α S f q σ hpos
  exact activeStoppingForest_form_bound_of_energyBounds_of_integrable
    α S hS u c f q σ hq hpos hcont hbound hdomfinite
      C₁ C₂ hC₁ hC₂ hcs hEone hEtwo hint

/-! ## Scalar stopping distributions

The finite forest construction has already reduced its global packing
estimate to four maximal-function level sums.  The following lemmas make the
finite layer-cake conversion explicit, so it can consume the measurable
coordinatewise maximal majorants constructed below. -/

/-- A dyadic `r`-power weight is the integer power used by the finite
layer-cake estimate with base `2^r`. -/
theorem rpow_two_mul_int_eq_zpow_rpow
    (r : ℝ) (m : ℤ) :
    (2 : ℝ) ^ (r * (m : ℝ)) = ((2 : ℝ) ^ r) ^ m := by
  rw [← Real.rpow_mul_intCast (by norm_num : (0 : ℝ) ≤ 2) r m]

/-- Exact threshold conversion after raising a stopping level to a positive
real power. -/
theorem sourceStopping_threshold_rpow
    (j : Fin 4) (r : ℝ) (m : ℤ) :
    (sourceStoppingComparisonConstant j / 2) ^ r *
        ((2 : ℝ) ^ r) ^ m =
      (sourceStoppingComparisonConstant j * (2 : ℝ) ^ (m - 1)) ^ r := by
  have hc : 0 < sourceStoppingComparisonConstant j :=
    sourceStoppingComparisonConstant_pos j
  have htwo : (2 : ℝ) ≠ 0 := by norm_num
  rw [← rpow_two_mul_int_eq_zpow_rpow r m]
  rw [← Real.rpow_intCast]
  rw [show (r * (m : ℝ)) = ((m : ℝ) * r) by ring,
    Real.rpow_intCast_mul (by norm_num : (0 : ℝ) ≤ 2) m r]
  rw [← Real.mul_rpow (by positivity : 0 ≤ sourceStoppingComparisonConstant j / 2)
    (zpow_nonneg (by norm_num) m)]
  congr 1
  have hpow : (2 : ℝ) ^ ((m - 1 : ℤ) : ℝ) = (2 : ℝ) ^ m / 2 := by
    rw [show ((m - 1 : ℤ) : ℝ) = (m : ℝ) - 1 by
      push_cast
      ring,
      Real.rpow_sub (by norm_num : 0 < (2 : ℝ)), Real.rpow_one,
      ← Real.rpow_intCast]
  rw [hpow]
  ring

/-- Bounded continuous inputs make the literal fourth-power all-scale
supremum nonnegative by retaining its positive unit-scale member. -/
theorem anisotropicMaximalFourPower_nonneg_of_boundedContinuous
    (α : Anisotropy) (f : E3 → ℝ) (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f y| ≤ B) (p : E3) :
    0 ≤ anisotropicMaximalFourPower α f p := by
  calc
    0 ≤ fourthMoment α 1 p f := fourthMoment_nonneg α (by norm_num) p f
    _ ≤ anisotropicMaximalFourPower α f p := by
      unfold anisotropicMaximalFourPower
      apply le_csSup (bddAbove_anisotropicMaximalFourPower
        α f hfcont B hB hfB p)
      exact ⟨1, by norm_num, rfl⟩

/-- Every literal source stopping maximal is nonnegative on bounded
continuous data. -/
theorem sourceStoppingMaximal_nonneg_of_boundedContinuous
    (α : Anisotropy) (f : ModelRealInput) (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (j : Fin 4) (p : E3) :
    0 ≤ sourceStoppingMaximal α f j p := by
  by_cases hj : j = 3
  · subst j
    simp only [sourceStoppingMaximal, ↓reduceIte]
    exact Real.sqrt_nonneg _
  · rcases hbound j with ⟨B, hB, hfB⟩
    simp only [sourceStoppingMaximal, hj, ite_false]
    exact Real.rpow_nonneg
      (anisotropicMaximalFourPower_nonneg_of_boundedContinuous
        α (f j) (hcont j) B hB hfB p) _

/-- A literal stopping superlevel is contained in the corresponding level
set of any `r`-power majorant. -/
theorem sourceStoppingLevelSetAt_subset_majorant_rpowLevel
    (α : Anisotropy) (f : ModelRealInput) (j : Fin 4) (m : ℤ)
    (r : ℝ) (h : E3 → ℝ)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hr : 0 < r)
    (hmajor : ∀ x, sourceStoppingMaximal α f j x ≤ h x) :
    sourceStoppingMaximalLevelSetAt α f j m ⊆
      {x | (sourceStoppingComparisonConstant j / 2) ^ r *
          ((2 : ℝ) ^ r) ^ m ≤ h x ^ r} := by
  intro x hx
  have hsource : sourceStoppingComparisonConstant j * (2 : ℝ) ^ (m - 1) <
      sourceStoppingMaximal α f j x := hx
  have hsource_nonneg : 0 ≤ sourceStoppingMaximal α f j x := by
    exact sourceStoppingMaximal_nonneg_of_boundedContinuous
      α f hcont hbound j x
  have hpow :
      (sourceStoppingComparisonConstant j * (2 : ℝ) ^ (m - 1)) ^ r ≤
        (sourceStoppingMaximal α f j x) ^ r := by
    apply Real.rpow_le_rpow
    · exact (mul_pos (sourceStoppingComparisonConstant_pos j)
        (zpow_pos (by norm_num) _)).le
    · exact hsource.le
    · exact hr.le
  have hmajorpow : (sourceStoppingMaximal α f j x) ^ r ≤ h x ^ r := by
    exact Real.rpow_le_rpow hsource_nonneg (hmajor x) hr.le
  rw [sourceStopping_threshold_rpow j r m]
  exact hpow.trans hmajorpow

/-- A positive closed superlevel of an integrable nonnegative function has
finite volume. -/
theorem volume_ne_top_of_integrable_closed_superlevel
    (g : E3 → ℝ) (hg : Integrable g) {θ : ℝ} (hθ : 0 < θ) :
    volume {x : E3 | θ ≤ g x} ≠ ∞ := by
  have hmem : MemLp g 1 volume := memLp_one_iff_integrable.mpr hg
  have hhalf : 0 < θ / 2 := by linarith
  have htop : volume {x : E3 | θ / 2 < g x} ≠ ∞ :=
    volume_ne_top_of_memLp g 1 hmem (by norm_num) (by norm_num) hhalf
  apply ne_of_lt
  apply (MeasureTheory.measure_mono ?_).trans_lt
    (lt_top_iff_ne_top.mpr htop)
  intro x hx
  change θ / 2 < g x
  change θ ≤ g x at hx
  linarith

/-- Finite scalar distribution estimate for a literal source stopping
coordinate dominated by a measurable integrable `r`-power majorant. -/
theorem sum_sourceStoppingLevel_rpow_weight_le_integral_majorant
    (α : Anisotropy) (f : ModelRealInput) (j : Fin 4) (r : ℝ)
    (h : E3 → ℝ)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hr : 0 < r)
    (hmajor : ∀ x, sourceStoppingMaximal α f j x ≤ h x)
    (hnonneg : ∀ x, 0 ≤ h x)
    (hmeas : Measurable (fun x : E3 ↦ h x ^ r))
    (hint : Integrable (fun x : E3 ↦ h x ^ r))
    (N : Finset ℤ) :
    (∑ m ∈ N, (2 : ℝ) ^ (r * (m : ℝ)) *
      (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) ≤
      ((1 - ((2 : ℝ) ^ r)⁻¹)⁻¹ *
        (sourceStoppingComparisonConstant j / 2) ^ (-r)) *
          ∫ x : E3, h x ^ r := by
  let a : ℝ := (2 : ℝ) ^ r
  let c : ℝ := (sourceStoppingComparisonConstant j / 2) ^ r
  let g : E3 → ℝ := fun x ↦ h x ^ r
  have ha : 1 < a := by
    dsimp [a]
    exact Real.one_lt_rpow (by norm_num) hr
  have hc : 0 < c := by
    dsimp [c]
    exact Real.rpow_pos_of_pos
      (div_pos (sourceStoppingComparisonConstant_pos j) (by norm_num)) _
  have hapos : 0 < a := lt_trans (by norm_num) ha
  have hgmeas : Measurable g := by
    simpa only [g] using hmeas
  have hgint : Integrable g := by
    simpa only [g] using hint
  have hgnonneg : ∀ x, 0 ≤ g x := by
    intro x
    dsimp [g]
    exact Real.rpow_nonneg (hnonneg x) _
  have hfinite : ∀ m ∈ N, volume {x : E3 | c * a ^ m ≤ g x} ≠ ∞ := by
    intro m hm
    apply volume_ne_top_of_integrable_closed_superlevel g hgint
    exact mul_pos hc (zpow_pos hapos m)
  have hset : ∀ m : ℤ,
      sourceStoppingMaximalLevelSetAt α f j m ⊆
        {x : E3 | c * a ^ m ≤ g x} := by
    intro m
    dsimp [a, c, g]
    exact sourceStoppingLevelSetAt_subset_majorant_rpowLevel
      α f j m r h hcont hbound hr hmajor
  have hterm : ∀ m ∈ N,
      (2 : ℝ) ^ (r * (m : ℝ)) *
          (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal ≤
        a ^ m * (volume {x : E3 | c * a ^ m ≤ g x}).toReal := by
    intro m hm
    rw [rpow_two_mul_int_eq_zpow_rpow]
    apply mul_le_mul_of_nonneg_left
      (ENNReal.toReal_mono (hfinite m hm)
        (MeasureTheory.measure_mono (hset m)))
    exact zpow_nonneg hapos.le m
  have hlayer := sum_zpow_levelSet_toReal_le_integral
    a c ha hc g hgmeas hgint hgnonneg N hfinite
  calc
    (∑ m ∈ N, (2 : ℝ) ^ (r * (m : ℝ)) *
        (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) ≤
        ∑ m ∈ N, a ^ m *
          (volume {x : E3 | c * a ^ m ≤ g x}).toReal := by
      exact Finset.sum_le_sum fun m hm ↦ hterm m hm
    _ ≤ ((1 - a⁻¹)⁻¹ * c⁻¹) * ∫ x : E3, g x := hlayer
    _ = ((1 - ((2 : ℝ) ^ r)⁻¹)⁻¹ *
        (sourceStoppingComparisonConstant j / 2) ^ (-r)) *
          ∫ x : E3, h x ^ r := by
      have hbase : 0 ≤ sourceStoppingComparisonConstant j / 2 := by
        exact (div_pos (sourceStoppingComparisonConstant_pos j)
          (by norm_num)).le
      rw [show c⁻¹ = (sourceStoppingComparisonConstant j / 2) ^ (-r) by
        dsimp [c]
        rw [← Real.rpow_neg hbase r]]

/-- The finite stopping envelope is reduced to its four scalar dyadic
distribution sums once its dominant-fiber weights have been compared with
the corresponding `r`-power dyadic weights. -/
theorem SourceStoppingCoordinateEnvelope_le_of_dominant_weight_bound
    (α : Anisotropy) (S : BoxCollection α) (f : ModelRealInput)
    (q σ r B L : Fin 4 → ℝ)
    (hpos : ∀ s ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) s)
    (hB : ∀ j, 0 ≤ B j)
    (hweight : ∀ j m,
      sourceStoppingDominantFiberEnvelope q σ j m ≤
        B j * (2 : ℝ) ^ (r j * (m : ℝ)))
    (hlevel : ∀ j,
      (∑ m ∈ (activeStoppingLevels α S sourceStoppingExponent f hpos).filter
          (fun n ↦ sourceStoppingDominantIndex q σ n = j) |>.image
            (fun n ↦ n j),
        (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal *
          (2 : ℝ) ^ (r j * (m : ℝ))) ≤ L j) :
    SourceStoppingCoordinateEnvelope α S f q σ hpos ≤ ∑ j, B j * L j := by
  unfold SourceStoppingCoordinateEnvelope
  apply Finset.sum_le_sum
  intro j hj
  let N : Finset ℤ :=
    (activeStoppingLevels α S sourceStoppingExponent f hpos).filter
      (fun n ↦ sourceStoppingDominantIndex q σ n = j) |>.image
        (fun n ↦ n j)
  have hterm : ∀ m ∈ N,
      sourceStoppingDominantFiberEnvelope q σ j m *
          (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal ≤
        B j * ((2 : ℝ) ^ (r j * (m : ℝ)) *
          (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) := by
    intro m hm
    calc
      sourceStoppingDominantFiberEnvelope q σ j m *
          (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal ≤
        (B j * (2 : ℝ) ^ (r j * (m : ℝ))) *
          (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal := by
          apply mul_le_mul_of_nonneg_right (hweight j m)
          exact ENNReal.toReal_nonneg
      _ = B j * ((2 : ℝ) ^ (r j * (m : ℝ)) *
          (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) := by
          ring
  change (∑ m ∈ N,
      sourceStoppingDominantFiberEnvelope q σ j m *
        (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) ≤ B j * L j
  calc
    (∑ m ∈ N,
        sourceStoppingDominantFiberEnvelope q σ j m *
          (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) ≤
        ∑ m ∈ N, B j * ((2 : ℝ) ^ (r j * (m : ℝ)) *
          (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) := by
      exact Finset.sum_le_sum fun m hm ↦ hterm m hm
    _ = B j * (∑ m ∈ N, (2 : ℝ) ^ (r j * (m : ℝ)) *
          (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) := by
      rw [Finset.mul_sum]
    _ ≤ B j * L j := by
      apply mul_le_mul_of_nonneg_left
      · simpa only [N, mul_comm] using hlevel j
      · exact hB j


/-! ### Four-linear rescaling of the real model form -/

/-- Real scalar multiplication commutes exactly with each one-coordinate
model convolution. -/
theorem ModelCoordinateConvolution_smul
    (i : Fin 3) (a : ℝ) (f : E3 → ℝ) (k : ℝ → ℝ)
    (s : ℝ) (x : E3) :
    ModelCoordinateConvolution i (a • f) k s x =
      a * ModelCoordinateConvolution i f k s x := by
  unfold ModelCoordinateConvolution
  rw [show (fun r : ℝ ↦ (a • f) (x - r • Anisotropy.coordinateDirection i) *
      kernelDilate k s r) =
      fun r ↦ a * (f (x - r • Anisotropy.coordinateDirection i) *
        kernelDilate k s r) by
      funext r
      simp only [Pi.smul_apply, smul_eq_mul]
      ring, integral_const_mul]

/-- Independently rescale the four real Schwartz inputs of the model form. -/
noncomputable def modelInputRescale
    (a : Fin 4 → ℝ) (F : ModelSchwartzInput) : ModelSchwartzInput :=
  fun j ↦ a j • F j

@[simp] theorem modelInputRescale_apply
    (a : Fin 4 → ℝ) (F : ModelSchwartzInput) (j : Fin 4) (x : E3) :
    modelInputRescale a F j x = a j * F j x := by
  simp [modelInputRescale]

/-- The pointwise spatial model integrand is four-linear in independently
rescaled inputs. -/
theorem ModelSpatialIntegrand_rescale
    (α : Anisotropy) (u : E3) (a : Fin 4 → ℝ)
    (F : ModelSchwartzInput) (t : ℝ) (x : E3) :
    ModelSpatialIntegrand α u (modelInputRescale a F) t x =
      (∏ j : Fin 4, a j) * ModelSpatialIntegrand α u F t x := by
  have hcomp (j : Fin 4) :
      ((modelInputRescale a F j : SchwartzMap E3 ℝ) : E3 → ℝ) =
        a j • ((F j : SchwartzMap E3 ℝ) : E3 → ℝ) := by
    funext y
    simp [modelInputRescale]
  unfold ModelSpatialIntegrand
  rw [hcomp 0, hcomp 1, hcomp 2, hcomp 3,
    ModelCoordinateConvolution_smul,
    ModelCoordinateConvolution_smul,
    ModelCoordinateConvolution_smul]
  simp only [Pi.smul_apply, smul_eq_mul, Fin.prod_univ_four]
  ring

/-- The spatial profile inherits the same four-linear rescaling law. -/
theorem ModelSpatialProfile_rescale
    (α : Anisotropy) (u : E3) (a : Fin 4 → ℝ)
    (F : ModelSchwartzInput) (t : ℝ) :
    ModelSpatialProfile α u (modelInputRescale a F) t =
      (∏ j : Fin 4, a j) * ModelSpatialProfile α u F t := by
  unfold ModelSpatialProfile
  rw [show (fun x : E3 ↦ ModelSpatialIntegrand α u
      (modelInputRescale a F) t x) =
      fun x ↦ (∏ j : Fin 4, a j) * ModelSpatialIntegrand α u F t x by
        funext x
        exact ModelSpatialIntegrand_rescale α u a F t x,
      integral_const_mul]

/-- The full real Schwartz model form is exactly four-linear under
independent scalar rescaling. -/
theorem ModelFullForm_rescale
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ)
    (a : Fin 4 → ℝ) (F : ModelSchwartzInput) :
    ModelFullForm α u c (modelInputRescale a F) =
      (∏ j : Fin 4, a j) * ModelFullForm α u c F := by
  unfold ModelFullForm
  rw [show (fun t : ℝ ↦ c t * ModelSpatialProfile α u
      (modelInputRescale a F) t) =
      fun t ↦ (∏ j : Fin 4, a j) *
        (c t * ModelSpatialProfile α u F t) by
        funext t
        rw [ModelSpatialProfile_rescale]
        ring,
      integral_const_mul]

/-- Independent rescaling at the raw real-input level used by finite model
forests. -/
def modelRealInputRescale
    (a : Fin 4 → ℝ) (f : ModelRealInput) : ModelRealInput :=
  fun j ↦ a j • f j

@[simp] theorem modelRealInputRescale_apply
    (a : Fin 4 → ℝ) (f : ModelRealInput) (j : Fin 4) (x : E3) :
    modelRealInputRescale a f j x = a j * f j x := by
  simp [modelRealInputRescale]

/-- The first fiber is trilinear in its three real input branches. -/
theorem modelFirstFiber_rescale
    (α : Anisotropy) (a : Fin 4 → ℝ) (f : ModelRealInput)
    (p : E3) (t : ℝ) (z : ModelE5) :
    modelFirstFiber α (modelRealInputRescale a f) p t z =
      (a 0 * a 1 * a 2) * modelFirstFiber α f p t z := by
  unfold modelFirstFiber
  rw [show (fun v : ℝ ↦
      modelRealInputRescale a f 0 (modelPoint (z 0) (z 1) v) *
      modelRealInputRescale a f 1 (modelPoint (z 2) (z 1) v) *
      modelRealInputRescale a f 2 (modelPoint (z 0) (z 3) v) *
      gaussianDerivAt (t ^ α.weight 2) (p 2) v) =
      fun v ↦ (a 0 * a 1 * a 2) *
        (f 0 (modelPoint (z 0) (z 1) v) *
        f 1 (modelPoint (z 2) (z 1) v) *
        f 2 (modelPoint (z 0) (z 3) v) *
        gaussianDerivAt (t ^ α.weight 2) (p 2) v) by
      funext v
      simp only [modelRealInputRescale_apply]
      ring, integral_const_mul]

/-- The second fiber is linear in the fourth real input branch. -/
theorem modelSecondFiber_smul
    (α : Anisotropy) (a : ℝ) (f : E3 → ℝ)
    (p : E3) (t : ℝ) (z : ModelE5) :
    modelSecondFiber α (a • f) p t z =
      a * modelSecondFiber α f p t z := by
  unfold modelSecondFiber
  rw [show (fun v : ℝ ↦
      (a • f) (modelPoint (z 0) (z 1) v) *
        gaussianDerivAt (t ^ α.weight 2)
          (p 2 + z 4 * t ^ α.weight 2) v) =
      fun v ↦ a * (f (modelPoint (z 0) (z 1) v) *
        gaussianDerivAt (t ^ α.weight 2)
          (p 2 + z 4 * t ^ α.weight 2) v) by
      funext v
      simp only [Pi.smul_apply, smul_eq_mul]
      ring, integral_const_mul]

/-- The finite expanded local form has the expected four-linear scaling
law, without any auxiliary integrability premise. -/
theorem expandedModelLocalForm_rescale
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (a : Fin 4 → ℝ) (f : ModelRealInput) :
    expandedModelLocalForm α S u c (modelRealInputRescale a f) =
      (∏ j : Fin 4, a j) * expandedModelLocalForm α S u c f := by
  unfold expandedModelLocalForm
  rw [show (fun pt : E3 × ℝ ↦ c pt.2 * (∫ z : ModelE5,
      modelFirstFiber α (modelRealInputRescale a f) pt.1 pt.2 z *
        modelSecondFiber α (modelRealInputRescale a f 3) pt.1 pt.2 z *
          modelSignedDensity α u pt.1 pt.2 z)) =
      fun pt ↦ (∏ j : Fin 4, a j) *
        (c pt.2 * (∫ z : ModelE5,
          modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z)) by
      funext pt
      rw [show (fun z : ModelE5 ↦
        modelFirstFiber α (modelRealInputRescale a f) pt.1 pt.2 z *
          modelSecondFiber α (modelRealInputRescale a f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z) =
          fun z ↦ (a 0 * a 1 * a 2 * a 3) *
            (modelFirstFiber α f pt.1 pt.2 z *
              modelSecondFiber α (f 3) pt.1 pt.2 z *
                modelSignedDensity α u pt.1 pt.2 z) by
          funext z
          rw [modelFirstFiber_rescale,
            show modelRealInputRescale a f 3 = a 3 • f 3 by
              funext y
              simp [modelRealInputRescale],
            modelSecondFiber_smul]
          ring,
        integral_const_mul]
      simp only [Fin.prod_univ_four]
      ring,
    integral_const_mul]
  ring

/-- Rescaling commutes with the coercion from a real Schwartz tuple to the
finite-forest input tuple. -/
theorem InitialModelRealInput_rescale
    (a : Fin 4 → ℝ) (F : InitialModelSchwartzInput) :
    InitialModelRealInput (modelInputRescale a F) =
      modelRealInputRescale a (InitialModelRealInput F) := by
  funext j x
  simp [modelInputRescale, modelRealInputRescale,
    InitialModelRealInput]

/-- The finite forest form has the same rescaling law when presented by a
real Schwartz tuple. -/
theorem expandedModelLocalForm_initial_rescale
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (a : Fin 4 → ℝ) (F : InitialModelSchwartzInput) :
    expandedModelLocalForm α S u c
      (InitialModelRealInput (modelInputRescale a F)) =
      (∏ j : Fin 4, a j) *
        expandedModelLocalForm α S u c (InitialModelRealInput F) := by
  rw [InitialModelRealInput_rescale]
  exact expandedModelLocalForm_rescale α S u c a
    (InitialModelRealInput F)

/-! ## Literal coordinate-fiber bracket identification -/

theorem e3ToFiberDyadicCoordinates_snd
    (i : Fin 3) (p : E3) :
    (e3ToFiberDyadicCoordinates i p).2 = realToFiberDyadicLine (p i) := by
  rfl

theorem e3ToFiberDyadicCoordinates_symm_coordinate
    (i : Fin 3) (z : FiberDyadicBase) (y : FiberDyadicLine) :
    ((e3ToFiberDyadicCoordinates i).symm (z, y)) i =
      realToFiberDyadicLine.symm y := by
  simp [e3ToFiberDyadicCoordinates, coordinateJoin, faceInsert,
    MeasurableEquiv.prodComm, MeasurableEquiv.prodCongr]

theorem norm_realToFiberDyadicLine (x : ℝ) :
    ‖realToFiberDyadicLine x‖ = |x| := by
  simpa [realToFiberDyadicLine, MeasurableEquiv.piUnique,
    EuclideanSpace.norm_eq] using Real.sqrt_sq_eq_abs x

theorem realToFiberDyadicLine_sub (x y : ℝ) :
    realToFiberDyadicLine x - realToFiberDyadicLine y =
      realToFiberDyadicLine (x - y) := by
  ext j
  simp [realToFiberDyadicLine, MeasurableEquiv.piUnique]

theorem norm_realToFiberDyadicLine_sub (x y : ℝ) :
    ‖realToFiberDyadicLine x - realToFiberDyadicLine y‖ = |x - y| := by
  rw [realToFiberDyadicLine_sub]
  exact norm_realToFiberDyadicLine (x - y)

theorem norm_scaled_fiber_sub
    (r a : ℝ) (y : FiberDyadicLine) (hr : 0 < r) :
    ‖r⁻¹ • (y - realToFiberDyadicLine a)‖ =
      |(realToFiberDyadicLine.symm y - a) / r| := by
  have hy : y = realToFiberDyadicLine (realToFiberDyadicLine.symm y) :=
    (realToFiberDyadicLine.apply_symm_apply y).symm
  conv_lhs => rw [hy]
  rw [norm_smul, norm_realToFiberDyadicLine_sub]
  rw [Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hr)]
  rw [div_eq_mul_inv, abs_mul, abs_of_pos (inv_pos.mpr hr)]
  ring

/-- Along a transported coordinate fibre, the literal source bracket kernel
is exactly the scaled radial fibre bracket. -/
theorem bracketKernelAt_coordinateFiber_eq
    (i : Fin 3) (p : E3) (z : FiberDyadicBase) (y : FiberDyadicLine)
    (r : ℝ) (hr : 0 < r) :
    bracketKernelAt r (p i) ((e3ToFiberDyadicCoordinates i).symm (z, y) i) =
      r⁻¹ * fiberRadialBracket
        (r⁻¹ • (y - (e3ToFiberDyadicCoordinates i p).2)) := by
  rw [e3ToFiberDyadicCoordinates_symm_coordinate,
    e3ToFiberDyadicCoordinates_snd]
  unfold bracketKernelAt kernelAt kernelDilate bracketKernel fiberRadialBracket
  rw [norm_scaled_fiber_sub r (p i) y hr]
  simp only [smul_eq_mul]

theorem e3ToFiberDyadicCoordinates_faceInsert
    (i : Fin 3) (a : ℝ) (z : TransverseSpace i) :
    e3ToFiberDyadicCoordinates i (faceInsert i a z) =
      (transverseToFiberDyadicBase i z, realToFiberDyadicLine a) := by
  simp [e3ToFiberDyadicCoordinates, MeasurableEquiv.prodComm,
    MeasurableEquiv.prodCongr]

theorem e3ToFiberDyadicCoordinates_symm_pair
    (i : Fin 3) (a : ℝ) (z : TransverseSpace i) :
    (e3ToFiberDyadicCoordinates i).symm
        (transverseToFiberDyadicBase i z, realToFiberDyadicLine a) =
      faceInsert i a z := by
  apply (e3ToFiberDyadicCoordinates i).injective
  simp [e3ToFiberDyadicCoordinates_faceInsert]

theorem integral_real_eq_integral_fiber
    (F : ℝ → ℝ) :
    (∫ x : ℝ, F x) =
      ∫ y : FiberDyadicLine, F (realToFiberDyadicLine.symm y) := by
  simpa using
    (realToFiberDyadicLine_measurePreserving.integral_comp'
      (fun y : FiberDyadicLine ↦ F (realToFiberDyadicLine.symm y)))

theorem coordinateBracketAverage_eq_coordinateFiberRadialBracketAverage
    (i : Fin 3) (f : E3 → ℂ) (r a : ℝ) (z : TransverseSpace i)
    (hr : 0 < r) :
    (∫ x : ℝ, ‖f (faceInsert i x z)‖ * bracketKernelAt r a x) =
      coordinateFiberRadialBracketAverage i f r (faceInsert i a z) := by
  rw [integral_real_eq_integral_fiber]
  unfold coordinateFiberRadialBracketAverage
  apply integral_congr_ae
  filter_upwards [] with y
  have hcoords := e3ToFiberDyadicCoordinates_faceInsert i a z
  have hfirst :
      (e3ToFiberDyadicCoordinates i (faceInsert i a z)).1 =
        transverseToFiberDyadicBase i z := congrArg Prod.fst hcoords
  have hsecond :
      (e3ToFiberDyadicCoordinates i (faceInsert i a z)).2 =
        realToFiberDyadicLine a := congrArg Prod.snd hcoords
  have hpoint :
      (e3ToFiberDyadicCoordinates i).symm
          ((e3ToFiberDyadicCoordinates i (faceInsert i a z)).1, y) =
        faceInsert i (realToFiberDyadicLine.symm y) z := by
    rw [hfirst, ← realToFiberDyadicLine.apply_symm_apply y]
    exact e3ToFiberDyadicCoordinates_symm_pair i
      (realToFiberDyadicLine.symm y) z
  have hkernel := bracketKernelAt_coordinateFiber_eq i
    (faceInsert i a z) (transverseToFiberDyadicBase i z) y r hr
  have hpair :
      (e3ToFiberDyadicCoordinates i).symm
          (transverseToFiberDyadicBase i z, y) =
        faceInsert i (realToFiberDyadicLine.symm y) z := by
    rw [← realToFiberDyadicLine.apply_symm_apply y]
    exact e3ToFiberDyadicCoordinates_symm_pair i
      (realToFiberDyadicLine.symm y) z
  have hkernel' :
      bracketKernelAt r a (realToFiberDyadicLine.symm y) =
        r⁻¹ * fiberRadialBracket
          (r⁻¹ • (y - realToFiberDyadicLine a)) := by
    rw [hpair] at hkernel
    simpa [e3ToFiberDyadicCoordinates_faceInsert] using hkernel
  rw [hpoint, hsecond, hkernel']

/-- A literal one-coordinate bracket convolution is bounded by the
transported dyadic ball maximal function. -/
theorem coordinateBracketAverage_le_dyadic
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ x, ‖f x‖ ≤ A)
    (r a : ℝ) (z : TransverseSpace i) (hr : 0 < r) :
    (∫ x : ℝ, ‖f (faceInsert i x z)‖ * bracketKernelAt r a x) ≤
      16 * (coordinateDyadicBallMaximal i f (faceInsert i a z) *
        (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) := by
  rw [coordinateBracketAverage_eq_coordinateFiberRadialBracketAverage
    i f r a z hr]
  exact coordinateFiberRadialBracketAverage_le_dyadic i f hf A hA hbound r hr
    (faceInsert i a z)

/-! ## Reverse coordinate order for the three-fold iteration -/

/-- The coordinate order `2,1,0`, so that Fubini exposes the literal
dyadic iteration in the canonical order `0,1,2`. -/
noncomputable def reverseTripleCoordinates :
    ℝ × (ℝ × ℝ) ≃ᵐ ℝ × (ℝ × ℝ) :=
  (MeasurableEquiv.prodComm.trans
    (MeasurableEquiv.prodCongr MeasurableEquiv.prodComm
      (MeasurableEquiv.refl ℝ))).trans MeasurableEquiv.prodAssoc

@[simp] theorem reverseTripleCoordinates_apply (a b c : ℝ) :
    reverseTripleCoordinates (a, (b, c)) = (c, (b, a)) := by
  simp [reverseTripleCoordinates, MeasurableEquiv.prodComm,
    MeasurableEquiv.prodCongr, MeasurableEquiv.prodAssoc]

/-- The reverse coordinate reordering preserves the three-fold Lebesgue
product measure. -/
theorem reverseTripleCoordinates_measurePreserving :
    MeasurePreserving reverseTripleCoordinates
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
  let hswap₀ : MeasurePreserving (MeasurableEquiv.prodComm :
      ℝ × (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) × ℝ)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))
      (((volume : Measure ℝ).prod volume).prod volume) :=
    Measure.measurePreserving_swap
  let hswap₁ : MeasurePreserving
      (MeasurableEquiv.prodCongr MeasurableEquiv.prodComm
        (MeasurableEquiv.refl ℝ) : (ℝ × ℝ) × ℝ ≃ᵐ (ℝ × ℝ) × ℝ)
      (((volume : Measure ℝ).prod volume).prod volume)
      (((volume : Measure ℝ).prod volume).prod volume) :=
    (Measure.measurePreserving_swap : MeasurePreserving Prod.swap
      ((volume : Measure ℝ).prod volume) ((volume : Measure ℝ).prod volume)).prod
        (MeasurePreserving.id volume)
  let hassoc : MeasurePreserving (MeasurableEquiv.prodAssoc :
      (ℝ × ℝ) × ℝ ≃ᵐ ℝ × (ℝ × ℝ))
      (((volume : Measure ℝ).prod volume).prod volume)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) :=
    measurePreserving_prodAssoc volume volume volume
  exact hassoc.comp (hswap₁.comp hswap₀)

/-- The reverse coordinate map on `E3`. -/
noncomputable def e3ReverseCoordinates :
    E3 ≃ᵐ ℝ × (ℝ × ℝ) :=
  e3Coordinates.trans reverseTripleCoordinates

@[simp] theorem e3ReverseCoordinates_apply (p : E3) :
    e3ReverseCoordinates p = (p 2, (p 1, p 0)) := by
  simp [e3ReverseCoordinates, e3Coordinates_apply]

/-- The reverse coordinate map on `E3` preserves Lebesgue measure. -/
theorem e3ReverseCoordinates_measurePreserving :
    MeasurePreserving e3ReverseCoordinates (volume : Measure E3)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
  exact reverseTripleCoordinates_measurePreserving.comp
    e3Coordinates_measurePreserving

@[simp] theorem e3ReverseCoordinates_symm_modelPoint
    (a b c : ℝ) :
    e3ReverseCoordinates.symm (c, (b, a)) = modelPoint a b c := by
  apply e3ReverseCoordinates.injective
  rw [e3ReverseCoordinates.apply_symm_apply]
  simp

/-- A bounded measurable input remains integrable after multiplication by a
positive anisotropic bracket kernel. -/
theorem integrable_norm_mul_anisotropicBracketKernel
    (α : Anisotropy) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ y, ‖f y‖ ≤ A)
    {t : ℝ} (ht : 0 < t) (p : E3) :
    Integrable (fun y : E3 ↦ ‖f y‖ * anisotropicBracketKernel α t p y) := by
  let K : E3 → ℝ := anisotropicBracketKernel α t p
  have hK : Integrable K := integrable_anisotropicBracketKernel α ht p
  refine (hK.const_mul A).mono
    ((hf.norm.mul (continuous_anisotropicBracketKernel α ht p).measurable).aestronglyMeasurable)
    ?_
  filter_upwards [] with y
  have hKnonneg : 0 ≤ K y := anisotropicBracketKernel_nonneg α ht.le p y
  rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (norm_nonneg _) hKnonneg),
    Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hA hKnonneg)]
  exact mul_le_mul_of_nonneg_right (hbound y) hKnonneg

/-- Fubini opens an anisotropic bracket average in reverse coordinate order.
That order exposes coordinate `0` as the inner integral, matching the
canonical iteration order of the dyadic maximal operator. -/
theorem integral_norm_mul_anisotropicBracketKernel_eq_reverse_nested
    (α : Anisotropy) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ y, ‖f y‖ ≤ A)
    {t : ℝ} (ht : 0 < t) (p : E3) :
    (∫ y : E3, ‖f y‖ * anisotropicBracketKernel α t p y) =
      ∫ y₂ : ℝ, ∫ y₁ : ℝ, ∫ y₀ : ℝ,
        ‖f (modelPoint y₀ y₁ y₂)‖ *
          bracketKernelAt (t ^ α.weight 0) (p 0) y₀ *
          bracketKernelAt (t ^ α.weight 1) (p 1) y₁ *
          bracketKernelAt (t ^ α.weight 2) (p 2) y₂ := by
  let e := e3ReverseCoordinates
  let G : E3 → ℝ := fun y ↦ ‖f y‖ * anisotropicBracketKernel α t p y
  let H : ℝ × (ℝ × ℝ) → ℝ := fun z ↦ G (e.symm z)
  have hG : Integrable G := by
    dsimp only [G]
    exact integrable_norm_mul_anisotropicBracketKernel
      α f hf A hA hbound ht p
  have hmp : MeasurePreserving e (volume : Measure E3)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    simpa only [e] using e3ReverseCoordinates_measurePreserving
  have hH : Integrable H
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    exact (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hG
  calc
    (∫ y : E3, ‖f y‖ * anisotropicBracketKernel α t p y) =
        ∫ z : ℝ × (ℝ × ℝ), H z
          ∂((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
          change (∫ y : E3, G y) = _
          exact (MeasurePreserving.symm e hmp).integral_comp
            e.symm.measurableEmbedding G |>.symm
    _ = ∫ y₂ : ℝ, ∫ y₁ : ℝ, ∫ y₀ : ℝ, H (y₂, (y₁, y₀)) :=
      integral_real_cube_eq_nested H hH
    _ = ∫ y₂ : ℝ, ∫ y₁ : ℝ, ∫ y₀ : ℝ,
        ‖f (modelPoint y₀ y₁ y₂)‖ *
          bracketKernelAt (t ^ α.weight 0) (p 0) y₀ *
          bracketKernelAt (t ^ α.weight 1) (p 1) y₁ *
          bracketKernelAt (t ^ α.weight 2) (p 2) y₂ := by
      apply integral_congr_ae
      filter_upwards [] with y₂
      apply integral_congr_ae
      filter_upwards [] with y₁
      apply integral_congr_ae
      filter_upwards [] with y₀
      have hcoords : e.symm (y₂, (y₁, y₀)) = modelPoint y₀ y₁ y₂ := by
        dsimp only [e]
        exact e3ReverseCoordinates_symm_modelPoint y₀ y₁ y₂
      dsimp only [H, G]
      rw [hcoords]
      simp only [anisotropicBracketKernel, Fin.prod_univ_three,
        modelPoint_zero, modelPoint_one, modelPoint_two]
      ring

/-- The literal positive bracket convolution in one coordinate. -/
noncomputable def coordinateBracketConvolution
    (i : Fin 3) (f : E3 → ℂ) (r : ℝ) (p : E3) : ℝ :=
  ∫ x : ℝ, ‖f (faceInsert i x (coordinateSplit i p).2)‖ *
    bracketKernelAt r (p i) x

@[simp] theorem faceInsert_zero_coordinateSplit_modelPoint
    (a b c x : ℝ) :
    faceInsert 0 x (coordinateSplit 0 (modelPoint a b c)).2 =
      modelPoint x b c := by
  ext j
  fin_cases j <;> simp [faceInsert, coordinateSplit, modelPoint]

@[simp] theorem faceInsert_one_coordinateSplit_modelPoint
    (a b c x : ℝ) :
    faceInsert 1 x (coordinateSplit 1 (modelPoint a b c)).2 =
      modelPoint a x c := by
  ext j
  fin_cases j <;> simp [faceInsert, coordinateSplit, modelPoint]

@[simp] theorem faceInsert_two_coordinateSplit_modelPoint
    (a b c x : ℝ) :
    faceInsert 2 x (coordinateSplit 2 (modelPoint a b c)).2 =
      modelPoint a b x := by
  ext j
  fin_cases j <;> simp [faceInsert, coordinateSplit, modelPoint]

/-- Each literal coordinate bracket convolution is nonnegative. -/
theorem coordinateBracketConvolution_nonneg
    (i : Fin 3) (f : E3 → ℂ) (r : ℝ) (p : E3) (hr : 0 ≤ r) :
    0 ≤ coordinateBracketConvolution i f r p := by
  unfold coordinateBracketConvolution
  apply integral_nonneg
  intro x
  exact mul_nonneg (norm_nonneg _) (bracketKernelAt_nonneg hr)

@[simp] theorem norm_complex_coordinateBracketConvolution
    (i : Fin 3) (f : E3 → ℂ) (r : ℝ) (p : E3) (hr : 0 ≤ r) :
    ‖(coordinateBracketConvolution i f r p : ℂ)‖ =
      coordinateBracketConvolution i f r p := by
  rw [Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (coordinateBracketConvolution_nonneg i f r p hr)]

/-- The literal coordinate convolution is exactly the transported radial
bracket average used by the fiber maximal theorem. -/
theorem coordinateBracketConvolution_eq_coordinateFiber
    (i : Fin 3) (f : E3 → ℂ) (r : ℝ) (p : E3) (hr : 0 < r) :
    coordinateBracketConvolution i f r p =
      coordinateFiberRadialBracketAverage i f r p := by
  have hp : faceInsert i (p i) (coordinateSplit i p).2 = p := by
    simpa [coordinateJoin, coordinateSplit] using (coordinateJoin_split i p)
  unfold coordinateBracketConvolution
  rw [coordinateBracketAverage_eq_coordinateFiberRadialBracketAverage
    i f r (p i) (coordinateSplit i p).2 hr, hp]

/-- A bounded measurable coordinate bracket convolution is Borel measurable
in its ambient center.  This is the Fubini measurability input needed to
iterate the one-dimensional estimate. -/
theorem coordinateBracketConvolution_measurable
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f) (r : ℝ) :
    Measurable (coordinateBracketConvolution i f r) := by
  let J : E3 × ℝ → ℝ := fun q ↦
    ‖f (faceInsert i q.2 (coordinateSplit i q.1).2)‖ *
      bracketKernelAt r (q.1 i) q.2
  have hsplit : Measurable (fun q : E3 × ℝ ↦ coordinateSplit i q.1) :=
    (coordinateSplit_measurePreserving i).measurable.comp measurable_fst
  have htrans : Measurable (fun q : E3 × ℝ ↦ (coordinateSplit i q.1).2) :=
    measurable_snd.comp hsplit
  have hpair : Measurable (fun q : E3 × ℝ ↦
      (q.2, (coordinateSplit i q.1).2)) :=
    Measurable.prodMk measurable_snd htrans
  have hpoint : Measurable (fun q : E3 × ℝ ↦
      faceInsert i q.2 (coordinateSplit i q.1).2) := by
    change Measurable (coordinateJoin i ∘ fun q : E3 × ℝ ↦
      (q.2, (coordinateSplit i q.1).2))
    exact (coordinateJoin_continuous i).measurable.comp hpair
  have hcenter : Measurable (fun q : E3 × ℝ ↦ q.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp
      measurable_fst
  have hkernel : Measurable (fun q : E3 × ℝ ↦
      bracketKernelAt r (q.1 i) q.2) :=
    measurable_kernelAt bracketKernel continuous_bracketKernel.measurable
      (fun _ : E3 × ℝ ↦ r) (fun q ↦ q.1 i) (fun q ↦ q.2)
      measurable_const hcenter measurable_snd
  have hJ : Measurable J := by
    exact (hf.comp hpoint).norm.mul hkernel
  change Measurable (fun p : E3 ↦ ∫ x : ℝ, J (p, x))
  exact hJ.stronglyMeasurable.integral_prod_right'.measurable

/-- The literal coordinate bracket convolution is bounded by the fiber
dyadic maximal operator with the explicit shell constant. -/
theorem coordinateBracketConvolution_le_dyadic
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ x, ‖f x‖ ≤ A)
    (r : ℝ) (p : E3) (hr : 0 < r) :
    coordinateBracketConvolution i f r p ≤
      16 * (coordinateDyadicBallMaximal i f p *
        (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) := by
  rw [coordinateBracketConvolution_eq_coordinateFiber i f r p hr]
  exact coordinateFiberRadialBracketAverage_le_dyadic i f hf A hA hbound r hr p

/-- The scale-independent shell constant furnished by the one-dimensional
radial-bracket decomposition. -/
noncomputable def dyadicBracketShellConstant : ℝ :=
  16 * (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal

theorem dyadicBracketShellConstant_nonneg :
    0 ≤ dyadicBracketShellConstant := by
  unfold dyadicBracketShellConstant
  exact mul_nonneg (by norm_num) ENNReal.toReal_nonneg

/-- Repackage the one-coordinate shell estimate using its named constant. -/
theorem coordinateBracketConvolution_le_shell_dyadic
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ x, ‖f x‖ ≤ A)
    (r : ℝ) (p : E3) (hr : 0 < r) :
    coordinateBracketConvolution i f r p ≤
      dyadicBracketShellConstant * coordinateDyadicBallMaximal i f p := by
  calc
    coordinateBracketConvolution i f r p ≤
        16 * (coordinateDyadicBallMaximal i f p *
          (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) :=
      coordinateBracketConvolution_le_dyadic i f hf A hA hbound r p hr
    _ = dyadicBracketShellConstant * coordinateDyadicBallMaximal i f p := by
      unfold dyadicBracketShellConstant
      ring

/-- The shell-scaled coordinate maximal function has the expected real norm. -/
theorem norm_shell_smul_coordinateDyadicBallMaximalComplex
    (K : ℝ) (hK : 0 ≤ K) (i : Fin 3) (f : E3 → ℂ) (p : E3) :
    ‖(K : ℂ) • coordinateDyadicBallMaximalComplex i f p‖ =
      K * coordinateDyadicBallMaximal i f p := by
  rw [norm_smul]
  change ‖(K : ℂ)‖ * ‖(coordinateDyadicBallMaximal i f p : ℂ)‖ = _
  rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hK]
  rw [Complex.norm_real]
  change K * |coordinateDyadicBallMaximal i f p| =
    K * coordinateDyadicBallMaximal i f p
  rw [abs_of_nonneg (show 0 ≤ coordinateDyadicBallMaximal i f p from
    ENNReal.toReal_nonneg)]

/-- The literal bracket convolution is uniformly bounded after its shell
comparison, a fact used to feed the next coordinate iteration. -/
theorem coordinateBracketConvolution_bound
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ x, ‖f x‖ ≤ A)
    (r : ℝ) (p : E3) (hr : 0 < r) :
    coordinateBracketConvolution i f r p ≤
      dyadicBracketShellConstant * A := by
  calc
    coordinateBracketConvolution i f r p ≤
        dyadicBracketShellConstant * coordinateDyadicBallMaximal i f p :=
      coordinateBracketConvolution_le_shell_dyadic
        i f hf A hA hbound r p hr
    _ ≤ dyadicBracketShellConstant * A :=
      mul_le_mul_of_nonneg_left
        (coordinateDyadicBallMaximal_top_bound i f A hA hbound p)
        dyadicBracketShellConstant_nonneg

/-- A pointwise norm majorant propagates through one literal bracket
convolution and then through its dyadic shell estimate. -/
theorem coordinateBracketConvolution_le_shell_dyadic_of_norm_le
    (i : Fin 3) (f g : E3 → ℂ) (hf : Measurable f)
    (B : ℝ) (hB : 0 ≤ B) (hgbound : ∀ x, ‖g x‖ ≤ B)
    (hfg : ∀ x, ‖f x‖ ≤ ‖g x‖)
    (r : ℝ) (p : E3) (hr : 0 < r) :
    coordinateBracketConvolution i f r p ≤
      dyadicBracketShellConstant * coordinateDyadicBallMaximal i g p := by
  have hfbound : ∀ x, ‖f x‖ ≤ B := fun x ↦ (hfg x).trans (hgbound x)
  calc
    coordinateBracketConvolution i f r p ≤
        dyadicBracketShellConstant * coordinateDyadicBallMaximal i f p :=
      coordinateBracketConvolution_le_shell_dyadic
        i f hf B hB hfbound r p hr
    _ ≤ dyadicBracketShellConstant * coordinateDyadicBallMaximal i g p :=
      mul_le_mul_of_nonneg_left
        (coordinateDyadicBallMaximal_mono_of_norm_le
          i f g B hB hgbound hfg p)
        dyadicBracketShellConstant_nonneg

/-- The anisotropic bracket average is the literal composition of its three
one-coordinate positive bracket convolutions, in the canonical `0,1,2`
order. -/
theorem integral_norm_mul_anisotropicBracketKernel_eq_iterated
    (α : Anisotropy) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ y, ‖f y‖ ≤ A)
    {t : ℝ} (ht : 0 < t) (p : E3) :
    (∫ y : E3, ‖f y‖ * anisotropicBracketKernel α t p y) =
      coordinateBracketConvolution 2
        (fun q ↦ (coordinateBracketConvolution 1
          (fun q ↦ (coordinateBracketConvolution 0 f
            (t ^ α.weight 0) q : ℂ))
          (t ^ α.weight 1) q : ℂ))
        (t ^ α.weight 2) p := by
  rw [integral_norm_mul_anisotropicBracketKernel_eq_reverse_nested
    α f hf A hA hbound ht p]
  conv_rhs => rw [← modelPoint_components p]
  change
    (∫ y₂ : ℝ, ∫ y₁ : ℝ, ∫ y₀ : ℝ,
      ‖f (modelPoint y₀ y₁ y₂)‖ *
        bracketKernelAt (t ^ α.weight 0) (p 0) y₀ *
        bracketKernelAt (t ^ α.weight 1) (p 1) y₁ *
        bracketKernelAt (t ^ α.weight 2) (p 2) y₂) =
      ∫ y₂ : ℝ,
        ‖(coordinateBracketConvolution 1
          (fun q ↦ (coordinateBracketConvolution 0 f
            (t ^ α.weight 0) q : ℂ))
          (t ^ α.weight 1)
          (faceInsert 2 y₂
            (coordinateSplit 2 (modelPoint (p 0) (p 1) (p 2))).2) : ℂ)‖ *
          bracketKernelAt (t ^ α.weight 2)
            ((modelPoint (p 0) (p 1) (p 2)) 2) y₂
  apply integral_congr_ae
  filter_upwards [] with y₂
  rw [faceInsert_two_coordinateSplit_modelPoint, modelPoint_two,
    norm_complex_coordinateBracketConvolution 1
      (fun q ↦ (coordinateBracketConvolution 0 f
        (t ^ α.weight 0) q : ℂ))
      (t ^ α.weight 1) (modelPoint (p 0) (p 1) y₂) (pow_pos ht _).le]
  calc
    (∫ y₁ : ℝ, ∫ y₀ : ℝ,
      ‖f (modelPoint y₀ y₁ y₂)‖ *
        bracketKernelAt (t ^ α.weight 0) (p 0) y₀ *
        bracketKernelAt (t ^ α.weight 1) (p 1) y₁ *
        bracketKernelAt (t ^ α.weight 2) (p 2) y₂) =
        ∫ y₁ : ℝ,
          (∫ y₀ : ℝ,
            ‖f (modelPoint y₀ y₁ y₂)‖ *
              bracketKernelAt (t ^ α.weight 0) (p 0) y₀ *
              bracketKernelAt (t ^ α.weight 1) (p 1) y₁) *
            bracketKernelAt (t ^ α.weight 2) (p 2) y₂ := by
          apply integral_congr_ae
          filter_upwards [] with y₁
          rw [← integral_mul_const]
    _ = (∫ y₁ : ℝ, ∫ y₀ : ℝ,
          ‖f (modelPoint y₀ y₁ y₂)‖ *
            bracketKernelAt (t ^ α.weight 0) (p 0) y₀ *
            bracketKernelAt (t ^ α.weight 1) (p 1) y₁) *
          bracketKernelAt (t ^ α.weight 2) (p 2) y₂ := by
      rw [integral_mul_const]
    _ = coordinateBracketConvolution 1
          (fun q ↦ (coordinateBracketConvolution 0 f
            (t ^ α.weight 0) q : ℂ))
          (t ^ α.weight 1) (modelPoint (p 0) (p 1) y₂) *
          bracketKernelAt (t ^ α.weight 2) (p 2) y₂ := by
      congr 1
      change (∫ y₁ : ℝ, ∫ y₀ : ℝ,
        ‖f (modelPoint y₀ y₁ y₂)‖ *
          bracketKernelAt (t ^ α.weight 0) (p 0) y₀ *
          bracketKernelAt (t ^ α.weight 1) (p 1) y₁) =
        ∫ y₁ : ℝ,
          ‖(coordinateBracketConvolution 0 f
            (t ^ α.weight 0)
            (faceInsert 1 y₁
              (coordinateSplit 1 (modelPoint (p 0) (p 1) y₂)).2) : ℂ)‖ *
            bracketKernelAt (t ^ α.weight 1)
              ((modelPoint (p 0) (p 1) y₂) 1) y₁
      apply integral_congr_ae
      filter_upwards [] with y₁
      rw [faceInsert_one_coordinateSplit_modelPoint, modelPoint_one,
        norm_complex_coordinateBracketConvolution 0 f
          (t ^ α.weight 0) (modelPoint (p 0) y₁ y₂) (pow_pos ht _).le]
      change (∫ y₀ : ℝ,
        ‖f (modelPoint y₀ y₁ y₂)‖ *
          bracketKernelAt (t ^ α.weight 0) (p 0) y₀ *
          bracketKernelAt (t ^ α.weight 1) (p 1) y₁) =
        (∫ y₀ : ℝ,
          ‖f (faceInsert 0 y₀
            (coordinateSplit 0 (modelPoint (p 0) y₁ y₂)).2)‖ *
            bracketKernelAt (t ^ α.weight 0)
              ((modelPoint (p 0) y₁ y₂) 0) y₀) *
          bracketKernelAt (t ^ α.weight 1) (p 1) y₁
      rw [← integral_mul_const]
      apply integral_congr_ae
      filter_upwards [] with y₀
      rw [faceInsert_zero_coordinateSplit_modelPoint, modelPoint_zero]

/-- Three literal positive coordinate bracket convolutions are dominated by
the shell-scaled three-coordinate dyadic maximal operator.  The proof keeps
the shell constant after every stage, matching the operator's definition. -/
theorem integral_norm_mul_anisotropicBracketKernel_le_scaledDyadic
    (α : Anisotropy) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ y, ‖f y‖ ≤ A)
    {t : ℝ} (ht : 0 < t) (p : E3) :
    (∫ y : E3, ‖f y‖ * anisotropicBracketKernel α t p y) ≤
      ‖scaledIteratedCoordinateDyadicBallMaximal
        dyadicBracketShellConstant f p‖ := by
  let K : ℝ := dyadicBracketShellConstant
  let r₀ : ℝ := t ^ α.weight 0
  let r₁ : ℝ := t ^ α.weight 1
  let r₂ : ℝ := t ^ α.weight 2
  let h₀ : E3 → ℂ := fun q ↦
    (coordinateBracketConvolution 0 f r₀ q : ℂ)
  let f₀ : E3 → ℂ := coordinateDyadicBallMaximalComplex 0 f
  let g₀ : E3 → ℂ := (K : ℂ) • f₀
  let h₁ : E3 → ℂ := fun q ↦
    (coordinateBracketConvolution 1 h₀ r₁ q : ℂ)
  let f₁ : E3 → ℂ := coordinateDyadicBallMaximalComplex 1 g₀
  let g₁ : E3 → ℂ := (K : ℂ) • f₁
  have hK : 0 ≤ K := by
    dsimp only [K]
    exact dyadicBracketShellConstant_nonneg
  have hr₀ : 0 < r₀ := by
    dsimp only [r₀]
    exact pow_pos ht _
  have hr₁ : 0 < r₁ := by
    dsimp only [r₁]
    exact pow_pos ht _
  have hr₂ : 0 < r₂ := by
    dsimp only [r₂]
    exact pow_pos ht _
  have hh₀meas : Measurable h₀ := by
    dsimp only [h₀]
    exact Complex.continuous_ofReal.measurable.comp
      (coordinateBracketConvolution_measurable 0 f hf r₀)
  have hf₀meas : Measurable f₀ := by
    dsimp only [f₀]
    exact coordinateDyadicBallMaximalComplex_measurable 0 f hf
  have hg₀meas : Measurable g₀ := by
    dsimp only [g₀]
    exact hf₀meas.const_smul (K : ℂ)
  have hg₀bound : ∀ q, ‖g₀ q‖ ≤ K * A := by
    intro q
    rw [show ‖g₀ q‖ = K * coordinateDyadicBallMaximal 0 f q by
      dsimp only [g₀, f₀]
      exact norm_shell_smul_coordinateDyadicBallMaximalComplex K hK 0 f q]
    exact mul_le_mul_of_nonneg_left
      (coordinateDyadicBallMaximal_top_bound 0 f A hA hbound q) hK
  have hh₀bound : ∀ q, ‖h₀ q‖ ≤ K * A := by
    intro q
    rw [show ‖h₀ q‖ = coordinateBracketConvolution 0 f r₀ q by
      dsimp only [h₀]
      exact norm_complex_coordinateBracketConvolution 0 f r₀ q hr₀.le]
    exact coordinateBracketConvolution_bound 0 f hf A hA hbound r₀ q hr₀
  have hh₀le : ∀ q, ‖h₀ q‖ ≤ ‖g₀ q‖ := by
    intro q
    rw [show ‖h₀ q‖ = coordinateBracketConvolution 0 f r₀ q by
      dsimp only [h₀]
      exact norm_complex_coordinateBracketConvolution 0 f r₀ q hr₀.le,
      show ‖g₀ q‖ = K * coordinateDyadicBallMaximal 0 f q by
        dsimp only [g₀, f₀]
        exact norm_shell_smul_coordinateDyadicBallMaximalComplex K hK 0 f q]
    dsimp only [K]
    exact coordinateBracketConvolution_le_shell_dyadic
      0 f hf A hA hbound r₀ q hr₀
  have hh₁meas : Measurable h₁ := by
    dsimp only [h₁]
    exact Complex.continuous_ofReal.measurable.comp
      (coordinateBracketConvolution_measurable 1 h₀ hh₀meas r₁)
  have hf₁meas : Measurable f₁ := by
    dsimp only [f₁]
    exact coordinateDyadicBallMaximalComplex_measurable 1 g₀ hg₀meas
  have hKA : 0 ≤ K * A := mul_nonneg hK hA
  have hg₁bound : ∀ q, ‖g₁ q‖ ≤ K * (K * A) := by
    intro q
    rw [show ‖g₁ q‖ = K * coordinateDyadicBallMaximal 1 g₀ q by
      dsimp only [g₁, f₁]
      exact norm_shell_smul_coordinateDyadicBallMaximalComplex K hK 1 g₀ q]
    exact mul_le_mul_of_nonneg_left
      (coordinateDyadicBallMaximal_top_bound 1 g₀ (K * A) hKA hg₀bound q) hK
  have hh₁bound : ∀ q, ‖h₁ q‖ ≤ K * (K * A) := by
    intro q
    rw [show ‖h₁ q‖ = coordinateBracketConvolution 1 h₀ r₁ q by
      dsimp only [h₁]
      exact norm_complex_coordinateBracketConvolution 1 h₀ r₁ q hr₁.le]
    exact coordinateBracketConvolution_bound
      1 h₀ hh₀meas (K * A) hKA hh₀bound r₁ q hr₁
  have hh₁le : ∀ q, ‖h₁ q‖ ≤ ‖g₁ q‖ := by
    intro q
    rw [show ‖h₁ q‖ = coordinateBracketConvolution 1 h₀ r₁ q by
      dsimp only [h₁]
      exact norm_complex_coordinateBracketConvolution 1 h₀ r₁ q hr₁.le,
      show ‖g₁ q‖ = K * coordinateDyadicBallMaximal 1 g₀ q by
        dsimp only [g₁, f₁]
        exact norm_shell_smul_coordinateDyadicBallMaximalComplex K hK 1 g₀ q]
    exact coordinateBracketConvolution_le_shell_dyadic_of_norm_le
      1 h₀ g₀ hh₀meas (K * A) hKA hg₀bound hh₀le r₁ q hr₁
  have hfinal :
      coordinateBracketConvolution 2 h₁ r₂ p ≤
        K * coordinateDyadicBallMaximal 2 g₁ p :=
    coordinateBracketConvolution_le_shell_dyadic_of_norm_le
      2 h₁ g₁ hh₁meas (K * (K * A))
        (mul_nonneg hK hKA) hg₁bound hh₁le r₂ p hr₂
  calc
    (∫ y : E3, ‖f y‖ * anisotropicBracketKernel α t p y) =
        coordinateBracketConvolution 2 h₁ r₂ p := by
      rw [integral_norm_mul_anisotropicBracketKernel_eq_iterated
        α f hf A hA hbound ht p]
    _ ≤ K * coordinateDyadicBallMaximal 2 g₁ p := hfinal
    _ = ‖scaledIteratedCoordinateDyadicBallMaximal K f p‖ := by
      change K * coordinateDyadicBallMaximal 2 g₁ p =
        ‖(K : ℂ) • coordinateDyadicBallMaximalComplex 2 g₁ p‖
      rw [norm_shell_smul_coordinateDyadicBallMaximalComplex K hK]


/-! ## Fixed-scale scalar moment majorants -/

/-- A fixed-scale second moment is dominated by the shell-scaled iterated
dyadic maximal function of any Schwartz representative whose norm is the
literal square.  This form leaves the choice of power representative to the
stopping construction. -/
theorem cubeSecondMoment_le_scaledDyadic_of_norm_eq_square
    (α : Anisotropy) (f : E3 → ℝ) (g : Schwartz3)
    (hpower : ∀ y : E3, ‖g y‖ = f y ^ 2)
    {t : ℝ} (ht : 0 < t) (p : E3) :
    cubeSecondMoment α t p f ≤
      ‖scaledIteratedCoordinateDyadicBallMaximal
        dyadicBracketShellConstant g p‖ := by
  rcases schwartz_continuous_bounded g with ⟨hgcont, A, hA, hgA⟩
  have hmajor := integral_norm_mul_anisotropicBracketKernel_le_scaledDyadic
    α g hgcont.measurable A hA hgA ht p
  calc
    cubeSecondMoment α t p f =
        ∫ y : E3, ‖g y‖ * anisotropicBracketKernel α t p y := by
      unfold cubeSecondMoment
      apply integral_congr_ae
      filter_upwards [] with y
      rw [hpower y]
    _ ≤ ‖scaledIteratedCoordinateDyadicBallMaximal
        dyadicBracketShellConstant g p‖ := hmajor

/-- A fixed-scale fourth moment is dominated by the shell-scaled iterated
dyadic maximal function of any Schwartz representative whose norm is the
literal fourth power. -/
theorem fourthMoment_le_scaledDyadic_of_norm_eq_fourth
    (α : Anisotropy) (f : E3 → ℝ) (g : Schwartz3)
    (hpower : ∀ y : E3, ‖g y‖ = |f y| ^ (4 : ℝ))
    {t : ℝ} (ht : 0 < t) (p : E3) :
    fourthMoment α t p f ≤
      ‖scaledIteratedCoordinateDyadicBallMaximal
        dyadicBracketShellConstant g p‖ := by
  rcases schwartz_continuous_bounded g with ⟨hgcont, A, hA, hgA⟩
  have hmajor := integral_norm_mul_anisotropicBracketKernel_le_scaledDyadic
    α g hgcont.measurable A hA hgA ht p
  calc
    fourthMoment α t p f =
        ∫ y : E3, ‖g y‖ * anisotropicBracketKernel α t p y := by
      unfold fourthMoment
      apply integral_congr_ae
      filter_upwards [] with y
      rw [hpower y]
    _ ≤ ‖scaledIteratedCoordinateDyadicBallMaximal
        dyadicBracketShellConstant g p‖ := hmajor


/-- The strong fiber maximal estimate transports to each literal coordinate
of `E3`, retaining its explicit `L^p` constant. -/
theorem coordinateDyadicBallMaximal_lintegral_bound
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ x, ‖f x‖ ≤ A)
    {p : ℝ} (hp : 1 < p) :
    (∫⁻ x, ENNReal.ofReal (coordinateDyadicBallMaximal i f x ^ p)) ≤
      ENNReal.ofReal p *
        (2 * ENNReal.ofReal 4 * (ENNReal.ofReal (p - 1))⁻¹ *
          (ENNReal.ofReal (2 : ℝ)) ^ (p - 1) *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p) := by
  let e := e3ToFiberDyadicCoordinates i
  let G : FiberDyadicBase × FiberDyadicLine → ℂ := f ∘ e.symm
  have he : MeasurePreserving e volume fiberDyadicMeasure := by
    simpa only [e] using e3ToFiberDyadicCoordinates_measurePreserving i
  have hG : Measurable G := hf.comp e.symm.measurable
  have hGbound : ∀ z, ‖G z‖ ≤ A := by
    intro z
    exact hbound (e.symm z)
  have hfiber := fiberDyadicBallMaximal_lintegral_bound
    G hG ⟨A, hA, hGbound⟩ hp
  have hleft :
      (∫⁻ x, ENNReal.ofReal (coordinateDyadicBallMaximal i f x ^ p)) =
        ∫⁻ z, ENNReal.ofReal (fiberDyadicBallMaximal G z ^ p)
          ∂fiberDyadicMeasure := by
    change (∫⁻ x, ENNReal.ofReal (fiberDyadicBallMaximal G (e x) ^ p)) = _
    exact he.lintegral_comp
      ((fiberDyadicBallMaximal_measurable G hG).pow measurable_const).ennreal_ofReal
  have hright :
      (∫⁻ z, (ENNReal.ofReal ‖G z‖) ^ p ∂fiberDyadicMeasure) =
        ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := by
    simpa only [G, Function.comp_apply, MeasurableEquiv.symm_apply_apply] using
      (he.lintegral_comp ((hG.norm.ennreal_ofReal).pow measurable_const)).symm
  calc
    (∫⁻ x, ENNReal.ofReal (coordinateDyadicBallMaximal i f x ^ p)) =
        ∫⁻ z, ENNReal.ofReal (fiberDyadicBallMaximal G z ^ p)
          ∂fiberDyadicMeasure := hleft
    _ ≤ ENNReal.ofReal p *
        (2 * ENNReal.ofReal 4 * (ENNReal.ofReal (p - 1))⁻¹ *
          (ENNReal.ofReal (2 : ℝ)) ^ (p - 1) *
          ∫⁻ z, (ENNReal.ofReal ‖G z‖) ^ p ∂fiberDyadicMeasure) := hfiber
    _ = ENNReal.ofReal p *
        (2 * ENNReal.ofReal 4 * (ENNReal.ofReal (p - 1))⁻¹ *
          (ENNReal.ofReal (2 : ℝ)) ^ (p - 1) *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p) := by rw [hright]

/-- Complex packaging of the transported estimate preserves the literal
`L^p` integral, because the packaged maximal function is nonnegative real. -/
theorem coordinateDyadicBallMaximalComplex_lintegral_bound
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ x, ‖f x‖ ≤ A)
    {p : ℝ} (hp : 1 < p) :
    (∫⁻ x, (ENNReal.ofReal ‖coordinateDyadicBallMaximalComplex i f x‖) ^ p) ≤
      ENNReal.ofReal p *
        (2 * ENNReal.ofReal 4 * (ENNReal.ofReal (p - 1))⁻¹ *
          (ENNReal.ofReal (2 : ℝ)) ^ (p - 1) *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p) := by
  have h := coordinateDyadicBallMaximal_lintegral_bound
    i f hf A hA hbound hp
  have hpoint (x : E3) :
      ENNReal.ofReal (coordinateDyadicBallMaximal i f x ^ p) =
        (ENNReal.ofReal ‖coordinateDyadicBallMaximalComplex i f x‖) ^ p := by
    have hnon : 0 ≤ coordinateDyadicBallMaximal i f x := ENNReal.toReal_nonneg
    rw [coordinateDyadicBallMaximalComplex, Complex.norm_real,
      Real.norm_eq_abs, abs_of_nonneg hnon,
      ENNReal.ofReal_rpow_of_nonneg hnon (by linarith)]
  calc
    (∫⁻ x, (ENNReal.ofReal ‖coordinateDyadicBallMaximalComplex i f x‖) ^ p) =
        ∫⁻ x, ENNReal.ofReal (coordinateDyadicBallMaximal i f x ^ p) := by
          apply lintegral_congr
          intro x
          exact (hpoint x).symm
    _ ≤ _ := h

/-- Pulling a nonnegative real constant through a complex-valued `L^p`
integral costs exactly its `p`th power. -/
theorem lintegral_norm_const_smul_rpow
    (K : ℝ) (hK : 0 ≤ K) (g : E3 → ℂ) (hg : Measurable g)
    {p : ℝ} (hp : 0 ≤ p) :
    (∫⁻ x, (ENNReal.ofReal ‖(K : ℂ) • g x‖) ^ p) =
      (ENNReal.ofReal K) ^ p *
        ∫⁻ x, (ENNReal.ofReal ‖g x‖) ^ p := by
  have hpoint (x : E3) :
      (ENNReal.ofReal ‖(K : ℂ) • g x‖) ^ p =
        (ENNReal.ofReal K) ^ p * (ENNReal.ofReal ‖g x‖) ^ p := by
    rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hK,
      ENNReal.ofReal_mul hK, ENNReal.mul_rpow_of_nonneg _ _ hp]
  calc
    (∫⁻ x, (ENNReal.ofReal ‖(K : ℂ) • g x‖) ^ p) =
        ∫⁻ x, (ENNReal.ofReal K) ^ p * (ENNReal.ofReal ‖g x‖) ^ p := by
          apply lintegral_congr
          intro x
          exact hpoint x
    _ = (ENNReal.ofReal K) ^ p *
        ∫⁻ x, (ENNReal.ofReal ‖g x‖) ^ p := by
          rw [lintegral_const_mul]
          exact (hg.norm.ennreal_ofReal.pow measurable_const)

/-- The explicit one-coordinate strong-type factor, including one shell
constant from the bracket-to-dyadic comparison. -/
noncomputable def dyadicStrongFactor (K p : ℝ) : ℝ≥0∞ :=
  (ENNReal.ofReal K) ^ p *
    (ENNReal.ofReal p *
      (2 * ENNReal.ofReal 4 * (ENNReal.ofReal (p - 1))⁻¹ *
        (ENNReal.ofReal (2 : ℝ)) ^ (p - 1)))

/-- Three successive literal-coordinate dyadic maximal operations have an
explicit strong `L^p` bound.  This is the quantitative upgrade of the
earlier `MemLp`-only terminal. -/
theorem scaledIteratedCoordinateDyadicBallMaximal_lintegral_bound
    (K : ℝ) (hK : 0 ≤ K) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ x, ‖f x‖ ≤ A)
    {p : ℝ} (hp : 1 < p) :
    (∫⁻ x, (ENNReal.ofReal
      ‖scaledIteratedCoordinateDyadicBallMaximal K f x‖) ^ p) ≤
      (dyadicStrongFactor K p) ^ 3 *
        ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := by
  let D : ℝ≥0∞ := ENNReal.ofReal p *
    (2 * ENNReal.ofReal 4 * (ENNReal.ofReal (p - 1))⁻¹ *
      (ENNReal.ofReal (2 : ℝ)) ^ (p - 1))
  let k : ℝ≥0∞ := (ENNReal.ofReal K) ^ p
  let f₀ : E3 → ℂ := coordinateDyadicBallMaximalComplex 0 f
  let g₀ : E3 → ℂ := (K : ℂ) • f₀
  let f₁ : E3 → ℂ := coordinateDyadicBallMaximalComplex 1 g₀
  let g₁ : E3 → ℂ := (K : ℂ) • f₁
  let f₂ : E3 → ℂ := coordinateDyadicBallMaximalComplex 2 g₁
  have hnormK : ‖(K : ℂ)‖ = K := by
    simpa only [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hK]
  have hf₀ : Measurable f₀ := by
    dsimp only [f₀]
    exact coordinateDyadicBallMaximalComplex_measurable 0 f hf
  have hbound₀ : ∀ x, ‖f₀ x‖ ≤ A := by
    dsimp only [f₀]
    exact coordinateDyadicBallMaximalComplex_top_bound 0 f A hA hbound
  have hD₀ : (∫⁻ x, (ENNReal.ofReal ‖f₀ x‖) ^ p) ≤
      D * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := by
    simpa only [D, mul_assoc] using
      (coordinateDyadicBallMaximalComplex_lintegral_bound
        0 f hf A hA hbound hp)
  have hg₀ : Measurable g₀ := by
    dsimp only [g₀]
    exact hf₀.const_smul (K : ℂ)
  have hKA : 0 ≤ K * A := mul_nonneg hK hA
  have hboundg₀ : ∀ x, ‖g₀ x‖ ≤ K * A := by
    intro x
    change ‖(K : ℂ) • f₀ x‖ ≤ K * A
    rw [norm_smul, hnormK]
    exact mul_le_mul_of_nonneg_left (hbound₀ x) hK
  have hf₁ : Measurable f₁ := by
    dsimp only [f₁]
    exact coordinateDyadicBallMaximalComplex_measurable 1 g₀ hg₀
  have hbound₁ : ∀ x, ‖f₁ x‖ ≤ K * A := by
    dsimp only [f₁]
    exact coordinateDyadicBallMaximalComplex_top_bound 1 g₀
      (K * A) hKA hboundg₀
  have hD₁ : (∫⁻ x, (ENNReal.ofReal ‖f₁ x‖) ^ p) ≤
      D * ∫⁻ x, (ENNReal.ofReal ‖g₀ x‖) ^ p := by
    simpa only [D, mul_assoc] using
      (coordinateDyadicBallMaximalComplex_lintegral_bound
        1 g₀ hg₀ (K * A) hKA hboundg₀ hp)
  have hg₁ : Measurable g₁ := by
    dsimp only [g₁]
    exact hf₁.const_smul (K : ℂ)
  have hKKA : 0 ≤ K * (K * A) := mul_nonneg hK hKA
  have hboundg₁ : ∀ x, ‖g₁ x‖ ≤ K * (K * A) := by
    intro x
    change ‖(K : ℂ) • f₁ x‖ ≤ K * (K * A)
    rw [norm_smul, hnormK]
    exact mul_le_mul_of_nonneg_left (hbound₁ x) hK
  have hf₂ : Measurable f₂ := by
    dsimp only [f₂]
    exact coordinateDyadicBallMaximalComplex_measurable 2 g₁ hg₁
  have hD₂ : (∫⁻ x, (ENNReal.ofReal ‖f₂ x‖) ^ p) ≤
      D * ∫⁻ x, (ENNReal.ofReal ‖g₁ x‖) ^ p := by
    simpa only [D, mul_assoc] using
      (coordinateDyadicBallMaximalComplex_lintegral_bound
        2 g₁ hg₁ (K * (K * A)) hKKA hboundg₁ hp)
  have hk₀ : (∫⁻ x, (ENNReal.ofReal ‖g₀ x‖) ^ p) =
      k * ∫⁻ x, (ENNReal.ofReal ‖f₀ x‖) ^ p := by
    simpa only [g₀, Pi.smul_apply, k] using
      (lintegral_norm_const_smul_rpow K hK f₀ hf₀ (by linarith))
  have hk₁ : (∫⁻ x, (ENNReal.ofReal ‖g₁ x‖) ^ p) =
      k * ∫⁻ x, (ENNReal.ofReal ‖f₁ x‖) ^ p := by
    simpa only [g₁, Pi.smul_apply, k] using
      (lintegral_norm_const_smul_rpow K hK f₁ hf₁ (by linarith))
  have hG₀ : (∫⁻ x, (ENNReal.ofReal ‖g₀ x‖) ^ p) ≤
      (k * D) * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := by
    calc
      (∫⁻ x, (ENNReal.ofReal ‖g₀ x‖) ^ p) =
          k * ∫⁻ x, (ENNReal.ofReal ‖f₀ x‖) ^ p := hk₀
      _ ≤ k * (D * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p) :=
        mul_le_mul_of_nonneg_left hD₀ bot_le
      _ = (k * D) * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := by ring
  have hG₁ : (∫⁻ x, (ENNReal.ofReal ‖g₁ x‖) ^ p) ≤
      (k * D) ^ 2 * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := by
    calc
      (∫⁻ x, (ENNReal.ofReal ‖g₁ x‖) ^ p) =
          k * ∫⁻ x, (ENNReal.ofReal ‖f₁ x‖) ^ p := hk₁
      _ ≤ k * (D * ∫⁻ x, (ENNReal.ofReal ‖g₀ x‖) ^ p) :=
        mul_le_mul_of_nonneg_left hD₁ bot_le
      _ ≤ k * (D * ((k * D) * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p)) :=
        mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_left hG₀ bot_le) bot_le
      _ = (k * D) ^ 2 * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := by ring
  have hk₂ : (∫⁻ x, (ENNReal.ofReal ‖(K : ℂ) • f₂ x‖) ^ p) =
      k * ∫⁻ x, (ENNReal.ofReal ‖f₂ x‖) ^ p := by
    simpa only [k] using
      (lintegral_norm_const_smul_rpow K hK f₂ hf₂ (by linarith))
  change (∫⁻ x, (ENNReal.ofReal ‖(K : ℂ) • f₂ x‖) ^ p) ≤ _
  calc
    (∫⁻ x, (ENNReal.ofReal ‖(K : ℂ) • f₂ x‖) ^ p) =
        k * ∫⁻ x, (ENNReal.ofReal ‖f₂ x‖) ^ p := hk₂
    _ ≤ k * (D * ∫⁻ x, (ENNReal.ofReal ‖g₁ x‖) ^ p) :=
      mul_le_mul_of_nonneg_left hD₂ bot_le
    _ ≤ k * (D * ((k * D) ^ 2 *
        ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p)) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hG₁ bot_le) bot_le
    _ = (dyadicStrongFactor K p) ^ 3 *
        ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := by
      dsimp only [dyadicStrongFactor, k, D]
      ring


/-- The explicit three-coordinate strong factor is finite above the
strong-type endpoint. -/
theorem dyadicStrongFactor_ne_top
    (K p : ℝ) (hp : 1 < p) :
    dyadicStrongFactor K p ≠ ∞ := by
  unfold dyadicStrongFactor
  apply ENNReal.mul_ne_top
  · apply ne_of_lt
    exact ENNReal.rpow_lt_top_of_nonneg (by linarith) ENNReal.ofReal_ne_top
  · apply ENNReal.mul_ne_top ENNReal.ofReal_ne_top
    apply ENNReal.mul_ne_top
    · apply ENNReal.mul_ne_top
      · exact ENNReal.mul_ne_top (by norm_num) ENNReal.ofReal_ne_top
      · apply ne_of_lt
        exact ENNReal.inv_lt_top.mpr (ENNReal.ofReal_pos.mpr (by linarith))
    · apply ne_of_lt
      exact ENNReal.rpow_lt_top_of_nonneg (by linarith) ENNReal.ofReal_ne_top

/-- Convert the raw `lintegral` strong estimate to the ordinary nonnegative
real integral used by the stopping distribution. -/
theorem scaledIteratedCoordinateDyadicBallMaximal_integral_bound
    (K : ℝ) (hK : 0 ≤ K) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ x, ‖f x‖ ≤ A)
    {p : ℝ} (hp : 1 < p) (hfp : MemLp f (ENNReal.ofReal p) volume) :
    ∫ x : E3, ‖scaledIteratedCoordinateDyadicBallMaximal K f x‖ ^ p ≤
      (dyadicStrongFactor K p ^ 3).toReal *
        ∫ x : E3, ‖f x‖ ^ p := by
  let G := scaledIteratedCoordinateDyadicBallMaximal K f
  have hp0 : 0 < p := by linarith
  have hGmem : MemLp G (ENNReal.ofReal p) volume := by
    dsimp only [G]
    exact scaledIteratedCoordinateDyadicBallMaximal_memLp
      K hK f hf A hA hbound hp hfp
  have hGin : Integrable (fun x : E3 ↦ ‖G x‖ ^ p) := by
    have h := hGmem.integrable_norm_rpow
      (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top
    simpa only [ENNReal.toReal_ofReal hp0.le] using h
  have hfin : Integrable (fun x : E3 ↦ ‖f x‖ ^ p) := by
    have h := hfp.integrable_norm_rpow
      (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top
    simpa only [ENNReal.toReal_ofReal hp0.le] using h
  have hG_eq :
      (∫⁻ x, (ENNReal.ofReal ‖G x‖) ^ p) =
        ENNReal.ofReal (∫ x : E3, ‖G x‖ ^ p) := by
    calc
      (∫⁻ x, (ENNReal.ofReal ‖G x‖) ^ p) =
          ∫⁻ x, ENNReal.ofReal (‖G x‖ ^ p) := by
            apply lintegral_congr
            intro x
            exact ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp0.le
      _ = ENNReal.ofReal (∫ x : E3, ‖G x‖ ^ p) := by
            exact (ofReal_integral_eq_lintegral_ofReal hGin
              (Filter.Eventually.of_forall fun x ↦
                Real.rpow_nonneg (norm_nonneg _) _)).symm
  have hfin_eq :
      (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p) =
        ENNReal.ofReal (∫ x : E3, ‖f x‖ ^ p) := by
    calc
      (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p) =
          ∫⁻ x, ENNReal.ofReal (‖f x‖ ^ p) := by
            apply lintegral_congr
            intro x
            exact ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp0.le
      _ = ENNReal.ofReal (∫ x : E3, ‖f x‖ ^ p) := by
            exact (ofReal_integral_eq_lintegral_ofReal hfin
              (Filter.Eventually.of_forall fun x ↦
                Real.rpow_nonneg (norm_nonneg _) _)).symm
  have hraw := scaledIteratedCoordinateDyadicBallMaximal_lintegral_bound
    K hK f hf A hA hbound hp
  have hfactor : (dyadicStrongFactor K p ^ 3 : ℝ≥0∞) ≠ ∞ := by
    exact ENNReal.pow_ne_top (dyadicStrongFactor_ne_top K p hp)
  have hrighttop :
      (dyadicStrongFactor K p ^ 3 : ℝ≥0∞) *
        ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ≠ ∞ := by
    apply ENNReal.mul_ne_top hfactor
    rw [hfin_eq]
    exact ENNReal.ofReal_ne_top
  have hlefttop : (∫⁻ x, (ENNReal.ofReal ‖G x‖) ^ p) ≠ ∞ :=
    ne_top_of_le_ne_top hrighttop hraw
  have htoReal :=
    (ENNReal.toReal_le_toReal hlefttop hrighttop).mpr hraw
  change ∫ x : E3, ‖G x‖ ^ p ≤ _
  rw [hG_eq, hfin_eq] at htoReal
  rw [ENNReal.toReal_mul,
    ENNReal.toReal_ofReal (integral_nonneg fun x ↦
      Real.rpow_nonneg (norm_nonneg (G x)) _),
    ENNReal.toReal_ofReal (integral_nonneg fun x ↦
      Real.rpow_nonneg (norm_nonneg (f x)) _)] at htoReal
  exact htoReal


/-- The zero-shift dominant-envelope algebra and the scalar layer-cake
estimate reduce the complete finite stopping envelope to four integrable
coordinate majorants. -/
theorem sourceStoppingCoordinateEnvelope_le_of_zero_shift_majorants
    (α : Anisotropy) (S : BoxCollection α) (f : ModelRealInput)
    (q : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hpos : ∀ s ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) s)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (h : Fin 4 → E3 → ℝ)
    (hmajor : ∀ j x, sourceStoppingMaximal α f j x ≤ h j x)
    (hnonneg : ∀ j x, 0 ≤ h j x)
    (hmeas : ∀ j, Measurable (fun x : E3 ↦ h j x ^ q j))
    (hint : ∀ j, Integrable (fun x : E3 ↦ h j x ^ q j)) :
    SourceStoppingCoordinateEnvelope α S f q (fun _ ↦ 0) hpos ≤
      ∑ j : Fin 4, 8 *
        (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
          (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
            ∫ x : E3, h j x ^ q j) := by
  let L : Fin 4 → ℝ := fun j ↦
    ((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
      (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
        ∫ x : E3, h j x ^ q j
  apply SourceStoppingCoordinateEnvelope_le_of_dominant_weight_bound
    α S f q (fun _ ↦ 0) q (fun _ ↦ 8) L hpos
  · intro j
    norm_num
  · intro j m
    rw [sourceStoppingDominantFiberEnvelope_zero_eq q hq hsum j m]
  · intro j
    let N : Finset ℤ :=
      (activeStoppingLevels α S sourceStoppingExponent f hpos).filter
        (fun n ↦ sourceStoppingDominantIndex q (fun _ ↦ 0) n = j) |>.image
          (fun n ↦ n j)
    have hscalar := sum_sourceStoppingLevel_rpow_weight_le_integral_majorant
      α f j (q j) (h j) hcont hbound (hq j)
      (hmajor j) (hnonneg j) (hmeas j) (hint j) N
    change (∑ m ∈ N,
      (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal *
        (2 : ℝ) ^ (q j * (m : ℝ))) ≤ L j
    simpa only [L, mul_comm] using hscalar


/-- Pointwise multiplication closes real Schwartz inputs under the precise
power representatives needed by the two- and four-moment stopping sizes. -/
noncomputable def realSchwartzProduct
    (f g : SchwartzMap E3 ℝ) : SchwartzMap E3 ℝ :=
  SchwartzMap.smulLeftCLM ℝ (f : E3 → ℝ) g

@[simp] theorem realSchwartzProduct_apply
    (f g : SchwartzMap E3 ℝ) (x : E3) :
    realSchwartzProduct f g x = f x * g x := by
  simp [realSchwartzProduct, f.hasTemperateGrowth]

noncomputable def realSchwartzSquare
    (f : SchwartzMap E3 ℝ) : SchwartzMap E3 ℝ :=
  realSchwartzProduct f f

@[simp] theorem realSchwartzSquare_apply
    (f : SchwartzMap E3 ℝ) (x : E3) :
    realSchwartzSquare f x = f x ^ 2 := by
  simp [realSchwartzSquare, pow_two]

noncomputable def realSchwartzFourth
    (f : SchwartzMap E3 ℝ) : SchwartzMap E3 ℝ :=
  realSchwartzSquare (realSchwartzSquare f)

@[simp] theorem realSchwartzFourth_apply
    (f : SchwartzMap E3 ℝ) (x : E3) :
    realSchwartzFourth f x = f x ^ 4 := by
  simp [realSchwartzFourth, pow_succ]
  ring

/-- The shell-scaled iterated dyadic operator is measurable whenever its
input is measurable. -/
theorem scaledIteratedCoordinateDyadicBallMaximal_measurable
    (K : ℝ) (f : E3 → ℂ) (hf : Measurable f) :
    Measurable (scaledIteratedCoordinateDyadicBallMaximal K f) := by
  let f₀ := coordinateDyadicBallMaximalComplex (0 : Fin 3) f
  let g₀ : E3 → ℂ := (K : ℂ) • f₀
  let f₁ := coordinateDyadicBallMaximalComplex (1 : Fin 3) g₀
  let g₁ : E3 → ℂ := (K : ℂ) • f₁
  let f₂ := coordinateDyadicBallMaximalComplex (2 : Fin 3) g₁
  have hf₀ : Measurable f₀ := by
    dsimp only [f₀]
    exact coordinateDyadicBallMaximalComplex_measurable 0 f hf
  have hg₀ : Measurable g₀ := by
    dsimp only [g₀]
    exact hf₀.const_smul (K : ℂ)
  have hf₁ : Measurable f₁ := by
    dsimp only [f₁]
    exact coordinateDyadicBallMaximalComplex_measurable 1 g₀ hg₀
  have hg₁ : Measurable g₁ := by
    dsimp only [g₁]
    exact hf₁.const_smul (K : ℂ)
  have hf₂ : Measurable f₂ := by
    dsimp only [f₂]
    exact coordinateDyadicBallMaximalComplex_measurable 2 g₁ hg₁
  change Measurable ((K : ℂ) • f₂)
  exact hf₂.const_smul (K : ℂ)

/-- The positive real root of a measurable complex majorant is measurable. -/
theorem measurable_norm_rpow
    (G : E3 → ℂ) (hG : Measurable G) (s : ℝ) (hs : 0 ≤ s) :
    Measurable (fun x : E3 ↦ ‖G x‖ ^ s) := by
  exact (Real.continuous_rpow_const hs).measurable.comp hG.norm

/-- The `q`-power of an `s`-root majorant is integrable if the unrooted
majorant belongs to `L^(q/s)`.  This is the exact scalar conversion needed by
the stopping layer-cake estimate. -/
theorem integrable_norm_rpow_inv_rpow_of_memLp
    (G : E3 → ℂ) (_hG : Measurable G) (q s : ℝ)
    (hq : 0 < q) (hs : 0 < s)
    (hmem : MemLp G (ENNReal.ofReal (q / s)) volume) :
    Integrable (fun x : E3 ↦ (‖G x‖ ^ s⁻¹) ^ q) volume := by
  have hqdiv : 0 < q / s := div_pos hq hs
  have hbase := hmem.integrable_norm_rpow
    (ne_of_gt (ENNReal.ofReal_pos.mpr hqdiv)) ENNReal.ofReal_ne_top
  have hbase' : Integrable (fun x : E3 ↦ ‖G x‖ ^ (q / s)) volume := by
    simpa [ENNReal.toReal_ofReal hqdiv.le] using hbase
  apply hbase'.congr
  filter_upwards [] with x
  rw [← Real.rpow_mul (norm_nonneg (G x))]
  congr 1
  field_simp

/-- The same root conversion supplies the literal measurable `q`-power used
by the finite stopping envelope. -/
theorem measurable_norm_rpow_inv_rpow
    (G : E3 → ℂ) (hG : Measurable G) (q s : ℝ)
    (hq : 0 < q) (hs : 0 < s) :
    Measurable (fun x : E3 ↦ (‖G x‖ ^ s⁻¹) ^ q) := by
  have heq : (fun x : E3 ↦ (‖G x‖ ^ s⁻¹) ^ q) =
      (fun x : E3 ↦ ‖G x‖ ^ (s⁻¹ * q)) := by
    funext x
    exact (Real.rpow_mul (norm_nonneg (G x)) s⁻¹ q).symm
  rw [heq]
  apply measurable_norm_rpow G hG
  positivity

/-- The stopping exponent is always the positive integer `2` or `4`. -/
theorem sourceStoppingExponent_pos (j : Fin 4) :
    0 < sourceStoppingExponent j := by
  by_cases hj : j = 3
  · simp [sourceStoppingExponent, hj]
  · simp [sourceStoppingExponent, hj]

/-- The Schwartz power representative paired to a source stopping coordinate.
For coordinate three it is the square, and for the other three coordinates it
is the fourth power. -/
noncomputable def sourceStoppingPowerRepresentative
    (F : InitialModelSchwartzInput) (j : Fin 4) : SchwartzMap E3 ℝ :=
  if j = 3 then realSchwartzSquare (F j)
  else realSchwartzFourth (F j)

@[simp] theorem sourceStoppingPowerRepresentative_apply_of_eq_three
    (F : InitialModelSchwartzInput) {j : Fin 4} (hj : j = 3) (x : E3) :
    sourceStoppingPowerRepresentative F j x = (F j x) ^ 2 := by
  simp [sourceStoppingPowerRepresentative, hj]

@[simp] theorem sourceStoppingPowerRepresentative_apply_of_ne_three
    (F : InitialModelSchwartzInput) {j : Fin 4} (hj : j ≠ 3) (x : E3) :
    sourceStoppingPowerRepresentative F j x = (F j x) ^ 4 := by
  simp [sourceStoppingPowerRepresentative, hj]

/-- The complex dyadic majorant associated to the appropriate integral power
of each initial real Schwartz component. -/
noncomputable def sourceStoppingPowerMajorant
    (K : Fin 4 → ℝ) (F : InitialModelSchwartzInput) (j : Fin 4) : E3 → ℂ :=
  scaledIteratedCoordinateDyadicBallMaximal (K j)
    (complexifyRealSchwartz (sourceStoppingPowerRepresentative F j))

/-- The scalar majorant used in the stopping layer-cake: take the `2`nd or
`4`th root only after the full three-coordinate dyadic iteration. -/
noncomputable def sourceStoppingRootMajorant
    (K : Fin 4 → ℝ) (F : InitialModelSchwartzInput) (j : Fin 4) : E3 → ℝ :=
  fun x ↦ ‖sourceStoppingPowerMajorant K F j x‖ ^
    (sourceStoppingExponent j)⁻¹

theorem sourceStoppingPowerMajorant_measurable
    (K : Fin 4 → ℝ) (F : InitialModelSchwartzInput) (j : Fin 4) :
    Measurable (sourceStoppingPowerMajorant K F j) := by
  unfold sourceStoppingPowerMajorant
  apply scaledIteratedCoordinateDyadicBallMaximal_measurable
  exact (complexifyRealSchwartz
    (sourceStoppingPowerRepresentative F j)).continuous.measurable

/-- The dyadic majorant of the requisite power representative belongs to
`L^(q/s)` whenever the source exponent `s` is strictly below `q`. -/
theorem sourceStoppingPowerMajorant_memLp
    (K : Fin 4 → ℝ) (hK : ∀ j, 0 ≤ K j)
    (F : InitialModelSchwartzInput) (j : Fin 4) (q : ℝ)
    (hqs : sourceStoppingExponent j < q) :
    MemLp (sourceStoppingPowerMajorant K F j)
      (ENNReal.ofReal (q / sourceStoppingExponent j)) volume := by
  have hs : 0 < sourceStoppingExponent j := sourceStoppingExponent_pos j
  have hp : 1 < q / sourceStoppingExponent j := by
    rw [lt_div_iff₀ hs]
    simpa using hqs
  unfold sourceStoppingPowerMajorant
  exact scaledIteratedCoordinateDyadicBallMaximal_memLp_of_realSchwartz
    (K j) (hK j) (sourceStoppingPowerRepresentative F j) hp

theorem sourceStoppingRootMajorant_nonneg
    (K : Fin 4 → ℝ) (F : InitialModelSchwartzInput) (j : Fin 4) (x : E3) :
    0 ≤ sourceStoppingRootMajorant K F j x := by
  unfold sourceStoppingRootMajorant
  exact Real.rpow_nonneg (norm_nonneg _) _

theorem sourceStoppingRootMajorant_power_measurable
    (K : Fin 4 → ℝ) (F : InitialModelSchwartzInput) (j : Fin 4) (q : ℝ)
    (hq : 0 < q) :
    Measurable (fun x : E3 ↦
      sourceStoppingRootMajorant K F j x ^ q) := by
  unfold sourceStoppingRootMajorant
  exact measurable_norm_rpow_inv_rpow _
    (sourceStoppingPowerMajorant_measurable K F j) q
    (sourceStoppingExponent j) hq (sourceStoppingExponent_pos j)

theorem sourceStoppingRootMajorant_power_integrable
    (K : Fin 4 → ℝ) (hK : ∀ j, 0 ≤ K j)
    (F : InitialModelSchwartzInput) (j : Fin 4) (q : ℝ)
    (hqs : sourceStoppingExponent j < q) :
    Integrable (fun x : E3 ↦
      sourceStoppingRootMajorant K F j x ^ q) volume := by
  have hq : 0 < q :=
    (sourceStoppingExponent_pos j).trans hqs
  unfold sourceStoppingRootMajorant
  exact integrable_norm_rpow_inv_rpow_of_memLp _
    (sourceStoppingPowerMajorant_measurable K F j) q
    (sourceStoppingExponent j) hq (sourceStoppingExponent_pos j)
    (sourceStoppingPowerMajorant_memLp K hK F j q hqs)

/-- In particular, the root majorant itself is in the intended stopping
space `L^q` whenever `q` lies strictly above the associated source exponent. -/
theorem sourceStoppingRootMajorant_memLp
    (K : Fin 4 → ℝ) (hK : ∀ j, 0 ≤ K j)
    (F : InitialModelSchwartzInput) (j : Fin 4) (q : ℝ)
    (hqs : sourceStoppingExponent j < q) :
    MemLp (sourceStoppingRootMajorant K F j)
      (ENNReal.ofReal q) volume := by
  have hq : 0 < q := (sourceStoppingExponent_pos j).trans hqs
  have hmeas : Measurable (sourceStoppingRootMajorant K F j) := by
    unfold sourceStoppingRootMajorant
    exact measurable_norm_rpow _
      (sourceStoppingPowerMajorant_measurable K F j) _
      (inv_nonneg.mpr (sourceStoppingExponent_pos j).le)
  apply (integrable_norm_rpow_iff hmeas.aestronglyMeasurable
    (ne_of_gt (ENNReal.ofReal_pos.mpr hq)) ENNReal.ofReal_ne_top).mp
  have hint := sourceStoppingRootMajorant_power_integrable
    K hK F j q hqs
  apply hint.congr
  filter_upwards [] with x
  rw [ENNReal.toReal_ofReal hq.le, Real.norm_eq_abs,
    abs_of_nonneg (sourceStoppingRootMajorant_nonneg K F j x)]

/-- The quantitative three-coordinate dyadic estimate specialized to the
power representative at one stopping coordinate.  This is still expressed
in terms of that representative, before the elementary `s`th-power algebra
returns to the original input. -/
theorem sourceStoppingPowerMajorant_integral_bound
    (K : Fin 4 → ℝ) (hK : ∀ j, 0 ≤ K j)
    (F : InitialModelSchwartzInput) (j : Fin 4) (q : ℝ)
    (hqs : sourceStoppingExponent j < q) :
    (∫ x : E3, ‖sourceStoppingPowerMajorant K F j x‖ ^
      (q / sourceStoppingExponent j)) ≤
      ((dyadicStrongFactor (K j)
        (q / sourceStoppingExponent j)) ^ 3).toReal *
        ∫ x : E3, ‖complexifyRealSchwartz
          (sourceStoppingPowerRepresentative F j) x‖ ^
          (q / sourceStoppingExponent j) := by
  let s : ℝ := sourceStoppingExponent j
  let p : ℝ := q / s
  have hs : 0 < s := by
    dsimp only [s]
    exact sourceStoppingExponent_pos j
  have hp : 1 < p := by
    dsimp only [p]
    rw [lt_div_iff₀ hs]
    simpa only [s, one_mul] using hqs
  let f : E3 → ℂ := complexifyRealSchwartz
    (sourceStoppingPowerRepresentative F j)
  let G : E3 → ℂ := sourceStoppingPowerMajorant K F j
  rcases schwartz_continuous_bounded
    (complexifyRealSchwartz (sourceStoppingPowerRepresentative F j)) with
    ⟨hcont, A, hA, hbound⟩
  have hf : Measurable f := by
    dsimp only [f]
    exact hcont.measurable
  have hboundf : ∀ x, ‖f x‖ ≤ A := by
    simpa only [f] using hbound
  have hfp : MemLp f (ENNReal.ofReal p) volume := by
    dsimp only [f]
    exact schwartz_memLp (complexifyRealSchwartz
      (sourceStoppingPowerRepresentative F j)) (ENNReal.ofReal p)
  change (∫ x : E3, ‖G x‖ ^ p) ≤
    ((dyadicStrongFactor (K j) p) ^ 3).toReal *
      ∫ x : E3, ‖f x‖ ^ p
  dsimp only [G]
  exact scaledIteratedCoordinateDyadicBallMaximal_integral_bound
    (K j) (hK j) f hf A hA hboundf hp hfp

/-- The `L^(q/s)` power of the squared/fourth-powered Schwartz representative
is exactly the `L^q` power of the original real input. -/
theorem sourceStoppingPowerRepresentative_norm_rpow_eq_input_rpow
    (F : InitialModelSchwartzInput) (j : Fin 4) (q : ℝ) (x : E3) :
    ‖complexifyRealSchwartz (sourceStoppingPowerRepresentative F j) x‖ ^
      (q / sourceStoppingExponent j) = |F j x| ^ q := by
  by_cases hj : j = 3
  · subst j
    rw [complexifyRealSchwartz_apply,
      sourceStoppingPowerRepresentative_apply_of_eq_three F rfl,
      Complex.norm_real, Real.norm_eq_abs,
      abs_pow]
    rw [show sourceStoppingExponent 3 = 2 by simp [sourceStoppingExponent],
      ← Real.rpow_natCast (|F 3 x|) 2,
      ← Real.rpow_mul (abs_nonneg (F 3 x))]
    congr 1
    field_simp
    ring

  · rw [complexifyRealSchwartz_apply,
      sourceStoppingPowerRepresentative_apply_of_ne_three F hj,
      Complex.norm_real, Real.norm_eq_abs,
      abs_pow]
    rw [sourceStoppingExponent_eq_four_of_ne_three hj,
      ← Real.rpow_natCast (|F j x|) 4,
      ← Real.rpow_mul (abs_nonneg (F j x))]
    congr 1
    field_simp
    ring

/-- The coefficient multiplying each scalar distribution integral is
nonnegative as soon as its stopping exponent is positive. -/
theorem sourceStoppingDistributionCoefficient_nonneg
    (j : Fin 4) (q : ℝ) (hq : 0 < q) :
    0 ≤ 8 * ((1 - ((2 : ℝ) ^ q)⁻¹)⁻¹ *
      (sourceStoppingComparisonConstant j / 2) ^ (-q)) := by
  have hpow : 1 < (2 : ℝ) ^ q :=
    Real.one_lt_rpow (by norm_num) hq
  have hpowpos : 0 < (2 : ℝ) ^ q :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hden : 0 < 1 - ((2 : ℝ) ^ q)⁻¹ := by
    exact sub_pos.mpr ((inv_lt_one₀ hpowpos).mpr hpow)
  have hconst : 0 < sourceStoppingComparisonConstant j / 2 :=
    div_pos (sourceStoppingComparisonConstant_pos j) (by norm_num)
  exact (mul_pos (by norm_num)
    (mul_pos (inv_pos.mpr hden) (Real.rpow_pos_of_pos hconst _))).le

/-- The explicit scalar multiplying the `q_j`-power integral of one initial
input after the three-coordinate dyadic strong-type estimate. -/
noncomputable def sourceStoppingDyadicInputConstant
    (K q : Fin 4 → ℝ) (j : Fin 4) : ℝ :=
  8 * (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
    (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
      (dyadicStrongFactor (K j)
        (q j / sourceStoppingExponent j) ^ 3).toReal)

/-- The weighted scalar distribution term for one coordinate is controlled
by its original `q_j`-power input integral, with a fully explicit constant. -/
theorem weightedPowerMajorantIntegral_le_inputPowerIntegral
    (K q : Fin 4 → ℝ) (hK : ∀ j, 0 ≤ K j)
    (F : InitialModelSchwartzInput) (j : Fin 4)
    (hq : 0 < q j) (hqs : sourceStoppingExponent j < q j) :
    8 * (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
      (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
        ∫ x : E3, ‖sourceStoppingPowerMajorant K F j x‖ ^
          (q j / sourceStoppingExponent j)) ≤
      sourceStoppingDyadicInputConstant K q j *
        ∫ x : E3, |F j x| ^ q j := by
  let c : ℝ := 8 * ((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
    (sourceStoppingComparisonConstant j / 2) ^ (-(q j)))
  let D : ℝ := (dyadicStrongFactor (K j)
    (q j / sourceStoppingExponent j) ^ 3).toReal
  have hc : 0 ≤ c := by
    dsimp only [c]
    exact sourceStoppingDistributionCoefficient_nonneg j (q j) hq
  have hstrong := sourceStoppingPowerMajorant_integral_bound
    K hK F j (q j) hqs
  have hrep :
      (∫ x : E3, ‖complexifyRealSchwartz
        (sourceStoppingPowerRepresentative F j) x‖ ^
          (q j / sourceStoppingExponent j)) =
        ∫ x : E3, |F j x| ^ q j := by
    apply integral_congr_ae
    filter_upwards [] with x
    exact sourceStoppingPowerRepresentative_norm_rpow_eq_input_rpow
      F j (q j) x
  calc
    8 * (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
        (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
          ∫ x : E3, ‖sourceStoppingPowerMajorant K F j x‖ ^
            (q j / sourceStoppingExponent j)) =
        c * (∫ x : E3, ‖sourceStoppingPowerMajorant K F j x‖ ^
          (q j / sourceStoppingExponent j)) := by
        dsimp only [c]
        ring
    _ ≤ c * (D * ∫ x : E3, ‖complexifyRealSchwartz
          (sourceStoppingPowerRepresentative F j) x‖ ^
            (q j / sourceStoppingExponent j)) :=
      mul_le_mul_of_nonneg_left hstrong hc
    _ = sourceStoppingDyadicInputConstant K q j *
        ∫ x : E3, |F j x| ^ q j := by
      rw [hrep]
      dsimp only [sourceStoppingDyadicInputConstant, c, D]
      ring

/-- A uniform fixed-scale scalar bound closes the literal real supremum in
the second maximal power without any additional analytic loss. -/
theorem anisotropicMaximalTwoPower_le_of_fixedScale_scalar_bound
    (α : Anisotropy) (f : SchwartzMap E3 ℝ) (H : E3 → ℝ)
    (hfixed : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      cubeSecondMoment α t x f ≤ H x)
    (x : E3) :
    anisotropicMaximalTwoPower α f x ≤ H x := by
  unfold anisotropicMaximalTwoPower
  apply csSup_le
  · exact ⟨cubeSecondMoment α 1 x f, ⟨1, by norm_num, rfl⟩⟩
  · rintro a ⟨t, ht, rfl⟩
    exact hfixed t ht x

/-- The same all-scale closure for the fourth maximal power. -/
theorem anisotropicMaximalFourPower_le_of_fixedScale_scalar_bound
    (α : Anisotropy) (f : SchwartzMap E3 ℝ) (H : E3 → ℝ)
    (hfixed : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      fourthMoment α t x f ≤ H x)
    (x : E3) :
    anisotropicMaximalFourPower α f x ≤ H x := by
  unfold anisotropicMaximalFourPower
  apply csSup_le
  · exact ⟨fourthMoment α 1 x f, ⟨1, by norm_num, rfl⟩⟩
  · rintro a ⟨t, ht, rfl⟩
    exact hfixed t ht x

/-- The literal source stopping maximal is controlled by the root of its
three-coordinate dyadic power majorant once the second/fourth fixed-scale
kernel bounds have been supplied. -/
theorem sourceStoppingMaximal_le_rootMajorant_of_fixedScale
    (α : Anisotropy) (K : Fin 4 → ℝ) (F : InitialModelSchwartzInput)
    (htwo : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      cubeSecondMoment α t x (F 3) ≤
        ‖sourceStoppingPowerMajorant K F 3 x‖)
    (hfour : ∀ (j : Fin 4), j ≠ 3 → ∀ (t : ℝ), 0 < t → ∀ x : E3,
      fourthMoment α t x (F j) ≤
        ‖sourceStoppingPowerMajorant K F j x‖)
    (j : Fin 4) (x : E3) :
    sourceStoppingMaximal α (InitialModelRealInput F) j x ≤
      sourceStoppingRootMajorant K F j x := by
  by_cases hj : j = 3
  · subst j
    change √(anisotropicMaximalTwoPower α (F 3) x) ≤
      ‖sourceStoppingPowerMajorant K F 3 x‖ ^
        (sourceStoppingExponent 3)⁻¹
    have hpower : anisotropicMaximalTwoPower α (F 3) x ≤
        ‖sourceStoppingPowerMajorant K F 3 x‖ :=
      anisotropicMaximalTwoPower_le_of_fixedScale_scalar_bound
        α (F 3) _ htwo x
    calc
      √(anisotropicMaximalTwoPower α (F 3) x) ≤
          √‖sourceStoppingPowerMajorant K F 3 x‖ :=
        Real.sqrt_le_sqrt hpower
      _ = ‖sourceStoppingPowerMajorant K F 3 x‖ ^
          (sourceStoppingExponent 3)⁻¹ := by
        rw [Real.sqrt_eq_rpow]
        simp [sourceStoppingExponent]
  · simp only [sourceStoppingMaximal, hj, ite_false]
    unfold sourceStoppingRootMajorant
    change anisotropicMaximalFourPower α (F j) x ^ ((4 : ℝ)⁻¹) ≤
      ‖sourceStoppingPowerMajorant K F j x‖ ^
        (sourceStoppingExponent j)⁻¹
    have hpower : anisotropicMaximalFourPower α (F j) x ≤
        ‖sourceStoppingPowerMajorant K F j x‖ :=
      anisotropicMaximalFourPower_le_of_fixedScale_scalar_bound
        α (F j) _ (hfour j hj) x
    rcases initialModelRealInput_bounded F j with ⟨B, hB, hbound⟩
    have hpower_nonneg : 0 ≤ anisotropicMaximalFourPower α (F j) x :=
      anisotropicMaximalFourPower_nonneg_of_boundedContinuous α (F j)
        (F j).continuous B hB (by simpa [InitialModelRealInput] using hbound) x
    calc
      anisotropicMaximalFourPower α (F j) x ^ ((4 : ℝ)⁻¹) ≤
          ‖sourceStoppingPowerMajorant K F j x‖ ^ ((4 : ℝ)⁻¹) :=
        Real.rpow_le_rpow hpower_nonneg hpower (by positivity)
      _ = ‖sourceStoppingPowerMajorant K F j x‖ ^
          (sourceStoppingExponent j)⁻¹ := by
        rw [sourceStoppingExponent_eq_four_of_ne_three hj]

/-- The initial finite stopping distribution is bounded by the four literal
dyadic power-majorant integrals.  The only analytic inputs are the fixed-scale
second/fourth bracket bounds; all root, measurability, `L^(q/s)`, and
layer-cake bookkeeping is discharged here. -/
theorem initialSourceStoppingCoordinateEnvelope_le_powerDyadic
    (α : Anisotropy) (S : BoxCollection α) (F : InitialModelSchwartzInput)
    (q K : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j)
    (hK : ∀ j, 0 ≤ K j)
    (hFnonzero : ∀ j, F j ≠ 0)
    (htwo : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      cubeSecondMoment α t x (F 3) ≤
        ‖sourceStoppingPowerMajorant K F 3 x‖)
    (hfour : ∀ (j : Fin 4), j ≠ 3 → ∀ (t : ℝ), 0 < t → ∀ x : E3,
      fourthMoment α t x (F j) ≤
        ‖sourceStoppingPowerMajorant K F j x‖) :
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
      (fun _ ↦ 0)
      (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
      ∑ j : Fin 4, 8 *
        (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
          (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
            ∫ x : E3,
              sourceStoppingRootMajorant K F j x ^ q j) := by
  exact sourceStoppingCoordinateEnvelope_le_of_zero_shift_majorants
    α S (InitialModelRealInput F) q hq hsum
    (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero)
    (initialModelRealInput_continuous F) (initialModelRealInput_bounded F)
    (sourceStoppingRootMajorant K F)
    (fun j x ↦ sourceStoppingMaximal_le_rootMajorant_of_fixedScale
      α K F htwo hfour j x)
    (fun j x ↦ sourceStoppingRootMajorant_nonneg K F j x)
    (fun j ↦ sourceStoppingRootMajorant_power_measurable K F j
      (q j) (hq j))
    (fun j ↦ sourceStoppingRootMajorant_power_integrable K hK F j
      (q j) (hqs j))

/-- Equivalent product-norm-ready form of the initial stopping distribution:
the displayed integral is the `q_j / s_j` power integral of the unrooted
three-coordinate dyadic majorant. -/
theorem initialSourceStoppingCoordinateEnvelope_le_powerDyadic_unrooted
    (α : Anisotropy) (S : BoxCollection α) (F : InitialModelSchwartzInput)
    (q K : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j)
    (hK : ∀ j, 0 ≤ K j)
    (hFnonzero : ∀ j, F j ≠ 0)
    (htwo : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      cubeSecondMoment α t x (F 3) ≤
        ‖sourceStoppingPowerMajorant K F 3 x‖)
    (hfour : ∀ (j : Fin 4), j ≠ 3 → ∀ (t : ℝ), 0 < t → ∀ x : E3,
      fourthMoment α t x (F j) ≤
        ‖sourceStoppingPowerMajorant K F j x‖) :
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
      (fun _ ↦ 0)
      (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
      ∑ j : Fin 4, 8 *
        (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
          (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
            ∫ x : E3, ‖sourceStoppingPowerMajorant K F j x‖ ^
              (q j / sourceStoppingExponent j)) := by
  calc
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
        (fun _ ↦ 0)
        (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
        ∑ j : Fin 4, 8 *
          (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
            (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
              ∫ x : E3,
                sourceStoppingRootMajorant K F j x ^ q j) :=
      initialSourceStoppingCoordinateEnvelope_le_powerDyadic
        α S F q K hq hsum hqs hK hFnonzero htwo hfour
    _ = ∑ j : Fin 4, 8 *
        (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
          (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
            ∫ x : E3, ‖sourceStoppingPowerMajorant K F j x‖ ^
              (q j / sourceStoppingExponent j)) := by
      apply Finset.sum_congr rfl
      intro j _
      congr 2
      apply integral_congr_ae
      filter_upwards [] with x
      unfold sourceStoppingRootMajorant
      rw [← Real.rpow_mul (norm_nonneg _)]
      congr 1
      field_simp

/-- A quantitative dyadic `L^(q_j/s_j)` estimate for each powered input can
be substituted directly into the initial stopping distribution.  This is the
normalization-ready interface: later one takes `B_j` to be a fixed constant
times the `q_j`-power input norm. -/
theorem initialSourceStoppingCoordinateEnvelope_le_of_powerDyadic_bounds
    (α : Anisotropy) (S : BoxCollection α) (F : InitialModelSchwartzInput)
    (q K : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j)
    (hK : ∀ j, 0 ≤ K j)
    (hFnonzero : ∀ j, F j ≠ 0)
    (htwo : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      cubeSecondMoment α t x (F 3) ≤
        ‖sourceStoppingPowerMajorant K F 3 x‖)
    (hfour : ∀ (j : Fin 4), j ≠ 3 → ∀ (t : ℝ), 0 < t → ∀ x : E3,
      fourthMoment α t x (F j) ≤
        ‖sourceStoppingPowerMajorant K F j x‖)
    (B : Fin 4 → ℝ)
    (hB : ∀ j : Fin 4,
      8 * (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
        (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
          ∫ x : E3, ‖sourceStoppingPowerMajorant K F j x‖ ^
            (q j / sourceStoppingExponent j)) ≤ B j) :
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
      (fun _ ↦ 0)
      (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
      ∑ j : Fin 4, B j := by
  calc
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
        (fun _ ↦ 0)
        (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
        ∑ j : Fin 4, 8 *
          (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
            (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
              ∫ x : E3, ‖sourceStoppingPowerMajorant K F j x‖ ^
                (q j / sourceStoppingExponent j)) :=
      initialSourceStoppingCoordinateEnvelope_le_powerDyadic_unrooted
        α S F q K hq hsum hqs hK hFnonzero htwo hfour
    _ ≤ ∑ j : Fin 4, B j := by
      exact Finset.sum_le_sum fun j _ ↦ hB j

/-- Product-norm-facing specialization of the preceding interface.  A
quantitative dyadic strong-type estimate is supplied exactly in the form
needed to bound each powered-majorant integral by the `q_j`-power integral of
the original input. -/
theorem initialSourceStoppingCoordinateEnvelope_le_inputPowerIntegrals
    (α : Anisotropy) (S : BoxCollection α) (F : InitialModelSchwartzInput)
    (q K C : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j)
    (hK : ∀ j, 0 ≤ K j)
    (hFnonzero : ∀ j, F j ≠ 0)
    (htwo : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      cubeSecondMoment α t x (F 3) ≤
        ‖sourceStoppingPowerMajorant K F 3 x‖)
    (hfour : ∀ (j : Fin 4), j ≠ 3 → ∀ (t : ℝ), 0 < t → ∀ x : E3,
      fourthMoment α t x (F j) ≤
        ‖sourceStoppingPowerMajorant K F j x‖)
    (hdyadic : ∀ j : Fin 4,
      8 * (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
        (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
          ∫ x : E3, ‖sourceStoppingPowerMajorant K F j x‖ ^
            (q j / sourceStoppingExponent j)) ≤
        C j * ∫ x : E3, |F j x| ^ q j) :
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
      (fun _ ↦ 0)
      (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
      ∑ j : Fin 4, C j * ∫ x : E3, |F j x| ^ q j := by
  exact initialSourceStoppingCoordinateEnvelope_le_of_powerDyadic_bounds
    α S F q K hq hsum hqs hK hFnonzero htwo hfour
    (fun j ↦ C j * ∫ x : E3, |F j x| ^ q j) hdyadic

/-- Fully quantitative initial stopping distribution for real Schwartz
input, conditional only on the literal fixed-scale second/fourth bracket
majorants.  The dyadic strong-type and root conversions have all been
discharged, leaving the explicit coordinate constants below. -/
theorem initialSourceStoppingCoordinateEnvelope_le_explicitInputPowers
    (α : Anisotropy) (S : BoxCollection α) (F : InitialModelSchwartzInput)
    (q K : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j)
    (hK : ∀ j, 0 ≤ K j)
    (hFnonzero : ∀ j, F j ≠ 0)
    (htwo : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      cubeSecondMoment α t x (F 3) ≤
        ‖sourceStoppingPowerMajorant K F 3 x‖)
    (hfour : ∀ (j : Fin 4), j ≠ 3 → ∀ (t : ℝ), 0 < t → ∀ x : E3,
      fourthMoment α t x (F j) ≤
        ‖sourceStoppingPowerMajorant K F j x‖) :
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
      (fun _ ↦ 0)
      (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
      ∑ j : Fin 4, sourceStoppingDyadicInputConstant K q j *
        ∫ x : E3, |F j x| ^ q j := by
  exact initialSourceStoppingCoordinateEnvelope_le_inputPowerIntegrals
    α S F q K (sourceStoppingDyadicInputConstant K q)
    hq hsum hqs hK hFnonzero htwo hfour
    (fun j ↦ weightedPowerMajorantIntegral_le_inputPowerIntegral
      K q hK F j (hq j) (hqs j))

/-- The initial stopping distribution for real Schwartz data follows from the
literal bracket-kernel shell majorants, with no remaining fixed-scale
assumptions.  The explicit coefficient retains the three coordinate dyadic
strong-type factors and the source layer-cake constants. -/
theorem initialSourceStoppingCoordinateEnvelope_le_explicitInputPowers_of_realSchwartz
    (α : Anisotropy) (S : BoxCollection α) (F : InitialModelSchwartzInput)
    (q : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j)
    (hFnonzero : ∀ j, F j ≠ 0) :
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
      (fun _ ↦ 0)
      (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
      ∑ j : Fin 4,
        sourceStoppingDyadicInputConstant
          (fun _ ↦ dyadicBracketShellConstant) q j *
          ∫ x : E3, |F j x| ^ q j := by
  let K : Fin 4 → ℝ := fun _ ↦ dyadicBracketShellConstant
  have hK : ∀ j, 0 ≤ K j := by
    intro j
    dsimp only [K]
    exact dyadicBracketShellConstant_nonneg
  have htwo : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      cubeSecondMoment α t x (F 3) ≤
        ‖sourceStoppingPowerMajorant K F 3 x‖ := by
    intro t ht x
    have hpower : ∀ y : E3,
        ‖complexifyRealSchwartz (sourceStoppingPowerRepresentative F 3) y‖ =
          (F 3 y) ^ 2 := by
      intro y
      rw [complexifyRealSchwartz_apply,
        sourceStoppingPowerRepresentative_apply_of_eq_three F rfl,
        Complex.norm_real, Real.norm_eq_abs]
      exact abs_of_nonneg (sq_nonneg (F 3 y))
    simpa only [sourceStoppingPowerMajorant] using
      (cubeSecondMoment_le_scaledDyadic_of_norm_eq_square
        α (F 3)
        (complexifyRealSchwartz (sourceStoppingPowerRepresentative F 3))
        hpower ht x)
  have hfour : ∀ (j : Fin 4), j ≠ 3 → ∀ (t : ℝ), 0 < t → ∀ x : E3,
      fourthMoment α t x (F j) ≤
        ‖sourceStoppingPowerMajorant K F j x‖ := by
    intro j hj t ht x
    have hpower : ∀ y : E3,
        ‖complexifyRealSchwartz (sourceStoppingPowerRepresentative F j) y‖ =
          |F j y| ^ (4 : ℝ) := by
      intro y
      rw [complexifyRealSchwartz_apply,
        sourceStoppingPowerRepresentative_apply_of_ne_three F hj,
        Complex.norm_real, Real.norm_eq_abs, abs_pow]
      exact (Real.rpow_natCast (|F j y|) 4).symm
    simpa only [sourceStoppingPowerMajorant] using
      (fourthMoment_le_scaledDyadic_of_norm_eq_fourth
        α (F j)
        (complexifyRealSchwartz (sourceStoppingPowerRepresentative F j))
        hpower ht x)
  simpa only [K] using
    (initialSourceStoppingCoordinateEnvelope_le_explicitInputPowers
      α S F q K hq hsum hqs hK hFnonzero htwo hfour)


/-! ## Compact-scale full-slab integrability -/

open Topology

/-- A positive compact interval has finite mass for the source logarithmic
scale measure. -/
theorem isFiniteMeasure_logScale_Ioc
    {a b : ℝ} (ha : 0 < a) :
    IsFiniteMeasure
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict (Set.Ioc a b)) := by
  apply (integrable_const_iff_isFiniteMeasure (by norm_num : (1 : ℝ) ≠ 0)).mp
  have htop : ∀ᵐ t ∂(volume.restrict (Set.Ioc a b)), cubeScaleDensity t < ∞ := by
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    rw [cubeScaleDensity_eq_of_pos (lt_trans ha ht.1)]
    exact ENNReal.ofReal_lt_top
  rw [restrict_withDensity measurableSet_Ioc]
  rw [integrable_withDensity_iff measurable_cubeScaleDensity htop]
  have heq : (fun t : ℝ ↦ (1 : ℝ) * (cubeScaleDensity t).toReal) =ᵐ[
      volume.restrict (Set.Ioc a b)] fun t ↦ 1 / t := by
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    have htpos : 0 < t := lt_trans ha ht.1
    rw [cubeScaleDensity_eq_of_pos htpos,
      ENNReal.toReal_ofReal (inv_pos.mpr htpos).le]
    ring
  rw [integrable_congr heq]
  have hcont : ContinuousOn (fun t : ℝ ↦ 1 / t) (Set.Icc a b) :=
    continuousOn_const.div continuousOn_id
      (fun t ht ↦ ne_of_gt (lt_of_lt_of_le ha ht.1))
  exact (hcont.integrableOn_compact isCompact_Icc).mono_set Set.Ioc_subset_Icc_self

/-- The literal dyadic scale band in the two-index exhaustion has finite
logarithmic measure. -/
theorem isFiniteMeasure_truncationScaleSet (N : ℕ) :
    IsFiniteMeasure
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (truncationScaleSet N)) := by
  apply isFiniteMeasure_logScale_Ioc
  change 0 < (2 : ℝ) ^ (-(N : ℤ) - 1)
  exact zpow_pos (by norm_num) _

/-- The first difference-kernel block after the center reordering. -/
noncomputable def modelCenterP
    (α : Anisotropy) (u : E3) (t : ℝ) (a : E3) : ℝ :=
  |modelPhiAt (t ^ α.weight 0) (t ^ α.weight 0 * u 0) (a 0)| *
    |modelPhiAt (t ^ α.weight 1) (t ^ α.weight 1 * u 1) (a 1)| *
      |gaussianDerivAt (t ^ α.weight 2) 0 (a 2)|

/-- The second difference/translation-kernel block after the center
reordering. -/
noncomputable def modelCenterQ
    (α : Anisotropy) (u : E3) (t : ℝ) (br : E3 × ℝ) : ℝ :=
  (|gaussianAt (t ^ α.weight 0) 0 (br.1 0)| *
      |gaussianAt (t ^ α.weight 1) 0 (br.1 1)|) *
    (|gaussianDerivAt (t ^ α.weight 2)
        (br.2 * t ^ α.weight 2) (br.1 2)| *
      |conePsiPhysicalReal (br.2 + u 2)|)

theorem integrable_modelCenterP
    (α : Anisotropy) (u : E3) (t : ℝ) (ht : 0 < t) :
    Integrable (modelCenterP α u t) := by
  have hs₀ : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs₁ : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs₂ : 0 < t ^ α.weight 2 := pow_pos ht _
  have h₀ : Integrable (fun r : ℝ ↦
      |modelPhiAt (t ^ α.weight 0) (t ^ α.weight 0 * u 0) r|) :=
    integrable_abs_modelPhiAt hs₀ _
  have h₁ : Integrable (fun r : ℝ ↦
      |modelPhiAt (t ^ α.weight 1) (t ^ α.weight 1 * u 1) r|) :=
    integrable_abs_modelPhiAt hs₁ _
  have h₂ : Integrable (fun r : ℝ ↦
      |gaussianDerivAt (t ^ α.weight 2) 0 r|) :=
    integrable_abs_gaussianDerivAt hs₂ _
  change Integrable (fun a : E3 ↦
    |modelPhiAt (t ^ α.weight 0) (t ^ α.weight 0 * u 0) (a 0)| *
      |modelPhiAt (t ^ α.weight 1) (t ^ α.weight 1 * u 1) (a 1)| *
        |gaussianDerivAt (t ^ α.weight 2) 0 (a 2)|)
  exact integrable_E3_coordinate_product _ _ _ h₀ h₁ h₂

theorem integral_modelCenterP
    (α : Anisotropy) (u : E3) (t : ℝ) (ht : 0 < t) :
    (∫ a : E3, modelCenterP α u t a) =
      (∫ r : ℝ, |conePhiPhysicalReal r|) ^ 2 *
        ∫ r : ℝ, |gaussianDeriv r| := by
  have hs₀ : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs₁ : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs₂ : 0 < t ^ α.weight 2 := pow_pos ht _
  let P₀ : ℝ → ℝ := fun r ↦
    |modelPhiAt (t ^ α.weight 0) (t ^ α.weight 0 * u 0) r|
  let P₁ : ℝ → ℝ := fun r ↦
    |modelPhiAt (t ^ α.weight 1) (t ^ α.weight 1 * u 1) r|
  let P₂ : ℝ → ℝ := fun r ↦ |gaussianDerivAt (t ^ α.weight 2) 0 r|
  change (∫ a : E3, P₀ (a 0) * P₁ (a 1) * P₂ (a 2)) = _
  calc
    (∫ a : E3, P₀ (a 0) * P₁ (a 1) * P₂ (a 2)) =
        (∫ r : ℝ, P₀ r) * (∫ r : ℝ, P₁ r) * ∫ r : ℝ, P₂ r :=
      integral_E3_coordinate_product P₀ P₁ P₂
    _ = (∫ r : ℝ, |conePhiPhysicalReal r|) ^ 2 *
          ∫ r : ℝ, |gaussianDeriv r| := by
      dsimp only [P₀, P₁, P₂]
      rw [integral_abs_modelPhiAt hs₀,
        integral_abs_modelPhiAt hs₁,
        integral_abs_gaussianDerivAt hs₂]
      ring

theorem integrable_modelCenterQ
    (α : Anisotropy) (u : E3) (t : ℝ) (ht : 0 < t) :
    Integrable (modelCenterQ α u t)
      ((volume : Measure E3).prod volume) := by
  have hs₀ : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs₁ : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs₂ : 0 < t ^ α.weight 2 := pow_pos ht _
  change Integrable (fun br : E3 × ℝ ↦
    (|gaussianAt (t ^ α.weight 0) 0 (br.1 0)| *
        |gaussianAt (t ^ α.weight 1) 0 (br.1 1)|) *
      (|gaussianDerivAt (t ^ α.weight 2)
          (br.2 * t ^ α.weight 2) (br.1 2)| *
        |conePsiPhysicalReal (br.2 + u 2)|))
    ((volume : Measure E3).prod volume)
  exact integrable_rawTranslationKernelBlock
    (t ^ α.weight 0) (t ^ α.weight 1) (t ^ α.weight 2) (u 2)
    hs₀ hs₁ hs₂

/-- The absolute mass of the raw third-coordinate translation pair is
independent of its positive scale. -/
theorem integral_abs_rawThirdTranslationPair
    (s u : ℝ) (hs : 0 < s) :
    (∫ z : ℝ × ℝ,
      |gaussianDerivAt s (z.2 * s) z.1| *
        |conePsiPhysicalReal (z.2 + u)|) =
      (∫ x : ℝ, |gaussianDeriv x|) * conePsiPhysicalRealL1 := by
  let G : ℝ → ℝ → ℝ := fun x r ↦
    |gaussianDerivAt s (r * s) x| * |conePsiPhysicalReal (r + u)|
  have hG : Integrable (Function.uncurry G)
      ((volume : Measure ℝ).prod volume) := by
    change Integrable (fun z : ℝ × ℝ ↦
      |gaussianDerivAt s (z.2 * s) z.1| *
        |conePsiPhysicalReal (z.2 + u)|)
      ((volume : Measure ℝ).prod volume)
    exact integrable_rawThirdTranslationPair s u hs
  calc
    (∫ z : ℝ × ℝ,
      |gaussianDerivAt s (z.2 * s) z.1| *
        |conePsiPhysicalReal (z.2 + u)|) =
        ∫ x : ℝ, ∫ r : ℝ, G x r := by
          exact integral_prod (Function.uncurry G) hG
    _ = ∫ r : ℝ, ∫ x : ℝ, G x r :=
      integral_integral_swap hG
    _ = ∫ r : ℝ,
        (∫ x : ℝ, |gaussianDeriv x|) * |conePsiPhysicalReal (r + u)| := by
      apply integral_congr_ae
      filter_upwards [] with r
      dsimp only [G]
      rw [show (fun x : ℝ ↦
          |gaussianDerivAt s (r * s) x| * |conePsiPhysicalReal (r + u)|) =
          fun x ↦ |gaussianDerivAt s (r * s) x| *
            |conePsiPhysicalReal (r + u)| by rfl,
        integral_mul_const, integral_abs_gaussianDerivAt hs]
    _ = (∫ x : ℝ, |gaussianDeriv x|) * conePsiPhysicalRealL1 := by
      rw [integral_const_mul, integral_abs_conePsiPhysicalReal_add]

/-- The second center block has scale-independent absolute mass. -/
theorem integral_modelCenterQ
    (α : Anisotropy) (u : E3) (t : ℝ) (ht : 0 < t) :
    (∫ br : E3 × ℝ, modelCenterQ α u t br) =
      (∫ r : ℝ, |gaussianDeriv r|) * conePsiPhysicalRealL1 := by
  let s₀ : ℝ := t ^ α.weight 0
  let s₁ : ℝ := t ^ α.weight 1
  let s₂ : ℝ := t ^ α.weight 2
  have hs₀ : 0 < s₀ := by dsimp only [s₀]; exact pow_pos ht _
  have hs₁ : 0 < s₁ := by dsimp only [s₁]; exact pow_pos ht _
  have hs₂ : 0 < s₂ := by dsimp only [s₂]; exact pow_pos ht _
  let G₀ : ℝ → ℝ := fun x ↦ |gaussianAt s₀ 0 x|
  let G₁ : ℝ → ℝ := fun x ↦ |gaussianAt s₁ 0 x|
  let T : ℝ × ℝ → ℝ := fun z ↦
    |gaussianDerivAt s₂ (z.2 * s₂) z.1| *
      |conePsiPhysicalReal (z.2 + u 2)|
  have hG₀ : Integrable G₀ := by
    have h := (integrable_gaussianAt hs₀ 0).norm
    apply h.congr
    filter_upwards [] with x
    dsimp only [G₀]
    exact (Real.norm_eq_abs _).symm
  have hG₁ : Integrable G₁ := by
    have h := (integrable_gaussianAt hs₁ 0).norm
    apply h.congr
    filter_upwards [] with x
    dsimp only [G₁]
    exact (Real.norm_eq_abs _).symm
  have hT : Integrable T ((volume : Measure ℝ).prod volume) := by
    simpa only [T] using integrable_rawThirdTranslationPair s₂ (u 2) hs₂
  let e : E3 × ℝ ≃ᵐ ℝ × (ℝ × (ℝ × ℝ)) :=
    (MeasurableEquiv.prodCongr e3Coordinates (MeasurableEquiv.refl ℝ)).trans
      (MeasurableEquiv.prodAssoc.trans
        (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
          MeasurableEquiv.prodAssoc))
  have hcoords : MeasurePreserving
      (MeasurableEquiv.prodCongr e3Coordinates (MeasurableEquiv.refl ℝ))
      ((volume : Measure E3).prod volume)
      (((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)).prod
        volume) :=
    e3Coordinates_measurePreserving.prod (MeasurePreserving.id (volume : Measure ℝ))
  have hassoc₁ : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        (ℝ × (ℝ × ℝ)) × ℝ ≃ᵐ ℝ × ((ℝ × ℝ) × ℝ))
      (((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)).prod volume)
      ((volume : Measure ℝ).prod
        (((volume : Measure ℝ).prod volume).prod volume)) :=
    measurePreserving_prodAssoc volume ((volume : Measure ℝ).prod volume) volume
  have hassoc₂ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
        (MeasurableEquiv.prodAssoc :
          (ℝ × ℝ) × ℝ ≃ᵐ ℝ × (ℝ × ℝ)))
      ((volume : Measure ℝ).prod
        (((volume : Measure ℝ).prod volume).prod volume))
      ((volume : Measure ℝ).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) :=
    (MeasurePreserving.id (volume : Measure ℝ)).prod
      (measurePreserving_prodAssoc volume volume volume)
  have hmp : MeasurePreserving e
      ((volume : Measure E3).prod volume)
      ((volume : Measure ℝ).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) := by
    dsimp only [e]
    exact (hcoords.trans hassoc₁).trans hassoc₂
  let H : ℝ × (ℝ × (ℝ × ℝ)) → ℝ := fun z ↦
    G₀ z.1 * (G₁ z.2.1 * T z.2.2)
  have hH : Integrable H
      ((volume : Measure ℝ).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) :=
    hG₀.mul_prod (hG₁.mul_prod hT)
  have htransport : Integrable (fun br : E3 × ℝ ↦ H (e br))
      ((volume : Measure E3).prod volume) :=
    hmp.integrable_comp_of_integrable hH
  have hrewrite : (fun br : E3 × ℝ ↦ H (e br)) =
      modelCenterQ α u t := by
    funext br
    rcases br with ⟨b, r⟩
    simp [H, G₀, G₁, T, modelCenterQ, e, MeasurableEquiv.trans_apply,
      MeasurableEquiv.prodCongr, MeasurableEquiv.prodAssoc,
      e3Coordinates_apply]
    dsimp only [s₀, s₁, s₂]
    ring
  rw [← hrewrite]
  calc
    (∫ br : E3 × ℝ, H (e br)) =
        ∫ z : ℝ × (ℝ × (ℝ × ℝ)), H z :=
      hmp.integral_comp e.measurableEmbedding H
    _ = (∫ x : ℝ, G₀ x) *
          ∫ z : ℝ × (ℝ × ℝ), G₁ z.1 * T z.2 := by
      rw [show (fun z : ℝ × (ℝ × (ℝ × ℝ)) ↦ H z) =
        fun z ↦ G₀ z.1 * (G₁ z.2.1 * T z.2.2) by rfl]
      exact integral_prod_mul G₀ (fun z : ℝ × (ℝ × ℝ) ↦
        G₁ z.1 * T z.2)
    _ = (∫ x : ℝ, G₀ x) *
          ((∫ x : ℝ, G₁ x) * ∫ z : ℝ × ℝ, T z) := by
      congr 1
      exact integral_prod_mul G₁ T
    _ = (∫ r : ℝ, |gaussianDeriv r|) * conePsiPhysicalRealL1 := by
      have hG₀mass : (∫ x : ℝ, G₀ x) = 1 := by
        dsimp only [G₀]
        calc
          (∫ x : ℝ, |gaussianAt s₀ 0 x|) = ∫ x : ℝ, gaussianAt s₀ 0 x := by
            apply integral_congr_ae
            filter_upwards [] with x
            rw [abs_of_nonneg]
            unfold gaussianAt kernelAt kernelDilate
            exact mul_nonneg (inv_nonneg.mpr hs₀.le) (gaussian_nonneg _)
          _ = 1 := integral_gaussianAt hs₀ 0
      have hG₁mass : (∫ x : ℝ, G₁ x) = 1 := by
        dsimp only [G₁]
        calc
          (∫ x : ℝ, |gaussianAt s₁ 0 x|) = ∫ x : ℝ, gaussianAt s₁ 0 x := by
            apply integral_congr_ae
            filter_upwards [] with x
            rw [abs_of_nonneg]
            unfold gaussianAt kernelAt kernelDilate
            exact mul_nonneg (inv_nonneg.mpr hs₁.le) (gaussian_nonneg _)
          _ = 1 := integral_gaussianAt hs₁ 0
      have hTmass : (∫ z : ℝ × ℝ, T z) =
          (∫ x : ℝ, |gaussianDeriv x|) * conePsiPhysicalRealL1 := by
        dsimp only [T]
        exact integral_abs_rawThirdTranslationPair s₂ (u 2) hs₂
      rw [hG₀mass, hG₁mass, hTmass]
      ring

/-- Reflecting the first difference block preserves both integrability and
its scale-independent mass. -/
theorem integrable_modelCenterP_neg
    (α : Anisotropy) (u : E3) (t : ℝ) (ht : 0 < t) :
    Integrable (fun a : E3 ↦ modelCenterP α u t (-a)) :=
  (integrable_modelCenterP α u t ht).comp_neg

theorem integral_modelCenterP_neg
    (α : Anisotropy) (u : E3) (t : ℝ) (ht : 0 < t) :
    (∫ a : E3, modelCenterP α u t (-a)) =
      (∫ r : ℝ, |conePhiPhysicalReal r|) ^ 2 *
        ∫ r : ℝ, |gaussianDeriv r| := by
  let P : E3 → ℝ := modelCenterP α u t
  have hneg : MeasurePreserving (fun a : E3 ↦ -a) volume volume :=
    Measure.measurePreserving_neg (volume : Measure E3)
  calc
    (∫ a : E3, modelCenterP α u t (-a)) = ∫ a : E3, P a := by
      change (∫ a : E3, P (-a)) = ∫ a : E3, P a
      exact hneg.integral_comp (Homeomorph.neg E3).measurableEmbedding P
    _ = (∫ r : ℝ, |conePhiPhysicalReal r|) ^ 2 *
          ∫ r : ℝ, |gaussianDeriv r| :=
      integral_modelCenterP α u t ht

/-- The separated nonnegative center majorant after all fixed spatial
differences have been taken. -/
noncomputable def modelCenterMajorant
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (A : E3 → ℝ)
    (t : ℝ) (q : (E3 × E3) × (E3 × ℝ)) : ℝ :=
  |c t| * A q.1.1 * modelCenterP α u t (-q.1.2) *
    modelCenterQ α u t q.2

theorem integrable_modelCenterMajorant_fixed
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (A : E3 → ℝ)
    (hA : Integrable A) (t : ℝ) (ht : 0 < t) :
    Integrable (modelCenterMajorant α u c A t)
      (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume)) := by
  have hP : Integrable (fun a : E3 ↦ modelCenterP α u t (-a)) :=
    integrable_modelCenterP_neg α u t ht
  have hQ : Integrable (modelCenterQ α u t)
      ((volume : Measure E3).prod volume) :=
    integrable_modelCenterQ α u t ht
  have hPQ : Integrable (fun q : E3 × (E3 × ℝ) ↦
      modelCenterP α u t (-q.1) * modelCenterQ α u t q.2)
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume)) :=
    hP.mul_prod hQ
  have hAPQ : Integrable (fun q : E3 × (E3 × (E3 × ℝ)) ↦
      A q.1 * (modelCenterP α u t (-q.2.1) *
        modelCenterQ α u t q.2.2))
      ((volume : Measure E3).prod
        ((volume : Measure E3).prod ((volume : Measure E3).prod volume))) :=
    hA.mul_prod hPQ
  have hassoc : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        (E3 × E3) × (E3 × ℝ) ≃ᵐ E3 × (E3 × (E3 × ℝ)))
      (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume))
      ((volume : Measure E3).prod
        ((volume : Measure E3).prod ((volume : Measure E3).prod volume))) :=
    measurePreserving_prodAssoc volume volume
      ((volume : Measure E3).prod volume)
  have htransport : Integrable (fun q : (E3 × E3) × (E3 × ℝ) ↦
      A ((MeasurableEquiv.prodAssoc q).1) *
        (modelCenterP α u t (-((MeasurableEquiv.prodAssoc q).2.1)) *
          modelCenterQ α u t (MeasurableEquiv.prodAssoc q).2.2))
      (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume)) :=
    hassoc.integrable_comp_of_integrable hAPQ
  apply htransport.const_mul |c t| |>.congr
  filter_upwards [] with q
  rcases q with ⟨⟨x, a⟩, br⟩
  change |c t| * (A x * (modelCenterP α u t (-a) *
      modelCenterQ α u t br)) = modelCenterMajorant α u c A t ((x, a), br)
  simp only [modelCenterMajorant]
  ring

theorem integral_modelCenterMajorant_fixed
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (A : E3 → ℝ)
    (hA : Integrable A) (t : ℝ) (ht : 0 < t) :
    (∫ q : (E3 × E3) × (E3 × ℝ),
      modelCenterMajorant α u c A t q) =
      |c t| * (∫ x : E3, A x) *
        ((∫ r : ℝ, |conePhiPhysicalReal r|) ^ 2 *
          ∫ r : ℝ, |gaussianDeriv r|) *
        ((∫ r : ℝ, |gaussianDeriv r|) * conePsiPhysicalRealL1) := by
  let P : E3 → ℝ := fun a ↦ modelCenterP α u t (-a)
  let Q : E3 × ℝ → ℝ := modelCenterQ α u t
  let H : (E3 × E3) × (E3 × ℝ) → ℝ := fun q ↦
    A q.1.1 * P q.1.2 * Q q.2
  have hH : Integrable H
      (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume)) := by
    have hP : Integrable P := integrable_modelCenterP_neg α u t ht
    have hQ : Integrable Q ((volume : Measure E3).prod volume) :=
      integrable_modelCenterQ α u t ht
    have hPQ : Integrable (fun q : E3 × (E3 × ℝ) ↦ P q.1 * Q q.2)
        ((volume : Measure E3).prod ((volume : Measure E3).prod volume)) :=
      hP.mul_prod hQ
    have hAPQ := hA.mul_prod hPQ
    have hassoc : MeasurePreserving
        (MeasurableEquiv.prodAssoc :
          (E3 × E3) × (E3 × ℝ) ≃ᵐ E3 × (E3 × (E3 × ℝ)))
        (((volume : Measure E3).prod volume).prod
          ((volume : Measure E3).prod volume))
        ((volume : Measure E3).prod
          ((volume : Measure E3).prod ((volume : Measure E3).prod volume))) :=
      measurePreserving_prodAssoc volume volume
        ((volume : Measure E3).prod volume)
    have htransport : Integrable (fun q : (E3 × E3) × (E3 × ℝ) ↦
        A ((MeasurableEquiv.prodAssoc q).1) *
          (P ((MeasurableEquiv.prodAssoc q).2.1) *
            Q (MeasurableEquiv.prodAssoc q).2.2))
        (((volume : Measure E3).prod volume).prod
          ((volume : Measure E3).prod volume)) :=
      hassoc.integrable_comp_of_integrable hAPQ
    apply htransport.congr
    filter_upwards [] with q
    rcases q with ⟨⟨x, a⟩, br⟩
    change A x * (P a * Q br) = H ((x, a), br)
    dsimp only [H]
    ring
  calc
    (∫ q : (E3 × E3) × (E3 × ℝ),
      modelCenterMajorant α u c A t q) =
        |c t| * ∫ q : (E3 × E3) × (E3 × ℝ), H q := by
          have hpoint : (fun q : (E3 × E3) × (E3 × ℝ) ↦
              modelCenterMajorant α u c A t q) =
              fun q ↦ |c t| * H q := by
            funext q
            rcases q with ⟨⟨x, a⟩, br⟩
            simp only [modelCenterMajorant, H, P, Q]
            ring
          rw [hpoint, integral_const_mul]
    _ = |c t| *
          ((∫ x : E3, A x) *
            ((∫ a : E3, P a) * ∫ br : E3 × ℝ, Q br)) := by
          congr 1
          have hassoc : MeasurePreserving
              (MeasurableEquiv.prodAssoc :
                (E3 × E3) × (E3 × ℝ) ≃ᵐ E3 × (E3 × (E3 × ℝ)))
              (((volume : Measure E3).prod volume).prod
                ((volume : Measure E3).prod volume))
              ((volume : Measure E3).prod
                ((volume : Measure E3).prod ((volume : Measure E3).prod volume))) :=
            measurePreserving_prodAssoc volume volume
              ((volume : Measure E3).prod volume)
          calc
            (∫ q : (E3 × E3) × (E3 × ℝ), H q) =
                ∫ q : (E3 × E3) × (E3 × ℝ),
                  A (MeasurableEquiv.prodAssoc q).1 *
                    (P (MeasurableEquiv.prodAssoc q).2.1 *
                      Q (MeasurableEquiv.prodAssoc q).2.2) := by
                apply integral_congr_ae
                filter_upwards [] with q
                rcases q with ⟨⟨x, a⟩, br⟩
                change A x * P a * Q br = A x * (P a * Q br)
                ring
            _ =
                ∫ q : E3 × (E3 × (E3 × ℝ)),
                  A q.1 * (P q.2.1 * Q q.2.2) :=
              by
                exact hassoc.integral_comp
                  MeasurableEquiv.prodAssoc.measurableEmbedding
                  (fun q : E3 × (E3 × (E3 × ℝ)) ↦ A q.1 *
                    (P q.2.1 * Q q.2.2))
            _ = (∫ x : E3, A x) *
                ∫ q : E3 × (E3 × ℝ), P q.1 * Q q.2 := by
              exact integral_prod_mul A (fun q : E3 × (E3 × ℝ) ↦ P q.1 * Q q.2)
            _ = (∫ x : E3, A x) *
                ((∫ a : E3, P a) * ∫ br : E3 × ℝ, Q br) := by
              congr 1
              exact integral_prod_mul P Q
    _ = |c t| * (∫ x : E3, A x) *
          ((∫ r : ℝ, |conePhiPhysicalReal r|) ^ 2 *
            ∫ r : ℝ, |gaussianDeriv r|) *
          ((∫ r : ℝ, |gaussianDeriv r|) * conePsiPhysicalRealL1) := by
          rw [show (∫ a : E3, P a) =
              (∫ r : ℝ, |conePhiPhysicalReal r|) ^ 2 *
                ∫ r : ℝ, |gaussianDeriv r| by
                dsimp only [P]
                exact integral_modelCenterP_neg α u t ht,
            show (∫ br : E3 × ℝ, Q br) =
              (∫ r : ℝ, |gaussianDeriv r|) * conePsiPhysicalRealL1 by
                dsimp only [Q]
                exact integral_modelCenterQ α u t ht]
          ring

/-- The separated center majorant is measurable jointly in scale and all
center/difference variables whenever its base factor and coefficient are
measurable. -/
theorem measurable_modelCenterMajorant_joint
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (A : E3 → ℝ)
    (hc : Measurable c) (hA : Measurable A) :
    Measurable (fun z : ℝ × ((E3 × E3) × (E3 × ℝ)) ↦
      modelCenterMajorant α u c A z.1 z.2) := by
  let X := ℝ × ((E3 × E3) × (E3 × ℝ))
  have ht : Measurable (fun z : X ↦ z.1) := measurable_fst
  have hx : Measurable (fun z : X ↦ z.2.1.1) :=
    measurable_fst.comp (measurable_fst.comp measurable_snd)
  have ha : Measurable (fun z : X ↦ z.2.1.2) :=
    measurable_snd.comp (measurable_fst.comp measurable_snd)
  have hb : Measurable (fun z : X ↦ z.2.2.1) :=
    measurable_fst.comp (measurable_snd.comp measurable_snd)
  have hr : Measurable (fun z : X ↦ z.2.2.2) :=
    measurable_snd.comp (measurable_snd.comp measurable_snd)
  have hxi (i : Fin 3) : Measurable (fun z : X ↦ z.2.1.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp hx
  have hai (i : Fin 3) : Measurable (fun z : X ↦ z.2.1.2 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp ha
  have hbi (i : Fin 3) : Measurable (fun z : X ↦ z.2.2.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp hb
  have hderiv : Measurable gaussianDeriv := by
    unfold gaussianDeriv
    exact (measurable_const.mul measurable_id).mul
      gaussian_contDiff.continuous.measurable
  have hphi₀ : Measurable (fun z : X ↦
      modelPhiAt (z.1 ^ α.weight 0) (z.1 ^ α.weight 0 * u 0)
        (-(z.2.1.2 0))) := by
    unfold modelPhiAt
    exact measurable_kernelAt conePhiPhysicalReal
      conePhiPhysicalReal.continuous.measurable _ _ _
      (ht.pow_const _) ((ht.pow_const _).mul measurable_const) (hai 0).neg
  have hphi₁ : Measurable (fun z : X ↦
      modelPhiAt (z.1 ^ α.weight 1) (z.1 ^ α.weight 1 * u 1)
        (-(z.2.1.2 1))) := by
    unfold modelPhiAt
    exact measurable_kernelAt conePhiPhysicalReal
      conePhiPhysicalReal.continuous.measurable _ _ _
      (ht.pow_const _) ((ht.pow_const _).mul measurable_const) (hai 1).neg
  have hderiv₀ : Measurable (fun z : X ↦
      gaussianDerivAt (z.1 ^ α.weight 2) 0 (-(z.2.1.2 2))) := by
    unfold gaussianDerivAt
    exact measurable_kernelAt gaussianDeriv hderiv _ _ _
      (ht.pow_const _) measurable_const (hai 2).neg
  have hgauss₀ : Measurable (fun z : X ↦
      gaussianAt (z.1 ^ α.weight 0) 0 (z.2.2.1 0)) := by
    unfold gaussianAt
    exact measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable
      _ _ _ (ht.pow_const _) measurable_const (hbi 0)
  have hgauss₁ : Measurable (fun z : X ↦
      gaussianAt (z.1 ^ α.weight 1) 0 (z.2.2.1 1)) := by
    unfold gaussianAt
    exact measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable
      _ _ _ (ht.pow_const _) measurable_const (hbi 1)
  have hderiv₁ : Measurable (fun z : X ↦
      gaussianDerivAt (z.1 ^ α.weight 2)
        (z.2.2.2 * z.1 ^ α.weight 2) (z.2.2.1 2)) := by
    unfold gaussianDerivAt
    exact measurable_kernelAt gaussianDeriv hderiv _ _ _
      (ht.pow_const _) (hr.mul (ht.pow_const _)) (hbi 2)
  have hpsi : Measurable (fun z : X ↦
      conePsiPhysicalReal (z.2.2.2 + u 2)) :=
    conePsiPhysicalReal.continuous.measurable.comp (hr.add measurable_const)
  have hc' : Measurable (fun z : X ↦ c z.1) := hc.comp ht
  have hcabs : Measurable (fun z : X ↦ |c z.1|) :=
    continuous_abs.measurable.comp hc'
  have hA' : Measurable (fun z : X ↦ A z.2.1.1) := hA.comp hx
  have hphi₀abs : Measurable (fun z : X ↦
      |modelPhiAt (z.1 ^ α.weight 0) (z.1 ^ α.weight 0 * u 0)
        (-(z.2.1.2 0))|) := continuous_abs.measurable.comp hphi₀
  have hphi₁abs : Measurable (fun z : X ↦
      |modelPhiAt (z.1 ^ α.weight 1) (z.1 ^ α.weight 1 * u 1)
        (-(z.2.1.2 1))|) := continuous_abs.measurable.comp hphi₁
  have hderiv₀abs : Measurable (fun z : X ↦
      |gaussianDerivAt (z.1 ^ α.weight 2) 0 (-(z.2.1.2 2))|) :=
    continuous_abs.measurable.comp hderiv₀
  have hgauss₀abs : Measurable (fun z : X ↦
      |gaussianAt (z.1 ^ α.weight 0) 0 (z.2.2.1 0)|) :=
    continuous_abs.measurable.comp hgauss₀
  have hgauss₁abs : Measurable (fun z : X ↦
      |gaussianAt (z.1 ^ α.weight 1) 0 (z.2.2.1 1)|) :=
    continuous_abs.measurable.comp hgauss₁
  have hderiv₁abs : Measurable (fun z : X ↦
      |gaussianDerivAt (z.1 ^ α.weight 2)
        (z.2.2.2 * z.1 ^ α.weight 2) (z.2.2.1 2)|) :=
    continuous_abs.measurable.comp hderiv₁
  have hpsiabs : Measurable (fun z : X ↦
      |conePsiPhysicalReal (z.2.2.2 + u 2)|) :=
    continuous_abs.measurable.comp hpsi
  have hleft : Measurable (fun z : X ↦
      |c z.1| * A z.2.1.1 *
        |modelPhiAt (z.1 ^ α.weight 0) (z.1 ^ α.weight 0 * u 0)
          (-(z.2.1.2 0))| *
        |modelPhiAt (z.1 ^ α.weight 1) (z.1 ^ α.weight 1 * u 1)
          (-(z.2.1.2 1))| *
        |gaussianDerivAt (z.1 ^ α.weight 2) 0 (-(z.2.1.2 2))|) :=
    ((((hcabs.mul hA').mul hphi₀abs).mul hphi₁abs).mul hderiv₀abs)
  have hright : Measurable (fun z : X ↦
      (|gaussianAt (z.1 ^ α.weight 0) 0 (z.2.2.1 0)| *
        |gaussianAt (z.1 ^ α.weight 1) 0 (z.2.2.1 1)|) *
      (|gaussianDerivAt (z.1 ^ α.weight 2)
          (z.2.2.2 * z.1 ^ α.weight 2) (z.2.2.1 2)| *
        |conePsiPhysicalReal (z.2.2.2 + u 2)|)) :=
    (hgauss₀abs.mul hgauss₁abs).mul (hderiv₁abs.mul hpsiabs)
  change Measurable (fun z : X ↦
    |c z.1| * A z.2.1.1 *
      (|modelPhiAt (z.1 ^ α.weight 0) (z.1 ^ α.weight 0 * u 0)
          ((-z.2.1.2) 0)| *
        |modelPhiAt (z.1 ^ α.weight 1) (z.1 ^ α.weight 1 * u 1)
          ((-z.2.1.2) 1)| *
        |gaussianDerivAt (z.1 ^ α.weight 2) 0 ((-z.2.1.2) 2)|) *
      ((|gaussianAt (z.1 ^ α.weight 0) 0 (z.2.2.1 0)| *
          |gaussianAt (z.1 ^ α.weight 1) 0 (z.2.2.1 1)|) *
        (|gaussianDerivAt (z.1 ^ α.weight 2)
            (z.2.2.2 * z.1 ^ α.weight 2) (z.2.2.1 2)| *
          |conePsiPhysicalReal (z.2.2.2 + u 2)|)))
  convert
    (((hcabs.mul hA').mul ((hphi₀abs.mul hphi₁abs).mul hderiv₀abs)).mul
      ((hgauss₀abs.mul hgauss₁abs).mul (hderiv₁abs.mul hpsiabs))) using 1
  rfl

/-- On every finite positive scale measure, the separated center majorant is
jointly integrable.  Its spatial mass is independent of the scale. -/
theorem integrable_modelCenterMajorant_joint_of_isFinite
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (A : E3 → ℝ)
    (ν : Measure ℝ) [IsFiniteMeasure ν]
    (hc : Measurable c) (hcBound : ∀ t : ℝ, |c t| ≤ 1)
    (hAmeas : Measurable A) (hAint : Integrable A)
    (hAnonneg : ∀ x : E3, 0 ≤ A x)
    (hpos : ∀ᵐ t ∂ν, 0 < t) :
    Integrable (fun z : ℝ × ((E3 × E3) × (E3 × ℝ)) ↦
      modelCenterMajorant α u c A z.1 z.2)
      (ν.prod (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume))) := by
  let μ : Measure ((E3 × E3) × (E3 × ℝ)) :=
    ((volume : Measure E3).prod volume).prod
      ((volume : Measure E3).prod volume)
  let Pmass : ℝ :=
    (∫ r : ℝ, |conePhiPhysicalReal r|) ^ 2 *
      ∫ r : ℝ, |gaussianDeriv r|
  let Qmass : ℝ :=
    (∫ r : ℝ, |gaussianDeriv r|) * conePsiPhysicalRealL1
  let K : ℝ := (∫ x : E3, A x) * Pmass * Qmass
  have hmeas : AEStronglyMeasurable (fun z : ℝ × ((E3 × E3) × (E3 × ℝ)) ↦
      modelCenterMajorant α u c A z.1 z.2) (ν.prod μ) :=
    (measurable_modelCenterMajorant_joint α u c A hc hAmeas).aestronglyMeasurable
  refine (integrable_prod_iff hmeas).mpr ⟨?_, ?_⟩
  · filter_upwards [hpos] with t ht
    simpa only [μ] using
      integrable_modelCenterMajorant_fixed α u c A hAint t ht
  · have hAint_nonneg : 0 ≤ ∫ x : E3, A x :=
      integral_nonneg hAnonneg
    have hphi_nonneg : 0 ≤ ∫ r : ℝ, |conePhiPhysicalReal r| :=
      integral_nonneg fun _ ↦ abs_nonneg _
    have hderiv_nonneg : 0 ≤ ∫ r : ℝ, |gaussianDeriv r| :=
      integral_nonneg fun _ ↦ abs_nonneg _
    have hPmass_nonneg : 0 ≤ Pmass := by
      dsimp only [Pmass]
      exact mul_nonneg (sq_nonneg _) hderiv_nonneg
    have hQmass_nonneg : 0 ≤ Qmass := by
      dsimp only [Qmass]
      exact mul_nonneg hderiv_nonneg conePsiPhysicalRealL1_pos.le
    have hKnonneg : 0 ≤ K := by
      dsimp only [K]
      exact mul_nonneg (mul_nonneg hAint_nonneg hPmass_nonneg) hQmass_nonneg
    have hcoeff_meas : AEStronglyMeasurable (fun t : ℝ ↦ |c t| * K) ν :=
      ((continuous_abs.measurable.comp hc).mul measurable_const).aestronglyMeasurable
    have hcoeff : Integrable (fun t : ℝ ↦ |c t| * K) ν := by
      refine (integrable_const K).mono' hcoeff_meas ?_
      filter_upwards [] with t
      rw [Real.norm_eq_abs, abs_of_nonneg]
      · nlinarith [hcBound t, abs_nonneg (c t)]
      · exact mul_nonneg (abs_nonneg _) hKnonneg
    apply hcoeff.congr
    filter_upwards [hpos] with t ht
    symm
    calc
      (∫ q : (E3 × E3) × (E3 × ℝ),
        ‖modelCenterMajorant α u c A t q‖) =
          ∫ q : (E3 × E3) × (E3 × ℝ),
            modelCenterMajorant α u c A t q := by
              apply integral_congr_ae
              filter_upwards [] with q
              rw [Real.norm_eq_abs, abs_of_nonneg]
              have hP : 0 ≤ modelCenterP α u t (-q.1.2) := by
                unfold modelCenterP
                positivity
              have hQ : 0 ≤ modelCenterQ α u t q.2 := by
                unfold modelCenterQ
                positivity
              exact mul_nonneg
                (mul_nonneg
                  (mul_nonneg (abs_nonneg _) (hAnonneg q.1.1)) hP) hQ
      _ = |c t| * (∫ x : E3, A x) * Pmass * Qmass := by
            dsimp only [Pmass, Qmass]
            exact integral_modelCenterMajorant_fixed α u c A hAint t ht
      _ = |c t| * K := by
            dsimp only [K]
            ring

/-- The two spatial difference shears carrying the raw center variables to
the separated majorant coordinates. -/
noncomputable def modelCenterRawReorder :
    ((E3 × E3) × E3) × ℝ ≃ᵐ (E3 × E3) × (E3 × ℝ) :=
  let e₃ : (E3 × E3) × E3 ≃ᵐ (E3 × E3) × E3 :=
    ((MeasurableEquiv.prodAssoc.trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.prodComm : E3 × E3 ≃ᵐ E3 × E3))).trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.shearSubRight E3))).trans
      MeasurableEquiv.prodAssoc.symm
  ((MeasurableEquiv.prodCongr e₃ (MeasurableEquiv.refl ℝ)).trans
    MeasurableEquiv.prodAssoc).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.shearSubRight E3)
      (MeasurableEquiv.refl (E3 × ℝ)))

/-- The raw-center difference shear preserves the four-dimensional product
Lebesgue measure. -/
theorem modelCenterRawReorder_measurePreserving :
    MeasurePreserving modelCenterRawReorder
      ((((volume : Measure E3).prod volume).prod volume).prod volume)
      (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume)) := by
  let e₃ : (E3 × E3) × E3 ≃ᵐ (E3 × E3) × E3 :=
    ((MeasurableEquiv.prodAssoc.trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.prodComm : E3 × E3 ≃ᵐ E3 × E3))).trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.shearSubRight E3))).trans
      MeasurableEquiv.prodAssoc.symm
  let e : ((E3 × E3) × E3) × ℝ ≃ᵐ
      (E3 × E3) × (E3 × ℝ) :=
    (MeasurableEquiv.prodCongr e₃ (MeasurableEquiv.refl ℝ)).trans
      MeasurableEquiv.prodAssoc
  have hassoc : MeasurePreserving
      (MeasurableEquiv.prodAssoc : (E3 × E3) × E3 ≃ᵐ E3 × (E3 × E3))
      (((volume : Measure E3).prod volume).prod volume)
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume)) :=
    measurePreserving_prodAssoc volume volume volume
  have hswap : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.prodComm : E3 × E3 ≃ᵐ E3 × E3))
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume))
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume)) := by
    exact (MeasurePreserving.id (volume : Measure E3)).prod
      (MeasureTheory.Measure.measurePreserving_swap
        (μ := (volume : Measure E3)) (ν := (volume : Measure E3)))
  have hshear : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.shearSubRight E3))
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume))
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume)) := by
    have hsub : MeasurePreserving (fun z : E3 × E3 ↦ (z.1, z.2 - z.1))
        ((volume : Measure E3).prod volume)
        ((volume : Measure E3).prod volume) :=
      measurePreserving_prod_sub volume volume
    have hprod := (MeasurePreserving.id (volume : Measure E3)).prod hsub
    convert hprod using 1
    rfl
  have he₃ : MeasurePreserving e₃
      (((volume : Measure E3).prod volume).prod volume)
      (((volume : Measure E3).prod volume).prod volume) := by
    dsimp only [e₃]
    exact ((hassoc.trans hswap).trans hshear).trans hassoc.symm
  have he : MeasurePreserving e
      ((((volume : Measure E3).prod volume).prod volume).prod volume)
      (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume)) := by
    dsimp only [e]
    exact (he₃.prod (MeasurePreserving.id (volume : Measure ℝ))).trans
      (measurePreserving_prodAssoc
        ((volume : Measure E3).prod volume) volume volume)
  have hlast : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.shearSubRight E3)
        (MeasurableEquiv.refl (E3 × ℝ)))
      (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume))
      (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume)) := by
    have hsub : MeasurePreserving (fun z : E3 × E3 ↦ (z.1, z.2 - z.1))
        ((volume : Measure E3).prod volume)
        ((volume : Measure E3).prod volume) :=
      measurePreserving_prod_sub volume volume
    have hprod := hsub.prod
      (MeasurePreserving.id
        ((volume : Measure E3).prod (volume : Measure ℝ)))
    convert hprod using 1
    rfl
  change MeasurePreserving
    (((MeasurableEquiv.prodCongr e₃ (MeasurableEquiv.refl ℝ)).trans
      MeasurableEquiv.prodAssoc).trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.shearSubRight E3)
        (MeasurableEquiv.refl (E3 × ℝ)))) _ _
  exact he.trans hlast

@[simp] theorem modelCenterRawReorder_apply
    (x y p : E3) (r : ℝ) :
    modelCenterRawReorder (((x, y), p), r) =
      ((x, p - x), (y - p, r)) := by
  simp [modelCenterRawReorder, MeasurableEquiv.trans_apply,
    MeasurableEquiv.prodCongr, MeasurableEquiv.prodAssoc,
    MeasurableEquiv.prodComm, MeasurableEquiv.shearSubRight]

/-- The pulled-back separated majorant in the original raw center order. -/
noncomputable def modelRawCenterMajorant
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (A : E3 → ℝ)
    (z : ℝ × (((E3 × E3) × E3) × ℝ)) : ℝ :=
  modelCenterMajorant α u c A z.1 (modelCenterRawReorder z.2)

/-- Pulling the separated majorant through the two spatial shears preserves
joint integrability. -/
theorem integrable_modelRawCenterMajorant_of_isFinite
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (A : E3 → ℝ)
    (ν : Measure ℝ) [IsFiniteMeasure ν]
    (hc : Measurable c) (hcBound : ∀ t : ℝ, |c t| ≤ 1)
    (hAmeas : Measurable A) (hAint : Integrable A)
    (hAnonneg : ∀ x : E3, 0 ≤ A x)
    (hpos : ∀ᵐ t ∂ν, 0 < t) :
    Integrable (modelRawCenterMajorant α u c A)
      (ν.prod ((((volume : Measure E3).prod volume).prod volume).prod volume)) := by
  let η : Measure (((E3 × E3) × E3) × ℝ) :=
    (((volume : Measure E3).prod volume).prod volume).prod volume
  let μ : Measure ((E3 × E3) × (E3 × ℝ)) :=
    ((volume : Measure E3).prod volume).prod
      ((volume : Measure E3).prod volume)
  have hbase : Integrable (fun z : ℝ × ((E3 × E3) × (E3 × ℝ)) ↦
      modelCenterMajorant α u c A z.1 z.2) (ν.prod μ) := by
    simpa only [μ] using integrable_modelCenterMajorant_joint_of_isFinite
      α u c A ν hc hcBound hAmeas hAint hAnonneg hpos
  have hmp : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ) modelCenterRawReorder)
      (ν.prod η) (ν.prod μ) := by
    exact (MeasurePreserving.id ν).prod modelCenterRawReorder_measurePreserving
  apply hmp.integrable_comp_of_integrable hbase |>.congr
  filter_upwards [] with z
  rfl

/-- The raw center-translation integrand, including a measurable scale
coefficient, is jointly measurable before any estimate is applied. -/
theorem measurable_coefficient_modelCenterTranslation
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (hc : Measurable c) :
    Measurable (fun z : ℝ × (((E3 × E3) × E3) × ℝ) ↦
      c z.1 * ModelCenterTranslationIntegrand α u F z.1 z.2) := by
  let X := ℝ × (((E3 × E3) × E3) × ℝ)
  have ht : Measurable (fun z : X ↦ z.1) := measurable_fst
  have hx : Measurable (fun z : X ↦ z.2.1.1.1) :=
    measurable_fst.comp (measurable_fst.comp (measurable_fst.comp measurable_snd))
  have hy : Measurable (fun z : X ↦ z.2.1.1.2) :=
    measurable_snd.comp (measurable_fst.comp (measurable_fst.comp measurable_snd))
  have hp : Measurable (fun z : X ↦ z.2.1.2) :=
    measurable_snd.comp (measurable_fst.comp measurable_snd)
  have hr : Measurable (fun z : X ↦ z.2.2) :=
    measurable_snd.comp measurable_snd
  have hxi (i : Fin 3) : Measurable (fun z : X ↦ z.2.1.1.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp hx
  have hyi (i : Fin 3) : Measurable (fun z : X ↦ z.2.1.1.2 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp hy
  have hpi (i : Fin 3) : Measurable (fun z : X ↦ z.2.1.2 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp hp
  have hderiv : Measurable gaussianDeriv := by
    unfold gaussianDeriv
    exact (measurable_const.mul measurable_id).mul
      gaussian_contDiff.continuous.measurable
  have h0 : Measurable (fun z : X ↦ F 0 z.2.1.1.1) :=
    (F 0).continuous.measurable.comp hx
  have h1 : Measurable (fun z : X ↦
      F 1 (modelPoint (z.2.1.1.2 0) (z.2.1.1.1 1) (z.2.1.1.1 2))) :=
    (F 1).continuous.measurable.comp
      (measurable_modelPoint _ _ _ (hyi 0) (hxi 1) (hxi 2))
  have h2 : Measurable (fun z : X ↦
      F 2 (modelPoint (z.2.1.1.1 0) (z.2.1.1.2 1) (z.2.1.1.1 2))) :=
    (F 2).continuous.measurable.comp
      (measurable_modelPoint _ _ _ (hxi 0) (hyi 1) (hxi 2))
  have h3 : Measurable (fun z : X ↦
      F 3 (modelPoint (z.2.1.1.1 0) (z.2.1.1.1 1) (z.2.1.1.2 2))) :=
    (F 3).continuous.measurable.comp
      (measurable_modelPoint _ _ _ (hxi 0) (hxi 1) (hyi 2))
  have hphi0 : Measurable (fun z : X ↦
      modelPhiAt (z.1 ^ α.weight 0)
        (z.2.1.2 0 + z.1 ^ α.weight 0 * u 0) (z.2.1.1.1 0)) :=
    measurable_kernelAt conePhiPhysicalReal
      conePhiPhysicalReal.continuous.measurable _ _ _
      (ht.pow_const _) ((hpi 0).add ((ht.pow_const _).mul measurable_const)) (hxi 0)
  have hgauss0 : Measurable (fun z : X ↦
      gaussianAt (z.1 ^ α.weight 0) (z.2.1.2 0) (z.2.1.1.2 0)) :=
    measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable _ _ _
      (ht.pow_const _) (hpi 0) (hyi 0)
  have hphi1 : Measurable (fun z : X ↦
      modelPhiAt (z.1 ^ α.weight 1)
        (z.2.1.2 1 + z.1 ^ α.weight 1 * u 1) (z.2.1.1.1 1)) :=
    measurable_kernelAt conePhiPhysicalReal
      conePhiPhysicalReal.continuous.measurable _ _ _
      (ht.pow_const _) ((hpi 1).add ((ht.pow_const _).mul measurable_const)) (hxi 1)
  have hgauss1 : Measurable (fun z : X ↦
      gaussianAt (z.1 ^ α.weight 1) (z.2.1.2 1) (z.2.1.1.2 1)) :=
    measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable _ _ _
      (ht.pow_const _) (hpi 1) (hyi 1)
  have hderiv0 : Measurable (fun z : X ↦
      gaussianDerivAt (z.1 ^ α.weight 2) (z.2.1.2 2) (z.2.1.1.1 2)) :=
    measurable_kernelAt gaussianDeriv hderiv _ _ _
      (ht.pow_const _) (hpi 2) (hxi 2)
  have hderiv1 : Measurable (fun z : X ↦
      gaussianDerivAt (z.1 ^ α.weight 2)
        (z.2.1.2 2 + z.2.2 * z.1 ^ α.weight 2) (z.2.1.1.2 2)) :=
    measurable_kernelAt gaussianDeriv hderiv _ _ _
      (ht.pow_const _) ((hpi 2).add (hr.mul (ht.pow_const _))) (hyi 2)
  have hpsi : Measurable (fun z : X ↦
      conePsiPhysicalReal (z.2.2 + u 2)) :=
    conePsiPhysicalReal.continuous.measurable.comp (hr.add measurable_const)
  have hc' : Measurable (fun z : X ↦ c z.1) := hc.comp ht
  change Measurable (fun z : X ↦ c z.1 *
    ((F 0 z.2.1.1.1 * F 1 (modelPoint (z.2.1.1.2 0)
          (z.2.1.1.1 1) (z.2.1.1.1 2)) *
        F 2 (modelPoint (z.2.1.1.1 0) (z.2.1.1.2 1) (z.2.1.1.1 2)) *
        F 3 (modelPoint (z.2.1.1.1 0) (z.2.1.1.1 1) (z.2.1.1.2 2))) *
      ((modelPhiAt (z.1 ^ α.weight 0)
          (z.2.1.2 0 + z.1 ^ α.weight 0 * u 0) (z.2.1.1.1 0) *
        gaussianAt (z.1 ^ α.weight 0) (z.2.1.2 0) (z.2.1.1.2 0)) *
      (modelPhiAt (z.1 ^ α.weight 1)
          (z.2.1.2 1 + z.1 ^ α.weight 1 * u 1) (z.2.1.1.1 1) *
        gaussianAt (z.1 ^ α.weight 1) (z.2.1.2 1) (z.2.1.1.2 1)) *
      (gaussianDerivAt (z.1 ^ α.weight 2) (z.2.1.2 2) (z.2.1.1.1 2) *
        gaussianDerivAt (z.1 ^ α.weight 2)
          (z.2.1.2 2 + z.2.2 * z.1 ^ α.weight 2) (z.2.1.1.2 2) *
          conePsiPhysicalReal (z.2.2 + u 2)))))
  exact hc'.mul
    ((((h0.mul h1).mul h2).mul h3).mul
      (((hphi0.mul hgauss0).mul (hphi1.mul hgauss1)).mul
        ((hderiv0.mul hderiv1).mul hpsi)))

/-- A bounded measurable scale coefficient times the raw center integrand
is jointly integrable over every finite positive scale measure. -/
theorem integrable_coefficient_modelCenterTranslation_of_isFinite
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (ν : Measure ℝ) [IsFiniteMeasure ν]
    (hc : Measurable c) (hcBound : ∀ t : ℝ, |c t| ≤ 1)
    (hpos : ∀ᵐ t ∂ν, 0 < t) :
    Integrable (fun z : ℝ × (((E3 × E3) × E3) × ℝ) ↦
      c z.1 * ModelCenterTranslationIntegrand α u F z.1 z.2)
      (ν.prod ((((volume : Measure E3).prod volume).prod volume).prod volume)) := by
  obtain ⟨B₁, hB₁, hF₁⟩ := initialModelRealInput_bounded F 1
  obtain ⟨B₂, hB₂, hF₂⟩ := initialModelRealInput_bounded F 2
  obtain ⟨B₃, hB₃, hF₃⟩ := initialModelRealInput_bounded F 3
  let C : ℝ := B₁ * B₂ * B₃
  let A : E3 → ℝ := fun x ↦ C * |F 0 x|
  have hAmeas : Measurable A := by
    dsimp only [A]
    exact measurable_const.mul ((F 0).continuous.measurable.norm)
  have hAint : Integrable A := by
    have hF₀ : Integrable (fun x : E3 ↦ |F 0 x|) := by
      simpa only [Real.norm_eq_abs] using (F 0).integrable.norm
    simpa only [A] using hF₀.const_mul C
  have hAnonneg : ∀ x : E3, 0 ≤ A x := by
    intro x
    dsimp only [A, C]
    exact mul_nonneg (mul_nonneg (mul_nonneg hB₁ hB₂) hB₃) (abs_nonneg _)
  have hmajor : Integrable (modelRawCenterMajorant α u c A)
      (ν.prod ((((volume : Measure E3).prod volume).prod volume).prod volume)) :=
    integrable_modelRawCenterMajorant_of_isFinite
      α u c A ν hc hcBound hAmeas hAint hAnonneg hpos
  have hmeas : AEStronglyMeasurable
      (fun z : ℝ × (((E3 × E3) × E3) × ℝ) ↦
        c z.1 * ModelCenterTranslationIntegrand α u F z.1 z.2)
      (ν.prod ((((volume : Measure E3).prod volume).prod volume).prod volume)) :=
    (measurable_coefficient_modelCenterTranslation α u c F hc).aestronglyMeasurable
  apply hmajor.mono' hmeas
  filter_upwards [] with z
  rcases z with ⟨t, ⟨⟨⟨x, y⟩, p⟩, r⟩⟩
  change ‖c t * ModelCenterTranslationIntegrand α u F t (((x, y), p), r)‖ ≤
    modelRawCenterMajorant α u c A (t, (((x, y), p), r))
  rw [Real.norm_eq_abs]
  simp only [ModelCenterTranslationIntegrand, abs_mul,
    modelRawCenterMajorant, modelCenterRawReorder_apply,
    modelCenterMajorant, modelCenterP, modelCenterQ]
  rw [modelPhiAt_center_shift (t ^ α.weight 0) (p 0)
      (t ^ α.weight 0 * u 0) (x 0),
    gaussianAt_center_shift (t ^ α.weight 0) (p 0) (y 0),
    modelPhiAt_center_shift (t ^ α.weight 1) (p 1)
      (t ^ α.weight 1 * u 1) (x 1),
    gaussianAt_center_shift (t ^ α.weight 1) (p 1) (y 1),
    gaussianDerivAt_center_shift (t ^ α.weight 2) (p 2) (x 2),
    show gaussianDerivAt (t ^ α.weight 2)
        (p 2 + r * t ^ α.weight 2) (y 2) =
        gaussianDerivAt (t ^ α.weight 2)
          (r * t ^ α.weight 2) (y 2 - p 2) by
        simpa only [gaussianDerivAt] using
          kernelAt_center_shift gaussianDeriv (t ^ α.weight 2)
            (p 2) (r * t ^ α.weight 2) (y 2)]
  simp only [PiLp.sub_apply, neg_sub]
  have hinput :
      |F 1 (modelPoint (y 0) (x 1) (x 2))| *
        |F 2 (modelPoint (x 0) (y 1) (x 2))| *
          |F 3 (modelPoint (x 0) (x 1) (y 2))| ≤ C := by
    dsimp only [C]
    gcongr
    · exact hF₁ _
    · exact hF₂ _
    · exact hF₃ _
  have hkernel : 0 ≤
      (|modelPhiAt (t ^ α.weight 0)
          (t ^ α.weight 0 * u 0) (x 0 - p 0)| *
        |modelPhiAt (t ^ α.weight 1)
          (t ^ α.weight 1 * u 1) (x 1 - p 1)| *
        |gaussianDerivAt (t ^ α.weight 2) 0 (x 2 - p 2)|) *
      ((|gaussianAt (t ^ α.weight 0) 0 (y 0 - p 0)| *
          |gaussianAt (t ^ α.weight 1) 0 (y 1 - p 1)|) *
        (|gaussianDerivAt (t ^ α.weight 2)
            (r * t ^ α.weight 2) (y 2 - p 2)| *
          |conePsiPhysicalReal (r + u 2)|)) := by
    positivity
  have hinputF0 :
      (|F 1 (modelPoint (y 0) (x 1) (x 2))| *
        |F 2 (modelPoint (x 0) (y 1) (x 2))| *
        |F 3 (modelPoint (x 0) (x 1) (y 2))|) * |F 0 x| ≤
        C * |F 0 x| :=
    mul_le_mul_of_nonneg_right hinput (abs_nonneg _)
  have hinside :
      ((|F 1 (modelPoint (y 0) (x 1) (x 2))| *
        |F 2 (modelPoint (x 0) (y 1) (x 2))| *
        |F 3 (modelPoint (x 0) (x 1) (y 2))|) * |F 0 x|) *
        ((|modelPhiAt (t ^ α.weight 0)
            (t ^ α.weight 0 * u 0) (x 0 - p 0)| *
          |modelPhiAt (t ^ α.weight 1)
            (t ^ α.weight 1 * u 1) (x 1 - p 1)| *
          |gaussianDerivAt (t ^ α.weight 2) 0 (x 2 - p 2)|) *
          ((|gaussianAt (t ^ α.weight 0) 0 (y 0 - p 0)| *
            |gaussianAt (t ^ α.weight 1) 0 (y 1 - p 1)|) *
            (|gaussianDerivAt (t ^ α.weight 2)
                (r * t ^ α.weight 2) (y 2 - p 2)| *
              |conePsiPhysicalReal (r + u 2)|))) ≤
      (C * |F 0 x|) *
        ((|modelPhiAt (t ^ α.weight 0)
            (t ^ α.weight 0 * u 0) (x 0 - p 0)| *
          |modelPhiAt (t ^ α.weight 1)
            (t ^ α.weight 1 * u 1) (x 1 - p 1)| *
          |gaussianDerivAt (t ^ α.weight 2) 0 (x 2 - p 2)|) *
          ((|gaussianAt (t ^ α.weight 0) 0 (y 0 - p 0)| *
            |gaussianAt (t ^ α.weight 1) 0 (y 1 - p 1)|) *
            (|gaussianDerivAt (t ^ α.weight 2)
                (r * t ^ α.weight 2) (y 2 - p 2)| *
              |conePsiPhysicalReal (r + u 2)|))) :=
    mul_le_mul_of_nonneg_right hinputF0 hkernel
  have htotal := mul_le_mul_of_nonneg_left hinside (abs_nonneg (c t))
  calc
    |c t| *
        (|F 0 x| * |F 1 (modelPoint (y 0) (x 1) (x 2))| *
          |F 2 (modelPoint (x 0) (y 1) (x 2))| *
          |F 3 (modelPoint (x 0) (x 1) (y 2))| *
          ((|modelPhiAt (t ^ α.weight 0)
              (t ^ α.weight 0 * u 0) (x 0 - p 0)| *
            |gaussianAt (t ^ α.weight 0) 0 (y 0 - p 0)|) *
            (|modelPhiAt (t ^ α.weight 1)
              (t ^ α.weight 1 * u 1) (x 1 - p 1)| *
            |gaussianAt (t ^ α.weight 1) 0 (y 1 - p 1)|) *
            (|gaussianDerivAt (t ^ α.weight 2) 0 (x 2 - p 2)| *
            |gaussianDerivAt (t ^ α.weight 2)
              (r * t ^ α.weight 2) (y 2 - p 2)| *
              |conePsiPhysicalReal (r + u 2)|))) =
      |c t| *
        ((|F 1 (modelPoint (y 0) (x 1) (x 2))| *
          |F 2 (modelPoint (x 0) (y 1) (x 2))| *
          |F 3 (modelPoint (x 0) (x 1) (y 2))|) * |F 0 x| *
        ((|modelPhiAt (t ^ α.weight 0)
            (t ^ α.weight 0 * u 0) (x 0 - p 0)| *
          |modelPhiAt (t ^ α.weight 1)
            (t ^ α.weight 1 * u 1) (x 1 - p 1)| *
          |gaussianDerivAt (t ^ α.weight 2) 0 (x 2 - p 2)|) *
          ((|gaussianAt (t ^ α.weight 0) 0 (y 0 - p 0)| *
            |gaussianAt (t ^ α.weight 1) 0 (y 1 - p 1)|) *
            (|gaussianDerivAt (t ^ α.weight 2)
                (r * t ^ α.weight 2) (y 2 - p 2)| *
              |conePsiPhysicalReal (r + u 2)|)))) := by ring
    _ ≤ |c t| *
        ((C * |F 0 x|) *
        ((|modelPhiAt (t ^ α.weight 0)
            (t ^ α.weight 0 * u 0) (x 0 - p 0)| *
          |modelPhiAt (t ^ α.weight 1)
            (t ^ α.weight 1 * u 1) (x 1 - p 1)| *
          |gaussianDerivAt (t ^ α.weight 2) 0 (x 2 - p 2)|) *
          ((|gaussianAt (t ^ α.weight 0) 0 (y 0 - p 0)| *
            |gaussianAt (t ^ α.weight 1) 0 (y 1 - p 1)|) *
            (|gaussianDerivAt (t ^ α.weight 2)
                (r * t ^ α.weight 2) (y 2 - p 2)| *
              |conePsiPhysicalReal (r + u 2)|)))) := htotal
    _ = _ := by
      dsimp only [A]
      ring

/-- The raw center-translation expression is jointly integrable on every
literal finite truncation scale band. -/
theorem integrable_coefficient_modelCenterTranslation_truncationScale
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (N : ℕ) (hc : Measurable c) (hcBound : ∀ t : ℝ, |c t| ≤ 1) :
    Integrable (fun z : ℝ × (((E3 × E3) × E3) × ℝ) ↦
      c z.1 * ModelCenterTranslationIntegrand α u F z.1 z.2)
      ((((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (truncationScaleSet N)).prod
        ((((volume : Measure E3).prod volume).prod volume).prod volume)) := by
  let ν : Measure ℝ := ((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
    (truncationScaleSet N)
  letI : IsFiniteMeasure ν := by
    dsimp only [ν]
    exact isFiniteMeasure_truncationScaleSet N
  apply integrable_coefficient_modelCenterTranslation_of_isFinite
    α u c F ν hc hcBound
  filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
  exact truncationScaleSet_subset_positive N ht

/-- The fully opened fiber integrand is absolutely integrable on each
finite truncation slab for every bounded measurable coefficient and real
Schwartz input. -/
theorem integrable_modelFiberFullyExpanded_truncationScale
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (N : ℕ) (hc : Measurable c) (hcBound : ∀ t : ℝ, |c t| ≤ 1) :
    Integrable (modelFiberFullyExpandedIntegrand α u c (InitialModelRealInput F))
      (((cubeScaleMeasure.restrict (Set.univ ×ˢ truncationScaleSet N)).prod
        (volume : Measure ModelE5)).prod ((volume : Measure ℝ).prod volume)) := by
  let ν : Measure ℝ := ((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
    (truncationScaleSet N)
  let η : Measure (((E3 × E3) × E3) × ℝ) :=
    (((volume : Measure E3).prod volume).prod volume).prod volume
  let e := modelFiberCenterReorder
  have hraw : Integrable (fun z : ℝ × (((E3 × E3) × E3) × ℝ) ↦
      c z.1 * ModelCenterTranslationIntegrand α u F z.1 z.2) (ν.prod η) := by
    simpa only [ν, η] using
      integrable_coefficient_modelCenterTranslation_truncationScale
        α u c F N hc hcBound
  have hscale : cubeScaleMeasure.restrict
      (Set.univ ×ˢ truncationScaleSet N) = (volume : Measure E3).prod ν := by
    unfold cubeScaleMeasure ν
    rw [← Measure.prod_restrict]
    simp
  have hmp : MeasurePreserving e
      (((((volume : Measure E3).prod ν).prod
        (volume : Measure ModelE5)).prod ((volume : Measure ℝ).prod volume)))
      (ν.prod η) := by
    simpa only [e, η] using modelFiberCenterReorder_measurePreserving ν
  have htransport : Integrable (fun q : ((E3 × ℝ) × ModelE5) × (ℝ × ℝ) ↦
      (fun z : ℝ × (((E3 × E3) × E3) × ℝ) ↦
        c z.1 * ModelCenterTranslationIntegrand α u F z.1 z.2) (e q))
      (((((volume : Measure E3).prod ν).prod
        (volume : Measure ModelE5)).prod ((volume : Measure ℝ).prod volume))) :=
    hmp.integrable_comp_of_integrable hraw
  rw [hscale]
  apply htransport.congr
  filter_upwards [] with q
  rcases hq : e q with ⟨t, ⟨⟨⟨x, y⟩, p⟩, r⟩⟩
  rw [← e.symm_apply_apply q, hq]
  simpa only [e] using
    (modelFiberFullyExpandedIntegrand_centerReorder_symm
      α u c F t x y p r).symm

/-! ### Strict initial model range -/

/-- Rescaling a nonzero finite `L^p` size by its reciprocal produces unit
`lpNorm`. -/
theorem lpNorm_inv_smul_eq_one
    (f : E3 → ℝ) (p : ℝ)
    (hpos : 0 < lpNorm f (ENNReal.ofReal p) volume) :
    lpNorm ((lpNorm f (ENNReal.ofReal p) volume)⁻¹ • f)
      (ENNReal.ofReal p) volume = 1 := by
  rw [lpNorm_const_smul]
  have hnorm : ‖(lpNorm f (ENNReal.ofReal p) volume)⁻¹‖₊ =
      (lpNorm f (ENNReal.ofReal p) volume)⁻¹ := by
    change ‖(lpNorm f (ENNReal.ofReal p) volume)⁻¹‖ =
      (lpNorm f (ENNReal.ofReal p) volume)⁻¹
    rw [Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hpos)]
  rw [hnorm, inv_mul_cancel₀ hpos.ne']

/-- Unit finite `lpNorm` is equivalent to a unit ordinary power integral for
a strongly measurable real function. -/
theorem integral_abs_rpow_eq_one_of_lpNorm_eq_one
    (f : E3 → ℝ) (p : ℝ) (hp : 0 < p)
    (hf : AEStronglyMeasurable f volume)
    (hnorm : lpNorm f (ENNReal.ofReal p) volume = 1) :
    (∫ x : E3, |f x| ^ p) = 1 := by
  have hp0 : (ENNReal.ofReal p) ≠ 0 :=
    ENNReal.ofReal_ne_zero_iff.mpr hp
  have hptop : (ENNReal.ofReal p) ≠ ∞ := ENNReal.ofReal_ne_top
  have hlp := lpNorm_eq_integral_norm_rpow_toReal hp0 hptop hf
  simp only [ENNReal.toReal_ofReal hp.le, Real.norm_eq_abs] at hlp
  have hI : 0 ≤ ∫ x : E3, |f x| ^ p :=
    integral_nonneg fun x ↦ Real.rpow_nonneg (abs_nonneg _) _
  have hpow := congrArg (fun z : ℝ ↦ z ^ p) hnorm
  rw [hlp, Real.one_rpow, Real.rpow_inv_rpow hI hp.ne'] at hpow
  exact hpow

/-- A nonzero real Schwartz function has strictly positive finite `L^p`
size at every positive finite exponent. -/
theorem lpNorm_pos_of_realSchwartz_ne_zero
    (f : SchwartzMap E3 ℝ) (p : ℝ) (hp : 0 < p) (hf : f ≠ 0) :
    0 < lpNorm (f : E3 → ℝ) (ENNReal.ofReal p) volume := by
  have hp0 : (ENNReal.ofReal p) ≠ 0 :=
    ENNReal.ofReal_ne_zero_iff.mpr hp
  have hmem : MemLp (f : E3 → ℝ) (ENNReal.ofReal p) volume :=
    f.memLp (ENNReal.ofReal p) volume
  have hne : lpNorm (f : E3 → ℝ) (ENNReal.ofReal p) volume ≠ 0 := by
    intro hzero
    have hae : (f : E3 → ℝ) =ᵐ[volume] 0 :=
      (lpNorm_eq_zero hmem hp0).mp hzero
    have hfun : (f : E3 → ℝ) = 0 :=
      (f.continuous.ae_eq_iff_eq (μ := volume) continuous_zero).mp hae
    apply hf
    ext x
    exact congrFun hfun x
  exact lt_of_le_of_ne lpNorm_nonneg hne.symm

/-- A four-linear real model functional which is bounded on independently
normalized inputs is bounded by the product of the four normalizing sizes. -/
theorem fourlinear_bound_of_normalized_bound
    (L : ModelSchwartzInput → ℝ)
    (N : Fin 4 → SchwartzMap E3 ℝ → ℝ)
    (C : ℝ)
    (hL : ∀ (a : Fin 4 → ℝ) (F : ModelSchwartzInput),
      L (modelInputRescale a F) = (∏ j : Fin 4, a j) * L F)
    (hunit : ∀ G : ModelSchwartzInput,
      (∀ j : Fin 4, N j (G j) = 1) → |L G| ≤ C)
    (F : ModelSchwartzInput)
    (hpos : ∀ j : Fin 4, 0 < N j (F j))
    (hnormalize : ∀ j : Fin 4,
      N j ((N j (F j))⁻¹ • F j) = 1) :
    |L F| ≤ C * ∏ j : Fin 4, N j (F j) := by
  let a : Fin 4 → ℝ := fun j ↦ (N j (F j))⁻¹
  let P : ℝ := ∏ j : Fin 4, N j (F j)
  have hPpos : 0 < P := by
    dsimp only [P]
    exact Finset.prod_pos fun j _ ↦ hpos j
  have hPnonneg : 0 ≤ P := hPpos.le
  have haPos : 0 < ∏ j : Fin 4, a j := by
    apply Finset.prod_pos
    intro j _
    dsimp only [a]
    exact inv_pos.mpr (hpos j)
  have haP : P * ∏ j : Fin 4, a j = 1 := by
    dsimp only [P, a]
    rw [← Finset.prod_mul_distrib]
    apply Finset.prod_eq_one
    intro j _
    exact mul_inv_cancel₀ (hpos j).ne'
  have hnorm : ∀ j : Fin 4, N j (modelInputRescale a F j) = 1 := by
    intro j
    change N j (a j • F j) = 1
    exact hnormalize j
  have hnormalized := hunit (modelInputRescale a F) hnorm
  rw [hL a F, abs_mul] at hnormalized
  calc
    |L F| = (P * ∏ j : Fin 4, a j) * |L F| := by rw [haP]; ring
    _ = P * (|(∏ j : Fin 4, a j)| * |L F|) := by
      rw [abs_of_pos haPos]
      ring
    _ ≤ P * C := mul_le_mul_of_nonneg_left hnormalized hPnonneg
    _ = C * ∏ j : Fin 4, N j (F j) := by
      dsimp only [P]
      ring

/-- The two-index limit only needs finite-forest bounds for the actual
measurable scale cutoffs of the given coefficient. -/
theorem modelFullForm_bound_of_restrictedForest
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (B : ℝ) (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hfull : ∀ N : ℕ, Integrable
      (modelFiberFullyExpandedIntegrand α u c (InitialModelRealInput F))
      (((cubeScaleMeasure.restrict
        (Set.univ ×ˢ truncationScaleSet N)).prod
          (volume : Measure ModelE5)).prod
        ((volume : Measure ℝ).prod volume)))
    (hforest : ∀ N M : ℕ,
      |expandedModelLocalForm α (truncationCollection α M) u
        (RestrictScaleCoefficient c (truncationScaleSet N))
        (InitialModelRealInput F)| ≤ B) :
    |ModelFullForm α u c F| ≤ B := by
  have hscale := tendsto_ModelScaleTruncation_of_realSchwartz
    α u c F hcmeas hc
  have hscaleAbs : Tendsto (fun N ↦ |ModelScaleTruncation α u c F N|)
      atTop (𝓝 |ModelFullForm α u c F|) := by
    exact (continuous_abs.tendsto _).comp hscale
  apply le_of_tendsto hscaleAbs
  filter_upwards [] with N
  apply modelScaleTruncation_bound_of_twoIndex_localization
    α u c F B N
  · exact tendsto_expandedModelLocalForm_twoIndex_of_fullyExpanded_auto
      α u c F N (hfull N)
  · exact hforest N

/-- A fixed uniform finite-forest constant and a scalar stopping-envelope
bound yield the full real Schwartz model estimate. -/
theorem modelFullForm_bound_of_initial_stoppingEnvelope_of_uniformForest
    (α : Anisotropy) (C : ℝ) (hC : 0 ≤ C)
    (hforest : ∀ S (_hS : IsConvexCollection α S) u c
      (F : InitialModelSchwartzInput) (q σ : Fin 4 → ℝ)
      (_hq : ∀ j, 0 < q j)
      (hpos : ∀ r ∈ S, ∀ j,
        0 < stoppingData α S (sourceStoppingExponent j)
          (InitialModelRealInput F j) r)
      (_hcmeas : Measurable c) (_hc : ∀ t, |c t| ≤ 1)
      (_hfinite : ∀ (j : Fin 4) (m : ℤ),
        volume (sourceStoppingMaximalLevelSetAt α
          (InitialModelRealInput F) j m) ≠ ∞),
      |expandedModelLocalForm α S u c (InitialModelRealInput F)| ≤
        C * sourceWeight u ^ 75 *
          SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F)
            q σ hpos)
    (u : E3) (c : ℝ → ℝ) (F : InitialModelSchwartzInput)
    (q σ : Fin 4 → ℝ) (W : ℝ)
    (hq : ∀ j, 0 < q j) (hFnonzero : ∀ j, F j ≠ 0)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hfull : ∀ N : ℕ, Integrable
      (modelFiberFullyExpandedIntegrand α u c (InitialModelRealInput F))
      (((cubeScaleMeasure.restrict
        (Set.univ ×ˢ truncationScaleSet N)).prod
          (volume : Measure ModelE5)).prod
        ((volume : Measure ℝ).prod volume)))
    (hdistribution : ∀ M : ℕ,
      SourceStoppingCoordinateEnvelope α (truncationCollection α M)
        (InitialModelRealInput F) q σ
        (initialModel_sourceStoppingData_all_pos_of_ne_zero
          α (truncationCollection α M) F hFnonzero) ≤ W) :
    |ModelFullForm α u c F| ≤ C * sourceWeight u ^ 75 * W := by
  apply modelFullForm_bound_of_restrictedForest
    α u c F (C * sourceWeight u ^ 75 * W) hcmeas hc hfull
  intro N M
  let d : ℝ → ℝ := RestrictScaleCoefficient c (truncationScaleSet N)
  let hpos : ∀ r ∈ truncationCollection α M, ∀ j,
      0 < stoppingData α (truncationCollection α M)
        (sourceStoppingExponent j) (InitialModelRealInput F j) r :=
    initialModel_sourceStoppingData_all_pos_of_ne_zero
      α (truncationCollection α M) F hFnonzero
  have hdmeas : Measurable d := by
    exact measurable_RestrictScaleCoefficient c (truncationScaleSet N)
      hcmeas measurableSet_Ioc
  have hd : ∀ t : ℝ, |d t| ≤ 1 := by
    exact abs_restrictScaleCoefficient_le_one c (truncationScaleSet N) hc
  have hfinite : ∀ (j : Fin 4) (m : ℤ),
      volume (sourceStoppingMaximalLevelSetAt α
        (InitialModelRealInput F) j m) ≠ ∞ := by
    exact sourceStopping_coordinateLevel_finite_of_initialModelRealSchwartz α F
  have hlocal := hforest (truncationCollection α M)
    (isConvexCollection_truncationCollection α M) u d F q σ hq hpos
    hdmeas hd hfinite
  change |expandedModelLocalForm α (truncationCollection α M) u d
    (InitialModelRealInput F)| ≤ C * sourceWeight u ^ 75 * W
  calc
    |expandedModelLocalForm α (truncationCollection α M) u d
        (InitialModelRealInput F)| ≤
        C * sourceWeight u ^ 75 *
          SourceStoppingCoordinateEnvelope α (truncationCollection α M)
            (InitialModelRealInput F) q σ hpos := hlocal
    _ ≤ C * sourceWeight u ^ 75 * W := by
      apply mul_le_mul_of_nonneg_left (hdistribution M)
      exact mul_nonneg hC (pow_nonneg (sourceWeight_nonneg u) _)

/-- The explicitly assembled stopping constant is nonnegative. -/
theorem sourceStoppingDyadicInputConstant_nonneg
    (K q : Fin 4 → ℝ) (j : Fin 4) (hq : 0 < q j) :
    0 ≤ sourceStoppingDyadicInputConstant K q j := by
  unfold sourceStoppingDyadicInputConstant
  calc
    0 ≤ (8 * ((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
        (sourceStoppingComparisonConstant j / 2) ^ (-(q j)))) *
        (dyadicStrongFactor (K j)
          (q j / sourceStoppingExponent j) ^ 3).toReal :=
      mul_nonneg
        (sourceStoppingDistributionCoefficient_nonneg j (q j) hq)
        ENNReal.toReal_nonneg
    _ = _ := by ring

/-- The complete strict initial range for a nonzero real Schwartz tuple.
The constant is independent of the translation, coefficient, and input tuple. -/
theorem initialModelFullForm_bound_of_nonzero
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : InitialModelSchwartzInput)
    (q : Fin 4 → ℝ)
    (hq : ∀ j : Fin 4, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j : Fin 4, sourceStoppingExponent j < q j)
    (hF : ∀ j : Fin 4, F j ≠ 0)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1) :
    ∃ C : ℝ, 0 ≤ C ∧
      |ModelFullForm α u c F| ≤ C * sourceWeight u ^ 75 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
  rcases exists_uniform_activeStoppingForest_constant α with
    ⟨C₀, hC₀, hforest⟩
  let K : Fin 4 → ℝ := fun _ ↦ dyadicBracketShellConstant
  let D : Fin 4 → ℝ := fun j ↦ sourceStoppingDyadicInputConstant K q j
  let C : ℝ := C₀ * ∑ j : Fin 4, D j
  have hD : ∀ j : Fin 4, 0 ≤ D j := by
    intro j
    dsimp only [D]
    exact sourceStoppingDyadicInputConstant_nonneg K q j (hq j)
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg hC₀ (Finset.sum_nonneg fun j _ ↦ hD j)
  refine ⟨C, hC, ?_⟩
  apply fourlinear_bound_of_normalized_bound
    (L := ModelFullForm α u c)
    (N := fun j f ↦ lpNorm (f : E3 → ℝ) (ENNReal.ofReal (q j)) volume)
    (C := C * sourceWeight u ^ 75)
  · exact ModelFullForm_rescale α u c
  · intro G hGunit
    have hG : ∀ j : Fin 4, G j ≠ 0 := by
      intro j hzero
      have hzeroNorm : lpNorm (G j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume = 0 := by
        rw [hzero]
        change lpNorm (0 : E3 → ℝ) (ENNReal.ofReal (q j)) volume = 0
        exact lpNorm_zero (ENNReal.ofReal (q j)) volume
      linarith [hGunit j]
    let W : ℝ := ∑ j : Fin 4, D j *
      ∫ x : E3, |G j x| ^ q j
    have hfull : ∀ N : ℕ, Integrable
        (modelFiberFullyExpandedIntegrand α u c (InitialModelRealInput G))
        (((cubeScaleMeasure.restrict
          (Set.univ ×ˢ truncationScaleSet N)).prod
            (volume : Measure ModelE5)).prod
          ((volume : Measure ℝ).prod volume)) := by
      intro N
      exact integrable_modelFiberFullyExpanded_truncationScale
        α u c G N hcmeas hc
    have hdistribution : ∀ M : ℕ,
        SourceStoppingCoordinateEnvelope α (truncationCollection α M)
          (InitialModelRealInput G) q (fun _ ↦ 0)
          (initialModel_sourceStoppingData_all_pos_of_ne_zero
            α (truncationCollection α M) G hG) ≤ W := by
      intro M
      dsimp only [W, D, K]
      exact initialSourceStoppingCoordinateEnvelope_le_explicitInputPowers_of_realSchwartz
        α (truncationCollection α M) G q hq hsum hqs hG
    have hglobal :=
      modelFullForm_bound_of_initial_stoppingEnvelope_of_uniformForest
        α C₀ hC₀ hforest u c G q (fun _ ↦ 0) W hq hG hcmeas hc
        hfull hdistribution
    have hpower (j : Fin 4) :
        (∫ x : E3, |G j x| ^ q j) = 1 :=
      integral_abs_rpow_eq_one_of_lpNorm_eq_one
        (G j : E3 → ℝ) (q j) (hq j)
        (G j).continuous.aestronglyMeasurable (hGunit j)
    have hW : W = ∑ j : Fin 4, D j := by
      dsimp only [W]
      apply Finset.sum_congr rfl
      intro j _
      rw [hpower j, mul_one]
    rw [hW] at hglobal
    change |ModelFullForm α u c G| ≤ C * sourceWeight u ^ 75
    dsimp only [C]
    calc
      |ModelFullForm α u c G| ≤ C₀ * sourceWeight u ^ 75 * ∑ j : Fin 4, D j := hglobal
      _ = (C₀ * ∑ j : Fin 4, D j) * sourceWeight u ^ 75 := by ring
  · intro j
    exact lpNorm_pos_of_realSchwartz_ne_zero
      (F j) (q j) (hq j) (hF j)
  · intro j
    exact lpNorm_inv_smul_eq_one
      (F j : E3 → ℝ) (q j)
      (lpNorm_pos_of_realSchwartz_ne_zero
        (F j) (q j) (hq j) (hF j))

/-- The strict initial real model range, including zero input branches. -/
theorem initialModelFullForm_bound
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : InitialModelSchwartzInput)
    (q : Fin 4 → ℝ)
    (hq : ∀ j : Fin 4, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j : Fin 4, sourceStoppingExponent j < q j)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1) :
    ∃ C : ℝ, 0 ≤ C ∧
      |ModelFullForm α u c F| ≤ C * sourceWeight u ^ 75 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
  by_cases hzero : ∃ j : Fin 4, F j = 0
  · rcases hzero with ⟨j, hj⟩
    refine ⟨0, le_rfl, ?_⟩
    rw [ModelFullForm_eq_zero_of_component_eq_zero α u c F j hj]
    norm_num
  · have hF : ∀ j : Fin 4, F j ≠ 0 := by
      intro j hj
      exact hzero ⟨j, hj⟩
    exact initialModelFullForm_bound_of_nonzero
      α u c F q hq hsum hqs hF hcmeas hc

/-! ## Section 9 coordinate-permuted finite model forms -/

/-- Extend a spatial-coordinate permutation by fixing the outer model input
and relabeling the three convolved inputs. -/
def modelInputIndex (σ : Equiv.Perm (Fin 3)) : Fin 4 → Fin 4 :=
  Fin.cases 0 (fun j ↦ (σ j).succ)

@[simp] theorem modelInputIndex_zero (σ : Equiv.Perm (Fin 3)) :
    modelInputIndex σ 0 = 0 := rfl

@[simp] theorem modelInputIndex_succ (σ : Equiv.Perm (Fin 3))
    (j : Fin 3) :
    modelInputIndex σ j.succ = (σ j).succ := rfl

/-- Pull a real spatial input back along the inverse coordinate relabeling,
as in the data transformation in `lem:permutation`. -/
noncomputable def coordinatePullback
    (σ : Equiv.Perm (Fin 3)) (f : E3 → ℝ) : E3 → ℝ :=
  fun x ↦ f ((coordinatePermutation σ).symm x)

@[simp] theorem coordinatePullback_apply
    (σ : Equiv.Perm (Fin 3)) (f : E3 → ℝ) (x : E3) :
    coordinatePullback σ f x =
      f ((coordinatePermutation σ).symm x) := rfl

/-- The permuted Schwartz tuple in the source coordinate-permutation lemma. -/
noncomputable def permutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelSchwartzInput) : ModelSchwartzInput :=
  fun j ↦ (SchwartzMap.compCLMOfContinuousLinearEquiv ℝ
    (coordinatePermutation σ).symm.toContinuousLinearEquiv)
      (F (modelInputIndex σ j))

@[simp] theorem permutedModelInput_apply
    (σ : Equiv.Perm (Fin 3)) (F : ModelSchwartzInput)
    (j : Fin 4) (x : E3) :
    permutedModelInput σ F j x =
      F (modelInputIndex σ j) ((coordinatePermutation σ).symm x) := by
  simp [permutedModelInput,
    SchwartzMap.compCLMOfContinuousLinearEquiv_apply]

/-- The corresponding tuple after forgetting Schwartz structure. -/
noncomputable def permutedModelRealInput
    (σ : Equiv.Perm (Fin 3)) (f : ModelRealInput) : ModelRealInput :=
  fun j ↦ coordinatePullback σ (f (modelInputIndex σ j))

@[simp] theorem permutedModelRealInput_apply
    (σ : Equiv.Perm (Fin 3)) (f : ModelRealInput)
    (j : Fin 4) (x : E3) :
    permutedModelRealInput σ f j x =
      f (modelInputIndex σ j) ((coordinatePermutation σ).symm x) := rfl

@[simp] theorem permutedModelRealInput_of_schwartz
    (σ : Equiv.Perm (Fin 3)) (F : ModelSchwartzInput) :
    InitialModelRealInput (permutedModelInput σ F) =
      permutedModelRealInput σ (InitialModelRealInput F) := by
  funext j x
  simp [InitialModelRealInput]

/-- The literal one-dimensional kernel at spatial coordinate `j` when the
annular (third) kernel is active at coordinate `i`. -/
noncomputable def activeModelKernel
    (i j : Fin 3) (u : E3) : ℝ → ℝ :=
  if j = i then ModelThirdKernel (u j) else ModelLowKernel (u j)

/-- The source spatial model integrand with an arbitrary active coordinate.
The outer input remains input zero; the three convolved inputs are paired
with their matching spatial coordinates. -/
noncomputable def activeModelSpatialIntegrand
    (α : Anisotropy) (i : Fin 3) (u : E3) (F : ModelSchwartzInput)
    (t : ℝ) (x : E3) : ℝ :=
  F 0 x * ∏ j : Fin 3,
    ModelCoordinateConvolution j (F j.succ)
      (activeModelKernel i j u) (t ^ α.weight j) x

/-- The finite-scale model form in an arbitrary active coordinate, faithful
to Definition `def:permuted_model`. -/
noncomputable def activeModelScaleTruncation
    (α : Anisotropy) (i : Fin 3) (u : E3) (c : ℝ → ℝ)
    (F : ModelSchwartzInput) (N : ℕ) : ℝ :=
  ∫ t in truncationScaleSet N,
    c t * (∫ x : E3, activeModelSpatialIntegrand α i u F t x)
      ∂((volume : Measure ℝ).withDensity cubeScaleDensity)

/-- The literal full-scale form with arbitrary active coordinate.  This is
the integral version of the source limit once the usual model convergence
theorem has identified the limit with the full scale integral. -/
noncomputable def activeModelFullForm
    (α : Anisotropy) (i : Fin 3) (u : E3) (c : ℝ → ℝ)
    (F : ModelSchwartzInput) : ℝ :=
  ∫ t in Set.Ioi (0 : ℝ),
    c t * (∫ x : E3, activeModelSpatialIntegrand α i u F t x)
      ∂((volume : Measure ℝ).withDensity cubeScaleDensity)

/-- At active coordinate three, the general finite-scale integrand is the
already formalized third-coordinate model integrand. -/
theorem activeModelSpatialIntegrand_two
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput)
    (t : ℝ) (x : E3) :
    activeModelSpatialIntegrand α 2 u F t x =
      ModelSpatialIntegrand α u F t x := by
  unfold activeModelSpatialIntegrand ModelSpatialIntegrand
  simp only [Fin.prod_univ_succ]
  simp [activeModelKernel]
  ring

/-- At active coordinate three, the generic finite-scale form is exactly the
canonical scale truncation. -/
theorem activeModelScaleTruncation_two
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ)
  (F : ModelSchwartzInput) (N : ℕ) :
    activeModelScaleTruncation α 2 u c F N =
      ModelScaleTruncation α u c F N := by
  unfold activeModelScaleTruncation ModelScaleTruncation
  apply integral_congr_ae
  filter_upwards [] with t
  congr 1
  unfold ModelSpatialProfile
  apply integral_congr_ae
  filter_upwards [] with x
  exact activeModelSpatialIntegrand_two α u F t x

/-- At active coordinate three, the arbitrary-coordinate full form is the
canonical full model form. -/
theorem activeModelFullForm_two
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ)
    (F : ModelSchwartzInput) :
    activeModelFullForm α 2 u c F = ModelFullForm α u c F := by
  unfold activeModelFullForm ModelFullForm
  apply integral_congr_ae
  filter_upwards [] with t
  congr 1
  unfold ModelSpatialProfile
  apply integral_congr_ae
  filter_upwards [] with x
  exact activeModelSpatialIntegrand_two α u F t x

/-- The inverse coordinate relabeling has the expected coordinate formula. -/
@[simp] theorem coordinatePermutation_symm_apply
    (σ : Equiv.Perm (Fin 3)) (x : E3) (i : Fin 3) :
    (coordinatePermutation σ).symm x i = x (σ.symm i) := by
  have h := congrArg (fun y : E3 ↦ y (σ.symm i))
    ((coordinatePermutation σ).apply_symm_apply x)
  simpa only [coordinatePermutation_apply, Equiv.apply_symm_apply] using h

/-- Pulling a shifted coordinate line back through the coordinate relabeling
gives the corresponding shifted line in the original coordinate. -/
theorem coordinatePermutation_symm_sub_smul_coordinateDirection
    (σ : Equiv.Perm (Fin 3)) (j : Fin 3) (x : E3) (r : ℝ) :
    (coordinatePermutation σ).symm
      (coordinatePermutation σ x - r • Anisotropy.coordinateDirection j) =
        x - r • Anisotropy.coordinateDirection (σ j) := by
  rw [map_sub, map_smul, (coordinatePermutation σ).symm_apply_apply]
  congr 1
  ext k
  simp [coordinatePermutation_symm_apply, coordinateDirection_apply,
    Equiv.symm_apply_eq]

/-- The forward relabeling sends the original `σ j` coordinate line to the
new `j` coordinate line. -/
theorem coordinatePermutation_coordinateDirection
    (σ : Equiv.Perm (Fin 3)) (j : Fin 3) :
    coordinatePermutation σ (Anisotropy.coordinateDirection (σ j)) =
      Anisotropy.coordinateDirection j := by
  have hsymm : (coordinatePermutation σ).symm
      (Anisotropy.coordinateDirection j) =
        Anisotropy.coordinateDirection (σ j) := by
    ext k
    simp [coordinatePermutation_symm_apply, coordinateDirection_apply,
      Equiv.symm_apply_eq]
  rw [← hsymm, (coordinatePermutation σ).apply_symm_apply]

/-- The forward coordinate change carries the original `σ j` fiber shift to
the standard `j` fiber shift. -/
theorem coordinatePermutation_sub_smul_coordinateDirection
    (σ : Equiv.Perm (Fin 3)) (j : Fin 3) (x : E3) (r : ℝ) :
    coordinatePermutation σ
      (x - r • Anisotropy.coordinateDirection (σ j)) =
        coordinatePermutation σ x - r • Anisotropy.coordinateDirection j := by
  rw [map_sub, map_smul,
    coordinatePermutation_coordinateDirection]

/-- A literal one-coordinate convolution commutes with relabeling its
spatial coordinate.  The kernel and its scale parameter remain unchanged. -/
theorem ModelCoordinateConvolution_coordinatePermutation
    (σ : Equiv.Perm (Fin 3)) (j : Fin 3)
    (f : E3 → ℝ) (k : ℝ → ℝ) (s : ℝ) (x : E3) :
    ModelCoordinateConvolution j (coordinatePullback σ f) k s
      (coordinatePermutation σ x) =
        ModelCoordinateConvolution (σ j) f k s x := by
  unfold ModelCoordinateConvolution
  apply integral_congr_ae
  filter_upwards [] with r
  rw [coordinatePullback_apply,
    coordinatePermutation_symm_sub_smul_coordinateDirection]

/-- The active kernel itself transports correctly when `σ 2` is the active
source coordinate. -/
theorem activeModelKernel_coordinatePermutation
    (σ : Equiv.Perm (Fin 3)) (i : Fin 3) (u : E3)
    (hσ : σ 2 = i) (j : Fin 3) :
    activeModelKernel 2 j (coordinatePermutation σ u) =
      activeModelKernel i (σ j) u := by
  by_cases hj : j = 2
  · subst j
    simp [activeModelKernel, hσ]
  · have hσj : σ j ≠ i := by
      intro h
      apply hj
      apply σ.injective
      simpa [hσ] using h
    simp [activeModelKernel, hj, hσj]

/-- Each relabeled convolved input is literally the pullback of the input
whose index was transported by the spatial permutation. -/
theorem permutedModelInput_succ_asFun
    (σ : Equiv.Perm (Fin 3)) (F : ModelSchwartzInput) (j : Fin 3) :
    (permutedModelInput σ F j.succ : E3 → ℝ) =
      coordinatePullback σ (F (σ j).succ : E3 → ℝ) := by
  funext x
  simp [coordinatePullback]

/-- The distinguished outer input is unchanged after evaluating the
relabeled tuple at the correspondingly relabeled point. -/
theorem permutedModelInput_zero_coordinatePermutation
    (σ : Equiv.Perm (Fin 3)) (F : ModelSchwartzInput) (x : E3) :
    permutedModelInput σ F 0 (coordinatePermutation σ x) = F 0 x := by
  rw [permutedModelInput_apply]
  simp

/-- One convolved factor of the active-third model after relabeling is the
factor in the corresponding original spatial coordinate. -/
theorem activeModelCoordinateFactor_permute_to_two
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (F : ModelSchwartzInput) (hσ : σ 2 = i)
    (t : ℝ) (x : E3) (j : Fin 3) :
    ModelCoordinateConvolution j (permutedModelInput σ F j.succ)
        (activeModelKernel 2 j (coordinatePermutation σ u))
        (t ^ (permutedAnisotropy α σ).weight j)
        (coordinatePermutation σ x) =
      ModelCoordinateConvolution (σ j) (F (σ j).succ)
        (activeModelKernel i (σ j) u)
        (t ^ α.weight (σ j)) x := by
  rw [permutedModelInput_succ_asFun,
    activeModelKernel_coordinatePermutation σ i u hσ j,
    permutedAnisotropy_weight]
  exact ModelCoordinateConvolution_coordinatePermutation σ j
    (F (σ j).succ) (activeModelKernel i (σ j) u)
    (t ^ α.weight (σ j)) x

/-- The arbitrary-active-coordinate spatial integrand becomes the
active-third-coordinate integrand after permuting all three spatial labels. -/
theorem activeModelSpatialIntegrand_permute_to_two
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (F : ModelSchwartzInput) (hσ : σ 2 = i)
    (t : ℝ) (x : E3) :
    activeModelSpatialIntegrand α i u F t x =
      activeModelSpatialIntegrand (permutedAnisotropy α σ) 2
        (coordinatePermutation σ u) (permutedModelInput σ F)
        t (coordinatePermutation σ x) := by
  unfold activeModelSpatialIntegrand
  rw [permutedModelInput_zero_coordinatePermutation]
  have hprod :
      (∏ j : Fin 3,
        ModelCoordinateConvolution j (permutedModelInput σ F j.succ)
          (activeModelKernel 2 j (coordinatePermutation σ u))
          (t ^ (permutedAnisotropy α σ).weight j)
          (coordinatePermutation σ x)) =
        ∏ k : Fin 3,
          ModelCoordinateConvolution k (F k.succ)
            (activeModelKernel i k u) (t ^ α.weight k) x := by
    calc
      (∏ j : Fin 3,
        ModelCoordinateConvolution j (permutedModelInput σ F j.succ)
          (activeModelKernel 2 j (coordinatePermutation σ u))
          (t ^ (permutedAnisotropy α σ).weight j)
          (coordinatePermutation σ x)) =
          ∏ j : Fin 3,
            ModelCoordinateConvolution (σ j) (F (σ j).succ)
              (activeModelKernel i (σ j) u)
              (t ^ α.weight (σ j)) x := by
            apply Finset.prod_congr rfl
            intro j _
            exact activeModelCoordinateFactor_permute_to_two α σ i u F
              hσ t x j
      _ = ∏ k : Fin 3,
          ModelCoordinateConvolution k (F k.succ)
            (activeModelKernel i k u) (t ^ α.weight k) x :=
        by
          simpa using (Equiv.prod_comp σ (fun k : Fin 3 ↦
            ModelCoordinateConvolution k (F k.succ)
              (activeModelKernel i k u) (t ^ α.weight k) x))
  rw [hprod]

/-- The inverse coordinate map is also Lebesgue-measure preserving. -/
theorem coordinatePermutation_symm_measurePreserving
    (σ : Equiv.Perm (Fin 3)) :
    MeasurePreserving (coordinatePermutation σ).symm volume volume := by
  have hmp : MeasurePreserving (coordinatePermutation σ).toMeasurableEquiv
      volume volume := by
    simpa using coordinatePermutation_measurePreserving σ
  simpa using MeasurePreserving.symm
    (coordinatePermutation σ).toMeasurableEquiv hmp

/-- Pullback along a coordinate permutation preserves all finite or
infinite `L^p` membership statements. -/
theorem memLp_coordinatePullback
    (σ : Equiv.Perm (Fin 3)) (f : E3 → ℝ) (p : ℝ≥0∞)
    (hf : MemLp f p volume) :
    MemLp (coordinatePullback σ f) p volume := by
  change MemLp (f ∘ (coordinatePermutation σ).symm) p volume
  exact hf.comp_measurePreserving
    (coordinatePermutation_symm_measurePreserving σ)

/-- The `L^p` seminorm of a measurable function is unchanged by coordinate
pullback.  This is the norm-preservation interface for the permutation
argument. -/
theorem eLpNorm_coordinatePullback
    (σ : Equiv.Perm (Fin 3)) (f : E3 → ℝ) (p : ℝ≥0∞)
    (hf : AEStronglyMeasurable f volume) :
    eLpNorm (coordinatePullback σ f) p volume =
      eLpNorm f p volume := by
  change eLpNorm (f ∘ (coordinatePermutation σ).symm) p volume =
    eLpNorm f p volume
  exact eLpNorm_comp_measurePreserving hf
    (coordinatePermutation_symm_measurePreserving σ)

/-- Componentwise `L^p` membership is preserved by the relabeled Schwartz
tuple. -/
theorem memLp_permutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelSchwartzInput)
    (j : Fin 4) (p : ℝ≥0∞)
    (hF : MemLp (F (modelInputIndex σ j) : E3 → ℝ) p volume) :
    MemLp (permutedModelInput σ F j : E3 → ℝ) p volume := by
  rw [show (permutedModelInput σ F j : E3 → ℝ) =
    coordinatePullback σ (F (modelInputIndex σ j) : E3 → ℝ) by
      funext x
      exact permutedModelInput_apply σ F j x]
  exact memLp_coordinatePullback σ _ p hF

/-- Componentwise `L^p` seminorms of the relabeled Schwartz tuple agree
with the seminorms of the corresponding original components. -/
theorem eLpNorm_permutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelSchwartzInput)
    (j : Fin 4) (p : ℝ≥0∞) :
    eLpNorm (permutedModelInput σ F j : E3 → ℝ) p volume =
      eLpNorm (F (modelInputIndex σ j) : E3 → ℝ) p volume := by
  rw [show (permutedModelInput σ F j : E3 → ℝ) =
    coordinatePullback σ (F (modelInputIndex σ j) : E3 → ℝ) by
      funext x
      exact permutedModelInput_apply σ F j x]
  exact eLpNorm_coordinatePullback σ _ p
    (F (modelInputIndex σ j)).continuous.aestronglyMeasurable

/-- The spatial integral in an arbitrary active coordinate is transported
to the active-third spatial integral by the measure-preserving relabeling. -/
theorem activeModelSpatialProfile_permute_to_two
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (F : ModelSchwartzInput) (hσ : σ 2 = i)
    (t : ℝ) :
    (∫ x : E3, activeModelSpatialIntegrand α i u F t x) =
      ∫ y : E3,
        activeModelSpatialIntegrand (permutedAnisotropy α σ) 2
          (coordinatePermutation σ u) (permutedModelInput σ F) t y := by
  calc
    (∫ x : E3, activeModelSpatialIntegrand α i u F t x) =
        ∫ x : E3,
          activeModelSpatialIntegrand (permutedAnisotropy α σ) 2
            (coordinatePermutation σ u) (permutedModelInput σ F)
            t (coordinatePermutation σ x) := by
          apply integral_congr_ae
          filter_upwards [] with x
          exact activeModelSpatialIntegrand_permute_to_two α σ i u F
            hσ t x
    _ = ∫ y : E3,
        activeModelSpatialIntegrand (permutedAnisotropy α σ) 2
          (coordinatePermutation σ u) (permutedModelInput σ F) t y :=
      by
        have hmp : MeasurePreserving (coordinatePermutation σ).toMeasurableEquiv
            volume volume := by
          simpa using coordinatePermutation_measurePreserving σ
        simpa using hmp.integral_comp'
          (activeModelSpatialIntegrand (permutedAnisotropy α σ) 2
            (coordinatePermutation σ u) (permutedModelInput σ F) t)

/-- Finite scale truncations transport exactly to the canonical
active-third-coordinate model form under a permutation sending coordinate
three to the desired active coordinate. -/
theorem activeModelScaleTruncation_permute_to_third
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput) (N : ℕ)
    (hσ : σ 2 = i) :
    activeModelScaleTruncation α i u c F N =
      ModelScaleTruncation (permutedAnisotropy α σ)
        (coordinatePermutation σ u) c (permutedModelInput σ F) N := by
  rw [← activeModelScaleTruncation_two
    (permutedAnisotropy α σ) (coordinatePermutation σ u) c
    (permutedModelInput σ F) N]
  unfold activeModelScaleTruncation
  apply integral_congr_ae
  filter_upwards [] with t
  congr 1
  exact activeModelSpatialProfile_permute_to_two α σ i u F hσ t

/-- The full-scale arbitrary-coordinate model form transports exactly to the
canonical active-third form. -/
theorem activeModelFullForm_permute_to_third
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (hσ : σ 2 = i) :
    activeModelFullForm α i u c F =
      ModelFullForm (permutedAnisotropy α σ)
        (coordinatePermutation σ u) c (permutedModelInput σ F) := by
  rw [← activeModelFullForm_two
    (permutedAnisotropy α σ) (coordinatePermutation σ u) c
    (permutedModelInput σ F)]
  unfold activeModelFullForm
  apply integral_congr_ae
  filter_upwards [] with t
  congr 1
  exact activeModelSpatialProfile_permute_to_two α σ i u F hσ t

/-- A permutation sending the canonical active-third coordinate to any
specified active coordinate is always available. -/
theorem exists_coordinatePermutation_to_active
    (i : Fin 3) : ∃ σ : Equiv.Perm (Fin 3), σ 2 = i := by
  refine ⟨Equiv.swap 2 i, ?_⟩
  simp

/-! ### Blueprint-normalized initial-range weight -/

/-- The strict real initial range can be stated with the blueprint's larger
translation weight exponent. -/
theorem initialModelFullForm_bound_weight100
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : InitialModelSchwartzInput)
    (q : Fin 4 → ℝ)
    (hq : ∀ j : Fin 4, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j : Fin 4, sourceStoppingExponent j < q j)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1) :
    ∃ C : ℝ, 0 ≤ C ∧
      |ModelFullForm α u c F| ≤ C * sourceWeight u ^ 100 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
  obtain ⟨C, hC, hbound⟩ :=
    initialModelFullForm_bound α u c F q hq hsum hqs hcmeas hc
  refine ⟨C, hC, hbound.trans ?_⟩
  have hweight : 1 ≤ sourceWeight u := by
    unfold sourceWeight
    linarith [abs_nonneg (u 0), abs_nonneg (u 1), abs_nonneg (u 2)]
  have hpow : sourceWeight u ^ 75 ≤ sourceWeight u ^ 100 :=
    pow_le_pow_right₀ hweight (by norm_num)
  have hprod : 0 ≤ ∏ j : Fin 4,
      lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
    exact Finset.prod_nonneg fun j _ ↦ lpNorm_nonneg
  calc
    C * sourceWeight u ^ 75 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume =
        (C * ∏ j : Fin 4,
          lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume) *
          sourceWeight u ^ 75 := by ring
    _ ≤ (C * ∏ j : Fin 4,
          lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume) *
          sourceWeight u ^ 100 :=
      mul_le_mul_of_nonneg_left hpow (mul_nonneg hC hprod)
    _ = C * sourceWeight u ^ 100 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
      ring

/-- The three input slots of the fixed truncated model operator.  This is the
operator `U^{a,b}_{u,c}` from Section 8 before pairing with the zeroth input.
-/
abbrev ModelOperatorRealInput := Fin 3 → E3 → ℝ

/-- Drop the zeroth (dual) slot from the four Schwartz inputs of the model
form, preserving the source order `1,2,3`. -/
noncomputable def modelOperatorInput (F : ModelSchwartzInput) :
    ModelOperatorRealInput :=
  fun j ↦ F j.succ

@[simp]
theorem modelOperatorInput_apply (F : ModelSchwartzInput) (j : Fin 3) (x : E3) :
    modelOperatorInput F j x = F j.succ x := rfl

/-- The pointwise integrand of the real fixed truncated model operator. -/
noncomputable def modelTruncatedOperatorIntegrand
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelOperatorRealInput)
    (t : ℝ) (x : E3) : ℝ :=
  c t *
    ModelCoordinateConvolution 0 (f 0) (ModelLowKernel (u 0))
      (t ^ α.weight 0) x *
    ModelCoordinateConvolution 1 (f 1) (ModelLowKernel (u 1))
      (t ^ α.weight 1) x *
    ModelCoordinateConvolution 2 (f 2) (ModelThirdKernel (u 2))
      (t ^ α.weight 2) x

/-- The actual real fixed truncated trilinear operator of Section 8.  Its
scale measure is exactly the source measure `1_{t>0} dt/t`. -/
noncomputable def ModelTruncatedOperator
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelOperatorRealInput)
    (a b : ℝ) (x : E3) : ℝ :=
  ∫ t in Set.Ioc a b, modelTruncatedOperatorIntegrand α u c f t x
    ∂((volume : Measure ℝ).withDensity cubeScaleDensity)

@[simp]
theorem modelTruncatedOperatorIntegrand_of_modelOperatorInput
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (t : ℝ) (x : E3) :
    modelTruncatedOperatorIntegrand α u c (modelOperatorInput F) t x =
      c t *
        ModelCoordinateConvolution 0 (F 1) (ModelLowKernel (u 0))
          (t ^ α.weight 0) x *
        ModelCoordinateConvolution 1 (F 2) (ModelLowKernel (u 1))
          (t ^ α.weight 1) x *
        ModelCoordinateConvolution 2 (F 3) (ModelThirdKernel (u 2))
          (t ^ α.weight 2) x := by
  rfl

/-- The four-linear product behind the scale-truncated form, arranged with
space first and scale second for Fubini. -/
noncomputable def modelTruncatedOperatorPairingIntegrand
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (t : ℝ) (x : E3) : ℝ :=
  F 0 x * modelTruncatedOperatorIntegrand α u c (modelOperatorInput F) t x

@[simp]
theorem modelTruncatedOperatorPairingIntegrand_eq_modelSpatialIntegrand
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (t : ℝ) (x : E3) :
    modelTruncatedOperatorPairingIntegrand α u c F t x =
      c t * ModelSpatialIntegrand α u F t x := by
  unfold modelTruncatedOperatorPairingIntegrand ModelSpatialIntegrand
    modelTruncatedOperatorIntegrand modelOperatorInput
  norm_num
  have hthree : Fin.succ (2 : Fin 3) = (3 : Fin 4) := by decide
  rw [hthree]
  ring

/-- Fubini identifies the pre-existing finite scale form with pairing the
fixed truncated operator against its zeroth input.  The explicit joint
integrability premise is precisely the finite-interval Young/Hölder
obligation discharged before the one-fiber Calderón--Zygmund argument. -/
theorem modelScaleIntervalTruncation_eq_modelTruncatedOperator_pairing
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (a b : ℝ)
    (hjoint : Integrable (fun xt : E3 × ℝ ↦
      modelTruncatedOperatorPairingIntegrand α u c F xt.2 xt.1)
      ((volume : Measure E3).prod
        (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
          (Set.Ioc a b)))) :
    ModelScaleIntervalTruncation α u c F a b =
      ∫ x : E3, F 0 x *
        ModelTruncatedOperator α u c (modelOperatorInput F) a b x := by
  let ν : Measure ℝ := (volume : Measure ℝ).withDensity cubeScaleDensity
  let I : Set ℝ := Set.Ioc a b
  let H : E3 × ℝ → ℝ := fun xt ↦
    modelTruncatedOperatorPairingIntegrand α u c F xt.2 xt.1
  have hH : Integrable H ((volume : Measure E3).prod (ν.restrict I)) := by
    simpa only [H, ν, I] using hjoint
  have hleft :
      ModelScaleIntervalTruncation α u c F a b =
        ∫ t : ℝ, ∫ x : E3, H (x, t) ∂volume ∂(ν.restrict I) := by
    unfold ModelScaleIntervalTruncation ModelSpatialProfile
    change (∫ t : ℝ in I, c t *
      (∫ x : E3, ModelSpatialIntegrand α u F t x) ∂ν) = _
    apply integral_congr_ae
    filter_upwards [] with t
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards [] with x
    change c t * ModelSpatialIntegrand α u F t x = H (x, t)
    dsimp only [H]
    exact (modelTruncatedOperatorPairingIntegrand_eq_modelSpatialIntegrand
      α u c F t x).symm
  have hright :
      (∫ x : E3, F 0 x *
        ModelTruncatedOperator α u c (modelOperatorInput F) a b x) =
        ∫ x : E3, ∫ t : ℝ, H (x, t) ∂(ν.restrict I) ∂volume := by
    apply integral_congr_ae
    filter_upwards [] with x
    unfold ModelTruncatedOperator
    change F 0 x * (∫ t : ℝ in I,
      modelTruncatedOperatorIntegrand α u c (modelOperatorInput F) t x ∂ν) = _
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards [] with t
    change F 0 x * modelTruncatedOperatorIntegrand α u c
      (modelOperatorInput F) t x = H (x, t)
    rfl
  calc
    ModelScaleIntervalTruncation α u c F a b =
        ∫ t : ℝ, ∫ x : E3, H (x, t) ∂volume ∂(ν.restrict I) := hleft
    _ = ∫ tx : ℝ × E3, H tx.swap ∂((ν.restrict I).prod volume) := by
      symm
      exact MeasureTheory.integral_prod (fun tx : ℝ × E3 ↦ H tx.swap) hH.swap
    _ = ∫ xt : E3 × ℝ, H xt ∂(volume.prod (ν.restrict I)) :=
      MeasureTheory.integral_prod_swap H
    _ = ∫ x : E3, ∫ t : ℝ, H (x, t) ∂(ν.restrict I) ∂volume :=
      MeasureTheory.integral_prod H hH
    _ = ∫ x : E3, F 0 x *
        ModelTruncatedOperator α u c (modelOperatorInput F) a b x := hright.symm

/-- A continuous scalar function is integrable on every positive finite scale
interval for the model's logarithmic scale measure. -/
theorem integrableOn_modelScaleInterval_of_continuous
    {a b : ℝ} (ha : 0 < a) (f : ℝ → ℝ) (hf : Continuous f) :
    IntegrableOn f (Set.Ioc a b)
      ((volume : Measure ℝ).withDensity cubeScaleDensity) := by
  have htop : ∀ᵐ t ∂(volume.restrict (Set.Ioc a b)), cubeScaleDensity t < ∞ := by
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    rw [cubeScaleDensity_eq_of_pos (lt_trans ha ht.1)]
    exact ENNReal.ofReal_lt_top
  unfold IntegrableOn
  rw [restrict_withDensity measurableSet_Ioc]
  rw [integrable_withDensity_iff measurable_cubeScaleDensity htop]
  have heq : (fun t : ℝ ↦ f t * (cubeScaleDensity t).toReal) =ᵐ[
      volume.restrict (Set.Ioc a b)] (fun t ↦ f t / t) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    rw [cubeScaleDensity_eq_of_pos (lt_trans ha ht.1),
      ENNReal.toReal_ofReal (inv_pos.mpr (lt_trans ha ht.1)).le]
    ring
  rw [integrable_congr heq]
  have hcont : ContinuousOn (fun t : ℝ ↦ f t / t) (Set.Icc a b) :=
    hf.continuousOn.div continuousOn_id
      (fun t ht ↦ ne_of_gt (lt_of_lt_of_le ha ht.1))
  exact (hcont.integrableOn_compact isCompact_Icc).mono_set Set.Ioc_subset_Icc_self

/-- The logarithmic scale measure of a positive finite interval is finite. -/
theorem isFiniteMeasure_modelScaleInterval
    {a b : ℝ} (ha : 0 < a) :
    IsFiniteMeasure (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
      (Set.Ioc a b)) := by
  apply (integrable_const_iff_isFiniteMeasure (by norm_num : (1 : ℝ) ≠ 0)).mp
  simpa only [IntegrableOn] using
    (integrableOn_modelScaleInterval_of_continuous ha (fun _ : ℝ ↦ (1 : ℝ))
      continuous_const)

/-- On a positive finite interval, the model scale measure is literally the
oriented interval integral with integrand divided by `t`. -/
theorem integral_modelScaleInterval_withDensity_eq_intervalIntegral
    {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) (f : ℝ → ℝ) :
    ∫ t in Set.Ioc a b, f t ∂((volume : Measure ℝ).withDensity cubeScaleDensity) =
      ∫ t in a..b, f t / t := by
  have htop : ∀ᵐ t ∂(volume.restrict (Set.Ioc a b)), cubeScaleDensity t < ∞ := by
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    rw [cubeScaleDensity_eq_of_pos (lt_trans ha ht.1)]
    exact ENNReal.ofReal_lt_top
  rw [setIntegral_withDensity_eq_setIntegral_toReal_smul
    measurable_cubeScaleDensity htop f measurableSet_Ioc]
  have hpoint : ∀ t ∈ Set.Ioc a b,
      (cubeScaleDensity t).toReal * f t = f t / t := by
    intro t ht
    rw [cubeScaleDensity_eq_of_pos (lt_trans ha ht.1),
      ENNReal.toReal_ofReal (inv_pos.mpr (lt_trans ha ht.1)).le]
    ring
  calc
    ∫ t in Set.Ioc a b, (cubeScaleDensity t).toReal • f t =
        ∫ t in Set.Ioc a b, f t / t := by
      apply setIntegral_congr_fun measurableSet_Ioc
      intro t ht
      change (cubeScaleDensity t).toReal * f t = f t / t
      exact hpoint t ht
    _ = ∫ t in a..b, f t / t :=
      (intervalIntegral.integral_of_le hab).symm

/-- The elementary `L^∞` Young estimate on one coordinate fiber.  It is the
finite-scale boundedness input used before the density and good--bad
identities in Section 8. -/
theorem abs_ModelCoordinateConvolution_le_of_bounded
    (i : Fin 3) (f : E3 → ℝ) (k : ℝ → ℝ) (s : ℝ) (x : E3)
    (hf : Continuous f) (B : ℝ)
    (hfB : ∀ y : E3, |f y| ≤ B) (hk : Integrable k) (hs : 0 < s) :
    |ModelCoordinateConvolution i f k s x| ≤
      B * ∫ r : ℝ, |k r| := by
  let kd : ℝ → ℝ := fun r ↦ kernelDilate k s r
  let G : ℝ → ℝ := fun r ↦
    f (x - r • Anisotropy.coordinateDirection i) * kd r
  have hkd : Integrable kd := by
    dsimp only [kd]
    exact integrable_kernelDilate hk hs.ne'
  have hmap : Continuous (fun r : ℝ ↦
      x - r • Anisotropy.coordinateDirection i) :=
    continuous_const.sub (continuous_id.smul continuous_const)
  have hGmeas : AEStronglyMeasurable G volume := by
    dsimp only [G]
    exact ((hf.comp hmap).aestronglyMeasurable).mul hkd.aestronglyMeasurable
  have hupper : Integrable (fun r : ℝ ↦ B * |kd r|) :=
    hkd.norm.const_mul B
  have hG : Integrable G := by
    apply hupper.mono' hGmeas
    filter_upwards [] with r
    dsimp only [G]
    rw [Real.norm_eq_abs, abs_mul]
    exact mul_le_mul_of_nonneg_right
      (hfB (x - r • Anisotropy.coordinateDirection i)) (abs_nonneg _)
  unfold ModelCoordinateConvolution
  change |∫ r : ℝ, G r| ≤ B * ∫ r : ℝ, |k r|
  calc
    |∫ r : ℝ, G r| ≤ ∫ r : ℝ, |G r| :=
      MeasureTheory.abs_integral_le_integral_abs
    _ ≤ ∫ r : ℝ, B * |kd r| := by
      apply integral_mono hG.norm hupper
      intro r
      dsimp only [G]
      rw [Real.norm_eq_abs, abs_mul]
      exact mul_le_mul_of_nonneg_right
        (hfB (x - r • Anisotropy.coordinateDirection i)) (abs_nonneg _)
    _ = B * ∫ r : ℝ, |kd r| := by
      rw [integral_const_mul]
    _ = B * ∫ r : ℝ, |k r| := by
      rw [integral_abs_kernelDilate k hs]

/-- At one positive scale, the fixed model-operator integrand is bounded by
the product of the three fiber `L^∞` Young bounds. -/
theorem abs_modelTruncatedOperatorIntegrand_le_of_bounded
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelOperatorRealInput)
    (t : ℝ) (x : E3) (ht : 0 < t) (C : ℝ) (B : Fin 3 → ℝ)
    (hC : 0 ≤ C) (hc : |c t| ≤ C)
    (hf : ∀ j, Continuous (f j)) (hB : ∀ j, 0 ≤ B j)
    (hfB : ∀ j, ∀ y : E3, |f j y| ≤ B j) :
    |modelTruncatedOperatorIntegrand α u c f t x| ≤
      C * (B 0 * ∫ r : ℝ, |ModelLowKernel (u 0) r|) *
        (B 1 * ∫ r : ℝ, |ModelLowKernel (u 1) r|) *
          (B 2 * ∫ r : ℝ, |ModelThirdKernel (u 2) r|) := by
  have hs0 : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs1 : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs2 : 0 < t ^ α.weight 2 := pow_pos ht _
  have h0 := abs_ModelCoordinateConvolution_le_of_bounded
    0 (f 0) (ModelLowKernel (u 0)) (t ^ α.weight 0) x
    (hf 0) (B 0) (hfB 0) (integrable_ModelLowKernel (u 0)) hs0
  have h1 := abs_ModelCoordinateConvolution_le_of_bounded
    1 (f 1) (ModelLowKernel (u 1)) (t ^ α.weight 1) x
    (hf 1) (B 1) (hfB 1) (integrable_ModelLowKernel (u 1)) hs1
  have h2 := abs_ModelCoordinateConvolution_le_of_bounded
    2 (f 2) (ModelThirdKernel (u 2)) (t ^ α.weight 2) x
    (hf 2) (B 2) (hfB 2) (integrable_ModelThirdKernel (u 2)) hs2
  have hM0 : 0 ≤ ∫ r : ℝ, |ModelLowKernel (u 0) r| :=
    integral_nonneg fun _ ↦ abs_nonneg _
  have hM1 : 0 ≤ ∫ r : ℝ, |ModelLowKernel (u 1) r| :=
    integral_nonneg fun _ ↦ abs_nonneg _
  have hM2 : 0 ≤ ∫ r : ℝ, |ModelThirdKernel (u 2) r| :=
    integral_nonneg fun _ ↦ abs_nonneg _
  have hD0 : 0 ≤ B 0 * ∫ r : ℝ, |ModelLowKernel (u 0) r| :=
    mul_nonneg (hB 0) hM0
  have hD1 : 0 ≤ B 1 * ∫ r : ℝ, |ModelLowKernel (u 1) r| :=
    mul_nonneg (hB 1) hM1
  have hD2 : 0 ≤ B 2 * ∫ r : ℝ, |ModelThirdKernel (u 2) r| :=
    mul_nonneg (hB 2) hM2
  have hCD0 : 0 ≤ C * (B 0 * ∫ r : ℝ, |ModelLowKernel (u 0) r|) :=
    mul_nonneg hC hD0
  have hCD01 : 0 ≤ C * (B 0 * ∫ r : ℝ, |ModelLowKernel (u 0) r|) *
      (B 1 * ∫ r : ℝ, |ModelLowKernel (u 1) r|) :=
    mul_nonneg hCD0 hD1
  unfold modelTruncatedOperatorIntegrand
  rw [abs_mul, abs_mul, abs_mul]
  gcongr

/-- The product of the three exact one-fiber Young constants at a fixed
parameter `u`. -/
noncomputable def modelTruncatedOperatorFiberBound (u : E3)
    (B : Fin 3 → ℝ) : ℝ :=
  (B 0 * ∫ r : ℝ, |ModelLowKernel (u 0) r|) *
    (B 1 * ∫ r : ℝ, |ModelLowKernel (u 1) r|) *
      (B 2 * ∫ r : ℝ, |ModelThirdKernel (u 2) r|)

/-- The fixed model-operator integrand is jointly strongly measurable in
scale and space for continuous inputs and a measurable coefficient. -/
theorem stronglyMeasurable_modelTruncatedOperatorIntegrand_joint
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelOperatorRealInput)
    (hc : Measurable c) (hf : ∀ j, Continuous (f j)) :
    StronglyMeasurable (fun tx : ℝ × E3 ↦
      modelTruncatedOperatorIntegrand α u c f tx.1 tx.2) := by
  have hc' : StronglyMeasurable (fun tx : ℝ × E3 ↦ c tx.1) :=
    (hc.comp measurable_fst).stronglyMeasurable
  have h0 : StronglyMeasurable (fun tx : ℝ × E3 ↦
      ModelCoordinateConvolution 0 (f 0) (ModelLowKernel (u 0))
        (tx.1 ^ α.weight 0) tx.2) :=
    stronglyMeasurable_modelCoordinateConvolution_joint
      0 (α.weight 0) (f 0) (ModelLowKernel (u 0))
      (hf 0).measurable (measurable_ModelLowKernel (u 0))
  have h1 : StronglyMeasurable (fun tx : ℝ × E3 ↦
      ModelCoordinateConvolution 1 (f 1) (ModelLowKernel (u 1))
        (tx.1 ^ α.weight 1) tx.2) :=
    stronglyMeasurable_modelCoordinateConvolution_joint
      1 (α.weight 1) (f 1) (ModelLowKernel (u 1))
      (hf 1).measurable (measurable_ModelLowKernel (u 1))
  have h2 : StronglyMeasurable (fun tx : ℝ × E3 ↦
      ModelCoordinateConvolution 2 (f 2) (ModelThirdKernel (u 2))
        (tx.1 ^ α.weight 2) tx.2) :=
    stronglyMeasurable_modelCoordinateConvolution_joint
      2 (α.weight 2) (f 2) (ModelThirdKernel (u 2))
      (hf 2).measurable (measurable_ModelThirdKernel (u 2))
  change StronglyMeasurable (fun tx : ℝ × E3 ↦
    c tx.1 *
      ModelCoordinateConvolution 0 (f 0) (ModelLowKernel (u 0))
        (tx.1 ^ α.weight 0) tx.2 *
      ModelCoordinateConvolution 1 (f 1) (ModelLowKernel (u 1))
        (tx.1 ^ α.weight 1) tx.2 *
      ModelCoordinateConvolution 2 (f 2) (ModelThirdKernel (u 2))
        (tx.1 ^ α.weight 2) tx.2)
  exact ((hc'.mul h0).mul h1).mul h2

/-- The real mass of a positive finite scale interval is its logarithmic
length. -/
theorem real_measure_modelScaleInterval
    {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    (((volume : Measure ℝ).withDensity cubeScaleDensity).real (Set.Ioc a b)) =
      Real.log (b / a) := by
  calc
    (((volume : Measure ℝ).withDensity cubeScaleDensity).real (Set.Ioc a b)) =
        ∫ _t in Set.Ioc a b, (1 : ℝ)
          ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
      simp
    _ = ∫ t in a..b, (1 : ℝ) / t :=
      integral_modelScaleInterval_withDensity_eq_intervalIntegral ha hab
        (fun _ : ℝ ↦ (1 : ℝ))
    _ = ∫ t in a..b, t⁻¹ := by
      apply intervalIntegral.integral_congr
      intro t _
      simp
    _ = Real.log (b / a) :=
      integral_inv_of_pos ha (lt_of_lt_of_le ha hab)

/-- The source's elementary finite-interval Young bound for the actual
truncated operator.  It is uniform in the coefficient except for its
`L^∞` bound and has the exact logarithmic interval length. -/
theorem abs_ModelTruncatedOperator_le_of_bounded
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelOperatorRealInput)
    (a b C : ℝ) (B : Fin 3 → ℝ) (x : E3)
    (ha : 0 < a) (hab : a ≤ b) (hC : 0 ≤ C)
    (hc : ∀ t : ℝ, |c t| ≤ C)
    (hf : ∀ j, Continuous (f j)) (hB : ∀ j, 0 ≤ B j)
    (hfB : ∀ j, ∀ y : E3, |f j y| ≤ B j) :
    |ModelTruncatedOperator α u c f a b x| ≤
      C * modelTruncatedOperatorFiberBound u B * Real.log (b / a) := by
  let ν : Measure ℝ := (volume : Measure ℝ).withDensity cubeScaleDensity
  let I : Set ℝ := Set.Ioc a b
  let Q : ℝ := C * modelTruncatedOperatorFiberBound u B
  have hfinite : ν I < ∞ := by
    letI : IsFiniteMeasure (ν.restrict I) := by
      simpa only [ν, I] using isFiniteMeasure_modelScaleInterval ha
    rw [← Measure.restrict_apply_univ]
    exact IsFiniteMeasure.measure_univ_lt_top
  have hpoint : ∀ t ∈ I,
      ‖modelTruncatedOperatorIntegrand α u c f t x‖ ≤ Q := by
    intro t ht
    have htpos : 0 < t := lt_trans ha ht.1
    rw [Real.norm_eq_abs]
    calc
      |modelTruncatedOperatorIntegrand α u c f t x| ≤
          C * (B 0 * ∫ r : ℝ, |ModelLowKernel (u 0) r|) *
            (B 1 * ∫ r : ℝ, |ModelLowKernel (u 1) r|) *
              (B 2 * ∫ r : ℝ, |ModelThirdKernel (u 2) r|) :=
        abs_modelTruncatedOperatorIntegrand_le_of_bounded
          α u c f t x htpos C B hC (hc t) hf hB hfB
      _ = Q := by
        dsimp only [Q, modelTruncatedOperatorFiberBound]
        ring
  change |∫ t in I, modelTruncatedOperatorIntegrand α u c f t x ∂ν| ≤
    C * modelTruncatedOperatorFiberBound u B * Real.log (b / a)
  calc
    |∫ t in I, modelTruncatedOperatorIntegrand α u c f t x ∂ν| =
        ‖∫ t in I, modelTruncatedOperatorIntegrand α u c f t x ∂ν‖ :=
      (Real.norm_eq_abs _).symm
    _ ≤ Q * ν.real I :=
      MeasureTheory.norm_setIntegral_le_of_norm_le_const hfinite hpoint
    _ = C * modelTruncatedOperatorFiberBound u B * Real.log (b / a) := by
      rw [show ν.real I = Real.log (b / a) by
        simpa only [ν, I] using real_measure_modelScaleInterval ha hab]

/-! ### Finite-`L^p` fiber Young inequality -/

theorem coordinate_ennreal_weighted_factor_of_holder
    {p r : ℝ} (hpq : r.HolderConjugate p) (a b : ENNReal) :
    a * b = a ^ r⁻¹ * (a * b ^ p) ^ p⁻¹ := by
  have hp0 : 0 < p := hpq.symm.pos
  have hbinv : (b ^ p) ^ p⁻¹ = b := by
    calc
      (b ^ p) ^ p⁻¹ = b ^ (p * p⁻¹) := (ENNReal.rpow_mul _ _ _).symm
      _ = b := by rw [mul_inv_cancel₀ hp0.ne', ENNReal.rpow_one]
  rw [ENNReal.mul_rpow_of_nonneg _ _ hpq.symm.inv_nonneg]
  rw [hbinv]
  calc
    a * b = a ^ (r⁻¹ + p⁻¹) * b := by
      rw [hpq.inv_add_inv_eq_one, ENNReal.rpow_one]
    _ = (a ^ r⁻¹ * a ^ p⁻¹) * b := by
      rw [ENNReal.rpow_add_of_nonneg _ _ hpq.inv_nonneg hpq.symm.inv_nonneg]
    _ = a ^ r⁻¹ * (a ^ p⁻¹ * b) := by ring

/-- The pointwise weighted Hölder step for convolution along one coordinate
fiber.  Unlike a full-space convolution, only the one-dimensional kernel
variable is integrated; translations in the ambient `E3` are retained
explicitly for the later Fubini step. -/
theorem coordinate_lintegral_p_pointwise
    {p r : ℝ} (hpq : r.HolderConjugate p) (i : Fin 3)
    (K : ℝ → ENNReal) (q : E3 → ENNReal)
    (hK : Measurable K) (hq : Measurable q) (x : E3) :
    (∫⁻ y : ℝ, K y * q (x - y • Anisotropy.coordinateDirection i)) ^ p ≤
      (∫⁻ y : ℝ, K y) ^ (p - 1) *
        ∫⁻ y : ℝ, K y * q (x - y • Anisotropy.coordinateDirection i) ^ p := by
  have hp0 : 0 < p := hpq.symm.pos
  have hr0 : 0 < r := hpq.pos
  let A : ℝ → ENNReal := fun y ↦ K y ^ r⁻¹
  let B : ℝ → ENNReal := fun y ↦
    (K y * q (x - y • Anisotropy.coordinateDirection i) ^ p) ^ p⁻¹
  have hqshift : Measurable (fun y : ℝ ↦
      q (x - y • Anisotropy.coordinateDirection i)) :=
    hq.comp (measurable_const.sub (measurable_id.smul measurable_const))
  have hA : AEMeasurable A volume :=
    (hK.pow measurable_const).aemeasurable
  have hB : AEMeasurable B volume :=
    ((hK.mul (hqshift.pow measurable_const)).pow measurable_const).aemeasurable
  have hholder := ENNReal.lintegral_mul_le_Lp_mul_Lq volume hpq hA hB
  have hleft : (∫⁻ y : ℝ, (A * B) y) =
      ∫⁻ y : ℝ, K y * q (x - y • Anisotropy.coordinateDirection i) := by
    apply lintegral_congr
    intro y
    simp only [A, B, Pi.mul_apply]
    exact (coordinate_ennreal_weighted_factor_of_holder hpq
      (K y) (q (x - y • Anisotropy.coordinateDirection i))).symm
  have hfirst : (∫⁻ y : ℝ, A y ^ r) = ∫⁻ y : ℝ, K y := by
    apply lintegral_congr
    intro y
    simp only [A]
    rw [← ENNReal.rpow_mul, inv_mul_cancel₀ hr0.ne', ENNReal.rpow_one]
  have hsecond : (∫⁻ y : ℝ, B y ^ p) =
      ∫⁻ y : ℝ, K y * q (x - y • Anisotropy.coordinateDirection i) ^ p := by
    apply lintegral_congr
    intro y
    simp only [B]
    rw [← ENNReal.rpow_mul, inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one]
  have hholder2 :
      (∫⁻ y : ℝ, K y * q (x - y • Anisotropy.coordinateDirection i)) ≤
        (∫⁻ y : ℝ, K y) ^ r⁻¹ *
          (∫⁻ y : ℝ, K y *
            q (x - y • Anisotropy.coordinateDirection i) ^ p) ^ p⁻¹ := by
    rw [hleft, hfirst, hsecond] at hholder
    simpa only [one_div] using hholder
  have hrp : r⁻¹ * p = p - 1 := by
    rw [← hpq.symm.one_sub_inv]
    field_simp [hp0.ne']
  have hpow := ENNReal.rpow_le_rpow hholder2 hp0.le
  calc
    (∫⁻ y : ℝ, K y * q (x - y • Anisotropy.coordinateDirection i)) ^ p ≤
        ((∫⁻ y : ℝ, K y) ^ r⁻¹ *
          (∫⁻ y : ℝ, K y *
            q (x - y • Anisotropy.coordinateDirection i) ^ p) ^ p⁻¹) ^ p := hpow
    _ = (∫⁻ y : ℝ, K y) ^ (p - 1) *
        ∫⁻ y : ℝ, K y * q (x - y • Anisotropy.coordinateDirection i) ^ p := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
      rw [← ENNReal.rpow_mul, ← ENNReal.rpow_mul, hrp,
        inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one]

/-- Young's inequality for the `p`-moment of a positive convolution along a
single coordinate fiber.  The ambient translation in the Tonelli step is
measure preserving, so the constant is the exact one-dimensional kernel
mass. -/
theorem coordinate_lintegral_p_young
    {p r : ℝ} (hpq : r.HolderConjugate p) (i : Fin 3)
    (K : ℝ → ENNReal) (q : E3 → ENNReal)
    (hK : Measurable K) (hq : Measurable q) :
    ∫⁻ x : E3,
        (∫⁻ y : ℝ, K y * q (x - y • Anisotropy.coordinateDirection i)) ^ p ≤
      (∫⁻ y : ℝ, K y) ^ p * ∫⁻ x : E3, q x ^ p := by
  have hp0 : 0 < p := hpq.symm.pos
  have hpone : 1 ≤ p := hpq.symm.lt.le
  let H : E3 × ℝ → ENNReal := fun z ↦
    K z.2 * q (z.1 - z.2 • Anisotropy.coordinateDirection i) ^ p
  have hH : Measurable H :=
    (hK.comp measurable_snd).mul
      ((hq.comp (measurable_fst.sub
        (measurable_snd.smul measurable_const))).pow measurable_const)
  have hinner : Measurable (fun x : E3 ↦
      ∫⁻ y : ℝ, K y * q (x - y • Anisotropy.coordinateDirection i) ^ p) :=
    hH.lintegral_prod_right
  have htranslate (y : ℝ) :
      (∫⁻ x : E3, q (x - y • Anisotropy.coordinateDirection i) ^ p) =
        ∫⁻ x : E3, q x ^ p :=
    (measurePreserving_sub_right (volume : Measure E3)
      (y • Anisotropy.coordinateDirection i)).lintegral_comp
      (hq.pow measurable_const)
  have hqshiftPow (y : ℝ) : Measurable (fun x : E3 ↦
      q (x - y • Anisotropy.coordinateDirection i) ^ p) :=
    (hq.comp (measurable_id.sub measurable_const)).pow measurable_const
  have hdouble :
      (∫⁻ x : E3, ∫⁻ y : ℝ,
        K y * q (x - y • Anisotropy.coordinateDirection i) ^ p) =
        (∫⁻ y : ℝ, K y) * ∫⁻ x : E3, q x ^ p := by
    calc
      (∫⁻ x : E3, ∫⁻ y : ℝ,
          K y * q (x - y • Anisotropy.coordinateDirection i) ^ p) =
          ∫⁻ y : ℝ, ∫⁻ x : E3,
            K y * q (x - y • Anisotropy.coordinateDirection i) ^ p :=
        lintegral_lintegral_swap hH.aemeasurable
      _ = ∫⁻ y : ℝ, K y *
          (∫⁻ x : E3, q (x - y • Anisotropy.coordinateDirection i) ^ p) := by
        apply lintegral_congr
        intro y
        simpa only [Function.comp_apply] using
          (lintegral_const_mul (K y) (hqshiftPow y))
      _ = ∫⁻ y : ℝ, K y * (∫⁻ x : E3, q x ^ p) := by
        apply lintegral_congr
        intro y
        rw [htranslate y]
      _ = (∫⁻ y : ℝ, K y) * ∫⁻ x : E3, q x ^ p :=
        lintegral_mul_const _ hK
  calc
    (∫⁻ x : E3,
        (∫⁻ y : ℝ, K y * q (x - y • Anisotropy.coordinateDirection i)) ^ p) ≤
        ∫⁻ x : E3, (∫⁻ y : ℝ, K y) ^ (p - 1) *
          (∫⁻ y : ℝ,
            K y * q (x - y • Anisotropy.coordinateDirection i) ^ p) := by
      apply lintegral_mono
      intro x
      exact coordinate_lintegral_p_pointwise hpq i K q hK hq x
    _ = (∫⁻ y : ℝ, K y) ^ (p - 1) *
        (∫⁻ x : E3, ∫⁻ y : ℝ,
          K y * q (x - y • Anisotropy.coordinateDirection i) ^ p) := by
      rw [lintegral_const_mul _ hinner]
    _ = (∫⁻ y : ℝ, K y) ^ (p - 1) *
        ((∫⁻ y : ℝ, K y) * ∫⁻ x : E3, q x ^ p) := by
      rw [hdouble]
    _ = (∫⁻ y : ℝ, K y) ^ p * ∫⁻ x : E3, q x ^ p := by
      calc
        (∫⁻ y : ℝ, K y) ^ (p - 1) *
            ((∫⁻ y : ℝ, K y) * ∫⁻ x : E3, q x ^ p) =
            ((∫⁻ y : ℝ, K y) ^ (p - 1) *
              (∫⁻ y : ℝ, K y) ^ (1 : ℝ)) *
              ∫⁻ x : E3, q x ^ p := by
          rw [ENNReal.rpow_one]
          ring
        _ = (∫⁻ y : ℝ, K y) ^ ((p - 1) + 1) *
              ∫⁻ x : E3, q x ^ p := by
          rw [← ENNReal.rpow_add_of_nonneg _ _ (sub_nonneg.mpr hpone)
            (by norm_num : (0 : ℝ) ≤ 1)]
        _ = (∫⁻ y : ℝ, K y) ^ p * ∫⁻ x : E3, q x ^ p := by
          congr 2
          ring

/-- The finite-`L^p` Young inequality for `ModelCoordinateConvolution`.
This is the literal fiberwise Young input invoked in Section 8 before
Hölder and scale integration. -/
theorem eLpNorm_ModelCoordinateConvolution_le
    (i : Fin 3) (p : ℝ) (hp : 1 < p) (f : E3 → ℝ) (k : ℝ → ℝ)
    (hf : Measurable f) (hk : Measurable k) (hkint : Integrable k)
    {s : ℝ} (hs : 0 < s) :
    eLpNorm (ModelCoordinateConvolution i f k s) (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal (∫ y : ℝ, |k y|) *
        eLpNorm f (ENNReal.ofReal p) volume := by
  have hp0 : 0 < p := lt_trans zero_lt_one hp
  have hpq : p.conjExponent.HolderConjugate p :=
    (Real.HolderConjugate.conjExponent hp).symm
  have hkd : Measurable (fun y : ℝ ↦ kernelDilate k s y) := by
    unfold kernelDilate
    change Measurable (fun y : ℝ ↦ s⁻¹ * k (y / s))
    exact measurable_const.mul
      (hk.comp (measurable_id.div measurable_const))
  have hpoint (x : E3) :
      ‖ModelCoordinateConvolution i f k s x‖ₑ ≤
        ∫⁻ y : ℝ, ‖kernelDilate k s y‖ₑ *
          ‖f (x - y • Anisotropy.coordinateDirection i)‖ₑ := by
    change ‖∫ y : ℝ,
      f (x - y • Anisotropy.coordinateDirection i) * kernelDilate k s y‖ₑ ≤ _
    calc
      ‖∫ y : ℝ,
          f (x - y • Anisotropy.coordinateDirection i) * kernelDilate k s y‖ₑ ≤
          ∫⁻ y : ℝ,
            ‖f (x - y • Anisotropy.coordinateDirection i) * kernelDilate k s y‖ₑ :=
        enorm_integral_le_lintegral_enorm _
      _ = ∫⁻ y : ℝ, ‖kernelDilate k s y‖ₑ *
          ‖f (x - y • Anisotropy.coordinateDirection i)‖ₑ := by
        apply lintegral_congr
        intro y
        rw [enorm_mul]
        ring
  have hmoment :
      (∫⁻ x : E3, ‖ModelCoordinateConvolution i f k s x‖ₑ ^ p) ≤
        (∫⁻ y : ℝ, ‖kernelDilate k s y‖ₑ) ^ p *
          ∫⁻ x : E3, ‖f x‖ₑ ^ p := by
    calc
      (∫⁻ x : E3, ‖ModelCoordinateConvolution i f k s x‖ₑ ^ p) ≤
          ∫⁻ x : E3,
            (∫⁻ y : ℝ, ‖kernelDilate k s y‖ₑ *
              ‖f (x - y • Anisotropy.coordinateDirection i)‖ₑ) ^ p := by
        apply lintegral_mono
        intro x
        exact ENNReal.rpow_le_rpow (hpoint x) (by positivity)
      _ ≤ (∫⁻ y : ℝ, ‖kernelDilate k s y‖ₑ) ^ p *
          ∫⁻ x : E3, ‖f x‖ₑ ^ p :=
        coordinate_lintegral_p_young hpq i
          (fun y ↦ ‖kernelDilate k s y‖ₑ) (fun x ↦ ‖f x‖ₑ)
          hkd.enorm hf.enorm
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top]
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top]
  simp only [ENNReal.toReal_ofReal hp0.le, one_div]
  have hstep := ENNReal.rpow_le_rpow hmoment
    (by positivity : (0 : ℝ) ≤ p⁻¹)
  calc
    (∫⁻ x : E3, ‖ModelCoordinateConvolution i f k s x‖ₑ ^ p) ^ p⁻¹ ≤
        ((∫⁻ y : ℝ, ‖kernelDilate k s y‖ₑ) ^ p *
          ∫⁻ x : E3, ‖f x‖ₑ ^ p) ^ p⁻¹ := hstep
    _ = (∫⁻ y : ℝ, ‖kernelDilate k s y‖ₑ) *
        (∫⁻ x : E3, ‖f x‖ₑ ^ p) ^ p⁻¹ := by
      rw [ENNReal.mul_rpow_of_nonneg _ _
        (by positivity : (0 : ℝ) ≤ p⁻¹)]
      congr 1
      rw [← ENNReal.rpow_mul, mul_inv_cancel₀ hp0.ne', ENNReal.rpow_one]
    _ = ENNReal.ofReal (∫ y : ℝ, |k y|) *
        (∫⁻ x : E3, ‖f x‖ₑ ^ p) ^ p⁻¹ := by
      have hkdint : Integrable (fun y : ℝ ↦ kernelDilate k s y) :=
        integrable_kernelDilate hkint hs.ne'
      rw [← ofReal_integral_norm_eq_lintegral_enorm hkdint]
      change ENNReal.ofReal (∫ y : ℝ, |kernelDilate k s y|) * _ = _
      rw [integral_abs_kernelDilate k hs]

/-- A Borel input and Borel kernel give a strongly measurable literal
coordinate convolution at every positive scale. -/
theorem stronglyMeasurable_ModelCoordinateConvolution_of_measurable
    (i : Fin 3) (f : E3 → ℝ) (k : ℝ → ℝ) (s : ℝ)
    (hf : Measurable f) (hk : Measurable k) :
    StronglyMeasurable (ModelCoordinateConvolution i f k s) := by
  have hinput : StronglyMeasurable (fun xr : E3 × ℝ ↦
      f (xr.1 - xr.2 • Anisotropy.coordinateDirection i)) :=
    (hf.comp (measurable_fst.sub
      (measurable_snd.smul measurable_const))).stronglyMeasurable
  have hkernel : StronglyMeasurable (fun xr : E3 × ℝ ↦
      kernelDilate k s xr.2) := by
    unfold kernelDilate
    change StronglyMeasurable (fun xr : E3 × ℝ ↦
      s⁻¹ * k (xr.2 / s))
    exact (measurable_const.mul
      (hk.comp (measurable_snd.div measurable_const))).stronglyMeasurable
  change StronglyMeasurable (fun x : E3 ↦
    ∫ r : ℝ, f (x - r • Anisotropy.coordinateDirection i) *
      kernelDilate k s r)
  exact (hinput.mul hkernel).integral_prod_right'

/-- The literal coordinate convolution maps Borel `L^p` inputs to `L^p` for
every finite exponent strictly above one. -/
theorem memLp_ModelCoordinateConvolution_of_memLp
    (i : Fin 3) (p : ℝ) (hp : 1 < p) (f : E3 → ℝ) (k : ℝ → ℝ)
    (hf : Measurable f) (hk : Measurable k) (hkint : Integrable k)
    {s : ℝ} (hs : 0 < s)
    (hfp : MemLp f (ENNReal.ofReal p) volume) :
    MemLp (ModelCoordinateConvolution i f k s) (ENNReal.ofReal p) volume := by
  refine ⟨(stronglyMeasurable_ModelCoordinateConvolution_of_measurable
    i f k s hf hk).aestronglyMeasurable, ?_⟩
  exact (eLpNorm_ModelCoordinateConvolution_le i p hp f k hf hk hkint hs).trans_lt
    (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hfp.eLpNorm_lt_top)

/-- A four-factor Hölder package in the association used by the fixed model
form.  The three `HolderTriple` assumptions make the intermediate output
exponents explicit, avoiding any hidden interpolation convention. -/
theorem eLpNorm_fourfold_product_le
    {p0 p1 p2 p3 r23 r123 : ENNReal}
    [ENNReal.HolderTriple p2 p3 r23] [ENNReal.HolderTriple p1 r23 r123]
    [ENNReal.HolderTriple p0 r123 1]
    (g0 g1 g2 g3 : E3 → ℝ)
    (hg0 : AEStronglyMeasurable g0 volume)
    (hg1 : AEStronglyMeasurable g1 volume)
    (hg2 : AEStronglyMeasurable g2 volume)
    (hg3 : AEStronglyMeasurable g3 volume) :
    eLpNorm (fun x ↦ g0 x * g1 x * g2 x * g3 x) 1 volume ≤
      eLpNorm g0 p0 volume * eLpNorm g1 p1 volume *
        eLpNorm g2 p2 volume * eLpNorm g3 p3 volume := by
  have h23 : eLpNorm (fun x ↦ g2 x * g3 x) r23 volume ≤
      eLpNorm g2 p2 volume * eLpNorm g3 p3 volume := by
    change eLpNorm (g2 * g3) r23 volume ≤ _
    simpa only [smul_eq_mul] using
      (eLpNorm_smul_le_mul_eLpNorm (μ := volume) hg3 hg2)
  have hm23 : AEStronglyMeasurable (fun x ↦ g2 x * g3 x) volume :=
    hg2.mul hg3
  have h123 : eLpNorm (fun x ↦ g1 x * (g2 x * g3 x)) r123 volume ≤
      eLpNorm g1 p1 volume *
        eLpNorm (fun x ↦ g2 x * g3 x) r23 volume := by
    change eLpNorm (g1 * fun x ↦ g2 x * g3 x) r123 volume ≤ _
    simpa only [smul_eq_mul] using
      (eLpNorm_smul_le_mul_eLpNorm (μ := volume) hm23 hg1)
  have hm123 : AEStronglyMeasurable (fun x ↦
      g1 x * (g2 x * g3 x)) volume := hg1.mul hm23
  have h0123 : eLpNorm (fun x ↦
      g0 x * (g1 x * (g2 x * g3 x))) 1 volume ≤
      eLpNorm g0 p0 volume *
        eLpNorm (fun x ↦ g1 x * (g2 x * g3 x)) r123 volume := by
    change eLpNorm (g0 * fun x ↦ g1 x * (g2 x * g3 x)) 1 volume ≤ _
    simpa only [smul_eq_mul] using
      (eLpNorm_smul_le_mul_eLpNorm (μ := volume) hm123 hg0)
  calc
    eLpNorm (fun x ↦ g0 x * g1 x * g2 x * g3 x) 1 volume =
        eLpNorm (fun x ↦ g0 x * (g1 x * (g2 x * g3 x))) 1 volume := by
      apply eLpNorm_congr_ae
      filter_upwards [] with x
      ring
    _ ≤ eLpNorm g0 p0 volume *
        eLpNorm (fun x ↦ g1 x * (g2 x * g3 x)) r123 volume := h0123
    _ ≤ eLpNorm g0 p0 volume *
        (eLpNorm g1 p1 volume *
          eLpNorm (fun x ↦ g2 x * g3 x) r23 volume) := by
      gcongr
    _ ≤ eLpNorm g0 p0 volume *
        (eLpNorm g1 p1 volume *
          (eLpNorm g2 p2 volume * eLpNorm g3 p3 volume)) := by
      gcongr
    _ = eLpNorm g0 p0 volume * eLpNorm g1 p1 volume *
        eLpNorm g2 p2 volume * eLpNorm g3 p3 volume := by
      ring

/-- The product of the three coordinate convolutions at one fixed scale,
before multiplication by the dual zeroth input or the scale coefficient. -/
noncomputable def modelFixedOperatorSpatialProduct
    (α : Anisotropy) (u : E3) (f : ModelRealInput) (t : ℝ) (x : E3) : ℝ :=
  ModelCoordinateConvolution 0 (f 1) (ModelLowKernel (u 0))
    (t ^ α.weight 0) x *
  ModelCoordinateConvolution 1 (f 2) (ModelLowKernel (u 1))
    (t ^ α.weight 1) x *
  ModelCoordinateConvolution 2 (f 3) (ModelThirdKernel (u 2))
    (t ^ α.weight 2) x

/-- The spatial integrand of the fixed-scale four-linear form, including the
dual zeroth input. -/
noncomputable def modelFixedOperatorFormIntegrand
    (α : Anisotropy) (u : E3) (f : ModelRealInput) (t : ℝ) (x : E3) : ℝ :=
  f 0 x *
  ModelCoordinateConvolution 0 (f 1) (ModelLowKernel (u 0))
    (t ^ α.weight 0) x *
  ModelCoordinateConvolution 1 (f 2) (ModelLowKernel (u 1))
    (t ^ α.weight 1) x *
  ModelCoordinateConvolution 2 (f 3) (ModelThirdKernel (u 2))
    (t ^ α.weight 2) x

/-- Fixed-scale Young followed by the three-stage Hölder product estimate.
This is the elementary spatial estimate that precedes Minkowski's finite
scale integration in the source proof. -/
theorem eLpNorm_modelFixedOperatorFormIntegrand_le
    (α : Anisotropy) (u : E3) (f : ModelRealInput) (t : ℝ) (ht : 0 < t)
    {p0 p1 p2 p3 r23 r123 : ℝ}
    (hp1 : 1 < p1) (hp2 : 1 < p2) (hp3 : 1 < p3)
    [ENNReal.HolderTriple (ENNReal.ofReal p2) (ENNReal.ofReal p3)
      (ENNReal.ofReal r23)]
    [ENNReal.HolderTriple (ENNReal.ofReal p1) (ENNReal.ofReal r23)
      (ENNReal.ofReal r123)]
    [ENNReal.HolderTriple (ENNReal.ofReal p0) (ENNReal.ofReal r123) 1]
    (hf : ∀ j, Measurable (f j)) :
    eLpNorm (modelFixedOperatorFormIntegrand α u f t) 1 volume ≤
      eLpNorm (f 0) (ENNReal.ofReal p0) volume *
        (ENNReal.ofReal (∫ y : ℝ, |ModelLowKernel (u 0) y|) *
          eLpNorm (f 1) (ENNReal.ofReal p1) volume) *
        (ENNReal.ofReal (∫ y : ℝ, |ModelLowKernel (u 1) y|) *
          eLpNorm (f 2) (ENNReal.ofReal p2) volume) *
        (ENNReal.ofReal (∫ y : ℝ, |ModelThirdKernel (u 2) y|) *
          eLpNorm (f 3) (ENNReal.ofReal p3) volume) := by
  have hs0 : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs1 : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs2 : 0 < t ^ α.weight 2 := pow_pos ht _
  have hm0 : AEStronglyMeasurable
      (ModelCoordinateConvolution 0 (f 1) (ModelLowKernel (u 0))
        (t ^ α.weight 0)) volume :=
    (stronglyMeasurable_ModelCoordinateConvolution_of_measurable
      0 (f 1) (ModelLowKernel (u 0)) (t ^ α.weight 0)
      (hf 1) (measurable_ModelLowKernel (u 0))).aestronglyMeasurable
  have hm1 : AEStronglyMeasurable
      (ModelCoordinateConvolution 1 (f 2) (ModelLowKernel (u 1))
        (t ^ α.weight 1)) volume :=
    (stronglyMeasurable_ModelCoordinateConvolution_of_measurable
      1 (f 2) (ModelLowKernel (u 1)) (t ^ α.weight 1)
      (hf 2) (measurable_ModelLowKernel (u 1))).aestronglyMeasurable
  have hm2 : AEStronglyMeasurable
      (ModelCoordinateConvolution 2 (f 3) (ModelThirdKernel (u 2))
        (t ^ α.weight 2)) volume :=
    (stronglyMeasurable_ModelCoordinateConvolution_of_measurable
      2 (f 3) (ModelThirdKernel (u 2)) (t ^ α.weight 2)
      (hf 3) (measurable_ModelThirdKernel (u 2))).aestronglyMeasurable
  have hY0 := eLpNorm_ModelCoordinateConvolution_le
    0 p1 hp1
    (f 1) (ModelLowKernel (u 0)) (hf 1)
    (measurable_ModelLowKernel (u 0)) (integrable_ModelLowKernel (u 0)) hs0
  have hY1 := eLpNorm_ModelCoordinateConvolution_le
    1 p2 hp2
    (f 2) (ModelLowKernel (u 1)) (hf 2)
    (measurable_ModelLowKernel (u 1)) (integrable_ModelLowKernel (u 1)) hs1
  have hY2 := eLpNorm_ModelCoordinateConvolution_le
    2 p3 hp3
    (f 3) (ModelThirdKernel (u 2)) (hf 3)
    (measurable_ModelThirdKernel (u 2)) (integrable_ModelThirdKernel (u 2)) hs2
  have hholder := eLpNorm_fourfold_product_le
    (p0 := ENNReal.ofReal p0) (p1 := ENNReal.ofReal p1)
    (p2 := ENNReal.ofReal p2) (p3 := ENNReal.ofReal p3)
    (r23 := ENNReal.ofReal r23) (r123 := ENNReal.ofReal r123)
    (f 0)
    (ModelCoordinateConvolution 0 (f 1) (ModelLowKernel (u 0))
      (t ^ α.weight 0))
    (ModelCoordinateConvolution 1 (f 2) (ModelLowKernel (u 1))
      (t ^ α.weight 1))
    (ModelCoordinateConvolution 2 (f 3) (ModelThirdKernel (u 2))
      (t ^ α.weight 2))
    (hf 0).aestronglyMeasurable hm0 hm1 hm2
  change eLpNorm (fun x ↦ f 0 x *
    ModelCoordinateConvolution 0 (f 1) (ModelLowKernel (u 0))
      (t ^ α.weight 0) x *
    ModelCoordinateConvolution 1 (f 2) (ModelLowKernel (u 1))
      (t ^ α.weight 1) x *
    ModelCoordinateConvolution 2 (f 3) (ModelThirdKernel (u 2))
      (t ^ α.weight 2) x) 1 volume ≤ _
  calc
    eLpNorm (fun x ↦ f 0 x *
      ModelCoordinateConvolution 0 (f 1) (ModelLowKernel (u 0))
        (t ^ α.weight 0) x *
      ModelCoordinateConvolution 1 (f 2) (ModelLowKernel (u 1))
        (t ^ α.weight 1) x *
      ModelCoordinateConvolution 2 (f 3) (ModelThirdKernel (u 2))
        (t ^ α.weight 2) x) 1 volume ≤
        eLpNorm (f 0) (ENNReal.ofReal p0) volume *
          eLpNorm (ModelCoordinateConvolution 0 (f 1) (ModelLowKernel (u 0))
            (t ^ α.weight 0)) (ENNReal.ofReal p1) volume *
          eLpNorm (ModelCoordinateConvolution 1 (f 2) (ModelLowKernel (u 1))
            (t ^ α.weight 1)) (ENNReal.ofReal p2) volume *
          eLpNorm (ModelCoordinateConvolution 2 (f 3) (ModelThirdKernel (u 2))
            (t ^ α.weight 2)) (ENNReal.ofReal p3) volume := hholder
    _ ≤ eLpNorm (f 0) (ENNReal.ofReal p0) volume *
        (ENNReal.ofReal (∫ y : ℝ, |ModelLowKernel (u 0) y|) *
          eLpNorm (f 1) (ENNReal.ofReal p1) volume) *
        (ENNReal.ofReal (∫ y : ℝ, |ModelLowKernel (u 1) y|) *
          eLpNorm (f 2) (ENNReal.ofReal p2) volume) *
        (ENNReal.ofReal (∫ y : ℝ, |ModelThirdKernel (u 2) y|) *
          eLpNorm (f 3) (ENNReal.ofReal p3) volume) := by
      gcongr

/-! ## Section 9 active-coordinate strict model range -/

/-- Relabel the four exponents by the same permutation that relabels the
three convolved model inputs, while fixing the outer input. -/
def permutedModelExponent
    (σ : Equiv.Perm (Fin 3)) (q : Fin 4 → ℝ) : Fin 4 → ℝ :=
  fun j ↦ q (modelInputIndex σ j)

@[simp] theorem permutedModelExponent_apply
    (σ : Equiv.Perm (Fin 3)) (q : Fin 4 → ℝ) (j : Fin 4) :
    permutedModelExponent σ q j = q (modelInputIndex σ j) := rfl

/-- The stopping threshold for the model in which the annular kernel is
active at spatial coordinate `i`: fourth powers except for the active
convolved input, which uses a second power. -/
def activeSourceStoppingExponent
    (i : Fin 3) : Fin 4 → ℝ :=
  Fin.cases 4 (fun j ↦ if j = i then 2 else 4)

@[simp] theorem activeSourceStoppingExponent_zero
    (i : Fin 3) : activeSourceStoppingExponent i 0 = 4 := rfl

@[simp] theorem activeSourceStoppingExponent_succ
    (i j : Fin 3) :
    activeSourceStoppingExponent i j.succ =
      if j = i then 2 else 4 := rfl

/-- Reindexing a four-term sum by `modelInputIndex` is harmless. -/
theorem sum_modelInputIndex
    (σ : Equiv.Perm (Fin 3)) (g : Fin 4 → ℝ) :
    (∑ j : Fin 4, g (modelInputIndex σ j)) = ∑ j : Fin 4, g j := by
  conv_lhs => rw [Fin.sum_univ_succ]
  conv_rhs => rw [Fin.sum_univ_succ]
  simp only [modelInputIndex_zero, modelInputIndex_succ]
  rw [Equiv.sum_comp σ (fun j : Fin 3 ↦ g j.succ)]

/-- Reindexing a four-term product by `modelInputIndex` is harmless. -/
theorem prod_modelInputIndex
    (σ : Equiv.Perm (Fin 3)) (g : Fin 4 → ℝ) :
    (∏ j : Fin 4, g (modelInputIndex σ j)) = ∏ j : Fin 4, g j := by
  conv_lhs => rw [Fin.prod_univ_succ]
  conv_rhs => rw [Fin.prod_univ_succ]
  simp only [modelInputIndex_zero, modelInputIndex_succ]
  rw [Equiv.prod_comp σ (fun j : Fin 3 ↦ g j.succ)]

/-- The canonical stopping thresholds after permutation coincide with the
active-coordinate thresholds before permutation. -/
theorem sourceStoppingExponent_permute
    (σ : Equiv.Perm (Fin 3)) (i : Fin 3) (hσ : σ 2 = i)
    (j : Fin 4) :
    sourceStoppingExponent j =
      activeSourceStoppingExponent i (modelInputIndex σ j) := by
  refine Fin.cases ?_ ?_ j
  · simp [sourceStoppingExponent, activeSourceStoppingExponent]
  · intro k
    by_cases hk : k = 2
    · subst k
      change 2 = activeSourceStoppingExponent i ((σ 2).succ)
      simp [activeSourceStoppingExponent, hσ]
    · have hσk : σ k ≠ i := by
        intro hki
        apply hk
        exact σ.injective (hki.trans hσ.symm)
      have hksucc : k.succ ≠ (3 : Fin 4) := by
        intro h
        apply hk
        exact (Fin.succ_injective 3) (by simpa using h)
      simp [sourceStoppingExponent, activeSourceStoppingExponent,
        hksucc, hσk]

/-- Positivity of the original active-coordinate exponent tuple transfers to
the canonical tuple after relabeling. -/
theorem permutedModelExponent_pos
    (σ : Equiv.Perm (Fin 3)) (q : Fin 4 → ℝ)
    (hq : ∀ j : Fin 4, 0 < q j) :
    ∀ j : Fin 4, 0 < permutedModelExponent σ q j := by
  intro j
  exact hq (modelInputIndex σ j)

/-- The reciprocal-sum condition is invariant under the four-input
relabeling. -/
theorem sum_inv_permutedModelExponent
    (σ : Equiv.Perm (Fin 3)) (q : Fin 4 → ℝ) :
    (∑ j : Fin 4, (permutedModelExponent σ q j)⁻¹) =
      ∑ j : Fin 4, (q j)⁻¹ := by
  exact sum_modelInputIndex σ (fun j ↦ (q j)⁻¹)

/-- Active-coordinate stopping threshold hypotheses transfer to the initial
active-third model after relabeling. -/
theorem permutedModelExponent_stoppingThreshold
    (σ : Equiv.Perm (Fin 3)) (i : Fin 3) (q : Fin 4 → ℝ)
    (hσ : σ 2 = i)
    (hqs : ∀ j : Fin 4, activeSourceStoppingExponent i j < q j) :
    ∀ j : Fin 4,
      sourceStoppingExponent j < permutedModelExponent σ q j := by
  intro j
  rw [sourceStoppingExponent_permute σ i hσ j]
  exact hqs (modelInputIndex σ j)

/-- The ordinary real `L^p` norm is preserved componentwise by the
coordinate-permuted Schwartz tuple. -/
theorem lpNorm_permutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelSchwartzInput)
    (j : Fin 4) (p : ℝ≥0∞) :
    lpNorm (permutedModelInput σ F j : E3 → ℝ) p volume =
      lpNorm (F (modelInputIndex σ j) : E3 → ℝ) p volume := by
  rw [← toReal_eLpNorm
    (permutedModelInput σ F j).continuous.aestronglyMeasurable,
    ← toReal_eLpNorm
      (F (modelInputIndex σ j)).continuous.aestronglyMeasurable,
    eLpNorm_permutedModelInput]

/-- The product of the four input norms is invariant under simultaneous
permutation of input labels and exponents. -/
theorem prod_lpNorm_permutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelSchwartzInput)
    (q : Fin 4 → ℝ) :
    (∏ j : Fin 4,
      lpNorm (permutedModelInput σ F j : E3 → ℝ)
        (ENNReal.ofReal (permutedModelExponent σ q j)) volume) =
      ∏ j : Fin 4,
        lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
  let G : Fin 4 → ℝ := fun j ↦
    lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume
  calc
    (∏ j : Fin 4,
      lpNorm (permutedModelInput σ F j : E3 → ℝ)
        (ENNReal.ofReal (permutedModelExponent σ q j)) volume) =
        ∏ j : Fin 4, G (modelInputIndex σ j) := by
          apply Finset.prod_congr rfl
          intro j _
          simpa only [G, permutedModelExponent_apply] using
            lpNorm_permutedModelInput σ F j
              (ENNReal.ofReal (q (modelInputIndex σ j)))
    _ = ∏ j : Fin 4, G j := prod_modelInputIndex σ G

/-- The strict real initial range holds uniformly for every choice of the
active annular coordinate.  The hypotheses use fourth-power thresholds for
the outer and passive inputs and the second-power threshold for the active
convolved input. -/
theorem activeModelFullForm_bound_weight100
    (α : Anisotropy) (i : Fin 3) (u : E3) (c : ℝ → ℝ)
    (F : ModelSchwartzInput) (q : Fin 4 → ℝ)
    (hq : ∀ j : Fin 4, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j : Fin 4, activeSourceStoppingExponent i j < q j)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1) :
    ∃ C : ℝ, 0 ≤ C ∧
      |activeModelFullForm α i u c F| ≤ C * sourceWeight u ^ 100 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
  rcases exists_coordinatePermutation_to_active i with ⟨σ, hσ⟩
  let q' : Fin 4 → ℝ := permutedModelExponent σ q
  have hq' : ∀ j : Fin 4, 0 < q' j := by
    simpa only [q'] using permutedModelExponent_pos σ q hq
  have hsum' : ∑ j : Fin 4, (q' j)⁻¹ = 1 := by
    calc
      (∑ j : Fin 4, (q' j)⁻¹) = ∑ j : Fin 4, (q j)⁻¹ := by
        simpa only [q'] using sum_inv_permutedModelExponent σ q
      _ = 1 := hsum
  have hqs' : ∀ j : Fin 4, sourceStoppingExponent j < q' j := by
    simpa only [q'] using
      permutedModelExponent_stoppingThreshold σ i q hσ hqs
  obtain ⟨C, hC, hbound⟩ := initialModelFullForm_bound
    (permutedAnisotropy α σ) (coordinatePermutation σ u) c
    (permutedModelInput σ F) q' hq' hsum' hqs' hcmeas hc
  refine ⟨C, hC, ?_⟩
  rw [activeModelFullForm_permute_to_third α σ i u c F hσ]
  have hbound' :
      |ModelFullForm (permutedAnisotropy α σ) (coordinatePermutation σ u)
          c (permutedModelInput σ F)| ≤
        C * sourceWeight (coordinatePermutation σ u) ^ 75 *
          ∏ j : Fin 4,
            lpNorm (permutedModelInput σ F j : E3 → ℝ)
              (ENNReal.ofReal (permutedModelExponent σ q j)) volume := by
    simpa only [q'] using hbound
  rw [sourceWeight_coordinatePermutation σ u,
    prod_lpNorm_permutedModelInput σ F q] at hbound'
  have hweight : 1 ≤ sourceWeight u := by
    unfold sourceWeight
    linarith [abs_nonneg (u 0), abs_nonneg (u 1), abs_nonneg (u 2)]
  have hpow : sourceWeight u ^ 75 ≤ sourceWeight u ^ 100 :=
    pow_le_pow_right₀ hweight (by norm_num)
  have hprod : 0 ≤ ∏ j : Fin 4,
      lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
    exact Finset.prod_nonneg fun j _ ↦ lpNorm_nonneg
  calc
    |ModelFullForm (permutedAnisotropy α σ) (coordinatePermutation σ u)
        c (permutedModelInput σ F)| ≤
        C * sourceWeight u ^ 75 *
          ∏ j : Fin 4,
            lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := hbound'
    _ = (C * ∏ j : Fin 4,
          lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume) *
          sourceWeight u ^ 75 := by ring
    _ ≤ (C * ∏ j : Fin 4,
          lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume) *
          sourceWeight u ^ 100 :=
      mul_le_mul_of_nonneg_left hpow (mul_nonneg hC hprod)
    _ = C * sourceWeight u ^ 100 *
        ∏ j : Fin 4,
          lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by ring

/-! ## Uniform strict initial-range constants -/

/-- The forest construction in the real initial range supplies one constant
for every translation, real unit coefficient, and real Schwartz four-tuple.
This places the quantifiers in the order needed by complexification. -/
theorem exists_uniform_initialModelFullForm_bound_weight75
    (α : Anisotropy) (q : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (c : ℝ → ℝ)
      (F : InitialModelSchwartzInput),
      Measurable c → (∀ t : ℝ, |c t| ≤ 1) →
      |ModelFullForm α u c F| ≤ C * sourceWeight u ^ 75 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume := by
  rcases exists_uniform_activeStoppingForest_constant α with
    ⟨C₀, hC₀, hforest⟩
  let K : Fin 4 → ℝ := fun _ ↦ dyadicBracketShellConstant
  let D : Fin 4 → ℝ := fun j ↦ sourceStoppingDyadicInputConstant K q j
  let C : ℝ := C₀ * ∑ j : Fin 4, D j
  have hD : ∀ j : Fin 4, 0 ≤ D j := by
    intro j
    dsimp only [D]
    exact sourceStoppingDyadicInputConstant_nonneg K q j (hq j)
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg hC₀ (Finset.sum_nonneg fun j _ ↦ hD j)
  refine ⟨C, hC, ?_⟩
  intro u c F hcmeas hc
  by_cases hzero : ∃ j : Fin 4, F j = 0
  · rcases hzero with ⟨j, hj⟩
    rw [ModelFullForm_eq_zero_of_component_eq_zero α u c F j hj]
    have hprod : 0 ≤ ∏ j : Fin 4,
        lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
      exact Finset.prod_nonneg fun j _ ↦ lpNorm_nonneg
    simpa using (mul_nonneg
      (mul_nonneg hC (pow_nonneg (sourceWeight_nonneg u) 75))
      hprod)
  · have hF : ∀ j : Fin 4, F j ≠ 0 := by
      intro j hj
      exact hzero ⟨j, hj⟩
    apply fourlinear_bound_of_normalized_bound
      (L := ModelFullForm α u c)
      (N := fun j f ↦ lpNorm (f : E3 → ℝ)
        (ENNReal.ofReal (q j)) volume)
      (C := C * sourceWeight u ^ 75)
    · exact ModelFullForm_rescale α u c
    · intro G hGunit
      have hG : ∀ j : Fin 4, G j ≠ 0 := by
        intro j hzero
        have hzeroNorm : lpNorm (G j : E3 → ℝ)
            (ENNReal.ofReal (q j)) volume = 0 := by
          rw [hzero]
          change lpNorm (0 : E3 → ℝ) (ENNReal.ofReal (q j)) volume = 0
          exact lpNorm_zero (ENNReal.ofReal (q j)) volume
        linarith [hGunit j]
      let W : ℝ := ∑ j : Fin 4, D j *
        ∫ x : E3, |G j x| ^ q j
      have hfull : ∀ N : ℕ, Integrable
          (modelFiberFullyExpandedIntegrand α u c (InitialModelRealInput G))
          (((cubeScaleMeasure.restrict
            (Set.univ ×ˢ truncationScaleSet N)).prod
              (volume : Measure ModelE5)).prod
            ((volume : Measure ℝ).prod volume)) := by
        intro N
        exact integrable_modelFiberFullyExpanded_truncationScale
          α u c G N hcmeas hc
      have hdistribution : ∀ M : ℕ,
          SourceStoppingCoordinateEnvelope α (truncationCollection α M)
            (InitialModelRealInput G) q (fun _ ↦ 0)
            (initialModel_sourceStoppingData_all_pos_of_ne_zero
              α (truncationCollection α M) G hG) ≤ W := by
        intro M
        dsimp only [W, D, K]
        exact initialSourceStoppingCoordinateEnvelope_le_explicitInputPowers_of_realSchwartz
          α (truncationCollection α M) G q hq hsum hqs hG
      have hglobal :=
        modelFullForm_bound_of_initial_stoppingEnvelope_of_uniformForest
          α C₀ hC₀ hforest u c G q (fun _ ↦ 0) W hq hG hcmeas hc
          hfull hdistribution
      have hpower (j : Fin 4) :
          (∫ x : E3, |G j x| ^ q j) = 1 :=
        integral_abs_rpow_eq_one_of_lpNorm_eq_one
          (G j : E3 → ℝ) (q j) (hq j)
          (G j).continuous.aestronglyMeasurable (hGunit j)
      have hW : W = ∑ j : Fin 4, D j := by
        dsimp only [W]
        apply Finset.sum_congr rfl
        intro j _
        rw [hpower j, mul_one]
      rw [hW] at hglobal
      change |ModelFullForm α u c G| ≤ C * sourceWeight u ^ 75
      dsimp only [C]
      calc
        |ModelFullForm α u c G| ≤
            C₀ * sourceWeight u ^ 75 * ∑ j : Fin 4, D j := hglobal
        _ = (C₀ * ∑ j : Fin 4, D j) * sourceWeight u ^ 75 := by ring
    · intro j
      exact lpNorm_pos_of_realSchwartz_ne_zero
        (F j) (q j) (hq j) (hF j)
    · intro j
      exact lpNorm_inv_smul_eq_one
        (F j : E3 → ℝ) (q j)
        (lpNorm_pos_of_realSchwartz_ne_zero
          (F j) (q j) (hq j) (hF j))

/-- The uniform real initial range at the larger translation exponent
displayed in the blueprint. -/
theorem exists_uniform_initialModelFullForm_bound_weight100
    (α : Anisotropy) (q : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (c : ℝ → ℝ)
      (F : InitialModelSchwartzInput),
      Measurable c → (∀ t : ℝ, |c t| ≤ 1) →
      |ModelFullForm α u c F| ≤ C * sourceWeight u ^ 100 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume := by
  rcases exists_uniform_initialModelFullForm_bound_weight75
    α q hq hsum hqs with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u c F hcmeas hc
  refine (hbound u c F hcmeas hc).trans ?_
  have hweight : 1 ≤ sourceWeight u := by
    unfold sourceWeight
    linarith [abs_nonneg (u 0), abs_nonneg (u 1), abs_nonneg (u 2)]
  have hpow : sourceWeight u ^ 75 ≤ sourceWeight u ^ 100 :=
    pow_le_pow_right₀ hweight (by norm_num)
  have hprod : 0 ≤ ∏ j : Fin 4,
      lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
    exact Finset.prod_nonneg fun j _ ↦ lpNorm_nonneg
  calc
    C * sourceWeight u ^ 75 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume =
        (C * ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume) * sourceWeight u ^ 75 := by ring
    _ ≤ (C * ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume) * sourceWeight u ^ 100 :=
      mul_le_mul_of_nonneg_left hpow (mul_nonneg hC hprod)
    _ = C * sourceWeight u ^ 100 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume := by
      calc
        (C * ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
            (ENNReal.ofReal (q j)) volume) * sourceWeight u ^ 100 =
            C * ((∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
              (ENNReal.ofReal (q j)) volume) * sourceWeight u ^ 100) := by
              rw [mul_assoc]
        _ = C * (sourceWeight u ^ 100 *
            ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
              (ENNReal.ofReal (q j)) volume) := by
              rw [mul_comm (∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
                (ENNReal.ofReal (q j)) volume)]
        _ = C * sourceWeight u ^ 100 *
            ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
              (ENNReal.ofReal (q j)) volume := by
              rw [mul_assoc]

/-- The literal dyadic maximal operator in an arbitrary coordinate has the
weak `(1,1)` bound obtained by transporting the proved product-fiber endpoint.
This is the maximal-function input used for the nonexceptional factors in the
one-fiber Calderón--Zygmund argument. -/
theorem coordinateDyadicBallMaximal_weak_one
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f)
    {s : ℝ} (hs : 0 < s) :
    ENNReal.ofReal s * volume {x | s < coordinateDyadicBallMaximal i f x} ≤
      ENNReal.ofReal 4 * ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
  let e := e3ToFiberDyadicCoordinates i
  let G : FiberDyadicBase × FiberDyadicLine → ℂ := f ∘ e.symm
  have he : MeasurePreserving e volume fiberDyadicMeasure := by
    simpa only [e] using e3ToFiberDyadicCoordinates_measurePreserving i
  have hG : Measurable G := hf.comp e.symm.measurable
  have hfiber := fiberDyadicBallMaximal_weak_one G hG hs
  have hA : MeasurableSet {q : FiberDyadicBase × FiberDyadicLine |
      s < fiberDyadicBallMaximal G q} :=
    measurableSet_lt measurable_const (fiberDyadicBallMaximal_measurable G hG)
  have hset : {x : E3 | s < coordinateDyadicBallMaximal i f x} =
      e ⁻¹' {q : FiberDyadicBase × FiberDyadicLine |
        s < fiberDyadicBallMaximal G q} := by
    ext x
    change s < fiberDyadicBallMaximal G (e x) ↔
      s < fiberDyadicBallMaximal G (e x)
    rfl
  have hright :
      (∫⁻ q, ENNReal.ofReal ‖G q‖ ∂fiberDyadicMeasure) =
        ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
    simpa only [G, Function.comp_apply, MeasurableEquiv.symm_apply_apply] using
      (he.lintegral_comp (hG.norm.ennreal_ofReal)).symm
  calc
    ENNReal.ofReal s * volume {x | s < coordinateDyadicBallMaximal i f x} =
        ENNReal.ofReal s * volume
          (e ⁻¹' {q : FiberDyadicBase × FiberDyadicLine |
            s < fiberDyadicBallMaximal G q}) := by rw [hset]
    _ = ENNReal.ofReal s * fiberDyadicMeasure
          {q : FiberDyadicBase × FiberDyadicLine |
            s < fiberDyadicBallMaximal G q} := by
      rw [he.measure_preimage hA.nullMeasurableSet]
    _ ≤ ENNReal.ofReal 4 * ∫⁻ q, ENNReal.ofReal ‖G q‖
          ∂fiberDyadicMeasure := hfiber
    _ = ENNReal.ofReal 4 * ∫⁻ x, ENNReal.ofReal ‖f x‖ := by rw [hright]

/-- The shell constant in the bracket-to-dyadic comparison is strictly
positive, so weak bounds may be rescaled through it. -/
theorem dyadicBracketShellConstant_pos : 0 < dyadicBracketShellConstant := by
  unfold dyadicBracketShellConstant
  apply mul_pos (by norm_num)
  exact ENNReal.toReal_pos
    (Metric.measure_ball_pos volume (0 : FiberDyadicLine) (by norm_num)).ne'
    measure_ball_lt_top.ne

/-- A positive bracket convolution in any one coordinate has the concrete
weak `(1,1)` endpoint required for the bad-fiber estimate: it is controlled
by the dyadic maximal weak endpoint with exactly one shell factor. -/
theorem coordinateBracketConvolution_weak_one
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ x, ‖f x‖ ≤ A)
    (r : ℝ) (hr : 0 < r) {s : ℝ} (hs : 0 < s) :
    ENNReal.ofReal s * volume {x | s < coordinateBracketConvolution i f r x} ≤
      ENNReal.ofReal (4 * dyadicBracketShellConstant) *
        ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
  let K : ℝ := dyadicBracketShellConstant
  have hK : 0 < K := by
    dsimp only [K]
    exact dyadicBracketShellConstant_pos
  have hsubset : {x : E3 | s < coordinateBracketConvolution i f r x} ⊆
      {x | s / K < coordinateDyadicBallMaximal i f x} := by
    intro x hx
    have hpoint := coordinateBracketConvolution_le_shell_dyadic
      i f hf A hA hbound r x hr
    have hlt : s < K * coordinateDyadicBallMaximal i f x := by
      exact lt_of_lt_of_le hx hpoint
    exact (div_lt_iff₀ hK).mpr (by simpa [mul_comm] using hlt)
  have hmeasure : volume {x | s < coordinateBracketConvolution i f r x} ≤
      volume {x | s / K < coordinateDyadicBallMaximal i f x} :=
    measure_mono hsubset
  have hbase :
      ENNReal.ofReal (s / K) *
          volume {x | s < coordinateBracketConvolution i f r x} ≤
        ENNReal.ofReal 4 * ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
    calc
      ENNReal.ofReal (s / K) *
          volume {x | s < coordinateBracketConvolution i f r x} ≤
          ENNReal.ofReal (s / K) *
            volume {x | s / K < coordinateDyadicBallMaximal i f x} :=
        mul_le_mul_of_nonneg_left hmeasure bot_le
      _ ≤ ENNReal.ofReal 4 * ∫⁻ x, ENNReal.ofReal ‖f x‖ :=
        coordinateDyadicBallMaximal_weak_one i f hf (div_pos hs hK)
  have hKs : ENNReal.ofReal K * ENNReal.ofReal (s / K) = ENNReal.ofReal s := by
    rw [← ENNReal.ofReal_mul hK.le]
    congr 1
    field_simp
  have hKfour : ENNReal.ofReal K * ENNReal.ofReal 4 =
      ENNReal.ofReal (4 * K) := by
    rw [← ENNReal.ofReal_mul hK.le]
    congr 1
    ring
  calc
    ENNReal.ofReal s * volume {x | s < coordinateBracketConvolution i f r x} =
        ENNReal.ofReal K *
          (ENNReal.ofReal (s / K) *
            volume {x | s < coordinateBracketConvolution i f r x}) := by
      rw [← mul_assoc, hKs]
    _ ≤ ENNReal.ofReal K *
          (ENNReal.ofReal 4 * ∫⁻ x, ENNReal.ofReal ‖f x‖) :=
      mul_le_mul_of_nonneg_left hbase bot_le
    _ = ENNReal.ofReal (4 * K) * ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
      rw [← mul_assoc, hKfour]
    _ = ENNReal.ofReal (4 * dyadicBracketShellConstant) *
          ∫⁻ x, ENNReal.ofReal ‖f x‖ := by rfl

/-! ## Uniform active-coordinate range and mode summation -/

/-- The uniform strict model constant transports to every active coordinate.
Unlike the earlier pointwise formulation, its constant is chosen before the
translation, coefficient, and input tuple; this is the form consumed by the
complexification and lattice-mode stages. -/
theorem exists_uniform_activeModelFullForm_bound_weight100
    (α : Anisotropy) (i : Fin 3) (q : Fin 4 → ℝ)
    (hq : ∀ j : Fin 4, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j : Fin 4, activeSourceStoppingExponent i j < q j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (c : ℝ → ℝ)
      (F : ModelSchwartzInput),
      Measurable c → (∀ t : ℝ, |c t| ≤ 1) →
      |activeModelFullForm α i u c F| ≤ C * sourceWeight u ^ 100 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
  rcases exists_coordinatePermutation_to_active i with ⟨σ, hσ⟩
  let q' : Fin 4 → ℝ := permutedModelExponent σ q
  have hq' : ∀ j : Fin 4, 0 < q' j := by
    simpa only [q'] using permutedModelExponent_pos σ q hq
  have hsum' : ∑ j : Fin 4, (q' j)⁻¹ = 1 := by
    calc
      (∑ j : Fin 4, (q' j)⁻¹) = ∑ j : Fin 4, (q j)⁻¹ := by
        simpa only [q'] using sum_inv_permutedModelExponent σ q
      _ = 1 := hsum
  have hqs' : ∀ j : Fin 4, sourceStoppingExponent j < q' j := by
    simpa only [q'] using
      permutedModelExponent_stoppingThreshold σ i q hσ hqs
  rcases exists_uniform_initialModelFullForm_bound_weight100
    (permutedAnisotropy α σ) q' hq' hsum' hqs' with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u c F hcmeas hc
  rw [activeModelFullForm_permute_to_third α σ i u c F hσ]
  have hbound' := hbound (coordinatePermutation σ u) c
    (permutedModelInput σ F) hcmeas hc
  rw [sourceWeight_coordinatePermutation σ u,
    prod_lpNorm_permutedModelInput σ F q] at hbound'
  simpa only [q'] using hbound'

/-- The translation parameter attached to a Fourier mode.  The source uses
`ν / 8`; scalar multiplication keeps the standard lattice embedding available
to the summability package. -/
noncomputable def standardModeTranslate (z : standardModeLattice) : E3 :=
  (8 : ℝ)⁻¹ • (z : E3)

@[simp] theorem standardModeTranslate_apply
    (z : standardModeLattice) (j : Fin 3) :
    standardModeTranslate z j = (8 : ℝ)⁻¹ * (z : E3) j := by
  rfl

/-- Dividing a mode vector by the source period does not enlarge its
translation weight. -/
theorem sourceWeight_standardModeTranslate_le
    (z : standardModeLattice) :
    sourceWeight (standardModeTranslate z) ≤ sourceWeight (z : E3) := by
  unfold standardModeTranslate sourceWeight
  simp only [PiLp.smul_apply, smul_eq_mul]
  have h0 : |(8 : ℝ)⁻¹ * (z : E3) 0| ≤ |(z : E3) 0| := by
    rw [abs_mul]
    nlinarith [abs_nonneg ((z : E3) 0)]
  have h1 : |(8 : ℝ)⁻¹ * (z : E3) 1| ≤ |(z : E3) 1| := by
    rw [abs_mul]
    nlinarith [abs_nonneg ((z : E3) 1)]
  have h2 : |(8 : ℝ)⁻¹ * (z : E3) 2| ≤ |(z : E3) 2| := by
    rw [abs_mul]
    nlinarith [abs_nonneg ((z : E3) 2)]
  linarith

/-- The weight-100 model factor at the translated Fourier mode is dominated
by the weight-100 factor already used by the degree-ten lattice tail. -/
theorem sourceWeight_standardModeTranslate_pow_le
    (z : standardModeLattice) :
    sourceWeight (standardModeTranslate z) ^ (100 : ℕ) ≤
      sourceWeight (z : E3) ^ (100 : ℕ) := by
  exact pow_le_pow_left₀ (sourceWeight_nonneg _)
    (sourceWeight_standardModeTranslate_le z) _

/-- The degree-110 coefficient decay and degree-100 active-model bound are
summable after the source mode translation `ν ↦ ν / 8`.  This is the literal
lattice-summation consumer used after the cone/Fourier expansion identifies
its individual terms. -/
theorem summable_activeModelFullForm_modeTerms_of_decay
    (α : Anisotropy) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (a : Fin 3 → standardModeLattice → ℂ) (C D : ℝ)
    (hC : 0 ≤ C) (hD : 0 ≤ D)
    (ha : ∀ i z, ‖a i z‖ ≤
      C * (sourceWeight (z : E3))⁻¹ ^ (110 : ℕ))
    (hactive : ∀ i z,
      ‖(activeModelFullForm α i (standardModeTranslate z) c F : ℂ)‖ ≤
        D * sourceWeight (standardModeTranslate z) ^ (100 : ℕ)) :
    Summable (fun z : standardModeLattice ↦
      ∑ i : Fin 3, a i z *
        (activeModelFullForm α i (standardModeTranslate z) c F : ℂ)) := by
  let b : Fin 3 → standardModeLattice → ℂ := fun i z ↦
    (activeModelFullForm α i (standardModeTranslate z) c F : ℂ)
  have hb : ∀ i z, ‖b i z‖ ≤
      D * sourceWeight (z : E3) ^ (100 : ℕ) := by
    intro i z
    dsimp only [b]
    exact (hactive i z).trans
      (mul_le_mul_of_nonneg_left
        (sourceWeight_standardModeTranslate_pow_le z) hD)
  simpa only [b] using
    (summable_threeCoordinateModeProducts_of_decay a b C D hC hD ha hb)

/-- The preceding absolutely convergent cone-mode sum has its explicit
degree-ten lattice majorant. -/
theorem norm_tsum_activeModelFullForm_modeTerms_le_of_decay
    (α : Anisotropy) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (a : Fin 3 → standardModeLattice → ℂ) (C D : ℝ)
    (hC : 0 ≤ C) (hD : 0 ≤ D)
    (ha : ∀ i z, ‖a i z‖ ≤
      C * (sourceWeight (z : E3))⁻¹ ^ (110 : ℕ))
    (hactive : ∀ i z,
      ‖(activeModelFullForm α i (standardModeTranslate z) c F : ℂ)‖ ≤
        D * sourceWeight (standardModeTranslate z) ^ (100 : ℕ)) :
    ‖∑' z : standardModeLattice, ∑ i : Fin 3, a i z *
      (activeModelFullForm α i (standardModeTranslate z) c F : ℂ)‖ ≤
      (3 * C * D) * ∑' z : standardModeLattice,
        (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ) := by
  let b : Fin 3 → standardModeLattice → ℂ := fun i z ↦
    (activeModelFullForm α i (standardModeTranslate z) c F : ℂ)
  have hb : ∀ i z, ‖b i z‖ ≤
      D * sourceWeight (z : E3) ^ (100 : ℕ) := by
    intro i z
    dsimp only [b]
    exact (hactive i z).trans
      (mul_le_mul_of_nonneg_left
        (sourceWeight_standardModeTranslate_pow_le z) hD)
  simpa only [b] using
    (norm_tsum_threeCoordinateModeProducts_le_of_decay a b C D hC hD ha hb)

/-! ### Section 8 kernel majorants -/

/-- An additional tenth-order reciprocal estimate makes a polynomially
weighted absolute value integrable.  This is the weighted input for the
convolutional kernel decay calculation. -/
theorem integrable_weighted_abs_of_decay
    (n : ℕ) (f : ℝ → ℝ) (hf : AEStronglyMeasurable f volume) {C : ℝ}
    (hdecay : ∀ x : ℝ, |f x| ≤ C / (1 + |x|) ^ (n + 10)) :
    Integrable (fun x : ℝ ↦ (1 + |x|) ^ n * |f x|) := by
  have hmajor : Integrable (fun x : ℝ ↦ C * bracketKernel x) :=
    integrable_bracketKernel.const_mul C
  have hfabs : AEStronglyMeasurable (fun x : ℝ ↦ |f x|) volume := by
    simpa only [Real.norm_eq_abs] using hf.norm
  have hweight : AEStronglyMeasurable (fun x : ℝ ↦ (1 + |x|) ^ n) volume :=
    ((continuous_const.add continuous_id.abs).pow n).aestronglyMeasurable
  have hmeas : AEStronglyMeasurable
      (fun x : ℝ ↦ (1 + |x|) ^ n * |f x|) volume :=
    hweight.mul hfabs
  apply hmajor.mono' hmeas
  filter_upwards [] with x
  have htargetnonneg : 0 ≤ (1 + |x|) ^ n * |f x| := by positivity
  rw [Real.norm_eq_abs, abs_of_nonneg htargetnonneg]
  have hW : 0 < (1 + |x|) ^ 10 := by positivity
  have hprod : (1 + |x|) ^ (n + 10) * |f x| ≤ C := by
    simpa [mul_comm] using
      (le_div_iff₀ (pow_pos (by positivity) (n + 10))).mp (hdecay x)
  rw [bracketKernel_eq_inv_pow]
  change (1 + |x|) ^ n * |f x| ≤ C / (1 + |x|) ^ 10
  apply (le_div_iff₀ hW).mpr
  have hpows : (1 + |x|) ^ n * (1 + |x|) ^ 10 =
      (1 + |x|) ^ (n + 10) := by
    rw [← pow_add]
  calc
    ((1 + |x|) ^ n * |f x|) * (1 + |x|) ^ 10 =
        ((1 + |x|) ^ n * (1 + |x|) ^ 10) * |f x| := by ring
    _ = (1 + |x|) ^ (n + 10) * |f x| := by rw [hpows]
    _ ≤ C := hprod

/-- A convolution inherits polynomial decay when one factor has a bounded
weighted absolute value and the other has an integrable weighted absolute
value.  The asymmetric form is tailored to the Gaussian--Schwartz kernel
convolutions in the source model. -/
theorem convolution_decay_of_weighted_bound
    (n : ℕ) (f g : ℝ → ℝ) (hf : Measurable f) (hg : Measurable g)
    (hgint : Integrable g)
    (hgw : Integrable (fun y : ℝ ↦ (1 + |y|) ^ n * |g y|))
    {C : ℝ}
    (hfbound : ∀ z : ℝ, (1 + |z|) ^ n * |f z| ≤ C) :
    ∀ x : ℝ, (1 + |x|) ^ n *
      abs ((f ⋆[ContinuousLinearMap.mul ℝ ℝ] g) x) ≤
        C * ∫ y : ℝ, (1 + |y|) ^ n * |g y| := by
  intro x
  let H : ℝ → ℝ := fun z ↦ f z * g (x - z)
  let Q : ℝ → ℝ := fun z ↦ (1 + |x - z|) ^ n * |g (x - z)|
  have hgabs : Integrable (fun z : ℝ ↦ |g (x - z)|) := by
    simpa only [Real.norm_eq_abs] using hgint.norm.comp_sub_left x
  have hHmeas : AEStronglyMeasurable H volume := by
    dsimp only [H]
    exact hf.aestronglyMeasurable.mul
      ((hg.comp (measurable_const.sub measurable_id)).aestronglyMeasurable)
  have hH : Integrable H := by
    apply (hgabs.const_mul C).mono' hHmeas
    filter_upwards [] with z
    have hWone : 1 ≤ (1 + |z|) ^ n := by
      have hbase : (1 : ℝ) ≤ 1 + |z| := by linarith [abs_nonneg z]
      simpa using pow_le_pow_left₀ (by norm_num : (0 : ℝ) ≤ 1) hbase n
    have hfplain : |f z| ≤ C := by
      calc
        |f z| = 1 * |f z| := by ring
        _ ≤ (1 + |z|) ^ n * |f z| :=
          mul_le_mul_of_nonneg_right hWone (abs_nonneg _)
        _ ≤ C := hfbound z
    dsimp only [H]
    rw [Real.norm_eq_abs, abs_mul]
    exact mul_le_mul_of_nonneg_right hfplain (abs_nonneg _)
  have hQ : Integrable Q := by
    dsimp only [Q]
    exact hgw.comp_sub_left x
  have hQscaled : Integrable (fun z : ℝ ↦ C * Q z) := hQ.const_mul C
  have hweightpoint (z : ℝ) :
      (1 + |x|) ^ n * |H z| ≤ C * Q z := by
    have htri : 1 + |x| ≤ (1 + |z|) * (1 + |x - z|) := by
      have habs : |x| ≤ |z| + |x - z| := by
        calc
          |x| = |z + (x - z)| := by ring_nf
          _ ≤ |z| + |x - z| := abs_add_le _ _
      nlinarith [mul_nonneg (abs_nonneg z) (abs_nonneg (x - z))]
    have hpow : (1 + |x|) ^ n ≤
        (1 + |z|) ^ n * (1 + |x - z|) ^ n := by
      calc
        (1 + |x|) ^ n ≤ ((1 + |z|) * (1 + |x - z|)) ^ n :=
          pow_le_pow_left₀ (by positivity) htri n
        _ = (1 + |z|) ^ n * (1 + |x - z|) ^ n := by rw [mul_pow]
    dsimp only [H, Q]
    rw [abs_mul]
    calc
      (1 + |x|) ^ n * (|f z| * |g (x - z)|) ≤
          ((1 + |z|) ^ n * (1 + |x - z|) ^ n) *
            (|f z| * |g (x - z)|) :=
        mul_le_mul_of_nonneg_right hpow
          (mul_nonneg (abs_nonneg _) (abs_nonneg _))
      _ = ((1 + |z|) ^ n * |f z|) *
          ((1 + |x - z|) ^ n * |g (x - z)|) := by ring
      _ ≤ C * ((1 + |x - z|) ^ n * |g (x - z)|) :=
        mul_le_mul_of_nonneg_right (hfbound z)
          (mul_nonneg (pow_nonneg (by positivity) _) (abs_nonneg _))
  have hleft : Integrable (fun z : ℝ ↦ (1 + |x|) ^ n * |H z|) := by
    simpa only [Real.norm_eq_abs] using hH.norm.const_mul ((1 + |x|) ^ n)
  change (1 + |x|) ^ n * |∫ z : ℝ, f z * g (x - z)| ≤ _
  calc
    (1 + |x|) ^ n * |∫ z : ℝ, f z * g (x - z)| ≤
        (1 + |x|) ^ n * ∫ z : ℝ, |H z| := by
      apply mul_le_mul_of_nonneg_left
      · change |∫ z : ℝ, H z| ≤ ∫ z : ℝ, |H z|
        exact MeasureTheory.abs_integral_le_integral_abs
      · positivity
    _ = ∫ z : ℝ, (1 + |x|) ^ n * |H z| := by
      rw [integral_const_mul]
    _ ≤ ∫ z : ℝ, C * Q z := by
      exact integral_mono hleft hQscaled hweightpoint
    _ = C * ∫ z : ℝ, Q z := by rw [integral_const_mul]
    _ = C * ∫ y : ℝ, (1 + |y|) ^ n * |g y| := by
      dsimp only [Q]
      exact congrArg (fun I : ℝ ↦ C * I)
        (integral_sub_left_eq_self
          (fun y : ℝ ↦ (1 + |y|) ^ n * |g y|) volume x)

/-- The low-frequency Gaussian--Schwartz convolution has the source's
order-ten physical decay. -/
theorem low_convolution_polynomial_decay :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      (1 + |x|) ^ 10 *
        |(gaussian ⋆[ContinuousLinearMap.mul ℝ ℝ] conePhiPhysicalReal) x| ≤ C := by
  rcases gaussian_polynomial_decay 10 with ⟨Cg, hCg, hg⟩
  rcases conePhiPhysicalReal_decay 20 with ⟨Cphi, hCphi, hphi⟩
  have hphiweighted : Integrable (fun y : ℝ ↦
      (1 + |y|) ^ 10 * |conePhiPhysicalReal y|) :=
    integrable_weighted_abs_of_decay 10 conePhiPhysicalReal
      conePhiPhysicalReal.continuous.aestronglyMeasurable hphi
  have hgaussian : ∀ z : ℝ, (1 + |z|) ^ 10 * |gaussian z| ≤ Cg := by
    intro z
    rw [abs_of_nonneg (gaussian_nonneg z)]
    exact hg z
  have hconv := convolution_decay_of_weighted_bound 10
    gaussian conePhiPhysicalReal gaussian_contDiff.continuous.measurable
    conePhiPhysicalReal.continuous.measurable conePhiPhysicalReal.integrable
    hphiweighted hgaussian
  let C : ℝ := Cg * ∫ y : ℝ, (1 + |y|) ^ 10 * |conePhiPhysicalReal y|
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg hCg (integral_nonneg fun y ↦ by positivity)
  refine ⟨C, hC, ?_⟩
  intro x
  exact hconv x

/-- The literal low-frequency model kernel obeys a translated bracket
majorant.  This is the unit-scale source kernel estimate. -/
theorem ModelLowKernel_translate_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u w : ℝ),
      |ModelLowKernel u w| ≤
        C * translationWeight u ^ 10 * bracketKernel w := by
  rcases low_convolution_polynomial_decay with ⟨C, hC, hdecay⟩
  rcases kernelAt_translate_bracket_of_polynomial_decay
    (gaussian ⋆[ContinuousLinearMap.mul ℝ ℝ] conePhiPhysicalReal)
    ⟨C, hC, hdecay⟩ with ⟨D, hD, htranslate⟩
  refine ⟨D, hD, ?_⟩
  intro u w
  have hEq : ModelLowKernel u w =
      kernelAt (gaussian ⋆[ContinuousLinearMap.mul ℝ ℝ] conePhiPhysicalReal) 1 u w := by
    unfold kernelAt kernelDilate
    simp only [inv_one, one_smul]
    rw [convolution_mul]
    unfold ModelLowKernel
    apply integral_congr_ae
    filter_upwards [] with z
    congr 1
    ring_nf
  rw [hEq]
  exact htranslate u w

/-- Positive mass-normalized dilation preserves the translated bracket
majorant, in the exact form used by one-fiber convolution. -/
theorem kernelDilate_ModelLowKernel_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u s y : ℝ), 0 < s →
      |kernelDilate (ModelLowKernel u) s y| ≤
        C * translationWeight u ^ 10 * bracketKernelAt s 0 y := by
  rcases ModelLowKernel_translate_bracket_majorant with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u s y hs
  have hbase := hbound u (y / s)
  have hsinv : 0 ≤ s⁻¹ := (inv_pos.mpr hs).le
  unfold kernelDilate bracketKernelAt kernelAt kernelDilate
  simp only [sub_zero, smul_eq_mul]
  rw [abs_mul, abs_of_nonneg hsinv]
  calc
    s⁻¹ * |ModelLowKernel u (y / s)| ≤
        s⁻¹ * (C * translationWeight u ^ 10 * bracketKernel (y / s)) :=
      mul_le_mul_of_nonneg_left hbase hsinv
    _ = C * translationWeight u ^ 10 * (s⁻¹ * bracketKernel (y / s)) := by ring

/-- The first Gaussian-derivative/annular-kernel convolution has twentieth
order decay, leaving one order-ten weighted integral for the second
convolution in the third model kernel. -/
theorem annular_convolution_polynomial_decay_twenty :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      (1 + |x|) ^ 20 *
        |(gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal) x| ≤ C := by
  rcases gaussianDeriv_polynomial_decay 20 with ⟨Ch, hCh, hh⟩
  rcases conePsiPhysicalReal_decay 30 with ⟨Cpsi, hCpsi, hpsi⟩
  have hpsiweighted : Integrable (fun y : ℝ ↦
      (1 + |y|) ^ 20 * |conePsiPhysicalReal y|) :=
    integrable_weighted_abs_of_decay 20 conePsiPhysicalReal
      conePsiPhysicalReal.continuous.aestronglyMeasurable hpsi
  have hconv := convolution_decay_of_weighted_bound 20
    gaussianDeriv conePsiPhysicalReal continuous_gaussianDeriv.measurable
    conePsiPhysicalReal.continuous.measurable conePsiPhysicalReal.integrable
    hpsiweighted hh
  let C : ℝ := Ch * ∫ y : ℝ, (1 + |y|) ^ 20 * |conePsiPhysicalReal y|
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg hCh (integral_nonneg fun y ↦ by positivity)
  refine ⟨C, hC, ?_⟩
  intro x
  exact hconv x

/-- The first annular convolution has finite tenth weighted absolute mass. -/
theorem integrable_weighted_annular_convolution :
    Integrable (fun x : ℝ ↦ (1 + |x|) ^ 10 *
      |(gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal) x|) := by
  rcases annular_convolution_polynomial_decay_twenty with ⟨C, hC, hbound⟩
  have hconv : Integrable
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal) :=
    integrable_gaussianDeriv.integrable_convolution (ContinuousLinearMap.mul ℝ ℝ)
      conePsiPhysicalReal.integrable
  apply integrable_weighted_abs_of_decay 10
    (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal)
    hconv.aestronglyMeasurable
  intro x
  apply (le_div_iff₀ (pow_pos (by positivity) 20)).mpr
  simpa [mul_comm] using hbound x

/-- The translation-free physical third kernel has order-ten decay. -/
theorem third_convolution_polynomial_decay :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      (1 + |x|) ^ 10 *
        |(gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal)) x| ≤ C := by
  rcases gaussianDeriv_polynomial_decay 10 with ⟨Ch, hCh, hh⟩
  have hinner : Integrable
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal) :=
    integrable_gaussianDeriv.integrable_convolution (ContinuousLinearMap.mul ℝ ℝ)
      conePsiPhysicalReal.integrable
  have hinnermeas : Measurable
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal) := by
    rcases gaussianDeriv_polynomial_decay 0 with ⟨B, hB, hBbound⟩
    have hbounded : BddAbove (Set.range fun x : ℝ ↦ ‖gaussianDeriv x‖) := by
      refine ⟨B, ?_⟩
      rintro _ ⟨x, rfl⟩
      simpa only [Real.norm_eq_abs, pow_zero, one_mul] using hBbound x
    exact (hbounded.continuous_convolution_left_of_integrable
      (ContinuousLinearMap.mul ℝ ℝ) continuous_gaussianDeriv
      conePsiPhysicalReal.integrable).measurable
  have hconv := convolution_decay_of_weighted_bound 10 gaussianDeriv
    (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal)
    continuous_gaussianDeriv.measurable hinnermeas
    hinner integrable_weighted_annular_convolution hh
  let C : ℝ := Ch * ∫ y : ℝ, (1 + |y|) ^ 10 *
    |(gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal) y|
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg hCh (integral_nonneg fun y ↦ by positivity)
  refine ⟨C, hC, ?_⟩
  intro x
  exact hconv x

/-- The literal third model kernel is a translation of the fixed double
Gaussian-derivative/annular convolution. -/
theorem ModelThirdKernel_translate_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u w : ℝ),
      |ModelThirdKernel u w| ≤
        C * translationWeight u ^ 10 * bracketKernel w := by
  rcases third_convolution_polynomial_decay with ⟨C, hC, hdecay⟩
  let K : ℝ → ℝ := gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
    (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal)
  rcases kernelAt_translate_bracket_of_polynomial_decay K
    ⟨C, hC, by simpa only [K] using hdecay⟩ with ⟨D, hD, htranslate⟩
  refine ⟨D, hD, ?_⟩
  intro u w
  have hEq : ModelThirdKernel u w = kernelAt K 1 u w := by
    dsimp only [K]
    unfold kernelAt kernelDilate
    simp only [inv_one, one_smul]
    rw [convolution_mul]
    unfold ModelThirdKernel
    apply integral_congr_ae
    filter_upwards [] with z
    rw [modelThirdKernel_unit_eq_convolution u (w - z)]
    congr 1
    ring
  rw [hEq]
  exact htranslate u w

/-- The dilated third model kernel obeys the same translated bracket
majorant as the low kernels. -/
theorem kernelDilate_ModelThirdKernel_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u s y : ℝ), 0 < s →
      |kernelDilate (ModelThirdKernel u) s y| ≤
        C * translationWeight u ^ 10 * bracketKernelAt s 0 y := by
  rcases ModelThirdKernel_translate_bracket_majorant with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u s y hs
  have hbase := hbound u (y / s)
  have hsinv : 0 ≤ s⁻¹ := (inv_pos.mpr hs).le
  unfold kernelDilate bracketKernelAt kernelAt kernelDilate
  simp only [sub_zero, smul_eq_mul]
  rw [abs_mul, abs_of_nonneg hsinv]
  calc
    s⁻¹ * |ModelThirdKernel u (y / s)| ≤
        s⁻¹ * (C * translationWeight u ^ 10 * bracketKernel (y / s)) :=
      mul_le_mul_of_nonneg_left hbase hsinv
    _ = C * translationWeight u ^ 10 * (s⁻¹ * bracketKernel (y / s)) := by ring

/-- Every scalar coordinate translation is controlled by the source weight
of the full translation vector. -/
theorem translationWeight_coordinate_le_sourceWeight
    (u : E3) (j : Fin 3) :
    translationWeight (u j) ≤ sourceWeight u := by
  fin_cases j <;> simp only [translationWeight, sourceWeight, Fin.reduceFinMk] <;>
    nlinarith [abs_nonneg (u 0), abs_nonneg (u 1), abs_nonneg (u 2)]

/-- The low coordinate kernels have the literal `U(u)^10` fiber majorant. -/
theorem kernelDilate_ModelLowKernel_sourceWeight_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (j : Fin 3) (s y : ℝ), 0 < s →
      |kernelDilate (ModelLowKernel (u j)) s y| ≤
        C * sourceWeight u ^ 10 * bracketKernelAt s 0 y := by
  rcases kernelDilate_ModelLowKernel_bracket_majorant with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u j s y hs
  have hcoord := translationWeight_coordinate_le_sourceWeight u j
  have hpow : translationWeight (u j) ^ 10 ≤ sourceWeight u ^ 10 :=
    pow_le_pow_left₀ (by unfold translationWeight; positivity) hcoord 10
  have hbracket : 0 ≤ bracketKernelAt s 0 y := (bracketKernelAt_pos hs).le
  calc
    |kernelDilate (ModelLowKernel (u j)) s y| ≤
        C * translationWeight (u j) ^ 10 * bracketKernelAt s 0 y :=
      hbound (u j) s y hs
    _ = (C * bracketKernelAt s 0 y) * translationWeight (u j) ^ 10 := by ring
    _ ≤ (C * bracketKernelAt s 0 y) * sourceWeight u ^ 10 :=
      mul_le_mul_of_nonneg_left hpow (mul_nonneg hC hbracket)
    _ = C * sourceWeight u ^ 10 * bracketKernelAt s 0 y := by ring

/-- The third coordinate kernel has the literal `U(u)^10` fiber majorant. -/
theorem kernelDilate_ModelThirdKernel_sourceWeight_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (j : Fin 3) (s y : ℝ), 0 < s →
      |kernelDilate (ModelThirdKernel (u j)) s y| ≤
        C * sourceWeight u ^ 10 * bracketKernelAt s 0 y := by
  rcases kernelDilate_ModelThirdKernel_bracket_majorant with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u j s y hs
  have hcoord := translationWeight_coordinate_le_sourceWeight u j
  have hpow : translationWeight (u j) ^ 10 ≤ sourceWeight u ^ 10 :=
    pow_le_pow_left₀ (by unfold translationWeight; positivity) hcoord 10
  have hbracket : 0 ≤ bracketKernelAt s 0 y := (bracketKernelAt_pos hs).le
  calc
    |kernelDilate (ModelThirdKernel (u j)) s y| ≤
        C * translationWeight (u j) ^ 10 * bracketKernelAt s 0 y :=
      hbound (u j) s y hs
    _ = (C * bracketKernelAt s 0 y) * translationWeight (u j) ^ 10 := by ring
    _ ≤ (C * bracketKernelAt s 0 y) * sourceWeight u ^ 10 :=
      mul_le_mul_of_nonneg_left hpow (mul_nonneg hC hbracket)
    _ = C * sourceWeight u ^ 10 * bracketKernelAt s 0 y := by ring

namespace LiteralComplexInternal

open MeasureTheory Filter
open scoped BigOperators ENNReal NNReal

noncomputable section

/-! ## Section 7: real-to-complex expansion for the model form -/

/-- The real part of a complex Schwartz input remains a real Schwartz input. -/
noncomputable def scratch_realPartSchwartz (f : SchwartzMap E3 ℂ) :
    SchwartzMap E3 ℝ :=
  f.postcompCLM (𝕜 := ℝ) Complex.reCLM

/-- The imaginary part of a complex Schwartz input remains a real Schwartz input. -/
noncomputable def scratch_imagPartSchwartz (f : SchwartzMap E3 ℂ) :
    SchwartzMap E3 ℝ :=
  f.postcompCLM (𝕜 := ℝ) Complex.imCLM

@[simp] theorem scratch_realPartSchwartz_apply (f : SchwartzMap E3 ℂ) (x : E3) :
    scratch_realPartSchwartz f x = (f x).re := by
  rfl

@[simp] theorem scratch_imagPartSchwartz_apply (f : SchwartzMap E3 ℂ) (x : E3) :
    scratch_imagPartSchwartz f x = (f x).im := by
  rfl

/-- Real part recovers a real Schwartz function after its standard
complexification. -/
theorem scratch_realPartSchwartz_complexifyRealSchwartz (f : SchwartzMap E3 ℝ) :
    scratch_realPartSchwartz (complexifyRealSchwartz f) = f := by
  ext x
  simp

/-- Imaginary part vanishes on a standard complexification of real data. -/
theorem scratch_imagPartSchwartz_complexifyRealSchwartz (f : SchwartzMap E3 ℝ) :
    scratch_imagPartSchwartz (complexifyRealSchwartz f) = 0 := by
  ext x
  simp

/-- Taking the real part cannot increase a finite `L^p` norm. -/
theorem scratch_lpNorm_realPartSchwartz_le
    (f : SchwartzMap E3 ℂ) (p : ℝ) :
    lpNorm (scratch_realPartSchwartz f : E3 → ℝ) (ENNReal.ofReal p) volume ≤
      lpNorm (f : E3 → ℂ) (ENNReal.ofReal p) volume := by
  rw [← toReal_eLpNorm
    (scratch_realPartSchwartz f).continuous.aestronglyMeasurable,
    ← toReal_eLpNorm f.continuous.aestronglyMeasurable]
  apply ENNReal.toReal_mono (f.memLp (ENNReal.ofReal p) volume).eLpNorm_ne_top
  apply eLpNorm_mono
  intro x
  change |(f x).re| ≤ ‖f x‖
  exact Complex.abs_re_le_norm _

/-- Taking the imaginary part cannot increase a finite `L^p` norm. -/
theorem scratch_lpNorm_imagPartSchwartz_le
    (f : SchwartzMap E3 ℂ) (p : ℝ) :
    lpNorm (scratch_imagPartSchwartz f : E3 → ℝ) (ENNReal.ofReal p) volume ≤
      lpNorm (f : E3 → ℂ) (ENNReal.ofReal p) volume := by
  rw [← toReal_eLpNorm
    (scratch_imagPartSchwartz f).continuous.aestronglyMeasurable,
    ← toReal_eLpNorm f.continuous.aestronglyMeasurable]
  apply ENNReal.toReal_mono (f.memLp (ENNReal.ofReal p) volume).eLpNorm_ne_top
  apply eLpNorm_mono
  intro x
  change |(f x).im| ≤ ‖f x‖
  exact Complex.abs_im_le_norm _

/-- A complex Schwartz four-tuple for the algebraic complexification of the
real model form. -/
abbrev ScratchModelComplexSchwartzInput := Fin 4 → SchwartzMap E3 ℂ

/-- Select the real or imaginary part of every complex input according to one
of the sixteen terms in the standard multilinear expansion. -/
noncomputable def scratch_complexComponent
    (ε : Fin 4 → Bool) (F : ScratchModelComplexSchwartzInput) :
    ModelSchwartzInput := fun j ↦
  if ε j then scratch_imagPartSchwartz (F j) else scratch_realPartSchwartz (F j)

/-- The coefficient of a real/imaginary component in the standard complex
multilinear expansion. -/
noncomputable def scratch_complexPhase (ε : Fin 4 → Bool) : ℂ :=
  ∏ j : Fin 4, if ε j then Complex.I else 1

/-- The Boolean choice selecting the real part in every coordinate. -/
def scratch_allRealChoices : Fin 4 → Bool := fun _ ↦ false

/-- On a complexification of real data, the all-real choice recovers the
original real tuple. -/
theorem scratch_complexComponent_allRealChoices
    (G : ModelSchwartzInput) :
    scratch_complexComponent scratch_allRealChoices
      (fun j ↦ complexifyRealSchwartz (G j)) = G := by
  funext j
  simp [scratch_complexComponent, scratch_allRealChoices,
    scratch_realPartSchwartz_complexifyRealSchwartz]

/-- Any choice involving an imaginary part has a zero component when the
input tuple is the complexification of real data. -/
theorem scratch_complexComponent_eq_zero_of_choice_true
    (ε : Fin 4 → Bool) (G : ModelSchwartzInput) (j : Fin 4)
    (hε : ε j) :
    scratch_complexComponent ε (fun k ↦ complexifyRealSchwartz (G k)) j = 0 := by
  rw [scratch_complexComponent, if_pos hε]
  exact scratch_imagPartSchwartz_complexifyRealSchwartz (G j)

/-- A Boolean coordinate choice distinct from the all-real selection contains
at least one imaginary component. -/
theorem scratch_exists_choice_true_of_ne_allRealChoices
    (ε : Fin 4 → Bool) (hε : ε ≠ scratch_allRealChoices) :
    ∃ j : Fin 4, ε j := by
  by_contra hnone
  push Not at hnone
  apply hε
  funext j
  exact Bool.eq_false_of_not_eq_true (hnone j)

/-- The algebraic complexification of a real four-linear functional.  When
the functional is four-linear, this is its unique complex multilinear
extension. -/
noncomputable def scratch_fourLinearComplexification
    (L : ModelSchwartzInput → ℝ) (F : ScratchModelComplexSchwartzInput) : ℂ :=
  ∑ ε : Fin 4 → Bool,
    scratch_complexPhase ε * (L (scratch_complexComponent ε F) : ℂ)

/-- The algebraic complexification restricts to the original real functional
on the usual embedding of real Schwartz data, provided a zero input makes the
real functional vanish. -/
theorem scratch_fourLinearComplexification_complexifyRealSchwartz
    (L : ModelSchwartzInput → ℝ)
    (hzero : ∀ (H : ModelSchwartzInput) (j : Fin 4), H j = 0 → L H = 0)
    (G : ModelSchwartzInput) :
    scratch_fourLinearComplexification L
      (fun j ↦ complexifyRealSchwartz (G j)) = (L G : ℂ) := by
  classical
  unfold scratch_fourLinearComplexification
  rw [Finset.sum_eq_single scratch_allRealChoices]
  · rw [scratch_complexComponent_allRealChoices]
    simp [scratch_complexPhase, scratch_allRealChoices]
  · intro ε _ hε
    obtain ⟨j, hj⟩ := scratch_exists_choice_true_of_ne_allRealChoices ε hε
    have hcomponent : scratch_complexComponent ε
        (fun k ↦ complexifyRealSchwartz (G k)) j = 0 :=
      scratch_complexComponent_eq_zero_of_choice_true ε G j hj
    have hLzero : L (scratch_complexComponent ε
        (fun k ↦ complexifyRealSchwartz (G k))) = 0 :=
      hzero _ j hcomponent
    simp [hLzero]
  · intro hnot
    exact (hnot (Finset.mem_univ _)).elim

/-- Each real/imaginary component has no larger `L^p` norm than the original
complex Schwartz input. -/
theorem scratch_lpNorm_complexComponent_le
    (ε : Fin 4 → Bool) (F : ScratchModelComplexSchwartzInput)
    (j : Fin 4) (p : ℝ) :
    lpNorm (scratch_complexComponent ε F j : E3 → ℝ) (ENNReal.ofReal p) volume ≤
      lpNorm (F j : E3 → ℂ) (ENNReal.ofReal p) volume := by
  by_cases hε : ε j
  · rw [scratch_complexComponent, if_pos hε]
    exact scratch_lpNorm_imagPartSchwartz_le (F j) p
  · rw [scratch_complexComponent, if_neg hε]
    exact scratch_lpNorm_realPartSchwartz_le (F j) p

/-- The expansion phases all have unit modulus. -/
theorem scratch_norm_complexPhase (ε : Fin 4 → Bool) :
    ‖scratch_complexPhase ε‖ = 1 := by
  rw [scratch_complexPhase, norm_prod]
  apply Finset.prod_eq_one
  intro j _
  split <;> simp

/-- The real/imaginary expansion has exactly sixteen summands. -/
theorem scratch_sum_sixteen (A : ℝ) : (∑ _ : Fin 4 → Bool, A) = 16 * A := by
  norm_num

/-- Products of the selected real/imaginary component norms are bounded by
the product of the original complex input norms. -/
theorem scratch_prod_lpNorm_complexComponent_le
    (ε : Fin 4 → Bool) (F : ScratchModelComplexSchwartzInput)
    (p : Fin 4 → ℝ) :
    (∏ j : Fin 4,
      lpNorm (scratch_complexComponent ε F j : E3 → ℝ)
        (ENNReal.ofReal (p j)) volume) ≤
      ∏ j : Fin 4, lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
  apply Finset.prod_le_prod
  · intro j _
    exact lpNorm_nonneg
  · intro j _
    exact scratch_lpNorm_complexComponent_le ε F j (p j)

/-- The standard real/imaginary expansion transfers a product `L^p` bound
for a real four-linear functional to its complexification, at the exact cost
of the sixteen expansion terms from Section 7 of the blueprint. -/
theorem scratch_norm_fourLinearComplexification_le
    (L : ModelSchwartzInput → ℝ) (C : ℝ) (hC : 0 ≤ C)
    (p : Fin 4 → ℝ)
    (hL : ∀ G : ModelSchwartzInput,
      |L G| ≤ C * ∏ j : Fin 4,
        lpNorm (G j : E3 → ℝ) (ENNReal.ofReal (p j)) volume)
    (F : ScratchModelComplexSchwartzInput) :
    ‖scratch_fourLinearComplexification L F‖ ≤
      16 * C * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
  unfold scratch_fourLinearComplexification
  calc
    ‖∑ ε : Fin 4 → Bool,
        scratch_complexPhase ε * (L (scratch_complexComponent ε F) : ℂ)‖ ≤
        ∑ ε : Fin 4 → Bool,
          ‖scratch_complexPhase ε * (L (scratch_complexComponent ε F) : ℂ)‖ :=
      norm_sum_le _ _
    _ = ∑ ε : Fin 4 → Bool, |L (scratch_complexComponent ε F)| := by
      apply Finset.sum_congr rfl
      intro ε _
      rw [norm_mul, scratch_norm_complexPhase, one_mul,
        Complex.norm_real, Real.norm_eq_abs]
    _ ≤ ∑ ε : Fin 4 → Bool, C * ∏ j : Fin 4,
        lpNorm (scratch_complexComponent ε F j : E3 → ℝ)
          (ENNReal.ofReal (p j)) volume := by
      apply Finset.sum_le_sum
      intro ε _
      exact hL (scratch_complexComponent ε F)
    _ ≤ ∑ _ε : Fin 4 → Bool, C * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
      apply Finset.sum_le_sum
      intro ε _
      exact mul_le_mul_of_nonneg_left
        (scratch_prod_lpNorm_complexComponent_le ε F p) hC
    _ = 16 * C * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
      rw [scratch_sum_sixteen]
      ring

/-- The canonical complexification of the source full-scale real model form. -/
noncomputable def scratch_ModelFullFormComplexified
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ)
    (F : ScratchModelComplexSchwartzInput) : ℂ :=
  scratch_fourLinearComplexification (ModelFullForm α u c) F

/-- Select the real or imaginary part of a complex scale coefficient. -/
def scratch_complexCoefficientComponent
    (δ : Bool) (c : ℝ → ℂ) : ℝ → ℝ := fun t ↦
  if δ then (c t).im else (c t).re

/-- The coefficient phase in the real/imaginary expansion. -/
def scratch_complexCoefficientPhase (δ : Bool) : ℂ :=
  if δ then Complex.I else 1

/-- Each real/imaginary coefficient component is measurable when the original
complex coefficient is measurable. -/
theorem scratch_complexCoefficientComponent_measurable
    (δ : Bool) (c : ℝ → ℂ) (hc : Measurable c) :
    Measurable (scratch_complexCoefficientComponent δ c) := by
  cases δ
  · change Measurable (Complex.re ∘ c)
    exact Complex.continuous_re.measurable.comp hc
  · change Measurable (Complex.im ∘ c)
    exact Complex.continuous_im.measurable.comp hc

/-- A complex coefficient bounded by one has both real coefficient components
bounded in absolute value by one. -/
theorem scratch_abs_complexCoefficientComponent_le_one
    (δ : Bool) (c : ℝ → ℂ) (hc : ∀ t : ℝ, ‖c t‖ ≤ 1) :
    ∀ t : ℝ, |scratch_complexCoefficientComponent δ c t| ≤ 1 := by
  intro t
  cases δ
  · change |(c t).re| ≤ 1
    exact (Complex.abs_re_le_norm _).trans (hc t)
  · change |(c t).im| ≤ 1
    exact (Complex.abs_im_le_norm _).trans (hc t)

/-- Coefficient expansion phases have unit modulus. -/
theorem scratch_norm_complexCoefficientPhase (δ : Bool) :
    ‖scratch_complexCoefficientPhase δ‖ = 1 := by
  by_cases hδ : δ <;> simp [scratch_complexCoefficientPhase, hδ]

/-- The algebraic complexification of the model form in its scale coefficient
as well as in its four inputs.  This is the literal `2^5` expansion used in
the complex step of blueprint Section 7. -/
noncomputable def scratch_ModelFullFormComplexCoefficientComplexified
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (F : ScratchModelComplexSchwartzInput) : ℂ :=
  ∑ δ : Bool, scratch_complexCoefficientPhase δ *
    scratch_ModelFullFormComplexified α u
      (scratch_complexCoefficientComponent δ c) F

/-- The real full model form vanishes for the zero scale coefficient. -/
theorem scratch_ModelFullForm_zero_coefficient
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) :
    ModelFullForm α u (0 : ℝ → ℝ) F = 0 := by
  simp [ModelFullForm]

/-- Complexifying a real scale coefficient and then selecting its real part
recovers the coefficient. -/
theorem scratch_complexCoefficientComponent_realEmbedding_false
    (d : ℝ → ℝ) :
    scratch_complexCoefficientComponent false (fun t ↦ (d t : ℂ)) = d := by
  funext t
  simp [scratch_complexCoefficientComponent]

/-- The imaginary component of a complexified real scale coefficient is zero. -/
theorem scratch_complexCoefficientComponent_realEmbedding_true
    (d : ℝ → ℝ) :
    scratch_complexCoefficientComponent true (fun t ↦ (d t : ℂ)) = 0 := by
  funext t
  simp [scratch_complexCoefficientComponent]

/-- The input-complexified model form vanishes for the zero real coefficient. -/
theorem scratch_ModelFullFormComplexified_zero_coefficient
    (α : Anisotropy) (u : E3) (F : ScratchModelComplexSchwartzInput) :
    scratch_ModelFullFormComplexified α u (0 : ℝ → ℝ) F = 0 := by
  unfold scratch_ModelFullFormComplexified scratch_fourLinearComplexification
  apply Finset.sum_eq_zero
  intro ε _
  rw [scratch_ModelFullForm_zero_coefficient]
  simp

/-- The five-variable complexification agrees with the real source model form
when both its coefficient and all four inputs are standard complexifications
of real data. -/
theorem scratch_ModelFullFormComplexCoefficientComplexified_complexifyReal
    (α : Anisotropy) (u : E3) (d : ℝ → ℝ) (G : ModelSchwartzInput) :
    scratch_ModelFullFormComplexCoefficientComplexified α u
      (fun t ↦ (d t : ℂ))
      (fun j ↦ complexifyRealSchwartz (G j)) = (ModelFullForm α u d G : ℂ) := by
  classical
  have hinner : scratch_ModelFullFormComplexified α u d
      (fun j ↦ complexifyRealSchwartz (G j)) = (ModelFullForm α u d G : ℂ) := by
    unfold scratch_ModelFullFormComplexified
    apply scratch_fourLinearComplexification_complexifyRealSchwartz
    intro H j hj
    exact ModelFullForm_eq_zero_of_component_eq_zero α u d H j hj
  unfold scratch_ModelFullFormComplexCoefficientComplexified
  rw [Finset.sum_eq_single false]
  · rw [scratch_complexCoefficientComponent_realEmbedding_false]
    rw [hinner]
    simp [scratch_complexCoefficientPhase]
  · intro δ _ hδ
    cases δ
    · exact (hδ rfl).elim
    · rw [scratch_complexCoefficientComponent_realEmbedding_true]
      rw [scratch_ModelFullFormComplexified_zero_coefficient]
      simp
  · intro hnot
    exact (hnot (Finset.mem_univ _)).elim

/-- The complexified model form agrees with the source real form on real
Schwartz data embedded into the complex Schwartz space. -/
theorem scratch_ModelFullFormComplexified_complexifyRealSchwartz
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (G : ModelSchwartzInput) :
    scratch_ModelFullFormComplexified α u c
      (fun j ↦ complexifyRealSchwartz (G j)) = (ModelFullForm α u c G : ℂ) := by
  unfold scratch_ModelFullFormComplexified
  apply scratch_fourLinearComplexification_complexifyRealSchwartz
  intro H j hj
  exact ModelFullForm_eq_zero_of_component_eq_zero α u c H j hj

/-- A real initial-range product estimate for the source model form transfers
to its complexification with precisely the factor `2^4 = 16` from expanding
the four complex inputs into real and imaginary parts. -/
theorem scratch_norm_ModelFullFormComplexified_le
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ)
    (C : ℝ) (hC : 0 ≤ C) (p : Fin 4 → ℝ)
    (hreal : ∀ G : ModelSchwartzInput,
      |ModelFullForm α u c G| ≤ C * sourceWeight u ^ 75 *
        ∏ j : Fin 4, lpNorm (G j : E3 → ℝ)
          (ENNReal.ofReal (p j)) volume)
    (F : ScratchModelComplexSchwartzInput) :
    ‖scratch_ModelFullFormComplexified α u c F‖ ≤
      16 * C * sourceWeight u ^ 75 * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
  have hsource : 0 ≤ sourceWeight u ^ 75 :=
    pow_nonneg (sourceWeight_nonneg u) _
  have hD : 0 ≤ C * sourceWeight u ^ 75 := mul_nonneg hC hsource
  change ‖scratch_fourLinearComplexification (ModelFullForm α u c) F‖ ≤ _
  calc
    ‖scratch_fourLinearComplexification (ModelFullForm α u c) F‖ ≤
        16 * (C * sourceWeight u ^ 75) * ∏ j : Fin 4,
          lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
      apply scratch_norm_fourLinearComplexification_le
        (L := ModelFullForm α u c) (C := C * sourceWeight u ^ 75) hD p
      intro G
      simpa only [mul_assoc] using hreal G
    _ = 16 * C * sourceWeight u ^ 75 * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
      ring

/-- The same Section 7 complexification bridge at the blueprint's displayed
translation exponent `100`. -/
theorem scratch_norm_ModelFullFormComplexified_le_weight100
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ)
    (C : ℝ) (hC : 0 ≤ C) (p : Fin 4 → ℝ)
    (hreal : ∀ G : ModelSchwartzInput,
      |ModelFullForm α u c G| ≤ C * sourceWeight u ^ 100 *
        ∏ j : Fin 4, lpNorm (G j : E3 → ℝ)
          (ENNReal.ofReal (p j)) volume)
    (F : ScratchModelComplexSchwartzInput) :
    ‖scratch_ModelFullFormComplexified α u c F‖ ≤
      16 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
  have hsource : 0 ≤ sourceWeight u ^ 100 :=
    pow_nonneg (sourceWeight_nonneg u) _
  have hD : 0 ≤ C * sourceWeight u ^ 100 := mul_nonneg hC hsource
  change ‖scratch_fourLinearComplexification (ModelFullForm α u c) F‖ ≤ _
  calc
    ‖scratch_fourLinearComplexification (ModelFullForm α u c) F‖ ≤
        16 * (C * sourceWeight u ^ 100) * ∏ j : Fin 4,
          lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
      apply scratch_norm_fourLinearComplexification_le
        (L := ModelFullForm α u c) (C := C * sourceWeight u ^ 100) hD p
      intro G
      simpa only [mul_assoc] using hreal G
    _ = 16 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
      ring

/-- The real/imaginary expansion of one complex coefficient has two terms. -/
theorem scratch_sum_two (A : ℝ) : (∑ _ : Bool, A) = 2 * A := by
  norm_num

/-- If the real initial estimate is uniform over all measurable real
coefficients bounded by one, it transfers to a complex coefficient and four
complex inputs.  The factor `32 = 2^5` is exactly the coefficient choice
times the four input choices in blueprint Section 7. -/
theorem scratch_norm_ModelFullFormComplexCoefficientComplexified_le_weight100
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (C : ℝ) (hC : 0 ≤ C) (p : Fin 4 → ℝ)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, ‖c t‖ ≤ 1)
    (hreal : ∀ (d : ℝ → ℝ), Measurable d → (∀ t : ℝ, |d t| ≤ 1) →
      ∀ G : ModelSchwartzInput,
        |ModelFullForm α u d G| ≤ C * sourceWeight u ^ 100 *
          ∏ j : Fin 4, lpNorm (G j : E3 → ℝ)
            (ENNReal.ofReal (p j)) volume)
    (F : ScratchModelComplexSchwartzInput) :
    ‖scratch_ModelFullFormComplexCoefficientComplexified α u c F‖ ≤
      32 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
  unfold scratch_ModelFullFormComplexCoefficientComplexified
  calc
    ‖∑ δ : Bool, scratch_complexCoefficientPhase δ *
        scratch_ModelFullFormComplexified α u
          (scratch_complexCoefficientComponent δ c) F‖ ≤
        ∑ δ : Bool, ‖scratch_complexCoefficientPhase δ *
          scratch_ModelFullFormComplexified α u
            (scratch_complexCoefficientComponent δ c) F‖ :=
      norm_sum_le _ _
    _ = ∑ δ : Bool, ‖scratch_ModelFullFormComplexified α u
        (scratch_complexCoefficientComponent δ c) F‖ := by
      apply Finset.sum_congr rfl
      intro δ _
      rw [norm_mul, scratch_norm_complexCoefficientPhase, one_mul]
    _ ≤ ∑ _δ : Bool, 16 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
      apply Finset.sum_le_sum
      intro δ _
      apply scratch_norm_ModelFullFormComplexified_le_weight100
        α u (scratch_complexCoefficientComponent δ c) C hC p
      intro G
      exact hreal (scratch_complexCoefficientComponent δ c)
        (scratch_complexCoefficientComponent_measurable δ c hcmeas)
        (scratch_abs_complexCoefficientComponent_le_one δ c hc) G
    _ = 32 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
      rw [scratch_sum_two]
      ring

/-- The forest construction in the real initial range supplies one constant
for every translation, real unit coefficient, and real Schwartz four-tuple.
This puts the quantifiers in the order needed by the complexification step. -/
theorem scratch_exists_uniform_initialModelFullForm_bound_weight75
    (α : Anisotropy) (q : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (c : ℝ → ℝ)
      (F : InitialModelSchwartzInput),
      Measurable c → (∀ t : ℝ, |c t| ≤ 1) →
      |ModelFullForm α u c F| ≤ C * sourceWeight u ^ 75 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume := by
  rcases exists_uniform_activeStoppingForest_constant α with
    ⟨C₀, hC₀, hforest⟩
  let K : Fin 4 → ℝ := fun _ ↦ dyadicBracketShellConstant
  let D : Fin 4 → ℝ := fun j ↦ sourceStoppingDyadicInputConstant K q j
  let C : ℝ := C₀ * ∑ j : Fin 4, D j
  have hD : ∀ j : Fin 4, 0 ≤ D j := by
    intro j
    dsimp only [D]
    exact sourceStoppingDyadicInputConstant_nonneg K q j (hq j)
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg hC₀ (Finset.sum_nonneg fun j _ ↦ hD j)
  refine ⟨C, hC, ?_⟩
  intro u c F hcmeas hc
  by_cases hzero : ∃ j : Fin 4, F j = 0
  · rcases hzero with ⟨j, hj⟩
    rw [ModelFullForm_eq_zero_of_component_eq_zero α u c F j hj]
    have hprod : 0 ≤ ∏ j : Fin 4,
        lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
      exact Finset.prod_nonneg fun j _ ↦ lpNorm_nonneg
    simpa using (mul_nonneg
      (mul_nonneg hC (pow_nonneg (sourceWeight_nonneg u) 75))
      hprod)
  · have hF : ∀ j : Fin 4, F j ≠ 0 := by
      intro j hj
      exact hzero ⟨j, hj⟩
    apply fourlinear_bound_of_normalized_bound
      (L := ModelFullForm α u c)
      (N := fun j f ↦ lpNorm (f : E3 → ℝ)
        (ENNReal.ofReal (q j)) volume)
      (C := C * sourceWeight u ^ 75)
    · exact ModelFullForm_rescale α u c
    · intro G hGunit
      have hG : ∀ j : Fin 4, G j ≠ 0 := by
        intro j hzero
        have hzeroNorm : lpNorm (G j : E3 → ℝ)
            (ENNReal.ofReal (q j)) volume = 0 := by
          rw [hzero]
          change lpNorm (0 : E3 → ℝ) (ENNReal.ofReal (q j)) volume = 0
          exact lpNorm_zero (ENNReal.ofReal (q j)) volume
        linarith [hGunit j]
      let W : ℝ := ∑ j : Fin 4, D j *
        ∫ x : E3, |G j x| ^ q j
      have hfull : ∀ N : ℕ, Integrable
          (modelFiberFullyExpandedIntegrand α u c (InitialModelRealInput G))
          (((cubeScaleMeasure.restrict
            (Set.univ ×ˢ truncationScaleSet N)).prod
              (volume : Measure ModelE5)).prod
            ((volume : Measure ℝ).prod volume)) := by
        intro N
        exact integrable_modelFiberFullyExpanded_truncationScale
          α u c G N hcmeas hc
      have hdistribution : ∀ M : ℕ,
          SourceStoppingCoordinateEnvelope α (truncationCollection α M)
            (InitialModelRealInput G) q (fun _ ↦ 0)
            (initialModel_sourceStoppingData_all_pos_of_ne_zero
              α (truncationCollection α M) G hG) ≤ W := by
        intro M
        dsimp only [W, D, K]
        exact initialSourceStoppingCoordinateEnvelope_le_explicitInputPowers_of_realSchwartz
          α (truncationCollection α M) G q hq hsum hqs hG
      have hglobal :=
        modelFullForm_bound_of_initial_stoppingEnvelope_of_uniformForest
          α C₀ hC₀ hforest u c G q (fun _ ↦ 0) W hq hG hcmeas hc
          hfull hdistribution
      have hpower (j : Fin 4) :
          (∫ x : E3, |G j x| ^ q j) = 1 :=
        integral_abs_rpow_eq_one_of_lpNorm_eq_one
          (G j : E3 → ℝ) (q j) (hq j)
          (G j).continuous.aestronglyMeasurable (hGunit j)
      have hW : W = ∑ j : Fin 4, D j := by
        dsimp only [W]
        apply Finset.sum_congr rfl
        intro j _
        rw [hpower j, mul_one]
      rw [hW] at hglobal
      change |ModelFullForm α u c G| ≤ C * sourceWeight u ^ 75
      dsimp only [C]
      calc
        |ModelFullForm α u c G| ≤
            C₀ * sourceWeight u ^ 75 * ∑ j : Fin 4, D j := hglobal
        _ = (C₀ * ∑ j : Fin 4, D j) * sourceWeight u ^ 75 := by ring
    · intro j
      exact lpNorm_pos_of_realSchwartz_ne_zero
        (F j) (q j) (hq j) (hF j)
    · intro j
      exact lpNorm_inv_smul_eq_one
        (F j : E3 → ℝ) (q j)
        (lpNorm_pos_of_realSchwartz_ne_zero
          (F j) (q j) (hq j) (hF j))

/-- The same uniform real initial range at the larger translation exponent
displayed in the blueprint. -/
theorem scratch_exists_uniform_initialModelFullForm_bound_weight100
    (α : Anisotropy) (q : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (c : ℝ → ℝ)
      (F : InitialModelSchwartzInput),
      Measurable c → (∀ t : ℝ, |c t| ≤ 1) →
      |ModelFullForm α u c F| ≤ C * sourceWeight u ^ 100 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume := by
  rcases scratch_exists_uniform_initialModelFullForm_bound_weight75
    α q hq hsum hqs with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u c F hcmeas hc
  refine (hbound u c F hcmeas hc).trans ?_
  have hweight : 1 ≤ sourceWeight u := by
    unfold sourceWeight
    linarith [abs_nonneg (u 0), abs_nonneg (u 1), abs_nonneg (u 2)]
  have hpow : sourceWeight u ^ 75 ≤ sourceWeight u ^ 100 :=
    pow_le_pow_right₀ hweight (by norm_num)
  have hprod : 0 ≤ ∏ j : Fin 4,
      lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
    exact Finset.prod_nonneg fun j _ ↦ lpNorm_nonneg
  calc
    C * sourceWeight u ^ 75 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume =
        (C * ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume) * sourceWeight u ^ 75 := by ring
    _ ≤ (C * ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume) * sourceWeight u ^ 100 :=
      mul_le_mul_of_nonneg_left hpow (mul_nonneg hC hprod)
    _ = C * sourceWeight u ^ 100 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume := by ring

/-- The complete strict initial range for the literal algebraic
complexification is uniform over translations, complex unit coefficients, and
complex Schwartz four-tuples. -/
theorem scratch_exists_uniform_ModelFullFormComplexCoefficientComplexified_bound_weight100
    (α : Anisotropy) (q : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (c : ℝ → ℂ)
      (F : ScratchModelComplexSchwartzInput),
      Measurable c → (∀ t : ℝ, ‖c t‖ ≤ 1) →
      ‖scratch_ModelFullFormComplexCoefficientComplexified α u c F‖ ≤
        32 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
          lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (q j)) volume := by
  rcases scratch_exists_uniform_initialModelFullForm_bound_weight100
    α q hq hsum hqs with ⟨C, hC, hreal⟩
  refine ⟨C, hC, ?_⟩
  intro u c F hcmeas hc
  apply scratch_norm_ModelFullFormComplexCoefficientComplexified_le_weight100
    α u c C hC q hcmeas hc
  intro d hdmeas hd G
  exact hreal u d G hdmeas hd

/-! ### Literal complex model form -/

/-- The literal complex version of one coordinate convolution in the source
model.  The kernel remains real-valued and is embedded into `ℂ` in the
integrand. -/
noncomputable def scratch_LiteralModelCoordinateConvolution
    (i : Fin 3) (f : E3 → ℂ) (k : ℝ → ℝ) (s : ℝ) (x : E3) : ℂ :=
  ∫ r : ℝ, f (x - r • Anisotropy.coordinateDirection i) *
    ((kernelDilate k s r : ℝ) : ℂ)

/-- On real data, the literal complex coordinate convolution is exactly the
standard complex embedding of the source real convolution. -/
theorem scratch_LiteralModelCoordinateConvolution_complexifyRealSchwartz
    (i : Fin 3) (f : SchwartzMap E3 ℝ) (k : ℝ → ℝ) (s : ℝ) (x : E3) :
    scratch_LiteralModelCoordinateConvolution i (complexifyRealSchwartz f) k s x =
      (ModelCoordinateConvolution i f k s x : ℂ) := by
  unfold scratch_LiteralModelCoordinateConvolution ModelCoordinateConvolution
  rw [← integral_complex_ofReal]
  apply integral_congr_ae
  filter_upwards [] with r
  rw [complexifyRealSchwartz_apply]
  norm_cast

/-- The literal complex spatial integrand, with precisely the three source
coordinate convolutions and the original association of the four factors. -/
noncomputable def scratch_LiteralModelSpatialIntegrand
    (α : Anisotropy) (u : E3) (F : ScratchModelComplexSchwartzInput)
    (t : ℝ) (x : E3) : ℂ :=
  F 0 x *
    scratch_LiteralModelCoordinateConvolution 0 (F 1)
      (ModelLowKernel (u 0)) (t ^ α.weight 0) x *
    scratch_LiteralModelCoordinateConvolution 1 (F 2)
      (ModelLowKernel (u 1)) (t ^ α.weight 1) x *
    scratch_LiteralModelCoordinateConvolution 2 (F 3)
      (ModelThirdKernel (u 2)) (t ^ α.weight 2) x

/-- The literal complex spatial profile, before integration in scale. -/
noncomputable def scratch_LiteralModelSpatialProfile
    (α : Anisotropy) (u : E3) (F : ScratchModelComplexSchwartzInput)
    (t : ℝ) : ℂ :=
  ∫ x : E3, scratch_LiteralModelSpatialIntegrand α u F t x

/-- The literal complex-valued full model form: complex coefficient and four
complex inputs, with the exact source convolution and two integrations. -/
noncomputable def scratch_LiteralModelFullForm
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (F : ScratchModelComplexSchwartzInput) : ℂ :=
  ∫ t in Set.Ioi (0 : ℝ), c t * scratch_LiteralModelSpatialProfile α u F t
    ∂((volume : Measure ℝ).withDensity cubeScaleDensity)

/-- The literal complex spatial integrand reduces pointwise to the source
real integrand on real embedded Schwartz data. -/
theorem scratch_LiteralModelSpatialIntegrand_complexifyRealSchwartz
    (α : Anisotropy) (u : E3) (G : ModelSchwartzInput)
    (t : ℝ) (x : E3) :
    scratch_LiteralModelSpatialIntegrand α u
      (fun j ↦ complexifyRealSchwartz (G j)) t x =
        (ModelSpatialIntegrand α u G t x : ℂ) := by
  unfold scratch_LiteralModelSpatialIntegrand ModelSpatialIntegrand
  rw [scratch_LiteralModelCoordinateConvolution_complexifyRealSchwartz,
    scratch_LiteralModelCoordinateConvolution_complexifyRealSchwartz,
    scratch_LiteralModelCoordinateConvolution_complexifyRealSchwartz]
  simp only [complexifyRealSchwartz_apply]
  norm_cast

/-- The literal complex spatial profile reduces to the complex embedding of
the real profile on real embedded data. -/
theorem scratch_LiteralModelSpatialProfile_complexifyRealSchwartz
    (α : Anisotropy) (u : E3) (G : ModelSchwartzInput) (t : ℝ) :
    scratch_LiteralModelSpatialProfile α u
      (fun j ↦ complexifyRealSchwartz (G j)) t =
        (ModelSpatialProfile α u G t : ℂ) := by
  unfold scratch_LiteralModelSpatialProfile ModelSpatialProfile
  calc
    ∫ x : E3, scratch_LiteralModelSpatialIntegrand α u
        (fun j ↦ complexifyRealSchwartz (G j)) t x =
        ∫ x : E3, (ModelSpatialIntegrand α u G t x : ℂ) := by
          apply integral_congr_ae
          filter_upwards [] with x
          exact scratch_LiteralModelSpatialIntegrand_complexifyRealSchwartz α u G t x
    _ = (∫ x : E3, ModelSpatialIntegrand α u G t x : ℝ) :=
      integral_complex_ofReal

/-- The literal complex full form reduces to the complex embedding of the
source real form on a real coefficient and real embedded inputs. -/
theorem scratch_LiteralModelFullForm_complexifyRealSchwartz
    (α : Anisotropy) (u : E3) (d : ℝ → ℝ) (G : ModelSchwartzInput) :
    scratch_LiteralModelFullForm α u (fun t ↦ (d t : ℂ))
      (fun j ↦ complexifyRealSchwartz (G j)) =
        (ModelFullForm α u d G : ℂ) := by
  unfold scratch_LiteralModelFullForm ModelFullForm
  calc
    ∫ t in Set.Ioi (0 : ℝ), (d t : ℂ) *
        scratch_LiteralModelSpatialProfile α u
          (fun j ↦ complexifyRealSchwartz (G j)) t
        ∂((volume : Measure ℝ).withDensity cubeScaleDensity) =
        ∫ t in Set.Ioi (0 : ℝ),
          ((d t * ModelSpatialProfile α u G t : ℝ) : ℂ)
          ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
          apply integral_congr_ae
          filter_upwards [] with t
          rw [scratch_LiteralModelSpatialProfile_complexifyRealSchwartz]
          norm_cast
    _ = ((∫ t in Set.Ioi (0 : ℝ), d t * ModelSpatialProfile α u G t
          ∂((volume : Measure ℝ).withDensity cubeScaleDensity) : ℝ) : ℂ) :=
      integral_complex_ofReal

/-- One of the two scalar phases occurring in a single input expansion. -/
def scratch_inputPhase (b : Bool) : ℂ := if b then Complex.I else 1

/-- Select one real component of a single complex Schwartz input. -/
noncomputable def scratch_complexInputComponent
    (b : Bool) (f : SchwartzMap E3 ℂ) : SchwartzMap E3 ℝ :=
  if b then scratch_imagPartSchwartz f else scratch_realPartSchwartz f

@[simp] theorem scratch_complexInputComponent_apply
    (b : Bool) (f : SchwartzMap E3 ℂ) (x : E3) :
    scratch_complexInputComponent b f x =
      if b then (f x).im else (f x).re := by
  cases b <;> rfl

/-- The tuple component selector is the slotwise version of the single-input
component selector. -/
theorem scratch_complexComponent_eq_complexInputComponent
    (ε : Fin 4 → Bool) (F : ScratchModelComplexSchwartzInput) (j : Fin 4) :
    scratch_complexComponent ε F j =
      scratch_complexInputComponent (ε j) (F j) := by
  unfold scratch_complexComponent scratch_complexInputComponent
  split <;> rfl

/-- The real integrand of a coordinate convolution is integrable at a
positive scale for every real Schwartz input and integrable real kernel. -/
theorem scratch_integrable_coordinate_integrand
    (i : Fin 3) (f : SchwartzMap E3 ℝ) (k : ℝ → ℝ) (s : ℝ) (x : E3)
    (hk : Integrable k) (hs : 0 < s) :
    Integrable (fun r : ℝ ↦
      f (x - r • Anisotropy.coordinateDirection i) * kernelDilate k s r) := by
  let B : ℝ := SchwartzMap.seminorm ℝ 0 0 f
  have hbound (y : E3) : |f y| ≤ B := by
    simpa only [B, Real.norm_eq_abs] using
      SchwartzMap.norm_le_seminorm ℝ f y
  have hmap : Continuous (fun r : ℝ ↦ x - r • Anisotropy.coordinateDirection i) :=
    continuous_const.sub (continuous_id.smul continuous_const)
  have hkd : Integrable (fun r : ℝ ↦ kernelDilate k s r) :=
    integrable_kernelDilate hk hs.ne'
  have hmeas : AEStronglyMeasurable (fun r : ℝ ↦
      f (x - r • Anisotropy.coordinateDirection i) * kernelDilate k s r) volume :=
    (f.continuous.comp hmap).aestronglyMeasurable.mul hkd.aestronglyMeasurable
  have hupper : Integrable (fun r : ℝ ↦ B * |kernelDilate k s r|) :=
    (integrable_abs_kernelDilate k hk hs).const_mul B
  apply hupper.mono' hmeas
  filter_upwards [] with r
  change |f (x - r • Anisotropy.coordinateDirection i) * kernelDilate k s r| ≤
    B * |kernelDilate k s r|
  rw [abs_mul]
  exact mul_le_mul_of_nonneg_right (hbound _) (abs_nonneg _)

/-- Pointwise real/imaginary expansion of the literal complex coordinate
integrand. -/
theorem scratch_LiteralModelCoordinateIntegrand_expand
    (f : SchwartzMap E3 ℂ) (y : E3) (k : ℝ) :
    f y * (k : ℂ) = ∑ b : Bool, scratch_inputPhase b *
      ((scratch_complexInputComponent b f y * k : ℝ) : ℂ) := by
  rw [Fintype.sum_bool]
  simp only [scratch_inputPhase, scratch_complexInputComponent_apply]
  simp
  calc
    f y * (k : ℂ) = ((f y).re : ℂ) * (k : ℂ) +
        ((f y).im : ℂ) * Complex.I * (k : ℂ) := by
      calc
        f y * (k : ℂ) = (((f y).re : ℂ) +
            ((f y).im : ℂ) * Complex.I) * (k : ℂ) := by
              rw [Complex.re_add_im]
        _ = _ := by ring
    _ = Complex.I * ((f y).im : ℂ) * (k : ℂ) +
        ((f y).re : ℂ) * (k : ℂ) := by ring
  all_goals rw [mul_assoc]

/-- At every positive scale, the literal complex coordinate convolution is
the two-term real/imaginary expansion of the source real convolution. -/
theorem scratch_LiteralModelCoordinateConvolution_expand
    (i : Fin 3) (f : SchwartzMap E3 ℂ) (k : ℝ → ℝ) (s : ℝ) (x : E3)
    (hk : Integrable k) (hs : 0 < s) :
    scratch_LiteralModelCoordinateConvolution i f k s x =
      ∑ b : Bool, scratch_inputPhase b *
        (ModelCoordinateConvolution i (scratch_complexInputComponent b f) k s x : ℂ) := by
  unfold scratch_LiteralModelCoordinateConvolution ModelCoordinateConvolution
  calc
    (∫ r : ℝ, f (x - r • Anisotropy.coordinateDirection i) *
        ((kernelDilate k s r : ℝ) : ℂ)) =
        ∫ r : ℝ, ∑ b : Bool, scratch_inputPhase b *
          ((scratch_complexInputComponent b f
            (x - r • Anisotropy.coordinateDirection i) *
              kernelDilate k s r : ℝ) : ℂ) := by
          apply integral_congr_ae
          filter_upwards [] with r
          exact scratch_LiteralModelCoordinateIntegrand_expand f
            (x - r • Anisotropy.coordinateDirection i) (kernelDilate k s r)
    _ = ∑ b : Bool, ∫ r : ℝ, scratch_inputPhase b *
        ((scratch_complexInputComponent b f
          (x - r • Anisotropy.coordinateDirection i) *
            kernelDilate k s r : ℝ) : ℂ) := by
          simpa using (integral_finsetSum (μ := volume) (s := Finset.univ)
            (f := fun b r ↦ scratch_inputPhase b *
              ((scratch_complexInputComponent b f
                (x - r • Anisotropy.coordinateDirection i) *
                  kernelDilate k s r : ℝ) : ℂ)) (by
                intro b _
                exact ((scratch_integrable_coordinate_integrand
                  i (scratch_complexInputComponent b f) k s x hk hs).ofReal).const_mul
                    (scratch_inputPhase b)))
    _ = ∑ b : Bool, scratch_inputPhase b *
        (∫ r : ℝ, scratch_complexInputComponent b f
          (x - r • Anisotropy.coordinateDirection i) *
            kernelDilate k s r : ℝ) := by
          apply Finset.sum_congr rfl
          intro b _
          rw [integral_const_mul, integral_complex_ofReal]

/-- A product of four binary expansions is the expected sum over the sixteen
choices of real or imaginary part. -/
theorem scratch_prod_binary_expansion
    (z : Fin 4 → ℂ) (r : Bool → Fin 4 → ℂ)
    (hz : ∀ j, z j = ∑ b : Bool, scratch_inputPhase b * r b j) :
    (∏ j : Fin 4, z j) = ∑ ε : Fin 4 → Bool,
      scratch_complexPhase ε * ∏ j : Fin 4, r (ε j) j := by
  calc
    (∏ j : Fin 4, z j) = ∏ j : Fin 4,
        ∑ b : Bool, scratch_inputPhase b * r b j := by
          apply Finset.prod_congr rfl
          intro j _
          exact hz j
    _ = ∑ ε : Fin 4 → Bool,
        ∏ j : Fin 4, scratch_inputPhase (ε j) * r (ε j) j :=
      Fintype.prod_sum _
    _ = ∑ ε : Fin 4 → Bool, scratch_complexPhase ε *
        ∏ j : Fin 4, r (ε j) j := by
      apply Finset.sum_congr rfl
      intro ε _
      rw [Finset.prod_mul_distrib]
      rfl

/-- The four complex factors whose product is the literal complex spatial
integrand, listed in source input order. -/
noncomputable def scratch_LiteralModelSpatialFactors
    (α : Anisotropy) (u : E3) (F : ScratchModelComplexSchwartzInput)
    (t : ℝ) (x : E3) : Fin 4 → ℂ :=
  ![F 0 x,
    scratch_LiteralModelCoordinateConvolution 0 (F 1)
      (ModelLowKernel (u 0)) (t ^ α.weight 0) x,
    scratch_LiteralModelCoordinateConvolution 1 (F 2)
      (ModelLowKernel (u 1)) (t ^ α.weight 1) x,
    scratch_LiteralModelCoordinateConvolution 2 (F 3)
      (ModelThirdKernel (u 2)) (t ^ α.weight 2) x]

/-- The two real factor choices at each of the four source input slots. -/
noncomputable def scratch_ModelSpatialBinaryFactors
    (α : Anisotropy) (u : E3) (F : ScratchModelComplexSchwartzInput)
    (t : ℝ) (x : E3) (b : Bool) : Fin 4 → ℂ :=
  ![(scratch_complexInputComponent b (F 0) x : ℂ),
    (ModelCoordinateConvolution 0 (scratch_complexInputComponent b (F 1))
      (ModelLowKernel (u 0)) (t ^ α.weight 0) x : ℂ),
    (ModelCoordinateConvolution 1 (scratch_complexInputComponent b (F 2))
      (ModelLowKernel (u 1)) (t ^ α.weight 1) x : ℂ),
    (ModelCoordinateConvolution 2 (scratch_complexInputComponent b (F 3))
      (ModelThirdKernel (u 2)) (t ^ α.weight 2) x : ℂ)]

/-- Reassociation identifies the literal spatial integrand with the product
of its four source-ordered factors. -/
theorem scratch_LiteralModelSpatialIntegrand_eq_prod_factors
    (α : Anisotropy) (u : E3) (F : ScratchModelComplexSchwartzInput)
    (t : ℝ) (x : E3) :
    scratch_LiteralModelSpatialIntegrand α u F t x =
      ∏ j : Fin 4, scratch_LiteralModelSpatialFactors α u F t x j := by
  simp [scratch_LiteralModelSpatialIntegrand,
    scratch_LiteralModelSpatialFactors, Fin.prod_univ_succ]
  ring

/-- A complex Schwartz value is the two-term expansion of its real and
imaginary components. -/
theorem scratch_complexInput_expand
    (f : SchwartzMap E3 ℂ) (x : E3) :
    f x = ∑ b : Bool, scratch_inputPhase b *
      (scratch_complexInputComponent b f x : ℂ) := by
  rw [Fintype.sum_bool]
  simp only [scratch_inputPhase, scratch_complexInputComponent_apply]
  simp
  calc
    f x = ((f x).re : ℂ) + ((f x).im : ℂ) * Complex.I :=
      (Complex.re_add_im _).symm
    _ = Complex.I * ((f x).im : ℂ) + ((f x).re : ℂ) := by ring

/-- Each factor of the literal spatial integrand has its appropriate binary
real/imaginary expansion at positive scales. -/
theorem scratch_LiteralModelSpatialFactors_expand
    (α : Anisotropy) (u : E3) (F : ScratchModelComplexSchwartzInput)
    (t : ℝ) (x : E3) (ht : 0 < t) (j : Fin 4) :
    scratch_LiteralModelSpatialFactors α u F t x j =
      ∑ b : Bool, scratch_inputPhase b *
        scratch_ModelSpatialBinaryFactors α u F t x b j := by
  have hs0 : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs1 : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs2 : 0 < t ^ α.weight 2 := pow_pos ht _
  fin_cases j
  · simpa [scratch_LiteralModelSpatialFactors,
      scratch_ModelSpatialBinaryFactors] using scratch_complexInput_expand (F 0) x
  · simpa [scratch_LiteralModelSpatialFactors,
      scratch_ModelSpatialBinaryFactors] using
      scratch_LiteralModelCoordinateConvolution_expand 0 (F 1)
        (ModelLowKernel (u 0)) (t ^ α.weight 0) x
        (integrable_ModelLowKernel (u 0)) hs0
  · simpa [scratch_LiteralModelSpatialFactors,
      scratch_ModelSpatialBinaryFactors] using
      scratch_LiteralModelCoordinateConvolution_expand 1 (F 2)
        (ModelLowKernel (u 1)) (t ^ α.weight 1) x
        (integrable_ModelLowKernel (u 1)) hs1
  · simpa [scratch_LiteralModelSpatialFactors,
      scratch_ModelSpatialBinaryFactors] using
      scratch_LiteralModelCoordinateConvolution_expand 2 (F 3)
        (ModelThirdKernel (u 2)) (t ^ α.weight 2) x
        (integrable_ModelThirdKernel (u 2)) hs2

/-- The product of the selected real factors is exactly the real source
spatial integrand for the corresponding four-input component choice. -/
theorem scratch_ModelSpatialBinaryFactors_prod_eq_component
    (α : Anisotropy) (u : E3) (F : ScratchModelComplexSchwartzInput)
    (t : ℝ) (x : E3) (ε : Fin 4 → Bool) :
    (∏ j : Fin 4, scratch_ModelSpatialBinaryFactors α u F t x (ε j) j) =
      (ModelSpatialIntegrand α u (scratch_complexComponent ε F) t x : ℂ) := by
  have h0 := scratch_complexComponent_eq_complexInputComponent ε F 0
  have h1 := scratch_complexComponent_eq_complexInputComponent ε F 1
  have h2 := scratch_complexComponent_eq_complexInputComponent ε F 2
  have h3 := scratch_complexComponent_eq_complexInputComponent ε F 3
  unfold ModelSpatialIntegrand
  rw [h0, h1, h2, h3]
  rw [Fin.prod_univ_four]
  simp [scratch_ModelSpatialBinaryFactors]
  split <;> norm_cast

/-- At every positive scale, the literal complex spatial integrand is the
sixteen-term source real/imaginary expansion. -/
theorem scratch_LiteralModelSpatialIntegrand_expand
    (α : Anisotropy) (u : E3) (F : ScratchModelComplexSchwartzInput)
    (t : ℝ) (x : E3) (ht : 0 < t) :
    scratch_LiteralModelSpatialIntegrand α u F t x =
      ∑ ε : Fin 4 → Bool, scratch_complexPhase ε *
        (ModelSpatialIntegrand α u (scratch_complexComponent ε F) t x : ℂ) := by
  rw [scratch_LiteralModelSpatialIntegrand_eq_prod_factors]
  rw [scratch_prod_binary_expansion]
  · apply Finset.sum_congr rfl
    intro ε _
    rw [scratch_ModelSpatialBinaryFactors_prod_eq_component]
  · exact scratch_LiteralModelSpatialFactors_expand α u F t x ht

/-- The real source spatial integrand is integrable at every positive scale
for a real Schwartz four-tuple.  This localizes the integrability needed to
pass the sixteen-term expansion through the spatial integral. -/
theorem scratch_integrable_ModelSpatialIntegrand
    (α : Anisotropy) (u : E3) (G : ModelSchwartzInput) (t : ℝ) (ht : 0 < t) :
    Integrable (fun x : E3 ↦ ModelSpatialIntegrand α u G t x) := by
  let B1 : ℝ := SchwartzMap.seminorm ℝ 0 0 (G 1)
  let B2 : ℝ := SchwartzMap.seminorm ℝ 0 0 (G 2)
  let B3 : ℝ := SchwartzMap.seminorm ℝ 0 0 (G 3)
  have hB1 : 0 ≤ B1 := by
    exact (norm_nonneg ((G 1) 0)).trans
      (SchwartzMap.norm_le_seminorm ℝ (G 1) (0 : E3))
  have hB2 : 0 ≤ B2 := by
    exact (norm_nonneg ((G 2) 0)).trans
      (SchwartzMap.norm_le_seminorm ℝ (G 2) (0 : E3))
  have hB3 : 0 ≤ B3 := by
    exact (norm_nonneg ((G 3) 0)).trans
      (SchwartzMap.norm_le_seminorm ℝ (G 3) (0 : E3))
  have hG1 (x : E3) : |G 1 x| ≤ B1 := by
    simpa only [B1, Real.norm_eq_abs] using
      SchwartzMap.norm_le_seminorm ℝ (G 1) x
  have hG2 (x : E3) : |G 2 x| ≤ B2 := by
    simpa only [B2, Real.norm_eq_abs] using
      SchwartzMap.norm_le_seminorm ℝ (G 2) x
  have hG3 (x : E3) : |G 3 x| ≤ B3 := by
    simpa only [B3, Real.norm_eq_abs] using
      SchwartzMap.norm_le_seminorm ℝ (G 3) x
  have hs0 : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs1 : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs2 : 0 < t ^ α.weight 2 := pow_pos ht _
  let A0 : ℝ := B1 * ∫ r : ℝ, |ModelLowKernel (u 0) r|
  let A1 : ℝ := B2 * ∫ r : ℝ, |ModelLowKernel (u 1) r|
  let A2 : ℝ := B3 * ∫ r : ℝ, |ModelThirdKernel (u 2) r|
  have hA0 : ∀ x : E3,
      |ModelCoordinateConvolution 0 (G 1) (ModelLowKernel (u 0))
        (t ^ α.weight 0) x| ≤ A0 := by
    intro x
    simpa only [A0] using abs_ModelCoordinateConvolution_le
      0 (G 1) (ModelLowKernel (u 0)) (t ^ α.weight 0) x
      (G 1).continuous B1 hG1 (integrable_ModelLowKernel (u 0)) hs0
  have hA1 : ∀ x : E3,
      |ModelCoordinateConvolution 1 (G 2) (ModelLowKernel (u 1))
        (t ^ α.weight 1) x| ≤ A1 := by
    intro x
    simpa only [A1] using abs_ModelCoordinateConvolution_le
      1 (G 2) (ModelLowKernel (u 1)) (t ^ α.weight 1) x
      (G 2).continuous B2 hG2 (integrable_ModelLowKernel (u 1)) hs1
  have hA2 : ∀ x : E3,
      |ModelCoordinateConvolution 2 (G 3) (ModelThirdKernel (u 2))
        (t ^ α.weight 2) x| ≤ A2 := by
    intro x
    simpa only [A2] using abs_ModelCoordinateConvolution_le
      2 (G 3) (ModelThirdKernel (u 2)) (t ^ α.weight 2) x
      (G 3).continuous B3 hG3 (integrable_ModelThirdKernel (u 2)) hs2
  have hA0nonneg : 0 ≤ A0 := by
    dsimp only [A0]
    exact mul_nonneg hB1 (integral_nonneg fun _ ↦ abs_nonneg _)
  have hA1nonneg : 0 ≤ A1 := by
    dsimp only [A1]
    exact mul_nonneg hB2 (integral_nonneg fun _ ↦ abs_nonneg _)
  have hA2nonneg : 0 ≤ A2 := by
    dsimp only [A2]
    exact mul_nonneg hB3 (integral_nonneg fun _ ↦ abs_nonneg _)
  let D : ℝ := A0 * A1 * A2
  have hD : 0 ≤ D := by
    dsimp only [D]
    positivity
  have hG0int : Integrable (fun x : E3 ↦ |G 0 x|) := by
    simpa only [Real.norm_eq_abs] using (G 0).integrable.norm
  have hupper : Integrable (fun x : E3 ↦ D * |G 0 x|) :=
    hG0int.const_mul D
  have hmeas : AEStronglyMeasurable
      (fun x : E3 ↦ ModelSpatialIntegrand α u G t x) volume := by
    exact ((stronglyMeasurable_ModelSpatialIntegrand α u G).comp_measurable
      (measurable_const.prodMk measurable_id)).aestronglyMeasurable
  apply hupper.mono' hmeas
  filter_upwards [] with x
  change ‖ModelSpatialIntegrand α u G t x‖ ≤ D * |G 0 x|
  simpa only [Real.norm_eq_abs] using (show
    |ModelSpatialIntegrand α u G t x| ≤ D * |G 0 x| by
      unfold ModelSpatialIntegrand
      dsimp only [D]
      rw [abs_mul, abs_mul, abs_mul]
      calc
        |G 0 x| *
            |ModelCoordinateConvolution 0 (G 1) (ModelLowKernel (u 0))
                (t ^ α.weight 0) x| *
            |ModelCoordinateConvolution 1 (G 2) (ModelLowKernel (u 1))
                (t ^ α.weight 1) x| *
            |ModelCoordinateConvolution 2 (G 3) (ModelThirdKernel (u 2))
                (t ^ α.weight 2) x| ≤
            |G 0 x| * A0 * A1 * A2 := by
              gcongr
              · exact hA0 x
              · exact hA1 x
              · exact hA2 x
        _ = A0 * A1 * A2 * |G 0 x| := by ring)

/-- At every positive scale, the literal complex spatial profile is the
sixteen-term real/imaginary expansion of the source real profiles. -/
theorem scratch_LiteralModelSpatialProfile_expand
    (α : Anisotropy) (u : E3) (F : ScratchModelComplexSchwartzInput)
    (t : ℝ) (ht : 0 < t) :
    scratch_LiteralModelSpatialProfile α u F t =
      ∑ ε : Fin 4 → Bool, scratch_complexPhase ε *
        (ModelSpatialProfile α u (scratch_complexComponent ε F) t : ℂ) := by
  unfold scratch_LiteralModelSpatialProfile ModelSpatialProfile
  calc
    (∫ x : E3, scratch_LiteralModelSpatialIntegrand α u F t x) =
        ∫ x : E3, ∑ ε : Fin 4 → Bool, scratch_complexPhase ε *
          (ModelSpatialIntegrand α u (scratch_complexComponent ε F) t x : ℂ) := by
          apply integral_congr_ae
          filter_upwards [] with x
          exact scratch_LiteralModelSpatialIntegrand_expand α u F t x ht
    _ = ∑ ε : Fin 4 → Bool, ∫ x : E3, scratch_complexPhase ε *
        (ModelSpatialIntegrand α u (scratch_complexComponent ε F) t x : ℂ) := by
          simpa using (integral_finsetSum (μ := volume) (s := Finset.univ)
            (f := fun ε x ↦ scratch_complexPhase ε *
              (ModelSpatialIntegrand α u (scratch_complexComponent ε F) t x : ℂ)) (by
                intro ε _
                exact ((scratch_integrable_ModelSpatialIntegrand
                  α u (scratch_complexComponent ε F) t ht).ofReal).const_mul
                    (scratch_complexPhase ε)))
    _ = ∑ ε : Fin 4 → Bool, scratch_complexPhase ε *
        (∫ x : E3, ModelSpatialIntegrand α u (scratch_complexComponent ε F) t x : ℝ) := by
          apply Finset.sum_congr rfl
          intro ε _
          rw [integral_const_mul, integral_complex_ofReal]

/-- A complex scale coefficient is the two-term expansion of its real and
imaginary parts. -/
theorem scratch_complexCoefficient_expand
    (c : ℝ → ℂ) (t : ℝ) :
    c t = ∑ δ : Bool, scratch_complexCoefficientPhase δ *
      (scratch_complexCoefficientComponent δ c t : ℂ) := by
  rw [Fintype.sum_bool]
  simp only [scratch_complexCoefficientPhase,
    scratch_complexCoefficientComponent]
  simp
  calc
    c t = ((c t).re : ℂ) + ((c t).im : ℂ) * Complex.I :=
      (Complex.re_add_im _).symm
    _ = Complex.I * ((c t).im : ℂ) + ((c t).re : ℂ) := by ring

/-- Pointwise expansion of the complex scale integrand into the thirty-two
real source integrands. -/
theorem scratch_LiteralModelFullForm_integrand_expand
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (F : ScratchModelComplexSchwartzInput) (t : ℝ) (ht : 0 < t) :
    c t * scratch_LiteralModelSpatialProfile α u F t =
      ∑ δ : Bool, ∑ ε : Fin 4 → Bool,
        scratch_complexCoefficientPhase δ * scratch_complexPhase ε *
          ((scratch_complexCoefficientComponent δ c t *
            ModelSpatialProfile α u (scratch_complexComponent ε F) t : ℝ) : ℂ) := by
  rw [scratch_complexCoefficient_expand c t,
    scratch_LiteralModelSpatialProfile_expand α u F t ht]
  rw [Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro δ _
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro ε _
  rw [Complex.ofReal_mul]
  ring

/-- Each of the thirty-two real source integrands in the literal expansion
is integrable in scale for a measurable complex unit coefficient. -/
theorem scratch_integrable_LiteralModelFullForm_expansionTerm
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (F : ScratchModelComplexSchwartzInput) (δ : Bool) (ε : Fin 4 → Bool)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, ‖c t‖ ≤ 1) :
    Integrable (fun t : ℝ ↦
      scratch_complexCoefficientPhase δ * scratch_complexPhase ε *
        ((scratch_complexCoefficientComponent δ c t *
          ModelSpatialProfile α u (scratch_complexComponent ε F) t : ℝ) : ℂ))
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))) := by
  have hbase := integrableOn_modelScaleProfile_of_realSchwartz
    α u (scratch_complexCoefficientComponent δ c)
      (scratch_complexComponent ε F)
      (scratch_complexCoefficientComponent_measurable δ c hcmeas)
      (scratch_abs_complexCoefficientComponent_le_one δ c hc)
  convert (((hbase.ofReal).const_mul (scratch_complexPhase ε)).const_mul
    (scratch_complexCoefficientPhase δ)) using 1
  ext t
  rw [mul_assoc]
  rfl

/-- Integrating one expansion term recovers the corresponding real source
full form, with its two complex phases left outside the integral. -/
theorem scratch_integral_LiteralModelFullForm_expansionTerm_eq
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (F : ScratchModelComplexSchwartzInput) (δ : Bool) (ε : Fin 4 → Bool) :
    ∫ t in Set.Ioi (0 : ℝ),
      scratch_complexCoefficientPhase δ * scratch_complexPhase ε *
        ((scratch_complexCoefficientComponent δ c t *
          ModelSpatialProfile α u (scratch_complexComponent ε F) t : ℝ) : ℂ)
        ∂((volume : Measure ℝ).withDensity cubeScaleDensity) =
      scratch_complexCoefficientPhase δ * scratch_complexPhase ε *
        (ModelFullForm α u (scratch_complexCoefficientComponent δ c)
          (scratch_complexComponent ε F) : ℂ) := by
  unfold ModelFullForm
  rw [integral_const_mul, integral_complex_ofReal]

/-- Under the source measurability and unit-bound hypotheses, the literal
complex convolution/integral model form is exactly its algebraic thirty-two
term real/imaginary expansion.  Thus the Section 7 triangle estimate applies
to the actual complex model, not merely to an auxiliary extension. -/
theorem scratch_LiteralModelFullForm_eq_complexCoefficientComplexified
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (F : ScratchModelComplexSchwartzInput)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, ‖c t‖ ≤ 1) :
    scratch_LiteralModelFullForm α u c F =
      scratch_ModelFullFormComplexCoefficientComplexified α u c F := by
  let ν : Measure ℝ := (volume : Measure ℝ).withDensity cubeScaleDensity
  let term : Bool → (Fin 4 → Bool) → ℝ → ℂ := fun δ ε t ↦
    scratch_complexCoefficientPhase δ * scratch_complexPhase ε *
      ((scratch_complexCoefficientComponent δ c t *
        ModelSpatialProfile α u (scratch_complexComponent ε F) t : ℝ) : ℂ)
  have hterm (δ : Bool) (ε : Fin 4 → Bool) :
      Integrable (term δ ε) (ν.restrict (Set.Ioi (0 : ℝ))) := by
    dsimp only [term, ν]
    exact scratch_integrable_LiteralModelFullForm_expansionTerm
      α u c F δ ε hcmeas hc
  have hsum (δ : Bool) :
      Integrable (fun t : ℝ ↦ ∑ ε : Fin 4 → Bool, term δ ε t)
        (ν.restrict (Set.Ioi (0 : ℝ))) := by
    apply integrable_finsetSum
    intro ε _
    exact hterm δ ε
  unfold scratch_LiteralModelFullForm
  change (∫ t : ℝ, c t * scratch_LiteralModelSpatialProfile α u F t
      ∂(ν.restrict (Set.Ioi (0 : ℝ)))) =
    scratch_ModelFullFormComplexCoefficientComplexified α u c F
  calc
    (∫ t : ℝ, c t * scratch_LiteralModelSpatialProfile α u F t
      ∂(ν.restrict (Set.Ioi (0 : ℝ)))) =
        ∫ t : ℝ, ∑ δ : Bool, ∑ ε : Fin 4 → Bool, term δ ε t
          ∂(ν.restrict (Set.Ioi (0 : ℝ))) := by
          apply integral_congr_ae
          filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
          dsimp only [term]
          exact scratch_LiteralModelFullForm_integrand_expand α u c F t ht
    _ = ∑ δ : Bool, ∫ t : ℝ, ∑ ε : Fin 4 → Bool, term δ ε t
          ∂(ν.restrict (Set.Ioi (0 : ℝ))) := by
          simpa using (integral_finsetSum
            (μ := ν.restrict (Set.Ioi (0 : ℝ))) (s := Finset.univ)
            (f := fun δ t ↦ ∑ ε : Fin 4 → Bool, term δ ε t) (by
              intro δ _
              exact hsum δ))
    _ = ∑ δ : Bool, ∑ ε : Fin 4 → Bool, ∫ t : ℝ, term δ ε t
          ∂(ν.restrict (Set.Ioi (0 : ℝ))) := by
          apply Finset.sum_congr rfl
          intro δ _
          simpa using (integral_finsetSum
            (μ := ν.restrict (Set.Ioi (0 : ℝ))) (s := Finset.univ)
            (f := fun ε t ↦ term δ ε t) (by
              intro ε _
              exact hterm δ ε))
    _ = ∑ δ : Bool, ∑ ε : Fin 4 → Bool,
        scratch_complexCoefficientPhase δ * scratch_complexPhase ε *
          (ModelFullForm α u (scratch_complexCoefficientComponent δ c)
            (scratch_complexComponent ε F) : ℂ) := by
          apply Finset.sum_congr rfl
          intro δ _
          apply Finset.sum_congr rfl
          intro ε _
          dsimp only [term, ν]
          exact scratch_integral_LiteralModelFullForm_expansionTerm_eq
            α u c F δ ε
    _ = scratch_ModelFullFormComplexCoefficientComplexified α u c F := by
          unfold scratch_ModelFullFormComplexCoefficientComplexified
            scratch_ModelFullFormComplexified scratch_fourLinearComplexification
          apply Finset.sum_congr rfl
          intro δ _
          rw [Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro ε _
          ring

/-- The exact `2^5` Section 7 estimate for the literal complex model form,
obtained by transporting the already-proved algebraic complexification bound
through the literal expansion identity. -/
theorem scratch_norm_LiteralModelFullForm_le_weight100
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (C : ℝ) (hC : 0 ≤ C) (p : Fin 4 → ℝ)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, ‖c t‖ ≤ 1)
    (hreal : ∀ (d : ℝ → ℝ), Measurable d → (∀ t : ℝ, |d t| ≤ 1) →
      ∀ G : ModelSchwartzInput,
        |ModelFullForm α u d G| ≤ C * sourceWeight u ^ 100 *
          ∏ j : Fin 4, lpNorm (G j : E3 → ℝ)
            (ENNReal.ofReal (p j)) volume)
    (F : ScratchModelComplexSchwartzInput) :
    ‖scratch_LiteralModelFullForm α u c F‖ ≤
      32 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
  rw [scratch_LiteralModelFullForm_eq_complexCoefficientComplexified
    α u c F hcmeas hc]
  exact scratch_norm_ModelFullFormComplexCoefficientComplexified_le_weight100
    α u c C hC p hcmeas hc hreal F

/-- The strict initial range for the actual literal complex model form is
uniform in the translation, measurable complex unit coefficient, and complex
Schwartz four-tuple. -/
theorem scratch_exists_uniform_LiteralModelFullForm_bound_weight100
    (α : Anisotropy) (q : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (c : ℝ → ℂ)
      (F : ScratchModelComplexSchwartzInput),
      Measurable c → (∀ t : ℝ, ‖c t‖ ≤ 1) →
      ‖scratch_LiteralModelFullForm α u c F‖ ≤
        32 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
          lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (q j)) volume := by
  rcases scratch_exists_uniform_ModelFullFormComplexCoefficientComplexified_bound_weight100
    α q hq hsum hqs with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u c F hcmeas hc
  rw [scratch_LiteralModelFullForm_eq_complexCoefficientComplexified
    α u c F hcmeas hc]
  exact hbound u c F hcmeas hc

end

end LiteralComplexInternal

/-! ## Section 7 literal complex model bridge -/

/-- Complex Schwartz four-tuples for the literal complex model form. -/
abbrev ModelComplexSchwartzInput :=
  LiteralComplexInternal.ScratchModelComplexSchwartzInput

/-- The literal complex coordinate convolution in the source convention. -/
noncomputable def LiteralModelCoordinateConvolution
    (i : Fin 3) (f : E3 → ℂ) (k : ℝ → ℝ) (s : ℝ) (x : E3) : ℂ :=
  LiteralComplexInternal.scratch_LiteralModelCoordinateConvolution i f k s x

/-- The literal complex source spatial integrand. -/
noncomputable def LiteralModelSpatialIntegrand
    (α : Anisotropy) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (x : E3) : ℂ :=
  LiteralComplexInternal.scratch_LiteralModelSpatialIntegrand α u F t x

/-- The literal complex spatial profile before scale integration. -/
noncomputable def LiteralModelSpatialProfile
    (α : Anisotropy) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) : ℂ :=
  LiteralComplexInternal.scratch_LiteralModelSpatialProfile α u F t

/-- The actual complex model form with the source convolution and both
integrations retained literally. -/
noncomputable def LiteralModelFullForm
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (F : ModelComplexSchwartzInput) : ℂ :=
  LiteralComplexInternal.scratch_LiteralModelFullForm α u c F

/-- The algebraic `2^5` real/imaginary expansion of the real source model
form, for a complex coefficient and four complex inputs. -/
noncomputable def ModelFullFormComplexCoefficientComplexified
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (F : ModelComplexSchwartzInput) : ℂ :=
  LiteralComplexInternal.scratch_ModelFullFormComplexCoefficientComplexified α u c F

/-- The literal complex model form agrees with its exact thirty-two-term
real/imaginary expansion under the source coefficient hypotheses. -/
theorem LiteralModelFullForm_eq_complexCoefficientComplexified
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (F : ModelComplexSchwartzInput)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, ‖c t‖ ≤ 1) :
    LiteralModelFullForm α u c F =
      ModelFullFormComplexCoefficientComplexified α u c F := by
  simpa only [LiteralModelFullForm,
    ModelFullFormComplexCoefficientComplexified] using
    LiteralComplexInternal.scratch_LiteralModelFullForm_eq_complexCoefficientComplexified
      α u c F hcmeas hc

/-- The Section 7 `2^5` estimate for the literal complex model form from a
uniform real product estimate at translation exponent `100`. -/
theorem norm_LiteralModelFullForm_le_weight100
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (C : ℝ) (hC : 0 ≤ C) (p : Fin 4 → ℝ)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, ‖c t‖ ≤ 1)
    (hreal : ∀ (d : ℝ → ℝ), Measurable d → (∀ t : ℝ, |d t| ≤ 1) →
      ∀ G : ModelSchwartzInput,
        |ModelFullForm α u d G| ≤ C * sourceWeight u ^ 100 *
          ∏ j : Fin 4, lpNorm (G j : E3 → ℝ)
            (ENNReal.ofReal (p j)) volume)
    (F : ModelComplexSchwartzInput) :
    ‖LiteralModelFullForm α u c F‖ ≤
      32 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
  simpa only [LiteralModelFullForm] using
    LiteralComplexInternal.scratch_norm_LiteralModelFullForm_le_weight100
      α u c C hC p hcmeas hc hreal F

/-- The strict initial range for the actual literal complex model form,
uniform in translations, complex unit coefficients, and complex Schwartz
four-tuples. -/
theorem exists_uniform_LiteralModelFullForm_bound_weight100
    (α : Anisotropy) (q : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (c : ℝ → ℂ)
      (F : ModelComplexSchwartzInput),
      Measurable c → (∀ t : ℝ, ‖c t‖ ≤ 1) →
      ‖LiteralModelFullForm α u c F‖ ≤
        32 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
          lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (q j)) volume := by
  simpa only [LiteralModelFullForm] using
    LiteralComplexInternal.scratch_exists_uniform_LiteralModelFullForm_bound_weight100
      α q hq hsum hqs

/-! ## Section 7 literal complex active-coordinate bridge -/

namespace LiteralComplexActiveInternal

open MeasureTheory Filter
open scoped BigOperators ENNReal NNReal

noncomputable section

/-- Pull a complex function back along the inverse coordinate relabeling. -/
noncomputable def scratch_complexCoordinatePullback
    (σ : Equiv.Perm (Fin 3)) (f : E3 → ℂ) : E3 → ℂ :=
  fun x ↦ f ((coordinatePermutation σ).symm x)

@[simp] theorem scratch_complexCoordinatePullback_apply
    (σ : Equiv.Perm (Fin 3)) (f : E3 → ℂ) (x : E3) :
    scratch_complexCoordinatePullback σ f x =
      f ((coordinatePermutation σ).symm x) := rfl

/-- Simultaneously relabel the three spatial coordinates and the four complex
source inputs, retaining Schwartz regularity. -/
noncomputable def scratch_complexPermutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelComplexSchwartzInput) :
    ModelComplexSchwartzInput :=
  fun j ↦ (SchwartzMap.compCLMOfContinuousLinearEquiv ℂ
    (coordinatePermutation σ).symm.toContinuousLinearEquiv)
      (F (modelInputIndex σ j))

@[simp] theorem scratch_complexPermutedModelInput_apply
    (σ : Equiv.Perm (Fin 3)) (F : ModelComplexSchwartzInput)
    (j : Fin 4) (x : E3) :
    scratch_complexPermutedModelInput σ F j x =
      F (modelInputIndex σ j) ((coordinatePermutation σ).symm x) := by
  simp [scratch_complexPermutedModelInput,
    SchwartzMap.compCLMOfContinuousLinearEquiv_apply]

/-- The literal complex coordinate convolution commutes with the same
coordinate relabeling as the real model convolution. -/
theorem scratch_LiteralModelCoordinateConvolution_coordinatePermutation
    (σ : Equiv.Perm (Fin 3)) (j : Fin 3)
    (f : E3 → ℂ) (k : ℝ → ℝ) (s : ℝ) (x : E3) :
    LiteralModelCoordinateConvolution j
      (scratch_complexCoordinatePullback σ f) k s
      (coordinatePermutation σ x) =
      LiteralModelCoordinateConvolution (σ j) f k s x := by
  unfold LiteralModelCoordinateConvolution
    LiteralComplexInternal.scratch_LiteralModelCoordinateConvolution
  apply integral_congr_ae
  filter_upwards [] with r
  rw [scratch_complexCoordinatePullback_apply,
    coordinatePermutation_symm_sub_smul_coordinateDirection]

/-- The complex source tuple in a convolved slot is the appropriate complex
coordinate pullback of the source input. -/
theorem scratch_complexPermutedModelInput_succ_asFun
    (σ : Equiv.Perm (Fin 3)) (F : ModelComplexSchwartzInput) (j : Fin 3) :
    (scratch_complexPermutedModelInput σ F j.succ : E3 → ℂ) =
      scratch_complexCoordinatePullback σ (F (σ j).succ : E3 → ℂ) := by
  funext x
  simp [scratch_complexCoordinatePullback]

/-- The distinguished outer complex input is unchanged after evaluating the
relabeled tuple at the correspondingly relabeled spatial point. -/
theorem scratch_complexPermutedModelInput_zero_coordinatePermutation
    (σ : Equiv.Perm (Fin 3)) (F : ModelComplexSchwartzInput) (x : E3) :
    scratch_complexPermutedModelInput σ F 0 (coordinatePermutation σ x) =
      F 0 x := by
  rw [scratch_complexPermutedModelInput_apply]
  simp

/-- The literal complex active-coordinate spatial integrand, retaining all
three source coordinate convolutions. -/
noncomputable def scratch_LiteralActiveModelSpatialIntegrand
    (α : Anisotropy) (i : Fin 3) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (x : E3) : ℂ :=
  F 0 x * ∏ j : Fin 3,
    LiteralModelCoordinateConvolution j (F j.succ)
      (activeModelKernel i j u) (t ^ α.weight j) x

/-- The literal complex active-coordinate spatial profile. -/
noncomputable def scratch_LiteralActiveModelSpatialProfile
    (α : Anisotropy) (i : Fin 3) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) : ℂ :=
  ∫ x : E3, scratch_LiteralActiveModelSpatialIntegrand α i u F t x

/-- The literal complex active-coordinate full form. -/
noncomputable def scratch_LiteralActiveModelFullForm
    (α : Anisotropy) (i : Fin 3) (u : E3) (c : ℝ → ℂ)
    (F : ModelComplexSchwartzInput) : ℂ :=
  ∫ t in Set.Ioi (0 : ℝ), c t *
    scratch_LiteralActiveModelSpatialProfile α i u F t
      ∂((volume : Measure ℝ).withDensity cubeScaleDensity)

/-- At active coordinate three, the literal complex active spatial integrand
is exactly the canonical literal complex spatial integrand. -/
theorem scratch_LiteralActiveModelSpatialIntegrand_two
    (α : Anisotropy) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (x : E3) :
    scratch_LiteralActiveModelSpatialIntegrand α 2 u F t x =
      LiteralModelSpatialIntegrand α u F t x := by
  unfold scratch_LiteralActiveModelSpatialIntegrand
    LiteralModelSpatialIntegrand
    LiteralModelCoordinateConvolution
    LiteralComplexInternal.scratch_LiteralModelSpatialIntegrand
  simp only [Fin.prod_univ_succ]
  simp [activeModelKernel]
  ring

/-- At active coordinate three, the literal complex active full form is the
canonical literal complex full form. -/
theorem scratch_LiteralActiveModelFullForm_two
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (F : ModelComplexSchwartzInput) :
    scratch_LiteralActiveModelFullForm α 2 u c F =
      LiteralModelFullForm α u c F := by
  unfold scratch_LiteralActiveModelFullForm LiteralModelFullForm
    scratch_LiteralActiveModelSpatialProfile
    LiteralComplexInternal.scratch_LiteralModelFullForm
    LiteralComplexInternal.scratch_LiteralModelSpatialProfile
  apply integral_congr_ae
  filter_upwards [] with t
  congr 1
  apply integral_congr_ae
  filter_upwards [] with x
  exact scratch_LiteralActiveModelSpatialIntegrand_two α u F t x

/-- One complex convolved factor of the active-third model after relabeling
is the factor in the corresponding original active coordinate. -/
theorem scratch_LiteralActiveModelCoordinateFactor_permute_to_two
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (F : ModelComplexSchwartzInput) (hσ : σ 2 = i)
    (t : ℝ) (x : E3) (j : Fin 3) :
    LiteralModelCoordinateConvolution j
        (scratch_complexPermutedModelInput σ F j.succ)
        (activeModelKernel 2 j (coordinatePermutation σ u))
        (t ^ (permutedAnisotropy α σ).weight j)
        (coordinatePermutation σ x) =
      LiteralModelCoordinateConvolution (σ j) (F (σ j).succ)
        (activeModelKernel i (σ j) u)
        (t ^ α.weight (σ j)) x := by
  rw [scratch_complexPermutedModelInput_succ_asFun,
    activeModelKernel_coordinatePermutation σ i u hσ j,
    permutedAnisotropy_weight]
  exact scratch_LiteralModelCoordinateConvolution_coordinatePermutation σ j
    (F (σ j).succ) (activeModelKernel i (σ j) u)
    (t ^ α.weight (σ j)) x

/-- The arbitrary-active-coordinate literal complex spatial integrand becomes
the active-third literal complex integrand after all spatial/input labels are
permuted. -/
theorem scratch_LiteralActiveModelSpatialIntegrand_permute_to_two
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (F : ModelComplexSchwartzInput) (hσ : σ 2 = i)
    (t : ℝ) (x : E3) :
    scratch_LiteralActiveModelSpatialIntegrand α i u F t x =
      scratch_LiteralActiveModelSpatialIntegrand (permutedAnisotropy α σ) 2
        (coordinatePermutation σ u) (scratch_complexPermutedModelInput σ F)
        t (coordinatePermutation σ x) := by
  unfold scratch_LiteralActiveModelSpatialIntegrand
  rw [scratch_complexPermutedModelInput_zero_coordinatePermutation]
  have hprod :
      (∏ j : Fin 3,
        LiteralModelCoordinateConvolution j
          (scratch_complexPermutedModelInput σ F j.succ)
          (activeModelKernel 2 j (coordinatePermutation σ u))
          (t ^ (permutedAnisotropy α σ).weight j)
          (coordinatePermutation σ x)) =
        ∏ k : Fin 3,
          LiteralModelCoordinateConvolution k (F k.succ)
            (activeModelKernel i k u) (t ^ α.weight k) x := by
    calc
      (∏ j : Fin 3,
        LiteralModelCoordinateConvolution j
          (scratch_complexPermutedModelInput σ F j.succ)
          (activeModelKernel 2 j (coordinatePermutation σ u))
          (t ^ (permutedAnisotropy α σ).weight j)
          (coordinatePermutation σ x)) =
          ∏ j : Fin 3,
            LiteralModelCoordinateConvolution (σ j) (F (σ j).succ)
              (activeModelKernel i (σ j) u) (t ^ α.weight (σ j)) x := by
            apply Finset.prod_congr rfl
            intro j _
            exact scratch_LiteralActiveModelCoordinateFactor_permute_to_two
              α σ i u F hσ t x j
      _ = ∏ k : Fin 3,
          LiteralModelCoordinateConvolution k (F k.succ)
            (activeModelKernel i k u) (t ^ α.weight k) x := by
          simpa using (Equiv.prod_comp σ (fun k : Fin 3 ↦
            LiteralModelCoordinateConvolution k (F k.succ)
              (activeModelKernel i k u) (t ^ α.weight k) x))
  rw [hprod]

/-- The spatial integral in an arbitrary active coordinate transports to the
active-third literal complex spatial profile. -/
theorem scratch_LiteralActiveModelSpatialProfile_permute_to_two
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (F : ModelComplexSchwartzInput) (hσ : σ 2 = i)
    (t : ℝ) :
    scratch_LiteralActiveModelSpatialProfile α i u F t =
      scratch_LiteralActiveModelSpatialProfile (permutedAnisotropy α σ) 2
        (coordinatePermutation σ u) (scratch_complexPermutedModelInput σ F)
        t := by
  unfold scratch_LiteralActiveModelSpatialProfile
  calc
    (∫ x : E3, scratch_LiteralActiveModelSpatialIntegrand α i u F t x) =
        ∫ x : E3,
          scratch_LiteralActiveModelSpatialIntegrand (permutedAnisotropy α σ) 2
            (coordinatePermutation σ u) (scratch_complexPermutedModelInput σ F)
            t (coordinatePermutation σ x) := by
          apply integral_congr_ae
          filter_upwards [] with x
          exact scratch_LiteralActiveModelSpatialIntegrand_permute_to_two
            α σ i u F hσ t x
    _ = ∫ y : E3,
        scratch_LiteralActiveModelSpatialIntegrand (permutedAnisotropy α σ) 2
          (coordinatePermutation σ u) (scratch_complexPermutedModelInput σ F)
          t y := by
        have hmp : MeasurePreserving (coordinatePermutation σ).toMeasurableEquiv
            volume volume := by
          simpa using coordinatePermutation_measurePreserving σ
        simpa using hmp.integral_comp'
          (scratch_LiteralActiveModelSpatialIntegrand
            (permutedAnisotropy α σ) 2 (coordinatePermutation σ u)
            (scratch_complexPermutedModelInput σ F) t)

/-- The full literal complex active-coordinate form transports exactly to the
canonical literal complex model when the permutation sends coordinate three to
the active coordinate. -/
theorem scratch_LiteralActiveModelFullForm_permute_to_third
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (c : ℝ → ℂ) (F : ModelComplexSchwartzInput)
    (hσ : σ 2 = i) :
    scratch_LiteralActiveModelFullForm α i u c F =
      LiteralModelFullForm (permutedAnisotropy α σ)
        (coordinatePermutation σ u) c (scratch_complexPermutedModelInput σ F) := by
  rw [← scratch_LiteralActiveModelFullForm_two
    (permutedAnisotropy α σ) (coordinatePermutation σ u) c
    (scratch_complexPermutedModelInput σ F)]
  unfold scratch_LiteralActiveModelFullForm
  apply integral_congr_ae
  filter_upwards [] with t
  congr 1
  exact scratch_LiteralActiveModelSpatialProfile_permute_to_two
    α σ i u F hσ t

/-- Complex `L^p` norms are preserved componentwise by the coordinate/input
permutation used to transport the active model. -/
theorem scratch_lpNorm_complexPermutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelComplexSchwartzInput)
    (j : Fin 4) (p : ℝ≥0∞) :
    lpNorm (scratch_complexPermutedModelInput σ F j : E3 → ℂ) p volume =
      lpNorm (F (modelInputIndex σ j) : E3 → ℂ) p volume := by
  have hfun : (scratch_complexPermutedModelInput σ F j : E3 → ℂ) =
      (F (modelInputIndex σ j) : E3 → ℂ) ∘ (coordinatePermutation σ).symm := by
    funext x
    exact scratch_complexPermutedModelInput_apply σ F j x
  rw [← toReal_eLpNorm
    (scratch_complexPermutedModelInput σ F j).continuous.aestronglyMeasurable,
    ← toReal_eLpNorm
      (F (modelInputIndex σ j)).continuous.aestronglyMeasurable,
    hfun,
    eLpNorm_comp_measurePreserving
      (F (modelInputIndex σ j)).continuous.aestronglyMeasurable
      (coordinatePermutation_symm_measurePreserving σ)]

/-- The product of the four complex input norms is invariant under the full
coordinate/input relabeling. -/
theorem scratch_prod_lpNorm_complexPermutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelComplexSchwartzInput)
    (q : Fin 4 → ℝ) :
    (∏ j : Fin 4,
      lpNorm (scratch_complexPermutedModelInput σ F j : E3 → ℂ)
        (ENNReal.ofReal (permutedModelExponent σ q j)) volume) =
      ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (q j)) volume := by
  let G : Fin 4 → ℝ := fun j ↦
    lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (q j)) volume
  calc
    (∏ j : Fin 4,
      lpNorm (scratch_complexPermutedModelInput σ F j : E3 → ℂ)
        (ENNReal.ofReal (permutedModelExponent σ q j)) volume) =
        ∏ j : Fin 4, G (modelInputIndex σ j) := by
          apply Finset.prod_congr rfl
          intro j _
          simpa only [G, permutedModelExponent_apply] using
            scratch_lpNorm_complexPermutedModelInput σ F j
              (ENNReal.ofReal (q (modelInputIndex σ j)))
    _ = ∏ j : Fin 4, G j := prod_modelInputIndex σ G

/-- The strict literal complex model bound holds uniformly at every active
coordinate.  The constant is chosen before translation, complex unit
coefficient, and complex Schwartz input. -/
theorem scratch_exists_uniform_LiteralActiveModelFullForm_bound_weight100
    (α : Anisotropy) (i : Fin 3) (q : Fin 4 → ℝ)
    (hq : ∀ j : Fin 4, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j : Fin 4, activeSourceStoppingExponent i j < q j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (c : ℝ → ℂ)
      (F : ModelComplexSchwartzInput),
      Measurable c → (∀ t : ℝ, ‖c t‖ ≤ 1) →
      ‖scratch_LiteralActiveModelFullForm α i u c F‖ ≤
        32 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
          lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (q j)) volume := by
  rcases exists_coordinatePermutation_to_active i with ⟨σ, hσ⟩
  let q' : Fin 4 → ℝ := permutedModelExponent σ q
  have hq' : ∀ j : Fin 4, 0 < q' j := by
    simpa only [q'] using permutedModelExponent_pos σ q hq
  have hsum' : ∑ j : Fin 4, (q' j)⁻¹ = 1 := by
    calc
      (∑ j : Fin 4, (q' j)⁻¹) = ∑ j : Fin 4, (q j)⁻¹ := by
        simpa only [q'] using sum_inv_permutedModelExponent σ q
      _ = 1 := hsum
  have hqs' : ∀ j : Fin 4, sourceStoppingExponent j < q' j := by
    simpa only [q'] using
      permutedModelExponent_stoppingThreshold σ i q hσ hqs
  rcases exists_uniform_LiteralModelFullForm_bound_weight100
    (permutedAnisotropy α σ) q' hq' hsum' hqs' with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u c F hcmeas hc
  rw [scratch_LiteralActiveModelFullForm_permute_to_third α σ i u c F hσ]
  have hbound' := hbound (coordinatePermutation σ u) c
    (scratch_complexPermutedModelInput σ F) hcmeas hc
  rw [sourceWeight_coordinatePermutation σ u,
    scratch_prod_lpNorm_complexPermutedModelInput σ F q] at hbound'
  simpa only [q'] using hbound'

end

end LiteralComplexActiveInternal

/-- Pull a complex function back along the inverse coordinate relabeling used
by the active-coordinate model transport. -/
noncomputable def complexCoordinatePullback
    (σ : Equiv.Perm (Fin 3)) (f : E3 → ℂ) : E3 → ℂ :=
  LiteralComplexActiveInternal.scratch_complexCoordinatePullback σ f

@[simp] theorem complexCoordinatePullback_apply
    (σ : Equiv.Perm (Fin 3)) (f : E3 → ℂ) (x : E3) :
    complexCoordinatePullback σ f x =
      f ((coordinatePermutation σ).symm x) := by
  rfl

/-- Simultaneously permute spatial coordinates and the four complex Schwartz
inputs in the active-coordinate model. -/
noncomputable def complexPermutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelComplexSchwartzInput) :
    ModelComplexSchwartzInput :=
  LiteralComplexActiveInternal.scratch_complexPermutedModelInput σ F

@[simp] theorem complexPermutedModelInput_apply
    (σ : Equiv.Perm (Fin 3)) (F : ModelComplexSchwartzInput)
    (j : Fin 4) (x : E3) :
    complexPermutedModelInput σ F j x =
      F (modelInputIndex σ j) ((coordinatePermutation σ).symm x) := by
  simpa only [complexPermutedModelInput] using
    LiteralComplexActiveInternal.scratch_complexPermutedModelInput_apply σ F j x

/-- Literal complex coordinate convolution commutes with a coordinate
permutation. -/
theorem LiteralModelCoordinateConvolution_coordinatePermutation
    (σ : Equiv.Perm (Fin 3)) (j : Fin 3)
    (f : E3 → ℂ) (k : ℝ → ℝ) (s : ℝ) (x : E3) :
    LiteralModelCoordinateConvolution j
      (complexCoordinatePullback σ f) k s
      (coordinatePermutation σ x) =
      LiteralModelCoordinateConvolution (σ j) f k s x := by
  simpa only [complexCoordinatePullback] using
    LiteralComplexActiveInternal.scratch_LiteralModelCoordinateConvolution_coordinatePermutation
      σ j f k s x

/-- The literal complex active-coordinate spatial integrand. -/
noncomputable def LiteralActiveModelSpatialIntegrand
    (α : Anisotropy) (i : Fin 3) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (x : E3) : ℂ :=
  LiteralComplexActiveInternal.scratch_LiteralActiveModelSpatialIntegrand
    α i u F t x

/-- The literal complex active-coordinate spatial profile. -/
noncomputable def LiteralActiveModelSpatialProfile
    (α : Anisotropy) (i : Fin 3) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) : ℂ :=
  LiteralComplexActiveInternal.scratch_LiteralActiveModelSpatialProfile
    α i u F t

/-- The literal complex full model form with an arbitrary active annular
coordinate. -/
noncomputable def LiteralActiveModelFullForm
    (α : Anisotropy) (i : Fin 3) (u : E3) (c : ℝ → ℂ)
    (F : ModelComplexSchwartzInput) : ℂ :=
  LiteralComplexActiveInternal.scratch_LiteralActiveModelFullForm α i u c F

/-- At active coordinate three, the active literal complex spatial integrand
is the canonical literal complex spatial integrand. -/
theorem LiteralActiveModelSpatialIntegrand_two
    (α : Anisotropy) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (x : E3) :
    LiteralActiveModelSpatialIntegrand α 2 u F t x =
      LiteralModelSpatialIntegrand α u F t x := by
  simpa only [LiteralActiveModelSpatialIntegrand] using
    LiteralComplexActiveInternal.scratch_LiteralActiveModelSpatialIntegrand_two
      α u F t x

/-- At active coordinate three, the active literal complex full form is the
canonical literal complex full form. -/
theorem LiteralActiveModelFullForm_two
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (F : ModelComplexSchwartzInput) :
    LiteralActiveModelFullForm α 2 u c F =
      LiteralModelFullForm α u c F := by
  simpa only [LiteralActiveModelFullForm] using
    LiteralComplexActiveInternal.scratch_LiteralActiveModelFullForm_two α u c F

/-- The full literal complex active-coordinate model is exactly transported to
the canonical literal complex model by any permutation taking coordinate three
to the active coordinate. -/
theorem LiteralActiveModelFullForm_permute_to_third
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (c : ℝ → ℂ) (F : ModelComplexSchwartzInput)
    (hσ : σ 2 = i) :
    LiteralActiveModelFullForm α i u c F =
      LiteralModelFullForm (permutedAnisotropy α σ)
        (coordinatePermutation σ u) c (complexPermutedModelInput σ F) := by
  simpa only [LiteralActiveModelFullForm, complexPermutedModelInput] using
    LiteralComplexActiveInternal.scratch_LiteralActiveModelFullForm_permute_to_third
      α σ i u c F hσ

/-- Complex `L^p` norms are invariant under the active-coordinate input
permutation. -/
theorem lpNorm_complexPermutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelComplexSchwartzInput)
    (j : Fin 4) (p : ℝ≥0∞) :
    lpNorm (complexPermutedModelInput σ F j : E3 → ℂ) p volume =
      lpNorm (F (modelInputIndex σ j) : E3 → ℂ) p volume := by
  simpa only [complexPermutedModelInput] using
    LiteralComplexActiveInternal.scratch_lpNorm_complexPermutedModelInput σ F j p

/-- The product of the four complex input norms is invariant under the full
active-coordinate input/exponent relabeling. -/
theorem prod_lpNorm_complexPermutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelComplexSchwartzInput)
    (q : Fin 4 → ℝ) :
    (∏ j : Fin 4,
      lpNorm (complexPermutedModelInput σ F j : E3 → ℂ)
        (ENNReal.ofReal (permutedModelExponent σ q j)) volume) =
      ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (q j)) volume := by
  simpa only [complexPermutedModelInput] using
    LiteralComplexActiveInternal.scratch_prod_lpNorm_complexPermutedModelInput
      σ F q

/-- The strict literal complex model bound holds uniformly for every active
coordinate, complex unit coefficient, and complex Schwartz four-tuple. -/
theorem exists_uniform_LiteralActiveModelFullForm_bound_weight100
    (α : Anisotropy) (i : Fin 3) (q : Fin 4 → ℝ)
    (hq : ∀ j : Fin 4, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j : Fin 4, activeSourceStoppingExponent i j < q j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (c : ℝ → ℂ)
      (F : ModelComplexSchwartzInput),
      Measurable c → (∀ t : ℝ, ‖c t‖ ≤ 1) →
      ‖LiteralActiveModelFullForm α i u c F‖ ≤
        32 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
          lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (q j)) volume := by
  simpa only [LiteralActiveModelFullForm] using
    LiteralComplexActiveInternal.scratch_exists_uniform_LiteralActiveModelFullForm_bound_weight100
      α i q hq hsum hqs

/-! ## Section 9 anisotropic derivative transport -/

/-- A diagonal anisotropic dilation acts on a coordinate direction by the
corresponding anisotropic power. -/
theorem dilateLinear_coordinateDirection
    (α : Anisotropy) (t : ℝ) (j : Fin 3) :
    α.dilateLinear t (Anisotropy.coordinateDirection j) =
      t ^ α.weight j • Anisotropy.coordinateDirection j := by
  ext k
  rw [Anisotropy.dilateLinear_apply]
  simp [Anisotropy.dilate, coordinateDirection_apply]
  split_ifs with h
  · subst k
    simp
  · simp [h]

/-- Away from the origin, anisotropic diagonal precomposition transports an
ordered coordinate derivative by applying the same diagonal map to every
input vector. -/
theorem iteratedFDeriv_dilate_comp_coordinate
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    {t : ℝ} (ht : 0 < t) (η : E3) (k : ℕ) (hk : k ≤ 110)
    (σ : Fin k → Fin 3) (hη : η ≠ 0) :
    (iteratedFDeriv ℝ k (fun z : E3 ↦ m (α.dilate t⁻¹ z)) η)
        (fun r ↦ Anisotropy.coordinateDirection (σ r)) =
      (iteratedFDeriv ℝ k m (α.dilate t⁻¹ η))
        (fun r ↦ α.dilateLinear t⁻¹ (Anisotropy.coordinateDirection (σ r))) := by
  let S : Set E3 := ({0}ᶜ : Set E3)
  let L : E3 →L[ℝ] E3 :=
    { α.dilateLinear t⁻¹ with
      cont := LinearMap.continuous_of_finiteDimensional (α.dilateLinear t⁻¹) }
  let S' : Set E3 := L ⁻¹' S
  have hLapply (z : E3) : L z = α.dilate t⁻¹ z := by
    change (α.dilateLinear t⁻¹) z = α.dilate t⁻¹ z
    exact α.dilateLinear_apply t⁻¹ z
  have hLη : L η = α.dilate t⁻¹ η := hLapply η
  have hLηne : L η ≠ 0 := by
    rw [hLη]
    intro hzero
    have hrecover := α.dilate_apply_inv ht.ne' η
    rw [hzero] at hrecover
    apply hη
    change α.dilate t (0 : E3) = η at hrecover
    have hzeroDilate : α.dilate t (0 : E3) = 0 := by
      rw [← α.dilateLinear_apply]
      exact (α.dilateLinear t).map_zero
    rw [hzeroDilate] at hrecover
    exact hrecover.symm
  have hηS' : η ∈ S' := by
    change L η ∈ S
    simpa [S] using hLηne
  have hLS : L η ∈ S := by
    simpa [S] using hLηne
  have hSopen : IsOpen S := by
    simpa only [S] using (isOpen_compl_singleton : IsOpen ({0}ᶜ : Set E3))
  have hS'open : IsOpen S' := hSopen.preimage L.continuous
  have hSunique : UniqueDiffOn ℝ S := hSopen.uniqueDiffOn
  have hS'unique : UniqueDiffOn ℝ S' := hS'open.uniqueDiffOn
  have hmAt : ContDiffAt ℝ 110 m (L η) :=
    hm.2.2.2.1.contDiffAt (hSopen.mem_nhds hLS)
  have hcompOn : ContDiffOn ℝ 110 (m ∘ L) S' :=
    hm.2.2.2.1.comp_continuousLinearMap L
  have hcompAt : ContDiffAt ℝ 110 (m ∘ L) η :=
    hcompOn.contDiffAt (hS'open.mem_nhds hηS')
  have hwithin := L.iteratedFDerivWithin_comp_right hm.2.2.2.1
    hSunique hS'unique hLS (show (k : WithTop ℕ∞) ≤ 110 by exact_mod_cast hk)
  have hleft : iteratedFDeriv ℝ k (m ∘ L) η =
      iteratedFDerivWithin ℝ k (m ∘ L) S' η := by
    symm
    exact iteratedFDerivWithin_eq_iteratedFDeriv hS'unique
      (hcompAt.of_le (by exact_mod_cast hk)) hηS'
  have hright : iteratedFDerivWithin ℝ k m S (L η) =
      iteratedFDeriv ℝ k m (L η) :=
    iteratedFDerivWithin_eq_iteratedFDeriv hSunique
      (hmAt.of_le (by exact_mod_cast hk)) hLS
  have hfun : (fun z : E3 ↦ m (α.dilate t⁻¹ z)) = m ∘ L := by
    funext z
    exact congrArg m (hLapply z).symm
  calc
    (iteratedFDeriv ℝ k (fun z : E3 ↦ m (α.dilate t⁻¹ z)) η)
        (fun r ↦ Anisotropy.coordinateDirection (σ r)) =
        (iteratedFDeriv ℝ k (m ∘ L) η)
          (fun r ↦ Anisotropy.coordinateDirection (σ r)) := by rw [hfun]
    _ = (iteratedFDerivWithin ℝ k (m ∘ L) S' η)
          (fun r ↦ Anisotropy.coordinateDirection (σ r)) := by rw [hleft]
    _ = ((iteratedFDerivWithin ℝ k m S (L η)).compContinuousLinearMap
          (fun _ ↦ L)) (fun r ↦ Anisotropy.coordinateDirection (σ r)) := by
          rw [hwithin]
    _ = (iteratedFDeriv ℝ k m (L η))
          (fun r ↦ L (Anisotropy.coordinateDirection (σ r))) := by
          rw [hright]
          simp only [ContinuousMultilinearMap.compContinuousLinearMap_apply]
    _ = (iteratedFDeriv ℝ k m (α.dilate t⁻¹ η))
          (fun r ↦ α.dilateLinear t⁻¹ (Anisotropy.coordinateDirection (σ r))) := by
          rw [hLη]
          rfl

/-- The anisotropic radius is strictly positive off the origin. -/
theorem radius_pos_of_ne_zero (α : Anisotropy) {x : E3} (hx : x ≠ 0) :
    0 < α.radius x := by
  obtain ⟨i, hi⟩ : ∃ i : Fin 3, x i ≠ 0 := by
    by_contra h
    push_neg at h
    apply hx
    ext j
    exact h j
  have hterm : 0 < |x i| ^ ((α.weight i : ℝ)⁻¹) := by
    exact Real.rpow_pos_of_pos (abs_pos.mpr hi) _
  unfold Anisotropy.radius
  exact lt_of_lt_of_le hterm
    (Finset.single_le_sum (s := Finset.univ)
      (fun j _ ↦ Real.rpow_nonneg (abs_nonneg (x j)) ((α.weight j : ℝ)⁻¹))
      (Finset.mem_univ i))

/-- The exact coordinate derivative factor of the rescaled multiplier. -/
theorem dilate_coordinate_derivative_factor
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    {t : ℝ} (ht : 0 < t) (η : E3) (k : ℕ) (hk : k ≤ 110)
    (σ : Fin k → Fin 3) (hη : η ≠ 0) :
    (iteratedFDeriv ℝ k (fun z : E3 ↦ m (α.dilate t⁻¹ z)) η)
        (fun r ↦ Anisotropy.coordinateDirection (σ r)) =
      (t⁻¹) ^ α.derivativeWeight σ •
        (iteratedFDeriv ℝ k m (α.dilate t⁻¹ η))
          (fun r ↦ Anisotropy.coordinateDirection (σ r)) := by
  rw [iteratedFDeriv_dilate_comp_coordinate α M m hm ht η k hk σ hη]
  have hvec : (fun r ↦ α.dilateLinear t⁻¹
      (Anisotropy.coordinateDirection (σ r))) =
      (fun r ↦ (t⁻¹) ^ α.weight (σ r) •
        Anisotropy.coordinateDirection (σ r)) := by
    funext r
    exact dilateLinear_coordinateDirection α t⁻¹ (σ r)
  rw [hvec, ContinuousMultilinearMap.map_smul_univ]
  congr 1
  unfold Anisotropy.derivativeWeight
  rw [Finset.prod_pow_eq_pow_sum]

/-- The scale powers in the multiplier derivative bound cancel exactly under
anisotropic precomposition. -/
theorem anisotropic_derivative_scalar_cancel
    (M t r : ℝ) (ht : 0 < t) (hr : 0 < r) (d : ℕ) :
    (t⁻¹) ^ d * (M * (t⁻¹ * r) ^ (-((d : ℕ) : ℝ))) =
      M * r ^ (-((d : ℕ) : ℝ)) := by
  have hti : 0 < t⁻¹ := inv_pos.mpr ht
  rw [Real.mul_rpow hti.le hr.le]
  rw [← Real.rpow_natCast]
  calc
    t⁻¹ ^ (d : ℝ) * (M * (t⁻¹ ^ (-(d : ℝ)) * r ^ (-(d : ℝ)))) =
        M * (t⁻¹ ^ (d : ℝ) * t⁻¹ ^ (-(d : ℝ))) * r ^ (-(d : ℝ)) := by ring
    _ = M * t⁻¹ ^ ((d : ℝ) + -(d : ℝ)) * r ^ (-(d : ℝ)) := by
      rw [Real.rpow_add hti]
    _ = M * r ^ (-(d : ℝ)) := by norm_num

/-- The anisotropic multiplier hypothesis is uniform under the diagonal
rescaling used in localized symbols when tested on ordered coordinate
directions. -/
theorem dilate_coordinate_derivative_bound
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    {t : ℝ} (ht : 0 < t) (η : E3) (k : ℕ) (hk : k ≤ 110)
    (σ : Fin k → Fin 3) (hη : η ≠ 0) :
    ‖(iteratedFDeriv ℝ k (fun z : E3 ↦ m (α.dilate t⁻¹ z)) η)
        (fun r ↦ Anisotropy.coordinateDirection (σ r))‖ ≤
      M * (α.radius η) ^ (-((α.derivativeWeight σ : ℕ) : ℝ)) := by
  rw [dilate_coordinate_derivative_factor α M m hm ht η k hk σ hη]
  have hDη : α.dilate t⁻¹ η ≠ 0 := by
    intro hzero
    have hrecover := α.dilate_apply_inv ht.ne' η
    rw [hzero] at hrecover
    apply hη
    change α.dilate t (0 : E3) = η at hrecover
    have hzeroDilate : α.dilate t (0 : E3) = 0 := by
      rw [← α.dilateLinear_apply]
      exact (α.dilateLinear t).map_zero
    rw [hzeroDilate] at hrecover
    exact hrecover.symm
  have hsource := hm.2.2.2.2 k hk (α.dilate t⁻¹ η) hDη σ
  have hpow_nonneg : 0 ≤ (t⁻¹) ^ α.derivativeWeight σ := by positivity
  rw [norm_smul, Real.norm_eq_abs,
    abs_of_pos (pow_pos (inv_pos.mpr ht) _)]
  calc
    (t⁻¹) ^ α.derivativeWeight σ *
        ‖(iteratedFDeriv ℝ k m (α.dilate t⁻¹ η))
          (fun r ↦ Anisotropy.coordinateDirection (σ r))‖ ≤
        (t⁻¹) ^ α.derivativeWeight σ *
          (M * (α.radius (α.dilate t⁻¹ η)) ^
            (-((α.derivativeWeight σ : ℕ) : ℝ))) :=
      mul_le_mul_of_nonneg_left hsource hpow_nonneg
    _ = M * (α.radius η) ^ (-((α.derivativeWeight σ : ℕ) : ℝ)) := by
      rw [α.radius_dilate (inv_pos.mpr ht)]
      exact anisotropic_derivative_scalar_cancel M t (α.radius η) ht
        (radius_pos_of_ne_zero α hη) (α.derivativeWeight σ)

/-- The literal active kernel family obeys the source's order-ten translated
bracket bound, uniformly in the active coordinate. -/
theorem kernelDilate_activeModelKernel_sourceWeight_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i j : Fin 3) (u : E3) (s y : ℝ), 0 < s →
      |kernelDilate (activeModelKernel i j u) s y| ≤
        C * sourceWeight u ^ 10 * bracketKernelAt s 0 y := by
  rcases kernelDilate_ModelLowKernel_sourceWeight_bracket_majorant with
    ⟨Clow, hClow, hlow⟩
  rcases kernelDilate_ModelThirdKernel_sourceWeight_bracket_majorant with
    ⟨Cthird, hCthird, hthird⟩
  refine ⟨max Clow Cthird, le_trans hClow (le_max_left _ _), ?_⟩
  intro i j u s y hs
  have hfactor : 0 ≤ sourceWeight u ^ 10 * bracketKernelAt s 0 y := by
    exact mul_nonneg (pow_nonneg (sourceWeight_nonneg u) _)
      (bracketKernelAt_pos hs).le
  by_cases hji : j = i
  · subst j
    simp only [activeModelKernel]
    calc
      |kernelDilate (ModelThirdKernel (u i)) s y| ≤
          Cthird * sourceWeight u ^ 10 * bracketKernelAt s 0 y :=
        hthird u i s y hs
      _ = Cthird * (sourceWeight u ^ 10 * bracketKernelAt s 0 y) := by ring
      _ ≤ max Clow Cthird * (sourceWeight u ^ 10 * bracketKernelAt s 0 y) :=
        mul_le_mul_of_nonneg_right (le_max_right _ _) hfactor
      _ = max Clow Cthird * sourceWeight u ^ 10 * bracketKernelAt s 0 y := by ring
  · simp only [activeModelKernel, if_neg hji]
    calc
      |kernelDilate (ModelLowKernel (u j)) s y| ≤
          Clow * sourceWeight u ^ 10 * bracketKernelAt s 0 y :=
        hlow u j s y hs
      _ = Clow * (sourceWeight u ^ 10 * bracketKernelAt s 0 y) := by ring
      _ ≤ max Clow Cthird * (sourceWeight u ^ 10 * bracketKernelAt s 0 y) :=
        mul_le_mul_of_nonneg_right (le_max_left _ _) hfactor
      _ = max Clow Cthird * sourceWeight u ^ 10 * bracketKernelAt s 0 y := by ring

/-- Moving only the active coordinate by a scalar displacement preserves the
literal transverse face. -/
theorem faceInsert_sub_coordinateDirection
    (i : Fin 3) (a r : ℝ) (z : TransverseSpace i) :
    faceInsert i a z - r • Anisotropy.coordinateDirection i =
      faceInsert i (a - r) z := by
  ext k
  by_cases hki : k = i
  · subst k
    simp [faceInsert, coordinateDirection_apply]
  · simp [faceInsert, coordinateDirection_apply, hki]

/-- Evenness converts the displacement form of the bracket kernel into its
sampled-coordinate form on a coordinate fiber. -/
theorem bracketKernelAt_displacement_eq_sampled
    (s a r : ℝ) :
    bracketKernelAt s 0 r = bracketKernelAt s a (a - r) := by
  simp only [bracketKernelAt, kernelAt, kernelDilate, smul_eq_mul, sub_zero]
  rw [show (a - r - a) / s = -(r / s) by ring, bracketKernel_even]

/-- The positive displacement bracket integral is exactly the literal
coordinate bracket convolution. -/
theorem displacementBracket_eq_coordinateBracketConvolution
    (i : Fin 3) (f : E3 → ℂ) (s : ℝ) (x : E3) :
    (∫ r : ℝ, ‖f (x - r • Anisotropy.coordinateDirection i)‖ *
      bracketKernelAt s 0 r) = coordinateBracketConvolution i f s x := by
  let a : ℝ := x i
  let z : TransverseSpace i := (coordinateSplit i x).2
  have hx : x = faceInsert i a z := by
    change x = faceInsert i (coordinateSplit i x).1 (coordinateSplit i x).2
    exact (coordinateJoin_split i x).symm
  let F : ℝ → ℝ := fun y ↦ ‖f (faceInsert i y z)‖ * bracketKernelAt s a y
  calc
    (∫ r : ℝ, ‖f (x - r • Anisotropy.coordinateDirection i)‖ *
        bracketKernelAt s 0 r) = ∫ r : ℝ, F (a - r) := by
      apply integral_congr_ae
      filter_upwards [] with r
      dsimp only [F]
      rw [hx, faceInsert_sub_coordinateDirection,
        bracketKernelAt_displacement_eq_sampled]
    _ = ∫ y : ℝ, F y := integral_sub_left_eq_self F volume a
    _ = coordinateBracketConvolution i f s x := by
      unfold coordinateBracketConvolution
      rfl

/-- A pointwise bracket majorant for a real kernel transfers directly to its
literal coordinate convolution against a bounded continuous input. -/
theorem abs_ModelCoordinateConvolution_le_displacementBracket
    (i : Fin 3) (f : E3 → ℝ) (k : ℝ → ℝ) (s : ℝ) (x : E3)
    (hfcont : Continuous f) (B : ℝ) (hfB : ∀ y : E3, |f y| ≤ B)
    (hk : Integrable k) (hs : 0 < s) (C : ℝ) (hC : 0 ≤ C)
    (hmajor : ∀ r : ℝ, |kernelDilate k s r| ≤ C * bracketKernelAt s 0 r) :
    |ModelCoordinateConvolution i f k s x| ≤ C *
      ∫ r : ℝ, |f (x - r • Anisotropy.coordinateDirection i)| *
        bracketKernelAt s 0 r := by
  let h : ℝ → E3 := fun r ↦ x - r • Anisotropy.coordinateDirection i
  let G : ℝ → ℝ := fun r ↦ f (h r) * kernelDilate k s r
  let H : ℝ → ℝ := fun r ↦
    C * (|f (h r)| * bracketKernelAt s 0 r)
  have hmap : Continuous h :=
    continuous_const.sub (continuous_id.smul continuous_const)
  have hB : 0 ≤ B := le_trans (abs_nonneg (f x)) (hfB x)
  have hkd : Integrable (kernelDilate k s) := by
    unfold kernelDilate
    exact (hk.comp_div hs.ne').smul (s⁻¹ : ℝ)
  have hGmeas : AEStronglyMeasurable G volume :=
    ((hfcont.comp hmap).aestronglyMeasurable.mul hkd.aestronglyMeasurable)
  have hK : Integrable (fun r : ℝ ↦ |kernelDilate k s r|) :=
    integrable_abs_kernelDilate k hk hs
  have hupperG : Integrable (fun r : ℝ ↦ B * |kernelDilate k s r|) :=
    hK.const_mul B
  have hG : Integrable G := by
    apply Integrable.mono' hupperG hGmeas
    filter_upwards [] with r
    dsimp only [G]
    rw [Real.norm_eq_abs, abs_mul]
    exact mul_le_mul_of_nonneg_right (hfB _) (abs_nonneg _)
  have hbracket : Integrable (bracketKernelAt s 0) :=
    integrable_bracketKernelAt hs 0
  have hHmeas : AEStronglyMeasurable H volume :=
    ((((hfcont.comp hmap).abs).aestronglyMeasurable.mul
      hbracket.aestronglyMeasurable).const_mul C)
  have hupperH : Integrable (fun r : ℝ ↦
      (C * B) * bracketKernelAt s 0 r) :=
    hbracket.const_mul (C * B)
  have hH : Integrable H := by
    apply Integrable.mono' hupperH hHmeas
    filter_upwards [] with r
    dsimp only [H]
    rw [Real.norm_eq_abs]
    rw [abs_of_nonneg]
    · calc
        C * (|f (h r)| * bracketKernelAt s 0 r) =
            (C * |f (h r)|) * bracketKernelAt s 0 r := by ring
        _ ≤ (C * B) * bracketKernelAt s 0 r :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left (hfB _) hC)
            (bracketKernelAt_pos hs).le
    · exact mul_nonneg hC
        (mul_nonneg (abs_nonneg _) (bracketKernelAt_pos hs).le)
  unfold ModelCoordinateConvolution
  change |∫ r : ℝ, G r| ≤ C * ∫ r : ℝ,
    |f (h r)| * bracketKernelAt s 0 r
  calc
    |∫ r : ℝ, G r| ≤ ∫ r : ℝ, |G r| :=
      MeasureTheory.abs_integral_le_integral_abs
    _ ≤ ∫ r : ℝ, H r := by
      apply integral_mono hG.norm hH
      intro r
      dsimp only [G, H]
      rw [Real.norm_eq_abs, abs_mul]
      calc
        |f (h r)| * |kernelDilate k s r| ≤
            |f (h r)| * (C * bracketKernelAt s 0 r) :=
          mul_le_mul_of_nonneg_left (hmajor r) (abs_nonneg _)
        _ = C * (|f (h r)| * bracketKernelAt s 0 r) := by ring
    _ = C * ∫ r : ℝ, |f (h r)| * bracketKernelAt s 0 r := by
      rw [integral_const_mul]

/-- The preceding domination in the source's sampled-coordinate convention. -/
theorem abs_ModelCoordinateConvolution_le_coordinateBracketConvolution
    (i : Fin 3) (f : E3 → ℝ) (k : ℝ → ℝ) (s : ℝ) (x : E3)
    (hfcont : Continuous f) (B : ℝ) (hfB : ∀ y : E3, |f y| ≤ B)
    (hk : Integrable k) (hs : 0 < s) (C : ℝ) (hC : 0 ≤ C)
    (hmajor : ∀ r : ℝ, |kernelDilate k s r| ≤ C * bracketKernelAt s 0 r) :
    |ModelCoordinateConvolution i f k s x| ≤ C *
      coordinateBracketConvolution i (fun y ↦ (f y : ℂ)) s x := by
  calc
    |ModelCoordinateConvolution i f k s x| ≤ C *
        ∫ r : ℝ, |f (x - r • Anisotropy.coordinateDirection i)| *
          bracketKernelAt s 0 r :=
      abs_ModelCoordinateConvolution_le_displacementBracket
        i f k s x hfcont B hfB hk hs C hC hmajor
    _ = C * coordinateBracketConvolution i (fun y ↦ (f y : ℂ)) s x := by
      rw [← displacementBracket_eq_coordinateBracketConvolution
        i (fun y ↦ (f y : ℂ)) s x]
      simp only [Complex.norm_real, Real.norm_eq_abs]

/-- Every active coordinate kernel is integrable, whether it is a low or the
single annular model kernel. -/
theorem integrable_activeModelKernel
    (i j : Fin 3) (u : E3) :
    Integrable (activeModelKernel i j u) := by
  unfold activeModelKernel
  split_ifs with hji
  · exact integrable_ModelThirdKernel (u j)
  · exact integrable_ModelLowKernel (u j)

/-- The literal active model convolution is dominated by the positive
coordinate bracket convolution with the source translation weight. -/
theorem abs_activeModelCoordinateConvolution_le_coordinateBracketConvolution :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i j : Fin 3) (u : E3) (s : ℝ) (x : E3)
      (f : E3 → ℝ) (B : ℝ), 0 < s → Continuous f →
      (∀ y : E3, |f y| ≤ B) →
      |ModelCoordinateConvolution j f (activeModelKernel i j u) s x| ≤
        C * sourceWeight u ^ 10 *
          coordinateBracketConvolution j (fun y ↦ (f y : ℂ)) s x := by
  rcases kernelDilate_activeModelKernel_sourceWeight_bracket_majorant with
    ⟨C, hC, hmajor⟩
  refine ⟨C, hC, ?_⟩
  intro i j u s x f B hs hfcont hfB
  have hCW : 0 ≤ C * sourceWeight u ^ 10 :=
    mul_nonneg hC (pow_nonneg (sourceWeight_nonneg u) _)
  have hpoint : ∀ r : ℝ,
      |kernelDilate (activeModelKernel i j u) s r| ≤
        (C * sourceWeight u ^ 10) * bracketKernelAt s 0 r := by
    intro r
    calc
      |kernelDilate (activeModelKernel i j u) s r| ≤
          C * sourceWeight u ^ 10 * bracketKernelAt s 0 r :=
        hmajor i j u s r hs
      _ = (C * sourceWeight u ^ 10) * bracketKernelAt s 0 r := by ring
  calc
    |ModelCoordinateConvolution j f (activeModelKernel i j u) s x| ≤
        (C * sourceWeight u ^ 10) *
          coordinateBracketConvolution j (fun y ↦ (f y : ℂ)) s x :=
      abs_ModelCoordinateConvolution_le_coordinateBracketConvolution
        j f (activeModelKernel i j u) s x hfcont B hfB
        (integrable_activeModelKernel i j u) hs
        (C * sourceWeight u ^ 10) hCW hpoint
    _ = C * sourceWeight u ^ 10 *
          coordinateBracketConvolution j (fun y ↦ (f y : ℂ)) s x := by ring

/-- The source's coordinate maximal domination for every active model
convolution, in a form ready to feed the one-fiber weak endpoint. -/
theorem abs_activeModelCoordinateConvolution_le_dyadic :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i j : Fin 3) (u : E3) (s : ℝ) (x : E3)
      (f : E3 → ℝ) (B : ℝ), 0 < s → Continuous f →
      (∀ y : E3, |f y| ≤ B) →
      |ModelCoordinateConvolution j f (activeModelKernel i j u) s x| ≤
        C * sourceWeight u ^ 10 *
          coordinateDyadicBallMaximal j (fun y ↦ (f y : ℂ)) x := by
  rcases abs_activeModelCoordinateConvolution_le_coordinateBracketConvolution with
    ⟨C, hC, hconv⟩
  refine ⟨C * dyadicBracketShellConstant,
    mul_nonneg hC dyadicBracketShellConstant_nonneg, ?_⟩
  intro i j u s x f B hs hfcont hfB
  have hB : 0 ≤ B := le_trans (abs_nonneg (f x)) (hfB x)
  have hfmeas : Measurable (fun y : E3 ↦ (f y : ℂ)) :=
    (Complex.continuous_ofReal.comp hfcont).measurable
  have hfbound : ∀ y : E3, ‖(f y : ℂ)‖ ≤ B := by
    intro y
    rw [Complex.norm_real, Real.norm_eq_abs]
    exact hfB y
  have hfactor : 0 ≤ C * sourceWeight u ^ 10 :=
    mul_nonneg hC (pow_nonneg (sourceWeight_nonneg u) _)
  calc
    |ModelCoordinateConvolution j f (activeModelKernel i j u) s x| ≤
        C * sourceWeight u ^ 10 *
          coordinateBracketConvolution j (fun y ↦ (f y : ℂ)) s x :=
      hconv i j u s x f B hs hfcont hfB
    _ ≤ C * sourceWeight u ^ 10 *
          (dyadicBracketShellConstant *
            coordinateDyadicBallMaximal j (fun y ↦ (f y : ℂ)) x) := by
      exact mul_le_mul_of_nonneg_left
        (coordinateBracketConvolution_le_shell_dyadic
          j (fun y ↦ (f y : ℂ)) hfmeas B hB hfbound s x hs)
        hfactor
    _ = (C * dyadicBracketShellConstant) * sourceWeight u ^ 10 *
          coordinateDyadicBallMaximal j (fun y ↦ (f y : ℂ)) x := by ring

/-- A one-dimensional noncompact differentiation-under-convolution lemma.
The globally bounded kernel and derivative give the integrable majorants
needed for the parametric-integral theorem. -/
theorem hasDerivAt_convolution_right_of_bound
    (f k k' : ℝ → ℝ) (hf : Integrable f)
    (hk : Continuous k) (hk' : Continuous k')
    (hderiv : ∀ x : ℝ, HasDerivAt k (k' x) x)
    (A B : ℝ) (hbound : ∀ x : ℝ, ‖k x‖ ≤ A)
    (hbound' : ∀ x : ℝ, ‖k' x‖ ≤ B) (x : ℝ) :
    HasDerivAt (fun y ↦
      (f ⋆[ContinuousLinearMap.mul ℝ ℝ] k) y)
      ((f ⋆[ContinuousLinearMap.mul ℝ ℝ] k') x) x := by
  let F : ℝ → ℝ → ℝ := fun y t ↦ f t * k (y - t)
  let F' : ℝ → ℝ → ℝ := fun y t ↦ f t * k' (y - t)
  have hmeas (y : ℝ) : AEStronglyMeasurable (F y) volume := by
    exact hf.aestronglyMeasurable.convolution_integrand_snd
      (ContinuousLinearMap.mul ℝ ℝ) hk.aestronglyMeasurable y
  have hmeas' (y : ℝ) : AEStronglyMeasurable (F' y) volume := by
    exact hf.aestronglyMeasurable.convolution_integrand_snd
      (ContinuousLinearMap.mul ℝ ℝ) hk'.aestronglyMeasurable y
  have hFint (y : ℝ) : Integrable (F y) := by
    have hupper : Integrable (fun t : ℝ ↦ ‖f t‖ * A) :=
      hf.norm.mul_const A
    apply Integrable.mono' hupper (hmeas y)
    filter_upwards [] with t
    dsimp only [F]
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (hbound _) (norm_nonneg _)
  have hmajor : Integrable (fun t : ℝ ↦ ‖f t‖ * B) :=
    hf.norm.mul_const B
  have hderiv_integrand (y t : ℝ) :
      HasDerivAt (fun q ↦ F q t) (F' y t) y := by
    dsimp only [F, F']
    convert! (hasDerivAt_const y (f t)).mul
      ((hderiv (y - t)).comp y
        ((hasDerivAt_id y).sub (hasDerivAt_const y t))) using 1 <;> ring
  have h := hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := volume) (F := F) (F' := F')
    (bound := fun t : ℝ ↦ ‖f t‖ * B) (s := Set.univ) (x₀ := x)
    univ_mem
    (Filter.Eventually.of_forall hmeas) (hFint x) (hmeas' x)
    (Filter.Eventually.of_forall fun t y hy ↦ by
      dsimp only [F']
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_left (hbound' _) (norm_nonneg _))
    hmajor
    (Filter.Eventually.of_forall fun t y hy ↦ hderiv_integrand y t)
  simpa only [F, F', convolution_mul] using h.2

/-- Scalar convolution is commutative in the exact measure-theoretic
convention used by the model kernels. -/
theorem convolution_mul_comm
    (f g : ℝ → ℝ) (x : ℝ) :
    (f ⋆[ContinuousLinearMap.mul ℝ ℝ] g) x =
      (g ⋆[ContinuousLinearMap.mul ℝ ℝ] f) x := by
  rw [convolution_mul_swap, convolution_mul]
  apply integral_congr_ae
  filter_upwards [] with t
  ring

/-- The unscaled derivative of the translated low-frequency model kernel. -/
noncomputable def ModelLowKernelDeriv (u w : ℝ) : ℝ :=
  (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePhiPhysicalReal) (w - u)

/-- The Gaussian derivative is globally bounded. -/
theorem exists_bound_gaussianDeriv :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ x : ℝ, ‖gaussianDeriv x‖ ≤ B := by
  rcases gaussianDeriv_polynomial_decay 0 with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro x
  rw [Real.norm_eq_abs]
  simpa using hbound x

/-- Differentiating the low Gaussian--Schwartz convolution differentiates
the Gaussian factor. -/
theorem hasDerivAt_low_convolution (w : ℝ) :
    HasDerivAt (fun y ↦
      (gaussian ⋆[ContinuousLinearMap.mul ℝ ℝ] conePhiPhysicalReal) y)
      ((gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        conePhiPhysicalReal) w) w := by
  rcases exists_bound_gaussianDeriv with ⟨B, hB, hderivbound⟩
  have hgaussianbound : ∀ x : ℝ, ‖gaussian x‖ ≤ (1 : ℝ) := by
    intro x
    rw [Real.norm_eq_abs, abs_of_nonneg (gaussian_nonneg x)]
    exact gaussian_le_one x
  have hbase := hasDerivAt_convolution_right_of_bound
    conePhiPhysicalReal gaussian gaussianDeriv
    conePhiPhysicalReal.integrable gaussian_contDiff.continuous
    continuous_gaussianDeriv hasDerivAt_gaussian
    1 B hgaussianbound hderivbound w
  have hfun :
      (fun y ↦ (gaussian ⋆[ContinuousLinearMap.mul ℝ ℝ]
        conePhiPhysicalReal) y) =
        fun y ↦ (conePhiPhysicalReal ⋆[ContinuousLinearMap.mul ℝ ℝ]
          gaussian) y := by
    funext y
    exact convolution_mul_comm gaussian conePhiPhysicalReal y
  have hvalue :
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        conePhiPhysicalReal) w =
        (conePhiPhysicalReal ⋆[ContinuousLinearMap.mul ℝ ℝ]
          gaussianDeriv) w :=
    convolution_mul_comm gaussianDeriv conePhiPhysicalReal w
  rw [hfun, hvalue]
  exact hbase

/-- The literal low kernel is the translated low Gaussian--Schwartz
convolution. -/
theorem ModelLowKernel_eq_convolution_translate (u w : ℝ) :
    ModelLowKernel u w =
      (gaussian ⋆[ContinuousLinearMap.mul ℝ ℝ] conePhiPhysicalReal) (w - u) := by
  rw [convolution_mul]
  unfold ModelLowKernel
  apply integral_congr_ae
  filter_upwards [] with z
  congr 1
  ring

/-- The displayed low-kernel derivative is an actual spatial derivative. -/
theorem hasDerivAt_ModelLowKernel (u w : ℝ) :
    HasDerivAt (ModelLowKernel u) (ModelLowKernelDeriv u w) w := by
  have hbase := hasDerivAt_low_convolution (w - u)
  have htranslate := hbase.comp w
    ((hasDerivAt_id w).sub (hasDerivAt_const w u))
  rw [show ModelLowKernel u = fun y ↦
      (gaussian ⋆[ContinuousLinearMap.mul ℝ ℝ] conePhiPhysicalReal) (y - u) by
        funext y
        exact ModelLowKernel_eq_convolution_translate u y]
  have hcomp :
      (fun y : ℝ ↦ (gaussian ⋆[ContinuousLinearMap.mul ℝ ℝ]
        conePhiPhysicalReal) y) ∘ (id - fun _ : ℝ ↦ u) =
        fun y : ℝ ↦ (gaussian ⋆[ContinuousLinearMap.mul ℝ ℝ]
          conePhiPhysicalReal) (y - u) := by
    funext y
    simp
  rw [hcomp] at htranslate
  simpa only [sub_zero, mul_one, ModelLowKernelDeriv] using htranslate

/-- The low-kernel derivative has the same order-ten polynomial decay as the
source's fixed Schwartz kernel. -/
theorem low_deriv_convolution_polynomial_decay :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      (1 + |x|) ^ 10 *
        |(gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          conePhiPhysicalReal) x| ≤ C := by
  rcases gaussianDeriv_polynomial_decay 10 with ⟨Ch, hCh, hh⟩
  rcases conePhiPhysicalReal_decay 20 with ⟨Cphi, hCphi, hphi⟩
  have hphiweighted : Integrable (fun y : ℝ ↦
      (1 + |y|) ^ 10 * |conePhiPhysicalReal y|) :=
    integrable_weighted_abs_of_decay 10 conePhiPhysicalReal
      conePhiPhysicalReal.continuous.aestronglyMeasurable hphi
  have hconv := convolution_decay_of_weighted_bound 10
    gaussianDeriv conePhiPhysicalReal continuous_gaussianDeriv.measurable
    conePhiPhysicalReal.continuous.measurable conePhiPhysicalReal.integrable
    hphiweighted hh
  let C : ℝ := Ch * ∫ y : ℝ,
    (1 + |y|) ^ 10 * |conePhiPhysicalReal y|
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg hCh (integral_nonneg fun y ↦ by positivity)
  exact ⟨C, hC, fun x ↦ hconv x⟩

/-- The actual low-kernel derivative obeys the translated bracket majorant. -/
theorem ModelLowKernelDeriv_translate_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u w : ℝ),
      |ModelLowKernelDeriv u w| ≤
        C * translationWeight u ^ 10 * bracketKernel w := by
  rcases low_deriv_convolution_polynomial_decay with ⟨C, hC, hdecay⟩
  rcases kernelAt_translate_bracket_of_polynomial_decay
    (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePhiPhysicalReal)
    ⟨C, hC, hdecay⟩ with ⟨D, hD, htranslate⟩
  refine ⟨D, hD, ?_⟩
  intro u w
  simpa only [ModelLowKernelDeriv, kernelAt, kernelDilate,
    inv_one, one_smul, div_one] using htranslate u w

/-- Differentiating a mass-normalized kernel dilation contributes precisely
one additional inverse scale. -/
theorem hasDerivAt_kernelDilate_of_hasDerivAt
    (k k' : ℝ → ℝ) (s y : ℝ) (hs : s ≠ 0)
    (hderiv : HasDerivAt k (k' (y / s)) (y / s)) :
    HasDerivAt (kernelDilate k s)
      (s⁻¹ * kernelDilate k' s y) y := by
  unfold kernelDilate
  simp only [smul_eq_mul]
  have hinner : HasDerivAt (fun q : ℝ ↦ q / s) s⁻¹ y := by
    simpa only [div_eq_mul_inv, id_eq, one_mul] using
      (hasDerivAt_id y).mul_const s⁻¹
  have hmul := (hasDerivAt_const y s⁻¹).mul
    (hderiv.comp y hinner)
  have hfun :
      (fun _ : ℝ ↦ s⁻¹) * (k ∘ fun q : ℝ ↦ q / s) =
        fun q : ℝ ↦ s⁻¹ * k (q / s) := by
    funext q
    simp only [Pi.mul_apply, Function.comp_apply]
  rw [hfun] at hmul
  have hderivEq :
      s⁻¹ * (s⁻¹ * k' (y / s)) =
        0 * (k ∘ fun q : ℝ ↦ q / s) y +
          s⁻¹ * (k' (y / s) * s⁻¹) := by ring
  rw [hderivEq]
  exact hmul

/-- The scaled low-kernel derivative has the order-ten source-weight
bracket majorant needed for the bad-fiber cancellation argument. -/
theorem kernelDilate_ModelLowKernelDeriv_sourceWeight_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (j : Fin 3) (s y : ℝ), 0 < s →
      |kernelDilate (ModelLowKernelDeriv (u j)) s y| ≤
        C * sourceWeight u ^ 10 * bracketKernelAt s 0 y := by
  rcases ModelLowKernelDeriv_translate_bracket_majorant with
    ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u j s y hs
  have hbase := hbound (u j) (y / s)
  have hsinv : 0 ≤ s⁻¹ := (inv_pos.mpr hs).le
  have hcoordinate := translationWeight_coordinate_le_sourceWeight u j
  have hpow : translationWeight (u j) ^ 10 ≤ sourceWeight u ^ 10 :=
    pow_le_pow_left₀ (by unfold translationWeight; positivity) hcoordinate 10
  have hbracket : 0 ≤ bracketKernelAt s 0 y := (bracketKernelAt_pos hs).le
  unfold kernelDilate bracketKernelAt kernelAt kernelDilate
  simp only [sub_zero, smul_eq_mul]
  rw [abs_mul, abs_of_nonneg hsinv]
  calc
    s⁻¹ * |ModelLowKernelDeriv (u j) (y / s)| ≤
        s⁻¹ * (C * translationWeight (u j) ^ 10 *
          bracketKernel (y / s)) :=
      mul_le_mul_of_nonneg_left hbase hsinv
    _ = (C * (s⁻¹ * bracketKernel (y / s))) *
          translationWeight (u j) ^ 10 := by ring
    _ ≤ (C * (s⁻¹ * bracketKernel (y / s))) * sourceWeight u ^ 10 :=
      mul_le_mul_of_nonneg_left hpow
        (mul_nonneg hC (mul_nonneg hsinv (bracketKernel_nonneg _)))
    _ = C * sourceWeight u ^ 10 *
          (s⁻¹ * bracketKernel (y / s)) := by ring

/-- The literal scaled low kernel has an actual spatial derivative obeying
the source's inverse-scale bracket estimate. -/
theorem hasDerivAt_kernelDilate_ModelLowKernel
    (u : E3) (j : Fin 3) (s y : ℝ) (hs : 0 < s) :
    HasDerivAt (kernelDilate (ModelLowKernel (u j)) s)
      (s⁻¹ * kernelDilate (ModelLowKernelDeriv (u j)) s y) y := by
  exact hasDerivAt_kernelDilate_of_hasDerivAt
    (ModelLowKernel (u j)) (ModelLowKernelDeriv (u j)) s y hs.ne'
    (hasDerivAt_ModelLowKernel (u j) (y / s))

/-- The low active derivative satisfies the literal `s⁻¹`-times-bracket
bound. -/
theorem deriv_kernelDilate_ModelLowKernel_sourceWeight_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (j : Fin 3) (s y : ℝ), 0 < s →
      |s⁻¹ * kernelDilate (ModelLowKernelDeriv (u j)) s y| ≤
        C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y := by
  rcases kernelDilate_ModelLowKernelDeriv_sourceWeight_bracket_majorant with
    ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u j s y hs
  have hsinv : 0 ≤ s⁻¹ := (inv_pos.mpr hs).le
  have hmain := hbound u j s y hs
  rw [abs_mul, abs_of_nonneg hsinv]
  calc
    s⁻¹ * |kernelDilate (ModelLowKernelDeriv (u j)) s y| ≤
        s⁻¹ * (C * sourceWeight u ^ 10 * bracketKernelAt s 0 y) :=
      mul_le_mul_of_nonneg_left hmain hsinv
    _ = C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y := by ring



/-- The second derivative of the fixed Gaussian, written in a form adapted
to polynomial decay estimates. -/
noncomputable def gaussianSecondDeriv (x : ℝ) : ℝ :=
  (4 * Real.pi ^ 2 * x ^ 2 - 2 * Real.pi) * gaussian x

/-- The displayed second Gaussian derivative is genuine. -/
theorem hasDerivAt_gaussianDeriv_second (x : ℝ) :
    HasDerivAt gaussianDeriv (gaussianSecondDeriv x) x := by
  have hlinear : HasDerivAt (fun y : ℝ ↦ -2 * Real.pi * y)
      (-2 * Real.pi) x := by
    convert! (hasDerivAt_const x (-2 * Real.pi)).mul
      (hasDerivAt_id x) using 1 <;> ring
  have h := hlinear.mul (hasDerivAt_gaussian x)
  unfold gaussianDeriv gaussianSecondDeriv
  convert! h using 1 <;> simp only [gaussianDeriv] <;> ring

/-- The second Gaussian derivative is continuous. -/
theorem continuous_gaussianSecondDeriv :
    Continuous gaussianSecondDeriv := by
  unfold gaussianSecondDeriv
  apply Continuous.mul
  · fun_prop
  · exact gaussian_contDiff.continuous

/-- Every polynomial weight is bounded against the second Gaussian
derivative. -/
theorem gaussianSecondDeriv_polynomial_decay (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      (1 + |x|) ^ n * |gaussianSecondDeriv x| ≤ C := by
  rcases gaussian_polynomial_decay (n + 2) with ⟨Cg, hCg, hgaussian⟩
  refine ⟨(2 * Real.pi + 4 * Real.pi ^ 2) * Cg,
    mul_nonneg (by positivity) hCg, ?_⟩
  intro x
  have hcoeff : |4 * Real.pi ^ 2 * x ^ 2 - 2 * Real.pi| ≤
      2 * Real.pi + 4 * Real.pi ^ 2 * |x| ^ 2 := by
    calc
      |4 * Real.pi ^ 2 * x ^ 2 - 2 * Real.pi| =
          |4 * Real.pi ^ 2 * x ^ 2 + -(2 * Real.pi)| := by ring
      _ ≤ |4 * Real.pi ^ 2 * x ^ 2| + |-(2 * Real.pi)| :=
        abs_add_le _ _
      _ = 2 * Real.pi + 4 * Real.pi ^ 2 * |x| ^ 2 := by
        simp only [abs_mul, abs_neg, abs_pow,
          abs_of_pos Real.pi_pos]
        norm_num
        ring
  have hfirst :
      (1 + |x|) ^ n * gaussian x ≤
        (1 + |x|) ^ (n + 2) * gaussian x := by
    apply mul_le_mul_of_nonneg_right
      (pow_le_pow_right₀ (a := 1 + |x|) (by linarith [abs_nonneg x])
        (Nat.le_add_right n 2))
      (gaussian_nonneg x)
  have hsecond :
      (1 + |x|) ^ n * |x| ^ 2 * gaussian x ≤
        (1 + |x|) ^ (n + 2) * gaussian x := by
    calc
      (1 + |x|) ^ n * |x| ^ 2 * gaussian x ≤
          ((1 + |x|) ^ n * (1 + |x|) ^ 2) * gaussian x := by
        apply mul_le_mul_of_nonneg_right _ (gaussian_nonneg x)
        apply mul_le_mul_of_nonneg_left _ (pow_nonneg (by positivity) _)
        nlinarith [abs_nonneg x]
      _ = (1 + |x|) ^ (n + 2) * gaussian x := by
        rw [← pow_add]
  unfold gaussianSecondDeriv
  rw [abs_mul, abs_of_nonneg (gaussian_nonneg x)]
  calc
    (1 + |x|) ^ n *
        (|4 * Real.pi ^ 2 * x ^ 2 - 2 * Real.pi| * gaussian x) ≤
        (1 + |x|) ^ n *
          (2 * Real.pi + 4 * Real.pi ^ 2 * |x| ^ 2) * gaussian x := by
      calc
        (1 + |x|) ^ n *
            (|4 * Real.pi ^ 2 * x ^ 2 - 2 * Real.pi| * gaussian x) =
            ((1 + |x|) ^ n *
              |4 * Real.pi ^ 2 * x ^ 2 - 2 * Real.pi|) * gaussian x := by ring
        _ ≤ ((1 + |x|) ^ n *
              (2 * Real.pi + 4 * Real.pi ^ 2 * |x| ^ 2)) * gaussian x := by
          apply mul_le_mul_of_nonneg_right _ (gaussian_nonneg x)
          exact mul_le_mul_of_nonneg_left hcoeff (pow_nonneg (by positivity) _)
        _ = (1 + |x|) ^ n *
            (2 * Real.pi + 4 * Real.pi ^ 2 * |x| ^ 2) * gaussian x := by ring
    _ = 2 * Real.pi * ((1 + |x|) ^ n * gaussian x) +
        4 * Real.pi ^ 2 * ((1 + |x|) ^ n * |x| ^ 2 * gaussian x) := by ring
    _ ≤ 2 * Real.pi * Cg + 4 * Real.pi ^ 2 * Cg := by
      apply add_le_add
      · exact mul_le_mul_of_nonneg_left (hfirst.trans (hgaussian x))
          (by positivity)
      · exact mul_le_mul_of_nonneg_left (hsecond.trans (hgaussian x))
          (by positivity)
    _ = (2 * Real.pi + 4 * Real.pi ^ 2) * Cg := by ring

/-- The second Gaussian derivative is globally bounded. -/
theorem exists_bound_gaussianSecondDeriv :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ x : ℝ, ‖gaussianSecondDeriv x‖ ≤ B := by
  rcases gaussianSecondDeriv_polynomial_decay 0 with
    ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro x
  rw [Real.norm_eq_abs]
  simpa using hbound x

/-- The unscaled derivative of the translated third model kernel. -/
noncomputable def ModelThirdKernelDeriv (u w : ℝ) : ℝ :=
  (gaussianSecondDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
    (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
      conePsiPhysicalReal)) (w - u)

/-- Differentiating the outer Gaussian derivative in the double annular
convolution gives the displayed third-kernel derivative. -/
theorem hasDerivAt_third_convolution (w : ℝ) :
    HasDerivAt (fun y ↦
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          conePsiPhysicalReal)) y)
      ((gaussianSecondDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          conePsiPhysicalReal)) w) w := by
  rcases exists_bound_gaussianDeriv with ⟨A, hA, hgaussianDeriv⟩
  rcases exists_bound_gaussianSecondDeriv with ⟨B, hB, hsecond⟩
  have hinner : Integrable
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        conePsiPhysicalReal) :=
    integrable_gaussianDeriv.integrable_convolution
      (ContinuousLinearMap.mul ℝ ℝ) conePsiPhysicalReal.integrable
  have hbase := hasDerivAt_convolution_right_of_bound
    (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
      conePsiPhysicalReal) gaussianDeriv gaussianSecondDeriv
    hinner continuous_gaussianDeriv continuous_gaussianSecondDeriv
    hasDerivAt_gaussianDeriv_second A B hgaussianDeriv hsecond w
  have hfun :
      (fun y ↦ (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          conePsiPhysicalReal)) y) =
        fun y ↦ ((gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          conePsiPhysicalReal) ⋆[ContinuousLinearMap.mul ℝ ℝ]
          gaussianDeriv) y := by
    funext y
    exact convolution_mul_comm gaussianDeriv
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        conePsiPhysicalReal) y
  have hvalue :
      (gaussianSecondDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          conePsiPhysicalReal)) w =
        ((gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          conePsiPhysicalReal) ⋆[ContinuousLinearMap.mul ℝ ℝ]
          gaussianSecondDeriv) w :=
    convolution_mul_comm gaussianSecondDeriv
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        conePsiPhysicalReal) w
  rw [hfun, hvalue]
  exact hbase

/-- The literal third kernel is the translation of the fixed double
Gaussian-derivative/annular convolution. -/
theorem ModelThirdKernel_eq_convolution_translate (u w : ℝ) :
    ModelThirdKernel u w =
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          conePsiPhysicalReal)) (w - u) := by
  rw [convolution_mul]
  unfold ModelThirdKernel
  apply integral_congr_ae
  filter_upwards [] with z
  rw [modelThirdKernel_unit_eq_convolution u (w - z)]
  congr 1
  ring

/-- The displayed third-kernel derivative is an actual spatial derivative. -/
theorem hasDerivAt_ModelThirdKernel (u w : ℝ) :
    HasDerivAt (ModelThirdKernel u) (ModelThirdKernelDeriv u w) w := by
  have hbase := hasDerivAt_third_convolution (w - u)
  have htranslate := hbase.comp w
    ((hasDerivAt_id w).sub (hasDerivAt_const w u))
  have hcomp :
      (fun y : ℝ ↦ (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          conePsiPhysicalReal)) y) ∘ (id - fun _ : ℝ ↦ u) =
        fun y : ℝ ↦ (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
            conePsiPhysicalReal)) (y - u) := by
    funext y
    simp
  rw [hcomp] at htranslate
  rw [show ModelThirdKernel u = fun y ↦
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          conePsiPhysicalReal)) (y - u) by
        funext y
        exact ModelThirdKernel_eq_convolution_translate u y]
  simpa only [sub_zero, mul_one, ModelThirdKernelDeriv] using htranslate

/-- The third-kernel derivative has order-ten polynomial decay. -/
theorem third_deriv_convolution_polynomial_decay :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      (1 + |x|) ^ 10 *
        |(gaussianSecondDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
            conePsiPhysicalReal)) x| ≤ C := by
  rcases gaussianSecondDeriv_polynomial_decay 10 with
    ⟨Csecond, hCsecond, hsecond⟩
  have hinner : Integrable
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        conePsiPhysicalReal) :=
    integrable_gaussianDeriv.integrable_convolution
      (ContinuousLinearMap.mul ℝ ℝ) conePsiPhysicalReal.integrable
  have hinnermeas : Measurable
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        conePsiPhysicalReal) := by
    rcases exists_bound_gaussianDeriv with ⟨A, hA, hbound⟩
    have hbounded : BddAbove
        (Set.range fun x : ℝ ↦ ‖gaussianDeriv x‖) := by
      refine ⟨A, ?_⟩
      rintro _ ⟨x, rfl⟩
      exact hbound x
    exact (hbounded.continuous_convolution_left_of_integrable
      (ContinuousLinearMap.mul ℝ ℝ) continuous_gaussianDeriv
      conePsiPhysicalReal.integrable).measurable
  have hconv := convolution_decay_of_weighted_bound 10
    gaussianSecondDeriv
    (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
      conePsiPhysicalReal)
    continuous_gaussianSecondDeriv.measurable hinnermeas
    hinner integrable_weighted_annular_convolution hsecond
  let C : ℝ := Csecond * ∫ y : ℝ, (1 + |y|) ^ 10 *
    |(gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
      conePsiPhysicalReal) y|
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg hCsecond (integral_nonneg fun y ↦ by positivity)
  exact ⟨C, hC, fun x ↦ hconv x⟩

/-- The actual third-kernel derivative obeys the translated bracket
majorant. -/
theorem ModelThirdKernelDeriv_translate_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u w : ℝ),
      |ModelThirdKernelDeriv u w| ≤
        C * translationWeight u ^ 10 * bracketKernel w := by
  rcases third_deriv_convolution_polynomial_decay with
    ⟨C, hC, hdecay⟩
  let K : ℝ → ℝ := gaussianSecondDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
    (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
      conePsiPhysicalReal)
  rcases kernelAt_translate_bracket_of_polynomial_decay K
    ⟨C, hC, by simpa only [K] using hdecay⟩ with ⟨D, hD, htranslate⟩
  refine ⟨D, hD, ?_⟩
  intro u w
  simpa only [ModelThirdKernelDeriv, K, kernelAt, kernelDilate,
    inv_one, one_smul, div_one] using htranslate u w

/-- The scaled third-kernel derivative has the order-ten source-weight
bracket majorant needed for the bad-fiber cancellation argument. -/
theorem kernelDilate_ModelThirdKernelDeriv_sourceWeight_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (j : Fin 3) (s y : ℝ), 0 < s →
      |kernelDilate (ModelThirdKernelDeriv (u j)) s y| ≤
        C * sourceWeight u ^ 10 * bracketKernelAt s 0 y := by
  rcases ModelThirdKernelDeriv_translate_bracket_majorant with
    ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u j s y hs
  have hbase := hbound (u j) (y / s)
  have hsinv : 0 ≤ s⁻¹ := (inv_pos.mpr hs).le
  have hcoordinate := translationWeight_coordinate_le_sourceWeight u j
  have hpow : translationWeight (u j) ^ 10 ≤ sourceWeight u ^ 10 :=
    pow_le_pow_left₀ (by unfold translationWeight; positivity) hcoordinate 10
  have hbracket : 0 ≤ bracketKernelAt s 0 y := (bracketKernelAt_pos hs).le
  unfold kernelDilate bracketKernelAt kernelAt kernelDilate
  simp only [sub_zero, smul_eq_mul]
  rw [abs_mul, abs_of_nonneg hsinv]
  calc
    s⁻¹ * |ModelThirdKernelDeriv (u j) (y / s)| ≤
        s⁻¹ * (C * translationWeight (u j) ^ 10 *
          bracketKernel (y / s)) :=
      mul_le_mul_of_nonneg_left hbase hsinv
    _ = (C * (s⁻¹ * bracketKernel (y / s))) *
          translationWeight (u j) ^ 10 := by ring
    _ ≤ (C * (s⁻¹ * bracketKernel (y / s))) * sourceWeight u ^ 10 :=
      mul_le_mul_of_nonneg_left hpow
        (mul_nonneg hC (mul_nonneg hsinv (bracketKernel_nonneg _)))
    _ = C * sourceWeight u ^ 10 *
          (s⁻¹ * bracketKernel (y / s)) := by ring

/-- The literal scaled third kernel has an actual spatial derivative obeying
the source's inverse-scale bracket estimate. -/
theorem hasDerivAt_kernelDilate_ModelThirdKernel
    (u : E3) (j : Fin 3) (s y : ℝ) (hs : 0 < s) :
    HasDerivAt (kernelDilate (ModelThirdKernel (u j)) s)
      (s⁻¹ * kernelDilate (ModelThirdKernelDeriv (u j)) s y) y := by
  exact hasDerivAt_kernelDilate_of_hasDerivAt
    (ModelThirdKernel (u j)) (ModelThirdKernelDeriv (u j)) s y hs.ne'
    (hasDerivAt_ModelThirdKernel (u j) (y / s))

/-- The third active derivative satisfies the literal `s⁻¹`-times-bracket
bound. -/
theorem deriv_kernelDilate_ModelThirdKernel_sourceWeight_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (j : Fin 3) (s y : ℝ), 0 < s →
      |s⁻¹ * kernelDilate (ModelThirdKernelDeriv (u j)) s y| ≤
        C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y := by
  rcases kernelDilate_ModelThirdKernelDeriv_sourceWeight_bracket_majorant with
    ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u j s y hs
  have hsinv : 0 ≤ s⁻¹ := (inv_pos.mpr hs).le
  have hmain := hbound u j s y hs
  rw [abs_mul, abs_of_nonneg hsinv]
  calc
    s⁻¹ * |kernelDilate (ModelThirdKernelDeriv (u j)) s y| ≤
        s⁻¹ * (C * sourceWeight u ^ 10 * bracketKernelAt s 0 y) :=
      mul_le_mul_of_nonneg_left hmain hsinv
    _ = C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y := by ring

/-- The spatial derivative of the active kernel, choosing the annular
derivative exactly in the active coordinate. -/
noncomputable def activeModelKernelDeriv
    (i j : Fin 3) (u : E3) : ℝ → ℝ :=
  if j = i then ModelThirdKernelDeriv (u j)
  else ModelLowKernelDeriv (u j)

/-- Every scaled active model kernel has the displayed genuine spatial
derivative. -/
theorem hasDerivAt_kernelDilate_activeModelKernel
    (i j : Fin 3) (u : E3) (s y : ℝ) (hs : 0 < s) :
    HasDerivAt (kernelDilate (activeModelKernel i j u) s)
      (s⁻¹ * kernelDilate (activeModelKernelDeriv i j u) s y) y := by
  by_cases hji : j = i
  · subst j
    simp only [activeModelKernel, activeModelKernelDeriv]
    exact hasDerivAt_kernelDilate_ModelThirdKernel u i s y hs
  · simp only [activeModelKernel, activeModelKernelDeriv, if_neg hji]
    exact hasDerivAt_kernelDilate_ModelLowKernel u j s y hs

/-- Uniform source-weight derivative bracket bound for all three active
kernels.  This is the literal derivative clause of `lem:fiber_kernel`. -/
theorem deriv_kernelDilate_activeModelKernel_sourceWeight_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i j : Fin 3) (u : E3) (s y : ℝ), 0 < s →
      |s⁻¹ * kernelDilate (activeModelKernelDeriv i j u) s y| ≤
        C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y := by
  rcases deriv_kernelDilate_ModelLowKernel_sourceWeight_bracket_majorant with
    ⟨Clow, hClow, hlow⟩
  rcases deriv_kernelDilate_ModelThirdKernel_sourceWeight_bracket_majorant with
    ⟨Cthird, hCthird, hthird⟩
  refine ⟨max Clow Cthird, le_trans hClow (le_max_left _ _), ?_⟩
  intro i j u s y hs
  have hfactor : 0 ≤ sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y := by
    exact mul_nonneg
      (mul_nonneg (pow_nonneg (sourceWeight_nonneg u) _)
        (inv_pos.mpr hs).le)
      (bracketKernelAt_pos hs).le
  by_cases hji : j = i
  · subst j
    simp only [activeModelKernelDeriv]
    calc
      |s⁻¹ * kernelDilate (ModelThirdKernelDeriv (u i)) s y| ≤
          Cthird * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y :=
        hthird u i s y hs
      _ = Cthird * (sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y) := by ring
      _ ≤ max Clow Cthird *
          (sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y) :=
        mul_le_mul_of_nonneg_right (le_max_right _ _) hfactor
      _ = max Clow Cthird * sourceWeight u ^ 10 * s⁻¹ *
          bracketKernelAt s 0 y := by ring
  · simp only [activeModelKernelDeriv, if_neg hji]
    calc
      |s⁻¹ * kernelDilate (ModelLowKernelDeriv (u j)) s y| ≤
          Clow * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y :=
        hlow u j s y hs
      _ = Clow * (sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y) := by ring
      _ ≤ max Clow Cthird *
          (sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y) :=
        mul_le_mul_of_nonneg_right (le_max_left _ _) hfactor
      _ = max Clow Cthird * sourceWeight u ^ 10 * s⁻¹ *
          bracketKernelAt s 0 y := by ring


