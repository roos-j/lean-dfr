  by_cases h : σ i ≤ t
  · have hone : (1 : ℝ≥0∞) ≤ ENNReal.ofReal (t / σ i) := by
      rw [ENNReal.one_le_ofReal, le_div_iff₀ (hσ i), one_mul]
      exact h
