/-- **The localized symbol's derivative bound, with the constant chosen before
the multiplier.** -/
theorem exists_uniform_localizedSymbol_derivative_bound_of_anisotropy
    (α : Anisotropy) (i : Fin 3) (k : ℕ) (hk : k ≤ 110) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (M : ℝ) (m : E3 → ℂ),
