    (hcC : ∀ t : ℝ, |c t| ≤ Cc)
    (hf : ∀ jj, Measurable (f jj))
    (hBf : ∀ jj, 0 ≤ Bf jj) (hfB : ∀ jj, ∀ y : E3, |f jj y| ≤ Bf jj)
    (h : ∀ lam : ℝ, 0 < lam →
      ∃ (Zf : Set (TransverseSpace m))
        (Astop : FiberDyadicInterval → TransverseSpace m → ℝ)
