    (Zf : Set Z) (hZf : MeasurableSet Zf)
    (A : FiberDyadicInterval → Z → ℝ) (hA : ∀ I, Measurable (A I)) (H : ℝ)
    (hfinite : ∀ I ∈ T, μ (fiberDyadicSelectionSet Zf A H I) ≠ ∞) :
