            ENNReal.ofReal (-t₀ ^ (-r + 1) / (-r + 1)) := by
          rw [lintegral_Ioi_rpow (by linarith : (-r : ℝ) < -1) ht₀]
      _ = ENNReal.ofReal (A ^ r * (-t₀ ^ (-r + 1) / (-r + 1))) := by
          rw [← ENNReal.ofReal_mul (by positivity)]

