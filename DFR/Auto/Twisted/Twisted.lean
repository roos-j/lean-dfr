            ENNReal.ofReal (t ^ (-r)) := by
          refine lintegral_mono_ae ?_
          filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
          refine le_trans (hpow t (lt_trans ht₀ ht)) (le_of_eq ?_)
          rw [← ENNReal.ofReal_mul (by positivity)]
