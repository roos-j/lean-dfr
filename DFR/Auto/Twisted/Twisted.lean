/-- Complex Schwartz test functions on the source space `E_3`. -/
abbrev Schwartz3 := SchwartzMap E3 ℂ

/-- Pointwise product of two Schwartz test functions. -/
def schwartzProduct (f g : Schwartz3) : Schwartz3 :=
  SchwartzMap.smulLeftCLM ℂ (f : E3 → ℂ) g

@[simp]
theorem schwartzProduct_apply (f g : Schwartz3) (x : E3) :
