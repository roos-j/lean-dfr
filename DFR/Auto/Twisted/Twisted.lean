theorem schwartz_denseRange_toLp {p : ℝ≥0∞} (hp : p ≠ ⊤) [Fact (1 ≤ p)] :
    DenseRange (SchwartzMap.toLpCLM (E := E3) ℝ ℂ p (volume : Measure E3)) :=
  SchwartzMap.denseRange_toLpCLM (E := E3) (F := ℂ) hp

/-- The injective affine pullback from item (3) of Lemma `lem:schwartz`.

Mathlib supplies the Schwartz pullback operator for anti-Lipschitz maps.  In
finite dimension, an injective linear map is anti-Lipschitz, so this is the
source's affine-pullback statement with its finite-dimensional norm comparison
made explicit. -/
noncomputable def schwartzAffinePullbackOfInjective
    {𝕜 D E V : Type*} [RCLike 𝕜]
    [NormedAddCommGroup D] [NormedSpace ℝ D] [FiniteDimensional ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace 𝕜 V]
    [SMulCommClass ℝ 𝕜 V]
    (L : D →L[ℝ] E) (hL : Function.Injective L) (a : E)
    (f : SchwartzMap E V) : SchwartzMap D V := by
  let hAnti := (L.toLinearMap.injective_iff_antilipschitz).mp hL
  exact SchwartzMap.compCLMOfAntilipschitz 𝕜 L.hasTemperateGrowth
    (Classical.choose_spec hAnti).2 (f.compSubConstCLM 𝕜 (-a))

@[simp]
theorem schwartzAffinePullbackOfInjective_apply
    {𝕜 D E V : Type*} [RCLike 𝕜]
    [NormedAddCommGroup D] [NormedSpace ℝ D] [FiniteDimensional ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace 𝕜 V]
    [SMulCommClass ℝ 𝕜 V]
    (L : D →L[ℝ] E) (hL : Function.Injective L) (a : E)
    (f : SchwartzMap E V) (x : D) :
    schwartzAffinePullbackOfInjective (𝕜 := 𝕜) L hL a f x = f (L x + a) := by
  simp [schwartzAffinePullbackOfInjective]

/-- Derivatives of a Schwartz function pulled back by a coordinate projection
do not grow.  This elementary estimate is the analytic input for the external
product construction below. -/
theorem norm_iteratedFDeriv_fst_comp_le
    {D E : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : SchwartzMap D ℂ) (n : ℕ) (z : D × E) :
    ‖iteratedFDeriv ℝ n (fun w : D × E ↦ f w.1) z‖ ≤
      ‖iteratedFDeriv ℝ n f z.1‖ := by
  change ‖iteratedFDeriv ℝ n (f ∘ ContinuousLinearMap.fst ℝ D E) z‖ ≤ _
  rw [ContinuousLinearMap.iteratedFDeriv_comp_right
    (ContinuousLinearMap.fst ℝ D E) (f.smooth ⊤) z (by exact_mod_cast le_top)]
  calc
    _ ≤ ‖iteratedFDeriv ℝ n f z.1‖ *
        ∏ _ : Fin n, ‖ContinuousLinearMap.fst ℝ D E‖ :=
      ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv ℝ n f z.1‖ * 1 := by
      gcongr
      apply Finset.prod_le_one
      · intro i hi
        exact norm_nonneg _
      · intro i hi
        exact ContinuousLinearMap.norm_fst_le ℝ D E
    _ = _ := by ring

/-- The companion estimate for the second product coordinate. -/
theorem norm_iteratedFDeriv_snd_comp_le
    {D E : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (g : SchwartzMap E ℂ) (n : ℕ) (z : D × E) :
    ‖iteratedFDeriv ℝ n (fun w : D × E ↦ g w.2) z‖ ≤
      ‖iteratedFDeriv ℝ n g z.2‖ := by
  change ‖iteratedFDeriv ℝ n (g ∘ ContinuousLinearMap.snd ℝ D E) z‖ ≤ _
  rw [ContinuousLinearMap.iteratedFDeriv_comp_right
    (ContinuousLinearMap.snd ℝ D E) (g.smooth ⊤) z (by exact_mod_cast le_top)]
  calc
    _ ≤ ‖iteratedFDeriv ℝ n g z.2‖ *
        ∏ _ : Fin n, ‖ContinuousLinearMap.snd ℝ D E‖ :=
      ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv ℝ n g z.2‖ * 1 := by
      gcongr
      apply Finset.prod_le_one
      · intro i hi
        exact norm_nonneg _
      · intro i hi
        exact ContinuousLinearMap.norm_snd_le ℝ D E
    _ = _ := by ring

/-- The product norm is controlled by the two one-variable Schwartz weights.
This is the elementary decay bookkeeping behind finite tensor products. -/
theorem norm_prod_pow_le_product_one_add_pow
    {D E : Type*} [SeminormedAddCommGroup D] [SeminormedAddCommGroup E]
    (z : D × E) (k : ℕ) :
    ‖z‖ ^ k ≤ (1 + ‖z.1‖) ^ k * (1 + ‖z.2‖) ^ k := by
  rw [← mul_pow]
  apply pow_le_pow_left₀ (norm_nonneg _) ?_ k
  rw [Prod.norm_def]
  by_cases h : ‖z.1‖ ≤ ‖z.2‖
  · rw [max_eq_right h]
    nlinarith [mul_nonneg (show 0 ≤ ‖z.1‖ by positivity)
      (show 0 ≤ 1 + ‖z.2‖ by positivity)]
  · rw [max_eq_left (le_of_not_ge h)]
    nlinarith [mul_nonneg (show 0 ≤ ‖z.2‖ by positivity)
      (show 0 ≤ 1 + ‖z.1‖ by positivity)]

/-- The external product of two complex Schwartz functions.  This formalizes
the finite tensor-product closure used in item (2) of Lemma `lem:schwartz`.
The proof keeps the source's rapid-decay argument explicit rather than pulling
back along either coordinate projection, which would not be injective. -/
noncomputable def schwartzExternalProduct
    {D E : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : SchwartzMap D ℂ) (g : SchwartzMap E ℂ) : SchwartzMap (D × E) ℂ where
  toFun := fun z ↦ f z.1 * g z.2
  smooth' := (f.smooth ⊤).fst'.mul (g.smooth ⊤).snd'
  decay' := by
    intro k n
    let Cf : ℝ := 2 ^ k *
      (Finset.Iic (k, n)).sup (fun q ↦ SchwartzMap.seminorm ℂ q.1 q.2) f
    let Cg : ℝ := 2 ^ k *
      (Finset.Iic (k, n)).sup (fun q ↦ SchwartzMap.seminorm ℂ q.1 q.2) g
    have hf_bound (i : ℕ) (hi : i ≤ n) (x : D) :
        (1 + ‖x‖) ^ k * ‖iteratedFDeriv ℝ i f x‖ ≤ Cf := by
      exact SchwartzMap.one_add_le_sup_seminorm_apply (m := (k, n)) le_rfl hi f x
    have hg_bound (i : ℕ) (hi : i ≤ n) (y : E) :
        (1 + ‖y‖) ^ k * ‖iteratedFDeriv ℝ i g y‖ ≤ Cg := by
      exact SchwartzMap.one_add_le_sup_seminorm_apply (m := (k, n)) le_rfl hi g y
    have hCf : 0 ≤ Cf := by
      exact le_trans (by positivity) (hf_bound 0 (Nat.zero_le n) 0)
    have hCg : 0 ≤ Cg := by
      exact le_trans (by positivity) (hg_bound 0 (Nat.zero_le n) 0)
    refine ⟨∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * (Cf * Cg), fun z ↦ ?_⟩
    let F : D × E → ℂ := fun w ↦ f w.1
    let G : D × E → ℂ := fun w ↦ g w.2
    have hF : ContDiff ℝ (↑(⊤ : ℕ∞)) F := by
      change ContDiff ℝ (↑(⊤ : ℕ∞)) (fun w : D × E ↦ f.toFun w.1)
      exact (f.smooth').fst'
    have hG : ContDiff ℝ (↑(⊤ : ℕ∞)) G := by
      change ContDiff ℝ (↑(⊤ : ℕ∞)) (fun w : D × E ↦ g.toFun w.2)
      exact (g.smooth').snd'
    have hterm (i : ℕ) (hi : i ≤ n) :
        ‖z‖ ^ k * ‖iteratedFDeriv ℝ i F z‖ *
            ‖iteratedFDeriv ℝ (n - i) G z‖ ≤ Cf * Cg := by
      calc
        ‖z‖ ^ k * ‖iteratedFDeriv ℝ i F z‖ *
            ‖iteratedFDeriv ℝ (n - i) G z‖ ≤
            ‖z‖ ^ k * ‖iteratedFDeriv ℝ i f z.1‖ *
              ‖iteratedFDeriv ℝ (n - i) g z.2‖ := by
          gcongr
          · exact norm_iteratedFDeriv_fst_comp_le f i z
          · exact norm_iteratedFDeriv_snd_comp_le g (n - i) z
        _ ≤ (1 + ‖z.1‖) ^ k * (1 + ‖z.2‖) ^ k *
              ‖iteratedFDeriv ℝ i f z.1‖ *
              ‖iteratedFDeriv ℝ (n - i) g z.2‖ := by
          gcongr
          exact norm_prod_pow_le_product_one_add_pow z k
        _ = ((1 + ‖z.1‖) ^ k * ‖iteratedFDeriv ℝ i f z.1‖) *
              ((1 + ‖z.2‖) ^ k * ‖iteratedFDeriv ℝ (n - i) g z.2‖) := by
          ring
        _ ≤ Cf * Cg := by
          apply mul_le_mul
          · exact hf_bound i hi z.1
          · exact hg_bound (n - i) (Nat.sub_le _ _) z.2
          · positivity
          · exact hCf
    have hderiv := norm_iteratedFDeriv_mul_le hF hG z (n := n)
      (by exact_mod_cast le_top)
    have hbound :
        ‖z‖ ^ k * ‖iteratedFDeriv ℝ n (fun w ↦ F w * G w) z‖ ≤
          ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * (Cf * Cg) := by
      calc
        ‖z‖ ^ k * ‖iteratedFDeriv ℝ n (fun w ↦ F w * G w) z‖ ≤
            ‖z‖ ^ k *
              ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
                ‖iteratedFDeriv ℝ i F z‖ * ‖iteratedFDeriv ℝ (n - i) G z‖ := by
          exact mul_le_mul_of_nonneg_left hderiv (pow_nonneg (norm_nonneg _) _)
        _ = ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
              (‖z‖ ^ k * ‖iteratedFDeriv ℝ i F z‖ *
                ‖iteratedFDeriv ℝ (n - i) G z‖) := by
          rw [Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro i hi
          ring
        _ ≤ ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * (Cf * Cg) := by
          apply Finset.sum_le_sum
          intro i hi
          apply mul_le_mul_of_nonneg_left
          · exact hterm i (Finset.mem_range_succ_iff.mp hi)
          · positivity
    simpa only [F, G] using hbound

@[simp]
theorem schwartzExternalProduct_apply
    {D E : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : SchwartzMap D ℂ) (g : SchwartzMap E ℂ) (z : D × E) :
    schwartzExternalProduct f g z = f z.1 * g z.2 := rfl

/-- Restriction of a joint Schwartz function to a fixed first-coordinate
fibre.  This is item (4)'s fixed-fibre assertion, obtained from the injective
affine-pullback theorem rather than from an invalid projection pullback. -/
noncomputable def schwartzFixedFiber
    {D E V : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    (F : SchwartzMap (D × E) V) (u : D) : SchwartzMap E V :=
  schwartzAffinePullbackOfInjective (𝕜 := ℂ) (ContinuousLinearMap.inr ℝ D E)
    (by
      intro v w h
      change (0, v) = (0, w) at h
      exact Prod.ext_iff.mp h |>.2)
    (u, 0) F

@[simp]
theorem schwartzFixedFiber_apply
    {D E V : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    (F : SchwartzMap (D × E) V) (u : D) (v : E) :
    schwartzFixedFiber F u v = F (u, v) := by
  simp [schwartzFixedFiber, schwartzAffinePullbackOfInjective]

/-- A joint Schwartz estimate gives a uniform rapid-decay majorant in its
second coordinate.  This is the quantitative domination needed to justify
the parameter integral in item (4) of Lemma `lem:schwartz`. -/
theorem schwartz_uniform_second_decay
    {D E V : Type*}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    (F : SchwartzMap (D × E) V) (r n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ z : D × E,
      ‖iteratedFDeriv ℝ n F z‖ ≤ C / (1 + ‖z.2‖) ^ r := by
  let C : ℝ := 2 ^ r *
    (Finset.Iic (r, n)).sup (fun q ↦ SchwartzMap.seminorm ℂ q.1 q.2) F
  have hC : 0 ≤ C := by
    have h := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℂ)
      (m := (r, n)) le_rfl le_rfl F (0 : D × E)
    have hnonneg : 0 ≤ (1 + ‖(0 : D × E)‖) ^ r *
        ‖iteratedFDeriv ℝ n F (0 : D × E)‖ :=
      mul_nonneg (pow_nonneg (by positivity) _) (norm_nonneg _)
    exact hnonneg.trans (by simpa [C] using h)
  refine ⟨C, hC, fun z ↦ ?_⟩
  apply (le_div_iff₀ (by positivity)).mpr
  rw [mul_comm]
  calc
    (1 + ‖z.2‖) ^ r * ‖iteratedFDeriv ℝ n F z‖ ≤
        (1 + ‖z‖) ^ r * ‖iteratedFDeriv ℝ n F z‖ := by
      gcongr
      rw [Prod.norm_def]
      exact le_max_right _ _
    _ ≤ C := by
      simpa [C] using (SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℂ)
        (m := (r, n)) le_rfl le_rfl F z)

/-- A joint Schwartz estimate with a polynomial weight in the retained
coordinate and rapid decay in the integrated coordinate. -/
theorem schwartz_weighted_second_decay
    {D E V : Type*}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    (F : SchwartzMap (D × E) V) (k r n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ z : D × E,
      ‖z.1‖ ^ k * ‖iteratedFDeriv ℝ n F z‖ ≤ C / (1 + ‖z.2‖) ^ r := by
  let C : ℝ := 2 ^ (k + r) *
    (Finset.Iic (k + r, n)).sup (fun q ↦ SchwartzMap.seminorm ℂ q.1 q.2) F
  have hC : 0 ≤ C := by
    have h := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℂ)
      (m := (k + r, n)) le_rfl le_rfl F (0 : D × E)
    have hnonneg : 0 ≤ (1 + ‖(0 : D × E)‖) ^ (k + r) *
        ‖iteratedFDeriv ℝ n F (0 : D × E)‖ :=
      mul_nonneg (pow_nonneg (by positivity) _) (norm_nonneg _)
    exact hnonneg.trans (by simpa [C] using h)
  refine ⟨C, hC, fun z ↦ ?_⟩
  apply (le_div_iff₀ (by positivity)).mpr
  have hz1 : ‖z.1‖ ≤ 1 + ‖z‖ := by
    rw [Prod.norm_def]
    exact le_trans (le_max_left _ _) (by linarith [norm_nonneg z])
  have hz2 : 1 + ‖z.2‖ ≤ 1 + ‖z‖ := by
    rw [Prod.norm_def]
    gcongr
    exact le_max_right _ _
  calc
    (‖z.1‖ ^ k * ‖iteratedFDeriv ℝ n F z‖) * (1 + ‖z.2‖) ^ r =
        (‖z.1‖ ^ k * (1 + ‖z.2‖) ^ r) * ‖iteratedFDeriv ℝ n F z‖ := by ring
    _ ≤ ((1 + ‖z‖) ^ k * (1 + ‖z‖) ^ r) * ‖iteratedFDeriv ℝ n F z‖ := by
      gcongr
    _ = (1 + ‖z‖) ^ (k + r) * ‖iteratedFDeriv ℝ n F z‖ := by rw [← pow_add]
    _ ≤ C := by
      simpa [C] using (SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℂ)
        (m := (k + r, n)) le_rfl le_rfl F z)

/-- The reciprocal polynomial majorant used for parameter integration is
integrable whenever its exponent is one above the dimension. -/
theorem integrable_second_weight
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
    {μ : Measure E} [μ.IsAddHaarMeasure] (C : ℝ) :
    Integrable (fun v : E ↦ C / (1 + ‖v‖) ^ (Module.finrank ℝ E + 1)) μ := by
  have hr : (Module.finrank ℝ E : ℝ) <
      (↑(Module.finrank ℝ E + 1) : ℝ) := by
    exact_mod_cast Nat.lt_succ_self (Module.finrank ℝ E)
  have h := (integrable_one_add_norm (E := E) (μ := μ) hr).const_mul C
  convert h using 1
  ext v
  rw [Real.rpow_neg (by positivity), ← Real.rpow_natCast]
  ring

/-- The derivative of a joint function in its first coordinate, retained as a
Schwartz function with continuous-linear-map values. -/
noncomputable def schwartzFiberFDeriv
    {D E V : Type*}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    (F : SchwartzMap (D × E) V) : SchwartzMap (D × E) (D →L[ℝ] V) :=
  (SchwartzMap.fderivCLM ℂ (D × E) V F).postcompCLM
    ((ContinuousLinearMap.compL ℝ D (D × E) V).flip (ContinuousLinearMap.inl ℝ D E))

@[simp]
theorem schwartzFiberFDeriv_apply
    {D E V : Type*}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    (F : SchwartzMap (D × E) V) (z : D × E) (h : D) :
    schwartzFiberFDeriv F z h = fderiv ℝ F z (h, 0) := rfl

/-- A first-coordinate slice of a joint Schwartz function has the derivative
obtained by restricting the joint Fréchet derivative to that coordinate. -/
theorem hasFDerivAt_schwartzFiberSlice
    {D E V : Type*}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    (F : SchwartzMap (D × E) V) (u : D) (v : E) :
    HasFDerivAt (fun x : D ↦ F (x, v)) (schwartzFiberFDeriv F (u, v)) u := by
  have hlin : HasFDerivAt (fun x : D ↦ (x, v))
      (ContinuousLinearMap.inl ℝ D E) u := by
    simpa [ContinuousLinearMap.inl_apply] using
      ((ContinuousLinearMap.inl ℝ D E).hasFDerivAt (x := u) |>.add_const (0, v))
  convert (F.hasFDerivAt (u, v)).comp u hlin using 1
  · rfl
  · ext h
    rfl

/-- Integrate a joint Schwartz function in its second variable.  The following
dominated-differentiation theorem supplies its first derivative; the full
Schwartz construction below iterates this identity. -/
noncomputable def schwartzFiberIntegral
    {D E V : Type*}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [MeasurableSpace E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    (μ : Measure E) (F : SchwartzMap (D × E) V) : D → V :=
  fun u ↦ ∫ v, F (u, v) ∂μ

/-- Differentiation under the parameter integral for a joint Schwartz
function.  Its majorant is the explicit dimension-plus-one reciprocal weight
proved above, so no unrecorded Fubini or domination assumption is used. -/
theorem schwartzFiberIntegral_hasFDerivAt
    {D E V : Type*}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    {μ : Measure E} [μ.IsAddHaarMeasure]
    (F : SchwartzMap (D × E) V) (u : D) :
    HasFDerivAt (schwartzFiberIntegral μ F)
      (∫ v, schwartzFiberFDeriv F (u, v) ∂μ) u := by
  obtain ⟨C, hC, hdecay⟩ :=
    schwartz_uniform_second_decay (schwartzFiberFDeriv F)
      (Module.finrank ℝ E + 1) 0
  let bound : E → ℝ := fun v ↦ C / (1 + ‖v‖) ^ (Module.finrank ℝ E + 1)
  have hF_meas : ∀ᶠ x in 𝓝 u, AEStronglyMeasurable (fun v ↦ F (x, v)) μ :=
    Filter.Eventually.of_forall fun x ↦ by
      simpa only [← schwartzFixedFiber_apply] using
        ((schwartzFixedFiber F x).integrable (μ := μ)).aestronglyMeasurable
  have hF_int : Integrable (fun v ↦ F (u, v)) μ := by
    simpa only [← schwartzFixedFiber_apply] using
      (schwartzFixedFiber F u).integrable (μ := μ)
  have hF'_meas : AEStronglyMeasurable
      (fun v ↦ schwartzFiberFDeriv F (u, v)) μ := by
    simpa only [← schwartzFixedFiber_apply] using
      ((schwartzFixedFiber (schwartzFiberFDeriv F) u).integrable (μ := μ)).aestronglyMeasurable
  have hbound : ∀ᵐ v ∂μ, ∀ x ∈ Set.univ,
      ‖schwartzFiberFDeriv F (x, v)‖ ≤ bound v :=
    Filter.Eventually.of_forall fun v x _ ↦ by
      simpa only [bound, norm_iteratedFDeriv_zero] using hdecay (x, v)
  have hbound_int : Integrable bound μ := by
    simpa only [bound] using integrable_second_weight (μ := μ) C
  have hdiff : ∀ᵐ v ∂μ, ∀ x ∈ Set.univ,
      HasFDerivAt (fun y : D ↦ F (y, v)) (schwartzFiberFDeriv F (x, v)) x :=
    Filter.Eventually.of_forall fun v x _ ↦ hasFDerivAt_schwartzFiberSlice F x v
  change HasFDerivAt (fun x : D ↦ ∫ v : E, F (x, v) ∂μ)
    (∫ v, schwartzFiberFDeriv F (u, v) ∂μ) u
  exact hasFDerivAt_integral_of_dominated_of_fderiv_le (s := Set.univ)
    univ_mem hF_meas hF_int hF'_meas hbound hbound_int hdiff

/-- Finite-order smoothness of the fiber integral.  The induction feeds the
Schwartz-valued first-coordinate derivative back into the same dominated
parameter-integral theorem. -/
theorem schwartzFiberIntegral_contDiff_nat
    {D E V : Type u}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    {μ : Measure E} [μ.IsAddHaarMeasure]
    (F : SchwartzMap (D × E) V) (n : ℕ) :
    ContDiff ℝ n (schwartzFiberIntegral μ F) := by
  induction n generalizing V with
  | zero =>
      apply contDiff_zero.2
      have hd : Differentiable ℝ (schwartzFiberIntegral μ F) :=
        fun u ↦ (schwartzFiberIntegral_hasFDerivAt F u).differentiableAt
      exact hd.continuous
  | succ n ih =>
      apply (contDiff_succ_iff_hasFDerivAt (n := n)).2
      refine ⟨schwartzFiberIntegral μ (schwartzFiberFDeriv F), ?_, ?_⟩
      · exact ih (schwartzFiberFDeriv F)
      · intro u
        exact schwartzFiberIntegral_hasFDerivAt F u

/-- The fiber integral is smooth to every finite order. -/
theorem schwartzFiberIntegral_smooth
    {D E V : Type u}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    {μ : Measure E} [μ.IsAddHaarMeasure]
    (F : SchwartzMap (D × E) V) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (schwartzFiberIntegral μ F) := by
  rw [contDiff_infty]
  intro n
  exact schwartzFiberIntegral_contDiff_nat F n

/-- Zeroth-order weighted decay of a fiber integral. -/
theorem schwartzFiberIntegral_decay_zero
    {D E V : Type u}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    {μ : Measure E} [μ.IsAddHaarMeasure]
    (F : SchwartzMap (D × E) V) (k : ℕ) :
    ∃ C : ℝ, ∀ u : D,
      ‖u‖ ^ k * ‖schwartzFiberIntegral μ F u‖ ≤ C := by
  let r : ℕ := Module.finrank ℝ E + 1
  obtain ⟨C, hC, hdecay⟩ := schwartz_weighted_second_decay F k r 0
  let major : E → ℝ := fun v ↦ C / (1 + ‖v‖) ^ r
  have hmajor : Integrable major μ := by
    simpa only [major, r] using integrable_second_weight (μ := μ) C
  refine ⟨∫ v, major v ∂μ, fun u ↦ ?_⟩
  have hFu : Integrable (fun v : E ↦ F (u, v)) μ := by
    simpa only [← schwartzFixedFiber_apply] using
      (schwartzFixedFiber F u).integrable (μ := μ)
  have hnorm : Integrable (fun v : E ↦ ‖u‖ ^ k * ‖F (u, v)‖) μ :=
    hFu.norm.const_mul _
  calc
    ‖u‖ ^ k * ‖schwartzFiberIntegral μ F u‖ =
        ‖u‖ ^ k * ‖∫ v : E, F (u, v) ∂μ‖ := rfl
    _ ≤ ‖u‖ ^ k * ∫ v : E, ‖F (u, v)‖ ∂μ := by
      gcongr
      exact norm_integral_le_integral_norm _
    _ = ∫ v : E, ‖u‖ ^ k * ‖F (u, v)‖ ∂μ := by
      rw [integral_const_mul]
    _ ≤ ∫ v, major v ∂μ := by
      apply integral_mono hnorm hmajor
      intro v
      simpa only [major, norm_iteratedFDeriv_zero] using hdecay (u, v)

/-- Every iterated first-coordinate derivative of the fiber integral has the
required polynomial decay. -/
theorem schwartzFiberIntegral_decay
    {D E V : Type u}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    {μ : Measure E} [μ.IsAddHaarMeasure]
    (F : SchwartzMap (D × E) V) (k n : ℕ) :
    ∃ C : ℝ, ∀ u : D,
      ‖u‖ ^ k * ‖iteratedFDeriv ℝ n (schwartzFiberIntegral μ F) u‖ ≤ C := by
  induction n generalizing V with
  | zero =>
      simpa only [norm_iteratedFDeriv_zero] using schwartzFiberIntegral_decay_zero F k
  | succ n ih =>
      obtain ⟨C, hC⟩ := ih (V := D →L[ℝ] V) (schwartzFiberFDeriv F)
      refine ⟨C, fun u ↦ ?_⟩
      rw [← norm_iteratedFDeriv_fderiv]
      have heq : fderiv ℝ (schwartzFiberIntegral μ F) =
          schwartzFiberIntegral μ (schwartzFiberFDeriv F) := by
        funext u
        exact (schwartzFiberIntegral_hasFDerivAt F u).fderiv
      rw [heq]
      exact hC u

/-- Integration over a fixed Euclidean fiber preserves the Schwartz class.
This packages the smoothness and all weighted derivative estimates above into
item (4) of Lemma `lem:schwartz`. -/
noncomputable def schwartzFiberIntegralMap
    {D E V : Type u}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    {μ : Measure E} [μ.IsAddHaarMeasure]
    (F : SchwartzMap (D × E) V) : SchwartzMap D V where
  toFun := schwartzFiberIntegral μ F
  smooth' := schwartzFiberIntegral_smooth F
  decay' := schwartzFiberIntegral_decay F

@[simp]
theorem schwartzFiberIntegralMap_apply
    {D E V : Type u}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    {μ : Measure E} [μ.IsAddHaarMeasure]
    (F : SchwartzMap (D × E) V) (u : D) :
    schwartzFiberIntegralMap (μ := μ) F u = ∫ v : E, F (u, v) ∂μ := rfl

/-- The absolute fiber integrals of a joint Schwartz function are uniformly
bounded in the retained parameter. -/
theorem schwartz_uniform_fiber_norm_integral
    {D E V : Type u}
    [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    [MeasurableSpace E] [BorelSpace E]
    [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedSpace ℂ V]
    [SMulCommClass ℝ ℂ V]
    {μ : Measure E} [μ.IsAddHaarMeasure]
    (F : SchwartzMap (D × E) V) :
    ∃ C : ℝ, ∀ u : D, ∫ v : E, ‖F (u, v)‖ ∂μ ≤ C := by
  let r : ℕ := Module.finrank ℝ E + 1
  obtain ⟨C, hC, hdecay⟩ := schwartz_weighted_second_decay F 0 r 0
  let major : E → ℝ := fun v ↦ C / (1 + ‖v‖) ^ r
  have hmajor : Integrable major μ := by
    simpa only [major, r] using integrable_second_weight (μ := μ) C
  refine ⟨∫ v, major v ∂μ, fun u ↦ ?_⟩
  have hFu : Integrable (fun v : E ↦ F (u, v)) μ := by
    simpa only [← schwartzFixedFiber_apply] using
      (schwartzFixedFiber F u).integrable (μ := μ)
  apply integral_mono hFu.norm hmajor
  intro v
  simpa only [major, norm_iteratedFDeriv_zero, pow_zero, one_mul] using hdecay (u, v)

/-- The source's linear coordinate shear `(x,t) ↦ (x - t e_i,t)`. -/
noncomputable def coordinateShear (i : Fin 3) : E3 × ℝ →L[ℝ] E3 × ℝ :=
  (ContinuousLinearMap.fst ℝ E3 ℝ -
      ((ContinuousLinearMap.id ℝ ℝ).smulRight (Anisotropy.coordinateDirection i) ∘L
        ContinuousLinearMap.snd ℝ E3 ℝ)).prod
    (ContinuousLinearMap.snd ℝ E3 ℝ)

@[simp]
theorem coordinateShear_apply (i : Fin 3) (z : E3 × ℝ) :
    coordinateShear i z = (z.1 - z.2 • Anisotropy.coordinateDirection i, z.2) := by
  simp [coordinateShear]

theorem coordinateShear_injective (i : Fin 3) : Function.Injective (coordinateShear i) := by
  intro z w h
  have hsecond : z.2 = w.2 := by
    simpa only [coordinateShear_apply] using congrArg Prod.snd h
  apply Prod.ext
  · have hfirst := congrArg Prod.fst h
    have hfirst' : z.1 - w.2 • Anisotropy.coordinateDirection i =
        w.1 - w.2 • Anisotropy.coordinateDirection i := by
      simpa only [coordinateShear_apply, hsecond] using hfirst
    calc
      z.1 = (z.1 - w.2 • Anisotropy.coordinateDirection i) +
          w.2 • Anisotropy.coordinateDirection i := (sub_add_cancel _ _).symm
      _ = (w.1 - w.2 • Anisotropy.coordinateDirection i) +
          w.2 • Anisotropy.coordinateDirection i := by rw [hfirst']
      _ = w.1 := sub_add_cancel _ _
  · exact hsecond

/-- Convolution of a three-dimensional Schwartz function along one coordinate
with a one-dimensional Schwartz kernel. -/
noncomputable def schwartzCoordinateConvolution
    (i : Fin 3) (f : Schwartz3) (g : SchwartzMap ℝ ℂ) : Schwartz3 :=
  schwartzFiberIntegralMap (μ := volume)
    (schwartzAffinePullbackOfInjective (𝕜 := ℂ) (coordinateShear i)
      (coordinateShear_injective i) 0 (schwartzExternalProduct f g))

@[simp]
theorem schwartzCoordinateConvolution_apply
    (i : Fin 3) (f : Schwartz3) (g : SchwartzMap ℝ ℂ) (x : E3) :
    schwartzCoordinateConvolution i f g x =
      ∫ t : ℝ, f (x - t • Anisotropy.coordinateDirection i) * g t := by
  simp [schwartzCoordinateConvolution]

/-- Evaluation in one Euclidean coordinate as a continuous linear map. -/
def coordinateProjection (i : Fin 3) : E3 →L[ℝ] ℝ where
  toFun := fun x ↦ x i
  map_add' := by
    intro x y
    rfl
  map_smul' := by
    intro c x
    rfl
  cont := PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i

@[simp]
theorem coordinateProjection_apply (i : Fin 3) (x : E3) :
    coordinateProjection i x = x i := rfl

@[simp]
theorem coordinateDirection_apply (i j : Fin 3) :
    Anisotropy.coordinateDirection i j = if j = i then 1 else 0 := by
  simp [Anisotropy.coordinateDirection]

/-- The `i`-th translated copy `x + t_i e_i` on the `(t,x)` parameter
space used in the source definition of `P_f`. -/
noncomputable def twistedShiftedCoordinate (i : Fin 3) : E3 × E3 →L[ℝ] E3 :=
  ContinuousLinearMap.snd ℝ E3 E3 +
    ((coordinateProjection i ∘L ContinuousLinearMap.fst ℝ E3 E3).smulRight
      (Anisotropy.coordinateDirection i))

@[simp]
theorem twistedShiftedCoordinate_apply (i : Fin 3) (z : E3 × E3) :
    twistedShiftedCoordinate i z = z.2 + z.1 i • Anisotropy.coordinateDirection i := by
  simp [twistedShiftedCoordinate]

/-- The injective source map `(t,x) ↦ (x,x+t₀e₀,x+t₁e₁,x+t₂e₂)`, grouped
as two pairs so it can be fed to iterated external products. -/
noncomputable def twistedProductLinear :
    E3 × E3 →L[ℝ] (E3 × E3) × (E3 × E3) :=
  ((ContinuousLinearMap.snd ℝ E3 E3).prod (twistedShiftedCoordinate 0)).prod
    ((twistedShiftedCoordinate 1).prod (twistedShiftedCoordinate 2))

@[simp]
theorem twistedProductLinear_apply (z : E3 × E3) :
    twistedProductLinear z =
      ((z.2, twistedShiftedCoordinate 0 z),
        (twistedShiftedCoordinate 1 z, twistedShiftedCoordinate 2 z)) := by
  simp [twistedProductLinear]

theorem twistedProductLinear_injective : Function.Injective twistedProductLinear := by
  intro z w h
  have hbase : z.2 = w.2 := by
    have h' := congrArg (fun q : (E3 × E3) × (E3 × E3) ↦ q.1.1) h
    simpa only [twistedProductLinear_apply] using h'
  have hshift : ∀ i : Fin 3,
      twistedShiftedCoordinate i z = twistedShiftedCoordinate i w := by
    intro i
    fin_cases i
    · have h' := congrArg (fun q : (E3 × E3) × (E3 × E3) ↦ q.1.2) h
      change twistedShiftedCoordinate 0 z = twistedShiftedCoordinate 0 w
      simpa only [twistedProductLinear_apply] using h'
    · have h' := congrArg (fun q : (E3 × E3) × (E3 × E3) ↦ q.2.1) h
      change twistedShiftedCoordinate 1 z = twistedShiftedCoordinate 1 w
      simpa only [twistedProductLinear_apply] using h'
    · have h' := congrArg (fun q : (E3 × E3) × (E3 × E3) ↦ q.2.2) h
      change twistedShiftedCoordinate 2 z = twistedShiftedCoordinate 2 w
      simpa only [twistedProductLinear_apply] using h'
  apply Prod.ext
  · ext i
    have hi := congrArg (fun q : E3 ↦ q i) (hshift i)
    rw [twistedShiftedCoordinate_apply, twistedShiftedCoordinate_apply, hbase] at hi
    apply add_left_cancel (a := z.2 i)
    simpa [coordinateDirection_apply] using hi
  · exact hbase

/-- The joint Schwartz function whose fiber integral is the source's
translated product `P_f`. -/
noncomputable def schwartzTwistedProductJoint
    (f₀ f₁ f₂ f₃ : Schwartz3) : SchwartzMap (E3 × E3) ℂ :=
  schwartzAffinePullbackOfInjective (𝕜 := ℂ) twistedProductLinear
    twistedProductLinear_injective 0
    (schwartzExternalProduct (schwartzExternalProduct f₀ f₁)
      (schwartzExternalProduct f₂ f₃))

@[simp]
theorem schwartzTwistedProductJoint_apply
    (f₀ f₁ f₂ f₃ : Schwartz3) (z : E3 × E3) :
    schwartzTwistedProductJoint f₀ f₁ f₂ f₃ z =
      (f₀ z.2 * f₁ (z.2 + z.1 0 • Anisotropy.coordinateDirection 0)) *
        (f₂ (z.2 + z.1 1 • Anisotropy.coordinateDirection 1) *
          f₃ (z.2 + z.1 2 • Anisotropy.coordinateDirection 2)) := by
  simp [schwartzTwistedProductJoint]

/-- The translated product `P_f` from Definition `def:multiplier`. -/
noncomputable def twistedProduct
    (f₀ f₁ f₂ f₃ : Schwartz3) : Schwartz3 :=
  schwartzFiberIntegralMap (μ := volume) (schwartzTwistedProductJoint f₀ f₁ f₂ f₃)

@[simp]
theorem twistedProduct_apply
    (f₀ f₁ f₂ f₃ : Schwartz3) (t : E3) :
    twistedProduct f₀ f₁ f₂ f₃ t =
      ∫ x : E3,
        (f₀ x * f₁ (x + t 0 • Anisotropy.coordinateDirection 0)) *
          (f₂ (x + t 1 • Anisotropy.coordinateDirection 1) *
            f₃ (x + t 2 • Anisotropy.coordinateDirection 2)) := by
  simp [twistedProduct]

/-- Precomposition of a Schwartz function with negation. -/
noncomputable def schwartzNegate (f : Schwartz3) : Schwartz3 :=
  schwartzAffinePullbackOfInjective (𝕜 := ℂ) (-(ContinuousLinearMap.id ℝ E3))
    (by
      intro x y h
      change -x = -y at h
      exact neg_injective h)
    0 f

@[simp]
theorem schwartzNegate_apply (f : Schwartz3) (x : E3) :
    schwartzNegate f x = f (-x) := by
  simp [schwartzNegate, schwartzAffinePullbackOfInjective]

/-- The defining Fourier-side integral for the multiplier form in
Definition `def:multiplier`. -/
noncomputable def multiplierForm
    (m : E3 → ℂ) (f₀ f₁ f₂ f₃ : Schwartz3) : ℂ :=
  ∫ ξ : E3, m ξ * schwartzFourier (twistedProduct f₀ f₁ f₂ f₃) (-ξ)

/-- A bounded measurable multiplier can be multiplied against any Schwartz
test function under the Lebesgue integral. -/
theorem multiplier_mul_schwartz_integrable
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m) (f : Schwartz3) :
    Integrable (fun ξ : E3 ↦ m ξ * f ξ) :=
  f.integrable.bdd_mul hm.measurable.aestronglyMeasurable
    (Filter.Eventually.of_forall fun ξ ↦ hm.norm_le_all ξ)

/-- The bounded multiplier as an `L^∞` representative.  Using the `L^∞`
embedding is essential here: the source does not impose global smoothness at
the origin, so the smooth temperate-growth embedding is not applicable. -/
noncomputable def multiplierLp
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m) :
    MeasureTheory.Lp ℂ ⊤ (volume : Measure E3) :=
  (MeasureTheory.memLp_top_of_bound hm.measurable.aestronglyMeasurable M
    (Filter.Eventually.of_forall fun ξ ↦ hm.norm_le_all ξ)).toLp m

/-- The regular tempered distribution defined by the multiplier, including
its behavior at the origin. -/
noncomputable def multiplierRegularDistribution
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m) :
    TemperedDistribution E3 ℂ :=
  (multiplierLp α M m hm : TemperedDistribution E3 ℂ)

@[simp]
theorem multiplierRegularDistribution_apply
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m) (g : Schwartz3) :
    multiplierRegularDistribution α M m hm g = ∫ ξ : E3, g ξ * m ξ := by
  simp only [multiplierRegularDistribution, multiplierLp,
    MeasureTheory.Lp.toTemperedDistribution_apply]
  apply integral_congr_ae
  filter_upwards [MeasureTheory.MemLp.coeFn_toLp
    (MeasureTheory.memLp_top_of_bound hm.measurable.aestronglyMeasurable M
      (Filter.Eventually.of_forall fun ξ ↦ hm.norm_le_all ξ))] with ξ hξ
  simp [hξ]

/-- The inverse Fourier transform of the regular multiplier distribution,
which is the source kernel `K = 𝓕⁻ m`. -/
noncomputable def inverseMultiplierDistribution
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m) :
    TemperedDistribution E3 ℂ :=
  𝓕⁻ (multiplierRegularDistribution α M m hm)

@[simp]
theorem inverseMultiplierDistribution_apply
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m) (P : Schwartz3) :
    inverseMultiplierDistribution α M m hm P =
      ∫ ξ : E3, (𝓕⁻ P : Schwartz3) ξ * m ξ := by
  rw [inverseMultiplierDistribution, TemperedDistribution.fourierInv_apply,
    multiplierRegularDistribution_apply]

/-- The source's distributional identity: evaluating `K = 𝓕⁻m` on a
Schwartz test function is the literal Fourier-side multiplier integral. -/
theorem inverseMultiplierDistribution_apply_eq_multiplierForm
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (f₀ f₁ f₂ f₃ : Schwartz3) :
    inverseMultiplierDistribution α M m hm (twistedProduct f₀ f₁ f₂ f₃) =
      multiplierForm m f₀ f₁ f₂ f₃ := by
  rw [inverseMultiplierDistribution_apply]
  apply integral_congr_ae
  filter_upwards with ξ
  rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq_fourier_neg]
  change (𝓕 (twistedProduct f₀ f₁ f₂ f₃ : E3 → ℂ)) (-ξ) * m ξ =
    m ξ * (𝓕 (twistedProduct f₀ f₁ f₂ f₃ : E3 → ℂ)) (-ξ)
  ring

/-- The nested product carrier used for the source's nine frequency
coordinates.  Product-coordinate identifications are made explicit below. -/
abbrev Frequency9 := (E3 × E3) × E3

/-- The source's `E_9` integral, written with its nested product Lebesgue
measure.  This makes the blueprint's product-coordinate convention explicit
instead of relying on an unmentioned identification. -/
abbrev frequencyMeasure : Measure Frequency9 :=
  ((volume : Measure E3).prod volume).prod volume

@[simp]
theorem frequencyMeasure_eq_volume : (frequencyMeasure : Measure Frequency9) = volume := by
  simp only [frequencyMeasure, Measure.volume_eq_prod]

noncomputable def frequencyFirst : Frequency9 →L[ℝ] E3 :=
  (ContinuousLinearMap.fst ℝ E3 E3).comp
    (ContinuousLinearMap.fst ℝ (E3 × E3) E3)

noncomputable def frequencySecond : Frequency9 →L[ℝ] E3 :=
  (ContinuousLinearMap.snd ℝ E3 E3).comp
    (ContinuousLinearMap.fst ℝ (E3 × E3) E3)

noncomputable def frequencyThird : Frequency9 →L[ℝ] E3 :=
  ContinuousLinearMap.snd ℝ (E3 × E3) E3

noncomputable def frequencySum : Frequency9 →L[ℝ] E3 :=
  frequencyFirst + frequencySecond + frequencyThird

/-- The three diagonal coordinates `η(ζ)` occurring in the source frequency
formula. -/
noncomputable def frequencyDiagonal : Frequency9 →L[ℝ] E3 :=
  ((coordinateProjection 0).comp frequencyFirst).smulRight
      (Anisotropy.coordinateDirection 0) +
    ((coordinateProjection 1).comp frequencySecond).smulRight
      (Anisotropy.coordinateDirection 1) +
    ((coordinateProjection 2).comp frequencyThird).smulRight
      (Anisotropy.coordinateDirection 2)

@[simp]
theorem frequencyDiagonal_apply (ζ : Frequency9) :
    frequencyDiagonal ζ =
      ζ.1.1 0 • Anisotropy.coordinateDirection 0 +
        ζ.1.2 1 • Anisotropy.coordinateDirection 1 +
          ζ.2 2 • Anisotropy.coordinateDirection 2 := by
  simp [frequencyDiagonal, frequencyFirst, frequencySecond, frequencyThird,
    coordinateProjection_apply]

/-- Package the four frequency arguments
`(-ζ¹-ζ²-ζ³, ζ¹, ζ², ζ³)` for the tensor-product Schwartz map. -/
noncomputable def frequencyPackaging :
    Frequency9 →L[ℝ] (E3 × E3) × (E3 × E3) :=
  ((-frequencySum).prod frequencyFirst).prod
    (frequencySecond.prod frequencyThird)

@[simp]
theorem frequencyPackaging_apply (ζ : Frequency9) :
    frequencyPackaging ζ =
      ((-(ζ.1.1 + ζ.1.2 + ζ.2), ζ.1.1), (ζ.1.2, ζ.2)) := by
  simp [frequencyPackaging, frequencySum, frequencyFirst, frequencySecond, frequencyThird]

theorem frequencyPackaging_injective : Function.Injective frequencyPackaging := by
  intro ζ ω h
  have h₁ := congrArg (fun q : (E3 × E3) × (E3 × E3) ↦ q.1.2) h
  have h₂ := congrArg (fun q : (E3 × E3) × (E3 × E3) ↦ q.2.1) h
  have h₃ := congrArg (fun q : (E3 × E3) × (E3 × E3) ↦ q.2.2) h
  change ζ.1.1 = ω.1.1 at h₁
  change ζ.1.2 = ω.1.2 at h₂
  change ζ.2 = ω.2 at h₃
  exact Prod.ext (Prod.ext h₁ h₂) h₃

/-- The Schwartz factor in the source's frequency representation, before
the bounded multiplier is inserted. -/
noncomputable def frequencyKernel
    (f₀ f₁ f₂ f₃ : Schwartz3) : SchwartzMap Frequency9 ℂ :=
  schwartzAffinePullbackOfInjective (𝕜 := ℂ) frequencyPackaging
    frequencyPackaging_injective 0
    (schwartzExternalProduct
      (schwartzExternalProduct (schwartzFourier f₀) (schwartzFourier f₁))
      (schwartzExternalProduct (schwartzFourier f₂) (schwartzFourier f₃)))

@[simp]
theorem frequencyKernel_apply
    (f₀ f₁ f₂ f₃ : Schwartz3) (ζ : Frequency9) :
    frequencyKernel f₀ f₁ f₂ f₃ ζ =
      (schwartzFourier f₀) (-(ζ.1.1 + ζ.1.2 + ζ.2)) *
        (schwartzFourier f₁ ζ.1.1 *
          ((schwartzFourier f₂ ζ.1.2) * schwartzFourier f₃ ζ.2)) := by
  simp [frequencyKernel, schwartzAffinePullbackOfInjective]
  ring

/-- A Euclidean six-dimensional carrier for the six non-diagonal frequency
coordinates. -/
abbrev FrequencyRemainder := WithLp 2 (E3 × E3)

/-- The nine frequency coordinates arranged as `(η, remainder)`.  This is an
honest Euclidean space; the map below records its measure-preserving
identification with the nested source product carrier. -/
abbrev FrequencySplit9 := WithLp 2 (E3 × FrequencyRemainder)

abbrev FrequencyEuclidean9 := EuclideanSpace ℝ (Fin 9)
abbrev FrequencyHilbert9 := WithLp 2 (FrequencyRemainder × E3)

noncomputable def frequencySplit6Hilbert :
    WithLp 2 (Fin 3 ⊕ Fin 3 → ℝ) ≃ₗᵢ[ℝ] FrequencyRemainder :=
  PiLp.sumPiLpEquivProdLpPiLp 2 (fun _ : Fin 3 ⊕ Fin 3 => ℝ)

/-- The standard grouping of nine scalar coordinates into the three source
frequency vectors. -/
noncomputable def frequencyIndexGrouping :
    Fin 9 ≃ Fin 3 ⊕ (Fin 3 ⊕ Fin 3) :=
  (finSumFinEquiv (m := 3) (n := 6)).symm.trans
    (Equiv.sumCongr (Equiv.refl _) (finSumFinEquiv (m := 3) (n := 3)).symm)

/-- The coordinate permutation which puts the three diagonal frequency
coordinates first.  Its explicit inverse makes the subsequent coordinate
calculation reducible. -/
def frequencyIndexPermutation : Fin 9 ≃ Fin 9 where
  toFun i :=
    match i.1 with
    | 0 => 3
    | 1 => 7
    | 2 => 2
    | 3 => 4
    | 4 => 5
    | 5 => 6
    | 6 => 8
    | 7 => 0
    | _ => 1
  invFun i :=
    match i.1 with
    | 0 => 7
    | 1 => 8
    | 2 => 2
    | 3 => 0
    | 4 => 3
    | 5 => 4
    | 6 => 5
    | 7 => 1
    | _ => 6
  left_inv := by intro i; fin_cases i <;> rfl
  right_inv := by intro i; fin_cases i <;> rfl

/-- Regroup scalar coordinates as three Euclidean vectors, with the third
source vector placed last. -/
noncomputable def frequencyEuclideanToHilbert :
    FrequencyEuclidean9 ≃ₗᵢ[ℝ] FrequencyHilbert9 :=
  (LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ frequencyIndexGrouping).trans
    ((PiLp.sumPiLpEquivProdLpPiLp 2
      (fun _ : Fin 3 ⊕ (Fin 3 ⊕ Fin 3) => ℝ)).trans
      ((LinearIsometryEquiv.withLpProdCongr 2
        (LinearIsometryEquiv.refl ℝ E3)
        (PiLp.sumPiLpEquivProdLpPiLp 2 (fun _ : Fin 3 ⊕ Fin 3 => ℝ))).trans
          (LinearIsometryEquiv.withLpProdComm 2 ℝ E3 FrequencyRemainder)))

/-- Flatten the diagonal/remainder Hilbert product to nine scalar coordinates. -/
noncomputable def frequencySplitToEuclidean :
    FrequencySplit9 ≃ₗᵢ[ℝ] FrequencyEuclidean9 :=
  (LinearIsometryEquiv.withLpProdCongr 2 (LinearIsometryEquiv.refl ℝ E3)
    frequencySplit6Hilbert.symm).trans
      ((PiLp.sumPiLpEquivProdLpPiLp 2
        (fun _ : Fin 3 ⊕ (Fin 3 ⊕ Fin 3) => ℝ)).symm.trans
          (LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ frequencyIndexGrouping.symm))

noncomputable def frequencyHilbertReassembly :
    FrequencyEuclidean9 ≃ₗᵢ[ℝ] FrequencyHilbert9 :=
  (LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ frequencyIndexPermutation).trans
    frequencyEuclideanToHilbert

/-- The measurable-equivalence form of the source's nested product
coordinates. -/
noncomputable def frequencyRawEquiv : FrequencyHilbert9 ≃ᵐ Frequency9 :=
  (MeasurableEquiv.toLp 2 (FrequencyRemainder × E3)).symm.trans
    (MeasurableEquiv.prodCongr
      (MeasurableEquiv.toLp 2 (E3 × E3)).symm (MeasurableEquiv.refl E3))

noncomputable def frequencyRawCLE : FrequencyHilbert9 ≃L[ℝ] Frequency9 :=
  (WithLp.prodContinuousLinearEquiv 2 ℝ FrequencyRemainder E3).trans
    (ContinuousLinearEquiv.prodCongr
      (WithLp.prodContinuousLinearEquiv 2 ℝ E3 E3)
      (ContinuousLinearEquiv.refl ℝ E3))

/-- The explicit measure-preserving coordinate reassembly from
`(η, six remaining coordinates)` to the three source frequency vectors. -/
noncomputable def frequencyReassembly : (E3 × FrequencyRemainder) ≃L[ℝ] Frequency9 :=
  (WithLp.prodContinuousLinearEquiv 2 ℝ E3 FrequencyRemainder).symm.trans
    ((frequencySplitToEuclidean.toContinuousLinearEquiv.trans
      frequencyHilbertReassembly.toContinuousLinearEquiv).trans frequencyRawCLE)

noncomputable def frequencyAssemble3 (a b c : ℝ) : E3 :=
  WithLp.toLp 2 ![a, b, c]

@[simp]
theorem frequencyAssemble3_apply (a b c : ℝ) (i : Fin 3) :
    frequencyAssemble3 a b c i = ![a, b, c] i := rfl

@[simp]
theorem frequencyReassembly_apply (η : E3) (r : FrequencyRemainder) :
    frequencyReassembly (η, r) =
      ((frequencyAssemble3 (η 0) (r.fst 0) (r.fst 1),
        frequencyAssemble3 (r.fst 2) (η 1) (r.snd 0)),
        frequencyAssemble3 (r.snd 1) (r.snd 2) (η 2)) := by
  apply Prod.ext
  · apply Prod.ext
    · ext i
      fin_cases i <;> rfl
    · ext i
      fin_cases i <;> rfl
  · ext i
    fin_cases i <;> rfl

theorem frequencyRawEquiv_measurePreserving :
    MeasurePreserving frequencyRawEquiv volume volume := by
  exact (WithLp.volume_preserving_symm_measurableEquiv_toLp_prod FrequencyRemainder E3).trans
    (MeasurePreserving.prod
      (WithLp.volume_preserving_symm_measurableEquiv_toLp_prod E3 E3)
      (MeasurePreserving.id volume))

/-- This verifies the blueprint's product-coordinate convention for the
specific diagonal/remainder ordering used in the frequency proof. -/
theorem frequencyReassembly_measurePreserving :
    MeasurePreserving frequencyReassembly volume volume := by
  have h1 : MeasurePreserving (WithLp.toLp 2)
      (volume : Measure (E3 × FrequencyRemainder))
      (volume : Measure FrequencySplit9) :=
    WithLp.volume_preserving_toLp (U := E3) (V := FrequencyRemainder)
  have h2 : MeasurePreserving frequencySplitToEuclidean
      (volume : Measure FrequencySplit9) (volume : Measure FrequencyEuclidean9) :=
    frequencySplitToEuclidean.measurePreserving
  have h3 : MeasurePreserving frequencyHilbertReassembly
      (volume : Measure FrequencyEuclidean9) (volume : Measure FrequencyHilbert9) :=
    frequencyHilbertReassembly.measurePreserving
  have h4 : MeasurePreserving frequencyRawEquiv
      (volume : Measure FrequencyHilbert9) (volume : Measure Frequency9) :=
    frequencyRawEquiv_measurePreserving
  have h := h4.comp (h3.comp (h2.comp h1))
  convert h using 1
  ext z <;> rfl

@[simp]
theorem frequencyDiagonal_reassembly (η : E3) (r : FrequencyRemainder) :
    frequencyDiagonal (frequencyReassembly (η, r)) = η := by
  ext i
  fin_cases i <;>
    simp [frequencyDiagonal_apply, frequencyReassembly_apply,
      frequencyAssemble3_apply, coordinateDirection_apply]

local instance : (volume : Measure (E3 × FrequencyRemainder)).IsAddHaarMeasure :=
  Measure.prod.instIsAddHaarMeasure volume volume

/-- The source frequency kernel expressed in diagonal/remainder coordinates. -/
noncomputable def frequencyKernelJoint
    (f₀ f₁ f₂ f₃ : Schwartz3) :
    SchwartzMap (E3 × FrequencyRemainder) ℂ :=
  schwartzAffinePullbackOfInjective (𝕜 := ℂ)
    frequencyReassembly.toContinuousLinearMap frequencyReassembly.injective 0
    (frequencyKernel f₀ f₁ f₂ f₃)

@[simp]
theorem frequencyKernelJoint_apply
    (f₀ f₁ f₂ f₃ : Schwartz3) (η : E3) (r : FrequencyRemainder) :
    frequencyKernelJoint f₀ f₁ f₂ f₃ (η, r) =
      frequencyKernel f₀ f₁ f₂ f₃ (frequencyReassembly (η, r)) := by
  simp [frequencyKernelJoint, schwartzAffinePullbackOfInjective]

/-- Integrating the six non-diagonal frequency coordinates gives the
Fourier transform of the translated product. -/
noncomputable def frequencyFiber
    (f₀ f₁ f₂ f₃ : Schwartz3) : Schwartz3 :=
  schwartzFiberIntegralMap (μ := volume) (frequencyKernelJoint f₀ f₁ f₂ f₃)

@[simp]
theorem frequencyFiber_apply
    (f₀ f₁ f₂ f₃ : Schwartz3) (η : E3) :
    frequencyFiber f₀ f₁ f₂ f₃ η =
      ∫ r : FrequencyRemainder, frequencyKernelJoint f₀ f₁ f₂ f₃ (η, r) := rfl

@[simp]
theorem inner_coordinateDirection_left (i : Fin 3) (x : E3) :
    ⟪Anisotropy.coordinateDirection i, x⟫ = x i := by
  simp [Anisotropy.coordinateDirection, EuclideanSpace.inner_single_left]

@[simp]
theorem inner_coordinateDirection_right (x : E3) (i : Fin 3) :
    ⟪x, Anisotropy.coordinateDirection i⟫ = x i := by
  rw [real_inner_comm]
  exact inner_coordinateDirection_left i x

theorem inner_frequencyDiagonal (ζ : Frequency9) (t : E3) :
    ⟪frequencyDiagonal ζ, t⟫ =
      ζ.1.1 0 * t 0 + ζ.1.2 1 * t 1 + ζ.2 2 * t 2 := by
  rw [frequencyDiagonal_apply]
  simp [inner_add_left, inner_smul_left]

/-- The scalar Fourier character, written as a complex number for the
product/Fubini calculation. -/
noncomputable def frequencyPhase (x y : E3) : ℂ :=
  (𝐞 ⟪x, y⟫ : Circle)

@[simp]
theorem norm_frequencyPhase (x y : E3) : ‖frequencyPhase x y‖ = 1 := by
  simp [frequencyPhase, Circle.norm_coe]

theorem frequency_phase_scalar_identity (x t : E3) (ζ : Frequency9) :
    ⟪frequencyDiagonal ζ, t⟫ + ⟪x, ζ.1.1 + ζ.1.2 + ζ.2⟫ =
      ⟪ζ.1.1, x + t 0 • Anisotropy.coordinateDirection 0⟫ +
        (⟪ζ.1.2, x + t 1 • Anisotropy.coordinateDirection 1⟫ +
          ⟪ζ.2, x + t 2 • Anisotropy.coordinateDirection 2⟫) := by
  rw [inner_frequencyDiagonal]
  simp [inner_add_right, inner_smul_right]
  rw [real_inner_comm x ζ.1.1, real_inner_comm x ζ.1.2, real_inner_comm x ζ.2]
  ring

theorem frequency_phase_factorization (x t : E3) (ζ : Frequency9) :
    frequencyPhase (frequencyDiagonal ζ) t *
        frequencyPhase x (ζ.1.1 + ζ.1.2 + ζ.2) =
      frequencyPhase ζ.1.1 (x + t 0 • Anisotropy.coordinateDirection 0) *
        (frequencyPhase ζ.1.2 (x + t 1 • Anisotropy.coordinateDirection 1) *
          frequencyPhase ζ.2 (x + t 2 • Anisotropy.coordinateDirection 2)) := by
  simp only [frequencyPhase]
  rw [← Circle.coe_mul, ← Circle.coe_mul, ← Circle.coe_mul]
  apply congrArg (fun q : Circle ↦ (q : ℂ))
  rw [← AddChar.map_add_eq_mul, frequency_phase_scalar_identity,
    AddChar.map_add_eq_mul, AddChar.map_add_eq_mul]

theorem inverseFourier_schwartzFourier_apply (f : Schwartz3) (x : E3) :
    ∫ ζ : E3, frequencyPhase ζ x * schwartzFourier f ζ = f x := by
  have h := congrArg (fun g : Schwartz3 ↦ g x) (schwartzFourierInv_fourier f)
  rw [schwartzFourierInv, SchwartzMap.fourierInv_coe, Real.fourierInv_eq] at h
  simpa [frequencyPhase, Circle.smul_def] using h

theorem schwartzFourier_neg_apply (f : Schwartz3) (s : E3) :
    schwartzFourier f (-s) = ∫ x : E3, frequencyPhase x s * f x := by
  rw [schwartzFourier, SchwartzMap.fourier_coe, Real.fourier_eq]
  apply integral_congr_ae
  filter_upwards with x
  simp [frequencyPhase, Circle.smul_def, inner_neg_right]

theorem frequency_three_inverse_integral
    (f₁ f₂ f₃ : Schwartz3) (x t : E3) :
    ∫ ζ : Frequency9,
      (frequencyPhase (frequencyDiagonal ζ) t *
        frequencyPhase x (ζ.1.1 + ζ.1.2 + ζ.2)) *
          (schwartzFourier f₁ ζ.1.1 *
            (schwartzFourier f₂ ζ.1.2 * schwartzFourier f₃ ζ.2)) =
      f₁ (x + t 0 • Anisotropy.coordinateDirection 0) *
        (f₂ (x + t 1 • Anisotropy.coordinateDirection 1) *
          f₃ (x + t 2 • Anisotropy.coordinateDirection 2)) := by
  calc
    ∫ ζ : Frequency9,
        (frequencyPhase (frequencyDiagonal ζ) t *
          frequencyPhase x (ζ.1.1 + ζ.1.2 + ζ.2)) *
            (schwartzFourier f₁ ζ.1.1 *
              (schwartzFourier f₂ ζ.1.2 * schwartzFourier f₃ ζ.2)) =
        ∫ ζ : Frequency9,
          (frequencyPhase ζ.1.1 (x + t 0 • Anisotropy.coordinateDirection 0) *
            schwartzFourier f₁ ζ.1.1) *
              ((frequencyPhase ζ.1.2 (x + t 1 • Anisotropy.coordinateDirection 1) *
                schwartzFourier f₂ ζ.1.2) *
                  (frequencyPhase ζ.2 (x + t 2 • Anisotropy.coordinateDirection 2) *
                    schwartzFourier f₃ ζ.2)) := by
          apply integral_congr_ae
          filter_upwards with ζ
          rw [frequency_phase_factorization]
          ring
    _ =
        (∫ ζ₁ : E3,
          frequencyPhase ζ₁ (x + t 0 • Anisotropy.coordinateDirection 0) *
            schwartzFourier f₁ ζ₁) *
          ((∫ ζ₂ : E3,
            frequencyPhase ζ₂ (x + t 1 • Anisotropy.coordinateDirection 1) *
              schwartzFourier f₂ ζ₂) *
            ∫ ζ₃ : E3,
              frequencyPhase ζ₃ (x + t 2 • Anisotropy.coordinateDirection 2) *
                schwartzFourier f₃ ζ₃) := by
          let A : E3 → ℂ := fun ζ₁ ↦
            frequencyPhase ζ₁ (x + t 0 • Anisotropy.coordinateDirection 0) *
              schwartzFourier f₁ ζ₁
          let B : E3 → ℂ := fun ζ₂ ↦
            frequencyPhase ζ₂ (x + t 1 • Anisotropy.coordinateDirection 1) *
              schwartzFourier f₂ ζ₂
          let C : E3 → ℂ := fun ζ₃ ↦
            frequencyPhase ζ₃ (x + t 2 • Anisotropy.coordinateDirection 2) *
              schwartzFourier f₃ ζ₃
          rw [show (volume : Measure Frequency9) =
            (volume : Measure (E3 × E3)).prod (volume : Measure E3) from
              Measure.volume_eq_prod (E3 × E3) E3]
          change
            ∫ ζ : (E3 × E3) × E3, A ζ.1.1 * (B ζ.1.2 * C ζ.2)
              ∂((volume : Measure (E3 × E3)).prod (volume : Measure E3)) =
              (∫ ζ₁ : E3, A ζ₁) * ((∫ ζ₂ : E3, B ζ₂) * ∫ ζ₃ : E3, C ζ₃)
          calc
            ∫ ζ : (E3 × E3) × E3, A ζ.1.1 * (B ζ.1.2 * C ζ.2)
                ∂((volume : Measure (E3 × E3)).prod (volume : Measure E3)) =
                ∫ ζ : (E3 × E3) × E3, (A ζ.1.1 * B ζ.1.2) * C ζ.2
                  ∂((volume : Measure (E3 × E3)).prod (volume : Measure E3)) := by
              apply integral_congr_ae
              filter_upwards with ζ
              ring
            _ = (∫ p : E3 × E3, A p.1 * B p.2) * ∫ ζ₃ : E3, C ζ₃ :=
              integral_prod_mul (μ := (volume : Measure (E3 × E3)))
                (ν := (volume : Measure E3)) (fun p ↦ A p.1 * B p.2) C
            _ = (∫ ζ₁ : E3, A ζ₁) * ((∫ ζ₂ : E3, B ζ₂) * ∫ ζ₃ : E3, C ζ₃) := by
              rw [show (volume : Measure (E3 × E3)) =
                (volume : Measure E3).prod (volume : Measure E3) from
                  Measure.volume_eq_prod E3 E3]
              rw [integral_prod_mul (μ := (volume : Measure E3))
                (ν := (volume : Measure E3)) A B]
              ring
    _ =
        f₁ (x + t 0 • Anisotropy.coordinateDirection 0) *
          (f₂ (x + t 1 • Anisotropy.coordinateDirection 1) *
            f₃ (x + t 2 • Anisotropy.coordinateDirection 2)) := by
          rw [inverseFourier_schwartzFourier_apply,
            inverseFourier_schwartzFourier_apply,
            inverseFourier_schwartzFourier_apply]

/-- Reassembling the diagonal and off-diagonal coordinates converts the
inverse Fourier transform of the frequency fiber into the full source
frequency integral. -/
theorem schwartzFourierInv_frequencyFiber_apply
    (f₀ f₁ f₂ f₃ : Schwartz3) (t : E3) :
    schwartzFourierInv (frequencyFiber f₀ f₁ f₂ f₃) t =
      ∫ ζ : Frequency9,
        frequencyPhase (frequencyDiagonal ζ) t * frequencyKernel f₀ f₁ f₂ f₃ ζ := by
  letI : (volume : Measure (E3 × E3)).IsAddHaarMeasure :=
    Measure.prod.instIsAddHaarMeasure volume volume
  letI : (volume : Measure Frequency9).IsAddHaarMeasure :=
    Measure.prod.instIsAddHaarMeasure (volume : Measure (E3 × E3)) volume
  let g : Frequency9 → ℂ := fun ζ ↦
    frequencyPhase (frequencyDiagonal ζ) t * frequencyKernel f₀ f₁ f₂ f₃ ζ
  have hphase : Continuous (fun ζ : Frequency9 ↦
      frequencyPhase (frequencyDiagonal ζ) t) := by
    unfold frequencyPhase
    exact continuous_subtype_val.comp
      (Real.continuous_fourierChar.comp
        (continuous_inner.comp (frequencyDiagonal.continuous.prodMk continuous_const)))
  have hg : Integrable g (volume : Measure Frequency9) := by
    exact (frequencyKernel f₀ f₁ f₂ f₃).integrable.bdd_mul
      (c := 1) hphase.aestronglyMeasurable
      (Filter.Eventually.of_forall fun ζ ↦ by simp)
  have hpull : Integrable (g ∘ frequencyReassembly) :=
    frequencyReassembly_measurePreserving.integrable_comp_of_integrable hg
  have hjoint : Integrable (fun q : E3 × FrequencyRemainder ↦
      frequencyPhase q.1 t * frequencyKernelJoint f₀ f₁ f₂ f₃ q) := by
    convert hpull using 1
    ext q
    rcases q with ⟨η, r⟩
    change frequencyPhase η t * frequencyKernelJoint f₀ f₁ f₂ f₃ (η, r) =
      frequencyPhase (frequencyDiagonal (frequencyReassembly (η, r))) t *
        frequencyKernel f₀ f₁ f₂ f₃ (frequencyReassembly (η, r))
    rw [frequencyDiagonal_reassembly, ← frequencyKernelJoint_apply]
  calc
    schwartzFourierInv (frequencyFiber f₀ f₁ f₂ f₃) t =
        ∫ η : E3, frequencyPhase η t * frequencyFiber f₀ f₁ f₂ f₃ η := by
      rw [schwartzFourierInv, SchwartzMap.fourierInv_coe, Real.fourierInv_eq]
      apply integral_congr_ae
      filter_upwards with η
      simp [frequencyPhase, Circle.smul_def]
    _ = ∫ η : E3, ∫ r : FrequencyRemainder,
        frequencyPhase η t * frequencyKernelJoint f₀ f₁ f₂ f₃ (η, r) := by
      apply integral_congr_ae
      filter_upwards with η
      rw [frequencyFiber_apply, ← integral_const_mul]
    _ = ∫ q : E3 × FrequencyRemainder,
        frequencyPhase q.1 t * frequencyKernelJoint f₀ f₁ f₂ f₃ q := by
      rw [Measure.volume_eq_prod]
      exact (integral_prod _ hjoint).symm
    _ = ∫ q : E3 × FrequencyRemainder, g (frequencyReassembly q) := by
      apply integral_congr_ae
      filter_upwards with q
      rcases q with ⟨η, r⟩
      change frequencyPhase η t * frequencyKernelJoint f₀ f₁ f₂ f₃ (η, r) =
        frequencyPhase (frequencyDiagonal (frequencyReassembly (η, r))) t *
          frequencyKernel f₀ f₁ f₂ f₃ (frequencyReassembly (η, r))
      rw [frequencyDiagonal_reassembly, ← frequencyKernelJoint_apply]
    _ = ∫ ζ : Frequency9, g ζ :=
      frequencyReassembly_measurePreserving.integral_comp
        frequencyReassembly.toHomeomorph.measurableEmbedding g
    _ = ∫ ζ : Frequency9,
        frequencyPhase (frequencyDiagonal ζ) t * frequencyKernel f₀ f₁ f₂ f₃ ζ := rfl

/-- The full source frequency integral is the translated product.  The only
interchange of integrations is justified by the displayed product majorant
`‖H(ζ)‖ ‖f₀(x)‖`. -/
theorem frequencyKernel_phase_integral_eq_twistedProduct
    (f₀ f₁ f₂ f₃ : Schwartz3) (t : E3) :
    (∫ ζ : Frequency9,
      frequencyPhase (frequencyDiagonal ζ) t * frequencyKernel f₀ f₁ f₂ f₃ ζ) =
      twistedProduct f₀ f₁ f₂ f₃ t := by
  letI : (volume : Measure (E3 × E3)).IsAddHaarMeasure :=
    Measure.prod.instIsAddHaarMeasure volume volume
  letI : (volume : Measure Frequency9).IsAddHaarMeasure :=
    Measure.prod.instIsAddHaarMeasure (volume : Measure (E3 × E3)) volume
  let H : Frequency9 → ℂ := fun ζ ↦
    ((schwartzFourier f₁ ζ.1.1 * schwartzFourier f₂ ζ.1.2) *
      schwartzFourier f₃ ζ.2)
  let Q : Frequency9 → E3 → ℂ := fun ζ x ↦
    (frequencyPhase (frequencyDiagonal ζ) t *
      (frequencyPhase x (ζ.1.1 + ζ.1.2 + ζ.2) * f₀ x)) * H ζ
  have h12 : Integrable (fun z : E3 × E3 ↦
      schwartzFourier f₁ z.1 * schwartzFourier f₂ z.2) :=
    (schwartzFourier f₁).integrable.mul_prod (schwartzFourier f₂).integrable
  have hH : Integrable H := h12.mul_prod (schwartzFourier f₃).integrable
  have hdom : Integrable (fun p : Frequency9 × E3 ↦ ‖H p.1‖ * ‖f₀ p.2‖) :=
    hH.norm.mul_prod f₀.integrable.norm
  have hQcont : Continuous (Function.uncurry Q) := by
    dsimp [Q, H]
    unfold frequencyPhase
    fun_prop
  have hQ : Integrable (Function.uncurry Q) := by
    refine Integrable.mono hdom hQcont.aestronglyMeasurable
      (Filter.Eventually.of_forall ?_)
    rintro ⟨ζ, x⟩
    dsimp [Q, H]
    simp [norm_frequencyPhase]
    ring_nf
    exact le_rfl
  calc
    (∫ ζ : Frequency9,
      frequencyPhase (frequencyDiagonal ζ) t * frequencyKernel f₀ f₁ f₂ f₃ ζ) =
        ∫ ζ : Frequency9, ∫ x : E3, Q ζ x := by
      apply integral_congr_ae
      filter_upwards with ζ
      rw [frequencyKernel_apply, schwartzFourier_neg_apply]
      rw [← integral_mul_const, ← integral_const_mul]
      apply integral_congr_ae
      filter_upwards with x
      dsimp [Q, H]
      ring
    _ = ∫ x : E3, ∫ ζ : Frequency9, Q ζ x :=
      integral_integral_swap hQ
    _ = ∫ x : E3,
        (f₀ x * f₁ (x + t 0 • Anisotropy.coordinateDirection 0)) *
          (f₂ (x + t 1 • Anisotropy.coordinateDirection 1) *
            f₃ (x + t 2 • Anisotropy.coordinateDirection 2)) := by
      apply integral_congr_ae
      filter_upwards with x
      calc
        (∫ ζ : Frequency9, Q ζ x) =
            ∫ ζ : Frequency9,
              f₀ x *
                ((frequencyPhase (frequencyDiagonal ζ) t *
                  frequencyPhase x (ζ.1.1 + ζ.1.2 + ζ.2)) *
                  (schwartzFourier f₁ ζ.1.1 *
                    (schwartzFourier f₂ ζ.1.2 * schwartzFourier f₃ ζ.2))) := by
              apply integral_congr_ae
              filter_upwards with ζ
              dsimp [Q, H]
              ring
        _ = f₀ x * ∫ ζ : Frequency9,
              (frequencyPhase (frequencyDiagonal ζ) t *
                frequencyPhase x (ζ.1.1 + ζ.1.2 + ζ.2)) *
                (schwartzFourier f₁ ζ.1.1 *
                  (schwartzFourier f₂ ζ.1.2 * schwartzFourier f₃ ζ.2)) := by
              rw [integral_const_mul]
        _ = f₀ x *
            (f₁ (x + t 0 • Anisotropy.coordinateDirection 0) *
              (f₂ (x + t 1 • Anisotropy.coordinateDirection 1) *
                f₃ (x + t 2 • Anisotropy.coordinateDirection 2))) := by
              rw [frequency_three_inverse_integral]
        _ =
            (f₀ x * f₁ (x + t 0 • Anisotropy.coordinateDirection 0)) *
              (f₂ (x + t 1 • Anisotropy.coordinateDirection 1) *
                f₃ (x + t 2 • Anisotropy.coordinateDirection 2)) := by
              ring
    _ = twistedProduct f₀ f₁ f₂ f₃ t := (twistedProduct_apply f₀ f₁ f₂ f₃ t).symm

/-- The fiber constructed from the source frequency kernel is precisely the
Fourier transform of the translated product. -/
theorem twistedProduct_eq_schwartzFourierInv_frequencyFiber
    (f₀ f₁ f₂ f₃ : Schwartz3) :
    twistedProduct f₀ f₁ f₂ f₃ =
      schwartzFourierInv (frequencyFiber f₀ f₁ f₂ f₃) := by
  ext t
  rw [schwartzFourierInv_frequencyFiber_apply,
    frequencyKernel_phase_integral_eq_twistedProduct]

theorem schwartzFourier_twistedProduct_eq_frequencyFiber
    (f₀ f₁ f₂ f₃ : Schwartz3) :
    schwartzFourier (twistedProduct f₀ f₁ f₂ f₃) =
      frequencyFiber f₀ f₁ f₂ f₃ := by
  rw [twistedProduct_eq_schwartzFourierInv_frequencyFiber,
    schwartzFourier_fourierInv]

/-- The right-hand side of the source frequency formula. -/
noncomputable def frequencyForm
    (m : E3 → ℂ) (f₀ f₁ f₂ f₃ : Schwartz3) : ℂ :=
  ∫ ζ : Frequency9, m (-frequencyDiagonal ζ) * frequencyKernel f₀ f₁ f₂ f₃ ζ
    ∂frequencyMeasure

/-- Absolute convergence of the source frequency-side integrand. -/
theorem frequencyForm_integrable
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (f₀ f₁ f₂ f₃ : Schwartz3) :
    Integrable (fun ζ : Frequency9 ↦
      m (-frequencyDiagonal ζ) * frequencyKernel f₀ f₁ f₂ f₃ ζ) frequencyMeasure := by
  rw [frequencyMeasure_eq_volume]
  letI : (volume : Measure (E3 × E3)).IsAddHaarMeasure :=
    Measure.prod.instIsAddHaarMeasure volume volume
  letI : (volume : Measure Frequency9).IsAddHaarMeasure :=
    Measure.prod.instIsAddHaarMeasure (volume : Measure (E3 × E3)) volume
  let F : SchwartzMap Frequency9 ℂ := frequencyKernel f₀ f₁ f₂ f₃
  have hFint : Integrable F (volume : Measure Frequency9) := F.integrable
  have hFmeas : AEStronglyMeasurable F volume := F.continuous.aestronglyMeasurable
  have hmmeas : AEStronglyMeasurable (fun ζ : Frequency9 ↦ m (-frequencyDiagonal ζ)) volume :=
    (hm.measurable.comp
      ((continuous_neg.comp frequencyDiagonal.continuous).measurable)).aestronglyMeasurable
  have hmeas : AEStronglyMeasurable
      (fun ζ : Frequency9 ↦ m (-frequencyDiagonal ζ) * F ζ) volume :=
    hmmeas.mul hFmeas
  have hbound : ∀ ζ : Frequency9,
      ‖m (-frequencyDiagonal ζ) * F ζ‖ ≤ M * ‖F ζ‖ := by
    intro ζ
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (hm.norm_le_all _) (norm_nonneg _)
  exact Integrable.mono' (hFint.norm.const_mul M) hmeas
    (Filter.Eventually.of_forall hbound)

/-- Fubini after the explicit coordinate reassembly identifies the source
frequency integral with the diagonal-frequency fiber integral. -/
theorem frequencyForm_eq_fiberIntegral
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (f₀ f₁ f₂ f₃ : Schwartz3) :
    frequencyForm m f₀ f₁ f₂ f₃ =
      ∫ η : E3, m (-η) * frequencyFiber f₀ f₁ f₂ f₃ η := by
  let g : Frequency9 → ℂ := fun ζ ↦
    m (-frequencyDiagonal ζ) * frequencyKernel f₀ f₁ f₂ f₃ ζ
  have hg : Integrable g (volume : Measure Frequency9) := by
    simpa only [g, frequencyMeasure_eq_volume] using
      frequencyForm_integrable α M m hm f₀ f₁ f₂ f₃
  have hpull : Integrable (g ∘ frequencyReassembly) :=
    frequencyReassembly_measurePreserving.integrable_comp_of_integrable hg
  have hjoint : Integrable (fun q : E3 × FrequencyRemainder ↦
      m (-q.1) * frequencyKernelJoint f₀ f₁ f₂ f₃ q) := by
    convert hpull using 1
    ext q
    rcases q with ⟨η, r⟩
    change m (-η) * frequencyKernelJoint f₀ f₁ f₂ f₃ (η, r) =
      m (-frequencyDiagonal (frequencyReassembly (η, r))) *
        frequencyKernel f₀ f₁ f₂ f₃ (frequencyReassembly (η, r))
    rw [frequencyDiagonal_reassembly, ← frequencyKernelJoint_apply]
  calc
    frequencyForm m f₀ f₁ f₂ f₃ = ∫ ζ : Frequency9, g ζ := by
      simp [frequencyForm, g, frequencyMeasure_eq_volume]
    _ = ∫ q : E3 × FrequencyRemainder, g (frequencyReassembly q) :=
      (frequencyReassembly_measurePreserving.integral_comp
        frequencyReassembly.toHomeomorph.measurableEmbedding g).symm
    _ = ∫ q : E3 × FrequencyRemainder,
        m (-q.1) * frequencyKernelJoint f₀ f₁ f₂ f₃ q := by
      apply integral_congr_ae
      filter_upwards with q
      rcases q with ⟨η, r⟩
      change m (-frequencyDiagonal (frequencyReassembly (η, r))) *
          frequencyKernel f₀ f₁ f₂ f₃ (frequencyReassembly (η, r)) =
        m (-η) * frequencyKernelJoint f₀ f₁ f₂ f₃ (η, r)
      rw [frequencyDiagonal_reassembly, ← frequencyKernelJoint_apply]
    _ = ∫ η : E3, ∫ r : FrequencyRemainder,
        m (-η) * frequencyKernelJoint f₀ f₁ f₂ f₃ (η, r) := by
      rw [Measure.volume_eq_prod]
      exact integral_prod _ hjoint
    _ = ∫ η : E3, m (-η) * frequencyFiber f₀ f₁ f₂ f₃ η := by
      apply integral_congr_ae
      filter_upwards with η
      rw [frequencyFiber_apply, integral_const_mul]

/-- The two absolutely convergent formulas in `lem:pairing` agree. -/
theorem multiplierForm_eq_frequencyForm
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (f₀ f₁ f₂ f₃ : Schwartz3) :
    multiplierForm m f₀ f₁ f₂ f₃ = frequencyForm m f₀ f₁ f₂ f₃ := by
  let g : E3 → ℂ := fun ξ ↦
    m ξ * frequencyFiber f₀ f₁ f₂ f₃ (-ξ)
  have hneg : MeasurePreserving (fun ξ : E3 ↦ -ξ) volume volume :=
    Measure.measurePreserving_neg (volume : Measure E3)
  calc
    multiplierForm m f₀ f₁ f₂ f₃ = ∫ ξ : E3, g ξ := by
      unfold multiplierForm
      apply integral_congr_ae
      filter_upwards with ξ
      rw [schwartzFourier_twistedProduct_eq_frequencyFiber]
    _ = ∫ η : E3, g (-η) := by
      symm
      exact hneg.integral_comp (Homeomorph.neg E3).measurableEmbedding g
    _ = ∫ η : E3, m (-η) * frequencyFiber f₀ f₁ f₂ f₃ η := by
      apply integral_congr_ae
      filter_upwards with η
      simp [g]
    _ = frequencyForm m f₀ f₁ f₂ f₃ :=
      (frequencyForm_eq_fiberIntegral α M m hm f₀ f₁ f₂ f₃).symm

/-- The multiplier-form integrand is absolutely integrable.  This is the
analytic well-definedness assertion in Lemma `lem:pairing`; its only use of
the symbol hypothesis is the order-zero uniform bound. -/
theorem multiplierForm_integrable
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m)
    (f₀ f₁ f₂ f₃ : Schwartz3) :
    Integrable (fun ξ : E3 ↦
      m ξ * schwartzFourier (twistedProduct f₀ f₁ f₂ f₃) (-ξ)) := by
  let P : Schwartz3 := twistedProduct f₀ f₁ f₂ f₃
  let Q : Schwartz3 := schwartzNegate (schwartzFourier P)
  have hQint : Integrable Q := Q.integrable
  have hQmeas : AEStronglyMeasurable Q volume := Q.continuous.aestronglyMeasurable
  have hmmeas : AEStronglyMeasurable m volume := hm.measurable.aestronglyMeasurable
  have hmeas : AEStronglyMeasurable (fun ξ : E3 ↦ m ξ * Q ξ) volume :=
    hmmeas.mul hQmeas
  have hbound : ∀ ξ : E3, ‖m ξ * Q ξ‖ ≤ M * ‖Q ξ‖ := by
    intro ξ
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (hm.norm_le_all ξ) (norm_nonneg _)
  have hint : Integrable (fun ξ : E3 ↦ m ξ * Q ξ) :=
    Integrable.mono' (hQint.norm.const_mul M) hmeas
      (Filter.Eventually.of_forall hbound)
  simpa only [P, Q, schwartzNegate_apply] using hint

/-! ## Fixed Gaussian and comparison kernels

This begins the source's fixed-kernel block (`def:gaussian`).  The exact
Gaussian normalization is retained, rather than replacing it by an abstract
Schwartz cutoff, because the later Calderón identity uses its Fourier-side
normalization. -/

/-- The one-dimensional Gaussian `\(\mathsf g(x)=e^{-\pi x^2}\)`. -/
noncomputable def gaussian (x : ℝ) : ℝ := Real.exp (-Real.pi * x ^ 2)

/-- Its source-normalized derivative
`\(\mathsf h(x)=-2\pi x\mathsf g(x)\)`. -/
noncomputable def gaussianDeriv (x : ℝ) : ℝ :=
  -2 * Real.pi * x * gaussian x

/-- The positive comparison kernel `\(\theta(x)=(1+|x|)^{-10}\)`. -/
noncomputable def bracketKernel (x : ℝ) : ℝ := (1 + |x|) ^ (-10 : ℝ)

/-- The source translation weight `\(R(r)=1+|r|\)`. -/
def translationWeight (r : ℝ) : ℝ := 1 + |r|

theorem bracketKernel_nonneg (x : ℝ) : 0 ≤ bracketKernel x := by
  unfold bracketKernel
  positivity

theorem bracketKernel_pos (x : ℝ) : 0 < bracketKernel x := by
  unfold bracketKernel
  exact Real.rpow_pos_of_pos (by positivity) _

theorem bracketKernel_even (x : ℝ) : bracketKernel (-x) = bracketKernel x := by
  simp [bracketKernel]

theorem bracketKernel_eq_inv_pow (x : ℝ) :
    bracketKernel x = ((1 + |x|) ^ 10)⁻¹ := by
  unfold bracketKernel
  rw [Real.rpow_neg (by positivity)]
  exact congrArg Inv.inv (Real.rpow_natCast (1 + |x|) 10)

/-- The comparison kernel is integrable on the line. -/
theorem integrable_bracketKernel : Integrable bracketKernel := by
  change Integrable (fun x : ℝ ↦ (1 + |x|) ^ (-10 : ℝ))
  simpa [Real.norm_eq_abs] using
    (integrable_one_add_norm (E := ℝ) (μ := volume) (r := (10 : ℝ)) (by norm_num))

theorem integral_bracketKernel : ∫ x : ℝ, bracketKernel x = 2 / 9 := by
  unfold bracketKernel
  change (∫ x : ℝ, (fun y : ℝ ↦ (1 + y) ^ (-10 : ℝ)) |x|) = 2 / 9
  rw [integral_comp_abs (f := fun y : ℝ ↦ (1 + y) ^ (-10 : ℝ))]
  simp_rw [add_comm (1 : ℝ)]
  have hhalf : ∫ x : ℝ in Set.Ioi (0 : ℝ), (x + 1) ^ (-10 : ℝ) = 1 / 9 := by
    have hd : ∀ x ∈ Set.Ici (0 : ℝ),
        HasDerivAt (fun t : ℝ ↦ (t + 1) ^ (-10 + 1 : ℝ) / (-10 + 1))
          ((x + 1) ^ (-10 : ℝ)) x := by
      intro x hx
      convert! (((hasDerivAt_id x).add_const 1).rpow_const _).div_const _ using 1
      · norm_num [id_eq]
      · left
        intro h
        have hx0 : 0 ≤ x := Set.mem_Ici.mp hx
        have hx1 : 0 < id x + 1 := by
          simpa only [id_eq] using add_pos_of_nonneg_of_pos hx0 zero_lt_one
        exact hx1.ne' h
    have ht : Tendsto (fun t : ℝ ↦ (t + 1) ^ (-10 + 1 : ℝ) / (-10 + 1)) atTop
        (𝓝 (0 / (-10 + 1))) := by
      rw [← neg_neg (-10 + 1 : ℝ)]
      exact (tendsto_rpow_neg_atTop (by norm_num : 0 < -(-10 + 1 : ℝ))).comp
        (tendsto_atTop_add_const_right _ 1 tendsto_id) |>.div_const _
    convert integral_Ioi_of_hasDerivAt_of_tendsto' hd
      (integrableOn_add_rpow_Ioi_of_lt (by norm_num : (-10 : ℝ) < -1)
        (by norm_num : -(1 : ℝ) < 0)) ht using 1; norm_num
  rw [hhalf]
  norm_num

theorem integral_bracketKernel_le_one : ∫ x : ℝ, bracketKernel x ≤ 1 := by
  rw [integral_bracketKernel]
  norm_num

@[simp]
theorem gaussian_pos (x : ℝ) : 0 < gaussian x := by
  exact Real.exp_pos _

@[simp]
theorem gaussian_nonneg (x : ℝ) : 0 ≤ gaussian x := (gaussian_pos x).le

theorem gaussian_le_one (x : ℝ) : gaussian x ≤ 1 := by
  unfold gaussian
  rw [Real.exp_le_one_iff]
  exact mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr Real.pi_pos.le) (sq_nonneg x)

theorem hasDerivAt_gaussian (x : ℝ) :
    HasDerivAt gaussian (gaussianDeriv x) x := by
  have hpow : HasDerivAt (fun y : ℝ ↦ y ^ 2) (2 * x) x := by
    simpa [pow_two, two_mul] using (hasDerivAt_pow 2 x)
  have hinner : HasDerivAt (fun y : ℝ ↦ -Real.pi * y ^ 2)
      (-2 * Real.pi * x) x := by
    convert! HasDerivAt.const_mul (-Real.pi) hpow using 1
    all_goals ring
  change HasDerivAt (Real.exp ∘ fun y : ℝ ↦ -Real.pi * y ^ 2)
    (-2 * Real.pi * x * Real.exp (-Real.pi * x ^ 2)) x
  convert! (Real.hasDerivAt_exp (-Real.pi * x ^ 2)).comp x hinner using 1
  all_goals ring

theorem integral_gaussian : ∫ x : ℝ, gaussian x = 1 := by
  simp only [gaussian]
  rw [_root_.integral_gaussian]
  rw [div_self (ne_of_gt Real.pi_pos), Real.sqrt_one]

theorem integrable_gaussian : Integrable gaussian := by
  change Integrable (fun x : ℝ ↦ Real.exp (-Real.pi * x ^ 2))
  exact integrable_exp_neg_mul_sq Real.pi_pos

/-- Every fixed polynomial weight is bounded against the Gaussian.  The
proof uses the Gaussian's exponential decay at the cocompact filter and the
extreme-value theorem, so the resulting constant is genuinely global. -/
theorem gaussian_polynomial_decay (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ, (1 + |x|) ^ n * gaussian x ≤ C := by
  let F : ℝ → ℝ := fun x ↦ (1 + |x|) ^ n * gaussian x
  have hg0 : Tendsto (fun x : ℝ ↦ gaussian x) (cocompact ℝ) (𝓝 0) := by
    simpa [gaussian, Real.rpow_zero] using
      (tendsto_rpow_abs_mul_exp_neg_mul_sq_cocompact Real.pi_pos (0 : ℝ))
  have hgn : Tendsto (fun x : ℝ ↦ |x| ^ n * gaussian x) (cocompact ℝ) (𝓝 0) := by
    simpa [gaussian, Real.rpow_natCast] using
      (tendsto_rpow_abs_mul_exp_neg_mul_sq_cocompact Real.pi_pos (n : ℝ))
  have hq : Tendsto (fun x : ℝ ↦ (2 : ℝ) ^ n * (gaussian x + |x| ^ n * gaussian x))
      (cocompact ℝ) (𝓝 0) := by
    convert (tendsto_const_nhds.mul (hg0.add hgn)) using 1; norm_num
  have hnonneg (x : ℝ) : 0 ≤ F x := by
    exact mul_nonneg (pow_nonneg (by positivity) _) (gaussian_nonneg x)
  have hupper (x : ℝ) : F x ≤ (2 : ℝ) ^ n * (gaussian x + |x| ^ n * gaussian x) := by
    dsimp [F]
    have hp : (1 + |x|) ^ n ≤ (2 : ℝ) ^ (n - 1) * (1 ^ n + |x| ^ n) :=
      add_pow_le zero_le_one (abs_nonneg x) n
    have hpow : (2 : ℝ) ^ (n - 1) ≤ (2 : ℝ) ^ n := by
      exact pow_le_pow_right₀ (a := (2 : ℝ)) (by norm_num) (Nat.sub_le n 1)
    calc
      (1 + |x|) ^ n * gaussian x ≤
          ((2 : ℝ) ^ (n - 1) * (1 ^ n + |x| ^ n)) * gaussian x := by
        exact mul_le_mul_of_nonneg_right hp (gaussian_nonneg x)
      _ ≤ ((2 : ℝ) ^ n * (1 ^ n + |x| ^ n)) * gaussian x := by
        exact mul_le_mul_of_nonneg_right (by gcongr) (gaussian_nonneg x)
      _ = (2 : ℝ) ^ n * (gaussian x + |x| ^ n * gaussian x) := by ring
  have hlim : Tendsto F (cocompact ℝ) (𝓝 0) :=
    tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hq
      (Filter.Eventually.of_forall hnonneg) (Filter.Eventually.of_forall hupper)
  have hFzero : F 0 = 1 := by simp [F, gaussian]
  have hev : ∀ᶠ x in cocompact ℝ, F x ≤ F 0 := by
    rw [hFzero]
    exact hlim.eventually (Iic_mem_nhds (by norm_num))
  have hcont : Continuous F := by
    dsimp [F, gaussian]
    fun_prop
  rcases hcont.exists_forall_ge' 0 hev with ⟨x0, hmax⟩
  exact ⟨F x0, hnonneg x0, fun x ↦ hmax x⟩

/-- The source-normalized Gaussian is fixed by the one-dimensional Fourier
transform. -/
theorem fourier_gaussian :
    (𝓕 fun x : ℝ ↦ (gaussian x : ℂ)) = fun ξ : ℝ ↦ (gaussian ξ : ℂ) := by
  have h := fourier_gaussian_pi (b := (1 : ℂ)) (by norm_num)
  convert h using 1 <;> ext x <;> simp [gaussian]

theorem hasDerivAt_complexGaussian (x : ℝ) :
    HasDerivAt (fun y : ℝ ↦ (gaussian y : ℂ)) (gaussianDeriv x : ℂ) x := by
  exact (hasDerivAt_gaussian x).ofReal_comp

theorem deriv_complexGaussian (x : ℝ) :
    deriv (fun y : ℝ ↦ (gaussian y : ℂ)) x = (gaussianDeriv x : ℂ) :=
  (hasDerivAt_complexGaussian x).deriv

theorem differentiable_complexGaussian : Differentiable ℝ (fun x : ℝ ↦ (gaussian x : ℂ)) := by
  intro x
  exact (hasDerivAt_complexGaussian x).differentiableAt

theorem integrable_gaussianDeriv : Integrable gaussianDeriv := by
  have h : Integrable (fun x : ℝ ↦ x * Real.exp (-Real.pi * x ^ 2)) :=
    integrable_mul_exp_neg_mul_sq Real.pi_pos
  convert h.const_mul (-2 * Real.pi) using 1
  ext x
  simp [gaussianDeriv, gaussian]
  ring

/-- The derivative of the Gaussian has the same arbitrary polynomial decay. -/
theorem gaussianDeriv_polynomial_decay (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ, (1 + |x|) ^ n * |gaussianDeriv x| ≤ C := by
  rcases gaussian_polynomial_decay (n + 1) with ⟨C, hC, h⟩
  refine ⟨2 * Real.pi * C, mul_nonneg (mul_nonneg (by norm_num) Real.pi_pos.le) hC, ?_⟩
  intro x
  have hderiv : |gaussianDeriv x| = 2 * Real.pi * |x| * gaussian x := by
    simp [gaussianDeriv, abs_mul, abs_of_pos Real.pi_pos, gaussian_nonneg]
  have hpow : (1 + |x|) ^ n * |x| ≤ (1 + |x|) ^ (n + 1) := by
    rw [pow_succ]
    apply mul_le_mul_of_nonneg_left
    · linarith [abs_nonneg x]
    · positivity
  rw [hderiv]
  calc
    (1 + |x|) ^ n * (2 * Real.pi * |x| * gaussian x) =
        (2 * Real.pi) * ((1 + |x|) ^ n * |x| * gaussian x) := by ring
    _ ≤ (2 * Real.pi) * ((1 + |x|) ^ (n + 1) * gaussian x) := by
      gcongr
      exact gaussian_nonneg x
    _ ≤ 2 * Real.pi * C := by
      exact mul_le_mul_of_nonneg_left (h x) (mul_nonneg (by norm_num) Real.pi_pos.le)

theorem integrable_complexGaussianDeriv :
    Integrable (fun x : ℝ ↦ (gaussianDeriv x : ℂ)) :=
  integrable_gaussianDeriv.ofReal

/-- Fourier transformation of the source derivative. -/
theorem fourier_gaussianDeriv :
    (𝓕 fun x : ℝ ↦ (gaussianDeriv x : ℂ)) =
      fun ξ : ℝ ↦ -Complex.I * (gaussianDeriv ξ : ℂ) := by
  have hderivInt : Integrable (deriv fun x : ℝ ↦ (gaussian x : ℂ)) := by
    convert integrable_complexGaussianDeriv using 1
    ext x
    rw [deriv_complexGaussian]
  calc
    (𝓕 fun x : ℝ ↦ (gaussianDeriv x : ℂ)) =
        𝓕 (deriv fun x : ℝ ↦ (gaussian x : ℂ)) := by
      congr 1
      ext x
      rw [deriv_complexGaussian]
    _ = fun ξ : ℝ ↦ (2 * Real.pi * Complex.I * ξ) •
        (𝓕 fun x : ℝ ↦ (gaussian x : ℂ)) ξ :=
      Real.fourier_deriv integrable_gaussian.ofReal differentiable_complexGaussian hderivInt
    _ = fun ξ : ℝ ↦ -Complex.I * (gaussianDeriv ξ : ℂ) := by
      funext ξ
      rw [fourier_gaussian]
      simp [gaussianDeriv]
      ring

theorem gaussianDeriv_neg (x : ℝ) : gaussianDeriv (-x) = -gaussianDeriv x := by
  simp [gaussianDeriv, gaussian]

theorem gaussian_even (x : ℝ) : gaussian (-x) = gaussian x := by
  simp [gaussian]

theorem integral_gaussianDeriv : ∫ x : ℝ, gaussianDeriv x = 0 := by
  have hneg : MeasurePreserving (fun x : ℝ ↦ -x) volume volume :=
    Measure.measurePreserving_neg (volume : Measure ℝ)
  have hchange := hneg.integral_comp (Homeomorph.neg ℝ).measurableEmbedding gaussianDeriv
  have hodd : (∫ x : ℝ, gaussianDeriv (-x)) = -∫ x : ℝ, gaussianDeriv x := by
    rw [← integral_neg]
    apply integral_congr_ae
    filter_upwards with x
    rw [gaussianDeriv_neg]
  rw [hodd] at hchange
  linarith

/-! ### One-dimensional kernel dilations

These definitions retain the normalization and translation convention fixed
at the start of the blueprint: `v_(s)(x) = s⁻¹ v(x / s)` and
`v_(s,a)(x) = v_(s)(x-a)`. -/

/-- Mass-normalized one-dimensional dilation of a scalar-valued kernel. -/
def kernelDilate {V : Type*} [SMul ℝ V] (v : ℝ → V) (s x : ℝ) : V :=
  s⁻¹ • v (x / s)

/-- The translated, mass-normalized kernel `v_{s,a}`. -/
def kernelAt {V : Type*} [SMul ℝ V] (v : ℝ → V) (s a x : ℝ) : V :=
  kernelDilate v s (x - a)

theorem kernelAt_one (v : ℝ → ℝ) (a x : ℝ) : kernelAt v 1 a x = v (x - a) := by
  simp [kernelAt, kernelDilate]

/-- The precise nested-dilation convention used repeatedly in the source. -/
theorem kernelAt_dilate_translate {V : Type*} [AddCommMonoid V] [Module ℝ V] (v : ℝ → V)
    {s : ℝ} (hs : s ≠ 0) (r a x : ℝ) :
    kernelAt (kernelAt v 1 r) s a x = kernelAt v s (a + s * r) x := by
  simp only [kernelAt, kernelDilate, inv_one, one_smul]
  congr 2
  field_simp
  ring

/-- A polynomial order-ten decay estimate is stable under the source's
mass-normalized dilation, with the precise `λ^9` loss used in Gaussian
domination. -/
theorem kernelAt_scale_bracket_of_polynomial_decay (f : ℝ → ℝ)
    (hdecay : ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      (1 + |x|) ^ 10 * |f x| ≤ C) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (s v : ℝ), 1 ≤ s →
      |kernelAt f s 0 v| ≤ C * s ^ 9 * bracketKernel v := by
  rcases hdecay with ⟨C, hC, hdecay⟩
  refine ⟨C, hC, ?_⟩
  intro s v hs
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hsne : s ≠ 0 := hspos.ne'
  have hB : 1 + |v| ≤ s * (1 + |v / s|) := by
    have hv : |v| = s * |v / s| := by
      calc
        |v| = |s * (v / s)| := congrArg abs (by field_simp)
        _ = s * |v / s| := by rw [abs_mul, abs_of_nonneg hspos.le]
    rw [hv]
    nlinarith [abs_nonneg (v / s)]
  have hBpow : (1 + |v|) ^ 10 ≤ s ^ 10 * (1 + |v / s|) ^ 10 := by
    calc
      (1 + |v|) ^ 10 ≤ (s * (1 + |v / s|)) ^ 10 :=
        pow_le_pow_left₀ (by positivity) hB 10
      _ = s ^ 10 * (1 + |v / s|) ^ 10 := by rw [mul_pow]
  have hmain : |s⁻¹ * f (v / s)| ≤ (C * s ^ 9) / (1 + |v|) ^ 10 := by
    apply (le_div_iff₀ (pow_pos (by positivity) _)).mpr
    rw [abs_mul, abs_of_pos (inv_pos.mpr hspos)]
    calc
      s⁻¹ * |f (v / s)| * (1 + |v|) ^ 10 ≤
          s⁻¹ * |f (v / s)| * (s ^ 10 * (1 + |v / s|) ^ 10) :=
        mul_le_mul_of_nonneg_left hBpow
          (mul_nonneg (inv_nonneg.mpr hspos.le) (abs_nonneg _))
      _ = s ^ 9 * ((1 + |v / s|) ^ 10 * |f (v / s)|) := by
        field_simp
      _ ≤ s ^ 9 * C :=
        mul_le_mul_of_nonneg_left (hdecay (v / s)) (pow_nonneg hspos.le _)
      _ = C * s ^ 9 := by ring
  simpa [kernelAt, kernelDilate, bracketKernel_eq_inv_pow, div_eq_mul_inv, smul_eq_mul] using hmain

/-- The same order-ten decay controls unit-scale translations with the
source weight `R(r)^10`. -/
theorem kernelAt_translate_bracket_of_polynomial_decay (f : ℝ → ℝ)
    (hdecay : ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      (1 + |x|) ^ 10 * |f x| ≤ C) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (r v : ℝ),
      |kernelAt f 1 r v| ≤ C * translationWeight r ^ 10 * bracketKernel v := by
  rcases hdecay with ⟨C, hC, hdecay⟩
  refine ⟨C, hC, ?_⟩
  intro r v
  have hv : |v| ≤ |v - r| + |r| := by
    calc
      |v| = |(v - r) + r| := congrArg abs (by ring)
      _ ≤ |v - r| + |r| := abs_add_le (v - r) r
  have hRnonneg : 0 ≤ translationWeight r := by
    unfold translationWeight
    positivity
  have hB : 1 + |v| ≤ translationWeight r * (1 + |v - r|) := by
    unfold translationWeight
    nlinarith [mul_nonneg (abs_nonneg r) (abs_nonneg (v - r))]
  have hBpow : (1 + |v|) ^ 10 ≤
      translationWeight r ^ 10 * (1 + |v - r|) ^ 10 := by
    calc
      (1 + |v|) ^ 10 ≤ (translationWeight r * (1 + |v - r|)) ^ 10 :=
        pow_le_pow_left₀ (by positivity) hB 10
      _ = translationWeight r ^ 10 * (1 + |v - r|) ^ 10 := by rw [mul_pow]
  have hmain : |f (v - r)| ≤
      (C * translationWeight r ^ 10) / (1 + |v|) ^ 10 := by
    apply (le_div_iff₀ (pow_pos (by positivity) _)).mpr
    calc
      |f (v - r)| * (1 + |v|) ^ 10 ≤
          |f (v - r)| *
            (translationWeight r ^ 10 * (1 + |v - r|) ^ 10) :=
        mul_le_mul_of_nonneg_left hBpow (abs_nonneg _)
      _ = translationWeight r ^ 10 * ((1 + |v - r|) ^ 10 * |f (v - r)|) := by
        ring
      _ ≤ translationWeight r ^ 10 * C :=
        mul_le_mul_of_nonneg_left (hdecay (v - r)) (pow_nonneg hRnonneg _)
      _ = C * translationWeight r ^ 10 := by ring
  simpa [kernelAt, kernelDilate, bracketKernel_eq_inv_pow, div_eq_mul_inv,
    translationWeight, smul_eq_mul] using hmain

/-- The source kernels `\(\mathsf g_{s,a}\)`. -/
def gaussianAt (s a x : ℝ) : ℝ := kernelAt gaussian s a x

/-- The source kernels `\(\mathsf h_{s,a}\)`. -/
def gaussianDerivAt (s a x : ℝ) : ℝ := kernelAt gaussianDeriv s a x

/-- The translated and mass-normalized comparison kernel. -/
def bracketKernelAt (s a x : ℝ) : ℝ := kernelAt bracketKernel s a x

theorem integrable_gaussianAt {s : ℝ} (hs : 0 < s) (a : ℝ) :
    Integrable (gaussianAt s a) := by
  unfold gaussianAt kernelAt kernelDilate
  exact ((integrable_gaussian.comp_div hs.ne').comp_sub_right a).smul (s⁻¹ : ℝ)

theorem integrable_gaussianDerivAt {s : ℝ} (hs : 0 < s) (a : ℝ) :
    Integrable (gaussianDerivAt s a) := by
  unfold gaussianDerivAt kernelAt kernelDilate
  exact ((integrable_gaussianDeriv.comp_div hs.ne').comp_sub_right a).smul (s⁻¹ : ℝ)

theorem integrable_bracketKernelAt {s : ℝ} (hs : 0 < s) (a : ℝ) :
    Integrable (bracketKernelAt s a) := by
  unfold bracketKernelAt kernelAt kernelDilate
  exact ((integrable_bracketKernel.comp_div hs.ne').comp_sub_right a).smul (s⁻¹ : ℝ)

theorem bracketKernelAt_pos {s a x : ℝ} (hs : 0 < s) :
    0 < bracketKernelAt s a x := by
  unfold bracketKernelAt kernelAt kernelDilate
  exact smul_pos (inv_pos.mpr hs) (bracketKernel_pos _)

theorem integral_gaussianAt {s : ℝ} (hs : 0 < s) (a : ℝ) :
    ∫ x : ℝ, gaussianAt s a x = 1 := by
  unfold gaussianAt kernelAt kernelDilate
  rw [integral_smul]
  rw [integral_sub_right_eq_self (μ := volume) (fun x : ℝ ↦ gaussian (x / s)) a]
  rw [Measure.integral_comp_div]
  simp [abs_of_pos hs, integral_gaussian, hs.ne']

theorem integral_gaussianDerivAt {s : ℝ} (hs : 0 < s) (a : ℝ) :
    ∫ x : ℝ, gaussianDerivAt s a x = 0 := by
  unfold gaussianDerivAt kernelAt kernelDilate
  rw [integral_smul]
  rw [integral_sub_right_eq_self (μ := volume) (fun x : ℝ ↦ gaussianDeriv (x / s)) a]
  rw [Measure.integral_comp_div]
  simp [abs_of_pos hs, integral_gaussianDeriv]

theorem integral_bracketKernelAt {s : ℝ} (hs : 0 < s) (a : ℝ) :
    ∫ x : ℝ, bracketKernelAt s a x = 2 / 9 := by
  unfold bracketKernelAt kernelAt kernelDilate
  rw [integral_smul]
  rw [integral_sub_right_eq_self (μ := volume) (fun x : ℝ ↦ bracketKernel (x / s)) a]
  rw [Measure.integral_comp_div]
  simp [abs_of_pos hs, integral_bracketKernel, hs.ne']

/-- The source derivative kernel is the logarithmic spatial derivative of
the mass-normalized Gaussian.  This explicit formula is the algebraic input
for the center and scale differentiation identities in Section 4. -/
theorem gaussianDerivAt_eq_logarithmic_deriv {s a x : ℝ} (hs : s ≠ 0) :
    gaussianDerivAt s a x =
      (-2 * Real.pi * ((x - a) / s)) * gaussianAt s a x := by
  simp only [gaussianDerivAt, gaussianAt, kernelAt, kernelDilate,
    gaussianDeriv, smul_eq_mul]
  field_simp

/-- Differentiating the center parameter of a Gaussian produces the
derivative Gaussian with the source sign and scale factor. -/
theorem hasDerivAt_gaussianAt_center {s a x : ℝ} (hs : s ≠ 0) :
    HasDerivAt (fun p : ℝ ↦ gaussianAt s p x)
      (-s⁻¹ * gaussianDerivAt s a x) a := by
  change HasDerivAt (fun p : ℝ ↦ s⁻¹ * gaussian ((x - p) / s))
    (-s⁻¹ * (s⁻¹ * gaussianDeriv ((x - a) / s))) a
  have hinner : HasDerivAt (fun p : ℝ ↦ (x - p) / s) (-s⁻¹) a := by
    simpa [div_eq_mul_inv] using
      ((hasDerivAt_const (c := x) a).sub (hasDerivAt_id (𝕜 := ℝ) a)).div_const s
  have houter := (hasDerivAt_gaussian ((x - a) / s)).comp a hinner
  simpa [Function.comp_def, mul_assoc, mul_left_comm, mul_comm] using
    houter.const_mul s⁻¹

/-- Differentiating the scale parameter of a mass-normalized Gaussian.  The
formula is kept in terms of `gaussianDerivAt`, which is the form that later
combines with the center derivative by integration by parts. -/
theorem hasDerivAt_gaussianAt_scale {s a x : ℝ} (hs : s ≠ 0) :
    HasDerivAt (fun u : ℝ ↦ gaussianAt u a x)
      (-s⁻¹ * gaussianAt s a x - (x - a) * (s ^ 2)⁻¹ * gaussianDerivAt s a x) s := by
  change HasDerivAt (fun u : ℝ ↦ u⁻¹ * gaussian ((x - a) / u))
    (-s⁻¹ * (s⁻¹ * gaussian ((x - a) / s)) -
      (x - a) * (s ^ 2)⁻¹ * (s⁻¹ * gaussianDeriv ((x - a) / s))) s
  have hinv : HasDerivAt (fun u : ℝ ↦ u⁻¹) (-(s ^ 2)⁻¹) s := by
    simpa [inv_pow] using hasDerivAt_inv hs
  have hinner : HasDerivAt (fun u : ℝ ↦ (x - a) / u)
      ((x - a) * (-(s ^ 2)⁻¹)) s := by
    simpa [div_eq_mul_inv] using hinv.const_mul (x - a)
  have houter := (hasDerivAt_gaussian ((x - a) / s)).comp s hinner
  have hraw := hinv.mul houter
  have hcoef :
      -(s ^ 2)⁻¹ * gaussian ((x - a) / s) +
          s⁻¹ * (gaussianDeriv ((x - a) / s) * ((x - a) * -(s ^ 2)⁻¹)) =
        -s⁻¹ * (s⁻¹ * gaussian ((x - a) / s)) -
          (x - a) * (s ^ 2)⁻¹ * (s⁻¹ * gaussianDeriv ((x - a) / s)) := by
    rw [← inv_pow]
    ring
  rw [← hcoef]
  convert! hraw using 1

/-! ### Scalar kernels for the one-dimensional telescope

These names isolate one active coordinate of the cubical form.  They match
the source notation `G_i,H_i,D_i,P_i,W_i,E_i` and let the differential and
integration-by-parts calculations be proved once before being applied in the
three coordinate directions. -/

def scalarG (mu sig : ℝ) (n : ℕ) (t p u : ℝ) : ℝ :=
  gaussianAt (mu * t ^ n) (p + sig * t ^ n) u

def scalarH (mu sig : ℝ) (n : ℕ) (t p u : ℝ) : ℝ :=
  gaussianDerivAt (mu * t ^ n) (p + sig * t ^ n) u

def scalarD (mu sig : ℝ) (n : ℕ) (t p u0 u1 : ℝ) : ℝ :=
  scalarG mu sig n t p u0 * scalarG mu sig n t p u1

def scalarP (mu sig : ℝ) (n : ℕ) (t p u0 u1 : ℝ) : ℝ :=
  scalarH mu sig n t p u0 * scalarH mu sig n t p u1

def scalarW (mu sig : ℝ) (n : ℕ) (t p u0 u1 : ℝ) : ℝ :=
  scalarH mu sig n t p u0 * scalarG mu sig n t p u1 +
    scalarG mu sig n t p u0 * scalarH mu sig n t p u1

def scalarE (mu sig : ℝ) (n : ℕ) (t p u0 u1 : ℝ) : ℝ :=
  mu / (2 * Real.pi) * scalarW mu sig n t p u0 u1 -
    sig * scalarD mu sig n t p u0 u1

theorem scalarH_eq_logarithmic {mu sig : ℝ} {n : ℕ} {t p u : ℝ}
    (hscale : mu * t ^ n ≠ 0) :
    scalarH mu sig n t p u =
      (-2 * Real.pi * ((u - (p + sig * t ^ n)) / (mu * t ^ n))) *
        scalarG mu sig n t p u := by
  exact gaussianDerivAt_eq_logarithmic_deriv hscale

theorem hasDerivAt_scalarG_center {mu sig : ℝ} {n : ℕ} {t p u : ℝ}
    (hscale : mu * t ^ n ≠ 0) :
    HasDerivAt (fun q : ℝ ↦ scalarG mu sig n t q u)
      (-(mu * t ^ n)⁻¹ * scalarH mu sig n t p u) p := by
  have hbase := hasDerivAt_gaussianAt_center (a := p + sig * t ^ n)
    (x := u) hscale
  have hcenter : HasDerivAt (fun q : ℝ ↦ q + sig * t ^ n) 1 p := by
    simpa using (hasDerivAt_id' (𝕜 := ℝ) p).add_const (sig * t ^ n)
  convert! hbase.comp p hcenter using 1
  simp [scalarH]

/-- Raw scale differentiation of the scalar Gaussian factor.  Introducing
the scale and center tangents explicitly keeps the later source identity
algebraic rather than hiding a parameter interchange. -/
theorem hasDerivAt_scalarG_scale_raw {mu sig : ℝ} {n : ℕ} {t p u : ℝ}
    (hscale : mu * t ^ n ≠ 0) :
    let w : ℝ := t ^ n
    let dw : ℝ := (n : ℝ) * t ^ (n - 1)
    let s : ℝ := mu * w
    let ds : ℝ := mu * dw
    let a : ℝ := p + sig * w
    let da : ℝ := sig * dw
    let z : ℝ := (u - a) / s
    let dz : ℝ := ((-da) * s - (u - a) * ds) / s ^ 2
    HasDerivAt (fun q : ℝ => scalarG mu sig n q p u)
      ((-ds / s ^ 2) * gaussian z + s⁻¹ * gaussianDeriv z * dz) t := by
  dsimp only
  have hp : HasDerivAt (fun q : ℝ => q ^ n)
      ((n : ℝ) * t ^ (n - 1)) t := by
    simpa using hasDerivAt_pow n t
  have hsfun : HasDerivAt (fun q : ℝ => mu * q ^ n)
      (mu * ((n : ℝ) * t ^ (n - 1))) t := by
    convert! hp.const_mul mu using 1
  have hafun : HasDerivAt (fun q : ℝ => p + sig * q ^ n)
      (sig * ((n : ℝ) * t ^ (n - 1))) t := by
    convert! (hp.const_mul sig).const_add p using 1
  have hnum : HasDerivAt (fun q : ℝ => u - (p + sig * q ^ n))
      (-(sig * ((n : ℝ) * t ^ (n - 1)))) t := by
    convert! hafun.const_sub u using 1
  have hzfun := hnum.div hsfun hscale
  have hinv := hsfun.inv hscale
  have houter := (hasDerivAt_gaussian
    ((u - (p + sig * t ^ n)) / (mu * t ^ n))).comp t hzfun
  have hprod := hinv.mul houter
  convert! hprod using 1
  simp only [Function.comp_apply, Pi.div_apply, Pi.inv_apply]
  ring

/-- The clean logarithmic scale derivative of one scalar Gaussian.  This is
the scalar version of the source's scale derivative before the two endpoint
variables are multiplied together. -/
theorem hasDerivAt_scalarG_scale {mu sig : ℝ} {n : ℕ} {t p u : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    HasDerivAt (fun q : ℝ => scalarG mu sig n q p u)
      (-(n : ℝ) / t *
        (scalarG mu sig n t p u +
          (((u - (p + sig * t ^ n)) / (mu * t ^ n)) + sig / mu) *
            scalarH mu sig n t p u)) t := by
  have hpowne : t ^ n ≠ 0 := pow_ne_zero n ht
  have hscale : mu * t ^ n ≠ 0 := mul_ne_zero hmu hpowne
  have hraw := hasDerivAt_scalarG_scale_raw
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u := u) hscale
  have hpow : t * ((n : ℝ) * t ^ (n - 1)) = (n : ℝ) * t ^ n := by
    cases n with
    | zero => norm_num
    | succ n =>
      rw [Nat.cast_succ, Nat.succ_sub_one, pow_succ]
      ring
  let w : ℝ := t ^ n
  let dw : ℝ := (n : ℝ) * t ^ (n - 1)
  let s : ℝ := mu * w
  let ds : ℝ := mu * dw
  let a : ℝ := p + sig * w
  let da : ℝ := sig * dw
  let z : ℝ := (u - a) / s
  let dz : ℝ := ((-da) * s - (u - a) * ds) / s ^ 2
  change HasDerivAt (fun q : ℝ ↦ (mu * q ^ n)⁻¹ * gaussian
    ((u - (p + sig * q ^ n)) / (mu * q ^ n)))
    (-(n : ℝ) / t * (s⁻¹ * gaussian z + (z + sig / mu) *
      (s⁻¹ * gaussianDeriv z))) t
  have hcoef :
      (-ds / s ^ 2) * gaussian z + s⁻¹ * gaussianDeriv z * dz =
        -(n : ℝ) / t * (s⁻¹ * gaussian z + (z + sig / mu) *
          (s⁻¹ * gaussianDeriv z)) := by
    dsimp [w, dw, s, ds, a, da, z, dz]
    field_simp [hmu, ht]
    let X : ℝ :=
      -(mu * t ^ n * gaussian ((u - (p + t ^ n * sig)) / (mu * t ^ n))) +
        gaussianDeriv ((u - (p + t ^ n * sig)) / (mu * t ^ n)) *
          (-(t ^ n * sig) - (u - (p + t ^ n * sig)))
    change ((n : ℝ) * t ^ (n - 1)) * X * t = _
    have hpow' : ((n : ℝ) * t ^ (n - 1)) * t = (n : ℝ) * t ^ n := by
      rw [mul_comm]
      exact hpow
    calc
      ((n : ℝ) * t ^ (n - 1)) * X * t =
          (((n : ℝ) * t ^ (n - 1)) * t) * X := by ring
      _ = ((n : ℝ) * t ^ n) * X := by rw [hpow']
      _ = _ := by dsimp [X]; ring
  rw [← hcoef]
  convert! hraw using 1

theorem hasDerivAt_gaussianDeriv (x : ℝ) :
    HasDerivAt gaussianDeriv
      (-2 * Real.pi * gaussian x - 2 * Real.pi * x * gaussianDeriv x) x := by
  have hprod := (hasDerivAt_id' (𝕜 := ℝ) x).mul (hasDerivAt_gaussian x)
  have hscaled := hprod.const_mul (-2 * Real.pi)
  have hcoeff : -2 * Real.pi * (1 * gaussian x + x * gaussianDeriv x) =
      -2 * Real.pi * gaussian x - 2 * Real.pi * x * gaussianDeriv x := by ring
  rw [← hcoeff]
  change HasDerivAt (fun y : ℝ ↦ -2 * Real.pi * y * gaussian y) _ x
  simpa [Function.comp_def, mul_assoc] using hscaled

theorem hasDerivAt_scalarH_center {mu sig : ℝ} {n : ℕ} {t p u : ℝ} :
    HasDerivAt (fun q : ℝ ↦ scalarH mu sig n t q u)
      ((mu * t ^ n)⁻¹ *
        (2 * Real.pi * scalarG mu sig n t p u +
          2 * Real.pi * ((u - (p + sig * t ^ n)) / (mu * t ^ n)) *
            scalarH mu sig n t p u)) p := by
  let s : ℝ := mu * t ^ n
  let z : ℝ := (u - (p + sig * t ^ n)) / s
  change HasDerivAt (fun q : ℝ ↦ s⁻¹ *
      gaussianDeriv ((u - (q + sig * t ^ n)) / s))
    (s⁻¹ * (2 * Real.pi * (s⁻¹ * gaussian z) +
      2 * Real.pi * z * (s⁻¹ * gaussianDeriv z))) p
  have hinner : HasDerivAt
      (fun q : ℝ ↦ (u - (q + sig * t ^ n)) / (mu * t ^ n))
      (-(mu * t ^ n)⁻¹) p := by
    have hsub : HasDerivAt (fun q : ℝ ↦ u - (q + sig * t ^ n)) (-1) p := by
      convert! ((hasDerivAt_id' (𝕜 := ℝ) p).add_const (sig * t ^ n)).const_sub u using 1
    simpa [div_eq_mul_inv] using hsub.mul_const (mu * t ^ n)⁻¹
  have houter := (hasDerivAt_gaussianDeriv
    ((u - (p + sig * t ^ n)) / (mu * t ^ n))).comp p hinner
  have hraw := houter.const_mul (mu * t ^ n)⁻¹
  have hcoef : s⁻¹ *
      ((-2 * Real.pi * gaussian z - 2 * Real.pi * z * gaussianDeriv z) * -s⁻¹) =
    s⁻¹ * (2 * Real.pi * (s⁻¹ * gaussian z) +
      2 * Real.pi * z * (s⁻¹ * gaussianDeriv z)) := by ring
  rw [← hcoef]
  convert! hraw using 1

theorem hasDerivAt_scalarD_center {mu sig : ℝ} {n : ℕ} {t p u0 u1 : ℝ}
    (hscale : mu * t ^ n ≠ 0) :
    HasDerivAt (fun q : ℝ ↦ scalarD mu sig n t q u0 u1)
      (-(mu * t ^ n)⁻¹ * scalarW mu sig n t p u0 u1) p := by
  have h0 := hasDerivAt_scalarG_center (mu := mu) (sig := sig)
    (n := n) (t := t) (p := p) (u := u0) hscale
  have h1 := hasDerivAt_scalarG_center (mu := mu) (sig := sig)
    (n := n) (t := t) (p := p) (u := u1) hscale
  have hraw := h0.mul h1
  convert! hraw using 1
  simp [scalarW]
  ring

/-- Standardized affine coordinate inside a scalar local Gaussian. -/
def scalarZ (mu sig : ℝ) (n : ℕ) (t p u : ℝ) : ℝ :=
  (u - (p + sig * t ^ n)) / (mu * t ^ n)

/-- Restatement of the clean scale calculation using the standardized
coordinate. -/
theorem hasDerivAt_scalarG_scale_z {mu sig : ℝ} {n : ℕ} {t p u : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    HasDerivAt (fun q : ℝ => scalarG mu sig n q p u)
      (-(n : ℝ) / t *
        (scalarG mu sig n t p u + (scalarZ mu sig n t p u + sig / mu) *
          scalarH mu sig n t p u)) t := by
  simpa [scalarZ] using hasDerivAt_scalarG_scale
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u := u) hmu ht

theorem hasDerivAt_scalarD_scale {mu sig : ℝ} {n : ℕ} {t p u0 u1 : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    HasDerivAt (fun q : ℝ => scalarD mu sig n q p u0 u1)
      (-(n : ℝ) / t *
        (2 * scalarD mu sig n t p u0 u1 +
          (scalarZ mu sig n t p u0 + sig / mu) * scalarH mu sig n t p u0 *
            scalarG mu sig n t p u1 +
          (scalarZ mu sig n t p u1 + sig / mu) * scalarG mu sig n t p u0 *
            scalarH mu sig n t p u1)) t := by
  have h0 := hasDerivAt_scalarG_scale_z
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u := u0) hmu ht
  have h1 := hasDerivAt_scalarG_scale_z
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u := u1) hmu ht
  have hprod := h0.mul h1
  convert! hprod using 1
  simp [scalarD]
  ring

/-- Restatement of the `H` center derivative using `scalarZ`. -/
theorem hasDerivAt_scalarH_center_z {mu sig : ℝ} {n : ℕ} {t p u : ℝ} :
    HasDerivAt (fun q : ℝ => scalarH mu sig n t q u)
      ((mu * t ^ n)⁻¹ *
        (2 * Real.pi * scalarG mu sig n t p u +
          2 * Real.pi * scalarZ mu sig n t p u * scalarH mu sig n t p u)) p := by
  simpa [scalarZ] using hasDerivAt_scalarH_center
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u := u)

theorem hasDerivAt_scalarE_center {mu sig : ℝ} {n : ℕ} {t p u0 u1 : ℝ}
    (hscale : mu * t ^ n ≠ 0) :
    HasDerivAt (fun q : ℝ => scalarE mu sig n t q u0 u1)
      (mu / (2 * Real.pi) * (mu * t ^ n)⁻¹ *
        (4 * Real.pi * scalarD mu sig n t p u0 u1 +
          2 * Real.pi * scalarZ mu sig n t p u0 * scalarH mu sig n t p u0 *
            scalarG mu sig n t p u1 +
          2 * Real.pi * scalarZ mu sig n t p u1 * scalarG mu sig n t p u0 *
            scalarH mu sig n t p u1 -
          2 * scalarP mu sig n t p u0 u1) +
        sig * (mu * t ^ n)⁻¹ * scalarW mu sig n t p u0 u1) p := by
  have hg0 := hasDerivAt_scalarG_center
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u := u0) hscale
  have hg1 := hasDerivAt_scalarG_center
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u := u1) hscale
  have hh0 := hasDerivAt_scalarH_center_z
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u := u0)
  have hh1 := hasDerivAt_scalarH_center_z
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u := u1)
  have hw := (hh0.mul hg1).add (hg0.mul hh1)
  have hd := hg0.mul hg1
  have he := hw.const_mul (mu / (2 * Real.pi)) |>.sub (hd.const_mul sig)
  convert! he using 1
  simp [scalarE, scalarW, scalarD, scalarP]
  ring

/-- Pointwise one-dimensional divergence identity underlying the source
telescoping lemma. -/
theorem scalar_pointwise_divergence {mu sig : ℝ} {n : ℕ} {t p u0 u1 : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    -t * deriv (fun q : ℝ => scalarD mu sig n q p u0 u1) t =
      (n : ℝ) / Real.pi * scalarP mu sig n t p u0 u1 +
        (n : ℝ) * t ^ n * deriv (fun q : ℝ => scalarE mu sig n t q u0 u1) p := by
  have hpowne : t ^ n ≠ 0 := pow_ne_zero n ht
  have hscale : mu * t ^ n ≠ 0 := mul_ne_zero hmu hpowne
  have hD := hasDerivAt_scalarD_scale
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u0 := u0) (u1 := u1)
      hmu ht
  have hE := hasDerivAt_scalarE_center
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u0 := u0) (u1 := u1)
      hscale
  rw [hD.deriv, hE.deriv]
  field_simp [hmu, ht, Real.pi_ne_zero]
  simp [scalarW]
  ring

/-- The exact interval form of the one-dimensional source identity, with the
regularity required by the ordinary fundamental theorem made explicit. -/
theorem scalar_oneDim_telescoping
    {mu sig t a b u0 u1 : ℝ} {n : ℕ}
    (hmu : mu ≠ 0) (ht : t ≠ 0)
    (hDdot : IntervalIntegrable
      (fun p : ℝ => deriv (fun q : ℝ => scalarD mu sig n q p u0 u1) t)
      volume a b)
    (hP : IntervalIntegrable (fun p : ℝ => scalarP mu sig n t p u0 u1)
      volume a b)
    (hEdiff : ∀ p ∈ Set.uIcc a b,
      DifferentiableAt ℝ (fun q : ℝ => scalarE mu sig n t q u0 u1) p)
    (hEcont : ContinuousOn
      (deriv (fun q : ℝ => scalarE mu sig n t q u0 u1)) (Set.uIcc a b)) :
    ∫ p in a..b, -t * deriv (fun q : ℝ => scalarD mu sig n q p u0 u1) t =
      (n : ℝ) / Real.pi *
          (∫ p in a..b, scalarP mu sig n t p u0 u1) +
        (n : ℝ) * t ^ n *
          (scalarE mu sig n t b u0 u1 - scalarE mu sig n t a u0 u1) := by
  have hEint : IntervalIntegrable
      (deriv (fun q : ℝ => scalarE mu sig n t q u0 u1)) volume a b :=
    hEcont.intervalIntegrable
  have hFTC :
      (∫ p in a..b, deriv (fun q : ℝ => scalarE mu sig n t q u0 u1) p) =
        scalarE mu sig n t b u0 u1 - scalarE mu sig n t a u0 u1 :=
    intervalIntegral.integral_deriv_eq_sub hEdiff hEint
  calc
    ∫ p in a..b, -t * deriv (fun q : ℝ => scalarD mu sig n q p u0 u1) t =
        ∫ p in a..b, ((n : ℝ) / Real.pi * scalarP mu sig n t p u0 u1 +
          (n : ℝ) * t ^ n *
            deriv (fun q : ℝ => scalarE mu sig n t q u0 u1) p) := by
      apply intervalIntegral.integral_congr
      intro p hp
      exact scalar_pointwise_divergence
        (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u0 := u0) (u1 := u1)
          hmu ht
    _ = (n : ℝ) / Real.pi *
          (∫ p in a..b, scalarP mu sig n t p u0 u1) +
        (n : ℝ) * t ^ n *
          (∫ p in a..b, deriv (fun q : ℝ => scalarE mu sig n t q u0 u1) p) := by
      rw [intervalIntegral.integral_add
        (hP.const_mul ((n : ℝ) / Real.pi))
        (hEint.const_mul ((n : ℝ) * t ^ n))]
      rw [intervalIntegral.integral_const_mul,
        intervalIntegral.integral_const_mul]
    _ = _ := by rw [hFTC]

/-- Continuous dependence of the scalar Gaussian pair on its active center. -/
theorem continuous_scalarG_center {mu sig : ℝ} {n : ℕ} {t u : ℝ}
    (hscale : mu * t ^ n ≠ 0) :
    Continuous (fun p : ℝ ↦ scalarG mu sig n t p u) := by
  rw [continuous_iff_continuousAt]
  intro p
  exact (hasDerivAt_scalarG_center (mu := mu) (sig := sig) (n := n)
    (t := t) (p := p) (u := u) hscale).continuousAt

theorem continuous_scalarH_center {mu sig : ℝ} {n : ℕ} {t u : ℝ} :
    Continuous (fun p : ℝ ↦ scalarH mu sig n t p u) := by
  rw [continuous_iff_continuousAt]
  intro p
  exact (hasDerivAt_scalarH_center (mu := mu) (sig := sig) (n := n)
    (t := t) (p := p) (u := u)).continuousAt

theorem continuous_scalarZ_center {mu sig : ℝ} {n : ℕ} {t u : ℝ} :
    Continuous (fun p : ℝ ↦ scalarZ mu sig n t p u) := by
  unfold scalarZ
  fun_prop

theorem continuous_scalarD_center {mu sig : ℝ} {n : ℕ} {t u0 u1 : ℝ}
    (hscale : mu * t ^ n ≠ 0) :
    Continuous (fun p : ℝ ↦ scalarD mu sig n t p u0 u1) := by
  exact (continuous_scalarG_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u0) hscale).mul
      (continuous_scalarG_center (mu := mu) (sig := sig) (n := n)
        (t := t) (u := u1) hscale)

theorem continuous_scalarP_center {mu sig : ℝ} {n : ℕ} {t u0 u1 : ℝ} :
    Continuous (fun p : ℝ ↦ scalarP mu sig n t p u0 u1) := by
  exact (continuous_scalarH_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u0)).mul
      (continuous_scalarH_center (mu := mu) (sig := sig) (n := n)
        (t := t) (u := u1))

theorem continuous_scalarW_center {mu sig : ℝ} {n : ℕ} {t u0 u1 : ℝ}
    (hscale : mu * t ^ n ≠ 0) :
    Continuous (fun p : ℝ ↦ scalarW mu sig n t p u0 u1) := by
  have hG0 := continuous_scalarG_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u0) hscale
  have hG1 := continuous_scalarG_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u1) hscale
  have hH0 := continuous_scalarH_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u0)
  have hH1 := continuous_scalarH_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u1)
  convert! (hH0.mul hG1).add (hG0.mul hH1) using 1

theorem continuous_scalarE_center {mu sig : ℝ} {n : ℕ} {t u0 u1 : ℝ}
    (hscale : mu * t ^ n ≠ 0) :
    Continuous (fun p : ℝ ↦ scalarE mu sig n t p u0 u1) := by
  have hW := continuous_scalarW_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u0 := u0) (u1 := u1) hscale
  have hD := continuous_scalarD_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u0 := u0) (u1 := u1) hscale
  convert! (hW.const_mul (mu / (2 * Real.pi))).sub
    (hD.const_mul sig) using 1

theorem continuous_scalarDdot_center {mu sig : ℝ} {n : ℕ} {t u0 u1 : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    Continuous (fun p : ℝ ↦
      deriv (fun q : ℝ ↦ scalarD mu sig n q p u0 u1) t) := by
  have hscale : mu * t ^ n ≠ 0 :=
    mul_ne_zero hmu (pow_ne_zero n ht)
  have hD := continuous_scalarD_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u0 := u0) (u1 := u1) hscale
  have hG0 := continuous_scalarG_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u0) hscale
  have hG1 := continuous_scalarG_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u1) hscale
  have hH0 := continuous_scalarH_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u0)
  have hH1 := continuous_scalarH_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u1)
  have hZ0 := continuous_scalarZ_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u0)
  have hZ1 := continuous_scalarZ_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u1)
  let f : ℝ → ℝ := fun p ↦
    -(n : ℝ) / t *
      (2 * scalarD mu sig n t p u0 u1 +
        (scalarZ mu sig n t p u0 + sig / mu) * scalarH mu sig n t p u0 *
          scalarG mu sig n t p u1 +
        (scalarZ mu sig n t p u1 + sig / mu) * scalarG mu sig n t p u0 *
          scalarH mu sig n t p u1)
  have hf : Continuous f := by
    dsimp [f]
    have hterm0 : Continuous (fun p : ℝ ↦ 2 * scalarD mu sig n t p u0 u1) :=
      continuous_const.mul hD
    have hterm1 : Continuous (fun p : ℝ ↦
        (scalarZ mu sig n t p u0 + sig / mu) * scalarH mu sig n t p u0 *
          scalarG mu sig n t p u1) :=
      ((hZ0.add continuous_const).mul hH0).mul hG1
    have hterm2 : Continuous (fun p : ℝ ↦
        (scalarZ mu sig n t p u1 + sig / mu) * scalarG mu sig n t p u0 *
          scalarH mu sig n t p u1) :=
      ((hZ1.add continuous_const).mul hG0).mul hH1
    have hconst : Continuous (fun _ : ℝ ↦ -(n : ℝ) / t) := continuous_const
    convert! hconst.mul (hterm0.add (hterm1.add hterm2)) using 1
    funext p
    simp only [Pi.mul_apply, Pi.add_apply]
    ring
  have heq : (fun p : ℝ ↦
      deriv (fun q : ℝ ↦ scalarD mu sig n q p u0 u1) t) = f := by
    funext p
    exact (hasDerivAt_scalarD_scale
      (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u0 := u0) (u1 := u1)
        hmu ht).deriv
  rw [heq]
  exact hf

theorem continuous_scalarEdot_center {mu sig : ℝ} {n : ℕ} {t u0 u1 : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    Continuous (fun p : ℝ ↦
      deriv (fun q : ℝ ↦ scalarE mu sig n t q u0 u1) p) := by
  have hscale : mu * t ^ n ≠ 0 :=
    mul_ne_zero hmu (pow_ne_zero n ht)
  have hD := continuous_scalarD_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u0 := u0) (u1 := u1) hscale
  have hG0 := continuous_scalarG_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u0) hscale
  have hG1 := continuous_scalarG_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u1) hscale
  have hH0 := continuous_scalarH_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u0)
  have hH1 := continuous_scalarH_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u1)
  have hZ0 := continuous_scalarZ_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u0)
  have hZ1 := continuous_scalarZ_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u1)
  have hP := continuous_scalarP_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u0 := u0) (u1 := u1)
  have hW := continuous_scalarW_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u0 := u0) (u1 := u1) hscale
  let f : ℝ → ℝ := fun p ↦
    mu / (2 * Real.pi) * (mu * t ^ n)⁻¹ *
      (4 * Real.pi * scalarD mu sig n t p u0 u1 +
        2 * Real.pi * scalarZ mu sig n t p u0 * scalarH mu sig n t p u0 *
          scalarG mu sig n t p u1 +
        2 * Real.pi * scalarZ mu sig n t p u1 * scalarG mu sig n t p u0 *
          scalarH mu sig n t p u1 -
        2 * scalarP mu sig n t p u0 u1) +
      sig * (mu * t ^ n)⁻¹ * scalarW mu sig n t p u0 u1
  have hf : Continuous f := by
    dsimp [f]
    have htermD : Continuous (fun p : ℝ ↦
        4 * Real.pi * scalarD mu sig n t p u0 u1) :=
      hD.const_mul (4 * Real.pi)
    have htermZ0 : Continuous (fun p : ℝ ↦
        2 * Real.pi * scalarZ mu sig n t p u0 * scalarH mu sig n t p u0 *
          scalarG mu sig n t p u1) :=
      ((continuous_const.mul hZ0).mul hH0).mul hG1
    have htermZ1 : Continuous (fun p : ℝ ↦
        2 * Real.pi * scalarZ mu sig n t p u1 * scalarG mu sig n t p u0 *
          scalarH mu sig n t p u1) :=
      ((continuous_const.mul hZ1).mul hG0).mul hH1
    have htermP : Continuous (fun p : ℝ ↦
        2 * scalarP mu sig n t p u0 u1) :=
      hP.const_mul 2
    have hins : Continuous (fun p : ℝ ↦
        4 * Real.pi * scalarD mu sig n t p u0 u1 +
          2 * Real.pi * scalarZ mu sig n t p u0 * scalarH mu sig n t p u0 *
            scalarG mu sig n t p u1 +
          2 * Real.pi * scalarZ mu sig n t p u1 * scalarG mu sig n t p u0 *
            scalarH mu sig n t p u1 -
          2 * scalarP mu sig n t p u0 u1) := by
      convert! (htermD.add (htermZ0.add htermZ1)).sub htermP using 1
      funext p
      simp only [Pi.add_apply, Pi.sub_apply]
      ring
    have hleft : Continuous (fun p : ℝ ↦
        mu / (2 * Real.pi) * (mu * t ^ n)⁻¹ *
          (4 * Real.pi * scalarD mu sig n t p u0 u1 +
            2 * Real.pi * scalarZ mu sig n t p u0 * scalarH mu sig n t p u0 *
              scalarG mu sig n t p u1 +
            2 * Real.pi * scalarZ mu sig n t p u1 * scalarG mu sig n t p u0 *
              scalarH mu sig n t p u1 -
            2 * scalarP mu sig n t p u0 u1)) :=
      hins.const_mul (mu / (2 * Real.pi) * (mu * t ^ n)⁻¹)
    have hright : Continuous (fun p : ℝ ↦
        sig * (mu * t ^ n)⁻¹ * scalarW mu sig n t p u0 u1) :=
      hW.const_mul (sig * (mu * t ^ n)⁻¹)
    convert! hleft.add hright using 1
  have heq : (fun p : ℝ ↦
      deriv (fun q : ℝ ↦ scalarE mu sig n t q u0 u1) p) = f := by
    funext p
    exact (hasDerivAt_scalarE_center
      (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u0 := u0) (u1 := u1)
        hscale).deriv
  rw [heq]
  exact hf

theorem scalarE_differentiableAt_center {mu sig : ℝ} {n : ℕ} {t p u0 u1 : ℝ}
    (hscale : mu * t ^ n ≠ 0) :
    DifferentiableAt ℝ (fun q : ℝ ↦ scalarE mu sig n t q u0 u1) p :=
  (hasDerivAt_scalarE_center
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u0 := u0) (u1 := u1)
      hscale).differentiableAt

/-- The source one-dimensional telescope with all compact-interval
regularity discharged for nonzero scale and width. -/
theorem scalar_oneDim_telescoping_of_ne_zero
    {mu sig t a b u0 u1 : ℝ} {n : ℕ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    ∫ p in a..b, -t * deriv (fun q : ℝ => scalarD mu sig n q p u0 u1) t =
      (n : ℝ) / Real.pi *
          (∫ p in a..b, scalarP mu sig n t p u0 u1) +
        (n : ℝ) * t ^ n *
          (scalarE mu sig n t b u0 u1 - scalarE mu sig n t a u0 u1) := by
  have hscale : mu * t ^ n ≠ 0 :=
    mul_ne_zero hmu (pow_ne_zero n ht)
  apply scalar_oneDim_telescoping hmu ht
  · exact (continuous_scalarDdot_center
      (mu := mu) (sig := sig) (n := n) (t := t) (u0 := u0) (u1 := u1) hmu ht).intervalIntegrable a b
  · exact (continuous_scalarP_center
      (mu := mu) (sig := sig) (n := n) (t := t) (u0 := u0) (u1 := u1)).intervalIntegrable a b
  · intro p hp
    exact scalarE_differentiableAt_center
      (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u0 := u0) (u1 := u1)
        hscale
  · exact (continuous_scalarEdot_center
      (mu := mu) (sig := sig) (n := n) (t := t) (u0 := u0) (u1 := u1) hmu ht).continuousOn

/-- A one-coordinate comparison of bracket kernels.  It is the elementary
scale-and-center estimate behind the local-size comparison: `s` is no larger
than `L`, is at least `L / b`, and the two centers are within `L / 2`. -/
theorem bracketKernelAt_le_of_scale_center
    {s L b p c y : ℝ} (hs : 0 < s) (hL : 0 < L)
    (hscaleLower : L ≤ b * s) (hscaleUpper : s ≤ L)
    (hcenter : |p - c| ≤ L / 2) :
    bracketKernelAt s p y ≤
      b * (3 / 2 : ℝ) ^ 10 * bracketKernelAt L c y := by
  let A : ℝ := 1 + |(y - p) / s|
  let B : ℝ := 1 + |(y - c) / L|
  let C : ℝ := 3 / 2
  have hApos : 0 < A := by
    dsimp [A]
    positivity
  have hBpos : 0 < B := by
    dsimp [B]
    positivity
  have hCpos : 0 < C := by
    dsimp [C]
    norm_num
  have hbpos : 0 < b := by
    nlinarith [hscaleLower]
  have hdist : |y - c| ≤ |y - p| + |p - c| := by
    calc
      |y - c| = |(y - p) + (p - c)| := by congr 1 <;> ring
      _ ≤ |y - p| + |p - c| := abs_add_le _ _
  have hpc : |p - c| / L ≤ 1 / 2 := by
    apply (div_le_iff₀ hL).mpr
    nlinarith [hcenter]
  have hratio : |y - p| / L ≤ |y - p| / s :=
    div_le_div_of_nonneg_left (abs_nonneg _) hs hscaleUpper
  have hdistdiv : |y - c| / L ≤ |y - p| / s + 1 / 2 := by
    calc
      |y - c| / L ≤ (|y - p| + |p - c|) / L :=
        div_le_div_of_nonneg_right hdist hL.le
      _ = |y - p| / L + |p - c| / L := by ring
      _ ≤ |y - p| / s + 1 / 2 := by gcongr
  have hBA : B ≤ C * A := by
    have habsdiv : |(y - p) / s| = |y - p| / s := by
      rw [abs_div, abs_of_pos hs]
    have habsdiv' : |(y - c) / L| = |y - c| / L := by
      rw [abs_div, abs_of_pos hL]
    have hquotient_nonneg : 0 ≤ |y - p| / s :=
      div_nonneg (abs_nonneg _) hs.le
    dsimp [A, B, C]
    rw [habsdiv, habsdiv']
    nlinarith [hdistdiv, hquotient_nonneg]
  have hBApow : B ^ 10 ≤ C ^ 10 * A ^ 10 := by
    calc
      B ^ 10 ≤ (C * A) ^ 10 := pow_le_pow_left₀ hBpos.le hBA 10
      _ = C ^ 10 * A ^ 10 := by rw [mul_pow]
  have hA10pos : 0 < A ^ 10 := pow_pos hApos _
  have hB10pos : 0 < B ^ 10 := pow_pos hBpos _
  have hinv : (A ^ 10)⁻¹ ≤ C ^ 10 * (B ^ 10)⁻¹ := by
    rw [← one_div, ← div_eq_mul_inv]
    exact (div_le_div_iff₀ hA10pos hB10pos).mpr (by simpa using hBApow)
  have hscaleInv : s⁻¹ ≤ b * L⁻¹ := by
    rw [← one_div, ← div_eq_mul_inv]
    exact (div_le_div_iff₀ hs hL).mpr (by simpa using hscaleLower)
  have hmain : s⁻¹ * (A ^ 10)⁻¹ ≤
      (b * L⁻¹) * (C ^ 10 * (B ^ 10)⁻¹) := by
    exact mul_le_mul hscaleInv hinv (by positivity) (by positivity)
  simpa only [bracketKernelAt, kernelAt, kernelDilate, smul_eq_mul,
    bracketKernel_eq_inv_pow, A, B, C] using
    (hmain.trans_eq (by ring))

/-- Scale-uniform bracket domination for the Gaussian. -/
theorem gaussianAt_scale_bracket_domination :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (s v : ℝ), 1 ≤ s →
      |gaussianAt s 0 v| ≤ C * s ^ 9 * bracketKernel v := by
  apply kernelAt_scale_bracket_of_polynomial_decay gaussian
  rcases gaussian_polynomial_decay 10 with ⟨C, hC, h⟩
  refine ⟨C, hC, fun x ↦ ?_⟩
  simpa [abs_of_nonneg (gaussian_nonneg x)] using h x

/-- Scale-uniform bracket domination for the Gaussian derivative. -/
theorem gaussianDerivAt_scale_bracket_domination :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (s v : ℝ), 1 ≤ s →
      |gaussianDerivAt s 0 v| ≤ C * s ^ 9 * bracketKernel v :=
  kernelAt_scale_bracket_of_polynomial_decay gaussianDeriv (gaussianDeriv_polynomial_decay 10)

/-- The first pointwise estimate in `lem:domination`. -/
theorem gaussian_pair_scale_bracket_domination :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (s v : ℝ), 1 ≤ s →
      |gaussianAt s 0 v| + |gaussianDerivAt s 0 v| ≤
        C * s ^ 9 * bracketKernel v := by
  rcases gaussianAt_scale_bracket_domination with ⟨Cg, hCg, hg⟩
  rcases gaussianDerivAt_scale_bracket_domination with ⟨Ch, hCh, hh⟩
  refine ⟨Cg + Ch, add_nonneg hCg hCh, ?_⟩
  intro s v hs
  calc
    |gaussianAt s 0 v| + |gaussianDerivAt s 0 v| ≤
        Cg * s ^ 9 * bracketKernel v + Ch * s ^ 9 * bracketKernel v :=
      add_le_add (hg s v hs) (hh s v hs)
    _ = (Cg + Ch) * s ^ 9 * bracketKernel v := by ring

/-- Unit-scale translated Gaussian domination with the source weight `R(r)^10`. -/
theorem gaussianAt_translate_bracket_domination :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (r v : ℝ),
      |gaussianAt 1 r v| ≤ C * translationWeight r ^ 10 * bracketKernel v := by
  apply kernelAt_translate_bracket_of_polynomial_decay gaussian
  rcases gaussian_polynomial_decay 10 with ⟨C, hC, h⟩
  refine ⟨C, hC, fun x ↦ ?_⟩
  simpa [abs_of_nonneg (gaussian_nonneg x)] using h x

/-- Unit-scale translated derivative-Gaussian domination with `R(r)^10`. -/
theorem gaussianDerivAt_translate_bracket_domination :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (r v : ℝ),
      |gaussianDerivAt 1 r v| ≤ C * translationWeight r ^ 10 * bracketKernel v :=
  kernelAt_translate_bracket_of_polynomial_decay gaussianDeriv (gaussianDeriv_polynomial_decay 10)

/-- The second pointwise estimate in `lem:domination`. -/
theorem gaussian_pair_translate_bracket_domination :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (r v : ℝ),
      |gaussianAt 1 r v| + |gaussianDerivAt 1 r v| ≤
        C * translationWeight r ^ 10 * bracketKernel v := by
  rcases gaussianAt_translate_bracket_domination with ⟨Cg, hCg, hg⟩
  rcases gaussianDerivAt_translate_bracket_domination with ⟨Ch, hCh, hh⟩
  refine ⟨Cg + Ch, add_nonneg hCg hCh, ?_⟩
  intro r v
  calc
    |gaussianAt 1 r v| + |gaussianDerivAt 1 r v| ≤
        Cg * translationWeight r ^ 10 * bracketKernel v +
          Ch * translationWeight r ^ 10 * bracketKernel v :=
      add_le_add (hg r v) (hh r v)
    _ = (Cg + Ch) * translationWeight r ^ 10 * bracketKernel v := by ring

/-! ### The standard frequency bump

The literal source definition constructs the cutoff through an infinite
convolution product.  The analytic work below and later in the proof uses
only its proved properties.  We therefore package a direct smooth compactly
supported realization with exactly those support and plateau radii; the
source-audit entry records this implementation-level replacement.
-/

/-- A real, even, smooth cutoff with plateau `[-1/2, 1/2]` and support in
`[-1, 1]`.  It realizes the frequency-side bump `b` of `def:bumps`. -/
noncomputable def standardFrequencyBump : ℝ → ℝ :=
  (⟨(1 : ℝ) / 2, 1, by norm_num, by norm_num⟩ : ContDiffBump (0 : ℝ))

private theorem standardFrequencyBump_apply (x : ℝ) :
    standardFrequencyBump x =
      (let b : ContDiffBump (0 : ℝ) :=
        ⟨(1 : ℝ) / 2, 1, by norm_num, by norm_num⟩
       b x) := by
  rfl

theorem standardFrequencyBump_nonneg (x : ℝ) : 0 ≤ standardFrequencyBump x := by
  rw [standardFrequencyBump_apply]
  exact ContDiffBump.nonneg' _ _

theorem standardFrequencyBump_le_one (x : ℝ) : standardFrequencyBump x ≤ 1 := by
  rw [standardFrequencyBump_apply]
  exact ContDiffBump.le_one _

theorem standardFrequencyBump_even (x : ℝ) :
    standardFrequencyBump (-x) = standardFrequencyBump x := by
  rw [standardFrequencyBump_apply, standardFrequencyBump_apply]
  exact ContDiffBump.neg _ _

theorem standardFrequencyBump_eq_one_of_abs_le_half {x : ℝ} (hx : |x| ≤ 1 / 2) :
    standardFrequencyBump x = 1 := by
  rw [standardFrequencyBump_apply]
  let b : ContDiffBump (0 : ℝ) :=
    ⟨(1 : ℝ) / 2, 1, by norm_num, by norm_num⟩
  apply b.one_of_mem_closedBall
  rw [Metric.mem_closedBall, Real.dist_eq]
  simpa [b] using hx

theorem standardFrequencyBump_eq_zero_of_one_le_abs {x : ℝ} (hx : 1 ≤ |x|) :
    standardFrequencyBump x = 0 := by
  rw [standardFrequencyBump_apply]
  let b : ContDiffBump (0 : ℝ) :=
    ⟨(1 : ℝ) / 2, 1, by norm_num, by norm_num⟩
  apply b.zero_of_le_dist
  rw [Real.dist_eq]
  simpa [b] using hx

theorem standardFrequencyBump_contDiff :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) standardFrequencyBump := by
  rw [show standardFrequencyBump =
      (⟨(1 : ℝ) / 2, 1, by norm_num, by norm_num⟩ : ContDiffBump (0 : ℝ)) by rfl]
  exact (⟨(1 : ℝ) / 2, 1, by norm_num, by norm_num⟩ : ContDiffBump (0 : ℝ)).contDiff

theorem standardFrequencyBump_hasCompactSupport :
    HasCompactSupport standardFrequencyBump := by
  rw [show standardFrequencyBump =
      (⟨(1 : ℝ) / 2, 1, by norm_num, by norm_num⟩ : ContDiffBump (0 : ℝ)) by rfl]
  exact ContDiffBump.hasCompactSupport _

/-- The complex Schwartz realization of the real frequency bump. -/
noncomputable def standardFrequencyBumpSchwartz : SchwartzMap ℝ ℂ := by
  let g : ℝ → ℂ := Complex.ofRealCLM ∘ standardFrequencyBump
  have hcompact : HasCompactSupport g :=
    standardFrequencyBump_hasCompactSupport.comp_left (g := Complex.ofRealCLM) rfl
  have hsmooth : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) g :=
    Complex.ofRealCLM.contDiff.comp standardFrequencyBump_contDiff
  exact hcompact.toSchwartzMap hsmooth

@[simp]
theorem standardFrequencyBumpSchwartz_apply (x : ℝ) :
    standardFrequencyBumpSchwartz x = standardFrequencyBump x := by
  rfl

/-- The spatial-side standard bump `\(\mathsf B=\mathcal F^{-1}b\)`. -/
noncomputable def standardBump : SchwartzMap ℝ ℂ :=
  𝓕⁻ standardFrequencyBumpSchwartz

@[simp]
theorem schwartzFourier_standardBump :
    𝓕 standardBump = standardFrequencyBumpSchwartz := by
  simp [standardBump]

theorem standardBump_decay (r : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      ‖standardBump x‖ ≤ C / (1 + |x|) ^ r :=
  schwartz_oneDim_decay standardBump r

/-- The two annular frequency cutoffs `\(\Psi\)` from `def:bumps`. -/
noncomputable def conePsi (η : ℝ) : ℝ :=
  standardFrequencyBump (4 * (η - 3 / 2)) +
    standardFrequencyBump (4 * (η + 3 / 2))

theorem conePsi_nonneg (η : ℝ) : 0 ≤ conePsi η := by
  exact add_nonneg (standardFrequencyBump_nonneg _) (standardFrequencyBump_nonneg _)

theorem conePsi_even (η : ℝ) : conePsi (-η) = conePsi η := by
  unfold conePsi
  rw [show 4 * (-η - 3 / 2) = -(4 * (η + 3 / 2)) by ring,
    show 4 * (-η + 3 / 2) = -(4 * (η - 3 / 2)) by ring,
    standardFrequencyBump_even, standardFrequencyBump_even]
  ring

theorem conePsi_eq_one_on_core {η : ℝ} (hη : |η - 3 / 2| ≤ 1 / 8) :
    conePsi η = 1 := by
  unfold conePsi
  have hfirst : |4 * (η - 3 / 2)| ≤ 1 / 2 := by
    rw [abs_mul]
    nlinarith [abs_nonneg (η - 3 / 2)]
  have hsecond : 1 ≤ |4 * (η + 3 / 2)| := by
    have hlow : 11 / 8 ≤ η := by
      rw [abs_le] at hη
      linarith
    rw [abs_of_nonneg (by linarith)]
    linarith
  rw [standardFrequencyBump_eq_one_of_abs_le_half hfirst,
    standardFrequencyBump_eq_zero_of_one_le_abs hsecond]
  norm_num

theorem conePsi_eq_zero_of_abs_le_one {η : ℝ} (hη : |η| ≤ 1) : conePsi η = 0 := by
  unfold conePsi
  rw [abs_le] at hη
  have hpos : 1 ≤ |4 * (η - 3 / 2)| := by
    rw [abs_of_nonpos (by linarith)]
    linarith
  have hneg : 1 ≤ |4 * (η + 3 / 2)| := by
    rw [abs_of_nonneg (by linarith)]
    linarith
  rw [standardFrequencyBump_eq_zero_of_one_le_abs hpos,
    standardFrequencyBump_eq_zero_of_one_le_abs hneg]
  norm_num

theorem conePsi_eq_zero_of_two_le_abs {η : ℝ} (hη : 2 ≤ |η|) : conePsi η = 0 := by
  unfold conePsi
  rcases le_total 0 η with hpos | hneg
  · have hpos' : 2 ≤ η := by
      rw [abs_of_nonneg hpos] at hη
      exact hη
    have hfirst : 1 ≤ |4 * (η - 3 / 2)| := by
      rw [abs_of_nonneg (by linarith)]
      linarith
    have hsecond : 1 ≤ |4 * (η + 3 / 2)| := by
      rw [abs_of_nonneg (by linarith)]
      linarith
    rw [standardFrequencyBump_eq_zero_of_one_le_abs hfirst,
      standardFrequencyBump_eq_zero_of_one_le_abs hsecond]
    norm_num
  · have hneg' : η ≤ -2 := by
      rw [abs_of_nonpos hneg] at hη
      linarith
    have hfirst : 1 ≤ |4 * (η - 3 / 2)| := by
      rw [abs_of_nonpos (by linarith)]
      linarith
    have hsecond : 1 ≤ |4 * (η + 3 / 2)| := by
      rw [abs_of_nonpos (by linarith)]
      linarith
    rw [standardFrequencyBump_eq_zero_of_one_le_abs hfirst,
      standardFrequencyBump_eq_zero_of_one_le_abs hsecond]
    norm_num

/-- A globally smooth version of
`\(\Psi(x)\mathsf h(x)^2/x\)`, with its removable zero filled in. -/
noncomputable def coneWeight (x : ℝ) : ℝ :=
  4 * Real.pi ^ 2 * x * conePsi x * gaussian x ^ 2

theorem coneWeight_eq_source_integrand {x : ℝ} (hx : x ≠ 0) :
    coneWeight x = conePsi x * gaussianDeriv x ^ 2 / x := by
  unfold coneWeight gaussianDeriv
  field_simp
  ring

theorem coneWeight_nonneg_of_nonneg {x : ℝ} (hx : 0 ≤ x) : 0 ≤ coneWeight x := by
  unfold coneWeight
  apply mul_nonneg
  · apply mul_nonneg
    · apply mul_nonneg
      · positivity
      · exact hx
    · exact conePsi_nonneg x
  · exact sq_nonneg _

theorem coneWeight_pos_on_core {x : ℝ}
    (hx : x ∈ Set.Ioo (11 / 8 : ℝ) (13 / 8 : ℝ)) : 0 < coneWeight x := by
  unfold coneWeight
  have hcore : |x - 3 / 2| ≤ 1 / 8 := by
    rw [abs_le]
    constructor <;> linarith [hx.1, hx.2]
  rw [conePsi_eq_one_on_core hcore]
  have hxpos : 0 < x := by linarith [hx.1]
  have hpi : 0 < 4 * Real.pi ^ 2 := by positivity
  exact mul_pos (mul_pos (mul_pos hpi hxpos) zero_lt_one)
    (sq_pos_of_pos (gaussian_pos x))

theorem gaussian_contDiff :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) gaussian := by
  have hsq : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun x : ℝ ↦ x ^ 2) :=
    contDiff_id.pow 2
  have hin : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞)
      (fun x : ℝ ↦ -Real.pi * x ^ 2) := by
    simpa using
      (contDiff_const.mul hsq : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞)
        (fun x : ℝ ↦ (-Real.pi) * x ^ 2))
  change ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞)
    (fun x : ℝ ↦ Real.exp (-Real.pi * x ^ 2))
  exact Real.contDiff_exp.comp hin

theorem conePsi_contDiff :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) conePsi := by
  unfold conePsi
  apply ContDiff.add
  · exact standardFrequencyBump_contDiff.comp
      (contDiff_const.mul (contDiff_id.sub contDiff_const))
  · exact standardFrequencyBump_contDiff.comp
      (contDiff_const.mul (contDiff_id.add contDiff_const))

theorem coneWeight_contDiff :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) coneWeight := by
  unfold coneWeight
  exact ((((contDiff_const.mul contDiff_const).mul contDiff_id).mul conePsi_contDiff).mul
    (gaussian_contDiff.pow 2))

theorem coneWeight_neg (x : ℝ) : coneWeight (-x) = -coneWeight x := by
  simp [coneWeight, conePsi_even, gaussian_even]

theorem coneWeight_eq_zero_of_abs_le_one {x : ℝ} (hx : |x| ≤ 1) : coneWeight x = 0 := by
  unfold coneWeight
  rw [conePsi_eq_zero_of_abs_le_one hx]
  ring

theorem coneWeight_eq_zero_of_two_le_abs {x : ℝ} (hx : 2 ≤ |x|) : coneWeight x = 0 := by
  unfold coneWeight
  rw [conePsi_eq_zero_of_two_le_abs hx]
  ring

/-- The primitive used to express the source tail cutoff without placing an
absolute value inside a smooth definition. -/
noncomputable def conePrimitive (x : ℝ) : ℝ := ∫ t in (0 : ℝ)..x, coneWeight t

/-- The positive Calderón normalization `\(c_\Psi\)`. -/
noncomputable def cPsi : ℝ := ∫ t in (0 : ℝ)..2, coneWeight t

/-- The source cutoff `\(\Phi\)`, represented through its smooth primitive. -/
noncomputable def conePhi (x : ℝ) : ℝ := cPsi - conePrimitive x

theorem cPsi_pos : 0 < cPsi := by
  unfold cPsi
  have hsmall : 0 < ∫ x in (11 / 8 : ℝ)..(13 / 8 : ℝ), coneWeight x := by
    apply intervalIntegral.intervalIntegral_pos_of_pos_on
      (coneWeight_contDiff.continuous.intervalIntegrable _ _) ?_ (by norm_num)
    intro x hx
    exact coneWeight_pos_on_core hx
  have hmono : (∫ x in (11 / 8 : ℝ)..(13 / 8 : ℝ), coneWeight x) ≤
      ∫ x in (0 : ℝ)..2, coneWeight x := by
    apply intervalIntegral.integral_mono_interval (c := (0 : ℝ)) (d := 2)
      (by norm_num) (by norm_num) (by norm_num) ?_
      (coneWeight_contDiff.continuous.intervalIntegrable _ _)
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with x hx
    exact coneWeight_nonneg_of_nonneg hx.1.le
  exact lt_of_lt_of_le hsmall hmono

/-- A smooth integrand has a smooth variable-endpoint interval primitive. -/
theorem contDiff_intervalPrimitive (f : ℝ → ℝ)
    (hf : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) f) (a : ℝ) :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun x ↦ ∫ t in a..x, f t) := by
  have hcont : Continuous f := hf.continuous
  have hdifferentiable : Differentiable ℝ (fun x ↦ ∫ t in a..x, f t) := by
    intro x
    exact (intervalIntegral.integral_hasDerivAt_right
      (hcont.intervalIntegrable _ _)
      hcont.aestronglyMeasurable.stronglyMeasurableAtFilter
      hcont.continuousAt).differentiableAt
  have hderiv : deriv (fun x ↦ ∫ t in a..x, f t) = f := by
    funext x
    exact intervalIntegral.deriv_integral_right
      (hcont.intervalIntegrable _ _)
      hcont.aestronglyMeasurable.stronglyMeasurableAtFilter hcont.continuousAt
  rw [contDiff_iff_forall_nat_le]
  intro n _
  induction n with
  | zero => exact contDiff_zero.mpr hdifferentiable.continuous
  | succ n ih =>
      change ContDiff ℝ ((n : ℕ∞) + 1) (fun x ↦ ∫ t in a..x, f t)
      rw [contDiff_succ_iff_deriv]
      refine ⟨hdifferentiable, ?_, ?_⟩
      · simp
      · rw [hderiv]
        apply hf.of_le
        exact_mod_cast (le_top : n ≤ (⊤ : ℕ∞))

theorem conePrimitive_contDiff :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) conePrimitive := by
  exact contDiff_intervalPrimitive coneWeight coneWeight_contDiff 0

theorem conePhi_contDiff :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) conePhi := by
  unfold conePhi
  exact contDiff_const.sub conePrimitive_contDiff

theorem conePrimitive_even (x : ℝ) : conePrimitive (-x) = conePrimitive x := by
  have hcomp : (∫ t in (0 : ℝ)..x, coneWeight (-t)) = ∫ t in -x..0, coneWeight t := by
    simp [intervalIntegral.integral_comp_neg]
  have hrel : (∫ t in -x..0, coneWeight t) = -(∫ t in (0 : ℝ)..x, coneWeight t) := by
    rw [← hcomp]
    rw [show (fun t : ℝ ↦ coneWeight (-t)) = fun t ↦ -coneWeight t by
      funext t
      exact coneWeight_neg t]
    rw [intervalIntegral.integral_neg]
  unfold conePrimitive
  rw [intervalIntegral.integral_symm (-x) 0, hrel]
  ring

theorem conePhi_even (x : ℝ) : conePhi (-x) = conePhi x := by
  unfold conePhi
  rw [conePrimitive_even x]

theorem conePrimitive_eq_zero_of_abs_le_one {x : ℝ} (hx : |x| ≤ 1) :
    conePrimitive x = 0 := by
  unfold conePrimitive
  rcases le_total 0 x with hx0 | hx0
  · rw [intervalIntegral.integral_of_le hx0]
    apply integral_eq_zero_of_ae
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with y hy
    apply coneWeight_eq_zero_of_abs_le_one
    rw [abs_of_nonneg (by linarith [hy.1])]
    exact le_trans hy.2 (by nlinarith [le_abs_self x])
  · rw [intervalIntegral.integral_symm x 0]
    have hz : (∫ t in x..0, coneWeight t) = 0 := by
      rw [intervalIntegral.integral_of_le hx0]
      apply integral_eq_zero_of_ae
      filter_upwards [ae_restrict_mem measurableSet_Ioc] with y hy
      apply coneWeight_eq_zero_of_abs_le_one
      rw [abs_of_nonpos (by linarith [hy.2])]
      have hxlo : -1 ≤ x := by nlinarith [neg_le_abs x]
      nlinarith [hy.1]
    rw [hz]
    simp

theorem conePhi_eq_cPsi_of_abs_le_one {x : ℝ} (hx : |x| ≤ 1) :
    conePhi x = cPsi := by
  unfold conePhi
  rw [conePrimitive_eq_zero_of_abs_le_one hx]
  ring

theorem conePrimitive_eq_cPsi_of_two_le {x : ℝ} (hx : 2 ≤ x) :
    conePrimitive x = cPsi := by
  have htail : (∫ t in (2 : ℝ)..x, coneWeight t) = 0 := by
    rw [intervalIntegral.integral_of_le hx]
    apply integral_eq_zero_of_ae
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with y hy
    apply coneWeight_eq_zero_of_two_le_abs
    rw [abs_of_nonneg (by linarith [hy.1])]
    linarith [hy.1]
  unfold conePrimitive cPsi
  rw [← intervalIntegral.integral_add_adjacent_intervals
    (coneWeight_contDiff.continuous.intervalIntegrable (0 : ℝ) 2)
    (coneWeight_contDiff.continuous.intervalIntegrable 2 x), htail, add_zero]

theorem conePhi_eq_zero_of_two_le_abs {x : ℝ} (hx : 2 ≤ |x|) : conePhi x = 0 := by
  have heq : conePrimitive x = cPsi := by
    rcases le_total 0 x with hx0 | hx0
    · rw [abs_of_nonneg hx0] at hx
      exact conePrimitive_eq_cPsi_of_two_le hx
    · have hneg : 2 ≤ -x := by rwa [abs_of_nonpos hx0] at hx
      rw [← conePrimitive_even x]
      exact conePrimitive_eq_cPsi_of_two_le hneg
  unfold conePhi
  rw [heq]
  ring

theorem conePhi_eq_tail (x : ℝ) : conePhi x = ∫ t in |x|..2, coneWeight t := by
  have hpos (u : ℝ) (hu : 0 ≤ u) : conePhi u = ∫ t in u..2, coneWeight t := by
    unfold conePhi cPsi conePrimitive
    have hadd : (∫ t in (0 : ℝ)..u, coneWeight t) + ∫ t in u..2, coneWeight t =
        ∫ t in (0 : ℝ)..2, coneWeight t :=
      intervalIntegral.integral_add_adjacent_intervals
        (coneWeight_contDiff.continuous.intervalIntegrable (0 : ℝ) u)
        (coneWeight_contDiff.continuous.intervalIntegrable u 2)
    linarith
  rcases le_total 0 x with hx | hx
  · rw [abs_of_nonneg hx]
    exact hpos x hx
  · rw [abs_of_nonpos hx]
    have heven : conePhi x = conePhi (-x) := by
      unfold conePhi
      rw [← conePrimitive_even x]
    rw [heven]
    exact hpos (-x) (by linarith)

theorem conePsi_hasCompactSupport : HasCompactSupport conePsi := by
  apply HasCompactSupport.intro (isCompact_closedBall (0 : ℝ) 2)
  intro x hx
  have hx' : 2 < |x| := by
    simpa only [Metric.mem_closedBall, Real.dist_eq, sub_zero, not_le] using hx
  exact conePsi_eq_zero_of_two_le_abs hx'.le

theorem conePhi_hasCompactSupport : HasCompactSupport conePhi := by
  apply HasCompactSupport.intro (isCompact_closedBall (0 : ℝ) 2)
  intro x hx
  have hx' : 2 < |x| := by
    simpa only [Metric.mem_closedBall, Real.dist_eq, sub_zero, not_le] using hx
  exact conePhi_eq_zero_of_two_le_abs hx'.le

/-- Complex Schwartz realization of the real annular cutoff `\(\Psi\)`. -/
noncomputable def conePsiSchwartz : SchwartzMap ℝ ℂ := by
  let g : ℝ → ℂ := Complex.ofRealCLM ∘ conePsi
  have hcompact : HasCompactSupport g :=
    conePsi_hasCompactSupport.comp_left (g := Complex.ofRealCLM) rfl
  have hsmooth : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) g :=
    Complex.ofRealCLM.contDiff.comp conePsi_contDiff
  exact hcompact.toSchwartzMap hsmooth

@[simp]
theorem conePsiSchwartz_apply (x : ℝ) : conePsiSchwartz x = conePsi x := by
  rfl

/-- Complex Schwartz realization of the real low-frequency cutoff `\(\Phi\)`. -/
noncomputable def conePhiSchwartz : SchwartzMap ℝ ℂ := by
  let g : ℝ → ℂ := Complex.ofRealCLM ∘ conePhi
  have hcompact : HasCompactSupport g :=
    conePhi_hasCompactSupport.comp_left (g := Complex.ofRealCLM) rfl
  have hsmooth : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) g :=
    Complex.ofRealCLM.contDiff.comp conePhi_contDiff
  exact hcompact.toSchwartzMap hsmooth

@[simp]
theorem conePhiSchwartz_apply (x : ℝ) : conePhiSchwartz x = conePhi x := by
  rfl

/-- The spatial Schwartz kernels `\(\psi=\mathcal F^{-1}\Psi\)` and
`\(\varphi=\mathcal F^{-1}\Phi\)`. -/
noncomputable def conePsiPhysical : SchwartzMap ℝ ℂ := 𝓕⁻ conePsiSchwartz

noncomputable def conePhiPhysical : SchwartzMap ℝ ℂ := 𝓕⁻ conePhiSchwartz

@[simp]
theorem schwartzFourier_conePsiPhysical :
    𝓕 conePsiPhysical = conePsiSchwartz := by
  simp [conePsiPhysical]

@[simp]
theorem schwartzFourier_conePhiPhysical :
    𝓕 conePhiPhysical = conePhiSchwartz := by
  simp [conePhiPhysical]

/-- The spatial annular kernel is even. -/
theorem conePsiPhysical_even (x : ℝ) :
    conePsiPhysical (-x) = conePsiPhysical x := by
  unfold conePsiPhysical
  rw [SchwartzMap.fourierInv_coe]
  have h := Real.fourierInv_comp_linearIsometry
    (LinearIsometryEquiv.neg ℝ (E := ℝ)) (conePsiSchwartz : ℝ → ℂ) x
  change (𝓕⁻ ((conePsiSchwartz : ℝ → ℂ) ∘
      (LinearIsometryEquiv.neg ℝ (E := ℝ))) : ℝ → ℂ) x = _ at h
  rw [show ((conePsiSchwartz : ℝ → ℂ) ∘
      (LinearIsometryEquiv.neg ℝ (E := ℝ))) = conePsiSchwartz by
    funext t
    change conePsiSchwartz (-t) = conePsiSchwartz t
    simpa only [conePsiSchwartz_apply] using
      congrArg Complex.ofReal (conePsi_even t)] at h
  simpa using h.symm

/-- The spatial low-frequency kernel is even. -/
theorem conePhiPhysical_even (x : ℝ) :
    conePhiPhysical (-x) = conePhiPhysical x := by
  unfold conePhiPhysical
  rw [SchwartzMap.fourierInv_coe]
  have h := Real.fourierInv_comp_linearIsometry
    (LinearIsometryEquiv.neg ℝ (E := ℝ)) (conePhiSchwartz : ℝ → ℂ) x
  change (𝓕⁻ ((conePhiSchwartz : ℝ → ℂ) ∘
      (LinearIsometryEquiv.neg ℝ (E := ℝ))) : ℝ → ℂ) x = _ at h
  rw [show ((conePhiSchwartz : ℝ → ℂ) ∘
      (LinearIsometryEquiv.neg ℝ (E := ℝ))) = conePhiSchwartz by
    funext t
    change conePhiSchwartz (-t) = conePhiSchwartz t
    simpa only [conePhiSchwartz_apply] using
      congrArg Complex.ofReal (conePhi_even t)] at h
  simpa using h.symm

/-- Inverse Fourier transformation sends a real-valued frequency function to
a conjugate-symmetric spatial function. -/
lemma fourierInv_conj_eq_of_real (f : ℝ → ℂ)
    (hreal : ∀ t : ℝ, (starRingEnd ℂ) (f t) = f t) (x : ℝ) :
    (starRingEnd ℂ) (𝓕⁻ f x) = 𝓕⁻ f (-x) := by
  rw [Real.fourierInv_eq, Real.fourierInv_eq, ← integral_conj]
  apply integral_congr_ae
  filter_upwards with t
  simp only [Real.inner_apply, mul_neg]
  change (starRingEnd ℂ) ((↑(𝐞 (t * x)) : ℂ) * f t) =
    (↑(𝐞 (-(t * x))) : ℂ) * f t
  rw [map_mul, hreal]
  rw [← Circle.coe_inv_eq_conj, ← Real.fourierChar.map_neg_eq_inv]

/-- The spatial annular kernel has real values. -/
theorem conePsiPhysical_im_eq_zero (x : ℝ) : (conePsiPhysical x).im = 0 := by
  apply Complex.conj_eq_iff_im.mp
  unfold conePsiPhysical
  rw [SchwartzMap.fourierInv_coe]
  calc
    (starRingEnd ℂ) (𝓕⁻ (conePsiSchwartz : ℝ → ℂ) x) =
        𝓕⁻ (conePsiSchwartz : ℝ → ℂ) (-x) :=
      fourierInv_conj_eq_of_real _ (by
        intro t
        rw [conePsiSchwartz_apply]
        simp) x
    _ = 𝓕⁻ (conePsiSchwartz : ℝ → ℂ) x := by
      have h := Real.fourierInv_comp_linearIsometry
        (LinearIsometryEquiv.neg ℝ (E := ℝ)) (conePsiSchwartz : ℝ → ℂ) x
      change (𝓕⁻ ((conePsiSchwartz : ℝ → ℂ) ∘
        (LinearIsometryEquiv.neg ℝ (E := ℝ))) : ℝ → ℂ) x = _ at h
      rw [show ((conePsiSchwartz : ℝ → ℂ) ∘
        (LinearIsometryEquiv.neg ℝ (E := ℝ))) = conePsiSchwartz by
        funext t
        change conePsiSchwartz (-t) = conePsiSchwartz t
        simpa only [conePsiSchwartz_apply] using
          congrArg Complex.ofReal (conePsi_even t)] at h
      simpa using h.symm

/-- The spatial low-frequency kernel has real values. -/
theorem conePhiPhysical_im_eq_zero (x : ℝ) : (conePhiPhysical x).im = 0 := by
  apply Complex.conj_eq_iff_im.mp
  unfold conePhiPhysical
  rw [SchwartzMap.fourierInv_coe]
  calc
    (starRingEnd ℂ) (𝓕⁻ (conePhiSchwartz : ℝ → ℂ) x) =
        𝓕⁻ (conePhiSchwartz : ℝ → ℂ) (-x) :=
      fourierInv_conj_eq_of_real _ (by
        intro t
        rw [conePhiSchwartz_apply]
        simp) x
    _ = 𝓕⁻ (conePhiSchwartz : ℝ → ℂ) x := by
      have h := Real.fourierInv_comp_linearIsometry
        (LinearIsometryEquiv.neg ℝ (E := ℝ)) (conePhiSchwartz : ℝ → ℂ) x
      change (𝓕⁻ ((conePhiSchwartz : ℝ → ℂ) ∘
        (LinearIsometryEquiv.neg ℝ (E := ℝ))) : ℝ → ℂ) x = _ at h
      rw [show ((conePhiSchwartz : ℝ → ℂ) ∘
        (LinearIsometryEquiv.neg ℝ (E := ℝ))) = conePhiSchwartz by
        funext t
        change conePhiSchwartz (-t) = conePhiSchwartz t
        simpa only [conePhiSchwartz_apply] using
          congrArg Complex.ofReal (conePhi_even t)] at h
      simpa using h.symm

/-- The real Schwartz realization of the annular spatial kernel. -/
noncomputable def conePsiPhysicalReal : SchwartzMap ℝ ℝ :=
  conePsiPhysical.postcompCLM (𝕜 := ℝ) Complex.reCLM

/-- The real Schwartz realization of the low-frequency spatial kernel. -/
noncomputable def conePhiPhysicalReal : SchwartzMap ℝ ℝ :=
  conePhiPhysical.postcompCLM (𝕜 := ℝ) Complex.reCLM

@[simp]
theorem conePsiPhysicalReal_apply (x : ℝ) :
    conePsiPhysicalReal x = (conePsiPhysical x).re := by
  rfl

@[simp]
theorem conePhiPhysicalReal_apply (x : ℝ) :
    conePhiPhysicalReal x = (conePhiPhysical x).re := by
  rfl

theorem conePsiPhysical_eq_ofReal (x : ℝ) :
    (conePsiPhysicalReal x : ℂ) = conePsiPhysical x := by
  apply Complex.ext
  · simp [conePsiPhysicalReal_apply]
  · simp [conePsiPhysical_im_eq_zero]

theorem conePhiPhysical_eq_ofReal (x : ℝ) :
    (conePhiPhysicalReal x : ℂ) = conePhiPhysical x := by
  apply Complex.ext
  · simp [conePhiPhysicalReal_apply]
  · simp [conePhiPhysical_im_eq_zero]

theorem conePsiPhysicalReal_even (x : ℝ) :
    conePsiPhysicalReal (-x) = conePsiPhysicalReal x := by
  simp only [conePsiPhysicalReal_apply]
  rw [conePsiPhysical_even]

theorem conePhiPhysicalReal_even (x : ℝ) :
    conePhiPhysicalReal (-x) = conePhiPhysicalReal x := by
  simp only [conePhiPhysicalReal_apply]
  rw [conePhiPhysical_even]

theorem conePsiPhysical_decay (r : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      ‖conePsiPhysical x‖ ≤ C / (1 + |x|) ^ r :=
  schwartz_oneDim_decay conePsiPhysical r

theorem conePhiPhysical_decay (r : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      ‖conePhiPhysical x‖ ≤ C / (1 + |x|) ^ r :=
  schwartz_oneDim_decay conePhiPhysical r

theorem conePsiPhysicalReal_decay (r : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      |conePsiPhysicalReal x| ≤ C / (1 + |x|) ^ r := by
  rcases conePsiPhysical_decay r with ⟨C, hC, h⟩
  refine ⟨C, hC, fun x ↦ ?_⟩
  rw [← Real.norm_eq_abs, ← Complex.norm_real, conePsiPhysical_eq_ofReal]
  exact h x

theorem conePhiPhysicalReal_decay (r : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      |conePhiPhysicalReal x| ≤ C / (1 + |x|) ^ r := by
  rcases conePhiPhysical_decay r with ⟨C, hC, h⟩
  refine ⟨C, hC, fun x ↦ ?_⟩
  rw [← Real.norm_eq_abs, ← Complex.norm_real, conePhiPhysical_eq_ofReal]
  exact h x

/-! ### Positive Gaussian superposition

The proof of the third estimate in `lem:domination` only uses a fixed
equivalent norm on the four scalar variables.  We use the coordinate `ℓ¹`
radius below, which makes the source's translation bookkeeping completely
explicit while retaining the same Gaussian superposition on the right.
-/

/-- The coordinate radius used to select the source scale interval. -/
def fourRadius (z : E4) : ℝ :=
  |z 0| + |z 1| + |z 2| + |z 3|

/-- The translated coordinate radius for the two low-frequency slots. -/
def fourRadiusShift (z : E4) (u : E3) : ℝ :=
  |z 0 - u 0| + |z 1| + |z 2 - u 1| + |z 3|

/-- The source translation weight `U(u)`. -/
def sourceWeight (u : E3) : ℝ := 1 + |u 0| + |u 1| + |u 2|

/-- The four input factors in the source superposition estimate. -/
noncomputable def superpositionInput (z : E4) (u : E3) : ℝ :=
  |conePhiPhysicalReal (z 0 - u 0)| * gaussian (z 1) *
    |conePhiPhysicalReal (z 2 - u 1)| * gaussian (z 3)

/-- The positive scale integrand from equation `eq:superposition`, after
collecting the four mass-normalization factors into `s^{-51}`. -/
noncomputable def superpositionIntegrand (z : E4) (s : ℝ) : ℝ :=
  gaussian (z 0 / s) * gaussian (z 1 / s) *
    gaussian (z 2 / s) * gaussian (z 3 / s) * s ^ (-51 : ℝ)

/-- The source's positive Gaussian superposition, written as a set integral. -/
noncomputable def gaussianSuperposition (z : E4) : ℝ :=
  ∫ s in Set.Ici (1 : ℝ), superpositionIntegrand z s

/-- The collected scale integrand is exactly the source expression with four
mass-normalized Gaussian dilates and the remaining factor `s^{-47}`. -/
theorem superpositionIntegrand_eq_source_product (z : E4) {s : ℝ} (hs : 0 < s) :
    superpositionIntegrand z s =
      (gaussianAt s 0 (z 0) * gaussianAt s 0 (z 1) *
        gaussianAt s 0 (z 2) * gaussianAt s 0 (z 3)) * s ^ (-47 : ℝ) := by
  have hpow : (s⁻¹) ^ 4 * s ^ (-47 : ℝ) = s ^ (-51 : ℝ) := by
    rw [show (-47 : ℝ) = -(47 : ℝ) by norm_num, Real.rpow_neg hs.le]
    rw [show (-51 : ℝ) = -(51 : ℝ) by norm_num, Real.rpow_neg hs.le]
    norm_num [Real.rpow_natCast]
    field_simp
  unfold superpositionIntegrand gaussianAt kernelAt kernelDilate
  simp only [sub_zero, smul_eq_mul]
  rw [show gaussian (z 0 / s) * gaussian (z 1 / s) * gaussian (z 2 / s) *
      gaussian (z 3 / s) * s ^ (-51 : ℝ) =
      ((s⁻¹) ^ 4 * s ^ (-47 : ℝ)) *
        (gaussian (z 0 / s) * gaussian (z 1 / s) * gaussian (z 2 / s) *
          gaussian (z 3 / s)) by
    rw [hpow]
    ring]
  ring

theorem superpositionIntegrand_nonneg {z : E4} {s : ℝ} (hs : 0 ≤ s) :
    0 ≤ superpositionIntegrand z s := by
  unfold superpositionIntegrand
  exact mul_nonneg
    (mul_nonneg
      (mul_nonneg
        (mul_nonneg (gaussian_nonneg _) (gaussian_nonneg _))
        (gaussian_nonneg _))
      (gaussian_nonneg _))
    (Real.rpow_nonneg hs _)

theorem superpositionIntegrand_continuousOn (z : E4) :
    ContinuousOn (superpositionIntegrand z) (Set.Ici (1 : ℝ)) := by
  intro s hs
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hsne : s ≠ 0 := hspos.ne'
  have hg (a : Fin 4) : ContinuousAt (fun t : ℝ ↦ gaussian (z a / t)) s := by
    have hdiv : ContinuousAt (fun t : ℝ ↦ z a / t) s :=
      continuousAt_const.div continuousAt_id hsne
    exact gaussian_contDiff.continuous.continuousAt.comp hdiv
  have hp : ContinuousAt (fun t : ℝ ↦ t ^ (-51 : ℝ)) s :=
    continuousAt_id.rpow_const (Or.inl hsne)
  change ContinuousWithinAt
    (fun t : ℝ ↦ gaussian (z 0 / t) * gaussian (z 1 / t) *
      gaussian (z 2 / t) * gaussian (z 3 / t) * t ^ (-51 : ℝ))
    (Set.Ici 1) s
  exact (((((hg 0).mul (hg 1)).mul (hg 2)).mul (hg 3)).mul hp).continuousWithinAt

theorem integrableOn_superpositionIntegrand (z : E4) :
    IntegrableOn (superpositionIntegrand z) (Set.Ici (1 : ℝ)) := by
  have hbase : IntegrableOn (fun s : ℝ ↦ s ^ (-51 : ℝ)) (Set.Ici (1 : ℝ)) := by
    apply (integrableOn_Ici_iff_integrableOn_Ioi).mpr
    exact integrableOn_Ioi_rpow_of_lt (by norm_num) zero_lt_one
  apply Integrable.mono' hbase
    ((superpositionIntegrand_continuousOn z).aestronglyMeasurable measurableSet_Ici)
  filter_upwards [ae_restrict_mem measurableSet_Ici] with s hs
  have hs0 : 0 ≤ s := le_trans zero_le_one hs
  rw [Real.norm_eq_abs, abs_of_nonneg (superpositionIntegrand_nonneg hs0)]
  unfold superpositionIntegrand
  have hpow : 0 ≤ s ^ (-51 : ℝ) := Real.rpow_nonneg hs0 _
  have hg0 : gaussian (z 0 / s) ≤ 1 := gaussian_le_one _
  have hg1 : gaussian (z 1 / s) ≤ 1 := gaussian_le_one _
  have hg2 : gaussian (z 2 / s) ≤ 1 := gaussian_le_one _
  have hg3 : gaussian (z 3 / s) ≤ 1 := gaussian_le_one _
  have h01 : gaussian (z 0 / s) * gaussian (z 1 / s) ≤ 1 := by
    calc
      gaussian (z 0 / s) * gaussian (z 1 / s) ≤ 1 * 1 :=
        mul_le_mul hg0 hg1 (gaussian_nonneg _) zero_le_one
      _ = 1 := by ring
  have h23 : gaussian (z 2 / s) * gaussian (z 3 / s) ≤ 1 := by
    calc
      gaussian (z 2 / s) * gaussian (z 3 / s) ≤ 1 * 1 :=
        mul_le_mul hg2 hg3 (gaussian_nonneg _) zero_le_one
      _ = 1 := by ring
  have hprod : gaussian (z 0 / s) * gaussian (z 1 / s) *
      gaussian (z 2 / s) * gaussian (z 3 / s) ≤ 1 := by
    calc
      gaussian (z 0 / s) * gaussian (z 1 / s) *
          gaussian (z 2 / s) * gaussian (z 3 / s) =
          (gaussian (z 0 / s) * gaussian (z 1 / s)) *
            (gaussian (z 2 / s) * gaussian (z 3 / s)) := by ring
      _ ≤ 1 * 1 :=
        mul_le_mul h01 h23
          (mul_nonneg (gaussian_nonneg _) (gaussian_nonneg _)) zero_le_one
      _ = 1 := by ring
  simpa using mul_le_mul_of_nonneg_right hprod hpow

theorem abs_coordinate_le_fourRadius (z : E4) (a : Fin 4) :
    |z a| ≤ fourRadius z := by
  fin_cases a
  · change |z 0| ≤ |z 0| + |z 1| + |z 2| + |z 3|
    nlinarith [abs_nonneg (z 1), abs_nonneg (z 2), abs_nonneg (z 3)]
  · change |z 1| ≤ |z 0| + |z 1| + |z 2| + |z 3|
    nlinarith [abs_nonneg (z 0), abs_nonneg (z 2), abs_nonneg (z 3)]
  · change |z 2| ≤ |z 0| + |z 1| + |z 2| + |z 3|
    nlinarith [abs_nonneg (z 0), abs_nonneg (z 1), abs_nonneg (z 3)]
  · change |z 3| ≤ |z 0| + |z 1| + |z 2| + |z 3|
    nlinarith [abs_nonneg (z 0), abs_nonneg (z 1), abs_nonneg (z 2)]

theorem exp_neg_pi_le_gaussian {x : ℝ} (hx : |x| ≤ 1) :
    Real.exp (-Real.pi) ≤ gaussian x := by
  rw [abs_le] at hx
  have hsq : x ^ 2 ≤ 1 := by
    have hprod : 0 ≤ (x + 1) * (1 - x) := by
      exact mul_nonneg (by linarith [hx.1]) (by linarith [hx.2])
    nlinarith
  unfold gaussian
  rw [Real.exp_le_exp]
  nlinarith [Real.pi_pos]

theorem superposition_coordinate_abs_div_le_one (z : E4) {s : ℝ}
    (hs : 1 + fourRadius z ≤ s) :
    ∀ a : Fin 4, |z a / s| ≤ 1 := by
  have hrad : 0 ≤ fourRadius z := by
    unfold fourRadius
    positivity
  have hspos : 0 < s := by linarith
  intro a
  rw [abs_div, abs_of_pos hspos]
  apply (div_le_one₀ hspos).mpr
  exact (abs_coordinate_le_fourRadius z a).trans (by linarith)

/-- A constant lower bound on a compact subinterval transfers to the positive
improper scale integral.  This isolates the interval restriction in the
source proof of `eq:superposition`. -/
theorem setIntegral_lower_of_pointwise
    (A c : ℝ) (hA : 0 ≤ A) (hc : 0 ≤ c) (f : ℝ → ℝ)
    (hfi : IntegrableOn f (Set.Ici (1 : ℝ)))
    (hnonneg : ∀ s ∈ Set.Ici (1 : ℝ), 0 ≤ f s)
    (hf : ∀ s ∈ Set.Icc A (2 * A), c * (2 * A) ^ (-51 : ℝ) ≤ f s)
    (hsub : Set.Icc A (2 * A) ⊆ Set.Ici (1 : ℝ)) :
    c * (2 * A) ^ (-51 : ℝ) * A ≤ ∫ s in Set.Ici (1 : ℝ), f s := by
  let q : ℝ := c * (2 * A) ^ (-51 : ℝ)
  have hq : 0 ≤ q := by
    unfold q
    exact mul_nonneg hc (Real.rpow_nonneg (by positivity) _)
  have hconst : IntegrableOn (fun _ : ℝ ↦ q) (Set.Icc A (2 * A)) := by
    exact integrableOn_const measure_Icc_lt_top.ne (by simp)
  have hmono : (∫ s in Set.Icc A (2 * A), q) ≤ ∫ s in Set.Icc A (2 * A), f s := by
    apply integral_mono_ae hconst (hfi.mono_set hsub)
    filter_upwards [ae_restrict_mem measurableSet_Icc] with s hs
    exact hf s hs
  have hset : (∫ s in Set.Icc A (2 * A), f s) ≤ ∫ s in Set.Ici (1 : ℝ), f s := by
    apply setIntegral_mono_set hfi
    · filter_upwards [ae_restrict_mem measurableSet_Ici] with s hs
      exact hnonneg s hs
    · exact Filter.Eventually.of_forall fun s hs => hsub hs
  calc
    c * (2 * A) ^ (-51 : ℝ) * A = ∫ s in Set.Icc A (2 * A), q := by
      rw [integral_const]
      simp [q]
      rw [max_eq_left (by nlinarith [hA])]
      ring
    _ ≤ ∫ s in Set.Icc A (2 * A), f s := hmono
    _ ≤ ∫ s in Set.Ici (1 : ℝ), f s := hset

theorem superpositionIntegrand_lower_on_scale_interval (z : E4) {s : ℝ}
    (hs : s ∈ Set.Icc (1 + fourRadius z) (2 * (1 + fourRadius z))) :
    Real.exp (-Real.pi) ^ 4 *
        (2 * (1 + fourRadius z)) ^ (-51 : ℝ) ≤
      superpositionIntegrand z s := by
  have hrad : 0 ≤ fourRadius z := by
    unfold fourRadius
    positivity
  have hApos : 0 < 1 + fourRadius z := by linarith
  have hspos : 0 < s := lt_of_lt_of_le hApos hs.1
  have hcoord := superposition_coordinate_abs_div_le_one z hs.1
  have hg0 : Real.exp (-Real.pi) ≤ gaussian (z 0 / s) :=
    exp_neg_pi_le_gaussian (hcoord 0)
  have hg1 : Real.exp (-Real.pi) ≤ gaussian (z 1 / s) :=
    exp_neg_pi_le_gaussian (hcoord 1)
  have hg2 : Real.exp (-Real.pi) ≤ gaussian (z 2 / s) :=
    exp_neg_pi_le_gaussian (hcoord 2)
  have hg3 : Real.exp (-Real.pi) ≤ gaussian (z 3 / s) :=
    exp_neg_pi_le_gaussian (hcoord 3)
  have he : 0 ≤ Real.exp (-Real.pi) := (Real.exp_pos _).le
  have h01 : Real.exp (-Real.pi) * Real.exp (-Real.pi) ≤
      gaussian (z 0 / s) * gaussian (z 1 / s) :=
    mul_le_mul hg0 hg1 he (gaussian_nonneg _)
  have h23 : Real.exp (-Real.pi) * Real.exp (-Real.pi) ≤
      gaussian (z 2 / s) * gaussian (z 3 / s) :=
    mul_le_mul hg2 hg3 he (gaussian_nonneg _)
  have hprod : Real.exp (-Real.pi) ^ 4 ≤
      gaussian (z 0 / s) * gaussian (z 1 / s) *
        gaussian (z 2 / s) * gaussian (z 3 / s) := by
    calc
      Real.exp (-Real.pi) ^ 4 =
          (Real.exp (-Real.pi) * Real.exp (-Real.pi)) *
            (Real.exp (-Real.pi) * Real.exp (-Real.pi)) := by ring
      _ ≤ (gaussian (z 0 / s) * gaussian (z 1 / s)) *
          (gaussian (z 2 / s) * gaussian (z 3 / s)) :=
        mul_le_mul h01 h23 (mul_nonneg he he)
          (mul_nonneg (gaussian_nonneg _) (gaussian_nonneg _))
      _ = gaussian (z 0 / s) * gaussian (z 1 / s) *
          gaussian (z 2 / s) * gaussian (z 3 / s) := by ring
  have hpow : (2 * (1 + fourRadius z)) ^ (-51 : ℝ) ≤ s ^ (-51 : ℝ) :=
    Real.rpow_le_rpow_of_nonpos hspos hs.2 (by norm_num)
  have hprodnonneg : 0 ≤ gaussian (z 0 / s) * gaussian (z 1 / s) *
      gaussian (z 2 / s) * gaussian (z 3 / s) := by
    exact mul_nonneg
      (mul_nonneg
        (mul_nonneg (gaussian_nonneg _) (gaussian_nonneg _))
        (gaussian_nonneg _))
      (gaussian_nonneg _)
  unfold superpositionIntegrand
  calc
    Real.exp (-Real.pi) ^ 4 * (2 * (1 + fourRadius z)) ^ (-51 : ℝ) ≤
        (gaussian (z 0 / s) * gaussian (z 1 / s) *
          gaussian (z 2 / s) * gaussian (z 3 / s)) *
            (2 * (1 + fourRadius z)) ^ (-51 : ℝ) :=
      mul_le_mul_of_nonneg_right hprod (Real.rpow_nonneg (by linarith [hApos]) _)
    _ ≤ (gaussian (z 0 / s) * gaussian (z 1 / s) *
          gaussian (z 2 / s) * gaussian (z 3 / s)) * s ^ (-51 : ℝ) :=
      mul_le_mul_of_nonneg_left hpow hprodnonneg

/-- The positive superposition has the explicit polynomial lower bound used
in the source proof. -/
theorem gaussianSuperposition_lower (z : E4) :
    Real.exp (-Real.pi) ^ 4 *
        (2 * (1 + fourRadius z)) ^ (-51 : ℝ) * (1 + fourRadius z) ≤
      gaussianSuperposition z := by
  have hrad : 0 ≤ fourRadius z := by
    unfold fourRadius
    positivity
  have hA : 0 ≤ 1 + fourRadius z := by linarith
  have hc : 0 ≤ Real.exp (-Real.pi) ^ 4 := pow_nonneg (Real.exp_pos _).le _
  unfold gaussianSuperposition
  exact setIntegral_lower_of_pointwise (1 + fourRadius z) (Real.exp (-Real.pi) ^ 4)
    hA hc (superpositionIntegrand z) (integrableOn_superpositionIntegrand z)
    (fun s hs ↦ superpositionIntegrand_nonneg (le_trans zero_le_one hs))
    (fun s hs ↦ superpositionIntegrand_lower_on_scale_interval z hs)
    (by
      intro s hs
      exact le_trans (by linarith) hs.1)

/-- A convenient order-fifty form of the positive superposition lower bound. -/
theorem gaussianSuperposition_lower_power (z : E4) :
    (2 : ℝ) ^ (-51 : ℝ) * Real.exp (-Real.pi) ^ 4 *
        (1 + fourRadius z) ^ (-50 : ℝ) ≤ gaussianSuperposition z := by
  let A : ℝ := 1 + fourRadius z
  have hApos : 0 < A := by
    dsimp [A]
    unfold fourRadius
    positivity
  have h := gaussianSuperposition_lower z
  have hfactor : (2 * A) ^ (-51 : ℝ) * A =
      (2 : ℝ) ^ (-51 : ℝ) * A ^ (-50 : ℝ) := by
    rw [Real.mul_rpow (by norm_num : (0 : ℝ) ≤ 2) hApos.le]
    calc
      (2 : ℝ) ^ (-51 : ℝ) * A ^ (-51 : ℝ) * A =
          (2 : ℝ) ^ (-51 : ℝ) * (A ^ (-51 : ℝ) * A ^ (1 : ℝ)) := by
        rw [Real.rpow_one]
        ring
      _ = (2 : ℝ) ^ (-51 : ℝ) * A ^ (-50 : ℝ) := by
        rw [← Real.rpow_add hApos]
        norm_num
  change (2 : ℝ) ^ (-51 : ℝ) * Real.exp (-Real.pi) ^ 4 * A ^ (-50 : ℝ) ≤ _
  calc
    (2 : ℝ) ^ (-51 : ℝ) * Real.exp (-Real.pi) ^ 4 * A ^ (-50 : ℝ) =
        Real.exp (-Real.pi) ^ 4 * ((2 * A) ^ (-51 : ℝ) * A) := by
      rw [hfactor]
      ring
    _ ≤ gaussianSuperposition z := by simpa [A, mul_assoc] using h

theorem fourRadius_nonneg (z : E4) : 0 ≤ fourRadius z := by
  unfold fourRadius
  positivity

theorem fourRadiusShift_nonneg (z : E4) (u : E3) : 0 ≤ fourRadiusShift z u := by
  unfold fourRadiusShift
  positivity

theorem sourceWeight_nonneg (u : E3) : 0 ≤ sourceWeight u := by
  unfold sourceWeight
  positivity

theorem sourceWeight_pos (u : E3) : 0 < sourceWeight u := by
  unfold sourceWeight
  positivity

/-- The elementary translation comparison used in the source proof. -/
theorem one_add_fourRadius_le_sourceWeight_mul_shift (z : E4) (u : E3) :
    1 + fourRadius z ≤ sourceWeight u * (1 + fourRadiusShift z u) := by
  have hz0 : |z 0| ≤ |z 0 - u 0| + |u 0| := by
    calc
      |z 0| = |(z 0 - u 0) + u 0| := congrArg abs (by ring)
      _ ≤ |z 0 - u 0| + |u 0| := abs_add_le _ _
  have hz2 : |z 2| ≤ |z 2 - u 1| + |u 1| := by
    calc
      |z 2| = |(z 2 - u 1) + u 1| := congrArg abs (by ring)
      _ ≤ |z 2 - u 1| + |u 1| := abs_add_le _ _
  have hcross : 0 ≤ (|u 0| + |u 1| + |u 2|) *
      (|z 0 - u 0| + |z 1| + |z 2 - u 1| + |z 3|) := by
    positivity
  unfold fourRadius fourRadiusShift sourceWeight
  nlinarith [abs_nonneg (u 2)]

theorem one_add_four_nonneg_le_product (a b c d : ℝ)
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) (hd : 0 ≤ d) :
    1 + (a + b + c + d) ≤ (1 + a) * (1 + b) * (1 + c) * (1 + d) := by
  have hab : 1 + a + b ≤ (1 + a) * (1 + b) := by
    nlinarith [mul_nonneg ha hb]
  have hcd : 1 + c + d ≤ (1 + c) * (1 + d) := by
    nlinarith [mul_nonneg hc hd]
  have hgroup : 1 + (a + b) + (c + d) ≤
      (1 + (a + b)) * (1 + (c + d)) := by
    have habnonneg : 0 ≤ a + b := add_nonneg ha hb
    have hcdnonneg : 0 ≤ c + d := add_nonneg hc hd
    nlinarith [mul_nonneg habnonneg hcdnonneg]
  calc
    1 + (a + b + c + d) = 1 + (a + b) + (c + d) := by ring
    _ ≤ (1 + (a + b)) * (1 + (c + d)) := hgroup
    _ = (1 + a + b) * (1 + c + d) := by ring
    _ ≤ ((1 + a) * (1 + b)) * ((1 + c) * (1 + d)) :=
      mul_le_mul hab hcd (by positivity) (by positivity)
    _ = (1 + a) * (1 + b) * (1 + c) * (1 + d) := by ring

theorem one_add_fourRadiusShift_le_product (z : E4) (u : E3) :
    1 + fourRadiusShift z u ≤
      (1 + |z 0 - u 0|) * (1 + |z 1|) *
        (1 + |z 2 - u 1|) * (1 + |z 3|) := by
  unfold fourRadiusShift
  exact one_add_four_nonneg_le_product _ _ _ _ (abs_nonneg _) (abs_nonneg _)
    (abs_nonneg _) (abs_nonneg _)

/-- A fixed algebraic rearrangement kept polymorphic in the exponent so the
kernel never unfolds a large concrete natural power while normalizing it. -/
theorem four_factor_mul_pow_distribute
    (a b c d e f g h : ℝ) (n : ℕ) :
    (a * b * c * d) * (e * f * g * h) ^ n =
      (a * e ^ n) * (b * f ^ n) * (c * g ^ n) * (d * h ^ n) := by
  rw [mul_pow, mul_pow, mul_pow]
  ac_rfl

/-- The four fixed spatial factors have arbitrary polynomial decay in their
joint translated coordinate radius.  Keeping the order as a variable avoids
kernel reduction of a concrete large natural power in the bookkeeping proof. -/
theorem superpositionInput_shift_weighted_decay_at (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (z : E4) (u : E3),
      superpositionInput z u * (1 + fourRadiusShift z u) ^ n ≤ C := by
  rcases conePhiPhysicalReal_decay n with ⟨Cφ, hCφ, hφ⟩
  rcases gaussian_polynomial_decay n with ⟨Cg, hCg, hg⟩
  refine ⟨(Cφ * Cg) * (Cφ * Cg),
    mul_nonneg (mul_nonneg hCφ hCg) (mul_nonneg hCφ hCg), ?_⟩
  intro z u
  have hφ0 : |conePhiPhysicalReal (z 0 - u 0)| * (1 + |z 0 - u 0|) ^ n ≤ Cφ :=
    (le_div_iff₀ (pow_pos (by positivity) _)).mp (hφ (z 0 - u 0))
  have hφ2 : |conePhiPhysicalReal (z 2 - u 1)| * (1 + |z 2 - u 1|) ^ n ≤ Cφ :=
    (le_div_iff₀ (pow_pos (by positivity) _)).mp (hφ (z 2 - u 1))
  have hg1 : gaussian (z 1) * (1 + |z 1|) ^ n ≤ Cg := by
    simpa [mul_comm] using hg (z 1)
  have hg3 : gaussian (z 3) * (1 + |z 3|) ^ n ≤ Cg := by
    simpa [mul_comm] using hg (z 3)
  have hφ0nonneg : 0 ≤ |conePhiPhysicalReal (z 0 - u 0)| *
      (1 + |z 0 - u 0|) ^ n :=
    mul_nonneg (abs_nonneg _) (pow_nonneg (by positivity) _)
  have hφ2nonneg : 0 ≤ |conePhiPhysicalReal (z 2 - u 1)| *
      (1 + |z 2 - u 1|) ^ n :=
    mul_nonneg (abs_nonneg _) (pow_nonneg (by positivity) _)
  have hg1nonneg : 0 ≤ gaussian (z 1) * (1 + |z 1|) ^ n :=
    mul_nonneg (gaussian_nonneg _) (pow_nonneg (by positivity) _)
  have hg3nonneg : 0 ≤ gaussian (z 3) * (1 + |z 3|) ^ n :=
    mul_nonneg (gaussian_nonneg _) (pow_nonneg (by positivity) _)
  have h01 :
      (|conePhiPhysicalReal (z 0 - u 0)| * (1 + |z 0 - u 0|) ^ n) *
        (gaussian (z 1) * (1 + |z 1|) ^ n) ≤ Cφ * Cg :=
    mul_le_mul hφ0 hg1
      hg1nonneg hCφ
  have h23 :
      (|conePhiPhysicalReal (z 2 - u 1)| * (1 + |z 2 - u 1|) ^ n) *
        (gaussian (z 3) * (1 + |z 3|) ^ n) ≤ Cφ * Cg :=
    mul_le_mul hφ2 hg3
      hg3nonneg hCφ
  have hproduct :
      (|conePhiPhysicalReal (z 0 - u 0)| * (1 + |z 0 - u 0|) ^ n) *
        (gaussian (z 1) * (1 + |z 1|) ^ n) *
        (|conePhiPhysicalReal (z 2 - u 1)| * (1 + |z 2 - u 1|) ^ n) *
        (gaussian (z 3) * (1 + |z 3|) ^ n) ≤
          (Cφ * Cg) * (Cφ * Cg) := by
    calc
      (|conePhiPhysicalReal (z 0 - u 0)| * (1 + |z 0 - u 0|) ^ n) *
          (gaussian (z 1) * (1 + |z 1|) ^ n) *
          (|conePhiPhysicalReal (z 2 - u 1)| * (1 + |z 2 - u 1|) ^ n) *
          (gaussian (z 3) * (1 + |z 3|) ^ n) =
          ((|conePhiPhysicalReal (z 0 - u 0)| * (1 + |z 0 - u 0|) ^ n) *
            (gaussian (z 1) * (1 + |z 1|) ^ n)) *
          ((|conePhiPhysicalReal (z 2 - u 1)| * (1 + |z 2 - u 1|) ^ n) *
            (gaussian (z 3) * (1 + |z 3|) ^ n)) := by ac_rfl
      _ ≤ (Cφ * Cg) * (Cφ * Cg) :=
        mul_le_mul h01 h23
          (mul_nonneg hφ2nonneg hg3nonneg)
          (mul_nonneg hCφ hCg)
  have hbase : (1 + fourRadiusShift z u) ^ n ≤
      ((1 + |z 0 - u 0|) * (1 + |z 1|) *
        (1 + |z 2 - u 1|) * (1 + |z 3|)) ^ n :=
    pow_le_pow_left₀ (by linarith [fourRadiusShift_nonneg z u])
      (one_add_fourRadiusShift_le_product z u) n
  have hinputnonneg : 0 ≤ superpositionInput z u := by
    unfold superpositionInput
    exact mul_nonneg
      (mul_nonneg
        (mul_nonneg (abs_nonneg _) (gaussian_nonneg _))
        (abs_nonneg _))
      (gaussian_nonneg _)
  calc
    superpositionInput z u * (1 + fourRadiusShift z u) ^ n ≤
        superpositionInput z u *
          ((1 + |z 0 - u 0|) * (1 + |z 1|) *
            (1 + |z 2 - u 1|) * (1 + |z 3|)) ^ n :=
      mul_le_mul_of_nonneg_left hbase hinputnonneg
    _ = (|conePhiPhysicalReal (z 0 - u 0)| * (1 + |z 0 - u 0|) ^ n) *
        (gaussian (z 1) * (1 + |z 1|) ^ n) *
        (|conePhiPhysicalReal (z 2 - u 1)| * (1 + |z 2 - u 1|) ^ n) *
        (gaussian (z 3) * (1 + |z 3|) ^ n) := by
      simpa only [superpositionInput] using
        four_factor_mul_pow_distribute
          |conePhiPhysicalReal (z 0 - u 0)| (gaussian (z 1))
          |conePhiPhysicalReal (z 2 - u 1)| (gaussian (z 3))
          (1 + |z 0 - u 0|) (1 + |z 1|)
          (1 + |z 2 - u 1|) (1 + |z 3|) n
    _ ≤ (Cφ * Cg) * (Cφ * Cg) := hproduct

/-- The order-fifty instance used by the translated low-frequency estimate. -/
theorem superpositionInput_shift_weighted_decay :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (z : E4) (u : E3),
      superpositionInput z u * (1 + fourRadiusShift z u) ^ 50 ≤ C :=
  superpositionInput_shift_weighted_decay_at 50

/-- Translation of the two low-frequency slots costs exactly the source
weight `U(u)^50`. -/
theorem superpositionInput_weighted_decay :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (z : E4) (u : E3),
      superpositionInput z u * (1 + fourRadius z) ^ 50 ≤
        C * sourceWeight u ^ 50 := by
  rcases superpositionInput_shift_weighted_decay with ⟨C, hC, hshift⟩
  refine ⟨C, hC, ?_⟩
  intro z u
  have hinputnonneg : 0 ≤ superpositionInput z u := by
    unfold superpositionInput
    exact mul_nonneg
      (mul_nonneg
        (mul_nonneg (abs_nonneg _) (gaussian_nonneg _))
        (abs_nonneg _))
      (gaussian_nonneg _)
  have htranslate : (1 + fourRadius z) ^ 50 ≤
      sourceWeight u ^ 50 * (1 + fourRadiusShift z u) ^ 50 := by
    calc
      (1 + fourRadius z) ^ 50 ≤
          (sourceWeight u * (1 + fourRadiusShift z u)) ^ 50 :=
        pow_le_pow_left₀ (by linarith [fourRadius_nonneg z])
          (one_add_fourRadius_le_sourceWeight_mul_shift z u) 50
      _ = sourceWeight u ^ 50 * (1 + fourRadiusShift z u) ^ 50 := by
        rw [mul_pow]
  calc
    superpositionInput z u * (1 + fourRadius z) ^ 50 ≤
        superpositionInput z u *
          (sourceWeight u ^ 50 * (1 + fourRadiusShift z u) ^ 50) :=
      mul_le_mul_of_nonneg_left htranslate hinputnonneg
    _ = sourceWeight u ^ 50 *
        (superpositionInput z u * (1 + fourRadiusShift z u) ^ 50) := by ring
    _ ≤ sourceWeight u ^ 50 * C :=
      mul_le_mul_of_nonneg_left (hshift z u)
        (pow_nonneg (sourceWeight_nonneg u) _)
    _ = C * sourceWeight u ^ 50 := by ring

/-- The third pointwise estimate of `lem:domination`: the two translated
low-frequency factors are controlled by the positive Gaussian superposition. -/
theorem gaussianSuperposition_domination :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (z : E4) (u : E3),
      superpositionInput z u ≤
        C * sourceWeight u ^ 50 * gaussianSuperposition z := by
  rcases superpositionInput_weighted_decay with ⟨C, hC, hinput⟩
  let c : ℝ := (2 : ℝ) ^ (-51 : ℝ) * Real.exp (-Real.pi) ^ 4
  have hcpos : 0 < c := by
    unfold c
    exact mul_pos (Real.rpow_pos_of_pos zero_lt_two _) (pow_pos (Real.exp_pos _) _)
  refine ⟨C * c⁻¹, mul_nonneg hC (inv_nonneg.mpr hcpos.le), ?_⟩
  intro z u
  let A : ℝ := 1 + fourRadius z
  have hApos : 0 < A := by
    dsimp [A]
    linarith [fourRadius_nonneg z]
  have hAinv : (A ^ (50 : ℕ))⁻¹ = A ^ (-50 : ℝ) := by
    rw [← Real.rpow_natCast A 50]
    exact (Real.rpow_neg hApos.le (50 : ℝ)).symm
  have hinputPower : superpositionInput z u ≤
      C * sourceWeight u ^ 50 * A ^ (-50 : ℝ) := by
    calc
      superpositionInput z u ≤ (C * sourceWeight u ^ 50) / A ^ (50 : ℕ) :=
        (le_div_iff₀ (pow_pos hApos _)).mpr (by simpa [A] using hinput z u)
      _ = C * sourceWeight u ^ 50 * A ^ (-50 : ℝ) := by
        rw [div_eq_mul_inv, hAinv]
  have hsuper : c * A ^ (-50 : ℝ) ≤ gaussianSuperposition z := by
    simpa [c, A] using gaussianSuperposition_lower_power z
  have hAtoSuper : A ^ (-50 : ℝ) ≤ c⁻¹ * gaussianSuperposition z := by
    calc
      A ^ (-50 : ℝ) ≤ gaussianSuperposition z / c := by
        apply (le_div_iff₀ hcpos).mpr
        simpa [mul_comm] using hsuper
      _ = c⁻¹ * gaussianSuperposition z := by ring
  have hmult : 0 ≤ C * sourceWeight u ^ 50 :=
    mul_nonneg hC (pow_nonneg (sourceWeight_nonneg u) _)
  calc
    superpositionInput z u ≤ C * sourceWeight u ^ 50 * A ^ (-50 : ℝ) := hinputPower
    _ ≤ C * sourceWeight u ^ 50 * (c⁻¹ * gaussianSuperposition z) :=
      mul_le_mul_of_nonneg_left hAtoSuper hmult
    _ = (C * c⁻¹) * sourceWeight u ^ 50 * gaussianSuperposition z := by ring

/-- A one-dimensional order-fifty decay estimate is stable under translation,
with the precise polynomial loss used for the annular cutoff. -/
theorem translated_orderFifty_decay (f : ℝ → ℝ)
    (hdecay : ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      (1 + |x|) ^ 50 * |f x| ≤ C) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (r a : ℝ),
      |f (r + a)| ≤ C * (1 + |a|) ^ 50 / (1 + |r|) ^ 50 := by
  rcases hdecay with ⟨C, hC, hdecay⟩
  refine ⟨C, hC, ?_⟩
  intro r a
  have hr : |r| ≤ |r + a| + |a| := by
    calc
      |r| = |(r + a) + (-a)| := congrArg abs (by ring)
      _ ≤ |r + a| + |-a| := abs_add_le _ _
      _ = |r + a| + |a| := by rw [abs_neg]
  have hWnonneg : 0 ≤ 1 + |a| := by positivity
  have hB : 1 + |r| ≤ (1 + |a|) * (1 + |r + a|) := by
    nlinarith [mul_nonneg (abs_nonneg a) (abs_nonneg (r + a))]
  have hBpow : (1 + |r|) ^ 50 ≤
      (1 + |a|) ^ 50 * (1 + |r + a|) ^ 50 := by
    calc
      (1 + |r|) ^ 50 ≤ ((1 + |a|) * (1 + |r + a|)) ^ 50 :=
        pow_le_pow_left₀ (by positivity) hB 50
      _ = (1 + |a|) ^ 50 * (1 + |r + a|) ^ 50 := by rw [mul_pow]
  apply (le_div_iff₀ (pow_pos (by positivity) _)).mpr
  calc
    |f (r + a)| * (1 + |r|) ^ 50 ≤
        |f (r + a)| * ((1 + |a|) ^ 50 * (1 + |r + a|) ^ 50) :=
      mul_le_mul_of_nonneg_left hBpow (abs_nonneg _)
    _ = (1 + |a|) ^ 50 * ((1 + |r + a|) ^ 50 * |f (r + a)|) := by ring
    _ ≤ (1 + |a|) ^ 50 * C :=
      mul_le_mul_of_nonneg_left (hdecay (r + a)) (pow_nonneg hWnonneg _)
    _ = C * (1 + |a|) ^ 50 := by ring

/-- The annular spatial cutoff obeys the two signed translation bounds in
the final clause of `lem:domination`. -/
theorem conePsiPhysicalReal_translate_decay :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (r : ℝ) (u : E3),
      |conePsiPhysicalReal (r + u 2)| ≤
          C * sourceWeight u ^ 50 * translationWeight r ^ (-50 : ℝ) ∧
      |conePsiPhysicalReal (r - u 2)| ≤
          C * sourceWeight u ^ 50 * translationWeight r ^ (-50 : ℝ) := by
  rcases conePsiPhysicalReal_decay 50 with ⟨C, hC, hdecay⟩
  have hdecay' : ∀ x : ℝ, (1 + |x|) ^ 50 * |conePsiPhysicalReal x| ≤ C := by
    intro x
    simpa [mul_comm] using
      (le_div_iff₀ (pow_pos (by positivity) _)).mp (hdecay x)
  rcases translated_orderFifty_decay conePsiPhysicalReal ⟨C, hC, hdecay'⟩ with
    ⟨C', hC', htranslate⟩
  refine ⟨C', hC', ?_⟩
  intro r u
  have hu : 1 + |u 2| ≤ sourceWeight u := by
    unfold sourceWeight
    nlinarith [abs_nonneg (u 0), abs_nonneg (u 1)]
  have hupow : (1 + |u 2|) ^ 50 ≤ sourceWeight u ^ 50 :=
    pow_le_pow_left₀ (by positivity) hu 50
  have hRpos : 0 < translationWeight r := by
    unfold translationWeight
    positivity
  have hdenom : (1 + |r|) ^ 50 ≠ 0 := pow_ne_zero _ (by positivity)
  constructor
  · calc
      |conePsiPhysicalReal (r + u 2)| ≤
          C' * (1 + |u 2|) ^ 50 / (1 + |r|) ^ 50 := htranslate r (u 2)
      _ ≤ C' * sourceWeight u ^ 50 / (1 + |r|) ^ 50 := by
        apply (div_le_div_iff_of_pos_right (pow_pos (by positivity) _)).mpr
        exact mul_le_mul_of_nonneg_left hupow hC'
      _ = C' * sourceWeight u ^ 50 * translationWeight r ^ (-50 : ℝ) := by
        unfold translationWeight
        rw [div_eq_mul_inv]
        congr 1
        rw [show (-50 : ℝ) = -(50 : ℝ) by norm_num,
          Real.rpow_neg (by positivity)]
        exact congrArg (fun x : ℝ ↦ x⁻¹)
          (Real.rpow_natCast (1 + |r|) 50).symm
  · have hminus := htranslate r (-(u 2))
    rw [show r + -(u 2) = r - u 2 by ring, abs_neg] at hminus
    calc
      |conePsiPhysicalReal (r - u 2)| ≤
          C' * (1 + |u 2|) ^ 50 / (1 + |r|) ^ 50 := hminus
      _ ≤ C' * sourceWeight u ^ 50 / (1 + |r|) ^ 50 := by
        apply (div_le_div_iff_of_pos_right (pow_pos (by positivity) _)).mpr
        exact mul_le_mul_of_nonneg_left hupow hC'
      _ = C' * sourceWeight u ^ 50 * translationWeight r ^ (-50 : ℝ) := by
        unfold translationWeight
        rw [div_eq_mul_inv]
        congr 1
        rw [show (-50 : ℝ) = -(50 : ℝ) by norm_num,
          Real.rpow_neg (by positivity)]
        exact congrArg (fun x : ℝ ↦ x⁻¹)
          (Real.rpow_natCast (1 + |r|) 50).symm

/-- The `L¹` mass of the annular spatial cutoff, written in the source's
absolute-value convention. -/
noncomputable def conePsiPhysicalRealL1 : ℝ :=
  ∫ r : ℝ, |conePsiPhysicalReal r|

theorem integrable_abs_conePsiPhysicalReal :
    Integrable (fun r : ℝ ↦ |conePsiPhysicalReal r|) := by
  simpa only [Real.norm_eq_abs] using conePsiPhysicalReal.integrable.norm

theorem integral_abs_conePsiPhysicalReal_add (a : ℝ) :
    ∫ r : ℝ, |conePsiPhysicalReal (r + a)| = conePsiPhysicalRealL1 := by
  unfold conePsiPhysicalRealL1
  exact integral_add_right_eq_self (μ := volume)
    (fun r : ℝ ↦ |conePsiPhysicalReal r|) a

theorem integral_abs_conePsiPhysicalReal_sub (a : ℝ) :
    ∫ r : ℝ, |conePsiPhysicalReal (r - a)| = conePsiPhysicalRealL1 := by
  unfold conePsiPhysicalRealL1
  exact integral_sub_right_eq_self (μ := volume)
    (fun r : ℝ ↦ |conePsiPhysicalReal r|) a

/-! ## Anisotropic dyadic boxes

This is the literal integer-level grid from `def:tree`.  In particular,
parents use Euclidean division on `ℤ`; this is the floor operation stipulated
by the source even for negative coordinate indices.
-/

/-- A source dyadic box is determined by an integral scale and three integral
coordinate indices. -/
structure AnisoBox (α : Anisotropy) where
  level : ℤ
  index : Fin 3 → ℤ
  deriving DecidableEq

/-- The number of children in coordinate `i`. -/
def anisoRadix (α : Anisotropy) (i : Fin 3) : ℕ := 2 ^ α.weight i

/-- A coordinatewise child digit. -/
abbrev AnisoDigit (α : Anisotropy) := (i : Fin 3) → Fin (anisoRadix α i)

theorem anisoRadix_pos (α : Anisotropy) (i : Fin 3) : 0 < anisoRadix α i := by
  exact Nat.pow_pos (by norm_num)

/-- The side length in coordinate `i` of an anisotropic box. -/
noncomputable def boxSide (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) : ℝ :=
  (2 : ℝ) ^ (q.level * (α.weight i : ℤ))

/-- The source scale `\(\ell(Q)\)`. -/
noncomputable def boxLength (q : AnisoBox α) : ℝ := (2 : ℝ) ^ q.level

/-- The source volume formula `\(|Q|=2^{kA}\)`, recorded as a positive
grid mass before its Lebesgue-measure identification. -/
noncomputable def boxMass (α : Anisotropy) (q : AnisoBox α) : ℝ :=
  (2 : ℝ) ^ (q.level * (α.homogeneousDimension : ℤ))

theorem boxSide_eq_length_pow (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    boxSide α q i = boxLength q ^ α.weight i := by
  simp only [boxSide, boxLength, ← zpow_natCast, zpow_mul]

theorem prod_boxSide_eq_boxMass (α : Anisotropy) (q : AnisoBox α) :
    (∏ i, boxSide α q i) = boxMass α q := by
  simp_rw [boxSide_eq_length_pow]
  rw [Finset.prod_pow_eq_pow_sum]
  simp only [boxMass, boxLength, Anisotropy.homogeneousDimension, ← zpow_natCast, zpow_mul]

theorem boxSide_pos (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    0 < boxSide α q i := by
  exact zpow_pos (by norm_num) _

theorem boxMass_pos (α : Anisotropy) (q : AnisoBox α) : 0 < boxMass α q := by
  exact zpow_pos (by norm_num) _

theorem boxLength_pos (q : AnisoBox α) : 0 < boxLength q := by
  exact zpow_pos (by norm_num) _

/-- The half-open coordinate interval of a box. -/
noncomputable def boxInterval (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    Set ℝ :=
  Set.Ico ((q.index i : ℝ) * boxSide α q i)
    (((q.index i + 1 : ℤ) : ℝ) * boxSide α q i)

/-- The spatial half-open box `Q(k,n)`. -/
noncomputable def boxSet (α : Anisotropy) (q : AnisoBox α) : Set E3 :=
  Set.preimage (WithLp.ofLp : E3 → Fin 3 → ℝ)
    (Set.pi Set.univ (fun i ↦ boxInterval α q i))

/-- The source parent box, using integer floor division coordinatewise. -/
def boxParent (α : Anisotropy) (q : AnisoBox α) : AnisoBox α :=
  ⟨q.level + 1, fun i ↦ q.index i / (anisoRadix α i : ℤ)⟩

/-- The child selected by a coordinatewise digit. -/
def boxChild (α : Anisotropy) (q : AnisoBox α) (v : AnisoDigit α) : AnisoBox α :=
  ⟨q.level - 1, fun i ↦ (anisoRadix α i : ℤ) * q.index i + (v i : ℤ)⟩

/-- The finite family of source children. -/
def boxChildren (α : Anisotropy) (q : AnisoBox α) : Finset (AnisoBox α) :=
  Finset.univ.image (boxChild α q)

theorem boxParent_child (α : Anisotropy) (q : AnisoBox α) (v : AnisoDigit α) :
    boxParent α (boxChild α q v) = q := by
  cases q with
  | mk level index =>
    simp only [boxParent, boxChild, AnisoBox.mk.injEq]
    constructor
    · omega
    · funext i
      rw [Int.mul_add_ediv_left]
      · rw [Int.ediv_eq_zero_of_lt]
        · simp
        · exact_mod_cast Nat.zero_le (v i).val
        · exact_mod_cast (v i).isLt
      · exact_mod_cast (Nat.ne_of_gt (anisoRadix_pos α i))

theorem boxChild_injective (α : Anisotropy) (q : AnisoBox α) :
    Function.Injective (boxChild α q) := by
  intro v w h
  funext i
  have hi := congrFun (congrArg AnisoBox.index h) i
  dsimp [boxChild] at hi
  apply Fin.ext
  have hval : (v i : ℤ) = (w i : ℤ) := by linarith
  exact_mod_cast hval

/-- Every box has exactly `2^A` children, as in `lem:geometry`. -/
theorem card_boxChildren (α : Anisotropy) (q : AnisoBox α) :
    (boxChildren α q).card = 2 ^ α.homogeneousDimension := by
  unfold boxChildren
  rw [Finset.card_image_iff.mpr (boxChild_injective α q).injOn]
  rw [Finset.card_univ, Fintype.card_pi]
  have hc (i : Fin 3) : Fintype.card (Fin (anisoRadix α i)) = anisoRadix α i :=
    Fintype.card_fin _
  simp_rw [hc]
  unfold anisoRadix Anisotropy.homogeneousDimension
  rw [Finset.prod_pow_eq_pow_sum]

theorem measurableSet_boxSet (α : Anisotropy) (q : AnisoBox α) :
    MeasurableSet (boxSet α q) := by
  unfold boxSet
  apply (PiLp.volume_preserving_ofLp (Fin 3)).measurable
  apply MeasurableSet.pi Set.countable_univ
  intro i _
  exact measurableSet_Ico

/-- Lebesgue volume of the literal half-open grid box, before collecting the
coordinate factors into the homogeneous-dimension expression. -/
theorem volume_boxSet (α : Anisotropy) (q : AnisoBox α) :
    volume (boxSet α q) = ∏ i, ENNReal.ofReal (boxSide α q i) := by
  let lo : Fin 3 → ℝ := fun i ↦ (q.index i : ℝ) * boxSide α q i
  let hi : Fin 3 → ℝ := fun i ↦ ((q.index i + 1 : ℤ) : ℝ) * boxSide α q i
  have hmeas : MeasurableSet (Set.pi Set.univ fun i ↦ Set.Ico (lo i) (hi i)) := by
    apply MeasurableSet.pi Set.countable_univ
    intro i _
    exact measurableSet_Ico
  change volume ((WithLp.ofLp : E3 → Fin 3 → ℝ) ⁻¹'
      Set.pi Set.univ (fun i ↦ Set.Ico (lo i) (hi i))) = _
  rw [(PiLp.volume_preserving_ofLp (Fin 3)).measure_preimage hmeas.nullMeasurableSet]
  rw [Real.volume_pi_Ico]
  congr with i
  congr 1
  dsimp [lo, hi]
  push_cast
  ring

theorem volume_boxSet_toReal (α : Anisotropy) (q : AnisoBox α) :
    (volume (boxSet α q)).toReal = boxMass α q := by
  rw [volume_boxSet, ENNReal.toReal_prod]
  have htoReal : ∀ i : Fin 3,
      (ENNReal.ofReal (boxSide α q i)).toReal = boxSide α q i :=
    fun i ↦ ENNReal.toReal_ofReal (boxSide_pos α q i).le
  simp_rw [htoReal]
  exact prod_boxSide_eq_boxMass α q

/-- The exact source normalization `|Q(k,n)| = 2^{kA}`. -/
theorem volume_boxSet_eq_boxMass (α : Anisotropy) (q : AnisoBox α) :
    volume (boxSet α q) = ENNReal.ofReal (boxMass α q) := by
  rw [volume_boxSet]
  rw [← ENNReal.ofReal_prod_of_nonneg]
  · rw [prod_boxSide_eq_boxMass]
  · intro i _
    exact (boxSide_pos α q i).le

/-- Integer division reconstructs every child digit, including at negative
indices.  This is the converse to `boxParent_child`. -/
theorem exists_boxChild_eq_of_boxParent_eq
    (α : Anisotropy) (q r : AnisoBox α)
    (h : boxParent α r = q) :
    ∃ v : AnisoDigit α, boxChild α q v = r := by
  cases q with
  | mk qlevel qindex =>
    cases r with
    | mk rlevel rindex =>
      simp only [boxParent, AnisoBox.mk.injEq] at h
      rcases h with ⟨hlevel, hindex⟩
      let v : AnisoDigit α := fun i ↦
        ⟨(rindex i % (anisoRadix α i : ℤ)).toNat, by
          rw [Int.toNat_lt
            (Int.emod_nonneg _ (by
              exact_mod_cast (Nat.ne_of_gt (anisoRadix_pos α i))))]
          exact Int.emod_lt_of_pos _ (by
            exact_mod_cast (anisoRadix_pos α i))⟩
      refine ⟨v, ?_⟩
      simp only [boxChild, AnisoBox.mk.injEq]
      constructor
      · omega
      · funext i
        have hrem :
            ((rindex i % (anisoRadix α i : ℤ)).toNat : ℤ) =
              rindex i % (anisoRadix α i : ℤ) :=
          Int.toNat_of_nonneg (Int.emod_nonneg _ (by
            exact_mod_cast (Nat.ne_of_gt (anisoRadix_pos α i))))
        dsimp [v]
        rw [← congrFun hindex i, hrem, Int.mul_ediv_add_emod]

theorem boxParent_eq_iff_exists_boxChild (α : Anisotropy) (q r : AnisoBox α) :
    boxParent α r = q ↔ ∃ v : AnisoDigit α, boxChild α q v = r := by
  constructor
  · exact exists_boxChild_eq_of_boxParent_eq α q r
  · rintro ⟨v, rfl⟩
    exact boxParent_child α q v

theorem boxSide_parent (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    boxSide α (boxParent α q) i =
      (anisoRadix α i : ℝ) * boxSide α q i := by
  unfold boxSide boxParent anisoRadix
  have hexp : (q.level + 1) * (α.weight i : ℤ) =
      q.level * (α.weight i : ℤ) + (α.weight i : ℤ) := by ring
  rw [hexp, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_natCast]
  norm_cast
  ring

theorem boxInterval_subset_parent (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    boxInterval α q i ⊆ boxInterval α (boxParent α q) i := by
  unfold boxInterval
  rw [boxSide_parent]
  simp only [boxParent]
  have hlt : (q.index i : ℝ) < ((q.index i + 1 : ℤ) : ℝ) := by
    have hltZ : q.index i < q.index i + 1 := by omega
    exact_mod_cast hltZ
  have hnonempty : (q.index i : ℝ) * boxSide α q i <
      ((q.index i + 1 : ℤ) : ℝ) * boxSide α q i :=
    mul_lt_mul_of_pos_right hlt (boxSide_pos α q i)
  apply (Set.Ico_subset_Ico_iff hnonempty).2
  constructor
  · let R : ℤ := anisoRadix α i
    have hRne : R ≠ 0 := by
      dsimp [R]
      exact_mod_cast (Nat.ne_of_gt (anisoRadix_pos α i))
    have hlowZ : (q.index i / R) * R ≤ q.index i :=
      Int.ediv_mul_le _ hRne
    have hlow : ((q.index i / R : ℤ) : ℝ) * (R : ℝ) ≤ q.index i := by
      exact_mod_cast hlowZ
    change ((q.index i / R : ℤ) : ℝ) * ((R : ℝ) * boxSide α q i) ≤
      (q.index i : ℝ) * boxSide α q i
    rw [← mul_assoc]
    exact mul_le_mul_of_nonneg_right hlow (boxSide_pos α q i).le
  · let R : ℤ := anisoRadix α i
    have hRpos : 0 < R := by
      dsimp [R]
      exact_mod_cast anisoRadix_pos α i
    have hrem : q.index i % R < R := Int.emod_lt_of_pos _ hRpos
    have hdecomp : q.index i % R + R * (q.index i / R) = q.index i :=
      Int.emod_add_mul_ediv _ _
    have huZ : q.index i + 1 ≤ (q.index i / R + 1) * R := by
      calc
        q.index i + 1 = q.index i % R + R * (q.index i / R) + 1 := by
          rw [hdecomp]
        _ ≤ R * (q.index i / R) + R := by linarith
        _ = (q.index i / R + 1) * R := by ring
    have hu : ((q.index i + 1 : ℤ) : ℝ) ≤
        ((q.index i / R + 1 : ℤ) : ℝ) * (R : ℝ) := by
      exact_mod_cast huZ
    change ((q.index i + 1 : ℤ) : ℝ) * boxSide α q i ≤
      ((q.index i / R + 1 : ℤ) : ℝ) * ((R : ℝ) * boxSide α q i)
    rw [← mul_assoc]
    exact mul_le_mul_of_nonneg_right hu (boxSide_pos α q i).le

theorem boxSet_subset_parent (α : Anisotropy) (q : AnisoBox α) :
    boxSet α q ⊆ boxSet α (boxParent α q) := by
  intro x hx
  rw [boxSet, Set.mem_preimage, Set.mem_pi] at hx ⊢
  intro i _
  exact boxInterval_subset_parent α q i (hx i (Set.mem_univ i))

/-- Boxes at a common grid level have common side lengths. -/
theorem boxSide_eq_of_level (α : Anisotropy) {q r : AnisoBox α}
    (hlevel : q.level = r.level) (i : Fin 3) :
    boxSide α q i = boxSide α r i := by
  unfold boxSide
  rw [hlevel]

/-- Distinct integer coordinate intervals at a fixed level are disjoint. -/
theorem boxInterval_disjoint_of_eq_level_of_ne_index
    (α : Anisotropy) {q r : AnisoBox α} (i : Fin 3)
    (hlevel : q.level = r.level) (hindex : q.index i ≠ r.index i) :
    Disjoint (boxInterval α q i) (boxInterval α r i) := by
  have hside : boxSide α r i = boxSide α q i :=
    (boxSide_eq_of_level α hlevel i).symm
  rw [boxInterval, boxInterval, hside]
  have hs : 0 < boxSide α q i := boxSide_pos α q i
  apply Set.disjoint_left.2
  intro x hx hy
  rcases hx with ⟨hxlo, hxhi⟩
  rcases hy with ⟨hylo, hyhi⟩
  rcases lt_or_gt_of_ne hindex with hlt | hgt
  · have hstep : q.index i + 1 ≤ r.index i := by omega
    have hstepR : ((q.index i + 1 : ℤ) : ℝ) * boxSide α q i ≤
        (r.index i : ℝ) * boxSide α q i := by
      apply mul_le_mul_of_nonneg_right _ hs.le
      exact_mod_cast hstep
    exact (not_le_of_gt hxhi) (hstepR.trans hylo)
  · have hstep : r.index i + 1 ≤ q.index i := by omega
    have hstepR : ((r.index i + 1 : ℤ) : ℝ) * boxSide α q i ≤
        (q.index i : ℝ) * boxSide α q i := by
      apply mul_le_mul_of_nonneg_right _ hs.le
      exact_mod_cast hstep
    exact (not_le_of_gt hyhi) (hstepR.trans hxlo)

/-- A disjoint coordinate interval makes the corresponding spatial boxes disjoint. -/
theorem boxSet_disjoint_of_disjoint_interval
    (α : Anisotropy) {q r : AnisoBox α} (i : Fin 3)
    (hi : Disjoint (boxInterval α q i) (boxInterval α r i)) :
    Disjoint (boxSet α q) (boxSet α r) := by
  apply Set.disjoint_left.2
  intro x hx hy
  rw [boxSet, Set.mem_preimage, Set.mem_pi] at hx hy
  exact (Set.disjoint_left.1 hi)
    (hx i (Set.mem_univ i)) (hy i (Set.mem_univ i))

/-- Distinct boxes at a common level are disjoint. -/
theorem boxSet_disjoint_of_eq_level_of_ne
    (α : Anisotropy) {q r : AnisoBox α}
    (hlevel : q.level = r.level) (hne : q ≠ r) :
    Disjoint (boxSet α q) (boxSet α r) := by
  have hindex : q.index ≠ r.index := by
    intro h
    apply hne
    cases q with
    | mk qlevel qindex =>
      cases r with
      | mk rlevel rindex =>
        simp only [AnisoBox.mk.injEq]
        exact ⟨hlevel, h⟩
  obtain ⟨i, hi⟩ : ∃ i, q.index i ≠ r.index i := by
    by_contra h
    push Not at h
    apply hindex
    funext i
    exact h i
  exact boxSet_disjoint_of_disjoint_interval α i
    (boxInterval_disjoint_of_eq_level_of_ne_index α i hlevel hi)

/-- The finite parent iterate used to compare boxes across levels. -/
def boxAncestor (α : Anisotropy) (n : ℕ) (q : AnisoBox α) : AnisoBox α :=
  (boxParent α)^[n] q

theorem boxAncestor_level (α : Anisotropy) (n : ℕ) (q : AnisoBox α) :
    (boxAncestor α n q).level = q.level + n := by
  induction n generalizing q with
  | zero => simp [boxAncestor]
  | succ n ih =>
    have ih' : ((boxParent α)^[n] q).level = q.level + n := by
      simpa [boxAncestor] using ih q
    simp only [boxAncestor, Function.iterate_succ_apply', Nat.cast_add,
      Nat.cast_one]
    change ((boxParent α ((boxParent α)^[n] q)).level) = q.level + (↑n + 1)
    simp only [boxParent]
    rw [ih']
    ring

theorem boxAncestor_subset (α : Anisotropy) (n : ℕ) (q : AnisoBox α) :
    boxSet α q ⊆ boxSet α (boxAncestor α n q) := by
  induction n with
  | zero => simp [boxAncestor]
  | succ n ih =>
    rw [boxAncestor, Function.iterate_succ_apply']
    exact ih.trans (boxSet_subset_parent α _)

/-- Intersecting grid boxes are nested when their levels are ordered. -/
theorem boxSet_nested_of_inter_nonempty (α : Anisotropy)
    {q r : AnisoBox α} (hlevel : q.level ≤ r.level)
    (hinter : (boxSet α q ∩ boxSet α r).Nonempty) :
    boxSet α q ⊆ boxSet α r := by
  let n : ℕ := (r.level - q.level).toNat
  have hn : (n : ℤ) = r.level - q.level := by
    dsimp [n]
    rw [Int.toNat_of_nonneg (sub_nonneg.mpr hlevel)]
  have hAncestorLevel : (boxAncestor α n q).level = r.level := by
    rw [boxAncestor_level, hn]
    ring
  have hAncestorEq : boxAncestor α n q = r := by
    by_contra hne
    have hdisj := boxSet_disjoint_of_eq_level_of_ne α hAncestorLevel hne
    rcases hinter with ⟨x, hx⟩
    exact (Set.disjoint_left.1 hdisj)
      (boxAncestor_subset α n q hx.1) hx.2
  simpa [hAncestorEq] using boxAncestor_subset α n q

/-- The coordinate side length at the child level. -/
noncomputable def boxSubside (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) : ℝ :=
  (2 : ℝ) ^ ((q.level - 1) * (α.weight i : ℤ))

/-- The `d`-th coordinate child interval of a box. -/
noncomputable def boxChildInterval (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) (d : Fin (anisoRadix α i)) : Set ℝ :=
  Set.Ico
    (((((anisoRadix α i : ℤ) * q.index i + (d : ℤ)) : ℤ) : ℝ) *
      boxSubside α q i)
    (((((anisoRadix α i : ℤ) * q.index i + (d : ℤ) + 1 : ℤ) : ℤ) : ℝ) *
      boxSubside α q i)

theorem boxSide_eq_radix_mul_subside (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    boxSide α q i = (anisoRadix α i : ℝ) * boxSubside α q i := by
  unfold boxSide anisoRadix boxSubside
  have hexp : q.level * (α.weight i : ℤ) =
      (q.level - 1) * (α.weight i : ℤ) + (α.weight i : ℤ) := by ring
  rw [hexp, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_natCast]
  norm_cast
  ring

theorem boxChildInterval_eq_boxInterval_child
    (α : Anisotropy) (q : AnisoBox α) (v : AnisoDigit α) (i : Fin 3) :
    boxChildInterval α q i (v i) = boxInterval α (boxChild α q v) i := by
  rfl

/-- A parent coordinate interval is covered by its finitely many child intervals. -/
theorem boxInterval_subset_iUnion_childInterval
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    boxInterval α q i ⊆
      ⋃ d : Fin (anisoRadix α i), boxChildInterval α q i d := by
  let R : ℕ := anisoRadix α i
  let a : ℕ → ℝ := fun d ↦ ((R : ℤ) * q.index i + d : ℤ) * boxSubside α q i
  have htiling := Ico_subset_biUnion_Ico R a
  intro x hx
  have hzero : a 0 = (q.index i : ℝ) * boxSide α q i := by
    dsimp [a, R]
    rw [boxSide_eq_radix_mul_subside]
    push_cast
    ring
  have htop : a R = ((q.index i + 1 : ℤ) : ℝ) * boxSide α q i := by
    dsimp [a, R]
    rw [boxSide_eq_radix_mul_subside]
    push_cast
    ring
  have hx' : x ∈ Set.Ico (a 0) (a R) := by
    rw [hzero, htop]
    exact hx
  rcases Set.mem_iUnion.1 (htiling hx') with ⟨d, hd⟩
  rcases Set.mem_iUnion.1 hd with ⟨hdR, hxd⟩
  let e : Fin (anisoRadix α i) := ⟨d, by
    simpa only [R] using Finset.mem_range.mp hdR⟩
  refine Set.mem_iUnion.2 ⟨e, ?_⟩
  have ha : a d =
      (((((anisoRadix α i : ℤ) * q.index i + (e : ℤ)) : ℤ) : ℝ) *
        boxSubside α q i) := by
    dsimp [a, R, e]
  have hanext : a (d + 1) =
      (((((anisoRadix α i : ℤ) * q.index i + (e : ℤ) + 1 : ℤ) : ℤ) : ℝ) *
        boxSubside α q i) := by
    dsimp [a, R, e]
    push_cast
    ring
  simpa only [boxChildInterval, ← ha, ← hanext] using hxd

/-- The spatial box is covered by the union of its finitely many children. -/
theorem boxSet_subset_children_union (α : Anisotropy) (q : AnisoBox α) :
    boxSet α q ⊆ ⋃ r ∈ boxChildren α q, boxSet α r := by
  intro x hx
  rw [boxSet, Set.mem_preimage, Set.mem_pi] at hx
  have hcoord : ∀ i, ∃ d : Fin (anisoRadix α i),
      (WithLp.ofLp x : Fin 3 → ℝ) i ∈ boxChildInterval α q i d := by
    intro i
    rcases Set.mem_iUnion.1
      (boxInterval_subset_iUnion_childInterval α q i
        (hx i (Set.mem_univ i))) with ⟨d, hd⟩
    exact ⟨d, hd⟩
  choose d hd using hcoord
  let v : AnisoDigit α := fun i ↦ d i
  have hchild : x ∈ boxSet α (boxChild α q v) := by
    rw [boxSet, Set.mem_preimage, Set.mem_pi]
    intro i _
    rw [← boxChildInterval_eq_boxInterval_child]
    exact hd i
  refine Set.mem_iUnion.2 ⟨boxChild α q v, ?_⟩
  refine Set.mem_iUnion.2 ⟨?_, hchild⟩
  exact Finset.mem_image.2 ⟨v, Finset.mem_univ v, rfl⟩

theorem children_union_subset_boxSet (α : Anisotropy) (q : AnisoBox α) :
    (⋃ r ∈ boxChildren α q, boxSet α r) ⊆ boxSet α q := by
  intro x hx
  rcases Set.mem_iUnion.1 hx with ⟨r, hr⟩
  rcases Set.mem_iUnion.1 hr with ⟨hrmem, hxr⟩
  rcases Finset.mem_image.1 hrmem with ⟨v, hv, rfl⟩
  simpa only [boxParent_child] using boxSet_subset_parent α (boxChild α q v) hxr

/-- Exact finite child partition of a grid box. -/
theorem boxSet_eq_children_union (α : Anisotropy) (q : AnisoBox α) :
    boxSet α q = ⋃ r ∈ boxChildren α q, boxSet α r := by
  exact Set.Subset.antisymm (boxSet_subset_children_union α q)
    (children_union_subset_boxSet α q)

theorem pairwiseDisjoint_boxSet_children (α : Anisotropy) (q : AnisoBox α) :
    (↑(boxChildren α q) : Set (AnisoBox α)).PairwiseDisjoint (boxSet α) := by
  intro r hr s hs hrs
  rcases Finset.mem_image.1 hr with ⟨v, hv, rfl⟩
  rcases Finset.mem_image.1 hs with ⟨w, hw, rfl⟩
  exact boxSet_disjoint_of_eq_level_of_ne α (by rfl) hrs

theorem measure_children_union (α : Anisotropy) (q : AnisoBox α) :
    volume (⋃ r ∈ boxChildren α q, boxSet α r) =
      ∑ r ∈ boxChildren α q, volume (boxSet α r) := by
  exact MeasureTheory.measure_biUnion_finset
    (pairwiseDisjoint_boxSet_children α q)
    (fun r hr ↦ measurableSet_boxSet α r)

/-- Passing to the parent multiplies the grid mass by the number of
anisotropic children. -/
theorem boxMass_parent (α : Anisotropy) (q : AnisoBox α) :
    boxMass α (boxParent α q) = (2 ^ α.homogeneousDimension : ℝ) * boxMass α q := by
  unfold boxMass boxParent
  have hexp : (q.level + 1) * (α.homogeneousDimension : ℤ) =
      (α.homogeneousDimension : ℤ) + q.level * (α.homogeneousDimension : ℤ) := by
    ring
  rw [hexp, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_natCast]

/-- Each child has the corresponding fraction of its parent's grid mass. -/
theorem boxMass_child_mul_card (α : Anisotropy) (q : AnisoBox α) (v : AnisoDigit α) :
    boxMass α (boxChild α q v) * (2 ^ α.homogeneousDimension : ℝ) = boxMass α q := by
  unfold boxMass boxChild
  have hexp : (q.level - 1) * (α.homogeneousDimension : ℤ) +
      (α.homogeneousDimension : ℤ) = q.level * (α.homogeneousDimension : ℤ) := by
    ring
  rw [← zpow_natCast, ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), hexp]

/-! ### Finite convex trees and scale regions

This is the finite combinatorial form of `def:tree`.  It intentionally keeps
the tree as a `Finset` of literal grid boxes, so every union and boundary sum
in the source remains finite and exact.
-/

/-- A finite collection of anisotropic grid boxes. -/
abbrev BoxCollection (α : Anisotropy) := Finset (AnisoBox α)

/-- Convexity of a finite collection in the grid-inclusion order. -/
def IsConvexCollection (α : Anisotropy) (S : BoxCollection α) : Prop :=
  ∀ ⦃q r w : AnisoBox α⦄, q ∈ S → r ∈ S →
    boxSet α q ⊆ boxSet α w → boxSet α w ⊆ boxSet α r → w ∈ S

/-- A source convex tree: a nonempty finite convex collection together with
its largest (root) box. -/
structure FiniteConvexTree (α : Anisotropy) where
  boxes : BoxCollection α
  nonempty : boxes.Nonempty
  root : AnisoBox α
  root_mem : root ∈ boxes
  convex : IsConvexCollection α boxes
  below_root : ∀ q : AnisoBox α, q ∈ boxes → boxSet α q ⊆ boxSet α root

/-- The boxes of a tree at a literal integer level. -/
def treeAtLevel {α : Anisotropy} (T : FiniteConvexTree α) (k : ℤ) :
    BoxCollection α :=
  T.boxes.filter fun q ↦ q.level = k

/-- The spatial union at one tree level. -/
noncomputable def treeLevelSet {α : Anisotropy} (T : FiniteConvexTree α) (k : ℤ) :
    Set E3 :=
  ⋃ q ∈ treeAtLevel T k, boxSet α q

/-- The leaves are exactly the first children outside the finite tree. -/
def treeLeaves {α : Anisotropy} (T : FiniteConvexTree α) : BoxCollection α :=
  T.boxes.biUnion fun q ↦ (boxChildren α q).filter fun l ↦ l ∉ T.boxes

/-- The upper half-open scale band attached to a box. -/
noncomputable def boxScaleBand (q : AnisoBox α) : Set ℝ :=
  Set.Ioc (boxLength q / 2) (boxLength q)

/-- The box-scale cell in `E_3 × ℝ`. -/
noncomputable def boxScaleRegion (α : Anisotropy) (q : AnisoBox α) : Set (E3 × ℝ) :=
  boxSet α q ×ˢ boxScaleBand q

/-- The source region `Ω_𝒬` for an arbitrary finite collection. -/
noncomputable def collectionRegion (α : Anisotropy) (S : BoxCollection α) : Set (E3 × ℝ) :=
  ⋃ q ∈ S, boxScaleRegion α q

/-- A tree's source region. -/
noncomputable def treeRegion {α : Anisotropy} (T : FiniteConvexTree α) : Set (E3 × ℝ) :=
  collectionRegion α T.boxes

theorem mem_treeAtLevel_iff {α : Anisotropy} (T : FiniteConvexTree α)
    (k : ℤ) (q : AnisoBox α) :
    q ∈ treeAtLevel T k ↔ q ∈ T.boxes ∧ q.level = k := by
  simp [treeAtLevel]

theorem boxChildren_level (α : Anisotropy) {q r : AnisoBox α}
    (hr : r ∈ boxChildren α q) :
    r.level = q.level - 1 := by
  rcases Finset.mem_image.mp hr with ⟨v, _, rfl⟩
  rfl

/-- Literal leaf membership is equivalent to the parent formulation in the
source definition. -/
theorem mem_treeLeaves_iff {α : Anisotropy} (T : FiniteConvexTree α)
    (l : AnisoBox α) :
    l ∈ treeLeaves T ↔ l ∉ T.boxes ∧ boxParent α l ∈ T.boxes := by
  constructor
  · intro hl
    rw [treeLeaves, Finset.mem_biUnion] at hl
    rcases hl with ⟨q, hq, hl⟩
    rw [Finset.mem_filter] at hl
    constructor
    · exact hl.2
    · rcases Finset.mem_image.mp hl.1 with ⟨v, hv, hchild⟩
      subst l
      simpa only [boxParent_child] using hq
  · rintro ⟨hlnot, hlparent⟩
    rw [treeLeaves, Finset.mem_biUnion]
    refine ⟨boxParent α l, hlparent, ?_⟩
    rw [Finset.mem_filter]
    constructor
    · rcases (boxParent_eq_iff_exists_boxChild α (boxParent α l) l).mp rfl with
        ⟨v, hv⟩
      exact Finset.mem_image.mpr ⟨v, Finset.mem_univ _, hv⟩
    · exact hlnot

theorem treeLeaves_not_mem {α : Anisotropy} (T : FiniteConvexTree α)
    {l : AnisoBox α} (hl : l ∈ treeLeaves T) : l ∉ T.boxes :=
  (mem_treeLeaves_iff T l).mp hl |>.1

theorem treeLeaves_parent_mem {α : Anisotropy} (T : FiniteConvexTree α)
    {l : AnisoBox α} (hl : l ∈ treeLeaves T) : boxParent α l ∈ T.boxes :=
  (mem_treeLeaves_iff T l).mp hl |>.2

theorem boxSet_leaf_subset_root {α : Anisotropy} (T : FiniteConvexTree α)
    {l : AnisoBox α} (hl : l ∈ treeLeaves T) :
    boxSet α l ⊆ boxSet α T.root :=
  (boxSet_subset_parent α l).trans (T.below_root _ (treeLeaves_parent_mem T hl))

theorem pairwiseDisjoint_treeAtLevel {α : Anisotropy} (T : FiniteConvexTree α)
    (k : ℤ) :
    (↑(treeAtLevel T k) : Set (AnisoBox α)).PairwiseDisjoint (boxSet α) := by
  intro q hq r hr hne
  have hqlevel : q.level = k := (mem_treeAtLevel_iff T k q).mp hq |>.2
  have hrlevel : r.level = k := (mem_treeAtLevel_iff T k r).mp hr |>.2
  exact boxSet_disjoint_of_eq_level_of_ne α (hqlevel.trans hrlevel.symm) hne

theorem measurableSet_treeLevelSet {α : Anisotropy} (T : FiniteConvexTree α)
    (k : ℤ) : MeasurableSet (treeLevelSet T k) := by
  unfold treeLevelSet
  exact Finset.measurableSet_biUnion (treeAtLevel T k)
    (fun q _ ↦ measurableSet_boxSet α q)

theorem boxLength_le_half_of_level_lt {α : Anisotropy} {q r : AnisoBox α}
    (hlevel : q.level < r.level) : boxLength q ≤ boxLength r / 2 := by
  unfold boxLength
  calc
    (2 : ℝ) ^ q.level ≤ (2 : ℝ) ^ (r.level - 1) :=
      zpow_le_zpow_right₀ (by norm_num) (by omega)
    _ = (2 : ℝ) ^ r.level / 2 := by
      rw [zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0)]
      norm_num

theorem measurableSet_boxScaleRegion (α : Anisotropy) (q : AnisoBox α) :
    MeasurableSet (boxScaleRegion α q) :=
  (measurableSet_boxSet α q).prod measurableSet_Ioc

theorem measurableSet_collectionRegion (α : Anisotropy) (S : BoxCollection α) :
    MeasurableSet (collectionRegion α S) :=
  Finset.measurableSet_biUnion S (fun q _ ↦ measurableSet_boxScaleRegion α q)

/-- Distinct box-scale cells are exactly disjoint, including across levels. -/
theorem boxScaleRegion_disjoint_of_ne (α : Anisotropy) {q r : AnisoBox α}
    (hne : q ≠ r) :
    Disjoint (boxScaleRegion α q) (boxScaleRegion α r) := by
  rcases lt_trichotomy q.level r.level with hlt | heq | hgt
  · apply Set.Disjoint.set_prod_right
    change Disjoint (Set.Ioc (boxLength q / 2) (boxLength q))
      (Set.Ioc (boxLength r / 2) (boxLength r))
    exact Set.Ioc_disjoint_Ioc_of_le (boxLength_le_half_of_level_lt hlt)
  · apply Set.Disjoint.set_prod_left
    exact boxSet_disjoint_of_eq_level_of_ne α heq hne
  · apply Set.Disjoint.set_prod_right
    change Disjoint (Set.Ioc (boxLength q / 2) (boxLength q))
      (Set.Ioc (boxLength r / 2) (boxLength r))
    exact (Set.Ioc_disjoint_Ioc_of_le (boxLength_le_half_of_level_lt hgt)).symm

theorem pairwiseDisjoint_boxScaleRegion (α : Anisotropy) (S : BoxCollection α) :
    (↑S : Set (AnisoBox α)).PairwiseDisjoint (boxScaleRegion α) := by
  intro q hq r hr hne
  exact boxScaleRegion_disjoint_of_ne α hne

theorem measure_collectionRegion (α : Anisotropy) (S : BoxCollection α) :
    volume (collectionRegion α S) = ∑ q ∈ S, volume (boxScaleRegion α q) := by
  exact MeasureTheory.measure_biUnion_finset
    (pairwiseDisjoint_boxScaleRegion α S)
    (fun q hq ↦ measurableSet_boxScaleRegion α q)

/-- Finiteness supplies a first absent child over every point of the root. -/
theorem boxSet_root_subset_leaves_union {α : Anisotropy} (T : FiniteConvexTree α) :
    boxSet α T.root ⊆ ⋃ l ∈ treeLeaves T, boxSet α l := by
  classical
  intro x hx
  let relevant : Finset (AnisoBox α) :=
    T.boxes.filter fun q ↦ x ∈ boxSet α q
  have hrelne : relevant.Nonempty := by
    refine ⟨T.root, Finset.mem_filter.mpr ⟨T.root_mem, hx⟩⟩
  let levels : Finset ℤ := relevant.image AnisoBox.level
  have hlevelsne : levels.Nonempty := hrelne.image AnisoBox.level
  let m : ℤ := levels.min' hlevelsne
  have hm : m ∈ levels := by
    dsimp [m]
    exact Finset.min'_mem levels hlevelsne
  rcases Finset.mem_image.mp hm with ⟨q, hqrel, hqlevel⟩
  have hqT : q ∈ T.boxes := (Finset.mem_filter.mp hqrel).1
  have hxq : x ∈ boxSet α q := (Finset.mem_filter.mp hqrel).2
  have hxchildren : x ∈ ⋃ r ∈ boxChildren α q, boxSet α r := by
    rw [← boxSet_eq_children_union α q]
    exact hxq
  rcases Set.mem_iUnion.1 hxchildren with ⟨r, hr⟩
  rcases Set.mem_iUnion.1 hr with ⟨hrchild, hxr⟩
  have hrnot : r ∉ T.boxes := by
    intro hrT
    have hrrel : r ∈ relevant := Finset.mem_filter.mpr ⟨hrT, hxr⟩
    have hrlevels : r.level ∈ levels := Finset.mem_image.mpr ⟨r, hrrel, rfl⟩
    have hmin := Finset.min'_le levels r.level hrlevels
    have hlevel := boxChildren_level α hrchild
    change m ≤ r.level at hmin
    omega
  have hrleaf : r ∈ treeLeaves T := by
    apply (mem_treeLeaves_iff T r).mpr
    constructor
    · exact hrnot
    · rcases Finset.mem_image.mp hrchild with ⟨v, hv, hr⟩
      subst r
      simpa only [boxParent_child] using hqT
  exact Set.mem_iUnion.2 ⟨r, Set.mem_iUnion.2 ⟨hrleaf, hxr⟩⟩

theorem leaves_union_subset_boxSet_root {α : Anisotropy} (T : FiniteConvexTree α) :
    (⋃ l ∈ treeLeaves T, boxSet α l) ⊆ boxSet α T.root := by
  intro x hx
  rcases Set.mem_iUnion.1 hx with ⟨l, hl⟩
  rcases Set.mem_iUnion.1 hl with ⟨hlleaf, hxl⟩
  exact boxSet_leaf_subset_root T hlleaf hxl

/-- The leaves cover the root exactly; pairwise disjointness is established
separately from convexity below. -/
theorem boxSet_root_eq_leaves_union {α : Anisotropy} (T : FiniteConvexTree α) :
    boxSet α T.root = ⋃ l ∈ treeLeaves T, boxSet α l :=
  Set.Subset.antisymm (boxSet_root_subset_leaves_union T)
    (leaves_union_subset_boxSet_root T)

/-- Convexity excludes nested distinct leaves, so the leaf boxes are pairwise
disjoint exactly (not only almost everywhere). -/
theorem pairwiseDisjoint_boxSet_treeLeaves {α : Anisotropy} (T : FiniteConvexTree α) :
    (↑(treeLeaves T) : Set (AnisoBox α)).PairwiseDisjoint (boxSet α) := by
  intro l hl r hr hne
  apply Set.disjoint_left.2
  intro x hxl hxr
  rcases lt_trichotomy l.level r.level with hlt | heq | hgt
  · have hparentNested : boxSet α (boxParent α l) ⊆ boxSet α r := by
      have hparentLevel : (boxParent α l).level = l.level + 1 := rfl
      apply boxSet_nested_of_inter_nonempty α (by omega)
      exact ⟨x, boxSet_subset_parent α l hxl, hxr⟩
    have hrT : r ∈ T.boxes :=
      T.convex (treeLeaves_parent_mem T hl) (treeLeaves_parent_mem T hr)
        hparentNested (boxSet_subset_parent α r)
    exact (treeLeaves_not_mem T hr) hrT
  · have hdisj := boxSet_disjoint_of_eq_level_of_ne α heq hne
    exact (Set.disjoint_left.1 hdisj) hxl hxr
  · have hparentNested : boxSet α (boxParent α r) ⊆ boxSet α l := by
      have hparentLevel : (boxParent α r).level = r.level + 1 := rfl
      apply boxSet_nested_of_inter_nonempty α (by omega)
      exact ⟨x, boxSet_subset_parent α r hxr, hxl⟩
    have hlT : l ∈ T.boxes :=
      T.convex (treeLeaves_parent_mem T hr) (treeLeaves_parent_mem T hl)
        hparentNested (boxSet_subset_parent α l)
    exact (treeLeaves_not_mem T hl) hlT

theorem measure_leaves_union {α : Anisotropy} (T : FiniteConvexTree α) :
    volume (⋃ l ∈ treeLeaves T, boxSet α l) =
      ∑ l ∈ treeLeaves T, volume (boxSet α l) := by
  exact MeasureTheory.measure_biUnion_finset
    (pairwiseDisjoint_boxSet_treeLeaves T)
    (fun l hl ↦ measurableSet_boxSet α l)

/-- The exact finite leaf-volume partition from `lem:geometry`. -/
theorem volume_root_eq_sum_volume_leaves {α : Anisotropy} (T : FiniteConvexTree α) :
    volume (boxSet α T.root) = ∑ l ∈ treeLeaves T, volume (boxSet α l) := by
  rw [boxSet_root_eq_leaves_union T]
  exact measure_leaves_union T

theorem boxMass_root_eq_sum_boxMass_leaves {α : Anisotropy} (T : FiniteConvexTree α) :
    boxMass α T.root = ∑ l ∈ treeLeaves T, boxMass α l := by
  rw [← volume_boxSet_toReal α T.root, volume_root_eq_sum_volume_leaves]
  rw [ENNReal.toReal_sum (fun l hl ↦ by
    rw [volume_boxSet_eq_boxMass]
    exact ENNReal.ofReal_ne_top)]
  congr with l
  congr 1
  exact volume_boxSet_toReal α l

/-! ### Oriented grid faces

The face layer retains the source's incident-box encoding.  This makes the
surviving-face cancellation later a finite equality of explicitly indexed
objects rather than an informal boundary convention.
-/

/-- The two outward orientations of a coordinate face. -/
inductive FaceOrientation where
  | lower
  | upper
  deriving DecidableEq

instance : Fintype FaceOrientation where
  elems := {FaceOrientation.lower, FaceOrientation.upper}
  complete := by
    intro ε
    cases ε <;> simp

/-- The source sign `ε ∈ {-1,1}`. -/
def FaceOrientation.sign : FaceOrientation → ℤ
  | .lower => -1
  | .upper => 1

/-- The orientation viewed from the adjacent incident box. -/
def FaceOrientation.opposite : FaceOrientation → FaceOrientation
  | .lower => .upper
  | .upper => .lower

@[simp]
theorem FaceOrientation.opposite_opposite (ε : FaceOrientation) :
    ε.opposite.opposite = ε := by
  cases ε <;> rfl

@[simp]
theorem FaceOrientation.sign_opposite (ε : FaceOrientation) :
    ε.opposite.sign = -ε.sign := by
  cases ε <;> rfl

theorem FaceOrientation.opposite_ne (ε : FaceOrientation) : ε.opposite ≠ ε := by
  cases ε <;> decide

/-- The same-level box adjacent across an oriented coordinate face. -/
def boxNeighbor (α : Anisotropy) (q : AnisoBox α) (i : Fin 3)
    (ε : FaceOrientation) : AnisoBox α :=
  ⟨q.level, fun j ↦ if j = i then q.index j + ε.sign else q.index j⟩

theorem boxNeighbor_neighbor_opposite (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) (ε : FaceOrientation) :
    boxNeighbor α (boxNeighbor α q i ε) i ε.opposite = q := by
  cases q with
  | mk level index =>
    rw [AnisoBox.mk.injEq]
    constructor
    · rfl
    · funext j
      by_cases hji : j = i
      · subst j
        cases ε <;> simp [boxNeighbor, FaceOrientation.sign, FaceOrientation.opposite]
      · simp [boxNeighbor, hji]

/-- Dividing two adjacent integer grid indices by a positive radix either
identifies them or leaves them adjacent. -/
theorem int_ediv_add_one_or (a R : ℤ) (hR : 0 < R) :
    (a + 1) / R = a / R ∨ (a + 1) / R = a / R + 1 := by
  have hRne : R ≠ 0 := ne_of_gt hR
  have hlow : a / R ≤ (a + 1) / R := by
    rw [Int.le_ediv_iff_mul_le hR]
    exact (Int.ediv_mul_le a hRne).trans (by omega)
  have hrem : a % R < R := Int.emod_lt_of_pos a hR
  have hdecomp : a % R + a / R * R = a := Int.emod_add_ediv_mul a R
  have hupp : (a + 1) / R ≤ a / R + 1 := by
    rw [Int.ediv_le_iff_le_mul hR]
    rw [show (a / R + 1) * R + R = a / R * R + 2 * R by ring]
    omega
  omega

theorem int_ediv_sub_one_or (a R : ℤ) (hR : 0 < R) :
    (a - 1) / R = a / R ∨ (a - 1) / R = a / R - 1 := by
  rcases int_ediv_add_one_or (a - 1) R hR with h | h
  · left
    simpa only [sub_add_cancel] using h.symm
  · right
    have h' : a / R = (a - 1) / R + 1 := by
      simpa only [sub_add_cancel] using h
    omega

/-- Parent boxes of two adjacent grid boxes either coincide or remain
adjacent.  This integer-dichotomy is the alignment mechanism in the finite
surviving-face packing proof. -/
theorem boxParent_neighbor_eq_or_neighbor (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) (ε : FaceOrientation) :
    boxParent α (boxNeighbor α q i ε) = boxParent α q ∨
      boxParent α (boxNeighbor α q i ε) =
        boxNeighbor α (boxParent α q) i ε := by
  cases q with
  | mk level index =>
    have hR (j : Fin 3) : (0 : ℤ) < (anisoRadix α j : ℤ) := by
      exact_mod_cast anisoRadix_pos α j
    cases ε with
    | lower =>
      rcases int_ediv_sub_one_or (index i) (anisoRadix α i : ℤ) (hR i) with h | h
      · left
        simp only [boxParent, boxNeighbor, AnisoBox.mk.injEq]
        constructor
        · trivial
        · funext j
          by_cases hji : j = i
          · subst j
            simpa [FaceOrientation.sign, sub_eq_add_neg] using h
          · simp [hji]
      · right
        simp only [boxParent, boxNeighbor, AnisoBox.mk.injEq]
        constructor
        · trivial
        · funext j
          by_cases hji : j = i
          · subst j
            simpa [FaceOrientation.sign, sub_eq_add_neg] using h
          · simp [hji]
    | upper =>
      rcases int_ediv_add_one_or (index i) (anisoRadix α i : ℤ) (hR i) with h | h
      · left
        simp only [boxParent, boxNeighbor, AnisoBox.mk.injEq]
        constructor
        · trivial
        · funext j
          by_cases hji : j = i
          · subst j
            simpa [FaceOrientation.sign] using h
          · simp [hji]
      · right
        simp only [boxParent, boxNeighbor, AnisoBox.mk.injEq]
        constructor
        · trivial
        · funext j
          by_cases hji : j = i
          · subst j
            simpa [FaceOrientation.sign] using h
          · simp [hji]

/-- The coordinate position of an oriented face. -/
noncomputable def boxFaceCoordinate (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) : FaceOrientation → ℝ
  | .lower => (q.index i : ℝ) * boxSide α q i
  | .upper => ((q.index i + 1 : ℤ) : ℝ) * boxSide α q i

/-- The lower active endpoint of a literal box does not exceed its upper
endpoint. -/
theorem boxFaceCoordinate_lower_le_upper (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) :
    boxFaceCoordinate α q i FaceOrientation.lower ≤
      boxFaceCoordinate α q i FaceOrientation.upper := by
  unfold boxFaceCoordinate
  apply mul_le_mul_of_nonneg_right _ (boxSide_pos α q i).le
  have hindex : q.index i ≤ q.index i + 1 := by omega
  exact_mod_cast hindex

/-- The spatial closed face, represented in ambient coordinates. -/
noncomputable def boxFaceSet (α : Anisotropy) (q : AnisoBox α) (i : Fin 3)
    (ε : FaceOrientation) : Set E3 :=
  {p | p i = boxFaceCoordinate α q i ε ∧
    ∀ j : Fin 3, j ≠ i →
      p j ∈ Set.Icc ((q.index j : ℝ) * boxSide α q j)
        (((q.index j + 1 : ℤ) : ℝ) * boxSide α q j)}

/-- The closed coordinate interval used on a face.  The spatial boxes remain
half-open; this closed version is only for the face containment argument in
the boundary packing proof. -/
noncomputable def boxClosedInterval (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) : Set ℝ :=
  Set.Icc ((q.index i : ℝ) * boxSide α q i)
    (((q.index i + 1 : ℤ) : ℝ) * boxSide α q i)

/-- The transverse half-open rectangle used as the integration domain of a
face.  It is embedded in ambient coordinates only to keep its indices literal. -/
noncomputable def boxTransverseSet (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) : Set E3 :=
  {p | ∀ j : Fin 3, j ≠ i → p j ∈ boxInterval α q j}

/-- The product of transverse side lengths, i.e. the source coordinate area. -/
noncomputable def boxFaceArea (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) : ℝ :=
  ∏ j ∈ Finset.univ.erase i, boxSide α q j

/-- A finite oriented face is encoded by its incident box and orientation. -/
structure OrientedFace (α : Anisotropy) where
  box : AnisoBox α
  orientation : FaceOrientation
  deriving DecidableEq

/-- The surviving oriented `i`-faces at one tree level. -/
def survivingFaces {α : Anisotropy} (T : FiniteConvexTree α)
    (i : Fin 3) (k : ℤ) : Finset (OrientedFace α) :=
  (((treeAtLevel T k).product Finset.univ).image fun qε ↦
    OrientedFace.mk qε.1 qε.2).filter fun S ↦
      boxNeighbor α S.box i S.orientation ∉ T.boxes

theorem boxNeighbor_level (α : Anisotropy) (q : AnisoBox α) (i : Fin 3)
    (ε : FaceOrientation) : (boxNeighbor α q i ε).level = q.level :=
  rfl

theorem boxNeighbor_index_self (α : Anisotropy) (q : AnisoBox α) (i : Fin 3)
    (ε : FaceOrientation) :
    (boxNeighbor α q i ε).index i = q.index i + ε.sign := by
  simp [boxNeighbor]

theorem boxNeighbor_index_ne (α : Anisotropy) (q : AnisoBox α) {i j : Fin 3}
    (hji : j ≠ i) (ε : FaceOrientation) :
    (boxNeighbor α q i ε).index j = q.index j := by
  simp [boxNeighbor, hji]

theorem boxSide_neighbor (α : Anisotropy) (q : AnisoBox α) (i j : Fin 3)
    (ε : FaceOrientation) :
    boxSide α (boxNeighbor α q i ε) j = boxSide α q j := by
  rfl

theorem boxFaceCoordinate_neighbor_opposite (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) (ε : FaceOrientation) :
    boxFaceCoordinate α q i ε =
      boxFaceCoordinate α (boxNeighbor α q i ε) i ε.opposite := by
  cases ε <;> simp [boxFaceCoordinate, FaceOrientation.opposite,
    FaceOrientation.sign, boxNeighbor, boxSide]
  all_goals ring

/-- In the non-coalescing case of the parent-neighbor dichotomy, the common
normal coordinate is already a face coordinate of the parent. -/
theorem boxFaceCoordinate_eq_parent_of_parent_neighbor
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) (ε : FaceOrientation)
    (h : boxParent α (boxNeighbor α q i ε) =
      boxNeighbor α (boxParent α q) i ε) :
    boxFaceCoordinate α q i ε = boxFaceCoordinate α (boxParent α q) i ε := by
  let R : ℤ := anisoRadix α i
  have hR : (0 : ℤ) < R := by
    dsimp [R]
    exact_mod_cast anisoRadix_pos α i
  have hRne : R ≠ 0 := ne_of_gt hR
  have hi := congrFun (congrArg AnisoBox.index h) i
  cases ε with
  | lower =>
    have hquot : (q.index i - 1) / R = q.index i / R - 1 := by
      simpa [boxParent, boxNeighbor, FaceOrientation.sign, sub_eq_add_neg, R] using hi
    have hlt : q.index i - 1 < q.index i / R * R := by
      have hle : (q.index i - 1) / R ≤ q.index i / R - 1 := by rw [hquot]
      have h' := (Int.ediv_le_iff_le_mul hR).mp hle
      calc
        q.index i - 1 < (q.index i / R - 1) * R + R := h'
        _ = q.index i / R * R := by ring
    have hle : q.index i / R * R ≤ q.index i := Int.ediv_mul_le _ hRne
    have hidx : q.index i = q.index i / R * R := by omega
    have hidxR : (q.index i : ℝ) =
        ((q.index i / R : ℤ) : ℝ) * (R : ℝ) := by exact_mod_cast hidx
    change (q.index i : ℝ) * boxSide α q i =
      (((boxParent α q).index i : ℤ) : ℝ) * boxSide α (boxParent α q) i
    change (q.index i : ℝ) * boxSide α q i =
      ((q.index i / R : ℤ) : ℝ) * boxSide α (boxParent α q) i
    dsimp [R] at hidxR ⊢
    rw [boxSide_parent, hidxR]
    push_cast
    ring
  | upper =>
    have hquot : (q.index i + 1) / R = q.index i / R + 1 := by
      simpa [boxParent, boxNeighbor, FaceOrientation.sign, R] using hi
    have hlow : (q.index i / R + 1) * R ≤ q.index i + 1 := by
      rw [← hquot]
      exact (Int.le_ediv_iff_mul_le hR).mp le_rfl
    have hrem : q.index i % R < R := Int.emod_lt_of_pos _ hR
    have hremnonneg : 0 ≤ q.index i % R := Int.emod_nonneg _ hRne
    have hdecomp : q.index i % R + q.index i / R * R = q.index i :=
      Int.emod_add_ediv_mul _ _
    have hupp : q.index i + 1 ≤ (q.index i / R + 1) * R := by
      rw [show (q.index i / R + 1) * R = q.index i / R * R + R by ring]
      omega
    have hidx : q.index i + 1 = (q.index i / R + 1) * R := by omega
    have hidxR : ((q.index i + 1 : ℤ) : ℝ) =
        ((q.index i / R + 1 : ℤ) : ℝ) * (R : ℝ) := by exact_mod_cast hidx
    change ((q.index i + 1 : ℤ) : ℝ) * boxSide α q i =
      (((boxParent α q).index i + 1 : ℤ) : ℝ) * boxSide α (boxParent α q) i
    change ((q.index i + 1 : ℤ) : ℝ) * boxSide α q i =
      ((q.index i / R + 1 : ℤ) : ℝ) * boxSide α (boxParent α q) i
    dsimp [R] at hidxR ⊢
    rw [boxSide_parent, hidxR]
    push_cast
    ring

/-- A coordinate interval is contained in the corresponding parent interval.
This remains true for negative grid indices because parents use Euclidean
division. -/
theorem boxClosedInterval_subset_parent (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) :
    boxClosedInterval α q i ⊆ boxClosedInterval α (boxParent α q) i := by
  unfold boxClosedInterval
  rw [boxSide_parent]
  simp only [boxParent]
  have hlt : (q.index i : ℝ) < ((q.index i + 1 : ℤ) : ℝ) := by
    have hltZ : q.index i < q.index i + 1 := by omega
    exact_mod_cast hltZ
  have hnonempty : (q.index i : ℝ) * boxSide α q i <
      ((q.index i + 1 : ℤ) : ℝ) * boxSide α q i :=
    mul_lt_mul_of_pos_right hlt (boxSide_pos α q i)
  apply (Set.Icc_subset_Icc_iff hnonempty.le).2
  constructor
  · let R : ℤ := anisoRadix α i
    have hRne : R ≠ 0 := by
      dsimp [R]
      exact_mod_cast (Nat.ne_of_gt (anisoRadix_pos α i))
    have hlowZ : (q.index i / R) * R ≤ q.index i := Int.ediv_mul_le _ hRne
    have hlow : ((q.index i / R : ℤ) : ℝ) * (R : ℝ) ≤ q.index i := by
      exact_mod_cast hlowZ
    change ((q.index i / R : ℤ) : ℝ) * ((R : ℝ) * boxSide α q i) ≤
      (q.index i : ℝ) * boxSide α q i
    rw [← mul_assoc]
    exact mul_le_mul_of_nonneg_right hlow (boxSide_pos α q i).le
  · let R : ℤ := anisoRadix α i
    have hRpos : 0 < R := by
      dsimp [R]
      exact_mod_cast anisoRadix_pos α i
    have hrem : q.index i % R < R := Int.emod_lt_of_pos _ hRpos
    have hdecomp : q.index i % R + R * (q.index i / R) = q.index i :=
      Int.emod_add_mul_ediv _ _
    have huZ : q.index i + 1 ≤ (q.index i / R + 1) * R := by
      calc
        q.index i + 1 = q.index i % R + R * (q.index i / R) + 1 := by rw [hdecomp]
        _ ≤ R * (q.index i / R) + R := by linarith
        _ = (q.index i / R + 1) * R := by ring
    have hu : ((q.index i + 1 : ℤ) : ℝ) ≤
        ((q.index i / R + 1 : ℤ) : ℝ) * (R : ℝ) := by exact_mod_cast huZ
    change ((q.index i + 1 : ℤ) : ℝ) * boxSide α q i ≤
      ((q.index i / R + 1 : ℤ) : ℝ) * ((R : ℝ) * boxSide α q i)
    rw [← mul_assoc]
    exact mul_le_mul_of_nonneg_right hu (boxSide_pos α q i).le

/-- A surviving face whose neighbor remains a neighbor after coarsening is
contained in the corresponding parent face. -/
theorem boxFaceSet_subset_parent_of_parent_neighbor
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) (ε : FaceOrientation)
    (h : boxParent α (boxNeighbor α q i ε) =
      boxNeighbor α (boxParent α q) i ε) :
    boxFaceSet α q i ε ⊆ boxFaceSet α (boxParent α q) i ε := by
  intro p hp
  rcases hp with ⟨hpcoord, hptrans⟩
  refine ⟨?_, ?_⟩
  · rw [← boxFaceCoordinate_eq_parent_of_parent_neighbor α q i ε h]
    exact hpcoord
  · intro j hji
    have hj := boxClosedInterval_subset_parent α q j (hptrans j hji)
    simpa [boxClosedInterval] using hj

theorem boxInterval_neighbor_eq_of_ne (α : Anisotropy) (q : AnisoBox α)
    {i j : Fin 3} (hji : j ≠ i) (ε : FaceOrientation) :
    boxInterval α (boxNeighbor α q i ε) j = boxInterval α q j := by
  unfold boxInterval
  rw [boxNeighbor_index_ne α q hji ε, boxSide_neighbor]

theorem boxFaceArea_mul_boxSide (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    boxFaceArea α q i * boxSide α q i = boxMass α q := by
  unfold boxFaceArea
  rw [Finset.prod_erase_mul]
  · exact prod_boxSide_eq_boxMass α q
  · simp

/-- The source face-area exponent `k(A-α_i)`. -/
theorem boxFaceArea_eq_source (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    boxFaceArea α q i =
      (2 : ℝ) ^ (q.level * ((α.homogeneousDimension - α.weight i : ℕ) : ℤ)) := by
  have hweight : α.weight i ≤ α.homogeneousDimension :=
    Finset.single_le_sum (fun j _ ↦ Nat.zero_le _) (Finset.mem_univ i)
  have hsumNat : α.homogeneousDimension - α.weight i + α.weight i =
      α.homogeneousDimension := Nat.sub_add_cancel hweight
  have hsumInt :
      ((α.homogeneousDimension - α.weight i : ℕ) : ℤ) + (α.weight i : ℤ) =
        (α.homogeneousDimension : ℤ) := by
    exact_mod_cast hsumNat
  apply mul_right_cancel₀ (boxSide_pos α q i).ne'
  rw [boxFaceArea_mul_boxSide]
  unfold boxSide boxMass
  rw [← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
  congr 1
  rw [← mul_add, hsumInt]

/-- The literal two-coordinate Euclidean space transverse to `i`. -/
abbrev TransverseSpace (i : Fin 3) := EuclideanSpace ℝ {j : Fin 3 // j ≠ i}

/-- The half-open transverse rectangle `R_S`, now in its actual coordinate
plane rather than as an ambient three-dimensional set. -/
noncomputable def transverseRectangle (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) : Set (TransverseSpace i) :=
  Set.preimage (WithLp.ofLp : TransverseSpace i → {j : Fin 3 // j ≠ i} → ℝ)
    (Set.pi Set.univ fun j ↦ boxInterval α q j.1)

/-- Coordinate two-dimensional area of a transverse rectangle. -/
noncomputable def transverseArea (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) : ℝ :=
  ∏ j : {m : Fin 3 // m ≠ i}, boxSide α q j.1

/-- Insert a transverse point into the affine coordinate plane whose
`i`-th coordinate is `c`. -/
noncomputable def faceInsert (i : Fin 3) (c : ℝ) : TransverseSpace i → E3 :=
  fun y ↦ WithLp.toLp 2 fun j ↦ if h : j = i then c else y ⟨j, h⟩

@[simp]
theorem faceInsert_apply (i : Fin 3) (c : ℝ) (y : TransverseSpace i)
    (j : Fin 3) :
    faceInsert i c y j = if h : j = i then c else y ⟨j, h⟩ := by
  simp [faceInsert]

theorem faceInsert_injective (i : Fin 3) (c : ℝ) :
    Function.Injective (faceInsert i c) := by
  intro y z hyz
  ext j
  have hj := congrArg (fun w : E3 ↦ w j.1) hyz
  simpa [faceInsert, j.2] using hj

theorem faceInsert_continuous (i : Fin 3) (c : ℝ) :
    Continuous (faceInsert i c) := by
  apply (PiLp.continuous_toLp 2 _).comp
  rw [continuous_pi_iff]
  intro j
  by_cases hji : j = i
  · simpa [faceInsert, hji] using
      (continuous_const : Continuous fun _ : TransverseSpace i ↦ c)
  · simpa [faceInsert, hji] using
      (PiLp.continuous_apply (p := 2)
        (β := fun _ : {m : Fin 3 // m ≠ i} ↦ ℝ) ⟨j, hji⟩)

theorem faceInsert_measurableEmbedding (i : Fin 3) (c : ℝ) :
    MeasurableEmbedding (faceInsert i c) :=
  (faceInsert_continuous i c).measurableEmbedding (faceInsert_injective i c)

/-- Coordinate two-dimensional Lebesgue measure on the affine `i`-face at
height `c`, realized as a pushforward. -/
noncomputable def faceCoordinateMeasure (i : Fin 3) (c : ℝ) : Measure E3 :=
  Measure.map (faceInsert i c) volume

theorem measurableSet_transverseRectangle (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) : MeasurableSet (transverseRectangle α q i) := by
  unfold transverseRectangle
  apply (PiLp.volume_preserving_ofLp {j : Fin 3 // j ≠ i}).measurable
  apply MeasurableSet.pi Set.countable_univ
  intro j _
  exact measurableSet_Ico

/-- The ordered two-element index set obtained by deleting the active
coordinate.  It is used only to transport the standard finite-product
Lebesgue measure to the literal transverse coordinate type. -/
def transverseIndexEquiv (i : Fin 3) : Fin 2 ≃ {j : Fin 3 // j ≠ i} :=
  Equiv.ofBijective (fun k ↦ ⟨i.succAbove k, Fin.succAbove_ne i k⟩) ⟨
    (fun k l h ↦ i.succAbove_right_injective (congrArg Subtype.val h)), by
      intro j
      rcases Fin.exists_succAbove_eq j.2 with ⟨k, hk⟩
      exact ⟨k, Subtype.ext hk⟩⟩

/-- Split an ambient point into its active real coordinate and its literal
two-dimensional transverse point. -/
noncomputable def coordinateSplit (i : Fin 3) : E3 → ℝ × TransverseSpace i :=
  fun p ↦ (p i, WithLp.toLp 2 fun j ↦ p j.1)

/-- Reassemble active and transverse coordinates into an ambient point. -/
noncomputable def coordinateJoin (i : Fin 3) : ℝ × TransverseSpace i → E3 :=
  fun z ↦ faceInsert i z.1 z.2

@[simp]
theorem coordinateJoin_split (i : Fin 3) (p : E3) :
    coordinateJoin i (coordinateSplit i p) = p := by
  ext j
  by_cases hji : j = i
  · subst j
    simp [coordinateJoin, coordinateSplit, faceInsert]
  · simp [coordinateJoin, coordinateSplit, faceInsert, hji]

@[simp]
theorem coordinateSplit_join (i : Fin 3) (z : ℝ × TransverseSpace i) :
    coordinateSplit i (coordinateJoin i z) = z := by
  apply Prod.ext
  · simp [coordinateJoin, coordinateSplit, faceInsert]
  · ext j
    simp [coordinateJoin, coordinateSplit, faceInsert, j.2]

@[simp]
theorem coordinateSplit_faceInsert (i : Fin 3) (u : ℝ)
    (y : TransverseSpace i) :
    coordinateSplit i (faceInsert i u y) = (u, y) := by
  change coordinateSplit i (coordinateJoin i (u, y)) = (u, y)
  exact coordinateSplit_join i (u, y)

theorem coordinateSplit_mem_box_product_iff
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) (p : E3) :
    coordinateSplit i p ∈
      boxInterval α q i ×ˢ transverseRectangle α q i ↔ p ∈ boxSet α q := by
  constructor
  · rintro ⟨hp, hy⟩
    rw [boxSet, Set.mem_preimage, Set.mem_pi]
    intro j _
    by_cases hji : j = i
    · subst j
      exact hp
    · rw [transverseRectangle, Set.mem_preimage, Set.mem_pi] at hy
      simpa [coordinateSplit] using hy ⟨j, hji⟩ (Set.mem_univ _)
  · intro hp
    rw [boxSet, Set.mem_preimage, Set.mem_pi] at hp
    constructor
    · exact hp i (Set.mem_univ _)
    · rw [transverseRectangle, Set.mem_preimage, Set.mem_pi]
      intro j _
      simpa [coordinateSplit] using hp j.1 (Set.mem_univ _)

theorem coordinateSplit_preimage_box_product
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    coordinateSplit i ⁻¹'
      (boxInterval α q i ×ˢ transverseRectangle α q i) = boxSet α q := by
  ext p
  exact coordinateSplit_mem_box_product_iff α q i p

private noncomputable def coordinateSplitAux (i : Fin 3) :
    E3 → ℝ × TransverseSpace i :=
  fun p ↦
    let z := MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 ↦ ℝ) i (WithLp.ofLp p)
    (z.1, WithLp.toLp 2
      (MeasurableEquiv.piCongrLeft (fun _ : {j : Fin 3 // j ≠ i} ↦ ℝ)
        (transverseIndexEquiv i) z.2))

private theorem coordinateSplitAux_eq (i : Fin 3) :
    coordinateSplitAux i = coordinateSplit i := by
  funext p
  apply Prod.ext
  · change ((Fin.insertNthEquiv (fun _ : Fin 3 ↦ ℝ) i).symm (WithLp.ofLp p)).1 = p i
    rfl
  · ext j
    let e := transverseIndexEquiv i
    have he : i.succAbove (e.symm j) = j.1 := by
      change (e (e.symm j)).1 = j.1
      exact congrArg Subtype.val (e.apply_symm_apply j)
    change (e.piCongrLeft (fun _ : {j : Fin 3 // j ≠ i} ↦ ℝ)
      ((Fin.insertNthEquiv (fun _ : Fin 3 ↦ ℝ) i).symm (WithLp.ofLp p)).2) j = p j.1
    rw [Equiv.piCongrLeft_apply]
    have hz : ((Fin.insertNthEquiv (fun _ : Fin 3 ↦ ℝ) i).symm
        (WithLp.ofLp p)).2 (e.symm j) = p (i.succAbove (e.symm j)) := rfl
    simpa [he] using hz

/-- The coordinate split preserves Lebesgue measure.  The proof is the
standard finite-product decomposition, with the final reindexing expressed
through `transverseIndexEquiv`. -/
theorem coordinateSplit_measurePreserving (i : Fin 3) :
    MeasurePreserving (coordinateSplit i) volume volume := by
  have h0 : MeasurePreserving (WithLp.ofLp : E3 → Fin 3 → ℝ) volume volume :=
    PiLp.volume_preserving_ofLp (Fin 3)
  have h1 : MeasurePreserving
      (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 ↦ ℝ) i) volume volume :=
    volume_preserving_piFinSuccAbove (fun _ : Fin 3 ↦ ℝ) i
  have hreindex : MeasurePreserving
      (MeasurableEquiv.piCongrLeft (fun _ : {j : Fin 3 // j ≠ i} ↦ ℝ)
        (transverseIndexEquiv i)) volume volume :=
    volume_measurePreserving_piCongrLeft (fun _ : {j : Fin 3 // j ≠ i} ↦ ℝ)
      (transverseIndexEquiv i)
  have hright : MeasurePreserving
      (WithLp.toLp 2 : ({j : Fin 3 // j ≠ i} → ℝ) → TransverseSpace i)
      volume volume :=
    PiLp.volume_preserving_toLp {j : Fin 3 // j ≠ i}
  have hid : MeasurePreserving (id : ℝ → ℝ) volume volume :=
    MeasurePreserving.id volume
  have h2 := hid.prod hreindex
  have h3 := hid.prod hright
  have h := h3.comp (h2.comp (h1.comp h0))
  rw [Measure.volume_eq_prod]
  convert h using 1
  · rfl
  · exact (coordinateSplitAux_eq i).symm

theorem coordinateJoin_continuous (i : Fin 3) :
    Continuous (coordinateJoin i) := by
  apply (PiLp.continuous_toLp 2 _).comp
  rw [continuous_pi_iff]
  intro j
  by_cases hji : j = i
  · subst j
    simpa [coordinateJoin, faceInsert] using
      (continuous_fst : Continuous fun z : ℝ × TransverseSpace i ↦ z.1)
  · have hcont := (PiLp.continuous_apply (p := 2)
        (β := fun _ : {m : Fin 3 // m ≠ i} ↦ ℝ) ⟨j, hji⟩).comp
          (continuous_snd : Continuous fun z : ℝ × TransverseSpace i ↦ z.2)
    convert hcont using 1
    funext z
    simp [hji]

/-- The measure-preserving measurable equivalence used to apply Fubini in
one box coordinate. -/
noncomputable def coordinateSplitEquiv (i : Fin 3) :
    E3 ≃ᵐ ℝ × TransverseSpace i where
  toEquiv :=
    { toFun := coordinateSplit i
      invFun := coordinateJoin i
      left_inv := coordinateJoin_split i
      right_inv := coordinateSplit_join i }
  measurable_toFun := (coordinateSplit_measurePreserving i).measurable
  measurable_invFun := (coordinateJoin_continuous i).measurable

@[simp]
theorem coordinateSplitEquiv_apply (i : Fin 3) (p : E3) :
    coordinateSplitEquiv i p = coordinateSplit i p := rfl

@[simp]
theorem coordinateSplitEquiv_symm_apply
    (i : Fin 3) (z : ℝ × TransverseSpace i) :
    (coordinateSplitEquiv i).symm z = coordinateJoin i z := rfl

theorem coordinateSplitEquiv_measurePreserving (i : Fin 3) :
    MeasurePreserving (coordinateSplitEquiv i) volume volume :=
  coordinateSplit_measurePreserving i

theorem measurableSet_coordinateBoxProduct
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    MeasurableSet (boxInterval α q i ×ˢ transverseRectangle α q i) := by
  apply MeasurableSet.prod
  · exact measurableSet_Ico
  · exact measurableSet_transverseRectangle α q i

/-- Exact Fubini transport of a box integral into its active and transverse
coordinates. -/
theorem integral_boxSet_coordinateSplit
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) (f : E3 → ℝ) :
    ∫ p in boxSet α q, f p =
      ∫ z in boxInterval α q i ×ˢ transverseRectangle α q i,
        f ((coordinateSplitEquiv i).symm z) := by
  let A : Set (ℝ × TransverseSpace i) :=
    boxInterval α q i ×ˢ transverseRectangle α q i
  let g : ℝ × TransverseSpace i → ℝ :=
    A.indicator (fun z ↦ f ((coordinateSplitEquiv i).symm z))
  have hA : MeasurableSet A := by
    exact measurableSet_coordinateBoxProduct α q i
  have hfactor (p : E3) : coordinateSplitEquiv i p ∈ A ↔ p ∈ boxSet α q := by
    simpa [A] using coordinateSplit_mem_box_product_iff α q i p
  calc
    ∫ p in boxSet α q, f p = ∫ p, (boxSet α q).indicator f p :=
      (integral_indicator (measurableSet_boxSet α q)).symm
    _ = ∫ p, g (coordinateSplitEquiv i p) := by
      apply integral_congr_ae
      filter_upwards [] with p
      dsimp [g]
      by_cases hp : p ∈ boxSet α q
      · have hpA : coordinateSplit i p ∈ A := by
          simpa using (hfactor p).mpr hp
        rw [Set.indicator_of_mem hp, Set.indicator_of_mem hpA]
        simp
      · have hpA : coordinateSplit i p ∉ A := by
          intro h
          apply hp
          exact (hfactor p).mp (by simpa using h)
        rw [Set.indicator_of_notMem hp, Set.indicator_of_notMem hpA]
    _ = ∫ z, g z :=
      (coordinateSplitEquiv_measurePreserving i).integral_comp' g
    _ = ∫ z in boxInterval α q i ×ˢ transverseRectangle α q i,
        f ((coordinateSplitEquiv i).symm z) := by
      exact integral_indicator hA

/-- Fubini's formula in literal active/transverse coordinates on one box.
The integrability hypothesis is exactly the source local-integrability
requirement; no null-boundary convention is hidden in this statement. -/
theorem integral_boxSet_eq_integral_transverse_interval
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) (f : E3 → ℝ)
    (hf : IntegrableOn f (boxSet α q)) :
    ∫ p in boxSet α q, f p =
      ∫ y in transverseRectangle α q i,
        ∫ u in boxInterval α q i, f (faceInsert i u y) := by
  let A : Set (ℝ × TransverseSpace i) :=
    boxInterval α q i ×ˢ transverseRectangle α q i
  let g : ℝ × TransverseSpace i → ℝ :=
    fun z ↦ f ((coordinateSplitEquiv i).symm z)
  have htransport : IntegrableOn g A := by
    apply (coordinateSplitEquiv_measurePreserving i).integrableOn_comp_preimage
      (coordinateSplitEquiv i).measurableEmbedding |>.mp
    have hcomp : g ∘ coordinateSplitEquiv i = f := by
      funext p
      simp [g]
    have hpre : (coordinateSplitEquiv i) ⁻¹' A = boxSet α q := by
      ext p
      change coordinateSplit i p ∈
        boxInterval α q i ×ˢ transverseRectangle α q i ↔ p ∈ boxSet α q
      exact coordinateSplit_mem_box_product_iff α q i p
    rw [hcomp, hpre]
    exact hf
  have htransport' : IntegrableOn g A
      ((volume : Measure ℝ).prod (volume : Measure (TransverseSpace i))) := by
    simpa only [Measure.volume_eq_prod] using htransport
  have hfirst :
      (∫ z in A, g z ∂((volume : Measure ℝ).prod
        (volume : Measure (TransverseSpace i)))) =
        ∫ u in boxInterval α q i,
          ∫ y in transverseRectangle α q i, g (u, y) :=
    MeasureTheory.setIntegral_prod g htransport'
  have hswap : Integrable g
      ((volume.restrict (boxInterval α q i)).prod
        (volume.restrict (transverseRectangle α q i))) := by
    simpa only [IntegrableOn, A, ← Measure.prod_restrict] using htransport'
  have hswap' : Integrable (Function.uncurry fun u y ↦ g (u, y))
      ((volume.restrict (boxInterval α q i)).prod
        (volume.restrict (transverseRectangle α q i))) := by
    refine Integrable.congr hswap (Filter.Eventually.of_forall ?_)
    rintro ⟨u, y⟩
    rfl
  calc
    ∫ p in boxSet α q, f p = ∫ z in A, g z := by
      simpa only [A, g] using integral_boxSet_coordinateSplit α q i f
    _ = ∫ u in boxInterval α q i,
          ∫ y in transverseRectangle α q i, g (u, y) := by
      rw [Measure.volume_eq_prod]
      exact hfirst
    _ = ∫ y in transverseRectangle α q i,
          ∫ u in boxInterval α q i, g (u, y) :=
      MeasureTheory.integral_integral_swap hswap'
    _ = _ := by
      simp only [g, coordinateSplitEquiv_symm_apply, coordinateJoin]

/-- The Fubini section of an integrable box function is integrable on the
transverse rectangle.  This is the hypothesis needed when the one-dimensional
telescoping identity is integrated across the inactive coordinates. -/
theorem integrable_outer_integral_boxInterval_of_integrableOn
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) (f : E3 → ℝ)
    (hf : IntegrableOn f (boxSet α q)) :
    Integrable (fun y : TransverseSpace i ↦
      ∫ u in boxInterval α q i, f (faceInsert i u y))
      (volume.restrict (transverseRectangle α q i)) := by
  let A : Set (ℝ × TransverseSpace i) :=
    boxInterval α q i ×ˢ transverseRectangle α q i
  let g : ℝ × TransverseSpace i → ℝ :=
    fun z ↦ f ((coordinateSplitEquiv i).symm z)
  have htransport : IntegrableOn g A := by
    apply (coordinateSplitEquiv_measurePreserving i).integrableOn_comp_preimage
      (coordinateSplitEquiv i).measurableEmbedding |>.mp
    have hcomp : g ∘ coordinateSplitEquiv i = f := by
      funext p
      simp [g]
    have hpre : (coordinateSplitEquiv i) ⁻¹' A = boxSet α q := by
      ext p
      change coordinateSplit i p ∈
        boxInterval α q i ×ˢ transverseRectangle α q i ↔ p ∈ boxSet α q
      exact coordinateSplit_mem_box_product_iff α q i p
    rw [hcomp, hpre]
    exact hf
  have htransport' : IntegrableOn g A
      ((volume : Measure ℝ).prod (volume : Measure (TransverseSpace i))) := by
    simpa only [Measure.volume_eq_prod] using htransport
  have hswap : Integrable g
      ((volume.restrict (boxInterval α q i)).prod
        (volume.restrict (transverseRectangle α q i))) := by
    simpa only [IntegrableOn, A, ← Measure.prod_restrict] using htransport'
  have hswap' : Integrable (Function.uncurry fun u y ↦ g (u, y))
      ((volume.restrict (boxInterval α q i)).prod
        (volume.restrict (transverseRectangle α q i))) := by
    refine Integrable.congr hswap (Filter.Eventually.of_forall ?_)
    rintro ⟨u, y⟩
    rfl
  convert hswap'.integral_prod_right using 1
  funext y
  congr 1

theorem volume_transverseRectangle (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) :
    volume (transverseRectangle α q i) =
      ∏ j : {m : Fin 3 // m ≠ i}, ENNReal.ofReal (boxSide α q j.1) := by
  let lo : {j : Fin 3 // j ≠ i} → ℝ := fun j ↦
    (q.index j.1 : ℝ) * boxSide α q j.1
  let hi : {j : Fin 3 // j ≠ i} → ℝ := fun j ↦
    ((q.index j.1 + 1 : ℤ) : ℝ) * boxSide α q j.1
  have hmeas : MeasurableSet (Set.pi Set.univ fun j ↦ Set.Ico (lo j) (hi j)) := by
    apply MeasurableSet.pi Set.countable_univ
    intro j _
    exact measurableSet_Ico
  change volume ((WithLp.ofLp : TransverseSpace i → {j : Fin 3 // j ≠ i} → ℝ) ⁻¹'
      Set.pi Set.univ (fun j ↦ Set.Ico (lo j) (hi j))) = _
  rw [(PiLp.volume_preserving_ofLp {j : Fin 3 // j ≠ i}).measure_preimage
    hmeas.nullMeasurableSet]
  rw [Real.volume_pi_Ico]
  congr with j
  congr 1
  dsimp [lo, hi]
  push_cast
  ring

theorem volume_transverseRectangle_toReal (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) :
    (volume (transverseRectangle α q i)).toReal = transverseArea α q i := by
  rw [volume_transverseRectangle, ENNReal.toReal_prod]
  simp_rw [ENNReal.toReal_ofReal (boxSide_pos α q _).le]
  rfl

/-- The pushed-forward face measure gives the half-open transverse rectangle
exactly its coordinate area.  This is the measure convention stipulated in
`def:faces`, not ambient three-dimensional volume. -/
theorem faceCoordinateMeasure_transverseRectangle (α : Anisotropy)
    (q : AnisoBox α) (i : Fin 3) (c : ℝ) :
    faceCoordinateMeasure i c (faceInsert i c '' transverseRectangle α q i) =
      volume (transverseRectangle α q i) := by
  unfold faceCoordinateMeasure
  rw [Measure.map_apply (faceInsert_measurableEmbedding i c).measurable
    ((faceInsert_measurableEmbedding i c).measurableSet_image.mpr
      (measurableSet_transverseRectangle α q i))]
  rw [Set.preimage_image_eq _ (faceInsert_injective i c)]

theorem faceCoordinateMeasure_transverseArea (α : Anisotropy)
    (q : AnisoBox α) (i : Fin 3) (c : ℝ) :
    (faceCoordinateMeasure i c
      (faceInsert i c '' transverseRectangle α q i)).toReal =
        transverseArea α q i := by
  rw [faceCoordinateMeasure_transverseRectangle]
  exact volume_transverseRectangle_toReal α q i

/-- The half-open coordinate rectangle is contained in the source's closed
ambient face.  Thus the pushforward measure above realizes precisely the
face integral convention while the closed face remains available for boundary
containment statements. -/
theorem faceInsert_transverseRectangle_subset_boxFaceSet (α : Anisotropy)
    (q : AnisoBox α) (i : Fin 3) (ε : FaceOrientation) :
    faceInsert i (boxFaceCoordinate α q i ε) '' transverseRectangle α q i ⊆
      boxFaceSet α q i ε := by
  intro x hx
  rcases hx with ⟨y, hy, rfl⟩
  rw [boxFaceSet]
  constructor
  · simp [faceInsert]
  · intro j hji
    rw [transverseRectangle, Set.mem_preimage, Set.mem_pi] at hy
    have hyj := hy ⟨j, hji⟩ (Set.mem_univ _)
    rw [boxInterval] at hyj
    simp only [faceInsert_apply, dif_neg hji]
    exact ⟨hyj.1, le_of_lt hyj.2⟩

def transverseDimension (α : Anisotropy) (i : Fin 3) : ℤ :=
  (α.homogeneousDimension : ℤ) - (α.weight i : ℤ)

theorem transverseArea_eq_zpow (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    transverseArea α q i = (2 : ℝ) ^ (q.level * transverseDimension α i) := by
  apply mul_right_cancel₀ (ne_of_gt (boxSide_pos α q i))
  unfold transverseArea
  rw [← Finset.prod_subtype (Finset.univ.erase i) (by simp)
    (fun j : Fin 3 ↦ boxSide α q j)]
  rw [Finset.prod_erase_mul Finset.univ (fun j : Fin 3 ↦ boxSide α q j)
    (Finset.mem_univ i)]
  rw [prod_boxSide_eq_boxMass]
  unfold boxMass boxSide transverseDimension
  rw [← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
  congr 1
  ring

theorem mem_survivingFaces_iff {α : Anisotropy} (T : FiniteConvexTree α)
    (i : Fin 3) (k : ℤ) (S : OrientedFace α) :
    S ∈ survivingFaces T i k ↔ S.box ∈ treeAtLevel T k ∧
      boxNeighbor α S.box i S.orientation ∉ T.boxes := by
  constructor
  · intro h
    unfold survivingFaces at h
    rcases Finset.mem_filter.mp h with ⟨himage, hneighbor⟩
    rcases Finset.mem_image.mp himage with ⟨qε, hqε, hEq⟩
    rcases qε with ⟨q, ε⟩
    cases hEq
    exact ⟨by simpa using hqε, hneighbor⟩
  · rintro ⟨hbox, hneighbor⟩
    unfold survivingFaces
    apply Finset.mem_filter.mpr
    refine ⟨Finset.mem_image.mpr ?_, hneighbor⟩
    refine ⟨(S.box, S.orientation), ?_, ?_⟩
    · simpa using hbox
    · cases S
      rfl

/-- Both orientations incident to one literal grid box. -/
def orientedFacesOfBox {α : Anisotropy} (q : AnisoBox α) :
    Finset (OrientedFace α) :=
  Finset.univ.image fun ε ↦ ⟨q, ε⟩

theorem mem_orientedFacesOfBox_iff {α : Anisotropy} (q : AnisoBox α)
    (S : OrientedFace α) :
    S ∈ orientedFacesOfBox q ↔ S.box = q := by
  constructor
  · intro h
    change S ∈ Finset.univ.image (fun ε ↦ OrientedFace.mk q ε) at h
    rcases Finset.mem_image.mp h with ⟨ε, hε, hEq⟩
    simpa [← hEq]
  · intro hS
    refine Finset.mem_image.mpr ⟨S.orientation, Finset.mem_univ _, ?_⟩
    cases S
    simp_all

/-- The other incident oriented record for the same geometric grid face. -/
def oppositeOrientedFace (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) : OrientedFace α :=
  ⟨boxNeighbor α S.box i S.orientation, S.orientation.opposite⟩

@[simp]
theorem oppositeOrientedFace_orientation (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) : (oppositeOrientedFace α i S).orientation = S.orientation.opposite :=
  rfl

@[simp]
theorem oppositeOrientedFace_box (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) : (oppositeOrientedFace α i S).box =
      boxNeighbor α S.box i S.orientation :=
  rfl

@[simp]
theorem oppositeOrientedFace_involutive (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) : oppositeOrientedFace α i (oppositeOrientedFace α i S) = S := by
  cases S with
  | mk q ε =>
    simp only [oppositeOrientedFace, OrientedFace.mk.injEq,
      FaceOrientation.opposite_opposite]
    exact ⟨boxNeighbor_neighbor_opposite α q i ε, trivial⟩

theorem oppositeOrientedFace_ne (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) : oppositeOrientedFace α i S ≠ S := by
  intro h
  have horient := congrArg OrientedFace.orientation h
  exact S.orientation.opposite_ne (by simpa using horient)

/-- All oriented records incident to the boxes of a finite tree. -/
def treeOrientedFaces {α : Anisotropy} (T : FiniteConvexTree α) :
    Finset (OrientedFace α) :=
  T.boxes.biUnion orientedFacesOfBox

theorem mem_treeOrientedFaces_iff {α : Anisotropy} (T : FiniteConvexTree α)
    (S : OrientedFace α) :
    S ∈ treeOrientedFaces T ↔ S.box ∈ T.boxes := by
  constructor
  · intro h
    rcases Finset.mem_biUnion.mp h with ⟨q, hq, hS⟩
    exact (mem_orientedFacesOfBox_iff q S).mp hS ▸ hq
  · intro h
    exact Finset.mem_biUnion.mpr ⟨S.box, h,
      (mem_orientedFacesOfBox_iff S.box S).mpr rfl⟩

/-- All surviving faces, represented by one finite collection rather than an
infinite sum over integer levels.  This is precisely the finite support of
the source packing sum. -/
def survivingFacesAll {α : Anisotropy} (T : FiniteConvexTree α)
    (i : Fin 3) : Finset (OrientedFace α) :=
  T.boxes.biUnion fun q ↦
    (orientedFacesOfBox q).filter fun S ↦
      boxNeighbor α S.box i S.orientation ∉ T.boxes

theorem survivingFacesAll_eq_filter_treeOrientedFaces {α : Anisotropy}
    (T : FiniteConvexTree α) (i : Fin 3) :
    survivingFacesAll T i =
      (treeOrientedFaces T).filter fun S ↦
        boxNeighbor α S.box i S.orientation ∉ T.boxes := by
  ext S
  constructor
  · intro h
    rcases Finset.mem_biUnion.mp h with ⟨q, hq, hS⟩
    rcases Finset.mem_filter.mp hS with ⟨hface, hout⟩
    apply Finset.mem_filter.mpr
    refine ⟨(mem_treeOrientedFaces_iff T S).mpr ?_, hout⟩
    exact (mem_orientedFacesOfBox_iff q S).mp hface ▸ hq
  · intro h
    rcases Finset.mem_filter.mp h with ⟨htree, hout⟩
    have hbox : S.box ∈ T.boxes := (mem_treeOrientedFaces_iff T S).mp htree
    refine Finset.mem_biUnion.mpr ⟨S.box, hbox, ?_⟩
    exact Finset.mem_filter.mpr
      ⟨(mem_orientedFacesOfBox_iff S.box S).mpr rfl, hout⟩

/-- The complementary, paired face records whose two incident boxes are both
in the tree. -/
def interiorFacesAll {α : Anisotropy} (T : FiniteConvexTree α)
    (i : Fin 3) : Finset (OrientedFace α) :=
  (treeOrientedFaces T).filter fun S ↦
    boxNeighbor α S.box i S.orientation ∈ T.boxes

theorem mem_interiorFacesAll_iff {α : Anisotropy} (T : FiniteConvexTree α)
    (i : Fin 3) (S : OrientedFace α) :
    S ∈ interiorFacesAll T i ↔ S.box ∈ T.boxes ∧
      boxNeighbor α S.box i S.orientation ∈ T.boxes := by
  simp only [interiorFacesAll, Finset.mem_filter, mem_treeOrientedFaces_iff]

/-- The two oriented records of an interior grid face are both interior. -/
theorem mem_interiorFacesAll_opposite {α : Anisotropy} (T : FiniteConvexTree α)
    (i : Fin 3) (S : OrientedFace α) :
    oppositeOrientedFace α i S ∈ interiorFacesAll T i ↔ S ∈ interiorFacesAll T i := by
  constructor
  · intro h
    rcases (mem_interiorFacesAll_iff T i (oppositeOrientedFace α i S)).mp h with
      ⟨hbox, hneighbor⟩
    apply (mem_interiorFacesAll_iff T i S).mpr
    constructor
    · simpa only [oppositeOrientedFace_box, oppositeOrientedFace_orientation,
        boxNeighbor_neighbor_opposite] using hneighbor
    · simpa only [oppositeOrientedFace_box] using hbox
  · intro h
    rcases (mem_interiorFacesAll_iff T i S).mp h with ⟨hbox, hneighbor⟩
    apply (mem_interiorFacesAll_iff T i (oppositeOrientedFace α i S)).mpr
    constructor
    · simpa only [oppositeOrientedFace_box] using hneighbor
    · simpa only [oppositeOrientedFace_box, oppositeOrientedFace_orientation,
        boxNeighbor_neighbor_opposite] using hbox

/-- Any anti-symmetric quantity cancels on the paired interior face records. -/
theorem sum_interiorFacesAll_eq_zero_of_opposite
    {α : Anisotropy} {G : Type*} [AddCommGroup G]
    (T : FiniteConvexTree α) (i : Fin 3) (f : OrientedFace α → G)
    (hanti : ∀ S, f S + f (oppositeOrientedFace α i S) = 0) :
    ∑ S ∈ interiorFacesAll T i, f S = 0 := by
  apply Finset.sum_involution (fun S _ ↦ oppositeOrientedFace α i S)
  · intro S hS
    exact hanti S
  · intro S hS hnonzero hEq
    exact oppositeOrientedFace_ne α i S hEq
  · intro S hS
    exact (mem_interiorFacesAll_opposite T i S).mpr hS
  · intro S hS
    exact oppositeOrientedFace_involutive α i S

/-- Splitting the oriented faces of a tree into its surviving and interior
records is an exact finite partition. -/
theorem sum_treeOrientedFaces_eq_sum_surviving_add_interior
    {α : Anisotropy} {G : Type*} [AddCommMonoid G]
    (T : FiniteConvexTree α) (i : Fin 3) (f : OrientedFace α → G) :
    (∑ S ∈ treeOrientedFaces T, f S) =
      (∑ S ∈ survivingFacesAll T i, f S) +
        ∑ S ∈ interiorFacesAll T i, f S := by
  symm
  simpa only [survivingFacesAll_eq_filter_treeOrientedFaces, interiorFacesAll,
    not_not] using
    (Finset.sum_filter_add_sum_filter_not (treeOrientedFaces T)
      (fun S ↦ boxNeighbor α S.box i S.orientation ∉ T.boxes) f)

/-- After anti-symmetric interior cancellation, the full oriented boundary sum
is exactly its surviving-face sum. -/
theorem sum_treeOrientedFaces_eq_sum_surviving_of_opposite
    {α : Anisotropy} {G : Type*} [AddCommGroup G]
    (T : FiniteConvexTree α) (i : Fin 3) (f : OrientedFace α → G)
    (hanti : ∀ S, f S + f (oppositeOrientedFace α i S) = 0) :
    (∑ S ∈ treeOrientedFaces T, f S) =
      ∑ S ∈ survivingFacesAll T i, f S := by
  rw [sum_treeOrientedFaces_eq_sum_surviving_add_interior]
  rw [sum_interiorFacesAll_eq_zero_of_opposite T i f hanti]
  simp

theorem mem_survivingFacesAll_iff {α : Anisotropy} (T : FiniteConvexTree α)
    (i : Fin 3) (S : OrientedFace α) :
    S ∈ survivingFacesAll T i ↔ S.box ∈ T.boxes ∧
      boxNeighbor α S.box i S.orientation ∉ T.boxes := by
  constructor
  · intro hS
    rcases Finset.mem_biUnion.mp hS with ⟨q, hq, hS⟩
    have hface : S ∈ orientedFacesOfBox q := (Finset.mem_filter.mp hS).1
    have hneighbor : boxNeighbor α S.box i S.orientation ∉ T.boxes :=
      (Finset.mem_filter.mp hS).2
    exact ⟨(mem_orientedFacesOfBox_iff q S).mp hface ▸ hq, hneighbor⟩
  · rintro ⟨hbox, hneighbor⟩
    refine Finset.mem_biUnion.mpr ⟨S.box, hbox, ?_⟩
    exact Finset.mem_filter.mpr ⟨(mem_orientedFacesOfBox_iff S.box S).mpr rfl,
      hneighbor⟩

/-- The finite version of the source's weighted boundary count.  The equality
`boxMass = 2^(k A)` proved above makes this definition literally the displayed
packing sum after grouping by levels. -/
noncomputable def facePackingMass {α : Anisotropy} (T : FiniteConvexTree α)
    (i : Fin 3) : ℝ :=
  ∑ S ∈ survivingFacesAll T i, boxMass α S.box

theorem mem_survivingFacesAll_iff_exists_level {α : Anisotropy}
    (T : FiniteConvexTree α) (i : Fin 3) (S : OrientedFace α) :
    S ∈ survivingFacesAll T i ↔ ∃ k : ℤ, S ∈ survivingFaces T i k := by
  constructor
  · intro hS
    refine ⟨S.box.level, (mem_survivingFaces_iff T i S.box.level S).mpr ?_⟩
    rcases (mem_survivingFacesAll_iff T i S).mp hS with ⟨hbox, hneighbor⟩
    exact ⟨(mem_treeAtLevel_iff T S.box.level S.box).mpr ⟨hbox, rfl⟩, hneighbor⟩
  · rintro ⟨k, hS⟩
    rcases (mem_survivingFaces_iff T i k S).mp hS with ⟨hbox, hneighbor⟩
    exact (mem_survivingFacesAll_iff T i S).mpr
      ⟨(mem_treeAtLevel_iff T k S.box).mp hbox |>.1, hneighbor⟩

/-! ### Local anisotropic sizes

These definitions are the literal positive quantities from `def:size`; their
analytic comparison estimates are developed before the tree-form bounds.
-/

/-- The product comparison kernel `Θ_t(p-y)`. -/
noncomputable def anisotropicBracketKernel (α : Anisotropy) (t : ℝ)
    (p y : E3) : ℝ :=
  ∏ i : Fin 3, bracketKernelAt (t ^ α.weight i) (p i) (y i)

/-- Positivity of every factor in the comparison kernel.  The scale is kept
nonnegative here because later tree scales are positive by construction. -/
theorem bracketKernelAt_nonneg {s a x : ℝ} (hs : 0 ≤ s) :
    0 ≤ bracketKernelAt s a x := by
  unfold bracketKernelAt kernelAt kernelDilate
  exact smul_nonneg (inv_nonneg.mpr hs) (bracketKernel_nonneg _)

theorem anisotropicBracketKernel_nonneg (α : Anisotropy) {t : ℝ}
    (ht : 0 ≤ t) (p y : E3) :
    0 ≤ anisotropicBracketKernel α t p y := by
  unfold anisotropicBracketKernel
  apply Finset.prod_nonneg
  intro i _
  exact bracketKernelAt_nonneg (pow_nonneg ht _)

theorem anisotropicBracketKernel_pos (α : Anisotropy) {t : ℝ}
    (ht : 0 < t) (p y : E3) :
    0 < anisotropicBracketKernel α t p y := by
  unfold anisotropicBracketKernel
  apply Finset.prod_pos
  intro i _
  exact bracketKernelAt_pos (pow_pos ht _)

/-- The product comparison kernel is integrable at every positive
anisotropic scale. -/
theorem integrable_anisotropicBracketKernel (α : Anisotropy) {t : ℝ}
    (ht : 0 < t) (p : E3) :
    Integrable (anisotropicBracketKernel α t p) := by
  rw [← (PiLp.volume_preserving_toLp (Fin 3)).integrable_comp_emb
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  change Integrable (fun x : Fin 3 → ℝ ↦
    ∏ i : Fin 3, bracketKernelAt (t ^ α.weight i) (p i) (x i))
  exact Integrable.fintype_prod fun i ↦
    integrable_bracketKernelAt (pow_pos ht _) (p i)

/-- Exact mass of the three-dimensional comparison kernel.  Its value is
less than one, as required in the cube and edge Brascamp--Lieb estimates. -/
theorem integral_anisotropicBracketKernel (α : Anisotropy) {t : ℝ}
    (ht : 0 < t) (p : E3) :
    ∫ y : E3, anisotropicBracketKernel α t p y = (2 / 9 : ℝ) ^ 3 := by
  rw [← (PiLp.volume_preserving_toLp (Fin 3)).integral_comp
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  change (∫ x : Fin 3 → ℝ,
    ∏ i : Fin 3, bracketKernelAt (t ^ α.weight i) (p i) (x i)) = _
  rw [integral_fintype_prod_volume_eq_prod]
  have hfac (i : Fin 3) :
      ∫ x : ℝ, bracketKernelAt (t ^ α.weight i) (p i) x = 2 / 9 :=
    integral_bracketKernelAt (pow_pos ht _) (p i)
  simp_rw [hfac]
  norm_num [Finset.prod_const, Fintype.card_fin]

/-- The center of a literal anisotropic box. -/
noncomputable def boxCenter (α : Anisotropy) (q : AnisoBox α) : E3 :=
  WithLp.toLp 2 fun i ↦ ((q.index i : ℝ) + 1 / 2) * boxSide α q i

@[simp]
theorem boxCenter_apply (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    boxCenter α q i = ((q.index i : ℝ) + 1 / 2) * boxSide α q i := by
  simp [boxCenter]

/-- The indicated center really is an interior point of its half-open grid
box.  This is the coordinate fact needed when the local kernel is compared
on a box closure. -/
theorem boxCenter_mem_boxSet (α : Anisotropy) (q : AnisoBox α) :
    boxCenter α q ∈ boxSet α q := by
  rw [boxSet, Set.mem_preimage, Set.mem_pi]
  intro i _
  rw [boxInterval, boxCenter_apply]
  push_cast
  constructor <;> nlinarith [boxSide_pos α q i]

/-- The weighted local `L^s` average assigned to one box. -/
noncomputable def boxLocalPower (α : Anisotropy) (s : ℝ)
    (f : E3 → ℝ) (q : AnisoBox α) : ℝ :=
  ∫ y : E3, |f y| ^ s *
    anisotropicBracketKernel α (boxLength q) (boxCenter α q) y

/-- The source local size contribution of one box. -/
noncomputable def boxLocalSize (α : Anisotropy) (s : ℝ)
    (f : E3 → ℝ) (q : AnisoBox α) : ℝ :=
  (boxLocalPower α s f q) ^ s⁻¹

/-- The maximum local size over a finite collection; it is zero for the empty
collection exactly as stipulated in the source. -/
noncomputable def collectionLocalSize (α : Anisotropy) (S : BoxCollection α)
    (s : ℝ) (f : E3 → ℝ) : ℝ :=
  if h : S.Nonempty then S.sup' h (boxLocalSize α s f) else 0

noncomputable def treeLocalSize {α : Anisotropy} (T : FiniteConvexTree α)
    (s : ℝ) (f : E3 → ℝ) : ℝ :=
  collectionLocalSize α T.boxes s f

theorem collectionLocalSize_empty (α : Anisotropy) (s : ℝ) (f : E3 → ℝ) :
    collectionLocalSize α ∅ s f = 0 := by
  simp [collectionLocalSize]

theorem collectionLocalSize_eq_sup' {α : Anisotropy} (S : BoxCollection α)
    (hS : S.Nonempty) (s : ℝ) (f : E3 → ℝ) :
    collectionLocalSize α S s f = S.sup' hS (boxLocalSize α s f) := by
  simp [collectionLocalSize, hS]

theorem boxLocalSize_le_collectionLocalSize {α : Anisotropy}
    (S : BoxCollection α) {q : AnisoBox α} (hq : q ∈ S)
    (s : ℝ) (f : E3 → ℝ) :
    boxLocalSize α s f q ≤ collectionLocalSize α S s f := by
  rw [collectionLocalSize_eq_sup' S ⟨q, hq⟩ s f]
  exact Finset.le_sup' (boxLocalSize α s f) hq

/-! ### Cubical coordinates for the local Brascamp--Lieb forms

The source uses two copies of each spatial coordinate.  Keeping this as an
actual six-dimensional Euclidean space, rather than an informal tuple,
makes the product measure and every projection below literal.
-/

/-- The eight vertices of the three-dimensional binary cube. -/
abbrev CubeVertex := Fin 3 → Bool

/-- The six scalar variables `x_i^b` in the source cube integral. -/
abbrev E6 := EuclideanSpace ℝ (Fin 3 × Bool)

/-- The opposite vertex of the binary cube. -/
def cubeComplement (j : CubeVertex) : CubeVertex := fun i ↦ !(j i)

@[simp]
theorem cubeComplement_apply (j : CubeVertex) (i : Fin 3) :
    cubeComplement j i = !(j i) := rfl

@[simp]
theorem cubeComplement_complement (j : CubeVertex) :
    cubeComplement (cubeComplement j) = j := by
  funext i
  simp [cubeComplement]

/-- Replace the `i`th bit of a cube vertex by `b`, the source map
`\rho_i^b`. -/
def cubeVertexReplace (i : Fin 3) (b : Bool) (j : CubeVertex) : CubeVertex :=
  fun q ↦ if q = i then b else j q

@[simp]
theorem cubeVertexReplace_apply (i : Fin 3) (b : Bool) (j : CubeVertex)
    (q : Fin 3) :
    cubeVertexReplace i b j q = if q = i then b else j q := rfl

theorem cubeVertexReplace_idempotent (i : Fin 3) (a b : Bool)
    (j : CubeVertex) :
    cubeVertexReplace i b (cubeVertexReplace i a j) =
      cubeVertexReplace i b j := by
  funext q
  by_cases hqi : q = i <;> simp [cubeVertexReplace, hqi]

theorem cubeVertexReplace_commute {i q : Fin 3} (hiq : i ≠ q)
    (a b : Bool) (j : CubeVertex) :
    cubeVertexReplace i a (cubeVertexReplace q b j) =
      cubeVertexReplace q b (cubeVertexReplace i a j) := by
  funext r
  by_cases hri : r = i
  · subst r
    simp [cubeVertexReplace, hiq]
  · by_cases hrq : r = q
    · subst r
      simp [cubeVertexReplace, hri, hiq]
    · simp [cubeVertexReplace, hri, hrq]

/-- Copy a cube input along one coordinate bit, the source operator
`\mathsf C_i^b`. -/
def cubeCoordinateCopy (i : Fin 3) (b : Bool)
    (F : CubeVertex → E3 → ℝ) : CubeVertex → E3 → ℝ :=
  fun j ↦ F (cubeVertexReplace i b j)

theorem cubeCoordinateCopy_absorb (i : Fin 3) (a b : Bool)
    (F : CubeVertex → E3 → ℝ) :
    cubeCoordinateCopy i b (cubeCoordinateCopy i a F) =
      cubeCoordinateCopy i a F := by
  funext j x
  simp only [cubeCoordinateCopy]
  rw [cubeVertexReplace_idempotent i b a]

theorem cubeCoordinateCopy_idempotent (i : Fin 3) (b : Bool)
    (F : CubeVertex → E3 → ℝ) :
    cubeCoordinateCopy i b (cubeCoordinateCopy i b F) =
      cubeCoordinateCopy i b F :=
  cubeCoordinateCopy_absorb i b b F

theorem cubeCoordinateCopy_commute {i q : Fin 3} (hiq : i ≠ q)
    (a b : Bool) (F : CubeVertex → E3 → ℝ) :
    cubeCoordinateCopy i a (cubeCoordinateCopy q b F) =
      cubeCoordinateCopy q b (cubeCoordinateCopy i a F) := by
  funext j x
  simp only [cubeCoordinateCopy]
  rw [cubeVertexReplace_commute hiq]

/-- The vertex projection `Π_j(x)=(x_1^{j_1},x_2^{j_2},x_3^{j_3})`. -/
noncomputable def cubeProjection (j : CubeVertex) (x : E6) : E3 :=
  WithLp.toLp 2 fun i ↦ x (i, j i)

@[simp]
theorem cubeProjection_apply (j : CubeVertex) (x : E6) (i : Fin 3) :
    cubeProjection j x i = x (i, j i) := by
  simp [cubeProjection]

theorem cubeProjection_continuous (j : CubeVertex) :
    Continuous (cubeProjection j) := by
  exact (PiLp.continuous_toLp 2 (fun _ : Fin 3 ↦ ℝ)).comp (by
    rw [continuous_pi_iff]
    intro i
    exact PiLp.continuous_apply (p := 2)
      (β := fun _ : Fin 3 × Bool ↦ ℝ) (i, j i))

/-- The six-fold product of the one-dimensional comparison densities. -/
noncomputable def cubeBracketWeight (α : Anisotropy) (t : ℝ) (p : E3)
    (x : E6) : ℝ :=
  ∏ q : Fin 3 × Bool,
    bracketKernelAt (t ^ α.weight q.1) (p q.1) (x q)

theorem cubeBracketWeight_nonneg (α : Anisotropy) {t : ℝ} (ht : 0 ≤ t)
    (p : E3) (x : E6) : 0 ≤ cubeBracketWeight α t p x := by
  unfold cubeBracketWeight
  apply Finset.prod_nonneg
  intro q _
  exact bracketKernelAt_nonneg (pow_nonneg ht _)

theorem cubeBracketWeight_pos (α : Anisotropy) {t : ℝ} (ht : 0 < t)
    (p : E3) (x : E6) : 0 < cubeBracketWeight α t p x := by
  unfold cubeBracketWeight
  apply Finset.prod_pos
  intro q _
  exact bracketKernelAt_pos (pow_pos ht _)

theorem integrable_cubeBracketWeight (α : Anisotropy) {t : ℝ} (ht : 0 < t)
    (p : E3) : Integrable (cubeBracketWeight α t p) := by
  rw [← (PiLp.volume_preserving_toLp (Fin 3 × Bool)).integrable_comp_emb
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  change Integrable (fun x : Fin 3 × Bool → ℝ ↦
    ∏ q : Fin 3 × Bool,
      bracketKernelAt (t ^ α.weight q.1) (p q.1) (x q))
  exact Integrable.fintype_prod fun q ↦
    integrable_bracketKernelAt (pow_pos ht _) (p q.1)

theorem integral_cubeBracketWeight (α : Anisotropy) {t : ℝ} (ht : 0 < t)
    (p : E3) :
    ∫ x : E6, cubeBracketWeight α t p x = (2 / 9 : ℝ) ^ 6 := by
  rw [← (PiLp.volume_preserving_toLp (Fin 3 × Bool)).integral_comp
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  change (∫ x : Fin 3 × Bool → ℝ,
    ∏ q : Fin 3 × Bool,
      bracketKernelAt (t ^ α.weight q.1) (p q.1) (x q)) = _
  rw [integral_fintype_prod_volume_eq_prod]
  have hfac (q : Fin 3 × Bool) :
      ∫ x : ℝ, bracketKernelAt (t ^ α.weight q.1) (p q.1) x = 2 / 9 :=
    integral_bracketKernelAt (pow_pos ht _) (p q.1)
  simp_rw [hfac]
  norm_num [Finset.prod_const, Fintype.card_prod, Fintype.card_fin]

/-- The nonnegative product of the eight vertex inputs. -/
noncomputable def cubeInputProduct (F : CubeVertex → E3 → ℝ) (x : E6) : ℝ :=
  ∏ j : CubeVertex, |F j (cubeProjection j x)|

theorem cubeInputProduct_nonneg (F : CubeVertex → E3 → ℝ) (x : E6) :
    0 ≤ cubeInputProduct F x := by
  unfold cubeInputProduct
  exact Finset.prod_nonneg fun _ _ ↦ abs_nonneg _

/-- The concrete coordinate permutation which places the `000` variables
first and the `111` variables second. -/
def cubeFalseTrueIndexEquiv : Fin 3 ⊕ Fin 3 ≃ Fin 3 × Bool where
  toFun := fun q ↦ match q with
    | .inl i => (i, false)
    | .inr i => (i, true)
  invFun := fun q ↦ if q.2 then .inr q.1 else .inl q.1
  left_inv := by intro q; cases q <;> simp
  right_inv := by rintro ⟨i, b⟩; cases b <;> simp

/-- Measure-preserving splitting of the six cube coordinates into the two
opposite vertices `000` and `111`. -/
noncomputable def cubeFalseTrueSplit : E6 ≃ᵐ E3 × E3 :=
  ((LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ cubeFalseTrueIndexEquiv.symm).trans
    (PiLp.sumPiLpEquivProdLpPiLp 2 (fun _ : Fin 3 ⊕ Fin 3 => ℝ))).toMeasurableEquiv.trans
    (MeasurableEquiv.toLp 2 (E3 × E3)).symm

theorem cubeFalseTrueSplit_measurePreserving :
    MeasurePreserving cubeFalseTrueSplit := by
  exact (WithLp.volume_preserving_symm_measurableEquiv_toLp_prod
    (U := E3) (V := E3)).comp
    (LinearIsometryEquiv.measurePreserving
      ((LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ cubeFalseTrueIndexEquiv.symm).trans
        (PiLp.sumPiLpEquivProdLpPiLp 2 (fun _ : Fin 3 ⊕ Fin 3 => ℝ))))

theorem cubeFalseTrueSplit_apply (x : E6) :
    cubeFalseTrueSplit x =
      (cubeProjection (fun _ => false) x, cubeProjection (fun _ => true) x) := by
  ext i <;>
    simp [cubeFalseTrueSplit, cubeProjection, cubeFalseTrueIndexEquiv,
      LinearIsometryEquiv.piLpCongrLeft_apply, PiLp.sumPiLpEquivProdLpPiLp,
      WithLp.ofLp_toLp]

/-- The exact Fubini factorization for the `000`--`111` opposite pair.
This is the analytic heart of one of the four factors in the full-cube
Brascamp--Lieb inequality. -/
theorem integral_cube_false_true_pair_pow_four
    (α : Anisotropy) (t : ℝ) (p : E3) (F0 F1 : E3 → ℝ) :
    ∫ x : E6,
        (F0 (cubeProjection (fun _ => false) x) *
          F1 (cubeProjection (fun _ => true) x)) ^ 4 *
          cubeBracketWeight α t p x =
      (∫ y : E3, F0 y ^ 4 * anisotropicBracketKernel α t p y) *
        ∫ z : E3, F1 z ^ 4 * anisotropicBracketKernel α t p z := by
  let A : E3 → ℝ := fun y => F0 y ^ 4 * anisotropicBracketKernel α t p y
  let C : E3 → ℝ := fun z => F1 z ^ 4 * anisotropicBracketKernel α t p z
  let G : E3 × E3 → ℝ := fun yz => A yz.1 * C yz.2
  have hW (x : E6) :
      cubeBracketWeight α t p x =
        anisotropicBracketKernel α t p (cubeProjection (fun _ => false) x) *
          anisotropicBracketKernel α t p (cubeProjection (fun _ => true) x) := by
    simp only [cubeBracketWeight, anisotropicBracketKernel, cubeProjection]
    rw [Fintype.prod_prod_type]
    simp_rw [Fintype.prod_bool]
    rw [Finset.prod_mul_distrib, mul_comm]
  calc
    _ = ∫ x : E6, G (cubeFalseTrueSplit x) := by
      apply integral_congr_ae
      filter_upwards [] with x
      rw [cubeFalseTrueSplit_apply]
      simp only [G, A, C]
      rw [hW x, mul_pow]
      ring
    _ = ∫ yz : E3 × E3, G yz :=
      cubeFalseTrueSplit_measurePreserving.integral_comp' G
    _ = _ := by exact integral_prod_mul A C

/-- The coordinate split attached to an arbitrary pair of opposite cube
vertices. -/
def cubeVertexIndexEquiv (j : CubeVertex) : Fin 3 ⊕ Fin 3 ≃ Fin 3 × Bool where
  toFun := fun q ↦ match q with
    | .inl i => (i, j i)
    | .inr i => (i, !(j i))
  invFun := fun q ↦ if q.2 = j q.1 then .inl q.1 else .inr q.1
  left_inv := by
    intro q
    rcases q with i | i <;> cases h : j i <;> simp [h]
  right_inv := by
    rintro ⟨i, b⟩
    cases hb : b <;> cases hj : j i <;> simp_all

noncomputable def cubeVertexSplit (j : CubeVertex) : E6 ≃ᵐ E3 × E3 :=
  ((LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ (cubeVertexIndexEquiv j).symm).trans
    (PiLp.sumPiLpEquivProdLpPiLp 2 (fun _ : Fin 3 ⊕ Fin 3 => ℝ))).toMeasurableEquiv.trans
    (MeasurableEquiv.toLp 2 (E3 × E3)).symm

theorem cubeVertexSplit_measurePreserving (j : CubeVertex) :
    MeasurePreserving (cubeVertexSplit j) := by
  exact (WithLp.volume_preserving_symm_measurableEquiv_toLp_prod
    (U := E3) (V := E3)).comp
    (LinearIsometryEquiv.measurePreserving
      ((LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ (cubeVertexIndexEquiv j).symm).trans
        (PiLp.sumPiLpEquivProdLpPiLp 2 (fun _ : Fin 3 ⊕ Fin 3 => ℝ))))

theorem cubeVertexSplit_apply (j : CubeVertex) (x : E6) :
    cubeVertexSplit j x =
      (cubeProjection j x, cubeProjection (cubeComplement j) x) := by
  ext i <;>
    simp [cubeVertexSplit, cubeProjection, cubeComplement, cubeVertexIndexEquiv,
      LinearIsometryEquiv.piLpCongrLeft_apply, PiLp.sumPiLpEquivProdLpPiLp,
      WithLp.ofLp_toLp]

/-- Exact Fubini factorization for every opposite pair of cube vertices. -/
theorem integral_cube_opposite_pair_pow_four
    (α : Anisotropy) (t : ℝ) (p : E3) (j : CubeVertex) (F0 F1 : E3 → ℝ) :
    ∫ x : E6,
        (F0 (cubeProjection j x) *
          F1 (cubeProjection (cubeComplement j) x)) ^ 4 *
          cubeBracketWeight α t p x =
      (∫ y : E3, F0 y ^ 4 * anisotropicBracketKernel α t p y) *
        ∫ z : E3, F1 z ^ 4 * anisotropicBracketKernel α t p z := by
  let A : E3 → ℝ := fun y => F0 y ^ 4 * anisotropicBracketKernel α t p y
  let C : E3 → ℝ := fun z => F1 z ^ 4 * anisotropicBracketKernel α t p z
  let G : E3 × E3 → ℝ := fun yz => A yz.1 * C yz.2
  have hW (x : E6) :
      cubeBracketWeight α t p x =
        anisotropicBracketKernel α t p (cubeProjection j x) *
          anisotropicBracketKernel α t p (cubeProjection (cubeComplement j) x) := by
    simp only [cubeBracketWeight, anisotropicBracketKernel, cubeProjection, cubeComplement]
    rw [Fintype.prod_prod_type]
    have hEach (i : Fin 3) :
        (∏ b : Bool, bracketKernelAt (t ^ α.weight i) (p i) (x (i, b))) =
          bracketKernelAt (t ^ α.weight i) (p i) (x (i, j i)) *
            bracketKernelAt (t ^ α.weight i) (p i) (x (i, !(j i))) := by
      cases h : j i <;> simp [h, mul_comm]
    simp_rw [hEach]
    rw [Finset.prod_mul_distrib]
  calc
    _ = ∫ x : E6, G (cubeVertexSplit j x) := by
      apply integral_congr_ae
      filter_upwards [] with x
      rw [cubeVertexSplit_apply]
      simp only [G, A, C]
      rw [hW x, mul_pow]
      ring
    _ = ∫ yz : E3 × E3, G yz :=
      (cubeVertexSplit_measurePreserving j).integral_comp' G
    _ = _ := by exact integral_prod_mul A C

/-- One canonical representative from each opposite pair, exactly the
source set `J₀={0}×{0,1}²`. -/
abbrev CubePairRepresentative := {j : CubeVertex // j 0 = false}

def cubeComplementRepresentativeEquiv :
    CubePairRepresentative ≃ {j : CubeVertex // ¬ j 0 = false} where
  toFun := fun j ↦ ⟨cubeComplement j.1, by simp [cubeComplement, j.2]⟩
  invFun := fun j ↦ ⟨cubeComplement j.1, by
    cases h : j.1 0
    · exact False.elim (j.2 h)
    · simp [cubeComplement, h]⟩
  left_inv := by rintro ⟨j, hj⟩; simp [cubeComplement_complement]
  right_inv := by rintro ⟨j, hj⟩; simp [cubeComplement_complement]

/-- Factor a product over the cube into its four complementary vertex pairs. -/
theorem cubeVertexProduct_pair_factorization (H : CubeVertex → ℝ) :
    (∏ j : CubeVertex, H j) =
      ∏ j : CubePairRepresentative, H j.1 * H (cubeComplement j.1) := by
  symm
  rw [Finset.prod_mul_distrib]
  change (∏ j : CubePairRepresentative, H j.1) *
      ∏ j : CubePairRepresentative,
        (fun q : {j : CubeVertex // ¬ j 0 = false} ↦ H q.1)
          (cubeComplementRepresentativeEquiv j) = ∏ j : CubeVertex, H j
  rw [Equiv.prod_comp cubeComplementRepresentativeEquiv
    (fun q : {j : CubeVertex // ¬ j 0 = false} ↦ H q.1)]
  exact Fintype.prod_subtype_mul_prod_subtype
    (fun j : CubeVertex ↦ j 0 = false) H

/-- Literal pairing of the eight vertex factors into the four opposite
pairs used in the first Cauchy--Schwarz step. -/
theorem cubeInputProduct_pair_factorization (F : CubeVertex → E3 → ℝ) (x : E6) :
    cubeInputProduct F x =
      ∏ j : CubePairRepresentative,
        |F j.1 (cubeProjection j.1 x)| *
          |F (cubeComplement j.1) (cubeProjection (cubeComplement j.1) x)| := by
  let H : CubeVertex → ℝ := fun j ↦ |F j (cubeProjection j x)|
  change (∏ j : CubeVertex, H j) = _
  symm
  rw [Finset.prod_mul_distrib]
  change (∏ j : CubePairRepresentative, H j.1) *
      ∏ j : CubePairRepresentative,
        (fun q : {j : CubeVertex // ¬ j 0 = false} ↦ H q.1)
          (cubeComplementRepresentativeEquiv j) = ∏ j : CubeVertex, H j
  rw [Equiv.prod_comp cubeComplementRepresentativeEquiv
    (fun q : {j : CubeVertex // ¬ j 0 = false} ↦ H q.1)]
  exact Fintype.prod_subtype_mul_prod_subtype (fun j : CubeVertex ↦ j 0 = false) H

/-- The local cube average occurring in `def:size` and `lem:bl`. -/
noncomputable def cubeBracketAverage (α : Anisotropy) (t : ℝ) (p : E3)
    (F : CubeVertex → E3 → ℝ) : ℝ :=
  ∫ x : E6, cubeInputProduct F x * cubeBracketWeight α t p x

/-- The source local cube size over the closure of a finite box-scale
region.  The set-theoretic supremum is intentionally literal; finiteness is
proved later from the Brascamp--Lieb bound for bounded inputs. -/
noncomputable def collectionCubeSize (α : Anisotropy) (S : BoxCollection α)
    (F : CubeVertex → E3 → ℝ) : ℝ :=
  sSup {a : ℝ | ∃ z : E3 × ℝ, z ∈ closure (collectionRegion α S) ∧
    a = cubeBracketAverage α z.2 z.1 F}

noncomputable def treeCubeSize {α : Anisotropy} (T : FiniteConvexTree α)
    (F : CubeVertex → E3 → ℝ) : ℝ :=
  collectionCubeSize α T.boxes F

/-- The nonnegative real Cauchy--Schwarz inequality in the exact integral
form used twice in the proof of `lem:bl`.  Isolating it here keeps the later
cube proof about the coordinate factorization rather than `L²` coercions. -/
theorem integral_mul_le_sqrt_integral_sq
    {X : Type*} [MeasurableSpace X] (μ : Measure X) (f g : X → ℝ)
    (hfmeas : AEStronglyMeasurable f μ) (hgmeas : AEStronglyMeasurable g μ)
    (hfnonneg : 0 ≤ᵐ[μ] f) (hgnonneg : 0 ≤ᵐ[μ] g)
    (hfsq : Integrable (fun x ↦ f x ^ 2) μ)
    (hgsq : Integrable (fun x ↦ g x ^ 2) μ) :
    ∫ x, f x * g x ∂μ ≤
      √(∫ x, f x ^ 2 ∂μ) * √(∫ x, g x ^ 2 ∂μ) := by
  have hpq : (2 : ℝ).HolderConjugate 2 := by
    rw [Real.holderConjugate_iff]
    norm_num
  have hf : MemLp f 2 μ := (memLp_two_iff_integrable_sq hfmeas).mpr hfsq
  have hg : MemLp g 2 μ := (memLp_two_iff_integrable_sq hgmeas).mpr hgsq
  simpa [Real.sqrt_eq_rpow] using
    (integral_mul_le_Lp_mul_Lq_of_nonneg hpq hfnonneg hgnonneg
      (by convert hf using 1 <;> norm_num)
      (by convert hg using 1 <;> norm_num))

/-! ### Measurability of the local comparison measures

The two Cauchy--Schwarz applications in `lem:bl` are most naturally made
with respect to the finite product density occurring in the source.  The
following elementary continuity facts make that density an actual measure,
rather than a formal notation for a weighted integral.
-/

theorem continuous_bracketKernel : Continuous bracketKernel := by
  unfold bracketKernel
  rw [continuous_iff_continuousAt]
  intro x
  apply ContinuousAt.rpow_const
  · fun_prop
  · left
    positivity

theorem continuous_bracketKernelAt {s : ℝ} (hs : s ≠ 0) (a : ℝ) :
    Continuous (bracketKernelAt s a) := by
  unfold bracketKernelAt kernelAt kernelDilate
  change Continuous fun x : ℝ ↦ s⁻¹ * bracketKernel ((x - a) / s)
  exact continuous_const.mul
    (continuous_bracketKernel.comp
      ((continuous_id.sub continuous_const).div_const s))

theorem measurable_bracketKernelAt {s : ℝ} (hs : s ≠ 0) (a : ℝ) :
    Measurable (bracketKernelAt s a) :=
  (continuous_bracketKernelAt hs a).measurable

theorem continuous_anisotropicBracketKernel (α : Anisotropy) {t : ℝ}
    (ht : 0 < t) (p : E3) :
    Continuous (anisotropicBracketKernel α t p) := by
  unfold anisotropicBracketKernel
  apply continuous_finsetProd Finset.univ
  intro i _
  exact (continuous_bracketKernelAt (pow_ne_zero _ ht.ne') (p i)).comp
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i)

theorem measurable_anisotropicBracketKernel (α : Anisotropy) {t : ℝ}
    (ht : 0 < t) (p : E3) :
    Measurable (anisotropicBracketKernel α t p) :=
  (continuous_anisotropicBracketKernel α ht p).measurable

theorem continuous_cubeBracketWeight (α : Anisotropy) {t : ℝ}
    (ht : 0 < t) (p : E3) :
    Continuous (cubeBracketWeight α t p) := by
  unfold cubeBracketWeight
  apply continuous_finsetProd Finset.univ
  intro q _
  exact (continuous_bracketKernelAt (pow_ne_zero _ ht.ne') (p q.1)).comp
    (PiLp.continuous_apply (p := 2)
      (β := fun _ : Fin 3 × Bool ↦ ℝ) q)

theorem measurable_cubeBracketWeight (α : Anisotropy) {t : ℝ}
    (ht : 0 < t) (p : E3) :
    Measurable (cubeBracketWeight α t p) :=
  (continuous_cubeBracketWeight α ht p).measurable

/-- Joint continuity of the sixfold comparison weight in center and spatial
variables at one fixed scale. -/
theorem continuous_cubeBracketWeight_center_space
    (α : Anisotropy) (t : ℝ) :
    Continuous (fun z : E3 × E6 ↦ cubeBracketWeight α t z.1 z.2) := by
  unfold cubeBracketWeight bracketKernelAt kernelAt kernelDilate
  apply continuous_finsetProd
  intro q _
  have hx : Continuous (fun z : E3 × E6 ↦ z.2 q) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 × Bool ↦ ℝ) q).comp
      continuous_snd
  have hp : Continuous (fun z : E3 × E6 ↦ z.1 q.1) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) q.1).comp
      continuous_fst
  have harg : Continuous (fun z : E3 × E6 ↦
      (z.2 q - z.1 q.1) / t ^ α.weight q.1) :=
    (hx.sub hp).div_const _
  have hprod : Continuous (fun z : E3 × E6 ↦
      (t ^ α.weight q.1)⁻¹ * bracketKernel
        ((z.2 q - z.1 q.1) / t ^ α.weight q.1)) :=
    (continuous_const : Continuous (fun _ : E3 × E6 ↦
      (t ^ α.weight q.1)⁻¹)).mul (continuous_bracketKernel.comp harg)
  simpa only [smul_eq_mul] using hprod

/-- On a finite center box, the positive sixfold comparison weight is jointly
integrable in the center and all six spatial variables. -/
theorem integrable_cubeBracketWeight_center_space
    (α : Anisotropy) (q : AnisoBox α) {t : ℝ} (ht : 0 < t) :
    Integrable (fun z : E3 × E6 ↦ cubeBracketWeight α t z.1 z.2)
      ((volume.restrict (boxSet α q)).prod volume) := by
  letI : IsFiniteMeasure (volume.restrict (boxSet α q)) := by
    constructor
    rw [Measure.restrict_apply_univ]
    rw [volume_boxSet]
    exact lt_top_iff_ne_top.mpr
      (ENNReal.prod_ne_top fun _ _ ↦ ENNReal.ofReal_ne_top)
  have hmeas : AEStronglyMeasurable
      (fun z : E3 × E6 ↦ cubeBracketWeight α t z.1 z.2)
      ((volume.restrict (boxSet α q)).prod volume) :=
    (continuous_cubeBracketWeight_center_space α t).aestronglyMeasurable
  refine (integrable_prod_iff hmeas).mpr ⟨?_, ?_⟩
  · filter_upwards [] with p
    exact integrable_cubeBracketWeight α ht p
  · have hconst : (fun p : E3 ↦
        ∫ x : E6, ‖cubeBracketWeight α t p x‖) =
          fun _ ↦ (2 / 9 : ℝ) ^ 6 := by
      funext p
      rw [show (fun x : E6 ↦ ‖cubeBracketWeight α t p x‖) =
        cubeBracketWeight α t p by
          funext x
          rw [Real.norm_eq_abs, abs_of_nonneg]
          exact cubeBracketWeight_nonneg α ht.le p x]
      exact integral_cubeBracketWeight α ht p
    rw [hconst]
    exact integrable_const _

/-- The finite six-coordinate measure used in the two source
Cauchy--Schwarz steps. -/
noncomputable def cubeBracketMeasure (α : Anisotropy) (t : ℝ) (p : E3) :
    Measure E6 :=
  volume.withDensity (fun x ↦ ENNReal.ofReal (cubeBracketWeight α t p x))

theorem integral_cubeBracketMeasure_eq (α : Anisotropy) {t : ℝ}
    (ht : 0 < t) (p : E3) (f : E6 → ℝ) :
    ∫ x, f x ∂cubeBracketMeasure α t p =
      ∫ x, cubeBracketWeight α t p x * f x := by
  unfold cubeBracketMeasure
  rw [integral_withDensity_eq_integral_toReal_smul
    (measurable_cubeBracketWeight α ht p).ennreal_ofReal
    (Filter.Eventually.of_forall fun x ↦ ENNReal.ofReal_lt_top)]
  apply integral_congr_ae
  filter_upwards [] with x
  rw [ENNReal.toReal_ofReal (cubeBracketWeight_nonneg α ht.le p x)]
  simp only [smul_eq_mul]

theorem isFiniteMeasure_cubeBracketMeasure (α : Anisotropy) {t : ℝ}
    (ht : 0 < t) (p : E3) : IsFiniteMeasure (cubeBracketMeasure α t p) := by
  unfold cubeBracketMeasure
  exact isFiniteMeasure_withDensity_ofReal
    (integrable_cubeBracketWeight α ht p).hasFiniteIntegral

/-- The two Cauchy--Schwarz steps from the full-cube estimate, isolated in a
four-function form.  Keeping the nested square roots is intentional: it is
the literal output of the two steps and avoids hiding any integrability
assumption in a fourth-root notation. -/
theorem integral_mul_mul_mul_le_two_cs
    {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (a b c d : X → ℝ)
    (ha : AEStronglyMeasurable a μ) (hb : AEStronglyMeasurable b μ)
    (hc : AEStronglyMeasurable c μ) (hd : AEStronglyMeasurable d μ)
    (hanonneg : 0 ≤ᵐ[μ] a) (hbnonneg : 0 ≤ᵐ[μ] b)
    (hcnonneg : 0 ≤ᵐ[μ] c) (hdnonneg : 0 ≤ᵐ[μ] d)
    (ha4 : Integrable (fun x ↦ a x ^ 4) μ)
    (hb4 : Integrable (fun x ↦ b x ^ 4) μ)
    (hc4 : Integrable (fun x ↦ c x ^ 4) μ)
    (hd4 : Integrable (fun x ↦ d x ^ 4) μ)
    (hab2 : Integrable (fun x ↦ (a x * b x) ^ 2) μ)
    (hcd2 : Integrable (fun x ↦ (c x * d x) ^ 2) μ) :
    ∫ x, a x * b x * c x * d x ∂μ ≤
      √(√(∫ x, a x ^ 4 ∂μ) * √(∫ x, b x ^ 4 ∂μ)) *
        √(√(∫ x, c x ^ 4 ∂μ) * √(∫ x, d x ^ 4 ∂μ)) := by
  have hab : ∫ x, (a x * b x) ^ 2 ∂μ ≤
      √(∫ x, a x ^ 4 ∂μ) * √(∫ x, b x ^ 4 ∂μ) := by
    have h := integral_mul_le_sqrt_integral_sq μ (fun x ↦ a x ^ 2)
      (fun x ↦ b x ^ 2) (ha.pow 2) (hb.pow 2)
      (hanonneg.mono fun x hx ↦ sq_nonneg (a x))
      (hbnonneg.mono fun x hx ↦ sq_nonneg (b x))
      (by convert ha4 using 1 <;> ext x <;> ring)
      (by convert hb4 using 1 <;> ext x <;> ring)
    convert h using 1 <;> ring
  have hcd : ∫ x, (c x * d x) ^ 2 ∂μ ≤
      √(∫ x, c x ^ 4 ∂μ) * √(∫ x, d x ^ 4 ∂μ) := by
    have h := integral_mul_le_sqrt_integral_sq μ (fun x ↦ c x ^ 2)
      (fun x ↦ d x ^ 2) (hc.pow 2) (hd.pow 2)
      (hcnonneg.mono fun x hx ↦ sq_nonneg (c x))
      (hdnonneg.mono fun x hx ↦ sq_nonneg (d x))
      (by convert hc4 using 1 <;> ext x <;> ring)
      (by convert hd4 using 1 <;> ext x <;> ring)
    convert h using 1 <;> ring
  have hfirst := integral_mul_le_sqrt_integral_sq μ
    (fun x ↦ a x * b x) (fun x ↦ c x * d x)
    (ha.mul hb) (hc.mul hd)
    (by
      filter_upwards [hanonneg, hbnonneg] with x hax hbx
      exact mul_nonneg hax hbx)
    (by
      filter_upwards [hcnonneg, hdnonneg] with x hcx hdx
      exact mul_nonneg hcx hdx) hab2 hcd2
  have hsab : √(∫ x, (a x * b x) ^ 2 ∂μ) ≤
      √(√(∫ x, a x ^ 4 ∂μ) * √(∫ x, b x ^ 4 ∂μ)) :=
    Real.sqrt_le_sqrt hab
  have hscd : √(∫ x, (c x * d x) ^ 2 ∂μ) ≤
      √(√(∫ x, c x ^ 4 ∂μ) * √(∫ x, d x ^ 4 ∂μ)) :=
    Real.sqrt_le_sqrt hcd
  calc
    ∫ x, a x * b x * c x * d x ∂μ =
        ∫ x, (a x * b x) * (c x * d x) ∂μ := by
          apply integral_congr_ae
          filter_upwards [] with x
          ring
    _ ≤ √(∫ x, (a x * b x) ^ 2 ∂μ) *
          √(∫ x, (c x * d x) ^ 2 ∂μ) := hfirst
    _ ≤ _ := mul_le_mul hsab hscd (Real.sqrt_nonneg _) (by positivity)

theorem sqrt_sqrt_eq_rpow_one_div_four {x : ℝ} (hx : 0 ≤ x) :
    √(√x) = x ^ ((4 : ℝ)⁻¹) := by
  rw [Real.sqrt_eq_rpow, Real.sqrt_eq_rpow, ← Real.rpow_mul hx]
  norm_num

/-- The nested square roots produced by two Cauchy--Schwarz steps are the
four corresponding fourth roots. -/
theorem sqrt_nested_four_moments (a b c d : ℝ)
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) (hd : 0 ≤ d) :
    √(√(a * b) * √(c * d)) =
      a ^ ((4 : ℝ)⁻¹) * b ^ ((4 : ℝ)⁻¹) *
        c ^ ((4 : ℝ)⁻¹) * d ^ ((4 : ℝ)⁻¹) := by
  rw [Real.sqrt_mul (Real.sqrt_nonneg _)]
  rw [sqrt_sqrt_eq_rpow_one_div_four (mul_nonneg ha hb),
    sqrt_sqrt_eq_rpow_one_div_four (mul_nonneg hc hd)]
  rw [Real.mul_rpow ha hb, Real.mul_rpow hc hd]
  ring

/-- The four representatives `000,001,010,011` of opposite pairs, written
as a genuine equivalence rather than an implicit enumeration. -/
def cubePairVertex (b c : Bool) : CubeVertex := ![false, b, c]

@[simp]
theorem cubePairVertex_zero (b c : Bool) : cubePairVertex b c 0 = false := by
  simp [cubePairVertex]

@[simp]
theorem cubePairVertex_one (b c : Bool) : cubePairVertex b c 1 = b := by
  simp [cubePairVertex]

@[simp]
theorem cubePairVertex_two (b c : Bool) : cubePairVertex b c 2 = c := by
  simp [cubePairVertex]

def cubePairRepresentativeEquiv : Bool × Bool ≃ CubePairRepresentative where
  toFun := fun bc ↦ ⟨cubePairVertex bc.1 bc.2, cubePairVertex_zero _ _⟩
  invFun := fun j ↦ (j.1 1, j.1 2)
  left_inv := by
    rintro ⟨b, c⟩
    simp
  right_inv := by
    rintro ⟨j, hj⟩
    apply Subtype.ext
    funext i
    fin_cases i <;> simp [cubePairVertex, hj]

/-- One of the four opposite-pair factors in the first cube
Cauchy--Schwarz step. -/
noncomputable def cubePairFactor (F : CubeVertex → E3 → ℝ)
    (b c : Bool) (x : E6) : ℝ :=
  |F (cubePairVertex b c) (cubeProjection (cubePairVertex b c) x)| *
    |F (cubeComplement (cubePairVertex b c))
      (cubeProjection (cubeComplement (cubePairVertex b c)) x)|

theorem cubeInputProduct_eq_four_pairFactors (F : CubeVertex → E3 → ℝ)
    (x : E6) :
    cubeInputProduct F x =
      cubePairFactor F false false x * cubePairFactor F false true x *
        cubePairFactor F true false x * cubePairFactor F true true x := by
  calc
    cubeInputProduct F x = ∏ j : CubePairRepresentative,
        |F j.1 (cubeProjection j.1 x)| *
          |F (cubeComplement j.1) (cubeProjection (cubeComplement j.1) x)| :=
      cubeInputProduct_pair_factorization F x
    _ = ∏ bc : Bool × Bool,
        |F (cubePairRepresentativeEquiv bc).1
            (cubeProjection (cubePairRepresentativeEquiv bc).1 x)| *
          |F (cubeComplement (cubePairRepresentativeEquiv bc).1)
            (cubeProjection (cubeComplement (cubePairRepresentativeEquiv bc).1) x)| := by
      symm
      exact Equiv.prod_comp cubePairRepresentativeEquiv
        (fun j : CubePairRepresentative ↦
          |F j.1 (cubeProjection j.1 x)| *
            |F (cubeComplement j.1)
              (cubeProjection (cubeComplement j.1) x)|)
    _ = _ := by
      rw [Fintype.prod_prod_type]
      simp [cubePairFactor, cubePairRepresentativeEquiv]
      ring

/-! ### Ancestor transport of surviving faces

These finite-grid facts implement the first charge in the source packing
argument.  In particular, the apparent ``first ancestor'' is an actual
finite selection from the tree rather than an implicit infinite chain.
-/

theorem boxAncestor_succ (α : Anisotropy) (n : ℕ) (q : AnisoBox α) :
    boxAncestor α (n + 1) q = boxParent α (boxAncestor α n q) := by
  simp [boxAncestor, Function.iterate_succ_apply']

theorem boxAncestor_neighbor_eq_or_neighbor (α : Anisotropy)
    (n : ℕ) (q : AnisoBox α) (i : Fin 3) (ε : FaceOrientation) :
    boxAncestor α n (boxNeighbor α q i ε) = boxAncestor α n q ∨
      boxAncestor α n (boxNeighbor α q i ε) =
        boxNeighbor α (boxAncestor α n q) i ε := by
  induction n with
  | zero => right; simp [boxAncestor]
  | succ n ih =>
    rw [boxAncestor_succ, boxAncestor_succ]
    rcases ih with heq | hnb
    · left
      rw [heq]
    · rw [hnb]
      exact boxParent_neighbor_eq_or_neighbor α (boxAncestor α n q) i ε

theorem boxNeighbor_ne_self (α : Anisotropy) (q : AnisoBox α) (i : Fin 3)
    (ε : FaceOrientation) : boxNeighbor α q i ε ≠ q := by
  intro h
  have hi := congrFun (congrArg AnisoBox.index h) i
  cases ε <;> simp [boxNeighbor, FaceOrientation.sign] at hi <;> omega

theorem boxFaceSet_neighbor_opposite (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) (ε : FaceOrientation) :
    boxFaceSet α q i ε =
      boxFaceSet α (boxNeighbor α q i ε) i ε.opposite := by
  ext p
  simp only [boxFaceSet, Set.mem_setOf_eq]
  rw [boxFaceCoordinate_neighbor_opposite]
  constructor
  · rintro ⟨hp, ht⟩
    refine ⟨hp, ?_⟩
    intro j hji
    simpa [boxNeighbor, boxSide, hji] using ht j hji
  · rintro ⟨hp, ht⟩
    refine ⟨hp, ?_⟩
    intro j hji
    simpa [boxNeighbor, boxSide, hji] using ht j hji

theorem boxFaceSet_subset_ancestor_of_ancestor_neighbor
    (α : Anisotropy) (n : ℕ) (q : AnisoBox α) (i : Fin 3)
    (ε : FaceOrientation)
    (h : boxAncestor α n (boxNeighbor α q i ε) =
      boxNeighbor α (boxAncestor α n q) i ε) :
    boxFaceSet α q i ε ⊆ boxFaceSet α (boxAncestor α n q) i ε := by
  induction n generalizing q with
  | zero => simpa [boxAncestor]
  | succ n ih =>
    simp only [boxAncestor_succ] at h ⊢
    rcases boxAncestor_neighbor_eq_or_neighbor α n q i ε with heq | hnb
    · exfalso
      have hbad : boxParent α (boxAncestor α n q) =
          boxNeighbor α (boxParent α (boxAncestor α n q)) i ε := by
        simpa [heq] using h
      exact boxNeighbor_ne_self α (boxParent α (boxAncestor α n q)) i ε hbad.symm
    · have hparent : boxParent α (boxNeighbor α (boxAncestor α n q) i ε) =
          boxNeighbor α (boxParent α (boxAncestor α n q)) i ε := by
        simpa [hnb] using h
      exact (ih q hnb).trans
        (boxFaceSet_subset_parent_of_parent_neighbor α (boxAncestor α n q) i ε hparent)

theorem boxFaceSet_subset_of_adjacent_box_ancestor_not_subset
    (α : Anisotropy) (q L : AnisoBox α) (i : Fin 3) (ε : FaceOrientation)
    (n : ℕ) (hL : L = boxAncestor α n (boxNeighbor α q i ε))
    (hnot : ¬ boxSet α q ⊆ boxSet α L) :
    ∃ δ : FaceOrientation, boxFaceSet α q i ε ⊆ boxFaceSet α L i δ := by
  rcases boxAncestor_neighbor_eq_or_neighbor α n q i ε with heq | hnb
  · exfalso
    apply hnot
    rw [hL, heq]
    exact boxAncestor_subset α n q
  · refine ⟨ε.opposite, ?_⟩
    calc
      boxFaceSet α q i ε ⊆ boxFaceSet α (boxAncestor α n q) i ε :=
        boxFaceSet_subset_ancestor_of_ancestor_neighbor α n q i ε hnb
      _ = boxFaceSet α (boxNeighbor α (boxAncestor α n q) i ε) i ε.opposite :=
        boxFaceSet_neighbor_opposite α (boxAncestor α n q) i ε
      _ = boxFaceSet α L i ε.opposite := by rw [hL, hnb]

theorem boxSet_nonempty (α : Anisotropy) (q : AnisoBox α) :
    (boxSet α q).Nonempty := by
  by_contra h
  have hempty : boxSet α q = ∅ := Set.not_nonempty_iff_eq_empty.mp h
  have hzero : volume (boxSet α q) = 0 := by
    rw [hempty]
    exact measure_empty
  have hpos : 0 < volume (boxSet α q) := by
    rw [volume_boxSet_eq_boxMass]
    exact ENNReal.ofReal_pos.mpr (boxMass_pos α q)
  exact hpos.ne' hzero

theorem boxMass_lt_of_level_lt (α : Anisotropy) {q r : AnisoBox α}
    (hlevel : q.level < r.level) : boxMass α q < boxMass α r := by
  unfold boxMass
  apply zpow_lt_zpow_right₀ (by norm_num)
  have hA : (0 : ℤ) < (α.homogeneousDimension : ℤ) := by
    exact_mod_cast α.homogeneousDimension_pos
  nlinarith

theorem level_le_of_boxSet_subset (α : Anisotropy) {q r : AnisoBox α}
    (hsub : boxSet α q ⊆ boxSet α r) : q.level ≤ r.level := by
  by_contra hnot
  have hlevel : r.level < q.level := by omega
  obtain ⟨x, hx⟩ := boxSet_nonempty α q
  have hnested : boxSet α r ⊆ boxSet α q := by
    apply boxSet_nested_of_inter_nonempty α (by omega)
    exact ⟨x, hsub hx, hx⟩
  have hset : boxSet α q = boxSet α r := Set.Subset.antisymm hsub hnested
  have hmass : boxMass α q = boxMass α r := by
    rw [← volume_boxSet_toReal α q, hset, volume_boxSet_toReal]
  exact (ne_of_lt (boxMass_lt_of_level_lt α hlevel)) hmass.symm

theorem boxAncestor_eq_of_boxSet_subset (α : Anisotropy) {q r : AnisoBox α}
    (hsub : boxSet α q ⊆ boxSet α r) :
    boxAncestor α (r.level - q.level).toNat q = r := by
  have hlevel : q.level ≤ r.level := level_le_of_boxSet_subset α hsub
  let n : ℕ := (r.level - q.level).toNat
  have hn : (n : ℤ) = r.level - q.level := by
    dsimp [n]
    rw [Int.toNat_of_nonneg (sub_nonneg.mpr hlevel)]
  have hAncestorLevel : (boxAncestor α n q).level = r.level := by
    rw [boxAncestor_level, hn]
    ring
  by_contra hne
  have hdisj := boxSet_disjoint_of_eq_level_of_ne α hAncestorLevel hne
  obtain ⟨x, hx⟩ := boxSet_nonempty α q
  exact (Set.disjoint_left.1 hdisj) (boxAncestor_subset α n q hx) (hsub hx)

/-- A finite replacement for the source's ``first ancestor in the tree''.
It selects the missing child immediately below the minimal tree container. -/
theorem exists_leaf_container_of_boxSet_subset_root
    {α : Anisotropy} (T : FiniteConvexTree α) (q : AnisoBox α)
    (hqroot : boxSet α q ⊆ boxSet α T.root) (hqnot : q ∉ T.boxes) :
    ∃ L : AnisoBox α, L ∈ treeLeaves T ∧
      boxSet α q ⊆ boxSet α L ∧ q.level ≤ L.level := by
  classical
  let containers : Finset (AnisoBox α) :=
    T.boxes.filter fun P ↦ boxSet α q ⊆ boxSet α P
  have hcontne : containers.Nonempty := by
    exact ⟨T.root, Finset.mem_filter.mpr ⟨T.root_mem, hqroot⟩⟩
  let levels : Finset ℤ := containers.image AnisoBox.level
  have hlevelsne : levels.Nonempty := hcontne.image AnisoBox.level
  let m : ℤ := levels.min' hlevelsne
  have hm : m ∈ levels := by
    dsimp [m]
    exact Finset.min'_mem levels hlevelsne
  rcases Finset.mem_image.mp hm with ⟨P, hPcont, hPlevel⟩
  have hPT : P ∈ T.boxes := (Finset.mem_filter.mp hPcont).1
  have hqP : boxSet α q ⊆ boxSet α P := (Finset.mem_filter.mp hPcont).2
  have hqPlevel : q.level ≤ P.level := level_le_of_boxSet_subset α hqP
  have hlevelne : q.level ≠ P.level := by
    intro heq
    have hboxeq : q = P := by
      by_contra hne
      have hdisj := boxSet_disjoint_of_eq_level_of_ne α heq hne
      obtain ⟨x, hx⟩ := boxSet_nonempty α q
      exact (Set.disjoint_left.1 hdisj) hx (hqP hx)
    exact hqnot (hboxeq ▸ hPT)
  have hqPlt : q.level < P.level := by omega
  obtain ⟨x, hx⟩ := boxSet_nonempty α q
  have hxP : x ∈ boxSet α P := hqP hx
  have hxchildren : x ∈ ⋃ r ∈ boxChildren α P, boxSet α r := by
    rw [← boxSet_eq_children_union α P]
    exact hxP
  rcases Set.mem_iUnion.mp hxchildren with ⟨L, hL⟩
  rcases Set.mem_iUnion.mp hL with ⟨hLchild, hxL⟩
  have hLlevel : L.level = P.level - 1 := boxChildren_level α hLchild
  have hqLlevel : q.level ≤ L.level := by omega
  have hqL : boxSet α q ⊆ boxSet α L := by
    apply boxSet_nested_of_inter_nonempty α hqLlevel
    exact ⟨x, hx, hxL⟩
  have hLnot : L ∉ T.boxes := by
    intro hLT
    have hLcont : L ∈ containers := Finset.mem_filter.mpr ⟨hLT, hqL⟩
    have hLlevels : L.level ∈ levels := Finset.mem_image.mpr ⟨L, hLcont, rfl⟩
    have hmin := Finset.min'_le levels L.level hLlevels
    change m ≤ L.level at hmin
    omega
  have hparent : boxParent α L = P := by
    rcases Finset.mem_image.mp hLchild with ⟨v, -, rfl⟩
    exact boxParent_child α P v
  refine ⟨L, (mem_treeLeaves_iff T L).mpr ⟨hLnot, ?_⟩, hqL, hqLlevel⟩
  simpa only [hparent] using hPT

/-- First boundary charge: a surviving face whose outside neighbor stays
inside the root is charged to a face of one leaf, at no finer level. -/
theorem exists_leaf_face_charge
    {α : Anisotropy} (T : FiniteConvexTree α) (i : Fin 3)
    (S : OrientedFace α) (hS : S ∈ survivingFacesAll T i)
    (hout : boxSet α (boxNeighbor α S.box i S.orientation) ⊆ boxSet α T.root) :
    ∃ L ∈ treeLeaves T, ∃ δ : FaceOrientation,
      S.box.level ≤ L.level ∧
      boxFaceSet α S.box i S.orientation ⊆ boxFaceSet α L i δ := by
  rcases (mem_survivingFacesAll_iff T i S).mp hS with ⟨hbox, houtnot⟩
  rcases exists_leaf_container_of_boxSet_subset_root T
      (boxNeighbor α S.box i S.orientation) hout houtnot with
      ⟨L, hLleaf, houtL, houtLlevel⟩
  have hinsidenot : ¬ boxSet α S.box ⊆ boxSet α L := by
    intro hinside
    have hLtree : L ∈ T.boxes :=
      T.convex hbox (treeLeaves_parent_mem T hLleaf)
        hinside (boxSet_subset_parent α L)
    exact (treeLeaves_not_mem T hLleaf) hLtree
  have hAncestor :
      boxAncestor α (L.level - (boxNeighbor α S.box i S.orientation).level).toNat
        (boxNeighbor α S.box i S.orientation) = L :=
    boxAncestor_eq_of_boxSet_subset α houtL
  rcases boxFaceSet_subset_of_adjacent_box_ancestor_not_subset α S.box L
      i S.orientation
      (L.level - (boxNeighbor α S.box i S.orientation).level).toNat
      hAncestor.symm hinsidenot with ⟨δ, hface⟩
  refine ⟨L, hLleaf, δ, ?_, hface⟩
  simpa only [boxNeighbor_level] using houtLlevel

/-! ### Exact fourth moments of the four cube pairs -/

theorem cubePairFactor_nonneg (F : CubeVertex → E3 → ℝ)
    (b c : Bool) (x : E6) : 0 ≤ cubePairFactor F b c x := by
  unfold cubePairFactor
  positivity

theorem measurable_cubePairFactor (F : CubeVertex → E3 → ℝ)
    (hF : ∀ j, Measurable (F j)) (b c : Bool) :
    Measurable (cubePairFactor F b c) := by
  unfold cubePairFactor
  apply Measurable.mul
  · exact (continuous_abs.measurable).comp
      ((hF _).comp (cubeProjection_continuous _).measurable)
  · exact (continuous_abs.measurable).comp
      ((hF _).comp (cubeProjection_continuous _).measurable)

theorem integral_cubePairFactor_pow_four
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (F : CubeVertex → E3 → ℝ) (b c : Bool) :
    ∫ x, (cubePairFactor F b c x) ^ 4 ∂cubeBracketMeasure α t p =
      (∫ y : E3, |F (cubePairVertex b c) y| ^ 4 *
        anisotropicBracketKernel α t p y) *
        ∫ z : E3, |F (cubeComplement (cubePairVertex b c)) z| ^ 4 *
          anisotropicBracketKernel α t p z := by
  rw [integral_cubeBracketMeasure_eq α ht p]
  have h := integral_cube_opposite_pair_pow_four α t p (cubePairVertex b c)
    (fun y ↦ |F (cubePairVertex b c) y|)
    (fun z ↦ |F (cubeComplement (cubePairVertex b c)) z|)
  simpa only [cubePairFactor] using (by
    calc
      ∫ x : E6, cubeBracketWeight α t p x *
          (|F (cubePairVertex b c) (cubeProjection (cubePairVertex b c) x)| *
            |F (cubeComplement (cubePairVertex b c))
              (cubeProjection (cubeComplement (cubePairVertex b c)) x)|) ^ 4 =
          ∫ x : E6,
            (|F (cubePairVertex b c) (cubeProjection (cubePairVertex b c) x)| *
              |F (cubeComplement (cubePairVertex b c))
                (cubeProjection (cubeComplement (cubePairVertex b c)) x)|) ^ 4 *
              cubeBracketWeight α t p x := by
                apply integral_congr_ae
                filter_upwards [] with x
                ring
      _ = _ := h)

/-- A bounded measurable nonnegative source input, in the precise form used
by `lem:bl`.  The explicit bound avoids silently replacing the source's
pointwise bounded representatives by equivalence classes. -/
def IsBoundedMeasurableNonneg (f : E3 → ℝ) : Prop :=
  Measurable f ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ y, 0 ≤ f y ∧ f y ≤ C

theorem integrable_cubePairFactor_pow_of_bounded
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (F : CubeVertex → E3 → ℝ)
    (hFmeas : ∀ j, Measurable (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (b c : Bool) (n : ℕ) :
    Integrable (fun x ↦ cubePairFactor F b c x ^ n)
      (cubeBracketMeasure α t p) := by
  letI : IsFiniteMeasure (cubeBracketMeasure α t p) :=
    isFiniteMeasure_cubeBracketMeasure α ht p
  change Integrable ((cubePairFactor F b c) ^ n) (cubeBracketMeasure α t p)
  rcases hFbound (cubePairVertex b c) with ⟨C₀, hC₀, hbound₀⟩
  rcases hFbound (cubeComplement (cubePairVertex b c)) with ⟨C₁, hC₁, hbound₁⟩
  refine Integrable.of_bound
    ((measurable_cubePairFactor F hFmeas b c).pow_const n).aestronglyMeasurable
    ((C₀ * C₁) ^ n) ?_
  filter_upwards [] with x
  simp only [Pi.pow_apply]
  rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (cubePairFactor_nonneg F b c x) _)]
  apply pow_le_pow_left₀ (cubePairFactor_nonneg F b c x)
  unfold cubePairFactor
  exact mul_le_mul (hbound₀ _) (hbound₁ _) (abs_nonneg _) hC₀

theorem integrable_mul_cubePairFactor_pow_of_bounded
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (F : CubeVertex → E3 → ℝ)
    (hFmeas : ∀ j, Measurable (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (b₀ c₀ b₁ c₁ : Bool) (n : ℕ) :
    Integrable (fun x ↦
      (cubePairFactor F b₀ c₀ x * cubePairFactor F b₁ c₁ x) ^ n)
      (cubeBracketMeasure α t p) := by
  letI : IsFiniteMeasure (cubeBracketMeasure α t p) :=
    isFiniteMeasure_cubeBracketMeasure α ht p
  change Integrable ((cubePairFactor F b₀ c₀ * cubePairFactor F b₁ c₁) ^ n)
    (cubeBracketMeasure α t p)
  rcases hFbound (cubePairVertex b₀ c₀) with ⟨C₀, hC₀, hbound₀⟩
  rcases hFbound (cubeComplement (cubePairVertex b₀ c₀)) with ⟨C₁, hC₁, hbound₁⟩
  rcases hFbound (cubePairVertex b₁ c₁) with ⟨C₂, hC₂, hbound₂⟩
  rcases hFbound (cubeComplement (cubePairVertex b₁ c₁)) with ⟨C₃, hC₃, hbound₃⟩
  refine Integrable.of_bound
    (((measurable_cubePairFactor F hFmeas b₀ c₀).mul
      (measurable_cubePairFactor F hFmeas b₁ c₁)).pow_const n).aestronglyMeasurable
    (((C₀ * C₁) * (C₂ * C₃)) ^ n) ?_
  filter_upwards [] with x
  simp only [Pi.pow_apply, Pi.mul_apply]
  rw [Real.norm_eq_abs,
    abs_of_nonneg (pow_nonneg
      (mul_nonneg (cubePairFactor_nonneg F b₀ c₀ x)
        (cubePairFactor_nonneg F b₁ c₁ x)) _)]
  apply pow_le_pow_left₀
    (mul_nonneg (cubePairFactor_nonneg F b₀ c₀ x)
      (cubePairFactor_nonneg F b₁ c₁ x))
  apply mul_le_mul
  · unfold cubePairFactor
    exact mul_le_mul (hbound₀ _) (hbound₁ _) (abs_nonneg _) hC₀
  · unfold cubePairFactor
    exact mul_le_mul (hbound₂ _) (hbound₃ _) (abs_nonneg _) hC₂
  · exact cubePairFactor_nonneg F b₁ c₁ x
  · exact mul_nonneg hC₀ hC₁

/-- The weighted fourth moment appearing in the right side of the cube
Brascamp--Lieb estimate. -/
noncomputable def cubeFourthMoment (α : Anisotropy) (t : ℝ) (p : E3)
    (F : CubeVertex → E3 → ℝ) (j : CubeVertex) : ℝ :=
  ∫ y : E3, |F j y| ^ 4 * anisotropicBracketKernel α t p y

theorem cubeFourthMoment_nonneg (α : Anisotropy) {t : ℝ} (ht : 0 ≤ t)
    (p : E3) (F : CubeVertex → E3 → ℝ) (j : CubeVertex) :
    0 ≤ cubeFourthMoment α t p F j := by
  unfold cubeFourthMoment
  apply integral_nonneg
  intro y
  exact mul_nonneg (pow_nonneg (abs_nonneg _) _)
    (anisotropicBracketKernel_nonneg α ht p y)

/-- At a literal tree box, a fourth moment is exactly the fourth power
appearing in the source local size. -/
theorem cubeFourthMoment_rpow_eq_boxLocalSize
    (α : Anisotropy) (q : AnisoBox α)
    (F : CubeVertex → E3 → ℝ) (j : CubeVertex) :
    cubeFourthMoment α (boxLength q) (boxCenter α q) F j ^ ((4 : ℝ)⁻¹) =
      boxLocalSize α 4 (F j) q := by
  unfold cubeFourthMoment boxLocalSize boxLocalPower
  congr 1
  apply integral_congr_ae
  filter_upwards [] with y
  norm_num [Real.rpow_natCast]

theorem cubeFourthMoment_rpow_at_box_le_treeLocalSize
    {α : Anisotropy} (T : FiniteConvexTree α) {q : AnisoBox α}
    (hq : q ∈ T.boxes) (F : CubeVertex → E3 → ℝ) (j : CubeVertex) :
    cubeFourthMoment α (boxLength q) (boxCenter α q) F j ^ ((4 : ℝ)⁻¹) ≤
      treeLocalSize T 4 (F j) := by
  rw [cubeFourthMoment_rpow_eq_boxLocalSize]
  change boxLocalSize α 4 (F j) q ≤ collectionLocalSize α T.boxes 4 (F j)
  exact boxLocalSize_le_collectionLocalSize T.boxes hq 4 (F j)

theorem cubeFourthMoment_product_at_box_le_treeLocalSize_product
    {α : Anisotropy} (T : FiniteConvexTree α) {q : AnisoBox α}
    (hq : q ∈ T.boxes) (F : CubeVertex → E3 → ℝ) :
    (∏ j : CubeVertex,
      cubeFourthMoment α (boxLength q) (boxCenter α q) F j ^ ((4 : ℝ)⁻¹)) ≤
      ∏ j : CubeVertex, treeLocalSize T 4 (F j) := by
  apply Finset.prod_le_prod
  · intro j _
    exact Real.rpow_nonneg
      (cubeFourthMoment_nonneg α (boxLength_pos q).le (boxCenter α q) F j) _
  · intro j _
    exact cubeFourthMoment_rpow_at_box_le_treeLocalSize T hq F j

/-- Reassemble the four complementary-pair factors into the usual product
over all eight cube vertices. -/
theorem cubeFourthMoment_nested_roots_eq_product
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (F : CubeVertex → E3 → ℝ) :
    √(√(cubeFourthMoment α t p F (cubePairVertex false false) *
          cubeFourthMoment α t p F
            (cubeComplement (cubePairVertex false false))) *
        √(cubeFourthMoment α t p F (cubePairVertex false true) *
          cubeFourthMoment α t p F
            (cubeComplement (cubePairVertex false true)))) *
      √(√(cubeFourthMoment α t p F (cubePairVertex true false) *
          cubeFourthMoment α t p F
            (cubeComplement (cubePairVertex true false))) *
        √(cubeFourthMoment α t p F (cubePairVertex true true) *
          cubeFourthMoment α t p F
            (cubeComplement (cubePairVertex true true)))) =
      ∏ j : CubeVertex, cubeFourthMoment α t p F j ^ ((4 : ℝ)⁻¹) := by
  rw [sqrt_nested_four_moments _ _ _ _
    (cubeFourthMoment_nonneg α ht.le p F _)
    (cubeFourthMoment_nonneg α ht.le p F _)
    (cubeFourthMoment_nonneg α ht.le p F _)
    (cubeFourthMoment_nonneg α ht.le p F _)]
  rw [sqrt_nested_four_moments _ _ _ _
    (cubeFourthMoment_nonneg α ht.le p F _)
    (cubeFourthMoment_nonneg α ht.le p F _)
    (cubeFourthMoment_nonneg α ht.le p F _)
    (cubeFourthMoment_nonneg α ht.le p F _)]
  rw [cubeVertexProduct_pair_factorization
    (fun j ↦ cubeFourthMoment α t p F j ^ ((4 : ℝ)⁻¹))]
  rw [← Equiv.prod_comp cubePairRepresentativeEquiv
    (fun j : CubePairRepresentative ↦
      cubeFourthMoment α t p F j.1 ^ ((4 : ℝ)⁻¹) *
        cubeFourthMoment α t p F (cubeComplement j.1) ^ ((4 : ℝ)⁻¹))]
  rw [Fintype.prod_prod_type]
  simp [cubePairRepresentativeEquiv]
  ring

/-- The full-cube Brascamp--Lieb estimate in the literal four-pair form
obtained by the two Cauchy--Schwarz steps.  The next algebraic lemma turns
this into the usual product over all eight vertices. -/
theorem cubeBracketAverage_le_two_cs
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (F : CubeVertex → E3 → ℝ)
    (hFmeas : ∀ j, Measurable (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C) :
    cubeBracketAverage α t p F ≤
      √(√(cubeFourthMoment α t p F (cubePairVertex false false) *
          cubeFourthMoment α t p F
            (cubeComplement (cubePairVertex false false))) *
        √(cubeFourthMoment α t p F (cubePairVertex false true) *
          cubeFourthMoment α t p F
            (cubeComplement (cubePairVertex false true)))) *
        √(√(cubeFourthMoment α t p F (cubePairVertex true false) *
          cubeFourthMoment α t p F
            (cubeComplement (cubePairVertex true false))) *
          √(cubeFourthMoment α t p F (cubePairVertex true true) *
            cubeFourthMoment α t p F
              (cubeComplement (cubePairVertex true true))) ) := by
  have hmeasure : cubeBracketAverage α t p F =
      ∫ x, cubeInputProduct F x ∂cubeBracketMeasure α t p := by
    unfold cubeBracketAverage
    rw [integral_cubeBracketMeasure_eq α ht p]
    apply integral_congr_ae
    filter_upwards [] with x
    ring
  calc
    cubeBracketAverage α t p F =
        ∫ x, cubeInputProduct F x ∂cubeBracketMeasure α t p := hmeasure
    _ = ∫ x,
        cubePairFactor F false false x * cubePairFactor F false true x *
          cubePairFactor F true false x * cubePairFactor F true true x
          ∂cubeBracketMeasure α t p := by
      apply integral_congr_ae
      filter_upwards [] with x
      rw [cubeInputProduct_eq_four_pairFactors]
    _ ≤ √(√(∫ x, (cubePairFactor F false false x) ^ 4
          ∂cubeBracketMeasure α t p) *
          √(∫ x, (cubePairFactor F false true x) ^ 4
            ∂cubeBracketMeasure α t p)) *
        √(√(∫ x, (cubePairFactor F true false x) ^ 4
          ∂cubeBracketMeasure α t p) *
          √(∫ x, (cubePairFactor F true true x) ^ 4
            ∂cubeBracketMeasure α t p)) := by
      apply integral_mul_mul_mul_le_two_cs
      · exact (measurable_cubePairFactor F hFmeas false false).aestronglyMeasurable
      · exact (measurable_cubePairFactor F hFmeas false true).aestronglyMeasurable
      · exact (measurable_cubePairFactor F hFmeas true false).aestronglyMeasurable
      · exact (measurable_cubePairFactor F hFmeas true true).aestronglyMeasurable
      · filter_upwards [] with x
        exact cubePairFactor_nonneg F false false x
      · filter_upwards [] with x
        exact cubePairFactor_nonneg F false true x
      · filter_upwards [] with x
        exact cubePairFactor_nonneg F true false x
      · filter_upwards [] with x
        exact cubePairFactor_nonneg F true true x
      · exact integrable_cubePairFactor_pow_of_bounded α ht p F hFmeas hFbound false false 4
      · exact integrable_cubePairFactor_pow_of_bounded α ht p F hFmeas hFbound false true 4
      · exact integrable_cubePairFactor_pow_of_bounded α ht p F hFmeas hFbound true false 4
      · exact integrable_cubePairFactor_pow_of_bounded α ht p F hFmeas hFbound true true 4
      · exact integrable_mul_cubePairFactor_pow_of_bounded α ht p F hFmeas hFbound
          false false false true 2
      · exact integrable_mul_cubePairFactor_pow_of_bounded α ht p F hFmeas hFbound
          true false true true 2
    _ = _ := by
      simp only [cubeFourthMoment]
      rw [integral_cubePairFactor_pow_four α ht p F false false,
        integral_cubePairFactor_pow_four α ht p F false true,
        integral_cubePairFactor_pow_four α ht p F true false,
        integral_cubePairFactor_pow_four α ht p F true true]

/-- The full-cube Brascamp--Lieb inequality in the source's product-over-
vertices form. -/
theorem cubeBracketAverage_le_fourth_moments
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (F : CubeVertex → E3 → ℝ)
    (hFmeas : ∀ j, Measurable (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C) :
    cubeBracketAverage α t p F ≤
      ∏ j : CubeVertex, cubeFourthMoment α t p F j ^ ((4 : ℝ)⁻¹) := by
  calc
    cubeBracketAverage α t p F ≤
        √(√(cubeFourthMoment α t p F (cubePairVertex false false) *
            cubeFourthMoment α t p F
              (cubeComplement (cubePairVertex false false))) *
          √(cubeFourthMoment α t p F (cubePairVertex false true) *
            cubeFourthMoment α t p F
              (cubeComplement (cubePairVertex false true)))) *
          √(√(cubeFourthMoment α t p F (cubePairVertex true false) *
            cubeFourthMoment α t p F
              (cubeComplement (cubePairVertex true false))) *
            √(cubeFourthMoment α t p F (cubePairVertex true true) *
              cubeFourthMoment α t p F
                (cubeComplement (cubePairVertex true true)))) :=
      cubeBracketAverage_le_two_cs α ht p F hFmeas hFbound
    _ = _ := cubeFourthMoment_nested_roots_eq_product α ht p F

theorem cubeBracketAverage_at_box_le_treeLocalSize_product
    {α : Anisotropy} (T : FiniteConvexTree α) {q : AnisoBox α}
    (hq : q ∈ T.boxes) (F : CubeVertex → E3 → ℝ)
    (hFmeas : ∀ j, Measurable (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C) :
    cubeBracketAverage α (boxLength q) (boxCenter α q) F ≤
      ∏ j : CubeVertex, treeLocalSize T 4 (F j) := by
  exact (cubeBracketAverage_le_fourth_moments α (boxLength_pos q)
    (boxCenter α q) F hFmeas hFbound).trans
      (cubeFourthMoment_product_at_box_le_treeLocalSize_product T hq F)

/-- One vertex factor for the edge Brascamp--Lieb form. -/
noncomputable def cubeVertexFactor (F : E3 → ℝ) (j : CubeVertex) (x : E6) : ℝ :=
  F (cubeProjection j x)

/-- The weighted second moment appearing in the edge estimate. -/
noncomputable def cubeSecondMoment (α : Anisotropy) (t : ℝ) (p : E3)
    (F : E3 → ℝ) : ℝ :=
  ∫ y : E3, F y ^ 2 * anisotropicBracketKernel α t p y

/-- The literal six-variable edge average with the two active vertices
`000` and `001`. -/
noncomputable def cubeEdgeBracketAverage (α : Anisotropy) (t : ℝ) (p : E3)
    (F0 F1 : E3 → ℝ) : ℝ :=
  ∫ x : E6,
    F0 (cubeProjection (cubePairVertex false false) x) *
      F1 (cubeProjection (cubePairVertex false true) x) *
        cubeBracketWeight α t p x

theorem measurable_cubeVertexFactor (F : E3 → ℝ) (hF : Measurable F)
    (j : CubeVertex) : Measurable (cubeVertexFactor F j) := by
  unfold cubeVertexFactor
  exact hF.comp (cubeProjection_continuous j).measurable

theorem cubeVertexFactor_nonneg (F : E3 → ℝ) (hF : ∀ y, 0 ≤ F y)
    (j : CubeVertex) (x : E6) : 0 ≤ cubeVertexFactor F j x := by
  unfold cubeVertexFactor
  exact hF _

theorem integrable_cubeVertexFactor_pow_of_bounded
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (F : E3 → ℝ) (hFmeas : Measurable F)
    (hFnonneg : ∀ y, 0 ≤ F y)
    (hFbound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, F y ≤ C)
    (j : CubeVertex) (n : ℕ) :
    Integrable (fun x ↦ cubeVertexFactor F j x ^ n)
      (cubeBracketMeasure α t p) := by
  letI : IsFiniteMeasure (cubeBracketMeasure α t p) :=
    isFiniteMeasure_cubeBracketMeasure α ht p
  change Integrable ((cubeVertexFactor F j) ^ n) (cubeBracketMeasure α t p)
  rcases hFbound with ⟨C, hC, hbound⟩
  refine Integrable.of_bound
    ((measurable_cubeVertexFactor F hFmeas j).pow_const n).aestronglyMeasurable
    (C ^ n) ?_
  filter_upwards [] with x
  simp only [Pi.pow_apply]
  rw [Real.norm_eq_abs,
    abs_of_nonneg (pow_nonneg (cubeVertexFactor_nonneg F hFnonneg j x) _)]
  apply pow_le_pow_left₀ (cubeVertexFactor_nonneg F hFnonneg j x)
  unfold cubeVertexFactor
  exact hbound _

theorem cubeSecondMoment_nonneg (α : Anisotropy) {t : ℝ} (ht : 0 ≤ t)
    (p : E3) (F : E3 → ℝ) :
    0 ≤ cubeSecondMoment α t p F := by
  unfold cubeSecondMoment
  apply integral_nonneg
  intro y
  exact mul_nonneg (sq_nonneg _) (anisotropicBracketKernel_nonneg α ht p y)

theorem integral_cubeVertexFactor_pow_two
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (F : E3 → ℝ) (j : CubeVertex) :
    ∫ x, cubeVertexFactor F j x ^ 2 ∂cubeBracketMeasure α t p =
      cubeSecondMoment α t p F * (2 / 9 : ℝ) ^ 3 := by
  rw [integral_cubeBracketMeasure_eq α ht p]
  let A : E3 → ℝ := fun y ↦ F y ^ 2 * anisotropicBracketKernel α t p y
  let C : E3 → ℝ := fun z ↦ anisotropicBracketKernel α t p z
  let G : E3 × E3 → ℝ := fun yz ↦ A yz.1 * C yz.2
  have hW (x : E6) :
      cubeBracketWeight α t p x =
        anisotropicBracketKernel α t p (cubeProjection j x) *
          anisotropicBracketKernel α t p (cubeProjection (cubeComplement j) x) := by
    simp only [cubeBracketWeight, anisotropicBracketKernel, cubeProjection, cubeComplement]
    rw [Fintype.prod_prod_type]
    have hEach (i : Fin 3) :
        (∏ b : Bool, bracketKernelAt (t ^ α.weight i) (p i) (x (i, b))) =
          bracketKernelAt (t ^ α.weight i) (p i) (x (i, j i)) *
            bracketKernelAt (t ^ α.weight i) (p i) (x (i, !(j i))) := by
      cases h : j i <;> simp [h, mul_comm]
    simp_rw [hEach]
    rw [Finset.prod_mul_distrib]
  calc
    _ = ∫ x : E6, G (cubeVertexSplit j x) := by
      apply integral_congr_ae
      filter_upwards [] with x
      rw [cubeVertexSplit_apply]
      simp only [G, A, C, cubeVertexFactor]
      rw [hW x]
      ring
    _ = ∫ yz : E3 × E3, G yz :=
      (cubeVertexSplit_measurePreserving j).integral_comp' G
    _ = (∫ y : E3, A y) * ∫ z : E3, C z := by
      change (∫ yz : E3 × E3, A yz.1 * C yz.2) = _
      exact integral_prod_mul A C
    _ = _ := by
      simp only [A, C, cubeSecondMoment]
      rw [integral_anisotropicBracketKernel α ht p]

/-- The edge Brascamp--Lieb inequality from `lem:bl`, retaining the literal
six-dimensional comparison measure and its unused-coordinate mass. -/
theorem cubeEdgeBracketAverage_le_product_secondMoments
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (F0 F1 : E3 → ℝ)
    (hF0meas : Measurable F0) (hF1meas : Measurable F1)
    (hF0nonneg : ∀ y, 0 ≤ F0 y) (hF1nonneg : ∀ y, 0 ≤ F1 y)
    (hF0bound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, F0 y ≤ C)
    (hF1bound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, F1 y ≤ C) :
    cubeEdgeBracketAverage α t p F0 F1 ≤
      √(cubeSecondMoment α t p F0) * √(cubeSecondMoment α t p F1) := by
  let j0 : CubeVertex := cubePairVertex false false
  let j1 : CubeVertex := cubePairVertex false true
  have hmeasure : cubeEdgeBracketAverage α t p F0 F1 =
      ∫ x, cubeVertexFactor F0 j0 x * cubeVertexFactor F1 j1 x
        ∂cubeBracketMeasure α t p := by
    unfold cubeEdgeBracketAverage cubeVertexFactor
    rw [integral_cubeBracketMeasure_eq α ht p]
    apply integral_congr_ae
    filter_upwards [] with x
    ring
  have hcs := integral_mul_le_sqrt_integral_sq (cubeBracketMeasure α t p)
    (cubeVertexFactor F0 j0) (cubeVertexFactor F1 j1)
    (measurable_cubeVertexFactor F0 hF0meas j0).aestronglyMeasurable
    (measurable_cubeVertexFactor F1 hF1meas j1).aestronglyMeasurable
    (by
      filter_upwards [] with x
      exact cubeVertexFactor_nonneg F0 hF0nonneg j0 x)
    (by
      filter_upwards [] with x
      exact cubeVertexFactor_nonneg F1 hF1nonneg j1 x)
    (integrable_cubeVertexFactor_pow_of_bounded α ht p F0 hF0meas hF0nonneg
      hF0bound j0 2)
    (integrable_cubeVertexFactor_pow_of_bounded α ht p F1 hF1meas hF1nonneg
      hF1bound j1 2)
  have hM0 : 0 ≤ cubeSecondMoment α t p F0 :=
    cubeSecondMoment_nonneg α ht.le p F0
  have hM1 : 0 ≤ cubeSecondMoment α t p F1 :=
    cubeSecondMoment_nonneg α ht.le p F1
  have hmass : (2 / 9 : ℝ) ^ 3 ≤ 1 := by norm_num
  have hs0 : √(cubeSecondMoment α t p F0 * (2 / 9 : ℝ) ^ 3) ≤
      √(cubeSecondMoment α t p F0) :=
    Real.sqrt_le_sqrt (mul_le_of_le_one_right hM0 hmass)
  have hs1 : √(cubeSecondMoment α t p F1 * (2 / 9 : ℝ) ^ 3) ≤
      √(cubeSecondMoment α t p F1) :=
    Real.sqrt_le_sqrt (mul_le_of_le_one_right hM1 hmass)
  calc
    cubeEdgeBracketAverage α t p F0 F1 =
        ∫ x, cubeVertexFactor F0 j0 x * cubeVertexFactor F1 j1 x
          ∂cubeBracketMeasure α t p := hmeasure
    _ ≤ √(∫ x, cubeVertexFactor F0 j0 x ^ 2 ∂cubeBracketMeasure α t p) *
        √(∫ x, cubeVertexFactor F1 j1 x ^ 2 ∂cubeBracketMeasure α t p) := hcs
    _ = √(cubeSecondMoment α t p F0 * (2 / 9 : ℝ) ^ 3) *
        √(cubeSecondMoment α t p F1 * (2 / 9 : ℝ) ^ 3) := by
      rw [integral_cubeVertexFactor_pow_two α ht p F0 j0,
        integral_cubeVertexFactor_pow_two α ht p F1 j1]
    _ ≤ _ := mul_le_mul hs0 hs1 (Real.sqrt_nonneg _) (by positivity)

/-! ### Finite forest reindexing

This is the exact finite endpoint cancellation used in the telescoping
identity: every non-root tree box occurs once as a child, and the remaining
children are precisely the leaves. -/

def treeChildrenAll {α : Anisotropy} (T : FiniteConvexTree α) :
    Finset (AnisoBox α) :=
  T.boxes.biUnion (boxChildren α)

theorem mem_treeChildrenAll_iff {α : Anisotropy} (T : FiniteConvexTree α)
    (r : AnisoBox α) :
    r ∈ treeChildrenAll T ↔ boxParent α r ∈ T.boxes := by
  constructor
  · intro hr
    rcases Finset.mem_biUnion.mp hr with ⟨q, hq, hrq⟩
    rcases Finset.mem_image.mp hrq with ⟨v, hv, hvr⟩
    subst r
    simpa only [boxParent_child] using hq
  · intro hr
    rcases (boxParent_eq_iff_exists_boxChild α (boxParent α r) r).mp rfl with
      ⟨v, hv⟩
    refine Finset.mem_biUnion.mpr ⟨boxParent α r, hr, ?_⟩
    exact Finset.mem_image.mpr ⟨v, Finset.mem_univ _, hv⟩

theorem root_not_mem_treeChildrenAll {α : Anisotropy} (T : FiniteConvexTree α) :
    T.root ∉ treeChildrenAll T := by
  intro hroot
  have hparent : boxParent α T.root ∈ T.boxes :=
    (mem_treeChildrenAll_iff T T.root).mp hroot
  have hsub : boxSet α (boxParent α T.root) ⊆ boxSet α T.root :=
    T.below_root _ hparent
  have hlevel := level_le_of_boxSet_subset α hsub
  change T.root.level + 1 ≤ T.root.level at hlevel
  omega

theorem boxParent_mem_tree_of_mem_ne_root {α : Anisotropy}
    (T : FiniteConvexTree α) {q : AnisoBox α}
    (hq : q ∈ T.boxes) (hqroot : q ≠ T.root) :
    boxParent α q ∈ T.boxes := by
  have hqsub : boxSet α q ⊆ boxSet α T.root := T.below_root q hq
  have hqle : q.level ≤ T.root.level := level_le_of_boxSet_subset α hqsub
  have hqnelevel : q.level ≠ T.root.level := by
    intro hlevel
    have hdisj := boxSet_disjoint_of_eq_level_of_ne α hlevel hqroot
    obtain ⟨x, hx⟩ := boxSet_nonempty α q
    exact (Set.disjoint_left.1 hdisj) hx (hqsub hx)
  have hqlt : q.level < T.root.level := lt_of_le_of_ne hqle hqnelevel
  apply T.convex hq T.root_mem (boxSet_subset_parent α q)
  apply boxSet_nested_of_inter_nonempty α
  · change q.level + 1 ≤ T.root.level
    omega
  · obtain ⟨x, hx⟩ := boxSet_nonempty α q
    exact ⟨x, boxSet_subset_parent α q hx, hqsub hx⟩

theorem treeChildrenAll_eq_erase_union_leaves {α : Anisotropy}
    (T : FiniteConvexTree α) :
    treeChildrenAll T = (T.boxes.erase T.root) ∪ treeLeaves T := by
  ext r
  constructor
  · intro hr
    by_cases hrT : r ∈ T.boxes
    · have hrne : r ≠ T.root := by
        intro hEq
        subst r
        exact root_not_mem_treeChildrenAll T hr
      exact Finset.mem_union_left _ (Finset.mem_erase.mpr ⟨hrne, hrT⟩)
    · exact Finset.mem_union_right _
        ((mem_treeLeaves_iff T r).mpr
          ⟨hrT, (mem_treeChildrenAll_iff T r).mp hr⟩)
  · intro hr
    rcases Finset.mem_union.mp hr with hr | hr
    · have hrT : r ∈ T.boxes := (Finset.mem_erase.mp hr).2
      have hrne : r ≠ T.root := (Finset.mem_erase.mp hr).1
      exact (mem_treeChildrenAll_iff T r).mpr
        (boxParent_mem_tree_of_mem_ne_root T hrT hrne)
    · exact (mem_treeChildrenAll_iff T r).mpr
        ((mem_treeLeaves_iff T r).mp hr).2

theorem treeEraseRoot_disjoint_leaves {α : Anisotropy} (T : FiniteConvexTree α) :
    Disjoint (T.boxes.erase T.root) (treeLeaves T) := by
  rw [Finset.disjoint_left]
  intro l hl hleaf
  exact treeLeaves_not_mem T hleaf (Finset.mem_erase.mp hl).2

theorem sum_treeChildrenAll_sub_sum_treeBoxes {α : Anisotropy}
    (T : FiniteConvexTree α) (w : AnisoBox α → ℝ) :
    (∑ r ∈ treeChildrenAll T, w r) - ∑ q ∈ T.boxes, w q =
      (∑ l ∈ treeLeaves T, w l) - w T.root := by
  rw [treeChildrenAll_eq_erase_union_leaves]
  rw [Finset.sum_union (treeEraseRoot_disjoint_leaves T)]
  rw [← Finset.sum_erase_add T.boxes w T.root_mem]
  ring

/-! ### Boundary-frontier mass contraction

The following finite descendants are the numerical core of the boundary
packing argument.  At one subdivision step they tile a fixed oriented face;
their total box mass contracts by the normal-coordinate radix. -/

def boundaryDigit (α : Anisotropy) (i : Fin 3) :
    FaceOrientation → Fin (anisoRadix α i)
  | .lower => ⟨0, anisoRadix_pos α i⟩
  | .upper => ⟨(anisoRadix α i).pred,
      Nat.pred_lt (Nat.ne_of_gt (anisoRadix_pos α i))⟩

def boundaryDigits (α : Anisotropy) (i : Fin 3)
    (ε : FaceOrientation) : Finset (AnisoDigit α) :=
  Finset.univ.filter fun v => v i = boundaryDigit α i ε

noncomputable def boundaryFaceChildren (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) : Finset (OrientedFace α) := by
  classical
  rcases S with ⟨q, ε⟩
  exact (boundaryDigits α i ε).image fun v => ⟨boxChild α q v, ε⟩

theorem card_boundaryDigits_mul_radix (α : Anisotropy) (i : Fin 3)
    (ε : FaceOrientation) :
    (boundaryDigits α i ε).card * anisoRadix α i =
      2 ^ α.homogeneousDimension := by
  unfold boundaryDigits
  rw [← Fintype.piFinset_univ]
  let s : ∀ j, Finset (Fin (anisoRadix α j)) := fun j => Finset.univ
  change ({v ∈ Fintype.piFinset s | v i = boundaryDigit α i ε}.card) *
      anisoRadix α i = 2 ^ α.homogeneousDimension
  have ha : boundaryDigit α i ε ∈ s i := Finset.mem_univ _
  have h := Fintype.card_filter_piFinset_eq_of_mem s i ha
  rw [h]
  calc
    (∏ j ∈ Finset.univ.erase i, (s j).card) * anisoRadix α i =
        ∏ j, anisoRadix α j := by
          simp [s]
          exact Finset.prod_erase_mul _ _ (Finset.mem_univ _)
    _ = 2 ^ α.homogeneousDimension := by
      unfold anisoRadix Anisotropy.homogeneousDimension
      rw [Finset.prod_pow_eq_pow_sum]

theorem boundaryFaceChild_injective (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) :
    Function.Injective (fun v : AnisoDigit α =>
      (⟨boxChild α S.box v, S.orientation⟩ : OrientedFace α)) := by
  intro v w h
  apply boxChild_injective α S.box
  exact congrArg OrientedFace.box h

theorem boundaryFaceChildren_sum_eq (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) :
    ∑ S' ∈ boundaryFaceChildren α i S, boxMass α S'.box =
      ∑ v ∈ boundaryDigits α i S.orientation,
        boxMass α (boxChild α S.box v) := by
  classical
  rcases S with ⟨q, ε⟩
  simp only [boundaryFaceChildren]
  rw [Finset.sum_image (boundaryFaceChild_injective α i ⟨q, ε⟩).injOn]

theorem boundaryFaceChildren_mass_mul_radix (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) :
    (∑ S' ∈ boundaryFaceChildren α i S, boxMass α S'.box) *
      (anisoRadix α i : ℝ) = boxMass α S.box := by
  classical
  have hDpos : 0 < 2 ^ α.homogeneousDimension := by positivity
  have hDne : (2 ^ α.homogeneousDimension : ℝ) ≠ 0 := by
    exact_mod_cast (Nat.ne_of_gt hDpos)
  apply mul_right_cancel₀ hDne
  rw [boundaryFaceChildren_sum_eq]
  have hcardNat : (boundaryDigits α i S.orientation).card * anisoRadix α i =
      2 ^ α.homogeneousDimension :=
    card_boundaryDigits_mul_radix α i S.orientation
  have hcard : ((boundaryDigits α i S.orientation).card : ℝ) *
      (anisoRadix α i : ℝ) = (2 ^ α.homogeneousDimension : ℝ) := by
    exact_mod_cast hcardNat
  have hsum :
      (∑ v ∈ boundaryDigits α i S.orientation,
          boxMass α (boxChild α S.box v)) *
        (2 ^ α.homogeneousDimension : ℝ) =
      (boundaryDigits α i S.orientation).card * boxMass α S.box := by
    rw [Finset.sum_mul]
    calc
      (∑ x ∈ boundaryDigits α i S.orientation,
          boxMass α (boxChild α S.box x) *
            (2 ^ α.homogeneousDimension : ℝ)) =
          ∑ _x ∈ boundaryDigits α i S.orientation, boxMass α S.box := by
            apply Finset.sum_congr rfl
            intro v hv
            exact boxMass_child_mul_card α S.box v
      _ = (boundaryDigits α i S.orientation).card * boxMass α S.box := by
          simp [nsmul_eq_mul]
  calc
    ((∑ v ∈ boundaryDigits α i S.orientation,
        boxMass α (boxChild α S.box v)) * (anisoRadix α i : ℝ)) *
        (2 ^ α.homogeneousDimension : ℝ) =
        ((∑ v ∈ boundaryDigits α i S.orientation,
          boxMass α (boxChild α S.box v)) *
            (2 ^ α.homogeneousDimension : ℝ)) * (anisoRadix α i : ℝ) := by ring
    _ = ((boundaryDigits α i S.orientation).card * boxMass α S.box) *
        (anisoRadix α i : ℝ) := by rw [hsum]
    _ = boxMass α S.box * ((boundaryDigits α i S.orientation).card *
        (anisoRadix α i : ℝ)) := by ring
    _ = boxMass α S.box * (2 ^ α.homogeneousDimension : ℝ) := by rw [hcard]

theorem boundaryFaceChildren_disjoint (α : Anisotropy) (i : Fin 3)
    (S T : OrientedFace α) (hne : S ≠ T) :
    Disjoint (boundaryFaceChildren α i S) (boundaryFaceChildren α i T) := by
  classical
  rw [Finset.disjoint_left]
  intro F hFS hFT
  rcases Finset.mem_image.mp hFS with ⟨v, hv, hvF⟩
  rcases Finset.mem_image.mp hFT with ⟨w, hw, hwF⟩
  have hEq : (⟨boxChild α S.box v, S.orientation⟩ : OrientedFace α) =
      ⟨boxChild α T.box w, T.orientation⟩ := hvF.trans hwF.symm
  have hChild' := congrArg (fun (F : OrientedFace α) => F.box) hEq
  change boxChild α S.box v = boxChild α T.box w at hChild'
  have hbox : S.box = T.box := by
    calc
      S.box = boxParent α (boxChild α S.box v) := (boxParent_child α S.box v).symm
      _ = boxParent α (boxChild α T.box w) := congrArg (boxParent α) hChild'
      _ = T.box := boxParent_child α T.box w
  have horient' := congrArg (fun (F : OrientedFace α) => F.orientation) hEq
  change S.orientation = T.orientation at horient'
  apply hne
  cases S
  cases T
  simp_all

noncomputable def boundaryFrontier (α : Anisotropy) (i : Fin 3) (q : AnisoBox α)
    (ε : FaceOrientation) : ℕ → Finset (OrientedFace α)
  | 0 => by classical exact {⟨q, ε⟩}
  | n + 1 => by
      classical
      exact (boundaryFrontier α i q ε n).biUnion (boundaryFaceChildren α i)

noncomputable def boundaryFrontierMass (α : Anisotropy) (i : Fin 3)
    (q : AnisoBox α) (ε : FaceOrientation) (n : ℕ) : ℝ :=
  ∑ S ∈ boundaryFrontier α i q ε n, boxMass α S.box

theorem boundaryFrontierMass_succ_mul_radix (α : Anisotropy) (i : Fin 3)
    (q : AnisoBox α) (ε : FaceOrientation) (n : ℕ) :
    boundaryFrontierMass α i q ε (n + 1) * (anisoRadix α i : ℝ) =
      boundaryFrontierMass α i q ε n := by
  classical
  unfold boundaryFrontierMass
  simp only [boundaryFrontier]
  have hdis : (↑(boundaryFrontier α i q ε n) : Set (OrientedFace α)).PairwiseDisjoint
      (boundaryFaceChildren α i) := by
    intro S hS T hT hne
    exact boundaryFaceChildren_disjoint α i S T hne
  rw [Finset.sum_biUnion hdis]
  rw [Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro S hS
  exact boundaryFaceChildren_mass_mul_radix α i S

theorem anisoRadix_two_le (α : Anisotropy) (i : Fin 3) :
    2 ≤ anisoRadix α i := by
  unfold anisoRadix
  calc
    2 = 2 ^ 1 := by norm_num
    _ ≤ 2 ^ α.weight i :=
      pow_le_pow_right₀ (by norm_num) (Nat.succ_le_iff.mpr (α.weight_pos i))

theorem boundaryFrontierMass_nonneg (α : Anisotropy) (i : Fin 3)
    (q : AnisoBox α) (ε : FaceOrientation) (n : ℕ) :
    0 ≤ boundaryFrontierMass α i q ε n := by
  unfold boundaryFrontierMass
  apply Finset.sum_nonneg
  intro S hS
  exact (boxMass_pos α S.box).le

theorem boundaryFrontierMass_succ_le_half (α : Anisotropy) (i : Fin 3)
    (q : AnisoBox α) (ε : FaceOrientation) (n : ℕ) :
    boundaryFrontierMass α i q ε (n + 1) ≤
      boundaryFrontierMass α i q ε n / 2 := by
  have hrec := boundaryFrontierMass_succ_mul_radix α i q ε n
  have hnonneg := boundaryFrontierMass_nonneg α i q ε (n + 1)
  have hRnat := anisoRadix_two_le α i
  have hR : (2 : ℝ) ≤ (anisoRadix α i : ℝ) := by exact_mod_cast hRnat
  nlinarith

theorem sum_range_le_two_of_half_contraction (M : ℕ → ℝ)
    (hM : ∀ n, 0 ≤ M n)
    (hstep : ∀ n, M (n + 1) ≤ M n / 2) (N : ℕ) :
    ∑ n ∈ Finset.range (N + 1), M n ≤ 2 * M 0 := by
  have haux : ∀ n : ℕ,
      (∑ j ∈ Finset.range (n + 1), M j) + 2 * M (n + 1) ≤ 2 * M 0 := by
    intro n
    induction n with
    | zero =>
      simp only [Finset.sum_range_succ, Finset.sum_range_zero]
      nlinarith [hstep 0]
    | succ n ih =>
      rw [Finset.sum_range_succ]
      have hs := hstep (n + 1)
      nlinarith
  have h := haux N
  nlinarith [hM (N + 1)]

theorem sum_boundaryFrontierMass_range_le_two (α : Anisotropy) (i : Fin 3)
    (q : AnisoBox α) (ε : FaceOrientation) (N : ℕ) :
    ∑ n ∈ Finset.range (N + 1), boundaryFrontierMass α i q ε n ≤
      2 * boxMass α q := by
  classical
  have h := sum_range_le_two_of_half_contraction
    (boundaryFrontierMass α i q ε)
    (boundaryFrontierMass_nonneg α i q ε)
    (boundaryFrontierMass_succ_le_half α i q ε) N
  simpa [boundaryFrontierMass, boundaryFrontier] using h

/-- Finite reindexing form of the source boundary-packing conclusion.  A
geometric charge sends every surviving face to a leaf or to the root, with a
bounded frontier depth; the three hypotheses below state exactly that the
charge is defined, that each fibre is dominated by its frontier, and that a
two-sided frontier has its geometric-series budget. -/
theorem facePackingMass_le_eight_of_charge
    {α : Anisotropy} (T : FiniteConvexTree α) (i : Fin 3) (N : ℕ)
    (charge : OrientedFace α → AnisoBox α × ℕ)
    (budget : AnisoBox α → ℕ → ℝ)
    (hmap : ∀ S ∈ survivingFacesAll T i,
      charge S ∈ (treeLeaves T ∪ {T.root}).product (Finset.range (N + 1)))
    (hbudget : ∀ L ∈ treeLeaves T ∪ {T.root}, ∀ n ∈ Finset.range (N + 1),
      (∑ S ∈ survivingFacesAll T i with charge S = (L, n), boxMass α S.box) ≤
        budget L n)
    (hhost : ∀ L ∈ treeLeaves T ∪ {T.root},
      (∑ n ∈ Finset.range (N + 1), budget L n) ≤ 4 * boxMass α L) :
    facePackingMass T i ≤ 8 * boxMass α T.root := by
  classical
  have hrootnot : T.root ∉ treeLeaves T := by
    intro hroot
    exact treeLeaves_not_mem T hroot T.root_mem
  have hdis : Disjoint (treeLeaves T) ({T.root} : Finset (AnisoBox α)) :=
    Finset.disjoint_singleton_right.mpr hrootnot
  calc
    facePackingMass T i =
        ∑ p ∈ (treeLeaves T ∪ {T.root}).product (Finset.range (N + 1)),
          ∑ S ∈ survivingFacesAll T i with charge S = p, boxMass α S.box := by
      unfold facePackingMass
      symm
      exact Finset.sum_fiberwise_of_maps_to hmap (fun S => boxMass α S.box)
    _ ≤ ∑ p ∈ (treeLeaves T ∪ {T.root}).product (Finset.range (N + 1)),
        budget p.1 p.2 := by
      apply Finset.sum_le_sum
      intro p hp
      rcases Finset.mem_product.mp hp with ⟨hpL, hpn⟩
      exact hbudget p.1 hpL p.2 hpn
    _ = ∑ L ∈ treeLeaves T ∪ {T.root},
        ∑ n ∈ Finset.range (N + 1), budget L n := by
      exact Finset.sum_product (treeLeaves T ∪ {T.root}) (Finset.range (N + 1))
        (fun p => budget p.1 p.2)
    _ ≤ ∑ L ∈ treeLeaves T ∪ {T.root}, 4 * boxMass α L := by
      apply Finset.sum_le_sum
      intro L hL
      exact hhost L hL
    _ = 8 * boxMass α T.root := by
      rw [Finset.sum_union hdis, Finset.sum_singleton]
      rw [← Finset.mul_sum]
      rw [← boxMass_root_eq_sum_boxMass_leaves T]
      ring

/-! ### Finite frontier realization of boundary packing

The preceding conditional reindexing theorem records the abstract finite
charge.  We now construct it concretely from the grid: a surviving face is
covered either by a root frontier or by the exterior frontier of a leaf.
-/

noncomputable def facePackingFrontierCover {α : Anisotropy}
    (T : FiniteConvexTree α) (i : Fin 3) (N : ℕ) : Finset (OrientedFace α) := by
  classical
  exact (Finset.range (N + 1)).biUnion fun n ↦
    (Finset.univ : Finset FaceOrientation).biUnion fun ε ↦
      boundaryFrontier α i T.root ε n ∪
        (treeLeaves T).biUnion fun L ↦
          boundaryFrontier α i (boxNeighbor α L i ε) ε.opposite n

theorem mem_facePackingFrontierCover_iff {α : Anisotropy}
    (T : FiniteConvexTree α) (i : Fin 3) (N : ℕ) (S : OrientedFace α) :
    S ∈ facePackingFrontierCover T i N ↔
      ∃ n ≤ N, ∃ ε : FaceOrientation,
        S ∈ boundaryFrontier α i T.root ε n ∨
          ∃ L ∈ treeLeaves T,
            S ∈ boundaryFrontier α i (boxNeighbor α L i ε) ε.opposite n := by
  classical
  simp [facePackingFrontierCover, Nat.lt_succ_iff]

theorem boundaryLower_div (R n : ℤ) (hR : 0 < R) :
    (R * n + 0 - 1) / R = n - 1 := by
  have hRne : R ≠ 0 := ne_of_gt hR
  rw [show R * n + 0 - 1 = R * (n - 1) + (R - 1) by ring]
  rw [Int.mul_add_ediv_left _ (R - 1) hRne]
  rw [Int.ediv_eq_zero_of_lt]
  · ring
  · omega
  · omega

theorem boundaryUpper_div (R n : ℤ) (hR : 0 < R) :
    (R * n + (R - 1) + 1) / R = n + 1 := by
  have hRne : R ≠ 0 := ne_of_gt hR
  rw [show R * n + (R - 1) + 1 = R * (n + 1) by ring]
  exact Int.mul_ediv_cancel_left _ hRne

theorem boundaryLower_div_iff (R n d : ℤ) (hR : 0 < R)
    (hd0 : 0 ≤ d) (hdR : d < R) :
    (R * n + d - 1) / R = n - 1 ↔ d = 0 := by
  constructor
  · intro h
    by_contra hne
    have hd : 1 ≤ d := by omega
    have hquot : n ≤ (R * n + d - 1) / R := by
      rw [Int.le_ediv_iff_mul_le hR]
      nlinarith
    omega
  · intro h
    subst d
    exact boundaryLower_div R n hR

theorem boundaryUpper_div_iff (R n d : ℤ) (hR : 0 < R)
    (_hd0 : 0 ≤ d) (hdR : d < R) :
    (R * n + d + 1) / R = n + 1 ↔ d = R - 1 := by
  constructor
  · intro h
    by_contra hne
    have hd : d ≤ R - 2 := by omega
    have hquot : (R * n + d + 1) / R < n + 1 := by
      rw [Int.ediv_lt_iff_lt_mul hR]
      nlinarith
    omega
  · intro h
    rw [h]
    exact boundaryUpper_div R n hR

theorem test_boxParent_neighbor_child_eq_neighbor_iff (α : Anisotropy)
    (q : AnisoBox α) (i : Fin 3) (ε : FaceOrientation) (v : AnisoDigit α) :
    boxParent α (boxNeighbor α (boxChild α q v) i ε) =
      boxNeighbor α q i ε ↔ v i = boundaryDigit α i ε := by
  cases q with
  | mk level index =>
    cases ε with
    | lower =>
      constructor
      · intro h
        have hi := congrFun (congrArg AnisoBox.index h) i
        simp [boxParent, boxNeighbor, boxChild, FaceOrientation.sign] at hi
        have hR : (0 : ℤ) < (anisoRadix α i : ℤ) := by
          exact_mod_cast anisoRadix_pos α i
        have hd0 : (0 : ℤ) ≤ (v i : ℤ) := by
          exact_mod_cast Nat.zero_le (v i).val
        have hdR : (v i : ℤ) < (anisoRadix α i : ℤ) := by
          exact_mod_cast (v i).isLt
        have hz : (v i : ℤ) = 0 :=
          (boundaryLower_div_iff (anisoRadix α i : ℤ) (index i) (v i : ℤ)
            hR hd0 hdR).mp (by simpa [sub_eq_add_neg] using hi)
        apply Fin.ext
        have hzNat : (v i).val = 0 := by exact_mod_cast hz
        simpa [boundaryDigit] using hzNat
      · intro h
        have hvalNat : (v i).val = 0 := by
          have := congrArg Fin.val h
          simpa [boundaryDigit] using this
        have hval : (v i : ℤ) = 0 := by exact_mod_cast hvalNat
        simp only [boxParent, boxNeighbor, boxChild, AnisoBox.mk.injEq]
        constructor
        · omega
        · funext j
          by_cases hji : j = i
          · subst j
            simp only [if_pos]
            simpa [hval, FaceOrientation.sign, sub_eq_add_neg] using
              boundaryLower_div (anisoRadix α i : ℤ) (index i) (by
                exact_mod_cast anisoRadix_pos α i)
          · simp only [if_neg hji]
            rw [Int.mul_add_ediv_left]
            · rw [Int.ediv_eq_zero_of_lt]
              · simp
              · exact_mod_cast Nat.zero_le (v j).val
              · exact_mod_cast (v j).isLt
            · exact_mod_cast (Nat.ne_of_gt (anisoRadix_pos α j))
    | upper =>
      constructor
      · intro h
        have hi := congrFun (congrArg AnisoBox.index h) i
        simp [boxParent, boxNeighbor, boxChild, FaceOrientation.sign] at hi
        have hR : (0 : ℤ) < (anisoRadix α i : ℤ) := by
          exact_mod_cast anisoRadix_pos α i
        have hd0 : (0 : ℤ) ≤ (v i : ℤ) := by
          exact_mod_cast Nat.zero_le (v i).val
        have hdR : (v i : ℤ) < (anisoRadix α i : ℤ) := by
          exact_mod_cast (v i).isLt
        have hz : (v i : ℤ) = (anisoRadix α i : ℤ) - 1 :=
          (boundaryUpper_div_iff (anisoRadix α i : ℤ) (index i) (v i : ℤ)
            hR hd0 hdR).mp hi
        have hpred : ((anisoRadix α i).pred : ℤ) =
            (anisoRadix α i : ℤ) - 1 := by
          rw [Nat.pred_eq_sub_one]
          rw [Nat.cast_sub (Nat.succ_le_iff.mpr (anisoRadix_pos α i))]
          norm_num
        apply Fin.ext
        have hzNat : (v i).val = (anisoRadix α i).pred := by
          exact_mod_cast (hz.trans hpred.symm)
        simpa [boundaryDigit] using hzNat
      · intro h
        have hvalNat : (v i).val = (anisoRadix α i).pred := by
          have := congrArg Fin.val h
          simpa [boundaryDigit] using this
        have hpred : ((anisoRadix α i).pred : ℤ) =
            (anisoRadix α i : ℤ) - 1 := by
          rw [Nat.pred_eq_sub_one]
          rw [Nat.cast_sub (Nat.succ_le_iff.mpr (anisoRadix_pos α i))]
          norm_num
        have hval : (v i : ℤ) = (anisoRadix α i : ℤ) - 1 := by
          calc
            (v i : ℤ) = ((anisoRadix α i).pred : ℤ) := by
              exact_mod_cast hvalNat
            _ = (anisoRadix α i : ℤ) - 1 := hpred
        simp only [boxParent, boxNeighbor, boxChild, AnisoBox.mk.injEq]
        constructor
        · omega
        · funext j
          by_cases hji : j = i
          · subst j
            simp only [if_pos]
            simpa [hval, FaceOrientation.sign] using
              boundaryUpper_div (anisoRadix α i : ℤ) (index i) (by
                exact_mod_cast anisoRadix_pos α i)
          · simp only [if_neg hji]
            rw [Int.mul_add_ediv_left]
            · rw [Int.ediv_eq_zero_of_lt]
              · simp
              · exact_mod_cast Nat.zero_le (v j).val
              · exact_mod_cast (v j).isLt
            · exact_mod_cast (Nat.ne_of_gt (anisoRadix_pos α j))

theorem test_boxAncestor_parent (α : Anisotropy) (n : ℕ) (q : AnisoBox α) :
    boxAncestor α n (boxParent α q) = boxAncestor α (n + 1) q := by
  induction n with
  | zero => simp [boxAncestor]
  | succ n ih =>
    rw [boxAncestor_succ, boxAncestor_succ, ih]

theorem test_mem_boundaryFaceChildren_iff {α : Anisotropy} (i : Fin 3)
    (P S : OrientedFace α) :
    S ∈ boundaryFaceChildren α i P ↔
      ∃ v : AnisoDigit α, v i = boundaryDigit α i P.orientation ∧
        S = ⟨boxChild α P.box v, P.orientation⟩ := by
  classical
  rcases P with ⟨q, ε⟩
  unfold boundaryFaceChildren
  constructor
  · intro h
    rcases Finset.mem_image.mp h with ⟨v, hv, hvs⟩
    exact ⟨v, (Finset.mem_filter.mp hv).2, hvs.symm⟩
  · rintro ⟨v, hv, rfl⟩
    exact Finset.mem_image.mpr ⟨v,
      Finset.mem_filter.mpr ⟨Finset.mem_univ _, hv⟩, rfl⟩

theorem test_mem_boundaryFaceChildren_of_parent_neighbor
    {α : Anisotropy} (i : Fin 3) (P S : OrientedFace α)
    (horient : S.orientation = P.orientation)
    (hparent : boxParent α S.box = P.box)
    (hneighbor : boxParent α (boxNeighbor α S.box i S.orientation) =
      boxNeighbor α P.box i P.orientation) :
    S ∈ boundaryFaceChildren α i P := by
  classical
  rcases exists_boxChild_eq_of_boxParent_eq α P.box S.box hparent with ⟨v, hv⟩
  apply (test_mem_boundaryFaceChildren_iff i P S).mpr
  refine ⟨v, ?_, ?_⟩
  · apply (test_boxParent_neighbor_child_eq_neighbor_iff α P.box i P.orientation v).mp
    simpa [hv, horient] using hneighbor
  · cases P
    cases S
    simp_all

theorem test_mem_boundaryFrontier_of_ancestor
    {α : Anisotropy} (i : Fin 3) (q : AnisoBox α) (ε : FaceOrientation)
    (n : ℕ) (S : OrientedFace α)
    (horient : S.orientation = ε)
    (hbox : boxAncestor α n S.box = q)
    (hneighbor : boxAncestor α n (boxNeighbor α S.box i ε) =
      boxNeighbor α q i ε) :
    S ∈ boundaryFrontier α i q ε n := by
  induction n generalizing S with
  | zero =>
    have hbox' : S.box = q := by simpa [boxAncestor] using hbox
    have hS : S = ⟨q, ε⟩ := by
      cases S
      simp_all
    simpa [boundaryFrontier, hS]
  | succ n ih =>
    have hparentneighbor :
        boxParent α (boxNeighbor α S.box i ε) =
          boxNeighbor α (boxParent α S.box) i ε := by
      rcases boxParent_neighbor_eq_or_neighbor α S.box i ε with hsame | hnext
      · exfalso
        have hEq : boxNeighbor α q i ε = q := by
          calc
            boxNeighbor α q i ε =
                boxAncestor α (n + 1) (boxNeighbor α S.box i ε) :=
                  hneighbor.symm
            _ = boxAncestor α n (boxParent α (boxNeighbor α S.box i ε)) :=
              (test_boxAncestor_parent α n
                (boxNeighbor α S.box i ε)).symm
            _ = boxAncestor α n (boxParent α S.box) :=
              congrArg (boxAncestor α n) hsame
            _ = boxAncestor α (n + 1) S.box :=
              test_boxAncestor_parent α n S.box
            _ = q := by simpa [Nat.succ_eq_add_one] using hbox
        exact boxNeighbor_ne_self α q i ε hEq
      · exact hnext
    let P : OrientedFace α := ⟨boxParent α S.box, ε⟩
    have hP : P ∈ boundaryFrontier α i q ε n := by
      apply ih P
      · simp [P]
      · change boxAncestor α n (boxParent α S.box) = q
        rw [test_boxAncestor_parent]
        simpa [Nat.succ_eq_add_one] using hbox
      · change boxAncestor α n
            (boxNeighbor α (boxParent α S.box) i ε) =
              boxNeighbor α q i ε
        rw [← hparentneighbor, test_boxAncestor_parent]
        simpa [Nat.succ_eq_add_one] using hneighbor
    simp only [boundaryFrontier]
    apply Finset.mem_biUnion.mpr
    refine ⟨P, hP, ?_⟩
    apply test_mem_boundaryFaceChildren_of_parent_neighbor i P S
    · simp [P, horient]
    · simp [P]
    · simpa [P, horient] using hparentneighbor

theorem test_boxAncestor_neighbor_eq_neighbor_of_not_subset
    (α : Anisotropy) (n : ℕ) (q L : AnisoBox α) (i : Fin 3)
    (ε : FaceOrientation)
    (hL : boxAncestor α n q = L)
    (hnot : ¬ boxSet α (boxNeighbor α q i ε) ⊆ boxSet α L) :
    boxAncestor α n (boxNeighbor α q i ε) = boxNeighbor α L i ε := by
  rcases boxAncestor_neighbor_eq_or_neighbor α n q i ε with hsame | hneighbor
  · exfalso
    apply hnot
    calc
      boxSet α (boxNeighbor α q i ε) ⊆
          boxSet α (boxAncestor α n (boxNeighbor α q i ε)) :=
        boxAncestor_subset α n _
      _ = boxSet α (boxAncestor α n q) := by rw [hsame]
      _ = boxSet α L := by rw [hL]
  · simpa only [hL] using hneighbor

theorem test_survivingFace_mem_rootFrontier
    {α : Anisotropy} (T : FiniteConvexTree α) (i : Fin 3)
    (S : OrientedFace α) (hS : S ∈ survivingFacesAll T i)
    (hout : ¬ boxSet α (boxNeighbor α S.box i S.orientation) ⊆
      boxSet α T.root) :
    S ∈ boundaryFrontier α i T.root S.orientation
      (T.root.level - S.box.level).toNat := by
  have hbox : S.box ∈ T.boxes := (mem_survivingFacesAll_iff T i S).mp hS |>.1
  have hsub : boxSet α S.box ⊆ boxSet α T.root := T.below_root S.box hbox
  have hancestor :
      boxAncestor α (T.root.level - S.box.level).toNat S.box = T.root :=
    boxAncestor_eq_of_boxSet_subset α hsub
  apply test_mem_boundaryFrontier_of_ancestor i T.root S.orientation
  · rfl
  · exact hancestor
  · exact test_boxAncestor_neighbor_eq_neighbor_of_not_subset α
      (T.root.level - S.box.level).toNat S.box T.root i S.orientation
      hancestor hout

theorem test_survivingFace_mem_leafExteriorFrontier
    {α : Anisotropy} (T : FiniteConvexTree α) (i : Fin 3)
    (S : OrientedFace α) (hS : S ∈ survivingFacesAll T i)
    (hout : boxSet α (boxNeighbor α S.box i S.orientation) ⊆
      boxSet α T.root) :
    ∃ L ∈ treeLeaves T,
      S ∈ boundaryFrontier α i
        (boxNeighbor α L i S.orientation.opposite) S.orientation
        (L.level - S.box.level).toNat := by
  let qout : AnisoBox α := boxNeighbor α S.box i S.orientation
  have hSbox : S.box ∈ T.boxes :=
    (mem_survivingFacesAll_iff T i S).mp hS |>.1
  have hqoutnot : qout ∉ T.boxes := by
    simpa [qout] using (mem_survivingFacesAll_iff T i S).mp hS |>.2
  rcases exists_leaf_container_of_boxSet_subset_root T qout (by simpa [qout] using hout)
      hqoutnot with ⟨L, hL, hqoutL, hqoutlevel⟩
  refine ⟨L, hL, ?_⟩
  have hinside : ¬ boxSet α S.box ⊆ boxSet α L := by
    intro hinside
    have hLtree : L ∈ T.boxes :=
      T.convex hSbox (treeLeaves_parent_mem T hL)
        hinside (boxSet_subset_parent α L)
    exact treeLeaves_not_mem T hL hLtree
  have hancestorout :
      boxAncestor α (L.level - qout.level).toNat qout = L :=
    boxAncestor_eq_of_boxSet_subset α hqoutL
  have hnot : ¬ boxSet α
      (boxNeighbor α qout i S.orientation.opposite) ⊆ boxSet α L := by
    simpa [qout, boxNeighbor_neighbor_opposite] using hinside
  have hancestorinside :
      boxAncestor α (L.level - qout.level).toNat S.box =
        boxNeighbor α L i S.orientation.opposite := by
    have h := test_boxAncestor_neighbor_eq_neighbor_of_not_subset α
      (L.level - qout.level).toNat qout L i S.orientation.opposite
      hancestorout hnot
    simpa [qout, boxNeighbor_neighbor_opposite] using h
  have hfront := test_mem_boundaryFrontier_of_ancestor i
    (boxNeighbor α L i S.orientation.opposite) S.orientation
    (L.level - qout.level).toNat S rfl hancestorinside (by
      have hinverse : boxNeighbor α
          (boxNeighbor α L i S.orientation.opposite) i S.orientation = L := by
        cases S.orientation <;>
          exact boxNeighbor_neighbor_opposite α L i _
      rw [hinverse]
      simpa [qout] using hancestorout)
  simpa [qout, boxNeighbor_level] using hfront

noncomputable def facePackingDepth {α : Anisotropy}
    (T : FiniteConvexTree α) (i : Fin 3) : ℕ :=
  ∑ S ∈ survivingFacesAll T i, (T.root.level - S.box.level).toNat

theorem test_facePackingDepth_bound {α : Anisotropy}
    (T : FiniteConvexTree α) (i : Fin 3) (S : OrientedFace α)
    (hS : S ∈ survivingFacesAll T i) :
    (T.root.level - S.box.level).toNat ≤ facePackingDepth T i := by
  unfold facePackingDepth
  exact Finset.single_le_sum
    (f := fun S ↦ (T.root.level - S.box.level).toNat)
    (fun _ _ ↦ Nat.zero_le _) hS

theorem test_leaf_depth_le_facePackingDepth {α : Anisotropy}
    (T : FiniteConvexTree α) (i : Fin 3) (S : OrientedFace α)
    (hS : S ∈ survivingFacesAll T i) (L : AnisoBox α)
    (hL : L ∈ treeLeaves T) :
    (L.level - S.box.level).toNat ≤ facePackingDepth T i := by
  apply le_trans (Int.toNat_le_toNat ?_) (test_facePackingDepth_bound T i S hS)
  have hLlevel : L.level ≤ T.root.level :=
    level_le_of_boxSet_subset α (boxSet_leaf_subset_root T hL)
  omega

theorem test_survivingFacesAll_subset_facePackingFrontierCover
    {α : Anisotropy} (T : FiniteConvexTree α) (i : Fin 3) :
    survivingFacesAll T i ⊆
      facePackingFrontierCover T i (facePackingDepth T i) := by
  intro S hS
  by_cases hout : boxSet α (boxNeighbor α S.box i S.orientation) ⊆
      boxSet α T.root
  · rcases test_survivingFace_mem_leafExteriorFrontier T i S hS hout with
        ⟨L, hL, hfront⟩
    apply (mem_facePackingFrontierCover_iff T i (facePackingDepth T i) S).mpr
    refine ⟨(L.level - S.box.level).toNat,
      test_leaf_depth_le_facePackingDepth T i S hS L hL,
      S.orientation.opposite, ?_⟩
    right
    refine ⟨L, hL, ?_⟩
    simpa only [FaceOrientation.opposite_opposite] using hfront
  · apply (mem_facePackingFrontierCover_iff T i (facePackingDepth T i) S).mpr
    refine ⟨(T.root.level - S.box.level).toNat,
      test_facePackingDepth_bound T i S hS, S.orientation, ?_⟩
    left
    exact test_survivingFace_mem_rootFrontier T i S hS hout

theorem test_sum_union_le_of_nonneg {β : Type*} [DecidableEq β]
    (w : β → ℝ) (s t : Finset β) (hw : ∀ x, 0 ≤ w x) :
    (∑ x ∈ s ∪ t, w x) ≤ (∑ x ∈ s, w x) + ∑ x ∈ t, w x := by
  rw [← Finset.sum_union_inter]
  exact le_add_of_nonneg_right (Finset.sum_nonneg fun x _ ↦ hw x)

theorem test_sum_biUnion_le_of_nonneg {β γ : Type*} [DecidableEq β]
    [DecidableEq γ] (w : β → ℝ) (s : Finset γ) (t : γ → Finset β)
    (hw : ∀ x, 0 ≤ w x) :
    (∑ x ∈ s.biUnion t, w x) ≤ ∑ a ∈ s, ∑ x ∈ t a, w x := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
    rw [Finset.biUnion_insert]
    calc
      (∑ x ∈ t a ∪ s.biUnion t, w x) ≤
          (∑ x ∈ t a, w x) + ∑ x ∈ s.biUnion t, w x :=
        test_sum_union_le_of_nonneg w (t a) (s.biUnion t) hw
      _ ≤ (∑ x ∈ t a, w x) + ∑ b ∈ s, ∑ x ∈ t b, w x :=
        add_le_add_right ih _
      _ = ∑ b ∈ insert a s, ∑ x ∈ t b, w x := by
        rw [Finset.sum_insert ha]

theorem test_faceOrientation_univ :
    (Finset.univ : Finset FaceOrientation) =
      {FaceOrientation.lower, FaceOrientation.upper} := by
  ext ε
  cases ε <;> simp

theorem test_rootFrontierBudget_le_four (α : Anisotropy) (i : Fin 3)
    (q : AnisoBox α) (N : ℕ) :
    (∑ ε : FaceOrientation, ∑ n ∈ Finset.range (N + 1),
      boundaryFrontierMass α i q ε n) ≤ 4 * boxMass α q := by
  have hlower := sum_boundaryFrontierMass_range_le_two α i q FaceOrientation.lower N
  have hupper := sum_boundaryFrontierMass_range_le_two α i q FaceOrientation.upper N
  rw [test_faceOrientation_univ]
  rw [Finset.sum_insert (by decide)]
  simp
  nlinarith

theorem test_leafExteriorFrontierBudget_le_four (α : Anisotropy) (i : Fin 3)
    (L : AnisoBox α) (N : ℕ) :
    (∑ ε : FaceOrientation, ∑ n ∈ Finset.range (N + 1),
      boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n) ≤
      4 * boxMass α L := by
  have hlower := sum_boundaryFrontierMass_range_le_two α i
    (boxNeighbor α L i FaceOrientation.lower) FaceOrientation.upper N
  have hupper := sum_boundaryFrontierMass_range_le_two α i
    (boxNeighbor α L i FaceOrientation.upper) FaceOrientation.lower N
  rw [test_faceOrientation_univ]
  rw [Finset.sum_insert (by decide)]
  simp only [Finset.sum_singleton, FaceOrientation.opposite]
  change _ ≤ 2 * boxMass α L at hlower
  change _ ≤ 2 * boxMass α L at hupper
  nlinarith

theorem test_facePackingFrontierCover_mass_le
    {α : Anisotropy} (T : FiniteConvexTree α) (i : Fin 3) (N : ℕ) :
    (∑ S ∈ facePackingFrontierCover T i N, boxMass α S.box) ≤
      ∑ n ∈ Finset.range (N + 1), ∑ ε : FaceOrientation,
        (boundaryFrontierMass α i T.root ε n +
          ∑ L ∈ treeLeaves T,
            boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n) := by
  classical
  unfold facePackingFrontierCover
  calc
    (∑ S ∈ (Finset.range (N + 1)).biUnion (fun n ↦
        (Finset.univ : Finset FaceOrientation).biUnion (fun ε ↦
          boundaryFrontier α i T.root ε n ∪
            (treeLeaves T).biUnion (fun L ↦
              boundaryFrontier α i (boxNeighbor α L i ε) ε.opposite n))),
        boxMass α S.box) ≤
        ∑ n ∈ Finset.range (N + 1),
          ∑ S ∈ (Finset.univ : Finset FaceOrientation).biUnion (fun ε ↦
            boundaryFrontier α i T.root ε n ∪
              (treeLeaves T).biUnion (fun L ↦
                boundaryFrontier α i (boxNeighbor α L i ε) ε.opposite n)),
            boxMass α S.box := by
      apply test_sum_biUnion_le_of_nonneg
      intro S
      exact (boxMass_pos α S.box).le
    _ ≤ ∑ n ∈ Finset.range (N + 1), ∑ ε : FaceOrientation,
        (boundaryFrontierMass α i T.root ε n +
          ∑ L ∈ treeLeaves T,
            boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n) := by
      apply Finset.sum_le_sum
      intro n hn
      calc
        (∑ S ∈ (Finset.univ : Finset FaceOrientation).biUnion (fun ε ↦
            boundaryFrontier α i T.root ε n ∪
              (treeLeaves T).biUnion (fun L ↦
                boundaryFrontier α i (boxNeighbor α L i ε) ε.opposite n)),
            boxMass α S.box) ≤
            ∑ ε : FaceOrientation,
              ∑ S ∈ boundaryFrontier α i T.root ε n ∪
                (treeLeaves T).biUnion (fun L ↦
                  boundaryFrontier α i (boxNeighbor α L i ε) ε.opposite n),
                boxMass α S.box := by
          apply test_sum_biUnion_le_of_nonneg
          intro S
          exact (boxMass_pos α S.box).le
        _ ≤ ∑ ε : FaceOrientation,
            (boundaryFrontierMass α i T.root ε n +
              ∑ L ∈ treeLeaves T,
                boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n) := by
          apply Finset.sum_le_sum
          intro ε hε
          calc
            (∑ S ∈ boundaryFrontier α i T.root ε n ∪
                (treeLeaves T).biUnion (fun L ↦
                  boundaryFrontier α i (boxNeighbor α L i ε) ε.opposite n),
                boxMass α S.box) ≤
                (∑ S ∈ boundaryFrontier α i T.root ε n, boxMass α S.box) +
                  ∑ S ∈ (treeLeaves T).biUnion (fun L ↦
                    boundaryFrontier α i (boxNeighbor α L i ε) ε.opposite n),
                    boxMass α S.box :=
              test_sum_union_le_of_nonneg _ _ _ (fun S ↦ (boxMass_pos α S.box).le)
            _ ≤ (∑ S ∈ boundaryFrontier α i T.root ε n, boxMass α S.box) +
                  ∑ L ∈ treeLeaves T,
                    ∑ S ∈ boundaryFrontier α i (boxNeighbor α L i ε) ε.opposite n,
                      boxMass α S.box := by
              apply add_le_add_right
              apply test_sum_biUnion_le_of_nonneg
              intro S
              exact (boxMass_pos α S.box).le
            _ = boundaryFrontierMass α i T.root ε n +
                  ∑ L ∈ treeLeaves T,
                    boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n := by
              rfl

theorem test_frontierBudget_le_eight
    {α : Anisotropy} (T : FiniteConvexTree α) (i : Fin 3) (N : ℕ) :
    (∑ n ∈ Finset.range (N + 1), ∑ ε : FaceOrientation,
      (boundaryFrontierMass α i T.root ε n +
        ∑ L ∈ treeLeaves T,
          boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n)) ≤
      8 * boxMass α T.root := by
  have hrootorder :
      (∑ n ∈ Finset.range (N + 1), ∑ ε : FaceOrientation,
        boundaryFrontierMass α i T.root ε n) =
        ∑ ε : FaceOrientation, ∑ n ∈ Finset.range (N + 1),
          boundaryFrontierMass α i T.root ε n := by
    exact Finset.sum_comm
  have hleaforder :
      (∑ n ∈ Finset.range (N + 1), ∑ ε : FaceOrientation,
        ∑ L ∈ treeLeaves T,
          boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n) =
        ∑ L ∈ treeLeaves T, ∑ ε : FaceOrientation,
          ∑ n ∈ Finset.range (N + 1),
            boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n := by
    calc
      (∑ n ∈ Finset.range (N + 1), ∑ ε : FaceOrientation,
        ∑ L ∈ treeLeaves T,
          boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n) =
          ∑ ε : FaceOrientation, ∑ n ∈ Finset.range (N + 1),
            ∑ L ∈ treeLeaves T,
              boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n :=
        Finset.sum_comm
      _ = ∑ ε : FaceOrientation, ∑ L ∈ treeLeaves T,
            ∑ n ∈ Finset.range (N + 1),
              boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n := by
        apply Finset.sum_congr rfl
        intro ε hε
        exact Finset.sum_comm
      _ = ∑ L ∈ treeLeaves T, ∑ ε : FaceOrientation,
            ∑ n ∈ Finset.range (N + 1),
              boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n :=
        Finset.sum_comm
  calc
    (∑ n ∈ Finset.range (N + 1), ∑ ε : FaceOrientation,
      (boundaryFrontierMass α i T.root ε n +
        ∑ L ∈ treeLeaves T,
          boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n)) =
        (∑ ε : FaceOrientation, ∑ n ∈ Finset.range (N + 1),
          boundaryFrontierMass α i T.root ε n) +
        ∑ L ∈ treeLeaves T, ∑ ε : FaceOrientation,
          ∑ n ∈ Finset.range (N + 1),
            boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n := by
      simp_rw [Finset.sum_add_distrib]
      rw [hrootorder, hleaforder]
    _ ≤ 4 * boxMass α T.root +
        ∑ L ∈ treeLeaves T, 4 * boxMass α L := by
      apply add_le_add
      · exact test_rootFrontierBudget_le_four α i T.root N
      · apply Finset.sum_le_sum
        intro L hL
        exact test_leafExteriorFrontierBudget_le_four α i L N
    _ = 8 * boxMass α T.root := by
      rw [← Finset.mul_sum]
      rw [← boxMass_root_eq_sum_boxMass_leaves T]
      ring

theorem facePackingMass_le_eight
    {α : Anisotropy} (T : FiniteConvexTree α) (i : Fin 3) :
    facePackingMass T i ≤ 8 * boxMass α T.root := by
  classical
  calc
    facePackingMass T i = ∑ S ∈ survivingFacesAll T i, boxMass α S.box := rfl
    _ ≤ ∑ S ∈ facePackingFrontierCover T i (facePackingDepth T i),
          boxMass α S.box := by
      apply Finset.sum_le_sum_of_subset_of_nonneg
        (test_survivingFacesAll_subset_facePackingFrontierCover T i)
      intro S hS hnot
      exact (boxMass_pos α S.box).le
    _ ≤ ∑ n ∈ Finset.range (facePackingDepth T i + 1),
          ∑ ε : FaceOrientation,
            (boundaryFrontierMass α i T.root ε n +
              ∑ L ∈ treeLeaves T,
                boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n) :=
      test_facePackingFrontierCover_mass_le T i (facePackingDepth T i)
    _ ≤ 8 * boxMass α T.root :=
      test_frontierBudget_le_eight T i (facePackingDepth T i)

/-! ### Local cubical forms and coordinate copies

These definitions are the literal signed local forms from Section 4 of the
blueprint.  They are kept separate from the positive bracket-kernel averages
above: the latter supply local sizes, while these forms carry the Gaussian
telescoping identity. -/

/-- The two large Gaussian widths and the one unscaled width in the local
cube form. -/
def cubeWidth (i : Fin 3) (lam : ℝ) : ℝ :=
  if i = 0 ∨ i = 1 then lam else 1

/-- The translated third-coordinate center shift in the local cube form. -/
def cubeCenterShift (i : Fin 3) (r : ℝ) : ℝ :=
  if i = 2 then r else 0

/-- The source range `λ ≥ 1` makes every Gaussian width strictly positive. -/
theorem cubeWidth_pos_of_one_le (i : Fin 3) {lam : ℝ} (hlam : 1 ≤ lam) :
    0 < cubeWidth i lam := by
  unfold cubeWidth
  split_ifs with hi
  · linarith
  · positivity

theorem cubeGaussianScale_pos (α : Anisotropy) (i : Fin 3)
    {lam t : ℝ} (hlam : 1 ≤ lam) (ht : 0 < t) :
    0 < cubeWidth i lam * t ^ α.weight i := by
  exact mul_pos (cubeWidth_pos_of_one_le i hlam) (pow_pos ht _)

theorem cubeGaussianScale_ne_zero (α : Anisotropy) (i : Fin 3)
    {lam t : ℝ} (hlam : 1 ≤ lam) (ht : 0 < t) :
    cubeWidth i lam * t ^ α.weight i ≠ 0 :=
  (cubeGaussianScale_pos α i hlam ht).ne'

/-- Replace one center coordinate while retaining the ambient Euclidean
representation.  This packages the one-dimensional center variable used in
the scalar divergence identity. -/
noncomputable def cubeCenterReplace (p : E3) (i : Fin 3) (a : ℝ) : E3 :=
  WithLp.toLp 2 (Function.update (WithLp.ofLp p) i a)

@[simp]
theorem cubeCenterReplace_apply_same (p : E3) (i : Fin 3) (a : ℝ) :
    cubeCenterReplace p i a i = a := by
  simp [cubeCenterReplace]

theorem cubeCenterReplace_apply_ne (p : E3) (i j : Fin 3) (a : ℝ)
    (hji : j ≠ i) :
    cubeCenterReplace p i a j = p j := by
  simp [cubeCenterReplace, hji]

theorem cubeCenterReplace_replace (p : E3) (i : Fin 3) (q r : ℝ) :
    cubeCenterReplace (cubeCenterReplace p i q) i r =
      cubeCenterReplace p i r := by
  ext j
  by_cases hji : j = i
  · subst j
    simp
  · simp [cubeCenterReplace, hji]

/-- The source kernel `G_i` at a fixed center and scale. -/
def cubeGaussianKernel (α : Anisotropy) (lam r t : ℝ) (p : E3)
    (i : Fin 3) : ℝ → ℝ :=
  gaussianAt (cubeWidth i lam * t ^ α.weight i)
    (p i + cubeCenterShift i r * t ^ α.weight i)

/-- The source kernel `H_i` at a fixed center and scale. -/
def cubeGaussianDerivKernel (α : Anisotropy) (lam r t : ℝ) (p : E3)
    (i : Fin 3) : ℝ → ℝ :=
  gaussianDerivAt (cubeWidth i lam * t ^ α.weight i)
    (p i + cubeCenterShift i r * t ^ α.weight i)

/-- The signed product of the eight cube inputs. -/
def cubeSignedInputProduct (F : CubeVertex → E3 → ℝ) (x : E6) : ℝ :=
  ∏ j : CubeVertex, F j (cubeProjection j x)

/-- The six-variable local kernel with the derivative pair in coordinate
`i`, as in `eq:cubeform`. -/
def localCubeKernel (α : Anisotropy) (i : Fin 3)
    (lam r t : ℝ) (p : E3) (x : E6) : ℝ :=
  ∏ q : Fin 3 × Bool,
    if q.1 = i then
      cubeGaussianDerivKernel α lam r t p q.1 (x q)
    else
      cubeGaussianKernel α lam r t p q.1 (x q)

/-- The one-dimensional density `1_{t>0}dt/t` used for the scale variable. -/
noncomputable def cubeScaleDensity (t : ℝ) : ℝ≥0∞ :=
  if 0 < t then ENNReal.ofReal t⁻¹ else 0

theorem measurable_cubeScaleDensity : Measurable cubeScaleDensity := by
  unfold cubeScaleDensity
  exact Measurable.ite measurableSet_Ioi
    (measurable_id.inv.ennreal_ofReal) measurable_const

@[simp]
theorem cubeScaleDensity_eq_of_pos {t : ℝ} (ht : 0 < t) :
    cubeScaleDensity t = ENNReal.ofReal t⁻¹ := by
  simp [cubeScaleDensity, ht]

/-- The center--scale measure `dp dt/t` on the positive scale half-space,
written as a product measure so that its Fubini decomposition is literal. -/
noncomputable def cubeScaleMeasure : Measure (E3 × ℝ) :=
  (volume : Measure E3).prod ((volume : Measure ℝ).withDensity cubeScaleDensity)

/-- The factorized definition agrees with the density-on-product presentation
used in the source notation. -/
theorem cubeScaleMeasure_eq_withDensity :
    cubeScaleMeasure = (volume : Measure (E3 × ℝ)).withDensity
      (fun z ↦ cubeScaleDensity z.2) := by
  unfold cubeScaleMeasure
  rw [prod_withDensity_right measurable_cubeScaleDensity,
    ← Measure.volume_eq_prod]

/-- On one source box--scale cell, the center--scale measure is exactly the
product of the restricted center measure and the restricted logarithmic scale
measure.  This is the Fubini measure identity used below. -/
theorem cubeScaleMeasure_restrict_boxScaleRegion (α : Anisotropy)
    (q : AnisoBox α) :
    cubeScaleMeasure.restrict (boxScaleRegion α q) =
      (volume.restrict (boxSet α q)).prod
        ((volume.withDensity cubeScaleDensity).restrict (boxScaleBand q)) := by
  unfold cubeScaleMeasure boxScaleRegion
  rw [← Measure.prod_restrict]

/-- On a positive box-scale band, integration against the scale density is
the source's logarithmic interval integral. -/
theorem integral_boxScaleBand_withDensity_eq_intervalIntegral
    (q : AnisoBox α) (f : ℝ → ℝ) :
    ∫ t in boxScaleBand q, f t ∂(volume.withDensity cubeScaleDensity) =
      ∫ t in boxLength q / 2..boxLength q, f t / t := by
  have htop : ∀ᵐ t ∂(volume.restrict (boxScaleBand q)), cubeScaleDensity t < ∞ := by
    filter_upwards [] with t
    by_cases ht : 0 < t
    · simp [cubeScaleDensity, ht]
    · simp [cubeScaleDensity, ht]
  rw [setIntegral_withDensity_eq_setIntegral_toReal_smul
    measurable_cubeScaleDensity htop f measurableSet_Ioc]
  unfold boxScaleBand
  have hle : boxLength q / 2 ≤ boxLength q :=
    div_le_self (boxLength_pos q).le (by norm_num)
  calc
    ∫ t in Set.Ioc (boxLength q / 2) (boxLength q),
        (cubeScaleDensity t).toReal • f t =
        ∫ t in Set.Ioc (boxLength q / 2) (boxLength q), f t / t := by
      apply setIntegral_congr_fun measurableSet_Ioc
      intro t ht
      have htpos : 0 < t := by
        exact lt_trans
          (div_pos (boxLength_pos q) (by norm_num : (0 : ℝ) < 2)) ht.1
      change (cubeScaleDensity t).toReal * f t = f t / t
      rw [cubeScaleDensity_eq_of_pos htpos,
        ENNReal.toReal_ofReal (inv_pos.2 htpos).le]
      rw [div_eq_mul_inv]
      ring
    _ = ∫ t in boxLength q / 2..boxLength q, f t / t :=
      (intervalIntegral.integral_of_le hle).symm

/-- A continuous scalar scale integrand is integrable on every positive source
scale band for the logarithmic scale measure. -/
theorem integrableOn_boxScaleBand_of_continuous
    (q : AnisoBox α) (f : ℝ → ℝ) (hf : Continuous f) :
    IntegrableOn f (boxScaleBand q) (volume.withDensity cubeScaleDensity) := by
  have htop : ∀ᵐ t ∂(volume.restrict (boxScaleBand q)), cubeScaleDensity t < ∞ := by
    filter_upwards [] with t
    by_cases ht : 0 < t
    · simp [cubeScaleDensity, ht]
    · simp [cubeScaleDensity, ht]
  unfold IntegrableOn
  unfold boxScaleBand at htop ⊢
  rw [restrict_withDensity measurableSet_Ioc]
  rw [integrable_withDensity_iff measurable_cubeScaleDensity htop]
  have heq : (fun t : ℝ ↦ f t * (cubeScaleDensity t).toReal) =ᵐ[
      volume.restrict (Set.Ioc (boxLength q / 2) (boxLength q))]
      (fun t ↦ f t / t) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    have htpos : 0 < t := by
      exact lt_trans
        (div_pos (boxLength_pos q) (by norm_num : (0 : ℝ) < 2)) ht.1
    rw [cubeScaleDensity_eq_of_pos htpos,
      ENNReal.toReal_ofReal (inv_pos.2 htpos).le]
    ring
  rw [integrable_congr heq]
  let a : ℝ := boxLength q / 2
  let b : ℝ := boxLength q
  have hapos : 0 < a := by
    dsimp [a]
    exact div_pos (boxLength_pos q) (by norm_num)
  have hcont : ContinuousOn (fun t : ℝ ↦ f t / t) (Set.Icc a b) :=
    hf.continuousOn.div continuousOn_id
      (fun t ht ↦ ne_of_gt (lt_of_lt_of_le hapos ht.1))
  exact (hcont.integrableOn_compact isCompact_Icc).mono_set Set.Ioc_subset_Icc_self

/-- The local cubical form `Θ^{(i)}_{𝒬,λ,r}` over a finite collection. -/
noncomputable def localCubeForm (α : Anisotropy) (S : BoxCollection α)
    (i : Fin 3) (lam r : ℝ) (F : CubeVertex → E3 → ℝ) : ℝ :=
  ∫ z : E3 × ℝ,
    (∫ x : E6,
      cubeSignedInputProduct F x * localCubeKernel α i lam r z.2 z.1 x
    ) ∂(cubeScaleMeasure.restrict (collectionRegion α S))

/-- A singleton collection has precisely its one literal box-scale cell. -/
theorem collectionRegion_singleton
    (α : Anisotropy) (q : AnisoBox α) :
    collectionRegion α ({q} : BoxCollection α) = boxScaleRegion α q := by
  ext z
  simp [collectionRegion]

/-- Under the source local-integrability condition, a finite local cube form
is the sum of its literal one-box forms. -/
theorem localCubeForm_collection_eq_sum_singletons_of_integrable
    (α : Anisotropy) (S : BoxCollection α) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ)
    (h : IntegrableOn (fun z : E3 × ℝ ↦
      ∫ x : E6, cubeSignedInputProduct F x *
        localCubeKernel α i lam r z.2 z.1 x)
      (collectionRegion α S) cubeScaleMeasure) :
    localCubeForm α S i lam r F =
      ∑ q ∈ S, localCubeForm α ({q} : BoxCollection α) i lam r F := by
  unfold localCubeForm
  simp_rw [collectionRegion_singleton]
  unfold collectionRegion
  apply MeasureTheory.integral_biUnion_finset
  · intro q hq
    exact measurableSet_boxScaleRegion α q
  · exact pairwiseDisjoint_boxScaleRegion α S
  · intro q hq
    apply h.mono_set
    intro z hz
    exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hq, hz⟩⟩

/-- The pair `D_i=G_i(x_i^0)G_i(x_i^1)` from the endpoint and boundary
forms in Section 4. -/
def cubeCoordinateD (α : Anisotropy) (i : Fin 3)
    (lam r t : ℝ) (p : E3) (x : E6) : ℝ :=
  cubeGaussianKernel α lam r t p i (x (i, false)) *
    cubeGaussianKernel α lam r t p i (x (i, true))

/-- The pair `P_i=H_i(x_i^0)H_i(x_i^1)` in the source notation. -/
def cubeCoordinateP (α : Anisotropy) (i : Fin 3)
    (lam r t : ℝ) (p : E3) (x : E6) : ℝ :=
  cubeGaussianDerivKernel α lam r t p i (x (i, false)) *
    cubeGaussianDerivKernel α lam r t p i (x (i, true))

/-- The boundary factor
`E_i=μ_i W_i/(2π)-s_iD_i`, retaining the source's different third
coordinate translation term. -/
def cubeBoundaryKernel (α : Anisotropy) (i : Fin 3)
    (lam r t : ℝ) (p : E3) (x : E6) : ℝ :=
  cubeWidth i lam / (2 * Real.pi) *
      (cubeGaussianDerivKernel α lam r t p i (x (i, false)) *
          cubeGaussianKernel α lam r t p i (x (i, true)) +
        cubeGaussianKernel α lam r t p i (x (i, false)) *
          cubeGaussianDerivKernel α lam r t p i (x (i, true))) -
    cubeCenterShift i r * cubeCoordinateD α i lam r t p x

/-- The positive endpoint product `K_{t,p}`. -/
def cubeEndpointKernel (α : Anisotropy) (lam r t : ℝ) (p : E3)
    (x : E6) : ℝ :=
  ∏ i : Fin 3, cubeCoordinateD α i lam r t p x

/-- The integrand attached to an oriented coordinate face. -/
def cubeFaceKernel (α : Anisotropy) (i : Fin 3)
    (lam r t : ℝ) (p : E3) (x : E6) : ℝ :=
  cubeBoundaryKernel α i lam r t p x *
    ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x

/-- The source face integral `𝒥_{i,S}(t;F)`, using the literal transverse
coordinate Lebesgue measure built earlier for oriented faces. -/
noncomputable def cubeFaceIntegral (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) (lam r t : ℝ) (F : CubeVertex → E3 → ℝ) : ℝ :=
  ∫ y : TransverseSpace i in transverseRectangle α S.box i,
    ∫ x : E6,
      cubeSignedInputProduct F x *
        cubeFaceKernel α i lam r t
          (faceInsert i (boxFaceCoordinate α S.box i S.orientation) y) x

/-- The endpoint form `Ξ_𝒬` for a finite box collection. -/
noncomputable def cubeEndpointForm (α : Anisotropy) (S : BoxCollection α)
    (lam r : ℝ) (F : CubeVertex → E3 → ℝ) : ℝ :=
  Real.pi * ∑ q ∈ S,
    ∫ p : E3 in boxSet α q,
      ∫ x : E6,
          cubeSignedInputProduct F x *
          cubeEndpointKernel α lam r (boxLength q) p x

/-- The finite endpoint reindexing in the tree telescope.  It is separated
from the analytic single-box scale identity: the equality is only the exact
children/boxes/leaves bookkeeping of a finite convex tree. -/
theorem cubeEndpointForm_tree_children_sub_tree_boxes
    (α : Anisotropy) (T : FiniteConvexTree α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) :
    cubeEndpointForm α (treeChildrenAll T) lam r F -
        cubeEndpointForm α T.boxes lam r F =
      cubeEndpointForm α (treeLeaves T) lam r F -
        cubeEndpointForm α {T.root} lam r F := by
  let w : AnisoBox α → ℝ := fun q ↦
    ∫ p : E3 in boxSet α q,
      ∫ x : E6,
        cubeSignedInputProduct F x *
          cubeEndpointKernel α lam r (boxLength q) p x
  have hsum := sum_treeChildrenAll_sub_sum_treeBoxes (T := T) w
  change Real.pi * (∑ q ∈ treeChildrenAll T, w q) -
      Real.pi * (∑ q ∈ T.boxes, w q) =
    Real.pi * (∑ q ∈ treeLeaves T, w q) -
      Real.pi * (∑ q ∈ ({T.root} : Finset (AnisoBox α)), w q)
  rw [← mul_sub, ← mul_sub, hsum]
  simp

/-- The surviving-face expansion of the source boundary form.  Its equality
with the original box-endpoint expansion is the interior-face cancellation
lemma proved after the single-box telescoping identity. -/
noncomputable def cubeBoundaryFaceForm (α : Anisotropy) (T : FiniteConvexTree α)
    (lam r : ℝ) (F : CubeVertex → E3 → ℝ) : ℝ :=
  -Real.pi * ∑ i : Fin 3, (α.weight i : ℝ) *
    ∑ S ∈ survivingFacesAll T i,
      (S.orientation.sign : ℝ) *
        ∫ t : ℝ in Set.Ioc (boxLength S.box / 2) (boxLength S.box),
          t ^ (α.weight i - 1) * cubeFaceIntegral α i S lam r t F

/-- The literal tree remainder after endpoint telescoping and surviving-face
cancellation. -/
noncomputable def cubeTreeRemainder (α : Anisotropy) (T : FiniteConvexTree α)
    (lam r : ℝ) (F : CubeVertex → E3 → ℝ) : ℝ :=
  cubeEndpointForm α (treeLeaves T) lam r F -
    cubeEndpointForm α {T.root} lam r F +
      cubeBoundaryFaceForm α T lam r F

/-- The cubical coordinate factors are instances of the scalar telescope
with the source parameters `(μ_i,s_i)`. -/
theorem cubeCoordinateD_eq_scalarD (α : Anisotropy) (i : Fin 3)
    (lam r t : ℝ) (p : E3) (x : E6) :
    cubeCoordinateD α i lam r t p x =
      scalarD (cubeWidth i lam) (cubeCenterShift i r) (α.weight i) t (p i)
        (x (i, false)) (x (i, true)) := rfl

theorem cubeCoordinateP_eq_scalarP (α : Anisotropy) (i : Fin 3)
    (lam r t : ℝ) (p : E3) (x : E6) :
    cubeCoordinateP α i lam r t p x =
      scalarP (cubeWidth i lam) (cubeCenterShift i r) (α.weight i) t (p i)
        (x (i, false)) (x (i, true)) := rfl

theorem cubeBoundaryKernel_eq_scalarE (α : Anisotropy) (i : Fin 3)
    (lam r t : ℝ) (p : E3) (x : E6) :
    cubeBoundaryKernel α i lam r t p x =
      scalarE (cubeWidth i lam) (cubeCenterShift i r) (α.weight i) t (p i)
        (x (i, false)) (x (i, true)) := rfl

/-- The six-variable local kernel splits into the active derivative pair and
the two passive Gaussian pairs.  This is the literal kernel factorization
used when the scalar telescope is integrated in the other coordinates. -/
theorem localCubeKernel_eq_coordinateP_mul (α : Anisotropy) (i : Fin 3)
    (lam r t : ℝ) (p : E3) (x : E6) :
    localCubeKernel α i lam r t p x =
      cubeCoordinateP α i lam r t p x *
        ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x := by
  unfold localCubeKernel cubeCoordinateP cubeCoordinateD
  rw [Fintype.prod_prod_type]
  simp_rw [Fintype.prod_bool]
  let A : Fin 3 → ℝ := fun m ↦
    (if m = i then
      cubeGaussianDerivKernel α lam r t p m (x (m, true))
    else cubeGaussianKernel α lam r t p m (x (m, true))) *
    (if m = i then
      cubeGaussianDerivKernel α lam r t p m (x (m, false))
    else cubeGaussianKernel α lam r t p m (x (m, false)))
  let B : Fin 3 → ℝ := fun m ↦
    cubeGaussianKernel α lam r t p m (x (m, false)) *
      cubeGaussianKernel α lam r t p m (x (m, true))
  change (∏ m, A m) =
    cubeGaussianDerivKernel α lam r t p i (x (i, false)) *
      cubeGaussianDerivKernel α lam r t p i (x (i, true)) *
        ∏ m ∈ Finset.univ.erase i, B m
  have hAerase : (∏ m ∈ Finset.univ.erase i, A m) =
      ∏ m ∈ Finset.univ.erase i, B m := by
    apply Finset.prod_congr rfl
    intro m hm
    have hmi : m ≠ i := (Finset.mem_erase.mp hm).1
    simp only [A, B, if_neg hmi]
    ring
  calc
    (∏ m, A m) = A i * ∏ m ∈ Finset.univ.erase i, A m :=
      (Finset.mul_prod_erase Finset.univ A (Finset.mem_univ i)).symm
    _ = cubeGaussianDerivKernel α lam r t p i (x (i, false)) *
          cubeGaussianDerivKernel α lam r t p i (x (i, true)) *
            ∏ m ∈ Finset.univ.erase i, B m := by
      rw [hAerase]
      simp only [A, if_pos]
      ring

/-- The scalar divergence identity expressed in the active coordinate of a
cubical kernel.  The remaining coordinates are deliberately inert, so this
is the exact bridge used before Fubini lifts the identity over a box. -/
theorem cubeCoordinate_pointwise_divergence
    (α : Anisotropy) (i : Fin 3) {lam t : ℝ} (r : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    -t * deriv (fun q : ℝ => cubeCoordinateD α i lam r q p x) t =
      (α.weight i : ℝ) / Real.pi * cubeCoordinateP α i lam r t p x +
        (α.weight i : ℝ) * t ^ α.weight i *
          deriv (fun q : ℝ =>
            cubeBoundaryKernel α i lam r t (cubeCenterReplace p i q) x) (p i) := by
  have hwidth : 0 < cubeWidth i lam := by
    unfold cubeWidth
    split_ifs with hi
    · linarith
    · positivity
  have hmu : cubeWidth i lam ≠ 0 := hwidth.ne'
  have htne : t ≠ 0 := ht.ne'
  have hscalar := scalar_pointwise_divergence
    (mu := cubeWidth i lam) (sig := cubeCenterShift i r)
    (n := α.weight i) (t := t) (p := p i)
    (u0 := x (i, false)) (u1 := x (i, true)) hmu htne
  have hboundary :
      (fun q : ℝ => cubeBoundaryKernel α i lam r t (cubeCenterReplace p i q) x) =
        (fun q : ℝ => scalarE (cubeWidth i lam) (cubeCenterShift i r)
          (α.weight i) t q (x (i, false)) (x (i, true))) := by
    funext q
    rw [cubeBoundaryKernel_eq_scalarE]
    simp
  rw [hboundary]
  simpa only [cubeCoordinateD_eq_scalarD, cubeCoordinateP_eq_scalarP] using hscalar

/-- The interval telescope in an actual cubical coordinate.  Its hypotheses
are precisely the compact-parameter regularity facts subsequently supplied
by the local-integrability development. -/
theorem cubeCoordinate_oneDim_telescoping
    (α : Anisotropy) (i : Fin 3) {lam t a b : ℝ} (r : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t)
    (hDdot : IntervalIntegrable
      (fun q : ℝ => deriv (fun s : ℝ =>
        cubeCoordinateD α i lam r s (cubeCenterReplace p i q) x) t)
      volume a b)
    (hP : IntervalIntegrable
      (fun q : ℝ => cubeCoordinateP α i lam r t (cubeCenterReplace p i q) x)
      volume a b)
    (hEdiff : ∀ q ∈ Set.uIcc a b, DifferentiableAt ℝ
      (fun s : ℝ => cubeBoundaryKernel α i lam r t (cubeCenterReplace p i s) x) q)
    (hEcont : ContinuousOn
      (deriv (fun s : ℝ => cubeBoundaryKernel α i lam r t
        (cubeCenterReplace p i s) x)) (Set.uIcc a b)) :
    ∫ q in a..b, -t * deriv (fun s : ℝ =>
      cubeCoordinateD α i lam r s (cubeCenterReplace p i q) x) t =
      (α.weight i : ℝ) / Real.pi *
        (∫ q in a..b, cubeCoordinateP α i lam r t (cubeCenterReplace p i q) x) +
      (α.weight i : ℝ) * t ^ α.weight i *
        (cubeBoundaryKernel α i lam r t (cubeCenterReplace p i b) x -
          cubeBoundaryKernel α i lam r t (cubeCenterReplace p i a) x) := by
  have hEint : IntervalIntegrable
      (deriv (fun s : ℝ => cubeBoundaryKernel α i lam r t
        (cubeCenterReplace p i s) x)) volume a b :=
    hEcont.intervalIntegrable
  have hFTC :
      (∫ q in a..b, deriv (fun s : ℝ => cubeBoundaryKernel α i lam r t
        (cubeCenterReplace p i s) x) q) =
        cubeBoundaryKernel α i lam r t (cubeCenterReplace p i b) x -
          cubeBoundaryKernel α i lam r t (cubeCenterReplace p i a) x :=
    intervalIntegral.integral_deriv_eq_sub hEdiff hEint
  calc
    ∫ q in a..b, -t * deriv (fun s : ℝ =>
        cubeCoordinateD α i lam r s (cubeCenterReplace p i q) x) t =
      ∫ q in a..b, ((α.weight i : ℝ) / Real.pi *
        cubeCoordinateP α i lam r t (cubeCenterReplace p i q) x +
        (α.weight i : ℝ) * t ^ α.weight i *
          deriv (fun s : ℝ => cubeBoundaryKernel α i lam r t
            (cubeCenterReplace p i s) x) q) := by
      apply intervalIntegral.integral_congr
      intro q hq
      have hpoint := cubeCoordinate_pointwise_divergence α i r
        (cubeCenterReplace p i q) x hlam ht
      have hreplace :
          (fun s : ℝ => cubeBoundaryKernel α i lam r t
            (cubeCenterReplace (cubeCenterReplace p i q) i s) x) =
          (fun s : ℝ => cubeBoundaryKernel α i lam r t
            (cubeCenterReplace p i s) x) := by
        funext s
        rw [cubeCenterReplace_replace]
      rw [hreplace] at hpoint
      simpa using hpoint
    _ = (α.weight i : ℝ) / Real.pi *
          (∫ q in a..b, cubeCoordinateP α i lam r t (cubeCenterReplace p i q) x) +
        (α.weight i : ℝ) * t ^ α.weight i *
          (∫ q in a..b, deriv (fun s : ℝ => cubeBoundaryKernel α i lam r t
            (cubeCenterReplace p i s) x) q) := by
      rw [intervalIntegral.integral_add
        (hP.const_mul ((α.weight i : ℝ) / Real.pi))
        (hEint.const_mul ((α.weight i : ℝ) * t ^ α.weight i))]
      rw [intervalIntegral.integral_const_mul,
        intervalIntegral.integral_const_mul]
    _ = _ := by rw [hFTC]

/-- The scalar regularity package discharges every analytic side condition in
the active-coordinate telescope on the positive scale range. -/
theorem cubeCoordinate_oneDim_telescoping_of_pos
    (α : Anisotropy) (i : Fin 3) {lam t a b : ℝ} (r : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    ∫ q in a..b, -t * deriv (fun s : ℝ =>
      cubeCoordinateD α i lam r s (cubeCenterReplace p i q) x) t =
      (α.weight i : ℝ) / Real.pi *
        (∫ q in a..b, cubeCoordinateP α i lam r t (cubeCenterReplace p i q) x) +
      (α.weight i : ℝ) * t ^ α.weight i *
        (cubeBoundaryKernel α i lam r t (cubeCenterReplace p i b) x -
          cubeBoundaryKernel α i lam r t (cubeCenterReplace p i a) x) := by
  have hwidth : 0 < cubeWidth i lam := by
    unfold cubeWidth
    split_ifs with hi
    · linarith
    · positivity
  have hmu : cubeWidth i lam ≠ 0 := hwidth.ne'
  have htne : t ≠ 0 := ht.ne'
  have hscalar := scalar_oneDim_telescoping_of_ne_zero
    (mu := cubeWidth i lam) (sig := cubeCenterShift i r)
    (n := α.weight i) (t := t) (a := a) (b := b)
    (u0 := x (i, false)) (u1 := x (i, true)) hmu htne
  simpa only [cubeCoordinateD_eq_scalarD, cubeCoordinateP_eq_scalarP,
    cubeBoundaryKernel_eq_scalarE, cubeCenterReplace_apply_same] using hscalar

/-- Replacing the active coordinate of a point already assembled from a
transverse point leaves precisely that transverse point and the new coordinate.
This is the affine-coordinate compatibility used before applying Fubini. -/
theorem cubeCenterReplace_faceInsert (i : Fin 3) (c q : ℝ)
    (y : TransverseSpace i) :
    cubeCenterReplace (faceInsert i c y) i q = faceInsert i q y := by
  ext j
  by_cases hji : j = i
  · subst j
    simp
  · rw [cubeCenterReplace_apply_ne _ _ _ _ hji]
    simp [faceInsert_apply, hji]

/-- At a fixed transverse point, the positive-scale one-dimensional telescope
over a box is exactly the interval telescope between that box's two active
coordinate endpoints.  No Fubini or integrability assertion is used here. -/
theorem cubeCoordinate_oneDim_telescoping_faceInsert_box
    (α : Anisotropy) (Q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r c : ℝ) (y : TransverseSpace i) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    ∫ u in boxFaceCoordinate α Q i FaceOrientation.lower..
        boxFaceCoordinate α Q i FaceOrientation.upper,
      -t * deriv (fun s : ℝ =>
        cubeCoordinateD α i lam r s (faceInsert i u y) x) t =
      (α.weight i : ℝ) / Real.pi *
        (∫ u in boxFaceCoordinate α Q i FaceOrientation.lower..
          boxFaceCoordinate α Q i FaceOrientation.upper,
          cubeCoordinateP α i lam r t (faceInsert i u y) x) +
      (α.weight i : ℝ) * t ^ α.weight i *
        (cubeBoundaryKernel α i lam r t
          (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.upper) y) x -
          cubeBoundaryKernel α i lam r t
            (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.lower) y) x) := by
  simpa only [cubeCenterReplace_faceInsert] using
    (cubeCoordinate_oneDim_telescoping_of_pos α i
      (a := boxFaceCoordinate α Q i FaceOrientation.lower)
      (b := boxFaceCoordinate α Q i FaceOrientation.upper)
      r (faceInsert i c y) x hlam ht)

/-- A passive coordinate pair is constant along the active coordinate
fibres.  This is the elementary affine fact that turns the other two Gaussian
pairs into the transverse weight of the box telescope. -/
theorem cubeCoordinateD_faceInsert_ne
    (α : Anisotropy) (i j : Fin 3) (lam r t u : ℝ)
    (y : TransverseSpace i) (x : E6) (hji : j ≠ i) :
    cubeCoordinateD α j lam r t (faceInsert i u y) x =
      cubeCoordinateD α j lam r t (faceInsert i 0 y) x := by
  simp [cubeCoordinateD, cubeGaussianKernel, faceInsert_apply, hji]

/-- The product of the two passive coordinate pairs is constant on every
active-coordinate fibre. -/
theorem passiveCoordinateProduct_faceInsert
    (α : Anisotropy) (i : Fin 3) (lam r t u : ℝ)
    (y : TransverseSpace i) (x : E6) :
    (∏ m ∈ Finset.univ.erase i,
      cubeCoordinateD α m lam r t (faceInsert i u y) x) =
      ∏ m ∈ Finset.univ.erase i,
        cubeCoordinateD α m lam r t (faceInsert i 0 y) x := by
  apply Finset.prod_congr rfl
  intro m hm
  exact cubeCoordinateD_faceInsert_ne α i m lam r t u y x
    (Finset.mem_erase.mp hm).1

/-! ### Compact local-integrability package

The source local-integrability lemma first fixes a positive scale and the six
spatial variables.  Literal boxes and transverse rectangles are half-open, so
we place each in its compact coordinatewise closure and apply continuity there.
-/

/-- Compact coordinatewise closure used to establish integrability on a
literal half-open source box. -/
noncomputable def boxClosedSet (α : Anisotropy) (q : AnisoBox α) : Set E3 :=
  (WithLp.toLp 2) '' Set.pi Set.univ (fun i ↦
    Set.Icc ((q.index i : ℝ) * boxSide α q i)
      (((q.index i + 1 : ℤ) : ℝ) * boxSide α q i))

theorem isCompact_boxClosedSet (α : Anisotropy) (q : AnisoBox α) :
    IsCompact (boxClosedSet α q) := by
  unfold boxClosedSet
  let K : Set (Fin 3 → ℝ) := Set.pi Set.univ (fun i ↦
    Set.Icc ((q.index i : ℝ) * boxSide α q i)
      (((q.index i + 1 : ℤ) : ℝ) * boxSide α q i))
  change IsCompact ((WithLp.toLp 2) '' K)
  have hK : IsCompact K := by
    dsimp only [K]
    exact isCompact_univ_pi fun _ ↦ isCompact_Icc
  exact hK.image (PiLp.continuous_toLp 2 _)

theorem boxSet_subset_boxClosedSet (α : Anisotropy) (q : AnisoBox α) :
    boxSet α q ⊆ boxClosedSet α q := by
  intro p hp
  refine ⟨WithLp.ofLp p, ?_, ?_⟩
  · rw [Set.mem_pi]
    intro i _
    rw [boxSet, Set.mem_preimage, Set.mem_pi] at hp
    exact Set.Ico_subset_Icc_self (hp i (Set.mem_univ i))
  · simp

theorem volume_boxSet_ne_top (α : Anisotropy) (q : AnisoBox α) :
    volume (boxSet α q) ≠ ∞ := by
  rw [volume_boxSet]
  exact ENNReal.prod_ne_top fun _ _ ↦ ENNReal.ofReal_ne_top

/-- A continuous ambient function is integrable on every literal source box. -/
theorem integrableOn_boxSet_of_continuous {α : Anisotropy}
    {f : E3 → ℝ} (hf : Continuous f) (q : AnisoBox α) :
    IntegrableOn f (boxSet α q) := by
  exact hf.continuousOn.integrableOn_of_subset_isCompact
    (isCompact_boxClosedSet α q) (measurableSet_boxSet α q)
    (boxSet_subset_boxClosedSet α q) (volume_boxSet_ne_top α q)

/-- Center-continuity of the active Gaussian pair at positive source scale. -/
theorem continuous_cubeCoordinateD_center
    (α : Anisotropy) (i : Fin 3) {lam t : ℝ} (r : ℝ) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    Continuous (fun p : E3 ↦ cubeCoordinateD α i lam r t p x) := by
  have hscale : cubeWidth i lam * t ^ α.weight i ≠ 0 :=
    cubeGaussianScale_ne_zero α i hlam ht
  simpa only [cubeCoordinateD_eq_scalarD, coordinateProjection_apply,
    Function.comp_def] using
    (continuous_scalarD_center (mu := cubeWidth i lam)
      (sig := cubeCenterShift i r) (n := α.weight i) (t := t)
      (u0 := x (i, false)) (u1 := x (i, true)) hscale).comp
      (coordinateProjection i).continuous

/-- Center-continuity of the active derivative-Gaussian pair. -/
theorem continuous_cubeCoordinateP_center
    (α : Anisotropy) (i : Fin 3) (lam r t : ℝ) (x : E6) :
    Continuous (fun p : E3 ↦ cubeCoordinateP α i lam r t p x) := by
  simpa only [cubeCoordinateP_eq_scalarP, coordinateProjection_apply,
    Function.comp_def] using
    (continuous_scalarP_center (mu := cubeWidth i lam)
      (sig := cubeCenterShift i r) (n := α.weight i) (t := t)
      (u0 := x (i, false)) (u1 := x (i, true))).comp
      (coordinateProjection i).continuous

/-- Center-continuity of the boundary kernel at positive source scale. -/
theorem continuous_cubeBoundaryKernel_center
    (α : Anisotropy) (i : Fin 3) {lam t : ℝ} (r : ℝ) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    Continuous (fun p : E3 ↦ cubeBoundaryKernel α i lam r t p x) := by
  have hscale : cubeWidth i lam * t ^ α.weight i ≠ 0 :=
    cubeGaussianScale_ne_zero α i hlam ht
  simpa only [cubeBoundaryKernel_eq_scalarE, coordinateProjection_apply,
    Function.comp_def] using
    (continuous_scalarE_center (mu := cubeWidth i lam)
      (sig := cubeCenterShift i r) (n := α.weight i) (t := t)
      (u0 := x (i, false)) (u1 := x (i, true)) hscale).comp
      (coordinateProjection i).continuous

/-- Center-continuity of the scale derivative of the active Gaussian pair. -/
theorem continuous_cubeCoordinateDdot_center
    (α : Anisotropy) (i : Fin 3) {lam t : ℝ} (r : ℝ) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    Continuous (fun p : E3 ↦ deriv (fun s : ℝ ↦
      cubeCoordinateD α i lam r s p x) t) := by
  have hmu : cubeWidth i lam ≠ 0 :=
    (cubeWidth_pos_of_one_le i hlam).ne'
  simpa only [cubeCoordinateD_eq_scalarD, coordinateProjection_apply,
    Function.comp_def] using
    (continuous_scalarDdot_center (mu := cubeWidth i lam)
      (sig := cubeCenterShift i r) (n := α.weight i) (t := t)
      (u0 := x (i, false)) (u1 := x (i, true)) hmu ht.ne').comp
      (coordinateProjection i).continuous

theorem integrableOn_cubeCoordinateD_boxSet
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r : ℝ) (x : E6) (hlam : 1 ≤ lam) (ht : 0 < t) :
    IntegrableOn (fun p : E3 ↦ cubeCoordinateD α i lam r t p x) (boxSet α q) :=
  integrableOn_boxSet_of_continuous
    (continuous_cubeCoordinateD_center α i r x hlam ht) q

theorem integrableOn_cubeCoordinateP_boxSet
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) (lam r t : ℝ) (x : E6) :
    IntegrableOn (fun p : E3 ↦ cubeCoordinateP α i lam r t p x) (boxSet α q) :=
  integrableOn_boxSet_of_continuous
    (continuous_cubeCoordinateP_center α i lam r t x) q

theorem integrableOn_cubeBoundaryKernel_boxSet
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r : ℝ) (x : E6) (hlam : 1 ≤ lam) (ht : 0 < t) :
    IntegrableOn (fun p : E3 ↦ cubeBoundaryKernel α i lam r t p x) (boxSet α q) :=
  integrableOn_boxSet_of_continuous
    (continuous_cubeBoundaryKernel_center α i r x hlam ht) q

theorem integrableOn_cubeCoordinateDdot_boxSet
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r : ℝ) (x : E6) (hlam : 1 ≤ lam) (ht : 0 < t) :
    IntegrableOn (fun p : E3 ↦ deriv (fun s : ℝ ↦
      cubeCoordinateD α i lam r s p x) t) (boxSet α q) :=
  integrableOn_boxSet_of_continuous
    (continuous_cubeCoordinateDdot_center α i r x hlam ht) q

/-- Compact coordinatewise closure of a transverse half-open rectangle. -/
noncomputable def transverseClosedRectangle (α : Anisotropy)
    (q : AnisoBox α) (i : Fin 3) : Set (TransverseSpace i) :=
  (WithLp.toLp 2) '' Set.pi Set.univ (fun j : {m : Fin 3 // m ≠ i} ↦
    Set.Icc ((q.index j.1 : ℝ) * boxSide α q j.1)
      (((q.index j.1 + 1 : ℤ) : ℝ) * boxSide α q j.1))

theorem isCompact_transverseClosedRectangle (α : Anisotropy)
    (q : AnisoBox α) (i : Fin 3) :
    IsCompact (transverseClosedRectangle α q i) := by
  unfold transverseClosedRectangle
  let K : Set ({j : Fin 3 // j ≠ i} → ℝ) := Set.pi Set.univ (fun j ↦
    Set.Icc ((q.index j.1 : ℝ) * boxSide α q j.1)
      (((q.index j.1 + 1 : ℤ) : ℝ) * boxSide α q j.1))
  change IsCompact ((WithLp.toLp 2) '' K)
  have hK : IsCompact K := by
    dsimp only [K]
    exact isCompact_univ_pi fun _ ↦ isCompact_Icc
  exact hK.image (PiLp.continuous_toLp 2 _)

theorem transverseRectangle_subset_transverseClosedRectangle
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    transverseRectangle α q i ⊆ transverseClosedRectangle α q i := by
  intro y hy
  refine ⟨WithLp.ofLp y, ?_, ?_⟩
  · rw [Set.mem_pi]
    intro j _
    rw [transverseRectangle, Set.mem_preimage, Set.mem_pi] at hy
    exact Set.Ico_subset_Icc_self (hy j (Set.mem_univ j))
  · simp

theorem volume_transverseRectangle_ne_top (α : Anisotropy)
    (q : AnisoBox α) (i : Fin 3) :
    volume (transverseRectangle α q i) ≠ ∞ := by
  rw [volume_transverseRectangle]
  exact ENNReal.prod_ne_top fun _ _ ↦ ENNReal.ofReal_ne_top

/-- A continuous transverse function is integrable on every source face
rectangle. -/
theorem integrableOn_transverseRectangle_of_continuous
    {α : Anisotropy} {i : Fin 3} {f : TransverseSpace i → ℝ}
    (hf : Continuous f) (q : AnisoBox α) :
    IntegrableOn f (transverseRectangle α q i) := by
  exact hf.continuousOn.integrableOn_of_subset_isCompact
    (isCompact_transverseClosedRectangle α q i)
    (measurableSet_transverseRectangle α q i)
    (transverseRectangle_subset_transverseClosedRectangle α q i)
    (volume_transverseRectangle_ne_top α q i)

theorem continuous_cubeBoundaryKernel_face
    (α : Anisotropy) (i : Fin 3) {lam t : ℝ} (r c : ℝ) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    Continuous (fun y : TransverseSpace i ↦
      cubeBoundaryKernel α i lam r t (faceInsert i c y) x) :=
  (continuous_cubeBoundaryKernel_center α i r x hlam ht).comp
    (faceInsert_continuous i c)

theorem integrableOn_cubeBoundaryKernel_face
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r c : ℝ) (x : E6) (hlam : 1 ≤ lam) (ht : 0 < t) :
    IntegrableOn (fun y : TransverseSpace i ↦
      cubeBoundaryKernel α i lam r t (faceInsert i c y) x)
      (transverseRectangle α q i) :=
  integrableOn_transverseRectangle_of_continuous
    (continuous_cubeBoundaryKernel_face α i r c x hlam ht) q

/-- Literal-coordinate Fubini for the scale derivative in the source
one-dimensional telescope. -/
theorem integral_cubeCoordinateDdot_boxSet_eq_transverse_interval
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r : ℝ) (x : E6) (hlam : 1 ≤ lam) (ht : 0 < t) :
    (∫ p : E3 in boxSet α q, deriv (fun s : ℝ ↦
      cubeCoordinateD α i lam r s p x) t) =
      ∫ y in transverseRectangle α q i,
        ∫ u in boxInterval α q i, deriv (fun s : ℝ ↦
          cubeCoordinateD α i lam r s (faceInsert i u y) x) t := by
  exact integral_boxSet_eq_integral_transverse_interval α q i _
    (integrableOn_cubeCoordinateDdot_boxSet α q i r x hlam ht)

/-- Literal-coordinate Fubini for the active derivative-Gaussian pair on the
right side of the telescope. -/
theorem integral_cubeCoordinateP_boxSet_eq_transverse_interval
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) (lam r t : ℝ) (x : E6) :
    (∫ p : E3 in boxSet α q, cubeCoordinateP α i lam r t p x) =
      ∫ y in transverseRectangle α q i,
        ∫ u in boxInterval α q i,
          cubeCoordinateP α i lam r t (faceInsert i u y) x := by
  exact integral_boxSet_eq_integral_transverse_interval α q i _
    (integrableOn_cubeCoordinateP_boxSet α q i lam r t x)

/-- The one-dimensional source telescope, integrated through a literal box
with an arbitrary passive transverse weight.  This is the Fubini step in
`lem:telescoping_identity`: the hypotheses retain precisely the local
integrability obligations which the Gaussian majorant later discharges. -/
theorem cubeCoordinate_box_telescoping_weighted
    (α : Anisotropy) (Q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r : ℝ) (x : E6) (w : TransverseSpace i → ℝ)
    (hlam : 1 ≤ lam) (ht : 0 < t)
    (hD : IntegrableOn (fun p : E3 ↦
      w (coordinateSplit i p).2 *
        (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t))
      (boxSet α Q))
    (hP : IntegrableOn (fun p : E3 ↦
      w (coordinateSplit i p).2 * cubeCoordinateP α i lam r t p x)
      (boxSet α Q))
    (hElo : IntegrableOn (fun y : TransverseSpace i ↦
      w y * cubeBoundaryKernel α i lam r t
        (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.lower) y) x)
      (transverseRectangle α Q i))
    (hEhi : IntegrableOn (fun y : TransverseSpace i ↦
      w y * cubeBoundaryKernel α i lam r t
        (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.upper) y) x)
      (transverseRectangle α Q i))
    (hPouter : Integrable (fun y : TransverseSpace i ↦
      ∫ u in boxInterval α Q i,
        w y * cubeCoordinateP α i lam r t (faceInsert i u y) x)
      (volume.restrict (transverseRectangle α Q i))) :
    (∫ p : E3 in boxSet α Q,
      w (coordinateSplit i p).2 *
        (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t)) =
      (α.weight i : ℝ) / Real.pi *
        (∫ p : E3 in boxSet α Q,
          w (coordinateSplit i p).2 * cubeCoordinateP α i lam r t p x) +
      (α.weight i : ℝ) * t ^ α.weight i *
        ((∫ y : TransverseSpace i in transverseRectangle α Q i,
          w y * cubeBoundaryKernel α i lam r t
            (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.upper) y) x) -
         (∫ y : TransverseSpace i in transverseRectangle α Q i,
          w y * cubeBoundaryKernel α i lam r t
            (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.lower) y) x)) := by
  have hDsplit := integral_boxSet_eq_integral_transverse_interval α Q i
    (fun p : E3 ↦ w (coordinateSplit i p).2 *
      (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t)) hD
  have hPsplit := integral_boxSet_eq_integral_transverse_interval α Q i
    (fun p : E3 ↦ w (coordinateSplit i p).2 *
      cubeCoordinateP α i lam r t p x) hP
  simp only [coordinateSplit_faceInsert] at hDsplit hPsplit
  rw [hDsplit, hPsplit]
  let c : ℝ := (α.weight i : ℝ) / Real.pi
  let d : ℝ := (α.weight i : ℝ) * t ^ α.weight i
  let lo : ℝ := boxFaceCoordinate α Q i FaceOrientation.lower
  let hi : ℝ := boxFaceCoordinate α Q i FaceOrientation.upper
  let R : Set (TransverseSpace i) := transverseRectangle α Q i
  let Ddot : TransverseSpace i → ℝ → ℝ := fun y u ↦
    w y * (-t * deriv (fun s : ℝ ↦
      cubeCoordinateD α i lam r s (faceInsert i u y) x) t)
  let P : TransverseSpace i → ℝ → ℝ := fun y u ↦
    w y * cubeCoordinateP α i lam r t (faceInsert i u y) x
  let Elo : TransverseSpace i → ℝ := fun y ↦
    w y * cubeBoundaryKernel α i lam r t (faceInsert i lo y) x
  let Ehi : TransverseSpace i → ℝ := fun y ↦
    w y * cubeBoundaryKernel α i lam r t (faceInsert i hi y) x
  have hpoint (y : TransverseSpace i) :
      (∫ u in boxInterval α Q i, Ddot y u) =
        c * (∫ u in boxInterval α Q i, P y u) + d * (Ehi y - Elo y) := by
    dsimp only [Ddot, P, Elo, Ehi, c, d, lo, hi]
    have hbase := cubeCoordinate_oneDim_telescoping_faceInsert_box
      α Q i r 0 y x hlam ht
    have horder := boxFaceCoordinate_lower_le_upper α Q i
    simp_rw [intervalIntegral.integral_of_le horder] at hbase
    simp_rw [← integral_Ico_eq_integral_Ioc] at hbase
    calc
      (∫ u in boxInterval α Q i,
        w y * (-t * deriv (fun s : ℝ ↦
          cubeCoordinateD α i lam r s (faceInsert i u y) x) t)) =
          w y * (∫ u in boxInterval α Q i,
            -t * deriv (fun s : ℝ ↦
              cubeCoordinateD α i lam r s (faceInsert i u y) x) t) := by
            rw [MeasureTheory.integral_const_mul]
      _ = w y * ((α.weight i : ℝ) / Real.pi *
            (∫ u in boxInterval α Q i,
              cubeCoordinateP α i lam r t (faceInsert i u y) x) +
          (α.weight i : ℝ) * t ^ α.weight i *
            (cubeBoundaryKernel α i lam r t
              (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.upper) y) x -
              cubeBoundaryKernel α i lam r t
                (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.lower) y) x)) := by
            simpa only [boxInterval, boxFaceCoordinate] using
              congrArg (fun z : ℝ ↦ w y * z) hbase
      _ = (α.weight i : ℝ) / Real.pi *
            (∫ u in boxInterval α Q i,
              w y * cubeCoordinateP α i lam r t (faceInsert i u y) x) +
          (α.weight i : ℝ) * t ^ α.weight i *
            (w y * cubeBoundaryKernel α i lam r t
              (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.upper) y) x -
              w y * cubeBoundaryKernel α i lam r t
                (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.lower) y) x) := by
            rw [MeasureTheory.integral_const_mul]
            ring
  have hboundary : Integrable (fun y : TransverseSpace i ↦ d * (Ehi y - Elo y))
      (volume.restrict R) := by
    exact ((hEhi.sub hElo).const_mul d)
  calc
    (∫ y : TransverseSpace i in transverseRectangle α Q i,
      ∫ u in boxInterval α Q i,
        w y * (-t * deriv (fun s : ℝ ↦
          cubeCoordinateD α i lam r s (faceInsert i u y) x) t)) =
        ∫ y : TransverseSpace i in R,
          (c * (∫ u in boxInterval α Q i, P y u) + d * (Ehi y - Elo y)) := by
      apply integral_congr_ae
      filter_upwards [] with y
      exact hpoint y
    _ = c * (∫ y : TransverseSpace i in R,
          ∫ u in boxInterval α Q i, P y u) +
        d * ((∫ y : TransverseSpace i in R, Ehi y) -
          (∫ y : TransverseSpace i in R, Elo y)) := by
      rw [MeasureTheory.integral_add (hPouter.const_mul c) hboundary]
      rw [MeasureTheory.integral_const_mul]
      rw [MeasureTheory.integral_const_mul]
      rw [MeasureTheory.integral_sub hEhi hElo]
    _ = _ := by
      simp only [c, d, P, Ehi, Elo, R, hi, lo]

/-- The half-open active interval of a box has the same integral as its
oriented interval integral.  This is the endpoint-null-set bridge between
the literal box decomposition and the one-dimensional FTC identity. -/
theorem integral_boxInterval_eq_intervalIntegral
    (α : Anisotropy) (Q : AnisoBox α) (i : Fin 3) (f : ℝ → ℝ) :
    ∫ u in boxInterval α Q i, f u =
      ∫ u in boxFaceCoordinate α Q i FaceOrientation.lower..
        boxFaceCoordinate α Q i FaceOrientation.upper, f u := by
  let a := boxFaceCoordinate α Q i FaceOrientation.lower
  let b := boxFaceCoordinate α Q i FaceOrientation.upper
  have hab : a ≤ b := boxFaceCoordinate_lower_le_upper α Q i
  change ∫ u in Set.Ico a b, f u = ∫ u in a..b, f u
  rw [integral_Ico_eq_integral_Ioc]
  exact (intervalIntegral.integral_of_le hab).symm

/-- Fubini lift of the active-coordinate telescope at a fixed six-variable
point and arbitrary transverse weight.  Keeping the transverse sum bundled
means that the one source local-integrability hypothesis is sufficient here. -/
theorem weighted_cubeCoordinate_box_telescoping
    (α : Anisotropy) (Q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r : ℝ) (x : E6) (w : TransverseSpace i → ℝ)
    (hlam : 1 ≤ lam) (ht : 0 < t)
    (hlocal : IntegrableOn
      (fun p : E3 ↦
        (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
          w (coordinateSplit i p).2)
      (boxSet α Q)) :
    ∫ p in boxSet α Q,
      (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
        w (coordinateSplit i p).2 =
      ∫ y in transverseRectangle α Q i,
        ((α.weight i : ℝ) / Real.pi *
            (∫ u in boxFaceCoordinate α Q i FaceOrientation.lower..
              boxFaceCoordinate α Q i FaceOrientation.upper,
              cubeCoordinateP α i lam r t (faceInsert i u y) x) +
          (α.weight i : ℝ) * t ^ α.weight i *
            (cubeBoundaryKernel α i lam r t
              (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.upper) y) x -
            cubeBoundaryKernel α i lam r t
              (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.lower) y) x)) *
          w y := by
  rw [integral_boxSet_eq_integral_transverse_interval α Q i _ hlocal]
  apply integral_congr_ae
  filter_upwards [] with y
  have htel := cubeCoordinate_oneDim_telescoping_faceInsert_box
    α Q i r 0 y x hlam ht
  let d : ℝ → ℝ := fun u ↦
    -t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s (faceInsert i u y) x) t
  have hbox :
      (∫ u in boxInterval α Q i, d u) =
        ∫ u in boxFaceCoordinate α Q i FaceOrientation.lower..
          boxFaceCoordinate α Q i FaceOrientation.upper, d u :=
    integral_boxInterval_eq_intervalIntegral α Q i d
  simp only [coordinateSplit_faceInsert]
  change (∫ u in boxInterval α Q i, d u * w y) = _
  rw [integral_mul_const]
  rw [hbox, htel]

/-- The product of the two inactive coordinate factors, expressed in literal
transverse coordinates. -/
noncomputable def cubeInactiveWeight (α : Anisotropy) (i : Fin 3)
    (lam r t : ℝ) (x : E6) (y : TransverseSpace i) : ℝ :=
  ∏ m ∈ Finset.univ.erase i,
    cubeCoordinateD α m lam r t (faceInsert i 0 y) x

/-- An inactive cubical coordinate factor is unchanged when only the active
center coordinate is varied. -/
theorem cubeCoordinateD_faceInsert_eq_of_ne
    (α : Anisotropy) (i m : Fin 3) (hmi : m ≠ i)
    (lam r t u c : ℝ) (y : TransverseSpace i) (x : E6) :
    cubeCoordinateD α m lam r t (faceInsert i u y) x =
      cubeCoordinateD α m lam r t (faceInsert i c y) x := by
  simp [cubeCoordinateD, cubeGaussianKernel, faceInsert_apply, hmi]

/-- The inactive product on an active/transverse coordinate slice is the
literal transverse weight. -/
theorem cubeInactiveWeight_faceInsert
    (α : Anisotropy) (i : Fin 3) (lam r t u : ℝ)
    (y : TransverseSpace i) (x : E6) :
    (∏ m ∈ Finset.univ.erase i,
      cubeCoordinateD α m lam r t (faceInsert i u y) x) =
      cubeInactiveWeight α i lam r t x y := by
  unfold cubeInactiveWeight
  apply Finset.prod_congr rfl
  intro m hm
  exact cubeCoordinateD_faceInsert_eq_of_ne α i m
    (Finset.mem_erase.mp hm).1 lam r t u 0 y x

/-- Reexpress the inactive product at an ambient point through its literal
transverse coordinates. -/
theorem cubeInactiveWeight_coordinateSplit
    (α : Anisotropy) (i : Fin 3) (lam r t : ℝ) (p : E3) (x : E6) :
    (∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x) =
      cubeInactiveWeight α i lam r t x (coordinateSplit i p).2 := by
  have hjoin : p = faceInsert i (p i) (coordinateSplit i p).2 := by
    simpa [coordinateJoin, coordinateSplit] using (coordinateJoin_split i p).symm
  calc
    (∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x) =
        ∏ m ∈ Finset.univ.erase i,
          cubeCoordinateD α m lam r t
            (faceInsert i (p i) (coordinateSplit i p).2) x :=
      congrArg (fun z : E3 ↦
        ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t z x) hjoin
    _ = cubeInactiveWeight α i lam r t x (coordinateSplit i p).2 :=
      cubeInactiveWeight_faceInsert α i lam r t (p i)
        (coordinateSplit i p).2 x

/-- Source-faithful fixed-`x` box-coordinate telescope: the active
one-dimensional identity is multiplied by the two inactive `D_m` factors and
lifted through the literal box Fubini decomposition. -/
theorem cubeCoordinate_box_telescoping
    (α : Anisotropy) (Q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r : ℝ) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t)
    (hlocal : IntegrableOn
      (fun p : E3 ↦
        (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
          ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x)
      (boxSet α Q)) :
    ∫ p in boxSet α Q,
      (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
        ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x =
      ∫ y in transverseRectangle α Q i,
        ((α.weight i : ℝ) / Real.pi *
            (∫ u in boxFaceCoordinate α Q i FaceOrientation.lower..
              boxFaceCoordinate α Q i FaceOrientation.upper,
              cubeCoordinateP α i lam r t (faceInsert i u y) x) +
          (α.weight i : ℝ) * t ^ α.weight i *
            (cubeBoundaryKernel α i lam r t
              (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.upper) y) x -
            cubeBoundaryKernel α i lam r t
              (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.lower) y) x)) *
          ∏ m ∈ Finset.univ.erase i,
            cubeCoordinateD α m lam r t (faceInsert i 0 y) x := by
  have hlocal' : IntegrableOn
      (fun p : E3 ↦
        (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
          cubeInactiveWeight α i lam r t x (coordinateSplit i p).2)
      (boxSet α Q) := by
    apply hlocal.congr_fun
    · intro p _
      change
        (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
            (∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x) =
          (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
            cubeInactiveWeight α i lam r t x (coordinateSplit i p).2
      rw [cubeInactiveWeight_coordinateSplit]
    · exact measurableSet_boxSet α Q
  have htel := weighted_cubeCoordinate_box_telescoping α Q i r x
    (cubeInactiveWeight α i lam r t x) hlam ht hlocal'
  calc
    ∫ p in boxSet α Q,
        (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
          ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x =
        ∫ p in boxSet α Q,
          (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
            cubeInactiveWeight α i lam r t x (coordinateSplit i p).2 := by
          apply integral_congr_ae
          filter_upwards [] with p
          rw [cubeInactiveWeight_coordinateSplit]
    _ = _ := by
      simpa only [cubeInactiveWeight] using htel

/-- Continuity of the fixed-`x` integrand on the left-hand side of the
source box telescope. -/
theorem continuous_cubeCoordinateTelescopeIntegrand
    (α : Anisotropy) (i : Fin 3) {lam t : ℝ} (r : ℝ) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    Continuous (fun p : E3 ↦
      (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
        ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x) := by
  have hdot := continuous_cubeCoordinateDdot_center α i r x hlam ht
  have hpassive : Continuous (fun p : E3 ↦
      ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x) := by
    apply continuous_finsetProd
    intro m hm
    exact continuous_cubeCoordinateD_center α m r x hlam ht
  exact (continuous_const.mul hdot).mul hpassive

theorem integrableOn_cubeCoordinateTelescopeIntegrand_boxSet
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r : ℝ) (x : E6) (hlam : 1 ≤ lam) (ht : 0 < t) :
    IntegrableOn (fun p : E3 ↦
      (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
        ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x)
      (boxSet α q) :=
  integrableOn_boxSet_of_continuous
    (continuous_cubeCoordinateTelescopeIntegrand α i r x hlam ht) q

/-- The fixed-`x` box-coordinate telescope with its local-integrability
obligation discharged by the compact local Gaussian regularity package. -/
theorem cubeCoordinate_box_telescoping_of_pos
    (α : Anisotropy) (Q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r : ℝ) (x : E6) (hlam : 1 ≤ lam) (ht : 0 < t) :
    ∫ p in boxSet α Q,
      (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
        ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x =
      ∫ y in transverseRectangle α Q i,
        ((α.weight i : ℝ) / Real.pi *
            (∫ u in boxFaceCoordinate α Q i FaceOrientation.lower..
              boxFaceCoordinate α Q i FaceOrientation.upper,
              cubeCoordinateP α i lam r t (faceInsert i u y) x) +
          (α.weight i : ℝ) * t ^ α.weight i *
            (cubeBoundaryKernel α i lam r t
              (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.upper) y) x -
            cubeBoundaryKernel α i lam r t
              (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.lower) y) x)) *
          ∏ m ∈ Finset.univ.erase i,
            cubeCoordinateD α m lam r t (faceInsert i 0 y) x :=
  cubeCoordinate_box_telescoping α Q i r x hlam ht
    (integrableOn_cubeCoordinateTelescopeIntegrand_boxSet α Q i r x hlam ht)

/-- The fully split fixed-`x` box telescope.  The interior term is the
literal local cube kernel, while the two remaining terms are the two oriented
face kernels.  Every Fubini condition follows from compact-domain continuity. -/
theorem cubeCoordinate_box_telescoping_split_of_pos
    (α : Anisotropy) (Q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r : ℝ) (x : E6) (hlam : 1 ≤ lam) (ht : 0 < t) :
    ∫ p in boxSet α Q,
      (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
        ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x =
      (α.weight i : ℝ) / Real.pi *
        (∫ p in boxSet α Q, localCubeKernel α i lam r t p x) +
      (α.weight i : ℝ) * t ^ α.weight i *
        ((∫ y in transverseRectangle α Q i,
          cubeFaceKernel α i lam r t
            (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.upper) y) x) -
         (∫ y in transverseRectangle α Q i,
          cubeFaceKernel α i lam r t
            (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.lower) y) x)) := by
  let w : TransverseSpace i → ℝ := cubeInactiveWeight α i lam r t x
  have hpassive : Continuous (fun p : E3 ↦
      ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x) := by
    apply continuous_finsetProd
    intro m hm
    exact continuous_cubeCoordinateD_center α m r x hlam ht
  have hw : Continuous (fun p : E3 ↦ w (coordinateSplit i p).2) := by
    apply Continuous.congr hpassive
    intro p
    dsimp only [w]
    exact cubeInactiveWeight_coordinateSplit α i lam r t p x
  have hD : IntegrableOn (fun p : E3 ↦
      w (coordinateSplit i p).2 *
        (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t))
      (boxSet α Q) := by
    apply integrableOn_boxSet_of_continuous
    exact hw.mul ((continuous_const.mul
      (continuous_cubeCoordinateDdot_center α i r x hlam ht)))
  have hP : IntegrableOn (fun p : E3 ↦
      w (coordinateSplit i p).2 * cubeCoordinateP α i lam r t p x)
      (boxSet α Q) := by
    apply integrableOn_boxSet_of_continuous
    exact hw.mul (continuous_cubeCoordinateP_center α i lam r t x)
  have hE (o : FaceOrientation) : IntegrableOn
      (fun y : TransverseSpace i ↦
        w y * cubeBoundaryKernel α i lam r t
          (faceInsert i (boxFaceCoordinate α Q i o) y) x)
      (transverseRectangle α Q i) := by
    apply integrableOn_transverseRectangle_of_continuous
    have hwface : Continuous w := by
      dsimp only [w, cubeInactiveWeight]
      apply continuous_finsetProd
      intro m hm
      exact (continuous_cubeCoordinateD_center α m r x hlam ht).comp
        (faceInsert_continuous i 0)
    exact hwface.mul (continuous_cubeBoundaryKernel_face α i r
      (boxFaceCoordinate α Q i o) x hlam ht)
  have hPouter : Integrable (fun y : TransverseSpace i ↦
      ∫ u in boxInterval α Q i,
        w y * cubeCoordinateP α i lam r t (faceInsert i u y) x)
      (volume.restrict (transverseRectangle α Q i)) := by
    have h := integrable_outer_integral_boxInterval_of_integrableOn α Q i
      (fun p : E3 ↦ w (coordinateSplit i p).2 *
        cubeCoordinateP α i lam r t p x) hP
    simpa only [coordinateSplit_faceInsert] using h
  have htel := cubeCoordinate_box_telescoping_weighted α Q i r x w hlam ht
    hD hP (hE FaceOrientation.lower) (hE FaceOrientation.upper) hPouter
  have hlocal :
      (∫ p in boxSet α Q,
        w (coordinateSplit i p).2 * cubeCoordinateP α i lam r t p x) =
        ∫ p in boxSet α Q, localCubeKernel α i lam r t p x := by
    apply integral_congr_ae
    filter_upwards [] with p
    dsimp only [w]
    rw [← cubeInactiveWeight_coordinateSplit]
    simpa only [mul_comm] using
      (localCubeKernel_eq_coordinateP_mul α i lam r t p x).symm
  have hleft :
      (∫ p in boxSet α Q,
        (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
          ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x) =
        ∫ p in boxSet α Q,
          w (coordinateSplit i p).2 *
            (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) := by
    apply integral_congr_ae
    filter_upwards [] with p
    dsimp only [w]
    rw [← cubeInactiveWeight_coordinateSplit]
    ring
  have hface (o : FaceOrientation) :
      (∫ y in transverseRectangle α Q i,
        w y * cubeBoundaryKernel α i lam r t
          (faceInsert i (boxFaceCoordinate α Q i o) y) x) =
        ∫ y in transverseRectangle α Q i,
          cubeFaceKernel α i lam r t
            (faceInsert i (boxFaceCoordinate α Q i o) y) x := by
    apply integral_congr_ae
    filter_upwards [] with y
    dsimp only [w]
    rw [cubeFaceKernel, cubeInactiveWeight_faceInsert]
    ring
  rw [hleft, htel, hlocal, hface FaceOrientation.upper,
    hface FaceOrientation.lower]

/-- The exact product rule for the three coordinate pairs in the endpoint
kernel.  It is the first equality in the source box-derivative calculation. -/
theorem cubeEndpointKernel_scale_derivative
    (α : Anisotropy) (lam r t : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    -t * deriv (fun s : ℝ ↦ cubeEndpointKernel α lam r s p x) t =
      ∑ i : Fin 3,
        (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
          ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x := by
  have hwidth (i : Fin 3) : cubeWidth i lam ≠ 0 :=
    (cubeWidth_pos_of_one_le i hlam).ne'
  have hdif (i : Fin 3) : DifferentiableAt ℝ
      (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t := by
    simpa only [cubeCoordinateD_eq_scalarD] using
      (hasDerivAt_scalarD_scale (mu := cubeWidth i lam)
        (sig := cubeCenterShift i r) (n := α.weight i) (t := t)
        (p := p i) (u0 := x (i, false)) (u1 := x (i, true))
        (hwidth i) ht.ne').differentiableAt
  simp only [cubeEndpointKernel, Fin.prod_univ_three]
  change -t * deriv
      (((fun s : ℝ ↦ cubeCoordinateD α 0 lam r s p x) *
        (fun s : ℝ ↦ cubeCoordinateD α 1 lam r s p x)) *
        (fun s : ℝ ↦ cubeCoordinateD α 2 lam r s p x)) t = _
  rw [deriv_mul ((hdif 0).mul (hdif 1)) (hdif 2)]
  rw [deriv_mul (hdif 0) (hdif 1)]
  simp only [Fin.sum_univ_three]
  have herase0 : (Finset.univ.erase (0 : Fin 3)) = {1, 2} := by decide
  have herase1 : (Finset.univ.erase (1 : Fin 3)) = {0, 2} := by decide
  have herase2 : (Finset.univ.erase (2 : Fin 3)) = {0, 1} := by decide
  rw [herase0, herase1, herase2]
  simp
  ring

/-- Scale continuity of the scalar Gaussian factor away from zero scale. -/
theorem continuousAt_scalarG_scale {mu sig : ℝ} {n : ℕ} {t p u : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    ContinuousAt (fun q : ℝ ↦ scalarG mu sig n q p u) t := by
  have hscale : mu * t ^ n ≠ 0 :=
    mul_ne_zero hmu (pow_ne_zero n ht)
  have hpow : ContinuousAt (fun q : ℝ ↦ q ^ n) t := continuousAt_id.pow n
  have hs : ContinuousAt (fun q : ℝ ↦ mu * q ^ n) t :=
    continuousAt_const.mul hpow
  have hinv : ContinuousAt (fun q : ℝ ↦ (mu * q ^ n)⁻¹) t := hs.inv₀ hscale
  have hcenter : ContinuousAt (fun q : ℝ ↦ p + sig * q ^ n) t :=
    continuousAt_const.add (continuousAt_const.mul hpow)
  have hnum : ContinuousAt (fun q : ℝ ↦ u - (p + sig * q ^ n)) t :=
    continuousAt_const.sub hcenter
  have hratio : ContinuousAt
      (fun q : ℝ ↦ (u - (p + sig * q ^ n)) / (mu * q ^ n)) t := by
    change ContinuousAt
      (fun q : ℝ ↦ (u - (p + sig * q ^ n)) * (mu * q ^ n)⁻¹) t
    convert hnum.mul hinv using 1
    funext q
    rfl
  have hexp : ContinuousAt
      (fun q : ℝ ↦ Real.exp (-Real.pi *
        ((u - (p + sig * q ^ n)) / (mu * q ^ n)) ^ 2)) t :=
    (Real.continuous_exp.continuousAt.comp
      (continuousAt_const.mul (hratio.pow 2)))
  unfold scalarG gaussianAt kernelAt kernelDilate gaussian
  exact hinv.smul hexp

/-- Scale differentiability of the scalar derivative-Gaussian factor away
from zero scale. -/
theorem differentiableAt_scalarH_scale {mu sig : ℝ} {n : ℕ} {t p u : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    DifferentiableAt ℝ (fun q : ℝ ↦ scalarH mu sig n q p u) t := by
  have hscale : mu * t ^ n ≠ 0 :=
    mul_ne_zero hmu (pow_ne_zero n ht)
  unfold scalarH gaussianDerivAt kernelAt kernelDilate gaussianDeriv gaussian
  fun_prop (disch := exact hscale)

theorem continuousAt_scalarH_scale {mu sig : ℝ} {n : ℕ} {t p u : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    ContinuousAt (fun q : ℝ ↦ scalarH mu sig n q p u) t :=
  (differentiableAt_scalarH_scale hmu ht).continuousAt

/-- The standardized scalar coordinate is differentiable, hence continuous,
on the nonzero scale half-line. -/
theorem differentiableAt_scalarZ_scale {mu sig : ℝ} {n : ℕ} {t p u : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    DifferentiableAt ℝ (fun q : ℝ ↦ scalarZ mu sig n q p u) t := by
  have hscale : mu * t ^ n ≠ 0 :=
    mul_ne_zero hmu (pow_ne_zero n ht)
  have hpow : HasDerivAt (fun q : ℝ ↦ q ^ n)
      ((n : ℝ) * t ^ (n - 1)) t := by
    simpa using hasDerivAt_pow n t
  have hs : HasDerivAt (fun q : ℝ ↦ mu * q ^ n)
      (mu * ((n : ℝ) * t ^ (n - 1))) t := by
    convert hpow.const_mul mu using 1
  have hcenter : HasDerivAt (fun q : ℝ ↦ p + sig * q ^ n)
      (sig * ((n : ℝ) * t ^ (n - 1))) t := by
    convert (hpow.const_mul sig).const_add p using 1
  have hnum : HasDerivAt (fun q : ℝ ↦ u - (p + sig * q ^ n))
      (-(sig * ((n : ℝ) * t ^ (n - 1)))) t := by
    convert hcenter.const_sub u using 1
  change DifferentiableAt ℝ
    (fun q : ℝ ↦ (u - (p + sig * q ^ n)) / (mu * q ^ n)) t
  exact hnum.differentiableAt.fun_div hs.differentiableAt hscale

theorem continuousAt_scalarZ_scale {mu sig : ℝ} {n : ℕ} {t p u : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    ContinuousAt (fun q : ℝ ↦ scalarZ mu sig n q p u) t :=
  (differentiableAt_scalarZ_scale hmu ht).continuousAt

/-- The explicit scalar scale-derivative formula is continuous at every
nonzero scale. -/
theorem continuousAt_scalarDdot_scale
    {mu sig : ℝ} {n : ℕ} {t p u0 u1 : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    ContinuousAt (fun q : ℝ ↦
      deriv (fun s : ℝ ↦ scalarD mu sig n s p u0 u1) q) t := by
  let d : ℝ → ℝ := fun q ↦
    -(n : ℝ) / q *
      (2 * scalarD mu sig n q p u0 u1 +
        (scalarZ mu sig n q p u0 + sig / mu) * scalarH mu sig n q p u0 *
          scalarG mu sig n q p u1 +
        (scalarZ mu sig n q p u1 + sig / mu) * scalarG mu sig n q p u0 *
          scalarH mu sig n q p u1)
  have hscale : mu * t ^ n ≠ 0 :=
    mul_ne_zero hmu (pow_ne_zero n ht)
  have hform : ContinuousAt d t := by
    dsimp only [d]
    fun_prop (disch := assumption) [scalarD, scalarG, scalarH, scalarZ,
      gaussianAt, gaussianDerivAt, kernelAt, kernelDilate, gaussian, gaussianDeriv]
  have heq : (fun q : ℝ ↦
      deriv (fun s : ℝ ↦ scalarD mu sig n s p u0 u1) q) =ᶠ[𝓝 t] d := by
    filter_upwards [eventually_ne_nhds ht] with q hq
    exact (hasDerivAt_scalarD_scale hmu hq).deriv
  exact hform.congr_of_eventuallyEq heq

/-- A coordinate-pair factor is differentiable at every nonzero scale. -/
theorem differentiableAt_cubeCoordinateD_scale_ne_zero
    (α : Anisotropy) (i : Fin 3) {lam t : ℝ} (r : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (ht : t ≠ 0) :
    DifferentiableAt ℝ (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t := by
  have hwidth : cubeWidth i lam ≠ 0 :=
    (cubeWidth_pos_of_one_le i hlam).ne'
  simpa only [cubeCoordinateD_eq_scalarD] using
    (hasDerivAt_scalarD_scale (mu := cubeWidth i lam)
      (sig := cubeCenterShift i r) (n := α.weight i) (t := t)
      (p := p i) (u0 := x (i, false)) (u1 := x (i, true))
      hwidth ht).differentiableAt

theorem differentiableAt_cubeCoordinateD_scale
    (α : Anisotropy) (i : Fin 3) {lam t : ℝ} (r : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    DifferentiableAt ℝ (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t := by
  exact differentiableAt_cubeCoordinateD_scale_ne_zero α i r p x hlam ht.ne'

theorem continuousAt_cubeCoordinateD_scale
    (α : Anisotropy) (i : Fin 3) {lam t : ℝ} (r : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    ContinuousAt (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t :=
  (differentiableAt_cubeCoordinateD_scale α i r p x hlam ht).continuousAt

/-- Positive-scale continuity of the scale derivative of a coordinate-pair
factor. -/
theorem continuousAt_cubeCoordinateDdot_scale
    (α : Anisotropy) (i : Fin 3) {lam t : ℝ} (r : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    ContinuousAt (fun q : ℝ ↦
      deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) q) t := by
  have hwidth : cubeWidth i lam ≠ 0 :=
    (cubeWidth_pos_of_one_le i hlam).ne'
  simpa only [cubeCoordinateD_eq_scalarD] using
    (continuousAt_scalarDdot_scale
      (mu := cubeWidth i lam) (sig := cubeCenterShift i r)
      (n := α.weight i) (t := t) (p := p i)
      (u0 := x (i, false)) (u1 := x (i, true)) hwidth ht.ne')

/-- The endpoint product is differentiable at every positive scale. -/
theorem differentiableAt_cubeEndpointKernel_scale
    (α : Anisotropy) {lam t : ℝ} (r : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    DifferentiableAt ℝ (fun s : ℝ ↦ cubeEndpointKernel α lam r s p x) t := by
  simp only [cubeEndpointKernel, Fin.prod_univ_three]
  exact
    ((differentiableAt_cubeCoordinateD_scale α 0 r p x hlam ht).mul
      (differentiableAt_cubeCoordinateD_scale α 1 r p x hlam ht)).mul
      (differentiableAt_cubeCoordinateD_scale α 2 r p x hlam ht)

/-- The derivative of the endpoint product is continuous at every positive
scale. -/
theorem continuousAt_cubeEndpointKernel_deriv_scale
    (α : Anisotropy) {lam t : ℝ} (r : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    ContinuousAt (fun q : ℝ ↦
      deriv (fun s : ℝ ↦ cubeEndpointKernel α lam r s p x) q) t := by
  let D : Fin 3 → ℝ → ℝ := fun i q ↦ cubeCoordinateD α i lam r q p x
  let d : ℝ → ℝ := fun q ↦
    (deriv (D 0) q * D 1 q + D 0 q * deriv (D 1) q) * D 2 q +
      (D 0 q * D 1 q) * deriv (D 2) q
  have hD0 : ContinuousAt (D 0) t := by
    dsimp only [D]
    exact continuousAt_cubeCoordinateD_scale α 0 r p x hlam ht
  have hD1 : ContinuousAt (D 1) t := by
    dsimp only [D]
    exact continuousAt_cubeCoordinateD_scale α 1 r p x hlam ht
  have hD2 : ContinuousAt (D 2) t := by
    dsimp only [D]
    exact continuousAt_cubeCoordinateD_scale α 2 r p x hlam ht
  have hdD0 : ContinuousAt (fun q : ℝ ↦ deriv (D 0) q) t := by
    dsimp only [D]
    exact continuousAt_cubeCoordinateDdot_scale α 0 r p x hlam ht
  have hdD1 : ContinuousAt (fun q : ℝ ↦ deriv (D 1) q) t := by
    dsimp only [D]
    exact continuousAt_cubeCoordinateDdot_scale α 1 r p x hlam ht
  have hdD2 : ContinuousAt (fun q : ℝ ↦ deriv (D 2) q) t := by
    dsimp only [D]
    exact continuousAt_cubeCoordinateDdot_scale α 2 r p x hlam ht
  have hform : ContinuousAt d t := by
    dsimp only [d]
    exact (((hdD0.mul hD1).add (hD0.mul hdD1)).mul hD2).add
      ((hD0.mul hD1).mul hdD2)
  have heq : (fun q : ℝ ↦
      deriv (fun s : ℝ ↦ cubeEndpointKernel α lam r s p x) q) =ᶠ[𝓝 t] d := by
    filter_upwards [eventually_ne_nhds ht.ne'] with q hq
    have hd0 : DifferentiableAt ℝ (D 0) q := by
      dsimp only [D]
      exact differentiableAt_cubeCoordinateD_scale_ne_zero α 0 r p x hlam hq
    have hd1 : DifferentiableAt ℝ (D 1) q := by
      dsimp only [D]
      exact differentiableAt_cubeCoordinateD_scale_ne_zero α 1 r p x hlam hq
    have hd2 : DifferentiableAt ℝ (D 2) q := by
      dsimp only [D]
      exact differentiableAt_cubeCoordinateD_scale_ne_zero α 2 r p x hlam hq
    simp only [cubeEndpointKernel, Fin.prod_univ_three]
    change deriv ((D 0 * D 1) * D 2) q = d q
    rw [deriv_mul (hd0.mul hd1) hd2, deriv_mul hd0 hd1]
    rfl
  exact hform.congr_of_eventuallyEq heq

/-- The fixed-`(p,x)` scale fundamental-theorem-of-calculus step: the two
endpoint kernels differ by the logarithmic scale integral of their derivative. -/
theorem cubeEndpointKernel_scale_FTC
    (α : Anisotropy) {lam L : ℝ} (r : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (hL : 0 < L) :
    cubeEndpointKernel α lam r (L / 2) p x - cubeEndpointKernel α lam r L p x =
      ∫ t in L / 2..L,
        (-t * deriv (fun s : ℝ ↦ cubeEndpointKernel α lam r s p x) t) / t := by
  let K : ℝ → ℝ := fun s ↦ cubeEndpointKernel α lam r s p x
  have hhalf : 0 < L / 2 := by linarith
  have hle : L / 2 ≤ L := by linarith
  have hderiv : ∀ s ∈ Set.uIcc (L / 2) L, DifferentiableAt ℝ K s := by
    intro s hs
    rw [Set.uIcc_of_le hle] at hs
    have hspos : 0 < s := lt_of_lt_of_le hhalf hs.1
    dsimp only [K]
    exact differentiableAt_cubeEndpointKernel_scale α r p x hlam hspos
  have hcont : ContinuousOn (deriv K) (Set.uIcc (L / 2) L) := by
    intro s hs
    rw [Set.uIcc_of_le hle] at hs
    have hspos : 0 < s := lt_of_lt_of_le hhalf hs.1
    simpa only [K] using
      (continuousAt_cubeEndpointKernel_deriv_scale α r p x hlam hspos).continuousWithinAt
  have hFTC : (∫ s in L / 2..L, deriv K s) = K L - K (L / 2) :=
    intervalIntegral.integral_deriv_eq_sub hderiv hcont.intervalIntegrable
  change K (L / 2) - K L =
    ∫ t in L / 2..L, (-t * deriv K t) / t
  calc
    K (L / 2) - K L = -(K L - K (L / 2)) := by ring
    _ = -(∫ s in L / 2..L, deriv K s) := by rw [hFTC]
    _ = ∫ s in L / 2..L, -deriv K s := by
      rw [intervalIntegral.integral_neg]
    _ = ∫ s in L / 2..L, (-s * deriv K s) / s := by
      apply intervalIntegral.integral_congr
      intro s hs
      rw [Set.uIcc_of_le hle] at hs
      have hspos : 0 < s := lt_of_lt_of_le hhalf hs.1
      symm
      apply (div_eq_iff hspos.ne').2
      ring

/-- The source box-derivative identity before the scale FTC: integrate the
three-term endpoint-kernel product rule and use the fixed-`x` coordinate
telescope in each summand. -/
theorem integral_boxSet_cubeEndpointKernel_scale_derivative
    (α : Anisotropy) (Q : AnisoBox α) (lam r t : ℝ) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    (∫ p : E3 in boxSet α Q,
      -t * deriv (fun s : ℝ ↦ cubeEndpointKernel α lam r s p x) t) =
      ∑ i : Fin 3,
        ∫ y in transverseRectangle α Q i,
          ((α.weight i : ℝ) / Real.pi *
              (∫ u in boxFaceCoordinate α Q i FaceOrientation.lower..
                boxFaceCoordinate α Q i FaceOrientation.upper,
                cubeCoordinateP α i lam r t (faceInsert i u y) x) +
            (α.weight i : ℝ) * t ^ α.weight i *
              (cubeBoundaryKernel α i lam r t
                (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.upper) y) x -
              cubeBoundaryKernel α i lam r t
                (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.lower) y) x)) *
            ∏ m ∈ Finset.univ.erase i,
              cubeCoordinateD α m lam r t (faceInsert i 0 y) x := by
  let term : Fin 3 → E3 → ℝ := fun i p ↦
    (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
      ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x
  have hterm (i : Fin 3) : IntegrableOn (term i) (boxSet α Q) := by
    exact integrableOn_cubeCoordinateTelescopeIntegrand_boxSet α Q i r x hlam ht
  calc
    (∫ p : E3 in boxSet α Q,
      -t * deriv (fun s : ℝ ↦ cubeEndpointKernel α lam r s p x) t) =
        ∫ p : E3 in boxSet α Q, ∑ i : Fin 3, term i p := by
      apply integral_congr_ae
      filter_upwards [] with p
      exact cubeEndpointKernel_scale_derivative α lam r t p x hlam ht
    _ = ∑ i : Fin 3, ∫ p : E3 in boxSet α Q, term i p := by
      apply MeasureTheory.integral_finsetSum
      intro i hi
      exact hterm i
    _ = _ := by
      apply Finset.sum_congr rfl
      intro i hi
      exact cubeCoordinate_box_telescoping_of_pos α Q i r x hlam ht

/-- Neighboring boxes have the same literal half-open transverse rectangle
across their common `i`-face. -/
theorem transverseRectangle_neighbor_eq (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) (ε : FaceOrientation) :
    transverseRectangle α (boxNeighbor α q i ε) i = transverseRectangle α q i := by
  unfold transverseRectangle
  congr 1
  apply Set.pi_congr rfl
  intro j _
  exact boxInterval_neighbor_eq_of_ne α q j.2 ε

/-- The two oriented records of one geometric grid face give the same local
boundary integral: both the transverse domain and the inserted face coordinate
are literal equalities. -/
theorem cubeFaceIntegral_oppositeOrientedFace (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) (lam r t : ℝ) (F : CubeVertex → E3 → ℝ) :
    cubeFaceIntegral α i (oppositeOrientedFace α i S) lam r t F =
      cubeFaceIntegral α i S lam r t F := by
  rcases S with ⟨q, ε⟩
  simp only [oppositeOrientedFace, cubeFaceIntegral]
  rw [transverseRectangle_neighbor_eq]
  rw [← boxFaceCoordinate_neighbor_opposite]

/-- With the source orientation sign, the two incident records of a face have
opposite boundary contributions. -/
theorem orientedFace_sign_mul_cubeFaceIntegral_opposite (α : Anisotropy)
    (i : Fin 3) (S : OrientedFace α) (lam r t : ℝ)
    (F : CubeVertex → E3 → ℝ) :
    ((oppositeOrientedFace α i S).orientation.sign : ℝ) *
        cubeFaceIntegral α i (oppositeOrientedFace α i S) lam r t F =
      -((S.orientation.sign : ℝ) * cubeFaceIntegral α i S lam r t F) := by
  rw [cubeFaceIntegral_oppositeOrientedFace]
  rw [oppositeOrientedFace_orientation, FaceOrientation.sign_opposite]
  push_cast
  ring

/-- The actual fixed-scale boundary integrals over all incident faces of a
tree reduce to the source's surviving-face sum: every interior pair cancels
with its opposite oriented record. -/
theorem sum_treeOrientedFaces_signed_cubeFaceIntegral_eq_surviving
    (α : Anisotropy) (T : FiniteConvexTree α) (i : Fin 3)
    (lam r t : ℝ) (F : CubeVertex → E3 → ℝ) :
    (∑ S ∈ treeOrientedFaces T,
      (S.orientation.sign : ℝ) * cubeFaceIntegral α i S lam r t F) =
      ∑ S ∈ survivingFacesAll T i,
        (S.orientation.sign : ℝ) * cubeFaceIntegral α i S lam r t F := by
  apply sum_treeOrientedFaces_eq_sum_surviving_of_opposite T i
  intro S
  rw [orientedFace_sign_mul_cubeFaceIntegral_opposite]
  ring

/-- The source boundary summand attached to one oriented face, including the
scale interval of its incident box. -/
noncomputable def cubeFaceScaleIntegral (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) (lam r : ℝ) (F : CubeVertex → E3 → ℝ) : ℝ :=
  ∫ t : ℝ in Set.Ioc (boxLength S.box / 2) (boxLength S.box),
    t ^ (α.weight i - 1) * cubeFaceIntegral α i S lam r t F

/-- The original per-box boundary form before interior faces have been
cancelled. -/
noncomputable def cubeBoxBoundaryForm (α : Anisotropy) (q : AnisoBox α)
    (lam r : ℝ) (F : CubeVertex → E3 → ℝ) : ℝ :=
  -Real.pi * ∑ i : Fin 3, (α.weight i : ℝ) *
    (cubeFaceScaleIntegral α i ⟨q, FaceOrientation.upper⟩ lam r F -
      cubeFaceScaleIntegral α i ⟨q, FaceOrientation.lower⟩ lam r F)

/-- The finite-tree sum of its box-wise boundary contributions. -/
noncomputable def cubeTreeBoxBoundaryForm (α : Anisotropy)
    (T : FiniteConvexTree α) (lam r : ℝ) (F : CubeVertex → E3 → ℝ) : ℝ :=
  ∑ q ∈ T.boxes, cubeBoxBoundaryForm α q lam r F

theorem boxLength_neighbor (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) (ε : FaceOrientation) :
    boxLength (boxNeighbor α q i ε) = boxLength q := by
  rfl

theorem cubeFaceScaleIntegral_oppositeOrientedFace (α : Anisotropy)
    (i : Fin 3) (S : OrientedFace α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) :
    cubeFaceScaleIntegral α i (oppositeOrientedFace α i S) lam r F =
      cubeFaceScaleIntegral α i S lam r F := by
  unfold cubeFaceScaleIntegral
  change
    (∫ t : ℝ in Set.Ioc
        (boxLength (boxNeighbor α S.box i S.orientation) / 2)
        (boxLength (boxNeighbor α S.box i S.orientation)),
      t ^ (α.weight i - 1) *
        cubeFaceIntegral α i (oppositeOrientedFace α i S) lam r t F) = _
  rw [boxLength_neighbor]
  apply integral_congr_ae
  filter_upwards [] with t
  rw [cubeFaceIntegral_oppositeOrientedFace]

theorem signed_cubeFaceScaleIntegral_oppositeOrientedFace (α : Anisotropy)
    (i : Fin 3) (S : OrientedFace α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) :
    ((oppositeOrientedFace α i S).orientation.sign : ℝ) *
        cubeFaceScaleIntegral α i (oppositeOrientedFace α i S) lam r F =
      -((S.orientation.sign : ℝ) *
        cubeFaceScaleIntegral α i S lam r F) := by
  rw [cubeFaceScaleIntegral_oppositeOrientedFace]
  rw [oppositeOrientedFace_orientation, FaceOrientation.sign_opposite]
  push_cast
  ring

theorem sum_treeOrientedFaces_signed_cubeFaceScaleIntegral_eq_surviving
    (α : Anisotropy) (T : FiniteConvexTree α) (i : Fin 3)
    (lam r : ℝ) (F : CubeVertex → E3 → ℝ) :
    (∑ S ∈ treeOrientedFaces T,
      (S.orientation.sign : ℝ) *
        cubeFaceScaleIntegral α i S lam r F) =
      ∑ S ∈ survivingFacesAll T i,
        (S.orientation.sign : ℝ) *
          cubeFaceScaleIntegral α i S lam r F := by
  apply sum_treeOrientedFaces_eq_sum_surviving_of_opposite T i
  intro S
  rw [signed_cubeFaceScaleIntegral_oppositeOrientedFace]
  ring

theorem orientedFacesOfBox_disjoint (q q' : AnisoBox α) (hqq' : q ≠ q') :
    Disjoint (orientedFacesOfBox q) (orientedFacesOfBox q') := by
  rw [Finset.disjoint_left]
  intro S hS hS'
  have hq : S.box = q := (mem_orientedFacesOfBox_iff q S).mp hS
  have hq' : S.box = q' := (mem_orientedFacesOfBox_iff q' S).mp hS'
  exact hqq' (hq.symm.trans hq')

theorem sum_treeOrientedFaces_eq_sum_boxes_orientedFaces
    (T : FiniteConvexTree α) (f : OrientedFace α → ℝ) :
    (∑ S ∈ treeOrientedFaces T, f S) =
      ∑ q ∈ T.boxes, ∑ S ∈ orientedFacesOfBox q, f S := by
  unfold treeOrientedFaces
  rw [Finset.sum_biUnion]
  intro q hq q' hq' hqq'
  exact orientedFacesOfBox_disjoint q q' hqq'

theorem sum_orientedFacesOfBox_signed (q : AnisoBox α)
    (f : OrientedFace α → ℝ) :
    (∑ S ∈ orientedFacesOfBox q, (S.orientation.sign : ℝ) * f S) =
      f ⟨q, FaceOrientation.upper⟩ - f ⟨q, FaceOrientation.lower⟩ := by
  rw [orientedFacesOfBox, Finset.sum_image]
  · have hfaces : (Finset.univ : Finset FaceOrientation) =
        {FaceOrientation.lower, FaceOrientation.upper} := by
      decide
    rw [hfaces]
    simp [FaceOrientation.sign]
    ring
  · intro ε hε ε' hε' h
    exact congrArg OrientedFace.orientation h

theorem cubeBoxBoundaryForm_eq_orientedFaceSum
    (α : Anisotropy) (q : AnisoBox α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) :
    cubeBoxBoundaryForm α q lam r F =
      -Real.pi * ∑ i : Fin 3, (α.weight i : ℝ) *
        ∑ S ∈ orientedFacesOfBox q,
          (S.orientation.sign : ℝ) *
            cubeFaceScaleIntegral α i S lam r F := by
  unfold cubeBoxBoundaryForm
  congr 2
  funext i
  rw [sum_orientedFacesOfBox_signed]

theorem sum_box_weighted_faceSums
    (T : FiniteConvexTree α) (c : ℝ) (a : Fin 3 → ℝ)
    (B : Fin 3 → AnisoBox α → ℝ) :
    (∑ q ∈ T.boxes, c * ∑ i : Fin 3, a i * B i q) =
      c * ∑ i : Fin 3, a i * ∑ q ∈ T.boxes, B i q := by
  calc
    (∑ q ∈ T.boxes, c * ∑ i : Fin 3, a i * B i q) =
        ∑ q ∈ T.boxes, ∑ i : Fin 3, c * (a i * B i q) := by
          apply Finset.sum_congr rfl
          intro q hq
          rw [Finset.mul_sum]
    _ = ∑ i : Fin 3, ∑ q ∈ T.boxes, c * (a i * B i q) := by
          exact Finset.sum_comm
    _ = ∑ i : Fin 3, c * (a i * ∑ q ∈ T.boxes, B i q) := by
          apply Finset.sum_congr rfl
          intro i hi
          calc
            (∑ q ∈ T.boxes, c * (a i * B i q)) =
                ∑ q ∈ T.boxes, (c * a i) * B i q := by
                  apply Finset.sum_congr rfl
                  intro q hq
                  ring
            _ = (c * a i) * ∑ q ∈ T.boxes, B i q := by
                  rw [Finset.mul_sum]
            _ = c * (a i * ∑ q ∈ T.boxes, B i q) := by ring
    _ = c * ∑ i : Fin 3, a i * ∑ q ∈ T.boxes, B i q := by
          rw [Finset.mul_sum]

theorem cubeTreeBoxBoundaryForm_eq_treeOrientedFaceScaleSum
    (α : Anisotropy) (T : FiniteConvexTree α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) :
    cubeTreeBoxBoundaryForm α T lam r F =
      -Real.pi * ∑ i : Fin 3, (α.weight i : ℝ) *
        ∑ S ∈ treeOrientedFaces T,
          (S.orientation.sign : ℝ) *
            cubeFaceScaleIntegral α i S lam r F := by
  unfold cubeTreeBoxBoundaryForm
  simp_rw [cubeBoxBoundaryForm_eq_orientedFaceSum]
  rw [sum_box_weighted_faceSums T (-Real.pi) (fun i ↦ (α.weight i : ℝ))
    (fun i q ↦ ∑ S ∈ orientedFacesOfBox q,
      (S.orientation.sign : ℝ) * cubeFaceScaleIntegral α i S lam r F)]
  congr 2
  funext i
  rw [← sum_treeOrientedFaces_eq_sum_boxes_orientedFaces T]

/-- Exact source `lem:face_cancellation`: the sum of all box-wise
upper-minus-lower boundary terms equals the surviving oriented-face form, with
each face retaining precisely its own scale band. -/
theorem cubeTreeBoxBoundaryForm_eq_cubeBoundaryFaceForm
    (α : Anisotropy) (T : FiniteConvexTree α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) :
    cubeTreeBoxBoundaryForm α T lam r F =
      cubeBoundaryFaceForm α T lam r F := by
  rw [cubeTreeBoxBoundaryForm_eq_treeOrientedFaceScaleSum]
  rw [show (∑ i : Fin 3, (α.weight i : ℝ) *
      ∑ S ∈ treeOrientedFaces T,
        (S.orientation.sign : ℝ) *
          cubeFaceScaleIntegral α i S lam r F) =
    ∑ i : Fin 3, (α.weight i : ℝ) *
      ∑ S ∈ survivingFacesAll T i,
        (S.orientation.sign : ℝ) *
          cubeFaceScaleIntegral α i S lam r F by
    apply Finset.sum_congr rfl
    intro i hi
    rw [sum_treeOrientedFaces_signed_cubeFaceScaleIntegral_eq_surviving]]
  unfold cubeBoundaryFaceForm cubeFaceScaleIntegral
  rfl

@[simp]
theorem cubeWidth_zero (lam : ℝ) : cubeWidth 0 lam = lam := by
  simp [cubeWidth]

@[simp]
theorem cubeWidth_one (lam : ℝ) : cubeWidth 1 lam = lam := by
  simp [cubeWidth]

@[simp]
theorem cubeWidth_two (lam : ℝ) : cubeWidth 2 lam = 1 := by
  simp [cubeWidth]

@[simp]
theorem cubeCenterShift_zero (r : ℝ) : cubeCenterShift 0 r = 0 := by
  simp [cubeCenterShift]

@[simp]
theorem cubeCenterShift_one (r : ℝ) : cubeCenterShift 1 r = 0 := by
  simp [cubeCenterShift]

@[simp]
theorem cubeCenterShift_two (r : ℝ) : cubeCenterShift 2 r = r := by
  simp [cubeCenterShift]

/-- The scale-domination estimate is stable under a positive ambient
dilation and translation of the center. -/
theorem gaussian_pair_scale_bracket_dilate :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (lam s p v : ℝ), 1 ≤ lam → 0 < s →
      |gaussianAt (lam * s) p v| + |gaussianDerivAt (lam * s) p v| ≤
        C * lam ^ 9 * bracketKernelAt s p v := by
  rcases gaussian_pair_scale_bracket_domination with ⟨C, hC, hdom⟩
  refine ⟨C, hC, ?_⟩
  intro lam s p v hlam hs
  have h := hdom lam ((v - p) / s) hlam
  have hsInv : 0 ≤ s⁻¹ := inv_nonneg.mpr hs.le
  have hmul := mul_le_mul_of_nonneg_left h hsInv
  have hlam0 : lam ≠ 0 := by linarith
  have hs0 : s ≠ 0 := hs.ne'
  have hgauss : gaussianAt (lam * s) p v =
      s⁻¹ * gaussianAt lam 0 ((v - p) / s) := by
    change (lam * s)⁻¹ * gaussian ((v - p) / (lam * s)) =
      s⁻¹ * (lam⁻¹ * gaussian (((v - p) / s - 0) / lam))
    have harg : (v - p) / (lam * s) = ((v - p) / s - 0) / lam := by
      field_simp
      ring
    rw [harg]
    field_simp
  have hderiv : gaussianDerivAt (lam * s) p v =
      s⁻¹ * gaussianDerivAt lam 0 ((v - p) / s) := by
    change (lam * s)⁻¹ * gaussianDeriv ((v - p) / (lam * s)) =
      s⁻¹ * (lam⁻¹ * gaussianDeriv (((v - p) / s - 0) / lam))
    have harg : (v - p) / (lam * s) = ((v - p) / s - 0) / lam := by
      field_simp
      ring
    rw [harg]
    field_simp
  have hbracket : bracketKernelAt s p v =
      s⁻¹ * bracketKernel ((v - p) / s) := by
    simp only [bracketKernelAt, kernelAt, kernelDilate, smul_eq_mul]
  rw [hgauss, hderiv, hbracket]
  rw [abs_mul, abs_mul, abs_of_nonneg hsInv]
  simpa [mul_add, mul_assoc, mul_left_comm, mul_comm] using hmul

/-- The translated domination estimate is likewise stable under a positive
ambient dilation. -/
theorem gaussian_pair_translate_bracket_dilate :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (r s p v : ℝ), 0 < s →
      |gaussianAt s (p + s * r) v| + |gaussianDerivAt s (p + s * r) v| ≤
        C * translationWeight r ^ 10 * bracketKernelAt s p v := by
  rcases gaussian_pair_translate_bracket_domination with ⟨C, hC, hdom⟩
  refine ⟨C, hC, ?_⟩
  intro r s p v hs
  have h := hdom r ((v - p) / s)
  have hsInv : 0 ≤ s⁻¹ := inv_nonneg.mpr hs.le
  have hmul := mul_le_mul_of_nonneg_left h hsInv
  have hs0 : s ≠ 0 := hs.ne'
  have hgauss : gaussianAt s (p + s * r) v =
      s⁻¹ * gaussianAt 1 r ((v - p) / s) := by
    change s⁻¹ * gaussian ((v - (p + s * r)) / s) =
      s⁻¹ * (1⁻¹ * gaussian (((v - p) / s - r) / 1))
    have harg : (v - (p + s * r)) / s = ((v - p) / s - r) / 1 := by
      field_simp
      ring
    rw [harg]
    ring
  have hderiv : gaussianDerivAt s (p + s * r) v =
      s⁻¹ * gaussianDerivAt 1 r ((v - p) / s) := by
    change s⁻¹ * gaussianDeriv ((v - (p + s * r)) / s) =
      s⁻¹ * (1⁻¹ * gaussianDeriv (((v - p) / s - r) / 1))
    have harg : (v - (p + s * r)) / s = ((v - p) / s - r) / 1 := by
      field_simp
      ring
    rw [harg]
    ring
  have hbracket : bracketKernelAt s p v =
      s⁻¹ * bracketKernel ((v - p) / s) := by
    simp only [bracketKernelAt, kernelAt, kernelDilate, smul_eq_mul]
  rw [hgauss, hderiv, hbracket]
  rw [abs_mul, abs_mul, abs_of_nonneg hsInv]
  simpa [mul_add, mul_assoc, mul_left_comm, mul_comm] using hmul

/-- A source-facing one-coordinate bound for either the Gaussian or its
derivative.  The first two coordinates carry the `λ^9` loss, while the third
carries the translated `R(r)^10` loss. -/
theorem cubeGaussian_pair_domination (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (j : Fin 3) (lam r t : ℝ) (p : E3) (v : ℝ),
      1 ≤ lam → 0 < t →
      |cubeGaussianKernel α lam r t p j v| +
        |cubeGaussianDerivKernel α lam r t p j v| ≤
        C * (if j = 2 then translationWeight r ^ 10 else lam ^ 9) *
          bracketKernelAt (t ^ α.weight j) (p j) v := by
  rcases gaussian_pair_scale_bracket_dilate with ⟨Cs, hCs, hs⟩
  rcases gaussian_pair_translate_bracket_dilate with ⟨Ct, hCt, ht⟩
  refine ⟨max Cs Ct, le_trans hCs (le_max_left _ _), ?_⟩
  intro j lam r t p v hlam htpos
  have htj : 0 < t ^ α.weight j := pow_pos htpos _
  fin_cases j
  · have h := hs lam (t ^ α.weight 0) (p 0) v hlam htj
    have hC : Cs ≤ max Cs Ct := le_max_left _ _
    calc
      |cubeGaussianKernel α lam r t p 0 v| +
          |cubeGaussianDerivKernel α lam r t p 0 v| =
          |gaussianAt (lam * t ^ α.weight 0) (p 0) v| +
            |gaussianDerivAt (lam * t ^ α.weight 0) (p 0) v| := by
              simp [cubeGaussianKernel, cubeGaussianDerivKernel, cubeWidth,
                cubeCenterShift]
      _ ≤ Cs * lam ^ 9 * bracketKernelAt (t ^ α.weight 0) (p 0) v := h
      _ ≤ max Cs Ct * lam ^ 9 * bracketKernelAt (t ^ α.weight 0) (p 0) v := by
        rw [mul_assoc, mul_assoc]
        apply mul_le_mul_of_nonneg_right hC
        exact mul_nonneg (pow_nonneg (by linarith) _)
          (bracketKernelAt_nonneg (s := t ^ α.weight 0) (a := p 0) (x := v) htj.le)
      _ = max Cs Ct * (if (0 : Fin 3) = 2 then translationWeight r ^ 10 else lam ^ 9) *
          bracketKernelAt (t ^ α.weight 0) (p 0) v := by simp
  · have h := hs lam (t ^ α.weight 1) (p 1) v hlam htj
    have hC : Cs ≤ max Cs Ct := le_max_left _ _
    calc
      |cubeGaussianKernel α lam r t p 1 v| +
          |cubeGaussianDerivKernel α lam r t p 1 v| =
          |gaussianAt (lam * t ^ α.weight 1) (p 1) v| +
            |gaussianDerivAt (lam * t ^ α.weight 1) (p 1) v| := by
              simp [cubeGaussianKernel, cubeGaussianDerivKernel, cubeWidth,
                cubeCenterShift]
      _ ≤ Cs * lam ^ 9 * bracketKernelAt (t ^ α.weight 1) (p 1) v := h
      _ ≤ max Cs Ct * lam ^ 9 * bracketKernelAt (t ^ α.weight 1) (p 1) v := by
        rw [mul_assoc, mul_assoc]
        apply mul_le_mul_of_nonneg_right hC
        exact mul_nonneg (pow_nonneg (by linarith) _)
          (bracketKernelAt_nonneg (s := t ^ α.weight 1) (a := p 1) (x := v) htj.le)
      _ = max Cs Ct * (if (1 : Fin 3) = 2 then translationWeight r ^ 10 else lam ^ 9) *
          bracketKernelAt (t ^ α.weight 1) (p 1) v := by simp
  · have h := ht r (t ^ α.weight 2) (p 2) v htj
    have hC : Ct ≤ max Cs Ct := le_max_right _ _
    calc
      |cubeGaussianKernel α lam r t p 2 v| +
          |cubeGaussianDerivKernel α lam r t p 2 v| =
          |gaussianAt (t ^ α.weight 2) (p 2 + t ^ α.weight 2 * r) v| +
            |gaussianDerivAt (t ^ α.weight 2) (p 2 + t ^ α.weight 2 * r) v| := by
              simp [cubeGaussianKernel, cubeGaussianDerivKernel, cubeWidth,
                cubeCenterShift]
              ring_nf
      _ ≤ Ct * translationWeight r ^ 10 * bracketKernelAt (t ^ α.weight 2) (p 2) v := h
      _ ≤ max Cs Ct * translationWeight r ^ 10 *
          bracketKernelAt (t ^ α.weight 2) (p 2) v := by
        rw [mul_assoc, mul_assoc]
        apply mul_le_mul_of_nonneg_right hC
        have hR : 0 ≤ translationWeight r := by
          unfold translationWeight
          positivity
        exact mul_nonneg (pow_nonneg hR _)
          (bracketKernelAt_nonneg (s := t ^ α.weight 2) (a := p 2) (x := v) htj.le)
      _ = max Cs Ct * (if (2 : Fin 3) = 2 then translationWeight r ^ 10 else lam ^ 9) *
          bracketKernelAt (t ^ α.weight 2) (p 2) v := by simp

/-- Exact multiplication of the six pointwise majorants. -/
theorem cubeKernel_majorant_prod_eq (α : Anisotropy) (C lam r t : ℝ)
    (p : E3) (x : E6) :
    (∏ q : Fin 3 × Bool,
      C * (if q.1 = 2 then translationWeight r ^ 10 else lam ^ 9) *
        bracketKernelAt (t ^ α.weight q.1) (p q.1) (x q)) =
      C ^ 6 * lam ^ 36 * translationWeight r ^ 20 * cubeBracketWeight α t p x := by
  simp [cubeBracketWeight, Fintype.prod_prod_type, Fin.prod_univ_three]
  ring

/-- Each literal factor in the local six-kernel is controlled by the
corresponding one-coordinate source majorant. -/
theorem localCubeKernel_factor_domination (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i j : Fin 3) (lam r t : ℝ) (p : E3) (v : ℝ),
      1 ≤ lam → 0 < t →
      |if j = i then
        cubeGaussianDerivKernel α lam r t p j v
      else cubeGaussianKernel α lam r t p j v| ≤
        C * (if j = 2 then translationWeight r ^ 10 else lam ^ 9) *
          bracketKernelAt (t ^ α.weight j) (p j) v := by
  rcases cubeGaussian_pair_domination α with ⟨C, hC, hpair⟩
  refine ⟨C, hC, ?_⟩
  intro i j lam r t p v hlam ht
  have h := hpair j lam r t p v hlam ht
  by_cases hji : j = i
  · rw [if_pos hji]
    exact (le_add_of_nonneg_left (abs_nonneg _)).trans h
  · rw [if_neg hji]
    exact (le_add_of_nonneg_right (abs_nonneg _)).trans h

/-- The same source exponents control every choice of one Gaussian or one
derivative-Gaussian in each of the six coordinate slots. -/
theorem cubeGaussian_sixfold_domination (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (choose : Fin 3 × Bool → Bool)
      (lam r t : ℝ) (p : E3) (x : E6), 1 ≤ lam → 0 < t →
      (∏ q : Fin 3 × Bool,
        |if choose q then
          cubeGaussianDerivKernel α lam r t p q.1 (x q)
        else cubeGaussianKernel α lam r t p q.1 (x q)|) ≤
        C ^ 6 * lam ^ 36 * translationWeight r ^ 20 * cubeBracketWeight α t p x := by
  rcases cubeGaussian_pair_domination α with ⟨C, hC, hpair⟩
  refine ⟨C, hC, ?_⟩
  intro choose lam r t p x hlam ht
  have hEach (q : Fin 3 × Bool) :
      |if choose q then
        cubeGaussianDerivKernel α lam r t p q.1 (x q)
      else cubeGaussianKernel α lam r t p q.1 (x q)| ≤
        C * (if q.1 = 2 then translationWeight r ^ 10 else lam ^ 9) *
          bracketKernelAt (t ^ α.weight q.1) (p q.1) (x q) := by
    have h := hpair q.1 lam r t p (x q) hlam ht
    cases hchoice : choose q
    · simpa [hchoice] using (le_add_of_nonneg_right (abs_nonneg _)).trans h
    · simpa [hchoice] using (le_add_of_nonneg_left (abs_nonneg _)).trans h
  calc
    (∏ q : Fin 3 × Bool,
        |if choose q then
          cubeGaussianDerivKernel α lam r t p q.1 (x q)
        else cubeGaussianKernel α lam r t p q.1 (x q)|) ≤
        ∏ q : Fin 3 × Bool,
          C * (if q.1 = 2 then translationWeight r ^ 10 else lam ^ 9) *
            bracketKernelAt (t ^ α.weight q.1) (p q.1) (x q) := by
      apply Finset.prod_le_prod
      · intro q hq
        exact abs_nonneg _
      · intro q hq
        exact hEach q
    _ = C ^ 6 * lam ^ 36 * translationWeight r ^ 20 * cubeBracketWeight α t p x :=
      cubeKernel_majorant_prod_eq α C lam r t p x

/-- The six Gaussian/derivative factors in a local cube form have the
source exponents: four scaled factors give `λ^36`, and two translated
third-coordinate factors give `R(r)^20`. -/
theorem localCubeKernel_abs_domination (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i : Fin 3) (lam r t : ℝ) (p : E3) (x : E6),
      1 ≤ lam → 0 < t →
      |localCubeKernel α i lam r t p x| ≤
        C ^ 6 * lam ^ 36 * translationWeight r ^ 20 * cubeBracketWeight α t p x := by
  rcases localCubeKernel_factor_domination α with ⟨C, hC, hfac⟩
  refine ⟨C, hC, ?_⟩
  intro i lam r t p x hlam ht
  have hEach (q : Fin 3 × Bool) :
      |if q.1 = i then
        cubeGaussianDerivKernel α lam r t p q.1 (x q)
      else cubeGaussianKernel α lam r t p q.1 (x q)| ≤
        C * (if q.1 = 2 then translationWeight r ^ 10 else lam ^ 9) *
          bracketKernelAt (t ^ α.weight q.1) (p q.1) (x q) :=
    hfac i q.1 lam r t p (x q) hlam ht
  have hprod :
      (∏ q : Fin 3 × Bool,
        |if q.1 = i then
          cubeGaussianDerivKernel α lam r t p q.1 (x q)
        else cubeGaussianKernel α lam r t p q.1 (x q)|) ≤
      ∏ q : Fin 3 × Bool,
        C * (if q.1 = 2 then translationWeight r ^ 10 else lam ^ 9) *
          bracketKernelAt (t ^ α.weight q.1) (p q.1) (x q) := by
    apply Finset.prod_le_prod
    · intro q hq
      exact abs_nonneg _
    · intro q hq
      exact hEach q
  rw [localCubeKernel, Finset.abs_prod]
  calc
    (∏ q : Fin 3 × Bool,
        |if q.1 = i then
          cubeGaussianDerivKernel α lam r t p q.1 (x q)
        else cubeGaussianKernel α lam r t p q.1 (x q)|) ≤
        ∏ q : Fin 3 × Bool,
          C * (if q.1 = 2 then translationWeight r ^ 10 else lam ^ 9) *
            bracketKernelAt (t ^ α.weight q.1) (p q.1) (x q) := hprod
    _ = C ^ 6 * lam ^ 36 * translationWeight r ^ 20 * cubeBracketWeight α t p x :=
      cubeKernel_majorant_prod_eq α C lam r t p x

/-! ### Endpoint and face kernel majorants -/

/-- The six literal Gaussian slots, with a Boolean choosing the derivative in
each slot. -/
private def cubeGaussianProduct (α : Anisotropy) (choose : Fin 3 × Bool → Bool)
    (lam r t : ℝ) (p : E3) (x : E6) : ℝ :=
  ∏ q : Fin 3 × Bool,
    if choose q then
      cubeGaussianDerivKernel α lam r t p q.1 (x q)
    else cubeGaussianKernel α lam r t p q.1 (x q)

private theorem cubeGaussianProduct_domination (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (choose : Fin 3 × Bool → Bool)
      (lam r t : ℝ) (p : E3) (x : E6), 1 ≤ lam → 0 < t →
      |cubeGaussianProduct α choose lam r t p x| ≤
        C ^ 6 * lam ^ 36 * translationWeight r ^ 20 * cubeBracketWeight α t p x := by
  rcases cubeGaussian_sixfold_domination α with ⟨C, hC, hdom⟩
  refine ⟨C, hC, ?_⟩
  intro choose lam r t p x hlam ht
  unfold cubeGaussianProduct
  rw [Finset.abs_prod]
  exact hdom choose lam r t p x hlam ht

private theorem cubeEndpointKernel_eq_gaussianProduct (α : Anisotropy)
    (lam r t : ℝ) (p : E3) (x : E6) :
    cubeEndpointKernel α lam r t p x =
      cubeGaussianProduct α (fun _ ↦ false) lam r t p x := by
  unfold cubeEndpointKernel cubeCoordinateD cubeGaussianProduct
  rw [Fintype.prod_prod_type]
  simp_rw [Fintype.prod_bool]
  apply Finset.prod_congr rfl
  intro i hi
  simp
  ring

private theorem cubeEndpointKernel_eq_coordinate_mul_erase (α : Anisotropy)
    (i : Fin 3) (lam r t : ℝ) (p : E3) (x : E6) :
    cubeEndpointKernel α lam r t p x =
      cubeGaussianKernel α lam r t p i (x (i, false)) *
        cubeGaussianKernel α lam r t p i (x (i, true)) *
          ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x := by
  unfold cubeEndpointKernel cubeCoordinateD
  rw [← Finset.mul_prod_erase Finset.univ
    (fun m ↦ cubeGaussianKernel α lam r t p m (x (m, false)) *
      cubeGaussianKernel α lam r t p m (x (m, true))) (Finset.mem_univ i)]

private theorem cubeGaussianProduct_deriv_false_eq (α : Anisotropy)
    (i : Fin 3) (lam r t : ℝ) (p : E3) (x : E6) :
    cubeGaussianProduct α (fun q ↦ decide (q = (i, false))) lam r t p x =
      cubeGaussianDerivKernel α lam r t p i (x (i, false)) *
        cubeGaussianKernel α lam r t p i (x (i, true)) *
          ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x := by
  unfold cubeGaussianProduct cubeCoordinateD
  rw [Fintype.prod_prod_type]
  let A : Fin 3 → ℝ := fun j ↦
    ∏ b : Bool, if decide ((j, b) = (i, false)) then
      cubeGaussianDerivKernel α lam r t p j (x (j, b))
    else cubeGaussianKernel α lam r t p j (x (j, b))
  change (∏ j : Fin 3, A j) = _
  rw [← Finset.mul_prod_erase Finset.univ A (Finset.mem_univ i)]
  have hAi : A i =
      cubeGaussianDerivKernel α lam r t p i (x (i, false)) *
        cubeGaussianKernel α lam r t p i (x (i, true)) := by
    dsimp [A]
    simp
    ring
  rw [hAi]
  congr 1
  apply Finset.prod_congr rfl
  intro m hm
  have hmi : m ≠ i := (Finset.mem_erase.mp hm).1
  dsimp [A]
  simp [hmi]
  ring

private theorem cubeGaussianProduct_deriv_true_eq (α : Anisotropy)
    (i : Fin 3) (lam r t : ℝ) (p : E3) (x : E6) :
    cubeGaussianProduct α (fun q ↦ decide (q = (i, true))) lam r t p x =
      cubeGaussianKernel α lam r t p i (x (i, false)) *
        cubeGaussianDerivKernel α lam r t p i (x (i, true)) *
          ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x := by
  unfold cubeGaussianProduct cubeCoordinateD
  rw [Fintype.prod_prod_type]
  let A : Fin 3 → ℝ := fun j ↦
    ∏ b : Bool, if decide ((j, b) = (i, true)) then
      cubeGaussianDerivKernel α lam r t p j (x (j, b))
    else cubeGaussianKernel α lam r t p j (x (j, b))
  change (∏ j : Fin 3, A j) = _
  rw [← Finset.mul_prod_erase Finset.univ A (Finset.mem_univ i)]
  have hAi : A i =
      cubeGaussianKernel α lam r t p i (x (i, false)) *
        cubeGaussianDerivKernel α lam r t p i (x (i, true)) := by
    dsimp [A]
    simp
    ring
  rw [hAi]
  congr 1
  apply Finset.prod_congr rfl
  intro m hm
  have hmi : m ≠ i := (Finset.mem_erase.mp hm).1
  dsimp [A]
  simp [hmi]
  ring

private theorem cubeFaceKernel_eq_threeGaussianProducts (α : Anisotropy)
    (i : Fin 3) (lam r t : ℝ) (p : E3) (x : E6) :
    cubeFaceKernel α i lam r t p x =
      cubeWidth i lam / (2 * Real.pi) *
        (cubeGaussianProduct α (fun q ↦ decide (q = (i, false))) lam r t p x +
          cubeGaussianProduct α (fun q ↦ decide (q = (i, true))) lam r t p x) -
      cubeCenterShift i r * cubeGaussianProduct α (fun _ ↦ false) lam r t p x := by
  rw [cubeGaussianProduct_deriv_false_eq,
    cubeGaussianProduct_deriv_true_eq,
    ← cubeEndpointKernel_eq_gaussianProduct,
    cubeEndpointKernel_eq_coordinate_mul_erase]
  unfold cubeFaceKernel cubeBoundaryKernel cubeCoordinateD
  ring

/-- The endpoint kernel is bounded by the sixfold bracket weight, with the
four scaled slots contributing `λ^36` and the two translated slots
contributing `R(r)^20`. -/
theorem cubeEndpointKernel_domination (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (lam r t : ℝ) (p : E3) (x : E6),
      1 ≤ lam → 0 < t →
      |cubeEndpointKernel α lam r t p x| ≤
        C ^ 6 * lam ^ 36 * translationWeight r ^ 20 * cubeBracketWeight α t p x := by
  rcases cubeGaussianProduct_domination α with ⟨C, hC, hdom⟩
  refine ⟨C, hC, ?_⟩
  intro lam r t p x hlam ht
  rw [cubeEndpointKernel_eq_gaussianProduct]
  exact hdom (fun _ ↦ false) lam r t p x hlam ht

/-- The complete kernel in one face integral has the source remainder
exponents `λ^37 R(r)^21` against the sixfold bracket weight. -/
theorem cubeFaceKernel_domination (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i : Fin 3) (lam r t : ℝ) (p : E3) (x : E6),
      1 ≤ lam → 0 < t →
      |cubeFaceKernel α i lam r t p x| ≤
        C * lam ^ 37 * translationWeight r ^ 21 * cubeBracketWeight α t p x := by
  rcases cubeGaussianProduct_domination α with ⟨C, hC, hdom⟩
  let P : ℝ := |(2 * Real.pi)⁻¹|
  have hP : 0 ≤ P := abs_nonneg _
  have hcoef : 0 ≤ 2 * P + 1 := by nlinarith
  refine ⟨(2 * P + 1) * C ^ 6, mul_nonneg hcoef (pow_nonneg hC _), ?_⟩
  intro i lam r t p x hlam ht
  let R : ℝ := translationWeight r
  let K : ℝ := C ^ 6 * lam ^ 36 * R ^ 20 * cubeBracketWeight α t p x
  let Pfalse : ℝ := cubeGaussianProduct α
    (fun q ↦ decide (q = (i, false))) lam r t p x
  let Ptrue : ℝ := cubeGaussianProduct α
    (fun q ↦ decide (q = (i, true))) lam r t p x
  let Pall : ℝ := cubeGaussianProduct α (fun _ ↦ false) lam r t p x
  have hRone : 1 ≤ R := by
    dsimp [R, translationWeight]
    linarith [abs_nonneg r]
  have hR : 0 ≤ R := le_trans (by norm_num) hRone
  have hlam0 : 0 ≤ lam := le_trans (by norm_num) hlam
  have hW : 0 ≤ cubeBracketWeight α t p x :=
    cubeBracketWeight_nonneg α ht.le p x
  have hK : 0 ≤ K := by
    dsimp [K]
    exact mul_nonneg
      (mul_nonneg
        (mul_nonneg (pow_nonneg hC _) (pow_nonneg hlam0 _))
        (pow_nonneg hR _)) hW
  have hfalse : |Pfalse| ≤ K := by
    dsimp [Pfalse]
    simpa only [K, R] using
      hdom (fun q ↦ decide (q = (i, false))) lam r t p x hlam ht
  have htrue : |Ptrue| ≤ K := by
    dsimp [Ptrue]
    simpa only [K, R] using
      hdom (fun q ↦ decide (q = (i, true))) lam r t p x hlam ht
  have hall : |Pall| ≤ K := by
    dsimp [Pall]
    simpa only [K, R] using hdom (fun _ ↦ false) lam r t p x hlam ht
  have hwidth0 : 0 ≤ cubeWidth i lam := (cubeWidth_pos_of_one_le i hlam).le
  have hwidth : cubeWidth i lam ≤ lam := by
    fin_cases i <;> simp [cubeWidth, hlam]
  have hscale : |cubeWidth i lam / (2 * Real.pi)| ≤ lam * P := by
    calc
      |cubeWidth i lam / (2 * Real.pi)| =
          cubeWidth i lam * |(2 * Real.pi)⁻¹| := by
            rw [div_eq_mul_inv, abs_mul, abs_of_nonneg hwidth0]
      _ ≤ lam * |(2 * Real.pi)⁻¹| :=
        mul_le_mul_of_nonneg_right hwidth (abs_nonneg _)
      _ = lam * P := rfl
  have hshift : |cubeCenterShift i r| ≤ R := by
    dsimp [R]
    fin_cases i
    · change |0| ≤ translationWeight r
      unfold translationWeight
      simp only [abs_zero]
      linarith [abs_nonneg r]
    · change |0| ≤ translationWeight r
      unfold translationWeight
      simp only [abs_zero]
      linarith [abs_nonneg r]
    · change |r| ≤ translationWeight r
      unfold translationWeight
      linarith [abs_nonneg r]
  have hsum : |Pfalse| + |Ptrue| ≤ K + K := add_le_add hfalse htrue
  have hterm1 : |cubeWidth i lam / (2 * Real.pi)| *
      (|Pfalse| + |Ptrue|) ≤ lam * P * (K + K) := by
    exact mul_le_mul hscale hsum (by positivity)
      (mul_nonneg hlam0 hP)
  have hterm2 : |cubeCenterShift i r| * |Pall| ≤ R * K := by
    exact mul_le_mul hshift hall (abs_nonneg _) hR
  have hcoefbound :
      lam * P * (K + K) + R * K ≤ (2 * P + 1) * lam * R * K := by
    nlinarith [mul_nonneg (sub_nonneg.mpr hlam) (sub_nonneg.mpr hRone),
      mul_nonneg (sub_nonneg.mpr hlam) hK,
      mul_nonneg (sub_nonneg.mpr hRone) hK,
      mul_nonneg hP hK]
  have hdecomp : cubeFaceKernel α i lam r t p x =
      cubeWidth i lam / (2 * Real.pi) * (Pfalse + Ptrue) -
        cubeCenterShift i r * Pall := by
    dsimp [Pfalse, Ptrue, Pall]
    exact cubeFaceKernel_eq_threeGaussianProducts α i lam r t p x
  calc
    |cubeFaceKernel α i lam r t p x| =
        |cubeWidth i lam / (2 * Real.pi) * (Pfalse + Ptrue) -
          cubeCenterShift i r * Pall| := by rw [hdecomp]
    _ ≤ |cubeWidth i lam / (2 * Real.pi)| * (|Pfalse| + |Ptrue|) +
          |cubeCenterShift i r| * |Pall| := by
      calc
        _ ≤ |cubeWidth i lam / (2 * Real.pi) * (Pfalse + Ptrue)| +
            |cubeCenterShift i r * Pall| := by
              simpa using (abs_sub_le
                (cubeWidth i lam / (2 * Real.pi) * (Pfalse + Ptrue)) 0
                (cubeCenterShift i r * Pall))
        _ = |cubeWidth i lam / (2 * Real.pi)| * |Pfalse + Ptrue| +
            |cubeCenterShift i r| * |Pall| := by rw [abs_mul, abs_mul]
        _ ≤ _ := by gcongr; exact abs_add_le _ _
    _ ≤ lam * P * (K + K) + R * K := add_le_add hterm1 hterm2
    _ ≤ (2 * P + 1) * lam * R * K := hcoefbound
    _ = ((2 * P + 1) * C ^ 6) * lam ^ 37 * translationWeight r ^ 21 *
          cubeBracketWeight α t p x := by
      dsimp [K, R]
      ring

/-! ### Spatial absolute integrability for sixfold Gaussian kernels -/

/-- A choice of either `G` or `H` in each of the six spatial slots. -/
noncomputable def cubeSixfoldGaussianKernel (α : Anisotropy)
    (choose : Fin 3 × Bool → Bool) (lam r t : ℝ) (p : E3) (x : E6) : ℝ :=
  ∏ q : Fin 3 × Bool,
    if choose q then
      cubeGaussianDerivKernel α lam r t p q.1 (x q)
    else
      cubeGaussianKernel α lam r t p q.1 (x q)

/-- The signed cube input product is continuous when every source input is
continuous. -/
theorem continuous_cubeSignedInputProduct
    (F : CubeVertex → E3 → ℝ) (hF : ∀ j, Continuous (F j)) :
    Continuous (cubeSignedInputProduct F) := by
  unfold cubeSignedInputProduct
  apply continuous_finsetProd Finset.univ
  intro j _
  exact (hF j).comp (cubeProjection_continuous j)

/-- A continuous Gaussian or derivative-Gaussian factor is continuous in its
one selected spatial coordinate. -/
theorem continuous_cubeSixfoldGaussianFactor
    (α : Anisotropy) (choose : (Fin 3 × Bool) → Bool) (lam r t : ℝ) (p : E3)
    (q : Fin 3 × Bool) :
    Continuous (fun x : E6 ↦
      if choose q then
        cubeGaussianDerivKernel α lam r t p q.1 (x q)
      else
        cubeGaussianKernel α lam r t p q.1 (x q)) := by
  by_cases hq : choose q
  · simp only [hq, ↓reduceIte]
    have harg : Continuous (fun x : E6 ↦
        (x q - (p q.1 + cubeCenterShift q.1 r * t ^ α.weight q.1)) /
          (cubeWidth q.1 lam * t ^ α.weight q.1)) :=
      ((PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 × Bool ↦ ℝ) q).sub
        continuous_const).div_const _
    have hderiv : Continuous gaussianDeriv := by
      unfold gaussianDeriv
      exact (continuous_const.mul continuous_id).mul gaussian_contDiff.continuous
    unfold cubeGaussianDerivKernel gaussianDerivAt kernelAt kernelDilate
    simp only [smul_eq_mul]
    exact continuous_const.mul (hderiv.comp harg)
  · simp only [hq]
    have harg : Continuous (fun x : E6 ↦
        (x q - (p q.1 + cubeCenterShift q.1 r * t ^ α.weight q.1)) /
          (cubeWidth q.1 lam * t ^ α.weight q.1)) :=
      ((PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 × Bool ↦ ℝ) q).sub
        continuous_const).div_const _
    unfold cubeGaussianKernel gaussianAt kernelAt kernelDilate
    simp only [smul_eq_mul]
    exact continuous_const.mul (gaussian_contDiff.continuous.comp harg)

/-- Any sixfold `G/H` kernel is continuous in the six spatial variables. -/
theorem continuous_cubeSixfoldGaussianKernel
    (α : Anisotropy) (choose : (Fin 3 × Bool) → Bool) (lam r t : ℝ) (p : E3) :
    Continuous (cubeSixfoldGaussianKernel α choose lam r t p) := by
  unfold cubeSixfoldGaussianKernel
  apply continuous_finsetProd Finset.univ
  intro q _
  exact continuous_cubeSixfoldGaussianFactor α choose lam r t p q

/-- A uniform bound for the eightfold input product. -/
theorem exists_bound_cubeSignedInputProduct
    (F : CubeVertex → E3 → ℝ)
    (hF : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ x, |cubeSignedInputProduct F x| ≤ B := by
  classical
  choose B hB using hF
  refine ⟨∏ j : CubeVertex, B j, Finset.prod_nonneg (fun j _ ↦ (hB j).1), ?_⟩
  intro x
  rw [cubeSignedInputProduct, Finset.abs_prod]
  exact Finset.prod_le_prod (fun j _ ↦ abs_nonneg _) (fun j _ ↦ (hB j).2 _)

/-- At fixed positive scale, a bounded continuous cube input product times
any sixfold choice of the source `G/H` kernels is absolutely integrable in
the six spatial variables. -/
theorem integrable_cubeSignedInputProduct_mul_sixfoldGaussianKernel
    (α : Anisotropy) (choose : (Fin 3 × Bool) → Bool) (lam r t : ℝ) (p : E3)
    (F : CubeVertex → E3 → ℝ) (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    Integrable (fun x : E6 ↦ cubeSignedInputProduct F x *
      cubeSixfoldGaussianKernel α choose lam r t p x) := by
  rcases exists_bound_cubeSignedInputProduct F hFbound with ⟨B, hB, hinput⟩
  rcases cubeGaussian_sixfold_domination α with ⟨C, hC, hdom⟩
  let D : ℝ := C ^ 6 * lam ^ 36 * translationWeight r ^ 20
  have hmajor : Integrable (fun x : E6 ↦
      (B * D) * cubeBracketWeight α t p x) := by
    simpa only [smul_eq_mul] using
      (integrable_cubeBracketWeight α ht p).const_mul (B * D)
  have hmeas : AEStronglyMeasurable
      (fun x : E6 ↦ cubeSignedInputProduct F x *
        cubeSixfoldGaussianKernel α choose lam r t p x) volume :=
    ((continuous_cubeSignedInputProduct F hFcont).mul
      (continuous_cubeSixfoldGaussianKernel α choose lam r t p)).aestronglyMeasurable
  refine hmajor.mono hmeas (Filter.Eventually.of_forall ?_)
  intro x
  have hkernel : |cubeSixfoldGaussianKernel α choose lam r t p x| ≤
      D * cubeBracketWeight α t p x := by
    dsimp [cubeSixfoldGaussianKernel, D]
    rw [Finset.abs_prod]
    exact hdom choose lam r t p x hlam ht
  have hmajor_nonneg : 0 ≤ (B * D) * cubeBracketWeight α t p x := by
    simpa only [mul_assoc] using
      (mul_nonneg hB (le_trans (abs_nonneg _) hkernel))
  rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul, abs_of_nonneg hmajor_nonneg]
  calc
    |cubeSignedInputProduct F x| *
        |cubeSixfoldGaussianKernel α choose lam r t p x| ≤
        B * (D * cubeBracketWeight α t p x) :=
      mul_le_mul (hinput x) hkernel (abs_nonneg _) hB
    _ = (B * D) * cubeBracketWeight α t p x := by ring

/-- The preceding sixfold statement specialized to the local cube kernel. -/
theorem integrable_cubeSignedInputProduct_mul_localCubeKernel
    (α : Anisotropy) (i : Fin 3) (lam r t : ℝ) (p : E3)
    (F : CubeVertex → E3 → ℝ) (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    Integrable (fun x : E6 ↦ cubeSignedInputProduct F x *
      localCubeKernel α i lam r t p x) := by
  simpa [cubeSixfoldGaussianKernel, localCubeKernel] using
    integrable_cubeSignedInputProduct_mul_sixfoldGaussianKernel
      α (fun q ↦ decide (q.1 = i)) lam r t p F hFcont hFbound hlam ht

/-- Continuity of the fixed-scale endpoint kernel in all six spatial variables. -/
theorem continuous_cubeEndpointKernel
    (α : Anisotropy) (lam r t : ℝ) (p : E3) :
    Continuous (cubeEndpointKernel α lam r t p) := by
  unfold cubeEndpointKernel cubeCoordinateD
  apply continuous_finsetProd Finset.univ
  intro i hi
  have h0 : Continuous (fun x : E6 ↦
      cubeGaussianKernel α lam r t p i (x (i, false))) := by
    simpa using (continuous_cubeSixfoldGaussianFactor α (fun _ ↦ false)
      lam r t p (i, false))
  have h1 : Continuous (fun x : E6 ↦
      cubeGaussianKernel α lam r t p i (x (i, true))) := by
    simpa using (continuous_cubeSixfoldGaussianFactor α (fun _ ↦ false)
      lam r t p (i, true))
  exact h0.mul h1

/-- Continuity of the fixed-scale face kernel in all six spatial variables. -/
theorem continuous_cubeFaceKernel
    (α : Anisotropy) (i : Fin 3) (lam r t : ℝ) (p : E3) :
    Continuous (cubeFaceKernel α i lam r t p) := by
  have hG0 : Continuous (fun x : E6 ↦
      cubeGaussianKernel α lam r t p i (x (i, false))) := by
    simpa using (continuous_cubeSixfoldGaussianFactor α (fun _ ↦ false)
      lam r t p (i, false))
  have hG1 : Continuous (fun x : E6 ↦
      cubeGaussianKernel α lam r t p i (x (i, true))) := by
    simpa using (continuous_cubeSixfoldGaussianFactor α (fun _ ↦ false)
      lam r t p (i, true))
  have hH0 : Continuous (fun x : E6 ↦
      cubeGaussianDerivKernel α lam r t p i (x (i, false))) := by
    simpa using (continuous_cubeSixfoldGaussianFactor α
      (fun q ↦ decide (q = (i, false))) lam r t p (i, false))
  have hH1 : Continuous (fun x : E6 ↦
      cubeGaussianDerivKernel α lam r t p i (x (i, true))) := by
    simpa using (continuous_cubeSixfoldGaussianFactor α
      (fun q ↦ decide (q = (i, true))) lam r t p (i, true))
  have hD : Continuous (fun x : E6 ↦
      cubeCoordinateD α i lam r t p x) := by
    exact hG0.mul hG1
  have hB : Continuous (fun x : E6 ↦
      cubeBoundaryKernel α i lam r t p x) := by
    unfold cubeBoundaryKernel
    exact (continuous_const.mul ((hH0.mul hG1).add (hG0.mul hH1))).sub
      (continuous_const.mul hD)
  have hpassive : Continuous (fun x : E6 ↦
      ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x) := by
    apply continuous_finsetProd (Finset.univ.erase i)
    intro m hm
    have h0 : Continuous (fun x : E6 ↦
        cubeGaussianKernel α lam r t p m (x (m, false))) := by
      simpa using (continuous_cubeSixfoldGaussianFactor α (fun _ ↦ false)
        lam r t p (m, false))
    have h1 : Continuous (fun x : E6 ↦
        cubeGaussianKernel α lam r t p m (x (m, true))) := by
      simpa using (continuous_cubeSixfoldGaussianFactor α (fun _ ↦ false)
        lam r t p (m, true))
    exact h0.mul h1
  exact hB.mul hpassive

/-- Joint center--space continuity for one Gaussian coordinate factor. -/
theorem continuous_cubeGaussianKernel_center_space
    (α : Anisotropy) (i : Fin 3) (b : Bool) (lam r t : ℝ) :
    Continuous (fun z : E3 × E6 ↦
      cubeGaussianKernel α lam r t z.1 i (z.2 (i, b))) := by
  have hx : Continuous (fun z : E3 × E6 ↦ z.2 (i, b)) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 × Bool ↦ ℝ) (i, b)).comp
      continuous_snd
  have hp : Continuous (fun z : E3 × E6 ↦ z.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).comp
      continuous_fst
  have harg : Continuous (fun z : E3 × E6 ↦
      (z.2 (i, b) - (z.1 i + cubeCenterShift i r * t ^ α.weight i)) /
        (cubeWidth i lam * t ^ α.weight i)) :=
    (hx.sub (hp.add continuous_const)).div_const _
  unfold cubeGaussianKernel gaussianAt kernelAt kernelDilate
  simp only [smul_eq_mul]
  exact continuous_const.mul (gaussian_contDiff.continuous.comp harg)

/-- Joint center--space continuity for one differentiated Gaussian factor. -/
theorem continuous_cubeGaussianDerivKernel_center_space
    (α : Anisotropy) (i : Fin 3) (b : Bool) (lam r t : ℝ) :
    Continuous (fun z : E3 × E6 ↦
      cubeGaussianDerivKernel α lam r t z.1 i (z.2 (i, b))) := by
  have hx : Continuous (fun z : E3 × E6 ↦ z.2 (i, b)) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 × Bool ↦ ℝ) (i, b)).comp
      continuous_snd
  have hp : Continuous (fun z : E3 × E6 ↦ z.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).comp
      continuous_fst
  have harg : Continuous (fun z : E3 × E6 ↦
      (z.2 (i, b) - (z.1 i + cubeCenterShift i r * t ^ α.weight i)) /
        (cubeWidth i lam * t ^ α.weight i)) :=
    (hx.sub (hp.add continuous_const)).div_const _
  have hderiv : Continuous gaussianDeriv := by
    unfold gaussianDeriv
    exact (continuous_const.mul continuous_id).mul gaussian_contDiff.continuous
  unfold cubeGaussianDerivKernel gaussianDerivAt kernelAt kernelDilate
  simp only [smul_eq_mul]
  exact continuous_const.mul (hderiv.comp harg)

/-- Joint center--space continuity of the endpoint kernel. -/
theorem continuous_cubeEndpointKernel_center_space
    (α : Anisotropy) (lam r t : ℝ) :
    Continuous (fun z : E3 × E6 ↦ cubeEndpointKernel α lam r t z.1 z.2) := by
  unfold cubeEndpointKernel cubeCoordinateD
  apply continuous_finsetProd Finset.univ
  intro i hi
  exact
    (continuous_cubeGaussianKernel_center_space α i false lam r t).mul
      (continuous_cubeGaussianKernel_center_space α i true lam r t)

/-- Joint center--space continuity of the face kernel. -/
theorem continuous_cubeFaceKernel_center_space
    (α : Anisotropy) (i : Fin 3) (lam r t : ℝ) :
    Continuous (fun z : E3 × E6 ↦ cubeFaceKernel α i lam r t z.1 z.2) := by
  have hG0 := continuous_cubeGaussianKernel_center_space α i false lam r t
  have hG1 := continuous_cubeGaussianKernel_center_space α i true lam r t
  have hH0 := continuous_cubeGaussianDerivKernel_center_space α i false lam r t
  have hH1 := continuous_cubeGaussianDerivKernel_center_space α i true lam r t
  have hD : Continuous (fun z : E3 × E6 ↦
      cubeCoordinateD α i lam r t z.1 z.2) := by
    exact hG0.mul hG1
  have hB : Continuous (fun z : E3 × E6 ↦
      cubeBoundaryKernel α i lam r t z.1 z.2) := by
    unfold cubeBoundaryKernel
    exact (continuous_const.mul ((hH0.mul hG1).add (hG0.mul hH1))).sub
      (continuous_const.mul hD)
  have hpassive : Continuous (fun z : E3 × E6 ↦
      ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t z.1 z.2) := by
    apply continuous_finsetProd (Finset.univ.erase i)
    intro m hm
    exact
      (continuous_cubeGaussianKernel_center_space α m false lam r t).mul
        (continuous_cubeGaussianKernel_center_space α m true lam r t)
  exact hB.mul hpassive

/-- Fixed-center spatial integrability of the endpoint integrand. -/
theorem integrable_cubeSignedInputProduct_mul_cubeEndpointKernel
    (α : Anisotropy) (lam r t : ℝ) (p : E3)
    (F : CubeVertex → E3 → ℝ) (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    Integrable (fun x : E6 ↦ cubeSignedInputProduct F x *
      cubeEndpointKernel α lam r t p x) := by
  rcases exists_bound_cubeSignedInputProduct F hFbound with ⟨B, hB, hinput⟩
  rcases cubeEndpointKernel_domination α with ⟨C, hC, hdom⟩
  let D : ℝ := C ^ 6 * lam ^ 36 * translationWeight r ^ 20
  have hmajor : Integrable (fun x : E6 ↦
      (B * D) * cubeBracketWeight α t p x) := by
    simpa only [smul_eq_mul] using
      (integrable_cubeBracketWeight α ht p).const_mul (B * D)
  have hmeas : AEStronglyMeasurable
      (fun x : E6 ↦ cubeSignedInputProduct F x *
        cubeEndpointKernel α lam r t p x) volume :=
    ((continuous_cubeSignedInputProduct F hFcont).mul
      (continuous_cubeEndpointKernel α lam r t p)).aestronglyMeasurable
  refine hmajor.mono hmeas (Filter.Eventually.of_forall ?_)
  intro x
  have hkernel : |cubeEndpointKernel α lam r t p x| ≤
      D * cubeBracketWeight α t p x := by
    dsimp [D]
    exact hdom lam r t p x hlam ht
  have hmajor_nonneg : 0 ≤ (B * D) * cubeBracketWeight α t p x := by
    simpa only [mul_assoc] using
      (mul_nonneg hB (le_trans (abs_nonneg _) hkernel))
  rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul, abs_of_nonneg hmajor_nonneg]
  calc
    |cubeSignedInputProduct F x| * |cubeEndpointKernel α lam r t p x| ≤
        B * (D * cubeBracketWeight α t p x) :=
      mul_le_mul (hinput x) hkernel (abs_nonneg _) hB
    _ = (B * D) * cubeBracketWeight α t p x := by ring

