      (∀ F : Fin 3 → ℝ, (∏ j ∈ Finset.univ.erase m, F j) = F j₁ * F j₂) →
      (∀ j, 0 < N j) →
      0 < a → Measurable c → (∀ t : ℝ, |c t| ≤ 1) →
      (∀ jj, Measurable (f jj)) → (∀ jj, 0 ≤ Bd jj) →
      (∀ jj, ∀ y : E3, |f jj y| ≤ Bd jj) →
      (∀ jj, MemLp (f jj) (ENNReal.ofReal (q jj.succ)) (volume : Measure E3)) →
      1 ≤ p → p ≤ q m.succ →
