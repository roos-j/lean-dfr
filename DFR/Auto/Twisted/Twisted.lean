    setIntegral_indicator measurableSet_Ioc]
  have hinter : Ioi (0 : ℝ) ∩ Ioc 0 2 = Ioc (0 : ℝ) 2 := by
    ext x
    simp only [Set.mem_inter_iff, Set.mem_Ioi, Set.mem_Ioc]
