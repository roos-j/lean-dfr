  exact hmain u c g (fun jj ↦ (N jj)⁻¹ * Bd jj) a b m j₁ j₂ hsplit ha hcm hc
    hgmeas hgBd0 hgB hgmem hp hpP hAc hgint hgmass hgnorm hgfiber hgn₁ hgn₂ hCA
    hAu hexp

end
