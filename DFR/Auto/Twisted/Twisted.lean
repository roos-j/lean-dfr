        coordinateFiberInput j f (q, (coordinateSplit j x).2)) :=
      hG.comp (measurable_id.prodMk measurable_const)
    exact hshift.lintegral_comp
      (((continuous_abs.measurable.comp hfibmeas).pow_const P).ennreal_ofReal)
