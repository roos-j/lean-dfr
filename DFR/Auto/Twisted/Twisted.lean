hypothesis. -/
theorem modelEnergyOne_le_cubeComparison_of_boundedContinuous :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (α : Anisotropy) (S : BoxCollection α)
      (u : E3) (f : ModelRealInput) (b : Bool),
      (∀ j, Continuous (f j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B) →
      Integrable (modelFirstSuperpositionJoint α u f)
        ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
          ((volume : Measure ModelE5).prod
            ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) ) →
      modelEnergyOne α S u f ≤
        C * sourceWeight u ^ 50 * conePsiPhysicalRealL1 *
          ∫ lam in Set.Ici (1 : ℝ),
            localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
              lam ^ (-47 : ℝ) := by
  rcases modelEnergyOne_le_cubeComparison_of_fubini with ⟨C, hC, hmain⟩
  refine ⟨C, hC, ?_⟩
  intro α S u f b hfcont hfbound hsuper
  apply hmain α S u f b
  · exact integrable_modelEnergyOne_of_boundedContinuous
      α S u f hfcont hfbound
  · exact hsuper
  exact outerFirstSuperposition_eq_cubeComparison α S u f b
    (continuous_modelFirstCubeTuple f hfcont)
    (bounded_modelFirstCubeTuple f hfbound) hsuper

/-- The second local energy satisfies the literal edge-cube comparison under
bounded continuity and the one remaining joint superposition integrability
hypothesis. -/
theorem modelEnergyTwo_le_cubeComparison_of_boundedContinuous :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (α : Anisotropy) (S : BoxCollection α)
      (u : E3) (f : E3 → ℝ) (b : Bool),
      Continuous f →
      (∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) →
      Integrable (modelSecondSuperpositionJoint α f)
        ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
          ((volume : Measure ModelE5).prod
            ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) ) →
      modelEnergyTwo α S u f ≤
        C * sourceWeight u ^ 100 *
          ∫ lam in Set.Ici (1 : ℝ),
            (∫ r : ℝ,
              localCubeForm α S 2 lam r (edgeCubeTuple f) *
                translationWeight r ^ (-50 : ℝ)) * lam ^ (-47 : ℝ) := by
  rcases modelEnergyTwo_le_cubeComparison_of_fubini with ⟨C, hC, hmain⟩
  refine ⟨C, hC, ?_⟩
  intro α S u f b hfcont hfbound hsuper
  apply hmain α S u f b
  · exact integrable_modelEnergyTwo_of_boundedContinuous
      α S u f hfcont hfbound
  · exact hsuper
  exact outerSecondSuperposition_eq_cubeComparison
    α S f b hfcont hfbound hsuper

/-- Constant cube slots have fourth tree local size at most one. -/
theorem treeLocalSize_four_one_le_one
    (α : Anisotropy) (T : FiniteConvexTree α) :
    treeLocalSize T 4 (fun _ : E3 ↦ (1 : ℝ)) ≤ 1 := by
  change collectionLocalSize α T.boxes 4 (fun _ : E3 ↦ (1 : ℝ)) ≤ 1
  rw [collectionLocalSize_eq_sup' T.boxes T.nonempty]
  apply Finset.sup'_le
  intro q hq
  unfold boxLocalSize boxLocalPower
  rw [show (fun y : E3 ↦ |(1 : ℝ)| ^ (4 : ℝ) *
      anisotropicBracketKernel α (boxLength q) (boxCenter α q) y) =
        anisotropicBracketKernel α (boxLength q) (boxCenter α q) by
      funext y
      norm_num]
  rw [integral_anisotropicBracketKernel α (boxLength_pos q) (boxCenter α q)]
  apply Real.rpow_le_one <;> norm_num

/-- An explicit enumeration of the eight cube vertices for finite-product
bookkeeping in the first energy estimate. -/
theorem cubeVertex_univ :
    (Finset.univ : Finset CubeVertex) =
      {cubeVertex false false false, cubeVertex false false true,
        cubeVertex false true false, cubeVertex false true true,
        cubeVertex true false false, cubeVertex true false true,
        cubeVertex true true false, cubeVertex true true true} := by
  decide

/-- The eight first-energy cube slots contribute the square of the three
nonconstant fourth local sizes; the two constant slots are harmless. -/

theorem modelFirstCubeTuple_treeLocalSize_product_le
    (α : Anisotropy) (T : FiniteConvexTree α) (f : ModelRealInput) :
    (∏ j : CubeVertex, treeLocalSize T 4 (modelFirstCubeTuple f j)) ≤
      (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
        treeLocalSize T 4 (f 2)) ^ 2 := by
  let K : ℝ := treeLocalSize T 4 (fun _ : E3 ↦ (1 : ℝ))
  let M0 : ℝ := treeLocalSize T 4 (f 0)
  let M1 : ℝ := treeLocalSize T 4 (f 1)
  let M2 : ℝ := treeLocalSize T 4 (f 2)
  have hK0 : 0 ≤ K := by
    dsimp only [K]
    exact treeLocalSize_four_nonneg T _
  have hK1 : K ≤ 1 := by
    dsimp only [K]
    exact treeLocalSize_four_one_le_one α T
  have hKsq : K * K ≤ 1 := by
    calc
      K * K ≤ 1 * K := mul_le_mul_of_nonneg_right hK1 hK0
      _ ≤ 1 * 1 := mul_le_mul_of_nonneg_left hK1 zero_le_one
      _ = 1 := by ring
  have hM0 : 0 ≤ M0 := by
    dsimp only [M0]
    exact treeLocalSize_four_nonneg T _
  have hM1 : 0 ≤ M1 := by
    dsimp only [M1]
    exact treeLocalSize_four_nonneg T _
  have hM2 : 0 ≤ M2 := by
    dsimp only [M2]
    exact treeLocalSize_four_nonneg T _
  have hP : 0 ≤ (M0 * M1 * M2) ^ 2 := sq_nonneg _
  have h000 : cubeVertex false false false ∉
      ({cubeVertex false false true, cubeVertex false true false,
        cubeVertex false true true, cubeVertex true false false,
        cubeVertex true false true, cubeVertex true true false,
        cubeVertex true true true} : Finset CubeVertex) := by decide
  have h001 : cubeVertex false false true ∉
      ({cubeVertex false true false, cubeVertex false true true,
        cubeVertex true false false, cubeVertex true false true,
        cubeVertex true true false, cubeVertex true true true} : Finset CubeVertex) := by decide
  have h010 : cubeVertex false true false ∉
      ({cubeVertex false true true, cubeVertex true false false,
        cubeVertex true false true, cubeVertex true true false,
        cubeVertex true true true} : Finset CubeVertex) := by decide
  have h011 : cubeVertex false true true ∉
      ({cubeVertex true false false, cubeVertex true false true,
        cubeVertex true true false, cubeVertex true true true} : Finset CubeVertex) := by decide
  have h100 : cubeVertex true false false ∉
      ({cubeVertex true false true, cubeVertex true true false,
        cubeVertex true true true} : Finset CubeVertex) := by decide
  have h101 : cubeVertex true false true ∉
      ({cubeVertex true true false, cubeVertex true true true} : Finset CubeVertex) := by decide
  have h110 : cubeVertex true true false ∉
      ({cubeVertex true true true} : Finset CubeVertex) := by decide
  rw [cubeVertex_univ]
  rw [Finset.prod_insert h000, Finset.prod_insert h001,
    Finset.prod_insert h010, Finset.prod_insert h011,
    Finset.prod_insert h100, Finset.prod_insert h101,
    Finset.prod_insert h110, Finset.prod_singleton]
  simp [modelFirstCubeTuple]
  change M0 * (M0 * (M2 * (M2 * (M1 * (M1 * (K * K)))))) ≤
    (M0 * M1 * M2) ^ 2
  calc
    M0 * (M0 * (M2 * (M2 * (M1 * (M1 * (K * K)))))) =
        (M0 * M1 * M2) ^ 2 * (K * K) := by ring
    _ ≤ (M0 * M1 * M2) ^ 2 * 1 :=
      mul_le_mul_of_nonneg_left hKsq hP
    _ = (M0 * M1 * M2) ^ 2 := by ring

/-- At a fixed positive scale, the full-cube tree estimate leaves exactly the
`λ⁻¹⁰` scale weight after the first-energy normalization. -/
theorem modelFirst_fixed_majorant
    (α : Anisotropy) (T : FiniteConvexTree α) (f : ModelRealInput)
    (lam : ℝ) (C : ℝ)
    (hC : 0 ≤ C)
    (htree : |localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f)| ≤
      C * lam ^ (37 : ℕ) * translationWeight 0 ^ (21 : ℕ) *
        (∏ j : CubeVertex, treeLocalSize T 4 (modelFirstCubeTuple f j)) *
          boxMass α T.root)
    (hlam : 1 ≤ lam) :
    localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) * lam ^ (-47 : ℝ) ≤
      (C *
        (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
          treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root) *
        lam ^ (-10 : ℝ) := by
  have hlam0 : 0 ≤ lam := le_trans zero_le_one hlam
  have hlampos : 0 < lam := lt_of_lt_of_le zero_lt_one hlam
  have hpow47 : 0 ≤ lam ^ (-47 : ℝ) := Real.rpow_nonneg hlam0 _
  have hR0 : translationWeight (0 : ℝ) = 1 := by
    norm_num [translationWeight]
  have hbase : 0 ≤ C * lam ^ (37 : ℕ) * translationWeight 0 ^ (21 : ℕ) := by
    positivity
  have hmass : 0 ≤ boxMass α T.root := (boxMass_pos α T.root).le
  have hprod := modelFirstCubeTuple_treeLocalSize_product_le α T f
  have htree' : |localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f)| ≤
      C * lam ^ (37 : ℕ) * translationWeight 0 ^ (21 : ℕ) *
        (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
          treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root := by
    exact htree.trans
      (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left hprod hbase) hmass)
  have hpow : lam ^ (37 : ℕ) * lam ^ (-47 : ℝ) = lam ^ (-10 : ℝ) := by
    rw [← Real.rpow_natCast]
    rw [← Real.rpow_add hlampos]
    norm_num
  calc
    localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) * lam ^ (-47 : ℝ) ≤
        (C * lam ^ (37 : ℕ) * translationWeight 0 ^ (21 : ℕ) *
          (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
            treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root) *
            lam ^ (-47 : ℝ) :=
      mul_le_mul_of_nonneg_right ((le_abs_self _).trans htree') hpow47
    _ = (C *
        (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
          treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root) *
        lam ^ (-10 : ℝ) := by
      rw [hR0]
      simp only [one_pow, mul_one]
      calc
        C * lam ^ (37 : ℕ) *
              (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
                treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root *
                lam ^ (-47 : ℝ) =
            (C *
              (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
                treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root) *
              (lam ^ (37 : ℕ) * lam ^ (-47 : ℝ)) := by ring
        _ = _ := by rw [hpow]

/-- At a fixed positive scale, the edge-tree estimate leaves the product
`λ⁻¹⁰ R⁻²⁹` after the second-energy normalization. -/
theorem edge_fixed_majorant
    (α : Anisotropy) (T : FiniteConvexTree α) (f : E3 → ℝ)
    (lam r C : ℝ)
    (hC : 0 ≤ C)
    (htree : localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) ≤
      C * lam ^ (37 : ℕ) * translationWeight r ^ (21 : ℕ) *
        treeLocalSize T 2 f ^ 2 * boxMass α T.root)
    (hlam : 1 ≤ lam) :
    localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
        translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ) ≤
      (C * treeLocalSize T 2 f ^ 2 * boxMass α T.root) *
        lam ^ (-10 : ℝ) * translationWeight r ^ (-29 : ℝ) := by
  have hlam0 : 0 ≤ lam := le_trans zero_le_one hlam
  have hlampos : 0 < lam := lt_of_lt_of_le zero_lt_one hlam
  have hRpos : 0 < translationWeight r := by
    unfold translationWeight
    positivity
  have hR0 : 0 ≤ translationWeight r := hRpos.le
  have hpowlam47 : 0 ≤ lam ^ (-47 : ℝ) := Real.rpow_nonneg hlam0 _
  have hpowR50 : 0 ≤ translationWeight r ^ (-50 : ℝ) := Real.rpow_nonneg hR0 _
  have hbase : 0 ≤ C * lam ^ (37 : ℕ) * translationWeight r ^ (21 : ℕ) := by
    positivity
  have hM2 : 0 ≤ treeLocalSize T 2 f ^ 2 := sq_nonneg _
  have hmass : 0 ≤ boxMass α T.root := (boxMass_pos α T.root).le
  have hpowlam : lam ^ (37 : ℕ) * lam ^ (-47 : ℝ) = lam ^ (-10 : ℝ) := by
    rw [← Real.rpow_natCast]
    rw [← Real.rpow_add hlampos]
    norm_num
  have hpowR : translationWeight r ^ (21 : ℕ) *
      translationWeight r ^ (-50 : ℝ) = translationWeight r ^ (-29 : ℝ) := by
    rw [← Real.rpow_natCast]
    rw [← Real.rpow_add hRpos]
    norm_num
  calc
    localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
          translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ) ≤
        (C * lam ^ (37 : ℕ) * translationWeight r ^ (21 : ℕ) *
          treeLocalSize T 2 f ^ 2 * boxMass α T.root) *
          translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ) := by
      gcongr
    _ = (C * treeLocalSize T 2 f ^ 2 * boxMass α T.root) *
          lam ^ (-10 : ℝ) * translationWeight r ^ (-29 : ℝ) := by
      calc
        (C * lam ^ (37 : ℕ) * translationWeight r ^ (21 : ℕ) *
            treeLocalSize T 2 f ^ 2 * boxMass α T.root) *
            translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ) =
          (C * treeLocalSize T 2 f ^ 2 * boxMass α T.root) *
            (lam ^ (37 : ℕ) * lam ^ (-47 : ℝ)) *
              (translationWeight r ^ (21 : ℕ) *
                translationWeight r ^ (-50 : ℝ)) := by ring
        _ = _ := by rw [hpowlam, hpowR]

/-- Integration of the first fixed-scale majorant uses the exact remaining
scale mass `∫₁∞ λ⁻¹⁰ = 1/9`. -/
theorem modelFirst_integral_majorant
    (α : Anisotropy) (T : FiniteConvexTree α) (f : ModelRealInput)
    (C : ℝ) (hC : 0 ≤ C)
    (htree : ∀ lam : ℝ, 1 ≤ lam →
      |localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f)| ≤
        C * lam ^ (37 : ℕ) * translationWeight 0 ^ (21 : ℕ) *
          (∏ j : CubeVertex, treeLocalSize T 4 (modelFirstCubeTuple f j)) *
            boxMass α T.root)
    (hform : IntegrableOn (fun lam : ℝ ↦
      localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) *
        lam ^ (-47 : ℝ)) (Set.Ici (1 : ℝ))) :
    ∫ lam : ℝ in Set.Ici (1 : ℝ),
      localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) *
        lam ^ (-47 : ℝ) ≤
      (C *
        (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
          treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root) / 9 := by
  let D : ℝ := C *
    (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
      treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root
  have hweight : Integrable (fun lam : ℝ ↦ lam ^ (-10 : ℝ))
      ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))) := by
    exact integrableOn_scaleWeight_negTen
  have hmajor : Integrable (fun lam : ℝ ↦ D * lam ^ (-10 : ℝ))
      ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))) :=
    hweight.const_mul D
  have hAE : ∀ᵐ lam : ℝ ∂(volume.restrict (Set.Ici (1 : ℝ))),
      localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) *
          lam ^ (-47 : ℝ) ≤ D * lam ^ (-10 : ℝ) := by
    filter_upwards [ae_restrict_mem (measurableSet_Ici : MeasurableSet (Set.Ici (1 : ℝ)))]
      with lam hlam
    exact modelFirst_fixed_majorant α T f lam C hC (htree lam hlam) hlam
  calc
    ∫ lam : ℝ in Set.Ici (1 : ℝ),
        localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) *
          lam ^ (-47 : ℝ) ≤
        ∫ lam : ℝ in Set.Ici (1 : ℝ), D * lam ^ (-10 : ℝ) :=
      integral_mono_ae hform hmajor hAE
    _ = D * (∫ lam : ℝ in Set.Ici (1 : ℝ), lam ^ (-10 : ℝ)) := by
      rw [MeasureTheory.integral_const_mul]
    _ = (C *
        (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
          treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root) / 9 := by
      rw [integralOn_scaleWeight_negTen]
      dsimp only [D]
      ring

/-- Integration of the edge fixed-scale majorant uses the two exact remaining
masses `1/9` and `1/14`, hence the factor `1/126`. -/
theorem edge_integral_majorant
    (α : Anisotropy) (T : FiniteConvexTree α) (f : E3 → ℝ)
    (C : ℝ) (hC : 0 ≤ C)
    (htree : ∀ (lam r : ℝ), 1 ≤ lam →
      localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) ≤
        C * lam ^ (37 : ℕ) * translationWeight r ^ (21 : ℕ) *
          treeLocalSize T 2 f ^ 2 * boxMass α T.root)
    (hform : Integrable (fun z : ℝ × ℝ ↦
      localCubeForm α T.boxes 2 z.1 z.2 (edgeCubeTuple f) *
          translationWeight z.2 ^ (-50 : ℝ) * z.1 ^ (-47 : ℝ))
      (((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))).prod volume)) :
    ∫ lam : ℝ in Set.Ici (1 : ℝ),
        (∫ r : ℝ,
          localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
            translationWeight r ^ (-50 : ℝ)) * lam ^ (-47 : ℝ) ≤
      (C * treeLocalSize T 2 f ^ 2 * boxMass α T.root) / 126 := by
  let D : ℝ := C * treeLocalSize T 2 f ^ 2 * boxMass α T.root
  let nu : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  have hweightlam : Integrable (fun lam : ℝ ↦ lam ^ (-10 : ℝ)) nu := by
    exact integrableOn_scaleWeight_negTen
  have hweightr : Integrable (fun r : ℝ ↦ translationWeight r ^ (-29 : ℝ))
      (volume : Measure ℝ) := integrable_translationWeight_negTwentyNine
  have hmajor : Integrable (fun z : ℝ × ℝ ↦
      D * z.1 ^ (-10 : ℝ) * translationWeight z.2 ^ (-29 : ℝ))
      (nu.prod volume) := by
    simpa only [mul_assoc] using (hweightlam.mul_prod hweightr).const_mul D
  have hinner : ∀ᵐ lam : ℝ ∂nu,
      (∫ r : ℝ,
        localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
          translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ)) ≤
        ∫ r : ℝ, D * lam ^ (-10 : ℝ) * translationWeight r ^ (-29 : ℝ) := by
    filter_upwards [hform.prod_right_ae, hmajor.prod_right_ae,
      ae_restrict_mem (measurableSet_Ici : MeasurableSet (Set.Ici (1 : ℝ)))]
      with lam hformlam hmajorlam hlam
    apply integral_mono_ae hformlam hmajorlam
    filter_upwards [] with r
    exact edge_fixed_majorant α T f lam r C hC (htree lam r hlam) hlam
  have houter :
      (∫ lam : ℝ in Set.Ici (1 : ℝ),
        ∫ r : ℝ,
          localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
            translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ)) ≤
        ∫ lam : ℝ in Set.Ici (1 : ℝ),
          ∫ r : ℝ, D * lam ^ (-10 : ℝ) * translationWeight r ^ (-29 : ℝ) := by
    exact integral_mono_ae hform.integral_prod_left hmajor.integral_prod_left hinner
  have hrewrite :
      (∫ lam : ℝ in Set.Ici (1 : ℝ),
        (∫ r : ℝ,
          localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
            translationWeight r ^ (-50 : ℝ)) * lam ^ (-47 : ℝ)) =
      ∫ lam : ℝ in Set.Ici (1 : ℝ),
        ∫ r : ℝ,
          localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
            translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ) := by
    apply integral_congr_ae
    filter_upwards [] with lam
    rw [MeasureTheory.integral_mul_const]
  have heval :
      (∫ lam : ℝ in Set.Ici (1 : ℝ),
        ∫ r : ℝ, D * lam ^ (-10 : ℝ) * translationWeight r ^ (-29 : ℝ)) =
      D / 126 := by
    calc
      (∫ lam : ℝ in Set.Ici (1 : ℝ),
        ∫ r : ℝ, D * lam ^ (-10 : ℝ) * translationWeight r ^ (-29 : ℝ)) =
          ∫ lam : ℝ in Set.Ici (1 : ℝ),
            (D * lam ^ (-10 : ℝ)) *
              (∫ r : ℝ, translationWeight r ^ (-29 : ℝ)) := by
        apply integral_congr_ae
        filter_upwards [] with lam
        rw [MeasureTheory.integral_const_mul]
      _ = ∫ lam : ℝ in Set.Ici (1 : ℝ),
            (D / 14) * lam ^ (-10 : ℝ) := by
        apply integral_congr_ae
        filter_upwards [] with lam
        rw [integral_translationWeight_negTwentyNine]
        ring
      _ = (D / 14) *
          (∫ lam : ℝ in Set.Ici (1 : ℝ), lam ^ (-10 : ℝ)) := by
        rw [MeasureTheory.integral_const_mul]
      _ = D / 126 := by
        rw [integralOn_scaleWeight_negTen]
        ring
  rw [hrewrite]
  exact houter.trans_eq heval

/-- The first model energy is controlled by the full-cube tree estimate.  The
only analytic hypothesis left explicit is the exact normalized scale
integrability used to justify the comparison integral. -/
theorem modelEnergyOne_tree_bound_of_boundedContinuous
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α)
      (u : E3) (f : ModelRealInput) (b : Bool),
      (∀ j, Continuous (f j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B) →
      Integrable (modelFirstSuperpositionJoint α u f)
        ((cubeScaleMeasure.restrict (collectionRegion α T.boxes)).prod
          ((volume : Measure ModelE5).prod
            ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) ) →
      IntegrableOn (fun lam : ℝ ↦
        localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) *
          lam ^ (-47 : ℝ)) (Set.Ici (1 : ℝ)) →
      modelEnergyOne α T.boxes u f ≤
        C * sourceWeight u ^ 50 * boxMass α T.root *
          (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
            treeLocalSize T 4 (f 2)) ^ 2 := by
  rcases modelEnergyOne_le_cubeComparison_of_boundedContinuous with
    ⟨CE, hCE, henergy⟩
  rcases fullCubeTreeEstimate_of_boundedContinuous α with ⟨CT, hCT, htree⟩
  refine ⟨CE * CT * conePsiPhysicalRealL1 / 9, ?_, ?_⟩
  · have hL1 : 0 ≤ conePsiPhysicalRealL1 := by
      unfold conePsiPhysicalRealL1
      exact integral_nonneg fun r ↦ abs_nonneg _
    positivity
  intro T u f b hfcont hfbound hsuper hform
  have hL1 : 0 ≤ conePsiPhysicalRealL1 := by
    unfold conePsiPhysicalRealL1
    exact integral_nonneg fun r ↦ abs_nonneg _
  have htree' : ∀ lam : ℝ, 1 ≤ lam →
      |localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f)| ≤
        CT * lam ^ (37 : ℕ) * translationWeight 0 ^ (21 : ℕ) *
          (∏ j : CubeVertex, treeLocalSize T 4 (modelFirstCubeTuple f j)) *
            boxMass α T.root := by
    intro lam hlam
    exact htree T lam 0 (modelFirstCubeTuple f) 2
      (continuous_modelFirstCubeTuple f hfcont)
      (bounded_modelFirstCubeTuple f hfbound) hlam
  have hI := modelFirst_integral_majorant α T f CT hCT htree' hform
  have henergy' := henergy α T.boxes u f b hfcont hfbound hsuper
  have hfac : 0 ≤ CE * sourceWeight u ^ 50 * conePsiPhysicalRealL1 := by
    positivity
  calc
    modelEnergyOne α T.boxes u f ≤
        CE * sourceWeight u ^ 50 * conePsiPhysicalRealL1 *
          ∫ lam : ℝ in Set.Ici (1 : ℝ),
            localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) *
              lam ^ (-47 : ℝ) := henergy'
    _ ≤ CE * sourceWeight u ^ 50 * conePsiPhysicalRealL1 *
        ((CT *
          (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
            treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root) / 9) :=
      mul_le_mul_of_nonneg_left hI hfac
    _ = (CE * CT * conePsiPhysicalRealL1 / 9) *
        sourceWeight u ^ 50 * boxMass α T.root *
          (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
            treeLocalSize T 4 (f 2)) ^ 2 := by ring

/-- The second model energy is controlled by the edge-cube tree estimate.
The remaining hypothesis is precisely the joint scale--translation
integrability needed for the Fubini comparison. -/
theorem modelEnergyTwo_tree_bound_of_boundedContinuous
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α)
      (u : E3) (f : E3 → ℝ) (b : Bool),
      Continuous f →
      (∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) →
      Integrable (modelSecondSuperpositionJoint α f)
        ((cubeScaleMeasure.restrict (collectionRegion α T.boxes)).prod
          ((volume : Measure ModelE5).prod
            ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) ) →
      Integrable (fun z : ℝ × ℝ ↦
        localCubeForm α T.boxes 2 z.1 z.2 (edgeCubeTuple f) *
          translationWeight z.2 ^ (-50 : ℝ) * z.1 ^ (-47 : ℝ))
        (((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))).prod volume) →
      modelEnergyTwo α T.boxes u f ≤
        C * sourceWeight u ^ 100 * boxMass α T.root * treeLocalSize T 2 f ^ 2 := by
  rcases modelEnergyTwo_le_cubeComparison_of_boundedContinuous with
    ⟨CE, hCE, henergy⟩
  rcases edgeTreeEstimate_of_boundedContinuous α with ⟨CT, hCT, htree⟩
  refine ⟨CE * CT / 126, ?_, ?_⟩
  · positivity
  intro T u f b hfcont hfbound hsuper hform
  have htree' : ∀ (lam r : ℝ), 1 ≤ lam →
      localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) ≤
        CT * lam ^ (37 : ℕ) * translationWeight r ^ (21 : ℕ) *
          treeLocalSize T 2 f ^ 2 * boxMass α T.root := by
    intro lam r hlam
    exact (htree T lam r f hfcont hfbound hlam).2.2.2
  have hI := edge_integral_majorant α T f CT hCT htree' hform
  have henergy' := henergy α T.boxes u f b hfcont hfbound hsuper
  have hfac : 0 ≤ CE * sourceWeight u ^ 100 := by
    positivity
  calc
    modelEnergyTwo α T.boxes u f ≤
        CE * sourceWeight u ^ 100 *
          ∫ lam : ℝ in Set.Ici (1 : ℝ),
            (∫ r : ℝ,
              localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
                translationWeight r ^ (-50 : ℝ)) * lam ^ (-47 : ℝ) := henergy'
    _ ≤ CE * sourceWeight u ^ 100 *
        ((CT * treeLocalSize T 2 f ^ 2 * boxMass α T.root) / 126) :=
      mul_le_mul_of_nonneg_left hI hfac
    _ = (CE * CT / 126) * sourceWeight u ^ 100 *
        boxMass α T.root * treeLocalSize T 2 f ^ 2 := by ring

/-- Fubini in the literal three-coordinate order used by the final
one-dimensional square-function identity. -/
theorem integral_real_cube_eq_nested
    (H : ℝ × (ℝ × ℝ) → ℝ)
    (hH : Integrable H
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) :
    (∫ z : ℝ × (ℝ × ℝ), H z
      ∂((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) =
      ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ v : ℝ, H (x₁, (x₂, v)) := by
  let K : ℝ → ℝ := fun x₁ ↦
    ∫ x₂ : ℝ, ∫ v : ℝ, H (x₁, (x₂, v))
  have hpair (x₁ : ℝ)
      (hx₁ : Integrable (fun q : ℝ × ℝ ↦ H (x₁, q))
        ((volume : Measure ℝ).prod volume)) :
      (∫ q : ℝ × ℝ, H (x₁, q)
        ∂((volume : Measure ℝ).prod volume)) = K x₁ := by
    calc
      (∫ q : ℝ × ℝ, H (x₁, q)
        ∂((volume : Measure ℝ).prod volume)) =
          ∫ x₂ : ℝ, ∫ v : ℝ, H (x₁, (x₂, v)) := by
            exact integral_prod _ hx₁
      _ = K x₁ := by rfl
  have hK : Integrable K (volume : Measure ℝ) := by
    have hleft := hH.integral_prod_left
    apply hleft.congr
    filter_upwards [hH.prod_right_ae] with x₁ hx₁
    exact hpair x₁ hx₁
  calc
    (∫ z : ℝ × (ℝ × ℝ), H z
      ∂((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) =
        ∫ x₁ : ℝ, ∫ q : ℝ × ℝ, H (x₁, q)
          ∂((volume : Measure ℝ).prod volume) :=
      integral_prod _ hH
    _ = ∫ x₁ : ℝ, K x₁ := by
      apply integral_congr_ae
      filter_upwards [hH.prod_right_ae] with x₁ hx₁
      exact hpair x₁ hx₁
    _ = ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ v : ℝ, H (x₁, (x₂, v)) := by
      rfl

/-- The coordinate parametrization used by the third-coordinate fibers is
the inverse of `e3Coordinates`. -/
theorem modelPoint_e3Coordinates
    (x : E3) : modelPoint (x 0) (x 1) (x 2) = x := by
  ext i
  fin_cases i <;> simp

/-- The ambient squared norm of an integrable real input is exactly its
three-coordinate iterated integral. -/
theorem integral_modelPoint_sq_eq
    (f : E3 → ℝ)
    (hf : Integrable (fun x : E3 ↦ f x ^ 2)) :
    (∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ v : ℝ,
      f (modelPoint x₁ x₂ v) ^ 2) =
      ∫ x : E3, f x ^ 2 := by
  let G : ℝ × (ℝ × ℝ) → ℝ := fun z ↦
    f (modelPoint z.1 z.2.1 z.2.2) ^ 2
  have hG : Integrable G
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    let e := e3Coordinates
    have hmp : MeasurePreserving e (volume : Measure E3)
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
      simpa only [e] using e3Coordinates_measurePreserving
    have hcomp : (fun z : ℝ × (ℝ × ℝ) ↦ G z) =
        (fun x : E3 ↦ f x ^ 2) ∘ e.symm := by
      funext z
      rcases z with ⟨x₁, x₂, v⟩
      simp only [Function.comp_apply, G]
      congr 2
      apply e.injective
      simp only [e, e3Coordinates_apply]
      exact Prod.ext rfl (Prod.ext rfl rfl)
    have htrans :=
      (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hf
    apply htrans.congr
    filter_upwards [] with z
    exact (congrFun hcomp z).symm
  calc
    (∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ v : ℝ,
      f (modelPoint x₁ x₂ v) ^ 2) =
        ∫ z : ℝ × (ℝ × ℝ), G z
          ∂((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
            exact (integral_real_cube_eq_nested G hG).symm
    _ = ∫ x : E3, f x ^ 2 := by
      let e := e3Coordinates
      have hmp : MeasurePreserving e (volume : Measure E3)
          ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
        simpa only [e] using e3Coordinates_measurePreserving
      have hpoint (x : E3) : G (e x) = f x ^ 2 := by
        simp only [G, e, e3Coordinates_apply]
        rw [modelPoint_e3Coordinates]
      calc
        (∫ z : ℝ × (ℝ × ℝ), G z
          ∂((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) =
            ∫ x : E3, G (e x) := by
              exact (hmp.integral_comp' G).symm
        _ = ∫ x : E3, f x ^ 2 := by
          apply integral_congr_ae
          filter_upwards [] with x
          exact hpoint x

/-- On the global positive-scale region the product restriction in
`cubeScaleMeasure` is exactly the product of Lebesgue measure and the
restricted logarithmic scale measure. -/
theorem cubeScaleMeasure_restrict_global_eq :
    cubeScaleMeasure.restrict (Set.univ ×ˢ Set.Ioi (0 : ℝ)) =
      (volume : Measure E3).prod
        (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
          (Set.Ioi (0 : ℝ))) := by
  unfold cubeScaleMeasure
  rw [← Measure.prod_restrict]
  simp

/-- Joint integrability transports the global second energy to the literal
nine scalar coordinates.  This is the exact Tonelli bridge before the
scalar mass and one-dimensional square-function reductions. -/
theorem modelEnergyTwoOn_eq_reordered_nested
    (α : Anisotropy) (u : E3) (f : E3 → ℝ)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyTwoIntegrand α u f q.1 q.2)
      ((cubeScaleMeasure.restrict (Set.univ ×ˢ Set.Ioi (0 : ℝ))).prod volume)) :
    modelEnergyTwoOn α (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f =
      ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ p₂ : ℝ,
        ∫ t : ℝ in Set.Ioi (0 : ℝ),
          (∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
            (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
              modelEnergyDensityReordered α u x₁ x₂ t p₀ p₁ y₁ y₂ r
          ) ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
  let ν : Measure ℝ :=
    (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
      (Set.Ioi (0 : ℝ)))
  let G : (E3 × ℝ) × ModelE5 → ℝ := fun q ↦
    modelEnergyTwoIntegrand α u f q.1 q.2
  let μouter : Measure ScratchModelEnergyOuter :=
    ((volume : Measure ℝ).prod volume).prod ((volume : Measure ℝ).prod ν)
  let μinner : Measure ScratchModelEnergyInner :=
    ((volume : Measure ℝ).prod volume).prod
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))
  have hjoint' : Integrable G (((volume : Measure E3).prod ν).prod volume) := by
    simpa only [G, ν, cubeScaleMeasure_restrict_global_eq] using hjoint
  have htrans : Integrable (fun w : ScratchModelEnergyOuter × ScratchModelEnergyInner ↦
      G (modelEnergyCoordinateReorder.symm w)) (μouter.prod μinner) := by
    have hmp := modelEnergyCoordinateReorder_measurePreserving_scale ν
    exact (MeasurePreserving.symm modelEnergyCoordinateReorder hmp).integrable_comp_of_integrable
      hjoint'
  let K : ScratchModelEnergyOuter → ℝ := fun w ↦
    ∫ v : ScratchModelEnergyInner,
      G (modelEnergyCoordinateReorder.symm (w, v)) ∂μinner
  have hK : Integrable K μouter := by
    exact htrans.integral_prod_left
  let L : ScratchModelEnergyOuter → ℝ := fun w ↦
    ∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
      (modelSecondFiberReduced α f w.1.1 w.1.2 w.2.1 w.2.2 r) ^ 2 *
        modelEnergyDensityReordered α u w.1.1 w.1.2 w.2.2
          p₀ p₁ y₁ y₂ r
  have hKL : K =ᵐ[μouter] L := by
    filter_upwards [htrans.prod_right_ae] with w hw
    dsimp [K, L]
    calc
      (∫ v : ScratchModelEnergyInner,
        G (modelEnergyCoordinateReorder.symm (w, v)) ∂μinner) =
          ∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
            G (modelEnergyCoordinateReorder.symm
              (w, ((p₀, p₁), (y₁, (y₂, r))))) := by
              exact integral_ScratchModelEnergyInner_eq_nested _ hw
      _ = ∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
          (modelSecondFiberReduced α f w.1.1 w.1.2 w.2.1 w.2.2 r) ^ 2 *
            modelEnergyDensityReordered α u w.1.1 w.1.2 w.2.2
              p₀ p₁ y₁ y₂ r := by
            apply integral_congr_ae
            filter_upwards [] with p₀
            apply integral_congr_ae
            filter_upwards [] with p₁
            apply integral_congr_ae
            filter_upwards [] with y₁
            apply integral_congr_ae
            filter_upwards [] with y₂
            apply integral_congr_ae
            filter_upwards [] with r
            rcases w with ⟨⟨x₁, x₂⟩, ⟨p₂, t⟩⟩
            exact modelEnergyTwoIntegrand_reorder_symm
              α u f x₁ x₂ p₂ t p₀ p₁ y₁ y₂ r
  have hL : Integrable L μouter := hK.congr hKL
  calc
    modelEnergyTwoOn α (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f =
        ∫ q : (E3 × ℝ) × ModelE5, G q
          ∂(((volume : Measure E3).prod ν).prod volume) := by
            rw [modelEnergyTwoOn_eq_jointIntegral_of_integrable α
              (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f hjoint]
            simp only [G, ν, cubeScaleMeasure_restrict_global_eq]
    _ = ∫ w : ScratchModelEnergyOuter, K w ∂μouter := by
          exact integral_modelEnergyCoordinateReorder_fubini ν G hjoint'
    _ = ∫ w : ScratchModelEnergyOuter, L w ∂μouter := by
          exact integral_congr_ae hKL
    _ = ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ p₂ : ℝ,
        ∫ t : ℝ, L ((x₁, x₂), (p₂, t)) ∂ν := by
          exact integral_ScratchModelEnergyOuter_eq_nested ν L hL
    _ = ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ p₂ : ℝ,
        ∫ t : ℝ in Set.Ioi (0 : ℝ),
          (∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
            (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
              modelEnergyDensityReordered α u x₁ x₂ t p₀ p₁ y₁ y₂ r
          ) ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
          dsimp [ν, L]

/-- After the harmless scalar variables have been removed, the remaining
positive-scale integral is the global third-coordinate square function.
The two hypotheses are precisely the product-Fubini condition and the
fixed-fiber translation condition used by the scalar reductions. -/
theorem reordered_scalar_energy_eq_global_L2
    (α : Anisotropy) (u : E3) (f : SchwartzMap E3 ℝ)
    (hscalar : Integrable (fun w : ScratchModelEnergyOuter ↦
      (∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
        (modelSecondFiberReduced α f w.1.1 w.1.2 w.2.1 w.2.2 r) ^ 2) *
        (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2)
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod
          (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
            (Set.Ioi (0 : ℝ))))))
    (hpr : ∀ (x₁ x₂ t : ℝ), 0 < t → Integrable (fun z : ℝ × ℝ ↦
      (modelSecondFiberReduced α f x₁ x₂ z.1 t z.2) ^ 2 *
        |conePsiPhysicalReal (z.2 + u 2)|)
      ((volume : Measure ℝ).prod volume)) :
    (∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ p₂ : ℝ,
      ∫ t : ℝ in Set.Ioi (0 : ℝ),
        ((∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
          (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2) *
          (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2)
        ∂((volume : Measure ℝ).withDensity cubeScaleDensity)) =
      (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 *
        conePsiPhysicalRealL1 * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ x : E3, f x ^ 2 := by
  let ν : Measure ℝ :=
    ((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
      (Set.Ioi (0 : ℝ))
  let A : ℝ := (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2
  let P : ℝ := conePsiPhysicalRealL1
  let Q : ℝ → ℝ → ℝ → ℝ := fun x₁ x₂ t ↦
    ∫ q : ℝ, (∫ v : ℝ, f (modelPoint x₁ x₂ v) *
      gaussianDerivAt (t ^ α.weight 2) q v) ^ 2
  let H : ScratchModelEnergyOuter → ℝ := fun w ↦
    A * ∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
      (modelSecondFiberReduced α f w.1.1 w.1.2 w.2.1 w.2.2 r) ^ 2
  have hH : Integrable H
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ν)) := by
    apply hscalar.congr
    filter_upwards [] with w
    dsimp [H, A]
    ring
  have hswap (x : ℝ × ℝ)
      (hx : Integrable (fun pt : ℝ × ℝ ↦ H (x, pt))
        ((volume : Measure ℝ).prod ν)) :
      (∫ p₂ : ℝ, ∫ t : ℝ, H (x, (p₂, t)) ∂ν) =
        ∫ t : ℝ, (∫ p₂ : ℝ, H (x, (p₂, t))) ∂ν := by
    have hx' : Integrable (Function.uncurry
        (fun p₂ : ℝ ↦ fun t : ℝ ↦ H (x, (p₂, t))))
        ((volume : Measure ℝ).prod ν) := by
      apply hx.congr
      filter_upwards [] with pt
      rcases pt with ⟨p₂, t⟩
      rfl
    simpa only using (integral_integral_swap hx')
  let J : ℝ × ℝ → ℝ := fun x ↦
    ∫ t : ℝ, (∫ p₂ : ℝ, H (x, (p₂, t))) ∂ν
  have hJ : Integrable J ((volume : Measure ℝ).prod volume) := by
    have hleft := hH.integral_prod_left
    apply hleft.congr
    filter_upwards [hH.prod_right_ae] with x hx
    calc
      (∫ pt : ℝ × ℝ, H (x, pt) ∂((volume : Measure ℝ).prod ν)) =
          ∫ p₂ : ℝ, ∫ t : ℝ, H (x, (p₂, t)) ∂ν :=
        integral_prod _ hx
      _ = J x := hswap x hx
  have hJvalue (x₁ x₂ : ℝ) :
      J (x₁, x₂) =
        A * P * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ v : ℝ, f (modelPoint x₁ x₂ v) ^ 2 := by
    dsimp [J, ν]
    change (∫ t : ℝ in Set.Ioi (0 : ℝ),
      (∫ p₂ : ℝ, H ((x₁, x₂), (p₂, t)))
      ∂((volume : Measure ℝ).withDensity cubeScaleDensity)) = _
    calc
      (∫ t : ℝ in Set.Ioi (0 : ℝ),
        (∫ p₂ : ℝ, H ((x₁, x₂), (p₂, t)))
        ∂((volume : Measure ℝ).withDensity cubeScaleDensity)) =
          ∫ t : ℝ in Set.Ioi (0 : ℝ), A * (P * Q x₁ x₂ t)
            ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
            apply setIntegral_congr_fun measurableSet_Ioi
            intro t ht
            dsimp [H]
            rw [integral_const_mul]
            calc
              A * ∫ p₂ : ℝ, ∫ r : ℝ,
                |conePsiPhysicalReal (r + u 2)| *
                  (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 =
                  A * ∫ p₂ : ℝ, ∫ r : ℝ,
                    (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
                      |conePsiPhysicalReal (r + u 2)| := by
                        congr 1
                        apply integral_congr_ae
                        filter_upwards [] with p₂
                        apply integral_congr_ae
                        filter_upwards [] with r
                        ring
              _ = A * (P * Q x₁ x₂ t) := by
                    rw [show (∫ p₂ : ℝ, ∫ r : ℝ,
                      (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
                        |conePsiPhysicalReal (r + u 2)|) = P * Q x₁ x₂ t by
                      dsimp [P, Q]
                      exact modelSecondFiberReduced_p2_r_reduction α u f x₁ x₂ t
                        (hpr x₁ x₂ t ht)]
      _ = ∫ t : ℝ in Set.Ioi (0 : ℝ),
          (A * P * Q x₁ x₂ t)
            ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
            apply setIntegral_congr_fun measurableSet_Ioi
            intro t ht
            ring
      _ = ∫ t : ℝ in Set.Ioi (0 : ℝ),
          (A * P * Q x₁ x₂ t) / t := by
            exact integral_Ioi_withDensity_cubeScaleDensity_eq
              (fun t : ℝ ↦ A * P * Q x₁ x₂ t)
      _ = A * P * ∫ t : ℝ in Set.Ioi (0 : ℝ), Q x₁ x₂ t / t := by
            rw [show (fun t : ℝ ↦ (A * P * Q x₁ x₂ t) / t) =
              fun t : ℝ ↦ (A * P) * (Q x₁ x₂ t / t) by
                funext t
                ring,
              integral_const_mul]
      _ = A * P * ((Real.pi / (α.weight 2 : ℝ)) *
          ∫ v : ℝ, f (modelPoint x₁ x₂ v) ^ 2) := by
            rw [show (∫ t : ℝ in Set.Ioi (0 : ℝ), Q x₁ x₂ t / t) =
              ∫ t : ℝ in Set.Ioi (0 : ℝ), ∫ q : ℝ,
                (∫ v : ℝ, f (modelPoint x₁ x₂ v) *
                  gaussianDerivAt (t ^ α.weight 2) q v) ^ 2 / t by
                apply setIntegral_congr_fun measurableSet_Ioi
                intro t ht
                dsimp [Q]
                rw [integral_div],
              modelThird_square_function_of_real_schwartz α f x₁ x₂]
      _ = A * P * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ v : ℝ, f (modelPoint x₁ x₂ v) ^ 2 := by ring
  have hfsq : Integrable (fun x : E3 ↦ f x ^ 2) := by
    exact (memLp_two_iff_integrable_sq
      f.continuous.aestronglyMeasurable).mp (f.memLp 2 volume)
  calc
    (∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ p₂ : ℝ,
      ∫ t : ℝ in Set.Ioi (0 : ℝ),
        ((∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
          (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2) *
          (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2)
        ∂((volume : Measure ℝ).withDensity cubeScaleDensity)) =
        ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ p₂ : ℝ,
          ∫ t : ℝ in Set.Ioi (0 : ℝ),
            H ((x₁, x₂), (p₂, t))
            ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
            dsimp [H, A, ν]
            apply integral_congr_ae
            filter_upwards [] with x₁
            apply integral_congr_ae
            filter_upwards [] with x₂
            apply integral_congr_ae
            filter_upwards [] with p₂
            apply integral_congr_ae
            filter_upwards [] with t
            ring
    _ = ∫ w : ScratchModelEnergyOuter, H w
        ∂(((volume : Measure ℝ).prod volume).prod
          ((volume : Measure ℝ).prod ν)) := by
          exact (integral_ScratchModelEnergyOuter_eq_nested ν H hH).symm
    _ = ∫ x : ℝ × ℝ, ∫ pt : ℝ × ℝ, H (x, pt)
        ∂((volume : Measure ℝ).prod ν) := by
          exact integral_prod _ hH
    _ = ∫ x : ℝ × ℝ, J x := by
          apply integral_congr_ae
          filter_upwards [hH.prod_right_ae] with x hx
          calc
            (∫ pt : ℝ × ℝ, H (x, pt)
              ∂((volume : Measure ℝ).prod ν)) =
                ∫ p₂ : ℝ, ∫ t : ℝ, H (x, (p₂, t)) ∂ν :=
              integral_prod _ hx
            _ = J x := hswap x hx
    _ = ∫ x₁ : ℝ, ∫ x₂ : ℝ, J (x₁, x₂) := by
          exact integral_prod _ hJ
    _ = ∫ x₁ : ℝ, ∫ x₂ : ℝ,
        A * P * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ v : ℝ, f (modelPoint x₁ x₂ v) ^ 2 := by
          apply integral_congr_ae
          filter_upwards [] with x₁
          apply integral_congr_ae
          filter_upwards [] with x₂
          exact hJvalue x₁ x₂
    _ = A * P * (Real.pi / (α.weight 2 : ℝ)) *
        ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ v : ℝ,
          f (modelPoint x₁ x₂ v) ^ 2 := by
          let C : ℝ := A * P * (Real.pi / (α.weight 2 : ℝ))
          calc
            (∫ x₁ : ℝ, ∫ x₂ : ℝ,
              A * P * (Real.pi / (α.weight 2 : ℝ)) *
                ∫ v : ℝ, f (modelPoint x₁ x₂ v) ^ 2) =
                ∫ x₁ : ℝ, ∫ x₂ : ℝ,
                  C * ∫ v : ℝ, f (modelPoint x₁ x₂ v) ^ 2 := by
                    apply integral_congr_ae
                    filter_upwards [] with x₁
                    apply integral_congr_ae
                    filter_upwards [] with x₂
                    rfl
            _ = ∫ x₁ : ℝ, C * (∫ x₂ : ℝ, ∫ v : ℝ,
                f (modelPoint x₁ x₂ v) ^ 2) := by
                  apply integral_congr_ae
                  filter_upwards [] with x₁
                  rw [integral_const_mul]
            _ = C * ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ v : ℝ,
                f (modelPoint x₁ x₂ v) ^ 2 := by
                  rw [integral_const_mul]
            _ = A * P * (Real.pi / (α.weight 2 : ℝ)) *
                ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ v : ℝ,
                  f (modelPoint x₁ x₂ v) ^ 2 := by
                    rfl
    _ = A * P * (Real.pi / (α.weight 2 : ℝ)) *
        ∫ x : E3, f x ^ 2 := by
          rw [integral_modelPoint_sq_eq f hfsq]
    _ = (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 *
        conePsiPhysicalRealL1 * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ x : E3, f x ^ 2 := by
          rfl

/-- Conditional full form of the blueprint's global second-energy identity
for a real Schwartz input.  The hypotheses are exactly the two unresolved
global integrability discharges: the original joint density and the scalar
post-Tonelli `(x₁,x₂,p₂,t)` density. -/
theorem modelEnergyTwoOn_global_eq_of_real_schwartz
    (α : Anisotropy) (u : E3) (f : SchwartzMap E3 ℝ)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyTwoIntegrand α u f q.1 q.2)
      ((cubeScaleMeasure.restrict (Set.univ ×ˢ Set.Ioi (0 : ℝ))).prod volume))
    (hscalar : Integrable (fun w : ScratchModelEnergyOuter ↦
      (∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
        (modelSecondFiberReduced α f w.1.1 w.1.2 w.2.1 w.2.2 r) ^ 2) *
        (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2)
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod
          (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
            (Set.Ioi (0 : ℝ))))))
    (hpr : ∀ (x₁ x₂ t : ℝ), 0 < t → Integrable (fun z : ℝ × ℝ ↦
      (modelSecondFiberReduced α f x₁ x₂ z.1 t z.2) ^ 2 *
        |conePsiPhysicalReal (z.2 + u 2)|)
      ((volume : Measure ℝ).prod volume)) :
    modelEnergyTwoOn α (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f =
      (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 *
        conePsiPhysicalRealL1 * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ x : E3, f x ^ 2 := by
  calc
    modelEnergyTwoOn α (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f =
      ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ p₂ : ℝ,
        ∫ t : ℝ in Set.Ioi (0 : ℝ),
          (∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
            (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
              modelEnergyDensityReordered α u x₁ x₂ t p₀ p₁ y₁ y₂ r)
          ∂((volume : Measure ℝ).withDensity cubeScaleDensity) :=
      modelEnergyTwoOn_eq_reordered_nested α u f hjoint
    _ = ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ p₂ : ℝ,
        ∫ t : ℝ in Set.Ioi (0 : ℝ),
          ((∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
            (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2) *
            (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2)
          ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
            apply integral_congr_ae
            filter_upwards [] with x₁
            apply integral_congr_ae
            filter_upwards [] with x₂
            apply integral_congr_ae
            filter_upwards [] with p₂
            apply setIntegral_congr_fun measurableSet_Ioi
            intro t ht
            exact modelEnergy_reordered_inner_scalar_reduction
              α u f x₁ x₂ p₂ t ht
    _ = (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 *
        conePsiPhysicalRealL1 * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ x : E3, f x ^ 2 :=
      reordered_scalar_energy_eq_global_L2 α u f hscalar hpr

/-- The post-scalar outer density is integrable whenever the original global
joint energy density is integrable.  Thus the only genuinely new analytic
condition in the terminal square-function calculation is the fixed-fiber
translation integrability. -/
theorem integrable_reordered_scalar_of_joint
    (α : Anisotropy) (u : E3) (f : E3 → ℝ)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyTwoIntegrand α u f q.1 q.2)
      ((cubeScaleMeasure.restrict (Set.univ ×ˢ Set.Ioi (0 : ℝ))).prod volume)) :
    Integrable (fun w : ScratchModelEnergyOuter ↦
      (∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
        (modelSecondFiberReduced α f w.1.1 w.1.2 w.2.1 w.2.2 r) ^ 2) *
        (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2)
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod
          (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
            (Set.Ioi (0 : ℝ))))) := by
  let ν : Measure ℝ :=
    ((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
      (Set.Ioi (0 : ℝ))
  let G : (E3 × ℝ) × ModelE5 → ℝ := fun q ↦
    modelEnergyTwoIntegrand α u f q.1 q.2
  let μouter : Measure ScratchModelEnergyOuter :=
    ((volume : Measure ℝ).prod volume).prod ((volume : Measure ℝ).prod ν)
  let μinner : Measure ScratchModelEnergyInner :=
    ((volume : Measure ℝ).prod volume).prod
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))
  have hjoint' : Integrable G (((volume : Measure E3).prod ν).prod volume) := by
    simpa only [G, ν, cubeScaleMeasure_restrict_global_eq] using hjoint
  have htrans : Integrable (fun w : ScratchModelEnergyOuter × ScratchModelEnergyInner ↦
      G (modelEnergyCoordinateReorder.symm w)) (μouter.prod μinner) := by
    have hmp := modelEnergyCoordinateReorder_measurePreserving_scale ν
    exact (MeasurePreserving.symm modelEnergyCoordinateReorder hmp).integrable_comp_of_integrable
      hjoint'
  let K : ScratchModelEnergyOuter → ℝ := fun w ↦
    ∫ v : ScratchModelEnergyInner,
      G (modelEnergyCoordinateReorder.symm (w, v)) ∂μinner
  have hK : Integrable K μouter := htrans.integral_prod_left
  have htν : ∀ᵐ t : ℝ ∂ν, 0 < t := by
    dsimp [ν]
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    exact ht
  have htpt : ∀ᵐ pt : ℝ × ℝ ∂((volume : Measure ℝ).prod ν), 0 < pt.2 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [] with p₂
      exact htν
    · exact measurableSet_Ioi.preimage measurable_snd
  have htouter : ∀ᵐ w : ScratchModelEnergyOuter ∂μouter, 0 < w.2.2 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [] with x
      exact htpt
    · exact measurableSet_Ioi.preimage (measurable_snd.comp measurable_snd)
  let H : ScratchModelEnergyOuter → ℝ := fun w ↦
    (∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
      (modelSecondFiberReduced α f w.1.1 w.1.2 w.2.1 w.2.2 r) ^ 2) *
        (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2
  have hKH : K =ᵐ[μouter] H := by
    filter_upwards [htrans.prod_right_ae, htouter] with w hw ht
    dsimp [K, H]
    calc
      (∫ v : ScratchModelEnergyInner,
        G (modelEnergyCoordinateReorder.symm (w, v)) ∂μinner) =
          ∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
            G (modelEnergyCoordinateReorder.symm
              (w, ((p₀, p₁), (y₁, (y₂, r))))) := by
              exact integral_ScratchModelEnergyInner_eq_nested _ hw
      _ = ∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
          (modelSecondFiberReduced α f w.1.1 w.1.2 w.2.1 w.2.2 r) ^ 2 *
            modelEnergyDensityReordered α u w.1.1 w.1.2 w.2.2
              p₀ p₁ y₁ y₂ r := by
            apply integral_congr_ae
            filter_upwards [] with p₀
            apply integral_congr_ae
            filter_upwards [] with p₁
            apply integral_congr_ae
            filter_upwards [] with y₁
            apply integral_congr_ae
            filter_upwards [] with y₂
            apply integral_congr_ae
            filter_upwards [] with r
            rcases w with ⟨⟨x₁, x₂⟩, ⟨p₂, t⟩⟩
            exact modelEnergyTwoIntegrand_reorder_symm
              α u f x₁ x₂ p₂ t p₀ p₁ y₁ y₂ r
      _ = (∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
          (modelSecondFiberReduced α f w.1.1 w.1.2 w.2.1 w.2.2 r) ^ 2) *
          (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 := by
            rcases w with ⟨⟨x₁, x₂⟩, ⟨p₂, t⟩⟩
            exact modelEnergy_reordered_inner_scalar_reduction
              α u f x₁ x₂ p₂ t ht
  simpa only [H, ν] using hK.congr hKH
/-- Source-facing conditional global second-energy identity.  All Tonelli
and scalar-mass side conditions are discharged from `hjoint`; only the
fixed-fiber translation integrability remains as an explicit analytic
hypothesis. -/
theorem modelEnergyTwoOn_global_eq_of_joint_and_fixedFiber
    (α : Anisotropy) (u : E3) (f : SchwartzMap E3 ℝ)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyTwoIntegrand α u f q.1 q.2)
      ((cubeScaleMeasure.restrict (Set.univ ×ˢ Set.Ioi (0 : ℝ))).prod volume))
    (hpr : ∀ (x₁ x₂ t : ℝ), 0 < t → Integrable (fun z : ℝ × ℝ ↦
      (modelSecondFiberReduced α f x₁ x₂ z.1 t z.2) ^ 2 *
        |conePsiPhysicalReal (z.2 + u 2)|)
      ((volume : Measure ℝ).prod volume)) :
    modelEnergyTwoOn α (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f =
      (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 *
        conePsiPhysicalRealL1 * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ x : E3, f x ^ 2 := by
  exact modelEnergyTwoOn_global_eq_of_real_schwartz α u f hjoint
    (integrable_reordered_scalar_of_joint α u f hjoint) hpr

/-- The standard integer lattice in the three frequency coordinates. -/
def standardModeLattice : Submodule ℤ E3 :=
  Submodule.span ℤ (Set.range (PiLp.basisFun 2 ℝ (Fin 3)))

local instance : DiscreteTopology standardModeLattice := by
  change DiscreteTopology (Submodule.span ℤ
    (Set.range (PiLp.basisFun 2 ℝ (Fin 3))))
  infer_instance

local instance : IsZLattice ℝ standardModeLattice := by
  change IsZLattice ℝ (Submodule.span ℤ
    (Set.range (PiLp.basisFun 2 ℝ (Fin 3))))
  infer_instance

theorem standardModeLattice_rank :
    Module.finrank ℤ standardModeLattice = 3 := by
  rw [ZLattice.rank ℝ]
  exact finrank_euclideanSpace_fin

theorem summable_standardMode_norm_inv :
    Summable (fun z : standardModeLattice ↦
      if z = 0 then (1 : ℝ) else ‖(z : E3)‖⁻¹ ^ (10 : ℕ)) := by
  have hbase := ZLattice.summable_norm_pow_inv standardModeLattice 10 (by
    rw [standardModeLattice_rank]
    norm_num)
  have hdelta : Summable (fun z : standardModeLattice ↦
      if z = 0 then (1 : ℝ) else 0) := by
    apply summable_of_hasFiniteSupport
    rw [Function.HasFiniteSupport]
    refine (Set.finite_singleton (0 : standardModeLattice)).subset ?_
    intro z hz
    rw [Set.mem_singleton_iff]
    by_contra hzero
    simpa [Function.mem_support, hzero] using hz
  refine (hdelta.add hbase).congr ?_
  intro z
  by_cases hz : z = 0
  · simp [hz]
  · simp [hz]

theorem summable_standardMode_one_add_norm_inv :
    Summable (fun z : standardModeLattice ↦
      (1 + ‖(z : E3)‖)⁻¹ ^ (10 : ℕ)) := by
  apply summable_standardMode_norm_inv.of_nonneg_of_le
  · intro z
    positivity
  · intro z
    by_cases hz : z = 0
    · subst z
      simp
    · rw [if_neg hz]
      have hnorm : 0 < ‖(z : E3)‖ := by
        apply norm_pos_iff.mpr
        intro hzero
        apply hz
        exact Subtype.ext hzero
      have hinv : (1 + ‖(z : E3)‖)⁻¹ ≤ ‖(z : E3)‖⁻¹ := by
        exact (inv_le_inv₀ (by linarith) hnorm).mpr (by linarith)
      exact pow_le_pow_left₀ (by positivity) hinv _

theorem norm_le_coordinate_l1 (x : E3) :
    ‖x‖ ≤ |x 0| + |x 1| + |x 2| := by
  have hdir (i : Fin 3) : ‖Anisotropy.coordinateDirection i‖ = 1 := by
    simpa only [Anisotropy.coordinateDirection] using
      (EuclideanSpace.basisFun (Fin 3) ℝ).norm_eq_one i
  have hdecomp : x =
      x 0 • Anisotropy.coordinateDirection 0 +
        x 1 • Anisotropy.coordinateDirection 1 +
          x 2 • Anisotropy.coordinateDirection 2 := by
    ext i
    fin_cases i <;> simp [coordinateDirection_apply]
  calc
    ‖x‖ = ‖x 0 • Anisotropy.coordinateDirection 0 +
        x 1 • Anisotropy.coordinateDirection 1 +
          x 2 • Anisotropy.coordinateDirection 2‖ := congrArg norm hdecomp
    _ ≤
        ‖x 0 • Anisotropy.coordinateDirection 0‖ +
          ‖x 1 • Anisotropy.coordinateDirection 1‖ +
            ‖x 2 • Anisotropy.coordinateDirection 2‖ := by
      exact norm_add_le_of_le (norm_add_le _ _) (le_refl _)
    _ = |x 0| + |x 1| + |x 2| := by
      simp only [norm_smul, hdir, mul_one, Real.norm_eq_abs]

theorem one_add_norm_le_sourceWeight (x : E3) :
    1 + ‖x‖ ≤ sourceWeight x := by
  unfold sourceWeight
  linarith [norm_le_coordinate_l1 x]

theorem summable_standardMode_sourceWeight_inv :
    Summable (fun z : standardModeLattice ↦
      (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ)) := by
  apply summable_standardMode_one_add_norm_inv.of_nonneg_of_le
  · intro z
    positivity
  · intro z
    have hweight : 1 + ‖(z : E3)‖ ≤ sourceWeight (z : E3) :=
      one_add_norm_le_sourceWeight (z : E3)
    have hposNorm : 0 < 1 + ‖(z : E3)‖ := by positivity
    have hposWeight : 0 < sourceWeight (z : E3) := by
      unfold sourceWeight
      positivity
    have hinv : (sourceWeight (z : E3))⁻¹ ≤ (1 + ‖(z : E3)‖)⁻¹ := by
      exact (inv_le_inv₀ hposWeight hposNorm).mpr hweight
    exact pow_le_pow_left₀ (by positivity) hinv _

theorem sourceStopping_treeLocalSize_product
    (α : Anisotropy) (T : FiniteConvexTree α) (f : ModelRealInput) :
    (∏ j : Fin 4, treeLocalSize T (sourceStoppingExponent j) (f j)) =
      (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
        treeLocalSize T 4 (f 2)) * treeLocalSize T 2 (f 3) := by
  simp [Fin.prod_univ_succ, sourceStoppingExponent]
  ring

/-- A single source stopping tree satisfies the local-model bound in exactly
the weighted form summed by the stopping-forest estimate. -/
theorem stoppingTree_localModel_bound_of_energyBounds
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (f : ModelRealInput) (C₁ C₂ : ℝ)
    (hC₁ : 0 ≤ C₁) (hC₂ : 0 ≤ C₂)
    (n : Fin 4 → ℤ)
    (Q : {Q : AnisoBox α // Q ∈ stoppingRoots α S sourceStoppingExponent f n})
    (hcs : |expandedModelLocalForm α
      (stoppingTree α S sourceStoppingExponent f n
        (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
        Q.1 Q.2).boxes u c f| ^ 2 ≤
      modelEnergyOne α
        (stoppingTree α S sourceStoppingExponent f n
          (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
          Q.1 Q.2).boxes u f *
        modelEnergyTwo α
          (stoppingTree α S sourceStoppingExponent f n
            (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
            Q.1 Q.2).boxes u (f 3))
    (hE₁ : modelEnergyOne α
      (stoppingTree α S sourceStoppingExponent f n
        (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
        Q.1 Q.2).boxes u f ≤
      C₁ * sourceWeight u ^ 50 *
        boxMass α
          (stoppingTree α S sourceStoppingExponent f n
            (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
            Q.1 Q.2).root *
        (treeLocalSize
            (stoppingTree α S sourceStoppingExponent f n
              (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
              Q.1 Q.2)
            4 (f 0) *
          treeLocalSize
            (stoppingTree α S sourceStoppingExponent f n
              (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
              Q.1 Q.2)
            4 (f 1) *
          treeLocalSize
            (stoppingTree α S sourceStoppingExponent f n
              (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
              Q.1 Q.2)
            4 (f 2)) ^ 2)
    (hE₂ : modelEnergyTwo α
      (stoppingTree α S sourceStoppingExponent f n
        (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
        Q.1 Q.2).boxes u (f 3) ≤
      C₂ * sourceWeight u ^ 100 *
        boxMass α
          (stoppingTree α S sourceStoppingExponent f n
            (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
            Q.1 Q.2).root *
        treeLocalSize
          (stoppingTree α S sourceStoppingExponent f n
            (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
            Q.1 Q.2)
          2 (f 3) ^ 2) :
    |expandedModelLocalForm α
        (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f| ≤
      (C₁ * C₂ + 1) * sourceWeight u ^ 75 * boxMass α Q.1 *
        (∏ j : Fin 4,
          treeLocalSize
            (stoppingTree α S sourceStoppingExponent f n
              (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
              Q.1 Q.2)
            (sourceStoppingExponent j) (f j)) := by
  let T := stoppingTree α S sourceStoppingExponent f n
    (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
    Q.1 Q.2
  have hmain := localModelEstimate_of_energyBounds α T u c f C₁ C₂ hC₁ hC₂
    hcs hE₁ hE₂
  calc
    |expandedModelLocalForm α
        (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f| =
        |expandedModelLocalForm α T.boxes u c f| := by
      rw [stoppingTree_boxes]
    _ ≤ (C₁ * C₂ + 1) * sourceWeight u ^ 75 * boxMass α T.root *
        (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
          treeLocalSize T 4 (f 2)) * treeLocalSize T 2 (f 3) := hmain
    _ = (C₁ * C₂ + 1) * sourceWeight u ^ 75 * boxMass α Q.1 *
        (∏ j : Fin 4, treeLocalSize T (sourceStoppingExponent j) (f j)) := by
      rw [stoppingTree_root]
      calc
        (C₁ * C₂ + 1) * sourceWeight u ^ 75 * boxMass α Q.1 *
              (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
                treeLocalSize T 4 (f 2)) * treeLocalSize T 2 (f 3) =
            (C₁ * C₂ + 1) * sourceWeight u ^ 75 * boxMass α Q.1 *
              ((treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
                treeLocalSize T 4 (f 2)) * treeLocalSize T 2 (f 3)) := by ring
        _ = _ := by
          rw [← sourceStopping_treeLocalSize_product α T f]

/-- The finite active stopping forest converts uniform stopping-tree local
form bounds into the four-coordinate envelope sum.  The exact forest form
decomposition is kept as an explicit hypothesis, since it is the point at
which the outer model Fubini package is consumed. -/
theorem activeStoppingForest_form_bound_of_localBounds
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (q σ : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (hpos : ∀ q ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) q)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hfinite : ∀ n,
      volume (sourceStoppingDominantMaximalLevelSet α f q σ n) ≠ ∞)
    (C : ℝ) (hC : 0 ≤ C)
    (hdecomp :
      expandedModelLocalForm α S u c f =
        ∑ n ∈ activeStoppingLevels α S sourceStoppingExponent f hpos,
          ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
            expandedModelLocalForm α
              (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f)
    (hlocal : ∀ (n : Fin 4 → ℤ)
      (Q : {Q : AnisoBox α // Q ∈ stoppingRoots α S sourceStoppingExponent f n}),
      |expandedModelLocalForm α
          (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f| ≤
        C * sourceWeight u ^ 75 * boxMass α Q.1 *
          (∏ j : Fin 4,
            treeLocalSize
              (stoppingTree α S sourceStoppingExponent f n
                (isConvexCollection_stoppingLevel α S hS
                  sourceStoppingExponent f n) Q.1 Q.2)
              (sourceStoppingExponent j) (f j))) :
    |expandedModelLocalForm α S u c f| ≤
      C * sourceWeight u ^ 75 *
        (∑ j : Fin 4,
          ∑ m ∈ (activeStoppingLevels α S sourceStoppingExponent f hpos).filter
              (fun n ↦ sourceStoppingDominantIndex q σ n = j) |>.image
                (fun n ↦ n j),
            sourceStoppingDominantFiberEnvelope q σ j m *
              (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) := by
  let L := activeStoppingLevels α S sourceStoppingExponent f hpos
  let W : ℝ := ∑ n ∈ L,
    ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
      boxMass α Q.1 *
        (∏ j : Fin 4,
          treeLocalSize
            (stoppingTree α S sourceStoppingExponent f n
              (isConvexCollection_stoppingLevel α S hS
                sourceStoppingExponent f n) Q.1 Q.2)
            (sourceStoppingExponent j) (f j))
  let E : ℝ := ∑ j : Fin 4,
    ∑ m ∈ L.filter (fun n ↦ sourceStoppingDominantIndex q σ n = j) |>.image
        (fun n ↦ n j),
      sourceStoppingDominantFiberEnvelope q σ j m *
        (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal
  have hW : W ≤ E := by
    dsimp only [W, E, L]
    exact sourceStoppingForestWeightedSum_le_coordinateEnvelopeSums
      α S hS f q σ hq hpos hcont hbound hfinite
  have hU : 0 ≤ sourceWeight u := sourceWeight_nonneg u
  have hfac : 0 ≤ C * sourceWeight u ^ 75 := by positivity
  have hsum :
      (∑ n ∈ L,
        ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
          |expandedModelLocalForm α
            (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f|) ≤
        C * sourceWeight u ^ 75 * W := by
    calc
      (∑ n ∈ L,
        ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
          |expandedModelLocalForm α
            (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f|) ≤
          ∑ n ∈ L,
            ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
              C * sourceWeight u ^ 75 * boxMass α Q.1 *
                (∏ j : Fin 4,
                  treeLocalSize
                    (stoppingTree α S sourceStoppingExponent f n
                      (isConvexCollection_stoppingLevel α S hS
                        sourceStoppingExponent f n) Q.1 Q.2)
                    (sourceStoppingExponent j) (f j)) := by
        apply Finset.sum_le_sum
        intro n hn
        apply Finset.sum_le_sum
        intro Q hQ
        exact hlocal n Q
      _ = C * sourceWeight u ^ 75 * W := by
        dsimp only [W]
        calc
          (∑ n ∈ L,
            ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
              C * sourceWeight u ^ 75 * boxMass α Q.1 *
                (∏ j : Fin 4,
                  treeLocalSize
                    (stoppingTree α S sourceStoppingExponent f n
                      (isConvexCollection_stoppingLevel α S hS
                        sourceStoppingExponent f n) Q.1 Q.2)
                    (sourceStoppingExponent j) (f j))) =
              ∑ n ∈ L,
                (C * sourceWeight u ^ 75) *
                  (∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
                    boxMass α Q.1 *
                      (∏ j : Fin 4,
                        treeLocalSize
                          (stoppingTree α S sourceStoppingExponent f n
                            (isConvexCollection_stoppingLevel α S hS
                              sourceStoppingExponent f n) Q.1 Q.2)
                          (sourceStoppingExponent j) (f j))) := by
                apply Finset.sum_congr rfl
                intro n hn
                rw [Finset.mul_sum]
                apply Finset.sum_congr rfl
                intro Q hQ
                ring
          _ = C * sourceWeight u ^ 75 *
              (∑ n ∈ L,
                ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
                  boxMass α Q.1 *
                    (∏ j : Fin 4,
                      treeLocalSize
                        (stoppingTree α S sourceStoppingExponent f n
                          (isConvexCollection_stoppingLevel α S hS
                            sourceStoppingExponent f n) Q.1 Q.2)
                        (sourceStoppingExponent j) (f j))) := by
            rw [Finset.mul_sum]
  calc
    |expandedModelLocalForm α S u c f| =
        |∑ n ∈ L,
          ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
            expandedModelLocalForm α
              (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f| := by
      rw [hdecomp]
    _ ≤ ∑ n ∈ L,
        |∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
          expandedModelLocalForm α
            (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f| := by
      exact Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ n ∈ L,
        ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
          |expandedModelLocalForm α
            (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f| := by
      apply Finset.sum_le_sum
      intro n hn
      exact Finset.abs_sum_le_sum_abs _ _
    _ ≤ C * sourceWeight u ^ 75 * W := hsum
    _ ≤ C * sourceWeight u ^ 75 * E :=
      mul_le_mul_of_nonneg_left hW hfac
    _ = C * sourceWeight u ^ 75 *
        (∑ j : Fin 4,
          ∑ m ∈ (activeStoppingLevels α S sourceStoppingExponent f hpos).filter
              (fun n ↦ sourceStoppingDominantIndex q σ n = j) |>.image
                (fun n ↦ n j),
            sourceStoppingDominantFiberEnvelope q σ j m *
              (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) := by
      rfl

/-- The literal stopping tree attached to a source active root.  Naming it
makes the energy hypotheses in the terminal forest wrapper compact. -/
noncomputable def sourceStoppingTree
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (f : ModelRealInput) (n : Fin 4 → ℤ)
    (Q : {Q : AnisoBox α // Q ∈ stoppingRoots α S sourceStoppingExponent f n}) :
    FiniteConvexTree α :=
  stoppingTree α S sourceStoppingExponent f n
    (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
    Q.1 Q.2

/-- The local Cauchy--Schwarz input on every tree of the source stopping
forest. -/
def sourceStoppingTreeCS
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (f : ModelRealInput) : Prop :=
  ∀ (n : Fin 4 → ℤ)
    (Q : {Q : AnisoBox α // Q ∈ stoppingRoots α S sourceStoppingExponent f n}),
    |expandedModelLocalForm α (sourceStoppingTree α S hS f n Q).boxes u c f| ^ 2 ≤
      modelEnergyOne α (sourceStoppingTree α S hS f n Q).boxes u f *
        modelEnergyTwo α (sourceStoppingTree α S hS f n Q).boxes u (f 3)

/-- The first tree-energy conclusion, uniform over source stopping roots. -/
def sourceStoppingTreeEnergyOneBound
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (f : ModelRealInput) (C₁ : ℝ) : Prop :=
  ∀ (n : Fin 4 → ℤ)
    (Q : {Q : AnisoBox α // Q ∈ stoppingRoots α S sourceStoppingExponent f n}),
    modelEnergyOne α (sourceStoppingTree α S hS f n Q).boxes u f ≤
      C₁ * sourceWeight u ^ 50 *
        boxMass α (sourceStoppingTree α S hS f n Q).root *
        (treeLocalSize (sourceStoppingTree α S hS f n Q) 4 (f 0) *
          treeLocalSize (sourceStoppingTree α S hS f n Q) 4 (f 1) *
          treeLocalSize (sourceStoppingTree α S hS f n Q) 4 (f 2)) ^ 2

/-- The second tree-energy conclusion, uniform over source stopping roots. -/
def sourceStoppingTreeEnergyTwoBound
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (f : ModelRealInput) (C₂ : ℝ) : Prop :=
  ∀ (n : Fin 4 → ℤ)
    (Q : {Q : AnisoBox α // Q ∈ stoppingRoots α S sourceStoppingExponent f n}),
    modelEnergyTwo α (sourceStoppingTree α S hS f n Q).boxes u (f 3) ≤
      C₂ * sourceWeight u ^ 100 *
        boxMass α (sourceStoppingTree α S hS f n Q).root *
        treeLocalSize (sourceStoppingTree α S hS f n Q) 2 (f 3) ^ 2

/-- The exact four integrability obligations which instantiate the two
bounded-continuous tree-energy estimates on every source stopping tree. -/
def sourceStoppingTreeEnergyIntegrability
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (f : ModelRealInput) : Prop :=
  ∀ (n : Fin 4 → ℤ)
    (Q : {Q : AnisoBox α // Q ∈ stoppingRoots α S sourceStoppingExponent f n}),
    Integrable (modelFirstSuperpositionJoint α u f)
      ((cubeScaleMeasure.restrict
        (collectionRegion α (sourceStoppingTree α S hS f n Q).boxes)).prod
        ((volume : Measure ModelE5).prod
          ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) ) ∧
    IntegrableOn (fun lam : ℝ ↦
      localCubeForm α (sourceStoppingTree α S hS f n Q).boxes 2 lam 0
        (modelFirstCubeTuple f) * lam ^ (-47 : ℝ)) (Set.Ici (1 : ℝ)) ∧
    Integrable (modelSecondSuperpositionJoint α (f 3))
      ((cubeScaleMeasure.restrict
        (collectionRegion α (sourceStoppingTree α S hS f n Q).boxes)).prod
        ((volume : Measure ModelE5).prod
          ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) ) ∧
    Integrable (fun z : ℝ × ℝ ↦
      localCubeForm α (sourceStoppingTree α S hS f n Q).boxes 2 z.1 z.2
        (edgeCubeTuple (f 3)) * translationWeight z.2 ^ (-50 : ℝ) *
          z.1 ^ (-47 : ℝ))
      (((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))).prod volume)

/-- The checked tree-energy package specializes uniformly to every root of
the active source stopping forest once its four explicit integrability
conditions are provided. -/
theorem sourceStoppingTree_energyBounds_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (f : ModelRealInput)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hint : sourceStoppingTreeEnergyIntegrability α S hS u f) :
    ∃ C₁ C₂ : ℝ, 0 ≤ C₁ ∧ 0 ≤ C₂ ∧
      sourceStoppingTreeEnergyOneBound α S hS u f C₁ ∧
      sourceStoppingTreeEnergyTwoBound α S hS u f C₂ := by
  rcases modelEnergyOne_tree_bound_of_boundedContinuous α with ⟨C₁, hC₁, hE₁⟩
  rcases modelEnergyTwo_tree_bound_of_boundedContinuous α with ⟨C₂, hC₂, hE₂⟩
  refine ⟨C₁, C₂, hC₁, hC₂, ?_, ?_⟩
  · intro n Q
    rcases hint n Q with ⟨hfirst, hscale, hsecond, hjoint⟩
    exact hE₁ (sourceStoppingTree α S hS f n Q) u f false
      hcont hbound hfirst hscale
  · intro n Q
    rcases hint n Q with ⟨hfirst, hscale, hsecond, hjoint⟩
    exact hE₂ (sourceStoppingTree α S hS f n Q) u (f 3) false
      (hcont 3) (hbound 3) hsecond hjoint

/-- The Section 5 finite active stopping-forest form estimate.  The only
remaining analytic input is the exact outer form decomposition and the three
treewise hypotheses; the scalar stopping sum is discharged by the checked
coordinate-envelope theorem. -/
theorem activeStoppingForest_form_bound_of_energyBounds
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (q σ : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (hpos : ∀ q ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) q)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hfinite : ∀ n,
      volume (sourceStoppingDominantMaximalLevelSet α f q σ n) ≠ ∞)
    (C₁ C₂ : ℝ) (hC₁ : 0 ≤ C₁) (hC₂ : 0 ≤ C₂)
    (hdecomp :
      expandedModelLocalForm α S u c f =
        ∑ n ∈ activeStoppingLevels α S sourceStoppingExponent f hpos,
          ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
            expandedModelLocalForm α
              (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f)
    (hcs : sourceStoppingTreeCS α S hS u c f)
    (hE₁ : sourceStoppingTreeEnergyOneBound α S hS u f C₁)
    (hE₂ : sourceStoppingTreeEnergyTwoBound α S hS u f C₂) :
    |expandedModelLocalForm α S u c f| ≤
      (C₁ * C₂ + 1) * sourceWeight u ^ 75 *
        (∑ j : Fin 4,
          ∑ m ∈ (activeStoppingLevels α S sourceStoppingExponent f hpos).filter
              (fun n ↦ sourceStoppingDominantIndex q σ n = j) |>.image
                (fun n ↦ n j),
            sourceStoppingDominantFiberEnvelope q σ j m *
              (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) := by
  apply activeStoppingForest_form_bound_of_localBounds
    α S hS u c f q σ hq hpos hcont hbound hfinite (C₁ * C₂ + 1)
  · exact add_nonneg (mul_nonneg hC₁ hC₂) zero_le_one
  · exact hdecomp
  intro n Q
  apply stoppingTree_localModel_bound_of_energyBounds
    α S hS u c f C₁ C₂ hC₁ hC₂ n Q
  · simpa only [sourceStoppingTree] using hcs n Q
  · simpa only [sourceStoppingTree] using hE₁ n Q
  · simpa only [sourceStoppingTree] using hE₂ n Q

/-- The exact active-forest form decomposition obtained from a single outer
integrability hypothesis.  This discharges the decomposition premise of the
terminal forest estimate without any rearrangement of conditionally
integrable terms. -/
theorem expandedModelLocalForm_activeStoppingForest_eq_sum_of_integrable
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput)
    (hpos : ∀ q ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) q)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict (collectionRegion α S))) :
    expandedModelLocalForm α S u c f =
      ∑ n ∈ activeStoppingLevels α S sourceStoppingExponent f hpos,
        ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
          expandedModelLocalForm α
            (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f := by
  classical
  let I := activeStoppingForestRoots α S sourceStoppingExponent f hpos
  let A : (Sigma fun _ : Fin 4 → ℤ ↦ AnisoBox α) → BoxCollection α :=
    fun z ↦ stoppingTreeBoxes α S sourceStoppingExponent f z.1 z.2
  have hpartition : S = I.biUnion A := by
    dsimp only [I, A]
    exact boxCollection_eq_biUnion_activeStoppingForestTreeBoxes
      α S sourceStoppingExponent f hpos
  have hint' : Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict (collectionRegion α (I.biUnion A))) := by
    rw [← hpartition]
    exact hint
  have hsum := expandedModelLocalForm_biUnion_eq_sum_of_integrable
    α I A u c f
    (by
      dsimp only [I, A]
      exact pairwiseDisjoint_activeStoppingForestTreeBoxes
        α S sourceStoppingExponent f hpos)
    hint'
  calc
    expandedModelLocalForm α S u c f =
        expandedModelLocalForm α (I.biUnion A) u c f := by rw [← hpartition]
    _ = ∑ z ∈ I, expandedModelLocalForm α (A z) u c f := hsum
    _ = ∑ n ∈ activeStoppingLevels α S sourceStoppingExponent f hpos,
        ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
          expandedModelLocalForm α
            (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f := by
      simp only [I, A, activeStoppingForestRoots, Finset.sum_sigma]
      apply Finset.sum_congr rfl
      intro n hn
      symm
      exact Finset.sum_attach (stoppingRoots α S sourceStoppingExponent f n)
        (fun Q ↦ expandedModelLocalForm α
          (stoppingTreeBoxes α S sourceStoppingExponent f n Q) u c f)

/-- A ready-to-use finite active stopping-forest bound.  It combines the
outer-integrability decomposition, treewise local-model/energy bounds, and
the source coordinate-envelope stopping estimate. -/
theorem activeStoppingForest_form_bound_of_energyBounds_of_integrable
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (q σ : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (hpos : ∀ q ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) q)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hfinite : ∀ n,
      volume (sourceStoppingDominantMaximalLevelSet α f q σ n) ≠ ∞)
    (C₁ C₂ : ℝ) (hC₁ : 0 ≤ C₁) (hC₂ : 0 ≤ C₂)
    (hcs : sourceStoppingTreeCS α S hS u c f)
    (hE₁ : sourceStoppingTreeEnergyOneBound α S hS u f C₁)
    (hE₂ : sourceStoppingTreeEnergyTwoBound α S hS u f C₂)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict (collectionRegion α S))) :
    |expandedModelLocalForm α S u c f| ≤
      (C₁ * C₂ + 1) * sourceWeight u ^ 75 *
        (∑ j : Fin 4,
          ∑ m ∈ (activeStoppingLevels α S sourceStoppingExponent f hpos).filter
              (fun n ↦ sourceStoppingDominantIndex q σ n = j) |>.image
                (fun n ↦ n j),
            sourceStoppingDominantFiberEnvelope q σ j m *
              (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) := by
  apply activeStoppingForest_form_bound_of_energyBounds
    α S hS u c f q σ hq hpos hcont hbound hfinite C₁ C₂ hC₁ hC₂
  · exact expandedModelLocalForm_activeStoppingForest_eq_sum_of_integrable
      α S u c f hpos hint
  · exact hcs
  · exact hE₁
  · exact hE₂

/-- The fully assembled bounded-continuous Section 5 active-forest estimate.
Its sole remaining analytic assumptions are the explicit treewise energy
integrability package and the outer form integrability needed for finite
Fubini additivity. -/
theorem activeStoppingForest_form_bound_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (q σ : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (hpos : ∀ q ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) q)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hfinite : ∀ n,
      volume (sourceStoppingDominantMaximalLevelSet α f q σ n) ≠ ∞)
    (hcs : sourceStoppingTreeCS α S hS u c f)
    (henergy : sourceStoppingTreeEnergyIntegrability α S hS u f)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict (collectionRegion α S))) :
    ∃ C : ℝ, 0 ≤ C ∧
      |expandedModelLocalForm α S u c f| ≤
        C * sourceWeight u ^ 75 *
          (∑ j : Fin 4,
            ∑ m ∈ (activeStoppingLevels α S sourceStoppingExponent f hpos).filter
                (fun n ↦ sourceStoppingDominantIndex q σ n = j) |>.image
                  (fun n ↦ n j),
              sourceStoppingDominantFiberEnvelope q σ j m *
                (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) := by
  rcases sourceStoppingTree_energyBounds_of_boundedContinuous
    α S hS u f hcont hbound henergy with ⟨C₁, C₂, hC₁, hC₂, hE₁, hE₂⟩
  refine ⟨C₁ * C₂ + 1, add_nonneg (mul_nonneg hC₁ hC₂) zero_le_one, ?_⟩
  exact activeStoppingForest_form_bound_of_energyBounds_of_integrable
    α S hS u c f q σ hq hpos hcont hbound hfinite C₁ C₂ hC₁ hC₂
    hcs hE₁ hE₂ hint

/-! ## Section 7: finite dyadic truncations and center--scale exhaustion

This scratch block follows `lem:model_convergence` in the Task 3 blueprint.
The root boxes are the eight level-`N` boxes indexed by `{-1,0}^3`; their
successive literal child generations supply all levels from `N` down to
`-N`.  The remaining declarations turn any increasing exhaustion by these
finite regions into convergence of the expanded real model form.
-/

/-- The eight level-`N` roots of the spatial truncation in the source. -/
def truncationRoots (α : Anisotropy) (N : ℕ) : BoxCollection α :=
  Finset.univ.image fun v : Fin 3 → Bool ↦
    ⟨(N : ℤ), fun i ↦ if v i then 0 else -1⟩

/-- The spatial box `B_N`, initially presented as the union of its eight
literal dyadic roots. -/
noncomputable def truncationSpatialSet (α : Anisotropy) (N : ℕ) : Set E3 :=
  ⋃ q ∈ truncationRoots α N, boxSet α q

/-- Apply one literal dyadic refinement simultaneously to a finite family. -/
def refineCollection (α : Anisotropy) (S : BoxCollection α) :
    BoxCollection α :=
  S.biUnion (boxChildren α)

/-- The `d`-th level in the finite truncation rooted at level `N`. -/
def truncationLevel (α : Anisotropy) (N d : ℕ) : BoxCollection α :=
  (refineCollection α)^[d] (truncationRoots α N)

/-- The literal finite collection `Q_N`: roots together with all descendants
through level `-N`. -/
def truncationCollection (α : Anisotropy) (N : ℕ) : BoxCollection α :=
  (Finset.range (2 * N + 1)).biUnion (truncationLevel α N)

theorem mem_truncationRoots_iff (α : Anisotropy) (N : ℕ)
    (q : AnisoBox α) :
    q ∈ truncationRoots α N ↔
      q.level = N ∧ ∃ v : Fin 3 → Bool,
        q.index = fun i ↦ if v i then 0 else -1 := by
  constructor
  · intro hq
    rcases Finset.mem_image.mp hq with ⟨v, -, rfl⟩
    exact ⟨rfl, ⟨v, rfl⟩⟩
  · rintro ⟨hlevel, v, hindex⟩
    have hq : q = ⟨(N : ℤ), fun i ↦ if v i then 0 else -1⟩ := by
      cases q
      simp only [AnisoBox.mk.injEq] at hlevel hindex ⊢
      exact ⟨by simpa using hlevel, hindex⟩
    subst q
    exact Finset.mem_image.mpr ⟨v, Finset.mem_univ _, rfl⟩

theorem refineCollection_mem_iff (α : Anisotropy)
    (S : BoxCollection α) (q : AnisoBox α) :
    q ∈ refineCollection α S ↔
      ∃ r ∈ S, q ∈ boxChildren α r := by
  simp only [refineCollection, Finset.mem_biUnion]

theorem mem_truncationLevel_zero (α : Anisotropy) (N : ℕ)
    (q : AnisoBox α) :
    q ∈ truncationLevel α N 0 ↔ q ∈ truncationRoots α N := by
  simp [truncationLevel]

theorem truncationLevel_succ (α : Anisotropy) (N d : ℕ) :
    truncationLevel α N (d + 1) =
      refineCollection α (truncationLevel α N d) := by
  simp only [truncationLevel, Function.iterate_succ_apply']

theorem truncationLevel_level (α : Anisotropy) (N d : ℕ)
    {q : AnisoBox α} (hq : q ∈ truncationLevel α N d) :
    q.level = (N : ℤ) - d := by
  induction d generalizing q with
  | zero =>
      rw [mem_truncationLevel_zero] at hq
      exact (mem_truncationRoots_iff α N q).mp hq |>.1
  | succ d ih =>
      rw [truncationLevel_succ, refineCollection_mem_iff] at hq
      rcases hq with ⟨r, hr, hqchild⟩
      rw [boxChildren_level α hqchild, ih hr]
      push_cast
      ring

theorem subset_truncationSpatialSet_of_mem_truncationLevel
    (α : Anisotropy) (N d : ℕ) {q : AnisoBox α}
    (hq : q ∈ truncationLevel α N d) :
    boxSet α q ⊆ truncationSpatialSet α N := by
  induction d generalizing q with
  | zero =>
      rw [mem_truncationLevel_zero] at hq
      intro x hx
      exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hq, hx⟩⟩
  | succ d ih =>
      rw [truncationLevel_succ, refineCollection_mem_iff] at hq
      rcases hq with ⟨r, hr, hqchild⟩
      rcases Finset.mem_image.mp hqchild with ⟨v, -, rfl⟩
      have hparent : boxSet α (boxChild α r v) ⊆ boxSet α r := by
        simpa only [boxParent_child] using boxSet_subset_parent α (boxChild α r v)
      exact hparent.trans (ih hr)

theorem truncationSpatialSet_subset_iUnion_level
    (α : Anisotropy) (N d : ℕ) :
    truncationSpatialSet α N ⊆
      ⋃ q ∈ truncationLevel α N d, boxSet α q := by
  induction d with
  | zero =>
      exact Set.Subset.rfl
  | succ d ih =>
      intro x hx
      rcases Set.mem_iUnion.1 (ih hx) with ⟨q, hx⟩
      rcases Set.mem_iUnion.1 hx with ⟨hq, hxq⟩
      rcases Set.mem_iUnion.1 (boxSet_subset_children_union α q hxq) with ⟨r, hxr⟩
      rcases Set.mem_iUnion.1 hxr with ⟨hr, hxr⟩
      refine Set.mem_iUnion.2 ⟨r, Set.mem_iUnion.2 ⟨?_, hxr⟩⟩
      rw [truncationLevel_succ, refineCollection_mem_iff]
      exact ⟨q, hq, hr⟩

theorem iUnion_truncationLevel_eq_spatialSet
    (α : Anisotropy) (N d : ℕ) :
    (⋃ q ∈ truncationLevel α N d, boxSet α q) =
      truncationSpatialSet α N := by
  apply Set.Subset.antisymm
  · rintro x hx
    rcases Set.mem_iUnion.1 hx with ⟨q, hx⟩
    rcases Set.mem_iUnion.1 hx with ⟨hq, hx⟩
    exact subset_truncationSpatialSet_of_mem_truncationLevel α N d hq hx
  · exact truncationSpatialSet_subset_iUnion_level α N d

theorem exists_root_of_mem_truncationLevel
    (α : Anisotropy) (N d : ℕ) {q : AnisoBox α}
    (hq : q ∈ truncationLevel α N d) :
    ∃ R ∈ truncationRoots α N, boxSet α q ⊆ boxSet α R := by
  induction d generalizing q with
  | zero =>
      rw [mem_truncationLevel_zero] at hq
      exact ⟨q, hq, Set.Subset.rfl⟩
  | succ d ih =>
      rw [truncationLevel_succ, refineCollection_mem_iff] at hq
      rcases hq with ⟨r, hr, hqchild⟩
      rcases ih hr with ⟨R, hR, hrR⟩
      rcases Finset.mem_image.mp hqchild with ⟨v, -, rfl⟩
      refine ⟨R, hR, ?_⟩
      have hparent : boxSet α (boxChild α r v) ⊆ boxSet α r := by
        simpa only [boxParent_child] using boxSet_subset_parent α (boxChild α r v)
      exact hparent.trans hrR

theorem mem_truncationLevel_of_root_subset
    (α : Anisotropy) (N d : ℕ) (q R : AnisoBox α)
    (hR : R ∈ truncationRoots α N)
    (hlevel : q.level = (N : ℤ) - d)
    (hsub : boxSet α q ⊆ boxSet α R) :
    q ∈ truncationLevel α N d := by
  induction d generalizing q with
  | zero =>
      rw [mem_truncationLevel_zero]
      have hRlevel : R.level = N :=
        (mem_truncationRoots_iff α N R).mp hR |>.1
      have hancestor := boxAncestor_eq_of_boxSet_subset α hsub
      have hdiff : (R.level - q.level).toNat = 0 := by
        rw [hRlevel, hlevel]
        norm_num
      have hqR : q = R := by
        simpa [boxAncestor, hdiff] using hancestor
      simpa only [hqR] using hR
  | succ d ih =>
      rw [truncationLevel_succ, refineCollection_mem_iff]
      have hRlevel : R.level = N :=
        (mem_truncationRoots_iff α N R).mp hR |>.1
      have hparentlevel : (boxParent α q).level = (N : ℤ) - d := by
        simp only [boxParent]
        rw [hlevel]
        push_cast
        ring
      have hinter : (boxSet α (boxParent α q) ∩ boxSet α R).Nonempty := by
        obtain ⟨x, hx⟩ := boxSet_nonempty α q
        exact ⟨x, boxSet_subset_parent α q hx, hsub hx⟩
      have hparentR : boxSet α (boxParent α q) ⊆ boxSet α R := by
        apply boxSet_nested_of_inter_nonempty α
        rw [hparentlevel, hRlevel]
        omega
        exact hinter
      have hparentmem : boxParent α q ∈ truncationLevel α N d :=
        ih (boxParent α q) hparentlevel hparentR
      have hchild : q ∈ boxChildren α (boxParent α q) := by
        rcases (boxParent_eq_iff_exists_boxChild α (boxParent α q) q).mp rfl with
          ⟨v, hv⟩
        exact Finset.mem_image.mpr ⟨v, Finset.mem_univ _, hv⟩
      exact ⟨boxParent α q, hparentmem, hchild⟩

theorem mem_truncationLevel_iff
    (α : Anisotropy) (N d : ℕ) (q : AnisoBox α) :
    q ∈ truncationLevel α N d ↔
      q.level = (N : ℤ) - d ∧
        ∃ R ∈ truncationRoots α N, boxSet α q ⊆ boxSet α R := by
  constructor
  · intro hq
    exact ⟨truncationLevel_level α N d hq,
      exists_root_of_mem_truncationLevel α N d hq⟩
  · rintro ⟨hlevel, R, hR, hsub⟩
    exact mem_truncationLevel_of_root_subset α N d q R hR hlevel hsub

theorem mem_truncationCollection_iff (α : Anisotropy) (N : ℕ)
    (q : AnisoBox α) :
    q ∈ truncationCollection α N ↔
      ∃ d ∈ Finset.range (2 * N + 1), q ∈ truncationLevel α N d := by
  simp only [truncationCollection, Finset.mem_biUnion]

theorem truncationCollection_box_subset (α : Anisotropy) (N : ℕ)
    {q : AnisoBox α} (hq : q ∈ truncationCollection α N) :
    boxSet α q ⊆ truncationSpatialSet α N := by
  rcases (mem_truncationCollection_iff α N q).mp hq with ⟨d, -, hqd⟩
  exact subset_truncationSpatialSet_of_mem_truncationLevel α N d hqd

theorem truncationCollection_level_bounds
    (α : Anisotropy) (N : ℕ) {q : AnisoBox α}
    (hq : q ∈ truncationCollection α N) :
    -(N : ℤ) ≤ q.level ∧ q.level ≤ N := by
  rcases (mem_truncationCollection_iff α N q).mp hq with ⟨d, hd, hqd⟩
  have hdlt : d < 2 * N + 1 := Finset.mem_range.mp hd
  have hlevel := truncationLevel_level α N d hqd
  constructor <;> rw [hlevel] <;> omega

theorem exists_root_of_mem_truncationCollection
    (α : Anisotropy) (N : ℕ) {q : AnisoBox α}
    (hq : q ∈ truncationCollection α N) :
    ∃ R ∈ truncationRoots α N, boxSet α q ⊆ boxSet α R := by
  rcases (mem_truncationCollection_iff α N q).mp hq with ⟨d, -, hqd⟩
  exact exists_root_of_mem_truncationLevel α N d hqd

theorem parent_mem_truncationRoots
    (α : Anisotropy) (N : ℕ) {R : AnisoBox α}
    (hR : R ∈ truncationRoots α N) :
    boxParent α R ∈ truncationRoots α (N + 1) := by
  rcases (mem_truncationRoots_iff α N R).mp hR with ⟨hlevel, v, hindex⟩
  apply (mem_truncationRoots_iff α (N + 1) (boxParent α R)).mpr
  refine ⟨?_, v, ?_⟩
  · simp only [boxParent]
    rw [hlevel]
    push_cast
    ring
  · funext i
    simp only [boxParent]
    rw [hindex]
    by_cases hv : v i
    · simp [hv]
    · have hpos : (0 : ℤ) < anisoRadix α i := by
        exact_mod_cast anisoRadix_pos α i
      have hdiv : (-1 : ℤ) / (anisoRadix α i : ℤ) = -1 := by
        change Int.ediv (-1) (anisoRadix α i : ℤ) = -1
        rw [Int.ediv_of_neg_of_pos (by norm_num) hpos]
        simp
      simpa [hv] using hdiv

/-- The source truncation `Q_N` is convex in the literal grid order. -/
theorem isConvexCollection_truncationCollection
    (α : Anisotropy) (N : ℕ) :
    IsConvexCollection α (truncationCollection α N) := by
  intro q r w hq hr hqw hwr
  have hqlevel := truncationCollection_level_bounds α N hq
  have hrlevel := truncationCollection_level_bounds α N hr
  have hwlower : -(N : ℤ) ≤ w.level := by
    have h : q.level ≤ w.level := level_le_of_boxSet_subset α hqw
    exact hqlevel.1.trans h
  have hwupper : w.level ≤ N := by
    have h : w.level ≤ r.level := level_le_of_boxSet_subset α hwr
    exact h.trans hrlevel.2
  rcases exists_root_of_mem_truncationCollection α N hr with ⟨R, hR, hrR⟩
  let d : ℕ := ((N : ℤ) - w.level).toNat
  have hdZ : (d : ℤ) = (N : ℤ) - w.level := by
    dsimp [d]
    exact Int.toNat_of_nonneg (sub_nonneg.mpr hwupper)
  have hdmem : d ∈ Finset.range (2 * N + 1) := by
    apply Finset.mem_range.mpr
    rw [show d = ((d : ℤ).toNat) by simp, hdZ]
    omega
  have hwlevel : w.level = (N : ℤ) - d := by
    rw [show (d : ℤ) = (N : ℤ) - w.level by exact hdZ]
    ring
  have hwR : boxSet α w ⊆ boxSet α R := hwr.trans hrR
  have hwd : w ∈ truncationLevel α N d :=
    mem_truncationLevel_of_root_subset α N d w R hR hwlevel hwR
  exact (mem_truncationCollection_iff α N w).mpr ⟨d, hdmem, hwd⟩

theorem truncationCollection_subset_succ
    (α : Anisotropy) (N : ℕ) :
    truncationCollection α N ⊆ truncationCollection α (N + 1) := by
  intro q hq
  rcases exists_root_of_mem_truncationCollection α N hq with ⟨R, hR, hqR⟩
  have hP : boxParent α R ∈ truncationRoots α (N + 1) :=
    parent_mem_truncationRoots α N hR
  have hqlevel := truncationCollection_level_bounds α N hq
  let d : ℕ := ((N + 1 : ℕ) - q.level).toNat
  have hdZ : (d : ℤ) = (N + 1 : ℕ) - q.level := by
    dsimp [d]
    exact Int.toNat_of_nonneg (by omega)
  have hdmem : d ∈ Finset.range (2 * (N + 1) + 1) := by
    apply Finset.mem_range.mpr
    rw [show d = ((d : ℤ).toNat) by simp, hdZ]
    omega
  have hqlevel' : q.level = (N + 1 : ℕ) - d := by
    rw [show (d : ℤ) = (N + 1 : ℕ) - q.level by exact hdZ]
    ring
  have hqP : boxSet α q ⊆ boxSet α (boxParent α R) :=
    hqR.trans (boxSet_subset_parent α R)
  have hqd : q ∈ truncationLevel α (N + 1) d :=
    mem_truncationLevel_of_root_subset α (N + 1) d q (boxParent α R)
      hP hqlevel' hqP
  exact (mem_truncationCollection_iff α (N + 1) q).mpr ⟨d, hdmem, hqd⟩

theorem monotone_truncationCollection (α : Anisotropy) :
    Monotone (truncationCollection α) :=
  monotone_nat_of_le_succ (truncationCollection_subset_succ α)

theorem collectionRegion_mono_of_truncationCollection
    (α : Anisotropy) :
    Monotone fun N ↦ collectionRegion α (truncationCollection α N) := by
  intro N M hNM z hz
  change z ∈ collectionRegion α (truncationCollection α N) at hz
  change z ∈ collectionRegion α (truncationCollection α M)
  rw [collectionRegion] at hz
  rw [collectionRegion]
  rcases Set.mem_iUnion.1 hz with ⟨q, hz⟩
  rcases Set.mem_iUnion.1 hz with ⟨hq, hz⟩
  exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2
    ⟨monotone_truncationCollection α hNM hq, hz⟩⟩

/-- The scale interval carried by the source truncation `Q_N`. -/
noncomputable def truncationScaleSet (N : ℕ) : Set ℝ :=
  Set.Ioc ((2 : ℝ) ^ (-(N : ℤ) - 1)) ((2 : ℝ) ^ (N : ℤ))

/-- The scale band assigned to the `d`-th descendant generation. -/
noncomputable def truncationBand (N d : ℕ) : Set ℝ :=
  Set.Ioc ((2 : ℝ) ^ ((N : ℤ) - d - 1)) ((2 : ℝ) ^ ((N : ℤ) - d))

theorem iUnion_truncationBand_range (N m : ℕ) :
    (⋃ d ∈ Finset.range (m + 1), truncationBand N d) =
      Set.Ioc ((2 : ℝ) ^ ((N : ℤ) - m - 1)) ((2 : ℝ) ^ (N : ℤ)) := by
  induction m with
  | zero =>
      simp [truncationBand]
  | succ m ih =>
      have hjoin : truncationBand N (m + 1) =
          Set.Ioc ((2 : ℝ) ^ ((N : ℤ) - (m + 1) - 1))
            ((2 : ℝ) ^ ((N : ℤ) - m - 1)) := by
        simp only [truncationBand, Nat.cast_add, Nat.cast_one]
        congr 2
        all_goals ring
      calc
        (⋃ d ∈ Finset.range (m.succ + 1), truncationBand N d) =
            truncationBand N (m + 1) ∪
              (⋃ d ∈ Finset.range (m + 1), truncationBand N d) := by
          ext t
          simp [Nat.succ_eq_add_one, Finset.range_add_one]
        _ = Set.Ioc ((2 : ℝ) ^ ((N : ℤ) - (m + 1) - 1))
                ((2 : ℝ) ^ ((N : ℤ) - m - 1)) ∪
              Set.Ioc ((2 : ℝ) ^ ((N : ℤ) - m - 1)) ((2 : ℝ) ^ (N : ℤ)) := by rw [ih, hjoin]
        _ = Set.Ioc ((2 : ℝ) ^ ((N : ℤ) - (m + 1) - 1)) ((2 : ℝ) ^ (N : ℤ)) := by
          rw [Set.Ioc_union_Ioc_eq_Ioc]
          · apply zpow_le_zpow_right₀ (by norm_num)
            omega
          · apply zpow_le_zpow_right₀ (by norm_num)
            omega
        _ = Set.Ioc ((2 : ℝ) ^ ((N : ℤ) - m.succ - 1)) ((2 : ℝ) ^ (N : ℤ)) := by
          simp only [Nat.cast_succ]

theorem iUnion_truncationBand_eq_scaleSet (N : ℕ) :
    (⋃ d ∈ Finset.range (2 * N + 1), truncationBand N d) =
      truncationScaleSet N := by
  have h := iUnion_truncationBand_range N (2 * N)
  rw [truncationScaleSet]
  convert h using 1
  congr 2
  all_goals
    push_cast
    ring

theorem boxScaleBand_eq_truncationBand
    (α : Anisotropy) (N d : ℕ) {q : AnisoBox α}
    (hq : q ∈ truncationLevel α N d) :
    boxScaleBand q = truncationBand N d := by
  unfold boxScaleBand truncationBand boxLength
  rw [truncationLevel_level α N d hq]
  congr 1
  rw [zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0)]
  rw [zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0)]
  rw [zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0)]
  norm_num

theorem iUnion_boxScaleRegion_truncationLevel_eq
    (α : Anisotropy) (N d : ℕ) :
    (⋃ q ∈ truncationLevel α N d, boxScaleRegion α q) =
      truncationSpatialSet α N ×ˢ truncationBand N d := by
  ext pt
  constructor
  · intro hpt
    rcases Set.mem_iUnion.1 hpt with ⟨q, hpt⟩
    rcases Set.mem_iUnion.1 hpt with ⟨hq, hp, ht⟩
    constructor
    · rw [← iUnion_truncationLevel_eq_spatialSet α N d]
      exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hq, hp⟩⟩
    · rw [← boxScaleBand_eq_truncationBand α N d hq]
      exact ht
  · rintro ⟨hp, ht⟩
    rw [← iUnion_truncationLevel_eq_spatialSet α N d] at hp
    rcases Set.mem_iUnion.1 hp with ⟨q, hp⟩
    rcases Set.mem_iUnion.1 hp with ⟨hq, hp⟩
    refine Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hq, hp, ?_⟩⟩
    rw [boxScaleBand_eq_truncationBand α N d hq]
    exact ht

theorem boxLength_le_truncationScaleTop
    (α : Anisotropy) (N : ℕ) {q : AnisoBox α}
    (hq : q ∈ truncationCollection α N) :
    boxLength q ≤ (2 : ℝ) ^ (N : ℤ) := by
  unfold boxLength
  exact zpow_le_zpow_right₀ (by norm_num)
    (truncationCollection_level_bounds α N hq).2

theorem truncationScaleBottom_le_boxLength_div
    (α : Anisotropy) (N : ℕ) {q : AnisoBox α}
    (hq : q ∈ truncationCollection α N) :
    (2 : ℝ) ^ (-(N : ℤ) - 1) ≤ boxLength q / 2 := by
  have hlevel := (truncationCollection_level_bounds α N hq).1
  have hpow : (2 : ℝ) ^ (-(N : ℤ) - 1) ≤
      (2 : ℝ) ^ (q.level - 1) :=
    zpow_le_zpow_right₀ (by norm_num) (by omega)
  calc
    (2 : ℝ) ^ (-(N : ℤ) - 1) ≤ (2 : ℝ) ^ (q.level - 1) := hpow
    _ = boxLength q / 2 := by
      unfold boxLength
      rw [zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0)]
      norm_num

/-- Every literal cell of `Q_N` lies in the expected spatial/scale slab.
The reverse inclusion is the remaining grid-partition part of the Section 7
exhaustion argument. -/
theorem collectionRegion_truncationCollection_subset_slab
    (α : Anisotropy) (N : ℕ) :
    collectionRegion α (truncationCollection α N) ⊆
      truncationSpatialSet α N ×ˢ truncationScaleSet N := by
  intro pt hpt
  rw [collectionRegion] at hpt
  rcases Set.mem_iUnion.1 hpt with ⟨q, hpt⟩
  rcases Set.mem_iUnion.1 hpt with ⟨hq, hp, ht⟩
  constructor
  · exact truncationCollection_box_subset α N hq hp
  · change pt.2 ∈ Set.Ioc ((2 : ℝ) ^ (-(N : ℤ) - 1)) ((2 : ℝ) ^ (N : ℤ))
    change pt.2 ∈ boxScaleBand q at ht
    change boxLength q / 2 < pt.2 ∧ pt.2 ≤ boxLength q at ht
    exact ⟨lt_of_le_of_lt
      (truncationScaleBottom_le_boxLength_div α N hq) ht.1,
      ht.2.trans (boxLength_le_truncationScaleTop α N hq)⟩

/-- Exact center--scale region of the finite source truncation:
`Ω_{Q_N}=B_N × (2^{-N-1},2^N]`. -/
theorem collectionRegion_truncationCollection_eq_slab
    (α : Anisotropy) (N : ℕ) :
    collectionRegion α (truncationCollection α N) =
      truncationSpatialSet α N ×ˢ truncationScaleSet N := by
  apply Set.Subset.antisymm
  · exact collectionRegion_truncationCollection_subset_slab α N
  · rintro pt ⟨hp, ht⟩
    rw [← iUnion_truncationBand_eq_scaleSet N] at ht
    rcases Set.mem_iUnion.1 ht with ⟨d, ht⟩
    rcases Set.mem_iUnion.1 ht with ⟨hd, ht⟩
    have hplevel : pt.1 ∈ ⋃ q ∈ truncationLevel α N d, boxSet α q :=
      truncationSpatialSet_subset_iUnion_level α N d hp
    rcases Set.mem_iUnion.1 hplevel with ⟨q, hplevel⟩
    rcases Set.mem_iUnion.1 hplevel with ⟨hq, hpq⟩
    have hqcoll : q ∈ truncationCollection α N :=
      (mem_truncationCollection_iff α N q).mpr ⟨d, hd, hq⟩
    rw [collectionRegion]
    refine Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hqcoll, ?_⟩⟩
    change pt.1 ∈ boxSet α q ∧ pt.2 ∈ boxScaleBand q
    refine ⟨hpq, ?_⟩
    rw [boxScaleBand_eq_truncationBand α N d hq]
    exact ht

theorem mem_truncationSpatialSet_of_coord_abs_lt
    (α : Anisotropy) (N : ℕ) (x : E3)
    (hbound : ∀ i : Fin 3,
      |(WithLp.ofLp x : Fin 3 → ℝ) i| <
        (2 : ℝ) ^ ((N : ℤ) * (α.weight i : ℤ))) :
    x ∈ truncationSpatialSet α N := by
  let v : Fin 3 → Bool := fun i ↦ decide (0 ≤ (WithLp.ofLp x : Fin 3 → ℝ) i)
  let R : AnisoBox α := ⟨(N : ℤ), fun i ↦ if v i then 0 else -1⟩
  have hR : R ∈ truncationRoots α N :=
    (mem_truncationRoots_iff α N R).mpr ⟨by simp [R], v, by simp [R]⟩
  refine Set.mem_iUnion.2 ⟨R, Set.mem_iUnion.2 ⟨hR, ?_⟩⟩
  rw [boxSet, Set.mem_preimage, Set.mem_pi]
  intro i _
  have hside : boxSide α R i =
      (2 : ℝ) ^ ((N : ℤ) * (α.weight i : ℤ)) := by
    simp [R, boxSide]
  have hspos : 0 < boxSide α R i := boxSide_pos α R i
  rw [boxInterval]
  by_cases hxi : 0 ≤ (WithLp.ofLp x : Fin 3 → ℝ) i
  · have hv : v i = true := by simp [v, hxi]
    have hxlt : (WithLp.ofLp x : Fin 3 → ℝ) i < boxSide α R i := by
      rw [hside]
      exact (le_abs_self _).trans_lt (hbound i)
    simpa [R, hv] using ⟨hxi, hxlt⟩
  · have hxneg : (WithLp.ofLp x : Fin 3 → ℝ) i < 0 := lt_of_not_ge hxi
    have hv : v i = false := by simp [v, hxi]
    have hxlo : -(boxSide α R i) < (WithLp.ofLp x : Fin 3 → ℝ) i := by
      rw [hside]
      exact (abs_lt.mp (hbound i)).1
    simpa [R, hv] using ⟨hxlo.le, hxneg⟩

theorem exists_mem_truncationSpatialSet
    (α : Anisotropy) (x : E3) :
    ∃ N : ℕ, x ∈ truncationSpatialSet α N := by
  let C : ℝ := ∑ i : Fin 3, |(WithLp.ofLp x : Fin 3 → ℝ) i|
  have hpow : Tendsto (fun N : ℕ ↦ (2 : ℝ) ^ N) atTop atTop :=
    tendsto_pow_atTop_atTop_of_one_lt (by norm_num)
  obtain ⟨N, hN⟩ := hpow.eventually_gt_atTop C |>.exists
  refine ⟨N, mem_truncationSpatialSet_of_coord_abs_lt α N x ?_⟩
  intro i
  have hcoord : |(WithLp.ofLp x : Fin 3 → ℝ) i| ≤ C := by
    dsimp [C]
    exact Finset.single_le_sum
      (s := Finset.univ)
      (f := fun j : Fin 3 ↦ |(WithLp.ofLp x : Fin 3 → ℝ) j|)
      (fun j _ ↦ abs_nonneg _) (Finset.mem_univ i)
  have hweight : N ≤ N * α.weight i := by
    calc
      N = N * 1 := by omega
      _ ≤ N * α.weight i := Nat.mul_le_mul_left N
        (Nat.succ_le_iff.mpr (α.weight_pos i))
  calc
    |(WithLp.ofLp x : Fin 3 → ℝ) i| ≤ C := hcoord
    _ < (2 : ℝ) ^ N := hN
    _ ≤ (2 : ℝ) ^ (N * α.weight i) :=
      pow_le_pow_right₀ (by norm_num) hweight
    _ = (2 : ℝ) ^ ((N : ℤ) * (α.weight i : ℤ)) := by
      have hexp : ((N * α.weight i : ℕ) : ℤ) =
          (N : ℤ) * (α.weight i : ℤ) := by
        push_cast
        ring
      rw [← hexp, zpow_natCast]

theorem truncationSpatialSet_subset_succ
    (α : Anisotropy) (N : ℕ) :
    truncationSpatialSet α N ⊆ truncationSpatialSet α (N + 1) := by
  intro x hx
  rw [truncationSpatialSet] at hx ⊢
  rcases Set.mem_iUnion.1 hx with ⟨R, hx⟩
  rcases Set.mem_iUnion.1 hx with ⟨hR, hx⟩
  refine Set.mem_iUnion.2 ⟨boxParent α R, Set.mem_iUnion.2
    ⟨parent_mem_truncationRoots α N hR, ?_⟩⟩
  exact boxSet_subset_parent α R hx

theorem monotone_truncationSpatialSet (α : Anisotropy) :
    Monotone (truncationSpatialSet α) :=
  monotone_nat_of_le_succ (truncationSpatialSet_subset_succ α)

theorem truncationScaleSet_subset_succ (N : ℕ) :
    truncationScaleSet N ⊆ truncationScaleSet (N + 1) := by
  intro t ht
  change t ∈ Set.Ioc ((2 : ℝ) ^ (-(N : ℤ) - 1)) ((2 : ℝ) ^ (N : ℤ)) at ht
  change t ∈ Set.Ioc ((2 : ℝ) ^ (-((N + 1 : ℕ) : ℤ) - 1))
    ((2 : ℝ) ^ ((N + 1 : ℕ) : ℤ))
  constructor
  · apply lt_of_le_of_lt _ ht.1
    apply zpow_le_zpow_right₀ (by norm_num)
    push_cast
    omega
  · exact ht.2.trans (zpow_le_zpow_right₀ (by norm_num) (by push_cast; omega))

theorem monotone_truncationScaleSet : Monotone truncationScaleSet :=
  monotone_nat_of_le_succ truncationScaleSet_subset_succ

theorem exists_mem_truncationScaleSet {t : ℝ} (ht : 0 < t) :
    ∃ N : ℕ, t ∈ truncationScaleSet N := by
  have hpow : Tendsto (fun N : ℕ ↦ (2 : ℝ) ^ N) atTop atTop :=
    tendsto_pow_atTop_atTop_of_one_lt (by norm_num)
  obtain ⟨N, hNt, hNinv⟩ :=
    ((hpow.eventually_gt_atTop t).and
      (hpow.eventually_gt_atTop t⁻¹)).exists
  refine ⟨N, ?_⟩
  change t ∈ Set.Ioc ((2 : ℝ) ^ (-(N : ℤ) - 1)) ((2 : ℝ) ^ (N : ℤ))
  refine ⟨?_, ?_⟩
  · have hinv : ((2 : ℝ) ^ (N : ℤ))⁻¹ < (t⁻¹)⁻¹ :=
      inv_strictAntiOn
        (show t⁻¹ ∈ Set.Ioi (0 : ℝ) from inv_pos.mpr ht)
        (show (2 : ℝ) ^ N ∈ Set.Ioi (0 : ℝ) from
          pow_pos (show (0 : ℝ) < 2 by norm_num) N)
        hNinv
    have hneg : (2 : ℝ) ^ (-(N : ℤ)) < t := by
      simpa [zpow_neg, inv_inv] using hinv
    have hstep : (2 : ℝ) ^ (-(N : ℤ) - 1) ≤ (2 : ℝ) ^ (-(N : ℤ)) :=
      zpow_le_zpow_right₀ (by norm_num) (by omega)
    exact lt_of_le_of_lt hstep hneg
  · simpa only [zpow_natCast] using hNt.le

/-- The finite source regions exhaust exactly `E₃ × (0,∞)`. -/
theorem iUnion_collectionRegion_truncationCollection
    (α : Anisotropy) :
    (⋃ N : ℕ, collectionRegion α (truncationCollection α N)) =
      Set.univ ×ˢ Set.Ioi (0 : ℝ) := by
  apply Set.Subset.antisymm
  · rintro pt hpt
    rcases Set.mem_iUnion.1 hpt with ⟨N, hpt⟩
    rw [collectionRegion_truncationCollection_eq_slab α N] at hpt
    rcases hpt with ⟨-, ht⟩
    constructor
    · exact Set.mem_univ _
    · change (0 : ℝ) < pt.2
      exact lt_trans
        (show (0 : ℝ) < (2 : ℝ) ^ (-(N : ℤ) - 1) by exact zpow_pos (by norm_num) _)
        ht.1
  · rintro pt ⟨-, ht⟩
    obtain ⟨Np, hp⟩ := exists_mem_truncationSpatialSet α pt.1
    obtain ⟨Nt, ht'⟩ := exists_mem_truncationScaleSet ht
    let N : ℕ := max Np Nt
    have hpN : pt.1 ∈ truncationSpatialSet α N :=
      monotone_truncationSpatialSet α (Nat.le_max_left _ _) hp
    have htN : pt.2 ∈ truncationScaleSet N :=
      monotone_truncationScaleSet (Nat.le_max_right _ _) ht'
    refine Set.mem_iUnion.2 ⟨N, ?_⟩
    rw [collectionRegion_truncationCollection_eq_slab α N]
    exact ⟨hpN, htN⟩

/-- A generic increasing finite collection exhaustion gives convergence of
the real expanded local form whenever its signed outer integrand is integrable
on the limiting region. -/
theorem tendsto_expandedModelLocalForm_of_monotone_exhaustion
    (α : Anisotropy) (S : ℕ → BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (V : Set (E3 × ℝ))
    (hmono : Monotone fun N ↦ collectionRegion α (S N))
    (hV : (⋃ N, collectionRegion α (S N)) = V)
    (hint : IntegrableOn (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z)) V cubeScaleMeasure) :
    Tendsto (fun N ↦ expandedModelLocalForm α (S N) u c f) atTop
      (𝓝 (-∫ pt in V,
        c pt.2 * (∫ z : ModelE5,
          modelFirstFiber α f pt.1 pt.2 z *
            modelSecondFiber α (f 3) pt.1 pt.2 z *
              modelSignedDensity α u pt.1 pt.2 z)
        ∂cubeScaleMeasure)) := by
  let g : E3 × ℝ → ℝ := fun pt ↦
    c pt.2 * (∫ z : ModelE5,
      modelFirstFiber α f pt.1 pt.2 z *
        modelSecondFiber α (f 3) pt.1 pt.2 z *
          modelSignedDensity α u pt.1 pt.2 z)
  have hlim := tendsto_setIntegral_of_monotone
    (μ := cubeScaleMeasure)
    (f := g)
    (fun N ↦ measurableSet_collectionRegion α (S N)) hmono (by
      simpa only [hV] using hint)
  rw [hV] at hlim
  simpa only [expandedModelLocalForm, g] using hlim.neg

/-- The Section 7 convergence bridge for the literal finite truncations. -/
theorem tendsto_expandedModelLocalForm_truncationCollection
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (hint : IntegrableOn (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (Set.univ ×ˢ Set.Ioi (0 : ℝ)) cubeScaleMeasure) :
    Tendsto (fun N ↦ expandedModelLocalForm α
      (truncationCollection α N) u c f) atTop
      (𝓝 (-∫ pt in Set.univ ×ˢ Set.Ioi (0 : ℝ),
        c pt.2 * (∫ z : ModelE5,
          modelFirstFiber α f pt.1 pt.2 z *
            modelSecondFiber α (f 3) pt.1 pt.2 z *
              modelSignedDensity α u pt.1 pt.2 z)
        ∂cubeScaleMeasure)) := by
  exact tendsto_expandedModelLocalForm_of_monotone_exhaustion
    α (truncationCollection α) u c f (Set.univ ×ˢ Set.Ioi (0 : ℝ))
    (collectionRegion_mono_of_truncationCollection α)
    (iUnion_collectionRegion_truncationCollection α) hint

/-- The low-frequency Calderón cutoff is nonnegative. -/
theorem conePhi_nonneg (x : ℝ) :
    0 ≤ conePhi x := by
  by_cases hx : |x| ≤ 2
  · rw [conePhi_eq_tail]
    exact intervalIntegral.integral_nonneg hx fun y hy ↦
      coneWeight_nonneg_of_nonneg (le_trans (abs_nonneg x) hy.1)
  · have hx' : 2 ≤ |x| := le_of_lt (lt_of_not_ge hx)
    rw [conePhi_eq_zero_of_two_le_abs hx']

/-- The low-frequency cutoff never exceeds its positive Calderón mass. -/
theorem conePhi_le_cPsi (x : ℝ) :
    conePhi x ≤ cPsi := by
  by_cases hx : |x| ≤ 2
  · rw [conePhi_eq_tail, cPsi]
    apply intervalIntegral.integral_mono_interval (c := (0 : ℝ)) (d := 2)
      (by positivity) hx (by norm_num) ?_
      (coneWeight_contDiff.continuous.intervalIntegrable _ _)
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with y hy
    exact coneWeight_nonneg_of_nonneg hy.1.le
  · have hx' : 2 ≤ |x| := le_of_lt (lt_of_not_ge hx)
    rw [conePhi_eq_zero_of_two_le_abs hx']
    exact le_of_lt cPsi_pos

/-- The smooth primitive differentiates to the Calderón density. -/
theorem hasDerivAt_conePrimitive (x : ℝ) :
    HasDerivAt conePrimitive (coneWeight x) x := by
  unfold conePrimitive
  exact intervalIntegral.integral_hasDerivAt_right
    (coneWeight_contDiff.continuous.intervalIntegrable _ _)
    coneWeight_contDiff.continuous.aestronglyMeasurable.stronglyMeasurableAtFilter
    coneWeight_contDiff.continuous.continuousAt

/-- The derivative of the low-frequency cutoff is the negative Calderón
density, including at the removable origin. -/
theorem hasDerivAt_conePhi (x : ℝ) :
    HasDerivAt conePhi (-coneWeight x) x := by
  unfold conePhi
  have hfun : (fun y : ℝ ↦ cPsi - conePrimitive y) =
      (fun _ : ℝ ↦ cPsi) - conePrimitive := by
    funext y
    rfl
  rw [hfun]
  simpa using (hasDerivAt_const x cPsi).sub (hasDerivAt_conePrimitive x)

theorem deriv_conePhi (x : ℝ) :
    deriv conePhi x = -coneWeight x :=
  (hasDerivAt_conePhi x).deriv

/-- The one-dimensional differential Calderón identity at an anisotropic
natural scale. -/
theorem neg_mul_deriv_conePhi_nat_scale
    (n : ℕ) (hn : 0 < n) (ξ t : ℝ) (hξ : ξ ≠ 0) (ht : 0 < t) :
    -t * deriv (fun s : ℝ ↦ conePhi (s ^ n * ξ)) t =
      (n : ℝ) * conePsi (t ^ n * ξ) * gaussianDeriv (t ^ n * ξ) ^ 2 := by
  have hpow : HasDerivAt (fun s : ℝ ↦ s ^ n * ξ)
      ((n : ℝ) * t ^ (n - 1) * ξ) t := by
    convert (hasDerivAt_pow n t).mul_const ξ using 1 <;> ring
  have hcomp := (hasDerivAt_conePhi (t ^ n * ξ)).comp t hpow
  have hderiv : deriv (fun s : ℝ ↦ conePhi (s ^ n * ξ)) t =
      (-coneWeight (t ^ n * ξ)) * ((n : ℝ) * t ^ (n - 1) * ξ) :=
    hcomp.deriv
  rw [hderiv]
  have htn : t ^ n * ξ ≠ 0 := mul_ne_zero (pow_ne_zero _ ht.ne') hξ
  have hpow' : t * t ^ (n - 1) = t ^ n := by
    calc
      t * t ^ (n - 1) = t ^ (n - 1) * t := by ring
      _ = t ^ ((n - 1) + 1) := (pow_succ t (n - 1)).symm
      _ = t ^ n := by congr 1 <;> omega
  rw [coneWeight_eq_source_integrand htn]
  field_simp
  calc
    t * conePsi (t ^ n * ξ) * gaussianDeriv (t ^ n * ξ) ^ 2 * t ^ (n - 1) =
        (t * t ^ (n - 1)) * conePsi (t ^ n * ξ) * gaussianDeriv (t ^ n * ξ) ^ 2 := by
          ring
    _ = _ := by rw [hpow']

/-- A translated square times an integrable absolute tail is integrable on
the two-variable product space.  This is the analytic Fubini fact needed to
discharge the fixed `(p₂,r)` condition in the global-energy identity. -/
theorem integrable_square_shifted_mul_abs
    (B ψ : ℝ → ℝ) (s u : ℝ)
    (hBcont : Continuous B)
    (hBsq : Integrable (fun q : ℝ ↦ B q ^ 2))
    (hψcont : Continuous ψ)
    (hψ : Integrable (fun r : ℝ ↦ |ψ (r + u)|)) :
    Integrable (fun z : ℝ × ℝ ↦
      B (z.1 + z.2 * s) ^ 2 * |ψ (z.2 + u)|)
      ((volume : Measure ℝ).prod volume) := by
  let G : ℝ × ℝ → ℝ := fun z ↦
    B (z.2 + z.1 * s) ^ 2 * |ψ (z.1 + u)|
  have hGcont : Continuous G := by
    apply Continuous.mul
    · exact (hBcont.comp
        ((continuous_snd.add (continuous_fst.mul continuous_const)))).pow 2
    · exact (hψcont.comp (continuous_fst.add continuous_const)).abs
  have hGin : ∀ᵐ r : ℝ,
      Integrable (fun p : ℝ ↦ G (r, p)) := by
    filter_upwards [] with r
    have hshift : Integrable (fun p : ℝ ↦ B (p + r * s) ^ 2) := by
      simpa only using hBsq.comp_add_right (r * s)
    simpa only [G] using hshift.mul_const |ψ (r + u)|
  have hGnorm : Integrable (fun r : ℝ ↦ ∫ p : ℝ, ‖G (r, p)‖) := by
    have hconst : Integrable (fun r : ℝ ↦
        (∫ q : ℝ, B q ^ 2) * |ψ (r + u)|) := hψ.const_mul _
    apply hconst.congr
    filter_upwards [] with r
    have hBnonneg (q : ℝ) : 0 ≤ B q ^ 2 := sq_nonneg _
    have htailnonneg : 0 ≤ |ψ (r + u)| := abs_nonneg _
    symm
    calc
      (∫ p : ℝ, ‖G (r, p)‖) =
          ∫ p : ℝ, B (p + r * s) ^ 2 * |ψ (r + u)| := by
            apply integral_congr_ae
            filter_upwards [] with p
            dsimp [G]
            exact abs_of_nonneg (mul_nonneg (hBnonneg _) htailnonneg)
      _ = (∫ p : ℝ, B (p + r * s) ^ 2) * |ψ (r + u)| := by
            rw [integral_mul_const]
      _ = (∫ q : ℝ, B q ^ 2) * |ψ (r + u)| := by
            exact congrArg (fun x : ℝ ↦ x * |ψ (r + u)|)
              (integral_add_right_eq_self (μ := volume)
                (fun q : ℝ ↦ B q ^ 2) (r * s))
  have hG : Integrable G ((volume : Measure ℝ).prod volume) := by
    exact (integrable_prod_iff hGcont.aestronglyMeasurable).mpr ⟨hGin, hGnorm⟩
  have hswap : Integrable (G ∘ Prod.swap)
      ((volume : Measure ℝ).prod volume) := hG.swap
  apply hswap.congr
  filter_upwards [] with z
  rfl

/-- An integrable real function with a uniform absolute bound has integrable
square. -/
theorem integrable_sq_of_integrable_bounded
    (B : ℝ → ℝ) (hB : Integrable B)
    (C : ℝ) (hC : 0 ≤ C) (hbound : ∀ q : ℝ, |B q| ≤ C) :
    Integrable (fun q : ℝ ↦ B q ^ 2) := by
  have hmajor : Integrable (fun q : ℝ ↦ C * |B q|) :=
    hB.norm.const_mul C
  apply Integrable.mono hmajor
    (hB.aestronglyMeasurable.pow 2)
  filter_upwards [] with q
  have hBnonneg : 0 ≤ |B q| := abs_nonneg _
  change |B q ^ 2| ≤ abs (C * |B q|)
  rw [abs_of_nonneg (sq_nonneg _),
    abs_of_nonneg (mul_nonneg hC hBnonneg)]
  rw [← sq_abs]
  nlinarith [hbound q]

/-- A real Schwartz third-coordinate fiber satisfies the fixed-scale
`(p₂,r)` integrability required by the global second-energy reduction. -/
theorem integrable_modelSecondFiberReduced_p2_r_of_real_schwartz
    (α : Anisotropy) (u : E3) (f : SchwartzMap E3 ℝ)
    (x₁ x₂ t : ℝ) (ht : 0 < t) :
    Integrable (fun z : ℝ × ℝ ↦
      (modelSecondFiberReduced α f x₁ x₂ z.1 t z.2) ^ 2 *
        |conePsiPhysicalReal (z.2 + u 2)|)
      ((volume : Measure ℝ).prod volume) := by
  let F : SchwartzMap ℝ ℂ :=
    modelThirdSchwartzFiber (complexifyRealSchwartz f) x₁ x₂
  let g : ℝ → ℝ := fun v ↦ f (modelPoint x₁ x₂ v)
  let s : ℝ := t ^ α.weight 2
  let K : ℝ → ℂ := fun v ↦ (gaussianDerivAt s 0 v : ℂ)
  let Cfun : ℝ → ℂ := fun q ↦
    ∫ v : ℝ, F v * (gaussianDerivAt s q v : ℂ)
  let B : ℝ → ℝ := fun q ↦
    ∫ v : ℝ, g v * gaussianDerivAt s q v
  have hs : 0 < s := by
    dsimp [s]
    exact pow_pos ht _
  have hFreal (v : ℝ) : F v = (g v : ℂ) := by
    dsimp [F, g]
    simp
  have hK : Integrable K := by
    dsimp [K]
    exact (integrable_gaussianDerivAt hs 0).ofReal
  have hconv : Integrable ((F : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] K) :=
    F.integrable.integrable_convolution (ContinuousLinearMap.mul ℂ ℂ) hK
  have hCfun_eq (q : ℝ) : Cfun q =
      -((F : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] K) q := by
    dsimp [Cfun, K]
    exact gaussianDerivAt_fiber_eq_neg_convolution F s q
  have hCfun : Integrable Cfun := by
    apply hconv.neg.congr
    filter_upwards [] with q
    symm
    exact hCfun_eq q
  have hconvcont : Continuous ((F : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] K) :=
    (bddAbove_norm_complex_gaussianDerivAt s 0).continuous_convolution_right_of_integrable
        (ContinuousLinearMap.mul ℂ ℂ) F.integrable
        (continuous_complex_gaussianDerivAt s 0)
  have hCfuncont : Continuous Cfun := by
    apply hconvcont.neg.congr
    intro q
    symm
    exact hCfun_eq q
  obtain ⟨C, hC⟩ := bddAbove_norm_complex_gaussianDerivAt s 0
  have hKbound (v : ℝ) : ‖K v‖ ≤ C := by
    exact hC ⟨v, rfl⟩
  have hCfunbound (q : ℝ) : ‖Cfun q‖ ≤ (∫ v : ℝ, ‖F v‖) * C := by
    have hmajor : Integrable (fun v : ℝ ↦ ‖F v‖ * C) :=
      F.integrable.norm.mul_const C
    calc
      ‖Cfun q‖ ≤ ∫ v : ℝ,
          ‖F v * (gaussianDerivAt s q v : ℂ)‖ :=
        norm_integral_le_integral_norm _
      _ ≤ ∫ v : ℝ, ‖F v‖ * C := by
        apply MeasureTheory.integral_mono_of_nonneg
        · filter_upwards [] with v
          exact norm_nonneg _
        · exact hmajor
        filter_upwards [] with v
        rw [norm_mul]
        apply mul_le_mul_of_nonneg_left
        · rw [gaussianDerivAt_reflect]
          push_cast
          simpa [K, Complex.norm_real, Real.norm_eq_abs] using hKbound (q - v)
        · exact norm_nonneg _
      _ = (∫ v : ℝ, ‖F v‖) * C := by
        rw [integral_mul_const]
  have hB_eq (q : ℝ) : Cfun q = (B q : ℂ) := by
    dsimp [Cfun, B]
    exact complexFiberIntegral_eq_real F g hFreal s q
  have hB : Integrable B := by
    apply hCfun.re.congr
    filter_upwards [] with q
    exact congrArg Complex.re (hB_eq q)
  have hBcont : Continuous B := by
    apply (Complex.continuous_re.comp hCfuncont).congr
    intro q
    exact congrArg Complex.re (hB_eq q)
  have hDnonneg : 0 ≤ (∫ v : ℝ, ‖F v‖) * C := by
    exact (norm_nonneg (Cfun 0)).trans (hCfunbound 0)
  have hBbound (q : ℝ) : |B q| ≤ (∫ v : ℝ, ‖F v‖) * C := by
    calc
      |B q| = ‖(B q : ℂ)‖ := by simp
      _ = ‖Cfun q‖ := by rw [hB_eq q]
      _ ≤ _ := hCfunbound q
  have hBsq : Integrable (fun q : ℝ ↦ B q ^ 2) :=
    integrable_sq_of_integrable_bounded B hB
      ((∫ v : ℝ, ‖F v‖) * C) hDnonneg hBbound
  have htail : Integrable (fun r : ℝ ↦
      |conePsiPhysicalReal (r + u 2)|) :=
    integrable_abs_conePsiPhysicalReal.comp_add_right (u 2)
  have hmain := integrable_square_shifted_mul_abs
    B conePsiPhysicalReal s (u 2) hBcont hBsq
    conePsiPhysicalReal.continuous htail
  apply hmain.congr
  filter_upwards [] with z
  dsimp [B, g, s]
  rfl

/-- For a real Schwartz input, all post-Tonelli scalar and fixed-fiber
integrability conditions in the global second-energy identity are automatic.
The original joint density is the sole remaining global Fubini hypothesis. -/
theorem modelEnergyTwoOn_global_eq_of_real_schwartz_of_joint
    (α : Anisotropy) (u : E3) (f : SchwartzMap E3 ℝ)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyTwoIntegrand α u f q.1 q.2)
      ((cubeScaleMeasure.restrict (Set.univ ×ˢ Set.Ioi (0 : ℝ))).prod volume)) :
    modelEnergyTwoOn α (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f =
      (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 *
        conePsiPhysicalRealL1 * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ x : E3, f x ^ 2 := by
  apply modelEnergyTwoOn_global_eq_of_joint_and_fixedFiber α u f hjoint
  intro x₁ x₂ t ht
  exact integrable_modelSecondFiberReduced_p2_r_of_real_schwartz
    α u f x₁ x₂ t ht

/-- Integrating the differential identity gives the finite-scale Calderón
telescoping formula. -/
theorem calderon_interval_nat_scale
    (n : ℕ) (hn : 0 < n) (ξ a b : ℝ) (hξ : ξ ≠ 0)
    (ha : 0 < a) (hab : a ≤ b) :
    ∫ t in a..b,
      (n : ℝ) * conePsi (t ^ n * ξ) * gaussianDeriv (t ^ n * ξ) ^ 2 / t =
        conePhi (a ^ n * ξ) - conePhi (b ^ n * ξ) := by
  let F : ℝ → ℝ :=
    (fun _ : ℝ ↦ cPsi) - conePrimitive ∘ (fun s : ℝ ↦ s ^ n * ξ)
  let F' : ℝ → ℝ := fun s ↦
    (-coneWeight (s ^ n * ξ)) * ((n : ℝ) * s ^ (n - 1) * ξ)
  have hpowcont : Continuous (fun s : ℝ ↦ s ^ n * ξ) :=
    (continuous_pow n).mul continuous_const
  have hFcont : Continuous F := by
    dsimp [F]
    exact continuous_const.sub (conePrimitive_contDiff.continuous.comp hpowcont)
  have hF'cont : Continuous F' := by
    dsimp [F']
    exact (coneWeight_contDiff.continuous.comp hpowcont).neg.mul
      ((continuous_const.mul (continuous_pow (n - 1))).mul continuous_const)
  have hFderiv (s : ℝ) : HasDerivAt F (F' s) s := by
    have hpow : HasDerivAt (fun y : ℝ ↦ y ^ n * ξ)
        ((n : ℝ) * s ^ (n - 1) * ξ) s := by
      convert (hasDerivAt_pow n s).mul_const ξ using 1 <;> ring
    have hprim := (hasDerivAt_conePrimitive (s ^ n * ξ)).comp s hpow
    have h := (hasDerivAt_const s cPsi).sub hprim
    simpa only [F, F', Pi.sub_apply, Pi.zero_apply, zero_sub, neg_mul] using h
  have hFTC := intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le hab
    hFcont.continuousOn (fun s _ ↦ hFderiv s) (hF'cont.intervalIntegrable _ _)
  have hneg : (∫ t in a..b, -F' t) = F a - F b := by
    rw [intervalIntegral.integral_neg, hFTC]
    ring
  have hpoint (t : ℝ) (ht : t ∈ Set.Icc a b) :
      (n : ℝ) * conePsi (t ^ n * ξ) * gaussianDeriv (t ^ n * ξ) ^ 2 / t =
        -F' t := by
    have htpos : 0 < t := lt_of_lt_of_le ha ht.1
    change (n : ℝ) * conePsi (t ^ n * ξ) * gaussianDeriv (t ^ n * ξ) ^ 2 / t =
      -F' t
    dsimp [F']
    have htn : t ^ n * ξ ≠ 0 := mul_ne_zero (pow_ne_zero _ htpos.ne') hξ
    have hpow' : t * t ^ (n - 1) = t ^ n := by
      calc
        t * t ^ (n - 1) = t ^ (n - 1) * t := by ring
        _ = t ^ ((n - 1) + 1) := (pow_succ t (n - 1)).symm
        _ = t ^ n := by congr 1 <;> omega
    rw [coneWeight_eq_source_integrand htn]
    field_simp
    rw [← hpow']
    ring
  calc
    ∫ t in a..b,
        (n : ℝ) * conePsi (t ^ n * ξ) * gaussianDeriv (t ^ n * ξ) ^ 2 / t =
        ∫ t in a..b, -F' t := by
          apply intervalIntegral.integral_congr
          rw [Set.uIcc_of_le hab]
          exact fun t ht ↦ hpoint t ht
    _ = F a - F b := hneg
    _ = conePhi (a ^ n * ξ) - conePhi (b ^ n * ξ) := by
      have hFapply (s : ℝ) : F s = conePhi (s ^ n * ξ) := by
        dsimp [F, conePhi]
      rw [hFapply a, hFapply b]

theorem hasDerivAt_conePhi_nat_scale
    (n : ℕ) (ξ s : ℝ) :
    HasDerivAt (conePhi ∘ fun y : ℝ ↦ y ^ n * ξ)
      ((-coneWeight (s ^ n * ξ)) * ((n : ℝ) * s ^ (n - 1) * ξ)) s := by
  have hpow : HasDerivAt (fun y : ℝ ↦ y ^ n * ξ)
      ((n : ℝ) * s ^ (n - 1) * ξ) s := by
    convert (hasDerivAt_pow n s).mul_const ξ using 1 <;> ring
  exact (hasDerivAt_conePhi (s ^ n * ξ)).comp s hpow

/-- The product of the three anisotropically scaled low-frequency cutoffs. -/
noncomputable def coneProduct (α : Anisotropy) (ξ : E3) : ℝ → ℝ :=
  ((conePhi ∘ fun t : ℝ ↦ t ^ (α.weight 0) * ξ 0) *
    (conePhi ∘ fun t : ℝ ↦ t ^ (α.weight 1) * ξ 1)) *
      (conePhi ∘ fun t : ℝ ↦ t ^ (α.weight 2) * ξ 2)

/-- Product-rule form of the finite-scale three-cone identity. -/
theorem hasDerivAt_coneProduct
    (α : Anisotropy) (ξ : E3) (t : ℝ) :
    let A : ℝ → ℝ := conePhi ∘ fun s : ℝ ↦ s ^ (α.weight 0) * ξ 0
    let B : ℝ → ℝ := conePhi ∘ fun s : ℝ ↦ s ^ (α.weight 1) * ξ 1
    let C : ℝ → ℝ := conePhi ∘ fun s : ℝ ↦ s ^ (α.weight 2) * ξ 2
    let d0 : ℝ := -coneWeight (t ^ (α.weight 0) * ξ 0) *
      ((α.weight 0 : ℝ) * t ^ (α.weight 0 - 1) * ξ 0)
    let d1 : ℝ := -coneWeight (t ^ (α.weight 1) * ξ 1) *
      ((α.weight 1 : ℝ) * t ^ (α.weight 1 - 1) * ξ 1)
    let d2 : ℝ := -coneWeight (t ^ (α.weight 2) * ξ 2) *
      ((α.weight 2 : ℝ) * t ^ (α.weight 2 - 1) * ξ 2)
    HasDerivAt ((A * B) * C)
      ((d0 * B t + A t * d1) * C t + (A * B) t * d2) t := by
  dsimp only
  exact
    ((hasDerivAt_conePhi_nat_scale (α.weight 0) (ξ 0) t).mul
      (hasDerivAt_conePhi_nat_scale (α.weight 1) (ξ 1) t)).mul
      (hasDerivAt_conePhi_nat_scale (α.weight 2) (ξ 2) t)

/-- The differentiated product is the three-cone Calderón integrand, with
the identity continuing across the coordinate planes. -/
theorem neg_mul_deriv_coneProduct
    (α : Anisotropy) (ξ : E3) (t : ℝ) :
    -t * deriv (coneProduct α ξ) t =
      ((α.weight 0 : ℝ) * conePsi (t ^ (α.weight 0) * ξ 0) *
          gaussianDeriv (t ^ (α.weight 0) * ξ 0) ^ 2) *
        conePhi (t ^ (α.weight 1) * ξ 1) *
          conePhi (t ^ (α.weight 2) * ξ 2) +
      conePhi (t ^ (α.weight 0) * ξ 0) *
        ((α.weight 1 : ℝ) * conePsi (t ^ (α.weight 1) * ξ 1) *
          gaussianDeriv (t ^ (α.weight 1) * ξ 1) ^ 2) *
          conePhi (t ^ (α.weight 2) * ξ 2) +
      conePhi (t ^ (α.weight 0) * ξ 0) *
        conePhi (t ^ (α.weight 1) * ξ 1) *
          ((α.weight 2 : ℝ) * conePsi (t ^ (α.weight 2) * ξ 2) *
            gaussianDeriv (t ^ (α.weight 2) * ξ 2) ^ 2) := by
  let A : ℝ → ℝ := conePhi ∘ fun s : ℝ ↦ s ^ (α.weight 0) * ξ 0
  let B : ℝ → ℝ := conePhi ∘ fun s : ℝ ↦ s ^ (α.weight 1) * ξ 1
  let C : ℝ → ℝ := conePhi ∘ fun s : ℝ ↦ s ^ (α.weight 2) * ξ 2
  let d0 : ℝ := -coneWeight (t ^ (α.weight 0) * ξ 0) *
    ((α.weight 0 : ℝ) * t ^ (α.weight 0 - 1) * ξ 0)
  let d1 : ℝ := -coneWeight (t ^ (α.weight 1) * ξ 1) *
    ((α.weight 1 : ℝ) * t ^ (α.weight 1 - 1) * ξ 1)
  let d2 : ℝ := -coneWeight (t ^ (α.weight 2) * ξ 2) *
    ((α.weight 2 : ℝ) * t ^ (α.weight 2 - 1) * ξ 2)
  let g0 : ℝ := (α.weight 0 : ℝ) * conePsi (t ^ (α.weight 0) * ξ 0) *
    gaussianDeriv (t ^ (α.weight 0) * ξ 0) ^ 2
  let g1 : ℝ := (α.weight 1 : ℝ) * conePsi (t ^ (α.weight 1) * ξ 1) *
    gaussianDeriv (t ^ (α.weight 1) * ξ 1) ^ 2
  let g2 : ℝ := (α.weight 2 : ℝ) * conePsi (t ^ (α.weight 2) * ξ 2) *
    gaussianDeriv (t ^ (α.weight 2) * ξ 2) ^ 2
  have hderiv : deriv ((A * B) * C) t =
      (d0 * B t + A t * d1) * C t + (A * B) t * d2 :=
    (hasDerivAt_coneProduct α ξ t).deriv
  have h0 : -t * d0 = g0 := by
    dsimp [d0, g0, coneWeight, gaussianDeriv]
    have hpow : t * t ^ (α.weight 0 - 1) = t ^ (α.weight 0) := by
      calc
        t * t ^ (α.weight 0 - 1) = t ^ (α.weight 0 - 1) * t := by ring
        _ = t ^ ((α.weight 0 - 1) + 1) := (pow_succ t (α.weight 0 - 1)).symm
        _ = t ^ (α.weight 0) := by
          have hpos : 0 < α.weight 0 := α.weight_pos 0
          congr 1
          omega
    rw [← hpow]
    ring
  have h1 : -t * d1 = g1 := by
    dsimp [d1, g1, coneWeight, gaussianDeriv]
    have hpow : t * t ^ (α.weight 1 - 1) = t ^ (α.weight 1) := by
      calc
        t * t ^ (α.weight 1 - 1) = t ^ (α.weight 1 - 1) * t := by ring
        _ = t ^ ((α.weight 1 - 1) + 1) := (pow_succ t (α.weight 1 - 1)).symm
        _ = t ^ (α.weight 1) := by
          have hpos : 0 < α.weight 1 := α.weight_pos 1
          congr 1
          omega
    rw [← hpow]
    ring
  have h2 : -t * d2 = g2 := by
    dsimp [d2, g2, coneWeight, gaussianDeriv]
    have hpow : t * t ^ (α.weight 2 - 1) = t ^ (α.weight 2) := by
      calc
        t * t ^ (α.weight 2 - 1) = t ^ (α.weight 2 - 1) * t := by ring
        _ = t ^ ((α.weight 2 - 1) + 1) := (pow_succ t (α.weight 2 - 1)).symm
        _ = t ^ (α.weight 2) := by
          have hpos : 0 < α.weight 2 := α.weight_pos 2
          congr 1
          omega
    rw [← hpow]
    ring
  change -t * deriv ((A * B) * C) t =
    g0 * B t * C t + A t * g1 * C t + A t * B t * g2
  rw [hderiv]
  have h0' : t * d0 = -g0 := by linarith
  have h1' : t * d1 = -g1 := by linarith
  have h2' : t * d2 = -g2 := by linarith
  calc
    -t * ((d0 * B t + A t * d1) * C t + (A * B) t * d2) =
        (-t * d0) * B t * C t + A t * (-t * d1) * C t +
          A t * B t * (-t * d2) := by
            simp only [Pi.mul_apply]
            ring
    _ = _ := by rw [h0, h1, h2]

/-- Finite-scale telescoping for the three-cone product.  It is valid without
excluding coordinate planes, because the smooth cone weight fills the
removable zero identically. -/
theorem calderon_coneProduct_interval
    (α : Anisotropy) (ξ : E3) (a b : ℝ)
    (ha : 0 < a) (hab : a ≤ b) :
    ∫ t in a..b,
      (((α.weight 0 : ℝ) * conePsi (t ^ (α.weight 0) * ξ 0) *
          gaussianDeriv (t ^ (α.weight 0) * ξ 0) ^ 2) *
        conePhi (t ^ (α.weight 1) * ξ 1) *
          conePhi (t ^ (α.weight 2) * ξ 2) +
      conePhi (t ^ (α.weight 0) * ξ 0) *
        ((α.weight 1 : ℝ) * conePsi (t ^ (α.weight 1) * ξ 1) *
          gaussianDeriv (t ^ (α.weight 1) * ξ 1) ^ 2) *
          conePhi (t ^ (α.weight 2) * ξ 2) +
      conePhi (t ^ (α.weight 0) * ξ 0) *
        conePhi (t ^ (α.weight 1) * ξ 1) *
          ((α.weight 2 : ℝ) * conePsi (t ^ (α.weight 2) * ξ 2) *
            gaussianDeriv (t ^ (α.weight 2) * ξ 2) ^ 2)) / t =
      coneProduct α ξ a - coneProduct α ξ b := by
  let A : ℝ → ℝ := conePhi ∘ fun s : ℝ ↦ s ^ (α.weight 0) * ξ 0
  let B : ℝ → ℝ := conePhi ∘ fun s : ℝ ↦ s ^ (α.weight 1) * ξ 1
  let C : ℝ → ℝ := conePhi ∘ fun s : ℝ ↦ s ^ (α.weight 2) * ξ 2
  let F : ℝ → ℝ := (A * B) * C
  let G : ℝ → ℝ := fun t ↦
    ((α.weight 0 : ℝ) * conePsi (t ^ (α.weight 0) * ξ 0) *
        gaussianDeriv (t ^ (α.weight 0) * ξ 0) ^ 2) *
      conePhi (t ^ (α.weight 1) * ξ 1) *
        conePhi (t ^ (α.weight 2) * ξ 2) +
    conePhi (t ^ (α.weight 0) * ξ 0) *
      ((α.weight 1 : ℝ) * conePsi (t ^ (α.weight 1) * ξ 1) *
        gaussianDeriv (t ^ (α.weight 1) * ξ 1) ^ 2) *
        conePhi (t ^ (α.weight 2) * ξ 2) +
    conePhi (t ^ (α.weight 0) * ξ 0) *
      conePhi (t ^ (α.weight 1) * ξ 1) *
        ((α.weight 2 : ℝ) * conePsi (t ^ (α.weight 2) * ξ 2) *
          gaussianDeriv (t ^ (α.weight 2) * ξ 2) ^ 2)
  have hA : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) A := by
    dsimp [A]
    exact conePhi_contDiff.comp
      ((contDiff_id.pow (α.weight 0)).mul contDiff_const)
  have hB : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) B := by
    dsimp [B]
    exact conePhi_contDiff.comp
      ((contDiff_id.pow (α.weight 1)).mul contDiff_const)
  have hC : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) C := by
    dsimp [C]
    exact conePhi_contDiff.comp
      ((contDiff_id.pow (α.weight 2)).mul contDiff_const)
  have hF : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) F := hA.mul hB |>.mul hC
  have hInt : IntervalIntegrable (deriv F) volume a b :=
    (hF.continuous_deriv (by norm_num)).intervalIntegrable a b
  have hFTC := intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le hab
    hF.continuous.continuousOn
    (fun s _ ↦ (hF.differentiable (by norm_num) s).hasDerivAt)
    hInt
  have hpoint (t : ℝ) (ht : t ∈ Set.Icc a b) : G t / t = -deriv F t := by
    have htpos : 0 < t := lt_of_lt_of_le ha ht.1
    have hderiv := neg_mul_deriv_coneProduct α ξ t
    change G t / t = -deriv F t
    rw [div_eq_iff htpos.ne']
    calc
      G t = -t * deriv (coneProduct α ξ) t := hderiv.symm
      _ = -deriv F t * t := by
        change -t * deriv F t = -deriv F t * t
        ring
  change (∫ t in a..b, G t / t) = F a - F b
  calc
    ∫ t in a..b, G t / t = ∫ t in a..b, -deriv F t := by
      apply intervalIntegral.integral_congr
      rw [Set.uIcc_of_le hab]
      exact fun t ht ↦ hpoint t ht
    _ = -(∫ t in a..b, deriv F t) := by
      rw [intervalIntegral.integral_neg]
    _ = F a - F b := by rw [hFTC]; ring

noncomputable def ModelScaleTail (a t : ℝ) : ℝ :=
  min (t ^ a) (t ^ (-a)) / t

theorem integrableOn_modelScaleTail
    {a : ℝ} (ha : 0 < a) :
    IntegrableOn (ModelScaleTail a) (Set.Ioi (0 : ℝ)) := by
  rw [← Set.Ioc_union_Ioi_eq_Ioi zero_le_one]
  apply IntegrableOn.union
  · refine IntegrableOn.congr_set_ae (t := Set.Ioo (0 : ℝ) 1) ?_
      (Filter.EventuallyEq.symm Ioo_ae_eq_Ioc)
    have hpower : IntegrableOn (fun t : ℝ ↦ t ^ (a - 1))
        (Set.Ioo (0 : ℝ) 1) :=
      (intervalIntegral.integrableOn_Ioo_rpow_iff zero_lt_one).2 (by linarith)
    apply Integrable.mono' hpower
    · unfold ModelScaleTail
      have hleft : ContinuousOn (fun t : ℝ ↦ t ^ a) (Set.Ioo (0 : ℝ) 1) :=
        continuousOn_id.rpow_const fun t ht ↦ Or.inl ht.1.ne'
      have hright : ContinuousOn (fun t : ℝ ↦ t ^ (-a)) (Set.Ioo (0 : ℝ) 1) :=
        continuousOn_id.rpow_const fun t ht ↦ Or.inl ht.1.ne'
      have hcont : ContinuousOn (ModelScaleTail a) (Set.Ioo (0 : ℝ) 1) :=
        (hleft.inf hright).div continuousOn_id (fun t ht ↦ ht.1.ne')
      exact hcont.aestronglyMeasurable measurableSet_Ioo
    · filter_upwards [ae_restrict_mem measurableSet_Ioo] with t ht
      have htpos : 0 < t := ht.1
      have hminnonneg : 0 ≤ min (t ^ a) (t ^ (-a)) :=
        le_min (Real.rpow_nonneg htpos.le _) (Real.rpow_nonneg htpos.le _)
      change |min (t ^ a) (t ^ (-a)) / t| ≤ t ^ (a - 1)
      rw [abs_of_nonneg (div_nonneg hminnonneg htpos.le)]
      calc
        min (t ^ a) (t ^ (-a)) / t ≤ t ^ a / t :=
          div_le_div_of_nonneg_right (min_le_left _ _) htpos.le
        _ = t ^ (a - 1) := by
          calc
            t ^ a / t = t ^ a / t ^ (1 : ℝ) := by rw [Real.rpow_one]
            _ = t ^ (a - 1) := (Real.rpow_sub htpos a 1).symm
  · have hpower : IntegrableOn (fun t : ℝ ↦ t ^ (-a - 1))
        (Set.Ioi (1 : ℝ)) :=
      integrableOn_Ioi_rpow_of_lt (by linarith) zero_lt_one
    apply Integrable.mono' hpower
    · unfold ModelScaleTail
      have hleft : ContinuousOn (fun t : ℝ ↦ t ^ a) (Set.Ioi (1 : ℝ)) :=
        continuousOn_id.rpow_const fun t ht ↦ Or.inl
          (lt_trans zero_lt_one (Set.mem_Ioi.mp ht)).ne'
      have hright : ContinuousOn (fun t : ℝ ↦ t ^ (-a)) (Set.Ioi (1 : ℝ)) :=
        continuousOn_id.rpow_const fun t ht ↦ Or.inl
          (lt_trans zero_lt_one (Set.mem_Ioi.mp ht)).ne'
      have hcont : ContinuousOn (ModelScaleTail a) (Set.Ioi (1 : ℝ)) :=
        (hleft.inf hright).div continuousOn_id
          (fun t ht ↦ (lt_trans zero_lt_one (Set.mem_Ioi.mp ht)).ne')
      exact hcont.aestronglyMeasurable measurableSet_Ioi
    · filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
      have htpos : 0 < t := lt_trans zero_lt_one (Set.mem_Ioi.mp ht)
      have hminnonneg : 0 ≤ min (t ^ a) (t ^ (-a)) :=
        le_min (Real.rpow_nonneg htpos.le _) (Real.rpow_nonneg htpos.le _)
      change |min (t ^ a) (t ^ (-a)) / t| ≤ t ^ (-a - 1)
      rw [abs_of_nonneg (div_nonneg hminnonneg htpos.le)]
      calc
        min (t ^ a) (t ^ (-a)) / t ≤ t ^ (-a) / t :=
          div_le_div_of_nonneg_right (min_le_right _ _) htpos.le
        _ = t ^ (-a - 1) := by
          calc
            t ^ (-a) / t = t ^ (-a) / t ^ (1 : ℝ) := by rw [Real.rpow_one]
            _ = t ^ (-a - 1) := (Real.rpow_sub htpos (-a) 1).symm

/-- The same small and large scale envelope is integrable for the source
logarithmic scale measure. -/
theorem integrableOn_modelScaleEnvelope_withDensity
    {a : ℝ} (ha : 0 < a) :
    IntegrableOn (fun t : ℝ ↦ min (t ^ a) (t ^ (-a))) (Set.Ioi (0 : ℝ))
      ((volume : Measure ℝ).withDensity cubeScaleDensity) := by
  have htop : ∀ᵐ t ∂(volume.restrict (Set.Ioi (0 : ℝ))),
      cubeScaleDensity t < ∞ := by
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    rw [cubeScaleDensity_eq_of_pos ht]
    exact ENNReal.ofReal_lt_top
  unfold IntegrableOn
  rw [restrict_withDensity measurableSet_Ioi]
  rw [integrable_withDensity_iff measurable_cubeScaleDensity htop]
  have heq : (fun t : ℝ ↦ min (t ^ a) (t ^ (-a)) *
      (cubeScaleDensity t).toReal) =ᵐ[volume.restrict (Set.Ioi (0 : ℝ))]
      ModelScaleTail a := by
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    rw [cubeScaleDensity_eq_of_pos ht,
      ENNReal.toReal_ofReal (inv_pos.mpr ht).le]
    unfold ModelScaleTail
    ring
  rw [integrable_congr heq]
  exact integrableOn_modelScaleTail ha

/-- A spatial absolute-integral estimate by the source scale envelope turns
directly into center--scale integrability.  This is the measure-theoretic
consumer of the small- and large-scale estimates in `lem:model_convergence`.
-/
theorem integrableOn_centerScale_of_spatial_scale_bound
    {a C : ℝ} (ha : 0 < a)
    (g : E3 × ℝ → ℝ)
    (hgmeas : AEStronglyMeasurable g cubeScaleMeasure)
    (hfiber : ∀ t : ℝ, 0 < t → Integrable (fun p : E3 ↦ g (p, t)))
    (hbound : ∀ t : ℝ, 0 < t →
      (∫ p : E3, ‖g (p, t)‖) ≤ C * min (t ^ a) (t ^ (-a))) :
    IntegrableOn g (Set.univ ×ˢ Set.Ioi (0 : ℝ)) cubeScaleMeasure := by
  let ν : Measure ℝ := (volume : Measure ℝ).withDensity cubeScaleDensity
  letI : SFinite ν := by
    dsimp only [ν]
    infer_instance
  unfold IntegrableOn cubeScaleMeasure
  change Integrable g (((volume : Measure E3).prod ν).restrict
    (Set.univ ×ˢ Set.Ioi (0 : ℝ)))
  rw [← Measure.prod_restrict]
  simp only [Measure.restrict_univ]
  have hmeas : AEStronglyMeasurable g
      ((volume : Measure E3).prod (ν.restrict (Set.Ioi (0 : ℝ)))) := by
    have hrestrict := hgmeas.restrict (s := Set.univ ×ˢ Set.Ioi (0 : ℝ))
    change AEStronglyMeasurable g (((volume : Measure E3).prod ν).restrict
      (Set.univ ×ˢ Set.Ioi (0 : ℝ))) at hrestrict
    rw [← Measure.prod_restrict] at hrestrict
    simpa only [Measure.restrict_univ] using hrestrict
  refine (integrable_prod_iff' hmeas).2 ⟨?_, ?_⟩
  · filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    exact hfiber t ht
  · have htail : Integrable (fun t : ℝ ↦
        C * min (t ^ a) (t ^ (-a))) (ν.restrict (Set.Ioi (0 : ℝ))) := by
      simpa only [ν, IntegrableOn] using
        (integrableOn_modelScaleEnvelope_withDensity ha).const_mul C
    have hTmeas : AEStronglyMeasurable (fun t : ℝ ↦
        ∫ p : E3, ‖g (p, t)‖)
        (ν.restrict (Set.Ioi (0 : ℝ))) := by
      simpa only [Prod.swap_prod_mk] using hmeas.norm.prod_swap.integral_prod_right'
    apply Integrable.mono' htail hTmeas
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    have hTnonneg : 0 ≤ ∫ p : E3, ‖g (p, t)‖ :=
      integral_nonneg fun p ↦ norm_nonneg (g (p, t))
    rw [Real.norm_eq_abs, abs_of_nonneg hTnonneg]
    exact hbound t ht

/-! ### The literal full-scale spatial model profile -/

/-- A real Schwartz four-tuple for the full model form. -/
abbrev ModelSchwartzInput := Fin 4 → SchwartzMap E3 ℝ

/-- The unscaled first and second coordinate kernel
`\(\mathsf g * \varphi_{1,u}\)`. -/
noncomputable def ModelLowKernel (u w : ℝ) : ℝ :=
  ∫ z : ℝ, gaussian z * conePhiPhysicalReal (w - z - u)

/-- The unscaled third coordinate kernel
`\(\mathsf h * \mathsf h * \psi_{1,u}\)`. -/
noncomputable def ModelThirdKernel (u w : ℝ) : ℝ :=
  ∫ z : ℝ, gaussianDeriv z * modelThirdKernel (-u) 1 0 (w - z)

/-- One coordinate convolution in the source convention, written after the
change from the sampled coordinate to its displacement from `x`. -/
noncomputable def ModelCoordinateConvolution
    (i : Fin 3) (f : E3 → ℝ) (k : ℝ → ℝ) (s : ℝ) (x : E3) : ℝ :=
  ∫ r : ℝ, f (x - r • Anisotropy.coordinateDirection i) * kernelDilate k s r

/-- The spatial integrand in the source's unexpanded model form at one
positive scale.  The three coordinate kernels are exactly the kernels in
Definition `def:model`; the scale coefficient is deliberately not included. -/
noncomputable def ModelSpatialIntegrand
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput)
    (t : ℝ) (x : E3) : ℝ :=
  F 0 x *
    ModelCoordinateConvolution 0 (F 1)
      (ModelLowKernel (u 0)) (t ^ α.weight 0) x *
    ModelCoordinateConvolution 1 (F 2)
      (ModelLowKernel (u 1)) (t ^ α.weight 1) x *
    ModelCoordinateConvolution 2 (F 3)
      (ModelThirdKernel (u 2)) (t ^ α.weight 2) x

/-- The spatially integrated scale profile in `lem:model_convergence`. -/
noncomputable def ModelSpatialProfile
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ) : ℝ :=
  ∫ x : E3, ModelSpatialIntegrand α u F t x

/-- The source full-scale model form, once the spatial profile has been
formed. -/
noncomputable def ModelFullForm
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput) : ℝ :=
  ∫ t in Set.Ioi (0 : ℝ), c t * ModelSpatialProfile α u F t
    ∂((volume : Measure ℝ).withDensity cubeScaleDensity)

/-- The finite dyadic scale truncation used before taking the full-scale
limit. -/
noncomputable def ModelScaleTruncation
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (N : ℕ) : ℝ :=
  ∫ t in truncationScaleSet N, c t * ModelSpatialProfile α u F t
    ∂((volume : Measure ℝ).withDensity cubeScaleDensity)

/-- The scale intervals in the finite source truncations exhaust the
positive half-line. -/
theorem iUnion_truncationScaleSet :
    (⋃ N : ℕ, truncationScaleSet N) = Set.Ioi (0 : ℝ) := by
  apply Set.Subset.antisymm
  · rintro t ht
    rcases Set.mem_iUnion.1 ht with ⟨N, ht⟩
    change t ∈ Set.Ioc ((2 : ℝ) ^ (-(N : ℤ) - 1)) ((2 : ℝ) ^ (N : ℤ)) at ht
    exact lt_trans (zpow_pos (by norm_num) _) ht.1
  · intro t ht
    rcases exists_mem_truncationScaleSet ht with ⟨N, hN⟩
    exact Set.mem_iUnion.2 ⟨N, hN⟩

/-- The source small and large scale estimate makes the full profile
integrable against `dt / t`; this contains no integrability premise. -/
theorem integrableOn_modelScaleProfile_of_bound
    {a C : ℝ} (ha : 0 < a)
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hmeas : AEStronglyMeasurable
      (fun t : ℝ ↦ c t * ModelSpatialProfile α u F t)
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))))
    (hprofile : ∀ t : ℝ, 0 < t →
      |ModelSpatialProfile α u F t| ≤ C * min (t ^ a) (t ^ (-a))) :
    IntegrableOn (fun t : ℝ ↦ c t * ModelSpatialProfile α u F t)
      (Set.Ioi (0 : ℝ)) ((volume : Measure ℝ).withDensity cubeScaleDensity) := by
  have htail : Integrable (fun t : ℝ ↦
      C * min (t ^ a) (t ^ (-a)))
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))) := by
    simpa only [IntegrableOn] using
      (integrableOn_modelScaleEnvelope_withDensity ha).const_mul C
  unfold IntegrableOn
  apply Integrable.mono' htail hmeas
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
  rw [Real.norm_eq_abs, abs_mul]
  calc
    |c t| * |ModelSpatialProfile α u F t| ≤
        1 * |ModelSpatialProfile α u F t| :=
      mul_le_mul_of_nonneg_right (hc t) (abs_nonneg _)
    _ = |ModelSpatialProfile α u F t| := one_mul _
    _ ≤ C * min (t ^ a) (t ^ (-a)) := hprofile t ht

/-- The literal finite dyadic scale truncations converge to the full model
form once the source small and large scale profile estimate is available. -/
theorem tendsto_modelScaleTruncation_of_bound
    {a C : ℝ} (ha : 0 < a)
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hmeas : AEStronglyMeasurable
      (fun t : ℝ ↦ c t * ModelSpatialProfile α u F t)
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))))
    (hprofile : ∀ t : ℝ, 0 < t →
      |ModelSpatialProfile α u F t| ≤ C * min (t ^ a) (t ^ (-a))) :
    Tendsto (fun N ↦ ModelScaleTruncation α u c F N) atTop
      (𝓝 (ModelFullForm α u c F)) := by
  let ν : Measure ℝ := (volume : Measure ℝ).withDensity cubeScaleDensity
  let g : ℝ → ℝ := fun t ↦ c t * ModelSpatialProfile α u F t
  let S : ℕ → Set ℝ := truncationScaleSet
  have hint : IntegrableOn g (Set.Ioi (0 : ℝ)) ν := by
    simpa only [g, ν] using integrableOn_modelScaleProfile_of_bound
      ha α u c F hc hmeas hprofile
  have hSmeas : ∀ N : ℕ, MeasurableSet (S N) := by
    intro N
    exact measurableSet_Ioc
  have hSmono : Monotone S := by
    simpa only [S] using monotone_truncationScaleSet
  have hSunion : (⋃ N : ℕ, S N) = Set.Ioi (0 : ℝ) := by
    simpa only [S] using iUnion_truncationScaleSet
  have hlim := tendsto_setIntegral_of_monotone
    (μ := ν) (f := g) hSmeas hSmono (by rw [hSunion]; exact hint)
  rw [hSunion] at hlim
  simpa only [ModelScaleTruncation, ModelFullForm, S, g, ν] using hlim

/-! ### Coefficient cutoffs and finite-forest transfer -/

/-- Restrict a scale coefficient to a measurable scale set.  This is the
literal replacement `c ↦ c 1_A` used to transfer finite-forest estimates to
scale truncations. -/
noncomputable def RestrictScaleCoefficient
    (c : ℝ → ℝ) (A : Set ℝ) : ℝ → ℝ :=
  A.indicator c

/-- Restricting a coefficient preserves the unit coefficient hypothesis. -/
theorem abs_restrictScaleCoefficient_le_one
    (c : ℝ → ℝ) (A : Set ℝ) (hc : ∀ t : ℝ, |c t| ≤ 1) :
    ∀ t : ℝ, |RestrictScaleCoefficient c A t| ≤ 1 := by
  intro t
  by_cases ht : t ∈ A
  · rw [RestrictScaleCoefficient, Set.indicator_of_mem ht]
    exact hc t
  · rw [RestrictScaleCoefficient, Set.indicator_of_notMem ht]
    norm_num

/-- Every source dyadic truncation scale is positive. -/
theorem truncationScaleSet_subset_positive (N : ℕ) :
    truncationScaleSet N ⊆ Set.Ioi (0 : ℝ) := by
  intro t ht
  change t ∈ Set.Ioc ((2 : ℝ) ^ (-(N : ℤ) - 1)) ((2 : ℝ) ^ (N : ℤ)) at ht
  exact lt_trans (zpow_pos (by norm_num) _) ht.1

/-- The profile integral on any measurable positive scale set is the full
profile form with the coefficient cut off to that set. -/
theorem setIntegral_modelScaleProfile_eq_modelFullForm_restrict
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (A : Set ℝ) (hAmeas : MeasurableSet A) (hApos : A ⊆ Set.Ioi (0 : ℝ)) :
    (∫ t in A, c t * ModelSpatialProfile α u F t
      ∂((volume : Measure ℝ).withDensity cubeScaleDensity)) =
      ModelFullForm α u (RestrictScaleCoefficient c A) F := by
  let P : ℝ → ℝ := ModelSpatialProfile α u F
  unfold ModelFullForm
  change (∫ t in A, c t * P t
      ∂((volume : Measure ℝ).withDensity cubeScaleDensity)) =
    ∫ t in Set.Ioi (0 : ℝ),
      RestrictScaleCoefficient c A t * P t
      ∂((volume : Measure ℝ).withDensity cubeScaleDensity)
  rw [← MeasureTheory.integral_indicator hAmeas,
    ← MeasureTheory.integral_indicator measurableSet_Ioi]
  apply integral_congr_ae
  filter_upwards [] with t
  by_cases htA : t ∈ A
  · have htpos : t ∈ Set.Ioi (0 : ℝ) := hApos htA
    rw [Set.indicator_of_mem htA, Set.indicator_of_mem htpos,
      RestrictScaleCoefficient, Set.indicator_of_mem htA]
  · by_cases htpos : t ∈ Set.Ioi (0 : ℝ)
    · rw [Set.indicator_of_notMem htA, Set.indicator_of_mem htpos,
        RestrictScaleCoefficient, Set.indicator_of_notMem htA]
      ring
    · rw [Set.indicator_of_notMem htA, Set.indicator_of_notMem htpos]

/-- Every positive measurable scale restriction inherits a uniform bound that
holds for all coefficients of modulus at most one. -/
theorem setIntegral_modelScaleProfile_bound_of_uniform_coefficient_bound
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (B : ℝ) (A : Set ℝ) (hAmeas : MeasurableSet A)
    (hApos : A ⊆ Set.Ioi (0 : ℝ))
    (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hforest : ∀ d : ℝ → ℝ, (∀ t : ℝ, |d t| ≤ 1) →
      |ModelFullForm α u d F| ≤ B) :
    |∫ t in A, c t * ModelSpatialProfile α u F t
      ∂((volume : Measure ℝ).withDensity cubeScaleDensity)| ≤ B := by
  rw [setIntegral_modelScaleProfile_eq_modelFullForm_restrict
    α u c F A hAmeas hApos]
  exact hforest (RestrictScaleCoefficient c A)
    (abs_restrictScaleCoefficient_le_one c A hc)

/-- The literal finite interval form \(\Lambda^{a,b}_{u,c}\), with the
endpoint convention `Ioc`; endpoints have no analytic role in the subsequent
integrability argument. -/
noncomputable def ModelScaleIntervalTruncation
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (a b : ℝ) : ℝ :=
  ∫ t in Set.Ioc a b, c t * ModelSpatialProfile α u F t
    ∂((volume : Measure ℝ).withDensity cubeScaleDensity)

/-- Replacing the coefficient by its interval cutoff realizes the literal
interval form as a full profile form. -/
theorem modelScaleIntervalTruncation_eq_modelFullForm_restrict
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    {a b : ℝ} (ha : 0 ≤ a) :
    ModelScaleIntervalTruncation α u c F a b =
      ModelFullForm α u
        (RestrictScaleCoefficient c (Set.Ioc a b)) F := by
  unfold ModelScaleIntervalTruncation
  apply setIntegral_modelScaleProfile_eq_modelFullForm_restrict
  · exact measurableSet_Ioc
  · intro t ht
    exact lt_of_le_of_lt ha ht.1

/-- The finite-forest estimate transfers verbatim to every positive scale
interval, as required before the `a ↓ 0`, `b ↑ ∞` limit. -/
theorem modelScaleIntervalTruncation_bound_of_uniform_coefficient_bound
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (B : ℝ) {a b : ℝ} (ha : 0 ≤ a)
    (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hforest : ∀ d : ℝ → ℝ, (∀ t : ℝ, |d t| ≤ 1) →
      |ModelFullForm α u d F| ≤ B) :
    |ModelScaleIntervalTruncation α u c F a b| ≤ B := by
  rw [modelScaleIntervalTruncation_eq_modelFullForm_restrict
    α u c F ha]
  exact hforest (RestrictScaleCoefficient c (Set.Ioc a b))
    (abs_restrictScaleCoefficient_le_one c (Set.Ioc a b) hc)

/-- Cutting the coefficient to the dyadic scale band converts the full
profile form exactly into its finite scale truncation.  No expanded-fiber
global integrability is used here. -/
theorem modelScaleTruncation_eq_modelFullForm_restrict
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (N : ℕ) :
    ModelScaleTruncation α u c F N =
      ModelFullForm α u
        (RestrictScaleCoefficient c (truncationScaleSet N)) F := by
  unfold ModelScaleTruncation
  exact setIntegral_modelScaleProfile_eq_modelFullForm_restrict
    α u c F (truncationScaleSet N) measurableSet_Ioc
    (truncationScaleSet_subset_positive N)

/-- A uniform finite-forest bound for all bounded coefficients transfers
unchanged to each literal finite dyadic scale truncation.  The conclusion is
the bound transfer in `lem:model_convergence`; the analytic profile estimate
is only needed separately to pass to the full-scale limit. -/
theorem modelScaleTruncation_bound_of_uniform_coefficient_bound
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (B : ℝ) (N : ℕ)
    (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hforest : ∀ d : ℝ → ℝ, (∀ t : ℝ, |d t| ≤ 1) →
      |ModelFullForm α u d F| ≤ B) :
    |ModelScaleTruncation α u c F N| ≤ B := by
  rw [modelScaleTruncation_eq_modelFullForm_restrict]
  exact hforest (RestrictScaleCoefficient c (truncationScaleSet N))
    (abs_restrictScaleCoefficient_le_one c (truncationScaleSet N) hc)

/-- The scale-profile convergence turns a uniform family of finite
truncation bounds into the full-scale model bound.  This is the limiting step
in `lem:model_convergence`, and it never asks for absolute integrability of
the fully expanded auxiliary-fiber expression. -/
theorem modelFullForm_bound_of_profile_and_uniform_truncation_bound
    {a C : ℝ} (ha : 0 < a)
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (B : ℝ)
    (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hmeas : AEStronglyMeasurable
      (fun t : ℝ ↦ c t * ModelSpatialProfile α u F t)
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))))
    (hprofile : ∀ t : ℝ, 0 < t →
      |ModelSpatialProfile α u F t| ≤ C * min (t ^ a) (t ^ (-a)))
    (htrunc : ∀ N : ℕ, |ModelScaleTruncation α u c F N| ≤ B) :
    |ModelFullForm α u c F| ≤ B := by
  have hlim := tendsto_modelScaleTruncation_of_bound
    ha α u c F hc hmeas hprofile
  have hlimabs : Tendsto (fun N ↦ |ModelScaleTruncation α u c F N|)
      atTop (𝓝 |ModelFullForm α u c F|) := by
    exact (continuous_abs.tendsto _).comp hlim
  apply le_of_tendsto hlimabs
  exact Filter.Eventually.of_forall htrunc

/-- In particular, a finite-forest estimate uniform over bounded
coefficients transfers first to all finite dyadic truncations and then to the
full model form. -/
theorem modelFullForm_bound_of_profile_and_uniform_forest_bound
    {a C : ℝ} (ha : 0 < a)
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (B : ℝ)
    (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hmeas : AEStronglyMeasurable
      (fun t : ℝ ↦ c t * ModelSpatialProfile α u F t)
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))))
    (hprofile : ∀ t : ℝ, 0 < t →
      |ModelSpatialProfile α u F t| ≤ C * min (t ^ a) (t ^ (-a)))
    (hforest : ∀ d : ℝ → ℝ, (∀ t : ℝ, |d t| ≤ 1) →
      |ModelFullForm α u d F| ≤ B) :
    |ModelFullForm α u c F| ≤ B := by
  apply modelFullForm_bound_of_profile_and_uniform_truncation_bound
    ha α u c F B hc hmeas hprofile
  intro N
  exact modelScaleTruncation_bound_of_uniform_coefficient_bound
    α u c F B N hc hforest

/-- At a scale at which every coordinate lies in the low-frequency plateau,
the three-cone product has its full Calderón mass. -/
theorem coneProduct_eq_cPsi_pow_of_small
    (α : Anisotropy) (ξ : E3) (t : ℝ)
    (h : ∀ i : Fin 3, |t ^ (α.weight i) * ξ i| ≤ 1) :
    coneProduct α ξ t = cPsi ^ 3 := by
  change (conePhi (t ^ (α.weight 0) * ξ 0) *
      conePhi (t ^ (α.weight 1) * ξ 1)) *
        conePhi (t ^ (α.weight 2) * ξ 2) = cPsi ^ 3
  rw [conePhi_eq_cPsi_of_abs_le_one (h 0),
    conePhi_eq_cPsi_of_abs_le_one (h 1),
    conePhi_eq_cPsi_of_abs_le_one (h 2)]
  ring

/-- If one coordinate lies outside the high-frequency support, the product
cutoff vanishes. -/
theorem coneProduct_eq_zero_of_large
    (α : Anisotropy) (ξ : E3) (t : ℝ)
    (h : ∃ i : Fin 3, 2 ≤ |t ^ (α.weight i) * ξ i|) :
    coneProduct α ξ t = 0 := by
  rcases h with ⟨i, hi⟩
  fin_cases i
  · have hi' : 2 ≤ |t ^ (α.weight 0) * ξ 0| := by simpa using hi
    change (conePhi (t ^ (α.weight 0) * ξ 0) *
      conePhi (t ^ (α.weight 1) * ξ 1)) *
        conePhi (t ^ (α.weight 2) * ξ 2) = 0
    rw [conePhi_eq_zero_of_two_le_abs hi']
    ring
  · have hi' : 2 ≤ |t ^ (α.weight 1) * ξ 1| := by simpa using hi
    change (conePhi (t ^ (α.weight 0) * ξ 0) *
      conePhi (t ^ (α.weight 1) * ξ 1)) *
        conePhi (t ^ (α.weight 2) * ξ 2) = 0
    rw [conePhi_eq_zero_of_two_le_abs hi']
    ring
  · have hi' : 2 ≤ |t ^ (α.weight 2) * ξ 2| := by simpa using hi
    change (conePhi (t ^ (α.weight 0) * ξ 0) *
      conePhi (t ^ (α.weight 1) * ξ 1)) *
        conePhi (t ^ (α.weight 2) * ξ 2) = 0
    rw [conePhi_eq_zero_of_two_le_abs hi']
    ring

/-- The finite interval form of the cone identity once its natural endpoints
have been chosen. -/
theorem calderon_coneProduct_interval_of_endpoints
    (α : Anisotropy) (ξ : E3) (a b : ℝ)
    (ha : 0 < a) (hab : a ≤ b)
    (hsmall : coneProduct α ξ a = cPsi ^ 3)
    (hlarge : coneProduct α ξ b = 0) :
    ∫ t in a..b,
      (((α.weight 0 : ℝ) * conePsi (t ^ (α.weight 0) * ξ 0) *
          gaussianDeriv (t ^ (α.weight 0) * ξ 0) ^ 2) *
        conePhi (t ^ (α.weight 1) * ξ 1) *
          conePhi (t ^ (α.weight 2) * ξ 2) +
      conePhi (t ^ (α.weight 0) * ξ 0) *
        ((α.weight 1 : ℝ) * conePsi (t ^ (α.weight 1) * ξ 1) *
          gaussianDeriv (t ^ (α.weight 1) * ξ 1) ^ 2) *
          conePhi (t ^ (α.weight 2) * ξ 2) +
      conePhi (t ^ (α.weight 0) * ξ 0) *
        conePhi (t ^ (α.weight 1) * ξ 1) *
          ((α.weight 2 : ℝ) * conePsi (t ^ (α.weight 2) * ξ 2) *
            gaussianDeriv (t ^ (α.weight 2) * ξ 2) ^ 2)) / t = cPsi ^ 3 := by
  rw [calderon_coneProduct_interval α ξ a b ha hab, hsmall, hlarge]
  ring

/-- Every nonzero three-frequency has positive finite scales at which the
three-cone product respectively equals its full mass and vanishes. -/
theorem exists_coneProduct_endpoints
    (α : Anisotropy) (ξ : E3) (hξ : ξ ≠ 0) :
    ∃ a b : ℝ, 0 < a ∧ a ≤ b ∧
      coneProduct α ξ a = cPsi ^ 3 ∧ coneProduct α ξ b = 0 := by
  obtain ⟨i, hξi⟩ : ∃ i : Fin 3, ξ i ≠ 0 := by
    by_contra h
    apply hξ
    ext j
    apply not_ne_iff.mp
    intro hj
    exact h ⟨j, hj⟩
  let R : ℝ := max |ξ 0| (max |ξ 1| |ξ 2|)
  have hRnonneg : 0 ≤ R := by
    dsimp [R]
    positivity
  have hR (j : Fin 3) : |ξ j| ≤ R := by
    fin_cases j
    · exact le_max_left _ _
    · exact (le_max_left _ _).trans (le_max_right _ _)
    · exact (le_max_right _ _).trans (le_max_right _ _)
  let a : ℝ := 1 / (1 + R)
  have hden : 0 < 1 + R := by linarith
  have ha : 0 < a := by
    dsimp [a]
    exact div_pos zero_lt_one hden
  have haone : a ≤ 1 := by
    dsimp [a]
    apply (div_le_iff₀ hden).mpr
    linarith
  have haR : a * R ≤ 1 := by
    calc
      a * R = R / (1 + R) := by
        dsimp [a]
        ring
      _ ≤ 1 := (div_le_iff₀ hden).mpr (by linarith)
  have hsmall : ∀ j : Fin 3, |a ^ (α.weight j) * ξ j| ≤ 1 := by
    intro j
    have hpow : a ^ (α.weight j) ≤ a :=
      pow_le_of_le_one ha.le haone (Nat.ne_zero_of_lt (α.weight_pos j))
    rw [abs_mul, abs_of_nonneg (pow_nonneg ha.le _)]
    calc
      a ^ (α.weight j) * |ξ j| ≤ a * |ξ j| :=
        mul_le_mul_of_nonneg_right hpow (abs_nonneg _)
      _ ≤ a * R := mul_le_mul_of_nonneg_left (hR j) ha.le
      _ ≤ 1 := haR
  let b : ℝ := max 1 (2 / |ξ i|)
  have hb_one : 1 ≤ b := le_max_left _ _
  have hb : 0 < b := lt_of_lt_of_le zero_lt_one hb_one
  have hab : a ≤ b := haone.trans hb_one
  have habs : 0 < |ξ i| := abs_pos.mpr hξi
  have hpowb : b ≤ b ^ (α.weight i) :=
    by
      simpa only [pow_one] using
        (pow_le_pow_right₀ hb_one
          (Nat.one_le_iff_ne_zero.mpr (Nat.ne_zero_of_lt (α.weight_pos i))))
  have hlargei : 2 ≤ |b ^ (α.weight i) * ξ i| := by
    rw [abs_mul, abs_of_nonneg (pow_nonneg hb.le _)]
    calc
      2 ≤ b * |ξ i| :=
        (div_le_iff₀ habs).mp (le_max_right _ _)
      _ ≤ b ^ (α.weight i) * |ξ i| :=
        mul_le_mul_of_nonneg_right hpowb (abs_nonneg _)
  refine ⟨a, b, ha, hab,
    coneProduct_eq_cPsi_pow_of_small α ξ a hsmall, ?_⟩
  exact coneProduct_eq_zero_of_large α ξ b ⟨i, hlargei⟩

/-- The finite positive scale interval can always be chosen to recover the
entire three-cone Calderón mass at a nonzero frequency. -/
theorem exists_calderon_coneProduct_interval
    (α : Anisotropy) (ξ : E3) (hξ : ξ ≠ 0) :
    ∃ a b : ℝ, 0 < a ∧ a ≤ b ∧
      ∫ t in a..b,
        (((α.weight 0 : ℝ) * conePsi (t ^ (α.weight 0) * ξ 0) *
            gaussianDeriv (t ^ (α.weight 0) * ξ 0) ^ 2) *
          conePhi (t ^ (α.weight 1) * ξ 1) *
            conePhi (t ^ (α.weight 2) * ξ 2) +
        conePhi (t ^ (α.weight 0) * ξ 0) *
          ((α.weight 1 : ℝ) * conePsi (t ^ (α.weight 1) * ξ 1) *
            gaussianDeriv (t ^ (α.weight 1) * ξ 1) ^ 2) *
            conePhi (t ^ (α.weight 2) * ξ 2) +
        conePhi (t ^ (α.weight 0) * ξ 0) *
          conePhi (t ^ (α.weight 1) * ξ 1) *
            ((α.weight 2 : ℝ) * conePsi (t ^ (α.weight 2) * ξ 2) *
              gaussianDeriv (t ^ (α.weight 2) * ξ 2) ^ 2)) / t = cPsi ^ 3 := by
  obtain ⟨a, b, ha, hab, hsmall, hlarge⟩ :=
    exists_coneProduct_endpoints α ξ hξ
  exact ⟨a, b, ha, hab,
    calderon_coneProduct_interval_of_endpoints
      α ξ a b ha hab hsmall hlarge⟩

/-- The zero multiplier scale forces the multiplier itself to vanish, so the
zero case in the cone decomposition does not need any division by `M`. -/
theorem multiplier_eq_zero_of_M_eq_zero
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m) (hM : M = 0) :
    m = 0 := by
  funext ξ
  apply norm_eq_zero.mp
  apply le_antisymm
  · calc
      ‖m ξ‖ ≤ M := hm.norm_le_all ξ
      _ = 0 := hM
  · exact norm_nonneg _

/-- Consequently the literal multiplier form is zero in the zero-scale
case. -/
theorem multiplierForm_eq_zero_of_M_eq_zero
    (α : Anisotropy) (M : ℝ) (m : E3 → ℂ)
    (hm : Anisotropy.IsAnisotropicMultiplier α M m) (hM : M = 0)
    (f₀ f₁ f₂ f₃ : Schwartz3) :
    multiplierForm m f₀ f₁ f₂ f₃ = 0 := by
  rw [multiplier_eq_zero_of_M_eq_zero α M m hm hM]
  simp [multiplierForm]

/-- A mode family with the coefficient decay produced by the Fourier-series
step is absolutely summable on the standard three-dimensional lattice. -/
theorem summable_standardMode_of_sourceWeight_decay
    {E : Type*} [NormedAddCommGroup E] [CompleteSpace E]
    (F : standardModeLattice → E) (C : ℝ)
    (hF : ∀ z : standardModeLattice,
      ‖F z‖ ≤ C * (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ)) :
    Summable F := by
  apply Summable.of_norm_bounded
  · exact (summable_standardMode_sourceWeight_inv).mul_left C
  · intro z
    exact hF z

/-- The three active-coordinate mode sums remain summable under a common
degree-ten coefficient bound. -/
theorem summable_threeCoordinateModes_of_sourceWeight_decay
    {E : Type*} [NormedAddCommGroup E] [CompleteSpace E]
    (F : Fin 3 → standardModeLattice → E) (C : ℝ)
    (hF : ∀ i z, ‖F i z‖ ≤ C * (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ)) :
    Summable (fun z ↦ F 0 z + F 1 z + F 2 z) := by
  let g : standardModeLattice → ℝ := fun z ↦
    (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ)
  apply Summable.of_norm_bounded ((summable_standardMode_sourceWeight_inv).mul_left (3 * C))
  intro z
  change ‖F 0 z + F 1 z + F 2 z‖ ≤ (3 * C) * g z
  calc
    ‖F 0 z + F 1 z + F 2 z‖ ≤ ‖F 0 z + F 1 z‖ + ‖F 2 z‖ := norm_add_le _ _
    _ ≤ (‖F 0 z‖ + ‖F 1 z‖) + ‖F 2 z‖ := by
      gcongr
      exact norm_add_le _ _
    _ ≤ (C * g z + C * g z) + C * g z := by
      gcongr
      · exact hF 0 z
      · exact hF 1 z
      · exact hF 2 z
    _ = (3 * C) * g z := by ring

/-- Coefficient decay of order 110 and model growth of order 100 leave the
summable order-10 lattice tail required in the final cone summation. -/
theorem summable_threeCoordinateModeProducts_of_decay
    (a b : Fin 3 → standardModeLattice → ℂ) (C D : ℝ)
    (hC : 0 ≤ C) (hD : 0 ≤ D)
    (ha : ∀ i z, ‖a i z‖ ≤
      C * (sourceWeight (z : E3))⁻¹ ^ (110 : ℕ))
    (hb : ∀ i z, ‖b i z‖ ≤
      D * sourceWeight (z : E3) ^ (100 : ℕ)) :
    Summable (fun z ↦ ∑ i : Fin 3, a i z * b i z) := by
  let g : standardModeLattice → ℝ := fun z ↦
    (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ)
  apply Summable.of_norm_bounded
    ((summable_standardMode_sourceWeight_inv).mul_left (3 * C * D))
  intro z
  have hwpos : 0 < sourceWeight (z : E3) := sourceWeight_pos _
  have hwne : sourceWeight (z : E3) ≠ 0 := hwpos.ne'
  have hpow :
      (sourceWeight (z : E3))⁻¹ ^ (110 : ℕ) *
          sourceWeight (z : E3) ^ (100 : ℕ) = g z := by
    dsimp [g]
    field_simp [hwne]
  have hterm (i : Fin 3) :
      ‖a i z * b i z‖ ≤ C * D * g z := by
    rw [norm_mul]
    calc
      ‖a i z‖ * ‖b i z‖ ≤
          (C * (sourceWeight (z : E3))⁻¹ ^ (110 : ℕ)) *
            (D * sourceWeight (z : E3) ^ (100 : ℕ)) := by
              apply mul_le_mul (ha i z) (hb i z) (norm_nonneg _)
              exact mul_nonneg hC (pow_nonneg (inv_nonneg.mpr hwpos.le) _)
      _ = C * D *
          ((sourceWeight (z : E3))⁻¹ ^ (110 : ℕ) *
            sourceWeight (z : E3) ^ (100 : ℕ)) := by ring
      _ = C * D * g z := by rw [hpow]
  calc
    ‖∑ i : Fin 3, a i z * b i z‖ ≤ ∑ i : Fin 3, ‖a i z * b i z‖ :=
      by simpa using
        (norm_sum_le (Finset.univ : Finset (Fin 3)) (fun i ↦ a i z * b i z))
    _ ≤ ∑ _i : Fin 3, C * D * g z := by
      exact Finset.sum_le_sum fun i hi ↦ hterm i
    _ = (3 * C * D) * g z := by
      simp [Fin.sum_univ_succ]
      ring

/-- The preceding absolutely convergent mode sum has the explicit final
majorant needed after a Fourier-series form decomposition. -/
theorem norm_tsum_threeCoordinateModeProducts_le_of_decay
    (a b : Fin 3 → standardModeLattice → ℂ) (C D : ℝ)
    (hC : 0 ≤ C) (hD : 0 ≤ D)
    (ha : ∀ i z, ‖a i z‖ ≤
      C * (sourceWeight (z : E3))⁻¹ ^ (110 : ℕ))
    (hb : ∀ i z, ‖b i z‖ ≤
      D * sourceWeight (z : E3) ^ (100 : ℕ)) :
    ‖∑' z, ∑ i : Fin 3, a i z * b i z‖ ≤
      (3 * C * D) * ∑' z : standardModeLattice,
        (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ) := by
  let F : standardModeLattice → ℂ := fun z ↦ ∑ i : Fin 3, a i z * b i z
  let g : standardModeLattice → ℝ := fun z ↦
    (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ)
  have hF : Summable F := by
    exact summable_threeCoordinateModeProducts_of_decay
      a b C D hC hD ha hb
  have hg : Summable g := by
    exact summable_standardMode_sourceWeight_inv
  have hpoint (z : standardModeLattice) : ‖F z‖ ≤ (3 * C * D) * g z := by
    dsimp only [F, g]
    have hwpos : 0 < sourceWeight (z : E3) := sourceWeight_pos _
    have hwne : sourceWeight (z : E3) ≠ 0 := hwpos.ne'
    have hpow :
        (sourceWeight (z : E3))⁻¹ ^ (110 : ℕ) *
            sourceWeight (z : E3) ^ (100 : ℕ) =
          (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ) := by
      field_simp [hwne]
    have hterm (i : Fin 3) :
        ‖a i z * b i z‖ ≤ C * D *
          (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ) := by
      rw [norm_mul]
      calc
        ‖a i z‖ * ‖b i z‖ ≤
            (C * (sourceWeight (z : E3))⁻¹ ^ (110 : ℕ)) *
              (D * sourceWeight (z : E3) ^ (100 : ℕ)) := by
                apply mul_le_mul (ha i z) (hb i z) (norm_nonneg _)
                exact mul_nonneg hC (pow_nonneg (inv_nonneg.mpr hwpos.le) _)
        _ = C * D *
            ((sourceWeight (z : E3))⁻¹ ^ (110 : ℕ) *
              sourceWeight (z : E3) ^ (100 : ℕ)) := by ring
        _ = _ := by rw [hpow]
    calc
      ‖∑ i : Fin 3, a i z * b i z‖ ≤ ∑ i : Fin 3, ‖a i z * b i z‖ :=
        by simpa using
          (norm_sum_le (Finset.univ : Finset (Fin 3)) (fun i ↦ a i z * b i z))
      _ ≤ ∑ _i : Fin 3, C * D *
          (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ) := by
        exact Finset.sum_le_sum fun i hi ↦ hterm i
      _ = (3 * C * D) *
          (sourceWeight (z : E3))⁻¹ ^ (10 : ℕ) := by
        simp [Fin.sum_univ_succ]
        ring
  calc
    ‖∑' z, ∑ i : Fin 3, a i z * b i z‖ = ‖∑' z, F z‖ := by rfl
    _ ≤ ∑' z, ‖F z‖ := norm_tsum_le_tsum_norm hF.norm
    _ ≤ ∑' z, (3 * C * D) * g z :=
      hF.norm.tsum_le_tsum hpoint (hg.mul_left _)
    _ = (3 * C * D) * ∑' z, g z := hg.tsum_mul_left _

/-- A real Schwartz tuple, viewed as the bounded continuous input required by
the finite active stopping-forest theorem. -/
abbrev InitialModelSchwartzInput := Fin 4 → SchwartzMap E3 ℝ

noncomputable def InitialModelRealInput
    (F : InitialModelSchwartzInput) : ModelRealInput :=
  fun j ↦ F j

/-- The continuity hypotheses in the finite forest theorem are automatic for
real Schwartz inputs. -/
theorem initialModelRealInput_continuous
    (F : InitialModelSchwartzInput) :
    ∀ j : Fin 4, Continuous (InitialModelRealInput F j) := by
  intro j
  exact (F j).continuous

/-- The uniform boundedness hypotheses in the finite forest theorem are
automatic for real Schwartz inputs. -/
theorem initialModelRealInput_bounded
    (F : InitialModelSchwartzInput) :
    ∀ j : Fin 4, ∃ B : ℝ, 0 ≤ B ∧
      ∀ y : E3, |InitialModelRealInput F j y| ≤ B := by
  intro j
  refine ⟨SchwartzMap.seminorm ℝ 0 0 (F j), ?_, ?_⟩
  · exact (norm_nonneg ((F j) 0)).trans
      (SchwartzMap.norm_le_seminorm ℝ (F j) (0 : E3))
  · intro y
    simpa only [InitialModelRealInput, Real.norm_eq_abs] using
      (SchwartzMap.norm_le_seminorm ℝ (F j) y)

/-- The four scalar dyadic level sums left by the finite stopping argument. -/
noncomputable def SourceStoppingCoordinateEnvelope
    (α : Anisotropy) (S : BoxCollection α) (f : ModelRealInput)
    (q σ : Fin 4 → ℝ)
    (hpos : ∀ r ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) r) : ℝ :=
  ∑ j : Fin 4,
    ∑ m ∈ (activeStoppingLevels α S sourceStoppingExponent f hpos).filter
        (fun n ↦ sourceStoppingDominantIndex q σ n = j) |>.image
          (fun n ↦ n j),
      sourceStoppingDominantFiberEnvelope q σ j m *
        (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal

/-- Coordinatewise finiteness of the scalar maximal level regions supplies
the finite-measure hypothesis at the dominant coordinate of every stopping
level. -/
theorem dominantMaximalLevel_finite_of_coordinateLevel_finite
    (α : Anisotropy) (f : ModelRealInput) (q σ : Fin 4 → ℝ)
    (hfinite : ∀ (j : Fin 4) (m : ℤ),
      volume (sourceStoppingMaximalLevelSetAt α f j m) ≠ ∞) :
    ∀ n : Fin 4 → ℤ,
      volume (sourceStoppingDominantMaximalLevelSet α f q σ n) ≠ ∞ := by
  intro n
  simpa only [sourceStoppingDominantMaximalLevelSet] using
    hfinite (sourceStoppingDominantIndex q σ n)
      (n (sourceStoppingDominantIndex q σ n))

/-- The bounded-continuous active stopping-forest estimate with its
finite-measure condition reduced to the four scalar maximal level families. -/
theorem activeStoppingForest_bound_of_coordinateLevel_finite
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (q σ : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (hpos : ∀ r ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) r)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hfinite : ∀ (j : Fin 4) (m : ℤ),
      volume (sourceStoppingMaximalLevelSetAt α f j m) ≠ ∞)
    (hcs : sourceStoppingTreeCS α S hS u c f)
    (henergy : sourceStoppingTreeEnergyIntegrability α S hS u f)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict (collectionRegion α S))) :
    ∃ C : ℝ, 0 ≤ C ∧
      |expandedModelLocalForm α S u c f| ≤
        C * sourceWeight u ^ 75 *
          SourceStoppingCoordinateEnvelope α S f q σ hpos := by
  rcases activeStoppingForest_form_bound_of_boundedContinuous
    α S hS u c f q σ hq hpos hcont hbound
      (dominantMaximalLevel_finite_of_coordinateLevel_finite
        α f q σ hfinite) hcs henergy hint with ⟨C, hC, hCbound⟩
  refine ⟨C, hC, ?_⟩
  simpa only [SourceStoppingCoordinateEnvelope] using hCbound

/-- The same active-forest conclusion specialized to real Schwartz input;
continuity and uniform boundedness are discharged here rather than remaining
as terminal assumptions. -/
theorem activeStoppingForest_bound_of_realSchwartz
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (F : InitialModelSchwartzInput)
    (q σ : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (hpos : ∀ r ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j)
        (InitialModelRealInput F j) r)
    (hfinite : ∀ (j : Fin 4) (m : ℤ),
      volume (sourceStoppingMaximalLevelSetAt α
        (InitialModelRealInput F) j m) ≠ ∞)
    (hcs : sourceStoppingTreeCS α S hS u c (InitialModelRealInput F))
    (henergy : sourceStoppingTreeEnergyIntegrability α S hS u
      (InitialModelRealInput F))
    (hint : Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α (InitialModelRealInput F) pt.1 pt.2 z *
          modelSecondFiber α (InitialModelRealInput F 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict (collectionRegion α S))) :
    ∃ C : ℝ, 0 ≤ C ∧
      |expandedModelLocalForm α S u c (InitialModelRealInput F)| ≤
        C * sourceWeight u ^ 75 *
          SourceStoppingCoordinateEnvelope α S
            (InitialModelRealInput F) q σ hpos := by
  exact activeStoppingForest_bound_of_coordinateLevel_finite
    α S hS u c (InitialModelRealInput F) q σ hq hpos
    (initialModelRealInput_continuous F)
    (initialModelRealInput_bounded F) hfinite hcs henergy hint

/-- The exact distributional interface remaining after the finite stopping
argument.  A maximal-function proof supplies this inequality with the desired
product of `L^p` norms as `W`. -/
theorem initialModel_bound_of_coordinateEnvelope_bound
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (q σ : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (hpos : ∀ r ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) r)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hfinite : ∀ (j : Fin 4) (m : ℤ),
      volume (sourceStoppingMaximalLevelSetAt α f j m) ≠ ∞)
    (hcs : sourceStoppingTreeCS α S hS u c f)
    (henergy : sourceStoppingTreeEnergyIntegrability α S hS u f)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict (collectionRegion α S)))
    (W : ℝ)
    (hdistribution : SourceStoppingCoordinateEnvelope α S f q σ hpos ≤ W) :
    ∃ C : ℝ, 0 ≤ C ∧
      |expandedModelLocalForm α S u c f| ≤ C * sourceWeight u ^ 75 * W := by
  rcases activeStoppingForest_bound_of_coordinateLevel_finite
    α S hS u c f q σ hq hpos hcont hbound hfinite hcs henergy hint with
      ⟨C, hC, hCbound⟩
  refine ⟨C, hC, hCbound.trans ?_⟩
  apply mul_le_mul_of_nonneg_left hdistribution
  exact mul_nonneg hC (pow_nonneg (sourceWeight_nonneg u) _)

/-- The exact bridge from finite active-forest estimates to the literal
full-scale model form.  Its `hlocalization` hypothesis is deliberately only
the finite-scale identification: the global expanded six-variable expression
is never required to be absolutely integrable. -/
theorem modelFullForm_bound_of_profile_and_truncationForest_bound
    {a C : ℝ} (ha : 0 < a)
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ)
    (F : ModelSchwartzInput) (f : ModelRealInput) (B : ℝ)
    (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hmeas : AEStronglyMeasurable
      (fun t : ℝ ↦ c t * ModelSpatialProfile α u F t)
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))))
    (hprofile : ∀ t : ℝ, 0 < t →
      |ModelSpatialProfile α u F t| ≤ C * min (t ^ a) (t ^ (-a)))
    (hlocalization : ∀ N : ℕ,
      ModelScaleTruncation α u c F N =
        expandedModelLocalForm α (truncationCollection α N) u c f)
    (hforest : ∀ N : ℕ,
      |expandedModelLocalForm α (truncationCollection α N) u c f| ≤ B) :
    |ModelFullForm α u c F| ≤ B := by
  apply modelFullForm_bound_of_profile_and_uniform_truncation_bound
    ha α u c F B hc hmeas hprofile
  intro N
  rw [hlocalization N]
  exact hforest N

/-- One low-frequency model factor and its normalized Gaussian partner are
jointly integrable in their center and spatial variables. -/
theorem integrable_modelPhi_gaussian_pair
    (s c x : ℝ) (hs : 0 < s) :
    Integrable (fun z : ℝ × ℝ ↦
      |modelPhiAt s (z.1 + c) x| * gaussianAt s z.1 z.2)
      ((volume : Measure ℝ).prod volume) := by
  have hphi_meas : Measurable (fun z : ℝ × ℝ ↦
      modelPhiAt s (z.1 + c) x) := by
    unfold modelPhiAt
    apply measurable_kernelAt conePhiPhysicalReal
      conePhiPhysicalReal.continuous.measurable
    · exact measurable_const
    · exact measurable_fst.add measurable_const
    · exact measurable_const
  have hgauss_meas : Measurable (fun z : ℝ × ℝ ↦
      gaussianAt s z.1 z.2) := by
    unfold gaussianAt
    apply measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable
    · exact measurable_const
    · exact measurable_fst
    · exact measurable_snd
  have hmeas : AEStronglyMeasurable (fun z : ℝ × ℝ ↦
      |modelPhiAt s (z.1 + c) x| * gaussianAt s z.1 z.2)
      ((volume : Measure ℝ).prod volume) := by
    have hphi_abs : AEStronglyMeasurable (fun z : ℝ × ℝ ↦
        |modelPhiAt s (z.1 + c) x|) ((volume : Measure ℝ).prod volume) := by
      simpa only [Real.norm_eq_abs] using hphi_meas.aestronglyMeasurable.norm
    exact hphi_abs.mul hgauss_meas.aestronglyMeasurable
  refine (integrable_prod_iff hmeas).mpr ⟨?_, ?_⟩
  · filter_upwards [] with p
    have hgauss : Integrable (gaussianAt s p) := integrable_gaussianAt hs p
    simpa only using hgauss.const_mul |modelPhiAt s (p + c) x|
  · have hphi : Integrable (fun p : ℝ ↦ |modelPhiAt s (p + c) x|) := by
      apply (integrable_abs_modelPhiAt hs (x - c)).congr
      filter_upwards [] with p
      symm
      unfold modelPhiAt kernelAt kernelDilate
      simp only [smul_eq_mul, abs_mul]
      congr 1
      rw [show (x - (p + c)) / s = -((p - (x - c)) / s) by ring,
        conePhiPhysicalReal_even]
    apply hphi.congr
    filter_upwards [] with p
    have hnonneg (y : ℝ) : 0 ≤ gaussianAt s p y := by
      unfold gaussianAt kernelAt kernelDilate
      exact mul_nonneg (inv_pos.mpr hs).le (gaussian_nonneg _)
    symm
    calc
      (∫ y : ℝ, ‖|modelPhiAt s (p + c) x| * gaussianAt s p y‖) =
          ∫ y : ℝ, |modelPhiAt s (p + c) x| * gaussianAt s p y := by
            apply integral_congr_ae
            filter_upwards [] with y
            rw [Real.norm_eq_abs, abs_of_nonneg]
            exact mul_nonneg (abs_nonneg _) (hnonneg y)
      _ = |modelPhiAt s (p + c) x| * ∫ y : ℝ, gaussianAt s p y := by
            rw [integral_const_mul]
      _ = |modelPhiAt s (p + c) x| := by
            rw [integral_gaussianAt hs p]
            ring

/-- The preceding center--Gaussian pair has the scale-independent mass of
the absolute low-frequency kernel. -/
theorem integral_modelPhi_gaussian_pair
    (s c x : ℝ) (hs : 0 < s) :
    (∫ z : ℝ × ℝ,
      |modelPhiAt s (z.1 + c) x| * gaussianAt s z.1 z.2) =
      ∫ w : ℝ, |conePhiPhysicalReal w| := by
  let G : ℝ × ℝ → ℝ := fun z ↦
    |modelPhiAt s (z.1 + c) x| * gaussianAt s z.1 z.2
  have hG : Integrable G ((volume : Measure ℝ).prod volume) :=
    integrable_modelPhi_gaussian_pair s c x hs
  calc
    (∫ z : ℝ × ℝ, |modelPhiAt s (z.1 + c) x| * gaussianAt s z.1 z.2) =
        ∫ p : ℝ, ∫ y : ℝ, G (p, y) := by
          exact integral_prod G hG
    _ = ∫ p : ℝ, |modelPhiAt s (p + c) x| := by
          apply integral_congr_ae
          filter_upwards [] with p
          dsimp [G]
          rw [show (fun y : ℝ ↦
            |modelPhiAt s (p + c) x| * gaussianAt s p y) =
              fun y : ℝ ↦ |modelPhiAt s (p + c) x| * gaussianAt s p y by rfl,
            integral_const_mul, integral_gaussianAt hs p]
          ring
    _ = ∫ w : ℝ, |conePhiPhysicalReal w| :=
      integral_abs_modelPhiAt_center hs c x

/-- At every positive scale, the physical Gaussian-derivative transform of
a Schwartz fiber has an integrable squared norm. -/
theorem integrable_norm_sq_gaussianDeriv_fiber
    (F : SchwartzMap ℝ ℂ) (s : ℝ) (hs : 0 < s) :
    Integrable (fun q : ℝ ↦
      ‖∫ v : ℝ, F v * (gaussianDerivAt s q v : ℂ)‖ ^ 2) := by
  let K : ℝ → ℂ := fun v ↦ (gaussianDerivAt s 0 v : ℂ)
  let Cfun : ℝ → ℂ := fun q ↦
    ∫ v : ℝ, F v * (gaussianDerivAt s q v : ℂ)
  have hK : Integrable K := by
    dsimp [K]
    exact (integrable_gaussianDerivAt hs 0).ofReal
  have hconv : Integrable ((F : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] K) :=
    F.integrable.integrable_convolution (ContinuousLinearMap.mul ℂ ℂ) hK
  have hCfun_eq (q : ℝ) : Cfun q =
      -((F : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] K) q := by
    dsimp [Cfun, K]
    exact gaussianDerivAt_fiber_eq_neg_convolution F s q
  have hCfun : Integrable Cfun := by
    apply hconv.neg.congr
    filter_upwards [] with q
    symm
    exact hCfun_eq q
  have hconvcont : Continuous ((F : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] K) :=
    (bddAbove_norm_complex_gaussianDerivAt s 0).continuous_convolution_right_of_integrable
      (ContinuousLinearMap.mul ℂ ℂ) F.integrable
      (continuous_complex_gaussianDerivAt s 0)
  have hCfuncont : Continuous Cfun := by
    apply hconvcont.neg.congr
    intro q
    symm
    exact hCfun_eq q
  obtain ⟨C, hC⟩ := bddAbove_norm_complex_gaussianDerivAt s 0
  have hKbound (v : ℝ) : ‖K v‖ ≤ C := hC ⟨v, rfl⟩
  have hCfunbound (q : ℝ) : ‖Cfun q‖ ≤ (∫ v : ℝ, ‖F v‖) * C := by
    have hmajor : Integrable (fun v : ℝ ↦ ‖F v‖ * C) :=
      F.integrable.norm.mul_const C
    calc
      ‖Cfun q‖ ≤ ∫ v : ℝ,
          ‖F v * (gaussianDerivAt s q v : ℂ)‖ :=
        norm_integral_le_integral_norm _
      _ ≤ ∫ v : ℝ, ‖F v‖ * C := by
        apply MeasureTheory.integral_mono_of_nonneg
        · filter_upwards [] with v
          exact norm_nonneg _
        · exact hmajor
        filter_upwards [] with v
        rw [norm_mul]
        apply mul_le_mul_of_nonneg_left
        · rw [gaussianDerivAt_reflect]
          push_cast
          simpa [K, Complex.norm_real, Real.norm_eq_abs] using hKbound (q - v)
        · exact norm_nonneg _
      _ = (∫ v : ℝ, ‖F v‖) * C := by
        rw [integral_mul_const]
  have hDnonneg : 0 ≤ (∫ v : ℝ, ‖F v‖) * C := by
    exact (norm_nonneg (Cfun 0)).trans (hCfunbound 0)
  have hnormsq : Integrable (fun q : ℝ ↦ ‖Cfun q‖ ^ 2) :=
    integrable_sq_of_integrable_bounded (fun q ↦ ‖Cfun q‖) hCfun.norm
      ((∫ v : ℝ, ‖F v‖) * C) hDnonneg (by
        intro q
        simpa only [abs_norm] using hCfunbound q)
  simpa only [Cfun] using hnormsq

/-- The physical one-dimensional square function of every complex Schwartz
fiber is jointly integrable in positive scale and center. -/
theorem integrable_schwartz_fiber_physical_square
    (F : SchwartzMap ℝ ℂ) (n : ℕ) (hn : 0 < n) :
    Integrable (fun z : ℝ × ℝ ↦
      ‖∫ v : ℝ, F v * (gaussianDerivAt (z.1 ^ n) z.2 v : ℂ)‖ ^ 2 / z.1)
      ((volume.restrict (Set.Ioi (0 : ℝ))).prod volume) := by
  let μ : Measure ℝ := volume.restrict (Set.Ioi (0 : ℝ))
  let J : ℝ × ℝ → ℂ := fun z ↦
    ∫ v : ℝ, F v * (gaussianDerivAt (z.1 ^ n) z.2 v : ℂ)
  let H : ℝ × ℝ → ℝ := fun z ↦ ‖J z‖ ^ 2 / z.1
  let M : ℝ → ℝ := fun ξ ↦ ‖𝓕 (F : ℝ → ℂ) ξ‖ ^ 2
  have hkernel_meas : Measurable (fun qv : (ℝ × ℝ) × ℝ ↦
      F qv.2 * (gaussianDerivAt (qv.1.1 ^ n) qv.1.2 qv.2 : ℂ)) := by
    have ht : Measurable (fun qv : (ℝ × ℝ) × ℝ ↦ qv.1.1 ^ n) :=
      (measurable_fst.comp measurable_fst).pow_const _
    have hq : Measurable (fun qv : (ℝ × ℝ) × ℝ ↦ qv.1.2) :=
      measurable_snd.comp measurable_fst
    have hv : Measurable (fun qv : (ℝ × ℝ) × ℝ ↦ qv.2) := measurable_snd
    have hderiv : Measurable gaussianDeriv := by
      unfold gaussianDeriv
      exact (measurable_const.mul measurable_id).mul
        gaussian_contDiff.continuous.measurable
    have hkernel : Measurable (fun qv : (ℝ × ℝ) × ℝ ↦
        gaussianDerivAt (qv.1.1 ^ n) qv.1.2 qv.2) :=
      measurable_kernelAt gaussianDeriv hderiv
        _ _ _ ht hq hv
    exact (F.continuous.measurable.comp hv).mul
      (Complex.continuous_ofReal.measurable.comp hkernel)
  have hJmeas : AEStronglyMeasurable J (μ.prod volume) := by
    have hfull : AEStronglyMeasurable (fun qv : (ℝ × ℝ) × ℝ ↦
        F qv.2 * (gaussianDerivAt (qv.1.1 ^ n) qv.1.2 qv.2 : ℂ))
        ((μ.prod volume).prod volume) := hkernel_meas.aestronglyMeasurable
    simpa only [J] using hfull.integral_prod_right'
  have hHmeas : AEStronglyMeasurable H (μ.prod volume) := by
    dsimp [H]
    have hmul := (hJmeas.norm.pow 2).mul
      ((measurable_fst : Measurable fun z : ℝ × ℝ ↦ z.1).inv.aestronglyMeasurable)
    apply hmul.congr
    filter_upwards [] with z
    rfl
  have hM : Integrable M := by
    have hmem : MemLp (𝓕 F : SchwartzMap ℝ ℂ) 2 (volume : Measure ℝ) :=
      (𝓕 F).memLp 2 volume
    have hsq : Integrable (fun ξ : ℝ ↦
        ‖(𝓕 F : SchwartzMap ℝ ℂ) ξ‖ ^ 2) :=
      (memLp_two_iff_integrable_sq_norm
        (𝓕 F : SchwartzMap ℝ ℂ).continuous.aestronglyMeasurable).mp hmem
    simpa only [M, SchwartzMap.fourier_coe] using hsq
  have hfreq : Integrable (fun z : ℝ × ℝ ↦
      M z.2 * (gaussianDeriv (z.1 ^ n * z.2) ^ 2 / z.1)) (μ.prod volume) := by
    exact integrable_calderon_joint_of_integrable n hn M hM
      (fun ξ ↦ sq_nonneg _)
  have hfreqOuter : Integrable (fun t : ℝ ↦
      ∫ ξ : ℝ, ‖M ξ * (gaussianDeriv (t ^ n * ξ) ^ 2 / t)‖) μ :=
    (integrable_prod_iff hfreq.aestronglyMeasurable).mp hfreq |>.2
  have hfixed : ∀ᵐ t : ℝ ∂μ,
      (∫ q : ℝ, H (t, q)) =
        ∫ ξ : ℝ, M ξ * (gaussianDeriv (t ^ n * ξ) ^ 2 / t) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    have hscale : 0 < t ^ n := pow_pos ht n
    dsimp [H, J]
    rw [show (∫ q : ℝ,
      ‖∫ v : ℝ, F v * (gaussianDerivAt (t ^ n) q v : ℂ)‖ ^ 2 / t) =
        (∫ q : ℝ,
          ‖∫ v : ℝ, F v * (gaussianDerivAt (t ^ n) q v : ℂ)‖ ^ 2) / t by
      rw [integral_div],
      integral_norm_sq_gaussianDeriv_fiber F (t ^ n) hscale,
      ← integral_div]
    apply integral_congr_ae
    filter_upwards [] with ξ
    dsimp only [M]
    ring
  have hsections : ∀ᵐ t : ℝ ∂μ, Integrable (fun q : ℝ ↦ H (t, q)) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    have hscale : 0 < t ^ n := pow_pos ht n
    have hsq := integrable_norm_sq_gaussianDeriv_fiber F (t ^ n) hscale
    simpa only [H, J] using hsq.div_const t
  have houter : Integrable (fun t : ℝ ↦ ∫ q : ℝ, ‖H (t, q)‖) μ := by
    apply hfreqOuter.congr
    filter_upwards [ae_restrict_mem measurableSet_Ioi, hfixed] with t ht hfixed
    have hHnonneg (q : ℝ) : 0 ≤ H (t, q) := by
      dsimp [H]
      exact div_nonneg (sq_nonneg _) ht.le
    have hKnonneg (ξ : ℝ) :
        0 ≤ M ξ * (gaussianDeriv (t ^ n * ξ) ^ 2 / t) := by
      exact mul_nonneg (sq_nonneg _)
        (div_nonneg (sq_nonneg _) ht.le)
    symm
    calc
      (∫ q : ℝ, ‖H (t, q)‖) = ∫ q : ℝ, H (t, q) := by
        apply integral_congr_ae
        filter_upwards [] with q
        rw [Real.norm_eq_abs, abs_of_nonneg (hHnonneg q)]
      _ = ∫ ξ : ℝ, M ξ * (gaussianDeriv (t ^ n * ξ) ^ 2 / t) := hfixed
      _ = ∫ ξ : ℝ, ‖M ξ * (gaussianDeriv (t ^ n * ξ) ^ 2 / t)‖ := by
        symm
        apply integral_congr_ae
        filter_upwards [] with ξ
        rw [Real.norm_eq_abs, abs_of_nonneg (hKnonneg ξ)]
  have hmain : Integrable H (μ.prod volume) :=
    (integrable_prod_iff hHmeas).mpr ⟨hsections, houter⟩
  simpa only [H, J, μ] using hmain

/-- Passing from `dt/t` to the literal `cubeScaleDensity` measure preserves
integrability of a positive-scale scalar square function. -/
theorem integrable_with_cubeScaleDensity_of_integrable_div
    (B : ℝ × ℝ → ℝ)
    (hB : Integrable (fun z : ℝ × ℝ ↦ B z / z.1)
      ((volume.restrict (Set.Ioi (0 : ℝ))).prod volume)) :
    Integrable B
      ((((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))).prod volume) := by
  let μ : Measure ℝ := volume.restrict (Set.Ioi (0 : ℝ))
  have hpos : ∀ᵐ z : ℝ × ℝ ∂(μ.prod volume), 0 < z.1 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
      exact Filter.Eventually.of_forall fun _ ↦ ht
    · exact measurableSet_Ioi.preimage measurable_fst
  have htop : ∀ᵐ z : ℝ × ℝ ∂(μ.prod volume),
      cubeScaleDensity z.1 < ∞ := by
    filter_upwards [hpos] with z hz
    rw [cubeScaleDensity_eq_of_pos hz]
    exact ENNReal.ofReal_lt_top
  change Integrable B (((volume.withDensity cubeScaleDensity).restrict
    (Set.Ioi (0 : ℝ))).prod volume)
  rw [restrict_withDensity measurableSet_Ioi,
    prod_withDensity_left measurable_cubeScaleDensity]
  change Integrable B ((μ.prod volume).withDensity (cubeScaleDensity ∘ Prod.fst))
  rw [integrable_withDensity_iff
    (measurable_cubeScaleDensity.comp measurable_fst) htop]
  apply hB.congr
  filter_upwards [hpos] with z hz
  change B z / z.1 = B z * (cubeScaleDensity z.1).toReal
  rw [cubeScaleDensity_eq_of_pos hz,
    ENNReal.toReal_ofReal (inv_pos.mpr hz).le]
  ring

/-- The preceding physical square-function integrability in the real fiber
convention, obtained by complexifying its Schwartz realization. -/
theorem integrable_real_schwartz_fiber_physical_square
    (F : SchwartzMap ℝ ℂ) (g : ℝ → ℝ)
    (hF : ∀ v : ℝ, F v = (g v : ℂ)) (n : ℕ) (hn : 0 < n) :
    Integrable (fun z : ℝ × ℝ ↦
      (∫ v : ℝ, g v * gaussianDerivAt (z.1 ^ n) z.2 v) ^ 2 / z.1)
      ((volume.restrict (Set.Ioi (0 : ℝ))).prod volume) := by
  apply (integrable_schwartz_fiber_physical_square F n hn).congr
  filter_upwards [] with z
  rw [complexFiberIntegral_eq_real F g hF]
  simp

/-- The real Schwartz fiber square function is integrable for the literal
positive logarithmic scale measure. -/
theorem integrable_real_schwartz_fiber_with_cubeScaleDensity
    (F : SchwartzMap ℝ ℂ) (g : ℝ → ℝ)
    (hF : ∀ v : ℝ, F v = (g v : ℂ)) (n : ℕ) (hn : 0 < n) :
    Integrable (fun z : ℝ × ℝ ↦
      (∫ v : ℝ, g v * gaussianDerivAt (z.1 ^ n) z.2 v) ^ 2)
      ((((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))).prod volume) := by
  apply integrable_with_cubeScaleDensity_of_integrable_div
  exact integrable_real_schwartz_fiber_physical_square F g hF n hn

/-- The reduced third-coordinate square function of a real Schwartz input
is jointly integrable in its two transverse coordinates, center, and the
literal logarithmic scale measure. -/
theorem integrable_modelThirdSquare_global_of_real_schwartz
    (α : Anisotropy) (f : SchwartzMap E3 ℝ) :
    Integrable (fun z : (ℝ × ℝ) × (ℝ × ℝ) ↦
      (∫ v : ℝ, f (modelPoint z.1.1 z.1.2 v) *
        gaussianDerivAt (z.2.2 ^ α.weight 2) z.2.1 v) ^ 2)
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod
          (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
            (Set.Ioi (0 : ℝ))))) := by
  let ν : Measure ℝ :=
    ((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
      (Set.Ioi (0 : ℝ))
  let G : (ℝ × ℝ) × (ℝ × ℝ) → ℝ := fun z ↦
    (∫ v : ℝ, f (modelPoint z.1.1 z.1.2 v) *
      gaussianDerivAt (z.2.2 ^ α.weight 2) z.2.1 v) ^ 2
  have hkernel_meas : Measurable (fun qv : ((ℝ × ℝ) × (ℝ × ℝ)) × ℝ ↦
      f (modelPoint qv.1.1.1 qv.1.1.2 qv.2) *
        gaussianDerivAt (qv.1.2.2 ^ α.weight 2) qv.1.2.1 qv.2) := by
    have hx₁ : Measurable (fun qv : ((ℝ × ℝ) × (ℝ × ℝ)) × ℝ ↦ qv.1.1.1) :=
      measurable_fst.comp (measurable_fst.comp measurable_fst)
    have hx₂ : Measurable (fun qv : ((ℝ × ℝ) × (ℝ × ℝ)) × ℝ ↦ qv.1.1.2) :=
      measurable_snd.comp (measurable_fst.comp measurable_fst)
    have ht : Measurable (fun qv : ((ℝ × ℝ) × (ℝ × ℝ)) × ℝ ↦
        qv.1.2.2 ^ α.weight 2) :=
      (measurable_snd.comp (measurable_snd.comp measurable_fst)).pow_const _
    have hp : Measurable (fun qv : ((ℝ × ℝ) × (ℝ × ℝ)) × ℝ ↦ qv.1.2.1) :=
      measurable_fst.comp (measurable_snd.comp measurable_fst)
    have hv : Measurable (fun qv : ((ℝ × ℝ) × (ℝ × ℝ)) × ℝ ↦ qv.2) :=
      measurable_snd
    have hinput : Measurable (fun qv : ((ℝ × ℝ) × (ℝ × ℝ)) × ℝ ↦
        f (modelPoint qv.1.1.1 qv.1.1.2 qv.2)) :=
      f.continuous.measurable.comp
        (measurable_modelPoint _ _ _ hx₁ hx₂ hv)
    have hderiv : Measurable gaussianDeriv := by
      unfold gaussianDeriv
      exact (measurable_const.mul measurable_id).mul
        gaussian_contDiff.continuous.measurable
    have hkernel : Measurable (fun qv : ((ℝ × ℝ) × (ℝ × ℝ)) × ℝ ↦
        gaussianDerivAt (qv.1.2.2 ^ α.weight 2) qv.1.2.1 qv.2) :=
      measurable_kernelAt gaussianDeriv hderiv _ _ _ ht hp hv
    exact hinput.mul hkernel
  have hGmeas : AEStronglyMeasurable G
      ((((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ν))) := by
    have hpre : AEStronglyMeasurable (fun z : (ℝ × ℝ) × (ℝ × ℝ) ↦
        ∫ v : ℝ, f (modelPoint z.1.1 z.1.2 v) *
          gaussianDerivAt (z.2.2 ^ α.weight 2) z.2.1 v)
        ((((volume : Measure ℝ).prod volume).prod
          ((volume : Measure ℝ).prod ν))) := by
      have hfull : AEStronglyMeasurable (fun qv :
          ((ℝ × ℝ) × (ℝ × ℝ)) × ℝ ↦
          f (modelPoint qv.1.1.1 qv.1.1.2 qv.2) *
            gaussianDerivAt (qv.1.2.2 ^ α.weight 2) qv.1.2.1 qv.2)
          (((((volume : Measure ℝ).prod volume).prod
            ((volume : Measure ℝ).prod ν)).prod volume)) :=
        hkernel_meas.aestronglyMeasurable
      exact hfull.integral_prod_right'
    have hsq := hpre.pow 2
    apply hsq.congr
    filter_upwards [] with z
    rfl
  have hsections_all (x : ℝ × ℝ) : Integrable (fun pt : ℝ × ℝ ↦ G (x, pt))
      ((volume : Measure ℝ).prod ν) := by
    let F : SchwartzMap ℝ ℂ :=
      modelThirdSchwartzFiber (complexifyRealSchwartz f) x.1 x.2
    let g : ℝ → ℝ := fun v ↦ f (modelPoint x.1 x.2 v)
    have hF (v : ℝ) : F v = (g v : ℂ) := by
      dsimp [F, g]
      simp
    have hdensity : Integrable (fun z : ℝ × ℝ ↦
        (∫ v : ℝ, g v * gaussianDerivAt (z.1 ^ α.weight 2) z.2 v) ^ 2)
        (ν.prod volume) := by
      simpa only [ν] using
        integrable_real_schwartz_fiber_with_cubeScaleDensity
          F g hF (α.weight 2) (α.weight_pos 2)
    have hswap := hdensity.swap
    apply hswap.congr
    filter_upwards [] with pt
    rcases pt with ⟨p₂, t⟩
    rfl
  have hfsq : Integrable (fun y : E3 ↦ f y ^ 2) :=
    (memLp_two_iff_integrable_sq f.continuous.aestronglyMeasurable).mp
      (f.memLp 2 volume)
  let R : (ℝ × ℝ) × ℝ → ℝ := fun z ↦
    f (modelPoint z.1.1 z.1.2 z.2) ^ 2
  have hR : Integrable R (((volume : Measure ℝ).prod volume).prod volume) := by
    let e : E3 ≃ᵐ ℝ × (ℝ × ℝ) := e3Coordinates
    let R' : ℝ × (ℝ × ℝ) → ℝ := fun z ↦
      f (modelPoint z.1 z.2.1 z.2.2) ^ 2
    have hmp : MeasurePreserving e (volume : Measure E3)
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
      simpa only [e] using e3Coordinates_measurePreserving
    have hR' : Integrable R'
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
      have htrans := (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hfsq
      apply htrans.congr
      filter_upwards [] with z
      rcases z with ⟨x₁, x₂, v⟩
      simp only [Function.comp_apply, R', e]
      congr 2
      apply e.injective
      simp only [e, e3Coordinates_apply]
      exact Prod.ext rfl (Prod.ext rfl rfl)
    have hassoc := measurePreserving_prodAssoc
      (volume : Measure ℝ) (volume : Measure ℝ) (volume : Measure ℝ)
    have htrans := hassoc.integrable_comp_of_integrable hR'
    apply htrans.congr
    filter_upwards [] with z
    rcases z with ⟨⟨x₁, x₂⟩, v⟩
    rfl
  let L : ℝ × ℝ → ℝ := fun x ↦
    ∫ v : ℝ, f (modelPoint x.1 x.2 v) ^ 2
  have hL : Integrable L ((volume : Measure ℝ).prod volume) := by
    have houter := (integrable_prod_iff hR.aestronglyMeasurable).mp hR |>.2
    apply houter.congr
    filter_upwards [] with x
    dsimp [L, R]
    apply integral_congr_ae
    filter_upwards [] with v
    rw [abs_of_nonneg (sq_nonneg _)]
  let C : ℝ := Real.pi / (α.weight 2 : ℝ)
  have hinner_value (x : ℝ × ℝ) :
      (∫ pt : ℝ × ℝ, G (x, pt) ∂((volume : Measure ℝ).prod ν)) =
        C * L x := by
    have hx := hsections_all x
    calc
      (∫ pt : ℝ × ℝ, G (x, pt) ∂((volume : Measure ℝ).prod ν)) =
          ∫ p₂ : ℝ, (∫ t : ℝ, G (x, (p₂, t)) ∂ν) :=
        integral_prod _ hx
      _ = ∫ t : ℝ, (∫ p₂ : ℝ, G (x, (p₂, t))) ∂ν := by
        exact integral_integral_swap hx
      _ = ∫ t : ℝ in Set.Ioi (0 : ℝ), (∫ p₂ : ℝ,
          (∫ v : ℝ, f (modelPoint x.1 x.2 v) *
            gaussianDerivAt (t ^ α.weight 2) p₂ v) ^ 2)
          ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
            dsimp [G, ν]
      _ = ∫ t : ℝ in Set.Ioi (0 : ℝ),
          (∫ p₂ : ℝ,
            (∫ v : ℝ, f (modelPoint x.1 x.2 v) *
              gaussianDerivAt (t ^ α.weight 2) p₂ v) ^ 2) / t := by
            exact integral_Ioi_withDensity_cubeScaleDensity_eq
              (fun t : ℝ ↦ ∫ p₂ : ℝ,
                (∫ v : ℝ, f (modelPoint x.1 x.2 v) *
                  gaussianDerivAt (t ^ α.weight 2) p₂ v) ^ 2)
      _ = ∫ t : ℝ in Set.Ioi (0 : ℝ), ∫ p₂ : ℝ,
          (∫ v : ℝ, f (modelPoint x.1 x.2 v) *
            gaussianDerivAt (t ^ α.weight 2) p₂ v) ^ 2 / t := by
            apply setIntegral_congr_fun measurableSet_Ioi
            intro t ht
            change (∫ p₂ : ℝ,
              (∫ v : ℝ, f (modelPoint x.1 x.2 v) *
                gaussianDerivAt (t ^ α.weight 2) p₂ v) ^ 2) / t =
              ∫ p₂ : ℝ,
                (∫ v : ℝ, f (modelPoint x.1 x.2 v) *
                  gaussianDerivAt (t ^ α.weight 2) p₂ v) ^ 2 / t
            rw [← integral_div]
      _ = C * L x := by
            dsimp [C, L]
            exact modelThird_square_function_of_real_schwartz α f x.1 x.2
  have houter : Integrable (fun x : ℝ × ℝ ↦
      ∫ pt : ℝ × ℝ, ‖G (x, pt)‖ ∂((volume : Measure ℝ).prod ν))
      ((volume : Measure ℝ).prod volume) := by
    have hmajor : Integrable (fun x : ℝ × ℝ ↦ C * L x) := hL.const_mul C
    apply hmajor.congr
    filter_upwards [] with x
    symm
    calc
      (∫ pt : ℝ × ℝ, ‖G (x, pt)‖ ∂((volume : Measure ℝ).prod ν)) =
          ∫ pt : ℝ × ℝ, G (x, pt) ∂((volume : Measure ℝ).prod ν) := by
            apply integral_congr_ae
            filter_upwards [] with pt
            rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
      _ = C * L x := hinner_value x
  have hmain : Integrable G
      (((volume : Measure ℝ).prod volume).prod ((volume : Measure ℝ).prod ν)) :=
    (integrable_prod_iff hGmeas).mpr
      ⟨Filter.Eventually.of_forall hsections_all, houter⟩
  simpa only [G, ν] using hmain

/-- Regroup the reduced-tail variables from `((x,t),(p,r))` to
`((x,(p,t)),r)`, retaining the literal product measures. -/
noncomputable def tailReorder
    (X : Type*) [MeasurableSpace X] :
    ((X × ℝ) × (ℝ × ℝ)) ≃ᵐ ((X × (ℝ × ℝ)) × ℝ) :=
  (((MeasurableEquiv.prodAssoc :
      (X × ℝ) × (ℝ × ℝ) ≃ᵐ X × (ℝ × (ℝ × ℝ))).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl X)
      (swapMiddle ℝ ℝ ℝ))).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl X)
      (MeasurableEquiv.prodAssoc.symm :
        ℝ × (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) × ℝ))).trans
    (MeasurableEquiv.prodAssoc.symm :
      X × ((ℝ × ℝ) × ℝ) ≃ᵐ (X × (ℝ × ℝ)) × ℝ)

@[simp] theorem tailReorder_apply
    (X : Type*) [MeasurableSpace X] (x : X) (t p r : ℝ) :
    tailReorder X ((x, t), (p, r)) = ((x, (p, t)), r) := by
  simp [tailReorder, swapMiddle,
    MeasurableEquiv.prodAssoc, MeasurableEquiv.prodComm,
    MeasurableEquiv.prodCongr]

/-- The tail regrouping is measure preserving for arbitrary sigma-finite
outer and scale measures. -/
theorem tailReorder_measurePreserving
    (X : Type*) [MeasurableSpace X] (μX : Measure X) (ν : Measure ℝ)
    [SFinite μX] [SFinite ν] :
    MeasurePreserving (tailReorder X)
      ((μX.prod ν).prod ((volume : Measure ℝ).prod volume))
      ((μX.prod ((volume : Measure ℝ).prod ν)).prod volume) := by
  let h₁ : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        (X × ℝ) × (ℝ × ℝ) ≃ᵐ X × (ℝ × (ℝ × ℝ)))
      ((μX.prod ν).prod ((volume : Measure ℝ).prod volume))
      (μX.prod (ν.prod ((volume : Measure ℝ).prod volume))) :=
    measurePreserving_prodAssoc μX ν ((volume : Measure ℝ).prod volume)
  let h₂ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl X)
        (swapMiddle ℝ ℝ ℝ))
      (μX.prod (ν.prod ((volume : Measure ℝ).prod volume)))
      (μX.prod ((volume : Measure ℝ).prod (ν.prod volume))) :=
    (MeasurePreserving.id μX).prod
      (swapMiddle_measurePreserving ℝ ℝ ℝ ν volume volume)
  let h₃ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl X)
        (MeasurableEquiv.prodAssoc.symm :
          ℝ × (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) × ℝ))
      (μX.prod ((volume : Measure ℝ).prod (ν.prod volume)))
      (μX.prod (((volume : Measure ℝ).prod ν).prod volume)) :=
    (MeasurePreserving.id μX).prod
      (measurePreserving_prodAssoc (volume : Measure ℝ) ν volume).symm
  let h₄ : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        X × ((ℝ × ℝ) × ℝ) ≃ᵐ (X × (ℝ × ℝ)) × ℝ)
      (μX.prod (((volume : Measure ℝ).prod ν).prod volume))
      ((μX.prod ((volume : Measure ℝ).prod ν)).prod volume) :=
    (measurePreserving_prodAssoc μX ((volume : Measure ℝ).prod ν) volume).symm
  simpa only [tailReorder] using ((h₁.trans h₂).trans h₃).trans h₄

/-- The reduced square-tail density is a.e.-strongly measurable on every
product measure for a continuous real input. -/
theorem aestronglyMeasurable_reducedTail
    (α : Anisotropy) (u : E3) (f : E3 → ℝ) (hf : Continuous f)
    (μ : Measure (((ℝ × ℝ) × ℝ) × (ℝ × ℝ))) :
    AEStronglyMeasurable (fun z : ((ℝ × ℝ) × ℝ) × (ℝ × ℝ) ↦
      (modelSecondFiberReduced α f z.1.1.1 z.1.1.2 z.2.1 z.1.2 z.2.2) ^ 2 *
        |conePsiPhysicalReal (z.2.2 + u 2)|) μ := by
  have hx₁ : Measurable (fun qv : (((ℝ × ℝ) × ℝ) × (ℝ × ℝ)) × ℝ ↦
      qv.1.1.1.1) :=
    measurable_fst.comp (measurable_fst.comp
      (measurable_fst.comp measurable_fst))
  have hx₂ : Measurable (fun qv : (((ℝ × ℝ) × ℝ) × (ℝ × ℝ)) × ℝ ↦
      qv.1.1.1.2) :=
    measurable_snd.comp (measurable_fst.comp
      (measurable_fst.comp measurable_fst))
  have ht : Measurable (fun qv : (((ℝ × ℝ) × ℝ) × (ℝ × ℝ)) × ℝ ↦
      qv.1.1.2 ^ α.weight 2) :=
    (measurable_snd.comp (measurable_fst.comp measurable_fst)).pow_const _
  have hp : Measurable (fun qv : (((ℝ × ℝ) × ℝ) × (ℝ × ℝ)) × ℝ ↦
      qv.1.2.1) :=
    measurable_fst.comp (measurable_snd.comp measurable_fst)
  have hr : Measurable (fun qv : (((ℝ × ℝ) × ℝ) × (ℝ × ℝ)) × ℝ ↦
      qv.1.2.2) :=
    measurable_snd.comp (measurable_snd.comp measurable_fst)
  have hv : Measurable (fun qv : (((ℝ × ℝ) × ℝ) × (ℝ × ℝ)) × ℝ ↦
      qv.2) := measurable_snd
  have hinput : Measurable (fun qv : (((ℝ × ℝ) × ℝ) × (ℝ × ℝ)) × ℝ ↦
      f (modelPoint qv.1.1.1.1 qv.1.1.1.2 qv.2)) :=
    hf.measurable.comp (measurable_modelPoint _ _ _ hx₁ hx₂ hv)
  have hderiv : Measurable gaussianDeriv := by
    unfold gaussianDeriv
    exact (measurable_const.mul measurable_id).mul
      gaussian_contDiff.continuous.measurable
  have hcenter : Measurable (fun qv : (((ℝ × ℝ) × ℝ) × (ℝ × ℝ)) × ℝ ↦
      qv.1.2.1 + qv.1.2.2 * qv.1.1.2 ^ α.weight 2) :=
    hp.add (hr.mul ht)
  have hkernel : Measurable (fun qv : (((ℝ × ℝ) × ℝ) × (ℝ × ℝ)) × ℝ ↦
      gaussianDerivAt (qv.1.1.2 ^ α.weight 2)
        (qv.1.2.1 + qv.1.2.2 * qv.1.1.2 ^ α.weight 2) qv.2) :=
    measurable_kernelAt gaussianDeriv hderiv _ _ _ ht hcenter hv
  have hpre : AEStronglyMeasurable (fun z : ((ℝ × ℝ) × ℝ) × (ℝ × ℝ) ↦
      ∫ v : ℝ, f (modelPoint z.1.1.1 z.1.1.2 v) *
        gaussianDerivAt (z.1.2 ^ α.weight 2)
          (z.2.1 + z.2.2 * z.1.2 ^ α.weight 2) v) μ := by
    have hfull : AEStronglyMeasurable (fun qv :
        (((ℝ × ℝ) × ℝ) × (ℝ × ℝ)) × ℝ ↦
        f (modelPoint qv.1.1.1.1 qv.1.1.1.2 qv.2) *
          gaussianDerivAt (qv.1.1.2 ^ α.weight 2)
            (qv.1.2.1 + qv.1.2.2 * qv.1.1.2 ^ α.weight 2) qv.2)
        (μ.prod volume) := (hinput.mul hkernel).aestronglyMeasurable
    exact hfull.integral_prod_right'
  have htail : AEStronglyMeasurable (fun z : ((ℝ × ℝ) × ℝ) × (ℝ × ℝ) ↦
      |conePsiPhysicalReal (z.2.2 + u 2)|) μ := by
    have hmeas : Measurable (fun z : ((ℝ × ℝ) × ℝ) × (ℝ × ℝ) ↦
        conePsiPhysicalReal (z.2.2 + u 2)) :=
      conePsiPhysicalReal.continuous.measurable.comp
        ((measurable_snd.comp measurable_snd).add measurable_const)
    simpa only [Real.norm_eq_abs] using hmeas.aestronglyMeasurable.norm
  have hsq := hpre.pow 2
  have hmul := hsq.mul htail
  apply hmul.congr
  filter_upwards [] with z
  rfl

/-- The reduced translation tail is jointly integrable over all transverse
coordinates, third-coordinate centers, positive scales, and translations for
a real Schwartz input. -/
theorem integrable_reducedTail_global_of_real_schwartz
    (α : Anisotropy) (u : E3) (f : SchwartzMap E3 ℝ) :
    Integrable (fun z : ((ℝ × ℝ) × (ℝ × ℝ)) × ℝ ↦
      (modelSecondFiberReduced α f z.1.1.1 z.1.1.2 z.1.2.1 z.1.2.2 z.2) ^ 2 *
        |conePsiPhysicalReal (z.2 + u 2)|)
      ((((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod
          (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
            (Set.Ioi (0 : ℝ))))).prod volume) := by
  let ν : Measure ℝ :=
    ((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
      (Set.Ioi (0 : ℝ))
  let μX : Measure (ℝ × ℝ) := (volume : Measure ℝ).prod volume
  let K : ((ℝ × ℝ) × ℝ) × (ℝ × ℝ) → ℝ := fun z ↦
    (modelSecondFiberReduced α f z.1.1.1 z.1.1.2 z.2.1 z.1.2 z.2.2) ^ 2 *
      |conePsiPhysicalReal (z.2.2 + u 2)|
  have hKmeas : AEStronglyMeasurable K
      ((μX.prod ν).prod ((volume : Measure ℝ).prod volume)) := by
    simpa only [K] using aestronglyMeasurable_reducedTail α u f
      f.continuous ((μX.prod ν).prod ((volume : Measure ℝ).prod volume))
  have htpos : ∀ᵐ a : (ℝ × ℝ) × ℝ ∂(μX.prod ν), 0 < a.2 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [] with x
      filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
      exact ht
    · exact measurableSet_Ioi.preimage measurable_snd
  have hsection_of_pos (a : (ℝ × ℝ) × ℝ) (ha : 0 < a.2) :
      Integrable (fun pr : ℝ × ℝ ↦ K (a, pr))
        ((volume : Measure ℝ).prod volume) := by
    exact integrable_modelSecondFiberReduced_p2_r_of_real_schwartz
      α u f a.1.1 a.1.2 a.2 ha
  have hsections : ∀ᵐ a : (ℝ × ℝ) × ℝ ∂(μX.prod ν),
      Integrable (fun pr : ℝ × ℝ ↦ K (a, pr))
        ((volume : Measure ℝ).prod volume) := by
    filter_upwards [htpos] with a ha
    exact hsection_of_pos a ha
  let G : (ℝ × ℝ) × (ℝ × ℝ) → ℝ := fun z ↦
    (∫ v : ℝ, f (modelPoint z.1.1 z.1.2 v) *
      gaussianDerivAt (z.2.2 ^ α.weight 2) z.2.1 v) ^ 2
  have hG : Integrable G (μX.prod ((volume : Measure ℝ).prod ν)) := by
    simpa only [G, μX, ν] using
      integrable_modelThirdSquare_global_of_real_schwartz α f
  let e : (ℝ × ℝ) × (ℝ × ℝ) ≃ᵐ ((ℝ × ℝ) × ℝ) × ℝ :=
    (swapMiddle (ℝ × ℝ) ℝ ℝ).trans MeasurableEquiv.prodComm
  have hmp : MeasurePreserving e (μX.prod ((volume : Measure ℝ).prod ν))
      ((μX.prod ν).prod volume) := by
    let h₁ : MeasurePreserving (swapMiddle (ℝ × ℝ) ℝ ℝ)
        (μX.prod ((volume : Measure ℝ).prod ν))
        ((volume : Measure ℝ).prod (μX.prod ν)) :=
      swapMiddle_measurePreserving (ℝ × ℝ) ℝ ℝ μX volume ν
    let h₂ : MeasurePreserving (MeasurableEquiv.prodComm :
        ℝ × ((ℝ × ℝ) × ℝ) ≃ᵐ ((ℝ × ℝ) × ℝ) × ℝ)
        ((volume : Measure ℝ).prod (μX.prod ν))
        ((μX.prod ν).prod volume) :=
      Measure.measurePreserving_swap
    simpa only [e] using h₁.trans h₂
  have hGswap_raw :=
    (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hG
  have hGswap : Integrable (fun a : ((ℝ × ℝ) × ℝ) × ℝ ↦
      (∫ v : ℝ, f (modelPoint a.1.1.1 a.1.1.2 v) *
        gaussianDerivAt (a.1.2 ^ α.weight 2) a.2 v) ^ 2)
      ((μX.prod ν).prod volume) := by
    apply hGswap_raw.congr
    filter_upwards [] with a
    rcases a with ⟨⟨⟨x₁, x₂⟩, t⟩, p₂⟩
    rfl
  have hQ : Integrable (fun a : (ℝ × ℝ) × ℝ ↦
      ∫ p₂ : ℝ, (∫ v : ℝ, f (modelPoint a.1.1 a.1.2 v) *
        gaussianDerivAt (a.2 ^ α.weight 2) p₂ v) ^ 2)
      (μX.prod ν) := hGswap.integral_prod_left
  have houter : Integrable (fun a : (ℝ × ℝ) × ℝ ↦
      ∫ pr : ℝ × ℝ, ‖K (a, pr)‖)
      (μX.prod ν) := by
    have hmajor : Integrable (fun a : (ℝ × ℝ) × ℝ ↦
        conePsiPhysicalRealL1 *
          ∫ p₂ : ℝ, (∫ v : ℝ, f (modelPoint a.1.1 a.1.2 v) *
            gaussianDerivAt (a.2 ^ α.weight 2) p₂ v) ^ 2)
        (μX.prod ν) := hQ.const_mul conePsiPhysicalRealL1
    apply hmajor.congr
    filter_upwards [htpos] with a ha
    have hsection := hsection_of_pos a ha
    symm
    calc
      (∫ pr : ℝ × ℝ, ‖K (a, pr)‖) =
          ∫ pr : ℝ × ℝ, K (a, pr) := by
            apply integral_congr_ae
            filter_upwards [] with pr
            rw [Real.norm_eq_abs, abs_of_nonneg]
            exact mul_nonneg (sq_nonneg _) (abs_nonneg _)
      _ = ∫ p₂ : ℝ, ∫ r : ℝ, K (a, (p₂, r)) :=
        integral_prod _ hsection
      _ = conePsiPhysicalRealL1 *
          ∫ q : ℝ, (∫ v : ℝ, f (modelPoint a.1.1 a.1.2 v) *
            gaussianDerivAt (a.2 ^ α.weight 2) q v) ^ 2 := by
            exact modelSecondFiberReduced_p2_r_reduction α u f a.1.1 a.1.2 a.2
              hsection
  have hK : Integrable K
      ((μX.prod ν).prod ((volume : Measure ℝ).prod volume)) :=
    (integrable_prod_iff hKmeas).mpr ⟨hsections, houter⟩
  let D : ((ℝ × ℝ) × (ℝ × ℝ)) × ℝ → ℝ := fun z ↦
    (modelSecondFiberReduced α f z.1.1.1 z.1.1.2 z.1.2.1 z.1.2.2 z.2) ^ 2 *
      |conePsiPhysicalReal (z.2 + u 2)|
  have htailmp := tailReorder_measurePreserving (ℝ × ℝ) μX ν
  have hD_raw :=
    (MeasurePreserving.symm (tailReorder (ℝ × ℝ)) htailmp).integrable_comp_of_integrable hK
  apply hD_raw.congr
  filter_upwards [] with z
  rcases z with ⟨⟨⟨x₁, x₂⟩, ⟨p₂, t⟩⟩, r⟩
  rfl

/-- The post-scalar density in the global second-energy calculation is
integrable for every real Schwartz input. -/
theorem integrable_reordered_scalar_of_real_schwartz
    (α : Anisotropy) (u : E3) (f : SchwartzMap E3 ℝ) :
    Integrable (fun w : ScratchModelEnergyOuter ↦
      (∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
        (modelSecondFiberReduced α f w.1.1 w.1.2 w.2.1 w.2.2 r) ^ 2) *
        (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2)
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod
          (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
            (Set.Ioi (0 : ℝ)))) ) := by
  let ν : Measure ℝ :=
    ((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
      (Set.Ioi (0 : ℝ))
  let D : ScratchModelEnergyOuter × ℝ → ℝ := fun z ↦
    (modelSecondFiberReduced α f z.1.1.1 z.1.1.2 z.1.2.1 z.1.2.2 z.2) ^ 2 *
      |conePsiPhysicalReal (z.2 + u 2)|
  have hD : Integrable D
      ((((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ν)).prod volume) := by
    simpa only [D, ν] using
      integrable_reducedTail_global_of_real_schwartz α u f
  have hS : Integrable (fun w : ScratchModelEnergyOuter ↦
      ∫ r : ℝ, D (w, r))
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ν)) := hD.integral_prod_left
  have hmain := hS.mul_const ((∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2)
  apply hmain.congr
  filter_upwards [] with w
  dsimp [D]
  apply congrArg (fun q : ℝ ↦ q * (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2)
  apply integral_congr_ae
  filter_upwards [] with r
  ring

/-- Bounded continuous data discharge the local Cauchy--Schwarz premise on
every source stopping tree. -/
theorem sourceStoppingTreeCS_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (hcmeas : Measurable c)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    sourceStoppingTreeCS α S hS u c f := by
  intro n Q
  exact expandedModelLocalForm_cauchySchwarz_of_boundedContinuous_local
    α (sourceStoppingTree α S hS f n Q).boxes u c f hcmeas hcont hbound hc

/-- Lift the first fiber's parameter-integral measurability across the
additional source-scale coordinate. -/
theorem aestronglyMeasurable_modelFirstFiber_lift
    (α : Anisotropy) (f : ModelRealInput) (hcont : ∀ j, Continuous (f j))
    (μ : Measure ((E3 × ℝ) × (ModelE5 × ℝ))) :
    AEStronglyMeasurable (fun q ↦
      modelFirstFiber α f q.1.1 q.1.2 q.2.1) μ := by
  have hproj : Measurable (fun qv : ((E3 × ℝ) × (ModelE5 × ℝ)) × ℝ ↦
      ((qv.1.1, qv.1.2.1), qv.2)) := by
    exact ((measurable_fst.comp measurable_fst).prodMk
      (measurable_fst.comp (measurable_snd.comp measurable_fst))).prodMk
        measurable_snd
  have hjoint : AEStronglyMeasurable
      (fun qv : ((E3 × ℝ) × (ModelE5 × ℝ)) × ℝ ↦
        f 0 (modelPoint (qv.1.2.1 0) (qv.1.2.1 1) qv.2) *
        f 1 (modelPoint (qv.1.2.1 2) (qv.1.2.1 1) qv.2) *
        f 2 (modelPoint (qv.1.2.1 0) (qv.1.2.1 3) qv.2) *
        gaussianDerivAt (qv.1.1.2 ^ α.weight 2) (qv.1.1.1 2) qv.2)
      (μ.prod volume) := by
    exact ((measurable_modelFirstFiber_integrand α f hcont).comp hproj).aestronglyMeasurable
  simpa only [modelFirstFiber] using hjoint.integral_prod_right'

/-- The analogous lift for the one-input second fiber. -/
theorem aestronglyMeasurable_modelSecondFiber_lift
    (α : Anisotropy) (f : E3 → ℝ) (hcont : Continuous f)
    (μ : Measure ((E3 × ℝ) × (ModelE5 × ℝ))) :
    AEStronglyMeasurable (fun q ↦
      modelSecondFiber α f q.1.1 q.1.2 q.2.1) μ := by
  have hproj : Measurable (fun qv : ((E3 × ℝ) × (ModelE5 × ℝ)) × ℝ ↦
      ((qv.1.1, qv.1.2.1), qv.2)) := by
    exact ((measurable_fst.comp measurable_fst).prodMk
      (measurable_fst.comp (measurable_snd.comp measurable_fst))).prodMk
        measurable_snd
  have hjoint : AEStronglyMeasurable
      (fun qv : ((E3 × ℝ) × (ModelE5 × ℝ)) × ℝ ↦
        f (modelPoint (qv.1.2.1 0) (qv.1.2.1 1) qv.2) *
        gaussianDerivAt (qv.1.1.2 ^ α.weight 2)
          (qv.1.1.1 2 + qv.1.2.1 4 * qv.1.1.2 ^ α.weight 2) qv.2)
      (μ.prod volume) := by
    exact ((measurable_modelSecondFiber_integrand α f hcont).comp hproj).aestronglyMeasurable
  simpa only [modelSecondFiber] using hjoint.integral_prod_right'

/-- The passive four-Gaussian factor is measurable when center, tree scale,
fiber variables, and source scale vary jointly. -/
theorem measurable_modelFirstPassiveGaussianWeight_lift
    (α : Anisotropy) :
    Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      modelFirstPassiveGaussianWeight α q.2.2 q.1.1 q.1.2
        (q.2.1 0) (q.2.1 1) (q.2.1 2) (q.2.1 3)) := by
  have ht (i : Fin 3) : Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      q.1.2 ^ α.weight i) :=
    (measurable_snd.comp measurable_fst).pow_const _
  have hp (i : Fin 3) : Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      q.1.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp
      (measurable_fst.comp measurable_fst)
  have hz (i : Fin 5) : Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      q.2.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 5 ↦ ℝ) i).measurable.comp
      (measurable_fst.comp measurable_snd)
  have hlam : Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦ q.2.2) :=
    measurable_snd.comp measurable_snd
  have hs0 : Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      q.2.2 * q.1.2 ^ α.weight 0) := hlam.mul (ht 0)
  have hs1 : Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      q.2.2 * q.1.2 ^ α.weight 1) := hlam.mul (ht 1)
  have hg0x : Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      gaussianAt (q.2.2 * q.1.2 ^ α.weight 0) (q.1.1 0) (q.2.1 0)) := by
    unfold gaussianAt
    exact measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable
      _ _ _ hs0 (hp 0) (hz 0)
  have hg0y : Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      gaussianAt (q.2.2 * q.1.2 ^ α.weight 0) (q.1.1 0) (q.2.1 2)) := by
    unfold gaussianAt
    exact measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable
      _ _ _ hs0 (hp 0) (hz 2)
  have hg1x : Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      gaussianAt (q.2.2 * q.1.2 ^ α.weight 1) (q.1.1 1) (q.2.1 1)) := by
    unfold gaussianAt
    exact measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable
      _ _ _ hs1 (hp 1) (hz 1)
  have hg1y : Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      gaussianAt (q.2.2 * q.1.2 ^ α.weight 1) (q.1.1 1) (q.2.1 3)) := by
    unfold gaussianAt
    exact measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable
      _ _ _ hs1 (hp 1) (hz 3)
  change Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
    (gaussianAt (q.2.2 * q.1.2 ^ α.weight 0) (q.1.1 0) (q.2.1 0) *
      gaussianAt (q.2.2 * q.1.2 ^ α.weight 0) (q.1.1 0) (q.2.1 2)) *
    (gaussianAt (q.2.2 * q.1.2 ^ α.weight 1) (q.1.1 1) (q.2.1 1) *
      gaussianAt (q.2.2 * q.1.2 ^ α.weight 1) (q.1.1 1) (q.2.1 3)))
  exact (hg0x.mul hg0y).mul (hg1x.mul hg1y)

/-- The five independent factors in a passive Gaussian kernel, with an
arbitrary integrable final translation weight. -/
noncomputable def modelPassiveFactor
    (α : Anisotropy) (lam : ℝ) (p : E3) (t : ℝ) (g : ℝ → ℝ)
    (i : Fin 5) (x : ℝ) : ℝ :=
  match i.1 with
  | 0 => gaussianAt (lam * t ^ α.weight 0) (p 0) x
  | 1 => gaussianAt (lam * t ^ α.weight 1) (p 1) x
  | 2 => gaussianAt (lam * t ^ α.weight 0) (p 0) x
  | 3 => gaussianAt (lam * t ^ α.weight 1) (p 1) x
  | _ => g x

/-- Product version of `modelPassiveFactor` on the literal five
model-variable space. -/
noncomputable def modelPassiveKernel
    (α : Anisotropy) (lam : ℝ) (p : E3) (t : ℝ) (g : ℝ → ℝ)
    (z : ModelE5) : ℝ :=
  ∏ i : Fin 5, modelPassiveFactor α lam p t g i (z i)

/-- The literal first-energy passive weight times a fifth-coordinate factor
is the generic five-factor product. -/
theorem modelPassiveKernel_eq
    (α : Anisotropy) (lam : ℝ) (p : E3) (t : ℝ) (g : ℝ → ℝ)
    (z : ModelE5) :
    modelPassiveKernel α lam p t g z =
      modelFirstPassiveGaussianWeight α lam p t
        (z 0) (z 1) (z 2) (z 3) * g (z 4) := by
  simp only [modelPassiveKernel, Fin.prod_univ_succ,
    Finset.prod_empty]
  simp [modelPassiveFactor, modelFirstPassiveGaussianWeight]
  ring

/-- Each scalar factor of the generic passive kernel is integrable at a
positive tree and source scale. -/
theorem integrable_modelPassiveFactor
    (α : Anisotropy) (lam : ℝ) (p : E3) (t : ℝ) (g : ℝ → ℝ)
    (hg : Integrable g) (hlam : 0 < lam) (ht : 0 < t)
    (i : Fin 5) :
    Integrable (modelPassiveFactor α lam p t g i) := by
  have hs0 : 0 < lam * t ^ α.weight 0 :=
    mul_pos hlam (pow_pos ht _)
  have hs1 : 0 < lam * t ^ α.weight 1 :=
    mul_pos hlam (pow_pos ht _)
  fin_cases i
  · change Integrable (gaussianAt (lam * t ^ α.weight 0) (p 0))
    exact integrable_gaussianAt hs0 _
  · change Integrable (gaussianAt (lam * t ^ α.weight 1) (p 1))
    exact integrable_gaussianAt hs1 _
  · change Integrable (gaussianAt (lam * t ^ α.weight 0) (p 0))
    exact integrable_gaussianAt hs0 _
  · change Integrable (gaussianAt (lam * t ^ α.weight 1) (p 1))
    exact integrable_gaussianAt hs1 _
  · change Integrable g
    exact hg

/-- At fixed positive parameters, the passive kernel is integrable over all
five model variables. -/
theorem integrable_modelPassiveKernel
    (α : Anisotropy) (lam : ℝ) (p : E3) (t : ℝ) (g : ℝ → ℝ)
    (hg : Integrable g) (hlam : 0 < lam) (ht : 0 < t) :
    Integrable (modelPassiveKernel α lam p t g) := by
  rw [← (PiLp.volume_preserving_toLp (Fin 5)).integrable_comp_emb
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  have hfactor : (modelPassiveKernel α lam p t g ∘ WithLp.toLp 2) =
      (fun x : Fin 5 → ℝ ↦
        ∏ i : Fin 5, modelPassiveFactor α lam p t g i (x i)) := by
    funext x
    change modelPassiveKernel α lam p t g (WithLp.toLp 2 x) = _
    rfl
  rw [hfactor]
  exact Integrable.fintype_prod fun i ↦
    integrable_modelPassiveFactor α lam p t g hg hlam ht i

/-- The fixed-parameter passive mass is precisely the mass of its remaining
one-dimensional factor. -/
theorem integral_modelPassiveKernel
    (α : Anisotropy) (lam : ℝ) (p : E3) (t : ℝ) (g : ℝ → ℝ)
    (hg : Integrable g) (hlam : 0 < lam) (ht : 0 < t) :
    ∫ z : ModelE5, modelPassiveKernel α lam p t g z =
      ∫ r : ℝ, g r := by
  have hs0 : 0 < lam * t ^ α.weight 0 :=
    mul_pos hlam (pow_pos ht _)
  have hs1 : 0 < lam * t ^ α.weight 1 :=
    mul_pos hlam (pow_pos ht _)
  have h0 : ∫ x : ℝ, modelPassiveFactor α lam p t g 0 x = 1 := by
    change ∫ x : ℝ, gaussianAt (lam * t ^ α.weight 0) (p 0) x = 1
    exact integral_gaussianAt hs0 _
  have h1 : ∫ x : ℝ, modelPassiveFactor α lam p t g 1 x = 1 := by
    change ∫ x : ℝ, gaussianAt (lam * t ^ α.weight 1) (p 1) x = 1
    exact integral_gaussianAt hs1 _
  have h2 : ∫ x : ℝ, modelPassiveFactor α lam p t g 2 x = 1 := by
    change ∫ x : ℝ, gaussianAt (lam * t ^ α.weight 0) (p 0) x = 1
    exact integral_gaussianAt hs0 _
  have h3 : ∫ x : ℝ, modelPassiveFactor α lam p t g 3 x = 1 := by
    change ∫ x : ℝ, gaussianAt (lam * t ^ α.weight 1) (p 1) x = 1
    exact integral_gaussianAt hs1 _
  have h4 : ∫ x : ℝ, modelPassiveFactor α lam p t g 4 x =
      ∫ r : ℝ, g r := by
    simpa only [modelPassiveFactor]
  rw [← (PiLp.volume_preserving_toLp (Fin 5)).integral_comp
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  have hfactor : (modelPassiveKernel α lam p t g ∘ WithLp.toLp 2) =
      (fun x : Fin 5 → ℝ ↦
        ∏ i : Fin 5, modelPassiveFactor α lam p t g i (x i)) := by
    funext x
    change modelPassiveKernel α lam p t g (WithLp.toLp 2 x) = _
    rfl
  change (∫ x : Fin 5 → ℝ,
    (modelPassiveKernel α lam p t g ∘ WithLp.toLp 2) x) = _
  rw [hfactor, integral_fintype_prod_volume_eq_prod]
  have hfac (i : Fin 5) :
      ∫ x : ℝ, modelPassiveFactor α lam p t g i x =
        match i.1 with
        | 0 => 1
        | 1 => 1
        | 2 => 1
        | 3 => 1
        | _ => ∫ r : ℝ, g r := by
    fin_cases i
    · exact h0
    · exact h1
    · exact h2
    · exact h3
    · exact h4
  simp_rw [hfac]
  simp only [Fin.prod_univ_succ, Finset.prod_empty, mul_one]
  norm_num

/-- Positivity of the passive product follows from positivity of its final
translation factor on the source-scale range. -/
theorem modelPassiveKernel_nonneg
    (α : Anisotropy) (lam : ℝ) (p : E3) (t : ℝ) (g : ℝ → ℝ)
    (hgnonneg : ∀ r, 0 ≤ g r) (hlam : 1 ≤ lam) (ht : 0 < t)
    (z : ModelE5) :
    0 ≤ modelPassiveKernel α lam p t g z := by
  rw [modelPassiveKernel_eq]
  exact mul_nonneg
    (modelFirstPassiveGaussianWeight_nonneg α lam p t
      (z 0) (z 1) (z 2) (z 3) hlam ht)
    (hgnonneg (z 4))

/-- The norm mass of a nonnegative passive kernel is its final scalar mass. -/
theorem integral_norm_modelPassiveKernel
    (α : Anisotropy) (lam : ℝ) (p : E3) (t : ℝ) (g : ℝ → ℝ)
    (hg : Integrable g) (hgnonneg : ∀ r, 0 ≤ g r)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    ∫ z : ModelE5, ‖modelPassiveKernel α lam p t g z‖ =
      ∫ r : ℝ, g r := by
  have hpos : ∀ z : ModelE5, 0 ≤ modelPassiveKernel α lam p t g z :=
    fun z ↦ modelPassiveKernel_nonneg α lam p t g hgnonneg hlam ht z
  calc
    ∫ z : ModelE5, ‖modelPassiveKernel α lam p t g z‖ =
        ∫ z : ModelE5, modelPassiveKernel α lam p t g z := by
      apply integral_congr_ae
      filter_upwards [] with z
      rw [Real.norm_eq_abs, abs_of_nonneg (hpos z)]
    _ = ∫ r : ℝ, g r :=
      integral_modelPassiveKernel α lam p t g hg
        (lt_of_lt_of_le zero_lt_one hlam) ht

/-- At one source scale, a generic passive kernel is integrable jointly over
a finite box collection and all five model variables. -/
theorem integrable_modelPassiveKernel_collection_at_scale
    (α : Anisotropy) (S : BoxCollection α) (lam : ℝ) (g : ℝ → ℝ)
    (hgmeas : Measurable g) (hg : Integrable g) (hgnonneg : ∀ r, 0 ≤ g r)
    (hlam : 1 ≤ lam) :
    Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelPassiveKernel α lam q.1.1 q.1.2 g q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume) := by
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  letI : IsFiniteMeasure μ := by
    dsimp only [μ]
    exact isFiniteMeasure_cubeScaleCollection α S
  have hpos : ∀ᵐ pt ∂μ, 0 < pt.2 := by
    dsimp only [μ]
    filter_upwards [ae_restrict_mem (measurableSet_collectionRegion α S)]
      with pt hpt
    exact pos_of_mem_collectionRegion α S hpt
  have hparam : Measurable (fun q : (E3 × ℝ) × ModelE5 ↦
      (q.1, (q.2, lam))) :=
    measurable_fst.prodMk (measurable_snd.prodMk measurable_const)
  have hpassive : Measurable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelFirstPassiveGaussianWeight α lam q.1.1 q.1.2
        (q.2 0) (q.2 1) (q.2 2) (q.2 3)) := by
    convert (measurable_modelFirstPassiveGaussianWeight_lift α).comp hparam using 1
    funext q
    rfl
  have hz4 : Measurable (fun q : (E3 × ℝ) × ModelE5 ↦ q.2 4) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 5 ↦ ℝ) 4).measurable.comp
      measurable_snd
  have hmeas : AEStronglyMeasurable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelPassiveKernel α lam q.1.1 q.1.2 g q.2) (μ.prod volume) := by
    rw [show (fun q : (E3 × ℝ) × ModelE5 ↦
        modelPassiveKernel α lam q.1.1 q.1.2 g q.2) =
        (fun q ↦ modelFirstPassiveGaussianWeight α lam q.1.1 q.1.2
          (q.2 0) (q.2 1) (q.2 2) (q.2 3) * g (q.2 4)) by
      funext q
      exact modelPassiveKernel_eq α lam q.1.1 q.1.2 g q.2]
    exact (hpassive.mul (hgmeas.comp hz4)).aestronglyMeasurable
  apply (MeasureTheory.integrable_prod_iff hmeas).mpr
  constructor
  · filter_upwards [hpos] with pt hpt
    exact integrable_modelPassiveKernel α lam pt.1 pt.2 g hg
      (lt_of_lt_of_le zero_lt_one hlam) hpt
  · have hconst : Integrable (fun _ : E3 × ℝ ↦ ∫ r : ℝ, g r) μ :=
      integrable_const _
    refine hconst.congr ?_
    filter_upwards [hpos] with pt hpt
    symm
    exact integral_norm_modelPassiveKernel α lam pt.1 pt.2 g hg
      hgnonneg hlam hpt

/-- A globally measurable representative of the negative source-scale power
which agrees with it on the source range. -/
theorem measurable_safeScaleWeight_negFortySeven :
    Measurable (fun lam : ℝ ↦ (max lam 1) ^ (-47 : ℝ)) := by
  exact ((continuous_id.max continuous_const).rpow_const (fun lam ↦
    Or.inl (ne_of_gt (lt_of_lt_of_le zero_lt_one (le_max_right _ _))))).measurable

/-- The negative source-scale power is a.e.-strongly measurable on its
literal restricted source-scale measure. -/
theorem aestronglyMeasurable_scaleWeight_negFortySeven :
    AEStronglyMeasurable (fun lam : ℝ ↦ lam ^ (-47 : ℝ))
      ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))) := by
  refine measurable_safeScaleWeight_negFortySeven.aestronglyMeasurable.congr ?_
  filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
  rw [max_eq_left hlam]

/-- A finite collection makes the passive Gaussian superposition integrable
jointly in its center--scale variables, the five passive variables, and the
source scale. -/
theorem integrable_modelPassiveKernel_collection_sourceScale
    (α : Anisotropy) (S : BoxCollection α) (g : ℝ → ℝ)
    (hgmeas : Measurable g) (hg : Integrable g) (hgnonneg : ∀ r, 0 ≤ g r) :
    Integrable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
        q.2.2 ^ (-47 : ℝ))
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        ((volume : Measure ModelE5).prod
          ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))))) := by
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let e := outerLambdaShuffleRight (E3 × ℝ) ModelE5
  letI : IsFiniteMeasure μ := by
    dsimp only [μ]
    exact isFiniteMeasure_cubeScaleCollection α S
  letI : SigmaFinite μ := IsFiniteMeasure.toSigmaFinite μ
  letI : SFinite (μ.prod (volume : Measure ModelE5)) := by
    infer_instance
  have hpos : ∀ᵐ pt ∂μ, 0 < pt.2 := by
    dsimp only [μ]
    filter_upwards [ae_restrict_mem (measurableSet_collectionRegion α S)]
      with pt hpt
    exact pos_of_mem_collectionRegion α S hpt
  have hmp : MeasurePreserving e
      (μ.prod ((volume : Measure ModelE5).prod ν))
      (ν.prod (μ.prod (volume : Measure ModelE5))) := by
    simpa only [e] using outerLambdaShuffleRight_measurePreserving
      μ (volume : Measure ModelE5)
  let H : ℝ × ((E3 × ℝ) × ModelE5) → ℝ := fun q ↦
    modelPassiveKernel α q.1 q.2.1.1 q.2.1.2 g q.2.2 *
      q.1 ^ (-47 : ℝ)
  have hparam : Measurable (fun q : ℝ × ((E3 × ℝ) × ModelE5) ↦
      (q.2.1, (q.2.2, q.1))) :=
    (measurable_fst.comp measurable_snd).prodMk
      ((measurable_snd.comp measurable_snd).prodMk measurable_fst)
  have hpassive : Measurable (fun q : ℝ × ((E3 × ℝ) × ModelE5) ↦
      modelFirstPassiveGaussianWeight α q.1 q.2.1.1 q.2.1.2
        (q.2.2 0) (q.2.2 1) (q.2.2 2) (q.2.2 3)) := by
    convert (measurable_modelFirstPassiveGaussianWeight_lift α).comp
      hparam using 1
    funext q
    rfl
  have hz4 : Measurable (fun q : ℝ × ((E3 × ℝ) × ModelE5) ↦ q.2.2 4) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 5 ↦ ℝ) 4).measurable.comp
      (measurable_snd.comp measurable_snd)
  have hsafe : Measurable (fun q : ℝ × ((E3 × ℝ) × ModelE5) ↦
      modelFirstPassiveGaussianWeight α q.1 q.2.1.1 q.2.1.2
        (q.2.2 0) (q.2.2 1) (q.2.2 2) (q.2.2 3) * g (q.2.2 4) *
          (max q.1 1) ^ (-47 : ℝ)) :=
    (hpassive.mul (hgmeas.comp hz4)).mul
      (measurable_safeScaleWeight_negFortySeven.comp measurable_fst)
  have hsourceRange : ∀ᵐ q ∂(ν.prod (μ.prod (volume : Measure ModelE5))),
      q.1 ∈ Set.Ici (1 : ℝ) := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
      exact ae_of_all _ fun _ ↦ hlam
    · exact measurableSet_Ici.preimage measurable_fst
  have hHmeas : AEStronglyMeasurable H
      (ν.prod (μ.prod (volume : Measure ModelE5))) := by
    refine hsafe.aestronglyMeasurable.congr ?_
    filter_upwards [hsourceRange] with q hq
    dsimp only [H]
    rw [modelPassiveKernel_eq, max_eq_left hq]
  have hpowle (lam : ℝ) (hlam : 1 ≤ lam) :
      lam ^ (-47 : ℝ) ≤ lam ^ (-10 : ℝ) := by
    rw [show (-47 : ℝ) = (-10 : ℝ) + (-37 : ℝ) by norm_num,
      Real.rpow_add (lt_of_lt_of_le zero_lt_one hlam)]
    have hsmall : lam ^ (-37 : ℝ) ≤ 1 :=
      Real.rpow_le_one_of_one_le_of_nonpos hlam (by norm_num)
    exact (mul_le_mul_of_nonneg_left hsmall
      (Real.rpow_nonneg (le_trans zero_le_one hlam) _)).trans_eq (by ring)
  let C : ℝ := μ.real Set.univ * ∫ r : ℝ, g r
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg measureReal_nonneg (integral_nonneg hgnonneg)
  have hinner (lam : ℝ) (hlam : 1 ≤ lam) :
      (∫ yz : (E3 × ℝ) × ModelE5, ‖H (lam, yz)‖
        ∂(μ.prod (volume : Measure ModelE5))) =
        lam ^ (-47 : ℝ) * C := by
    have hK := integrable_modelPassiveKernel_collection_at_scale
      α S lam g hgmeas hg hgnonneg hlam
    have hK' : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
        modelPassiveKernel α lam q.1.1 q.1.2 g q.2) (μ.prod volume) := by
      simpa only [μ] using hK
    have hpow : 0 ≤ lam ^ (-47 : ℝ) :=
      Real.rpow_nonneg (le_trans zero_le_one hlam) _
    change (∫ yz : (E3 × ℝ) × ModelE5,
      ‖modelPassiveKernel α lam yz.1.1 yz.1.2 g yz.2 *
        lam ^ (-47 : ℝ)‖ ∂(μ.prod volume)) = _
    calc
      (∫ yz : (E3 × ℝ) × ModelE5,
          ‖modelPassiveKernel α lam yz.1.1 yz.1.2 g yz.2 *
            lam ^ (-47 : ℝ)‖ ∂(μ.prod volume)) =
          ∫ yz : (E3 × ℝ) × ModelE5,
            lam ^ (-47 : ℝ) *
              ‖modelPassiveKernel α lam yz.1.1 yz.1.2 g yz.2‖
            ∂(μ.prod volume) := by
              apply integral_congr_ae
              filter_upwards [] with yz
              rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg hpow,
                Real.norm_eq_abs]
              ring
      _ = lam ^ (-47 : ℝ) *
          ∫ yz : (E3 × ℝ) × ModelE5,
            ‖modelPassiveKernel α lam yz.1.1 yz.1.2 g yz.2‖
            ∂(μ.prod volume) := by
              rw [MeasureTheory.integral_const_mul]
      _ = lam ^ (-47 : ℝ) *
          ∫ pt : E3 × ℝ, ∫ z : ModelE5,
            ‖modelPassiveKernel α lam pt.1 pt.2 g z‖
            ∂volume ∂μ := by
              rw [MeasureTheory.integral_prod _ hK'.norm]
      _ = lam ^ (-47 : ℝ) *
          ∫ pt : E3 × ℝ, ∫ r : ℝ, g r ∂volume ∂μ := by
              congr 1
              apply integral_congr_ae
              filter_upwards [hpos] with pt hpt
              exact integral_norm_modelPassiveKernel α lam pt.1 pt.2 g
                hg hgnonneg hlam hpt
      _ = lam ^ (-47 : ℝ) * C := by
              dsimp only [C]
              rw [MeasureTheory.integral_const]
              simp only [smul_eq_mul]
  have houterMeas : AEStronglyMeasurable
      (fun lam : ℝ ↦ lam ^ (-47 : ℝ) * C) ν := by
    have hsafeouter : Measurable (fun lam : ℝ ↦
        (max lam 1) ^ (-47 : ℝ) * C) :=
      measurable_safeScaleWeight_negFortySeven.mul
        (measurable_const : Measurable (fun _ : ℝ ↦ C))
    refine hsafeouter.aestronglyMeasurable.congr ?_
    filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
    rw [max_eq_left hlam]
  have houter : Integrable (fun lam : ℝ ↦ lam ^ (-47 : ℝ) * C) ν := by
    have hbase : Integrable (fun lam : ℝ ↦ C * lam ^ (-10 : ℝ)) ν := by
      simpa only [ν] using (integrableOn_scaleWeight_negTen.const_mul C)
    apply Integrable.mono' hbase houterMeas
    filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
    have hleft : 0 ≤ lam ^ (-47 : ℝ) * C :=
      mul_nonneg (Real.rpow_nonneg (le_trans zero_le_one hlam) _) hC
    have hright : 0 ≤ C * lam ^ (-10 : ℝ) :=
      mul_nonneg hC (Real.rpow_nonneg (le_trans zero_le_one hlam) _)
    have hineq :
      lam ^ (-47 : ℝ) * C ≤ lam ^ (-10 : ℝ) * C :=
      mul_le_mul_of_nonneg_right (hpowle lam hlam) hC
    have hineq' : lam ^ (-47 : ℝ) * C ≤ C * lam ^ (-10 : ℝ) :=
      hineq.trans_eq (by ring)
    simpa only [Real.norm_eq_abs, abs_of_nonneg hleft, abs_of_nonneg hright]
      using hineq'
  have hH : Integrable H (ν.prod (μ.prod (volume : Measure ModelE5))) := by
    apply (MeasureTheory.integrable_prod_iff hHmeas).mpr
    constructor
    · filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
      have hK := integrable_modelPassiveKernel_collection_at_scale
        α S lam g hgmeas hg hgnonneg hlam
      change Integrable (fun yz : (E3 × ℝ) × ModelE5 ↦
        modelPassiveKernel α lam yz.1.1 yz.1.2 g yz.2 *
          lam ^ (-47 : ℝ)) (μ.prod volume)
      refine (hK.const_mul (lam ^ (-47 : ℝ))).congr ?_
      filter_upwards [] with yz
      ring
    · refine houter.congr ?_
      filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
      symm
      exact hinner lam hlam
  have hback : Integrable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      H (e q)) (μ.prod ((volume : Measure ModelE5).prod ν)) :=
    hmp.integrable_comp_of_integrable hH
  refine hback.congr ?_
  filter_upwards [] with q
  change H (e q) = _
  rw [outerLambdaShuffleRight_apply]

/-- Bounded continuous data make the full first-energy Gaussian
superposition integrable jointly in the collection variables, passive model
variables, and source scale. -/
theorem integrable_modelFirstSuperpositionJoint_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : ModelRealInput)
    (hfcont : ∀ j, Continuous (f j))
    (hfbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B) :
    Integrable (modelFirstSuperpositionJoint α u f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        ((volume : Measure ModelE5).prod
          ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) ) := by
  rcases hfbound 0 with ⟨B0, hB0, hf0⟩
  rcases hfbound 1 with ⟨B1, hB1, hf1⟩
  rcases hfbound 2 with ⟨B2, hB2, hf2⟩
  let g : ℝ → ℝ := fun r ↦ |conePsiPhysicalReal (r + u 2)|
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let M : ℝ := (B0 * B1 * B2) * ∫ v : ℝ, |gaussianDeriv v|
  have hgmeas : Measurable g := by
    dsimp only [g]
    exact continuous_abs.measurable.comp
      (conePsiPhysicalReal.continuous.measurable.comp
        (measurable_id.add measurable_const))
  have hg : Integrable g := by
    simpa only [g] using
      integrable_abs_conePsiPhysicalReal.comp_add_right (u 2)
  have hgnonneg : ∀ r, 0 ≤ g r := by
    intro r
    exact abs_nonneg _
  have hM : 0 ≤ M := by
    dsimp only [M]
    exact mul_nonneg (mul_nonneg (mul_nonneg hB0 hB1) hB2)
      (integral_nonneg fun v ↦ abs_nonneg (gaussianDeriv v))
  have hkernel := integrable_modelPassiveKernel_collection_sourceScale
    α S g hgmeas hg hgnonneg
  have hscale : ∀ᵐ q ∂(μ.prod ((volume : Measure ModelE5).prod ν)),
      0 < q.1.2 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · dsimp only [μ]
      filter_upwards [ae_restrict_mem (measurableSet_collectionRegion α S)]
        with pt hpt
      exact ae_of_all _ fun _ ↦ pos_of_mem_collectionRegion α S hpt
    · exact measurableSet_Ioi.preimage (measurable_snd.comp measurable_fst)
  have hlambda : ∀ᵐ q ∂(μ.prod ((volume : Measure ModelE5).prod ν)),
      1 ≤ q.2.2 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [] with pt
      rw [Measure.ae_prod_iff_ae_ae]
      · filter_upwards [] with z
        exact ae_restrict_mem measurableSet_Ici
      · exact measurableSet_Ici.preimage measurable_snd
    · exact measurableSet_Ici.preimage (measurable_snd.comp measurable_snd)
  have hmeas : AEStronglyMeasurable (modelFirstSuperpositionJoint α u f)
      (μ.prod ((volume : Measure ModelE5).prod ν)) := by
    have hfiber := aestronglyMeasurable_modelFirstFiber_lift
      α f hfcont (μ.prod ((volume : Measure ModelE5).prod ν))
    refine ((hfiber.pow 2).mul hkernel.aestronglyMeasurable).congr ?_
    filter_upwards [] with q
    change modelFirstFiber α f q.1.1 q.1.2 q.2.1 ^ 2 *
        (modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
          q.2.2 ^ (-47 : ℝ)) = _
    rw [modelPassiveKernel_eq]
    dsimp only [modelFirstSuperpositionJoint, modelFirstSuperpositionIntegrand, g]
    ring
  apply Integrable.mono' (hkernel.const_mul (M ^ 2)) hmeas
  filter_upwards [hscale, hlambda] with q ht hlam
  have hfiber : |modelFirstFiber α f q.1.1 q.1.2 q.2.1| ≤ M := by
    dsimp only [M]
    exact abs_modelFirstFiber_le α f q.1.1 q.2.1 hfcont B0 B1 B2
      hB0 hB1 hB2 hf0 hf1 hf2 ht
  have hsq : (modelFirstFiber α f q.1.1 q.1.2 q.2.1) ^ 2 ≤ M ^ 2 := by
    rw [← sq_abs]
    have hsub : 0 ≤ M - |modelFirstFiber α f q.1.1 q.1.2 q.2.1| :=
      sub_nonneg.mpr hfiber
    have hadd : 0 ≤ M + |modelFirstFiber α f q.1.1 q.1.2 q.2.1| :=
      add_nonneg hM (abs_nonneg _)
    nlinarith [mul_nonneg hsub hadd]
  have hpassive : 0 ≤ modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 :=
    modelPassiveKernel_nonneg α q.2.2 q.1.1 q.1.2 g hgnonneg hlam ht q.2.1
  have hpow : 0 ≤ q.2.2 ^ (-47 : ℝ) :=
    Real.rpow_nonneg (le_trans zero_le_one hlam) _
  have hweight : 0 ≤ modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
      q.2.2 ^ (-47 : ℝ) := mul_nonneg hpassive hpow
  have htargeteq : modelFirstSuperpositionJoint α u f q =
      modelFirstFiber α f q.1.1 q.1.2 q.2.1 ^ 2 *
        (modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
          q.2.2 ^ (-47 : ℝ)) := by
    dsimp only [modelFirstSuperpositionJoint, modelFirstSuperpositionIntegrand, g]
    rw [modelPassiveKernel_eq]
    ring
  have htarget : 0 ≤ modelFirstSuperpositionJoint α u f q := by
    rw [htargeteq]
    exact mul_nonneg (sq_nonneg _) hweight
  have hmajor : 0 ≤ M ^ 2 *
      (modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
        q.2.2 ^ (-47 : ℝ)) := mul_nonneg (sq_nonneg _) hweight
  have hle : modelFirstSuperpositionJoint α u f q ≤ M ^ 2 *
      (modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
        q.2.2 ^ (-47 : ℝ)) := by
    rw [htargeteq]
    exact mul_le_mul_of_nonneg_right hsq hweight
  simpa only [Real.norm_eq_abs, abs_of_nonneg htarget, abs_of_nonneg hmajor]
    using hle

/-- Bounded continuous data make the translated second-energy Gaussian
superposition integrable jointly in the collection variables, passive model
variables, and source scale. -/
theorem integrable_modelSecondSuperpositionJoint_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) :
    Integrable (modelSecondSuperpositionJoint α f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        ((volume : Measure ModelE5).prod
          ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) ) := by
  rcases hfbound with ⟨B, hB, hf⟩
  let g : ℝ → ℝ := fun r ↦ translationWeight r ^ (-50 : ℝ)
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let M : ℝ := B * ∫ v : ℝ, |gaussianDeriv v|
  have hRpos (r : ℝ) : 0 < translationWeight r := by
    unfold translationWeight
    positivity
  have hRone (r : ℝ) : 1 ≤ translationWeight r := by
    unfold translationWeight
    linarith [abs_nonneg r]
  have hgmeas : Measurable g := by
    dsimp only [g]
    exact ((continuous_const.add continuous_abs).rpow_const (fun r ↦
      Or.inl (ne_of_gt (hRpos r)))).measurable
  have hgnonneg : ∀ r, 0 ≤ g r := by
    intro r
    dsimp only [g]
    exact Real.rpow_nonneg (hRpos r).le _
  have hpowle (r : ℝ) :
      translationWeight r ^ (-50 : ℝ) ≤ translationWeight r ^ (-29 : ℝ) := by
    rw [show (-50 : ℝ) = (-29 : ℝ) + (-21 : ℝ) by norm_num,
      Real.rpow_add (hRpos r)]
    have hsmall : translationWeight r ^ (-21 : ℝ) ≤ 1 :=
      Real.rpow_le_one_of_one_le_of_nonpos (hRone r) (by norm_num)
    exact (mul_le_mul_of_nonneg_left hsmall
      (Real.rpow_nonneg (hRpos r).le _)).trans_eq (by ring)
  have hg : Integrable g := by
    apply Integrable.mono' integrable_translationWeight_negTwentyNine
      hgmeas.aestronglyMeasurable
    filter_upwards [] with r
    have hleft : 0 ≤ translationWeight r ^ (-50 : ℝ) := hgnonneg r
    have hright : 0 ≤ translationWeight r ^ (-29 : ℝ) :=
      Real.rpow_nonneg (hRpos r).le _
    simpa only [g, Real.norm_eq_abs, abs_of_nonneg hleft, abs_of_nonneg hright]
      using hpowle r
  have hM : 0 ≤ M := by
    dsimp only [M]
    exact mul_nonneg hB
      (integral_nonneg fun v ↦ abs_nonneg (gaussianDeriv v))
  have hkernel := integrable_modelPassiveKernel_collection_sourceScale
    α S g hgmeas hg hgnonneg
  have hscale : ∀ᵐ q ∂(μ.prod ((volume : Measure ModelE5).prod ν)),
      0 < q.1.2 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · dsimp only [μ]
      filter_upwards [ae_restrict_mem (measurableSet_collectionRegion α S)]
        with pt hpt
      exact ae_of_all _ fun _ ↦ pos_of_mem_collectionRegion α S hpt
    · exact measurableSet_Ioi.preimage (measurable_snd.comp measurable_fst)
  have hlambda : ∀ᵐ q ∂(μ.prod ((volume : Measure ModelE5).prod ν)),
      1 ≤ q.2.2 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [] with pt
      rw [Measure.ae_prod_iff_ae_ae]
      · filter_upwards [] with z
        exact ae_restrict_mem measurableSet_Ici
      · exact measurableSet_Ici.preimage measurable_snd
    · exact measurableSet_Ici.preimage (measurable_snd.comp measurable_snd)
  have hmeas : AEStronglyMeasurable (modelSecondSuperpositionJoint α f)
      (μ.prod ((volume : Measure ModelE5).prod ν)) := by
    have hfiber := aestronglyMeasurable_modelSecondFiber_lift
      α f hfcont (μ.prod ((volume : Measure ModelE5).prod ν))
    refine ((hfiber.pow 2).mul hkernel.aestronglyMeasurable).congr ?_
    filter_upwards [] with q
    change modelSecondFiber α f q.1.1 q.1.2 q.2.1 ^ 2 *
        (modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
          q.2.2 ^ (-47 : ℝ)) = _
    rw [modelPassiveKernel_eq]
    dsimp only [modelSecondSuperpositionJoint,
      modelSecondSuperpositionIntegrand, g]
    ring
  apply Integrable.mono' (hkernel.const_mul (M ^ 2)) hmeas
  filter_upwards [hscale, hlambda] with q ht hlam
  have hfiber : |modelSecondFiber α f q.1.1 q.1.2 q.2.1| ≤ M := by
    dsimp only [M]
    exact abs_modelSecondFiber_le α f q.1.1 q.2.1 hfcont B hB hf ht
  have hsq : (modelSecondFiber α f q.1.1 q.1.2 q.2.1) ^ 2 ≤ M ^ 2 := by
    rw [← sq_abs]
    have hsub : 0 ≤ M - |modelSecondFiber α f q.1.1 q.1.2 q.2.1| :=
      sub_nonneg.mpr hfiber
    have hadd : 0 ≤ M + |modelSecondFiber α f q.1.1 q.1.2 q.2.1| :=
      add_nonneg hM (abs_nonneg _)
    nlinarith [mul_nonneg hsub hadd]
  have hpassive : 0 ≤ modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 :=
    modelPassiveKernel_nonneg α q.2.2 q.1.1 q.1.2 g hgnonneg hlam ht q.2.1
  have hpow : 0 ≤ q.2.2 ^ (-47 : ℝ) :=
    Real.rpow_nonneg (le_trans zero_le_one hlam) _
  have hweight : 0 ≤ modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
      q.2.2 ^ (-47 : ℝ) := mul_nonneg hpassive hpow
  have htargeteq : modelSecondSuperpositionJoint α f q =
      modelSecondFiber α f q.1.1 q.1.2 q.2.1 ^ 2 *
        (modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
          q.2.2 ^ (-47 : ℝ)) := by
    dsimp only [modelSecondSuperpositionJoint,
      modelSecondSuperpositionIntegrand, g]
    rw [modelPassiveKernel_eq]
    ring
  have htarget : 0 ≤ modelSecondSuperpositionJoint α f q := by
    rw [htargeteq]
    exact mul_nonneg (sq_nonneg _) hweight
  have hmajor : 0 ≤ M ^ 2 *
      (modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
        q.2.2 ^ (-47 : ℝ)) := mul_nonneg (sq_nonneg _) hweight
  have hle : modelSecondSuperpositionJoint α f q ≤ M ^ 2 *
      (modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
        q.2.2 ^ (-47 : ℝ)) := by
    rw [htargeteq]
    exact mul_le_mul_of_nonneg_right hsq hweight
  simpa only [Real.norm_eq_abs, abs_of_nonneg htarget, abs_of_nonneg hmajor]
    using hle

/-- The annular physical cutoff is nonzero, hence its absolute `L¹` mass is
strictly positive.  This permits recovery of the first cube form from the
first superposition after its annular variable has been integrated out. -/
theorem conePsiPhysicalRealL1_pos : 0 < conePsiPhysicalRealL1 := by
  have hnonzero : ∃ x : ℝ, conePsiPhysicalReal x ≠ 0 := by
    classical
    by_contra h
    push_neg at h
    have hzero : conePsiPhysical = 0 := by
      ext x
      rw [← conePsiPhysical_eq_ofReal x, h x]
      norm_num
    have hfourier : conePsiSchwartz = 0 := by
      have h' := congrArg (fun G : SchwartzMap ℝ ℂ ↦ 𝓕 G) hzero
      simpa only [schwartzFourier_conePsiPhysical,
        FourierTransform.fourier_zero] using h'
    have hvalue := congrArg (fun G : SchwartzMap ℝ ℂ ↦ G (3 / 2 : ℝ)) hfourier
    rw [conePsiSchwartz_apply,
      conePsi_eq_one_on_core (by norm_num : |(3 / 2 : ℝ) - 3 / 2| ≤ 1 / 8)] at hvalue
    norm_num at hvalue
  rcases hnonzero with ⟨x, hx⟩
  unfold conePsiPhysicalRealL1
  exact integral_pos_of_integrable_nonneg_nonzero
    (continuous_abs.comp conePsiPhysicalReal.continuous)
    integrable_abs_conePsiPhysicalReal
    (fun r ↦ abs_nonneg _)
    (abs_ne_zero.mpr hx)

/-- The bounded-continuous first superposition supplies the normalized
source-scale integrability required by the full-cube tree estimate. -/
theorem integrableOn_modelFirstCubeComparison_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : ModelRealInput)
    (hfcont : ∀ j, Continuous (f j))
    (hfbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B) :
    IntegrableOn (fun lam : ℝ ↦
      localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
        lam ^ (-47 : ℝ)) (Set.Ici (1 : ℝ)) := by
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let η : Measure ModelE5 := volume
  let e := outerLambdaShuffleRight (E3 × ℝ) ModelE5
  let H : ℝ → ℝ := fun lam ↦
    ∫ xy : (E3 × ℝ) × ModelE5,
      modelFirstSuperpositionJoint α u f (xy.1, (xy.2, lam)) ∂(μ.prod η)
  have hsuper := integrable_modelFirstSuperpositionJoint_of_boundedContinuous
    α S u f hfcont hfbound
  have hFcont : ∀ j, Continuous (modelFirstCubeTuple f j) :=
    continuous_modelFirstCubeTuple f hfcont
  have hFbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y,
      |modelFirstCubeTuple f j y| ≤ B :=
    bounded_modelFirstCubeTuple f hfbound
  letI : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  have hmp : MeasurePreserving e (μ.prod (η.prod ν)) (ν.prod (μ.prod η)) := by
    simpa only [e, μ, η, ν] using
      outerLambdaShuffleRight_measurePreserving μ η
  have htrans : Integrable (fun q : ℝ × ((E3 × ℝ) × ModelE5) ↦
      modelFirstSuperpositionJoint α u f (e.symm q)) (ν.prod (μ.prod η)) := by
    exact (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hsuper
  have hfib : ∀ᵐ lam ∂ν, Integrable (fun xy : (E3 × ℝ) × ModelE5 ↦
      modelFirstSuperpositionJoint α u f
        (xy.1, (xy.2, lam))) (μ.prod η) := by
    have h := (MeasureTheory.integrable_prod_iff htrans.aestronglyMeasurable).mp
      htrans
    filter_upwards [h.1] with lam hlamint
    refine hlamint.congr ?_
    filter_upwards [] with xy
    rw [outerLambdaShuffleRight_symm_apply]
  have hlam : ∀ᵐ lam ∂ν, 1 ≤ lam := by
    filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
    exact hlam
  have hH : Integrable H ν := by
    refine htrans.integral_prod_left.congr ?_
    filter_upwards [] with lam
    dsimp only [H]
    apply integral_congr_ae
    filter_upwards [] with xy
    rw [outerLambdaShuffleRight_symm_apply]
  have hEq : H =ᵐ[ν] fun lam ↦
      conePsiPhysicalRealL1 *
        localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
          lam ^ (-47 : ℝ) := by
    filter_upwards [hfib, hlam] with lam hlamint hlam
    have hpassive := integrable_modelFirstPassiveSquare
      α S lam f false hFcont hFbound hlam
    dsimp only [H]
    calc
      ∫ xy : (E3 × ℝ) × ModelE5,
          modelFirstSuperpositionJoint α u f
            (xy.1, (xy.2, lam)) ∂(μ.prod η) =
          ∫ pt : E3 × ℝ, ∫ z : ModelE5,
            modelFirstSuperpositionJoint α u f
              (pt, (z, lam)) ∂η ∂μ :=
        MeasureTheory.integral_prod _ hlamint
      _ = ∫ pt : E3 × ℝ,
          ((∫ y : TransverseSpace 2 × TransverseSpace 2,
            cubePassiveGaussianKernel α 2 lam 0 pt.2 pt.1 y *
              (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) false
                ((pt.1, pt.2), y)) ^ 2
            ∂((volume : Measure (TransverseSpace 2)).prod
              (volume : Measure (TransverseSpace 2)))) *
            conePsiPhysicalRealL1) * lam ^ (-47 : ℝ) ∂μ := by
          apply integral_congr_ae
          filter_upwards [] with pt
          calc
            ∫ z : ModelE5,
                modelFirstSuperpositionJoint α u f
                  (pt, (z, lam)) ∂η =
                (∫ z : ModelE5,
                  (modelFirstFiber α f pt.1 pt.2 z) ^ 2 *
                    |conePsiPhysicalReal (z 4 + u 2)| *
                    modelFirstPassiveGaussianWeight α lam pt.1 pt.2
                      (z 0) (z 1) (z 2) (z 3)) * lam ^ (-47 : ℝ) := by
                  rw [← MeasureTheory.integral_mul_const]
                  apply integral_congr_ae
                  filter_upwards [] with z
                  dsimp only [modelFirstSuperpositionJoint,
                    modelFirstSuperpositionIntegrand]
            _ = _ := by
              rw [integral_modelFirstFiber_sq_psi_passiveWeight
                α lam f false pt.1 pt.2 (u 2)]
      _ = conePsiPhysicalRealL1 *
          (∫ pt : E3 × ℝ,
            ∫ y : TransverseSpace 2 × TransverseSpace 2,
              cubePassiveGaussianKernel α 2 lam 0 pt.2 pt.1 y *
                (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) false
                  ((pt.1, pt.2), y)) ^ 2
              ∂((volume : Measure (TransverseSpace 2)).prod
                (volume : Measure (TransverseSpace 2))) ∂μ) *
            lam ^ (-47 : ℝ) := by
              rw [show (∫ pt : E3 × ℝ,
                  ((∫ y : TransverseSpace 2 × TransverseSpace 2,
                    cubePassiveGaussianKernel α 2 lam 0 pt.2 pt.1 y *
                      (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) false
                        ((pt.1, pt.2), y)) ^ 2
                    ∂((volume : Measure (TransverseSpace 2)).prod
                      (volume : Measure (TransverseSpace 2)))) *
                    conePsiPhysicalRealL1) * lam ^ (-47 : ℝ) ∂μ) =
                  (conePsiPhysicalRealL1 * lam ^ (-47 : ℝ)) *
                    ∫ pt : E3 × ℝ,
                      ∫ y : TransverseSpace 2 × TransverseSpace 2,
                        cubePassiveGaussianKernel α 2 lam 0 pt.2 pt.1 y *
                          (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) false
                            ((pt.1, pt.2), y)) ^ 2
                        ∂((volume : Measure (TransverseSpace 2)).prod
                          (volume : Measure (TransverseSpace 2))) ∂μ by
                    rw [← MeasureTheory.integral_const_mul]
                    apply integral_congr_ae
                    filter_upwards [] with pt
                    ring]
              ring
      _ = conePsiPhysicalRealL1 *
          localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
            lam ^ (-47 : ℝ) := by
              rw [← (MeasureTheory.integral_prod _ hpassive)]
              rw [← localCubeForm_modelFirst_eq_passiveSquare
                α S lam f false hFcont hFbound hlam]
  have hscaled : Integrable (fun lam ↦
      conePsiPhysicalRealL1 *
        localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
          lam ^ (-47 : ℝ)) ν := hH.congr hEq
  have hpositive := conePsiPhysicalRealL1_pos
  have hform := hscaled.const_mul conePsiPhysicalRealL1⁻¹
  refine hform.congr ?_
  filter_upwards [] with lam
  field_simp [ne_of_gt hpositive]

/-- The joint coordinate reordering for the second superposition: source
scale and translation become the two outer variables, while the collection
and transverse passive variables are retained as the inner block. -/
noncomputable def modelSecondSuperpositionShuffle :
    (E3 × ℝ) × (ModelE5 × ℝ) ≃ᵐ
      (ℝ × ℝ) × ((E3 × ℝ) ×
        (TransverseSpace 2 × TransverseSpace 2)) :=
  (((((outerLambdaShuffleRight (E3 × ℝ) ModelE5).trans
    (MeasurableEquiv.prodAssoc.symm :
      ℝ × ((E3 × ℝ) × ModelE5) ≃ᵐ (ℝ × (E3 × ℝ)) × ModelE5)).trans
    (modelFirstPassiveCoordinatesProd (ℝ × (E3 × ℝ)))).trans
    (crossShuffle ℝ (E3 × ℝ)
      (TransverseSpace 2 × TransverseSpace 2) ℝ)).trans
    (MeasurableEquiv.prodComm :
      ((TransverseSpace 2 × TransverseSpace 2) × (E3 × ℝ)) × (ℝ × ℝ) ≃ᵐ
        (ℝ × ℝ) × ((TransverseSpace 2 × TransverseSpace 2) × (E3 × ℝ)))).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (ℝ × ℝ))
      (MeasurableEquiv.prodComm :
        (TransverseSpace 2 × TransverseSpace 2) × (E3 × ℝ) ≃ᵐ
          (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2)))

@[simp] theorem modelSecondSuperpositionShuffle_apply
    (pt : E3 × ℝ) (z : ModelE5) (lam : ℝ) :
    modelSecondSuperpositionShuffle (pt, (z, lam)) =
      ((lam, z 4),
        (pt, modelFirstPassivePair (z 0) (z 1) (z 2) (z 3))) := by
  simp [modelSecondSuperpositionShuffle, outerLambdaShuffleRight,
    MeasurableEquiv.prodAssoc, MeasurableEquiv.prodComm,
    MeasurableEquiv.prodCongr, modelFirstPassiveCoordinatesProd_apply,
    crossShuffle, swapMiddle]

@[simp] theorem modelSecondSuperpositionShuffle_symm_apply
    (lam r : ℝ) (pt : E3 × ℝ)
    (y : TransverseSpace 2 × TransverseSpace 2) :
    modelSecondSuperpositionShuffle.symm ((lam, r), (pt, y)) =
      (pt, (modelFirstPassiveCoordinates.symm (y, r), lam)) := by
  apply modelSecondSuperpositionShuffle.injective
  rw [MeasurableEquiv.apply_symm_apply,
    modelSecondSuperpositionShuffle_apply,
    modelFirstPassiveCoordinates_symm_translation,
    modelFirstPassiveCoordinates_symm_passive]

/-- The second-superposition shuffle preserves the exact product measures
used by the source-scale/translation Fubini argument. -/
theorem modelSecondSuperpositionShuffle_measurePreserving
    (μ : Measure (E3 × ℝ)) [SFinite μ] :
    MeasurePreserving modelSecondSuperpositionShuffle
      (μ.prod ((volume : Measure ModelE5).prod
        ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))))
      ((((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))).prod volume).prod
        (μ.prod ((volume : Measure (TransverseSpace 2)).prod
          (volume : Measure (TransverseSpace 2))))) := by
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let η : Measure ModelE5 := volume
  let κ : Measure (TransverseSpace 2 × TransverseSpace 2) :=
    (volume : Measure (TransverseSpace 2)).prod volume
  letI : SFinite ν := by
    dsimp only [ν]
    infer_instance
  letI : SFinite (ν.prod (volume : Measure ℝ)) := by
    infer_instance
  have h₁ : MeasurePreserving (outerLambdaShuffleRight (E3 × ℝ) ModelE5)
      (μ.prod (η.prod ν)) (ν.prod (μ.prod η)) := by
    simpa only [ν, η] using
      outerLambdaShuffleRight_measurePreserving μ η
  have h₂ : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        ℝ × ((E3 × ℝ) × ModelE5) ≃ᵐ (ℝ × (E3 × ℝ)) × ModelE5)
      (ν.prod (μ.prod η)) ((ν.prod μ).prod η) :=
    (measurePreserving_prodAssoc ν μ η).symm
  have h₃ : MeasurePreserving
      (modelFirstPassiveCoordinatesProd (ℝ × (E3 × ℝ)))
      ((ν.prod μ).prod η) ((ν.prod μ).prod (κ.prod volume)) := by
    simpa only [κ, η] using
      modelFirstPassiveCoordinatesProd_measurePreserving (ν.prod μ)
  have h₄ : MeasurePreserving
      (crossShuffle ℝ (E3 × ℝ)
        (TransverseSpace 2 × TransverseSpace 2) ℝ)
      ((ν.prod μ).prod (κ.prod volume))
      ((κ.prod μ).prod (ν.prod volume)) := by
    simpa only [κ] using
      crossShuffle_measurePreserving ℝ (E3 × ℝ)
        (TransverseSpace 2 × TransverseSpace 2) ℝ ν μ κ volume
  have h₅ : MeasurePreserving
      (MeasurableEquiv.prodComm :
        ((TransverseSpace 2 × TransverseSpace 2) × (E3 × ℝ)) × (ℝ × ℝ) ≃ᵐ
          (ℝ × ℝ) × ((TransverseSpace 2 × TransverseSpace 2) × (E3 × ℝ)))
      ((κ.prod μ).prod (ν.prod volume))
      ((ν.prod volume).prod (κ.prod μ)) :=
    Measure.measurePreserving_swap
  have h₆ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (ℝ × ℝ))
        (MeasurableEquiv.prodComm :
          (TransverseSpace 2 × TransverseSpace 2) × (E3 × ℝ) ≃ᵐ
            (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2)))
      ((ν.prod volume).prod (κ.prod μ))
      ((ν.prod volume).prod (μ.prod κ)) := by
    convert (MeasurePreserving.id (ν.prod volume)).prod
      (Measure.measurePreserving_swap : MeasurePreserving Prod.swap
        (κ.prod μ) (μ.prod κ)) using 1 <;> try infer_instance
    funext q
    rfl
  simpa only [modelSecondSuperpositionShuffle, ν, η, κ] using
    (((((h₁.trans h₂).trans h₃).trans h₄).trans h₅).trans h₆)

/-- The bounded-continuous second superposition supplies the joint
source-scale/translation integrability required by the edge-tree estimate. -/
theorem integrable_modelSecondCubeComparison_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) :
    Integrable (fun z : ℝ × ℝ ↦
      localCubeForm α S 2 z.1 z.2 (edgeCubeTuple f) *
        translationWeight z.2 ^ (-50 : ℝ) * z.1 ^ (-47 : ℝ))
      (((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))).prod volume) := by
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let κ : Measure (TransverseSpace 2 × TransverseSpace 2) :=
    (volume : Measure (TransverseSpace 2)).prod volume
  letI : IsFiniteMeasure μ := by
    dsimp only [μ]
    exact isFiniteMeasure_cubeScaleCollection α S
  letI : SFinite ν := by
    dsimp only [ν]
    infer_instance
  letI : SFinite (ν.prod (volume : Measure ℝ)) := by infer_instance
  letI : SFinite κ := by
    dsimp only [κ]
    infer_instance
  letI : SFinite (μ.prod κ) := by infer_instance
  let e := modelSecondSuperpositionShuffle
  let G : (ℝ × ℝ) × ((E3 × ℝ) ×
      (TransverseSpace 2 × TransverseSpace 2)) → ℝ := fun q ↦
    cubePassiveGaussianKernel α 2 q.1.1 q.1.2 q.2.1.2 q.2.1.1 q.2.2 *
      (cubeActiveCSAverage α 2 q.1.1 q.1.2 (edgeCubeTuple f) false q.2) ^ 2 *
        translationWeight q.1.2 ^ (-50 : ℝ) * q.1.1 ^ (-47 : ℝ)
  have hsuper := integrable_modelSecondSuperpositionJoint_of_boundedContinuous
    α S f hfcont hfbound
  have hmp : MeasurePreserving e
      (μ.prod ((volume : Measure ModelE5).prod ν))
      ((ν.prod volume).prod (μ.prod κ)) := by
    simpa only [e, μ, ν, κ] using
      modelSecondSuperpositionShuffle_measurePreserving μ
  have htransport : Integrable (fun q : (ℝ × ℝ) × ((E3 × ℝ) ×
      (TransverseSpace 2 × TransverseSpace 2)) ↦
      modelSecondSuperpositionJoint α f (e.symm q))
      ((ν.prod volume).prod (μ.prod κ)) := by
    exact (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hsuper
  have hkernel : Integrable G ((ν.prod volume).prod (μ.prod κ)) := by
    refine htransport.congr ?_
    filter_upwards [] with q
    rcases q with ⟨⟨lam, r⟩, ⟨pt, y⟩⟩
    change modelSecondSuperpositionJoint α f
        (e.symm ((lam, r), (pt, y))) = G ((lam, r), (pt, y))
    rw [show e = modelSecondSuperpositionShuffle by rfl,
      modelSecondSuperpositionShuffle_symm_apply]
    dsimp only [G, modelSecondSuperpositionJoint,
      modelSecondSuperpositionIntegrand]
    rw [← cubeActiveCSAverage_modelSecond α lam f false pt.1 pt.2
      (modelFirstPassiveCoordinates.symm (y, r)),
      ← cubePassiveGaussianKernel_modelFirst α lam r pt.1 pt.2
        ((modelFirstPassiveCoordinates.symm (y, r)) 0)
        ((modelFirstPassiveCoordinates.symm (y, r)) 1)
        ((modelFirstPassiveCoordinates.symm (y, r)) 2)
        ((modelFirstPassiveCoordinates.symm (y, r)) 3),
      modelFirstPassiveCoordinates_symm_passive,
      modelFirstPassiveCoordinates_symm_translation]
    ring
  have houter : Integrable (fun lr : ℝ × ℝ ↦
      ∫ w : (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2),
        G (lr, w) ∂(μ.prod κ)) (ν.prod volume) :=
    hkernel.integral_prod_left
  have hlam : ∀ᵐ lr ∂(ν.prod (volume : Measure ℝ)), 1 ≤ lr.1 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
      exact ae_of_all _ fun _ ↦ hlam
    · exact measurableSet_Ici.preimage measurable_fst
  refine houter.congr ?_
  filter_upwards [hlam] with lr hlr
  have hform : localCubeForm α S 2 lr.1 lr.2 (edgeCubeTuple f) =
      ∫ w : (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2),
        cubePassiveGaussianKernel α 2 lr.1 lr.2 w.1.2 w.1.1 w.2 *
          (cubeActiveCSAverage α 2 lr.1 lr.2 (edgeCubeTuple f) false w) ^ 2
        ∂(μ.prod κ) := by
    simpa only [μ, κ] using localCubeForm_edge_eq_passiveSquare
      α S lr.1 lr.2 f false hfcont hfbound hlr
  dsimp only [G]
  calc
    (∫ w : (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2),
        cubePassiveGaussianKernel α 2 lr.1 lr.2 w.1.2 w.1.1 w.2 *
          (cubeActiveCSAverage α 2 lr.1 lr.2 (edgeCubeTuple f) false w) ^ 2 *
            translationWeight lr.2 ^ (-50 : ℝ) * lr.1 ^ (-47 : ℝ)
        ∂(μ.prod κ)) =
        (translationWeight lr.2 ^ (-50 : ℝ) * lr.1 ^ (-47 : ℝ)) *
          ∫ w : (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2),
            cubePassiveGaussianKernel α 2 lr.1 lr.2 w.1.2 w.1.1 w.2 *
              (cubeActiveCSAverage α 2 lr.1 lr.2 (edgeCubeTuple f) false w) ^ 2
            ∂(μ.prod κ) := by
              rw [← MeasureTheory.integral_const_mul]
              apply integral_congr_ae
              filter_upwards [] with w
              ring
    _ = localCubeForm α S 2 lr.1 lr.2 (edgeCubeTuple f) *
        translationWeight lr.2 ^ (-50 : ℝ) * lr.1 ^ (-47 : ℝ) := by
          rw [← hform]
          ring

/-- Bounded continuous source data meet all four literal integrability inputs
to the source-stopping tree energy estimates. -/
theorem sourceStoppingTreeEnergyIntegrability_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (f : ModelRealInput)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B) :
    sourceStoppingTreeEnergyIntegrability α S hS u f := by
  intro n Q
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact integrable_modelFirstSuperpositionJoint_of_boundedContinuous
      α (sourceStoppingTree α S hS f n Q).boxes u f hcont hbound
  · exact integrableOn_modelFirstCubeComparison_of_boundedContinuous
      α (sourceStoppingTree α S hS f n Q).boxes u f hcont hbound
  · exact integrable_modelSecondSuperpositionJoint_of_boundedContinuous
      α (sourceStoppingTree α S hS f n Q).boxes (f 3) (hcont 3) (hbound 3)
  · exact integrable_modelSecondCubeComparison_of_boundedContinuous
      α (sourceStoppingTree α S hS f n Q).boxes (f 3) (hcont 3) (hbound 3)

/-- The two stopping-tree analytic hypotheses are automatic for bounded
continuous input functions and a bounded measurable scale coefficient. -/
theorem sourceStoppingTreeAnalyticPremises_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (hcmeas : Measurable c)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    sourceStoppingTreeCS α S hS u c f ∧
      sourceStoppingTreeEnergyIntegrability α S hS u f := by
  exact ⟨sourceStoppingTreeCS_of_boundedContinuous
      α S hS u c f hcmeas hcont hbound hc,
    sourceStoppingTreeEnergyIntegrability_of_boundedContinuous
      α S hS u f hcont hbound⟩

/-- The stopping-tree analytic premises specialize directly to real Schwartz
input tuples used in the initial model range. -/
theorem initialModel_sourceStoppingTreeAnalyticPremises
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (F : InitialModelSchwartzInput)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1) :
    sourceStoppingTreeCS α S hS u c (InitialModelRealInput F) ∧
      sourceStoppingTreeEnergyIntegrability α S hS u (InitialModelRealInput F) := by
  exact sourceStoppingTreeAnalyticPremises_of_boundedContinuous
    α S hS u c (InitialModelRealInput F) hcmeas
    (initialModelRealInput_continuous F) (initialModelRealInput_bounded F) hc

/-- The literal three-cone Calderón density.  Naming it makes the passage
from a scalar identity to a complex multiplier identity explicit. -/
noncomputable def coneProductCalderonIntegrand
    (α : Anisotropy) (ξ : E3) (t : ℝ) : ℝ :=
  (((α.weight 0 : ℝ) * conePsi (t ^ (α.weight 0) * ξ 0) *
      gaussianDeriv (t ^ (α.weight 0) * ξ 0) ^ 2) *
    conePhi (t ^ (α.weight 1) * ξ 1) *
      conePhi (t ^ (α.weight 2) * ξ 2) +
    conePhi (t ^ (α.weight 0) * ξ 0) *
      ((α.weight 1 : ℝ) * conePsi (t ^ (α.weight 1) * ξ 1) *
        gaussianDeriv (t ^ (α.weight 1) * ξ 1) ^ 2) *
        conePhi (t ^ (α.weight 2) * ξ 2) +
    conePhi (t ^ (α.weight 0) * ξ 0) *
      conePhi (t ^ (α.weight 1) * ξ 1) *
        ((α.weight 2 : ℝ) * conePsi (t ^ (α.weight 2) * ξ 2) *
          gaussianDeriv (t ^ (α.weight 2) * ξ 2) ^ 2)) / t

theorem integral_coneProductCalderonIntegrand
    (α : Anisotropy) (ξ : E3) (a b : ℝ)
    (ha : 0 < a) (hab : a ≤ b)
    (hsmall : coneProduct α ξ a = cPsi ^ 3)
    (hlarge : coneProduct α ξ b = 0) :
    ∫ t in a..b, coneProductCalderonIntegrand α ξ t = cPsi ^ 3 := by
  simpa only [coneProductCalderonIntegrand] using
    calderon_coneProduct_interval_of_endpoints α ξ a b ha hab hsmall hlarge

/-- The finite cone-product Calderón identity may be multiplied by an
arbitrary complex symbol value before the Fourier-side calculation. -/
theorem multiplier_coneProduct_interval
    (α : Anisotropy) (m : E3 → ℂ) (ξ : E3) (a b : ℝ)
    (ha : 0 < a) (hab : a ≤ b)
    (hsmall : coneProduct α ξ a = cPsi ^ 3)
    (hlarge : coneProduct α ξ b = 0) :
    m ξ = ((cPsi : ℂ) ^ 3)⁻¹ *
      ∫ t in a..b, m ξ * (coneProductCalderonIntegrand α ξ t : ℂ) := by
  have hscalar := integral_coneProductCalderonIntegrand
    α ξ a b ha hab hsmall hlarge
  have hscalarC :
      (∫ t in a..b, (coneProductCalderonIntegrand α ξ t : ℂ)) =
        (cPsi : ℂ) ^ 3 := by
    rw [intervalIntegral.integral_ofReal]
    norm_cast
  have hfactor :
      (∫ t in a..b, m ξ * (coneProductCalderonIntegrand α ξ t : ℂ)) =
        m ξ * ∫ t in a..b, (coneProductCalderonIntegrand α ξ t : ℂ) := by
    rw [intervalIntegral.integral_const_mul]
  rw [hfactor, hscalarC]
  have hc : (cPsi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr cPsi_pos.ne'
  field_simp [hc]

/-- Every nonzero frequency admits a finite cone interval giving the exact
multiplier-valued Calderón identity. -/
theorem exists_multiplier_coneProduct_interval
    (α : Anisotropy) (m : E3 → ℂ) (ξ : E3) (hξ : ξ ≠ 0) :
    ∃ a b : ℝ, 0 < a ∧ a ≤ b ∧
      m ξ = ((cPsi : ℂ) ^ 3)⁻¹ *
        ∫ t in a..b, m ξ *
          (coneProductCalderonIntegrand α ξ t : ℂ) := by
  obtain ⟨a, b, ha, hab, hsmall, hlarge⟩ :=
    exists_coneProduct_endpoints α ξ hξ
  exact ⟨a, b, ha, hab,
    multiplier_coneProduct_interval α m ξ a b ha hab hsmall hlarge⟩

/-- Group the two low-frequency/Gaussian pairs in the five scalar inner
variables, leaving the translation tail last. -/
noncomputable def innerPairReorder :
    ScratchModelEnergyInner ≃ᵐ (ℝ × ℝ) × ((ℝ × ℝ) × ℝ) :=
  ((((MeasurableEquiv.prodAssoc :
      (ℝ × ℝ) × (ℝ × (ℝ × ℝ)) ≃ᵐ ℝ × (ℝ × (ℝ × (ℝ × ℝ)))).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
      (swapMiddle ℝ ℝ (ℝ × ℝ)))).trans
    (MeasurableEquiv.prodAssoc.symm :
      ℝ × (ℝ × (ℝ × (ℝ × ℝ))) ≃ᵐ
        (ℝ × ℝ) × (ℝ × (ℝ × ℝ)))).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (ℝ × ℝ))
      (MeasurableEquiv.prodAssoc.symm :
        ℝ × (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) × ℝ)))

@[simp] theorem innerPairReorder_apply
    (p₀ p₁ y₁ y₂ r : ℝ) :
    innerPairReorder ((p₀, p₁), (y₁, (y₂, r))) =
      ((p₀, y₁), ((p₁, y₂), r)) := by
  simp [innerPairReorder, swapMiddle,
    MeasurableEquiv.prodAssoc, MeasurableEquiv.prodComm,
    MeasurableEquiv.prodCongr]

/-- The inner pair regrouping preserves the literal fivefold Lebesgue
product measure. -/
theorem innerPairReorder_measurePreserving :
    MeasurePreserving innerPairReorder
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))
      (((volume : Measure ℝ).prod volume).prod
        (((volume : Measure ℝ).prod volume).prod volume)) := by
  let h₁ : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        (ℝ × ℝ) × (ℝ × (ℝ × ℝ)) ≃ᵐ ℝ × (ℝ × (ℝ × (ℝ × ℝ))))
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))
      ((volume : Measure ℝ).prod
        ((volume : Measure ℝ).prod
          ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))) :=
    measurePreserving_prodAssoc volume volume
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))
  let h₂ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
        (swapMiddle ℝ ℝ (ℝ × ℝ)))
      ((volume : Measure ℝ).prod
        ((volume : Measure ℝ).prod
          ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))))
      ((volume : Measure ℝ).prod
        ((volume : Measure ℝ).prod
          ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))) :=
    (MeasurePreserving.id (volume : Measure ℝ)).prod
      (swapMiddle_measurePreserving ℝ ℝ (ℝ × ℝ)
        volume volume ((volume : Measure ℝ).prod volume))
  let h₃ : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        ℝ × (ℝ × (ℝ × (ℝ × ℝ))) ≃ᵐ
          (ℝ × ℝ) × (ℝ × (ℝ × ℝ)))
      ((volume : Measure ℝ).prod
        ((volume : Measure ℝ).prod
          ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))))
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) :=
    (measurePreserving_prodAssoc volume volume
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))).symm
  let h₄ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (ℝ × ℝ))
        (MeasurableEquiv.prodAssoc.symm :
          ℝ × (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) × ℝ))
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))
      (((volume : Measure ℝ).prod volume).prod
        (((volume : Measure ℝ).prod volume).prod volume)) :=
    (MeasurePreserving.id ((volume : Measure ℝ).prod volume)).prod
      (measurePreserving_prodAssoc (volume : Measure ℝ)
        (volume : Measure ℝ) (volume : Measure ℝ)).symm
  simpa only [innerPairReorder] using ((h₁.trans h₂).trans h₃).trans h₄

/-- Two independent low-frequency/Gaussian pairs may be multiplied with any
integrable translation tail on the literal fivefold product space. -/
theorem integrable_two_modelPhi_gaussian_pairs_mul_tail
    (s₀ s₁ c₀ c₁ x₀ x₁ : ℝ) (hs₀ : 0 < s₀) (hs₁ : 0 < s₁)
    (T : ℝ → ℝ) (hT : Integrable T) :
    Integrable (fun z : (ℝ × ℝ) × ((ℝ × ℝ) × ℝ) ↦
      (|modelPhiAt s₀ (z.1.1 + c₀) x₀| * gaussianAt s₀ z.1.1 z.1.2) *
        ((|modelPhiAt s₁ (z.2.1.1 + c₁) x₁| *
          gaussianAt s₁ z.2.1.1 z.2.1.2) * T z.2.2))
      (((volume : Measure ℝ).prod volume).prod
        (((volume : Measure ℝ).prod volume).prod volume)) := by
  let P₀ : ℝ × ℝ → ℝ := fun z ↦
    |modelPhiAt s₀ (z.1 + c₀) x₀| * gaussianAt s₀ z.1 z.2
  let P₁ : ℝ × ℝ → ℝ := fun z ↦
    |modelPhiAt s₁ (z.1 + c₁) x₁| * gaussianAt s₁ z.1 z.2
  have hP₀ : Integrable P₀ ((volume : Measure ℝ).prod volume) := by
    simpa only [P₀] using integrable_modelPhi_gaussian_pair
      s₀ c₀ x₀ hs₀
  have hP₁ : Integrable P₁ ((volume : Measure ℝ).prod volume) := by
    simpa only [P₁] using integrable_modelPhi_gaussian_pair
      s₁ c₁ x₁ hs₁
  have hP₁T : Integrable (fun z : (ℝ × ℝ) × ℝ ↦ P₁ z.1 * T z.2)
      (((volume : Measure ℝ).prod volume).prod volume) :=
    hP₁.mul_prod hT
  have hmain := hP₀.mul_prod hP₁T
  simpa only [P₀, P₁] using hmain

/-- The exact scalar mass of the two pair factors is the square of the
absolute low-frequency kernel mass. -/
theorem integral_two_modelPhi_gaussian_pairs_mul_tail
    (s₀ s₁ c₀ c₁ x₀ x₁ : ℝ) (hs₀ : 0 < s₀) (hs₁ : 0 < s₁)
    (T : ℝ → ℝ) :
    (∫ z : (ℝ × ℝ) × ((ℝ × ℝ) × ℝ),
      (|modelPhiAt s₀ (z.1.1 + c₀) x₀| * gaussianAt s₀ z.1.1 z.1.2) *
        ((|modelPhiAt s₁ (z.2.1.1 + c₁) x₁| *
          gaussianAt s₁ z.2.1.1 z.2.1.2) * T z.2.2) ∂
          (((volume : Measure ℝ).prod volume).prod
            (((volume : Measure ℝ).prod volume).prod volume))) =
      (∫ r : ℝ, T r) * (∫ w : ℝ, |conePhiPhysicalReal w|) ^ 2 := by
  let P₀ : ℝ × ℝ → ℝ := fun z ↦
    |modelPhiAt s₀ (z.1 + c₀) x₀| * gaussianAt s₀ z.1 z.2
  let P₁ : ℝ × ℝ → ℝ := fun z ↦
    |modelPhiAt s₁ (z.1 + c₁) x₁| * gaussianAt s₁ z.1 z.2
  let A : ℝ := ∫ w : ℝ, |conePhiPhysicalReal w|
  calc
    (∫ z : (ℝ × ℝ) × ((ℝ × ℝ) × ℝ),
      (|modelPhiAt s₀ (z.1.1 + c₀) x₀| * gaussianAt s₀ z.1.1 z.1.2) *
        ((|modelPhiAt s₁ (z.2.1.1 + c₁) x₁| *
          gaussianAt s₁ z.2.1.1 z.2.1.2) * T z.2.2) ∂
          (((volume : Measure ℝ).prod volume).prod
            (((volume : Measure ℝ).prod volume).prod volume))) =
        (∫ a : ℝ × ℝ, P₀ a ∂((volume : Measure ℝ).prod volume)) *
          ∫ b : (ℝ × ℝ) × ℝ, P₁ b.1 * T b.2 ∂
            (((volume : Measure ℝ).prod volume).prod volume) := by
            simpa only [P₀, P₁] using
              integral_prod_mul (μ := (volume : Measure ℝ).prod volume)
                (ν := ((volume : Measure ℝ).prod volume).prod volume)
                P₀ (fun b : (ℝ × ℝ) × ℝ ↦ P₁ b.1 * T b.2)
    _ = A * (A * ∫ r : ℝ, T r) := by
          rw [show (∫ a : ℝ × ℝ, P₀ a ∂((volume : Measure ℝ).prod volume)) = A by
            dsimp [P₀, A]
            exact integral_modelPhi_gaussian_pair s₀ c₀ x₀ hs₀,
            show (∫ b : (ℝ × ℝ) × ℝ, P₁ b.1 * T b.2 ∂
                (((volume : Measure ℝ).prod volume).prod volume)) =
              (∫ b : ℝ × ℝ, P₁ b ∂((volume : Measure ℝ).prod volume)) * ∫ r : ℝ, T r by
                exact integral_prod_mul (μ := (volume : Measure ℝ).prod volume)
                  (ν := (volume : Measure ℝ)) P₁ T,
            show (∫ b : ℝ × ℝ, P₁ b ∂((volume : Measure ℝ).prod volume)) = A by
              dsimp [P₁, A]
              exact integral_modelPhi_gaussian_pair s₁ c₁ x₁ hs₁]
    _ = (∫ r : ℝ, T r) * (∫ w : ℝ, |conePhiPhysicalReal w|) ^ 2 := by
          dsimp [A]
          ring

/-- Once the reduced translation tail is integrable, the literal five scalar
variables in a reordered second-energy fiber are jointly integrable. -/
theorem integrable_reordered_inner_of_tail
    (α : Anisotropy) (u : E3) (f : E3 → ℝ)
    (x₁ x₂ p₂ t : ℝ) (ht : 0 < t)
    (T : ℝ → ℝ)
    (hT : ∀ r : ℝ, T r =
      (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
        |conePsiPhysicalReal (r + u 2)|)
    (hTint : Integrable T) :
    Integrable (fun v : ScratchModelEnergyInner ↦
      (modelSecondFiberReduced α f x₁ x₂ p₂ t v.2.2.2) ^ 2 *
        modelEnergyDensityReordered α u x₁ x₂ t
          v.1.1 v.1.2 v.2.1 v.2.2.1 v.2.2.2)
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) := by
  let s₀ : ℝ := t ^ α.weight 0
  let s₁ : ℝ := t ^ α.weight 1
  have hs₀ : 0 < s₀ := by
    dsimp [s₀]
    exact pow_pos ht _
  have hs₁ : 0 < s₁ := by
    dsimp [s₁]
    exact pow_pos ht _
  let H : (ℝ × ℝ) × ((ℝ × ℝ) × ℝ) → ℝ := fun z ↦
    (|modelPhiAt s₀ (z.1.1 + s₀ * u 0) x₁| * gaussianAt s₀ z.1.1 z.1.2) *
      ((|modelPhiAt s₁ (z.2.1.1 + s₁ * u 1) x₂| *
        gaussianAt s₁ z.2.1.1 z.2.1.2) * T z.2.2)
  have hH : Integrable H
      (((volume : Measure ℝ).prod volume).prod
        (((volume : Measure ℝ).prod volume).prod volume)) := by
    simpa only [H] using
      integrable_two_modelPhi_gaussian_pairs_mul_tail
        s₀ s₁ (s₀ * u 0) (s₁ * u 1) x₁ x₂ hs₀ hs₁ T hTint
  have hcomp := innerPairReorder_measurePreserving
    |>.integrable_comp_of_integrable hH
  apply hcomp.congr
  filter_upwards [] with v
  rcases v with ⟨⟨p₀, p₁⟩, ⟨y₁, ⟨y₂, r⟩⟩⟩
  dsimp [H, s₀, s₁]
  rw [innerPairReorder_apply, hT r]
  unfold modelEnergyDensityReordered
  ring

/-- The norm integral of a reordered scalar fiber is exactly its reduced
translation-tail mass times the square of the two low-frequency masses. -/
theorem integral_norm_reordered_inner_of_tail
    (α : Anisotropy) (u : E3) (f : E3 → ℝ)
    (x₁ x₂ p₂ t : ℝ) (ht : 0 < t)
    (T : ℝ → ℝ)
    (hT : ∀ r : ℝ, T r =
      (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
        |conePsiPhysicalReal (r + u 2)|)
    (hTint : Integrable T) :
    (∫ v : ScratchModelEnergyInner,
      ‖(modelSecondFiberReduced α f x₁ x₂ p₂ t v.2.2.2) ^ 2 *
        modelEnergyDensityReordered α u x₁ x₂ t
          v.1.1 v.1.2 v.2.1 v.2.2.1 v.2.2.2‖ ∂
        (((volume : Measure ℝ).prod volume).prod
          ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))) =
      (∫ r : ℝ, T r) * (∫ w : ℝ, |conePhiPhysicalReal w|) ^ 2 := by
  let H : ScratchModelEnergyInner → ℝ := fun v ↦
    (modelSecondFiberReduced α f x₁ x₂ p₂ t v.2.2.2) ^ 2 *
      modelEnergyDensityReordered α u x₁ x₂ t
        v.1.1 v.1.2 v.2.1 v.2.2.1 v.2.2.2
  have hH : Integrable H
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) := by
    exact integrable_reordered_inner_of_tail
      α u f x₁ x₂ p₂ t ht T hT hTint
  have hgauss (s p y : ℝ) (hs : 0 < s) : 0 ≤ gaussianAt s p y := by
    unfold gaussianAt kernelAt kernelDilate
    exact mul_nonneg (inv_pos.mpr hs).le (gaussian_nonneg _)
  have hHnonneg (v : ScratchModelEnergyInner) : 0 ≤ H v := by
    rcases v with ⟨⟨p₀, p₁⟩, ⟨y₁, ⟨y₂, r⟩⟩⟩
    dsimp [H]
    unfold modelEnergyDensityReordered
    exact mul_nonneg (sq_nonneg _)
      (mul_nonneg
        (mul_nonneg
          (mul_nonneg
            (mul_nonneg (abs_nonneg _)
              (hgauss (t ^ α.weight 0) p₀ y₁ (pow_pos ht _)))
            (abs_nonneg _))
          (hgauss (t ^ α.weight 1) p₁ y₂ (pow_pos ht _)))
        (abs_nonneg _))
  calc
    (∫ v : ScratchModelEnergyInner, ‖H v‖ ∂
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))) =
        ∫ v : ScratchModelEnergyInner, H v ∂
          (((volume : Measure ℝ).prod volume).prod
            ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) := by
          apply integral_congr_ae
          filter_upwards [] with v
          rw [Real.norm_eq_abs, abs_of_nonneg (hHnonneg v)]
    _ = ∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
        H ((p₀, p₁), (y₁, (y₂, r))) := by
          exact integral_ScratchModelEnergyInner_eq_nested H hH
    _ = (∫ r : ℝ, T r) * (∫ w : ℝ, |conePhiPhysicalReal w|) ^ 2 := by
          change (∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
            (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
              modelEnergyDensityReordered α u x₁ x₂ t p₀ p₁ y₁ y₂ r) = _
          rw [modelEnergy_reordered_inner_scalar_reduction α u f x₁ x₂ p₂ t ht]
          congr 1
          apply integral_congr_ae
          filter_upwards [] with r
          rw [hT r]
          ring

/-- The global positive-scale second-energy density of a real Schwartz input
is jointly integrable.  This discharges the final Fubini hypothesis in the
global second-energy identity. -/
theorem integrable_modelEnergyTwoIntegrand_global_of_real_schwartz
    (α : Anisotropy) (u : E3) (f : SchwartzMap E3 ℝ) :
    Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyTwoIntegrand α u f q.1 q.2)
      ((cubeScaleMeasure.restrict (Set.univ ×ˢ Set.Ioi (0 : ℝ))).prod volume) := by
  let ν : Measure ℝ :=
    ((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
      (Set.Ioi (0 : ℝ))
  let μouter : Measure ScratchModelEnergyOuter :=
    ((volume : Measure ℝ).prod volume).prod ((volume : Measure ℝ).prod ν)
  let μinner : Measure ScratchModelEnergyInner :=
    ((volume : Measure ℝ).prod volume).prod
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))
  let G : (E3 × ℝ) × ModelE5 → ℝ := fun q ↦
    modelEnergyTwoIntegrand α u f q.1 q.2
  let H : ScratchModelEnergyOuter × ScratchModelEnergyInner → ℝ := fun wv ↦
    G (modelEnergyCoordinateReorder.symm wv)
  let D : ScratchModelEnergyOuter × ℝ → ℝ := fun wr ↦
    (modelSecondFiberReduced α f wr.1.1.1 wr.1.1.2 wr.1.2.1 wr.1.2.2 wr.2) ^ 2 *
      |conePsiPhysicalReal (wr.2 + u 2)|
  let S : ScratchModelEnergyOuter → ℝ := fun w ↦
    (∫ r : ℝ, D (w, r)) * (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2
  have hmp := modelEnergyCoordinateReorder_measurePreserving_scale ν
  have hGmeas : AEStronglyMeasurable G
      (((volume : Measure E3).prod ν).prod (volume : Measure ModelE5)) := by
    dsimp [G]
    exact (aestronglyMeasurable_modelSecondFiber α f f.continuous _).pow 2 |>.mul
      (aestronglyMeasurable_modelEnergyDensity α u _)
  have hHmeas : AEStronglyMeasurable H (μouter.prod μinner) := by
    change AEStronglyMeasurable (G ∘ modelEnergyCoordinateReorder.symm)
      (μouter.prod μinner)
    exact hGmeas.comp_quasiMeasurePreserving
      (MeasurePreserving.symm modelEnergyCoordinateReorder hmp).quasiMeasurePreserving
  have hD : Integrable D (μouter.prod volume) := by
    simpa only [D, μouter, ν] using
      integrable_reducedTail_global_of_real_schwartz α u f
  have hDsections : ∀ᵐ w : ScratchModelEnergyOuter ∂μouter,
      Integrable (fun r : ℝ ↦ D (w, r)) := hD.prod_right_ae
  have htν : ∀ᵐ t : ℝ ∂ν, 0 < t := by
    dsimp [ν]
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    exact ht
  have htpt : ∀ᵐ pt : ℝ × ℝ ∂((volume : Measure ℝ).prod ν), 0 < pt.2 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [] with p₂
      exact htν
    · exact measurableSet_Ioi.preimage measurable_snd
  have htouter : ∀ᵐ w : ScratchModelEnergyOuter ∂μouter, 0 < w.2.2 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [] with x
      exact htpt
    · exact measurableSet_Ioi.preimage (measurable_snd.comp measurable_snd)
  have hS : Integrable S μouter := by
    have hscalar := integrable_reordered_scalar_of_real_schwartz α u f
    apply hscalar.congr
    filter_upwards [] with w
    dsimp [S, D]
    congr 1
    apply integral_congr_ae
    filter_upwards [] with r
    ring
  have hsections : ∀ᵐ w : ScratchModelEnergyOuter ∂μouter,
      Integrable (fun v : ScratchModelEnergyInner ↦ H (w, v)) μinner := by
    filter_upwards [hDsections, htouter] with w hw ht
    rcases w with ⟨⟨x₁, x₂⟩, ⟨p₂, t⟩⟩
    have hT : ∀ r : ℝ, D (((x₁, x₂), (p₂, t)), r) =
        (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
          |conePsiPhysicalReal (r + u 2)| := by
      intro r
      rfl
    have hinner := integrable_reordered_inner_of_tail
      α u f x₁ x₂ p₂ t ht (fun r : ℝ ↦ D (((x₁, x₂), (p₂, t)), r)) hT hw
    apply hinner.congr
    filter_upwards [] with v
    rcases v with ⟨⟨p₀, p₁⟩, ⟨y₁, ⟨y₂, r⟩⟩⟩
    dsimp [H, G]
    symm
    exact modelEnergyTwoIntegrand_reorder_symm
      α u f x₁ x₂ p₂ t p₀ p₁ y₁ y₂ r
  have houter : Integrable (fun w : ScratchModelEnergyOuter ↦
      ∫ v : ScratchModelEnergyInner, ‖H (w, v)‖ ∂μinner) μouter := by
    apply hS.congr
    filter_upwards [hDsections, htouter] with w hw ht
    rcases w with ⟨⟨x₁, x₂⟩, ⟨p₂, t⟩⟩
    have hT : ∀ r : ℝ, D (((x₁, x₂), (p₂, t)), r) =
        (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
          |conePsiPhysicalReal (r + u 2)| := by
      intro r
      rfl
    symm
    calc
      (∫ v : ScratchModelEnergyInner, ‖H (((x₁, x₂), (p₂, t)), v)‖ ∂μinner) =
          ∫ v : ScratchModelEnergyInner,
            ‖(modelSecondFiberReduced α f x₁ x₂ p₂ t v.2.2.2) ^ 2 *
              modelEnergyDensityReordered α u x₁ x₂ t
                v.1.1 v.1.2 v.2.1 v.2.2.1 v.2.2.2‖ ∂μinner := by
            apply integral_congr_ae
            filter_upwards [] with v
            rcases v with ⟨⟨p₀, p₁⟩, ⟨y₁, ⟨y₂, r⟩⟩⟩
            dsimp [H, G]
            rw [modelEnergyTwoIntegrand_reorder_symm]
      _ = (∫ r : ℝ, D (((x₁, x₂), (p₂, t)), r)) *
          (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 := by
            exact integral_norm_reordered_inner_of_tail
              α u f x₁ x₂ p₂ t ht
                (fun r : ℝ ↦ D (((x₁, x₂), (p₂, t)), r)) hT hw
      _ = S ((x₁, x₂), (p₂, t)) := rfl
  have hH : Integrable H (μouter.prod μinner) :=
    (integrable_prod_iff hHmeas).mpr ⟨hsections, houter⟩
  have hback := hmp.integrable_comp_of_integrable hH
  have hG : Integrable G
      (((volume : Measure E3).prod ν).prod (volume : Measure ModelE5)) := by
    apply hback.congr
    filter_upwards [] with q
    dsimp [H]
    simp only [MeasurableEquiv.symm_apply_apply]
  simpa only [G, ν, cubeScaleMeasure_restrict_global_eq] using hG

/-- Unconditional real-Schwartz form of the blueprint's global second-energy
identity. -/
theorem modelEnergyTwoOn_global_eq_of_real_schwartz_unconditional
    (α : Anisotropy) (u : E3) (f : SchwartzMap E3 ℝ) :
    modelEnergyTwoOn α (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f =
      (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 *
        conePsiPhysicalRealL1 * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ x : E3, f x ^ 2 := by
  exact modelEnergyTwoOn_global_eq_of_real_schwartz_of_joint α u f
    (integrable_modelEnergyTwoIntegrand_global_of_real_schwartz α u f)

/-- Bounded continuous inputs make the literal signed center--scale/fiber
integrand absolutely integrable over every finite collection. -/
theorem integrable_modelSignedIntegrand_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (hcmeas : Measurable c)
    (hfcont : ∀ j, Continuous (f j))
    (hfbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    Integrable (modelSignedIntegrand α u c f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)) := by
  let μ : Measure ((E3 × ℝ) × ModelE5) :=
    (cubeScaleMeasure.restrict (collectionRegion α S)).prod volume
  let A : (E3 × ℝ) × ModelE5 → ℝ := fun q ↦
    modelFirstFiber α f q.1.1 q.1.2 q.2
  let B : (E3 × ℝ) × ModelE5 → ℝ := fun q ↦
    modelSecondFiber α (f 3) q.1.1 q.1.2 q.2
  let C : (E3 × ℝ) × ModelE5 → ℝ := fun q ↦ c q.1.2
  let σ : (E3 × ℝ) × ModelE5 → ℝ := fun q ↦
    modelSignedDensity α u q.1.1 q.1.2 q.2
  let W : (E3 × ℝ) × ModelE5 → ℝ := fun q ↦
    modelEnergyDensity α u q.1.1 q.1.2 q.2
  have hW : ∀ᵐ q ∂μ, 0 ≤ W q := by
    simpa only [μ, W] using ae_modelEnergyDensity_nonneg_collection α S u
  have hσ : ∀ᵐ q ∂μ, |σ q| = W q := by
    simpa only [μ, σ, W] using ae_abs_modelSignedDensity_collection α S u
  have hC : ∀ᵐ q ∂μ, |C q| ≤ 1 :=
    Filter.Eventually.of_forall fun q ↦ hc q.1.2
  have hprodmeas : AEStronglyMeasurable
      (fun q ↦ C q * (A q * B q * σ q)) μ := by
    change AEStronglyMeasurable (modelSignedIntegrand α u c f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)
    exact aestronglyMeasurable_modelSignedIntegrand α u c f hcmeas hfcont μ
  have hfirstmeas : AEStronglyMeasurable
      (fun q ↦ |A q| * √(W q)) μ := by
    change AEStronglyMeasurable (modelFirstWeightedFactor α u f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)
    exact aestronglyMeasurable_modelFirstWeightedFactor α u f hfcont μ
  have hsecondmeas : AEStronglyMeasurable
      (fun q ↦ |B q| * √(W q)) μ := by
    change AEStronglyMeasurable (modelSecondWeightedFactor α u (f 3))
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)
    exact aestronglyMeasurable_modelSecondWeightedFactor α u (f 3) (hfcont 3) μ
  rcases hfbound 0 with ⟨B0, hB0, hf0⟩
  rcases hfbound 1 with ⟨B1, hB1, hf1⟩
  rcases hfbound 2 with ⟨B2, hB2, hf2⟩
  rcases hfbound 3 with ⟨B3, hB3, hf3⟩
  have hweightint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyDensity α u q.1.1 q.1.2 q.2) μ := by
    simpa only [μ] using integrable_modelEnergyDensity_collection α S u
  have hfirstint : Integrable (fun q ↦ (|A q| * √(W q)) ^ 2) μ := by
    simpa only [μ, A, W, modelFirstWeightedFactor] using
      integrable_modelFirstWeightedFactor_sq_of_density
        α S u f hfcont B0 B1 B2 hB0 hB1 hB2 hf0 hf1 hf2 hweightint
  have hsecondint : Integrable (fun q ↦ (|B q| * √(W q)) ^ 2) μ := by
    simpa only [μ, B, W, modelSecondWeightedFactor] using
      integrable_modelSecondWeightedFactor_sq_of_density
        α S u (f 3) (hfcont 3) B3 hB3 hf3 hweightint
  have hjoint := integrable_signedDensity_of_weighted μ A B C σ W
    hprodmeas hfirstmeas hsecondmeas hfirstint hsecondint hC hW hσ
  change Integrable (fun q ↦ C q * (A q * B q * σ q)) μ
  exact hjoint

/-- The signed product's joint absolute integrability gives the literal
outer center--scale integrability used to partition a finite stopping forest. -/
theorem integrable_outerModelSignedFiber_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (hcmeas : Measurable c)
    (hfcont : ∀ j, Continuous (f j))
    (hfbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict (collectionRegion α S)) := by
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  letI : IsFiniteMeasure μ := by
    dsimp only [μ]
    exact isFiniteMeasure_cubeScaleCollection α S
  have hjoint := integrable_modelSignedIntegrand_of_boundedContinuous
    α S u c f hcmeas hfcont hfbound hc
  have houter : Integrable (fun pt : E3 × ℝ ↦
      ∫ z : ModelE5, modelSignedIntegrand α u c f (pt, z)) μ := by
    exact hjoint.integral_prod_left
  refine houter.congr ?_
  filter_upwards [] with pt
  change (∫ z : ModelE5,
      c pt.2 * (modelFirstFiber α f pt.1 pt.2 z *
        modelSecondFiber α (f 3) pt.1 pt.2 z *
          modelSignedDensity α u pt.1 pt.2 z)) = _
  rw [MeasureTheory.integral_const_mul]

/-- The outer signed-form integrability premise is automatic for the real
Schwartz tuples in the initial model range. -/
theorem integrable_outerModelSignedFiber_of_initialModelSchwartz
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (F : InitialModelSchwartzInput) (hcmeas : Measurable c)
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α (InitialModelRealInput F) pt.1 pt.2 z *
          modelSecondFiber α (InitialModelRealInput F 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict (collectionRegion α S)) := by
  exact integrable_outerModelSignedFiber_of_boundedContinuous
    α S u c (InitialModelRealInput F) hcmeas
    (initialModelRealInput_continuous F) (initialModelRealInput_bounded F) hc

/-- After the finite maximal-level hypothesis, all analytic premises of the
coordinate-level active stopping-forest bound are automatic for bounded
continuous input data. -/
theorem activeStoppingForest_bound_of_coordinateLevel_finite_auto
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (q σ : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (hpos : ∀ r ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) r)
    (hcmeas : Measurable c)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hfinite : ∀ (j : Fin 4) (m : ℤ),
      volume (sourceStoppingMaximalLevelSetAt α f j m) ≠ ∞) :
    ∃ C : ℝ, 0 ≤ C ∧
      |expandedModelLocalForm α S u c f| ≤
        C * sourceWeight u ^ 75 *
          SourceStoppingCoordinateEnvelope α S f q σ hpos := by
  rcases sourceStoppingTreeAnalyticPremises_of_boundedContinuous
    α S hS u c f hcmeas hcont hbound hc with ⟨hcs, henergy⟩
  exact activeStoppingForest_bound_of_coordinateLevel_finite
    α S hS u c f q σ hq hpos hcont hbound hfinite hcs henergy
      (integrable_outerModelSignedFiber_of_boundedContinuous
        α S u c f hcmeas hcont hbound hc)

/-- The initial Schwartz-model active stopping-forest estimate with every
treewise and Fubini analytic condition discharged. -/
theorem activeStoppingForest_bound_of_realSchwartz_auto
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (F : InitialModelSchwartzInput)
    (q σ : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (hpos : ∀ r ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j)
        (InitialModelRealInput F j) r)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hfinite : ∀ (j : Fin 4) (m : ℤ),
      volume (sourceStoppingMaximalLevelSetAt α
        (InitialModelRealInput F) j m) ≠ ∞) :
    ∃ C : ℝ, 0 ≤ C ∧
      |expandedModelLocalForm α S u c (InitialModelRealInput F)| ≤
        C * sourceWeight u ^ 75 *
          SourceStoppingCoordinateEnvelope α S
            (InitialModelRealInput F) q σ hpos := by
  rcases initialModel_sourceStoppingTreeAnalyticPremises
    α S hS u c F hcmeas hc with ⟨hcs, henergy⟩
  exact activeStoppingForest_bound_of_realSchwartz
    α S hS u c F q σ hq hpos hfinite hcs henergy
      (integrable_outerModelSignedFiber_of_initialModelSchwartz
        α S u c F hcmeas hc)

/-- A positive superlevel set has finite volume whenever the function tends
to zero at spatial infinity.  This is the topological last step needed for
the stopping maximal-level regions. -/
theorem volume_ne_top_of_tendsto_cocompact_zero
    (g : E3 → ℝ) (θ : ℝ) (hθ : 0 < θ)
    (hzero : Tendsto g (cocompact E3) (𝓝 0)) :
    volume {p | θ < g p} ≠ ∞ := by
  have hIio : Set.Iio θ ∈ 𝓝 (0 : ℝ) := Iio_mem_nhds hθ
  have hsmall : g ⁻¹' Set.Iio θ ∈ cocompact E3 := hzero hIio
  rcases Filter.mem_cocompact.mp hsmall with ⟨K, hK, hKsmall⟩
  have hsub : {p : E3 | θ < g p} ⊆ K := by
    intro p hp
    by_contra hpK
    have hpSmall : g p ∈ Set.Iio θ := hKsmall hpK
    change θ < g p at hp
    change g p < θ at hpSmall
    exact (not_lt_of_ge hpSmall.le) hp
  exact ne_of_lt ((MeasureTheory.measure_mono hsub).trans_lt hK.measure_lt_top)

/-- The measure-theoretic alternative to the compact-tail argument: any
finite-exponent `L^p` maximal estimate gives finite positive superlevel
measure by Chebyshev--Markov. -/
theorem volume_ne_top_of_memLp
    (g : E3 → ℝ) (q : ℝ≥0∞) (hg : MemLp g q volume)
    (hq0 : q ≠ 0) (hqtop : q ≠ ∞) {θ : ℝ} (hθ : 0 < θ) :
    volume {p | θ < g p} ≠ ∞ := by
  have hθnn : (θ.toNNReal : NNReal) ≠ 0 := by
    exact (Real.toNNReal_pos.mpr hθ).ne'
  have hmark : volume {p | (θ.toNNReal : NNReal) ≤ ‖g p‖₊} < ∞ :=
    hg.meas_ge_lt_top hq0 hqtop hθnn
  apply ne_of_lt
  apply (MeasureTheory.measure_mono ?_).trans_lt hmark
  intro p hp
  change θ < g p at hp
  change θ.toNNReal ≤ ‖g p‖₊
  apply Real.toNNReal_le_iff_le_coe.mpr
  change θ ≤ ‖g p‖
  rw [Real.norm_eq_abs, abs_of_nonneg (hθ.le.trans hp.le)]
  exact hp.le

/-- The tail conclusion specialized to one literal coordinate stopping level.
The positive threshold is automatic from the source comparison constant. -/
theorem sourceStoppingMaximalLevelSetAt_finite_of_tendsto_zero
    (α : Anisotropy) (f : ModelRealInput) (j : Fin 4) (m : ℤ)
    (hzero : Tendsto (sourceStoppingMaximal α f j)
      (cocompact E3) (𝓝 0)) :
    volume (sourceStoppingMaximalLevelSetAt α f j m) ≠ ∞ := by
  apply volume_ne_top_of_tendsto_cocompact_zero
    (sourceStoppingMaximal α f j)
    (sourceStoppingComparisonConstant j * (2 : ℝ) ^ (m - 1))
  · exact mul_pos (sourceStoppingComparisonConstant_pos j)
      (zpow_pos (by norm_num) _)
  · exact hzero

/-- A finite-exponent `L^p` estimate for a literal source stopping maximal
function supplies the finiteness hypothesis required by the root-packing
argument at every one of its dyadic levels. -/
theorem sourceStoppingMaximalLevelSetAt_finite_of_memLp
    (α : Anisotropy) (f : ModelRealInput) (j : Fin 4) (m : ℤ)
    (q : ℝ≥0∞) (hmax : MemLp (sourceStoppingMaximal α f j) q volume)
    (hq0 : q ≠ 0) (hqtop : q ≠ ∞) :
    volume (sourceStoppingMaximalLevelSetAt α f j m) ≠ ∞ := by
  apply volume_ne_top_of_memLp (sourceStoppingMaximal α f j) q
    hmax hq0 hqtop
  exact mul_pos (sourceStoppingComparisonConstant_pos j)
    (zpow_pos (by norm_num) _)

/-- Coordinatewise finite-exponent maximal estimates give all finite-measure
level hypotheses for the source stopping construction at once. -/
theorem sourceStopping_coordinateLevel_finite_of_memLp
    (α : Anisotropy) (f : ModelRealInput) (q : Fin 4 → ℝ≥0∞)
    (hmax : ∀ j : Fin 4, MemLp (sourceStoppingMaximal α f j) (q j) volume)
    (hq0 : ∀ j : Fin 4, q j ≠ 0) (hqtop : ∀ j : Fin 4, q j ≠ ∞) :
    ∀ (j : Fin 4) (m : ℤ),
      volume (sourceStoppingMaximalLevelSetAt α f j m) ≠ ∞ := by
  intro j m
  exact sourceStoppingMaximalLevelSetAt_finite_of_memLp
    α f j m (q j) (hmax j) (hq0 j) (hqtop j)

/-- The preceding `L^p` bridge in the native split form of the source
maximal-size lemma: one exponent-two branch and three exponent-four branches. -/
theorem sourceStopping_coordinateLevel_finite_of_branch_memLp
    (α : Anisotropy) (f : ModelRealInput) (q : Fin 4 → ℝ≥0∞)
    (htwo : MemLp (anisotropicMaximalTwo α (f 3)) (q 3) volume)
    (hfour : ∀ j : Fin 4, j ≠ 3 →
      MemLp (anisotropicMaximalFour α (f j)) (q j) volume)
    (hq0 : ∀ j : Fin 4, q j ≠ 0) (hqtop : ∀ j : Fin 4, q j ≠ ∞) :
    ∀ (j : Fin 4) (m : ℤ),
      volume (sourceStoppingMaximalLevelSetAt α f j m) ≠ ∞ := by
  apply sourceStopping_coordinateLevel_finite_of_memLp α f q ?_ hq0 hqtop
  intro j
  by_cases hj : j = 3
  · simpa only [sourceStoppingMaximal, hj, ↓reduceIte] using htwo
  · simpa only [sourceStoppingMaximal, hj, ↓reduceIte] using hfour j hj

/-- A tail estimate for the two-maximal branch and the fourth-maximal branch
gives the corresponding tail estimate for the literal stopping maximal. -/
theorem tendsto_sourceStoppingMaximal_of_tails
    (α : Anisotropy) (f : ModelRealInput)
    (htwo : Tendsto (anisotropicMaximalTwo α (f 3))
      (cocompact E3) (𝓝 0))
    (hfour : ∀ j : Fin 4, j ≠ 3 →
      Tendsto (anisotropicMaximalFour α (f j))
        (cocompact E3) (𝓝 0)) :
    ∀ j : Fin 4, Tendsto (sourceStoppingMaximal α f j)
      (cocompact E3) (𝓝 0) := by
  intro j
  by_cases hj : j = 3
  · simpa only [sourceStoppingMaximal, hj, ↓reduceIte] using htwo
  · simpa only [sourceStoppingMaximal, hj, ↓reduceIte] using hfour j hj

/-- The exact stopping-time finiteness interface obtained from spatial tail
estimates for the two and fourth anisotropic maximal functions. -/
theorem sourceStopping_coordinateLevel_finite_of_maximal_tails
    (α : Anisotropy) (f : ModelRealInput)
    (htwo : Tendsto (anisotropicMaximalTwo α (f 3))
      (cocompact E3) (𝓝 0))
    (hfour : ∀ j : Fin 4, j ≠ 3 →
      Tendsto (anisotropicMaximalFour α (f j))
        (cocompact E3) (𝓝 0)) :
    ∀ (j : Fin 4) (m : ℤ),
      volume (sourceStoppingMaximalLevelSetAt α f j m) ≠ ∞ := by
  intro j m
  apply sourceStoppingMaximalLevelSetAt_finite_of_tendsto_zero
  exact tendsto_sourceStoppingMaximal_of_tails α f htwo hfour j

/-- A bounded continuous input which is nonzero at one point has strictly
positive exponent-two local size on every literal box. -/
theorem boxLocalSize_two_pos_of_continuous_nonzero
    (α : Anisotropy) (q : AnisoBox α) (f : E3 → ℝ)
    (hcont : Continuous f)
    (hbound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f y| ≤ C)
    {y : E3} (hy : f y ≠ 0) :
    0 < boxLocalSize α 2 f q := by
  let K : E3 → ℝ :=
    anisotropicBracketKernel α (boxLength q) (boxCenter α q)
  let g : E3 → ℝ := fun z ↦ |f z| ^ (2 : ℝ) * K z
  have hgcont : Continuous g :=
    (hcont.abs.rpow_const (fun _ ↦ Or.inr (by norm_num))).mul
      (continuous_anisotropicBracketKernel α (boxLength_pos q)
        (boxCenter α q))
  have hgint : Integrable g := by
    rcases hbound with ⟨C, hC, hbound⟩
    have hK : Integrable K :=
      integrable_anisotropicBracketKernel α (boxLength_pos q) (boxCenter α q)
    refine (hK.const_mul (C ^ (2 : ℝ))).mono hgcont.aestronglyMeasurable ?_
    filter_upwards [] with z
    have hpow : |f z| ^ (2 : ℝ) ≤ C ^ (2 : ℝ) :=
      Real.rpow_le_rpow (abs_nonneg _) (hbound z) (by norm_num)
    have hKnonneg : 0 ≤ K z :=
      anisotropicBracketKernel_nonneg α (boxLength_pos q).le (boxCenter α q) z
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg
      (Real.rpow_nonneg (abs_nonneg _) _) hKnonneg),
      Real.norm_eq_abs, abs_of_nonneg (mul_nonneg
        (Real.rpow_nonneg hC _) hKnonneg)]
    exact mul_le_mul_of_nonneg_right hpow hKnonneg
  have hgnonneg : 0 ≤ g := by
    intro z
    exact mul_nonneg (Real.rpow_nonneg (abs_nonneg (f z)) _)
      (anisotropicBracketKernel_nonneg α (boxLength_pos q).le
        (boxCenter α q) z)
  have hgpoint : g y ≠ 0 := by
    apply mul_ne_zero
    · exact (Real.rpow_pos_of_pos (abs_pos.mpr hy) _).ne'
    · exact (anisotropicBracketKernel_pos α (boxLength_pos q)
        (boxCenter α q) y).ne'
  have hpower : 0 < boxLocalPower α 2 f q := by
    change 0 < ∫ z : E3, g z
    exact integral_pos_of_integrable_nonneg_nonzero hgcont hgint hgnonneg hgpoint
  unfold boxLocalSize
  exact Real.rpow_pos_of_pos hpower _

/-- Function-level nonvanishing supplies the point witness required for the
positive exponent-two local-size lemma. -/
theorem boxLocalSize_two_pos_of_continuous_ne_zero
    (α : Anisotropy) (q : AnisoBox α) (f : E3 → ℝ)
    (hcont : Continuous f)
    (hbound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f y| ≤ C)
    (hne : f ≠ 0) :
    0 < boxLocalSize α 2 f q := by
  have hwitness : ∃ y, f y ≠ 0 := by
    by_contra h
    apply hne
    funext y
    by_contra hy
    exact h ⟨y, hy⟩
  rcases hwitness with ⟨y, hy⟩
  exact boxLocalSize_two_pos_of_continuous_nonzero
    α q f hcont hbound hy

/-- Function-level nonvanishing also gives positive exponent-four local
size through the existing fourth-power local-size lemma. -/
theorem boxLocalSize_four_pos_of_continuous_ne_zero
    (α : Anisotropy) (q : AnisoBox α) (f : E3 → ℝ)
    (hcont : Continuous f)
    (hbound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f y| ≤ C)
    (hne : f ≠ 0) :
    0 < boxLocalSize α 4 f q := by
  have hwitness : ∃ y, f y ≠ 0 := by
    by_contra h
    apply hne
    funext y
    by_contra hy
    exact h ⟨y, hy⟩
  rcases hwitness with ⟨y, hy⟩
  exact boxLocalSize_four_pos_of_continuous_nonzero
    α q f hcont hbound hy

/-- Strict positivity propagates from a box local size to its ancestor
stopping datum. -/
theorem stoppingData_pos_of_boxLocalSize_pos
    (α : Anisotropy) (S : BoxCollection α) (s : ℝ) (f : E3 → ℝ)
    {q : AnisoBox α} (hq : q ∈ S)
    (hpos : 0 < boxLocalSize α s f q) :
    0 < stoppingData α S s f q := by
  exact lt_of_lt_of_le hpos (boxLocalSize_le_stoppingData α S s f hq)

/-- A bounded continuous input nonzero somewhere has positive exponent-two
stopping data at every box of the ambient finite collection. -/
theorem stoppingData_two_pos_of_continuous_nonzero
    (α : Anisotropy) (S : BoxCollection α) (f : E3 → ℝ)
    (hcont : Continuous f)
    (hbound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f y| ≤ C)
    {y : E3} (hy : f y ≠ 0)
    {q : AnisoBox α} (hq : q ∈ S) :
    0 < stoppingData α S 2 f q := by
  apply stoppingData_pos_of_boxLocalSize_pos α S 2 f hq
  exact boxLocalSize_two_pos_of_continuous_nonzero
    α q f hcont hbound hy

/-- The function-level form of positivity for exponent-two stopping data. -/
theorem stoppingData_two_pos_of_continuous_ne_zero
    (α : Anisotropy) (S : BoxCollection α) (f : E3 → ℝ)
    (hcont : Continuous f)
    (hbound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f y| ≤ C)
    (hne : f ≠ 0)
    {q : AnisoBox α} (hq : q ∈ S) :
    0 < stoppingData α S 2 f q := by
  apply stoppingData_pos_of_boxLocalSize_pos α S 2 f hq
  exact boxLocalSize_two_pos_of_continuous_ne_zero
    α q f hcont hbound hne

/-- A bounded continuous input nonzero somewhere has positive exponent-four
stopping data at every box of the ambient finite collection. -/
theorem stoppingData_four_pos_of_continuous_nonzero
    (α : Anisotropy) (S : BoxCollection α) (f : E3 → ℝ)
    (hcont : Continuous f)
    (hbound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f y| ≤ C)
    {y : E3} (hy : f y ≠ 0)
    {q : AnisoBox α} (hq : q ∈ S) :
    0 < stoppingData α S 4 f q := by
  apply stoppingData_pos_of_boxLocalSize_pos α S 4 f hq
  exact boxLocalSize_four_pos_of_continuous_nonzero α q f hcont hbound hy

/-- The function-level form of positivity for exponent-four stopping data. -/
theorem stoppingData_four_pos_of_continuous_ne_zero
    (α : Anisotropy) (S : BoxCollection α) (f : E3 → ℝ)
    (hcont : Continuous f)
    (hbound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f y| ≤ C)
    (hne : f ≠ 0)
    {q : AnisoBox α} (hq : q ∈ S) :
    0 < stoppingData α S 4 f q := by
  apply stoppingData_pos_of_boxLocalSize_pos α S 4 f hq
  exact boxLocalSize_four_pos_of_continuous_ne_zero
    α q f hcont hbound hne

/-- Coordinatewise nonzero bounded continuous source inputs provide the
strict stopping-data premise required by the active source stopping forest. -/
theorem sourceStoppingData_pos_of_boundedContinuous_nonzero
    (α : Anisotropy) (S : BoxCollection α) (f : ModelRealInput)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f j y| ≤ C)
    (hnonzero : ∀ j, ∃ y, f j y ≠ 0)
    {q : AnisoBox α} (hq : q ∈ S) (j : Fin 4) :
    0 < stoppingData α S (sourceStoppingExponent j) (f j) q := by
  rcases hnonzero j with ⟨y, hy⟩
  by_cases hj : j = 3
  · subst j
    simpa [sourceStoppingExponent] using
      stoppingData_two_pos_of_continuous_nonzero
        α S (f 3) (hcont 3) (hbound 3) hy hq
  · simpa [sourceStoppingExponent, hj] using
      stoppingData_four_pos_of_continuous_nonzero
        α S (f j) (hcont j) (hbound j) hy hq

/-- A version of the active-source stopping positivity lemma stated with
function-level coordinatewise nonvanishing. -/
theorem sourceStoppingData_pos_of_boundedContinuous_ne_zero
    (α : Anisotropy) (S : BoxCollection α) (f : ModelRealInput)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f j y| ≤ C)
    (hnonzero : ∀ j, f j ≠ 0)
    {q : AnisoBox α} (hq : q ∈ S) (j : Fin 4) :
    0 < stoppingData α S (sourceStoppingExponent j) (f j) q := by
  by_cases hj : j = 3
  · subst j
    simpa [sourceStoppingExponent] using
      stoppingData_two_pos_of_continuous_ne_zero
        α S (f 3) (hcont 3) (hbound 3) (hnonzero 3) hq
  · simpa [sourceStoppingExponent, hj] using
      stoppingData_four_pos_of_continuous_ne_zero
        α S (f j) (hcont j) (hbound j) (hnonzero j) hq

/-- The active-forest premise itself, with all finite-collection boxes and
all four source coordinates quantified in its consumer-facing order. -/
theorem sourceStoppingData_all_pos_of_boundedContinuous_ne_zero
    (α : Anisotropy) (S : BoxCollection α) (f : ModelRealInput)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f j y| ≤ C)
    (hnonzero : ∀ j, f j ≠ 0) :
    ∀ q ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) q := by
  intro q hq j
  exact sourceStoppingData_pos_of_boundedContinuous_ne_zero
    α S f hcont hbound hnonzero hq j

/-- The global outer second-energy density is integrable for a real Schwartz
input. -/
theorem integrable_modelEnergyTwoOuter_global_of_real_schwartz
    (α : Anisotropy) (u : E3) (f : SchwartzMap E3 ℝ) :
    Integrable (modelEnergyTwoOuter α u f)
      (cubeScaleMeasure.restrict (Set.univ ×ˢ Set.Ioi (0 : ℝ))) := by
  have hjoint :=
    integrable_modelEnergyTwoIntegrand_global_of_real_schwartz α u f
  change Integrable (fun pt : E3 × ℝ ↦
    ∫ z : ModelE5, modelEnergyTwoIntegrand α u f pt z)
    (cubeScaleMeasure.restrict (Set.univ ×ˢ Set.Ioi (0 : ℝ)))
  exact hjoint.integral_prod_left

/-- Every positive-scale restriction of the second energy is bounded by the
explicit global real-Schwartz energy. -/
theorem modelEnergyTwoOn_le_global_of_real_schwartz
    (α : Anisotropy) (V : Set (E3 × ℝ)) (u : E3) (f : SchwartzMap E3 ℝ)
    (hV : V ⊆ Set.univ ×ˢ Set.Ioi (0 : ℝ)) :
    modelEnergyTwoOn α V u f ≤
      (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 *
        conePsiPhysicalRealL1 * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ x : E3, f x ^ 2 := by
  calc
    modelEnergyTwoOn α V u f ≤
        modelEnergyTwoOn α (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f :=
      modelEnergyTwoOn_le_global_of_integrable α V u f hV
        (integrable_modelEnergyTwoOuter_global_of_real_schwartz α u f)
    _ = _ := modelEnergyTwoOn_global_eq_of_real_schwartz_unconditional α u f

/-- Restricting the globally integrable outer energy to any positive-scale
region preserves integrability. -/
theorem integrable_modelEnergyTwoOuter_on_of_real_schwartz
    (α : Anisotropy) (V : Set (E3 × ℝ)) (u : E3) (f : SchwartzMap E3 ℝ)
    (hV : V ⊆ Set.univ ×ˢ Set.Ioi (0 : ℝ)) :
    Integrable (modelEnergyTwoOuter α u f) (cubeScaleMeasure.restrict V) := by
  apply (integrable_modelEnergyTwoOuter_global_of_real_schwartz α u f).mono_measure
  exact Measure.restrict_mono hV le_rfl

/-- Additivity of the real-Schwartz second energy on disjoint positive-scale
regions follows without any residual integrability assumption. -/
theorem modelEnergyTwoOn_union_of_real_schwartz
    (α : Anisotropy) (V W : Set (E3 × ℝ)) (u : E3) (f : SchwartzMap E3 ℝ)
    (hdisj : Disjoint V W) (hWmeas : MeasurableSet W)
    (hVpos : V ⊆ Set.univ ×ˢ Set.Ioi (0 : ℝ))
    (hWpos : W ⊆ Set.univ ×ˢ Set.Ioi (0 : ℝ)) :
    modelEnergyTwoOn α (V ∪ W) u f =
      modelEnergyTwoOn α V u f + modelEnergyTwoOn α W u f := by
  exact modelEnergyTwoOn_union_of_integrable α V W u f hdisj hWmeas
    (integrable_modelEnergyTwoOuter_on_of_real_schwartz α V u f hVpos)
    (integrable_modelEnergyTwoOuter_on_of_real_schwartz α W u f hWpos)

/-- The global real-Schwartz energy bound applies in particular to every
finite box collection. -/
theorem modelEnergyTwo_collection_le_global_of_real_schwartz
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : SchwartzMap E3 ℝ) :
    modelEnergyTwo α S u f ≤
      (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 *
        conePsiPhysicalRealL1 * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ x : E3, f x ^ 2 := by
  unfold modelEnergyTwo
  apply modelEnergyTwoOn_le_global_of_real_schwartz α
    (collectionRegion α S) u f
  intro pt hpt
  exact ⟨Set.mem_univ _, pos_of_mem_collectionRegion α S hpt⟩

/-- Nonzero real Schwartz components supply the literal positive stopping
data premise for every finite source collection. -/
theorem initialModel_sourceStoppingData_all_pos_of_ne_zero
    (α : Anisotropy) (S : BoxCollection α) (F : InitialModelSchwartzInput)
    (hFnonzero : ∀ j, F j ≠ 0) :
    ∀ q ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j)
        (InitialModelRealInput F j) q := by
  apply sourceStoppingData_all_pos_of_boundedContinuous_ne_zero
    α S (InitialModelRealInput F)
    (initialModelRealInput_continuous F) (initialModelRealInput_bounded F)
  intro j hzero
  apply hFnonzero j
  ext y
  exact congr_fun hzero y


/-- The finite active stopping-forest estimate for a nonzero real Schwartz
tuple, with all local analytic and stopping-positivity premises discharged. -/
theorem activeStoppingForest_bound_of_realSchwartz_auto_of_ne_zero
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (F : InitialModelSchwartzInput)
    (q σ : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (hFnonzero : ∀ j, F j ≠ 0)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hfinite : ∀ (j : Fin 4) (m : ℤ),
      volume (sourceStoppingMaximalLevelSetAt α
        (InitialModelRealInput F) j m) ≠ ∞) :
    ∃ C : ℝ, 0 ≤ C ∧
      |expandedModelLocalForm α S u c (InitialModelRealInput F)| ≤
        C * sourceWeight u ^ 75 *
          SourceStoppingCoordinateEnvelope α S
            (InitialModelRealInput F) q σ
              (initialModel_sourceStoppingData_all_pos_of_ne_zero
                α S F hFnonzero) := by
  exact activeStoppingForest_bound_of_realSchwartz_auto
    α S hS u c F q σ hq
    (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero)
    hcmeas hc hfinite

/-- The finite real-Schwartz active stopping-forest estimate follows from
the branchwise finite-exponent maximal estimates of the source maximal-size
lemma.  Thus only those maximal `L^p` estimates remain analytic input. -/
theorem activeStoppingForest_bound_of_realSchwartz_auto_of_ne_zero_of_branch_memLp
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (F : InitialModelSchwartzInput)
    (q σ : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (hFnonzero : ∀ j, F j ≠ 0)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1)
    (p : Fin 4 → ℝ≥0∞)
    (htwo : MemLp (anisotropicMaximalTwo α (InitialModelRealInput F 3))
      (p 3) volume)
    (hfour : ∀ j : Fin 4, j ≠ 3 →
      MemLp (anisotropicMaximalFour α (InitialModelRealInput F j))
        (p j) volume)
    (hp0 : ∀ j : Fin 4, p j ≠ 0)
    (hptop : ∀ j : Fin 4, p j ≠ ∞) :
    ∃ C : ℝ, 0 ≤ C ∧
      |expandedModelLocalForm α S u c (InitialModelRealInput F)| ≤
        C * sourceWeight u ^ 75 *
          SourceStoppingCoordinateEnvelope α S
            (InitialModelRealInput F) q σ
              (initialModel_sourceStoppingData_all_pos_of_ne_zero
                α S F hFnonzero) := by
  apply activeStoppingForest_bound_of_realSchwartz_auto_of_ne_zero
    α S hS u c F q σ hq hFnonzero hcmeas hc
  exact sourceStopping_coordinateLevel_finite_of_branch_memLp
    α (InitialModelRealInput F) p htwo hfour hp0 hptop

/-- A vanishing first input annihilates the three-input local fiber. -/
theorem modelFirstFiber_eq_zero_of_input_zero
    (α : Anisotropy) (f : ModelRealInput) (p : E3) (t : ℝ) (z : ModelE5)
    (hzero : f 0 = 0) :
    modelFirstFiber α f p t z = 0 := by
  unfold modelFirstFiber
  rw [hzero]
  simp

/-- A vanishing second input annihilates the three-input local fiber. -/
theorem modelFirstFiber_eq_zero_of_input_one
    (α : Anisotropy) (f : ModelRealInput) (p : E3) (t : ℝ) (z : ModelE5)
    (hzero : f 1 = 0) :
    modelFirstFiber α f p t z = 0 := by
  unfold modelFirstFiber
  rw [hzero]
  simp

/-- A vanishing third input annihilates the three-input local fiber. -/
theorem modelFirstFiber_eq_zero_of_input_two
    (α : Anisotropy) (f : ModelRealInput) (p : E3) (t : ℝ) (z : ModelE5)
    (hzero : f 2 = 0) :
    modelFirstFiber α f p t z = 0 := by
  unfold modelFirstFiber
  rw [hzero]
  simp

/-- A vanishing fourth input annihilates the one-input local fiber. -/
theorem modelSecondFiber_eq_zero_of_input_zero
    (α : Anisotropy) (f : E3 → ℝ) (p : E3) (t : ℝ) (z : ModelE5)
    (hzero : f = 0) :
    modelSecondFiber α f p t z = 0 := by
  unfold modelSecondFiber
  rw [hzero]
  simp

/-- Any zero component of the real model input annihilates its expanded
local form on every finite box collection. -/
theorem expandedModelLocalForm_eq_zero_of_component_eq_zero
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (j : Fin 4) (hzero : f j = 0) :
    expandedModelLocalForm α S u c f = 0 := by
  fin_cases j
  · unfold expandedModelLocalForm
    simp_rw [modelFirstFiber_eq_zero_of_input_zero α f _ _ _ hzero]
    simp
  · unfold expandedModelLocalForm
    simp_rw [modelFirstFiber_eq_zero_of_input_one α f _ _ _ hzero]
    simp
  · unfold expandedModelLocalForm
    simp_rw [modelFirstFiber_eq_zero_of_input_two α f _ _ _ hzero]
    simp
  · unfold expandedModelLocalForm
    simp_rw [modelSecondFiber_eq_zero_of_input_zero α (f 3) _ _ _ hzero]
    simp

/-- The finite dyadic local form is zero whenever a real input component is
zero.  This is the zero branch needed before invoking strict stopping-data
positivity. -/
theorem expandedModelLocalForm_truncation_eq_zero_of_component_eq_zero
    (α : Anisotropy) (N : ℕ) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (j : Fin 4) (hzero : f j = 0) :
    expandedModelLocalForm α (truncationCollection α N) u c f = 0 := by
  exact expandedModelLocalForm_eq_zero_of_component_eq_zero
    α (truncationCollection α N) u c f j hzero

/-- Any zero Schwartz component annihilates the unexpanded fixed-scale
spatial model integrand. -/
theorem ModelSpatialIntegrand_eq_zero_of_component_eq_zero
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput)
    (t : ℝ) (x : E3) (j : Fin 4) (hzero : F j = 0) :
    ModelSpatialIntegrand α u F t x = 0 := by
  fin_cases j <;> simp at hzero
  all_goals unfold ModelSpatialIntegrand
  · rw [hzero]
    simp
  · rw [hzero]
    simp [ModelCoordinateConvolution]
  · rw [hzero]
    simp [ModelCoordinateConvolution]
  · rw [hzero]
    simp [ModelCoordinateConvolution]

/-- A zero Schwartz component annihilates the spatial profile at every
scale. -/
theorem ModelSpatialProfile_eq_zero_of_component_eq_zero
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput)
    (t : ℝ) (j : Fin 4) (hzero : F j = 0) :
    ModelSpatialProfile α u F t = 0 := by
  unfold ModelSpatialProfile
  simp_rw [ModelSpatialIntegrand_eq_zero_of_component_eq_zero
    α u F t _ j hzero]
  simp

/-- A zero Schwartz component annihilates the full model form. -/
theorem ModelFullForm_eq_zero_of_component_eq_zero
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (j : Fin 4) (hzero : F j = 0) :
    ModelFullForm α u c F = 0 := by
  unfold ModelFullForm
  simp_rw [ModelSpatialProfile_eq_zero_of_component_eq_zero
    α u F _ j hzero]
  simp

/-- A zero Schwartz component annihilates every finite-scale truncation of
the unexpanded model form. -/
theorem ModelScaleTruncation_eq_zero_of_component_eq_zero
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (N : ℕ) (j : Fin 4) (hzero : F j = 0) :
    ModelScaleTruncation α u c F N = 0 := by
  unfold ModelScaleTruncation
  simp_rw [ModelSpatialProfile_eq_zero_of_component_eq_zero
    α u F _ j hzero]
  simp

/-- Passing a zero Schwartz component to the real finite-forest input keeps
it identically zero. -/
theorem InitialModelRealInput_component_eq_zero_of_component_eq_zero
    (F : InitialModelSchwartzInput) (j : Fin 4) (hzero : F j = 0) :
    InitialModelRealInput F j = 0 := by
  change (F j : E3 → ℝ) = 0
  rw [hzero]
  rfl

/-- The expanded finite forest form for the real input of a Schwartz tuple
vanishes in the same zero-component branch. -/
theorem expandedModelLocalForm_initialModel_eq_zero_of_component_eq_zero
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (F : InitialModelSchwartzInput) (j : Fin 4) (hzero : F j = 0) :
    expandedModelLocalForm α S u c (InitialModelRealInput F) = 0 := by
  apply expandedModelLocalForm_eq_zero_of_component_eq_zero
    α S u c (InitialModelRealInput F) j
  exact InitialModelRealInput_component_eq_zero_of_component_eq_zero
    F j hzero

/-- The low-frequency kernel in the spatial profile is strongly measurable
in its output coordinate. -/
theorem stronglyMeasurable_ModelLowKernel (u : ℝ) :
    StronglyMeasurable (ModelLowKernel u) := by
  have hgauss : Measurable (fun wz : ℝ × ℝ ↦ gaussian wz.2) :=
    gaussian_contDiff.continuous.measurable.comp measurable_snd
  have hphi : Measurable (fun wz : ℝ × ℝ ↦
      conePhiPhysicalReal (wz.1 - wz.2 - u)) :=
    conePhiPhysicalReal.continuous.measurable.comp
      ((measurable_fst.sub measurable_snd).sub measurable_const)
  have hjoint : StronglyMeasurable (fun wz : ℝ × ℝ ↦
      gaussian wz.2 * conePhiPhysicalReal (wz.1 - wz.2 - u)) :=
    (hgauss.mul hphi).stronglyMeasurable
  change StronglyMeasurable (fun w : ℝ ↦
    ∫ z : ℝ, gaussian z * conePhiPhysicalReal (w - z - u))
  exact hjoint.integral_prod_right'

/-- The translated third-coordinate kernel is strongly measurable in its
spatial variable, before the outer Gaussian-derivative convolution. -/
theorem stronglyMeasurable_modelThirdKernel
    (u s p : ℝ) : StronglyMeasurable (modelThirdKernel u s p) := by
  have hderiv : Measurable gaussianDeriv := by
    unfold gaussianDeriv
    exact (measurable_const.mul measurable_id).mul
      gaussian_contDiff.continuous.measurable
  have hpsi : Measurable (fun wz : ℝ × ℝ ↦
      conePsiPhysicalReal (wz.1 - wz.2 + u)) :=
    conePsiPhysicalReal.continuous.measurable.comp
      ((measurable_fst.sub measurable_snd).add measurable_const)
  have hjoint : StronglyMeasurable (fun wz : ℝ × ℝ ↦
      gaussianDeriv wz.2 * conePsiPhysicalReal (wz.1 - wz.2 + u)) :=
    ((hderiv.comp measurable_snd).mul hpsi).stronglyMeasurable
  have hinter : StronglyMeasurable (fun w : ℝ ↦
      ∫ z : ℝ, gaussianDeriv z * conePsiPhysicalReal (w - z + u)) :=
    hjoint.integral_prod_right'
  unfold modelThirdKernel kernelAt kernelDilate
  change StronglyMeasurable (fun y : ℝ ↦
    s⁻¹ * (∫ z : ℝ,
      gaussianDeriv z * conePsiPhysicalReal (((y - p) / s) - z + u)))
  exact (hinter.comp_measurable
    ((measurable_id.sub measurable_const).div measurable_const)).const_mul s⁻¹

/-- The outer third-coordinate kernel in the profile is strongly measurable. -/
theorem stronglyMeasurable_ModelThirdKernel (u : ℝ) :
    StronglyMeasurable (ModelThirdKernel u) := by
  have hderiv : Measurable gaussianDeriv := by
    unfold gaussianDeriv
    exact (measurable_const.mul measurable_id).mul
      gaussian_contDiff.continuous.measurable
  have hthird : StronglyMeasurable (modelThirdKernel (-u) 1 0) :=
    stronglyMeasurable_modelThirdKernel (-u) 1 0
  have hjoint : StronglyMeasurable (fun wz : ℝ × ℝ ↦
      gaussianDeriv wz.2 * modelThirdKernel (-u) 1 0 (wz.1 - wz.2)) :=
    (hderiv.comp measurable_snd).stronglyMeasurable.mul
      (hthird.comp_measurable (measurable_fst.sub measurable_snd))
  change StronglyMeasurable (fun w : ℝ ↦
    ∫ z : ℝ, gaussianDeriv z * modelThirdKernel (-u) 1 0 (w - z))
  exact hjoint.integral_prod_right'

/-- The two profile kernels are Borel measurable, in forms convenient for
the coordinate-convolution measurability lemma. -/
theorem measurable_ModelLowKernel (u : ℝ) :
    Measurable (ModelLowKernel u) :=
  (stronglyMeasurable_ModelLowKernel u).measurable

theorem measurable_ModelThirdKernel (u : ℝ) :
    Measurable (ModelThirdKernel u) :=
  (stronglyMeasurable_ModelThirdKernel u).measurable

/-- A coordinate convolution is jointly strongly measurable in a scale
parameter and the ambient spatial point whenever its input and kernel are
strongly measurable. -/
theorem stronglyMeasurable_modelCoordinateConvolution_joint
    (i : Fin 3) (n : ℕ) (f : E3 → ℝ) (k : ℝ → ℝ)
    (hf : Measurable f) (hk : Measurable k) :
    StronglyMeasurable (fun tx : ℝ × E3 ↦
      ModelCoordinateConvolution i f k (tx.1 ^ n) tx.2) := by
  have ht : Measurable (fun q : (ℝ × E3) × ℝ ↦ q.1.1 ^ n) :=
    (measurable_fst.comp measurable_fst).pow_const _
  have hx : Measurable (fun q : (ℝ × E3) × ℝ ↦
      q.1.2 - q.2 • Anisotropy.coordinateDirection i) := by
    exact (measurable_snd.comp measurable_fst).sub
      (measurable_snd.smul measurable_const)
  have hr : Measurable (fun q : (ℝ × E3) × ℝ ↦ q.2) := measurable_snd
  have hinput : StronglyMeasurable (fun q : (ℝ × E3) × ℝ ↦
      f (q.1.2 - q.2 • Anisotropy.coordinateDirection i)) :=
    (hf.comp hx).stronglyMeasurable
  have hkernel : StronglyMeasurable (fun q : (ℝ × E3) × ℝ ↦
      kernelDilate k (q.1.1 ^ n) q.2) := by
    unfold kernelDilate
    change StronglyMeasurable (fun q : (ℝ × E3) × ℝ ↦
      (q.1.1 ^ n)⁻¹ * k (q.2 / (q.1.1 ^ n)))
    exact (ht.inv.mul (hk.comp (hr.div ht))).stronglyMeasurable
  have hjoint : StronglyMeasurable (fun q : (ℝ × E3) × ℝ ↦
      f (q.1.2 - q.2 • Anisotropy.coordinateDirection i) *
        kernelDilate k (q.1.1 ^ n) q.2) := hinput.mul hkernel
  change StronglyMeasurable (fun tx : ℝ × E3 ↦
    ∫ r : ℝ, f (tx.2 - r • Anisotropy.coordinateDirection i) *
      kernelDilate k (tx.1 ^ n) r)
  exact hjoint.integral_prod_right'

/-- The literal spatial integrand of the full model profile is jointly
strongly measurable in scale and space for every Schwartz four-tuple. -/
theorem stronglyMeasurable_ModelSpatialIntegrand
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) :
    StronglyMeasurable (fun tx : ℝ × E3 ↦
      ModelSpatialIntegrand α u F tx.1 tx.2) := by
  have h0 : StronglyMeasurable (fun tx : ℝ × E3 ↦ F 0 tx.2) :=
    ((F 0).continuous.measurable.comp measurable_snd).stronglyMeasurable
  have h1 : StronglyMeasurable (fun tx : ℝ × E3 ↦
      ModelCoordinateConvolution 0 (F 1) (ModelLowKernel (u 0))
        (tx.1 ^ α.weight 0) tx.2) :=
    stronglyMeasurable_modelCoordinateConvolution_joint
      0 (α.weight 0) (F 1) (ModelLowKernel (u 0))
      (F 1).continuous.measurable (measurable_ModelLowKernel (u 0))
  have h2 : StronglyMeasurable (fun tx : ℝ × E3 ↦
      ModelCoordinateConvolution 1 (F 2) (ModelLowKernel (u 1))
        (tx.1 ^ α.weight 1) tx.2) :=
    stronglyMeasurable_modelCoordinateConvolution_joint
      1 (α.weight 1) (F 2) (ModelLowKernel (u 1))
      (F 2).continuous.measurable (measurable_ModelLowKernel (u 1))
  have h3 : StronglyMeasurable (fun tx : ℝ × E3 ↦
      ModelCoordinateConvolution 2 (F 3) (ModelThirdKernel (u 2))
        (tx.1 ^ α.weight 2) tx.2) :=
    stronglyMeasurable_modelCoordinateConvolution_joint
      2 (α.weight 2) (F 3) (ModelThirdKernel (u 2))
      (F 3).continuous.measurable (measurable_ModelThirdKernel (u 2))
  change StronglyMeasurable (fun tx : ℝ × E3 ↦
    F 0 tx.2 *
      ModelCoordinateConvolution 0 (F 1) (ModelLowKernel (u 0))
        (tx.1 ^ α.weight 0) tx.2 *
      ModelCoordinateConvolution 1 (F 2) (ModelLowKernel (u 1))
        (tx.1 ^ α.weight 1) tx.2 *
      ModelCoordinateConvolution 2 (F 3) (ModelThirdKernel (u 2))
        (tx.1 ^ α.weight 2) tx.2)
  exact ((h0.mul h1).mul h2).mul h3

/-- A joint strongly measurable spatial integrand has a strongly measurable
scale profile.  This is the exact Fubini-measurability step needed by the
full-profile convergence bridge. -/
theorem stronglyMeasurable_modelSpatialProfile_of_joint
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput)
    (hjoint : StronglyMeasurable
      (fun tx : ℝ × E3 ↦ ModelSpatialIntegrand α u F tx.1 tx.2)) :
    StronglyMeasurable (ModelSpatialProfile α u F) := by
  change StronglyMeasurable (fun t : ℝ ↦
    ∫ x : E3, ModelSpatialIntegrand α u F t x)
  exact hjoint.integral_prod_right'

/-- Schwartz inputs make the literal spatial profile strongly measurable,
with no auxiliary integrability hypothesis: the Bochner integral uses its
standard zero convention off integrable fibers. -/
theorem stronglyMeasurable_ModelSpatialProfile
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) :
    StronglyMeasurable (ModelSpatialProfile α u F) :=
  stronglyMeasurable_modelSpatialProfile_of_joint α u F
    (stronglyMeasurable_ModelSpatialIntegrand α u F)

/-- A measurable coefficient times a jointly measurable spatial profile has
the exact a.e.-strong measurability required in the profile convergence
lemma. -/
theorem aestronglyMeasurable_modelScaleProfile_of_joint
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (hcmeas : Measurable c)
    (hjoint : StronglyMeasurable
      (fun tx : ℝ × E3 ↦ ModelSpatialIntegrand α u F tx.1 tx.2)) :
    AEStronglyMeasurable
      (fun t : ℝ ↦ c t * ModelSpatialProfile α u F t)
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))) := by
  exact hcmeas.aestronglyMeasurable.mul
    (stronglyMeasurable_modelSpatialProfile_of_joint α u F hjoint).aestronglyMeasurable

/-- This discharges the `hmeas` premise in the profile-to-full-form bridge
for every measurable bounded coefficient and every Schwartz input tuple.  A
bound on `c` is not needed for measurability itself. -/
theorem aestronglyMeasurable_modelScaleProfile_of_measurable
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (hcmeas : Measurable c) :
    AEStronglyMeasurable
      (fun t : ℝ ↦ c t * ModelSpatialProfile α u F t)
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))) := by
  exact aestronglyMeasurable_modelScaleProfile_of_joint
    α u c F hcmeas
    (stronglyMeasurable_ModelSpatialIntegrand α u F)

/-- Measurability is preserved by the literal coefficient cutoff used for
finite scale bands. -/
theorem measurable_RestrictScaleCoefficient
    (c : ℝ → ℝ) (A : Set ℝ) (hcmeas : Measurable c)
    (hAmeas : MeasurableSet A) :
    Measurable (RestrictScaleCoefficient c A) := by
  unfold RestrictScaleCoefficient
  exact hcmeas.indicator hAmeas

/-- The cutoff coefficient on an arbitrary measurable scale set satisfies
the same full-profile measurability premise. -/
theorem aestronglyMeasurable_modelScaleProfile_restrict
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (A : Set ℝ) (hcmeas : Measurable c) (hAmeas : MeasurableSet A) :
    AEStronglyMeasurable
      (fun t : ℝ ↦ RestrictScaleCoefficient c A t *
        ModelSpatialProfile α u F t)
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))) := by
  exact aestronglyMeasurable_modelScaleProfile_of_measurable
    α u (RestrictScaleCoefficient c A) F
    (measurable_RestrictScaleCoefficient c A hcmeas hAmeas)

/-- In particular, every literal dyadic scale cutoff has the profile
measurability needed to invoke the finite-forest localization identity. -/
theorem aestronglyMeasurable_modelScaleProfile_truncation_restrict
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (N : ℕ) (hcmeas : Measurable c) :
    AEStronglyMeasurable
      (fun t : ℝ ↦ RestrictScaleCoefficient c (truncationScaleSet N) t *
        ModelSpatialProfile α u F t)
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))) := by
  exact aestronglyMeasurable_modelScaleProfile_restrict
    α u c F (truncationScaleSet N) hcmeas measurableSet_Ioc

/-- The low-frequency physical kernel is integrable.  This is the large-scale
input for the model profile, after its fixed translation in `u`. -/
theorem integrable_ModelLowKernel (u : ℝ) :
    Integrable (ModelLowKernel u) := by
  let K : ℝ → ℝ := gaussian ⋆[ContinuousLinearMap.mul ℝ ℝ] conePhiPhysicalReal
  have hK : Integrable K :=
    integrable_gaussian.integrable_convolution (ContinuousLinearMap.mul ℝ ℝ)
      conePhiPhysicalReal.integrable
  have hshift : Integrable (fun w : ℝ ↦ K (w - u)) := hK.comp_sub_right u
  apply hshift.congr
  filter_upwards [] with w
  dsimp only [K]
  rw [convolution_mul]
  unfold ModelLowKernel
  apply integral_congr_ae
  filter_upwards [] with z
  congr 1
  ring

/-- At unit scale the signed third-coordinate kernel is a translated ordinary
convolution. The equality keeps its sign convention explicit. -/
theorem modelThirdKernel_unit_eq_convolution (u w : ℝ) :
    modelThirdKernel (-u) 1 0 w =
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal) (w - u) := by
  unfold modelThirdKernel kernelAt kernelDilate
  simp only [inv_one, one_smul]
  rw [convolution_mul]
  apply integral_congr_ae
  filter_upwards [] with z
  congr 1
  ring

/-- The unit-scale third-coordinate factor is integrable in its spatial
argument. -/
theorem integrable_modelThirdKernel_unit (u : ℝ) :
    Integrable (modelThirdKernel (-u) 1 0) := by
  let K : ℝ → ℝ := gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal
  have hK : Integrable K :=
    integrable_gaussianDeriv.integrable_convolution (ContinuousLinearMap.mul ℝ ℝ)
      conePsiPhysicalReal.integrable
  have hshift : Integrable (fun w : ℝ ↦ K (w - u)) := hK.comp_sub_right u
  apply hshift.congr
  filter_upwards [] with w
  dsimp only [K]
  exact (modelThirdKernel_unit_eq_convolution u w).symm

/-- The full third model kernel is integrable: it is one more convolution by
the Gaussian derivative of the preceding unit-scale factor. -/
theorem integrable_ModelThirdKernel (u : ℝ) :
    Integrable (ModelThirdKernel u) := by
  let G : ℝ → ℝ := modelThirdKernel (-u) 1 0
  let K : ℝ → ℝ := gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] G
  have hG : Integrable G := by
    simpa only [G] using integrable_modelThirdKernel_unit u
  have hK : Integrable K :=
    integrable_gaussianDeriv.integrable_convolution (ContinuousLinearMap.mul ℝ ℝ) hG
  apply hK.congr
  filter_upwards [] with w
  dsimp only [K, G]
  rw [convolution_mul]
  rfl

/-- The third model kernel has mean zero. Its outer Gaussian-derivative
factor is enough; no cancellation is lost in the translated inner kernel. -/
theorem integral_ModelThirdKernel (u : ℝ) :
    ∫ w : ℝ, ModelThirdKernel u w = 0 := by
  let G : ℝ → ℝ := modelThirdKernel (-u) 1 0
  let K : ℝ → ℝ := gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] G
  have hG : Integrable G := by
    simpa only [G] using integrable_modelThirdKernel_unit u
  have hK : Integrable K :=
    integrable_gaussianDeriv.integrable_convolution (ContinuousLinearMap.mul ℝ ℝ) hG
  have hEq : ModelThirdKernel u = K := by
    funext w
    dsimp only [K, G]
    rw [convolution_mul]
    rfl
  calc
    (∫ w : ℝ, ModelThirdKernel u w) = ∫ w : ℝ, K w := by rw [hEq]
    _ = (ContinuousLinearMap.mul ℝ ℝ)
        (∫ w : ℝ, gaussianDeriv w) (∫ w : ℝ, G w) :=
      integral_convolution (ContinuousLinearMap.mul ℝ ℝ) integrable_gaussianDeriv hG
    _ = 0 := by rw [integral_gaussianDeriv]; simp

/-- Positive normalized dilation preserves absolute `L¹` mass for an arbitrary
real kernel.  This packages the recurring change of variables needed for the
three model coordinate convolutions. -/
theorem integral_abs_kernelDilate (k : ℝ → ℝ) {s : ℝ} (hs : 0 < s) :
    ∫ x : ℝ, |kernelDilate k s x| = ∫ x : ℝ, |k x| := by
  unfold kernelDilate
  have hinv : 0 ≤ s⁻¹ := (inv_pos.mpr hs).le
  calc
    (∫ x : ℝ, |s⁻¹ • k (x / s)|) =
        ∫ x : ℝ, s⁻¹ • |k (x / s)| := by
          apply integral_congr_ae
          filter_upwards [] with x
          simp only [smul_eq_mul, abs_mul, abs_of_nonneg hinv]
    _ = s⁻¹ • ∫ x : ℝ, |k (x / s)| := by
          rw [integral_smul]
    _ = _ := by
      rw [Measure.integral_comp_div (fun x : ℝ ↦ |k x|) s]
      simp [smul_eq_mul, abs_of_pos hs, hs.ne']

/-- An integrable kernel remains absolutely integrable after a positive
normalized dilation. -/
theorem integrable_abs_kernelDilate (k : ℝ → ℝ) (hk : Integrable k)
    {s : ℝ} (hs : 0 < s) :
    Integrable (fun x : ℝ ↦ |kernelDilate k s x|) := by
  have hbase : Integrable (fun x : ℝ ↦ |k x|) := by
    simpa only [Real.norm_eq_abs] using hk.norm
  unfold kernelDilate
  refine ((hbase.comp_div hs.ne').smul (s⁻¹ : ℝ)).congr ?_
  filter_upwards [] with x
  simp only [Pi.smul_apply, smul_eq_mul, abs_mul,
    abs_of_pos (inv_pos.mpr hs)]

/-- A bounded continuous input convolved in one coordinate with an
integrable kernel is uniformly controlled by the absolute kernel mass. -/
theorem abs_ModelCoordinateConvolution_le
    (i : Fin 3) (f : E3 → ℝ) (k : ℝ → ℝ) (s : ℝ) (x : E3)
    (hfcont : Continuous f) (B : ℝ) (hf : ∀ y : E3, |f y| ≤ B)
    (hk : Integrable k) (hs : 0 < s) :
    |ModelCoordinateConvolution i f k s x| ≤ B * ∫ r : ℝ, |k r| := by
  let G : ℝ → ℝ := fun r ↦
    f (x - r • Anisotropy.coordinateDirection i) * kernelDilate k s r
  have hmap : Continuous (fun r : ℝ ↦
      x - r • Anisotropy.coordinateDirection i) :=
    continuous_const.sub (continuous_id.smul continuous_const)
  have hkd : Integrable (kernelDilate k s) := by
    unfold kernelDilate
    exact (hk.comp_div hs.ne').smul (s⁻¹ : ℝ)
  have hGmeas : AEStronglyMeasurable G volume :=
    ((hfcont.comp hmap).aestronglyMeasurable.mul hkd.aestronglyMeasurable)
  have hK : Integrable (fun r : ℝ ↦ |kernelDilate k s r|) :=
    integrable_abs_kernelDilate k hk hs
  have hupper : Integrable (fun r : ℝ ↦ B * |kernelDilate k s r|) :=
    hK.const_mul B
  have hG : Integrable G := by
    apply Integrable.mono' hupper hGmeas
    filter_upwards [] with r
    dsimp [G]
    rw [abs_mul]
    exact mul_le_mul_of_nonneg_right (hf _) (abs_nonneg _)
  unfold ModelCoordinateConvolution
  change |∫ r : ℝ, G r| ≤ _
  calc
    |∫ r : ℝ, G r| ≤ ∫ r : ℝ, |G r| :=
      MeasureTheory.abs_integral_le_integral_abs
    _ ≤ ∫ r : ℝ, B * |kernelDilate k s r| := by
      apply integral_mono hG.norm hupper
      intro r
      dsimp [G]
      rw [abs_mul]
      exact mul_le_mul_of_nonneg_right (hf _) (abs_nonneg _)
    _ = B * ∫ r : ℝ, |k r| := by
      rw [integral_const_mul, integral_abs_kernelDilate k hs]

/-- Integrating the low-frequency center pair produces the physical
low-frequency kernel at the difference coordinate. -/
theorem integral_modelPhiAt_mul_gaussianAt_center
    (s u x y : ℝ) (hs : 0 < s) :
    (∫ p : ℝ,
      modelPhiAt s (p + s * u) x * gaussianAt s p y) =
      kernelDilate (ModelLowKernel u) s (x - y) := by
  let w : ℝ := (x - y) / s
  let G : ℝ → ℝ := fun z ↦
    gaussian z * conePhiPhysicalReal (w - z - u)
  have hpoint (p : ℝ) :
      modelPhiAt s (p + s * u) x * gaussianAt s p y =
        s⁻¹ * s⁻¹ * G ((p - y) / s) := by
    dsimp only [G, w]
    unfold modelPhiAt gaussianAt kernelAt kernelDilate
    simp only [smul_eq_mul]
    rw [show (x - (p + s * u)) / s =
        (x - y) / s - (p - y) / s - u by field_simp; ring,
      show (y - p) / s = -((p - y) / s) by ring,
      gaussian_even]
    ring
  calc
    (∫ p : ℝ, modelPhiAt s (p + s * u) x * gaussianAt s p y) =
        ∫ p : ℝ, s⁻¹ * s⁻¹ * G ((p - y) / s) := by
          apply integral_congr_ae
          filter_upwards [] with p
          exact hpoint p
    _ = s⁻¹ * s⁻¹ * ∫ p : ℝ, G ((p - y) / s) := by
          rw [integral_const_mul]
    _ = s⁻¹ * s⁻¹ * (s * ∫ z : ℝ, G z) := by
          rw [integral_sub_right_eq_self (μ := volume)
            (fun p : ℝ ↦ G (p / s)) y,
            Measure.integral_comp_div]
          simp only [smul_eq_mul, abs_of_pos hs]
    _ = kernelDilate (ModelLowKernel u) s (x - y) := by
          dsimp only [G, w]
          unfold ModelLowKernel kernelDilate
          simp only [smul_eq_mul]
          field_simp

/-- Reflecting the center in the third model kernel switches the translation
parameter and contributes the odd Gaussian-derivative sign. -/
theorem modelThirdKernel_reflect
    (u r : ℝ) :
    modelThirdKernel u 1 0 (-r) =
      -modelThirdKernel (-u) 1 0 r := by
  let H : ℝ → ℝ := fun z ↦
    gaussianDeriv z * conePsiPhysicalReal (r - z - u)
  have hneg : MeasurePreserving (fun z : ℝ ↦ -z) volume volume :=
    Measure.measurePreserving_neg (volume : Measure ℝ)
  have hchange : (∫ z : ℝ, H (-z)) = ∫ z : ℝ, H z :=
    hneg.integral_comp (Homeomorph.neg ℝ).measurableEmbedding H
  unfold modelThirdKernel kernelAt kernelDilate
  simp only [inv_one, one_smul, sub_zero, div_one]
  calc
    (∫ z : ℝ, gaussianDeriv z * conePsiPhysicalReal ((-r) - z + u)) =
        -(∫ z : ℝ, H (-z)) := by
          rw [← integral_neg]
          apply integral_congr_ae
          filter_upwards [] with z
          dsimp only [H]
          rw [gaussianDeriv_neg,
            show -r - z + u = -(r + z - u) by ring,
            conePsiPhysicalReal_even]
          ring_nf
    _ = -(∫ z : ℝ, H z) := by rw [hchange]
    _ = -∫ z : ℝ,
        gaussianDeriv z * conePsiPhysicalReal (r - z + (-u)) := by
          dsimp only [H]
          congr 2

/-- Separating the normalized scale from the unit-scale third kernel. -/
theorem modelThirdKernel_eq_scale_dilate
    (u s p y : ℝ) :
    modelThirdKernel u s p y =
      s⁻¹ * modelThirdKernel u 1 0 ((y - p) / s) := by
  unfold modelThirdKernel kernelAt kernelDilate
  simp only [smul_eq_mul, inv_one, one_mul, sub_zero, div_one]

/-- Integrating the derivative/third-kernel center pair gives the third
physical convolution kernel, with its source-mandated minus sign. -/
theorem integral_gaussianDerivAt_mul_modelThirdKernel_center
    (s u x y : ℝ) (hs : 0 < s) :
    (∫ p : ℝ,
      gaussianDerivAt s p x * modelThirdKernel u s p y) =
      -kernelDilate (ModelThirdKernel u) s (x - y) := by
  let w : ℝ := (x - y) / s
  let G : ℝ → ℝ := fun z ↦
    gaussianDeriv z * modelThirdKernel (-u) 1 0 (w - z)
  have hpoint (p : ℝ) :
      gaussianDerivAt s p x * modelThirdKernel u s p y =
        -(s⁻¹ * s⁻¹) * G ((x - p) / s) := by
    rw [modelThirdKernel_eq_scale_dilate]
    dsimp only [G, w]
    unfold gaussianDerivAt kernelAt kernelDilate
    simp only [smul_eq_mul]
    rw [show (y - p) / s =
        -((x - y) / s - (x - p) / s) by field_simp; ring,
      modelThirdKernel_reflect]
    ring
  calc
    (∫ p : ℝ, gaussianDerivAt s p x * modelThirdKernel u s p y) =
        ∫ p : ℝ, -(s⁻¹ * s⁻¹) * G ((x - p) / s) := by
          apply integral_congr_ae
          filter_upwards [] with p
          exact hpoint p
    _ = -(s⁻¹ * s⁻¹) * ∫ p : ℝ, G ((x - p) / s) := by
          rw [integral_const_mul]
    _ = -(s⁻¹ * s⁻¹) * (s * ∫ z : ℝ, G z) := by
          rw [integral_sub_left_eq_self (fun p : ℝ ↦ G (p / s)) volume x,
            Measure.integral_comp_div]
          simp only [smul_eq_mul, abs_of_pos hs]
    _ = -kernelDilate (ModelThirdKernel u) s (x - y) := by
          dsimp only [G, w]
          unfold ModelThirdKernel kernelDilate
          simp only [smul_eq_mul]
          field_simp

/-- The three-center Fubini calculation in the right-associated coordinate
order used by `e3Coordinates`. -/
theorem integral_centerTriple_kernel_product_right
    (s₀ s₁ s₂ u₀ u₁ u₂ x₀ x₁ x₂ y₀ y₁ y₂ : ℝ)
    (hs₀ : 0 < s₀) (hs₁ : 0 < s₁) (hs₂ : 0 < s₂) :
    (∫ p : ℝ × (ℝ × ℝ),
      (modelPhiAt s₀ (p.1 + s₀ * u₀) x₀ * gaussianAt s₀ p.1 y₀) *
        (modelPhiAt s₁ (p.2.1 + s₁ * u₁) x₁ * gaussianAt s₁ p.2.1 y₁) *
        (gaussianDerivAt s₂ p.2.2 x₂ * modelThirdKernel u₂ s₂ p.2.2 y₂)) =
      -(kernelDilate (ModelLowKernel u₀) s₀ (x₀ - y₀) *
        kernelDilate (ModelLowKernel u₁) s₁ (x₁ - y₁) *
        kernelDilate (ModelThirdKernel u₂) s₂ (x₂ - y₂)) := by
  let A₀ : ℝ → ℝ := fun p ↦
    modelPhiAt s₀ (p + s₀ * u₀) x₀ * gaussianAt s₀ p y₀
  let A₁ : ℝ → ℝ := fun p ↦
    modelPhiAt s₁ (p + s₁ * u₁) x₁ * gaussianAt s₁ p y₁
  let A₂ : ℝ → ℝ := fun p ↦
    gaussianDerivAt s₂ p x₂ * modelThirdKernel u₂ s₂ p y₂
  have hA₀ : (∫ p : ℝ, A₀ p) =
      kernelDilate (ModelLowKernel u₀) s₀ (x₀ - y₀) := by
    dsimp only [A₀]
    exact integral_modelPhiAt_mul_gaussianAt_center s₀ u₀ x₀ y₀ hs₀
  have hA₁ : (∫ p : ℝ, A₁ p) =
      kernelDilate (ModelLowKernel u₁) s₁ (x₁ - y₁) := by
    dsimp only [A₁]
    exact integral_modelPhiAt_mul_gaussianAt_center s₁ u₁ x₁ y₁ hs₁
  have hA₂ : (∫ p : ℝ, A₂ p) =
      -kernelDilate (ModelThirdKernel u₂) s₂ (x₂ - y₂) := by
    dsimp only [A₂]
    exact integral_gaussianDerivAt_mul_modelThirdKernel_center
      s₂ u₂ x₂ y₂ hs₂
  change (∫ p : ℝ × (ℝ × ℝ), A₀ p.1 * A₁ p.2.1 * A₂ p.2.2) = _
  rw [Measure.volume_eq_prod]
  calc
    (∫ p : ℝ × (ℝ × ℝ), A₀ p.1 * A₁ p.2.1 * A₂ p.2.2
      ∂((volume : Measure ℝ).prod volume)) =
        (∫ q : ℝ, A₀ q) * ∫ r : ℝ × ℝ, A₁ r.1 * A₂ r.2 := by
          rw [show (fun p : ℝ × (ℝ × ℝ) ↦ A₀ p.1 * A₁ p.2.1 * A₂ p.2.2) =
            fun p ↦ A₀ p.1 * (A₁ p.2.1 * A₂ p.2.2) by
              funext p
              ring]
          exact MeasureTheory.integral_prod_mul A₀
            (fun r : ℝ × ℝ ↦ A₁ r.1 * A₂ r.2)
    _ = (∫ q : ℝ, A₀ q) * ((∫ r : ℝ, A₁ r) * ∫ z : ℝ, A₂ z) := by
          rw [Measure.volume_eq_prod]
          rw [MeasureTheory.integral_prod_mul]
    _ = -(kernelDilate (ModelLowKernel u₀) s₀ (x₀ - y₀) *
        kernelDilate (ModelLowKernel u₁) s₁ (x₁ - y₁) *
        kernelDilate (ModelThirdKernel u₂) s₂ (x₂ - y₂)) := by
          rw [hA₀, hA₁, hA₂]
          ring

/-- Transporting the scalar three-center calculation through the literal
Euclidean-coordinate equivalence gives the center integral occurring in the
three-dimensional model form. -/
theorem integral_E3_centerTriple_kernel_product
    (s₀ s₁ s₂ u₀ u₁ u₂ x₀ x₁ x₂ y₀ y₁ y₂ : ℝ)
    (hs₀ : 0 < s₀) (hs₁ : 0 < s₁) (hs₂ : 0 < s₂) :
    (∫ p : E3,
      (modelPhiAt s₀ (p 0 + s₀ * u₀) x₀ * gaussianAt s₀ (p 0) y₀) *
        (modelPhiAt s₁ (p 1 + s₁ * u₁) x₁ * gaussianAt s₁ (p 1) y₁) *
        (gaussianDerivAt s₂ (p 2) x₂ *
          modelThirdKernel u₂ s₂ (p 2) y₂)) =
      -(kernelDilate (ModelLowKernel u₀) s₀ (x₀ - y₀) *
        kernelDilate (ModelLowKernel u₁) s₁ (x₁ - y₁) *
        kernelDilate (ModelThirdKernel u₂) s₂ (x₂ - y₂)) := by
  let G : E3 → ℝ := fun p ↦
    (modelPhiAt s₀ (p 0 + s₀ * u₀) x₀ * gaussianAt s₀ (p 0) y₀) *
      (modelPhiAt s₁ (p 1 + s₁ * u₁) x₁ * gaussianAt s₁ (p 1) y₁) *
      (gaussianDerivAt s₂ (p 2) x₂ * modelThirdKernel u₂ s₂ (p 2) y₂)
  let e : E3 ≃ᵐ ℝ × (ℝ × ℝ) := e3Coordinates
  have hmp : MeasurePreserving e (volume : Measure E3)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    simpa only [e] using e3Coordinates_measurePreserving
  have htransport : (∫ z : ℝ × (ℝ × ℝ), G (e.symm z)) =
      ∫ p : E3, G p := by
    exact (MeasurePreserving.symm e hmp).integral_comp
      e.symm.measurableEmbedding G
  change (∫ p : E3, G p) = _
  rw [← htransport]
  calc
    (∫ z : ℝ × (ℝ × ℝ), G (e.symm z)) =
        ∫ z : ℝ × (ℝ × ℝ),
          (modelPhiAt s₀ (z.1 + s₀ * u₀) x₀ * gaussianAt s₀ z.1 y₀) *
            (modelPhiAt s₁ (z.2.1 + s₁ * u₁) x₁ * gaussianAt s₁ z.2.1 y₁) *
            (gaussianDerivAt s₂ z.2.2 x₂ * modelThirdKernel u₂ s₂ z.2.2 y₂) := by
          apply integral_congr_ae
          filter_upwards [] with z
          have heq := e.apply_symm_apply z
          have h0 : (e.symm z) 0 = z.1 := by
            simpa only [e, e3Coordinates_apply] using congrArg Prod.fst heq
          have h1 : (e.symm z) 1 = z.2.1 := by
            simpa only [e, e3Coordinates_apply] using
              congrArg (fun q : ℝ × (ℝ × ℝ) ↦ q.2.1) heq
          have h2 : (e.symm z) 2 = z.2.2 := by
            simpa only [e, e3Coordinates_apply] using
              congrArg (fun q : ℝ × (ℝ × ℝ) ↦ q.2.2) heq
          dsimp only [G]
          rw [h0, h1, h2]
    _ = -(kernelDilate (ModelLowKernel u₀) s₀ (x₀ - y₀) *
        kernelDilate (ModelLowKernel u₁) s₁ (x₁ - y₁) *
        kernelDilate (ModelThirdKernel u₂) s₂ (x₂ - y₂)) :=
      integral_centerTriple_kernel_product_right
        s₀ s₁ s₂ u₀ u₁ u₂ x₀ x₁ x₂ y₀ y₁ y₂ hs₀ hs₁ hs₂

/-- Fubini lifts the center calculation through any absolutely integrable
outer parameter.  This is the form used when the remaining six spatial
variables carry the four model inputs. -/
theorem integral_centerTriple_weighted_of_integrable
    {X : Type*} [MeasurableSpace X] (μ : Measure X) [SFinite μ]
    (s₀ s₁ s₂ u₀ u₁ u₂ : ℝ)
    (W x₀ x₁ x₂ y₀ y₁ y₂ : X → ℝ)
    (hs₀ : 0 < s₀) (hs₁ : 0 < s₁) (hs₂ : 0 < s₂)
    (hjoint : Integrable (fun q : X × E3 ↦
      W q.1 *
        ((modelPhiAt s₀ (q.2 0 + s₀ * u₀) (x₀ q.1) *
            gaussianAt s₀ (q.2 0) (y₀ q.1)) *
          (modelPhiAt s₁ (q.2 1 + s₁ * u₁) (x₁ q.1) *
            gaussianAt s₁ (q.2 1) (y₁ q.1)) *
          (gaussianDerivAt s₂ (q.2 2) (x₂ q.1) *
            modelThirdKernel u₂ s₂ (q.2 2) (y₂ q.1))))
      (μ.prod volume)) :
    (∫ q : X × E3,
      W q.1 *
        ((modelPhiAt s₀ (q.2 0 + s₀ * u₀) (x₀ q.1) *
            gaussianAt s₀ (q.2 0) (y₀ q.1)) *
          (modelPhiAt s₁ (q.2 1 + s₁ * u₁) (x₁ q.1) *
            gaussianAt s₁ (q.2 1) (y₁ q.1)) *
          (gaussianDerivAt s₂ (q.2 2) (x₂ q.1) *
            modelThirdKernel u₂ s₂ (q.2 2) (y₂ q.1)))
      ∂(μ.prod volume)) =
      -(∫ z : X,
        W z *
          (kernelDilate (ModelLowKernel u₀) s₀ (x₀ z - y₀ z) *
            kernelDilate (ModelLowKernel u₁) s₁ (x₁ z - y₁ z) *
            kernelDilate (ModelThirdKernel u₂) s₂ (x₂ z - y₂ z)) ∂μ) := by
  let C : X → E3 → ℝ := fun z p ↦
    (modelPhiAt s₀ (p 0 + s₀ * u₀) (x₀ z) *
        gaussianAt s₀ (p 0) (y₀ z)) *
      (modelPhiAt s₁ (p 1 + s₁ * u₁) (x₁ z) *
        gaussianAt s₁ (p 1) (y₁ z)) *
      (gaussianDerivAt s₂ (p 2) (x₂ z) *
        modelThirdKernel u₂ s₂ (p 2) (y₂ z))
  let K : X → ℝ := fun z ↦
    kernelDilate (ModelLowKernel u₀) s₀ (x₀ z - y₀ z) *
      kernelDilate (ModelLowKernel u₁) s₁ (x₁ z - y₁ z) *
      kernelDilate (ModelThirdKernel u₂) s₂ (x₂ z - y₂ z)
  change (∫ q : X × E3, W q.1 * C q.1 q.2 ∂(μ.prod volume)) =
    -(∫ z : X, W z * K z ∂μ)
  calc
    (∫ q : X × E3, W q.1 * C q.1 q.2 ∂(μ.prod volume)) =
        ∫ z : X, (∫ p : E3, W z * C z p ∂volume) ∂μ :=
      MeasureTheory.integral_prod _ hjoint
    _ = ∫ z : X, W z * (∫ p : E3, C z p ∂volume) ∂μ := by
      apply integral_congr_ae
      filter_upwards [] with z
      rw [← integral_const_mul]
    _ = ∫ z : X, W z * (-K z) ∂μ := by
      apply integral_congr_ae
      filter_upwards [] with z
      rw [integral_E3_centerTriple_kernel_product
        s₀ s₁ s₂ u₀ u₁ u₂ (x₀ z) (x₁ z) (x₂ z)
          (y₀ z) (y₁ z) (y₂ z) hs₀ hs₁ hs₂]
    _ = -(∫ z : X, W z * K z ∂μ) := by
      rw [← integral_neg]
      apply integral_congr_ae
      filter_upwards [] with z
      ring

/-- Mass-normalized dilation preserves integrability at every nonzero scale. -/
theorem integrable_kernelDilate
    {v : ℝ → ℝ} (hv : Integrable v) {s : ℝ} (hs : s ≠ 0) :
    Integrable (fun x : ℝ ↦ kernelDilate v s x) := by
  unfold kernelDilate
  simp only [smul_eq_mul]
  exact (hv.comp_div hs).const_mul s⁻¹

/-- Both physical low-frequency factors are integrable at every positive
model scale. -/
theorem integrable_ModelLowKernel_dilate
    (u s : ℝ) (hs : 0 < s) :
    Integrable (fun x : ℝ ↦ kernelDilate (ModelLowKernel u) s x) := by
  exact integrable_kernelDilate (integrable_ModelLowKernel u) hs.ne'

/-- The signed third physical factor is integrable at every positive model
scale. -/
theorem integrable_ModelThirdKernel_dilate
    (u s : ℝ) (hs : 0 < s) :
    Integrable (fun x : ℝ ↦ kernelDilate (ModelThirdKernel u) s x) := by
  exact integrable_kernelDilate (integrable_ModelThirdKernel u) hs.ne'

/-! ## Section 6: Schwartz maximal-function bridges

This scratch development keeps the source's literal all-positive-scales
anisotropic maxima.  The initial block isolates elementary fixed-scale and
finite-scale facts which are reusable independently of the remaining
Hardy--Littlewood iteration.
-/

/-- The real-valued Schwartz inputs used in the initial model range have an
explicit polynomial tail in the Euclidean norm.  This is the real analogue of
the earlier complex Schwartz decay extractor, stated here because Section 6
uses real second and fourth moments. -/
theorem realSchwartz_decay_norm
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : SchwartzMap E ℝ) (r : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : E, |f x| ≤ C / (1 + ‖x‖) ^ r := by
  let C : ℝ := 2 ^ r *
    (Finset.Iic (r, 0)).sup (fun q ↦ SchwartzMap.seminorm ℝ q.1 q.2) f
  have hC : 0 ≤ C := by
    have h := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ)
      (m := (r, 0)) le_rfl le_rfl f (0 : E)
    have hnonneg : 0 ≤ (1 + ‖(0 : E)‖) ^ r *
        ‖iteratedFDeriv ℝ 0 f (0 : E)‖ :=
      mul_nonneg (pow_nonneg (by positivity) _) (norm_nonneg _)
    exact hnonneg.trans (by simpa [C] using h)
  refine ⟨C, hC, fun x ↦ ?_⟩
  apply (le_div_iff₀ (by positivity)).mpr
  rw [mul_comm]
  simpa [C, Real.norm_eq_abs, norm_iteratedFDeriv_zero] using
    (SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ)
      (m := (r, 0)) le_rfl le_rfl f x)

/-- The Euclidean norm on the literal three-coordinate source space is at
most the coordinate `ℓ¹` norm.  Keeping this elementary comparison explicit
lets later kernel estimates reduce spatial escape to one coordinate. -/
theorem norm_le_sum_abs (v : E3) :
    ‖v‖ ≤ |v 0| + |v 1| + |v 2| := by
  rw [EuclideanSpace.norm_eq]
  apply (Real.sqrt_le_iff).mpr
  constructor
  · positivity
  rw [Fin.sum_univ_three]
  simp only [Real.norm_eq_abs]
  have h01 : 0 ≤ |v 0| * |v 1| := mul_nonneg (abs_nonneg _) (abs_nonneg _)
  have h02 : 0 ≤ |v 0| * |v 2| := mul_nonneg (abs_nonneg _) (abs_nonneg _)
  have h12 : 0 ≤ |v 1| * |v 2| := mul_nonneg (abs_nonneg _) (abs_nonneg _)
  nlinarith

/-- The product of the three coordinate Japanese brackets dominates one plus
their sum. -/
theorem one_add_sum_le_prod_one_add
    (a : Fin 3 → ℝ) (ha : ∀ i, 0 ≤ a i) :
    1 + ∑ i, a i ≤ ∏ i, (1 + a i) := by
  rw [Fin.sum_univ_three, Fin.prod_univ_three]
  have h01 : 0 ≤ a 0 * a 1 := mul_nonneg (ha _) (ha _)
  have h02 : 0 ≤ a 0 * a 2 := mul_nonneg (ha _) (ha _)
  have h12 : 0 ≤ a 1 * a 2 := mul_nonneg (ha _) (ha _)
  have h012 : 0 ≤ a 0 * a 1 * a 2 :=
    mul_nonneg h01 (ha _)
  nlinarith

/-- The product bracket on `E3` dominates the usual radial Japanese bracket.
This is the source's elementary product-to-radial tail comparison. -/
theorem one_add_norm_le_prod_one_add_abs (v : E3) :
    1 + ‖v‖ ≤ ∏ i : Fin 3, (1 + |v i|) := by
  calc
    1 + ‖v‖ ≤ 1 + ∑ i, |v i| := by
      gcongr
      simpa only [Fin.sum_univ_three] using norm_le_sum_abs v
    _ ≤ ∏ i : Fin 3, (1 + |v i|) :=
      one_add_sum_le_prod_one_add (fun i ↦ |v i|)
        (fun _ ↦ abs_nonneg _)

/-- After positive coordinate rescaling, the product bracket still dominates
the radial bracket at the sum of the three scales. -/
theorem one_add_norm_div_sum_le_prod_scaled
    (v : E3) (s : Fin 3 → ℝ) (hs : ∀ i, 0 < s i) :
    1 + ‖v‖ / (∑ i, s i) ≤ ∏ i, (1 + |v i / s i|) := by
  let S : ℝ := ∑ i, s i
  have hS : 0 < S := by
    dsimp only [S]
    exact Finset.sum_pos (fun i _ ↦ hs i) (by simp)
  have hsiS (i : Fin 3) : s i ≤ S := by
    dsimp only [S]
    exact Finset.single_le_sum (fun j _ ↦ (hs j).le) (Finset.mem_univ i)
  have hcoord (i : Fin 3) : |v i| / S ≤ |v i / s i| := by
    rw [abs_div, abs_of_pos (hs i)]
    apply (div_le_div_iff₀ hS (hs i)).mpr
    exact mul_le_mul_of_nonneg_left (hsiS i) (abs_nonneg _)
  calc
    1 + ‖v‖ / S ≤ 1 + (∑ i, |v i|) / S := by
      apply add_le_add_right
      exact div_le_div_of_nonneg_right
        (by simpa only [Fin.sum_univ_three] using norm_le_sum_abs v) hS.le
    _ = 1 + ∑ i, |v i| / S := by rw [Finset.sum_div]
    _ ≤ 1 + ∑ i, |v i / s i| := by
      apply add_le_add_right
      exact Finset.sum_le_sum fun i _ ↦ hcoord i
    _ ≤ ∏ i, (1 + |v i / s i|) :=
      one_add_sum_le_prod_one_add (fun i ↦ |v i / s i|)
        (fun _ ↦ abs_nonneg _)

/-- A finite product commutes with the fixed negative bracket exponent on
nonnegative factors. -/
theorem prod_rpow_neg_ten
    (a : Fin 3 → ℝ) (ha : ∀ i, 0 ≤ a i) :
    (∏ i, (a i) ^ (-10 : ℝ)) = (∏ i, a i) ^ (-10 : ℝ) := by
  rw [Fin.prod_univ_three]
  rw [← Real.mul_rpow (ha 0) (ha 1)]
  rw [← Real.mul_rpow (mul_nonneg (ha 0) (ha 1)) (ha 2)]
  rw [Fin.prod_univ_three]

/-- The unnormalized product of three rescaled bracket kernels is controlled
by one radial bracket. -/
theorem prod_bracketKernel_le_radial
    (v : E3) (s : Fin 3 → ℝ) (hs : ∀ i, 0 < s i) :
    (∏ i, bracketKernel (v i / s i)) ≤
      (1 + ‖v‖ / (∑ i, s i)) ^ (-10 : ℝ) := by
  have hS : 0 < ∑ i, s i :=
    Finset.sum_pos (fun i _ ↦ hs i) (by simp)
  have hbracket : ∀ i : Fin 3, bracketKernel (v i / s i) =
      (1 + |v i / s i|) ^ (-10 : ℝ) := by
    intro i
    rfl
  rw [show (∏ i, bracketKernel (v i / s i)) =
      ∏ i, (1 + |v i / s i|) ^ (-10 : ℝ) by
        apply Finset.prod_congr rfl
        intro i _
        exact hbracket i]
  rw [prod_rpow_neg_ten (fun i ↦ 1 + |v i / s i|)
    (fun i ↦ by positivity)]
  exact Real.rpow_le_rpow_of_nonpos
    (add_pos_of_pos_of_nonneg zero_lt_one (div_nonneg (norm_nonneg _) hS.le))
    (one_add_norm_div_sum_le_prod_scaled v s hs)
    (by norm_num)

/-- At each fixed positive anisotropic scale, the literal product comparison
kernel has a radial polynomial tail in the center variable. -/
theorem anisotropicBracketKernel_le_radial
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p y : E3) :
    anisotropicBracketKernel α t p y ≤
      (∏ i : Fin 3, (t ^ α.weight i)⁻¹) *
        (1 + ‖y - p‖ / (∑ i : Fin 3, t ^ α.weight i)) ^ (-10 : ℝ) := by
  have hs (i : Fin 3) : 0 < t ^ α.weight i := pow_pos ht _
  have hrewrite (i : Fin 3) :
      bracketKernelAt (t ^ α.weight i) (p i) (y i) =
        (t ^ α.weight i)⁻¹ * bracketKernel ((y - p) i / (t ^ α.weight i)) := by
    simp only [bracketKernelAt, kernelAt, kernelDilate, smul_eq_mul,
      PiLp.sub_apply]
  calc
    anisotropicBracketKernel α t p y =
        ∏ i : Fin 3, ((t ^ α.weight i)⁻¹ *
          bracketKernel ((y - p) i / (t ^ α.weight i))) := by
      unfold anisotropicBracketKernel
      apply Finset.prod_congr rfl
      intro i _
      exact hrewrite i
    _ = (∏ i : Fin 3, (t ^ α.weight i)⁻¹) *
        ∏ i : Fin 3, bracketKernel ((y - p) i / (t ^ α.weight i)) := by
      rw [Finset.prod_mul_distrib]
    _ ≤ (∏ i : Fin 3, (t ^ α.weight i)⁻¹) *
        (1 + ‖y - p‖ / (∑ i : Fin 3, t ^ α.weight i)) ^ (-10 : ℝ) := by
      apply mul_le_mul_of_nonneg_left
        (prod_bracketKernel_le_radial (y - p)
          (fun i ↦ t ^ α.weight i) hs)
      apply Finset.prod_nonneg
      intro i _
      exact inv_nonneg.mpr (hs i).le

/-- A fixed anisotropic comparison kernel vanishes when its center escapes to
spatial infinity.  This is the pointwise tail input for dominated convergence
in the fixed-scale second and fourth moments. -/
theorem tendsto_anisotropicBracketKernel_center
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (y : E3) :
    Tendsto (fun p : E3 ↦ anisotropicBracketKernel α t p y)
      (cocompact E3) (𝓝 0) := by
  let S : ℝ := ∑ i : Fin 3, t ^ α.weight i
  let C : ℝ := ∏ i : Fin 3, (t ^ α.weight i)⁻¹
  have hS : 0 < S := by
    dsimp only [S]
    exact Finset.sum_pos (fun i _ ↦ pow_pos ht _) (by simp)
  have hC : 0 ≤ C := by
    dsimp only [C]
    apply Finset.prod_nonneg
    intro i _
    exact inv_nonneg.mpr (pow_pos ht _).le
  have hdist : Tendsto (fun p : E3 ↦ ‖y - p‖)
      (cocompact E3) atTop := by
    convert tendsto_dist_left_cocompact_atTop y using 1
    ext p
    exact (dist_eq_norm_sub y p).symm
  have hbase : Tendsto (fun p : E3 ↦ 1 + ‖y - p‖ / S)
      (cocompact E3) atTop := by
    exact tendsto_atTop_add_const_left _ 1
      (hdist.atTop_div_const hS)
  have htail : Tendsto (fun p : E3 ↦
      (1 + ‖y - p‖ / S) ^ (-10 : ℝ))
      (cocompact E3) (𝓝 0) := by
    exact (tendsto_rpow_neg_atTop (by norm_num : 0 < (10 : ℝ))).comp hbase
  have hmajor : Tendsto (fun p : E3 ↦ C *
      (1 + ‖y - p‖ / S) ^ (-10 : ℝ))
      (cocompact E3) (𝓝 0) := by
    simpa only [mul_zero] using tendsto_const_nhds.mul htail
  apply squeeze_zero
  · intro p
    exact anisotropicBracketKernel_nonneg α ht.le p y
  · intro p
    simpa only [S, C] using
      anisotropicBracketKernel_le_radial α ht p y
  · exact hmajor

/-- Each one-dimensional comparison bracket is at most one before its scale
normalization. -/
theorem bracketKernel_le_one (x : ℝ) : bracketKernel x ≤ 1 := by
  unfold bracketKernel
  apply Real.rpow_le_one_of_one_le_of_nonpos
  · linarith [abs_nonneg x]
  · norm_num

/-- The literal anisotropic kernel is bounded by its product scale density. -/
theorem anisotropicBracketKernel_le_scaleDensity
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p y : E3) :
    anisotropicBracketKernel α t p y ≤
      ∏ i : Fin 3, (t ^ α.weight i)⁻¹ := by
  have hs (i : Fin 3) : 0 < t ^ α.weight i := pow_pos ht _
  calc
    anisotropicBracketKernel α t p y =
        ∏ i : Fin 3, ((t ^ α.weight i)⁻¹ *
          bracketKernel ((y i - p i) / (t ^ α.weight i))) := by
      unfold anisotropicBracketKernel bracketKernelAt kernelAt kernelDilate
      apply Finset.prod_congr rfl
      intro i _
      simp only [smul_eq_mul]
    _ ≤ ∏ i : Fin 3, ((t ^ α.weight i)⁻¹ * 1) := by
      apply Finset.prod_le_prod
      · intro i _
        exact mul_nonneg (inv_nonneg.mpr (hs i).le) (bracketKernel_nonneg _)
      · intro i _
        exact mul_le_mul_of_nonneg_left
          (bracketKernel_le_one _) (inv_nonneg.mpr (hs i).le)
    _ = ∏ i : Fin 3, (t ^ α.weight i)⁻¹ := by simp

/-- Dominated convergence turns the fixed-kernel tail into a tail for a
fixed-scale second moment.  The hypotheses are deliberately analytic rather
than Schwartz-specific, so the later Schwartz corollary has no hidden gap. -/
theorem tendsto_cubeSecondMoment_fixedScale
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (f : E3 → ℝ)
    (hfcont : Continuous f) (hfSq : Integrable (fun y : E3 ↦ f y ^ 2)) :
    Tendsto (fun p : E3 ↦ cubeSecondMoment α t p f)
      (cocompact E3) (𝓝 0) := by
  letI : (cocompact E3).IsCountablyGenerated := by
    rw [← comap_dist_left_atTop_eq_cocompact (0 : E3)]
    infer_instance
  let C : ℝ := ∏ i : Fin 3, (t ^ α.weight i)⁻¹
  have hC : 0 ≤ C := by
    dsimp only [C]
    apply Finset.prod_nonneg
    intro i _
    exact inv_nonneg.mpr (pow_pos ht _).le
  have hbound : Integrable (fun y : E3 ↦ C * f y ^ 2) :=
    hfSq.const_mul C
  have hdc := tendsto_integral_filter_of_dominated_convergence
    (μ := volume) (l := cocompact E3)
    (F := fun p y ↦ f y ^ 2 * anisotropicBracketKernel α t p y)
    (f := fun _ : E3 ↦ (0 : ℝ))
    (fun y ↦ C * f y ^ 2)
    (Filter.Eventually.of_forall (fun p ↦
      ((hfcont.pow 2).mul (continuous_anisotropicBracketKernel α ht p)).aestronglyMeasurable))
    (Filter.Eventually.of_forall (fun p ↦ Filter.Eventually.of_forall (fun y ↦ by
      rw [Real.norm_eq_abs,
        abs_of_nonneg (mul_nonneg (sq_nonneg _)
          (anisotropicBracketKernel_nonneg α ht.le p y))]
      simpa only [mul_comm] using mul_le_mul_of_nonneg_left
        (anisotropicBracketKernel_le_scaleDensity α ht p y) (sq_nonneg _))))
    hbound
    (Filter.Eventually.of_forall (fun y ↦ by
      have hkernel := tendsto_anisotropicBracketKernel_center α ht y
      simpa only [mul_zero] using tendsto_const_nhds.mul hkernel))
  simpa only [cubeSecondMoment, integral_zero] using hdc

/-- Fixed-scale exponent-two anisotropic averages of a real Schwartz input
vanish at spatial infinity. -/
theorem tendsto_cubeSecondMoment_fixedScale_of_realSchwartz
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (f : SchwartzMap E3 ℝ) :
    Tendsto (fun p : E3 ↦ cubeSecondMoment α t p f)
      (cocompact E3) (𝓝 0) := by
  apply tendsto_cubeSecondMoment_fixedScale α ht f f.continuous
  have hmem : MemLp f (2 : ℝ≥0∞) volume := f.memLp 2 volume
  simpa only [Real.norm_eq_abs, sq_abs] using
    hmem.integrable_norm_pow (by norm_num : (2 : ℕ) ≠ 0)

/-! ### One-dimensional scale-uniform comparison -/

/-- A positive-scale bracket kernel is bounded by its scale density. -/
theorem bracketKernelAt_le_inv_scale {s : ℝ} (hs : 0 < s)
    (p y : ℝ) :
    bracketKernelAt s p y ≤ s⁻¹ := by
  unfold bracketKernelAt kernelAt kernelDilate
  change s⁻¹ * bracketKernel ((y - p) / s) ≤ s⁻¹
  simpa using mul_le_mul_of_nonneg_left
    (bracketKernel_le_one ((y - p) / s)) (inv_nonneg.mpr hs.le)

/-- Away from the center, a small-scale bracket kernel has a uniform
polynomial bound.  The deliberately generous constant keeps later
annular bookkeeping elementary. -/
theorem bracketKernelAt_le_remote
    {s p y : ℝ} (hs : 0 < s) (hp : 1 ≤ |p|)
    (hscale : s ≤ |p| / 4) (hy : |y| ≤ |p| / 2) :
    bracketKernelAt s p y ≤ (2 : ℝ) ^ 10 / |p| := by
  have hp0 : 0 < |p| := lt_of_lt_of_le zero_lt_one hp
  have hdist : |p| / 2 ≤ |y - p| := by
    have htri : |p| ≤ |y| + |y - p| := by
      calc
        |p| = |y + (p - y)| := by
          congr 1
          ring
        _ ≤ |y| + |p - y| := abs_add_le _ _
        _ = |y| + |y - p| := by rw [abs_sub_comm]
    linarith
  have hratio : |p| / (2 * s) ≤ |(y - p) / s| := by
    rw [abs_div, abs_of_pos hs]
    calc
      |p| / (2 * s) = (|p| / 2) / s := by field_simp
      _ ≤ |y - p| / s := div_le_div_of_nonneg_right hdist hs.le
  have hbase : |p| / (2 * s) ≤ 1 + |(y - p) / s| := by
    linarith [abs_nonneg ((y - p) / s)]
  have hbasepos : 0 < |p| / (2 * s) := by positivity
  have hpow : (1 + |(y - p) / s|) ^ 10 ≥
      (|p| / (2 * s)) ^ 10 := by
    exact pow_le_pow_left₀ (by positivity) hbase 10
  rw [bracketKernelAt, kernelAt, kernelDilate, smul_eq_mul,
    bracketKernel_eq_inv_pow]
  have hinv : ((1 + |(y - p) / s|) ^ 10)⁻¹ ≤
      ((|p| / (2 * s)) ^ 10)⁻¹ := by
    exact inv_anti₀ (pow_pos hbasepos 10) hpow
  calc
    s⁻¹ * ((1 + |(y - p) / s|) ^ 10)⁻¹ ≤
        s⁻¹ * ((|p| / (2 * s)) ^ 10)⁻¹ :=
      mul_le_mul_of_nonneg_left hinv (inv_nonneg.mpr hs.le)
    _ = (2 : ℝ) ^ 10 * s ^ 9 / |p| ^ 10 := by
      field_simp
    _ ≤ (2 : ℝ) ^ 10 / |p| := by
      have hsle : s ≤ |p| := le_trans hscale (by nlinarith)
      have hspow : s ^ 9 ≤ |p| ^ 9 :=
        pow_le_pow_left₀ hs.le hsle 9
      have hquot : s ^ 9 / |p| ^ 10 ≤ 1 / |p| := by
        apply (div_le_div_iff₀ (pow_pos hp0 10) hp0).mpr
        calc
          s ^ 9 * |p| ≤ |p| ^ 9 * |p| :=
            mul_le_mul_of_nonneg_right hspow hp0.le
          _ = 1 * |p| ^ 10 := by ring
      calc
        (2 : ℝ) ^ 10 * s ^ 9 / |p| ^ 10 =
            (2 : ℝ) ^ 10 * (s ^ 9 / |p| ^ 10) := by ring
        _ ≤ (2 : ℝ) ^ 10 * (1 / |p|) :=
          mul_le_mul_of_nonneg_left hquot (by positivity)
        _ = (2 : ℝ) ^ 10 / |p| := by ring

/-- The unit bracket itself has the matching remote-center estimate. -/
theorem bracketKernel_le_remote
    {p y : ℝ} (hp : 1 ≤ |p|) (hy : |p| / 2 ≤ |y|) :
    bracketKernel y ≤ (2 : ℝ) ^ 10 / |p| := by
  have hp0 : 0 < |p| := lt_of_lt_of_le zero_lt_one hp
  have hbase : |p| / 2 ≤ 1 + |y| := by linarith
  have hbasepos : 0 < |p| / 2 := by positivity
  have hpow : (|p| / 2) ^ 10 ≤ (1 + |y|) ^ 10 :=
    pow_le_pow_left₀ (by positivity) hbase 10
  rw [bracketKernel_eq_inv_pow]
  calc
    ((1 + |y|) ^ 10)⁻¹ ≤ ((|p| / 2) ^ 10)⁻¹ :=
      inv_anti₀ (pow_pos hbasepos 10) hpow
    _ = (2 : ℝ) ^ 10 / |p| ^ 10 := by
      field_simp
    _ ≤ (2 : ℝ) ^ 10 / |p| := by
      have hpow : 1 ≤ |p| ^ 9 :=
        one_le_pow₀ hp
      have hquot : 1 / |p| ^ 10 ≤ 1 / |p| := by
        apply (div_le_div_iff₀ (pow_pos hp0 10) hp0).mpr
        calc
          1 * |p| ≤ |p| ^ 9 * |p| :=
            mul_le_mul_of_nonneg_right hpow hp0.le
          _ = 1 * |p| ^ 10 := by ring
      calc
        (2 : ℝ) ^ 10 / |p| ^ 10 = (2 : ℝ) ^ 10 * (1 / |p| ^ 10) := by ring
        _ ≤ (2 : ℝ) ^ 10 * (1 / |p|) :=
          mul_le_mul_of_nonneg_left hquot (by positivity)
        _ = (2 : ℝ) ^ 10 / |p| := by ring

/-- Products of a unit bracket and a positive-scale bracket kernel are
integrable; this is the basic one-dimensional Fubini input. -/
theorem integrable_bracketKernel_mul_bracketKernelAt
    {s : ℝ} (hs : 0 < s) (p : ℝ) :
    Integrable (fun y : ℝ ↦ bracketKernel y * bracketKernelAt s p y) := by
  refine (integrable_bracketKernelAt hs p).mono
    ((continuous_bracketKernel.mul (continuous_bracketKernelAt hs.ne' p)).aestronglyMeasurable) ?_
  filter_upwards [] with y
  rw [Real.norm_eq_abs,
    abs_of_nonneg (mul_nonneg (bracketKernel_nonneg _)
      (bracketKernelAt_nonneg hs.le)),
    Real.norm_eq_abs, abs_of_nonneg (bracketKernelAt_nonneg hs.le)]
  exact (mul_le_of_le_one_left (bracketKernelAt_nonneg hs.le)
    (bracketKernel_le_one _))

/-- The product bracket average is bounded by the mass of either factor. -/
theorem integral_bracketKernel_mul_bracketKernelAt_le_mass
    {s : ℝ} (hs : 0 < s) (p : ℝ) :
    ∫ y : ℝ, bracketKernel y * bracketKernelAt s p y ≤ 2 / 9 := by
  have hleft := integrable_bracketKernel_mul_bracketKernelAt hs p
  have hright := integrable_bracketKernelAt hs p
  calc
    (∫ y : ℝ, bracketKernel y * bracketKernelAt s p y) ≤
        ∫ y : ℝ, bracketKernelAt s p y :=
      MeasureTheory.integral_mono_ae hleft hright
        (Filter.Eventually.of_forall fun y ↦
          mul_le_of_le_one_left (bracketKernelAt_nonneg hs.le)
            (bracketKernel_le_one _))
    _ = 2 / 9 := integral_bracketKernelAt hs p

/-- At scales no smaller than the escaping coordinate, the product average
is controlled directly by scale density. -/
theorem integral_bracketKernel_mul_bracketKernelAt_le_largeScale
    {s p : ℝ} (hs : 0 < s) (hp : 1 ≤ |p|) (hscale : |p| / 4 ≤ s) :
    ∫ y : ℝ, bracketKernel y * bracketKernelAt s p y ≤
      (4 / |p|) * (2 / 9) := by
  have hp0 : 0 < |p| := lt_of_lt_of_le zero_lt_one hp
  have hquot : s⁻¹ ≤ 4 / |p| := by
    calc
      s⁻¹ ≤ (|p| / 4)⁻¹ := inv_anti₀ (by positivity) hscale
      _ = 4 / |p| := by field_simp
  have hleft := integrable_bracketKernel_mul_bracketKernelAt hs p
  have hright : Integrable (fun y : ℝ ↦ (4 / |p|) * bracketKernel y) :=
    integrable_bracketKernel.const_mul _
  calc
    (∫ y : ℝ, bracketKernel y * bracketKernelAt s p y) ≤
        ∫ y : ℝ, (4 / |p|) * bracketKernel y :=
      MeasureTheory.integral_mono_ae hleft hright
        (Filter.Eventually.of_forall fun y ↦ by
          have hK := bracketKernelAt_le_inv_scale hs p y
          calc
            bracketKernel y * bracketKernelAt s p y ≤
                bracketKernel y * (4 / |p|) :=
              mul_le_mul_of_nonneg_left (hK.trans hquot) (bracketKernel_nonneg _)
            _ = (4 / |p|) * bracketKernel y := by ring)
    _ = (4 / |p|) * (2 / 9) := by
      rw [MeasureTheory.integral_const_mul, integral_bracketKernel]

/-- At smaller scales, either the center kernel is remote or the unit
bracket is remote.  This pointwise dichotomy is the core of the uniform
one-dimensional tail estimate. -/
theorem bracketKernel_mul_bracketKernelAt_le_smallScale
    {s p y : ℝ} (hs : 0 < s) (hp : 1 ≤ |p|)
    (hscale : s ≤ |p| / 4) :
    bracketKernel y * bracketKernelAt s p y ≤
      ((2 : ℝ) ^ 10 / |p|) *
        (bracketKernel y + bracketKernelAt s p y) := by
  have hp0 : 0 < |p| := lt_of_lt_of_le zero_lt_one hp
  have hcoeff : 0 ≤ (2 : ℝ) ^ 10 / |p| :=
    div_nonneg (by positivity) hp0.le
  by_cases hy : |y| ≤ |p| / 2
  · have hK := bracketKernelAt_le_remote hs hp hscale hy
    calc
      bracketKernel y * bracketKernelAt s p y ≤
          bracketKernel y * ((2 : ℝ) ^ 10 / |p|) :=
        mul_le_mul_of_nonneg_left hK (bracketKernel_nonneg _)
      _ = ((2 : ℝ) ^ 10 / |p|) * bracketKernel y := by ring
      _ ≤ ((2 : ℝ) ^ 10 / |p|) *
          (bracketKernel y + bracketKernelAt s p y) :=
        mul_le_mul_of_nonneg_left
          (le_add_of_nonneg_right (bracketKernelAt_nonneg hs.le)) hcoeff
  · have hy' : |p| / 2 ≤ |y| := le_of_lt (lt_of_not_ge hy)
    have hB := bracketKernel_le_remote hp hy'
    calc
      bracketKernel y * bracketKernelAt s p y ≤
          ((2 : ℝ) ^ 10 / |p|) * bracketKernelAt s p y :=
        mul_le_mul_of_nonneg_right hB (bracketKernelAt_nonneg hs.le)
      _ ≤ ((2 : ℝ) ^ 10 / |p|) *
          (bracketKernel y + bracketKernelAt s p y) :=
        mul_le_mul_of_nonneg_left
          (le_add_of_nonneg_left (bracketKernel_nonneg _)) hcoeff

/-- The small-scale dichotomy integrates without any unproved Fubini
interchange: both summands have explicit mass. -/
theorem integral_bracketKernel_mul_bracketKernelAt_le_smallScale
    {s p : ℝ} (hs : 0 < s) (hp : 1 ≤ |p|)
    (hscale : s ≤ |p| / 4) :
    ∫ y : ℝ, bracketKernel y * bracketKernelAt s p y ≤
      ((2 : ℝ) ^ 10 / |p|) * ((2 / 9) + (2 / 9)) := by
  have hleft := integrable_bracketKernel_mul_bracketKernelAt hs p
  have hsum : Integrable (fun y : ℝ ↦ bracketKernel y + bracketKernelAt s p y) :=
    integrable_bracketKernel.add (integrable_bracketKernelAt hs p)
  have hright := hsum.const_mul ((2 : ℝ) ^ 10 / |p|)
  calc
    (∫ y : ℝ, bracketKernel y * bracketKernelAt s p y) ≤
        ∫ y : ℝ, ((2 : ℝ) ^ 10 / |p|) *
          (bracketKernel y + bracketKernelAt s p y) :=
      MeasureTheory.integral_mono_ae hleft hright
        (Filter.Eventually.of_forall
          (fun y ↦ bracketKernel_mul_bracketKernelAt_le_smallScale
            hs hp hscale))
    _ = ((2 : ℝ) ^ 10 / |p|) *
        ((∫ y : ℝ, bracketKernel y) + ∫ y : ℝ, bracketKernelAt s p y) := by
      rw [MeasureTheory.integral_const_mul, MeasureTheory.integral_add
        integrable_bracketKernel (integrable_bracketKernelAt hs p)]
    _ = ((2 : ℝ) ^ 10 / |p|) * ((2 / 9) + (2 / 9)) := by
      rw [integral_bracketKernel, integral_bracketKernelAt hs p]

/-- A single, scale-uniform one-dimensional polynomial envelope.  This is
the precise replacement for the annular-decomposition step in the source:
the constant is intentionally coarse, while the decay is uniform over every
positive dilation. -/
theorem integral_bracketKernel_mul_bracketKernelAt_le_uniform
    {s : ℝ} (hs : 0 < s) (p : ℝ) :
    ∫ y : ℝ, bracketKernel y * bracketKernelAt s p y ≤
      (2 : ℝ) ^ 13 / (1 + |p|) := by
  by_cases hp : 1 ≤ |p|
  · have hp0 : 0 < |p| := lt_of_lt_of_le zero_lt_one hp
    have hP : ∫ y : ℝ, bracketKernel y * bracketKernelAt s p y ≤
        (2 : ℝ) ^ 12 / |p| := by
      by_cases hscale : s ≤ |p| / 4
      · calc
          (∫ y : ℝ, bracketKernel y * bracketKernelAt s p y) ≤
              ((2 : ℝ) ^ 10 / |p|) * ((2 / 9) + (2 / 9)) :=
            integral_bracketKernel_mul_bracketKernelAt_le_smallScale
              hs hp hscale
          _ = ((2 : ℝ) ^ 10 * ((2 / 9) + (2 / 9))) / |p| := by ring
          _ ≤ (2 : ℝ) ^ 12 / |p| := by
            apply div_le_div_of_nonneg_right _ hp0.le
            norm_num
      · have hscale' : |p| / 4 ≤ s := le_of_not_ge hscale
        calc
          (∫ y : ℝ, bracketKernel y * bracketKernelAt s p y) ≤
              (4 / |p|) * (2 / 9) :=
            integral_bracketKernel_mul_bracketKernelAt_le_largeScale
              hs hp hscale'
          _ = (4 * (2 / 9)) / |p| := by ring
          _ ≤ (2 : ℝ) ^ 12 / |p| := by
            apply div_le_div_of_nonneg_right _ hp0.le
            norm_num
    calc
      (∫ y : ℝ, bracketKernel y * bracketKernelAt s p y) ≤
          (2 : ℝ) ^ 12 / |p| := hP
      _ = 4096 / |p| := by norm_num
      _ ≤ 8192 / (1 + |p|) := by
        apply (div_le_div_iff₀ hp0 (by positivity)).mpr
        nlinarith
      _ = (2 : ℝ) ^ 13 / (1 + |p|) := by norm_num
  · have hp' : |p| ≤ 1 := le_of_not_ge hp
    calc
      (∫ y : ℝ, bracketKernel y * bracketKernelAt s p y) ≤ 2 / 9 :=
        integral_bracketKernel_mul_bracketKernelAt_le_mass hs p
      _ ≤ 8192 / (1 + |p|) := by
        apply (le_div_iff₀ (by positivity)).mpr
        nlinarith [abs_nonneg p]
      _ = (2 : ℝ) ^ 13 / (1 + |p|) := by norm_num

/-! ### Product Schwartz envelopes -/

/-- The product of the three coordinate Japanese brackets is at most the
third power of the Euclidean bracket. -/
theorem prod_one_add_abs_le_one_add_norm_cube (v : E3) :
    (∏ i : Fin 3, (1 + |v i|)) ≤ (1 + ‖v‖) ^ 3 := by
  have hcoord (i : Fin 3) : |v i| ≤ ‖v‖ := by
    simpa only [Real.norm_eq_abs] using PiLp.norm_apply_le v i
  rw [Fin.prod_univ_three]
  have h0 : 1 + |v 0| ≤ 1 + ‖v‖ := by linarith [hcoord 0]
  have h1 : 1 + |v 1| ≤ 1 + ‖v‖ := by linarith [hcoord 1]
  have h2 : 1 + |v 2| ≤ 1 + ‖v‖ := by linarith [hcoord 2]
  calc
    (1 + |v 0|) * (1 + |v 1|) * (1 + |v 2|) ≤
        (1 + ‖v‖) * (1 + ‖v‖) * (1 + ‖v‖) := by gcongr
    _ = (1 + ‖v‖) ^ 3 := by ring

/-- A radial order-thirty bracket is dominated by the product of the three
literal coordinate brackets. -/
theorem radial_bracket_neg_thirty_le_prod_bracketKernel (v : E3) :
    (1 + ‖v‖) ^ (-30 : ℝ) ≤ ∏ i : Fin 3, bracketKernel (v i) := by
  have hprod := prod_one_add_abs_le_one_add_norm_cube v
  have hprodpos : 0 < ∏ i : Fin 3, (1 + |v i|) := by positivity
  rw [show (∏ i : Fin 3, bracketKernel (v i)) =
      (∏ i : Fin 3, (1 + |v i|)) ^ (-10 : ℝ) by
        simpa only [bracketKernel] using
          prod_rpow_neg_ten (fun i ↦ 1 + |v i|)
            (fun _ ↦ by positivity)]
  calc
    (1 + ‖v‖) ^ (-30 : ℝ) = ((1 + ‖v‖) ^ 3) ^ (-10 : ℝ) := by
      rw [← Real.rpow_natCast (1 + ‖v‖) 3, ← Real.rpow_mul (by positivity)]
      norm_num
    _ ≤ (∏ i : Fin 3, (1 + |v i|)) ^ (-10 : ℝ) :=
      Real.rpow_le_rpow_of_nonpos hprodpos hprod (by norm_num)

/-- Squared real Schwartz data have a separable three-coordinate bracket
envelope.  Its coefficient is explicit enough for the scale-uniform
convolution calculation, but no choice of a Schwartz seminorm is exposed to
the eventual maximal-function statement. -/
theorem realSchwartz_sq_le_prod_bracketKernel
    (f : SchwartzMap E3 ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ y : E3,
      f y ^ 2 ≤ C * ∏ i : Fin 3, bracketKernel (y i) := by
  rcases realSchwartz_decay_norm f 15 with ⟨A, hA, hdecay⟩
  refine ⟨A ^ 2, pow_nonneg hA _, fun y ↦ ?_⟩
  have hB : 0 < 1 + ‖y‖ := by positivity
  have hdivnonneg : 0 ≤ A / (1 + ‖y‖) ^ 15 :=
    div_nonneg hA (pow_nonneg hB.le _)
  have hsq : |f y| ^ 2 ≤ (A / (1 + ‖y‖) ^ 15) ^ 2 :=
    (sq_le_sq₀ (abs_nonneg _) hdivnonneg).mpr (hdecay y)
  have hradial : f y ^ 2 ≤ A ^ 2 * (1 + ‖y‖) ^ (-30 : ℝ) := by
    calc
      f y ^ 2 = |f y| ^ 2 := by rw [← sq_abs]
      _ ≤ (A / (1 + ‖y‖) ^ 15) ^ 2 := hsq
      _ = A ^ 2 * (1 + ‖y‖) ^ (-30 : ℝ) := by
        rw [div_pow]
        rw [show (1 + ‖y‖) ^ (-30 : ℝ) =
            ((1 + ‖y‖) ^ 30)⁻¹ by
              rw [Real.rpow_neg hB.le]
              congr 1
              exact Real.rpow_natCast _ _]
        field_simp
  calc
    f y ^ 2 ≤ A ^ 2 * (1 + ‖y‖) ^ (-30 : ℝ) := hradial
    _ ≤ A ^ 2 * ∏ i : Fin 3, bracketKernel (y i) :=
      mul_le_mul_of_nonneg_left
        (radial_bracket_neg_thirty_le_prod_bracketKernel y)
        (pow_nonneg hA _)

/-- The same separable bracket envelope also controls the fourth power of a
real Schwartz input (after enlarging its coefficient once). -/
theorem realSchwartz_rpow_four_le_prod_bracketKernel
    (f : SchwartzMap E3 ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ y : E3,
      |f y| ^ (4 : ℝ) ≤ C * ∏ i : Fin 3, bracketKernel (y i) := by
  rcases realSchwartz_sq_le_prod_bracketKernel f with ⟨C, hC, henv⟩
  refine ⟨C ^ 2, pow_nonneg hC _, fun y ↦ ?_⟩
  let P : ℝ := ∏ i : Fin 3, bracketKernel (y i)
  have hP0 : 0 ≤ P := by
    dsimp only [P]
    exact Finset.prod_nonneg fun i _ ↦ bracketKernel_nonneg _
  have hP1 : P ≤ 1 := by
    dsimp only [P]
    apply Finset.prod_le_one
    · intro i _
      exact bracketKernel_nonneg _
    · intro i _
      exact bracketKernel_le_one _
  have hCP : 0 ≤ C * P := mul_nonneg hC hP0
  have hsquare : (f y ^ 2) ^ 2 ≤ (C * P) ^ 2 := by
    have hdiff : 0 ≤ (C * P - f y ^ 2) * (C * P + f y ^ 2) :=
      mul_nonneg (sub_nonneg.mpr (henv y)) (add_nonneg hCP (sq_nonneg _))
    nlinarith
  have hP2 : P ^ 2 ≤ P := by
    have hdiff : 0 ≤ P * (1 - P) :=
      mul_nonneg hP0 (sub_nonneg.mpr hP1)
    nlinarith
  calc
    |f y| ^ (4 : ℝ) = (f y ^ 2) ^ 2 := by
      calc
        |f y| ^ (4 : ℝ) = |f y| ^ (4 : ℕ) := Real.rpow_natCast _ _
        _ = (|f y| ^ 2) ^ 2 := by ring
        _ = (f y ^ 2) ^ 2 := by rw [sq_abs]
    _ ≤ (C * P) ^ 2 := hsquare
    _ = C ^ 2 * P ^ 2 := by ring
    _ ≤ C ^ 2 * P := mul_le_mul_of_nonneg_left hP2 (sq_nonneg _)
    _ = C ^ 2 * ∏ i : Fin 3, bracketKernel (y i) := by rfl

/-- The separable bracket envelope times the literal anisotropic kernel is
integrable.  This is the exact product-measure statement needed to iterate
the one-dimensional scale-uniform estimate. -/
theorem integrable_prod_bracketKernel_mul_anisotropicBracketKernel
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3) :
    Integrable (fun y : E3 ↦
      (∏ i : Fin 3, bracketKernel (y i)) *
        anisotropicBracketKernel α t p y) := by
  rw [← (PiLp.volume_preserving_toLp (Fin 3)).integrable_comp_emb
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  change Integrable (fun x : Fin 3 → ℝ ↦
    (∏ i : Fin 3, bracketKernel (x i)) *
      ∏ i : Fin 3, bracketKernelAt (t ^ α.weight i) (p i) (x i))
  have hprod (x : Fin 3 → ℝ) :
      (∏ i : Fin 3, bracketKernel (x i)) *
        ∏ i : Fin 3, bracketKernelAt (t ^ α.weight i) (p i) (x i) =
      ∏ i : Fin 3, bracketKernel (x i) *
        bracketKernelAt (t ^ α.weight i) (p i) (x i) := by
    rw [Finset.prod_mul_distrib]
  refine Integrable.congr (Integrable.fintype_prod fun i ↦
    integrable_bracketKernel_mul_bracketKernelAt
      (pow_pos ht _) (p i)) (Filter.Eventually.of_forall fun x ↦ (hprod x).symm)

/-- Fubini factors the separable envelope against the literal anisotropic
kernel into the three one-dimensional bracket convolutions. -/
theorem integral_prod_bracketKernel_mul_anisotropicBracketKernel
    (α : Anisotropy) {t : ℝ} (_ht : 0 < t) (p : E3) :
    ∫ y : E3, (∏ i : Fin 3, bracketKernel (y i)) *
        anisotropicBracketKernel α t p y =
      ∏ i : Fin 3, ∫ x : ℝ,
        bracketKernel x * bracketKernelAt (t ^ α.weight i) (p i) x := by
  rw [← (PiLp.volume_preserving_toLp (Fin 3)).integral_comp
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  change (∫ x : Fin 3 → ℝ,
    (∏ i : Fin 3, bracketKernel (x i)) *
      ∏ i : Fin 3, bracketKernelAt (t ^ α.weight i) (p i) (x i)) = _
  have hprod (x : Fin 3 → ℝ) :
      (∏ i : Fin 3, bracketKernel (x i)) *
        ∏ i : Fin 3, bracketKernelAt (t ^ α.weight i) (p i) (x i) =
      ∏ i : Fin 3, bracketKernel (x i) *
        bracketKernelAt (t ^ α.weight i) (p i) (x i) := by
    rw [Finset.prod_mul_distrib]
  calc
    (∫ x : Fin 3 → ℝ,
      (∏ i : Fin 3, bracketKernel (x i)) *
        ∏ i : Fin 3, bracketKernelAt (t ^ α.weight i) (p i) (x i)) =
        ∫ x : Fin 3 → ℝ, ∏ i : Fin 3, bracketKernel (x i) *
          bracketKernelAt (t ^ α.weight i) (p i) (x i) :=
      integral_congr_ae (Filter.Eventually.of_forall hprod)
    _ = ∏ i : Fin 3, ∫ x : ℝ,
        bracketKernel x * bracketKernelAt (t ^ α.weight i) (p i) x :=
      integral_fintype_prod_volume_eq_prod
        (fun i (x : ℝ) ↦ bracketKernel x *
          bracketKernelAt (t ^ α.weight i) (p i) x)

/-- A separable product bracket envelope for `f²` gives a scale-uniform
three-dimensional estimate for every literal anisotropic average. -/
theorem cubeSecondMoment_le_uniform_product_envelope
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (f : SchwartzMap E3 ℝ) {C : ℝ} (hC : 0 ≤ C)
    (henv : ∀ y : E3, f y ^ 2 ≤ C * ∏ i : Fin 3, bracketKernel (y i)) :
    cubeSecondMoment α t p f ≤ C *
      ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) := by
  let R : E3 → ℝ := fun y ↦
    (∏ i : Fin 3, bracketKernel (y i)) *
      anisotropicBracketKernel α t p y
  have hR : Integrable R :=
    integrable_prod_bracketKernel_mul_anisotropicBracketKernel α ht p
  have hleft : Integrable (fun y : E3 ↦
      f y ^ 2 * anisotropicBracketKernel α t p y) := by
    refine (hR.const_mul C).mono
      ((f.continuous.pow 2).mul
        (continuous_anisotropicBracketKernel α ht p)).aestronglyMeasurable ?_
    filter_upwards [] with y
    have hK : 0 ≤ anisotropicBracketKernel α t p y :=
      anisotropicBracketKernel_nonneg α ht.le p y
    have hRnonneg : 0 ≤ R y := by
      dsimp only [R]
      exact mul_nonneg (Finset.prod_nonneg fun i _ ↦ bracketKernel_nonneg _)
        hK
    rw [Real.norm_eq_abs,
      abs_of_nonneg (mul_nonneg (sq_nonneg _) hK),
      Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hC hRnonneg)]
    calc
      f y ^ 2 * anisotropicBracketKernel α t p y ≤
          (C * ∏ i : Fin 3, bracketKernel (y i)) *
            anisotropicBracketKernel α t p y :=
        mul_le_mul_of_nonneg_right (henv y) hK
      _ = C * R y := by
        dsimp only [R]
        ring
  have hright : Integrable (fun y : E3 ↦ C * R y) := hR.const_mul C
  have hfacnonneg (i : Fin 3) : 0 ≤
      ∫ x : ℝ, bracketKernel x * bracketKernelAt
        (t ^ α.weight i) (p i) x := by
    apply integral_nonneg
    intro x
    exact mul_nonneg (bracketKernel_nonneg _)
      (bracketKernelAt_nonneg (pow_pos ht _).le)
  have hfacbound (i : Fin 3) :
      ∫ x : ℝ, bracketKernel x * bracketKernelAt
        (t ^ α.weight i) (p i) x ≤
        (2 : ℝ) ^ 13 / (1 + |p i|) :=
    integral_bracketKernel_mul_bracketKernelAt_le_uniform
      (pow_pos ht _) (p i)
  have hprod : (∏ i : Fin 3, ∫ x : ℝ,
      bracketKernel x * bracketKernelAt (t ^ α.weight i) (p i) x) ≤
      ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) := by
    apply Finset.prod_le_prod
    · intro i _
      exact hfacnonneg i
    · intro i _
      exact hfacbound i
  calc
    cubeSecondMoment α t p f = ∫ y : E3,
        f y ^ 2 * anisotropicBracketKernel α t p y := rfl
    _ ≤ ∫ y : E3, C * R y :=
      MeasureTheory.integral_mono_ae hleft hright
        (Filter.Eventually.of_forall fun y ↦ by
          have hK : 0 ≤ anisotropicBracketKernel α t p y :=
            anisotropicBracketKernel_nonneg α ht.le p y
          calc
            f y ^ 2 * anisotropicBracketKernel α t p y ≤
                (C * ∏ i : Fin 3, bracketKernel (y i)) *
                  anisotropicBracketKernel α t p y :=
              mul_le_mul_of_nonneg_right (henv y) hK
            _ = C * R y := by
              dsimp only [R]
              ring)
    _ = C * ∫ y : E3, R y := by rw [MeasureTheory.integral_const_mul]
    _ = C * ∏ i : Fin 3, ∫ x : ℝ,
        bracketKernel x * bracketKernelAt (t ^ α.weight i) (p i) x := by
      rw [integral_prod_bracketKernel_mul_anisotropicBracketKernel α ht p]
    _ ≤ C * ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) :=
      mul_le_mul_of_nonneg_left hprod hC

/-- Real Schwartz data satisfy a scale-uniform separable tail estimate for
their exponent-two anisotropic averages. -/
theorem cubeSecondMoment_le_uniform_of_realSchwartz
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (f : SchwartzMap E3 ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧
      cubeSecondMoment α t p f ≤ C *
        ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) := by
  rcases realSchwartz_sq_le_prod_bracketKernel f with ⟨C, hC, henv⟩
  exact ⟨C, hC,
    cubeSecondMoment_le_uniform_product_envelope α ht p f hC henv⟩

/-- The preceding bound chooses one coefficient uniformly over all positive
anisotropic scales, which is exactly what is needed to pass through the
literal real supremum in `anisotropicMaximalTwoPower`. -/
theorem cubeSecondMoment_uniform_of_realSchwartz
    (α : Anisotropy) (f : SchwartzMap E3 ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (t : ℝ), 0 < t → ∀ p : E3,
      cubeSecondMoment α t p f ≤ C *
        ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) := by
  rcases realSchwartz_sq_le_prod_bracketKernel f with ⟨C, hC, henv⟩
  refine ⟨C, hC, fun t ht p ↦ ?_⟩
  exact cubeSecondMoment_le_uniform_product_envelope
    α ht p f hC henv

/-- The exponent-two all-positive-scales supremum inherits the same explicit
Schwartz envelope. -/
theorem anisotropicMaximalTwoPower_le_uniform_of_realSchwartz
    (α : Anisotropy) (f : SchwartzMap E3 ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ p : E3,
      anisotropicMaximalTwoPower α f p ≤ C *
        ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) := by
  rcases cubeSecondMoment_uniform_of_realSchwartz α f with
    ⟨C, hC, hmoment⟩
  refine ⟨C, hC, fun p ↦ ?_⟩
  unfold anisotropicMaximalTwoPower
  apply csSup_le
  · exact ⟨cubeSecondMoment α 1 p f, ⟨1, by norm_num, rfl⟩⟩
  · rintro a ⟨t, ht, rfl⟩
    exact hmoment t ht p

/-- The product envelope itself is bounded by one radial reciprocal bracket,
so it vanishes along the cocompact filter. -/
theorem prod_maximalEnvelope_le_radial (p : E3) :
    (∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|))) ≤
      ((2 : ℝ) ^ 13) ^ 3 / (1 + ‖p‖) := by
  have hdenom : 1 + ‖p‖ ≤ ∏ i : Fin 3, (1 + |p i|) :=
    one_add_norm_le_prod_one_add_abs p
  have hdenompos : 0 < 1 + ‖p‖ := by positivity
  have hinv : (∏ i : Fin 3, (1 + |p i|))⁻¹ ≤ (1 + ‖p‖)⁻¹ :=
    inv_anti₀ hdenompos hdenom
  calc
    (∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|))) =
        ∏ i : Fin 3, ((2 : ℝ) ^ 13 * (1 + |p i|)⁻¹) := by
      apply Finset.prod_congr rfl
      intro i _
      ring
    _ = (∏ _i : Fin 3, (2 : ℝ) ^ 13) *
        ∏ i : Fin 3, (1 + |p i|)⁻¹ := by
      rw [Finset.prod_mul_distrib]
    _ = ((2 : ℝ) ^ 13) ^ 3 *
        (∏ i : Fin 3, (1 + |p i|))⁻¹ := by
      rw [Finset.prod_const, Finset.prod_inv_distrib]
      norm_num
    _ ≤ ((2 : ℝ) ^ 13) ^ 3 * (1 + ‖p‖)⁻¹ :=
      mul_le_mul_of_nonneg_left hinv (by positivity)
    _ = ((2 : ℝ) ^ 13) ^ 3 / (1 + ‖p‖) := by ring

/-- Any nonnegative multiple of the explicit product envelope vanishes at
spatial infinity. -/
theorem tendsto_uniform_maximalEnvelope
    (C : ℝ) (hC : 0 ≤ C) :
    Tendsto (fun p : E3 ↦ C *
      ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)))
      (cocompact E3) (𝓝 0) := by
  have hnorm : Tendsto (fun p : E3 ↦ ‖p‖) (cocompact E3) atTop :=
    tendsto_norm_cocompact_atTop
  have hbase : Tendsto (fun p : E3 ↦ 1 + ‖p‖)
      (cocompact E3) atTop :=
    tendsto_atTop_add_const_left _ 1 hnorm
  have hinv : Tendsto (fun p : E3 ↦ (1 + ‖p‖)⁻¹)
      (cocompact E3) (𝓝 0) :=
    tendsto_inv_atTop_zero.comp hbase
  have hradial : Tendsto (fun p : E3 ↦ C *
      (((2 : ℝ) ^ 13) ^ 3 / (1 + ‖p‖)))
      (cocompact E3) (𝓝 0) := by
    have hconst : Tendsto (fun p : E3 ↦ C * ((2 : ℝ) ^ 13) ^ 3)
        (cocompact E3) (𝓝 (C * ((2 : ℝ) ^ 13) ^ 3)) := tendsto_const_nhds
    simpa [div_eq_mul_inv, mul_assoc] using hconst.mul hinv
  apply squeeze_zero
  · intro p
    exact mul_nonneg hC (Finset.prod_nonneg fun i _ ↦ by positivity)
  · intro p
    exact mul_le_mul_of_nonneg_left
      (prod_maximalEnvelope_le_radial p) hC
  · exact hradial

/-- The full literal exponent-two anisotropic maximal function of a real
Schwartz input tends to zero at spatial infinity.  This closes the tail
branch of the source stopping-time finiteness interface without invoking an
external maximal theorem. -/
theorem tendsto_anisotropicMaximalTwo_of_realSchwartz
    (α : Anisotropy) (f : SchwartzMap E3 ℝ) :
    Tendsto (anisotropicMaximalTwo α f) (cocompact E3) (𝓝 0) := by
  rcases anisotropicMaximalTwoPower_le_uniform_of_realSchwartz α f
    with ⟨C, hC, hbound⟩
  have henv : Tendsto (fun p : E3 ↦ C *
      ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)))
      (cocompact E3) (𝓝 0) :=
    tendsto_uniform_maximalEnvelope C hC
  have hsqrtenv : Tendsto (fun p : E3 ↦
      √(C * ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|))) )
      (cocompact E3) (𝓝 0) := by
    convert (Real.continuous_sqrt.tendsto 0).comp henv using 1
    · ext p
      rfl
    · simp only [Real.sqrt_zero]
  change Tendsto (fun p : E3 ↦ √(anisotropicMaximalTwoPower α f p))
    (cocompact E3) (𝓝 0)
  apply squeeze_zero
  · intro p
    exact Real.sqrt_nonneg _
  · intro p
    exact Real.sqrt_le_sqrt (hbound p)
  · exact hsqrtenv

/-- The same product-envelope/Fubini calculation applies to the literal
fourth moments. -/
theorem fourthMoment_le_uniform_product_envelope
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (f : SchwartzMap E3 ℝ) {C : ℝ} (hC : 0 ≤ C)
    (henv : ∀ y : E3, |f y| ^ (4 : ℝ) ≤ C *
      ∏ i : Fin 3, bracketKernel (y i)) :
    fourthMoment α t p f ≤ C *
      ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) := by
  let R : E3 → ℝ := fun y ↦
    (∏ i : Fin 3, bracketKernel (y i)) *
      anisotropicBracketKernel α t p y
  have hR : Integrable R :=
    integrable_prod_bracketKernel_mul_anisotropicBracketKernel α ht p
  have hleft : Integrable (fun y : E3 ↦
      |f y| ^ (4 : ℝ) * anisotropicBracketKernel α t p y) := by
    refine (hR.const_mul C).mono
      ((f.continuous.abs.rpow_const (fun _ ↦ Or.inr (by norm_num))).mul
        (continuous_anisotropicBracketKernel α ht p)).aestronglyMeasurable ?_
    filter_upwards [] with y
    have hK : 0 ≤ anisotropicBracketKernel α t p y :=
      anisotropicBracketKernel_nonneg α ht.le p y
    have hRnonneg : 0 ≤ R y := by
      dsimp only [R]
      exact mul_nonneg (Finset.prod_nonneg fun i _ ↦ bracketKernel_nonneg _)
        hK
    rw [Real.norm_eq_abs,
      abs_of_nonneg (mul_nonneg (Real.rpow_nonneg (abs_nonneg _) _) hK),
      Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hC hRnonneg)]
    calc
      |f y| ^ (4 : ℝ) * anisotropicBracketKernel α t p y ≤
          (C * ∏ i : Fin 3, bracketKernel (y i)) *
            anisotropicBracketKernel α t p y :=
        mul_le_mul_of_nonneg_right (henv y) hK
      _ = C * R y := by
        dsimp only [R]
        ring
  have hright : Integrable (fun y : E3 ↦ C * R y) := hR.const_mul C
  have hfacnonneg (i : Fin 3) : 0 ≤
      ∫ x : ℝ, bracketKernel x * bracketKernelAt
        (t ^ α.weight i) (p i) x := by
    apply integral_nonneg
    intro x
    exact mul_nonneg (bracketKernel_nonneg _)
      (bracketKernelAt_nonneg (pow_pos ht _).le)
  have hfacbound (i : Fin 3) :
      ∫ x : ℝ, bracketKernel x * bracketKernelAt
        (t ^ α.weight i) (p i) x ≤
        (2 : ℝ) ^ 13 / (1 + |p i|) :=
    integral_bracketKernel_mul_bracketKernelAt_le_uniform
      (pow_pos ht _) (p i)
  have hprod : (∏ i : Fin 3, ∫ x : ℝ,
      bracketKernel x * bracketKernelAt (t ^ α.weight i) (p i) x) ≤
      ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) := by
    apply Finset.prod_le_prod
    · intro i _
      exact hfacnonneg i
    · intro i _
      exact hfacbound i
  calc
    fourthMoment α t p f = ∫ y : E3,
        |f y| ^ (4 : ℝ) * anisotropicBracketKernel α t p y := rfl
    _ ≤ ∫ y : E3, C * R y :=
      MeasureTheory.integral_mono_ae hleft hright
        (Filter.Eventually.of_forall fun y ↦ by
          have hK : 0 ≤ anisotropicBracketKernel α t p y :=
            anisotropicBracketKernel_nonneg α ht.le p y
          calc
            |f y| ^ (4 : ℝ) * anisotropicBracketKernel α t p y ≤
                (C * ∏ i : Fin 3, bracketKernel (y i)) *
                  anisotropicBracketKernel α t p y :=
              mul_le_mul_of_nonneg_right (henv y) hK
            _ = C * R y := by
              dsimp only [R]
              ring)
    _ = C * ∫ y : E3, R y := by rw [MeasureTheory.integral_const_mul]
    _ = C * ∏ i : Fin 3, ∫ x : ℝ,
        bracketKernel x * bracketKernelAt (t ^ α.weight i) (p i) x := by
      rw [integral_prod_bracketKernel_mul_anisotropicBracketKernel α ht p]
    _ ≤ C * ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) :=
      mul_le_mul_of_nonneg_left hprod hC

/-- A single fourth-moment envelope coefficient works simultaneously at all
positive anisotropic scales. -/
theorem fourthMoment_uniform_of_realSchwartz
    (α : Anisotropy) (f : SchwartzMap E3 ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (t : ℝ), 0 < t → ∀ p : E3,
      fourthMoment α t p f ≤ C *
        ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) := by
  rcases realSchwartz_rpow_four_le_prod_bracketKernel f with
    ⟨C, hC, henv⟩
  refine ⟨C, hC, fun t ht p ↦ ?_⟩
  exact fourthMoment_le_uniform_product_envelope α ht p f hC henv

/-- The exponent-four all-positive-scales maximal power inherits the same
explicit product tail. -/
theorem anisotropicMaximalFourPower_le_uniform_of_realSchwartz
    (α : Anisotropy) (f : SchwartzMap E3 ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ p : E3,
      anisotropicMaximalFourPower α f p ≤ C *
        ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) := by
  rcases fourthMoment_uniform_of_realSchwartz α f with
    ⟨C, hC, hmoment⟩
  refine ⟨C, hC, fun p ↦ ?_⟩
  unfold anisotropicMaximalFourPower
  apply csSup_le
  · exact ⟨fourthMoment α 1 p f, ⟨1, by norm_num, rfl⟩⟩
  · rintro a ⟨t, ht, rfl⟩
    exact hmoment t ht p

/-- Taking the positive fourth root preserves the cocompact tail of the
explicit maximal envelope. -/
theorem tendsto_uniform_maximalEnvelope_rpow_four_inv
    (C : ℝ) (hC : 0 ≤ C) :
    Tendsto (fun p : E3 ↦ (C *
      ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|))) ^ ((4 : ℝ)⁻¹))
      (cocompact E3) (𝓝 0) := by
  have henv := tendsto_uniform_maximalEnvelope C hC
  have hcont := (Real.continuous_rpow_const
    (by positivity : 0 ≤ (4 : ℝ)⁻¹)).tendsto 0
  convert hcont.comp henv using 1
  · ext p
    rfl
  · rw [Real.zero_rpow (by positivity : (4 : ℝ)⁻¹ ≠ 0)]

/-- The full literal exponent-four anisotropic maximal function of a real
Schwartz input tends to zero at spatial infinity. -/
theorem tendsto_anisotropicMaximalFour_of_realSchwartz
    (α : Anisotropy) (f : SchwartzMap E3 ℝ) :
    Tendsto (anisotropicMaximalFour α f) (cocompact E3) (𝓝 0) := by
  rcases anisotropicMaximalFourPower_le_uniform_of_realSchwartz α f
    with ⟨C, hC, hbound⟩
  rcases fourthMoment_uniform_of_realSchwartz α f with
    ⟨D, hD, hmoment⟩
  have henv : Tendsto (fun p : E3 ↦ (C *
      ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|))) ^ ((4 : ℝ)⁻¹))
      (cocompact E3) (𝓝 0) :=
    tendsto_uniform_maximalEnvelope_rpow_four_inv C hC
  have hHnonneg (p : E3) : 0 ≤ C *
      ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) :=
    mul_nonneg hC (Finset.prod_nonneg fun i _ ↦ by positivity)
  have hmaxnonneg (p : E3) : 0 ≤ anisotropicMaximalFourPower α f p := by
    let H : ℝ := D * ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|))
    have hbdd : BddAbove {a : ℝ | ∃ t : ℝ, 0 < t ∧
        a = fourthMoment α t p f} := by
      refine ⟨H, ?_⟩
      rintro a ⟨t, ht, rfl⟩
      exact hmoment t ht p
    calc
      0 ≤ fourthMoment α 1 p f := fourthMoment_nonneg α (by norm_num) p f
      _ ≤ anisotropicMaximalFourPower α f p := by
        unfold anisotropicMaximalFourPower
        apply le_csSup hbdd
        exact ⟨1, by norm_num, rfl⟩
  change Tendsto (fun p : E3 ↦
      (anisotropicMaximalFourPower α f p) ^ ((4 : ℝ)⁻¹))
    (cocompact E3) (𝓝 0)
  apply squeeze_zero
  · intro p
    exact Real.rpow_nonneg (hmaxnonneg p) _
  · intro p
    exact Real.rpow_le_rpow (hmaxnonneg p) (hbound p) (by positivity)
  · exact henv

/-- All four literal stopping maximal functions of an initial real Schwartz
tuple vanish at spatial infinity. -/
theorem tendsto_sourceStoppingMaximal_of_initialModelRealSchwartz
    (α : Anisotropy) (F : InitialModelSchwartzInput) :
    ∀ j : Fin 4, Tendsto (sourceStoppingMaximal α (InitialModelRealInput F) j)
      (cocompact E3) (𝓝 0) := by
  apply tendsto_sourceStoppingMaximal_of_tails α (InitialModelRealInput F)
  · simpa only [InitialModelRealInput] using
      tendsto_anisotropicMaximalTwo_of_realSchwartz α (F 3)
  · intro j hj
    simpa only [InitialModelRealInput] using
      tendsto_anisotropicMaximalFour_of_realSchwartz α (F j)

/-- Consequently, every source stopping level of an initial real Schwartz
tuple has finite Lebesgue measure.  This is the direct tail-based discharge
of the formerly external maximal-function hypothesis. -/
theorem sourceStopping_coordinateLevel_finite_of_initialModelRealSchwartz
    (α : Anisotropy) (F : InitialModelSchwartzInput) :
    ∀ (j : Fin 4) (m : ℤ),
      volume (sourceStoppingMaximalLevelSetAt α
        (InitialModelRealInput F) j m) ≠ ∞ := by
  apply sourceStopping_coordinateLevel_finite_of_maximal_tails
    α (InitialModelRealInput F)
  · simpa only [InitialModelRealInput] using
      tendsto_anisotropicMaximalTwo_of_realSchwartz α (F 3)
  · intro j hj
    simpa only [InitialModelRealInput] using
      tendsto_anisotropicMaximalFour_of_realSchwartz α (F j)

/-! ### Mean-zero profile-kernel cancellation -/

/-- A real Schwartz function has a global Lipschitz bound supplied by its
first derivative seminorm. -/
theorem schwartz_real_global_lipschitz (f : SchwartzMap E3 ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x y : E3,
      ‖f y - f x‖ ≤ C * ‖y - x‖ := by
  refine ⟨SchwartzMap.seminorm ℝ 0 1 f, ?_, ?_⟩
  · exact le_trans (norm_nonneg (fderiv ℝ f (0 : E3)))
      (by simpa only [norm_iteratedFDeriv_one] using
        SchwartzMap.norm_iteratedFDeriv_le_seminorm ℝ f 1 (0 : E3))
  · intro x y
    apply Convex.norm_image_sub_le_of_norm_fderiv_le (𝕜 := ℝ)
    · intro z _
      exact f.differentiableAt
    · intro z _
      simpa only [norm_iteratedFDeriv_one] using
        SchwartzMap.norm_iteratedFDeriv_le_seminorm ℝ f 1 z
    · exact convex_univ
    · exact Set.mem_univ _
    · exact Set.mem_univ _

/-- The first absolute moment of a normalized positive dilation has the
expected linear scaling. -/
theorem integral_abs_mul_kernelDilate (k : ℝ → ℝ) {s : ℝ}
    (hs : 0 < s) :
    ∫ x : ℝ, |x| * |kernelDilate k s x| =
      s * ∫ z : ℝ, |z| * |k z| := by
  unfold kernelDilate
  have hinv : 0 ≤ s⁻¹ := (inv_pos.mpr hs).le
  have hpoint (x : ℝ) :
      |x| * |s⁻¹ • k (x / s)| =
        s⁻¹ * (s * (|x / s| * |k (x / s)|)) := by
    simp only [smul_eq_mul, abs_mul, abs_of_nonneg hinv]
    rw [abs_div, abs_of_pos hs]
    field_simp [hs.ne']
  calc
    (∫ x : ℝ, |x| * |s⁻¹ • k (x / s)|) =
        ∫ x : ℝ, s⁻¹ * (s * (|x / s| * |k (x / s)|)) := by
          apply integral_congr_ae
          filter_upwards [] with x
          exact hpoint x
    _ = s⁻¹ * (s * ∫ x : ℝ, |x / s| * |k (x / s)|) := by
          rw [integral_const_mul, integral_const_mul]
    _ = s⁻¹ * (s * (s * ∫ z : ℝ, |z| * |k z|)) := by
          have hchange : (∫ x : ℝ, |x / s| * |k (x / s)|) =
              s * ∫ z : ℝ, |z| * |k z| := by
            change (∫ x : ℝ, (fun z : ℝ ↦ |z| * |k z|) (x / s)) = _
            rw [Measure.integral_comp_div (fun z : ℝ ↦ |z| * |k z|) s]
            simp only [smul_eq_mul, abs_of_pos hs]
          rw [hchange]
    _ = s * ∫ z : ℝ, |z| * |k z| := by field_simp

/-- The Euclidean norm of a scalar coordinate displacement is its absolute
scalar size. -/
theorem norm_smul_coordinateDirection (i : Fin 3) (r : ℝ) :
    ‖r • Anisotropy.coordinateDirection i‖ = |r| := by
  rw [norm_smul]
  simp [Anisotropy.coordinateDirection]

/-- Normalized positive dilation preserves the signed integral. -/
theorem integral_kernelDilate (k : ℝ → ℝ) {s : ℝ} (hs : 0 < s) :
    ∫ x : ℝ, kernelDilate k s x = ∫ z : ℝ, k z := by
  unfold kernelDilate
  rw [integral_smul, Measure.integral_comp_div k s]
  simp [smul_eq_mul, abs_of_pos hs, hs.ne']

/-- Finite first absolute moment is preserved under every positive normalized
dilation. -/
theorem integrable_abs_mul_kernelDilate (k : ℝ → ℝ)
    (hk : Integrable (fun z : ℝ ↦ |z| * |k z|)) {s : ℝ} (hs : 0 < s) :
    Integrable (fun x : ℝ ↦ |x| * |kernelDilate k s x|) := by
  have hbase : Integrable (fun x : ℝ ↦ |x / s| * |k (x / s)|) :=
    hk.comp_div hs.ne'
  refine hbase.congr ?_
  filter_upwards [] with x
  unfold kernelDilate
  simp only [smul_eq_mul, abs_mul, abs_of_pos (inv_pos.mpr hs)]
  rw [abs_div, abs_of_pos hs]
  field_simp [hs.ne']

/-- A mean-zero coordinate kernel gains one factor of its scale against a
directionally Lipschitz input. -/
theorem abs_ModelCoordinateConvolution_le_of_mean_zero
    (i : Fin 3) (f : E3 → ℝ) (k : ℝ → ℝ) (s : ℝ) (x : E3)
    (hfcont : Continuous f) (L : ℝ)
    (hLip : ∀ r : ℝ,
      |f (x - r • Anisotropy.coordinateDirection i) - f x| ≤ L * |r|)
    (hk : Integrable k)
    (hkmoment : Integrable (fun r : ℝ ↦ |r| * |k r|))
    (hzero : ∫ r : ℝ, k r = 0) (hs : 0 < s) :
    |ModelCoordinateConvolution i f k s x| ≤
      L * s * ∫ r : ℝ, |r| * |k r| := by
  let kd : ℝ → ℝ := fun r ↦ kernelDilate k s r
  let B : ℝ → ℝ := fun r ↦
    (f (x - r • Anisotropy.coordinateDirection i) - f x) * kd r
  have hkd : Integrable kd := by
    dsimp only [kd]
    exact integrable_kernelDilate hk hs.ne'
  have hmomentd : Integrable (fun r : ℝ ↦ |r| * |kd r|) := by
    dsimp only [kd]
    exact integrable_abs_mul_kernelDilate k hkmoment hs
  have hmap : Continuous (fun r : ℝ ↦
      x - r • Anisotropy.coordinateDirection i) :=
    continuous_const.sub (continuous_id.smul continuous_const)
  have hBmeas : AEStronglyMeasurable B volume := by
    dsimp only [B]
    exact (((hfcont.comp hmap).sub continuous_const).aestronglyMeasurable).mul
      hkd.aestronglyMeasurable
  have hB : Integrable B := by
    apply (hmomentd.const_mul L).mono' hBmeas
    filter_upwards [] with r
    dsimp only [B]
    rw [Real.norm_eq_abs, abs_mul]
    simpa [mul_assoc] using
      (mul_le_mul_of_nonneg_right (hLip r) (abs_nonneg (kd r)))
  have hsplit : (fun r : ℝ ↦
      f (x - r • Anisotropy.coordinateDirection i) * kd r) =
      fun r ↦ B r + f x * kd r := by
    funext r
    dsimp only [B]
    ring
  have hconst : Integrable (fun r : ℝ ↦ f x * kd r) := hkd.const_mul (f x)
  have hzero_d : (∫ r : ℝ, kd r) = 0 := by
    dsimp only [kd]
    rw [integral_kernelDilate k hs, hzero]
  have hrewrite : (∫ r : ℝ,
      f (x - r • Anisotropy.coordinateDirection i) * kd r) = ∫ r : ℝ, B r := by
    rw [hsplit, integral_add hB hconst, integral_const_mul, hzero_d]
    ring
  unfold ModelCoordinateConvolution
  change |∫ r : ℝ,
      f (x - r • Anisotropy.coordinateDirection i) * kd r| ≤ _
  rw [hrewrite]
  calc
    |∫ r : ℝ, B r| ≤ ∫ r : ℝ, |B r| :=
      MeasureTheory.abs_integral_le_integral_abs
    _ ≤ ∫ r : ℝ, L * (|r| * |kd r|) := by
      apply integral_mono hB.norm (hmomentd.const_mul L)
      intro r
      dsimp only [B]
      rw [Real.norm_eq_abs, abs_mul]
      simpa [mul_assoc] using
        (mul_le_mul_of_nonneg_right (hLip r) (abs_nonneg (kd r)))
    _ = L * (s * ∫ r : ℝ, |r| * |k r|) := by
      rw [integral_const_mul, integral_abs_mul_kernelDilate k hs]
    _ = L * s * ∫ r : ℝ, |r| * |k r| := by ring

/-- The preceding cancellation estimate applies directly to a real Schwartz
input, with its global first-derivative seminorm furnishing the Lipschitz
constant. -/
theorem abs_ModelCoordinateConvolution_schwartz_le_of_mean_zero
    (i : Fin 3) (f : SchwartzMap E3 ℝ) (k : ℝ → ℝ) (s : ℝ) (x : E3)
    (hk : Integrable k)
    (hkmoment : Integrable (fun r : ℝ ↦ |r| * |k r|))
    (hzero : ∫ r : ℝ, k r = 0) (hs : 0 < s) :
    ∃ L : ℝ, 0 ≤ L ∧
      |ModelCoordinateConvolution i f k s x| ≤
        L * s * ∫ r : ℝ, |r| * |k r| := by
  rcases schwartz_real_global_lipschitz f with ⟨L, hL, hLip⟩
  refine ⟨L, hL, ?_⟩
  apply abs_ModelCoordinateConvolution_le_of_mean_zero
    i f k s x f.continuous L ?_ hk hkmoment hzero hs
  intro r
  have h := hLip x (x - r • Anisotropy.coordinateDirection i)
  have hv : x - r • Anisotropy.coordinateDirection i - x =
      -(r • Anisotropy.coordinateDirection i) := by abel
  rw [Real.norm_eq_abs, hv, norm_neg,
    norm_smul_coordinateDirection] at h
  exact h

/-- The Gaussian derivative has finite first absolute moment. -/
theorem integrable_abs_mul_gaussianDeriv :
    Integrable (fun x : ℝ ↦ |x| * |gaussianDeriv x|) := by
  have hbase : Integrable (fun x : ℝ ↦ x ^ (2 : ℝ) *
      Real.exp (-Real.pi * x ^ 2)) :=
    integrable_rpow_mul_exp_neg_mul_sq Real.pi_pos (by norm_num)
  have hscaled := hbase.const_mul (2 * Real.pi)
  apply hscaled.congr
  filter_upwards [] with x
  rw [Real.rpow_two]
  simp only [gaussianDeriv, gaussian, abs_mul, abs_of_pos Real.pi_pos,
    abs_of_nonneg (Real.exp_pos _).le]
  norm_num
  have hsq : |x| * |x| = x ^ 2 := by
    rw [← pow_two, sq_abs]
  calc
    2 * Real.pi * (x ^ 2 * Real.exp (-(Real.pi * x ^ 2))) =
        (|x| * |x|) * (2 * Real.pi * Real.exp (-(Real.pi * x ^ 2))) := by
          rw [hsq]
          ring
    _ = |x| * (2 * Real.pi * |x| * Real.exp (-(Real.pi * x ^ 2))) := by
          ring

/-- The fixed annular physical cutoff has finite first absolute moment. -/
theorem integrable_abs_mul_conePsiPhysicalReal :
    Integrable (fun x : ℝ ↦ |x| * |conePsiPhysicalReal x|) := by
  simpa only [Real.norm_eq_abs, pow_one] using
    (conePsiPhysicalReal.integrable_pow_mul volume 1)

/-- A bounded kernel has a scale-decaying coordinate convolution bound once
the input has finite absolute mass on that coordinate line. -/
theorem abs_ModelCoordinateConvolution_le_of_bounded_kernel_line_mass
    (i : Fin 3) (f : E3 → ℝ) (k : ℝ → ℝ) (s : ℝ) (x : E3)
    (hk : Integrable k) (A : ℝ)
    (hkbound : ∀ r : ℝ, |k r| ≤ A)
    (hline : Integrable (fun r : ℝ ↦
      f (x - r • Anisotropy.coordinateDirection i)))
    (hs : 0 < s) :
    |ModelCoordinateConvolution i f k s x| ≤
      s⁻¹ * A * ∫ r : ℝ, |f (x - r • Anisotropy.coordinateDirection i)| := by
  let h : ℝ → ℝ := fun r ↦ f (x - r • Anisotropy.coordinateDirection i)
  let kd : ℝ → ℝ := fun r ↦ kernelDilate k s r
  have hkd : Integrable kd := by
    dsimp only [kd]
    exact integrable_kernelDilate hk hs.ne'
  have hupper : Integrable (fun r : ℝ ↦ s⁻¹ * A * |h r|) :=
    hline.norm.const_mul (s⁻¹ * A)
  have hGmeas : AEStronglyMeasurable (fun r : ℝ ↦ h r * kd r) volume :=
    hline.aestronglyMeasurable.mul hkd.aestronglyMeasurable
  have hG : Integrable (fun r : ℝ ↦ h r * kd r) := by
    apply hupper.mono' hGmeas
    filter_upwards [] with r
    dsimp only [kd]
    rw [Real.norm_eq_abs, abs_mul, kernelDilate, smul_eq_mul, abs_mul,
      abs_of_pos (inv_pos.mpr hs)]
    calc
      |h r| * (s⁻¹ * |k (r / s)|) ≤ |h r| * (s⁻¹ * A) :=
        mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_left (hkbound (r / s)) (inv_pos.mpr hs).le)
          (abs_nonneg _)
      _ = s⁻¹ * A * |h r| := by ring
  unfold ModelCoordinateConvolution
  change |∫ r : ℝ, h r * kd r| ≤ _
  calc
    |∫ r : ℝ, h r * kd r| ≤ ∫ r : ℝ, |h r * kd r| :=
      MeasureTheory.abs_integral_le_integral_abs
    _ ≤ ∫ r : ℝ, s⁻¹ * A * |h r| := by
      apply integral_mono hG.norm hupper
      intro r
      dsimp only [kd]
      rw [Real.norm_eq_abs, abs_mul, kernelDilate, smul_eq_mul, abs_mul,
        abs_of_pos (inv_pos.mpr hs)]
      calc
        |h r| * (s⁻¹ * |k (r / s)|) ≤ |h r| * (s⁻¹ * A) :=
          mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_left (hkbound (r / s)) (inv_pos.mpr hs).le)
            (abs_nonneg _)
        _ = s⁻¹ * A * |h r| := by ring
    _ = s⁻¹ * A * ∫ r : ℝ, |h r| := by
      rw [integral_const_mul]

/-! ### Fixed-scale center localization -/

/-- The measure-preserving shear from a base point and a coordinatewise
difference to the corresponding pair of base and sampled points. -/
noncomputable def modelDifferenceCoordinates : E3 × E3 ≃ᵐ E3 × E3 where
  toEquiv :=
    { toFun := fun z ↦ (z.1, z.1 - z.2)
      invFun := fun z ↦ (z.1, z.1 - z.2)
      left_inv := by
        rintro ⟨x, r⟩
        simp
      right_inv := by
        rintro ⟨x, y⟩
        simp }
  measurable_toFun := measurable_fst.prodMk (measurable_fst.sub measurable_snd)
  measurable_invFun := measurable_fst.prodMk (measurable_fst.sub measurable_snd)

/-- The difference-coordinate shear preserves product Lebesgue measure. -/
theorem modelDifferenceCoordinates_measurePreserving :
    MeasurePreserving modelDifferenceCoordinates
      ((volume : Measure E3).prod volume)
      ((volume : Measure E3).prod volume) := by
  have hneg : MeasurePreserving (fun z : E3 × E3 ↦ (z.1, -z.2))
      ((volume : Measure E3).prod volume)
      ((volume : Measure E3).prod volume) :=
    (MeasurePreserving.id (volume : Measure E3)).prod
      (Measure.measurePreserving_neg (volume : Measure E3))
  have hadd : MeasurePreserving (fun z : E3 × E3 ↦ (z.1, z.2 + z.1))
      ((volume : Measure E3).prod volume)
      ((volume : Measure E3).prod volume) :=
    measurePreserving_prod_add_right (volume : Measure E3) volume
  have h := hadd.comp hneg
  convert h using 1
  funext z
  change (z.1, z.1 - z.2) = (z.1, -z.2 + z.1)
  abel_nf

/-- Subtracting a scalar multiple of the first coordinate direction changes
only the first entry of a literal `modelPoint`. -/
theorem modelPoint_sub_coordinateDirection_zero
    (a b c r : ℝ) :
    modelPoint a b c - r • Anisotropy.coordinateDirection 0 =
      modelPoint (a - r) b c := by
  ext i
  fin_cases i <;> simp [modelPoint, coordinateDirection_apply]

/-- The analogous coordinate identity in the second direction. -/
theorem modelPoint_sub_coordinateDirection_one
    (a b c r : ℝ) :
    modelPoint a b c - r • Anisotropy.coordinateDirection 1 =
      modelPoint a (b - r) c := by
  ext i
  fin_cases i <;> simp [modelPoint, coordinateDirection_apply]

/-- The analogous coordinate identity in the third direction. -/
theorem modelPoint_sub_coordinateDirection_two
    (a b c r : ℝ) :
    modelPoint a b c - r • Anisotropy.coordinateDirection 2 =
      modelPoint a b (c - r) := by
  ext i
  fin_cases i <;> simp [modelPoint, coordinateDirection_apply]

/-- The first coordinate convolution at a literal point can be written in
the sampled-variable convention of the expanded local form. -/
theorem ModelCoordinateConvolution_zero_modelPoint
    (f : E3 → ℝ) (k : ℝ → ℝ) (s a b c : ℝ) :
    ModelCoordinateConvolution 0 f k s (modelPoint a b c) =
      ∫ y : ℝ, f (modelPoint y b c) * kernelDilate k s (a - y) := by
  let G : ℝ → ℝ := fun y ↦
    f (modelPoint y b c) * kernelDilate k s (a - y)
  unfold ModelCoordinateConvolution
  calc
    (∫ r : ℝ, f (modelPoint a b c -
        r • Anisotropy.coordinateDirection 0) * kernelDilate k s r) =
        ∫ r : ℝ, G (a - r) := by
          apply integral_congr_ae
          filter_upwards [] with r
          dsimp only [G]
          rw [modelPoint_sub_coordinateDirection_zero]
          congr 1
          ring_nf
    _ = ∫ y : ℝ, G y := integral_sub_left_eq_self G volume a

/-- The second coordinate convolution at a literal point in sampled-variable
coordinates. -/
theorem ModelCoordinateConvolution_one_modelPoint
    (f : E3 → ℝ) (k : ℝ → ℝ) (s a b c : ℝ) :
    ModelCoordinateConvolution 1 f k s (modelPoint a b c) =
      ∫ y : ℝ, f (modelPoint a y c) * kernelDilate k s (b - y) := by
  let G : ℝ → ℝ := fun y ↦
    f (modelPoint a y c) * kernelDilate k s (b - y)
  unfold ModelCoordinateConvolution
  calc
    (∫ r : ℝ, f (modelPoint a b c -
        r • Anisotropy.coordinateDirection 1) * kernelDilate k s r) =
        ∫ r : ℝ, G (b - r) := by
          apply integral_congr_ae
          filter_upwards [] with r
          dsimp only [G]
          rw [modelPoint_sub_coordinateDirection_one]
          congr 1
          ring_nf
    _ = ∫ y : ℝ, G y := integral_sub_left_eq_self G volume b

/-- The third coordinate convolution at a literal point in sampled-variable
coordinates. -/
theorem ModelCoordinateConvolution_two_modelPoint
    (f : E3 → ℝ) (k : ℝ → ℝ) (s a b c : ℝ) :
    ModelCoordinateConvolution 2 f k s (modelPoint a b c) =
      ∫ y : ℝ, f (modelPoint a b y) * kernelDilate k s (c - y) := by
  let G : ℝ → ℝ := fun y ↦
    f (modelPoint a b y) * kernelDilate k s (c - y)
  unfold ModelCoordinateConvolution
  calc
    (∫ r : ℝ, f (modelPoint a b c -
        r • Anisotropy.coordinateDirection 2) * kernelDilate k s r) =
        ∫ r : ℝ, G (c - r) := by
          apply integral_congr_ae
          filter_upwards [] with r
          dsimp only [G]
          rw [modelPoint_sub_coordinateDirection_two]
          congr 1
          ring_nf
    _ = ∫ y : ℝ, G y := integral_sub_left_eq_self G volume c

/-- At a literal spatial point, the unexpanded model integrand is the product
of the three sampled-variable coordinate convolutions. -/
theorem ModelSpatialIntegrand_modelPoint_expand
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput)
    (t a b c : ℝ) :
    ModelSpatialIntegrand α u F t (modelPoint a b c) =
      F 0 (modelPoint a b c) *
        (∫ y₁ : ℝ,
          F 1 (modelPoint y₁ b c) *
            kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0) (a - y₁)) *
        (∫ y₂ : ℝ,
          F 2 (modelPoint a y₂ c) *
            kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1) (b - y₂)) *
        (∫ y₃ : ℝ,
          F 3 (modelPoint a b y₃) *
            kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2) (c - y₃)) := by
  unfold ModelSpatialIntegrand
  rw [ModelCoordinateConvolution_zero_modelPoint,
    ModelCoordinateConvolution_one_modelPoint,
    ModelCoordinateConvolution_two_modelPoint]

/-- The spatial profile can consequently be written over the three literal
Euclidean coordinates. -/
theorem ModelSpatialProfile_eq_coordinateIntegral
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ) :
    ModelSpatialProfile α u F t =
      ∫ z : ℝ × (ℝ × ℝ),
        F 0 (modelPoint z.1 z.2.1 z.2.2) *
          (∫ y₁ : ℝ,
            F 1 (modelPoint y₁ z.2.1 z.2.2) *
              kernelDilate (ModelLowKernel (u 0))
                (t ^ α.weight 0) (z.1 - y₁)) *
          (∫ y₂ : ℝ,
            F 2 (modelPoint z.1 y₂ z.2.2) *
              kernelDilate (ModelLowKernel (u 1))
                (t ^ α.weight 1) (z.2.1 - y₂)) *
          (∫ y₃ : ℝ,
            F 3 (modelPoint z.1 z.2.1 y₃) *
              kernelDilate (ModelThirdKernel (u 2))
                (t ^ α.weight 2) (z.2.2 - y₃)) := by
  let G : E3 → ℝ := fun x ↦ ModelSpatialIntegrand α u F t x
  let e : E3 ≃ᵐ ℝ × (ℝ × ℝ) := e3Coordinates
  have hmp : MeasurePreserving e (volume : Measure E3)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    simpa only [e] using e3Coordinates_measurePreserving
  change (∫ x : E3, G x) = _
  calc
    (∫ x : E3, G x) = ∫ z : ℝ × (ℝ × ℝ), G (e.symm z) := by
      exact (MeasurePreserving.symm e hmp).integral_comp
        e.symm.measurableEmbedding G |>.symm
    _ = _ := by
      apply integral_congr_ae
      filter_upwards [] with z
      have hcoords : e.symm z = modelPoint z.1 z.2.1 z.2.2 := by
        apply e.injective
        rw [e.apply_symm_apply]
        simp only [e, e3Coordinates_apply, modelPoint_zero,
          modelPoint_one, modelPoint_two]
      have hpoint := ModelSpatialIntegrand_modelPoint_expand
        α u F t z.1 z.2.1 z.2.2
      dsimp only [G]
      rw [hcoords]
      exact hpoint

/-- A product of three one-dimensional factors integrates over `E3` as the
product of its coordinate integrals. -/
theorem integral_E3_coordinate_product
    (A₀ A₁ A₂ : ℝ → ℝ) :
    (∫ y : E3, A₀ (y 0) * A₁ (y 1) * A₂ (y 2)) =
      (∫ r : ℝ, A₀ r) * (∫ r : ℝ, A₁ r) * ∫ r : ℝ, A₂ r := by
  let e : E3 ≃ᵐ ℝ × (ℝ × ℝ) := e3Coordinates
  have hmp : MeasurePreserving e (volume : Measure E3)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    simpa only [e] using e3Coordinates_measurePreserving
  calc
    (∫ y : E3, A₀ (y 0) * A₁ (y 1) * A₂ (y 2)) =
        ∫ z : ℝ × (ℝ × ℝ),
          A₀ ((e.symm z) 0) * A₁ ((e.symm z) 1) * A₂ ((e.symm z) 2) := by
          exact (MeasurePreserving.symm e hmp).integral_comp
            e.symm.measurableEmbedding _ |>.symm
    _ = ∫ z : ℝ × (ℝ × ℝ),
          A₀ z.1 * A₁ z.2.1 * A₂ z.2.2 := by
          apply integral_congr_ae
          filter_upwards [] with z
          have heq := e.apply_symm_apply z
          have h0 : (e.symm z) 0 = z.1 := by
            simpa only [e, e3Coordinates_apply] using congrArg Prod.fst heq
          have h1 : (e.symm z) 1 = z.2.1 := by
            simpa only [e, e3Coordinates_apply] using
              congrArg (fun q : ℝ × (ℝ × ℝ) ↦ q.2.1) heq
          have h2 : (e.symm z) 2 = z.2.2 := by
            simpa only [e, e3Coordinates_apply] using
              congrArg (fun q : ℝ × (ℝ × ℝ) ↦ q.2.2) heq
          rw [h0, h1, h2]
    _ = (∫ r : ℝ, A₀ r) * (∫ r : ℝ, A₁ r) * ∫ r : ℝ, A₂ r := by
          rw [Measure.volume_eq_prod]
          calc
            (∫ z : ℝ × (ℝ × ℝ), A₀ z.1 * A₁ z.2.1 * A₂ z.2.2
              ∂((volume : Measure ℝ).prod volume)) =
                (∫ r : ℝ, A₀ r) *
                  ∫ q : ℝ × ℝ, A₁ q.1 * A₂ q.2 := by
                    rw [show (fun z : ℝ × (ℝ × ℝ) ↦
                      A₀ z.1 * A₁ z.2.1 * A₂ z.2.2) =
                        fun z ↦ A₀ z.1 * (A₁ z.2.1 * A₂ z.2.2) by
                          funext z
                          ring]
                    exact MeasureTheory.integral_prod_mul A₀
                      (fun q : ℝ × ℝ ↦ A₁ q.1 * A₂ q.2)
            _ = (∫ r : ℝ, A₀ r) * (∫ r : ℝ, A₁ r) * ∫ r : ℝ, A₂ r := by
                    rw [Measure.volume_eq_prod]
                    rw [MeasureTheory.integral_prod_mul]
                    ring

/-- The corresponding product of three independent coordinate factors is
integrable on `E3` whenever its one-dimensional factors are integrable. -/
theorem integrable_E3_coordinate_product
    (A₀ A₁ A₂ : ℝ → ℝ)
    (hA₀ : Integrable A₀) (hA₁ : Integrable A₁) (hA₂ : Integrable A₂) :
    Integrable (fun y : E3 ↦ A₀ (y 0) * A₁ (y 1) * A₂ (y 2)) := by
  let e : E3 ≃ᵐ ℝ × (ℝ × ℝ) := e3Coordinates
  have hmp : MeasurePreserving e (volume : Measure E3)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    simpa only [e] using e3Coordinates_measurePreserving
  have hprod : Integrable (fun z : ℝ × (ℝ × ℝ) ↦
      A₀ z.1 * (A₁ z.2.1 * A₂ z.2.2))
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    exact hA₀.mul_prod (hA₁.mul_prod hA₂)
  have htrans : Integrable (fun y : E3 ↦
      A₀ ((e y).1) * (A₁ ((e y).2.1) * A₂ ((e y).2.2))) := by
    exact hmp.integrable_comp_of_integrable hprod
  apply htrans.congr
  filter_upwards [] with y
  simp only [e, e3Coordinates_apply]
  ring

/-- The three sampled coordinate kernels can be recombined into one literal
`E3` integral at a fixed spatial point. -/
theorem ModelSpatialIntegrand_modelPoint_eq_kernelIntegral
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput)
    (t a b c : ℝ) :
    ModelSpatialIntegrand α u F t (modelPoint a b c) =
      F 0 (modelPoint a b c) *
        ∫ y : E3,
          (F 1 (modelPoint (y 0) b c) *
              kernelDilate (ModelLowKernel (u 0))
                (t ^ α.weight 0) (a - y 0)) *
            (F 2 (modelPoint a (y 1) c) *
              kernelDilate (ModelLowKernel (u 1))
                (t ^ α.weight 1) (b - y 1)) *
            (F 3 (modelPoint a b (y 2)) *
              kernelDilate (ModelThirdKernel (u 2))
                (t ^ α.weight 2) (c - y 2)) := by
  let A₀ : ℝ → ℝ := fun y ↦
    F 1 (modelPoint y b c) *
      kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0) (a - y)
  let A₁ : ℝ → ℝ := fun y ↦
    F 2 (modelPoint a y c) *
      kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1) (b - y)
  let A₂ : ℝ → ℝ := fun y ↦
    F 3 (modelPoint a b y) *
      kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2) (c - y)
  have hproduct := integral_E3_coordinate_product A₀ A₁ A₂
  rw [ModelSpatialIntegrand_modelPoint_expand]
  change F 0 (modelPoint a b c) * (∫ y : ℝ, A₀ y) *
      (∫ y : ℝ, A₁ y) * (∫ y : ℝ, A₂ y) = _
  calc
    F 0 (modelPoint a b c) * (∫ y : ℝ, A₀ y) *
        (∫ y : ℝ, A₁ y) * (∫ y : ℝ, A₂ y) =
        F 0 (modelPoint a b c) *
          ((∫ y : ℝ, A₀ y) * (∫ y : ℝ, A₁ y) * ∫ y : ℝ, A₂ y) := by
            ring
    _ = F 0 (modelPoint a b c) *
        (∫ y : E3, A₀ (y 0) * A₁ (y 1) * A₂ (y 2)) := by
          rw [← hproduct]
    _ = _ := by
          rfl

/-- Every ambient point is the literal `modelPoint` assembled from its three
coordinates. -/
theorem modelPoint_components (x : E3) :
    modelPoint (x 0) (x 1) (x 2) = x := by
  ext i
  fin_cases i <;> simp

/-- The coordinate-product expansion of the spatial model integrand, stated
without choosing coordinates for the outer point. -/
theorem ModelSpatialIntegrand_eq_kernelIntegral
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput)
    (t : ℝ) (x : E3) :
    ModelSpatialIntegrand α u F t x =
      F 0 x *
        ∫ y : E3,
          (F 1 (modelPoint (y 0) (x 1) (x 2)) *
              kernelDilate (ModelLowKernel (u 0))
                (t ^ α.weight 0) (x 0 - y 0)) *
            (F 2 (modelPoint (x 0) (y 1) (x 2)) *
              kernelDilate (ModelLowKernel (u 1))
                (t ^ α.weight 1) (x 1 - y 1)) *
            (F 3 (modelPoint (x 0) (x 1) (y 2)) *
              kernelDilate (ModelThirdKernel (u 2))
                (t ^ α.weight 2) (x 2 - y 2)) := by
  have h := ModelSpatialIntegrand_modelPoint_eq_kernelIntegral
    α u F t (x 0) (x 1) (x 2)
  rw [modelPoint_components x] at h
  exact h

/-- The fixed-scale spatial profile after opening all three coordinate
convolutions. -/
theorem ModelSpatialProfile_eq_expandedKernelIntegral
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ) :
    ModelSpatialProfile α u F t =
      ∫ x : E3,
        F 0 x *
          (∫ y : E3,
            (F 1 (modelPoint (y 0) (x 1) (x 2)) *
                kernelDilate (ModelLowKernel (u 0))
                  (t ^ α.weight 0) (x 0 - y 0)) *
              (F 2 (modelPoint (x 0) (y 1) (x 2)) *
                kernelDilate (ModelLowKernel (u 1))
                  (t ^ α.weight 1) (x 1 - y 1)) *
              (F 3 (modelPoint (x 0) (x 1) (y 2)) *
                kernelDilate (ModelThirdKernel (u 2))
                  (t ^ α.weight 2) (x 2 - y 2))) := by
  unfold ModelSpatialProfile
  apply integral_congr_ae
  filter_upwards [] with x
  exact ModelSpatialIntegrand_eq_kernelIntegral α u F t x

/-- The literal center-expanded integrand at one positive model scale.  The
outer pair contains the base point and the three sampled coordinates; the
last factor is the three-dimensional center. -/
noncomputable def ModelCenterExpandedIntegrand
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (q : (E3 × E3) × E3) : ℝ :=
  let x : E3 := q.1.1
  let y : E3 := q.1.2
  let p : E3 := q.2
  (F 0 x * F 1 (modelPoint (y 0) (x 1) (x 2)) *
      F 2 (modelPoint (x 0) (y 1) (x 2)) *
      F 3 (modelPoint (x 0) (x 1) (y 2))) *
    ((modelPhiAt (t ^ α.weight 0)
          (p 0 + t ^ α.weight 0 * u 0) (x 0) *
        gaussianAt (t ^ α.weight 0) (p 0) (y 0)) *
      (modelPhiAt (t ^ α.weight 1)
          (p 1 + t ^ α.weight 1 * u 1) (x 1) *
        gaussianAt (t ^ α.weight 1) (p 1) (y 1)) *
      (gaussianDerivAt (t ^ α.weight 2) (p 2) (x 2) *
        modelThirdKernel (u 2) (t ^ α.weight 2) (p 2) (y 2)))

/-- The post-center kernel integrand which remains after the signed third
pair has been evaluated. -/
noncomputable def ModelExpandedKernelIntegrand
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (q : E3 × E3) : ℝ :=
  let x : E3 := q.1
  let y : E3 := q.2
  (F 0 x * F 1 (modelPoint (y 0) (x 1) (x 2)) *
      F 2 (modelPoint (x 0) (y 1) (x 2)) *
      F 3 (modelPoint (x 0) (x 1) (y 2))) *
    (kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0) (x 0 - y 0) *
      kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1) (x 1 - y 1) *
      kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2) (x 2 - y 2))

/-- The product of the absolute physical kernels is integrable in the three
coordinatewise differences at every positive model scale. -/
theorem integrable_ModelKernelAbsProduct
    (α : Anisotropy) (u : E3) (t : ℝ) (ht : 0 < t) :
    Integrable (fun r : E3 ↦
      |kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0) (r 0)| *
        |kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1) (r 1)| *
        |kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2) (r 2)|) := by
  have hs₀ : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs₁ : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs₂ : 0 < t ^ α.weight 2 := pow_pos ht _
  have hK₀ : Integrable (fun r : ℝ ↦
      |kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0) r|) := by
    simpa only [Real.norm_eq_abs] using
      (integrable_ModelLowKernel_dilate (u 0) (t ^ α.weight 0) hs₀).norm
  have hK₁ : Integrable (fun r : ℝ ↦
      |kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1) r|) := by
    simpa only [Real.norm_eq_abs] using
      (integrable_ModelLowKernel_dilate (u 1) (t ^ α.weight 1) hs₁).norm
  have hK₂ : Integrable (fun r : ℝ ↦
      |kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2) r|) := by
    simpa only [Real.norm_eq_abs] using
      (integrable_ModelThirdKernel_dilate (u 2) (t ^ α.weight 2) hs₂).norm
  exact integrable_E3_coordinate_product _ _ _ hK₀ hK₁ hK₂

/-- Uniform bounds on the three convolved inputs, together with the
integrability of the base Schwartz input, make the post-center fixed-scale
kernel integrable. -/
theorem integrable_ModelExpandedKernelIntegrand_of_bounds
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (ht : 0 < t) (B₁ B₂ B₃ : ℝ)
    (hB₁ : 0 ≤ B₁) (hB₂ : 0 ≤ B₂) (hB₃ : 0 ≤ B₃)
    (hF₁ : ∀ x : E3, |F 1 x| ≤ B₁)
    (hF₂ : ∀ x : E3, |F 2 x| ≤ B₂)
    (hF₃ : ∀ x : E3, |F 3 x| ≤ B₃) :
    Integrable (ModelExpandedKernelIntegrand α u F t)
      ((volume : Measure E3).prod volume) := by
  let R : E3 → ℝ := fun r ↦
    |kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0) (r 0)| *
      |kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1) (r 1)| *
      |kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2) (r 2)|
  have hR : Integrable R := by
    simpa only [R] using integrable_ModelKernelAbsProduct α u t ht
  let B : ℝ := B₁ * B₂ * B₃
  have hB : 0 ≤ B := mul_nonneg (mul_nonneg hB₁ hB₂) hB₃
  let A : E3 → ℝ := fun x ↦ B * |F 0 x|
  have hA : Integrable A := by
    simpa only [A, Real.norm_eq_abs] using (F 0).integrable.norm.const_mul B
  have hAR : Integrable (fun q : E3 × E3 ↦ A q.1 * R q.2)
      ((volume : Measure E3).prod volume) := hA.mul_prod hR
  let e : E3 × E3 ≃ᵐ E3 × E3 := modelDifferenceCoordinates
  have hmp : MeasurePreserving e ((volume : Measure E3).prod volume)
      ((volume : Measure E3).prod volume) := by
    simpa only [e] using modelDifferenceCoordinates_measurePreserving
  have hmajorTransport : Integrable (fun q : E3 × E3 ↦
      A ((e.symm q).1) * R ((e.symm q).2))
      ((volume : Measure E3).prod volume) := by
    exact (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hAR
  have hmajor : Integrable (fun q : E3 × E3 ↦ A q.1 * R (q.1 - q.2))
      ((volume : Measure E3).prod volume) := by
    apply hmajorTransport.congr
    filter_upwards [] with q
    have heq : e.symm q = (q.1, q.1 - q.2) := by rfl
    rw [heq]
  have hq₁ (i : Fin 3) : Measurable (fun q : E3 × E3 ↦ q.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp
      measurable_fst
  have hq₂ (i : Fin 3) : Measurable (fun q : E3 × E3 ↦ q.2 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp
      measurable_snd
  have hinput₀ : Measurable (fun q : E3 × E3 ↦ F 0 q.1) :=
    (F 0).continuous.measurable.comp measurable_fst
  have hinput₁ : Measurable (fun q : E3 × E3 ↦
      F 1 (modelPoint (q.2 0) (q.1 1) (q.1 2))) :=
    (F 1).continuous.measurable.comp
      (measurable_modelPoint _ _ _ (hq₂ 0) (hq₁ 1) (hq₁ 2))
  have hinput₂ : Measurable (fun q : E3 × E3 ↦
      F 2 (modelPoint (q.1 0) (q.2 1) (q.1 2))) :=
    (F 2).continuous.measurable.comp
      (measurable_modelPoint _ _ _ (hq₁ 0) (hq₂ 1) (hq₁ 2))
  have hinput₃ : Measurable (fun q : E3 × E3 ↦
      F 3 (modelPoint (q.1 0) (q.1 1) (q.2 2))) :=
    (F 3).continuous.measurable.comp
      (measurable_modelPoint _ _ _ (hq₁ 0) (hq₁ 1) (hq₂ 2))
  have hkernel₀ : Measurable (fun q : E3 × E3 ↦
      kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0) (q.1 0 - q.2 0)) := by
    unfold kernelDilate
    exact (measurable_const.inv.mul
      ((measurable_ModelLowKernel (u 0)).comp
        (((hq₁ 0).sub (hq₂ 0)).div measurable_const)))
  have hkernel₁ : Measurable (fun q : E3 × E3 ↦
      kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1) (q.1 1 - q.2 1)) := by
    unfold kernelDilate
    exact (measurable_const.inv.mul
      ((measurable_ModelLowKernel (u 1)).comp
        (((hq₁ 1).sub (hq₂ 1)).div measurable_const)))
  have hkernel₂ : Measurable (fun q : E3 × E3 ↦
      kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2) (q.1 2 - q.2 2)) := by
    unfold kernelDilate
    exact (measurable_const.inv.mul
      ((measurable_ModelThirdKernel (u 2)).comp
        (((hq₁ 2).sub (hq₂ 2)).div measurable_const)))
  have hmeas : AEStronglyMeasurable
      (ModelExpandedKernelIntegrand α u F t)
      ((volume : Measure E3).prod volume) := by
    change AEStronglyMeasurable (fun q : E3 × E3 ↦
      (F 0 q.1 * F 1 (modelPoint (q.2 0) (q.1 1) (q.1 2)) *
          F 2 (modelPoint (q.1 0) (q.2 1) (q.1 2)) *
          F 3 (modelPoint (q.1 0) (q.1 1) (q.2 2))) *
        (kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0) (q.1 0 - q.2 0) *
          kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1) (q.1 1 - q.2 1) *
          kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2) (q.1 2 - q.2 2)))
      ((volume : Measure E3).prod volume)
    exact (((hinput₀.aestronglyMeasurable.mul hinput₁.aestronglyMeasurable).mul
      hinput₂.aestronglyMeasurable).mul hinput₃.aestronglyMeasurable).mul
      ((hkernel₀.aestronglyMeasurable.mul hkernel₁.aestronglyMeasurable).mul
        hkernel₂.aestronglyMeasurable)
  apply Integrable.mono' hmajor hmeas
  filter_upwards [] with q
  change ‖ModelExpandedKernelIntegrand α u F t q‖ ≤ A q.1 * R (q.1 - q.2)
  simp only [ModelExpandedKernelIntegrand, A, R, B,
    Real.norm_eq_abs, abs_mul]
  calc
    |F 0 q.1| * |F 1 (modelPoint (q.2 0) (q.1 1) (q.1 2))| *
          |F 2 (modelPoint (q.1 0) (q.2 1) (q.1 2))| *
          |F 3 (modelPoint (q.1 0) (q.1 1) (q.2 2))| *
        (|kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0)
            (q.1 0 - q.2 0)| *
          |kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1)
            (q.1 1 - q.2 1)| *
          |kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2)
            (q.1 2 - q.2 2)|) =
        (|F 1 (modelPoint (q.2 0) (q.1 1) (q.1 2))| *
            |F 2 (modelPoint (q.1 0) (q.2 1) (q.1 2))| *
            |F 3 (modelPoint (q.1 0) (q.1 1) (q.2 2))|) * |F 0 q.1| *
          (|kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0)
              (q.1 0 - q.2 0)| *
            |kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1)
              (q.1 1 - q.2 1)| *
            |kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2)
              (q.1 2 - q.2 2)|) := by ring
    _ ≤ (B₁ * B₂ * B₃) * |F 0 q.1| *
          (|kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0)
              (q.1 0 - q.2 0)| *
            |kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1)
              (q.1 1 - q.2 1)| *
            |kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2)
              (q.1 2 - q.2 2)|) := by
          gcongr
          · exact hF₁ _
          · exact hF₂ _
          · exact hF₃ _
    _ = _ := by simp

/-- For Schwartz inputs the three passive factors have global seminorm
bounds, so the post-center fixed-scale integrand is automatically absolutely
integrable. -/
theorem integrable_ModelExpandedKernelIntegrand
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (ht : 0 < t) :
    Integrable (ModelExpandedKernelIntegrand α u F t)
      ((volume : Measure E3).prod volume) := by
  let B₁ : ℝ := SchwartzMap.seminorm ℝ 0 0 (F 1)
  let B₂ : ℝ := SchwartzMap.seminorm ℝ 0 0 (F 2)
  let B₃ : ℝ := SchwartzMap.seminorm ℝ 0 0 (F 3)
  apply integrable_ModelExpandedKernelIntegrand_of_bounds
    α u F t ht B₁ B₂ B₃
  · exact le_trans (norm_nonneg ((F 1) 0))
      (SchwartzMap.norm_le_seminorm ℝ (F 1) 0)
  · exact le_trans (norm_nonneg ((F 2) 0))
      (SchwartzMap.norm_le_seminorm ℝ (F 2) 0)
  · exact le_trans (norm_nonneg ((F 3) 0))
      (SchwartzMap.norm_le_seminorm ℝ (F 3) 0)
  · intro x
    simpa only [B₁, Real.norm_eq_abs] using
      (SchwartzMap.norm_le_seminorm ℝ (F 1) x)
  · intro x
    simpa only [B₂, Real.norm_eq_abs] using
      (SchwartzMap.norm_le_seminorm ℝ (F 2) x)
  · intro x
    simpa only [B₃, Real.norm_eq_abs] using
      (SchwartzMap.norm_le_seminorm ℝ (F 3) x)

/-- At one positive scale, Fubini and the three center identities turn the
literal center-expanded integrand into the negative physical-kernel
integrand. -/
theorem integral_ModelCenterExpanded_eq_neg_kernel_of_integrable
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (ht : 0 < t)
    (hjoint : Integrable (ModelCenterExpandedIntegrand α u F t)
      (((volume : Measure E3).prod volume).prod volume)) :
    (∫ q : (E3 × E3) × E3,
      ModelCenterExpandedIntegrand α u F t q
      ∂(((volume : Measure E3).prod volume).prod volume)) =
      -(∫ q : E3 × E3,
        ModelExpandedKernelIntegrand α u F t q
        ∂((volume : Measure E3).prod volume)) := by
  let W : E3 × E3 → ℝ := fun q ↦
    F 0 q.1 * F 1 (modelPoint (q.2 0) (q.1 1) (q.1 2)) *
      F 2 (modelPoint (q.1 0) (q.2 1) (q.1 2)) *
      F 3 (modelPoint (q.1 0) (q.1 1) (q.2 2))
  have hs₀ : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs₁ : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs₂ : 0 < t ^ α.weight 2 := pow_pos ht _
  let C : (E3 × E3) × E3 → ℝ := fun q ↦
    (modelPhiAt (t ^ α.weight 0)
        (q.2 0 + t ^ α.weight 0 * u 0) (q.1.1 0) *
      gaussianAt (t ^ α.weight 0) (q.2 0) (q.1.2 0)) *
      (modelPhiAt (t ^ α.weight 1)
        (q.2 1 + t ^ α.weight 1 * u 1) (q.1.1 1) *
      gaussianAt (t ^ α.weight 1) (q.2 1) (q.1.2 1)) *
      (gaussianDerivAt (t ^ α.weight 2) (q.2 2) (q.1.1 2) *
        modelThirdKernel (u 2) (t ^ α.weight 2) (q.2 2) (q.1.2 2))
  have hcenter : Integrable (fun q : (E3 × E3) × E3 ↦ W q.1 * C q)
      (((volume : Measure E3).prod volume).prod volume) := by
    apply hjoint.congr
    filter_upwards [] with q
    simp only [ModelCenterExpandedIntegrand, W, C]
  have hmain := integral_centerTriple_weighted_of_integrable
    ((volume : Measure E3).prod volume)
    (t ^ α.weight 0) (t ^ α.weight 1) (t ^ α.weight 2)
    (u 0) (u 1) (u 2)
    W
    (fun q : E3 × E3 ↦ q.1 0)
    (fun q : E3 × E3 ↦ q.1 1)
    (fun q : E3 × E3 ↦ q.1 2)
    (fun q : E3 × E3 ↦ q.2 0)
    (fun q : E3 × E3 ↦ q.2 1)
    (fun q : E3 × E3 ↦ q.2 2)
    hs₀ hs₁ hs₂
    hcenter
  convert hmain using 1 <;>
    simp only [ModelCenterExpandedIntegrand,
      ModelExpandedKernelIntegrand, W]

/-- Opening the three coordinate convolutions recovers the spatial profile
from the post-center kernel integral. -/
theorem integral_ModelExpandedKernel_eq_ModelSpatialProfile_of_integrable
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (hkernel : Integrable (ModelExpandedKernelIntegrand α u F t)
      ((volume : Measure E3).prod volume)) :
    (∫ q : E3 × E3,
      ModelExpandedKernelIntegrand α u F t q
      ∂((volume : Measure E3).prod volume)) =
      ModelSpatialProfile α u F t := by
  calc
    (∫ q : E3 × E3,
      ModelExpandedKernelIntegrand α u F t q
      ∂((volume : Measure E3).prod volume)) =
        ∫ x : E3, ∫ y : E3,
          ModelExpandedKernelIntegrand α u F t (x, y) :=
      MeasureTheory.integral_prod _ hkernel
    _ = ∫ x : E3,
        F 0 x *
          (∫ y : E3,
            (F 1 (modelPoint (y 0) (x 1) (x 2)) *
                kernelDilate (ModelLowKernel (u 0))
                  (t ^ α.weight 0) (x 0 - y 0)) *
              (F 2 (modelPoint (x 0) (y 1) (x 2)) *
                kernelDilate (ModelLowKernel (u 1))
                  (t ^ α.weight 1) (x 1 - y 1)) *
              (F 3 (modelPoint (x 0) (x 1) (y 2)) *
                kernelDilate (ModelThirdKernel (u 2))
                  (t ^ α.weight 2) (x 2 - y 2))) := by
          apply integral_congr_ae
          filter_upwards [] with x
          rw [← integral_const_mul]
          apply integral_congr_ae
          filter_upwards [] with y
          simp only [ModelExpandedKernelIntegrand]
          ring
    _ = ModelSpatialProfile α u F t :=
      (ModelSpatialProfile_eq_expandedKernelIntegral α u F t).symm

/-- The fixed-scale localization identity under the two absolute-integrability
conditions that justify the relevant Fubini steps. -/
theorem integral_ModelCenterExpanded_eq_neg_ModelSpatialProfile_of_integrable
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (ht : 0 < t)
    (hjoint : Integrable (ModelCenterExpandedIntegrand α u F t)
      (((volume : Measure E3).prod volume).prod volume))
    (hkernel : Integrable (ModelExpandedKernelIntegrand α u F t)
      ((volume : Measure E3).prod volume)) :
    (∫ q : (E3 × E3) × E3,
      ModelCenterExpandedIntegrand α u F t q
      ∂(((volume : Measure E3).prod volume).prod volume)) =
      -ModelSpatialProfile α u F t := by
  rw [integral_ModelCenterExpanded_eq_neg_kernel_of_integrable
    α u F t ht hjoint,
    integral_ModelExpandedKernel_eq_ModelSpatialProfile_of_integrable
      α u F t hkernel]

/-- With the outer sign in the local-form convention, the fixed-scale center
expansion is exactly the spatial model profile. -/
theorem neg_integral_ModelCenterExpanded_eq_ModelSpatialProfile_of_integrable
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (ht : 0 < t)
    (hjoint : Integrable (ModelCenterExpandedIntegrand α u F t)
      (((volume : Measure E3).prod volume).prod volume))
    (hkernel : Integrable (ModelExpandedKernelIntegrand α u F t)
      ((volume : Measure E3).prod volume)) :
    -(∫ q : (E3 × E3) × E3,
      ModelCenterExpandedIntegrand α u F t q
      ∂(((volume : Measure E3).prod volume).prod volume)) =
      ModelSpatialProfile α u F t := by
  rw [integral_ModelCenterExpanded_eq_neg_ModelSpatialProfile_of_integrable
    α u F t ht hjoint hkernel]
  ring

/-- A product of an `L¹` base factor and an `L¹` difference factor is
integrable on the corresponding product Euclidean space. -/
theorem integrable_mul_difference
    (f g : E3 → ℝ) (hf : Integrable f) (hg : Integrable g) :
    Integrable (fun q : E3 × E3 ↦ f q.1 * g (q.2 - q.1))
      ((volume : Measure E3).prod volume) := by
  have hprod : Integrable (fun q : E3 × E3 ↦ f q.1 * g q.2)
      ((volume : Measure E3).prod volume) := hf.mul_prod hg
  have hmp : MeasurePreserving (fun q : E3 × E3 ↦ (q.1, q.2 - q.1))
      ((volume : Measure E3).prod volume)
      ((volume : Measure E3).prod volume) :=
    measurePreserving_prod_sub volume volume
  convert hmp.integrable_comp_of_integrable hprod using 1
  rfl

/-- A fixed normalized dilation is measurable after any measurable scalar
parameterization. -/
theorem measurable_kernelDilate
    {X : Type*} [MeasurableSpace X]
    (k : ℝ → ℝ) (hk : Measurable k) (s : ℝ) (r : X → ℝ)
    (hr : Measurable r) :
    Measurable (fun x ↦ kernelDilate k s (r x)) := by
  unfold kernelDilate
  simp only [smul_eq_mul]
  exact measurable_const.mul (hk.comp (hr.div measurable_const))

/-- Two translated `L¹` factors remain jointly integrable with an `L¹` base
factor.  This is the product-space Fubini majorant used for a fixed center
expansion. -/
theorem integrable_two_difference_factors
    (f P Q : E3 → ℝ)
    (hf : Integrable f) (hP : Integrable P) (hQ : Integrable Q) :
    Integrable (fun q : (E3 × E3) × E3 ↦
      f q.1.1 * P (q.1.1 - q.1.2) * Q (q.2 - q.1.2))
      (((volume : Measure E3).prod volume).prod volume) := by
  have hPneg : Integrable (fun r : E3 ↦ P (-r)) := hP.comp_neg
  have hbase' : Integrable (fun z : E3 × E3 ↦
      f z.1 * P (-(z.2 - z.1))) ((volume : Measure E3).prod volume) :=
    integrable_mul_difference f (fun r : E3 ↦ P (-r)) hf hPneg
  have hbase : Integrable (fun z : E3 × E3 ↦
      f z.1 * P (z.1 - z.2)) ((volume : Measure E3).prod volume) := by
    apply hbase'.congr
    filter_upwards [] with z
    congr 2
    ext i
    change -(z.2 i - z.1 i) = z.1 i - z.2 i
    ring
  have hprod : Integrable (fun z : (E3 × E3) × E3 ↦
      (f z.1.1 * P (z.1.1 - z.1.2)) * Q z.2)
      (((volume : Measure E3).prod volume).prod volume) :=
    hbase.mul_prod hQ
  let e : (E3 × E3) × E3 ≃ᵐ (E3 × E3) × E3 :=
    (MeasurableEquiv.prodAssoc.trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.shearSubRight E3))).trans
      MeasurableEquiv.prodAssoc.symm
  have hassoc : MeasurePreserving
      (MeasurableEquiv.prodAssoc : (E3 × E3) × E3 ≃ᵐ E3 × (E3 × E3))
      (((volume : Measure E3).prod volume).prod volume)
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume)) :=
    measurePreserving_prodAssoc volume volume volume
  have hshear : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.shearSubRight E3))
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume))
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume)) := by
    have hsub : MeasurePreserving (fun z : E3 × E3 ↦ (z.1, z.2 - z.1))
        ((volume : Measure E3).prod volume)
        ((volume : Measure E3).prod volume) :=
      measurePreserving_prod_sub volume volume
    have hprod := (MeasurePreserving.id (volume : Measure E3)).prod hsub
    convert hprod using 1
    rfl
  have he : MeasurePreserving e
      (((volume : Measure E3).prod volume).prod volume)
      (((volume : Measure E3).prod volume).prod volume) := by
    dsimp only [e]
    exact (hassoc.trans hshear).trans hassoc.symm
  convert he.integrable_comp_of_integrable hprod using 1
  rfl

/-- The same product-space estimate in the `(x,y,p)` order used by the
center-expanded integrand. -/
theorem integrable_two_difference_factors_center_order
    (f P Q : E3 → ℝ)
    (hf : Integrable f) (hP : Integrable P) (hQ : Integrable Q) :
    Integrable (fun q : (E3 × E3) × E3 ↦
      f q.1.1 * P (q.1.1 - q.2) * Q (q.1.2 - q.2))
      (((volume : Measure E3).prod volume).prod volume) := by
  have hbase := integrable_two_difference_factors f P Q hf hP hQ
  let e : (E3 × E3) × E3 ≃ᵐ (E3 × E3) × E3 :=
    (MeasurableEquiv.prodAssoc.trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        MeasurableEquiv.prodComm)).trans MeasurableEquiv.prodAssoc.symm
  have hassoc : MeasurePreserving
      (MeasurableEquiv.prodAssoc : (E3 × E3) × E3 ≃ᵐ E3 × (E3 × E3))
      (((volume : Measure E3).prod volume).prod volume)
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume)) :=
    measurePreserving_prodAssoc volume volume volume
  have hswap : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.prodComm : E3 × E3 ≃ᵐ E3 × E3))
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume))
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume)) := by
    have hprod := (MeasurePreserving.id (volume : Measure E3)).prod
      (MeasureTheory.Measure.measurePreserving_swap (μ := (volume : Measure E3))
        (ν := (volume : Measure E3)))
    convert hprod using 1
    rfl
  have he : MeasurePreserving e
      (((volume : Measure E3).prod volume).prod volume)
      (((volume : Measure E3).prod volume).prod volume) := by
    dsimp only [e]
    exact (hassoc.trans hswap).trans hassoc.symm
  convert he.integrable_comp_of_integrable hbase using 1
  rfl

/-- Moving a center into the output variable leaves a kernel-at expression
unchanged after taking the corresponding difference. -/
theorem kernelAt_center_shift
    (k : ℝ → ℝ) (s p c x : ℝ) :
    kernelAt k s (p + c) x = kernelAt k s c (x - p) := by
  unfold kernelAt
  congr 1
  ring

theorem modelPhiAt_center_shift
    (s p c x : ℝ) :
    modelPhiAt s (p + c) x = modelPhiAt s c (x - p) := by
  exact kernelAt_center_shift conePhiPhysicalReal s p c x

theorem gaussianAt_center_shift
    (s p y : ℝ) :
    gaussianAt s p y = gaussianAt s 0 (y - p) := by
  simpa only [gaussianAt, add_zero] using
    kernelAt_center_shift gaussian s p 0 y

theorem gaussianDerivAt_center_shift
    (s p x : ℝ) :
    gaussianDerivAt s p x = gaussianDerivAt s 0 (x - p) := by
  simpa only [gaussianDerivAt, add_zero] using
    kernelAt_center_shift gaussianDeriv s p 0 x

theorem modelThirdKernel_center_shift
    (u s p y : ℝ) :
    modelThirdKernel u s p y = modelThirdKernel u s 0 (y - p) := by
  unfold modelThirdKernel
  simpa only [add_zero] using kernelAt_center_shift
    (fun w : ℝ ↦ ∫ z : ℝ,
      gaussianDeriv z * conePsiPhysicalReal (w - z + u)) s p 0 y

/-- The third model factor is a translated normalized dilation of its
unit-scale kernel. -/
theorem modelThirdKernel_eq_unit_dilate
    (u s p y : ℝ) :
    modelThirdKernel u s p y =
      kernelDilate (modelThirdKernel u 1 0) s (y - p) := by
  unfold modelThirdKernel kernelAt kernelDilate
  simp only [smul_eq_mul, inv_one, one_mul, sub_zero]
  simp only [div_one]

/-- Fixed positive scales make the literal center-expanded model kernel
absolutely integrable for every real Schwartz input tuple. -/
theorem integrable_ModelCenterExpandedIntegrand
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (ht : 0 < t) :
    Integrable (ModelCenterExpandedIntegrand α u F t)
      (((volume : Measure E3).prod volume).prod volume) := by
  obtain ⟨B₁, hB₁, hF₁⟩ := initialModelRealInput_bounded F 1
  obtain ⟨B₂, hB₂, hF₂⟩ := initialModelRealInput_bounded F 2
  obtain ⟨B₃, hB₃, hF₃⟩ := initialModelRealInput_bounded F 3
  let s₀ : ℝ := t ^ α.weight 0
  let s₁ : ℝ := t ^ α.weight 1
  let s₂ : ℝ := t ^ α.weight 2
  have hs₀ : 0 < s₀ := by
    dsimp only [s₀]
    exact pow_pos ht _
  have hs₁ : 0 < s₁ := by
    dsimp only [s₁]
    exact pow_pos ht _
  have hs₂ : 0 < s₂ := by
    dsimp only [s₂]
    exact pow_pos ht _
  let C : ℝ := B₁ * B₂ * B₃
  have hF₀abs : Integrable (fun x : E3 ↦ |F 0 x|) := by
    simpa only [Real.norm_eq_abs] using (F 0).integrable.norm
  let A : E3 → ℝ := fun x ↦ C * |F 0 x|
  have hA : Integrable A := by
    simpa only [A] using hF₀abs.const_mul C
  have hphi₀ : Integrable (fun r : ℝ ↦
      |modelPhiAt s₀ (s₀ * u 0) r|) := by
    simpa only [modelPhiAt, kernelAt] using
      (integrable_abs_kernelDilate conePhiPhysicalReal
        conePhiPhysicalReal.integrable hs₀).comp_sub_right (s₀ * u 0)
  have hphi₁ : Integrable (fun r : ℝ ↦
      |modelPhiAt s₁ (s₁ * u 1) r|) := by
    simpa only [modelPhiAt, kernelAt] using
      (integrable_abs_kernelDilate conePhiPhysicalReal
        conePhiPhysicalReal.integrable hs₁).comp_sub_right (s₁ * u 1)
  have hderiv : Integrable (fun r : ℝ ↦ |gaussianDerivAt s₂ 0 r|) := by
    simpa only [gaussianDerivAt, kernelAt, sub_zero] using
      integrable_abs_kernelDilate gaussianDeriv integrable_gaussianDeriv hs₂
  have hgauss₀ : Integrable (fun r : ℝ ↦ |gaussianAt s₀ 0 r|) := by
    simpa only [gaussianAt, kernelAt, sub_zero] using
      integrable_abs_kernelDilate gaussian integrable_gaussian hs₀
  have hgauss₁ : Integrable (fun r : ℝ ↦ |gaussianAt s₁ 0 r|) := by
    simpa only [gaussianAt, kernelAt, sub_zero] using
      integrable_abs_kernelDilate gaussian integrable_gaussian hs₁
  have hthirdUnit : Integrable (modelThirdKernel (u 2) 1 0) := by
    simpa only [neg_neg] using integrable_modelThirdKernel_unit (-(u 2))
  have hthird : Integrable (fun r : ℝ ↦
      |modelThirdKernel (u 2) s₂ 0 r|) := by
    let H : ℝ → ℝ := fun r ↦
      |kernelDilate (modelThirdKernel (u 2) 1 0) s₂ r|
    have hH : Integrable H := by
      simpa only [H] using integrable_abs_kernelDilate
        (modelThirdKernel (u 2) 1 0) hthirdUnit hs₂
    apply hH.congr
    filter_upwards [] with r
    dsimp only [H]
    rw [modelThirdKernel_eq_unit_dilate]
    simp
  let P : E3 → ℝ := fun r ↦
    |modelPhiAt s₀ (s₀ * u 0) (r 0)| *
      |modelPhiAt s₁ (s₁ * u 1) (r 1)| *
      |gaussianDerivAt s₂ 0 (r 2)|
  have hP : Integrable P := by
    simpa only [P] using integrable_E3_coordinate_product
      (fun r : ℝ ↦ |modelPhiAt s₀ (s₀ * u 0) r|)
      (fun r : ℝ ↦ |modelPhiAt s₁ (s₁ * u 1) r|)
      (fun r : ℝ ↦ |gaussianDerivAt s₂ 0 r|)
      hphi₀ hphi₁ hderiv
  let Q : E3 → ℝ := fun r ↦
    |gaussianAt s₀ 0 (r 0)| *
      |gaussianAt s₁ 0 (r 1)| *
      |modelThirdKernel (u 2) s₂ 0 (r 2)|
  have hQ : Integrable Q := by
    simpa only [Q] using integrable_E3_coordinate_product
      (fun r : ℝ ↦ |gaussianAt s₀ 0 r|)
      (fun r : ℝ ↦ |gaussianAt s₁ 0 r|)
      (fun r : ℝ ↦ |modelThirdKernel (u 2) s₂ 0 r|)
      hgauss₀ hgauss₁ hthird
  let M : (E3 × E3) × E3 → ℝ := fun q ↦
    A q.1.1 * P (q.1.1 - q.2) * Q (q.1.2 - q.2)
  have hM : Integrable M
      (((volume : Measure E3).prod volume).prod volume) := by
    simpa only [M] using integrable_two_difference_factors_center_order
      A P Q hA hP hQ
  have hx (i : Fin 3) : Measurable
      (fun q : (E3 × E3) × E3 ↦ q.1.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp
      (measurable_fst.comp measurable_fst)
  have hy (i : Fin 3) : Measurable
      (fun q : (E3 × E3) × E3 ↦ q.1.2 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp
      (measurable_snd.comp measurable_fst)
  have hp (i : Fin 3) : Measurable
      (fun q : (E3 × E3) × E3 ↦ q.2 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp
      measurable_snd
  have hmeas : Measurable (ModelCenterExpandedIntegrand α u F t) := by
    have h0 : Measurable (fun q : (E3 × E3) × E3 ↦ F 0 q.1.1) :=
