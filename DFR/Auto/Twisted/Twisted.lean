        ≤ ∫ t in Ioi (0 : ℝ), C ν * ‖Φ ν t / (t : ℂ)‖ := by
      refine integral_mono_ae (hint ν).norm (((hΦint ν).norm).const_mul (C ν)) ?_
      filter_upwards [self_mem_ae_restrict measurableSet_Ioi] with t ht
