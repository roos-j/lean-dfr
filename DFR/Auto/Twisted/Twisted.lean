                  (1 / p)) := by
  classical
  rcases selectedFiber_scaleTail_pairing_le_line_maximal with ⟨C, hC, hmain⟩
  refine ⟨C, hC, ?_⟩
  intro Z _ F Zf Astop H z T i j u α B D hα hD hselected hF hFB hkernel hfar
