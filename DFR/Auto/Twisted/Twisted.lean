/-- **Each mode's frequency integrand is integrable.** -/
theorem integrable_modeFrequencyIntegrand
    (α : Anisotropy) (m : E3 → ℂ) (t : ℝ) (F : ModelComplexSchwartzInput)
    (ν : Fin 3 → ℤ) :
