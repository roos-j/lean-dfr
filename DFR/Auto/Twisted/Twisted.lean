/-- Every Schwartz test function is continuous and uniformly bounded. -/
theorem schwartz_continuous_bounded (f : Schwartz3) :
    Continuous f ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ x : E3, ‖f x‖ ≤ C := by
  have hC : 0 ≤ SchwartzMap.seminorm ℂ 0 0 f := by
    exact le_trans (norm_nonneg (f 0)) (SchwartzMap.norm_le_seminorm ℂ f (0 : E3))
  refine ⟨f.continuous, SchwartzMap.seminorm ℂ 0 0 f, hC, ?_⟩
  intro x
  exact SchwartzMap.norm_le_seminorm ℂ f x

/-- Every complex Schwartz test function belongs to every `L^p`, including
`p = ⊤`, with respect to Lebesgue measure. -/
theorem schwartz_memLp (f : Schwartz3) (p : ℝ≥0∞) : MemLp f p :=
  f.memLp p

/-- In particular, every complex Schwartz test function is integrable. -/
theorem schwartz_integrable (f : Schwartz3) : Integrable f :=
  f.integrable

/-- A concrete one-dimensional rapid-decay estimate extracted from a Schwartz
seminorm.  This is the form used for the fixed spatial cutoffs in the model
kernel estimates. -/
theorem schwartz_oneDim_decay (f : SchwartzMap ℝ ℂ) (r : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ, ‖f x‖ ≤ C / (1 + |x|) ^ r := by
  let C : ℝ := 2 ^ r *
    (Finset.Iic (r, 0)).sup (fun q ↦ SchwartzMap.seminorm ℂ q.1 q.2) f
  have hC : 0 ≤ C := by
    have h := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℂ)
      (m := (r, 0)) le_rfl le_rfl f (0 : ℝ)
    have hnonneg : 0 ≤ (1 + ‖(0 : ℝ)‖) ^ r *
        ‖iteratedFDeriv ℝ 0 f (0 : ℝ)‖ :=
      mul_nonneg (pow_nonneg (by positivity) _) (norm_nonneg _)
    exact hnonneg.trans (by simpa [C] using h)
  refine ⟨C, hC, fun x ↦ ?_⟩
  apply (le_div_iff₀ (by positivity)).mpr
  rw [mul_comm]
  simpa [C, Real.norm_eq_abs, norm_iteratedFDeriv_zero] using
    (SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℂ)
      (m := (r, 0)) le_rfl le_rfl f x)

/-- The same seminorm extraction in an arbitrary real normed source space. -/
theorem schwartz_decay_norm {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : SchwartzMap E ℂ) (r : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : E, ‖f x‖ ≤ C / (1 + ‖x‖) ^ r := by
  let C : ℝ := 2 ^ r *
    (Finset.Iic (r, 0)).sup (fun q ↦ SchwartzMap.seminorm ℂ q.1 q.2) f
  have hC : 0 ≤ C := by
    have h := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℂ)
      (m := (r, 0)) le_rfl le_rfl f (0 : E)
    have hnonneg : 0 ≤ (1 + ‖(0 : E)‖) ^ r *
        ‖iteratedFDeriv ℝ 0 f (0 : E)‖ :=
      mul_nonneg (pow_nonneg (by positivity) _) (norm_nonneg _)
    exact hnonneg.trans (by simpa [C] using h)
  refine ⟨C, hC, fun x ↦ ?_⟩
  apply (le_div_iff₀ (by positivity)).mpr
  rw [mul_comm]
  simpa [C, norm_iteratedFDeriv_zero] using
    (SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℂ)
      (m := (r, 0)) le_rfl le_rfl f x)

/-- Fourier transformation preserves the source's complex Schwartz class. -/
def schwartzFourier (f : Schwartz3) : Schwartz3 := 𝓕 f

/-- Inverse Fourier transformation preserves the source's complex Schwartz class. -/
