/-- Square-integrable square-root weighted factors make the signed product
absolutely integrable whenever the signed density is dominated by the weight.
This is the Fubini input accompanying the weighted Cauchy--Schwarz bound. -/
theorem integrable_signedDensity_of_weighted
    {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (a b c σ w : X → ℝ)
    (hprodmeas : AEStronglyMeasurable (fun x ↦ c x * (a x * b x * σ x)) μ)
    (hameas : AEStronglyMeasurable (fun x ↦ |a x| * √(w x)) μ)
    (hbmeas : AEStronglyMeasurable (fun x ↦ |b x| * √(w x)) μ)
    (haint : Integrable (fun x ↦ (|a x| * √(w x)) ^ 2) μ)
    (hbint : Integrable (fun x ↦ (|b x| * √(w x)) ^ 2) μ)
    (hc : ∀ᵐ x ∂μ, |c x| ≤ 1)
    (hw : ∀ᵐ x ∂μ, 0 ≤ w x)
    (hσ : ∀ᵐ x ∂μ, |σ x| = w x) :
    Integrable (fun x ↦ c x * (a x * b x * σ x)) μ := by
  let A : X → ℝ := fun x ↦ |a x| * √(w x)
  let B : X → ℝ := fun x ↦ |b x| * √(w x)
  have hAmeas : AEStronglyMeasurable A μ := by
    simpa only [A] using hameas
  have hBmeas : AEStronglyMeasurable B μ := by
    simpa only [B] using hbmeas
  have hAint : Integrable (fun x ↦ A x ^ 2) μ := by
    simpa only [A] using haint
  have hBint : Integrable (fun x ↦ B x ^ 2) μ := by
    simpa only [B] using hbint
  have hABint : Integrable (fun x ↦ A x * B x) μ := by
    exact ((memLp_two_iff_integrable_sq hAmeas).2 hAint).integrable_mul
      ((memLp_two_iff_integrable_sq hBmeas).2 hBint)
  refine hABint.mono' hprodmeas ?_
  filter_upwards [hc, hw, hσ] with x hcx hw' hσ'
  have hab : 0 ≤ |a x| * |b x| * w x := by positivity
  calc
    ‖c x * (a x * b x * σ x)‖ = |c x| * |a x| * |b x| * w x := by
      rw [Real.norm_eq_abs, abs_mul, abs_mul, abs_mul, hσ']
      ring
    _ = |c x| * (|a x| * |b x| * w x) := by ring
    _ ≤ 1 * (|a x| * |b x| * w x) :=
      mul_le_mul_of_nonneg_right hcx hab
    _ = |a x| * |b x| * w x := by ring
    _ = A x * B x := by
      dsimp only [A, B]
      calc
        |a x| * |b x| * w x =
            |a x| * |b x| * (√(w x) * √(w x)) := by
          rw [Real.mul_self_sqrt hw']
        _ = |a x| * √(w x) * (|b x| * √(w x)) := by ring

/-- A uniform bound on a fiber and integrability of a nonnegative density
give the square-integrability of its square-root weighted version. -/
theorem squareRootWeighted_integrable_of_ae_bound
    {X : Type*} [MeasurableSpace X] (μ : Measure X) (a w : X → ℝ)
    (ha : AEStronglyMeasurable a μ)
    (hwmeas : AEStronglyMeasurable w μ)
    (hwint : Integrable w μ)
    (hw : ∀ᵐ x ∂μ, 0 ≤ w x)
    (M : ℝ) (hM : 0 ≤ M)
    (hbound : ∀ᵐ x ∂μ, |a x| ≤ M) :
    AEStronglyMeasurable (fun x ↦ |a x| * √(w x)) μ ∧
      Integrable (fun x ↦ (|a x| * √(w x)) ^ 2) μ := by
  have hsqrt : AEStronglyMeasurable (fun x ↦ √(w x)) μ :=
    (hwmeas.aemeasurable.sqrt).aestronglyMeasurable
  have hmeas : AEStronglyMeasurable (fun x ↦ |a x| * √(w x)) μ :=
    ha.norm.mul hsqrt
  have hmajor : Integrable (fun x ↦ M ^ 2 * w x) μ := by
    simpa only using hwint.const_mul (M ^ 2)
  refine ⟨hmeas, hmajor.mono' (hmeas.pow 2) ?_⟩
  filter_upwards [hw, hbound] with x hw' hbound'
  rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
  have hsq : |a x| ^ 2 ≤ M ^ 2 :=
    (sq_le_sq₀ (abs_nonneg _) hM).2 hbound'
  calc
    (|a x| * √(w x)) ^ 2 = |a x| ^ 2 * w x := by
      rw [mul_pow, Real.sq_sqrt hw']
    _ ≤ M ^ 2 * w x := mul_le_mul_of_nonneg_right hsq hw'

/-- Cauchy--Schwarz for a signed density whose absolute value is a positive
weight.  The square-root weighted factors are kept explicit: this makes the
lemma applicable before any particular parameter-integral measurability
package has been chosen. -/
theorem signedDensity_weighted_cauchySchwarz
    {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (a b c σ w : X → ℝ)
    (hprodmeas : AEStronglyMeasurable (fun x ↦ c x * (a x * b x * σ x)) μ)
    (hameas : AEStronglyMeasurable (fun x ↦ |a x| * √(w x)) μ)
    (hbmeas : AEStronglyMeasurable (fun x ↦ |b x| * √(w x)) μ)
    (haint : Integrable (fun x ↦ (|a x| * √(w x)) ^ 2) μ)
    (hbint : Integrable (fun x ↦ (|b x| * √(w x)) ^ 2) μ)
    (hc : ∀ᵐ x ∂μ, |c x| ≤ 1)
    (hw : ∀ᵐ x ∂μ, 0 ≤ w x)
    (hσ : ∀ᵐ x ∂μ, |σ x| = w x) :
    |∫ x, c x * (a x * b x * σ x) ∂μ| ^ 2 ≤
      (∫ x, (|a x| * √(w x)) ^ 2 ∂μ) *
        ∫ x, (|b x| * √(w x)) ^ 2 ∂μ := by
  let A : X → ℝ := fun x ↦ |a x| * √(w x)
  let B : X → ℝ := fun x ↦ |b x| * √(w x)
  have hAmeas : AEStronglyMeasurable A μ := by
    simpa only [A] using hameas
  have hBmeas : AEStronglyMeasurable B μ := by
    simpa only [B] using hbmeas
  have hAint : Integrable (fun x ↦ A x ^ 2) μ := by
    simpa only [A] using haint
  have hBint : Integrable (fun x ↦ B x ^ 2) μ := by
    simpa only [B] using hbint
  have hABint : Integrable (fun x ↦ A x * B x) μ := by
    exact ((memLp_two_iff_integrable_sq hAmeas).2 hAint).integrable_mul
      ((memLp_two_iff_integrable_sq hBmeas).2 hBint)
  have hdom : ∀ᵐ x ∂μ,
      |c x * (a x * b x * σ x)| ≤ A x * B x := by
    filter_upwards [hc, hw, hσ] with x hcx hw' hσ'
    have hab : 0 ≤ |a x| * |b x| * w x := by positivity
    calc
      |c x * (a x * b x * σ x)| = |c x| * |a x| * |b x| * w x := by
        rw [abs_mul, abs_mul, abs_mul, hσ']
        ring
      _ = |c x| * (|a x| * |b x| * w x) := by ring
      _ ≤ 1 * (|a x| * |b x| * w x) :=
        mul_le_mul_of_nonneg_right hcx hab
      _ = |a x| * |b x| * w x := by ring
      _ = A x * B x := by
        dsimp only [A, B]
        calc
          |a x| * |b x| * w x =
              |a x| * |b x| * (√(w x) * √(w x)) := by
            rw [Real.mul_self_sqrt hw']
          _ = |a x| * √(w x) * (|b x| * √(w x)) := by ring
  have hsignedAbsInt : Integrable (fun x ↦ |c x * (a x * b x * σ x)|) μ := by
    refine hABint.mono' hprodmeas.norm ?_
    simpa only [Real.norm_eq_abs, abs_abs] using hdom
  have hbound : |∫ x, c x * (a x * b x * σ x) ∂μ| ≤
      √(∫ x, A x ^ 2 ∂μ) * √(∫ x, B x ^ 2 ∂μ) := by
    calc
      |∫ x, c x * (a x * b x * σ x) ∂μ| ≤
          ∫ x, |c x * (a x * b x * σ x)| ∂μ :=
        MeasureTheory.abs_integral_le_integral_abs
      _ ≤ ∫ x, A x * B x ∂μ :=
        integral_mono_ae hsignedAbsInt hABint hdom
      _ ≤ √(∫ x, A x ^ 2 ∂μ) * √(∫ x, B x ^ 2 ∂μ) :=
        integral_mul_le_sqrt_integral_sq μ A B hAmeas hBmeas
          (Filter.Eventually.of_forall fun x ↦ by positivity)
          (Filter.Eventually.of_forall fun x ↦ by positivity) hAint hBint
  have hAnonnneg : 0 ≤ ∫ x, A x ^ 2 ∂μ :=
    integral_nonneg fun x ↦ sq_nonneg (A x)
  have hBnonnneg : 0 ≤ ∫ x, B x ^ 2 ∂μ :=
    integral_nonneg fun x ↦ sq_nonneg (B x)
  have hright : 0 ≤ √(∫ x, A x ^ 2 ∂μ) * √(∫ x, B x ^ 2 ∂μ) :=
    mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
  calc
    |∫ x, c x * (a x * b x * σ x) ∂μ| ^ 2 ≤
        (√(∫ x, A x ^ 2 ∂μ) * √(∫ x, B x ^ 2 ∂μ)) ^ 2 :=
      (sq_le_sq₀ (abs_nonneg _) hright).2 hbound
    _ = (∫ x, A x ^ 2 ∂μ) * ∫ x, B x ^ 2 ∂μ := by
      rw [mul_pow, Real.sq_sqrt hAnonnneg, Real.sq_sqrt hBnonnneg]
    _ = (∫ x, (|a x| * √(w x)) ^ 2 ∂μ) *
        ∫ x, (|b x| * √(w x)) ^ 2 ∂μ := by
      rfl

/-- The first square-root weighted factor on the joint local-model space. -/
noncomputable def modelFirstWeightedFactor
    (α : Anisotropy) (u : E3) (f : ModelRealInput)
    (q : (E3 × ℝ) × ModelE5) : ℝ :=
  |modelFirstFiber α f q.1.1 q.1.2 q.2| *
    √(modelEnergyDensity α u q.1.1 q.1.2 q.2)

/-- The second square-root weighted factor on the joint local-model space. -/
noncomputable def modelSecondWeightedFactor
    (α : Anisotropy) (u : E3) (f : E3 → ℝ)
    (q : (E3 × ℝ) × ModelE5) : ℝ :=
  |modelSecondFiber α f q.1.1 q.1.2 q.2| *
    √(modelEnergyDensity α u q.1.1 q.1.2 q.2)

/-- The signed joint integrand whose iterated integral defines the expanded
local model form. -/
noncomputable def modelSignedIntegrand
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (q : (E3 × ℝ) × ModelE5) : ℝ :=
  c q.1.2 *
    (modelFirstFiber α f q.1.1 q.1.2 q.2 *
      modelSecondFiber α (f 3) q.1.1 q.1.2 q.2 *
        modelSignedDensity α u q.1.1 q.1.2 q.2)

/-- The joint integrand defining the first local energy. -/
noncomputable def modelEnergyOneIntegrand
    (α : Anisotropy) (u : E3) (f : ModelRealInput)
    (q : (E3 × ℝ) × ModelE5) : ℝ :=
  (modelFirstFiber α f q.1.1 q.1.2 q.2) ^ 2 *
    modelEnergyDensity α u q.1.1 q.1.2 q.2

/-- The joint integrand defining the second local energy. -/
noncomputable def modelEnergyTwoJointIntegrand
    (α : Anisotropy) (u : E3) (f : E3 → ℝ)
    (q : (E3 × ℝ) × ModelE5) : ℝ :=
  (modelSecondFiber α f q.1.1 q.1.2 q.2) ^ 2 *
    modelEnergyDensity α u q.1.1 q.1.2 q.2

/-- Continuous real inputs and a measurable multiplier make the signed local
model product a.e.-strongly measurable on every joint measure. -/
theorem aestronglyMeasurable_modelSignedIntegrand
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (hcmeas : Measurable c) (hfcont : ∀ j, Continuous (f j))
    (μ : Measure ((E3 × ℝ) × ModelE5)) :
    AEStronglyMeasurable (modelSignedIntegrand α u c f) μ := by
  have hc : AEStronglyMeasurable (fun q : (E3 × ℝ) × ModelE5 ↦ c q.1.2) μ :=
    (hcmeas.comp (measurable_snd.comp measurable_fst)).aestronglyMeasurable
  have hfirst := aestronglyMeasurable_modelFirstFiber α f hfcont μ
  have hsecond := aestronglyMeasurable_modelSecondFiber α (f 3)
    (hfcont 3) μ
  have hdensity := aestronglyMeasurable_modelSignedDensity α u μ
  unfold modelSignedIntegrand
  exact hc.mul ((hfirst.mul hsecond).mul hdensity)

/-- The first square-root weighted factor is a.e.-strongly measurable for
continuous inputs on every joint measure. -/
theorem aestronglyMeasurable_modelFirstWeightedFactor
    (α : Anisotropy) (u : E3) (f : ModelRealInput)
    (hfcont : ∀ j, Continuous (f j))
    (μ : Measure ((E3 × ℝ) × ModelE5)) :
    AEStronglyMeasurable (modelFirstWeightedFactor α u f) μ := by
  have hfirst := aestronglyMeasurable_modelFirstFiber α f hfcont μ
  have hweight := aestronglyMeasurable_modelEnergyDensity α u μ
  unfold modelFirstWeightedFactor
  exact hfirst.norm.mul (hweight.aemeasurable.sqrt).aestronglyMeasurable

/-- The second square-root weighted factor is a.e.-strongly measurable for a
continuous input on every joint measure. -/
theorem aestronglyMeasurable_modelSecondWeightedFactor
    (α : Anisotropy) (u : E3) (f : E3 → ℝ) (hfcont : Continuous f)
    (μ : Measure ((E3 × ℝ) × ModelE5)) :
    AEStronglyMeasurable (modelSecondWeightedFactor α u f) μ := by
  have hsecond := aestronglyMeasurable_modelSecondFiber α f hfcont μ
  have hweight := aestronglyMeasurable_modelEnergyDensity α u μ
  unfold modelSecondWeightedFactor
  exact hsecond.norm.mul (hweight.aemeasurable.sqrt).aestronglyMeasurable

/-- The joint center--scale/fiber measure of a finite collection is supported
on strictly positive scales. -/
theorem ae_pos_scale_modelJoint
    (α : Anisotropy) (S : BoxCollection α) :
    ∀ᵐ q ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
      (volume : Measure ModelE5)), 0 < q.1.2 := by
  let μpt : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  have hpt : ∀ᵐ pt ∂μpt, 0 < pt.2 := by
    dsimp [μpt]
    filter_upwards [ae_restrict_mem (measurableSet_collectionRegion α S)]
      with pt hpt
    exact pos_of_mem_closure_collectionRegion α S (subset_closure hpt)
  have hmeas : MeasurableSet {q : (E3 × ℝ) × ModelE5 | 0 < q.1.2} := by
    change MeasurableSet ((fun q : (E3 × ℝ) × ModelE5 ↦ q.1.2) ⁻¹'
      Set.Ioi 0)
    exact measurableSet_preimage (measurable_snd.comp measurable_fst)
      measurableSet_Ioi
  change ∀ᵐ q ∂μpt.prod volume, 0 < q.1.2
  apply (Measure.ae_prod_iff_ae_ae hmeas).2
  filter_upwards [hpt] with pt hpt
  exact Filter.Eventually.of_forall fun _ ↦ hpt

/-- The literal energy density is a.e. nonnegative on the joint local-model
measure. -/
theorem ae_modelEnergyDensity_nonneg_collection
    (α : Anisotropy) (S : BoxCollection α) (u : E3) :
    ∀ᵐ q ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
      (volume : Measure ModelE5)),
      0 ≤ modelEnergyDensity α u q.1.1 q.1.2 q.2 := by
  filter_upwards [ae_pos_scale_modelJoint α S] with q hq
  exact modelEnergyDensity_nonneg α u q.1.1 hq.le q.2

/-- On the same joint measure, the signed density has absolute value exactly
the energy density. -/
theorem ae_abs_modelSignedDensity_collection
    (α : Anisotropy) (S : BoxCollection α) (u : E3) :
    ∀ᵐ q ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
      (volume : Measure ModelE5)),
      |modelSignedDensity α u q.1.1 q.1.2 q.2| =
        modelEnergyDensity α u q.1.1 q.1.2 q.2 := by
  filter_upwards [ae_pos_scale_modelJoint α S] with q hq
  exact abs_modelSignedDensity α u q.1.1 hq.le q.2

/-- Squaring the first weighted factor recovers the first energy density on
the positive-scale local joint measure. -/
theorem ae_modelFirstWeightedFactor_sq
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : ModelRealInput) :
    ∀ᵐ q ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
      (volume : Measure ModelE5)),
      (modelFirstWeightedFactor α u f q) ^ 2 =
        modelEnergyOneIntegrand α u f q := by
  filter_upwards [ae_modelEnergyDensity_nonneg_collection α S u]
    with q hq
  unfold modelFirstWeightedFactor modelEnergyOneIntegrand
  rw [mul_pow, sq_abs, Real.sq_sqrt hq]

/-- Squaring the second weighted factor recovers the second energy density on
the positive-scale local joint measure. -/
theorem ae_modelSecondWeightedFactor_sq
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : E3 → ℝ) :
    ∀ᵐ q ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
      (volume : Measure ModelE5)),
      (modelSecondWeightedFactor α u f q) ^ 2 =
        modelEnergyTwoJointIntegrand α u f q := by
  filter_upwards [ae_modelEnergyDensity_nonneg_collection α S u]
    with q hq
  unfold modelSecondWeightedFactor modelEnergyTwoJointIntegrand
  rw [mul_pow, sq_abs, Real.sq_sqrt hq]

/-- The positive-scale support of a finite collection promotes the fixed-scale
first-fiber estimate to the full local joint measure. -/
theorem ae_abs_modelFirstFiber_le_collection
    (α : Anisotropy) (S : BoxCollection α) (f : ModelRealInput)
    (hfcont : ∀ j, Continuous (f j))
    (B0 B1 B2 : ℝ) (hB0 : 0 ≤ B0) (hB1 : 0 ≤ B1) (hB2 : 0 ≤ B2)
    (hf0 : ∀ y, |f 0 y| ≤ B0) (hf1 : ∀ y, |f 1 y| ≤ B1)
    (hf2 : ∀ y, |f 2 y| ≤ B2) :
    ∀ᵐ q ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
      (volume : Measure ModelE5)),
      |modelFirstFiber α f q.1.1 q.1.2 q.2| ≤
        (B0 * B1 * B2) * ∫ v : ℝ, |gaussianDeriv v| := by
  filter_upwards [ae_pos_scale_modelJoint α S] with q hq
  exact abs_modelFirstFiber_le α f q.1.1 q.2 hfcont B0 B1 B2 hB0 hB1 hB2
    hf0 hf1 hf2 hq

/-- The analogous uniform second-fiber estimate on the full local joint
measure. -/
theorem ae_abs_modelSecondFiber_le_collection
    (α : Anisotropy) (S : BoxCollection α) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hf : ∀ y, |f y| ≤ B) :
    ∀ᵐ q ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
      (volume : Measure ModelE5)),
      |modelSecondFiber α f q.1.1 q.1.2 q.2| ≤
        B * ∫ v : ℝ, |gaussianDeriv v| := by
  filter_upwards [ae_pos_scale_modelJoint α S] with q hq
  exact abs_modelSecondFiber_le α f q.1.1 q.2 hfcont B hB hf hq

/-- Once the positive local density is jointly integrable, the first
square-root weighted fiber is square-integrable under the literal uniform
bounded-continuous hypotheses. -/
theorem integrable_modelFirstWeightedFactor_sq_of_density
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : ModelRealInput)
    (hfcont : ∀ j, Continuous (f j))
    (B0 B1 B2 : ℝ) (hB0 : 0 ≤ B0) (hB1 : 0 ≤ B1) (hB2 : 0 ≤ B2)
    (hf0 : ∀ y, |f 0 y| ≤ B0) (hf1 : ∀ y, |f 1 y| ≤ B1)
    (hf2 : ∀ y, |f 2 y| ≤ B2)
    (hweightint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5))) :
    Integrable (fun q ↦ (modelFirstWeightedFactor α u f q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)) := by
  let μ : Measure ((E3 × ℝ) × ModelE5) :=
    (cubeScaleMeasure.restrict (collectionRegion α S)).prod volume
  let A : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelFirstFiber α f q.1.1 q.1.2 q.2
  let W : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelEnergyDensity α u q.1.1 q.1.2 q.2
  let M : ℝ := (B0 * B1 * B2) * ∫ v : ℝ, |gaussianDeriv v|
  have hM : 0 ≤ M := by
    dsimp only [M]
    exact mul_nonneg (mul_nonneg (mul_nonneg hB0 hB1) hB2)
      (integral_nonneg fun v ↦ abs_nonneg (gaussianDeriv v))
  have hAmeas : AEStronglyMeasurable A μ := by
    simpa only [A] using
      aestronglyMeasurable_modelFirstFiber α f hfcont μ
  have hWmeas : AEStronglyMeasurable W μ := by
    simpa only [W] using aestronglyMeasurable_modelEnergyDensity α u μ
  have hWint : Integrable W μ := by
    simpa only [μ, W] using hweightint
  have hWnonneg : ∀ᵐ q ∂μ, 0 ≤ W q := by
    simpa only [μ, W] using
      ae_modelEnergyDensity_nonneg_collection α S u
  have hAbound : ∀ᵐ q ∂μ, |A q| ≤ M := by
    simpa only [μ, A, M] using
      ae_abs_modelFirstFiber_le_collection α S f hfcont B0 B1 B2
        hB0 hB1 hB2 hf0 hf1 hf2
  have hweighted := squareRootWeighted_integrable_of_ae_bound
    μ A W hAmeas hWmeas hWint hWnonneg M hM hAbound
  change Integrable (fun q ↦ (|A q| * √(W q)) ^ 2) μ
  exact hweighted.2

/-- The corresponding density-to-square-integrability step for the second
weighted fiber. -/
theorem integrable_modelSecondWeightedFactor_sq_of_density
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : E3 → ℝ)
    (hfcont : Continuous f) (B : ℝ) (hB : 0 ≤ B) (hf : ∀ y, |f y| ≤ B)
    (hweightint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5))) :
    Integrable (fun q ↦ (modelSecondWeightedFactor α u f q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)) := by
  let μ : Measure ((E3 × ℝ) × ModelE5) :=
    (cubeScaleMeasure.restrict (collectionRegion α S)).prod volume
  let A : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelSecondFiber α f q.1.1 q.1.2 q.2
  let W : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelEnergyDensity α u q.1.1 q.1.2 q.2
  let M : ℝ := B * ∫ v : ℝ, |gaussianDeriv v|
  have hM : 0 ≤ M := by
    dsimp only [M]
    exact mul_nonneg hB (integral_nonneg fun v ↦ abs_nonneg (gaussianDeriv v))
  have hAmeas : AEStronglyMeasurable A μ := by
    simpa only [A] using
      aestronglyMeasurable_modelSecondFiber α f hfcont μ
  have hWmeas : AEStronglyMeasurable W μ := by
    simpa only [W] using aestronglyMeasurable_modelEnergyDensity α u μ
  have hWint : Integrable W μ := by
    simpa only [μ, W] using hweightint
  have hWnonneg : ∀ᵐ q ∂μ, 0 ≤ W q := by
    simpa only [μ, W] using
      ae_modelEnergyDensity_nonneg_collection α S u
  have hAbound : ∀ᵐ q ∂μ, |A q| ≤ M := by
    simpa only [μ, A, M] using
      ae_abs_modelSecondFiber_le_collection α S f hfcont B hB hf
  have hweighted := squareRootWeighted_integrable_of_ae_bound
    μ A W hAmeas hWmeas hWint hWnonneg M hM hAbound
  change Integrable (fun q ↦ (|A q| * √(W q)) ^ 2) μ
  exact hweighted.2

/-- Fubini turns the literal iterated signed-density local form into its
single product-space integral, once absolute integrability is available. -/
theorem expandedModelLocalForm_eq_neg_jointIntegral_of_integrable
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      c q.1.2 *
        (modelFirstFiber α f q.1.1 q.1.2 q.2 *
          modelSecondFiber α (f 3) q.1.1 q.1.2 q.2 *
            modelSignedDensity α u q.1.1 q.1.2 q.2))
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)) :
    expandedModelLocalForm α S u c f =
      -(∫ q : (E3 × ℝ) × ModelE5,
        c q.1.2 *
          (modelFirstFiber α f q.1.1 q.1.2 q.2 *
            modelSecondFiber α (f 3) q.1.1 q.1.2 q.2 *
              modelSignedDensity α u q.1.1 q.1.2 q.2)
        ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)) := by
  letI : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  unfold expandedModelLocalForm
  calc
    -(∫ pt : E3 × ℝ,
        c pt.2 * (∫ z : ModelE5,
          modelFirstFiber α f pt.1 pt.2 z *
            modelSecondFiber α (f 3) pt.1 pt.2 z *
              modelSignedDensity α u pt.1 pt.2 z)
        ∂(cubeScaleMeasure.restrict (collectionRegion α S))) =
        -(∫ pt : E3 × ℝ,
          (∫ z : ModelE5,
            c pt.2 *
              (modelFirstFiber α f pt.1 pt.2 z *
                modelSecondFiber α (f 3) pt.1 pt.2 z *
                  modelSignedDensity α u pt.1 pt.2 z))
          ∂(cubeScaleMeasure.restrict (collectionRegion α S))) := by
      congr 1
      apply integral_congr_ae
      filter_upwards [] with pt
      rw [← integral_const_mul]
    _ = _ := by
      simpa only using congrArg Neg.neg (MeasureTheory.integral_prod _ hjoint).symm

/-- The first energy is the corresponding product-space integral under the
joint integrability hypothesis supplied by localization. -/
theorem modelEnergyOne_eq_jointIntegral_of_integrable
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : ModelRealInput)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      (modelFirstFiber α f q.1.1 q.1.2 q.2) ^ 2 *
        modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)) :
    modelEnergyOne α S u f =
      ∫ q : (E3 × ℝ) × ModelE5,
        (modelFirstFiber α f q.1.1 q.1.2 q.2) ^ 2 *
          modelEnergyDensity α u q.1.1 q.1.2 q.2
        ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume) := by
  letI : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  unfold modelEnergyOne
  simpa only using (MeasureTheory.integral_prod _ hjoint).symm

/-- The second finite-collection energy has the same joint-integral form. -/
theorem modelEnergyTwo_eq_jointIntegral_of_integrable
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : E3 → ℝ)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      (modelSecondFiber α f q.1.1 q.1.2 q.2) ^ 2 *
        modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)) :
    modelEnergyTwo α S u f =
      ∫ q : (E3 × ℝ) × ModelE5,
        (modelSecondFiber α f q.1.1 q.1.2 q.2) ^ 2 *
          modelEnergyDensity α u q.1.1 q.1.2 q.2
        ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume) := by
  letI : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  unfold modelEnergyTwo modelEnergyTwoOn
  simpa only using (MeasureTheory.integral_prod _ hjoint).symm

/-- The literal first local Cauchy--Schwarz inequality.  Its hypotheses are
precisely the joint measurability and square-integrability assertions supplied
by the bounded-continuous localization package; no Fubini equality is left as
an assumption. -/
theorem expandedModelLocalForm_cauchySchwarz_of_weightedIntegrable
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput)
    (hsignedmeas : AEStronglyMeasurable
      (modelSignedIntegrand α u c f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hfirstmeas : AEStronglyMeasurable
      (modelFirstWeightedFactor α u f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hsecondmeas : AEStronglyMeasurable
      (modelSecondWeightedFactor α u (f 3))
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hfirstint : Integrable
      (fun q ↦ (modelFirstWeightedFactor α u f q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hsecondint : Integrable
      (fun q ↦ (modelSecondWeightedFactor α u (f 3) q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    |expandedModelLocalForm α S u c f| ^ 2 ≤
      modelEnergyOne α S u f * modelEnergyTwo α S u (f 3) := by
  letI : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  let μ : Measure ((E3 × ℝ) × ModelE5) :=
    (cubeScaleMeasure.restrict (collectionRegion α S)).prod volume
  let A : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelFirstFiber α f q.1.1 q.1.2 q.2
  let B : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelSecondFiber α (f 3) q.1.1 q.1.2 q.2
  let C : (E3 × ℝ) × ModelE5 → ℝ := fun q ↦ c q.1.2
  let σ : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelSignedDensity α u q.1.1 q.1.2 q.2
  let W : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelEnergyDensity α u q.1.1 q.1.2 q.2
  have hW : ∀ᵐ q ∂μ, 0 ≤ W q := by
    simpa only [μ, W] using
      ae_modelEnergyDensity_nonneg_collection α S u
  have hσ : ∀ᵐ q ∂μ, |σ q| = W q := by
    simpa only [μ, σ, W] using
      ae_abs_modelSignedDensity_collection α S u
  have hC : ∀ᵐ q ∂μ, |C q| ≤ 1 :=
    Filter.Eventually.of_forall fun q ↦ hc q.1.2
  have hsignedmeas' : AEStronglyMeasurable
      (fun q ↦ C q * (A q * B q * σ q)) μ := by
    change AEStronglyMeasurable (modelSignedIntegrand α u c f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)
    exact hsignedmeas
  have hfirstmeas' : AEStronglyMeasurable
      (fun q ↦ |A q| * √(W q)) μ := by
    change AEStronglyMeasurable (modelFirstWeightedFactor α u f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)
    exact hfirstmeas
  have hsecondmeas' : AEStronglyMeasurable
      (fun q ↦ |B q| * √(W q)) μ := by
    change AEStronglyMeasurable (modelSecondWeightedFactor α u (f 3))
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)
    exact hsecondmeas
  have hfirstint' : Integrable (fun q ↦ (|A q| * √(W q)) ^ 2) μ := by
    change Integrable (fun q ↦ (modelFirstWeightedFactor α u f q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)
    exact hfirstint
  have hsecondint' : Integrable (fun q ↦ (|B q| * √(W q)) ^ 2) μ := by
    change Integrable
      (fun q ↦ (modelSecondWeightedFactor α u (f 3) q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)
    exact hsecondint
  have hsignedint' : Integrable (fun q ↦ C q * (A q * B q * σ q)) μ :=
    integrable_signedDensity_of_weighted μ A B C σ W hsignedmeas'
      hfirstmeas' hsecondmeas' hfirstint' hsecondint' hC hW hσ
  have hfirstEnergyInt : Integrable
      (modelEnergyOneIntegrand α u f) μ := by
    exact hfirstint.congr (ae_modelFirstWeightedFactor_sq α S u f)
  have hsecondEnergyInt : Integrable
      (modelEnergyTwoJointIntegrand α u (f 3)) μ := by
    exact hsecondint.congr
      (ae_modelSecondWeightedFactor_sq α S u (f 3))
  have hform : expandedModelLocalForm α S u c f =
      -(∫ q : (E3 × ℝ) × ModelE5,
        C q * (A q * B q * σ q) ∂μ) := by
    simpa [μ, A, B, C, σ, modelSignedIntegrand] using
      expandedModelLocalForm_eq_neg_jointIntegral_of_integrable α S u c f
        (by simpa [μ, A, B, C, σ, modelSignedIntegrand]
          using hsignedint')
  have henergyOne : modelEnergyOne α S u f =
      ∫ q : (E3 × ℝ) × ModelE5,
        modelEnergyOneIntegrand α u f q ∂μ := by
    unfold modelEnergyOne
    change (∫ pt : E3 × ℝ,
      (∫ z : ModelE5,
        modelEnergyOneIntegrand α u f (pt, z))
      ∂(cubeScaleMeasure.restrict (collectionRegion α S))) =
        ∫ q : (E3 × ℝ) × ModelE5,
          modelEnergyOneIntegrand α u f q ∂μ
    simpa only [μ] using
      (MeasureTheory.integral_prod (modelEnergyOneIntegrand α u f)
        hfirstEnergyInt).symm
  have henergyTwo : modelEnergyTwo α S u (f 3) =
      ∫ q : (E3 × ℝ) × ModelE5,
        modelEnergyTwoJointIntegrand α u (f 3) q ∂μ := by
    unfold modelEnergyTwo modelEnergyTwoOn
    change (∫ pt : E3 × ℝ,
      (∫ z : ModelE5,
        modelEnergyTwoJointIntegrand α u (f 3) (pt, z))
      ∂(cubeScaleMeasure.restrict (collectionRegion α S))) =
        ∫ q : (E3 × ℝ) × ModelE5,
          modelEnergyTwoJointIntegrand α u (f 3) q ∂μ
    simpa only [μ] using
      (MeasureTheory.integral_prod (modelEnergyTwoJointIntegrand α u (f 3))
        hsecondEnergyInt).symm
  have hcs := signedDensity_weighted_cauchySchwarz μ A B C σ W
    hsignedmeas' hfirstmeas' hsecondmeas' hfirstint' hsecondint' hC hW hσ
  have hfirstSquare :
      (∫ q : (E3 × ℝ) × ModelE5,
        (modelFirstWeightedFactor α u f q) ^ 2 ∂μ) =
      ∫ q : (E3 × ℝ) × ModelE5,
        modelEnergyOneIntegrand α u f q ∂μ := by
    exact integral_congr_ae (ae_modelFirstWeightedFactor_sq α S u f)
  have hsecondSquare :
      (∫ q : (E3 × ℝ) × ModelE5,
        (modelSecondWeightedFactor α u (f 3) q) ^ 2 ∂μ) =
      ∫ q : (E3 × ℝ) × ModelE5,
        modelEnergyTwoJointIntegrand α u (f 3) q ∂μ := by
    exact integral_congr_ae
      (ae_modelSecondWeightedFactor_sq α S u (f 3))
  calc
    |expandedModelLocalForm α S u c f| ^ 2 =
        |∫ q : (E3 × ℝ) × ModelE5, C q * (A q * B q * σ q) ∂μ| ^ 2 := by
      rw [hform, abs_neg]
    _ ≤ (∫ q : (E3 × ℝ) × ModelE5,
          (modelFirstWeightedFactor α u f q) ^ 2 ∂μ) *
        ∫ q : (E3 × ℝ) × ModelE5,
          (modelSecondWeightedFactor α u (f 3) q) ^ 2 ∂μ := by
      simpa only [A, B, W, modelFirstWeightedFactor,
        modelSecondWeightedFactor] using hcs
    _ = (∫ q : (E3 × ℝ) × ModelE5,
          modelEnergyOneIntegrand α u f q ∂μ) *
        ∫ q : (E3 × ℝ) × ModelE5,
          modelEnergyTwoJointIntegrand α u (f 3) q ∂μ := by
      rw [hfirstSquare, hsecondSquare]
    _ = modelEnergyOne α S u f * modelEnergyTwo α S u (f 3) := by
      rw [← henergyOne, ← henergyTwo]


/-- A finite collection has finite center--scale measure. -/
theorem isFiniteMeasure_cubeScaleCollection
    (α : Anisotropy) (S : BoxCollection α) :
    IsFiniteMeasure (cubeScaleMeasure.restrict (collectionRegion α S)) := by
  constructor
  rw [Measure.restrict_apply_univ]
  have hcell (q : AnisoBox α) :
      cubeScaleMeasure (boxScaleRegion α q) < ∞ := by
    rw [← Measure.restrict_apply_univ,
      cubeScaleMeasure_restrict_boxScaleRegion]
    letI : IsFiniteMeasure
        ((volume.restrict (boxSet α q)).prod
          ((volume.withDensity cubeScaleDensity).restrict (boxScaleBand q))) :=
      isFiniteMeasure_boxScaleCell α q
    exact IsFiniteMeasure.measure_univ_lt_top
  rw [collectionRegion,
    MeasureTheory.measure_biUnion_finset
      (pairwiseDisjoint_boxScaleRegion α S)
      (fun q hq ↦ measurableSet_boxScaleRegion α q)]
  exact ENNReal.sum_lt_top.mpr fun q hq ↦ hcell q

/-- The literal positive local-model density is jointly integrable over every
finite box collection. -/
theorem integrable_modelEnergyDensity_collection
    (α : Anisotropy) (S : BoxCollection α) (u : E3) :
    Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)) := by
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  letI : IsFiniteMeasure μ := by
    dsimp only [μ]
    exact isFiniteMeasure_cubeScaleCollection α S
  letI : SigmaFinite μ := IsFiniteMeasure.toSigmaFinite μ
  letI : SFinite (μ.prod (volume : Measure ModelE5)) := by
    infer_instance
  have hpos : ∀ᵐ pt ∂μ, 0 < pt.2 := by
    dsimp only [μ]
    filter_upwards [ae_restrict_mem (measurableSet_collectionRegion α S)]
      with pt hpt
    exact pos_of_mem_closure_collectionRegion α S (subset_closure hpt)
  have hmeas : AEStronglyMeasurable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyDensity α u q.1.1 q.1.2 q.2) (μ.prod volume) :=
    aestronglyMeasurable_modelEnergyDensity α u (μ.prod volume)
  apply (integrable_prod_iff hmeas).mpr
  constructor
  · filter_upwards [hpos] with pt hpt
    exact integrable_modelEnergyDensity α u pt.1 hpt
  · let K : ℝ := (∫ x : ℝ, |conePhiPhysicalReal x|) ^ 2 *
      conePsiPhysicalRealL1
    have hconst : Integrable (fun _ : E3 × ℝ ↦ K) μ := integrable_const _
    refine hconst.congr ?_
    filter_upwards [hpos] with pt hpt
    change K = (∫ z : ModelE5,
      ‖modelEnergyDensity α u pt.1 pt.2 z‖)
    symm
    have hnonneg : ∀ z : ModelE5,
        0 ≤ modelEnergyDensity α u pt.1 pt.2 z :=
      fun z ↦ modelEnergyDensity_nonneg α u pt.1 hpt.le z
    rw [show (fun z : ModelE5 ↦
      ‖modelEnergyDensity α u pt.1 pt.2 z‖) =
        modelEnergyDensity α u pt.1 pt.2 by
      funext z
      rw [Real.norm_eq_abs, abs_of_nonneg (hnonneg z)]]
    exact integral_modelEnergyDensity α u pt.1 hpt

/-- All measurability premises of the literal local Cauchy--Schwarz step
follow from continuous inputs and a measurable multiplier. -/
theorem expandedModelLocalForm_cauchySchwarz_of_continuous_weighted
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (hcmeas : Measurable c)
    (hfcont : ∀ j, Continuous (f j))
    (hfirstint : Integrable
      (fun q ↦ (modelFirstWeightedFactor α u f q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hsecondint : Integrable
      (fun q ↦ (modelSecondWeightedFactor α u (f 3) q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    |expandedModelLocalForm α S u c f| ^ 2 ≤
      modelEnergyOne α S u f * modelEnergyTwo α S u (f 3) := by
  exact expandedModelLocalForm_cauchySchwarz_of_weightedIntegrable
    α S u c f
    (aestronglyMeasurable_modelSignedIntegrand α u c f hcmeas hfcont
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume))
    (aestronglyMeasurable_modelFirstWeightedFactor α u f hfcont
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume))
    (aestronglyMeasurable_modelSecondWeightedFactor α u (f 3)
      (hfcont 3) ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume))
    hfirstint hsecondint hc

/-- Bounded continuous inputs turn joint density integrability into the
square-integrability demanded by the literal first local Cauchy--Schwarz
argument. -/
theorem expandedModelLocalForm_cauchySchwarz_of_boundedContinuous_of_density
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (hcmeas : Measurable c)
    (hfcont : ∀ j, Continuous (f j))
    (B0 B1 B2 B3 : ℝ)
    (hB0 : 0 ≤ B0) (hB1 : 0 ≤ B1) (hB2 : 0 ≤ B2) (hB3 : 0 ≤ B3)
    (hf0 : ∀ y, |f 0 y| ≤ B0) (hf1 : ∀ y, |f 1 y| ≤ B1)
    (hf2 : ∀ y, |f 2 y| ≤ B2) (hf3 : ∀ y, |f 3 y| ≤ B3)
    (hweightint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    |expandedModelLocalForm α S u c f| ^ 2 ≤
      modelEnergyOne α S u f * modelEnergyTwo α S u (f 3) := by
  apply expandedModelLocalForm_cauchySchwarz_of_continuous_weighted
    α S u c f hcmeas hfcont
  · exact integrable_modelFirstWeightedFactor_sq_of_density
      α S u f hfcont B0 B1 B2 hB0 hB1 hB2 hf0 hf1 hf2 hweightint
  · exact integrable_modelSecondWeightedFactor_sq_of_density
      α S u (f 3) (hfcont 3) B3 hB3 hf3 hweightint
  · exact hc

/-- The usual existential uniform bounds are sufficient for the local
Cauchy--Schwarz conclusion once the positive density has been localized. -/
theorem expandedModelLocalForm_cauchySchwarz_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (hcmeas : Measurable c)
    (hfcont : ∀ j, Continuous (f j))
    (hfbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hweightint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    |expandedModelLocalForm α S u c f| ^ 2 ≤
      modelEnergyOne α S u f * modelEnergyTwo α S u (f 3) := by
  rcases hfbound 0 with ⟨B0, hB0, hf0⟩
  rcases hfbound 1 with ⟨B1, hB1, hf1⟩
  rcases hfbound 2 with ⟨B2, hB2, hf2⟩
  rcases hfbound 3 with ⟨B3, hB3, hf3⟩
  exact expandedModelLocalForm_cauchySchwarz_of_boundedContinuous_of_density
    α S u c f hcmeas hfcont B0 B1 B2 B3 hB0 hB1 hB2 hB3
      hf0 hf1 hf2 hf3 hweightint hc

/-- The first literal local Cauchy--Schwarz inequality, with the joint
positive-density localization supplied by the finite collection. -/
theorem expandedModelLocalForm_cauchySchwarz_of_boundedContinuous_local
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (hcmeas : Measurable c)
    (hfcont : ∀ j, Continuous (f j))
    (hfbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    |expandedModelLocalForm α S u c f| ^ 2 ≤
      modelEnergyOne α S u f * modelEnergyTwo α S u (f 3) := by
  exact expandedModelLocalForm_cauchySchwarz_of_boundedContinuous
    α S u c f hcmeas hfcont hfbound
      (integrable_modelEnergyDensity_collection α S u) hc


/-- The reciprocal-exponent inequalities needed by the extended model
estimate in the source blueprint. -/
def ExtendedModelRegion (β0 β1 β2 β3 : ℝ) : Prop :=
  0 < β0 ∧ 0 < β1 ∧ 0 < β2 ∧ 0 < β3 ∧
    β0 + β1 + β2 + β3 = 1 ∧
    β0 < 1 / 4 ∧ β3 > 1 / 4 ∧
    β1 + β2 > 1 / 4 ∧ β1 + β3 > 1 / 2 ∧ β2 + β3 > 1 / 2

/-- The final theorem's reciprocal inequalities imply the extended-model
region after choosing any active coordinate.  This is the arithmetic used in
the last paragraph of the blueprint. -/
theorem extendedModelRegion_of_mainInequalities
    {β0 β1 β2 β3 : ℝ}
    (hβ0 : 0 < β0) (hβ1 : 1 / 4 < β1) (hβ2 : 1 / 4 < β2)
    (hβ3 : 1 / 4 < β3)
    (hsum : β0 + β1 + β2 + β3 = 1) (hzero : β0 < 1 / 4) :
    ExtendedModelRegion β0 β1 β2 β3 := by
  refine ⟨hβ0, lt_trans (by norm_num) hβ1, lt_trans (by norm_num) hβ2,
    lt_trans (by norm_num) hβ3, hsum, hzero, hβ3, ?_, ?_, ?_⟩ <;> linarith

/-- The capped reciprocal sum in the simplex argument is strictly larger
than three quarters throughout the extended region. -/
theorem cappedExponentSum_gt_three_quarters
    {β0 β1 β2 β3 : ℝ}
    (h : ExtendedModelRegion β0 β1 β2 β3) :
    3 / 4 < min β1 (1 / 4) + min β2 (1 / 4) + min β3 (1 / 2) := by
  rcases h with ⟨h0, h1, h2, h3, hsum, h0small, h3large,
    h12, h13, h23⟩
  by_cases h1cap : β1 ≤ 1 / 4
  · rw [min_eq_left h1cap]
    by_cases h2cap : β2 ≤ 1 / 4
    · rw [min_eq_left h2cap]
      by_cases h3cap : β3 ≤ 1 / 2
      · rw [min_eq_left h3cap]
        linarith
      · rw [min_eq_right (le_of_lt (lt_of_not_ge h3cap))]
        linarith
    · rw [min_eq_right (le_of_lt (lt_of_not_ge h2cap))]
      by_cases h3cap : β3 ≤ 1 / 2
      · rw [min_eq_left h3cap]
        linarith
      · rw [min_eq_right (le_of_lt (lt_of_not_ge h3cap))]
        linarith
  · rw [min_eq_right (le_of_lt (lt_of_not_ge h1cap))]
    by_cases h2cap : β2 ≤ 1 / 4
    · rw [min_eq_left h2cap]
      by_cases h3cap : β3 ≤ 1 / 2
      · rw [min_eq_left h3cap]
        linarith
      · rw [min_eq_right (le_of_lt (lt_of_not_ge h3cap))]
        linarith
    · rw [min_eq_right (le_of_lt (lt_of_not_ge h2cap))]
      by_cases h3cap : β3 ≤ 1 / 2
      · rw [min_eq_left h3cap]
        linarith
      · rw [min_eq_right (le_of_lt (lt_of_not_ge h3cap))]
        linarith

/-- The four reciprocal exponents used as the vertices of the interpolation
simplex in the extended-model argument. -/
structure ExponentSimplex (β0 β1 β2 β3 : ℝ) where
  b0 : ℝ
  b1 : ℝ
  b2 : ℝ
  b3 : ℝ
  b0_pos : 0 < b0
  b0_gt : β0 < b0
  b0_lt_quarter : b0 < 1 / 4
  b1_pos : 0 < b1
  b1_lt : b1 < β1
  b1_lt_quarter : b1 < 1 / 4
  b2_pos : 0 < b2
  b2_lt : b2 < β2
  b2_lt_quarter : b2 < 1 / 4
  b3_pos : 0 < b3
  b3_lt : b3 < β3
  b3_gt_quarter : 1 / 4 < b3
  b3_lt_half : b3 < 1 / 2
  sum_eq_one : b0 + b1 + b2 + b3 = 1
  beta0_pos : 0 < β0
  beta_sum_eq_one : β0 + β1 + β2 + β3 = 1

/-- Every point in the extended region has the strictly interior simplex
used by the four endpoint estimates. -/
theorem exists_exponentSimplex
    {β0 β1 β2 β3 : ℝ}
    (h : ExtendedModelRegion β0 β1 β2 β3) :
    Nonempty (ExponentSimplex β0 β1 β2 β3) := by
  rcases h with ⟨h0, h1, h2, h3, hsum, h0small, h3large,
    h12, h13, h23⟩
  let c1 : ℝ := min β1 (1 / 4)
  let c2 : ℝ := min β2 (1 / 4)
  let c3 : ℝ := min β3 (1 / 2)
  let S : ℝ := c1 + c2 + c3
  have hc1pos : 0 < c1 := by
    dsimp [c1]
    exact lt_min h1 (by norm_num)
  have hc2pos : 0 < c2 := by
    dsimp [c2]
    exact lt_min h2 (by norm_num)
  have hc3pos : 0 < c3 := by
    dsimp [c3]
    exact lt_min h3 (by norm_num)
  have hSgt : 3 / 4 < S := by
    dsimp [S, c1, c2, c3]
    exact cappedExponentSum_gt_three_quarters
      ⟨h0, h1, h2, h3, hsum, h0small, h3large, h12, h13, h23⟩
  have hc1le : c1 ≤ β1 := by
    dsimp [c1]
    exact min_le_left _ _
  have hc2le : c2 ≤ β2 := by
    dsimp [c2]
    exact min_le_left _ _
  have hc3le : c3 ≤ β3 := by
    dsimp [c3]
    exact min_le_left _ _
  have hSlt : S < 1 := by
    dsimp [S]
    linarith
  let δ : ℝ := min c1 (min c2 (min c3 ((S - 3 / 4) / 3)))
  have hδpos : 0 < δ := by
    dsimp [δ]
    refine lt_min hc1pos ?_
    refine lt_min hc2pos ?_
    refine lt_min hc3pos ?_
    linarith
  let ε : ℝ := δ / 2
  have hεpos : 0 < ε := by
    dsimp [ε]
    linarith
  have hεc1 : ε < c1 := by
    have hδc1 : δ ≤ c1 := by
      dsimp [δ]
      exact min_le_left _ _
    dsimp [ε]
    linarith
  have hεc2 : ε < c2 := by
    have hδc2 : δ ≤ c2 := by
      dsimp [δ]
      exact le_trans (min_le_right _ _) (min_le_left _ _)
    dsimp [ε]
    linarith
  have hεc3 : ε < c3 := by
    have hδc3 : δ ≤ c3 := by
      dsimp [δ]
      exact le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
    dsimp [ε]
    linarith
  have hthreeε : 3 * ε < S - 3 / 4 := by
    have hδgap : δ ≤ (S - 3 / 4) / 3 := by
      dsimp [δ]
      exact le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _))
    dsimp [ε]
    linarith
  let b1 : ℝ := c1 - ε
  let b2 : ℝ := c2 - ε
  let b3 : ℝ := c3 - ε
  let b0 : ℝ := 1 - (b1 + b2 + b3)
  have hb1pos : 0 < b1 := by dsimp [b1]; linarith
  have hb2pos : 0 < b2 := by dsimp [b2]; linarith
  have hb3pos : 0 < b3 := by dsimp [b3]; linarith
  have hsum_b123 : b1 + b2 + b3 = S - 3 * ε := by
    dsimp [b1, b2, b3, S]
    ring
  have hb0eq : b0 = 1 - S + 3 * ε := by
    dsimp [b0]
    rw [hsum_b123]
    ring
  have hb0gt : β0 < b0 := by
    rw [hb0eq]
    linarith
  have hb0lt : b0 < 1 / 4 := by
    rw [hb0eq]
    linarith
  have hb0pos : 0 < b0 := by linarith
  have hb1lt : b1 < β1 := by
    dsimp [b1]
    linarith
  have hb1quarter : b1 < 1 / 4 := by
    have hc1quarter : c1 ≤ 1 / 4 := by
      dsimp [c1]
      exact min_le_right _ _
    dsimp [b1]
    linarith
  have hb2lt : b2 < β2 := by
    dsimp [b2]
    linarith
  have hb2quarter : b2 < 1 / 4 := by
    have hc2quarter : c2 ≤ 1 / 4 := by
      dsimp [c2]
      exact min_le_right _ _
    dsimp [b2]
    linarith
  have hb3lt : b3 < β3 := by
    dsimp [b3]
    linarith
  have hb3half : b3 < 1 / 2 := by
    have hc3half : c3 ≤ 1 / 2 := by
      dsimp [c3]
      exact min_le_right _ _
    dsimp [b3]
    linarith
  have hsum_b0 : b0 + b1 + b2 + b3 = 1 := by
    dsimp [b0]
    ring
  have hb3quarter : 1 / 4 < b3 := by
    linarith
  exact ⟨⟨b0, b1, b2, b3, hb0pos, hb0gt, hb0lt,
    hb1pos, hb1lt, hb1quarter, hb2pos, hb2lt, hb2quarter,
    hb3pos, hb3lt, hb3quarter, hb3half, hsum_b0, h0, hsum⟩⟩

/-- The four strictly positive barycentric weights associated to an interior
simplex point.  The displayed identities are exactly the four interpolation
vertices `b`, `b + b₀ e₁`, `b + b₀ e₂`, and `b + b₀ e₃`. -/
theorem exponentSimplex_has_barycentricWeights
    {β0 β1 β2 β3 : ℝ} (b : ExponentSimplex β0 β1 β2 β3) :
    ∃ θ0 θ1 θ2 θ3 : ℝ,
      0 < θ0 ∧ 0 < θ1 ∧ 0 < θ2 ∧ 0 < θ3 ∧
      θ0 + θ1 + θ2 + θ3 = 1 ∧
      β0 = θ0 * b.b0 ∧
      β1 = θ0 * b.b1 + θ1 * (b.b1 + b.b0) + θ2 * b.b1 + θ3 * b.b1 ∧
      β2 = θ0 * b.b2 + θ1 * b.b2 + θ2 * (b.b2 + b.b0) + θ3 * b.b2 ∧
      β3 = θ0 * b.b3 + θ1 * b.b3 + θ2 * b.b3 + θ3 * (b.b3 + b.b0) ∧
      1 - β0 = θ0 * (1 - b.b0) + θ1 + θ2 + θ3 := by
  let θ0 : ℝ := β0 / b.b0
  let θ1 : ℝ := (β1 - b.b1) / b.b0
  let θ2 : ℝ := (β2 - b.b2) / b.b0
  let θ3 : ℝ := (β3 - b.b3) / b.b0
  have hb0ne : b.b0 ≠ 0 := ne_of_gt b.b0_pos
  have hθ0 : 0 < θ0 := by
    dsimp [θ0]
    exact div_pos b.beta0_pos b.b0_pos
  have hθ1 : 0 < θ1 := by
    dsimp [θ1]
    exact div_pos (sub_pos.mpr b.b1_lt) b.b0_pos
  have hθ2 : 0 < θ2 := by
    dsimp [θ2]
    exact div_pos (sub_pos.mpr b.b2_lt) b.b0_pos
  have hθ3 : 0 < θ3 := by
    dsimp [θ3]
    exact div_pos (sub_pos.mpr b.b3_lt) b.b0_pos
  have hnum : β0 + (β1 - b.b1) + (β2 - b.b2) + (β3 - b.b3) = b.b0 := by
    linarith [b.sum_eq_one, b.beta_sum_eq_one]
  refine ⟨θ0, θ1, θ2, θ3, hθ0, hθ1, hθ2, hθ3, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · dsimp [θ0, θ1, θ2, θ3]
    field_simp
    exact hnum
  · dsimp [θ0]
    field_simp
  · dsimp [θ0, θ1, θ2, θ3]
    field_simp
    linear_combination -b.b1 * hnum
  · dsimp [θ0, θ1, θ2, θ3]
    field_simp
    linear_combination -b.b2 * hnum
  · dsimp [θ0, θ1, θ2, θ3]
    field_simp
    linear_combination -b.b3 * hnum
  · dsimp [θ0, θ1, θ2, θ3]
    field_simp
    linarith [b.sum_eq_one, b.beta_sum_eq_one]


/-- A square-form local estimate and two nonnegative energy estimates combine
without choosing square roots of the implicit constants. -/
theorem abs_le_of_square_energy_bounds
    {L E₁ E₂ A B C₁ C₂ : ℝ}
    (hcs : |L| ^ 2 ≤ E₁ * E₂)
    (hE₁ : 0 ≤ E₁) (hE₂ : 0 ≤ E₂)
    (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hC₁ : 0 ≤ C₁) (hC₂ : 0 ≤ C₂)
    (hbound₁ : E₁ ≤ C₁ * A ^ 2)
    (hbound₂ : E₂ ≤ C₂ * B ^ 2) :
    |L| ≤ (C₁ * C₂ + 1) * A * B := by
  have hC : 0 ≤ C₁ * C₂ := mul_nonneg hC₁ hC₂
  have hAB : 0 ≤ A * B := mul_nonneg hA hB
  have hright : 0 ≤ (C₁ * C₂ + 1) * A * B := by positivity
  have hfirstBound : 0 ≤ C₁ * A ^ 2 :=
    mul_nonneg hC₁ (sq_nonneg A)
  have hsecondBound : 0 ≤ C₂ * B ^ 2 :=
    mul_nonneg hC₂ (sq_nonneg B)
  have hprod : E₁ * E₂ ≤ (C₁ * A ^ 2) * (C₂ * B ^ 2) := by
    exact mul_le_mul hbound₁ hbound₂ hE₂ hfirstBound
  have hcoeff : C₁ * C₂ ≤ (C₁ * C₂ + 1) ^ 2 := by nlinarith
  have hsq : |L| ^ 2 ≤ ((C₁ * C₂ + 1) * A * B) ^ 2 := by
    calc
      |L| ^ 2 ≤ E₁ * E₂ := hcs
      _ ≤ (C₁ * A ^ 2) * (C₂ * B ^ 2) := hprod
      _ = (C₁ * C₂) * (A * B) ^ 2 := by ring
      _ ≤ (C₁ * C₂ + 1) ^ 2 * (A * B) ^ 2 :=
        mul_le_mul_of_nonneg_right hcoeff (sq_nonneg _)
      _ = ((C₁ * C₂ + 1) * A * B) ^ 2 := by ring
  exact (sq_le_sq₀ (abs_nonneg L) hright).mp hsq


/-- The exponent hypotheses in `thm:main` imply the reciprocal region used
by the extended model theorem in the active third coordinate. -/
theorem mainExponentRegion
    {p0 p1 p2 p3 : ℝ}
    (hp0 : 4 < p0)
    (hp1low : 1 < p1) (hp1high : p1 < 4)
    (hp2low : 1 < p2) (hp2high : p2 < 4)
    (hp3low : 1 < p3) (hp3high : p3 < 4)
    (hsum : p0⁻¹ + p1⁻¹ + p2⁻¹ + p3⁻¹ = 1) :
    ExtendedModelRegion p0⁻¹ p1⁻¹ p2⁻¹ p3⁻¹ := by
  have hp0pos : 0 < p0 := by linarith
  have hp1pos : 0 < p1 := by linarith
  have hp2pos : 0 < p2 := by linarith
  have hp3pos : 0 < p3 := by linarith
  have h0small : p0⁻¹ < 1 / 4 := by
    simpa [one_div] using
      (one_div_lt_one_div_of_lt (show (0 : ℝ) < 4 by norm_num) hp0)
  have h1large : 1 / 4 < p1⁻¹ := by
    simpa [one_div] using one_div_lt_one_div_of_lt hp1pos hp1high
  have h2large : 1 / 4 < p2⁻¹ := by
    simpa [one_div] using one_div_lt_one_div_of_lt hp2pos hp2high
  have h3large : 1 / 4 < p3⁻¹ := by
    simpa [one_div] using one_div_lt_one_div_of_lt hp3pos hp3high
  exact extendedModelRegion_of_mainInequalities
    (inv_pos.mpr hp0pos) h1large h2large h3large hsum h0small

/-- The reciprocal region used by the extended model theorem is invariant
under relabeling the three active input coordinates. -/
theorem mainExponentRegion_permuted
    {p0 : ℝ} (p : Fin 3 → ℝ)
    (hp0 : 4 < p0)
    (hplow : ∀ i, 1 < p i) (hphigh : ∀ i, p i < 4)
    (hsum : p0⁻¹ + ∑ i : Fin 3, (p i)⁻¹ = 1)
    (σ : Equiv.Perm (Fin 3)) :
    ExtendedModelRegion p0⁻¹ (p (σ 0))⁻¹ (p (σ 1))⁻¹ (p (σ 2))⁻¹ := by
  have hp0pos : 0 < p0 := by linarith
  have h0small : p0⁻¹ < 1 / 4 := by
    simpa [one_div] using
      (one_div_lt_one_div_of_lt (show (0 : ℝ) < 4 by norm_num) hp0)
  have hlarge (i : Fin 3) : 1 / 4 < (p i)⁻¹ := by
    have hpos : 0 < p i := by linarith [hplow i]
    simpa [one_div] using one_div_lt_one_div_of_lt hpos (hphigh i)
  have hsum' : p0⁻¹ + (p (σ 0))⁻¹ + (p (σ 1))⁻¹ +
      (p (σ 2))⁻¹ = 1 := by
    calc
      p0⁻¹ + (p (σ 0))⁻¹ + (p (σ 1))⁻¹ + (p (σ 2))⁻¹ =
          p0⁻¹ + ∑ i : Fin 3, (p (σ i))⁻¹ := by
            simp [Fin.sum_univ_three]
            ring
      _ = p0⁻¹ + ∑ i : Fin 3, (p i)⁻¹ := by
        congr 1
        exact Equiv.sum_comp σ (fun i ↦ (p i)⁻¹)
      _ = 1 := hsum
  exact extendedModelRegion_of_mainInequalities
    (inv_pos.mpr hp0pos) (hlarge (σ 0)) (hlarge (σ 1))
    (hlarge (σ 2)) hsum' h0small


/-- The one-dimensional Calderón mass of the source-normalized Gaussian
derivative.  This is the scalar constant behind the factor `π / α₃` in the
fiber square-function identity. -/
theorem integral_gaussianDeriv_sq_div_Ioi :
    ∫ x : ℝ in Set.Ioi (0 : ℝ), gaussianDeriv x ^ 2 / x = Real.pi := by
  let P : ℝ → ℝ := fun x ↦ -Real.pi * Real.exp (-2 * Real.pi * x ^ 2)
  have hmatch (x : ℝ) :
      gaussianDeriv x ^ 2 / x =
        4 * Real.pi ^ 2 * (x * Real.exp (-(2 * Real.pi) * x ^ 2)) := by
    by_cases hx : x = 0
    · subst x
      simp [gaussianDeriv]
    · have hexp : Real.exp (-Real.pi * x ^ 2) ^ 2 =
        Real.exp (-(2 * Real.pi) * x ^ 2) := by
        rw [← Real.exp_nat_mul]
        congr 1
        ring
      simp only [gaussianDeriv, gaussian]
      calc
        (-2 * Real.pi * x * Real.exp (-Real.pi * x ^ 2)) ^ 2 / x =
            ((-2 * Real.pi * x) ^ 2 * Real.exp (-Real.pi * x ^ 2) ^ 2) / x := by
              ring
        _ = 4 * Real.pi ^ 2 * (x * Real.exp (-(2 * Real.pi) * x ^ 2)) := by
              rw [hexp]
              field_simp [hx]
              ring
  have hderiv (x : ℝ) : HasDerivAt P (gaussianDeriv x ^ 2 / x) x := by
    have hpow : HasDerivAt (fun y : ℝ ↦ y ^ 2) (2 * x) x := by
      simpa [pow_two, two_mul] using (hasDerivAt_pow 2 x)
    have hinner : HasDerivAt (fun y : ℝ ↦ -2 * Real.pi * y ^ 2)
        (-4 * Real.pi * x) x := by
      convert! HasDerivAt.const_mul (-2 * Real.pi) hpow using 1
      all_goals ring
    have hP : HasDerivAt P
        ((-Real.pi) * (Real.exp (-2 * Real.pi * x ^ 2) *
          (-4 * Real.pi * x))) x := by
      exact (Real.hasDerivAt_exp (-2 * Real.pi * x ^ 2)).comp x hinner |>.const_mul
        (-Real.pi)
    have hcoef : (-Real.pi) * (Real.exp (-2 * Real.pi * x ^ 2) *
        (-4 * Real.pi * x)) = gaussianDeriv x ^ 2 / x := by
      rw [show -2 * Real.pi * x ^ 2 = -(2 * Real.pi) * x ^ 2 by ring]
      rw [hmatch]
      ring
    rwa [hcoef] at hP
  have hint : Integrable (fun x : ℝ ↦
      4 * Real.pi ^ 2 * (x * Real.exp (-(2 * Real.pi) * x ^ 2))) := by
    convert
      (integrable_mul_exp_neg_mul_sq (show 0 < 2 * Real.pi by positivity)).const_mul
        (4 * Real.pi ^ 2) using 1
  have hlim : Tendsto P atTop (nhds (0 : ℝ)) := by
    have he : Tendsto (fun x : ℝ ↦ Real.exp (-2 * Real.pi * x ^ 2)) atTop
        (nhds (0 : ℝ)) :=
      Real.tendsto_exp_atBot.comp
        ((tendsto_pow_atTop two_ne_zero).const_mul_atTop_of_neg
          (by nlinarith [Real.pi_pos] : -2 * Real.pi < 0))
    simpa [P, neg_mul] using
      ((tendsto_const_nhds : Tendsto (fun _ : ℝ ↦ -Real.pi) atTop
        (nhds (-Real.pi))).mul he)
  have hderivIoi : ∀ x ∈ Set.Ici (0 : ℝ),
      HasDerivAt P (gaussianDeriv x ^ 2 / x) x := fun x _ ↦ hderiv x
  have hcalc := integral_Ioi_of_hasDerivAt_of_tendsto'
    hderivIoi (hint.congr (Filter.Eventually.of_forall fun x ↦ (hmatch x).symm)).integrableOn
    hlim
  convert hcalc using 1
  all_goals simp [P]

/-- Dilation of the one-dimensional Calderón density has the same mass at
every positive frequency. -/
theorem integral_gaussianDeriv_sq_div_mul_Ioi
    (ξ : ℝ) (hξ : 0 < ξ) :
    ∫ s : ℝ in Set.Ioi (0 : ℝ), gaussianDeriv (s * ξ) ^ 2 / s = Real.pi := by
  let k : ℝ → ℝ := fun r ↦ gaussianDeriv r ^ 2 / r
  have hpoint (s : ℝ) (hs : s ∈ Set.Ioi (0 : ℝ)) :
      gaussianDeriv (s * ξ) ^ 2 / s = ξ * k (ξ * s) := by
    dsimp [k]
    rw [mul_comm s ξ]
    field_simp [hξ.ne']
  calc
    ∫ s : ℝ in Set.Ioi (0 : ℝ), gaussianDeriv (s * ξ) ^ 2 / s =
        ∫ s : ℝ in Set.Ioi (0 : ℝ), ξ * k (ξ * s) := by
          apply setIntegral_congr_fun measurableSet_Ioi
          intro s hs
          exact hpoint s hs
    _ = ξ * ∫ s : ℝ in Set.Ioi (0 : ℝ), k (ξ * s) := by
      rw [← integral_const_mul]
    _ = ξ * (ξ⁻¹ * ∫ r : ℝ in Set.Ioi (0 : ℝ), k r) := by
      rw [integral_comp_mul_left_Ioi k 0 hξ]
      simp [smul_eq_mul]
    _ = Real.pi := by
      rw [show (∫ r : ℝ in Set.Ioi (0 : ℝ), k r) = Real.pi by
        exact integral_gaussianDeriv_sq_div_Ioi]
      field_simp

/-- The power-change-of-variables form of the Calderón identity.  It is the
exact scalar formula before rewriting the Jacobian as the scale density
`dt / t`. -/
theorem integral_gaussianDeriv_sq_rpow_weighted_Ioi
    (p ξ : ℝ) (hp : 0 < p) (hξ : 0 < ξ) :
    ∫ t : ℝ in Set.Ioi (0 : ℝ),
      (p * t ^ (p - 1)) * (gaussianDeriv (t ^ p * ξ) ^ 2 / t ^ p) =
        Real.pi := by
  let g : ℝ → ℝ := fun s ↦ gaussianDeriv (s * ξ) ^ 2 / s
  calc
    ∫ t : ℝ in Set.Ioi (0 : ℝ),
        (p * t ^ (p - 1)) * (gaussianDeriv (t ^ p * ξ) ^ 2 / t ^ p) =
        ∫ t : ℝ in Set.Ioi (0 : ℝ), (p * t ^ (p - 1)) • g (t ^ p) := by
          apply setIntegral_congr_fun measurableSet_Ioi
          intro t ht
          simp [g, smul_eq_mul]
    _ = ∫ s : ℝ in Set.Ioi (0 : ℝ), g s :=
      integral_comp_rpow_Ioi_of_pos hp
    _ = Real.pi := integral_gaussianDeriv_sq_div_mul_Ioi ξ hξ

/-- In the natural-power convention used by `Anisotropy`, the preceding
identity becomes the `dt/t` Calderón mass `π / n`. -/
theorem integral_gaussianDeriv_sq_nat_scale_Ioi
    (n : ℕ) (hn : 0 < n) (ξ : ℝ) (hξ : 0 < ξ) :
    ∫ t : ℝ in Set.Ioi (0 : ℝ),
      gaussianDeriv (t ^ n * ξ) ^ 2 / t = Real.pi / (n : ℝ) := by
  let N : ℝ := n
  have hN : 0 < N := by
    simpa [N] using (Nat.cast_pos.mpr hn : (0 : ℝ) < n)
  have hweighted := integral_gaussianDeriv_sq_rpow_weighted_Ioi
    N ξ hN hξ
  have hpoint (t : ℝ) (ht : t ∈ Set.Ioi (0 : ℝ)) :
      (N * t ^ (N - 1)) * (gaussianDeriv (t ^ N * ξ) ^ 2 / t ^ N) =
        N * (gaussianDeriv (t ^ n * ξ) ^ 2 / t) := by
    have htpos : 0 < t := ht
    have hratio : t ^ (N - 1) / t ^ N = t⁻¹ := by
      calc
        t ^ (N - 1) / t ^ N = t ^ ((N - 1) - N) :=
          (Real.rpow_sub htpos _ _).symm
        _ = t ^ (-1 : ℝ) := by congr 1; ring
        _ = t⁻¹ := by rw [Real.rpow_neg htpos.le, Real.rpow_one]
    calc
      (N * t ^ (N - 1)) * (gaussianDeriv (t ^ N * ξ) ^ 2 / t ^ N) =
          (N * gaussianDeriv (t ^ N * ξ) ^ 2) * (t ^ (N - 1) / t ^ N) := by
            ring
      _ = (N * gaussianDeriv (t ^ N * ξ) ^ 2) * t⁻¹ := by rw [hratio]
      _ = N * (gaussianDeriv (t ^ N * ξ) ^ 2 / t) := by
            field_simp [htpos.ne']
      _ = N * (gaussianDeriv (t ^ n * ξ) ^ 2 / t) := by
            rw [Real.rpow_natCast]
  have hmul : N * (∫ t : ℝ in Set.Ioi (0 : ℝ),
      gaussianDeriv (t ^ n * ξ) ^ 2 / t) = Real.pi := by
    calc
      N * (∫ t : ℝ in Set.Ioi (0 : ℝ),
          gaussianDeriv (t ^ n * ξ) ^ 2 / t) =
          ∫ t : ℝ in Set.Ioi (0 : ℝ),
            N * (gaussianDeriv (t ^ n * ξ) ^ 2 / t) := by
              rw [integral_const_mul]
      _ = ∫ t : ℝ in Set.Ioi (0 : ℝ),
          (N * t ^ (N - 1)) *
            (gaussianDeriv (t ^ N * ξ) ^ 2 / t ^ N) := by
              apply setIntegral_congr_fun measurableSet_Ioi
              intro t ht
              exact (hpoint t ht).symm
      _ = Real.pi := hweighted
  apply (eq_div_iff hN.ne').2
  simpa [mul_comm] using hmul

/-- The scalar Calderón mass is insensitive to the sign of the nonzero
frequency, as required for the Fourier-side square-function calculation. -/
theorem integral_gaussianDeriv_sq_nat_scale_Ioi_of_ne_zero
    (n : ℕ) (hn : 0 < n) (ξ : ℝ) (hξ : ξ ≠ 0) :
    ∫ t : ℝ in Set.Ioi (0 : ℝ),
      gaussianDeriv (t ^ n * ξ) ^ 2 / t = Real.pi / (n : ℝ) := by
  rcases lt_or_gt_of_ne hξ with hneg | hpos
  · have hpos' : 0 < -ξ := neg_pos.mpr hneg
    calc
      ∫ t : ℝ in Set.Ioi (0 : ℝ),
          gaussianDeriv (t ^ n * ξ) ^ 2 / t =
          ∫ t : ℝ in Set.Ioi (0 : ℝ),
            gaussianDeriv (t ^ n * (-ξ)) ^ 2 / t := by
              apply setIntegral_congr_fun measurableSet_Ioi
              intro t ht
              change gaussianDeriv (t ^ n * ξ) ^ 2 / t =
                gaussianDeriv (t ^ n * (-ξ)) ^ 2 / t
              rw [show t ^ n * (-ξ) = -(t ^ n * ξ) by ring,
                gaussianDeriv_neg]
              ring
      _ = Real.pi / (n : ℝ) :=
        integral_gaussianDeriv_sq_nat_scale_Ioi n hn (-ξ) hpos'
  · exact integral_gaussianDeriv_sq_nat_scale_Ioi n hn ξ hpos

/-- The exceptional zero frequency is null for Lebesgue measure, so the
Calderón mass holds almost everywhere on the Fourier side. -/
theorem ae_integral_gaussianDeriv_sq_nat_scale_Ioi
    (n : ℕ) (hn : 0 < n) :
    ∀ᵐ ξ : ℝ,
      ∫ t : ℝ in Set.Ioi (0 : ℝ),
        gaussianDeriv (t ^ n * ξ) ^ 2 / t = Real.pi / (n : ℝ) := by
  filter_upwards [show ∀ᵐ ξ : ℝ, ξ ≠ 0 by
    simp [ae_iff, measure_singleton]] with ξ hξ
  exact integral_gaussianDeriv_sq_nat_scale_Ioi_of_ne_zero n hn ξ hξ

/-- Abstract Fubini contraction for the scalar Calderón multiplier.  The
only analytic input is joint integrability; the Fourier calculation supplies
the almost-everywhere inner scale identity separately. -/
theorem calderon_fubini_of_ae_scale_mass
    (n : ℕ) (M : ℝ → ℝ)
    (hjoint : Integrable (fun q : ℝ × ℝ ↦
      M q.2 * (gaussianDeriv (q.1 ^ n * q.2) ^ 2 / q.1))
      ((volume.restrict (Set.Ioi (0 : ℝ))).prod volume))
    (hscale : ∀ᵐ ξ : ℝ,
      ∫ t : ℝ in Set.Ioi (0 : ℝ),
        gaussianDeriv (t ^ n * ξ) ^ 2 / t = Real.pi / (n : ℝ)) :
    ∫ t : ℝ in Set.Ioi (0 : ℝ),
      ∫ ξ : ℝ, M ξ * (gaussianDeriv (t ^ n * ξ) ^ 2 / t) =
        (Real.pi / (n : ℝ)) * ∫ ξ : ℝ, M ξ := by
  let K : ℝ → ℝ → ℝ := fun t ξ ↦
    M ξ * (gaussianDeriv (t ^ n * ξ) ^ 2 / t)
  have hK : Integrable (Function.uncurry K)
      ((volume.restrict (Set.Ioi (0 : ℝ))).prod volume) := by
    apply hjoint.congr
    filter_upwards [] with q
    rcases q with ⟨t, ξ⟩
    rfl
  have hinter : ∀ᵐ ξ : ℝ,
      (∫ t : ℝ in Set.Ioi (0 : ℝ), K t ξ) =
        M ξ * (Real.pi / (n : ℝ)) := by
    filter_upwards [hscale] with ξ hξ
    dsimp only [K]
    rw [integral_const_mul, hξ]
  change (∫ t : ℝ in Set.Ioi (0 : ℝ), ∫ ξ : ℝ, K t ξ) = _
  rw [integral_integral_swap hK]
  calc
    (∫ ξ : ℝ, ∫ t : ℝ in Set.Ioi (0 : ℝ), K t ξ) =
        ∫ ξ : ℝ, M ξ * (Real.pi / (n : ℝ)) :=
      integral_congr_ae hinter
    _ = (Real.pi / (n : ℝ)) * ∫ ξ : ℝ, M ξ := by
      rw [integral_mul_const]
      ring

/-- The one-dimensional square-function conclusion once fixed-scale
Plancherel has identified the fiber `L²` norm with its Fourier multiplier.
This isolates exactly the convolution/Plancherel extension from the
subsequent Tonelli and scalar calculations. -/
theorem fiberSquare_identity_of_fixedScalePlancherel
    (n : ℕ) (H : ℝ → ℝ → ℝ) (M : ℝ → ℝ)
    (hfixed : ∀ᵐ t : ℝ ∂(volume.restrict (Set.Ioi (0 : ℝ))),
      (∫ q : ℝ, H t q) =
        ∫ ξ : ℝ, M ξ * (gaussianDeriv (t ^ n * ξ) ^ 2 / t))
    (hjoint : Integrable (fun q : ℝ × ℝ ↦
      M q.2 * (gaussianDeriv (q.1 ^ n * q.2) ^ 2 / q.1))
      ((volume.restrict (Set.Ioi (0 : ℝ))).prod volume))
    (hscale : ∀ᵐ ξ : ℝ,
      ∫ t : ℝ in Set.Ioi (0 : ℝ),
        gaussianDeriv (t ^ n * ξ) ^ 2 / t = Real.pi / (n : ℝ)) :
    ∫ t : ℝ in Set.Ioi (0 : ℝ), ∫ q : ℝ, H t q =
      (Real.pi / (n : ℝ)) * ∫ ξ : ℝ, M ξ := by
  calc
    (∫ t : ℝ in Set.Ioi (0 : ℝ), ∫ q : ℝ, H t q) =
        ∫ t : ℝ in Set.Ioi (0 : ℝ),
          ∫ ξ : ℝ, M ξ * (gaussianDeriv (t ^ n * ξ) ^ 2 / t) :=
      integral_congr_ae hfixed
    _ = (Real.pi / (n : ℝ)) * ∫ ξ : ℝ, M ξ :=
      calderon_fubini_of_ae_scale_mass n M hjoint hscale

/-- A ready-to-use natural-power form of the preceding fiber square identity.
The scalar almost-everywhere multiplier calculation is now internal. -/
theorem fiberSquare_identity_of_fixedScalePlancherel_nat
    (n : ℕ) (hn : 0 < n) (H : ℝ → ℝ → ℝ) (M : ℝ → ℝ)
    (hfixed : ∀ᵐ t : ℝ ∂(volume.restrict (Set.Ioi (0 : ℝ))),
      (∫ q : ℝ, H t q) =
        ∫ ξ : ℝ, M ξ * (gaussianDeriv (t ^ n * ξ) ^ 2 / t))
    (hjoint : Integrable (fun q : ℝ × ℝ ↦
      M q.2 * (gaussianDeriv (q.1 ^ n * q.2) ^ 2 / q.1))
      ((volume.restrict (Set.Ioi (0 : ℝ))).prod volume)) :
    ∫ t : ℝ in Set.Ioi (0 : ℝ), ∫ q : ℝ, H t q =
      (Real.pi / (n : ℝ)) * ∫ ξ : ℝ, M ξ := by
  apply fiberSquare_identity_of_fixedScalePlancherel n H M hfixed hjoint
  exact ae_integral_gaussianDeriv_sq_nat_scale_Ioi n hn


/-- The finite ancestor family used in the stopping datum of Section 6. -/
noncomputable def stoppingAncestors
    (α : Anisotropy) (S : BoxCollection α) (q : AnisoBox α) :
    BoxCollection α := by
  classical
  exact S.filter fun r ↦ boxSet α q ⊆ boxSet α r

/-- The stopping datum `a(Q)`: the largest one-box local size among the
ancestors of `Q` which remain in the ambient finite collection. -/
noncomputable def stoppingData
    (α : Anisotropy) (S : BoxCollection α) (s : ℝ) (f : E3 → ℝ)
    (q : AnisoBox α) : ℝ :=
  if h : (stoppingAncestors α S q).Nonempty then
    (stoppingAncestors α S q).sup' h (boxLocalSize α s f)
  else 0

theorem mem_stoppingAncestors
    (α : Anisotropy) (S : BoxCollection α) {q : AnisoBox α}
    (hq : q ∈ S) : q ∈ stoppingAncestors α S q := by
  simp [stoppingAncestors, hq]

theorem stoppingAncestors_nonempty
    (α : Anisotropy) (S : BoxCollection α) {q : AnisoBox α}
    (hq : q ∈ S) : (stoppingAncestors α S q).Nonempty :=
  ⟨q, mem_stoppingAncestors α S hq⟩

theorem stoppingData_eq_sup'
    (α : Anisotropy) (S : BoxCollection α) (s : ℝ) (f : E3 → ℝ)
    {q : AnisoBox α} (hq : q ∈ S) :
    stoppingData α S s f q =
      (stoppingAncestors α S q).sup'
        (stoppingAncestors_nonempty α S hq) (boxLocalSize α s f) := by
  simp only [stoppingData]
  rw [dif_pos (stoppingAncestors_nonempty α S hq)]

theorem boxLocalSize_le_stoppingData
    (α : Anisotropy) (S : BoxCollection α) (s : ℝ) (f : E3 → ℝ)
    {q : AnisoBox α} (hq : q ∈ S) :
    boxLocalSize α s f q ≤ stoppingData α S s f q := by
  rw [stoppingData_eq_sup' α S s f hq]
  exact Finset.le_sup' (boxLocalSize α s f)
    (mem_stoppingAncestors α S hq)

theorem stoppingAncestors_antitone
    (α : Anisotropy) (S : BoxCollection α) {q r : AnisoBox α}
    (hqr : boxSet α q ⊆ boxSet α r) :
    stoppingAncestors α S r ⊆ stoppingAncestors α S q := by
  classical
  intro w hw
  rw [stoppingAncestors, Finset.mem_filter] at hw ⊢
  exact ⟨hw.1, hqr.trans hw.2⟩

/-- Ancestor maxima decrease as boxes get larger. -/
theorem stoppingData_antitone
    (α : Anisotropy) (S : BoxCollection α) (s : ℝ) (f : E3 → ℝ)
    {q r : AnisoBox α} (hq : q ∈ S) (hr : r ∈ S)
    (hqr : boxSet α q ⊆ boxSet α r) :
    stoppingData α S s f r ≤ stoppingData α S s f q := by
  rw [stoppingData_eq_sup' α S s f hq,
    stoppingData_eq_sup' α S s f hr]
  apply Finset.sup'_le
  intro w hw
  exact Finset.le_sup' (boxLocalSize α s f)
    (stoppingAncestors_antitone α S hqr hw)

/-- The finite dyadic stopping level indexed by a vector of integer levels.
It is exactly the source interval `(2^(n_j-1), 2^n_j]` applied to each
ancestor maximum. -/
noncomputable def stoppingLevel {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) : BoxCollection α := by
  classical
  exact S.filter fun q ↦ ∀ j,
    (2 : ℝ) ^ (n j - 1) < stoppingData α S (s j) (f j) q ∧
      stoppingData α S (s j) (f j) q ≤ (2 : ℝ) ^ n j

theorem mem_stoppingLevel_iff {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) (q : AnisoBox α) :
    q ∈ stoppingLevel α S s f n ↔ q ∈ S ∧ ∀ j,
      (2 : ℝ) ^ (n j - 1) < stoppingData α S (s j) (f j) q ∧
        stoppingData α S (s j) (f j) q ≤ (2 : ℝ) ^ n j := by
  simp [stoppingLevel]

/-- The maximal members of one finite stopping level. -/
noncomputable def stoppingRoots {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) : BoxCollection α := by
  classical
  let L := stoppingLevel α S s f n
  exact L.filter fun q ↦ ∀ r ∈ L, boxSet α q ⊆ boxSet α r → r = q

theorem mem_stoppingRoots_iff {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) (q : AnisoBox α) :
    q ∈ stoppingRoots α S s f n ↔
      q ∈ stoppingLevel α S s f n ∧
        ∀ r ∈ stoppingLevel α S s f n,
          boxSet α q ⊆ boxSet α r → r = q := by
  classical
  simp [stoppingRoots]

/-- The boxes of the stopping tree below one designated stopping root. -/
noncomputable def stoppingTreeBoxes {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) (Q : AnisoBox α) :
    BoxCollection α := by
  classical
  exact (stoppingLevel α S s f n).filter fun q ↦
    boxSet α q ⊆ boxSet α Q

theorem mem_stoppingTreeBoxes_iff {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ)
    (Q q : AnisoBox α) :
    q ∈ stoppingTreeBoxes α S s f n Q ↔
      q ∈ stoppingLevel α S s f n ∧ boxSet α q ⊆ boxSet α Q := by
  classical
  simp [stoppingTreeBoxes]

/-- Every member of a nonempty finite stopping level lies below a maximal
member of that same level. -/
theorem exists_stoppingRoot_above {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) {q : AnisoBox α}
    (hq : q ∈ stoppingLevel α S s f n) :
    ∃ Q ∈ stoppingRoots α S s f n, boxSet α q ⊆ boxSet α Q := by
  classical
  let L := stoppingLevel α S s f n
  let A := stoppingAncestors α L q
  have hqA : q ∈ A := by
    dsimp [A]
    exact mem_stoppingAncestors α L hq
  obtain ⟨Q, hQA, hmax⟩ := Finset.exists_max_image A AnisoBox.level ⟨q, hqA⟩
  have hQL : Q ∈ L := by
    dsimp [A, stoppingAncestors] at hQA
    exact (Finset.mem_filter.mp hQA).1
  have hqQ : boxSet α q ⊆ boxSet α Q := by
    dsimp [A, stoppingAncestors] at hQA
    exact (Finset.mem_filter.mp hQA).2
  have hQroot : Q ∈ stoppingRoots α S s f n := by
    rw [mem_stoppingRoots_iff]
    refine ⟨hQL, ?_⟩
    intro R hRL hQR
    have hRA : R ∈ A := by
      dsimp [A, stoppingAncestors]
      exact Finset.mem_filter.mpr ⟨hRL, hqQ.trans hQR⟩
    have hRQlevel : R.level ≤ Q.level := hmax R hRA
    have hQRlevel : Q.level ≤ R.level := level_le_of_boxSet_subset α hQR
    have hlevel : Q.level = R.level := le_antisymm hQRlevel hRQlevel
    by_contra hne
    have hdisj := boxSet_disjoint_of_eq_level_of_ne α hlevel (Ne.symm hne)
    obtain ⟨x, hx⟩ := boxSet_nonempty α Q
    exact (Set.disjoint_left.1 hdisj) hx (hQR hx)
  exact ⟨Q, hQroot, hqQ⟩

/-- Distinct stopping roots are spatially disjoint. -/
theorem pairwiseDisjoint_stoppingRoots {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) :
    (↑(stoppingRoots α S s f n) : Set (AnisoBox α)).PairwiseDisjoint
      (boxSet α) := by
  intro Q hQ R hR hne
  apply Set.disjoint_left.2
  intro x hxQ hxR
  rcases (mem_stoppingRoots_iff α S s f n Q).mp hQ with ⟨hQL, hQmax⟩
  rcases (mem_stoppingRoots_iff α S s f n R).mp hR with ⟨hRL, hRmax⟩
  rcases le_total Q.level R.level with hlevel | hlevel
  · have hQR : boxSet α Q ⊆ boxSet α R :=
      boxSet_nested_of_inter_nonempty α hlevel ⟨x, hxQ, hxR⟩
    exact hne (hQmax R hRL hQR).symm
  · have hRQ : boxSet α R ⊆ boxSet α Q :=
      boxSet_nested_of_inter_nonempty α hlevel ⟨x, hxR, hxQ⟩
    exact hne (hRmax Q hQL hRQ)

/-- Distinct stopping trees have no box in common. -/
theorem stoppingTreeBoxes_disjoint_of_ne {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ)
    (Q R : AnisoBox α) (hQ : Q ∈ stoppingRoots α S s f n)
    (hR : R ∈ stoppingRoots α S s f n) (hQR : Q ≠ R) :
    Disjoint (stoppingTreeBoxes α S s f n Q)
      (stoppingTreeBoxes α S s f n R) := by
  rw [Finset.disjoint_left]
  intro q hqQ hqR
  have hqQsub := (mem_stoppingTreeBoxes_iff α S s f n Q q).mp hqQ |>.2
  have hqRsub := (mem_stoppingTreeBoxes_iff α S s f n R q).mp hqR |>.2
  have hrootDisj : Disjoint (boxSet α Q) (boxSet α R) :=
    pairwiseDisjoint_stoppingRoots α S s f n hQ hR hQR
  obtain ⟨x, hx⟩ := boxSet_nonempty α q
  exact (Set.disjoint_left.1 hrootDisj) (hqQsub hx) (hqRsub hx)

theorem pairwiseDisjoint_stoppingTreeBoxes {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) :
    (↑(stoppingRoots α S s f n) : Set (AnisoBox α)).PairwiseDisjoint
      (stoppingTreeBoxes α S s f n) := by
  intro Q hQ R hR hne
  exact stoppingTreeBoxes_disjoint_of_ne α S s f n Q R hQ hR
    hne

/-- The maximal-root trees form an exact finite partition of one stopping
level. -/
theorem stoppingLevel_eq_biUnion_stoppingTreeBoxes {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) :
    stoppingLevel α S s f n =
      (stoppingRoots α S s f n).biUnion
        (stoppingTreeBoxes α S s f n) := by
  classical
  ext q
  constructor
  · intro hq
    rcases exists_stoppingRoot_above α S s f n hq with ⟨Q, hQ, hqQ⟩
    exact Finset.mem_biUnion.mpr ⟨Q, hQ,
      (mem_stoppingTreeBoxes_iff α S s f n Q q).mpr ⟨hq, hqQ⟩⟩
  · intro hq
    rcases Finset.mem_biUnion.mp hq with ⟨Q, hQ, hqQ⟩
    exact (mem_stoppingTreeBoxes_iff α S s f n Q q).mp hqQ |>.1

/-- Any finite sum over a stopping level splits exactly into its maximal-root
tree sums. -/
theorem sum_stoppingLevel_eq_sum_stoppingTrees {d : ℕ}
    {M : Type*} [AddCommMonoid M]
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) (w : AnisoBox α → M) :
    (∑ q ∈ stoppingLevel α S s f n, w q) =
      ∑ Q ∈ stoppingRoots α S s f n,
        ∑ q ∈ stoppingTreeBoxes α S s f n Q, w q := by
  classical
  rw [stoppingLevel_eq_biUnion_stoppingTreeBoxes]
  exact Finset.sum_biUnion (pairwiseDisjoint_stoppingTreeBoxes α S s f n)

/-- Each stopping level is convex in the anisotropic dyadic grid. -/
theorem isConvexCollection_stoppingLevel {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (s : Fin d → ℝ) (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) :
    IsConvexCollection α (stoppingLevel α S s f n) := by
  intro q r w hq hr hqw hwr
  rw [mem_stoppingLevel_iff] at hq hr ⊢
  have hwS : w ∈ S := hS (q := q) (r := r) (w := w) hq.1 hr.1 hqw hwr
  refine ⟨hwS, ?_⟩
  intro j
  have hwq : stoppingData α S (s j) (f j) w ≤
      stoppingData α S (s j) (f j) q :=
    stoppingData_antitone (q := q) (r := w) α S (s j) (f j)
      hq.1 hwS hqw
  have hrw : stoppingData α S (s j) (f j) r ≤
      stoppingData α S (s j) (f j) w :=
    stoppingData_antitone (q := w) (r := r) α S (s j) (f j)
      hwS hr.1 hwr
  exact ⟨lt_of_lt_of_le (hr.2 j).1 hrw,
    le_trans hwq (hq.2 j).2⟩

/-- The source stopping-tree local-size estimate follows for any convex tree
whose boxes lie in one stopping level. -/
theorem treeLocalSize_le_stoppingLevel {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ)
    (T : FiniteConvexTree α)
    (hT : ∀ q ∈ T.boxes, q ∈ stoppingLevel α S s f n)
    (j : Fin d) :
    treeLocalSize T (s j) (f j) ≤ (2 : ℝ) ^ n j := by
  unfold treeLocalSize
  rw [collectionLocalSize_eq_sup' T.boxes T.nonempty]
  apply Finset.sup'_le
  intro q hq
  have hqlevel := hT q hq
  rw [mem_stoppingLevel_iff] at hqlevel
  exact (boxLocalSize_le_stoppingData α S (s j) (f j) hqlevel.1).trans
    (hqlevel.2 j).2

/-- Package the boxes below a maximal stopping root as the literal finite
convex tree used in the forest estimate. -/
noncomputable def stoppingTree {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ)
    (hconvex : IsConvexCollection α (stoppingLevel α S s f n))
    (Q : AnisoBox α) (hQ : Q ∈ stoppingRoots α S s f n) :
    FiniteConvexTree α := by
  let L := stoppingLevel α S s f n
  let U := stoppingTreeBoxes α S s f n Q
  have hQL : Q ∈ L := (mem_stoppingRoots_iff α S s f n Q).mp hQ |>.1
  have hQU : Q ∈ U := by
    rw [mem_stoppingTreeBoxes_iff]
    exact ⟨hQL, Set.Subset.rfl⟩
  exact
    { boxes := U
      nonempty := ⟨Q, hQU⟩
      root := Q
      root_mem := hQU
      convex := by
        intro q r w hq hr hqw hwr
        rw [mem_stoppingTreeBoxes_iff] at hq hr ⊢
        refine ⟨hconvex hq.1 hr.1 hqw hwr, ?_⟩
        exact hwr.trans hr.2
      below_root := by
        intro q hq
        exact (mem_stoppingTreeBoxes_iff α S s f n Q q).mp hq |>.2 }

theorem stoppingTree_boxes {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ)
    (hconvex : IsConvexCollection α (stoppingLevel α S s f n))
    (Q : AnisoBox α) (hQ : Q ∈ stoppingRoots α S s f n) :
    (stoppingTree α S s f n hconvex Q hQ).boxes =
      stoppingTreeBoxes α S s f n Q := rfl

theorem stoppingTree_root {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ)
    (hconvex : IsConvexCollection α (stoppingLevel α S s f n))
    (Q : AnisoBox α) (hQ : Q ∈ stoppingRoots α S s f n) :
    (stoppingTree α S s f n hconvex Q hQ).root = Q := rfl

/-- Every box in a stopping level belongs to the tree of some maximal root. -/
theorem exists_stoppingTree_contains {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ)
    (hconvex : IsConvexCollection α (stoppingLevel α S s f n))
    {q : AnisoBox α} (hq : q ∈ stoppingLevel α S s f n) :
    ∃ Q : {Q : AnisoBox α // Q ∈ stoppingRoots α S s f n},
      q ∈ (stoppingTree α S s f n hconvex Q.1 Q.2).boxes := by
  rcases exists_stoppingRoot_above α S s f n hq with ⟨Q, hQ, hqQ⟩
  refine ⟨⟨Q, hQ⟩, ?_⟩
  rw [stoppingTree_boxes]
  exact (mem_stoppingTreeBoxes_iff α S s f n Q q).mpr ⟨hq, hqQ⟩

/-- The local-size bound of a stopping tree is its upper level threshold. -/
theorem stoppingTreeLocalSize_le {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ)
    (hconvex : IsConvexCollection α (stoppingLevel α S s f n))
    (Q : AnisoBox α) (hQ : Q ∈ stoppingRoots α S s f n)
    (j : Fin d) :
    treeLocalSize (stoppingTree α S s f n hconvex Q hQ) (s j) (f j) ≤
      (2 : ℝ) ^ n j := by
  apply treeLocalSize_le_stoppingLevel α S s f n
    (stoppingTree α S s f n hconvex Q hQ)
  intro q hq
  rw [stoppingTree_boxes] at hq
  exact (mem_stoppingTreeBoxes_iff α S s f n Q q).mp hq |>.1

/-- The fixed-scale comparison behind the source's ancestor-size lower
bound: every point of a box sees at least the stated fraction of its
centered bracket kernel. -/
theorem boxCenterKernel_le_anisotropicBracketKernel
    (α : Anisotropy) (q : AnisoBox α) {p : E3}
    (hp : p ∈ boxClosedSet α q) (y : E3) :
    (2 / 3 : ℝ) ^ 30 *
        anisotropicBracketKernel α (boxLength q) (boxCenter α q) y ≤
      anisotropicBracketKernel α (boxLength q) p y := by
  have hfactor (i : Fin 3) :
      bracketKernelAt (boxLength q ^ α.weight i) (boxCenter α q i) (y i) ≤
        (3 / 2 : ℝ) ^ 10 *
          bracketKernelAt (boxLength q ^ α.weight i) (p i) (y i) := by
    have hcenter : |boxCenter α q i - p i| ≤ boxLength q ^ α.weight i / 2 := by
      rw [abs_sub_comm]
      simpa only [boxSide_eq_length_pow] using
        abs_sub_boxCenter_le_half_side α q hp i
    simpa using bracketKernelAt_le_of_scale_center
      (s := boxLength q ^ α.weight i)
      (L := boxLength q ^ α.weight i) (b := 1)
      (p := boxCenter α q i) (c := p i) (y := y i)
      (pow_pos (boxLength_pos q) _) (pow_pos (boxLength_pos q) _)
      (by simp) le_rfl hcenter
  have hprod :
      anisotropicBracketKernel α (boxLength q) (boxCenter α q) y ≤
        (3 / 2 : ℝ) ^ 30 *
          anisotropicBracketKernel α (boxLength q) p y := by
    unfold anisotropicBracketKernel
    calc
      (∏ i : Fin 3,
          bracketKernelAt (boxLength q ^ α.weight i) (boxCenter α q i) (y i)) ≤
          ∏ i : Fin 3, (3 / 2 : ℝ) ^ 10 *
            bracketKernelAt (boxLength q ^ α.weight i) (p i) (y i) := by
        apply Finset.prod_le_prod
        · intro i _
          exact bracketKernelAt_nonneg (pow_pos (boxLength_pos q) _).le
        · intro i _
          exact hfactor i
      _ = (3 / 2 : ℝ) ^ 30 *
          ∏ i : Fin 3,
            bracketKernelAt (boxLength q ^ α.weight i) (p i) (y i) := by
        rw [Finset.prod_mul_distrib]
        norm_num [Finset.prod_const, ← pow_mul]
  calc
    (2 / 3 : ℝ) ^ 30 *
        anisotropicBracketKernel α (boxLength q) (boxCenter α q) y ≤
        (2 / 3 : ℝ) ^ 30 *
          ((3 / 2 : ℝ) ^ 30 *
            anisotropicBracketKernel α (boxLength q) p y) :=
      mul_le_mul_of_nonneg_left hprod (pow_nonneg (by norm_num) _)
    _ = anisotropicBracketKernel α (boxLength q) p y := by
      norm_num
      ring

/-- The exponent-two local power of a box is controlled from below by the
same-scale bracket average at every point of that box. -/
theorem boxLocalPower_two_le_cubeSecondMoment
    (α : Anisotropy) (q : AnisoBox α) {p : E3}
    (hp : p ∈ boxClosedSet α q) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) :
    (2 / 3 : ℝ) ^ 30 * boxLocalPower α 2 f q ≤
      cubeSecondMoment α (boxLength q) p f := by
  rw [← cubeSecondMoment_at_box_eq_boxLocalPower_two α q f]
  let K₀ : E3 → ℝ :=
    anisotropicBracketKernel α (boxLength q) (boxCenter α q)
  let Kp : E3 → ℝ := anisotropicBracketKernel α (boxLength q) p
  have hleft : Integrable (fun y : E3 ↦
      (2 / 3 : ℝ) ^ 30 * (f y ^ 2 * K₀ y)) := by
    exact (integrable_cubeSecondMoment_integrand α (boxLength_pos q)
      (boxCenter α q) f hfcont hfbound).const_mul _
  have hright : Integrable (fun y : E3 ↦ f y ^ 2 * Kp y) := by
    exact integrable_cubeSecondMoment_integrand α (boxLength_pos q)
      p f hfcont hfbound
  have hpointwise (y : E3) :
      (2 / 3 : ℝ) ^ 30 * (f y ^ 2 * K₀ y) ≤ f y ^ 2 * Kp y := by
    have hkernel : (2 / 3 : ℝ) ^ 30 * K₀ y ≤ Kp y := by
      exact boxCenterKernel_le_anisotropicBracketKernel α q hp y
    calc
      (2 / 3 : ℝ) ^ 30 * (f y ^ 2 * K₀ y) =
          f y ^ 2 * ((2 / 3 : ℝ) ^ 30 * K₀ y) := by ring
      _ ≤ f y ^ 2 * Kp y :=
        mul_le_mul_of_nonneg_left hkernel (sq_nonneg _)
  change (2 / 3 : ℝ) ^ 30 *
      (∫ y : E3, f y ^ 2 * K₀ y) ≤ ∫ y : E3, f y ^ 2 * Kp y
  rw [← MeasureTheory.integral_const_mul]
  exact MeasureTheory.integral_mono_ae hleft hright
    (Filter.Eventually.of_forall hpointwise)

/-- The literal exponent-two anisotropic maximal power, before taking the
square root in the maximal size. -/
noncomputable def anisotropicMaximalTwoPower
    (α : Anisotropy) (f : E3 → ℝ) (p : E3) : ℝ :=
  sSup {a : ℝ | ∃ t : ℝ, 0 < t ∧ a = cubeSecondMoment α t p f}

noncomputable def anisotropicMaximalTwo
    (α : Anisotropy) (f : E3 → ℝ) (p : E3) : ℝ :=
  √(anisotropicMaximalTwoPower α f p)

/-- Bounded continuous inputs make the real supremum defining the local
maximal power bounded above. -/
theorem bddAbove_anisotropicMaximalTwoPower
    (α : Anisotropy) (f : E3 → ℝ) (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f y| ≤ B) (p : E3) :
    BddAbove {a : ℝ | ∃ t : ℝ, 0 < t ∧ a = cubeSecondMoment α t p f} := by
  refine ⟨B ^ 2 * (2 / 9 : ℝ) ^ 3, ?_⟩
  rintro a ⟨t, ht, rfl⟩
  let K : E3 → ℝ := anisotropicBracketKernel α t p
  have hleft : Integrable (fun y : E3 ↦ f y ^ 2 * K y) := by
    exact integrable_cubeSecondMoment_integrand α ht p f hfcont
      ⟨B, hB, hfB⟩
  have hright : Integrable (fun y : E3 ↦ B ^ 2 * K y) := by
    exact (integrable_anisotropicBracketKernel α ht p).const_mul _
  have hpointwise (y : E3) : f y ^ 2 * K y ≤ B ^ 2 * K y := by
    have hK : 0 ≤ K y := anisotropicBracketKernel_nonneg α ht.le p y
    have hf2 : f y ^ 2 ≤ B ^ 2 := by
      rw [← sq_abs]
      exact pow_le_pow_left₀ (abs_nonneg _) (hfB y) 2
    exact mul_le_mul_of_nonneg_right hf2 hK
  calc
    cubeSecondMoment α t p f = ∫ y : E3, f y ^ 2 * K y := by rfl
    _ ≤ ∫ y : E3, B ^ 2 * K y :=
      MeasureTheory.integral_mono_ae hleft hright
        (Filter.Eventually.of_forall hpointwise)
    _ = B ^ 2 * ∫ y : E3, K y := by
      rw [MeasureTheory.integral_const_mul]
    _ = B ^ 2 * (2 / 9 : ℝ) ^ 3 := by
      rw [integral_anisotropicBracketKernel α ht p]

theorem cubeSecondMoment_le_anisotropicMaximalTwoPower
    (α : Anisotropy) (f : E3 → ℝ) (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f y| ≤ B)
    (p : E3) {t : ℝ} (ht : 0 < t) :
    cubeSecondMoment α t p f ≤ anisotropicMaximalTwoPower α f p := by
  unfold anisotropicMaximalTwoPower
  apply le_csSup (bddAbove_anisotropicMaximalTwoPower
    α f hfcont B hB hfB p)
  exact ⟨t, ht, rfl⟩

/-- The source ancestor-size estimate in exponent-two power form. -/
theorem boxLocalPower_two_le_anisotropicMaximalTwoPower
    (α : Anisotropy) (q : AnisoBox α) {p : E3}
    (hp : p ∈ boxSet α q) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f y| ≤ B) :
    (2 / 3 : ℝ) ^ 30 * boxLocalPower α 2 f q ≤
      anisotropicMaximalTwoPower α f p := by
  exact (boxLocalPower_two_le_cubeSecondMoment α q
    (boxSet_subset_boxClosedSet α q hp) f hfcont ⟨B, hB, hfB⟩).trans
      (cubeSecondMoment_le_anisotropicMaximalTwoPower α f hfcont
        B hB hfB p (boxLength_pos q))

/-- The exponent-two maximal-size estimate in the exact square-root form
of `lem:maximal_size`. -/
theorem boxLocalSize_two_le_anisotropicMaximalTwo
    (α : Anisotropy) (q : AnisoBox α) {p : E3}
    (hp : p ∈ boxSet α q) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f y| ≤ B) :
    (2 / 3 : ℝ) ^ 15 * boxLocalSize α 2 f q ≤
      anisotropicMaximalTwo α f p := by
  have hsize : 0 ≤ boxLocalSize α 2 f q := by
    unfold boxLocalSize
    exact Real.rpow_nonneg (by
      unfold boxLocalPower
      apply integral_nonneg
      intro y
      exact mul_nonneg (Real.rpow_nonneg (abs_nonneg _) _)
        (anisotropicBracketKernel_nonneg α (boxLength_pos q).le
          (boxCenter α q) y)) _
  have hmax : 0 ≤ anisotropicMaximalTwoPower α f p := by
    calc
      0 ≤ cubeSecondMoment α 1 p f :=
        cubeSecondMoment_nonneg α (by norm_num) p f
      _ ≤ anisotropicMaximalTwoPower α f p :=
        cubeSecondMoment_le_anisotropicMaximalTwoPower α f hfcont
          B hB hfB p (by norm_num)
  apply (sq_le_sq₀
    (mul_nonneg (pow_nonneg (by norm_num) _) hsize)
    (Real.sqrt_nonneg _)).mp
  rw [Real.sq_sqrt hmax]
  calc
    ((2 / 3 : ℝ) ^ 15 * boxLocalSize α 2 f q) ^ 2 =
        (2 / 3 : ℝ) ^ 30 * boxLocalSize α 2 f q ^ 2 := by
      rw [mul_pow]
      norm_num [← pow_mul]
    _ = (2 / 3 : ℝ) ^ 30 * boxLocalPower α 2 f q := by
      rw [boxLocalSize_two_sq_eq_boxLocalPower]
    _ ≤ anisotropicMaximalTwoPower α f p :=
      boxLocalPower_two_le_anisotropicMaximalTwoPower α q hp f
        hfcont B hB hfB

/-- The exact Fourier multiplier of a positive normalized Gaussian-derivative
dilation.  This is the physical-to-frequency bridge at one fixed scale. -/
theorem fourier_gaussianDerivAt_zero
    (s : ℝ) (hs : 0 < s) :
    (𝓕 fun x : ℝ ↦ (gaussianDerivAt s 0 x : ℂ)) =
      fun ξ : ℝ ↦ -Complex.I * (gaussianDeriv (s * ξ) : ℂ) := by
  funext ξ
  let G : ℝ → ℂ := fun y ↦
    (Real.fourierChar (-(y * (s * ξ))) : ℂ) * (gaussianDeriv y : ℂ)
  have hkernel (x : ℝ) :
      (gaussianDerivAt s 0 x : ℂ) =
        (s⁻¹ : ℂ) * (gaussianDeriv (x / s) : ℂ) := by
    simp [gaussianDerivAt, kernelAt, kernelDilate, smul_eq_mul]
  have hphase (x : ℝ) :
      (Real.fourierChar (-(x * ξ)) : ℂ) *
        ((s⁻¹ : ℂ) * (gaussianDeriv (x / s) : ℂ)) =
      (s⁻¹ : ℂ) * G (x / s) := by
    dsimp [G]
    have hs0 : s ≠ 0 := hs.ne'
    rw [show -((x / s) * (s * ξ)) = -(x * ξ) by
      field_simp]
    ring
  have hchange :
      (∫ x : ℝ, (Real.fourierChar (-(x * ξ)) : ℂ) *
        ((s⁻¹ : ℂ) * (gaussianDeriv (x / s) : ℂ))) = ∫ y : ℝ, G y := by
    calc
      (∫ x : ℝ, (Real.fourierChar (-(x * ξ)) : ℂ) *
          ((s⁻¹ : ℂ) * (gaussianDeriv (x / s) : ℂ))) =
          ∫ x : ℝ, (s⁻¹ : ℂ) * G (x / s) := by
            apply integral_congr_ae
            filter_upwards [] with x
            exact hphase x
      _ = (s⁻¹ : ℂ) * ∫ x : ℝ, G (x / s) := by
            rw [integral_const_mul]
      _ = (s⁻¹ : ℂ) * (|s| • ∫ y : ℝ, G y) := by
            rw [Measure.integral_comp_div]
      _ = ∫ y : ℝ, G y := by
            rw [abs_of_pos hs]
            rw [Complex.real_smul]
            field_simp [Complex.ofReal_ne_zero.mpr hs.ne']
  rw [Real.fourier_real_eq]
  change (∫ x : ℝ, (Real.fourierChar (-(x * ξ)) : ℂ) *
    (gaussianDerivAt s 0 x : ℂ)) = _
  rw [show (fun x : ℝ ↦
      (Real.fourierChar (-(x * ξ)) : ℂ) * (gaussianDerivAt s 0 x : ℂ)) =
      fun x : ℝ ↦ (Real.fourierChar (-(x * ξ)) : ℂ) *
        ((s⁻¹ : ℂ) * (gaussianDeriv (x / s) : ℂ)) by
          funext x
          rw [hkernel]]
  rw [hchange]
  have hGfourier : (∫ y : ℝ, G y) =
      𝓕 (fun y : ℝ ↦ (gaussianDeriv y : ℂ)) (s * ξ) := by
    rw [Real.fourier_real_eq]
    change (∫ y : ℝ, G y) =
      ∫ y : ℝ, (Real.fourierChar (-(y * (s * ξ))) : ℂ) *
        (gaussianDeriv y : ℂ)
    apply integral_congr_ae
    filter_upwards [] with y
    dsimp [G]
  rw [hGfourier, fourier_gaussianDeriv]

/-- Translation contributes only the expected unimodular Fourier phase to a
positive Gaussian-derivative dilation. -/
theorem fourier_gaussianDerivAt
    (s a : ℝ) (hs : 0 < s) :
    (𝓕 fun x : ℝ ↦ (gaussianDerivAt s a x : ℂ)) =
      fun ξ : ℝ ↦ (Real.fourierChar (-(a * ξ)) : ℂ) *
        (-Complex.I * (gaussianDeriv (s * ξ) : ℂ)) := by
  funext ξ
  let H : ℝ → ℂ := fun y ↦
    (Real.fourierChar (-(y * ξ)) : ℂ) * (gaussianDerivAt s 0 y : ℂ)
  have htranslate (x : ℝ) :
      (gaussianDerivAt s a x : ℂ) = (gaussianDerivAt s 0 (x - a) : ℂ) := by
    simp [gaussianDerivAt, kernelAt]
  have hphase (x : ℝ) :
      (Real.fourierChar (-(x * ξ)) : ℂ) =
        (Real.fourierChar (-(a * ξ)) : ℂ) *
          (Real.fourierChar (-((x - a) * ξ)) : ℂ) := by
    simp only [Real.fourierChar_apply]
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  rw [Real.fourier_real_eq]
  change (∫ x : ℝ, (Real.fourierChar (-(x * ξ)) : ℂ) *
    (gaussianDerivAt s a x : ℂ)) = _
  calc
    (∫ x : ℝ, (Real.fourierChar (-(x * ξ)) : ℂ) *
        (gaussianDerivAt s a x : ℂ)) =
        ∫ x : ℝ, (Real.fourierChar (-(a * ξ)) : ℂ) * H (x - a) := by
          apply integral_congr_ae
          filter_upwards [] with x
          rw [hphase x, htranslate x]
          dsimp [H]
          ring
    _ = (Real.fourierChar (-(a * ξ)) : ℂ) * ∫ x : ℝ, H (x - a) := by
      rw [integral_const_mul]
    _ = (Real.fourierChar (-(a * ξ)) : ℂ) * ∫ y : ℝ, H y := by
      congr 1
      exact integral_sub_right_eq_self H a
    _ = (Real.fourierChar (-(a * ξ)) : ℂ) *
        𝓕 (fun y : ℝ ↦ (gaussianDerivAt s 0 y : ℂ)) ξ := by
          congr 1
          rw [Real.fourier_real_eq]
          change (∫ y : ℝ, H y) =
            ∫ y : ℝ, (Real.fourierChar (-(y * ξ)) : ℂ) *
              (gaussianDerivAt s 0 y : ℂ)
          apply integral_congr_ae
          filter_upwards [] with y
          rfl
    _ = (Real.fourierChar (-(a * ξ)) : ℂ) *
        (-Complex.I * (gaussianDeriv (s * ξ) : ℂ)) := by
          rw [fourier_gaussianDerivAt_zero s hs]

/-- The translated Gaussian-derivative multiplier has the literal real
square modulus used by the fixed-scale Plancherel calculation. -/
theorem norm_sq_fourier_gaussianDerivAt
    (s a ξ : ℝ) (hs : 0 < s) :
    ‖𝓕 (fun x : ℝ ↦ (gaussianDerivAt s a x : ℂ)) ξ‖ ^ 2 =
      gaussianDeriv (s * ξ) ^ 2 := by
  rw [fourier_gaussianDerivAt s a hs]
  simp only [norm_mul, Circle.norm_coe, Complex.norm_real, Real.norm_eq_abs]
  rw [norm_neg, Complex.norm_I]
  simp only [one_mul, sq_abs]

/-- Finite unions of literal box collections become ordinary unions of their
center--scale regions. -/
theorem collectionRegion_union (α : Anisotropy)
    (S T : BoxCollection α) :
    collectionRegion α (S ∪ T) =
      collectionRegion α S ∪ collectionRegion α T := by
  ext z
  constructor
  · intro hz
    rw [collectionRegion] at hz
    rcases Set.mem_iUnion.1 hz with ⟨q, hz⟩
    rcases Set.mem_iUnion.1 hz with ⟨hq, hz⟩
    rw [Finset.mem_union] at hq
    rcases hq with hq | hq
    · left
      rw [collectionRegion]
      exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hq, hz⟩⟩
    · right
      rw [collectionRegion]
      exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hq, hz⟩⟩
  · intro hz
    rw [collectionRegion]
    rcases hz with hz | hz
    · rw [collectionRegion] at hz
      rcases Set.mem_iUnion.1 hz with ⟨q, hz⟩
      rcases Set.mem_iUnion.1 hz with ⟨hq, hz⟩
      exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2
        ⟨Finset.mem_union_left _ hq, hz⟩⟩
    · rw [collectionRegion] at hz
      rcases Set.mem_iUnion.1 hz with ⟨q, hz⟩
      rcases Set.mem_iUnion.1 hz with ⟨hq, hz⟩
      exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2
        ⟨Finset.mem_union_right _ hq, hz⟩⟩

/-- Disjoint finite box collections have disjoint center--scale regions. -/
theorem disjoint_collectionRegion_of_disjoint (α : Anisotropy)
    (S T : BoxCollection α) (hST : Disjoint S T) :
    Disjoint (collectionRegion α S) (collectionRegion α T) := by
  rw [Set.disjoint_left]
  intro z hzS hzT
  rw [collectionRegion] at hzS hzT
  rcases Set.mem_iUnion.1 hzS with ⟨q, hzS⟩
  rcases Set.mem_iUnion.1 hzS with ⟨hqS, hzq⟩
  rcases Set.mem_iUnion.1 hzT with ⟨r, hzT⟩
  rcases Set.mem_iUnion.1 hzT with ⟨hrT, hzr⟩
  by_cases hqr : q = r
  · subst r
    exact (Finset.disjoint_left.1 hST hqS hrT).elim
  · exact (Set.disjoint_left.1 (boxScaleRegion_disjoint_of_ne α hqr) hzq hzr).elim

/-- The expanded local form is additive over a finite disjoint union whenever
the outer signed integrand is integrable on the union. -/
theorem expandedModelLocalForm_union_of_integrable
    (α : Anisotropy) (S T : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (hST : Disjoint S T)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict (collectionRegion α (S ∪ T)))) :
    expandedModelLocalForm α (S ∪ T) u c f =
      expandedModelLocalForm α S u c f +
        expandedModelLocalForm α T u c f := by
  let g : E3 × ℝ → ℝ := fun pt ↦
    c pt.2 * (∫ z : ModelE5,
      modelFirstFiber α f pt.1 pt.2 z *
        modelSecondFiber α (f 3) pt.1 pt.2 z *
          modelSignedDensity α u pt.1 pt.2 z)
  have hregion : collectionRegion α (S ∪ T) =
      collectionRegion α S ∪ collectionRegion α T :=
    collectionRegion_union α S T
  have hdisj : Disjoint (collectionRegion α S) (collectionRegion α T) :=
    disjoint_collectionRegion_of_disjoint α S T hST
  have hSint : Integrable g
      (cubeScaleMeasure.restrict (collectionRegion α S)) := by
    apply hint.mono_measure
    rw [hregion]
    exact Measure.restrict_mono (Set.subset_union_left) le_rfl
  have hTint : Integrable g
      (cubeScaleMeasure.restrict (collectionRegion α T)) := by
    apply hint.mono_measure
    rw [hregion]
    exact Measure.restrict_mono (Set.subset_union_right) le_rfl
  unfold expandedModelLocalForm
  change -(∫ pt, g pt ∂(cubeScaleMeasure.restrict
      (collectionRegion α (S ∪ T)))) =
    -(∫ pt, g pt ∂(cubeScaleMeasure.restrict (collectionRegion α S))) +
      -(∫ pt, g pt ∂(cubeScaleMeasure.restrict (collectionRegion α T)))
  rw [hregion, setIntegral_union hdisj
    (measurableSet_collectionRegion α T) hSint hTint]
  ring

/-- The expanded local form is the finite sum of its literal one-box forms
under the matching outer integrability hypothesis. -/
theorem expandedModelLocalForm_collection_eq_sum_singletons_of_integrable
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict (collectionRegion α S))) :
    expandedModelLocalForm α S u c f =
      ∑ q ∈ S, expandedModelLocalForm α ({q} : BoxCollection α) u c f := by
  unfold expandedModelLocalForm
  simp_rw [collectionRegion_singleton]
  unfold collectionRegion
  rw [Finset.sum_neg_distrib]
  congr 1
  apply MeasureTheory.integral_biUnion_finset
  · intro q hq
    exact measurableSet_boxScaleRegion α q
  · exact pairwiseDisjoint_boxScaleRegion α S
  · intro q hq
    have hsub : boxScaleRegion α q ⊆ collectionRegion α S := by
      intro pt hpt
      unfold collectionRegion
      exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hq, hpt⟩⟩
    apply hint.mono_measure
    exact Measure.restrict_mono hsub le_rfl

/-- The first local energy is a finite sum of one-box energies whenever its
outer energy density is integrable over the collection. -/
theorem modelEnergyOne_collection_eq_sum_singletons_of_integrable
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : ModelRealInput)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      ∫ z : ModelE5,
        (modelFirstFiber α f pt.1 pt.2 z) ^ 2 *
          modelEnergyDensity α u pt.1 pt.2 z)
      (cubeScaleMeasure.restrict (collectionRegion α S))) :
    modelEnergyOne α S u f =
      ∑ q ∈ S, modelEnergyOne α ({q} : BoxCollection α) u f := by
  unfold modelEnergyOne
  simp_rw [collectionRegion_singleton]
  unfold collectionRegion
  apply MeasureTheory.integral_biUnion_finset
  · intro q hq
    exact measurableSet_boxScaleRegion α q
  · exact pairwiseDisjoint_boxScaleRegion α S
  · intro q hq
    have hsub : boxScaleRegion α q ⊆ collectionRegion α S := by
      intro pt hpt
      unfold collectionRegion
      exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hq, hpt⟩⟩
    apply hint.mono_measure
    exact Measure.restrict_mono hsub le_rfl

/-- The second local energy is a finite sum of one-box energies whenever its
outer energy density is integrable over the collection. -/
theorem modelEnergyTwo_collection_eq_sum_singletons_of_integrable
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : E3 → ℝ)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      ∫ z : ModelE5,
        (modelSecondFiber α f pt.1 pt.2 z) ^ 2 *
          modelEnergyDensity α u pt.1 pt.2 z)
      (cubeScaleMeasure.restrict (collectionRegion α S))) :
    modelEnergyTwo α S u f =
      ∑ q ∈ S, modelEnergyTwo α ({q} : BoxCollection α) u f := by
  unfold modelEnergyTwo modelEnergyTwoOn
  simp_rw [collectionRegion_singleton]
  unfold collectionRegion
  apply MeasureTheory.integral_biUnion_finset
  · intro q hq
    exact measurableSet_boxScaleRegion α q
  · exact pairwiseDisjoint_boxScaleRegion α S
  · intro q hq
    have hsub : boxScaleRegion α q ⊆ collectionRegion α S := by
      intro pt hpt
      unfold collectionRegion
      exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hq, hpt⟩⟩
    apply hint.mono_measure
    exact Measure.restrict_mono hsub le_rfl

/-- The two local-energy bounds with powers `50` and `100` give the source
local-model estimate with translation power `75`.  All analytic content stays
in the two displayed energy hypotheses; this lemma only records their exact
positive algebraic synthesis. -/
theorem localModelEstimate_of_energyBounds
    (α : Anisotropy) (T : FiniteConvexTree α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (C₁ C₂ : ℝ)
    (hC₁ : 0 ≤ C₁) (hC₂ : 0 ≤ C₂)
    (hcs : |expandedModelLocalForm α T.boxes u c f| ^ 2 ≤
      modelEnergyOne α T.boxes u f * modelEnergyTwo α T.boxes u (f 3))
    (hE₁ : modelEnergyOne α T.boxes u f ≤
      C₁ * sourceWeight u ^ 50 * boxMass α T.root *
        (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
          treeLocalSize T 4 (f 2)) ^ 2)
    (hE₂ : modelEnergyTwo α T.boxes u (f 3) ≤
      C₂ * sourceWeight u ^ 100 * boxMass α T.root *
        treeLocalSize T 2 (f 3) ^ 2) :
    |expandedModelLocalForm α T.boxes u c f| ≤
      (C₁ * C₂ + 1) * sourceWeight u ^ 75 * boxMass α T.root *
        (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
          treeLocalSize T 4 (f 2)) * treeLocalSize T 2 (f 3) := by
  let P : ℝ := treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
    treeLocalSize T 4 (f 2)
  let M : ℝ := treeLocalSize T 2 (f 3)
  let A : ℝ := sourceWeight u ^ 25 * √(boxMass α T.root) * P
  let B : ℝ := sourceWeight u ^ 50 * √(boxMass α T.root) * M
  have hU : 0 ≤ sourceWeight u := sourceWeight_nonneg u
  have hmass : 0 ≤ boxMass α T.root := (boxMass_pos α T.root).le
  have hP : 0 ≤ P := by
    dsimp [P]
    exact mul_nonneg
      (mul_nonneg (treeLocalSize_four_nonneg T (f 0))
        (treeLocalSize_four_nonneg T (f 1)))
      (treeLocalSize_four_nonneg T (f 2))
  have hM : 0 ≤ M := by
    dsimp [M]
    exact treeLocalSize_two_nonneg T (f 3)
  have hA : 0 ≤ A := by
    dsimp [A]
    positivity
  have hB : 0 ≤ B := by
    dsimp [B]
    positivity
  have hA_sq : A ^ 2 = sourceWeight u ^ 50 * boxMass α T.root * P ^ 2 := by
    dsimp [A]
    rw [mul_pow, mul_pow, ← pow_mul, show 25 * 2 = 50 by norm_num,
      Real.sq_sqrt hmass]
  have hB_sq : B ^ 2 = sourceWeight u ^ 100 * boxMass α T.root * M ^ 2 := by
    dsimp [B]
    rw [mul_pow, mul_pow, ← pow_mul, show 50 * 2 = 100 by norm_num,
      Real.sq_sqrt hmass]
  have hbound₁ : modelEnergyOne α T.boxes u f ≤ C₁ * A ^ 2 := by
    rw [hA_sq]
    calc
      modelEnergyOne α T.boxes u f ≤
          C₁ * sourceWeight u ^ 50 * boxMass α T.root * P ^ 2 := by
            simpa only [P] using hE₁
      _ = C₁ * (sourceWeight u ^ 50 * boxMass α T.root * P ^ 2) := by ring
  have hbound₂ : modelEnergyTwo α T.boxes u (f 3) ≤ C₂ * B ^ 2 := by
    rw [hB_sq]
    calc
      modelEnergyTwo α T.boxes u (f 3) ≤
          C₂ * sourceWeight u ^ 100 * boxMass α T.root * M ^ 2 := by
            simpa only [M] using hE₂
      _ = C₂ * (sourceWeight u ^ 100 * boxMass α T.root * M ^ 2) := by ring
  have hmain := abs_le_of_square_energy_bounds hcs
    (modelEnergyOne_nonneg α T.boxes u f)
    (modelEnergyTwo_nonneg α T.boxes u (f 3)) hA hB hC₁ hC₂ hbound₁ hbound₂
  calc
    |expandedModelLocalForm α T.boxes u c f| ≤ (C₁ * C₂ + 1) * A * B := hmain
    _ = (C₁ * C₂ + 1) * sourceWeight u ^ 75 * boxMass α T.root * P * M := by
      dsimp [A, B]
      calc
        (C₁ * C₂ + 1) *
            (sourceWeight u ^ 25 * √(boxMass α T.root) * P) *
            (sourceWeight u ^ 50 * √(boxMass α T.root) * M) =
            (C₁ * C₂ + 1) *
              (sourceWeight u ^ 25 * sourceWeight u ^ 50) *
              (√(boxMass α T.root) * √(boxMass α T.root)) * P * M := by ring
        _ = _ := by
          rw [← pow_add, show 25 + 50 = 75 by norm_num,
            Real.mul_self_sqrt hmass]
    _ = _ := by rfl

/-- A raw one-dimensional Plancherel identity on the elementary inversion
domain.  This is deliberately stated with the exact `L¹` hypotheses needed by
Mathlib's Fourier inversion theorem, so it can be applied to a Schwartz fiber
after the physical convolution calculation. -/
theorem integral_norm_sq_fourier_eq_of_integrable
    {f : ℝ → ℂ} (hfcont : Continuous f) (hf : Integrable f)
    (hfourier : Integrable (𝓕 f)) :
    (∫ ξ : ℝ, ‖𝓕 f ξ‖ ^ 2) = ∫ x : ℝ, ‖f x‖ ^ 2 := by
  have hinv : 𝓕⁻ (𝓕 f) = f :=
    hfcont.fourierInv_fourier_eq hf hfourier
  have hsesq := VectorFourier.integral_sesq_fourierIntegral_eq_neg_flip
    (μ := (volume : Measure ℝ)) (ν := (volume : Measure ℝ))
    (L := innerₗ ℝ) (e := Real.fourierChar) (f := f) (g := 𝓕 f)
    (innerSL ℂ) Real.continuous_fourierChar continuous_inner hf hfourier
  have hfourier_apply (x : ℝ) :
      VectorFourier.fourierIntegral 𝐞 volume (innerₗ ℝ) f x = 𝓕 f x := rfl
  have hfourierInv_apply (x : ℝ) :
      VectorFourier.fourierIntegral 𝐞 volume (-(innerₗ ℝ).flip) (𝓕 f) x =
        𝓕⁻ (𝓕 f) x := by
    rw [flip_innerₗ]
    rfl
  simp_rw [hfourier_apply, hfourierInv_apply] at hsesq
  rw [hinv] at hsesq
  change (∫ ξ : ℝ, ‖𝓕 f ξ‖ ^ 2) = ∫ x : ℝ, ‖f x‖ ^ 2
  apply Complex.ofRealLI.injective
  simpa [← LinearIsometry.integral_comp_comm, inner_self_eq_norm_sq_to_K] using hsesq

/-- Exact finite-forest additivity for the expanded local form.  The proof
uses only the literal disjoint partition of boxes, so it applies directly to
the stopping trees at a fixed level. -/
theorem expandedModelLocalForm_biUnion_eq_sum_of_integrable
    {ι : Type*} (α : Anisotropy) (I : Finset ι)
    (A : ι → BoxCollection α) (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (hdisj : (↑I : Set ι).PairwiseDisjoint A)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict (collectionRegion α (I.biUnion A)))) :
    expandedModelLocalForm α (I.biUnion A) u c f =
      ∑ i ∈ I, expandedModelLocalForm α (A i) u c f := by
  classical
  calc
    expandedModelLocalForm α (I.biUnion A) u c f =
        ∑ q ∈ I.biUnion A,
          expandedModelLocalForm α ({q} : BoxCollection α) u c f :=
      expandedModelLocalForm_collection_eq_sum_singletons_of_integrable
        α (I.biUnion A) u c f hint
    _ = ∑ i ∈ I, ∑ q ∈ A i,
          expandedModelLocalForm α ({q} : BoxCollection α) u c f :=
      Finset.sum_biUnion hdisj
    _ = ∑ i ∈ I, expandedModelLocalForm α (A i) u c f := by
      apply Finset.sum_congr rfl
      intro i hi
      symm
      apply expandedModelLocalForm_collection_eq_sum_singletons_of_integrable
      have hsub : collectionRegion α (A i) ⊆
          collectionRegion α (I.biUnion A) := by
        intro pt hpt
        rw [collectionRegion] at hpt ⊢
        rcases Set.mem_iUnion.1 hpt with ⟨q, hpt⟩
        rcases Set.mem_iUnion.1 hpt with ⟨hq, hpt⟩
        refine Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨?_, hpt⟩⟩
        exact Finset.mem_biUnion.mpr ⟨i, hi, hq⟩
      apply hint.mono_measure
      exact Measure.restrict_mono hsub le_rfl

