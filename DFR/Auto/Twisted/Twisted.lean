    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelOperatorRealInput)
    (m : Fin 3) (a b : ℝ)
    (g : ℕ → E3 → ℝ) (glim : E3 → ℝ) (Bm C : ℝ) (Bf : Fin 3 → ℝ)
