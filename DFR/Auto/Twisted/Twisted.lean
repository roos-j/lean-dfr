/-- Derivatives of a Schwartz function pulled back by a coordinate projection
do not grow.  This elementary estimate is the analytic input for the external
product construction below. -/
theorem norm_iteratedFDeriv_fst_comp_le
    {D E : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : SchwartzMap D ℂ) (n : ℕ) (z : D × E) :
    ‖iteratedFDeriv ℝ n (fun w : D × E ↦ f w.1) z‖ ≤
      ‖iteratedFDeriv ℝ n f z.1‖ := by
  change ‖iteratedFDeriv ℝ n (f ∘ ContinuousLinearMap.fst ℝ D E) z‖ ≤ _
  rw [ContinuousLinearMap.iteratedFDeriv_comp_right
    (ContinuousLinearMap.fst ℝ D E) (f.smooth ⊤) z (by exact_mod_cast le_top)]
  calc
    _ ≤ ‖iteratedFDeriv ℝ n f z.1‖ *
        ∏ _ : Fin n, ‖ContinuousLinearMap.fst ℝ D E‖ :=
      ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv ℝ n f z.1‖ * 1 := by
      gcongr
      apply Finset.prod_le_one
      · intro i hi
        exact norm_nonneg _
      · intro i hi
        exact ContinuousLinearMap.norm_fst_le ℝ D E
    _ = _ := by ring

/-- The companion estimate for the second product coordinate. -/
theorem norm_iteratedFDeriv_snd_comp_le
    {D E : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (g : SchwartzMap E ℂ) (n : ℕ) (z : D × E) :
    ‖iteratedFDeriv ℝ n (fun w : D × E ↦ g w.2) z‖ ≤
      ‖iteratedFDeriv ℝ n g z.2‖ := by
  change ‖iteratedFDeriv ℝ n (g ∘ ContinuousLinearMap.snd ℝ D E) z‖ ≤ _
  rw [ContinuousLinearMap.iteratedFDeriv_comp_right
    (ContinuousLinearMap.snd ℝ D E) (g.smooth ⊤) z (by exact_mod_cast le_top)]
  calc
    _ ≤ ‖iteratedFDeriv ℝ n g z.2‖ *
        ∏ _ : Fin n, ‖ContinuousLinearMap.snd ℝ D E‖ :=
      ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv ℝ n g z.2‖ * 1 := by
      gcongr
      apply Finset.prod_le_one
      · intro i hi
        exact norm_nonneg _
      · intro i hi
        exact ContinuousLinearMap.norm_snd_le ℝ D E
    _ = _ := by ring

/-- The product norm is controlled by the two one-variable Schwartz weights.
This is the elementary decay bookkeeping behind finite tensor products. -/
theorem norm_prod_pow_le_product_one_add_pow
    {D E : Type*} [SeminormedAddCommGroup D] [SeminormedAddCommGroup E]
    (z : D × E) (k : ℕ) :
    ‖z‖ ^ k ≤ (1 + ‖z.1‖) ^ k * (1 + ‖z.2‖) ^ k := by
  rw [← mul_pow]
  apply pow_le_pow_left₀ (norm_nonneg _) ?_ k
  rw [Prod.norm_def]
  by_cases h : ‖z.1‖ ≤ ‖z.2‖
  · rw [max_eq_right h]
    nlinarith [mul_nonneg (show 0 ≤ ‖z.1‖ by positivity)
      (show 0 ≤ 1 + ‖z.2‖ by positivity)]
  · rw [max_eq_left (le_of_not_ge h)]
    nlinarith [mul_nonneg (show 0 ≤ ‖z.2‖ by positivity)
      (show 0 ≤ 1 + ‖z.1‖ by positivity)]

/-- The external product of two complex Schwartz functions.  This formalizes
the finite tensor-product closure used in item (2) of Lemma `lem:schwartz`.
The proof keeps the source's rapid-decay argument explicit rather than pulling
back along either coordinate projection, which would not be injective. -/
noncomputable def schwartzExternalProduct
    {D E : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : SchwartzMap D ℂ) (g : SchwartzMap E ℂ) : SchwartzMap (D × E) ℂ where
  toFun := fun z ↦ f z.1 * g z.2
  smooth' := (f.smooth ⊤).fst'.mul (g.smooth ⊤).snd'
  decay' := by
    intro k n
    let Cf : ℝ := 2 ^ k *
      (Finset.Iic (k, n)).sup (fun q ↦ SchwartzMap.seminorm ℂ q.1 q.2) f
    let Cg : ℝ := 2 ^ k *
      (Finset.Iic (k, n)).sup (fun q ↦ SchwartzMap.seminorm ℂ q.1 q.2) g
    have hf_bound (i : ℕ) (hi : i ≤ n) (x : D) :
        (1 + ‖x‖) ^ k * ‖iteratedFDeriv ℝ i f x‖ ≤ Cf := by
      exact SchwartzMap.one_add_le_sup_seminorm_apply (m := (k, n)) le_rfl hi f x
    have hg_bound (i : ℕ) (hi : i ≤ n) (y : E) :
        (1 + ‖y‖) ^ k * ‖iteratedFDeriv ℝ i g y‖ ≤ Cg := by
      exact SchwartzMap.one_add_le_sup_seminorm_apply (m := (k, n)) le_rfl hi g y
    have hCf : 0 ≤ Cf := by
      exact le_trans (by positivity) (hf_bound 0 (Nat.zero_le n) 0)
    have hCg : 0 ≤ Cg := by
      exact le_trans (by positivity) (hg_bound 0 (Nat.zero_le n) 0)
    refine ⟨∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * (Cf * Cg), fun z ↦ ?_⟩
    let F : D × E → ℂ := fun w ↦ f w.1
    let G : D × E → ℂ := fun w ↦ g w.2
    have hF : ContDiff ℝ (↑(⊤ : ℕ∞)) F := by
      change ContDiff ℝ (↑(⊤ : ℕ∞)) (fun w : D × E ↦ f.toFun w.1)
      exact (f.smooth').fst'
    have hG : ContDiff ℝ (↑(⊤ : ℕ∞)) G := by
      change ContDiff ℝ (↑(⊤ : ℕ∞)) (fun w : D × E ↦ g.toFun w.2)
      exact (g.smooth').snd'
    have hterm (i : ℕ) (hi : i ≤ n) :
        ‖z‖ ^ k * ‖iteratedFDeriv ℝ i F z‖ *
            ‖iteratedFDeriv ℝ (n - i) G z‖ ≤ Cf * Cg := by
      calc
        ‖z‖ ^ k * ‖iteratedFDeriv ℝ i F z‖ *
            ‖iteratedFDeriv ℝ (n - i) G z‖ ≤
            ‖z‖ ^ k * ‖iteratedFDeriv ℝ i f z.1‖ *
              ‖iteratedFDeriv ℝ (n - i) g z.2‖ := by
          gcongr
          · exact norm_iteratedFDeriv_fst_comp_le f i z
          · exact norm_iteratedFDeriv_snd_comp_le g (n - i) z
        _ ≤ (1 + ‖z.1‖) ^ k * (1 + ‖z.2‖) ^ k *
              ‖iteratedFDeriv ℝ i f z.1‖ *
              ‖iteratedFDeriv ℝ (n - i) g z.2‖ := by
          gcongr
          exact norm_prod_pow_le_product_one_add_pow z k
        _ = ((1 + ‖z.1‖) ^ k * ‖iteratedFDeriv ℝ i f z.1‖) *
              ((1 + ‖z.2‖) ^ k * ‖iteratedFDeriv ℝ (n - i) g z.2‖) := by
          ring
        _ ≤ Cf * Cg := by
          apply mul_le_mul
          · exact hf_bound i hi z.1
          · exact hg_bound (n - i) (Nat.sub_le _ _) z.2
          · positivity
          · exact hCf
    have hderiv := norm_iteratedFDeriv_mul_le hF hG z (n := n)
      (by exact_mod_cast le_top)
    have hbound :
        ‖z‖ ^ k * ‖iteratedFDeriv ℝ n (fun w ↦ F w * G w) z‖ ≤
          ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * (Cf * Cg) := by
      calc
        ‖z‖ ^ k * ‖iteratedFDeriv ℝ n (fun w ↦ F w * G w) z‖ ≤
            ‖z‖ ^ k *
              ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
                ‖iteratedFDeriv ℝ i F z‖ * ‖iteratedFDeriv ℝ (n - i) G z‖ := by
          exact mul_le_mul_of_nonneg_left hderiv (pow_nonneg (norm_nonneg _) _)
        _ = ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) *
              (‖z‖ ^ k * ‖iteratedFDeriv ℝ i F z‖ *
                ‖iteratedFDeriv ℝ (n - i) G z‖) := by
          rw [Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro i hi
          ring
        _ ≤ ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * (Cf * Cg) := by
          apply Finset.sum_le_sum
          intro i hi
          apply mul_le_mul_of_nonneg_left
          · exact hterm i (Finset.mem_range_succ_iff.mp hi)
          · positivity
    simpa only [F, G] using hbound

@[simp]
theorem schwartzExternalProduct_apply
    {D E : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : SchwartzMap D ℂ) (g : SchwartzMap E ℂ) (z : D × E) :
