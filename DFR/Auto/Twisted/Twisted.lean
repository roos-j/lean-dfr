      ((volume.restrict (transverseRectangle α q i)).prod volume) := by
  rcases exists_bound_cubeSignedInputProduct F hFbound with ⟨B, hB, hinput⟩
  rcases cubeFaceKernel_domination α with ⟨C, hC, hdom⟩
  let D : ℝ := C * lam ^ 37 * translationWeight r ^ 21
  have hmajor : Integrable (fun z : TransverseSpace i × E6 ↦
      (B * D) * cubeBracketWeight α t (faceInsert i c z.1) z.2)
      ((volume.restrict (transverseRectangle α q i)).prod volume) := by
    simpa only [smul_eq_mul] using
      (integrable_cubeBracketWeight_face_space α q i c ht).const_mul (B * D)
  have hmap : Continuous (fun z : TransverseSpace i × E6 ↦
      (faceInsert i c z.1, z.2)) :=
    ((faceInsert_continuous i c).comp continuous_fst).prodMk continuous_snd
  have hmeas : AEStronglyMeasurable
      (fun z : TransverseSpace i × E6 ↦ cubeSignedInputProduct F z.2 *
        cubeFaceKernel α i lam r t (faceInsert i c z.1) z.2)
      ((volume.restrict (transverseRectangle α q i)).prod volume) :=
    (((continuous_cubeSignedInputProduct F hFcont).comp continuous_snd).mul
      ((continuous_cubeFaceKernel_center_space α i lam r t).comp hmap)).aestronglyMeasurable
  refine hmajor.mono hmeas (Filter.Eventually.of_forall ?_)
  intro z
  have hkernel : |cubeFaceKernel α i lam r t (faceInsert i c z.1) z.2| ≤
      D * cubeBracketWeight α t (faceInsert i c z.1) z.2 := by
    dsimp [D]
    exact hdom i lam r t (faceInsert i c z.1) z.2 hlam ht
  have hmajor_nonneg : 0 ≤ (B * D) *
      cubeBracketWeight α t (faceInsert i c z.1) z.2 := by
    simpa only [mul_assoc] using
      (mul_nonneg hB (le_trans (abs_nonneg _) hkernel))
  rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul, abs_of_nonneg hmajor_nonneg]
  calc
    |cubeSignedInputProduct F z.2| *
        |cubeFaceKernel α i lam r t (faceInsert i c z.1) z.2| ≤
