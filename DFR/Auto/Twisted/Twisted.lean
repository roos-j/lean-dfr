            max (Γ₁ i) ((2:ℝ) ^ (i:ℝ) * Γ₂ i)) ^ R :=
      (Finset.sum_filter_add_sum_filter_not T (fun i ↦ i ∈ I) _).symm
    rw [hsplit]
    have hnn : ∀ i : ℤ, 0 ≤ (2:ℝ) ^ (-(1 / 2 * (i:ℝ))) * max (Γ₁ i) ((2:ℝ) ^ (i:ℝ) * Γ₂ i) :=
