  set h : ModelOperatorRealInput := modelOperatorReplace f m G with hh
  set Bg : ℝ := Bd m + (T.card : ℝ) * (2 * Bd m) with hBg
  set Bnew : Fin 3 → ℝ := fun j ↦ if j = m then Bg else Bd j with hBnew
  have hBgnn : 0 ≤ Bg := by
