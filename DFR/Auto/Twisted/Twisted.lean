    Complex.measurable_ofReal.comp measurable_snd
  have hK : Measurable (fun p : Frequency9 × ℝ ↦
      frequencyKernel (F 0) (F 1) (F 2) (F 3) p.1) :=
    (frequencyKernel (F 0) (F 1) (F 2) (F 3)).continuous.measurable.comp measurable_fst
