/-- The source's order-110 anisotropic multiplier hypothesis from
Definition `def:multiplier`.  Ordered coordinate derivatives are used in
place of multi-indices, with the same anisotropic weight. -/
def IsAnisotropicMultiplier (α : Anisotropy) (M : ℝ) (m : E3 → ℂ) : Prop :=
  0 ≤ M ∧ Measurable m ∧ m 0 = 0 ∧
    ContDiffOn ℝ 110 m ({0}ᶜ : Set E3) ∧
    ∀ k : ℕ, k ≤ 110 → ∀ ξ : E3, ξ ≠ 0 → ∀ σ : Fin k → Fin 3,
      ‖(iteratedFDeriv ℝ k m ξ) (fun r ↦ coordinateDirection (σ r))‖ ≤
        M * (α.radius ξ) ^ (-((α.derivativeWeight σ : ℕ) : ℝ))

theorem IsAnisotropicMultiplier.nonneg {α : Anisotropy} {M : ℝ} {m : E3 → ℂ}
    (h : IsAnisotropicMultiplier α M m) : 0 ≤ M := h.1

theorem IsAnisotropicMultiplier.measurable {α : Anisotropy} {M : ℝ} {m : E3 → ℂ}
    (h : IsAnisotropicMultiplier α M m) : Measurable m := h.2.1

theorem IsAnisotropicMultiplier.map_zero {α : Anisotropy} {M : ℝ} {m : E3 → ℂ}
    (h : IsAnisotropicMultiplier α M m) : m 0 = 0 := h.2.2.1

theorem IsAnisotropicMultiplier.norm_le {α : Anisotropy} {M : ℝ} {m : E3 → ℂ}
    (h : IsAnisotropicMultiplier α M m) {ξ : E3} (hξ : ξ ≠ 0) : ‖m ξ‖ ≤ M := by
  simpa [derivativeWeight] using
    h.2.2.2.2 0 (Nat.zero_le 110) ξ hξ (fun r ↦ Fin.elim0 r)

