      ∫ t in Ioi (0 : ℝ), ‖(a ν t * Φ ν t) / (t : ℂ)‖) := by
    refine Summable.of_nonneg_of_le
      (fun ν ↦ integral_nonneg fun t ↦ norm_nonneg _) (fun ν ↦ ?_)
      (((summable_intMode_sourceWeight_inv_110.mul_left (A * M)).mul_right
        ((cPsi ^ 3 / ((α.weight 2 : ℕ) : ℝ)) * IK)))
