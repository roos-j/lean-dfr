    _ = (C ^ 6 * S) * lam ^ 36 * translationWeight r ^ 20 *
        ∏ j : CubeVertex, treeLocalSize T 4 (F j) := by ring

/-- The face spatial integral is controlled uniformly on the closure of a
tree region by the product of tree-local fourth sizes. -/
theorem abs_integral_cubeFaceKernel_le_treeLocalSize_product_of_mem_closure
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α) (i : Fin 3)
      (lam r t : ℝ) (p : E3) (F : CubeVertex → E3 → ℝ),
      (∀ j, Continuous (F j)) →
      (∀ j, Measurable (F j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B) →
      1 ≤ lam →
      (p, t) ∈ closure (collectionRegion α T.boxes) →
      |∫ x : E6, cubeSignedInputProduct F x *
        cubeFaceKernel α i lam r t p x| ≤
        C * lam ^ 37 * translationWeight r ^ 21 *
          ∏ j : CubeVertex, treeLocalSize T 4 (F j) := by
  rcases abs_integral_cubeFaceKernel_le_bracketAverage α with
    ⟨C, hC, hface⟩
  let S : ℝ := boxScaleComparisonConstant α
  refine ⟨C * S,
    mul_nonneg hC (boxScaleComparisonConstant_nonneg α), ?_⟩
  intro T i lam r t p F hFcont hFmeas hFbound hlam hpt
  have ht : 0 < t := pos_of_mem_closure_collectionRegion α T.boxes hpt
  have hface' := hface i lam r t p F hFcont hFbound hlam ht
  have hsize := cubeBracketAverage_le_treeLocalSize_product_of_mem_closure
    T F hFcont hFmeas hFbound hpt
  have hfac : 0 ≤ C * lam ^ 37 * translationWeight r ^ 21 := by
    have hlam0 : 0 ≤ lam := by linarith
    have hR : 0 ≤ translationWeight r := by
      unfold translationWeight
      positivity
    change 0 ≤ (C * lam ^ (37 : ℕ)) * translationWeight r ^ (21 : ℕ)
    exact mul_nonneg
      (mul_nonneg hC (pow_nonneg hlam0 _))
      (pow_nonneg hR _)
  calc
    |∫ x : E6, cubeSignedInputProduct F x *
        cubeFaceKernel α i lam r t p x| ≤
        C * lam ^ 37 * translationWeight r ^ 21 *
          cubeBracketAverage α t p F := hface'
    _ ≤ C * lam ^ 37 * translationWeight r ^ 21 *
        (S * ∏ j : CubeVertex, treeLocalSize T 4 (F j)) :=
      mul_le_mul_of_nonneg_left hsize hfac
    _ = (C * S) * lam ^ 37 * translationWeight r ^ 21 *
        ∏ j : CubeVertex, treeLocalSize T 4 (F j) := by ring

/-! ### One-cell product-integrability bridge

The remaining source Fubini steps need genuinely joint center--scale--space
integrability.  We first record the elementary Borel measurability of the
variable-scale Gaussian factors; unlike the fixed-scale continuity lemmas,
these statements are valid at the totalized value `t = 0` as well. -/

/-- The variable center--scale--space Gaussian factor is Borel measurable. -/
theorem measurable_cubeGaussianKernel_center_scale_space
    (α : Anisotropy) (i : Fin 3) (b : Bool) (lam r : ℝ) :
    Measurable (fun z : (E3 × ℝ) × E6 ↦
      cubeGaussianKernel α lam r z.1.2 z.1.1 i (z.2 (i, b))) := by
  have ht : Measurable (fun z : (E3 × ℝ) × E6 ↦ z.1.2 ^ α.weight i) :=
    (measurable_snd.comp measurable_fst).pow_const _
  have hp : Measurable (fun z : (E3 × ℝ) × E6 ↦ z.1.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp
      (measurable_fst.comp measurable_fst)
  have hx : Measurable (fun z : (E3 × ℝ) × E6 ↦ z.2 (i, b)) :=
    (PiLp.continuous_apply (p := 2)
      (β := fun _ : Fin 3 × Bool ↦ ℝ) (i, b)).measurable.comp measurable_snd
  have hs : Measurable (fun z : (E3 × ℝ) × E6 ↦
      cubeWidth i lam * z.1.2 ^ α.weight i) := measurable_const.mul ht
  have ha : Measurable (fun z : (E3 × ℝ) × E6 ↦
      z.1.1 i + cubeCenterShift i r * z.1.2 ^ α.weight i) :=
    hp.add (measurable_const.mul ht)
  unfold cubeGaussianKernel gaussianAt kernelAt kernelDilate
  simpa only [smul_eq_mul] using
    (show Measurable (fun z : (E3 × ℝ) × E6 ↦
      (cubeWidth i lam * z.1.2 ^ α.weight i)⁻¹ *
        gaussian ((z.2 (i, b) -
          (z.1.1 i + cubeCenterShift i r * z.1.2 ^ α.weight i)) /
          (cubeWidth i lam * z.1.2 ^ α.weight i))) from
      hs.inv.mul (gaussian_contDiff.continuous.measurable.comp ((hx.sub ha).div hs)))

/-- The variable center--scale--space Gaussian derivative factor is Borel
measurable. -/
theorem measurable_cubeGaussianDerivKernel_center_scale_space
    (α : Anisotropy) (i : Fin 3) (b : Bool) (lam r : ℝ) :
    Measurable (fun z : (E3 × ℝ) × E6 ↦
      cubeGaussianDerivKernel α lam r z.1.2 z.1.1 i (z.2 (i, b))) := by
  have ht : Measurable (fun z : (E3 × ℝ) × E6 ↦ z.1.2 ^ α.weight i) :=
    (measurable_snd.comp measurable_fst).pow_const _
  have hp : Measurable (fun z : (E3 × ℝ) × E6 ↦ z.1.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp
      (measurable_fst.comp measurable_fst)
  have hx : Measurable (fun z : (E3 × ℝ) × E6 ↦ z.2 (i, b)) :=
    (PiLp.continuous_apply (p := 2)
      (β := fun _ : Fin 3 × Bool ↦ ℝ) (i, b)).measurable.comp measurable_snd
  have hs : Measurable (fun z : (E3 × ℝ) × E6 ↦
      cubeWidth i lam * z.1.2 ^ α.weight i) := measurable_const.mul ht
  have ha : Measurable (fun z : (E3 × ℝ) × E6 ↦
      z.1.1 i + cubeCenterShift i r * z.1.2 ^ α.weight i) :=
    hp.add (measurable_const.mul ht)
  have hderiv : Measurable gaussianDeriv := by
    unfold gaussianDeriv
    exact (measurable_const.mul measurable_id).mul
      gaussian_contDiff.continuous.measurable
  unfold cubeGaussianDerivKernel gaussianDerivAt kernelAt kernelDilate
  simpa only [smul_eq_mul] using
    (show Measurable (fun z : (E3 × ℝ) × E6 ↦
      (cubeWidth i lam * z.1.2 ^ α.weight i)⁻¹ *
        gaussianDeriv ((z.2 (i, b) -
          (z.1.1 i + cubeCenterShift i r * z.1.2 ^ α.weight i)) /
          (cubeWidth i lam * z.1.2 ^ α.weight i))) from
      hs.inv.mul (hderiv.comp ((hx.sub ha).div hs)))

/-- Joint a.e.-strong measurability of the variable-scale local kernel. -/
theorem aestronglyMeasurable_localCubeKernel_center_scale_space
    (α : Anisotropy) (i : Fin 3) (lam r : ℝ)
    (μ : Measure ((E3 × ℝ) × E6)) :
    AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      localCubeKernel α i lam r z.1.2 z.1.1 z.2) μ := by
  unfold localCubeKernel
  apply Finset.aestronglyMeasurable_fun_prod Finset.univ
  rintro ⟨q, b⟩ hq
  by_cases hqi : q = i
  · subst q
    simp only [↓reduceIte]
    exact (measurable_cubeGaussianDerivKernel_center_scale_space
      α i b lam r).aestronglyMeasurable
  · simp only [hqi, ↓reduceIte]
    exact (measurable_cubeGaussianKernel_center_scale_space
      α q b lam r).aestronglyMeasurable

/-- Joint a.e.-strong measurability of the variable-scale endpoint kernel. -/
theorem aestronglyMeasurable_cubeEndpointKernel_center_scale_space
    (α : Anisotropy) (lam r : ℝ) (μ : Measure ((E3 × ℝ) × E6)) :
    AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      cubeEndpointKernel α lam r z.1.2 z.1.1 z.2) μ := by
  unfold cubeEndpointKernel cubeCoordinateD
  apply Finset.aestronglyMeasurable_fun_prod Finset.univ
  intro i hi
  exact
    ((measurable_cubeGaussianKernel_center_scale_space
      α i false lam r).aestronglyMeasurable).mul
      ((measurable_cubeGaussianKernel_center_scale_space
        α i true lam r).aestronglyMeasurable)

/-- Joint a.e.-strong measurability of the variable-scale face kernel. -/
theorem aestronglyMeasurable_cubeFaceKernel_center_scale_space
    (α : Anisotropy) (i : Fin 3) (lam r : ℝ)
    (μ : Measure ((E3 × ℝ) × E6)) :
    AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      cubeFaceKernel α i lam r z.1.2 z.1.1 z.2) μ := by
  have hG0 : AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      cubeGaussianKernel α lam r z.1.2 z.1.1 i (z.2 (i, false))) μ :=
    (measurable_cubeGaussianKernel_center_scale_space
      α i false lam r).aestronglyMeasurable
  have hG1 : AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      cubeGaussianKernel α lam r z.1.2 z.1.1 i (z.2 (i, true))) μ :=
    (measurable_cubeGaussianKernel_center_scale_space
      α i true lam r).aestronglyMeasurable
  have hH0 : AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      cubeGaussianDerivKernel α lam r z.1.2 z.1.1 i (z.2 (i, false))) μ :=
    (measurable_cubeGaussianDerivKernel_center_scale_space
      α i false lam r).aestronglyMeasurable
  have hH1 : AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      cubeGaussianDerivKernel α lam r z.1.2 z.1.1 i (z.2 (i, true))) μ :=
    (measurable_cubeGaussianDerivKernel_center_scale_space
      α i true lam r).aestronglyMeasurable
  have hD : AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      cubeCoordinateD α i lam r z.1.2 z.1.1 z.2) μ := hG0.mul hG1
  have hB : AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      cubeBoundaryKernel α i lam r z.1.2 z.1.1 z.2) μ := by
    unfold cubeBoundaryKernel
    exact (aestronglyMeasurable_const.mul ((hH0.mul hG1).add (hG0.mul hH1))).sub
      (aestronglyMeasurable_const.mul hD)
  have hpassive : AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      ∏ m ∈ Finset.univ.erase i,
        cubeCoordinateD α m lam r z.1.2 z.1.1 z.2) μ := by
    apply Finset.aestronglyMeasurable_fun_prod (Finset.univ.erase i)
    intro m hm
    exact
      ((measurable_cubeGaussianKernel_center_scale_space
        α m false lam r).aestronglyMeasurable).mul
        ((measurable_cubeGaussianKernel_center_scale_space
          α m true lam r).aestronglyMeasurable)
  exact hB.mul hpassive

/-- The joint local-form integrand is a.e.-strongly measurable for every
product measure. -/
theorem aestronglyMeasurable_cubeSignedInputProduct_mul_localCubeKernel
    (α : Anisotropy) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (hFcont : ∀ j, Continuous (F j))
    (μ : Measure ((E3 × ℝ) × E6)) :
    AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      cubeSignedInputProduct F z.2 *
        localCubeKernel α i lam r z.1.2 z.1.1 z.2) μ := by
  exact
    (((continuous_cubeSignedInputProduct F hFcont).measurable.comp
      measurable_snd).aestronglyMeasurable).mul
      (aestronglyMeasurable_localCubeKernel_center_scale_space
        α i lam r μ)

/-- The joint endpoint-form integrand is a.e.-strongly measurable for every
product measure. -/
theorem aestronglyMeasurable_cubeSignedInputProduct_mul_cubeEndpointKernel
    (α : Anisotropy) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (hFcont : ∀ j, Continuous (F j))
    (μ : Measure ((E3 × ℝ) × E6)) :
    AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      cubeSignedInputProduct F z.2 *
        cubeEndpointKernel α lam r z.1.2 z.1.1 z.2) μ := by
  exact
    (((continuous_cubeSignedInputProduct F hFcont).measurable.comp
      measurable_snd).aestronglyMeasurable).mul
      (aestronglyMeasurable_cubeEndpointKernel_center_scale_space
        α lam r μ)

/-- The joint face-form integrand is a.e.-strongly measurable for every
product measure. -/
theorem aestronglyMeasurable_cubeSignedInputProduct_mul_cubeFaceKernel
    (α : Anisotropy) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (hFcont : ∀ j, Continuous (F j))
    (μ : Measure ((E3 × ℝ) × E6)) :
    AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      cubeSignedInputProduct F z.2 *
        cubeFaceKernel α i lam r z.1.2 z.1.1 z.2) μ := by
  exact
    (((continuous_cubeSignedInputProduct F hFcont).measurable.comp
      measurable_snd).aestronglyMeasurable).mul
      (aestronglyMeasurable_cubeFaceKernel_center_scale_space
        α i lam r μ)

/-- The logarithmic scale measure of one positive box-scale band is finite. -/
theorem isFiniteMeasure_boxScaleBand (q : AnisoBox α) :
    IsFiniteMeasure ((volume.withDensity cubeScaleDensity).restrict (boxScaleBand q)) := by
  apply (integrable_const_iff_isFiniteMeasure (by norm_num : (1 : ℝ) ≠ 0)).mp
  simpa only [IntegrableOn] using
    (integrableOn_boxScaleBand_of_continuous q (fun _ : ℝ ↦ (1 : ℝ))
      continuous_const)

/-- The literal center--scale measure of one box cell is finite. -/
theorem isFiniteMeasure_boxScaleCell (α : Anisotropy) (q : AnisoBox α) :
    IsFiniteMeasure
      ((volume.restrict (boxSet α q)).prod
        ((volume.withDensity cubeScaleDensity).restrict (boxScaleBand q))) := by
  letI : IsFiniteMeasure (volume.restrict (boxSet α q)) := by
    constructor
    rw [Measure.restrict_apply_univ]
    exact lt_top_iff_ne_top.mpr (volume_boxSet_ne_top α q)
  letI : IsFiniteMeasure
      ((volume.withDensity cubeScaleDensity).restrict (boxScaleBand q)) :=
    isFiniteMeasure_boxScaleBand q
  infer_instance

/-- The bracket weight at one fixed box center and scale remains integrable
after adjoining the finite center--scale cell as a passive factor. -/
theorem integrable_boxCenterBracketWeight_boxScaleCell
    (α : Anisotropy) (q : AnisoBox α) :
    Integrable (fun z : (E3 × ℝ) × E6 ↦
      cubeBracketWeight α (boxLength q) (boxCenter α q) z.2)
      (((volume.restrict (boxSet α q)).prod
        ((volume.withDensity cubeScaleDensity).restrict (boxScaleBand q))).prod volume) := by
  let μ : Measure (E3 × ℝ) :=
    (volume.restrict (boxSet α q)).prod
      ((volume.withDensity cubeScaleDensity).restrict (boxScaleBand q))
  letI : IsFiniteMeasure μ := by
    dsimp only [μ]
    exact isFiniteMeasure_boxScaleCell α q
  have hbase : Integrable (cubeBracketWeight α (boxLength q) (boxCenter α q)) :=
    integrable_cubeBracketWeight α (boxLength_pos q) (boxCenter α q)
  have hmeas : AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      cubeBracketWeight α (boxLength q) (boxCenter α q) z.2) (μ.prod volume) :=
    ((continuous_cubeBracketWeight α (boxLength_pos q) (boxCenter α q)).comp
      continuous_snd).aestronglyMeasurable
  refine (integrable_prod_iff hmeas).mpr ⟨?_, ?_⟩
  · filter_upwards [] with z
    exact hbase
  · have hconst : (fun z : E3 × ℝ ↦
        ∫ x : E6, ‖cubeBracketWeight α (boxLength q) (boxCenter α q) x‖) =
          fun _ ↦ (2 / 9 : ℝ) ^ 6 := by
      funext z
      rw [show (fun x : E6 ↦
          ‖cubeBracketWeight α (boxLength q) (boxCenter α q) x‖) =
          cubeBracketWeight α (boxLength q) (boxCenter α q) by
            funext x
            rw [Real.norm_eq_abs, abs_of_nonneg]
            exact cubeBracketWeight_nonneg α (boxLength_pos q).le
              (boxCenter α q) x]
      exact integral_cubeBracketWeight α (boxLength_pos q) (boxCenter α q)
    rw [hconst]
    exact integrable_const _

/-- A bracket-dominated kernel is jointly integrable in center, logarithmic
scale, and all spatial variables on one source box--scale cell.  The only
geometric input is the closed-cell comparison of the bracket weight to the
box's designated center and scale. -/
theorem integrable_boxScaleCell_of_bracket_domination
    (α : Anisotropy) (q : AnisoBox α) (F : CubeVertex → E3 → ℝ)
    (K : ℝ → E3 → E6 → ℝ)
    (hFbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B)
    (D : ℝ) (hD : 0 ≤ D)
    (hKmeas : AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      cubeSignedInputProduct F z.2 * K z.1.2 z.1.1 z.2)
      (((volume.restrict (boxSet α q)).prod
        ((volume.withDensity cubeScaleDensity).restrict (boxScaleBand q))).prod volume))
    (hdom : ∀ (t : ℝ) (p : E3) (x : E6), 0 < t →
      |K t p x| ≤ D * cubeBracketWeight α t p x) :
    Integrable (fun z : (E3 × ℝ) × E6 ↦
      cubeSignedInputProduct F z.2 * K z.1.2 z.1.1 z.2)
      (((volume.restrict (boxSet α q)).prod
        ((volume.withDensity cubeScaleDensity).restrict (boxScaleBand q))).prod volume) := by
  let μ : Measure (E3 × ℝ) :=
    (volume.restrict (boxSet α q)).prod
      ((volume.withDensity cubeScaleDensity).restrict (boxScaleBand q))
  let S : ℝ := boxScaleComparisonConstant α
  rcases exists_bound_cubeSignedInputProduct F hFbound with ⟨B, hB, hinput⟩
  have hS : 0 ≤ S := boxScaleComparisonConstant_nonneg α
  have hmajor : Integrable (fun z : (E3 × ℝ) × E6 ↦
      (B * D * S) * cubeBracketWeight α (boxLength q) (boxCenter α q) z.2)
      (μ.prod volume) := by
    simpa only [smul_eq_mul] using
      (integrable_boxCenterBracketWeight_boxScaleCell α q).const_mul
        (B * D * S)
  have hcell : ∀ᵐ z : E3 × ℝ ∂μ,
      z ∈ boxSet α q ×ˢ boxScaleBand q := by
    dsimp only [μ]
    change ∀ᵐ z : E3 × ℝ ∂
      (volume.restrict (boxSet α q)).prod
        ((volume.withDensity cubeScaleDensity).restrict (boxScaleBand q)),
      z ∈ boxSet α q ×ˢ Set.Ioc (boxLength q / 2) (boxLength q)
    rw [Measure.ae_prod_mem_iff_ae_ae_mem
      ((measurableSet_boxSet α q).prod measurableSet_Ioc)]
    filter_upwards [ae_restrict_mem (measurableSet_boxSet α q)] with p hp
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    exact ⟨hp, ht⟩
  have hcell' : ∀ᵐ z : (E3 × ℝ) × E6 ∂(μ.prod volume),
      z.1 ∈ boxSet α q ×ˢ boxScaleBand q :=
    (Measure.quasiMeasurePreserving_fst (μ := μ) (ν := volume)).ae hcell
  have hKmeas' : AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      cubeSignedInputProduct F z.2 * K z.1.2 z.1.1 z.2) (μ.prod volume) := by
    simpa only [μ] using hKmeas
  change Integrable (fun z : (E3 × ℝ) × E6 ↦
      cubeSignedInputProduct F z.2 * K z.1.2 z.1.1 z.2) (μ.prod volume)
  refine hmajor.mono hKmeas' ?_
  filter_upwards [hcell'] with z hz
  change z.1.1 ∈ boxSet α q ∧ z.1.2 ∈ boxScaleBand q at hz
  rcases hz with ⟨hp, htband⟩
  have htband' : z.1.2 ∈ Set.Ioc (boxLength q / 2) (boxLength q) := by
    simpa only [boxScaleBand] using htband
  have htpos : 0 < z.1.2 :=
    lt_trans (div_pos (boxLength_pos q) (by norm_num)) htband'.1
  have hpclosed : z.1.1 ∈ boxClosedSet α q :=
    boxSet_subset_boxClosedSet α q hp
  have hweight := cubeBracketWeight_le_boxCenterWeight
    α q hpclosed htpos htband'.1.le htband'.2 z.2
  have hkernel := hdom z.1.2 z.1.1 z.2 htpos
  have hmajor_nonneg : 0 ≤ (B * D * S) *
      cubeBracketWeight α (boxLength q) (boxCenter α q) z.2 := by
    exact mul_nonneg (mul_nonneg (mul_nonneg hB hD) hS)
      (cubeBracketWeight_nonneg α (boxLength_pos q).le (boxCenter α q) z.2)
  rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul, abs_of_nonneg hmajor_nonneg]
  calc
    |cubeSignedInputProduct F z.2| * |K z.1.2 z.1.1 z.2| ≤
        B * (D * cubeBracketWeight α z.1.2 z.1.1 z.2) :=
      mul_le_mul (hinput z.2) hkernel (abs_nonneg _) hB
    _ ≤ B * (D * (S *
        cubeBracketWeight α (boxLength q) (boxCenter α q) z.2)) := by
      exact mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hweight hD) hB
    _ = (B * D * S) *
        cubeBracketWeight α (boxLength q) (boxCenter α q) z.2 := by ring

/-- The local cube integrand is jointly integrable on one literal
center--scale cell, with the source loss `λ^36 R(r)^20`. -/
theorem integrable_cubeSignedInputProduct_mul_localCubeKernel_boxScaleCell
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ)
    (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B)
    (hlam : 1 ≤ lam) :
    Integrable (fun z : (E3 × ℝ) × E6 ↦
      cubeSignedInputProduct F z.2 *
        localCubeKernel α i lam r z.1.2 z.1.1 z.2)
      (((volume.restrict (boxSet α q)).prod
        ((volume.withDensity cubeScaleDensity).restrict (boxScaleBand q))).prod volume) := by
  rcases localCubeKernel_abs_domination α with ⟨C, hC, hdom⟩
  let D : ℝ := C ^ 6 * lam ^ 36 * translationWeight r ^ 20
  have hD : 0 ≤ D := by
    dsimp only [D]
    have hlam0 : 0 ≤ lam := by linarith
    have hR : 0 ≤ translationWeight r := by
      unfold translationWeight
      positivity
    exact mul_nonneg
      (mul_nonneg (pow_nonneg hC _) (pow_nonneg hlam0 _))
      (pow_nonneg hR _)
  apply integrable_boxScaleCell_of_bracket_domination
    α q F (fun t p x ↦ localCubeKernel α i lam r t p x) hFbound D hD
  · exact aestronglyMeasurable_cubeSignedInputProduct_mul_localCubeKernel
      α i lam r F hFcont _
  · intro t p x ht
    dsimp only [D]
    exact hdom i lam r t p x hlam ht

