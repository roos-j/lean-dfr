/-- Bounded continuous data make the full first-energy Gaussian
superposition integrable jointly in the collection variables, passive model
variables, and source scale. -/
theorem scratch_integrable_modelFirstSuperpositionJoint_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : ModelRealInput)
    (hfcont : ∀ j, Continuous (f j))
    (hfbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B) :
    Integrable (modelFirstSuperpositionJoint α u f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        ((volume : Measure ModelE5).prod
          ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) ) := by
  rcases hfbound 0 with ⟨B0, hB0, hf0⟩
  rcases hfbound 1 with ⟨B1, hB1, hf1⟩
  rcases hfbound 2 with ⟨B2, hB2, hf2⟩
  let g : ℝ → ℝ := fun r ↦ |conePsiPhysicalReal (r + u 2)|
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let M : ℝ := (B0 * B1 * B2) * ∫ v : ℝ, |gaussianDeriv v|
  have hgmeas : Measurable g := by
    dsimp only [g]
    exact continuous_abs.measurable.comp
      (conePsiPhysicalReal.continuous.measurable.comp
        (measurable_id.add measurable_const))
  have hg : Integrable g := by
    simpa only [g] using
      integrable_abs_conePsiPhysicalReal.comp_add_right (u 2)
  have hgnonneg : ∀ r, 0 ≤ g r := by
    intro r
    exact abs_nonneg _
  have hM : 0 ≤ M := by
    dsimp only [M]
    exact mul_nonneg (mul_nonneg (mul_nonneg hB0 hB1) hB2)
      (integral_nonneg fun v ↦ abs_nonneg (gaussianDeriv v))
  have hkernel := scratch_integrable_modelPassiveKernel_collection_sourceScale
    α S g hgmeas hg hgnonneg
  have hscale : ∀ᵐ q ∂(μ.prod ((volume : Measure ModelE5).prod ν)),
      0 < q.1.2 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · dsimp only [μ]
      filter_upwards [ae_restrict_mem (measurableSet_collectionRegion α S)]
        with pt hpt
      exact ae_of_all _ fun _ ↦ pos_of_mem_collectionRegion α S hpt
    · exact measurableSet_Ioi.preimage (measurable_snd.comp measurable_fst)
  have hlambda : ∀ᵐ q ∂(μ.prod ((volume : Measure ModelE5).prod ν)),
      1 ≤ q.2.2 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [] with pt
      rw [Measure.ae_prod_iff_ae_ae]
      · filter_upwards [] with z
        exact ae_restrict_mem measurableSet_Ici
      · exact measurableSet_Ici.preimage measurable_snd
    · exact measurableSet_Ici.preimage (measurable_snd.comp measurable_snd)
  have hmeas : AEStronglyMeasurable (modelFirstSuperpositionJoint α u f)
      (μ.prod ((volume : Measure ModelE5).prod ν)) := by
    have hfiber := scratch_aestronglyMeasurable_modelFirstFiber_lift
      α f hfcont (μ.prod ((volume : Measure ModelE5).prod ν))
    refine ((hfiber.pow 2).mul hkernel.aestronglyMeasurable).congr ?_
    filter_upwards [] with q
    change modelFirstFiber α f q.1.1 q.1.2 q.2.1 ^ 2 *
        (scratch_modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
          q.2.2 ^ (-47 : ℝ)) = _
    rw [scratch_modelPassiveKernel_eq]
    dsimp only [modelFirstSuperpositionJoint, modelFirstSuperpositionIntegrand, g]
    ring
  apply Integrable.mono' (hkernel.const_mul (M ^ 2)) hmeas
  filter_upwards [hscale, hlambda] with q ht hlam
  have hfiber : |modelFirstFiber α f q.1.1 q.1.2 q.2.1| ≤ M := by
    dsimp only [M]
    exact abs_modelFirstFiber_le α f q.1.1 q.2.1 hfcont B0 B1 B2
      hB0 hB1 hB2 hf0 hf1 hf2 ht
  have hsq : (modelFirstFiber α f q.1.1 q.1.2 q.2.1) ^ 2 ≤ M ^ 2 := by
    rw [← sq_abs]
    have hsub : 0 ≤ M - |modelFirstFiber α f q.1.1 q.1.2 q.2.1| :=
      sub_nonneg.mpr hfiber
    have hadd : 0 ≤ M + |modelFirstFiber α f q.1.1 q.1.2 q.2.1| :=
      add_nonneg hM (abs_nonneg _)
    nlinarith [mul_nonneg hsub hadd]
  have hpassive : 0 ≤ scratch_modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 :=
    scratch_modelPassiveKernel_nonneg α q.2.2 q.1.1 q.1.2 g hgnonneg hlam ht q.2.1
  have hpow : 0 ≤ q.2.2 ^ (-47 : ℝ) :=
    Real.rpow_nonneg (le_trans zero_le_one hlam) _
  have hweight : 0 ≤ scratch_modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
      q.2.2 ^ (-47 : ℝ) := mul_nonneg hpassive hpow
  have htargeteq : modelFirstSuperpositionJoint α u f q =
      modelFirstFiber α f q.1.1 q.1.2 q.2.1 ^ 2 *
        (scratch_modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
          q.2.2 ^ (-47 : ℝ)) := by
    dsimp only [modelFirstSuperpositionJoint, modelFirstSuperpositionIntegrand, g]
    rw [scratch_modelPassiveKernel_eq]
    ring
  have htarget : 0 ≤ modelFirstSuperpositionJoint α u f q := by
    rw [htargeteq]
    exact mul_nonneg (sq_nonneg _) hweight
  have hmajor : 0 ≤ M ^ 2 *
      (scratch_modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
        q.2.2 ^ (-47 : ℝ)) := mul_nonneg (sq_nonneg _) hweight
  have hle : modelFirstSuperpositionJoint α u f q ≤ M ^ 2 *
      (scratch_modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
        q.2.2 ^ (-47 : ℝ)) := by
    rw [htargeteq]
    exact mul_le_mul_of_nonneg_right hsq hweight
  simpa only [Real.norm_eq_abs, abs_of_nonneg htarget, abs_of_nonneg hmajor]
    using hle

/-- Bounded continuous data make the translated second-energy Gaussian
superposition integrable jointly in the collection variables, passive model
variables, and source scale. -/
theorem scratch_integrable_modelSecondSuperpositionJoint_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) :
    Integrable (modelSecondSuperpositionJoint α f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        ((volume : Measure ModelE5).prod
          ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) ) := by
  rcases hfbound with ⟨B, hB, hf⟩
  let g : ℝ → ℝ := fun r ↦ translationWeight r ^ (-50 : ℝ)
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let M : ℝ := B * ∫ v : ℝ, |gaussianDeriv v|
  have hRpos (r : ℝ) : 0 < translationWeight r := by
    unfold translationWeight
    positivity
  have hRone (r : ℝ) : 1 ≤ translationWeight r := by
    unfold translationWeight
    linarith [abs_nonneg r]
  have hgmeas : Measurable g := by
    dsimp only [g]
    exact ((continuous_const.add continuous_abs).rpow_const (fun r ↦
      Or.inl (ne_of_gt (hRpos r)))).measurable
  have hgnonneg : ∀ r, 0 ≤ g r := by
    intro r
    dsimp only [g]
    exact Real.rpow_nonneg (hRpos r).le _
  have hpowle (r : ℝ) :
      translationWeight r ^ (-50 : ℝ) ≤ translationWeight r ^ (-29 : ℝ) := by
    rw [show (-50 : ℝ) = (-29 : ℝ) + (-21 : ℝ) by norm_num,
      Real.rpow_add (hRpos r)]
    have hsmall : translationWeight r ^ (-21 : ℝ) ≤ 1 :=
      Real.rpow_le_one_of_one_le_of_nonpos (hRone r) (by norm_num)
    exact (mul_le_mul_of_nonneg_left hsmall
      (Real.rpow_nonneg (hRpos r).le _)).trans_eq (by ring)
  have hg : Integrable g := by
    apply Integrable.mono' integrable_translationWeight_negTwentyNine
      hgmeas.aestronglyMeasurable
    filter_upwards [] with r
    have hleft : 0 ≤ translationWeight r ^ (-50 : ℝ) := hgnonneg r
    have hright : 0 ≤ translationWeight r ^ (-29 : ℝ) :=
      Real.rpow_nonneg (hRpos r).le _
    simpa only [g, Real.norm_eq_abs, abs_of_nonneg hleft, abs_of_nonneg hright]
      using hpowle r
  have hM : 0 ≤ M := by
    dsimp only [M]
    exact mul_nonneg hB
      (integral_nonneg fun v ↦ abs_nonneg (gaussianDeriv v))
  have hkernel := scratch_integrable_modelPassiveKernel_collection_sourceScale
    α S g hgmeas hg hgnonneg
  have hscale : ∀ᵐ q ∂(μ.prod ((volume : Measure ModelE5).prod ν)),
      0 < q.1.2 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · dsimp only [μ]
      filter_upwards [ae_restrict_mem (measurableSet_collectionRegion α S)]
        with pt hpt
      exact ae_of_all _ fun _ ↦ pos_of_mem_collectionRegion α S hpt
    · exact measurableSet_Ioi.preimage (measurable_snd.comp measurable_fst)
  have hlambda : ∀ᵐ q ∂(μ.prod ((volume : Measure ModelE5).prod ν)),
      1 ≤ q.2.2 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [] with pt
      rw [Measure.ae_prod_iff_ae_ae]
      · filter_upwards [] with z
        exact ae_restrict_mem measurableSet_Ici
      · exact measurableSet_Ici.preimage measurable_snd
    · exact measurableSet_Ici.preimage (measurable_snd.comp measurable_snd)
  have hmeas : AEStronglyMeasurable (modelSecondSuperpositionJoint α f)
      (μ.prod ((volume : Measure ModelE5).prod ν)) := by
    have hfiber := scratch_aestronglyMeasurable_modelSecondFiber_lift
      α f hfcont (μ.prod ((volume : Measure ModelE5).prod ν))
    refine ((hfiber.pow 2).mul hkernel.aestronglyMeasurable).congr ?_
    filter_upwards [] with q
    change modelSecondFiber α f q.1.1 q.1.2 q.2.1 ^ 2 *
        (scratch_modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
          q.2.2 ^ (-47 : ℝ)) = _
    rw [scratch_modelPassiveKernel_eq]
    dsimp only [modelSecondSuperpositionJoint,
      modelSecondSuperpositionIntegrand, g]
    ring
  apply Integrable.mono' (hkernel.const_mul (M ^ 2)) hmeas
  filter_upwards [hscale, hlambda] with q ht hlam
  have hfiber : |modelSecondFiber α f q.1.1 q.1.2 q.2.1| ≤ M := by
    dsimp only [M]
    exact abs_modelSecondFiber_le α f q.1.1 q.2.1 hfcont B hB hf ht
  have hsq : (modelSecondFiber α f q.1.1 q.1.2 q.2.1) ^ 2 ≤ M ^ 2 := by
    rw [← sq_abs]
    have hsub : 0 ≤ M - |modelSecondFiber α f q.1.1 q.1.2 q.2.1| :=
      sub_nonneg.mpr hfiber
    have hadd : 0 ≤ M + |modelSecondFiber α f q.1.1 q.1.2 q.2.1| :=
      add_nonneg hM (abs_nonneg _)
    nlinarith [mul_nonneg hsub hadd]
  have hpassive : 0 ≤ scratch_modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 :=
    scratch_modelPassiveKernel_nonneg α q.2.2 q.1.1 q.1.2 g hgnonneg hlam ht q.2.1
  have hpow : 0 ≤ q.2.2 ^ (-47 : ℝ) :=
    Real.rpow_nonneg (le_trans zero_le_one hlam) _
  have hweight : 0 ≤ scratch_modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
      q.2.2 ^ (-47 : ℝ) := mul_nonneg hpassive hpow
  have htargeteq : modelSecondSuperpositionJoint α f q =
      modelSecondFiber α f q.1.1 q.1.2 q.2.1 ^ 2 *
        (scratch_modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
          q.2.2 ^ (-47 : ℝ)) := by
    dsimp only [modelSecondSuperpositionJoint,
      modelSecondSuperpositionIntegrand, g]
    rw [scratch_modelPassiveKernel_eq]
    ring
  have htarget : 0 ≤ modelSecondSuperpositionJoint α f q := by
    rw [htargeteq]
    exact mul_nonneg (sq_nonneg _) hweight
  have hmajor : 0 ≤ M ^ 2 *
      (scratch_modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
        q.2.2 ^ (-47 : ℝ)) := mul_nonneg (sq_nonneg _) hweight
  have hle : modelSecondSuperpositionJoint α f q ≤ M ^ 2 *
      (scratch_modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
        q.2.2 ^ (-47 : ℝ)) := by
    rw [htargeteq]
    exact mul_le_mul_of_nonneg_right hsq hweight
  simpa only [Real.norm_eq_abs, abs_of_nonneg htarget, abs_of_nonneg hmajor]
    using hle

/-- The annular physical cutoff is nonzero, hence its absolute `L¹` mass is
strictly positive.  This permits recovery of the first cube form from the
first superposition after its annular variable has been integrated out. -/
theorem scratch_conePsiPhysicalRealL1_pos : 0 < conePsiPhysicalRealL1 := by
  have hnonzero : ∃ x : ℝ, conePsiPhysicalReal x ≠ 0 := by
    classical
    by_contra h
    push_neg at h
    have hzero : conePsiPhysical = 0 := by
      ext x
      rw [← conePsiPhysical_eq_ofReal x, h x]
      norm_num
    have hfourier : conePsiSchwartz = 0 := by
      have h' := congrArg (fun G : SchwartzMap ℝ ℂ ↦ 𝓕 G) hzero
      simpa only [schwartzFourier_conePsiPhysical,
        FourierTransform.fourier_zero] using h'
    have hvalue := congrArg (fun G : SchwartzMap ℝ ℂ ↦ G (3 / 2 : ℝ)) hfourier
    rw [conePsiSchwartz_apply,
      conePsi_eq_one_on_core (by norm_num : |(3 / 2 : ℝ) - 3 / 2| ≤ 1 / 8)] at hvalue
    norm_num at hvalue
  rcases hnonzero with ⟨x, hx⟩
  unfold conePsiPhysicalRealL1
  exact integral_pos_of_integrable_nonneg_nonzero
    (continuous_abs.comp conePsiPhysicalReal.continuous)
    integrable_abs_conePsiPhysicalReal
    (fun r ↦ abs_nonneg _)
    (abs_ne_zero.mpr hx)

/-- The bounded-continuous first superposition supplies the normalized
source-scale integrability required by the full-cube tree estimate. -/
theorem scratch_integrableOn_modelFirstCubeComparison_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : ModelRealInput)
    (hfcont : ∀ j, Continuous (f j))
    (hfbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B) :
    IntegrableOn (fun lam : ℝ ↦
      localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
        lam ^ (-47 : ℝ)) (Set.Ici (1 : ℝ)) := by
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let η : Measure ModelE5 := volume
  let e := outerLambdaShuffleRight (E3 × ℝ) ModelE5
  let H : ℝ → ℝ := fun lam ↦
    ∫ xy : (E3 × ℝ) × ModelE5,
      modelFirstSuperpositionJoint α u f (xy.1, (xy.2, lam)) ∂(μ.prod η)
  have hsuper := scratch_integrable_modelFirstSuperpositionJoint_of_boundedContinuous
    α S u f hfcont hfbound
  have hFcont : ∀ j, Continuous (modelFirstCubeTuple f j) :=
    continuous_modelFirstCubeTuple f hfcont
  have hFbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y,
      |modelFirstCubeTuple f j y| ≤ B :=
    bounded_modelFirstCubeTuple f hfbound
  letI : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  have hmp : MeasurePreserving e (μ.prod (η.prod ν)) (ν.prod (μ.prod η)) := by
    simpa only [e, μ, η, ν] using
      outerLambdaShuffleRight_measurePreserving μ η
  have htrans : Integrable (fun q : ℝ × ((E3 × ℝ) × ModelE5) ↦
      modelFirstSuperpositionJoint α u f (e.symm q)) (ν.prod (μ.prod η)) := by
    exact (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hsuper
  have hfib : ∀ᵐ lam ∂ν, Integrable (fun xy : (E3 × ℝ) × ModelE5 ↦
      modelFirstSuperpositionJoint α u f
        (xy.1, (xy.2, lam))) (μ.prod η) := by
    have h := (MeasureTheory.integrable_prod_iff htrans.aestronglyMeasurable).mp
      htrans
    filter_upwards [h.1] with lam hlamint
    refine hlamint.congr ?_
    filter_upwards [] with xy
    rw [outerLambdaShuffleRight_symm_apply]
  have hlam : ∀ᵐ lam ∂ν, 1 ≤ lam := by
    filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
    exact hlam
  have hH : Integrable H ν := by
    refine htrans.integral_prod_left.congr ?_
    filter_upwards [] with lam
    dsimp only [H]
    apply integral_congr_ae
    filter_upwards [] with xy
    rw [outerLambdaShuffleRight_symm_apply]
  have hEq : H =ᵐ[ν] fun lam ↦
      conePsiPhysicalRealL1 *
        localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
          lam ^ (-47 : ℝ) := by
    filter_upwards [hfib, hlam] with lam hlamint hlam
    have hpassive := integrable_modelFirstPassiveSquare
      α S lam f false hFcont hFbound hlam
    dsimp only [H]
    calc
      ∫ xy : (E3 × ℝ) × ModelE5,
          modelFirstSuperpositionJoint α u f
            (xy.1, (xy.2, lam)) ∂(μ.prod η) =
          ∫ pt : E3 × ℝ, ∫ z : ModelE5,
            modelFirstSuperpositionJoint α u f
              (pt, (z, lam)) ∂η ∂μ :=
        MeasureTheory.integral_prod _ hlamint
      _ = ∫ pt : E3 × ℝ,
          ((∫ y : TransverseSpace 2 × TransverseSpace 2,
            cubePassiveGaussianKernel α 2 lam 0 pt.2 pt.1 y *
              (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) false
                ((pt.1, pt.2), y)) ^ 2
            ∂((volume : Measure (TransverseSpace 2)).prod
              (volume : Measure (TransverseSpace 2)))) *
            conePsiPhysicalRealL1) * lam ^ (-47 : ℝ) ∂μ := by
          apply integral_congr_ae
          filter_upwards [] with pt
          calc
            ∫ z : ModelE5,
                modelFirstSuperpositionJoint α u f
                  (pt, (z, lam)) ∂η =
                (∫ z : ModelE5,
                  (modelFirstFiber α f pt.1 pt.2 z) ^ 2 *
                    |conePsiPhysicalReal (z 4 + u 2)| *
                    modelFirstPassiveGaussianWeight α lam pt.1 pt.2
                      (z 0) (z 1) (z 2) (z 3)) * lam ^ (-47 : ℝ) := by
                  rw [← MeasureTheory.integral_mul_const]
                  apply integral_congr_ae
                  filter_upwards [] with z
                  dsimp only [modelFirstSuperpositionJoint,
                    modelFirstSuperpositionIntegrand]
            _ = _ := by
              rw [integral_modelFirstFiber_sq_psi_passiveWeight
                α lam f false pt.1 pt.2 (u 2)]
      _ = conePsiPhysicalRealL1 *
          (∫ pt : E3 × ℝ,
            ∫ y : TransverseSpace 2 × TransverseSpace 2,
              cubePassiveGaussianKernel α 2 lam 0 pt.2 pt.1 y *
                (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) false
                  ((pt.1, pt.2), y)) ^ 2
              ∂((volume : Measure (TransverseSpace 2)).prod
                (volume : Measure (TransverseSpace 2))) ∂μ) *
            lam ^ (-47 : ℝ) := by
              rw [show (∫ pt : E3 × ℝ,
                  ((∫ y : TransverseSpace 2 × TransverseSpace 2,
                    cubePassiveGaussianKernel α 2 lam 0 pt.2 pt.1 y *
                      (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) false
                        ((pt.1, pt.2), y)) ^ 2
                    ∂((volume : Measure (TransverseSpace 2)).prod
                      (volume : Measure (TransverseSpace 2)))) *
                    conePsiPhysicalRealL1) * lam ^ (-47 : ℝ) ∂μ) =
                  (conePsiPhysicalRealL1 * lam ^ (-47 : ℝ)) *
                    ∫ pt : E3 × ℝ,
                      ∫ y : TransverseSpace 2 × TransverseSpace 2,
                        cubePassiveGaussianKernel α 2 lam 0 pt.2 pt.1 y *
                          (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) false
                            ((pt.1, pt.2), y)) ^ 2
                        ∂((volume : Measure (TransverseSpace 2)).prod
                          (volume : Measure (TransverseSpace 2))) ∂μ by
                    rw [← MeasureTheory.integral_const_mul]
                    apply integral_congr_ae
                    filter_upwards [] with pt
                    ring]
              ring
      _ = conePsiPhysicalRealL1 *
          localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
            lam ^ (-47 : ℝ) := by
              rw [← (MeasureTheory.integral_prod _ hpassive)]
              rw [← localCubeForm_modelFirst_eq_passiveSquare
                α S lam f false hFcont hFbound hlam]
  have hscaled : Integrable (fun lam ↦
      conePsiPhysicalRealL1 *
        localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
          lam ^ (-47 : ℝ)) ν := hH.congr hEq
  have hpositive := scratch_conePsiPhysicalRealL1_pos
  have hform := hscaled.const_mul conePsiPhysicalRealL1⁻¹
  refine hform.congr ?_
  filter_upwards [] with lam
  field_simp [ne_of_gt hpositive]

/-- The joint coordinate reordering for the second superposition: source
scale and translation become the two outer variables, while the collection
and transverse passive variables are retained as the inner block. -/
noncomputable def scratch_modelSecondSuperpositionShuffle :
    (E3 × ℝ) × (ModelE5 × ℝ) ≃ᵐ
      (ℝ × ℝ) × ((E3 × ℝ) ×
        (TransverseSpace 2 × TransverseSpace 2)) :=
  (((((outerLambdaShuffleRight (E3 × ℝ) ModelE5).trans
    (MeasurableEquiv.prodAssoc.symm :
      ℝ × ((E3 × ℝ) × ModelE5) ≃ᵐ (ℝ × (E3 × ℝ)) × ModelE5)).trans
    (modelFirstPassiveCoordinatesProd (ℝ × (E3 × ℝ)))).trans
    (crossShuffle ℝ (E3 × ℝ)
      (TransverseSpace 2 × TransverseSpace 2) ℝ)).trans
    (MeasurableEquiv.prodComm :
      ((TransverseSpace 2 × TransverseSpace 2) × (E3 × ℝ)) × (ℝ × ℝ) ≃ᵐ
        (ℝ × ℝ) × ((TransverseSpace 2 × TransverseSpace 2) × (E3 × ℝ)))).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (ℝ × ℝ))
      (MeasurableEquiv.prodComm :
        (TransverseSpace 2 × TransverseSpace 2) × (E3 × ℝ) ≃ᵐ
          (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2)))

@[simp] theorem scratch_modelSecondSuperpositionShuffle_apply
    (pt : E3 × ℝ) (z : ModelE5) (lam : ℝ) :
    scratch_modelSecondSuperpositionShuffle (pt, (z, lam)) =
      ((lam, z 4),
        (pt, modelFirstPassivePair (z 0) (z 1) (z 2) (z 3))) := by
  simp [scratch_modelSecondSuperpositionShuffle, outerLambdaShuffleRight,
    MeasurableEquiv.prodAssoc, MeasurableEquiv.prodComm,
    MeasurableEquiv.prodCongr, modelFirstPassiveCoordinatesProd_apply,
    crossShuffle, swapMiddle]

@[simp] theorem scratch_modelSecondSuperpositionShuffle_symm_apply
    (lam r : ℝ) (pt : E3 × ℝ)
    (y : TransverseSpace 2 × TransverseSpace 2) :
    scratch_modelSecondSuperpositionShuffle.symm ((lam, r), (pt, y)) =
      (pt, (modelFirstPassiveCoordinates.symm (y, r), lam)) := by
  apply scratch_modelSecondSuperpositionShuffle.injective
  rw [MeasurableEquiv.apply_symm_apply,
    scratch_modelSecondSuperpositionShuffle_apply,
    modelFirstPassiveCoordinates_symm_translation,
    modelFirstPassiveCoordinates_symm_passive]

/-- The second-superposition shuffle preserves the exact product measures
used by the source-scale/translation Fubini argument. -/
theorem scratch_modelSecondSuperpositionShuffle_measurePreserving
    (μ : Measure (E3 × ℝ)) [SFinite μ] :
    MeasurePreserving scratch_modelSecondSuperpositionShuffle
      (μ.prod ((volume : Measure ModelE5).prod
        ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))))
      ((((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))).prod volume).prod
        (μ.prod ((volume : Measure (TransverseSpace 2)).prod
          (volume : Measure (TransverseSpace 2))))) := by
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let η : Measure ModelE5 := volume
  let κ : Measure (TransverseSpace 2 × TransverseSpace 2) :=
    (volume : Measure (TransverseSpace 2)).prod volume
  letI : SFinite ν := by
    dsimp only [ν]
    infer_instance
  letI : SFinite (ν.prod (volume : Measure ℝ)) := by
    infer_instance
  have h₁ : MeasurePreserving (outerLambdaShuffleRight (E3 × ℝ) ModelE5)
      (μ.prod (η.prod ν)) (ν.prod (μ.prod η)) := by
    simpa only [ν, η] using
      outerLambdaShuffleRight_measurePreserving μ η
  have h₂ : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        ℝ × ((E3 × ℝ) × ModelE5) ≃ᵐ (ℝ × (E3 × ℝ)) × ModelE5)
      (ν.prod (μ.prod η)) ((ν.prod μ).prod η) :=
    (measurePreserving_prodAssoc ν μ η).symm
  have h₃ : MeasurePreserving
      (modelFirstPassiveCoordinatesProd (ℝ × (E3 × ℝ)))
      ((ν.prod μ).prod η) ((ν.prod μ).prod (κ.prod volume)) := by
    simpa only [κ, η] using
      modelFirstPassiveCoordinatesProd_measurePreserving (ν.prod μ)
  have h₄ : MeasurePreserving
      (crossShuffle ℝ (E3 × ℝ)
        (TransverseSpace 2 × TransverseSpace 2) ℝ)
      ((ν.prod μ).prod (κ.prod volume))
      ((κ.prod μ).prod (ν.prod volume)) := by
    simpa only [κ] using
      crossShuffle_measurePreserving ℝ (E3 × ℝ)
        (TransverseSpace 2 × TransverseSpace 2) ℝ ν μ κ volume
  have h₅ : MeasurePreserving
      (MeasurableEquiv.prodComm :
        ((TransverseSpace 2 × TransverseSpace 2) × (E3 × ℝ)) × (ℝ × ℝ) ≃ᵐ
          (ℝ × ℝ) × ((TransverseSpace 2 × TransverseSpace 2) × (E3 × ℝ)))
      ((κ.prod μ).prod (ν.prod volume))
      ((ν.prod volume).prod (κ.prod μ)) :=
    Measure.measurePreserving_swap
  have h₆ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (ℝ × ℝ))
        (MeasurableEquiv.prodComm :
          (TransverseSpace 2 × TransverseSpace 2) × (E3 × ℝ) ≃ᵐ
            (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2)))
      ((ν.prod volume).prod (κ.prod μ))
      ((ν.prod volume).prod (μ.prod κ)) := by
    convert (MeasurePreserving.id (ν.prod volume)).prod
      (Measure.measurePreserving_swap : MeasurePreserving Prod.swap
        (κ.prod μ) (μ.prod κ)) using 1 <;> try infer_instance
    funext q
    rfl
  simpa only [scratch_modelSecondSuperpositionShuffle, ν, η, κ] using
    (((((h₁.trans h₂).trans h₃).trans h₄).trans h₅).trans h₆)

/-- The bounded-continuous second superposition supplies the joint
source-scale/translation integrability required by the edge-tree estimate. -/
theorem scratch_integrable_modelSecondCubeComparison_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) :
    Integrable (fun z : ℝ × ℝ ↦
      localCubeForm α S 2 z.1 z.2 (edgeCubeTuple f) *
        translationWeight z.2 ^ (-50 : ℝ) * z.1 ^ (-47 : ℝ))
      (((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))).prod volume) := by
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let κ : Measure (TransverseSpace 2 × TransverseSpace 2) :=
    (volume : Measure (TransverseSpace 2)).prod volume
  letI : IsFiniteMeasure μ := by
    dsimp only [μ]
    exact isFiniteMeasure_cubeScaleCollection α S
  letI : SFinite ν := by
    dsimp only [ν]
    infer_instance
  letI : SFinite (ν.prod (volume : Measure ℝ)) := by infer_instance
  letI : SFinite κ := by
    dsimp only [κ]
    infer_instance
  letI : SFinite (μ.prod κ) := by infer_instance
  let e := scratch_modelSecondSuperpositionShuffle
  let G : (ℝ × ℝ) × ((E3 × ℝ) ×
      (TransverseSpace 2 × TransverseSpace 2)) → ℝ := fun q ↦
    cubePassiveGaussianKernel α 2 q.1.1 q.1.2 q.2.1.2 q.2.1.1 q.2.2 *
      (cubeActiveCSAverage α 2 q.1.1 q.1.2 (edgeCubeTuple f) false q.2) ^ 2 *
        translationWeight q.1.2 ^ (-50 : ℝ) * q.1.1 ^ (-47 : ℝ)
  have hsuper := scratch_integrable_modelSecondSuperpositionJoint_of_boundedContinuous
    α S f hfcont hfbound
  have hmp : MeasurePreserving e
      (μ.prod ((volume : Measure ModelE5).prod ν))
      ((ν.prod volume).prod (μ.prod κ)) := by
    simpa only [e, μ, ν, κ] using
      scratch_modelSecondSuperpositionShuffle_measurePreserving μ
  have htransport : Integrable (fun q : (ℝ × ℝ) × ((E3 × ℝ) ×
      (TransverseSpace 2 × TransverseSpace 2)) ↦
      modelSecondSuperpositionJoint α f (e.symm q))
      ((ν.prod volume).prod (μ.prod κ)) := by
    exact (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hsuper
  have hkernel : Integrable G ((ν.prod volume).prod (μ.prod κ)) := by
    refine htransport.congr ?_
    filter_upwards [] with q
    rcases q with ⟨⟨lam, r⟩, ⟨pt, y⟩⟩
    change modelSecondSuperpositionJoint α f
        (e.symm ((lam, r), (pt, y))) = G ((lam, r), (pt, y))
    rw [show e = scratch_modelSecondSuperpositionShuffle by rfl,
      scratch_modelSecondSuperpositionShuffle_symm_apply]
    dsimp only [G, modelSecondSuperpositionJoint,
      modelSecondSuperpositionIntegrand]
    rw [← cubeActiveCSAverage_modelSecond α lam f false pt.1 pt.2
      (modelFirstPassiveCoordinates.symm (y, r)),
      ← cubePassiveGaussianKernel_modelFirst α lam r pt.1 pt.2
        ((modelFirstPassiveCoordinates.symm (y, r)) 0)
        ((modelFirstPassiveCoordinates.symm (y, r)) 1)
        ((modelFirstPassiveCoordinates.symm (y, r)) 2)
        ((modelFirstPassiveCoordinates.symm (y, r)) 3),
      modelFirstPassiveCoordinates_symm_passive,
      modelFirstPassiveCoordinates_symm_translation]
    ring
  have houter : Integrable (fun lr : ℝ × ℝ ↦
      ∫ w : (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2),
        G (lr, w) ∂(μ.prod κ)) (ν.prod volume) :=
    hkernel.integral_prod_left
  have hlam : ∀ᵐ lr ∂(ν.prod (volume : Measure ℝ)), 1 ≤ lr.1 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
      exact ae_of_all _ fun _ ↦ hlam
    · exact measurableSet_Ici.preimage measurable_fst
  refine houter.congr ?_
  filter_upwards [hlam] with lr hlr
  have hform : localCubeForm α S 2 lr.1 lr.2 (edgeCubeTuple f) =
      ∫ w : (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2),
        cubePassiveGaussianKernel α 2 lr.1 lr.2 w.1.2 w.1.1 w.2 *
          (cubeActiveCSAverage α 2 lr.1 lr.2 (edgeCubeTuple f) false w) ^ 2
        ∂(μ.prod κ) := by
    simpa only [μ, κ] using localCubeForm_edge_eq_passiveSquare
      α S lr.1 lr.2 f false hfcont hfbound hlr
  dsimp only [G]
  calc
    (∫ w : (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2),
        cubePassiveGaussianKernel α 2 lr.1 lr.2 w.1.2 w.1.1 w.2 *
          (cubeActiveCSAverage α 2 lr.1 lr.2 (edgeCubeTuple f) false w) ^ 2 *
            translationWeight lr.2 ^ (-50 : ℝ) * lr.1 ^ (-47 : ℝ)
        ∂(μ.prod κ)) =
        (translationWeight lr.2 ^ (-50 : ℝ) * lr.1 ^ (-47 : ℝ)) *
          ∫ w : (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2),
            cubePassiveGaussianKernel α 2 lr.1 lr.2 w.1.2 w.1.1 w.2 *
              (cubeActiveCSAverage α 2 lr.1 lr.2 (edgeCubeTuple f) false w) ^ 2
            ∂(μ.prod κ) := by
              rw [← MeasureTheory.integral_const_mul]
              apply integral_congr_ae
              filter_upwards [] with w
              ring
    _ = localCubeForm α S 2 lr.1 lr.2 (edgeCubeTuple f) *
        translationWeight lr.2 ^ (-50 : ℝ) * lr.1 ^ (-47 : ℝ) := by
          rw [← hform]
          ring

/-- Bounded continuous source data meet all four literal integrability inputs
to the source-stopping tree energy estimates. -/
theorem scratch_sourceStoppingTreeEnergyIntegrability_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (f : ModelRealInput)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B) :
    sourceStoppingTreeEnergyIntegrability α S hS u f := by
  intro n Q
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact scratch_integrable_modelFirstSuperpositionJoint_of_boundedContinuous
      α (sourceStoppingTree α S hS f n Q).boxes u f hcont hbound
  · exact scratch_integrableOn_modelFirstCubeComparison_of_boundedContinuous
      α (sourceStoppingTree α S hS f n Q).boxes u f hcont hbound
  · exact scratch_integrable_modelSecondSuperpositionJoint_of_boundedContinuous
      α (sourceStoppingTree α S hS f n Q).boxes (f 3) (hcont 3) (hbound 3)
  · exact scratch_integrable_modelSecondCubeComparison_of_boundedContinuous
      α (sourceStoppingTree α S hS f n Q).boxes (f 3) (hcont 3) (hbound 3)

/-- The two stopping-tree analytic hypotheses are automatic for bounded
continuous input functions and a bounded measurable scale coefficient. -/
theorem scratch_sourceStoppingTreeAnalyticPremises_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (hcmeas : Measurable c)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    sourceStoppingTreeCS α S hS u c f ∧
      sourceStoppingTreeEnergyIntegrability α S hS u f := by
  exact ⟨scratch_sourceStoppingTreeCS_of_boundedContinuous
      α S hS u c f hcmeas hcont hbound hc,
    scratch_sourceStoppingTreeEnergyIntegrability_of_boundedContinuous
      α S hS u f hcont hbound⟩

/-- The stopping-tree analytic premises specialize directly to real Schwartz
input tuples used in the initial model range. -/
theorem scratch_initialModel_sourceStoppingTreeAnalyticPremises
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (F : InitialModelSchwartzInput)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1) :
    sourceStoppingTreeCS α S hS u c (InitialModelRealInput F) ∧
      sourceStoppingTreeEnergyIntegrability α S hS u (InitialModelRealInput F) := by
  exact scratch_sourceStoppingTreeAnalyticPremises_of_boundedContinuous
    α S hS u c (InitialModelRealInput F) hcmeas
    (initialModelRealInput_continuous F) (initialModelRealInput_bounded F) hc

