    refine hsafeouter.aestronglyMeasurable.congr ?_
    filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
    rw [max_eq_left hlam]
  have houter : Integrable (fun lam : ℝ ↦ lam ^ (-47 : ℝ) * C) ν := by
