      _ = lam ^ (-47 : ℝ) *
          ∫ pt : E3 × ℝ, ∫ r : ℝ, g r ∂volume ∂μ := by
              congr 1
              apply integral_congr_ae
              filter_upwards [hpos] with pt hpt
              exact scratch_integral_norm_modelPassiveKernel α lam pt.1 pt.2 g
