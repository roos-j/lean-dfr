    rw [← Real.rpow_mul ht.le, mul_inv_cancel₀ (ne_of_gt ha), Real.rpow_one]
  constructor
  · have hlt : xi⁻¹ < t ^ a := by
      rw [inv_lt_iff_one_lt_mul₀ hxi, mul_comm]
      exact h1
