/-- **Absolute convergence.**  The active scale integrand is integrable on the
positive half-line. -/
theorem integrableOn_coneActiveScale {xi a : ℝ} (hxi : 0 < xi) (ha : 0 < a) :
    IntegrableOn (fun t : ℝ ↦ coneActiveProfile (xi * t ^ a) / t) (Ioi 0) := by
