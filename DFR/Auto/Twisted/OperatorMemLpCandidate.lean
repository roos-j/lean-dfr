    (hf : Measurable f) (B : ℝ) (hfB : ∀ y : E3, |f y| ≤ B)
    (A : ℝ) (hA : ∀ r : ℝ, |f (x - r • Anisotropy.coordinateDirection i)| ≤ A)
    (hk : Integrable k) (hs : 0 < s) :
    |ModelCoordinateConvolution i f k s x| ≤ A * ∫ r : ℝ, |k r| := by
