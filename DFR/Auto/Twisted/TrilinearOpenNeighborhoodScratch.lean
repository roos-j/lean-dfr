    (p₁ p₂ p₃ a₁ a₂ a₃ C : ℝ)
    (hp₁ : 0 < p₁) (hp₂ : 0 < p₂) (hp₃ : 0 < p₃)
    (ha₁ : 0 ≤ a₁) (ha₂ : 0 ≤ a₂) (ha₃ : 0 ≤ a₃)
    (hside₁ : if positive₁ then p₁⁻¹ < a₁ else a₁ < p₁⁻¹)
    (hside₂ : if positive₂ then p₂⁻¹ < a₂ else a₂ < p₂⁻¹)
    (hside₃ : if positive₃ then p₃⁻¹ < a₃ else a₃ < p₃⁻¹)
    (hC : 0 ≤ C)
    (hm₁ : ∀ i ∈ s₁, 0 ≤ m₁ i)
    (hm₂ : ∀ j ∈ s₂, 0 ≤ m₂ j)
    (hm₃ : ∀ k ∈ s₃, 0 ≤ m₃ k)
    (hlevel₁ : ∀ i ∈ s₁, ‖c₁ i‖ =
      (2 : ℝ) ^ scratch_fixedSignDyadicHeight positive₁ i)
    (hlevel₂ : ∀ j ∈ s₂, ‖c₂ j‖ =
      (2 : ℝ) ^ scratch_fixedSignDyadicHeight positive₂ j)
    (hlevel₃ : ∀ k ∈ s₃, ‖c₃ k‖ =
      (2 : ℝ) ^ scratch_fixedSignDyadicHeight positive₃ k)
    (hmass₁ : ∀ i ∈ s₁,
      (2 : ℝ) ^ (scratch_fixedSignDyadicHeight positive₁ i * p₁) * m₁ i ≤ 1)
    (hmass₂ : ∀ j ∈ s₂,
      (2 : ℝ) ^ (scratch_fixedSignDyadicHeight positive₂ j * p₂) * m₂ j ≤ 1)
    (hmass₃ : ∀ k ∈ s₃,
      (2 : ℝ) ^ (scratch_fixedSignDyadicHeight positive₃ k * p₃) * m₃ k ≤ 1)
    (hpair : ∀ i ∈ s₁, ∀ j ∈ s₂, ∀ k ∈ s₃,
