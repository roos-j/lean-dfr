    positive₁ p₁ a₁ hp₁ hside₁ s₁
  have hsum₂ := scratch_fixedSignDyadic_sum_decay_le
    positive₂ p₂ a₂ hp₂ hside₂ s₂
  have hsum₃ := scratch_fixedSignDyadic_sum_decay_le
    positive₃ p₃ a₃ hp₃ hside₃ s₃
  have hsum₂_nonneg : 0 ≤ ∑ j ∈ s₂,
      (2 : ℝ) ^ ((1 - p₂ * a₂) * scratch_fixedSignDyadicHeight positive₂ j) :=
    Finset.sum_nonneg fun j hj => Real.rpow_nonneg (by norm_num) _
  have hsum₃_nonneg : 0 ≤ ∑ k ∈ s₃,
      (2 : ℝ) ^ ((1 - p₃ * a₃) * scratch_fixedSignDyadicHeight positive₃ k) :=
    Finset.sum_nonneg fun k hk => Real.rpow_nonneg (by norm_num) _
  have hdecay₁_nonneg : 0 ≤ scratch_fixedSignDyadicDecay positive₁ p₁ a₁ :=
    (Finset.sum_nonneg fun i hi => Real.rpow_nonneg (by norm_num) _).trans hsum₁
  have hdecay₂_nonneg : 0 ≤ scratch_fixedSignDyadicDecay positive₂ p₂ a₂ :=
