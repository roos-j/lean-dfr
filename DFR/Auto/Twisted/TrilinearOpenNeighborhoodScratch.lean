/-- The real height corresponding to one sign of a dyadic amplitude level. -/
def scratch_fixedSignDyadicHeight (positive : Bool) (n : ℕ) : ℝ :=
  if positive then (n : ℝ) else -(n : ℝ)

/-- The geometric-series constant for a fixed signed dyadic amplitude
family. -/
def scratch_fixedSignDyadicDecay (positive : Bool) (p a : ℝ) : ℝ :=
  if positive then (1 - (2 : ℝ) ^ (1 - p * a))⁻¹ else
    (1 - (2 : ℝ) ^ (-(1 - p * a)))⁻¹

/-- The scalar dyadic sum in one fixed sign family is uniformly bounded as
soon as its restricted exponent lies strictly on the appropriate side of the
target reciprocal. -/
theorem scratch_fixedSignDyadic_sum_decay_le
    (positive : Bool) (p a : ℝ) (hp : 0 < p)
    (hside : if positive then p⁻¹ < a else a < p⁻¹)
    (s : Finset ℕ) :
    (∑ n ∈ s,
      (2 : ℝ) ^ ((1 - p * a) * scratch_fixedSignDyadicHeight positive n)) ≤
      scratch_fixedSignDyadicDecay positive p a := by
  cases positive <;> simp only [scratch_fixedSignDyadicHeight,
    scratch_fixedSignDyadicDecay, Bool.false_eq_true, ↓reduceIte] at hside ⊢
  · exact Auto.Spherical.FractalDilations.AHRSUpperBounds.finset_sum_negative_level_decay_le
      hp hside s
  · exact Auto.Spherical.FractalDilations.AHRSUpperBounds.finset_sum_positive_level_decay_le
      hp hside s

