            exact hsum₂_nonneg
          · exact hsum₃_nonneg
    _ ≤ C * scratch_fixedSignDyadicDecay positive₁ p₁ a₁ *
          scratch_fixedSignDyadicDecay positive₂ p₂ a₂ *
            (∑ k ∈ s₃,
              (2 : ℝ) ^ ((1 - p₃ * a₃) * scratch_fixedSignDyadicHeight positive₃ k)) := by
          apply mul_le_mul_of_nonneg_right
          · exact mul_le_mul_of_nonneg_left hsum₂
              (mul_nonneg hC hdecay₁_nonneg)
          · exact hsum₃_nonneg
    _ ≤ C * scratch_fixedSignDyadicDecay positive₁ p₁ a₁ *
          scratch_fixedSignDyadicDecay positive₂ p₂ a₂ *
            scratch_fixedSignDyadicDecay positive₃ p₃ a₃ := by
