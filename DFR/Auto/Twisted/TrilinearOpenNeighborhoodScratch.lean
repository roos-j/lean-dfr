        C * (m₁ i) ^ a₁ * (m₂ j) ^ a₂ * (m₃ k) ^ a₃) :
    ‖B (∑ i ∈ s₁, c₁ i • u i) (∑ j ∈ s₂, c₂ j • v j)
        (∑ k ∈ s₃, c₃ k • w k)‖ ≤
      C * scratch_fixedSignDyadicDecay positive₁ p₁ a₁ *
        scratch_fixedSignDyadicDecay positive₂ p₂ a₂ *
          scratch_fixedSignDyadicDecay positive₃ p₃ a₃ := by
  have hmain := scratch_norm_trilinear_finset_sum_le_of_normalized_dyadic_atoms
    B s₁ s₂ s₃ u v w c₁ c₂ c₃ m₁ m₂ m₃
    (fun _ => a₁) (fun _ => a₂) (fun _ => a₃)
