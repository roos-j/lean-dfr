    [Module ℂ F] [Module ℂ G] [Module ℂ H]
    (B : F →ₗ[ℂ] G →ₗ[ℂ] H →ₗ[ℂ] ℂ)
    (s₁ s₂ s₃ : Finset ℕ) (u : ℕ → F) (v : ℕ → G) (w : ℕ → H)
