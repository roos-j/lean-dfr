      rw [Real.mul_rpow hs.le (Real.rpow_nonneg (by norm_num) _)]
      rw [← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
    have hrho : ((2 : ℝ) ^ (-(R0 - R))) ^ n =
        (2 : ℝ) ^ (-(R0 - R) * (n : ℝ)) := by
      rw [← Real.rpow_natCast]
      rw [← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
    rw [← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2), hsPow, hpow, hbase, hrho]
    ring
  calc
    (s * (2 : ℝ) ^ (n : ℝ)) ^ R * D n =
        (s ^ (R - R0) * rho ^ n) *
          ((s * (2 : ℝ) ^ (n : ℝ)) ^ R0 * D n) := by
            rw [hfactor]
            ring
    _ ≤ (s ^ (R - R0) * rho ^ n) * B :=
      mul_le_mul_of_nonneg_left (hstrong n hn)
        (mul_nonneg hsPow0 (pow_nonneg hrho0 n))
    _ = (s ^ (R - R0) * B) * rho ^ n := by ring

/-- The rescaled finite output-layer terminal at an arbitrary positive
crossover height. -/
theorem scratch_twoSided_rescaledDyadicOutputLayers_targetMoment_le
    (s R R0 A B : ℝ) (hs : 0 < s) (hR : 1 < R) (hRR0 : R < R0)
