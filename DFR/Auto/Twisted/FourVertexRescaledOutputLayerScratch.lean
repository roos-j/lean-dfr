/-! ## Atom-dependent two-sided output cutoffs

The crossover height in the four-vertex argument depends on the selected
input atom triple.  These finite scalar lemmas keep that height `s` explicit.
They are the rescaled form of the unit-height two-sided output-layer lemma:
weak-one layers below `s` contribute `A * s^(R - 1)`, while the base strong
`R₀` tail above `s` contributes `B * s^(R - R₀)`.
-/

/-- A weak-one distribution bound on the dyadic layers below a positive,
atom-dependent height `s` controls their target `R`-moment whenever `R > 1`.
-/
theorem scratch_lowWeakOne_rescaledDyadicLayers_targetMoment_le
    (s R A : ℝ) (hs : 0 < s) (hR : 1 < R) (hA : 0 ≤ A)
    (S : Finset ℕ) (D : ℕ → ℝ)
    (hweak : ∀ n ∈ S,
      (s * (2 : ℝ) ^ (-(n : ℝ))) * D n ≤ A) :
    (∑ n ∈ S, (s * (2 : ℝ) ^ (-(n : ℝ))) ^ R * D n) ≤
      (s ^ (R - 1) * A) * (1 - (2 : ℝ) ^ (-(R - 1)))⁻¹ := by
  let rho : ℝ := (2 : ℝ) ^ (-(R - 1))
  have hrho0 : 0 ≤ rho := by
    dsimp only [rho]
    exact Real.rpow_nonneg (by norm_num) _
  have hrho1 : rho < 1 := by
    dsimp only [rho]
    apply Real.rpow_lt_one_of_one_lt_of_neg
    · norm_num
    · linarith
  have hsPow0 : 0 ≤ s ^ (R - 1) := Real.rpow_nonneg hs.le _
  apply scratch_finset_geometric_layer_sum_le (s ^ (R - 1) * A) rho
    (mul_nonneg hsPow0 hA) hrho0 hrho1 S
    (fun n => (s * (2 : ℝ) ^ (-(n : ℝ))) ^ R * D n)
  intro n hn
  have hfactor : (s * (2 : ℝ) ^ (-(n : ℝ))) ^ R * D n =
      s ^ (R - 1) * ((s * (2 : ℝ) ^ (-(n : ℝ))) * D n) * rho ^ n := by
    rw [Real.mul_rpow hs.le (Real.rpow_nonneg (by norm_num) _)]
    have hsPow : s ^ R = s ^ (R - 1) * s := by
      calc
        s ^ R = s ^ ((R - 1) + 1) := by
          congr 1
          ring
        _ = s ^ (R - 1) * s ^ (1 : ℝ) := Real.rpow_add hs _ _
        _ = s ^ (R - 1) * s := by rw [Real.rpow_one]
    have hpow : (2 : ℝ) ^ (-(n : ℝ) * R) =
        (2 : ℝ) ^ (-(n : ℝ)) *
          (2 : ℝ) ^ (-(R - 1) * (n : ℝ)) := by
      rw [← Real.rpow_add (by norm_num : (0 : ℝ) < 2)]
      congr 1
      ring
    have hrho : ((2 : ℝ) ^ (-(R - 1))) ^ n =
        (2 : ℝ) ^ (-(R - 1) * (n : ℝ)) := by
      rw [← Real.rpow_natCast]
      rw [← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
    rw [← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2), hsPow, hpow, hrho]
    ring
  calc
    (s * (2 : ℝ) ^ (-(n : ℝ))) ^ R * D n =
        (s ^ (R - 1) * rho ^ n) *
          ((s * (2 : ℝ) ^ (-(n : ℝ))) * D n) := by
            rw [hfactor]
            ring
    _ ≤ (s ^ (R - 1) * rho ^ n) * A :=
      mul_le_mul_of_nonneg_left (hweak n hn)
        (mul_nonneg hsPow0 (pow_nonneg hrho0 n))
    _ = (s ^ (R - 1) * A) * rho ^ n := by ring

/-- A base `R₀` distribution bound on the dyadic layers above a positive,
atom-dependent height `s` controls their target `R`-moment whenever
`R < R₀`. -/
theorem scratch_highStrong_rescaledDyadicLayers_targetMoment_le
    (s R R0 B : ℝ) (hs : 0 < s) (hRR0 : R < R0) (hB : 0 ≤ B)
    (S : Finset ℕ) (D : ℕ → ℝ)
    (hstrong : ∀ n ∈ S,
      (s * (2 : ℝ) ^ (n : ℝ)) ^ R0 * D n ≤ B) :
    (∑ n ∈ S, (s * (2 : ℝ) ^ (n : ℝ)) ^ R * D n) ≤
      (s ^ (R - R0) * B) * (1 - (2 : ℝ) ^ (-(R0 - R)))⁻¹ := by
  let rho : ℝ := (2 : ℝ) ^ (-(R0 - R))
  have hrho0 : 0 ≤ rho := by
    dsimp only [rho]
    exact Real.rpow_nonneg (by norm_num) _
  have hrho1 : rho < 1 := by
    dsimp only [rho]
    apply Real.rpow_lt_one_of_one_lt_of_neg
    · norm_num
    · linarith
  have hsPow0 : 0 ≤ s ^ (R - R0) := Real.rpow_nonneg hs.le _
  apply scratch_finset_geometric_layer_sum_le (s ^ (R - R0) * B) rho
    (mul_nonneg hsPow0 hB) hrho0 hrho1 S
    (fun n => (s * (2 : ℝ) ^ (n : ℝ)) ^ R * D n)
  intro n hn
  have hfactor : (s * (2 : ℝ) ^ (n : ℝ)) ^ R * D n =
      s ^ (R - R0) * ((s * (2 : ℝ) ^ (n : ℝ)) ^ R0 * D n) *
        rho ^ n := by
    rw [Real.mul_rpow hs.le (Real.rpow_nonneg (by norm_num) _)]
    have hsPow : s ^ R = s ^ (R - R0) * s ^ R0 := by
      calc
        s ^ R = s ^ ((R - R0) + R0) := by
          congr 1
          ring
        _ = s ^ (R - R0) * s ^ R0 := Real.rpow_add hs _ _
    have hpow : (2 : ℝ) ^ ((n : ℝ) * R) =
        (2 : ℝ) ^ ((n : ℝ) * R0) *
          (2 : ℝ) ^ (-(R0 - R) * (n : ℝ)) := by
      rw [← Real.rpow_add (by norm_num : (0 : ℝ) < 2)]
      congr 1
      ring
