/-! ## Finite output-layer bookkeeping for weak-one endpoints

The three non-base vertices in the Section 8 simplex have output exponent
one.  A weak-one estimate bounds each output dyadic layer separately, but
does not bound their unweighted sum independently of the number of retained
layers.  These finite statements isolate the exact layer-cake interface
required before the scalar atom estimates in
`scratch_fourVertex_normalizedDyadic_edges_to_hAtom` can be supplied.
-/

/-- A finite family of output dyadic layers satisfying a weak-one bound has
at most a cardinality loss.  Here `D n` stands for the distribution mass at
height `2^n`; in the analytic application it is a level-set measure. -/
theorem scratch_weakOne_finite_dyadicLayer_le_card_mul
    (A : ℝ) (L : Finset ℕ) (D : ℕ → ℝ)
    (hweak : ∀ n ∈ L, (2 : ℝ) ^ n * D n ≤ A) :
    (∑ n ∈ L, (2 : ℝ) ^ n * D n) ≤ (L.card : ℝ) * A := by
  calc
    (∑ n ∈ L, (2 : ℝ) ^ n * D n) ≤ ∑ _n ∈ L, A := by
      apply Finset.sum_le_sum
      intro n hn
      exact hweak n hn
    _ = (L.card : ℝ) * A := by
      simp [Finset.sum_const, nsmul_eq_mul]

/-- The preceding cardinality loss is sharp even for the normalized dyadic
model distribution `D n = 2^{-n}`: every retained layer has weak-one size
exactly one. -/
theorem scratch_weakOne_normalized_dyadicLayers_sharp (N : ℕ) :
    (∀ n ∈ Finset.range N, 0 ≤ ((2 : ℝ)⁻¹) ^ n) ∧
    (∀ n ∈ Finset.range N,
      (2 : ℝ) ^ n * ((2 : ℝ)⁻¹) ^ n ≤ 1) ∧
    (∑ n ∈ Finset.range N,
      (2 : ℝ) ^ n * ((2 : ℝ)⁻¹) ^ n) = N := by
  have hterm (n : ℕ) :
      (2 : ℝ) ^ n * ((2 : ℝ)⁻¹) ^ n = 1 := by
    rw [← mul_pow]
    norm_num
  refine ⟨?_, ?_, ?_⟩
  · intro n hn
    exact pow_nonneg (by positivity) _
  · intro n hn
    rw [hterm]
  · calc
      (∑ n ∈ Finset.range N,
        (2 : ℝ) ^ n * ((2 : ℝ)⁻¹) ^ n) =
          ∑ _n ∈ Finset.range N, (1 : ℝ) := by
            apply Finset.sum_congr rfl
            intro n hn
            exact hterm n
      _ = N := by simp

/-- There is no output-layer-count-free estimate derivable from the
pointwise weak-one layer inequalities alone.  Consequently, deriving the
scalar edge bounds used by the finite four-vertex atom summation requires a
genuine output cutoff/split (or a second weak exponent), not just the three
weak-one endpoint inequalities. -/
theorem scratch_weakOne_dyadicLayers_no_uniform_bound :
    ¬ ∃ K : ℝ, ∀ N : ℕ,
      (∀ n ∈ Finset.range N,
        (2 : ℝ) ^ n * ((2 : ℝ)⁻¹) ^ n ≤ 1) →
      (∑ n ∈ Finset.range N,
        (2 : ℝ) ^ n * ((2 : ℝ)⁻¹) ^ n) ≤ K := by
