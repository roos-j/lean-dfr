      M i j k ≤ ∑ ell ∈ L, W ell i j k)
    (hlayer : ∀ ell ∈ L, ∀ i ∈ s, ∀ j ∈ t, ∀ k ∈ u,
      W ell i j k ≤ P i j k) :
    ∀ i ∈ s, ∀ j ∈ t, ∀ k ∈ u,
      M i j k ≤ (L.card : ℝ) * P i j k := by
  intro i hi j hj k hk
