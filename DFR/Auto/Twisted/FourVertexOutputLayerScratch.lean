    M i j k ≤ ∑ ell ∈ L, W ell i j k := hdecomp i hi j hj k hk
    _ ≤ ∑ _ell ∈ L, P i j k := by
      apply Finset.sum_le_sum
      intro ell hell
      exact hlayer ell hell i hi j hj k hk
    _ = (L.card : ℝ) * P i j k := by
      simp [Finset.sum_const, nsmul_eq_mul]

