    convert! (hp.const_mul sig).const_add p using 1
  have hnum : HasDerivAt (fun q : ℝ => u - (p + sig * q ^ n))
      (-(sig * ((n : ℝ) * t ^ (n - 1)))) t := by
    convert! hafun.const_sub u using 1
