/-- Joint face-plane--space integrability of the bracket weight. -/
theorem integrable_cubeBracketWeight_face_space
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) (c : ℝ)
    {t : ℝ} (ht : 0 < t) :
    Integrable (fun z : TransverseSpace i × E6 ↦
      cubeBracketWeight α t (faceInsert i c z.1) z.2)
      ((volume.restrict (transverseRectangle α q i)).prod volume) := by
  letI : IsFiniteMeasure (volume.restrict (transverseRectangle α q i)) := by
    constructor
    rw [Measure.restrict_apply_univ]
    exact lt_top_iff_ne_top.mpr (volume_transverseRectangle_ne_top α q i)
  have hmap : Continuous (fun z : TransverseSpace i × E6 ↦
      (faceInsert i c z.1, z.2)) :=
    ((faceInsert_continuous i c).comp continuous_fst).prodMk continuous_snd
  have hmeas : AEStronglyMeasurable
      (fun z : TransverseSpace i × E6 ↦
        cubeBracketWeight α t (faceInsert i c z.1) z.2)
      ((volume.restrict (transverseRectangle α q i)).prod volume) :=
    ((continuous_cubeBracketWeight_center_space α t).comp hmap).aestronglyMeasurable
  refine (integrable_prod_iff hmeas).mpr ⟨?_, ?_⟩
  · filter_upwards [] with y
    exact integrable_cubeBracketWeight α ht (faceInsert i c y)
  · have hconst : (fun y : TransverseSpace i ↦
        ∫ x : E6, ‖cubeBracketWeight α t (faceInsert i c y) x‖) =
          fun _ ↦ (2 / 9 : ℝ) ^ 6 := by
      funext y
      rw [show (fun x : E6 ↦ ‖cubeBracketWeight α t (faceInsert i c y) x‖) =
        cubeBracketWeight α t (faceInsert i c y) by
          funext x
          rw [Real.norm_eq_abs, abs_of_nonneg]
          exact cubeBracketWeight_nonneg α ht.le (faceInsert i c y) x]
      exact integral_cubeBracketWeight α ht (faceInsert i c y)
    rw [hconst]
    exact integrable_const _

