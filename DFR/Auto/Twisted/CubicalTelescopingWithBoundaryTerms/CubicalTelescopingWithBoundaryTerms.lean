/-- A fixed spatial kernel with a positive bracket majorant inherits the
corresponding bracket-average bound after multiplication by bounded cube
inputs and spatial integration. -/
theorem abs_integral_kernel_le_bracketAverage
    (α : Anisotropy) (t : ℝ) (p : E3) (F : CubeVertex → E3 → ℝ)
    (K : E6 → ℝ)
    (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B)
    (ht : 0 < t) (hKcont : Continuous K) (D : ℝ) (hD : 0 ≤ D)
    (hdom : ∀ x, |K x| ≤ D * cubeBracketWeight α t p x) :
    |∫ x : E6, cubeSignedInputProduct F x * K x| ≤
      D * cubeBracketAverage α t p F := by
  let f : E6 → ℝ := fun x ↦ cubeSignedInputProduct F x * K x
  let g : E6 → ℝ := fun x ↦
    D * (cubeInputProduct F x * cubeBracketWeight α t p x)
  rcases exists_bound_cubeSignedInputProduct F hFbound with ⟨B, hB, hinput⟩
  have hmajor : Integrable (fun x : E6 ↦
      (B * D) * cubeBracketWeight α t p x) := by
    simpa only [smul_eq_mul] using
      (integrable_cubeBracketWeight α ht p).const_mul (B * D)
  have hfmeas : AEStronglyMeasurable f volume :=
    ((continuous_cubeSignedInputProduct F hFcont).mul hKcont).aestronglyMeasurable
  have hf : Integrable f := by
    refine hmajor.mono hfmeas (Filter.Eventually.of_forall ?_)
    intro x
    have hright : 0 ≤ (B * D) * cubeBracketWeight α t p x :=
      mul_nonneg (mul_nonneg hB hD) (cubeBracketWeight_nonneg α ht.le p x)
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul, abs_of_nonneg hright]
    calc
      |cubeSignedInputProduct F x| * |K x| ≤
          B * (D * cubeBracketWeight α t p x) :=
        mul_le_mul (hinput x) (hdom x) (abs_nonneg _) hB
      _ = (B * D) * cubeBracketWeight α t p x := by ring
  have hbracket : Integrable (fun x : E6 ↦
      cubeInputProduct F x * cubeBracketWeight α t p x) :=
    integrable_cubeInputProduct_mul_cubeBracketWeight
      α t p F hFcont hFbound ht
  have hg : Integrable g := by
    simpa only [g, smul_eq_mul] using hbracket.const_mul D
  have hpointwise (x : E6) : |f x| ≤ g x := by
    change |cubeSignedInputProduct F x * K x| ≤
      D * (cubeInputProduct F x * cubeBracketWeight α t p x)
    rw [abs_mul, abs_cubeSignedInputProduct_eq_cubeInputProduct]
    calc
      cubeInputProduct F x * |K x| ≤
          cubeInputProduct F x * (D * cubeBracketWeight α t p x) :=
        mul_le_mul_of_nonneg_left (hdom x) (cubeInputProduct_nonneg F x)
      _ = D * (cubeInputProduct F x * cubeBracketWeight α t p x) := by ring
  calc
    |∫ x : E6, f x| ≤ ∫ x : E6, |f x| := MeasureTheory.abs_integral_le_integral_abs
    _ ≤ ∫ x : E6, g x :=
      MeasureTheory.integral_mono_ae hf.abs hg
        (Filter.Eventually.of_forall hpointwise)
    _ = D * cubeBracketAverage α t p F := by
      rw [show g = fun x : E6 ↦ D *
        (cubeInputProduct F x * cubeBracketWeight α t p x) by rfl,
        cubeBracketAverage, MeasureTheory.integral_const_mul]

/-- The fixed-parameter local cube kernel is continuous in its six spatial
variables. -/
theorem continuous_localCubeKernel
    (α : Anisotropy) (i : Fin 3) (lam r t : ℝ) (p : E3) :
    Continuous (localCubeKernel α i lam r t p) := by
  unfold localCubeKernel
  apply continuous_finsetProd Finset.univ
  intro q _
  by_cases hq : q.1 = i
  · simpa [hq] using continuous_cubeSixfoldGaussianFactor α
      (fun a ↦ decide (a.1 = i)) lam r t p q
  · simpa [hq] using continuous_cubeSixfoldGaussianFactor α
      (fun a ↦ decide (a.1 = i)) lam r t p q

/-- At fixed center and scale, the local cube integrand is bounded by its
source bracket average with the exact `λ^36 R(r)^20` loss. -/
theorem abs_integral_localCubeKernel_le_bracketAverage
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i : Fin 3) (lam r t : ℝ) (p : E3)
      (F : CubeVertex → E3 → ℝ),
      (∀ j, Continuous (F j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B) →
      1 ≤ lam → 0 < t →
      |∫ x : E6, cubeSignedInputProduct F x *
        localCubeKernel α i lam r t p x| ≤
        C ^ 6 * lam ^ 36 * translationWeight r ^ 20 *
          cubeBracketAverage α t p F := by
  rcases localCubeKernel_abs_domination α with ⟨C, hC, hdom⟩
  refine ⟨C, hC, ?_⟩
  intro i lam r t p F hFcont hFbound hlam ht
  let D : ℝ := C ^ 6 * lam ^ 36 * translationWeight r ^ 20
  have hD : 0 ≤ D := by
    dsimp only [D]
    have hlam0 : 0 ≤ lam := by linarith
    have hR : 0 ≤ translationWeight r := by
      unfold translationWeight
      positivity
    change 0 ≤ (C ^ (6 : ℕ) * lam ^ (36 : ℕ)) * translationWeight r ^ (20 : ℕ)
    exact mul_nonneg
      (mul_nonneg (pow_nonneg hC _) (pow_nonneg hlam0 _))
      (pow_nonneg hR _)
  exact abs_integral_kernel_le_bracketAverage α t p F
    (localCubeKernel α i lam r t p) hFcont hFbound ht
    (continuous_localCubeKernel α i lam r t p) D hD
    (fun x ↦ by
      dsimp only [D]
      exact hdom i lam r t p x hlam ht)

/-- At the scale and center of a tree box, the fixed-parameter local cube
form is controlled by the product of the eight tree-local fourth sizes. -/
theorem abs_integral_localCubeKernel_at_box_le_treeLocalSize_product
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α) (q : AnisoBox α),
      q ∈ T.boxes → ∀ (i : Fin 3) (lam r : ℝ) (F : CubeVertex → E3 → ℝ),
      (∀ j, Continuous (F j)) →
      (∀ j, Measurable (F j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B) →
      1 ≤ lam →
      |∫ x : E6, cubeSignedInputProduct F x *
        localCubeKernel α i lam r (boxLength q) (boxCenter α q) x| ≤
        C ^ 6 * lam ^ 36 * translationWeight r ^ 20 *
          ∏ j : CubeVertex, treeLocalSize T 4 (F j) := by
  rcases abs_integral_localCubeKernel_le_bracketAverage α with ⟨C, hC, hlocal⟩
  refine ⟨C, hC, ?_⟩
  intro T q hq i lam r F hFcont hFmeas hFbound hlam
  have hlocal' := hlocal i lam r (boxLength q) (boxCenter α q) F
    hFcont hFbound hlam (boxLength_pos q)
  have hsize := cubeBracketAverage_at_box_le_treeLocalSize_product
    T hq F hFmeas hFbound
  have hfac : 0 ≤ C ^ 6 * lam ^ 36 * translationWeight r ^ 20 := by
    have hlam0 : 0 ≤ lam := by linarith
    have hR : 0 ≤ translationWeight r := by
      unfold translationWeight
      positivity
    change 0 ≤ (C ^ (6 : ℕ) * lam ^ (36 : ℕ)) * translationWeight r ^ (20 : ℕ)
    exact mul_nonneg
      (mul_nonneg (pow_nonneg hC _) (pow_nonneg hlam0 _))
      (pow_nonneg hR _)
  exact hlocal'.trans (mul_le_mul_of_nonneg_left hsize hfac)

/-- The endpoint spatial integral has the source `λ^36 R(r)^20` bracket
average bound at every fixed positive center-scale parameter. -/
theorem abs_integral_cubeEndpointKernel_le_bracketAverage
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (lam r t : ℝ) (p : E3)
      (F : CubeVertex → E3 → ℝ),
      (∀ j, Continuous (F j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B) →
      1 ≤ lam → 0 < t →
      |∫ x : E6, cubeSignedInputProduct F x *
        cubeEndpointKernel α lam r t p x| ≤
        C ^ 6 * lam ^ 36 * translationWeight r ^ 20 *
          cubeBracketAverage α t p F := by
  rcases cubeEndpointKernel_domination α with ⟨C, hC, hdom⟩
  refine ⟨C, hC, ?_⟩
  intro lam r t p F hFcont hFbound hlam ht
  let D : ℝ := C ^ 6 * lam ^ 36 * translationWeight r ^ 20
  have hD : 0 ≤ D := by
    dsimp only [D]
    have hlam0 : 0 ≤ lam := by linarith
    have hR : 0 ≤ translationWeight r := by
      unfold translationWeight
      positivity
    change 0 ≤ (C ^ (6 : ℕ) * lam ^ (36 : ℕ)) * translationWeight r ^ (20 : ℕ)
    exact mul_nonneg
      (mul_nonneg (pow_nonneg hC _) (pow_nonneg hlam0 _))
      (pow_nonneg hR _)
  exact abs_integral_kernel_le_bracketAverage α t p F
    (cubeEndpointKernel α lam r t p) hFcont hFbound ht
    (continuous_cubeEndpointKernel α lam r t p) D hD
    (fun x ↦ by
      dsimp only [D]
      exact hdom lam r t p x hlam ht)

/-- The face spatial integral has the source `λ^37 R(r)^21` bracket-average
bound at every fixed positive center-scale parameter. -/
theorem abs_integral_cubeFaceKernel_le_bracketAverage
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i : Fin 3) (lam r t : ℝ) (p : E3)
      (F : CubeVertex → E3 → ℝ),
      (∀ j, Continuous (F j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B) →
      1 ≤ lam → 0 < t →
      |∫ x : E6, cubeSignedInputProduct F x *
        cubeFaceKernel α i lam r t p x| ≤
        C * lam ^ 37 * translationWeight r ^ 21 *
          cubeBracketAverage α t p F := by
  rcases cubeFaceKernel_domination α with ⟨C, hC, hdom⟩
  refine ⟨C, hC, ?_⟩
  intro i lam r t p F hFcont hFbound hlam ht
  let D : ℝ := C * lam ^ 37 * translationWeight r ^ 21
  have hD : 0 ≤ D := by
    dsimp only [D]
    have hlam0 : 0 ≤ lam := by linarith
    have hR : 0 ≤ translationWeight r := by
      unfold translationWeight
      positivity
    change 0 ≤ (C * lam ^ (37 : ℕ)) * translationWeight r ^ (21 : ℕ)
    exact mul_nonneg
      (mul_nonneg hC (pow_nonneg hlam0 _))
      (pow_nonneg hR _)
  exact abs_integral_kernel_le_bracketAverage α t p F
    (cubeFaceKernel α i lam r t p) hFcont hFbound ht
    (continuous_cubeFaceKernel α i lam r t p) D hD
    (fun x ↦ by
      dsimp only [D]
      exact hdom i lam r t p x hlam ht)

/-! ### Endpoint-child bridge -/

/-- Every literal child has half the source length of its parent. -/
theorem boxLength_child_eq_half (α : Anisotropy) (q : AnisoBox α)
    (v : AnisoDigit α) :
    boxLength (boxChild α q v) = boxLength q / 2 := by
  unfold boxLength boxChild
  rw [show q.level - 1 = q.level + (-1 : ℤ) by ring,
    zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
  norm_num
  ring

/-- The center integrand occurring in one endpoint form at a fixed scale. -/
noncomputable def cubeEndpointIntegrand (α : Anisotropy)
    (lam shift t : ℝ) (F : CubeVertex → E3 → ℝ) (p : E3) : ℝ :=
  ∫ x : E6,
    cubeSignedInputProduct F x * cubeEndpointKernel α lam shift t p x

/-- The fixed-scale endpoint center integrand is integrable over every box. -/
theorem integrableOn_cubeEndpointIntegrand_boxSet
    (α : Anisotropy) (q : AnisoBox α) (lam r t : ℝ)
    (F : CubeVertex → E3 → ℝ) (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    IntegrableOn (cubeEndpointIntegrand α lam r t F) (boxSet α q) := by
  have h := integrable_cubeSignedInputProduct_mul_cubeEndpointKernel_center_space
    α q lam r t F hFcont hFbound hlam ht
  change Integrable (fun p : E3 ↦ ∫ x : E6,
      cubeSignedInputProduct F x * cubeEndpointKernel α lam r t p x)
    (volume.restrict (boxSet α q))
  exact h.integral_prod_left

/-- Integration over a parent box is the finite sum over its disjoint
children, provided the integrand is integrable on the parent. -/
theorem integral_boxSet_eq_sum_integral_boxSet_children
    (α : Anisotropy) (q : AnisoBox α) (G : E3 → ℝ)
    (hG : IntegrableOn G (boxSet α q)) :
    (∫ p : E3 in boxSet α q, G p) =
      ∑ r ∈ boxChildren α q, ∫ p : E3 in boxSet α r, G p := by
  rw [boxSet_eq_children_union]
  apply MeasureTheory.integral_biUnion_finset
  · intro r hr
    exact measurableSet_boxSet α r
  · exact pairwiseDisjoint_boxSet_children α q
  · intro r hr
    rcases Finset.mem_image.mp hr with ⟨v, hv, rfl⟩
    have hsub : boxSet α (boxChild α q v) ⊆ boxSet α q := by
      simpa only [boxParent_child] using boxSet_subset_parent α (boxChild α q v)
    exact hG.mono_set hsub

/-- The endpoint form of all children is the parent-box endpoint integral at
half the parent scale.  The sole analytic hypothesis is integrability of that
fixed-scale parent integrand; the equality itself is the finite geometric
child partition. -/
theorem cubeEndpointForm_children_eq_parent_half
    (α : Anisotropy) (q : AnisoBox α) (lam shift : ℝ)
    (F : CubeVertex → E3 → ℝ)
    (hG : IntegrableOn
      (cubeEndpointIntegrand α lam shift (boxLength q / 2) F) (boxSet α q)) :
    cubeEndpointForm α (boxChildren α q) lam shift F =
      Real.pi * ∫ p : E3 in boxSet α q,
        cubeEndpointIntegrand α lam shift (boxLength q / 2) F p := by
  have hpartition := integral_boxSet_eq_sum_integral_boxSet_children α q
    (cubeEndpointIntegrand α lam shift (boxLength q / 2) F) hG
  change Real.pi *
      (∑ Q ∈ boxChildren α q,
        ∫ p : E3 in boxSet α Q,
          cubeEndpointIntegrand α lam shift (boxLength Q) F p) =
      Real.pi * ∫ p : E3 in boxSet α q,
        cubeEndpointIntegrand α lam shift (boxLength q / 2) F p
  have hsum :
      (∑ Q ∈ boxChildren α q,
        ∫ p : E3 in boxSet α Q,
          cubeEndpointIntegrand α lam shift (boxLength Q) F p) =
      ∑ Q ∈ boxChildren α q,
        ∫ p : E3 in boxSet α Q,
          cubeEndpointIntegrand α lam shift (boxLength q / 2) F p := by
    apply Finset.sum_congr rfl
    intro Q hQ
    rcases Finset.mem_image.mp hQ with ⟨v, hv, rfl⟩
    rw [boxLength_child_eq_half]
  rw [hsum, ← hpartition]

/-- The endpoint child partition has no residual analytic hypothesis for
bounded continuous cube data: the fixed half-scale integrability is supplied
by the endpoint majorant. -/
theorem cubeEndpointForm_children_eq_parent_half_of_boundedContinuous
    (α : Anisotropy) (q : AnisoBox α) (lam shift : ℝ)
    (F : CubeVertex → E3 → ℝ)
    (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (hlam : 1 ≤ lam) :
    cubeEndpointForm α (boxChildren α q) lam shift F =
      Real.pi * ∫ p : E3 in boxSet α q,
        cubeEndpointIntegrand α lam shift (boxLength q / 2) F p := by
  apply cubeEndpointForm_children_eq_parent_half α q lam shift F
  apply integrableOn_cubeEndpointIntegrand_boxSet
  · exact hFcont
  · exact hFbound
  · exact hlam
  · exact div_pos (boxLength_pos q) (by norm_num)

/-! ### Finite-tree bookkeeping for the one-box telescope -/

/-- Children belonging to distinct tree boxes are distinct, because every
literal child has its parent as its unique grid parent. -/
theorem pairwiseDisjoint_boxChildren_over_tree
    (α : Anisotropy) (T : FiniteConvexTree α) :
    (↑T.boxes : Set (AnisoBox α)).PairwiseDisjoint (boxChildren α) := by
  intro q hq q' hq' hne
  change Disjoint (boxChildren α q) (boxChildren α q')
  rw [Finset.disjoint_left]
  intro r hr hr'
  rcases Finset.mem_image.mp hr with ⟨v, hv, hrv⟩
  rcases Finset.mem_image.mp hr' with ⟨v', hv', hrv'⟩
  have hparent : q = q' := by
    calc
      q = boxParent α (boxChild α q v) := (boxParent_child α q v).symm
      _ = boxParent α r := by rw [hrv]
      _ = boxParent α (boxChild α q' v') := by rw [hrv']
      _ = q' := boxParent_child α q' v'
  exact hne hparent

/-- The sum of endpoint forms of the children of every tree box is one
endpoint form over the literal union of all those children. -/
theorem sum_cubeEndpointForm_children_eq_treeChildrenAll
    (α : Anisotropy) (T : FiniteConvexTree α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) :
    (∑ q ∈ T.boxes, cubeEndpointForm α (boxChildren α q) lam r F) =
      cubeEndpointForm α (treeChildrenAll T) lam r F := by
  let w : AnisoBox α → ℝ := fun q ↦
    ∫ p : E3 in boxSet α q,
      ∫ x : E6, cubeSignedInputProduct F x *
        cubeEndpointKernel α lam r (boxLength q) p x
  have hdis := pairwiseDisjoint_boxChildren_over_tree α T
  change (∑ q ∈ T.boxes, Real.pi * ∑ r ∈ boxChildren α q, w r) =
    Real.pi * ∑ r ∈ treeChildrenAll T, w r
  rw [← Finset.mul_sum]
  congr 1
  unfold treeChildrenAll
  rw [Finset.sum_biUnion hdis]

/-- An endpoint form over a finite collection is the finite sum of its
literal singleton endpoint forms. -/
theorem cubeEndpointForm_collection_eq_sum_singletons
    (α : Anisotropy) (S : BoxCollection α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) :
    cubeEndpointForm α S lam r F =
      ∑ q ∈ S, cubeEndpointForm α ({q} : BoxCollection α) lam r F := by
  let w : AnisoBox α → ℝ := fun q ↦
    ∫ p : E3 in boxSet α q,
      ∫ x : E6, cubeSignedInputProduct F x *
        cubeEndpointKernel α lam r (boxLength q) p x
  change Real.pi * ∑ q ∈ S, w q =
    ∑ q ∈ S, Real.pi * ∑ r ∈ ({q} : Finset (AnisoBox α)), w r
  simp only [Finset.sum_singleton]
  rw [Finset.mul_sum]

/-- The finite-tree telescope follows from the analytic one-box identity and
the local integrability used to split the tree region into literal cells. -/
theorem cubeTree_telescope_of_single
    (α : Anisotropy) (T : FiniteConvexTree α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ)
    (hlocal : ∀ i : Fin 3,
      IntegrableOn (fun z : E3 × ℝ ↦
        ∫ x : E6, cubeSignedInputProduct F x *
          localCubeKernel α i lam r z.2 z.1 x)
        (collectionRegion α T.boxes) cubeScaleMeasure)
    (hsingle : ∀ q : AnisoBox α, q ∈ T.boxes →
      (∑ i : Fin 3, (α.weight i : ℝ) *
        localCubeForm α ({q} : BoxCollection α) i lam r F) =
        cubeEndpointForm α (boxChildren α q) lam r F -
          cubeEndpointForm α ({q} : BoxCollection α) lam r F +
            cubeBoxBoundaryForm α q lam r F) :
    (∑ i : Fin 3, (α.weight i : ℝ) *
      localCubeForm α T.boxes i lam r F) =
      cubeTreeRemainder α T lam r F := by
  have hsplit (i : Fin 3) :
      localCubeForm α T.boxes i lam r F =
        ∑ q ∈ T.boxes, localCubeForm α ({q} : BoxCollection α) i lam r F :=
    localCubeForm_collection_eq_sum_singletons_of_integrable α T.boxes i lam r F
      (hlocal i)
  calc
    (∑ i : Fin 3, (α.weight i : ℝ) *
        localCubeForm α T.boxes i lam r F) =
        ∑ q ∈ T.boxes, ∑ i : Fin 3, (α.weight i : ℝ) *
          localCubeForm α ({q} : BoxCollection α) i lam r F := by
      simp_rw [hsplit]
      rw [Finset.sum_comm]
      simp_rw [Finset.mul_sum]
    _ = ∑ q ∈ T.boxes,
        (cubeEndpointForm α (boxChildren α q) lam r F -
          cubeEndpointForm α ({q} : BoxCollection α) lam r F +
            cubeBoxBoundaryForm α q lam r F) := by
      apply Finset.sum_congr rfl
      intro q hq
      exact hsingle q hq
    _ = (∑ q ∈ T.boxes, cubeEndpointForm α (boxChildren α q) lam r F) -
          (∑ q ∈ T.boxes, cubeEndpointForm α ({q} : BoxCollection α) lam r F) +
            cubeTreeBoxBoundaryForm α T lam r F := by
      unfold cubeTreeBoxBoundaryForm
      rw [Finset.sum_add_distrib, Finset.sum_sub_distrib]
    _ = cubeEndpointForm α (treeChildrenAll T) lam r F -
          cubeEndpointForm α T.boxes lam r F +
            cubeTreeBoxBoundaryForm α T lam r F := by
      rw [sum_cubeEndpointForm_children_eq_treeChildrenAll,
        ← cubeEndpointForm_collection_eq_sum_singletons]
    _ = cubeTreeRemainder α T lam r F := by
      rw [cubeEndpointForm_tree_children_sub_tree_boxes,
        cubeTreeBoxBoundaryForm_eq_cubeBoundaryFaceForm]
      rfl

/-- The literal transverse rectangle has the same coordinate area as the
corresponding oriented grid face. -/
theorem transverseArea_eq_boxFaceArea
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    transverseArea α q i = boxFaceArea α q i := by
  unfold transverseArea boxFaceArea
  rw [← Finset.prod_subtype (Finset.univ.erase i) (by simp)
    (fun j : Fin 3 ↦ boxSide α q j)]

/-- The scale weight in a face term has mass at most the corresponding
anisotropic side length on its literal half-to-full scale interval. -/
theorem scale_weight_integral_le_boxSide
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    (α.weight i : ℝ) *
      (∫ t : ℝ in Set.Ioc (boxLength q / 2) (boxLength q),
        t ^ (α.weight i - 1)) ≤ boxSide α q i := by
  obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero
    (Nat.ne_of_gt (α.weight_pos i))
  rw [hn]
  simp only [Nat.succ_sub_one]
  have hL : 0 < boxLength q := boxLength_pos q
  have hle : boxLength q / 2 ≤ boxLength q := by linarith
  rw [← intervalIntegral.integral_of_le hle, integral_pow]
  simp only [Nat.cast_succ]
  change ((n : ℝ) + 1) *
      ((boxLength q ^ (n + 1) - (boxLength q / 2) ^ (n + 1)) /
        ((n : ℝ) + 1)) ≤ boxSide α q i
  have hden : ((n + 1 : ℕ) : ℝ) ≠ 0 := by positivity
  calc
    ((n : ℝ) + 1) *
        ((boxLength q ^ (n + 1) - (boxLength q / 2) ^ (n + 1)) /
          ((n : ℝ) + 1)) =
        boxLength q ^ (n + 1) - (boxLength q / 2) ^ (n + 1) := by
          field_simp
    _ ≤ boxLength q ^ (n + 1) := by
      exact sub_le_self _ (pow_nonneg (by positivity) _)
    _ = boxSide α q i := by
      rw [boxSide_eq_length_pow]
      congr 1
      omega

/-- A uniformly bounded integrable center integrand has the expected literal
box-mass estimate. -/
theorem abs_integral_boxSet_le_const_mul_boxMass
    (α : Anisotropy) (q : AnisoBox α) (f : E3 → ℝ)
    (hf : IntegrableOn f (boxSet α q)) (D : ℝ) (_hD : 0 ≤ D)
    (hbound : ∀ p ∈ boxSet α q, |f p| ≤ D) :
    |∫ p : E3 in boxSet α q, f p| ≤ D * boxMass α q := by
  have hconst : IntegrableOn (fun _ : E3 ↦ D) (boxSet α q) :=
    integrableOn_const (volume_boxSet_ne_top α q)
  calc
    |∫ p : E3 in boxSet α q, f p| ≤
        ∫ p : E3 in boxSet α q, |f p| :=
      MeasureTheory.abs_integral_le_integral_abs
    _ ≤ ∫ p : E3 in boxSet α q, D := by
      apply MeasureTheory.integral_mono_ae hf.abs hconst
      filter_upwards [ae_restrict_mem (measurableSet_boxSet α q)] with p hp
      exact hbound p hp
    _ = D * boxMass α q := by
      rw [integral_const]
      simp only [smul_eq_mul]
      rw [measureReal_restrict_apply_univ]
      change (volume (boxSet α q)).toReal * D = D * boxMass α q
      rw [volume_boxSet_toReal]
      ring

/-- The analogous literal area estimate on a transverse face rectangle. -/
theorem abs_integral_transverseRectangle_le_const_mul_area
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3)
    (f : TransverseSpace i → ℝ)
    (hf : IntegrableOn f (transverseRectangle α q i)) (D : ℝ)
    (hbound : ∀ y ∈ transverseRectangle α q i, |f y| ≤ D) :
    |∫ y : TransverseSpace i in transverseRectangle α q i, f y| ≤
      D * transverseArea α q i := by
  have hconst : IntegrableOn (fun _ : TransverseSpace i ↦ D)
      (transverseRectangle α q i) :=
    integrableOn_const (volume_transverseRectangle_ne_top α q i)
  calc
    |∫ y : TransverseSpace i in transverseRectangle α q i, f y| ≤
        ∫ y : TransverseSpace i in transverseRectangle α q i, |f y| :=
      MeasureTheory.abs_integral_le_integral_abs
    _ ≤ ∫ y : TransverseSpace i in transverseRectangle α q i, D := by
      apply MeasureTheory.integral_mono_ae hf.abs hconst
      filter_upwards [ae_restrict_mem (measurableSet_transverseRectangle α q i)]
        with y hy
      exact hbound y hy
    _ = D * transverseArea α q i := by
      rw [integral_const]
      simp only [smul_eq_mul]
      rw [measureReal_restrict_apply_univ]
      change (volume (transverseRectangle α q i)).toReal * D =
        D * transverseArea α q i
      rw [volume_transverseRectangle_toReal]
      ring

/-- After its anisotropic scale weight is included, a face-scale integral
whose transverse integrand is uniformly controlled by `D` has at most
`D` times the mass of its incident box. -/
theorem weighted_abs_face_scale_integral_le_const_mul_boxMass
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) (g : ℝ → ℝ)
    (hg : IntegrableOn (fun t : ℝ ↦
      t ^ (α.weight i - 1) * g t)
      (Set.Ioc (boxLength q / 2) (boxLength q)))
    (D : ℝ) (hD : 0 ≤ D)
    (hbound : ∀ t ∈ Set.Ioc (boxLength q / 2) (boxLength q),
      |g t| ≤ D * transverseArea α q i) :
    (α.weight i : ℝ) *
      |∫ t : ℝ in Set.Ioc (boxLength q / 2) (boxLength q),
        t ^ (α.weight i - 1) * g t| ≤ D * boxMass α q := by
  have harea : 0 ≤ transverseArea α q i := by
    unfold transverseArea
    exact Finset.prod_nonneg (fun j _ ↦ (boxSide_pos α q j.1).le)
  have hcoef : 0 ≤ D * transverseArea α q i := mul_nonneg hD harea
  have hpowCont : Continuous (fun t : ℝ ↦ t ^ (α.weight i - 1)) :=
    continuous_id.pow _
  have hmajor : IntegrableOn (fun t : ℝ ↦
      t ^ (α.weight i - 1) * (D * transverseArea α q i))
      (Set.Ioc (boxLength q / 2) (boxLength q)) := by
    have hcont : Continuous (fun t : ℝ ↦
        t ^ (α.weight i - 1) * (D * transverseArea α q i)) :=
      hpowCont.mul (continuous_const : Continuous fun _ : ℝ ↦
        D * transverseArea α q i)
    exact (hcont.continuousOn.integrableOn_compact isCompact_Icc).mono_set
      Set.Ioc_subset_Icc_self
  have hpoint : ∀ t ∈ Set.Ioc (boxLength q / 2) (boxLength q),
      |t ^ (α.weight i - 1) * g t| ≤
        t ^ (α.weight i - 1) * (D * transverseArea α q i) := by
    intro t ht
    have htpos : 0 < t := by
      exact lt_trans
        (div_pos (boxLength_pos q) (by norm_num : (0 : ℝ) < 2)) ht.1
    rw [abs_mul, abs_of_nonneg (pow_nonneg htpos.le _)]
    exact mul_le_mul_of_nonneg_left (hbound t ht) (pow_nonneg htpos.le _)
  have hint :
      (∫ t : ℝ in Set.Ioc (boxLength q / 2) (boxLength q),
        |t ^ (α.weight i - 1) * g t|) ≤
      ∫ t : ℝ in Set.Ioc (boxLength q / 2) (boxLength q),
        t ^ (α.weight i - 1) * (D * transverseArea α q i) := by
    apply MeasureTheory.integral_mono_ae hg.abs hmajor
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    exact hpoint t ht
  have hweight := scale_weight_integral_le_boxSide α q i
  calc
    (α.weight i : ℝ) *
        |∫ t : ℝ in Set.Ioc (boxLength q / 2) (boxLength q),
          t ^ (α.weight i - 1) * g t| ≤
        (α.weight i : ℝ) *
          ∫ t : ℝ in Set.Ioc (boxLength q / 2) (boxLength q),
            |t ^ (α.weight i - 1) * g t| :=
      mul_le_mul_of_nonneg_left MeasureTheory.abs_integral_le_integral_abs
        (Nat.cast_nonneg _)
    _ ≤ (α.weight i : ℝ) *
          ∫ t : ℝ in Set.Ioc (boxLength q / 2) (boxLength q),
            t ^ (α.weight i - 1) * (D * transverseArea α q i) :=
      mul_le_mul_of_nonneg_left hint (Nat.cast_nonneg _)
    _ = (D * transverseArea α q i) *
          ((α.weight i : ℝ) *
            ∫ t : ℝ in Set.Ioc (boxLength q / 2) (boxLength q),
              t ^ (α.weight i - 1)) := by
      rw [MeasureTheory.integral_mul_const]
      ring
    _ ≤ (D * transverseArea α q i) * boxSide α q i :=
      mul_le_mul_of_nonneg_left hweight hcoef
    _ = D * boxMass α q := by
      rw [transverseArea_eq_boxFaceArea]
      calc
        D * boxFaceArea α q i * boxSide α q i =
            D * (boxFaceArea α q i * boxSide α q i) := by ring
        _ = D * boxMass α q := by rw [boxFaceArea_mul_boxSide]

/-- Finite endpoint forms inherit a uniform one-box center-integral bound. -/
theorem abs_cubeEndpointForm_le_pi_mul_const_mul_sum_boxMass
    (α : Anisotropy) (S : BoxCollection α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (D : ℝ)
    (hint : ∀ q ∈ S,
      IntegrableOn (cubeEndpointIntegrand α lam r (boxLength q) F) (boxSet α q))
    (hbound : ∀ q ∈ S, ∀ p ∈ boxSet α q,
      |cubeEndpointIntegrand α lam r (boxLength q) F p| ≤ D) :
    |cubeEndpointForm α S lam r F| ≤
      Real.pi * D * ∑ q ∈ S, boxMass α q := by
  let w : AnisoBox α → ℝ := fun q ↦
    ∫ p : E3 in boxSet α q, cubeEndpointIntegrand α lam r (boxLength q) F p
  have hbox (q : AnisoBox α) (hq : q ∈ S) :
      |w q| ≤ D * boxMass α q := by
    apply abs_integral_boxSet_le_const_mul_boxMass
      α q (cubeEndpointIntegrand α lam r (boxLength q) F)
    · exact hint q hq
    · obtain ⟨p, hp⟩ := boxSet_nonempty α q
      exact (abs_nonneg _).trans (hbound q hq p hp)
    · intro p hp
      exact hbound q hq p hp
  have habs : |∑ q ∈ S, w q| ≤ ∑ q ∈ S, |w q| :=
    Finset.abs_sum_le_sum_abs w S
  calc
    |cubeEndpointForm α S lam r F| =
        Real.pi * |∑ q ∈ S, w q| := by
      unfold cubeEndpointForm
      change |Real.pi * ∑ q ∈ S, w q| = _
      rw [abs_mul, abs_of_nonneg Real.pi_pos.le]
    _ ≤ Real.pi * (∑ q ∈ S, |w q|) :=
      mul_le_mul_of_nonneg_left habs Real.pi_pos.le
    _ ≤ Real.pi * (∑ q ∈ S, D * boxMass α q) := by
      apply mul_le_mul_of_nonneg_left _ Real.pi_pos.le
      apply Finset.sum_le_sum
      intro q hq
      exact hbox q hq
    _ = Real.pi * D * ∑ q ∈ S, boxMass α q := by
      rw [← Finset.mul_sum]
      ring

/-- An orientation sign does not affect an absolute face contribution. -/
theorem abs_orientation_sign_mul (S : OrientedFace α) (a : ℝ) :
    |(S.orientation.sign : ℝ) * a| = |a| := by
  cases S.orientation <;> simp [FaceOrientation.sign]

/-- The surviving-face boundary form is controlled by a uniform face-integral
bound and the already proved finite face-packing mass estimate. -/
theorem abs_cubeBoundaryFaceForm_le
    (α : Anisotropy) (T : FiniteConvexTree α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (D : ℝ) (hD : 0 ≤ D)
    (hint : ∀ (i : Fin 3) (S : OrientedFace α), S ∈ survivingFacesAll T i →
      IntegrableOn (fun t : ℝ ↦ t ^ (α.weight i - 1) *
        cubeFaceIntegral α i S lam r t F)
        (Set.Ioc (boxLength S.box / 2) (boxLength S.box)))
    (hbound : ∀ (i : Fin 3) (S : OrientedFace α), S ∈ survivingFacesAll T i →
      ∀ t ∈ Set.Ioc (boxLength S.box / 2) (boxLength S.box),
        |cubeFaceIntegral α i S lam r t F| ≤ D * transverseArea α S.box i) :
    |cubeBoundaryFaceForm α T lam r F| ≤
      (24 : ℝ) * Real.pi * D * boxMass α T.root := by
  have hsingle (i : Fin 3) (S : OrientedFace α) (hS : S ∈ survivingFacesAll T i) :
      (α.weight i : ℝ) * |cubeFaceScaleIntegral α i S lam r F| ≤
        D * boxMass α S.box := by
    exact weighted_abs_face_scale_integral_le_const_mul_boxMass
      α S.box i (fun t ↦ cubeFaceIntegral α i S lam r t F) (hint i S hS) D hD
        (hbound i S hS)
  have hcoord (i : Fin 3) :
      (α.weight i : ℝ) *
          |∑ S ∈ survivingFacesAll T i,
            (S.orientation.sign : ℝ) * cubeFaceScaleIntegral α i S lam r F| ≤
        D * facePackingMass T i := by
    have habs :
        |∑ S ∈ survivingFacesAll T i,
          (S.orientation.sign : ℝ) * cubeFaceScaleIntegral α i S lam r F| ≤
          ∑ S ∈ survivingFacesAll T i,
            |(S.orientation.sign : ℝ) * cubeFaceScaleIntegral α i S lam r F| :=
      Finset.abs_sum_le_sum_abs (fun S ↦
        (S.orientation.sign : ℝ) * cubeFaceScaleIntegral α i S lam r F)
        (survivingFacesAll T i)
    calc
      (α.weight i : ℝ) *
          |∑ S ∈ survivingFacesAll T i,
            (S.orientation.sign : ℝ) * cubeFaceScaleIntegral α i S lam r F| ≤
          (α.weight i : ℝ) *
            ∑ S ∈ survivingFacesAll T i,
              |(S.orientation.sign : ℝ) * cubeFaceScaleIntegral α i S lam r F| :=
        mul_le_mul_of_nonneg_left habs (Nat.cast_nonneg _)
      _ = ∑ S ∈ survivingFacesAll T i,
          (α.weight i : ℝ) * |cubeFaceScaleIntegral α i S lam r F| := by
        simp_rw [abs_orientation_sign_mul]
        rw [Finset.mul_sum]
      _ ≤ ∑ S ∈ survivingFacesAll T i, D * boxMass α S.box := by
        apply Finset.sum_le_sum
        intro S hS
        exact hsingle i S hS
      _ = D * facePackingMass T i := by
        unfold facePackingMass
        rw [Finset.mul_sum]
  have hsum :
      |∑ i : Fin 3, (α.weight i : ℝ) *
        ∑ S ∈ survivingFacesAll T i,
          (S.orientation.sign : ℝ) * cubeFaceScaleIntegral α i S lam r F| ≤
      ∑ i : Fin 3, D * facePackingMass T i := by
    calc
      |∑ i : Fin 3, (α.weight i : ℝ) *
          ∑ S ∈ survivingFacesAll T i,
            (S.orientation.sign : ℝ) * cubeFaceScaleIntegral α i S lam r F| ≤
          ∑ i : Fin 3, |(α.weight i : ℝ) *
            ∑ S ∈ survivingFacesAll T i,
              (S.orientation.sign : ℝ) * cubeFaceScaleIntegral α i S lam r F| :=
        Finset.abs_sum_le_sum_abs _ _
      _ = ∑ i : Fin 3, (α.weight i : ℝ) *
          |∑ S ∈ survivingFacesAll T i,
            (S.orientation.sign : ℝ) * cubeFaceScaleIntegral α i S lam r F| := by
        apply Finset.sum_congr rfl
        intro i hi
        rw [abs_mul, abs_of_nonneg (Nat.cast_nonneg _)]
      _ ≤ ∑ i : Fin 3, D * facePackingMass T i := by
        apply Finset.sum_le_sum
        intro i hi
        exact hcoord i
  have hpack (i : Fin 3) : facePackingMass T i ≤ 8 * boxMass α T.root :=
    facePackingMass_le_eight T i
  have hsumPack :
      ∑ i : Fin 3, D * facePackingMass T i ≤
        (24 : ℝ) * D * boxMass α T.root := by
    calc
      ∑ i : Fin 3, D * facePackingMass T i ≤
          ∑ _i : Fin 3, D * (8 * boxMass α T.root) := by
        apply Finset.sum_le_sum
        intro i hi
        exact mul_le_mul_of_nonneg_left (hpack i) hD
      _ = (24 : ℝ) * D * boxMass α T.root := by
        norm_num [Fin.sum_univ_succ]
        ring
  unfold cubeBoundaryFaceForm
  calc
    |-Real.pi * ∑ i : Fin 3, (α.weight i : ℝ) *
        ∑ S ∈ survivingFacesAll T i,
          (S.orientation.sign : ℝ) * cubeFaceScaleIntegral α i S lam r F| =
        Real.pi * |∑ i : Fin 3, (α.weight i : ℝ) *
          ∑ S ∈ survivingFacesAll T i,
            (S.orientation.sign : ℝ) * cubeFaceScaleIntegral α i S lam r F| := by
      rw [abs_mul, abs_neg, abs_of_nonneg Real.pi_pos.le]
    _ ≤ Real.pi * (∑ i : Fin 3, D * facePackingMass T i) :=
      mul_le_mul_of_nonneg_left hsum Real.pi_pos.le
    _ ≤ Real.pi * ((24 : ℝ) * D * boxMass α T.root) :=
      mul_le_mul_of_nonneg_left hsumPack Real.pi_pos.le
    _ = (24 : ℝ) * Real.pi * D * boxMass α T.root := by ring

/-- The endpoint form on the tree leaves has the root-mass bound supplied by
the exact leaf partition. -/
theorem abs_cubeEndpointForm_leaves_le_pi_mul_const_mul_rootMass
    (α : Anisotropy) (T : FiniteConvexTree α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (D : ℝ)
    (hint : ∀ q ∈ treeLeaves T,
      IntegrableOn (cubeEndpointIntegrand α lam r (boxLength q) F) (boxSet α q))
    (hbound : ∀ q ∈ treeLeaves T, ∀ p ∈ boxSet α q,
      |cubeEndpointIntegrand α lam r (boxLength q) F p| ≤ D) :
    |cubeEndpointForm α (treeLeaves T) lam r F| ≤
      Real.pi * D * boxMass α T.root := by
  calc
    |cubeEndpointForm α (treeLeaves T) lam r F| ≤
        Real.pi * D * ∑ q ∈ treeLeaves T, boxMass α q :=
      abs_cubeEndpointForm_le_pi_mul_const_mul_sum_boxMass
        α (treeLeaves T) lam r F D hint hbound
    _ = Real.pi * D * boxMass α T.root := by
      rw [← boxMass_root_eq_sum_boxMass_leaves]

/-- The root singleton endpoint has the same literal root-mass bound. -/
theorem abs_cubeEndpointForm_root_le_pi_mul_const_mul_rootMass
    (α : Anisotropy) (T : FiniteConvexTree α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (D : ℝ)
    (hint : IntegrableOn
      (cubeEndpointIntegrand α lam r (boxLength T.root) F) (boxSet α T.root))
    (hbound : ∀ p ∈ boxSet α T.root,
      |cubeEndpointIntegrand α lam r (boxLength T.root) F p| ≤ D) :
    |cubeEndpointForm α ({T.root} : BoxCollection α) lam r F| ≤
      Real.pi * D * boxMass α T.root := by
  simpa using
    (abs_cubeEndpointForm_le_pi_mul_const_mul_sum_boxMass
      α ({T.root} : BoxCollection α) lam r F D
      (fun q hq ↦ by
        have hq' : q = T.root := Finset.mem_singleton.mp hq
        subst q
        exact hint)
      (fun q hq p hp ↦ by
        have hq' : q = T.root := Finset.mem_singleton.mp hq
        subst q
        exact hbound p hp))

/-- The literal remainder is bounded once its leaf/root endpoint integrands
and all surviving face integrands have uniform local-size controls. -/
theorem abs_cubeTreeRemainder_le_of_uniform_bounds
    (α : Anisotropy) (T : FiniteConvexTree α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (DE DF : ℝ) (hDF : 0 ≤ DF)
    (hLeafInt : ∀ q ∈ treeLeaves T,
      IntegrableOn (cubeEndpointIntegrand α lam r (boxLength q) F) (boxSet α q))
    (hLeafBound : ∀ q ∈ treeLeaves T, ∀ p ∈ boxSet α q,
      |cubeEndpointIntegrand α lam r (boxLength q) F p| ≤ DE)
    (hRootInt : IntegrableOn
      (cubeEndpointIntegrand α lam r (boxLength T.root) F) (boxSet α T.root))
    (hRootBound : ∀ p ∈ boxSet α T.root,
      |cubeEndpointIntegrand α lam r (boxLength T.root) F p| ≤ DE)
    (hFaceInt : ∀ (i : Fin 3) (S : OrientedFace α), S ∈ survivingFacesAll T i →
      IntegrableOn (fun t : ℝ ↦ t ^ (α.weight i - 1) *
        cubeFaceIntegral α i S lam r t F)
        (Set.Ioc (boxLength S.box / 2) (boxLength S.box)))
    (hFaceBound : ∀ (i : Fin 3) (S : OrientedFace α), S ∈ survivingFacesAll T i →
      ∀ t ∈ Set.Ioc (boxLength S.box / 2) (boxLength S.box),
        |cubeFaceIntegral α i S lam r t F| ≤ DF * transverseArea α S.box i) :
    |cubeTreeRemainder α T lam r F| ≤
      (2 * Real.pi * DE + 24 * Real.pi * DF) * boxMass α T.root := by
  have hleaf := abs_cubeEndpointForm_leaves_le_pi_mul_const_mul_rootMass
    α T lam r F DE hLeafInt hLeafBound
  have hroot := abs_cubeEndpointForm_root_le_pi_mul_const_mul_rootMass
    α T lam r F DE hRootInt hRootBound
  have hface := abs_cubeBoundaryFaceForm_le
    α T lam r F DF hDF hFaceInt hFaceBound
  unfold cubeTreeRemainder
  calc
    |cubeEndpointForm α (treeLeaves T) lam r F -
        cubeEndpointForm α {T.root} lam r F + cubeBoundaryFaceForm α T lam r F| ≤
        |cubeEndpointForm α (treeLeaves T) lam r F| +
          |cubeEndpointForm α {T.root} lam r F| +
            |cubeBoundaryFaceForm α T lam r F| := by
      calc
        |cubeEndpointForm α (treeLeaves T) lam r F -
            cubeEndpointForm α {T.root} lam r F + cubeBoundaryFaceForm α T lam r F| ≤
            |cubeEndpointForm α (treeLeaves T) lam r F -
              cubeEndpointForm α {T.root} lam r F| +
              |cubeBoundaryFaceForm α T lam r F| := abs_add_le _ _
        _ ≤ (|cubeEndpointForm α (treeLeaves T) lam r F| +
              |cubeEndpointForm α {T.root} lam r F|) +
              |cubeBoundaryFaceForm α T lam r F| :=
          by
            have hsub :
                |cubeEndpointForm α (treeLeaves T) lam r F -
                    cubeEndpointForm α {T.root} lam r F| ≤
                  |cubeEndpointForm α (treeLeaves T) lam r F| +
                    |cubeEndpointForm α {T.root} lam r F| := by
              simpa using (abs_sub_le
                (cubeEndpointForm α (treeLeaves T) lam r F) 0
                (cubeEndpointForm α {T.root} lam r F))
            exact add_le_add hsub le_rfl
        _ = _ := by ring
    _ ≤ (Real.pi * DE * boxMass α T.root +
          Real.pi * DE * boxMass α T.root) +
            (24 : ℝ) * Real.pi * DF * boxMass α T.root := by
      exact add_le_add (add_le_add hleaf hroot) hface
    _ = (2 * Real.pi * DE + 24 * Real.pi * DF) * boxMass α T.root := by ring

/-- A point at the full scale of any tree box lies in the closure (indeed in
the literal region) needed by the uniform kernel estimates. -/
theorem mem_closure_collectionRegion_of_mem_boxSet_fullScale
    (α : Anisotropy) (T : FiniteConvexTree α) (q : AnisoBox α)
    (hq : q ∈ T.boxes) {p : E3} (hp : p ∈ boxSet α q) :
    (p, boxLength q) ∈ closure (collectionRegion α T.boxes) := by
  apply subset_closure
  unfold collectionRegion
  refine Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hq, ?_⟩⟩
  exact ⟨hp, ⟨div_lt_self (boxLength_pos q) (by norm_num), le_rfl⟩⟩

/-- Every literal child has half the parent length, in a parent-only form
convenient for tree leaves. -/
theorem boxLength_eq_half_parent
    (α : Anisotropy) (q : AnisoBox α) :
    boxLength q = boxLength (boxParent α q) / 2 := by
  unfold boxLength boxParent
  rw [show q.level = (q.level + 1) - 1 by omega,
    zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0)]
  norm_num

/-- A leaf at its own full scale lies in the closure of its parent's source
cell, hence in the closure of the whole tree region. -/
theorem mem_closure_collectionRegion_of_mem_leaf_boxSet_fullScale
    (α : Anisotropy) (T : FiniteConvexTree α) (l : AnisoBox α)
    (hl : l ∈ treeLeaves T) {p : E3} (hp : p ∈ boxSet α l) :
    (p, boxLength l) ∈ closure (collectionRegion α T.boxes) := by
  let q : AnisoBox α := boxParent α l
  have hq : q ∈ T.boxes := by
    exact treeLeaves_parent_mem T hl
  have hpsub : p ∈ boxSet α q := by
    dsimp only [q]
    exact boxSet_subset_parent α l hp
  have hcell : (p, boxLength l) ∈ closure (boxScaleRegion α q) := by
    rw [boxScaleRegion, closure_prod_eq]
    constructor
    · exact subset_closure hpsub
    · rw [boxScaleBand]
      have hne : boxLength q / 2 ≠ boxLength q := by
        nlinarith [boxLength_pos q]
      rw [closure_Ioc hne]
      have hlen : boxLength l = boxLength q / 2 := by
        dsimp only [q]
        exact boxLength_eq_half_parent α l
      rw [hlen]
      exact ⟨le_rfl, (div_le_iff₀ (by norm_num : (0 : ℝ) < 2)).mpr
        (by linarith [boxLength_pos q])⟩
  apply closure_mono
  · intro z hz
    unfold collectionRegion
    exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hq, hz⟩⟩
  · exact hcell


/-- Every point of the closure of a nonempty finite box-scale region has
strictly positive scale. -/
theorem pos_of_mem_closure_collectionRegion
    (α : Anisotropy) (S : BoxCollection α) {p : E3} {t : ℝ}
    (hpt : (p, t) ∈ closure (collectionRegion α S)) :
    0 < t := by
  rcases mem_closure_collectionRegion_exists_bounds α S hpt with
    ⟨q, hq, hp, hlower, hupper⟩
  exact lt_of_lt_of_le (div_pos (boxLength_pos q) (by norm_num)) hlower

/-- The fixed-parameter local cube spatial integral is controlled uniformly
on the closure of a tree region by the product of tree-local fourth sizes. -/
theorem abs_integral_localCubeKernel_le_treeLocalSize_product_of_mem_closure
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α) (i : Fin 3)
      (lam r t : ℝ) (p : E3) (F : CubeVertex → E3 → ℝ),
      (∀ j, Continuous (F j)) →
      (∀ j, Measurable (F j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B) →
      1 ≤ lam →
      (p, t) ∈ closure (collectionRegion α T.boxes) →
      |∫ x : E6, cubeSignedInputProduct F x *
        localCubeKernel α i lam r t p x| ≤
        C * lam ^ 36 * translationWeight r ^ 20 *
          ∏ j : CubeVertex, treeLocalSize T 4 (F j) := by
  rcases abs_integral_localCubeKernel_le_bracketAverage α with
    ⟨C, hC, hlocal⟩
  let S : ℝ := boxScaleComparisonConstant α
  refine ⟨C ^ 6 * S,
    mul_nonneg (pow_nonneg hC _) (boxScaleComparisonConstant_nonneg α), ?_⟩
  intro T i lam r t p F hFcont hFmeas hFbound hlam hpt
  have ht : 0 < t := pos_of_mem_closure_collectionRegion α T.boxes hpt
  have hlocal' := hlocal i lam r t p F hFcont hFbound hlam ht
  have hsize := cubeBracketAverage_le_treeLocalSize_product_of_mem_closure
    T F hFcont hFmeas hFbound hpt
  have hfac : 0 ≤ C ^ 6 * lam ^ 36 * translationWeight r ^ 20 := by
    have hlam0 : 0 ≤ lam := by linarith
    have hR : 0 ≤ translationWeight r := by
      unfold translationWeight
      positivity
    change 0 ≤ (C ^ (6 : ℕ) * lam ^ (36 : ℕ)) * translationWeight r ^ (20 : ℕ)
    exact mul_nonneg
      (mul_nonneg (pow_nonneg hC _) (pow_nonneg hlam0 _))
      (pow_nonneg hR _)
  calc
    |∫ x : E6, cubeSignedInputProduct F x *
        localCubeKernel α i lam r t p x| ≤
        C ^ 6 * lam ^ 36 * translationWeight r ^ 20 *
          cubeBracketAverage α t p F := hlocal'
    _ ≤ C ^ 6 * lam ^ 36 * translationWeight r ^ 20 *
        (S * ∏ j : CubeVertex, treeLocalSize T 4 (F j)) :=
      mul_le_mul_of_nonneg_left hsize hfac
    _ = (C ^ 6 * S) * lam ^ 36 * translationWeight r ^ 20 *
        ∏ j : CubeVertex, treeLocalSize T 4 (F j) := by ring

/-- The endpoint spatial integral is controlled uniformly on the closure of
a tree region by the product of tree-local fourth sizes. -/
theorem abs_integral_cubeEndpointKernel_le_treeLocalSize_product_of_mem_closure
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α)
      (lam r t : ℝ) (p : E3) (F : CubeVertex → E3 → ℝ),
      (∀ j, Continuous (F j)) →
      (∀ j, Measurable (F j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B) →
