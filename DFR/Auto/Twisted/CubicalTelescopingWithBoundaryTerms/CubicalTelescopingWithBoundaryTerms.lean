  change HasDerivAt (fun u : ℝ ↦ u⁻¹ * gaussian ((x - a) / u))
    (-s⁻¹ * (s⁻¹ * gaussian ((x - a) / s)) -
      (x - a) * (s ^ 2)⁻¹ * (s⁻¹ * gaussianDeriv ((x - a) / s))) s
  have hinv : HasDerivAt (fun u : ℝ ↦ u⁻¹) (-(s ^ 2)⁻¹) s := by
    simpa [inv_pow] using hasDerivAt_inv hs
  have hinner : HasDerivAt (fun u : ℝ ↦ (x - a) / u)
      ((x - a) * (-(s ^ 2)⁻¹)) s := by
    simpa [div_eq_mul_inv] using hinv.const_mul (x - a)
  have houter := (hasDerivAt_gaussian ((x - a) / s)).comp s hinner
