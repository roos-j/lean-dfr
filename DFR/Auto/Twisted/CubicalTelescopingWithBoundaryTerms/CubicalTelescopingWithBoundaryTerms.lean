      2 * Real.pi * z * (s⁻¹ * gaussianDeriv z))) p
  have hinner : HasDerivAt
      (fun q : ℝ ↦ (u - (q + sig * t ^ n)) / (mu * t ^ n))
      (-(mu * t ^ n)⁻¹) p := by
    have hsub : HasDerivAt (fun q : ℝ ↦ u - (q + sig * t ^ n)) (-1) p := by
      convert! ((hasDerivAt_id' (𝕜 := ℝ) p).add_const (sig * t ^ n)).const_sub u using 1
    simpa [div_eq_mul_inv] using hsub.mul_const (mu * t ^ n)⁻¹
  have houter := (hasDerivAt_gaussianDeriv
    ((u - (p + sig * t ^ n)) / (mu * t ^ n))).comp p hinner
  have hraw := houter.const_mul (mu * t ^ n)⁻¹
  have hcoef : s⁻¹ *
      ((-2 * Real.pi * gaussian z - 2 * Real.pi * z * gaussianDeriv z) * -s⁻¹) =
    s⁻¹ * (2 * Real.pi * (s⁻¹ * gaussian z) +
      2 * Real.pi * z * (s⁻¹ * gaussianDeriv z)) := by ring
  rw [← hcoef]
  convert! hraw using 1

theorem hasDerivAt_scalarD_center {mu sig : ℝ} {n : ℕ} {t p u0 u1 : ℝ}
    (hscale : mu * t ^ n ≠ 0) :
    HasDerivAt (fun q : ℝ ↦ scalarD mu sig n t q u0 u1)
      (-(mu * t ^ n)⁻¹ * scalarW mu sig n t p u0 u1) p := by
  have h0 := hasDerivAt_scalarG_center (mu := mu) (sig := sig)
    (n := n) (t := t) (p := p) (u := u0) hscale
  have h1 := hasDerivAt_scalarG_center (mu := mu) (sig := sig)
    (n := n) (t := t) (p := p) (u := u1) hscale
  have hraw := h0.mul h1
  convert! hraw using 1
  simp [scalarW]
  ring

/-- Standardized affine coordinate inside a scalar local Gaussian. -/
def scalarZ (mu sig : ℝ) (n : ℕ) (t p u : ℝ) : ℝ :=
  (u - (p + sig * t ^ n)) / (mu * t ^ n)

/-- Restatement of the clean scale calculation using the standardized
coordinate. -/
theorem hasDerivAt_scalarG_scale_z {mu sig : ℝ} {n : ℕ} {t p u : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    HasDerivAt (fun q : ℝ => scalarG mu sig n q p u)
      (-(n : ℝ) / t *
        (scalarG mu sig n t p u + (scalarZ mu sig n t p u + sig / mu) *
          scalarH mu sig n t p u)) t := by
  simpa [scalarZ] using hasDerivAt_scalarG_scale
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u := u) hmu ht

theorem hasDerivAt_scalarD_scale {mu sig : ℝ} {n : ℕ} {t p u0 u1 : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    HasDerivAt (fun q : ℝ => scalarD mu sig n q p u0 u1)
      (-(n : ℝ) / t *
        (2 * scalarD mu sig n t p u0 u1 +
          (scalarZ mu sig n t p u0 + sig / mu) * scalarH mu sig n t p u0 *
            scalarG mu sig n t p u1 +
          (scalarZ mu sig n t p u1 + sig / mu) * scalarG mu sig n t p u0 *
            scalarH mu sig n t p u1)) t := by
  have h0 := hasDerivAt_scalarG_scale_z
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u := u0) hmu ht
  have h1 := hasDerivAt_scalarG_scale_z
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u := u1) hmu ht
  have hprod := h0.mul h1
  convert! hprod using 1
  simp [scalarD]
  ring

/-- Restatement of the `H` center derivative using `scalarZ`. -/
theorem hasDerivAt_scalarH_center_z {mu sig : ℝ} {n : ℕ} {t p u : ℝ} :
    HasDerivAt (fun q : ℝ => scalarH mu sig n t q u)
      ((mu * t ^ n)⁻¹ *
        (2 * Real.pi * scalarG mu sig n t p u +
          2 * Real.pi * scalarZ mu sig n t p u * scalarH mu sig n t p u)) p := by
  simpa [scalarZ] using hasDerivAt_scalarH_center
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u := u)

theorem hasDerivAt_scalarE_center {mu sig : ℝ} {n : ℕ} {t p u0 u1 : ℝ}
    (hscale : mu * t ^ n ≠ 0) :
    HasDerivAt (fun q : ℝ => scalarE mu sig n t q u0 u1)
      (mu / (2 * Real.pi) * (mu * t ^ n)⁻¹ *
        (4 * Real.pi * scalarD mu sig n t p u0 u1 +
          2 * Real.pi * scalarZ mu sig n t p u0 * scalarH mu sig n t p u0 *
            scalarG mu sig n t p u1 +
          2 * Real.pi * scalarZ mu sig n t p u1 * scalarG mu sig n t p u0 *
            scalarH mu sig n t p u1 -
          2 * scalarP mu sig n t p u0 u1) +
        sig * (mu * t ^ n)⁻¹ * scalarW mu sig n t p u0 u1) p := by
  have hg0 := hasDerivAt_scalarG_center
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u := u0) hscale
  have hg1 := hasDerivAt_scalarG_center
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u := u1) hscale
  have hh0 := hasDerivAt_scalarH_center_z
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u := u0)
  have hh1 := hasDerivAt_scalarH_center_z
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u := u1)
  have hw := (hh0.mul hg1).add (hg0.mul hh1)
  have hd := hg0.mul hg1
  have he := hw.const_mul (mu / (2 * Real.pi)) |>.sub (hd.const_mul sig)
  convert! he using 1
  simp [scalarW, scalarD, scalarP]
  ring

/-- Pointwise one-dimensional divergence identity underlying the source
telescoping lemma. -/
theorem scalar_pointwise_divergence {mu sig : ℝ} {n : ℕ} {t p u0 u1 : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    -t * deriv (fun q : ℝ => scalarD mu sig n q p u0 u1) t =
      (n : ℝ) / Real.pi * scalarP mu sig n t p u0 u1 +
        (n : ℝ) * t ^ n * deriv (fun q : ℝ => scalarE mu sig n t q u0 u1) p := by
  have hpowne : t ^ n ≠ 0 := pow_ne_zero n ht
  have hscale : mu * t ^ n ≠ 0 := mul_ne_zero hmu hpowne
  have hD := hasDerivAt_scalarD_scale
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u0 := u0) (u1 := u1)
      hmu ht
  have hE := hasDerivAt_scalarE_center
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u0 := u0) (u1 := u1)
      hscale
  rw [hD.deriv, hE.deriv]
  field_simp [hmu, ht, Real.pi_ne_zero]
  simp [scalarW]
  ring

/-- The exact interval form of the one-dimensional source identity, with the
regularity required by the ordinary fundamental theorem made explicit. -/
theorem scalar_oneDim_telescoping
    {mu sig t a b u0 u1 : ℝ} {n : ℕ}
    (hmu : mu ≠ 0) (ht : t ≠ 0)
    (_hDdot : IntervalIntegrable
      (fun p : ℝ => deriv (fun q : ℝ => scalarD mu sig n q p u0 u1) t)
      volume a b)
    (hP : IntervalIntegrable (fun p : ℝ => scalarP mu sig n t p u0 u1)
      volume a b)
    (hEdiff : ∀ p ∈ Set.uIcc a b,
      DifferentiableAt ℝ (fun q : ℝ => scalarE mu sig n t q u0 u1) p)
    (hEcont : ContinuousOn
      (deriv (fun q : ℝ => scalarE mu sig n t q u0 u1)) (Set.uIcc a b)) :
    ∫ p in a..b, -t * deriv (fun q : ℝ => scalarD mu sig n q p u0 u1) t =
      (n : ℝ) / Real.pi *
          (∫ p in a..b, scalarP mu sig n t p u0 u1) +
        (n : ℝ) * t ^ n *
          (scalarE mu sig n t b u0 u1 - scalarE mu sig n t a u0 u1) := by
  have hEint : IntervalIntegrable
      (deriv (fun q : ℝ => scalarE mu sig n t q u0 u1)) volume a b :=
    hEcont.intervalIntegrable
  have hFTC :
      (∫ p in a..b, deriv (fun q : ℝ => scalarE mu sig n t q u0 u1) p) =
        scalarE mu sig n t b u0 u1 - scalarE mu sig n t a u0 u1 :=
    intervalIntegral.integral_deriv_eq_sub hEdiff hEint
  calc
    ∫ p in a..b, -t * deriv (fun q : ℝ => scalarD mu sig n q p u0 u1) t =
        ∫ p in a..b, ((n : ℝ) / Real.pi * scalarP mu sig n t p u0 u1 +
          (n : ℝ) * t ^ n *
            deriv (fun q : ℝ => scalarE mu sig n t q u0 u1) p) := by
      apply intervalIntegral.integral_congr
      intro p hp
      exact scalar_pointwise_divergence
        (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u0 := u0) (u1 := u1)
          hmu ht
    _ = (n : ℝ) / Real.pi *
          (∫ p in a..b, scalarP mu sig n t p u0 u1) +
        (n : ℝ) * t ^ n *
          (∫ p in a..b, deriv (fun q : ℝ => scalarE mu sig n t q u0 u1) p) := by
      rw [intervalIntegral.integral_add
        (hP.const_mul ((n : ℝ) / Real.pi))
        (hEint.const_mul ((n : ℝ) * t ^ n))]
      rw [intervalIntegral.integral_const_mul,
        intervalIntegral.integral_const_mul]
    _ = _ := by rw [hFTC]

/-- Continuous dependence of the scalar Gaussian pair on its active center. -/
theorem continuous_scalarG_center {mu sig : ℝ} {n : ℕ} {t u : ℝ}
    (hscale : mu * t ^ n ≠ 0) :
    Continuous (fun p : ℝ ↦ scalarG mu sig n t p u) := by
  rw [continuous_iff_continuousAt]
  intro p
  exact (hasDerivAt_scalarG_center (mu := mu) (sig := sig) (n := n)
    (t := t) (p := p) (u := u) hscale).continuousAt

theorem continuous_scalarH_center {mu sig : ℝ} {n : ℕ} {t u : ℝ} :
    Continuous (fun p : ℝ ↦ scalarH mu sig n t p u) := by
  rw [continuous_iff_continuousAt]
  intro p
  exact (hasDerivAt_scalarH_center (mu := mu) (sig := sig) (n := n)
    (t := t) (p := p) (u := u)).continuousAt

theorem continuous_scalarZ_center {mu sig : ℝ} {n : ℕ} {t u : ℝ} :
    Continuous (fun p : ℝ ↦ scalarZ mu sig n t p u) := by
  unfold scalarZ
  fun_prop

theorem continuous_scalarD_center {mu sig : ℝ} {n : ℕ} {t u0 u1 : ℝ}
    (hscale : mu * t ^ n ≠ 0) :
    Continuous (fun p : ℝ ↦ scalarD mu sig n t p u0 u1) := by
  exact (continuous_scalarG_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u0) hscale).mul
      (continuous_scalarG_center (mu := mu) (sig := sig) (n := n)
        (t := t) (u := u1) hscale)

theorem continuous_scalarP_center {mu sig : ℝ} {n : ℕ} {t u0 u1 : ℝ} :
    Continuous (fun p : ℝ ↦ scalarP mu sig n t p u0 u1) := by
  exact (continuous_scalarH_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u0)).mul
      (continuous_scalarH_center (mu := mu) (sig := sig) (n := n)
        (t := t) (u := u1))

theorem continuous_scalarW_center {mu sig : ℝ} {n : ℕ} {t u0 u1 : ℝ}
    (hscale : mu * t ^ n ≠ 0) :
    Continuous (fun p : ℝ ↦ scalarW mu sig n t p u0 u1) := by
  have hG0 := continuous_scalarG_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u0) hscale
  have hG1 := continuous_scalarG_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u1) hscale
  have hH0 := continuous_scalarH_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u0)
  have hH1 := continuous_scalarH_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u1)
  convert! (hH0.mul hG1).add (hG0.mul hH1) using 1

theorem continuous_scalarE_center {mu sig : ℝ} {n : ℕ} {t u0 u1 : ℝ}
    (hscale : mu * t ^ n ≠ 0) :
    Continuous (fun p : ℝ ↦ scalarE mu sig n t p u0 u1) := by
  have hW := continuous_scalarW_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u0 := u0) (u1 := u1) hscale
  have hD := continuous_scalarD_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u0 := u0) (u1 := u1) hscale
  convert! (hW.const_mul (mu / (2 * Real.pi))).sub
    (hD.const_mul sig) using 1

theorem continuous_scalarDdot_center {mu sig : ℝ} {n : ℕ} {t u0 u1 : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    Continuous (fun p : ℝ ↦
      deriv (fun q : ℝ ↦ scalarD mu sig n q p u0 u1) t) := by
  have hscale : mu * t ^ n ≠ 0 :=
    mul_ne_zero hmu (pow_ne_zero n ht)
  have hD := continuous_scalarD_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u0 := u0) (u1 := u1) hscale
  have hG0 := continuous_scalarG_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u0) hscale
  have hG1 := continuous_scalarG_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u1) hscale
  have hH0 := continuous_scalarH_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u0)
  have hH1 := continuous_scalarH_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u1)
  have hZ0 := continuous_scalarZ_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u0)
  have hZ1 := continuous_scalarZ_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u1)
  let f : ℝ → ℝ := fun p ↦
    -(n : ℝ) / t *
      (2 * scalarD mu sig n t p u0 u1 +
        (scalarZ mu sig n t p u0 + sig / mu) * scalarH mu sig n t p u0 *
          scalarG mu sig n t p u1 +
        (scalarZ mu sig n t p u1 + sig / mu) * scalarG mu sig n t p u0 *
          scalarH mu sig n t p u1)
  have hf : Continuous f := by
    dsimp [f]
    have hterm0 : Continuous (fun p : ℝ ↦ 2 * scalarD mu sig n t p u0 u1) :=
      continuous_const.mul hD
    have hterm1 : Continuous (fun p : ℝ ↦
        (scalarZ mu sig n t p u0 + sig / mu) * scalarH mu sig n t p u0 *
          scalarG mu sig n t p u1) :=
      ((hZ0.add continuous_const).mul hH0).mul hG1
    have hterm2 : Continuous (fun p : ℝ ↦
        (scalarZ mu sig n t p u1 + sig / mu) * scalarG mu sig n t p u0 *
          scalarH mu sig n t p u1) :=
      ((hZ1.add continuous_const).mul hG0).mul hH1
    have hconst : Continuous (fun _ : ℝ ↦ -(n : ℝ) / t) := continuous_const
    convert! hconst.mul (hterm0.add (hterm1.add hterm2)) using 1
    funext p
    simp only [Pi.mul_apply, Pi.add_apply]
    ring
  have heq : (fun p : ℝ ↦
      deriv (fun q : ℝ ↦ scalarD mu sig n q p u0 u1) t) = f := by
    funext p
    exact (hasDerivAt_scalarD_scale
      (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u0 := u0) (u1 := u1)
        hmu ht).deriv
  rw [heq]
  exact hf

theorem continuous_scalarEdot_center {mu sig : ℝ} {n : ℕ} {t u0 u1 : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    Continuous (fun p : ℝ ↦
      deriv (fun q : ℝ ↦ scalarE mu sig n t q u0 u1) p) := by
  have hscale : mu * t ^ n ≠ 0 :=
    mul_ne_zero hmu (pow_ne_zero n ht)
  have hD := continuous_scalarD_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u0 := u0) (u1 := u1) hscale
  have hG0 := continuous_scalarG_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u0) hscale
  have hG1 := continuous_scalarG_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u1) hscale
  have hH0 := continuous_scalarH_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u0)
  have hH1 := continuous_scalarH_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u1)
  have hZ0 := continuous_scalarZ_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u0)
  have hZ1 := continuous_scalarZ_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u := u1)
  have hP := continuous_scalarP_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u0 := u0) (u1 := u1)
  have hW := continuous_scalarW_center (mu := mu) (sig := sig) (n := n)
    (t := t) (u0 := u0) (u1 := u1) hscale
  let f : ℝ → ℝ := fun p ↦
    mu / (2 * Real.pi) * (mu * t ^ n)⁻¹ *
      (4 * Real.pi * scalarD mu sig n t p u0 u1 +
        2 * Real.pi * scalarZ mu sig n t p u0 * scalarH mu sig n t p u0 *
          scalarG mu sig n t p u1 +
        2 * Real.pi * scalarZ mu sig n t p u1 * scalarG mu sig n t p u0 *
          scalarH mu sig n t p u1 -
        2 * scalarP mu sig n t p u0 u1) +
      sig * (mu * t ^ n)⁻¹ * scalarW mu sig n t p u0 u1
  have hf : Continuous f := by
    dsimp [f]
    have htermD : Continuous (fun p : ℝ ↦
        4 * Real.pi * scalarD mu sig n t p u0 u1) :=
      hD.const_mul (4 * Real.pi)
    have htermZ0 : Continuous (fun p : ℝ ↦
        2 * Real.pi * scalarZ mu sig n t p u0 * scalarH mu sig n t p u0 *
          scalarG mu sig n t p u1) :=
      ((continuous_const.mul hZ0).mul hH0).mul hG1
    have htermZ1 : Continuous (fun p : ℝ ↦
        2 * Real.pi * scalarZ mu sig n t p u1 * scalarG mu sig n t p u0 *
          scalarH mu sig n t p u1) :=
      ((continuous_const.mul hZ1).mul hG0).mul hH1
    have htermP : Continuous (fun p : ℝ ↦
        2 * scalarP mu sig n t p u0 u1) :=
      hP.const_mul 2
    have hins : Continuous (fun p : ℝ ↦
        4 * Real.pi * scalarD mu sig n t p u0 u1 +
          2 * Real.pi * scalarZ mu sig n t p u0 * scalarH mu sig n t p u0 *
            scalarG mu sig n t p u1 +
          2 * Real.pi * scalarZ mu sig n t p u1 * scalarG mu sig n t p u0 *
            scalarH mu sig n t p u1 -
          2 * scalarP mu sig n t p u0 u1) := by
      convert! (htermD.add (htermZ0.add htermZ1)).sub htermP using 1
      funext p
      simp only [Pi.add_apply, Pi.sub_apply]
      ring
    have hleft : Continuous (fun p : ℝ ↦
        mu / (2 * Real.pi) * (mu * t ^ n)⁻¹ *
          (4 * Real.pi * scalarD mu sig n t p u0 u1 +
            2 * Real.pi * scalarZ mu sig n t p u0 * scalarH mu sig n t p u0 *
              scalarG mu sig n t p u1 +
            2 * Real.pi * scalarZ mu sig n t p u1 * scalarG mu sig n t p u0 *
              scalarH mu sig n t p u1 -
            2 * scalarP mu sig n t p u0 u1)) :=
      hins.const_mul (mu / (2 * Real.pi) * (mu * t ^ n)⁻¹)
    have hright : Continuous (fun p : ℝ ↦
        sig * (mu * t ^ n)⁻¹ * scalarW mu sig n t p u0 u1) :=
      hW.const_mul (sig * (mu * t ^ n)⁻¹)
    convert! hleft.add hright using 1
  have heq : (fun p : ℝ ↦
      deriv (fun q : ℝ ↦ scalarE mu sig n t q u0 u1) p) = f := by
    funext p
    exact (hasDerivAt_scalarE_center
      (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u0 := u0) (u1 := u1)
        hscale).deriv
  rw [heq]
  exact hf

theorem scalarE_differentiableAt_center {mu sig : ℝ} {n : ℕ} {t p u0 u1 : ℝ}
    (hscale : mu * t ^ n ≠ 0) :
    DifferentiableAt ℝ (fun q : ℝ ↦ scalarE mu sig n t q u0 u1) p :=
  (hasDerivAt_scalarE_center
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u0 := u0) (u1 := u1)
      hscale).differentiableAt

/-- The source one-dimensional telescope with all compact-interval
regularity discharged for nonzero scale and width. -/
theorem scalar_oneDim_telescoping_of_ne_zero
    {mu sig t a b u0 u1 : ℝ} {n : ℕ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    ∫ p in a..b, -t * deriv (fun q : ℝ => scalarD mu sig n q p u0 u1) t =
      (n : ℝ) / Real.pi *
          (∫ p in a..b, scalarP mu sig n t p u0 u1) +
        (n : ℝ) * t ^ n *
          (scalarE mu sig n t b u0 u1 - scalarE mu sig n t a u0 u1) := by
  have hscale : mu * t ^ n ≠ 0 :=
    mul_ne_zero hmu (pow_ne_zero n ht)
  apply scalar_oneDim_telescoping hmu ht
  · exact (continuous_scalarDdot_center
      (mu := mu) (sig := sig) (n := n) (t := t) (u0 := u0) (u1 := u1) hmu ht).intervalIntegrable a b
  · exact (continuous_scalarP_center
      (mu := mu) (sig := sig) (n := n) (t := t) (u0 := u0) (u1 := u1)).intervalIntegrable a b
  · intro p hp
    exact scalarE_differentiableAt_center
      (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u0 := u0) (u1 := u1)
        hscale
  · exact (continuous_scalarEdot_center
      (mu := mu) (sig := sig) (n := n) (t := t) (u0 := u0) (u1 := u1) hmu ht).continuousOn

/-- Scale-uniform bracket domination for the Gaussian. -/
theorem gaussianAt_scale_bracket_domination :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (s v : ℝ), 1 ≤ s →
      |gaussianAt s 0 v| ≤ C * s ^ 9 * bracketKernel v := by
  apply kernelAt_scale_bracket_of_polynomial_decay gaussian
  rcases gaussian_polynomial_decay 10 with ⟨C, hC, h⟩
  refine ⟨C, hC, fun x ↦ ?_⟩
  simpa [abs_of_nonneg (gaussian_nonneg x)] using h x

/-- Scale-uniform bracket domination for the Gaussian derivative. -/
theorem gaussianDerivAt_scale_bracket_domination :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (s v : ℝ), 1 ≤ s →
      |gaussianDerivAt s 0 v| ≤ C * s ^ 9 * bracketKernel v :=
  kernelAt_scale_bracket_of_polynomial_decay gaussianDeriv (gaussianDeriv_polynomial_decay 10)

/-- The first pointwise estimate in `lem:domination`. -/
theorem gaussian_pair_scale_bracket_domination :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (s v : ℝ), 1 ≤ s →
      |gaussianAt s 0 v| + |gaussianDerivAt s 0 v| ≤
        C * s ^ 9 * bracketKernel v := by
  rcases gaussianAt_scale_bracket_domination with ⟨Cg, hCg, hg⟩
  rcases gaussianDerivAt_scale_bracket_domination with ⟨Ch, hCh, hh⟩
  refine ⟨Cg + Ch, add_nonneg hCg hCh, ?_⟩
  intro s v hs
  calc
    |gaussianAt s 0 v| + |gaussianDerivAt s 0 v| ≤
        Cg * s ^ 9 * bracketKernel v + Ch * s ^ 9 * bracketKernel v :=
      add_le_add (hg s v hs) (hh s v hs)
    _ = (Cg + Ch) * s ^ 9 * bracketKernel v := by ring

/-- Unit-scale translated Gaussian domination with the source weight `R(r)^10`. -/
theorem gaussianAt_translate_bracket_domination :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (r v : ℝ),
      |gaussianAt 1 r v| ≤ C * translationWeight r ^ 10 * bracketKernel v := by
  apply kernelAt_translate_bracket_of_polynomial_decay gaussian
  rcases gaussian_polynomial_decay 10 with ⟨C, hC, h⟩
  refine ⟨C, hC, fun x ↦ ?_⟩
  simpa [abs_of_nonneg (gaussian_nonneg x)] using h x

/-- Unit-scale translated derivative-Gaussian domination with `R(r)^10`. -/
theorem gaussianDerivAt_translate_bracket_domination :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (r v : ℝ),
      |gaussianDerivAt 1 r v| ≤ C * translationWeight r ^ 10 * bracketKernel v :=
  kernelAt_translate_bracket_of_polynomial_decay gaussianDeriv (gaussianDeriv_polynomial_decay 10)

/-- The second pointwise estimate in `lem:domination`. -/
theorem gaussian_pair_translate_bracket_domination :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (r v : ℝ),
      |gaussianAt 1 r v| + |gaussianDerivAt 1 r v| ≤
        C * translationWeight r ^ 10 * bracketKernel v := by
  rcases gaussianAt_translate_bracket_domination with ⟨Cg, hCg, hg⟩
  rcases gaussianDerivAt_translate_bracket_domination with ⟨Ch, hCh, hh⟩
  refine ⟨Cg + Ch, add_nonneg hCg hCh, ?_⟩
  intro r v
  calc
    |gaussianAt 1 r v| + |gaussianDerivAt 1 r v| ≤
        Cg * translationWeight r ^ 10 * bracketKernel v +
          Ch * translationWeight r ^ 10 * bracketKernel v :=
      add_le_add (hg r v) (hh r v)
    _ = (Cg + Ch) * translationWeight r ^ 10 * bracketKernel v := by ring

/-- The source volume formula `\(|Q|=2^{kA}\)`, recorded as a positive
grid mass before its Lebesgue-measure identification. -/
noncomputable def boxMass (α : Anisotropy) (q : AnisoBox α) : ℝ :=
  (2 : ℝ) ^ (q.level * (α.homogeneousDimension : ℤ))

theorem prod_boxSide_eq_boxMass (α : Anisotropy) (q : AnisoBox α) :
    (∏ i, boxSide α q i) = boxMass α q := by
  simp_rw [boxSide_eq_length_pow]
  rw [Finset.prod_pow_eq_pow_sum]
  simp only [boxMass, boxLength, Anisotropy.homogeneousDimension, ← zpow_natCast, zpow_mul]

theorem boxMass_pos (α : Anisotropy) (q : AnisoBox α) : 0 < boxMass α q := by
  exact zpow_pos (by norm_num) _

/-- Lebesgue volume of the literal half-open grid box, before collecting the
coordinate factors into the homogeneous-dimension expression. -/
theorem volume_boxSet (α : Anisotropy) (q : AnisoBox α) :
    volume (boxSet α q) = ∏ i, ENNReal.ofReal (boxSide α q i) := by
  let lo : Fin 3 → ℝ := fun i ↦ (q.index i : ℝ) * boxSide α q i
  let hi : Fin 3 → ℝ := fun i ↦ ((q.index i + 1 : ℤ) : ℝ) * boxSide α q i
  have hmeas : MeasurableSet (Set.pi Set.univ fun i ↦ Set.Ico (lo i) (hi i)) := by
    apply MeasurableSet.pi Set.countable_univ
    intro i _
    exact measurableSet_Ico
  change volume ((WithLp.ofLp : E3 → Fin 3 → ℝ) ⁻¹'
      Set.pi Set.univ (fun i ↦ Set.Ico (lo i) (hi i))) = _
  rw [(PiLp.volume_preserving_ofLp (Fin 3)).measure_preimage hmeas.nullMeasurableSet]
  rw [Real.volume_pi_Ico]
  congr with i
  congr 1
  dsimp [lo, hi]
  push_cast
  ring

theorem volume_boxSet_toReal (α : Anisotropy) (q : AnisoBox α) :
    (volume (boxSet α q)).toReal = boxMass α q := by
  rw [volume_boxSet, ENNReal.toReal_prod]
  have htoReal : ∀ i : Fin 3,
      (ENNReal.ofReal (boxSide α q i)).toReal = boxSide α q i :=
    fun i ↦ ENNReal.toReal_ofReal (boxSide_pos α q i).le
  simp_rw [htoReal]
  exact prod_boxSide_eq_boxMass α q

/-- The exact source normalization `|Q(k,n)| = 2^{kA}`. -/
theorem volume_boxSet_eq_boxMass (α : Anisotropy) (q : AnisoBox α) :
    volume (boxSet α q) = ENNReal.ofReal (boxMass α q) := by
  rw [volume_boxSet]
  rw [← ENNReal.ofReal_prod_of_nonneg]
  · rw [prod_boxSide_eq_boxMass]
  · intro i _
    exact (boxSide_pos α q i).le

theorem pairwiseDisjoint_boxSet_children (α : Anisotropy) (q : AnisoBox α) :
    (↑(boxChildren α q) : Set (AnisoBox α)).PairwiseDisjoint (boxSet α) := by
  intro r hr s hs hrs
  rcases Finset.mem_image.1 hr with ⟨v, hv, rfl⟩
  rcases Finset.mem_image.1 hs with ⟨w, hw, rfl⟩
  exact boxSet_disjoint_of_eq_level_of_ne α (by rfl) hrs

theorem measure_children_union (α : Anisotropy) (q : AnisoBox α) :
    volume (⋃ r ∈ boxChildren α q, boxSet α r) =
      ∑ r ∈ boxChildren α q, volume (boxSet α r) := by
  exact MeasureTheory.measure_biUnion_finset
    (pairwiseDisjoint_boxSet_children α q)
    (fun r hr ↦ measurableSet_boxSet α r)

/-- Passing to the parent multiplies the grid mass by the number of
anisotropic children. -/
theorem boxMass_parent (α : Anisotropy) (q : AnisoBox α) :
    boxMass α (boxParent α q) = (2 ^ α.homogeneousDimension : ℝ) * boxMass α q := by
  unfold boxMass boxParent
  have hexp : (q.level + 1) * (α.homogeneousDimension : ℤ) =
      (α.homogeneousDimension : ℤ) + q.level * (α.homogeneousDimension : ℤ) := by
    ring
  rw [hexp, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_natCast]

/-- Each child has the corresponding fraction of its parent's grid mass. -/
theorem boxMass_child_mul_card (α : Anisotropy) (q : AnisoBox α) (v : AnisoDigit α) :
    boxMass α (boxChild α q v) * (2 ^ α.homogeneousDimension : ℝ) = boxMass α q := by
  unfold boxMass boxChild
  have hexp : (q.level - 1) * (α.homogeneousDimension : ℤ) +
      (α.homogeneousDimension : ℤ) = q.level * (α.homogeneousDimension : ℤ) := by
    ring
  rw [← zpow_natCast, ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), hexp]

theorem boxLength_le_half_of_level_lt {α : Anisotropy} {q r : AnisoBox α}
    (hlevel : q.level < r.level) : boxLength q ≤ boxLength r / 2 := by
  unfold boxLength
  calc
    (2 : ℝ) ^ q.level ≤ (2 : ℝ) ^ (r.level - 1) :=
      zpow_le_zpow_right₀ (by norm_num) (by omega)
    _ = (2 : ℝ) ^ r.level / 2 := by
      rw [zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0)]
      norm_num

theorem measurableSet_boxScaleRegion (α : Anisotropy) (q : AnisoBox α) :
    MeasurableSet (boxScaleRegion α q) :=
  (measurableSet_boxSet α q).prod measurableSet_Ioc

theorem measurableSet_collectionRegion (α : Anisotropy) (S : BoxCollection α) :
    MeasurableSet (collectionRegion α S) :=
  Finset.measurableSet_biUnion S (fun q _ ↦ measurableSet_boxScaleRegion α q)

/-- Distinct box-scale cells are exactly disjoint, including across levels. -/
theorem boxScaleRegion_disjoint_of_ne (α : Anisotropy) {q r : AnisoBox α}
    (hne : q ≠ r) :
    Disjoint (boxScaleRegion α q) (boxScaleRegion α r) := by
  rcases lt_trichotomy q.level r.level with hlt | heq | hgt
  · apply Set.Disjoint.set_prod_right
    change Disjoint (Set.Ioc (boxLength q / 2) (boxLength q))
      (Set.Ioc (boxLength r / 2) (boxLength r))
    exact Set.Ioc_disjoint_Ioc_of_le (boxLength_le_half_of_level_lt hlt)
  · apply Set.Disjoint.set_prod_left
    exact boxSet_disjoint_of_eq_level_of_ne α heq hne
  · apply Set.Disjoint.set_prod_right
    change Disjoint (Set.Ioc (boxLength q / 2) (boxLength q))
      (Set.Ioc (boxLength r / 2) (boxLength r))
    exact (Set.Ioc_disjoint_Ioc_of_le (boxLength_le_half_of_level_lt hgt)).symm

theorem pairwiseDisjoint_boxScaleRegion (α : Anisotropy) (S : BoxCollection α) :
    (↑S : Set (AnisoBox α)).PairwiseDisjoint (boxScaleRegion α) := by
  intro q hq r hr hne
  exact boxScaleRegion_disjoint_of_ne α hne

theorem measure_collectionRegion (α : Anisotropy) (S : BoxCollection α) :
    volume (collectionRegion α S) = ∑ q ∈ S, volume (boxScaleRegion α q) := by
  exact MeasureTheory.measure_biUnion_finset
    (pairwiseDisjoint_boxScaleRegion α S)
    (fun q hq ↦ measurableSet_boxScaleRegion α q)

theorem boxMass_root_eq_sum_boxMass_leaves {α : Anisotropy} (T : FiniteConvexTree α) :
    boxMass α T.root = ∑ l ∈ treeLeaves T, boxMass α l := by
  rw [← volume_boxSet_toReal α T.root, volume_root_eq_sum_volume_leaves]
  rw [ENNReal.toReal_sum (fun l hl ↦ by
    rw [volume_boxSet_eq_boxMass]
    exact ENNReal.ofReal_ne_top)]
  congr with l
  exact volume_boxSet_toReal α l

/-- The same-level box adjacent across an oriented coordinate face. -/
def boxNeighbor (α : Anisotropy) (q : AnisoBox α) (i : Fin 3)
    (ε : FaceOrientation) : AnisoBox α :=
  ⟨q.level, fun j ↦ if j = i then q.index j + ε.sign else q.index j⟩

theorem boxNeighbor_neighbor_opposite (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) (ε : FaceOrientation) :
    boxNeighbor α (boxNeighbor α q i ε) i ε.opposite = q := by
  cases q with
  | mk level index =>
    rw [AnisoBox.mk.injEq]
    constructor
    · rfl
    · funext j
      by_cases hji : j = i
      · subst j
        cases ε <;> simp [boxNeighbor, FaceOrientation.sign, FaceOrientation.opposite]
      · simp [boxNeighbor, hji]

/-- Dividing two adjacent integer grid indices by a positive radix either
identifies them or leaves them adjacent. -/
theorem int_ediv_add_one_or (a R : ℤ) (hR : 0 < R) :
    (a + 1) / R = a / R ∨ (a + 1) / R = a / R + 1 := by
  have hRne : R ≠ 0 := ne_of_gt hR
  have hlow : a / R ≤ (a + 1) / R := by
    rw [Int.le_ediv_iff_mul_le hR]
    exact (Int.ediv_mul_le a hRne).trans (by omega)
  have hrem : a % R < R := Int.emod_lt_of_pos a hR
  have hdecomp : a % R + a / R * R = a := Int.emod_add_ediv_mul a R
  have hupp : (a + 1) / R ≤ a / R + 1 := by
    rw [Int.ediv_le_iff_le_mul hR]
    rw [show (a / R + 1) * R + R = a / R * R + 2 * R by ring]
    omega
  omega

theorem int_ediv_sub_one_or (a R : ℤ) (hR : 0 < R) :
    (a - 1) / R = a / R ∨ (a - 1) / R = a / R - 1 := by
  rcases int_ediv_add_one_or (a - 1) R hR with h | h
  · left
    simpa only [sub_add_cancel] using h.symm
  · right
    have h' : a / R = (a - 1) / R + 1 := by
      simpa only [sub_add_cancel] using h
    omega

/-- Parent boxes of two adjacent grid boxes either coincide or remain
adjacent.  This integer-dichotomy is the alignment mechanism in the finite
surviving-face packing proof. -/
theorem boxParent_neighbor_eq_or_neighbor (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) (ε : FaceOrientation) :
    boxParent α (boxNeighbor α q i ε) = boxParent α q ∨
      boxParent α (boxNeighbor α q i ε) =
        boxNeighbor α (boxParent α q) i ε := by
  cases q with
  | mk level index =>
    have hR (j : Fin 3) : (0 : ℤ) < (anisoRadix α j : ℤ) := by
      exact_mod_cast anisoRadix_pos α j
    cases ε with
    | lower =>
      rcases int_ediv_sub_one_or (index i) (anisoRadix α i : ℤ) (hR i) with h | h
      · left
        simp only [boxParent, boxNeighbor, AnisoBox.mk.injEq]
        constructor
        · trivial
        · funext j
          by_cases hji : j = i
          · subst j
            simpa [FaceOrientation.sign, sub_eq_add_neg] using h
          · simp [hji]
      · right
        simp only [boxParent, boxNeighbor, AnisoBox.mk.injEq]
        constructor
        · trivial
        · funext j
          by_cases hji : j = i
          · subst j
            simpa [FaceOrientation.sign, sub_eq_add_neg] using h
          · simp [hji]
    | upper =>
      rcases int_ediv_add_one_or (index i) (anisoRadix α i : ℤ) (hR i) with h | h
      · left
        simp only [boxParent, boxNeighbor, AnisoBox.mk.injEq]
        constructor
        · trivial
        · funext j
          by_cases hji : j = i
          · subst j
            simpa [FaceOrientation.sign] using h
          · simp [hji]
      · right
        simp only [boxParent, boxNeighbor, AnisoBox.mk.injEq]
        constructor
        · trivial
        · funext j
          by_cases hji : j = i
          · subst j
            simpa [FaceOrientation.sign] using h
          · simp [hji]

/-- The lower active endpoint of a literal box does not exceed its upper
endpoint. -/
theorem boxFaceCoordinate_lower_le_upper (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) :
    boxFaceCoordinate α q i FaceOrientation.lower ≤
      boxFaceCoordinate α q i FaceOrientation.upper := by
  unfold boxFaceCoordinate
  apply mul_le_mul_of_nonneg_right _ (boxSide_pos α q i).le
  have hindex : q.index i ≤ q.index i + 1 := by omega
  exact_mod_cast hindex

/-- A finite oriented face is encoded by its incident box and orientation. -/
structure OrientedFace (α : Anisotropy) where
  box : AnisoBox α
  orientation : FaceOrientation
  deriving DecidableEq

/-- The surviving oriented `i`-faces at one tree level. -/
def survivingFaces {α : Anisotropy} (T : FiniteConvexTree α)
    (i : Fin 3) (k : ℤ) : Finset (OrientedFace α) :=
  (((treeAtLevel T k).product Finset.univ).image fun qε ↦
    OrientedFace.mk qε.1 qε.2).filter fun S ↦
      boxNeighbor α S.box i S.orientation ∉ T.boxes

theorem boxNeighbor_level (α : Anisotropy) (q : AnisoBox α) (i : Fin 3)
    (ε : FaceOrientation) : (boxNeighbor α q i ε).level = q.level :=
  rfl

theorem boxNeighbor_index_self (α : Anisotropy) (q : AnisoBox α) (i : Fin 3)
    (ε : FaceOrientation) :
    (boxNeighbor α q i ε).index i = q.index i + ε.sign := by
  simp [boxNeighbor]

theorem boxNeighbor_index_ne (α : Anisotropy) (q : AnisoBox α) {i j : Fin 3}
    (hji : j ≠ i) (ε : FaceOrientation) :
    (boxNeighbor α q i ε).index j = q.index j := by
  simp [boxNeighbor, hji]

theorem boxSide_neighbor (α : Anisotropy) (q : AnisoBox α) (i j : Fin 3)
    (ε : FaceOrientation) :
    boxSide α (boxNeighbor α q i ε) j = boxSide α q j := by
  rfl

theorem boxFaceCoordinate_neighbor_opposite (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) (ε : FaceOrientation) :
    boxFaceCoordinate α q i ε =
      boxFaceCoordinate α (boxNeighbor α q i ε) i ε.opposite := by
  cases ε <;> simp [boxFaceCoordinate, FaceOrientation.opposite,
    FaceOrientation.sign, boxNeighbor, boxSide]

/-- In the non-coalescing case of the parent-neighbor dichotomy, the common
normal coordinate is already a face coordinate of the parent. -/
theorem boxFaceCoordinate_eq_parent_of_parent_neighbor
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) (ε : FaceOrientation)
    (h : boxParent α (boxNeighbor α q i ε) =
      boxNeighbor α (boxParent α q) i ε) :
    boxFaceCoordinate α q i ε = boxFaceCoordinate α (boxParent α q) i ε := by
  let R : ℤ := anisoRadix α i
  have hR : (0 : ℤ) < R := by
    dsimp [R]
    exact_mod_cast anisoRadix_pos α i
  have hRne : R ≠ 0 := ne_of_gt hR
  have hi := congrFun (congrArg AnisoBox.index h) i
  cases ε with
  | lower =>
    have hquot : (q.index i - 1) / R = q.index i / R - 1 := by
      simpa [boxParent, boxNeighbor, FaceOrientation.sign, sub_eq_add_neg, R] using hi
    have hlt : q.index i - 1 < q.index i / R * R := by
      have hle : (q.index i - 1) / R ≤ q.index i / R - 1 := by rw [hquot]
      have h' := (Int.ediv_le_iff_le_mul hR).mp hle
      calc
        q.index i - 1 < (q.index i / R - 1) * R + R := h'
        _ = q.index i / R * R := by ring
    have hle : q.index i / R * R ≤ q.index i := Int.ediv_mul_le _ hRne
    have hidx : q.index i = q.index i / R * R := by omega
    have hidxR : (q.index i : ℝ) =
        ((q.index i / R : ℤ) : ℝ) * (R : ℝ) := by exact_mod_cast hidx
    change (q.index i : ℝ) * boxSide α q i =
      (((boxParent α q).index i : ℤ) : ℝ) * boxSide α (boxParent α q) i
    change (q.index i : ℝ) * boxSide α q i =
      ((q.index i / R : ℤ) : ℝ) * boxSide α (boxParent α q) i
    dsimp [R] at hidxR ⊢
    rw [boxSide_parent, hidxR]
    push_cast
    ring
  | upper =>
    have hquot : (q.index i + 1) / R = q.index i / R + 1 := by
      simpa [boxParent, boxNeighbor, FaceOrientation.sign, R] using hi
    have hlow : (q.index i / R + 1) * R ≤ q.index i + 1 := by
      rw [← hquot]
      exact (Int.le_ediv_iff_mul_le hR).mp le_rfl
    have hrem : q.index i % R < R := Int.emod_lt_of_pos _ hR
    have hremnonneg : 0 ≤ q.index i % R := Int.emod_nonneg _ hRne
    have hdecomp : q.index i % R + q.index i / R * R = q.index i :=
      Int.emod_add_ediv_mul _ _
    have hupp : q.index i + 1 ≤ (q.index i / R + 1) * R := by
      rw [show (q.index i / R + 1) * R = q.index i / R * R + R by ring]
      omega
    have hidx : q.index i + 1 = (q.index i / R + 1) * R := by omega
    have hidxR : ((q.index i + 1 : ℤ) : ℝ) =
        ((q.index i / R + 1 : ℤ) : ℝ) * (R : ℝ) := by exact_mod_cast hidx
    change ((q.index i + 1 : ℤ) : ℝ) * boxSide α q i =
      (((boxParent α q).index i + 1 : ℤ) : ℝ) * boxSide α (boxParent α q) i
    change ((q.index i + 1 : ℤ) : ℝ) * boxSide α q i =
      ((q.index i / R + 1 : ℤ) : ℝ) * boxSide α (boxParent α q) i
    dsimp [R] at hidxR ⊢
    rw [boxSide_parent, hidxR]
    push_cast
    ring

/-- A coordinate interval is contained in the corresponding parent interval.
This remains true for negative grid indices because parents use Euclidean
division. -/
theorem boxClosedInterval_subset_parent (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) :
    boxClosedInterval α q i ⊆ boxClosedInterval α (boxParent α q) i := by
  unfold boxClosedInterval
  rw [boxSide_parent]
  simp only [boxParent]
  have hlt : (q.index i : ℝ) < ((q.index i + 1 : ℤ) : ℝ) := by
    have hltZ : q.index i < q.index i + 1 := by omega
    exact_mod_cast hltZ
  have hnonempty : (q.index i : ℝ) * boxSide α q i <
      ((q.index i + 1 : ℤ) : ℝ) * boxSide α q i :=
    mul_lt_mul_of_pos_right hlt (boxSide_pos α q i)
  apply (Set.Icc_subset_Icc_iff hnonempty.le).2
  constructor
  · let R : ℤ := anisoRadix α i
    have hRne : R ≠ 0 := by
      dsimp [R]
      exact_mod_cast (Nat.ne_of_gt (anisoRadix_pos α i))
    have hlowZ : (q.index i / R) * R ≤ q.index i := Int.ediv_mul_le _ hRne
    have hlow : ((q.index i / R : ℤ) : ℝ) * (R : ℝ) ≤ q.index i := by
      exact_mod_cast hlowZ
    change ((q.index i / R : ℤ) : ℝ) * ((R : ℝ) * boxSide α q i) ≤
      (q.index i : ℝ) * boxSide α q i
    rw [← mul_assoc]
    exact mul_le_mul_of_nonneg_right hlow (boxSide_pos α q i).le
  · let R : ℤ := anisoRadix α i
    have hRpos : 0 < R := by
      dsimp [R]
      exact_mod_cast anisoRadix_pos α i
    have hrem : q.index i % R < R := Int.emod_lt_of_pos _ hRpos
    have hdecomp : q.index i % R + R * (q.index i / R) = q.index i :=
      Int.emod_add_mul_ediv _ _
    have huZ : q.index i + 1 ≤ (q.index i / R + 1) * R := by
      calc
        q.index i + 1 = q.index i % R + R * (q.index i / R) + 1 := by rw [hdecomp]
        _ ≤ R * (q.index i / R) + R := by linarith
        _ = (q.index i / R + 1) * R := by ring
    have hu : ((q.index i + 1 : ℤ) : ℝ) ≤
        ((q.index i / R + 1 : ℤ) : ℝ) * (R : ℝ) := by exact_mod_cast huZ
    change ((q.index i + 1 : ℤ) : ℝ) * boxSide α q i ≤
      ((q.index i / R + 1 : ℤ) : ℝ) * ((R : ℝ) * boxSide α q i)
    rw [← mul_assoc]
    exact mul_le_mul_of_nonneg_right hu (boxSide_pos α q i).le

/-- A surviving face whose neighbor remains a neighbor after coarsening is
contained in the corresponding parent face. -/
theorem boxFaceSet_subset_parent_of_parent_neighbor
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) (ε : FaceOrientation)
    (h : boxParent α (boxNeighbor α q i ε) =
      boxNeighbor α (boxParent α q) i ε) :
    boxFaceSet α q i ε ⊆ boxFaceSet α (boxParent α q) i ε := by
  intro p hp
  rcases hp with ⟨hpcoord, hptrans⟩
  refine ⟨?_, ?_⟩
  · rw [← boxFaceCoordinate_eq_parent_of_parent_neighbor α q i ε h]
    exact hpcoord
  · intro j hji
    have hj := boxClosedInterval_subset_parent α q j (hptrans j hji)
    simpa [boxClosedInterval] using hj

theorem boxInterval_neighbor_eq_of_ne (α : Anisotropy) (q : AnisoBox α)
    {i j : Fin 3} (hji : j ≠ i) (ε : FaceOrientation) :
    boxInterval α (boxNeighbor α q i ε) j = boxInterval α q j := by
  unfold boxInterval
  rw [boxNeighbor_index_ne α q hji ε, boxSide_neighbor]

theorem boxFaceArea_mul_boxSide (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    boxFaceArea α q i * boxSide α q i = boxMass α q := by
  unfold boxFaceArea
  rw [Finset.prod_erase_mul]
  · exact prod_boxSide_eq_boxMass α q
  · simp

/-- The source face-area exponent `k(A-α_i)`. -/
theorem boxFaceArea_eq_source (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    boxFaceArea α q i =
      (2 : ℝ) ^ (q.level * ((α.homogeneousDimension - α.weight i : ℕ) : ℤ)) := by
  have hweight : α.weight i ≤ α.homogeneousDimension :=
    Finset.single_le_sum (fun j _ ↦ Nat.zero_le _) (Finset.mem_univ i)
  have hsumNat : α.homogeneousDimension - α.weight i + α.weight i =
      α.homogeneousDimension := Nat.sub_add_cancel hweight
  have hsumInt :
      ((α.homogeneousDimension - α.weight i : ℕ) : ℤ) + (α.weight i : ℤ) =
        (α.homogeneousDimension : ℤ) := by
    exact_mod_cast hsumNat
  apply mul_right_cancel₀ (boxSide_pos α q i).ne'
  rw [boxFaceArea_mul_boxSide]
  unfold boxSide boxMass
  rw [← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
  congr 1
  rw [← mul_add, hsumInt]

/-- The literal two-coordinate Euclidean space transverse to `i`. -/
abbrev TransverseSpace (i : Fin 3) := EuclideanSpace ℝ {j : Fin 3 // j ≠ i}

/-- The half-open transverse rectangle `R_S`, now in its actual coordinate
plane rather than as an ambient three-dimensional set. -/
noncomputable def transverseRectangle (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) : Set (TransverseSpace i) :=
  Set.preimage (WithLp.ofLp : TransverseSpace i → {j : Fin 3 // j ≠ i} → ℝ)
    (Set.pi Set.univ fun j ↦ boxInterval α q j.1)

/-- Coordinate two-dimensional area of a transverse rectangle. -/
noncomputable def transverseArea (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) : ℝ :=
  ∏ j : {m : Fin 3 // m ≠ i}, boxSide α q j.1

/-- Insert a transverse point into the affine coordinate plane whose
`i`-th coordinate is `c`. -/
noncomputable def faceInsert (i : Fin 3) (c : ℝ) : TransverseSpace i → E3 :=
  fun y ↦ WithLp.toLp 2 fun j ↦ if h : j = i then c else y ⟨j, h⟩

@[simp]
theorem faceInsert_apply (i : Fin 3) (c : ℝ) (y : TransverseSpace i)
    (j : Fin 3) :
    faceInsert i c y j = if h : j = i then c else y ⟨j, h⟩ := by
  simp [faceInsert]

theorem faceInsert_injective (i : Fin 3) (c : ℝ) :
    Function.Injective (faceInsert i c) := by
  intro y z hyz
  ext j
  have hj := congrArg (fun w : E3 ↦ w j.1) hyz
  simpa [faceInsert, j.2] using hj

theorem faceInsert_continuous (i : Fin 3) (c : ℝ) :
    Continuous (faceInsert i c) := by
  apply (PiLp.continuous_toLp 2 _).comp
  rw [continuous_pi_iff]
  intro j
  by_cases hji : j = i
  · simpa [faceInsert, hji] using
      (continuous_const : Continuous fun _ : TransverseSpace i ↦ c)
  · simpa [faceInsert, hji] using
      (PiLp.continuous_apply (p := 2)
        (β := fun _ : {m : Fin 3 // m ≠ i} ↦ ℝ) ⟨j, hji⟩)

theorem faceInsert_measurableEmbedding (i : Fin 3) (c : ℝ) :
    MeasurableEmbedding (faceInsert i c) :=
  (faceInsert_continuous i c).measurableEmbedding (faceInsert_injective i c)

/-- Coordinate two-dimensional Lebesgue measure on the affine `i`-face at
height `c`, realized as a pushforward. -/
noncomputable def faceCoordinateMeasure (i : Fin 3) (c : ℝ) : Measure E3 :=
  Measure.map (faceInsert i c) volume

theorem measurableSet_transverseRectangle (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) : MeasurableSet (transverseRectangle α q i) := by
  unfold transverseRectangle
  apply (PiLp.volume_preserving_ofLp {j : Fin 3 // j ≠ i}).measurable
  apply MeasurableSet.pi Set.countable_univ
  intro j _
  exact measurableSet_Ico

/-- The ordered two-element index set obtained by deleting the active
coordinate.  It is used only to transport the standard finite-product
Lebesgue measure to the literal transverse coordinate type. -/
def transverseIndexEquiv (i : Fin 3) : Fin 2 ≃ {j : Fin 3 // j ≠ i} :=
  Equiv.ofBijective (fun k ↦ ⟨i.succAbove k, Fin.succAbove_ne i k⟩) ⟨
    (fun k l h ↦ i.succAbove_right_injective (congrArg Subtype.val h)), by
      intro j
      rcases Fin.exists_succAbove_eq j.2 with ⟨k, hk⟩
      exact ⟨k, Subtype.ext hk⟩⟩

/-- Split an ambient point into its active real coordinate and its literal
two-dimensional transverse point. -/
noncomputable def coordinateSplit (i : Fin 3) : E3 → ℝ × TransverseSpace i :=
  fun p ↦ (p i, WithLp.toLp 2 fun j ↦ p j.1)

/-- Reassemble active and transverse coordinates into an ambient point. -/
noncomputable def coordinateJoin (i : Fin 3) : ℝ × TransverseSpace i → E3 :=
  fun z ↦ faceInsert i z.1 z.2

@[simp]
theorem coordinateJoin_split (i : Fin 3) (p : E3) :
    coordinateJoin i (coordinateSplit i p) = p := by
  ext j
  by_cases hji : j = i
  · subst j
    simp [coordinateJoin, coordinateSplit, faceInsert]
  · simp [coordinateJoin, coordinateSplit, faceInsert, hji]

@[simp]
theorem coordinateSplit_join (i : Fin 3) (z : ℝ × TransverseSpace i) :
    coordinateSplit i (coordinateJoin i z) = z := by
  apply Prod.ext
  · simp [coordinateJoin, coordinateSplit, faceInsert]
  · ext j
    simp [coordinateJoin, coordinateSplit, faceInsert, j.2]

@[simp]
theorem coordinateSplit_faceInsert (i : Fin 3) (u : ℝ)
    (y : TransverseSpace i) :
    coordinateSplit i (faceInsert i u y) = (u, y) := by
  change coordinateSplit i (coordinateJoin i (u, y)) = (u, y)
  exact coordinateSplit_join i (u, y)

theorem coordinateSplit_mem_box_product_iff
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) (p : E3) :
    coordinateSplit i p ∈
      boxInterval α q i ×ˢ transverseRectangle α q i ↔ p ∈ boxSet α q := by
  constructor
  · rintro ⟨hp, hy⟩
    rw [boxSet, Set.mem_preimage, Set.mem_pi]
    intro j _
    by_cases hji : j = i
    · subst j
      exact hp
    · rw [transverseRectangle, Set.mem_preimage, Set.mem_pi] at hy
      simpa [coordinateSplit] using hy ⟨j, hji⟩ (Set.mem_univ _)
  · intro hp
    rw [boxSet, Set.mem_preimage, Set.mem_pi] at hp
    constructor
    · exact hp i (Set.mem_univ _)
    · rw [transverseRectangle, Set.mem_preimage, Set.mem_pi]
      intro j _
      simpa [coordinateSplit] using hp j.1 (Set.mem_univ _)

theorem coordinateSplit_preimage_box_product
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    coordinateSplit i ⁻¹'
      (boxInterval α q i ×ˢ transverseRectangle α q i) = boxSet α q := by
  ext p
  exact coordinateSplit_mem_box_product_iff α q i p

private noncomputable def coordinateSplitAux (i : Fin 3) :
    E3 → ℝ × TransverseSpace i :=
  fun p ↦
    let z := MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 ↦ ℝ) i (WithLp.ofLp p)
    (z.1, WithLp.toLp 2
      (MeasurableEquiv.piCongrLeft (fun _ : {j : Fin 3 // j ≠ i} ↦ ℝ)
        (transverseIndexEquiv i) z.2))

private theorem coordinateSplitAux_eq (i : Fin 3) :
    coordinateSplitAux i = coordinateSplit i := by
  funext p
  apply Prod.ext
  · change ((Fin.insertNthEquiv (fun _ : Fin 3 ↦ ℝ) i).symm (WithLp.ofLp p)).1 = p i
    rfl
  · ext j
    let e := transverseIndexEquiv i
    have he : i.succAbove (e.symm j) = j.1 := by
      change (e (e.symm j)).1 = j.1
      exact congrArg Subtype.val (e.apply_symm_apply j)
    change (e.piCongrLeft (fun _ : {j : Fin 3 // j ≠ i} ↦ ℝ)
      ((Fin.insertNthEquiv (fun _ : Fin 3 ↦ ℝ) i).symm (WithLp.ofLp p)).2) j = p j.1
    rw [Equiv.piCongrLeft_apply]
    have hz : ((Fin.insertNthEquiv (fun _ : Fin 3 ↦ ℝ) i).symm
        (WithLp.ofLp p)).2 (e.symm j) = p (i.succAbove (e.symm j)) := rfl
    simpa [he] using hz

/-- The coordinate split preserves Lebesgue measure.  The proof is the
standard finite-product decomposition, with the final reindexing expressed
through `transverseIndexEquiv`. -/
theorem coordinateSplit_measurePreserving (i : Fin 3) :
    MeasurePreserving (coordinateSplit i) volume volume := by
  have h0 : MeasurePreserving (WithLp.ofLp : E3 → Fin 3 → ℝ) volume volume :=
    PiLp.volume_preserving_ofLp (Fin 3)
  have h1 : MeasurePreserving
      (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 ↦ ℝ) i) volume volume :=
    volume_preserving_piFinSuccAbove (fun _ : Fin 3 ↦ ℝ) i
  have hreindex : MeasurePreserving
      (MeasurableEquiv.piCongrLeft (fun _ : {j : Fin 3 // j ≠ i} ↦ ℝ)
        (transverseIndexEquiv i)) volume volume :=
    volume_measurePreserving_piCongrLeft (fun _ : {j : Fin 3 // j ≠ i} ↦ ℝ)
      (transverseIndexEquiv i)
  have hright : MeasurePreserving
      (WithLp.toLp 2 : ({j : Fin 3 // j ≠ i} → ℝ) → TransverseSpace i)
      volume volume :=
    PiLp.volume_preserving_toLp {j : Fin 3 // j ≠ i}
  have hid : MeasurePreserving (id : ℝ → ℝ) volume volume :=
    MeasurePreserving.id volume
  have h2 := hid.prod hreindex
  have h3 := hid.prod hright
  have h := h3.comp (h2.comp (h1.comp h0))
  rw [Measure.volume_eq_prod]
  convert h using 1
  · rfl
  · exact (coordinateSplitAux_eq i).symm

theorem coordinateJoin_continuous (i : Fin 3) :
    Continuous (coordinateJoin i) := by
  apply (PiLp.continuous_toLp 2 _).comp
  rw [continuous_pi_iff]
  intro j
  by_cases hji : j = i
  · subst j
    simpa [coordinateJoin, faceInsert] using
      (continuous_fst : Continuous fun z : ℝ × TransverseSpace i ↦ z.1)
  · have hcont := (PiLp.continuous_apply (p := 2)
        (β := fun _ : {m : Fin 3 // m ≠ i} ↦ ℝ) ⟨j, hji⟩).comp
          (continuous_snd : Continuous fun z : ℝ × TransverseSpace i ↦ z.2)
    convert hcont using 1
    funext z
    simp [hji]

/-- The measure-preserving measurable equivalence used to apply Fubini in
one box coordinate. -/
noncomputable def coordinateSplitEquiv (i : Fin 3) :
    E3 ≃ᵐ ℝ × TransverseSpace i where
  toEquiv :=
    { toFun := coordinateSplit i
      invFun := coordinateJoin i
      left_inv := coordinateJoin_split i
      right_inv := coordinateSplit_join i }
  measurable_toFun := (coordinateSplit_measurePreserving i).measurable
  measurable_invFun := (coordinateJoin_continuous i).measurable

@[simp]
theorem coordinateSplitEquiv_apply (i : Fin 3) (p : E3) :
    coordinateSplitEquiv i p = coordinateSplit i p := rfl

@[simp]
theorem coordinateSplitEquiv_symm_apply
    (i : Fin 3) (z : ℝ × TransverseSpace i) :
    (coordinateSplitEquiv i).symm z = coordinateJoin i z := rfl

theorem coordinateSplitEquiv_measurePreserving (i : Fin 3) :
    MeasurePreserving (coordinateSplitEquiv i) volume volume :=
  coordinateSplit_measurePreserving i

theorem measurableSet_coordinateBoxProduct
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    MeasurableSet (boxInterval α q i ×ˢ transverseRectangle α q i) := by
  apply MeasurableSet.prod
  · exact measurableSet_Ico
  · exact measurableSet_transverseRectangle α q i

/-- Exact Fubini transport of a box integral into its active and transverse
coordinates. -/
theorem integral_boxSet_coordinateSplit
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) (f : E3 → ℝ) :
    ∫ p in boxSet α q, f p =
      ∫ z in boxInterval α q i ×ˢ transverseRectangle α q i,
        f ((coordinateSplitEquiv i).symm z) := by
  let A : Set (ℝ × TransverseSpace i) :=
    boxInterval α q i ×ˢ transverseRectangle α q i
  let g : ℝ × TransverseSpace i → ℝ :=
    A.indicator (fun z ↦ f ((coordinateSplitEquiv i).symm z))
  have hA : MeasurableSet A := by
    exact measurableSet_coordinateBoxProduct α q i
  have hfactor (p : E3) : coordinateSplitEquiv i p ∈ A ↔ p ∈ boxSet α q := by
    simpa [A] using coordinateSplit_mem_box_product_iff α q i p
  calc
    ∫ p in boxSet α q, f p = ∫ p, (boxSet α q).indicator f p :=
      (integral_indicator (measurableSet_boxSet α q)).symm
    _ = ∫ p, g (coordinateSplitEquiv i p) := by
      apply integral_congr_ae
      filter_upwards [] with p
      dsimp [g]
      by_cases hp : p ∈ boxSet α q
      · have hpA : coordinateSplit i p ∈ A := by
          simpa using (hfactor p).mpr hp
        rw [Set.indicator_of_mem hp, Set.indicator_of_mem hpA]
        simp
      · have hpA : coordinateSplit i p ∉ A := by
          intro h
          apply hp
          exact (hfactor p).mp (by simpa using h)
        rw [Set.indicator_of_notMem hp, Set.indicator_of_notMem hpA]
    _ = ∫ z, g z :=
      (coordinateSplitEquiv_measurePreserving i).integral_comp' g
    _ = ∫ z in boxInterval α q i ×ˢ transverseRectangle α q i,
        f ((coordinateSplitEquiv i).symm z) := by
      exact integral_indicator hA

/-- Fubini's formula in literal active/transverse coordinates on one box.
The integrability hypothesis is exactly the source local-integrability
requirement; no null-boundary convention is hidden in this statement. -/
theorem integral_boxSet_eq_integral_transverse_interval
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) (f : E3 → ℝ)
    (hf : IntegrableOn f (boxSet α q)) :
    ∫ p in boxSet α q, f p =
      ∫ y in transverseRectangle α q i,
        ∫ u in boxInterval α q i, f (faceInsert i u y) := by
  let A : Set (ℝ × TransverseSpace i) :=
    boxInterval α q i ×ˢ transverseRectangle α q i
  let g : ℝ × TransverseSpace i → ℝ :=
    fun z ↦ f ((coordinateSplitEquiv i).symm z)
  have htransport : IntegrableOn g A := by
    apply (coordinateSplitEquiv_measurePreserving i).integrableOn_comp_preimage
      (coordinateSplitEquiv i).measurableEmbedding |>.mp
    have hcomp : g ∘ coordinateSplitEquiv i = f := by
      funext p
      simp [g]
    have hpre : (coordinateSplitEquiv i) ⁻¹' A = boxSet α q := by
      ext p
      change coordinateSplit i p ∈
        boxInterval α q i ×ˢ transverseRectangle α q i ↔ p ∈ boxSet α q
      exact coordinateSplit_mem_box_product_iff α q i p
    rw [hcomp, hpre]
    exact hf
  have htransport' : IntegrableOn g A
      ((volume : Measure ℝ).prod (volume : Measure (TransverseSpace i))) := by
    simpa only [Measure.volume_eq_prod] using htransport
  have hfirst :
      (∫ z in A, g z ∂((volume : Measure ℝ).prod
        (volume : Measure (TransverseSpace i)))) =
        ∫ u in boxInterval α q i,
          ∫ y in transverseRectangle α q i, g (u, y) :=
    MeasureTheory.setIntegral_prod g htransport'
  have hswap : Integrable g
      ((volume.restrict (boxInterval α q i)).prod
        (volume.restrict (transverseRectangle α q i))) := by
    simpa only [IntegrableOn, A, ← Measure.prod_restrict] using htransport'
  have hswap' : Integrable (Function.uncurry fun u y ↦ g (u, y))
      ((volume.restrict (boxInterval α q i)).prod
        (volume.restrict (transverseRectangle α q i))) := by
    refine Integrable.congr hswap (Filter.Eventually.of_forall ?_)
    rintro ⟨u, y⟩
    rfl
  calc
    ∫ p in boxSet α q, f p = ∫ z in A, g z := by
      simpa only [A, g] using integral_boxSet_coordinateSplit α q i f
    _ = ∫ u in boxInterval α q i,
          ∫ y in transverseRectangle α q i, g (u, y) := by
      rw [Measure.volume_eq_prod]
      exact hfirst
    _ = ∫ y in transverseRectangle α q i,
          ∫ u in boxInterval α q i, g (u, y) :=
      MeasureTheory.integral_integral_swap hswap'
    _ = _ := by
      simp only [g, coordinateSplitEquiv_symm_apply, coordinateJoin]

/-- The Fubini section of an integrable box function is integrable on the
transverse rectangle.  This is the hypothesis needed when the one-dimensional
telescoping identity is integrated across the inactive coordinates. -/
theorem integrable_outer_integral_boxInterval_of_integrableOn
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) (f : E3 → ℝ)
    (hf : IntegrableOn f (boxSet α q)) :
    Integrable (fun y : TransverseSpace i ↦
      ∫ u in boxInterval α q i, f (faceInsert i u y))
      (volume.restrict (transverseRectangle α q i)) := by
  let A : Set (ℝ × TransverseSpace i) :=
    boxInterval α q i ×ˢ transverseRectangle α q i
  let g : ℝ × TransverseSpace i → ℝ :=
    fun z ↦ f ((coordinateSplitEquiv i).symm z)
  have htransport : IntegrableOn g A := by
    apply (coordinateSplitEquiv_measurePreserving i).integrableOn_comp_preimage
      (coordinateSplitEquiv i).measurableEmbedding |>.mp
    have hcomp : g ∘ coordinateSplitEquiv i = f := by
      funext p
      simp [g]
    have hpre : (coordinateSplitEquiv i) ⁻¹' A = boxSet α q := by
      ext p
      change coordinateSplit i p ∈
        boxInterval α q i ×ˢ transverseRectangle α q i ↔ p ∈ boxSet α q
      exact coordinateSplit_mem_box_product_iff α q i p
    rw [hcomp, hpre]
    exact hf
  have htransport' : IntegrableOn g A
      ((volume : Measure ℝ).prod (volume : Measure (TransverseSpace i))) := by
    simpa only [Measure.volume_eq_prod] using htransport
  have hswap : Integrable g
      ((volume.restrict (boxInterval α q i)).prod
        (volume.restrict (transverseRectangle α q i))) := by
    simpa only [IntegrableOn, A, ← Measure.prod_restrict] using htransport'
  have hswap' : Integrable (Function.uncurry fun u y ↦ g (u, y))
      ((volume.restrict (boxInterval α q i)).prod
        (volume.restrict (transverseRectangle α q i))) := by
    refine Integrable.congr hswap (Filter.Eventually.of_forall ?_)
    rintro ⟨u, y⟩
    rfl
  convert hswap'.integral_prod_right using 1
  funext y
  congr 1

theorem volume_transverseRectangle (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) :
    volume (transverseRectangle α q i) =
      ∏ j : {m : Fin 3 // m ≠ i}, ENNReal.ofReal (boxSide α q j.1) := by
  let lo : {j : Fin 3 // j ≠ i} → ℝ := fun j ↦
    (q.index j.1 : ℝ) * boxSide α q j.1
  let hi : {j : Fin 3 // j ≠ i} → ℝ := fun j ↦
    ((q.index j.1 + 1 : ℤ) : ℝ) * boxSide α q j.1
  have hmeas : MeasurableSet (Set.pi Set.univ fun j ↦ Set.Ico (lo j) (hi j)) := by
    apply MeasurableSet.pi Set.countable_univ
    intro j _
    exact measurableSet_Ico
  change volume ((WithLp.ofLp : TransverseSpace i → {j : Fin 3 // j ≠ i} → ℝ) ⁻¹'
      Set.pi Set.univ (fun j ↦ Set.Ico (lo j) (hi j))) = _
  rw [(PiLp.volume_preserving_ofLp {j : Fin 3 // j ≠ i}).measure_preimage
    hmeas.nullMeasurableSet]
  rw [Real.volume_pi_Ico]
  congr with j
  congr 1
  dsimp [lo, hi]
  push_cast
  ring

theorem volume_transverseRectangle_toReal (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) :
    (volume (transverseRectangle α q i)).toReal = transverseArea α q i := by
  rw [volume_transverseRectangle, ENNReal.toReal_prod]
  simp_rw [ENNReal.toReal_ofReal (boxSide_pos α q _).le]
  rfl

/-- The pushed-forward face measure gives the half-open transverse rectangle
exactly its coordinate area.  This is the measure convention stipulated in
`def:faces`, not ambient three-dimensional volume. -/
theorem faceCoordinateMeasure_transverseRectangle (α : Anisotropy)
    (q : AnisoBox α) (i : Fin 3) (c : ℝ) :
    faceCoordinateMeasure i c (faceInsert i c '' transverseRectangle α q i) =
      volume (transverseRectangle α q i) := by
  unfold faceCoordinateMeasure
  rw [Measure.map_apply (faceInsert_measurableEmbedding i c).measurable
    ((faceInsert_measurableEmbedding i c).measurableSet_image.mpr
      (measurableSet_transverseRectangle α q i))]
  rw [Set.preimage_image_eq _ (faceInsert_injective i c)]

theorem faceCoordinateMeasure_transverseArea (α : Anisotropy)
    (q : AnisoBox α) (i : Fin 3) (c : ℝ) :
    (faceCoordinateMeasure i c
      (faceInsert i c '' transverseRectangle α q i)).toReal =
        transverseArea α q i := by
  rw [faceCoordinateMeasure_transverseRectangle]
  exact volume_transverseRectangle_toReal α q i

/-- The half-open coordinate rectangle is contained in the source's closed
ambient face.  Thus the pushforward measure above realizes precisely the
face integral convention while the closed face remains available for boundary
containment statements. -/
theorem faceInsert_transverseRectangle_subset_boxFaceSet (α : Anisotropy)
    (q : AnisoBox α) (i : Fin 3) (ε : FaceOrientation) :
    faceInsert i (boxFaceCoordinate α q i ε) '' transverseRectangle α q i ⊆
      boxFaceSet α q i ε := by
  intro x hx
  rcases hx with ⟨y, hy, rfl⟩
  rw [boxFaceSet]
  constructor
  · simp [faceInsert]
  · intro j hji
    rw [transverseRectangle, Set.mem_preimage, Set.mem_pi] at hy
    have hyj := hy ⟨j, hji⟩ (Set.mem_univ _)
    rw [boxInterval] at hyj
    simp only [faceInsert_apply, dif_neg hji]
    exact ⟨hyj.1, le_of_lt hyj.2⟩

def transverseDimension (α : Anisotropy) (i : Fin 3) : ℤ :=
  (α.homogeneousDimension : ℤ) - (α.weight i : ℤ)

theorem transverseArea_eq_zpow (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    transverseArea α q i = (2 : ℝ) ^ (q.level * transverseDimension α i) := by
  apply mul_right_cancel₀ (ne_of_gt (boxSide_pos α q i))
  unfold transverseArea
  rw [← Finset.prod_subtype (Finset.univ.erase i) (by simp)
    (fun j : Fin 3 ↦ boxSide α q j)]
  rw [Finset.prod_erase_mul Finset.univ (fun j : Fin 3 ↦ boxSide α q j)
    (Finset.mem_univ i)]
  rw [prod_boxSide_eq_boxMass]
  unfold boxMass boxSide transverseDimension
  rw [← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
  congr 1
  ring

theorem mem_survivingFaces_iff {α : Anisotropy} (T : FiniteConvexTree α)
    (i : Fin 3) (k : ℤ) (S : OrientedFace α) :
    S ∈ survivingFaces T i k ↔ S.box ∈ treeAtLevel T k ∧
      boxNeighbor α S.box i S.orientation ∉ T.boxes := by
  constructor
  · intro h
    unfold survivingFaces at h
    rcases Finset.mem_filter.mp h with ⟨himage, hneighbor⟩
    rcases Finset.mem_image.mp himage with ⟨qε, hqε, hEq⟩
    rcases qε with ⟨q, ε⟩
    cases hEq
    exact ⟨by simpa using hqε, hneighbor⟩
  · rintro ⟨hbox, hneighbor⟩
    unfold survivingFaces
    apply Finset.mem_filter.mpr
    refine ⟨Finset.mem_image.mpr ?_, hneighbor⟩
    refine ⟨(S.box, S.orientation), ?_, ?_⟩
    · simpa using hbox
    · cases S
      rfl

/-- Both orientations incident to one literal grid box. -/
def orientedFacesOfBox {α : Anisotropy} (q : AnisoBox α) :
    Finset (OrientedFace α) :=
  Finset.univ.image fun ε ↦ ⟨q, ε⟩

theorem mem_orientedFacesOfBox_iff {α : Anisotropy} (q : AnisoBox α)
    (S : OrientedFace α) :
    S ∈ orientedFacesOfBox q ↔ S.box = q := by
  constructor
  · intro h
    change S ∈ Finset.univ.image (fun ε ↦ OrientedFace.mk q ε) at h
    rcases Finset.mem_image.mp h with ⟨ε, hε, hEq⟩
    simp [← hEq]
  · intro hS
    refine Finset.mem_image.mpr ⟨S.orientation, Finset.mem_univ _, ?_⟩
    cases S
    simp_all

/-- The other incident oriented record for the same geometric grid face. -/
def oppositeOrientedFace (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) : OrientedFace α :=
  ⟨boxNeighbor α S.box i S.orientation, S.orientation.opposite⟩

@[simp]
theorem oppositeOrientedFace_orientation (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) : (oppositeOrientedFace α i S).orientation = S.orientation.opposite :=
  rfl

@[simp]
theorem oppositeOrientedFace_box (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) : (oppositeOrientedFace α i S).box =
      boxNeighbor α S.box i S.orientation :=
  rfl

@[simp]
theorem oppositeOrientedFace_involutive (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) : oppositeOrientedFace α i (oppositeOrientedFace α i S) = S := by
  cases S with
  | mk q ε =>
    simp only [oppositeOrientedFace, OrientedFace.mk.injEq,
      FaceOrientation.opposite_opposite]
    exact ⟨boxNeighbor_neighbor_opposite α q i ε, trivial⟩

theorem oppositeOrientedFace_ne (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) : oppositeOrientedFace α i S ≠ S := by
  intro h
  have horient := congrArg OrientedFace.orientation h
  exact S.orientation.opposite_ne (by simpa using horient)

/-- All oriented records incident to the boxes of a finite tree. -/
def treeOrientedFaces {α : Anisotropy} (T : FiniteConvexTree α) :
    Finset (OrientedFace α) :=
  T.boxes.biUnion orientedFacesOfBox

theorem mem_treeOrientedFaces_iff {α : Anisotropy} (T : FiniteConvexTree α)
    (S : OrientedFace α) :
    S ∈ treeOrientedFaces T ↔ S.box ∈ T.boxes := by
  constructor
  · intro h
    rcases Finset.mem_biUnion.mp h with ⟨q, hq, hS⟩
    exact (mem_orientedFacesOfBox_iff q S).mp hS ▸ hq
  · intro h
    exact Finset.mem_biUnion.mpr ⟨S.box, h,
      (mem_orientedFacesOfBox_iff S.box S).mpr rfl⟩

/-- All surviving faces, represented by one finite collection rather than an
infinite sum over integer levels.  This is precisely the finite support of
the source packing sum. -/
def survivingFacesAll {α : Anisotropy} (T : FiniteConvexTree α)
    (i : Fin 3) : Finset (OrientedFace α) :=
  T.boxes.biUnion fun q ↦
    (orientedFacesOfBox q).filter fun S ↦
      boxNeighbor α S.box i S.orientation ∉ T.boxes

theorem survivingFacesAll_eq_filter_treeOrientedFaces {α : Anisotropy}
    (T : FiniteConvexTree α) (i : Fin 3) :
    survivingFacesAll T i =
      (treeOrientedFaces T).filter fun S ↦
        boxNeighbor α S.box i S.orientation ∉ T.boxes := by
  ext S
  constructor
  · intro h
    rcases Finset.mem_biUnion.mp h with ⟨q, hq, hS⟩
    rcases Finset.mem_filter.mp hS with ⟨hface, hout⟩
    apply Finset.mem_filter.mpr
    refine ⟨(mem_treeOrientedFaces_iff T S).mpr ?_, hout⟩
    exact (mem_orientedFacesOfBox_iff q S).mp hface ▸ hq
  · intro h
    rcases Finset.mem_filter.mp h with ⟨htree, hout⟩
    have hbox : S.box ∈ T.boxes := (mem_treeOrientedFaces_iff T S).mp htree
    refine Finset.mem_biUnion.mpr ⟨S.box, hbox, ?_⟩
    exact Finset.mem_filter.mpr
      ⟨(mem_orientedFacesOfBox_iff S.box S).mpr rfl, hout⟩

/-- The complementary, paired face records whose two incident boxes are both
in the tree. -/
def interiorFacesAll {α : Anisotropy} (T : FiniteConvexTree α)
    (i : Fin 3) : Finset (OrientedFace α) :=
  (treeOrientedFaces T).filter fun S ↦
    boxNeighbor α S.box i S.orientation ∈ T.boxes

theorem mem_interiorFacesAll_iff {α : Anisotropy} (T : FiniteConvexTree α)
    (i : Fin 3) (S : OrientedFace α) :
    S ∈ interiorFacesAll T i ↔ S.box ∈ T.boxes ∧
      boxNeighbor α S.box i S.orientation ∈ T.boxes := by
  simp only [interiorFacesAll, Finset.mem_filter, mem_treeOrientedFaces_iff]

/-- The two oriented records of an interior grid face are both interior. -/
theorem mem_interiorFacesAll_opposite {α : Anisotropy} (T : FiniteConvexTree α)
    (i : Fin 3) (S : OrientedFace α) :
    oppositeOrientedFace α i S ∈ interiorFacesAll T i ↔ S ∈ interiorFacesAll T i := by
  constructor
  · intro h
    rcases (mem_interiorFacesAll_iff T i (oppositeOrientedFace α i S)).mp h with
      ⟨hbox, hneighbor⟩
    apply (mem_interiorFacesAll_iff T i S).mpr
    constructor
    · simpa only [oppositeOrientedFace_box, oppositeOrientedFace_orientation,
        boxNeighbor_neighbor_opposite] using hneighbor
    · simpa only [oppositeOrientedFace_box] using hbox
  · intro h
    rcases (mem_interiorFacesAll_iff T i S).mp h with ⟨hbox, hneighbor⟩
    apply (mem_interiorFacesAll_iff T i (oppositeOrientedFace α i S)).mpr
    constructor
    · simpa only [oppositeOrientedFace_box] using hneighbor
    · simpa only [oppositeOrientedFace_box, oppositeOrientedFace_orientation,
        boxNeighbor_neighbor_opposite] using hbox

/-- Any anti-symmetric quantity cancels on the paired interior face records. -/
theorem sum_interiorFacesAll_eq_zero_of_opposite
    {α : Anisotropy} {G : Type*} [AddCommGroup G]
    (T : FiniteConvexTree α) (i : Fin 3) (f : OrientedFace α → G)
    (hanti : ∀ S, f S + f (oppositeOrientedFace α i S) = 0) :
    ∑ S ∈ interiorFacesAll T i, f S = 0 := by
  apply Finset.sum_involution (fun S _ ↦ oppositeOrientedFace α i S)
  · intro S hS
    exact hanti S
  · intro S hS hnonzero hEq
    exact oppositeOrientedFace_ne α i S hEq
  · intro S hS
    exact (mem_interiorFacesAll_opposite T i S).mpr hS
  · intro S hS
    exact oppositeOrientedFace_involutive α i S

/-- Splitting the oriented faces of a tree into its surviving and interior
records is an exact finite partition. -/
theorem sum_treeOrientedFaces_eq_sum_surviving_add_interior
    {α : Anisotropy} {G : Type*} [AddCommMonoid G]
    (T : FiniteConvexTree α) (i : Fin 3) (f : OrientedFace α → G) :
    (∑ S ∈ treeOrientedFaces T, f S) =
      (∑ S ∈ survivingFacesAll T i, f S) +
        ∑ S ∈ interiorFacesAll T i, f S := by
  symm
  simpa only [survivingFacesAll_eq_filter_treeOrientedFaces, interiorFacesAll,
    not_not] using
    (Finset.sum_filter_add_sum_filter_not (treeOrientedFaces T)
      (fun S ↦ boxNeighbor α S.box i S.orientation ∉ T.boxes) f)

/-- After anti-symmetric interior cancellation, the full oriented boundary sum
is exactly its surviving-face sum. -/
theorem sum_treeOrientedFaces_eq_sum_surviving_of_opposite
    {α : Anisotropy} {G : Type*} [AddCommGroup G]
    (T : FiniteConvexTree α) (i : Fin 3) (f : OrientedFace α → G)
    (hanti : ∀ S, f S + f (oppositeOrientedFace α i S) = 0) :
    (∑ S ∈ treeOrientedFaces T, f S) =
      ∑ S ∈ survivingFacesAll T i, f S := by
  rw [sum_treeOrientedFaces_eq_sum_surviving_add_interior]
  rw [sum_interiorFacesAll_eq_zero_of_opposite T i f hanti]
  simp

theorem mem_survivingFacesAll_iff {α : Anisotropy} (T : FiniteConvexTree α)
    (i : Fin 3) (S : OrientedFace α) :
    S ∈ survivingFacesAll T i ↔ S.box ∈ T.boxes ∧
      boxNeighbor α S.box i S.orientation ∉ T.boxes := by
  constructor
  · intro hS
    rcases Finset.mem_biUnion.mp hS with ⟨q, hq, hS⟩
    have hface : S ∈ orientedFacesOfBox q := (Finset.mem_filter.mp hS).1
    have hneighbor : boxNeighbor α S.box i S.orientation ∉ T.boxes :=
      (Finset.mem_filter.mp hS).2
    exact ⟨(mem_orientedFacesOfBox_iff q S).mp hface ▸ hq, hneighbor⟩
  · rintro ⟨hbox, hneighbor⟩
    refine Finset.mem_biUnion.mpr ⟨S.box, hbox, ?_⟩
    exact Finset.mem_filter.mpr ⟨(mem_orientedFacesOfBox_iff S.box S).mpr rfl,
      hneighbor⟩

/-- The finite version of the source's weighted boundary count.  The equality
`boxMass = 2^(k A)` proved above makes this definition literally the displayed
packing sum after grouping by levels. -/
noncomputable def facePackingMass {α : Anisotropy} (T : FiniteConvexTree α)
    (i : Fin 3) : ℝ :=
  ∑ S ∈ survivingFacesAll T i, boxMass α S.box

theorem mem_survivingFacesAll_iff_exists_level {α : Anisotropy}
    (T : FiniteConvexTree α) (i : Fin 3) (S : OrientedFace α) :
    S ∈ survivingFacesAll T i ↔ ∃ k : ℤ, S ∈ survivingFaces T i k := by
  constructor
  · intro hS
    refine ⟨S.box.level, (mem_survivingFaces_iff T i S.box.level S).mpr ?_⟩
    rcases (mem_survivingFacesAll_iff T i S).mp hS with ⟨hbox, hneighbor⟩
    exact ⟨(mem_treeAtLevel_iff T S.box.level S.box).mpr ⟨hbox, rfl⟩, hneighbor⟩
  · rintro ⟨k, hS⟩
    rcases (mem_survivingFaces_iff T i k S).mp hS with ⟨hbox, hneighbor⟩
    exact (mem_survivingFacesAll_iff T i S).mpr
      ⟨(mem_treeAtLevel_iff T k S.box).mp hbox |>.1, hneighbor⟩

theorem anisotropicBracketKernel_pos (α : Anisotropy) {t : ℝ}
    (ht : 0 < t) (p y : E3) :
    0 < anisotropicBracketKernel α t p y := by
  unfold anisotropicBracketKernel
  apply Finset.prod_pos
  intro i _
  exact bracketKernelAt_pos (pow_pos ht _)

/-- The product comparison kernel is integrable at every positive
anisotropic scale. -/
theorem integrable_anisotropicBracketKernel (α : Anisotropy) {t : ℝ}
    (ht : 0 < t) (p : E3) :
    Integrable (anisotropicBracketKernel α t p) := by
  rw [← (PiLp.volume_preserving_toLp (Fin 3)).integrable_comp_emb
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  change Integrable (fun x : Fin 3 → ℝ ↦
    ∏ i : Fin 3, bracketKernelAt (t ^ α.weight i) (p i) (x i))
  exact Integrable.fintype_prod fun i ↦
    integrable_bracketKernelAt (pow_pos ht _) (p i)

/-- Replace the `i`th bit of a cube vertex by `b`, the source map
`\rho_i^b`. -/
def cubeVertexReplace (i : Fin 3) (b : Bool) (j : CubeVertex) : CubeVertex :=
  fun q ↦ if q = i then b else j q

@[simp]
theorem cubeVertexReplace_apply (i : Fin 3) (b : Bool) (j : CubeVertex)
    (q : Fin 3) :
    cubeVertexReplace i b j q = if q = i then b else j q := rfl

theorem cubeVertexReplace_idempotent (i : Fin 3) (a b : Bool)
    (j : CubeVertex) :
    cubeVertexReplace i b (cubeVertexReplace i a j) =
      cubeVertexReplace i b j := by
  funext q
  by_cases hqi : q = i <;> simp [cubeVertexReplace, hqi]

theorem cubeVertexReplace_commute {i q : Fin 3} (hiq : i ≠ q)
    (a b : Bool) (j : CubeVertex) :
    cubeVertexReplace i a (cubeVertexReplace q b j) =
      cubeVertexReplace q b (cubeVertexReplace i a j) := by
  funext r
  by_cases hri : r = i
  · subst r
    simp [cubeVertexReplace, hiq]
  · by_cases hrq : r = q
    · subst r
      simp [cubeVertexReplace, hri]
    · simp [cubeVertexReplace, hri, hrq]

/-- Copy a cube input along one coordinate bit, the source operator
`\mathsf C_i^b`. -/
def cubeCoordinateCopy (i : Fin 3) (b : Bool)
    (F : CubeVertex → E3 → ℝ) : CubeVertex → E3 → ℝ :=
  fun j ↦ F (cubeVertexReplace i b j)

theorem cubeCoordinateCopy_absorb (i : Fin 3) (a b : Bool)
    (F : CubeVertex → E3 → ℝ) :
    cubeCoordinateCopy i b (cubeCoordinateCopy i a F) =
      cubeCoordinateCopy i a F := by
  funext j x
  simp only [cubeCoordinateCopy]
  rw [cubeVertexReplace_idempotent i b a]

theorem cubeCoordinateCopy_idempotent (i : Fin 3) (b : Bool)
    (F : CubeVertex → E3 → ℝ) :
    cubeCoordinateCopy i b (cubeCoordinateCopy i b F) =
      cubeCoordinateCopy i b F :=
  cubeCoordinateCopy_absorb i b b F

theorem cubeCoordinateCopy_commute {i q : Fin 3} (hiq : i ≠ q)
    (a b : Bool) (F : CubeVertex → E3 → ℝ) :
    cubeCoordinateCopy i a (cubeCoordinateCopy q b F) =
      cubeCoordinateCopy q b (cubeCoordinateCopy i a F) := by
  funext j x
  simp only [cubeCoordinateCopy]
  rw [cubeVertexReplace_commute hiq]

theorem cubeBracketWeight_pos (α : Anisotropy) {t : ℝ} (ht : 0 < t)
    (p : E3) (x : E6) : 0 < cubeBracketWeight α t p x := by
  unfold cubeBracketWeight
  apply Finset.prod_pos
  intro q _
  exact bracketKernelAt_pos (pow_pos ht _)

theorem integral_cubeBracketWeight (α : Anisotropy) {t : ℝ} (ht : 0 < t)
    (p : E3) :
    ∫ x : E6, cubeBracketWeight α t p x = (2 / 9 : ℝ) ^ 6 := by
  rw [← (PiLp.volume_preserving_toLp (Fin 3 × Bool)).integral_comp
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  change (∫ x : Fin 3 × Bool → ℝ,
    ∏ q : Fin 3 × Bool,
      bracketKernelAt (t ^ α.weight q.1) (p q.1) (x q)) = _
  rw [integral_fintype_prod_volume_eq_prod]
  have hfac (q : Fin 3 × Bool) :
      ∫ x : ℝ, bracketKernelAt (t ^ α.weight q.1) (p q.1) x = 2 / 9 :=
    integral_bracketKernelAt (pow_pos ht _) (p q.1)
  simp_rw [hfac]
  norm_num [Finset.prod_const, Fintype.card_prod, Fintype.card_fin]

/-- The concrete coordinate permutation which places the `000` variables
first and the `111` variables second. -/
def cubeFalseTrueIndexEquiv : Fin 3 ⊕ Fin 3 ≃ Fin 3 × Bool where
  toFun := fun q ↦ match q with
    | .inl i => (i, false)
    | .inr i => (i, true)
  invFun := fun q ↦ if q.2 then .inr q.1 else .inl q.1
  left_inv := by intro q; cases q <;> simp
  right_inv := by rintro ⟨i, b⟩; cases b <;> simp

/-- Measure-preserving splitting of the six cube coordinates into the two
opposite vertices `000` and `111`. -/
noncomputable def cubeFalseTrueSplit : E6 ≃ᵐ E3 × E3 :=
  ((LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ cubeFalseTrueIndexEquiv.symm).trans
    (PiLp.sumPiLpEquivProdLpPiLp 2 (fun _ : Fin 3 ⊕ Fin 3 => ℝ))).toMeasurableEquiv.trans
    (MeasurableEquiv.toLp 2 (E3 × E3)).symm

theorem cubeFalseTrueSplit_measurePreserving :
    MeasurePreserving cubeFalseTrueSplit := by
  exact (WithLp.volume_preserving_symm_measurableEquiv_toLp_prod
    (U := E3) (V := E3)).comp
    (LinearIsometryEquiv.measurePreserving
      ((LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ cubeFalseTrueIndexEquiv.symm).trans
        (PiLp.sumPiLpEquivProdLpPiLp 2 (fun _ : Fin 3 ⊕ Fin 3 => ℝ))))

theorem cubeFalseTrueSplit_apply (x : E6) :
    cubeFalseTrueSplit x =
      (cubeProjection (fun _ => false) x, cubeProjection (fun _ => true) x) := by
  ext i <;>
    simp [cubeFalseTrueSplit, cubeProjection, cubeFalseTrueIndexEquiv,
      LinearIsometryEquiv.piLpCongrLeft_apply, PiLp.sumPiLpEquivProdLpPiLp,
      WithLp.ofLp_toLp]

/-- The exact Fubini factorization for the `000`--`111` opposite pair.
This is the analytic heart of one of the four factors in the full-cube
Brascamp--Lieb inequality. -/
theorem integral_cube_false_true_pair_pow_four
    (α : Anisotropy) (t : ℝ) (p : E3) (F0 F1 : E3 → ℝ) :
    ∫ x : E6,
        (F0 (cubeProjection (fun _ => false) x) *
          F1 (cubeProjection (fun _ => true) x)) ^ 4 *
          cubeBracketWeight α t p x =
      (∫ y : E3, F0 y ^ 4 * anisotropicBracketKernel α t p y) *
        ∫ z : E3, F1 z ^ 4 * anisotropicBracketKernel α t p z := by
  let A : E3 → ℝ := fun y => F0 y ^ 4 * anisotropicBracketKernel α t p y
  let C : E3 → ℝ := fun z => F1 z ^ 4 * anisotropicBracketKernel α t p z
  let G : E3 × E3 → ℝ := fun yz => A yz.1 * C yz.2
  have hW (x : E6) :
      cubeBracketWeight α t p x =
        anisotropicBracketKernel α t p (cubeProjection (fun _ => false) x) *
          anisotropicBracketKernel α t p (cubeProjection (fun _ => true) x) := by
    simp only [cubeBracketWeight, anisotropicBracketKernel, cubeProjection]
    rw [Fintype.prod_prod_type]
    simp_rw [Fintype.prod_bool]
    rw [Finset.prod_mul_distrib, mul_comm]
  calc
    _ = ∫ x : E6, G (cubeFalseTrueSplit x) := by
      apply integral_congr_ae
      filter_upwards [] with x
      rw [cubeFalseTrueSplit_apply]
      simp only [G, A, C]
      rw [hW x, mul_pow]
      ring
    _ = ∫ yz : E3 × E3, G yz :=
      cubeFalseTrueSplit_measurePreserving.integral_comp' G
    _ = _ := by exact integral_prod_mul A C

theorem continuous_anisotropicBracketKernel (α : Anisotropy) {t : ℝ}
    (ht : 0 < t) (p : E3) :
    Continuous (anisotropicBracketKernel α t p) := by
  unfold anisotropicBracketKernel
  apply continuous_finsetProd Finset.univ
  intro i _
  exact (continuous_bracketKernelAt (pow_ne_zero _ ht.ne') (p i)).comp
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i)

theorem measurable_anisotropicBracketKernel (α : Anisotropy) {t : ℝ}
    (ht : 0 < t) (p : E3) :
    Measurable (anisotropicBracketKernel α t p) :=
  (continuous_anisotropicBracketKernel α ht p).measurable

/-- Joint continuity of the sixfold comparison weight in center and spatial
variables at one fixed scale. -/
theorem continuous_cubeBracketWeight_center_space
    (α : Anisotropy) (t : ℝ) :
    Continuous (fun z : E3 × E6 ↦ cubeBracketWeight α t z.1 z.2) := by
  unfold cubeBracketWeight bracketKernelAt kernelAt kernelDilate
  apply continuous_finsetProd
  intro q _
  have hx : Continuous (fun z : E3 × E6 ↦ z.2 q) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 × Bool ↦ ℝ) q).comp
      continuous_snd
  have hp : Continuous (fun z : E3 × E6 ↦ z.1 q.1) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) q.1).comp
      continuous_fst
  have harg : Continuous (fun z : E3 × E6 ↦
      (z.2 q - z.1 q.1) / t ^ α.weight q.1) :=
    (hx.sub hp).div_const _
  have hprod : Continuous (fun z : E3 × E6 ↦
      (t ^ α.weight q.1)⁻¹ * bracketKernel
        ((z.2 q - z.1 q.1) / t ^ α.weight q.1)) :=
    (continuous_const : Continuous (fun _ : E3 × E6 ↦
      (t ^ α.weight q.1)⁻¹)).mul (continuous_bracketKernel.comp harg)
  simpa only [smul_eq_mul] using hprod

/-- On a finite center box, the positive sixfold comparison weight is jointly
integrable in the center and all six spatial variables. -/
theorem integrable_cubeBracketWeight_center_space
    (α : Anisotropy) (q : AnisoBox α) {t : ℝ} (ht : 0 < t) :
    Integrable (fun z : E3 × E6 ↦ cubeBracketWeight α t z.1 z.2)
      ((volume.restrict (boxSet α q)).prod volume) := by
  letI : IsFiniteMeasure (volume.restrict (boxSet α q)) := by
    constructor
    rw [Measure.restrict_apply_univ]
    rw [volume_boxSet]
    exact lt_top_iff_ne_top.mpr
      (ENNReal.prod_ne_top fun _ _ ↦ ENNReal.ofReal_ne_top)
  have hmeas : AEStronglyMeasurable
      (fun z : E3 × E6 ↦ cubeBracketWeight α t z.1 z.2)
      ((volume.restrict (boxSet α q)).prod volume) :=
    (continuous_cubeBracketWeight_center_space α t).aestronglyMeasurable
  refine (integrable_prod_iff hmeas).mpr ⟨?_, ?_⟩
  · filter_upwards [] with p
    exact integrable_cubeBracketWeight α ht p
  · have hconst : (fun p : E3 ↦
        ∫ x : E6, ‖cubeBracketWeight α t p x‖) =
          fun _ ↦ (2 / 9 : ℝ) ^ 6 := by
      funext p
      rw [show (fun x : E6 ↦ ‖cubeBracketWeight α t p x‖) =
        cubeBracketWeight α t p by
          funext x
          rw [Real.norm_eq_abs, abs_of_nonneg]
          exact cubeBracketWeight_nonneg α ht.le p x]
      exact integral_cubeBracketWeight α ht p
    rw [hconst]
    exact integrable_const _

/-! ### Ancestor transport of surviving faces

These finite-grid facts implement the first charge in the source packing
argument.  In particular, the apparent ``first ancestor'' is an actual
finite selection from the tree rather than an implicit infinite chain.
-/

theorem boxAncestor_succ (α : Anisotropy) (n : ℕ) (q : AnisoBox α) :
    boxAncestor α (n + 1) q = boxParent α (boxAncestor α n q) := by
  simp [boxAncestor, Function.iterate_succ_apply']

theorem boxAncestor_neighbor_eq_or_neighbor (α : Anisotropy)
    (n : ℕ) (q : AnisoBox α) (i : Fin 3) (ε : FaceOrientation) :
    boxAncestor α n (boxNeighbor α q i ε) = boxAncestor α n q ∨
      boxAncestor α n (boxNeighbor α q i ε) =
        boxNeighbor α (boxAncestor α n q) i ε := by
  induction n with
  | zero => right; simp [boxAncestor]
  | succ n ih =>
    rw [boxAncestor_succ, boxAncestor_succ]
    rcases ih with heq | hnb
    · left
      rw [heq]
    · rw [hnb]
      exact boxParent_neighbor_eq_or_neighbor α (boxAncestor α n q) i ε

theorem boxNeighbor_ne_self (α : Anisotropy) (q : AnisoBox α) (i : Fin 3)
    (ε : FaceOrientation) : boxNeighbor α q i ε ≠ q := by
  intro h
  have hi := congrFun (congrArg AnisoBox.index h) i
  cases ε <;> simp [boxNeighbor, FaceOrientation.sign] at hi

theorem boxFaceSet_neighbor_opposite (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) (ε : FaceOrientation) :
    boxFaceSet α q i ε =
      boxFaceSet α (boxNeighbor α q i ε) i ε.opposite := by
  ext p
  simp only [boxFaceSet, Set.mem_setOf_eq]
  rw [boxFaceCoordinate_neighbor_opposite]
  constructor
  · rintro ⟨hp, ht⟩
    refine ⟨hp, ?_⟩
    intro j hji
    simpa [boxNeighbor, boxSide, hji] using ht j hji
  · rintro ⟨hp, ht⟩
    refine ⟨hp, ?_⟩
    intro j hji
    simpa [boxNeighbor, boxSide, hji] using ht j hji

theorem boxFaceSet_subset_ancestor_of_ancestor_neighbor
    (α : Anisotropy) (n : ℕ) (q : AnisoBox α) (i : Fin 3)
    (ε : FaceOrientation)
    (h : boxAncestor α n (boxNeighbor α q i ε) =
      boxNeighbor α (boxAncestor α n q) i ε) :
    boxFaceSet α q i ε ⊆ boxFaceSet α (boxAncestor α n q) i ε := by
  induction n generalizing q with
  | zero => simp [boxAncestor]
  | succ n ih =>
    simp only [boxAncestor_succ] at h ⊢
    rcases boxAncestor_neighbor_eq_or_neighbor α n q i ε with heq | hnb
    · exfalso
      have hbad : boxParent α (boxAncestor α n q) =
          boxNeighbor α (boxParent α (boxAncestor α n q)) i ε := by
        simpa [heq] using h
      exact boxNeighbor_ne_self α (boxParent α (boxAncestor α n q)) i ε hbad.symm
    · have hparent : boxParent α (boxNeighbor α (boxAncestor α n q) i ε) =
          boxNeighbor α (boxParent α (boxAncestor α n q)) i ε := by
        simpa [hnb] using h
      exact (ih q hnb).trans
        (boxFaceSet_subset_parent_of_parent_neighbor α (boxAncestor α n q) i ε hparent)

theorem boxFaceSet_subset_of_adjacent_box_ancestor_not_subset
    (α : Anisotropy) (q L : AnisoBox α) (i : Fin 3) (ε : FaceOrientation)
    (n : ℕ) (hL : L = boxAncestor α n (boxNeighbor α q i ε))
    (hnot : ¬ boxSet α q ⊆ boxSet α L) :
    ∃ δ : FaceOrientation, boxFaceSet α q i ε ⊆ boxFaceSet α L i δ := by
  rcases boxAncestor_neighbor_eq_or_neighbor α n q i ε with heq | hnb
  · exfalso
    apply hnot
    rw [hL, heq]
    exact boxAncestor_subset α n q
  · refine ⟨ε.opposite, ?_⟩
    calc
      boxFaceSet α q i ε ⊆ boxFaceSet α (boxAncestor α n q) i ε :=
        boxFaceSet_subset_ancestor_of_ancestor_neighbor α n q i ε hnb
      _ = boxFaceSet α (boxNeighbor α (boxAncestor α n q) i ε) i ε.opposite :=
        boxFaceSet_neighbor_opposite α (boxAncestor α n q) i ε
      _ = boxFaceSet α L i ε.opposite := by rw [hL, hnb]

theorem boxSet_nonempty (α : Anisotropy) (q : AnisoBox α) :
    (boxSet α q).Nonempty := by
  by_contra h
  have hempty : boxSet α q = ∅ := Set.not_nonempty_iff_eq_empty.mp h
  have hzero : volume (boxSet α q) = 0 := by
    rw [hempty]
    exact measure_empty
  have hpos : 0 < volume (boxSet α q) := by
    rw [volume_boxSet_eq_boxMass]
    exact ENNReal.ofReal_pos.mpr (boxMass_pos α q)
  exact hpos.ne' hzero

theorem boxMass_lt_of_level_lt (α : Anisotropy) {q r : AnisoBox α}
    (hlevel : q.level < r.level) : boxMass α q < boxMass α r := by
  unfold boxMass
  apply zpow_lt_zpow_right₀ (by norm_num)
  have hA : (0 : ℤ) < (α.homogeneousDimension : ℤ) := by
    exact_mod_cast α.homogeneousDimension_pos
  nlinarith

theorem level_le_of_boxSet_subset (α : Anisotropy) {q r : AnisoBox α}
    (hsub : boxSet α q ⊆ boxSet α r) : q.level ≤ r.level := by
  by_contra hnot
  have hlevel : r.level < q.level := by omega
  obtain ⟨x, hx⟩ := boxSet_nonempty α q
  have hnested : boxSet α r ⊆ boxSet α q := by
    apply boxSet_nested_of_inter_nonempty α (by omega)
    exact ⟨x, hsub hx, hx⟩
  have hset : boxSet α q = boxSet α r := Set.Subset.antisymm hsub hnested
  have hmass : boxMass α q = boxMass α r := by
    rw [← volume_boxSet_toReal α q, hset, volume_boxSet_toReal]
  exact (ne_of_lt (boxMass_lt_of_level_lt α hlevel)) hmass.symm

theorem boxAncestor_eq_of_boxSet_subset (α : Anisotropy) {q r : AnisoBox α}
    (hsub : boxSet α q ⊆ boxSet α r) :
    boxAncestor α (r.level - q.level).toNat q = r := by
  have hlevel : q.level ≤ r.level := level_le_of_boxSet_subset α hsub
  let n : ℕ := (r.level - q.level).toNat
  have hn : (n : ℤ) = r.level - q.level := by
    dsimp [n]
    rw [Int.toNat_of_nonneg (sub_nonneg.mpr hlevel)]
  have hAncestorLevel : (boxAncestor α n q).level = r.level := by
    rw [boxAncestor_level, hn]
    ring
  by_contra hne
  have hdisj := boxSet_disjoint_of_eq_level_of_ne α hAncestorLevel hne
  obtain ⟨x, hx⟩ := boxSet_nonempty α q
  exact (Set.disjoint_left.1 hdisj) (boxAncestor_subset α n q hx) (hsub hx)

/-- A finite replacement for the source's ``first ancestor in the tree''.
It selects the missing child immediately below the minimal tree container. -/
theorem exists_leaf_container_of_boxSet_subset_root
    {α : Anisotropy} (T : FiniteConvexTree α) (q : AnisoBox α)
    (hqroot : boxSet α q ⊆ boxSet α T.root) (hqnot : q ∉ T.boxes) :
    ∃ L : AnisoBox α, L ∈ treeLeaves T ∧
      boxSet α q ⊆ boxSet α L ∧ q.level ≤ L.level := by
  classical
  let containers : Finset (AnisoBox α) :=
    T.boxes.filter fun P ↦ boxSet α q ⊆ boxSet α P
  have hcontne : containers.Nonempty := by
    exact ⟨T.root, Finset.mem_filter.mpr ⟨T.root_mem, hqroot⟩⟩
  let levels : Finset ℤ := containers.image AnisoBox.level
  have hlevelsne : levels.Nonempty := hcontne.image AnisoBox.level
  let m : ℤ := levels.min' hlevelsne
  have hm : m ∈ levels := by
    dsimp [m]
    exact Finset.min'_mem levels hlevelsne
  rcases Finset.mem_image.mp hm with ⟨P, hPcont, hPlevel⟩
  have hPT : P ∈ T.boxes := (Finset.mem_filter.mp hPcont).1
  have hqP : boxSet α q ⊆ boxSet α P := (Finset.mem_filter.mp hPcont).2
  have hqPlevel : q.level ≤ P.level := level_le_of_boxSet_subset α hqP
  have hlevelne : q.level ≠ P.level := by
    intro heq
    have hboxeq : q = P := by
      by_contra hne
      have hdisj := boxSet_disjoint_of_eq_level_of_ne α heq hne
      obtain ⟨x, hx⟩ := boxSet_nonempty α q
      exact (Set.disjoint_left.1 hdisj) hx (hqP hx)
    exact hqnot (hboxeq ▸ hPT)
  have hqPlt : q.level < P.level := by omega
  obtain ⟨x, hx⟩ := boxSet_nonempty α q
  have hxP : x ∈ boxSet α P := hqP hx
  have hxchildren : x ∈ ⋃ r ∈ boxChildren α P, boxSet α r := by
    rw [← boxSet_eq_children_union α P]
    exact hxP
  rcases Set.mem_iUnion.mp hxchildren with ⟨L, hL⟩
  rcases Set.mem_iUnion.mp hL with ⟨hLchild, hxL⟩
  have hLlevel : L.level = P.level - 1 := boxChildren_level α hLchild
  have hqLlevel : q.level ≤ L.level := by omega
  have hqL : boxSet α q ⊆ boxSet α L := by
    apply boxSet_nested_of_inter_nonempty α hqLlevel
    exact ⟨x, hx, hxL⟩
  have hLnot : L ∉ T.boxes := by
    intro hLT
    have hLcont : L ∈ containers := Finset.mem_filter.mpr ⟨hLT, hqL⟩
    have hLlevels : L.level ∈ levels := Finset.mem_image.mpr ⟨L, hLcont, rfl⟩
    have hmin := Finset.min'_le levels L.level hLlevels
    change m ≤ L.level at hmin
    omega
  have hparent : boxParent α L = P := by
    rcases Finset.mem_image.mp hLchild with ⟨v, -, rfl⟩
    exact boxParent_child α P v
  refine ⟨L, (mem_treeLeaves_iff T L).mpr ⟨hLnot, ?_⟩, hqL, hqLlevel⟩
  simpa only [hparent] using hPT

/-- First boundary charge: a surviving face whose outside neighbor stays
inside the root is charged to a face of one leaf, at no finer level. -/
theorem exists_leaf_face_charge
    {α : Anisotropy} (T : FiniteConvexTree α) (i : Fin 3)
    (S : OrientedFace α) (hS : S ∈ survivingFacesAll T i)
    (hout : boxSet α (boxNeighbor α S.box i S.orientation) ⊆ boxSet α T.root) :
    ∃ L ∈ treeLeaves T, ∃ δ : FaceOrientation,
      S.box.level ≤ L.level ∧
      boxFaceSet α S.box i S.orientation ⊆ boxFaceSet α L i δ := by
  rcases (mem_survivingFacesAll_iff T i S).mp hS with ⟨hbox, houtnot⟩
  rcases exists_leaf_container_of_boxSet_subset_root T
      (boxNeighbor α S.box i S.orientation) hout houtnot with
      ⟨L, hLleaf, houtL, houtLlevel⟩
  have hinsidenot : ¬ boxSet α S.box ⊆ boxSet α L := by
    intro hinside
    have hLtree : L ∈ T.boxes :=
      T.convex hbox (treeLeaves_parent_mem T hLleaf)
        hinside (boxSet_subset_parent α L)
    exact (treeLeaves_not_mem T hLleaf) hLtree
  have hAncestor :
      boxAncestor α (L.level - (boxNeighbor α S.box i S.orientation).level).toNat
        (boxNeighbor α S.box i S.orientation) = L :=
    boxAncestor_eq_of_boxSet_subset α houtL
  rcases boxFaceSet_subset_of_adjacent_box_ancestor_not_subset α S.box L
      i S.orientation
      (L.level - (boxNeighbor α S.box i S.orientation).level).toNat
      hAncestor.symm hinsidenot with ⟨δ, hface⟩
  refine ⟨L, hLleaf, δ, ?_, hface⟩
  simpa only [boxNeighbor_level] using houtLlevel

/-! ### Finite forest reindexing

This is the exact finite endpoint cancellation used in the telescoping
identity: every non-root tree box occurs once as a child, and the remaining
children are precisely the leaves. -/

def treeChildrenAll {α : Anisotropy} (T : FiniteConvexTree α) :
    Finset (AnisoBox α) :=
  T.boxes.biUnion (boxChildren α)

theorem mem_treeChildrenAll_iff {α : Anisotropy} (T : FiniteConvexTree α)
    (r : AnisoBox α) :
    r ∈ treeChildrenAll T ↔ boxParent α r ∈ T.boxes := by
  constructor
  · intro hr
    rcases Finset.mem_biUnion.mp hr with ⟨q, hq, hrq⟩
    rcases Finset.mem_image.mp hrq with ⟨v, hv, hvr⟩
    subst r
    simpa only [boxParent_child] using hq
  · intro hr
    rcases (boxParent_eq_iff_exists_boxChild α (boxParent α r) r).mp rfl with
      ⟨v, hv⟩
    refine Finset.mem_biUnion.mpr ⟨boxParent α r, hr, ?_⟩
    exact Finset.mem_image.mpr ⟨v, Finset.mem_univ _, hv⟩

theorem root_not_mem_treeChildrenAll {α : Anisotropy} (T : FiniteConvexTree α) :
    T.root ∉ treeChildrenAll T := by
  intro hroot
  have hparent : boxParent α T.root ∈ T.boxes :=
    (mem_treeChildrenAll_iff T T.root).mp hroot
  have hsub : boxSet α (boxParent α T.root) ⊆ boxSet α T.root :=
    T.below_root _ hparent
  have hlevel := level_le_of_boxSet_subset α hsub
  change T.root.level + 1 ≤ T.root.level at hlevel
  omega

theorem boxParent_mem_tree_of_mem_ne_root {α : Anisotropy}
    (T : FiniteConvexTree α) {q : AnisoBox α}
    (hq : q ∈ T.boxes) (hqroot : q ≠ T.root) :
    boxParent α q ∈ T.boxes := by
  have hqsub : boxSet α q ⊆ boxSet α T.root := T.below_root q hq
  have hqle : q.level ≤ T.root.level := level_le_of_boxSet_subset α hqsub
  have hqnelevel : q.level ≠ T.root.level := by
    intro hlevel
    have hdisj := boxSet_disjoint_of_eq_level_of_ne α hlevel hqroot
    obtain ⟨x, hx⟩ := boxSet_nonempty α q
    exact (Set.disjoint_left.1 hdisj) hx (hqsub hx)
  have hqlt : q.level < T.root.level := lt_of_le_of_ne hqle hqnelevel
  apply T.convex hq T.root_mem (boxSet_subset_parent α q)
  apply boxSet_nested_of_inter_nonempty α
  · change q.level + 1 ≤ T.root.level
    omega
  · obtain ⟨x, hx⟩ := boxSet_nonempty α q
    exact ⟨x, boxSet_subset_parent α q hx, hqsub hx⟩

theorem treeChildrenAll_eq_erase_union_leaves {α : Anisotropy}
    (T : FiniteConvexTree α) :
    treeChildrenAll T = (T.boxes.erase T.root) ∪ treeLeaves T := by
  ext r
  constructor
  · intro hr
    by_cases hrT : r ∈ T.boxes
    · have hrne : r ≠ T.root := by
        intro hEq
        subst r
        exact root_not_mem_treeChildrenAll T hr
      exact Finset.mem_union_left _ (Finset.mem_erase.mpr ⟨hrne, hrT⟩)
    · exact Finset.mem_union_right _
        ((mem_treeLeaves_iff T r).mpr
          ⟨hrT, (mem_treeChildrenAll_iff T r).mp hr⟩)
  · intro hr
    rcases Finset.mem_union.mp hr with hr | hr
    · have hrT : r ∈ T.boxes := (Finset.mem_erase.mp hr).2
      have hrne : r ≠ T.root := (Finset.mem_erase.mp hr).1
      exact (mem_treeChildrenAll_iff T r).mpr
        (boxParent_mem_tree_of_mem_ne_root T hrT hrne)
    · exact (mem_treeChildrenAll_iff T r).mpr
        ((mem_treeLeaves_iff T r).mp hr).2

theorem treeEraseRoot_disjoint_leaves {α : Anisotropy} (T : FiniteConvexTree α) :
    Disjoint (T.boxes.erase T.root) (treeLeaves T) := by
  rw [Finset.disjoint_left]
  intro l hl hleaf
  exact treeLeaves_not_mem T hleaf (Finset.mem_erase.mp hl).2

theorem sum_treeChildrenAll_sub_sum_treeBoxes {α : Anisotropy}
    (T : FiniteConvexTree α) (w : AnisoBox α → ℝ) :
    (∑ r ∈ treeChildrenAll T, w r) - ∑ q ∈ T.boxes, w q =
      (∑ l ∈ treeLeaves T, w l) - w T.root := by
  rw [treeChildrenAll_eq_erase_union_leaves]
  rw [Finset.sum_union (treeEraseRoot_disjoint_leaves T)]
  rw [← Finset.sum_erase_add T.boxes w T.root_mem]
  ring

/-! ### Boundary-frontier mass contraction

The following finite descendants are the numerical core of the boundary
packing argument.  At one subdivision step they tile a fixed oriented face;
their total box mass contracts by the normal-coordinate radix. -/

def boundaryDigit (α : Anisotropy) (i : Fin 3) :
    FaceOrientation → Fin (anisoRadix α i)
  | .lower => ⟨0, anisoRadix_pos α i⟩
  | .upper => ⟨(anisoRadix α i).pred,
      Nat.pred_lt (Nat.ne_of_gt (anisoRadix_pos α i))⟩

def boundaryDigits (α : Anisotropy) (i : Fin 3)
    (ε : FaceOrientation) : Finset (AnisoDigit α) :=
  Finset.univ.filter fun v => v i = boundaryDigit α i ε

noncomputable def boundaryFaceChildren (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) : Finset (OrientedFace α) := by
  classical
  rcases S with ⟨q, ε⟩
  exact (boundaryDigits α i ε).image fun v => ⟨boxChild α q v, ε⟩

theorem card_boundaryDigits_mul_radix (α : Anisotropy) (i : Fin 3)
    (ε : FaceOrientation) :
    (boundaryDigits α i ε).card * anisoRadix α i =
      2 ^ α.homogeneousDimension := by
  unfold boundaryDigits
  rw [← Fintype.piFinset_univ]
  let s : ∀ j, Finset (Fin (anisoRadix α j)) := fun j => Finset.univ
  change ({v ∈ Fintype.piFinset s | v i = boundaryDigit α i ε}.card) *
      anisoRadix α i = 2 ^ α.homogeneousDimension
  have ha : boundaryDigit α i ε ∈ s i := Finset.mem_univ _
  have h := Fintype.card_filter_piFinset_eq_of_mem s i ha
  rw [h]
  calc
    (∏ j ∈ Finset.univ.erase i, (s j).card) * anisoRadix α i =
        ∏ j, anisoRadix α j := by
          simp [s]
          exact Finset.prod_erase_mul _ _ (Finset.mem_univ _)
    _ = 2 ^ α.homogeneousDimension := by
      unfold anisoRadix Anisotropy.homogeneousDimension
      rw [Finset.prod_pow_eq_pow_sum]

theorem boundaryFaceChild_injective (α : Anisotropy) (_i : Fin 3)
    (S : OrientedFace α) :
    Function.Injective (fun v : AnisoDigit α =>
      (⟨boxChild α S.box v, S.orientation⟩ : OrientedFace α)) := by
  intro v w h
  apply boxChild_injective α S.box
  exact congrArg OrientedFace.box h

theorem boundaryFaceChildren_sum_eq (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) :
    ∑ S' ∈ boundaryFaceChildren α i S, boxMass α S'.box =
      ∑ v ∈ boundaryDigits α i S.orientation,
        boxMass α (boxChild α S.box v) := by
  classical
  rcases S with ⟨q, ε⟩
  simp only [boundaryFaceChildren]
  rw [Finset.sum_image (boundaryFaceChild_injective α i ⟨q, ε⟩).injOn]

theorem boundaryFaceChildren_mass_mul_radix (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) :
    (∑ S' ∈ boundaryFaceChildren α i S, boxMass α S'.box) *
      (anisoRadix α i : ℝ) = boxMass α S.box := by
  classical
  have hDpos : 0 < 2 ^ α.homogeneousDimension := by positivity
  have hDne : (2 ^ α.homogeneousDimension : ℝ) ≠ 0 := by
    exact_mod_cast (Nat.ne_of_gt hDpos)
  apply mul_right_cancel₀ hDne
  rw [boundaryFaceChildren_sum_eq]
  have hcardNat : (boundaryDigits α i S.orientation).card * anisoRadix α i =
      2 ^ α.homogeneousDimension :=
    card_boundaryDigits_mul_radix α i S.orientation
  have hcard : ((boundaryDigits α i S.orientation).card : ℝ) *
      (anisoRadix α i : ℝ) = (2 ^ α.homogeneousDimension : ℝ) := by
    exact_mod_cast hcardNat
  have hsum :
      (∑ v ∈ boundaryDigits α i S.orientation,
          boxMass α (boxChild α S.box v)) *
        (2 ^ α.homogeneousDimension : ℝ) =
      (boundaryDigits α i S.orientation).card * boxMass α S.box := by
    rw [Finset.sum_mul]
    calc
      (∑ x ∈ boundaryDigits α i S.orientation,
          boxMass α (boxChild α S.box x) *
            (2 ^ α.homogeneousDimension : ℝ)) =
          ∑ _x ∈ boundaryDigits α i S.orientation, boxMass α S.box := by
            apply Finset.sum_congr rfl
            intro v hv
            exact boxMass_child_mul_card α S.box v
      _ = (boundaryDigits α i S.orientation).card * boxMass α S.box := by
          simp [nsmul_eq_mul]
  calc
    ((∑ v ∈ boundaryDigits α i S.orientation,
        boxMass α (boxChild α S.box v)) * (anisoRadix α i : ℝ)) *
        (2 ^ α.homogeneousDimension : ℝ) =
        ((∑ v ∈ boundaryDigits α i S.orientation,
          boxMass α (boxChild α S.box v)) *
            (2 ^ α.homogeneousDimension : ℝ)) * (anisoRadix α i : ℝ) := by ring
    _ = ((boundaryDigits α i S.orientation).card * boxMass α S.box) *
        (anisoRadix α i : ℝ) := by rw [hsum]
    _ = boxMass α S.box * ((boundaryDigits α i S.orientation).card *
        (anisoRadix α i : ℝ)) := by ring
    _ = boxMass α S.box * (2 ^ α.homogeneousDimension : ℝ) := by rw [hcard]

theorem boundaryFaceChildren_disjoint (α : Anisotropy) (i : Fin 3)
    (S T : OrientedFace α) (hne : S ≠ T) :
    Disjoint (boundaryFaceChildren α i S) (boundaryFaceChildren α i T) := by
  classical
  rw [Finset.disjoint_left]
  intro F hFS hFT
  rcases Finset.mem_image.mp hFS with ⟨v, hv, hvF⟩
  rcases Finset.mem_image.mp hFT with ⟨w, hw, hwF⟩
  have hEq : (⟨boxChild α S.box v, S.orientation⟩ : OrientedFace α) =
      ⟨boxChild α T.box w, T.orientation⟩ := hvF.trans hwF.symm
  have hChild' := congrArg (fun (F : OrientedFace α) => F.box) hEq
  change boxChild α S.box v = boxChild α T.box w at hChild'
  have hbox : S.box = T.box := by
    calc
      S.box = boxParent α (boxChild α S.box v) := (boxParent_child α S.box v).symm
      _ = boxParent α (boxChild α T.box w) := congrArg (boxParent α) hChild'
      _ = T.box := boxParent_child α T.box w
  have horient' := congrArg (fun (F : OrientedFace α) => F.orientation) hEq
  change S.orientation = T.orientation at horient'
  apply hne
  cases S
  cases T
  simp_all

noncomputable def boundaryFrontier (α : Anisotropy) (i : Fin 3) (q : AnisoBox α)
    (ε : FaceOrientation) : ℕ → Finset (OrientedFace α)
  | 0 => by classical exact {⟨q, ε⟩}
  | n + 1 => by
      classical
      exact (boundaryFrontier α i q ε n).biUnion (boundaryFaceChildren α i)

noncomputable def boundaryFrontierMass (α : Anisotropy) (i : Fin 3)
    (q : AnisoBox α) (ε : FaceOrientation) (n : ℕ) : ℝ :=
  ∑ S ∈ boundaryFrontier α i q ε n, boxMass α S.box

theorem boundaryFrontierMass_succ_mul_radix (α : Anisotropy) (i : Fin 3)
    (q : AnisoBox α) (ε : FaceOrientation) (n : ℕ) :
    boundaryFrontierMass α i q ε (n + 1) * (anisoRadix α i : ℝ) =
      boundaryFrontierMass α i q ε n := by
  classical
  unfold boundaryFrontierMass
  simp only [boundaryFrontier]
  have hdis : (↑(boundaryFrontier α i q ε n) : Set (OrientedFace α)).PairwiseDisjoint
      (boundaryFaceChildren α i) := by
    intro S hS T hT hne
    exact boundaryFaceChildren_disjoint α i S T hne
  rw [Finset.sum_biUnion hdis]
  rw [Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro S hS
  exact boundaryFaceChildren_mass_mul_radix α i S

theorem anisoRadix_two_le (α : Anisotropy) (i : Fin 3) :
    2 ≤ anisoRadix α i := by
  unfold anisoRadix
  calc
    2 = 2 ^ 1 := by norm_num
    _ ≤ 2 ^ α.weight i :=
      pow_le_pow_right₀ (by norm_num) (Nat.succ_le_iff.mpr (α.weight_pos i))

theorem boundaryFrontierMass_nonneg (α : Anisotropy) (i : Fin 3)
    (q : AnisoBox α) (ε : FaceOrientation) (n : ℕ) :
    0 ≤ boundaryFrontierMass α i q ε n := by
  unfold boundaryFrontierMass
  apply Finset.sum_nonneg
  intro S hS
  exact (boxMass_pos α S.box).le

theorem boundaryFrontierMass_succ_le_half (α : Anisotropy) (i : Fin 3)
    (q : AnisoBox α) (ε : FaceOrientation) (n : ℕ) :
    boundaryFrontierMass α i q ε (n + 1) ≤
      boundaryFrontierMass α i q ε n / 2 := by
  have hrec := boundaryFrontierMass_succ_mul_radix α i q ε n
  have hnonneg := boundaryFrontierMass_nonneg α i q ε (n + 1)
  have hRnat := anisoRadix_two_le α i
  have hR : (2 : ℝ) ≤ (anisoRadix α i : ℝ) := by exact_mod_cast hRnat
  nlinarith

theorem sum_range_le_two_of_half_contraction (M : ℕ → ℝ)
    (hM : ∀ n, 0 ≤ M n)
    (hstep : ∀ n, M (n + 1) ≤ M n / 2) (N : ℕ) :
    ∑ n ∈ Finset.range (N + 1), M n ≤ 2 * M 0 := by
  have haux : ∀ n : ℕ,
      (∑ j ∈ Finset.range (n + 1), M j) + 2 * M (n + 1) ≤ 2 * M 0 := by
    intro n
    induction n with
    | zero =>
      simp only [Finset.sum_range_succ, Finset.sum_range_zero]
      nlinarith [hstep 0]
    | succ n ih =>
      rw [Finset.sum_range_succ]
      have hs := hstep (n + 1)
      nlinarith
  have h := haux N
  nlinarith [hM (N + 1)]

theorem sum_boundaryFrontierMass_range_le_two (α : Anisotropy) (i : Fin 3)
    (q : AnisoBox α) (ε : FaceOrientation) (N : ℕ) :
    ∑ n ∈ Finset.range (N + 1), boundaryFrontierMass α i q ε n ≤
      2 * boxMass α q := by
  classical
  have h := sum_range_le_two_of_half_contraction
    (boundaryFrontierMass α i q ε)
    (boundaryFrontierMass_nonneg α i q ε)
    (boundaryFrontierMass_succ_le_half α i q ε) N
  simpa [boundaryFrontierMass, boundaryFrontier] using h

/-- Finite reindexing form of the source boundary-packing conclusion.  A
geometric charge sends every surviving face to a leaf or to the root, with a
bounded frontier depth; the three hypotheses below state exactly that the
charge is defined, that each fibre is dominated by its frontier, and that a
two-sided frontier has its geometric-series budget. -/
theorem facePackingMass_le_eight_of_charge
    {α : Anisotropy} (T : FiniteConvexTree α) (i : Fin 3) (N : ℕ)
    (charge : OrientedFace α → AnisoBox α × ℕ)
    (budget : AnisoBox α → ℕ → ℝ)
    (hmap : ∀ S ∈ survivingFacesAll T i,
      charge S ∈ (treeLeaves T ∪ {T.root}).product (Finset.range (N + 1)))
    (hbudget : ∀ L ∈ treeLeaves T ∪ {T.root}, ∀ n ∈ Finset.range (N + 1),
      (∑ S ∈ survivingFacesAll T i with charge S = (L, n), boxMass α S.box) ≤
        budget L n)
    (hhost : ∀ L ∈ treeLeaves T ∪ {T.root},
      (∑ n ∈ Finset.range (N + 1), budget L n) ≤ 4 * boxMass α L) :
    facePackingMass T i ≤ 8 * boxMass α T.root := by
  classical
  have hrootnot : T.root ∉ treeLeaves T := by
    intro hroot
    exact treeLeaves_not_mem T hroot T.root_mem
  have hdis : Disjoint (treeLeaves T) ({T.root} : Finset (AnisoBox α)) :=
    Finset.disjoint_singleton_right.mpr hrootnot
  calc
    facePackingMass T i =
        ∑ p ∈ (treeLeaves T ∪ {T.root}).product (Finset.range (N + 1)),
          ∑ S ∈ survivingFacesAll T i with charge S = p, boxMass α S.box := by
      unfold facePackingMass
      symm
      exact Finset.sum_fiberwise_of_maps_to hmap (fun S => boxMass α S.box)
    _ ≤ ∑ p ∈ (treeLeaves T ∪ {T.root}).product (Finset.range (N + 1)),
        budget p.1 p.2 := by
      apply Finset.sum_le_sum
      intro p hp
      rcases Finset.mem_product.mp hp with ⟨hpL, hpn⟩
      exact hbudget p.1 hpL p.2 hpn
    _ = ∑ L ∈ treeLeaves T ∪ {T.root},
        ∑ n ∈ Finset.range (N + 1), budget L n := by
      exact Finset.sum_product (treeLeaves T ∪ {T.root}) (Finset.range (N + 1))
        (fun p => budget p.1 p.2)
    _ ≤ ∑ L ∈ treeLeaves T ∪ {T.root}, 4 * boxMass α L := by
      apply Finset.sum_le_sum
      intro L hL
      exact hhost L hL
    _ = 8 * boxMass α T.root := by
      rw [Finset.sum_union hdis, Finset.sum_singleton]
      rw [← Finset.mul_sum]
      rw [← boxMass_root_eq_sum_boxMass_leaves T]
      ring

/-! ### Finite frontier realization of boundary packing

The preceding conditional reindexing theorem records the abstract finite
charge.  We now construct it concretely from the grid: a surviving face is
covered either by a root frontier or by the exterior frontier of a leaf.
-/

noncomputable def facePackingFrontierCover {α : Anisotropy}
    (T : FiniteConvexTree α) (i : Fin 3) (N : ℕ) : Finset (OrientedFace α) := by
  classical
  exact (Finset.range (N + 1)).biUnion fun n ↦
    (Finset.univ : Finset FaceOrientation).biUnion fun ε ↦
      boundaryFrontier α i T.root ε n ∪
        (treeLeaves T).biUnion fun L ↦
          boundaryFrontier α i (boxNeighbor α L i ε) ε.opposite n

theorem mem_facePackingFrontierCover_iff {α : Anisotropy}
    (T : FiniteConvexTree α) (i : Fin 3) (N : ℕ) (S : OrientedFace α) :
    S ∈ facePackingFrontierCover T i N ↔
      ∃ n ≤ N, ∃ ε : FaceOrientation,
        S ∈ boundaryFrontier α i T.root ε n ∨
          ∃ L ∈ treeLeaves T,
            S ∈ boundaryFrontier α i (boxNeighbor α L i ε) ε.opposite n := by
  classical
  simp [facePackingFrontierCover]

theorem boundaryLower_div (R n : ℤ) (hR : 0 < R) :
    (R * n + 0 - 1) / R = n - 1 := by
  have hRne : R ≠ 0 := ne_of_gt hR
  rw [show R * n + 0 - 1 = R * (n - 1) + (R - 1) by ring]
  rw [Int.mul_add_ediv_left _ (R - 1) hRne]
  rw [Int.ediv_eq_zero_of_lt]
  · ring
  · omega
  · omega

theorem boundaryUpper_div (R n : ℤ) (hR : 0 < R) :
    (R * n + (R - 1) + 1) / R = n + 1 := by
  have hRne : R ≠ 0 := ne_of_gt hR
  rw [show R * n + (R - 1) + 1 = R * (n + 1) by ring]
  exact Int.mul_ediv_cancel_left _ hRne

theorem boundaryLower_div_iff (R n d : ℤ) (hR : 0 < R)
    (hd0 : 0 ≤ d) (hdR : d < R) :
    (R * n + d - 1) / R = n - 1 ↔ d = 0 := by
  constructor
  · intro h
    by_contra hne
    have hd : 1 ≤ d := by omega
    have hquot : n ≤ (R * n + d - 1) / R := by
      rw [Int.le_ediv_iff_mul_le hR]
      nlinarith
    omega
  · intro h
    subst d
    exact boundaryLower_div R n hR

theorem boundaryUpper_div_iff (R n d : ℤ) (hR : 0 < R)
    (_hd0 : 0 ≤ d) (hdR : d < R) :
    (R * n + d + 1) / R = n + 1 ↔ d = R - 1 := by
  constructor
  · intro h
    by_contra hne
    have hd : d ≤ R - 2 := by omega
    have hquot : (R * n + d + 1) / R < n + 1 := by
      rw [Int.ediv_lt_iff_lt_mul hR]
      nlinarith
    omega
  · intro h
    rw [h]
    exact boundaryUpper_div R n hR

theorem test_boxParent_neighbor_child_eq_neighbor_iff (α : Anisotropy)
    (q : AnisoBox α) (i : Fin 3) (ε : FaceOrientation) (v : AnisoDigit α) :
    boxParent α (boxNeighbor α (boxChild α q v) i ε) =
      boxNeighbor α q i ε ↔ v i = boundaryDigit α i ε := by
  cases q with
  | mk level index =>
    cases ε with
    | lower =>
      constructor
      · intro h
        have hi := congrFun (congrArg AnisoBox.index h) i
        simp [boxParent, boxNeighbor, boxChild, FaceOrientation.sign] at hi
        have hR : (0 : ℤ) < (anisoRadix α i : ℤ) := by
          exact_mod_cast anisoRadix_pos α i
        have hd0 : (0 : ℤ) ≤ (v i : ℤ) := by
          exact_mod_cast Nat.zero_le (v i).val
        have hdR : (v i : ℤ) < (anisoRadix α i : ℤ) := by
          exact_mod_cast (v i).isLt
        have hz : (v i : ℤ) = 0 :=
          (boundaryLower_div_iff (anisoRadix α i : ℤ) (index i) (v i : ℤ)
            hR hd0 hdR).mp (by simpa [sub_eq_add_neg] using hi)
        apply Fin.ext
        have hzNat : (v i).val = 0 := by exact_mod_cast hz
        simpa [boundaryDigit] using hzNat
      · intro h
        have hvalNat : (v i).val = 0 := by
          have := congrArg Fin.val h
          simpa [boundaryDigit] using this
        have hval : (v i : ℤ) = 0 := by exact_mod_cast hvalNat
        simp only [boxParent, boxNeighbor, boxChild, AnisoBox.mk.injEq]
        constructor
        · omega
        · funext j
          by_cases hji : j = i
          · subst j
            simp only [if_pos]
            simpa [hval, FaceOrientation.sign, sub_eq_add_neg] using
              boundaryLower_div (anisoRadix α i : ℤ) (index i) (by
                exact_mod_cast anisoRadix_pos α i)
          · simp only [if_neg hji]
            rw [Int.mul_add_ediv_left]
            · rw [Int.ediv_eq_zero_of_lt]
              · simp
              · exact_mod_cast Nat.zero_le (v j).val
              · exact_mod_cast (v j).isLt
            · exact_mod_cast (Nat.ne_of_gt (anisoRadix_pos α j))
    | upper =>
      constructor
      · intro h
        have hi := congrFun (congrArg AnisoBox.index h) i
        simp [boxParent, boxNeighbor, boxChild, FaceOrientation.sign] at hi
        have hR : (0 : ℤ) < (anisoRadix α i : ℤ) := by
          exact_mod_cast anisoRadix_pos α i
        have hd0 : (0 : ℤ) ≤ (v i : ℤ) := by
          exact_mod_cast Nat.zero_le (v i).val
        have hdR : (v i : ℤ) < (anisoRadix α i : ℤ) := by
          exact_mod_cast (v i).isLt
        have hz : (v i : ℤ) = (anisoRadix α i : ℤ) - 1 :=
          (boundaryUpper_div_iff (anisoRadix α i : ℤ) (index i) (v i : ℤ)
            hR hd0 hdR).mp hi
        have hpred : ((anisoRadix α i).pred : ℤ) =
            (anisoRadix α i : ℤ) - 1 := by
          rw [Nat.pred_eq_sub_one]
          rw [Nat.cast_sub (Nat.succ_le_iff.mpr (anisoRadix_pos α i))]
          norm_num
        apply Fin.ext
        have hzNat : (v i).val = (anisoRadix α i).pred := by
          exact_mod_cast (hz.trans hpred.symm)
        simpa [boundaryDigit] using hzNat
      · intro h
        have hvalNat : (v i).val = (anisoRadix α i).pred := by
          have := congrArg Fin.val h
          simpa [boundaryDigit] using this
        have hpred : ((anisoRadix α i).pred : ℤ) =
            (anisoRadix α i : ℤ) - 1 := by
          rw [Nat.pred_eq_sub_one]
          rw [Nat.cast_sub (Nat.succ_le_iff.mpr (anisoRadix_pos α i))]
          norm_num
        have hval : (v i : ℤ) = (anisoRadix α i : ℤ) - 1 := by
          calc
            (v i : ℤ) = ((anisoRadix α i).pred : ℤ) := by
              exact_mod_cast hvalNat
            _ = (anisoRadix α i : ℤ) - 1 := hpred
        simp only [boxParent, boxNeighbor, boxChild, AnisoBox.mk.injEq]
        constructor
        · omega
        · funext j
          by_cases hji : j = i
          · subst j
            simp only [if_pos]
            simpa [hval, FaceOrientation.sign] using
              boundaryUpper_div (anisoRadix α i : ℤ) (index i) (by
                exact_mod_cast anisoRadix_pos α i)
          · simp only [if_neg hji]
            rw [Int.mul_add_ediv_left]
            · rw [Int.ediv_eq_zero_of_lt]
              · simp
              · exact_mod_cast Nat.zero_le (v j).val
              · exact_mod_cast (v j).isLt
            · exact_mod_cast (Nat.ne_of_gt (anisoRadix_pos α j))

theorem test_boxAncestor_parent (α : Anisotropy) (n : ℕ) (q : AnisoBox α) :
    boxAncestor α n (boxParent α q) = boxAncestor α (n + 1) q := by
  induction n with
  | zero => simp [boxAncestor]
  | succ n ih =>
    rw [boxAncestor_succ, boxAncestor_succ, ih]

theorem test_mem_boundaryFaceChildren_iff {α : Anisotropy} (i : Fin 3)
    (P S : OrientedFace α) :
    S ∈ boundaryFaceChildren α i P ↔
      ∃ v : AnisoDigit α, v i = boundaryDigit α i P.orientation ∧
        S = ⟨boxChild α P.box v, P.orientation⟩ := by
  classical
  rcases P with ⟨q, ε⟩
  unfold boundaryFaceChildren
  constructor
  · intro h
    rcases Finset.mem_image.mp h with ⟨v, hv, hvs⟩
    exact ⟨v, (Finset.mem_filter.mp hv).2, hvs.symm⟩
  · rintro ⟨v, hv, rfl⟩
    exact Finset.mem_image.mpr ⟨v,
      Finset.mem_filter.mpr ⟨Finset.mem_univ _, hv⟩, rfl⟩

theorem test_mem_boundaryFaceChildren_of_parent_neighbor
    {α : Anisotropy} (i : Fin 3) (P S : OrientedFace α)
    (horient : S.orientation = P.orientation)
    (hparent : boxParent α S.box = P.box)
    (hneighbor : boxParent α (boxNeighbor α S.box i S.orientation) =
      boxNeighbor α P.box i P.orientation) :
    S ∈ boundaryFaceChildren α i P := by
  classical
  rcases exists_boxChild_eq_of_boxParent_eq α P.box S.box hparent with ⟨v, hv⟩
  apply (test_mem_boundaryFaceChildren_iff i P S).mpr
  refine ⟨v, ?_, ?_⟩
  · apply (test_boxParent_neighbor_child_eq_neighbor_iff α P.box i P.orientation v).mp
    simpa [hv, horient] using hneighbor
  · cases P
    cases S
    simp_all

theorem test_mem_boundaryFrontier_of_ancestor
    {α : Anisotropy} (i : Fin 3) (q : AnisoBox α) (ε : FaceOrientation)
    (n : ℕ) (S : OrientedFace α)
    (horient : S.orientation = ε)
    (hbox : boxAncestor α n S.box = q)
    (hneighbor : boxAncestor α n (boxNeighbor α S.box i ε) =
      boxNeighbor α q i ε) :
    S ∈ boundaryFrontier α i q ε n := by
  induction n generalizing S with
  | zero =>
    have hbox' : S.box = q := by simpa [boxAncestor] using hbox
    have hS : S = ⟨q, ε⟩ := by
      cases S
      simp_all
    simp [boundaryFrontier, hS]
  | succ n ih =>
    have hparentneighbor :
        boxParent α (boxNeighbor α S.box i ε) =
          boxNeighbor α (boxParent α S.box) i ε := by
      rcases boxParent_neighbor_eq_or_neighbor α S.box i ε with hsame | hnext
      · exfalso
        have hEq : boxNeighbor α q i ε = q := by
          calc
            boxNeighbor α q i ε =
                boxAncestor α (n + 1) (boxNeighbor α S.box i ε) :=
                  hneighbor.symm
            _ = boxAncestor α n (boxParent α (boxNeighbor α S.box i ε)) :=
              (test_boxAncestor_parent α n
                (boxNeighbor α S.box i ε)).symm
            _ = boxAncestor α n (boxParent α S.box) :=
              congrArg (boxAncestor α n) hsame
            _ = boxAncestor α (n + 1) S.box :=
              test_boxAncestor_parent α n S.box
            _ = q := by simpa [Nat.succ_eq_add_one] using hbox
        exact boxNeighbor_ne_self α q i ε hEq
      · exact hnext
    let P : OrientedFace α := ⟨boxParent α S.box, ε⟩
    have hP : P ∈ boundaryFrontier α i q ε n := by
      apply ih P
      · simp [P]
      · change boxAncestor α n (boxParent α S.box) = q
        rw [test_boxAncestor_parent]
        simpa [Nat.succ_eq_add_one] using hbox
      · change boxAncestor α n
            (boxNeighbor α (boxParent α S.box) i ε) =
              boxNeighbor α q i ε
        rw [← hparentneighbor, test_boxAncestor_parent]
        simpa [Nat.succ_eq_add_one] using hneighbor
    simp only [boundaryFrontier]
    apply Finset.mem_biUnion.mpr
    refine ⟨P, hP, ?_⟩
    apply test_mem_boundaryFaceChildren_of_parent_neighbor i P S
    · simp [P, horient]
    · simp [P]
    · simpa [P, horient] using hparentneighbor

theorem test_boxAncestor_neighbor_eq_neighbor_of_not_subset
    (α : Anisotropy) (n : ℕ) (q L : AnisoBox α) (i : Fin 3)
    (ε : FaceOrientation)
    (hL : boxAncestor α n q = L)
    (hnot : ¬ boxSet α (boxNeighbor α q i ε) ⊆ boxSet α L) :
    boxAncestor α n (boxNeighbor α q i ε) = boxNeighbor α L i ε := by
  rcases boxAncestor_neighbor_eq_or_neighbor α n q i ε with hsame | hneighbor
  · exfalso
    apply hnot
    calc
      boxSet α (boxNeighbor α q i ε) ⊆
          boxSet α (boxAncestor α n (boxNeighbor α q i ε)) :=
        boxAncestor_subset α n _
      _ = boxSet α (boxAncestor α n q) := by rw [hsame]
      _ = boxSet α L := by rw [hL]
  · simpa only [hL] using hneighbor

theorem test_survivingFace_mem_rootFrontier
    {α : Anisotropy} (T : FiniteConvexTree α) (i : Fin 3)
    (S : OrientedFace α) (hS : S ∈ survivingFacesAll T i)
    (hout : ¬ boxSet α (boxNeighbor α S.box i S.orientation) ⊆
      boxSet α T.root) :
    S ∈ boundaryFrontier α i T.root S.orientation
      (T.root.level - S.box.level).toNat := by
  have hbox : S.box ∈ T.boxes := (mem_survivingFacesAll_iff T i S).mp hS |>.1
  have hsub : boxSet α S.box ⊆ boxSet α T.root := T.below_root S.box hbox
  have hancestor :
      boxAncestor α (T.root.level - S.box.level).toNat S.box = T.root :=
    boxAncestor_eq_of_boxSet_subset α hsub
  apply test_mem_boundaryFrontier_of_ancestor i T.root S.orientation
  · rfl
  · exact hancestor
  · exact test_boxAncestor_neighbor_eq_neighbor_of_not_subset α
      (T.root.level - S.box.level).toNat S.box T.root i S.orientation
      hancestor hout

theorem test_survivingFace_mem_leafExteriorFrontier
    {α : Anisotropy} (T : FiniteConvexTree α) (i : Fin 3)
    (S : OrientedFace α) (hS : S ∈ survivingFacesAll T i)
    (hout : boxSet α (boxNeighbor α S.box i S.orientation) ⊆
      boxSet α T.root) :
    ∃ L ∈ treeLeaves T,
      S ∈ boundaryFrontier α i
        (boxNeighbor α L i S.orientation.opposite) S.orientation
        (L.level - S.box.level).toNat := by
  let qout : AnisoBox α := boxNeighbor α S.box i S.orientation
  have hSbox : S.box ∈ T.boxes :=
    (mem_survivingFacesAll_iff T i S).mp hS |>.1
  have hqoutnot : qout ∉ T.boxes := by
    simpa [qout] using (mem_survivingFacesAll_iff T i S).mp hS |>.2
  rcases exists_leaf_container_of_boxSet_subset_root T qout (by simpa [qout] using hout)
      hqoutnot with ⟨L, hL, hqoutL, hqoutlevel⟩
  refine ⟨L, hL, ?_⟩
  have hinside : ¬ boxSet α S.box ⊆ boxSet α L := by
    intro hinside
    have hLtree : L ∈ T.boxes :=
      T.convex hSbox (treeLeaves_parent_mem T hL)
        hinside (boxSet_subset_parent α L)
    exact treeLeaves_not_mem T hL hLtree
  have hancestorout :
      boxAncestor α (L.level - qout.level).toNat qout = L :=
    boxAncestor_eq_of_boxSet_subset α hqoutL
  have hnot : ¬ boxSet α
      (boxNeighbor α qout i S.orientation.opposite) ⊆ boxSet α L := by
    simpa [qout, boxNeighbor_neighbor_opposite] using hinside
  have hancestorinside :
      boxAncestor α (L.level - qout.level).toNat S.box =
        boxNeighbor α L i S.orientation.opposite := by
    have h := test_boxAncestor_neighbor_eq_neighbor_of_not_subset α
      (L.level - qout.level).toNat qout L i S.orientation.opposite
      hancestorout hnot
    simpa [qout, boxNeighbor_neighbor_opposite] using h
  have hfront := test_mem_boundaryFrontier_of_ancestor i
    (boxNeighbor α L i S.orientation.opposite) S.orientation
    (L.level - qout.level).toNat S rfl hancestorinside (by
      have hinverse : boxNeighbor α
          (boxNeighbor α L i S.orientation.opposite) i S.orientation = L := by
        cases S.orientation <;>
          exact boxNeighbor_neighbor_opposite α L i _
      rw [hinverse]
      simpa [qout] using hancestorout)
  simpa [qout, boxNeighbor_level] using hfront

noncomputable def facePackingDepth {α : Anisotropy}
    (T : FiniteConvexTree α) (i : Fin 3) : ℕ :=
  ∑ S ∈ survivingFacesAll T i, (T.root.level - S.box.level).toNat

theorem test_facePackingDepth_bound {α : Anisotropy}
    (T : FiniteConvexTree α) (i : Fin 3) (S : OrientedFace α)
    (hS : S ∈ survivingFacesAll T i) :
    (T.root.level - S.box.level).toNat ≤ facePackingDepth T i := by
  unfold facePackingDepth
  exact Finset.single_le_sum
    (f := fun S ↦ (T.root.level - S.box.level).toNat)
    (fun _ _ ↦ Nat.zero_le _) hS

theorem test_leaf_depth_le_facePackingDepth {α : Anisotropy}
    (T : FiniteConvexTree α) (i : Fin 3) (S : OrientedFace α)
    (hS : S ∈ survivingFacesAll T i) (L : AnisoBox α)
    (hL : L ∈ treeLeaves T) :
    (L.level - S.box.level).toNat ≤ facePackingDepth T i := by
  apply le_trans (Int.toNat_le_toNat ?_) (test_facePackingDepth_bound T i S hS)
  have hLlevel : L.level ≤ T.root.level :=
    level_le_of_boxSet_subset α (boxSet_leaf_subset_root T hL)
  omega

theorem test_survivingFacesAll_subset_facePackingFrontierCover
    {α : Anisotropy} (T : FiniteConvexTree α) (i : Fin 3) :
    survivingFacesAll T i ⊆
      facePackingFrontierCover T i (facePackingDepth T i) := by
  intro S hS
  by_cases hout : boxSet α (boxNeighbor α S.box i S.orientation) ⊆
      boxSet α T.root
  · rcases test_survivingFace_mem_leafExteriorFrontier T i S hS hout with
        ⟨L, hL, hfront⟩
    apply (mem_facePackingFrontierCover_iff T i (facePackingDepth T i) S).mpr
    refine ⟨(L.level - S.box.level).toNat,
      test_leaf_depth_le_facePackingDepth T i S hS L hL,
      S.orientation.opposite, ?_⟩
    right
    refine ⟨L, hL, ?_⟩
    simpa only [FaceOrientation.opposite_opposite] using hfront
  · apply (mem_facePackingFrontierCover_iff T i (facePackingDepth T i) S).mpr
    refine ⟨(T.root.level - S.box.level).toNat,
      test_facePackingDepth_bound T i S hS, S.orientation, ?_⟩
    left
    exact test_survivingFace_mem_rootFrontier T i S hS hout

theorem test_sum_union_le_of_nonneg {β : Type*} [DecidableEq β]
    (w : β → ℝ) (s t : Finset β) (hw : ∀ x, 0 ≤ w x) :
    (∑ x ∈ s ∪ t, w x) ≤ (∑ x ∈ s, w x) + ∑ x ∈ t, w x := by
  rw [← Finset.sum_union_inter]
  exact le_add_of_nonneg_right (Finset.sum_nonneg fun x _ ↦ hw x)

theorem test_sum_biUnion_le_of_nonneg {β γ : Type*} [DecidableEq β]
    [DecidableEq γ] (w : β → ℝ) (s : Finset γ) (t : γ → Finset β)
    (hw : ∀ x, 0 ≤ w x) :
    (∑ x ∈ s.biUnion t, w x) ≤ ∑ a ∈ s, ∑ x ∈ t a, w x := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
    rw [Finset.biUnion_insert]
    calc
      (∑ x ∈ t a ∪ s.biUnion t, w x) ≤
          (∑ x ∈ t a, w x) + ∑ x ∈ s.biUnion t, w x :=
        test_sum_union_le_of_nonneg w (t a) (s.biUnion t) hw
      _ ≤ (∑ x ∈ t a, w x) + ∑ b ∈ s, ∑ x ∈ t b, w x :=
        add_le_add_right ih _
      _ = ∑ b ∈ insert a s, ∑ x ∈ t b, w x := by
        rw [Finset.sum_insert ha]

theorem test_faceOrientation_univ :
    (Finset.univ : Finset FaceOrientation) =
      {FaceOrientation.lower, FaceOrientation.upper} := by
  ext ε
  cases ε <;> simp

theorem test_rootFrontierBudget_le_four (α : Anisotropy) (i : Fin 3)
    (q : AnisoBox α) (N : ℕ) :
    (∑ ε : FaceOrientation, ∑ n ∈ Finset.range (N + 1),
      boundaryFrontierMass α i q ε n) ≤ 4 * boxMass α q := by
  have hlower := sum_boundaryFrontierMass_range_le_two α i q FaceOrientation.lower N
  have hupper := sum_boundaryFrontierMass_range_le_two α i q FaceOrientation.upper N
  rw [test_faceOrientation_univ]
  rw [Finset.sum_insert (by decide)]
  simp
  nlinarith

theorem test_leafExteriorFrontierBudget_le_four (α : Anisotropy) (i : Fin 3)
    (L : AnisoBox α) (N : ℕ) :
    (∑ ε : FaceOrientation, ∑ n ∈ Finset.range (N + 1),
      boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n) ≤
      4 * boxMass α L := by
  have hlower := sum_boundaryFrontierMass_range_le_two α i
    (boxNeighbor α L i FaceOrientation.lower) FaceOrientation.upper N
  have hupper := sum_boundaryFrontierMass_range_le_two α i
    (boxNeighbor α L i FaceOrientation.upper) FaceOrientation.lower N
  rw [test_faceOrientation_univ]
  rw [Finset.sum_insert (by decide)]
  simp only [Finset.sum_singleton, FaceOrientation.opposite]
  change _ ≤ 2 * boxMass α L at hlower
  change _ ≤ 2 * boxMass α L at hupper
  nlinarith

theorem test_facePackingFrontierCover_mass_le
    {α : Anisotropy} (T : FiniteConvexTree α) (i : Fin 3) (N : ℕ) :
    (∑ S ∈ facePackingFrontierCover T i N, boxMass α S.box) ≤
      ∑ n ∈ Finset.range (N + 1), ∑ ε : FaceOrientation,
        (boundaryFrontierMass α i T.root ε n +
          ∑ L ∈ treeLeaves T,
            boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n) := by
  classical
  unfold facePackingFrontierCover
  calc
    (∑ S ∈ (Finset.range (N + 1)).biUnion (fun n ↦
        (Finset.univ : Finset FaceOrientation).biUnion (fun ε ↦
          boundaryFrontier α i T.root ε n ∪
            (treeLeaves T).biUnion (fun L ↦
              boundaryFrontier α i (boxNeighbor α L i ε) ε.opposite n))),
        boxMass α S.box) ≤
        ∑ n ∈ Finset.range (N + 1),
          ∑ S ∈ (Finset.univ : Finset FaceOrientation).biUnion (fun ε ↦
            boundaryFrontier α i T.root ε n ∪
              (treeLeaves T).biUnion (fun L ↦
                boundaryFrontier α i (boxNeighbor α L i ε) ε.opposite n)),
            boxMass α S.box := by
      apply test_sum_biUnion_le_of_nonneg
      intro S
      exact (boxMass_pos α S.box).le
    _ ≤ ∑ n ∈ Finset.range (N + 1), ∑ ε : FaceOrientation,
        (boundaryFrontierMass α i T.root ε n +
          ∑ L ∈ treeLeaves T,
            boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n) := by
      apply Finset.sum_le_sum
      intro n hn
      calc
        (∑ S ∈ (Finset.univ : Finset FaceOrientation).biUnion (fun ε ↦
            boundaryFrontier α i T.root ε n ∪
              (treeLeaves T).biUnion (fun L ↦
                boundaryFrontier α i (boxNeighbor α L i ε) ε.opposite n)),
            boxMass α S.box) ≤
            ∑ ε : FaceOrientation,
              ∑ S ∈ boundaryFrontier α i T.root ε n ∪
                (treeLeaves T).biUnion (fun L ↦
                  boundaryFrontier α i (boxNeighbor α L i ε) ε.opposite n),
                boxMass α S.box := by
          apply test_sum_biUnion_le_of_nonneg
          intro S
          exact (boxMass_pos α S.box).le
        _ ≤ ∑ ε : FaceOrientation,
            (boundaryFrontierMass α i T.root ε n +
              ∑ L ∈ treeLeaves T,
                boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n) := by
          apply Finset.sum_le_sum
          intro ε hε
          calc
            (∑ S ∈ boundaryFrontier α i T.root ε n ∪
                (treeLeaves T).biUnion (fun L ↦
                  boundaryFrontier α i (boxNeighbor α L i ε) ε.opposite n),
                boxMass α S.box) ≤
                (∑ S ∈ boundaryFrontier α i T.root ε n, boxMass α S.box) +
                  ∑ S ∈ (treeLeaves T).biUnion (fun L ↦
                    boundaryFrontier α i (boxNeighbor α L i ε) ε.opposite n),
                    boxMass α S.box :=
              test_sum_union_le_of_nonneg _ _ _ (fun S ↦ (boxMass_pos α S.box).le)
            _ ≤ (∑ S ∈ boundaryFrontier α i T.root ε n, boxMass α S.box) +
                  ∑ L ∈ treeLeaves T,
                    ∑ S ∈ boundaryFrontier α i (boxNeighbor α L i ε) ε.opposite n,
                      boxMass α S.box := by
              apply add_le_add_right
              apply test_sum_biUnion_le_of_nonneg
              intro S
              exact (boxMass_pos α S.box).le
            _ = boundaryFrontierMass α i T.root ε n +
                  ∑ L ∈ treeLeaves T,
                    boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n := by
              rfl

theorem test_frontierBudget_le_eight
    {α : Anisotropy} (T : FiniteConvexTree α) (i : Fin 3) (N : ℕ) :
    (∑ n ∈ Finset.range (N + 1), ∑ ε : FaceOrientation,
      (boundaryFrontierMass α i T.root ε n +
        ∑ L ∈ treeLeaves T,
          boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n)) ≤
      8 * boxMass α T.root := by
  have hrootorder :
      (∑ n ∈ Finset.range (N + 1), ∑ ε : FaceOrientation,
        boundaryFrontierMass α i T.root ε n) =
        ∑ ε : FaceOrientation, ∑ n ∈ Finset.range (N + 1),
          boundaryFrontierMass α i T.root ε n := by
    exact Finset.sum_comm
  have hleaforder :
      (∑ n ∈ Finset.range (N + 1), ∑ ε : FaceOrientation,
        ∑ L ∈ treeLeaves T,
          boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n) =
        ∑ L ∈ treeLeaves T, ∑ ε : FaceOrientation,
          ∑ n ∈ Finset.range (N + 1),
            boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n := by
    calc
      (∑ n ∈ Finset.range (N + 1), ∑ ε : FaceOrientation,
        ∑ L ∈ treeLeaves T,
          boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n) =
          ∑ ε : FaceOrientation, ∑ n ∈ Finset.range (N + 1),
            ∑ L ∈ treeLeaves T,
              boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n :=
        Finset.sum_comm
      _ = ∑ ε : FaceOrientation, ∑ L ∈ treeLeaves T,
            ∑ n ∈ Finset.range (N + 1),
              boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n := by
        apply Finset.sum_congr rfl
        intro ε hε
        exact Finset.sum_comm
      _ = ∑ L ∈ treeLeaves T, ∑ ε : FaceOrientation,
            ∑ n ∈ Finset.range (N + 1),
              boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n :=
        Finset.sum_comm
  calc
    (∑ n ∈ Finset.range (N + 1), ∑ ε : FaceOrientation,
      (boundaryFrontierMass α i T.root ε n +
        ∑ L ∈ treeLeaves T,
          boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n)) =
        (∑ ε : FaceOrientation, ∑ n ∈ Finset.range (N + 1),
          boundaryFrontierMass α i T.root ε n) +
        ∑ L ∈ treeLeaves T, ∑ ε : FaceOrientation,
          ∑ n ∈ Finset.range (N + 1),
            boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n := by
      simp_rw [Finset.sum_add_distrib]
      rw [hrootorder, hleaforder]
    _ ≤ 4 * boxMass α T.root +
        ∑ L ∈ treeLeaves T, 4 * boxMass α L := by
      apply add_le_add
      · exact test_rootFrontierBudget_le_four α i T.root N
      · apply Finset.sum_le_sum
        intro L hL
        exact test_leafExteriorFrontierBudget_le_four α i L N
    _ = 8 * boxMass α T.root := by
      rw [← Finset.mul_sum]
      rw [← boxMass_root_eq_sum_boxMass_leaves T]
      ring

theorem facePackingMass_le_eight
    {α : Anisotropy} (T : FiniteConvexTree α) (i : Fin 3) :
    facePackingMass T i ≤ 8 * boxMass α T.root := by
  classical
  calc
    facePackingMass T i = ∑ S ∈ survivingFacesAll T i, boxMass α S.box := rfl
    _ ≤ ∑ S ∈ facePackingFrontierCover T i (facePackingDepth T i),
          boxMass α S.box := by
      apply Finset.sum_le_sum_of_subset_of_nonneg
        (test_survivingFacesAll_subset_facePackingFrontierCover T i)
      intro S hS hnot
      exact (boxMass_pos α S.box).le
    _ ≤ ∑ n ∈ Finset.range (facePackingDepth T i + 1),
          ∑ ε : FaceOrientation,
            (boundaryFrontierMass α i T.root ε n +
              ∑ L ∈ treeLeaves T,
                boundaryFrontierMass α i (boxNeighbor α L i ε) ε.opposite n) :=
      test_facePackingFrontierCover_mass_le T i (facePackingDepth T i)
    _ ≤ 8 * boxMass α T.root :=
      test_frontierBudget_le_eight T i (facePackingDepth T i)

/-! ### Local cubical forms and coordinate copies

These definitions are the literal signed local forms from Section 4 of the
blueprint.  They are kept separate from the positive bracket-kernel averages
above: the latter supply local sizes, while these forms carry the Gaussian
telescoping identity. -/

/-- The two large Gaussian widths and the one unscaled width in the local
cube form. -/
def cubeWidth (i : Fin 3) (lam : ℝ) : ℝ :=
  if i = 0 ∨ i = 1 then lam else 1

/-- The translated third-coordinate center shift in the local cube form. -/
def cubeCenterShift (i : Fin 3) (r : ℝ) : ℝ :=
  if i = 2 then r else 0

/-- The source range `λ ≥ 1` makes every Gaussian width strictly positive. -/
theorem cubeWidth_pos_of_one_le (i : Fin 3) {lam : ℝ} (hlam : 1 ≤ lam) :
    0 < cubeWidth i lam := by
  unfold cubeWidth
  split_ifs with hi
  · linarith
  · positivity

theorem cubeGaussianScale_pos (α : Anisotropy) (i : Fin 3)
    {lam t : ℝ} (hlam : 1 ≤ lam) (ht : 0 < t) :
    0 < cubeWidth i lam * t ^ α.weight i := by
  exact mul_pos (cubeWidth_pos_of_one_le i hlam) (pow_pos ht _)

theorem cubeGaussianScale_ne_zero (α : Anisotropy) (i : Fin 3)
    {lam t : ℝ} (hlam : 1 ≤ lam) (ht : 0 < t) :
    cubeWidth i lam * t ^ α.weight i ≠ 0 :=
  (cubeGaussianScale_pos α i hlam ht).ne'

/-- Replace one center coordinate while retaining the ambient Euclidean
representation.  This packages the one-dimensional center variable used in
the scalar divergence identity. -/
noncomputable def cubeCenterReplace (p : E3) (i : Fin 3) (a : ℝ) : E3 :=
  WithLp.toLp 2 (Function.update (WithLp.ofLp p) i a)

@[simp]
theorem cubeCenterReplace_apply_same (p : E3) (i : Fin 3) (a : ℝ) :
    cubeCenterReplace p i a i = a := by
  simp [cubeCenterReplace]

theorem cubeCenterReplace_apply_ne (p : E3) (i j : Fin 3) (a : ℝ)
    (hji : j ≠ i) :
    cubeCenterReplace p i a j = p j := by
  simp [cubeCenterReplace, hji]

theorem cubeCenterReplace_replace (p : E3) (i : Fin 3) (q r : ℝ) :
    cubeCenterReplace (cubeCenterReplace p i q) i r =
      cubeCenterReplace p i r := by
  ext j
  by_cases hji : j = i
  · subst j
    simp
  · simp [cubeCenterReplace, hji]

/-- The source kernel `G_i` at a fixed center and scale. -/
def cubeGaussianKernel (α : Anisotropy) (lam r t : ℝ) (p : E3)
    (i : Fin 3) : ℝ → ℝ :=
  gaussianAt (cubeWidth i lam * t ^ α.weight i)
    (p i + cubeCenterShift i r * t ^ α.weight i)

/-- The source kernel `H_i` at a fixed center and scale. -/
def cubeGaussianDerivKernel (α : Anisotropy) (lam r t : ℝ) (p : E3)
    (i : Fin 3) : ℝ → ℝ :=
  gaussianDerivAt (cubeWidth i lam * t ^ α.weight i)
    (p i + cubeCenterShift i r * t ^ α.weight i)

/-- The six-variable local kernel with the derivative pair in coordinate
`i`, as in `eq:cubeform`. -/
def localCubeKernel (α : Anisotropy) (i : Fin 3)
    (lam r t : ℝ) (p : E3) (x : E6) : ℝ :=
  ∏ q : Fin 3 × Bool,
    if q.1 = i then
      cubeGaussianDerivKernel α lam r t p q.1 (x q)
    else
      cubeGaussianKernel α lam r t p q.1 (x q)

/-- The one-dimensional density `1_{t>0}dt/t` used for the scale variable. -/
noncomputable def cubeScaleDensity (t : ℝ) : ℝ≥0∞ :=
  if 0 < t then ENNReal.ofReal t⁻¹ else 0

theorem measurable_cubeScaleDensity : Measurable cubeScaleDensity := by
  unfold cubeScaleDensity
  exact Measurable.ite measurableSet_Ioi
    (measurable_id.inv.ennreal_ofReal) measurable_const

@[simp]
theorem cubeScaleDensity_eq_of_pos {t : ℝ} (ht : 0 < t) :
    cubeScaleDensity t = ENNReal.ofReal t⁻¹ := by
  simp [cubeScaleDensity, ht]

/-- The center--scale measure `dp dt/t` on the positive scale half-space,
written as a product measure so that its Fubini decomposition is literal. -/
noncomputable def cubeScaleMeasure : Measure (E3 × ℝ) :=
  (volume : Measure E3).prod ((volume : Measure ℝ).withDensity cubeScaleDensity)

/-- The factorized definition agrees with the density-on-product presentation
used in the source notation. -/
theorem cubeScaleMeasure_eq_withDensity :
    cubeScaleMeasure = (volume : Measure (E3 × ℝ)).withDensity
      (fun z ↦ cubeScaleDensity z.2) := by
  unfold cubeScaleMeasure
  rw [prod_withDensity_right measurable_cubeScaleDensity,
    ← Measure.volume_eq_prod]

/-- On one source box--scale cell, the center--scale measure is exactly the
product of the restricted center measure and the restricted logarithmic scale
measure.  This is the Fubini measure identity used below. -/
theorem cubeScaleMeasure_restrict_boxScaleRegion (α : Anisotropy)
    (q : AnisoBox α) :
    cubeScaleMeasure.restrict (boxScaleRegion α q) =
      (volume.restrict (boxSet α q)).prod
        ((volume.withDensity cubeScaleDensity).restrict (boxScaleBand q)) := by
  unfold cubeScaleMeasure boxScaleRegion
  rw [← Measure.prod_restrict]

/-- On a positive box-scale band, integration against the scale density is
the source's logarithmic interval integral. -/
theorem integral_boxScaleBand_withDensity_eq_intervalIntegral
    (q : AnisoBox α) (f : ℝ → ℝ) :
    ∫ t in boxScaleBand q, f t ∂(volume.withDensity cubeScaleDensity) =
      ∫ t in boxLength q / 2..boxLength q, f t / t := by
  have htop : ∀ᵐ t ∂(volume.restrict (boxScaleBand q)), cubeScaleDensity t < ∞ := by
    filter_upwards [] with t
    by_cases ht : 0 < t
    · simp [cubeScaleDensity, ht]
    · simp [cubeScaleDensity, ht]
  rw [setIntegral_withDensity_eq_setIntegral_toReal_smul
    measurable_cubeScaleDensity htop f measurableSet_Ioc]
  unfold boxScaleBand
  have hle : boxLength q / 2 ≤ boxLength q :=
    div_le_self (boxLength_pos q).le (by norm_num)
  calc
    ∫ t in Set.Ioc (boxLength q / 2) (boxLength q),
        (cubeScaleDensity t).toReal • f t =
        ∫ t in Set.Ioc (boxLength q / 2) (boxLength q), f t / t := by
      apply setIntegral_congr_fun measurableSet_Ioc
      intro t ht
      have htpos : 0 < t := by
        exact lt_trans
          (div_pos (boxLength_pos q) (by norm_num : (0 : ℝ) < 2)) ht.1
      change (cubeScaleDensity t).toReal * f t = f t / t
      rw [cubeScaleDensity_eq_of_pos htpos,
        ENNReal.toReal_ofReal (inv_pos.2 htpos).le]
      rw [div_eq_mul_inv]
      ring
    _ = ∫ t in boxLength q / 2..boxLength q, f t / t :=
      (intervalIntegral.integral_of_le hle).symm

/-- A continuous scalar scale integrand is integrable on every positive source
scale band for the logarithmic scale measure. -/
theorem integrableOn_boxScaleBand_of_continuous
    (q : AnisoBox α) (f : ℝ → ℝ) (hf : Continuous f) :
    IntegrableOn f (boxScaleBand q) (volume.withDensity cubeScaleDensity) := by
  have htop : ∀ᵐ t ∂(volume.restrict (boxScaleBand q)), cubeScaleDensity t < ∞ := by
    filter_upwards [] with t
    by_cases ht : 0 < t
    · simp [cubeScaleDensity, ht]
    · simp [cubeScaleDensity, ht]
  unfold IntegrableOn
  unfold boxScaleBand at htop ⊢
  rw [restrict_withDensity measurableSet_Ioc]
  rw [integrable_withDensity_iff measurable_cubeScaleDensity htop]
  have heq : (fun t : ℝ ↦ f t * (cubeScaleDensity t).toReal) =ᵐ[
      volume.restrict (Set.Ioc (boxLength q / 2) (boxLength q))]
      (fun t ↦ f t / t) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    have htpos : 0 < t := by
      exact lt_trans
        (div_pos (boxLength_pos q) (by norm_num : (0 : ℝ) < 2)) ht.1
    rw [cubeScaleDensity_eq_of_pos htpos,
      ENNReal.toReal_ofReal (inv_pos.2 htpos).le]
    ring
  rw [integrable_congr heq]
  let a : ℝ := boxLength q / 2
  let b : ℝ := boxLength q
  have hapos : 0 < a := by
    dsimp [a]
    exact div_pos (boxLength_pos q) (by norm_num)
  have hcont : ContinuousOn (fun t : ℝ ↦ f t / t) (Set.Icc a b) :=
    hf.continuousOn.div continuousOn_id
      (fun t ht ↦ ne_of_gt (lt_of_lt_of_le hapos ht.1))
  exact (hcont.integrableOn_compact isCompact_Icc).mono_set Set.Ioc_subset_Icc_self

/-- The local cubical form `Θ^{(i)}_{𝒬,λ,r}` over a finite collection. -/
noncomputable def localCubeForm (α : Anisotropy) (S : BoxCollection α)
    (i : Fin 3) (lam r : ℝ) (F : CubeVertex → E3 → ℝ) : ℝ :=
  ∫ z : E3 × ℝ,
    (∫ x : E6,
      cubeSignedInputProduct F x * localCubeKernel α i lam r z.2 z.1 x
    ) ∂(cubeScaleMeasure.restrict (collectionRegion α S))

/-- A singleton collection has precisely its one literal box-scale cell. -/
theorem collectionRegion_singleton
    (α : Anisotropy) (q : AnisoBox α) :
    collectionRegion α ({q} : BoxCollection α) = boxScaleRegion α q := by
  ext z
  simp [collectionRegion]

/-- Under the source local-integrability condition, a finite local cube form
is the sum of its literal one-box forms. -/
theorem localCubeForm_collection_eq_sum_singletons_of_integrable
    (α : Anisotropy) (S : BoxCollection α) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ)
    (h : IntegrableOn (fun z : E3 × ℝ ↦
      ∫ x : E6, cubeSignedInputProduct F x *
        localCubeKernel α i lam r z.2 z.1 x)
      (collectionRegion α S) cubeScaleMeasure) :
    localCubeForm α S i lam r F =
      ∑ q ∈ S, localCubeForm α ({q} : BoxCollection α) i lam r F := by
  unfold localCubeForm
  simp_rw [collectionRegion_singleton]
  unfold collectionRegion
  apply MeasureTheory.integral_biUnion_finset
  · intro q hq
    exact measurableSet_boxScaleRegion α q
  · exact pairwiseDisjoint_boxScaleRegion α S
  · intro q hq
    apply h.mono_set
    intro z hz
    exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hq, hz⟩⟩

/-- The pair `D_i=G_i(x_i^0)G_i(x_i^1)` from the endpoint and boundary
forms in Section 4. -/
def cubeCoordinateD (α : Anisotropy) (i : Fin 3)
    (lam r t : ℝ) (p : E3) (x : E6) : ℝ :=
  cubeGaussianKernel α lam r t p i (x (i, false)) *
    cubeGaussianKernel α lam r t p i (x (i, true))

/-- The pair `P_i=H_i(x_i^0)H_i(x_i^1)` in the source notation. -/
def cubeCoordinateP (α : Anisotropy) (i : Fin 3)
    (lam r t : ℝ) (p : E3) (x : E6) : ℝ :=
  cubeGaussianDerivKernel α lam r t p i (x (i, false)) *
    cubeGaussianDerivKernel α lam r t p i (x (i, true))

/-- The boundary factor
`E_i=μ_i W_i/(2π)-s_iD_i`, retaining the source's different third
coordinate translation term. -/
def cubeBoundaryKernel (α : Anisotropy) (i : Fin 3)
    (lam r t : ℝ) (p : E3) (x : E6) : ℝ :=
  cubeWidth i lam / (2 * Real.pi) *
      (cubeGaussianDerivKernel α lam r t p i (x (i, false)) *
          cubeGaussianKernel α lam r t p i (x (i, true)) +
        cubeGaussianKernel α lam r t p i (x (i, false)) *
          cubeGaussianDerivKernel α lam r t p i (x (i, true))) -
    cubeCenterShift i r * cubeCoordinateD α i lam r t p x

/-- The positive endpoint product `K_{t,p}`. -/
def cubeEndpointKernel (α : Anisotropy) (lam r t : ℝ) (p : E3)
    (x : E6) : ℝ :=
  ∏ i : Fin 3, cubeCoordinateD α i lam r t p x

/-- The integrand attached to an oriented coordinate face. -/
def cubeFaceKernel (α : Anisotropy) (i : Fin 3)
    (lam r t : ℝ) (p : E3) (x : E6) : ℝ :=
  cubeBoundaryKernel α i lam r t p x *
    ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x

/-- The source face integral `𝒥_{i,S}(t;F)`, using the literal transverse
coordinate Lebesgue measure built earlier for oriented faces. -/
noncomputable def cubeFaceIntegral (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) (lam r t : ℝ) (F : CubeVertex → E3 → ℝ) : ℝ :=
  ∫ y : TransverseSpace i in transverseRectangle α S.box i,
    ∫ x : E6,
      cubeSignedInputProduct F x *
        cubeFaceKernel α i lam r t
          (faceInsert i (boxFaceCoordinate α S.box i S.orientation) y) x

/-- The endpoint form `Ξ_𝒬` for a finite box collection. -/
noncomputable def cubeEndpointForm (α : Anisotropy) (S : BoxCollection α)
    (lam r : ℝ) (F : CubeVertex → E3 → ℝ) : ℝ :=
  Real.pi * ∑ q ∈ S,
    ∫ p : E3 in boxSet α q,
      ∫ x : E6,
          cubeSignedInputProduct F x *
          cubeEndpointKernel α lam r (boxLength q) p x

/-- The finite endpoint reindexing in the tree telescope.  It is separated
from the analytic single-box scale identity: the equality is only the exact
children/boxes/leaves bookkeeping of a finite convex tree. -/
theorem cubeEndpointForm_tree_children_sub_tree_boxes
    (α : Anisotropy) (T : FiniteConvexTree α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) :
    cubeEndpointForm α (treeChildrenAll T) lam r F -
        cubeEndpointForm α T.boxes lam r F =
      cubeEndpointForm α (treeLeaves T) lam r F -
        cubeEndpointForm α {T.root} lam r F := by
  let w : AnisoBox α → ℝ := fun q ↦
    ∫ p : E3 in boxSet α q,
      ∫ x : E6,
        cubeSignedInputProduct F x *
          cubeEndpointKernel α lam r (boxLength q) p x
  have hsum := sum_treeChildrenAll_sub_sum_treeBoxes (T := T) w
  change Real.pi * (∑ q ∈ treeChildrenAll T, w q) -
      Real.pi * (∑ q ∈ T.boxes, w q) =
    Real.pi * (∑ q ∈ treeLeaves T, w q) -
      Real.pi * (∑ q ∈ ({T.root} : Finset (AnisoBox α)), w q)
  rw [← mul_sub, ← mul_sub, hsum]
  simp

/-- The surviving-face expansion of the source boundary form.  Its equality
with the original box-endpoint expansion is the interior-face cancellation
lemma proved after the single-box telescoping identity. -/
noncomputable def cubeBoundaryFaceForm (α : Anisotropy) (T : FiniteConvexTree α)
    (lam r : ℝ) (F : CubeVertex → E3 → ℝ) : ℝ :=
  -Real.pi * ∑ i : Fin 3, (α.weight i : ℝ) *
    ∑ S ∈ survivingFacesAll T i,
      (S.orientation.sign : ℝ) *
        ∫ t : ℝ in Set.Ioc (boxLength S.box / 2) (boxLength S.box),
          t ^ (α.weight i - 1) * cubeFaceIntegral α i S lam r t F

/-- The literal tree remainder after endpoint telescoping and surviving-face
cancellation. -/
noncomputable def cubeTreeRemainder (α : Anisotropy) (T : FiniteConvexTree α)
    (lam r : ℝ) (F : CubeVertex → E3 → ℝ) : ℝ :=
  cubeEndpointForm α (treeLeaves T) lam r F -
    cubeEndpointForm α {T.root} lam r F +
      cubeBoundaryFaceForm α T lam r F

/-- The cubical coordinate factors are instances of the scalar telescope
with the source parameters `(μ_i,s_i)`. -/
theorem cubeCoordinateD_eq_scalarD (α : Anisotropy) (i : Fin 3)
    (lam r t : ℝ) (p : E3) (x : E6) :
    cubeCoordinateD α i lam r t p x =
      scalarD (cubeWidth i lam) (cubeCenterShift i r) (α.weight i) t (p i)
        (x (i, false)) (x (i, true)) := rfl

theorem cubeCoordinateP_eq_scalarP (α : Anisotropy) (i : Fin 3)
    (lam r t : ℝ) (p : E3) (x : E6) :
    cubeCoordinateP α i lam r t p x =
      scalarP (cubeWidth i lam) (cubeCenterShift i r) (α.weight i) t (p i)
        (x (i, false)) (x (i, true)) := rfl

theorem cubeBoundaryKernel_eq_scalarE (α : Anisotropy) (i : Fin 3)
    (lam r t : ℝ) (p : E3) (x : E6) :
    cubeBoundaryKernel α i lam r t p x =
      scalarE (cubeWidth i lam) (cubeCenterShift i r) (α.weight i) t (p i)
        (x (i, false)) (x (i, true)) := rfl

/-- The six-variable local kernel splits into the active derivative pair and
the two passive Gaussian pairs.  This is the literal kernel factorization
used when the scalar telescope is integrated in the other coordinates. -/
theorem localCubeKernel_eq_coordinateP_mul (α : Anisotropy) (i : Fin 3)
    (lam r t : ℝ) (p : E3) (x : E6) :
    localCubeKernel α i lam r t p x =
      cubeCoordinateP α i lam r t p x *
        ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x := by
  unfold localCubeKernel cubeCoordinateP cubeCoordinateD
  rw [Fintype.prod_prod_type]
  simp_rw [Fintype.prod_bool]
  let A : Fin 3 → ℝ := fun m ↦
    (if m = i then
      cubeGaussianDerivKernel α lam r t p m (x (m, true))
    else cubeGaussianKernel α lam r t p m (x (m, true))) *
    (if m = i then
      cubeGaussianDerivKernel α lam r t p m (x (m, false))
    else cubeGaussianKernel α lam r t p m (x (m, false)))
  let B : Fin 3 → ℝ := fun m ↦
    cubeGaussianKernel α lam r t p m (x (m, false)) *
      cubeGaussianKernel α lam r t p m (x (m, true))
  change (∏ m, A m) =
    cubeGaussianDerivKernel α lam r t p i (x (i, false)) *
      cubeGaussianDerivKernel α lam r t p i (x (i, true)) *
        ∏ m ∈ Finset.univ.erase i, B m
  have hAerase : (∏ m ∈ Finset.univ.erase i, A m) =
      ∏ m ∈ Finset.univ.erase i, B m := by
    apply Finset.prod_congr rfl
    intro m hm
    have hmi : m ≠ i := (Finset.mem_erase.mp hm).1
    simp only [A, B, if_neg hmi]
    ring
  calc
    (∏ m, A m) = A i * ∏ m ∈ Finset.univ.erase i, A m :=
      (Finset.mul_prod_erase Finset.univ A (Finset.mem_univ i)).symm
    _ = cubeGaussianDerivKernel α lam r t p i (x (i, false)) *
          cubeGaussianDerivKernel α lam r t p i (x (i, true)) *
            ∏ m ∈ Finset.univ.erase i, B m := by
      rw [hAerase]
      simp only [A, if_pos]
      ring

/-- The scalar divergence identity expressed in the active coordinate of a
cubical kernel.  The remaining coordinates are deliberately inert, so this
is the exact bridge used before Fubini lifts the identity over a box. -/
theorem cubeCoordinate_pointwise_divergence
    (α : Anisotropy) (i : Fin 3) {lam t : ℝ} (r : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    -t * deriv (fun q : ℝ => cubeCoordinateD α i lam r q p x) t =
      (α.weight i : ℝ) / Real.pi * cubeCoordinateP α i lam r t p x +
        (α.weight i : ℝ) * t ^ α.weight i *
          deriv (fun q : ℝ =>
            cubeBoundaryKernel α i lam r t (cubeCenterReplace p i q) x) (p i) := by
  have hwidth : 0 < cubeWidth i lam := by
    unfold cubeWidth
    split_ifs with hi
    · linarith
    · positivity
  have hmu : cubeWidth i lam ≠ 0 := hwidth.ne'
  have htne : t ≠ 0 := ht.ne'
  have hscalar := scalar_pointwise_divergence
    (mu := cubeWidth i lam) (sig := cubeCenterShift i r)
    (n := α.weight i) (t := t) (p := p i)
    (u0 := x (i, false)) (u1 := x (i, true)) hmu htne
  have hboundary :
      (fun q : ℝ => cubeBoundaryKernel α i lam r t (cubeCenterReplace p i q) x) =
        (fun q : ℝ => scalarE (cubeWidth i lam) (cubeCenterShift i r)
          (α.weight i) t q (x (i, false)) (x (i, true))) := by
    funext q
    rw [cubeBoundaryKernel_eq_scalarE]
    simp
  rw [hboundary]
  simpa only [cubeCoordinateD_eq_scalarD, cubeCoordinateP_eq_scalarP] using hscalar

/-- The interval telescope in an actual cubical coordinate.  Its hypotheses
are precisely the compact-parameter regularity facts subsequently supplied
by the local-integrability development. -/
theorem cubeCoordinate_oneDim_telescoping
    (α : Anisotropy) (i : Fin 3) {lam t a b : ℝ} (r : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t)
    (_hDdot : IntervalIntegrable
      (fun q : ℝ => deriv (fun s : ℝ =>
        cubeCoordinateD α i lam r s (cubeCenterReplace p i q) x) t)
      volume a b)
    (hP : IntervalIntegrable
      (fun q : ℝ => cubeCoordinateP α i lam r t (cubeCenterReplace p i q) x)
      volume a b)
    (hEdiff : ∀ q ∈ Set.uIcc a b, DifferentiableAt ℝ
      (fun s : ℝ => cubeBoundaryKernel α i lam r t (cubeCenterReplace p i s) x) q)
    (hEcont : ContinuousOn
      (deriv (fun s : ℝ => cubeBoundaryKernel α i lam r t
        (cubeCenterReplace p i s) x)) (Set.uIcc a b)) :
    ∫ q in a..b, -t * deriv (fun s : ℝ =>
      cubeCoordinateD α i lam r s (cubeCenterReplace p i q) x) t =
      (α.weight i : ℝ) / Real.pi *
        (∫ q in a..b, cubeCoordinateP α i lam r t (cubeCenterReplace p i q) x) +
      (α.weight i : ℝ) * t ^ α.weight i *
        (cubeBoundaryKernel α i lam r t (cubeCenterReplace p i b) x -
          cubeBoundaryKernel α i lam r t (cubeCenterReplace p i a) x) := by
  have hEint : IntervalIntegrable
      (deriv (fun s : ℝ => cubeBoundaryKernel α i lam r t
        (cubeCenterReplace p i s) x)) volume a b :=
    hEcont.intervalIntegrable
  have hFTC :
      (∫ q in a..b, deriv (fun s : ℝ => cubeBoundaryKernel α i lam r t
        (cubeCenterReplace p i s) x) q) =
        cubeBoundaryKernel α i lam r t (cubeCenterReplace p i b) x -
          cubeBoundaryKernel α i lam r t (cubeCenterReplace p i a) x :=
    intervalIntegral.integral_deriv_eq_sub hEdiff hEint
  calc
    ∫ q in a..b, -t * deriv (fun s : ℝ =>
        cubeCoordinateD α i lam r s (cubeCenterReplace p i q) x) t =
      ∫ q in a..b, ((α.weight i : ℝ) / Real.pi *
        cubeCoordinateP α i lam r t (cubeCenterReplace p i q) x +
        (α.weight i : ℝ) * t ^ α.weight i *
          deriv (fun s : ℝ => cubeBoundaryKernel α i lam r t
            (cubeCenterReplace p i s) x) q) := by
      apply intervalIntegral.integral_congr
      intro q hq
      have hpoint := cubeCoordinate_pointwise_divergence α i r
        (cubeCenterReplace p i q) x hlam ht
      have hreplace :
          (fun s : ℝ => cubeBoundaryKernel α i lam r t
            (cubeCenterReplace (cubeCenterReplace p i q) i s) x) =
          (fun s : ℝ => cubeBoundaryKernel α i lam r t
            (cubeCenterReplace p i s) x) := by
        funext s
        rw [cubeCenterReplace_replace]
      rw [hreplace] at hpoint
      simpa using hpoint
    _ = (α.weight i : ℝ) / Real.pi *
          (∫ q in a..b, cubeCoordinateP α i lam r t (cubeCenterReplace p i q) x) +
        (α.weight i : ℝ) * t ^ α.weight i *
          (∫ q in a..b, deriv (fun s : ℝ => cubeBoundaryKernel α i lam r t
            (cubeCenterReplace p i s) x) q) := by
      rw [intervalIntegral.integral_add
        (hP.const_mul ((α.weight i : ℝ) / Real.pi))
        (hEint.const_mul ((α.weight i : ℝ) * t ^ α.weight i))]
      rw [intervalIntegral.integral_const_mul,
        intervalIntegral.integral_const_mul]
    _ = _ := by rw [hFTC]

/-- The scalar regularity package discharges every analytic side condition in
the active-coordinate telescope on the positive scale range. -/
theorem cubeCoordinate_oneDim_telescoping_of_pos
    (α : Anisotropy) (i : Fin 3) {lam t a b : ℝ} (r : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    ∫ q in a..b, -t * deriv (fun s : ℝ =>
      cubeCoordinateD α i lam r s (cubeCenterReplace p i q) x) t =
      (α.weight i : ℝ) / Real.pi *
        (∫ q in a..b, cubeCoordinateP α i lam r t (cubeCenterReplace p i q) x) +
      (α.weight i : ℝ) * t ^ α.weight i *
        (cubeBoundaryKernel α i lam r t (cubeCenterReplace p i b) x -
          cubeBoundaryKernel α i lam r t (cubeCenterReplace p i a) x) := by
  have hwidth : 0 < cubeWidth i lam := by
    unfold cubeWidth
    split_ifs with hi
    · linarith
    · positivity
  have hmu : cubeWidth i lam ≠ 0 := hwidth.ne'
  have htne : t ≠ 0 := ht.ne'
  have hscalar := scalar_oneDim_telescoping_of_ne_zero
    (mu := cubeWidth i lam) (sig := cubeCenterShift i r)
    (n := α.weight i) (t := t) (a := a) (b := b)
    (u0 := x (i, false)) (u1 := x (i, true)) hmu htne
  simpa only [cubeCoordinateD_eq_scalarD, cubeCoordinateP_eq_scalarP,
    cubeBoundaryKernel_eq_scalarE, cubeCenterReplace_apply_same] using hscalar

/-- Replacing the active coordinate of a point already assembled from a
transverse point leaves precisely that transverse point and the new coordinate.
This is the affine-coordinate compatibility used before applying Fubini. -/
theorem cubeCenterReplace_faceInsert (i : Fin 3) (c q : ℝ)
    (y : TransverseSpace i) :
    cubeCenterReplace (faceInsert i c y) i q = faceInsert i q y := by
  ext j
  by_cases hji : j = i
  · subst j
    simp
  · rw [cubeCenterReplace_apply_ne _ _ _ _ hji]
    simp [faceInsert_apply, hji]

/-- At a fixed transverse point, the positive-scale one-dimensional telescope
over a box is exactly the interval telescope between that box's two active
coordinate endpoints.  No Fubini or integrability assertion is used here. -/
theorem cubeCoordinate_oneDim_telescoping_faceInsert_box
    (α : Anisotropy) (Q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r c : ℝ) (y : TransverseSpace i) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    ∫ u in boxFaceCoordinate α Q i FaceOrientation.lower..
        boxFaceCoordinate α Q i FaceOrientation.upper,
      -t * deriv (fun s : ℝ =>
        cubeCoordinateD α i lam r s (faceInsert i u y) x) t =
      (α.weight i : ℝ) / Real.pi *
        (∫ u in boxFaceCoordinate α Q i FaceOrientation.lower..
          boxFaceCoordinate α Q i FaceOrientation.upper,
          cubeCoordinateP α i lam r t (faceInsert i u y) x) +
      (α.weight i : ℝ) * t ^ α.weight i *
        (cubeBoundaryKernel α i lam r t
          (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.upper) y) x -
          cubeBoundaryKernel α i lam r t
            (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.lower) y) x) := by
  simpa only [cubeCenterReplace_faceInsert] using
    (cubeCoordinate_oneDim_telescoping_of_pos α i
      (a := boxFaceCoordinate α Q i FaceOrientation.lower)
      (b := boxFaceCoordinate α Q i FaceOrientation.upper)
      r (faceInsert i c y) x hlam ht)

/-- A passive coordinate pair is constant along the active coordinate
fibres.  This is the elementary affine fact that turns the other two Gaussian
pairs into the transverse weight of the box telescope. -/
theorem cubeCoordinateD_faceInsert_ne
    (α : Anisotropy) (i j : Fin 3) (lam r t u : ℝ)
    (y : TransverseSpace i) (x : E6) (hji : j ≠ i) :
    cubeCoordinateD α j lam r t (faceInsert i u y) x =
      cubeCoordinateD α j lam r t (faceInsert i 0 y) x := by
  simp [cubeCoordinateD, cubeGaussianKernel, faceInsert_apply, hji]

/-- The product of the two passive coordinate pairs is constant on every
active-coordinate fibre. -/
theorem passiveCoordinateProduct_faceInsert
    (α : Anisotropy) (i : Fin 3) (lam r t u : ℝ)
    (y : TransverseSpace i) (x : E6) :
    (∏ m ∈ Finset.univ.erase i,
      cubeCoordinateD α m lam r t (faceInsert i u y) x) =
      ∏ m ∈ Finset.univ.erase i,
        cubeCoordinateD α m lam r t (faceInsert i 0 y) x := by
  apply Finset.prod_congr rfl
  intro m hm
  exact cubeCoordinateD_faceInsert_ne α i m lam r t u y x
    (Finset.mem_erase.mp hm).1

theorem volume_boxSet_ne_top (α : Anisotropy) (q : AnisoBox α) :
    volume (boxSet α q) ≠ ∞ := by
  rw [volume_boxSet]
  exact ENNReal.prod_ne_top fun _ _ ↦ ENNReal.ofReal_ne_top

/-- A continuous ambient function is integrable on every literal source box. -/
theorem integrableOn_boxSet_of_continuous {α : Anisotropy}
    {f : E3 → ℝ} (hf : Continuous f) (q : AnisoBox α) :
    IntegrableOn f (boxSet α q) := by
  exact hf.continuousOn.integrableOn_of_subset_isCompact
    (isCompact_boxClosedSet α q) (measurableSet_boxSet α q)
    (boxSet_subset_boxClosedSet α q) (volume_boxSet_ne_top α q)

/-- Center-continuity of the active Gaussian pair at positive source scale. -/
theorem continuous_cubeCoordinateD_center
    (α : Anisotropy) (i : Fin 3) {lam t : ℝ} (r : ℝ) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    Continuous (fun p : E3 ↦ cubeCoordinateD α i lam r t p x) := by
  have hscale : cubeWidth i lam * t ^ α.weight i ≠ 0 :=
    cubeGaussianScale_ne_zero α i hlam ht
  simpa only [cubeCoordinateD_eq_scalarD, coordinateProjection_apply,
    Function.comp_def] using
    (continuous_scalarD_center (mu := cubeWidth i lam)
      (sig := cubeCenterShift i r) (n := α.weight i) (t := t)
      (u0 := x (i, false)) (u1 := x (i, true)) hscale).comp
      (coordinateProjection i).continuous

/-- Center-continuity of the active derivative-Gaussian pair. -/
theorem continuous_cubeCoordinateP_center
    (α : Anisotropy) (i : Fin 3) (lam r t : ℝ) (x : E6) :
    Continuous (fun p : E3 ↦ cubeCoordinateP α i lam r t p x) := by
  simpa only [cubeCoordinateP_eq_scalarP, coordinateProjection_apply,
    Function.comp_def] using
    (continuous_scalarP_center (mu := cubeWidth i lam)
      (sig := cubeCenterShift i r) (n := α.weight i) (t := t)
      (u0 := x (i, false)) (u1 := x (i, true))).comp
      (coordinateProjection i).continuous

/-- Center-continuity of the boundary kernel at positive source scale. -/
theorem continuous_cubeBoundaryKernel_center
    (α : Anisotropy) (i : Fin 3) {lam t : ℝ} (r : ℝ) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    Continuous (fun p : E3 ↦ cubeBoundaryKernel α i lam r t p x) := by
  have hscale : cubeWidth i lam * t ^ α.weight i ≠ 0 :=
    cubeGaussianScale_ne_zero α i hlam ht
  simpa only [cubeBoundaryKernel_eq_scalarE, coordinateProjection_apply,
    Function.comp_def] using
    (continuous_scalarE_center (mu := cubeWidth i lam)
      (sig := cubeCenterShift i r) (n := α.weight i) (t := t)
      (u0 := x (i, false)) (u1 := x (i, true)) hscale).comp
      (coordinateProjection i).continuous

/-- Center-continuity of the scale derivative of the active Gaussian pair. -/
theorem continuous_cubeCoordinateDdot_center
    (α : Anisotropy) (i : Fin 3) {lam t : ℝ} (r : ℝ) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    Continuous (fun p : E3 ↦ deriv (fun s : ℝ ↦
      cubeCoordinateD α i lam r s p x) t) := by
  have hmu : cubeWidth i lam ≠ 0 :=
    (cubeWidth_pos_of_one_le i hlam).ne'
  simpa only [cubeCoordinateD_eq_scalarD, coordinateProjection_apply,
    Function.comp_def] using
    (continuous_scalarDdot_center (mu := cubeWidth i lam)
      (sig := cubeCenterShift i r) (n := α.weight i) (t := t)
      (u0 := x (i, false)) (u1 := x (i, true)) hmu ht.ne').comp
      (coordinateProjection i).continuous

theorem integrableOn_cubeCoordinateD_boxSet
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r : ℝ) (x : E6) (hlam : 1 ≤ lam) (ht : 0 < t) :
    IntegrableOn (fun p : E3 ↦ cubeCoordinateD α i lam r t p x) (boxSet α q) :=
  integrableOn_boxSet_of_continuous
    (continuous_cubeCoordinateD_center α i r x hlam ht) q

theorem integrableOn_cubeCoordinateP_boxSet
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) (lam r t : ℝ) (x : E6) :
    IntegrableOn (fun p : E3 ↦ cubeCoordinateP α i lam r t p x) (boxSet α q) :=
  integrableOn_boxSet_of_continuous
    (continuous_cubeCoordinateP_center α i lam r t x) q

theorem integrableOn_cubeBoundaryKernel_boxSet
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r : ℝ) (x : E6) (hlam : 1 ≤ lam) (ht : 0 < t) :
    IntegrableOn (fun p : E3 ↦ cubeBoundaryKernel α i lam r t p x) (boxSet α q) :=
  integrableOn_boxSet_of_continuous
    (continuous_cubeBoundaryKernel_center α i r x hlam ht) q

theorem integrableOn_cubeCoordinateDdot_boxSet
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r : ℝ) (x : E6) (hlam : 1 ≤ lam) (ht : 0 < t) :
    IntegrableOn (fun p : E3 ↦ deriv (fun s : ℝ ↦
      cubeCoordinateD α i lam r s p x) t) (boxSet α q) :=
  integrableOn_boxSet_of_continuous
    (continuous_cubeCoordinateDdot_center α i r x hlam ht) q

/-- Compact coordinatewise closure of a transverse half-open rectangle. -/
noncomputable def transverseClosedRectangle (α : Anisotropy)
    (q : AnisoBox α) (i : Fin 3) : Set (TransverseSpace i) :=
  (WithLp.toLp 2) '' Set.pi Set.univ (fun j : {m : Fin 3 // m ≠ i} ↦
    Set.Icc ((q.index j.1 : ℝ) * boxSide α q j.1)
      (((q.index j.1 + 1 : ℤ) : ℝ) * boxSide α q j.1))

theorem isCompact_transverseClosedRectangle (α : Anisotropy)
    (q : AnisoBox α) (i : Fin 3) :
    IsCompact (transverseClosedRectangle α q i) := by
  unfold transverseClosedRectangle
  let K : Set ({j : Fin 3 // j ≠ i} → ℝ) := Set.pi Set.univ (fun j ↦
    Set.Icc ((q.index j.1 : ℝ) * boxSide α q j.1)
      (((q.index j.1 + 1 : ℤ) : ℝ) * boxSide α q j.1))
  change IsCompact ((WithLp.toLp 2) '' K)
  have hK : IsCompact K := by
    dsimp only [K]
    exact isCompact_univ_pi fun _ ↦ isCompact_Icc
  exact hK.image (PiLp.continuous_toLp 2 _)

theorem transverseRectangle_subset_transverseClosedRectangle
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    transverseRectangle α q i ⊆ transverseClosedRectangle α q i := by
  intro y hy
  refine ⟨WithLp.ofLp y, ?_, ?_⟩
  · rw [Set.mem_pi]
    intro j _
    rw [transverseRectangle, Set.mem_preimage, Set.mem_pi] at hy
    exact Set.Ico_subset_Icc_self (hy j (Set.mem_univ j))
  · simp

theorem volume_transverseRectangle_ne_top (α : Anisotropy)
    (q : AnisoBox α) (i : Fin 3) :
    volume (transverseRectangle α q i) ≠ ∞ := by
  rw [volume_transverseRectangle]
  exact ENNReal.prod_ne_top fun _ _ ↦ ENNReal.ofReal_ne_top

/-- A continuous transverse function is integrable on every source face
rectangle. -/
theorem integrableOn_transverseRectangle_of_continuous
    {α : Anisotropy} {i : Fin 3} {f : TransverseSpace i → ℝ}
    (hf : Continuous f) (q : AnisoBox α) :
    IntegrableOn f (transverseRectangle α q i) := by
  exact hf.continuousOn.integrableOn_of_subset_isCompact
    (isCompact_transverseClosedRectangle α q i)
    (measurableSet_transverseRectangle α q i)
    (transverseRectangle_subset_transverseClosedRectangle α q i)
    (volume_transverseRectangle_ne_top α q i)

theorem continuous_cubeBoundaryKernel_face
    (α : Anisotropy) (i : Fin 3) {lam t : ℝ} (r c : ℝ) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    Continuous (fun y : TransverseSpace i ↦
      cubeBoundaryKernel α i lam r t (faceInsert i c y) x) :=
  (continuous_cubeBoundaryKernel_center α i r x hlam ht).comp
    (faceInsert_continuous i c)

theorem integrableOn_cubeBoundaryKernel_face
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r c : ℝ) (x : E6) (hlam : 1 ≤ lam) (ht : 0 < t) :
    IntegrableOn (fun y : TransverseSpace i ↦
      cubeBoundaryKernel α i lam r t (faceInsert i c y) x)
      (transverseRectangle α q i) :=
  integrableOn_transverseRectangle_of_continuous
    (continuous_cubeBoundaryKernel_face α i r c x hlam ht) q

/-- Literal-coordinate Fubini for the scale derivative in the source
one-dimensional telescope. -/
theorem integral_cubeCoordinateDdot_boxSet_eq_transverse_interval
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r : ℝ) (x : E6) (hlam : 1 ≤ lam) (ht : 0 < t) :
    (∫ p : E3 in boxSet α q, deriv (fun s : ℝ ↦
      cubeCoordinateD α i lam r s p x) t) =
      ∫ y in transverseRectangle α q i,
        ∫ u in boxInterval α q i, deriv (fun s : ℝ ↦
          cubeCoordinateD α i lam r s (faceInsert i u y) x) t := by
  exact integral_boxSet_eq_integral_transverse_interval α q i _
    (integrableOn_cubeCoordinateDdot_boxSet α q i r x hlam ht)

/-- Literal-coordinate Fubini for the active derivative-Gaussian pair on the
right side of the telescope. -/
theorem integral_cubeCoordinateP_boxSet_eq_transverse_interval
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) (lam r t : ℝ) (x : E6) :
    (∫ p : E3 in boxSet α q, cubeCoordinateP α i lam r t p x) =
      ∫ y in transverseRectangle α q i,
        ∫ u in boxInterval α q i,
          cubeCoordinateP α i lam r t (faceInsert i u y) x := by
  exact integral_boxSet_eq_integral_transverse_interval α q i _
    (integrableOn_cubeCoordinateP_boxSet α q i lam r t x)

/-- The one-dimensional source telescope, integrated through a literal box
with an arbitrary passive transverse weight.  This is the Fubini step in
`lem:telescoping_identity`: the hypotheses retain precisely the local
integrability obligations which the Gaussian majorant later discharges. -/
theorem cubeCoordinate_box_telescoping_weighted
    (α : Anisotropy) (Q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r : ℝ) (x : E6) (w : TransverseSpace i → ℝ)
    (hlam : 1 ≤ lam) (ht : 0 < t)
    (hD : IntegrableOn (fun p : E3 ↦
      w (coordinateSplit i p).2 *
        (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t))
      (boxSet α Q))
    (hP : IntegrableOn (fun p : E3 ↦
      w (coordinateSplit i p).2 * cubeCoordinateP α i lam r t p x)
      (boxSet α Q))
    (hElo : IntegrableOn (fun y : TransverseSpace i ↦
      w y * cubeBoundaryKernel α i lam r t
        (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.lower) y) x)
      (transverseRectangle α Q i))
    (hEhi : IntegrableOn (fun y : TransverseSpace i ↦
      w y * cubeBoundaryKernel α i lam r t
        (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.upper) y) x)
      (transverseRectangle α Q i))
    (hPouter : Integrable (fun y : TransverseSpace i ↦
      ∫ u in boxInterval α Q i,
        w y * cubeCoordinateP α i lam r t (faceInsert i u y) x)
      (volume.restrict (transverseRectangle α Q i))) :
    (∫ p : E3 in boxSet α Q,
      w (coordinateSplit i p).2 *
        (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t)) =
      (α.weight i : ℝ) / Real.pi *
        (∫ p : E3 in boxSet α Q,
          w (coordinateSplit i p).2 * cubeCoordinateP α i lam r t p x) +
      (α.weight i : ℝ) * t ^ α.weight i *
        ((∫ y : TransverseSpace i in transverseRectangle α Q i,
          w y * cubeBoundaryKernel α i lam r t
            (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.upper) y) x) -
         (∫ y : TransverseSpace i in transverseRectangle α Q i,
          w y * cubeBoundaryKernel α i lam r t
            (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.lower) y) x)) := by
  have hDsplit := integral_boxSet_eq_integral_transverse_interval α Q i
    (fun p : E3 ↦ w (coordinateSplit i p).2 *
      (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t)) hD
  have hPsplit := integral_boxSet_eq_integral_transverse_interval α Q i
    (fun p : E3 ↦ w (coordinateSplit i p).2 *
      cubeCoordinateP α i lam r t p x) hP
  simp only [coordinateSplit_faceInsert] at hDsplit hPsplit
  rw [hDsplit, hPsplit]
  let c : ℝ := (α.weight i : ℝ) / Real.pi
  let d : ℝ := (α.weight i : ℝ) * t ^ α.weight i
  let lo : ℝ := boxFaceCoordinate α Q i FaceOrientation.lower
  let hi : ℝ := boxFaceCoordinate α Q i FaceOrientation.upper
  let R : Set (TransverseSpace i) := transverseRectangle α Q i
  let Ddot : TransverseSpace i → ℝ → ℝ := fun y u ↦
    w y * (-t * deriv (fun s : ℝ ↦
      cubeCoordinateD α i lam r s (faceInsert i u y) x) t)
  let P : TransverseSpace i → ℝ → ℝ := fun y u ↦
    w y * cubeCoordinateP α i lam r t (faceInsert i u y) x
  let Elo : TransverseSpace i → ℝ := fun y ↦
    w y * cubeBoundaryKernel α i lam r t (faceInsert i lo y) x
  let Ehi : TransverseSpace i → ℝ := fun y ↦
    w y * cubeBoundaryKernel α i lam r t (faceInsert i hi y) x
  have hpoint (y : TransverseSpace i) :
      (∫ u in boxInterval α Q i, Ddot y u) =
        c * (∫ u in boxInterval α Q i, P y u) + d * (Ehi y - Elo y) := by
    dsimp only [Ddot, P, Elo, Ehi, c, d, lo, hi]
    have hbase := cubeCoordinate_oneDim_telescoping_faceInsert_box
      α Q i r 0 y x hlam ht
    have horder := boxFaceCoordinate_lower_le_upper α Q i
    simp_rw [intervalIntegral.integral_of_le horder] at hbase
    simp_rw [← integral_Ico_eq_integral_Ioc] at hbase
    calc
      (∫ u in boxInterval α Q i,
        w y * (-t * deriv (fun s : ℝ ↦
          cubeCoordinateD α i lam r s (faceInsert i u y) x) t)) =
          w y * (∫ u in boxInterval α Q i,
            -t * deriv (fun s : ℝ ↦
              cubeCoordinateD α i lam r s (faceInsert i u y) x) t) := by
            rw [MeasureTheory.integral_const_mul]
      _ = w y * ((α.weight i : ℝ) / Real.pi *
            (∫ u in boxInterval α Q i,
              cubeCoordinateP α i lam r t (faceInsert i u y) x) +
          (α.weight i : ℝ) * t ^ α.weight i *
            (cubeBoundaryKernel α i lam r t
              (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.upper) y) x -
              cubeBoundaryKernel α i lam r t
                (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.lower) y) x)) := by
            simpa only [boxInterval, boxFaceCoordinate] using
              congrArg (fun z : ℝ ↦ w y * z) hbase
      _ = (α.weight i : ℝ) / Real.pi *
            (∫ u in boxInterval α Q i,
              w y * cubeCoordinateP α i lam r t (faceInsert i u y) x) +
          (α.weight i : ℝ) * t ^ α.weight i *
            (w y * cubeBoundaryKernel α i lam r t
              (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.upper) y) x -
              w y * cubeBoundaryKernel α i lam r t
                (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.lower) y) x) := by
            rw [MeasureTheory.integral_const_mul]
            ring
  have hboundary : Integrable (fun y : TransverseSpace i ↦ d * (Ehi y - Elo y))
      (volume.restrict R) := by
    exact ((hEhi.sub hElo).const_mul d)
  calc
    (∫ y : TransverseSpace i in transverseRectangle α Q i,
      ∫ u in boxInterval α Q i,
        w y * (-t * deriv (fun s : ℝ ↦
          cubeCoordinateD α i lam r s (faceInsert i u y) x) t)) =
        ∫ y : TransverseSpace i in R,
          (c * (∫ u in boxInterval α Q i, P y u) + d * (Ehi y - Elo y)) := by
      apply integral_congr_ae
      filter_upwards [] with y
      exact hpoint y
    _ = c * (∫ y : TransverseSpace i in R,
          ∫ u in boxInterval α Q i, P y u) +
        d * ((∫ y : TransverseSpace i in R, Ehi y) -
          (∫ y : TransverseSpace i in R, Elo y)) := by
      rw [MeasureTheory.integral_add (hPouter.const_mul c) hboundary]
      rw [MeasureTheory.integral_const_mul]
      rw [MeasureTheory.integral_const_mul]
      rw [MeasureTheory.integral_sub hEhi hElo]
    _ = _ := by
      simp only [c, d, P, Ehi, Elo, R, hi, lo]

/-- The half-open active interval of a box has the same integral as its
oriented interval integral.  This is the endpoint-null-set bridge between
the literal box decomposition and the one-dimensional FTC identity. -/
theorem integral_boxInterval_eq_intervalIntegral
    (α : Anisotropy) (Q : AnisoBox α) (i : Fin 3) (f : ℝ → ℝ) :
    ∫ u in boxInterval α Q i, f u =
      ∫ u in boxFaceCoordinate α Q i FaceOrientation.lower..
        boxFaceCoordinate α Q i FaceOrientation.upper, f u := by
  let a := boxFaceCoordinate α Q i FaceOrientation.lower
  let b := boxFaceCoordinate α Q i FaceOrientation.upper
  have hab : a ≤ b := boxFaceCoordinate_lower_le_upper α Q i
  change ∫ u in Set.Ico a b, f u = ∫ u in a..b, f u
  rw [integral_Ico_eq_integral_Ioc]
  exact (intervalIntegral.integral_of_le hab).symm

/-- Fubini lift of the active-coordinate telescope at a fixed six-variable
point and arbitrary transverse weight.  Keeping the transverse sum bundled
means that the one source local-integrability hypothesis is sufficient here. -/
theorem weighted_cubeCoordinate_box_telescoping
    (α : Anisotropy) (Q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r : ℝ) (x : E6) (w : TransverseSpace i → ℝ)
    (hlam : 1 ≤ lam) (ht : 0 < t)
    (hlocal : IntegrableOn
      (fun p : E3 ↦
        (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
          w (coordinateSplit i p).2)
      (boxSet α Q)) :
    ∫ p in boxSet α Q,
      (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
        w (coordinateSplit i p).2 =
      ∫ y in transverseRectangle α Q i,
        ((α.weight i : ℝ) / Real.pi *
            (∫ u in boxFaceCoordinate α Q i FaceOrientation.lower..
              boxFaceCoordinate α Q i FaceOrientation.upper,
              cubeCoordinateP α i lam r t (faceInsert i u y) x) +
          (α.weight i : ℝ) * t ^ α.weight i *
            (cubeBoundaryKernel α i lam r t
              (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.upper) y) x -
            cubeBoundaryKernel α i lam r t
              (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.lower) y) x)) *
          w y := by
  rw [integral_boxSet_eq_integral_transverse_interval α Q i _ hlocal]
  apply integral_congr_ae
  filter_upwards [] with y
  have htel := cubeCoordinate_oneDim_telescoping_faceInsert_box
    α Q i r 0 y x hlam ht
  let d : ℝ → ℝ := fun u ↦
    -t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s (faceInsert i u y) x) t
  have hbox :
      (∫ u in boxInterval α Q i, d u) =
        ∫ u in boxFaceCoordinate α Q i FaceOrientation.lower..
          boxFaceCoordinate α Q i FaceOrientation.upper, d u :=
    integral_boxInterval_eq_intervalIntegral α Q i d
  simp only [coordinateSplit_faceInsert]
  change (∫ u in boxInterval α Q i, d u * w y) = _
  rw [integral_mul_const]
  rw [hbox, htel]

/-- The product of the two inactive coordinate factors, expressed in literal
transverse coordinates. -/
noncomputable def cubeInactiveWeight (α : Anisotropy) (i : Fin 3)
    (lam r t : ℝ) (x : E6) (y : TransverseSpace i) : ℝ :=
  ∏ m ∈ Finset.univ.erase i,
    cubeCoordinateD α m lam r t (faceInsert i 0 y) x

/-- An inactive cubical coordinate factor is unchanged when only the active
center coordinate is varied. -/
theorem cubeCoordinateD_faceInsert_eq_of_ne
    (α : Anisotropy) (i m : Fin 3) (hmi : m ≠ i)
    (lam r t u c : ℝ) (y : TransverseSpace i) (x : E6) :
    cubeCoordinateD α m lam r t (faceInsert i u y) x =
      cubeCoordinateD α m lam r t (faceInsert i c y) x := by
  simp [cubeCoordinateD, cubeGaussianKernel, faceInsert_apply, hmi]

/-- The inactive product on an active/transverse coordinate slice is the
literal transverse weight. -/
theorem cubeInactiveWeight_faceInsert
    (α : Anisotropy) (i : Fin 3) (lam r t u : ℝ)
    (y : TransverseSpace i) (x : E6) :
    (∏ m ∈ Finset.univ.erase i,
      cubeCoordinateD α m lam r t (faceInsert i u y) x) =
      cubeInactiveWeight α i lam r t x y := by
  unfold cubeInactiveWeight
  apply Finset.prod_congr rfl
  intro m hm
  exact cubeCoordinateD_faceInsert_eq_of_ne α i m
    (Finset.mem_erase.mp hm).1 lam r t u 0 y x

/-- Reexpress the inactive product at an ambient point through its literal
transverse coordinates. -/
theorem cubeInactiveWeight_coordinateSplit
    (α : Anisotropy) (i : Fin 3) (lam r t : ℝ) (p : E3) (x : E6) :
    (∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x) =
      cubeInactiveWeight α i lam r t x (coordinateSplit i p).2 := by
  have hjoin : p = faceInsert i (p i) (coordinateSplit i p).2 := by
    simpa [coordinateJoin, coordinateSplit] using (coordinateJoin_split i p).symm
  calc
    (∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x) =
        ∏ m ∈ Finset.univ.erase i,
          cubeCoordinateD α m lam r t
            (faceInsert i (p i) (coordinateSplit i p).2) x :=
      congrArg (fun z : E3 ↦
        ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t z x) hjoin
    _ = cubeInactiveWeight α i lam r t x (coordinateSplit i p).2 :=
      cubeInactiveWeight_faceInsert α i lam r t (p i)
        (coordinateSplit i p).2 x

/-- Source-faithful fixed-`x` box-coordinate telescope: the active
one-dimensional identity is multiplied by the two inactive `D_m` factors and
lifted through the literal box Fubini decomposition. -/
theorem cubeCoordinate_box_telescoping
    (α : Anisotropy) (Q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r : ℝ) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t)
    (hlocal : IntegrableOn
      (fun p : E3 ↦
        (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
          ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x)
      (boxSet α Q)) :
    ∫ p in boxSet α Q,
      (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
        ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x =
      ∫ y in transverseRectangle α Q i,
        ((α.weight i : ℝ) / Real.pi *
            (∫ u in boxFaceCoordinate α Q i FaceOrientation.lower..
              boxFaceCoordinate α Q i FaceOrientation.upper,
              cubeCoordinateP α i lam r t (faceInsert i u y) x) +
          (α.weight i : ℝ) * t ^ α.weight i *
            (cubeBoundaryKernel α i lam r t
              (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.upper) y) x -
            cubeBoundaryKernel α i lam r t
              (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.lower) y) x)) *
          ∏ m ∈ Finset.univ.erase i,
            cubeCoordinateD α m lam r t (faceInsert i 0 y) x := by
  have hlocal' : IntegrableOn
      (fun p : E3 ↦
        (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
          cubeInactiveWeight α i lam r t x (coordinateSplit i p).2)
      (boxSet α Q) := by
    apply hlocal.congr_fun
    · intro p _
      change
        (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
            (∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x) =
          (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
            cubeInactiveWeight α i lam r t x (coordinateSplit i p).2
      rw [cubeInactiveWeight_coordinateSplit]
    · exact measurableSet_boxSet α Q
  have htel := weighted_cubeCoordinate_box_telescoping α Q i r x
    (cubeInactiveWeight α i lam r t x) hlam ht hlocal'
  calc
    ∫ p in boxSet α Q,
        (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
          ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x =
        ∫ p in boxSet α Q,
          (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
            cubeInactiveWeight α i lam r t x (coordinateSplit i p).2 := by
          apply integral_congr_ae
          filter_upwards [] with p
          rw [cubeInactiveWeight_coordinateSplit]
    _ = _ := by
      simpa only [cubeInactiveWeight] using htel

/-- Continuity of the fixed-`x` integrand on the left-hand side of the
source box telescope. -/
theorem continuous_cubeCoordinateTelescopeIntegrand
    (α : Anisotropy) (i : Fin 3) {lam t : ℝ} (r : ℝ) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    Continuous (fun p : E3 ↦
      (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
        ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x) := by
  have hdot := continuous_cubeCoordinateDdot_center α i r x hlam ht
  have hpassive : Continuous (fun p : E3 ↦
      ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x) := by
    apply continuous_finsetProd
    intro m hm
    exact continuous_cubeCoordinateD_center α m r x hlam ht
  exact (continuous_const.mul hdot).mul hpassive

theorem integrableOn_cubeCoordinateTelescopeIntegrand_boxSet
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r : ℝ) (x : E6) (hlam : 1 ≤ lam) (ht : 0 < t) :
    IntegrableOn (fun p : E3 ↦
      (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
        ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x)
      (boxSet α q) :=
  integrableOn_boxSet_of_continuous
    (continuous_cubeCoordinateTelescopeIntegrand α i r x hlam ht) q

/-- The fixed-`x` box-coordinate telescope with its local-integrability
obligation discharged by the compact local Gaussian regularity package. -/
theorem cubeCoordinate_box_telescoping_of_pos
    (α : Anisotropy) (Q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r : ℝ) (x : E6) (hlam : 1 ≤ lam) (ht : 0 < t) :
    ∫ p in boxSet α Q,
      (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
        ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x =
      ∫ y in transverseRectangle α Q i,
        ((α.weight i : ℝ) / Real.pi *
            (∫ u in boxFaceCoordinate α Q i FaceOrientation.lower..
              boxFaceCoordinate α Q i FaceOrientation.upper,
              cubeCoordinateP α i lam r t (faceInsert i u y) x) +
          (α.weight i : ℝ) * t ^ α.weight i *
            (cubeBoundaryKernel α i lam r t
              (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.upper) y) x -
            cubeBoundaryKernel α i lam r t
              (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.lower) y) x)) *
          ∏ m ∈ Finset.univ.erase i,
            cubeCoordinateD α m lam r t (faceInsert i 0 y) x :=
  cubeCoordinate_box_telescoping α Q i r x hlam ht
    (integrableOn_cubeCoordinateTelescopeIntegrand_boxSet α Q i r x hlam ht)

/-- The fully split fixed-`x` box telescope.  The interior term is the
literal local cube kernel, while the two remaining terms are the two oriented
face kernels.  Every Fubini condition follows from compact-domain continuity. -/
theorem cubeCoordinate_box_telescoping_split_of_pos
    (α : Anisotropy) (Q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r : ℝ) (x : E6) (hlam : 1 ≤ lam) (ht : 0 < t) :
    ∫ p in boxSet α Q,
      (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
        ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x =
      (α.weight i : ℝ) / Real.pi *
        (∫ p in boxSet α Q, localCubeKernel α i lam r t p x) +
      (α.weight i : ℝ) * t ^ α.weight i *
        ((∫ y in transverseRectangle α Q i,
          cubeFaceKernel α i lam r t
            (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.upper) y) x) -
         (∫ y in transverseRectangle α Q i,
          cubeFaceKernel α i lam r t
            (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.lower) y) x)) := by
  let w : TransverseSpace i → ℝ := cubeInactiveWeight α i lam r t x
  have hpassive : Continuous (fun p : E3 ↦
      ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x) := by
    apply continuous_finsetProd
    intro m hm
    exact continuous_cubeCoordinateD_center α m r x hlam ht
  have hw : Continuous (fun p : E3 ↦ w (coordinateSplit i p).2) := by
    apply Continuous.congr hpassive
    intro p
    dsimp only [w]
    exact cubeInactiveWeight_coordinateSplit α i lam r t p x
  have hD : IntegrableOn (fun p : E3 ↦
      w (coordinateSplit i p).2 *
        (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t))
      (boxSet α Q) := by
    apply integrableOn_boxSet_of_continuous
    exact hw.mul ((continuous_const.mul
      (continuous_cubeCoordinateDdot_center α i r x hlam ht)))
  have hP : IntegrableOn (fun p : E3 ↦
      w (coordinateSplit i p).2 * cubeCoordinateP α i lam r t p x)
      (boxSet α Q) := by
    apply integrableOn_boxSet_of_continuous
    exact hw.mul (continuous_cubeCoordinateP_center α i lam r t x)
  have hE (o : FaceOrientation) : IntegrableOn
      (fun y : TransverseSpace i ↦
        w y * cubeBoundaryKernel α i lam r t
          (faceInsert i (boxFaceCoordinate α Q i o) y) x)
      (transverseRectangle α Q i) := by
    apply integrableOn_transverseRectangle_of_continuous
    have hwface : Continuous w := by
      dsimp only [w, cubeInactiveWeight]
      apply continuous_finsetProd
      intro m hm
      exact (continuous_cubeCoordinateD_center α m r x hlam ht).comp
        (faceInsert_continuous i 0)
    exact hwface.mul (continuous_cubeBoundaryKernel_face α i r
      (boxFaceCoordinate α Q i o) x hlam ht)
  have hPouter : Integrable (fun y : TransverseSpace i ↦
      ∫ u in boxInterval α Q i,
        w y * cubeCoordinateP α i lam r t (faceInsert i u y) x)
      (volume.restrict (transverseRectangle α Q i)) := by
    have h := integrable_outer_integral_boxInterval_of_integrableOn α Q i
      (fun p : E3 ↦ w (coordinateSplit i p).2 *
        cubeCoordinateP α i lam r t p x) hP
    simpa only [coordinateSplit_faceInsert] using h
  have htel := cubeCoordinate_box_telescoping_weighted α Q i r x w hlam ht
    hD hP (hE FaceOrientation.lower) (hE FaceOrientation.upper) hPouter
  have hlocal :
      (∫ p in boxSet α Q,
        w (coordinateSplit i p).2 * cubeCoordinateP α i lam r t p x) =
        ∫ p in boxSet α Q, localCubeKernel α i lam r t p x := by
    apply integral_congr_ae
    filter_upwards [] with p
    dsimp only [w]
    rw [← cubeInactiveWeight_coordinateSplit]
    simpa only [mul_comm] using
      (localCubeKernel_eq_coordinateP_mul α i lam r t p x).symm
  have hleft :
      (∫ p in boxSet α Q,
        (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
          ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x) =
        ∫ p in boxSet α Q,
          w (coordinateSplit i p).2 *
            (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) := by
    apply integral_congr_ae
    filter_upwards [] with p
    dsimp only [w]
    rw [← cubeInactiveWeight_coordinateSplit]
    ring
  have hface (o : FaceOrientation) :
      (∫ y in transverseRectangle α Q i,
        w y * cubeBoundaryKernel α i lam r t
          (faceInsert i (boxFaceCoordinate α Q i o) y) x) =
        ∫ y in transverseRectangle α Q i,
          cubeFaceKernel α i lam r t
            (faceInsert i (boxFaceCoordinate α Q i o) y) x := by
    apply integral_congr_ae
    filter_upwards [] with y
    dsimp only [w]
    rw [cubeFaceKernel, cubeInactiveWeight_faceInsert]
    ring
  rw [hleft, htel, hlocal, hface FaceOrientation.upper,
    hface FaceOrientation.lower]

/-- The exact product rule for the three coordinate pairs in the endpoint
kernel.  It is the first equality in the source box-derivative calculation. -/
theorem cubeEndpointKernel_scale_derivative
    (α : Anisotropy) (lam r t : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    -t * deriv (fun s : ℝ ↦ cubeEndpointKernel α lam r s p x) t =
      ∑ i : Fin 3,
        (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
          ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x := by
  have hwidth (i : Fin 3) : cubeWidth i lam ≠ 0 :=
    (cubeWidth_pos_of_one_le i hlam).ne'
  have hdif (i : Fin 3) : DifferentiableAt ℝ
      (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t := by
    simpa only [cubeCoordinateD_eq_scalarD] using
      (hasDerivAt_scalarD_scale (mu := cubeWidth i lam)
        (sig := cubeCenterShift i r) (n := α.weight i) (t := t)
        (p := p i) (u0 := x (i, false)) (u1 := x (i, true))
        (hwidth i) ht.ne').differentiableAt
  simp only [cubeEndpointKernel, Fin.prod_univ_three]
  change -t * deriv
      (((fun s : ℝ ↦ cubeCoordinateD α 0 lam r s p x) *
        (fun s : ℝ ↦ cubeCoordinateD α 1 lam r s p x)) *
        (fun s : ℝ ↦ cubeCoordinateD α 2 lam r s p x)) t = _
  rw [deriv_mul ((hdif 0).mul (hdif 1)) (hdif 2)]
  rw [deriv_mul (hdif 0) (hdif 1)]
  simp only [Fin.sum_univ_three]
  have herase0 : (Finset.univ.erase (0 : Fin 3)) = {1, 2} := by decide
  have herase1 : (Finset.univ.erase (1 : Fin 3)) = {0, 2} := by decide
  have herase2 : (Finset.univ.erase (2 : Fin 3)) = {0, 1} := by decide
  rw [herase0, herase1, herase2]
  simp
  ring

/-- Scale continuity of the scalar Gaussian factor away from zero scale. -/
theorem continuousAt_scalarG_scale {mu sig : ℝ} {n : ℕ} {t p u : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    ContinuousAt (fun q : ℝ ↦ scalarG mu sig n q p u) t := by
  have hscale : mu * t ^ n ≠ 0 :=
    mul_ne_zero hmu (pow_ne_zero n ht)
  have hpow : ContinuousAt (fun q : ℝ ↦ q ^ n) t := continuousAt_id.pow n
  have hs : ContinuousAt (fun q : ℝ ↦ mu * q ^ n) t :=
    continuousAt_const.mul hpow
  have hinv : ContinuousAt (fun q : ℝ ↦ (mu * q ^ n)⁻¹) t := hs.inv₀ hscale
  have hcenter : ContinuousAt (fun q : ℝ ↦ p + sig * q ^ n) t :=
    continuousAt_const.add (continuousAt_const.mul hpow)
  have hnum : ContinuousAt (fun q : ℝ ↦ u - (p + sig * q ^ n)) t :=
    continuousAt_const.sub hcenter
  have hratio : ContinuousAt
      (fun q : ℝ ↦ (u - (p + sig * q ^ n)) / (mu * q ^ n)) t := by
    change ContinuousAt
      (fun q : ℝ ↦ (u - (p + sig * q ^ n)) * (mu * q ^ n)⁻¹) t
    convert hnum.mul hinv using 1
    funext q
    rfl
  have hexp : ContinuousAt
      (fun q : ℝ ↦ Real.exp (-Real.pi *
        ((u - (p + sig * q ^ n)) / (mu * q ^ n)) ^ 2)) t :=
    (Real.continuous_exp.continuousAt.comp
      (continuousAt_const.mul (hratio.pow 2)))
  unfold scalarG gaussianAt kernelAt kernelDilate gaussian
  exact hinv.smul hexp

/-- Scale differentiability of the scalar derivative-Gaussian factor away
from zero scale. -/
theorem differentiableAt_scalarH_scale {mu sig : ℝ} {n : ℕ} {t p u : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    DifferentiableAt ℝ (fun q : ℝ ↦ scalarH mu sig n q p u) t := by
  have hscale : mu * t ^ n ≠ 0 :=
    mul_ne_zero hmu (pow_ne_zero n ht)
  unfold scalarH gaussianDerivAt kernelAt kernelDilate gaussianDeriv gaussian
  fun_prop (disch := exact hscale)

theorem continuousAt_scalarH_scale {mu sig : ℝ} {n : ℕ} {t p u : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    ContinuousAt (fun q : ℝ ↦ scalarH mu sig n q p u) t :=
  (differentiableAt_scalarH_scale hmu ht).continuousAt

/-- The standardized scalar coordinate is differentiable, hence continuous,
on the nonzero scale half-line. -/
theorem differentiableAt_scalarZ_scale {mu sig : ℝ} {n : ℕ} {t p u : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    DifferentiableAt ℝ (fun q : ℝ ↦ scalarZ mu sig n q p u) t := by
  have hscale : mu * t ^ n ≠ 0 :=
    mul_ne_zero hmu (pow_ne_zero n ht)
  have hpow : HasDerivAt (fun q : ℝ ↦ q ^ n)
      ((n : ℝ) * t ^ (n - 1)) t := by
    simpa using hasDerivAt_pow n t
  have hs : HasDerivAt (fun q : ℝ ↦ mu * q ^ n)
      (mu * ((n : ℝ) * t ^ (n - 1))) t := by
    convert hpow.const_mul mu using 1
  have hcenter : HasDerivAt (fun q : ℝ ↦ p + sig * q ^ n)
      (sig * ((n : ℝ) * t ^ (n - 1))) t := by
    convert (hpow.const_mul sig).const_add p using 1
  have hnum : HasDerivAt (fun q : ℝ ↦ u - (p + sig * q ^ n))
      (-(sig * ((n : ℝ) * t ^ (n - 1)))) t := by
    convert hcenter.const_sub u using 1
  change DifferentiableAt ℝ
    (fun q : ℝ ↦ (u - (p + sig * q ^ n)) / (mu * q ^ n)) t
  exact hnum.differentiableAt.fun_div hs.differentiableAt hscale

theorem continuousAt_scalarZ_scale {mu sig : ℝ} {n : ℕ} {t p u : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    ContinuousAt (fun q : ℝ ↦ scalarZ mu sig n q p u) t :=
  (differentiableAt_scalarZ_scale hmu ht).continuousAt

/-- The explicit scalar scale-derivative formula is continuous at every
nonzero scale. -/
theorem continuousAt_scalarDdot_scale
    {mu sig : ℝ} {n : ℕ} {t p u0 u1 : ℝ}
    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    ContinuousAt (fun q : ℝ ↦
      deriv (fun s : ℝ ↦ scalarD mu sig n s p u0 u1) q) t := by
  let d : ℝ → ℝ := fun q ↦
    -(n : ℝ) / q *
      (2 * scalarD mu sig n q p u0 u1 +
        (scalarZ mu sig n q p u0 + sig / mu) * scalarH mu sig n q p u0 *
          scalarG mu sig n q p u1 +
        (scalarZ mu sig n q p u1 + sig / mu) * scalarG mu sig n q p u0 *
          scalarH mu sig n q p u1)
  have hscale : mu * t ^ n ≠ 0 :=
    mul_ne_zero hmu (pow_ne_zero n ht)
  have hform : ContinuousAt d t := by
    dsimp only [d]
    fun_prop (disch := assumption) [scalarD, scalarG, scalarH, scalarZ,
      gaussianAt, gaussianDerivAt, kernelAt, kernelDilate, gaussian, gaussianDeriv]
  have heq : (fun q : ℝ ↦
      deriv (fun s : ℝ ↦ scalarD mu sig n s p u0 u1) q) =ᶠ[𝓝 t] d := by
    filter_upwards [eventually_ne_nhds ht] with q hq
    exact (hasDerivAt_scalarD_scale hmu hq).deriv
  exact hform.congr_of_eventuallyEq heq

/-- A coordinate-pair factor is differentiable at every nonzero scale. -/
theorem differentiableAt_cubeCoordinateD_scale_ne_zero
    (α : Anisotropy) (i : Fin 3) {lam t : ℝ} (r : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (ht : t ≠ 0) :
    DifferentiableAt ℝ (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t := by
  have hwidth : cubeWidth i lam ≠ 0 :=
    (cubeWidth_pos_of_one_le i hlam).ne'
  simpa only [cubeCoordinateD_eq_scalarD] using
    (hasDerivAt_scalarD_scale (mu := cubeWidth i lam)
      (sig := cubeCenterShift i r) (n := α.weight i) (t := t)
      (p := p i) (u0 := x (i, false)) (u1 := x (i, true))
      hwidth ht).differentiableAt

theorem differentiableAt_cubeCoordinateD_scale
    (α : Anisotropy) (i : Fin 3) {lam t : ℝ} (r : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    DifferentiableAt ℝ (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t := by
  exact differentiableAt_cubeCoordinateD_scale_ne_zero α i r p x hlam ht.ne'

theorem continuousAt_cubeCoordinateD_scale
    (α : Anisotropy) (i : Fin 3) {lam t : ℝ} (r : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    ContinuousAt (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t :=
  (differentiableAt_cubeCoordinateD_scale α i r p x hlam ht).continuousAt

/-- Positive-scale continuity of the scale derivative of a coordinate-pair
factor. -/
theorem continuousAt_cubeCoordinateDdot_scale
    (α : Anisotropy) (i : Fin 3) {lam t : ℝ} (r : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    ContinuousAt (fun q : ℝ ↦
      deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) q) t := by
  have hwidth : cubeWidth i lam ≠ 0 :=
    (cubeWidth_pos_of_one_le i hlam).ne'
  simpa only [cubeCoordinateD_eq_scalarD] using
    (continuousAt_scalarDdot_scale
      (mu := cubeWidth i lam) (sig := cubeCenterShift i r)
      (n := α.weight i) (t := t) (p := p i)
      (u0 := x (i, false)) (u1 := x (i, true)) hwidth ht.ne')

/-- The endpoint product is differentiable at every positive scale. -/
theorem differentiableAt_cubeEndpointKernel_scale
    (α : Anisotropy) {lam t : ℝ} (r : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    DifferentiableAt ℝ (fun s : ℝ ↦ cubeEndpointKernel α lam r s p x) t := by
  simp only [cubeEndpointKernel, Fin.prod_univ_three]
  exact
    ((differentiableAt_cubeCoordinateD_scale α 0 r p x hlam ht).mul
      (differentiableAt_cubeCoordinateD_scale α 1 r p x hlam ht)).mul
      (differentiableAt_cubeCoordinateD_scale α 2 r p x hlam ht)

/-- The derivative of the endpoint product is continuous at every positive
scale. -/
theorem continuousAt_cubeEndpointKernel_deriv_scale
    (α : Anisotropy) {lam t : ℝ} (r : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    ContinuousAt (fun q : ℝ ↦
      deriv (fun s : ℝ ↦ cubeEndpointKernel α lam r s p x) q) t := by
  let D : Fin 3 → ℝ → ℝ := fun i q ↦ cubeCoordinateD α i lam r q p x
  let d : ℝ → ℝ := fun q ↦
    (deriv (D 0) q * D 1 q + D 0 q * deriv (D 1) q) * D 2 q +
      (D 0 q * D 1 q) * deriv (D 2) q
  have hD0 : ContinuousAt (D 0) t := by
    dsimp only [D]
    exact continuousAt_cubeCoordinateD_scale α 0 r p x hlam ht
  have hD1 : ContinuousAt (D 1) t := by
    dsimp only [D]
    exact continuousAt_cubeCoordinateD_scale α 1 r p x hlam ht
  have hD2 : ContinuousAt (D 2) t := by
    dsimp only [D]
    exact continuousAt_cubeCoordinateD_scale α 2 r p x hlam ht
  have hdD0 : ContinuousAt (fun q : ℝ ↦ deriv (D 0) q) t := by
    dsimp only [D]
    exact continuousAt_cubeCoordinateDdot_scale α 0 r p x hlam ht
  have hdD1 : ContinuousAt (fun q : ℝ ↦ deriv (D 1) q) t := by
    dsimp only [D]
    exact continuousAt_cubeCoordinateDdot_scale α 1 r p x hlam ht
  have hdD2 : ContinuousAt (fun q : ℝ ↦ deriv (D 2) q) t := by
    dsimp only [D]
    exact continuousAt_cubeCoordinateDdot_scale α 2 r p x hlam ht
  have hform : ContinuousAt d t := by
    dsimp only [d]
    exact (((hdD0.mul hD1).add (hD0.mul hdD1)).mul hD2).add
      ((hD0.mul hD1).mul hdD2)
  have heq : (fun q : ℝ ↦
      deriv (fun s : ℝ ↦ cubeEndpointKernel α lam r s p x) q) =ᶠ[𝓝 t] d := by
    filter_upwards [eventually_ne_nhds ht.ne'] with q hq
    have hd0 : DifferentiableAt ℝ (D 0) q := by
      dsimp only [D]
      exact differentiableAt_cubeCoordinateD_scale_ne_zero α 0 r p x hlam hq
    have hd1 : DifferentiableAt ℝ (D 1) q := by
      dsimp only [D]
      exact differentiableAt_cubeCoordinateD_scale_ne_zero α 1 r p x hlam hq
    have hd2 : DifferentiableAt ℝ (D 2) q := by
      dsimp only [D]
      exact differentiableAt_cubeCoordinateD_scale_ne_zero α 2 r p x hlam hq
    simp only [cubeEndpointKernel, Fin.prod_univ_three]
    change deriv ((D 0 * D 1) * D 2) q = d q
    rw [deriv_mul (hd0.mul hd1) hd2, deriv_mul hd0 hd1]
    rfl
  exact hform.congr_of_eventuallyEq heq

/-- The fixed-`(p,x)` scale fundamental-theorem-of-calculus step: the two
endpoint kernels differ by the logarithmic scale integral of their derivative. -/
theorem cubeEndpointKernel_scale_FTC
    (α : Anisotropy) {lam L : ℝ} (r : ℝ) (p : E3) (x : E6)
    (hlam : 1 ≤ lam) (hL : 0 < L) :
    cubeEndpointKernel α lam r (L / 2) p x - cubeEndpointKernel α lam r L p x =
      ∫ t in L / 2..L,
        (-t * deriv (fun s : ℝ ↦ cubeEndpointKernel α lam r s p x) t) / t := by
  let K : ℝ → ℝ := fun s ↦ cubeEndpointKernel α lam r s p x
  have hhalf : 0 < L / 2 := by linarith
  have hle : L / 2 ≤ L := by linarith
  have hderiv : ∀ s ∈ Set.uIcc (L / 2) L, DifferentiableAt ℝ K s := by
    intro s hs
    rw [Set.uIcc_of_le hle] at hs
    have hspos : 0 < s := lt_of_lt_of_le hhalf hs.1
    dsimp only [K]
    exact differentiableAt_cubeEndpointKernel_scale α r p x hlam hspos
  have hcont : ContinuousOn (deriv K) (Set.uIcc (L / 2) L) := by
    intro s hs
    rw [Set.uIcc_of_le hle] at hs
    have hspos : 0 < s := lt_of_lt_of_le hhalf hs.1
    simpa only [K] using
      (continuousAt_cubeEndpointKernel_deriv_scale α r p x hlam hspos).continuousWithinAt
  have hFTC : (∫ s in L / 2..L, deriv K s) = K L - K (L / 2) :=
    intervalIntegral.integral_deriv_eq_sub hderiv hcont.intervalIntegrable
  change K (L / 2) - K L =
    ∫ t in L / 2..L, (-t * deriv K t) / t
  calc
    K (L / 2) - K L = -(K L - K (L / 2)) := by ring
    _ = -(∫ s in L / 2..L, deriv K s) := by rw [hFTC]
    _ = ∫ s in L / 2..L, -deriv K s := by
      rw [intervalIntegral.integral_neg]
    _ = ∫ s in L / 2..L, (-s * deriv K s) / s := by
      apply intervalIntegral.integral_congr
      intro s hs
      rw [Set.uIcc_of_le hle] at hs
      have hspos : 0 < s := lt_of_lt_of_le hhalf hs.1
      symm
      apply (div_eq_iff hspos.ne').2
      ring

/-- The source box-derivative identity before the scale FTC: integrate the
three-term endpoint-kernel product rule and use the fixed-`x` coordinate
telescope in each summand. -/
theorem integral_boxSet_cubeEndpointKernel_scale_derivative
    (α : Anisotropy) (Q : AnisoBox α) (lam r t : ℝ) (x : E6)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    (∫ p : E3 in boxSet α Q,
      -t * deriv (fun s : ℝ ↦ cubeEndpointKernel α lam r s p x) t) =
      ∑ i : Fin 3,
        ∫ y in transverseRectangle α Q i,
          ((α.weight i : ℝ) / Real.pi *
              (∫ u in boxFaceCoordinate α Q i FaceOrientation.lower..
                boxFaceCoordinate α Q i FaceOrientation.upper,
                cubeCoordinateP α i lam r t (faceInsert i u y) x) +
            (α.weight i : ℝ) * t ^ α.weight i *
              (cubeBoundaryKernel α i lam r t
                (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.upper) y) x -
              cubeBoundaryKernel α i lam r t
                (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.lower) y) x)) *
            ∏ m ∈ Finset.univ.erase i,
              cubeCoordinateD α m lam r t (faceInsert i 0 y) x := by
  let term : Fin 3 → E3 → ℝ := fun i p ↦
    (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t) *
      ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x
  have hterm (i : Fin 3) : IntegrableOn (term i) (boxSet α Q) := by
    exact integrableOn_cubeCoordinateTelescopeIntegrand_boxSet α Q i r x hlam ht
  calc
    (∫ p : E3 in boxSet α Q,
      -t * deriv (fun s : ℝ ↦ cubeEndpointKernel α lam r s p x) t) =
        ∫ p : E3 in boxSet α Q, ∑ i : Fin 3, term i p := by
      apply integral_congr_ae
      filter_upwards [] with p
      exact cubeEndpointKernel_scale_derivative α lam r t p x hlam ht
    _ = ∑ i : Fin 3, ∫ p : E3 in boxSet α Q, term i p := by
      apply MeasureTheory.integral_finsetSum
      intro i hi
      exact hterm i
    _ = _ := by
      apply Finset.sum_congr rfl
      intro i hi
      exact cubeCoordinate_box_telescoping_of_pos α Q i r x hlam ht

/-- Neighboring boxes have the same literal half-open transverse rectangle
across their common `i`-face. -/
theorem transverseRectangle_neighbor_eq (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) (ε : FaceOrientation) :
    transverseRectangle α (boxNeighbor α q i ε) i = transverseRectangle α q i := by
  unfold transverseRectangle
  congr 1
  apply Set.pi_congr rfl
  intro j _
  exact boxInterval_neighbor_eq_of_ne α q j.2 ε

/-- The two oriented records of one geometric grid face give the same local
boundary integral: both the transverse domain and the inserted face coordinate
are literal equalities. -/
theorem cubeFaceIntegral_oppositeOrientedFace (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) (lam r t : ℝ) (F : CubeVertex → E3 → ℝ) :
    cubeFaceIntegral α i (oppositeOrientedFace α i S) lam r t F =
      cubeFaceIntegral α i S lam r t F := by
  rcases S with ⟨q, ε⟩
  simp only [oppositeOrientedFace, cubeFaceIntegral]
  rw [transverseRectangle_neighbor_eq]
  rw [← boxFaceCoordinate_neighbor_opposite]

/-- With the source orientation sign, the two incident records of a face have
opposite boundary contributions. -/
theorem orientedFace_sign_mul_cubeFaceIntegral_opposite (α : Anisotropy)
    (i : Fin 3) (S : OrientedFace α) (lam r t : ℝ)
    (F : CubeVertex → E3 → ℝ) :
    ((oppositeOrientedFace α i S).orientation.sign : ℝ) *
        cubeFaceIntegral α i (oppositeOrientedFace α i S) lam r t F =
      -((S.orientation.sign : ℝ) * cubeFaceIntegral α i S lam r t F) := by
  rw [cubeFaceIntegral_oppositeOrientedFace]
  rw [oppositeOrientedFace_orientation, FaceOrientation.sign_opposite]
  push_cast
  ring

/-- The actual fixed-scale boundary integrals over all incident faces of a
tree reduce to the source's surviving-face sum: every interior pair cancels
with its opposite oriented record. -/
theorem sum_treeOrientedFaces_signed_cubeFaceIntegral_eq_surviving
    (α : Anisotropy) (T : FiniteConvexTree α) (i : Fin 3)
    (lam r t : ℝ) (F : CubeVertex → E3 → ℝ) :
    (∑ S ∈ treeOrientedFaces T,
      (S.orientation.sign : ℝ) * cubeFaceIntegral α i S lam r t F) =
      ∑ S ∈ survivingFacesAll T i,
        (S.orientation.sign : ℝ) * cubeFaceIntegral α i S lam r t F := by
  apply sum_treeOrientedFaces_eq_sum_surviving_of_opposite T i
  intro S
  rw [orientedFace_sign_mul_cubeFaceIntegral_opposite]
  ring

/-- The source boundary summand attached to one oriented face, including the
scale interval of its incident box. -/
noncomputable def cubeFaceScaleIntegral (α : Anisotropy) (i : Fin 3)
    (S : OrientedFace α) (lam r : ℝ) (F : CubeVertex → E3 → ℝ) : ℝ :=
  ∫ t : ℝ in Set.Ioc (boxLength S.box / 2) (boxLength S.box),
    t ^ (α.weight i - 1) * cubeFaceIntegral α i S lam r t F

/-- The original per-box boundary form before interior faces have been
cancelled. -/
noncomputable def cubeBoxBoundaryForm (α : Anisotropy) (q : AnisoBox α)
    (lam r : ℝ) (F : CubeVertex → E3 → ℝ) : ℝ :=
  -Real.pi * ∑ i : Fin 3, (α.weight i : ℝ) *
    (cubeFaceScaleIntegral α i ⟨q, FaceOrientation.upper⟩ lam r F -
      cubeFaceScaleIntegral α i ⟨q, FaceOrientation.lower⟩ lam r F)

/-- The finite-tree sum of its box-wise boundary contributions. -/
noncomputable def cubeTreeBoxBoundaryForm (α : Anisotropy)
    (T : FiniteConvexTree α) (lam r : ℝ) (F : CubeVertex → E3 → ℝ) : ℝ :=
  ∑ q ∈ T.boxes, cubeBoxBoundaryForm α q lam r F

theorem boxLength_neighbor (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) (ε : FaceOrientation) :
    boxLength (boxNeighbor α q i ε) = boxLength q := by
  rfl

theorem cubeFaceScaleIntegral_oppositeOrientedFace (α : Anisotropy)
    (i : Fin 3) (S : OrientedFace α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) :
    cubeFaceScaleIntegral α i (oppositeOrientedFace α i S) lam r F =
      cubeFaceScaleIntegral α i S lam r F := by
  unfold cubeFaceScaleIntegral
  change
    (∫ t : ℝ in Set.Ioc
        (boxLength (boxNeighbor α S.box i S.orientation) / 2)
        (boxLength (boxNeighbor α S.box i S.orientation)),
      t ^ (α.weight i - 1) *
        cubeFaceIntegral α i (oppositeOrientedFace α i S) lam r t F) = _
  rw [boxLength_neighbor]
  apply integral_congr_ae
  filter_upwards [] with t
  rw [cubeFaceIntegral_oppositeOrientedFace]

theorem signed_cubeFaceScaleIntegral_oppositeOrientedFace (α : Anisotropy)
    (i : Fin 3) (S : OrientedFace α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) :
    ((oppositeOrientedFace α i S).orientation.sign : ℝ) *
        cubeFaceScaleIntegral α i (oppositeOrientedFace α i S) lam r F =
      -((S.orientation.sign : ℝ) *
        cubeFaceScaleIntegral α i S lam r F) := by
  rw [cubeFaceScaleIntegral_oppositeOrientedFace]
  rw [oppositeOrientedFace_orientation, FaceOrientation.sign_opposite]
  push_cast
  ring

theorem sum_treeOrientedFaces_signed_cubeFaceScaleIntegral_eq_surviving
    (α : Anisotropy) (T : FiniteConvexTree α) (i : Fin 3)
    (lam r : ℝ) (F : CubeVertex → E3 → ℝ) :
    (∑ S ∈ treeOrientedFaces T,
      (S.orientation.sign : ℝ) *
        cubeFaceScaleIntegral α i S lam r F) =
      ∑ S ∈ survivingFacesAll T i,
        (S.orientation.sign : ℝ) *
          cubeFaceScaleIntegral α i S lam r F := by
  apply sum_treeOrientedFaces_eq_sum_surviving_of_opposite T i
  intro S
  rw [signed_cubeFaceScaleIntegral_oppositeOrientedFace]
  ring

theorem orientedFacesOfBox_disjoint (q q' : AnisoBox α) (hqq' : q ≠ q') :
    Disjoint (orientedFacesOfBox q) (orientedFacesOfBox q') := by
  rw [Finset.disjoint_left]
  intro S hS hS'
  have hq : S.box = q := (mem_orientedFacesOfBox_iff q S).mp hS
  have hq' : S.box = q' := (mem_orientedFacesOfBox_iff q' S).mp hS'
  exact hqq' (hq.symm.trans hq')

theorem sum_treeOrientedFaces_eq_sum_boxes_orientedFaces
    (T : FiniteConvexTree α) (f : OrientedFace α → ℝ) :
    (∑ S ∈ treeOrientedFaces T, f S) =
      ∑ q ∈ T.boxes, ∑ S ∈ orientedFacesOfBox q, f S := by
  unfold treeOrientedFaces
  rw [Finset.sum_biUnion]
  intro q hq q' hq' hqq'
  exact orientedFacesOfBox_disjoint q q' hqq'

theorem sum_orientedFacesOfBox_signed (q : AnisoBox α)
    (f : OrientedFace α → ℝ) :
    (∑ S ∈ orientedFacesOfBox q, (S.orientation.sign : ℝ) * f S) =
      f ⟨q, FaceOrientation.upper⟩ - f ⟨q, FaceOrientation.lower⟩ := by
  rw [orientedFacesOfBox, Finset.sum_image]
  · have hfaces : (Finset.univ : Finset FaceOrientation) =
        {FaceOrientation.lower, FaceOrientation.upper} := by
      decide
    rw [hfaces]
    simp [FaceOrientation.sign]
    ring
  · intro ε hε ε' hε' h
    exact congrArg OrientedFace.orientation h

theorem cubeBoxBoundaryForm_eq_orientedFaceSum
    (α : Anisotropy) (q : AnisoBox α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) :
    cubeBoxBoundaryForm α q lam r F =
      -Real.pi * ∑ i : Fin 3, (α.weight i : ℝ) *
        ∑ S ∈ orientedFacesOfBox q,
          (S.orientation.sign : ℝ) *
            cubeFaceScaleIntegral α i S lam r F := by
  unfold cubeBoxBoundaryForm
  congr 2
  funext i
  rw [sum_orientedFacesOfBox_signed]

theorem sum_box_weighted_faceSums
    (T : FiniteConvexTree α) (c : ℝ) (a : Fin 3 → ℝ)
    (B : Fin 3 → AnisoBox α → ℝ) :
    (∑ q ∈ T.boxes, c * ∑ i : Fin 3, a i * B i q) =
      c * ∑ i : Fin 3, a i * ∑ q ∈ T.boxes, B i q := by
  calc
    (∑ q ∈ T.boxes, c * ∑ i : Fin 3, a i * B i q) =
        ∑ q ∈ T.boxes, ∑ i : Fin 3, c * (a i * B i q) := by
          apply Finset.sum_congr rfl
          intro q hq
          rw [Finset.mul_sum]
    _ = ∑ i : Fin 3, ∑ q ∈ T.boxes, c * (a i * B i q) := by
          exact Finset.sum_comm
    _ = ∑ i : Fin 3, c * (a i * ∑ q ∈ T.boxes, B i q) := by
          apply Finset.sum_congr rfl
          intro i hi
          calc
            (∑ q ∈ T.boxes, c * (a i * B i q)) =
                ∑ q ∈ T.boxes, (c * a i) * B i q := by
                  apply Finset.sum_congr rfl
                  intro q hq
                  ring
            _ = (c * a i) * ∑ q ∈ T.boxes, B i q := by
                  rw [Finset.mul_sum]
            _ = c * (a i * ∑ q ∈ T.boxes, B i q) := by ring
    _ = c * ∑ i : Fin 3, a i * ∑ q ∈ T.boxes, B i q := by
          rw [Finset.mul_sum]

theorem cubeTreeBoxBoundaryForm_eq_treeOrientedFaceScaleSum
    (α : Anisotropy) (T : FiniteConvexTree α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) :
    cubeTreeBoxBoundaryForm α T lam r F =
      -Real.pi * ∑ i : Fin 3, (α.weight i : ℝ) *
        ∑ S ∈ treeOrientedFaces T,
          (S.orientation.sign : ℝ) *
            cubeFaceScaleIntegral α i S lam r F := by
  unfold cubeTreeBoxBoundaryForm
  simp_rw [cubeBoxBoundaryForm_eq_orientedFaceSum]
  rw [sum_box_weighted_faceSums T (-Real.pi) (fun i ↦ (α.weight i : ℝ))
    (fun i q ↦ ∑ S ∈ orientedFacesOfBox q,
      (S.orientation.sign : ℝ) * cubeFaceScaleIntegral α i S lam r F)]
  congr 2
  funext i
  rw [← sum_treeOrientedFaces_eq_sum_boxes_orientedFaces T]

/-- Exact source `lem:face_cancellation`: the sum of all box-wise
upper-minus-lower boundary terms equals the surviving oriented-face form, with
each face retaining precisely its own scale band. -/
theorem cubeTreeBoxBoundaryForm_eq_cubeBoundaryFaceForm
    (α : Anisotropy) (T : FiniteConvexTree α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) :
    cubeTreeBoxBoundaryForm α T lam r F =
      cubeBoundaryFaceForm α T lam r F := by
  rw [cubeTreeBoxBoundaryForm_eq_treeOrientedFaceScaleSum]
  rw [show (∑ i : Fin 3, (α.weight i : ℝ) *
      ∑ S ∈ treeOrientedFaces T,
        (S.orientation.sign : ℝ) *
          cubeFaceScaleIntegral α i S lam r F) =
    ∑ i : Fin 3, (α.weight i : ℝ) *
      ∑ S ∈ survivingFacesAll T i,
        (S.orientation.sign : ℝ) *
          cubeFaceScaleIntegral α i S lam r F by
    apply Finset.sum_congr rfl
    intro i hi
    rw [sum_treeOrientedFaces_signed_cubeFaceScaleIntegral_eq_surviving]]
  unfold cubeBoundaryFaceForm cubeFaceScaleIntegral
  rfl

@[simp]
theorem cubeWidth_zero (lam : ℝ) : cubeWidth 0 lam = lam := by
  simp [cubeWidth]

@[simp]
theorem cubeWidth_one (lam : ℝ) : cubeWidth 1 lam = lam := by
  simp [cubeWidth]

@[simp]
theorem cubeWidth_two (lam : ℝ) : cubeWidth 2 lam = 1 := by
  simp [cubeWidth]

@[simp]
theorem cubeCenterShift_zero (r : ℝ) : cubeCenterShift 0 r = 0 := by
  simp [cubeCenterShift]

@[simp]
theorem cubeCenterShift_one (r : ℝ) : cubeCenterShift 1 r = 0 := by
  simp [cubeCenterShift]

@[simp]
theorem cubeCenterShift_two (r : ℝ) : cubeCenterShift 2 r = r := by
  simp [cubeCenterShift]

/-- The scale-domination estimate is stable under a positive ambient
dilation and translation of the center. -/
theorem gaussian_pair_scale_bracket_dilate :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (lam s p v : ℝ), 1 ≤ lam → 0 < s →
      |gaussianAt (lam * s) p v| + |gaussianDerivAt (lam * s) p v| ≤
        C * lam ^ 9 * bracketKernelAt s p v := by
  rcases gaussian_pair_scale_bracket_domination with ⟨C, hC, hdom⟩
  refine ⟨C, hC, ?_⟩
  intro lam s p v hlam hs
  have h := hdom lam ((v - p) / s) hlam
  have hsInv : 0 ≤ s⁻¹ := inv_nonneg.mpr hs.le
  have hmul := mul_le_mul_of_nonneg_left h hsInv
  have hlam0 : lam ≠ 0 := by linarith
  have hs0 : s ≠ 0 := hs.ne'
  have hgauss : gaussianAt (lam * s) p v =
      s⁻¹ * gaussianAt lam 0 ((v - p) / s) := by
    change (lam * s)⁻¹ * gaussian ((v - p) / (lam * s)) =
      s⁻¹ * (lam⁻¹ * gaussian (((v - p) / s - 0) / lam))
    have harg : (v - p) / (lam * s) = ((v - p) / s - 0) / lam := by
      field_simp
      ring
    rw [harg]
    field_simp
  have hderiv : gaussianDerivAt (lam * s) p v =
      s⁻¹ * gaussianDerivAt lam 0 ((v - p) / s) := by
    change (lam * s)⁻¹ * gaussianDeriv ((v - p) / (lam * s)) =
      s⁻¹ * (lam⁻¹ * gaussianDeriv (((v - p) / s - 0) / lam))
    have harg : (v - p) / (lam * s) = ((v - p) / s - 0) / lam := by
      field_simp
      ring
    rw [harg]
    field_simp
  have hbracket : bracketKernelAt s p v =
      s⁻¹ * bracketKernel ((v - p) / s) := by
    simp only [bracketKernelAt, kernelAt, kernelDilate, smul_eq_mul]
  rw [hgauss, hderiv, hbracket]
  rw [abs_mul, abs_mul, abs_of_nonneg hsInv]
  simpa [mul_add, mul_assoc, mul_left_comm, mul_comm] using hmul

/-- The translated domination estimate is likewise stable under a positive
ambient dilation. -/
theorem gaussian_pair_translate_bracket_dilate :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (r s p v : ℝ), 0 < s →
      |gaussianAt s (p + s * r) v| + |gaussianDerivAt s (p + s * r) v| ≤
        C * translationWeight r ^ 10 * bracketKernelAt s p v := by
  rcases gaussian_pair_translate_bracket_domination with ⟨C, hC, hdom⟩
  refine ⟨C, hC, ?_⟩
  intro r s p v hs
  have h := hdom r ((v - p) / s)
  have hsInv : 0 ≤ s⁻¹ := inv_nonneg.mpr hs.le
  have hmul := mul_le_mul_of_nonneg_left h hsInv
  have hs0 : s ≠ 0 := hs.ne'
  have hgauss : gaussianAt s (p + s * r) v =
      s⁻¹ * gaussianAt 1 r ((v - p) / s) := by
    change s⁻¹ * gaussian ((v - (p + s * r)) / s) =
      s⁻¹ * (1⁻¹ * gaussian (((v - p) / s - r) / 1))
    have harg : (v - (p + s * r)) / s = ((v - p) / s - r) / 1 := by
      field_simp
      ring
    rw [harg]
    ring
  have hderiv : gaussianDerivAt s (p + s * r) v =
      s⁻¹ * gaussianDerivAt 1 r ((v - p) / s) := by
    change s⁻¹ * gaussianDeriv ((v - (p + s * r)) / s) =
      s⁻¹ * (1⁻¹ * gaussianDeriv (((v - p) / s - r) / 1))
    have harg : (v - (p + s * r)) / s = ((v - p) / s - r) / 1 := by
      field_simp
      ring
    rw [harg]
    ring
  have hbracket : bracketKernelAt s p v =
      s⁻¹ * bracketKernel ((v - p) / s) := by
    simp only [bracketKernelAt, kernelAt, kernelDilate, smul_eq_mul]
  rw [hgauss, hderiv, hbracket]
  rw [abs_mul, abs_mul, abs_of_nonneg hsInv]
  simpa [mul_add, mul_assoc, mul_left_comm, mul_comm] using hmul

/-- A source-facing one-coordinate bound for either the Gaussian or its
derivative.  The first two coordinates carry the `λ^9` loss, while the third
carries the translated `R(r)^10` loss. -/
theorem cubeGaussian_pair_domination (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (j : Fin 3) (lam r t : ℝ) (p : E3) (v : ℝ),
      1 ≤ lam → 0 < t →
      |cubeGaussianKernel α lam r t p j v| +
        |cubeGaussianDerivKernel α lam r t p j v| ≤
        C * (if j = 2 then translationWeight r ^ 10 else lam ^ 9) *
          bracketKernelAt (t ^ α.weight j) (p j) v := by
  rcases gaussian_pair_scale_bracket_dilate with ⟨Cs, hCs, hs⟩
  rcases gaussian_pair_translate_bracket_dilate with ⟨Ct, hCt, ht⟩
  refine ⟨max Cs Ct, le_trans hCs (le_max_left _ _), ?_⟩
  intro j lam r t p v hlam htpos
  have htj : 0 < t ^ α.weight j := pow_pos htpos _
  fin_cases j
  · have h := hs lam (t ^ α.weight 0) (p 0) v hlam htj
    have hC : Cs ≤ max Cs Ct := le_max_left _ _
    calc
      |cubeGaussianKernel α lam r t p 0 v| +
          |cubeGaussianDerivKernel α lam r t p 0 v| =
          |gaussianAt (lam * t ^ α.weight 0) (p 0) v| +
            |gaussianDerivAt (lam * t ^ α.weight 0) (p 0) v| := by
              simp [cubeGaussianKernel, cubeGaussianDerivKernel, cubeWidth,
                cubeCenterShift]
      _ ≤ Cs * lam ^ 9 * bracketKernelAt (t ^ α.weight 0) (p 0) v := h
      _ ≤ max Cs Ct * lam ^ 9 * bracketKernelAt (t ^ α.weight 0) (p 0) v := by
        rw [mul_assoc, mul_assoc]
        apply mul_le_mul_of_nonneg_right hC
        exact mul_nonneg (pow_nonneg (by linarith) _)
          (bracketKernelAt_nonneg (s := t ^ α.weight 0) (a := p 0) (x := v) htj.le)
      _ = max Cs Ct * (if (0 : Fin 3) = 2 then translationWeight r ^ 10 else lam ^ 9) *
          bracketKernelAt (t ^ α.weight 0) (p 0) v := by simp
  · have h := hs lam (t ^ α.weight 1) (p 1) v hlam htj
    have hC : Cs ≤ max Cs Ct := le_max_left _ _
    calc
      |cubeGaussianKernel α lam r t p 1 v| +
          |cubeGaussianDerivKernel α lam r t p 1 v| =
          |gaussianAt (lam * t ^ α.weight 1) (p 1) v| +
            |gaussianDerivAt (lam * t ^ α.weight 1) (p 1) v| := by
              simp [cubeGaussianKernel, cubeGaussianDerivKernel, cubeWidth,
                cubeCenterShift]
      _ ≤ Cs * lam ^ 9 * bracketKernelAt (t ^ α.weight 1) (p 1) v := h
      _ ≤ max Cs Ct * lam ^ 9 * bracketKernelAt (t ^ α.weight 1) (p 1) v := by
        rw [mul_assoc, mul_assoc]
        apply mul_le_mul_of_nonneg_right hC
        exact mul_nonneg (pow_nonneg (by linarith) _)
          (bracketKernelAt_nonneg (s := t ^ α.weight 1) (a := p 1) (x := v) htj.le)
      _ = max Cs Ct * (if (1 : Fin 3) = 2 then translationWeight r ^ 10 else lam ^ 9) *
          bracketKernelAt (t ^ α.weight 1) (p 1) v := by simp
  · have h := ht r (t ^ α.weight 2) (p 2) v htj
    have hC : Ct ≤ max Cs Ct := le_max_right _ _
    calc
      |cubeGaussianKernel α lam r t p 2 v| +
          |cubeGaussianDerivKernel α lam r t p 2 v| =
          |gaussianAt (t ^ α.weight 2) (p 2 + t ^ α.weight 2 * r) v| +
            |gaussianDerivAt (t ^ α.weight 2) (p 2 + t ^ α.weight 2 * r) v| := by
              simp [cubeGaussianKernel, cubeGaussianDerivKernel, cubeWidth,
                cubeCenterShift]
              ring_nf
      _ ≤ Ct * translationWeight r ^ 10 * bracketKernelAt (t ^ α.weight 2) (p 2) v := h
      _ ≤ max Cs Ct * translationWeight r ^ 10 *
          bracketKernelAt (t ^ α.weight 2) (p 2) v := by
        rw [mul_assoc, mul_assoc]
        apply mul_le_mul_of_nonneg_right hC
        have hR : 0 ≤ translationWeight r := by
          unfold translationWeight
          positivity
        exact mul_nonneg (pow_nonneg hR _)
          (bracketKernelAt_nonneg (s := t ^ α.weight 2) (a := p 2) (x := v) htj.le)
      _ = max Cs Ct * (if (2 : Fin 3) = 2 then translationWeight r ^ 10 else lam ^ 9) *
          bracketKernelAt (t ^ α.weight 2) (p 2) v := by simp

/-- Exact multiplication of the six pointwise majorants. -/
theorem cubeKernel_majorant_prod_eq (α : Anisotropy) (C lam r t : ℝ)
    (p : E3) (x : E6) :
    (∏ q : Fin 3 × Bool,
      C * (if q.1 = 2 then translationWeight r ^ 10 else lam ^ 9) *
        bracketKernelAt (t ^ α.weight q.1) (p q.1) (x q)) =
      C ^ 6 * lam ^ 36 * translationWeight r ^ 20 * cubeBracketWeight α t p x := by
  simp [cubeBracketWeight, Fintype.prod_prod_type, Fin.prod_univ_three]
  ring

/-- Each literal factor in the local six-kernel is controlled by the
corresponding one-coordinate source majorant. -/
theorem localCubeKernel_factor_domination (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i j : Fin 3) (lam r t : ℝ) (p : E3) (v : ℝ),
      1 ≤ lam → 0 < t →
      |if j = i then
        cubeGaussianDerivKernel α lam r t p j v
      else cubeGaussianKernel α lam r t p j v| ≤
        C * (if j = 2 then translationWeight r ^ 10 else lam ^ 9) *
          bracketKernelAt (t ^ α.weight j) (p j) v := by
  rcases cubeGaussian_pair_domination α with ⟨C, hC, hpair⟩
  refine ⟨C, hC, ?_⟩
  intro i j lam r t p v hlam ht
  have h := hpair j lam r t p v hlam ht
  by_cases hji : j = i
  · rw [if_pos hji]
    exact (le_add_of_nonneg_left (abs_nonneg _)).trans h
  · rw [if_neg hji]
    exact (le_add_of_nonneg_right (abs_nonneg _)).trans h

/-- The same source exponents control every choice of one Gaussian or one
derivative-Gaussian in each of the six coordinate slots. -/
theorem cubeGaussian_sixfold_domination (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (choose : Fin 3 × Bool → Bool)
      (lam r t : ℝ) (p : E3) (x : E6), 1 ≤ lam → 0 < t →
      (∏ q : Fin 3 × Bool,
        |if choose q then
          cubeGaussianDerivKernel α lam r t p q.1 (x q)
        else cubeGaussianKernel α lam r t p q.1 (x q)|) ≤
        C ^ 6 * lam ^ 36 * translationWeight r ^ 20 * cubeBracketWeight α t p x := by
  rcases cubeGaussian_pair_domination α with ⟨C, hC, hpair⟩
  refine ⟨C, hC, ?_⟩
  intro choose lam r t p x hlam ht
  have hEach (q : Fin 3 × Bool) :
      |if choose q then
        cubeGaussianDerivKernel α lam r t p q.1 (x q)
      else cubeGaussianKernel α lam r t p q.1 (x q)| ≤
        C * (if q.1 = 2 then translationWeight r ^ 10 else lam ^ 9) *
          bracketKernelAt (t ^ α.weight q.1) (p q.1) (x q) := by
    have h := hpair q.1 lam r t p (x q) hlam ht
    cases hchoice : choose q
    · simpa [hchoice] using (le_add_of_nonneg_right (abs_nonneg _)).trans h
    · simpa [hchoice] using (le_add_of_nonneg_left (abs_nonneg _)).trans h
  calc
    (∏ q : Fin 3 × Bool,
        |if choose q then
          cubeGaussianDerivKernel α lam r t p q.1 (x q)
        else cubeGaussianKernel α lam r t p q.1 (x q)|) ≤
        ∏ q : Fin 3 × Bool,
          C * (if q.1 = 2 then translationWeight r ^ 10 else lam ^ 9) *
            bracketKernelAt (t ^ α.weight q.1) (p q.1) (x q) := by
      apply Finset.prod_le_prod
      · intro q hq
        exact abs_nonneg _
      · intro q hq
        exact hEach q
    _ = C ^ 6 * lam ^ 36 * translationWeight r ^ 20 * cubeBracketWeight α t p x :=
      cubeKernel_majorant_prod_eq α C lam r t p x

/-- The six Gaussian/derivative factors in a local cube form have the
source exponents: four scaled factors give `λ^36`, and two translated
third-coordinate factors give `R(r)^20`. -/
theorem localCubeKernel_abs_domination (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i : Fin 3) (lam r t : ℝ) (p : E3) (x : E6),
      1 ≤ lam → 0 < t →
      |localCubeKernel α i lam r t p x| ≤
        C ^ 6 * lam ^ 36 * translationWeight r ^ 20 * cubeBracketWeight α t p x := by
  rcases localCubeKernel_factor_domination α with ⟨C, hC, hfac⟩
  refine ⟨C, hC, ?_⟩
  intro i lam r t p x hlam ht
  have hEach (q : Fin 3 × Bool) :
      |if q.1 = i then
        cubeGaussianDerivKernel α lam r t p q.1 (x q)
      else cubeGaussianKernel α lam r t p q.1 (x q)| ≤
        C * (if q.1 = 2 then translationWeight r ^ 10 else lam ^ 9) *
          bracketKernelAt (t ^ α.weight q.1) (p q.1) (x q) :=
    hfac i q.1 lam r t p (x q) hlam ht
  have hprod :
      (∏ q : Fin 3 × Bool,
        |if q.1 = i then
          cubeGaussianDerivKernel α lam r t p q.1 (x q)
        else cubeGaussianKernel α lam r t p q.1 (x q)|) ≤
      ∏ q : Fin 3 × Bool,
        C * (if q.1 = 2 then translationWeight r ^ 10 else lam ^ 9) *
          bracketKernelAt (t ^ α.weight q.1) (p q.1) (x q) := by
    apply Finset.prod_le_prod
    · intro q hq
      exact abs_nonneg _
    · intro q hq
      exact hEach q
  rw [localCubeKernel, Finset.abs_prod]
  calc
    (∏ q : Fin 3 × Bool,
        |if q.1 = i then
          cubeGaussianDerivKernel α lam r t p q.1 (x q)
        else cubeGaussianKernel α lam r t p q.1 (x q)|) ≤
        ∏ q : Fin 3 × Bool,
          C * (if q.1 = 2 then translationWeight r ^ 10 else lam ^ 9) *
            bracketKernelAt (t ^ α.weight q.1) (p q.1) (x q) := hprod
    _ = C ^ 6 * lam ^ 36 * translationWeight r ^ 20 * cubeBracketWeight α t p x :=
      cubeKernel_majorant_prod_eq α C lam r t p x

/-! ### Endpoint and face kernel majorants -/

/-- The six literal Gaussian slots, with a Boolean choosing the derivative in
each slot. -/
private def cubeGaussianProduct (α : Anisotropy) (choose : Fin 3 × Bool → Bool)
    (lam r t : ℝ) (p : E3) (x : E6) : ℝ :=
  ∏ q : Fin 3 × Bool,
    if choose q then
      cubeGaussianDerivKernel α lam r t p q.1 (x q)
    else cubeGaussianKernel α lam r t p q.1 (x q)

private theorem cubeGaussianProduct_domination (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (choose : Fin 3 × Bool → Bool)
      (lam r t : ℝ) (p : E3) (x : E6), 1 ≤ lam → 0 < t →
      |cubeGaussianProduct α choose lam r t p x| ≤
        C ^ 6 * lam ^ 36 * translationWeight r ^ 20 * cubeBracketWeight α t p x := by
  rcases cubeGaussian_sixfold_domination α with ⟨C, hC, hdom⟩
  refine ⟨C, hC, ?_⟩
  intro choose lam r t p x hlam ht
  unfold cubeGaussianProduct
  rw [Finset.abs_prod]
  exact hdom choose lam r t p x hlam ht

private theorem cubeEndpointKernel_eq_gaussianProduct (α : Anisotropy)
    (lam r t : ℝ) (p : E3) (x : E6) :
    cubeEndpointKernel α lam r t p x =
      cubeGaussianProduct α (fun _ ↦ false) lam r t p x := by
  unfold cubeEndpointKernel cubeCoordinateD cubeGaussianProduct
  rw [Fintype.prod_prod_type]
  simp_rw [Fintype.prod_bool]
  apply Finset.prod_congr rfl
  intro i hi
  simp
  ring

private theorem cubeEndpointKernel_eq_coordinate_mul_erase (α : Anisotropy)
    (i : Fin 3) (lam r t : ℝ) (p : E3) (x : E6) :
    cubeEndpointKernel α lam r t p x =
      cubeGaussianKernel α lam r t p i (x (i, false)) *
        cubeGaussianKernel α lam r t p i (x (i, true)) *
          ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x := by
  unfold cubeEndpointKernel cubeCoordinateD
  rw [← Finset.mul_prod_erase Finset.univ
    (fun m ↦ cubeGaussianKernel α lam r t p m (x (m, false)) *
      cubeGaussianKernel α lam r t p m (x (m, true))) (Finset.mem_univ i)]

private theorem cubeGaussianProduct_deriv_false_eq (α : Anisotropy)
    (i : Fin 3) (lam r t : ℝ) (p : E3) (x : E6) :
    cubeGaussianProduct α (fun q ↦ decide (q = (i, false))) lam r t p x =
      cubeGaussianDerivKernel α lam r t p i (x (i, false)) *
        cubeGaussianKernel α lam r t p i (x (i, true)) *
          ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x := by
  unfold cubeGaussianProduct cubeCoordinateD
  rw [Fintype.prod_prod_type]
  let A : Fin 3 → ℝ := fun j ↦
    ∏ b : Bool, if decide ((j, b) = (i, false)) then
      cubeGaussianDerivKernel α lam r t p j (x (j, b))
    else cubeGaussianKernel α lam r t p j (x (j, b))
  change (∏ j : Fin 3, A j) = _
  rw [← Finset.mul_prod_erase Finset.univ A (Finset.mem_univ i)]
  have hAi : A i =
      cubeGaussianDerivKernel α lam r t p i (x (i, false)) *
        cubeGaussianKernel α lam r t p i (x (i, true)) := by
    dsimp [A]
    simp
    ring
  rw [hAi]
  congr 1
  apply Finset.prod_congr rfl
  intro m hm
  have hmi : m ≠ i := (Finset.mem_erase.mp hm).1
  dsimp [A]
  simp [hmi]
  ring

private theorem cubeGaussianProduct_deriv_true_eq (α : Anisotropy)
    (i : Fin 3) (lam r t : ℝ) (p : E3) (x : E6) :
    cubeGaussianProduct α (fun q ↦ decide (q = (i, true))) lam r t p x =
      cubeGaussianKernel α lam r t p i (x (i, false)) *
        cubeGaussianDerivKernel α lam r t p i (x (i, true)) *
          ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x := by
  unfold cubeGaussianProduct cubeCoordinateD
  rw [Fintype.prod_prod_type]
  let A : Fin 3 → ℝ := fun j ↦
    ∏ b : Bool, if decide ((j, b) = (i, true)) then
      cubeGaussianDerivKernel α lam r t p j (x (j, b))
    else cubeGaussianKernel α lam r t p j (x (j, b))
  change (∏ j : Fin 3, A j) = _
  rw [← Finset.mul_prod_erase Finset.univ A (Finset.mem_univ i)]
  have hAi : A i =
      cubeGaussianKernel α lam r t p i (x (i, false)) *
        cubeGaussianDerivKernel α lam r t p i (x (i, true)) := by
    dsimp [A]
    simp
    ring
  rw [hAi]
  congr 1
  apply Finset.prod_congr rfl
  intro m hm
  have hmi : m ≠ i := (Finset.mem_erase.mp hm).1
  dsimp [A]
  simp [hmi]
  ring

private theorem cubeFaceKernel_eq_threeGaussianProducts (α : Anisotropy)
    (i : Fin 3) (lam r t : ℝ) (p : E3) (x : E6) :
    cubeFaceKernel α i lam r t p x =
      cubeWidth i lam / (2 * Real.pi) *
        (cubeGaussianProduct α (fun q ↦ decide (q = (i, false))) lam r t p x +
          cubeGaussianProduct α (fun q ↦ decide (q = (i, true))) lam r t p x) -
      cubeCenterShift i r * cubeGaussianProduct α (fun _ ↦ false) lam r t p x := by
  rw [cubeGaussianProduct_deriv_false_eq,
    cubeGaussianProduct_deriv_true_eq,
    ← cubeEndpointKernel_eq_gaussianProduct,
    cubeEndpointKernel_eq_coordinate_mul_erase]
  unfold cubeFaceKernel cubeBoundaryKernel cubeCoordinateD
  ring

/-- The endpoint kernel is bounded by the sixfold bracket weight, with the
four scaled slots contributing `λ^36` and the two translated slots
contributing `R(r)^20`. -/
theorem cubeEndpointKernel_domination (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (lam r t : ℝ) (p : E3) (x : E6),
      1 ≤ lam → 0 < t →
      |cubeEndpointKernel α lam r t p x| ≤
        C ^ 6 * lam ^ 36 * translationWeight r ^ 20 * cubeBracketWeight α t p x := by
  rcases cubeGaussianProduct_domination α with ⟨C, hC, hdom⟩
  refine ⟨C, hC, ?_⟩
  intro lam r t p x hlam ht
  rw [cubeEndpointKernel_eq_gaussianProduct]
  exact hdom (fun _ ↦ false) lam r t p x hlam ht

/-- The complete kernel in one face integral has the source remainder
exponents `λ^37 R(r)^21` against the sixfold bracket weight. -/
theorem cubeFaceKernel_domination (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i : Fin 3) (lam r t : ℝ) (p : E3) (x : E6),
      1 ≤ lam → 0 < t →
      |cubeFaceKernel α i lam r t p x| ≤
        C * lam ^ 37 * translationWeight r ^ 21 * cubeBracketWeight α t p x := by
  rcases cubeGaussianProduct_domination α with ⟨C, hC, hdom⟩
  let P : ℝ := |(2 * Real.pi)⁻¹|
  have hP : 0 ≤ P := abs_nonneg _
  have hcoef : 0 ≤ 2 * P + 1 := by nlinarith
  refine ⟨(2 * P + 1) * C ^ 6, mul_nonneg hcoef (pow_nonneg hC _), ?_⟩
  intro i lam r t p x hlam ht
  let R : ℝ := translationWeight r
  let K : ℝ := C ^ 6 * lam ^ 36 * R ^ 20 * cubeBracketWeight α t p x
  let Pfalse : ℝ := cubeGaussianProduct α
    (fun q ↦ decide (q = (i, false))) lam r t p x
  let Ptrue : ℝ := cubeGaussianProduct α
    (fun q ↦ decide (q = (i, true))) lam r t p x
  let Pall : ℝ := cubeGaussianProduct α (fun _ ↦ false) lam r t p x
  have hRone : 1 ≤ R := by
    dsimp [R, translationWeight]
    linarith [abs_nonneg r]
  have hR : 0 ≤ R := le_trans (by norm_num) hRone
  have hlam0 : 0 ≤ lam := le_trans (by norm_num) hlam
  have hW : 0 ≤ cubeBracketWeight α t p x :=
    cubeBracketWeight_nonneg α ht.le p x
  have hK : 0 ≤ K := by
    dsimp [K]
    exact mul_nonneg
      (mul_nonneg
        (mul_nonneg (pow_nonneg hC _) (pow_nonneg hlam0 _))
        (pow_nonneg hR _)) hW
  have hfalse : |Pfalse| ≤ K := by
    dsimp [Pfalse]
    simpa only [K, R] using
      hdom (fun q ↦ decide (q = (i, false))) lam r t p x hlam ht
  have htrue : |Ptrue| ≤ K := by
    dsimp [Ptrue]
    simpa only [K, R] using
      hdom (fun q ↦ decide (q = (i, true))) lam r t p x hlam ht
  have hall : |Pall| ≤ K := by
    dsimp [Pall]
    simpa only [K, R] using hdom (fun _ ↦ false) lam r t p x hlam ht
  have hwidth0 : 0 ≤ cubeWidth i lam := (cubeWidth_pos_of_one_le i hlam).le
  have hwidth : cubeWidth i lam ≤ lam := by
    fin_cases i <;> simp [cubeWidth, hlam]
  have hscale : |cubeWidth i lam / (2 * Real.pi)| ≤ lam * P := by
    calc
      |cubeWidth i lam / (2 * Real.pi)| =
          cubeWidth i lam * |(2 * Real.pi)⁻¹| := by
            rw [div_eq_mul_inv, abs_mul, abs_of_nonneg hwidth0]
      _ ≤ lam * |(2 * Real.pi)⁻¹| :=
        mul_le_mul_of_nonneg_right hwidth (abs_nonneg _)
      _ = lam * P := rfl
  have hshift : |cubeCenterShift i r| ≤ R := by
    dsimp [R]
    fin_cases i
    · change |0| ≤ translationWeight r
      unfold translationWeight
      simp only [abs_zero]
      linarith [abs_nonneg r]
    · change |0| ≤ translationWeight r
      unfold translationWeight
      simp only [abs_zero]
      linarith [abs_nonneg r]
    · change |r| ≤ translationWeight r
      unfold translationWeight
      linarith [abs_nonneg r]
  have hsum : |Pfalse| + |Ptrue| ≤ K + K := add_le_add hfalse htrue
  have hterm1 : |cubeWidth i lam / (2 * Real.pi)| *
      (|Pfalse| + |Ptrue|) ≤ lam * P * (K + K) := by
    exact mul_le_mul hscale hsum (by positivity)
      (mul_nonneg hlam0 hP)
  have hterm2 : |cubeCenterShift i r| * |Pall| ≤ R * K := by
    exact mul_le_mul hshift hall (abs_nonneg _) hR
  have hcoefbound :
      lam * P * (K + K) + R * K ≤ (2 * P + 1) * lam * R * K := by
    nlinarith [mul_nonneg (sub_nonneg.mpr hlam) (sub_nonneg.mpr hRone),
      mul_nonneg (sub_nonneg.mpr hlam) hK,
      mul_nonneg (sub_nonneg.mpr hRone) hK,
      mul_nonneg hP hK]
  have hdecomp : cubeFaceKernel α i lam r t p x =
      cubeWidth i lam / (2 * Real.pi) * (Pfalse + Ptrue) -
        cubeCenterShift i r * Pall := by
    dsimp [Pfalse, Ptrue, Pall]
    exact cubeFaceKernel_eq_threeGaussianProducts α i lam r t p x
  calc
    |cubeFaceKernel α i lam r t p x| =
        |cubeWidth i lam / (2 * Real.pi) * (Pfalse + Ptrue) -
          cubeCenterShift i r * Pall| := by rw [hdecomp]
    _ ≤ |cubeWidth i lam / (2 * Real.pi)| * (|Pfalse| + |Ptrue|) +
          |cubeCenterShift i r| * |Pall| := by
      calc
        _ ≤ |cubeWidth i lam / (2 * Real.pi) * (Pfalse + Ptrue)| +
            |cubeCenterShift i r * Pall| := by
              simpa using (abs_sub_le
                (cubeWidth i lam / (2 * Real.pi) * (Pfalse + Ptrue)) 0
                (cubeCenterShift i r * Pall))
        _ = |cubeWidth i lam / (2 * Real.pi)| * |Pfalse + Ptrue| +
            |cubeCenterShift i r| * |Pall| := by rw [abs_mul, abs_mul]
        _ ≤ _ := by gcongr; exact abs_add_le _ _
    _ ≤ lam * P * (K + K) + R * K := add_le_add hterm1 hterm2
    _ ≤ (2 * P + 1) * lam * R * K := hcoefbound
    _ = ((2 * P + 1) * C ^ 6) * lam ^ 37 * translationWeight r ^ 21 *
          cubeBracketWeight α t p x := by
      dsimp [K, R]
      ring

/-! ### Spatial absolute integrability for sixfold Gaussian kernels -/

/-- A choice of either `G` or `H` in each of the six spatial slots. -/
noncomputable def cubeSixfoldGaussianKernel (α : Anisotropy)
    (choose : Fin 3 × Bool → Bool) (lam r t : ℝ) (p : E3) (x : E6) : ℝ :=
  ∏ q : Fin 3 × Bool,
    if choose q then
      cubeGaussianDerivKernel α lam r t p q.1 (x q)
    else
      cubeGaussianKernel α lam r t p q.1 (x q)

/-- The signed cube input product is continuous when every source input is
continuous. -/
theorem continuous_cubeSignedInputProduct
    (F : CubeVertex → E3 → ℝ) (hF : ∀ j, Continuous (F j)) :
    Continuous (cubeSignedInputProduct F) := by
  unfold cubeSignedInputProduct
  apply continuous_finsetProd Finset.univ
  intro j _
  exact (hF j).comp (cubeProjection_continuous j)

/-- A continuous Gaussian or derivative-Gaussian factor is continuous in its
one selected spatial coordinate. -/
theorem continuous_cubeSixfoldGaussianFactor
    (α : Anisotropy) (choose : (Fin 3 × Bool) → Bool) (lam r t : ℝ) (p : E3)
    (q : Fin 3 × Bool) :
    Continuous (fun x : E6 ↦
      if choose q then
        cubeGaussianDerivKernel α lam r t p q.1 (x q)
      else
        cubeGaussianKernel α lam r t p q.1 (x q)) := by
  by_cases hq : choose q
  · simp only [hq, ↓reduceIte]
    have harg : Continuous (fun x : E6 ↦
        (x q - (p q.1 + cubeCenterShift q.1 r * t ^ α.weight q.1)) /
          (cubeWidth q.1 lam * t ^ α.weight q.1)) :=
      ((PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 × Bool ↦ ℝ) q).sub
        continuous_const).div_const _
    have hderiv : Continuous gaussianDeriv := by
      unfold gaussianDeriv
      exact (continuous_const.mul continuous_id).mul gaussian_contDiff.continuous
    unfold cubeGaussianDerivKernel gaussianDerivAt kernelAt kernelDilate
    simp only [smul_eq_mul]
    exact continuous_const.mul (hderiv.comp harg)
  · simp only [hq]
    have harg : Continuous (fun x : E6 ↦
        (x q - (p q.1 + cubeCenterShift q.1 r * t ^ α.weight q.1)) /
          (cubeWidth q.1 lam * t ^ α.weight q.1)) :=
      ((PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 × Bool ↦ ℝ) q).sub
        continuous_const).div_const _
    unfold cubeGaussianKernel gaussianAt kernelAt kernelDilate
    simp only [smul_eq_mul]
    exact continuous_const.mul (gaussian_contDiff.continuous.comp harg)

/-- Any sixfold `G/H` kernel is continuous in the six spatial variables. -/
theorem continuous_cubeSixfoldGaussianKernel
    (α : Anisotropy) (choose : (Fin 3 × Bool) → Bool) (lam r t : ℝ) (p : E3) :
    Continuous (cubeSixfoldGaussianKernel α choose lam r t p) := by
  unfold cubeSixfoldGaussianKernel
  apply continuous_finsetProd Finset.univ
  intro q _
  exact continuous_cubeSixfoldGaussianFactor α choose lam r t p q

/-- At fixed positive scale, a bounded continuous cube input product times
any sixfold choice of the source `G/H` kernels is absolutely integrable in
the six spatial variables. -/
theorem integrable_cubeSignedInputProduct_mul_sixfoldGaussianKernel
    (α : Anisotropy) (choose : (Fin 3 × Bool) → Bool) (lam r t : ℝ) (p : E3)
    (F : CubeVertex → E3 → ℝ) (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    Integrable (fun x : E6 ↦ cubeSignedInputProduct F x *
      cubeSixfoldGaussianKernel α choose lam r t p x) := by
  rcases exists_bound_cubeSignedInputProduct F hFbound with ⟨B, hB, hinput⟩
  rcases cubeGaussian_sixfold_domination α with ⟨C, hC, hdom⟩
  let D : ℝ := C ^ 6 * lam ^ 36 * translationWeight r ^ 20
  have hmajor : Integrable (fun x : E6 ↦
      (B * D) * cubeBracketWeight α t p x) := by
    simpa only [smul_eq_mul] using
      (integrable_cubeBracketWeight α ht p).const_mul (B * D)
  have hmeas : AEStronglyMeasurable
      (fun x : E6 ↦ cubeSignedInputProduct F x *
        cubeSixfoldGaussianKernel α choose lam r t p x) volume :=
    ((continuous_cubeSignedInputProduct F hFcont).mul
      (continuous_cubeSixfoldGaussianKernel α choose lam r t p)).aestronglyMeasurable
  refine hmajor.mono hmeas (Filter.Eventually.of_forall ?_)
  intro x
  have hkernel : |cubeSixfoldGaussianKernel α choose lam r t p x| ≤
      D * cubeBracketWeight α t p x := by
    dsimp [cubeSixfoldGaussianKernel, D]
    rw [Finset.abs_prod]
    exact hdom choose lam r t p x hlam ht
  have hmajor_nonneg : 0 ≤ (B * D) * cubeBracketWeight α t p x := by
    simpa only [mul_assoc] using
      (mul_nonneg hB (le_trans (abs_nonneg _) hkernel))
  rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul, abs_of_nonneg hmajor_nonneg]
  calc
    |cubeSignedInputProduct F x| *
        |cubeSixfoldGaussianKernel α choose lam r t p x| ≤
        B * (D * cubeBracketWeight α t p x) :=
      mul_le_mul (hinput x) hkernel (abs_nonneg _) hB
    _ = (B * D) * cubeBracketWeight α t p x := by ring

/-- The preceding sixfold statement specialized to the local cube kernel. -/
theorem integrable_cubeSignedInputProduct_mul_localCubeKernel
    (α : Anisotropy) (i : Fin 3) (lam r t : ℝ) (p : E3)
    (F : CubeVertex → E3 → ℝ) (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    Integrable (fun x : E6 ↦ cubeSignedInputProduct F x *
      localCubeKernel α i lam r t p x) := by
  simpa [cubeSixfoldGaussianKernel, localCubeKernel] using
    integrable_cubeSignedInputProduct_mul_sixfoldGaussianKernel
      α (fun q ↦ decide (q.1 = i)) lam r t p F hFcont hFbound hlam ht

/-- Continuity of the fixed-scale endpoint kernel in all six spatial variables. -/
theorem continuous_cubeEndpointKernel
    (α : Anisotropy) (lam r t : ℝ) (p : E3) :
    Continuous (cubeEndpointKernel α lam r t p) := by
  unfold cubeEndpointKernel cubeCoordinateD
  apply continuous_finsetProd Finset.univ
  intro i hi
  have h0 : Continuous (fun x : E6 ↦
      cubeGaussianKernel α lam r t p i (x (i, false))) := by
    simpa using (continuous_cubeSixfoldGaussianFactor α (fun _ ↦ false)
      lam r t p (i, false))
  have h1 : Continuous (fun x : E6 ↦
      cubeGaussianKernel α lam r t p i (x (i, true))) := by
    simpa using (continuous_cubeSixfoldGaussianFactor α (fun _ ↦ false)
      lam r t p (i, true))
  exact h0.mul h1

/-- Continuity of the fixed-scale face kernel in all six spatial variables. -/
theorem continuous_cubeFaceKernel
    (α : Anisotropy) (i : Fin 3) (lam r t : ℝ) (p : E3) :
    Continuous (cubeFaceKernel α i lam r t p) := by
  have hG0 : Continuous (fun x : E6 ↦
      cubeGaussianKernel α lam r t p i (x (i, false))) := by
    simpa using (continuous_cubeSixfoldGaussianFactor α (fun _ ↦ false)
      lam r t p (i, false))
  have hG1 : Continuous (fun x : E6 ↦
      cubeGaussianKernel α lam r t p i (x (i, true))) := by
    simpa using (continuous_cubeSixfoldGaussianFactor α (fun _ ↦ false)
      lam r t p (i, true))
  have hH0 : Continuous (fun x : E6 ↦
      cubeGaussianDerivKernel α lam r t p i (x (i, false))) := by
    simpa using (continuous_cubeSixfoldGaussianFactor α
      (fun q ↦ decide (q = (i, false))) lam r t p (i, false))
  have hH1 : Continuous (fun x : E6 ↦
      cubeGaussianDerivKernel α lam r t p i (x (i, true))) := by
    simpa using (continuous_cubeSixfoldGaussianFactor α
      (fun q ↦ decide (q = (i, true))) lam r t p (i, true))
  have hD : Continuous (fun x : E6 ↦
      cubeCoordinateD α i lam r t p x) := by
    exact hG0.mul hG1
  have hB : Continuous (fun x : E6 ↦
      cubeBoundaryKernel α i lam r t p x) := by
    unfold cubeBoundaryKernel
    exact (continuous_const.mul ((hH0.mul hG1).add (hG0.mul hH1))).sub
      (continuous_const.mul hD)
  have hpassive : Continuous (fun x : E6 ↦
      ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t p x) := by
    apply continuous_finsetProd (Finset.univ.erase i)
    intro m hm
    have h0 : Continuous (fun x : E6 ↦
        cubeGaussianKernel α lam r t p m (x (m, false))) := by
      simpa using (continuous_cubeSixfoldGaussianFactor α (fun _ ↦ false)
        lam r t p (m, false))
    have h1 : Continuous (fun x : E6 ↦
        cubeGaussianKernel α lam r t p m (x (m, true))) := by
      simpa using (continuous_cubeSixfoldGaussianFactor α (fun _ ↦ false)
        lam r t p (m, true))
    exact h0.mul h1
  exact hB.mul hpassive

/-- Joint center--space continuity for one Gaussian coordinate factor. -/
theorem continuous_cubeGaussianKernel_center_space
    (α : Anisotropy) (i : Fin 3) (b : Bool) (lam r t : ℝ) :
    Continuous (fun z : E3 × E6 ↦
      cubeGaussianKernel α lam r t z.1 i (z.2 (i, b))) := by
  have hx : Continuous (fun z : E3 × E6 ↦ z.2 (i, b)) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 × Bool ↦ ℝ) (i, b)).comp
      continuous_snd
  have hp : Continuous (fun z : E3 × E6 ↦ z.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).comp
      continuous_fst
  have harg : Continuous (fun z : E3 × E6 ↦
      (z.2 (i, b) - (z.1 i + cubeCenterShift i r * t ^ α.weight i)) /
        (cubeWidth i lam * t ^ α.weight i)) :=
    (hx.sub (hp.add continuous_const)).div_const _
  unfold cubeGaussianKernel gaussianAt kernelAt kernelDilate
  simp only [smul_eq_mul]
  exact continuous_const.mul (gaussian_contDiff.continuous.comp harg)

/-- Joint center--space continuity for one differentiated Gaussian factor. -/
theorem continuous_cubeGaussianDerivKernel_center_space
    (α : Anisotropy) (i : Fin 3) (b : Bool) (lam r t : ℝ) :
    Continuous (fun z : E3 × E6 ↦
      cubeGaussianDerivKernel α lam r t z.1 i (z.2 (i, b))) := by
  have hx : Continuous (fun z : E3 × E6 ↦ z.2 (i, b)) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 × Bool ↦ ℝ) (i, b)).comp
      continuous_snd
  have hp : Continuous (fun z : E3 × E6 ↦ z.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).comp
      continuous_fst
  have harg : Continuous (fun z : E3 × E6 ↦
      (z.2 (i, b) - (z.1 i + cubeCenterShift i r * t ^ α.weight i)) /
        (cubeWidth i lam * t ^ α.weight i)) :=
    (hx.sub (hp.add continuous_const)).div_const _
  have hderiv : Continuous gaussianDeriv := by
    unfold gaussianDeriv
    exact (continuous_const.mul continuous_id).mul gaussian_contDiff.continuous
  unfold cubeGaussianDerivKernel gaussianDerivAt kernelAt kernelDilate
  simp only [smul_eq_mul]
  exact continuous_const.mul (hderiv.comp harg)

/-- Joint center--space continuity of the endpoint kernel. -/
theorem continuous_cubeEndpointKernel_center_space
    (α : Anisotropy) (lam r t : ℝ) :
    Continuous (fun z : E3 × E6 ↦ cubeEndpointKernel α lam r t z.1 z.2) := by
  unfold cubeEndpointKernel cubeCoordinateD
  apply continuous_finsetProd Finset.univ
  intro i hi
  exact
    (continuous_cubeGaussianKernel_center_space α i false lam r t).mul
      (continuous_cubeGaussianKernel_center_space α i true lam r t)

/-- Joint center--space continuity of the face kernel. -/
theorem continuous_cubeFaceKernel_center_space
    (α : Anisotropy) (i : Fin 3) (lam r t : ℝ) :
    Continuous (fun z : E3 × E6 ↦ cubeFaceKernel α i lam r t z.1 z.2) := by
  have hG0 := continuous_cubeGaussianKernel_center_space α i false lam r t
  have hG1 := continuous_cubeGaussianKernel_center_space α i true lam r t
  have hH0 := continuous_cubeGaussianDerivKernel_center_space α i false lam r t
  have hH1 := continuous_cubeGaussianDerivKernel_center_space α i true lam r t
  have hD : Continuous (fun z : E3 × E6 ↦
      cubeCoordinateD α i lam r t z.1 z.2) := by
    exact hG0.mul hG1
  have hB : Continuous (fun z : E3 × E6 ↦
      cubeBoundaryKernel α i lam r t z.1 z.2) := by
    unfold cubeBoundaryKernel
    exact (continuous_const.mul ((hH0.mul hG1).add (hG0.mul hH1))).sub
      (continuous_const.mul hD)
  have hpassive : Continuous (fun z : E3 × E6 ↦
      ∏ m ∈ Finset.univ.erase i, cubeCoordinateD α m lam r t z.1 z.2) := by
    apply continuous_finsetProd (Finset.univ.erase i)
    intro m hm
    exact
      (continuous_cubeGaussianKernel_center_space α m false lam r t).mul
        (continuous_cubeGaussianKernel_center_space α m true lam r t)
  exact hB.mul hpassive

/-- Fixed-center spatial integrability of the endpoint integrand. -/
theorem integrable_cubeSignedInputProduct_mul_cubeEndpointKernel
    (α : Anisotropy) (lam r t : ℝ) (p : E3)
    (F : CubeVertex → E3 → ℝ) (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    Integrable (fun x : E6 ↦ cubeSignedInputProduct F x *
      cubeEndpointKernel α lam r t p x) := by
  rcases exists_bound_cubeSignedInputProduct F hFbound with ⟨B, hB, hinput⟩
  rcases cubeEndpointKernel_domination α with ⟨C, hC, hdom⟩
  let D : ℝ := C ^ 6 * lam ^ 36 * translationWeight r ^ 20
  have hmajor : Integrable (fun x : E6 ↦
      (B * D) * cubeBracketWeight α t p x) := by
    simpa only [smul_eq_mul] using
      (integrable_cubeBracketWeight α ht p).const_mul (B * D)
  have hmeas : AEStronglyMeasurable
      (fun x : E6 ↦ cubeSignedInputProduct F x *
        cubeEndpointKernel α lam r t p x) volume :=
    ((continuous_cubeSignedInputProduct F hFcont).mul
      (continuous_cubeEndpointKernel α lam r t p)).aestronglyMeasurable
  refine hmajor.mono hmeas (Filter.Eventually.of_forall ?_)
  intro x
  have hkernel : |cubeEndpointKernel α lam r t p x| ≤
      D * cubeBracketWeight α t p x := by
    dsimp [D]
    exact hdom lam r t p x hlam ht
  have hmajor_nonneg : 0 ≤ (B * D) * cubeBracketWeight α t p x := by
    simpa only [mul_assoc] using
      (mul_nonneg hB (le_trans (abs_nonneg _) hkernel))
  rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul, abs_of_nonneg hmajor_nonneg]
  calc
    |cubeSignedInputProduct F x| * |cubeEndpointKernel α lam r t p x| ≤
        B * (D * cubeBracketWeight α t p x) :=
      mul_le_mul (hinput x) hkernel (abs_nonneg _) hB
    _ = (B * D) * cubeBracketWeight α t p x := by ring

