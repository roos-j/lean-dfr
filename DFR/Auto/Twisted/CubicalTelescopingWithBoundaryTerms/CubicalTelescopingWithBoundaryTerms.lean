    _ = (C ^ 6 * S) * lam ^ 36 * translationWeight r ^ 20 *
        ∏ j : CubeVertex, treeLocalSize T 4 (F j) := by ring

/-- The face spatial integral is controlled uniformly on the closure of a
tree region by the product of tree-local fourth sizes. -/
theorem abs_integral_cubeFaceKernel_le_treeLocalSize_product_of_mem_closure
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α) (i : Fin 3)
      (lam r t : ℝ) (p : E3) (F : CubeVertex → E3 → ℝ),
      (∀ j, Continuous (F j)) →
      (∀ j, Measurable (F j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B) →
      1 ≤ lam →
      (p, t) ∈ closure (collectionRegion α T.boxes) →
      |∫ x : E6, cubeSignedInputProduct F x *
        cubeFaceKernel α i lam r t p x| ≤
        C * lam ^ 37 * translationWeight r ^ 21 *
          ∏ j : CubeVertex, treeLocalSize T 4 (F j) := by
  rcases abs_integral_cubeFaceKernel_le_bracketAverage α with
    ⟨C, hC, hface⟩
  let S : ℝ := boxScaleComparisonConstant α
  refine ⟨C * S,
    mul_nonneg hC (boxScaleComparisonConstant_nonneg α), ?_⟩
  intro T i lam r t p F hFcont hFmeas hFbound hlam hpt
  have ht : 0 < t := pos_of_mem_closure_collectionRegion α T.boxes hpt
  have hface' := hface i lam r t p F hFcont hFbound hlam ht
  have hsize := cubeBracketAverage_le_treeLocalSize_product_of_mem_closure
    T F hFcont hFmeas hFbound hpt
  have hfac : 0 ≤ C * lam ^ 37 * translationWeight r ^ 21 := by
    have hlam0 : 0 ≤ lam := by linarith
    have hR : 0 ≤ translationWeight r := by
      unfold translationWeight
      positivity
    change 0 ≤ (C * lam ^ (37 : ℕ)) * translationWeight r ^ (21 : ℕ)
    exact mul_nonneg
      (mul_nonneg hC (pow_nonneg hlam0 _))
      (pow_nonneg hR _)
  calc
    |∫ x : E6, cubeSignedInputProduct F x *
        cubeFaceKernel α i lam r t p x| ≤
        C * lam ^ 37 * translationWeight r ^ 21 *
          cubeBracketAverage α t p F := hface'
    _ ≤ C * lam ^ 37 * translationWeight r ^ 21 *
        (S * ∏ j : CubeVertex, treeLocalSize T 4 (F j)) :=
      mul_le_mul_of_nonneg_left hsize hfac
    _ = (C * S) * lam ^ 37 * translationWeight r ^ 21 *
        ∏ j : CubeVertex, treeLocalSize T 4 (F j) := by ring

/-! ### One-cell product-integrability bridge

The remaining source Fubini steps need genuinely joint center--scale--space
integrability.  We first record the elementary Borel measurability of the
variable-scale Gaussian factors; unlike the fixed-scale continuity lemmas,
these statements are valid at the totalized value `t = 0` as well. -/

/-- The variable center--scale--space Gaussian factor is Borel measurable. -/
theorem measurable_cubeGaussianKernel_center_scale_space
    (α : Anisotropy) (i : Fin 3) (b : Bool) (lam r : ℝ) :
    Measurable (fun z : (E3 × ℝ) × E6 ↦
      cubeGaussianKernel α lam r z.1.2 z.1.1 i (z.2 (i, b))) := by
  have ht : Measurable (fun z : (E3 × ℝ) × E6 ↦ z.1.2 ^ α.weight i) :=
    (measurable_snd.comp measurable_fst).pow_const _
  have hp : Measurable (fun z : (E3 × ℝ) × E6 ↦ z.1.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp
      (measurable_fst.comp measurable_fst)
  have hx : Measurable (fun z : (E3 × ℝ) × E6 ↦ z.2 (i, b)) :=
    (PiLp.continuous_apply (p := 2)
      (β := fun _ : Fin 3 × Bool ↦ ℝ) (i, b)).measurable.comp measurable_snd
  have hs : Measurable (fun z : (E3 × ℝ) × E6 ↦
      cubeWidth i lam * z.1.2 ^ α.weight i) := measurable_const.mul ht
  have ha : Measurable (fun z : (E3 × ℝ) × E6 ↦
      z.1.1 i + cubeCenterShift i r * z.1.2 ^ α.weight i) :=
    hp.add (measurable_const.mul ht)
  unfold cubeGaussianKernel gaussianAt kernelAt kernelDilate
  simpa only [smul_eq_mul] using
    (show Measurable (fun z : (E3 × ℝ) × E6 ↦
      (cubeWidth i lam * z.1.2 ^ α.weight i)⁻¹ *
        gaussian ((z.2 (i, b) -
          (z.1.1 i + cubeCenterShift i r * z.1.2 ^ α.weight i)) /
          (cubeWidth i lam * z.1.2 ^ α.weight i))) from
      hs.inv.mul (gaussian_contDiff.continuous.measurable.comp ((hx.sub ha).div hs)))

/-- The variable center--scale--space Gaussian derivative factor is Borel
measurable. -/
theorem measurable_cubeGaussianDerivKernel_center_scale_space
    (α : Anisotropy) (i : Fin 3) (b : Bool) (lam r : ℝ) :
    Measurable (fun z : (E3 × ℝ) × E6 ↦
      cubeGaussianDerivKernel α lam r z.1.2 z.1.1 i (z.2 (i, b))) := by
  have ht : Measurable (fun z : (E3 × ℝ) × E6 ↦ z.1.2 ^ α.weight i) :=
    (measurable_snd.comp measurable_fst).pow_const _
  have hp : Measurable (fun z : (E3 × ℝ) × E6 ↦ z.1.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp
      (measurable_fst.comp measurable_fst)
  have hx : Measurable (fun z : (E3 × ℝ) × E6 ↦ z.2 (i, b)) :=
    (PiLp.continuous_apply (p := 2)
      (β := fun _ : Fin 3 × Bool ↦ ℝ) (i, b)).measurable.comp measurable_snd
  have hs : Measurable (fun z : (E3 × ℝ) × E6 ↦
      cubeWidth i lam * z.1.2 ^ α.weight i) := measurable_const.mul ht
  have ha : Measurable (fun z : (E3 × ℝ) × E6 ↦
      z.1.1 i + cubeCenterShift i r * z.1.2 ^ α.weight i) :=
    hp.add (measurable_const.mul ht)
  have hderiv : Measurable gaussianDeriv := by
    unfold gaussianDeriv
    exact (measurable_const.mul measurable_id).mul
      gaussian_contDiff.continuous.measurable
  unfold cubeGaussianDerivKernel gaussianDerivAt kernelAt kernelDilate
  simpa only [smul_eq_mul] using
    (show Measurable (fun z : (E3 × ℝ) × E6 ↦
      (cubeWidth i lam * z.1.2 ^ α.weight i)⁻¹ *
        gaussianDeriv ((z.2 (i, b) -
          (z.1.1 i + cubeCenterShift i r * z.1.2 ^ α.weight i)) /
          (cubeWidth i lam * z.1.2 ^ α.weight i))) from
      hs.inv.mul (hderiv.comp ((hx.sub ha).div hs)))

/-- Joint a.e.-strong measurability of the variable-scale local kernel. -/
theorem aestronglyMeasurable_localCubeKernel_center_scale_space
    (α : Anisotropy) (i : Fin 3) (lam r : ℝ)
    (μ : Measure ((E3 × ℝ) × E6)) :
    AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      localCubeKernel α i lam r z.1.2 z.1.1 z.2) μ := by
  unfold localCubeKernel
  apply Finset.aestronglyMeasurable_fun_prod Finset.univ
  rintro ⟨q, b⟩ hq
  by_cases hqi : q = i
  · subst q
    simp only [↓reduceIte]
    exact (measurable_cubeGaussianDerivKernel_center_scale_space
      α i b lam r).aestronglyMeasurable
  · simp only [hqi, ↓reduceIte]
    exact (measurable_cubeGaussianKernel_center_scale_space
      α q b lam r).aestronglyMeasurable

/-- Joint a.e.-strong measurability of the variable-scale endpoint kernel. -/
theorem aestronglyMeasurable_cubeEndpointKernel_center_scale_space
    (α : Anisotropy) (lam r : ℝ) (μ : Measure ((E3 × ℝ) × E6)) :
    AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      cubeEndpointKernel α lam r z.1.2 z.1.1 z.2) μ := by
  unfold cubeEndpointKernel cubeCoordinateD
  apply Finset.aestronglyMeasurable_fun_prod Finset.univ
  intro i hi
  exact
    ((measurable_cubeGaussianKernel_center_scale_space
      α i false lam r).aestronglyMeasurable).mul
      ((measurable_cubeGaussianKernel_center_scale_space
        α i true lam r).aestronglyMeasurable)

/-- Joint a.e.-strong measurability of the variable-scale face kernel. -/
theorem aestronglyMeasurable_cubeFaceKernel_center_scale_space
    (α : Anisotropy) (i : Fin 3) (lam r : ℝ)
    (μ : Measure ((E3 × ℝ) × E6)) :
    AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      cubeFaceKernel α i lam r z.1.2 z.1.1 z.2) μ := by
  have hG0 : AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      cubeGaussianKernel α lam r z.1.2 z.1.1 i (z.2 (i, false))) μ :=
    (measurable_cubeGaussianKernel_center_scale_space
      α i false lam r).aestronglyMeasurable
  have hG1 : AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      cubeGaussianKernel α lam r z.1.2 z.1.1 i (z.2 (i, true))) μ :=
    (measurable_cubeGaussianKernel_center_scale_space
      α i true lam r).aestronglyMeasurable
  have hH0 : AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      cubeGaussianDerivKernel α lam r z.1.2 z.1.1 i (z.2 (i, false))) μ :=
    (measurable_cubeGaussianDerivKernel_center_scale_space
      α i false lam r).aestronglyMeasurable
  have hH1 : AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      cubeGaussianDerivKernel α lam r z.1.2 z.1.1 i (z.2 (i, true))) μ :=
    (measurable_cubeGaussianDerivKernel_center_scale_space
      α i true lam r).aestronglyMeasurable
  have hD : AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      cubeCoordinateD α i lam r z.1.2 z.1.1 z.2) μ := hG0.mul hG1
  have hB : AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      cubeBoundaryKernel α i lam r z.1.2 z.1.1 z.2) μ := by
    unfold cubeBoundaryKernel
    exact (aestronglyMeasurable_const.mul ((hH0.mul hG1).add (hG0.mul hH1))).sub
      (aestronglyMeasurable_const.mul hD)
  have hpassive : AEStronglyMeasurable (fun z : (E3 × ℝ) × E6 ↦
      ∏ m ∈ Finset.univ.erase i,
        cubeCoordinateD α m lam r z.1.2 z.1.1 z.2) μ := by
    apply Finset.aestronglyMeasurable_fun_prod (Finset.univ.erase i)
    intro m hm
    exact
      ((measurable_cubeGaussianKernel_center_scale_space
        α m false lam r).aestronglyMeasurable).mul
        ((measurable_cubeGaussianKernel_center_scale_space
          α m true lam r).aestronglyMeasurable)
  exact hB.mul hpassive

