    rw [← inv_pow]
    ring
  rw [← hcoef]
  convert! hraw using 1

/-! ### Scalar kernels for the one-dimensional telescope

These names isolate one active coordinate of the cubical form.  They match
the source notation `G_i,H_i,D_i,P_i,W_i,E_i` and let the differential and
integration-by-parts calculations be proved once before being applied in the
three coordinate directions. -/

def scalarG (mu sig : ℝ) (n : ℕ) (t p u : ℝ) : ℝ :=
  gaussianAt (mu * t ^ n) (p + sig * t ^ n) u

def scalarH (mu sig : ℝ) (n : ℕ) (t p u : ℝ) : ℝ :=
  gaussianDerivAt (mu * t ^ n) (p + sig * t ^ n) u

def scalarD (mu sig : ℝ) (n : ℕ) (t p u0 u1 : ℝ) : ℝ :=
  scalarG mu sig n t p u0 * scalarG mu sig n t p u1

def scalarP (mu sig : ℝ) (n : ℕ) (t p u0 u1 : ℝ) : ℝ :=
  scalarH mu sig n t p u0 * scalarH mu sig n t p u1

def scalarW (mu sig : ℝ) (n : ℕ) (t p u0 u1 : ℝ) : ℝ :=
  scalarH mu sig n t p u0 * scalarG mu sig n t p u1 +
    scalarG mu sig n t p u0 * scalarH mu sig n t p u1

def scalarE (mu sig : ℝ) (n : ℕ) (t p u0 u1 : ℝ) : ℝ :=
  mu / (2 * Real.pi) * scalarW mu sig n t p u0 u1 -
    sig * scalarD mu sig n t p u0 u1

theorem scalarH_eq_logarithmic {mu sig : ℝ} {n : ℕ} {t p u : ℝ}
    (hscale : mu * t ^ n ≠ 0) :
    scalarH mu sig n t p u =
      (-2 * Real.pi * ((u - (p + sig * t ^ n)) / (mu * t ^ n))) *
        scalarG mu sig n t p u := by
  exact gaussianDerivAt_eq_logarithmic_deriv hscale

theorem hasDerivAt_scalarG_center {mu sig : ℝ} {n : ℕ} {t p u : ℝ}
    (hscale : mu * t ^ n ≠ 0) :
    HasDerivAt (fun q : ℝ ↦ scalarG mu sig n t q u)
      (-(mu * t ^ n)⁻¹ * scalarH mu sig n t p u) p := by
  have hbase := hasDerivAt_gaussianAt_center (a := p + sig * t ^ n)
    (x := u) hscale
  have hcenter : HasDerivAt (fun q : ℝ ↦ q + sig * t ^ n) 1 p := by
    simpa using (hasDerivAt_id' (𝕜 := ℝ) p).add_const (sig * t ^ n)
  convert! hbase.comp p hcenter using 1
  simp [scalarH]

/-- Raw scale differentiation of the scalar Gaussian factor.  Introducing
the scale and center tangents explicitly keeps the later source identity
algebraic rather than hiding a parameter interchange. -/
theorem hasDerivAt_scalarG_scale_raw {mu sig : ℝ} {n : ℕ} {t p u : ℝ}
    (hscale : mu * t ^ n ≠ 0) :
    let w : ℝ := t ^ n
    let dw : ℝ := (n : ℝ) * t ^ (n - 1)
    let s : ℝ := mu * w
    let ds : ℝ := mu * dw
    let a : ℝ := p + sig * w
    let da : ℝ := sig * dw
    let z : ℝ := (u - a) / s
    let dz : ℝ := ((-da) * s - (u - a) * ds) / s ^ 2
    HasDerivAt (fun q : ℝ => scalarG mu sig n q p u)
      ((-ds / s ^ 2) * gaussian z + s⁻¹ * gaussianDeriv z * dz) t := by
  dsimp only
  have hp : HasDerivAt (fun q : ℝ => q ^ n)
      ((n : ℝ) * t ^ (n - 1)) t := by
    simpa using hasDerivAt_pow n t
  have hsfun : HasDerivAt (fun q : ℝ => mu * q ^ n)
      (mu * ((n : ℝ) * t ^ (n - 1))) t := by
    convert! hp.const_mul mu using 1
  have hafun : HasDerivAt (fun q : ℝ => p + sig * q ^ n)
