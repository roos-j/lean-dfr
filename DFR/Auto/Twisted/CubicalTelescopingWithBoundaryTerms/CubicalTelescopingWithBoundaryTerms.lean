    ((u - (p + sig * t ^ n)) / (mu * t ^ n))).comp t hzfun
  have hprod := hinv.mul houter
  convert! hprod using 1
  simp only [Function.comp_apply, Pi.div_apply, Pi.inv_apply]
  ring

