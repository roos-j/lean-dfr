    (hmu : mu ≠ 0) (ht : t ≠ 0) :
    HasDerivAt (fun q : ℝ => scalarG mu sig n q p u)
      (-(n : ℝ) / t *
        (scalarG mu sig n t p u +
          (((u - (p + sig * t ^ n)) / (mu * t ^ n)) + sig / mu) *
            scalarH mu sig n t p u)) t := by
  have hpowne : t ^ n ≠ 0 := pow_ne_zero n ht
  have hscale : mu * t ^ n ≠ 0 := mul_ne_zero hmu hpowne
  have hraw := hasDerivAt_scalarG_scale_raw
    (mu := mu) (sig := sig) (n := n) (t := t) (p := p) (u := u) hscale
  have hpow : t * ((n : ℝ) * t ^ (n - 1)) = (n : ℝ) * t ^ n := by
    cases n with
    | zero => norm_num
    | succ n =>
      rw [Nat.cast_succ, Nat.succ_sub_one, pow_succ]
      ring
  let w : ℝ := t ^ n
  let dw : ℝ := (n : ℝ) * t ^ (n - 1)
  let s : ℝ := mu * w
  let ds : ℝ := mu * dw
  let a : ℝ := p + sig * w
  let da : ℝ := sig * dw
  let z : ℝ := (u - a) / s
  let dz : ℝ := ((-da) * s - (u - a) * ds) / s ^ 2
  change HasDerivAt (fun q : ℝ ↦ (mu * q ^ n)⁻¹ * gaussian
    ((u - (p + sig * q ^ n)) / (mu * q ^ n)))
    (-(n : ℝ) / t * (s⁻¹ * gaussian z + (z + sig / mu) *
      (s⁻¹ * gaussianDeriv z))) t
