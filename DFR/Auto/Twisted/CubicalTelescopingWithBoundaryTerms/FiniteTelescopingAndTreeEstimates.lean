/-- Pure finite algebra assembling the one-box identity once the endpoint,
local, face, and scale-FTC expansions have been identified. -/
theorem singleBox_finite_telescoping_assembly
    (α : Anisotropy) (Q : AnisoBox α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ)
    (H P : ℝ) (I U V : Fin 3 → ℝ)
    (hChild : cubeEndpointForm α (boxChildren α Q) lam r F = Real.pi * H)
    (hParent : cubeEndpointForm α ({Q} : BoxCollection α) lam r F = Real.pi * P)
    (hLocal : ∀ i : Fin 3,
      localCubeForm α ({Q} : BoxCollection α) i lam r F = I i)
    (hUpper : ∀ i : Fin 3,
      cubeFaceScaleIntegral α i ⟨Q, FaceOrientation.upper⟩ lam r F = U i)
    (hLower : ∀ i : Fin 3,
      cubeFaceScaleIntegral α i ⟨Q, FaceOrientation.lower⟩ lam r F = V i)
    (hScale : H - P = ∑ i : Fin 3,
      ((α.weight i : ℝ) / Real.pi * I i +
        (α.weight i : ℝ) * (U i - V i))) :
    (∑ i : Fin 3, (α.weight i : ℝ) *
      localCubeForm α ({Q} : BoxCollection α) i lam r F) =
      cubeEndpointForm α (boxChildren α Q) lam r F -
        cubeEndpointForm α ({Q} : BoxCollection α) lam r F +
        cubeBoxBoundaryForm α Q lam r F := by
  have hpi : Real.pi ≠ 0 := ne_of_gt Real.pi_pos
  have hfaces :
      (∑ i : Fin 3, (α.weight i : ℝ) *
        (cubeFaceScaleIntegral α i ⟨Q, FaceOrientation.upper⟩ lam r F -
          cubeFaceScaleIntegral α i ⟨Q, FaceOrientation.lower⟩ lam r F)) =
        ∑ i : Fin 3, (α.weight i : ℝ) * (U i - V i) := by
    apply Finset.sum_congr rfl
    intro i hi
    rw [hUpper i, hLower i]
  have halgebra :
      (∑ i : Fin 3, (α.weight i : ℝ) * I i) =
        Real.pi *
          (∑ i : Fin 3, ((α.weight i : ℝ) / Real.pi * I i +
            (α.weight i : ℝ) * (U i - V i))) -
          Real.pi * (∑ i : Fin 3, (α.weight i : ℝ) * (U i - V i)) := by
    calc
      (∑ i : Fin 3, (α.weight i : ℝ) * I i) =
          ∑ i : Fin 3,
            (Real.pi * ((α.weight i : ℝ) / Real.pi * I i +
              (α.weight i : ℝ) * (U i - V i)) -
              Real.pi * ((α.weight i : ℝ) * (U i - V i))) := by
            apply Finset.sum_congr rfl
            intro i hi
            field_simp [hpi]
            ring
      _ = (∑ i : Fin 3,
            Real.pi * ((α.weight i : ℝ) / Real.pi * I i +
              (α.weight i : ℝ) * (U i - V i))) -
            ∑ i : Fin 3, Real.pi * ((α.weight i : ℝ) * (U i - V i)) := by
            rw [Finset.sum_sub_distrib]
      _ = _ := by
            rw [Finset.mul_sum, Finset.mul_sum]
  calc
    (∑ i : Fin 3, (α.weight i : ℝ) *
      localCubeForm α ({Q} : BoxCollection α) i lam r F) =
        ∑ i : Fin 3, (α.weight i : ℝ) * I i := by
          apply Finset.sum_congr rfl
          intro i hi
          rw [hLocal i]
    _ = Real.pi * (H - P) -
          Real.pi * (∑ i : Fin 3, (α.weight i : ℝ) * (U i - V i)) := by
          rw [hScale]
          exact halgebra
    _ = Real.pi * H - Real.pi * P +
          -Real.pi * (∑ i : Fin 3, (α.weight i : ℝ) * (U i - V i)) := by
          ring
    _ = cubeEndpointForm α (boxChildren α Q) lam r F -
          cubeEndpointForm α ({Q} : BoxCollection α) lam r F +
          cubeBoxBoundaryForm α Q lam r F := by
          rw [hChild, hParent]
          unfold cubeBoxBoundaryForm
          rw [hfaces]

/-- The source one-box finite telescoping identity, with every Fubini and
scale-integrability requirement exposed as an explicit hypothesis. The
bounded-continuous wrappers in the main development discharge these hypotheses
from the Gaussian majorants. -/
theorem singleBox_finite_telescoping_of_integrable
    (α : Anisotropy) (Q : AnisoBox α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (hlam : 1 ≤ lam)
    (hChild : Integrable (Function.uncurry (fun p : E3 ↦ fun x : E6 ↦
      cubeSignedInputProduct F x *
        cubeEndpointKernel α lam r (boxLength Q / 2) p x))
      ((volume.restrict (boxSet α Q)).prod volume))
    (hParent : Integrable (Function.uncurry (fun p : E3 ↦ fun x : E6 ↦
      cubeSignedInputProduct F x *
        cubeEndpointKernel α lam r (boxLength Q) p x))
      ((volume.restrict (boxSet α Q)).prod volume))
    (hhalf : ∀ x : E6, IntegrableOn
      (fun p : E3 ↦ cubeEndpointKernel α lam r (boxLength Q / 2) p x)
      (boxSet α Q))
    (hfull : ∀ x : E6, IntegrableOn
      (fun p : E3 ↦ cubeEndpointKernel α lam r (boxLength Q) p x)
      (boxSet α Q))
    (hderiv : ∀ x : E6, Integrable
      (Function.uncurry (fun t : ℝ ↦ fun p : E3 ↦
        (-t * deriv (fun s : ℝ ↦ cubeEndpointKernel α lam r s p x) t) / t))
      ((volume.restrict (Set.Ioc (boxLength Q / 2) (boxLength Q))).prod
        (volume.restrict (boxSet α Q))))
    (hLocal : ∀ i : Fin 3, Integrable
      (Function.uncurry (fun z : E3 × ℝ ↦ fun x : E6 ↦
        cubeSignedInputProduct F x * localCubeKernel α i lam r z.2 z.1 x))
      (((volume.restrict (boxSet α Q)).prod
        ((volume.withDensity cubeScaleDensity).restrict (boxScaleBand Q))).prod volume))
    (hFace : ∀ (i : Fin 3) (o : FaceOrientation), Integrable
      (Function.uncurry (fun ty : ℝ × TransverseSpace i ↦ fun x : E6 ↦
        ty.1 ^ (α.weight i - 1) *
          (cubeSignedInputProduct F x * cubeFaceKernel α i lam r ty.1
            (faceInsert i (boxFaceCoordinate α Q i o) ty.2) x)))
      (((volume.restrict (Set.Ioc (boxLength Q / 2) (boxLength Q))).prod
        (volume.restrict (transverseRectangle α Q i))).prod volume))
    (hI : ∀ x : E6, ∀ i : Fin 3, Integrable
      (boxInteriorScaleIntegrand α Q i lam r x)
      (volume.restrict (Set.Ioc (boxLength Q / 2) (boxLength Q))))
    (hU : ∀ x : E6, ∀ i : Fin 3, Integrable
      (boxFaceScaleIntegrand α Q i FaceOrientation.upper lam r x)
      (volume.restrict (Set.Ioc (boxLength Q / 2) (boxLength Q))))
    (hV : ∀ x : E6, ∀ i : Fin 3, Integrable
      (boxFaceScaleIntegrand α Q i FaceOrientation.lower lam r x)
      (volume.restrict (Set.Ioc (boxLength Q / 2) (boxLength Q))))
    (hXI : ∀ i : Fin 3, Integrable (fun x : E6 ↦
      cubeSignedInputProduct F x *
        (∫ t : ℝ in Set.Ioc (boxLength Q / 2) (boxLength Q),
          boxInteriorScaleIntegrand α Q i lam r x t)) volume)
    (hXU : ∀ i : Fin 3, Integrable (fun x : E6 ↦
      cubeSignedInputProduct F x *
        (∫ t : ℝ in Set.Ioc (boxLength Q / 2) (boxLength Q),
          boxFaceScaleIntegrand α Q i FaceOrientation.upper lam r x t)) volume)
    (hXV : ∀ i : Fin 3, Integrable (fun x : E6 ↦
      cubeSignedInputProduct F x *
        (∫ t : ℝ in Set.Ioc (boxLength Q / 2) (boxLength Q),
          boxFaceScaleIntegrand α Q i FaceOrientation.lower lam r x t)) volume) :
    (∑ i : Fin 3, (α.weight i : ℝ) *
      localCubeForm α ({Q} : BoxCollection α) i lam r F) =
      cubeEndpointForm α (boxChildren α Q) lam r F -
        cubeEndpointForm α ({Q} : BoxCollection α) lam r F +
        cubeBoxBoundaryForm α Q lam r F := by
  let H : ℝ := ∫ x : E6, cubeSignedInputProduct F x *
    (∫ p : E3 in boxSet α Q,
      cubeEndpointKernel α lam r (boxLength Q / 2) p x)
  let P : ℝ := ∫ x : E6, cubeSignedInputProduct F x *
    (∫ p : E3 in boxSet α Q,
      cubeEndpointKernel α lam r (boxLength Q) p x)
  let I : Fin 3 → ℝ := fun i ↦ ∫ x : E6, cubeSignedInputProduct F x *
    (∫ t : ℝ in Set.Ioc (boxLength Q / 2) (boxLength Q),
      boxInteriorScaleIntegrand α Q i lam r x t)
  let U : Fin 3 → ℝ := fun i ↦ ∫ x : E6, cubeSignedInputProduct F x *
    (∫ t : ℝ in Set.Ioc (boxLength Q / 2) (boxLength Q),
      boxFaceScaleIntegrand α Q i FaceOrientation.upper lam r x t)
  let V : Fin 3 → ℝ := fun i ↦ ∫ x : E6, cubeSignedInputProduct F x *
    (∫ t : ℝ in Set.Ioc (boxLength Q / 2) (boxLength Q),
      boxFaceScaleIntegrand α Q i FaceOrientation.lower lam r x t)
  have hChild' : cubeEndpointForm α (boxChildren α Q) lam r F = Real.pi * H := by
    simpa only [H] using
      cubeEndpointForm_children_eq_spatial_outer α Q lam r F hChild
  have hParent' : cubeEndpointForm α ({Q} : BoxCollection α) lam r F =
      Real.pi * P := by
    simpa only [P] using
      cubeEndpointForm_singleton_eq_spatial_outer α Q lam r F hParent
  have hLocal' (i : Fin 3) :
      localCubeForm α ({Q} : BoxCollection α) i lam r F = I i := by
    simpa only [I] using
      localCubeForm_singleton_eq_spatial_interiorScale α Q i lam r F (hLocal i)
  have hUpper' (i : Fin 3) :
      cubeFaceScaleIntegral α i ⟨Q, FaceOrientation.upper⟩ lam r F = U i := by
    simpa only [U] using
      cubeFaceScaleIntegral_eq_spatial_faceScale α Q i FaceOrientation.upper
        lam r F (hFace i FaceOrientation.upper)
  have hLower' (i : Fin 3) :
      cubeFaceScaleIntegral α i ⟨Q, FaceOrientation.lower⟩ lam r F = V i := by
    simpa only [V] using
      cubeFaceScaleIntegral_eq_spatial_faceScale α Q i FaceOrientation.lower
        lam r F (hFace i FaceOrientation.lower)
  have hHalfOuter : Integrable (fun x : E6 ↦ cubeSignedInputProduct F x *
      (∫ p : E3 in boxSet α Q,
        cubeEndpointKernel α lam r (boxLength Q / 2) p x)) volume := by
    convert hChild.swap.integral_prod_left using 1
    funext x
    change cubeSignedInputProduct F x *
        (∫ p : E3 in boxSet α Q,
          cubeEndpointKernel α lam r (boxLength Q / 2) p x) =
      ∫ p : E3 in boxSet α Q,
        cubeSignedInputProduct F x *
          cubeEndpointKernel α lam r (boxLength Q / 2) p x
    rw [MeasureTheory.integral_const_mul]
  have hFullOuter : Integrable (fun x : E6 ↦ cubeSignedInputProduct F x *
      (∫ p : E3 in boxSet α Q,
        cubeEndpointKernel α lam r (boxLength Q) p x)) volume := by
    convert hParent.swap.integral_prod_left using 1
    funext x
    change cubeSignedInputProduct F x *
        (∫ p : E3 in boxSet α Q,
          cubeEndpointKernel α lam r (boxLength Q) p x) =
      ∫ p : E3 in boxSet α Q,
        cubeSignedInputProduct F x *
          cubeEndpointKernel α lam r (boxLength Q) p x
    rw [MeasureTheory.integral_const_mul]
  have hCenter := singleBox_center_scale_telescope_spatial_split
    α Q lam r F hlam hhalf hfull hderiv hI hU hV
  have hOuter := integral_spatial_scale_sum_expand α Q lam r F hXI hXU hXV
  have hScale : H - P = ∑ i : Fin 3,
      ((α.weight i : ℝ) / Real.pi * I i +
        (α.weight i : ℝ) * (U i - V i)) := by
    calc
      H - P = (∫ x : E6, cubeSignedInputProduct F x *
          (∫ p : E3 in boxSet α Q,
            cubeEndpointKernel α lam r (boxLength Q / 2) p x)) -
          ∫ x : E6, cubeSignedInputProduct F x *
            (∫ p : E3 in boxSet α Q,
              cubeEndpointKernel α lam r (boxLength Q) p x) := by
          rfl
      _ = ∫ x : E6,
          (cubeSignedInputProduct F x *
            (∫ p : E3 in boxSet α Q,
              cubeEndpointKernel α lam r (boxLength Q / 2) p x) -
           cubeSignedInputProduct F x *
            (∫ p : E3 in boxSet α Q,
              cubeEndpointKernel α lam r (boxLength Q) p x)) := by
          rw [MeasureTheory.integral_sub hHalfOuter hFullOuter]
      _ = ∫ x : E6, cubeSignedInputProduct F x *
          ((∫ p : E3 in boxSet α Q,
            cubeEndpointKernel α lam r (boxLength Q / 2) p x) -
           (∫ p : E3 in boxSet α Q,
            cubeEndpointKernel α lam r (boxLength Q) p x)) := by
          apply integral_congr_ae
          filter_upwards [] with x
          ring
      _ = ∑ i : Fin 3,
          ((α.weight i : ℝ) / Real.pi * I i +
            (α.weight i : ℝ) * (U i - V i)) := by
          simpa only [I, U, V] using hCenter.trans hOuter
  exact singleBox_finite_telescoping_assembly α Q lam r F H P I U V
    hChild' hParent' hLocal' hUpper' hLower' hScale

/-- The same one-box identity with all scale Fubini hypotheses discharged
except for the four natural joint product-integrability inputs. The
fixed-spatial-point conditions are only needed almost everywhere and are
therefore obtained from the corresponding bare-kernel triples. -/
theorem singleBox_finite_telescoping_of_integrable_ae
    (α : Anisotropy) (Q : AnisoBox α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (hlam : 1 ≤ lam)
    (hChild : Integrable (Function.uncurry (fun p : E3 ↦ fun x : E6 ↦
      cubeSignedInputProduct F x *
        cubeEndpointKernel α lam r (boxLength Q / 2) p x))
      ((volume.restrict (boxSet α Q)).prod volume))
    (hParent : Integrable (Function.uncurry (fun p : E3 ↦ fun x : E6 ↦
      cubeSignedInputProduct F x *
        cubeEndpointKernel α lam r (boxLength Q) p x))
      ((volume.restrict (boxSet α Q)).prod volume))
    (hhalf : ∀ x : E6, IntegrableOn
      (fun p : E3 ↦ cubeEndpointKernel α lam r (boxLength Q / 2) p x)
      (boxSet α Q))
    (hfull : ∀ x : E6, IntegrableOn
      (fun p : E3 ↦ cubeEndpointKernel α lam r (boxLength Q) p x)
      (boxSet α Q))
    (hderiv : ∀ x : E6, Integrable
      (Function.uncurry (fun t : ℝ ↦ fun p : E3 ↦
        (-t * deriv (fun s : ℝ ↦ cubeEndpointKernel α lam r s p x) t) / t))
      ((volume.restrict (Set.Ioc (boxLength Q / 2) (boxLength Q))).prod
        (volume.restrict (boxSet α Q))))
    (hLocal : ∀ i : Fin 3, Integrable
      (Function.uncurry (fun z : E3 × ℝ ↦ fun x : E6 ↦
        cubeSignedInputProduct F x * localCubeKernel α i lam r z.2 z.1 x))
      (((volume.restrict (boxSet α Q)).prod
        ((volume.withDensity cubeScaleDensity).restrict (boxScaleBand Q))).prod volume))
    (hFace : ∀ (i : Fin 3) (o : FaceOrientation), Integrable
      (Function.uncurry (fun ty : ℝ × TransverseSpace i ↦ fun x : E6 ↦
        ty.1 ^ (α.weight i - 1) *
          (cubeSignedInputProduct F x * cubeFaceKernel α i lam r ty.1
            (faceInsert i (boxFaceCoordinate α Q i o) ty.2) x)))
      (((volume.restrict (Set.Ioc (boxLength Q / 2) (boxLength Q))).prod
        (volume.restrict (transverseRectangle α Q i))).prod volume))
    (hI : ∀ i : Fin 3, ∀ᵐ x : E6 ∂volume, Integrable
      (boxInteriorScaleIntegrand α Q i lam r x)
      (volume.restrict (Set.Ioc (boxLength Q / 2) (boxLength Q))))
    (hU : ∀ i : Fin 3, ∀ᵐ x : E6 ∂volume, Integrable
      (boxFaceScaleIntegrand α Q i FaceOrientation.upper lam r x)
      (volume.restrict (Set.Ioc (boxLength Q / 2) (boxLength Q))))
    (hV : ∀ i : Fin 3, ∀ᵐ x : E6 ∂volume, Integrable
      (boxFaceScaleIntegrand α Q i FaceOrientation.lower lam r x)
      (volume.restrict (Set.Ioc (boxLength Q / 2) (boxLength Q)))) :
    (∑ i : Fin 3, (α.weight i : ℝ) *
      localCubeForm α ({Q} : BoxCollection α) i lam r F) =
      cubeEndpointForm α (boxChildren α Q) lam r F -
        cubeEndpointForm α ({Q} : BoxCollection α) lam r F +
        cubeBoxBoundaryForm α Q lam r F := by
  let H : ℝ := ∫ x : E6, cubeSignedInputProduct F x *
    (∫ p : E3 in boxSet α Q,
      cubeEndpointKernel α lam r (boxLength Q / 2) p x)
  let P : ℝ := ∫ x : E6, cubeSignedInputProduct F x *
    (∫ p : E3 in boxSet α Q,
      cubeEndpointKernel α lam r (boxLength Q) p x)
  let I : Fin 3 → ℝ := fun i ↦ ∫ x : E6, cubeSignedInputProduct F x *
    (∫ t : ℝ in Set.Ioc (boxLength Q / 2) (boxLength Q),
      boxInteriorScaleIntegrand α Q i lam r x t)
  let U : Fin 3 → ℝ := fun i ↦ ∫ x : E6, cubeSignedInputProduct F x *
    (∫ t : ℝ in Set.Ioc (boxLength Q / 2) (boxLength Q),
      boxFaceScaleIntegrand α Q i FaceOrientation.upper lam r x t)
  let V : Fin 3 → ℝ := fun i ↦ ∫ x : E6, cubeSignedInputProduct F x *
    (∫ t : ℝ in Set.Ioc (boxLength Q / 2) (boxLength Q),
      boxFaceScaleIntegrand α Q i FaceOrientation.lower lam r x t)
  have hChild' : cubeEndpointForm α (boxChildren α Q) lam r F = Real.pi * H := by
    simpa only [H] using
      cubeEndpointForm_children_eq_spatial_outer α Q lam r F hChild
  have hParent' : cubeEndpointForm α ({Q} : BoxCollection α) lam r F =
      Real.pi * P := by
    simpa only [P] using
      cubeEndpointForm_singleton_eq_spatial_outer α Q lam r F hParent
  have hLocal' (i : Fin 3) :
      localCubeForm α ({Q} : BoxCollection α) i lam r F = I i := by
    simpa only [I] using
      localCubeForm_singleton_eq_spatial_interiorScale α Q i lam r F (hLocal i)
  have hUpper' (i : Fin 3) :
      cubeFaceScaleIntegral α i ⟨Q, FaceOrientation.upper⟩ lam r F = U i := by
    simpa only [U] using
      cubeFaceScaleIntegral_eq_spatial_faceScale α Q i FaceOrientation.upper
        lam r F (hFace i FaceOrientation.upper)
  have hLower' (i : Fin 3) :
      cubeFaceScaleIntegral α i ⟨Q, FaceOrientation.lower⟩ lam r F = V i := by
    simpa only [V] using
      cubeFaceScaleIntegral_eq_spatial_faceScale α Q i FaceOrientation.lower
        lam r F (hFace i FaceOrientation.lower)
  have hHalfOuter : Integrable (fun x : E6 ↦ cubeSignedInputProduct F x *
      (∫ p : E3 in boxSet α Q,
        cubeEndpointKernel α lam r (boxLength Q / 2) p x)) volume := by
    convert hChild.swap.integral_prod_left using 1
    funext x
    change cubeSignedInputProduct F x *
        (∫ p : E3 in boxSet α Q,
          cubeEndpointKernel α lam r (boxLength Q / 2) p x) =
      ∫ p : E3 in boxSet α Q,
        cubeSignedInputProduct F x *
          cubeEndpointKernel α lam r (boxLength Q / 2) p x
    rw [MeasureTheory.integral_const_mul]
  have hFullOuter : Integrable (fun x : E6 ↦ cubeSignedInputProduct F x *
      (∫ p : E3 in boxSet α Q,
        cubeEndpointKernel α lam r (boxLength Q) p x)) volume := by
    convert hParent.swap.integral_prod_left using 1
    funext x
    change cubeSignedInputProduct F x *
        (∫ p : E3 in boxSet α Q,
          cubeEndpointKernel α lam r (boxLength Q) p x) =
      ∫ p : E3 in boxSet α Q,
        cubeSignedInputProduct F x *
          cubeEndpointKernel α lam r (boxLength Q) p x
    rw [MeasureTheory.integral_const_mul]
  have hCenter := singleBox_center_scale_telescope_spatial_split_ae
    α Q lam r F hlam hhalf hfull hderiv hI hU hV
  have hOuter := integral_spatial_scale_sum_expand α Q lam r F
    (fun i ↦ integrable_spatial_interiorScale_of_localTriple α Q i lam r F (hLocal i))
    (fun i ↦ integrable_spatial_faceScale_of_faceTriple α Q i FaceOrientation.upper
      lam r F (hFace i FaceOrientation.upper))
    (fun i ↦ integrable_spatial_faceScale_of_faceTriple α Q i FaceOrientation.lower
      lam r F (hFace i FaceOrientation.lower))
  have hScale : H - P = ∑ i : Fin 3,
      ((α.weight i : ℝ) / Real.pi * I i +
        (α.weight i : ℝ) * (U i - V i)) := by
    calc
      H - P = (∫ x : E6, cubeSignedInputProduct F x *
          (∫ p : E3 in boxSet α Q,
            cubeEndpointKernel α lam r (boxLength Q / 2) p x)) -
          ∫ x : E6, cubeSignedInputProduct F x *
            (∫ p : E3 in boxSet α Q,
              cubeEndpointKernel α lam r (boxLength Q) p x) := by
          rfl
      _ = ∫ x : E6,
          (cubeSignedInputProduct F x *
            (∫ p : E3 in boxSet α Q,
              cubeEndpointKernel α lam r (boxLength Q / 2) p x) -
           cubeSignedInputProduct F x *
            (∫ p : E3 in boxSet α Q,
              cubeEndpointKernel α lam r (boxLength Q) p x)) := by
          rw [MeasureTheory.integral_sub hHalfOuter hFullOuter]
      _ = ∫ x : E6, cubeSignedInputProduct F x *
          ((∫ p : E3 in boxSet α Q,
            cubeEndpointKernel α lam r (boxLength Q / 2) p x) -
           (∫ p : E3 in boxSet α Q,
            cubeEndpointKernel α lam r (boxLength Q) p x)) := by
          apply integral_congr_ae
          filter_upwards [] with x
          ring
      _ = ∑ i : Fin 3,
          ((α.weight i : ℝ) / Real.pi * I i +
            (α.weight i : ℝ) * (U i - V i)) := by
          simpa only [I, U, V] using hCenter.trans hOuter
  exact singleBox_finite_telescoping_assembly α Q lam r F H P I U V
    hChild' hParent' hLocal' hUpper' hLower' hScale

/-- Fully unconditional one-box source telescope for bounded continuous cube
data. All analytic side conditions are supplied by the established compact
cell Gaussian majorants and the endpoint scale-FTC package. -/
theorem singleBox_finite_telescoping_of_boundedContinuous
    (α : Anisotropy) (Q : AnisoBox α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ)
    (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (hlam : 1 ≤ lam) :
    (∑ i : Fin 3, (α.weight i : ℝ) *
      localCubeForm α ({Q} : BoxCollection α) i lam r F) =
      cubeEndpointForm α (boxChildren α Q) lam r F -
        cubeEndpointForm α ({Q} : BoxCollection α) lam r F +
        cubeBoxBoundaryForm α Q lam r F := by
  apply singleBox_finite_telescoping_of_integrable_ae α Q lam r F hlam
  · exact integrable_cubeSignedInputProduct_mul_cubeEndpointKernel_center_space
      α Q lam r (boxLength Q / 2) F hFcont hFbound hlam
        (div_pos (boxLength_pos Q) (by norm_num))
  · exact integrable_cubeSignedInputProduct_mul_cubeEndpointKernel_center_space
      α Q lam r (boxLength Q) F hFcont hFbound hlam (boxLength_pos Q)
  · intro x
    exact (singleBox_endpointScaleFTC_integrability α Q lam r x hlam).1
  · intro x
    exact (singleBox_endpointScaleFTC_integrability α Q lam r x hlam).2.1
  · intro x
    exact (singleBox_endpointScaleFTC_integrability α Q lam r x hlam).2.2
  · intro i
    exact integrable_cubeSignedInputProduct_mul_localCubeKernel_boxScaleCell
      α Q i lam r F hFcont hFbound hlam
  · intro i o
    exact integrable_cubeFaceScaleIntegrand α Q i o lam r F hFcont hFbound hlam
  · intro i
    exact ae_integrable_interiorScale_of_unweightedTriple α Q i lam r
      (integrable_localCubeKernel_boxScaleCell α Q i lam r hlam)
  · intro i
    exact ae_integrable_faceScale_of_unweightedTriple α Q i FaceOrientation.upper lam r
      (integrable_cubeFaceScaleKernel α Q i FaceOrientation.upper lam r hlam)
  · intro i
    exact ae_integrable_faceScale_of_unweightedTriple α Q i FaceOrientation.lower lam r
      (integrable_cubeFaceScaleKernel α Q i FaceOrientation.lower lam r hlam)


theorem integrableOn_localCube_outer_collectionRegion
    (α : Anisotropy) (S : BoxCollection α) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ)
    (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B)
    (hlam : 1 ≤ lam) :
    IntegrableOn (fun z : E3 × ℝ ↦
      ∫ x : E6, cubeSignedInputProduct F x *
        localCubeKernel α i lam r z.2 z.1 x)
      (collectionRegion α S) cubeScaleMeasure := by
  let g : E3 × ℝ → ℝ := fun z ↦
    ∫ x : E6, cubeSignedInputProduct F x *
      localCubeKernel α i lam r z.2 z.1 x
  have hcell (q : AnisoBox α) :
      IntegrableOn g (boxScaleRegion α q) cubeScaleMeasure := by
    change Integrable g (cubeScaleMeasure.restrict (boxScaleRegion α q))
    rw [cubeScaleMeasure_restrict_boxScaleRegion]
    exact (integrable_cubeSignedInputProduct_mul_localCubeKernel_boxScaleCell
      α q i lam r F hFcont hFbound hlam).integral_prod_left
  change IntegrableOn g (collectionRegion α S) cubeScaleMeasure
  classical
  induction S using Finset.induction_on with
  | empty =>
      simp [collectionRegion]
  | @insert q S hq ih =>
      have hregion : collectionRegion α (insert q S) =
          boxScaleRegion α q ∪ collectionRegion α S := by
        ext z
        simp [collectionRegion]
      rw [hregion]
      exact (hcell q).union ih

theorem cubeTree_telescope_of_boundedContinuous
    (α : Anisotropy) (T : FiniteConvexTree α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ)
    (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B)
    (hlam : 1 ≤ lam) :
    (∑ i : Fin 3, (α.weight i : ℝ) *
      localCubeForm α T.boxes i lam r F) =
      cubeTreeRemainder α T lam r F := by
  apply cubeTree_telescope_of_single α T lam r F
  · intro i
    exact integrableOn_localCube_outer_collectionRegion α T.boxes i lam r F
      hFcont hFbound hlam
  · intro q hq
    exact singleBox_finite_telescoping_of_boundedContinuous α q lam r F
      hFcont hFbound hlam


/-- Positivity of the local-size quantities at the fourth-moment exponent,
recorded for assembling a nonnegative uniform remainder constant. -/
theorem treeLocalSize_four_nonneg
    (T : FiniteConvexTree α) (f : E3 → ℝ) :
    0 ≤ treeLocalSize T 4 f := by
  unfold treeLocalSize collectionLocalSize
  split_ifs with hT
  · rcases hT with ⟨q, hq⟩
    exact (show 0 ≤ boxLocalSize α 4 f q by
      unfold boxLocalSize boxLocalPower
      apply Real.rpow_nonneg
      apply MeasureTheory.integral_nonneg
      intro y
      exact mul_nonneg (Real.rpow_nonneg (abs_nonneg (f y)) _)
        (anisotropicBracketKernel_nonneg α (boxLength_pos q).le (boxCenter α q) y)).trans
      (Finset.le_sup' (boxLocalSize α 4 f) hq)
  · norm_num

/-- The product of the eight fourth local sizes is nonnegative. -/
theorem treeLocalSize_product_four_nonneg
    (T : FiniteConvexTree α) (F : CubeVertex → E3 → ℝ) :
    0 ≤ ∏ j : CubeVertex, treeLocalSize T 4 (F j) := by
  exact Finset.prod_nonneg fun j _ ↦ treeLocalSize_four_nonneg T (F j)


/-- The bounded-continuous finite-tree remainder estimate. The constant
depends only on the anisotropy; the analytic powers are the exact endpoint
and face losses `λ^36 R^20` and `λ^37 R^21`, absorbed into the latter. -/
theorem cubeTreeRemainder_bound_of_boundedContinuous
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α) (lam r : ℝ)
      (F : CubeVertex → E3 → ℝ),
      (∀ j, Continuous (F j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B) →
      1 ≤ lam →
      |cubeTreeRemainder α T lam r F| ≤
        C * lam ^ 37 * translationWeight r ^ 21 *
          (∏ j : CubeVertex, treeLocalSize T 4 (F j)) * boxMass α T.root := by
  rcases abs_integral_cubeEndpointKernel_le_treeLocalSize_product_of_mem_closure α
    with ⟨CE, hCE, hEndpoint⟩
  rcases abs_integral_cubeFaceKernel_le_treeLocalSize_product_of_mem_closure α
    with ⟨CF, hCF, hFace⟩
  refine ⟨2 * Real.pi * CE + 24 * Real.pi * CF, ?_, ?_⟩
  · exact add_nonneg
      (mul_nonneg (mul_nonneg (by norm_num) Real.pi_pos.le) hCE)
      (mul_nonneg (mul_nonneg (by norm_num) Real.pi_pos.le) hCF)
  · intro T lam r F hFcont hFbound hlam
    have hFmeas : ∀ j, Measurable (F j) := fun j ↦ (hFcont j).measurable
    let P : ℝ := ∏ j : CubeVertex, treeLocalSize T 4 (F j)
    let DE : ℝ := CE * lam ^ 36 * translationWeight r ^ 20 * P
    let DF : ℝ := CF * lam ^ 37 * translationWeight r ^ 21 * P
    have hP : 0 ≤ P := by
      dsimp only [P]
      exact treeLocalSize_product_four_nonneg T F
    have hlam0 : 0 ≤ lam := by linarith
    have hR0 : 0 ≤ translationWeight r := by
      unfold translationWeight
      positivity
    have hDF : 0 ≤ DF := by
      dsimp only [DF]
      exact mul_nonneg
        (mul_nonneg
          (mul_nonneg hCF (pow_nonneg hlam0 _))
          (pow_nonneg hR0 _)) hP
    have hLeafInt : ∀ q ∈ treeLeaves T,
        IntegrableOn (cubeEndpointIntegrand α lam r (boxLength q) F)
          (boxSet α q) := by
      intro q hq
      exact integrableOn_cubeEndpointIntegrand_boxSet α q lam r (boxLength q) F
        hFcont hFbound hlam (boxLength_pos q)
    have hLeafBound : ∀ q ∈ treeLeaves T, ∀ p ∈ boxSet α q,
        |cubeEndpointIntegrand α lam r (boxLength q) F p| ≤ DE := by
      intro q hq p hp
      change |∫ x : E6, cubeSignedInputProduct F x *
        cubeEndpointKernel α lam r (boxLength q) p x| ≤ DE
      exact hEndpoint T lam r (boxLength q) p F hFcont hFmeas hFbound hlam
        (mem_closure_collectionRegion_of_mem_leaf_boxSet_fullScale α T q hq hp)
    have hRootInt : IntegrableOn
        (cubeEndpointIntegrand α lam r (boxLength T.root) F)
        (boxSet α T.root) :=
      integrableOn_cubeEndpointIntegrand_boxSet α T.root lam r (boxLength T.root) F
        hFcont hFbound hlam (boxLength_pos T.root)
    have hRootBound : ∀ p ∈ boxSet α T.root,
        |cubeEndpointIntegrand α lam r (boxLength T.root) F p| ≤ DE := by
      intro p hp
      change |∫ x : E6, cubeSignedInputProduct F x *
        cubeEndpointKernel α lam r (boxLength T.root) p x| ≤ DE
      exact hEndpoint T lam r (boxLength T.root) p F hFcont hFmeas hFbound hlam
        (mem_closure_collectionRegion_of_mem_boxSet_fullScale α T T.root T.root_mem hp)
    have hFaceInt : ∀ (i : Fin 3) (S : OrientedFace α),
        S ∈ survivingFacesAll T i →
        IntegrableOn (fun t : ℝ ↦ t ^ (α.weight i - 1) *
          cubeFaceIntegral α i S lam r t F)
          (Set.Ioc (boxLength S.box / 2) (boxLength S.box)) := by
      intro i S hS
      simpa only using integrableOn_cubeFaceIntegral_scale α S.box i S.orientation
        lam r F hFcont hFbound hlam
    have hFaceBound : ∀ (i : Fin 3) (S : OrientedFace α),
        S ∈ survivingFacesAll T i →
        ∀ t ∈ Set.Ioc (boxLength S.box / 2) (boxLength S.box),
          |cubeFaceIntegral α i S lam r t F| ≤ DF * transverseArea α S.box i := by
      intro i S hS t ht
      let g : TransverseSpace i → ℝ := fun y ↦ ∫ x : E6,
        cubeSignedInputProduct F x * cubeFaceKernel α i lam r t
          (faceInsert i (boxFaceCoordinate α S.box i S.orientation) y) x
      have htpos : 0 < t := by
        exact lt_trans (div_pos (boxLength_pos S.box) (by norm_num)) ht.1
      have hg : IntegrableOn g (transverseRectangle α S.box i) := by
        dsimp only [g]
        exact integrable_cubeFaceKernel_face_outer α S.box i
          (boxFaceCoordinate α S.box i S.orientation) lam r t F
          hFcont hFbound hlam htpos
      have hbox : S.box ∈ T.boxes := (mem_survivingFacesAll_iff T i S).mp hS |>.1
      have hgy : ∀ y ∈ transverseRectangle α S.box i, |g y| ≤ DF := by
        intro y hy
        dsimp only [g, DF]
        exact hFace T i lam r t
          (faceInsert i (boxFaceCoordinate α S.box i S.orientation) y) F
          hFcont hFmeas hFbound hlam
          (mem_closure_collectionRegion_face α T.boxes S.box i S.orientation
            hbox hy (Set.Ioc_subset_Icc_self ht))
      simpa only [cubeFaceIntegral, g] using
        abs_integral_transverseRectangle_le_const_mul_area α S.box i g hg DF hgy
    have hrem := abs_cubeTreeRemainder_le_of_uniform_bounds α T lam r F DE DF hDF
      hLeafInt hLeafBound hRootInt hRootBound hFaceInt hFaceBound
    have hlam36 : lam ^ 36 ≤ lam ^ 37 := by
      calc
        lam ^ 36 = lam ^ 36 * 1 := by ring
        _ ≤ lam ^ 36 * lam :=
          mul_le_mul_of_nonneg_left hlam (pow_nonneg hlam0 _)
        _ = lam ^ 37 := by ring
    have hRone : 1 ≤ translationWeight r := by
      unfold translationWeight
      linarith [abs_nonneg r]
    have hR20 : translationWeight r ^ 20 ≤ translationWeight r ^ 21 := by
      calc
        translationWeight r ^ 20 = translationWeight r ^ 20 * 1 := by ring
        _ ≤ translationWeight r ^ 20 * translationWeight r :=
          mul_le_mul_of_nonneg_left hRone (pow_nonneg hR0 _)
        _ = translationWeight r ^ 21 := by ring
    have hscale : lam ^ 36 * translationWeight r ^ 20 ≤
        lam ^ 37 * translationWeight r ^ 21 :=
      mul_le_mul hlam36 hR20 (pow_nonneg hR0 _) (pow_nonneg hlam0 _)
    have hDE : DE ≤ CE * lam ^ 37 * translationWeight r ^ 21 * P := by
      dsimp only [DE]
      calc
        CE * lam ^ 36 * translationWeight r ^ 20 * P =
            (CE * (lam ^ 36 * translationWeight r ^ 20)) * P := by ring
        _ ≤ (CE * (lam ^ 37 * translationWeight r ^ 21)) * P :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left hscale hCE) hP
        _ = CE * lam ^ 37 * translationWeight r ^ 21 * P := by ring
    have hcoef : 0 ≤ 2 * Real.pi := by positivity
    have hterm : 2 * Real.pi * DE ≤
        2 * Real.pi * (CE * lam ^ 37 * translationWeight r ^ 21 * P) :=
      mul_le_mul_of_nonneg_left hDE hcoef
    have hsum :
        2 * Real.pi * DE + 24 * Real.pi * DF ≤
          2 * Real.pi * (CE * lam ^ 37 * translationWeight r ^ 21 * P) +
            24 * Real.pi * (CF * lam ^ 37 * translationWeight r ^ 21 * P) := by
      apply add_le_add hterm
      exact le_rfl
    calc
      |cubeTreeRemainder α T lam r F| ≤
          (2 * Real.pi * DE + 24 * Real.pi * DF) * boxMass α T.root := hrem
      _ ≤ (2 * Real.pi * (CE * lam ^ 37 * translationWeight r ^ 21 * P) +
            24 * Real.pi * (CF * lam ^ 37 * translationWeight r ^ 21 * P)) *
            boxMass α T.root :=
        mul_le_mul_of_nonneg_right hsum (boxMass_pos α T.root).le
      _ = (2 * Real.pi * CE + 24 * Real.pi * CF) * lam ^ 37 *
            translationWeight r ^ 21 * P * boxMass α T.root := by ring
      _ = (2 * Real.pi * CE + 24 * Real.pi * CF) * lam ^ 37 *
            translationWeight r ^ 21 *
            (∏ j : CubeVertex, treeLocalSize T 4 (F j)) * boxMass α T.root := by
        rfl

/-- The exact finite-tree telescope turns the remainder estimate into the
corresponding weighted sum of local cube forms. -/
theorem cubeTreeTelescope_bound_of_boundedContinuous
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α) (lam r : ℝ)
      (F : CubeVertex → E3 → ℝ),
      (∀ j, Continuous (F j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B) →
      1 ≤ lam →
      |∑ i : Fin 3, (α.weight i : ℝ) *
        localCubeForm α T.boxes i lam r F| ≤
        C * lam ^ 37 * translationWeight r ^ 21 *
          (∏ j : CubeVertex, treeLocalSize T 4 (F j)) * boxMass α T.root := by
  rcases cubeTreeRemainder_bound_of_boundedContinuous α with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro T lam r F hFcont hFbound hlam
  rw [cubeTree_telescope_of_boundedContinuous α T lam r F hFcont hFbound hlam]
  exact hbound T lam r F hFcont hFbound hlam


/-- On the three-coordinate cube, deleting one coordinate leaves exactly two
summands. This is the finite counting input in the Section 4 iteration. -/
theorem sum_erase_fin_three_le
    (i : Fin 3) (f : Fin 3 → ℝ) (C : ℝ)
    (h : ∀ q ∈ Finset.univ.erase i, f q ≤ C) :
    (∑ q ∈ Finset.univ.erase i, f q) ≤ 2 * C := by
  calc
    (∑ q ∈ Finset.univ.erase i, f q) ≤
        ∑ _q ∈ Finset.univ.erase i, C := by
      apply Finset.sum_le_sum
      intro q hq
      exact h q hq
    _ = 2 * C := by
      simp [Finset.card_erase_of_mem]

/-- A nonnegative Cauchy--Schwarz product bounded by `C²` controls the
absolute value of its parent quantity by `C`. -/
theorem abs_le_of_sq_le_mul_of_nonneg_le
    (x y z C : ℝ) (hC : 0 ≤ C)
    (hz : 0 ≤ z) (hyC : y ≤ C) (hzC : z ≤ C)
    (h : |x| ^ 2 ≤ y * z) :
    |x| ≤ C := by
  have hyz : y * z ≤ C * C :=
    mul_le_mul hyC hzC hz hC
  have habs : 0 ≤ |x| := abs_nonneg x
  nlinarith

/-- Two distinct coordinates of `Fin 3` have a third coordinate distinct
from both. -/
theorem exists_third_coordinate (i q : Fin 3) (hiq : i ≠ q) :
    ∃ p : Fin 3, p ≠ i ∧ p ≠ q := by
  fin_cases i
  · fin_cases q
    · exact False.elim (hiq rfl)
    · exact ⟨2, by decide, by decide⟩
    · exact ⟨1, by decide, by decide⟩
  · fin_cases q
    · exact ⟨2, by decide, by decide⟩
    · exact False.elim (hiq rfl)
    · exact ⟨0, by decide, by decide⟩
  · fin_cases q
    · exact ⟨1, by decide, by decide⟩
    · exact ⟨0, by decide, by decide⟩
    · exact False.elim (hiq rfl)

/-- Three pairwise distinct elements exhaust `Fin 3`. -/
theorem fin_three_eq_one_of_three
    {i q p k : Fin 3} (hiq : i ≠ q) (hip : i ≠ p) (hqp : q ≠ p) :
    k = i ∨ k = q ∨ k = p := by
  fin_cases i <;> fin_cases q <;> fin_cases p <;> fin_cases k <;> simp_all

/-- The finite coordinate sum can be written in any pairwise-distinct
coordinate order. -/
theorem sum_fin_three_eq_of_pairwise_distinct
    (f : Fin 3 → ℝ) {i q p : Fin 3}
    (hiq : i ≠ q) (hip : i ≠ p) (hqp : q ≠ p) :
    (∑ k : Fin 3, f k) = f i + f q + f p := by
  fin_cases i <;> fin_cases q <;> fin_cases p <;>
    simp_all [Fin.sum_univ_succ] <;> ring

/-- Split a finite coordinate sum into one designated coordinate and the
two-coordinate erased sum. -/
theorem sum_fin_three_split_erase
    (f : Fin 3 → ℝ) (i : Fin 3) :
    (∑ k : Fin 3, f k) = f i + ∑ q ∈ Finset.univ.erase i, f q := by
  rw [← Finset.sum_erase_add Finset.univ f (Finset.mem_univ i)]
  ring

/-- A first-coordinate copy remains fixed after a distinct-coordinate copy. -/
theorem cubeCoordinateCopy_fixed_after_distinct
    {i q : Fin 3} (hiq : i ≠ q) (a b : Bool)
    (F : CubeVertex → E3 → ℝ) :
    cubeCoordinateCopy i a
        (cubeCoordinateCopy q b (cubeCoordinateCopy i a F)) =
      cubeCoordinateCopy q b (cubeCoordinateCopy i a F) := by
  rw [cubeCoordinateCopy_commute hiq a b]
  rw [cubeCoordinateCopy_idempotent]

/-- A tuple copied in three pairwise distinct coordinates is fixed by its
copy in the first coordinate. -/
theorem cubeCoordinateCopy_fixed_three_first
    {i q p : Fin 3} (hiq : i ≠ q) (hip : i ≠ p)
    (a b c : Bool) (F : CubeVertex → E3 → ℝ) :
    cubeCoordinateCopy i a
        (cubeCoordinateCopy p c
          (cubeCoordinateCopy q b (cubeCoordinateCopy i a F))) =
      cubeCoordinateCopy p c
        (cubeCoordinateCopy q b (cubeCoordinateCopy i a F)) := by
  rw [cubeCoordinateCopy_commute hip a c]
  rw [cubeCoordinateCopy_commute hiq a b]
  rw [cubeCoordinateCopy_idempotent]

/-- A tuple copied in three pairwise distinct coordinates is fixed by its
copy in the second coordinate. -/
theorem cubeCoordinateCopy_fixed_three_second
    {i q p : Fin 3} (hqp : q ≠ p)
    (a b c : Bool) (F : CubeVertex → E3 → ℝ) :
    cubeCoordinateCopy q b
        (cubeCoordinateCopy p c
          (cubeCoordinateCopy q b (cubeCoordinateCopy i a F))) =
      cubeCoordinateCopy p c
        (cubeCoordinateCopy q b (cubeCoordinateCopy i a F)) := by
  rw [cubeCoordinateCopy_commute hqp b c]
  rw [cubeCoordinateCopy_idempotent]

/-- A tuple copied in three pairwise distinct coordinates is fixed by its
final-coordinate copy. -/
theorem cubeCoordinateCopy_fixed_three_third
    (i q p : Fin 3) (a b c : Bool)
    (F : CubeVertex → E3 → ℝ) :
    cubeCoordinateCopy p c
        (cubeCoordinateCopy p c
          (cubeCoordinateCopy q b (cubeCoordinateCopy i a F))) =
      cubeCoordinateCopy p c
        (cubeCoordinateCopy q b (cubeCoordinateCopy i a F)) := by
  rw [cubeCoordinateCopy_idempotent]

/-- The finite three-step Cauchy--Schwarz iteration in the proof of
`prop:cube_tree`. Its hypotheses are exactly the analytic cube-CS,
positivity, telescoping, and copied-remainder inputs; the conclusion is the
normalized `5D/α_i` tree bound. -/
theorem cubeTree_cs_iteration_of_hypotheses
    (α : Anisotropy) (T : FiniteConvexTree α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (i : Fin 3) (D : ℝ)
    (hD : 0 ≤ D)
    (hcs : ∀ (k : Fin 3) (G : CubeVertex → E3 → ℝ),
      |localCubeForm α T.boxes k lam r G| ^ 2 ≤
        localCubeForm α T.boxes k lam r (cubeCoordinateCopy k false G) *
          localCubeForm α T.boxes k lam r (cubeCoordinateCopy k true G))
    (hpos : ∀ (k : Fin 3) (b : Bool) (G : CubeVertex → E3 → ℝ),
      0 ≤ localCubeForm α T.boxes k lam r (cubeCoordinateCopy k b G))
    (htel : ∀ G : CubeVertex → E3 → ℝ,
      (∑ k : Fin 3, (α.weight k : ℝ) *
        localCubeForm α T.boxes k lam r G) = cubeTreeRemainder α T lam r G)
    (hrem1 : ∀ (k : Fin 3) (b : Bool),
      |cubeTreeRemainder α T lam r (cubeCoordinateCopy k b F)| ≤ D)
    (hrem2 : ∀ (k q : Fin 3) (a b : Bool), k ≠ q →
      |cubeTreeRemainder α T lam r
        (cubeCoordinateCopy q b (cubeCoordinateCopy k a F))| ≤ D)
    (hrem3 : ∀ (k q p : Fin 3) (a b c : Bool),
      k ≠ q → k ≠ p → q ≠ p →
      |cubeTreeRemainder α T lam r
        (cubeCoordinateCopy p c
          (cubeCoordinateCopy q b (cubeCoordinateCopy k a F)))| ≤ D) :
    |localCubeForm α T.boxes i lam r F| ≤
      5 * D / (α.weight i : ℝ) := by
  let θ : Fin 3 → (CubeVertex → E3 → ℝ) → ℝ :=
    fun k G ↦ localCubeForm α T.boxes k lam r G
  let R : (CubeVertex → E3 → ℝ) → ℝ :=
    fun G ↦ cubeTreeRemainder α T lam r G
  let w : Fin 3 → ℝ := fun k ↦ (α.weight k : ℝ)
  let copy : Fin 3 → Bool → (CubeVertex → E3 → ℝ) →
      (CubeVertex → E3 → ℝ) :=
    fun k b G ↦ cubeCoordinateCopy k b G
  have hw (k : Fin 3) : 0 < w k := by
    dsimp [w]
    exact_mod_cast α.weight_pos k
  have hcs' (k : Fin 3) (G : CubeVertex → E3 → ℝ) :
      |θ k G| ^ 2 ≤ θ k (copy k false G) * θ k (copy k true G) := by
    simpa [θ, copy] using hcs k G
  have hpos' (k : Fin 3) (b : Bool) (G : CubeVertex → E3 → ℝ) :
      0 ≤ θ k (copy k b G) := by
    simpa [θ, copy] using hpos k b G
  have htel' (G : CubeVertex → E3 → ℝ) :
      (∑ k : Fin 3, w k * θ k G) = R G := by
    simpa [θ, R, w] using htel G
  have hrem1' (k : Fin 3) (b : Bool) : |R (copy k b F)| ≤ D := by
    simpa [R, copy] using hrem1 k b
  have hrem2' (k q : Fin 3) (a b : Bool) (hkq : k ≠ q) :
      |R (copy q b (copy k a F))| ≤ D := by
    simpa [R, copy] using hrem2 k q a b hkq
  have hrem3' (k q p : Fin 3) (a b c : Bool)
      (hkq : k ≠ q) (hkp : k ≠ p) (hqp : q ≠ p) :
      |R (copy p c (copy q b (copy k a F)))| ≤ D := by
    simpa [R, copy] using hrem3 k q p a b c hkq hkp hqp
  have hthird (a b : Bool) (q p : Fin 3)
      (hiq : i ≠ q) (hip : i ≠ p) (hqp : q ≠ p) :
      |θ p (copy q b (copy i a F))| ≤ D / w p := by
    let G : CubeVertex → E3 → ℝ := copy q b (copy i a F)
    have hleaf (c : Bool) : θ p (copy p c G) ≤ D / w p := by
      have hfixi : copy i a (copy p c G) = copy p c G := by
        dsimp [G, copy]
        exact cubeCoordinateCopy_fixed_three_first hiq hip a b c F
      have hfixq : copy q b (copy p c G) = copy p c G := by
        dsimp [G, copy]
        exact cubeCoordinateCopy_fixed_three_second hqp a b c F
      have hfixp : copy p c (copy p c G) = copy p c G := by
        dsimp [G, copy]
        exact cubeCoordinateCopy_fixed_three_third i q p a b c F
      have hposi : 0 ≤ θ i (copy p c G) := by
        rw [← hfixi]
        exact hpos' i a (copy p c G)
      have hposq : 0 ≤ θ q (copy p c G) := by
        rw [← hfixq]
        exact hpos' q b (copy p c G)
      have hposp : 0 ≤ θ p (copy p c G) := hpos' p c G
      have hposall (k : Fin 3) : 0 ≤ θ k (copy p c G) := by
        rcases fin_three_eq_one_of_three (k := k) hiq hip hqp with hk | hk | hk
        · simpa [hk] using hposi
        · simpa [hk] using hposq
        · simpa [hk] using hposp
      have hterm (k : Fin 3) (_hk : k ∈ Finset.univ) :
          0 ≤ w k * θ k (copy p c G) :=
        mul_nonneg (hw k).le (hposall k)
      have hple : w p * θ p (copy p c G) ≤
          ∑ k : Fin 3, w k * θ k (copy p c G) :=
        Finset.single_le_sum hterm (Finset.mem_univ p)
      have hRle : R (copy p c G) ≤ D :=
        (abs_le.mp (hrem3' i q p a b c hiq hip hqp)).2
      have hwp : w p * θ p (copy p c G) ≤ D := by
        calc
          w p * θ p (copy p c G) ≤
              ∑ k : Fin 3, w k * θ k (copy p c G) := hple
          _ = R (copy p c G) := htel' _
          _ ≤ D := hRle
      apply (le_div_iff₀ (hw p)).2
      simpa [mul_comm] using hwp
    have h0 : θ p (copy p false G) ≤ D / w p := hleaf false
    have h1 : θ p (copy p true G) ≤ D / w p := hleaf true
    exact abs_le_of_sq_le_mul_of_nonneg_le
      (θ p G) (θ p (copy p false G)) (θ p (copy p true G)) (D / w p)
      (div_nonneg hD (hw p).le) (hpos' p true G) h0 h1 (hcs' p G)
  have hsecondChild (a b : Bool) (q p : Fin 3)
      (hiq : i ≠ q) (hip : i ≠ p) (hqp : q ≠ p) :
      θ q (copy q b (copy i a F)) ≤ 2 * D / w q := by
    let G : CubeVertex → E3 → ℝ := copy q b (copy i a F)
    have hfixi : copy i a G = G := by
      dsimp [G, copy]
      exact cubeCoordinateCopy_fixed_after_distinct hiq a b F
    have hposi : 0 ≤ θ i G := by
      rw [← hfixi]
      exact hpos' i a G
    have hpbound : |θ p G| ≤ D / w p := by
      simpa [G] using hthird a b q p hiq hip hqp
    have hprodabs : w p * |θ p G| ≤ D := by
      calc
        w p * |θ p G| ≤ w p * (D / w p) :=
          mul_le_mul_of_nonneg_left hpbound (hw p).le
        _ = D := mul_div_cancel₀ D (ne_of_gt (hw p))
    have htelG := htel' G
    rw [sum_fin_three_eq_of_pairwise_distinct
      (fun k ↦ w k * θ k G) hiq hip hqp] at htelG
    have hRle : R G ≤ D := (abs_le.mp (hrem2' i q a b hiq)).2
    have hRabs : R G ≤ |R G| := le_abs_self _
    have hpabs : -θ p G ≤ |θ p G| := neg_le_abs _
    have hipos : 0 ≤ w i * θ i G := mul_nonneg (hw i).le hposi
    have hwpabs : -(w p * θ p G) ≤ w p * |θ p G| := by
      calc
        -(w p * θ p G) = w p * (-θ p G) := by ring
        _ ≤ w p * |θ p G| :=
          mul_le_mul_of_nonneg_left hpabs (hw p).le
    have hqred : w q * θ q G ≤ D + w p * |θ p G| := by
      linarith
    have hqprod : w q * θ q G ≤ 2 * D := by
      nlinarith
    apply (le_div_iff₀ (hw q)).2
    simpa [mul_comm] using hqprod
  have hsecond (a : Bool) (q p : Fin 3)
      (hiq : i ≠ q) (hip : i ≠ p) (hqp : q ≠ p) :
      |θ q (copy i a F)| ≤ 2 * D / w q := by
    have h0 : θ q (copy q false (copy i a F)) ≤ 2 * D / w q :=
      hsecondChild a false q p hiq hip hqp
    have h1 : θ q (copy q true (copy i a F)) ≤ 2 * D / w q :=
      hsecondChild a true q p hiq hip hqp
    exact abs_le_of_sq_le_mul_of_nonneg_le
      (θ q (copy i a F)) (θ q (copy q false (copy i a F)))
        (θ q (copy q true (copy i a F))) (2 * D / w q)
      (div_nonneg (mul_nonneg (by norm_num) hD) (hw q).le)
      (hpos' q true (copy i a F)) h0 h1 (hcs' q (copy i a F))
  have hfirstChild (a : Bool) : θ i (copy i a F) ≤ 5 * D / w i := by
    let G : CubeVertex → E3 → ℝ := copy i a F
    have hprod (q : Fin 3) (hq : q ∈ Finset.univ.erase i) :
        w q * |θ q G| ≤ 2 * D := by
      have hiq : i ≠ q := (Finset.mem_erase.mp hq).1.symm
      obtain ⟨p, hip, hqp⟩ := exists_third_coordinate i q hiq
      have hqbound : |θ q G| ≤ 2 * D / w q := by
        simpa [G] using hsecond a q p hiq hip.symm hqp.symm
      calc
        w q * |θ q G| ≤ w q * (2 * D / w q) :=
          mul_le_mul_of_nonneg_left hqbound (hw q).le
        _ = 2 * D := mul_div_cancel₀ (2 * D) (ne_of_gt (hw q))
    have hsumabs : (∑ q ∈ Finset.univ.erase i, w q * |θ q G|) ≤ 4 * D := by
      calc
        (∑ q ∈ Finset.univ.erase i, w q * |θ q G|) ≤ 2 * (2 * D) :=
          sum_erase_fin_three_le i (fun q ↦ w q * |θ q G|) (2 * D) hprod
        _ = 4 * D := by ring
    have htermneg : -(∑ q ∈ Finset.univ.erase i, w q * θ q G) ≤
        ∑ q ∈ Finset.univ.erase i, w q * |θ q G| := by
      rw [← Finset.sum_neg_distrib]
      apply Finset.sum_le_sum
      intro q hq
      calc
        -(w q * θ q G) = w q * (-θ q G) := by ring
        _ ≤ w q * |θ q G| :=
          mul_le_mul_of_nonneg_left (neg_le_abs _) (hw q).le
    have htelG := htel' G
    rw [sum_fin_three_split_erase (fun k ↦ w k * θ k G) i] at htelG
    have hRle : R G ≤ D := (abs_le.mp (hrem1' i a)).2
    have hRabs : R G ≤ |R G| := le_abs_self _
    have hred : w i * θ i G ≤
        D + ∑ q ∈ Finset.univ.erase i, w q * |θ q G| := by
      linarith
    have hiprod : w i * θ i G ≤ 5 * D := by
      nlinarith
    apply (le_div_iff₀ (hw i)).2
    simpa [mul_comm] using hiprod
  have h0 : θ i (copy i false F) ≤ 5 * D / w i := hfirstChild false
  have h1 : θ i (copy i true F) ≤ 5 * D / w i := hfirstChild true
  have hfinal : |θ i F| ≤ 5 * D / w i :=
    abs_le_of_sq_le_mul_of_nonneg_le
      (θ i F) (θ i (copy i false F)) (θ i (copy i true F)) (5 * D / w i)
      (div_nonneg (mul_nonneg (by norm_num) hD) (hw i).le)
      (hpos' i true F) h0 h1 (hcs' i F)
  simpa [θ, w] using hfinal


/-- The local cube integrand is genuinely jointly integrable over any finite
collection of box--scale cells. This is the product-space input for the
active/passive Fubini proof of cubical Cauchy--Schwarz. -/
theorem integrable_cubeSignedInputProduct_mul_localCubeKernel_collection
    (α : Anisotropy) (S : BoxCollection α) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ)
    (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B)
    (hlam : 1 ≤ lam) :
    Integrable (fun z : (E3 × ℝ) × E6 ↦
      cubeSignedInputProduct F z.2 *
        localCubeKernel α i lam r z.1.2 z.1.1 z.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume) := by
  let g : (E3 × ℝ) × E6 → ℝ := fun z ↦
    cubeSignedInputProduct F z.2 *
      localCubeKernel α i lam r z.1.2 z.1.1 z.2
  have hcell (q : AnisoBox α) :
      Integrable g ((cubeScaleMeasure.restrict (boxScaleRegion α q)).prod volume) := by
    rw [cubeScaleMeasure_restrict_boxScaleRegion]
    exact integrable_cubeSignedInputProduct_mul_localCubeKernel_boxScaleCell
      α q i lam r F hFcont hFbound hlam
  let : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  rw [Measure.restrict_prod_eq_prod_univ]
  change IntegrableOn g ((collectionRegion α S) ×ˢ (Set.univ : Set E6))
    (cubeScaleMeasure.prod volume)
  classical
  induction S using Finset.induction_on with
  | empty => simp [collectionRegion]
  | @insert q S hq ih =>
      have hregion : collectionRegion α (insert q S) =
          boxScaleRegion α q ∪ collectionRegion α S := by
        ext z
        simp [collectionRegion]
      rw [hregion, Set.union_prod]
      apply IntegrableOn.union
      · change Integrable g ((cubeScaleMeasure.prod volume).restrict
            (boxScaleRegion α q ×ˢ (Set.univ : Set E6)))
        rw [← Measure.restrict_prod_eq_prod_univ]
        exact hcell q
      · exact ih

/-- The fourth local power is homogeneous of degree four under scalar
rescaling of one input. -/
theorem boxLocalPower_four_smul
    (α : Anisotropy) (c : ℝ) (f : E3 → ℝ) (q : AnisoBox α) :
    boxLocalPower α 4 (c • f) q = |c| ^ 4 * boxLocalPower α 4 f q := by
  unfold boxLocalPower
  let K : E3 → ℝ :=
    anisotropicBracketKernel α (boxLength q) (boxCenter α q)
  have hfun : (fun y : E3 ↦ |(c • f) y| ^ (4 : ℝ) * K y) =
      (fun y ↦ |c| ^ (4 : ℝ) * (|f y| ^ (4 : ℝ) * K y)) := by
    funext y
    simp only [Pi.smul_apply, smul_eq_mul, abs_mul, Real.mul_rpow
      (abs_nonneg c) (abs_nonneg (f y))]
    exact mul_assoc _ _ _
  calc
    (∫ y : E3, |(c • f) y| ^ (4 : ℝ) * K y) =
        ∫ y : E3, |c| ^ (4 : ℝ) * (|f y| ^ (4 : ℝ) * K y) := by
          rw [hfun]
    _ = |c| ^ (4 : ℝ) * (∫ y : E3, |f y| ^ (4 : ℝ) * K y) := by
          rw [integral_const_mul]
    _ = |c| ^ 4 * (∫ y : E3, |f y| ^ (4 : ℝ) * K y) := by
          norm_num [Real.rpow_natCast]

/-- A fourth local size is homogeneous of degree one under a nonnegative
scalar rescaling. -/
theorem boxLocalSize_four_smul_of_nonneg
    (α : Anisotropy) (c : ℝ) (hc : 0 ≤ c) (f : E3 → ℝ) (q : AnisoBox α) :
    boxLocalSize α 4 (c • f) q = c * boxLocalSize α 4 f q := by
  unfold boxLocalSize
  rw [boxLocalPower_four_smul]
  rw [abs_of_nonneg hc]
  have hpower : 0 ≤ boxLocalPower α 4 f q := by
    unfold boxLocalPower
    apply integral_nonneg
    intro y
    exact mul_nonneg (Real.rpow_nonneg (abs_nonneg (f y)) _)
      (anisotropicBracketKernel_nonneg α (boxLength_pos q).le (boxCenter α q) y)
  rw [Real.mul_rpow (pow_nonneg hc _) hpower]
  have hcroot : (c ^ 4) ^ ((4 : ℝ)⁻¹) = c := by
    exact Real.pow_rpow_inv_natCast hc (by norm_num : (4 : ℕ) ≠ 0)
  rw [hcroot]

/-- The finite supremum defining a fourth local size preserves nonnegative
scalar homogeneity. -/
theorem collectionLocalSize_four_smul_of_nonneg
    (α : Anisotropy) (S : BoxCollection α) (c : ℝ) (hc : 0 ≤ c)
    (f : E3 → ℝ) :
    collectionLocalSize α S 4 (c • f) = c * collectionLocalSize α S 4 f := by
  by_cases hS : S.Nonempty
  · rw [collectionLocalSize_eq_sup' S hS 4 (c • f),
      collectionLocalSize_eq_sup' S hS 4 f]
    rw [Finset.mul₀_sup' hc (boxLocalSize α 4 f) S hS]
    congr 1
    funext q
    exact boxLocalSize_four_smul_of_nonneg α c hc f q
  · simp [collectionLocalSize, hS]

/-- The tree fourth local size is positively homogeneous, as used to
normalize each of the eight cubical inputs. -/
theorem treeLocalSize_four_smul_of_nonneg
    {α : Anisotropy} (T : FiniteConvexTree α) (c : ℝ) (hc : 0 ≤ c)
    (f : E3 → ℝ) :
    treeLocalSize T 4 (c • f) = c * treeLocalSize T 4 f := by
  unfold treeLocalSize
  exact collectionLocalSize_four_smul_of_nonneg α T.boxes c hc f

/-- The fourth local size is homogeneous with the absolute scalar value;
the nonnegative version above is the normalization specialization. -/
theorem boxLocalSize_four_smul
    (α : Anisotropy) (c : ℝ) (f : E3 → ℝ) (q : AnisoBox α) :
    boxLocalSize α 4 (c • f) q = |c| * boxLocalSize α 4 f q := by
  unfold boxLocalSize
  rw [boxLocalPower_four_smul]
  have hpower : 0 ≤ boxLocalPower α 4 f q := by
    unfold boxLocalPower
    apply integral_nonneg
    intro y
    exact mul_nonneg (Real.rpow_nonneg (abs_nonneg (f y)) _)
      (anisotropicBracketKernel_nonneg α (boxLength_pos q).le (boxCenter α q) y)
  rw [Real.mul_rpow (pow_nonneg (abs_nonneg c) _) hpower]
  have hcroot : (|c| ^ 4) ^ ((4 : ℝ)⁻¹) = |c| := by
    exact Real.pow_rpow_inv_natCast (abs_nonneg c) (by norm_num : (4 : ℕ) ≠ 0)
  rw [hcroot]

/-- The collection fourth local size is absolutely homogeneous. -/
theorem collectionLocalSize_four_smul
    (α : Anisotropy) (S : BoxCollection α) (c : ℝ) (f : E3 → ℝ) :
    collectionLocalSize α S 4 (c • f) =
      |c| * collectionLocalSize α S 4 f := by
  by_cases hS : S.Nonempty
  · rw [collectionLocalSize_eq_sup' S hS 4 (c • f),
      collectionLocalSize_eq_sup' S hS 4 f]
    rw [Finset.mul₀_sup' (abs_nonneg c) (boxLocalSize α 4 f) S hS]
    congr 1
    funext q
    exact boxLocalSize_four_smul α c f q
  · simp [collectionLocalSize, hS]

/-- The tree fourth local size has the exact absolute homogeneity required by
the source normalization. -/
theorem treeLocalSize_four_smul
    {α : Anisotropy} (T : FiniteConvexTree α) (c : ℝ) (f : E3 → ℝ) :
    treeLocalSize T 4 (c • f) = |c| * treeLocalSize T 4 f := by
  unfold treeLocalSize
  exact collectionLocalSize_four_smul α T.boxes c f

/-- Independently rescale the eight inputs of a cube tuple. -/
def cubeInputRescale (a : CubeVertex → ℝ)
    (F : CubeVertex → E3 → ℝ) : CubeVertex → E3 → ℝ :=
  fun j ↦ a j • F j

/-- The signed cube product has the expected eight-linear scaling law. -/
theorem cubeSignedInputProduct_rescale
    (a : CubeVertex → ℝ) (F : CubeVertex → E3 → ℝ) (x : E6) :
    cubeSignedInputProduct (cubeInputRescale a F) x =
      (∏ j : CubeVertex, a j) * cubeSignedInputProduct F x := by
  unfold cubeSignedInputProduct cubeInputRescale
  simp only [Pi.smul_apply, smul_eq_mul]
  rw [Finset.prod_mul_distrib]

/-- The local cube form is eight-linear in its independently scaled inputs.
This is the homogeneity step used after normalizing all local sizes. -/
theorem localCubeForm_rescale
    (α : Anisotropy) (S : BoxCollection α) (i : Fin 3) (lam r : ℝ)
    (a : CubeVertex → ℝ) (F : CubeVertex → E3 → ℝ) :
    localCubeForm α S i lam r (cubeInputRescale a F) =
      (∏ j : CubeVertex, a j) * localCubeForm α S i lam r F := by
  let A : ℝ := ∏ j : CubeVertex, a j
  have hinner (z : E3 × ℝ) :
      (∫ x : E6, cubeSignedInputProduct (cubeInputRescale a F) x *
        localCubeKernel α i lam r z.2 z.1 x) =
        A * (∫ x : E6, cubeSignedInputProduct F x *
          localCubeKernel α i lam r z.2 z.1 x) := by
    calc
      (∫ x : E6, cubeSignedInputProduct (cubeInputRescale a F) x *
          localCubeKernel α i lam r z.2 z.1 x) =
          ∫ x : E6, A * (cubeSignedInputProduct F x *
            localCubeKernel α i lam r z.2 z.1 x) := by
              apply integral_congr_ae
              filter_upwards [] with x
              rw [cubeSignedInputProduct_rescale]
              dsimp [A]
              ring
      _ = A * (∫ x : E6, cubeSignedInputProduct F x *
          localCubeKernel α i lam r z.2 z.1 x) := by
            rw [integral_const_mul]
  unfold localCubeForm
  calc
    (∫ z : E3 × ℝ,
      (∫ x : E6, cubeSignedInputProduct (cubeInputRescale a F) x *
        localCubeKernel α i lam r z.2 z.1 x) ∂
        cubeScaleMeasure.restrict (collectionRegion α S)) =
        ∫ z : E3 × ℝ, A * (∫ x : E6, cubeSignedInputProduct F x *
          localCubeKernel α i lam r z.2 z.1 x) ∂
          cubeScaleMeasure.restrict (collectionRegion α S) := by
            apply integral_congr_ae
            filter_upwards [] with z
            exact hinner z
    _ = A * (∫ z : E3 × ℝ, (∫ x : E6, cubeSignedInputProduct F x *
          localCubeKernel α i lam r z.2 z.1 x) ∂
          cubeScaleMeasure.restrict (collectionRegion α S)) := by
            rw [integral_const_mul]
    _ = _ := by rfl

/-- The fourth local-power integrand is integrable for a bounded continuous
input, with the literal anisotropic bracket weight. -/
theorem integrable_boxLocalPower_four
    (α : Anisotropy) (q : AnisoBox α) (f : E3 → ℝ)
    (hcont : Continuous f)
    (hbound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f y| ≤ C) :
    Integrable (fun y : E3 ↦ |f y| ^ (4 : ℝ) *
      anisotropicBracketKernel α (boxLength q) (boxCenter α q) y) := by
  rcases hbound with ⟨C, hC, hbound⟩
  let K : E3 → ℝ :=
    anisotropicBracketKernel α (boxLength q) (boxCenter α q)
  have hK : Integrable K :=
    integrable_anisotropicBracketKernel α (boxLength_pos q) (boxCenter α q)
  have hmeas : AEStronglyMeasurable (fun y : E3 ↦ |f y| ^ (4 : ℝ) * K y) :=
    ((hcont.abs.rpow_const (fun _ ↦ Or.inr (by norm_num))).mul
      (continuous_anisotropicBracketKernel α (boxLength_pos q)
        (boxCenter α q))).aestronglyMeasurable
  refine (hK.const_mul (C ^ (4 : ℝ))).mono hmeas ?_
  filter_upwards [] with y
  have hpow : |f y| ^ (4 : ℝ) ≤ C ^ (4 : ℝ) :=
    Real.rpow_le_rpow (abs_nonneg _) (hbound y) (by norm_num)
  have hKnonneg : 0 ≤ K y :=
    anisotropicBracketKernel_nonneg α (boxLength_pos q).le (boxCenter α q) y
  rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg
    (Real.rpow_nonneg (abs_nonneg _) _) hKnonneg),
    Real.norm_eq_abs, abs_of_nonneg (mul_nonneg
      (Real.rpow_nonneg hC _) hKnonneg)]
  exact mul_le_mul_of_nonneg_right hpow hKnonneg

/-- A bounded continuous input which is nonzero at one point has strictly
positive fourth local size on every literal box. -/
theorem boxLocalSize_four_pos_of_continuous_nonzero
    (α : Anisotropy) (q : AnisoBox α) (f : E3 → ℝ)
    (hcont : Continuous f)
    (hbound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f y| ≤ C)
    {y : E3} (hy : f y ≠ 0) :
    0 < boxLocalSize α 4 f q := by
  let K : E3 → ℝ :=
    anisotropicBracketKernel α (boxLength q) (boxCenter α q)
  let g : E3 → ℝ := fun z ↦ |f z| ^ (4 : ℝ) * K z
  have hgcont : Continuous g :=
    (hcont.abs.rpow_const (fun _ ↦ Or.inr (by norm_num))).mul
      (continuous_anisotropicBracketKernel α (boxLength_pos q)
        (boxCenter α q))
  have hgint : Integrable g := by
    simpa [g, K] using integrable_boxLocalPower_four α q f hcont hbound
  have hgnonneg : 0 ≤ g := by
    intro z
    exact mul_nonneg (Real.rpow_nonneg (abs_nonneg (f z)) _)
      (anisotropicBracketKernel_nonneg α (boxLength_pos q).le
        (boxCenter α q) z)
  have hgpoint : g y ≠ 0 := by
    apply mul_ne_zero
    · exact (Real.rpow_pos_of_pos (abs_pos.mpr hy) _).ne'
    · exact (anisotropicBracketKernel_pos α (boxLength_pos q)
        (boxCenter α q) y).ne'
  have hpower : 0 < boxLocalPower α 4 f q := by
    change 0 < ∫ z : E3, g z
    exact integral_pos_of_integrable_nonneg_nonzero hgcont hgint hgnonneg hgpoint
  unfold boxLocalSize
  exact Real.rpow_pos_of_pos hpower _

/-- A zero fourth tree local size forces a bounded continuous input to vanish
pointwise. This supplies the zero-size branch of the source normalization. -/
theorem eq_zero_of_treeLocalSize_four_eq_zero
    {α : Anisotropy} (T : FiniteConvexTree α) (f : E3 → ℝ)
    (hcont : Continuous f)
    (hbound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f y| ≤ C)
    (hzero : treeLocalSize T 4 f = 0) : f = 0 := by
  have hrootle : boxLocalSize α 4 f T.root ≤ treeLocalSize T 4 f := by
    change boxLocalSize α 4 f T.root ≤ collectionLocalSize α T.boxes 4 f
    exact boxLocalSize_le_collectionLocalSize T.boxes T.root_mem 4 f
  have hrootnonneg : 0 ≤ boxLocalSize α 4 f T.root := by
    unfold boxLocalSize boxLocalPower
    apply Real.rpow_nonneg
    apply integral_nonneg
    intro y
    exact mul_nonneg (Real.rpow_nonneg (abs_nonneg (f y)) _)
      (anisotropicBracketKernel_nonneg α (boxLength_pos T.root).le
        (boxCenter α T.root) y)
  have hrootzero : boxLocalSize α 4 f T.root = 0 := by
    apply le_antisymm
    · simpa [hzero] using hrootle
    · exact hrootnonneg
  funext y
  by_contra hy
  exact (ne_of_gt (boxLocalSize_four_pos_of_continuous_nonzero
    α T.root f hcont hbound hy)) hrootzero

/-- Independent scalar rescaling preserves continuity of each cube input. -/
theorem cubeInputRescale_continuous
    (a : CubeVertex → ℝ) (F : CubeVertex → E3 → ℝ)
    (hcont : ∀ j, Continuous (F j)) :
    ∀ j, Continuous (cubeInputRescale a F j) := by
  intro j
  simpa [cubeInputRescale] using (hcont j).const_smul (a j)

/-- Independent scalar rescaling preserves boundedness of each cube input. -/
theorem cubeInputRescale_bounded
    (a : CubeVertex → ℝ) (F : CubeVertex → E3 → ℝ)
    (hbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C) :
    ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |cubeInputRescale a F j y| ≤ C := by
  intro j
  rcases hbound j with ⟨C, hC, hCbound⟩
  refine ⟨|a j| * C, mul_nonneg (abs_nonneg _) hC, ?_⟩
  intro y
  simp only [cubeInputRescale, Pi.smul_apply, smul_eq_mul, abs_mul]
  exact mul_le_mul_of_nonneg_left (hCbound y) (abs_nonneg _)

/-- Copying a unit-normalized cube tuple leaves every fourth tree local size
equal to one. -/
theorem cubeCoordinateCopy_preserves_treeLocalSize_one
    {α : Anisotropy} (T : FiniteConvexTree α)
    (F : CubeVertex → E3 → ℝ)
    (hunit : ∀ j, treeLocalSize T 4 (F j) = 1)
    (i : Fin 3) (b : Bool) :
    ∀ j, treeLocalSize T 4 (cubeCoordinateCopy i b F j) = 1 := by
  intro j
  simpa [cubeCoordinateCopy] using hunit (cubeVertexReplace i b j)

/-- If any one cube input is zero, the entire local cube form vanishes. -/
theorem localCubeForm_eq_zero_of_component_eq_zero
    (α : Anisotropy) (S : BoxCollection α) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (j : CubeVertex) (hj : F j = 0) :
    localCubeForm α S i lam r F = 0 := by
  have hprod (x : E6) : cubeSignedInputProduct F x = 0 := by
    unfold cubeSignedInputProduct
    apply Finset.prod_eq_zero (Finset.mem_univ j)
    simp [hj]
  unfold localCubeForm
  simp_rw [hprod]
  simp

/-- The source normalization argument for the full cube tree estimate.
It reduces arbitrary bounded continuous data to unit fourth local sizes,
using zero-size vanishing in the exceptional case and eight-linearity in the
positive-size case. -/
theorem fullCubeTreeEstimate_of_normalized
    (α : Anisotropy) (T : FiniteConvexTree α) (i : Fin 3) (lam r B : ℝ)
    (F : CubeVertex → E3 → ℝ)
    (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (hnormalized : ∀ G : CubeVertex → E3 → ℝ,
      (∀ j, Continuous (G j)) →
      (∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |G j y| ≤ C) →
      (∀ j, treeLocalSize T 4 (G j) = 1) →
      |localCubeForm α T.boxes i lam r G| ≤ B) :
    |localCubeForm α T.boxes i lam r F| ≤
      B * ∏ j : CubeVertex, treeLocalSize T 4 (F j) := by
  let m : CubeVertex → ℝ := fun j ↦ treeLocalSize T 4 (F j)
  change |localCubeForm α T.boxes i lam r F| ≤ B * ∏ j : CubeVertex, m j
  by_cases hzero : ∃ j : CubeVertex, m j = 0
  · rcases hzero with ⟨j, hj⟩
    have hFzero : F j = 0 := by
      apply eq_zero_of_treeLocalSize_four_eq_zero T (F j) (hFcont j)
        (hFbound j)
      simpa [m] using hj
    have hformzero : localCubeForm α T.boxes i lam r F = 0 :=
      localCubeForm_eq_zero_of_component_eq_zero α T.boxes i lam r F j hFzero
    have hprodzero : (∏ k : CubeVertex, m k) = 0 :=
      Finset.prod_eq_zero (Finset.mem_univ j) hj
    rw [hformzero, hprodzero]
    simp
  · have hmne (j : CubeVertex) : m j ≠ 0 := by
      intro hj
      exact hzero ⟨j, hj⟩
    have hmnonneg (j : CubeVertex) : 0 ≤ m j := by
      dsimp [m]
      exact treeLocalSize_four_nonneg T (F j)
    have hmpos (j : CubeVertex) : 0 < m j :=
      lt_of_le_of_ne (hmnonneg j) (Ne.symm (hmne j))
    let G : CubeVertex → E3 → ℝ :=
      cubeInputRescale (fun j ↦ (m j)⁻¹) F
    have hGcont : ∀ j, Continuous (G j) := by
      simpa [G] using cubeInputRescale_continuous
        (fun j ↦ (m j)⁻¹) F hFcont
    have hGbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |G j y| ≤ C := by
      simpa [G] using cubeInputRescale_bounded
        (fun j ↦ (m j)⁻¹) F hFbound
    have hGunit (j : CubeVertex) : treeLocalSize T 4 (G j) = 1 := by
      change treeLocalSize T 4 ((m j)⁻¹ • F j) = 1
      rw [treeLocalSize_four_smul_of_nonneg T (m j)⁻¹
        (inv_nonneg.mpr (hmnonneg j)) (F j)]
      exact inv_mul_cancel₀ (hmne j)
    have hGboundForm : |localCubeForm α T.boxes i lam r G| ≤ B :=
      hnormalized G hGcont hGbound hGunit
    have hrestore : cubeInputRescale m G = F := by
      funext j y
      simp only [cubeInputRescale, G, Pi.smul_apply, smul_eq_mul]
      field_simp [hmne j]
    have hscale := localCubeForm_rescale α T.boxes i lam r m G
    rw [hrestore] at hscale
    let P : ℝ := ∏ j : CubeVertex, m j
    have hPnonneg : 0 ≤ P :=
      Finset.prod_nonneg fun j _ ↦ hmnonneg j
    change |localCubeForm α T.boxes i lam r F| ≤ B * P
    change localCubeForm α T.boxes i lam r F = P *
      localCubeForm α T.boxes i lam r G at hscale
    calc
      |localCubeForm α T.boxes i lam r F| =
          |P * localCubeForm α T.boxes i lam r G| := by rw [hscale]
      _ = P * |localCubeForm α T.boxes i lam r G| := by
        rw [abs_mul, abs_of_nonneg hPnonneg]
      _ ≤ P * B := mul_le_mul_of_nonneg_left hGboundForm hPnonneg
      _ = B * P := by ring


/-- The signed real Cauchy--Schwarz estimate in squared form. This is the
analytic inequality used after the active-coordinate Fubini factorization in
the cubical Cauchy--Schwarz argument. -/
theorem abs_integral_mul_sq_le_integral_sq_mul
    {X : Type*} [MeasurableSpace X] (μ : Measure X) (f g : X → ℝ)
    (hfmeas : AEStronglyMeasurable f μ) (hgmeas : AEStronglyMeasurable g μ)
    (hfsq : Integrable (fun x ↦ f x ^ 2) μ)
    (hgsq : Integrable (fun x ↦ g x ^ 2) μ) :
    |∫ x, f x * g x ∂μ| ^ 2 ≤
      (∫ x, f x ^ 2 ∂μ) * ∫ x, g x ^ 2 ∂μ := by
  have hfsqabs : Integrable (fun x ↦ |f x| ^ 2) μ := by
    simpa only [sq_abs] using hfsq
  have hgsqabs : Integrable (fun x ↦ |g x| ^ 2) μ := by
    simpa only [sq_abs] using hgsq
  have hcs := integral_mul_le_sqrt_integral_sq μ (fun x ↦ |f x|)
    (fun x ↦ |g x|) hfmeas.norm hgmeas.norm
    (Filter.Eventually.of_forall fun x ↦ abs_nonneg (f x))
    (Filter.Eventually.of_forall fun x ↦ abs_nonneg (g x)) hfsqabs hgsqabs
  have habs : |∫ x, f x * g x ∂μ| ≤ ∫ x, |f x| * |g x| ∂μ := by
    calc
      |∫ x, f x * g x ∂μ| ≤ ∫ x, |f x * g x| ∂μ :=
        MeasureTheory.abs_integral_le_integral_abs
      _ = ∫ x, |f x| * |g x| ∂μ := by
        apply integral_congr_ae
        filter_upwards [] with x
        rw [abs_mul]
  have hbound : |∫ x, f x * g x ∂μ| ≤
      √(∫ x, f x ^ 2 ∂μ) * √(∫ x, g x ^ 2 ∂μ) := by
    simpa only [sq_abs] using habs.trans hcs
  have hfnonneg : 0 ≤ ∫ x, f x ^ 2 ∂μ :=
    integral_nonneg fun x ↦ sq_nonneg (f x)
  have hgnonneg : 0 ≤ ∫ x, g x ^ 2 ∂μ :=
    integral_nonneg fun x ↦ sq_nonneg (g x)
  have hright : 0 ≤ √(∫ x, f x ^ 2 ∂μ) * √(∫ x, g x ^ 2 ∂μ) :=
    mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
  calc
    |∫ x, f x * g x ∂μ| ^ 2 ≤
        (√(∫ x, f x ^ 2 ∂μ) * √(∫ x, g x ^ 2 ∂μ)) ^ 2 :=
      (sq_le_sq₀ (abs_nonneg _) hright).2 hbound
    _ = (∫ x, f x ^ 2 ∂μ) * ∫ x, g x ^ 2 ∂μ := by
      rw [mul_pow, Real.sq_sqrt hfnonneg, Real.sq_sqrt hgnonneg]

/-- Coordinate copying preserves the continuity hypothesis on a cubical input
tuple. -/
theorem continuous_cubeCoordinateCopy
    (i : Fin 3) (b : Bool) (F : CubeVertex → E3 → ℝ)
    (hF : ∀ j, Continuous (F j)) :
    ∀ j, Continuous (cubeCoordinateCopy i b F j) := by
  intro j
  exact hF (cubeVertexReplace i b j)

/-- Coordinate copying preserves the boundedness hypothesis used for the
local cubical forms. -/
theorem bounded_cubeCoordinateCopy
    (i : Fin 3) (b : Bool) (F : CubeVertex → E3 → ℝ)
    (hF : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C) :
    ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |cubeCoordinateCopy i b F j y| ≤ C := by
  intro j
  exact hF (cubeVertexReplace i b j)

/-- The source cubical Cauchy--Schwarz conclusion, once Fubini has split the
two active variables and identified the two square integrals with coordinate
copies. The subsequent local-coordinate argument supplies the three displayed
factorization equalities. -/
theorem localCubeForm_cauchySchwarz_of_fubini
    (α : Anisotropy) (S : BoxCollection α) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) {X : Type*} [MeasurableSpace X]
    (μ : Measure X) (A0 A1 : X → ℝ)
    (hform : localCubeForm α S i lam r F = ∫ x, A0 x * A1 x ∂μ)
    (hcopy0 : localCubeForm α S i lam r (cubeCoordinateCopy i false F) =
      ∫ x, A0 x ^ 2 ∂μ)
    (hcopy1 : localCubeForm α S i lam r (cubeCoordinateCopy i true F) =
      ∫ x, A1 x ^ 2 ∂μ)
    (hA0meas : AEStronglyMeasurable A0 μ)
    (hA1meas : AEStronglyMeasurable A1 μ)
    (hA0sq : Integrable (fun x ↦ A0 x ^ 2) μ)
    (hA1sq : Integrable (fun x ↦ A1 x ^ 2) μ) :
    |localCubeForm α S i lam r F| ^ 2 ≤
      localCubeForm α S i lam r (cubeCoordinateCopy i false F) *
        localCubeForm α S i lam r (cubeCoordinateCopy i true F) := by
  calc
    |localCubeForm α S i lam r F| ^ 2 = |∫ x, A0 x * A1 x ∂μ| ^ 2 := by
      rw [hform]
    _ ≤ (∫ x, A0 x ^ 2 ∂μ) * ∫ x, A1 x ^ 2 ∂μ :=
      abs_integral_mul_sq_le_integral_sq_mul μ A0 A1 hA0meas hA1meas hA0sq hA1sq
    _ = localCubeForm α S i lam r (cubeCoordinateCopy i false F) *
        localCubeForm α S i lam r (cubeCoordinateCopy i true F) := by
      rw [← hcopy0, ← hcopy1]

/-- The positivity half of the cubical Cauchy--Schwarz lemma after the
Fubini/reindexing identification of a copied form with a square integral. -/
theorem localCubeForm_coordinateCopy_nonneg_of_fubini
    (α : Anisotropy) (S : BoxCollection α) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) {X : Type*} [MeasurableSpace X]
    (μ : Measure X) (b : Bool) (A : X → ℝ)
    (hcopy : localCubeForm α S i lam r (cubeCoordinateCopy i b F) =
      ∫ x, A x ^ 2 ∂μ) :
    0 ≤ localCubeForm α S i lam r (cubeCoordinateCopy i b F) := by
  rw [hcopy]
  exact integral_nonneg fun x ↦ sq_nonneg (A x)

/-- The established bounded-continuous local-integrability package applies
unchanged to either coordinate copy. This is the analytic input needed to
derive the three Fubini factorization identities in the next step. -/
theorem integrableOn_localCube_outer_collectionRegion_coordinateCopy
    (α : Anisotropy) (S : BoxCollection α) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (b : Bool)
    (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (hlam : 1 ≤ lam) :
    IntegrableOn (fun z : E3 × ℝ ↦
      ∫ x : E6, cubeSignedInputProduct (cubeCoordinateCopy i b F) x *
        localCubeKernel α i lam r z.2 z.1 x)
      (collectionRegion α S) cubeScaleMeasure := by
  exact integrableOn_localCube_outer_collectionRegion α S i lam r
    (cubeCoordinateCopy i b F) (continuous_cubeCoordinateCopy i b F hFcont)
    (bounded_cubeCoordinateCopy i b F hFbound) hlam

/-! ### Active/passive coordinate bookkeeping

The next declarations isolate the measure-preserving permutation underlying
the Fubini part of the source proof. They are kept in the scratch file while
the corresponding local-form factorization is developed. -/

/-- Reorder two active/transverse pairs so that the two active real variables
come first and the two transverse variables second. -/
noncomputable def activePassiveShuffle (Y : Type*) [MeasurableSpace Y] :
    ((ℝ × Y) × (ℝ × Y)) ≃ᵐ (ℝ × ℝ) × (Y × Y) :=
  ((MeasurableEquiv.prodAssoc :
    ((ℝ × Y) × (ℝ × Y)) ≃ᵐ (ℝ × (Y × (ℝ × Y)))).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
      (((MeasurableEquiv.prodAssoc.symm :
        (Y × (ℝ × Y)) ≃ᵐ ((Y × ℝ) × Y)).trans
        (MeasurableEquiv.prodCongr
          (MeasurableEquiv.prodComm : (Y × ℝ) ≃ᵐ (ℝ × Y))
          (MeasurableEquiv.refl Y))).trans
        (MeasurableEquiv.prodAssoc :
          ((ℝ × Y) × Y) ≃ᵐ (ℝ × (Y × Y)))))).trans
    (MeasurableEquiv.prodAssoc.symm :
      (ℝ × (ℝ × (Y × Y))) ≃ᵐ ((ℝ × ℝ) × (Y × Y)))

theorem activePassiveShuffle_apply (Y : Type*) [MeasurableSpace Y]
    (v0 v1 : ℝ) (y0 y1 : Y) :
    activePassiveShuffle Y ((v0, y0), (v1, y1)) = ((v0, v1), (y0, y1)) := by
  simp [activePassiveShuffle, MeasurableEquiv.prodAssoc,
    MeasurableEquiv.prodComm, MeasurableEquiv.prodCongr]

/-- The active/passive reordering preserves the iterated product measure. -/
theorem activePassiveShuffle_measurePreserving
    (Y : Type*) [MeasurableSpace Y] (ν : Measure Y) [SFinite ν] :
    MeasurePreserving (activePassiveShuffle Y)
      (((volume : Measure ℝ).prod ν).prod ((volume : Measure ℝ).prod ν))
      (((volume : Measure ℝ).prod (volume : Measure ℝ)).prod (ν.prod ν)) := by
  let h₁ : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        ((ℝ × Y) × (ℝ × Y)) ≃ᵐ (ℝ × (Y × (ℝ × Y))))
      (((volume : Measure ℝ).prod ν).prod ((volume : Measure ℝ).prod ν))
      ((volume : Measure ℝ).prod (ν.prod ((volume : Measure ℝ).prod ν))) :=
    measurePreserving_prodAssoc volume ν (volume.prod ν)
  let h₂a : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        (Y × (ℝ × Y)) ≃ᵐ ((Y × ℝ) × Y))
      (ν.prod ((volume : Measure ℝ).prod ν))
      ((ν.prod (volume : Measure ℝ)).prod ν) :=
    (measurePreserving_prodAssoc ν volume ν).symm
  let h₂b : MeasurePreserving
      (MeasurableEquiv.prodCongr
        (MeasurableEquiv.prodComm : (Y × ℝ) ≃ᵐ (ℝ × Y))
        (MeasurableEquiv.refl Y))
      ((ν.prod (volume : Measure ℝ)).prod ν)
      (((volume : Measure ℝ).prod ν).prod ν) :=
    (Measure.measurePreserving_swap : MeasurePreserving Prod.swap
      (ν.prod (volume : Measure ℝ)) ((volume : Measure ℝ).prod ν)).prod
      (MeasurePreserving.id ν)
  let h₂c : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        ((ℝ × Y) × Y) ≃ᵐ (ℝ × (Y × Y)))
      (((volume : Measure ℝ).prod ν).prod ν)
      ((volume : Measure ℝ).prod (ν.prod ν)) :=
    measurePreserving_prodAssoc volume ν ν
  let h₂ : MeasurePreserving
      (((MeasurableEquiv.prodAssoc.symm :
        (Y × (ℝ × Y)) ≃ᵐ ((Y × ℝ) × Y)).trans
        (MeasurableEquiv.prodCongr
          (MeasurableEquiv.prodComm : (Y × ℝ) ≃ᵐ (ℝ × Y))
          (MeasurableEquiv.refl Y))).trans
        (MeasurableEquiv.prodAssoc :
          ((ℝ × Y) × Y) ≃ᵐ (ℝ × (Y × Y))))
      (ν.prod ((volume : Measure ℝ).prod ν))
      ((volume : Measure ℝ).prod (ν.prod ν)) :=
    (h₂a.trans h₂b).trans h₂c
  let h₃ : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        (ℝ × (ℝ × (Y × Y))) ≃ᵐ ((ℝ × ℝ) × (Y × Y)))
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod (ν.prod ν)))
      (((volume : Measure ℝ).prod (volume : Measure ℝ)).prod (ν.prod ν)) :=
    (measurePreserving_prodAssoc volume volume (ν.prod ν)).symm
  simpa only [activePassiveShuffle] using
    (h₁.trans ((MeasurePreserving.id (volume : Measure ℝ)).prod h₂)).trans h₃

/-- Split the six cube coordinates into the two active scalars and the four
passive transverse coordinates for a fixed active direction. -/
noncomputable def cubeActivePassiveSplit (i : Fin 3) :
    E6 ≃ᵐ (ℝ × ℝ) × (TransverseSpace i × TransverseSpace i) :=
  ((cubeFalseTrueSplit.trans
    (MeasurableEquiv.prodCongr (coordinateSplitEquiv i)
      (coordinateSplitEquiv i))).trans
    (activePassiveShuffle (TransverseSpace i)))

theorem cubeActivePassiveSplit_apply (i : Fin 3) (x : E6) :
    cubeActivePassiveSplit i x =
      ((x (i, false), x (i, true)),
        ((coordinateSplit i (cubeProjection (fun _ ↦ false) x)).2,
          (coordinateSplit i (cubeProjection (fun _ ↦ true) x)).2)) := by
  simp only [cubeActivePassiveSplit, MeasurableEquiv.trans_apply,
    MeasurableEquiv.prodCongr, cubeFalseTrueSplit_apply]
  exact activePassiveShuffle_apply (TransverseSpace i)
    (x (i, false)) (x (i, true))
    (coordinateSplit i (cubeProjection (fun _ ↦ false) x)).2
    (coordinateSplit i (cubeProjection (fun _ ↦ true) x)).2

/-- The active/passive split is measure preserving for literal Lebesgue
measure on all six cube coordinates. -/
theorem cubeActivePassiveSplit_measurePreserving (i : Fin 3) :
    MeasurePreserving (cubeActivePassiveSplit i) volume
      (((volume : Measure ℝ).prod (volume : Measure ℝ)).prod
        ((volume : Measure (TransverseSpace i)).prod
          (volume : Measure (TransverseSpace i)))) := by
  have h₀ := cubeFalseTrueSplit_measurePreserving
  have h₁ := (coordinateSplitEquiv_measurePreserving i).prod
    (coordinateSplitEquiv_measurePreserving i)
  have h₂ := activePassiveShuffle_measurePreserving (TransverseSpace i)
    (volume : Measure (TransverseSpace i))
  simpa only [cubeActivePassiveSplit, Measure.volume_eq_prod] using
    (h₀.trans h₁).trans h₂

/-- The false active coordinate of the inverse active/passive split. -/
theorem cubeActivePassiveSplit_symm_active_false (i : Fin 3)
    (u : (ℝ × ℝ) × (TransverseSpace i × TransverseSpace i)) :
    ((cubeActivePassiveSplit i).symm u) (i, false) = u.1.1 := by
  have h := cubeActivePassiveSplit_apply i ((cubeActivePassiveSplit i).symm u)
  rw [MeasurableEquiv.apply_symm_apply] at h
  have h' := congrArg (fun w : (ℝ × ℝ) ×
      (TransverseSpace i × TransverseSpace i) ↦ w.1.1) h
  exact h'.symm

/-- The true active coordinate of the inverse active/passive split. -/
theorem cubeActivePassiveSplit_symm_active_true (i : Fin 3)
    (u : (ℝ × ℝ) × (TransverseSpace i × TransverseSpace i)) :
    ((cubeActivePassiveSplit i).symm u) (i, true) = u.1.2 := by
  have h := cubeActivePassiveSplit_apply i ((cubeActivePassiveSplit i).symm u)
  rw [MeasurableEquiv.apply_symm_apply] at h
  have h' := congrArg (fun w : (ℝ × ℝ) ×
      (TransverseSpace i × TransverseSpace i) ↦ w.1.2) h
  exact h'.symm

/-- A passive cube coordinate of the inverse split is selected from the
corresponding false/true transverse component. -/
theorem cubeActivePassiveSplit_symm_passive
    (i m : Fin 3) (hmi : m ≠ i) (b : Bool)
    (u : (ℝ × ℝ) × (TransverseSpace i × TransverseSpace i)) :
    ((cubeActivePassiveSplit i).symm u) (m, b) =
      if b then u.2.2 ⟨m, hmi⟩ else u.2.1 ⟨m, hmi⟩ := by
  have h := cubeActivePassiveSplit_apply i ((cubeActivePassiveSplit i).symm u)
  rw [MeasurableEquiv.apply_symm_apply] at h
  cases b
  · have h' := congrArg (fun w : (ℝ × ℝ) ×
        (TransverseSpace i × TransverseSpace i) ↦ w.2.1 ⟨m, hmi⟩) h
    simpa [coordinateSplit, cubeProjection] using h'.symm
  · have h' := congrArg (fun w : (ℝ × ℝ) ×
        (TransverseSpace i × TransverseSpace i) ↦ w.2.2 ⟨m, hmi⟩) h
    simpa [coordinateSplit, cubeProjection] using h'.symm

/-- The transverse point selected by a cube vertex from the two passive
coordinate copies. -/
noncomputable def cubePassiveProjection (i : Fin 3) (j : CubeVertex)
    (y : TransverseSpace i × TransverseSpace i) : TransverseSpace i :=
  WithLp.toLp 2 fun m ↦ if j m.1 then y.2 m else y.1 m

@[simp]
theorem cubePassiveProjection_apply (i : Fin 3) (j : CubeVertex)
    (y : TransverseSpace i × TransverseSpace i) (m : {q : Fin 3 // q ≠ i}) :
    cubePassiveProjection i j y m = if j m.1 then y.2 m else y.1 m := by
  simp [cubePassiveProjection]

/-- The vertex projection after reassembling active/passive coordinates is
the literal source projection: the active scalar is selected by `j i` and
each passive scalar by the remaining vertex bits. -/
theorem cubeProjection_cubeActivePassiveSplit_symm
    (i : Fin 3) (j : CubeVertex) (v0 v1 : ℝ)
    (y : TransverseSpace i × TransverseSpace i) :
    cubeProjection j ((cubeActivePassiveSplit i).symm ((v0, v1), y)) =
      faceInsert i (if j i then v1 else v0) (cubePassiveProjection i j y) := by
  ext m
  by_cases hmi : m = i
  · subst m
    rw [cubeProjection_apply, faceInsert_apply]
    cases hji : j i
    · simpa [hji] using cubeActivePassiveSplit_symm_active_false i ((v0, v1), y)
    · simpa [hji] using cubeActivePassiveSplit_symm_active_true i ((v0, v1), y)
  · rw [cubeProjection_apply]
    simp only [faceInsert_apply, dite_eq_right hmi, cubePassiveProjection_apply]
    simpa using cubeActivePassiveSplit_symm_passive i m hmi (j m) ((v0, v1), y)

/-- The four passive Gaussian factors in a local cube kernel, expressed in
the two transverse coordinate copies. -/
noncomputable def cubePassiveGaussianKernel (α : Anisotropy) (i : Fin 3)
    (lam r t : ℝ) (p : E3) (y : TransverseSpace i × TransverseSpace i) : ℝ :=
  ∏ m : Fin 3, if hmi : m = i then 1 else
    cubeGaussianKernel α lam r t p m (y.1 ⟨m, hmi⟩) *
      cubeGaussianKernel α lam r t p m (y.2 ⟨m, hmi⟩)

/-- After the active/passive split, a local kernel is the product of its two
active derivative factors and its passive Gaussian weight. -/
theorem localCubeKernel_cubeActivePassiveSplit_symm
    (α : Anisotropy) (i : Fin 3) (lam r t : ℝ) (p : E3)
    (v0 v1 : ℝ) (y : TransverseSpace i × TransverseSpace i) :
    localCubeKernel α i lam r t p
      ((cubeActivePassiveSplit i).symm ((v0, v1), y)) =
      cubeGaussianDerivKernel α lam r t p i v0 *
        cubeGaussianDerivKernel α lam r t p i v1 *
          cubePassiveGaussianKernel α i lam r t p y := by
  classical
  let u : (ℝ × ℝ) × (TransverseSpace i × TransverseSpace i) := ((v0, v1), y)
  rw [localCubeKernel_eq_coordinateP_mul]
  have hactive0 : ((cubeActivePassiveSplit i).symm u) (i, false) = v0 := by
    exact cubeActivePassiveSplit_symm_active_false i u
  have hactive1 : ((cubeActivePassiveSplit i).symm u) (i, true) = v1 := by
    exact cubeActivePassiveSplit_symm_active_true i u
  have hpassive :
      (∏ m ∈ Finset.univ.erase i,
        cubeGaussianKernel α lam r t p m
            (((cubeActivePassiveSplit i).symm u) (m, false)) *
          cubeGaussianKernel α lam r t p m
            (((cubeActivePassiveSplit i).symm u) (m, true))) =
        cubePassiveGaussianKernel α i lam r t p y := by
    let f : Fin 3 → ℝ := fun m ↦ if hmi : m = i then 1 else
      cubeGaussianKernel α lam r t p m (y.1 ⟨m, hmi⟩) *
        cubeGaussianKernel α lam r t p m (y.2 ⟨m, hmi⟩)
    calc
      (∏ m ∈ Finset.univ.erase i,
        cubeGaussianKernel α lam r t p m
            (((cubeActivePassiveSplit i).symm u) (m, false)) *
          cubeGaussianKernel α lam r t p m
            (((cubeActivePassiveSplit i).symm u) (m, true))) =
          ∏ m ∈ Finset.univ.erase i, f m := by
        apply Finset.prod_congr rfl
        intro m hm
        have hmi : m ≠ i := (Finset.mem_erase.mp hm).1
        rw [cubeActivePassiveSplit_symm_passive i m hmi false u,
          cubeActivePassiveSplit_symm_passive i m hmi true u]
        simp [u, f, hmi]
      _ = f i * ∏ m ∈ Finset.univ.erase i, f m := by
        simp [f]
      _ = ∏ m : Fin 3, f m :=
        Finset.mul_prod_erase Finset.univ f (Finset.mem_univ i)
      _ = cubePassiveGaussianKernel α i lam r t p y := by
        simp only [f, cubePassiveGaussianKernel]
  change
    (cubeGaussianDerivKernel α lam r t p i
      (((cubeActivePassiveSplit i).symm u) (i, false)) *
      cubeGaussianDerivKernel α lam r t p i
        (((cubeActivePassiveSplit i).symm u) (i, true))) *
      (∏ m ∈ Finset.univ.erase i,
        cubeGaussianKernel α lam r t p m
            (((cubeActivePassiveSplit i).symm u) (m, false)) *
          cubeGaussianKernel α lam r t p m
            (((cubeActivePassiveSplit i).symm u) (m, true))) = _
  rw [hactive0, hactive1, hpassive]

/-- The four input factors on one active-coordinate half of the cube. -/
noncomputable def cubeActiveInputSlice (i : Fin 3) (b : Bool)
    (F : CubeVertex → E3 → ℝ)
    (y : TransverseSpace i × TransverseSpace i) (v : ℝ) : ℝ :=
  ∏ j : {j : CubeVertex // j i = b},
    F j.1 (faceInsert i v (cubePassiveProjection i j.1 y))

/-- Selecting the two transverse copies according to a cube vertex is
continuous. -/
theorem continuous_cubePassiveProjection (i : Fin 3) (j : CubeVertex) :
    Continuous (cubePassiveProjection i j) := by
  unfold cubePassiveProjection
  apply (PiLp.continuous_toLp 2 _).comp
  rw [continuous_pi_iff]
  intro m
  by_cases hj : j m.1
  · simp only [hj, ↓reduceIte]
    simpa only [Function.comp_def] using
      (PiLp.continuous_apply (p := 2)
        (β := fun _ : {q : Fin 3 // q ≠ i} ↦ ℝ) m).comp
        (continuous_snd : Continuous fun z :
          TransverseSpace i × TransverseSpace i ↦ z.2)
  · simp only [hj, Bool.false_eq_true, ↓reduceIte]
    simpa only [Function.comp_def] using
      (PiLp.continuous_apply (p := 2)
        (β := fun _ : {q : Fin 3 // q ≠ i} ↦ ℝ) m).comp
        (continuous_fst : Continuous fun z :
          TransverseSpace i × TransverseSpace i ↦ z.1)

/-- Bounded-continuous source inputs make each active fourfold input slice
continuous in its passive point and active scalar. -/
theorem continuous_cubeActiveInputSlice
    (i : Fin 3) (b : Bool) (F : CubeVertex → E3 → ℝ)
    (hF : ∀ j, Continuous (F j)) :
    Continuous (fun yv : (TransverseSpace i × TransverseSpace i) × ℝ ↦
      cubeActiveInputSlice i b F yv.1 yv.2) := by
  unfold cubeActiveInputSlice
  apply continuous_finsetProd Finset.univ
  intro j hj
  apply (hF j.1).comp
  exact (coordinateJoin_continuous i).comp
    (Continuous.prodMk
      (continuous_snd : Continuous fun yv :
        (TransverseSpace i × TransverseSpace i) × ℝ ↦ yv.2)
      ((continuous_cubePassiveProjection i j.1).comp
        (continuous_fst : Continuous fun yv :
          (TransverseSpace i × TransverseSpace i) × ℝ ↦ yv.1)))

/-- Under the active/passive split, the original eight-fold cube input
product is the product of its two four-fold active slices. -/
theorem cubeSignedInputProduct_cubeActivePassiveSplit_symm
    (i : Fin 3) (F : CubeVertex → E3 → ℝ) (v0 v1 : ℝ)
    (y : TransverseSpace i × TransverseSpace i) :
    cubeSignedInputProduct F ((cubeActivePassiveSplit i).symm ((v0, v1), y)) =
      cubeActiveInputSlice i false F y v0 *
        cubeActiveInputSlice i true F y v1 := by
  classical
  let x : E6 := (cubeActivePassiveSplit i).symm ((v0, v1), y)
  let f : CubeVertex → ℝ := fun j ↦ F j (cubeProjection j x)
  have hslice (b : Bool) :
      (∏ j : {j : CubeVertex // j i = b}, f j) =
        cubeActiveInputSlice i b F y (if b then v1 else v0) := by
    unfold cubeActiveInputSlice
    apply Finset.prod_congr rfl
    intro j hj
    change F j.1 (cubeProjection j.1 x) = _
    change F j.1 (cubeProjection j.1
      ((cubeActivePassiveSplit i).symm ((v0, v1), y))) = _
    rw [cubeProjection_cubeActivePassiveSplit_symm]
    cases b <;> simp [j.2]
  change (∏ j : CubeVertex, f j) = _
  calc
    (∏ j : CubeVertex, f j) =
        ∏ b : Bool, ∏ j : {j : CubeVertex // j i = b}, f j :=
      (Fintype.prod_fiberwise (fun j : CubeVertex ↦ j i) f).symm
    _ = cubeActiveInputSlice i false F y v0 *
        cubeActiveInputSlice i true F y v1 := by
      simp_rw [Fintype.prod_bool, hslice]
      simp [mul_comm]

/-- Replacing the active bit is a bijection between the two corresponding
four-vertex slices of the cube. -/
def cubeVertexReplaceSliceEquiv (i : Fin 3) (a b : Bool) :
    {j : CubeVertex // j i = a} ≃ {j : CubeVertex // j i = b} where
  toFun := fun j ↦ ⟨cubeVertexReplace i b j.1, by
    simp [cubeVertexReplace]⟩
  invFun := fun j ↦ ⟨cubeVertexReplace i a j.1, by
    simp [cubeVertexReplace]⟩
  left_inv := by
    rintro ⟨j, hj⟩
    apply Subtype.ext
    funext m
    by_cases hmi : m = i
    · subst m
      simp [cubeVertexReplace, hj]
    · simp [cubeVertexReplace, hmi]
  right_inv := by
    rintro ⟨j, hj⟩
    apply Subtype.ext
    funext m
    by_cases hmi : m = i
    · subst m
      simp [cubeVertexReplace, hj]
    · simp [cubeVertexReplace, hmi]

/-- Active-bit replacement leaves the passive vertex projection unchanged. -/
theorem cubePassiveProjection_vertexReplace
    (i : Fin 3) (a : Bool) (j : CubeVertex)
    (y : TransverseSpace i × TransverseSpace i) :
    cubePassiveProjection i (cubeVertexReplace i a j) y =
      cubePassiveProjection i j y := by
  ext m
  simp [cubePassiveProjection, cubeVertexReplace, m.2]

/-- A coordinate copy turns either active slice into the same source slice. -/
theorem cubeActiveInputSlice_coordinateCopy
    (i : Fin 3) (a b : Bool) (F : CubeVertex → E3 → ℝ)
    (y : TransverseSpace i × TransverseSpace i) (v : ℝ) :
    cubeActiveInputSlice i a (cubeCoordinateCopy i b F) y v =
      cubeActiveInputSlice i b F y v := by
  classical
  unfold cubeActiveInputSlice cubeCoordinateCopy
  let e := cubeVertexReplaceSliceEquiv i a b
  calc
    (∏ j : {j : CubeVertex // j i = a},
      F (cubeVertexReplace i b j.1)
        (faceInsert i v (cubePassiveProjection i j.1 y))) =
        ∏ j : {j : CubeVertex // j i = a},
          F (e j).1 (faceInsert i v (cubePassiveProjection i (e j).1 y)) := by
      apply Finset.prod_congr rfl
      intro j hj
      dsimp [e, cubeVertexReplaceSliceEquiv]
      rw [cubePassiveProjection_vertexReplace]
    _ = ∏ j : {j : CubeVertex // j i = b},
        F j.1 (faceInsert i v (cubePassiveProjection i j.1 y)) :=
      Equiv.prod_comp e (fun j ↦
        F j.1 (faceInsert i v (cubePassiveProjection i j.1 y)))

/-- The copied cube input product is the product of two identical source
active slices, one evaluated at each active scalar. -/
theorem cubeSignedInputProduct_coordinateCopy_cubeActivePassiveSplit_symm
    (i : Fin 3) (b : Bool) (F : CubeVertex → E3 → ℝ) (v0 v1 : ℝ)
    (y : TransverseSpace i × TransverseSpace i) :
    cubeSignedInputProduct (cubeCoordinateCopy i b F)
      ((cubeActivePassiveSplit i).symm ((v0, v1), y)) =
      cubeActiveInputSlice i b F y v0 * cubeActiveInputSlice i b F y v1 := by
  calc
    cubeSignedInputProduct (cubeCoordinateCopy i b F)
        ((cubeActivePassiveSplit i).symm ((v0, v1), y)) =
        cubeActiveInputSlice i false (cubeCoordinateCopy i b F) y v0 *
          cubeActiveInputSlice i true (cubeCoordinateCopy i b F) y v1 :=
      cubeSignedInputProduct_cubeActivePassiveSplit_symm i
        (cubeCoordinateCopy i b F) v0 v1 y
    _ = cubeActiveInputSlice i b F y v0 * cubeActiveInputSlice i b F y v1 := by
      rw [cubeActiveInputSlice_coordinateCopy i false b F y v0,
        cubeActiveInputSlice_coordinateCopy i true b F y v1]

/-- Move an outer parameter and a passive variable ahead of an active
variable block. This is the last permutation needed before Fubini integrates
the two active scalars. -/
noncomputable def centerActivePassiveShuffle
    (Z V Y : Type*) [MeasurableSpace Z] [MeasurableSpace V] [MeasurableSpace Y] :
    Z × (V × Y) ≃ᵐ (Z × Y) × V :=
  ((((MeasurableEquiv.prodAssoc.symm :
      (Z × (V × Y)) ≃ᵐ ((Z × V) × Y)).trans
      (MeasurableEquiv.prodCongr
        (MeasurableEquiv.prodComm : (Z × V) ≃ᵐ (V × Z))
        (MeasurableEquiv.refl Y))).trans
      (MeasurableEquiv.prodAssoc :
        ((V × Z) × Y) ≃ᵐ (V × (Z × Y)))).trans
      (MeasurableEquiv.prodComm :
        (V × (Z × Y)) ≃ᵐ ((Z × Y) × V)))

/-- The center/passive/active reordering preserves its iterated product
measure. -/
theorem centerActivePassiveShuffle_measurePreserving
    (Z V Y : Type*) [MeasurableSpace Z] [MeasurableSpace V] [MeasurableSpace Y]
    (μz : Measure Z) (μv : Measure V) (μy : Measure Y)
    [SFinite μz] [SFinite μv] [SFinite μy] :
    MeasurePreserving (centerActivePassiveShuffle Z V Y)
      (μz.prod (μv.prod μy)) ((μz.prod μy).prod μv) := by
  let h₁ : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        (Z × (V × Y)) ≃ᵐ ((Z × V) × Y))
      (μz.prod (μv.prod μy)) ((μz.prod μv).prod μy) :=
    (measurePreserving_prodAssoc μz μv μy).symm
  let h₂ : MeasurePreserving
      (MeasurableEquiv.prodCongr
        (MeasurableEquiv.prodComm : (Z × V) ≃ᵐ (V × Z))
        (MeasurableEquiv.refl Y))
      ((μz.prod μv).prod μy) ((μv.prod μz).prod μy) :=
    (Measure.measurePreserving_swap : MeasurePreserving Prod.swap
      (μz.prod μv) (μv.prod μz)).prod (MeasurePreserving.id μy)
  let h₃ : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        ((V × Z) × Y) ≃ᵐ (V × (Z × Y)))
      ((μv.prod μz).prod μy) (μv.prod (μz.prod μy)) :=
    measurePreserving_prodAssoc μv μz μy
  let h₄ : MeasurePreserving
      (MeasurableEquiv.prodComm :
        (V × (Z × Y)) ≃ᵐ ((Z × Y) × V))
      (μv.prod (μz.prod μy)) ((μz.prod μy).prod μv) :=
    Measure.measurePreserving_swap
  simpa only [centerActivePassiveShuffle] using ((h₁.trans h₂).trans h₃).trans h₄

/-- The joint change of variables used by cubical Cauchy--Schwarz: center and
scale, then four passive coordinates, then the two active coordinates. -/
noncomputable def cubeCenterActivePassiveSplit (i : Fin 3) :
    (E3 × ℝ) × E6 ≃ᵐ
      ((E3 × ℝ) × (TransverseSpace i × TransverseSpace i)) × (ℝ × ℝ) :=
  ((MeasurableEquiv.prodCongr (MeasurableEquiv.refl (E3 × ℝ))
    (cubeActivePassiveSplit i)).trans
    (centerActivePassiveShuffle (E3 × ℝ) (ℝ × ℝ)
      (TransverseSpace i × TransverseSpace i)))

/-- The joint cube splitting preserves center--scale measure times spatial
Lebesgue measure, with passive parameters first. -/
theorem cubeCenterActivePassiveSplit_measurePreserving
    (i : Fin 3) (μz : Measure (E3 × ℝ)) [SFinite μz] :
    MeasurePreserving (cubeCenterActivePassiveSplit i) (μz.prod volume)
      ((μz.prod ((volume : Measure (TransverseSpace i)).prod
          (volume : Measure (TransverseSpace i)))).prod
        ((volume : Measure ℝ).prod (volume : Measure ℝ))) := by
  have hspace := cubeActivePassiveSplit_measurePreserving i
  have hproduct := (MeasurePreserving.id μz).prod hspace
  have hshuffle := centerActivePassiveShuffle_measurePreserving
    (E3 × ℝ) (ℝ × ℝ) (TransverseSpace i × TransverseSpace i)
    μz ((volume : Measure ℝ).prod (volume : Measure ℝ))
    ((volume : Measure (TransverseSpace i)).prod
      (volume : Measure (TransverseSpace i)))
  simpa only [cubeCenterActivePassiveSplit, Measure.volume_eq_prod] using
    hproduct.trans hshuffle

/-- One active one-dimensional integrand in the source cube Cauchy--Schwarz
argument, with center--scale and passive coordinates held fixed. -/
noncomputable def cubeActiveCSFactor (α : Anisotropy) (i : Fin 3)
    (lam r : ℝ) (F : CubeVertex → E3 → ℝ) (b : Bool)
    (w : (E3 × ℝ) × (TransverseSpace i × TransverseSpace i)) (v : ℝ) : ℝ :=
  cubeGaussianDerivKernel α lam r w.1.2 w.1.1 i v *
    cubeActiveInputSlice i b F w.2 v

/-- The four passive Gaussian factors are Borel measurable in the
center--scale/passive variables. -/
theorem measurable_cubePassiveGaussianKernel
    (α : Anisotropy) (i : Fin 3) (lam r : ℝ) :
    Measurable (fun w : (E3 × ℝ) ×
      (TransverseSpace i × TransverseSpace i) ↦
      cubePassiveGaussianKernel α i lam r w.1.2 w.1.1 w.2) := by
  classical
  unfold cubePassiveGaussianKernel
  apply Finset.measurable_fun_prod
  intro m hm
  split_ifs with hmi
  · exact measurable_const
  · have ht : Measurable (fun w : (E3 × ℝ) ×
        (TransverseSpace i × TransverseSpace i) ↦ w.1.2 ^ α.weight m) :=
      (measurable_snd.comp measurable_fst).pow_const _
    have hp : Measurable (fun w : (E3 × ℝ) ×
        (TransverseSpace i × TransverseSpace i) ↦ w.1.1.1 m) :=
      (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) m).measurable.comp
        (measurable_fst.comp measurable_fst)
    have hs : Measurable (fun w : (E3 × ℝ) ×
        (TransverseSpace i × TransverseSpace i) ↦
        cubeWidth m lam * w.1.2 ^ α.weight m) := measurable_const.mul ht
    have ha : Measurable (fun w : (E3 × ℝ) ×
        (TransverseSpace i × TransverseSpace i) ↦
        w.1.1 m + cubeCenterShift m r * w.1.2 ^ α.weight m) :=
      hp.add (measurable_const.mul ht)
    have hx (b : Bool) : Measurable (fun w : (E3 × ℝ) ×
        (TransverseSpace i × TransverseSpace i) ↦
        if b then w.2.2 ⟨m, hmi⟩ else w.2.1 ⟨m, hmi⟩) := by
      cases b
      · simpa only [Bool.false_eq_true, ↓reduceIte, Function.comp_def] using
          (PiLp.continuous_apply (p := 2)
            (β := fun _ : {q : Fin 3 // q ≠ i} ↦ ℝ) ⟨m, hmi⟩).measurable.comp
            ((measurable_fst : Measurable (fun y :
              TransverseSpace i × TransverseSpace i ↦ y.1)).comp
              (measurable_snd : Measurable (fun w : (E3 × ℝ) ×
                (TransverseSpace i × TransverseSpace i) ↦ w.2)))
      · simpa only [↓reduceIte, Function.comp_def] using
          (PiLp.continuous_apply (p := 2)
            (β := fun _ : {q : Fin 3 // q ≠ i} ↦ ℝ) ⟨m, hmi⟩).measurable.comp
            ((measurable_snd : Measurable (fun y :
              TransverseSpace i × TransverseSpace i ↦ y.2)).comp
              (measurable_snd : Measurable (fun w : (E3 × ℝ) ×
                (TransverseSpace i × TransverseSpace i) ↦ w.2)))
    have hG (b : Bool) : Measurable (fun w : (E3 × ℝ) ×
        (TransverseSpace i × TransverseSpace i) ↦
        cubeGaussianKernel α lam r w.1.2 w.1.1 m
          (if b then w.2.2 ⟨m, hmi⟩ else w.2.1 ⟨m, hmi⟩)) := by
      unfold cubeGaussianKernel gaussianAt kernelAt kernelDilate
      simpa only [smul_eq_mul] using
        (show Measurable (fun w : (E3 × ℝ) ×
          (TransverseSpace i × TransverseSpace i) ↦
          (cubeWidth m lam * w.1.2 ^ α.weight m)⁻¹ * gaussian
            (((if b then w.2.2 ⟨m, hmi⟩ else w.2.1 ⟨m, hmi⟩) -
              (w.1.1 m + cubeCenterShift m r * w.1.2 ^ α.weight m)) /
          (cubeWidth m lam * w.1.2 ^ α.weight m))) from
          hs.inv.mul (gaussian_contDiff.continuous.measurable.comp
            (((hx b).sub ha).div hs)))
    exact (hG false).mul (hG true)

/-- The one-dimensional active factor is Borel measurable jointly in its
center--scale/passive parameters and active scalar. -/
theorem measurable_cubeActiveCSFactor
    (α : Anisotropy) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (b : Bool)
    (hF : ∀ j, Continuous (F j)) :
    Measurable (fun wv : ((E3 × ℝ) ×
      (TransverseSpace i × TransverseSpace i)) × ℝ ↦
      cubeActiveCSFactor α i lam r F b wv.1 wv.2) := by
  unfold cubeActiveCSFactor
  have ht : Measurable (fun wv : ((E3 × ℝ) ×
      (TransverseSpace i × TransverseSpace i)) × ℝ ↦
      wv.1.1.2 ^ α.weight i) :=
    (measurable_snd.comp (measurable_fst.comp measurable_fst)).pow_const _
  have hp : Measurable (fun wv : ((E3 × ℝ) ×
      (TransverseSpace i × TransverseSpace i)) × ℝ ↦ wv.1.1.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp
      (measurable_fst.comp (measurable_fst.comp measurable_fst))
  have hs : Measurable (fun wv : ((E3 × ℝ) ×
      (TransverseSpace i × TransverseSpace i)) × ℝ ↦
      cubeWidth i lam * wv.1.1.2 ^ α.weight i) := measurable_const.mul ht
  have ha : Measurable (fun wv : ((E3 × ℝ) ×
      (TransverseSpace i × TransverseSpace i)) × ℝ ↦
      wv.1.1.1 i + cubeCenterShift i r * wv.1.1.2 ^ α.weight i) :=
    hp.add (measurable_const.mul ht)
  have hH : Measurable (fun wv : ((E3 × ℝ) ×
      (TransverseSpace i × TransverseSpace i)) × ℝ ↦
      cubeGaussianDerivKernel α lam r wv.1.1.2 wv.1.1.1 i wv.2) := by
    unfold cubeGaussianDerivKernel gaussianDerivAt kernelAt kernelDilate
    have hderiv : Measurable gaussianDeriv := by
      unfold gaussianDeriv
      exact (measurable_const.mul measurable_id).mul
        gaussian_contDiff.continuous.measurable
    simpa only [smul_eq_mul] using
      (show Measurable (fun wv : ((E3 × ℝ) ×
        (TransverseSpace i × TransverseSpace i)) × ℝ ↦
        (cubeWidth i lam * wv.1.1.2 ^ α.weight i)⁻¹ * gaussianDeriv
          ((wv.2 - (wv.1.1.1 i + cubeCenterShift i r *
            wv.1.1.2 ^ α.weight i)) /
            (cubeWidth i lam * wv.1.1.2 ^ α.weight i))) from
        hs.inv.mul (hderiv.comp ((measurable_snd.sub ha).div hs)))
  have hpair : Continuous (fun wv : ((E3 × ℝ) ×
      (TransverseSpace i × TransverseSpace i)) × ℝ ↦ (wv.1.2, wv.2)) :=
    (continuous_snd.comp continuous_fst).prodMk continuous_snd
  have hinput : Measurable (fun wv : ((E3 × ℝ) ×
      (TransverseSpace i × TransverseSpace i)) × ℝ ↦
      cubeActiveInputSlice i b F wv.1.2 wv.2) :=
    (continuous_cubeActiveInputSlice i b F hF).measurable.comp hpair.measurable
  exact hH.mul hinput

/-- At positive scale, each non-derivative Gaussian coordinate factor is
nonnegative. -/
theorem cubeGaussianKernel_nonneg_of_pos
    (α : Anisotropy) (i : Fin 3) (lam r t : ℝ) (p : E3) (v : ℝ)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    0 ≤ cubeGaussianKernel α lam r t p i v := by
  unfold cubeGaussianKernel gaussianAt kernelAt kernelDilate
  simp only [smul_eq_mul]
  exact mul_nonneg
    (inv_nonneg.mpr (cubeGaussianScale_pos α i hlam ht).le)
    (gaussian_nonneg _)

/-- The passive fourfold Gaussian weight is nonnegative on the positive
scale half-space supporting the local cube form. -/
theorem cubePassiveGaussianKernel_nonneg_of_pos
    (α : Anisotropy) (i : Fin 3) (lam r t : ℝ) (p : E3)
    (y : TransverseSpace i × TransverseSpace i)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    0 ≤ cubePassiveGaussianKernel α i lam r t p y := by
  classical
  unfold cubePassiveGaussianKernel
  apply Finset.prod_nonneg
  intro m hm
  split_ifs with hmi
  · norm_num
  · exact mul_nonneg
      (cubeGaussianKernel_nonneg_of_pos α m lam r t p (y.1 ⟨m, hmi⟩) hlam ht)
      (cubeGaussianKernel_nonneg_of_pos α m lam r t p (y.2 ⟨m, hmi⟩) hlam ht)

/-- The transformed local integrand factors into its passive Gaussian weight
and the two active one-dimensional factors. -/
theorem cubeLocalIntegrand_cubeCenterActivePassiveSplit_symm
    (α : Anisotropy) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ)
    (w : (E3 × ℝ) × (TransverseSpace i × TransverseSpace i))
    (v : ℝ × ℝ) :
    cubeSignedInputProduct F
        ((cubeCenterActivePassiveSplit i).symm (w, v)).2 *
      localCubeKernel α i lam r
        ((cubeCenterActivePassiveSplit i).symm (w, v)).1.2
        ((cubeCenterActivePassiveSplit i).symm (w, v)).1.1
        ((cubeCenterActivePassiveSplit i).symm (w, v)).2 =
      cubePassiveGaussianKernel α i lam r w.1.2 w.1.1 w.2 *
        cubeActiveCSFactor α i lam r F false w v.1 *
          cubeActiveCSFactor α i lam r F true w v.2 := by
  let z : E3 × ℝ := w.1
  let y : TransverseSpace i × TransverseSpace i := w.2
  change
    cubeSignedInputProduct F ((cubeActivePassiveSplit i).symm ((v.1, v.2), y)) *
      localCubeKernel α i lam r z.2 z.1
        ((cubeActivePassiveSplit i).symm ((v.1, v.2), y)) = _
  rw [cubeSignedInputProduct_cubeActivePassiveSplit_symm,
    localCubeKernel_cubeActivePassiveSplit_symm]
  simp only [cubeActiveCSFactor]
  ring

/-- The transformed local integrand of a coordinate copy has two copies of
the same active one-dimensional factor. -/
theorem cubeLocalIntegrand_coordinateCopy_cubeCenterActivePassiveSplit_symm
    (α : Anisotropy) (i : Fin 3) (lam r : ℝ) (b : Bool)
    (F : CubeVertex → E3 → ℝ)
    (w : (E3 × ℝ) × (TransverseSpace i × TransverseSpace i))
    (v : ℝ × ℝ) :
    cubeSignedInputProduct (cubeCoordinateCopy i b F)
        ((cubeCenterActivePassiveSplit i).symm (w, v)).2 *
      localCubeKernel α i lam r
        ((cubeCenterActivePassiveSplit i).symm (w, v)).1.2
        ((cubeCenterActivePassiveSplit i).symm (w, v)).1.1
        ((cubeCenterActivePassiveSplit i).symm (w, v)).2 =
      cubePassiveGaussianKernel α i lam r w.1.2 w.1.1 w.2 *
        cubeActiveCSFactor α i lam r F b w v.1 *
          cubeActiveCSFactor α i lam r F b w v.2 := by
  let z : E3 × ℝ := w.1
  let y : TransverseSpace i × TransverseSpace i := w.2
  change
    cubeSignedInputProduct (cubeCoordinateCopy i b F)
        ((cubeActivePassiveSplit i).symm ((v.1, v.2), y)) *
      localCubeKernel α i lam r z.2 z.1
        ((cubeActivePassiveSplit i).symm ((v.1, v.2), y)) = _
  rw [cubeSignedInputProduct_coordinateCopy_cubeActivePassiveSplit_symm,
    localCubeKernel_cubeActivePassiveSplit_symm]
  simp only [cubeActiveCSFactor]
  ring

/-- The one-dimensional active integral `A_b` from the source proof. -/
noncomputable def cubeActiveCSAverage (α : Anisotropy) (i : Fin 3)
    (lam r : ℝ) (F : CubeVertex → E3 → ℝ) (b : Bool)
    (w : (E3 × ℝ) × (TransverseSpace i × TransverseSpace i)) : ℝ :=
  ∫ v : ℝ, cubeActiveCSFactor α i lam r F b w v

/-- The active average is strongly measurable whenever the eight source
inputs are continuous. -/
theorem stronglyMeasurable_cubeActiveCSAverage
    (α : Anisotropy) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (b : Bool)
    (hF : ∀ j, Continuous (F j)) :
    StronglyMeasurable (cubeActiveCSAverage α i lam r F b) := by
  unfold cubeActiveCSAverage
  exact (measurable_cubeActiveCSFactor α i lam r F b hF).stronglyMeasurable
    |>.integral_prod_right'

/-- The square-root-passive-weighted active average used in the final
Cauchy--Schwarz integral. -/
noncomputable def cubeActiveCSWeightedAverage (α : Anisotropy) (i : Fin 3)
    (lam r : ℝ) (F : CubeVertex → E3 → ℝ) (b : Bool)
    (w : (E3 × ℝ) × (TransverseSpace i × TransverseSpace i)) : ℝ :=
  Real.sqrt (cubePassiveGaussianKernel α i lam r w.1.2 w.1.1 w.2) *
    cubeActiveCSAverage α i lam r F b w

/-- The weighted active average is strongly measurable. -/
theorem stronglyMeasurable_cubeActiveCSWeightedAverage
    (α : Anisotropy) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (b : Bool)
    (hF : ∀ j, Continuous (F j)) :
    StronglyMeasurable (cubeActiveCSWeightedAverage α i lam r F b) := by
  unfold cubeActiveCSWeightedAverage
  exact ((measurable_cubePassiveGaussianKernel α i lam r).sqrt.stronglyMeasurable).mul
    (stronglyMeasurable_cubeActiveCSAverage α i lam r F b hF)

/-- Fubini in the two active scalars factors the transformed original local
integrand into the two source averages. -/
theorem integral_cubeLocalIntegrand_active_factorization
    (α : Anisotropy) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ)
    (w : (E3 × ℝ) × (TransverseSpace i × TransverseSpace i)) :
    ∫ v : ℝ × ℝ,
      cubeSignedInputProduct F
          ((cubeCenterActivePassiveSplit i).symm (w, v)).2 *
        localCubeKernel α i lam r
          ((cubeCenterActivePassiveSplit i).symm (w, v)).1.2
          ((cubeCenterActivePassiveSplit i).symm (w, v)).1.1
          ((cubeCenterActivePassiveSplit i).symm (w, v)).2 =
      cubePassiveGaussianKernel α i lam r w.1.2 w.1.1 w.2 *
        cubeActiveCSAverage α i lam r F false w *
          cubeActiveCSAverage α i lam r F true w := by
  let P : ℝ := cubePassiveGaussianKernel α i lam r w.1.2 w.1.1 w.2
  let A0 : ℝ → ℝ := cubeActiveCSFactor α i lam r F false w
  let A1 : ℝ → ℝ := cubeActiveCSFactor α i lam r F true w
  calc
    ∫ v : ℝ × ℝ,
        cubeSignedInputProduct F
            ((cubeCenterActivePassiveSplit i).symm (w, v)).2 *
          localCubeKernel α i lam r
            ((cubeCenterActivePassiveSplit i).symm (w, v)).1.2
            ((cubeCenterActivePassiveSplit i).symm (w, v)).1.1
            ((cubeCenterActivePassiveSplit i).symm (w, v)).2 =
        ∫ v : ℝ × ℝ, P * (A0 v.1 * A1 v.2) := by
          apply integral_congr_ae
          filter_upwards [] with v
          simpa only [P, A0, A1, mul_assoc] using
            cubeLocalIntegrand_cubeCenterActivePassiveSplit_symm α i lam r F w v
    _ = P * ∫ v : ℝ × ℝ, A0 v.1 * A1 v.2 :=
      MeasureTheory.integral_const_mul P _
    _ = P * ((∫ v : ℝ, A0 v) * ∫ v : ℝ, A1 v) := by
      congr 1
      rw [Measure.volume_eq_prod]
      exact MeasureTheory.integral_prod_mul A0 A1
    _ = cubePassiveGaussianKernel α i lam r w.1.2 w.1.1 w.2 *
        cubeActiveCSAverage α i lam r F false w *
          cubeActiveCSAverage α i lam r F true w := by
      simp only [P, A0, A1, cubeActiveCSAverage]
      ring

/-- The same active Fubini calculation for a coordinate copy yields a square
of one source average. -/
theorem integral_cubeLocalIntegrand_coordinateCopy_active_factorization
    (α : Anisotropy) (i : Fin 3) (lam r : ℝ) (b : Bool)
    (F : CubeVertex → E3 → ℝ)
    (w : (E3 × ℝ) × (TransverseSpace i × TransverseSpace i)) :
    ∫ v : ℝ × ℝ,
      cubeSignedInputProduct (cubeCoordinateCopy i b F)
          ((cubeCenterActivePassiveSplit i).symm (w, v)).2 *
        localCubeKernel α i lam r
          ((cubeCenterActivePassiveSplit i).symm (w, v)).1.2
          ((cubeCenterActivePassiveSplit i).symm (w, v)).1.1
          ((cubeCenterActivePassiveSplit i).symm (w, v)).2 =
      cubePassiveGaussianKernel α i lam r w.1.2 w.1.1 w.2 *
        (cubeActiveCSAverage α i lam r F b w) ^ 2 := by
  let P : ℝ := cubePassiveGaussianKernel α i lam r w.1.2 w.1.1 w.2
  let A : ℝ → ℝ := cubeActiveCSFactor α i lam r F b w
  calc
    ∫ v : ℝ × ℝ,
        cubeSignedInputProduct (cubeCoordinateCopy i b F)
            ((cubeCenterActivePassiveSplit i).symm (w, v)).2 *
          localCubeKernel α i lam r
            ((cubeCenterActivePassiveSplit i).symm (w, v)).1.2
            ((cubeCenterActivePassiveSplit i).symm (w, v)).1.1
            ((cubeCenterActivePassiveSplit i).symm (w, v)).2 =
        ∫ v : ℝ × ℝ, P * (A v.1 * A v.2) := by
          apply integral_congr_ae
          filter_upwards [] with v
          simpa only [P, A, mul_assoc] using
            cubeLocalIntegrand_coordinateCopy_cubeCenterActivePassiveSplit_symm
              α i lam r b F w v
    _ = P * ∫ v : ℝ × ℝ, A v.1 * A v.2 :=
      MeasureTheory.integral_const_mul P _
    _ = P * ((∫ v : ℝ, A v) * ∫ v : ℝ, A v) := by
      congr 1
      rw [Measure.volume_eq_prod]
      exact MeasureTheory.integral_prod_mul A A
    _ = cubePassiveGaussianKernel α i lam r w.1.2 w.1.1 w.2 *
        (cubeActiveCSAverage α i lam r F b w) ^ 2 := by
      simp only [P, A, cubeActiveCSAverage]
      ring


/-- Transport the jointly integrable local cube integrand through the
active/passive measurable equivalence and then apply product Fubini. -/
theorem integral_localCubeIntegrand_centerActivePassive_fubini
    (α : Anisotropy) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (μz : Measure (E3 × ℝ)) [SFinite μz]
    (hjoint : Integrable (fun zx : (E3 × ℝ) × E6 ↦
      cubeSignedInputProduct F zx.2 *
        localCubeKernel α i lam r zx.1.2 zx.1.1 zx.2) (μz.prod volume)) :
    (∫ zx : (E3 × ℝ) × E6,
      cubeSignedInputProduct F zx.2 *
        localCubeKernel α i lam r zx.1.2 zx.1.1 zx.2 ∂(μz.prod volume)) =
      ∫ w : (E3 × ℝ) × (TransverseSpace i × TransverseSpace i),
        ∫ v : ℝ × ℝ,
          cubeSignedInputProduct F
              ((cubeCenterActivePassiveSplit i).symm (w, v)).2 *
            localCubeKernel α i lam r
              ((cubeCenterActivePassiveSplit i).symm (w, v)).1.2
              ((cubeCenterActivePassiveSplit i).symm (w, v)).1.1
              ((cubeCenterActivePassiveSplit i).symm (w, v)).2
          ∂((volume : Measure ℝ).prod volume)
        ∂(μz.prod ((volume : Measure (TransverseSpace i)).prod volume)) := by
  let g : (E3 × ℝ) × E6 → ℝ := fun zx ↦
    cubeSignedInputProduct F zx.2 *
      localCubeKernel α i lam r zx.1.2 zx.1.1 zx.2
  let e := cubeCenterActivePassiveSplit i
  let μw : Measure ((E3 × ℝ) × (TransverseSpace i × TransverseSpace i)) :=
    μz.prod ((volume : Measure (TransverseSpace i)).prod volume)
  let μv : Measure (ℝ × ℝ) := (volume : Measure ℝ).prod volume
  have hmp : MeasurePreserving e (μz.prod volume) (μw.prod μv) := by
    simpa only [e, μw, μv, Measure.volume_eq_prod] using
      cubeCenterActivePassiveSplit_measurePreserving i μz
  have htrans : Integrable (fun q :
      ((E3 × ℝ) × (TransverseSpace i × TransverseSpace i)) × (ℝ × ℝ) ↦
        g (e.symm q)) (μw.prod μv) := by
    exact (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hjoint
  calc
    (∫ zx : (E3 × ℝ) × E6, g zx ∂(μz.prod volume)) =
        ∫ q : ((E3 × ℝ) × (TransverseSpace i × TransverseSpace i)) × (ℝ × ℝ),
          g (e.symm q) ∂(μw.prod μv) := by
      exact (MeasurePreserving.symm e hmp).integral_comp
        e.symm.measurableEmbedding g |>.symm
    _ = ∫ w : (E3 × ℝ) × (TransverseSpace i × TransverseSpace i),
        ∫ v : ℝ × ℝ, g (e.symm (w, v)) ∂μv ∂μw :=
      MeasureTheory.integral_prod _ htrans
    _ = _ := by rfl


/-- The passive product measure inherited from a finite collection is
supported on strictly positive scales. -/
theorem ae_pos_scale_cubePassiveMeasure
    (α : Anisotropy) (S : BoxCollection α) (i : Fin 3) :
    ∀ᵐ w ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
      ((volume : Measure (TransverseSpace i)).prod
        (volume : Measure (TransverseSpace i)))), 0 < w.1.2 := by
  let μz : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let μy : Measure (TransverseSpace i × TransverseSpace i) :=
    (volume : Measure (TransverseSpace i)).prod
      (volume : Measure (TransverseSpace i))
  have htz : ∀ᵐ z ∂μz, 0 < z.2 := by
    dsimp [μz]
    filter_upwards [ae_restrict_mem (measurableSet_collectionRegion α S)] with z hz
    exact pos_of_mem_closure_collectionRegion α S (subset_closure hz)
  have hmeas : MeasurableSet {w : (E3 × ℝ) ×
      (TransverseSpace i × TransverseSpace i) | 0 < w.1.2} := by
    change MeasurableSet ((fun w : (E3 × ℝ) ×
      (TransverseSpace i × TransverseSpace i) ↦ w.1.2) ⁻¹' Set.Ioi 0)
    exact measurableSet_preimage (measurable_snd.comp measurable_fst) measurableSet_Ioi
  change ∀ᵐ w ∂μz.prod μy, 0 < w.1.2
  apply (Measure.ae_prod_iff_ae_ae hmeas).2
  filter_upwards [htz] with z hz
  exact Filter.Eventually.of_forall fun y ↦ hz

/-- On positive scales the original active product is the product of the
two square-root-weighted averages. -/
theorem cubeActiveCSWeightedAverage_mul_of_pos
    (α : Anisotropy) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ)
    (w : (E3 × ℝ) × (TransverseSpace i × TransverseSpace i))
    (hlam : 1 ≤ lam) (ht : 0 < w.1.2) :
    cubeActiveCSWeightedAverage α i lam r F false w *
        cubeActiveCSWeightedAverage α i lam r F true w =
      cubePassiveGaussianKernel α i lam r w.1.2 w.1.1 w.2 *
        cubeActiveCSAverage α i lam r F false w *
          cubeActiveCSAverage α i lam r F true w := by
  have hP : 0 ≤ cubePassiveGaussianKernel α i lam r w.1.2 w.1.1 w.2 :=
    cubePassiveGaussianKernel_nonneg_of_pos α i lam r w.1.2 w.1.1 w.2 hlam ht
  unfold cubeActiveCSWeightedAverage
  have hsqrt : Real.sqrt (cubePassiveGaussianKernel α i lam r w.1.2 w.1.1 w.2) *
      Real.sqrt (cubePassiveGaussianKernel α i lam r w.1.2 w.1.1 w.2) =
      cubePassiveGaussianKernel α i lam r w.1.2 w.1.1 w.2 := by
    simpa only [pow_two] using Real.sq_sqrt hP
  calc
    Real.sqrt (cubePassiveGaussianKernel α i lam r w.1.2 w.1.1 w.2) *
        cubeActiveCSAverage α i lam r F false w *
          (Real.sqrt (cubePassiveGaussianKernel α i lam r w.1.2 w.1.1 w.2) *
            cubeActiveCSAverage α i lam r F true w) =
        (Real.sqrt (cubePassiveGaussianKernel α i lam r w.1.2 w.1.1 w.2) *
          Real.sqrt (cubePassiveGaussianKernel α i lam r w.1.2 w.1.1 w.2)) *
            (cubeActiveCSAverage α i lam r F false w *
              cubeActiveCSAverage α i lam r F true w) := by ring
    _ = cubePassiveGaussianKernel α i lam r w.1.2 w.1.1 w.2 *
        cubeActiveCSAverage α i lam r F false w *
          cubeActiveCSAverage α i lam r F true w := by rw [hsqrt]; ring

/-- On positive scales a copied active product is the square of the
corresponding square-root-weighted average. -/
theorem cubeActiveCSWeightedAverage_sq_of_pos
    (α : Anisotropy) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (b : Bool)
    (w : (E3 × ℝ) × (TransverseSpace i × TransverseSpace i))
    (hlam : 1 ≤ lam) (ht : 0 < w.1.2) :
    (cubeActiveCSWeightedAverage α i lam r F b w) ^ 2 =
      cubePassiveGaussianKernel α i lam r w.1.2 w.1.1 w.2 *
        (cubeActiveCSAverage α i lam r F b w) ^ 2 := by
  have hP : 0 ≤ cubePassiveGaussianKernel α i lam r w.1.2 w.1.1 w.2 :=
    cubePassiveGaussianKernel_nonneg_of_pos α i lam r w.1.2 w.1.1 w.2 hlam ht
  unfold cubeActiveCSWeightedAverage
  rw [mul_pow, Real.sq_sqrt hP]

/-- Joint local-cube integrability transports to integrability of the
active-pair integral over the center--scale/passive variables. -/
theorem integrable_activePairIntegral_of_joint
    (α : Anisotropy) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (μz : Measure (E3 × ℝ)) [SFinite μz]
    (hjoint : Integrable (fun zx : (E3 × ℝ) × E6 ↦
      cubeSignedInputProduct F zx.2 *
        localCubeKernel α i lam r zx.1.2 zx.1.1 zx.2) (μz.prod volume)) :
    Integrable (fun w : (E3 × ℝ) ×
      (TransverseSpace i × TransverseSpace i) ↦
      ∫ v : ℝ × ℝ,
        cubeSignedInputProduct F
            ((cubeCenterActivePassiveSplit i).symm (w, v)).2 *
          localCubeKernel α i lam r
            ((cubeCenterActivePassiveSplit i).symm (w, v)).1.2
            ((cubeCenterActivePassiveSplit i).symm (w, v)).1.1
            ((cubeCenterActivePassiveSplit i).symm (w, v)).2
        ∂((volume : Measure ℝ).prod volume))
      (μz.prod ((volume : Measure (TransverseSpace i)).prod volume)) := by
  let g : (E3 × ℝ) × E6 → ℝ := fun zx ↦
    cubeSignedInputProduct F zx.2 *
      localCubeKernel α i lam r zx.1.2 zx.1.1 zx.2
  let e := cubeCenterActivePassiveSplit i
  let μw : Measure ((E3 × ℝ) × (TransverseSpace i × TransverseSpace i)) :=
    μz.prod ((volume : Measure (TransverseSpace i)).prod volume)
  let μv : Measure (ℝ × ℝ) := (volume : Measure ℝ).prod volume
  have hmp : MeasurePreserving e (μz.prod volume) (μw.prod μv) := by
    simpa only [e, μw, μv, Measure.volume_eq_prod] using
      cubeCenterActivePassiveSplit_measurePreserving i μz
  have htrans : Integrable (fun q :
      ((E3 × ℝ) × (TransverseSpace i × TransverseSpace i)) × (ℝ × ℝ) ↦
      g (e.symm q)) (μw.prod μv) := by
    exact (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hjoint
  simpa only [g, e, μw, μv] using htrans.integral_prod_left

/-- The copied local integrand supplies the square-integrability needed for
the final one-dimensional Cauchy--Schwarz inequality. -/
theorem integrable_cubeActiveCSWeightedAverage_sq
    (α : Anisotropy) (S : BoxCollection α) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (b : Bool)
    (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (hlam : 1 ≤ lam) :
    Integrable (fun w : (E3 × ℝ) ×
      (TransverseSpace i × TransverseSpace i) ↦
      (cubeActiveCSWeightedAverage α i lam r F b w) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        ((volume : Measure (TransverseSpace i)).prod volume)) := by
  let : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  let μz : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  have hjoint : Integrable (fun zx : (E3 × ℝ) × E6 ↦
      cubeSignedInputProduct (cubeCoordinateCopy i b F) zx.2 *
        localCubeKernel α i lam r zx.1.2 zx.1.1 zx.2) (μz.prod volume) := by
    simpa only [μz] using
      integrable_cubeSignedInputProduct_mul_localCubeKernel_collection
        α S i lam r (cubeCoordinateCopy i b F)
        (continuous_cubeCoordinateCopy i b F hFcont)
        (bounded_cubeCoordinateCopy i b F hFbound) hlam
  have hinter := integrable_activePairIntegral_of_joint
    α i lam r (cubeCoordinateCopy i b F) μz hjoint
  change Integrable (fun w : (E3 × ℝ) ×
      (TransverseSpace i × TransverseSpace i) ↦
      (cubeActiveCSWeightedAverage α i lam r F b w) ^ 2)
      (μz.prod ((volume : Measure (TransverseSpace i)).prod
        (volume : Measure (TransverseSpace i))))
  refine hinter.congr ?_
  have hpos : ∀ᵐ w ∂(μz.prod
      ((volume : Measure (TransverseSpace i)).prod
        (volume : Measure (TransverseSpace i)))), 0 < w.1.2 := by
    simpa only [μz] using ae_pos_scale_cubePassiveMeasure α S i
  filter_upwards [hpos] with w hw
  rw [← Measure.volume_eq_prod]
  rw [integral_cubeLocalIntegrand_coordinateCopy_active_factorization
    α i lam r b F w]
  exact (cubeActiveCSWeightedAverage_sq_of_pos α i lam r F b w hlam hw).symm

/-- The original local cube form is the outer integral of the product of
the two weighted active averages. -/
theorem localCubeForm_eq_weightedIntegral
    (α : Anisotropy) (S : BoxCollection α) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ)
    (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (hlam : 1 ≤ lam) :
    localCubeForm α S i lam r F =
      ∫ w : (E3 × ℝ) × (TransverseSpace i × TransverseSpace i),
        cubeActiveCSWeightedAverage α i lam r F false w *
          cubeActiveCSWeightedAverage α i lam r F true w
        ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
          ((volume : Measure (TransverseSpace i)).prod
            (volume : Measure (TransverseSpace i)))) := by
  let : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  let μz : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  have hjoint : Integrable (fun zx : (E3 × ℝ) × E6 ↦
      cubeSignedInputProduct F zx.2 *
        localCubeKernel α i lam r zx.1.2 zx.1.1 zx.2) (μz.prod volume) := by
    simpa only [μz] using
      integrable_cubeSignedInputProduct_mul_localCubeKernel_collection
        α S i lam r F hFcont hFbound hlam
  have hlocal : localCubeForm α S i lam r F =
      ∫ zx : (E3 × ℝ) × E6,
        cubeSignedInputProduct F zx.2 *
          localCubeKernel α i lam r zx.1.2 zx.1.1 zx.2 ∂(μz.prod volume) := by
    unfold localCubeForm
    simpa only [μz] using (MeasureTheory.integral_prod _ hjoint).symm
  calc
    localCubeForm α S i lam r F =
        ∫ zx : (E3 × ℝ) × E6,
          cubeSignedInputProduct F zx.2 *
            localCubeKernel α i lam r zx.1.2 zx.1.1 zx.2 ∂(μz.prod volume) := hlocal
    _ = ∫ w : (E3 × ℝ) × (TransverseSpace i × TransverseSpace i),
        ∫ v : ℝ × ℝ,
          cubeSignedInputProduct F
              ((cubeCenterActivePassiveSplit i).symm (w, v)).2 *
            localCubeKernel α i lam r
              ((cubeCenterActivePassiveSplit i).symm (w, v)).1.2
              ((cubeCenterActivePassiveSplit i).symm (w, v)).1.1
              ((cubeCenterActivePassiveSplit i).symm (w, v)).2
            ∂((volume : Measure ℝ).prod volume)
          ∂(μz.prod ((volume : Measure (TransverseSpace i)).prod volume)) :=
      integral_localCubeIntegrand_centerActivePassive_fubini α i lam r F μz hjoint
    _ = ∫ w : (E3 × ℝ) × (TransverseSpace i × TransverseSpace i),
        cubeActiveCSWeightedAverage α i lam r F false w *
          cubeActiveCSWeightedAverage α i lam r F true w
          ∂(μz.prod ((volume : Measure (TransverseSpace i)).prod volume)) := by
      apply integral_congr_ae
      have hpos : ∀ᵐ w ∂(μz.prod
          ((volume : Measure (TransverseSpace i)).prod
            (volume : Measure (TransverseSpace i)))), 0 < w.1.2 := by
        simpa only [μz] using ae_pos_scale_cubePassiveMeasure α S i
      filter_upwards [hpos] with w hw
      rw [← Measure.volume_eq_prod]
      rw [integral_cubeLocalIntegrand_active_factorization α i lam r F w]
      exact (cubeActiveCSWeightedAverage_mul_of_pos α i lam r F w hlam hw).symm
    _ = _ := by rfl

/-- A coordinate copy of the local cube form is the outer integral of the
square of its weighted active average. -/
theorem localCubeForm_coordinateCopy_eq_weightedSq
    (α : Anisotropy) (S : BoxCollection α) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (b : Bool)
    (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (hlam : 1 ≤ lam) :
    localCubeForm α S i lam r (cubeCoordinateCopy i b F) =
      ∫ w : (E3 × ℝ) × (TransverseSpace i × TransverseSpace i),
        (cubeActiveCSWeightedAverage α i lam r F b w) ^ 2
        ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
          ((volume : Measure (TransverseSpace i)).prod
            (volume : Measure (TransverseSpace i)))) := by
  let : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  let μz : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  have hjoint : Integrable (fun zx : (E3 × ℝ) × E6 ↦
      cubeSignedInputProduct (cubeCoordinateCopy i b F) zx.2 *
        localCubeKernel α i lam r zx.1.2 zx.1.1 zx.2) (μz.prod volume) := by
    simpa only [μz] using
      integrable_cubeSignedInputProduct_mul_localCubeKernel_collection
        α S i lam r (cubeCoordinateCopy i b F)
        (continuous_cubeCoordinateCopy i b F hFcont)
        (bounded_cubeCoordinateCopy i b F hFbound) hlam
  have hlocal : localCubeForm α S i lam r (cubeCoordinateCopy i b F) =
      ∫ zx : (E3 × ℝ) × E6,
        cubeSignedInputProduct (cubeCoordinateCopy i b F) zx.2 *
          localCubeKernel α i lam r zx.1.2 zx.1.1 zx.2 ∂(μz.prod volume) := by
    unfold localCubeForm
    simpa only [μz] using (MeasureTheory.integral_prod _ hjoint).symm
  calc
    localCubeForm α S i lam r (cubeCoordinateCopy i b F) =
        ∫ zx : (E3 × ℝ) × E6,
          cubeSignedInputProduct (cubeCoordinateCopy i b F) zx.2 *
            localCubeKernel α i lam r zx.1.2 zx.1.1 zx.2 ∂(μz.prod volume) := hlocal
    _ = ∫ w : (E3 × ℝ) × (TransverseSpace i × TransverseSpace i),
        ∫ v : ℝ × ℝ,
          cubeSignedInputProduct (cubeCoordinateCopy i b F)
              ((cubeCenterActivePassiveSplit i).symm (w, v)).2 *
            localCubeKernel α i lam r
              ((cubeCenterActivePassiveSplit i).symm (w, v)).1.2
              ((cubeCenterActivePassiveSplit i).symm (w, v)).1.1
              ((cubeCenterActivePassiveSplit i).symm (w, v)).2
            ∂((volume : Measure ℝ).prod volume)
          ∂(μz.prod ((volume : Measure (TransverseSpace i)).prod volume)) :=
      integral_localCubeIntegrand_centerActivePassive_fubini
        α i lam r (cubeCoordinateCopy i b F) μz hjoint
    _ = ∫ w : (E3 × ℝ) × (TransverseSpace i × TransverseSpace i),
        (cubeActiveCSWeightedAverage α i lam r F b w) ^ 2
          ∂(μz.prod ((volume : Measure (TransverseSpace i)).prod volume)) := by
      apply integral_congr_ae
      have hpos : ∀ᵐ w ∂(μz.prod
          ((volume : Measure (TransverseSpace i)).prod
            (volume : Measure (TransverseSpace i)))), 0 < w.1.2 := by
        simpa only [μz] using ae_pos_scale_cubePassiveMeasure α S i
      filter_upwards [hpos] with w hw
      rw [← Measure.volume_eq_prod]
      rw [integral_cubeLocalIntegrand_coordinateCopy_active_factorization
        α i lam r b F w]
      exact (cubeActiveCSWeightedAverage_sq_of_pos α i lam r F b w hlam hw).symm
    _ = _ := by rfl

/-- Coordinate copies of bounded continuous local cube forms are
nonnegative. -/
theorem localCubeForm_coordinateCopy_nonneg
    (α : Anisotropy) (S : BoxCollection α) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (b : Bool)
    (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (hlam : 1 ≤ lam) :
    0 ≤ localCubeForm α S i lam r (cubeCoordinateCopy i b F) := by
  rw [localCubeForm_coordinateCopy_eq_weightedSq
    α S i lam r F b hFcont hFbound hlam]
  exact integral_nonneg fun w ↦ sq_nonneg
    (cubeActiveCSWeightedAverage α i lam r F b w)

/-- Cubical Cauchy--Schwarz for a bounded continuous local cube form. -/
theorem localCubeForm_cauchySchwarz
    (α : Anisotropy) (S : BoxCollection α) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ)
    (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (hlam : 1 ≤ lam) :
    |localCubeForm α S i lam r F| ^ 2 ≤
      localCubeForm α S i lam r (cubeCoordinateCopy i false F) *
        localCubeForm α S i lam r (cubeCoordinateCopy i true F) := by
  let μw : Measure ((E3 × ℝ) × (TransverseSpace i × TransverseSpace i)) :=
    (cubeScaleMeasure.restrict (collectionRegion α S)).prod
      ((volume : Measure (TransverseSpace i)).prod volume)
  have hform : localCubeForm α S i lam r F =
      ∫ w, cubeActiveCSWeightedAverage α i lam r F false w *
        cubeActiveCSWeightedAverage α i lam r F true w ∂μw := by
    simpa only [μw] using localCubeForm_eq_weightedIntegral
      α S i lam r F hFcont hFbound hlam
  have hcopy0 : localCubeForm α S i lam r (cubeCoordinateCopy i false F) =
      ∫ w, (cubeActiveCSWeightedAverage α i lam r F false w) ^ 2 ∂μw := by
    simpa only [μw] using localCubeForm_coordinateCopy_eq_weightedSq
      α S i lam r F false hFcont hFbound hlam
  have hcopy1 : localCubeForm α S i lam r (cubeCoordinateCopy i true F) =
      ∫ w, (cubeActiveCSWeightedAverage α i lam r F true w) ^ 2 ∂μw := by
    simpa only [μw] using localCubeForm_coordinateCopy_eq_weightedSq
      α S i lam r F true hFcont hFbound hlam
  have hmeas0 : AEStronglyMeasurable
      (cubeActiveCSWeightedAverage α i lam r F false) μw :=
    (stronglyMeasurable_cubeActiveCSWeightedAverage α i lam r F false hFcont).aestronglyMeasurable
  have hmeas1 : AEStronglyMeasurable
      (cubeActiveCSWeightedAverage α i lam r F true) μw :=
    (stronglyMeasurable_cubeActiveCSWeightedAverage α i lam r F true hFcont).aestronglyMeasurable
  have hsq0 : Integrable (fun w : (E3 × ℝ) ×
      (TransverseSpace i × TransverseSpace i) ↦
      (cubeActiveCSWeightedAverage α i lam r F false w) ^ 2) μw := by
    simpa only [μw] using integrable_cubeActiveCSWeightedAverage_sq
      α S i lam r F false hFcont hFbound hlam
  have hsq1 : Integrable (fun w : (E3 × ℝ) ×
      (TransverseSpace i × TransverseSpace i) ↦
      (cubeActiveCSWeightedAverage α i lam r F true w) ^ 2) μw := by
    simpa only [μw] using integrable_cubeActiveCSWeightedAverage_sq
      α S i lam r F true hFcont hFbound hlam
  exact localCubeForm_cauchySchwarz_of_fubini α S i lam r F μw
    (cubeActiveCSWeightedAverage α i lam r F false)
    (cubeActiveCSWeightedAverage α i lam r F true)
    hform hcopy0 hcopy1 hmeas0 hmeas1 hsq0 hsq1


/-- The finite three-step cube Cauchy--Schwarz iteration, localized to a
class of tuples closed under coordinate copies. This is the source-ready
version needed when the analytic cube-CS and positivity facts are available
only for bounded continuous tuples. -/
theorem cubeTree_cs_iteration_of_descendant_hypotheses
    (α : Anisotropy) (T : FiniteConvexTree α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (i : Fin 3) (D : ℝ)
    (hD : 0 ≤ D)
    (P : (CubeVertex → E3 → ℝ) → Prop)
    (hPF : P F)
    (hPcopy : ∀ (k : Fin 3) (b : Bool) (G : CubeVertex → E3 → ℝ),
      P G → P (cubeCoordinateCopy k b G))
    (hcs : ∀ (k : Fin 3) (G : CubeVertex → E3 → ℝ), P G →
      |localCubeForm α T.boxes k lam r G| ^ 2 ≤
        localCubeForm α T.boxes k lam r (cubeCoordinateCopy k false G) *
          localCubeForm α T.boxes k lam r (cubeCoordinateCopy k true G))
    (hpos : ∀ (k : Fin 3) (b : Bool) (G : CubeVertex → E3 → ℝ), P G →
      0 ≤ localCubeForm α T.boxes k lam r (cubeCoordinateCopy k b G))
    (htel1 : ∀ a : Bool,
      (∑ k : Fin 3, (α.weight k : ℝ) *
        localCubeForm α T.boxes k lam r (cubeCoordinateCopy i a F)) =
          cubeTreeRemainder α T lam r (cubeCoordinateCopy i a F))
    (htel2 : ∀ (q : Fin 3) (a b : Bool), i ≠ q →
      (∑ k : Fin 3, (α.weight k : ℝ) *
        localCubeForm α T.boxes k lam r
          (cubeCoordinateCopy q b (cubeCoordinateCopy i a F))) =
          cubeTreeRemainder α T lam r
            (cubeCoordinateCopy q b (cubeCoordinateCopy i a F)))
    (htel3 : ∀ (q p : Fin 3) (a b c : Bool), i ≠ q → i ≠ p → q ≠ p →
      (∑ k : Fin 3, (α.weight k : ℝ) *
        localCubeForm α T.boxes k lam r
          (cubeCoordinateCopy p c
            (cubeCoordinateCopy q b (cubeCoordinateCopy i a F)))) =
          cubeTreeRemainder α T lam r
            (cubeCoordinateCopy p c
              (cubeCoordinateCopy q b (cubeCoordinateCopy i a F))))
    (hrem1 : ∀ (k : Fin 3) (b : Bool),
      |cubeTreeRemainder α T lam r (cubeCoordinateCopy k b F)| ≤ D)
    (hrem2 : ∀ (k q : Fin 3) (a b : Bool), k ≠ q →
      |cubeTreeRemainder α T lam r
        (cubeCoordinateCopy q b (cubeCoordinateCopy k a F))| ≤ D)
    (hrem3 : ∀ (k q p : Fin 3) (a b c : Bool),
      k ≠ q → k ≠ p → q ≠ p →
      |cubeTreeRemainder α T lam r
        (cubeCoordinateCopy p c
          (cubeCoordinateCopy q b (cubeCoordinateCopy k a F)))| ≤ D) :
    |localCubeForm α T.boxes i lam r F| ≤
      5 * D / (α.weight i : ℝ) := by
  let θ : Fin 3 → (CubeVertex → E3 → ℝ) → ℝ :=
    fun k G ↦ localCubeForm α T.boxes k lam r G
  let R : (CubeVertex → E3 → ℝ) → ℝ :=
    fun G ↦ cubeTreeRemainder α T lam r G
  let w : Fin 3 → ℝ := fun k ↦ (α.weight k : ℝ)
  let copy : Fin 3 → Bool → (CubeVertex → E3 → ℝ) →
      (CubeVertex → E3 → ℝ) :=
    fun k b G ↦ cubeCoordinateCopy k b G
  have hw (k : Fin 3) : 0 < w k := by
    dsimp [w]
    exact_mod_cast α.weight_pos k
  have hPcopy' (k : Fin 3) (b : Bool) (G : CubeVertex → E3 → ℝ)
      (hG : P G) : P (copy k b G) := by
    simpa [copy] using hPcopy k b G hG
  have hcs' (k : Fin 3) (G : CubeVertex → E3 → ℝ) (hG : P G) :
      |θ k G| ^ 2 ≤ θ k (copy k false G) * θ k (copy k true G) := by
    simpa [θ, copy] using hcs k G hG
  have hpos' (k : Fin 3) (b : Bool) (G : CubeVertex → E3 → ℝ) (hG : P G) :
      0 ≤ θ k (copy k b G) := by
    simpa [θ, copy] using hpos k b G hG
  have htel1' (a : Bool) :
      (∑ k : Fin 3, w k * θ k (copy i a F)) = R (copy i a F) := by
    simpa [θ, R, w, copy] using htel1 a
  have htel2' (q : Fin 3) (a b : Bool) (hiq : i ≠ q) :
      (∑ k : Fin 3, w k * θ k (copy q b (copy i a F))) =
        R (copy q b (copy i a F)) := by
    simpa [θ, R, w, copy] using htel2 q a b hiq
  have htel3' (q p : Fin 3) (a b c : Bool)
      (hiq : i ≠ q) (hip : i ≠ p) (hqp : q ≠ p) :
      (∑ k : Fin 3, w k * θ k (copy p c (copy q b (copy i a F)))) =
        R (copy p c (copy q b (copy i a F))) := by
    simpa [θ, R, w, copy] using htel3 q p a b c hiq hip hqp
  have hrem1' (k : Fin 3) (b : Bool) : |R (copy k b F)| ≤ D := by
    simpa [R, copy] using hrem1 k b
  have hrem2' (k q : Fin 3) (a b : Bool) (hkq : k ≠ q) :
      |R (copy q b (copy k a F))| ≤ D := by
    simpa [R, copy] using hrem2 k q a b hkq
  have hrem3' (k q p : Fin 3) (a b c : Bool)
      (hkq : k ≠ q) (hkp : k ≠ p) (hqp : q ≠ p) :
      |R (copy p c (copy q b (copy k a F)))| ≤ D := by
    simpa [R, copy] using hrem3 k q p a b c hkq hkp hqp
  have hthird (a b : Bool) (q p : Fin 3)
      (hiq : i ≠ q) (hip : i ≠ p) (hqp : q ≠ p) :
      |θ p (copy q b (copy i a F))| ≤ D / w p := by
    let G : CubeVertex → E3 → ℝ := copy q b (copy i a F)
    have hG : P G := by
      dsimp [G]
      exact hPcopy' q b (copy i a F) (hPcopy' i a F hPF)
    have hleaf (c : Bool) : θ p (copy p c G) ≤ D / w p := by
      have hfixi : copy i a (copy p c G) = copy p c G := by
        dsimp [G, copy]
        exact cubeCoordinateCopy_fixed_three_first hiq hip a b c F
      have hfixq : copy q b (copy p c G) = copy p c G := by
        dsimp [G, copy]
        exact cubeCoordinateCopy_fixed_three_second hqp a b c F
      have hfixp : copy p c (copy p c G) = copy p c G := by
        dsimp [G, copy]
        exact cubeCoordinateCopy_fixed_three_third i q p a b c F
      have hPGpc : P (copy p c G) := hPcopy' p c G hG
      have hposi : 0 ≤ θ i (copy p c G) := by
        rw [← hfixi]
        exact hpos' i a (copy p c G) hPGpc
      have hposq : 0 ≤ θ q (copy p c G) := by
        rw [← hfixq]
        exact hpos' q b (copy p c G) hPGpc
      have hposp : 0 ≤ θ p (copy p c G) := hpos' p c G hG
      have hposall (k : Fin 3) : 0 ≤ θ k (copy p c G) := by
        rcases fin_three_eq_one_of_three (k := k) hiq hip hqp with hk | hk | hk
        · simpa [hk] using hposi
        · simpa [hk] using hposq
        · simpa [hk] using hposp
      have hterm (k : Fin 3) (_hk : k ∈ Finset.univ) :
          0 ≤ w k * θ k (copy p c G) :=
        mul_nonneg (hw k).le (hposall k)
      have hple : w p * θ p (copy p c G) ≤
          ∑ k : Fin 3, w k * θ k (copy p c G) :=
        Finset.single_le_sum hterm (Finset.mem_univ p)
      have hRle : R (copy p c G) ≤ D :=
        (abs_le.mp (hrem3' i q p a b c hiq hip hqp)).2
      have hwp : w p * θ p (copy p c G) ≤ D := by
        calc
          w p * θ p (copy p c G) ≤
              ∑ k : Fin 3, w k * θ k (copy p c G) := hple
          _ = R (copy p c G) := by
            simpa [G] using htel3' q p a b c hiq hip hqp
          _ ≤ D := hRle
      apply (le_div_iff₀ (hw p)).2
      simpa [mul_comm] using hwp
    have h0 : θ p (copy p false G) ≤ D / w p := hleaf false
    have h1 : θ p (copy p true G) ≤ D / w p := hleaf true
    exact abs_le_of_sq_le_mul_of_nonneg_le
      (θ p G) (θ p (copy p false G)) (θ p (copy p true G)) (D / w p)
      (div_nonneg hD (hw p).le) (hpos' p true G hG) h0 h1 (hcs' p G hG)
  have hsecondChild (a b : Bool) (q p : Fin 3)
      (hiq : i ≠ q) (hip : i ≠ p) (hqp : q ≠ p) :
      θ q (copy q b (copy i a F)) ≤ 2 * D / w q := by
    let G : CubeVertex → E3 → ℝ := copy q b (copy i a F)
    have hG : P G := by
      dsimp [G]
      exact hPcopy' q b (copy i a F) (hPcopy' i a F hPF)
    have hfixi : copy i a G = G := by
      dsimp [G, copy]
      exact cubeCoordinateCopy_fixed_after_distinct hiq a b F
    have hposi : 0 ≤ θ i G := by
      rw [← hfixi]
      exact hpos' i a G hG
    have hpbound : |θ p G| ≤ D / w p := by
      simpa [G] using hthird a b q p hiq hip hqp
    have hprodabs : w p * |θ p G| ≤ D := by
      calc
        w p * |θ p G| ≤ w p * (D / w p) :=
          mul_le_mul_of_nonneg_left hpbound (hw p).le
        _ = D := mul_div_cancel₀ D (ne_of_gt (hw p))
    have htelG : ∑ k : Fin 3, w k * θ k G = R G := by
      simpa [G] using htel2' q a b hiq
    rw [sum_fin_three_eq_of_pairwise_distinct
      (fun k ↦ w k * θ k G) hiq hip hqp] at htelG
    have hRle : R G ≤ D := (abs_le.mp (hrem2' i q a b hiq)).2
    have hRabs : R G ≤ |R G| := le_abs_self _
    have hpabs : -θ p G ≤ |θ p G| := neg_le_abs _
    have hipos : 0 ≤ w i * θ i G := mul_nonneg (hw i).le hposi
    have hwpabs : -(w p * θ p G) ≤ w p * |θ p G| := by
      calc
        -(w p * θ p G) = w p * (-θ p G) := by ring
        _ ≤ w p * |θ p G| :=
          mul_le_mul_of_nonneg_left hpabs (hw p).le
    have hqred : w q * θ q G ≤ D + w p * |θ p G| := by
      linarith
    have hqprod : w q * θ q G ≤ 2 * D := by
      nlinarith
    apply (le_div_iff₀ (hw q)).2
    simpa [mul_comm] using hqprod
  have hsecond (a : Bool) (q p : Fin 3)
      (hiq : i ≠ q) (hip : i ≠ p) (hqp : q ≠ p) :
      |θ q (copy i a F)| ≤ 2 * D / w q := by
    have h0 : θ q (copy q false (copy i a F)) ≤ 2 * D / w q :=
      hsecondChild a false q p hiq hip hqp
    have h1 : θ q (copy q true (copy i a F)) ≤ 2 * D / w q :=
      hsecondChild a true q p hiq hip hqp
    have hPia : P (copy i a F) := hPcopy' i a F hPF
    exact abs_le_of_sq_le_mul_of_nonneg_le
      (θ q (copy i a F)) (θ q (copy q false (copy i a F)))
        (θ q (copy q true (copy i a F))) (2 * D / w q)
      (div_nonneg (mul_nonneg (by norm_num) hD) (hw q).le)
      (hpos' q true (copy i a F) hPia) h0 h1
      (hcs' q (copy i a F) hPia)
  have hfirstChild (a : Bool) : θ i (copy i a F) ≤ 5 * D / w i := by
    let G : CubeVertex → E3 → ℝ := copy i a F
    have hprod (q : Fin 3) (hq : q ∈ Finset.univ.erase i) :
        w q * |θ q G| ≤ 2 * D := by
      have hiq : i ≠ q := (Finset.mem_erase.mp hq).1.symm
      obtain ⟨p, hip, hqp⟩ := exists_third_coordinate i q hiq
      have hqbound : |θ q G| ≤ 2 * D / w q := by
        simpa [G] using hsecond a q p hiq hip.symm hqp.symm
      calc
        w q * |θ q G| ≤ w q * (2 * D / w q) :=
          mul_le_mul_of_nonneg_left hqbound (hw q).le
        _ = 2 * D := mul_div_cancel₀ (2 * D) (ne_of_gt (hw q))
    have hsumabs : (∑ q ∈ Finset.univ.erase i, w q * |θ q G|) ≤ 4 * D := by
      calc
        (∑ q ∈ Finset.univ.erase i, w q * |θ q G|) ≤ 2 * (2 * D) :=
          sum_erase_fin_three_le i (fun q ↦ w q * |θ q G|) (2 * D) hprod
        _ = 4 * D := by ring
    have htermneg : -(∑ q ∈ Finset.univ.erase i, w q * θ q G) ≤
        ∑ q ∈ Finset.univ.erase i, w q * |θ q G| := by
      rw [← Finset.sum_neg_distrib]
      apply Finset.sum_le_sum
      intro q hq
      calc
        -(w q * θ q G) = w q * (-θ q G) := by ring
        _ ≤ w q * |θ q G| :=
          mul_le_mul_of_nonneg_left (neg_le_abs _) (hw q).le
    have htelG : ∑ k : Fin 3, w k * θ k G = R G := by
      simpa [G] using htel1' a
    rw [sum_fin_three_split_erase (fun k ↦ w k * θ k G) i] at htelG
    have hRle : R G ≤ D := (abs_le.mp (hrem1' i a)).2
    have hRabs : R G ≤ |R G| := le_abs_self _
    have hred : w i * θ i G ≤
        D + ∑ q ∈ Finset.univ.erase i, w q * |θ q G| := by
      linarith
    have hiprod : w i * θ i G ≤ 5 * D := by
      nlinarith
    apply (le_div_iff₀ (hw i)).2
    simpa [mul_comm] using hiprod
  have h0 : θ i (copy i false F) ≤ 5 * D / w i := hfirstChild false
  have h1 : θ i (copy i true F) ≤ 5 * D / w i := hfirstChild true
  have hfinal : |θ i F| ≤ 5 * D / w i :=
    abs_le_of_sq_le_mul_of_nonneg_le
      (θ i F) (θ i (copy i false F)) (θ i (copy i true F)) (5 * D / w i)
      (div_nonneg (mul_nonneg (by norm_num) hD) (hw i).le)
      (hpos' i true F hPF) h0 h1 (hcs' i F hPF)
  simpa [θ, w] using hfinal

/-- The final finite-tree assembly from the bounded-continuous cubical
Cauchy--Schwarz and copied-form positivity conclusions. The constant is
uniform in the active coordinate, as required by `prop:cube_tree`. -/
theorem fullCubeTreeEstimate_of_boundedContinuousCubeCS
    (α : Anisotropy)
    (hcs : ∀ (S : BoxCollection α) (k : Fin 3) (lam r : ℝ)
      (G : CubeVertex → E3 → ℝ),
      (∀ j, Continuous (G j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |G j y| ≤ B) →
      1 ≤ lam →
      |localCubeForm α S k lam r G| ^ 2 ≤
        localCubeForm α S k lam r (cubeCoordinateCopy k false G) *
          localCubeForm α S k lam r (cubeCoordinateCopy k true G))
    (hpos : ∀ (S : BoxCollection α) (k : Fin 3) (lam r : ℝ)
      (b : Bool) (G : CubeVertex → E3 → ℝ),
      (∀ j, Continuous (G j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |G j y| ≤ B) →
      1 ≤ lam →
      0 ≤ localCubeForm α S k lam r (cubeCoordinateCopy k b G)) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α) (lam r : ℝ)
      (F : CubeVertex → E3 → ℝ) (i : Fin 3),
      (∀ j, Continuous (F j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B) →
      1 ≤ lam →
      |localCubeForm α T.boxes i lam r F| ≤
        C * lam ^ 37 * translationWeight r ^ 21 *
          (∏ j : CubeVertex, treeLocalSize T 4 (F j)) * boxMass α T.root := by
  rcases cubeTreeRemainder_bound_of_boundedContinuous α with
    ⟨C₀, hC₀, hrem⟩
  let W : ℝ := ∑ k : Fin 3, ((α.weight k : ℝ)⁻¹)
  have hW : 0 ≤ W := by
    dsimp [W]
    apply Finset.sum_nonneg
    intro k _
    exact inv_nonneg.mpr (by exact_mod_cast (α.weight_pos k).le)
  refine ⟨5 * C₀ * W, mul_nonneg (mul_nonneg (by norm_num) hC₀) hW, ?_⟩
  intro T lam r F i hFcont hFbound hlam
  let L : ℝ := lam ^ 37 * translationWeight r ^ 21 * boxMass α T.root
  let D : ℝ := C₀ * L
  have hlam0 : 0 ≤ lam := by linarith
  have hR0 : 0 ≤ translationWeight r := by
    unfold translationWeight
    positivity
  have hL : 0 ≤ L := by
    dsimp [L]
    exact mul_nonneg
      (mul_nonneg (pow_nonneg hlam0 _) (pow_nonneg hR0 _))
      (boxMass_pos α T.root).le
  have hD : 0 ≤ D := mul_nonneg hC₀ hL
  suffices hnormalized :
      |localCubeForm α T.boxes i lam r F| ≤
        (5 * C₀ * W * L) *
          (∏ j : CubeVertex, treeLocalSize T 4 (F j)) by
    calc
      |localCubeForm α T.boxes i lam r F| ≤
          (5 * C₀ * W * L) *
            (∏ j : CubeVertex, treeLocalSize T 4 (F j)) := hnormalized
      _ = (5 * C₀ * W) * lam ^ 37 * translationWeight r ^ 21 *
            (∏ j : CubeVertex, treeLocalSize T 4 (F j)) * boxMass α T.root := by
        dsimp [L]
        ring
  apply fullCubeTreeEstimate_of_normalized α T i lam r (5 * C₀ * W * L)
    F hFcont hFbound
  intro G hGcont hGbound hGunit
  have hcopyCont (k : Fin 3) (b : Bool)
      {H : CubeVertex → E3 → ℝ}
      (hHcont : ∀ j, Continuous (H j)) :
      ∀ j, Continuous (cubeCoordinateCopy k b H j) := by
    intro j
    exact hHcont (cubeVertexReplace k b j)
  have hcopyBound (k : Fin 3) (b : Bool)
      {H : CubeVertex → E3 → ℝ}
      (hHbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |H j y| ≤ B) :
      ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y,
        |cubeCoordinateCopy k b H j y| ≤ B := by
    intro j
    exact hHbound (cubeVertexReplace k b j)
  have hcopyUnit (k : Fin 3) (b : Bool)
      {H : CubeVertex → E3 → ℝ}
      (hHunit : ∀ j, treeLocalSize T 4 (H j) = 1) :
      ∀ j, treeLocalSize T 4 (cubeCoordinateCopy k b H j) = 1 :=
    cubeCoordinateCopy_preserves_treeLocalSize_one T H hHunit k b
  have hremUnit (H : CubeVertex → E3 → ℝ)
      (hHcont : ∀ j, Continuous (H j))
      (hHbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |H j y| ≤ B)
      (hHunit : ∀ j, treeLocalSize T 4 (H j) = 1) :
      |cubeTreeRemainder α T lam r H| ≤ D := by
    have hprod : (∏ j : CubeVertex, treeLocalSize T 4 (H j)) = 1 := by
      apply Finset.prod_eq_one
      intro j _
      exact hHunit j
    have h := hrem T lam r H hHcont hHbound hlam
    calc
      |cubeTreeRemainder α T lam r H| ≤
          C₀ * lam ^ 37 * translationWeight r ^ 21 * boxMass α T.root := by
        simpa [hprod] using h
      _ = D := by
        dsimp [D, L]
        ring
  have htel1 (a : Bool) :
      (∑ k : Fin 3, (α.weight k : ℝ) *
        localCubeForm α T.boxes k lam r (cubeCoordinateCopy i a G)) =
          cubeTreeRemainder α T lam r (cubeCoordinateCopy i a G) :=
    cubeTree_telescope_of_boundedContinuous α T lam r
      (cubeCoordinateCopy i a G) (hcopyCont i a hGcont)
      (hcopyBound i a hGbound) hlam
  have htel2 (q : Fin 3) (a b : Bool) (hiq : i ≠ q) :
      (∑ k : Fin 3, (α.weight k : ℝ) *
        localCubeForm α T.boxes k lam r
          (cubeCoordinateCopy q b (cubeCoordinateCopy i a G))) =
          cubeTreeRemainder α T lam r
            (cubeCoordinateCopy q b (cubeCoordinateCopy i a G)) :=
    cubeTree_telescope_of_boundedContinuous α T lam r
      (cubeCoordinateCopy q b (cubeCoordinateCopy i a G))
      (hcopyCont q b (hcopyCont i a hGcont))
      (hcopyBound q b (hcopyBound i a hGbound)) hlam
  have htel3 (q p : Fin 3) (a b c : Bool)
      (hiq : i ≠ q) (hip : i ≠ p) (hqp : q ≠ p) :
      (∑ k : Fin 3, (α.weight k : ℝ) *
        localCubeForm α T.boxes k lam r
          (cubeCoordinateCopy p c
            (cubeCoordinateCopy q b (cubeCoordinateCopy i a G)))) =
          cubeTreeRemainder α T lam r
            (cubeCoordinateCopy p c
              (cubeCoordinateCopy q b (cubeCoordinateCopy i a G))) :=
    cubeTree_telescope_of_boundedContinuous α T lam r
      (cubeCoordinateCopy p c (cubeCoordinateCopy q b
        (cubeCoordinateCopy i a G)))
      (hcopyCont p c (hcopyCont q b (hcopyCont i a hGcont)))
      (hcopyBound p c (hcopyBound q b (hcopyBound i a hGbound))) hlam
  have hrem1 (k : Fin 3) (b : Bool) :
      |cubeTreeRemainder α T lam r (cubeCoordinateCopy k b G)| ≤ D := by
    apply hremUnit
    · exact hcopyCont k b hGcont
    · exact hcopyBound k b hGbound
    · exact hcopyUnit k b hGunit
  have hrem2 (k q : Fin 3) (a b : Bool) (hkq : k ≠ q) :
      |cubeTreeRemainder α T lam r
        (cubeCoordinateCopy q b (cubeCoordinateCopy k a G))| ≤ D := by
    apply hremUnit
    · exact hcopyCont q b (hcopyCont k a hGcont)
    · exact hcopyBound q b (hcopyBound k a hGbound)
    · exact hcopyUnit q b (hcopyUnit k a hGunit)
  have hrem3 (k q p : Fin 3) (a b c : Bool)
      (hkq : k ≠ q) (hkp : k ≠ p) (hqp : q ≠ p) :
      |cubeTreeRemainder α T lam r
        (cubeCoordinateCopy p c
          (cubeCoordinateCopy q b (cubeCoordinateCopy k a G)))| ≤ D := by
    apply hremUnit
    · exact hcopyCont p c (hcopyCont q b (hcopyCont k a hGcont))
    · exact hcopyBound p c (hcopyBound q b (hcopyBound k a hGbound))
    · exact hcopyUnit p c (hcopyUnit q b (hcopyUnit k a hGunit))
  have hiter := cubeTree_cs_iteration_of_descendant_hypotheses
    α T lam r G i D hD
    (fun H ↦ (∀ j, Continuous (H j)) ∧
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |H j y| ≤ B))
    ⟨hGcont, hGbound⟩
    (fun k b H hH ↦ ⟨hcopyCont k b hH.1, hcopyBound k b hH.2⟩)
    (fun k H hH ↦ hcs T.boxes k lam r H hH.1 hH.2 hlam)
    (fun k b H hH ↦ hpos T.boxes k lam r b H hH.1 hH.2 hlam)
    htel1 htel2 htel3 hrem1 hrem2 hrem3
  have hwi : 0 < (α.weight i : ℝ) := by
    exact_mod_cast α.weight_pos i
  have hwiW : ((α.weight i : ℝ)⁻¹) ≤ W := by
    dsimp [W]
    simpa only using (Finset.single_le_sum (s := Finset.univ)
      (f := fun k : Fin 3 ↦ ((α.weight k : ℝ)⁻¹))
      (fun k _ ↦ inv_nonneg.mpr (by exact_mod_cast (α.weight_pos k).le))
      (Finset.mem_univ i))
  have hcoef : 0 ≤ 5 * C₀ * L :=
    mul_nonneg (mul_nonneg (by norm_num) hC₀) hL
  calc
    |localCubeForm α T.boxes i lam r G| ≤ 5 * D / (α.weight i : ℝ) := hiter
    _ = (5 * C₀ * L) * ((α.weight i : ℝ)⁻¹) := by
      rw [div_eq_mul_inv]
      dsimp [D]
      ring
    _ ≤ (5 * C₀ * L) * W :=
      mul_le_mul_of_nonneg_left hwiW hcoef
    _ = 5 * C₀ * W * L := by ring

/-- The full finite-tree cube estimate for bounded continuous inputs. This
is the direct formal counterpart of `prop:cube_tree`; its constant depends
only on the fixed anisotropy and is uniform over all three active directions. -/
theorem fullCubeTreeEstimate_of_boundedContinuous
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α) (lam r : ℝ)
      (F : CubeVertex → E3 → ℝ) (i : Fin 3),
      (∀ j, Continuous (F j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B) →
      1 ≤ lam →
      |localCubeForm α T.boxes i lam r F| ≤
        C * lam ^ 37 * translationWeight r ^ 21 *
          (∏ j : CubeVertex, treeLocalSize T 4 (F j)) * boxMass α T.root := by
  apply fullCubeTreeEstimate_of_boundedContinuousCubeCS α
  · intro S k lam r G hGcont hGbound hlam
    exact localCubeForm_cauchySchwarz α S k lam r G hGcont hGbound hlam
  · intro S k lam r b G hGcont hGbound hlam
    exact localCubeForm_coordinateCopy_nonneg α S k lam r G b
      hGcont hGbound hlam


/-- The edge tuple used in the Section 4 specialization: precisely the
vertices `000` and `001` carry `f`. Defining it through its first two bits
makes its invariance under the third-coordinate copies definitional. -/
noncomputable def edgeCubeTuple (f : E3 → ℝ) : CubeVertex → E3 → ℝ :=
  fun j ↦ if j 0 = false ∧ j 1 = false then f else fun _ ↦ 1

theorem edgeCubeTuple_at_000 (f : E3 → ℝ) :
    edgeCubeTuple f (cubePairVertex false false) = f := by
  funext x
  simp [edgeCubeTuple, cubePairVertex]

theorem edgeCubeTuple_at_001 (f : E3 → ℝ) :
    edgeCubeTuple f (cubePairVertex false true) = f := by
  funext x
  simp [edgeCubeTuple, cubePairVertex]

theorem edgeCubeTuple_at_other (f : E3 → ℝ) (j : CubeVertex)
    (hj : ¬ (j 0 = false ∧ j 1 = false)) :
    edgeCubeTuple f j = fun _ ↦ 1 := by
  funext x
  simp [edgeCubeTuple, hj]

/-- Copying the edge tuple in its active third coordinate leaves it fixed. -/
theorem cubeCoordinateCopy_two_edgeCubeTuple
    (f : E3 → ℝ) (b : Bool) :
    cubeCoordinateCopy 2 b (edgeCubeTuple f) = edgeCubeTuple f := by
  funext j x
  simp only [cubeCoordinateCopy, edgeCubeTuple]
  by_cases h0 : j 0 = false <;> by_cases h1 : j 1 = false <;>
    simp [cubeVertexReplace, h0, h1]

/-- The elementary continuity package for the two-active-slot edge tuple. -/
theorem continuous_edgeCubeTuple (f : E3 → ℝ) (hf : Continuous f) :
    ∀ j, Continuous (edgeCubeTuple f j) := by
  intro j
  by_cases hj : j 0 = false ∧ j 1 = false
  · simpa [edgeCubeTuple, hj] using hf
  · simpa [edgeCubeTuple, hj] using
      (continuous_const : Continuous (fun _ : E3 ↦ (1 : ℝ)))

/-- The elementary boundedness package for the two-active-slot edge tuple. -/
theorem bounded_edgeCubeTuple (f : E3 → ℝ)
    (hf : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) :
    ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |edgeCubeTuple f j y| ≤ B := by
  intro j
  rcases hf with ⟨B, hB, hfB⟩
  by_cases hj : j 0 = false ∧ j 1 = false
  · exact ⟨B, hB, by simpa [edgeCubeTuple, hj] using hfB⟩
  · refine ⟨1, zero_le_one, ?_⟩
    intro y
    simp [edgeCubeTuple, hj]

/-- The signed input product for the edge tuple has exactly its two source
factors; the other six slots are literal ones. -/
theorem cubeSignedInputProduct_edgeCubeTuple (f : E3 → ℝ) (x : E6) :
    cubeSignedInputProduct (edgeCubeTuple f) x =
      f (cubeProjection (cubePairVertex false false) x) *
        f (cubeProjection (cubePairVertex false true) x) := by
  have hactive : Finset.univ.filter (fun j : CubeVertex ↦
      j 0 = false ∧ j 1 = false) =
      {cubePairVertex false false, cubePairVertex false true} := by
    ext j
    simp only [Finset.mem_filter, Finset.mem_univ, true_and,
      Finset.mem_insert, Finset.mem_singleton]
    constructor
    · rintro ⟨h0, h1⟩
      have hj : j = cubePairVertex false (j 2) := by
        funext k
        fin_cases k <;> simp [cubePairVertex, h0, h1]
      rw [hj]
      cases j 2 <;> simp [cubePairVertex]
    · intro hj
      rcases hj with hj | hj
      · subst j
        simp [cubePairVertex]
      · subst j
        simp [cubePairVertex]
  rw [cubeSignedInputProduct]
  simp_rw [edgeCubeTuple]
  change (∏ j : CubeVertex,
    if j 0 = false ∧ j 1 = false then f (cubeProjection j x) else 1) = _
  rw [Finset.prod_ite]
  rw [hactive]
  simp [cubePairVertex]

/-- The unsigned cube input for the edge tuple retains the same two active
slots, now with absolute values. -/
theorem cubeInputProduct_edgeCubeTuple (f : E3 → ℝ) (x : E6) :
    cubeInputProduct (edgeCubeTuple f) x =
      |f (cubeProjection (cubePairVertex false false) x)| *
        |f (cubeProjection (cubePairVertex false true) x)| := by
  rw [← abs_cubeSignedInputProduct_eq_cubeInputProduct,
    cubeSignedInputProduct_edgeCubeTuple, abs_mul]

/-- The full positive cube bracket average for the edge tuple is exactly the
two-slot edge average with absolute-valued data. -/
theorem cubeBracketAverage_edgeCubeTuple_eq_edgeBracketAverage
    (α : Anisotropy) (t : ℝ) (p : E3) (f : E3 → ℝ) :
    cubeBracketAverage α t p (edgeCubeTuple f) =
      cubeEdgeBracketAverage α t p (fun y ↦ |f y|) (fun y ↦ |f y|) := by
  unfold cubeBracketAverage cubeEdgeBracketAverage
  apply integral_congr_ae
  filter_upwards [] with x
  rw [cubeInputProduct_edgeCubeTuple]

/-- A local form vanishes as soon as its fixed center--scale spatial
integral vanishes. This isolates the outer `dp dt/t` bookkeeping from the
one-dimensional cancellation used by the edge specialization. -/
theorem localCubeForm_eq_zero_of_spatial_zero
    (α : Anisotropy) (S : BoxCollection α) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ)
    (hzero : ∀ z : E3 × ℝ,
      (∫ x : E6, cubeSignedInputProduct F x *
        localCubeKernel α i lam r z.2 z.1 x) = 0) :
    localCubeForm α S i lam r F = 0 := by
  unfold localCubeForm
  apply integral_eq_zero_of_ae
  filter_upwards [] with z
  exact hzero z

/-- The exact outer-form interface for the first edge cancellation. Its
hypothesis is precisely the fixed-`(p,t)` Fubini conclusion obtained by
integrating the unused `x₁¹` derivative Gaussian. -/
theorem edge_localCubeForm_zero_zero_of_spatial_cancellation
    (α : Anisotropy) (S : BoxCollection α) (lam r : ℝ) (f : E3 → ℝ)
    (hzero : ∀ z : E3 × ℝ,
      (∫ x : E6, cubeSignedInputProduct (edgeCubeTuple f) x *
        localCubeKernel α 0 lam r z.2 z.1 x) = 0) :
    localCubeForm α S 0 lam r (edgeCubeTuple f) = 0 :=
  localCubeForm_eq_zero_of_spatial_zero α S 0 lam r
    (edgeCubeTuple f) hzero

/-- The exact outer-form interface for the second edge cancellation. Its
hypothesis is the corresponding Fubini conclusion for `x₂¹`. -/
theorem edge_localCubeForm_zero_one_of_spatial_cancellation
    (α : Anisotropy) (S : BoxCollection α) (lam r : ℝ) (f : E3 → ℝ)
    (hzero : ∀ z : E3 × ℝ,
      (∫ x : E6, cubeSignedInputProduct (edgeCubeTuple f) x *
        localCubeKernel α 1 lam r z.2 z.1 x) = 0) :
    localCubeForm α S 1 lam r (edgeCubeTuple f) = 0 :=
  localCubeForm_eq_zero_of_spatial_zero α S 1 lam r
    (edgeCubeTuple f) hzero

/-- The third-coordinate edge form is nonnegative once its Fubini square
representation is available. The equality uses the actual edge tuple;
`cubeCoordinateCopy_two_edgeCubeTuple` is the slot-level bridge to
the general cubical-copy positivity statement. -/
theorem edge_localCubeForm_two_nonneg_of_square
    (α : Anisotropy) (S : BoxCollection α) (lam r : ℝ) (f : E3 → ℝ)
    {X : Type*} [MeasurableSpace X] (μ : Measure X) (A : X → ℝ)
    (hsquare : localCubeForm α S 2 lam r (edgeCubeTuple f) =
      ∫ x, A x ^ 2 ∂μ) :
    0 ≤ localCubeForm α S 2 lam r (edgeCubeTuple f) := by
  rw [hsquare]
  exact integral_nonneg fun x ↦ sq_nonneg (A x)

/-- Slot-level conversion of copied-form positivity into positivity of the
edge form itself. This is the exact one-line consumer of the generic
cube-Cauchy--Schwarz positivity lemma. -/
theorem edge_localCubeForm_two_nonneg_of_copy
    (α : Anisotropy) (S : BoxCollection α) (lam r : ℝ) (f : E3 → ℝ)
    (b : Bool)
    (hcopy : 0 ≤ localCubeForm α S 2 lam r
      (cubeCoordinateCopy 2 b (edgeCubeTuple f))) :
    0 ≤ localCubeForm α S 2 lam r (edgeCubeTuple f) := by
  rw [cubeCoordinateCopy_two_edgeCubeTuple] at hcopy
  exact hcopy

/-- At a designated box center and scale, the edge second moment is exactly
the local power with exponent two. -/
theorem cubeSecondMoment_at_box_eq_boxLocalPower_two
    (α : Anisotropy) (q : AnisoBox α) (f : E3 → ℝ) :
    cubeSecondMoment α (boxLength q) (boxCenter α q) f =
      boxLocalPower α 2 f q := by
  unfold cubeSecondMoment boxLocalPower
  apply integral_congr_ae
  filter_upwards [] with y
  rw [← sq_abs]
  norm_num [Real.rpow_natCast]

/-- The square of the exponent-two local size recovers its local power. -/
theorem boxLocalSize_two_sq_eq_boxLocalPower
    (α : Anisotropy) (q : AnisoBox α) (f : E3 → ℝ) :
    boxLocalSize α 2 f q ^ 2 = boxLocalPower α 2 f q := by
  have hpower : 0 ≤ boxLocalPower α 2 f q := by
    unfold boxLocalPower
    apply integral_nonneg
    intro y
    exact mul_nonneg (Real.rpow_nonneg (abs_nonneg (f y)) _)
      (anisotropicBracketKernel_nonneg α (boxLength_pos q).le (boxCenter α q) y)
  unfold boxLocalSize
  exact Real.rpow_inv_natCast_pow hpower (by norm_num : (2 : ℕ) ≠ 0)

/-- Therefore the edge second moment at a tree box is the square of its
exponent-two local size. -/
theorem cubeSecondMoment_at_box_eq_boxLocalSize_two_sq
    (α : Anisotropy) (q : AnisoBox α) (f : E3 → ℝ) :
    cubeSecondMoment α (boxLength q) (boxCenter α q) f =
      boxLocalSize α 2 f q ^ 2 := by
  rw [cubeSecondMoment_at_box_eq_boxLocalPower_two]
  exact (boxLocalSize_two_sq_eq_boxLocalPower α q f).symm

/-- The exponent-two tree local size is nonnegative. -/
theorem treeLocalSize_two_nonneg
    (T : FiniteConvexTree α) (f : E3 → ℝ) :
    0 ≤ treeLocalSize T 2 f := by
  unfold treeLocalSize collectionLocalSize
  split_ifs with hT
  · rcases hT with ⟨q, hq⟩
    exact (show 0 ≤ boxLocalSize α 2 f q by
      unfold boxLocalSize boxLocalPower
      apply Real.rpow_nonneg
      apply integral_nonneg
      intro y
      exact mul_nonneg (Real.rpow_nonneg (abs_nonneg (f y)) _)
        (anisotropicBracketKernel_nonneg α (boxLength_pos q).le
          (boxCenter α q) y)).trans
      (Finset.le_sup' (boxLocalSize α 2 f) hq)
  · norm_num

/-- The edge second moment at a tree box is controlled by the square of the
exponent-two tree local size. -/
theorem cubeSecondMoment_at_box_le_treeLocalSize_two_sq
    {α : Anisotropy} (T : FiniteConvexTree α) {q : AnisoBox α}
    (hq : q ∈ T.boxes) (f : E3 → ℝ) :
    cubeSecondMoment α (boxLength q) (boxCenter α q) f ≤
      treeLocalSize T 2 f ^ 2 := by
  rw [cubeSecondMoment_at_box_eq_boxLocalSize_two_sq]
  apply pow_le_pow_left₀
  · unfold boxLocalSize boxLocalPower
    apply Real.rpow_nonneg
    apply integral_nonneg
    intro y
    exact mul_nonneg (Real.rpow_nonneg (abs_nonneg (f y)) _)
      (anisotropicBracketKernel_nonneg α (boxLength_pos q).le (boxCenter α q) y)
  · change boxLocalSize α 2 f q ≤ collectionLocalSize α T.boxes 2 f
    exact boxLocalSize_le_collectionLocalSize T.boxes hq 2 f

/-- Absolute values do not change the second moment. -/
theorem cubeSecondMoment_abs_eq
    (α : Anisotropy) (t : ℝ) (p : E3) (f : E3 → ℝ) :
    cubeSecondMoment α t p (fun y ↦ |f y|) = cubeSecondMoment α t p f := by
  unfold cubeSecondMoment
  apply integral_congr_ae
  filter_upwards [] with y
  rw [sq_abs]

/-- The positive edge bracket average with the same edge input twice is
bounded by its second moment. -/
theorem cubeEdgeBracketAverage_abs_self_le_secondMoment
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3) (f : E3 → ℝ)
    (hfmeas : Measurable f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) :
    cubeEdgeBracketAverage α t p (fun y ↦ |f y|) (fun y ↦ |f y|) ≤
      cubeSecondMoment α t p f := by
  rcases hfbound with ⟨B, hB, hfB⟩
  have habsmeas : Measurable (fun y ↦ |f y|) :=
    continuous_abs.measurable.comp hfmeas
  have habsnonneg : ∀ y, 0 ≤ |f y| := fun y ↦ abs_nonneg _
  have habsbound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f y| ≤ C :=
    ⟨B, hB, hfB⟩
  have hedge := cubeEdgeBracketAverage_le_product_secondMoments α ht p
    (fun y ↦ |f y|) (fun y ↦ |f y|) habsmeas habsmeas habsnonneg habsnonneg
    habsbound habsbound
  have hsecond : cubeSecondMoment α t p (fun y ↦ |f y|) =
      cubeSecondMoment α t p f := cubeSecondMoment_abs_eq α t p f
  have hnonneg : 0 ≤ cubeSecondMoment α t p f :=
    cubeSecondMoment_nonneg α ht.le p f
  calc
    cubeEdgeBracketAverage α t p (fun y ↦ |f y|) (fun y ↦ |f y|) ≤
        √(cubeSecondMoment α t p (fun y ↦ |f y|)) *
          √(cubeSecondMoment α t p (fun y ↦ |f y|)) := hedge
    _ = √(cubeSecondMoment α t p f) * √(cubeSecondMoment α t p f) := by
      rw [hsecond]
    _ = cubeSecondMoment α t p f := by
      rw [← sq, Real.sq_sqrt hnonneg]

/-- The three-coordinate comparison constant needed for second moments on a
closed box-scale cell. -/
noncomputable def edgeBoxScaleComparisonConstant (α : Anisotropy) : ℝ :=
  ∏ i : Fin 3, (2 : ℝ) ^ α.weight i * (3 / 2 : ℝ) ^ 10

theorem edgeBoxScaleComparisonConstant_nonneg (α : Anisotropy) :
    0 ≤ edgeBoxScaleComparisonConstant α := by
  unfold edgeBoxScaleComparisonConstant
  apply Finset.prod_nonneg
  intro i _
  positivity

/-- On a closed source cell, the threefold bracket kernel has the same
scale/center comparison as the sixfold kernel, with one factor per ambient
coordinate. -/
theorem anisotropicBracketKernel_le_boxCenterKernel
    (α : Anisotropy) (q : AnisoBox α) {p : E3} {t : ℝ}
    (hp : p ∈ boxClosedSet α q)
    (ht : 0 < t) (hlower : boxLength q / 2 ≤ t)
    (hupper : t ≤ boxLength q) (y : E3) :
    anisotropicBracketKernel α t p y ≤
      edgeBoxScaleComparisonConstant α *
        anisotropicBracketKernel α (boxLength q) (boxCenter α q) y := by
  have hfactor (i : Fin 3) :
      bracketKernelAt (t ^ α.weight i) (p i) (y i) ≤
        ((2 : ℝ) ^ α.weight i * (3 / 2 : ℝ) ^ 10) *
          bracketKernelAt (boxLength q ^ α.weight i) (boxCenter α q i) (y i) := by
    have hpow := pow_scale_bounds (boxLength_pos q) ht hlower hupper (α.weight i)
    have hcenter : |p i - boxCenter α q i| ≤ boxLength q ^ α.weight i / 2 := by
      simpa only [boxSide_eq_length_pow] using
        abs_sub_boxCenter_le_half_side α q hp i
    exact bracketKernelAt_le_of_scale_center
      (pow_pos ht _) (pow_pos (boxLength_pos q) _) hpow.1 hpow.2 hcenter
  unfold anisotropicBracketKernel edgeBoxScaleComparisonConstant
  calc
    (∏ i : Fin 3, bracketKernelAt (t ^ α.weight i) (p i) (y i)) ≤
        ∏ i : Fin 3,
          ((2 : ℝ) ^ α.weight i * (3 / 2 : ℝ) ^ 10) *
            bracketKernelAt (boxLength q ^ α.weight i)
              (boxCenter α q i) (y i) := by
      apply Finset.prod_le_prod₀
      · intro i _
        exact bracketKernelAt_nonneg (pow_pos ht _).le
      · intro i _
        exact hfactor i
    _ = (∏ i : Fin 3, (2 : ℝ) ^ α.weight i * (3 / 2 : ℝ) ^ 10) *
        ∏ i : Fin 3,
          bracketKernelAt (boxLength q ^ α.weight i)
            (boxCenter α q i) (y i) := by
      rw [Finset.prod_mul_distrib]

/-- Bounded continuous data have an integrable second-moment integrand at
every positive center-scale point. -/
theorem integrable_cubeSecondMoment_integrand
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) :
    Integrable (fun y ↦ f y ^ 2 * anisotropicBracketKernel α t p y) := by
  rcases hfbound with ⟨B, hB, hfB⟩
  have hmajor : Integrable (fun y ↦ B ^ 2 * anisotropicBracketKernel α t p y) := by
    simpa only [smul_eq_mul] using
      (integrable_anisotropicBracketKernel α ht p).const_mul (B ^ 2)
  have hmeas : AEStronglyMeasurable
      (fun y ↦ f y ^ 2 * anisotropicBracketKernel α t p y) volume :=
    ((hfcont.pow 2).mul (continuous_anisotropicBracketKernel α ht p)).aestronglyMeasurable
  refine hmajor.mono hmeas (Filter.Eventually.of_forall ?_)
  intro y
  have hkernel : 0 ≤ anisotropicBracketKernel α t p y :=
    anisotropicBracketKernel_nonneg α ht.le p y
  have hf2 : f y ^ 2 ≤ B ^ 2 := by
    rw [← sq_abs]
    exact pow_le_pow_left₀ (abs_nonneg _) (hfB y) 2
  have hleft : 0 ≤ f y ^ 2 * anisotropicBracketKernel α t p y :=
    mul_nonneg (sq_nonneg _) hkernel
  have hright : 0 ≤ B ^ 2 * anisotropicBracketKernel α t p y :=
    mul_nonneg (pow_nonneg hB _) hkernel
  simpa only [Real.norm_eq_abs, abs_of_nonneg hleft, abs_of_nonneg hright] using
    (mul_le_mul_of_nonneg_right hf2 hkernel)

/-- A second moment on a closed cell is controlled by the corresponding
second moment at that cell's designated box center and scale. -/
theorem cubeSecondMoment_le_boxCenterSecondMoment
    (α : Anisotropy) (q : AnisoBox α) {p : E3} {t : ℝ} (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B)
    (hp : p ∈ boxClosedSet α q)
    (ht : 0 < t) (hlower : boxLength q / 2 ≤ t)
    (hupper : t ≤ boxLength q) :
    cubeSecondMoment α t p f ≤
      edgeBoxScaleComparisonConstant α *
        cubeSecondMoment α (boxLength q) (boxCenter α q) f := by
  let C : ℝ := edgeBoxScaleComparisonConstant α
  let g : E3 → ℝ := fun y ↦ f y ^ 2 * anisotropicBracketKernel α t p y
  let h : E3 → ℝ := fun y ↦ C *
    (f y ^ 2 * anisotropicBracketKernel α (boxLength q) (boxCenter α q) y)
  have hg : Integrable g := by
    dsimp only [g]
    exact integrable_cubeSecondMoment_integrand α ht p f hfcont hfbound
  have hbase : Integrable (fun y ↦ f y ^ 2 *
      anisotropicBracketKernel α (boxLength q) (boxCenter α q) y) :=
    integrable_cubeSecondMoment_integrand α (boxLength_pos q)
      (boxCenter α q) f hfcont hfbound
  have hh : Integrable h := by
    simpa only [h, smul_eq_mul] using hbase.const_mul C
  have hpointwise (y : E3) : g y ≤ h y := by
    have hkernel := anisotropicBracketKernel_le_boxCenterKernel α q hp ht
      hlower hupper y
    have hf2 : 0 ≤ f y ^ 2 := sq_nonneg _
    change f y ^ 2 * anisotropicBracketKernel α t p y ≤
      C * (f y ^ 2 * anisotropicBracketKernel α (boxLength q) (boxCenter α q) y)
    calc
      f y ^ 2 * anisotropicBracketKernel α t p y ≤
          f y ^ 2 * (C * anisotropicBracketKernel α (boxLength q)
            (boxCenter α q) y) := mul_le_mul_of_nonneg_left hkernel hf2
      _ = C * (f y ^ 2 * anisotropicBracketKernel α (boxLength q)
            (boxCenter α q) y) := by ring
  calc
    cubeSecondMoment α t p f = ∫ y : E3, g y := by rfl
    _ ≤ ∫ y : E3, h y :=
      MeasureTheory.integral_mono_ae hg hh (Filter.Eventually.of_forall hpointwise)
    _ = C * cubeSecondMoment α (boxLength q) (boxCenter α q) f := by
      rw [show h = fun y : E3 ↦ C *
        (f y ^ 2 * anisotropicBracketKernel α (boxLength q) (boxCenter α q) y) by rfl,
        cubeSecondMoment, MeasureTheory.integral_const_mul]
    _ = _ := rfl

/-- The edge second moment is uniformly controlled on a tree region by the
square of the exponent-two tree local size. -/
theorem cubeSecondMoment_le_treeLocalSize_two_sq_of_mem_closure
    {α : Anisotropy} (T : FiniteConvexTree α) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B)
    {p : E3} {t : ℝ}
    (hpt : (p, t) ∈ closure (collectionRegion α T.boxes)) :
    cubeSecondMoment α t p f ≤
      edgeBoxScaleComparisonConstant α * treeLocalSize T 2 f ^ 2 := by
  rcases mem_closure_collectionRegion_exists_bounds α T.boxes hpt with
    ⟨q, hq, hp, hlower, hupper⟩
  have ht : 0 < t := by
    exact lt_of_lt_of_le (div_pos (boxLength_pos q) (by norm_num)) hlower
  have hcell := cubeSecondMoment_le_boxCenterSecondMoment α q f
    hfcont hfbound hp ht hlower hupper
  have hsize := cubeSecondMoment_at_box_le_treeLocalSize_two_sq T hq f
  exact hcell.trans (mul_le_mul_of_nonneg_left hsize
    (edgeBoxScaleComparisonConstant_nonneg α))

/-- The edge Brascamp--Lieb average is uniformly bounded on the closure of a
tree region by the square of the exponent-two tree local size. -/
theorem cubeEdgeBracketAverage_abs_self_le_treeLocalSize_two_sq_of_mem_closure
    {α : Anisotropy} (T : FiniteConvexTree α) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B)
    {p : E3} {t : ℝ}
    (hpt : (p, t) ∈ closure (collectionRegion α T.boxes)) :
    cubeEdgeBracketAverage α t p (fun y ↦ |f y|) (fun y ↦ |f y|) ≤
      edgeBoxScaleComparisonConstant α * treeLocalSize T 2 f ^ 2 := by
  have ht : 0 < t := pos_of_mem_closure_collectionRegion α T.boxes hpt
  have hedge := cubeEdgeBracketAverage_abs_self_le_secondMoment α ht p f
    hfcont.measurable hfbound
  have hsize := cubeSecondMoment_le_treeLocalSize_two_sq_of_mem_closure
    T f hfcont hfbound hpt
  exact hedge.trans hsize

/-- The ordinary positive cube bracket average of the edge tuple has the
same exponent-two tree-size bound. -/
theorem cubeBracketAverage_edgeCubeTuple_le_treeLocalSize_two_sq_of_mem_closure
    {α : Anisotropy} (T : FiniteConvexTree α) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B)
    {p : E3} {t : ℝ}
    (hpt : (p, t) ∈ closure (collectionRegion α T.boxes)) :
    cubeBracketAverage α t p (edgeCubeTuple f) ≤
      edgeBoxScaleComparisonConstant α * treeLocalSize T 2 f ^ 2 := by
  rw [cubeBracketAverage_edgeCubeTuple_eq_edgeBracketAverage]
  exact cubeEdgeBracketAverage_abs_self_le_treeLocalSize_two_sq_of_mem_closure
    T f hfcont hfbound hpt

/-- Uniform local-kernel estimate for the two-active-slot edge tuple, with
the exact `λ^36 R(r)^20` loss and the exponent-two tree size. -/
theorem abs_integral_localCubeKernel_edge_le_treeLocalSize_two_sq_of_mem_closure
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α) (i : Fin 3)
      (lam r t : ℝ) (p : E3) (f : E3 → ℝ),
      Continuous f →
      (∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) →
      1 ≤ lam →
      (p, t) ∈ closure (collectionRegion α T.boxes) →
      |∫ x : E6, cubeSignedInputProduct (edgeCubeTuple f) x *
        localCubeKernel α i lam r t p x| ≤
        C * lam ^ 36 * translationWeight r ^ 20 * treeLocalSize T 2 f ^ 2 := by
  rcases abs_integral_localCubeKernel_le_bracketAverage α with ⟨C, hC, hlocal⟩
  let S : ℝ := edgeBoxScaleComparisonConstant α
  refine ⟨C ^ 6 * S,
    mul_nonneg (pow_nonneg hC _) (edgeBoxScaleComparisonConstant_nonneg α), ?_⟩
  intro T i lam r t p f hfcont hfbound hlam hpt
  have ht : 0 < t := pos_of_mem_closure_collectionRegion α T.boxes hpt
  have hlocal' := hlocal i lam r t p (edgeCubeTuple f)
    (continuous_edgeCubeTuple f hfcont)
    (bounded_edgeCubeTuple f hfbound) hlam ht
  have hsize := cubeBracketAverage_edgeCubeTuple_le_treeLocalSize_two_sq_of_mem_closure
    T f hfcont hfbound hpt
  have hfac : 0 ≤ C ^ 6 * lam ^ 36 * translationWeight r ^ 20 := by
    have hlam0 : 0 ≤ lam := by linarith
    have hR : 0 ≤ translationWeight r := by
      unfold translationWeight
      positivity
    change 0 ≤ (C ^ (6 : ℕ) * lam ^ (36 : ℕ)) * translationWeight r ^ (20 : ℕ)
    exact mul_nonneg
      (mul_nonneg (pow_nonneg hC _) (pow_nonneg hlam0 _))
      (pow_nonneg hR _)
  calc
    |∫ x : E6, cubeSignedInputProduct (edgeCubeTuple f) x *
        localCubeKernel α i lam r t p x| ≤
        C ^ 6 * lam ^ 36 * translationWeight r ^ 20 *
          cubeBracketAverage α t p (edgeCubeTuple f) := hlocal'
    _ ≤ C ^ 6 * lam ^ 36 * translationWeight r ^ 20 *
        (S * treeLocalSize T 2 f ^ 2) :=
      mul_le_mul_of_nonneg_left hsize hfac
    _ = (C ^ 6 * S) * lam ^ 36 * translationWeight r ^ 20 *
        treeLocalSize T 2 f ^ 2 := by ring

/-- Uniform endpoint-kernel estimate for the edge tuple. -/
theorem abs_integral_cubeEndpointKernel_edge_le_treeLocalSize_two_sq_of_mem_closure
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α)
      (lam r t : ℝ) (p : E3) (f : E3 → ℝ),
      Continuous f →
      (∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) →
      1 ≤ lam →
      (p, t) ∈ closure (collectionRegion α T.boxes) →
      |∫ x : E6, cubeSignedInputProduct (edgeCubeTuple f) x *
        cubeEndpointKernel α lam r t p x| ≤
        C * lam ^ 36 * translationWeight r ^ 20 * treeLocalSize T 2 f ^ 2 := by
  rcases abs_integral_cubeEndpointKernel_le_bracketAverage α with ⟨C, hC, hendpoint⟩
  let S : ℝ := edgeBoxScaleComparisonConstant α
  refine ⟨C ^ 6 * S,
    mul_nonneg (pow_nonneg hC _) (edgeBoxScaleComparisonConstant_nonneg α), ?_⟩
  intro T lam r t p f hfcont hfbound hlam hpt
  have ht : 0 < t := pos_of_mem_closure_collectionRegion α T.boxes hpt
  have hendpoint' := hendpoint lam r t p (edgeCubeTuple f)
    (continuous_edgeCubeTuple f hfcont)
    (bounded_edgeCubeTuple f hfbound) hlam ht
  have hsize := cubeBracketAverage_edgeCubeTuple_le_treeLocalSize_two_sq_of_mem_closure
    T f hfcont hfbound hpt
  have hfac : 0 ≤ C ^ 6 * lam ^ 36 * translationWeight r ^ 20 := by
    have hlam0 : 0 ≤ lam := by linarith
    have hR : 0 ≤ translationWeight r := by
      unfold translationWeight
      positivity
    change 0 ≤ (C ^ (6 : ℕ) * lam ^ (36 : ℕ)) * translationWeight r ^ (20 : ℕ)
    exact mul_nonneg
      (mul_nonneg (pow_nonneg hC _) (pow_nonneg hlam0 _))
      (pow_nonneg hR _)
  calc
    |∫ x : E6, cubeSignedInputProduct (edgeCubeTuple f) x *
        cubeEndpointKernel α lam r t p x| ≤
        C ^ 6 * lam ^ 36 * translationWeight r ^ 20 *
          cubeBracketAverage α t p (edgeCubeTuple f) := hendpoint'
    _ ≤ C ^ 6 * lam ^ 36 * translationWeight r ^ 20 *
        (S * treeLocalSize T 2 f ^ 2) :=
      mul_le_mul_of_nonneg_left hsize hfac
    _ = (C ^ 6 * S) * lam ^ 36 * translationWeight r ^ 20 *
        treeLocalSize T 2 f ^ 2 := by ring

/-- Uniform face-kernel estimate for the edge tuple. -/
theorem abs_integral_cubeFaceKernel_edge_le_treeLocalSize_two_sq_of_mem_closure
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α) (i : Fin 3)
      (lam r t : ℝ) (p : E3) (f : E3 → ℝ),
      Continuous f →
      (∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) →
      1 ≤ lam →
      (p, t) ∈ closure (collectionRegion α T.boxes) →
      |∫ x : E6, cubeSignedInputProduct (edgeCubeTuple f) x *
        cubeFaceKernel α i lam r t p x| ≤
        C * lam ^ 37 * translationWeight r ^ 21 * treeLocalSize T 2 f ^ 2 := by
  rcases abs_integral_cubeFaceKernel_le_bracketAverage α with ⟨C, hC, hface⟩
  let S : ℝ := edgeBoxScaleComparisonConstant α
  refine ⟨C * S,
    mul_nonneg hC (edgeBoxScaleComparisonConstant_nonneg α), ?_⟩
  intro T i lam r t p f hfcont hfbound hlam hpt
  have ht : 0 < t := pos_of_mem_closure_collectionRegion α T.boxes hpt
  have hface' := hface i lam r t p (edgeCubeTuple f)
    (continuous_edgeCubeTuple f hfcont)
    (bounded_edgeCubeTuple f hfbound) hlam ht
  have hsize := cubeBracketAverage_edgeCubeTuple_le_treeLocalSize_two_sq_of_mem_closure
    T f hfcont hfbound hpt
  have hfac : 0 ≤ C * lam ^ 37 * translationWeight r ^ 21 := by
    have hlam0 : 0 ≤ lam := by linarith
    have hR : 0 ≤ translationWeight r := by
      unfold translationWeight
      positivity
    change 0 ≤ (C * lam ^ (37 : ℕ)) * translationWeight r ^ (21 : ℕ)
    exact mul_nonneg
      (mul_nonneg hC (pow_nonneg hlam0 _))
      (pow_nonneg hR _)
  calc
    |∫ x : E6, cubeSignedInputProduct (edgeCubeTuple f) x *
        cubeFaceKernel α i lam r t p x| ≤
        C * lam ^ 37 * translationWeight r ^ 21 *
          cubeBracketAverage α t p (edgeCubeTuple f) := hface'
    _ ≤ C * lam ^ 37 * translationWeight r ^ 21 *
        (S * treeLocalSize T 2 f ^ 2) :=
      mul_le_mul_of_nonneg_left hsize hfac
    _ = (C * S) * lam ^ 37 * translationWeight r ^ 21 *
        treeLocalSize T 2 f ^ 2 := by ring

/-- The finite-tree remainder estimate specialized to the two-slot edge
tuple. Its size is exactly `treeLocalSize T 2 f ^ 2`; no fourth-size
product remains. -/
theorem cubeTreeRemainder_edge_bound_of_boundedContinuous
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α) (lam r : ℝ)
      (f : E3 → ℝ),
      Continuous f →
      (∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) →
      1 ≤ lam →
      |cubeTreeRemainder α T lam r (edgeCubeTuple f)| ≤
        C * lam ^ 37 * translationWeight r ^ 21 *
          treeLocalSize T 2 f ^ 2 * boxMass α T.root := by
  rcases abs_integral_cubeEndpointKernel_edge_le_treeLocalSize_two_sq_of_mem_closure α
    with ⟨CE, hCE, hEndpoint⟩
  rcases abs_integral_cubeFaceKernel_edge_le_treeLocalSize_two_sq_of_mem_closure α
    with ⟨CF, hCF, hFace⟩
  refine ⟨2 * Real.pi * CE + 24 * Real.pi * CF, ?_, ?_⟩
  · exact add_nonneg
      (mul_nonneg (mul_nonneg (by norm_num) Real.pi_pos.le) hCE)
      (mul_nonneg (mul_nonneg (by norm_num) Real.pi_pos.le) hCF)
  · intro T lam r f hfcont hfbound hlam
    let M : ℝ := treeLocalSize T 2 f
    let DE : ℝ := CE * lam ^ 36 * translationWeight r ^ 20 * M ^ 2
    let DF : ℝ := CF * lam ^ 37 * translationWeight r ^ 21 * M ^ 2
    have hM : 0 ≤ M := by
      dsimp only [M]
      exact treeLocalSize_two_nonneg T f
    have hM2 : 0 ≤ M ^ 2 := pow_nonneg hM _
    have hlam0 : 0 ≤ lam := by linarith
    have hR0 : 0 ≤ translationWeight r := by
      unfold translationWeight
      positivity
    have hDF : 0 ≤ DF := by
      dsimp only [DF]
      exact mul_nonneg
        (mul_nonneg
          (mul_nonneg hCF (pow_nonneg hlam0 _))
          (pow_nonneg hR0 _)) hM2
    have hEdgeCont : ∀ j, Continuous (edgeCubeTuple f j) :=
      continuous_edgeCubeTuple f hfcont
    have hEdgeBound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y,
        |edgeCubeTuple f j y| ≤ B :=
      bounded_edgeCubeTuple f hfbound
    have hLeafInt : ∀ q ∈ treeLeaves T,
        IntegrableOn (cubeEndpointIntegrand α lam r (boxLength q)
          (edgeCubeTuple f)) (boxSet α q) := by
      intro q hq
      exact integrableOn_cubeEndpointIntegrand_boxSet α q lam r (boxLength q)
        (edgeCubeTuple f) hEdgeCont hEdgeBound hlam (boxLength_pos q)
    have hLeafBound : ∀ q ∈ treeLeaves T, ∀ p ∈ boxSet α q,
        |cubeEndpointIntegrand α lam r (boxLength q) (edgeCubeTuple f) p| ≤ DE := by
      intro q hq p hp
      change |∫ x : E6, cubeSignedInputProduct (edgeCubeTuple f) x *
        cubeEndpointKernel α lam r (boxLength q) p x| ≤ DE
      exact hEndpoint T lam r (boxLength q) p f hfcont hfbound hlam
        (mem_closure_collectionRegion_of_mem_leaf_boxSet_fullScale α T q hq hp)
    have hRootInt : IntegrableOn
        (cubeEndpointIntegrand α lam r (boxLength T.root) (edgeCubeTuple f))
        (boxSet α T.root) :=
      integrableOn_cubeEndpointIntegrand_boxSet α T.root lam r (boxLength T.root)
        (edgeCubeTuple f) hEdgeCont hEdgeBound hlam (boxLength_pos T.root)
    have hRootBound : ∀ p ∈ boxSet α T.root,
        |cubeEndpointIntegrand α lam r (boxLength T.root) (edgeCubeTuple f) p| ≤ DE := by
      intro p hp
      change |∫ x : E6, cubeSignedInputProduct (edgeCubeTuple f) x *
        cubeEndpointKernel α lam r (boxLength T.root) p x| ≤ DE
      exact hEndpoint T lam r (boxLength T.root) p f hfcont hfbound hlam
        (mem_closure_collectionRegion_of_mem_boxSet_fullScale α T T.root T.root_mem hp)
    have hFaceInt : ∀ (i : Fin 3) (S : OrientedFace α),
        S ∈ survivingFacesAll T i →
        IntegrableOn (fun t : ℝ ↦ t ^ (α.weight i - 1) *
          cubeFaceIntegral α i S lam r t (edgeCubeTuple f))
          (Set.Ioc (boxLength S.box / 2) (boxLength S.box)) := by
      intro i S hS
      simpa only using integrableOn_cubeFaceIntegral_scale α S.box i S.orientation
        lam r (edgeCubeTuple f) hEdgeCont hEdgeBound hlam
    have hFaceBound : ∀ (i : Fin 3) (S : OrientedFace α),
        S ∈ survivingFacesAll T i →
        ∀ t ∈ Set.Ioc (boxLength S.box / 2) (boxLength S.box),
          |cubeFaceIntegral α i S lam r t (edgeCubeTuple f)| ≤
            DF * transverseArea α S.box i := by
      intro i S hS t ht
      let g : TransverseSpace i → ℝ := fun y ↦ ∫ x : E6,
        cubeSignedInputProduct (edgeCubeTuple f) x *
          cubeFaceKernel α i lam r t
            (faceInsert i (boxFaceCoordinate α S.box i S.orientation) y) x
      have htpos : 0 < t := by
        exact lt_trans (div_pos (boxLength_pos S.box) (by norm_num)) ht.1
      have hg : IntegrableOn g (transverseRectangle α S.box i) := by
        dsimp only [g]
        exact integrable_cubeFaceKernel_face_outer α S.box i
          (boxFaceCoordinate α S.box i S.orientation) lam r t
          (edgeCubeTuple f) hEdgeCont hEdgeBound hlam htpos
      have hbox : S.box ∈ T.boxes := (mem_survivingFacesAll_iff T i S).mp hS |>.1
      have hgy : ∀ y ∈ transverseRectangle α S.box i, |g y| ≤ DF := by
        intro y hy
        dsimp only [g, DF]
        exact hFace T i lam r t
          (faceInsert i (boxFaceCoordinate α S.box i S.orientation) y) f
          hfcont hfbound hlam
          (mem_closure_collectionRegion_face α T.boxes S.box i S.orientation
            hbox hy (Set.Ioc_subset_Icc_self ht))
      simpa only [cubeFaceIntegral, g] using
        abs_integral_transverseRectangle_le_const_mul_area α S.box i g hg DF hgy
    have hrem := abs_cubeTreeRemainder_le_of_uniform_bounds α T lam r
      (edgeCubeTuple f) DE DF hDF
      hLeafInt hLeafBound hRootInt hRootBound hFaceInt hFaceBound
    have hlam36 : lam ^ 36 ≤ lam ^ 37 := by
      calc
        lam ^ 36 = lam ^ 36 * 1 := by ring
        _ ≤ lam ^ 36 * lam :=
          mul_le_mul_of_nonneg_left hlam (pow_nonneg hlam0 _)
        _ = lam ^ 37 := by ring
    have hRone : 1 ≤ translationWeight r := by
      unfold translationWeight
      linarith [abs_nonneg r]
    have hR20 : translationWeight r ^ 20 ≤ translationWeight r ^ 21 := by
      calc
        translationWeight r ^ 20 = translationWeight r ^ 20 * 1 := by ring
        _ ≤ translationWeight r ^ 20 * translationWeight r :=
          mul_le_mul_of_nonneg_left hRone (pow_nonneg hR0 _)
        _ = translationWeight r ^ 21 := by ring
    have hscale : lam ^ 36 * translationWeight r ^ 20 ≤
        lam ^ 37 * translationWeight r ^ 21 :=
      mul_le_mul hlam36 hR20 (pow_nonneg hR0 _) (pow_nonneg hlam0 _)
    have hDE : DE ≤ CE * lam ^ 37 * translationWeight r ^ 21 * M ^ 2 := by
      dsimp only [DE]
      calc
        CE * lam ^ 36 * translationWeight r ^ 20 * M ^ 2 =
            (CE * (lam ^ 36 * translationWeight r ^ 20)) * M ^ 2 := by ring
        _ ≤ (CE * (lam ^ 37 * translationWeight r ^ 21)) * M ^ 2 :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left hscale hCE) hM2
        _ = CE * lam ^ 37 * translationWeight r ^ 21 * M ^ 2 := by ring
    have hcoef : 0 ≤ 2 * Real.pi := by positivity
    have hterm : 2 * Real.pi * DE ≤
        2 * Real.pi * (CE * lam ^ 37 * translationWeight r ^ 21 * M ^ 2) :=
      mul_le_mul_of_nonneg_left hDE hcoef
    have hsum :
        2 * Real.pi * DE + 24 * Real.pi * DF ≤
          2 * Real.pi * (CE * lam ^ 37 * translationWeight r ^ 21 * M ^ 2) +
            24 * Real.pi * (CF * lam ^ 37 * translationWeight r ^ 21 * M ^ 2) := by
      apply add_le_add hterm
      exact le_rfl
    calc
      |cubeTreeRemainder α T lam r (edgeCubeTuple f)| ≤
          (2 * Real.pi * DE + 24 * Real.pi * DF) * boxMass α T.root := hrem
      _ ≤ (2 * Real.pi * (CE * lam ^ 37 * translationWeight r ^ 21 * M ^ 2) +
            24 * Real.pi * (CF * lam ^ 37 * translationWeight r ^ 21 * M ^ 2)) *
            boxMass α T.root :=
        mul_le_mul_of_nonneg_right hsum (boxMass_pos α T.root).le
      _ = (2 * Real.pi * CE + 24 * Real.pi * CF) * lam ^ 37 *
            translationWeight r ^ 21 * M ^ 2 * boxMass α T.root := by ring
      _ = (2 * Real.pi * CE + 24 * Real.pi * CF) * lam ^ 37 *
            translationWeight r ^ 21 * treeLocalSize T 2 f ^ 2 *
              boxMass α T.root := by rfl

/-- Once the first two edge coordinates cancel, the finite cube-tree
telescope retains exactly its third weighted local form. -/
theorem edge_weighted_localCubeForm_sum_eq_third
    (α : Anisotropy) (T : FiniteConvexTree α) (lam r : ℝ) (f : E3 → ℝ)
    (hzero0 : localCubeForm α T.boxes 0 lam r (edgeCubeTuple f) = 0)
    (hzero1 : localCubeForm α T.boxes 1 lam r (edgeCubeTuple f) = 0) :
    (∑ i : Fin 3, (α.weight i : ℝ) *
      localCubeForm α T.boxes i lam r (edgeCubeTuple f)) =
      (α.weight 2 : ℝ) * localCubeForm α T.boxes 2 lam r
        (edgeCubeTuple f) := by
  simp [Fin.sum_univ_succ, hzero0, hzero1]

/-- The complete finite-tree edge conclusion from the two one-dimensional
cancellations and third-coordinate positivity. The three analytic inputs
are stated separately so this theorem can consume the direct Fubini/square
identities without any further tree algebra. -/
theorem edgeTreeEstimate_of_cancellation_and_nonneg
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α) (lam r : ℝ)
      (f : E3 → ℝ),
      Continuous f →
      (∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) →
      1 ≤ lam →
      localCubeForm α T.boxes 0 lam r (edgeCubeTuple f) = 0 →
      localCubeForm α T.boxes 1 lam r (edgeCubeTuple f) = 0 →
      0 ≤ localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) →
      localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) ≤
        C * lam ^ 37 * translationWeight r ^ 21 *
          treeLocalSize T 2 f ^ 2 * boxMass α T.root := by
  rcases cubeTreeRemainder_edge_bound_of_boundedContinuous α with
    ⟨C, hC, hrem⟩
  let w : ℝ := (α.weight 2 : ℝ)
  have hw : 0 < w := by
    dsimp only [w]
    exact_mod_cast α.weight_pos 2
  refine ⟨C / w, div_nonneg hC hw.le, ?_⟩
  intro T lam r f hfcont hfbound hlam hzero0 hzero1 hnonneg
  have hEdgeCont : ∀ j, Continuous (edgeCubeTuple f j) :=
    continuous_edgeCubeTuple f hfcont
  have hEdgeBound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y,
      |edgeCubeTuple f j y| ≤ B :=
    bounded_edgeCubeTuple f hfbound
  have htel := cubeTree_telescope_of_boundedContinuous α T lam r
    (edgeCubeTuple f) hEdgeCont hEdgeBound hlam
  have hsum := edge_weighted_localCubeForm_sum_eq_third α T lam r f hzero0 hzero1
  have hweight : w * localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) =
      cubeTreeRemainder α T lam r (edgeCubeTuple f) := by
    simpa only [w] using hsum.symm.trans htel
  have hbound := hrem T lam r f hfcont hfbound hlam
  have hweighted : w * localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) ≤
      C * lam ^ 37 * translationWeight r ^ 21 * treeLocalSize T 2 f ^ 2 *
        boxMass α T.root := by
    rw [hweight]
    exact le_trans (le_abs_self _) hbound
  have hdiv : localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) ≤
      (C * lam ^ 37 * translationWeight r ^ 21 * treeLocalSize T 2 f ^ 2 *
        boxMass α T.root) / w := by
    apply (le_div_iff₀ hw).mpr
    simpa only [mul_comm] using hweighted
  calc
    localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) ≤
        (C * lam ^ 37 * translationWeight r ^ 21 * treeLocalSize T 2 f ^ 2 *
          boxMass α T.root) / w := hdiv
    _ = (C / w) * lam ^ 37 * translationWeight r ^ 21 *
          treeLocalSize T 2 f ^ 2 * boxMass α T.root := by field_simp

/-- Coordinates of the inverse false/true vertex split. This is the
concrete six-variable chart used to integrate an unused true coordinate. -/
theorem cubeFalseTrueSplit_symm_coordinate
    (y z : E3) (i : Fin 3) (b : Bool) :
    (cubeFalseTrueSplit.symm (y, z) : E6) (i, b) = if b then z i else y i := by
  cases b
  · have h := congrArg Prod.fst (cubeFalseTrueSplit.apply_symm_apply (y, z))
    rw [cubeFalseTrueSplit_apply] at h
    change cubeProjection (fun _ => false) (cubeFalseTrueSplit.symm (y, z)) = y at h
    simpa using (congrArg (fun w : E3 ↦ w i) h)
  · have h := congrArg Prod.snd (cubeFalseTrueSplit.apply_symm_apply (y, z))
    rw [cubeFalseTrueSplit_apply] at h
    change cubeProjection (fun _ => true) (cubeFalseTrueSplit.symm (y, z)) = z at h
    simpa using (congrArg (fun w : E3 ↦ w i) h)

/-- The mixed vertex `001` after the false/true split: the first two
coordinates come from the false vertex and the third from the true vertex. -/
noncomputable def edgeMixedProjection (y z : E3) : E3 :=
  WithLp.toLp 2 fun i ↦ if i = 2 then z 2 else y i

theorem cubeProjection_000_falseTrueSplit_symm (y z : E3) :
    cubeProjection (cubePairVertex false false) (cubeFalseTrueSplit.symm (y, z)) = y := by
  ext i
  fin_cases i <;>
    simp [cubePairVertex, cubeFalseTrueSplit_symm_coordinate]

theorem cubeProjection_001_falseTrueSplit_symm (y z : E3) :
    cubeProjection (cubePairVertex false true) (cubeFalseTrueSplit.symm (y, z)) =
      edgeMixedProjection y z := by
  ext i
  fin_cases i <;>
    simp [cubePairVertex, edgeMixedProjection,
      cubeFalseTrueSplit_symm_coordinate]

theorem cubeSignedInputProduct_edgeCubeTuple_falseTrueSplit_symm
    (f : E3 → ℝ) (y z : E3) :
    cubeSignedInputProduct (edgeCubeTuple f) (cubeFalseTrueSplit.symm (y, z)) =
      f y * f (edgeMixedProjection y z) := by
  rw [cubeSignedInputProduct_edgeCubeTuple,
    cubeProjection_000_falseTrueSplit_symm,
    cubeProjection_001_falseTrueSplit_symm]

/-- The first local cube kernel separates into its false and true vertex
factors in the false/true chart. -/
theorem localCubeKernel_zero_falseTrueSplit_symm
    (α : Anisotropy) (lam r t : ℝ) (p : E3) (y z : E3) :
    localCubeKernel α 0 lam r t p (cubeFalseTrueSplit.symm (y, z)) =
      (cubeGaussianDerivKernel α lam r t p 0 (y 0) *
        cubeGaussianKernel α lam r t p 1 (y 1) *
          cubeGaussianKernel α lam r t p 2 (y 2)) *
      (cubeGaussianDerivKernel α lam r t p 0 (z 0) *
        cubeGaussianKernel α lam r t p 1 (z 1) *
          cubeGaussianKernel α lam r t p 2 (z 2)) := by
  unfold localCubeKernel
  rw [Fintype.prod_prod_type]
  simp_rw [Fintype.prod_bool]
  simp [Fin.prod_univ_succ, cubeFalseTrueSplit_symm_coordinate]
  ring

/-- The second local cube kernel separates analogously. -/
theorem localCubeKernel_one_falseTrueSplit_symm
    (α : Anisotropy) (lam r t : ℝ) (p : E3) (y z : E3) :
    localCubeKernel α 1 lam r t p (cubeFalseTrueSplit.symm (y, z)) =
      (cubeGaussianKernel α lam r t p 0 (y 0) *
        cubeGaussianDerivKernel α lam r t p 1 (y 1) *
          cubeGaussianKernel α lam r t p 2 (y 2)) *
      (cubeGaussianKernel α lam r t p 0 (z 0) *
        cubeGaussianDerivKernel α lam r t p 1 (z 1) *
          cubeGaussianKernel α lam r t p 2 (z 2)) := by
  unfold localCubeKernel
  rw [Fintype.prod_prod_type]
  simp_rw [Fintype.prod_bool]
  simp [Fin.prod_univ_succ, cubeFalseTrueSplit_symm_coordinate]
  ring

/-- In the `x₁` coordinate split, the edge mixed projection is independent
of the active scalar coordinate. -/
theorem edgeMixedProjection_coordinateJoin_zero_independent
    (y : E3) (v : ℝ) (w : TransverseSpace 0) :
    edgeMixedProjection y (coordinateJoin 0 (v, w)) =
      edgeMixedProjection y (coordinateJoin 0 (0, w)) := by
  ext i
  fin_cases i <;>
    simp [edgeMixedProjection, coordinateJoin, faceInsert]

/-- The passive true-vertex kernel factors for the first cancellation are
independent of its active scalar coordinate. -/
theorem truePassiveKernel_zero_coordinateJoin_independent
    (α : Anisotropy) (lam r t : ℝ) (p : E3) (v : ℝ)
    (w : TransverseSpace 0) :
    cubeGaussianKernel α lam r t p 1 (coordinateJoin 0 (v, w) 1) *
      cubeGaussianKernel α lam r t p 2 (coordinateJoin 0 (v, w) 2) =
    cubeGaussianKernel α lam r t p 1 (coordinateJoin 0 (0, w) 1) *
      cubeGaussianKernel α lam r t p 2 (coordinateJoin 0 (0, w) 2) := by
  simp [coordinateJoin, faceInsert]

/-- In the `x₂` coordinate split, the edge mixed projection is likewise
independent of the active scalar coordinate. -/
theorem edgeMixedProjection_coordinateJoin_one_independent
    (y : E3) (v : ℝ) (w : TransverseSpace 1) :
    edgeMixedProjection y (coordinateJoin 1 (v, w)) =
      edgeMixedProjection y (coordinateJoin 1 (0, w)) := by
  ext i
  fin_cases i <;>
    simp [edgeMixedProjection, coordinateJoin, faceInsert]

/-- The passive true-vertex kernel factors for the second cancellation are
independent of its active scalar coordinate. -/
theorem truePassiveKernel_one_coordinateJoin_independent
    (α : Anisotropy) (lam r t : ℝ) (p : E3) (v : ℝ)
    (w : TransverseSpace 1) :
    cubeGaussianKernel α lam r t p 0 (coordinateJoin 1 (v, w) 0) *
      cubeGaussianKernel α lam r t p 2 (coordinateJoin 1 (v, w) 2) =
    cubeGaussianKernel α lam r t p 0 (coordinateJoin 1 (0, w) 0) *
      cubeGaussianKernel α lam r t p 2 (coordinateJoin 1 (0, w) 2) := by
  simp [coordinateJoin, faceInsert]

/-- Pointwise factorization used to integrate the unused true `x₁`
derivative factor first. -/
theorem edge_trueIntegrand_zero_factorization
    (α : Anisotropy) (lam r t : ℝ) (p : E3) (f : E3 → ℝ)
    (y : E3) (v : ℝ) (w : TransverseSpace 0) :
    f y * f (edgeMixedProjection y (coordinateJoin 0 (v, w))) *
        (cubeGaussianDerivKernel α lam r t p 0 (y 0) *
          cubeGaussianKernel α lam r t p 1 (y 1) *
            cubeGaussianKernel α lam r t p 2 (y 2)) *
        (cubeGaussianDerivKernel α lam r t p 0 (coordinateJoin 0 (v, w) 0) *
          cubeGaussianKernel α lam r t p 1 (coordinateJoin 0 (v, w) 1) *
            cubeGaussianKernel α lam r t p 2 (coordinateJoin 0 (v, w) 2)) =
      cubeGaussianDerivKernel α lam r t p 0 v *
        (f y * f (edgeMixedProjection y (coordinateJoin 0 (0, w))) *
          (cubeGaussianDerivKernel α lam r t p 0 (y 0) *
            cubeGaussianKernel α lam r t p 1 (y 1) *
              cubeGaussianKernel α lam r t p 2 (y 2)) *
          (cubeGaussianKernel α lam r t p 1 (coordinateJoin 0 (0, w) 1) *
            cubeGaussianKernel α lam r t p 2 (coordinateJoin 0 (0, w) 2))) := by
  rw [edgeMixedProjection_coordinateJoin_zero_independent]
  simp [coordinateJoin, faceInsert]
  ring

/-- Fubini cancellation of the unused true `x₁` derivative factor at fixed
false vertex `y`. -/
theorem integral_edge_true_factor_zero_zero
    (α : Anisotropy) (lam r t : ℝ) (p : E3) (f : E3 → ℝ)
    (hlam : 1 ≤ lam) (ht : 0 < t) (y : E3) :
    (∫ z : E3,
      f y * f (edgeMixedProjection y z) *
        (cubeGaussianDerivKernel α lam r t p 0 (y 0) *
          cubeGaussianKernel α lam r t p 1 (y 1) *
            cubeGaussianKernel α lam r t p 2 (y 2)) *
        (cubeGaussianDerivKernel α lam r t p 0 (z 0) *
          cubeGaussianKernel α lam r t p 1 (z 1) *
            cubeGaussianKernel α lam r t p 2 (z 2))) = 0 := by
  let A : ℝ → ℝ := fun v ↦ cubeGaussianDerivKernel α lam r t p 0 v
  let B : TransverseSpace 0 → ℝ := fun w ↦
    f y * f (edgeMixedProjection y (coordinateJoin 0 (0, w))) *
      (cubeGaussianDerivKernel α lam r t p 0 (y 0) *
        cubeGaussianKernel α lam r t p 1 (y 1) *
          cubeGaussianKernel α lam r t p 2 (y 2)) *
      (cubeGaussianKernel α lam r t p 1 (coordinateJoin 0 (0, w) 1) *
        cubeGaussianKernel α lam r t p 2 (coordinateJoin 0 (0, w) 2))
  let K : ℝ × TransverseSpace 0 → ℝ := fun vw ↦ A vw.1 * B vw.2
  have hpoint (z : E3) :
      f y * f (edgeMixedProjection y z) *
          (cubeGaussianDerivKernel α lam r t p 0 (y 0) *
            cubeGaussianKernel α lam r t p 1 (y 1) *
              cubeGaussianKernel α lam r t p 2 (y 2)) *
          (cubeGaussianDerivKernel α lam r t p 0 (z 0) *
            cubeGaussianKernel α lam r t p 1 (z 1) *
              cubeGaussianKernel α lam r t p 2 (z 2)) =
        K (coordinateSplit 0 z) := by
    have hz : z = coordinateJoin 0 (coordinateSplit 0 z) :=
      (coordinateJoin_split 0 z).symm
    rw [hz]
    simp only [coordinateSplit_join]
    dsimp only [K, A, B]
    exact edge_trueIntegrand_zero_factorization α lam r t p f y
      (coordinateSplit 0 z).1 (coordinateSplit 0 z).2
  have hA : ∫ v : ℝ, A v = 0 := by
    dsimp only [A, cubeGaussianDerivKernel]
    exact integral_gaussianDerivAt (cubeGaussianScale_pos α 0 hlam ht) _
  calc
    (∫ z : E3,
      f y * f (edgeMixedProjection y z) *
        (cubeGaussianDerivKernel α lam r t p 0 (y 0) *
          cubeGaussianKernel α lam r t p 1 (y 1) *
            cubeGaussianKernel α lam r t p 2 (y 2)) *
        (cubeGaussianDerivKernel α lam r t p 0 (z 0) *
          cubeGaussianKernel α lam r t p 1 (z 1) *
            cubeGaussianKernel α lam r t p 2 (z 2))) =
        ∫ z : E3, K (coordinateSplit 0 z) := by
          apply integral_congr_ae
          filter_upwards [] with z
          exact hpoint z
    _ = ∫ vw : ℝ × TransverseSpace 0, K vw := by
      calc
        (∫ z : E3, K (coordinateSplit 0 z)) =
            ∫ vw : ℝ × TransverseSpace 0, K vw ∂Measure.map (coordinateSplit 0) volume := by
              exact (integral_map_equiv (coordinateSplitEquiv 0) K).symm
        _ = ∫ vw : ℝ × TransverseSpace 0, K vw := by
              rw [(coordinateSplit_measurePreserving 0).map_eq]
    _ = (∫ v : ℝ, A v) * ∫ w : TransverseSpace 0, B w := by
      change (∫ vw : ℝ × TransverseSpace 0, A vw.1 * B vw.2) = _
      exact integral_prod_mul A B
    _ = 0 := by rw [hA, zero_mul]

/-- Pointwise factorization used to integrate the unused true `x₂`
derivative factor first. -/
theorem edge_trueIntegrand_one_factorization
    (α : Anisotropy) (lam r t : ℝ) (p : E3) (f : E3 → ℝ)
    (y : E3) (v : ℝ) (w : TransverseSpace 1) :
    f y * f (edgeMixedProjection y (coordinateJoin 1 (v, w))) *
        (cubeGaussianKernel α lam r t p 0 (y 0) *
          cubeGaussianDerivKernel α lam r t p 1 (y 1) *
            cubeGaussianKernel α lam r t p 2 (y 2)) *
        (cubeGaussianKernel α lam r t p 0 (coordinateJoin 1 (v, w) 0) *
          cubeGaussianDerivKernel α lam r t p 1 (coordinateJoin 1 (v, w) 1) *
            cubeGaussianKernel α lam r t p 2 (coordinateJoin 1 (v, w) 2)) =
      cubeGaussianDerivKernel α lam r t p 1 v *
        (f y * f (edgeMixedProjection y (coordinateJoin 1 (0, w))) *
          (cubeGaussianKernel α lam r t p 0 (y 0) *
            cubeGaussianDerivKernel α lam r t p 1 (y 1) *
              cubeGaussianKernel α lam r t p 2 (y 2)) *
          (cubeGaussianKernel α lam r t p 0 (coordinateJoin 1 (0, w) 0) *
            cubeGaussianKernel α lam r t p 2 (coordinateJoin 1 (0, w) 2))) := by
  rw [edgeMixedProjection_coordinateJoin_one_independent]
  simp [coordinateJoin, faceInsert]
  ring

/-- Fubini cancellation of the unused true `x₂` derivative factor at fixed
false vertex `y`. -/
theorem integral_edge_true_factor_zero_one
    (α : Anisotropy) (lam r t : ℝ) (p : E3) (f : E3 → ℝ)
    (hlam : 1 ≤ lam) (ht : 0 < t) (y : E3) :
    (∫ z : E3,
      f y * f (edgeMixedProjection y z) *
        (cubeGaussianKernel α lam r t p 0 (y 0) *
          cubeGaussianDerivKernel α lam r t p 1 (y 1) *
            cubeGaussianKernel α lam r t p 2 (y 2)) *
        (cubeGaussianKernel α lam r t p 0 (z 0) *
          cubeGaussianDerivKernel α lam r t p 1 (z 1) *
            cubeGaussianKernel α lam r t p 2 (z 2))) = 0 := by
  let A : ℝ → ℝ := fun v ↦ cubeGaussianDerivKernel α lam r t p 1 v
  let B : TransverseSpace 1 → ℝ := fun w ↦
    f y * f (edgeMixedProjection y (coordinateJoin 1 (0, w))) *
      (cubeGaussianKernel α lam r t p 0 (y 0) *
        cubeGaussianDerivKernel α lam r t p 1 (y 1) *
          cubeGaussianKernel α lam r t p 2 (y 2)) *
      (cubeGaussianKernel α lam r t p 0 (coordinateJoin 1 (0, w) 0) *
        cubeGaussianKernel α lam r t p 2 (coordinateJoin 1 (0, w) 2))
  let K : ℝ × TransverseSpace 1 → ℝ := fun vw ↦ A vw.1 * B vw.2
  have hpoint (z : E3) :
      f y * f (edgeMixedProjection y z) *
          (cubeGaussianKernel α lam r t p 0 (y 0) *
            cubeGaussianDerivKernel α lam r t p 1 (y 1) *
              cubeGaussianKernel α lam r t p 2 (y 2)) *
          (cubeGaussianKernel α lam r t p 0 (z 0) *
            cubeGaussianDerivKernel α lam r t p 1 (z 1) *
              cubeGaussianKernel α lam r t p 2 (z 2)) =
        K (coordinateSplit 1 z) := by
    have hz : z = coordinateJoin 1 (coordinateSplit 1 z) :=
      (coordinateJoin_split 1 z).symm
    rw [hz]
    simp only [coordinateSplit_join]
    dsimp only [K, A, B]
    exact edge_trueIntegrand_one_factorization α lam r t p f y
      (coordinateSplit 1 z).1 (coordinateSplit 1 z).2
  have hA : ∫ v : ℝ, A v = 0 := by
    dsimp only [A, cubeGaussianDerivKernel]
    exact integral_gaussianDerivAt (cubeGaussianScale_pos α 1 hlam ht) _
  calc
    (∫ z : E3,
      f y * f (edgeMixedProjection y z) *
        (cubeGaussianKernel α lam r t p 0 (y 0) *
          cubeGaussianDerivKernel α lam r t p 1 (y 1) *
            cubeGaussianKernel α lam r t p 2 (y 2)) *
        (cubeGaussianKernel α lam r t p 0 (z 0) *
          cubeGaussianDerivKernel α lam r t p 1 (z 1) *
            cubeGaussianKernel α lam r t p 2 (z 2))) =
        ∫ z : E3, K (coordinateSplit 1 z) := by
          apply integral_congr_ae
          filter_upwards [] with z
          exact hpoint z
    _ = ∫ vw : ℝ × TransverseSpace 1, K vw := by
      calc
        (∫ z : E3, K (coordinateSplit 1 z)) =
            ∫ vw : ℝ × TransverseSpace 1, K vw ∂Measure.map (coordinateSplit 1) volume := by
              exact (integral_map_equiv (coordinateSplitEquiv 1) K).symm
        _ = ∫ vw : ℝ × TransverseSpace 1, K vw := by
              rw [(coordinateSplit_measurePreserving 1).map_eq]
    _ = (∫ v : ℝ, A v) * ∫ w : TransverseSpace 1, B w := by
      change (∫ vw : ℝ × TransverseSpace 1, A vw.1 * B vw.2) = _
      exact integral_prod_mul A B
    _ = 0 := by rw [hA, zero_mul]

/-- The first edge local kernel has zero spatial integral at every positive
scale and center: after the false/true vertex split its unused true `x₁`
derivative has integral zero. -/
theorem spatial_integral_edge_zero_zero
    (α : Anisotropy) (lam r t : ℝ) (p : E3) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    (∫ x : E6,
      cubeSignedInputProduct (edgeCubeTuple f) x *
        localCubeKernel α 0 lam r t p x) = 0 := by
  let H : E6 → ℝ := fun x ↦
    cubeSignedInputProduct (edgeCubeTuple f) x *
      localCubeKernel α 0 lam r t p x
  let G : E3 × E3 → ℝ := fun yz ↦
    f yz.1 * f (edgeMixedProjection yz.1 yz.2) *
      (cubeGaussianDerivKernel α lam r t p 0 (yz.1 0) *
        cubeGaussianKernel α lam r t p 1 (yz.1 1) *
          cubeGaussianKernel α lam r t p 2 (yz.1 2)) *
      (cubeGaussianDerivKernel α lam r t p 0 (yz.2 0) *
        cubeGaussianKernel α lam r t p 1 (yz.2 1) *
          cubeGaussianKernel α lam r t p 2 (yz.2 2))
  have hFcont : ∀ j, Continuous (edgeCubeTuple f j) :=
    continuous_edgeCubeTuple f hfcont
  have hFbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y,
      |edgeCubeTuple f j y| ≤ B :=
    bounded_edgeCubeTuple f hfbound
  have hH : Integrable H := by
    dsimp only [H]
    exact integrable_cubeSignedInputProduct_mul_localCubeKernel
      α 0 lam r t p (edgeCubeTuple f) hFcont hFbound hlam ht
  have hinv : MeasurePreserving cubeFalseTrueSplit.symm
      (volume : Measure (E3 × E3)) volume :=
    cubeFalseTrueSplit_measurePreserving.symm
  have hGcomp : Integrable (H ∘ cubeFalseTrueSplit.symm) :=
    hinv.integrable_comp_of_integrable hH
  have hpoint (yz : E3 × E3) :
      H (cubeFalseTrueSplit.symm yz) = G yz := by
    rcases yz with ⟨y, z⟩
    dsimp only [H, G]
    rw [cubeSignedInputProduct_edgeCubeTuple_falseTrueSplit_symm,
      localCubeKernel_zero_falseTrueSplit_symm]
    ring
  have hG : Integrable G :=
    hGcomp.congr (Filter.Eventually.of_forall hpoint)
  have hinner (y : E3) : (∫ z : E3, G (y, z)) = 0 := by
    dsimp only [G]
    exact integral_edge_true_factor_zero_zero α lam r t p f hlam ht y
  change (∫ x : E6, H x) = 0
  calc
    (∫ x : E6, H x) = ∫ yz : E3 × E3, H (cubeFalseTrueSplit.symm yz) :=
      hinv.integral_comp' H |>.symm
    _ = ∫ yz : E3 × E3, G yz := by
      apply integral_congr_ae
      filter_upwards [] with yz
      exact hpoint yz
    _ = ∫ y : E3, ∫ z : E3, G (y, z) := integral_prod G hG
    _ = ∫ y : E3, 0 := by
      apply integral_congr_ae
      filter_upwards [] with y
      exact hinner y
    _ = 0 := by simp

/-- The second edge local kernel has zero spatial integral at every positive
scale and center: after the false/true vertex split its unused true `x₂`
derivative has integral zero. -/
theorem spatial_integral_edge_zero_one
    (α : Anisotropy) (lam r t : ℝ) (p : E3) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    (∫ x : E6,
      cubeSignedInputProduct (edgeCubeTuple f) x *
        localCubeKernel α 1 lam r t p x) = 0 := by
  let H : E6 → ℝ := fun x ↦
    cubeSignedInputProduct (edgeCubeTuple f) x *
      localCubeKernel α 1 lam r t p x
  let G : E3 × E3 → ℝ := fun yz ↦
    f yz.1 * f (edgeMixedProjection yz.1 yz.2) *
      (cubeGaussianKernel α lam r t p 0 (yz.1 0) *
        cubeGaussianDerivKernel α lam r t p 1 (yz.1 1) *
          cubeGaussianKernel α lam r t p 2 (yz.1 2)) *
      (cubeGaussianKernel α lam r t p 0 (yz.2 0) *
        cubeGaussianDerivKernel α lam r t p 1 (yz.2 1) *
          cubeGaussianKernel α lam r t p 2 (yz.2 2))
  have hFcont : ∀ j, Continuous (edgeCubeTuple f j) :=
    continuous_edgeCubeTuple f hfcont
  have hFbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y,
      |edgeCubeTuple f j y| ≤ B :=
    bounded_edgeCubeTuple f hfbound
  have hH : Integrable H := by
    dsimp only [H]
    exact integrable_cubeSignedInputProduct_mul_localCubeKernel
      α 1 lam r t p (edgeCubeTuple f) hFcont hFbound hlam ht
  have hinv : MeasurePreserving cubeFalseTrueSplit.symm
      (volume : Measure (E3 × E3)) volume :=
    cubeFalseTrueSplit_measurePreserving.symm
  have hGcomp : Integrable (H ∘ cubeFalseTrueSplit.symm) :=
    hinv.integrable_comp_of_integrable hH
  have hpoint (yz : E3 × E3) :
      H (cubeFalseTrueSplit.symm yz) = G yz := by
    rcases yz with ⟨y, z⟩
    dsimp only [H, G]
    rw [cubeSignedInputProduct_edgeCubeTuple_falseTrueSplit_symm,
      localCubeKernel_one_falseTrueSplit_symm]
    ring
  have hG : Integrable G :=
    hGcomp.congr (Filter.Eventually.of_forall hpoint)
  have hinner (y : E3) : (∫ z : E3, G (y, z)) = 0 := by
    dsimp only [G]
    exact integral_edge_true_factor_zero_one α lam r t p f hlam ht y
  change (∫ x : E6, H x) = 0
  calc
    (∫ x : E6, H x) = ∫ yz : E3 × E3, H (cubeFalseTrueSplit.symm yz) :=
      hinv.integral_comp' H |>.symm
    _ = ∫ yz : E3 × E3, G yz := by
      apply integral_congr_ae
      filter_upwards [] with yz
      exact hpoint yz
    _ = ∫ y : E3, ∫ z : E3, G (y, z) := integral_prod G hG
    _ = ∫ y : E3, 0 := by
      apply integral_congr_ae
      filter_upwards [] with y
      exact hinner y
    _ = 0 := by simp

/-- The local form vanishes when its fixed center--scale spatial integrand
vanishes almost everywhere on the collection region. -/
theorem localCubeForm_eq_zero_of_spatial_zero_ae
    (α : Anisotropy) (S : BoxCollection α) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ)
    (hzero : ∀ᵐ z ∂(cubeScaleMeasure.restrict (collectionRegion α S)),
      (∫ x : E6, cubeSignedInputProduct F x *
        localCubeKernel α i lam r z.2 z.1 x) = 0) :
    localCubeForm α S i lam r F = 0 := by
  unfold localCubeForm
  exact integral_eq_zero_of_ae hzero

/-- Every literal center--scale point in a finite collection has positive
scale. -/
theorem pos_of_mem_collectionRegion
    (α : Anisotropy) (S : BoxCollection α) {z : E3 × ℝ}
    (hz : z ∈ collectionRegion α S) : 0 < z.2 := by
  rw [collectionRegion] at hz
  rcases Set.mem_iUnion₂.mp hz with ⟨q, hq, hzq⟩
  change z.1 ∈ boxSet α q ∧ z.2 ∈ boxScaleBand q at hzq
  exact lt_trans (div_pos (boxLength_pos q) (by norm_num)) hzq.2.1

/-- The first edge local form cancels identically over every finite box
collection for bounded continuous data. -/
theorem edge_localCubeForm_zero_zero_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (lam r : ℝ) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B)
    (hlam : 1 ≤ lam) :
    localCubeForm α S 0 lam r (edgeCubeTuple f) = 0 := by
  apply localCubeForm_eq_zero_of_spatial_zero_ae
  filter_upwards [ae_restrict_mem (measurableSet_collectionRegion α S)] with z hz
  exact spatial_integral_edge_zero_zero α lam r z.2 z.1 f hfcont hfbound hlam
    (pos_of_mem_collectionRegion α S hz)

/-- The second edge local form cancels identically over every finite box
collection for bounded continuous data. -/
theorem edge_localCubeForm_zero_one_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (lam r : ℝ) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B)
    (hlam : 1 ≤ lam) :
    localCubeForm α S 1 lam r (edgeCubeTuple f) = 0 := by
  apply localCubeForm_eq_zero_of_spatial_zero_ae
  filter_upwards [ae_restrict_mem (measurableSet_collectionRegion α S)] with z hz
  exact spatial_integral_edge_zero_one α lam r z.2 z.1 f hfcont hfbound hlam
    (pos_of_mem_collectionRegion α S hz)

/-- The edge tree conclusion, reduced only to the standard cubical-copy
positivity statement. The two cancellations are supplied by the literal
active/passive Fubini calculation above, and the exact `37,21,2` exponents
come from the already checked edge remainder and tree telescope. -/
theorem edgeTreeEstimate_of_boundedContinuous_and_copy_nonneg
    (α : Anisotropy)
    (hcopy : ∀ (S : BoxCollection α) (lam r : ℝ) (f : E3 → ℝ) (b : Bool),
      Continuous f →
      (∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) →
      1 ≤ lam →
      0 ≤ localCubeForm α S 2 lam r
        (cubeCoordinateCopy 2 b (edgeCubeTuple f))) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α) (lam r : ℝ)
      (f : E3 → ℝ),
      Continuous f →
      (∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) →
      1 ≤ lam →
      localCubeForm α T.boxes 0 lam r (edgeCubeTuple f) = 0 ∧
      localCubeForm α T.boxes 1 lam r (edgeCubeTuple f) = 0 ∧
      0 ≤ localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) ∧
      localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) ≤
        C * lam ^ 37 * translationWeight r ^ 21 *
          treeLocalSize T 2 f ^ 2 * boxMass α T.root := by
  rcases edgeTreeEstimate_of_cancellation_and_nonneg α with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro T lam r f hfcont hfbound hlam
  have hzero0 := edge_localCubeForm_zero_zero_of_boundedContinuous
    α T.boxes lam r f hfcont hfbound hlam
  have hzero1 := edge_localCubeForm_zero_one_of_boundedContinuous
    α T.boxes lam r f hfcont hfbound hlam
  have hcopy2 := hcopy T.boxes lam r f false hfcont hfbound hlam
  have hnonneg := edge_localCubeForm_two_nonneg_of_copy
    α T.boxes lam r f false hcopy2
  exact ⟨hzero0, hzero1, hnonneg,
    hbound T lam r f hfcont hfbound hlam hzero0 hzero1 hnonneg⟩

/-- The literal Section 4 edge tree estimate. The two active coordinates
cancel by the fixed-scale Fubini calculation, while the third is nonnegative
by the bounded-continuous cubical-copy square theorem. -/
theorem edgeTreeEstimate_of_boundedContinuous
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α) (lam r : ℝ)
      (f : E3 → ℝ),
      Continuous f →
      (∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) →
      1 ≤ lam →
      localCubeForm α T.boxes 0 lam r (edgeCubeTuple f) = 0 ∧
      localCubeForm α T.boxes 1 lam r (edgeCubeTuple f) = 0 ∧
      0 ≤ localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) ∧
      localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) ≤
        C * lam ^ 37 * translationWeight r ^ 21 *
          treeLocalSize T 2 f ^ 2 * boxMass α T.root := by
  apply edgeTreeEstimate_of_boundedContinuous_and_copy_nonneg α
  intro S lam r f b hfcont hfbound hlam
  exact localCubeForm_coordinateCopy_nonneg α S 2 lam r
    (edgeCubeTuple f) b
    (continuous_edgeCubeTuple f hfcont)
    (bounded_edgeCubeTuple f hfbound) hlam



local instance : Fact (0 < (8 : ℝ)) := ⟨by norm_num⟩


/-- **`lem:local_integrability`** (Local integrability and differentiation).

For bounded continuous real `F_j` and a finite collection, `eq:cubeform` is
absolutely integrable and multilinear.

This is the absolute integrability of the cubical weight in the joint centre
and space variables. -/
theorem lem_local_integrability_cubeBracketWeight
    (α : Anisotropy) (q : AnisoBox α) {t : ℝ} (ht : 0 < t) :
    Integrable (fun z : E3 × E6 ↦ cubeBracketWeight α t z.1 z.2)
      ((volume.restrict (boxSet α q)).prod volume) :=
  integrable_cubeBracketWeight_center_space α q ht

/-- **`lem:telescoping_identity`** (Finite telescoping identity),
equation `eq:single_tel`.

For a single box, `∑_i α_i Θ^{(i)}_{{Q},λ,r}(F)
  = Ξ_{ch(Q)}(F) - Ξ_{{Q}}(F) + B_{{Q}}(F)`.

This is the weighted single-box identity the tree form is assembled from. -/
theorem lem_telescoping_identity_box
    (α : Anisotropy) (Q : AnisoBox α) (i : Fin 3) {lam t : ℝ}
    (r : ℝ) (x : E6) (w : TransverseSpace i → ℝ)
    (hlam : 1 ≤ lam) (ht : 0 < t)
    (hD : IntegrableOn (fun p : E3 ↦
      w (coordinateSplit i p).2 *
        (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t))
      (boxSet α Q))
    (hP : IntegrableOn (fun p : E3 ↦
      w (coordinateSplit i p).2 * cubeCoordinateP α i lam r t p x)
      (boxSet α Q))
    (hElo : IntegrableOn (fun y : TransverseSpace i ↦
      w y * cubeBoundaryKernel α i lam r t
        (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.lower) y) x)
      (transverseRectangle α Q i))
    (hEhi : IntegrableOn (fun y : TransverseSpace i ↦
      w y * cubeBoundaryKernel α i lam r t
        (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.upper) y) x)
      (transverseRectangle α Q i))
    (hPouter : Integrable (fun y : TransverseSpace i ↦
      ∫ u in boxInterval α Q i,
        w y * cubeCoordinateP α i lam r t (faceInsert i u y) x)
      (volume.restrict (transverseRectangle α Q i))) :
    (∫ p : E3 in boxSet α Q,
      w (coordinateSplit i p).2 *
        (-t * deriv (fun s : ℝ ↦ cubeCoordinateD α i lam r s p x) t)) =
      (α.weight i : ℝ) / Real.pi *
        (∫ p : E3 in boxSet α Q,
          w (coordinateSplit i p).2 * cubeCoordinateP α i lam r t p x) +
      (α.weight i : ℝ) * t ^ α.weight i *
        ((∫ y : TransverseSpace i in transverseRectangle α Q i,
          w y * cubeBoundaryKernel α i lam r t
            (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.upper) y) x) -
         (∫ y : TransverseSpace i in transverseRectangle α Q i,
          w y * cubeBoundaryKernel α i lam r t
            (faceInsert i (boxFaceCoordinate α Q i FaceOrientation.lower) y) x)) :=
  cubeCoordinate_box_telescoping_weighted α Q i r x w hlam ht hD hP hElo hEhi hPouter

/-- **`lem:face_cancellation`** (Cancellation of interior faces),
equation `eq:boundary_face_expansion`.

For every finite convex tree, the boundary form equals the surviving-face
expansion; only levels occupied by the finite tree contribute. -/
theorem lem_face_cancellation
    (α : Anisotropy) (T : FiniteConvexTree α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) :
    cubeTreeBoxBoundaryForm α T lam r F = cubeBoundaryFaceForm α T lam r F :=
  cubeTreeBoxBoundaryForm_eq_cubeBoundaryFaceForm α T lam r F

/-- **`cor:remainder_norms`** (Two remainder norms).

Write `D_{λ,r} = C_α λ^{37} R(r)^{21}`. Then
`|R_T(F)| ≤ D_{λ,r} |Q_T| ∏_{j ∈ J} M_{T,4}(F_j)`. -/
theorem cor_remainder_norms (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α) (lam r : ℝ)
      (F : CubeVertex → E3 → ℝ),
      (∀ j, Continuous (F j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B) →
      1 ≤ lam →
      |cubeTreeRemainder α T lam r F| ≤
        C * lam ^ 37 * translationWeight r ^ 21 *
          (∏ j : CubeVertex, treeLocalSize T 4 (F j)) * boxMass α T.root :=
  cubeTreeRemainder_bound_of_boundedContinuous α

/-- **`lem:cube_cs`** (Cubical Cauchy--Schwarz and positivity).

For real bounded continuous tuples,
`|Θ^{(i)}_T(F)|^2 ≤ Θ^{(i)}_T(C_i^0 F) Θ^{(i)}_T(C_i^1 F)`.

This is the Cauchy--Schwarz half. -/
theorem lem_cube_cs_cauchySchwarz
    (α : Anisotropy) (S : BoxCollection α) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ)
    (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (hlam : 1 ≤ lam) :
    |localCubeForm α S i lam r F| ^ 2 ≤
      localCubeForm α S i lam r (cubeCoordinateCopy i false F) *
        localCubeForm α S i lam r (cubeCoordinateCopy i true F) :=
  localCubeForm_cauchySchwarz α S i lam r F hFcont hFbound hlam

/-- **`lem:cube_cs`** (Cubical Cauchy--Schwarz and positivity).

`Θ^{(i)}_T(C_i^b F) ≥ 0`.

This is the positivity half. -/
theorem lem_cube_cs_nonneg
    (α : Anisotropy) (S : BoxCollection α) (i : Fin 3) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ) (b : Bool)
    (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (hlam : 1 ≤ lam) :
    0 ≤ localCubeForm α S i lam r (cubeCoordinateCopy i b F) :=
  localCubeForm_coordinateCopy_nonneg α S i lam r F b hFcont hFbound hlam

/-- **`prop:cube_tree`** (Full cube tree estimate), equation `eq:cube_tree`.

For `i = 1,2,3`,
`|Θ^{(i)}_{T,λ,r}(F)| ≤ C_α λ^{37} R(r)^{21} |Q_T| ∏_{j ∈ J} M_{T,4}(F_j)`. -/
theorem prop_cube_tree (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α) (lam r : ℝ)
      (F : CubeVertex → E3 → ℝ) (i : Fin 3),
      (∀ j, Continuous (F j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B) →
      1 ≤ lam →
      |localCubeForm α T.boxes i lam r F| ≤
        C * lam ^ 37 * translationWeight r ^ 21 *
          (∏ j : CubeVertex, treeLocalSize T 4 (F j)) * boxMass α T.root :=
  fullCubeTreeEstimate_of_boundedContinuous α

/-- **`prop:edge_tree`** (Edge tree estimate).

If `F_{000} = F_{001} = f ∈ C_b(E_3;ℝ)` and all other slots are `1`, then
`Θ^{(1)}_T(F) = Θ^{(2)}_T(F) = 0` and
`0 ≤ Θ^{(3)}_{T,λ,r}(F) ≤ C_α λ^{37} R(r)^{21} |Q_T| M_{T,2}(f)^2`. -/
theorem prop_edge_tree (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α) (lam r : ℝ)
      (f : E3 → ℝ),
      Continuous f →
      (∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) →
      1 ≤ lam →
      localCubeForm α T.boxes 0 lam r (edgeCubeTuple f) = 0 ∧
      localCubeForm α T.boxes 1 lam r (edgeCubeTuple f) = 0 ∧
      0 ≤ localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) ∧
      localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) ≤
        C * lam ^ 37 * translationWeight r ^ 21 *
          treeLocalSize T 2 f ^ 2 * boxMass α T.root :=
  edgeTreeEstimate_of_boundedContinuous α

