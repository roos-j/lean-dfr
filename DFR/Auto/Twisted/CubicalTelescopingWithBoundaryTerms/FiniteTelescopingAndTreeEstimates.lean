/-- The last finite Fubini/algebra step in the one-box telescope. Once the
three spatial scale integrals are integrable, the integral of the split
derivative is the corresponding finite sum of interior and oriented-face
terms. -/
theorem integral_spatial_scale_sum_expand
    (α : Anisotropy) (Q : AnisoBox α) (lam r : ℝ)
    (F : CubeVertex → E3 → ℝ)
    (hI : ∀ i : Fin 3, Integrable (fun x : E6 ↦
      cubeSignedInputProduct F x *
        (∫ t : ℝ in Set.Ioc (boxLength Q / 2) (boxLength Q),
          boxInteriorScaleIntegrand α Q i lam r x t)) volume)
    (hU : ∀ i : Fin 3, Integrable (fun x : E6 ↦
      cubeSignedInputProduct F x *
        (∫ t : ℝ in Set.Ioc (boxLength Q / 2) (boxLength Q),
          boxFaceScaleIntegrand α Q i FaceOrientation.upper lam r x t)) volume)
    (hV : ∀ i : Fin 3, Integrable (fun x : E6 ↦
      cubeSignedInputProduct F x *
        (∫ t : ℝ in Set.Ioc (boxLength Q / 2) (boxLength Q),
          boxFaceScaleIntegrand α Q i FaceOrientation.lower lam r x t)) volume) :
    (∫ x : E6, cubeSignedInputProduct F x *
      (∑ i : Fin 3,
        ((α.weight i : ℝ) / Real.pi *
          (∫ t : ℝ in Set.Ioc (boxLength Q / 2) (boxLength Q),
            boxInteriorScaleIntegrand α Q i lam r x t) +
        (α.weight i : ℝ) *
          ((∫ t : ℝ in Set.Ioc (boxLength Q / 2) (boxLength Q),
            boxFaceScaleIntegrand α Q i FaceOrientation.upper lam r x t) -
           (∫ t : ℝ in Set.Ioc (boxLength Q / 2) (boxLength Q),
            boxFaceScaleIntegrand α Q i FaceOrientation.lower lam r x t)))) =
      ∑ i : Fin 3,
        ((α.weight i : ℝ) / Real.pi *
          (∫ x : E6, cubeSignedInputProduct F x *
            (∫ t : ℝ in Set.Ioc (boxLength Q / 2) (boxLength Q),
              boxInteriorScaleIntegrand α Q i lam r x t)) +
        (α.weight i : ℝ) *
          ((∫ x : E6, cubeSignedInputProduct F x *
            (∫ t : ℝ in Set.Ioc (boxLength Q / 2) (boxLength Q),
              boxFaceScaleIntegrand α Q i FaceOrientation.upper lam r x t)) -
           (∫ x : E6, cubeSignedInputProduct F x *
            (∫ t : ℝ in Set.Ioc (boxLength Q / 2) (boxLength Q),
              boxFaceScaleIntegrand α Q i FaceOrientation.lower lam r x t))))) := by
  let f : E6 → ℝ := cubeSignedInputProduct F
  let I : Fin 3 → E6 → ℝ := fun i x ↦
    ∫ t : ℝ in Set.Ioc (boxLength Q / 2) (boxLength Q),
      boxInteriorScaleIntegrand α Q i lam r x t
  let U : Fin 3 → E6 → ℝ := fun i x ↦
    ∫ t : ℝ in Set.Ioc (boxLength Q / 2) (boxLength Q),
      boxFaceScaleIntegrand α Q i FaceOrientation.upper lam r x t
  let V : Fin 3 → E6 → ℝ := fun i x ↦
    ∫ t : ℝ in Set.Ioc (boxLength Q / 2) (boxLength Q),
      boxFaceScaleIntegrand α Q i FaceOrientation.lower lam r x t
  let R : Fin 3 → E6 → ℝ := fun i x ↦
    (α.weight i : ℝ) / Real.pi * I i x +
      (α.weight i : ℝ) * (U i x - V i x)
  have hI' (i : Fin 3) : Integrable (fun x : E6 ↦ f x * I i x) volume := by
    simpa only [f, I] using hI i
  have hU' (i : Fin 3) : Integrable (fun x : E6 ↦ f x * U i x) volume := by
    simpa only [f, U] using hU i
  have hV' (i : Fin 3) : Integrable (fun x : E6 ↦ f x * V i x) volume := by
    simpa only [f, V] using hV i
  have hR (i : Fin 3) : Integrable (fun x : E6 ↦ f x * R i x) volume := by
    have hAI : Integrable (fun x : E6 ↦
        ((α.weight i : ℝ) / Real.pi) * (f x * I i x)) volume :=
      (hI' i).const_mul ((α.weight i : ℝ) / Real.pi)
    have hAUV : Integrable (fun x : E6 ↦
        (α.weight i : ℝ) * ((f x * U i x) - (f x * V i x))) volume :=
      ((hU' i).sub (hV' i)).const_mul (α.weight i : ℝ)
    refine (hAI.add hAUV).congr ?_
    filter_upwards [] with x
    simp only [Pi.add_apply]
    dsimp only [R]
    ring
  change (∫ x : E6, f x * (∑ i : Fin 3, R i x)) =
    ∑ i : Fin 3,
      ((α.weight i : ℝ) / Real.pi * (∫ x : E6, f x * I i x) +
      (α.weight i : ℝ) * ((∫ x : E6, f x * U i x) -
        (∫ x : E6, f x * V i x)))
  calc
    (∫ x : E6, f x * (∑ i : Fin 3, R i x)) =
        ∫ x : E6, ∑ i : Fin 3, f x * R i x := by
      apply integral_congr_ae
      filter_upwards [] with x
      rw [Finset.mul_sum]
    _ = ∑ i : Fin 3, ∫ x : E6, f x * R i x := by
      exact MeasureTheory.integral_finsetSum Finset.univ (fun i _ ↦ hR i)
    _ = _ := by
      apply Finset.sum_congr rfl
      intro i hi
      have hAI : Integrable (fun x : E6 ↦
          ((α.weight i : ℝ) / Real.pi) * (f x * I i x)) volume :=
        (hI' i).const_mul ((α.weight i : ℝ) / Real.pi)
      have hAUV : Integrable (fun x : E6 ↦
          (α.weight i : ℝ) * ((f x * U i x) - (f x * V i x))) volume :=
        ((hU' i).sub (hV' i)).const_mul (α.weight i : ℝ)
      calc
        (∫ x : E6, f x * R i x) =
            ∫ x : E6, (((α.weight i : ℝ) / Real.pi) * (f x * I i x) +
              (α.weight i : ℝ) * ((f x * U i x) - (f x * V i x))) := by
          apply integral_congr_ae
          filter_upwards [] with x
          dsimp only [R]
          ring
        _ = (∫ x : E6, ((α.weight i : ℝ) / Real.pi) * (f x * I i x)) +
            (∫ x : E6, (α.weight i : ℝ) *
              ((f x * U i x) - (f x * V i x))) :=
          MeasureTheory.integral_add hAI hAUV
        _ = _ := by
          rw [MeasureTheory.integral_const_mul,
            MeasureTheory.integral_const_mul,
            MeasureTheory.integral_sub (hU' i) (hV' i)]

