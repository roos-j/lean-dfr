/-- Every literal child has half the parent length, in a parent-only form
convenient for tree leaves. -/
theorem scratch_boxLength_eq_half_parent
    (α : Anisotropy) (q : AnisoBox α) :
    boxLength q = boxLength (boxParent α q) / 2 := by
  unfold boxLength boxParent
  rw [show q.level = (q.level + 1) - 1 by omega,
    zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0)]
  norm_num

/-- A leaf at its own full scale lies in the closure of its parent's source
cell, hence in the closure of the whole tree region. -/
theorem scratch_mem_closure_collectionRegion_of_mem_leaf_boxSet_fullScale
    (α : Anisotropy) (T : FiniteConvexTree α) (l : AnisoBox α)
    (hl : l ∈ treeLeaves T) {p : E3} (hp : p ∈ boxSet α l) :
    (p, boxLength l) ∈ closure (collectionRegion α T.boxes) := by
  let q : AnisoBox α := boxParent α l
  have hq : q ∈ T.boxes := by
    exact treeLeaves_parent_mem T hl
  have hpsub : p ∈ boxSet α q := by
    dsimp only [q]
    exact boxSet_subset_parent α l hp
  have hcell : (p, boxLength l) ∈ closure (boxScaleRegion α q) := by
    rw [boxScaleRegion, closure_prod_eq]
    constructor
    · exact subset_closure hpsub
    · rw [boxScaleBand]
      have hne : boxLength q / 2 ≠ boxLength q := by
        nlinarith [boxLength_pos q]
      rw [closure_Ioc hne]
      have hlen : boxLength l = boxLength q / 2 := by
        dsimp only [q]
        exact scratch_boxLength_eq_half_parent α l
      rw [hlen]
      exact ⟨le_rfl, (div_le_iff₀ (by norm_num : (0 : ℝ) < 2)).mpr
        (by linarith [boxLength_pos q])⟩
  apply closure_mono
  · intro z hz
    unfold collectionRegion
    exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hq, hz⟩⟩
  · exact hcell

end

end Auto.Twisted
