/-! ## Scalar stopping distributions

The finite forest construction has already reduced its global packing
estimate to four maximal-function level sums. The following lemmas make the
finite layer-cake conversion explicit, so it can consume the measurable
coordinatewise maximal majorants constructed below. -/

/-- A dyadic `r`-power weight is the integer power used by the finite
layer-cake estimate with base `2^r`. -/
theorem rpow_two_mul_int_eq_zpow_rpow
    (r : ℝ) (m : ℤ) :
    (2 : ℝ) ^ (r * (m : ℝ)) = ((2 : ℝ) ^ r) ^ m := by
  rw [← Real.rpow_mul_intCast (by norm_num : (0 : ℝ) ≤ 2) r m]

/-- Exact threshold conversion after raising a stopping level to a positive
real power. -/
theorem sourceStopping_threshold_rpow
    (j : Fin 4) (r : ℝ) (m : ℤ) :
    (sourceStoppingComparisonConstant j / 2) ^ r *
        ((2 : ℝ) ^ r) ^ m =
      (sourceStoppingComparisonConstant j * (2 : ℝ) ^ (m - 1)) ^ r := by
  have hc : 0 < sourceStoppingComparisonConstant j :=
    sourceStoppingComparisonConstant_pos j
  have htwo : (2 : ℝ) ≠ 0 := by norm_num
  rw [← rpow_two_mul_int_eq_zpow_rpow r m]
  rw [← Real.rpow_intCast]
  rw [show (r * (m : ℝ)) = ((m : ℝ) * r) by ring,
    Real.rpow_intCast_mul (by norm_num : (0 : ℝ) ≤ 2) m r]
  rw [← Real.mul_rpow (by positivity : 0 ≤ sourceStoppingComparisonConstant j / 2)
    (zpow_nonneg (by norm_num) m)]
  congr 1
  have hpow : (2 : ℝ) ^ ((m - 1 : ℤ) : ℝ) = (2 : ℝ) ^ m / 2 := by
    rw [show ((m - 1 : ℤ) : ℝ) = (m : ℝ) - 1 by
      push_cast
      ring,
      Real.rpow_sub (by norm_num : 0 < (2 : ℝ)), Real.rpow_one,
      ← Real.rpow_intCast]
  rw [hpow]
  ring

/-- Bounded continuous inputs make the literal fourth-power all-scale
supremum nonnegative by retaining its positive unit-scale member. -/
theorem anisotropicMaximalFourPower_nonneg_of_boundedContinuous
    (α : Anisotropy) (f : E3 → ℝ) (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f y| ≤ B) (p : E3) :
    0 ≤ anisotropicMaximalFourPower α f p := by
  calc
    0 ≤ fourthMoment α 1 p f := fourthMoment_nonneg α (by norm_num) p f
    _ ≤ anisotropicMaximalFourPower α f p := by
      unfold anisotropicMaximalFourPower
      apply le_csSup (bddAbove_anisotropicMaximalFourPower
        α f hfcont B hB hfB p)
      exact ⟨1, by norm_num, rfl⟩

/-- Every literal source stopping maximal is nonnegative on bounded
continuous data. -/
theorem sourceStoppingMaximal_nonneg_of_boundedContinuous
    (α : Anisotropy) (f : ModelRealInput) (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (j : Fin 4) (p : E3) :
    0 ≤ sourceStoppingMaximal α f j p := by
  by_cases hj : j = 3
  · subst j
    simp only [sourceStoppingMaximal, ↓reduceIte]
    exact Real.sqrt_nonneg _
  · rcases hbound j with ⟨B, hB, hfB⟩
    simp only [sourceStoppingMaximal, hj, ite_false]
    exact Real.rpow_nonneg
      (anisotropicMaximalFourPower_nonneg_of_boundedContinuous
        α (f j) (hcont j) B hB hfB p) _

/-- A literal stopping superlevel is contained in the corresponding level
set of any `r`-power majorant. -/
theorem sourceStoppingLevelSetAt_subset_majorant_rpowLevel
    (α : Anisotropy) (f : ModelRealInput) (j : Fin 4) (m : ℤ)
    (r : ℝ) (h : E3 → ℝ)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hr : 0 < r)
    (hmajor : ∀ x, sourceStoppingMaximal α f j x ≤ h x) :
    sourceStoppingMaximalLevelSetAt α f j m ⊆
      {x | (sourceStoppingComparisonConstant j / 2) ^ r *
          ((2 : ℝ) ^ r) ^ m ≤ h x ^ r} := by
  intro x hx
  have hsource : sourceStoppingComparisonConstant j * (2 : ℝ) ^ (m - 1) <
      sourceStoppingMaximal α f j x := hx
  have hsource_nonneg : 0 ≤ sourceStoppingMaximal α f j x := by
    exact sourceStoppingMaximal_nonneg_of_boundedContinuous
      α f hcont hbound j x
  have hpow :
      (sourceStoppingComparisonConstant j * (2 : ℝ) ^ (m - 1)) ^ r ≤
        (sourceStoppingMaximal α f j x) ^ r := by
    apply Real.rpow_le_rpow
    · exact (mul_pos (sourceStoppingComparisonConstant_pos j)
        (zpow_pos (by norm_num) _)).le
    · exact hsource.le
    · exact hr.le
  have hmajorpow : (sourceStoppingMaximal α f j x) ^ r ≤ h x ^ r := by
    exact Real.rpow_le_rpow hsource_nonneg (hmajor x) hr.le
  rw [sourceStopping_threshold_rpow j r m]
  exact hpow.trans hmajorpow

/-- A positive closed superlevel of an integrable nonnegative function has
finite volume. -/
theorem volume_ne_top_of_integrable_closed_superlevel
    (g : E3 → ℝ) (hg : Integrable g) {θ : ℝ} (hθ : 0 < θ) :
    volume {x : E3 | θ ≤ g x} ≠ ∞ := by
  have hmem : MemLp g 1 volume := memLp_one_iff_integrable.mpr hg
  have hhalf : 0 < θ / 2 := by linarith
  have htop : volume {x : E3 | θ / 2 < g x} ≠ ∞ :=
    volume_ne_top_of_memLp g 1 hmem (by norm_num) (by norm_num) hhalf
  apply ne_of_lt
  apply (MeasureTheory.measure_mono ?_).trans_lt
    (lt_top_iff_ne_top.mpr htop)
  intro x hx
  change θ / 2 < g x
  change θ ≤ g x at hx
  linarith

/-- Finite scalar distribution estimate for a literal source stopping
coordinate dominated by a measurable integrable `r`-power majorant. -/
theorem sum_sourceStoppingLevel_rpow_weight_le_integral_majorant
    (α : Anisotropy) (f : ModelRealInput) (j : Fin 4) (r : ℝ)
    (h : E3 → ℝ)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hr : 0 < r)
    (hmajor : ∀ x, sourceStoppingMaximal α f j x ≤ h x)
    (hnonneg : ∀ x, 0 ≤ h x)
    (hmeas : Measurable (fun x : E3 ↦ h x ^ r))
    (hint : Integrable (fun x : E3 ↦ h x ^ r))
    (N : Finset ℤ) :
    (∑ m ∈ N, (2 : ℝ) ^ (r * (m : ℝ)) *
      (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) ≤
      ((1 - ((2 : ℝ) ^ r)⁻¹)⁻¹ *
        (sourceStoppingComparisonConstant j / 2) ^ (-r)) *
          ∫ x : E3, h x ^ r := by
  let a : ℝ := (2 : ℝ) ^ r
  let c : ℝ := (sourceStoppingComparisonConstant j / 2) ^ r
  let g : E3 → ℝ := fun x ↦ h x ^ r
  have ha : 1 < a := by
    dsimp [a]
    exact Real.one_lt_rpow (by norm_num) hr
  have hc : 0 < c := by
    dsimp [c]
    exact Real.rpow_pos_of_pos
      (div_pos (sourceStoppingComparisonConstant_pos j) (by norm_num)) _
  have hapos : 0 < a := lt_trans (by norm_num) ha
  have hgmeas : Measurable g := by
    simpa only [g] using hmeas
  have hgint : Integrable g := by
    simpa only [g] using hint
  have hgnonneg : ∀ x, 0 ≤ g x := by
    intro x
    dsimp [g]
    exact Real.rpow_nonneg (hnonneg x) _
  have hfinite : ∀ m ∈ N, volume {x : E3 | c * a ^ m ≤ g x} ≠ ∞ := by
    intro m hm
    apply volume_ne_top_of_integrable_closed_superlevel g hgint
    exact mul_pos hc (zpow_pos hapos m)
  have hset : ∀ m : ℤ,
      sourceStoppingMaximalLevelSetAt α f j m ⊆
        {x : E3 | c * a ^ m ≤ g x} := by
    intro m
    dsimp [a, c, g]
    exact sourceStoppingLevelSetAt_subset_majorant_rpowLevel
      α f j m r h hcont hbound hr hmajor
  have hterm : ∀ m ∈ N,
      (2 : ℝ) ^ (r * (m : ℝ)) *
          (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal ≤
        a ^ m * (volume {x : E3 | c * a ^ m ≤ g x}).toReal := by
    intro m hm
    rw [rpow_two_mul_int_eq_zpow_rpow]
    apply mul_le_mul_of_nonneg_left
      (ENNReal.toReal_mono (hfinite m hm)
        (MeasureTheory.measure_mono (hset m)))
    exact zpow_nonneg hapos.le m
  have hlayer := sum_zpow_levelSet_toReal_le_integral
    a c ha hc g hgmeas hgint hgnonneg N hfinite
  calc
    (∑ m ∈ N, (2 : ℝ) ^ (r * (m : ℝ)) *
        (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) ≤
        ∑ m ∈ N, a ^ m *
          (volume {x : E3 | c * a ^ m ≤ g x}).toReal := by
      exact Finset.sum_le_sum fun m hm ↦ hterm m hm
    _ ≤ ((1 - a⁻¹)⁻¹ * c⁻¹) * ∫ x : E3, g x := hlayer
    _ = ((1 - ((2 : ℝ) ^ r)⁻¹)⁻¹ *
        (sourceStoppingComparisonConstant j / 2) ^ (-r)) *
          ∫ x : E3, h x ^ r := by
      have hbase : 0 ≤ sourceStoppingComparisonConstant j / 2 := by
        exact (div_pos (sourceStoppingComparisonConstant_pos j)
          (by norm_num)).le
      rw [show c⁻¹ = (sourceStoppingComparisonConstant j / 2) ^ (-r) by
        dsimp [c]
        rw [← Real.rpow_neg hbase r]]

/-- The finite stopping envelope is reduced to its four scalar dyadic
distribution sums once its dominant-fiber weights have been compared with
the corresponding `r`-power dyadic weights. -/
theorem SourceStoppingCoordinateEnvelope_le_of_dominant_weight_bound
    (α : Anisotropy) (S : BoxCollection α) (f : ModelRealInput)
    (q σ r B L : Fin 4 → ℝ)
    (hpos : ∀ s ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) s)
    (hB : ∀ j, 0 ≤ B j)
    (hweight : ∀ j m,
      sourceStoppingDominantFiberEnvelope q σ j m ≤
        B j * (2 : ℝ) ^ (r j * (m : ℝ)))
    (hlevel : ∀ j,
      (∑ m ∈ (activeStoppingLevels α S sourceStoppingExponent f hpos).filter
          (fun n ↦ sourceStoppingDominantIndex q σ n = j) |>.image
            (fun n ↦ n j),
        (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal *
          (2 : ℝ) ^ (r j * (m : ℝ))) ≤ L j) :
    SourceStoppingCoordinateEnvelope α S f q σ hpos ≤ ∑ j, B j * L j := by
  unfold SourceStoppingCoordinateEnvelope
  apply Finset.sum_le_sum
  intro j hj
  let N : Finset ℤ :=
    (activeStoppingLevels α S sourceStoppingExponent f hpos).filter
      (fun n ↦ sourceStoppingDominantIndex q σ n = j) |>.image
        (fun n ↦ n j)
  have hterm : ∀ m ∈ N,
      sourceStoppingDominantFiberEnvelope q σ j m *
          (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal ≤
        B j * ((2 : ℝ) ^ (r j * (m : ℝ)) *
          (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) := by
    intro m hm
    calc
      sourceStoppingDominantFiberEnvelope q σ j m *
          (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal ≤
        (B j * (2 : ℝ) ^ (r j * (m : ℝ))) *
          (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal := by
          apply mul_le_mul_of_nonneg_right (hweight j m)
          exact ENNReal.toReal_nonneg
      _ = B j * ((2 : ℝ) ^ (r j * (m : ℝ)) *
          (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) := by
          ring
  change (∑ m ∈ N,
      sourceStoppingDominantFiberEnvelope q σ j m *
        (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) ≤ B j * L j
  calc
    (∑ m ∈ N,
        sourceStoppingDominantFiberEnvelope q σ j m *
          (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) ≤
        ∑ m ∈ N, B j * ((2 : ℝ) ^ (r j * (m : ℝ)) *
          (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) := by
      exact Finset.sum_le_sum fun m hm ↦ hterm m hm
    _ = B j * (∑ m ∈ N, (2 : ℝ) ^ (r j * (m : ℝ)) *
          (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) := by
      rw [Finset.mul_sum]
    _ ≤ B j * L j := by
      apply mul_le_mul_of_nonneg_left
      · simpa only [N, mul_comm] using hlevel j
      · exact hB j


/-! ### Four-linear rescaling of the real model form -/

/-- Real scalar multiplication commutes exactly with each one-coordinate
model convolution. -/
theorem ModelCoordinateConvolution_smul
    (i : Fin 3) (a : ℝ) (f : E3 → ℝ) (k : ℝ → ℝ)
    (s : ℝ) (x : E3) :
    ModelCoordinateConvolution i (a • f) k s x =
      a * ModelCoordinateConvolution i f k s x := by
  unfold ModelCoordinateConvolution
  rw [show (fun r : ℝ ↦ (a • f) (x - r • Anisotropy.coordinateDirection i) *
      kernelDilate k s r) =
      fun r ↦ a * (f (x - r • Anisotropy.coordinateDirection i) *
        kernelDilate k s r) by
      funext r
      simp only [Pi.smul_apply, smul_eq_mul]
      ring, integral_const_mul]

/-- Independently rescale the four real Schwartz inputs of the model form. -/
noncomputable def modelInputRescale
    (a : Fin 4 → ℝ) (F : ModelSchwartzInput) : ModelSchwartzInput :=
  fun j ↦ a j • F j

@[simp] theorem modelInputRescale_apply
    (a : Fin 4 → ℝ) (F : ModelSchwartzInput) (j : Fin 4) (x : E3) :
    modelInputRescale a F j x = a j * F j x := by
  simp [modelInputRescale]

/-- The pointwise spatial model integrand is four-linear in independently
rescaled inputs. -/
theorem ModelSpatialIntegrand_rescale
    (α : Anisotropy) (u : E3) (a : Fin 4 → ℝ)
    (F : ModelSchwartzInput) (t : ℝ) (x : E3) :
    ModelSpatialIntegrand α u (modelInputRescale a F) t x =
      (∏ j : Fin 4, a j) * ModelSpatialIntegrand α u F t x := by
  have hcomp (j : Fin 4) :
      ((modelInputRescale a F j : SchwartzMap E3 ℝ) : E3 → ℝ) =
        a j • ((F j : SchwartzMap E3 ℝ) : E3 → ℝ) := by
    funext y
    simp [modelInputRescale]
  unfold ModelSpatialIntegrand
  rw [hcomp 0, hcomp 1, hcomp 2, hcomp 3,
    ModelCoordinateConvolution_smul,
    ModelCoordinateConvolution_smul,
    ModelCoordinateConvolution_smul]
  simp only [Pi.smul_apply, smul_eq_mul, Fin.prod_univ_four]
  ring

/-- The spatial profile inherits the same four-linear rescaling law. -/
theorem ModelSpatialProfile_rescale
    (α : Anisotropy) (u : E3) (a : Fin 4 → ℝ)
    (F : ModelSchwartzInput) (t : ℝ) :
    ModelSpatialProfile α u (modelInputRescale a F) t =
      (∏ j : Fin 4, a j) * ModelSpatialProfile α u F t := by
  unfold ModelSpatialProfile
  rw [show (fun x : E3 ↦ ModelSpatialIntegrand α u
      (modelInputRescale a F) t x) =
      fun x ↦ (∏ j : Fin 4, a j) * ModelSpatialIntegrand α u F t x by
        funext x
        exact ModelSpatialIntegrand_rescale α u a F t x,
      integral_const_mul]

/-- The full real Schwartz model form is exactly four-linear under
independent scalar rescaling. -/
theorem ModelFullForm_rescale
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ)
    (a : Fin 4 → ℝ) (F : ModelSchwartzInput) :
    ModelFullForm α u c (modelInputRescale a F) =
      (∏ j : Fin 4, a j) * ModelFullForm α u c F := by
  unfold ModelFullForm
  rw [show (fun t : ℝ ↦ c t * ModelSpatialProfile α u
      (modelInputRescale a F) t) =
      fun t ↦ (∏ j : Fin 4, a j) *
        (c t * ModelSpatialProfile α u F t) by
        funext t
        rw [ModelSpatialProfile_rescale]
        ring,
      integral_const_mul]

/-- Independent rescaling at the raw real-input level used by finite model
forests. -/
def modelRealInputRescale
    (a : Fin 4 → ℝ) (f : ModelRealInput) : ModelRealInput :=
  fun j ↦ a j • f j

@[simp] theorem modelRealInputRescale_apply
    (a : Fin 4 → ℝ) (f : ModelRealInput) (j : Fin 4) (x : E3) :
    modelRealInputRescale a f j x = a j * f j x := by
  simp [modelRealInputRescale]

/-- The first fiber is trilinear in its three real input branches. -/
theorem modelFirstFiber_rescale
    (α : Anisotropy) (a : Fin 4 → ℝ) (f : ModelRealInput)
    (p : E3) (t : ℝ) (z : ModelE5) :
    modelFirstFiber α (modelRealInputRescale a f) p t z =
      (a 0 * a 1 * a 2) * modelFirstFiber α f p t z := by
  unfold modelFirstFiber
  rw [show (fun v : ℝ ↦
      modelRealInputRescale a f 0 (modelPoint (z 0) (z 1) v) *
      modelRealInputRescale a f 1 (modelPoint (z 2) (z 1) v) *
      modelRealInputRescale a f 2 (modelPoint (z 0) (z 3) v) *
      gaussianDerivAt (t ^ α.weight 2) (p 2) v) =
      fun v ↦ (a 0 * a 1 * a 2) *
        (f 0 (modelPoint (z 0) (z 1) v) *
        f 1 (modelPoint (z 2) (z 1) v) *
        f 2 (modelPoint (z 0) (z 3) v) *
        gaussianDerivAt (t ^ α.weight 2) (p 2) v) by
      funext v
      simp only [modelRealInputRescale_apply]
      ring, integral_const_mul]

/-- The second fiber is linear in the fourth real input branch. -/
theorem modelSecondFiber_smul
    (α : Anisotropy) (a : ℝ) (f : E3 → ℝ)
    (p : E3) (t : ℝ) (z : ModelE5) :
    modelSecondFiber α (a • f) p t z =
      a * modelSecondFiber α f p t z := by
  unfold modelSecondFiber
  rw [show (fun v : ℝ ↦
      (a • f) (modelPoint (z 0) (z 1) v) *
        gaussianDerivAt (t ^ α.weight 2)
          (p 2 + z 4 * t ^ α.weight 2) v) =
      fun v ↦ a * (f (modelPoint (z 0) (z 1) v) *
        gaussianDerivAt (t ^ α.weight 2)
          (p 2 + z 4 * t ^ α.weight 2) v) by
      funext v
      simp only [Pi.smul_apply, smul_eq_mul]
      ring, integral_const_mul]

/-- The finite expanded local form has the expected four-linear scaling
law, without any auxiliary integrability premise. -/
theorem expandedModelLocalForm_rescale
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (a : Fin 4 → ℝ) (f : ModelRealInput) :
    expandedModelLocalForm α S u c (modelRealInputRescale a f) =
      (∏ j : Fin 4, a j) * expandedModelLocalForm α S u c f := by
  unfold expandedModelLocalForm
  rw [show (fun pt : E3 × ℝ ↦ c pt.2 * (∫ z : ModelE5,
      modelFirstFiber α (modelRealInputRescale a f) pt.1 pt.2 z *
        modelSecondFiber α (modelRealInputRescale a f 3) pt.1 pt.2 z *
          modelSignedDensity α u pt.1 pt.2 z)) =
      fun pt ↦ (∏ j : Fin 4, a j) *
        (c pt.2 * (∫ z : ModelE5,
          modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z)) by
      funext pt
      rw [show (fun z : ModelE5 ↦
        modelFirstFiber α (modelRealInputRescale a f) pt.1 pt.2 z *
          modelSecondFiber α (modelRealInputRescale a f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z) =
          fun z ↦ (a 0 * a 1 * a 2 * a 3) *
            (modelFirstFiber α f pt.1 pt.2 z *
              modelSecondFiber α (f 3) pt.1 pt.2 z *
                modelSignedDensity α u pt.1 pt.2 z) by
          funext z
          rw [modelFirstFiber_rescale,
            show modelRealInputRescale a f 3 = a 3 • f 3 by
              funext y
              simp [modelRealInputRescale],
            modelSecondFiber_smul]
          ring,
        integral_const_mul]
      simp only [Fin.prod_univ_four]
      ring,
    integral_const_mul]
  ring

/-- Rescaling commutes with the coercion from a real Schwartz tuple to the
finite-forest input tuple. -/
theorem InitialModelRealInput_rescale
    (a : Fin 4 → ℝ) (F : InitialModelSchwartzInput) :
    InitialModelRealInput (modelInputRescale a F) =
      modelRealInputRescale a (InitialModelRealInput F) := by
  funext j x
  simp [modelInputRescale, modelRealInputRescale,
    InitialModelRealInput]

/-- The finite forest form has the same rescaling law when presented by a
real Schwartz tuple. -/
theorem expandedModelLocalForm_initial_rescale
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (a : Fin 4 → ℝ) (F : InitialModelSchwartzInput) :
    expandedModelLocalForm α S u c
      (InitialModelRealInput (modelInputRescale a F)) =
      (∏ j : Fin 4, a j) *
        expandedModelLocalForm α S u c (InitialModelRealInput F) := by
  rw [InitialModelRealInput_rescale]
  exact expandedModelLocalForm_rescale α S u c a
    (InitialModelRealInput F)

/-! ## Literal coordinate-fiber bracket identification -/
theorem e3ToFiberDyadicCoordinates_snd
    (i : Fin 3) (p : E3) :
    (e3ToFiberDyadicCoordinates i p).2 = realToFiberDyadicLine (p i) := by
  rfl

theorem e3ToFiberDyadicCoordinates_symm_coordinate
    (i : Fin 3) (z : FiberDyadicBase) (y : FiberDyadicLine) :
    ((e3ToFiberDyadicCoordinates i).symm (z, y)) i =
      realToFiberDyadicLine.symm y := by
  simp [e3ToFiberDyadicCoordinates, coordinateJoin, faceInsert,
    MeasurableEquiv.prodComm, MeasurableEquiv.prodCongr]

theorem norm_realToFiberDyadicLine (x : ℝ) :
    ‖realToFiberDyadicLine x‖ = |x| := by
  simpa [realToFiberDyadicLine, MeasurableEquiv.piUnique,
    EuclideanSpace.norm_eq] using Real.sqrt_sq_eq_abs x

theorem realToFiberDyadicLine_sub (x y : ℝ) :
    realToFiberDyadicLine x - realToFiberDyadicLine y =
      realToFiberDyadicLine (x - y) := by
  ext j
  simp [realToFiberDyadicLine, MeasurableEquiv.piUnique]

theorem norm_realToFiberDyadicLine_sub (x y : ℝ) :
    ‖realToFiberDyadicLine x - realToFiberDyadicLine y‖ = |x - y| := by
  rw [realToFiberDyadicLine_sub]
  exact norm_realToFiberDyadicLine (x - y)

theorem norm_scaled_fiber_sub
    (r a : ℝ) (y : FiberDyadicLine) (hr : 0 < r) :
    ‖r⁻¹ • (y - realToFiberDyadicLine a)‖ =
      |(realToFiberDyadicLine.symm y - a) / r| := by
  have hy : y = realToFiberDyadicLine (realToFiberDyadicLine.symm y) :=
    (realToFiberDyadicLine.apply_symm_apply y).symm
  conv_lhs => rw [hy]
  rw [norm_smul, norm_realToFiberDyadicLine_sub]
  rw [Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hr)]
  rw [div_eq_mul_inv, abs_mul, abs_of_pos (inv_pos.mpr hr)]
  ring

/-- Along a transported coordinate fibre, the literal source bracket kernel
is exactly the scaled radial fibre bracket. -/
theorem bracketKernelAt_coordinateFiber_eq
    (i : Fin 3) (p : E3) (z : FiberDyadicBase) (y : FiberDyadicLine)
    (r : ℝ) (hr : 0 < r) :
    bracketKernelAt r (p i) ((e3ToFiberDyadicCoordinates i).symm (z, y) i) =
      r⁻¹ * fiberRadialBracket
        (r⁻¹ • (y - (e3ToFiberDyadicCoordinates i p).2)) := by
  rw [e3ToFiberDyadicCoordinates_symm_coordinate,
    e3ToFiberDyadicCoordinates_snd]
  unfold bracketKernelAt kernelAt kernelDilate bracketKernel fiberRadialBracket
  rw [norm_scaled_fiber_sub r (p i) y hr]
  simp only [smul_eq_mul]

theorem e3ToFiberDyadicCoordinates_faceInsert
    (i : Fin 3) (a : ℝ) (z : TransverseSpace i) :
    e3ToFiberDyadicCoordinates i (faceInsert i a z) =
      (transverseToFiberDyadicBase i z, realToFiberDyadicLine a) := by
  simp [e3ToFiberDyadicCoordinates, MeasurableEquiv.prodComm,
    MeasurableEquiv.prodCongr]

theorem e3ToFiberDyadicCoordinates_symm_pair
    (i : Fin 3) (a : ℝ) (z : TransverseSpace i) :
    (e3ToFiberDyadicCoordinates i).symm
        (transverseToFiberDyadicBase i z, realToFiberDyadicLine a) =
      faceInsert i a z := by
  apply (e3ToFiberDyadicCoordinates i).injective
  simp [e3ToFiberDyadicCoordinates_faceInsert]

theorem integral_real_eq_integral_fiber
    (F : ℝ → ℝ) :
    (∫ x : ℝ, F x) =
      ∫ y : FiberDyadicLine, F (realToFiberDyadicLine.symm y) := by
  simpa using
    (realToFiberDyadicLine_measurePreserving.integral_comp'
      (fun y : FiberDyadicLine ↦ F (realToFiberDyadicLine.symm y)))

theorem coordinateBracketAverage_eq_coordinateFiberRadialBracketAverage
    (i : Fin 3) (f : E3 → ℂ) (r a : ℝ) (z : TransverseSpace i)
    (hr : 0 < r) :
    (∫ x : ℝ, ‖f (faceInsert i x z)‖ * bracketKernelAt r a x) =
      coordinateFiberRadialBracketAverage i f r (faceInsert i a z) := by
  rw [integral_real_eq_integral_fiber]
  unfold coordinateFiberRadialBracketAverage
  apply integral_congr_ae
  filter_upwards [] with y
  have hcoords := e3ToFiberDyadicCoordinates_faceInsert i a z
  have hfirst :
      (e3ToFiberDyadicCoordinates i (faceInsert i a z)).1 =
        transverseToFiberDyadicBase i z := congrArg Prod.fst hcoords
  have hsecond :
      (e3ToFiberDyadicCoordinates i (faceInsert i a z)).2 =
        realToFiberDyadicLine a := congrArg Prod.snd hcoords
  have hpoint :
      (e3ToFiberDyadicCoordinates i).symm
          ((e3ToFiberDyadicCoordinates i (faceInsert i a z)).1, y) =
        faceInsert i (realToFiberDyadicLine.symm y) z := by
    rw [hfirst, ← realToFiberDyadicLine.apply_symm_apply y]
    exact e3ToFiberDyadicCoordinates_symm_pair i
      (realToFiberDyadicLine.symm y) z
  have hkernel := bracketKernelAt_coordinateFiber_eq i
    (faceInsert i a z) (transverseToFiberDyadicBase i z) y r hr
  have hpair :
      (e3ToFiberDyadicCoordinates i).symm
          (transverseToFiberDyadicBase i z, y) =
        faceInsert i (realToFiberDyadicLine.symm y) z := by
    rw [← realToFiberDyadicLine.apply_symm_apply y]
    exact e3ToFiberDyadicCoordinates_symm_pair i
      (realToFiberDyadicLine.symm y) z
  have hkernel' :
      bracketKernelAt r a (realToFiberDyadicLine.symm y) =
        r⁻¹ * fiberRadialBracket
          (r⁻¹ • (y - realToFiberDyadicLine a)) := by
    rw [hpair] at hkernel
    simpa [e3ToFiberDyadicCoordinates_faceInsert] using hkernel
  rw [hpoint, hsecond, hkernel']

/-- A literal one-coordinate bracket convolution is bounded by the
transported dyadic ball maximal function. -/
theorem coordinateBracketAverage_le_dyadic
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ x, ‖f x‖ ≤ A)
    (r a : ℝ) (z : TransverseSpace i) (hr : 0 < r) :
    (∫ x : ℝ, ‖f (faceInsert i x z)‖ * bracketKernelAt r a x) ≤
      16 * (coordinateDyadicBallMaximal i f (faceInsert i a z) *
        (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) := by
  rw [coordinateBracketAverage_eq_coordinateFiberRadialBracketAverage
    i f r a z hr]
  exact coordinateFiberRadialBracketAverage_le_dyadic i f hf A hA hbound r hr
    (faceInsert i a z)

/-! ## Reverse coordinate order for the three-fold iteration -/

/-- The coordinate order `2,1,0`, so that Fubini exposes the literal
dyadic iteration in the canonical order `0,1,2`. -/
noncomputable def reverseTripleCoordinates :
    ℝ × (ℝ × ℝ) ≃ᵐ ℝ × (ℝ × ℝ) :=
  (MeasurableEquiv.prodComm.trans
    (MeasurableEquiv.prodCongr MeasurableEquiv.prodComm
      (MeasurableEquiv.refl ℝ))).trans MeasurableEquiv.prodAssoc

@[simp] theorem reverseTripleCoordinates_apply (a b c : ℝ) :
    reverseTripleCoordinates (a, (b, c)) = (c, (b, a)) := by
  simp [reverseTripleCoordinates, MeasurableEquiv.prodComm,
    MeasurableEquiv.prodCongr, MeasurableEquiv.prodAssoc]

/-- The reverse coordinate reordering preserves the three-fold Lebesgue
product measure. -/
theorem reverseTripleCoordinates_measurePreserving :
    MeasurePreserving reverseTripleCoordinates
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
  let hswap₀ : MeasurePreserving (MeasurableEquiv.prodComm :
      ℝ × (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) × ℝ)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))
      (((volume : Measure ℝ).prod volume).prod volume) :=
    Measure.measurePreserving_swap
  let hswap₁ : MeasurePreserving
      (MeasurableEquiv.prodCongr MeasurableEquiv.prodComm
        (MeasurableEquiv.refl ℝ) : (ℝ × ℝ) × ℝ ≃ᵐ (ℝ × ℝ) × ℝ)
      (((volume : Measure ℝ).prod volume).prod volume)
      (((volume : Measure ℝ).prod volume).prod volume) :=
    (Measure.measurePreserving_swap : MeasurePreserving Prod.swap
      ((volume : Measure ℝ).prod volume) ((volume : Measure ℝ).prod volume)).prod
        (MeasurePreserving.id volume)
  let hassoc : MeasurePreserving (MeasurableEquiv.prodAssoc :
      (ℝ × ℝ) × ℝ ≃ᵐ ℝ × (ℝ × ℝ))
      (((volume : Measure ℝ).prod volume).prod volume)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) :=
    measurePreserving_prodAssoc volume volume volume
  exact hassoc.comp (hswap₁.comp hswap₀)

/-- The reverse coordinate map on `E3`. -/
noncomputable def e3ReverseCoordinates :
    E3 ≃ᵐ ℝ × (ℝ × ℝ) :=
  e3Coordinates.trans reverseTripleCoordinates

@[simp] theorem e3ReverseCoordinates_apply (p : E3) :
    e3ReverseCoordinates p = (p 2, (p 1, p 0)) := by
  simp [e3ReverseCoordinates, e3Coordinates_apply]

/-- The reverse coordinate map on `E3` preserves Lebesgue measure. -/
theorem e3ReverseCoordinates_measurePreserving :
    MeasurePreserving e3ReverseCoordinates (volume : Measure E3)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
  exact reverseTripleCoordinates_measurePreserving.comp
    e3Coordinates_measurePreserving

@[simp] theorem e3ReverseCoordinates_symm_modelPoint
    (a b c : ℝ) :
    e3ReverseCoordinates.symm (c, (b, a)) = modelPoint a b c := by
  apply e3ReverseCoordinates.injective
  rw [e3ReverseCoordinates.apply_symm_apply]
  simp

/-- A bounded measurable input remains integrable after multiplication by a
positive anisotropic bracket kernel. -/
theorem integrable_norm_mul_anisotropicBracketKernel
    (α : Anisotropy) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ y, ‖f y‖ ≤ A)
    {t : ℝ} (ht : 0 < t) (p : E3) :
    Integrable (fun y : E3 ↦ ‖f y‖ * anisotropicBracketKernel α t p y) := by
  let K : E3 → ℝ := anisotropicBracketKernel α t p
  have hK : Integrable K := integrable_anisotropicBracketKernel α ht p
  refine (hK.const_mul A).mono
    ((hf.norm.mul (continuous_anisotropicBracketKernel α ht p).measurable).aestronglyMeasurable)
    ?_
  filter_upwards [] with y
  have hKnonneg : 0 ≤ K y := anisotropicBracketKernel_nonneg α ht.le p y
  rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (norm_nonneg _) hKnonneg),
    Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hA hKnonneg)]
  exact mul_le_mul_of_nonneg_right (hbound y) hKnonneg

/-- Fubini opens an anisotropic bracket average in reverse coordinate order.
That order exposes coordinate `0` as the inner integral, matching the
canonical iteration order of the dyadic maximal operator. -/
theorem integral_norm_mul_anisotropicBracketKernel_eq_reverse_nested
    (α : Anisotropy) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ y, ‖f y‖ ≤ A)
    {t : ℝ} (ht : 0 < t) (p : E3) :
    (∫ y : E3, ‖f y‖ * anisotropicBracketKernel α t p y) =
      ∫ y₂ : ℝ, ∫ y₁ : ℝ, ∫ y₀ : ℝ,
        ‖f (modelPoint y₀ y₁ y₂)‖ *
          bracketKernelAt (t ^ α.weight 0) (p 0) y₀ *
          bracketKernelAt (t ^ α.weight 1) (p 1) y₁ *
          bracketKernelAt (t ^ α.weight 2) (p 2) y₂ := by
  let e := e3ReverseCoordinates
  let G : E3 → ℝ := fun y ↦ ‖f y‖ * anisotropicBracketKernel α t p y
  let H : ℝ × (ℝ × ℝ) → ℝ := fun z ↦ G (e.symm z)
  have hG : Integrable G := by
    dsimp only [G]
    exact integrable_norm_mul_anisotropicBracketKernel
      α f hf A hA hbound ht p
  have hmp : MeasurePreserving e (volume : Measure E3)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    simpa only [e] using e3ReverseCoordinates_measurePreserving
  have hH : Integrable H
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    exact (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hG
  calc
    (∫ y : E3, ‖f y‖ * anisotropicBracketKernel α t p y) =
        ∫ z : ℝ × (ℝ × ℝ), H z
          ∂((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
          change (∫ y : E3, G y) = _
          exact (MeasurePreserving.symm e hmp).integral_comp
            e.symm.measurableEmbedding G |>.symm
    _ = ∫ y₂ : ℝ, ∫ y₁ : ℝ, ∫ y₀ : ℝ, H (y₂, (y₁, y₀)) :=
      integral_real_cube_eq_nested H hH
    _ = ∫ y₂ : ℝ, ∫ y₁ : ℝ, ∫ y₀ : ℝ,
        ‖f (modelPoint y₀ y₁ y₂)‖ *
          bracketKernelAt (t ^ α.weight 0) (p 0) y₀ *
          bracketKernelAt (t ^ α.weight 1) (p 1) y₁ *
          bracketKernelAt (t ^ α.weight 2) (p 2) y₂ := by
      apply integral_congr_ae
      filter_upwards [] with y₂
      apply integral_congr_ae
      filter_upwards [] with y₁
      apply integral_congr_ae
      filter_upwards [] with y₀
      have hcoords : e.symm (y₂, (y₁, y₀)) = modelPoint y₀ y₁ y₂ := by
        dsimp only [e]
        exact e3ReverseCoordinates_symm_modelPoint y₀ y₁ y₂
      dsimp only [H, G]
      rw [hcoords]
      simp only [anisotropicBracketKernel, Fin.prod_univ_three,
        modelPoint_zero, modelPoint_one, modelPoint_two]
      ring

/-- The literal positive bracket convolution in one coordinate. -/
noncomputable def coordinateBracketConvolution
    (i : Fin 3) (f : E3 → ℂ) (r : ℝ) (p : E3) : ℝ :=
  ∫ x : ℝ, ‖f (faceInsert i x (coordinateSplit i p).2)‖ *
    bracketKernelAt r (p i) x

/-- Each literal coordinate bracket convolution is nonnegative. -/
theorem coordinateBracketConvolution_nonneg
    (i : Fin 3) (f : E3 → ℂ) (r : ℝ) (p : E3) (hr : 0 ≤ r) :
    0 ≤ coordinateBracketConvolution i f r p := by
  unfold coordinateBracketConvolution
  apply integral_nonneg
  intro x
  exact mul_nonneg (norm_nonneg _) (bracketKernelAt_nonneg hr)

@[simp] theorem norm_complex_coordinateBracketConvolution
    (i : Fin 3) (f : E3 → ℂ) (r : ℝ) (p : E3) (hr : 0 ≤ r) :
    ‖(coordinateBracketConvolution i f r p : ℂ)‖ =
      coordinateBracketConvolution i f r p := by
  rw [Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (coordinateBracketConvolution_nonneg i f r p hr)]

/-- The literal coordinate convolution is exactly the transported radial
bracket average used by the fiber maximal theorem. -/
theorem coordinateBracketConvolution_eq_coordinateFiber
    (i : Fin 3) (f : E3 → ℂ) (r : ℝ) (p : E3) (hr : 0 < r) :
    coordinateBracketConvolution i f r p =
      coordinateFiberRadialBracketAverage i f r p := by
  have hp : faceInsert i (p i) (coordinateSplit i p).2 = p := by
    simpa [coordinateJoin, coordinateSplit] using (coordinateJoin_split i p)
  unfold coordinateBracketConvolution
  rw [coordinateBracketAverage_eq_coordinateFiberRadialBracketAverage
    i f r (p i) (coordinateSplit i p).2 hr, hp]

/-- A bounded measurable coordinate bracket convolution is Borel measurable
in its ambient center. This is the Fubini measurability input needed to
iterate the one-dimensional estimate. -/
theorem coordinateBracketConvolution_measurable
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f) (r : ℝ) :
    Measurable (coordinateBracketConvolution i f r) := by
  let J : E3 × ℝ → ℝ := fun q ↦
    ‖f (faceInsert i q.2 (coordinateSplit i q.1).2)‖ *
      bracketKernelAt r (q.1 i) q.2
  have hsplit : Measurable (fun q : E3 × ℝ ↦ coordinateSplit i q.1) :=
    (coordinateSplit_measurePreserving i).measurable.comp measurable_fst
  have htrans : Measurable (fun q : E3 × ℝ ↦ (coordinateSplit i q.1).2) :=
    measurable_snd.comp hsplit
  have hpair : Measurable (fun q : E3 × ℝ ↦
      (q.2, (coordinateSplit i q.1).2)) :=
    Measurable.prodMk measurable_snd htrans
  have hpoint : Measurable (fun q : E3 × ℝ ↦
      faceInsert i q.2 (coordinateSplit i q.1).2) := by
    change Measurable (coordinateJoin i ∘ fun q : E3 × ℝ ↦
      (q.2, (coordinateSplit i q.1).2))
    exact (coordinateJoin_continuous i).measurable.comp hpair
  have hcenter : Measurable (fun q : E3 × ℝ ↦ q.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp
      measurable_fst
  have hkernel : Measurable (fun q : E3 × ℝ ↦
      bracketKernelAt r (q.1 i) q.2) :=
    measurable_kernelAt bracketKernel continuous_bracketKernel.measurable
      (fun _ : E3 × ℝ ↦ r) (fun q ↦ q.1 i) (fun q ↦ q.2)
      measurable_const hcenter measurable_snd
  have hJ : Measurable J := by
    exact (hf.comp hpoint).norm.mul hkernel
  change Measurable (fun p : E3 ↦ ∫ x : ℝ, J (p, x))
  exact hJ.stronglyMeasurable.integral_prod_right'.measurable

/-- The literal coordinate bracket convolution is bounded by the fiber
dyadic maximal operator with the explicit shell constant. -/
theorem coordinateBracketConvolution_le_dyadic
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ x, ‖f x‖ ≤ A)
    (r : ℝ) (p : E3) (hr : 0 < r) :
    coordinateBracketConvolution i f r p ≤
      16 * (coordinateDyadicBallMaximal i f p *
        (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) := by
  rw [coordinateBracketConvolution_eq_coordinateFiber i f r p hr]
  exact coordinateFiberRadialBracketAverage_le_dyadic i f hf A hA hbound r hr p

/-- The scale-independent shell constant furnished by the one-dimensional
radial-bracket decomposition. -/
noncomputable def dyadicBracketShellConstant : ℝ :=
  16 * (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal

theorem dyadicBracketShellConstant_nonneg :
    0 ≤ dyadicBracketShellConstant := by
  unfold dyadicBracketShellConstant
  exact mul_nonneg (by norm_num) ENNReal.toReal_nonneg

/-- Repackage the one-coordinate shell estimate using its named constant. -/
theorem coordinateBracketConvolution_le_shell_dyadic
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ x, ‖f x‖ ≤ A)
    (r : ℝ) (p : E3) (hr : 0 < r) :
    coordinateBracketConvolution i f r p ≤
      dyadicBracketShellConstant * coordinateDyadicBallMaximal i f p := by
  calc
    coordinateBracketConvolution i f r p ≤
        16 * (coordinateDyadicBallMaximal i f p *
          (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) :=
      coordinateBracketConvolution_le_dyadic i f hf A hA hbound r p hr
    _ = dyadicBracketShellConstant * coordinateDyadicBallMaximal i f p := by
      unfold dyadicBracketShellConstant
      ring

/-- The shell-scaled coordinate maximal function has the expected real norm. -/
theorem norm_shell_smul_coordinateDyadicBallMaximalComplex
    (K : ℝ) (hK : 0 ≤ K) (i : Fin 3) (f : E3 → ℂ) (p : E3) :
    ‖(K : ℂ) • coordinateDyadicBallMaximalComplex i f p‖ =
      K * coordinateDyadicBallMaximal i f p := by
  rw [norm_smul]
  change ‖(K : ℂ)‖ * ‖(coordinateDyadicBallMaximal i f p : ℂ)‖ = _
  rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hK]
  rw [Complex.norm_real]
  change K * |coordinateDyadicBallMaximal i f p| =
    K * coordinateDyadicBallMaximal i f p
  rw [abs_of_nonneg (show 0 ≤ coordinateDyadicBallMaximal i f p from
    ENNReal.toReal_nonneg)]

/-- The literal bracket convolution is uniformly bounded after its shell
comparison, a fact used to feed the next coordinate iteration. -/
theorem coordinateBracketConvolution_bound
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ x, ‖f x‖ ≤ A)
    (r : ℝ) (p : E3) (hr : 0 < r) :
    coordinateBracketConvolution i f r p ≤
      dyadicBracketShellConstant * A := by
  calc
    coordinateBracketConvolution i f r p ≤
        dyadicBracketShellConstant * coordinateDyadicBallMaximal i f p :=
      coordinateBracketConvolution_le_shell_dyadic
        i f hf A hA hbound r p hr
    _ ≤ dyadicBracketShellConstant * A :=
      mul_le_mul_of_nonneg_left
        (coordinateDyadicBallMaximal_top_bound i f A hA hbound p)
        dyadicBracketShellConstant_nonneg

/-- A pointwise norm majorant propagates through one literal bracket
convolution and then through its dyadic shell estimate. -/
theorem coordinateBracketConvolution_le_shell_dyadic_of_norm_le
    (i : Fin 3) (f g : E3 → ℂ) (hf : Measurable f)
    (B : ℝ) (hB : 0 ≤ B) (hgbound : ∀ x, ‖g x‖ ≤ B)
    (hfg : ∀ x, ‖f x‖ ≤ ‖g x‖)
    (r : ℝ) (p : E3) (hr : 0 < r) :
    coordinateBracketConvolution i f r p ≤
      dyadicBracketShellConstant * coordinateDyadicBallMaximal i g p := by
  have hfbound : ∀ x, ‖f x‖ ≤ B := fun x ↦ (hfg x).trans (hgbound x)
  calc
    coordinateBracketConvolution i f r p ≤
        dyadicBracketShellConstant * coordinateDyadicBallMaximal i f p :=
      coordinateBracketConvolution_le_shell_dyadic
        i f hf B hB hfbound r p hr
    _ ≤ dyadicBracketShellConstant * coordinateDyadicBallMaximal i g p :=
      mul_le_mul_of_nonneg_left
        (coordinateDyadicBallMaximal_mono_of_norm_le
          i f g B hB hgbound hfg p)
        dyadicBracketShellConstant_nonneg

/-- The anisotropic bracket average is the literal composition of its three
one-coordinate positive bracket convolutions, in the canonical `0,1,2`
order. -/
theorem integral_norm_mul_anisotropicBracketKernel_eq_iterated
    (α : Anisotropy) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ y, ‖f y‖ ≤ A)
    {t : ℝ} (ht : 0 < t) (p : E3) :
    (∫ y : E3, ‖f y‖ * anisotropicBracketKernel α t p y) =
      coordinateBracketConvolution 2
        (fun q ↦ (coordinateBracketConvolution 1
          (fun q ↦ (coordinateBracketConvolution 0 f
            (t ^ α.weight 0) q : ℂ))
          (t ^ α.weight 1) q : ℂ))
        (t ^ α.weight 2) p := by
  rw [integral_norm_mul_anisotropicBracketKernel_eq_reverse_nested
    α f hf A hA hbound ht p]
  conv_rhs => rw [← modelPoint_components p]
  change
    (∫ y₂ : ℝ, ∫ y₁ : ℝ, ∫ y₀ : ℝ,
      ‖f (modelPoint y₀ y₁ y₂)‖ *
        bracketKernelAt (t ^ α.weight 0) (p 0) y₀ *
        bracketKernelAt (t ^ α.weight 1) (p 1) y₁ *
        bracketKernelAt (t ^ α.weight 2) (p 2) y₂) =
      ∫ y₂ : ℝ,
        ‖(coordinateBracketConvolution 1
          (fun q ↦ (coordinateBracketConvolution 0 f
            (t ^ α.weight 0) q : ℂ))
          (t ^ α.weight 1)
          (faceInsert 2 y₂
            (coordinateSplit 2 (modelPoint (p 0) (p 1) (p 2))).2) : ℂ)‖ *
          bracketKernelAt (t ^ α.weight 2)
            ((modelPoint (p 0) (p 1) (p 2)) 2) y₂
  apply integral_congr_ae
  filter_upwards [] with y₂
  rw [faceInsert_two_coordinateSplit_modelPoint, modelPoint_two,
    norm_complex_coordinateBracketConvolution 1
      (fun q ↦ (coordinateBracketConvolution 0 f
        (t ^ α.weight 0) q : ℂ))
      (t ^ α.weight 1) (modelPoint (p 0) (p 1) y₂) (pow_pos ht _).le]
  calc
    (∫ y₁ : ℝ, ∫ y₀ : ℝ,
      ‖f (modelPoint y₀ y₁ y₂)‖ *
        bracketKernelAt (t ^ α.weight 0) (p 0) y₀ *
        bracketKernelAt (t ^ α.weight 1) (p 1) y₁ *
        bracketKernelAt (t ^ α.weight 2) (p 2) y₂) =
        ∫ y₁ : ℝ,
          (∫ y₀ : ℝ,
            ‖f (modelPoint y₀ y₁ y₂)‖ *
              bracketKernelAt (t ^ α.weight 0) (p 0) y₀ *
              bracketKernelAt (t ^ α.weight 1) (p 1) y₁) *
            bracketKernelAt (t ^ α.weight 2) (p 2) y₂ := by
          apply integral_congr_ae
          filter_upwards [] with y₁
          rw [← integral_mul_const]
    _ = (∫ y₁ : ℝ, ∫ y₀ : ℝ,
          ‖f (modelPoint y₀ y₁ y₂)‖ *
            bracketKernelAt (t ^ α.weight 0) (p 0) y₀ *
            bracketKernelAt (t ^ α.weight 1) (p 1) y₁) *
          bracketKernelAt (t ^ α.weight 2) (p 2) y₂ := by
      rw [integral_mul_const]
    _ = coordinateBracketConvolution 1
          (fun q ↦ (coordinateBracketConvolution 0 f
            (t ^ α.weight 0) q : ℂ))
          (t ^ α.weight 1) (modelPoint (p 0) (p 1) y₂) *
          bracketKernelAt (t ^ α.weight 2) (p 2) y₂ := by
      congr 1
      change (∫ y₁ : ℝ, ∫ y₀ : ℝ,
        ‖f (modelPoint y₀ y₁ y₂)‖ *
          bracketKernelAt (t ^ α.weight 0) (p 0) y₀ *
          bracketKernelAt (t ^ α.weight 1) (p 1) y₁) =
        ∫ y₁ : ℝ,
          ‖(coordinateBracketConvolution 0 f
            (t ^ α.weight 0)
            (faceInsert 1 y₁
              (coordinateSplit 1 (modelPoint (p 0) (p 1) y₂)).2) : ℂ)‖ *
            bracketKernelAt (t ^ α.weight 1)
              ((modelPoint (p 0) (p 1) y₂) 1) y₁
      apply integral_congr_ae
      filter_upwards [] with y₁
      rw [faceInsert_one_coordinateSplit_modelPoint, modelPoint_one,
        norm_complex_coordinateBracketConvolution 0 f
          (t ^ α.weight 0) (modelPoint (p 0) y₁ y₂) (pow_pos ht _).le]
      change (∫ y₀ : ℝ,
        ‖f (modelPoint y₀ y₁ y₂)‖ *
          bracketKernelAt (t ^ α.weight 0) (p 0) y₀ *
          bracketKernelAt (t ^ α.weight 1) (p 1) y₁) =
        (∫ y₀ : ℝ,
          ‖f (faceInsert 0 y₀
            (coordinateSplit 0 (modelPoint (p 0) y₁ y₂)).2)‖ *
            bracketKernelAt (t ^ α.weight 0)
              ((modelPoint (p 0) y₁ y₂) 0) y₀) *
          bracketKernelAt (t ^ α.weight 1) (p 1) y₁
      rw [← integral_mul_const]
      apply integral_congr_ae
      filter_upwards [] with y₀
      rw [faceInsert_zero_coordinateSplit_modelPoint, modelPoint_zero]

/-- Three literal positive coordinate bracket convolutions are dominated by
the shell-scaled three-coordinate dyadic maximal operator. The proof keeps
the shell constant after every stage, matching the operator's definition. -/
theorem integral_norm_mul_anisotropicBracketKernel_le_scaledDyadic
    (α : Anisotropy) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ y, ‖f y‖ ≤ A)
    {t : ℝ} (ht : 0 < t) (p : E3) :
    (∫ y : E3, ‖f y‖ * anisotropicBracketKernel α t p y) ≤
      ‖scaledIteratedCoordinateDyadicBallMaximal
        dyadicBracketShellConstant f p‖ := by
  let K : ℝ := dyadicBracketShellConstant
  let r₀ : ℝ := t ^ α.weight 0
  let r₁ : ℝ := t ^ α.weight 1
  let r₂ : ℝ := t ^ α.weight 2
  let h₀ : E3 → ℂ := fun q ↦
    (coordinateBracketConvolution 0 f r₀ q : ℂ)
  let f₀ : E3 → ℂ := coordinateDyadicBallMaximalComplex 0 f
  let g₀ : E3 → ℂ := (K : ℂ) • f₀
  let h₁ : E3 → ℂ := fun q ↦
    (coordinateBracketConvolution 1 h₀ r₁ q : ℂ)
  let f₁ : E3 → ℂ := coordinateDyadicBallMaximalComplex 1 g₀
  let g₁ : E3 → ℂ := (K : ℂ) • f₁
  have hK : 0 ≤ K := by
    dsimp only [K]
    exact dyadicBracketShellConstant_nonneg
  have hr₀ : 0 < r₀ := by
    dsimp only [r₀]
    exact pow_pos ht _
  have hr₁ : 0 < r₁ := by
    dsimp only [r₁]
    exact pow_pos ht _
  have hr₂ : 0 < r₂ := by
    dsimp only [r₂]
    exact pow_pos ht _
  have hh₀meas : Measurable h₀ := by
    dsimp only [h₀]
    exact Complex.continuous_ofReal.measurable.comp
      (coordinateBracketConvolution_measurable 0 f hf r₀)
  have hf₀meas : Measurable f₀ := by
    dsimp only [f₀]
    exact coordinateDyadicBallMaximalComplex_measurable 0 f hf
  have hg₀meas : Measurable g₀ := by
    dsimp only [g₀]
    exact hf₀meas.const_smul (K : ℂ)
  have hg₀bound : ∀ q, ‖g₀ q‖ ≤ K * A := by
    intro q
    rw [show ‖g₀ q‖ = K * coordinateDyadicBallMaximal 0 f q by
      dsimp only [g₀, f₀]
      exact norm_shell_smul_coordinateDyadicBallMaximalComplex K hK 0 f q]
    exact mul_le_mul_of_nonneg_left
      (coordinateDyadicBallMaximal_top_bound 0 f A hA hbound q) hK
  have hh₀bound : ∀ q, ‖h₀ q‖ ≤ K * A := by
    intro q
    rw [show ‖h₀ q‖ = coordinateBracketConvolution 0 f r₀ q by
      dsimp only [h₀]
      exact norm_complex_coordinateBracketConvolution 0 f r₀ q hr₀.le]
    exact coordinateBracketConvolution_bound 0 f hf A hA hbound r₀ q hr₀
  have hh₀le : ∀ q, ‖h₀ q‖ ≤ ‖g₀ q‖ := by
    intro q
    rw [show ‖h₀ q‖ = coordinateBracketConvolution 0 f r₀ q by
      dsimp only [h₀]
      exact norm_complex_coordinateBracketConvolution 0 f r₀ q hr₀.le,
      show ‖g₀ q‖ = K * coordinateDyadicBallMaximal 0 f q by
        dsimp only [g₀, f₀]
        exact norm_shell_smul_coordinateDyadicBallMaximalComplex K hK 0 f q]
    dsimp only [K]
    exact coordinateBracketConvolution_le_shell_dyadic
      0 f hf A hA hbound r₀ q hr₀
  have hh₁meas : Measurable h₁ := by
    dsimp only [h₁]
    exact Complex.continuous_ofReal.measurable.comp
      (coordinateBracketConvolution_measurable 1 h₀ hh₀meas r₁)
  have hf₁meas : Measurable f₁ := by
    dsimp only [f₁]
    exact coordinateDyadicBallMaximalComplex_measurable 1 g₀ hg₀meas
  have hKA : 0 ≤ K * A := mul_nonneg hK hA
  have hg₁bound : ∀ q, ‖g₁ q‖ ≤ K * (K * A) := by
    intro q
    rw [show ‖g₁ q‖ = K * coordinateDyadicBallMaximal 1 g₀ q by
      dsimp only [g₁, f₁]
      exact norm_shell_smul_coordinateDyadicBallMaximalComplex K hK 1 g₀ q]
    exact mul_le_mul_of_nonneg_left
      (coordinateDyadicBallMaximal_top_bound 1 g₀ (K * A) hKA hg₀bound q) hK
  have hh₁bound : ∀ q, ‖h₁ q‖ ≤ K * (K * A) := by
    intro q
    rw [show ‖h₁ q‖ = coordinateBracketConvolution 1 h₀ r₁ q by
      dsimp only [h₁]
      exact norm_complex_coordinateBracketConvolution 1 h₀ r₁ q hr₁.le]
    exact coordinateBracketConvolution_bound
      1 h₀ hh₀meas (K * A) hKA hh₀bound r₁ q hr₁
  have hh₁le : ∀ q, ‖h₁ q‖ ≤ ‖g₁ q‖ := by
    intro q
    rw [show ‖h₁ q‖ = coordinateBracketConvolution 1 h₀ r₁ q by
      dsimp only [h₁]
      exact norm_complex_coordinateBracketConvolution 1 h₀ r₁ q hr₁.le,
      show ‖g₁ q‖ = K * coordinateDyadicBallMaximal 1 g₀ q by
        dsimp only [g₁, f₁]
        exact norm_shell_smul_coordinateDyadicBallMaximalComplex K hK 1 g₀ q]
    exact coordinateBracketConvolution_le_shell_dyadic_of_norm_le
      1 h₀ g₀ hh₀meas (K * A) hKA hg₀bound hh₀le r₁ q hr₁
  have hfinal :
      coordinateBracketConvolution 2 h₁ r₂ p ≤
        K * coordinateDyadicBallMaximal 2 g₁ p :=
    coordinateBracketConvolution_le_shell_dyadic_of_norm_le
      2 h₁ g₁ hh₁meas (K * (K * A))
        (mul_nonneg hK hKA) hg₁bound hh₁le r₂ p hr₂
  calc
    (∫ y : E3, ‖f y‖ * anisotropicBracketKernel α t p y) =
        coordinateBracketConvolution 2 h₁ r₂ p := by
      rw [integral_norm_mul_anisotropicBracketKernel_eq_iterated
        α f hf A hA hbound ht p]
    _ ≤ K * coordinateDyadicBallMaximal 2 g₁ p := hfinal
    _ = ‖scaledIteratedCoordinateDyadicBallMaximal K f p‖ := by
      change K * coordinateDyadicBallMaximal 2 g₁ p =
        ‖(K : ℂ) • coordinateDyadicBallMaximalComplex 2 g₁ p‖
      rw [norm_shell_smul_coordinateDyadicBallMaximalComplex K hK]


/-! ## Fixed-scale scalar moment majorants -/

/-- A fixed-scale second moment is dominated by the shell-scaled iterated
dyadic maximal function of any Schwartz representative whose norm is the
literal square. This form leaves the choice of power representative to the
stopping construction. -/
theorem cubeSecondMoment_le_scaledDyadic_of_norm_eq_square
    (α : Anisotropy) (f : E3 → ℝ) (g : Schwartz3)
    (hpower : ∀ y : E3, ‖g y‖ = f y ^ 2)
    {t : ℝ} (ht : 0 < t) (p : E3) :
    cubeSecondMoment α t p f ≤
      ‖scaledIteratedCoordinateDyadicBallMaximal
        dyadicBracketShellConstant g p‖ := by
  rcases schwartz_continuous_bounded g with ⟨hgcont, A, hA, hgA⟩
  have hmajor := integral_norm_mul_anisotropicBracketKernel_le_scaledDyadic
    α g hgcont.measurable A hA hgA ht p
  calc
    cubeSecondMoment α t p f =
        ∫ y : E3, ‖g y‖ * anisotropicBracketKernel α t p y := by
      unfold cubeSecondMoment
      apply integral_congr_ae
      filter_upwards [] with y
      rw [hpower y]
    _ ≤ ‖scaledIteratedCoordinateDyadicBallMaximal
        dyadicBracketShellConstant g p‖ := hmajor

/-- A fixed-scale fourth moment is dominated by the shell-scaled iterated
dyadic maximal function of any Schwartz representative whose norm is the
literal fourth power. -/
theorem fourthMoment_le_scaledDyadic_of_norm_eq_fourth
    (α : Anisotropy) (f : E3 → ℝ) (g : Schwartz3)
    (hpower : ∀ y : E3, ‖g y‖ = |f y| ^ (4 : ℝ))
    {t : ℝ} (ht : 0 < t) (p : E3) :
    fourthMoment α t p f ≤
      ‖scaledIteratedCoordinateDyadicBallMaximal
        dyadicBracketShellConstant g p‖ := by
  rcases schwartz_continuous_bounded g with ⟨hgcont, A, hA, hgA⟩
  have hmajor := integral_norm_mul_anisotropicBracketKernel_le_scaledDyadic
    α g hgcont.measurable A hA hgA ht p
  calc
    fourthMoment α t p f =
        ∫ y : E3, ‖g y‖ * anisotropicBracketKernel α t p y := by
      unfold fourthMoment
      apply integral_congr_ae
      filter_upwards [] with y
      rw [hpower y]
    _ ≤ ‖scaledIteratedCoordinateDyadicBallMaximal
        dyadicBracketShellConstant g p‖ := hmajor


/-- The strong fiber maximal estimate transports to each literal coordinate
of `E3`, retaining its explicit `L^p` constant. -/
theorem coordinateDyadicBallMaximal_lintegral_bound
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ x, ‖f x‖ ≤ A)
    {p : ℝ} (hp : 1 < p) :
    (∫⁻ x, ENNReal.ofReal (coordinateDyadicBallMaximal i f x ^ p)) ≤
      ENNReal.ofReal p *
        (2 * ENNReal.ofReal 4 * (ENNReal.ofReal (p - 1))⁻¹ *
          (ENNReal.ofReal (2 : ℝ)) ^ (p - 1) *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p) := by
  let e := e3ToFiberDyadicCoordinates i
  let G : FiberDyadicBase × FiberDyadicLine → ℂ := f ∘ e.symm
  have he : MeasurePreserving e volume fiberDyadicMeasure := by
    simpa only [e] using e3ToFiberDyadicCoordinates_measurePreserving i
  have hG : Measurable G := hf.comp e.symm.measurable
  have hGbound : ∀ z, ‖G z‖ ≤ A := by
    intro z
    exact hbound (e.symm z)
  have hfiber := fiberDyadicBallMaximal_lintegral_bound
    G hG ⟨A, hA, hGbound⟩ hp
  have hleft :
      (∫⁻ x, ENNReal.ofReal (coordinateDyadicBallMaximal i f x ^ p)) =
        ∫⁻ z, ENNReal.ofReal (fiberDyadicBallMaximal G z ^ p)
          ∂fiberDyadicMeasure := by
    change (∫⁻ x, ENNReal.ofReal (fiberDyadicBallMaximal G (e x) ^ p)) = _
    exact he.lintegral_comp
      ((fiberDyadicBallMaximal_measurable G hG).pow measurable_const).ennreal_ofReal
  have hright :
      (∫⁻ z, (ENNReal.ofReal ‖G z‖) ^ p ∂fiberDyadicMeasure) =
        ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := by
    simpa only [G, Function.comp_apply, MeasurableEquiv.symm_apply_apply] using
      (he.lintegral_comp ((hG.norm.ennreal_ofReal).pow measurable_const)).symm
  calc
    (∫⁻ x, ENNReal.ofReal (coordinateDyadicBallMaximal i f x ^ p)) =
        ∫⁻ z, ENNReal.ofReal (fiberDyadicBallMaximal G z ^ p)
          ∂fiberDyadicMeasure := hleft
    _ ≤ ENNReal.ofReal p *
        (2 * ENNReal.ofReal 4 * (ENNReal.ofReal (p - 1))⁻¹ *
          (ENNReal.ofReal (2 : ℝ)) ^ (p - 1) *
          ∫⁻ z, (ENNReal.ofReal ‖G z‖) ^ p ∂fiberDyadicMeasure) := hfiber
    _ = ENNReal.ofReal p *
        (2 * ENNReal.ofReal 4 * (ENNReal.ofReal (p - 1))⁻¹ *
          (ENNReal.ofReal (2 : ℝ)) ^ (p - 1) *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p) := by rw [hright]

/-- Complex packaging of the transported estimate preserves the literal
`L^p` integral, because the packaged maximal function is nonnegative real. -/
theorem coordinateDyadicBallMaximalComplex_lintegral_bound
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ x, ‖f x‖ ≤ A)
    {p : ℝ} (hp : 1 < p) :
    (∫⁻ x, (ENNReal.ofReal ‖coordinateDyadicBallMaximalComplex i f x‖) ^ p) ≤
      ENNReal.ofReal p *
        (2 * ENNReal.ofReal 4 * (ENNReal.ofReal (p - 1))⁻¹ *
          (ENNReal.ofReal (2 : ℝ)) ^ (p - 1) *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p) := by
  have h := coordinateDyadicBallMaximal_lintegral_bound
    i f hf A hA hbound hp
  have hpoint (x : E3) :
      ENNReal.ofReal (coordinateDyadicBallMaximal i f x ^ p) =
        (ENNReal.ofReal ‖coordinateDyadicBallMaximalComplex i f x‖) ^ p := by
    have hnon : 0 ≤ coordinateDyadicBallMaximal i f x := ENNReal.toReal_nonneg
    rw [coordinateDyadicBallMaximalComplex, Complex.norm_real,
      Real.norm_eq_abs, abs_of_nonneg hnon,
      ENNReal.ofReal_rpow_of_nonneg hnon (by linarith)]
  calc
    (∫⁻ x, (ENNReal.ofReal ‖coordinateDyadicBallMaximalComplex i f x‖) ^ p) =
        ∫⁻ x, ENNReal.ofReal (coordinateDyadicBallMaximal i f x ^ p) := by
          apply lintegral_congr
          intro x
          exact (hpoint x).symm
    _ ≤ _ := h

/-- Pulling a nonnegative real constant through a complex-valued `L^p`
integral costs exactly its `p`th power. -/
theorem lintegral_norm_const_smul_rpow
    (K : ℝ) (hK : 0 ≤ K) (g : E3 → ℂ) (hg : Measurable g)
    {p : ℝ} (hp : 0 ≤ p) :
    (∫⁻ x, (ENNReal.ofReal ‖(K : ℂ) • g x‖) ^ p) =
      (ENNReal.ofReal K) ^ p *
        ∫⁻ x, (ENNReal.ofReal ‖g x‖) ^ p := by
  have hpoint (x : E3) :
      (ENNReal.ofReal ‖(K : ℂ) • g x‖) ^ p =
        (ENNReal.ofReal K) ^ p * (ENNReal.ofReal ‖g x‖) ^ p := by
    rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hK,
      ENNReal.ofReal_mul hK, ENNReal.mul_rpow_of_nonneg _ _ hp]
  calc
    (∫⁻ x, (ENNReal.ofReal ‖(K : ℂ) • g x‖) ^ p) =
        ∫⁻ x, (ENNReal.ofReal K) ^ p * (ENNReal.ofReal ‖g x‖) ^ p := by
          apply lintegral_congr
          intro x
          exact hpoint x
    _ = (ENNReal.ofReal K) ^ p *
        ∫⁻ x, (ENNReal.ofReal ‖g x‖) ^ p := by
          rw [lintegral_const_mul]
          exact (hg.norm.ennreal_ofReal.pow measurable_const)

/-- The explicit one-coordinate strong-type factor, including one shell
constant from the bracket-to-dyadic comparison. -/
noncomputable def dyadicStrongFactor (K p : ℝ) : ℝ≥0∞ :=
  (ENNReal.ofReal K) ^ p *
    (ENNReal.ofReal p *
      (2 * ENNReal.ofReal 4 * (ENNReal.ofReal (p - 1))⁻¹ *
        (ENNReal.ofReal (2 : ℝ)) ^ (p - 1)))

/-- Three successive literal-coordinate dyadic maximal operations have an
explicit strong `L^p` bound. This is the quantitative upgrade of the
earlier `MemLp`-only terminal. -/
theorem scaledIteratedCoordinateDyadicBallMaximal_lintegral_bound
    (K : ℝ) (hK : 0 ≤ K) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ x, ‖f x‖ ≤ A)
    {p : ℝ} (hp : 1 < p) :
    (∫⁻ x, (ENNReal.ofReal
      ‖scaledIteratedCoordinateDyadicBallMaximal K f x‖) ^ p) ≤
      (dyadicStrongFactor K p) ^ 3 *
        ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := by
  let D : ℝ≥0∞ := ENNReal.ofReal p *
    (2 * ENNReal.ofReal 4 * (ENNReal.ofReal (p - 1))⁻¹ *
      (ENNReal.ofReal (2 : ℝ)) ^ (p - 1))
  let k : ℝ≥0∞ := (ENNReal.ofReal K) ^ p
  let f₀ : E3 → ℂ := coordinateDyadicBallMaximalComplex 0 f
  let g₀ : E3 → ℂ := (K : ℂ) • f₀
  let f₁ : E3 → ℂ := coordinateDyadicBallMaximalComplex 1 g₀
  let g₁ : E3 → ℂ := (K : ℂ) • f₁
  let f₂ : E3 → ℂ := coordinateDyadicBallMaximalComplex 2 g₁
  have hnormK : ‖(K : ℂ)‖ = K := by
    simp only [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hK]
  have hf₀ : Measurable f₀ := by
    dsimp only [f₀]
    exact coordinateDyadicBallMaximalComplex_measurable 0 f hf
  have hbound₀ : ∀ x, ‖f₀ x‖ ≤ A := by
    dsimp only [f₀]
    exact coordinateDyadicBallMaximalComplex_top_bound 0 f A hA hbound
  have hD₀ : (∫⁻ x, (ENNReal.ofReal ‖f₀ x‖) ^ p) ≤
      D * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := by
    simpa only [D, mul_assoc] using
      (coordinateDyadicBallMaximalComplex_lintegral_bound
        0 f hf A hA hbound hp)
  have hg₀ : Measurable g₀ := by
    dsimp only [g₀]
    exact hf₀.const_smul (K : ℂ)
  have hKA : 0 ≤ K * A := mul_nonneg hK hA
  have hboundg₀ : ∀ x, ‖g₀ x‖ ≤ K * A := by
    intro x
    change ‖(K : ℂ) • f₀ x‖ ≤ K * A
    rw [norm_smul, hnormK]
    exact mul_le_mul_of_nonneg_left (hbound₀ x) hK
  have hf₁ : Measurable f₁ := by
    dsimp only [f₁]
    exact coordinateDyadicBallMaximalComplex_measurable 1 g₀ hg₀
  have hbound₁ : ∀ x, ‖f₁ x‖ ≤ K * A := by
    dsimp only [f₁]
    exact coordinateDyadicBallMaximalComplex_top_bound 1 g₀
      (K * A) hKA hboundg₀
  have hD₁ : (∫⁻ x, (ENNReal.ofReal ‖f₁ x‖) ^ p) ≤
      D * ∫⁻ x, (ENNReal.ofReal ‖g₀ x‖) ^ p := by
    simpa only [D, mul_assoc] using
      (coordinateDyadicBallMaximalComplex_lintegral_bound
        1 g₀ hg₀ (K * A) hKA hboundg₀ hp)
  have hg₁ : Measurable g₁ := by
    dsimp only [g₁]
    exact hf₁.const_smul (K : ℂ)
  have hKKA : 0 ≤ K * (K * A) := mul_nonneg hK hKA
  have hboundg₁ : ∀ x, ‖g₁ x‖ ≤ K * (K * A) := by
    intro x
    change ‖(K : ℂ) • f₁ x‖ ≤ K * (K * A)
    rw [norm_smul, hnormK]
    exact mul_le_mul_of_nonneg_left (hbound₁ x) hK
  have hf₂ : Measurable f₂ := by
    dsimp only [f₂]
    exact coordinateDyadicBallMaximalComplex_measurable 2 g₁ hg₁
  have hD₂ : (∫⁻ x, (ENNReal.ofReal ‖f₂ x‖) ^ p) ≤
      D * ∫⁻ x, (ENNReal.ofReal ‖g₁ x‖) ^ p := by
    simpa only [D, mul_assoc] using
      (coordinateDyadicBallMaximalComplex_lintegral_bound
        2 g₁ hg₁ (K * (K * A)) hKKA hboundg₁ hp)
  have hk₀ : (∫⁻ x, (ENNReal.ofReal ‖g₀ x‖) ^ p) =
      k * ∫⁻ x, (ENNReal.ofReal ‖f₀ x‖) ^ p := by
    simpa only [g₀, Pi.smul_apply, k] using
      (lintegral_norm_const_smul_rpow K hK f₀ hf₀ (by linarith))
  have hk₁ : (∫⁻ x, (ENNReal.ofReal ‖g₁ x‖) ^ p) =
      k * ∫⁻ x, (ENNReal.ofReal ‖f₁ x‖) ^ p := by
    simpa only [g₁, Pi.smul_apply, k] using
      (lintegral_norm_const_smul_rpow K hK f₁ hf₁ (by linarith))
  have hG₀ : (∫⁻ x, (ENNReal.ofReal ‖g₀ x‖) ^ p) ≤
      (k * D) * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := by
    calc
      (∫⁻ x, (ENNReal.ofReal ‖g₀ x‖) ^ p) =
          k * ∫⁻ x, (ENNReal.ofReal ‖f₀ x‖) ^ p := hk₀
      _ ≤ k * (D * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p) :=
        mul_le_mul_of_nonneg_left hD₀ bot_le
      _ = (k * D) * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := by ring
  have hG₁ : (∫⁻ x, (ENNReal.ofReal ‖g₁ x‖) ^ p) ≤
      (k * D) ^ 2 * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := by
    calc
      (∫⁻ x, (ENNReal.ofReal ‖g₁ x‖) ^ p) =
          k * ∫⁻ x, (ENNReal.ofReal ‖f₁ x‖) ^ p := hk₁
      _ ≤ k * (D * ∫⁻ x, (ENNReal.ofReal ‖g₀ x‖) ^ p) :=
        mul_le_mul_of_nonneg_left hD₁ bot_le
      _ ≤ k * (D * ((k * D) * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p)) :=
        mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_left hG₀ bot_le) bot_le
      _ = (k * D) ^ 2 * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := by ring
  have hk₂ : (∫⁻ x, (ENNReal.ofReal ‖(K : ℂ) • f₂ x‖) ^ p) =
      k * ∫⁻ x, (ENNReal.ofReal ‖f₂ x‖) ^ p := by
    simpa only [k] using
      (lintegral_norm_const_smul_rpow K hK f₂ hf₂ (by linarith))
  change (∫⁻ x, (ENNReal.ofReal ‖(K : ℂ) • f₂ x‖) ^ p) ≤ _
  calc
    (∫⁻ x, (ENNReal.ofReal ‖(K : ℂ) • f₂ x‖) ^ p) =
        k * ∫⁻ x, (ENNReal.ofReal ‖f₂ x‖) ^ p := hk₂
    _ ≤ k * (D * ∫⁻ x, (ENNReal.ofReal ‖g₁ x‖) ^ p) :=
      mul_le_mul_of_nonneg_left hD₂ bot_le
    _ ≤ k * (D * ((k * D) ^ 2 *
        ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p)) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hG₁ bot_le) bot_le
    _ = (dyadicStrongFactor K p) ^ 3 *
        ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := by
      dsimp only [dyadicStrongFactor, k, D]
      ring


/-- The explicit three-coordinate strong factor is finite above the
strong-type endpoint. -/
theorem dyadicStrongFactor_ne_top
    (K p : ℝ) (hp : 1 < p) :
    dyadicStrongFactor K p ≠ ∞ := by
  unfold dyadicStrongFactor
  apply ENNReal.mul_ne_top
  · apply ne_of_lt
    exact ENNReal.rpow_lt_top_of_nonneg (by linarith) ENNReal.ofReal_ne_top
  · apply ENNReal.mul_ne_top ENNReal.ofReal_ne_top
    apply ENNReal.mul_ne_top
    · apply ENNReal.mul_ne_top
      · exact ENNReal.mul_ne_top (by norm_num) ENNReal.ofReal_ne_top
      · apply ne_of_lt
        exact ENNReal.inv_lt_top.mpr (ENNReal.ofReal_pos.mpr (by linarith))
    · apply ne_of_lt
      exact ENNReal.rpow_lt_top_of_nonneg (by linarith) ENNReal.ofReal_ne_top

/-- Convert the raw `lintegral` strong estimate to the ordinary nonnegative
real integral used by the stopping distribution. -/
theorem scaledIteratedCoordinateDyadicBallMaximal_integral_bound
    (K : ℝ) (hK : 0 ≤ K) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ x, ‖f x‖ ≤ A)
    {p : ℝ} (hp : 1 < p) (hfp : MemLp f (ENNReal.ofReal p) volume) :
    ∫ x : E3, ‖scaledIteratedCoordinateDyadicBallMaximal K f x‖ ^ p ≤
      (dyadicStrongFactor K p ^ 3).toReal *
        ∫ x : E3, ‖f x‖ ^ p := by
  let G := scaledIteratedCoordinateDyadicBallMaximal K f
  have hp0 : 0 < p := by linarith
  have hGmem : MemLp G (ENNReal.ofReal p) volume := by
    dsimp only [G]
    exact scaledIteratedCoordinateDyadicBallMaximal_memLp
      K hK f hf A hA hbound hp hfp
  have hGin : Integrable (fun x : E3 ↦ ‖G x‖ ^ p) := by
    have h := hGmem.integrable_norm_rpow
      (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top
    simpa only [ENNReal.toReal_ofReal hp0.le] using h
  have hfin : Integrable (fun x : E3 ↦ ‖f x‖ ^ p) := by
    have h := hfp.integrable_norm_rpow
      (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top
    simpa only [ENNReal.toReal_ofReal hp0.le] using h
  have hG_eq :
      (∫⁻ x, (ENNReal.ofReal ‖G x‖) ^ p) =
        ENNReal.ofReal (∫ x : E3, ‖G x‖ ^ p) := by
    calc
      (∫⁻ x, (ENNReal.ofReal ‖G x‖) ^ p) =
          ∫⁻ x, ENNReal.ofReal (‖G x‖ ^ p) := by
            apply lintegral_congr
            intro x
            exact ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp0.le
      _ = ENNReal.ofReal (∫ x : E3, ‖G x‖ ^ p) := by
            exact (ofReal_integral_eq_lintegral_ofReal hGin
              (Filter.Eventually.of_forall fun x ↦
                Real.rpow_nonneg (norm_nonneg _) _)).symm
  have hfin_eq :
      (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p) =
        ENNReal.ofReal (∫ x : E3, ‖f x‖ ^ p) := by
    calc
      (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p) =
          ∫⁻ x, ENNReal.ofReal (‖f x‖ ^ p) := by
            apply lintegral_congr
            intro x
            exact ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp0.le
      _ = ENNReal.ofReal (∫ x : E3, ‖f x‖ ^ p) := by
            exact (ofReal_integral_eq_lintegral_ofReal hfin
              (Filter.Eventually.of_forall fun x ↦
                Real.rpow_nonneg (norm_nonneg _) _)).symm
  have hraw := scaledIteratedCoordinateDyadicBallMaximal_lintegral_bound
    K hK f hf A hA hbound hp
  have hfactor : (dyadicStrongFactor K p ^ 3 : ℝ≥0∞) ≠ ∞ := by
    exact ENNReal.pow_ne_top (dyadicStrongFactor_ne_top K p hp)
  have hrighttop :
      (dyadicStrongFactor K p ^ 3 : ℝ≥0∞) *
        ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ≠ ∞ := by
    apply ENNReal.mul_ne_top hfactor
    rw [hfin_eq]
    exact ENNReal.ofReal_ne_top
  have hlefttop : (∫⁻ x, (ENNReal.ofReal ‖G x‖) ^ p) ≠ ∞ :=
    ne_top_of_le_ne_top hrighttop hraw
  have htoReal :=
    (ENNReal.toReal_le_toReal hlefttop hrighttop).mpr hraw
  change ∫ x : E3, ‖G x‖ ^ p ≤ _
  rw [hG_eq, hfin_eq] at htoReal
  rw [ENNReal.toReal_mul,
    ENNReal.toReal_ofReal (integral_nonneg fun x ↦
      Real.rpow_nonneg (norm_nonneg (G x)) _),
    ENNReal.toReal_ofReal (integral_nonneg fun x ↦
      Real.rpow_nonneg (norm_nonneg (f x)) _)] at htoReal
  exact htoReal


/-- The zero-shift dominant-envelope algebra and the scalar layer-cake
estimate reduce the complete finite stopping envelope to four integrable
coordinate majorants. -/
theorem sourceStoppingCoordinateEnvelope_le_of_zero_shift_majorants
    (α : Anisotropy) (S : BoxCollection α) (f : ModelRealInput)
    (q : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hpos : ∀ s ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) s)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (h : Fin 4 → E3 → ℝ)
    (hmajor : ∀ j x, sourceStoppingMaximal α f j x ≤ h j x)
    (hnonneg : ∀ j x, 0 ≤ h j x)
    (hmeas : ∀ j, Measurable (fun x : E3 ↦ h j x ^ q j))
    (hint : ∀ j, Integrable (fun x : E3 ↦ h j x ^ q j)) :
    SourceStoppingCoordinateEnvelope α S f q (fun _ ↦ 0) hpos ≤
      ∑ j : Fin 4, 8 *
        (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
          (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
            ∫ x : E3, h j x ^ q j) := by
  let L : Fin 4 → ℝ := fun j ↦
    ((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
      (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
        ∫ x : E3, h j x ^ q j
  apply SourceStoppingCoordinateEnvelope_le_of_dominant_weight_bound
    α S f q (fun _ ↦ 0) q (fun _ ↦ 8) L hpos
  · intro j
    norm_num
  · intro j m
    rw [sourceStoppingDominantFiberEnvelope_zero_eq q hq hsum j m]
  · intro j
    let N : Finset ℤ :=
      (activeStoppingLevels α S sourceStoppingExponent f hpos).filter
        (fun n ↦ sourceStoppingDominantIndex q (fun _ ↦ 0) n = j) |>.image
          (fun n ↦ n j)
    have hscalar := sum_sourceStoppingLevel_rpow_weight_le_integral_majorant
      α f j (q j) (h j) hcont hbound (hq j)
      (hmajor j) (hnonneg j) (hmeas j) (hint j) N
    change (∑ m ∈ N,
      (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal *
        (2 : ℝ) ^ (q j * (m : ℝ))) ≤ L j
    simpa only [L, mul_comm] using hscalar


/-- Pointwise multiplication closes real Schwartz inputs under the precise
power representatives needed by the two- and four-moment stopping sizes. -/
noncomputable def realSchwartzProduct
    (f g : SchwartzMap E3 ℝ) : SchwartzMap E3 ℝ :=
  SchwartzMap.smulLeftCLM ℝ (f : E3 → ℝ) g

@[simp] theorem realSchwartzProduct_apply
    (f g : SchwartzMap E3 ℝ) (x : E3) :
    realSchwartzProduct f g x = f x * g x := by
  simp [realSchwartzProduct, f.hasTemperateGrowth]

noncomputable def realSchwartzSquare
    (f : SchwartzMap E3 ℝ) : SchwartzMap E3 ℝ :=
  realSchwartzProduct f f

@[simp] theorem realSchwartzSquare_apply
    (f : SchwartzMap E3 ℝ) (x : E3) :
    realSchwartzSquare f x = f x ^ 2 := by
  simp [realSchwartzSquare, pow_two]

noncomputable def realSchwartzFourth
    (f : SchwartzMap E3 ℝ) : SchwartzMap E3 ℝ :=
  realSchwartzSquare (realSchwartzSquare f)

@[simp] theorem realSchwartzFourth_apply
    (f : SchwartzMap E3 ℝ) (x : E3) :
    realSchwartzFourth f x = f x ^ 4 := by
  simp [realSchwartzFourth, pow_succ]
  ring

/-- The shell-scaled iterated dyadic operator is measurable whenever its
input is measurable. -/
theorem scaledIteratedCoordinateDyadicBallMaximal_measurable
    (K : ℝ) (f : E3 → ℂ) (hf : Measurable f) :
    Measurable (scaledIteratedCoordinateDyadicBallMaximal K f) := by
  let f₀ := coordinateDyadicBallMaximalComplex (0 : Fin 3) f
  let g₀ : E3 → ℂ := (K : ℂ) • f₀
  let f₁ := coordinateDyadicBallMaximalComplex (1 : Fin 3) g₀
  let g₁ : E3 → ℂ := (K : ℂ) • f₁
  let f₂ := coordinateDyadicBallMaximalComplex (2 : Fin 3) g₁
  have hf₀ : Measurable f₀ := by
    dsimp only [f₀]
    exact coordinateDyadicBallMaximalComplex_measurable 0 f hf
  have hg₀ : Measurable g₀ := by
    dsimp only [g₀]
    exact hf₀.const_smul (K : ℂ)
  have hf₁ : Measurable f₁ := by
    dsimp only [f₁]
    exact coordinateDyadicBallMaximalComplex_measurable 1 g₀ hg₀
  have hg₁ : Measurable g₁ := by
    dsimp only [g₁]
    exact hf₁.const_smul (K : ℂ)
  have hf₂ : Measurable f₂ := by
    dsimp only [f₂]
    exact coordinateDyadicBallMaximalComplex_measurable 2 g₁ hg₁
  change Measurable ((K : ℂ) • f₂)
  exact hf₂.const_smul (K : ℂ)

/-- The positive real root of a measurable complex majorant is measurable. -/
theorem measurable_norm_rpow
    (G : E3 → ℂ) (hG : Measurable G) (s : ℝ) (hs : 0 ≤ s) :
    Measurable (fun x : E3 ↦ ‖G x‖ ^ s) := by
  exact (Real.continuous_rpow_const hs).measurable.comp hG.norm

/-- The `q`-power of an `s`-root majorant is integrable if the unrooted
majorant belongs to `L^(q/s)`. This is the exact scalar conversion needed by
the stopping layer-cake estimate. -/
theorem integrable_norm_rpow_inv_rpow_of_memLp
    (G : E3 → ℂ) (_hG : Measurable G) (q s : ℝ)
    (hq : 0 < q) (hs : 0 < s)
    (hmem : MemLp G (ENNReal.ofReal (q / s)) volume) :
    Integrable (fun x : E3 ↦ (‖G x‖ ^ s⁻¹) ^ q) volume := by
  have hqdiv : 0 < q / s := div_pos hq hs
  have hbase := hmem.integrable_norm_rpow
    (ne_of_gt (ENNReal.ofReal_pos.mpr hqdiv)) ENNReal.ofReal_ne_top
  have hbase' : Integrable (fun x : E3 ↦ ‖G x‖ ^ (q / s)) volume := by
    simpa [ENNReal.toReal_ofReal hqdiv.le] using hbase
  apply hbase'.congr
  filter_upwards [] with x
  rw [← Real.rpow_mul (norm_nonneg (G x))]
  congr 1
  field_simp

/-- The same root conversion supplies the literal measurable `q`-power used
by the finite stopping envelope. -/
theorem measurable_norm_rpow_inv_rpow
    (G : E3 → ℂ) (hG : Measurable G) (q s : ℝ)
    (hq : 0 < q) (hs : 0 < s) :
    Measurable (fun x : E3 ↦ (‖G x‖ ^ s⁻¹) ^ q) := by
  have heq : (fun x : E3 ↦ (‖G x‖ ^ s⁻¹) ^ q) =
      (fun x : E3 ↦ ‖G x‖ ^ (s⁻¹ * q)) := by
    funext x
    exact (Real.rpow_mul (norm_nonneg (G x)) s⁻¹ q).symm
  rw [heq]
  apply measurable_norm_rpow G hG
  positivity

/-- The stopping exponent is always the positive integer `2` or `4`. -/
theorem sourceStoppingExponent_pos (j : Fin 4) :
    0 < sourceStoppingExponent j := by
  by_cases hj : j = 3
  · simp [sourceStoppingExponent, hj]
  · simp [sourceStoppingExponent, hj]

/-- The Schwartz power representative paired to a source stopping coordinate.
For coordinate three it is the square, and for the other three coordinates it
is the fourth power. -/
noncomputable def sourceStoppingPowerRepresentative
    (F : InitialModelSchwartzInput) (j : Fin 4) : SchwartzMap E3 ℝ :=
  if j = 3 then realSchwartzSquare (F j)
  else realSchwartzFourth (F j)

@[simp] theorem sourceStoppingPowerRepresentative_apply_of_eq_three
    (F : InitialModelSchwartzInput) {j : Fin 4} (hj : j = 3) (x : E3) :
    sourceStoppingPowerRepresentative F j x = (F j x) ^ 2 := by
  simp [sourceStoppingPowerRepresentative, hj]

@[simp] theorem sourceStoppingPowerRepresentative_apply_of_ne_three
    (F : InitialModelSchwartzInput) {j : Fin 4} (hj : j ≠ 3) (x : E3) :
    sourceStoppingPowerRepresentative F j x = (F j x) ^ 4 := by
  simp [sourceStoppingPowerRepresentative, hj]

/-- The complex dyadic majorant associated to the appropriate integral power
of each initial real Schwartz component. -/
noncomputable def sourceStoppingPowerMajorant
    (K : Fin 4 → ℝ) (F : InitialModelSchwartzInput) (j : Fin 4) : E3 → ℂ :=
  scaledIteratedCoordinateDyadicBallMaximal (K j)
    (complexifyRealSchwartz (sourceStoppingPowerRepresentative F j))

/-- The scalar majorant used in the stopping layer-cake: take the `2`nd or
`4`th root only after the full three-coordinate dyadic iteration. -/
noncomputable def sourceStoppingRootMajorant
    (K : Fin 4 → ℝ) (F : InitialModelSchwartzInput) (j : Fin 4) : E3 → ℝ :=
  fun x ↦ ‖sourceStoppingPowerMajorant K F j x‖ ^
    (sourceStoppingExponent j)⁻¹

theorem sourceStoppingPowerMajorant_measurable
    (K : Fin 4 → ℝ) (F : InitialModelSchwartzInput) (j : Fin 4) :
    Measurable (sourceStoppingPowerMajorant K F j) := by
  unfold sourceStoppingPowerMajorant
  apply scaledIteratedCoordinateDyadicBallMaximal_measurable
  exact (complexifyRealSchwartz
    (sourceStoppingPowerRepresentative F j)).continuous.measurable

/-- The dyadic majorant of the requisite power representative belongs to
`L^(q/s)` whenever the source exponent `s` is strictly below `q`. -/
theorem sourceStoppingPowerMajorant_memLp
    (K : Fin 4 → ℝ) (hK : ∀ j, 0 ≤ K j)
    (F : InitialModelSchwartzInput) (j : Fin 4) (q : ℝ)
    (hqs : sourceStoppingExponent j < q) :
    MemLp (sourceStoppingPowerMajorant K F j)
      (ENNReal.ofReal (q / sourceStoppingExponent j)) volume := by
  have hs : 0 < sourceStoppingExponent j := sourceStoppingExponent_pos j
  have hp : 1 < q / sourceStoppingExponent j := by
    rw [lt_div_iff₀ hs]
    simpa using hqs
  unfold sourceStoppingPowerMajorant
  exact scaledIteratedCoordinateDyadicBallMaximal_memLp_of_realSchwartz
    (K j) (hK j) (sourceStoppingPowerRepresentative F j) hp

theorem sourceStoppingRootMajorant_nonneg
    (K : Fin 4 → ℝ) (F : InitialModelSchwartzInput) (j : Fin 4) (x : E3) :
    0 ≤ sourceStoppingRootMajorant K F j x := by
  unfold sourceStoppingRootMajorant
  exact Real.rpow_nonneg (norm_nonneg _) _

theorem sourceStoppingRootMajorant_power_measurable
    (K : Fin 4 → ℝ) (F : InitialModelSchwartzInput) (j : Fin 4) (q : ℝ)
    (hq : 0 < q) :
    Measurable (fun x : E3 ↦
      sourceStoppingRootMajorant K F j x ^ q) := by
  unfold sourceStoppingRootMajorant
  exact measurable_norm_rpow_inv_rpow _
    (sourceStoppingPowerMajorant_measurable K F j) q
    (sourceStoppingExponent j) hq (sourceStoppingExponent_pos j)

theorem sourceStoppingRootMajorant_power_integrable
    (K : Fin 4 → ℝ) (hK : ∀ j, 0 ≤ K j)
    (F : InitialModelSchwartzInput) (j : Fin 4) (q : ℝ)
    (hqs : sourceStoppingExponent j < q) :
    Integrable (fun x : E3 ↦
      sourceStoppingRootMajorant K F j x ^ q) volume := by
  have hq : 0 < q :=
    (sourceStoppingExponent_pos j).trans hqs
  unfold sourceStoppingRootMajorant
  exact integrable_norm_rpow_inv_rpow_of_memLp _
    (sourceStoppingPowerMajorant_measurable K F j) q
    (sourceStoppingExponent j) hq (sourceStoppingExponent_pos j)
    (sourceStoppingPowerMajorant_memLp K hK F j q hqs)

/-- In particular, the root majorant itself is in the intended stopping
space `L^q` whenever `q` lies strictly above the associated source exponent. -/
theorem sourceStoppingRootMajorant_memLp
    (K : Fin 4 → ℝ) (hK : ∀ j, 0 ≤ K j)
    (F : InitialModelSchwartzInput) (j : Fin 4) (q : ℝ)
    (hqs : sourceStoppingExponent j < q) :
    MemLp (sourceStoppingRootMajorant K F j)
      (ENNReal.ofReal q) volume := by
  have hq : 0 < q := (sourceStoppingExponent_pos j).trans hqs
  have hmeas : Measurable (sourceStoppingRootMajorant K F j) := by
    unfold sourceStoppingRootMajorant
    exact measurable_norm_rpow _
      (sourceStoppingPowerMajorant_measurable K F j) _
      (inv_nonneg.mpr (sourceStoppingExponent_pos j).le)
  apply (integrable_norm_rpow_iff hmeas.aestronglyMeasurable
    (ne_of_gt (ENNReal.ofReal_pos.mpr hq)) ENNReal.ofReal_ne_top).mp
  have hint := sourceStoppingRootMajorant_power_integrable
    K hK F j q hqs
  apply hint.congr
  filter_upwards [] with x
  rw [ENNReal.toReal_ofReal hq.le, Real.norm_eq_abs,
    abs_of_nonneg (sourceStoppingRootMajorant_nonneg K F j x)]

/-- The quantitative three-coordinate dyadic estimate specialized to the
power representative at one stopping coordinate. This is still expressed
in terms of that representative, before the elementary `s`th-power algebra
returns to the original input. -/
theorem sourceStoppingPowerMajorant_integral_bound
    (K : Fin 4 → ℝ) (hK : ∀ j, 0 ≤ K j)
    (F : InitialModelSchwartzInput) (j : Fin 4) (q : ℝ)
    (hqs : sourceStoppingExponent j < q) :
    (∫ x : E3, ‖sourceStoppingPowerMajorant K F j x‖ ^
      (q / sourceStoppingExponent j)) ≤
      ((dyadicStrongFactor (K j)
        (q / sourceStoppingExponent j)) ^ 3).toReal *
        ∫ x : E3, ‖complexifyRealSchwartz
          (sourceStoppingPowerRepresentative F j) x‖ ^
          (q / sourceStoppingExponent j) := by
  let s : ℝ := sourceStoppingExponent j
  let p : ℝ := q / s
  have hs : 0 < s := by
    dsimp only [s]
    exact sourceStoppingExponent_pos j
  have hp : 1 < p := by
    dsimp only [p]
    rw [lt_div_iff₀ hs]
    simpa only [s, one_mul] using hqs
  let f : E3 → ℂ := complexifyRealSchwartz
    (sourceStoppingPowerRepresentative F j)
  let G : E3 → ℂ := sourceStoppingPowerMajorant K F j
  rcases schwartz_continuous_bounded
    (complexifyRealSchwartz (sourceStoppingPowerRepresentative F j)) with
    ⟨hcont, A, hA, hbound⟩
  have hf : Measurable f := by
    dsimp only [f]
    exact hcont.measurable
  have hboundf : ∀ x, ‖f x‖ ≤ A := by
    simpa only [f] using hbound
  have hfp : MemLp f (ENNReal.ofReal p) volume := by
    dsimp only [f]
    exact schwartz_memLp (complexifyRealSchwartz
      (sourceStoppingPowerRepresentative F j)) (ENNReal.ofReal p)
  change (∫ x : E3, ‖G x‖ ^ p) ≤
    ((dyadicStrongFactor (K j) p) ^ 3).toReal *
      ∫ x : E3, ‖f x‖ ^ p
  dsimp only [G]
  exact scaledIteratedCoordinateDyadicBallMaximal_integral_bound
    (K j) (hK j) f hf A hA hboundf hp hfp

/-- The `L^(q/s)` power of the squared/fourth-powered Schwartz representative
is exactly the `L^q` power of the original real input. -/
theorem sourceStoppingPowerRepresentative_norm_rpow_eq_input_rpow
    (F : InitialModelSchwartzInput) (j : Fin 4) (q : ℝ) (x : E3) :
    ‖complexifyRealSchwartz (sourceStoppingPowerRepresentative F j) x‖ ^
      (q / sourceStoppingExponent j) = |F j x| ^ q := by
  by_cases hj : j = 3
  · subst j
    rw [complexifyRealSchwartz_apply,
      sourceStoppingPowerRepresentative_apply_of_eq_three F rfl,
      Complex.norm_real, Real.norm_eq_abs,
      abs_pow]
    rw [show sourceStoppingExponent 3 = 2 by simp [sourceStoppingExponent],
      ← Real.rpow_natCast (|F 3 x|) 2,
      ← Real.rpow_mul (abs_nonneg (F 3 x))]
    congr 1
    field_simp
    ring
  · rw [complexifyRealSchwartz_apply,
      sourceStoppingPowerRepresentative_apply_of_ne_three F hj,
      Complex.norm_real, Real.norm_eq_abs,
      abs_pow]
    rw [sourceStoppingExponent_eq_four_of_ne_three hj,
      ← Real.rpow_natCast (|F j x|) 4,
      ← Real.rpow_mul (abs_nonneg (F j x))]
    congr 1
    field_simp
    ring

/-- The coefficient multiplying each scalar distribution integral is
nonnegative as soon as its stopping exponent is positive. -/
theorem sourceStoppingDistributionCoefficient_nonneg
    (j : Fin 4) (q : ℝ) (hq : 0 < q) :
    0 ≤ 8 * ((1 - ((2 : ℝ) ^ q)⁻¹)⁻¹ *
      (sourceStoppingComparisonConstant j / 2) ^ (-q)) := by
  have hpow : 1 < (2 : ℝ) ^ q :=
    Real.one_lt_rpow (by norm_num) hq
  have hpowpos : 0 < (2 : ℝ) ^ q :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hden : 0 < 1 - ((2 : ℝ) ^ q)⁻¹ := by
    exact sub_pos.mpr ((inv_lt_one₀ hpowpos).mpr hpow)
  have hconst : 0 < sourceStoppingComparisonConstant j / 2 :=
    div_pos (sourceStoppingComparisonConstant_pos j) (by norm_num)
  exact (mul_pos (by norm_num)
    (mul_pos (inv_pos.mpr hden) (Real.rpow_pos_of_pos hconst _))).le

/-- The explicit scalar multiplying the `q_j`-power integral of one initial
input after the three-coordinate dyadic strong-type estimate. -/
noncomputable def sourceStoppingDyadicInputConstant
    (K q : Fin 4 → ℝ) (j : Fin 4) : ℝ :=
  8 * (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
    (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
      (dyadicStrongFactor (K j)
        (q j / sourceStoppingExponent j) ^ 3).toReal)

/-- The weighted scalar distribution term for one coordinate is controlled
by its original `q_j`-power input integral, with a fully explicit constant. -/
theorem weightedPowerMajorantIntegral_le_inputPowerIntegral
    (K q : Fin 4 → ℝ) (hK : ∀ j, 0 ≤ K j)
    (F : InitialModelSchwartzInput) (j : Fin 4)
    (hq : 0 < q j) (hqs : sourceStoppingExponent j < q j) :
    8 * (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
      (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
        ∫ x : E3, ‖sourceStoppingPowerMajorant K F j x‖ ^
          (q j / sourceStoppingExponent j)) ≤
      sourceStoppingDyadicInputConstant K q j *
        ∫ x : E3, |F j x| ^ q j := by
  let c : ℝ := 8 * ((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
    (sourceStoppingComparisonConstant j / 2) ^ (-(q j)))
  let D : ℝ := (dyadicStrongFactor (K j)
    (q j / sourceStoppingExponent j) ^ 3).toReal
  have hc : 0 ≤ c := by
    dsimp only [c]
    exact sourceStoppingDistributionCoefficient_nonneg j (q j) hq
  have hstrong := sourceStoppingPowerMajorant_integral_bound
    K hK F j (q j) hqs
  have hrep :
      (∫ x : E3, ‖complexifyRealSchwartz
        (sourceStoppingPowerRepresentative F j) x‖ ^
          (q j / sourceStoppingExponent j)) =
        ∫ x : E3, |F j x| ^ q j := by
    apply integral_congr_ae
    filter_upwards [] with x
    exact sourceStoppingPowerRepresentative_norm_rpow_eq_input_rpow
      F j (q j) x
  calc
    8 * (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
        (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
          ∫ x : E3, ‖sourceStoppingPowerMajorant K F j x‖ ^
            (q j / sourceStoppingExponent j)) =
        c * (∫ x : E3, ‖sourceStoppingPowerMajorant K F j x‖ ^
          (q j / sourceStoppingExponent j)) := by
        dsimp only [c]
        ring
    _ ≤ c * (D * ∫ x : E3, ‖complexifyRealSchwartz
          (sourceStoppingPowerRepresentative F j) x‖ ^
            (q j / sourceStoppingExponent j)) :=
      mul_le_mul_of_nonneg_left hstrong hc
    _ = sourceStoppingDyadicInputConstant K q j *
        ∫ x : E3, |F j x| ^ q j := by
      rw [hrep]
      dsimp only [sourceStoppingDyadicInputConstant, c, D]
      ring

/-- A uniform fixed-scale scalar bound closes the literal real supremum in
the second maximal power without any additional analytic loss. -/
theorem anisotropicMaximalTwoPower_le_of_fixedScale_scalar_bound
    (α : Anisotropy) (f : SchwartzMap E3 ℝ) (H : E3 → ℝ)
    (hfixed : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      cubeSecondMoment α t x f ≤ H x)
    (x : E3) :
    anisotropicMaximalTwoPower α f x ≤ H x := by
  unfold anisotropicMaximalTwoPower
  apply csSup_le
  · exact ⟨cubeSecondMoment α 1 x f, ⟨1, by norm_num, rfl⟩⟩
  · rintro a ⟨t, ht, rfl⟩
    exact hfixed t ht x

/-- The same all-scale closure for the fourth maximal power. -/
theorem anisotropicMaximalFourPower_le_of_fixedScale_scalar_bound
    (α : Anisotropy) (f : SchwartzMap E3 ℝ) (H : E3 → ℝ)
    (hfixed : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      fourthMoment α t x f ≤ H x)
    (x : E3) :
    anisotropicMaximalFourPower α f x ≤ H x := by
  unfold anisotropicMaximalFourPower
  apply csSup_le
  · exact ⟨fourthMoment α 1 x f, ⟨1, by norm_num, rfl⟩⟩
  · rintro a ⟨t, ht, rfl⟩
    exact hfixed t ht x

/-- The literal source stopping maximal is controlled by the root of its
three-coordinate dyadic power majorant once the second/fourth fixed-scale
kernel bounds have been supplied. -/
theorem sourceStoppingMaximal_le_rootMajorant_of_fixedScale
    (α : Anisotropy) (K : Fin 4 → ℝ) (F : InitialModelSchwartzInput)
    (htwo : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      cubeSecondMoment α t x (F 3) ≤
        ‖sourceStoppingPowerMajorant K F 3 x‖)
    (hfour : ∀ (j : Fin 4), j ≠ 3 → ∀ (t : ℝ), 0 < t → ∀ x : E3,
      fourthMoment α t x (F j) ≤
        ‖sourceStoppingPowerMajorant K F j x‖)
    (j : Fin 4) (x : E3) :
    sourceStoppingMaximal α (InitialModelRealInput F) j x ≤
      sourceStoppingRootMajorant K F j x := by
  by_cases hj : j = 3
  · subst j
    change √(anisotropicMaximalTwoPower α (F 3) x) ≤
      ‖sourceStoppingPowerMajorant K F 3 x‖ ^
        (sourceStoppingExponent 3)⁻¹
    have hpower : anisotropicMaximalTwoPower α (F 3) x ≤
        ‖sourceStoppingPowerMajorant K F 3 x‖ :=
      anisotropicMaximalTwoPower_le_of_fixedScale_scalar_bound
        α (F 3) _ htwo x
    calc
      √(anisotropicMaximalTwoPower α (F 3) x) ≤
          √‖sourceStoppingPowerMajorant K F 3 x‖ :=
        Real.sqrt_le_sqrt hpower
      _ = ‖sourceStoppingPowerMajorant K F 3 x‖ ^
          (sourceStoppingExponent 3)⁻¹ := by
        rw [Real.sqrt_eq_rpow]
        simp [sourceStoppingExponent]
  · simp only [sourceStoppingMaximal, hj, ite_false]
    unfold sourceStoppingRootMajorant
    change anisotropicMaximalFourPower α (F j) x ^ ((4 : ℝ)⁻¹) ≤
      ‖sourceStoppingPowerMajorant K F j x‖ ^
        (sourceStoppingExponent j)⁻¹
    have hpower : anisotropicMaximalFourPower α (F j) x ≤
        ‖sourceStoppingPowerMajorant K F j x‖ :=
      anisotropicMaximalFourPower_le_of_fixedScale_scalar_bound
        α (F j) _ (hfour j hj) x
    rcases initialModelRealInput_bounded F j with ⟨B, hB, hbound⟩
    have hpower_nonneg : 0 ≤ anisotropicMaximalFourPower α (F j) x :=
      anisotropicMaximalFourPower_nonneg_of_boundedContinuous α (F j)
        (F j).continuous B hB (by simpa [InitialModelRealInput] using hbound) x
    calc
      anisotropicMaximalFourPower α (F j) x ^ ((4 : ℝ)⁻¹) ≤
          ‖sourceStoppingPowerMajorant K F j x‖ ^ ((4 : ℝ)⁻¹) :=
        Real.rpow_le_rpow hpower_nonneg hpower (by positivity)
      _ = ‖sourceStoppingPowerMajorant K F j x‖ ^
          (sourceStoppingExponent j)⁻¹ := by
        rw [sourceStoppingExponent_eq_four_of_ne_three hj]

/-- The initial finite stopping distribution is bounded by the four literal
dyadic power-majorant integrals. The only analytic inputs are the fixed-scale
second/fourth bracket bounds; all root, measurability, `L^(q/s)`, and
layer-cake bookkeeping is discharged here. -/
theorem initialSourceStoppingCoordinateEnvelope_le_powerDyadic
    (α : Anisotropy) (S : BoxCollection α) (F : InitialModelSchwartzInput)
    (q K : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j)
    (hK : ∀ j, 0 ≤ K j)
    (hFnonzero : ∀ j, F j ≠ 0)
    (htwo : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      cubeSecondMoment α t x (F 3) ≤
        ‖sourceStoppingPowerMajorant K F 3 x‖)
    (hfour : ∀ (j : Fin 4), j ≠ 3 → ∀ (t : ℝ), 0 < t → ∀ x : E3,
      fourthMoment α t x (F j) ≤
        ‖sourceStoppingPowerMajorant K F j x‖) :
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
      (fun _ ↦ 0)
      (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
      ∑ j : Fin 4, 8 *
        (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
          (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
            ∫ x : E3,
              sourceStoppingRootMajorant K F j x ^ q j) := by
  exact sourceStoppingCoordinateEnvelope_le_of_zero_shift_majorants
    α S (InitialModelRealInput F) q hq hsum
    (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero)
    (initialModelRealInput_continuous F) (initialModelRealInput_bounded F)
    (sourceStoppingRootMajorant K F)
    (fun j x ↦ sourceStoppingMaximal_le_rootMajorant_of_fixedScale
      α K F htwo hfour j x)
    (fun j x ↦ sourceStoppingRootMajorant_nonneg K F j x)
    (fun j ↦ sourceStoppingRootMajorant_power_measurable K F j
      (q j) (hq j))
    (fun j ↦ sourceStoppingRootMajorant_power_integrable K hK F j
      (q j) (hqs j))

/-- Equivalent product-norm-ready form of the initial stopping distribution:
the displayed integral is the `q_j / s_j` power integral of the unrooted
three-coordinate dyadic majorant. -/
theorem initialSourceStoppingCoordinateEnvelope_le_powerDyadic_unrooted
    (α : Anisotropy) (S : BoxCollection α) (F : InitialModelSchwartzInput)
    (q K : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j)
    (hK : ∀ j, 0 ≤ K j)
    (hFnonzero : ∀ j, F j ≠ 0)
    (htwo : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      cubeSecondMoment α t x (F 3) ≤
        ‖sourceStoppingPowerMajorant K F 3 x‖)
    (hfour : ∀ (j : Fin 4), j ≠ 3 → ∀ (t : ℝ), 0 < t → ∀ x : E3,
      fourthMoment α t x (F j) ≤
        ‖sourceStoppingPowerMajorant K F j x‖) :
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
      (fun _ ↦ 0)
      (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
      ∑ j : Fin 4, 8 *
        (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
          (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
            ∫ x : E3, ‖sourceStoppingPowerMajorant K F j x‖ ^
              (q j / sourceStoppingExponent j)) := by
  calc
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
        (fun _ ↦ 0)
        (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
        ∑ j : Fin 4, 8 *
          (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
            (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
              ∫ x : E3,
                sourceStoppingRootMajorant K F j x ^ q j) :=
      initialSourceStoppingCoordinateEnvelope_le_powerDyadic
        α S F q K hq hsum hqs hK hFnonzero htwo hfour
    _ = ∑ j : Fin 4, 8 *
        (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
          (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
            ∫ x : E3, ‖sourceStoppingPowerMajorant K F j x‖ ^
              (q j / sourceStoppingExponent j)) := by
      apply Finset.sum_congr rfl
      intro j _
      congr 2
      apply integral_congr_ae
      filter_upwards [] with x
      unfold sourceStoppingRootMajorant
      rw [← Real.rpow_mul (norm_nonneg _)]
      congr 1
      field_simp

/-- A quantitative dyadic `L^(q_j/s_j)` estimate for each powered input can
be substituted directly into the initial stopping distribution. This is the
normalization-ready interface: later one takes `B_j` to be a fixed constant
times the `q_j`-power input norm. -/
theorem initialSourceStoppingCoordinateEnvelope_le_of_powerDyadic_bounds
    (α : Anisotropy) (S : BoxCollection α) (F : InitialModelSchwartzInput)
    (q K : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j)
    (hK : ∀ j, 0 ≤ K j)
    (hFnonzero : ∀ j, F j ≠ 0)
    (htwo : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      cubeSecondMoment α t x (F 3) ≤
        ‖sourceStoppingPowerMajorant K F 3 x‖)
    (hfour : ∀ (j : Fin 4), j ≠ 3 → ∀ (t : ℝ), 0 < t → ∀ x : E3,
      fourthMoment α t x (F j) ≤
        ‖sourceStoppingPowerMajorant K F j x‖)
    (B : Fin 4 → ℝ)
    (hB : ∀ j : Fin 4,
      8 * (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
        (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
          ∫ x : E3, ‖sourceStoppingPowerMajorant K F j x‖ ^
            (q j / sourceStoppingExponent j)) ≤ B j) :
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
      (fun _ ↦ 0)
      (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
      ∑ j : Fin 4, B j := by
  calc
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
        (fun _ ↦ 0)
        (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
        ∑ j : Fin 4, 8 *
          (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
            (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
              ∫ x : E3, ‖sourceStoppingPowerMajorant K F j x‖ ^
                (q j / sourceStoppingExponent j)) :=
      initialSourceStoppingCoordinateEnvelope_le_powerDyadic_unrooted
        α S F q K hq hsum hqs hK hFnonzero htwo hfour
    _ ≤ ∑ j : Fin 4, B j := by
      exact Finset.sum_le_sum fun j _ ↦ hB j

/-- Product-norm-facing specialization of the preceding interface. A
quantitative dyadic strong-type estimate is supplied exactly in the form
needed to bound each powered-majorant integral by the `q_j`-power integral of
the original input. -/
theorem initialSourceStoppingCoordinateEnvelope_le_inputPowerIntegrals
    (α : Anisotropy) (S : BoxCollection α) (F : InitialModelSchwartzInput)
    (q K C : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j)
    (hK : ∀ j, 0 ≤ K j)
    (hFnonzero : ∀ j, F j ≠ 0)
    (htwo : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      cubeSecondMoment α t x (F 3) ≤
        ‖sourceStoppingPowerMajorant K F 3 x‖)
    (hfour : ∀ (j : Fin 4), j ≠ 3 → ∀ (t : ℝ), 0 < t → ∀ x : E3,
      fourthMoment α t x (F j) ≤
        ‖sourceStoppingPowerMajorant K F j x‖)
    (hdyadic : ∀ j : Fin 4,
      8 * (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
        (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
          ∫ x : E3, ‖sourceStoppingPowerMajorant K F j x‖ ^
            (q j / sourceStoppingExponent j)) ≤
        C j * ∫ x : E3, |F j x| ^ q j) :
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
      (fun _ ↦ 0)
      (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
      ∑ j : Fin 4, C j * ∫ x : E3, |F j x| ^ q j := by
  exact initialSourceStoppingCoordinateEnvelope_le_of_powerDyadic_bounds
    α S F q K hq hsum hqs hK hFnonzero htwo hfour
    (fun j ↦ C j * ∫ x : E3, |F j x| ^ q j) hdyadic

/-- Fully quantitative initial stopping distribution for real Schwartz
input, conditional only on the literal fixed-scale second/fourth bracket
majorants. The dyadic strong-type and root conversions have all been
discharged, leaving the explicit coordinate constants below. -/
theorem initialSourceStoppingCoordinateEnvelope_le_explicitInputPowers
    (α : Anisotropy) (S : BoxCollection α) (F : InitialModelSchwartzInput)
    (q K : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j)
    (hK : ∀ j, 0 ≤ K j)
    (hFnonzero : ∀ j, F j ≠ 0)
    (htwo : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      cubeSecondMoment α t x (F 3) ≤
        ‖sourceStoppingPowerMajorant K F 3 x‖)
    (hfour : ∀ (j : Fin 4), j ≠ 3 → ∀ (t : ℝ), 0 < t → ∀ x : E3,
      fourthMoment α t x (F j) ≤
        ‖sourceStoppingPowerMajorant K F j x‖) :
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
      (fun _ ↦ 0)
      (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
      ∑ j : Fin 4, sourceStoppingDyadicInputConstant K q j *
        ∫ x : E3, |F j x| ^ q j := by
  exact initialSourceStoppingCoordinateEnvelope_le_inputPowerIntegrals
    α S F q K (sourceStoppingDyadicInputConstant K q)
    hq hsum hqs hK hFnonzero htwo hfour
    (fun j ↦ weightedPowerMajorantIntegral_le_inputPowerIntegral
      K q hK F j (hq j) (hqs j))

/-- The initial stopping distribution for real Schwartz data follows from the
literal bracket-kernel shell majorants, with no remaining fixed-scale
assumptions. The explicit coefficient retains the three coordinate dyadic
strong-type factors and the source layer-cake constants. -/
theorem initialSourceStoppingCoordinateEnvelope_le_explicitInputPowers_of_realSchwartz
    (α : Anisotropy) (S : BoxCollection α) (F : InitialModelSchwartzInput)
    (q : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j)
    (hFnonzero : ∀ j, F j ≠ 0) :
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
      (fun _ ↦ 0)
      (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
      ∑ j : Fin 4,
        sourceStoppingDyadicInputConstant
          (fun _ ↦ dyadicBracketShellConstant) q j *
          ∫ x : E3, |F j x| ^ q j := by
  let K : Fin 4 → ℝ := fun _ ↦ dyadicBracketShellConstant
  have hK : ∀ j, 0 ≤ K j := by
    intro j
    dsimp only [K]
    exact dyadicBracketShellConstant_nonneg
  have htwo : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      cubeSecondMoment α t x (F 3) ≤
        ‖sourceStoppingPowerMajorant K F 3 x‖ := by
    intro t ht x
    have hpower : ∀ y : E3,
        ‖complexifyRealSchwartz (sourceStoppingPowerRepresentative F 3) y‖ =
          (F 3 y) ^ 2 := by
      intro y
      rw [complexifyRealSchwartz_apply,
        sourceStoppingPowerRepresentative_apply_of_eq_three F rfl,
        Complex.norm_real, Real.norm_eq_abs]
      exact abs_of_nonneg (sq_nonneg (F 3 y))
    simpa only [sourceStoppingPowerMajorant] using
      (cubeSecondMoment_le_scaledDyadic_of_norm_eq_square
        α (F 3)
        (complexifyRealSchwartz (sourceStoppingPowerRepresentative F 3))
        hpower ht x)
  have hfour : ∀ (j : Fin 4), j ≠ 3 → ∀ (t : ℝ), 0 < t → ∀ x : E3,
      fourthMoment α t x (F j) ≤
        ‖sourceStoppingPowerMajorant K F j x‖ := by
    intro j hj t ht x
    have hpower : ∀ y : E3,
        ‖complexifyRealSchwartz (sourceStoppingPowerRepresentative F j) y‖ =
          |F j y| ^ (4 : ℝ) := by
      intro y
      rw [complexifyRealSchwartz_apply,
        sourceStoppingPowerRepresentative_apply_of_ne_three F hj,
        Complex.norm_real, Real.norm_eq_abs, abs_pow]
      exact (Real.rpow_natCast (|F j y|) 4).symm
    simpa only [sourceStoppingPowerMajorant] using
      (fourthMoment_le_scaledDyadic_of_norm_eq_fourth
        α (F j)
        (complexifyRealSchwartz (sourceStoppingPowerRepresentative F j))
        hpower ht x)
  simpa only [K] using
    (initialSourceStoppingCoordinateEnvelope_le_explicitInputPowers
      α S F q K hq hsum hqs hK hFnonzero htwo hfour)


/-- A positive compact interval has finite mass for the source logarithmic
scale measure. -/
theorem isFiniteMeasure_logScale_Ioc
    {a b : ℝ} (ha : 0 < a) :
    IsFiniteMeasure
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict (Set.Ioc a b)) := by
  apply (integrable_const_iff_isFiniteMeasure (by norm_num : (1 : ℝ) ≠ 0)).mp
  have htop : ∀ᵐ t ∂(volume.restrict (Set.Ioc a b)), cubeScaleDensity t < ∞ := by
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    rw [cubeScaleDensity_eq_of_pos (lt_trans ha ht.1)]
    exact ENNReal.ofReal_lt_top
  rw [restrict_withDensity measurableSet_Ioc]
  rw [integrable_withDensity_iff measurable_cubeScaleDensity htop]
  have heq : (fun t : ℝ ↦ (1 : ℝ) * (cubeScaleDensity t).toReal) =ᵐ[
      volume.restrict (Set.Ioc a b)] fun t ↦ 1 / t := by
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    have htpos : 0 < t := lt_trans ha ht.1
    rw [cubeScaleDensity_eq_of_pos htpos,
      ENNReal.toReal_ofReal (inv_pos.mpr htpos).le]
    ring
  rw [integrable_congr heq]
  have hcont : ContinuousOn (fun t : ℝ ↦ 1 / t) (Set.Icc a b) :=
    continuousOn_const.div continuousOn_id
      (fun t ht ↦ ne_of_gt (lt_of_lt_of_le ha ht.1))
  exact (hcont.integrableOn_compact isCompact_Icc).mono_set Set.Ioc_subset_Icc_self

/-- The literal dyadic scale band in the two-index exhaustion has finite
logarithmic measure. -/
theorem isFiniteMeasure_truncationScaleSet (N : ℕ) :
    IsFiniteMeasure
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (truncationScaleSet N)) := by
  apply isFiniteMeasure_logScale_Ioc
  change 0 < (2 : ℝ) ^ (-(N : ℤ) - 1)
  exact zpow_pos (by norm_num) _

/-- The first difference-kernel block after the center reordering. -/
noncomputable def modelCenterP
    (α : Anisotropy) (u : E3) (t : ℝ) (a : E3) : ℝ :=
  |modelPhiAt (t ^ α.weight 0) (t ^ α.weight 0 * u 0) (a 0)| *
    |modelPhiAt (t ^ α.weight 1) (t ^ α.weight 1 * u 1) (a 1)| *
      |gaussianDerivAt (t ^ α.weight 2) 0 (a 2)|

/-- The second difference/translation-kernel block after the center
reordering. -/
noncomputable def modelCenterQ
    (α : Anisotropy) (u : E3) (t : ℝ) (br : E3 × ℝ) : ℝ :=
  (|gaussianAt (t ^ α.weight 0) 0 (br.1 0)| *
      |gaussianAt (t ^ α.weight 1) 0 (br.1 1)|) *
    (|gaussianDerivAt (t ^ α.weight 2)
        (br.2 * t ^ α.weight 2) (br.1 2)| *
      |conePsiPhysicalReal (br.2 + u 2)|)

theorem integrable_modelCenterP
    (α : Anisotropy) (u : E3) (t : ℝ) (ht : 0 < t) :
    Integrable (modelCenterP α u t) := by
  have hs₀ : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs₁ : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs₂ : 0 < t ^ α.weight 2 := pow_pos ht _
  have h₀ : Integrable (fun r : ℝ ↦
      |modelPhiAt (t ^ α.weight 0) (t ^ α.weight 0 * u 0) r|) :=
    integrable_abs_modelPhiAt hs₀ _
  have h₁ : Integrable (fun r : ℝ ↦
      |modelPhiAt (t ^ α.weight 1) (t ^ α.weight 1 * u 1) r|) :=
    integrable_abs_modelPhiAt hs₁ _
  have h₂ : Integrable (fun r : ℝ ↦
      |gaussianDerivAt (t ^ α.weight 2) 0 r|) :=
    integrable_abs_gaussianDerivAt hs₂ _
  change Integrable (fun a : E3 ↦
    |modelPhiAt (t ^ α.weight 0) (t ^ α.weight 0 * u 0) (a 0)| *
      |modelPhiAt (t ^ α.weight 1) (t ^ α.weight 1 * u 1) (a 1)| *
        |gaussianDerivAt (t ^ α.weight 2) 0 (a 2)|)
  exact integrable_E3_coordinate_product _ _ _ h₀ h₁ h₂

theorem integral_modelCenterP
    (α : Anisotropy) (u : E3) (t : ℝ) (ht : 0 < t) :
    (∫ a : E3, modelCenterP α u t a) =
      (∫ r : ℝ, |conePhiPhysicalReal r|) ^ 2 *
        ∫ r : ℝ, |gaussianDeriv r| := by
  have hs₀ : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs₁ : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs₂ : 0 < t ^ α.weight 2 := pow_pos ht _
  let P₀ : ℝ → ℝ := fun r ↦
    |modelPhiAt (t ^ α.weight 0) (t ^ α.weight 0 * u 0) r|
  let P₁ : ℝ → ℝ := fun r ↦
    |modelPhiAt (t ^ α.weight 1) (t ^ α.weight 1 * u 1) r|
  let P₂ : ℝ → ℝ := fun r ↦ |gaussianDerivAt (t ^ α.weight 2) 0 r|
  change (∫ a : E3, P₀ (a 0) * P₁ (a 1) * P₂ (a 2)) = _
  calc
    (∫ a : E3, P₀ (a 0) * P₁ (a 1) * P₂ (a 2)) =
        (∫ r : ℝ, P₀ r) * (∫ r : ℝ, P₁ r) * ∫ r : ℝ, P₂ r :=
      integral_E3_coordinate_product P₀ P₁ P₂
    _ = (∫ r : ℝ, |conePhiPhysicalReal r|) ^ 2 *
          ∫ r : ℝ, |gaussianDeriv r| := by
      dsimp only [P₀, P₁, P₂]
      rw [integral_abs_modelPhiAt hs₀,
        integral_abs_modelPhiAt hs₁,
        integral_abs_gaussianDerivAt hs₂]
      ring

theorem integrable_modelCenterQ
    (α : Anisotropy) (u : E3) (t : ℝ) (ht : 0 < t) :
    Integrable (modelCenterQ α u t)
      ((volume : Measure E3).prod volume) := by
  have hs₀ : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs₁ : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs₂ : 0 < t ^ α.weight 2 := pow_pos ht _
  change Integrable (fun br : E3 × ℝ ↦
    (|gaussianAt (t ^ α.weight 0) 0 (br.1 0)| *
        |gaussianAt (t ^ α.weight 1) 0 (br.1 1)|) *
      (|gaussianDerivAt (t ^ α.weight 2)
          (br.2 * t ^ α.weight 2) (br.1 2)| *
        |conePsiPhysicalReal (br.2 + u 2)|))
    ((volume : Measure E3).prod volume)
  exact integrable_rawTranslationKernelBlock
    (t ^ α.weight 0) (t ^ α.weight 1) (t ^ α.weight 2) (u 2)
    hs₀ hs₁ hs₂

/-- The absolute mass of the raw third-coordinate translation pair is
independent of its positive scale. -/
theorem integral_abs_rawThirdTranslationPair
    (s u : ℝ) (hs : 0 < s) :
    (∫ z : ℝ × ℝ,
      |gaussianDerivAt s (z.2 * s) z.1| *
        |conePsiPhysicalReal (z.2 + u)|) =
      (∫ x : ℝ, |gaussianDeriv x|) * conePsiPhysicalRealL1 := by
  let G : ℝ → ℝ → ℝ := fun x r ↦
    |gaussianDerivAt s (r * s) x| * |conePsiPhysicalReal (r + u)|
  have hG : Integrable (Function.uncurry G)
      ((volume : Measure ℝ).prod volume) := by
    change Integrable (fun z : ℝ × ℝ ↦
      |gaussianDerivAt s (z.2 * s) z.1| *
        |conePsiPhysicalReal (z.2 + u)|)
      ((volume : Measure ℝ).prod volume)
    exact integrable_rawThirdTranslationPair s u hs
  calc
    (∫ z : ℝ × ℝ,
      |gaussianDerivAt s (z.2 * s) z.1| *
        |conePsiPhysicalReal (z.2 + u)|) =
        ∫ x : ℝ, ∫ r : ℝ, G x r := by
          exact integral_prod (Function.uncurry G) hG
    _ = ∫ r : ℝ, ∫ x : ℝ, G x r :=
      integral_integral_swap hG
    _ = ∫ r : ℝ,
        (∫ x : ℝ, |gaussianDeriv x|) * |conePsiPhysicalReal (r + u)| := by
      apply integral_congr_ae
      filter_upwards [] with r
      dsimp only [G]
      rw [show (fun x : ℝ ↦
          |gaussianDerivAt s (r * s) x| * |conePsiPhysicalReal (r + u)|) =
          fun x ↦ |gaussianDerivAt s (r * s) x| *
            |conePsiPhysicalReal (r + u)| by rfl,
        integral_mul_const, integral_abs_gaussianDerivAt hs]
    _ = (∫ x : ℝ, |gaussianDeriv x|) * conePsiPhysicalRealL1 := by
      rw [integral_const_mul, integral_abs_conePsiPhysicalReal_add]

/-- The second center block has scale-independent absolute mass. -/
theorem integral_modelCenterQ
    (α : Anisotropy) (u : E3) (t : ℝ) (ht : 0 < t) :
    (∫ br : E3 × ℝ, modelCenterQ α u t br) =
      (∫ r : ℝ, |gaussianDeriv r|) * conePsiPhysicalRealL1 := by
  let s₀ : ℝ := t ^ α.weight 0
  let s₁ : ℝ := t ^ α.weight 1
  let s₂ : ℝ := t ^ α.weight 2
  have hs₀ : 0 < s₀ := by dsimp only [s₀]; exact pow_pos ht _
  have hs₁ : 0 < s₁ := by dsimp only [s₁]; exact pow_pos ht _
  have hs₂ : 0 < s₂ := by dsimp only [s₂]; exact pow_pos ht _
  let G₀ : ℝ → ℝ := fun x ↦ |gaussianAt s₀ 0 x|
  let G₁ : ℝ → ℝ := fun x ↦ |gaussianAt s₁ 0 x|
  let T : ℝ × ℝ → ℝ := fun z ↦
    |gaussianDerivAt s₂ (z.2 * s₂) z.1| *
      |conePsiPhysicalReal (z.2 + u 2)|
  have hG₀ : Integrable G₀ := by
    have h := (integrable_gaussianAt hs₀ 0).norm
    apply h.congr
    filter_upwards [] with x
    dsimp only [G₀]
    exact (Real.norm_eq_abs _).symm
  have hG₁ : Integrable G₁ := by
    have h := (integrable_gaussianAt hs₁ 0).norm
    apply h.congr
    filter_upwards [] with x
    dsimp only [G₁]
    exact (Real.norm_eq_abs _).symm
  have hT : Integrable T ((volume : Measure ℝ).prod volume) := by
    simpa only [T] using integrable_rawThirdTranslationPair s₂ (u 2) hs₂
  let e : E3 × ℝ ≃ᵐ ℝ × (ℝ × (ℝ × ℝ)) :=
    (MeasurableEquiv.prodCongr e3Coordinates (MeasurableEquiv.refl ℝ)).trans
      (MeasurableEquiv.prodAssoc.trans
        (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
          MeasurableEquiv.prodAssoc))
  have hcoords : MeasurePreserving
      (MeasurableEquiv.prodCongr e3Coordinates (MeasurableEquiv.refl ℝ))
      ((volume : Measure E3).prod volume)
      (((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)).prod
        volume) :=
    e3Coordinates_measurePreserving.prod (MeasurePreserving.id (volume : Measure ℝ))
  have hassoc₁ : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        (ℝ × (ℝ × ℝ)) × ℝ ≃ᵐ ℝ × ((ℝ × ℝ) × ℝ))
      (((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)).prod volume)
      ((volume : Measure ℝ).prod
        (((volume : Measure ℝ).prod volume).prod volume)) :=
    measurePreserving_prodAssoc volume ((volume : Measure ℝ).prod volume) volume
  have hassoc₂ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
        (MeasurableEquiv.prodAssoc :
          (ℝ × ℝ) × ℝ ≃ᵐ ℝ × (ℝ × ℝ)))
      ((volume : Measure ℝ).prod
        (((volume : Measure ℝ).prod volume).prod volume))
      ((volume : Measure ℝ).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) :=
    (MeasurePreserving.id (volume : Measure ℝ)).prod
      (measurePreserving_prodAssoc volume volume volume)
  have hmp : MeasurePreserving e
      ((volume : Measure E3).prod volume)
      ((volume : Measure ℝ).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) := by
    dsimp only [e]
    exact (hcoords.trans hassoc₁).trans hassoc₂
  let H : ℝ × (ℝ × (ℝ × ℝ)) → ℝ := fun z ↦
    G₀ z.1 * (G₁ z.2.1 * T z.2.2)
  have hH : Integrable H
      ((volume : Measure ℝ).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) :=
    hG₀.mul_prod (hG₁.mul_prod hT)
  have htransport : Integrable (fun br : E3 × ℝ ↦ H (e br))
      ((volume : Measure E3).prod volume) :=
    hmp.integrable_comp_of_integrable hH
  have hrewrite : (fun br : E3 × ℝ ↦ H (e br)) =
      modelCenterQ α u t := by
    funext br
    rcases br with ⟨b, r⟩
    simp [H, G₀, G₁, T, modelCenterQ, e, MeasurableEquiv.trans_apply,
      MeasurableEquiv.prodCongr, MeasurableEquiv.prodAssoc,
      e3Coordinates_apply]
    dsimp only [s₀, s₁, s₂]
    ring
  rw [← hrewrite]
  calc
    (∫ br : E3 × ℝ, H (e br)) =
        ∫ z : ℝ × (ℝ × (ℝ × ℝ)), H z :=
      hmp.integral_comp e.measurableEmbedding H
    _ = (∫ x : ℝ, G₀ x) *
          ∫ z : ℝ × (ℝ × ℝ), G₁ z.1 * T z.2 := by
      rw [show (fun z : ℝ × (ℝ × (ℝ × ℝ)) ↦ H z) =
        fun z ↦ G₀ z.1 * (G₁ z.2.1 * T z.2.2) by rfl]
      exact integral_prod_mul G₀ (fun z : ℝ × (ℝ × ℝ) ↦
        G₁ z.1 * T z.2)
    _ = (∫ x : ℝ, G₀ x) *
          ((∫ x : ℝ, G₁ x) * ∫ z : ℝ × ℝ, T z) := by
      congr 1
      exact integral_prod_mul G₁ T
    _ = (∫ r : ℝ, |gaussianDeriv r|) * conePsiPhysicalRealL1 := by
      have hG₀mass : (∫ x : ℝ, G₀ x) = 1 := by
        dsimp only [G₀]
        calc
          (∫ x : ℝ, |gaussianAt s₀ 0 x|) = ∫ x : ℝ, gaussianAt s₀ 0 x := by
            apply integral_congr_ae
            filter_upwards [] with x
            rw [abs_of_nonneg]
            unfold gaussianAt kernelAt kernelDilate
            exact mul_nonneg (inv_nonneg.mpr hs₀.le) (gaussian_nonneg _)
          _ = 1 := integral_gaussianAt hs₀ 0
      have hG₁mass : (∫ x : ℝ, G₁ x) = 1 := by
        dsimp only [G₁]
        calc
          (∫ x : ℝ, |gaussianAt s₁ 0 x|) = ∫ x : ℝ, gaussianAt s₁ 0 x := by
            apply integral_congr_ae
            filter_upwards [] with x
            rw [abs_of_nonneg]
            unfold gaussianAt kernelAt kernelDilate
            exact mul_nonneg (inv_nonneg.mpr hs₁.le) (gaussian_nonneg _)
          _ = 1 := integral_gaussianAt hs₁ 0
      have hTmass : (∫ z : ℝ × ℝ, T z) =
          (∫ x : ℝ, |gaussianDeriv x|) * conePsiPhysicalRealL1 := by
        dsimp only [T]
        exact integral_abs_rawThirdTranslationPair s₂ (u 2) hs₂
      rw [hG₀mass, hG₁mass, hTmass]
      ring

/-- Reflecting the first difference block preserves both integrability and
its scale-independent mass. -/
theorem integrable_modelCenterP_neg
    (α : Anisotropy) (u : E3) (t : ℝ) (ht : 0 < t) :
    Integrable (fun a : E3 ↦ modelCenterP α u t (-a)) :=
  (integrable_modelCenterP α u t ht).comp_neg

theorem integral_modelCenterP_neg
    (α : Anisotropy) (u : E3) (t : ℝ) (ht : 0 < t) :
    (∫ a : E3, modelCenterP α u t (-a)) =
      (∫ r : ℝ, |conePhiPhysicalReal r|) ^ 2 *
        ∫ r : ℝ, |gaussianDeriv r| := by
  let P : E3 → ℝ := modelCenterP α u t
  have hneg : MeasurePreserving (fun a : E3 ↦ -a) volume volume :=
    Measure.measurePreserving_neg (volume : Measure E3)
  calc
    (∫ a : E3, modelCenterP α u t (-a)) = ∫ a : E3, P a := by
      change (∫ a : E3, P (-a)) = ∫ a : E3, P a
      exact hneg.integral_comp (Homeomorph.neg E3).measurableEmbedding P
    _ = (∫ r : ℝ, |conePhiPhysicalReal r|) ^ 2 *
          ∫ r : ℝ, |gaussianDeriv r| :=
      integral_modelCenterP α u t ht

/-- The separated nonnegative center majorant after all fixed spatial
differences have been taken. -/
noncomputable def modelCenterMajorant
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (A : E3 → ℝ)
    (t : ℝ) (q : (E3 × E3) × (E3 × ℝ)) : ℝ :=
  |c t| * A q.1.1 * modelCenterP α u t (-q.1.2) *
    modelCenterQ α u t q.2

theorem integrable_modelCenterMajorant_fixed
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (A : E3 → ℝ)
    (hA : Integrable A) (t : ℝ) (ht : 0 < t) :
    Integrable (modelCenterMajorant α u c A t)
      (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume)) := by
  have hP : Integrable (fun a : E3 ↦ modelCenterP α u t (-a)) :=
    integrable_modelCenterP_neg α u t ht
  have hQ : Integrable (modelCenterQ α u t)
      ((volume : Measure E3).prod volume) :=
    integrable_modelCenterQ α u t ht
  have hPQ : Integrable (fun q : E3 × (E3 × ℝ) ↦
      modelCenterP α u t (-q.1) * modelCenterQ α u t q.2)
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume)) :=
    hP.mul_prod hQ
  have hAPQ : Integrable (fun q : E3 × (E3 × (E3 × ℝ)) ↦
      A q.1 * (modelCenterP α u t (-q.2.1) *
        modelCenterQ α u t q.2.2))
      ((volume : Measure E3).prod
        ((volume : Measure E3).prod ((volume : Measure E3).prod volume))) :=
    hA.mul_prod hPQ
  have hassoc : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        (E3 × E3) × (E3 × ℝ) ≃ᵐ E3 × (E3 × (E3 × ℝ)))
      (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume))
      ((volume : Measure E3).prod
        ((volume : Measure E3).prod ((volume : Measure E3).prod volume))) :=
    measurePreserving_prodAssoc volume volume
      ((volume : Measure E3).prod volume)
  have htransport : Integrable (fun q : (E3 × E3) × (E3 × ℝ) ↦
      A ((MeasurableEquiv.prodAssoc q).1) *
        (modelCenterP α u t (-((MeasurableEquiv.prodAssoc q).2.1)) *
          modelCenterQ α u t (MeasurableEquiv.prodAssoc q).2.2))
      (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume)) :=
    hassoc.integrable_comp_of_integrable hAPQ
  apply htransport.const_mul |c t| |>.congr
  filter_upwards [] with q
  rcases q with ⟨⟨x, a⟩, br⟩
  change |c t| * (A x * (modelCenterP α u t (-a) *
      modelCenterQ α u t br)) = modelCenterMajorant α u c A t ((x, a), br)
  simp only [modelCenterMajorant]
  ring

theorem integral_modelCenterMajorant_fixed
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (A : E3 → ℝ)
    (hA : Integrable A) (t : ℝ) (ht : 0 < t) :
    (∫ q : (E3 × E3) × (E3 × ℝ),
      modelCenterMajorant α u c A t q) =
      |c t| * (∫ x : E3, A x) *
        ((∫ r : ℝ, |conePhiPhysicalReal r|) ^ 2 *
          ∫ r : ℝ, |gaussianDeriv r|) *
        ((∫ r : ℝ, |gaussianDeriv r|) * conePsiPhysicalRealL1) := by
  let P : E3 → ℝ := fun a ↦ modelCenterP α u t (-a)
  let Q : E3 × ℝ → ℝ := modelCenterQ α u t
  let H : (E3 × E3) × (E3 × ℝ) → ℝ := fun q ↦
    A q.1.1 * P q.1.2 * Q q.2
  have hH : Integrable H
      (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume)) := by
    have hP : Integrable P := integrable_modelCenterP_neg α u t ht
    have hQ : Integrable Q ((volume : Measure E3).prod volume) :=
      integrable_modelCenterQ α u t ht
    have hPQ : Integrable (fun q : E3 × (E3 × ℝ) ↦ P q.1 * Q q.2)
        ((volume : Measure E3).prod ((volume : Measure E3).prod volume)) :=
      hP.mul_prod hQ
    have hAPQ := hA.mul_prod hPQ
    have hassoc : MeasurePreserving
        (MeasurableEquiv.prodAssoc :
          (E3 × E3) × (E3 × ℝ) ≃ᵐ E3 × (E3 × (E3 × ℝ)))
        (((volume : Measure E3).prod volume).prod
          ((volume : Measure E3).prod volume))
        ((volume : Measure E3).prod
          ((volume : Measure E3).prod ((volume : Measure E3).prod volume))) :=
      measurePreserving_prodAssoc volume volume
        ((volume : Measure E3).prod volume)
    have htransport : Integrable (fun q : (E3 × E3) × (E3 × ℝ) ↦
        A ((MeasurableEquiv.prodAssoc q).1) *
          (P ((MeasurableEquiv.prodAssoc q).2.1) *
            Q (MeasurableEquiv.prodAssoc q).2.2))
        (((volume : Measure E3).prod volume).prod
          ((volume : Measure E3).prod volume)) :=
      hassoc.integrable_comp_of_integrable hAPQ
    apply htransport.congr
    filter_upwards [] with q
    rcases q with ⟨⟨x, a⟩, br⟩
    change A x * (P a * Q br) = H ((x, a), br)
    dsimp only [H]
    ring
  calc
    (∫ q : (E3 × E3) × (E3 × ℝ),
      modelCenterMajorant α u c A t q) =
        |c t| * ∫ q : (E3 × E3) × (E3 × ℝ), H q := by
          have hpoint : (fun q : (E3 × E3) × (E3 × ℝ) ↦
              modelCenterMajorant α u c A t q) =
              fun q ↦ |c t| * H q := by
            funext q
            rcases q with ⟨⟨x, a⟩, br⟩
            simp only [modelCenterMajorant, H, P, Q]
            ring
          rw [hpoint, integral_const_mul]
    _ = |c t| *
          ((∫ x : E3, A x) *
            ((∫ a : E3, P a) * ∫ br : E3 × ℝ, Q br)) := by
          congr 1
          have hassoc : MeasurePreserving
              (MeasurableEquiv.prodAssoc :
                (E3 × E3) × (E3 × ℝ) ≃ᵐ E3 × (E3 × (E3 × ℝ)))
              (((volume : Measure E3).prod volume).prod
                ((volume : Measure E3).prod volume))
              ((volume : Measure E3).prod
                ((volume : Measure E3).prod ((volume : Measure E3).prod volume))) :=
            measurePreserving_prodAssoc volume volume
              ((volume : Measure E3).prod volume)
          calc
            (∫ q : (E3 × E3) × (E3 × ℝ), H q) =
                ∫ q : (E3 × E3) × (E3 × ℝ),
                  A (MeasurableEquiv.prodAssoc q).1 *
                    (P (MeasurableEquiv.prodAssoc q).2.1 *
                      Q (MeasurableEquiv.prodAssoc q).2.2) := by
                apply integral_congr_ae
                filter_upwards [] with q
                rcases q with ⟨⟨x, a⟩, br⟩
                change A x * P a * Q br = A x * (P a * Q br)
                ring
            _ =
                ∫ q : E3 × (E3 × (E3 × ℝ)),
                  A q.1 * (P q.2.1 * Q q.2.2) :=
              by
                exact hassoc.integral_comp
                  MeasurableEquiv.prodAssoc.measurableEmbedding
                  (fun q : E3 × (E3 × (E3 × ℝ)) ↦ A q.1 *
                    (P q.2.1 * Q q.2.2))
            _ = (∫ x : E3, A x) *
                ∫ q : E3 × (E3 × ℝ), P q.1 * Q q.2 := by
              exact integral_prod_mul A (fun q : E3 × (E3 × ℝ) ↦ P q.1 * Q q.2)
            _ = (∫ x : E3, A x) *
                ((∫ a : E3, P a) * ∫ br : E3 × ℝ, Q br) := by
              congr 1
              exact integral_prod_mul P Q
    _ = |c t| * (∫ x : E3, A x) *
          ((∫ r : ℝ, |conePhiPhysicalReal r|) ^ 2 *
            ∫ r : ℝ, |gaussianDeriv r|) *
          ((∫ r : ℝ, |gaussianDeriv r|) * conePsiPhysicalRealL1) := by
          rw [show (∫ a : E3, P a) =
              (∫ r : ℝ, |conePhiPhysicalReal r|) ^ 2 *
                ∫ r : ℝ, |gaussianDeriv r| by
                dsimp only [P]
                exact integral_modelCenterP_neg α u t ht,
            show (∫ br : E3 × ℝ, Q br) =
              (∫ r : ℝ, |gaussianDeriv r|) * conePsiPhysicalRealL1 by
                dsimp only [Q]
                exact integral_modelCenterQ α u t ht]
          ring

/-- The separated center majorant is measurable jointly in scale and all
center/difference variables whenever its base factor and coefficient are
measurable. -/
theorem measurable_modelCenterMajorant_joint
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (A : E3 → ℝ)
    (hc : Measurable c) (hA : Measurable A) :
    Measurable (fun z : ℝ × ((E3 × E3) × (E3 × ℝ)) ↦
      modelCenterMajorant α u c A z.1 z.2) := by
  let X := ℝ × ((E3 × E3) × (E3 × ℝ))
  have ht : Measurable (fun z : X ↦ z.1) := measurable_fst
  have hx : Measurable (fun z : X ↦ z.2.1.1) :=
    measurable_fst.comp (measurable_fst.comp measurable_snd)
  have ha : Measurable (fun z : X ↦ z.2.1.2) :=
    measurable_snd.comp (measurable_fst.comp measurable_snd)
  have hb : Measurable (fun z : X ↦ z.2.2.1) :=
    measurable_fst.comp (measurable_snd.comp measurable_snd)
  have hr : Measurable (fun z : X ↦ z.2.2.2) :=
    measurable_snd.comp (measurable_snd.comp measurable_snd)
  have hxi (i : Fin 3) : Measurable (fun z : X ↦ z.2.1.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp hx
  have hai (i : Fin 3) : Measurable (fun z : X ↦ z.2.1.2 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp ha
  have hbi (i : Fin 3) : Measurable (fun z : X ↦ z.2.2.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp hb
  have hderiv : Measurable gaussianDeriv := by
    unfold gaussianDeriv
    exact (measurable_const.mul measurable_id).mul
      gaussian_contDiff.continuous.measurable
  have hphi₀ : Measurable (fun z : X ↦
      modelPhiAt (z.1 ^ α.weight 0) (z.1 ^ α.weight 0 * u 0)
        (-(z.2.1.2 0))) := by
    unfold modelPhiAt
    exact measurable_kernelAt conePhiPhysicalReal
      conePhiPhysicalReal.continuous.measurable _ _ _
      (ht.pow_const _) ((ht.pow_const _).mul measurable_const) (hai 0).neg
  have hphi₁ : Measurable (fun z : X ↦
      modelPhiAt (z.1 ^ α.weight 1) (z.1 ^ α.weight 1 * u 1)
        (-(z.2.1.2 1))) := by
    unfold modelPhiAt
    exact measurable_kernelAt conePhiPhysicalReal
      conePhiPhysicalReal.continuous.measurable _ _ _
      (ht.pow_const _) ((ht.pow_const _).mul measurable_const) (hai 1).neg
  have hderiv₀ : Measurable (fun z : X ↦
      gaussianDerivAt (z.1 ^ α.weight 2) 0 (-(z.2.1.2 2))) := by
    unfold gaussianDerivAt
    exact measurable_kernelAt gaussianDeriv hderiv _ _ _
      (ht.pow_const _) measurable_const (hai 2).neg
  have hgauss₀ : Measurable (fun z : X ↦
      gaussianAt (z.1 ^ α.weight 0) 0 (z.2.2.1 0)) := by
    unfold gaussianAt
    exact measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable
      _ _ _ (ht.pow_const _) measurable_const (hbi 0)
  have hgauss₁ : Measurable (fun z : X ↦
      gaussianAt (z.1 ^ α.weight 1) 0 (z.2.2.1 1)) := by
    unfold gaussianAt
    exact measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable
      _ _ _ (ht.pow_const _) measurable_const (hbi 1)
  have hderiv₁ : Measurable (fun z : X ↦
      gaussianDerivAt (z.1 ^ α.weight 2)
        (z.2.2.2 * z.1 ^ α.weight 2) (z.2.2.1 2)) := by
    unfold gaussianDerivAt
    exact measurable_kernelAt gaussianDeriv hderiv _ _ _
      (ht.pow_const _) (hr.mul (ht.pow_const _)) (hbi 2)
  have hpsi : Measurable (fun z : X ↦
      conePsiPhysicalReal (z.2.2.2 + u 2)) :=
    conePsiPhysicalReal.continuous.measurable.comp (hr.add measurable_const)
  have hc' : Measurable (fun z : X ↦ c z.1) := hc.comp ht
  have hcabs : Measurable (fun z : X ↦ |c z.1|) :=
    continuous_abs.measurable.comp hc'
  have hA' : Measurable (fun z : X ↦ A z.2.1.1) := hA.comp hx
  have hphi₀abs : Measurable (fun z : X ↦
      |modelPhiAt (z.1 ^ α.weight 0) (z.1 ^ α.weight 0 * u 0)
        (-(z.2.1.2 0))|) := continuous_abs.measurable.comp hphi₀
  have hphi₁abs : Measurable (fun z : X ↦
      |modelPhiAt (z.1 ^ α.weight 1) (z.1 ^ α.weight 1 * u 1)
        (-(z.2.1.2 1))|) := continuous_abs.measurable.comp hphi₁
  have hderiv₀abs : Measurable (fun z : X ↦
      |gaussianDerivAt (z.1 ^ α.weight 2) 0 (-(z.2.1.2 2))|) :=
    continuous_abs.measurable.comp hderiv₀
  have hgauss₀abs : Measurable (fun z : X ↦
      |gaussianAt (z.1 ^ α.weight 0) 0 (z.2.2.1 0)|) :=
    continuous_abs.measurable.comp hgauss₀
  have hgauss₁abs : Measurable (fun z : X ↦
      |gaussianAt (z.1 ^ α.weight 1) 0 (z.2.2.1 1)|) :=
    continuous_abs.measurable.comp hgauss₁
  have hderiv₁abs : Measurable (fun z : X ↦
      |gaussianDerivAt (z.1 ^ α.weight 2)
        (z.2.2.2 * z.1 ^ α.weight 2) (z.2.2.1 2)|) :=
    continuous_abs.measurable.comp hderiv₁
  have hpsiabs : Measurable (fun z : X ↦
      |conePsiPhysicalReal (z.2.2.2 + u 2)|) :=
    continuous_abs.measurable.comp hpsi
  have hleft : Measurable (fun z : X ↦
      |c z.1| * A z.2.1.1 *
        |modelPhiAt (z.1 ^ α.weight 0) (z.1 ^ α.weight 0 * u 0)
          (-(z.2.1.2 0))| *
        |modelPhiAt (z.1 ^ α.weight 1) (z.1 ^ α.weight 1 * u 1)
          (-(z.2.1.2 1))| *
        |gaussianDerivAt (z.1 ^ α.weight 2) 0 (-(z.2.1.2 2))|) :=
    ((((hcabs.mul hA').mul hphi₀abs).mul hphi₁abs).mul hderiv₀abs)
  have hright : Measurable (fun z : X ↦
      (|gaussianAt (z.1 ^ α.weight 0) 0 (z.2.2.1 0)| *
        |gaussianAt (z.1 ^ α.weight 1) 0 (z.2.2.1 1)|) *
      (|gaussianDerivAt (z.1 ^ α.weight 2)
          (z.2.2.2 * z.1 ^ α.weight 2) (z.2.2.1 2)| *
        |conePsiPhysicalReal (z.2.2.2 + u 2)|)) :=
    (hgauss₀abs.mul hgauss₁abs).mul (hderiv₁abs.mul hpsiabs)
  change Measurable (fun z : X ↦
    |c z.1| * A z.2.1.1 *
      (|modelPhiAt (z.1 ^ α.weight 0) (z.1 ^ α.weight 0 * u 0)
          ((-z.2.1.2) 0)| *
        |modelPhiAt (z.1 ^ α.weight 1) (z.1 ^ α.weight 1 * u 1)
          ((-z.2.1.2) 1)| *
        |gaussianDerivAt (z.1 ^ α.weight 2) 0 ((-z.2.1.2) 2)|) *
      ((|gaussianAt (z.1 ^ α.weight 0) 0 (z.2.2.1 0)| *
          |gaussianAt (z.1 ^ α.weight 1) 0 (z.2.2.1 1)|) *
        (|gaussianDerivAt (z.1 ^ α.weight 2)
            (z.2.2.2 * z.1 ^ α.weight 2) (z.2.2.1 2)| *
          |conePsiPhysicalReal (z.2.2.2 + u 2)|)))
  convert
    (((hcabs.mul hA').mul ((hphi₀abs.mul hphi₁abs).mul hderiv₀abs)).mul
      ((hgauss₀abs.mul hgauss₁abs).mul (hderiv₁abs.mul hpsiabs))) using 1
  rfl

/-- On every finite positive scale measure, the separated center majorant is
jointly integrable. Its spatial mass is independent of the scale. -/
theorem integrable_modelCenterMajorant_joint_of_isFinite
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (A : E3 → ℝ)
    (ν : Measure ℝ) [IsFiniteMeasure ν]
    (hc : Measurable c) (hcBound : ∀ t : ℝ, |c t| ≤ 1)
    (hAmeas : Measurable A) (hAint : Integrable A)
    (hAnonneg : ∀ x : E3, 0 ≤ A x)
    (hpos : ∀ᵐ t ∂ν, 0 < t) :
    Integrable (fun z : ℝ × ((E3 × E3) × (E3 × ℝ)) ↦
      modelCenterMajorant α u c A z.1 z.2)
      (ν.prod (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume))) := by
  let : SFinite ((volume : Measure E3).prod (volume : Measure E3)) := inferInstance
  let : SFinite ((volume : Measure E3).prod (volume : Measure ℝ)) := inferInstance
  let μ : Measure ((E3 × E3) × (E3 × ℝ)) :=
    ((volume : Measure E3).prod volume).prod
      ((volume : Measure E3).prod volume)
  let : SFinite μ := by
    dsimp [μ]
    infer_instance
  let Pmass : ℝ :=
    (∫ r : ℝ, |conePhiPhysicalReal r|) ^ 2 *
      ∫ r : ℝ, |gaussianDeriv r|
  let Qmass : ℝ :=
    (∫ r : ℝ, |gaussianDeriv r|) * conePsiPhysicalRealL1
  let K : ℝ := (∫ x : E3, A x) * Pmass * Qmass
  have hmeas : AEStronglyMeasurable (fun z : ℝ × ((E3 × E3) × (E3 × ℝ)) ↦
      modelCenterMajorant α u c A z.1 z.2) (ν.prod μ) :=
    (measurable_modelCenterMajorant_joint α u c A hc hAmeas).aestronglyMeasurable
  refine (integrable_prod_iff hmeas).mpr ⟨?_, ?_⟩
  · filter_upwards [hpos] with t ht
    simpa only [μ] using
      integrable_modelCenterMajorant_fixed α u c A hAint t ht
  · have hAint_nonneg : 0 ≤ ∫ x : E3, A x :=
      integral_nonneg hAnonneg
    have hphi_nonneg : 0 ≤ ∫ r : ℝ, |conePhiPhysicalReal r| :=
      integral_nonneg fun _ ↦ abs_nonneg _
    have hderiv_nonneg : 0 ≤ ∫ r : ℝ, |gaussianDeriv r| :=
      integral_nonneg fun _ ↦ abs_nonneg _
    have hPmass_nonneg : 0 ≤ Pmass := by
      dsimp only [Pmass]
      exact mul_nonneg (sq_nonneg _) hderiv_nonneg
    have hQmass_nonneg : 0 ≤ Qmass := by
      dsimp only [Qmass]
      exact mul_nonneg hderiv_nonneg conePsiPhysicalRealL1_pos.le
    have hKnonneg : 0 ≤ K := by
      dsimp only [K]
      exact mul_nonneg (mul_nonneg hAint_nonneg hPmass_nonneg) hQmass_nonneg
    have hcoeff_meas : AEStronglyMeasurable (fun t : ℝ ↦ |c t| * K) ν :=
      ((continuous_abs.measurable.comp hc).mul measurable_const).aestronglyMeasurable
    have hcoeff : Integrable (fun t : ℝ ↦ |c t| * K) ν := by
      refine (integrable_const K).mono' hcoeff_meas ?_
      filter_upwards [] with t
      rw [Real.norm_eq_abs, abs_of_nonneg]
      · nlinarith [hcBound t, abs_nonneg (c t)]
      · exact mul_nonneg (abs_nonneg _) hKnonneg
    apply hcoeff.congr
    filter_upwards [hpos] with t ht
    symm
    calc
      (∫ q : (E3 × E3) × (E3 × ℝ),
        ‖modelCenterMajorant α u c A t q‖) =
          ∫ q : (E3 × E3) × (E3 × ℝ),
            modelCenterMajorant α u c A t q := by
              apply integral_congr_ae
              filter_upwards [] with q
              rw [Real.norm_eq_abs, abs_of_nonneg]
              have hP : 0 ≤ modelCenterP α u t (-q.1.2) := by
                unfold modelCenterP
                positivity
              have hQ : 0 ≤ modelCenterQ α u t q.2 := by
                unfold modelCenterQ
                positivity
              exact mul_nonneg
                (mul_nonneg
                  (mul_nonneg (abs_nonneg _) (hAnonneg q.1.1)) hP) hQ
      _ = |c t| * (∫ x : E3, A x) * Pmass * Qmass := by
            dsimp only [Pmass, Qmass]
            exact integral_modelCenterMajorant_fixed α u c A hAint t ht
      _ = |c t| * K := by
            dsimp only [K]
            ring

/-- The two spatial difference shears carrying the raw center variables to
the separated majorant coordinates. -/
noncomputable def modelCenterRawReorder :
    ((E3 × E3) × E3) × ℝ ≃ᵐ (E3 × E3) × (E3 × ℝ) :=
  let e₃ : (E3 × E3) × E3 ≃ᵐ (E3 × E3) × E3 :=
    ((MeasurableEquiv.prodAssoc.trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.prodComm : E3 × E3 ≃ᵐ E3 × E3))).trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.shearSubRight E3))).trans
      MeasurableEquiv.prodAssoc.symm
  ((MeasurableEquiv.prodCongr e₃ (MeasurableEquiv.refl ℝ)).trans
    MeasurableEquiv.prodAssoc).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.shearSubRight E3)
      (MeasurableEquiv.refl (E3 × ℝ)))

/-- The raw-center difference shear preserves the four-dimensional product
Lebesgue measure. -/
theorem modelCenterRawReorder_measurePreserving :
    MeasurePreserving modelCenterRawReorder
      ((((volume : Measure E3).prod volume).prod volume).prod volume)
      (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume)) := by
  let e₃ : (E3 × E3) × E3 ≃ᵐ (E3 × E3) × E3 :=
    ((MeasurableEquiv.prodAssoc.trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.prodComm : E3 × E3 ≃ᵐ E3 × E3))).trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.shearSubRight E3))).trans
      MeasurableEquiv.prodAssoc.symm
  let e : ((E3 × E3) × E3) × ℝ ≃ᵐ
      (E3 × E3) × (E3 × ℝ) :=
    (MeasurableEquiv.prodCongr e₃ (MeasurableEquiv.refl ℝ)).trans
      MeasurableEquiv.prodAssoc
  have hassoc : MeasurePreserving
      (MeasurableEquiv.prodAssoc : (E3 × E3) × E3 ≃ᵐ E3 × (E3 × E3))
      (((volume : Measure E3).prod volume).prod volume)
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume)) :=
    measurePreserving_prodAssoc volume volume volume
  have hswap : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.prodComm : E3 × E3 ≃ᵐ E3 × E3))
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume))
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume)) := by
    exact (MeasurePreserving.id (volume : Measure E3)).prod
      (MeasureTheory.Measure.measurePreserving_swap
        (μ := (volume : Measure E3)) (ν := (volume : Measure E3)))
  have hshear : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.shearSubRight E3))
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume))
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume)) := by
    have hsub : MeasurePreserving (fun z : E3 × E3 ↦ (z.1, z.2 - z.1))
        ((volume : Measure E3).prod volume)
        ((volume : Measure E3).prod volume) :=
      measurePreserving_prod_sub volume volume
    have hprod := (MeasurePreserving.id (volume : Measure E3)).prod hsub
    convert hprod using 1
    rfl
  have he₃ : MeasurePreserving e₃
      (((volume : Measure E3).prod volume).prod volume)
      (((volume : Measure E3).prod volume).prod volume) := by
    dsimp only [e₃]
    exact ((hassoc.trans hswap).trans hshear).trans hassoc.symm
  have he : MeasurePreserving e
      ((((volume : Measure E3).prod volume).prod volume).prod volume)
      (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume)) := by
    dsimp only [e]
    exact (he₃.prod (MeasurePreserving.id (volume : Measure ℝ))).trans
      (measurePreserving_prodAssoc
        ((volume : Measure E3).prod volume) volume volume)
  have hlast : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.shearSubRight E3)
        (MeasurableEquiv.refl (E3 × ℝ)))
      (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume))
      (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume)) := by
    have hsub : MeasurePreserving (fun z : E3 × E3 ↦ (z.1, z.2 - z.1))
        ((volume : Measure E3).prod volume)
        ((volume : Measure E3).prod volume) :=
      measurePreserving_prod_sub volume volume
    have hprod := hsub.prod
      (MeasurePreserving.id
        ((volume : Measure E3).prod (volume : Measure ℝ)))
    convert hprod using 1
    rfl
  change MeasurePreserving
    (((MeasurableEquiv.prodCongr e₃ (MeasurableEquiv.refl ℝ)).trans
      MeasurableEquiv.prodAssoc).trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.shearSubRight E3)
        (MeasurableEquiv.refl (E3 × ℝ)))) _ _
  exact he.trans hlast

@[simp] theorem modelCenterRawReorder_apply
    (x y p : E3) (r : ℝ) :
    modelCenterRawReorder (((x, y), p), r) =
      ((x, p - x), (y - p, r)) := by
  simp [modelCenterRawReorder, MeasurableEquiv.trans_apply,
    MeasurableEquiv.prodCongr, MeasurableEquiv.prodAssoc,
    MeasurableEquiv.prodComm, MeasurableEquiv.shearSubRight]

/-- The pulled-back separated majorant in the original raw center order. -/
noncomputable def modelRawCenterMajorant
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (A : E3 → ℝ)
    (z : ℝ × (((E3 × E3) × E3) × ℝ)) : ℝ :=
  modelCenterMajorant α u c A z.1 (modelCenterRawReorder z.2)

/-- Pulling the separated majorant through the two spatial shears preserves
joint integrability. -/
theorem integrable_modelRawCenterMajorant_of_isFinite
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (A : E3 → ℝ)
    (ν : Measure ℝ) [IsFiniteMeasure ν]
    (hc : Measurable c) (hcBound : ∀ t : ℝ, |c t| ≤ 1)
    (hAmeas : Measurable A) (hAint : Integrable A)
    (hAnonneg : ∀ x : E3, 0 ≤ A x)
    (hpos : ∀ᵐ t ∂ν, 0 < t) :
    Integrable (modelRawCenterMajorant α u c A)
      (ν.prod ((((volume : Measure E3).prod volume).prod volume).prod volume)) := by
  let : SFinite (((volume : Measure E3).prod (volume : Measure E3)).prod
      (volume : Measure E3)) := inferInstance
  let η : Measure (((E3 × E3) × E3) × ℝ) :=
    (((volume : Measure E3).prod volume).prod volume).prod volume
  let : SFinite η := by
    dsimp [η]
    infer_instance
  let : SFinite ((volume : Measure E3).prod (volume : Measure E3)) := inferInstance
  let : SFinite ((volume : Measure E3).prod (volume : Measure ℝ)) := inferInstance
  let μ : Measure ((E3 × E3) × (E3 × ℝ)) :=
    ((volume : Measure E3).prod volume).prod
      ((volume : Measure E3).prod volume)
  let : SFinite μ := by
    dsimp [μ]
    infer_instance
  have hbase : Integrable (fun z : ℝ × ((E3 × E3) × (E3 × ℝ)) ↦
      modelCenterMajorant α u c A z.1 z.2) (ν.prod μ) := by
    simpa only [μ] using integrable_modelCenterMajorant_joint_of_isFinite
      α u c A ν hc hcBound hAmeas hAint hAnonneg hpos
  have hmp : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ) modelCenterRawReorder)
      (ν.prod η) (ν.prod μ) := by
    exact (MeasurePreserving.id ν).prod modelCenterRawReorder_measurePreserving
  apply hmp.integrable_comp_of_integrable hbase |>.congr
  filter_upwards [] with z
  rfl

/-- The raw center-translation integrand, including a measurable scale
coefficient, is jointly measurable before any estimate is applied. -/
theorem measurable_coefficient_modelCenterTranslation
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (hc : Measurable c) :
    Measurable (fun z : ℝ × (((E3 × E3) × E3) × ℝ) ↦
      c z.1 * ModelCenterTranslationIntegrand α u F z.1 z.2) := by
  let X := ℝ × (((E3 × E3) × E3) × ℝ)
  have ht : Measurable (fun z : X ↦ z.1) := measurable_fst
  have hx : Measurable (fun z : X ↦ z.2.1.1.1) :=
    measurable_fst.comp (measurable_fst.comp (measurable_fst.comp measurable_snd))
  have hy : Measurable (fun z : X ↦ z.2.1.1.2) :=
    measurable_snd.comp (measurable_fst.comp (measurable_fst.comp measurable_snd))
  have hp : Measurable (fun z : X ↦ z.2.1.2) :=
    measurable_snd.comp (measurable_fst.comp measurable_snd)
  have hr : Measurable (fun z : X ↦ z.2.2) :=
    measurable_snd.comp measurable_snd
  have hxi (i : Fin 3) : Measurable (fun z : X ↦ z.2.1.1.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp hx
  have hyi (i : Fin 3) : Measurable (fun z : X ↦ z.2.1.1.2 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp hy
  have hpi (i : Fin 3) : Measurable (fun z : X ↦ z.2.1.2 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp hp
  have hderiv : Measurable gaussianDeriv := by
    unfold gaussianDeriv
    exact (measurable_const.mul measurable_id).mul
      gaussian_contDiff.continuous.measurable
  have h0 : Measurable (fun z : X ↦ F 0 z.2.1.1.1) :=
    (F 0).continuous.measurable.comp hx
  have h1 : Measurable (fun z : X ↦
      F 1 (modelPoint (z.2.1.1.2 0) (z.2.1.1.1 1) (z.2.1.1.1 2))) :=
    (F 1).continuous.measurable.comp
      (measurable_modelPoint _ _ _ (hyi 0) (hxi 1) (hxi 2))
  have h2 : Measurable (fun z : X ↦
      F 2 (modelPoint (z.2.1.1.1 0) (z.2.1.1.2 1) (z.2.1.1.1 2))) :=
    (F 2).continuous.measurable.comp
      (measurable_modelPoint _ _ _ (hxi 0) (hyi 1) (hxi 2))
  have h3 : Measurable (fun z : X ↦
      F 3 (modelPoint (z.2.1.1.1 0) (z.2.1.1.1 1) (z.2.1.1.2 2))) :=
    (F 3).continuous.measurable.comp
      (measurable_modelPoint _ _ _ (hxi 0) (hxi 1) (hyi 2))
  have hphi0 : Measurable (fun z : X ↦
      modelPhiAt (z.1 ^ α.weight 0)
        (z.2.1.2 0 + z.1 ^ α.weight 0 * u 0) (z.2.1.1.1 0)) :=
    measurable_kernelAt conePhiPhysicalReal
      conePhiPhysicalReal.continuous.measurable _ _ _
      (ht.pow_const _) ((hpi 0).add ((ht.pow_const _).mul measurable_const)) (hxi 0)
  have hgauss0 : Measurable (fun z : X ↦
      gaussianAt (z.1 ^ α.weight 0) (z.2.1.2 0) (z.2.1.1.2 0)) :=
    measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable _ _ _
      (ht.pow_const _) (hpi 0) (hyi 0)
  have hphi1 : Measurable (fun z : X ↦
      modelPhiAt (z.1 ^ α.weight 1)
        (z.2.1.2 1 + z.1 ^ α.weight 1 * u 1) (z.2.1.1.1 1)) :=
    measurable_kernelAt conePhiPhysicalReal
      conePhiPhysicalReal.continuous.measurable _ _ _
      (ht.pow_const _) ((hpi 1).add ((ht.pow_const _).mul measurable_const)) (hxi 1)
  have hgauss1 : Measurable (fun z : X ↦
      gaussianAt (z.1 ^ α.weight 1) (z.2.1.2 1) (z.2.1.1.2 1)) :=
    measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable _ _ _
      (ht.pow_const _) (hpi 1) (hyi 1)
  have hderiv0 : Measurable (fun z : X ↦
      gaussianDerivAt (z.1 ^ α.weight 2) (z.2.1.2 2) (z.2.1.1.1 2)) :=
    measurable_kernelAt gaussianDeriv hderiv _ _ _
      (ht.pow_const _) (hpi 2) (hxi 2)
  have hderiv1 : Measurable (fun z : X ↦
      gaussianDerivAt (z.1 ^ α.weight 2)
        (z.2.1.2 2 + z.2.2 * z.1 ^ α.weight 2) (z.2.1.1.2 2)) :=
    measurable_kernelAt gaussianDeriv hderiv _ _ _
      (ht.pow_const _) ((hpi 2).add (hr.mul (ht.pow_const _))) (hyi 2)
  have hpsi : Measurable (fun z : X ↦
      conePsiPhysicalReal (z.2.2 + u 2)) :=
    conePsiPhysicalReal.continuous.measurable.comp (hr.add measurable_const)
  have hc' : Measurable (fun z : X ↦ c z.1) := hc.comp ht
  change Measurable (fun z : X ↦ c z.1 *
    ((F 0 z.2.1.1.1 * F 1 (modelPoint (z.2.1.1.2 0)
          (z.2.1.1.1 1) (z.2.1.1.1 2)) *
        F 2 (modelPoint (z.2.1.1.1 0) (z.2.1.1.2 1) (z.2.1.1.1 2)) *
        F 3 (modelPoint (z.2.1.1.1 0) (z.2.1.1.1 1) (z.2.1.1.2 2))) *
      ((modelPhiAt (z.1 ^ α.weight 0)
          (z.2.1.2 0 + z.1 ^ α.weight 0 * u 0) (z.2.1.1.1 0) *
        gaussianAt (z.1 ^ α.weight 0) (z.2.1.2 0) (z.2.1.1.2 0)) *
      (modelPhiAt (z.1 ^ α.weight 1)
          (z.2.1.2 1 + z.1 ^ α.weight 1 * u 1) (z.2.1.1.1 1) *
        gaussianAt (z.1 ^ α.weight 1) (z.2.1.2 1) (z.2.1.1.2 1)) *
      (gaussianDerivAt (z.1 ^ α.weight 2) (z.2.1.2 2) (z.2.1.1.1 2) *
        gaussianDerivAt (z.1 ^ α.weight 2)
          (z.2.1.2 2 + z.2.2 * z.1 ^ α.weight 2) (z.2.1.1.2 2) *
          conePsiPhysicalReal (z.2.2 + u 2)))))
  exact hc'.mul
    ((((h0.mul h1).mul h2).mul h3).mul
      (((hphi0.mul hgauss0).mul (hphi1.mul hgauss1)).mul
        ((hderiv0.mul hderiv1).mul hpsi)))

/-- A bounded measurable scale coefficient times the raw center integrand
is jointly integrable over every finite positive scale measure. -/
theorem integrable_coefficient_modelCenterTranslation_of_isFinite
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (ν : Measure ℝ) [IsFiniteMeasure ν]
    (hc : Measurable c) (hcBound : ∀ t : ℝ, |c t| ≤ 1)
    (hpos : ∀ᵐ t ∂ν, 0 < t) :
    Integrable (fun z : ℝ × (((E3 × E3) × E3) × ℝ) ↦
      c z.1 * ModelCenterTranslationIntegrand α u F z.1 z.2)
      (ν.prod ((((volume : Measure E3).prod volume).prod volume).prod volume)) := by
  obtain ⟨B₁, hB₁, hF₁⟩ := initialModelRealInput_bounded F 1
  obtain ⟨B₂, hB₂, hF₂⟩ := initialModelRealInput_bounded F 2
  obtain ⟨B₃, hB₃, hF₃⟩ := initialModelRealInput_bounded F 3
  let C : ℝ := B₁ * B₂ * B₃
  let A : E3 → ℝ := fun x ↦ C * |F 0 x|
  have hAmeas : Measurable A := by
    dsimp only [A]
    exact measurable_const.mul ((F 0).continuous.measurable.norm)
  have hAint : Integrable A := by
    have hF₀ : Integrable (fun x : E3 ↦ |F 0 x|) := by
      simpa only [Real.norm_eq_abs] using (F 0).integrable.norm
    simpa only [A] using hF₀.const_mul C
  have hAnonneg : ∀ x : E3, 0 ≤ A x := by
    intro x
    dsimp only [A, C]
    exact mul_nonneg (mul_nonneg (mul_nonneg hB₁ hB₂) hB₃) (abs_nonneg _)
  have hmajor : Integrable (modelRawCenterMajorant α u c A)
      (ν.prod ((((volume : Measure E3).prod volume).prod volume).prod volume)) :=
    integrable_modelRawCenterMajorant_of_isFinite
      α u c A ν hc hcBound hAmeas hAint hAnonneg hpos
  have hmeas : AEStronglyMeasurable
      (fun z : ℝ × (((E3 × E3) × E3) × ℝ) ↦
        c z.1 * ModelCenterTranslationIntegrand α u F z.1 z.2)
      (ν.prod ((((volume : Measure E3).prod volume).prod volume).prod volume)) :=
    (measurable_coefficient_modelCenterTranslation α u c F hc).aestronglyMeasurable
  apply hmajor.mono' hmeas
  filter_upwards [] with z
  rcases z with ⟨t, ⟨⟨⟨x, y⟩, p⟩, r⟩⟩
  change ‖c t * ModelCenterTranslationIntegrand α u F t (((x, y), p), r)‖ ≤
    modelRawCenterMajorant α u c A (t, (((x, y), p), r))
  rw [Real.norm_eq_abs]
  simp only [ModelCenterTranslationIntegrand, abs_mul,
    modelRawCenterMajorant, modelCenterRawReorder_apply,
    modelCenterMajorant, modelCenterP, modelCenterQ]
  rw [modelPhiAt_center_shift (t ^ α.weight 0) (p 0)
      (t ^ α.weight 0 * u 0) (x 0),
    gaussianAt_center_shift (t ^ α.weight 0) (p 0) (y 0),
    modelPhiAt_center_shift (t ^ α.weight 1) (p 1)
      (t ^ α.weight 1 * u 1) (x 1),
    gaussianAt_center_shift (t ^ α.weight 1) (p 1) (y 1),
    gaussianDerivAt_center_shift (t ^ α.weight 2) (p 2) (x 2),
    show gaussianDerivAt (t ^ α.weight 2)
        (p 2 + r * t ^ α.weight 2) (y 2) =
        gaussianDerivAt (t ^ α.weight 2)
          (r * t ^ α.weight 2) (y 2 - p 2) by
        simpa only [gaussianDerivAt] using
          kernelAt_center_shift gaussianDeriv (t ^ α.weight 2)
            (p 2) (r * t ^ α.weight 2) (y 2)]
  simp only [PiLp.sub_apply, neg_sub]
  have hinput :
      |F 1 (modelPoint (y 0) (x 1) (x 2))| *
        |F 2 (modelPoint (x 0) (y 1) (x 2))| *
          |F 3 (modelPoint (x 0) (x 1) (y 2))| ≤ C := by
    dsimp only [C]
    gcongr
    · exact hF₁ _
    · exact hF₂ _
    · exact hF₃ _
  have hkernel : 0 ≤
      (|modelPhiAt (t ^ α.weight 0)
          (t ^ α.weight 0 * u 0) (x 0 - p 0)| *
        |modelPhiAt (t ^ α.weight 1)
          (t ^ α.weight 1 * u 1) (x 1 - p 1)| *
        |gaussianDerivAt (t ^ α.weight 2) 0 (x 2 - p 2)|) *
      ((|gaussianAt (t ^ α.weight 0) 0 (y 0 - p 0)| *
          |gaussianAt (t ^ α.weight 1) 0 (y 1 - p 1)|) *
        (|gaussianDerivAt (t ^ α.weight 2)
            (r * t ^ α.weight 2) (y 2 - p 2)| *
          |conePsiPhysicalReal (r + u 2)|)) := by
    positivity
  have hinputF0 :
      (|F 1 (modelPoint (y 0) (x 1) (x 2))| *
        |F 2 (modelPoint (x 0) (y 1) (x 2))| *
        |F 3 (modelPoint (x 0) (x 1) (y 2))|) * |F 0 x| ≤
        C * |F 0 x| :=
    mul_le_mul_of_nonneg_right hinput (abs_nonneg _)
  have hinside :
      ((|F 1 (modelPoint (y 0) (x 1) (x 2))| *
        |F 2 (modelPoint (x 0) (y 1) (x 2))| *
        |F 3 (modelPoint (x 0) (x 1) (y 2))|) * |F 0 x|) *
        ((|modelPhiAt (t ^ α.weight 0)
            (t ^ α.weight 0 * u 0) (x 0 - p 0)| *
          |modelPhiAt (t ^ α.weight 1)
            (t ^ α.weight 1 * u 1) (x 1 - p 1)| *
          |gaussianDerivAt (t ^ α.weight 2) 0 (x 2 - p 2)|) *
          ((|gaussianAt (t ^ α.weight 0) 0 (y 0 - p 0)| *
            |gaussianAt (t ^ α.weight 1) 0 (y 1 - p 1)|) *
            (|gaussianDerivAt (t ^ α.weight 2)
                (r * t ^ α.weight 2) (y 2 - p 2)| *
              |conePsiPhysicalReal (r + u 2)|))) ≤
      (C * |F 0 x|) *
        ((|modelPhiAt (t ^ α.weight 0)
            (t ^ α.weight 0 * u 0) (x 0 - p 0)| *
          |modelPhiAt (t ^ α.weight 1)
            (t ^ α.weight 1 * u 1) (x 1 - p 1)| *
          |gaussianDerivAt (t ^ α.weight 2) 0 (x 2 - p 2)|) *
          ((|gaussianAt (t ^ α.weight 0) 0 (y 0 - p 0)| *
            |gaussianAt (t ^ α.weight 1) 0 (y 1 - p 1)|) *
            (|gaussianDerivAt (t ^ α.weight 2)
                (r * t ^ α.weight 2) (y 2 - p 2)| *
              |conePsiPhysicalReal (r + u 2)|))) :=
    mul_le_mul_of_nonneg_right hinputF0 hkernel
  have htotal := mul_le_mul_of_nonneg_left hinside (abs_nonneg (c t))
  calc
    |c t| *
        (|F 0 x| * |F 1 (modelPoint (y 0) (x 1) (x 2))| *
          |F 2 (modelPoint (x 0) (y 1) (x 2))| *
          |F 3 (modelPoint (x 0) (x 1) (y 2))| *
          ((|modelPhiAt (t ^ α.weight 0)
              (t ^ α.weight 0 * u 0) (x 0 - p 0)| *
            |gaussianAt (t ^ α.weight 0) 0 (y 0 - p 0)|) *
            (|modelPhiAt (t ^ α.weight 1)
              (t ^ α.weight 1 * u 1) (x 1 - p 1)| *
            |gaussianAt (t ^ α.weight 1) 0 (y 1 - p 1)|) *
            (|gaussianDerivAt (t ^ α.weight 2) 0 (x 2 - p 2)| *
            |gaussianDerivAt (t ^ α.weight 2)
              (r * t ^ α.weight 2) (y 2 - p 2)| *
              |conePsiPhysicalReal (r + u 2)|))) =
      |c t| *
        ((|F 1 (modelPoint (y 0) (x 1) (x 2))| *
          |F 2 (modelPoint (x 0) (y 1) (x 2))| *
          |F 3 (modelPoint (x 0) (x 1) (y 2))|) * |F 0 x| *
        ((|modelPhiAt (t ^ α.weight 0)
            (t ^ α.weight 0 * u 0) (x 0 - p 0)| *
          |modelPhiAt (t ^ α.weight 1)
            (t ^ α.weight 1 * u 1) (x 1 - p 1)| *
          |gaussianDerivAt (t ^ α.weight 2) 0 (x 2 - p 2)|) *
          ((|gaussianAt (t ^ α.weight 0) 0 (y 0 - p 0)| *
            |gaussianAt (t ^ α.weight 1) 0 (y 1 - p 1)|) *
            (|gaussianDerivAt (t ^ α.weight 2)
                (r * t ^ α.weight 2) (y 2 - p 2)| *
              |conePsiPhysicalReal (r + u 2)|)))) := by ring
    _ ≤ |c t| *
        ((C * |F 0 x|) *
        ((|modelPhiAt (t ^ α.weight 0)
            (t ^ α.weight 0 * u 0) (x 0 - p 0)| *
          |modelPhiAt (t ^ α.weight 1)
            (t ^ α.weight 1 * u 1) (x 1 - p 1)| *
          |gaussianDerivAt (t ^ α.weight 2) 0 (x 2 - p 2)|) *
          ((|gaussianAt (t ^ α.weight 0) 0 (y 0 - p 0)| *
            |gaussianAt (t ^ α.weight 1) 0 (y 1 - p 1)|) *
            (|gaussianDerivAt (t ^ α.weight 2)
                (r * t ^ α.weight 2) (y 2 - p 2)| *
              |conePsiPhysicalReal (r + u 2)|)))) := htotal
    _ = _ := by
      dsimp only [A]
      ring

/-- The raw center-translation expression is jointly integrable on every
literal finite truncation scale band. -/
theorem integrable_coefficient_modelCenterTranslation_truncationScale
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (N : ℕ) (hc : Measurable c) (hcBound : ∀ t : ℝ, |c t| ≤ 1) :
    Integrable (fun z : ℝ × (((E3 × E3) × E3) × ℝ) ↦
      c z.1 * ModelCenterTranslationIntegrand α u F z.1 z.2)
      ((((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (truncationScaleSet N)).prod
        ((((volume : Measure E3).prod volume).prod volume).prod volume)) := by
  let ν : Measure ℝ := ((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
    (truncationScaleSet N)
  let : IsFiniteMeasure ν := by
    dsimp only [ν]
    exact isFiniteMeasure_truncationScaleSet N
  apply integrable_coefficient_modelCenterTranslation_of_isFinite
    α u c F ν hc hcBound
  filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
  exact truncationScaleSet_subset_positive N ht

/-- The fully opened fiber integrand is absolutely integrable on each
finite truncation slab for every bounded measurable coefficient and real
Schwartz input. -/
theorem integrable_modelFiberFullyExpanded_truncationScale
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (N : ℕ) (hc : Measurable c) (hcBound : ∀ t : ℝ, |c t| ≤ 1) :
    Integrable (modelFiberFullyExpandedIntegrand α u c (InitialModelRealInput F))
      (((cubeScaleMeasure.restrict (Set.univ ×ˢ truncationScaleSet N)).prod
        (volume : Measure ModelE5)).prod ((volume : Measure ℝ).prod volume)) := by
  let ν : Measure ℝ := ((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
    (truncationScaleSet N)
  let : SFinite (((volume : Measure E3).prod (volume : Measure E3)).prod
      (volume : Measure E3)) := inferInstance
  let η : Measure (((E3 × E3) × E3) × ℝ) :=
    (((volume : Measure E3).prod volume).prod volume).prod volume
  let : SFinite η := by
    dsimp [η]
    infer_instance
  let e := modelFiberCenterReorder
  have hraw : Integrable (fun z : ℝ × (((E3 × E3) × E3) × ℝ) ↦
      c z.1 * ModelCenterTranslationIntegrand α u F z.1 z.2) (ν.prod η) := by
    simpa only [ν, η] using
      integrable_coefficient_modelCenterTranslation_truncationScale
        α u c F N hc hcBound
  have hscale : cubeScaleMeasure.restrict
      (Set.univ ×ˢ truncationScaleSet N) = (volume : Measure E3).prod ν := by
    unfold cubeScaleMeasure ν
    rw [← Measure.prod_restrict]
    simp
  have hmp : MeasurePreserving e
      (((((volume : Measure E3).prod ν).prod
        (volume : Measure ModelE5)).prod ((volume : Measure ℝ).prod volume)))
      (ν.prod η) := by
    simpa only [e, η] using modelFiberCenterReorder_measurePreserving ν
  have htransport : Integrable (fun q : ((E3 × ℝ) × ModelE5) × (ℝ × ℝ) ↦
      (fun z : ℝ × (((E3 × E3) × E3) × ℝ) ↦
        c z.1 * ModelCenterTranslationIntegrand α u F z.1 z.2) (e q))
      (((((volume : Measure E3).prod ν).prod
        (volume : Measure ModelE5)).prod ((volume : Measure ℝ).prod volume))) :=
    hmp.integrable_comp_of_integrable hraw
  rw [hscale]
  apply htransport.congr
  filter_upwards [] with q
  rcases hq : e q with ⟨t, ⟨⟨⟨x, y⟩, p⟩, r⟩⟩
  rw [← e.symm_apply_apply q, hq]
  simpa only [e] using
    (modelFiberFullyExpandedIntegrand_centerReorder_symm
      α u c F t x y p r).symm

/-! ### Strict initial model range -/

/-- Rescaling a nonzero finite `L^p` size by its reciprocal produces unit
`lpNorm`. -/
theorem lpNorm_inv_smul_eq_one
    (f : E3 → ℝ) (p : ℝ)
    (hpos : 0 < lpNorm f (ENNReal.ofReal p) volume) :
    lpNorm ((lpNorm f (ENNReal.ofReal p) volume)⁻¹ • f)
      (ENNReal.ofReal p) volume = 1 := by
  rw [lpNorm_const_smul]
  have hnorm : ‖(lpNorm f (ENNReal.ofReal p) volume)⁻¹‖₊ =
      (lpNorm f (ENNReal.ofReal p) volume)⁻¹ := by
    change ‖(lpNorm f (ENNReal.ofReal p) volume)⁻¹‖ =
      (lpNorm f (ENNReal.ofReal p) volume)⁻¹
    rw [Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hpos)]
  rw [hnorm, inv_mul_cancel₀ hpos.ne']

/-- Unit finite `lpNorm` is equivalent to a unit ordinary power integral for
a strongly measurable real function. -/
theorem integral_abs_rpow_eq_one_of_lpNorm_eq_one
    (f : E3 → ℝ) (p : ℝ) (hp : 0 < p)
    (hf : AEStronglyMeasurable f volume)
    (hnorm : lpNorm f (ENNReal.ofReal p) volume = 1) :
    (∫ x : E3, |f x| ^ p) = 1 := by
  have hp0 : (ENNReal.ofReal p) ≠ 0 :=
    ENNReal.ofReal_ne_zero_iff.mpr hp
  have hptop : (ENNReal.ofReal p) ≠ ∞ := ENNReal.ofReal_ne_top
  have hlp := lpNorm_eq_integral_norm_rpow_toReal hp0 hptop hf
  simp only [ENNReal.toReal_ofReal hp.le, Real.norm_eq_abs] at hlp
  have hI : 0 ≤ ∫ x : E3, |f x| ^ p :=
    integral_nonneg fun x ↦ Real.rpow_nonneg (abs_nonneg _) _
  have hpow := congrArg (fun z : ℝ ↦ z ^ p) hnorm
  rw [hlp, Real.one_rpow, Real.rpow_inv_rpow hI hp.ne'] at hpow
  exact hpow

/-- A nonzero real Schwartz function has strictly positive finite `L^p`
size at every positive finite exponent. -/
theorem lpNorm_pos_of_realSchwartz_ne_zero
    (f : SchwartzMap E3 ℝ) (p : ℝ) (hp : 0 < p) (hf : f ≠ 0) :
    0 < lpNorm (f : E3 → ℝ) (ENNReal.ofReal p) volume := by
  have hp0 : (ENNReal.ofReal p) ≠ 0 :=
    ENNReal.ofReal_ne_zero_iff.mpr hp
  have hmem : MemLp (f : E3 → ℝ) (ENNReal.ofReal p) volume :=
    f.memLp (ENNReal.ofReal p) volume
  have hne : lpNorm (f : E3 → ℝ) (ENNReal.ofReal p) volume ≠ 0 := by
    intro hzero
    have hae : (f : E3 → ℝ) =ᵐ[volume] 0 :=
      (lpNorm_eq_zero hmem hp0).mp hzero
    have hfun : (f : E3 → ℝ) = 0 :=
      (f.continuous.ae_eq_iff_eq (μ := volume) continuous_zero).mp hae
    apply hf
    ext x
    exact congrFun hfun x
  exact lt_of_le_of_ne lpNorm_nonneg hne.symm

/-- A four-linear real model functional which is bounded on independently
normalized inputs is bounded by the product of the four normalizing sizes. -/
theorem fourlinear_bound_of_normalized_bound
    (L : ModelSchwartzInput → ℝ)
    (N : Fin 4 → SchwartzMap E3 ℝ → ℝ)
    (C : ℝ)
    (hL : ∀ (a : Fin 4 → ℝ) (F : ModelSchwartzInput),
      L (modelInputRescale a F) = (∏ j : Fin 4, a j) * L F)
    (hunit : ∀ G : ModelSchwartzInput,
      (∀ j : Fin 4, N j (G j) = 1) → |L G| ≤ C)
    (F : ModelSchwartzInput)
    (hpos : ∀ j : Fin 4, 0 < N j (F j))
    (hnormalize : ∀ j : Fin 4,
      N j ((N j (F j))⁻¹ • F j) = 1) :
    |L F| ≤ C * ∏ j : Fin 4, N j (F j) := by
  let a : Fin 4 → ℝ := fun j ↦ (N j (F j))⁻¹
  let P : ℝ := ∏ j : Fin 4, N j (F j)
  have hPpos : 0 < P := by
    dsimp only [P]
    exact Finset.prod_pos fun j _ ↦ hpos j
  have hPnonneg : 0 ≤ P := hPpos.le
  have haPos : 0 < ∏ j : Fin 4, a j := by
    apply Finset.prod_pos
    intro j _
    dsimp only [a]
    exact inv_pos.mpr (hpos j)
  have haP : P * ∏ j : Fin 4, a j = 1 := by
    dsimp only [P, a]
    rw [← Finset.prod_mul_distrib]
    apply Finset.prod_eq_one
    intro j _
    exact mul_inv_cancel₀ (hpos j).ne'
  have hnorm : ∀ j : Fin 4, N j (modelInputRescale a F j) = 1 := by
    intro j
    change N j (a j • F j) = 1
    exact hnormalize j
  have hnormalized := hunit (modelInputRescale a F) hnorm
  rw [hL a F, abs_mul] at hnormalized
  calc
    |L F| = (P * ∏ j : Fin 4, a j) * |L F| := by rw [haP]; ring
    _ = P * (|(∏ j : Fin 4, a j)| * |L F|) := by
      rw [abs_of_pos haPos]
      ring
    _ ≤ P * C := mul_le_mul_of_nonneg_left hnormalized hPnonneg
    _ = C * ∏ j : Fin 4, N j (F j) := by
      dsimp only [P]
      ring

/-- The two-index limit only needs finite-forest bounds for the actual
measurable scale cutoffs of the given coefficient. -/
theorem modelFullForm_bound_of_restrictedForest
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (B : ℝ) (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hfull : ∀ N : ℕ, Integrable
      (modelFiberFullyExpandedIntegrand α u c (InitialModelRealInput F))
      (((cubeScaleMeasure.restrict
        (Set.univ ×ˢ truncationScaleSet N)).prod
          (volume : Measure ModelE5)).prod
        ((volume : Measure ℝ).prod volume)))
    (hforest : ∀ N M : ℕ,
      |expandedModelLocalForm α (truncationCollection α M) u
        (RestrictScaleCoefficient c (truncationScaleSet N))
        (InitialModelRealInput F)| ≤ B) :
    |ModelFullForm α u c F| ≤ B := by
  have hscale := tendsto_ModelScaleTruncation_of_realSchwartz
    α u c F hcmeas hc
  have hscaleAbs : Tendsto (fun N ↦ |ModelScaleTruncation α u c F N|)
      atTop (𝓝 |ModelFullForm α u c F|) := by
    exact (continuous_abs.tendsto _).comp hscale
  apply le_of_tendsto hscaleAbs
  filter_upwards [] with N
  apply modelScaleTruncation_bound_of_twoIndex_localization
    α u c F B N
  · exact tendsto_expandedModelLocalForm_twoIndex_of_fullyExpanded_auto
      α u c F N (hfull N)
  · exact hforest N

/-- A fixed uniform finite-forest constant and a scalar stopping-envelope
bound yield the full real Schwartz model estimate. -/
theorem modelFullForm_bound_of_initial_stoppingEnvelope_of_uniformForest
    (α : Anisotropy) (C : ℝ) (hC : 0 ≤ C)
    (hforest : ∀ S (_hS : IsConvexCollection α S) u c
      (F : InitialModelSchwartzInput) (q σ : Fin 4 → ℝ)
      (_hq : ∀ j, 0 < q j)
      (hpos : ∀ r ∈ S, ∀ j,
        0 < stoppingData α S (sourceStoppingExponent j)
          (InitialModelRealInput F j) r)
      (_hcmeas : Measurable c) (_hc : ∀ t, |c t| ≤ 1)
      (_hfinite : ∀ (j : Fin 4) (m : ℤ),
        volume (sourceStoppingMaximalLevelSetAt α
          (InitialModelRealInput F) j m) ≠ ∞),
      |expandedModelLocalForm α S u c (InitialModelRealInput F)| ≤
        C * sourceWeight u ^ 75 *
          SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F)
            q σ hpos)
    (u : E3) (c : ℝ → ℝ) (F : InitialModelSchwartzInput)
    (q σ : Fin 4 → ℝ) (W : ℝ)
    (hq : ∀ j, 0 < q j) (hFnonzero : ∀ j, F j ≠ 0)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hfull : ∀ N : ℕ, Integrable
      (modelFiberFullyExpandedIntegrand α u c (InitialModelRealInput F))
      (((cubeScaleMeasure.restrict
        (Set.univ ×ˢ truncationScaleSet N)).prod
          (volume : Measure ModelE5)).prod
        ((volume : Measure ℝ).prod volume)))
    (hdistribution : ∀ M : ℕ,
      SourceStoppingCoordinateEnvelope α (truncationCollection α M)
        (InitialModelRealInput F) q σ
        (initialModel_sourceStoppingData_all_pos_of_ne_zero
          α (truncationCollection α M) F hFnonzero) ≤ W) :
    |ModelFullForm α u c F| ≤ C * sourceWeight u ^ 75 * W := by
  apply modelFullForm_bound_of_restrictedForest
    α u c F (C * sourceWeight u ^ 75 * W) hcmeas hc hfull
  intro N M
  let d : ℝ → ℝ := RestrictScaleCoefficient c (truncationScaleSet N)
  let hpos : ∀ r ∈ truncationCollection α M, ∀ j,
      0 < stoppingData α (truncationCollection α M)
        (sourceStoppingExponent j) (InitialModelRealInput F j) r :=
    initialModel_sourceStoppingData_all_pos_of_ne_zero
      α (truncationCollection α M) F hFnonzero
  have hdmeas : Measurable d := by
    exact measurable_RestrictScaleCoefficient c (truncationScaleSet N)
      hcmeas measurableSet_Ioc
  have hd : ∀ t : ℝ, |d t| ≤ 1 := by
    exact abs_restrictScaleCoefficient_le_one c (truncationScaleSet N) hc
  have hfinite : ∀ (j : Fin 4) (m : ℤ),
      volume (sourceStoppingMaximalLevelSetAt α
        (InitialModelRealInput F) j m) ≠ ∞ := by
    exact sourceStopping_coordinateLevel_finite_of_initialModelRealSchwartz α F
  have hlocal := hforest (truncationCollection α M)
    (isConvexCollection_truncationCollection α M) u d F q σ hq hpos
    hdmeas hd hfinite
  change |expandedModelLocalForm α (truncationCollection α M) u d
    (InitialModelRealInput F)| ≤ C * sourceWeight u ^ 75 * W
  calc
    |expandedModelLocalForm α (truncationCollection α M) u d
        (InitialModelRealInput F)| ≤
        C * sourceWeight u ^ 75 *
          SourceStoppingCoordinateEnvelope α (truncationCollection α M)
            (InitialModelRealInput F) q σ hpos := hlocal
    _ ≤ C * sourceWeight u ^ 75 * W := by
      apply mul_le_mul_of_nonneg_left (hdistribution M)
      exact mul_nonneg hC (pow_nonneg (sourceWeight_nonneg u) _)

/-- The explicitly assembled stopping constant is nonnegative. -/
theorem sourceStoppingDyadicInputConstant_nonneg
    (K q : Fin 4 → ℝ) (j : Fin 4) (hq : 0 < q j) :
    0 ≤ sourceStoppingDyadicInputConstant K q j := by
  unfold sourceStoppingDyadicInputConstant
  calc
    0 ≤ (8 * ((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
        (sourceStoppingComparisonConstant j / 2) ^ (-(q j)))) *
        (dyadicStrongFactor (K j)
          (q j / sourceStoppingExponent j) ^ 3).toReal :=
      mul_nonneg
        (sourceStoppingDistributionCoefficient_nonneg j (q j) hq)
        ENNReal.toReal_nonneg
    _ = _ := by ring

/-- The complete strict initial range for a nonzero real Schwartz tuple.
The constant is independent of the translation, coefficient, and input tuple. -/
theorem initialModelFullForm_bound_of_nonzero
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : InitialModelSchwartzInput)
    (q : Fin 4 → ℝ)
    (hq : ∀ j : Fin 4, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j : Fin 4, sourceStoppingExponent j < q j)
    (hF : ∀ j : Fin 4, F j ≠ 0)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1) :
    ∃ C : ℝ, 0 ≤ C ∧
      |ModelFullForm α u c F| ≤ C * sourceWeight u ^ 75 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
  rcases exists_uniform_activeStoppingForest_constant α with
    ⟨C₀, hC₀, hforest⟩
  let K : Fin 4 → ℝ := fun _ ↦ dyadicBracketShellConstant
  let D : Fin 4 → ℝ := fun j ↦ sourceStoppingDyadicInputConstant K q j
  let C : ℝ := C₀ * ∑ j : Fin 4, D j
  have hD : ∀ j : Fin 4, 0 ≤ D j := by
    intro j
    dsimp only [D]
    exact sourceStoppingDyadicInputConstant_nonneg K q j (hq j)
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg hC₀ (Finset.sum_nonneg fun j _ ↦ hD j)
  refine ⟨C, hC, ?_⟩
  apply fourlinear_bound_of_normalized_bound
    (L := ModelFullForm α u c)
    (N := fun j f ↦ lpNorm (f : E3 → ℝ) (ENNReal.ofReal (q j)) volume)
    (C := C * sourceWeight u ^ 75)
  · exact ModelFullForm_rescale α u c
  · intro G hGunit
    have hG : ∀ j : Fin 4, G j ≠ 0 := by
      intro j hzero
      have hzeroNorm : lpNorm (G j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume = 0 := by
        rw [hzero]
        change lpNorm (0 : E3 → ℝ) (ENNReal.ofReal (q j)) volume = 0
        exact lpNorm_zero (ENNReal.ofReal (q j)) volume
      linarith [hGunit j]
    let W : ℝ := ∑ j : Fin 4, D j *
      ∫ x : E3, |G j x| ^ q j
    have hfull : ∀ N : ℕ, Integrable
        (modelFiberFullyExpandedIntegrand α u c (InitialModelRealInput G))
        (((cubeScaleMeasure.restrict
          (Set.univ ×ˢ truncationScaleSet N)).prod
            (volume : Measure ModelE5)).prod
          ((volume : Measure ℝ).prod volume)) := by
      intro N
      exact integrable_modelFiberFullyExpanded_truncationScale
        α u c G N hcmeas hc
    have hdistribution : ∀ M : ℕ,
        SourceStoppingCoordinateEnvelope α (truncationCollection α M)
          (InitialModelRealInput G) q (fun _ ↦ 0)
          (initialModel_sourceStoppingData_all_pos_of_ne_zero
            α (truncationCollection α M) G hG) ≤ W := by
      intro M
      dsimp only [W, D, K]
      exact initialSourceStoppingCoordinateEnvelope_le_explicitInputPowers_of_realSchwartz
        α (truncationCollection α M) G q hq hsum hqs hG
    have hglobal :=
      modelFullForm_bound_of_initial_stoppingEnvelope_of_uniformForest
        α C₀ hC₀ hforest u c G q (fun _ ↦ 0) W hq hG hcmeas hc
        hfull hdistribution
    have hpower (j : Fin 4) :
        (∫ x : E3, |G j x| ^ q j) = 1 :=
      integral_abs_rpow_eq_one_of_lpNorm_eq_one
        (G j : E3 → ℝ) (q j) (hq j)
        (G j).continuous.aestronglyMeasurable (hGunit j)
    have hW : W = ∑ j : Fin 4, D j := by
      dsimp only [W]
      apply Finset.sum_congr rfl
      intro j _
      rw [hpower j, mul_one]
    rw [hW] at hglobal
    change |ModelFullForm α u c G| ≤ C * sourceWeight u ^ 75
    dsimp only [C]
    calc
      |ModelFullForm α u c G| ≤ C₀ * sourceWeight u ^ 75 * ∑ j : Fin 4, D j := hglobal
      _ = (C₀ * ∑ j : Fin 4, D j) * sourceWeight u ^ 75 := by ring
  · intro j
    exact lpNorm_pos_of_realSchwartz_ne_zero
      (F j) (q j) (hq j) (hF j)
  · intro j
    exact lpNorm_inv_smul_eq_one
      (F j : E3 → ℝ) (q j)
      (lpNorm_pos_of_realSchwartz_ne_zero
        (F j) (q j) (hq j) (hF j))

/-- The strict initial real model range, including zero input branches. -/
theorem initialModelFullForm_bound
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : InitialModelSchwartzInput)
    (q : Fin 4 → ℝ)
    (hq : ∀ j : Fin 4, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j : Fin 4, sourceStoppingExponent j < q j)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1) :
    ∃ C : ℝ, 0 ≤ C ∧
      |ModelFullForm α u c F| ≤ C * sourceWeight u ^ 75 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
  by_cases hzero : ∃ j : Fin 4, F j = 0
  · rcases hzero with ⟨j, hj⟩
    refine ⟨0, le_rfl, ?_⟩
    rw [ModelFullForm_eq_zero_of_component_eq_zero α u c F j hj]
    norm_num
  · have hF : ∀ j : Fin 4, F j ≠ 0 := by
      intro j hj
      exact hzero ⟨j, hj⟩
    exact initialModelFullForm_bound_of_nonzero
      α u c F q hq hsum hqs hF hcmeas hc

/-! ## Uniform strict initial-range constants -/

/-- The forest construction in the real initial range supplies one constant
for every translation, real unit coefficient, and real Schwartz four-tuple.
This places the quantifiers in the order needed by complexification. -/
theorem exists_uniform_initialModelFullForm_bound_weight75
    (α : Anisotropy) (q : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (c : ℝ → ℝ)
      (F : InitialModelSchwartzInput),
      Measurable c → (∀ t : ℝ, |c t| ≤ 1) →
      |ModelFullForm α u c F| ≤ C * sourceWeight u ^ 75 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume := by
  rcases exists_uniform_activeStoppingForest_constant α with
    ⟨C₀, hC₀, hforest⟩
  let K : Fin 4 → ℝ := fun _ ↦ dyadicBracketShellConstant
  let D : Fin 4 → ℝ := fun j ↦ sourceStoppingDyadicInputConstant K q j
  let C : ℝ := C₀ * ∑ j : Fin 4, D j
  have hD : ∀ j : Fin 4, 0 ≤ D j := by
    intro j
    dsimp only [D]
    exact sourceStoppingDyadicInputConstant_nonneg K q j (hq j)
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg hC₀ (Finset.sum_nonneg fun j _ ↦ hD j)
  refine ⟨C, hC, ?_⟩
  intro u c F hcmeas hc
  by_cases hzero : ∃ j : Fin 4, F j = 0
  · rcases hzero with ⟨j, hj⟩
    rw [ModelFullForm_eq_zero_of_component_eq_zero α u c F j hj]
    have hprod : 0 ≤ ∏ j : Fin 4,
        lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
      exact Finset.prod_nonneg fun j _ ↦ lpNorm_nonneg
    simpa using (mul_nonneg
      (mul_nonneg hC (pow_nonneg (sourceWeight_nonneg u) 75))
      hprod)
  · have hF : ∀ j : Fin 4, F j ≠ 0 := by
      intro j hj
      exact hzero ⟨j, hj⟩
    apply fourlinear_bound_of_normalized_bound
      (L := ModelFullForm α u c)
      (N := fun j f ↦ lpNorm (f : E3 → ℝ)
        (ENNReal.ofReal (q j)) volume)
      (C := C * sourceWeight u ^ 75)
    · exact ModelFullForm_rescale α u c
    · intro G hGunit
      have hG : ∀ j : Fin 4, G j ≠ 0 := by
        intro j hzero
        have hzeroNorm : lpNorm (G j : E3 → ℝ)
            (ENNReal.ofReal (q j)) volume = 0 := by
          rw [hzero]
          change lpNorm (0 : E3 → ℝ) (ENNReal.ofReal (q j)) volume = 0
          exact lpNorm_zero (ENNReal.ofReal (q j)) volume
        linarith [hGunit j]
      let W : ℝ := ∑ j : Fin 4, D j *
        ∫ x : E3, |G j x| ^ q j
      have hfull : ∀ N : ℕ, Integrable
          (modelFiberFullyExpandedIntegrand α u c (InitialModelRealInput G))
          (((cubeScaleMeasure.restrict
            (Set.univ ×ˢ truncationScaleSet N)).prod
              (volume : Measure ModelE5)).prod
            ((volume : Measure ℝ).prod volume)) := by
        intro N
        exact integrable_modelFiberFullyExpanded_truncationScale
          α u c G N hcmeas hc
      have hdistribution : ∀ M : ℕ,
          SourceStoppingCoordinateEnvelope α (truncationCollection α M)
            (InitialModelRealInput G) q (fun _ ↦ 0)
            (initialModel_sourceStoppingData_all_pos_of_ne_zero
              α (truncationCollection α M) G hG) ≤ W := by
        intro M
        dsimp only [W, D, K]
        exact initialSourceStoppingCoordinateEnvelope_le_explicitInputPowers_of_realSchwartz
          α (truncationCollection α M) G q hq hsum hqs hG
      have hglobal :=
        modelFullForm_bound_of_initial_stoppingEnvelope_of_uniformForest
          α C₀ hC₀ hforest u c G q (fun _ ↦ 0) W hq hG hcmeas hc
          hfull hdistribution
      have hpower (j : Fin 4) :
          (∫ x : E3, |G j x| ^ q j) = 1 :=
        integral_abs_rpow_eq_one_of_lpNorm_eq_one
          (G j : E3 → ℝ) (q j) (hq j)
          (G j).continuous.aestronglyMeasurable (hGunit j)
      have hW : W = ∑ j : Fin 4, D j := by
        dsimp only [W]
        apply Finset.sum_congr rfl
        intro j _
        rw [hpower j, mul_one]
      rw [hW] at hglobal
      change |ModelFullForm α u c G| ≤ C * sourceWeight u ^ 75
      dsimp only [C]
      calc
        |ModelFullForm α u c G| ≤
            C₀ * sourceWeight u ^ 75 * ∑ j : Fin 4, D j := hglobal
        _ = (C₀ * ∑ j : Fin 4, D j) * sourceWeight u ^ 75 := by ring
    · intro j
      exact lpNorm_pos_of_realSchwartz_ne_zero
        (F j) (q j) (hq j) (hF j)
    · intro j
      exact lpNorm_inv_smul_eq_one
        (F j : E3 → ℝ) (q j)
        (lpNorm_pos_of_realSchwartz_ne_zero
          (F j) (q j) (hq j) (hF j))

/-- The uniform real initial range at the larger translation exponent
displayed in the blueprint. -/
theorem exists_uniform_initialModelFullForm_bound_weight100
    (α : Anisotropy) (q : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (c : ℝ → ℝ)
      (F : InitialModelSchwartzInput),
      Measurable c → (∀ t : ℝ, |c t| ≤ 1) →
      |ModelFullForm α u c F| ≤ C * sourceWeight u ^ 100 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume := by
  rcases exists_uniform_initialModelFullForm_bound_weight75
    α q hq hsum hqs with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u c F hcmeas hc
  refine (hbound u c F hcmeas hc).trans ?_
  have hweight : 1 ≤ sourceWeight u := by
    unfold sourceWeight
    linarith [abs_nonneg (u 0), abs_nonneg (u 1), abs_nonneg (u 2)]
  have hpow : sourceWeight u ^ 75 ≤ sourceWeight u ^ 100 :=
    pow_le_pow_right₀ hweight (by norm_num)
  have hprod : 0 ≤ ∏ j : Fin 4,
      lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
    exact Finset.prod_nonneg fun j _ ↦ lpNorm_nonneg
  calc
    C * sourceWeight u ^ 75 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume =
        (C * ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume) * sourceWeight u ^ 75 := by ring
    _ ≤ (C * ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume) * sourceWeight u ^ 100 :=
      mul_le_mul_of_nonneg_left hpow (mul_nonneg hC hprod)
    _ = C * sourceWeight u ^ 100 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume := by
      calc
        (C * ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
            (ENNReal.ofReal (q j)) volume) * sourceWeight u ^ 100 =
            C * ((∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
              (ENNReal.ofReal (q j)) volume) * sourceWeight u ^ 100) := by
              rw [mul_assoc]
        _ = C * (sourceWeight u ^ 100 *
            ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
              (ENNReal.ofReal (q j)) volume) := by
              rw [mul_comm (∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
                (ENNReal.ofReal (q j)) volume)]
        _ = C * sourceWeight u ^ 100 *
            ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
              (ENNReal.ofReal (q j)) volume := by
              rw [mul_assoc]

/-- The literal dyadic maximal operator in an arbitrary coordinate has the
weak `(1,1)` bound obtained by transporting the proved product-fiber endpoint.
This is the maximal-function input used for the nonexceptional factors in the
one-fiber Calderón--Zygmund argument. -/
theorem coordinateDyadicBallMaximal_weak_one
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f)
    {s : ℝ} (hs : 0 < s) :
    ENNReal.ofReal s * volume {x | s < coordinateDyadicBallMaximal i f x} ≤
      ENNReal.ofReal 4 * ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
  let e := e3ToFiberDyadicCoordinates i
  let G : FiberDyadicBase × FiberDyadicLine → ℂ := f ∘ e.symm
  have he : MeasurePreserving e volume fiberDyadicMeasure := by
    simpa only [e] using e3ToFiberDyadicCoordinates_measurePreserving i
  have hG : Measurable G := hf.comp e.symm.measurable
  have hfiber := fiberDyadicBallMaximal_weak_one G hG hs
  have hA : MeasurableSet {q : FiberDyadicBase × FiberDyadicLine |
      s < fiberDyadicBallMaximal G q} :=
    measurableSet_lt measurable_const (fiberDyadicBallMaximal_measurable G hG)
  have hset : {x : E3 | s < coordinateDyadicBallMaximal i f x} =
      e ⁻¹' {q : FiberDyadicBase × FiberDyadicLine |
        s < fiberDyadicBallMaximal G q} := by
    ext x
    change s < fiberDyadicBallMaximal G (e x) ↔
      s < fiberDyadicBallMaximal G (e x)
    rfl
  have hright :
      (∫⁻ q, ENNReal.ofReal ‖G q‖ ∂fiberDyadicMeasure) =
        ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
    simpa only [G, Function.comp_apply, MeasurableEquiv.symm_apply_apply] using
      (he.lintegral_comp (hG.norm.ennreal_ofReal)).symm
  calc
    ENNReal.ofReal s * volume {x | s < coordinateDyadicBallMaximal i f x} =
        ENNReal.ofReal s * volume
          (e ⁻¹' {q : FiberDyadicBase × FiberDyadicLine |
            s < fiberDyadicBallMaximal G q}) := by rw [hset]
    _ = ENNReal.ofReal s * fiberDyadicMeasure
          {q : FiberDyadicBase × FiberDyadicLine |
            s < fiberDyadicBallMaximal G q} := by
      rw [he.measure_preimage hA.nullMeasurableSet]
    _ ≤ ENNReal.ofReal 4 * ∫⁻ q, ENNReal.ofReal ‖G q‖
          ∂fiberDyadicMeasure := hfiber
    _ = ENNReal.ofReal 4 * ∫⁻ x, ENNReal.ofReal ‖f x‖ := by rw [hright]

/-- The shell constant in the bracket-to-dyadic comparison is strictly
positive, so weak bounds may be rescaled through it. -/
theorem dyadicBracketShellConstant_pos : 0 < dyadicBracketShellConstant := by
  unfold dyadicBracketShellConstant
  apply mul_pos (by norm_num)
  exact ENNReal.toReal_pos
    (Metric.measure_ball_pos volume (0 : FiberDyadicLine) (by norm_num)).ne'
    measure_ball_lt_top.ne

/-- A positive bracket convolution in any one coordinate has the concrete
weak `(1,1)` endpoint required for the bad-fiber estimate: it is controlled
by the dyadic maximal weak endpoint with exactly one shell factor. -/
theorem coordinateBracketConvolution_weak_one
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ x, ‖f x‖ ≤ A)
    (r : ℝ) (hr : 0 < r) {s : ℝ} (hs : 0 < s) :
    ENNReal.ofReal s * volume {x | s < coordinateBracketConvolution i f r x} ≤
      ENNReal.ofReal (4 * dyadicBracketShellConstant) *
        ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
  let K : ℝ := dyadicBracketShellConstant
  have hK : 0 < K := by
    dsimp only [K]
    exact dyadicBracketShellConstant_pos
  have hsubset : {x : E3 | s < coordinateBracketConvolution i f r x} ⊆
      {x | s / K < coordinateDyadicBallMaximal i f x} := by
    intro x hx
    have hpoint := coordinateBracketConvolution_le_shell_dyadic
      i f hf A hA hbound r x hr
    have hlt : s < K * coordinateDyadicBallMaximal i f x := by
      exact lt_of_lt_of_le hx hpoint
    exact (div_lt_iff₀ hK).mpr (by simpa [mul_comm] using hlt)
  have hmeasure : volume {x | s < coordinateBracketConvolution i f r x} ≤
      volume {x | s / K < coordinateDyadicBallMaximal i f x} :=
    measure_mono hsubset
  have hbase :
      ENNReal.ofReal (s / K) *
          volume {x | s < coordinateBracketConvolution i f r x} ≤
        ENNReal.ofReal 4 * ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
    calc
      ENNReal.ofReal (s / K) *
          volume {x | s < coordinateBracketConvolution i f r x} ≤
          ENNReal.ofReal (s / K) *
            volume {x | s / K < coordinateDyadicBallMaximal i f x} :=
        mul_le_mul_of_nonneg_left hmeasure bot_le
      _ ≤ ENNReal.ofReal 4 * ∫⁻ x, ENNReal.ofReal ‖f x‖ :=
        coordinateDyadicBallMaximal_weak_one i f hf (div_pos hs hK)
  have hKs : ENNReal.ofReal K * ENNReal.ofReal (s / K) = ENNReal.ofReal s := by
    rw [← ENNReal.ofReal_mul hK.le]
    congr 1
    field_simp
  have hKfour : ENNReal.ofReal K * ENNReal.ofReal 4 =
      ENNReal.ofReal (4 * K) := by
    rw [← ENNReal.ofReal_mul hK.le]
    congr 1
    ring
  calc
    ENNReal.ofReal s * volume {x | s < coordinateBracketConvolution i f r x} =
        ENNReal.ofReal K *
          (ENNReal.ofReal (s / K) *
            volume {x | s < coordinateBracketConvolution i f r x}) := by
      rw [← mul_assoc, hKs]
    _ ≤ ENNReal.ofReal K *
          (ENNReal.ofReal 4 * ∫⁻ x, ENNReal.ofReal ‖f x‖) :=
      mul_le_mul_of_nonneg_left hbase bot_le
    _ = ENNReal.ofReal (4 * K) * ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
      rw [← mul_assoc, hKfour]
    _ = ENNReal.ofReal (4 * dyadicBracketShellConstant) *
          ∫⁻ x, ENNReal.ofReal ‖f x‖ := by rfl

local instance : Fact (0 < (8 : ℝ)) := ⟨by norm_num⟩

namespace FiberTailCutoffInternal

/-! ### A one-dimensional strong bound for bounded cutoff tests

The product-fiber maximal theorem in `Twisted` already contains the hard
Marcinkiewicz argument. For the interval-tail dual test we need its literal
one-dimensional specialization on a single fiber. Rather than appeal to the
Schwartz-only theorem upstream, the following small transport exposes that
specialization for every bounded measurable line function. -/
theorem scratchLp_line_dyadicBallMaximal_measurable
    (g : FiberDyadicLine → ℂ) (hg : Measurable g) :
    Measurable (dyadicBallMaximal 1 g) := by
  let G : FiberDyadicBase × FiberDyadicLine → ℂ := fun q => g q.2
  let z0 : FiberDyadicBase := 0
  have hG : Measurable G := hg.comp measurable_snd
  have hM := fiberDyadicBallMaximal_measurable G hG
  have hcomp : Measurable (fun x : FiberDyadicLine =>
      fiberDyadicBallMaximal G (z0, x)) :=
    hM.comp ((measurable_const : Measurable fun _ : FiberDyadicLine => z0).prodMk
      measurable_id)
  simpa [G, fiberDyadicBallMaximal] using hcomp

private theorem scratchLp_line_dyadicBallMaximal_top_bound
    (g : FiberDyadicLine → ℂ) (a : ℝ) (ha : 0 ≤ a)
    (hg : ∀ x, ‖g x‖ ≤ a) :
    ∀ x : FiberDyadicLine, dyadicBallMaximal 1 g x ≤ a := by
  let G : FiberDyadicBase × FiberDyadicLine → ℂ := fun q => g q.2
  have hG : ∀ q, ‖G q‖ ≤ a := by
    intro q
    exact hg q.2
  intro x
  have h := fiberDyadicBallMaximal_top_bound G a ha hG (0, x)
  simpa [G, fiberDyadicBallMaximal] using h

private theorem scratchLp_line_dyadicBallMaximal_subadditive
    (g h : FiberDyadicLine → ℂ) (hg : Measurable g) (hh : Measurable h)
    (hgb : ∃ a : ℝ, 0 ≤ a ∧ ∀ x, ‖g x‖ ≤ a)
    (hhb : ∃ a : ℝ, 0 ≤ a ∧ ∀ x, ‖h x‖ ≤ a) :
    ∀ x : FiberDyadicLine, dyadicBallMaximal 1 (g + h) x ≤
      dyadicBallMaximal 1 g x + dyadicBallMaximal 1 h x := by
  let G : FiberDyadicBase × FiberDyadicLine → ℂ := fun q => g q.2
  let H : FiberDyadicBase × FiberDyadicLine → ℂ := fun q => h q.2
  have hG : Measurable G := hg.comp measurable_snd
  have hH : Measurable H := hh.comp measurable_snd
  obtain ⟨a, ha, hga⟩ := hgb
  obtain ⟨b, hb, hhb⟩ := hhb
  have hGb : ∃ A : ℝ, 0 ≤ A ∧ ∀ q, ‖G q‖ ≤ A := by
    refine ⟨a, ha, ?_⟩
    intro q
    exact hga q.2
  have hHb : ∃ A : ℝ, 0 ≤ A ∧ ∀ q, ‖H q‖ ≤ A := by
    refine ⟨b, hb, ?_⟩
    intro q
    exact hhb q.2
  intro x
  have hsub := fiberDyadicBallMaximal_subadditive G H hG hH hGb hHb (0, x)
  change dyadicBallMaximal 1 (fun y => g y + h y) x ≤
    dyadicBallMaximal 1 g x + dyadicBallMaximal 1 h x
  simpa [G, H, fiberDyadicBallMaximal] using hsub

/-- The literal line dyadic maximal function has the full strong bound on
bounded measurable input. This is the exact maximal-function API needed by
the finite interval-tail dual test. -/
theorem scratchLp_line_dyadicBallMaximal_lintegral_bound
    (g : FiberDyadicLine → ℂ) (hg : Measurable g)
    (hgb : ∃ a : ℝ, 0 ≤ a ∧ ∀ x, ‖g x‖ ≤ a)
    {p : ℝ} (hp : 1 < p) :
    (∫⁻ x : FiberDyadicLine,
      ENNReal.ofReal (dyadicBallMaximal 1 g x ^ p)) ≤
      ENNReal.ofReal p *
        (2 * ENNReal.ofReal 4 * (ENNReal.ofReal (p - 1))⁻¹ *
          (ENNReal.ofReal (2 : ℝ)) ^ (p - 1) *
          ∫⁻ x : FiberDyadicLine, (ENNReal.ofReal ‖g x‖) ^ p) := by
  let D : ENNReal := ENNReal.ofReal 4
  have hnonneg : ∀ (f : FiberDyadicLine → ℂ) x,
      0 ≤ dyadicBallMaximal 1 f x := fun _ _ => ENNReal.toReal_nonneg
  have hsub : ∀ (f h : FiberDyadicLine → ℂ), Measurable f → Measurable h →
      (∃ a : ℝ, 0 ≤ a ∧ ∀ x, ‖f x‖ ≤ a) →
      (∃ a : ℝ, 0 ≤ a ∧ ∀ x, ‖h x‖ ≤ a) →
      ∀ x, dyadicBallMaximal 1 (f + h) x ≤
        dyadicBallMaximal 1 f x + dyadicBallMaximal 1 h x := by
    intro f h hf hh hfb hhb x
    exact scratchLp_line_dyadicBallMaximal_subadditive f h hf hh hfb hhb x
  have hweak : ∀ (f : FiberDyadicLine → ℂ), Measurable f →
      (∃ a : ℝ, 0 ≤ a ∧ ∀ x, ‖f x‖ ≤ a) → ∀ {s : ℝ}, 0 < s →
      ENNReal.ofReal s * volume {x | s < dyadicBallMaximal 1 f x} ≤
        D * ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
    intro f _hf _hfb s hs
    simpa [D] using
      (dyadic_ball_maximal_toReal_weak_one (d := 1) (by norm_num) f hs)
  have htop : ∀ (f : FiberDyadicLine → ℂ) (a : ℝ), 0 ≤ a →
      (∀ x, ‖f x‖ ≤ a) → ∀ x, dyadicBallMaximal 1 f x ≤ a := by
    intro f a ha hfa x
    exact scratchLp_line_dyadicBallMaximal_top_bound f a ha hfa x
  simpa [D] using
    (marcinkiewicz_weak_one_top (dyadicBallMaximal 1) hnonneg hsub D hweak htop
      hp g hg hgb (scratchLp_line_dyadicBallMaximal_measurable g hg).aemeasurable)

end FiberTailCutoffInternal

/-! ### Countable measurable dyadic fibre families -/

/-- The countable dyadic interval index from Section 8: `(scale, translation)`
in `ℤ × ℤ`. -/
abbrev FiberDyadicInterval := ℤ × ℤ

/-- The literal half-open interval `[2^k n, 2^k(n + 1))` indexed by `I`. -/
def fiberDyadicInterval (I : FiberDyadicInterval) : Set ℝ :=
  Set.Ico ((I.2 : ℝ) * (2 : ℝ) ^ I.1)
    (((I.2 + 1 : ℤ) : ℝ) * (2 : ℝ) ^ I.1)

/-- The literal input field on the active-coordinate fiber of `E3`. -/
noncomputable def coordinateFiberInput
    (i : Fin 3) (f : E3 → ℝ) : ℝ × TransverseSpace i → ℝ :=
  fun yz ↦ f (coordinateJoin i yz)

/-! ## The line maximal estimate in norm form

Source: `ext:maximal`, in the one-dimensional form the duality step of
`lem:one_fiber` consumes. The file proves the lower-integral version; this is
the same estimate stated as a norm bound.
-/

/-- **The one-dimensional dyadic maximal estimate, in norm form.** -/
theorem eLpNorm_line_dyadicBallMaximal_le
    (g : FiberDyadicLine → ℂ) (hg : Measurable g)
    (hgb : ∃ a : ℝ, 0 ≤ a ∧ ∀ x, ‖g x‖ ≤ a)
    {p : ℝ} (hp : 1 < p) :
    eLpNorm (dyadicBallMaximal 1 g) (ENNReal.ofReal p) volume ≤
      (ENNReal.ofReal p *
          (2 * ENNReal.ofReal 4 * (ENNReal.ofReal (p - 1))⁻¹ *
            (ENNReal.ofReal (2 : ℝ)) ^ (p - 1))) ^ (1 / p) *
        eLpNorm g (ENNReal.ofReal p) volume := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hpne : ENNReal.ofReal p ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp0
  have hptop : ENNReal.ofReal p ≠ ⊤ := ENNReal.ofReal_ne_top
  have hptoReal : (ENNReal.ofReal p).toReal = p := ENNReal.toReal_ofReal hp0.le
  have hMnonneg : ∀ x : FiberDyadicLine, 0 ≤ dyadicBallMaximal 1 g x :=
    fun _ ↦ ENNReal.toReal_nonneg
  set K : ℝ≥0∞ := ENNReal.ofReal p *
    (2 * ENNReal.ofReal 4 * (ENNReal.ofReal (p - 1))⁻¹ *
      (ENNReal.ofReal (2 : ℝ)) ^ (p - 1)) with hK
  have hbase := FiberTailCutoffInternal.scratchLp_line_dyadicBallMaximal_lintegral_bound
    g hg hgb hp
  have hMlint : (∫⁻ x : FiberDyadicLine, ‖dyadicBallMaximal 1 g x‖ₑ ^ p) =
      ∫⁻ x : FiberDyadicLine,
        ENNReal.ofReal (dyadicBallMaximal 1 g x ^ p) := by
    refine lintegral_congr fun x ↦ ?_
    rw [← ofReal_norm, Real.norm_of_nonneg (hMnonneg x),
      ← ENNReal.ofReal_rpow_of_nonneg (hMnonneg x) hp0.le]
  have hflint : (∫⁻ x : FiberDyadicLine, ‖g x‖ₑ ^ p) =
      ∫⁻ x : FiberDyadicLine, (ENNReal.ofReal ‖g x‖) ^ p := by
    refine lintegral_congr fun x ↦ ?_
    rw [← ofReal_norm]
  have hstep : (∫⁻ x : FiberDyadicLine, ‖dyadicBallMaximal 1 g x‖ₑ ^ p) ≤
      K * ∫⁻ x : FiberDyadicLine, ‖g x‖ₑ ^ p := by
    rw [hMlint, hflint, hK, mul_assoc]
    exact hbase
  calc eLpNorm (dyadicBallMaximal 1 g) (ENNReal.ofReal p) volume
      = (∫⁻ x : FiberDyadicLine, ‖dyadicBallMaximal 1 g x‖ₑ ^ p) ^ (1 / p) := by
        rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hpne hptop
          (FiberTailCutoffInternal.scratchLp_line_dyadicBallMaximal_measurable g
            hg).aestronglyMeasurable, hptoReal]
    _ ≤ (K * ∫⁻ x : FiberDyadicLine, ‖g x‖ₑ ^ p) ^ (1 / p) :=
        ENNReal.rpow_le_rpow hstep (by positivity)
    _ = K ^ (1 / p) * (∫⁻ x : FiberDyadicLine, ‖g x‖ₑ ^ p) ^ (1 / p) :=
        ENNReal.mul_rpow_of_nonneg _ _ (by positivity)
    _ = K ^ (1 / p) * eLpNorm g (ENNReal.ofReal p) volume := by
        rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hpne hptop hg.aestronglyMeasurable, hptoReal]

/-! ## `ext:maximal`: the centered maximal function on the line

Source: `ext:maximal`. The blueprint's maximal operator takes the supremum
over all positive radii; the development's `dyadicBallMaximal` takes it over
dyadic radii. Every radius is within a factor two of a dyadic one, so the two
differ by at most a factor two and the strong `L^q` bound transfers.
-/

/-- The blueprint's centered maximal function on the line,
`Mh(x) = sup_{r>0} (2r)^{-1} ∫_{x-r}^{x+r} |h|`, with values in `ℝ≥0∞`. -/
def lineMaximalRaw (g : FiberDyadicLine → ℂ) (x : FiberDyadicLine) : ℝ≥0∞ :=
  ⨆ r ∈ Set.Ioi (0 : ℝ), (volume (Metric.ball x r))⁻¹ *
    ∫⁻ y in Metric.ball x r, ENNReal.ofReal ‖g y‖

/-- The real-valued form of the blueprint's maximal function. -/
def lineMaximal (g : FiberDyadicLine → ℂ) (x : FiberDyadicLine) : ℝ :=
  (lineMaximalRaw g x).toReal

theorem measurable_lineMaximal (g : FiberDyadicLine → ℂ) (hg : Measurable g) :
    Measurable (lineMaximal g) := by
  have hball (r : ℝ) : LowerSemicontinuous (fun x : FiberDyadicLine =>
      (volume (Metric.ball x r))⁻¹ * ∫⁻ y in Metric.ball x r, ENNReal.ofReal ‖g y‖) := by
    let c := (volume (Metric.ball (0 : FiberDyadicLine) r))⁻¹
    have heq (x : FiberDyadicLine) :
        (volume (Metric.ball x r))⁻¹ * ∫⁻ y in Metric.ball x r, ENNReal.ofReal ‖g y‖ =
          ∫⁻ y, (Metric.ball x r).indicator (fun y => c * ENNReal.ofReal ‖g y‖) y := by
      rw [lintegral_indicator measurableSet_ball, lintegral_const_mul _ (hg.norm.ennreal_ofReal)]
      congr 1
      simp only [c, InnerProductSpace.volume_ball]
    simp_rw [heq]
    apply lowerSemicontinuous_iff_le_liminf.mpr
    intro x
    refine (lintegral_mono fun y => ?_).trans (lintegral_liminf_le fun z =>
      (measurable_const.mul hg.norm.ennreal_ofReal).indicator measurableSet_ball)
    have h : LowerSemicontinuous (fun z : FiberDyadicLine =>
        (Metric.ball y r).indicator (fun _ => c * ENNReal.ofReal ‖g y‖) z) :=
      Metric.isOpen_ball.lowerSemicontinuous_indicator zero_le
    simpa only [Set.indicator, Metric.mem_ball, dist_comm] using h.le_liminf x
  exact (lowerSemicontinuous_iSup fun r =>
    lowerSemicontinuous_iSup fun (_ : r ∈ Set.Ioi (0 : ℝ)) => hball r).measurable.ennreal_toReal


/-- **Every radius is comparable to a dyadic one.** -/
theorem lineMaximalRaw_le_two_mul_dyadicBallMaximalRaw
    (g : FiberDyadicLine → ℂ) (x : FiberDyadicLine) :
    lineMaximalRaw g x ≤ 2 * dyadicBallMaximalRaw 1 g x := by
  classical
  refine iSup₂_le fun r hr ↦ ?_
  have hr0 : (0 : ℝ) < r := hr
  set n : ℤ := Int.log 2 r + 1 with hn
  have hrn : r < (2 : ℝ) ^ n := Int.lt_zpow_succ_log_self (by norm_num) r
  have hnr : (2 : ℝ) ^ n ≤ 2 * r := by
    have hlog := Int.zpow_log_le_self (b := 2) (R := ℝ) (by norm_num) hr0
    rw [hn, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_one]
    push_cast at hlog ⊢
    linarith
  have hnpos : (0 : ℝ) < (2 : ℝ) ^ n := zpow_pos (by norm_num) n
  -- the two balls
  have hsub : Metric.ball x r ⊆ Metric.ball x ((2 : ℝ) ^ n) :=
    Metric.ball_subset_ball hrn.le
  have hvol : volume (Metric.ball x ((2 : ℝ) ^ n)) ≤ 2 * volume (Metric.ball x r) := by
    rw [Measure.addHaar_ball volume x hnpos.le,
      Measure.addHaar_ball volume x hr0.le]
    have hfr : Module.finrank ℝ FiberDyadicLine = 1 := by
      simp [FiberDyadicLine]
    rw [hfr, pow_one, pow_one, ← mul_assoc]
    refine mul_le_mul' ?_ le_rfl
    rw [show (2 : ℝ≥0∞) = ENNReal.ofReal 2 by simp,
      ← ENNReal.ofReal_mul (by norm_num : (0:ℝ) ≤ 2)]
    exact ENNReal.ofReal_le_ofReal hnr
  -- the averages
  have hinvle : (volume (Metric.ball x r))⁻¹
      ≤ 2 * (volume (Metric.ball x ((2 : ℝ) ^ n)))⁻¹ := by
    have hstep : (volume (Metric.ball x r))⁻¹
        = 2 * (2 * volume (Metric.ball x r))⁻¹ := by
      rw [ENNReal.mul_inv (by simp) (by simp), ← mul_assoc,
        ENNReal.mul_inv_cancel (by simp) (by simp), one_mul]
    rw [hstep]
    exact mul_le_mul' le_rfl (ENNReal.inv_le_inv.mpr hvol)
  calc (volume (Metric.ball x r))⁻¹ *
        ∫⁻ y in Metric.ball x r, ENNReal.ofReal ‖g y‖
      ≤ (volume (Metric.ball x r))⁻¹ *
          ∫⁻ y in Metric.ball x ((2 : ℝ) ^ n), ENNReal.ofReal ‖g y‖ :=
        mul_le_mul' le_rfl (lintegral_mono_set hsub)
    _ ≤ (2 * (volume (Metric.ball x ((2 : ℝ) ^ n)))⁻¹) *
          ∫⁻ y in Metric.ball x ((2 : ℝ) ^ n), ENNReal.ofReal ‖g y‖ :=
        mul_le_mul' hinvle le_rfl
    _ = 2 * ((volume (Metric.ball x ((2 : ℝ) ^ n)))⁻¹ *
          ∫⁻ y in Metric.ball x ((2 : ℝ) ^ n), ENNReal.ofReal ‖g y‖) := by
        rw [mul_assoc]
    _ ≤ 2 * dyadicBallMaximalRaw 1 g x := by
        refine mul_le_mul' le_rfl ?_
        exact le_iSup (fun k : ℤ ↦ (volume (Metric.ball x ((2 : ℝ) ^ k)))⁻¹ *
          ∫⁻ y in Metric.ball x ((2 : ℝ) ^ k), ENNReal.ofReal ‖g y‖) n

/-- A bounded input has a bounded dyadic maximal function.

Auxiliary. -/
theorem dyadicBallMaximalRaw_le_of_bound
    (g : FiberDyadicLine → ℂ) {a : ℝ} (_ha : 0 ≤ a) (hga : ∀ x, ‖g x‖ ≤ a)
    (x : FiberDyadicLine) :
    dyadicBallMaximalRaw 1 g x ≤ ENNReal.ofReal a := by
  refine iSup_le fun k ↦ ?_
  have hk : (0 : ℝ) < (2 : ℝ) ^ k := zpow_pos (by norm_num) k
  have hpos : volume (Metric.ball x ((2 : ℝ) ^ k)) ≠ 0 :=
    ne_of_gt (Metric.measure_ball_pos volume x hk)
  have htop : volume (Metric.ball x ((2 : ℝ) ^ k)) ≠ ⊤ :=
    ne_of_lt measure_ball_lt_top
  have hle : (∫⁻ y in Metric.ball x ((2 : ℝ) ^ k), ENNReal.ofReal ‖g y‖)
      ≤ ENNReal.ofReal a * volume (Metric.ball x ((2 : ℝ) ^ k)) := by
    calc (∫⁻ y in Metric.ball x ((2 : ℝ) ^ k), ENNReal.ofReal ‖g y‖)
        ≤ ∫⁻ _ in Metric.ball x ((2 : ℝ) ^ k), ENNReal.ofReal a :=
          lintegral_mono fun y ↦ ENNReal.ofReal_le_ofReal (hga y)
      _ = ENNReal.ofReal a * volume (Metric.ball x ((2 : ℝ) ^ k)) := by
          rw [lintegral_const, Measure.restrict_apply_univ]
  calc (volume (Metric.ball x ((2 : ℝ) ^ k)))⁻¹ *
        ∫⁻ y in Metric.ball x ((2 : ℝ) ^ k), ENNReal.ofReal ‖g y‖
      ≤ (volume (Metric.ball x ((2 : ℝ) ^ k)))⁻¹ *
          (ENNReal.ofReal a * volume (Metric.ball x ((2 : ℝ) ^ k))) :=
        mul_le_mul' le_rfl hle
    _ = ENNReal.ofReal a := by
        rw [mul_comm (ENNReal.ofReal a), ← mul_assoc,
          ENNReal.inv_mul_cancel hpos htop, one_mul]

/-- **`ext:maximal`, the strong `(q,q)` bound.**

For `1 < q < ∞` there is `C_q` with `‖Mh‖_q ≤ C_q ‖h‖_q`, where `M` is the
centered maximal operator over all positive radii. -/
theorem eLpNorm_lineMaximal_le
    (g : FiberDyadicLine → ℂ) (hg : Measurable g)
    (hgb : ∃ a : ℝ, 0 ≤ a ∧ ∀ x, ‖g x‖ ≤ a)
    {q : ℝ} (hq : 1 < q) :
    eLpNorm (lineMaximal g) (ENNReal.ofReal q) volume ≤
      2 * ((ENNReal.ofReal q *
          (2 * ENNReal.ofReal 4 * (ENNReal.ofReal (q - 1))⁻¹ *
            (ENNReal.ofReal (2 : ℝ)) ^ (q - 1))) ^ (1 / q) *
        eLpNorm g (ENNReal.ofReal q) volume) := by
  classical
  obtain ⟨a, ha, hga⟩ := hgb
  have hfin : ∀ x, dyadicBallMaximalRaw 1 g x ≠ ⊤ := fun x ↦
    ne_of_lt (lt_of_le_of_lt (dyadicBallMaximalRaw_le_of_bound g ha hga x)
      ENNReal.ofReal_lt_top)
  have hptw : ∀ x, ‖lineMaximal g x‖ ≤ ‖2 * dyadicBallMaximal 1 g x‖ := by
    intro x
    have h1 : lineMaximalRaw g x ≤ 2 * dyadicBallMaximalRaw 1 g x :=
      lineMaximalRaw_le_two_mul_dyadicBallMaximalRaw g x
    have h2 : (2 : ℝ≥0∞) * dyadicBallMaximalRaw 1 g x ≠ ⊤ :=
      ENNReal.mul_ne_top (by simp) (hfin x)
    have h3 : (lineMaximalRaw g x).toReal
        ≤ (2 * dyadicBallMaximalRaw 1 g x).toReal :=
      ENNReal.toReal_mono h2 h1
    rw [ENNReal.toReal_mul] at h3
    have hnn : (0 : ℝ) ≤ (lineMaximalRaw g x).toReal := ENNReal.toReal_nonneg
    have hnn2 : (0 : ℝ) ≤ 2 * (dyadicBallMaximalRaw 1 g x).toReal := by
      have : (0 : ℝ) ≤ (dyadicBallMaximalRaw 1 g x).toReal := ENNReal.toReal_nonneg
      linarith
    unfold lineMaximal dyadicBallMaximal
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg hnn,
      abs_of_nonneg (by simp)]
    exact h3
  have hmono : eLpNorm (lineMaximal g) (ENNReal.ofReal q) volume
      ≤ eLpNorm (fun x ↦ 2 * dyadicBallMaximal 1 g x) (ENNReal.ofReal q) volume :=
    eLpNorm_mono (measurable_lineMaximal g hg).aestronglyMeasurable hptw
  have hsmul : eLpNorm (fun x ↦ 2 * dyadicBallMaximal 1 g x)
      (ENNReal.ofReal q) volume
      = 2 * eLpNorm (dyadicBallMaximal 1 g) (ENNReal.ofReal q) volume := by
    have hfun : (fun x ↦ (2 : ℝ) * dyadicBallMaximal 1 g x)
        = (2 : ℝ) • (dyadicBallMaximal 1 g) := by
      funext x; simp [Pi.smul_apply, smul_eq_mul]
    rw [hfun, eLpNorm_const_smul]
    congr 1
    rw [← ofReal_norm, Real.norm_eq_abs]
    norm_num
  rw [hsmul] at hmono
  refine hmono.trans ?_
  exact mul_le_mul' le_rfl (eLpNorm_line_dyadicBallMaximal_le g hg ⟨a, ha, hga⟩ hq)

/-! ## `ext:maximal`: Lebesgue differentiation

Source: `ext:maximal`, "Lebesgue differentiation holds for locally integrable
functions, also along the nested standard dyadic intervals containing a point".
The ball statement is Mathlib's Besicovitch--Vitali differentiation theorem; the
dyadic statement follows because a dyadic interval containing `x` sits inside
the ball of its own length about `x`, whose measure is twice as large.
-/

/-- **Lebesgue differentiation, centred balls.** -/
theorem ae_tendsto_setAverage_norm_sub
    {X : Type*} [MetricSpace X] [MeasurableSpace X] [BorelSpace X]
    [SecondCountableTopology X] [HasBesicovitchCovering X]
    {μ : Measure X} [IsLocallyFiniteMeasure μ] [SFinite μ]
    {E : Type*} [NormedAddCommGroup E] (h : X → E) (hloc : LocallyIntegrable h μ) :
    ∀ᵐ x ∂μ, Filter.Tendsto
      (fun r : ℝ ↦ ⨍ y in Metric.closedBall x r, ‖h y - h x‖ ∂μ)
      (nhdsWithin 0 (Set.Ioi (0 : ℝ))) (𝓝 0) := by
  filter_upwards [VitaliFamily.ae_tendsto_average_norm_sub
    (Besicovitch.vitaliFamily μ) hloc] with x hx
  exact hx.comp (Besicovitch.tendsto_filterAt μ x)

/-- The standard dyadic interval of scale `k` containing `x`. -/
def dyadicIntervalAt (k : ℤ) (x : ℝ) : FiberDyadicInterval :=
  (k, ⌊x / (2 : ℝ) ^ k⌋)

theorem mem_dyadicIntervalAt (k : ℤ) (x : ℝ) :
    x ∈ fiberDyadicInterval (dyadicIntervalAt k x) := by
  have hk : (0 : ℝ) < (2 : ℝ) ^ k := zpow_pos (by norm_num) k
  constructor
  · have := Int.floor_le (x / (2 : ℝ) ^ k)
    calc ((⌊x / (2 : ℝ) ^ k⌋ : ℤ) : ℝ) * (2 : ℝ) ^ k
        ≤ (x / (2 : ℝ) ^ k) * (2 : ℝ) ^ k :=
          mul_le_mul_of_nonneg_right this hk.le
      _ = x := by field_simp
  · have := Int.lt_floor_add_one (x / (2 : ℝ) ^ k)
    calc x = (x / (2 : ℝ) ^ k) * (2 : ℝ) ^ k := by field_simp
      _ < (((⌊x / (2 : ℝ) ^ k⌋ : ℤ) : ℝ) + 1) * (2 : ℝ) ^ k :=
          mul_lt_mul_of_pos_right this hk
      _ = (((⌊x / (2 : ℝ) ^ k⌋ + 1 : ℤ) : ℝ)) * (2 : ℝ) ^ k := by push_cast; ring

/-- A dyadic interval containing `x` sits in the ball of its own length. -/
theorem dyadicIntervalAt_subset_closedBall (k : ℤ) (x : ℝ) :
    fiberDyadicInterval (dyadicIntervalAt k x) ⊆
      Metric.closedBall x ((2 : ℝ) ^ k) := by
  intro y hy
  have hx := mem_dyadicIntervalAt k x
  have h1 : ((⌊x / (2 : ℝ) ^ k⌋ : ℤ) : ℝ) * (2 : ℝ) ^ k ≤ y := hy.1
  have h2 : y < (((⌊x / (2 : ℝ) ^ k⌋ + 1 : ℤ) : ℝ)) * (2 : ℝ) ^ k := hy.2
  have h3 : ((⌊x / (2 : ℝ) ^ k⌋ : ℤ) : ℝ) * (2 : ℝ) ^ k ≤ x := hx.1
  have h4 : x < (((⌊x / (2 : ℝ) ^ k⌋ + 1 : ℤ) : ℝ)) * (2 : ℝ) ^ k := hx.2
  have hexp : (((⌊x / (2 : ℝ) ^ k⌋ + 1 : ℤ) : ℝ)) * (2 : ℝ) ^ k
      = ((⌊x / (2 : ℝ) ^ k⌋ : ℤ) : ℝ) * (2 : ℝ) ^ k + (2 : ℝ) ^ k := by
    push_cast; ring
  rw [hexp] at h2 h4
  rw [Metric.mem_closedBall, Real.dist_eq, abs_le]
  constructor <;> linarith

/-- **Lebesgue differentiation along the standard dyadic intervals.** -/
theorem ae_tendsto_dyadic_average_norm_sub
    {E : Type*} [NormedAddCommGroup E] (h : ℝ → E)
    (hloc : LocallyIntegrable h (volume : Measure ℝ)) :
    ∀ᵐ x : ℝ, Filter.Tendsto
      (fun n : ℕ ↦ ⨍ y in fiberDyadicInterval (dyadicIntervalAt (-(n : ℤ)) x),
        ‖h y - h x‖)
      Filter.atTop (𝓝 0) := by
  filter_upwards [ae_tendsto_setAverage_norm_sub (μ := (volume : Measure ℝ)) h hloc]
    with x hx
  -- the radii tend to zero from the right
  have hrad : Filter.Tendsto (fun n : ℕ ↦ (2 : ℝ) ^ (-(n : ℤ)))
      Filter.atTop (nhdsWithin 0 (Set.Ioi (0 : ℝ))) := by
    refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ ?_ ?_
    · have hfun : (fun n : ℕ ↦ (2 : ℝ) ^ (-(n : ℤ)))
          = fun n : ℕ ↦ ((2 : ℝ)⁻¹) ^ n := by
        funext n
        simp [zpow_neg, zpow_natCast, inv_pow]
      rw [hfun]
      exact tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)
    · refine Filter.Eventually.of_forall fun n ↦ ?_
      simp
  have hball := hx.comp hrad
  have hlim : Filter.Tendsto
      (fun n : ℕ ↦ 2 * ⨍ y in Metric.closedBall x ((2 : ℝ) ^ (-(n : ℤ))),
        ‖h y - h x‖) Filter.atTop (𝓝 0) := by
    have := hball.const_mul (2 : ℝ)
    simpa using this
  refine squeeze_zero (fun n ↦ ?_) (fun n ↦ ?_) hlim
  · rw [setAverage_eq, smul_eq_mul]
    exact mul_nonneg (inv_nonneg.mpr ENNReal.toReal_nonneg)
      (integral_nonneg fun y ↦ norm_nonneg _)
  · -- the dyadic average is at most twice the ball average
    set k : ℤ := -(n : ℤ) with hk
    set I : Set ℝ := fiberDyadicInterval (dyadicIntervalAt k x) with hI
    set B : Set ℝ := Metric.closedBall x ((2 : ℝ) ^ k) with hB
    have hkpos : (0 : ℝ) < (2 : ℝ) ^ k := zpow_pos (by norm_num) k
    have hsub : I ⊆ B := dyadicIntervalAt_subset_closedBall k x
    have hvolI : volume I = ENNReal.ofReal ((2 : ℝ) ^ k) := by
      rw [hI]
      unfold fiberDyadicInterval dyadicIntervalAt
      rw [Real.volume_Ico]
      congr 1
      push_cast
      ring
    have hvolB : volume B = ENNReal.ofReal (2 * (2 : ℝ) ^ k) := by
      rw [hB, Real.volume_closedBall]
    have hintB : IntegrableOn (fun y ↦ ‖h y - h x‖) B (volume : Measure ℝ) := by
      have hb : IntegrableOn h B (volume : Measure ℝ) :=
        hloc.integrableOn_isCompact (isCompact_closedBall x _)
      exact (hb.sub (integrableOn_const (by rw [hvolB]; exact ENNReal.ofReal_ne_top))).norm
    have hintI : IntegrableOn (fun y ↦ ‖h y - h x‖) I (volume : Measure ℝ) :=
      hintB.mono_set hsub
    have hle : (∫ y in I, ‖h y - h x‖) ≤ ∫ y in B, ‖h y - h x‖ :=
      setIntegral_mono_set hintB
        (Filter.Eventually.of_forall fun y ↦ norm_nonneg _)
        (LE.le.eventuallyLE hsub)
    rw [setAverage_eq, setAverage_eq, measureReal_def, measureReal_def,
      hvolI, hvolB,
      ENNReal.toReal_ofReal hkpos.le, ENNReal.toReal_ofReal (by positivity),
      smul_eq_mul, smul_eq_mul]
    have hinv : ((2 : ℝ) ^ k)⁻¹ = 2 * (2 * (2 : ℝ) ^ k)⁻¹ := by
      field_simp
    rw [hinv, mul_assoc]
    refine mul_le_mul_of_nonneg_left ?_ (by norm_num)
    refine mul_le_mul_of_nonneg_left hle ?_
    positivity

/-! ## `ext:maximal`: the fiber statements

Source: `ext:maximal`, "The corresponding fiber statements hold for functions on
`E_3` whose fibers satisfy the respective hypotheses almost everywhere. The
fiber statements follow by Fubini."  The fibers of a function on `E_3` are
functions on the line, so each one-dimensional statement applies to each fiber
that satisfies its hypothesis.
-/

/-- **Lebesgue differentiation on almost every fiber, centred balls.** -/
theorem ae_ae_tendsto_setAverage_norm_sub_fiber
    (j : Fin 3) (f : E3 → ℝ)
    (hloc : ∀ᵐ z : TransverseSpace j,
      LocallyIntegrable (fun y : ℝ ↦ coordinateFiberInput j f (y, z))
        (volume : Measure ℝ)) :
    ∀ᵐ z : TransverseSpace j, ∀ᵐ y : ℝ, Filter.Tendsto
      (fun r : ℝ ↦ ⨍ w in Metric.closedBall y r,
        ‖coordinateFiberInput j f (w, z) - coordinateFiberInput j f (y, z)‖)
      (nhdsWithin 0 (Set.Ioi (0 : ℝ))) (𝓝 0) := by
  filter_upwards [hloc] with z hz
  exact ae_tendsto_setAverage_norm_sub
    (fun y : ℝ ↦ coordinateFiberInput j f (y, z)) hz

/-- **Lebesgue differentiation on almost every fiber, standard dyadic
intervals.** -/
theorem ae_ae_tendsto_dyadic_average_norm_sub_fiber
    (j : Fin 3) (f : E3 → ℝ)
    (hloc : ∀ᵐ z : TransverseSpace j,
      LocallyIntegrable (fun y : ℝ ↦ coordinateFiberInput j f (y, z))
        (volume : Measure ℝ)) :
    ∀ᵐ z : TransverseSpace j, ∀ᵐ y : ℝ, Filter.Tendsto
      (fun n : ℕ ↦ ⨍ w in fiberDyadicInterval (dyadicIntervalAt (-(n : ℤ)) y),
        ‖coordinateFiberInput j f (w, z) - coordinateFiberInput j f (y, z)‖)
      Filter.atTop (𝓝 0) := by
  filter_upwards [hloc] with z hz
  exact ae_tendsto_dyadic_average_norm_sub
    (fun y : ℝ ↦ coordinateFiberInput j f (y, z)) hz


/-- **`ext:maximal`**, the strong `(q,q)` bound.

For `Mh(x) = sup_{r>0} (2r)^{-1} ∫_{x-r}^{x+r} |h|` and every `1 < q < ∞` there
is `C_q` with `‖Mh‖_q ≤ C_q ‖h‖_q`. -/
theorem ext_maximal_strong_type
    (g : FiberDyadicLine → ℂ) (hg : Measurable g)
    (hgb : ∃ a : ℝ, 0 ≤ a ∧ ∀ x, ‖g x‖ ≤ a)
    {q : ℝ} (hq : 1 < q) :
    eLpNorm (lineMaximal g) (ENNReal.ofReal q) volume ≤
      2 * ((ENNReal.ofReal q *
          (2 * ENNReal.ofReal 4 * (ENNReal.ofReal (q - 1))⁻¹ *
            (ENNReal.ofReal (2 : ℝ)) ^ (q - 1))) ^ (1 / q) *
        eLpNorm g (ENNReal.ofReal q) volume) :=
  eLpNorm_lineMaximal_le g hg hgb hq

/-- **`ext:maximal`**, Lebesgue differentiation.

For a locally integrable function the averages of `‖h y - h x‖` over the balls
about `x` tend to zero at almost every `x`. -/
theorem ext_maximal_lebesgue_differentiation
    {X : Type*} [MetricSpace X] [MeasurableSpace X] [BorelSpace X]
    [SecondCountableTopology X] [HasBesicovitchCovering X]
    {μ : Measure X} [IsLocallyFiniteMeasure μ] [SFinite μ]
    {E : Type*} [NormedAddCommGroup E] (h : X → E) (hloc : LocallyIntegrable h μ) :
    ∀ᵐ x ∂μ, Filter.Tendsto
      (fun r : ℝ ↦ ⨍ y in Metric.closedBall x r, ‖h y - h x‖ ∂μ)
      (nhdsWithin 0 (Set.Ioi (0 : ℝ))) (𝓝 0) :=
  ae_tendsto_setAverage_norm_sub h hloc

/-- **`ext:maximal`**, Lebesgue differentiation along the nested standard
dyadic intervals containing a point. -/
theorem ext_maximal_dyadic_differentiation
    {E : Type*} [NormedAddCommGroup E] (h : ℝ → E)
    (hloc : LocallyIntegrable h (volume : Measure ℝ)) :
    ∀ᵐ x : ℝ, Filter.Tendsto
      (fun n : ℕ ↦ ⨍ y in fiberDyadicInterval (dyadicIntervalAt (-(n : ℤ)) x),
        ‖h y - h x‖)
      Filter.atTop (𝓝 0) :=
  ae_tendsto_dyadic_average_norm_sub h hloc

/-- **`ext:maximal`**, the fiber maximal estimate on `E_3`. -/
theorem ext_maximal_fiber_strong_type
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ x, ‖f x‖ ≤ A)
    {q : ℝ} (hq : 1 < q) :
    (∫⁻ x, ENNReal.ofReal (coordinateDyadicBallMaximal i f x ^ q)) ≤
      ENNReal.ofReal q *
        (2 * ENNReal.ofReal 4 * (ENNReal.ofReal (q - 1))⁻¹ *
          (ENNReal.ofReal (2 : ℝ)) ^ (q - 1) *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ q) :=
  coordinateDyadicBallMaximal_lintegral_bound i f hf A hA hbound hq

/-- **`ext:maximal`**, the fiber differentiation statements on `E_3`. -/
theorem ext_maximal_fiber_differentiation
    (j : Fin 3) (f : E3 → ℝ)
    (hloc : ∀ᵐ z : TransverseSpace j,
      LocallyIntegrable (fun y : ℝ ↦ coordinateFiberInput j f (y, z))
        (volume : Measure ℝ)) :
    (∀ᵐ z : TransverseSpace j, ∀ᵐ y : ℝ, Filter.Tendsto
      (fun r : ℝ ↦ ⨍ w in Metric.closedBall y r,
        ‖coordinateFiberInput j f (w, z) - coordinateFiberInput j f (y, z)‖)
      (nhdsWithin 0 (Set.Ioi (0 : ℝ))) (𝓝 0)) ∧
    (∀ᵐ z : TransverseSpace j, ∀ᵐ y : ℝ, Filter.Tendsto
      (fun n : ℕ ↦ ⨍ w in fiberDyadicInterval (dyadicIntervalAt (-(n : ℤ)) y),
        ‖coordinateFiberInput j f (w, z) - coordinateFiberInput j f (y, z)‖)
      Filter.atTop (𝓝 0)) :=
  ⟨ae_ae_tendsto_setAverage_norm_sub_fiber j f hloc,
    ae_ae_tendsto_dyadic_average_norm_sub_fiber j f hloc⟩

/-- **`lem:maximal_size`** (Maximal sizes), equation `eq:ancestor_size`.

For every box `Q` and `x ∈ Q`,
`M_s g(x) ≥ (2/3)^{30/s} M_{{Q},s}(g)`. -/
theorem lem_maximal_size
    (α : Anisotropy) (q : AnisoBox α) {p : E3}
    (hp : p ∈ boxSet α q) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f y| ≤ B) :
    (2 / 3 : ℝ) ^ 15 * boxLocalSize α 2 f q ≤
      anisotropicMaximalTwo α f p :=
  boxLocalSize_two_le_anisotropicMaximalTwo α q hp f hfcont B hB hfB

/-- **`lem:stopping`** (Stopping-time sum).

The `T_Q` partition `Q_0` into convex trees, and the stopping sum
`∑_n ∑_{Q ∈ P_n^{max}} |Q| ∏_{j<d} M_{T_Q,s_j}(g_j)` is controlled by
`∏_{j<d} ‖g_j‖_{q_j}`.

This is the energy bound on a stopping tree that the sum is assembled
from. -/
theorem lem_stopping
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (f : ModelRealInput)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hint : sourceStoppingTreeEnergyIntegrability α S hS u f) :
    ∃ C₁ C₂ : ℝ, 0 ≤ C₁ ∧ 0 ≤ C₂ ∧
      sourceStoppingTreeEnergyOneBound α S hS u f C₁ ∧
      sourceStoppingTreeEnergyTwoBound α S hS u f C₂ :=
  sourceStoppingTree_energyBounds_of_boundedContinuous α S hS u f hcont hbound hint

/-- **`lem:forest_bound`**.

If `p_0,p_1,p_2 > 4`, `2 ≤ p_3 < ∞`, all exponents finite and
`∑_j p_j^{-1} = 1`, then for real Schwartz inputs
`|L_{Q_0,u,c}(f)| ≤ C_{α,p} U(u)^{100} ∏_{j=0}^3 ‖f_j‖_{p_j}`,
uniformly over finite convex collections.

This is the forest sum's reduction to the maximal-level sum. -/
theorem lem_forest_bound
    (α : Anisotropy) (S : BoxCollection α)
    (hS : IsConvexCollection α S) (f : ModelRealInput)
    (hpos : ∀ q ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) q)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hfinite : ∀ n, volume (sourceStoppingMaximalLevelSet α f n) ≠ ∞) :
    (∑ n ∈ activeStoppingLevels α S sourceStoppingExponent f hpos,
      ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
        boxMass α Q.1 *
          (∏ j : Fin 4,
            treeLocalSize
              (stoppingTree α S sourceStoppingExponent f n
                (isConvexCollection_stoppingLevel α S hS
                  sourceStoppingExponent f n) Q.1 Q.2)
              (sourceStoppingExponent j) (f j))) ≤
      ∑ n ∈ activeStoppingLevels α S sourceStoppingExponent f hpos,
        (∏ j : Fin 4, (2 : ℝ) ^ n j) *
          (volume (sourceStoppingMaximalLevelSet α f n)).toReal :=
  sourceStoppingForestWeightedSum_le_maximalLevelSum α S hS f hpos hcont hbound hfinite

/-- **`lem:model_convergence`** (Truncation, exhaustion, and convergence).

For Schwartz tuples, the spatially integrated model integrand is absolutely
integrable in `t` on `(0,∞)`; exhausting the centre variable converges to the
scale-restricted form. -/
theorem lem_model_convergence
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (A : Set ℝ) (hA : MeasurableSet A) (hApos : A ⊆ Set.Ioi (0 : ℝ))
    (hglobal : IntegrableOn
      (truncationFiberIntegrand α u (RestrictScaleCoefficient c A) f)
      (Set.univ ×ˢ Set.Ioi (0 : ℝ)) cubeScaleMeasure) :
    Tendsto (fun M ↦ expandedModelLocalForm α (truncationCollection α M) u
      (RestrictScaleCoefficient c A) f) atTop
      (𝓝 (-(∫ pt in Set.univ ×ˢ A,
        truncationFiberIntegrand α u c f pt ∂cubeScaleMeasure))) :=
  tendsto_expandedModelLocalForm_centerExhaustion_restrictScale α u c f A hA hApos hglobal

/-- **`thm:initial_model`** (Initial model range).

For finite exponents `p_0,p_1,p_2 > 4`, `p_3 ≥ 2` with `∑_j p_j^{-1} = 1`, all
complex Schwartz tuples satisfy
`|Λ^{a,b}_{u,c}(f)| + |Λ_{u,c}(f)| ≤ C_{α,p} U(u)^{100} ∏_{j=0}^3 ‖f_j‖_{p_j}`,
uniformly in `0 < a < b`. -/
theorem thm_initial_model
    (α : Anisotropy) (q : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (c : ℝ → ℝ)
      (F : InitialModelSchwartzInput),
      Measurable c → (∀ t : ℝ, |c t| ≤ 1) →
      |ModelFullForm α u c F| ≤ C * sourceWeight u ^ 100 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume :=
  exists_uniform_initialModelFullForm_bound_weight100 α q hq hsum hqs

