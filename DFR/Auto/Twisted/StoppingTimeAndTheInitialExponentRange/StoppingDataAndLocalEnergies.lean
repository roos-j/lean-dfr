/-- Every positive real number lies in exactly one dyadic half-open level
interval in the convention of the stopping data. -/
theorem exists_dyadicLevel_of_pos {a : ℝ} (ha : 0 < a) :
    ∃ n : ℤ, (2 : ℝ) ^ (n - 1) < a ∧ a ≤ (2 : ℝ) ^ n := by
  rcases exists_mem_Ioc_zpow ha (by norm_num : (1 : ℝ) < 2) with ⟨m, hm⟩
  refine ⟨m + 1, ?_⟩
  simpa using hm

/-- The dyadic stopping index of a positive real number is unique. -/
theorem dyadicLevel_unique {a : ℝ} {n m : ℤ}
    (hn : (2 : ℝ) ^ (n - 1) < a ∧ a ≤ (2 : ℝ) ^ n)
    (hm : (2 : ℝ) ^ (m - 1) < a ∧ a ≤ (2 : ℝ) ^ m) : n = m := by
  apply le_antisymm
  · by_contra hnm
    have hlt : m < n := lt_of_not_ge hnm
    have hmlt : m ≤ n - 1 := by omega
    have hpow : (2 : ℝ) ^ m ≤ (2 : ℝ) ^ (n - 1) :=
      zpow_le_zpow_right₀ (by norm_num) hmlt
    exact (not_lt_of_ge (hm.2.trans hpow)) hn.1
  · by_contra hmn
    have hlt : n < m := lt_of_not_ge hmn
    have hnlt : n ≤ m - 1 := by omega
    have hpow : (2 : ℝ) ^ n ≤ (2 : ℝ) ^ (m - 1) :=
      zpow_le_zpow_right₀ (by norm_num) hnlt
    exact (not_lt_of_ge (hn.2.trans hpow)) hm.1

/-- Positive stopping data place a box in some vector-valued stopping
level, exactly as in the source finite forest construction. -/
theorem exists_stoppingLevel_of_positiveData {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) {q : AnisoBox α} (hq : q ∈ S)
    (hpos : ∀ j, 0 < stoppingData α S (s j) (f j) q) :
    ∃ n : Fin d → ℤ, q ∈ stoppingLevel α S s f n := by
  choose n hn using fun j ↦
    exists_dyadicLevel_of_pos (hpos j)
  refine ⟨n, ?_⟩
  rw [mem_stoppingLevel_iff]
  exact ⟨hq, hn⟩

/-- A box belongs to at most one vector-valued stopping level. -/
theorem stoppingLevel_unique_of_mem {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) {q : AnisoBox α} {n m : Fin d → ℤ}
    (hn : q ∈ stoppingLevel α S s f n)
    (hm : q ∈ stoppingLevel α S s f m) : n = m := by
  ext j
  exact dyadicLevel_unique
    ((mem_stoppingLevel_iff α S s f n q).mp hn |>.2 j)
    ((mem_stoppingLevel_iff α S s f m q).mp hm |>.2 j)

/-- Choose the unique stopping-level vector for each box under the source
positivity hypothesis on all stopping data. -/
noncomputable def stoppingLevelIndex {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ)
    (hpos : ∀ q ∈ S, ∀ j, 0 < stoppingData α S (s j) (f j) q)
    (q : {q : AnisoBox α // q ∈ S}) : Fin d → ℤ :=
  Classical.choose (exists_stoppingLevel_of_positiveData α S s f q.2
    (hpos q.1 q.2))

/-- The chosen index really places its box in the indicated stopping level. -/
theorem mem_stoppingLevelIndex {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ)
    (hpos : ∀ q ∈ S, ∀ j, 0 < stoppingData α S (s j) (f j) q)
    (q : {q : AnisoBox α // q ∈ S}) :
    q.1 ∈ stoppingLevel α S s f
      (stoppingLevelIndex α S s f hpos q) :=
  Classical.choose_spec (exists_stoppingLevel_of_positiveData α S s f q.2
    (hpos q.1 q.2))

/-- The finite set of all stopping level vectors which actually occur in the
ambient finite collection. -/
noncomputable def activeStoppingLevels {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ)
    (hpos : ∀ q ∈ S, ∀ j, 0 < stoppingData α S (s j) (f j) q) :
    Finset (Fin d → ℤ) :=
  S.attach.image (stoppingLevelIndex α S s f hpos)

/-- Distinct stopping-level vectors give disjoint finite collections. -/
theorem pairwiseDisjoint_stoppingLevels {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (N : Finset (Fin d → ℤ)) :
    (↑N : Set (Fin d → ℤ)).PairwiseDisjoint (stoppingLevel α S s f) := by
  intro n hn m hm hne
  change Disjoint (stoppingLevel α S s f n) (stoppingLevel α S s f m)
  rw [Finset.disjoint_left]
  intro q hqn hqm
  exact hne (stoppingLevel_unique_of_mem α S s f hqn hqm)

/-- The active finite stopping levels partition the ambient collection. -/
theorem boxCollection_eq_biUnion_activeStoppingLevels {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ)
    (hpos : ∀ q ∈ S, ∀ j, 0 < stoppingData α S (s j) (f j) q) :
    S = (activeStoppingLevels α S s f hpos).biUnion
      (stoppingLevel α S s f) := by
  classical
  ext q
  constructor
  · intro hq
    let qS : {q : AnisoBox α // q ∈ S} := ⟨q, hq⟩
    refine Finset.mem_biUnion.mpr ⟨
      stoppingLevelIndex α S s f hpos qS, ?_, ?_⟩
    · exact Finset.mem_image.mpr ⟨qS, by simp, rfl⟩
    · exact mem_stoppingLevelIndex α S s f hpos qS
  · intro hq
    rcases Finset.mem_biUnion.mp hq with ⟨n, hn, hqlevel⟩
    exact (mem_stoppingLevel_iff α S s f n q).mp hqlevel |>.1

/-- Every finite sum over the ambient collection splits exactly over the
active stopping levels. -/
theorem sum_boxCollection_eq_sum_activeStoppingLevels {d : ℕ}
    {M : Type*} [AddCommMonoid M]
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ)
    (hpos : ∀ q ∈ S, ∀ j, 0 < stoppingData α S (s j) (f j) q)
    (w : AnisoBox α → M) :
    (∑ q ∈ S, w q) =
      ∑ n ∈ activeStoppingLevels α S s f hpos,
        ∑ q ∈ stoppingLevel α S s f n, w q := by
  calc
    (∑ q ∈ S, w q) =
        ∑ q ∈ (activeStoppingLevels α S s f hpos).biUnion
          (stoppingLevel α S s f), w q :=
      congrArg (fun U : BoxCollection α ↦ ∑ q ∈ U, w q)
        (boxCollection_eq_biUnion_activeStoppingLevels α S s f hpos)
    _ = ∑ n ∈ activeStoppingLevels α S s f hpos,
        ∑ q ∈ stoppingLevel α S s f n, w q :=
      Finset.sum_biUnion
        (pairwiseDisjoint_stoppingLevels α S s f
          (activeStoppingLevels α S s f hpos))

/-- Combining the two finite partitions gives the literal forest sum over
all active level vectors and their maximal roots. -/
theorem sum_boxCollection_eq_sum_activeStoppingTrees {d : ℕ}
    {M : Type*} [AddCommMonoid M]
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ)
    (hpos : ∀ q ∈ S, ∀ j, 0 < stoppingData α S (s j) (f j) q)
    (w : AnisoBox α → M) :
    (∑ q ∈ S, w q) =
      ∑ n ∈ activeStoppingLevels α S s f hpos,
        ∑ Q ∈ stoppingRoots α S s f n,
          ∑ q ∈ stoppingTreeBoxes α S s f n Q, w q := by
  calc
    (∑ q ∈ S, w q) =
        ∑ n ∈ activeStoppingLevels α S s f hpos,
          ∑ q ∈ stoppingLevel α S s f n, w q :=
      sum_boxCollection_eq_sum_activeStoppingLevels α S s f hpos w
    _ = ∑ n ∈ activeStoppingLevels α S s f hpos,
        ∑ Q ∈ stoppingRoots α S s f n,
          ∑ q ∈ stoppingTreeBoxes α S s f n Q, w q := by
      apply Finset.sum_congr rfl
      intro n hn
      exact sum_stoppingLevel_eq_sum_stoppingTrees α S s f n w

/-- The finite weighted stopping-forest sum over all levels actually
occupied by the ambient collection is bounded by the corresponding finite
sum of covering-region measures. -/
theorem sum_activeStoppingRoot_weights_le {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α)
    (hS : IsConvexCollection α S) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ)
    (hpos : ∀ q ∈ S, ∀ j, 0 < stoppingData α S (s j) (f j) q)
    (E : (Fin d → ℤ) → Set E3) (hEtop : ∀ n, volume (E n) ≠ ∞)
    (hcover : ∀ n Q, Q ∈ stoppingRoots α S s f n → boxSet α Q ⊆ E n) :
    (∑ n ∈ activeStoppingLevels α S s f hpos,
      ∑ Q ∈ (stoppingRoots α S s f n).attach,
        boxMass α Q.1 *
          (∏ j : Fin d,
            treeLocalSize
              (stoppingTree α S s f n
                (isConvexCollection_stoppingLevel α S hS s f n) Q.1 Q.2)
              (s j) (f j))) ≤
      ∑ n ∈ activeStoppingLevels α S s f hpos,
        (∏ j : Fin d, (2 : ℝ) ^ n j) * (volume (E n)).toReal := by
  apply sum_stoppingRoot_weights_over_levels_le α S s f
    (activeStoppingLevels α S s f hpos)
    (fun n ↦ isConvexCollection_stoppingLevel α S hS s f n)
    E hEtop hcover

/-- The finite index set of all maximal stopping roots in all active levels. -/
noncomputable def activeStoppingForestRoots {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ)
    (hpos : ∀ q ∈ S, ∀ j, 0 < stoppingData α S (s j) (f j) q) :
    Finset (Sigma fun _ : Fin d → ℤ ↦ AnisoBox α) :=
  (activeStoppingLevels α S s f hpos).sigma
    (stoppingRoots α S s f)

/-- Membership in the finite stopping forest is precisely active-level
membership together with maximal-root membership at that level. -/
theorem mem_activeStoppingForestRoots_iff {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ)
    (hpos : ∀ q ∈ S, ∀ j, 0 < stoppingData α S (s j) (f j) q)
    (n : Fin d → ℤ) (Q : AnisoBox α) :
    ⟨n, Q⟩ ∈ activeStoppingForestRoots α S s f hpos ↔
      n ∈ activeStoppingLevels α S s f hpos ∧
        Q ∈ stoppingRoots α S s f n :=
  Finset.mem_sigma

/-- The box collections carried by distinct active forest roots are pairwise
disjoint, including roots from different stopping levels. -/
theorem pairwiseDisjoint_activeStoppingForestTreeBoxes {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ)
    (hpos : ∀ q ∈ S, ∀ j, 0 < stoppingData α S (s j) (f j) q) :
    (↑(activeStoppingForestRoots α S s f hpos) :
      Set (Sigma fun _ : Fin d → ℤ ↦ AnisoBox α)).PairwiseDisjoint
      (fun z ↦ stoppingTreeBoxes α S s f z.1 z.2) := by
  rintro ⟨n, Q⟩ hQ ⟨m, R⟩ hR hne
  change ⟨n, Q⟩ ∈ activeStoppingForestRoots α S s f hpos at hQ
  change ⟨m, R⟩ ∈ activeStoppingForestRoots α S s f hpos at hR
  change Disjoint (stoppingTreeBoxes α S s f n Q)
    (stoppingTreeBoxes α S s f m R)
  rw [mem_activeStoppingForestRoots_iff] at hQ hR
  by_cases hnm : n = m
  · subst m
    have hQR : Q ≠ R := by
      intro hQR
      apply hne
      simp [hQR]
    exact stoppingTreeBoxes_disjoint_of_ne α S s f n Q R hQ.2 hR.2 hQR
  · rw [Finset.disjoint_left]
    intro q hqQ hqR
    have hqlevelQ : q ∈ stoppingLevel α S s f n :=
      (mem_stoppingTreeBoxes_iff α S s f n Q q).mp hqQ |>.1
    have hqlevelR : q ∈ stoppingLevel α S s f m :=
      (mem_stoppingTreeBoxes_iff α S s f m R q).mp hqR |>.1
    exact hnm (stoppingLevel_unique_of_mem α S s f hqlevelQ hqlevelR)

/-- The active stopping forest trees form an exact finite partition of the
ambient collection. -/
theorem boxCollection_eq_biUnion_activeStoppingForestTreeBoxes {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ)
    (hpos : ∀ q ∈ S, ∀ j, 0 < stoppingData α S (s j) (f j) q) :
    S = (activeStoppingForestRoots α S s f hpos).biUnion
      (fun z ↦ stoppingTreeBoxes α S s f z.1 z.2) := by
  classical
  ext q
  constructor
  · intro hq
    have hqlevelUnion : q ∈
        (activeStoppingLevels α S s f hpos).biUnion
          (stoppingLevel α S s f) := by
      rw [← boxCollection_eq_biUnion_activeStoppingLevels α S s f hpos]
      exact hq
    rcases Finset.mem_biUnion.mp hqlevelUnion with ⟨n, hn, hqlevel⟩
    rcases exists_stoppingRoot_above α S s f n hqlevel with ⟨Q, hQ, hqQ⟩
    refine Finset.mem_biUnion.mpr ⟨⟨n, Q⟩, ?_, ?_⟩
    · exact Finset.mem_sigma.mpr ⟨hn, hQ⟩
    · exact (mem_stoppingTreeBoxes_iff α S s f n Q q).mpr ⟨hqlevel, hqQ⟩
  · intro hq
    rcases Finset.mem_biUnion.mp hq with ⟨z, hz, hqz⟩
    exact (mem_stoppingLevel_iff α S s f z.1 q).mp
      ((mem_stoppingTreeBoxes_iff α S s f z.1 z.2 q).mp hqz |>.1) |>.1

/-- Every finite box sum splits over the pairwise-disjoint active stopping
forest trees. -/
theorem sum_boxCollection_eq_sum_activeStoppingForestTreeBoxes {d : ℕ}
    {M : Type*} [AddCommMonoid M]
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ)
    (hpos : ∀ q ∈ S, ∀ j, 0 < stoppingData α S (s j) (f j) q)
    (w : AnisoBox α → M) :
    (∑ q ∈ S, w q) =
      ∑ z ∈ activeStoppingForestRoots α S s f hpos,
        ∑ q ∈ stoppingTreeBoxes α S s f z.1 z.2, w q := by
  calc
    (∑ q ∈ S, w q) =
        ∑ q ∈ (activeStoppingForestRoots α S s f hpos).biUnion
          (fun z ↦ stoppingTreeBoxes α S s f z.1 z.2), w q :=
      congrArg (fun U : BoxCollection α ↦ ∑ q ∈ U, w q)
        (boxCollection_eq_biUnion_activeStoppingForestTreeBoxes
          α S s f hpos)
    _ = ∑ z ∈ activeStoppingForestRoots α S s f hpos,
        ∑ q ∈ stoppingTreeBoxes α S s f z.1 z.2, w q :=
      Finset.sum_biUnion
        (pairwiseDisjoint_activeStoppingForestTreeBoxes α S s f hpos)


/-- The scale weight left after the full-cube estimate is integrable. -/
theorem integrableOn_scaleWeight_negTen :
    IntegrableOn (fun lam : ℝ ↦ lam ^ (-10 : ℝ)) (Set.Ici (1 : ℝ)) := by
  apply (integrableOn_Ici_iff_integrableOn_Ioi).mpr
  exact integrableOn_Ioi_rpow_of_lt (by norm_num) zero_lt_one

/-- Its exact mass is the source value `1 / 9`. -/
theorem integralOn_scaleWeight_negTen :
    ∫ lam : ℝ in Set.Ici (1 : ℝ), lam ^ (-10 : ℝ) = 1 / 9 := by
  rw [integral_Ici_eq_integral_Ioi]
  rw [integral_Ioi_rpow_of_lt (by norm_num) zero_lt_one]
  norm_num

/-- The edge-tree translation weight remaining after the estimate is
integrable on the line. -/
theorem integrable_translationWeight_negTwentyNine :
    Integrable (fun r : ℝ ↦ translationWeight r ^ (-29 : ℝ)) := by
  change Integrable (fun r : ℝ ↦ (1 + |r|) ^ (-29 : ℝ))
  simpa [Real.norm_eq_abs] using
    (integrable_one_add_norm (E := ℝ) (μ := volume) (r := (29 : ℝ))
      (by norm_num))

/-- Its exact line integral is the source value `1 / 14`. -/
theorem integral_translationWeight_negTwentyNine :
    ∫ r : ℝ, translationWeight r ^ (-29 : ℝ) = 1 / 14 := by
  unfold translationWeight
  change (∫ r : ℝ, (fun y : ℝ ↦ (1 + y) ^ (-29 : ℝ)) |r|) = 1 / 14
  rw [integral_comp_abs (f := fun y : ℝ ↦ (1 + y) ^ (-29 : ℝ))]
  simp_rw [add_comm (1 : ℝ)]
  have hhalf : ∫ x : ℝ in Set.Ioi (0 : ℝ), (x + 1) ^ (-29 : ℝ) = 1 / 28 := by
    have hd : ∀ x ∈ Set.Ici (0 : ℝ),
        HasDerivAt (fun t : ℝ ↦ (t + 1) ^ (-29 + 1 : ℝ) / (-29 + 1))
          ((x + 1) ^ (-29 : ℝ)) x := by
      intro x hx
      convert! (((hasDerivAt_id x).add_const 1).rpow_const _).div_const _ using 1
      · norm_num [id_eq]
      · left
        intro h
        have hx0 : 0 ≤ x := Set.mem_Ici.mp hx
        have hx1 : 0 < id x + 1 := by
          simpa only [id_eq] using add_pos_of_nonneg_of_pos hx0 zero_lt_one
        exact hx1.ne' h
    have ht : Tendsto (fun t : ℝ ↦ (t + 1) ^ (-29 + 1 : ℝ) / (-29 + 1)) atTop
        (𝓝 (0 / (-29 + 1))) := by
      rw [← neg_neg (-29 + 1 : ℝ)]
      exact (tendsto_rpow_neg_atTop (by norm_num : 0 < -(-29 + 1 : ℝ))).comp
        (tendsto_atTop_add_const_right _ 1 tendsto_id) |>.div_const _
    convert integral_Ioi_of_hasDerivAt_of_tendsto' hd
      (integrableOn_add_rpow_Ioi_of_lt (by norm_num : (-29 : ℝ) < -1)
        (by norm_num : -(1 : ℝ) < 0)) ht using 1 ; norm_num
  rw [hhalf]
  norm_num

/-- Reflection turns the source's centered odd derivative kernel into the
standard convolution kernel. -/
theorem gaussianDerivAt_reflect
    (s q v : ℝ) :
    gaussianDerivAt s q v = -gaussianDerivAt s 0 (q - v) := by
  unfold gaussianDerivAt kernelAt kernelDilate
  rw [show (v - q) / s = -((q - v) / s) by ring, gaussianDeriv_neg]
  ring_nf

/-- The one-dimensional source fiber is the negative of convolution with the
centered derivative kernel. No convergence hypothesis is needed for this
algebraic integral identity. -/
theorem gaussianDerivAt_fiber_eq_neg_convolution
    (F : ℝ → ℂ) (s q : ℝ) :
    (∫ v : ℝ, F v * (gaussianDerivAt s q v : ℂ)) =
      -((F ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
        fun v : ℝ ↦ (gaussianDerivAt s 0 v : ℂ)) q) := by
  rw [convolution_mul]
  calc
    (∫ v : ℝ, F v * (gaussianDerivAt s q v : ℂ)) =
        ∫ v : ℝ, -(F v * (gaussianDerivAt s 0 (q - v) : ℂ)) := by
          apply integral_congr_ae
          filter_upwards [] with v
          rw [gaussianDerivAt_reflect]
          push_cast
          ring
    _ = -∫ v : ℝ, F v * (gaussianDerivAt s 0 (q - v) : ℂ) := by
      rw [integral_neg]

/-- The Gaussian-derivative Fourier multiplier is bounded, hence multiplying
the Fourier transform of a Schwartz fiber preserves integrability. -/
theorem integrable_fourier_schwartz_mul_gaussianDeriv
    (F : SchwartzMap ℝ ℂ) (s : ℝ) :
    Integrable (fun ξ : ℝ ↦ 𝓕 (F : ℝ → ℂ) ξ *
      (gaussianDeriv (s * ξ) : ℂ)) := by
  rcases gaussianDeriv_polynomial_decay 0 with ⟨C, hC, hCbound⟩
  have hbound (x : ℝ) : ‖(gaussianDeriv x : ℂ)‖ ≤ C := by
    rw [Complex.norm_real, Real.norm_eq_abs]
    simpa using hCbound x
  have hmult_cont : Continuous (fun ξ : ℝ ↦ (gaussianDeriv (s * ξ) : ℂ)) := by
    apply Complex.continuous_ofReal.comp
    simp only [gaussianDeriv]
    exact ((continuous_const.mul (continuous_const.mul continuous_id)).mul
      (gaussian_contDiff.continuous.comp (continuous_const.mul continuous_id)))
  have hFfourier : Integrable (𝓕 (F : ℝ → ℂ)) := by
    simpa only [SchwartzMap.fourier_coe] using (𝓕 F).integrable
  exact hFfourier.mul_bdd hmult_cont.aestronglyMeasurable
    (Filter.Eventually.of_forall fun ξ ↦ hbound (s * ξ))

/-- Complexification of every translated Gaussian derivative is continuous. -/
theorem continuous_complex_gaussianDerivAt (s a : ℝ) :
    Continuous (fun x : ℝ ↦ (gaussianDerivAt s a x : ℂ)) := by
  apply Complex.continuous_ofReal.comp
  unfold gaussianDerivAt kernelAt kernelDilate gaussianDeriv
  simp only [smul_eq_mul]
  by_cases hs : s = 0
  · simp only [hs, inv_zero, neg_mul, div_zero, mul_zero, zero_mul]
    exact continuous_const
  · have harg : Continuous (fun x : ℝ ↦ (x - a) / s) :=
      (continuous_id.sub continuous_const).div continuous_const (fun _ ↦ hs)
    have hcoeff : Continuous (fun x : ℝ ↦ -2 * Real.pi * ((x - a) / s)) := by
      exact (continuous_const.mul continuous_const).mul harg
    have hprod : Continuous (fun x : ℝ ↦
        (-2 * Real.pi * ((x - a) / s)) * gaussian ((x - a) / s)) :=
      hcoeff.mul (gaussian_contDiff.continuous.comp harg)
    exact continuous_const.mul hprod

/-- A finite subseries of a positive geometric series is bounded by its full
sum. This is the scalar summation input for the finite stopping forest. -/
theorem sum_geometric_nat_finset_le
    (r : ℝ) (hr0 : 0 ≤ r) (hr1 : r < 1) (s : Finset ℕ) :
    (∑ n ∈ s, r ^ n) ≤ (1 - r)⁻¹ := by
  calc
    (∑ n ∈ s, r ^ n) ≤ ∑' n : ℕ, r ^ n :=
      (summable_geometric_of_lt_one hr0 hr1).sum_le_tsum s
        (fun n _ ↦ pow_nonneg hr0 n)
    _ = (1 - r)⁻¹ := tsum_geometric_of_lt_one hr0 hr1

/-- Reindex a finite set of integer levels by its distance below an upper
level. The map is injective because all selected levels lie below that
upper level. -/
theorem int_distanceToNat_injOn
    (N : Finset ℤ) (K : ℤ) (hN : ∀ n ∈ N, n ≤ K) :
    Set.InjOn (fun n : ℤ ↦ (K - n).toNat) (↑N : Set ℤ) := by
  intro m hm n hn hmn
  have hm0 : 0 ≤ K - m := sub_nonneg.mpr (hN m hm)
  have hn0 : 0 ≤ K - n := sub_nonneg.mpr (hN n hn)
  have hcast : (K - m).toNat = (K - n).toNat := hmn
  have hsub : K - m = K - n := by
    rw [← Int.toNat_of_nonneg hm0, ← Int.toNat_of_nonneg hn0, hcast]
  omega

/-- A finite family of integer geometric levels below `K` is dominated by
the full backwards geometric series from `K`. -/
theorem sum_zpow_le_geometric_upper
    (a : ℝ) (ha : 1 < a) (N : Finset ℤ) (K : ℤ)
    (hN : ∀ n ∈ N, n ≤ K) :
    (∑ n ∈ N, a ^ n) ≤ a ^ K * (1 - a⁻¹)⁻¹ := by
  let r : ℝ := a⁻¹
  have ha0 : 0 < a := lt_trans zero_lt_one ha
  have hr0 : 0 ≤ r := inv_nonneg.mpr ha0.le
  have hr1 : r < 1 := (inv_lt_one₀ ha0).mpr ha
  have hmapInj : Set.InjOn (fun n : ℤ ↦ (K - n).toNat) (↑N : Set ℤ) :=
    int_distanceToNat_injOn N K hN
  have hterm (n : ℤ) (hn : n ∈ N) :
      a ^ n = a ^ K * r ^ (K - n).toNat := by
    have hd0 : 0 ≤ K - n := sub_nonneg.mpr (hN n hn)
    have hdeq : ((K - n).toNat : ℤ) = K - n := Int.toNat_of_nonneg hd0
    dsimp [r]
    rw [← zpow_natCast]
    rw [hdeq]
    rw [inv_zpow]
    rw [← zpow_neg]
    rw [← zpow_add₀ ha0.ne']
    congr 1
    omega
  calc
    (∑ n ∈ N, a ^ n) =
        a ^ K * ∑ n ∈ N, r ^ (K - n).toNat := by
          rw [Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro n hn
          exact hterm n hn
    _ = a ^ K * ∑ m ∈ N.image (fun n : ℤ ↦ (K - n).toNat), r ^ m := by
          congr 1
          symm
          rw [Finset.sum_image]
          intro m hm n hn hmn
          exact hmapInj hm hn hmn
    _ ≤ a ^ K * (1 - r)⁻¹ := by
          apply mul_le_mul_of_nonneg_left
            (sum_geometric_nat_finset_le r hr0 hr1
              (N.image (fun n : ℤ ↦ (K - n).toNat)))
          exact zpow_nonneg ha0.le _
    _ = a ^ K * (1 - a⁻¹)⁻¹ := by rfl

/-- Finite dyadic layer-cake estimate. Any finite selection of levels whose
weighted geometric size is below `h` has total geometric mass controlled by
`h / c`; this is the pointwise core of the stopping-time distribution sum. -/
theorem sum_zpow_filter_le_layerCake
    (a c h : ℝ) (ha : 1 < a) (hc : 0 < c) (hh : 0 ≤ h)
    (N : Finset ℤ) :
    (∑ n ∈ N.filter (fun n ↦ c * a ^ n ≤ h), a ^ n) ≤
      (1 - a⁻¹)⁻¹ * (h / c) := by
  let S : Finset ℤ := N.filter (fun n ↦ c * a ^ n ≤ h)
  by_cases hS : S.Nonempty
  · let K : ℤ := S.max' hS
    have hupper : ∀ n ∈ S, n ≤ K := by
      intro n hn
      exact Finset.le_max' S n hn
    have hgeom := sum_zpow_le_geometric_upper a ha S K hupper
    have hK : K ∈ S := Finset.max'_mem S hS
    have hKthreshold : c * a ^ K ≤ h := by
      exact (Finset.mem_filter.mp hK).2
    have ha0 : 0 < a := lt_trans zero_lt_one ha
    have hpow : 0 ≤ a ^ K := zpow_nonneg ha0.le _
    have hfac : 0 ≤ (1 - a⁻¹)⁻¹ := by
      apply inv_nonneg.mpr
      exact sub_nonneg.mpr ((inv_lt_one₀ ha0).mpr ha).le
    have hpow_le : a ^ K ≤ h / c := by
      apply (le_div_iff₀ hc).mpr
      simpa [mul_comm] using hKthreshold
    change (∑ n ∈ S, a ^ n) ≤ _
    calc
      (∑ n ∈ S, a ^ n) ≤ a ^ K * (1 - a⁻¹)⁻¹ := hgeom
      _ ≤ (h / c) * (1 - a⁻¹)⁻¹ :=
        mul_le_mul_of_nonneg_right hpow_le hfac
      _ = (1 - a⁻¹)⁻¹ * (h / c) := by ring
  · have hSempt : S = ∅ := Finset.not_nonempty_iff_eq_empty.mp hS
    have hdiv : 0 ≤ h / c := div_nonneg hh hc.le
    have hfac : 0 ≤ (1 - a⁻¹)⁻¹ := by
      have ha0 : 0 < a := lt_trans zero_lt_one ha
      apply inv_nonneg.mpr
      exact sub_nonneg.mpr ((inv_lt_one₀ ha0).mpr ha).le
    change (∑ n ∈ S, a ^ n) ≤ _
    rw [hSempt]
    simp [mul_nonneg hfac hdiv]

/-- Finite real-valued distribution estimate for geometric level sets. It
is the Tonelli-free finite version of the scalar layer-cake bound used in
the stopping forest: all finite rearrangements are explicitly justified by
the supplied finite-measure hypotheses. -/
theorem sum_zpow_levelSet_toReal_le_integral
    (a c : ℝ) (ha : 1 < a) (hc : 0 < c)
    (f : E3 → ℝ) (hfmeas : Measurable f) (hfint : Integrable f)
    (hfnonneg : ∀ x, 0 ≤ f x) (N : Finset ℤ)
    (hfinite : ∀ n ∈ N,
      volume {x : E3 | c * a ^ n ≤ f x} ≠ ∞) :
    (∑ n ∈ N, a ^ n *
      (volume {x : E3 | c * a ^ n ≤ f x}).toReal) ≤
      ((1 - a⁻¹)⁻¹ * c⁻¹) * ∫ x : E3, f x := by
  classical
  let A : ℤ → Set E3 := fun n ↦ {x : E3 | c * a ^ n ≤ f x}
  let g : ℤ → E3 → ℝ := fun n x ↦
    a ^ n * (A n).indicator (fun _ : E3 ↦ 1) x
  have hAmeas (n : ℤ) : MeasurableSet (A n) := by
    dsimp [A]
    exact measurableSet_le measurable_const hfmeas
  have hgint (n : ℤ) (hn : n ∈ N) : Integrable (g n) := by
    have hbase : Integrable ((A n).indicator (fun _ : E3 ↦ (1 : ℝ))) :=
      (integrableOn_const (s := A n) (μ := volume) (C := (1 : ℝ))
        (hfinite n hn)).integrable_indicator (hAmeas n)
    simpa [g] using hbase.const_mul (a ^ n)
  have hsumint : Integrable (fun x : E3 ↦ ∑ n ∈ N, g n x) := by
    exact integrable_finsetSum N (fun n hn ↦ hgint n hn)
  have hrewrite (x : E3) :
      (∑ n ∈ N, g n x) =
        ∑ n ∈ N.filter (fun n ↦ c * a ^ n ≤ f x), a ^ n := by
    calc
      (∑ n ∈ N, g n x) =
          ∑ n ∈ N, if c * a ^ n ≤ f x then a ^ n else 0 := by
            apply Finset.sum_congr rfl
            intro n hn
            by_cases hnx : c * a ^ n ≤ f x
            · have hx : x ∈ A n := by simpa [A] using hnx
              change a ^ n * (A n).indicator (fun _ : E3 ↦ (1 : ℝ)) x = _
              rw [Set.indicator_of_mem hx]
              simp [hnx]
            · have hx : x ∉ A n := by simpa [A] using hnx
              change a ^ n * (A n).indicator (fun _ : E3 ↦ (1 : ℝ)) x = _
              rw [Set.indicator_of_notMem hx]
              simp [hnx]
      _ = ∑ n ∈ N.filter (fun n ↦ c * a ^ n ≤ f x), a ^ n := by
            rw [Finset.sum_filter]
  have hpoint (x : E3) :
      (∑ n ∈ N, g n x) ≤ ((1 - a⁻¹)⁻¹ * c⁻¹) * f x := by
    rw [hrewrite]
    have hlayer := sum_zpow_filter_le_layerCake a c (f x)
      ha hc (hfnonneg x) N
    convert hlayer using 1 ; field_simp [hc.ne']
  have hrightint : Integrable (fun x : E3 ↦
      ((1 - a⁻¹)⁻¹ * c⁻¹) * f x) :=
    hfint.const_mul _
  calc
    (∑ n ∈ N, a ^ n *
        (volume {x : E3 | c * a ^ n ≤ f x}).toReal) =
        ∑ n ∈ N, ∫ x : E3, g n x := by
          apply Finset.sum_congr rfl
          intro n hn
          dsimp [g]
          have hone : (∫ x : E3,
              (A n).indicator (fun _ : E3 ↦ (1 : ℝ)) x) =
              (volume (A n)).toReal :=
            integral_indicator_one (μ := volume) (hAmeas n)
          rw [integral_const_mul, hone]
    _ = ∫ x : E3, ∑ n ∈ N, g n x :=
      (integral_finsetSum N hgint).symm
    _ ≤ ∫ x : E3, ((1 - a⁻¹)⁻¹ * c⁻¹) * f x :=
      integral_mono_ae hsumint hrightint
        (Filter.Eventually.of_forall hpoint)
    _ = ((1 - a⁻¹)⁻¹ * c⁻¹) * ∫ x : E3, f x := by
      rw [integral_const_mul]

noncomputable def finThreeCoordinates :
    (Fin 3 → ℝ) ≃ᵐ ℝ × (ℝ × ℝ) :=
  (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 ↦ ℝ) (0 : Fin 3)).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
      (MeasurableEquiv.piFinTwo (fun _ : Fin 2 ↦ ℝ)))

/-- Split a four-coordinate real vector into its coordinates in increasing
`Fin` order. -/
noncomputable def finFourCoordinates :
    (Fin 4 → ℝ) ≃ᵐ ℝ × (ℝ × (ℝ × ℝ)) :=
  (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 4 ↦ ℝ) (0 : Fin 4)).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
      finThreeCoordinates)

/-- Split a five-coordinate real vector into its coordinates in increasing
`Fin` order. -/
noncomputable def finFiveCoordinates :
    (Fin 5 → ℝ) ≃ᵐ ℝ × (ℝ × (ℝ × (ℝ × ℝ))) :=
  (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 5 ↦ ℝ) (0 : Fin 5)).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
      finFourCoordinates)

/-- Euclidean coordinates of a point of `E3`, in the order `0,1,2`. -/
noncomputable def e3Coordinates :
    E3 ≃ᵐ ℝ × (ℝ × ℝ) :=
  (MeasurableEquiv.toLp 2 (Fin 3 → ℝ)).symm.trans
    finThreeCoordinates

/-- Euclidean coordinates of a point of `ModelE5`, in the order
`0,1,2,3,4`. -/
noncomputable def modelE5Coordinates :
    ModelE5 ≃ᵐ ℝ × (ℝ × (ℝ × (ℝ × ℝ))) :=
  (MeasurableEquiv.toLp 2 (Fin 5 → ℝ)).symm.trans
    finFiveCoordinates

@[simp] theorem finThreeCoordinates_apply (v : Fin 3 → ℝ) :
    finThreeCoordinates v = (v 0, (v 1, v 2)) := by
  change (v 0, (Fin.tail v 0, Fin.tail v 1)) = (v 0, (v 1, v 2))
  rfl

@[simp] theorem finFourCoordinates_apply (v : Fin 4 → ℝ) :
    finFourCoordinates v = (v 0, (v 1, (v 2, v 3))) := by
  change (v 0, finThreeCoordinates (Fin.tail v)) =
    (v 0, (v 1, (v 2, v 3)))
  rw [finThreeCoordinates_apply]
  rfl

@[simp] theorem finFiveCoordinates_apply (v : Fin 5 → ℝ) :
    finFiveCoordinates v = (v 0, (v 1, (v 2, (v 3, v 4)))) := by
  change (v 0, finFourCoordinates (Fin.tail v)) =
    (v 0, (v 1, (v 2, (v 3, v 4))))
  rw [finFourCoordinates_apply]
  rfl

@[simp] theorem e3Coordinates_apply (p : E3) :
    e3Coordinates p = (p 0, (p 1, p 2)) := by
  simp [e3Coordinates]

@[simp] theorem modelE5Coordinates_apply (z : ModelE5) :
    modelE5Coordinates z = (z 0, (z 1, (z 2, (z 3, z 4)))) := by
  simp [modelE5Coordinates]

/-- The three-coordinate splitting is Lebesgue-measure preserving. -/
theorem finThreeCoordinates_measurePreserving :
    MeasurePreserving finThreeCoordinates
      (Measure.pi fun _ : Fin 3 ↦ (volume : Measure ℝ))
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
  have h₁ := volume_preserving_piFinSuccAbove
    (fun _ : Fin 3 ↦ ℝ) (0 : Fin 3)
  have h₂ := (MeasurePreserving.id (volume : Measure ℝ)).prod
    (volume_preserving_piFinTwo (fun _ : Fin 2 ↦ ℝ))
  have h := h₂.comp h₁
  rw [volume_pi] at h
  rw [Measure.volume_eq_prod] at h
  convert h using 1
  funext v
  rw [finThreeCoordinates_apply]
  rfl

/-- The four-coordinate splitting is Lebesgue-measure preserving. -/
theorem finFourCoordinates_measurePreserving :
    MeasurePreserving finFourCoordinates
      (Measure.pi fun _ : Fin 4 ↦ (volume : Measure ℝ))
      ((volume : Measure ℝ).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) := by
  have h₁ := volume_preserving_piFinSuccAbove
    (fun _ : Fin 4 ↦ ℝ) (0 : Fin 4)
  have h₂ := (MeasurePreserving.id (volume : Measure ℝ)).prod
    finThreeCoordinates_measurePreserving
  have h := h₂.comp h₁
  rw [volume_pi] at h
  convert h using 1
  funext v
  change (v 0, (v 1, (v 2, v 3))) =
    (v 0, finThreeCoordinates (Fin.tail v))
  rw [finThreeCoordinates_apply]
  rfl

/-- The five-coordinate splitting is Lebesgue-measure preserving. -/
theorem finFiveCoordinates_measurePreserving :
    MeasurePreserving finFiveCoordinates
      (Measure.pi fun _ : Fin 5 ↦ (volume : Measure ℝ))
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))) := by
  have h₁ := volume_preserving_piFinSuccAbove
    (fun _ : Fin 5 ↦ ℝ) (0 : Fin 5)
  have h₂ := (MeasurePreserving.id (volume : Measure ℝ)).prod
    finFourCoordinates_measurePreserving
  have h := h₂.comp h₁
  rw [volume_pi] at h
  convert h using 1
  funext v
  change (v 0, (v 1, (v 2, (v 3, v 4)))) =
    (v 0, finFourCoordinates (Fin.tail v))
  rw [finFourCoordinates_apply]
  rfl

/-- The coordinate map on `E3` preserves Lebesgue measure. -/
theorem e3Coordinates_measurePreserving :
    MeasurePreserving e3Coordinates (volume : Measure E3)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
  exact finThreeCoordinates_measurePreserving.comp
    (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 3))

/-- The coordinate map on the five model variables preserves Lebesgue
measure. -/
theorem modelE5Coordinates_measurePreserving :
    MeasurePreserving modelE5Coordinates (volume : Measure ModelE5)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))) := by
  exact finFiveCoordinates_measurePreserving.comp
    (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 5))

/-- Swap the first two entries of a right-associated triple. Keeping this
small permutation separate makes the later nine-variable reordering a
composition of literal product-measure isomorphisms. -/
noncomputable def swapMiddle
    (A B C : Type*) [MeasurableSpace A] [MeasurableSpace B] [MeasurableSpace C] :
    A × (B × C) ≃ᵐ B × (A × C) :=
  ((MeasurableEquiv.prodAssoc.symm :
      A × (B × C) ≃ᵐ (A × B) × C).trans
    (MeasurableEquiv.prodCongr
      (MeasurableEquiv.prodComm : A × B ≃ᵐ B × A)
      (MeasurableEquiv.refl C))).trans
    (MeasurableEquiv.prodAssoc : (B × A) × C ≃ᵐ B × (A × C))

@[simp] theorem swapMiddle_apply
    (A B C : Type*) [MeasurableSpace A] [MeasurableSpace B] [MeasurableSpace C]
    (a : A) (b : B) (c : C) :
    swapMiddle A B C (a, (b, c)) = (b, (a, c)) := by
  simp [swapMiddle, MeasurableEquiv.prodAssoc,
    MeasurableEquiv.prodComm, MeasurableEquiv.prodCongr]

/-- `swapMiddle` preserves the iterated product measure. -/
theorem swapMiddle_measurePreserving
    (A B C : Type*) [MeasurableSpace A] [MeasurableSpace B] [MeasurableSpace C]
    (μA : Measure A) (μB : Measure B) (μC : Measure C)
    [SFinite μA] [SFinite μB] [SFinite μC] :
    MeasurePreserving (swapMiddle A B C)
      (μA.prod (μB.prod μC)) (μB.prod (μA.prod μC)) := by
  let h₁ : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        A × (B × C) ≃ᵐ (A × B) × C)
      (μA.prod (μB.prod μC)) ((μA.prod μB).prod μC) :=
    (measurePreserving_prodAssoc μA μB μC).symm
  let h₂ : MeasurePreserving
      (MeasurableEquiv.prodCongr
        (MeasurableEquiv.prodComm : A × B ≃ᵐ B × A)
        (MeasurableEquiv.refl C))
      ((μA.prod μB).prod μC) ((μB.prod μA).prod μC) :=
    (Measure.measurePreserving_swap : MeasurePreserving Prod.swap
      (μA.prod μB) (μB.prod μA)).prod (MeasurePreserving.id μC)
  let h₃ : MeasurePreserving
      (MeasurableEquiv.prodAssoc : (B × A) × C ≃ᵐ B × (A × C))
      ((μB.prod μA).prod μC) (μB.prod (μA.prod μC)) :=
    measurePreserving_prodAssoc μB μA μC
  simpa only [swapMiddle] using (h₁.trans h₂).trans h₃

/-- The four-block permutation that sends `(a,b,c,d)` to `(c,b,a,d)`.
For the global second energy it moves the two fiber base variables forward
while retaining the scale-frequency pair between them and the scalar mass
variables. -/
noncomputable def crossShuffle
    (A B C D : Type*) [MeasurableSpace A] [MeasurableSpace B]
    [MeasurableSpace C] [MeasurableSpace D] :
    (A × B) × (C × D) ≃ᵐ (C × B) × (A × D) :=
  ((((MeasurableEquiv.prodAssoc :
      (A × B) × (C × D) ≃ᵐ A × (B × (C × D))).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl A)
      (swapMiddle B C D))).trans
    (swapMiddle A C (B × D))).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl C)
      (swapMiddle A B D))).trans
    (MeasurableEquiv.prodAssoc.symm :
      C × (B × (A × D)) ≃ᵐ (C × B) × (A × D))

@[simp] theorem crossShuffle_apply
    (A B C D : Type*) [MeasurableSpace A] [MeasurableSpace B]
    [MeasurableSpace C] [MeasurableSpace D]
    (a : A) (b : B) (c : C) (d : D) :
    crossShuffle A B C D ((a, b), (c, d)) = ((c, b), (a, d)) := by
  simp [crossShuffle, swapMiddle,
    MeasurableEquiv.prodAssoc, MeasurableEquiv.prodComm,
    MeasurableEquiv.prodCongr]

/-- `crossShuffle` preserves the corresponding fourfold product
measure. -/
theorem crossShuffle_measurePreserving
    (A B C D : Type*) [MeasurableSpace A] [MeasurableSpace B]
    [MeasurableSpace C] [MeasurableSpace D]
    (μA : Measure A) (μB : Measure B) (μC : Measure C) (μD : Measure D)
    [SFinite μA] [SFinite μB] [SFinite μC] [SFinite μD] :
    MeasurePreserving (crossShuffle A B C D)
      ((μA.prod μB).prod (μC.prod μD))
      ((μC.prod μB).prod (μA.prod μD)) := by
  let h₁ : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        (A × B) × (C × D) ≃ᵐ A × (B × (C × D)))
      ((μA.prod μB).prod (μC.prod μD))
      (μA.prod (μB.prod (μC.prod μD))) :=
    measurePreserving_prodAssoc μA μB (μC.prod μD)
  let h₂ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl A)
        (swapMiddle B C D))
      (μA.prod (μB.prod (μC.prod μD)))
      (μA.prod (μC.prod (μB.prod μD))) :=
    (MeasurePreserving.id μA).prod
      (swapMiddle_measurePreserving B C D μB μC μD)
  let h₃ : MeasurePreserving (swapMiddle A C (B × D))
      (μA.prod (μC.prod (μB.prod μD)))
      (μC.prod (μA.prod (μB.prod μD))) :=
    swapMiddle_measurePreserving A C (B × D) μA μC (μB.prod μD)
  let h₄ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl C)
        (swapMiddle A B D))
      (μC.prod (μA.prod (μB.prod μD)))
      (μC.prod (μB.prod (μA.prod μD))) :=
    (MeasurePreserving.id μC).prod
      (swapMiddle_measurePreserving A B D μA μB μD)
  let h₅ : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        C × (B × (A × D)) ≃ᵐ (C × B) × (A × D))
      (μC.prod (μB.prod (μA.prod μD)))
      ((μC.prod μB).prod (μA.prod μD)) :=
    (measurePreserving_prodAssoc μC μB (μA.prod μD)).symm
  simpa only [crossShuffle] using (((h₁.trans h₂).trans h₃).trans h₄).trans h₅

/-- The four variables that remain after the scalar masses are integrated:
`(x₁,x₂,p₂,t)`. -/
abbrev ScratchModelEnergyOuter := (ℝ × ℝ) × (ℝ × ℝ)

/-- The five scalar variables integrated by Tonelli:
`(p₀,p₁,y₁,y₂,r)`. -/
abbrev ScratchModelEnergyInner := (ℝ × ℝ) × (ℝ × (ℝ × ℝ))

/-- Regroup the coordinate lists of the center and model variables into
`((p₀,p₁),(p₂,t))` and `((x₁,x₂),(y₁,(y₂,r)))`. -/
noncomputable def modelEnergyCoordinateGroup :
    (((ℝ × (ℝ × ℝ)) × ℝ) ×
      (ℝ × (ℝ × (ℝ × (ℝ × ℝ))))) ≃ᵐ
    (((ℝ × ℝ) × (ℝ × ℝ)) ×
      ((ℝ × ℝ) × (ℝ × (ℝ × ℝ)))) :=
  MeasurableEquiv.prodCongr
    ((MeasurableEquiv.prodCongr
        (MeasurableEquiv.prodAssoc.symm :
          ℝ × (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) × ℝ)
        (MeasurableEquiv.refl ℝ)).trans
      (MeasurableEquiv.prodAssoc :
        ((ℝ × ℝ) × ℝ) × ℝ ≃ᵐ (ℝ × ℝ) × (ℝ × ℝ)))
    (MeasurableEquiv.prodAssoc.symm :
      ℝ × (ℝ × (ℝ × (ℝ × ℝ))) ≃ᵐ
        (ℝ × ℝ) × (ℝ × (ℝ × ℝ)))

@[simp] theorem modelEnergyCoordinateGroup_apply
    (p₀ p₁ p₂ t x₁ x₂ y₁ y₂ r : ℝ) :
    modelEnergyCoordinateGroup
      (((p₀, (p₁, p₂)), t), (x₁, (x₂, (y₁, (y₂, r))))) =
      (((p₀, p₁), (p₂, t)), ((x₁, x₂), (y₁, (y₂, r)))) := by
  simp [modelEnergyCoordinateGroup, MeasurableEquiv.prodAssoc,
    MeasurableEquiv.prodCongr]

/-- The regrouping preceding the four-block shuffle preserves the literal
ninefold product measure. -/
theorem modelEnergyCoordinateGroup_measurePreserving
    (μ : Measure ℝ) [SFinite μ] :
    MeasurePreserving modelEnergyCoordinateGroup
      (((μ.prod (μ.prod μ)).prod μ).prod
        (μ.prod (μ.prod (μ.prod (μ.prod μ)))))
      (((μ.prod μ).prod (μ.prod μ)).prod
        ((μ.prod μ).prod (μ.prod (μ.prod μ)))) := by
  let hleft₁ : MeasurePreserving
      (MeasurableEquiv.prodCongr
        (MeasurableEquiv.prodAssoc.symm :
          ℝ × (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) × ℝ)
        (MeasurableEquiv.refl ℝ))
      ((μ.prod (μ.prod μ)).prod μ) (((μ.prod μ).prod μ).prod μ) :=
    (measurePreserving_prodAssoc μ μ μ).symm.prod (MeasurePreserving.id μ)
  let hleft₂ : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        ((ℝ × ℝ) × ℝ) × ℝ ≃ᵐ (ℝ × ℝ) × (ℝ × ℝ))
      (((μ.prod μ).prod μ).prod μ) ((μ.prod μ).prod (μ.prod μ)) :=
    measurePreserving_prodAssoc (μ.prod μ) μ μ
  let hleft : MeasurePreserving
      ((MeasurableEquiv.prodCongr
        (MeasurableEquiv.prodAssoc.symm :
          ℝ × (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) × ℝ)
        (MeasurableEquiv.refl ℝ)).trans
      (MeasurableEquiv.prodAssoc :
        ((ℝ × ℝ) × ℝ) × ℝ ≃ᵐ (ℝ × ℝ) × (ℝ × ℝ)))
      ((μ.prod (μ.prod μ)).prod μ) ((μ.prod μ).prod (μ.prod μ)) :=
    hleft₁.trans hleft₂
  let hright : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        ℝ × (ℝ × (ℝ × (ℝ × ℝ))) ≃ᵐ
          (ℝ × ℝ) × (ℝ × (ℝ × ℝ)))
      (μ.prod (μ.prod (μ.prod (μ.prod μ))))
      ((μ.prod μ).prod (μ.prod (μ.prod μ))) :=
    (measurePreserving_prodAssoc μ μ (μ.prod (μ.prod μ))).symm
  convert hleft.prod hright using 1
  funext q
  rfl

/-- The explicit coordinate reordering for the `E3 × ModelE5` Tonelli
reduction. It sends `((p,t),z)` to
`(((z₀,z₁),(p₂,t)),((p₀,p₁),(z₂,(z₃,z₄))))`, so all variables with scalar
kernel mass occur in the final inner factor. -/
noncomputable def modelEnergyCoordinateReorder :
    ((E3 × ℝ) × ModelE5) ≃ᵐ ScratchModelEnergyOuter × ScratchModelEnergyInner :=
  ((MeasurableEquiv.prodCongr
      (MeasurableEquiv.prodCongr e3Coordinates
        (MeasurableEquiv.refl ℝ))
      modelE5Coordinates).trans
    modelEnergyCoordinateGroup).trans
    (crossShuffle (ℝ × ℝ) (ℝ × ℝ) (ℝ × ℝ)
      (ℝ × (ℝ × ℝ)))

@[simp] theorem modelEnergyCoordinateReorder_apply
    (p : E3) (t : ℝ) (z : ModelE5) :
    modelEnergyCoordinateReorder ((p, t), z) =
      (((z 0, z 1), (p 2, t)), ((p 0, p 1), (z 2, (z 3, z 4)))) := by
  change crossShuffle (ℝ × ℝ) (ℝ × ℝ) (ℝ × ℝ)
      (ℝ × (ℝ × ℝ))
      (modelEnergyCoordinateGroup
        ((e3Coordinates p, t), modelE5Coordinates z)) = _
  rw [e3Coordinates_apply, modelE5Coordinates_apply,
    modelEnergyCoordinateGroup_apply, crossShuffle_apply]

/-- The global-energy coordinate reordering is measure preserving from
Lebesgue measure on `(E3 × ℝ) × ModelE5` to the outer/inner product measure
used for the scalar Tonelli integrations. -/
theorem modelEnergyCoordinateReorder_measurePreserving :
    MeasurePreserving modelEnergyCoordinateReorder
      (((volume : Measure E3).prod (volume : Measure ℝ)).prod
        (volume : Measure ModelE5))
      ((((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod volume)).prod
        (((volume : Measure ℝ).prod volume).prod
          ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))) := by
  let hcoords : MeasurePreserving
      (MeasurableEquiv.prodCongr
        (MeasurableEquiv.prodCongr e3Coordinates
          (MeasurableEquiv.refl ℝ))
        modelE5Coordinates)
      (((volume : Measure E3).prod (volume : Measure ℝ)).prod
        (volume : Measure ModelE5))
      (((((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)).prod
        (volume : Measure ℝ))).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod
          ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))))) :=
    ((e3Coordinates_measurePreserving.prod
      (MeasurePreserving.id (volume : Measure ℝ))).prod
      modelE5Coordinates_measurePreserving)
  let hgroup := modelEnergyCoordinateGroup_measurePreserving
    (volume : Measure ℝ)
  let hcross := crossShuffle_measurePreserving
    (ℝ × ℝ) (ℝ × ℝ) (ℝ × ℝ) (ℝ × (ℝ × ℝ))
    ((volume : Measure ℝ).prod volume)
    ((volume : Measure ℝ).prod volume)
    ((volume : Measure ℝ).prod volume)
    ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))
  simpa only [modelEnergyCoordinateReorder] using
    (hcoords.trans hgroup).trans hcross

/-- The regrouping also works when the scale variable carries an arbitrary
sigma-finite measure. This is the form needed for `dt / t`, rather than
only for ordinary Lebesgue measure in the scale coordinate. -/
theorem modelEnergyCoordinateGroup_measurePreserving_scale
    (μ ν : Measure ℝ) [SFinite μ] [SFinite ν] :
    MeasurePreserving modelEnergyCoordinateGroup
      (((μ.prod (μ.prod μ)).prod ν).prod
        (μ.prod (μ.prod (μ.prod (μ.prod μ)))))
      (((μ.prod μ).prod (μ.prod ν)).prod
        ((μ.prod μ).prod (μ.prod (μ.prod μ)))) := by
  let hleft₁ : MeasurePreserving
      (MeasurableEquiv.prodCongr
        (MeasurableEquiv.prodAssoc.symm :
          ℝ × (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) × ℝ)
        (MeasurableEquiv.refl ℝ))
      ((μ.prod (μ.prod μ)).prod ν) (((μ.prod μ).prod μ).prod ν) :=
    (measurePreserving_prodAssoc μ μ μ).symm.prod (MeasurePreserving.id ν)
  let hleft₂ : MeasurePreserving
      (MeasurableEquiv.prodAssoc :
        ((ℝ × ℝ) × ℝ) × ℝ ≃ᵐ (ℝ × ℝ) × (ℝ × ℝ))
      (((μ.prod μ).prod μ).prod ν) ((μ.prod μ).prod (μ.prod ν)) :=
    measurePreserving_prodAssoc (μ.prod μ) μ ν
  let hleft : MeasurePreserving
      ((MeasurableEquiv.prodCongr
        (MeasurableEquiv.prodAssoc.symm :
          ℝ × (ℝ × ℝ) ≃ᵐ (ℝ × ℝ) × ℝ)
        (MeasurableEquiv.refl ℝ)).trans
      (MeasurableEquiv.prodAssoc :
        ((ℝ × ℝ) × ℝ) × ℝ ≃ᵐ (ℝ × ℝ) × (ℝ × ℝ)))
      ((μ.prod (μ.prod μ)).prod ν) ((μ.prod μ).prod (μ.prod ν)) :=
    hleft₁.trans hleft₂
  let hright : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        ℝ × (ℝ × (ℝ × (ℝ × ℝ))) ≃ᵐ
          (ℝ × ℝ) × (ℝ × (ℝ × ℝ)))
      (μ.prod (μ.prod (μ.prod (μ.prod μ))))
      ((μ.prod μ).prod (μ.prod (μ.prod μ))) :=
    (measurePreserving_prodAssoc μ μ (μ.prod (μ.prod μ))).symm
  convert hleft.prod hright using 1
  funext q
  rfl

/-- The coordinate reordering preserves measure with an arbitrary
sigma-finite scale measure. Specializing `ν` to the density measure
`volume.withDensity cubeScaleDensity` is the global-energy change of
variables. -/
theorem modelEnergyCoordinateReorder_measurePreserving_scale
    (ν : Measure ℝ) [SFinite ν] :
    MeasurePreserving modelEnergyCoordinateReorder
      (((volume : Measure E3).prod ν).prod (volume : Measure ModelE5))
      ((((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ν)).prod
        (((volume : Measure ℝ).prod volume).prod
          ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))) := by
  let hcoords : MeasurePreserving
      (MeasurableEquiv.prodCongr
        (MeasurableEquiv.prodCongr e3Coordinates
          (MeasurableEquiv.refl ℝ))
        modelE5Coordinates)
      (((volume : Measure E3).prod ν).prod (volume : Measure ModelE5))
      ((((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)).prod ν).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod
          ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))))) :=
    ((e3Coordinates_measurePreserving.prod
      (MeasurePreserving.id ν)).prod
      modelE5Coordinates_measurePreserving)
  let hgroup := modelEnergyCoordinateGroup_measurePreserving_scale
    (volume : Measure ℝ) ν
  let hcross := crossShuffle_measurePreserving
    (ℝ × ℝ) (ℝ × ℝ) (ℝ × ℝ) (ℝ × (ℝ × ℝ))
    ((volume : Measure ℝ).prod volume)
    ((volume : Measure ℝ).prod ν)
    ((volume : Measure ℝ).prod volume)
    ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))
  simpa only [modelEnergyCoordinateReorder] using
    (hcoords.trans hgroup).trans hcross

/-- Exact Tonelli transport after the global-energy coordinate reordering.
The sole analytic hypothesis is joint integrability; all coordinate and
product-measure bookkeeping is discharged by the preceding equivalence. -/
theorem integral_modelEnergyCoordinateReorder
    (ν : Measure ℝ) [SFinite ν] (G : (E3 × ℝ) × ModelE5 → ℝ) :
    (∫ q : (E3 × ℝ) × ModelE5, G q
      ∂(((volume : Measure E3).prod ν).prod (volume : Measure ModelE5))) =
      ∫ w : ScratchModelEnergyOuter × ScratchModelEnergyInner,
        G (modelEnergyCoordinateReorder.symm w)
        ∂((((volume : Measure ℝ).prod volume).prod
          ((volume : Measure ℝ).prod ν)).prod
          (((volume : Measure ℝ).prod volume).prod
            ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))) := by
  let e := modelEnergyCoordinateReorder
  let μin : Measure ((E3 × ℝ) × ModelE5) :=
    ((volume : Measure E3).prod ν).prod volume
  let μout : Measure (ScratchModelEnergyOuter × ScratchModelEnergyInner) :=
    (((volume : Measure ℝ).prod volume).prod
      ((volume : Measure ℝ).prod ν)).prod
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))
  have hmp : MeasurePreserving e μin μout := by
    simpa only [e, μin, μout] using
      modelEnergyCoordinateReorder_measurePreserving_scale ν
  exact (MeasurePreserving.symm e hmp).integral_comp
    e.symm.measurableEmbedding G |>.symm

/-- Fubini's form of the preceding coordinate transport: the inner integral
is precisely over `(p₀,p₁,y₁,y₂,r)`, leaving `(x₁,x₂,p₂,t)` outside. -/
theorem integral_modelEnergyCoordinateReorder_fubini
    (ν : Measure ℝ) [SFinite ν] (G : (E3 × ℝ) × ModelE5 → ℝ)
    (hG : Integrable G
      (((volume : Measure E3).prod ν).prod (volume : Measure ModelE5))) :
    (∫ q : (E3 × ℝ) × ModelE5, G q
      ∂(((volume : Measure E3).prod ν).prod (volume : Measure ModelE5))) =
      ∫ w : ScratchModelEnergyOuter,
        ∫ v : ScratchModelEnergyInner,
          G (modelEnergyCoordinateReorder.symm (w, v))
          ∂(((volume : Measure ℝ).prod volume).prod
            ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)))
        ∂(((volume : Measure ℝ).prod volume).prod
          ((volume : Measure ℝ).prod ν)) := by
  rw [integral_modelEnergyCoordinateReorder ν G]
  let e := modelEnergyCoordinateReorder
  let μouter : Measure ScratchModelEnergyOuter :=
    ((volume : Measure ℝ).prod volume).prod ((volume : Measure ℝ).prod ν)
  let μinner : Measure ScratchModelEnergyInner :=
    ((volume : Measure ℝ).prod volume).prod
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))
  have htrans : Integrable (fun w : ScratchModelEnergyOuter × ScratchModelEnergyInner ↦
      G (e.symm w)) (μouter.prod μinner) := by
    have hmp := modelEnergyCoordinateReorder_measurePreserving_scale ν
    exact (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hG
  exact MeasureTheory.integral_prod _ htrans

/-- Assemble the five scalar fiber coordinates in their original model
order. This is the inverse-coordinate companion of
`modelE5Coordinates`. -/
noncomputable def modelE5Point
    (x₁ x₂ y₁ y₂ r : ℝ) : ModelE5 :=
  WithLp.toLp 2 fun i ↦
    if i = 0 then x₁ else if i = 1 then x₂ else if i = 2 then y₁ else
      if i = 3 then y₂ else r

@[simp] theorem modelE5Point_zero
    (x₁ x₂ y₁ y₂ r : ℝ) : modelE5Point x₁ x₂ y₁ y₂ r 0 = x₁ := by
  simp [modelE5Point]

@[simp] theorem modelE5Point_one
    (x₁ x₂ y₁ y₂ r : ℝ) : modelE5Point x₁ x₂ y₁ y₂ r 1 = x₂ := by
  simp [modelE5Point]

@[simp] theorem modelE5Point_two
    (x₁ x₂ y₁ y₂ r : ℝ) : modelE5Point x₁ x₂ y₁ y₂ r 2 = y₁ := by
  simp [modelE5Point]

@[simp] theorem modelE5Point_three
    (x₁ x₂ y₁ y₂ r : ℝ) : modelE5Point x₁ x₂ y₁ y₂ r 3 = y₂ := by
  simp [modelE5Point]

@[simp] theorem modelE5Point_four
    (x₁ x₂ y₁ y₂ r : ℝ) : modelE5Point x₁ x₂ y₁ y₂ r 4 = r := by
  simp [modelE5Point]

/-- Explicit inverse formula for the global-energy coordinate permutation. -/
theorem modelEnergyCoordinateReorder_symm_apply
    (x₁ x₂ p₂ t p₀ p₁ y₁ y₂ r : ℝ) :
    modelEnergyCoordinateReorder.symm
      (((x₁, x₂), (p₂, t)), ((p₀, p₁), (y₁, (y₂, r)))) =
      ((modelPoint p₀ p₁ p₂, t), modelE5Point x₁ x₂ y₁ y₂ r) := by
  apply modelEnergyCoordinateReorder.injective
  rw [modelEnergyCoordinateReorder.apply_symm_apply,
    modelEnergyCoordinateReorder_apply]
  simp

/-- The third-coordinate fiber after all harmless scalar variables have been
made explicit. It depends only on `(x₁,x₂,p₂,t,r)`. -/
noncomputable def modelSecondFiberReduced
    (α : Anisotropy) (f : E3 → ℝ)
    (x₁ x₂ p₂ t r : ℝ) : ℝ :=
  ∫ v : ℝ, f (modelPoint x₁ x₂ v) *
    gaussianDerivAt (t ^ α.weight 2)
      (p₂ + r * t ^ α.weight 2) v

/-- Opening the coordinates in `modelSecondFiber` leaves exactly the reduced
third-coordinate fiber. -/
theorem modelSecondFiber_eq_reduced
    (α : Anisotropy) (f : E3 → ℝ)
    (p₀ p₁ p₂ t x₁ x₂ y₁ y₂ r : ℝ) :
    modelSecondFiber α f (modelPoint p₀ p₁ p₂) t
      (modelE5Point x₁ x₂ y₁ y₂ r) =
      modelSecondFiberReduced α f x₁ x₂ p₂ t r := by
  unfold modelSecondFiber modelSecondFiberReduced
  simp only [modelPoint_two,
    modelE5Point_zero, modelE5Point_one,
    modelE5Point_four]

/-- The positive density in the reordered variables. The first two pairs
are the scalar factors integrated out by Tonelli; the final `r` factor stays
with the third-coordinate square function until the translation in `p₂`. -/
def modelEnergyDensityReordered
    (α : Anisotropy) (u : E3)
    (x₁ x₂ t p₀ p₁ y₁ y₂ r : ℝ) : ℝ :=
  |modelPhiAt (t ^ α.weight 0)
    (p₀ + t ^ α.weight 0 * u 0) x₁| *
  gaussianAt (t ^ α.weight 0) p₀ y₁ *
  |modelPhiAt (t ^ α.weight 1)
    (p₁ + t ^ α.weight 1 * u 1) x₂| *
  gaussianAt (t ^ α.weight 1) p₁ y₂ *
  |conePsiPhysicalReal (r + u 2)|

/-- The literal energy density agrees with the scalar reordered density. -/
theorem modelEnergyDensity_eq_reordered
    (α : Anisotropy) (u : E3)
    (p₀ p₁ p₂ t x₁ x₂ y₁ y₂ r : ℝ) :
    modelEnergyDensity α u (modelPoint p₀ p₁ p₂) t
      (modelE5Point x₁ x₂ y₁ y₂ r) =
      modelEnergyDensityReordered α u x₁ x₂ t p₀ p₁ y₁ y₂ r := by
  unfold modelEnergyDensity modelEnergyDensityReordered
  simp only [modelPoint_zero, modelPoint_one,
    modelE5Point_zero, modelE5Point_one,
    modelE5Point_two, modelE5Point_three,
    modelE5Point_four]

/-- The joint second-energy integrand, pulled back to the Tonelli coordinate
order, is a reduced square function times its five explicit scalar factors. -/
theorem modelEnergyTwoIntegrand_reorder_symm
    (α : Anisotropy) (u : E3) (f : E3 → ℝ)
    (x₁ x₂ p₂ t p₀ p₁ y₁ y₂ r : ℝ) :
    modelEnergyTwoIntegrand α u f
      (modelEnergyCoordinateReorder.symm
        (((x₁, x₂), (p₂, t)), ((p₀, p₁), (y₁, (y₂, r))))).1
      (modelEnergyCoordinateReorder.symm
        (((x₁, x₂), (p₂, t)), ((p₀, p₁), (y₁, (y₂, r))))).2 =
      (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
        modelEnergyDensityReordered α u x₁ x₂ t p₀ p₁ y₁ y₂ r := by
  rw [modelEnergyCoordinateReorder_symm_apply]
  unfold modelEnergyTwoIntegrand
  rw [modelSecondFiber_eq_reduced,
    modelEnergyDensity_eq_reordered]


/-- The third coordinate axis, regarded as an injective real linear map into
the ambient source space. -/
noncomputable def modelThirdAxis : ℝ →L[ℝ] E3 :=
  (ContinuousLinearMap.id ℝ ℝ).smulRight (Anisotropy.coordinateDirection 2)

@[simp] theorem modelThirdAxis_apply (v : ℝ) :
    modelThirdAxis v = v • Anisotropy.coordinateDirection 2 := by
  simp [modelThirdAxis]

/-- The third-axis map is injective. -/
theorem modelThirdAxis_injective :
    Function.Injective modelThirdAxis := by
  intro v w h
  have htwo := congrArg (fun z : E3 ↦ z 2) h
  simpa [modelThirdAxis, coordinateDirection_apply] using htwo

/-- The affine third-axis parametrization is exactly `modelPoint`. -/
theorem modelThirdAxis_add_modelPoint
    (x₁ x₂ v : ℝ) :
    modelThirdAxis v + modelPoint x₁ x₂ 0 = modelPoint x₁ x₂ v := by
  ext i
  fin_cases i <;>
    simp [modelThirdAxis, coordinateDirection_apply, modelPoint]

/-- Restriction of a global complex Schwartz function to a third-coordinate
model fiber. -/
noncomputable def modelThirdSchwartzFiber
    (F : SchwartzMap E3 ℂ) (x₁ x₂ : ℝ) : SchwartzMap ℝ ℂ :=
  schwartzAffinePullbackOfInjective (𝕜 := ℂ) modelThirdAxis
    modelThirdAxis_injective (modelPoint x₁ x₂ 0) F

@[simp] theorem modelThirdSchwartzFiber_apply
    (F : SchwartzMap E3 ℂ) (x₁ x₂ v : ℝ) :
    modelThirdSchwartzFiber F x₁ x₂ v = F (modelPoint x₁ x₂ v) := by
  rw [modelThirdSchwartzFiber,
    schwartzAffinePullbackOfInjective_apply,
    modelThirdAxis_add_modelPoint]

/-- A real fiber represented by a complex Schwartz function has the same
kernel integral after complexification. -/
theorem complexFiberIntegral_eq_real
    (F : SchwartzMap ℝ ℂ) (g : ℝ → ℝ) (hF : ∀ v : ℝ, F v = (g v : ℂ))
    (s q : ℝ) :
    (∫ v : ℝ, F v * (gaussianDerivAt s q v : ℂ)) =
      (∫ v : ℝ, g v * gaussianDerivAt s q v : ℝ) := by
  calc
    (∫ v : ℝ, F v * (gaussianDerivAt s q v : ℂ)) =
        ∫ v : ℝ, ((g v * gaussianDerivAt s q v : ℝ) : ℂ) := by
          apply integral_congr_ae
          filter_upwards [] with v
          rw [hF v]
          norm_cast
    _ = (∫ v : ℝ, g v * gaussianDerivAt s q v : ℝ) := integral_ofReal

/-- Complexification of a real Schwartz input, used solely to access the
complex Fourier formalism on each real model fiber. -/
noncomputable def complexifyRealSchwartz (f : SchwartzMap E3 ℝ) :
    SchwartzMap E3 ℂ :=
  f.postcompCLM Complex.ofRealCLM

@[simp] theorem complexifyRealSchwartz_apply
    (f : SchwartzMap E3 ℝ) (x : E3) :
    complexifyRealSchwartz f x = (f x : ℂ) := by
  simp [complexifyRealSchwartz]

/-- The maximal size paired with each source stopping exponent. -/
noncomputable def sourceStoppingMaximal
    (α : Anisotropy) (f : ModelRealInput) (j : Fin 4) : E3 → ℝ :=
  if j = 3 then anisotropicMaximalTwo α (f j)
  else anisotropicMaximalFour α (f j)

/-- The fixed comparison constant in the source stopping root coverage. -/
noncomputable def sourceStoppingComparisonConstant (j : Fin 4) : ℝ :=
  if j = 3 then (2 / 3 : ℝ) ^ 15
  else ((2 / 3 : ℝ) ^ 30) ^ ((4 : ℝ)⁻¹)

/-- The joint maximal superlevel region controlling every root at a given
four-component stopping level. -/
def sourceStoppingMaximalLevelSet
    (α : Anisotropy) (f : ModelRealInput) (n : Fin 4 → ℤ) : Set E3 :=
  ⋂ j : Fin 4, {p |
    sourceStoppingComparisonConstant j * (2 : ℝ) ^ (n j - 1) <
      sourceStoppingMaximal α f j p}

theorem sourceStoppingExponent_eq_two_of_eq_three {j : Fin 4} (hj : j = 3) :
    sourceStoppingExponent j = 2 := by
  simp [sourceStoppingExponent, hj]

theorem sourceStoppingExponent_eq_four_of_ne_three {j : Fin 4} (hj : j ≠ 3) :
    sourceStoppingExponent j = 4 := by
  simp [sourceStoppingExponent, hj]

theorem sourceStoppingComparisonConstant_pos (j : Fin 4) :
    0 < sourceStoppingComparisonConstant j := by
  by_cases hj : j = 3
  · simp [sourceStoppingComparisonConstant, hj]
  · simp only [sourceStoppingComparisonConstant, hj, ite_false]
    exact Real.rpow_pos_of_pos (pow_pos (by norm_num) _) _

/-- A canonical index at which the normalized stopping level is largest.
The minimum tie-breaking of the source is unnecessary for the estimate: any
maximizing index gives the same dominant-coordinate inequalities. -/
noncomputable def sourceStoppingDominantIndex
    (q σ : Fin 4 → ℝ) (n : Fin 4 → ℤ) : Fin 4 :=
  (Finset.exists_max_image Finset.univ
    (fun j ↦ q j * ((n j : ℝ) - σ j) )
    (by simp)).choose

/-- The normalized level at any coordinate is bounded by that at the chosen
dominant coordinate. -/
theorem sourceStoppingDominantIndex_spec
    (q σ : Fin 4 → ℝ) (n : Fin 4 → ℤ) (k : Fin 4) :
    q k * ((n k : ℝ) - σ k) ≤
      q (sourceStoppingDominantIndex q σ n) *
        ((n (sourceStoppingDominantIndex q σ n) : ℝ) -
          σ (sourceStoppingDominantIndex q σ n)) := by
  unfold sourceStoppingDominantIndex
  exact (Finset.exists_max_image Finset.univ
    (fun j ↦ q j * ((n j : ℝ) - σ j) )
    (by simp)).choose_spec.2 k (by simp)

/-- Every coordinate of a level vector is bounded in terms of its dominant
coordinate. -/
theorem sourceStoppingLevel_le_of_dominant
    (q σ : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (n : Fin 4 → ℤ) (j k : Fin 4)
    (hj : sourceStoppingDominantIndex q σ n = j) :
    (n k : ℝ) ≤ σ k +
      (q j / q k) * ((n j : ℝ) - σ j) := by
  have hdom := sourceStoppingDominantIndex_spec q σ n k
  rw [hj] at hdom
  have hdiv : (n k : ℝ) - σ k ≤
      (q j * ((n j : ℝ) - σ j)) / q k := by
    rw [le_div_iff₀ (hq k)]
    simpa [mul_comm, mul_left_comm, mul_assoc] using hdom
  calc
    (n k : ℝ) = σ k + ((n k : ℝ) - σ k) := by ring
    _ ≤ σ k + (q j * ((n j : ℝ) - σ j)) / q k := by gcongr
    _ = σ k + (q j / q k) * ((n j : ℝ) - σ j) := by ring

/-- The individual maximal superlevel region attached to a coordinate and
dyadic stopping level. -/
def sourceStoppingMaximalLevelSetAt
    (α : Anisotropy) (f : ModelRealInput) (j : Fin 4) (m : ℤ) : Set E3 :=
  {p | sourceStoppingComparisonConstant j * (2 : ℝ) ^ (m - 1) <
    sourceStoppingMaximal α f j p}

/-- The dominant-coordinate maximal region used to control one stopping
level vector. -/
def sourceStoppingDominantMaximalLevelSet
    (α : Anisotropy) (f : ModelRealInput) (q σ : Fin 4 → ℝ)
    (n : Fin 4 → ℤ) : Set E3 :=
  sourceStoppingMaximalLevelSetAt α f
    (sourceStoppingDominantIndex q σ n)
    (n (sourceStoppingDominantIndex q σ n))

/-- Split a finite sum according to the dominant coordinate of its level
vector. -/
theorem sum_by_sourceStoppingDominantIndex
    (A : Finset (Fin 4 → ℤ)) (q σ : Fin 4 → ℝ)
    (w : (Fin 4 → ℤ) → ℝ) (v : Fin 4 → ℤ → ℝ) :
    (∑ n ∈ A,
      w n * v (sourceStoppingDominantIndex q σ n)
        (n (sourceStoppingDominantIndex q σ n))) =
      ∑ j : Fin 4, ∑ n ∈ A with sourceStoppingDominantIndex q σ n = j,
        w n * v j (n j) := by
  calc
    (∑ n ∈ A,
      w n * v (sourceStoppingDominantIndex q σ n)
        (n (sourceStoppingDominantIndex q σ n))) =
        ∑ j : Fin 4, ∑ n ∈ A with sourceStoppingDominantIndex q σ n = j,
          w n * v (sourceStoppingDominantIndex q σ n)
            (n (sourceStoppingDominantIndex q σ n)) := by
      symm
      exact Finset.sum_fiberwise A (sourceStoppingDominantIndex q σ)
        (fun n ↦ w n * v (sourceStoppingDominantIndex q σ n)
          (n (sourceStoppingDominantIndex q σ n)))
    _ = _ := by
      refine Finset.sum_congr rfl fun j hj ↦ ?_
      refine Finset.sum_congr rfl fun n hn ↦ ?_
      exact (Finset.mem_filter.mp hn).2 ▸ rfl

/-- Reindex one dominant-coordinate fiber by its integer level. -/
theorem sum_by_sourceStoppingDominantIndex_fiber
    (A : Finset (Fin 4 → ℤ)) (q σ : Fin 4 → ℝ) (j : Fin 4)
    (w : (Fin 4 → ℤ) → ℝ) (v : Fin 4 → ℤ → ℝ) :
    (∑ n ∈ A with sourceStoppingDominantIndex q σ n = j,
      w n * v j (n j)) =
      ∑ m ∈ (A.filter fun n ↦ sourceStoppingDominantIndex q σ n = j).image
          (fun n ↦ n j),
        (∑ n ∈ A with sourceStoppingDominantIndex q σ n = j ∧ n j = m,
          w n) * v j m := by
  let B : Finset (Fin 4 → ℤ) :=
    A.filter fun n ↦ sourceStoppingDominantIndex q σ n = j
  have hmaps : ∀ n ∈ B, n j ∈ B.image (fun n ↦ n j) := by
    intro n hn
    exact Finset.mem_image.mpr ⟨n, hn, rfl⟩
  change (∑ n ∈ B, w n * v j (n j)) = _
  calc
    (∑ n ∈ B, w n * v j (n j)) =
        ∑ m ∈ B.image (fun n ↦ n j),
          ∑ n ∈ B with n j = m, w n * v j (n j) := by
      symm
      exact Finset.sum_fiberwise_of_maps_to hmaps
        (fun n ↦ w n * v j (n j))
    _ = ∑ m ∈ B.image (fun n ↦ n j),
          (∑ n ∈ B with n j = m, w n) * v j m := by
      refine Finset.sum_congr rfl fun m hm ↦ ?_
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun n hn ↦ ?_
      exact (Finset.mem_filter.mp hn).2 ▸ rfl
    _ = _ := by
      refine Finset.sum_congr rfl fun m hm ↦ ?_
      congr 1
      change (∑ n ∈ (A.filter fun n ↦ sourceStoppingDominantIndex q σ n = j).filter
          (fun n ↦ n j = m), w n) = _
      rw [Finset.filter_filter]

/-- The finite dominant-coordinate sum is reduced to scalar dyadic level
sums as soon as the three passive-coordinate fibers have a geometric bound.
This is the exact algebraic consumer for the source's dominant-index
geometric-series estimate. -/
theorem sum_by_sourceStoppingDominantIndex_le_of_fiberBound
    (A : Finset (Fin 4 → ℤ)) (q σ : Fin 4 → ℝ)
    (w : (Fin 4 → ℤ) → ℝ) (v B : Fin 4 → ℤ → ℝ)
    (hv : ∀ j m, 0 ≤ v j m)
    (hB : ∀ j m,
      (∑ n ∈ A with sourceStoppingDominantIndex q σ n = j ∧ n j = m,
        w n) ≤ B j m) :
    (∑ n ∈ A,
      w n * v (sourceStoppingDominantIndex q σ n)
        (n (sourceStoppingDominantIndex q σ n))) ≤
      ∑ j : Fin 4,
        ∑ m ∈ (A.filter fun n ↦ sourceStoppingDominantIndex q σ n = j).image
            (fun n ↦ n j),
          B j m * v j m := by
  calc
    (∑ n ∈ A,
      w n * v (sourceStoppingDominantIndex q σ n)
        (n (sourceStoppingDominantIndex q σ n))) =
        ∑ j : Fin 4, ∑ n ∈ A with sourceStoppingDominantIndex q σ n = j,
          w n * v j (n j) :=
      sum_by_sourceStoppingDominantIndex A q σ w v
    _ = ∑ j : Fin 4,
        ∑ m ∈ (A.filter fun n ↦ sourceStoppingDominantIndex q σ n = j).image
            (fun n ↦ n j),
          (∑ n ∈ A with sourceStoppingDominantIndex q σ n = j ∧ n j = m,
            w n) * v j m := by
      refine Finset.sum_congr rfl fun j hj ↦ ?_
      exact sum_by_sourceStoppingDominantIndex_fiber A q σ j w v
    _ ≤ _ := by
      refine Finset.sum_le_sum fun j hj ↦ ?_
      refine Finset.sum_le_sum fun m hm ↦ ?_
      exact mul_le_mul_of_nonneg_right (hB j m) (hv j m)

/-- A finite dyadic geometric sum below a real upper cutoff. This is the
passive-coordinate estimate in the dominant-index argument. -/
theorem sum_zpow_two_le_of_forall_le
    (N : Finset ℤ) (A : ℝ)
    (hN : ∀ n ∈ N, (n : ℝ) ≤ A) :
    (∑ n ∈ N, (2 : ℝ) ^ n) ≤ 2 * (2 : ℝ) ^ A := by
  have hpow : ∀ n ∈ N, (2 : ℝ) ^ n ≤ (2 : ℝ) ^ A := by
    intro n hn
    rw [← Real.rpow_intCast]
    exact Real.rpow_le_rpow_of_exponent_le (by norm_num) (hN n hn)
  have hfilter : N.filter (fun n ↦ (1 : ℝ) * (2 : ℝ) ^ n ≤ (2 : ℝ) ^ A) = N := by
    ext n
    simp only [Finset.mem_filter]
    constructor
    · exact fun h ↦ h.1
    · intro hn
      exact ⟨hn, by simpa using hpow n hn⟩
  calc
    (∑ n ∈ N, (2 : ℝ) ^ n) =
        ∑ n ∈ N with (1 : ℝ) * (2 : ℝ) ^ n ≤ (2 : ℝ) ^ A,
          (2 : ℝ) ^ n := by rw [hfilter]
    _ ≤ (1 - (2 : ℝ)⁻¹)⁻¹ * ((2 : ℝ) ^ A / 1) :=
      sum_zpow_filter_le_layerCake 2 1 ((2 : ℝ) ^ A) (by norm_num) (by norm_num)
        (by positivity) N
    _ = 2 * (2 : ℝ) ^ A := by ring

/-- A finite dyadic sum supported at one integer level. -/
theorem sum_zpow_two_le_of_forall_eq
    (N : Finset ℤ) (m : ℤ)
    (hN : ∀ n ∈ N, n = m) :
    (∑ n ∈ N, (2 : ℝ) ^ n) ≤ (2 : ℝ) ^ m := by
  calc
    (∑ n ∈ N, (2 : ℝ) ^ n) ≤ ∑ n ∈ ({m} : Finset ℤ), (2 : ℝ) ^ n := by
      apply Finset.sum_le_sum_of_subset_of_nonneg
      · intro n hn
        simp [hN n hn]
      · intro n hn hnot
        positivity
    _ = (2 : ℝ) ^ m := by simp

/-- A finite family of coordinatewise finite sets bounds the sum of a
nonnegative product by the product of its one-coordinate sums. -/
theorem sum_prod_le_prod_sum_of_mem_piFinset
    {ι κ : Type*} [Fintype ι]
    (A : Finset (ι → κ)) (C : ι → Finset κ)
    (g : ι → κ → ℝ)
    (hg : ∀ i x, x ∈ C i → 0 ≤ g i x)
    (hA : ∀ n ∈ A, ∀ i, n i ∈ C i) :
    (∑ n ∈ A, ∏ i, g i (n i)) ≤
      ∏ i, ∑ x ∈ C i, g i x := by
  classical
  have hsub : A ⊆ Fintype.piFinset C := by
    intro n hn
    exact Fintype.mem_piFinset.mpr (hA n hn)
  calc
    (∑ n ∈ A, ∏ i, g i (n i)) ≤
        ∑ n ∈ Fintype.piFinset C, ∏ i, g i (n i) := by
      apply Finset.sum_le_sum_of_subset_of_nonneg hsub
      intro n hn hnot
      exact Finset.prod_nonneg fun i hi ↦ hg i (n i)
        ((Fintype.mem_piFinset.mp hn) i)
    _ = ∏ i, ∑ x ∈ C i, g i x := by
      symm
      exact Finset.prod_univ_sum C g

/-- The product geometric envelope of a fiber with dominant coordinate `j`
and fixed level `m`. -/
noncomputable def sourceStoppingDominantFiberEnvelope
    (q σ : Fin 4 → ℝ) (j : Fin 4) (m : ℤ) : ℝ :=
  ∏ k : Fin 4,
    if k = j then (2 : ℝ) ^ (m : ℝ)
    else 2 * (2 : ℝ) ^
      (σ k + (q j / q k) * ((m : ℝ) - σ j))

/-- The three passive coordinates in a dominant stopping fiber contribute
only a uniform dyadic geometric factor. -/
theorem sum_sourceStoppingDominantFiber_le_envelope
    (A : Finset (Fin 4 → ℤ)) (q σ : Fin 4 → ℝ)
    (hq : ∀ k, 0 < q k) (j : Fin 4) (m : ℤ) :
    (∑ n ∈ A with sourceStoppingDominantIndex q σ n = j ∧ n j = m,
      ∏ k : Fin 4, (2 : ℝ) ^ n k) ≤
      sourceStoppingDominantFiberEnvelope q σ j m := by
  let F : Finset (Fin 4 → ℤ) :=
    A.filter fun n ↦ sourceStoppingDominantIndex q σ n = j ∧ n j = m
  let C : Fin 4 → Finset ℤ := fun k ↦ F.image fun n ↦ n k
  change (∑ n ∈ F, ∏ k : Fin 4, (2 : ℝ) ^ n k) ≤
    sourceStoppingDominantFiberEnvelope q σ j m
  calc
    (∑ n ∈ F, ∏ k : Fin 4, (2 : ℝ) ^ n k) ≤
        ∏ k : Fin 4, ∑ r ∈ C k, (2 : ℝ) ^ r := by
      apply sum_prod_le_prod_sum_of_mem_piFinset F C
        (fun _ r ↦ (2 : ℝ) ^ r)
      · intro k r hr
        positivity
      · intro n hn k
        exact Finset.mem_image.mpr ⟨n, hn, rfl⟩
    _ ≤ sourceStoppingDominantFiberEnvelope q σ j m := by
      unfold sourceStoppingDominantFiberEnvelope
      apply Finset.prod_le_prod₀
      · intro k hk
        exact Finset.sum_nonneg fun r hr ↦ by positivity
      · intro k hk
        by_cases hkj : k = j
        · subst k
          have hC : ∀ r ∈ C j, r = m := by
            intro r hr
            rcases Finset.mem_image.mp hr with ⟨n, hn, hnr⟩
            have hnF := Finset.mem_filter.mp hn
            exact hnr ▸ hnF.2.2
          simpa [Real.rpow_intCast] using sum_zpow_two_le_of_forall_eq (C j) m hC
        · have hC : ∀ r ∈ C k, (r : ℝ) ≤
            σ k + (q j / q k) * ((m : ℝ) - σ j) := by
            intro r hr
            rcases Finset.mem_image.mp hr with ⟨n, hn, hnr⟩
            have hnF := Finset.mem_filter.mp hn
            have hlevel := sourceStoppingLevel_le_of_dominant q σ hq n j k hnF.2.1
            simpa [hnr, hnF.2.2] using hlevel
          simpa [hkj] using sum_zpow_two_le_of_forall_le (C k)
            (σ k + (q j / q k) * ((m : ℝ) - σ j)) hC

/-- Combining the dominant-coordinate partition with the passive geometric
sum produces four scalar dyadic level sums. -/
theorem sum_sourceStoppingLevelWeight_le_coordinateEnvelopeSums
    (A : Finset (Fin 4 → ℤ)) (q σ : Fin 4 → ℝ)
    (hq : ∀ k, 0 < q k) (v : Fin 4 → ℤ → ℝ)
    (hv : ∀ j m, 0 ≤ v j m) :
    (∑ n ∈ A,
      (∏ k : Fin 4, (2 : ℝ) ^ n k) *
        v (sourceStoppingDominantIndex q σ n)
          (n (sourceStoppingDominantIndex q σ n))) ≤
      ∑ j : Fin 4,
        ∑ m ∈ (A.filter fun n ↦ sourceStoppingDominantIndex q σ n = j).image
            (fun n ↦ n j),
          sourceStoppingDominantFiberEnvelope q σ j m * v j m := by
  apply sum_by_sourceStoppingDominantIndex_le_of_fiberBound A q σ
    (fun n ↦ ∏ k : Fin 4, (2 : ℝ) ^ n k) v
    (sourceStoppingDominantFiberEnvelope q σ)
  · exact hv
  · intro j m
    exact sum_sourceStoppingDominantFiber_le_envelope A q σ hq j m

/-- Every root in the source `(4,4,4,2)` stopping forest lies in the
intersection of its four maximal superlevel regions. -/
theorem sourceStoppingRoot_boxSet_subset_maximalLevel
    (α : Anisotropy) (S : BoxCollection α) (f : ModelRealInput)
    (n : Fin 4 → ℤ) (Q : AnisoBox α)
    (hQ : Q ∈ stoppingRoots α S sourceStoppingExponent f n)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B) :
    boxSet α Q ⊆ sourceStoppingMaximalLevelSet α f n := by
  intro p hp
  rw [sourceStoppingMaximalLevelSet, Set.mem_iInter]
  intro j
  rcases hbound j with ⟨B, hB, hfB⟩
  by_cases hj : j = 3
  · subst j
    simpa [sourceStoppingExponent, sourceStoppingMaximal,
      sourceStoppingComparisonConstant] using
      stoppingRoot_two_boxSet_subset_maximalLevel α S sourceStoppingExponent f n Q hQ
        3 (by simp [sourceStoppingExponent]) (hcont 3) B hB hfB hp
  · simpa [sourceStoppingExponent, sourceStoppingMaximal,
      sourceStoppingComparisonConstant, hj] using
      stoppingRoot_four_boxSet_subset_maximalLevel α S sourceStoppingExponent f n Q hQ
        j (by simp [sourceStoppingExponent, hj]) (hcont j) B hB hfB hp

/-- A source stopping root is contained in each of its four individual
maximal superlevel regions. -/
theorem sourceStoppingRoot_boxSet_subset_maximalLevelAt
    (α : Anisotropy) (S : BoxCollection α) (f : ModelRealInput)
    (n : Fin 4 → ℤ) (Q : AnisoBox α)
    (hQ : Q ∈ stoppingRoots α S sourceStoppingExponent f n)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (j : Fin 4) :
    boxSet α Q ⊆ sourceStoppingMaximalLevelSetAt α f j (n j) := by
  intro p hp
  have hlevel := sourceStoppingRoot_boxSet_subset_maximalLevel α S f n Q hQ hcont hbound hp
  exact Set.mem_iInter.mp hlevel j

/-- A source stopping root lies in the maximal superlevel region selected by
any positive exponent vector's dominant normalized coordinate. -/
theorem sourceStoppingRoot_boxSet_subset_dominantMaximalLevel
    (α : Anisotropy) (S : BoxCollection α) (f : ModelRealInput)
    (q σ : Fin 4 → ℝ) (n : Fin 4 → ℤ) (Q : AnisoBox α)
    (hQ : Q ∈ stoppingRoots α S sourceStoppingExponent f n)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B) :
    boxSet α Q ⊆ sourceStoppingDominantMaximalLevelSet α f q σ n := by
  exact sourceStoppingRoot_boxSet_subset_maximalLevelAt α S f n Q hQ hcont hbound
    (sourceStoppingDominantIndex q σ n)

/-- The source finite stopping forest is bounded by the finite weighted sum
of its joint anisotropic-maximal superlevel regions. Finite volume of each
level region is the precise analytic input supplied by maximal `L^p` bounds. -/
theorem sourceStoppingForestWeightedSum_le_maximalLevelSum
    (α : Anisotropy) (S : BoxCollection α)
    (hS : IsConvexCollection α S) (f : ModelRealInput)
    (hpos : ∀ q ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) q)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hfinite : ∀ n, volume (sourceStoppingMaximalLevelSet α f n) ≠ ∞) :
    (∑ n ∈ activeStoppingLevels α S sourceStoppingExponent f hpos,
      ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
        boxMass α Q.1 *
          (∏ j : Fin 4,
            treeLocalSize
              (stoppingTree α S sourceStoppingExponent f n
                (isConvexCollection_stoppingLevel α S hS
                  sourceStoppingExponent f n) Q.1 Q.2)
              (sourceStoppingExponent j) (f j))) ≤
      ∑ n ∈ activeStoppingLevels α S sourceStoppingExponent f hpos,
        (∏ j : Fin 4, (2 : ℝ) ^ n j) *
          (volume (sourceStoppingMaximalLevelSet α f n)).toReal := by
  apply sum_activeStoppingRoot_weights_le α S hS sourceStoppingExponent f hpos
    (sourceStoppingMaximalLevelSet α f) hfinite
  intro n Q hQ
  exact sourceStoppingRoot_boxSet_subset_maximalLevel α S f n Q hQ hcont hbound

/-- The finite stopping forest is controlled by the single maximal level set
at the dominant coordinate of each level vector. This is the form consumed
by the source's dominant-index geometric-series argument. -/
theorem sourceStoppingForestWeightedSum_le_dominantMaximalLevelSum
    (α : Anisotropy) (S : BoxCollection α)
    (hS : IsConvexCollection α S) (f : ModelRealInput)
    (q σ : Fin 4 → ℝ)
    (hpos : ∀ q ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) q)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hfinite : ∀ n,
      volume (sourceStoppingDominantMaximalLevelSet α f q σ n) ≠ ∞) :
    (∑ n ∈ activeStoppingLevels α S sourceStoppingExponent f hpos,
      ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
        boxMass α Q.1 *
          (∏ j : Fin 4,
            treeLocalSize
              (stoppingTree α S sourceStoppingExponent f n
                (isConvexCollection_stoppingLevel α S hS
                  sourceStoppingExponent f n) Q.1 Q.2)
              (sourceStoppingExponent j) (f j))) ≤
      ∑ n ∈ activeStoppingLevels α S sourceStoppingExponent f hpos,
        (∏ j : Fin 4, (2 : ℝ) ^ n j) *
          (volume (sourceStoppingDominantMaximalLevelSet α f q σ n)).toReal := by
  apply sum_activeStoppingRoot_weights_le α S hS sourceStoppingExponent f hpos
    (sourceStoppingDominantMaximalLevelSet α f q σ) hfinite
  intro n Q hQ
  exact sourceStoppingRoot_boxSet_subset_dominantMaximalLevel α S f q σ n Q hQ hcont hbound

/-- The literal source stopping forest is bounded by four scalar dyadic
maximal-level sums, with the passive-coordinate geometric series discharged.
The remaining scalar distribution estimates are exactly the maximal-function
input from the blueprint. -/
theorem sourceStoppingForestWeightedSum_le_coordinateEnvelopeSums
    (α : Anisotropy) (S : BoxCollection α)
    (hS : IsConvexCollection α S) (f : ModelRealInput)
    (q σ : Fin 4 → ℝ) (hq : ∀ k, 0 < q k)
    (hpos : ∀ q ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) q)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hfinite : ∀ n,
      volume (sourceStoppingDominantMaximalLevelSet α f q σ n) ≠ ∞) :
    (∑ n ∈ activeStoppingLevels α S sourceStoppingExponent f hpos,
      ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
        boxMass α Q.1 *
          (∏ j : Fin 4,
            treeLocalSize
              (stoppingTree α S sourceStoppingExponent f n
                (isConvexCollection_stoppingLevel α S hS
                  sourceStoppingExponent f n) Q.1 Q.2)
              (sourceStoppingExponent j) (f j))) ≤
      ∑ j : Fin 4,
        ∑ m ∈ (activeStoppingLevels α S sourceStoppingExponent f hpos).filter
            (fun n ↦ sourceStoppingDominantIndex q σ n = j) |>.image
              (fun n ↦ n j),
          sourceStoppingDominantFiberEnvelope q σ j m *
            (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal := by
  apply le_trans
    (sourceStoppingForestWeightedSum_le_dominantMaximalLevelSum α S hS f q σ hpos
      hcont hbound hfinite)
  simpa only [sourceStoppingDominantMaximalLevelSet] using
    sum_sourceStoppingLevelWeight_le_coordinateEnvelopeSums
      (activeStoppingLevels α S sourceStoppingExponent f hpos) q σ hq
      (fun j m ↦ (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal)
      (fun j m ↦ ENNReal.toReal_nonneg)

def modelFirstPassiveIndexEquiv : Fin 5 ≃
    {j : Fin 3 // j ≠ 2} ⊕ ({j : Fin 3 // j ≠ 2} ⊕ Fin 1) where
  toFun i :=
    match i.1 with
    | 0 => .inl ⟨0, by decide⟩
    | 1 => .inl ⟨1, by decide⟩
    | 2 => .inr (.inl ⟨0, by decide⟩)
    | 3 => .inr (.inl ⟨1, by decide⟩)
    | _ => .inr (.inr 0)
  invFun q :=
    match q with
    | .inl j => if j.1 = 0 then 0 else 1
    | .inr (.inl j) => if j.1 = 0 then 2 else 3
    | .inr (.inr _) => 4
  left_inv := by
    intro i
    fin_cases i <;> rfl
  right_inv := by
    intro q
    rcases q with j | (j | k)
    · rcases j with ⟨j, hj⟩
      fin_cases j
      · rfl
      · rfl
      · exact False.elim (hj rfl)
    · rcases j with ⟨j, hj⟩
      fin_cases j
      · rfl
      · rfl
      · exact False.elim (hj rfl)
    · fin_cases k
      rfl

/-- The literal measure-coordinate equivalence behind the local first- and
second-energy comparisons. It sends the five model variables to the two
third-active transverse cube variables and the remaining translation. -/
noncomputable def modelFirstPassiveCoordinates :
    ModelE5 ≃ᵐ (TransverseSpace 2 × TransverseSpace 2) × ℝ := by
  let I := {j : Fin 3 // j ≠ 2}
  let e0 : ModelE5 ≃ᵐ (Fin 5 → ℝ) :=
    (MeasurableEquiv.toLp 2 (Fin 5 → ℝ)).symm
  let e1 : (Fin 5 → ℝ) ≃ᵐ (I ⊕ (I ⊕ Fin 1) → ℝ) :=
    MeasurableEquiv.piCongrLeft (fun _ : I ⊕ (I ⊕ Fin 1) => ℝ)
      modelFirstPassiveIndexEquiv
  let e2 : (I ⊕ (I ⊕ Fin 1) → ℝ) ≃ᵐ
      (I → ℝ) × ((I → ℝ) × (Fin 1 → ℝ)) :=
    (MeasurableEquiv.sumPiEquivProdPi
      (fun _ : I ⊕ (I ⊕ Fin 1) => ℝ)).trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (I → ℝ))
        (MeasurableEquiv.sumPiEquivProdPi
          (fun _ : I ⊕ Fin 1 => ℝ)))
  let e3 : (I → ℝ) × ((I → ℝ) × (Fin 1 → ℝ)) ≃ᵐ
      (TransverseSpace 2) × ((TransverseSpace 2) × ℝ) :=
    MeasurableEquiv.prodCongr
      (MeasurableEquiv.toLp 2 (I → ℝ))
      (MeasurableEquiv.prodCongr
        (MeasurableEquiv.toLp 2 (I → ℝ))
        (MeasurableEquiv.piUnique (fun _ : Fin 1 => ℝ)))
  let e4 : (TransverseSpace 2) × ((TransverseSpace 2) × ℝ) ≃ᵐ
      (TransverseSpace 2 × TransverseSpace 2) × ℝ :=
    MeasurableEquiv.prodAssoc.symm
  exact ((e0.trans e1).trans e2).trans (e3.trans e4)

@[simp] theorem modelFirstPassiveCoordinates_apply (z : ModelE5) :
    modelFirstPassiveCoordinates z =
      (modelFirstPassivePair (z 0) (z 1) (z 2) (z 3), z 4) := by
  apply Prod.ext
  · apply Prod.ext
    · ext j
      fin_cases j
      · rfl
      · rfl
    · ext j
      fin_cases j
      · rfl
      · rfl
  · rfl

/-- The passive-coordinate equivalence preserves the literal product
Lebesgue measures. -/
theorem modelFirstPassiveCoordinates_measurePreserving :
    MeasurePreserving modelFirstPassiveCoordinates
      (volume : Measure ModelE5)
      (((volume : Measure (TransverseSpace 2)).prod
        (volume : Measure (TransverseSpace 2))).prod volume) := by
  let I := {j : Fin 3 // j ≠ 2}
  let e0 : ModelE5 ≃ᵐ (Fin 5 → ℝ) :=
    (MeasurableEquiv.toLp 2 (Fin 5 → ℝ)).symm
  let e1 : (Fin 5 → ℝ) ≃ᵐ (I ⊕ (I ⊕ Fin 1) → ℝ) :=
    MeasurableEquiv.piCongrLeft (fun _ : I ⊕ (I ⊕ Fin 1) => ℝ)
      modelFirstPassiveIndexEquiv
  let e2 : (I ⊕ (I ⊕ Fin 1) → ℝ) ≃ᵐ
      (I → ℝ) × ((I → ℝ) × (Fin 1 → ℝ)) :=
    (MeasurableEquiv.sumPiEquivProdPi
      (fun _ : I ⊕ (I ⊕ Fin 1) => ℝ)).trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (I → ℝ))
        (MeasurableEquiv.sumPiEquivProdPi
          (fun _ : I ⊕ Fin 1 => ℝ)))
  let e3 : (I → ℝ) × ((I → ℝ) × (Fin 1 → ℝ)) ≃ᵐ
      (TransverseSpace 2) × ((TransverseSpace 2) × ℝ) :=
    MeasurableEquiv.prodCongr
      (MeasurableEquiv.toLp 2 (I → ℝ))
      (MeasurableEquiv.prodCongr
        (MeasurableEquiv.toLp 2 (I → ℝ))
        (MeasurableEquiv.piUnique (fun _ : Fin 1 => ℝ)))
  let e4 : (TransverseSpace 2) × ((TransverseSpace 2) × ℝ) ≃ᵐ
      (TransverseSpace 2 × TransverseSpace 2) × ℝ :=
    MeasurableEquiv.prodAssoc.symm
  have h0 : MeasurePreserving e0 (volume : Measure ModelE5)
      (volume : Measure (Fin 5 → ℝ)) := by
    simpa only [e0] using
      (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 5))
  have h1 : MeasurePreserving e1 (volume : Measure (Fin 5 → ℝ))
      (volume : Measure (I ⊕ (I ⊕ Fin 1) → ℝ)) := by
    simpa only [e1] using
      (volume_measurePreserving_piCongrLeft
        (fun _ : I ⊕ (I ⊕ Fin 1) => ℝ)
        modelFirstPassiveIndexEquiv)
  have h2a : MeasurePreserving
      (MeasurableEquiv.sumPiEquivProdPi
        (fun _ : I ⊕ (I ⊕ Fin 1) => ℝ))
      (volume : Measure (I ⊕ (I ⊕ Fin 1) → ℝ))
      ((volume : Measure (I → ℝ)).prod
        (volume : Measure (I ⊕ Fin 1 → ℝ))) := by
    simpa only [Measure.volume_eq_prod] using
      (volume_measurePreserving_sumPiEquivProdPi
        (fun _ : I ⊕ (I ⊕ Fin 1) => ℝ))
  have h2b : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (I → ℝ))
        (MeasurableEquiv.sumPiEquivProdPi
          (fun _ : I ⊕ Fin 1 => ℝ)))
      ((volume : Measure (I → ℝ)).prod
        (volume : Measure (I ⊕ Fin 1 → ℝ)))
      ((volume : Measure (I → ℝ)).prod
        ((volume : Measure (I → ℝ)).prod
          (volume : Measure (Fin 1 → ℝ)))) := by
    convert ((MeasurePreserving.id (volume : Measure (I → ℝ))).prod
      (volume_measurePreserving_sumPiEquivProdPi
        (fun _ : I ⊕ Fin 1 => ℝ))) using 1
    · funext q
      rfl
  have h2 : MeasurePreserving e2
      (volume : Measure (I ⊕ (I ⊕ Fin 1) → ℝ))
      ((volume : Measure (I → ℝ)).prod
        ((volume : Measure (I → ℝ)).prod
          (volume : Measure (Fin 1 → ℝ)))) := by
    convert h2b.comp h2a using 1
    funext q
    rfl
  have h3a : MeasurePreserving (MeasurableEquiv.toLp 2 (I → ℝ))
      (volume : Measure (I → ℝ)) (volume : Measure (TransverseSpace 2)) := by
    change MeasurePreserving (WithLp.toLp 2) volume volume
    exact PiLp.volume_preserving_toLp I
  have h3b : MeasurePreserving (MeasurableEquiv.piUnique (fun _ : Fin 1 => ℝ))
      (volume : Measure (Fin 1 → ℝ)) (volume : Measure ℝ) := by
    simpa using (volume_preserving_piUnique (fun _ : Fin 1 => ℝ))
  have h3 : MeasurePreserving e3
      ((volume : Measure (I → ℝ)).prod
        ((volume : Measure (I → ℝ)).prod
          (volume : Measure (Fin 1 → ℝ))))
      ((volume : Measure (TransverseSpace 2)).prod
        ((volume : Measure (TransverseSpace 2)).prod volume)) := by
    convert h3a.prod (h3a.prod h3b) using 1
    funext q
    rfl
  have h4 : MeasurePreserving e4
      ((volume : Measure (TransverseSpace 2)).prod
        ((volume : Measure (TransverseSpace 2)).prod volume))
      (((volume : Measure (TransverseSpace 2)).prod
        (volume : Measure (TransverseSpace 2))).prod volume) := by
    simpa only [e4] using
      (measurePreserving_prodAssoc
        (volume : Measure (TransverseSpace 2))
        (volume : Measure (TransverseSpace 2))
        (volume : Measure ℝ)).symm
  change MeasurePreserving (((e0.trans e1).trans e2).trans (e3.trans e4))
    (volume : Measure ModelE5)
    (((volume : Measure (TransverseSpace 2)).prod
      (volume : Measure (TransverseSpace 2))).prod volume)
  convert (h0.trans h1).trans ((h2.trans h3).trans h4) using 1
  funext q
  rfl

/-- Transport an integral in the five model variables to the two passive
cube coordinates and the remaining translation coordinate. -/
theorem integral_modelFirstPassiveCoordinates
    (G : (TransverseSpace 2 × TransverseSpace 2) × ℝ → ℝ) :
    ∫ z : ModelE5,
      G (modelFirstPassivePair (z 0) (z 1) (z 2) (z 3), z 4) =
      ∫ q : (TransverseSpace 2 × TransverseSpace 2) × ℝ, G q
        ∂(((volume : Measure (TransverseSpace 2)).prod
          (volume : Measure (TransverseSpace 2))).prod volume) := by
  convert modelFirstPassiveCoordinates_measurePreserving.integral_comp' G using 1
  apply integral_congr_ae
  filter_upwards [] with z
  rw [modelFirstPassiveCoordinates_apply]

/-- Integrability is invariant under the model/passive coordinate transport. -/
theorem integrable_modelFirstPassiveCoordinates_iff
    (G : (TransverseSpace 2 × TransverseSpace 2) × ℝ → ℝ)
    (hG : AEStronglyMeasurable G
      (((volume : Measure (TransverseSpace 2)).prod
        (volume : Measure (TransverseSpace 2))).prod volume)) :
    Integrable (fun z : ModelE5 ↦
      G (modelFirstPassivePair (z 0) (z 1) (z 2) (z 3), z 4)) ↔
      Integrable G
        (((volume : Measure (TransverseSpace 2)).prod
          (volume : Measure (TransverseSpace 2))).prod volume) := by
  have hcomp : (fun z : ModelE5 ↦
      G (modelFirstPassivePair (z 0) (z 1) (z 2) (z 3), z 4)) =
      G ∘ modelFirstPassiveCoordinates := by
    funext z
    change G (modelFirstPassivePair (z 0) (z 1) (z 2) (z 3), z 4) =
      G (modelFirstPassiveCoordinates z)
    rw [modelFirstPassiveCoordinates_apply]
  rw [hcomp]
  exact modelFirstPassiveCoordinates_measurePreserving.integrable_comp hG

/-- The transported integral has the Fubini order used in the local-energy
comparison, provided the real-valued integrand is integrable. -/
theorem integral_modelFirstPassiveCoordinates_fubini
    (G : (TransverseSpace 2 × TransverseSpace 2) × ℝ → ℝ)
    (hG : Integrable G
      (((volume : Measure (TransverseSpace 2)).prod
        (volume : Measure (TransverseSpace 2))).prod volume)) :
    ∫ z : ModelE5,
      G (modelFirstPassivePair (z 0) (z 1) (z 2) (z 3), z 4) =
      ∫ y : TransverseSpace 2 × TransverseSpace 2,
        ∫ r : ℝ, G (y, r) := by
  rw [integral_modelFirstPassiveCoordinates]
  exact MeasureTheory.integral_prod G hG

/-- Reading the inverse transport back into passive coordinates recovers the
given transverse pair. -/
@[simp] theorem modelFirstPassiveCoordinates_symm_passive
    (y : TransverseSpace 2 × TransverseSpace 2) (r : ℝ) :
    modelFirstPassivePair
      ((modelFirstPassiveCoordinates.symm (y, r)) 0)
      ((modelFirstPassiveCoordinates.symm (y, r)) 1)
      ((modelFirstPassiveCoordinates.symm (y, r)) 2)
      ((modelFirstPassiveCoordinates.symm (y, r)) 3) = y := by
  have h := modelFirstPassiveCoordinates_apply
    (modelFirstPassiveCoordinates.symm (y, r))
  rw [modelFirstPassiveCoordinates.apply_symm_apply] at h
  exact (congrArg Prod.fst h).symm

/-- The remaining coordinate of the inverse transport is the prescribed
translation parameter. -/
@[simp] theorem modelFirstPassiveCoordinates_symm_translation
    (y : TransverseSpace 2 × TransverseSpace 2) (r : ℝ) :
    (modelFirstPassiveCoordinates.symm (y, r)) 4 = r := by
  have h := modelFirstPassiveCoordinates_apply
    (modelFirstPassiveCoordinates.symm (y, r))
  rw [modelFirstPassiveCoordinates.apply_symm_apply] at h
  exact (congrArg Prod.snd h).symm

/-- Under the inverse passive transport, the first model fiber is precisely
the third-active cube average for the first-energy tuple. -/
theorem modelFirstFiber_symm_eq_cubeActiveCSAverage
    (α : Anisotropy) (lam : ℝ) (f : ModelRealInput) (b : Bool)
    (p : E3) (t : ℝ)
    (q : (TransverseSpace 2 × TransverseSpace 2) × ℝ) :
    modelFirstFiber α f p t (modelFirstPassiveCoordinates.symm q) =
      cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) b
        ((p, t), q.1) := by
  have h := cubeActiveCSAverage_modelFirst α lam f b p t
    (modelFirstPassiveCoordinates.symm q)
  rw [modelFirstPassiveCoordinates_symm_passive q.1 q.2] at h
  exact h.symm

/-- A reusable fixed-parameter transport of the first-energy square from
the five model coordinates to passive cube coordinates. -/
theorem integral_modelFirstFiber_sq_transport
    (α : Anisotropy) (lam : ℝ) (f : ModelRealInput) (b : Bool)
    (p : E3) (t : ℝ)
    (W : (TransverseSpace 2 × TransverseSpace 2) × ℝ → ℝ) :
    ∫ z : ModelE5,
      (modelFirstFiber α f p t z) ^ 2 *
        W (modelFirstPassivePair (z 0) (z 1) (z 2) (z 3), z 4) =
      ∫ q : (TransverseSpace 2 × TransverseSpace 2) × ℝ,
        (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) b
          ((p, t), q.1)) ^ 2 * W q
        ∂(((volume : Measure (TransverseSpace 2)).prod
          (volume : Measure (TransverseSpace 2))).prod volume) := by
  let G : (TransverseSpace 2 × TransverseSpace 2) × ℝ → ℝ := fun q ↦
    (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) b
      ((p, t), q.1)) ^ 2 * W q
  calc
    ∫ z : ModelE5,
        (modelFirstFiber α f p t z) ^ 2 *
          W (modelFirstPassivePair (z 0) (z 1) (z 2) (z 3), z 4) =
        ∫ z : ModelE5, G (modelFirstPassiveCoordinates z) := by
          apply integral_congr_ae
          filter_upwards [] with z
          simp only [G, modelFirstPassiveCoordinates_apply]
          rw [cubeActiveCSAverage_modelFirst]
    _ = ∫ q : (TransverseSpace 2 × TransverseSpace 2) × ℝ, G q
        ∂(((volume : Measure (TransverseSpace 2)).prod
          (volume : Measure (TransverseSpace 2))).prod volume) :=
      modelFirstPassiveCoordinates_measurePreserving.integral_comp' G
    _ = _ := by rfl

/-- Keep an arbitrary outer parameter while transporting the five model
coordinates to passive cube coordinates. -/
noncomputable def modelFirstPassiveCoordinatesProd
    (X : Type*) [MeasurableSpace X] :
    X × ModelE5 ≃ᵐ X × ((TransverseSpace 2 × TransverseSpace 2) × ℝ) :=
  MeasurableEquiv.prodCongr (MeasurableEquiv.refl X)
    modelFirstPassiveCoordinates

@[simp] theorem modelFirstPassiveCoordinatesProd_apply
    {X : Type*} [MeasurableSpace X] (x : X) (z : ModelE5) :
    modelFirstPassiveCoordinatesProd X (x, z) =
      (x, (modelFirstPassivePair (z 0) (z 1) (z 2) (z 3), z 4)) := by
  change (x, modelFirstPassiveCoordinates z) =
    (x, (modelFirstPassivePair (z 0) (z 1) (z 2) (z 3), z 4))
  rw [modelFirstPassiveCoordinates_apply]

/-- The passive-coordinate transport remains measure preserving after adding
any sigma-finite outer parameter measure. -/
theorem modelFirstPassiveCoordinatesProd_measurePreserving
    {X : Type*} [MeasurableSpace X] (μ : Measure X) [SFinite μ] :
    MeasurePreserving (modelFirstPassiveCoordinatesProd X)
      (μ.prod (volume : Measure ModelE5))
      (μ.prod (((volume : Measure (TransverseSpace 2)).prod
        (volume : Measure (TransverseSpace 2))).prod volume)) := by
  convert (MeasurePreserving.id μ).prod
    modelFirstPassiveCoordinates_measurePreserving using 1
  funext q
  rfl

/-- Joint integral transport with an arbitrary outer parameter. -/
theorem integral_modelFirstPassiveCoordinatesProd
    {X : Type*} [MeasurableSpace X] (μ : Measure X) [SFinite μ]
    (G : X × ((TransverseSpace 2 × TransverseSpace 2) × ℝ) → ℝ) :
    ∫ q : X × ModelE5,
      G (q.1, (modelFirstPassivePair (q.2 0) (q.2 1) (q.2 2) (q.2 3), q.2 4))
      ∂(μ.prod (volume : Measure ModelE5)) =
      ∫ w : X × ((TransverseSpace 2 × TransverseSpace 2) × ℝ), G w
      ∂(μ.prod (((volume : Measure (TransverseSpace 2)).prod
        (volume : Measure (TransverseSpace 2))).prod volume)) := by
  convert (modelFirstPassiveCoordinatesProd_measurePreserving μ).integral_comp' G
    using 1
  apply integral_congr_ae
  filter_upwards [] with q
  rw [modelFirstPassiveCoordinatesProd_apply]

/-- At fixed center and scale, the first-energy fiber square times its four
passive Gaussian factors is exactly the active-pair local cube integral,
expressed after the passive-coordinate transport. -/
theorem modelFirstFiber_sq_passiveWeight_eq_activeIntegral
    (α : Anisotropy) (lam : ℝ) (f : ModelRealInput)
    (p : E3) (t : ℝ) (z : ModelE5) :
    (modelFirstFiber α f p t z) ^ 2 *
      modelFirstPassiveGaussianWeight α lam p t
        (z 0) (z 1) (z 2) (z 3) =
      ∫ vw : ℝ × ℝ,
        cubeSignedInputProduct (modelFirstCubeTuple f)
          ((cubeActivePassiveSplit 2).symm
            ((vw.1, vw.2), (modelFirstPassiveCoordinates z).1)) *
          localCubeKernel α 2 lam 0 t p
            ((cubeActivePassiveSplit 2).symm
              ((vw.1, vw.2), (modelFirstPassiveCoordinates z).1)) := by
  rw [modelFirstPassiveCoordinates_apply]
  exact (integral_localCubeIntegrand_modelFirst_active α lam f p t z).symm

/-- The analogous fixed-parameter identity for the second energy: the
remaining model coordinate becomes the translated third-coordinate kernel
parameter of the edge cube form. -/
theorem modelSecondFiber_sq_passiveWeight_eq_activeIntegral
    (α : Anisotropy) (lam : ℝ) (f : E3 → ℝ)
    (p : E3) (t : ℝ) (z : ModelE5) :
    (modelSecondFiber α f p t z) ^ 2 *
      modelFirstPassiveGaussianWeight α lam p t
        (z 0) (z 1) (z 2) (z 3) =
      ∫ vw : ℝ × ℝ,
        cubeSignedInputProduct (edgeCubeTuple f)
          ((cubeActivePassiveSplit 2).symm
            ((vw.1, vw.2), (modelFirstPassiveCoordinates z).1)) *
          localCubeKernel α 2 lam (modelFirstPassiveCoordinates z).2 t p
            ((cubeActivePassiveSplit 2).symm
              ((vw.1, vw.2), (modelFirstPassiveCoordinates z).1)) := by
  rw [modelFirstPassiveCoordinates_apply]
  exact (integral_localCubeIntegrand_modelSecond_active α lam f p t z).symm

/-- Multiply the first density superposition by the nonnegative first-fiber
square. This is the pointwise starting point for the first local-energy
cube comparison. -/
theorem modelFirstFiber_sq_density_le_superposition :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (α : Anisotropy) (u p : E3) (t : ℝ)
      (f : ModelRealInput) (z : ModelE5), 0 < t →
      (modelFirstFiber α f p t z) ^ 2 * modelEnergyDensity α u p t z ≤
        C * sourceWeight u ^ 50 * (modelFirstFiber α f p t z) ^ 2 *
          |conePsiPhysicalReal (z 4 + u 2)| *
          ∫ lam in Set.Ici (1 : ℝ),
            modelFirstPassiveGaussianWeight α lam p t
              (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ) := by
  rcases modelEnergyDensity_le_superposition with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro α u p t f z ht
  have hsq : 0 ≤ (modelFirstFiber α f p t z) ^ 2 := sq_nonneg _
  have h := hbound α u p t z ht
  calc
    (modelFirstFiber α f p t z) ^ 2 * modelEnergyDensity α u p t z ≤
        (modelFirstFiber α f p t z) ^ 2 *
          (C * sourceWeight u ^ 50 * |conePsiPhysicalReal (z 4 + u 2)| *
            ∫ lam in Set.Ici (1 : ℝ),
              modelFirstPassiveGaussianWeight α lam p t
                (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ)) :=
      mul_le_mul_of_nonneg_left h hsq
    _ = C * sourceWeight u ^ 50 * (modelFirstFiber α f p t z) ^ 2 *
          |conePsiPhysicalReal (z 4 + u 2)| *
          ∫ lam in Set.Ici (1 : ℝ),
            modelFirstPassiveGaussianWeight α lam p t
              (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ) := by ring

/-- The corresponding pointwise superposition bound for the second-energy
fiber square, including the translated-annular decay weight. -/
theorem modelSecondFiber_sq_density_le_superposition :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (α : Anisotropy) (u p : E3) (t : ℝ)
      (f : E3 → ℝ) (z : ModelE5), 0 < t →
      (modelSecondFiber α f p t z) ^ 2 * modelEnergyDensity α u p t z ≤
        C * sourceWeight u ^ 100 * (modelSecondFiber α f p t z) ^ 2 *
          translationWeight (z 4) ^ (-50 : ℝ) *
          ∫ lam in Set.Ici (1 : ℝ),
            modelFirstPassiveGaussianWeight α lam p t
              (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ) := by
  rcases modelEnergyDensity_le_second_superposition with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro α u p t f z ht
  have hsq : 0 ≤ (modelSecondFiber α f p t z) ^ 2 := sq_nonneg _
  have h := hbound α u p t z ht
  calc
    (modelSecondFiber α f p t z) ^ 2 * modelEnergyDensity α u p t z ≤
        (modelSecondFiber α f p t z) ^ 2 *
          (C * sourceWeight u ^ 100 * translationWeight (z 4) ^ (-50 : ℝ) *
            ∫ lam in Set.Ici (1 : ℝ),
              modelFirstPassiveGaussianWeight α lam p t
                (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ)) :=
      mul_le_mul_of_nonneg_left h hsq
    _ = C * sourceWeight u ^ 100 * (modelSecondFiber α f p t z) ^ 2 *
          translationWeight (z 4) ^ (-50 : ℝ) *
          ∫ lam in Set.Ici (1 : ℝ),
            modelFirstPassiveGaussianWeight α lam p t
              (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ) := by ring

/-- Separate the remaining translated annular variable from a passive
integral. The statement is deliberately measure-explicit so it can be used
inside the center--scale product measure without reassociation. -/
theorem integral_passive_mul_absConePsi
    (A : TransverseSpace 2 × TransverseSpace 2 → ℝ) (a : ℝ) :
    ∫ q : (TransverseSpace 2 × TransverseSpace 2) × ℝ,
      A q.1 * |conePsiPhysicalReal (q.2 + a)|
      ∂(((volume : Measure (TransverseSpace 2)).prod
        (volume : Measure (TransverseSpace 2))).prod volume) =
      (∫ y : TransverseSpace 2 × TransverseSpace 2, A y
        ∂((volume : Measure (TransverseSpace 2)).prod volume)) *
        conePsiPhysicalRealL1 := by
  calc
    ∫ q : (TransverseSpace 2 × TransverseSpace 2) × ℝ,
        A q.1 * |conePsiPhysicalReal (q.2 + a)|
        ∂(((volume : Measure (TransverseSpace 2)).prod
          (volume : Measure (TransverseSpace 2))).prod volume) =
        (∫ y : TransverseSpace 2 × TransverseSpace 2, A y
          ∂((volume : Measure (TransverseSpace 2)).prod volume)) *
          ∫ r : ℝ, |conePsiPhysicalReal (r + a)| := by
            exact MeasureTheory.integral_prod_mul A
              (fun r : ℝ ↦ |conePsiPhysicalReal (r + a)|)
    _ = _ := by rw [integral_abs_conePsiPhysicalReal_add]

/-- At one fixed center and positive scale, integrating the first fiber
square, the four passive Gaussian factors, and the annular factor over the
five model variables gives the passive cube square times the fixed annular
mass. This is the exact analytic core of the first-energy comparison before
the source-scale superposition is integrated. -/
theorem integral_modelFirstFiber_sq_psi_passiveWeight
    (α : Anisotropy) (lam : ℝ) (f : ModelRealInput) (b : Bool)
    (p : E3) (t a : ℝ) :
    ∫ z : ModelE5,
      (modelFirstFiber α f p t z) ^ 2 *
        |conePsiPhysicalReal (z 4 + a)| *
        modelFirstPassiveGaussianWeight α lam p t
          (z 0) (z 1) (z 2) (z 3) =
      (∫ y : TransverseSpace 2 × TransverseSpace 2,
        cubePassiveGaussianKernel α 2 lam 0 t p y *
          (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) b
            ((p, t), y)) ^ 2
        ∂((volume : Measure (TransverseSpace 2)).prod volume)) *
        conePsiPhysicalRealL1 := by
  let A : TransverseSpace 2 × TransverseSpace 2 → ℝ := fun y ↦
    cubePassiveGaussianKernel α 2 lam 0 t p y *
      (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) b
        ((p, t), y)) ^ 2
  let G : (TransverseSpace 2 × TransverseSpace 2) × ℝ → ℝ := fun q ↦
    A q.1 * |conePsiPhysicalReal (q.2 + a)|
  calc
    ∫ z : ModelE5,
        (modelFirstFiber α f p t z) ^ 2 *
          |conePsiPhysicalReal (z 4 + a)| *
          modelFirstPassiveGaussianWeight α lam p t
            (z 0) (z 1) (z 2) (z 3) =
        ∫ z : ModelE5, G (modelFirstPassiveCoordinates z) := by
          apply integral_congr_ae
          filter_upwards [] with z
          dsimp only [G, A]
          rw [modelFirstPassiveCoordinates_apply,
            cubeActiveCSAverage_modelFirst,
            cubePassiveGaussianKernel_modelFirst]
          ring
    _ = ∫ q : (TransverseSpace 2 × TransverseSpace 2) × ℝ, G q
        ∂(((volume : Measure (TransverseSpace 2)).prod
          (volume : Measure (TransverseSpace 2))).prod volume) :=
      modelFirstPassiveCoordinates_measurePreserving.integral_comp' G
    _ = _ := integral_passive_mul_absConePsi A a

/-- The fixed-source-scale passive square is the actual third-coordinate
local cube form for the first-energy tuple. This uses positivity of the
collection scales to replace the weighted average square by the passive
Gaussian factor times the active average square. -/
theorem localCubeForm_modelFirst_eq_passiveSquare
    (α : Anisotropy) (S : BoxCollection α) (lam : ℝ)
    (f : ModelRealInput) (b : Bool)
    (hFcont : ∀ j, Continuous (modelFirstCubeTuple f j))
    (hFbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |modelFirstCubeTuple f j y| ≤ B)
    (hlam : 1 ≤ lam) :
    localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) =
      ∫ w : (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2),
        cubePassiveGaussianKernel α 2 lam 0 w.1.2 w.1.1 w.2 *
          (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) b w) ^ 2
        ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
          ((volume : Measure (TransverseSpace 2)).prod volume)) := by
  have hcopy := localCubeForm_coordinateCopy_eq_weightedSq
    α S 2 lam 0 (modelFirstCubeTuple f) b hFcont hFbound hlam
  rw [modelFirstCubeTuple_coordinateCopy_two] at hcopy
  calc
    localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) =
        ∫ w : (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2),
          (cubeActiveCSWeightedAverage α 2 lam 0 (modelFirstCubeTuple f) b w) ^ 2
          ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
            ((volume : Measure (TransverseSpace 2)).prod volume)) := hcopy
    _ = _ := by
      apply integral_congr_ae
      have hpos : ∀ᵐ w ∂((cubeScaleMeasure.restrict
          (collectionRegion α S)).prod
          ((volume : Measure (TransverseSpace 2)).prod
            (volume : Measure (TransverseSpace 2)))), 0 < w.1.2 := by
        simpa only using ae_pos_scale_cubePassiveMeasure α S 2
      filter_upwards [hpos] with w hw
      exact cubeActiveCSWeightedAverage_sq_of_pos
        α 2 lam 0 (modelFirstCubeTuple f) b w hlam hw

/-- The nonnegative three-variable integrand obtained after inserting the
first-energy Gaussian superposition. Keeping it as a function on the
literal product `ModelE5 × ℝ` makes the Tonelli/Fubini hypothesis in the
next comparison completely explicit. -/
noncomputable def modelFirstSuperpositionIntegrand
    (α : Anisotropy) (u p : E3) (t : ℝ) (f : ModelRealInput)
    (q : ModelE5 × ℝ) : ℝ :=
  (modelFirstFiber α f p t q.1) ^ 2 *
    |conePsiPhysicalReal (q.1 4 + u 2)| *
    modelFirstPassiveGaussianWeight α q.2 p t
      (q.1 0) (q.1 1) (q.1 2) (q.1 3) * q.2 ^ (-47 : ℝ)

/-- At a fixed center and scale, the first-energy superposition integrand
can be integrated in the source scale first. -/
theorem integral_modelFirstSuperposition_inner
    (α : Anisotropy) (u p : E3) (t : ℝ) (f : ModelRealInput)
    (z : ModelE5) :
    (∫ lam in Set.Ici (1 : ℝ),
      modelFirstSuperpositionIntegrand α u p t f (z, lam)) =
      (modelFirstFiber α f p t z) ^ 2 *
        |conePsiPhysicalReal (z 4 + u 2)| *
        ∫ lam in Set.Ici (1 : ℝ),
          modelFirstPassiveGaussianWeight α lam p t
            (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ) := by
  rw [← MeasureTheory.integral_const_mul]
  apply integral_congr_ae
  filter_upwards [] with lam
  dsimp only [modelFirstSuperpositionIntegrand]
  ring

/-- Fubini and the passive-coordinate transport identify the fixed
center--scale first-energy superposition with the passive square of the
first cube tuple. The sole integrability hypothesis is exactly the one
needed to justify the signed-real Fubini exchange. -/
theorem integral_modelFirstSuperposition_eq_cubePassive
    (α : Anisotropy) (u p : E3) (t : ℝ) (f : ModelRealInput) (b : Bool)
    (hG : Integrable (modelFirstSuperpositionIntegrand α u p t f)
      ((volume : Measure ModelE5).prod
        ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))))) :
    ∫ z : ModelE5,
      (modelFirstFiber α f p t z) ^ 2 *
        |conePsiPhysicalReal (z 4 + u 2)| *
        ∫ lam in Set.Ici (1 : ℝ),
          modelFirstPassiveGaussianWeight α lam p t
            (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ) =
      ∫ lam in Set.Ici (1 : ℝ),
        ((∫ y : TransverseSpace 2 × TransverseSpace 2,
          cubePassiveGaussianKernel α 2 lam 0 t p y *
            (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) b
              ((p, t), y)) ^ 2
          ∂((volume : Measure (TransverseSpace 2)).prod volume)) *
          conePsiPhysicalRealL1) * lam ^ (-47 : ℝ) := by
  calc
    ∫ z : ModelE5,
        (modelFirstFiber α f p t z) ^ 2 *
          |conePsiPhysicalReal (z 4 + u 2)| *
          ∫ lam in Set.Ici (1 : ℝ),
            modelFirstPassiveGaussianWeight α lam p t
              (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ) =
        ∫ z : ModelE5, ∫ lam in Set.Ici (1 : ℝ),
          modelFirstSuperpositionIntegrand α u p t f (z, lam) := by
            apply integral_congr_ae
            filter_upwards [] with z
            rw [integral_modelFirstSuperposition_inner]
    _ = ∫ lam in Set.Ici (1 : ℝ), ∫ z : ModelE5,
        modelFirstSuperpositionIntegrand α u p t f (z, lam) := by
          exact MeasureTheory.integral_integral_swap hG
    _ = ∫ lam in Set.Ici (1 : ℝ),
        ((∫ y : TransverseSpace 2 × TransverseSpace 2,
          cubePassiveGaussianKernel α 2 lam 0 t p y *
            (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) b
              ((p, t), y)) ^ 2
          ∂((volume : Measure (TransverseSpace 2)).prod volume)) *
          conePsiPhysicalRealL1) * lam ^ (-47 : ℝ) := by
            apply integral_congr_ae
            filter_upwards [] with lam
            calc
              ∫ z : ModelE5,
                  modelFirstSuperpositionIntegrand α u p t f (z, lam) =
                  (∫ z : ModelE5,
                    (modelFirstFiber α f p t z) ^ 2 *
                      |conePsiPhysicalReal (z 4 + u 2)| *
                      modelFirstPassiveGaussianWeight α lam p t
                        (z 0) (z 1) (z 2) (z 3)) * lam ^ (-47 : ℝ) := by
                    rw [← MeasureTheory.integral_mul_const]
                    apply integral_congr_ae
                    filter_upwards [] with z
                    dsimp only [modelFirstSuperpositionIntegrand]
              _ = _ := by
                rw [integral_modelFirstFiber_sq_psi_passiveWeight
                  α lam f b p t (u 2)]

/-- The fixed-center, fixed-scale first-energy comparison. It is the
literal inequality in the blueprint before the center--scale integration:
the density superposition is combined with the exact passive-coordinate
Fubini identity above. The two stated integrability hypotheses are precisely
what permits use of real-valued monotonicity and Fubini, without treating a
possibly nonintegrable signed integral as a nonnegative extended integral. -/
theorem integral_modelFirstFiber_sq_density_le_cubePassive :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (α : Anisotropy) (u p : E3) (t : ℝ)
      (f : ModelRealInput) (b : Bool), 0 < t →
      Integrable (fun z : ModelE5 ↦
        (modelFirstFiber α f p t z) ^ 2 * modelEnergyDensity α u p t z) →
      Integrable (modelFirstSuperpositionIntegrand α u p t f)
        ((volume : Measure ModelE5).prod
          ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) →
      (∫ z : ModelE5,
        (modelFirstFiber α f p t z) ^ 2 * modelEnergyDensity α u p t z) ≤
        C * sourceWeight u ^ 50 *
          ∫ lam in Set.Ici (1 : ℝ),
            ((∫ y : TransverseSpace 2 × TransverseSpace 2,
              cubePassiveGaussianKernel α 2 lam 0 t p y *
                (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) b
                  ((p, t), y)) ^ 2
              ∂((volume : Measure (TransverseSpace 2)).prod volume)) *
              conePsiPhysicalRealL1) * lam ^ (-47 : ℝ) := by
  rcases modelFirstFiber_sq_density_le_superposition with
    ⟨C, hC, hpoint⟩
  refine ⟨C, hC, ?_⟩
  intro α u p t f b ht henergy hsuper
  have hinner : Integrable (fun z : ModelE5 ↦
      ∫ lam in Set.Ici (1 : ℝ),
        modelFirstSuperpositionIntegrand α u p t f (z, lam)) := by
    exact hsuper.integral_prod_left
  have hmajor : Integrable (fun z : ModelE5 ↦
      C * sourceWeight u ^ 50 *
        ((modelFirstFiber α f p t z) ^ 2 *
          |conePsiPhysicalReal (z 4 + u 2)| *
          ∫ lam in Set.Ici (1 : ℝ),
            modelFirstPassiveGaussianWeight α lam p t
              (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ))) := by
    simpa only [integral_modelFirstSuperposition_inner] using
      hinner.const_mul (C * sourceWeight u ^ 50)
  have hmono : ∀ z : ModelE5,
      (modelFirstFiber α f p t z) ^ 2 * modelEnergyDensity α u p t z ≤
        C * sourceWeight u ^ 50 *
          ((modelFirstFiber α f p t z) ^ 2 *
            |conePsiPhysicalReal (z 4 + u 2)| *
            ∫ lam in Set.Ici (1 : ℝ),
              modelFirstPassiveGaussianWeight α lam p t
                (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ)) := by
    intro z
    have h := hpoint α u p t f z ht
    convert h using 1 ; ring
  calc
    ∫ z : ModelE5,
        (modelFirstFiber α f p t z) ^ 2 * modelEnergyDensity α u p t z ≤
        ∫ z : ModelE5,
          C * sourceWeight u ^ 50 *
            ((modelFirstFiber α f p t z) ^ 2 *
              |conePsiPhysicalReal (z 4 + u 2)| *
              ∫ lam in Set.Ici (1 : ℝ),
                modelFirstPassiveGaussianWeight α lam p t
                  (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ)) :=
      MeasureTheory.integral_mono henergy hmajor hmono
    _ = C * sourceWeight u ^ 50 *
        (∫ z : ModelE5,
          (modelFirstFiber α f p t z) ^ 2 *
            |conePsiPhysicalReal (z 4 + u 2)| *
            ∫ lam in Set.Ici (1 : ℝ),
              modelFirstPassiveGaussianWeight α lam p t
                (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ)) := by
      rw [MeasureTheory.integral_const_mul]
    _ = C * sourceWeight u ^ 50 *
        ∫ lam in Set.Ici (1 : ℝ),
          ((∫ y : TransverseSpace 2 × TransverseSpace 2,
            cubePassiveGaussianKernel α 2 lam 0 t p y *
              (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) b
                ((p, t), y)) ^ 2
            ∂((volume : Measure (TransverseSpace 2)).prod volume)) *
            conePsiPhysicalRealL1) * lam ^ (-47 : ℝ) := by
      rw [integral_modelFirstSuperposition_eq_cubePassive
        α u p t f b hsuper]

/-- The preceding first-energy identity in literal product-integral form.
This is the version used when center--scale variables are added as a further
outer product measure. -/
theorem integral_modelFirstSuperposition_prod_eq_cubePassive
    (α : Anisotropy) (u p : E3) (t : ℝ) (f : ModelRealInput) (b : Bool)
    (hG : Integrable (modelFirstSuperpositionIntegrand α u p t f)
      ((volume : Measure ModelE5).prod
        ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))))) :
    ∫ q : ModelE5 × ℝ,
      modelFirstSuperpositionIntegrand α u p t f q
      ∂((volume : Measure ModelE5).prod
        ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) =
      ∫ lam in Set.Ici (1 : ℝ),
        ((∫ y : TransverseSpace 2 × TransverseSpace 2,
          cubePassiveGaussianKernel α 2 lam 0 t p y *
            (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) b
              ((p, t), y)) ^ 2
          ∂((volume : Measure (TransverseSpace 2)).prod volume)) *
          conePsiPhysicalRealL1) * lam ^ (-47 : ℝ) := by
  calc
    ∫ q : ModelE5 × ℝ,
        modelFirstSuperpositionIntegrand α u p t f q
        ∂((volume : Measure ModelE5).prod
          ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) =
        ∫ z : ModelE5, ∫ lam in Set.Ici (1 : ℝ),
          modelFirstSuperpositionIntegrand α u p t f (z, lam) :=
      MeasureTheory.integral_prod _ hG
    _ = ∫ z : ModelE5,
        (modelFirstFiber α f p t z) ^ 2 *
          |conePsiPhysicalReal (z 4 + u 2)| *
          ∫ lam in Set.Ici (1 : ℝ),
            modelFirstPassiveGaussianWeight α lam p t
              (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ) := by
            apply integral_congr_ae
            filter_upwards [] with z
            rw [integral_modelFirstSuperposition_inner]
    _ = _ := integral_modelFirstSuperposition_eq_cubePassive
      α u p t f b hG

/-- On the false third-coordinate active slice, the edge tuple retains only
its `000` slot. This is the one-input integrand in the second model fiber. -/
theorem cubeActiveInputSlice_edge_false
    (f : E3 → ℝ) (x₁ x₂ y₁ y₂ v : ℝ) :
    cubeActiveInputSlice 2 false (edgeCubeTuple f)
      (modelFirstPassivePair x₁ x₂ y₁ y₂) v =
      f (modelPoint x₁ x₂ v) := by
  classical
  let j00 : {j : CubeVertex // j 2 = false} :=
    ⟨cubeVertex false false false, by simp⟩
  let j10 : {j : CubeVertex // j 2 = false} :=
    ⟨cubeVertex true false false, by simp⟩
  let j01 : {j : CubeVertex // j 2 = false} :=
    ⟨cubeVertex false true false, by simp⟩
  let j11 : {j : CubeVertex // j 2 = false} :=
    ⟨cubeVertex true true false, by simp⟩
  have huniv : (Finset.univ : Finset {j : CubeVertex // j 2 = false}) =
      {j00, j10, j01, j11} := by
    ext j
    simp only [Finset.mem_univ, Finset.mem_insert, Finset.mem_singleton]
    rcases j with ⟨j, hj⟩
    have hrepr : j = cubeVertex (j 0) (j 1) false := by
      funext k
      fin_cases k
      · simp [cubeVertex]
      · simp [cubeVertex]
      · simpa [cubeVertex] using hj
    constructor
    · intro _
      cases h0 : j 0 <;> cases h1 : j 1
      · left
        simpa [j00, h0, h1] using hrepr
      · right; right; left
        simpa [j01, h0, h1] using hrepr
      · right; left
        simpa [j10, h0, h1] using hrepr
      · right; right; right
        simpa [j11, h0, h1] using hrepr
    · intro _
      trivial
  unfold cubeActiveInputSlice
  rw [huniv]
  have h00_10 : j00 ≠ j10 := by
    intro h
    have h' := congrArg (fun q : {j : CubeVertex // j 2 = false} ↦ q.1 0) h
    simp [j00, j10] at h'
  have h00_01 : j00 ≠ j01 := by
    intro h
    have h' := congrArg (fun q : {j : CubeVertex // j 2 = false} ↦ q.1 1) h
    simp [j00, j01] at h'
  have h00_11 : j00 ≠ j11 := by
    intro h
    have h' := congrArg (fun q : {j : CubeVertex // j 2 = false} ↦ q.1 0) h
    simp [j00, j11] at h'
  have h10_01 : j10 ≠ j01 := by
    intro h
    have h' := congrArg (fun q : {j : CubeVertex // j 2 = false} ↦ q.1 0) h
    simp [j10, j01] at h'
  have h10_11 : j10 ≠ j11 := by
    intro h
    have h' := congrArg (fun q : {j : CubeVertex // j 2 = false} ↦ q.1 1) h
    simp [j10, j11] at h'
  have h01_11 : j01 ≠ j11 := by
    intro h
    have h' := congrArg (fun q : {j : CubeVertex // j 2 = false} ↦ q.1 0) h
    simp [j01, j11] at h'
  have hj00 : j00 ∉ ({j10, j01, j11} : Finset {j : CubeVertex // j 2 = false}) := by
    simp only [Finset.mem_insert, Finset.mem_singleton]
    exact fun h ↦ h.elim h00_10 (fun h ↦ h.elim h00_01 h00_11)
  have hj10 : j10 ∉ ({j01, j11} : Finset {j : CubeVertex // j 2 = false}) := by
    simp only [Finset.mem_insert, Finset.mem_singleton]
    exact fun h ↦ h.elim h10_01 h10_11
  have hj01 : j01 ∉ ({j11} : Finset {j : CubeVertex // j 2 = false}) := by
    simpa only [Finset.mem_singleton] using h01_11
  rw [Finset.prod_insert hj00, Finset.prod_insert hj10,
    Finset.prod_insert hj01, Finset.prod_singleton]
  have hp00 :
      faceInsert 2 v (cubePassiveProjection 2 j00.1
        (modelFirstPassivePair x₁ x₂ y₁ y₂)) =
        modelPoint x₁ x₂ v := by
    ext k
    fin_cases k <;>
      simp [j00, modelFirstPassivePair, cubePassiveProjection,
        faceInsert, cubeVertex, modelPoint]
  rw [hp00]
  simp [edgeCubeTuple, j00, j10, j01, j11, cubeVertex]

/-- The edge tuple is copied in its third coordinate, so the true slice is
the same one-input fiber integrand. -/
theorem cubeActiveInputSlice_edge_true
    (f : E3 → ℝ) (x₁ x₂ y₁ y₂ v : ℝ) :
    cubeActiveInputSlice 2 true (edgeCubeTuple f)
      (modelFirstPassivePair x₁ x₂ y₁ y₂) v =
      f (modelPoint x₁ x₂ v) := by
  calc
    cubeActiveInputSlice 2 true (edgeCubeTuple f)
        (modelFirstPassivePair x₁ x₂ y₁ y₂) v =
        cubeActiveInputSlice 2 false
          (cubeCoordinateCopy 2 true (edgeCubeTuple f))
          (modelFirstPassivePair x₁ x₂ y₁ y₂) v := by
      symm
      exact cubeActiveInputSlice_coordinateCopy 2 false true
        (edgeCubeTuple f) (modelFirstPassivePair x₁ x₂ y₁ y₂) v
    _ = cubeActiveInputSlice 2 false (edgeCubeTuple f)
          (modelFirstPassivePair x₁ x₂ y₁ y₂) v := by
      rw [cubeCoordinateCopy_two_edgeCubeTuple]
    _ = f (modelPoint x₁ x₂ v) :=
      cubeActiveInputSlice_edge_false f x₁ x₂ y₁ y₂ v

/-- Either third-active cube average of the edge tuple is the second model
fiber, with the remaining fifth model coordinate becoming the translation
parameter in the active Gaussian derivative. -/
theorem cubeActiveCSAverage_modelSecond
    (α : Anisotropy) (lam : ℝ) (f : E3 → ℝ) (b : Bool)
    (p : E3) (t : ℝ) (z : ModelE5) :
    cubeActiveCSAverage α 2 lam (z 4) (edgeCubeTuple f) b
      ((p, t), modelFirstPassivePair (z 0) (z 1) (z 2) (z 3)) =
      modelSecondFiber α f p t z := by
  unfold modelSecondFiber cubeActiveCSAverage cubeActiveCSFactor
  apply integral_congr_ae
  filter_upwards [] with v
  cases b
  · rw [cubeActiveInputSlice_edge_false]
    simp [cubeGaussianDerivKernel]
    ring
  · rw [cubeActiveInputSlice_edge_true]
    simp [cubeGaussianDerivKernel]
    ring

/-- Fixed-source-scale passive transport for the second energy. Unlike the
first energy, the fifth model coordinate is retained as the local cube
translation parameter and carries the decaying `R(r)^{-50}` weight. -/
theorem integral_modelSecondFiber_sq_translationWeight_passiveWeight
    (α : Anisotropy) (lam : ℝ) (f : E3 → ℝ) (b : Bool)
    (p : E3) (t : ℝ) :
    ∫ z : ModelE5,
      (modelSecondFiber α f p t z) ^ 2 *
        translationWeight (z 4) ^ (-50 : ℝ) *
        modelFirstPassiveGaussianWeight α lam p t
          (z 0) (z 1) (z 2) (z 3) =
      ∫ q : (TransverseSpace 2 × TransverseSpace 2) × ℝ,
        cubePassiveGaussianKernel α 2 lam q.2 t p q.1 *
          (cubeActiveCSAverage α 2 lam q.2 (edgeCubeTuple f) b
            ((p, t), q.1)) ^ 2 *
          translationWeight q.2 ^ (-50 : ℝ)
        ∂(((volume : Measure (TransverseSpace 2)).prod
          (volume : Measure (TransverseSpace 2))).prod volume) := by
  let G : (TransverseSpace 2 × TransverseSpace 2) × ℝ → ℝ := fun q ↦
    cubePassiveGaussianKernel α 2 lam q.2 t p q.1 *
      (cubeActiveCSAverage α 2 lam q.2 (edgeCubeTuple f) b
        ((p, t), q.1)) ^ 2 *
      translationWeight q.2 ^ (-50 : ℝ)
  calc
    ∫ z : ModelE5,
        (modelSecondFiber α f p t z) ^ 2 *
          translationWeight (z 4) ^ (-50 : ℝ) *
          modelFirstPassiveGaussianWeight α lam p t
            (z 0) (z 1) (z 2) (z 3) =
        ∫ z : ModelE5, G (modelFirstPassiveCoordinates z) := by
          apply integral_congr_ae
          filter_upwards [] with z
          dsimp only [G]
          rw [modelFirstPassiveCoordinates_apply,
            cubeActiveCSAverage_modelSecond,
            cubePassiveGaussianKernel_modelFirst]
          ring
    _ = ∫ q : (TransverseSpace 2 × TransverseSpace 2) × ℝ, G q
        ∂(((volume : Measure (TransverseSpace 2)).prod
          (volume : Measure (TransverseSpace 2))).prod volume) :=
      modelFirstPassiveCoordinates_measurePreserving.integral_comp' G
    _ = _ := by rfl

/-- The third-coordinate edge form is its literal passive Gaussian square.
This is the second-energy analogue of
`localCubeForm_modelFirst_eq_passiveSquare`; coordinate-copy
invariance of the edge tuple removes the apparent copy on the left. -/
theorem localCubeForm_edge_eq_passiveSquare
    (α : Anisotropy) (S : BoxCollection α) (lam r : ℝ)
    (f : E3 → ℝ) (b : Bool)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B)
    (hlam : 1 ≤ lam) :
    localCubeForm α S 2 lam r (edgeCubeTuple f) =
      ∫ w : (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2),
        cubePassiveGaussianKernel α 2 lam r w.1.2 w.1.1 w.2 *
          (cubeActiveCSAverage α 2 lam r (edgeCubeTuple f) b w) ^ 2
        ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
          ((volume : Measure (TransverseSpace 2)).prod volume)) := by
  have hcopy := localCubeForm_coordinateCopy_eq_weightedSq
    α S 2 lam r (edgeCubeTuple f) b
      (continuous_edgeCubeTuple f hfcont)
      (bounded_edgeCubeTuple f hfbound) hlam
  rw [cubeCoordinateCopy_two_edgeCubeTuple] at hcopy
  calc
    localCubeForm α S 2 lam r (edgeCubeTuple f) =
        ∫ w : (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2),
          (cubeActiveCSWeightedAverage α 2 lam r (edgeCubeTuple f) b w) ^ 2
          ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
            ((volume : Measure (TransverseSpace 2)).prod volume)) := hcopy
    _ = _ := by
      apply integral_congr_ae
      have hpos : ∀ᵐ w ∂((cubeScaleMeasure.restrict
          (collectionRegion α S)).prod
          ((volume : Measure (TransverseSpace 2)).prod
            (volume : Measure (TransverseSpace 2)))), 0 < w.1.2 := by
        simpa only using ae_pos_scale_cubePassiveMeasure α S 2
      filter_upwards [hpos] with w hw
      exact cubeActiveCSWeightedAverage_sq_of_pos
        α 2 lam r (edgeCubeTuple f) b w hlam hw

/-- The nonnegative product integrand for the second-energy Gaussian
superposition. Here the fifth model coordinate is not integrated out: it
becomes the edge-form translation `r`. -/
noncomputable def modelSecondSuperpositionIntegrand
    (α : Anisotropy) (p : E3) (t : ℝ) (f : E3 → ℝ)
    (q : ModelE5 × ℝ) : ℝ :=
  (modelSecondFiber α f p t q.1) ^ 2 *
    translationWeight (q.1 4) ^ (-50 : ℝ) *
    modelFirstPassiveGaussianWeight α q.2 p t
      (q.1 0) (q.1 1) (q.1 2) (q.1 3) * q.2 ^ (-47 : ℝ)

/-- At fixed center and scale, integrate the second-energy superposition in
the source-scale variable first. -/
theorem integral_modelSecondSuperposition_inner
    (α : Anisotropy) (p : E3) (t : ℝ) (f : E3 → ℝ)
    (z : ModelE5) :
    (∫ lam in Set.Ici (1 : ℝ),
      modelSecondSuperpositionIntegrand α p t f (z, lam)) =
      (modelSecondFiber α f p t z) ^ 2 *
        translationWeight (z 4) ^ (-50 : ℝ) *
        ∫ lam in Set.Ici (1 : ℝ),
          modelFirstPassiveGaussianWeight α lam p t
            (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ) := by
  rw [← MeasureTheory.integral_const_mul]
  apply integral_congr_ae
  filter_upwards [] with lam
  dsimp only [modelSecondSuperpositionIntegrand]
  ring

/-- Fubini and passive-coordinate transport identify the fixed
center--scale second-energy superposition with the translated edge-cube
passive square. -/
theorem integral_modelSecondSuperposition_eq_cubePassive
    (α : Anisotropy) (p : E3) (t : ℝ) (f : E3 → ℝ) (b : Bool)
    (hG : Integrable (modelSecondSuperpositionIntegrand α p t f)
      ((volume : Measure ModelE5).prod
        ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))))) :
    ∫ z : ModelE5,
      (modelSecondFiber α f p t z) ^ 2 *
        translationWeight (z 4) ^ (-50 : ℝ) *
        ∫ lam in Set.Ici (1 : ℝ),
          modelFirstPassiveGaussianWeight α lam p t
            (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ) =
      ∫ lam in Set.Ici (1 : ℝ),
        (∫ q : (TransverseSpace 2 × TransverseSpace 2) × ℝ,
          cubePassiveGaussianKernel α 2 lam q.2 t p q.1 *
            (cubeActiveCSAverage α 2 lam q.2 (edgeCubeTuple f) b
              ((p, t), q.1)) ^ 2 *
            translationWeight q.2 ^ (-50 : ℝ)
          ∂(((volume : Measure (TransverseSpace 2)).prod
            (volume : Measure (TransverseSpace 2))).prod volume)) *
          lam ^ (-47 : ℝ) := by
  calc
    ∫ z : ModelE5,
        (modelSecondFiber α f p t z) ^ 2 *
          translationWeight (z 4) ^ (-50 : ℝ) *
          ∫ lam in Set.Ici (1 : ℝ),
            modelFirstPassiveGaussianWeight α lam p t
              (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ) =
        ∫ z : ModelE5, ∫ lam in Set.Ici (1 : ℝ),
          modelSecondSuperpositionIntegrand α p t f (z, lam) := by
            apply integral_congr_ae
            filter_upwards [] with z
            rw [integral_modelSecondSuperposition_inner]
    _ = ∫ lam in Set.Ici (1 : ℝ), ∫ z : ModelE5,
        modelSecondSuperpositionIntegrand α p t f (z, lam) := by
          exact MeasureTheory.integral_integral_swap hG
    _ = ∫ lam in Set.Ici (1 : ℝ),
        (∫ q : (TransverseSpace 2 × TransverseSpace 2) × ℝ,
          cubePassiveGaussianKernel α 2 lam q.2 t p q.1 *
            (cubeActiveCSAverage α 2 lam q.2 (edgeCubeTuple f) b
              ((p, t), q.1)) ^ 2 *
            translationWeight q.2 ^ (-50 : ℝ)
          ∂(((volume : Measure (TransverseSpace 2)).prod
            (volume : Measure (TransverseSpace 2))).prod volume)) *
          lam ^ (-47 : ℝ) := by
            apply integral_congr_ae
            filter_upwards [] with lam
            calc
              ∫ z : ModelE5,
                  modelSecondSuperpositionIntegrand α p t f (z, lam) =
                  (∫ z : ModelE5,
                    (modelSecondFiber α f p t z) ^ 2 *
                      translationWeight (z 4) ^ (-50 : ℝ) *
                      modelFirstPassiveGaussianWeight α lam p t
                        (z 0) (z 1) (z 2) (z 3)) * lam ^ (-47 : ℝ) := by
                    rw [← MeasureTheory.integral_mul_const]
                    apply integral_congr_ae
                    filter_upwards [] with z
                    dsimp only [modelSecondSuperpositionIntegrand]
              _ = _ := by
                rw [integral_modelSecondFiber_sq_translationWeight_passiveWeight
                  α lam f b p t]

/-- The fixed-center, fixed-scale second-energy cube comparison, with the
source and translation weights exactly as in the blueprint. -/
theorem integral_modelSecondFiber_sq_density_le_cubePassive :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (α : Anisotropy) (u p : E3) (t : ℝ)
      (f : E3 → ℝ) (b : Bool), 0 < t →
      Integrable (fun z : ModelE5 ↦
        (modelSecondFiber α f p t z) ^ 2 * modelEnergyDensity α u p t z) →
      Integrable (modelSecondSuperpositionIntegrand α p t f)
        ((volume : Measure ModelE5).prod
          ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) →
      (∫ z : ModelE5,
        (modelSecondFiber α f p t z) ^ 2 * modelEnergyDensity α u p t z) ≤
        C * sourceWeight u ^ 100 *
          ∫ lam in Set.Ici (1 : ℝ),
            (∫ q : (TransverseSpace 2 × TransverseSpace 2) × ℝ,
              cubePassiveGaussianKernel α 2 lam q.2 t p q.1 *
                (cubeActiveCSAverage α 2 lam q.2 (edgeCubeTuple f) b
                  ((p, t), q.1)) ^ 2 *
                translationWeight q.2 ^ (-50 : ℝ)
              ∂(((volume : Measure (TransverseSpace 2)).prod
                (volume : Measure (TransverseSpace 2))).prod volume)) *
              lam ^ (-47 : ℝ) := by
  rcases modelSecondFiber_sq_density_le_superposition with
    ⟨C, hC, hpoint⟩
  refine ⟨C, hC, ?_⟩
  intro α u p t f b ht henergy hsuper
  have hinner : Integrable (fun z : ModelE5 ↦
      ∫ lam in Set.Ici (1 : ℝ),
        modelSecondSuperpositionIntegrand α p t f (z, lam)) := by
    exact hsuper.integral_prod_left
  have hmajor : Integrable (fun z : ModelE5 ↦
      C * sourceWeight u ^ 100 *
        ((modelSecondFiber α f p t z) ^ 2 *
          translationWeight (z 4) ^ (-50 : ℝ) *
          ∫ lam in Set.Ici (1 : ℝ),
            modelFirstPassiveGaussianWeight α lam p t
              (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ))) := by
    simpa only [integral_modelSecondSuperposition_inner] using
      hinner.const_mul (C * sourceWeight u ^ 100)
  have hmono : ∀ z : ModelE5,
      (modelSecondFiber α f p t z) ^ 2 * modelEnergyDensity α u p t z ≤
        C * sourceWeight u ^ 100 *
          ((modelSecondFiber α f p t z) ^ 2 *
            translationWeight (z 4) ^ (-50 : ℝ) *
            ∫ lam in Set.Ici (1 : ℝ),
              modelFirstPassiveGaussianWeight α lam p t
                (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ)) := by
    intro z
    have h := hpoint α u p t f z ht
    convert h using 1 ; ring
  calc
    ∫ z : ModelE5,
        (modelSecondFiber α f p t z) ^ 2 * modelEnergyDensity α u p t z ≤
        ∫ z : ModelE5,
          C * sourceWeight u ^ 100 *
            ((modelSecondFiber α f p t z) ^ 2 *
              translationWeight (z 4) ^ (-50 : ℝ) *
              ∫ lam in Set.Ici (1 : ℝ),
                modelFirstPassiveGaussianWeight α lam p t
                  (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ)) :=
      MeasureTheory.integral_mono henergy hmajor hmono
    _ = C * sourceWeight u ^ 100 *
        (∫ z : ModelE5,
          (modelSecondFiber α f p t z) ^ 2 *
            translationWeight (z 4) ^ (-50 : ℝ) *
            ∫ lam in Set.Ici (1 : ℝ),
              modelFirstPassiveGaussianWeight α lam p t
                (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ)) := by
      rw [MeasureTheory.integral_const_mul]
    _ = C * sourceWeight u ^ 100 *
        ∫ lam in Set.Ici (1 : ℝ),
          (∫ q : (TransverseSpace 2 × TransverseSpace 2) × ℝ,
            cubePassiveGaussianKernel α 2 lam q.2 t p q.1 *
              (cubeActiveCSAverage α 2 lam q.2 (edgeCubeTuple f) b
                ((p, t), q.1)) ^ 2 *
              translationWeight q.2 ^ (-50 : ℝ)
            ∂(((volume : Measure (TransverseSpace 2)).prod
              (volume : Measure (TransverseSpace 2))).prod volume)) *
            lam ^ (-47 : ℝ) := by
      rw [integral_modelSecondSuperposition_eq_cubePassive
        α p t f b hsuper]

/-- Product-integral form of the second-energy passive-square identity. -/
theorem integral_modelSecondSuperposition_prod_eq_cubePassive
    (α : Anisotropy) (p : E3) (t : ℝ) (f : E3 → ℝ) (b : Bool)
    (hG : Integrable (modelSecondSuperpositionIntegrand α p t f)
      ((volume : Measure ModelE5).prod
        ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))))) :
    ∫ q : ModelE5 × ℝ,
      modelSecondSuperpositionIntegrand α p t f q
      ∂((volume : Measure ModelE5).prod
        ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) =
      ∫ lam in Set.Ici (1 : ℝ),
        (∫ q : (TransverseSpace 2 × TransverseSpace 2) × ℝ,
          cubePassiveGaussianKernel α 2 lam q.2 t p q.1 *
            (cubeActiveCSAverage α 2 lam q.2 (edgeCubeTuple f) b
              ((p, t), q.1)) ^ 2 *
            translationWeight q.2 ^ (-50 : ℝ)
          ∂(((volume : Measure (TransverseSpace 2)).prod
            (volume : Measure (TransverseSpace 2))).prod volume)) *
          lam ^ (-47 : ℝ) := by
  calc
    ∫ q : ModelE5 × ℝ,
        modelSecondSuperpositionIntegrand α p t f q
        ∂((volume : Measure ModelE5).prod
          ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) =
        ∫ z : ModelE5, ∫ lam in Set.Ici (1 : ℝ),
          modelSecondSuperpositionIntegrand α p t f (z, lam) :=
      MeasureTheory.integral_prod _ hG
    _ = ∫ z : ModelE5,
        (modelSecondFiber α f p t z) ^ 2 *
          translationWeight (z 4) ^ (-50 : ℝ) *
          ∫ lam in Set.Ici (1 : ℝ),
            modelFirstPassiveGaussianWeight α lam p t
              (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ) := by
            apply integral_congr_ae
            filter_upwards [] with z
            rw [integral_modelSecondSuperposition_inner]
    _ = _ := integral_modelSecondSuperposition_eq_cubePassive
      α p t f b hG

/-- Add the center--scale parameter to the first-energy superposition
integrand. -/
noncomputable def modelFirstSuperpositionJoint
    (α : Anisotropy) (u : E3) (f : ModelRealInput)
    (q : (E3 × ℝ) × (ModelE5 × ℝ)) : ℝ :=
  modelFirstSuperpositionIntegrand α u q.1.1 q.1.2 f q.2

/-- Add the center--scale parameter to the second-energy superposition
integrand. -/
noncomputable def modelSecondSuperpositionJoint
    (α : Anisotropy) (f : E3 → ℝ)
    (q : (E3 × ℝ) × (ModelE5 × ℝ)) : ℝ :=
  modelSecondSuperpositionIntegrand α q.1.1 q.1.2 f q.2

/-- Outer Fubini wrapper for the first local energy. Its last hypothesis is
the exact, signed-real center--scale/source-scale exchange after the passive
square has been identified. All other Fubini obligations (in the five model
variables and in the source scale) are discharged from the two displayed
joint integrability assumptions. -/
theorem modelEnergyOne_le_cubeComparison_of_fubini :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (α : Anisotropy) (S : BoxCollection α)
      (u : E3) (f : ModelRealInput) (_b : Bool),
      Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
        (modelFirstFiber α f q.1.1 q.1.2 q.2) ^ 2 *
          modelEnergyDensity α u q.1.1 q.1.2 q.2)
        ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume) →
      Integrable (modelFirstSuperpositionJoint α u f)
        ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
          ((volume : Measure ModelE5).prod
            ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))))) →
      (∫ pt : E3 × ℝ,
        ∫ q : ModelE5 × ℝ,
          modelFirstSuperpositionJoint α u f (pt, q)
          ∂((volume : Measure ModelE5).prod
            ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))))
        ∂(cubeScaleMeasure.restrict (collectionRegion α S))) =
        conePsiPhysicalRealL1 *
          ∫ lam in Set.Ici (1 : ℝ),
            localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
              lam ^ (-47 : ℝ) →
      modelEnergyOne α S u f ≤
        C * sourceWeight u ^ 50 * conePsiPhysicalRealL1 *
          ∫ lam in Set.Ici (1 : ℝ),
            localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
              lam ^ (-47 : ℝ) := by
  rcases integral_modelFirstFiber_sq_density_le_cubePassive with
    ⟨C, hC, hfixed⟩
  refine ⟨C, hC, ?_⟩
  intro α S u f b henergy hsuper houter
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  have henergyFib : ∀ᵐ pt ∂μ, Integrable (fun z : ModelE5 ↦
      (modelFirstFiber α f pt.1 pt.2 z) ^ 2 *
        modelEnergyDensity α u pt.1 pt.2 z) := by
    simpa only [μ] using
      (MeasureTheory.integrable_prod_iff henergy.aestronglyMeasurable).mp henergy |>.1
  have hsuperFib : ∀ᵐ pt ∂μ, Integrable (fun q : ModelE5 × ℝ ↦
      modelFirstSuperpositionIntegrand α u pt.1 pt.2 f q)
      ((volume : Measure ModelE5).prod ν) := by
    simpa only [modelFirstSuperpositionJoint, μ, ν] using
      (MeasureTheory.integrable_prod_iff hsuper.aestronglyMeasurable).mp hsuper |>.1
  have hscale : ∀ᵐ pt ∂μ, 0 < pt.2 := by
    dsimp only [μ]
    filter_upwards [ae_restrict_mem (measurableSet_collectionRegion α S)]
      with pt hpt
    exact pos_of_mem_collectionRegion α S hpt
  have hpoint : ∀ᵐ pt ∂μ,
      (∫ z : ModelE5,
        (modelFirstFiber α f pt.1 pt.2 z) ^ 2 *
          modelEnergyDensity α u pt.1 pt.2 z) ≤
        C * sourceWeight u ^ 50 *
          ∫ q : ModelE5 × ℝ,
            modelFirstSuperpositionIntegrand α u pt.1 pt.2 f q
            ∂((volume : Measure ModelE5).prod ν) := by
    filter_upwards [henergyFib, hsuperFib, hscale] with pt hE hG ht
    have h := hfixed α u pt.1 pt.2 f b ht hE hG
    rw [← integral_modelFirstSuperposition_prod_eq_cubePassive
      α u pt.1 pt.2 f b hG] at h
    exact h
  have henergyOuter : Integrable (fun pt : E3 × ℝ ↦
      ∫ z : ModelE5,
        (modelFirstFiber α f pt.1 pt.2 z) ^ 2 *
          modelEnergyDensity α u pt.1 pt.2 z) μ := by
    simpa only [μ] using henergy.integral_prod_left
  have hsuperOuter : Integrable (fun pt : E3 × ℝ ↦
      ∫ q : ModelE5 × ℝ,
        modelFirstSuperpositionIntegrand α u pt.1 pt.2 f q
        ∂((volume : Measure ModelE5).prod ν)) μ := by
    simpa only [modelFirstSuperpositionJoint, μ, ν] using
      hsuper.integral_prod_left
  have hmajorOuter : Integrable (fun pt : E3 × ℝ ↦
      C * sourceWeight u ^ 50 *
        (∫ q : ModelE5 × ℝ,
          modelFirstSuperpositionIntegrand α u pt.1 pt.2 f q
          ∂((volume : Measure ModelE5).prod ν))) μ := by
    exact hsuperOuter.const_mul (C * sourceWeight u ^ 50)
  change (∫ pt : E3 × ℝ,
      (∫ z : ModelE5,
        (modelFirstFiber α f pt.1 pt.2 z) ^ 2 *
          modelEnergyDensity α u pt.1 pt.2 z)
      ∂μ) ≤ _
  calc
    ∫ pt : E3 × ℝ,
        (∫ z : ModelE5,
          (modelFirstFiber α f pt.1 pt.2 z) ^ 2 *
            modelEnergyDensity α u pt.1 pt.2 z)
        ∂μ ≤
        ∫ pt : E3 × ℝ,
          C * sourceWeight u ^ 50 *
            (∫ q : ModelE5 × ℝ,
              modelFirstSuperpositionIntegrand α u pt.1 pt.2 f q
              ∂((volume : Measure ModelE5).prod ν))
          ∂μ := MeasureTheory.integral_mono_ae henergyOuter hmajorOuter hpoint
    _ = C * sourceWeight u ^ 50 *
        (∫ pt : E3 × ℝ,
          ∫ q : ModelE5 × ℝ,
            modelFirstSuperpositionIntegrand α u pt.1 pt.2 f q
            ∂((volume : Measure ModelE5).prod ν)
          ∂μ) := by
      rw [MeasureTheory.integral_const_mul]
    _ = C * sourceWeight u ^ 50 *
        (conePsiPhysicalRealL1 *
          ∫ lam in Set.Ici (1 : ℝ),
            localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
              lam ^ (-47 : ℝ)) := by
      rw [show (∫ pt : E3 × ℝ,
          ∫ q : ModelE5 × ℝ,
            modelFirstSuperpositionIntegrand α u pt.1 pt.2 f q
            ∂((volume : Measure ModelE5).prod ν)
          ∂μ) =
          conePsiPhysicalRealL1 *
            ∫ lam in Set.Ici (1 : ℝ),
              localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
                lam ^ (-47 : ℝ) by
          simpa only [modelFirstSuperpositionJoint, μ, ν] using houter]
    _ = _ := by ring

/-- Outer Fubini wrapper for the second local energy. The translation
parameter remains explicit, yielding precisely the edge-cube comparison
weighted by `R(r)^{-50}`. -/
theorem modelEnergyTwo_le_cubeComparison_of_fubini :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (α : Anisotropy) (S : BoxCollection α)
      (u : E3) (f : E3 → ℝ) (_b : Bool),
      Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
        (modelSecondFiber α f q.1.1 q.1.2 q.2) ^ 2 *
          modelEnergyDensity α u q.1.1 q.1.2 q.2)
        ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume) →
      Integrable (modelSecondSuperpositionJoint α f)
        ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
          ((volume : Measure ModelE5).prod
            ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))))) →
      (∫ pt : E3 × ℝ,
        ∫ q : ModelE5 × ℝ,
          modelSecondSuperpositionJoint α f (pt, q)
          ∂((volume : Measure ModelE5).prod
            ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))))
        ∂(cubeScaleMeasure.restrict (collectionRegion α S))) =
        ∫ lam in Set.Ici (1 : ℝ),
          (∫ r : ℝ,
            localCubeForm α S 2 lam r (edgeCubeTuple f) *
              translationWeight r ^ (-50 : ℝ)) *
            lam ^ (-47 : ℝ) →
      modelEnergyTwo α S u f ≤
        C * sourceWeight u ^ 100 *
          ∫ lam in Set.Ici (1 : ℝ),
            (∫ r : ℝ,
              localCubeForm α S 2 lam r (edgeCubeTuple f) *
                translationWeight r ^ (-50 : ℝ)) *
              lam ^ (-47 : ℝ) := by
  rcases integral_modelSecondFiber_sq_density_le_cubePassive with
    ⟨C, hC, hfixed⟩
  refine ⟨C, hC, ?_⟩
  intro α S u f b henergy hsuper houter
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  have henergyFib : ∀ᵐ pt ∂μ, Integrable (fun z : ModelE5 ↦
      (modelSecondFiber α f pt.1 pt.2 z) ^ 2 *
        modelEnergyDensity α u pt.1 pt.2 z) := by
    simpa only [μ] using
      (MeasureTheory.integrable_prod_iff henergy.aestronglyMeasurable).mp henergy |>.1
  have hsuperFib : ∀ᵐ pt ∂μ, Integrable (fun q : ModelE5 × ℝ ↦
      modelSecondSuperpositionIntegrand α pt.1 pt.2 f q)
      ((volume : Measure ModelE5).prod ν) := by
    simpa only [modelSecondSuperpositionJoint, μ, ν] using
      (MeasureTheory.integrable_prod_iff hsuper.aestronglyMeasurable).mp hsuper |>.1
  have hscale : ∀ᵐ pt ∂μ, 0 < pt.2 := by
    dsimp only [μ]
    filter_upwards [ae_restrict_mem (measurableSet_collectionRegion α S)]
      with pt hpt
    exact pos_of_mem_collectionRegion α S hpt
  have hpoint : ∀ᵐ pt ∂μ,
      (∫ z : ModelE5,
        (modelSecondFiber α f pt.1 pt.2 z) ^ 2 *
          modelEnergyDensity α u pt.1 pt.2 z) ≤
        C * sourceWeight u ^ 100 *
          ∫ q : ModelE5 × ℝ,
            modelSecondSuperpositionIntegrand α pt.1 pt.2 f q
            ∂((volume : Measure ModelE5).prod ν) := by
    filter_upwards [henergyFib, hsuperFib, hscale] with pt hE hG ht
    have h := hfixed α u pt.1 pt.2 f b ht hE hG
    rw [← integral_modelSecondSuperposition_prod_eq_cubePassive
      α pt.1 pt.2 f b hG] at h
    exact h
  have henergyOuter : Integrable (fun pt : E3 × ℝ ↦
      ∫ z : ModelE5,
        (modelSecondFiber α f pt.1 pt.2 z) ^ 2 *
          modelEnergyDensity α u pt.1 pt.2 z) μ := by
    simpa only [μ] using henergy.integral_prod_left
  have hsuperOuter : Integrable (fun pt : E3 × ℝ ↦
      ∫ q : ModelE5 × ℝ,
        modelSecondSuperpositionIntegrand α pt.1 pt.2 f q
        ∂((volume : Measure ModelE5).prod ν)) μ := by
    simpa only [modelSecondSuperpositionJoint, μ, ν] using
      hsuper.integral_prod_left
  have hmajorOuter : Integrable (fun pt : E3 × ℝ ↦
      C * sourceWeight u ^ 100 *
        (∫ q : ModelE5 × ℝ,
          modelSecondSuperpositionIntegrand α pt.1 pt.2 f q
          ∂((volume : Measure ModelE5).prod ν))) μ := by
    exact hsuperOuter.const_mul (C * sourceWeight u ^ 100)
  change (∫ pt : E3 × ℝ,
      (∫ z : ModelE5,
        (modelSecondFiber α f pt.1 pt.2 z) ^ 2 *
          modelEnergyDensity α u pt.1 pt.2 z)
      ∂μ) ≤ _
  calc
    ∫ pt : E3 × ℝ,
        (∫ z : ModelE5,
          (modelSecondFiber α f pt.1 pt.2 z) ^ 2 *
            modelEnergyDensity α u pt.1 pt.2 z)
        ∂μ ≤
        ∫ pt : E3 × ℝ,
          C * sourceWeight u ^ 100 *
            (∫ q : ModelE5 × ℝ,
              modelSecondSuperpositionIntegrand α pt.1 pt.2 f q
              ∂((volume : Measure ModelE5).prod ν))
          ∂μ := MeasureTheory.integral_mono_ae henergyOuter hmajorOuter hpoint
    _ = C * sourceWeight u ^ 100 *
        (∫ pt : E3 × ℝ,
          ∫ q : ModelE5 × ℝ,
            modelSecondSuperpositionIntegrand α pt.1 pt.2 f q
            ∂((volume : Measure ModelE5).prod ν)
          ∂μ) := by
      rw [MeasureTheory.integral_const_mul]
    _ = C * sourceWeight u ^ 100 *
        ∫ lam in Set.Ici (1 : ℝ),
          (∫ r : ℝ,
            localCubeForm α S 2 lam r (edgeCubeTuple f) *
              translationWeight r ^ (-50 : ℝ)) *
            lam ^ (-47 : ℝ) := by
      rw [show (∫ pt : E3 × ℝ,
          ∫ q : ModelE5 × ℝ,
            modelSecondSuperpositionIntegrand α pt.1 pt.2 f q
            ∂((volume : Measure ModelE5).prod ν)
          ∂μ) =
          ∫ lam in Set.Ici (1 : ℝ),
            (∫ r : ℝ,
              localCubeForm α S 2 lam r (edgeCubeTuple f) *
                translationWeight r ^ (-50 : ℝ)) *
              lam ^ (-47 : ℝ) by
          simpa only [modelSecondSuperpositionJoint, μ, ν] using houter]

/-- The source-scale numerical factor left after the full-cube tree bound. -/
theorem integral_Ici_rpow_neg_ten :
    ∫ lam in Set.Ici (1 : ℝ), lam ^ (-10 : ℝ) = (1 : ℝ) / 9 := by
  rw [MeasureTheory.integral_Ici_eq_integral_Ioi,
    integral_Ioi_rpow_of_lt (by norm_num : (-10 : ℝ) < -1) zero_lt_one]
  norm_num

/-- The source-scale power in the first local-energy comparison is
integrable. -/
theorem integrableOn_Ici_rpow_neg_ten :
    IntegrableOn (fun lam : ℝ ↦ lam ^ (-10 : ℝ)) (Set.Ici (1 : ℝ)) := by
  rw [integrableOn_Ici_iff_integrableOn_Ioi]
  exact integrableOn_Ioi_rpow_of_lt (by norm_num) zero_lt_one

/-- Reorder a center variable, a source-scale variable, and a passive
variable from `((x, λ), y)` to `(λ, (x, y))`. This is the outer Tonelli
permutation used by both local-energy comparisons. -/
noncomputable def outerLambdaShuffle
    (X Y : Type*) [MeasurableSpace X] [MeasurableSpace Y] :
    ((X × ℝ) × Y) ≃ᵐ ℝ × (X × Y) :=
  (((MeasurableEquiv.prodAssoc :
      ((X × ℝ) × Y) ≃ᵐ (X × (ℝ × Y))).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl X)
      (MeasurableEquiv.prodComm : (ℝ × Y) ≃ᵐ (Y × ℝ)))).trans
    (MeasurableEquiv.prodAssoc.symm :
      (X × (Y × ℝ)) ≃ᵐ ((X × Y) × ℝ))).trans
    (MeasurableEquiv.prodComm : ((X × Y) × ℝ) ≃ᵐ (ℝ × (X × Y)))

@[simp] theorem outerLambdaShuffle_apply
    (X Y : Type*) [MeasurableSpace X] [MeasurableSpace Y]
    (x : X) (lam : ℝ) (y : Y) :
    outerLambdaShuffle X Y ((x, lam), y) = (lam, (x, y)) := by
  simp [outerLambdaShuffle, MeasurableEquiv.prodAssoc,
    MeasurableEquiv.prodComm, MeasurableEquiv.prodCongr]

@[simp] theorem outerLambdaShuffle_symm_apply
    (X Y : Type*) [MeasurableSpace X] [MeasurableSpace Y]
    (lam : ℝ) (xy : X × Y) :
    (outerLambdaShuffle X Y).symm (lam, xy) = ((xy.1, lam), xy.2) := by
  apply (outerLambdaShuffle X Y).injective
  rw [MeasurableEquiv.apply_symm_apply]
  exact (outerLambdaShuffle_apply X Y xy.1 lam xy.2).symm

/-- The outer source-scale shuffle preserves the corresponding literal
product measures. -/
theorem outerLambdaShuffle_measurePreserving
    {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    (μ : Measure X) (ν : Measure Y) [SFinite μ] [SFinite ν] :
    MeasurePreserving (outerLambdaShuffle X Y)
      ((μ.prod ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))).prod ν)
      (((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))).prod (μ.prod ν)) := by
  let lamμ : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  have h1 : MeasurePreserving
      (MeasurableEquiv.prodAssoc : ((X × ℝ) × Y) ≃ᵐ (X × (ℝ × Y)))
      ((μ.prod lamμ).prod ν) (μ.prod (lamμ.prod ν)) :=
    measurePreserving_prodAssoc μ lamμ ν
  have h2 : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl X)
        (MeasurableEquiv.prodComm : (ℝ × Y) ≃ᵐ (Y × ℝ)))
      (μ.prod (lamμ.prod ν)) (μ.prod (ν.prod lamμ)) := by
    convert (MeasurePreserving.id μ).prod
      (Measure.measurePreserving_swap : MeasurePreserving Prod.swap
        (lamμ.prod ν) (ν.prod lamμ)) using 1
    funext q
    rfl
  have h3 : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm : (X × (Y × ℝ)) ≃ᵐ ((X × Y) × ℝ))
      (μ.prod (ν.prod lamμ)) ((μ.prod ν).prod lamμ) :=
    (measurePreserving_prodAssoc μ ν lamμ).symm
  have h4 : MeasurePreserving
      (MeasurableEquiv.prodComm : ((X × Y) × ℝ) ≃ᵐ (ℝ × (X × Y)))
      ((μ.prod ν).prod lamμ) (lamμ.prod (μ.prod ν)) :=
    Measure.measurePreserving_swap
  change MeasurePreserving (outerLambdaShuffle X Y)
    ((μ.prod lamμ).prod ν) (lamμ.prod (μ.prod ν))
  convert ((h1.trans h2).trans h3).trans h4 using 1
  funext q
  rfl

/-- Fubini after the outer source-scale shuffle. -/
theorem integral_outerLambdaShuffle
    {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    (μ : Measure X) (ν : Measure Y) [SFinite μ] [SFinite ν]
    (G : (X × ℝ) × Y → ℝ)
    (hG : Integrable G
      ((μ.prod ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))).prod ν)) :
    ∫ q : (X × ℝ) × Y, G q
      ∂((μ.prod ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))).prod ν) =
      ∫ lam in Set.Ici (1 : ℝ),
        ∫ xy : X × Y, G ((xy.1, lam), xy.2) ∂(μ.prod ν) := by
  let lamμ : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let e := outerLambdaShuffle X Y
  have hmp : MeasurePreserving e ((μ.prod lamμ).prod ν) (lamμ.prod (μ.prod ν)) := by
    simpa only [e, lamμ] using outerLambdaShuffle_measurePreserving μ ν
  have htrans : Integrable (fun q : ℝ × (X × Y) ↦ G (e.symm q))
      (lamμ.prod (μ.prod ν)) := by
    exact (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hG
  calc
    ∫ q : (X × ℝ) × Y, G q ∂((μ.prod lamμ).prod ν) =
        ∫ q : ℝ × (X × Y), G (e.symm q) ∂(lamμ.prod (μ.prod ν)) := by
          symm
          exact (MeasurePreserving.symm e hmp).integral_comp'
            G
    _ = ∫ lam : ℝ, ∫ xy : X × Y, G (e.symm (lam, xy)) ∂(μ.prod ν) ∂lamμ :=
      MeasureTheory.integral_prod _ htrans
    _ = _ := by
      apply integral_congr_ae
      filter_upwards [] with lam
      apply integral_congr_ae
      filter_upwards [] with xy
      rw [outerLambdaShuffle_symm_apply]

/-- The first-energy cube tuple preserves bounded continuity of its three
nonconstant inputs. -/
theorem continuous_modelFirstCubeTuple
    (f : ModelRealInput) (hfcont : ∀ j, Continuous (f j)) :
    ∀ j, Continuous (modelFirstCubeTuple f j) := by
  intro j
  by_cases h0 : j 0
  · by_cases h1 : j 1
    · simpa [modelFirstCubeTuple, h0, h1] using (continuous_const :
        Continuous (fun _ : E3 ↦ (1 : ℝ)))
    · simpa [modelFirstCubeTuple, h0, h1] using hfcont 1
  · by_cases h1 : j 1
    · simpa [modelFirstCubeTuple, h0, h1] using hfcont 2
    · simpa [modelFirstCubeTuple, h0, h1] using hfcont 0

/-- The first-energy cube tuple preserves uniform bounds of its three
nonconstant inputs. -/
theorem bounded_modelFirstCubeTuple
    (f : ModelRealInput)
    (hfbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B) :
    ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |modelFirstCubeTuple f j y| ≤ B := by
  intro j
  by_cases h0 : j 0
  · by_cases h1 : j 1
    · refine ⟨1, zero_le_one, ?_⟩
      intro y
      simp [modelFirstCubeTuple, h0, h1]
    · simpa [modelFirstCubeTuple, h0, h1] using hfbound 1
  · by_cases h1 : j 1
    · simpa [modelFirstCubeTuple, h0, h1] using hfbound 2
    · simpa [modelFirstCubeTuple, h0, h1] using hfbound 0

/-- Bounded continuous first-energy inputs make the literal first energy
integrable on every finite collection. -/
theorem integrable_modelEnergyOne_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : ModelRealInput)
    (hfcont : ∀ j, Continuous (f j))
    (hfbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B) :
    Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      (modelFirstFiber α f q.1.1 q.1.2 q.2) ^ 2 *
        modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume) := by
  rcases hfbound 0 with ⟨B0, hB0, hf0⟩
  rcases hfbound 1 with ⟨B1, hB1, hf1⟩
  rcases hfbound 2 with ⟨B2, hB2, hf2⟩
  have hsq := integrable_modelFirstWeightedFactor_sq_of_density
    α S u f hfcont B0 B1 B2 hB0 hB1 hB2 hf0 hf1 hf2
      (integrable_modelEnergyDensity_collection α S u)
  exact hsq.congr (ae_modelFirstWeightedFactor_sq α S u f)

/-- Bounded continuous second-energy inputs make the literal second energy
integrable on every finite collection. -/
theorem integrable_modelEnergyTwo_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) :
    Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      (modelSecondFiber α f q.1.1 q.1.2 q.2) ^ 2 *
        modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume) := by
  rcases hfbound with ⟨B, hB, hf⟩
  have hsq := integrable_modelSecondWeightedFactor_sq_of_density
    α S u f hfcont B hB hf (integrable_modelEnergyDensity_collection α S u)
  exact hsq.congr (ae_modelSecondWeightedFactor_sq α S u f)

/-- At each source scale the first cube tuple's passive square is integrable
over the full center--scale/passive product measure. -/
