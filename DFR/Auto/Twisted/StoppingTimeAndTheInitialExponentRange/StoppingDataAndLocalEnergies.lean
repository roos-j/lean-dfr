      conePsiPhysicalRealL1 := by
    change ∫ x : ℝ, |conePsiPhysicalReal (x + u 2)| = _
    exact integral_abs_conePsiPhysicalReal_add _
  rw [← (PiLp.volume_preserving_toLp (Fin 5)).integral_comp
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  have hfactor : (modelEnergyDensity α u p t ∘ WithLp.toLp 2) =
      (fun x : Fin 5 → ℝ ↦
        ∏ i : Fin 5, modelEnergyDensityFactor α u p t i (x i)) := by
    funext x
    change modelEnergyDensity α u p t (WithLp.toLp 2 x) = _
    rw [modelEnergyDensity_eq_prod_factor]
  change (∫ x : Fin 5 → ℝ,
    (modelEnergyDensity α u p t ∘ WithLp.toLp 2) x) = _
  rw [hfactor, integral_fintype_prod_volume_eq_prod]
  have hfac (i : Fin 5) :
      ∫ x : ℝ, modelEnergyDensityFactor α u p t i x =
        match i.1 with
        | 0 => ∫ x : ℝ, |conePhiPhysicalReal x|
        | 1 => ∫ x : ℝ, |conePhiPhysicalReal x|
        | 2 => 1
        | 3 => 1
        | _ => conePsiPhysicalRealL1 := by
    fin_cases i
    · exact h0
    · exact h1
    · exact h2
    · exact h3
    · exact h4
  simp_rw [hfac]
  simp only [Fin.prod_univ_succ]
  norm_num
  ring


/-- The eight-slot tuple `F^[1]` from the first local-energy comparison.
It duplicates each of the three inputs in the third cube coordinate and
places the constant one in the remaining two slots. -/
noncomputable def modelFirstCubeTuple
    (f : ModelRealInput) : CubeVertex → E3 → ℝ :=
  fun j ↦ if j 0 then
    if j 1 then fun _ ↦ 1 else f 1
  else if j 1 then f 2 else f 0

/-- A concrete Boolean-labelled cube vertex, used to enumerate a fixed
third-coordinate slice without relying on an implicit order of functions. -/
def cubeVertex (a b c : Bool) : CubeVertex :=
  fun i ↦ if i = 0 then a else if i = 1 then b else c

@[simp] theorem cubeVertex_zero (a b c : Bool) :
    cubeVertex a b c 0 = a := by simp [cubeVertex]

@[simp] theorem cubeVertex_one (a b c : Bool) :
    cubeVertex a b c 1 = b := by simp [cubeVertex]

@[simp] theorem cubeVertex_two (a b c : Bool) :
    cubeVertex a b c 2 = c := by simp [cubeVertex]

/-- The first slot family is independent of the third cube bit, exactly as
required by the square expansion of the first fiber. -/
theorem modelFirstCubeTuple_coordinateCopy_two
    (f : ModelRealInput) (b : Bool) :
    cubeCoordinateCopy 2 b (modelFirstCubeTuple f) =
      modelFirstCubeTuple f := by
  funext j x
  simp only [cubeCoordinateCopy, modelFirstCubeTuple]
  by_cases h0 : j 0 <;> by_cases h1 : j 1 <;>
    simp [cubeVertexReplace, h0, h1]

theorem modelFirstCubeTuple_at_000
    (f : ModelRealInput) :
    modelFirstCubeTuple f (cubePairVertex false false) = f 0 := by
  funext x
  simp [modelFirstCubeTuple, cubePairVertex]

theorem modelFirstCubeTuple_at_100
    (f : ModelRealInput) :
    modelFirstCubeTuple f (cubeComplement (cubePairVertex true true)) = f 1 := by
  funext x
  simp [modelFirstCubeTuple, cubePairVertex]

theorem modelFirstCubeTuple_at_010
    (f : ModelRealInput) :
    modelFirstCubeTuple f (cubePairVertex true false) = f 2 := by
  funext x
  simp [modelFirstCubeTuple, cubePairVertex]

theorem modelFirstCubeTuple_at_110
    (f : ModelRealInput) :
    modelFirstCubeTuple f (cubeComplement (cubePairVertex false true)) = fun _ ↦ 1 := by
  funext x
  simp [modelFirstCubeTuple, cubePairVertex]

/-- The three-input integrand inside the first fiber, isolated so its two
copies can be matched with the false and true active cube coordinates. -/
noncomputable def modelFirstFiberIntegrand
    (f : ModelRealInput) (x₁ x₂ y₁ y₂ v : ℝ) : ℝ :=
  f 0 (modelPoint x₁ x₂ v) *
    f 1 (modelPoint y₁ x₂ v) *
      f 2 (modelPoint x₁ y₂ v)

theorem modelFirstFiber_eq_integral
    (α : Anisotropy) (f : ModelRealInput) (p : E3) (t : ℝ)
    (z : ModelE5) :
    modelFirstFiber α f p t z =
      ∫ v : ℝ,
        modelFirstFiberIntegrand f (z 0) (z 1) (z 2) (z 3) v *
          gaussianDerivAt (t ^ α.weight 2) (p 2) v := by
  rfl

/-- The passive coordinates for the third-active cube split, ordered as
`(x₁,x₂)` at the false vertex and `(y₁,y₂)` at the true vertex. -/
noncomputable def modelFirstPassivePair
    (x₁ x₂ y₁ y₂ : ℝ) : TransverseSpace 2 × TransverseSpace 2 :=
  (WithLp.toLp 2 fun m ↦ if m.1 = 0 then x₁ else x₂,
    WithLp.toLp 2 fun m ↦ if m.1 = 0 then y₁ else y₂)

@[simp] theorem modelFirstPassivePair_false_zero
    (x₁ x₂ y₁ y₂ : ℝ) :
    (modelFirstPassivePair x₁ x₂ y₁ y₂).1 ⟨0, by decide⟩ = x₁ := by
  simp [modelFirstPassivePair]

@[simp] theorem modelFirstPassivePair_false_one
    (x₁ x₂ y₁ y₂ : ℝ) :
    (modelFirstPassivePair x₁ x₂ y₁ y₂).1 ⟨1, by decide⟩ = x₂ := by
  simp [modelFirstPassivePair]

@[simp] theorem modelFirstPassivePair_true_zero
    (x₁ x₂ y₁ y₂ : ℝ) :
    (modelFirstPassivePair x₁ x₂ y₁ y₂).2 ⟨0, by decide⟩ = y₁ := by
  simp [modelFirstPassivePair]

@[simp] theorem modelFirstPassivePair_true_one
    (x₁ x₂ y₁ y₂ : ℝ) :
    (modelFirstPassivePair x₁ x₂ y₁ y₂).2 ⟨1, by decide⟩ = y₂ := by
  simp [modelFirstPassivePair]

/-- On the false active slice of the third-coordinate cube split, the first
energy tuple is exactly the three-input fiber integrand. -/
theorem cubeActiveInputSlice_modelFirst_false
    (f : ModelRealInput) (x₁ x₂ y₁ y₂ v : ℝ) :
    cubeActiveInputSlice 2 false (modelFirstCubeTuple f)
      (modelFirstPassivePair x₁ x₂ y₁ y₂) v =
      modelFirstFiberIntegrand f x₁ x₂ y₁ y₂ v := by
  classical
  let j00 : {j : CubeVertex // j 2 = false} :=
    ⟨cubeVertex false false false, by simp⟩
  let j10 : {j : CubeVertex // j 2 = false} :=
    ⟨cubeVertex true false false, by simp⟩
  let j01 : {j : CubeVertex // j 2 = false} :=
    ⟨cubeVertex false true false, by simp⟩
  let j11 : {j : CubeVertex // j 2 = false} :=
    ⟨cubeVertex true true false, by simp⟩
  have huniv : (Finset.univ : Finset {j : CubeVertex // j 2 = false}) =
      {j00, j10, j01, j11} := by
    ext j
    simp only [Finset.mem_univ, Finset.mem_insert, Finset.mem_singleton]
    rcases j with ⟨j, hj⟩
    have hrepr : j = cubeVertex (j 0) (j 1) false := by
      funext k
      fin_cases k
      · simp [cubeVertex]
      · simp [cubeVertex]
      · simpa [cubeVertex] using hj
    constructor
    · intro _
      cases h0 : j 0 <;> cases h1 : j 1
      · left
        simpa [j00, h0, h1] using hrepr
      · right; right; left
        simpa [j01, h0, h1] using hrepr
      · right; left
        simpa [j10, h0, h1] using hrepr
      · right; right; right
        simpa [j11, h0, h1] using hrepr
    · intro _
      trivial
  unfold cubeActiveInputSlice
  rw [huniv]
  have h00_10 : j00 ≠ j10 := by
    intro h
    have h' := congrArg (fun q : {j : CubeVertex // j 2 = false} ↦ q.1 0) h
    simp [j00, j10] at h'
  have h00_01 : j00 ≠ j01 := by
    intro h
    have h' := congrArg (fun q : {j : CubeVertex // j 2 = false} ↦ q.1 1) h
    simp [j00, j01] at h'
  have h00_11 : j00 ≠ j11 := by
    intro h
    have h' := congrArg (fun q : {j : CubeVertex // j 2 = false} ↦ q.1 0) h
    simp [j00, j11] at h'
  have h10_01 : j10 ≠ j01 := by
    intro h
    have h' := congrArg (fun q : {j : CubeVertex // j 2 = false} ↦ q.1 0) h
    simp [j10, j01] at h'
  have h10_11 : j10 ≠ j11 := by
    intro h
    have h' := congrArg (fun q : {j : CubeVertex // j 2 = false} ↦ q.1 1) h
    simp [j10, j11] at h'
  have h01_11 : j01 ≠ j11 := by
    intro h
    have h' := congrArg (fun q : {j : CubeVertex // j 2 = false} ↦ q.1 0) h
    simp [j01, j11] at h'
  have hj00 : j00 ∉ ({j10, j01, j11} : Finset {j : CubeVertex // j 2 = false}) := by
    simp only [Finset.mem_insert, Finset.mem_singleton]
    exact fun h ↦ h.elim h00_10 (fun h ↦ h.elim h00_01 h00_11)
  have hj10 : j10 ∉ ({j01, j11} : Finset {j : CubeVertex // j 2 = false}) := by
    simp only [Finset.mem_insert, Finset.mem_singleton]
    exact fun h ↦ h.elim h10_01 h10_11
  have hj01 : j01 ∉ ({j11} : Finset {j : CubeVertex // j 2 = false}) := by
    simpa only [Finset.mem_singleton] using h01_11
  rw [Finset.prod_insert hj00, Finset.prod_insert hj10,
    Finset.prod_insert hj01, Finset.prod_singleton]
  have hp00 :
      faceInsert 2 v (cubePassiveProjection 2 j00.1
        (modelFirstPassivePair x₁ x₂ y₁ y₂)) =
        modelPoint x₁ x₂ v := by
    ext k
    fin_cases k <;>
      simp [j00, modelFirstPassivePair, cubePassiveProjection,
        faceInsert, cubeVertex, modelPoint]
  have hp10 :
      faceInsert 2 v (cubePassiveProjection 2 j10.1
        (modelFirstPassivePair x₁ x₂ y₁ y₂)) =
        modelPoint y₁ x₂ v := by
    ext k
    fin_cases k <;>
      simp [j10, modelFirstPassivePair, cubePassiveProjection,
        faceInsert, cubeVertex, modelPoint]
  have hp01 :
      faceInsert 2 v (cubePassiveProjection 2 j01.1
        (modelFirstPassivePair x₁ x₂ y₁ y₂)) =
        modelPoint x₁ y₂ v := by
    ext k
    fin_cases k <;>
      simp [j01, modelFirstPassivePair, cubePassiveProjection,
        faceInsert, cubeVertex, modelPoint]
  rw [hp00, hp10, hp01]
  simp [modelFirstCubeTuple, modelFirstFiberIntegrand,
    j00, j10, j01, j11, cubeVertex]
  ring

/-- The true third-coordinate slice is the same first-fiber integrand: the
tuple is a coordinate copy in that direction. -/
theorem cubeActiveInputSlice_modelFirst_true
    (f : ModelRealInput) (x₁ x₂ y₁ y₂ v : ℝ) :
    cubeActiveInputSlice 2 true (modelFirstCubeTuple f)
      (modelFirstPassivePair x₁ x₂ y₁ y₂) v =
      modelFirstFiberIntegrand f x₁ x₂ y₁ y₂ v := by
  calc
    cubeActiveInputSlice 2 true (modelFirstCubeTuple f)
        (modelFirstPassivePair x₁ x₂ y₁ y₂) v =
        cubeActiveInputSlice 2 false
          (cubeCoordinateCopy 2 true (modelFirstCubeTuple f))
          (modelFirstPassivePair x₁ x₂ y₁ y₂) v := by
      symm
      exact cubeActiveInputSlice_coordinateCopy 2 false true
        (modelFirstCubeTuple f)
        (modelFirstPassivePair x₁ x₂ y₁ y₂) v
    _ = cubeActiveInputSlice 2 false (modelFirstCubeTuple f)
          (modelFirstPassivePair x₁ x₂ y₁ y₂) v := by
      rw [modelFirstCubeTuple_coordinateCopy_two]
    _ = modelFirstFiberIntegrand f x₁ x₂ y₁ y₂ v :=
      cubeActiveInputSlice_modelFirst_false f x₁ x₂ y₁ y₂ v

/-- Reassembling active/passive coordinates turns the eight first-energy cube
inputs into the two copies of the first fiber integrand. -/
theorem cubeSignedInputProduct_modelFirst_cubeActivePassiveSplit_symm
    (f : ModelRealInput) (x₁ x₂ y₁ y₂ v w : ℝ) :
    cubeSignedInputProduct (modelFirstCubeTuple f)
      ((cubeActivePassiveSplit 2).symm
        ((v, w), modelFirstPassivePair x₁ x₂ y₁ y₂)) =
      modelFirstFiberIntegrand f x₁ x₂ y₁ y₂ v *
        modelFirstFiberIntegrand f x₁ x₂ y₁ y₂ w := by
  rw [cubeSignedInputProduct_cubeActivePassiveSplit_symm]
  rw [cubeActiveInputSlice_modelFirst_false,
    cubeActiveInputSlice_modelFirst_true]

/-- At the third active coordinate and zero translation, either active
average of the first-energy cube tuple is the original first fiber. The
fifth model variable is intentionally absent on both sides. -/
theorem cubeActiveCSAverage_modelFirst
    (α : Anisotropy) (lam : ℝ) (f : ModelRealInput) (b : Bool)
    (p : E3) (t : ℝ) (z : ModelE5) :
    cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) b
      ((p, t), modelFirstPassivePair (z 0) (z 1) (z 2) (z 3)) =
      modelFirstFiber α f p t z := by
  rw [modelFirstFiber_eq_integral]
  unfold cubeActiveCSAverage cubeActiveCSFactor
  apply integral_congr_ae
  filter_upwards [] with v
  cases b
  · rw [cubeActiveInputSlice_modelFirst_false]
    simp [cubeGaussianDerivKernel]
    ring
  · rw [cubeActiveInputSlice_modelFirst_true]
    simp [cubeGaussianDerivKernel]
    ring

/-- The four passive Gaussian factors `D_{λ,p,t}` from the first-energy
superposition. -/
noncomputable def modelFirstPassiveGaussianWeight
    (α : Anisotropy) (lam : ℝ) (p : E3) (t x₁ x₂ y₁ y₂ : ℝ) : ℝ :=
  (gaussianAt (lam * t ^ α.weight 0) (p 0) x₁ *
    gaussianAt (lam * t ^ α.weight 0) (p 0) y₁) *
  (gaussianAt (lam * t ^ α.weight 1) (p 1) x₂ *
    gaussianAt (lam * t ^ α.weight 1) (p 1) y₂)

/-- The four normalized scalar coordinates used to invoke the Gaussian
superposition estimate at an anisotropic center and scale. -/
noncomputable def modelFirstNormalizedPoint
    (α : Anisotropy) (p : E3) (t x₁ x₂ y₁ y₂ : ℝ) : E4 :=
  WithLp.toLp 2 fun k ↦
    if k = 0 then (x₁ - p 0) / t ^ α.weight 0
    else if k = 1 then (y₁ - p 0) / t ^ α.weight 0
    else if k = 2 then (x₂ - p 1) / t ^ α.weight 1
    else (y₂ - p 1) / t ^ α.weight 1

@[simp] theorem modelFirstNormalizedPoint_zero
    (α : Anisotropy) (p : E3) (t x₁ x₂ y₁ y₂ : ℝ) :
    modelFirstNormalizedPoint α p t x₁ x₂ y₁ y₂ 0 =
      (x₁ - p 0) / t ^ α.weight 0 := by
  simp [modelFirstNormalizedPoint]

@[simp] theorem modelFirstNormalizedPoint_one
    (α : Anisotropy) (p : E3) (t x₁ x₂ y₁ y₂ : ℝ) :
    modelFirstNormalizedPoint α p t x₁ x₂ y₁ y₂ 1 =
      (y₁ - p 0) / t ^ α.weight 0 := by
  simp [modelFirstNormalizedPoint]

@[simp] theorem modelFirstNormalizedPoint_two
    (α : Anisotropy) (p : E3) (t x₁ x₂ y₁ y₂ : ℝ) :
    modelFirstNormalizedPoint α p t x₁ x₂ y₁ y₂ 2 =
      (x₂ - p 1) / t ^ α.weight 1 := by
  simp [modelFirstNormalizedPoint]

@[simp] theorem modelFirstNormalizedPoint_three
    (α : Anisotropy) (p : E3) (t x₁ x₂ y₁ y₂ : ℝ) :
    modelFirstNormalizedPoint α p t x₁ x₂ y₁ y₂ 3 =
      (y₂ - p 1) / t ^ α.weight 1 := by
  simp [modelFirstNormalizedPoint]

/-- The four nonnegative factors in a first/second local-energy density,
before the separate annular `r` factor is attached. -/
noncomputable def modelFirstEnergyDensityCore
    (α : Anisotropy) (u p : E3) (t x₁ x₂ y₁ y₂ : ℝ) : ℝ :=
  |modelPhiAt (t ^ α.weight 0)
    (p 0 + t ^ α.weight 0 * u 0) x₁| *
  gaussianAt (t ^ α.weight 0) (p 0) y₁ *
  |modelPhiAt (t ^ α.weight 1)
    (p 1 + t ^ α.weight 1 * u 1) x₂| *
  gaussianAt (t ^ α.weight 1) (p 1) y₂

/-- After normalizing the two passive coordinate pairs, the four-factor
energy density is the source superposition input times its exact Jacobian
factor. -/
theorem modelFirstEnergyDensityCore_eq_normalized
    (α : Anisotropy) (u p : E3) (t x₁ x₂ y₁ y₂ : ℝ) (ht : 0 < t) :
    modelFirstEnergyDensityCore α u p t x₁ x₂ y₁ y₂ =
      ((t ^ α.weight 0)⁻¹ * (t ^ α.weight 0)⁻¹ *
        (t ^ α.weight 1)⁻¹ * (t ^ α.weight 1)⁻¹) *
        superpositionInput
          (modelFirstNormalizedPoint α p t x₁ x₂ y₁ y₂) u := by
  have hs0 : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs1 : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs0ne : t ^ α.weight 0 ≠ 0 := hs0.ne'
  have hs1ne : t ^ α.weight 1 ≠ 0 := hs1.ne'
  unfold modelFirstEnergyDensityCore modelPhiAt gaussianAt
    superpositionInput kernelAt kernelDilate
  simp only [smul_eq_mul, abs_mul, abs_of_pos (inv_pos.mpr hs0),
    abs_of_pos (inv_pos.mpr hs1), modelFirstNormalizedPoint_zero,
    modelFirstNormalizedPoint_one,
    modelFirstNormalizedPoint_two,
    modelFirstNormalizedPoint_three]
  have hφ0 :
      (x₁ - (p 0 + t ^ α.weight 0 * u 0)) / t ^ α.weight 0 =
        (x₁ - p 0) / t ^ α.weight 0 - u 0 := by
    field_simp
    ring
  have hφ1 :
      (x₂ - (p 1 + t ^ α.weight 1 * u 1)) / t ^ α.weight 1 =
        (x₂ - p 1) / t ^ α.weight 1 - u 1 := by
    field_simp
    ring
  rw [hφ0, hφ1]
  ring

/-- Integrating the passive four-Gaussian weight over the superposition
scale recovers the normalized source superposition, with the exact two-scale
Jacobian factor. -/
theorem integral_modelFirstPassiveGaussianWeight_eq_superposition
    (α : Anisotropy) (p : E3) (t x₁ x₂ y₁ y₂ : ℝ) (ht : 0 < t) :
    ∫ lam in Set.Ici (1 : ℝ),
      modelFirstPassiveGaussianWeight α lam p t x₁ x₂ y₁ y₂ *
        lam ^ (-47 : ℝ) =
      ((t ^ α.weight 0)⁻¹ * (t ^ α.weight 0)⁻¹ *
        (t ^ α.weight 1)⁻¹ * (t ^ α.weight 1)⁻¹) *
        gaussianSuperposition
          (modelFirstNormalizedPoint α p t x₁ x₂ y₁ y₂) := by
  let z : E4 := modelFirstNormalizedPoint α p t x₁ x₂ y₁ y₂
  let s0 : ℝ := t ^ α.weight 0
  let s1 : ℝ := t ^ α.weight 1
  have hs0 : 0 < s0 := by
    dsimp [s0]
    exact pow_pos ht _
  have hs1 : 0 < s1 := by
    dsimp [s1]
    exact pow_pos ht _
  have hgauss0 (lam x a : ℝ) (hlam : 0 < lam) :
      gaussianAt (lam * s0) a x =
        s0⁻¹ * gaussianAt lam 0 ((x - a) / s0) := by
    unfold gaussianAt kernelAt kernelDilate
    simp only [smul_eq_mul, sub_zero]
    field_simp
  have hgauss1 (lam x a : ℝ) (hlam : 0 < lam) :
      gaussianAt (lam * s1) a x =
        s1⁻¹ * gaussianAt lam 0 ((x - a) / s1) := by
    unfold gaussianAt kernelAt kernelDilate
    simp only [smul_eq_mul, sub_zero]
    field_simp
  let J : ℝ := s0⁻¹ * s0⁻¹ * s1⁻¹ * s1⁻¹
  calc
    ∫ lam in Set.Ici (1 : ℝ),
        modelFirstPassiveGaussianWeight α lam p t x₁ x₂ y₁ y₂ *
          lam ^ (-47 : ℝ) =
        ∫ lam in Set.Ici (1 : ℝ), J * superpositionIntegrand z lam := by
          apply setIntegral_congr_fun measurableSet_Ici
          intro lam hlam
          have hlampos : 0 < lam := lt_of_lt_of_le zero_lt_one hlam
          have hsource := superpositionIntegrand_eq_source_product z hlampos
          dsimp [modelFirstPassiveGaussianWeight, J]
          rw [hgauss0 lam x₁ (p 0) hlampos,
            hgauss0 lam y₁ (p 0) hlampos,
            hgauss1 lam x₂ (p 1) hlampos,
            hgauss1 lam y₂ (p 1) hlampos]
          rw [hsource]
          dsimp [z, s0, s1]
          simp only [modelFirstNormalizedPoint_zero,
            modelFirstNormalizedPoint_one,
            modelFirstNormalizedPoint_two,
            modelFirstNormalizedPoint_three]
          ring
    _ = J * ∫ lam in Set.Ici (1 : ℝ), superpositionIntegrand z lam :=
      MeasureTheory.integral_const_mul J _
    _ = ((t ^ α.weight 0)⁻¹ * (t ^ α.weight 0)⁻¹ *
        (t ^ α.weight 1)⁻¹ * (t ^ α.weight 1)⁻¹) *
        gaussianSuperposition
          (modelFirstNormalizedPoint α p t x₁ x₂ y₁ y₂) := by
      rfl

/-- The scaled Gaussian superposition controls the four non-annular factors
of either local energy, with the exact source loss `U(u)^50`. -/
theorem modelFirstEnergyDensityCore_le_superposition :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (α : Anisotropy) (u p : E3)
      (t x₁ x₂ y₁ y₂ : ℝ), 0 < t →
      modelFirstEnergyDensityCore α u p t x₁ x₂ y₁ y₂ ≤
        C * sourceWeight u ^ 50 *
          ∫ lam in Set.Ici (1 : ℝ),
            modelFirstPassiveGaussianWeight α lam p t x₁ x₂ y₁ y₂ *
              lam ^ (-47 : ℝ) := by
  rcases gaussianSuperposition_domination with ⟨C, hC, hdom⟩
  refine ⟨C, hC, ?_⟩
  intro α u p t x₁ x₂ y₁ y₂ ht
  let z : E4 := modelFirstNormalizedPoint α p t x₁ x₂ y₁ y₂
  let J : ℝ := (t ^ α.weight 0)⁻¹ * (t ^ α.weight 0)⁻¹ *
    (t ^ α.weight 1)⁻¹ * (t ^ α.weight 1)⁻¹
  have hJ : 0 ≤ J := by
    dsimp [J]
    exact mul_nonneg
      (mul_nonneg (mul_nonneg
        (inv_nonneg.mpr (pow_pos ht _).le)
        (inv_nonneg.mpr (pow_pos ht _).le))
        (inv_nonneg.mpr (pow_pos ht _).le))
      (inv_nonneg.mpr (pow_pos ht _).le)
  have hcore := modelFirstEnergyDensityCore_eq_normalized
    α u p t x₁ x₂ y₁ y₂ ht
  have hscale := integral_modelFirstPassiveGaussianWeight_eq_superposition
    α p t x₁ x₂ y₁ y₂ ht
  have hpoint : superpositionInput z u ≤
      C * sourceWeight u ^ 50 * gaussianSuperposition z := hdom z u
  change modelFirstEnergyDensityCore α u p t x₁ x₂ y₁ y₂ ≤
    C * sourceWeight u ^ 50 *
      ∫ lam in Set.Ici (1 : ℝ),
        modelFirstPassiveGaussianWeight α lam p t x₁ x₂ y₁ y₂ *
          lam ^ (-47 : ℝ)
  rw [hcore, hscale]
  change J * superpositionInput z u ≤
    C * sourceWeight u ^ 50 * (J * gaussianSuperposition z)
  calc
    J * superpositionInput z u ≤
        J * (C * sourceWeight u ^ 50 * gaussianSuperposition z) :=
      mul_le_mul_of_nonneg_left hpoint hJ
    _ = C * sourceWeight u ^ 50 * (J * gaussianSuperposition z) := by ring

/-- The literal model-energy density separates into the four passive factors
and the translated annular factor. -/
theorem modelEnergyDensity_eq_core_mul_annular
    (α : Anisotropy) (u p : E3) (t : ℝ) (z : ModelE5) :
    modelEnergyDensity α u p t z =
      modelFirstEnergyDensityCore α u p t
        (z 0) (z 1) (z 2) (z 3) *
      |conePsiPhysicalReal (z 4 + u 2)| := by
  rfl

/-- The energy density admits the scaled Gaussian-superposition domination
used in both Section 5 local-energy estimates. -/
theorem modelEnergyDensity_le_superposition :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (α : Anisotropy) (u p : E3)
      (t : ℝ) (z : ModelE5), 0 < t →
      modelEnergyDensity α u p t z ≤
        C * sourceWeight u ^ 50 * |conePsiPhysicalReal (z 4 + u 2)| *
          ∫ lam in Set.Ici (1 : ℝ),
            modelFirstPassiveGaussianWeight α lam p t
              (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ) := by
  rcases modelFirstEnergyDensityCore_le_superposition with
    ⟨C, hC, hcore⟩
  refine ⟨C, hC, ?_⟩
  intro α u p t z ht
  have h := hcore α u p t (z 0) (z 1) (z 2) (z 3) ht
  have hann : 0 ≤ |conePsiPhysicalReal (z 4 + u 2)| := abs_nonneg _
  rw [modelEnergyDensity_eq_core_mul_annular]
  calc
    modelFirstEnergyDensityCore α u p t
          (z 0) (z 1) (z 2) (z 3) *
        |conePsiPhysicalReal (z 4 + u 2)| ≤
        (C * sourceWeight u ^ 50 *
          ∫ lam in Set.Ici (1 : ℝ),
            modelFirstPassiveGaussianWeight α lam p t
              (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ)) *
          |conePsiPhysicalReal (z 4 + u 2)| :=
      mul_le_mul_of_nonneg_right h hann
    _ = C * sourceWeight u ^ 50 * |conePsiPhysicalReal (z 4 + u 2)| *
          ∫ lam in Set.Ici (1 : ℝ),
            modelFirstPassiveGaussianWeight α lam p t
              (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ) := by ring

/-- The four-Gaussian passive weight is nonnegative in the source scale
range. -/
theorem modelFirstPassiveGaussianWeight_nonneg
    (α : Anisotropy) (lam : ℝ) (p : E3) (t x₁ x₂ y₁ y₂ : ℝ)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    0 ≤ modelFirstPassiveGaussianWeight α lam p t x₁ x₂ y₁ y₂ := by
  have hs0 : 0 < lam * t ^ α.weight 0 :=
    mul_pos (by linarith) (pow_pos ht _)
  have hs1 : 0 < lam * t ^ α.weight 1 :=
    mul_pos (by linarith) (pow_pos ht _)
  unfold modelFirstPassiveGaussianWeight gaussianAt kernelAt kernelDilate
  simp only [smul_eq_mul]
  repeat' apply mul_nonneg
  all_goals first | exact inv_nonneg.mpr hs0.le | exact inv_nonneg.mpr hs1.le |
    exact gaussian_nonneg _

/-- The passive superposition integral is nonnegative on the source scale
range. -/
theorem integral_modelFirstPassiveGaussianWeight_nonneg
    (α : Anisotropy) (p : E3) (t x₁ x₂ y₁ y₂ : ℝ) (ht : 0 < t) :
    0 ≤ ∫ lam in Set.Ici (1 : ℝ),
      modelFirstPassiveGaussianWeight α lam p t x₁ x₂ y₁ y₂ *
        lam ^ (-47 : ℝ) := by
  apply integral_nonneg_of_ae
  filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
  exact mul_nonneg
    (modelFirstPassiveGaussianWeight_nonneg α lam p t x₁ x₂ y₁ y₂
      hlam ht)
    (Real.rpow_nonneg (le_trans zero_le_one hlam) _)

/-- Combining the four-factor superposition with the translated annular
decay yields the `U(u)^100 R(r)^{-50}` pointwise majorant used for the
second local energy. -/
theorem modelEnergyDensity_le_second_superposition :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (α : Anisotropy) (u p : E3)
      (t : ℝ) (z : ModelE5), 0 < t →
      modelEnergyDensity α u p t z ≤
        C * sourceWeight u ^ 100 * translationWeight (z 4) ^ (-50 : ℝ) *
          ∫ lam in Set.Ici (1 : ℝ),
            modelFirstPassiveGaussianWeight α lam p t
              (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ) := by
  rcases modelEnergyDensity_le_superposition with ⟨C₁, hC₁, hfirst⟩
  rcases conePsiPhysicalReal_translate_decay with ⟨C₂, hC₂, hpsi⟩
  refine ⟨C₁ * C₂, mul_nonneg hC₁ hC₂, ?_⟩
  intro α u p t z ht
  let I : ℝ := ∫ lam in Set.Ici (1 : ℝ),
    modelFirstPassiveGaussianWeight α lam p t
      (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ)
  have hI : 0 ≤ I := by
    exact integral_modelFirstPassiveGaussianWeight_nonneg
      α p t (z 0) (z 1) (z 2) (z 3) ht
  have hA : 0 ≤ C₁ * sourceWeight u ^ 50 * I := by
    exact mul_nonneg (mul_nonneg hC₁ (pow_nonneg (sourceWeight_nonneg u) _)) hI
  have hψ : |conePsiPhysicalReal (z 4 + u 2)| ≤
      C₂ * sourceWeight u ^ 50 * translationWeight (z 4) ^ (-50 : ℝ) :=
    (hpsi (z 4) u).1
  have hfirst' : modelEnergyDensity α u p t z ≤
      (C₁ * sourceWeight u ^ 50 * I) *
        |conePsiPhysicalReal (z 4 + u 2)| := by
    calc
      modelEnergyDensity α u p t z ≤
          C₁ * sourceWeight u ^ 50 *
            |conePsiPhysicalReal (z 4 + u 2)| * I :=
        hfirst α u p t z ht
      _ = (C₁ * sourceWeight u ^ 50 * I) *
            |conePsiPhysicalReal (z 4 + u 2)| := by ring
  calc
    modelEnergyDensity α u p t z ≤
        (C₁ * sourceWeight u ^ 50 * I) *
          |conePsiPhysicalReal (z 4 + u 2)| := hfirst'
    _ ≤ (C₁ * sourceWeight u ^ 50 * I) *
        (C₂ * sourceWeight u ^ 50 * translationWeight (z 4) ^ (-50 : ℝ)) :=
      mul_le_mul_of_nonneg_left hψ hA
    _ = (C₁ * C₂) * (sourceWeight u ^ 50 * sourceWeight u ^ 50) *
        translationWeight (z 4) ^ (-50 : ℝ) * I := by ring
    _ = (C₁ * C₂) * sourceWeight u ^ 100 *
        translationWeight (z 4) ^ (-50 : ℝ) * I := by
      rw [← pow_add]
    _ = (C₁ * C₂) * sourceWeight u ^ 100 *
        translationWeight (z 4) ^ (-50 : ℝ) *
          ∫ lam in Set.Ici (1 : ℝ),
            modelFirstPassiveGaussianWeight α lam p t
              (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ) := by
      rfl

/-- The passive Gaussian weight in the third-active local cube form is the
four Gaussian product `D_{λ,p,t}` from the first-energy superposition. -/
theorem cubePassiveGaussianKernel_modelFirst
    (α : Anisotropy) (lam r : ℝ) (p : E3) (t x₁ x₂ y₁ y₂ : ℝ) :
    cubePassiveGaussianKernel α 2 lam r t p
      (modelFirstPassivePair x₁ x₂ y₁ y₂) =
      modelFirstPassiveGaussianWeight α lam p t x₁ x₂ y₁ y₂ := by
  simp [cubePassiveGaussianKernel, cubeGaussianKernel, Fin.prod_univ_three,
    modelFirstPassivePair, modelFirstPassiveGaussianWeight,
    cubeWidth, cubeCenterShift]

/-- The literal fixed-center, fixed-scale change of variables for the first
local energy: the local cube integrand is the product of two first-fiber
integrands and the four-factor Gaussian superposition weight. -/
theorem localCubeIntegrand_modelFirst_activePassiveSplit_symm
    (α : Anisotropy) (lam : ℝ) (f : ModelRealInput)
    (p : E3) (t x₁ x₂ y₁ y₂ v w : ℝ) :
    cubeSignedInputProduct (modelFirstCubeTuple f)
      ((cubeActivePassiveSplit 2).symm
        ((v, w), modelFirstPassivePair x₁ x₂ y₁ y₂)) *
      localCubeKernel α 2 lam 0 t p
        ((cubeActivePassiveSplit 2).symm
          ((v, w), modelFirstPassivePair x₁ x₂ y₁ y₂)) =
      (modelFirstFiberIntegrand f x₁ x₂ y₁ y₂ v *
        gaussianDerivAt (t ^ α.weight 2) (p 2) v) *
      (modelFirstFiberIntegrand f x₁ x₂ y₁ y₂ w *
        gaussianDerivAt (t ^ α.weight 2) (p 2) w) *
      modelFirstPassiveGaussianWeight α lam p t x₁ x₂ y₁ y₂ := by
  rw [cubeSignedInputProduct_modelFirst_cubeActivePassiveSplit_symm,
    localCubeKernel_cubeActivePassiveSplit_symm,
    cubePassiveGaussianKernel_modelFirst]
  simp [cubeGaussianDerivKernel]
  ring

/-- Integrating the two active variables in the fixed first-energy cube
integrand gives the square of the first fiber times the passive four-Gaussian
weight. This is the literal fixed-`(p,t,x₁,x₂,y₁,y₂)` identity behind the
first local-energy cube comparison. -/
theorem integral_localCubeIntegrand_modelFirst_active
    (α : Anisotropy) (lam : ℝ) (f : ModelRealInput)
    (p : E3) (t : ℝ) (z : ModelE5) :
    ∫ vw : ℝ × ℝ,
      cubeSignedInputProduct (modelFirstCubeTuple f)
        ((cubeActivePassiveSplit 2).symm
          ((vw.1, vw.2), modelFirstPassivePair
            (z 0) (z 1) (z 2) (z 3))) *
        localCubeKernel α 2 lam 0 t p
          ((cubeActivePassiveSplit 2).symm
            ((vw.1, vw.2), modelFirstPassivePair
              (z 0) (z 1) (z 2) (z 3))) =
      (modelFirstFiber α f p t z) ^ 2 *
        modelFirstPassiveGaussianWeight α lam p t
          (z 0) (z 1) (z 2) (z 3) := by
  let A : ℝ → ℝ := fun v ↦
    modelFirstFiberIntegrand f (z 0) (z 1) (z 2) (z 3) v *
      gaussianDerivAt (t ^ α.weight 2) (p 2) v
  let D : ℝ := modelFirstPassiveGaussianWeight α lam p t
    (z 0) (z 1) (z 2) (z 3)
  have hA : (∫ v : ℝ, A v) = modelFirstFiber α f p t z := by
    dsimp [A]
    rw [← modelFirstFiber_eq_integral]
  calc
    ∫ vw : ℝ × ℝ,
        cubeSignedInputProduct (modelFirstCubeTuple f)
          ((cubeActivePassiveSplit 2).symm
            ((vw.1, vw.2), modelFirstPassivePair
              (z 0) (z 1) (z 2) (z 3))) *
          localCubeKernel α 2 lam 0 t p
            ((cubeActivePassiveSplit 2).symm
              ((vw.1, vw.2), modelFirstPassivePair
                (z 0) (z 1) (z 2) (z 3))) =
        ∫ vw : ℝ × ℝ, D * (A vw.1 * A vw.2) := by
          apply integral_congr_ae
          filter_upwards [] with vw
          dsimp [A, D]
          rw [localCubeIntegrand_modelFirst_activePassiveSplit_symm]
          ring
    _ = D * ∫ vw : ℝ × ℝ, A vw.1 * A vw.2 :=
      MeasureTheory.integral_const_mul D _
    _ = D * ((∫ v : ℝ, A v) * ∫ w : ℝ, A w) := by
      congr 1
      rw [Measure.volume_eq_prod]
      exact MeasureTheory.integral_prod_mul A A
    _ = (modelFirstFiber α f p t z) ^ 2 *
        modelFirstPassiveGaussianWeight α lam p t
          (z 0) (z 1) (z 2) (z 3) := by
      rw [hA]
      dsimp [D]
      ring

/-- For the edge tuple, the two third-active cube variables are exactly the
two copies of the one-input second fiber integrand. -/
theorem cubeSignedInputProduct_edgeCubeTuple_activePassiveSplit_symm
    (f : E3 → ℝ) (x₁ x₂ y₁ y₂ v w : ℝ) :
    cubeSignedInputProduct (edgeCubeTuple f)
      ((cubeActivePassiveSplit 2).symm
        ((v, w), modelFirstPassivePair x₁ x₂ y₁ y₂)) =
      f (modelPoint x₁ x₂ v) * f (modelPoint x₁ x₂ w) := by
  have hp0 :
      faceInsert 2 v (cubePassiveProjection 2 (cubePairVertex false false)
        (modelFirstPassivePair x₁ x₂ y₁ y₂)) =
        modelPoint x₁ x₂ v := by
    ext k
    fin_cases k <;>
      simp [modelFirstPassivePair, cubePassiveProjection, faceInsert,
        cubePairVertex, modelPoint]
  have hp1 :
      faceInsert 2 w (cubePassiveProjection 2 (cubePairVertex false true)
        (modelFirstPassivePair x₁ x₂ y₁ y₂)) =
        modelPoint x₁ x₂ w := by
    ext k
    fin_cases k <;>
      simp [modelFirstPassivePair, cubePassiveProjection, faceInsert,
        cubePairVertex, modelPoint]
  rw [cubeSignedInputProduct_edgeCubeTuple,
    cubeProjection_cubeActivePassiveSplit_symm,
    cubeProjection_cubeActivePassiveSplit_symm]
  have h00 : ¬ cubePairVertex false false 2 = true := by
    simp [cubePairVertex]
  have h01 : cubePairVertex false true 2 = true := by
    simp [cubePairVertex]
  simp only [h00, h01, Bool.false_eq_true, ↓reduceIte]
  rw [hp0, hp1]

/-- The fixed-center, fixed-scale edge cube integrand is the product of two
second-fiber integrands and the same passive four-Gaussian weight. -/
theorem localCubeIntegrand_modelSecond_activePassiveSplit_symm
    (α : Anisotropy) (lam r : ℝ) (f : E3 → ℝ)
    (p : E3) (t x₁ x₂ y₁ y₂ v w : ℝ) :
    cubeSignedInputProduct (edgeCubeTuple f)
      ((cubeActivePassiveSplit 2).symm
        ((v, w), modelFirstPassivePair x₁ x₂ y₁ y₂)) *
      localCubeKernel α 2 lam r t p
        ((cubeActivePassiveSplit 2).symm
          ((v, w), modelFirstPassivePair x₁ x₂ y₁ y₂)) =
      (f (modelPoint x₁ x₂ v) *
        gaussianDerivAt (t ^ α.weight 2)
          (p 2 + r * t ^ α.weight 2) v) *
      (f (modelPoint x₁ x₂ w) *
        gaussianDerivAt (t ^ α.weight 2)
          (p 2 + r * t ^ α.weight 2) w) *
      modelFirstPassiveGaussianWeight α lam p t x₁ x₂ y₁ y₂ := by
  rw [cubeSignedInputProduct_edgeCubeTuple_activePassiveSplit_symm,
    localCubeKernel_cubeActivePassiveSplit_symm,
    cubePassiveGaussianKernel_modelFirst]
  simp [cubeGaussianDerivKernel]
  ring

/-- Integrating the two active variables in the edge cube integrand gives
the square of the second fiber, with its fifth model coordinate supplying
the translated third-coordinate center. -/
theorem integral_localCubeIntegrand_modelSecond_active
    (α : Anisotropy) (lam : ℝ) (f : E3 → ℝ)
    (p : E3) (t : ℝ) (z : ModelE5) :
    ∫ vw : ℝ × ℝ,
      cubeSignedInputProduct (edgeCubeTuple f)
        ((cubeActivePassiveSplit 2).symm
          ((vw.1, vw.2), modelFirstPassivePair
            (z 0) (z 1) (z 2) (z 3))) *
        localCubeKernel α 2 lam (z 4) t p
          ((cubeActivePassiveSplit 2).symm
            ((vw.1, vw.2), modelFirstPassivePair
              (z 0) (z 1) (z 2) (z 3))) =
      (modelSecondFiber α f p t z) ^ 2 *
        modelFirstPassiveGaussianWeight α lam p t
          (z 0) (z 1) (z 2) (z 3) := by
  let A : ℝ → ℝ := fun v ↦
    f (modelPoint (z 0) (z 1) v) *
      gaussianDerivAt (t ^ α.weight 2)
        (p 2 + z 4 * t ^ α.weight 2) v
  let D : ℝ := modelFirstPassiveGaussianWeight α lam p t
    (z 0) (z 1) (z 2) (z 3)
  have hA : (∫ v : ℝ, A v) = modelSecondFiber α f p t z := by
    dsimp [A]
    rfl
  calc
    ∫ vw : ℝ × ℝ,
        cubeSignedInputProduct (edgeCubeTuple f)
          ((cubeActivePassiveSplit 2).symm
            ((vw.1, vw.2), modelFirstPassivePair
              (z 0) (z 1) (z 2) (z 3))) *
          localCubeKernel α 2 lam (z 4) t p
            ((cubeActivePassiveSplit 2).symm
              ((vw.1, vw.2), modelFirstPassivePair
                (z 0) (z 1) (z 2) (z 3))) =
        ∫ vw : ℝ × ℝ, D * (A vw.1 * A vw.2) := by
          apply integral_congr_ae
          filter_upwards [] with vw
          dsimp [A, D]
          rw [localCubeIntegrand_modelSecond_activePassiveSplit_symm]
          ring
    _ = D * ∫ vw : ℝ × ℝ, A vw.1 * A vw.2 :=
      MeasureTheory.integral_const_mul D _
    _ = D * ((∫ v : ℝ, A v) * ∫ w : ℝ, A w) := by
      congr 1
      rw [Measure.volume_eq_prod]
      exact MeasureTheory.integral_prod_mul A A
    _ = (modelSecondFiber α f p t z) ^ 2 *
        modelFirstPassiveGaussianWeight α lam p t
          (z 0) (z 1) (z 2) (z 3) := by
      rw [hA]
      dsimp [D]
      ring


/-- A finite collection has finite center--scale measure. -/
theorem isFiniteMeasure_cubeScaleCollection
    (α : Anisotropy) (S : BoxCollection α) :
    IsFiniteMeasure (cubeScaleMeasure.restrict (collectionRegion α S)) := by
  constructor
  rw [Measure.restrict_apply_univ]
  have hcell (q : AnisoBox α) :
      cubeScaleMeasure (boxScaleRegion α q) < ∞ := by
    rw [← Measure.restrict_apply_univ,
      cubeScaleMeasure_restrict_boxScaleRegion]
    let : IsFiniteMeasure
        ((volume.restrict (boxSet α q)).prod
          ((volume.withDensity cubeScaleDensity).restrict (boxScaleBand q))) :=
      isFiniteMeasure_boxScaleCell α q
    exact IsFiniteMeasure.measure_univ_lt_top
  rw [collectionRegion,
    MeasureTheory.measure_biUnion_finset
      (pairwiseDisjoint_boxScaleRegion α S)
      (fun q hq ↦ measurableSet_boxScaleRegion α q)]
  exact ENNReal.sum_lt_top.mpr fun q hq ↦ hcell q

/-- The literal positive local-model density is jointly integrable over every
finite box collection. -/
theorem integrable_modelEnergyDensity_collection
    (α : Anisotropy) (S : BoxCollection α) (u : E3) :
    Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)) := by
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let : IsFiniteMeasure μ := by
    dsimp only [μ]
    exact isFiniteMeasure_cubeScaleCollection α S
  let : SigmaFinite μ := IsFiniteMeasure.toSigmaFinite μ
  let : SFinite (μ.prod (volume : Measure ModelE5)) := by
    infer_instance
  have hpos : ∀ᵐ pt ∂μ, 0 < pt.2 := by
    dsimp only [μ]
    filter_upwards [ae_restrict_mem (measurableSet_collectionRegion α S)]
      with pt hpt
    exact pos_of_mem_closure_collectionRegion α S (subset_closure hpt)
  have hmeas : AEStronglyMeasurable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyDensity α u q.1.1 q.1.2 q.2) (μ.prod volume) :=
    aestronglyMeasurable_modelEnergyDensity α u (μ.prod volume)
  apply (integrable_prod_iff hmeas).mpr
  constructor
  · filter_upwards [hpos] with pt hpt
    exact integrable_modelEnergyDensity α u pt.1 hpt
  · let K : ℝ := (∫ x : ℝ, |conePhiPhysicalReal x|) ^ 2 *
      conePsiPhysicalRealL1
    have hconst : Integrable (fun _ : E3 × ℝ ↦ K) μ := integrable_const _
    refine hconst.congr ?_
    filter_upwards [hpos] with pt hpt
    change K = (∫ z : ModelE5,
      ‖modelEnergyDensity α u pt.1 pt.2 z‖)
    symm
    have hnonneg : ∀ z : ModelE5,
        0 ≤ modelEnergyDensity α u pt.1 pt.2 z :=
      fun z ↦ modelEnergyDensity_nonneg α u pt.1 hpt.le z
    rw [show (fun z : ModelE5 ↦
      ‖modelEnergyDensity α u pt.1 pt.2 z‖) =
        modelEnergyDensity α u pt.1 pt.2 by
      funext z
      rw [Real.norm_eq_abs, abs_of_nonneg (hnonneg z)]]
    exact integral_modelEnergyDensity α u pt.1 hpt

/-- The first literal local Cauchy--Schwarz inequality, with the joint
positive-density localization supplied by the finite collection. -/
theorem expandedModelLocalForm_cauchySchwarz_of_boundedContinuous_local
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (hcmeas : Measurable c)
    (hfcont : ∀ j, Continuous (f j))
    (hfbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    |expandedModelLocalForm α S u c f| ^ 2 ≤
      modelEnergyOne α S u f * modelEnergyTwo α S u (f 3) := by
  exact expandedModelLocalForm_cauchySchwarz_of_boundedContinuous
    α S u c f hcmeas hfcont hfbound
      (integrable_modelEnergyDensity_collection α S u) hc


theorem boxLocalSize_le_stoppingData
    (α : Anisotropy) (S : BoxCollection α) (s : ℝ) (f : E3 → ℝ)
    {q : AnisoBox α} (hq : q ∈ S) :
    boxLocalSize α s f q ≤ stoppingData α S s f q := by
  rw [stoppingData_eq_sup' α S s f hq]
  exact Finset.le_sup' (boxLocalSize α s f)
    (mem_stoppingAncestors α S hq)

/-- Every member of a nonempty finite stopping level lies below a maximal
member of that same level. -/
theorem exists_stoppingRoot_above {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) {q : AnisoBox α}
    (hq : q ∈ stoppingLevel α S s f n) :
    ∃ Q ∈ stoppingRoots α S s f n, boxSet α q ⊆ boxSet α Q := by
  classical
  let L := stoppingLevel α S s f n
  let A := stoppingAncestors α L q
  have hqA : q ∈ A := by
    dsimp [A]
    exact mem_stoppingAncestors α L hq
  obtain ⟨Q, hQA, hmax⟩ := Finset.exists_max_image A AnisoBox.level ⟨q, hqA⟩
  have hQL : Q ∈ L := by
    dsimp [A, stoppingAncestors] at hQA
    exact (Finset.mem_filter.mp hQA).1
  have hqQ : boxSet α q ⊆ boxSet α Q := by
    dsimp [A, stoppingAncestors] at hQA
    exact (Finset.mem_filter.mp hQA).2
  have hQroot : Q ∈ stoppingRoots α S s f n := by
    rw [mem_stoppingRoots_iff]
    refine ⟨hQL, ?_⟩
    intro R hRL hQR
    have hRA : R ∈ A := by
      dsimp [A, stoppingAncestors]
      exact Finset.mem_filter.mpr ⟨hRL, hqQ.trans hQR⟩
    have hRQlevel : R.level ≤ Q.level := hmax R hRA
    have hQRlevel : Q.level ≤ R.level := level_le_of_boxSet_subset α hQR
    have hlevel : Q.level = R.level := le_antisymm hQRlevel hRQlevel
    by_contra hne
    have hdisj := boxSet_disjoint_of_eq_level_of_ne α hlevel (Ne.symm hne)
    obtain ⟨x, hx⟩ := boxSet_nonempty α Q
    exact (Set.disjoint_left.1 hdisj) hx (hQR hx)
  exact ⟨Q, hQroot, hqQ⟩

/-- Distinct stopping roots are spatially disjoint. -/
theorem pairwiseDisjoint_stoppingRoots {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) :
    (↑(stoppingRoots α S s f n) : Set (AnisoBox α)).PairwiseDisjoint
      (boxSet α) := by
  intro Q hQ R hR hne
  apply Set.disjoint_left.2
  intro x hxQ hxR
  rcases (mem_stoppingRoots_iff α S s f n Q).mp hQ with ⟨hQL, hQmax⟩
  rcases (mem_stoppingRoots_iff α S s f n R).mp hR with ⟨hRL, hRmax⟩
  rcases le_total Q.level R.level with hlevel | hlevel
  · have hQR : boxSet α Q ⊆ boxSet α R :=
      boxSet_nested_of_inter_nonempty α hlevel ⟨x, hxQ, hxR⟩
    exact hne (hQmax R hRL hQR).symm
  · have hRQ : boxSet α R ⊆ boxSet α Q :=
      boxSet_nested_of_inter_nonempty α hlevel ⟨x, hxR, hxQ⟩
    exact hne (hRmax Q hQL hRQ)

/-- Distinct stopping trees have no box in common. -/
theorem stoppingTreeBoxes_disjoint_of_ne {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ)
    (Q R : AnisoBox α) (hQ : Q ∈ stoppingRoots α S s f n)
    (hR : R ∈ stoppingRoots α S s f n) (hQR : Q ≠ R) :
    Disjoint (stoppingTreeBoxes α S s f n Q)
      (stoppingTreeBoxes α S s f n R) := by
  rw [Finset.disjoint_left]
  intro q hqQ hqR
  have hqQsub := (mem_stoppingTreeBoxes_iff α S s f n Q q).mp hqQ |>.2
  have hqRsub := (mem_stoppingTreeBoxes_iff α S s f n R q).mp hqR |>.2
  have hrootDisj : Disjoint (boxSet α Q) (boxSet α R) :=
    pairwiseDisjoint_stoppingRoots α S s f n hQ hR hQR
  obtain ⟨x, hx⟩ := boxSet_nonempty α q
  exact (Set.disjoint_left.1 hrootDisj) (hqQsub hx) (hqRsub hx)

theorem pairwiseDisjoint_stoppingTreeBoxes {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) :
    (↑(stoppingRoots α S s f n) : Set (AnisoBox α)).PairwiseDisjoint
      (stoppingTreeBoxes α S s f n) := by
  intro Q hQ R hR hne
  exact stoppingTreeBoxes_disjoint_of_ne α S s f n Q R hQ hR
    hne

/-- The maximal-root trees form an exact finite partition of one stopping
level. -/
theorem stoppingLevel_eq_biUnion_stoppingTreeBoxes {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) :
    stoppingLevel α S s f n =
      (stoppingRoots α S s f n).biUnion
        (stoppingTreeBoxes α S s f n) := by
  classical
  ext q
  constructor
  · intro hq
    rcases exists_stoppingRoot_above α S s f n hq with ⟨Q, hQ, hqQ⟩
    exact Finset.mem_biUnion.mpr ⟨Q, hQ,
      (mem_stoppingTreeBoxes_iff α S s f n Q q).mpr ⟨hq, hqQ⟩⟩
  · intro hq
    rcases Finset.mem_biUnion.mp hq with ⟨Q, hQ, hqQ⟩
    exact (mem_stoppingTreeBoxes_iff α S s f n Q q).mp hqQ |>.1

/-- Any finite sum over a stopping level splits exactly into its maximal-root
tree sums. -/
theorem sum_stoppingLevel_eq_sum_stoppingTrees {d : ℕ}
    {M : Type*} [AddCommMonoid M]
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) (w : AnisoBox α → M) :
    (∑ q ∈ stoppingLevel α S s f n, w q) =
      ∑ Q ∈ stoppingRoots α S s f n,
        ∑ q ∈ stoppingTreeBoxes α S s f n Q, w q := by
  classical
  rw [stoppingLevel_eq_biUnion_stoppingTreeBoxes]
  exact Finset.sum_biUnion (pairwiseDisjoint_stoppingTreeBoxes α S s f n)

/-- The source stopping-tree local-size estimate follows for any convex tree
whose boxes lie in one stopping level. -/
theorem treeLocalSize_le_stoppingLevel {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ)
    (T : FiniteConvexTree α)
    (hT : ∀ q ∈ T.boxes, q ∈ stoppingLevel α S s f n)
    (j : Fin d) :
    treeLocalSize T (s j) (f j) ≤ (2 : ℝ) ^ n j := by
  unfold treeLocalSize
  rw [collectionLocalSize_eq_sup' T.boxes T.nonempty]
  apply Finset.sup'_le
  intro q hq
  have hqlevel := hT q hq
  rw [mem_stoppingLevel_iff] at hqlevel
  exact (boxLocalSize_le_stoppingData α S (s j) (f j) hqlevel.1).trans
    (hqlevel.2 j).2

/-- Every box in a stopping level belongs to the tree of some maximal root. -/
theorem exists_stoppingTree_contains {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ)
    (hconvex : IsConvexCollection α (stoppingLevel α S s f n))
    {q : AnisoBox α} (hq : q ∈ stoppingLevel α S s f n) :
    ∃ Q : {Q : AnisoBox α // Q ∈ stoppingRoots α S s f n},
      q ∈ (stoppingTree α S s f n hconvex Q.1 Q.2).boxes := by
  rcases exists_stoppingRoot_above α S s f n hq with ⟨Q, hQ, hqQ⟩
  refine ⟨⟨Q, hQ⟩, ?_⟩
  rw [stoppingTree_boxes]
  exact (mem_stoppingTreeBoxes_iff α S s f n Q q).mpr ⟨hq, hqQ⟩

/-- The local-size bound of a stopping tree is its upper level threshold. -/
theorem stoppingTreeLocalSize_le {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ)
    (hconvex : IsConvexCollection α (stoppingLevel α S s f n))
    (Q : AnisoBox α) (hQ : Q ∈ stoppingRoots α S s f n)
    (j : Fin d) :
    treeLocalSize (stoppingTree α S s f n hconvex Q hQ) (s j) (f j) ≤
      (2 : ℝ) ^ n j := by
  apply treeLocalSize_le_stoppingLevel α S s f n
    (stoppingTree α S s f n hconvex Q hQ)
  intro q hq
  rw [stoppingTree_boxes] at hq
  exact (mem_stoppingTreeBoxes_iff α S s f n Q q).mp hq |>.1

/-- The fixed-scale comparison behind the source's ancestor-size lower
bound: every point of a box sees at least the stated fraction of its
centered bracket kernel. -/
theorem boxCenterKernel_le_anisotropicBracketKernel
    (α : Anisotropy) (q : AnisoBox α) {p : E3}
    (hp : p ∈ boxClosedSet α q) (y : E3) :
    (2 / 3 : ℝ) ^ 30 *
        anisotropicBracketKernel α (boxLength q) (boxCenter α q) y ≤
      anisotropicBracketKernel α (boxLength q) p y := by
  have hfactor (i : Fin 3) :
      bracketKernelAt (boxLength q ^ α.weight i) (boxCenter α q i) (y i) ≤
        (3 / 2 : ℝ) ^ 10 *
          bracketKernelAt (boxLength q ^ α.weight i) (p i) (y i) := by
    have hcenter : |boxCenter α q i - p i| ≤ boxLength q ^ α.weight i / 2 := by
      rw [abs_sub_comm]
      simpa only [boxSide_eq_length_pow] using
        abs_sub_boxCenter_le_half_side α q hp i
    simpa using bracketKernelAt_le_of_scale_center
      (s := boxLength q ^ α.weight i)
      (L := boxLength q ^ α.weight i) (b := 1)
      (p := boxCenter α q i) (c := p i) (y := y i)
      (pow_pos (boxLength_pos q) _) (pow_pos (boxLength_pos q) _)
      (by simp) le_rfl hcenter
  have hprod :
      anisotropicBracketKernel α (boxLength q) (boxCenter α q) y ≤
        (3 / 2 : ℝ) ^ 30 *
          anisotropicBracketKernel α (boxLength q) p y := by
    unfold anisotropicBracketKernel
    calc
      (∏ i : Fin 3,
          bracketKernelAt (boxLength q ^ α.weight i) (boxCenter α q i) (y i)) ≤
          ∏ i : Fin 3, (3 / 2 : ℝ) ^ 10 *
            bracketKernelAt (boxLength q ^ α.weight i) (p i) (y i) := by
        apply Finset.prod_le_prod₀
        · intro i _
          exact bracketKernelAt_nonneg (pow_pos (boxLength_pos q) _).le
        · intro i _
          exact hfactor i
      _ = (3 / 2 : ℝ) ^ 30 *
          ∏ i : Fin 3,
            bracketKernelAt (boxLength q ^ α.weight i) (p i) (y i) := by
        rw [Finset.prod_mul_distrib]
        norm_num [Finset.prod_const, ← pow_mul]
  calc
    (2 / 3 : ℝ) ^ 30 *
        anisotropicBracketKernel α (boxLength q) (boxCenter α q) y ≤
        (2 / 3 : ℝ) ^ 30 *
          ((3 / 2 : ℝ) ^ 30 *
            anisotropicBracketKernel α (boxLength q) p y) :=
      mul_le_mul_of_nonneg_left hprod (pow_nonneg (by norm_num) _)
    _ = anisotropicBracketKernel α (boxLength q) p y := by
      norm_num
      ring

/-- The exponent-two local power of a box is controlled from below by the
same-scale bracket average at every point of that box. -/
theorem boxLocalPower_two_le_cubeSecondMoment
    (α : Anisotropy) (q : AnisoBox α) {p : E3}
    (hp : p ∈ boxClosedSet α q) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) :
    (2 / 3 : ℝ) ^ 30 * boxLocalPower α 2 f q ≤
      cubeSecondMoment α (boxLength q) p f := by
  rw [← cubeSecondMoment_at_box_eq_boxLocalPower_two α q f]
  let K₀ : E3 → ℝ :=
    anisotropicBracketKernel α (boxLength q) (boxCenter α q)
  let Kp : E3 → ℝ := anisotropicBracketKernel α (boxLength q) p
  have hleft : Integrable (fun y : E3 ↦
      (2 / 3 : ℝ) ^ 30 * (f y ^ 2 * K₀ y)) := by
    exact (integrable_cubeSecondMoment_integrand α (boxLength_pos q)
      (boxCenter α q) f hfcont hfbound).const_mul _
  have hright : Integrable (fun y : E3 ↦ f y ^ 2 * Kp y) := by
    exact integrable_cubeSecondMoment_integrand α (boxLength_pos q)
      p f hfcont hfbound
  have hpointwise (y : E3) :
      (2 / 3 : ℝ) ^ 30 * (f y ^ 2 * K₀ y) ≤ f y ^ 2 * Kp y := by
    have hkernel : (2 / 3 : ℝ) ^ 30 * K₀ y ≤ Kp y := by
      exact boxCenterKernel_le_anisotropicBracketKernel α q hp y
    calc
      (2 / 3 : ℝ) ^ 30 * (f y ^ 2 * K₀ y) =
          f y ^ 2 * ((2 / 3 : ℝ) ^ 30 * K₀ y) := by ring
      _ ≤ f y ^ 2 * Kp y :=
        mul_le_mul_of_nonneg_left hkernel (sq_nonneg _)
  change (2 / 3 : ℝ) ^ 30 *
      (∫ y : E3, f y ^ 2 * K₀ y) ≤ ∫ y : E3, f y ^ 2 * Kp y
  rw [← MeasureTheory.integral_const_mul]
  exact MeasureTheory.integral_mono_ae hleft hright
    (Filter.Eventually.of_forall hpointwise)

/-- The literal exponent-two anisotropic maximal power, before taking the
square root in the maximal size. -/
noncomputable def anisotropicMaximalTwoPower
    (α : Anisotropy) (f : E3 → ℝ) (p : E3) : ℝ :=
  sSup {a : ℝ | ∃ t : ℝ, 0 < t ∧ a = cubeSecondMoment α t p f}

noncomputable def anisotropicMaximalTwo
    (α : Anisotropy) (f : E3 → ℝ) (p : E3) : ℝ :=
  √(anisotropicMaximalTwoPower α f p)

/-- Bounded continuous inputs make the real supremum defining the local
maximal power bounded above. -/
theorem bddAbove_anisotropicMaximalTwoPower
    (α : Anisotropy) (f : E3 → ℝ) (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f y| ≤ B) (p : E3) :
    BddAbove {a : ℝ | ∃ t : ℝ, 0 < t ∧ a = cubeSecondMoment α t p f} := by
  refine ⟨B ^ 2 * (2 / 9 : ℝ) ^ 3, ?_⟩
  rintro a ⟨t, ht, rfl⟩
  let K : E3 → ℝ := anisotropicBracketKernel α t p
  have hleft : Integrable (fun y : E3 ↦ f y ^ 2 * K y) := by
    exact integrable_cubeSecondMoment_integrand α ht p f hfcont
      ⟨B, hB, hfB⟩
  have hright : Integrable (fun y : E3 ↦ B ^ 2 * K y) := by
    exact (integrable_anisotropicBracketKernel α ht p).const_mul _
  have hpointwise (y : E3) : f y ^ 2 * K y ≤ B ^ 2 * K y := by
    have hK : 0 ≤ K y := anisotropicBracketKernel_nonneg α ht.le p y
    have hf2 : f y ^ 2 ≤ B ^ 2 := by
      rw [← sq_abs]
      exact pow_le_pow_left₀ (abs_nonneg _) (hfB y) 2
    exact mul_le_mul_of_nonneg_right hf2 hK
  calc
    cubeSecondMoment α t p f = ∫ y : E3, f y ^ 2 * K y := by rfl
    _ ≤ ∫ y : E3, B ^ 2 * K y :=
      MeasureTheory.integral_mono_ae hleft hright
        (Filter.Eventually.of_forall hpointwise)
    _ = B ^ 2 * ∫ y : E3, K y := by
      rw [MeasureTheory.integral_const_mul]
    _ = B ^ 2 * (2 / 9 : ℝ) ^ 3 := by
      rw [integral_anisotropicBracketKernel α ht p]

theorem cubeSecondMoment_le_anisotropicMaximalTwoPower
    (α : Anisotropy) (f : E3 → ℝ) (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f y| ≤ B)
    (p : E3) {t : ℝ} (ht : 0 < t) :
    cubeSecondMoment α t p f ≤ anisotropicMaximalTwoPower α f p := by
  unfold anisotropicMaximalTwoPower
  apply le_csSup (bddAbove_anisotropicMaximalTwoPower
    α f hfcont B hB hfB p)
  exact ⟨t, ht, rfl⟩

/-- The source ancestor-size estimate in exponent-two power form. -/
theorem boxLocalPower_two_le_anisotropicMaximalTwoPower
    (α : Anisotropy) (q : AnisoBox α) {p : E3}
    (hp : p ∈ boxSet α q) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f y| ≤ B) :
    (2 / 3 : ℝ) ^ 30 * boxLocalPower α 2 f q ≤
      anisotropicMaximalTwoPower α f p := by
  exact (boxLocalPower_two_le_cubeSecondMoment α q
    (boxSet_subset_boxClosedSet α q hp) f hfcont ⟨B, hB, hfB⟩).trans
      (cubeSecondMoment_le_anisotropicMaximalTwoPower α f hfcont
        B hB hfB p (boxLength_pos q))

/-- The exponent-two maximal-size estimate in the exact square-root form
of `lem:maximal_size`. -/
theorem boxLocalSize_two_le_anisotropicMaximalTwo
    (α : Anisotropy) (q : AnisoBox α) {p : E3}
    (hp : p ∈ boxSet α q) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f y| ≤ B) :
    (2 / 3 : ℝ) ^ 15 * boxLocalSize α 2 f q ≤
      anisotropicMaximalTwo α f p := by
  have hsize : 0 ≤ boxLocalSize α 2 f q := by
    unfold boxLocalSize
    exact Real.rpow_nonneg (by
      unfold boxLocalPower
      apply integral_nonneg
      intro y
      exact mul_nonneg (Real.rpow_nonneg (abs_nonneg _) _)
        (anisotropicBracketKernel_nonneg α (boxLength_pos q).le
          (boxCenter α q) y)) _
  have hmax : 0 ≤ anisotropicMaximalTwoPower α f p := by
    calc
      0 ≤ cubeSecondMoment α 1 p f :=
        cubeSecondMoment_nonneg α (by norm_num) p f
      _ ≤ anisotropicMaximalTwoPower α f p :=
        cubeSecondMoment_le_anisotropicMaximalTwoPower α f hfcont
          B hB hfB p (by norm_num)
  apply (sq_le_sq₀
    (mul_nonneg (pow_nonneg (by norm_num) _) hsize)
    (Real.sqrt_nonneg _)).mp
  rw [Real.sq_sqrt hmax]
  calc
    ((2 / 3 : ℝ) ^ 15 * boxLocalSize α 2 f q) ^ 2 =
        (2 / 3 : ℝ) ^ 30 * boxLocalSize α 2 f q ^ 2 := by
      rw [mul_pow]
      norm_num [← pow_mul]
    _ = (2 / 3 : ℝ) ^ 30 * boxLocalPower α 2 f q := by
      rw [boxLocalSize_two_sq_eq_boxLocalPower]
    _ ≤ anisotropicMaximalTwoPower α f p :=
      boxLocalPower_two_le_anisotropicMaximalTwoPower α q hp f
        hfcont B hB hfB

/-- The expanded local form is the finite sum of its literal one-box forms
under the matching outer integrability hypothesis. -/
theorem expandedModelLocalForm_collection_eq_sum_singletons_of_integrable
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict (collectionRegion α S))) :
    expandedModelLocalForm α S u c f =
      ∑ q ∈ S, expandedModelLocalForm α ({q} : BoxCollection α) u c f := by
  unfold expandedModelLocalForm
  simp_rw [collectionRegion_singleton]
  unfold collectionRegion
  rw [Finset.sum_neg_distrib]
  congr 1
  apply MeasureTheory.integral_biUnion_finset
  · intro q hq
    exact measurableSet_boxScaleRegion α q
  · exact pairwiseDisjoint_boxScaleRegion α S
  · intro q hq
    have hsub : boxScaleRegion α q ⊆ collectionRegion α S := by
      intro pt hpt
      unfold collectionRegion
      exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hq, hpt⟩⟩
    apply hint.mono_measure
    exact Measure.restrict_mono hsub le_rfl

/-- The first local energy is a finite sum of one-box energies whenever its
outer energy density is integrable over the collection. -/
theorem modelEnergyOne_collection_eq_sum_singletons_of_integrable
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : ModelRealInput)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      ∫ z : ModelE5,
        (modelFirstFiber α f pt.1 pt.2 z) ^ 2 *
          modelEnergyDensity α u pt.1 pt.2 z)
      (cubeScaleMeasure.restrict (collectionRegion α S))) :
    modelEnergyOne α S u f =
      ∑ q ∈ S, modelEnergyOne α ({q} : BoxCollection α) u f := by
  unfold modelEnergyOne
  simp_rw [collectionRegion_singleton]
  unfold collectionRegion
  apply MeasureTheory.integral_biUnion_finset
  · intro q hq
    exact measurableSet_boxScaleRegion α q
  · exact pairwiseDisjoint_boxScaleRegion α S
  · intro q hq
    have hsub : boxScaleRegion α q ⊆ collectionRegion α S := by
      intro pt hpt
      unfold collectionRegion
      exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hq, hpt⟩⟩
    apply hint.mono_measure
    exact Measure.restrict_mono hsub le_rfl

/-- The second local energy is a finite sum of one-box energies whenever its
outer energy density is integrable over the collection. -/
theorem modelEnergyTwo_collection_eq_sum_singletons_of_integrable
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : E3 → ℝ)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      ∫ z : ModelE5,
        (modelSecondFiber α f pt.1 pt.2 z) ^ 2 *
          modelEnergyDensity α u pt.1 pt.2 z)
      (cubeScaleMeasure.restrict (collectionRegion α S))) :
    modelEnergyTwo α S u f =
      ∑ q ∈ S, modelEnergyTwo α ({q} : BoxCollection α) u f := by
  unfold modelEnergyTwo modelEnergyTwoOn
  simp_rw [collectionRegion_singleton]
  unfold collectionRegion
  apply MeasureTheory.integral_biUnion_finset
  · intro q hq
    exact measurableSet_boxScaleRegion α q
  · exact pairwiseDisjoint_boxScaleRegion α S
  · intro q hq
    have hsub : boxScaleRegion α q ⊆ collectionRegion α S := by
      intro pt hpt
      unfold collectionRegion
      exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hq, hpt⟩⟩
    apply hint.mono_measure
    exact Measure.restrict_mono hsub le_rfl

/-- Exact finite-forest additivity for the expanded local form. The proof
uses only the literal disjoint partition of boxes, so it applies directly to
the stopping trees at a fixed level. -/
theorem expandedModelLocalForm_biUnion_eq_sum_of_integrable
    {ι : Type*} (α : Anisotropy) (I : Finset ι)
    (A : ι → BoxCollection α) (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (hdisj : (↑I : Set ι).PairwiseDisjoint A)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict (collectionRegion α (I.biUnion A)))) :
    expandedModelLocalForm α (I.biUnion A) u c f =
      ∑ i ∈ I, expandedModelLocalForm α (A i) u c f := by
  classical
  calc
    expandedModelLocalForm α (I.biUnion A) u c f =
        ∑ q ∈ I.biUnion A,
          expandedModelLocalForm α ({q} : BoxCollection α) u c f :=
      expandedModelLocalForm_collection_eq_sum_singletons_of_integrable
        α (I.biUnion A) u c f hint
    _ = ∑ i ∈ I, ∑ q ∈ A i,
          expandedModelLocalForm α ({q} : BoxCollection α) u c f :=
      Finset.sum_biUnion hdisj
    _ = ∑ i ∈ I, expandedModelLocalForm α (A i) u c f := by
      apply Finset.sum_congr rfl
      intro i hi
      symm
      apply expandedModelLocalForm_collection_eq_sum_singletons_of_integrable
      have hsub : collectionRegion α (A i) ⊆
          collectionRegion α (I.biUnion A) := by
        intro pt hpt
        rw [collectionRegion] at hpt ⊢
        rcases Set.mem_iUnion.1 hpt with ⟨q, hpt⟩
        rcases Set.mem_iUnion.1 hpt with ⟨hq, hpt⟩
        refine Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨?_, hpt⟩⟩
        exact Finset.mem_biUnion.mpr ⟨i, hi, hq⟩
      apply hint.mono_measure
      exact Measure.restrict_mono hsub le_rfl

/-- The first local energy has the same finite-forest additivity. -/
theorem modelEnergyOne_biUnion_eq_sum_of_integrable
    {ι : Type*} (α : Anisotropy) (I : Finset ι)
    (A : ι → BoxCollection α) (u : E3) (f : ModelRealInput)
    (hdisj : (↑I : Set ι).PairwiseDisjoint A)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      ∫ z : ModelE5,
        (modelFirstFiber α f pt.1 pt.2 z) ^ 2 *
          modelEnergyDensity α u pt.1 pt.2 z)
      (cubeScaleMeasure.restrict (collectionRegion α (I.biUnion A)))) :
    modelEnergyOne α (I.biUnion A) u f =
      ∑ i ∈ I, modelEnergyOne α (A i) u f := by
  classical
  calc
    modelEnergyOne α (I.biUnion A) u f =
        ∑ q ∈ I.biUnion A, modelEnergyOne α ({q} : BoxCollection α) u f :=
      modelEnergyOne_collection_eq_sum_singletons_of_integrable
        α (I.biUnion A) u f hint
    _ = ∑ i ∈ I, ∑ q ∈ A i,
          modelEnergyOne α ({q} : BoxCollection α) u f :=
      Finset.sum_biUnion hdisj
    _ = ∑ i ∈ I, modelEnergyOne α (A i) u f := by
      apply Finset.sum_congr rfl
      intro i hi
      symm
      apply modelEnergyOne_collection_eq_sum_singletons_of_integrable
      have hsub : collectionRegion α (A i) ⊆
          collectionRegion α (I.biUnion A) := by
        intro pt hpt
        rw [collectionRegion] at hpt ⊢
        rcases Set.mem_iUnion.1 hpt with ⟨q, hpt⟩
        rcases Set.mem_iUnion.1 hpt with ⟨hq, hpt⟩
        refine Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨?_, hpt⟩⟩
        exact Finset.mem_biUnion.mpr ⟨i, hi, hq⟩
      apply hint.mono_measure
      exact Measure.restrict_mono hsub le_rfl

/-- The second local energy has the corresponding finite-forest additivity. -/
theorem modelEnergyTwo_biUnion_eq_sum_of_integrable
    {ι : Type*} (α : Anisotropy) (I : Finset ι)
    (A : ι → BoxCollection α) (u : E3) (f : E3 → ℝ)
    (hdisj : (↑I : Set ι).PairwiseDisjoint A)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      ∫ z : ModelE5,
        (modelSecondFiber α f pt.1 pt.2 z) ^ 2 *
          modelEnergyDensity α u pt.1 pt.2 z)
      (cubeScaleMeasure.restrict (collectionRegion α (I.biUnion A)))) :
    modelEnergyTwo α (I.biUnion A) u f =
      ∑ i ∈ I, modelEnergyTwo α (A i) u f := by
  classical
  calc
    modelEnergyTwo α (I.biUnion A) u f =
        ∑ q ∈ I.biUnion A, modelEnergyTwo α ({q} : BoxCollection α) u f :=
      modelEnergyTwo_collection_eq_sum_singletons_of_integrable
        α (I.biUnion A) u f hint
    _ = ∑ i ∈ I, ∑ q ∈ A i,
          modelEnergyTwo α ({q} : BoxCollection α) u f :=
      Finset.sum_biUnion hdisj
    _ = ∑ i ∈ I, modelEnergyTwo α (A i) u f := by
      apply Finset.sum_congr rfl
      intro i hi
      symm
      apply modelEnergyTwo_collection_eq_sum_singletons_of_integrable
      have hsub : collectionRegion α (A i) ⊆
          collectionRegion α (I.biUnion A) := by
        intro pt hpt
        rw [collectionRegion] at hpt ⊢
        rcases Set.mem_iUnion.1 hpt with ⟨q, hpt⟩
        rcases Set.mem_iUnion.1 hpt with ⟨hq, hpt⟩
        refine Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨?_, hpt⟩⟩
        exact Finset.mem_biUnion.mpr ⟨i, hi, hq⟩
      apply hint.mono_measure
      exact Measure.restrict_mono hsub le_rfl

/-- At each stopping vector, the localized form is exactly the sum over its
maximal-root stopping trees. -/
theorem expandedModelLocalForm_stoppingLevel_eq_sum_trees_of_integrable
    {d : ℕ} (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) (u : E3) (c : ℝ → ℝ)
    (F : ModelRealInput)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α F pt.1 pt.2 z *
          modelSecondFiber α (F 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict
        (collectionRegion α (stoppingLevel α S s f n)))) :
    expandedModelLocalForm α (stoppingLevel α S s f n) u c F =
      ∑ Q ∈ stoppingRoots α S s f n,
        expandedModelLocalForm α (stoppingTreeBoxes α S s f n Q) u c F := by
  rw [stoppingLevel_eq_biUnion_stoppingTreeBoxes] at hint ⊢
  exact expandedModelLocalForm_biUnion_eq_sum_of_integrable α
    (stoppingRoots α S s f n) (stoppingTreeBoxes α S s f n) u c F
    (pairwiseDisjoint_stoppingTreeBoxes α S s f n) hint

/-- The first energy has the same exact stopping-tree partition. -/
theorem modelEnergyOne_stoppingLevel_eq_sum_trees_of_integrable
    {d : ℕ} (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) (u : E3) (F : ModelRealInput)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      ∫ z : ModelE5,
        (modelFirstFiber α F pt.1 pt.2 z) ^ 2 *
          modelEnergyDensity α u pt.1 pt.2 z)
      (cubeScaleMeasure.restrict
        (collectionRegion α (stoppingLevel α S s f n)))) :
    modelEnergyOne α (stoppingLevel α S s f n) u F =
      ∑ Q ∈ stoppingRoots α S s f n,
        modelEnergyOne α (stoppingTreeBoxes α S s f n Q) u F := by
  rw [stoppingLevel_eq_biUnion_stoppingTreeBoxes] at hint ⊢
  exact modelEnergyOne_biUnion_eq_sum_of_integrable α
    (stoppingRoots α S s f n) (stoppingTreeBoxes α S s f n) u F
    (pairwiseDisjoint_stoppingTreeBoxes α S s f n) hint

/-- The second energy has the same exact stopping-tree partition. -/
theorem modelEnergyTwo_stoppingLevel_eq_sum_trees_of_integrable
    {d : ℕ} (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) (u : E3) (F : E3 → ℝ)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      ∫ z : ModelE5,
        (modelSecondFiber α F pt.1 pt.2 z) ^ 2 *
          modelEnergyDensity α u pt.1 pt.2 z)
      (cubeScaleMeasure.restrict
        (collectionRegion α (stoppingLevel α S s f n)))) :
    modelEnergyTwo α (stoppingLevel α S s f n) u F =
      ∑ Q ∈ stoppingRoots α S s f n,
        modelEnergyTwo α (stoppingTreeBoxes α S s f n Q) u F := by
  rw [stoppingLevel_eq_biUnion_stoppingTreeBoxes] at hint ⊢
  exact modelEnergyTwo_biUnion_eq_sum_of_integrable α
    (stoppingRoots α S s f n) (stoppingTreeBoxes α S s f n) u F
    (pairwiseDisjoint_stoppingTreeBoxes α S s f n) hint

/-- The scalar fourth moment used to instantiate the `s = 4` branch of the
anisotropic maximal-size estimate. -/
noncomputable def fourthMoment
    (α : Anisotropy) (t : ℝ) (p : E3) (f : E3 → ℝ) : ℝ :=
  ∫ y : E3, |f y| ^ (4 : ℝ) * anisotropicBracketKernel α t p y

/-- Bounded continuous data make the fourth-moment integrand integrable at
every positive anisotropic center--scale point. -/
theorem integrable_fourthMoment_integrand
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) :
    Integrable (fun y : E3 ↦ |f y| ^ (4 : ℝ) *
      anisotropicBracketKernel α t p y) := by
  rcases hfbound with ⟨B, hB, hfB⟩
  let K : E3 → ℝ := anisotropicBracketKernel α t p
  have hK : Integrable K := integrable_anisotropicBracketKernel α ht p
  have hmeas : AEStronglyMeasurable
      (fun y : E3 ↦ |f y| ^ (4 : ℝ) * K y) :=
    ((hfcont.abs.rpow_const (fun _ ↦ Or.inr (by norm_num))).mul
      (continuous_anisotropicBracketKernel α ht p)).aestronglyMeasurable
  refine (hK.const_mul (B ^ (4 : ℝ))).mono hmeas ?_
  filter_upwards [] with y
  have hpow : |f y| ^ (4 : ℝ) ≤ B ^ (4 : ℝ) :=
    Real.rpow_le_rpow (abs_nonneg _) (hfB y) (by norm_num)
  have hKnonneg : 0 ≤ K y :=
    anisotropicBracketKernel_nonneg α ht.le p y
  rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg
    (Real.rpow_nonneg (abs_nonneg _) _) hKnonneg),
    Real.norm_eq_abs, abs_of_nonneg (mul_nonneg
      (Real.rpow_nonneg hB _) hKnonneg)]
  exact mul_le_mul_of_nonneg_right hpow hKnonneg

/-- The fourth moment is nonnegative at every nonnegative scale. -/
theorem fourthMoment_nonneg
    (α : Anisotropy) {t : ℝ} (ht : 0 ≤ t) (p : E3) (f : E3 → ℝ) :
    0 ≤ fourthMoment α t p f := by
  unfold fourthMoment
  apply integral_nonneg
  intro y
  exact mul_nonneg (Real.rpow_nonneg (abs_nonneg _) _)
    (anisotropicBracketKernel_nonneg α ht p y)

/-- At a literal box center and scale, the scalar fourth moment is exactly
the fourth local power. -/
theorem fourthMoment_at_box_eq_boxLocalPower
    (α : Anisotropy) (q : AnisoBox α) (f : E3 → ℝ) :
    fourthMoment α (boxLength q) (boxCenter α q) f =
      boxLocalPower α 4 f q := by
  unfold fourthMoment boxLocalPower
  rfl

/-- The exponent-four maximal power, before taking its literal fourth root.
This is the `s = 4` specialization of the source maximal-size definition. -/
noncomputable def anisotropicMaximalFourPower
    (α : Anisotropy) (f : E3 → ℝ) (p : E3) : ℝ :=
  sSup {a : ℝ | ∃ t : ℝ, 0 < t ∧ a = fourthMoment α t p f}

/-- The literal fourth-root maximal size used in the stopping construction. -/
noncomputable def anisotropicMaximalFour
    (α : Anisotropy) (f : E3 → ℝ) (p : E3) : ℝ :=
  anisotropicMaximalFourPower α f p ^ ((4 : ℝ)⁻¹)

/-- Bounded continuous inputs make the real supremum defining the fourth
maximal power bounded above. -/
theorem bddAbove_anisotropicMaximalFourPower
    (α : Anisotropy) (f : E3 → ℝ) (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f y| ≤ B) (p : E3) :
    BddAbove {a : ℝ | ∃ t : ℝ, 0 < t ∧
      a = fourthMoment α t p f} := by
  refine ⟨B ^ (4 : ℝ) * (2 / 9 : ℝ) ^ 3, ?_⟩
  rintro a ⟨t, ht, rfl⟩
  let K : E3 → ℝ := anisotropicBracketKernel α t p
  have hleft : Integrable (fun y : E3 ↦ |f y| ^ (4 : ℝ) * K y) := by
    simpa [K] using integrable_fourthMoment_integrand α ht p f
      hfcont ⟨B, hB, hfB⟩
  have hright : Integrable (fun y : E3 ↦ B ^ (4 : ℝ) * K y) := by
    exact (integrable_anisotropicBracketKernel α ht p).const_mul _
  have hpointwise (y : E3) :
      |f y| ^ (4 : ℝ) * K y ≤ B ^ (4 : ℝ) * K y := by
    have hK : 0 ≤ K y := anisotropicBracketKernel_nonneg α ht.le p y
    have hpow : |f y| ^ (4 : ℝ) ≤ B ^ (4 : ℝ) :=
      Real.rpow_le_rpow (abs_nonneg _) (hfB y) (by norm_num)
    exact mul_le_mul_of_nonneg_right hpow hK
  calc
    fourthMoment α t p f = ∫ y : E3, |f y| ^ (4 : ℝ) * K y := by rfl
    _ ≤ ∫ y : E3, B ^ (4 : ℝ) * K y :=
      MeasureTheory.integral_mono_ae hleft hright
        (Filter.Eventually.of_forall hpointwise)
    _ = B ^ (4 : ℝ) * ∫ y : E3, K y := by
      rw [MeasureTheory.integral_const_mul]
    _ = B ^ (4 : ℝ) * (2 / 9 : ℝ) ^ 3 := by
      rw [integral_anisotropicBracketKernel α ht p]

/-- Each positive-scale fourth moment is bounded by the literal maximal
power. -/
theorem fourthMoment_le_anisotropicMaximalFourPower
    (α : Anisotropy) (f : E3 → ℝ) (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f y| ≤ B)
    (p : E3) {t : ℝ} (ht : 0 < t) :
    fourthMoment α t p f ≤ anisotropicMaximalFourPower α f p := by
  unfold anisotropicMaximalFourPower
  apply le_csSup (bddAbove_anisotropicMaximalFourPower
    α f hfcont B hB hfB p)
  exact ⟨t, ht, rfl⟩

/-- The fixed-scale comparison gives the fourth-power form of the source
maximal-size estimate on each box. -/
theorem boxLocalPower_four_le_anisotropicMaximalFourPower
    (α : Anisotropy) (q : AnisoBox α) {p : E3}
    (hp : p ∈ boxSet α q) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f y| ≤ B) :
    (2 / 3 : ℝ) ^ 30 * boxLocalPower α 4 f q ≤
      anisotropicMaximalFourPower α f p := by
  let K₀ : E3 → ℝ :=
    anisotropicBracketKernel α (boxLength q) (boxCenter α q)
  let Kp : E3 → ℝ := anisotropicBracketKernel α (boxLength q) p
  have hleft : Integrable (fun y : E3 ↦
      (2 / 3 : ℝ) ^ 30 * (|f y| ^ (4 : ℝ) * K₀ y)) := by
    exact (integrable_fourthMoment_integrand α (boxLength_pos q)
      (boxCenter α q) f hfcont ⟨B, hB, hfB⟩).const_mul _
  have hright : Integrable (fun y : E3 ↦ |f y| ^ (4 : ℝ) * Kp y) := by
    exact integrable_fourthMoment_integrand α (boxLength_pos q)
      p f hfcont ⟨B, hB, hfB⟩
  have hpointwise (y : E3) :
      (2 / 3 : ℝ) ^ 30 * (|f y| ^ (4 : ℝ) * K₀ y) ≤
        |f y| ^ (4 : ℝ) * Kp y := by
    have hkernel : (2 / 3 : ℝ) ^ 30 * K₀ y ≤ Kp y := by
      exact boxCenterKernel_le_anisotropicBracketKernel α q
        (boxSet_subset_boxClosedSet α q hp) y
    calc
      (2 / 3 : ℝ) ^ 30 * (|f y| ^ (4 : ℝ) * K₀ y) =
          |f y| ^ (4 : ℝ) * ((2 / 3 : ℝ) ^ 30 * K₀ y) := by ring
      _ ≤ |f y| ^ (4 : ℝ) * Kp y :=
        mul_le_mul_of_nonneg_left hkernel (Real.rpow_nonneg (abs_nonneg _) _)
  calc
    (2 / 3 : ℝ) ^ 30 * boxLocalPower α 4 f q =
        ∫ y : E3, (2 / 3 : ℝ) ^ 30 *
          (|f y| ^ (4 : ℝ) * K₀ y) := by
            change (2 / 3 : ℝ) ^ 30 *
                (∫ y : E3, |f y| ^ (4 : ℝ) * K₀ y) = _
            rw [← MeasureTheory.integral_const_mul]
    _ ≤ ∫ y : E3, |f y| ^ (4 : ℝ) * Kp y :=
      MeasureTheory.integral_mono_ae hleft hright
        (Filter.Eventually.of_forall hpointwise)
    _ = fourthMoment α (boxLength q) p f := by rfl
    _ ≤ anisotropicMaximalFourPower α f p :=
      fourthMoment_le_anisotropicMaximalFourPower α f hfcont
        B hB hfB p (boxLength_pos q)

/-- Maximal stopping roots which are covered by a measurable region have
total box mass at most the volume of that region. This is the finite,
pairwise-disjoint packing step in the stopping-time argument. -/
theorem sum_boxMass_stoppingRoots_le_measure {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ) (E : Set E3)
    (hcover : ∀ Q ∈ stoppingRoots α S s f n, boxSet α Q ⊆ E) :
    ∑ Q ∈ stoppingRoots α S s f n, ENNReal.ofReal (boxMass α Q) ≤ volume E := by
  calc
    ∑ Q ∈ stoppingRoots α S s f n, ENNReal.ofReal (boxMass α Q) =
        ∑ Q ∈ stoppingRoots α S s f n, volume (boxSet α Q) := by
          apply Finset.sum_congr rfl
          intro Q hQ
          rw [volume_boxSet_eq_boxMass]
    _ = volume (⋃ Q ∈ stoppingRoots α S s f n, boxSet α Q) := by
      symm
      exact MeasureTheory.measure_biUnion_finset
        (pairwiseDisjoint_stoppingRoots α S s f n)
        (fun Q _ ↦ measurableSet_boxSet α Q)
    _ ≤ volume E := by
      apply MeasureTheory.measure_mono
      intro x hx
      rcases Set.mem_iUnion.mp hx with ⟨Q, hx⟩
      rcases Set.mem_iUnion.mp hx with ⟨hQ, hxQ⟩
      exact hcover Q (by simpa using hQ) hxQ

/-- The exponent-four maximal-size estimate in literal fourth-root form.
The comparison constant is kept as the fourth root of the fixed-scale
power constant, which is definitionally suited to the stopping argument. -/
theorem boxLocalSize_four_le_anisotropicMaximalFour
    (α : Anisotropy) (q : AnisoBox α) {p : E3}
    (hp : p ∈ boxSet α q) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f y| ≤ B) :
    ((2 / 3 : ℝ) ^ 30) ^ ((4 : ℝ)⁻¹) * boxLocalSize α 4 f q ≤
      anisotropicMaximalFour α f p := by
  have hpower : 0 ≤ boxLocalPower α 4 f q := by
    unfold boxLocalPower
    apply integral_nonneg
    intro y
    exact mul_nonneg (Real.rpow_nonneg (abs_nonneg (f y)) _)
      (anisotropicBracketKernel_nonneg α (boxLength_pos q).le
        (boxCenter α q) y)
  have hmax : 0 ≤ anisotropicMaximalFourPower α f p := by
    calc
      0 ≤ fourthMoment α 1 p f :=
        fourthMoment_nonneg α (by norm_num) p f
      _ ≤ anisotropicMaximalFourPower α f p :=
        fourthMoment_le_anisotropicMaximalFourPower α f hfcont
          B hB hfB p (by norm_num)
  have hcomparison :
      (2 / 3 : ℝ) ^ 30 * boxLocalPower α 4 f q ≤
        anisotropicMaximalFourPower α f p :=
    boxLocalPower_four_le_anisotropicMaximalFourPower α q hp f
      hfcont B hB hfB
  change ((2 / 3 : ℝ) ^ 30) ^ ((4 : ℝ)⁻¹) *
      (boxLocalPower α 4 f q) ^ ((4 : ℝ)⁻¹) ≤
        (anisotropicMaximalFourPower α f p) ^ ((4 : ℝ)⁻¹)
  rw [← Real.mul_rpow (pow_nonneg (by norm_num) _) hpower]
  exact Real.rpow_le_rpow
    (mul_nonneg (pow_nonneg (by norm_num) _) hpower) hcomparison (by norm_num)

/-- The fourth-root comparison constant is the source constant
`(2/3)^(30/4)`. -/
theorem fourthMaximalComparisonConstant_eq :
    ((2 / 3 : ℝ) ^ 30) ^ ((4 : ℝ)⁻¹) =
      (2 / 3 : ℝ) ^ ((30 : ℝ) / 4) := by
  rw [← Real.rpow_natCast]
  rw [← Real.rpow_mul (by norm_num)]
  congr 1

/-- A finite ancestor supremum inherits any common upper bound after
multiplication by a nonnegative scalar. -/
theorem mul_stoppingData_le_of_ancestor_bound
    (α : Anisotropy) (S : BoxCollection α) (s : ℝ) (f : E3 → ℝ)
    (c M : ℝ) {q : AnisoBox α} (hq : q ∈ S) (hc : 0 ≤ c)
    (hbound : ∀ r ∈ stoppingAncestors α S q,
      c * boxLocalSize α s f r ≤ M) :
    c * stoppingData α S s f q ≤ M := by
  rw [stoppingData_eq_sup' α S s f hq]
  rw [Finset.mul₀_sup' hc (boxLocalSize α s f)
    (stoppingAncestors α S q) (stoppingAncestors_nonempty α S hq)]
  apply Finset.sup'_le
  intro r hr
  exact hbound r hr

/-- The exponent-two stopping datum is pointwise controlled by the
anisotropic maximal size at every point of its box. -/
theorem stoppingData_two_le_anisotropicMaximalTwo
    (α : Anisotropy) (S : BoxCollection α) {q : AnisoBox α}
    (hq : q ∈ S) {p : E3} (hp : p ∈ boxSet α q) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f y| ≤ B) :
    (2 / 3 : ℝ) ^ 15 * stoppingData α S 2 f q ≤
      anisotropicMaximalTwo α f p := by
  classical
  apply mul_stoppingData_le_of_ancestor_bound α S 2 f
    ((2 / 3 : ℝ) ^ 15) (anisotropicMaximalTwo α f p) hq
    (pow_nonneg (by norm_num) _)
  intro r hr
  rw [stoppingAncestors, Finset.mem_filter] at hr
  exact boxLocalSize_two_le_anisotropicMaximalTwo α r (hr.2 hp) f
    hfcont B hB hfB

/-- The exponent-four stopping datum is pointwise controlled by the literal
fourth-root anisotropic maximal size at every point of its box. -/
theorem stoppingData_four_le_anisotropicMaximalFour
    (α : Anisotropy) (S : BoxCollection α) {q : AnisoBox α}
    (hq : q ∈ S) {p : E3} (hp : p ∈ boxSet α q) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f y| ≤ B) :
    ((2 / 3 : ℝ) ^ 30) ^ ((4 : ℝ)⁻¹) * stoppingData α S 4 f q ≤
      anisotropicMaximalFour α f p := by
  classical
  apply mul_stoppingData_le_of_ancestor_bound α S 4 f
    (((2 / 3 : ℝ) ^ 30) ^ ((4 : ℝ)⁻¹))
    (anisotropicMaximalFour α f p) hq
    (Real.rpow_nonneg (pow_nonneg (by norm_num) _) _)
  intro r hr
  rw [stoppingAncestors, Finset.mem_filter] at hr
  exact boxLocalSize_four_le_anisotropicMaximalFour α r (hr.2 hp) f
    hfcont B hB hfB

/-- A stopping root lies in the corresponding maximal superlevel set as
soon as its ancestor datum admits a pointwise maximal bound. -/
theorem stoppingRoot_boxSet_subset_maximalLevel {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ)
    (Q : AnisoBox α) (hQ : Q ∈ stoppingRoots α S s f n)
    (j : Fin d) (c : ℝ) (M : E3 → ℝ) (hc : 0 < c)
    (hdata : ∀ p ∈ boxSet α Q,
      c * stoppingData α S (s j) (f j) Q ≤ M p) :
    boxSet α Q ⊆ {p | c * (2 : ℝ) ^ (n j - 1) < M p} := by
  intro p hp
  have hQlevel : Q ∈ stoppingLevel α S s f n :=
    (mem_stoppingRoots_iff α S s f n Q).mp hQ |>.1
  have hlower : (2 : ℝ) ^ (n j - 1) <
      stoppingData α S (s j) (f j) Q :=
    (mem_stoppingLevel_iff α S s f n Q).mp hQlevel |>.2 j |>.1
  exact (mul_lt_mul_of_pos_left hlower hc).trans_le (hdata p hp)

/-- In the `s = 2` branch, every stopping root is covered by the exact
anisotropic maximal superlevel region used in the finite packing sum. -/
theorem stoppingRoot_two_boxSet_subset_maximalLevel {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ)
    (Q : AnisoBox α) (hQ : Q ∈ stoppingRoots α S s f n)
    (j : Fin d) (hsj : s j = 2)
    (hfcont : Continuous (f j))
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f j y| ≤ B) :
    boxSet α Q ⊆ {p |
      (2 / 3 : ℝ) ^ 15 * (2 : ℝ) ^ (n j - 1) <
        anisotropicMaximalTwo α (f j) p} := by
  apply stoppingRoot_boxSet_subset_maximalLevel α S s f n Q hQ j
    ((2 / 3 : ℝ) ^ 15) (anisotropicMaximalTwo α (f j))
    (pow_pos (by norm_num) _)
  intro p hp
  simpa [hsj] using stoppingData_two_le_anisotropicMaximalTwo
    α S ((mem_stoppingLevel_iff α S s f n Q).mp
      ((mem_stoppingRoots_iff α S s f n Q).mp hQ).1 |>.1) hp (f j)
      hfcont B hB hfB

/-- The same stopping-root coverage is available for the `s = 4` branch. -/
theorem stoppingRoot_four_boxSet_subset_maximalLevel {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ)
    (Q : AnisoBox α) (hQ : Q ∈ stoppingRoots α S s f n)
    (j : Fin d) (hsj : s j = 4)
    (hfcont : Continuous (f j))
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f j y| ≤ B) :
    boxSet α Q ⊆ {p |
      ((2 / 3 : ℝ) ^ 30) ^ ((4 : ℝ)⁻¹) *
          (2 : ℝ) ^ (n j - 1) <
        anisotropicMaximalFour α (f j) p} := by
  apply stoppingRoot_boxSet_subset_maximalLevel α S s f n Q hQ j
    (((2 / 3 : ℝ) ^ 30) ^ ((4 : ℝ)⁻¹))
    (anisotropicMaximalFour α (f j))
    (Real.rpow_pos_of_pos (pow_pos (by norm_num) _) _)
  intro p hp
  simpa [hsj] using stoppingData_four_le_anisotropicMaximalFour
    α S ((mem_stoppingLevel_iff α S s f n Q).mp
      ((mem_stoppingRoots_iff α S s f n Q).mp hQ).1 |>.1) hp (f j)
      hfcont B hB hfB

/-- The pairwise-disjoint roots of an exponent-two stopping level satisfy
the finite maximal-superlevel packing bound. -/
theorem sum_boxMass_stoppingRoots_two_le_maximalLevelMeasure {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ)
    (j : Fin d) (hsj : s j = 2)
    (hfcont : Continuous (f j))
    (B : ℝ) (hB : 0 ≤ B) (hfB : ∀ y, |f j y| ≤ B) :
    ∑ Q ∈ stoppingRoots α S s f n, ENNReal.ofReal (boxMass α Q) ≤
      volume {p |
        (2 / 3 : ℝ) ^ 15 * (2 : ℝ) ^ (n j - 1) <
          anisotropicMaximalTwo α (f j) p} := by
  apply sum_boxMass_stoppingRoots_le_measure α S s f n
  intro Q hQ
  exact stoppingRoot_two_boxSet_subset_maximalLevel α S s f n Q hQ
    j hsj hfcont B hB hfB

/-- The corresponding finite packing bound for the exponent-four stopping
branch. -/
theorem sum_boxMass_stoppingRoots_four_le_maximalLevelMeasure {d : ℕ}
    (α : Anisotropy) (S : BoxCollection α) (s : Fin d → ℝ)
    (f : Fin d → E3 → ℝ) (n : Fin d → ℤ)
    (j : Fin d) (hsj : s j = 4)
    (hfcont : Continuous (f j))
