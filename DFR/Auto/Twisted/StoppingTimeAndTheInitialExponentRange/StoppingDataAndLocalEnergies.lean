/-- Reorder `X × (Y × ℝ)` directly into the source-scale outer order
`ℝ × (X × Y)`. -/
noncomputable def outerLambdaShuffleRight
    (X Y : Type*) [MeasurableSpace X] [MeasurableSpace Y] :
    X × (Y × ℝ) ≃ᵐ ℝ × (X × Y) :=
  (MeasurableEquiv.prodAssoc.symm : X × (Y × ℝ) ≃ᵐ ((X × Y) × ℝ)).trans
    (MeasurableEquiv.prodComm : ((X × Y) × ℝ) ≃ᵐ ℝ × (X × Y))

@[simp] theorem outerLambdaShuffleRight_apply
    (X Y : Type*) [MeasurableSpace X] [MeasurableSpace Y]
    (x : X) (y : Y) (lam : ℝ) :
    outerLambdaShuffleRight X Y (x, (y, lam)) = (lam, (x, y)) := by
  simp [outerLambdaShuffleRight, MeasurableEquiv.prodAssoc,
    MeasurableEquiv.prodComm]

@[simp] theorem outerLambdaShuffleRight_symm_apply
    (X Y : Type*) [MeasurableSpace X] [MeasurableSpace Y]
    (lam : ℝ) (xy : X × Y) :
    (outerLambdaShuffleRight X Y).symm (lam, xy) =
      (xy.1, (xy.2, lam)) := by
  apply (outerLambdaShuffleRight X Y).injective
  rw [MeasurableEquiv.apply_symm_apply]
  exact (outerLambdaShuffleRight_apply X Y xy.1 xy.2 lam).symm

/-- The right-associated outer source-scale shuffle preserves its literal
product measures. -/
theorem outerLambdaShuffleRight_measurePreserving
    {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    (μ : Measure X) (ν : Measure Y) [SFinite μ] [SFinite ν] :
    MeasurePreserving (outerLambdaShuffleRight X Y)
      (μ.prod (ν.prod ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))))
      (((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))).prod (μ.prod ν)) := by
  let lamμ : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  have h1 : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm : X × (Y × ℝ) ≃ᵐ ((X × Y) × ℝ))
      (μ.prod (ν.prod lamμ)) ((μ.prod ν).prod lamμ) :=
    (measurePreserving_prodAssoc μ ν lamμ).symm
  have h2 : MeasurePreserving
      (MeasurableEquiv.prodComm : ((X × Y) × ℝ) ≃ᵐ ℝ × (X × Y))
      ((μ.prod ν).prod lamμ) (lamμ.prod (μ.prod ν)) :=
    Measure.measurePreserving_swap
  change MeasurePreserving (outerLambdaShuffleRight X Y)
    (μ.prod (ν.prod lamμ)) (lamμ.prod (μ.prod ν))
  convert h1.trans h2 using 1
  funext q
  rfl

/-- Fubini after the directly right-associated outer source-scale shuffle. -/
theorem integral_outerLambdaShuffleRight
    {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    (μ : Measure X) (ν : Measure Y) [SFinite μ] [SFinite ν]
    (G : X × (Y × ℝ) → ℝ)
    (hG : Integrable G
      (μ.prod (ν.prod ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))))) :
    ∫ q : X × (Y × ℝ), G q
      ∂(μ.prod (ν.prod ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))))) =
      ∫ lam in Set.Ici (1 : ℝ),
        ∫ xy : X × Y, G (xy.1, (xy.2, lam)) ∂(μ.prod ν) := by
  let lamμ : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let e := outerLambdaShuffleRight X Y
  have hmp : MeasurePreserving e (μ.prod (ν.prod lamμ))
      (lamμ.prod (μ.prod ν)) := by
    simpa only [e, lamμ] using
      outerLambdaShuffleRight_measurePreserving μ ν
  have htrans : Integrable (fun q : ℝ × (X × Y) ↦ G (e.symm q))
      (lamμ.prod (μ.prod ν)) := by
    exact (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hG
  calc
    ∫ q : X × (Y × ℝ), G q ∂(μ.prod (ν.prod lamμ)) =
        ∫ q : ℝ × (X × Y), G (e.symm q) ∂(lamμ.prod (μ.prod ν)) := by
          symm
          exact (MeasurePreserving.symm e hmp).integral_comp' G
    _ = ∫ lam : ℝ, ∫ xy : X × Y, G (e.symm (lam, xy)) ∂(μ.prod ν) ∂lamμ :=
      MeasureTheory.integral_prod _ htrans
    _ = _ := by
      apply integral_congr_ae
      filter_upwards [] with lam
      apply integral_congr_ae
      filter_upwards [] with xy
      rw [outerLambdaShuffleRight_symm_apply]

/-- The measure-generic version of the right-associated outer-variable
shuffle. -/
noncomputable def outerProductShuffleRight
    (X Y Z : Type*) [MeasurableSpace X] [MeasurableSpace Y]
    [MeasurableSpace Z] :
    X × (Y × Z) ≃ᵐ Z × (X × Y) :=
  (MeasurableEquiv.prodAssoc.symm : X × (Y × Z) ≃ᵐ ((X × Y) × Z)).trans
    (MeasurableEquiv.prodComm : ((X × Y) × Z) ≃ᵐ Z × (X × Y))

@[simp] theorem outerProductShuffleRight_apply
    (X Y Z : Type*) [MeasurableSpace X] [MeasurableSpace Y]
    [MeasurableSpace Z] (x : X) (y : Y) (z : Z) :
    outerProductShuffleRight X Y Z (x, (y, z)) = (z, (x, y)) := by
  simp [outerProductShuffleRight, MeasurableEquiv.prodAssoc,
    MeasurableEquiv.prodComm]

@[simp] theorem outerProductShuffleRight_symm_apply
    (X Y Z : Type*) [MeasurableSpace X] [MeasurableSpace Y]
    [MeasurableSpace Z] (z : Z) (xy : X × Y) :
    (outerProductShuffleRight X Y Z).symm (z, xy) =
      (xy.1, (xy.2, z)) := by
  apply (outerProductShuffleRight X Y Z).injective
  rw [MeasurableEquiv.apply_symm_apply]
  exact (outerProductShuffleRight_apply X Y Z xy.1 xy.2 z).symm

/-- The generic outer-variable shuffle is measure preserving. -/
theorem outerProductShuffleRight_measurePreserving
    {X Y Z : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    [MeasurableSpace Z] (μ : Measure X) (ν : Measure Y) (ρ : Measure Z)
    [SFinite μ] [SFinite ν] [SFinite ρ] :
    MeasurePreserving (outerProductShuffleRight X Y Z)
      (μ.prod (ν.prod ρ)) (ρ.prod (μ.prod ν)) := by
  have h1 : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm : X × (Y × Z) ≃ᵐ ((X × Y) × Z))
      (μ.prod (ν.prod ρ)) ((μ.prod ν).prod ρ) :=
    (measurePreserving_prodAssoc μ ν ρ).symm
  have h2 : MeasurePreserving
      (MeasurableEquiv.prodComm : ((X × Y) × Z) ≃ᵐ Z × (X × Y))
      ((μ.prod ν).prod ρ) (ρ.prod (μ.prod ν)) :=
    Measure.measurePreserving_swap
  change MeasurePreserving (outerProductShuffleRight X Y Z)
    (μ.prod (ν.prod ρ)) (ρ.prod (μ.prod ν))
  convert h1.trans h2 using 1
  funext q
  rfl

/-- Fubini after the generic right-associated product shuffle. -/
theorem integral_outerProductShuffleRight
    {X Y Z : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    [MeasurableSpace Z] (μ : Measure X) (ν : Measure Y) (ρ : Measure Z)
    [SFinite μ] [SFinite ν] [SFinite ρ] (G : X × (Y × Z) → ℝ)
    (hG : Integrable G (μ.prod (ν.prod ρ))) :
    ∫ q : X × (Y × Z), G q ∂(μ.prod (ν.prod ρ)) =
      ∫ z : Z, ∫ xy : X × Y, G (xy.1, (xy.2, z)) ∂(μ.prod ν) ∂ρ := by
  let e := outerProductShuffleRight X Y Z
  have hmp : MeasurePreserving e (μ.prod (ν.prod ρ)) (ρ.prod (μ.prod ν)) := by
    simpa only [e] using outerProductShuffleRight_measurePreserving μ ν ρ
  have htrans : Integrable (fun q : Z × (X × Y) ↦ G (e.symm q))
      (ρ.prod (μ.prod ν)) := by
    exact (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hG
  calc
    ∫ q : X × (Y × Z), G q ∂(μ.prod (ν.prod ρ)) =
        ∫ q : Z × (X × Y), G (e.symm q) ∂(ρ.prod (μ.prod ν)) := by
          symm
          exact (MeasurePreserving.symm e hmp).integral_comp' G
    _ = ∫ z : Z, ∫ xy : X × Y, G (e.symm (z, xy)) ∂(μ.prod ν) ∂ρ :=
      MeasureTheory.integral_prod _ htrans
    _ = _ := by
      apply integral_congr_ae
      filter_upwards [] with z
      apply integral_congr_ae
      filter_upwards [] with xy
      rw [outerProductShuffleRight_symm_apply]

/-- The first-energy superposition has the literal outer source-scale Fubini
identity once its joint integrand is integrable. -/
theorem outerFirstSuperposition_eq_cubeComparison
    (α : Anisotropy) (S : BoxCollection α) (u : E3)
    (f : ModelRealInput) (b : Bool)
    (hFcont : ∀ j, Continuous (modelFirstCubeTuple f j))
    (hFbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |modelFirstCubeTuple f j y| ≤ B)
    (hsuper : Integrable (modelFirstSuperpositionJoint α u f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        ((volume : Measure ModelE5).prod
          ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))))) :
    (∫ pt : E3 × ℝ,
      ∫ q : ModelE5 × ℝ,
        modelFirstSuperpositionJoint α u f (pt, q)
        ∂((volume : Measure ModelE5).prod
          ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))))
      ∂(cubeScaleMeasure.restrict (collectionRegion α S))) =
      conePsiPhysicalRealL1 *
        ∫ lam in Set.Ici (1 : ℝ),
          localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
            lam ^ (-47 : ℝ) := by
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let η : Measure ModelE5 := volume
  let e := outerLambdaShuffleRight (E3 × ℝ) ModelE5
  let : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  have hmp : MeasurePreserving e (μ.prod (η.prod ν)) (ν.prod (μ.prod η)) := by
    simpa only [e, μ, η, ν] using
      outerLambdaShuffleRight_measurePreserving μ η
  have htrans : Integrable (fun q : ℝ × ((E3 × ℝ) × ModelE5) ↦
      modelFirstSuperpositionJoint α u f
        (e.symm q)) (ν.prod (μ.prod η)) := by
    exact (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hsuper
  have hfib : ∀ᵐ lam ∂ν, Integrable (fun xy : (E3 × ℝ) × ModelE5 ↦
      modelFirstSuperpositionJoint α u f
        (xy.1, (xy.2, lam))) (μ.prod η) := by
    have h := (MeasureTheory.integrable_prod_iff htrans.aestronglyMeasurable).mp
      htrans
    filter_upwards [h.1] with lam hlamint
    refine hlamint.congr ?_
    filter_upwards [] with xy
    rw [outerLambdaShuffleRight_symm_apply]
  have hlam : ∀ᵐ lam ∂ν, 1 ≤ lam := by
    filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
    exact hlam
  have hprod :
      (∫ pt : E3 × ℝ,
        ∫ q : ModelE5 × ℝ,
          modelFirstSuperpositionJoint α u f (pt, q)
          ∂(η.prod ν)
        ∂μ) =
        ∫ q : (E3 × ℝ) × (ModelE5 × ℝ),
          modelFirstSuperpositionJoint α u f q ∂(μ.prod (η.prod ν)) := by
    exact (MeasureTheory.integral_prod _ hsuper).symm
  calc
    (∫ pt : E3 × ℝ,
        ∫ q : ModelE5 × ℝ,
          modelFirstSuperpositionJoint α u f (pt, q)
          ∂((volume : Measure ModelE5).prod
            ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))))
        ∂(cubeScaleMeasure.restrict (collectionRegion α S))) =
        (∫ pt : E3 × ℝ,
          ∫ q : ModelE5 × ℝ,
            modelFirstSuperpositionJoint α u f (pt, q)
            ∂(η.prod ν)
          ∂μ) := by rfl
    _ = ∫ q : (E3 × ℝ) × (ModelE5 × ℝ),
        modelFirstSuperpositionJoint α u f q ∂(μ.prod (η.prod ν)) := hprod
    _ = ∫ lam in Set.Ici (1 : ℝ),
        ∫ xy : (E3 × ℝ) × ModelE5,
          modelFirstSuperpositionJoint α u f
            (xy.1, (xy.2, lam)) ∂(μ.prod η) := by
      simpa only [μ, η, ν] using
        integral_outerLambdaShuffleRight μ η
          (modelFirstSuperpositionJoint α u f) hsuper
    _ = ∫ lam in Set.Ici (1 : ℝ),
        conePsiPhysicalRealL1 *
          localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
            lam ^ (-47 : ℝ) := by
      apply integral_congr_ae
      filter_upwards [hfib, hlam] with lam hlamint hlam
      have hpassive := integrable_modelFirstPassiveSquare
        α S lam f b hFcont hFbound hlam
      calc
        ∫ xy : (E3 × ℝ) × ModelE5,
            modelFirstSuperpositionJoint α u f
              (xy.1, (xy.2, lam)) ∂(μ.prod η) =
            ∫ pt : E3 × ℝ,
              ∫ z : ModelE5,
                modelFirstSuperpositionJoint α u f
                  (pt, (z, lam)) ∂η ∂μ :=
              MeasureTheory.integral_prod _ hlamint
        _ = ∫ pt : E3 × ℝ,
              ((∫ y : TransverseSpace 2 × TransverseSpace 2,
                cubePassiveGaussianKernel α 2 lam 0 pt.2 pt.1 y *
                  (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) b
                    ((pt.1, pt.2), y)) ^ 2
                ∂((volume : Measure (TransverseSpace 2)).prod
                  (volume : Measure (TransverseSpace 2)))) *
                conePsiPhysicalRealL1) * lam ^ (-47 : ℝ) ∂μ := by
              apply integral_congr_ae
              filter_upwards [] with pt
              calc
                ∫ z : ModelE5,
                    modelFirstSuperpositionJoint α u f
                      (pt, (z, lam)) ∂η =
                    (∫ z : ModelE5,
                      (modelFirstFiber α f pt.1 pt.2 z) ^ 2 *
                        |conePsiPhysicalReal (z 4 + u 2)| *
                        modelFirstPassiveGaussianWeight α lam pt.1 pt.2
                          (z 0) (z 1) (z 2) (z 3)) * lam ^ (-47 : ℝ) := by
                      rw [← MeasureTheory.integral_mul_const]
                      apply integral_congr_ae
                      filter_upwards [] with z
                      dsimp only [modelFirstSuperpositionJoint,
                        modelFirstSuperpositionIntegrand]
                _ = _ := by
                  rw [integral_modelFirstFiber_sq_psi_passiveWeight
                    α lam f b pt.1 pt.2 (u 2)]
        _ = conePsiPhysicalRealL1 *
            (∫ pt : E3 × ℝ,
              ∫ y : TransverseSpace 2 × TransverseSpace 2,
                cubePassiveGaussianKernel α 2 lam 0 pt.2 pt.1 y *
                  (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) b
                    ((pt.1, pt.2), y)) ^ 2
                ∂((volume : Measure (TransverseSpace 2)).prod
                  (volume : Measure (TransverseSpace 2))) ∂μ) *
              lam ^ (-47 : ℝ) := by
                rw [show (∫ pt : E3 × ℝ,
                    ((∫ y : TransverseSpace 2 × TransverseSpace 2,
                      cubePassiveGaussianKernel α 2 lam 0 pt.2 pt.1 y *
                        (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) b
                          ((pt.1, pt.2), y)) ^ 2
                      ∂((volume : Measure (TransverseSpace 2)).prod
                        (volume : Measure (TransverseSpace 2)))) *
                      conePsiPhysicalRealL1) * lam ^ (-47 : ℝ) ∂μ) =
                    (conePsiPhysicalRealL1 * lam ^ (-47 : ℝ)) *
                      ∫ pt : E3 × ℝ,
                        ∫ y : TransverseSpace 2 × TransverseSpace 2,
                          cubePassiveGaussianKernel α 2 lam 0 pt.2 pt.1 y *
                            (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) b
                              ((pt.1, pt.2), y)) ^ 2
                          ∂((volume : Measure (TransverseSpace 2)).prod
                            (volume : Measure (TransverseSpace 2))) ∂μ by
                      rw [← MeasureTheory.integral_const_mul]
                      apply integral_congr_ae
                      filter_upwards [] with pt
                      ring]
                ring
        _ = conePsiPhysicalRealL1 *
            localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
              lam ^ (-47 : ℝ) := by
                rw [← (MeasureTheory.integral_prod _ hpassive)]
                rw [← localCubeForm_modelFirst_eq_passiveSquare
                  α S lam f b hFcont hFbound hlam]
    _ = conePsiPhysicalRealL1 *
        ∫ lam in Set.Ici (1 : ℝ),
          localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
            lam ^ (-47 : ℝ) := by
              rw [← MeasureTheory.integral_const_mul]
              apply integral_congr_ae
              filter_upwards [] with lam
              ring

