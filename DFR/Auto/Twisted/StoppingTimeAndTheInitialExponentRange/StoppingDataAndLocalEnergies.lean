/-- A one-dimensional order-fifty decay estimate is stable under translation,
with the precise polynomial loss used for the annular cutoff. -/
theorem translated_orderFifty_decay (f : ℝ → ℝ)
    (hdecay : ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      (1 + |x|) ^ 50 * |f x| ≤ C) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (r a : ℝ),
      |f (r + a)| ≤ C * (1 + |a|) ^ 50 / (1 + |r|) ^ 50 := by
  rcases hdecay with ⟨C, hC, hdecay⟩
  refine ⟨C, hC, ?_⟩
  intro r a
  have hr : |r| ≤ |r + a| + |a| := by
    calc
      |r| = |(r + a) + (-a)| := congrArg abs (by ring)
      _ ≤ |r + a| + |-a| := abs_add_le _ _
      _ = |r + a| + |a| := by rw [abs_neg]
  have hWnonneg : 0 ≤ 1 + |a| := by positivity
  have hB : 1 + |r| ≤ (1 + |a|) * (1 + |r + a|) := by
    nlinarith [mul_nonneg (abs_nonneg a) (abs_nonneg (r + a))]
  have hBpow : (1 + |r|) ^ 50 ≤
      (1 + |a|) ^ 50 * (1 + |r + a|) ^ 50 := by
    calc
      (1 + |r|) ^ 50 ≤ ((1 + |a|) * (1 + |r + a|)) ^ 50 :=
        pow_le_pow_left₀ (by positivity) hB 50
      _ = (1 + |a|) ^ 50 * (1 + |r + a|) ^ 50 := by rw [mul_pow]
  apply (le_div_iff₀ (pow_pos (by positivity) _)).mpr
  calc
    |f (r + a)| * (1 + |r|) ^ 50 ≤
        |f (r + a)| * ((1 + |a|) ^ 50 * (1 + |r + a|) ^ 50) :=
      mul_le_mul_of_nonneg_left hBpow (abs_nonneg _)
    _ = (1 + |a|) ^ 50 * ((1 + |r + a|) ^ 50 * |f (r + a)|) := by ring
    _ ≤ (1 + |a|) ^ 50 * C :=
      mul_le_mul_of_nonneg_left (hdecay (r + a)) (pow_nonneg hWnonneg _)
    _ = C * (1 + |a|) ^ 50 := by ring

/-- The annular spatial cutoff obeys the two signed translation bounds in
the final clause of `lem:domination`. -/
theorem conePsiPhysicalReal_translate_decay :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (r : ℝ) (u : E3),
      |conePsiPhysicalReal (r + u 2)| ≤
          C * sourceWeight u ^ 50 * translationWeight r ^ (-50 : ℝ) ∧
      |conePsiPhysicalReal (r - u 2)| ≤
          C * sourceWeight u ^ 50 * translationWeight r ^ (-50 : ℝ) := by
  rcases conePsiPhysicalReal_decay 50 with ⟨C, hC, hdecay⟩
  have hdecay' : ∀ x : ℝ, (1 + |x|) ^ 50 * |conePsiPhysicalReal x| ≤ C := by
    intro x
    simpa [mul_comm] using
      (le_div_iff₀ (pow_pos (by positivity) _)).mp (hdecay x)
  rcases translated_orderFifty_decay conePsiPhysicalReal ⟨C, hC, hdecay'⟩ with
    ⟨C', hC', htranslate⟩
  refine ⟨C', hC', ?_⟩
  intro r u
  have hu : 1 + |u 2| ≤ sourceWeight u := by
    unfold sourceWeight
    nlinarith [abs_nonneg (u 0), abs_nonneg (u 1)]
  have hupow : (1 + |u 2|) ^ 50 ≤ sourceWeight u ^ 50 :=
    pow_le_pow_left₀ (by positivity) hu 50
  have hRpos : 0 < translationWeight r := by
    unfold translationWeight
    positivity
  have hdenom : (1 + |r|) ^ 50 ≠ 0 := pow_ne_zero _ (by positivity)
  constructor
  · calc
      |conePsiPhysicalReal (r + u 2)| ≤
          C' * (1 + |u 2|) ^ 50 / (1 + |r|) ^ 50 := htranslate r (u 2)
      _ ≤ C' * sourceWeight u ^ 50 / (1 + |r|) ^ 50 := by
        apply (div_le_div_iff_of_pos_right (pow_pos (by positivity) _)).mpr
        exact mul_le_mul_of_nonneg_left hupow hC'
      _ = C' * sourceWeight u ^ 50 * translationWeight r ^ (-50 : ℝ) := by
        unfold translationWeight
        rw [div_eq_mul_inv]
        congr 1
        rw [show (-50 : ℝ) = -(50 : ℝ) by norm_num,
          Real.rpow_neg (by positivity)]
        exact congrArg (fun x : ℝ ↦ x⁻¹)
          (Real.rpow_natCast (1 + |r|) 50).symm
  · have hminus := htranslate r (-(u 2))
    rw [show r + -(u 2) = r - u 2 by ring, abs_neg] at hminus
    calc
      |conePsiPhysicalReal (r - u 2)| ≤
          C' * (1 + |u 2|) ^ 50 / (1 + |r|) ^ 50 := hminus
      _ ≤ C' * sourceWeight u ^ 50 / (1 + |r|) ^ 50 := by
        apply (div_le_div_iff_of_pos_right (pow_pos (by positivity) _)).mpr
        exact mul_le_mul_of_nonneg_left hupow hC'
      _ = C' * sourceWeight u ^ 50 * translationWeight r ^ (-50 : ℝ) := by
        unfold translationWeight
        rw [div_eq_mul_inv]
        congr 1
        rw [show (-50 : ℝ) = -(50 : ℝ) by norm_num,
          Real.rpow_neg (by positivity)]
        exact congrArg (fun x : ℝ ↦ x⁻¹)
          (Real.rpow_natCast (1 + |r|) 50).symm

