  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let η : Measure ModelE5 := volume
  let κ : Measure (TransverseSpace 2 × TransverseSpace 2) :=
    (volume : Measure (TransverseSpace 2)).prod volume
  let e := outerLambdaShuffleRight (E3 × ℝ) ModelE5
  let : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  have hmp : MeasurePreserving e (μ.prod (η.prod ν)) (ν.prod (μ.prod η)) := by
    simpa only [e, μ, η, ν] using
      outerLambdaShuffleRight_measurePreserving μ η
  have htrans : Integrable (fun q : ℝ × ((E3 × ℝ) × ModelE5) ↦
      modelSecondSuperpositionJoint α f (e.symm q))
      (ν.prod (μ.prod η)) := by
    exact (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hsuper
  have hfib : ∀ᵐ lam ∂ν, Integrable (fun xy : (E3 × ℝ) × ModelE5 ↦
      modelSecondSuperpositionJoint α f (xy.1, (xy.2, lam)))
      (μ.prod η) := by
    have h := (MeasureTheory.integrable_prod_iff htrans.aestronglyMeasurable).mp
      htrans
    filter_upwards [h.1] with lam hlamint
    refine hlamint.congr ?_
    filter_upwards [] with xy
    rw [outerLambdaShuffleRight_symm_apply]
  have hlam : ∀ᵐ lam ∂ν, 1 ≤ lam := by
    filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
    exact hlam
  have hprod :
      (∫ pt : E3 × ℝ,
        ∫ q : ModelE5 × ℝ,
          modelSecondSuperpositionJoint α f (pt, q)
          ∂(η.prod ν) ∂μ) =
        ∫ q : (E3 × ℝ) × (ModelE5 × ℝ),
          modelSecondSuperpositionJoint α f q ∂(μ.prod (η.prod ν)) := by
    exact (MeasureTheory.integral_prod _ hsuper).symm
  calc
    (∫ pt : E3 × ℝ,
        ∫ q : ModelE5 × ℝ,
          modelSecondSuperpositionJoint α f (pt, q)
          ∂((volume : Measure ModelE5).prod
            ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))))
        ∂(cubeScaleMeasure.restrict (collectionRegion α S))) =
        (∫ pt : E3 × ℝ,
          ∫ q : ModelE5 × ℝ,
            modelSecondSuperpositionJoint α f (pt, q)
            ∂(η.prod ν) ∂μ) := by rfl
    _ = ∫ q : (E3 × ℝ) × (ModelE5 × ℝ),
        modelSecondSuperpositionJoint α f q ∂(μ.prod (η.prod ν)) := hprod
    _ = ∫ lam in Set.Ici (1 : ℝ),
        ∫ xy : (E3 × ℝ) × ModelE5,
          modelSecondSuperpositionJoint α f
            (xy.1, (xy.2, lam)) ∂(μ.prod η) := by
      simpa only [μ, η, ν] using
        integral_outerLambdaShuffleRight μ η
          (modelSecondSuperpositionJoint α f) hsuper
    _ = ∫ lam in Set.Ici (1 : ℝ),
        ∫ w : (E3 × ℝ) ×
          ((TransverseSpace 2 × TransverseSpace 2) × ℝ),
          cubePassiveGaussianKernel α 2 lam w.2.2 w.1.2 w.1.1 w.2.1 *
            (cubeActiveCSAverage α 2 lam w.2.2 (edgeCubeTuple f) b
              ((w.1.1, w.1.2), w.2.1)) ^ 2 *
            translationWeight w.2.2 ^ (-50 : ℝ) * lam ^ (-47 : ℝ)
          ∂(μ.prod (κ.prod volume)) := by
      apply integral_congr_ae
      filter_upwards [hfib] with lam hlamint
      have hpassive := integrable_modelSecondSuperposition_passive_at_scale
        α S lam f b hlamint
      calc
        ∫ xy : (E3 × ℝ) × ModelE5,
            modelSecondSuperpositionJoint α f
              (xy.1, (xy.2, lam)) ∂(μ.prod η) =
            ∫ pt : E3 × ℝ,
              ∫ z : ModelE5,
                modelSecondSuperpositionJoint α f
                  (pt, (z, lam)) ∂η ∂μ :=
              MeasureTheory.integral_prod _ hlamint
        _ = ∫ pt : E3 × ℝ,
              ∫ q : (TransverseSpace 2 × TransverseSpace 2) × ℝ,
                cubePassiveGaussianKernel α 2 lam q.2 pt.2 pt.1 q.1 *
                  (cubeActiveCSAverage α 2 lam q.2 (edgeCubeTuple f) b
                    ((pt.1, pt.2), q.1)) ^ 2 *
                  translationWeight q.2 ^ (-50 : ℝ) * lam ^ (-47 : ℝ)
                ∂(κ.prod volume) ∂μ := by
              apply integral_congr_ae
              filter_upwards [] with pt
              calc
                ∫ z : ModelE5,
                    modelSecondSuperpositionJoint α f
                      (pt, (z, lam)) ∂η =
                    (∫ z : ModelE5,
                      (modelSecondFiber α f pt.1 pt.2 z) ^ 2 *
                        translationWeight (z 4) ^ (-50 : ℝ) *
                        modelFirstPassiveGaussianWeight α lam pt.1 pt.2
                          (z 0) (z 1) (z 2) (z 3)) * lam ^ (-47 : ℝ) := by
                      rw [← MeasureTheory.integral_mul_const]
                      apply integral_congr_ae
                      filter_upwards [] with z
                      dsimp only [modelSecondSuperpositionJoint,
                        modelSecondSuperpositionIntegrand]
                _ = _ := by
                  rw [integral_modelSecondFiber_sq_translationWeight_passiveWeight
                    α lam f b pt.1 pt.2]
                  rw [← MeasureTheory.integral_mul_const]
        _ = ∫ w : (E3 × ℝ) ×
            ((TransverseSpace 2 × TransverseSpace 2) × ℝ),
            cubePassiveGaussianKernel α 2 lam w.2.2 w.1.2 w.1.1 w.2.1 *
              (cubeActiveCSAverage α 2 lam w.2.2 (edgeCubeTuple f) b
                ((w.1.1, w.1.2), w.2.1)) ^ 2 *
              translationWeight w.2.2 ^ (-50 : ℝ) * lam ^ (-47 : ℝ)
            ∂(μ.prod (κ.prod volume)) :=
              (MeasureTheory.integral_prod _ hpassive).symm
    _ = ∫ lam in Set.Ici (1 : ℝ),
        ∫ r : ℝ,
          localCubeForm α S 2 lam r (edgeCubeTuple f) *
            translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ) := by
      apply integral_congr_ae
      filter_upwards [hfib, hlam] with lam hlamint hlam
      have hpassive := integrable_modelSecondSuperposition_passive_at_scale
        α S lam f b hlamint
      calc
        ∫ w : (E3 × ℝ) ×
            ((TransverseSpace 2 × TransverseSpace 2) × ℝ),
            cubePassiveGaussianKernel α 2 lam w.2.2 w.1.2 w.1.1 w.2.1 *
              (cubeActiveCSAverage α 2 lam w.2.2 (edgeCubeTuple f) b
                ((w.1.1, w.1.2), w.2.1)) ^ 2 *
              translationWeight w.2.2 ^ (-50 : ℝ) * lam ^ (-47 : ℝ)
            ∂(μ.prod (κ.prod volume)) =
            ∫ r : ℝ,
              ∫ xy : (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2),
                cubePassiveGaussianKernel α 2 lam r xy.1.2 xy.1.1 xy.2 *
                  (cubeActiveCSAverage α 2 lam r (edgeCubeTuple f) b
                    ((xy.1.1, xy.1.2), xy.2)) ^ 2 *
                  translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ)
                ∂(μ.prod κ) := by
              simpa only [κ] using
                integral_outerProductShuffleRight μ κ volume
                  (fun w : (E3 × ℝ) ×
                    ((TransverseSpace 2 × TransverseSpace 2) × ℝ) ↦
                    cubePassiveGaussianKernel α 2 lam w.2.2 w.1.2 w.1.1 w.2.1 *
                      (cubeActiveCSAverage α 2 lam w.2.2 (edgeCubeTuple f) b
                        ((w.1.1, w.1.2), w.2.1)) ^ 2 *
                      translationWeight w.2.2 ^ (-50 : ℝ) * lam ^ (-47 : ℝ)) hpassive
        _ = ∫ r : ℝ,
              localCubeForm α S 2 lam r (edgeCubeTuple f) *
                translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ) := by
              apply integral_congr_ae
              filter_upwards [] with r
              have hsq := integrable_modelSecondPassiveSquare
                α S lam r f b hfcont hfbound hlam
              calc
                ∫ xy : (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2),
                    cubePassiveGaussianKernel α 2 lam r xy.1.2 xy.1.1 xy.2 *
                      (cubeActiveCSAverage α 2 lam r (edgeCubeTuple f) b
                        ((xy.1.1, xy.1.2), xy.2)) ^ 2 *
                      translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ)
                    ∂(μ.prod κ) =
                    (translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ)) *
                      ∫ xy : (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2),
                        cubePassiveGaussianKernel α 2 lam r xy.1.2 xy.1.1 xy.2 *
                          (cubeActiveCSAverage α 2 lam r (edgeCubeTuple f) b
                            ((xy.1.1, xy.1.2), xy.2)) ^ 2
                        ∂(μ.prod κ) := by
                      rw [← MeasureTheory.integral_const_mul]
                      apply integral_congr_ae
                      filter_upwards [] with xy
                      ring
                _ = _ := by
                  rw [← localCubeForm_edge_eq_passiveSquare
                    α S lam r f b hfcont hfbound hlam]
                  ring
    _ = ∫ lam in Set.Ici (1 : ℝ),
        (∫ r : ℝ,
          localCubeForm α S 2 lam r (edgeCubeTuple f) *
            translationWeight r ^ (-50 : ℝ)) * lam ^ (-47 : ℝ) := by
      apply integral_congr_ae
      filter_upwards [] with lam
      rw [← MeasureTheory.integral_mul_const]

/-- The first local energy satisfies the literal full-cube comparison under
bounded continuity and the one remaining joint superposition integrability
hypothesis. -/
theorem modelEnergyOne_le_cubeComparison_of_boundedContinuous :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (α : Anisotropy) (S : BoxCollection α)
      (u : E3) (f : ModelRealInput) (_b : Bool),
      (∀ j, Continuous (f j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B) →
      Integrable (modelFirstSuperpositionJoint α u f)
        ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
          ((volume : Measure ModelE5).prod
            ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) ) →
      modelEnergyOne α S u f ≤
        C * sourceWeight u ^ 50 * conePsiPhysicalRealL1 *
          ∫ lam in Set.Ici (1 : ℝ),
            localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
              lam ^ (-47 : ℝ) := by
  rcases modelEnergyOne_le_cubeComparison_of_fubini with ⟨C, hC, hmain⟩
  refine ⟨C, hC, ?_⟩
  intro α S u f b hfcont hfbound hsuper
  apply hmain α S u f b
  · exact integrable_modelEnergyOne_of_boundedContinuous
      α S u f hfcont hfbound
  · exact hsuper
  exact outerFirstSuperposition_eq_cubeComparison α S u f b
    (continuous_modelFirstCubeTuple f hfcont)
    (bounded_modelFirstCubeTuple f hfbound) hsuper

/-- The second local energy satisfies the literal edge-cube comparison under
bounded continuity and the one remaining joint superposition integrability
hypothesis. -/
theorem modelEnergyTwo_le_cubeComparison_of_boundedContinuous :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (α : Anisotropy) (S : BoxCollection α)
      (u : E3) (f : E3 → ℝ) (_b : Bool),
      Continuous f →
      (∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) →
      Integrable (modelSecondSuperpositionJoint α f)
        ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
          ((volume : Measure ModelE5).prod
            ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) ) →
      modelEnergyTwo α S u f ≤
        C * sourceWeight u ^ 100 *
          ∫ lam in Set.Ici (1 : ℝ),
            (∫ r : ℝ,
              localCubeForm α S 2 lam r (edgeCubeTuple f) *
                translationWeight r ^ (-50 : ℝ)) * lam ^ (-47 : ℝ) := by
  rcases modelEnergyTwo_le_cubeComparison_of_fubini with ⟨C, hC, hmain⟩
  refine ⟨C, hC, ?_⟩
  intro α S u f b hfcont hfbound hsuper
  apply hmain α S u f b
  · exact integrable_modelEnergyTwo_of_boundedContinuous
      α S u f hfcont hfbound
  · exact hsuper
  exact outerSecondSuperposition_eq_cubeComparison
    α S f b hfcont hfbound hsuper

/-- Constant cube slots have fourth tree local size at most one. -/
theorem treeLocalSize_four_one_le_one
    (α : Anisotropy) (T : FiniteConvexTree α) :
    treeLocalSize T 4 (fun _ : E3 ↦ (1 : ℝ)) ≤ 1 := by
  change collectionLocalSize α T.boxes 4 (fun _ : E3 ↦ (1 : ℝ)) ≤ 1
  rw [collectionLocalSize_eq_sup' T.boxes T.nonempty]
  apply Finset.sup'_le
  intro q hq
  unfold boxLocalSize boxLocalPower
  rw [show (fun y : E3 ↦ |(1 : ℝ)| ^ (4 : ℝ) *
      anisotropicBracketKernel α (boxLength q) (boxCenter α q) y) =
        anisotropicBracketKernel α (boxLength q) (boxCenter α q) by
      funext y
      norm_num]
  rw [integral_anisotropicBracketKernel α (boxLength_pos q) (boxCenter α q)]
  apply Real.rpow_le_one <;> norm_num

/-- An explicit enumeration of the eight cube vertices for finite-product
bookkeeping in the first energy estimate. -/
theorem cubeVertex_univ :
    (Finset.univ : Finset CubeVertex) =
      {cubeVertex false false false, cubeVertex false false true,
        cubeVertex false true false, cubeVertex false true true,
        cubeVertex true false false, cubeVertex true false true,
        cubeVertex true true false, cubeVertex true true true} := by
  decide

/-- The eight first-energy cube slots contribute the square of the three
nonconstant fourth local sizes; the two constant slots are harmless. -/
theorem modelFirstCubeTuple_treeLocalSize_product_le
    (α : Anisotropy) (T : FiniteConvexTree α) (f : ModelRealInput) :
    (∏ j : CubeVertex, treeLocalSize T 4 (modelFirstCubeTuple f j)) ≤
      (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
        treeLocalSize T 4 (f 2)) ^ 2 := by
  let K : ℝ := treeLocalSize T 4 (fun _ : E3 ↦ (1 : ℝ))
  let M0 : ℝ := treeLocalSize T 4 (f 0)
  let M1 : ℝ := treeLocalSize T 4 (f 1)
  let M2 : ℝ := treeLocalSize T 4 (f 2)
  have hK0 : 0 ≤ K := by
    dsimp only [K]
    exact treeLocalSize_four_nonneg T _
  have hK1 : K ≤ 1 := by
    dsimp only [K]
    exact treeLocalSize_four_one_le_one α T
  have hKsq : K * K ≤ 1 := by
    calc
      K * K ≤ 1 * K := mul_le_mul_of_nonneg_right hK1 hK0
      _ ≤ 1 * 1 := mul_le_mul_of_nonneg_left hK1 zero_le_one
      _ = 1 := by ring
  have hM0 : 0 ≤ M0 := by
    dsimp only [M0]
    exact treeLocalSize_four_nonneg T _
  have hM1 : 0 ≤ M1 := by
    dsimp only [M1]
    exact treeLocalSize_four_nonneg T _
  have hM2 : 0 ≤ M2 := by
    dsimp only [M2]
    exact treeLocalSize_four_nonneg T _
  have hP : 0 ≤ (M0 * M1 * M2) ^ 2 := sq_nonneg _
  have h000 : cubeVertex false false false ∉
      ({cubeVertex false false true, cubeVertex false true false,
        cubeVertex false true true, cubeVertex true false false,
        cubeVertex true false true, cubeVertex true true false,
        cubeVertex true true true} : Finset CubeVertex) := by decide
  have h001 : cubeVertex false false true ∉
      ({cubeVertex false true false, cubeVertex false true true,
        cubeVertex true false false, cubeVertex true false true,
        cubeVertex true true false, cubeVertex true true true} : Finset CubeVertex) := by decide
  have h010 : cubeVertex false true false ∉
      ({cubeVertex false true true, cubeVertex true false false,
        cubeVertex true false true, cubeVertex true true false,
        cubeVertex true true true} : Finset CubeVertex) := by decide
  have h011 : cubeVertex false true true ∉
      ({cubeVertex true false false, cubeVertex true false true,
        cubeVertex true true false, cubeVertex true true true} : Finset CubeVertex) := by decide
  have h100 : cubeVertex true false false ∉
      ({cubeVertex true false true, cubeVertex true true false,
        cubeVertex true true true} : Finset CubeVertex) := by decide
  have h101 : cubeVertex true false true ∉
      ({cubeVertex true true false, cubeVertex true true true} : Finset CubeVertex) := by decide
  have h110 : cubeVertex true true false ∉
      ({cubeVertex true true true} : Finset CubeVertex) := by decide
  rw [cubeVertex_univ]
  rw [Finset.prod_insert h000, Finset.prod_insert h001,
    Finset.prod_insert h010, Finset.prod_insert h011,
    Finset.prod_insert h100, Finset.prod_insert h101,
    Finset.prod_insert h110, Finset.prod_singleton]
  simp only [modelFirstCubeTuple, Fin.isValue, cubeVertex_zero, Bool.false_eq_true, ↓reduceIte,
    cubeVertex_one,
    ge_iff_le]
  change M0 * (M0 * (M2 * (M2 * (M1 * (M1 * (K * K)))))) ≤
    (M0 * M1 * M2) ^ 2
  calc
    M0 * (M0 * (M2 * (M2 * (M1 * (M1 * (K * K)))))) =
        (M0 * M1 * M2) ^ 2 * (K * K) := by ring
    _ ≤ (M0 * M1 * M2) ^ 2 * 1 :=
      mul_le_mul_of_nonneg_left hKsq hP
    _ = (M0 * M1 * M2) ^ 2 := by ring

/-- At a fixed positive scale, the full-cube tree estimate leaves exactly the
`λ⁻¹⁰` scale weight after the first-energy normalization. -/
theorem modelFirst_fixed_majorant
    (α : Anisotropy) (T : FiniteConvexTree α) (f : ModelRealInput)
    (lam : ℝ) (C : ℝ)
    (hC : 0 ≤ C)
    (htree : |localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f)| ≤
      C * lam ^ (37 : ℕ) * translationWeight 0 ^ (21 : ℕ) *
        (∏ j : CubeVertex, treeLocalSize T 4 (modelFirstCubeTuple f j)) *
          boxMass α T.root)
    (hlam : 1 ≤ lam) :
    localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) * lam ^ (-47 : ℝ) ≤
      (C *
        (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
          treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root) *
        lam ^ (-10 : ℝ) := by
  have hlam0 : 0 ≤ lam := le_trans zero_le_one hlam
  have hlampos : 0 < lam := lt_of_lt_of_le zero_lt_one hlam
  have hpow47 : 0 ≤ lam ^ (-47 : ℝ) := Real.rpow_nonneg hlam0 _
  have hR0 : translationWeight (0 : ℝ) = 1 := by
    norm_num [translationWeight]
  have hbase : 0 ≤ C * lam ^ (37 : ℕ) * translationWeight 0 ^ (21 : ℕ) := by
    positivity
  have hmass : 0 ≤ boxMass α T.root := (boxMass_pos α T.root).le
  have hprod := modelFirstCubeTuple_treeLocalSize_product_le α T f
  have htree' : |localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f)| ≤
      C * lam ^ (37 : ℕ) * translationWeight 0 ^ (21 : ℕ) *
        (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
          treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root := by
    exact htree.trans
      (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left hprod hbase) hmass)
  have hpow : lam ^ (37 : ℕ) * lam ^ (-47 : ℝ) = lam ^ (-10 : ℝ) := by
    rw [← Real.rpow_natCast]
    rw [← Real.rpow_add hlampos]
    norm_num
  calc
    localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) * lam ^ (-47 : ℝ) ≤
        (C * lam ^ (37 : ℕ) * translationWeight 0 ^ (21 : ℕ) *
          (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
            treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root) *
            lam ^ (-47 : ℝ) :=
      mul_le_mul_of_nonneg_right ((le_abs_self _).trans htree') hpow47
    _ = (C *
        (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
          treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root) *
        lam ^ (-10 : ℝ) := by
      rw [hR0]
      simp only [one_pow, mul_one]
      calc
        C * lam ^ (37 : ℕ) *
              (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
                treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root *
                lam ^ (-47 : ℝ) =
            (C *
              (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
                treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root) *
              (lam ^ (37 : ℕ) * lam ^ (-47 : ℝ)) := by ring
        _ = _ := by rw [hpow]

/-- At a fixed positive scale, the edge-tree estimate leaves the product
`λ⁻¹⁰ R⁻²⁹` after the second-energy normalization. -/
theorem edge_fixed_majorant
    (α : Anisotropy) (T : FiniteConvexTree α) (f : E3 → ℝ)
    (lam r C : ℝ)
    (hC : 0 ≤ C)
    (htree : localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) ≤
      C * lam ^ (37 : ℕ) * translationWeight r ^ (21 : ℕ) *
        treeLocalSize T 2 f ^ 2 * boxMass α T.root)
    (hlam : 1 ≤ lam) :
    localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
        translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ) ≤
      (C * treeLocalSize T 2 f ^ 2 * boxMass α T.root) *
        lam ^ (-10 : ℝ) * translationWeight r ^ (-29 : ℝ) := by
  have hlam0 : 0 ≤ lam := le_trans zero_le_one hlam
  have hlampos : 0 < lam := lt_of_lt_of_le zero_lt_one hlam
  have hRpos : 0 < translationWeight r := by
    unfold translationWeight
    positivity
  have hR0 : 0 ≤ translationWeight r := hRpos.le
  have hpowlam47 : 0 ≤ lam ^ (-47 : ℝ) := Real.rpow_nonneg hlam0 _
  have hpowR50 : 0 ≤ translationWeight r ^ (-50 : ℝ) := Real.rpow_nonneg hR0 _
  have hbase : 0 ≤ C * lam ^ (37 : ℕ) * translationWeight r ^ (21 : ℕ) := by
    positivity
  have hM2 : 0 ≤ treeLocalSize T 2 f ^ 2 := sq_nonneg _
  have hmass : 0 ≤ boxMass α T.root := (boxMass_pos α T.root).le
  have hpowlam : lam ^ (37 : ℕ) * lam ^ (-47 : ℝ) = lam ^ (-10 : ℝ) := by
    rw [← Real.rpow_natCast]
    rw [← Real.rpow_add hlampos]
    norm_num
  have hpowR : translationWeight r ^ (21 : ℕ) *
      translationWeight r ^ (-50 : ℝ) = translationWeight r ^ (-29 : ℝ) := by
    rw [← Real.rpow_natCast]
    rw [← Real.rpow_add hRpos]
    norm_num
  calc
    localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
          translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ) ≤
        (C * lam ^ (37 : ℕ) * translationWeight r ^ (21 : ℕ) *
          treeLocalSize T 2 f ^ 2 * boxMass α T.root) *
          translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ) := by
      gcongr
    _ = (C * treeLocalSize T 2 f ^ 2 * boxMass α T.root) *
          lam ^ (-10 : ℝ) * translationWeight r ^ (-29 : ℝ) := by
      calc
        (C * lam ^ (37 : ℕ) * translationWeight r ^ (21 : ℕ) *
            treeLocalSize T 2 f ^ 2 * boxMass α T.root) *
            translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ) =
          (C * treeLocalSize T 2 f ^ 2 * boxMass α T.root) *
            (lam ^ (37 : ℕ) * lam ^ (-47 : ℝ)) *
              (translationWeight r ^ (21 : ℕ) *
                translationWeight r ^ (-50 : ℝ)) := by ring
        _ = _ := by rw [hpowlam, hpowR]

/-- Integration of the first fixed-scale majorant uses the exact remaining
scale mass `∫₁∞ λ⁻¹⁰ = 1/9`. -/
theorem modelFirst_integral_majorant
    (α : Anisotropy) (T : FiniteConvexTree α) (f : ModelRealInput)
    (C : ℝ) (hC : 0 ≤ C)
    (htree : ∀ lam : ℝ, 1 ≤ lam →
      |localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f)| ≤
        C * lam ^ (37 : ℕ) * translationWeight 0 ^ (21 : ℕ) *
          (∏ j : CubeVertex, treeLocalSize T 4 (modelFirstCubeTuple f j)) *
            boxMass α T.root)
    (hform : IntegrableOn (fun lam : ℝ ↦
      localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) *
        lam ^ (-47 : ℝ)) (Set.Ici (1 : ℝ))) :
    ∫ lam : ℝ in Set.Ici (1 : ℝ),
      localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) *
        lam ^ (-47 : ℝ) ≤
      (C *
        (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
          treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root) / 9 := by
  let D : ℝ := C *
    (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
      treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root
  have hweight : Integrable (fun lam : ℝ ↦ lam ^ (-10 : ℝ))
      ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))) := by
    exact integrableOn_scaleWeight_negTen
  have hmajor : Integrable (fun lam : ℝ ↦ D * lam ^ (-10 : ℝ))
      ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))) :=
    hweight.const_mul D
  have hAE : ∀ᵐ lam : ℝ ∂(volume.restrict (Set.Ici (1 : ℝ))),
      localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) *
          lam ^ (-47 : ℝ) ≤ D * lam ^ (-10 : ℝ) := by
    filter_upwards [ae_restrict_mem (measurableSet_Ici : MeasurableSet (Set.Ici (1 : ℝ)))]
      with lam hlam
    exact modelFirst_fixed_majorant α T f lam C hC (htree lam hlam) hlam
  calc
    ∫ lam : ℝ in Set.Ici (1 : ℝ),
        localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) *
          lam ^ (-47 : ℝ) ≤
        ∫ lam : ℝ in Set.Ici (1 : ℝ), D * lam ^ (-10 : ℝ) :=
      integral_mono_ae hform hmajor hAE
    _ = D * (∫ lam : ℝ in Set.Ici (1 : ℝ), lam ^ (-10 : ℝ)) := by
      rw [MeasureTheory.integral_const_mul]
    _ = (C *
        (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
          treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root) / 9 := by
      rw [integralOn_scaleWeight_negTen]
      dsimp only [D]
      ring

/-- Integration of the edge fixed-scale majorant uses the two exact remaining
masses `1/9` and `1/14`, hence the factor `1/126`. -/
theorem edge_integral_majorant
    (α : Anisotropy) (T : FiniteConvexTree α) (f : E3 → ℝ)
    (C : ℝ) (hC : 0 ≤ C)
    (htree : ∀ (lam r : ℝ), 1 ≤ lam →
      localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) ≤
        C * lam ^ (37 : ℕ) * translationWeight r ^ (21 : ℕ) *
          treeLocalSize T 2 f ^ 2 * boxMass α T.root)
    (hform : Integrable (fun z : ℝ × ℝ ↦
      localCubeForm α T.boxes 2 z.1 z.2 (edgeCubeTuple f) *
          translationWeight z.2 ^ (-50 : ℝ) * z.1 ^ (-47 : ℝ))
      (((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))).prod volume)) :
    ∫ lam : ℝ in Set.Ici (1 : ℝ),
        (∫ r : ℝ,
          localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
            translationWeight r ^ (-50 : ℝ)) * lam ^ (-47 : ℝ) ≤
      (C * treeLocalSize T 2 f ^ 2 * boxMass α T.root) / 126 := by
  let D : ℝ := C * treeLocalSize T 2 f ^ 2 * boxMass α T.root
  let nu : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  have hweightlam : Integrable (fun lam : ℝ ↦ lam ^ (-10 : ℝ)) nu := by
    exact integrableOn_scaleWeight_negTen
  have hweightr : Integrable (fun r : ℝ ↦ translationWeight r ^ (-29 : ℝ))
      (volume : Measure ℝ) := integrable_translationWeight_negTwentyNine
  have hmajor : Integrable (fun z : ℝ × ℝ ↦
      D * z.1 ^ (-10 : ℝ) * translationWeight z.2 ^ (-29 : ℝ))
      (nu.prod volume) := by
    simpa only [mul_assoc] using (hweightlam.mul_prod hweightr).const_mul D
  have hinner : ∀ᵐ lam : ℝ ∂nu,
      (∫ r : ℝ,
        localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
          translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ)) ≤
        ∫ r : ℝ, D * lam ^ (-10 : ℝ) * translationWeight r ^ (-29 : ℝ) := by
    filter_upwards [hform.prod_right_ae, hmajor.prod_right_ae,
      ae_restrict_mem (measurableSet_Ici : MeasurableSet (Set.Ici (1 : ℝ)))]
      with lam hformlam hmajorlam hlam
    apply integral_mono_ae hformlam hmajorlam
    filter_upwards [] with r
    exact edge_fixed_majorant α T f lam r C hC (htree lam r hlam) hlam
  have houter :
      (∫ lam : ℝ in Set.Ici (1 : ℝ),
        ∫ r : ℝ,
          localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
            translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ)) ≤
        ∫ lam : ℝ in Set.Ici (1 : ℝ),
          ∫ r : ℝ, D * lam ^ (-10 : ℝ) * translationWeight r ^ (-29 : ℝ) := by
    exact integral_mono_ae hform.integral_prod_left hmajor.integral_prod_left hinner
  have hrewrite :
      (∫ lam : ℝ in Set.Ici (1 : ℝ),
        (∫ r : ℝ,
          localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
            translationWeight r ^ (-50 : ℝ)) * lam ^ (-47 : ℝ)) =
      ∫ lam : ℝ in Set.Ici (1 : ℝ),
        ∫ r : ℝ,
          localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
            translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ) := by
    apply integral_congr_ae
    filter_upwards [] with lam
    rw [MeasureTheory.integral_mul_const]
  have heval :
      (∫ lam : ℝ in Set.Ici (1 : ℝ),
        ∫ r : ℝ, D * lam ^ (-10 : ℝ) * translationWeight r ^ (-29 : ℝ)) =
      D / 126 := by
    calc
      (∫ lam : ℝ in Set.Ici (1 : ℝ),
        ∫ r : ℝ, D * lam ^ (-10 : ℝ) * translationWeight r ^ (-29 : ℝ)) =
          ∫ lam : ℝ in Set.Ici (1 : ℝ),
            (D * lam ^ (-10 : ℝ)) *
              (∫ r : ℝ, translationWeight r ^ (-29 : ℝ)) := by
        apply integral_congr_ae
        filter_upwards [] with lam
        rw [MeasureTheory.integral_const_mul]
      _ = ∫ lam : ℝ in Set.Ici (1 : ℝ),
            (D / 14) * lam ^ (-10 : ℝ) := by
        apply integral_congr_ae
        filter_upwards [] with lam
        rw [integral_translationWeight_negTwentyNine]
        ring
      _ = (D / 14) *
          (∫ lam : ℝ in Set.Ici (1 : ℝ), lam ^ (-10 : ℝ)) := by
        rw [MeasureTheory.integral_const_mul]
      _ = D / 126 := by
        rw [integralOn_scaleWeight_negTen]
        ring
  rw [hrewrite]
  exact houter.trans_eq heval

/-- The first model energy is controlled by the full-cube tree estimate. The
only analytic hypothesis left explicit is the exact normalized scale
integrability used to justify the comparison integral. -/
theorem modelEnergyOne_tree_bound_of_boundedContinuous
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α)
      (u : E3) (f : ModelRealInput) (b : Bool),
      (∀ j, Continuous (f j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B) →
      Integrable (modelFirstSuperpositionJoint α u f)
        ((cubeScaleMeasure.restrict (collectionRegion α T.boxes)).prod
          ((volume : Measure ModelE5).prod
            ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) ) →
      IntegrableOn (fun lam : ℝ ↦
        localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) *
          lam ^ (-47 : ℝ)) (Set.Ici (1 : ℝ)) →
      modelEnergyOne α T.boxes u f ≤
        C * sourceWeight u ^ 50 * boxMass α T.root *
          (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
            treeLocalSize T 4 (f 2)) ^ 2 := by
  rcases modelEnergyOne_le_cubeComparison_of_boundedContinuous with
    ⟨CE, hCE, henergy⟩
  rcases fullCubeTreeEstimate_of_boundedContinuous α with ⟨CT, hCT, htree⟩
  refine ⟨CE * CT * conePsiPhysicalRealL1 / 9, ?_, ?_⟩
  · have hL1 : 0 ≤ conePsiPhysicalRealL1 := by
      unfold conePsiPhysicalRealL1
      exact integral_nonneg fun r ↦ abs_nonneg _
    positivity
  intro T u f b hfcont hfbound hsuper hform
  have hL1 : 0 ≤ conePsiPhysicalRealL1 := by
    unfold conePsiPhysicalRealL1
    exact integral_nonneg fun r ↦ abs_nonneg _
  have htree' : ∀ lam : ℝ, 1 ≤ lam →
      |localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f)| ≤
        CT * lam ^ (37 : ℕ) * translationWeight 0 ^ (21 : ℕ) *
          (∏ j : CubeVertex, treeLocalSize T 4 (modelFirstCubeTuple f j)) *
            boxMass α T.root := by
    intro lam hlam
    exact htree T lam 0 (modelFirstCubeTuple f) 2
      (continuous_modelFirstCubeTuple f hfcont)
      (bounded_modelFirstCubeTuple f hfbound) hlam
  have hI := modelFirst_integral_majorant α T f CT hCT htree' hform
  have henergy' := henergy α T.boxes u f b hfcont hfbound hsuper
  have hfac : 0 ≤ CE * sourceWeight u ^ 50 * conePsiPhysicalRealL1 := by
    positivity
  calc
    modelEnergyOne α T.boxes u f ≤
        CE * sourceWeight u ^ 50 * conePsiPhysicalRealL1 *
          ∫ lam : ℝ in Set.Ici (1 : ℝ),
            localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) *
              lam ^ (-47 : ℝ) := henergy'
    _ ≤ CE * sourceWeight u ^ 50 * conePsiPhysicalRealL1 *
        ((CT *
          (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
            treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root) / 9) :=
      mul_le_mul_of_nonneg_left hI hfac
    _ = (CE * CT * conePsiPhysicalRealL1 / 9) *
        sourceWeight u ^ 50 * boxMass α T.root *
          (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
            treeLocalSize T 4 (f 2)) ^ 2 := by ring

/-- The second model energy is controlled by the edge-cube tree estimate.
The remaining hypothesis is precisely the joint scale--translation
integrability needed for the Fubini comparison. -/
theorem modelEnergyTwo_tree_bound_of_boundedContinuous
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α)
      (u : E3) (f : E3 → ℝ) (_b : Bool),
      Continuous f →
      (∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) →
      Integrable (modelSecondSuperpositionJoint α f)
        ((cubeScaleMeasure.restrict (collectionRegion α T.boxes)).prod
          ((volume : Measure ModelE5).prod
            ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) ) →
      Integrable (fun z : ℝ × ℝ ↦
        localCubeForm α T.boxes 2 z.1 z.2 (edgeCubeTuple f) *
          translationWeight z.2 ^ (-50 : ℝ) * z.1 ^ (-47 : ℝ))
        (((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))).prod volume) →
      modelEnergyTwo α T.boxes u f ≤
        C * sourceWeight u ^ 100 * boxMass α T.root * treeLocalSize T 2 f ^ 2 := by
  rcases modelEnergyTwo_le_cubeComparison_of_boundedContinuous with
    ⟨CE, hCE, henergy⟩
  rcases edgeTreeEstimate_of_boundedContinuous α with ⟨CT, hCT, htree⟩
  refine ⟨CE * CT / 126, ?_, ?_⟩
  · positivity
  intro T u f b hfcont hfbound hsuper hform
  have htree' : ∀ (lam r : ℝ), 1 ≤ lam →
      localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) ≤
        CT * lam ^ (37 : ℕ) * translationWeight r ^ (21 : ℕ) *
          treeLocalSize T 2 f ^ 2 * boxMass α T.root := by
    intro lam r hlam
    exact (htree T lam r f hfcont hfbound hlam).2.2.2
  have hI := edge_integral_majorant α T f CT hCT htree' hform
  have henergy' := henergy α T.boxes u f b hfcont hfbound hsuper
  have hfac : 0 ≤ CE * sourceWeight u ^ 100 := by
    positivity
  calc
    modelEnergyTwo α T.boxes u f ≤
        CE * sourceWeight u ^ 100 *
          ∫ lam : ℝ in Set.Ici (1 : ℝ),
            (∫ r : ℝ,
              localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
                translationWeight r ^ (-50 : ℝ)) * lam ^ (-47 : ℝ) := henergy'
    _ ≤ CE * sourceWeight u ^ 100 *
        ((CT * treeLocalSize T 2 f ^ 2 * boxMass α T.root) / 126) :=
      mul_le_mul_of_nonneg_left hI hfac
    _ = (CE * CT / 126) * sourceWeight u ^ 100 *
        boxMass α T.root * treeLocalSize T 2 f ^ 2 := by ring

/-- Fubini in the literal three-coordinate order used by the final
one-dimensional square-function identity. -/
theorem integral_real_cube_eq_nested
    (H : ℝ × (ℝ × ℝ) → ℝ)
    (hH : Integrable H
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) :
    (∫ z : ℝ × (ℝ × ℝ), H z
      ∂((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) =
      ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ v : ℝ, H (x₁, (x₂, v)) := by
  let K : ℝ → ℝ := fun x₁ ↦
    ∫ x₂ : ℝ, ∫ v : ℝ, H (x₁, (x₂, v))
  have hpair (x₁ : ℝ)
      (hx₁ : Integrable (fun q : ℝ × ℝ ↦ H (x₁, q))
        ((volume : Measure ℝ).prod volume)) :
      (∫ q : ℝ × ℝ, H (x₁, q)
        ∂((volume : Measure ℝ).prod volume)) = K x₁ := by
    calc
      (∫ q : ℝ × ℝ, H (x₁, q)
        ∂((volume : Measure ℝ).prod volume)) =
          ∫ x₂ : ℝ, ∫ v : ℝ, H (x₁, (x₂, v)) := by
            exact integral_prod _ hx₁
      _ = K x₁ := by rfl
  have hK : Integrable K (volume : Measure ℝ) := by
    have hleft := hH.integral_prod_left
    apply hleft.congr
    filter_upwards [hH.prod_right_ae] with x₁ hx₁
    exact hpair x₁ hx₁
  calc
    (∫ z : ℝ × (ℝ × ℝ), H z
      ∂((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) =
        ∫ x₁ : ℝ, ∫ q : ℝ × ℝ, H (x₁, q)
          ∂((volume : Measure ℝ).prod volume) :=
      integral_prod _ hH
    _ = ∫ x₁ : ℝ, K x₁ := by
      apply integral_congr_ae
      filter_upwards [hH.prod_right_ae] with x₁ hx₁
      exact hpair x₁ hx₁
    _ = ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ v : ℝ, H (x₁, (x₂, v)) := by
      rfl

/-- The coordinate parametrization used by the third-coordinate fibers is
the inverse of `e3Coordinates`. -/
theorem modelPoint_e3Coordinates
    (x : E3) : modelPoint (x 0) (x 1) (x 2) = x := by
  ext i
  fin_cases i <;> simp

/-- The ambient squared norm of an integrable real input is exactly its
three-coordinate iterated integral. -/
theorem integral_modelPoint_sq_eq
    (f : E3 → ℝ)
    (hf : Integrable (fun x : E3 ↦ f x ^ 2)) :
    (∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ v : ℝ,
      f (modelPoint x₁ x₂ v) ^ 2) =
      ∫ x : E3, f x ^ 2 := by
  let G : ℝ × (ℝ × ℝ) → ℝ := fun z ↦
    f (modelPoint z.1 z.2.1 z.2.2) ^ 2
  have hG : Integrable G
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    let e := e3Coordinates
    have hmp : MeasurePreserving e (volume : Measure E3)
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
      simpa only [e] using e3Coordinates_measurePreserving
    have hcomp : (fun z : ℝ × (ℝ × ℝ) ↦ G z) =
        (fun x : E3 ↦ f x ^ 2) ∘ e.symm := by
      funext z
      rcases z with ⟨x₁, x₂, v⟩
      simp only [Function.comp_apply, G]
      congr 2
      apply e.injective
      simp only [e, e3Coordinates_apply]
      exact Prod.ext rfl (Prod.ext rfl rfl)
    have htrans :=
      (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hf
    apply htrans.congr
    filter_upwards [] with z
    exact (congrFun hcomp z).symm
  calc
    (∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ v : ℝ,
      f (modelPoint x₁ x₂ v) ^ 2) =
        ∫ z : ℝ × (ℝ × ℝ), G z
          ∂((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
            exact (integral_real_cube_eq_nested G hG).symm
    _ = ∫ x : E3, f x ^ 2 := by
      let e := e3Coordinates
      have hmp : MeasurePreserving e (volume : Measure E3)
          ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
        simpa only [e] using e3Coordinates_measurePreserving
      have hpoint (x : E3) : G (e x) = f x ^ 2 := by
        simp only [G, e, e3Coordinates_apply]
        rw [modelPoint_e3Coordinates]
      calc
        (∫ z : ℝ × (ℝ × ℝ), G z
          ∂((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) =
            ∫ x : E3, G (e x) := by
              exact (hmp.integral_comp' G).symm
        _ = ∫ x : E3, f x ^ 2 := by
          apply integral_congr_ae
          filter_upwards [] with x
          exact hpoint x

/-- On the global positive-scale region the product restriction in
`cubeScaleMeasure` is exactly the product of Lebesgue measure and the
restricted logarithmic scale measure. -/
theorem cubeScaleMeasure_restrict_global_eq :
    cubeScaleMeasure.restrict (Set.univ ×ˢ Set.Ioi (0 : ℝ)) =
      (volume : Measure E3).prod
        (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
          (Set.Ioi (0 : ℝ))) := by
  unfold cubeScaleMeasure
  rw [← Measure.prod_restrict]
  simp

/-- The finite active stopping forest converts uniform stopping-tree local
form bounds into the four-coordinate envelope sum. The exact forest form
decomposition is kept as an explicit hypothesis, since it is the point at
which the outer model Fubini package is consumed. -/
theorem activeStoppingForest_form_bound_of_localBounds
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (q σ : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (hpos : ∀ q ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) q)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hfinite : ∀ n,
      volume (sourceStoppingDominantMaximalLevelSet α f q σ n) ≠ ∞)
    (C : ℝ) (hC : 0 ≤ C)
    (hdecomp :
      expandedModelLocalForm α S u c f =
        ∑ n ∈ activeStoppingLevels α S sourceStoppingExponent f hpos,
          ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
            expandedModelLocalForm α
              (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f)
    (hlocal : ∀ (n : Fin 4 → ℤ)
      (Q : {Q : AnisoBox α // Q ∈ stoppingRoots α S sourceStoppingExponent f n}),
      |expandedModelLocalForm α
          (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f| ≤
        C * sourceWeight u ^ 75 * boxMass α Q.1 *
          (∏ j : Fin 4,
            treeLocalSize
              (stoppingTree α S sourceStoppingExponent f n
                (isConvexCollection_stoppingLevel α S hS
                  sourceStoppingExponent f n) Q.1 Q.2)
              (sourceStoppingExponent j) (f j))) :
    |expandedModelLocalForm α S u c f| ≤
      C * sourceWeight u ^ 75 *
        (∑ j : Fin 4,
          ∑ m ∈ (activeStoppingLevels α S sourceStoppingExponent f hpos).filter
              (fun n ↦ sourceStoppingDominantIndex q σ n = j) |>.image
                (fun n ↦ n j),
            sourceStoppingDominantFiberEnvelope q σ j m *
              (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) := by
  let L := activeStoppingLevels α S sourceStoppingExponent f hpos
  let W : ℝ := ∑ n ∈ L,
    ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
      boxMass α Q.1 *
        (∏ j : Fin 4,
          treeLocalSize
            (stoppingTree α S sourceStoppingExponent f n
              (isConvexCollection_stoppingLevel α S hS
                sourceStoppingExponent f n) Q.1 Q.2)
            (sourceStoppingExponent j) (f j))
  let E : ℝ := ∑ j : Fin 4,
    ∑ m ∈ L.filter (fun n ↦ sourceStoppingDominantIndex q σ n = j) |>.image
        (fun n ↦ n j),
      sourceStoppingDominantFiberEnvelope q σ j m *
        (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal
  have hW : W ≤ E := by
    dsimp only [W, E, L]
    exact sourceStoppingForestWeightedSum_le_coordinateEnvelopeSums
      α S hS f q σ hq hpos hcont hbound hfinite
  have hU : 0 ≤ sourceWeight u := sourceWeight_nonneg u
  have hfac : 0 ≤ C * sourceWeight u ^ 75 := by positivity
  have hsum :
      (∑ n ∈ L,
        ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
          |expandedModelLocalForm α
            (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f|) ≤
        C * sourceWeight u ^ 75 * W := by
    calc
      (∑ n ∈ L,
        ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
          |expandedModelLocalForm α
            (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f|) ≤
          ∑ n ∈ L,
            ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
              C * sourceWeight u ^ 75 * boxMass α Q.1 *
                (∏ j : Fin 4,
                  treeLocalSize
                    (stoppingTree α S sourceStoppingExponent f n
                      (isConvexCollection_stoppingLevel α S hS
                        sourceStoppingExponent f n) Q.1 Q.2)
                    (sourceStoppingExponent j) (f j)) := by
        apply Finset.sum_le_sum
        intro n hn
        apply Finset.sum_le_sum
        intro Q hQ
        exact hlocal n Q
      _ = C * sourceWeight u ^ 75 * W := by
        dsimp only [W]
        calc
          (∑ n ∈ L,
            ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
              C * sourceWeight u ^ 75 * boxMass α Q.1 *
                (∏ j : Fin 4,
                  treeLocalSize
                    (stoppingTree α S sourceStoppingExponent f n
                      (isConvexCollection_stoppingLevel α S hS
                        sourceStoppingExponent f n) Q.1 Q.2)
                    (sourceStoppingExponent j) (f j))) =
              ∑ n ∈ L,
                (C * sourceWeight u ^ 75) *
                  (∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
                    boxMass α Q.1 *
                      (∏ j : Fin 4,
                        treeLocalSize
                          (stoppingTree α S sourceStoppingExponent f n
                            (isConvexCollection_stoppingLevel α S hS
                              sourceStoppingExponent f n) Q.1 Q.2)
                          (sourceStoppingExponent j) (f j))) := by
                apply Finset.sum_congr rfl
                intro n hn
                rw [Finset.mul_sum]
                apply Finset.sum_congr rfl
                intro Q hQ
                ring
          _ = C * sourceWeight u ^ 75 *
              (∑ n ∈ L,
                ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
                  boxMass α Q.1 *
                    (∏ j : Fin 4,
                      treeLocalSize
                        (stoppingTree α S sourceStoppingExponent f n
                          (isConvexCollection_stoppingLevel α S hS
                            sourceStoppingExponent f n) Q.1 Q.2)
                        (sourceStoppingExponent j) (f j))) := by
            rw [Finset.mul_sum]
  calc
    |expandedModelLocalForm α S u c f| =
        |∑ n ∈ L,
          ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
            expandedModelLocalForm α
              (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f| := by
      rw [hdecomp]
    _ ≤ ∑ n ∈ L,
        |∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
          expandedModelLocalForm α
            (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f| := by
      exact Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ n ∈ L,
        ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
          |expandedModelLocalForm α
            (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f| := by
      apply Finset.sum_le_sum
      intro n hn
      exact Finset.abs_sum_le_sum_abs _ _
    _ ≤ C * sourceWeight u ^ 75 * W := hsum
    _ ≤ C * sourceWeight u ^ 75 * E :=
      mul_le_mul_of_nonneg_left hW hfac
    _ = C * sourceWeight u ^ 75 *
        (∑ j : Fin 4,
          ∑ m ∈ (activeStoppingLevels α S sourceStoppingExponent f hpos).filter
              (fun n ↦ sourceStoppingDominantIndex q σ n = j) |>.image
                (fun n ↦ n j),
            sourceStoppingDominantFiberEnvelope q σ j m *
              (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) := by
      rfl

/-- The literal stopping tree attached to a source active root. Naming it
makes the energy hypotheses in the terminal forest wrapper compact. -/
noncomputable def sourceStoppingTree
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (f : ModelRealInput) (n : Fin 4 → ℤ)
    (Q : {Q : AnisoBox α // Q ∈ stoppingRoots α S sourceStoppingExponent f n}) :
    FiniteConvexTree α :=
  stoppingTree α S sourceStoppingExponent f n
    (isConvexCollection_stoppingLevel α S hS sourceStoppingExponent f n)
    Q.1 Q.2

/-- The local Cauchy--Schwarz input on every tree of the source stopping
forest. -/
def sourceStoppingTreeCS
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (f : ModelRealInput) : Prop :=
  ∀ (n : Fin 4 → ℤ)
    (Q : {Q : AnisoBox α // Q ∈ stoppingRoots α S sourceStoppingExponent f n}),
    |expandedModelLocalForm α (sourceStoppingTree α S hS f n Q).boxes u c f| ^ 2 ≤
      modelEnergyOne α (sourceStoppingTree α S hS f n Q).boxes u f *
        modelEnergyTwo α (sourceStoppingTree α S hS f n Q).boxes u (f 3)

/-- The first tree-energy conclusion, uniform over source stopping roots. -/
def sourceStoppingTreeEnergyOneBound
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (f : ModelRealInput) (C₁ : ℝ) : Prop :=
  ∀ (n : Fin 4 → ℤ)
    (Q : {Q : AnisoBox α // Q ∈ stoppingRoots α S sourceStoppingExponent f n}),
    modelEnergyOne α (sourceStoppingTree α S hS f n Q).boxes u f ≤
      C₁ * sourceWeight u ^ 50 *
        boxMass α (sourceStoppingTree α S hS f n Q).root *
        (treeLocalSize (sourceStoppingTree α S hS f n Q) 4 (f 0) *
          treeLocalSize (sourceStoppingTree α S hS f n Q) 4 (f 1) *
          treeLocalSize (sourceStoppingTree α S hS f n Q) 4 (f 2)) ^ 2

/-- The second tree-energy conclusion, uniform over source stopping roots. -/
def sourceStoppingTreeEnergyTwoBound
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (f : ModelRealInput) (C₂ : ℝ) : Prop :=
  ∀ (n : Fin 4 → ℤ)
    (Q : {Q : AnisoBox α // Q ∈ stoppingRoots α S sourceStoppingExponent f n}),
    modelEnergyTwo α (sourceStoppingTree α S hS f n Q).boxes u (f 3) ≤
      C₂ * sourceWeight u ^ 100 *
        boxMass α (sourceStoppingTree α S hS f n Q).root *
        treeLocalSize (sourceStoppingTree α S hS f n Q) 2 (f 3) ^ 2

/-- The exact four integrability obligations which instantiate the two
bounded-continuous tree-energy estimates on every source stopping tree. -/
def sourceStoppingTreeEnergyIntegrability
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (f : ModelRealInput) : Prop :=
  ∀ (n : Fin 4 → ℤ)
    (Q : {Q : AnisoBox α // Q ∈ stoppingRoots α S sourceStoppingExponent f n}),
    Integrable (modelFirstSuperpositionJoint α u f)
      ((cubeScaleMeasure.restrict
        (collectionRegion α (sourceStoppingTree α S hS f n Q).boxes)).prod
        ((volume : Measure ModelE5).prod
          ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) ) ∧
    IntegrableOn (fun lam : ℝ ↦
      localCubeForm α (sourceStoppingTree α S hS f n Q).boxes 2 lam 0
        (modelFirstCubeTuple f) * lam ^ (-47 : ℝ)) (Set.Ici (1 : ℝ)) ∧
    Integrable (modelSecondSuperpositionJoint α (f 3))
      ((cubeScaleMeasure.restrict
        (collectionRegion α (sourceStoppingTree α S hS f n Q).boxes)).prod
        ((volume : Measure ModelE5).prod
          ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) ) ∧
    Integrable (fun z : ℝ × ℝ ↦
      localCubeForm α (sourceStoppingTree α S hS f n Q).boxes 2 z.1 z.2
        (edgeCubeTuple (f 3)) * translationWeight z.2 ^ (-50 : ℝ) *
          z.1 ^ (-47 : ℝ))
      (((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))).prod volume)

/-- The checked tree-energy package specializes uniformly to every root of
the active source stopping forest once its four explicit integrability
conditions are provided. -/
theorem sourceStoppingTree_energyBounds_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (f : ModelRealInput)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hint : sourceStoppingTreeEnergyIntegrability α S hS u f) :
    ∃ C₁ C₂ : ℝ, 0 ≤ C₁ ∧ 0 ≤ C₂ ∧
      sourceStoppingTreeEnergyOneBound α S hS u f C₁ ∧
      sourceStoppingTreeEnergyTwoBound α S hS u f C₂ := by
  rcases modelEnergyOne_tree_bound_of_boundedContinuous α with ⟨C₁, hC₁, hE₁⟩
  rcases modelEnergyTwo_tree_bound_of_boundedContinuous α with ⟨C₂, hC₂, hE₂⟩
  refine ⟨C₁, C₂, hC₁, hC₂, ?_, ?_⟩
  · intro n Q
    rcases hint n Q with ⟨hfirst, hscale, hsecond, hjoint⟩
    exact hE₁ (sourceStoppingTree α S hS f n Q) u f false
      hcont hbound hfirst hscale
  · intro n Q
    rcases hint n Q with ⟨hfirst, hscale, hsecond, hjoint⟩
    exact hE₂ (sourceStoppingTree α S hS f n Q) u (f 3) false
      (hcont 3) (hbound 3) hsecond hjoint

/-- The Section 5 finite active stopping-forest form estimate. The only
remaining analytic input is the exact outer form decomposition and the three
treewise hypotheses; the scalar stopping sum is discharged by the checked
coordinate-envelope theorem. -/
theorem activeStoppingForest_form_bound_of_energyBounds
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (q σ : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (hpos : ∀ q ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) q)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hfinite : ∀ n,
      volume (sourceStoppingDominantMaximalLevelSet α f q σ n) ≠ ∞)
    (C₁ C₂ : ℝ) (hC₁ : 0 ≤ C₁) (hC₂ : 0 ≤ C₂)
    (hdecomp :
      expandedModelLocalForm α S u c f =
        ∑ n ∈ activeStoppingLevels α S sourceStoppingExponent f hpos,
          ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
            expandedModelLocalForm α
              (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f)
    (hcs : sourceStoppingTreeCS α S hS u c f)
    (hE₁ : sourceStoppingTreeEnergyOneBound α S hS u f C₁)
    (hE₂ : sourceStoppingTreeEnergyTwoBound α S hS u f C₂) :
    |expandedModelLocalForm α S u c f| ≤
      (C₁ * C₂ + 1) * sourceWeight u ^ 75 *
        (∑ j : Fin 4,
          ∑ m ∈ (activeStoppingLevels α S sourceStoppingExponent f hpos).filter
              (fun n ↦ sourceStoppingDominantIndex q σ n = j) |>.image
                (fun n ↦ n j),
            sourceStoppingDominantFiberEnvelope q σ j m *
              (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) := by
  apply activeStoppingForest_form_bound_of_localBounds
    α S hS u c f q σ hq hpos hcont hbound hfinite (C₁ * C₂ + 1)
  · exact add_nonneg (mul_nonneg hC₁ hC₂) zero_le_one
  · exact hdecomp
  intro n Q
  apply stoppingTree_localModel_bound_of_energyBounds
    α S hS u c f C₁ C₂ hC₁ hC₂ n Q
  · simpa only [sourceStoppingTree] using hcs n Q
  · simpa only [sourceStoppingTree] using hE₁ n Q
  · simpa only [sourceStoppingTree] using hE₂ n Q

/-- The exact active-forest form decomposition obtained from a single outer
integrability hypothesis. This discharges the decomposition premise of the
terminal forest estimate without any rearrangement of conditionally
integrable terms. -/
theorem expandedModelLocalForm_activeStoppingForest_eq_sum_of_integrable
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput)
    (hpos : ∀ q ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) q)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict (collectionRegion α S))) :
    expandedModelLocalForm α S u c f =
      ∑ n ∈ activeStoppingLevels α S sourceStoppingExponent f hpos,
        ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
          expandedModelLocalForm α
            (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f := by
  classical
  let I := activeStoppingForestRoots α S sourceStoppingExponent f hpos
  let A : (Sigma fun _ : Fin 4 → ℤ ↦ AnisoBox α) → BoxCollection α :=
    fun z ↦ stoppingTreeBoxes α S sourceStoppingExponent f z.1 z.2
  have hpartition : S = I.biUnion A := by
    dsimp only [I, A]
    exact boxCollection_eq_biUnion_activeStoppingForestTreeBoxes
      α S sourceStoppingExponent f hpos
  have hint' : Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict (collectionRegion α (I.biUnion A))) := by
    rw [← hpartition]
    exact hint
  have hsum := expandedModelLocalForm_biUnion_eq_sum_of_integrable
    α I A u c f
    (by
      dsimp only [I, A]
      exact pairwiseDisjoint_activeStoppingForestTreeBoxes
        α S sourceStoppingExponent f hpos)
    hint'
  calc
    expandedModelLocalForm α S u c f =
        expandedModelLocalForm α (I.biUnion A) u c f := by rw [← hpartition]
    _ = ∑ z ∈ I, expandedModelLocalForm α (A z) u c f := hsum
    _ = ∑ n ∈ activeStoppingLevels α S sourceStoppingExponent f hpos,
        ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
          expandedModelLocalForm α
            (stoppingTreeBoxes α S sourceStoppingExponent f n Q.1) u c f := by
      simp only [I, A, activeStoppingForestRoots, Finset.sum_sigma]
      apply Finset.sum_congr rfl
      intro n hn
      symm
      exact Finset.sum_attach (stoppingRoots α S sourceStoppingExponent f n)
        (fun Q ↦ expandedModelLocalForm α
          (stoppingTreeBoxes α S sourceStoppingExponent f n Q) u c f)

/-- A ready-to-use finite active stopping-forest bound. It combines the
outer-integrability decomposition, treewise local-model/energy bounds, and
the source coordinate-envelope stopping estimate. -/
theorem activeStoppingForest_form_bound_of_energyBounds_of_integrable
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (q σ : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (hpos : ∀ q ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) q)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hfinite : ∀ n,
      volume (sourceStoppingDominantMaximalLevelSet α f q σ n) ≠ ∞)
    (C₁ C₂ : ℝ) (hC₁ : 0 ≤ C₁) (hC₂ : 0 ≤ C₂)
    (hcs : sourceStoppingTreeCS α S hS u c f)
    (hE₁ : sourceStoppingTreeEnergyOneBound α S hS u f C₁)
    (hE₂ : sourceStoppingTreeEnergyTwoBound α S hS u f C₂)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict (collectionRegion α S))) :
    |expandedModelLocalForm α S u c f| ≤
      (C₁ * C₂ + 1) * sourceWeight u ^ 75 *
        (∑ j : Fin 4,
          ∑ m ∈ (activeStoppingLevels α S sourceStoppingExponent f hpos).filter
              (fun n ↦ sourceStoppingDominantIndex q σ n = j) |>.image
                (fun n ↦ n j),
            sourceStoppingDominantFiberEnvelope q σ j m *
              (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) := by
  apply activeStoppingForest_form_bound_of_energyBounds
    α S hS u c f q σ hq hpos hcont hbound hfinite C₁ C₂ hC₁ hC₂
  · exact expandedModelLocalForm_activeStoppingForest_eq_sum_of_integrable
      α S u c f hpos hint
  · exact hcs
  · exact hE₁
  · exact hE₂

/-- The fully assembled bounded-continuous Section 5 active-forest estimate.
Its sole remaining analytic assumptions are the explicit treewise energy
integrability package and the outer form integrability needed for finite
Fubini additivity. -/
theorem activeStoppingForest_form_bound_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (q σ : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (hpos : ∀ q ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) q)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hfinite : ∀ n,
      volume (sourceStoppingDominantMaximalLevelSet α f q σ n) ≠ ∞)
    (hcs : sourceStoppingTreeCS α S hS u c f)
    (henergy : sourceStoppingTreeEnergyIntegrability α S hS u f)
    (hint : Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict (collectionRegion α S))) :
    ∃ C : ℝ, 0 ≤ C ∧
      |expandedModelLocalForm α S u c f| ≤
        C * sourceWeight u ^ 75 *
          (∑ j : Fin 4,
            ∑ m ∈ (activeStoppingLevels α S sourceStoppingExponent f hpos).filter
                (fun n ↦ sourceStoppingDominantIndex q σ n = j) |>.image
                  (fun n ↦ n j),
              sourceStoppingDominantFiberEnvelope q σ j m *
                (volume (sourceStoppingMaximalLevelSetAt α f j m)).toReal) := by
  rcases sourceStoppingTree_energyBounds_of_boundedContinuous
    α S hS u f hcont hbound henergy with ⟨C₁, C₂, hC₁, hC₂, hE₁, hE₂⟩
  refine ⟨C₁ * C₂ + 1, add_nonneg (mul_nonneg hC₁ hC₂) zero_le_one, ?_⟩
  exact activeStoppingForest_form_bound_of_energyBounds_of_integrable
    α S hS u c f q σ hq hpos hcont hbound hfinite C₁ C₂ hC₁ hC₂
    hcs hE₁ hE₂ hint

/-! ## Section 7: finite dyadic truncations and center--scale exhaustion

This scratch block follows `lem:model_convergence` in the Task 3 blueprint.
The root boxes are the eight level-`N` boxes indexed by `{-1,0}^3`; their
successive literal child generations supply all levels from `N` down to
`-N`. The remaining declarations turn any increasing exhaustion by these
finite regions into convergence of the expanded real model form.
-/

/-- The eight level-`N` roots of the spatial truncation in the source. -/
def truncationRoots (α : Anisotropy) (N : ℕ) : BoxCollection α :=
  Finset.univ.image fun v : Fin 3 → Bool ↦
    ⟨(N : ℤ), fun i ↦ if v i then 0 else -1⟩

/-- The spatial box `B_N`, initially presented as the union of its eight
literal dyadic roots. -/
noncomputable def truncationSpatialSet (α : Anisotropy) (N : ℕ) : Set E3 :=
  ⋃ q ∈ truncationRoots α N, boxSet α q

/-- Apply one literal dyadic refinement simultaneously to a finite family. -/
def refineCollection (α : Anisotropy) (S : BoxCollection α) :
    BoxCollection α :=
  S.biUnion (boxChildren α)

/-- The `d`-th level in the finite truncation rooted at level `N`. -/
def truncationLevel (α : Anisotropy) (N d : ℕ) : BoxCollection α :=
  (refineCollection α)^[d] (truncationRoots α N)

/-- The literal finite collection `Q_N`: roots together with all descendants
through level `-N`. -/
def truncationCollection (α : Anisotropy) (N : ℕ) : BoxCollection α :=
  (Finset.range (2 * N + 1)).biUnion (truncationLevel α N)

theorem mem_truncationRoots_iff (α : Anisotropy) (N : ℕ)
    (q : AnisoBox α) :
    q ∈ truncationRoots α N ↔
      q.level = N ∧ ∃ v : Fin 3 → Bool,
        q.index = fun i ↦ if v i then 0 else -1 := by
  constructor
  · intro hq
    rcases Finset.mem_image.mp hq with ⟨v, -, rfl⟩
    exact ⟨rfl, ⟨v, rfl⟩⟩
  · rintro ⟨hlevel, v, hindex⟩
    have hq : q = ⟨(N : ℤ), fun i ↦ if v i then 0 else -1⟩ := by
      cases q
      simp only [AnisoBox.mk.injEq] at hlevel hindex ⊢
      exact ⟨by simpa using hlevel, hindex⟩
    subst q
    exact Finset.mem_image.mpr ⟨v, Finset.mem_univ _, rfl⟩

theorem refineCollection_mem_iff (α : Anisotropy)
    (S : BoxCollection α) (q : AnisoBox α) :
    q ∈ refineCollection α S ↔
      ∃ r ∈ S, q ∈ boxChildren α r := by
  simp only [refineCollection, Finset.mem_biUnion]

theorem mem_truncationLevel_zero (α : Anisotropy) (N : ℕ)
    (q : AnisoBox α) :
    q ∈ truncationLevel α N 0 ↔ q ∈ truncationRoots α N := by
  simp [truncationLevel]

theorem truncationLevel_succ (α : Anisotropy) (N d : ℕ) :
    truncationLevel α N (d + 1) =
      refineCollection α (truncationLevel α N d) := by
  simp only [truncationLevel, Function.iterate_succ_apply']

theorem truncationLevel_level (α : Anisotropy) (N d : ℕ)
    {q : AnisoBox α} (hq : q ∈ truncationLevel α N d) :
    q.level = (N : ℤ) - d := by
  induction d generalizing q with
  | zero =>
      rw [mem_truncationLevel_zero] at hq
      exact (mem_truncationRoots_iff α N q).mp hq |>.1
  | succ d ih =>
      rw [truncationLevel_succ, refineCollection_mem_iff] at hq
      rcases hq with ⟨r, hr, hqchild⟩
      rw [boxChildren_level α hqchild, ih hr]
      push_cast
      ring

theorem subset_truncationSpatialSet_of_mem_truncationLevel
    (α : Anisotropy) (N d : ℕ) {q : AnisoBox α}
    (hq : q ∈ truncationLevel α N d) :
    boxSet α q ⊆ truncationSpatialSet α N := by
  induction d generalizing q with
  | zero =>
      rw [mem_truncationLevel_zero] at hq
      intro x hx
      exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hq, hx⟩⟩
  | succ d ih =>
      rw [truncationLevel_succ, refineCollection_mem_iff] at hq
      rcases hq with ⟨r, hr, hqchild⟩
      rcases Finset.mem_image.mp hqchild with ⟨v, -, rfl⟩
      have hparent : boxSet α (boxChild α r v) ⊆ boxSet α r := by
        simpa only [boxParent_child] using boxSet_subset_parent α (boxChild α r v)
      exact hparent.trans (ih hr)

theorem truncationSpatialSet_subset_iUnion_level
    (α : Anisotropy) (N d : ℕ) :
    truncationSpatialSet α N ⊆
      ⋃ q ∈ truncationLevel α N d, boxSet α q := by
  induction d with
  | zero =>
      exact Set.Subset.rfl
  | succ d ih =>
      intro x hx
      rcases Set.mem_iUnion.1 (ih hx) with ⟨q, hx⟩
      rcases Set.mem_iUnion.1 hx with ⟨hq, hxq⟩
      rcases Set.mem_iUnion.1 (boxSet_subset_children_union α q hxq) with ⟨r, hxr⟩
      rcases Set.mem_iUnion.1 hxr with ⟨hr, hxr⟩
      refine Set.mem_iUnion.2 ⟨r, Set.mem_iUnion.2 ⟨?_, hxr⟩⟩
      rw [truncationLevel_succ, refineCollection_mem_iff]
      exact ⟨q, hq, hr⟩

theorem iUnion_truncationLevel_eq_spatialSet
    (α : Anisotropy) (N d : ℕ) :
    (⋃ q ∈ truncationLevel α N d, boxSet α q) =
      truncationSpatialSet α N := by
  apply Set.Subset.antisymm
  · rintro x hx
    rcases Set.mem_iUnion.1 hx with ⟨q, hx⟩
    rcases Set.mem_iUnion.1 hx with ⟨hq, hx⟩
    exact subset_truncationSpatialSet_of_mem_truncationLevel α N d hq hx
  · exact truncationSpatialSet_subset_iUnion_level α N d

theorem exists_root_of_mem_truncationLevel
    (α : Anisotropy) (N d : ℕ) {q : AnisoBox α}
    (hq : q ∈ truncationLevel α N d) :
    ∃ R ∈ truncationRoots α N, boxSet α q ⊆ boxSet α R := by
  induction d generalizing q with
  | zero =>
      rw [mem_truncationLevel_zero] at hq
      exact ⟨q, hq, Set.Subset.rfl⟩
  | succ d ih =>
      rw [truncationLevel_succ, refineCollection_mem_iff] at hq
      rcases hq with ⟨r, hr, hqchild⟩
      rcases ih hr with ⟨R, hR, hrR⟩
      rcases Finset.mem_image.mp hqchild with ⟨v, -, rfl⟩
      refine ⟨R, hR, ?_⟩
      have hparent : boxSet α (boxChild α r v) ⊆ boxSet α r := by
        simpa only [boxParent_child] using boxSet_subset_parent α (boxChild α r v)
      exact hparent.trans hrR

theorem mem_truncationLevel_of_root_subset
    (α : Anisotropy) (N d : ℕ) (q R : AnisoBox α)
    (hR : R ∈ truncationRoots α N)
    (hlevel : q.level = (N : ℤ) - d)
    (hsub : boxSet α q ⊆ boxSet α R) :
    q ∈ truncationLevel α N d := by
  induction d generalizing q with
  | zero =>
      rw [mem_truncationLevel_zero]
      have hRlevel : R.level = N :=
        (mem_truncationRoots_iff α N R).mp hR |>.1
      have hancestor := boxAncestor_eq_of_boxSet_subset α hsub
      have hdiff : (R.level - q.level).toNat = 0 := by
        rw [hRlevel, hlevel]
        norm_num
      have hqR : q = R := by
        simpa [boxAncestor, hdiff] using hancestor
      simpa only [hqR] using hR
  | succ d ih =>
      rw [truncationLevel_succ, refineCollection_mem_iff]
      have hRlevel : R.level = N :=
        (mem_truncationRoots_iff α N R).mp hR |>.1
      have hparentlevel : (boxParent α q).level = (N : ℤ) - d := by
        simp only [boxParent]
        rw [hlevel]
        push_cast
        ring
      have hinter : (boxSet α (boxParent α q) ∩ boxSet α R).Nonempty := by
        obtain ⟨x, hx⟩ := boxSet_nonempty α q
        exact ⟨x, boxSet_subset_parent α q hx, hsub hx⟩
      have hparentR : boxSet α (boxParent α q) ⊆ boxSet α R := by
        apply boxSet_nested_of_inter_nonempty α
        · rw [hparentlevel, hRlevel]
          omega
        · exact hinter
      have hparentmem : boxParent α q ∈ truncationLevel α N d :=
        ih (boxParent α q) hparentlevel hparentR
      have hchild : q ∈ boxChildren α (boxParent α q) := by
        rcases (boxParent_eq_iff_exists_boxChild α (boxParent α q) q).mp rfl with
          ⟨v, hv⟩
        exact Finset.mem_image.mpr ⟨v, Finset.mem_univ _, hv⟩
      exact ⟨boxParent α q, hparentmem, hchild⟩

theorem mem_truncationLevel_iff
    (α : Anisotropy) (N d : ℕ) (q : AnisoBox α) :
    q ∈ truncationLevel α N d ↔
      q.level = (N : ℤ) - d ∧
        ∃ R ∈ truncationRoots α N, boxSet α q ⊆ boxSet α R := by
  constructor
  · intro hq
    exact ⟨truncationLevel_level α N d hq,
      exists_root_of_mem_truncationLevel α N d hq⟩
  · rintro ⟨hlevel, R, hR, hsub⟩
    exact mem_truncationLevel_of_root_subset α N d q R hR hlevel hsub

theorem mem_truncationCollection_iff (α : Anisotropy) (N : ℕ)
    (q : AnisoBox α) :
    q ∈ truncationCollection α N ↔
      ∃ d ∈ Finset.range (2 * N + 1), q ∈ truncationLevel α N d := by
  simp only [truncationCollection, Finset.mem_biUnion]

theorem truncationCollection_box_subset (α : Anisotropy) (N : ℕ)
    {q : AnisoBox α} (hq : q ∈ truncationCollection α N) :
    boxSet α q ⊆ truncationSpatialSet α N := by
  rcases (mem_truncationCollection_iff α N q).mp hq with ⟨d, -, hqd⟩
  exact subset_truncationSpatialSet_of_mem_truncationLevel α N d hqd

theorem truncationCollection_level_bounds
    (α : Anisotropy) (N : ℕ) {q : AnisoBox α}
    (hq : q ∈ truncationCollection α N) :
    -(N : ℤ) ≤ q.level ∧ q.level ≤ N := by
  rcases (mem_truncationCollection_iff α N q).mp hq with ⟨d, hd, hqd⟩
  have hdlt : d < 2 * N + 1 := Finset.mem_range.mp hd
  have hlevel := truncationLevel_level α N d hqd
  constructor <;> rw [hlevel] <;> omega

theorem exists_root_of_mem_truncationCollection
    (α : Anisotropy) (N : ℕ) {q : AnisoBox α}
    (hq : q ∈ truncationCollection α N) :
    ∃ R ∈ truncationRoots α N, boxSet α q ⊆ boxSet α R := by
  rcases (mem_truncationCollection_iff α N q).mp hq with ⟨d, -, hqd⟩
  exact exists_root_of_mem_truncationLevel α N d hqd

theorem parent_mem_truncationRoots
    (α : Anisotropy) (N : ℕ) {R : AnisoBox α}
    (hR : R ∈ truncationRoots α N) :
    boxParent α R ∈ truncationRoots α (N + 1) := by
  rcases (mem_truncationRoots_iff α N R).mp hR with ⟨hlevel, v, hindex⟩
  apply (mem_truncationRoots_iff α (N + 1) (boxParent α R)).mpr
  refine ⟨?_, v, ?_⟩
  · simp only [boxParent]
    rw [hlevel]
    push_cast
    ring
  · funext i
    simp only [boxParent]
    rw [hindex]
    by_cases hv : v i
    · simp [hv]
    · have hpos : (0 : ℤ) < anisoRadix α i := by
        exact_mod_cast anisoRadix_pos α i
      have hdiv : (-1 : ℤ) / (anisoRadix α i : ℤ) = -1 := by
        change Int.ediv (-1) (anisoRadix α i : ℤ) = -1
        rw [Int.ediv_of_neg_of_pos (by norm_num) hpos]
        simp
      simpa [hv] using hdiv

/-- The source truncation `Q_N` is convex in the literal grid order. -/
theorem isConvexCollection_truncationCollection
    (α : Anisotropy) (N : ℕ) :
    IsConvexCollection α (truncationCollection α N) := by
  intro q r w hq hr hqw hwr
  have hqlevel := truncationCollection_level_bounds α N hq
  have hrlevel := truncationCollection_level_bounds α N hr
  have hwlower : -(N : ℤ) ≤ w.level := by
    have h : q.level ≤ w.level := level_le_of_boxSet_subset α hqw
    exact hqlevel.1.trans h
  have hwupper : w.level ≤ N := by
    have h : w.level ≤ r.level := level_le_of_boxSet_subset α hwr
    exact h.trans hrlevel.2
  rcases exists_root_of_mem_truncationCollection α N hr with ⟨R, hR, hrR⟩
  let d : ℕ := ((N : ℤ) - w.level).toNat
  have hdZ : (d : ℤ) = (N : ℤ) - w.level := by
    dsimp [d]
    exact Int.toNat_of_nonneg (sub_nonneg.mpr hwupper)
  have hdmem : d ∈ Finset.range (2 * N + 1) := by
    apply Finset.mem_range.mpr
    rw [show d = ((d : ℤ).toNat) by simp, hdZ]
    omega
  have hwlevel : w.level = (N : ℤ) - d := by
    rw [show (d : ℤ) = (N : ℤ) - w.level by exact hdZ]
    ring
  have hwR : boxSet α w ⊆ boxSet α R := hwr.trans hrR
  have hwd : w ∈ truncationLevel α N d :=
    mem_truncationLevel_of_root_subset α N d w R hR hwlevel hwR
  exact (mem_truncationCollection_iff α N w).mpr ⟨d, hdmem, hwd⟩

theorem truncationCollection_subset_succ
    (α : Anisotropy) (N : ℕ) :
    truncationCollection α N ⊆ truncationCollection α (N + 1) := by
  intro q hq
  rcases exists_root_of_mem_truncationCollection α N hq with ⟨R, hR, hqR⟩
  have hP : boxParent α R ∈ truncationRoots α (N + 1) :=
    parent_mem_truncationRoots α N hR
  have hqlevel := truncationCollection_level_bounds α N hq
  let d : ℕ := ((N + 1 : ℕ) - q.level).toNat
  have hdZ : (d : ℤ) = (N + 1 : ℕ) - q.level := by
    dsimp [d]
    exact Int.toNat_of_nonneg (by omega)
  have hdmem : d ∈ Finset.range (2 * (N + 1) + 1) := by
    apply Finset.mem_range.mpr
    rw [show d = ((d : ℤ).toNat) by simp, hdZ]
    omega
  have hqlevel' : q.level = (N + 1 : ℕ) - d := by
    rw [show (d : ℤ) = (N + 1 : ℕ) - q.level by exact hdZ]
    ring
  have hqP : boxSet α q ⊆ boxSet α (boxParent α R) :=
    hqR.trans (boxSet_subset_parent α R)
  have hqd : q ∈ truncationLevel α (N + 1) d :=
    mem_truncationLevel_of_root_subset α (N + 1) d q (boxParent α R)
      hP hqlevel' hqP
  exact (mem_truncationCollection_iff α (N + 1) q).mpr ⟨d, hdmem, hqd⟩

theorem monotone_truncationCollection (α : Anisotropy) :
    Monotone (truncationCollection α) :=
  monotone_nat_of_le_succ (truncationCollection_subset_succ α)

theorem collectionRegion_mono_of_truncationCollection
    (α : Anisotropy) :
    Monotone fun N ↦ collectionRegion α (truncationCollection α N) := by
  intro N M hNM z hz
  change z ∈ collectionRegion α (truncationCollection α N) at hz
  change z ∈ collectionRegion α (truncationCollection α M)
  rw [collectionRegion] at hz
  rw [collectionRegion]
  rcases Set.mem_iUnion.1 hz with ⟨q, hz⟩
  rcases Set.mem_iUnion.1 hz with ⟨hq, hz⟩
  exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2
    ⟨monotone_truncationCollection α hNM hq, hz⟩⟩

/-- The scale interval carried by the source truncation `Q_N`. -/
noncomputable def truncationScaleSet (N : ℕ) : Set ℝ :=
  Set.Ioc ((2 : ℝ) ^ (-(N : ℤ) - 1)) ((2 : ℝ) ^ (N : ℤ))

/-- The scale band assigned to the `d`-th descendant generation. -/
noncomputable def truncationBand (N d : ℕ) : Set ℝ :=
  Set.Ioc ((2 : ℝ) ^ ((N : ℤ) - d - 1)) ((2 : ℝ) ^ ((N : ℤ) - d))

theorem iUnion_truncationBand_range (N m : ℕ) :
    (⋃ d ∈ Finset.range (m + 1), truncationBand N d) =
      Set.Ioc ((2 : ℝ) ^ ((N : ℤ) - m - 1)) ((2 : ℝ) ^ (N : ℤ)) := by
  induction m with
  | zero =>
      simp [truncationBand]
  | succ m ih =>
      have hjoin : truncationBand N (m + 1) =
          Set.Ioc ((2 : ℝ) ^ ((N : ℤ) - (m + 1) - 1))
            ((2 : ℝ) ^ ((N : ℤ) - m - 1)) := by
        simp only [truncationBand, Nat.cast_add, Nat.cast_one]
        congr 2
        all_goals ring
      calc
        (⋃ d ∈ Finset.range (m.succ + 1), truncationBand N d) =
            truncationBand N (m + 1) ∪
              (⋃ d ∈ Finset.range (m + 1), truncationBand N d) := by
          ext t
          simp [Nat.succ_eq_add_one, Finset.range_add_one]
        _ = Set.Ioc ((2 : ℝ) ^ ((N : ℤ) - (m + 1) - 1))
                ((2 : ℝ) ^ ((N : ℤ) - m - 1)) ∪
              Set.Ioc ((2 : ℝ) ^ ((N : ℤ) - m - 1)) ((2 : ℝ) ^ (N : ℤ)) := by rw [ih, hjoin]
        _ = Set.Ioc ((2 : ℝ) ^ ((N : ℤ) - (m + 1) - 1)) ((2 : ℝ) ^ (N : ℤ)) := by
          rw [Set.Ioc_union_Ioc_eq_Ioc]
          · apply zpow_le_zpow_right₀ (by norm_num)
            omega
          · apply zpow_le_zpow_right₀ (by norm_num)
            omega
        _ = Set.Ioc ((2 : ℝ) ^ ((N : ℤ) - m.succ - 1)) ((2 : ℝ) ^ (N : ℤ)) := by
          simp only [Nat.cast_succ]

theorem iUnion_truncationBand_eq_scaleSet (N : ℕ) :
    (⋃ d ∈ Finset.range (2 * N + 1), truncationBand N d) =
      truncationScaleSet N := by
  have h := iUnion_truncationBand_range N (2 * N)
  rw [truncationScaleSet]
  convert h using 1
  congr 2
  all_goals
    push_cast
    ring

theorem boxScaleBand_eq_truncationBand
    (α : Anisotropy) (N d : ℕ) {q : AnisoBox α}
    (hq : q ∈ truncationLevel α N d) :
    boxScaleBand q = truncationBand N d := by
  unfold boxScaleBand truncationBand boxLength
  rw [truncationLevel_level α N d hq]
  congr 1
  rw [zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0)]
  rw [zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0)]
  rw [zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0)]
  norm_num

theorem iUnion_boxScaleRegion_truncationLevel_eq
    (α : Anisotropy) (N d : ℕ) :
    (⋃ q ∈ truncationLevel α N d, boxScaleRegion α q) =
      truncationSpatialSet α N ×ˢ truncationBand N d := by
  ext pt
  constructor
  · intro hpt
    rcases Set.mem_iUnion.1 hpt with ⟨q, hpt⟩
    rcases Set.mem_iUnion.1 hpt with ⟨hq, hp, ht⟩
    constructor
    · rw [← iUnion_truncationLevel_eq_spatialSet α N d]
      exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hq, hp⟩⟩
    · rw [← boxScaleBand_eq_truncationBand α N d hq]
      exact ht
  · rintro ⟨hp, ht⟩
    rw [← iUnion_truncationLevel_eq_spatialSet α N d] at hp
    rcases Set.mem_iUnion.1 hp with ⟨q, hp⟩
    rcases Set.mem_iUnion.1 hp with ⟨hq, hp⟩
    refine Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hq, hp, ?_⟩⟩
    rw [boxScaleBand_eq_truncationBand α N d hq]
    exact ht

theorem boxLength_le_truncationScaleTop
    (α : Anisotropy) (N : ℕ) {q : AnisoBox α}
    (hq : q ∈ truncationCollection α N) :
    boxLength q ≤ (2 : ℝ) ^ (N : ℤ) := by
  unfold boxLength
  exact zpow_le_zpow_right₀ (by norm_num)
    (truncationCollection_level_bounds α N hq).2

theorem truncationScaleBottom_le_boxLength_div
    (α : Anisotropy) (N : ℕ) {q : AnisoBox α}
    (hq : q ∈ truncationCollection α N) :
    (2 : ℝ) ^ (-(N : ℤ) - 1) ≤ boxLength q / 2 := by
  have hlevel := (truncationCollection_level_bounds α N hq).1
  have hpow : (2 : ℝ) ^ (-(N : ℤ) - 1) ≤
      (2 : ℝ) ^ (q.level - 1) :=
    zpow_le_zpow_right₀ (by norm_num) (by omega)
  calc
    (2 : ℝ) ^ (-(N : ℤ) - 1) ≤ (2 : ℝ) ^ (q.level - 1) := hpow
    _ = boxLength q / 2 := by
      unfold boxLength
      rw [zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0)]
      norm_num

/-- Every literal cell of `Q_N` lies in the expected spatial/scale slab.
The reverse inclusion is the remaining grid-partition part of the Section 7
exhaustion argument. -/
theorem collectionRegion_truncationCollection_subset_slab
    (α : Anisotropy) (N : ℕ) :
    collectionRegion α (truncationCollection α N) ⊆
      truncationSpatialSet α N ×ˢ truncationScaleSet N := by
  intro pt hpt
  rw [collectionRegion] at hpt
  rcases Set.mem_iUnion.1 hpt with ⟨q, hpt⟩
  rcases Set.mem_iUnion.1 hpt with ⟨hq, hp, ht⟩
  constructor
  · exact truncationCollection_box_subset α N hq hp
  · change pt.2 ∈ Set.Ioc ((2 : ℝ) ^ (-(N : ℤ) - 1)) ((2 : ℝ) ^ (N : ℤ))
    change pt.2 ∈ boxScaleBand q at ht
    change boxLength q / 2 < pt.2 ∧ pt.2 ≤ boxLength q at ht
    exact ⟨lt_of_le_of_lt
      (truncationScaleBottom_le_boxLength_div α N hq) ht.1,
      ht.2.trans (boxLength_le_truncationScaleTop α N hq)⟩

/-- Exact center--scale region of the finite source truncation:
`Ω_{Q_N}=B_N × (2^{-N-1},2^N]`. -/
theorem collectionRegion_truncationCollection_eq_slab
    (α : Anisotropy) (N : ℕ) :
    collectionRegion α (truncationCollection α N) =
      truncationSpatialSet α N ×ˢ truncationScaleSet N := by
  apply Set.Subset.antisymm
  · exact collectionRegion_truncationCollection_subset_slab α N
  · rintro pt ⟨hp, ht⟩
    rw [← iUnion_truncationBand_eq_scaleSet N] at ht
    rcases Set.mem_iUnion.1 ht with ⟨d, ht⟩
    rcases Set.mem_iUnion.1 ht with ⟨hd, ht⟩
    have hplevel : pt.1 ∈ ⋃ q ∈ truncationLevel α N d, boxSet α q :=
      truncationSpatialSet_subset_iUnion_level α N d hp
    rcases Set.mem_iUnion.1 hplevel with ⟨q, hplevel⟩
    rcases Set.mem_iUnion.1 hplevel with ⟨hq, hpq⟩
    have hqcoll : q ∈ truncationCollection α N :=
      (mem_truncationCollection_iff α N q).mpr ⟨d, hd, hq⟩
    rw [collectionRegion]
    refine Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hqcoll, ?_⟩⟩
    change pt.1 ∈ boxSet α q ∧ pt.2 ∈ boxScaleBand q
    refine ⟨hpq, ?_⟩
    rw [boxScaleBand_eq_truncationBand α N d hq]
    exact ht

theorem mem_truncationSpatialSet_of_coord_abs_lt
    (α : Anisotropy) (N : ℕ) (x : E3)
    (hbound : ∀ i : Fin 3,
      |(WithLp.ofLp x : Fin 3 → ℝ) i| <
        (2 : ℝ) ^ ((N : ℤ) * (α.weight i : ℤ))) :
    x ∈ truncationSpatialSet α N := by
  let v : Fin 3 → Bool := fun i ↦ decide (0 ≤ (WithLp.ofLp x : Fin 3 → ℝ) i)
  let R : AnisoBox α := ⟨(N : ℤ), fun i ↦ if v i then 0 else -1⟩
  have hR : R ∈ truncationRoots α N :=
    (mem_truncationRoots_iff α N R).mpr ⟨by simp [R], v, by simp [R]⟩
  refine Set.mem_iUnion.2 ⟨R, Set.mem_iUnion.2 ⟨hR, ?_⟩⟩
  rw [boxSet, Set.mem_preimage, Set.mem_pi]
  intro i _
  have hside : boxSide α R i =
      (2 : ℝ) ^ ((N : ℤ) * (α.weight i : ℤ)) := by
    simp [R, boxSide]
  have hspos : 0 < boxSide α R i := boxSide_pos α R i
  rw [boxInterval]
  by_cases hxi : 0 ≤ (WithLp.ofLp x : Fin 3 → ℝ) i
  · have hv : v i = true := by simp [v, hxi]
    have hxlt : (WithLp.ofLp x : Fin 3 → ℝ) i < boxSide α R i := by
      rw [hside]
      exact (le_abs_self _).trans_lt (hbound i)
    simpa [R, hv] using ⟨hxi, hxlt⟩
  · have hxneg : (WithLp.ofLp x : Fin 3 → ℝ) i < 0 := lt_of_not_ge hxi
    have hv : v i = false := by simp [v, hxi]
    have hxlo : -(boxSide α R i) < (WithLp.ofLp x : Fin 3 → ℝ) i := by
      rw [hside]
      exact (abs_lt.mp (hbound i)).1
    simpa [R, hv] using ⟨hxlo.le, hxneg⟩

theorem exists_mem_truncationSpatialSet
    (α : Anisotropy) (x : E3) :
    ∃ N : ℕ, x ∈ truncationSpatialSet α N := by
  let C : ℝ := ∑ i : Fin 3, |(WithLp.ofLp x : Fin 3 → ℝ) i|
  have hpow : Tendsto (fun N : ℕ ↦ (2 : ℝ) ^ N) atTop atTop :=
    tendsto_pow_atTop_atTop_of_one_lt (by norm_num)
  obtain ⟨N, hN⟩ := hpow.eventually_gt_atTop C |>.exists
  refine ⟨N, mem_truncationSpatialSet_of_coord_abs_lt α N x ?_⟩
  intro i
  have hcoord : |(WithLp.ofLp x : Fin 3 → ℝ) i| ≤ C := by
    dsimp [C]
    exact Finset.single_le_sum
      (s := Finset.univ)
      (f := fun j : Fin 3 ↦ |(WithLp.ofLp x : Fin 3 → ℝ) j|)
      (fun j _ ↦ abs_nonneg _) (Finset.mem_univ i)
  have hweight : N ≤ N * α.weight i := by
    calc
      N = N * 1 := by omega
      _ ≤ N * α.weight i := Nat.mul_le_mul_left N
        (Nat.succ_le_iff.mpr (α.weight_pos i))
  calc
    |(WithLp.ofLp x : Fin 3 → ℝ) i| ≤ C := hcoord
    _ < (2 : ℝ) ^ N := hN
    _ ≤ (2 : ℝ) ^ (N * α.weight i) :=
      pow_le_pow_right₀ (by norm_num) hweight
    _ = (2 : ℝ) ^ ((N : ℤ) * (α.weight i : ℤ)) := by
      have hexp : ((N * α.weight i : ℕ) : ℤ) =
          (N : ℤ) * (α.weight i : ℤ) := by
        push_cast
        ring
      rw [← hexp, zpow_natCast]

theorem truncationSpatialSet_subset_succ
    (α : Anisotropy) (N : ℕ) :
    truncationSpatialSet α N ⊆ truncationSpatialSet α (N + 1) := by
  intro x hx
  rw [truncationSpatialSet] at hx ⊢
  rcases Set.mem_iUnion.1 hx with ⟨R, hx⟩
  rcases Set.mem_iUnion.1 hx with ⟨hR, hx⟩
  refine Set.mem_iUnion.2 ⟨boxParent α R, Set.mem_iUnion.2
    ⟨parent_mem_truncationRoots α N hR, ?_⟩⟩
  exact boxSet_subset_parent α R hx

theorem monotone_truncationSpatialSet (α : Anisotropy) :
    Monotone (truncationSpatialSet α) :=
  monotone_nat_of_le_succ (truncationSpatialSet_subset_succ α)

theorem truncationScaleSet_subset_succ (N : ℕ) :
    truncationScaleSet N ⊆ truncationScaleSet (N + 1) := by
  intro t ht
  change t ∈ Set.Ioc ((2 : ℝ) ^ (-(N : ℤ) - 1)) ((2 : ℝ) ^ (N : ℤ)) at ht
  change t ∈ Set.Ioc ((2 : ℝ) ^ (-((N + 1 : ℕ) : ℤ) - 1))
    ((2 : ℝ) ^ ((N + 1 : ℕ) : ℤ))
  constructor
  · apply lt_of_le_of_lt _ ht.1
    apply zpow_le_zpow_right₀ (by norm_num)
    push_cast
    omega
  · exact ht.2.trans (zpow_le_zpow_right₀ (by norm_num) (by push_cast; omega))

theorem monotone_truncationScaleSet : Monotone truncationScaleSet :=
  monotone_nat_of_le_succ truncationScaleSet_subset_succ

theorem exists_mem_truncationScaleSet {t : ℝ} (ht : 0 < t) :
    ∃ N : ℕ, t ∈ truncationScaleSet N := by
  have hpow : Tendsto (fun N : ℕ ↦ (2 : ℝ) ^ N) atTop atTop :=
    tendsto_pow_atTop_atTop_of_one_lt (by norm_num)
  obtain ⟨N, hNt, hNinv⟩ :=
    ((hpow.eventually_gt_atTop t).and
      (hpow.eventually_gt_atTop t⁻¹)).exists
  refine ⟨N, ?_⟩
  change t ∈ Set.Ioc ((2 : ℝ) ^ (-(N : ℤ) - 1)) ((2 : ℝ) ^ (N : ℤ))
  refine ⟨?_, ?_⟩
  · have hinv : ((2 : ℝ) ^ (N : ℤ))⁻¹ < (t⁻¹)⁻¹ :=
      inv_strictAntiOn
        (show t⁻¹ ∈ Set.Ioi (0 : ℝ) from inv_pos.mpr ht)
        (show (2 : ℝ) ^ N ∈ Set.Ioi (0 : ℝ) from
          pow_pos (show (0 : ℝ) < 2 by norm_num) N)
        hNinv
    have hneg : (2 : ℝ) ^ (-(N : ℤ)) < t := by
      simpa [zpow_neg, inv_inv] using hinv
    have hstep : (2 : ℝ) ^ (-(N : ℤ) - 1) ≤ (2 : ℝ) ^ (-(N : ℤ)) :=
      zpow_le_zpow_right₀ (by norm_num) (by omega)
    exact lt_of_le_of_lt hstep hneg
  · simpa only [zpow_natCast] using hNt.le

/-- The finite source regions exhaust exactly `E₃ × (0,∞)`. -/
theorem iUnion_collectionRegion_truncationCollection
    (α : Anisotropy) :
    (⋃ N : ℕ, collectionRegion α (truncationCollection α N)) =
      Set.univ ×ˢ Set.Ioi (0 : ℝ) := by
  apply Set.Subset.antisymm
  · rintro pt hpt
    rcases Set.mem_iUnion.1 hpt with ⟨N, hpt⟩
    rw [collectionRegion_truncationCollection_eq_slab α N] at hpt
    rcases hpt with ⟨-, ht⟩
    constructor
    · exact Set.mem_univ _
    · change (0 : ℝ) < pt.2
      exact lt_trans
        (show (0 : ℝ) < (2 : ℝ) ^ (-(N : ℤ) - 1) by exact zpow_pos (by norm_num) _)
        ht.1
  · rintro pt ⟨-, ht⟩
    obtain ⟨Np, hp⟩ := exists_mem_truncationSpatialSet α pt.1
    obtain ⟨Nt, ht'⟩ := exists_mem_truncationScaleSet ht
    let N : ℕ := max Np Nt
    have hpN : pt.1 ∈ truncationSpatialSet α N :=
      monotone_truncationSpatialSet α (Nat.le_max_left _ _) hp
    have htN : pt.2 ∈ truncationScaleSet N :=
      monotone_truncationScaleSet (Nat.le_max_right _ _) ht'
    refine Set.mem_iUnion.2 ⟨N, ?_⟩
    rw [collectionRegion_truncationCollection_eq_slab α N]
    exact ⟨hpN, htN⟩

/-- A generic increasing finite collection exhaustion gives convergence of
the real expanded local form whenever its signed outer integrand is integrable
on the limiting region. -/
theorem tendsto_expandedModelLocalForm_of_monotone_exhaustion
    (α : Anisotropy) (S : ℕ → BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (V : Set (E3 × ℝ))
    (hmono : Monotone fun N ↦ collectionRegion α (S N))
    (hV : (⋃ N, collectionRegion α (S N)) = V)
    (hint : IntegrableOn (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z)) V cubeScaleMeasure) :
    Tendsto (fun N ↦ expandedModelLocalForm α (S N) u c f) atTop
      (𝓝 (-∫ pt in V,
        c pt.2 * (∫ z : ModelE5,
          modelFirstFiber α f pt.1 pt.2 z *
            modelSecondFiber α (f 3) pt.1 pt.2 z *
              modelSignedDensity α u pt.1 pt.2 z)
        ∂cubeScaleMeasure)) := by
  let g : E3 × ℝ → ℝ := fun pt ↦
    c pt.2 * (∫ z : ModelE5,
      modelFirstFiber α f pt.1 pt.2 z *
        modelSecondFiber α (f 3) pt.1 pt.2 z *
          modelSignedDensity α u pt.1 pt.2 z)
  have hlim := tendsto_setIntegral_of_monotone
    (μ := cubeScaleMeasure)
    (f := g)
    (fun N ↦ measurableSet_collectionRegion α (S N)) hmono (by
      simpa only [hV] using hint)
  rw [hV] at hlim
  simpa only [expandedModelLocalForm, g] using hlim.neg

/-- The Section 7 convergence bridge for the literal finite truncations. -/
theorem tendsto_expandedModelLocalForm_truncationCollection
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (hint : IntegrableOn (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (Set.univ ×ˢ Set.Ioi (0 : ℝ)) cubeScaleMeasure) :
    Tendsto (fun N ↦ expandedModelLocalForm α
      (truncationCollection α N) u c f) atTop
      (𝓝 (-∫ pt in Set.univ ×ˢ Set.Ioi (0 : ℝ),
        c pt.2 * (∫ z : ModelE5,
          modelFirstFiber α f pt.1 pt.2 z *
            modelSecondFiber α (f 3) pt.1 pt.2 z *
              modelSignedDensity α u pt.1 pt.2 z)
        ∂cubeScaleMeasure)) := by
  exact tendsto_expandedModelLocalForm_of_monotone_exhaustion
    α (truncationCollection α) u c f (Set.univ ×ˢ Set.Ioi (0 : ℝ))
    (collectionRegion_mono_of_truncationCollection α)
    (iUnion_collectionRegion_truncationCollection α) hint

noncomputable def ModelScaleTail (a t : ℝ) : ℝ :=
  min (t ^ a) (t ^ (-a)) / t

theorem integrableOn_modelScaleTail
    {a : ℝ} (ha : 0 < a) :
    IntegrableOn (ModelScaleTail a) (Set.Ioi (0 : ℝ)) := by
  rw [← Set.Ioc_union_Ioi_eq_Ioi zero_le_one]
  apply IntegrableOn.union
  · refine IntegrableOn.congr_set_ae (t := Set.Ioo (0 : ℝ) 1) ?_
      (Filter.EventuallyEq.symm Ioo_ae_eq_Ioc)
    have hpower : IntegrableOn (fun t : ℝ ↦ t ^ (a - 1))
        (Set.Ioo (0 : ℝ) 1) :=
      (intervalIntegral.integrableOn_Ioo_rpow_iff zero_lt_one).2 (by linarith)
    apply Integrable.mono' hpower
    · unfold ModelScaleTail
      have hleft : ContinuousOn (fun t : ℝ ↦ t ^ a) (Set.Ioo (0 : ℝ) 1) :=
        continuousOn_id.rpow_const fun t ht ↦ Or.inl ht.1.ne'
      have hright : ContinuousOn (fun t : ℝ ↦ t ^ (-a)) (Set.Ioo (0 : ℝ) 1) :=
        continuousOn_id.rpow_const fun t ht ↦ Or.inl ht.1.ne'
      have hcont : ContinuousOn (ModelScaleTail a) (Set.Ioo (0 : ℝ) 1) :=
        (hleft.inf hright).div continuousOn_id (fun t ht ↦ ht.1.ne')
      exact hcont.aestronglyMeasurable measurableSet_Ioo
    · filter_upwards [ae_restrict_mem measurableSet_Ioo] with t ht
      have htpos : 0 < t := ht.1
      have hminnonneg : 0 ≤ min (t ^ a) (t ^ (-a)) :=
        le_min (Real.rpow_nonneg htpos.le _) (Real.rpow_nonneg htpos.le _)
      change |min (t ^ a) (t ^ (-a)) / t| ≤ t ^ (a - 1)
      rw [abs_of_nonneg (div_nonneg hminnonneg htpos.le)]
      calc
        min (t ^ a) (t ^ (-a)) / t ≤ t ^ a / t :=
          div_le_div_of_nonneg_right (min_le_left _ _) htpos.le
        _ = t ^ (a - 1) := by
          calc
            t ^ a / t = t ^ a / t ^ (1 : ℝ) := by rw [Real.rpow_one]
            _ = t ^ (a - 1) := (Real.rpow_sub htpos a 1).symm
  · have hpower : IntegrableOn (fun t : ℝ ↦ t ^ (-a - 1))
        (Set.Ioi (1 : ℝ)) :=
      integrableOn_Ioi_rpow_of_lt (by linarith) zero_lt_one
    apply Integrable.mono' hpower
    · unfold ModelScaleTail
      have hleft : ContinuousOn (fun t : ℝ ↦ t ^ a) (Set.Ioi (1 : ℝ)) :=
        continuousOn_id.rpow_const fun t ht ↦ Or.inl
          (lt_trans zero_lt_one (Set.mem_Ioi.mp ht)).ne'
      have hright : ContinuousOn (fun t : ℝ ↦ t ^ (-a)) (Set.Ioi (1 : ℝ)) :=
        continuousOn_id.rpow_const fun t ht ↦ Or.inl
          (lt_trans zero_lt_one (Set.mem_Ioi.mp ht)).ne'
      have hcont : ContinuousOn (ModelScaleTail a) (Set.Ioi (1 : ℝ)) :=
        (hleft.inf hright).div continuousOn_id
          (fun t ht ↦ (lt_trans zero_lt_one (Set.mem_Ioi.mp ht)).ne')
      exact hcont.aestronglyMeasurable measurableSet_Ioi
    · filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
      have htpos : 0 < t := lt_trans zero_lt_one (Set.mem_Ioi.mp ht)
      have hminnonneg : 0 ≤ min (t ^ a) (t ^ (-a)) :=
        le_min (Real.rpow_nonneg htpos.le _) (Real.rpow_nonneg htpos.le _)
      change |min (t ^ a) (t ^ (-a)) / t| ≤ t ^ (-a - 1)
      rw [abs_of_nonneg (div_nonneg hminnonneg htpos.le)]
      calc
        min (t ^ a) (t ^ (-a)) / t ≤ t ^ (-a) / t :=
          div_le_div_of_nonneg_right (min_le_right _ _) htpos.le
        _ = t ^ (-a - 1) := by
          calc
            t ^ (-a) / t = t ^ (-a) / t ^ (1 : ℝ) := by rw [Real.rpow_one]
            _ = t ^ (-a - 1) := (Real.rpow_sub htpos (-a) 1).symm

/-- The same small and large scale envelope is integrable for the source
logarithmic scale measure. -/
theorem integrableOn_modelScaleEnvelope_withDensity
    {a : ℝ} (ha : 0 < a) :
    IntegrableOn (fun t : ℝ ↦ min (t ^ a) (t ^ (-a))) (Set.Ioi (0 : ℝ))
      ((volume : Measure ℝ).withDensity cubeScaleDensity) := by
  have htop : ∀ᵐ t ∂(volume.restrict (Set.Ioi (0 : ℝ))),
      cubeScaleDensity t < ∞ := by
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    rw [cubeScaleDensity_eq_of_pos ht]
    exact ENNReal.ofReal_lt_top
  unfold IntegrableOn
  rw [restrict_withDensity measurableSet_Ioi]
  rw [integrable_withDensity_iff measurable_cubeScaleDensity htop]
  have heq : (fun t : ℝ ↦ min (t ^ a) (t ^ (-a)) *
      (cubeScaleDensity t).toReal) =ᵐ[volume.restrict (Set.Ioi (0 : ℝ))]
      ModelScaleTail a := by
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    rw [cubeScaleDensity_eq_of_pos ht,
      ENNReal.toReal_ofReal (inv_pos.mpr ht).le]
    unfold ModelScaleTail
    ring
  rw [integrable_congr heq]
  exact integrableOn_modelScaleTail ha

/-- A spatial absolute-integral estimate by the source scale envelope turns
directly into center--scale integrability. This is the measure-theoretic
consumer of the small- and large-scale estimates in `lem:model_convergence`.
-/
theorem integrableOn_centerScale_of_spatial_scale_bound
    {a C : ℝ} (ha : 0 < a)
    (g : E3 × ℝ → ℝ)
    (hgmeas : AEStronglyMeasurable g cubeScaleMeasure)
    (hfiber : ∀ t : ℝ, 0 < t → Integrable (fun p : E3 ↦ g (p, t)))
    (hbound : ∀ t : ℝ, 0 < t →
      (∫ p : E3, ‖g (p, t)‖) ≤ C * min (t ^ a) (t ^ (-a))) :
    IntegrableOn g (Set.univ ×ˢ Set.Ioi (0 : ℝ)) cubeScaleMeasure := by
  let ν : Measure ℝ := (volume : Measure ℝ).withDensity cubeScaleDensity
  let : SFinite ν := by
    dsimp only [ν]
    infer_instance
  unfold IntegrableOn cubeScaleMeasure
  change Integrable g (((volume : Measure E3).prod ν).restrict
    (Set.univ ×ˢ Set.Ioi (0 : ℝ)))
  rw [← Measure.prod_restrict]
  simp only [Measure.restrict_univ]
  have hmeas : AEStronglyMeasurable g
      ((volume : Measure E3).prod (ν.restrict (Set.Ioi (0 : ℝ)))) := by
    have hrestrict := hgmeas.restrict (s := Set.univ ×ˢ Set.Ioi (0 : ℝ))
    change AEStronglyMeasurable g (((volume : Measure E3).prod ν).restrict
      (Set.univ ×ˢ Set.Ioi (0 : ℝ))) at hrestrict
    rw [← Measure.prod_restrict] at hrestrict
    simpa only [Measure.restrict_univ] using hrestrict
  refine (integrable_prod_iff' hmeas).2 ⟨?_, ?_⟩
  · filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    exact hfiber t ht
  · have htail : Integrable (fun t : ℝ ↦
        C * min (t ^ a) (t ^ (-a))) (ν.restrict (Set.Ioi (0 : ℝ))) := by
      simpa only [ν, IntegrableOn] using
        (integrableOn_modelScaleEnvelope_withDensity ha).const_mul C
    have hTmeas : AEStronglyMeasurable (fun t : ℝ ↦
        ∫ p : E3, ‖g (p, t)‖)
        (ν.restrict (Set.Ioi (0 : ℝ))) := by
      simpa only [Prod.swap_prod_mk] using hmeas.norm.prod_swap.integral_prod_right'
    apply Integrable.mono' htail hTmeas
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    have hTnonneg : 0 ≤ ∫ p : E3, ‖g (p, t)‖ :=
      integral_nonneg fun p ↦ norm_nonneg (g (p, t))
    rw [Real.norm_eq_abs, abs_of_nonneg hTnonneg]
    exact hbound t ht

/-- The spatially integrated scale profile in `lem:model_convergence`. -/
noncomputable def ModelSpatialProfile
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ) : ℝ :=
  ∫ x : E3, ModelSpatialIntegrand α u F t x

/-- The source full-scale model form, once the spatial profile has been
formed. -/
noncomputable def ModelFullForm
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput) : ℝ :=
  ∫ t in Set.Ioi (0 : ℝ), c t * ModelSpatialProfile α u F t
    ∂((volume : Measure ℝ).withDensity cubeScaleDensity)

/-- The finite dyadic scale truncation used before taking the full-scale
limit. -/
noncomputable def ModelScaleTruncation
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (N : ℕ) : ℝ :=
  ∫ t in truncationScaleSet N, c t * ModelSpatialProfile α u F t
    ∂((volume : Measure ℝ).withDensity cubeScaleDensity)

/-- The scale intervals in the finite source truncations exhaust the
positive half-line. -/
theorem iUnion_truncationScaleSet :
    (⋃ N : ℕ, truncationScaleSet N) = Set.Ioi (0 : ℝ) := by
  apply Set.Subset.antisymm
  · rintro t ht
    rcases Set.mem_iUnion.1 ht with ⟨N, ht⟩
    change t ∈ Set.Ioc ((2 : ℝ) ^ (-(N : ℤ) - 1)) ((2 : ℝ) ^ (N : ℤ)) at ht
    exact lt_trans (zpow_pos (by norm_num) _) ht.1
  · intro t ht
    rcases exists_mem_truncationScaleSet ht with ⟨N, hN⟩
    exact Set.mem_iUnion.2 ⟨N, hN⟩

/-- The source small and large scale estimate makes the full profile
integrable against `dt / t`; this contains no integrability premise. -/
theorem integrableOn_modelScaleProfile_of_bound
    {a C : ℝ} (ha : 0 < a)
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hmeas : AEStronglyMeasurable
      (fun t : ℝ ↦ c t * ModelSpatialProfile α u F t)
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))))
    (hprofile : ∀ t : ℝ, 0 < t →
      |ModelSpatialProfile α u F t| ≤ C * min (t ^ a) (t ^ (-a))) :
    IntegrableOn (fun t : ℝ ↦ c t * ModelSpatialProfile α u F t)
      (Set.Ioi (0 : ℝ)) ((volume : Measure ℝ).withDensity cubeScaleDensity) := by
  have htail : Integrable (fun t : ℝ ↦
      C * min (t ^ a) (t ^ (-a)))
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))) := by
    simpa only [IntegrableOn] using
      (integrableOn_modelScaleEnvelope_withDensity ha).const_mul C
  unfold IntegrableOn
  apply Integrable.mono' htail hmeas
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
  rw [Real.norm_eq_abs, abs_mul]
  calc
    |c t| * |ModelSpatialProfile α u F t| ≤
        1 * |ModelSpatialProfile α u F t| :=
      mul_le_mul_of_nonneg_right (hc t) (abs_nonneg _)
    _ = |ModelSpatialProfile α u F t| := one_mul _
    _ ≤ C * min (t ^ a) (t ^ (-a)) := hprofile t ht

/-- The literal finite dyadic scale truncations converge to the full model
form once the source small and large scale profile estimate is available. -/
theorem tendsto_modelScaleTruncation_of_bound
    {a C : ℝ} (ha : 0 < a)
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hmeas : AEStronglyMeasurable
      (fun t : ℝ ↦ c t * ModelSpatialProfile α u F t)
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))))
    (hprofile : ∀ t : ℝ, 0 < t →
      |ModelSpatialProfile α u F t| ≤ C * min (t ^ a) (t ^ (-a))) :
    Tendsto (fun N ↦ ModelScaleTruncation α u c F N) atTop
      (𝓝 (ModelFullForm α u c F)) := by
  let ν : Measure ℝ := (volume : Measure ℝ).withDensity cubeScaleDensity
  let g : ℝ → ℝ := fun t ↦ c t * ModelSpatialProfile α u F t
  let S : ℕ → Set ℝ := truncationScaleSet
  have hint : IntegrableOn g (Set.Ioi (0 : ℝ)) ν := by
    simpa only [g, ν] using integrableOn_modelScaleProfile_of_bound
      ha α u c F hc hmeas hprofile
  have hSmeas : ∀ N : ℕ, MeasurableSet (S N) := by
    intro N
    exact measurableSet_Ioc
  have hSmono : Monotone S := by
    simpa only [S] using monotone_truncationScaleSet
  have hSunion : (⋃ N : ℕ, S N) = Set.Ioi (0 : ℝ) := by
    simpa only [S] using iUnion_truncationScaleSet
  have hlim := tendsto_setIntegral_of_monotone
    (μ := ν) (f := g) hSmeas hSmono (by rw [hSunion]; exact hint)
  rw [hSunion] at hlim
  simpa only [ModelScaleTruncation, ModelFullForm, S, g, ν] using hlim

end Twisted
