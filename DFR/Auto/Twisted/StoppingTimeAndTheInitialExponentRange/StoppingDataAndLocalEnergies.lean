/-- At a fixed source scale, five-model-variable integrability transports to
the passive pair and translation variables for the second superposition. -/
theorem integrable_modelSecondSuperposition_passive_at_scale
    (α : Anisotropy) (S : BoxCollection α) (lam : ℝ)
    (f : E3 → ℝ) (b : Bool)
    (hG : Integrable (fun xy : (E3 × ℝ) × ModelE5 ↦
      modelSecondSuperpositionJoint α f (xy.1, (xy.2, lam)))
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5))) :
    Integrable (fun w : (E3 × ℝ) ×
      ((TransverseSpace 2 × TransverseSpace 2) × ℝ) ↦
      cubePassiveGaussianKernel α 2 lam w.2.2 w.1.2 w.1.1 w.2.1 *
        (cubeActiveCSAverage α 2 lam w.2.2 (edgeCubeTuple f) b
          ((w.1.1, w.1.2), w.2.1)) ^ 2 *
        translationWeight w.2.2 ^ (-50 : ℝ) * lam ^ (-47 : ℝ))
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (((volume : Measure (TransverseSpace 2)).prod
          (volume : Measure (TransverseSpace 2))).prod volume)) := by
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let e := modelFirstPassiveCoordinatesProd (E3 × ℝ)
  let : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  have hmp : MeasurePreserving e (μ.prod (volume : Measure ModelE5))
      (μ.prod (((volume : Measure (TransverseSpace 2)).prod
        (volume : Measure (TransverseSpace 2))).prod volume)) := by
    simpa only [e, μ] using modelFirstPassiveCoordinatesProd_measurePreserving μ
  have htransport : Integrable (fun w : (E3 × ℝ) ×
      ((TransverseSpace 2 × TransverseSpace 2) × ℝ) ↦
      modelSecondSuperpositionJoint α f
        (e.symm w |>.1, (e.symm w |>.2, lam)))
      (μ.prod (((volume : Measure (TransverseSpace 2)).prod
        (volume : Measure (TransverseSpace 2))).prod volume)) := by
    exact (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hG
  refine htransport.congr ?_
  filter_upwards [] with w
  change modelSecondSuperpositionJoint α f
      (w.1, (modelFirstPassiveCoordinates.symm w.2, lam)) = _
  dsimp only [modelSecondSuperpositionJoint,
    modelSecondSuperpositionIntegrand]
  rw [← cubeActiveCSAverage_modelSecond α lam f b w.1.1 w.1.2
      (modelFirstPassiveCoordinates.symm w.2),
    ← cubePassiveGaussianKernel_modelFirst α lam w.2.2 w.1.1 w.1.2
      ((modelFirstPassiveCoordinates.symm w.2) 0)
      ((modelFirstPassiveCoordinates.symm w.2) 1)
      ((modelFirstPassiveCoordinates.symm w.2) 2)
      ((modelFirstPassiveCoordinates.symm w.2) 3),
    modelFirstPassiveCoordinates_symm_passive,
    modelFirstPassiveCoordinates_symm_translation]
  ring

/-- The second-energy superposition has the literal source-scale/translation
