theorem outerSecondSuperposition_eq_cubeComparison
    (α : Anisotropy) (S : BoxCollection α)
    (f : E3 → ℝ) (b : Bool) (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B)
