  calc
    (2 * 2 ^ (q 2 / q 0 * (m : ℝ))) *
        (2 * 2 ^ (q 2 / q 1 * (m : ℝ))) * (2 : ℝ) ^ m *
        (2 * 2 ^ (q 2 / q 3 * (m : ℝ))) =
        8 * (2 ^ (q 2 / q 0 * (m : ℝ)) *
          2 ^ (q 2 / q 1 * (m : ℝ)) * (2 : ℝ) ^ m *
          2 ^ (q 2 / q 3 * (m : ℝ))) := by ring
    _ = 8 * (2 : ℝ) ^ (q 2 * (m : ℝ)) := by rw [hpow]

/-- At zero normalization shift, the fiber with dominant coordinate three has
