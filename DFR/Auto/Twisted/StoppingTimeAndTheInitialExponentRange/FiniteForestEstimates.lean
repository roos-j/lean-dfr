      (2 * 2 ^ (q 3 / q 1 * (m : ℝ))) *
      (2 * 2 ^ (q 3 / q 2 * (m : ℝ))) * (2 : ℝ) ^ m =
        8 * (2 : ℝ) ^ (q 3 * (m : ℝ)) := by
  have hcoeff : q 3 / q 0 * (m : ℝ) + q 3 / q 1 * (m : ℝ) +
      q 3 / q 2 * (m : ℝ) + (m : ℝ) = q 3 * (m : ℝ) := by
    have hsum' : (q 0)⁻¹ + (q 1)⁻¹ + (q 2)⁻¹ + (q 3)⁻¹ = 1 := by
      simpa only [Fin.sum_univ_four] using hsum
    field_simp [ne_of_gt (hq 0), ne_of_gt (hq 1), ne_of_gt (hq 2),
      ne_of_gt (hq 3)] at hsum' ⊢
    ring_nf at hsum' ⊢
    linear_combination (m : ℝ) * hsum'
  have htwo : 0 < (2 : ℝ) := by norm_num
  have hpow : 2 ^ (q 3 / q 0 * (m : ℝ)) *
      2 ^ (q 3 / q 1 * (m : ℝ)) * 2 ^ (q 3 / q 2 * (m : ℝ)) *
      (2 : ℝ) ^ m = 2 ^ (q 3 * (m : ℝ)) := by
    rw [← Real.rpow_intCast, ← Real.rpow_add htwo,
      ← Real.rpow_add htwo, ← Real.rpow_add htwo, hcoeff]
  calc
    (2 * 2 ^ (q 3 / q 0 * (m : ℝ))) *
        (2 * 2 ^ (q 3 / q 1 * (m : ℝ))) *
        (2 * 2 ^ (q 3 / q 2 * (m : ℝ))) * (2 : ℝ) ^ m =
        8 * (2 ^ (q 3 / q 0 * (m : ℝ)) *
          2 ^ (q 3 / q 1 * (m : ℝ)) *
          2 ^ (q 3 / q 2 * (m : ℝ)) * (2 : ℝ) ^ m) := by ring
    _ = 8 * (2 : ℝ) ^ (q 3 * (m : ℝ)) := by rw [hpow]

/-- With zero normalization shifts, each dominant stopping fiber is exactly
eight times its coordinate's dyadic `q_j`-power weight. -/
theorem sourceStoppingDominantFiberEnvelope_zero_eq
    (q : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (j : Fin 4) (m : ℤ) :
    sourceStoppingDominantFiberEnvelope q (fun _ ↦ 0) j m =
      8 * (2 : ℝ) ^ (q j * (m : ℝ)) := by
  fin_cases j
  · simpa [sourceStoppingDominantFiberEnvelope, Fin.prod_univ_four] using
      dominantFiberEnvelope_zero_case0 q hq hsum m
  · simpa [sourceStoppingDominantFiberEnvelope, Fin.prod_univ_four] using
      dominantFiberEnvelope_zero_case1 q hq hsum m
  · simpa [sourceStoppingDominantFiberEnvelope, Fin.prod_univ_four] using
      dominantFiberEnvelope_zero_case2 q hq hsum m
  · simpa [sourceStoppingDominantFiberEnvelope, Fin.prod_univ_four] using
      dominantFiberEnvelope_zero_case3 q hq hsum m

/-! ## Coordinatewise dyadic bracket majorants -/

/-- On bounded inputs, pointwise domination of norms is preserved by the
literal real-valued fiber dyadic maximal operator. Boundedness excludes the
otherwise exceptional `ENNReal.toReal ⊤` case. -/
theorem fiberDyadicBallMaximal_mono_of_norm_le
    (G H : FiberDyadicBase × FiberDyadicLine → ℂ)
    (A : ℝ) (hA : 0 ≤ A) (hHbound : ∀ z, ‖H z‖ ≤ A)
    (hGH : ∀ z, ‖G z‖ ≤ ‖H z‖)
    (q : FiberDyadicBase × FiberDyadicLine) :
    fiberDyadicBallMaximal G q ≤ fiberDyadicBallMaximal H q := by
  let SG : ENNReal := ⨆ n : ℤ,
    ((volume (Metric.ball q.2 ((2 : ℝ) ^ n)))⁻¹ *
      ∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n), ENNReal.ofReal ‖G (q.1, y)‖)
  let SH : ENNReal := ⨆ n : ℤ,
    ((volume (Metric.ball q.2 ((2 : ℝ) ^ n)))⁻¹ *
      ∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n), ENNReal.ofReal ‖H (q.1, y)‖)
  have hHfin : SH ≤ ENNReal.ofReal A := by
    dsimp only [SH]
    exact fiberDyadicBallMaximalRaw_le_of_norm_le H q A hA hHbound
  have hGHraw : SG ≤ SH := by
    apply iSup_le
    intro n
    have hlin :
        (∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n), ENNReal.ofReal ‖G (q.1, y)‖) ≤
          ∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n), ENNReal.ofReal ‖H (q.1, y)‖ := by
      apply lintegral_mono
      intro y
      exact ENNReal.ofReal_le_ofReal (hGH (q.1, y))
    calc
      ((volume (Metric.ball q.2 ((2 : ℝ) ^ n)))⁻¹ *
          ∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n), ENNReal.ofReal ‖G (q.1, y)‖) ≤
          ((volume (Metric.ball q.2 ((2 : ℝ) ^ n)))⁻¹ *
            ∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n), ENNReal.ofReal ‖H (q.1, y)‖) :=
        mul_le_mul_right hlin _
      _ ≤ SH := by
        dsimp only [SH]
        exact le_iSup (fun n : ℤ =>
          ((volume (Metric.ball q.2 ((2 : ℝ) ^ n)))⁻¹ *
            ∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n),
              ENNReal.ofReal ‖H (q.1, y)‖)) n
  have hSHtop : SH ≠ ⊤ :=
    ne_top_of_le_ne_top ENNReal.ofReal_ne_top hHfin
  have hSGtop : SG ≠ ⊤ :=
    ne_top_of_le_ne_top hSHtop hGHraw
  change SG.toReal ≤ SH.toReal
  exact (ENNReal.toReal_le_toReal hSGtop hSHtop).mpr hGHraw

/-- The same monotonicity statement after transporting the fiber operator to
an arbitrary ambient coordinate of `E3`. -/
theorem coordinateDyadicBallMaximal_mono_of_norm_le
    (i : Fin 3) (f g : E3 → ℂ)
    (A : ℝ) (hA : 0 ≤ A) (hgbound : ∀ x, ‖g x‖ ≤ A)
    (hfg : ∀ x, ‖f x‖ ≤ ‖g x‖)
    (p : E3) :
    coordinateDyadicBallMaximal i f p ≤ coordinateDyadicBallMaximal i g p := by
  let e := e3ToFiberDyadicCoordinates i
  let F : FiberDyadicBase × FiberDyadicLine → ℂ := f ∘ e.symm
  let G : FiberDyadicBase × FiberDyadicLine → ℂ := g ∘ e.symm
  have hGbound : ∀ z, ‖G z‖ ≤ A := by
    intro z
    exact hgbound (e.symm z)
  have hFG : ∀ z, ‖F z‖ ≤ ‖G z‖ := by
    intro z
    exact hfg (e.symm z)
  change fiberDyadicBallMaximal F (e p) ≤ fiberDyadicBallMaximal G (e p)
  exact fiberDyadicBallMaximal_mono_of_norm_le F G A hA hGbound hFG (e p)
/-- The positive one-dimensional radial-bracket average in literal ambient
coordinate `i`, written through the measure-preserving coordinate split used
by the fiber dyadic maximal operator. -/
noncomputable def coordinateFiberRadialBracketAverage
    (i : Fin 3) (f : E3 → ℂ) (r : ℝ) (p : E3) : ℝ :=
  let e := e3ToFiberDyadicCoordinates i
  ∫ y : FiberDyadicLine,
    ‖f (e.symm ((e p).1, y))‖ *
      (r⁻¹ * fiberRadialBracket (r⁻¹ • (y - (e p).2)))

/-- The all-positive-scales radial-bracket maximum in one transported
ambient coordinate. -/
noncomputable def coordinateFiberRadialBracketMaximal
    (i : Fin 3) (f : E3 → ℂ) (p : E3) : ℝ :=
  sSup {a : ℝ | ∃ r : ℝ, 0 < r ∧
    a = coordinateFiberRadialBracketAverage i f r p}

/-- The product-fiber shell bound transports exactly to a literal coordinate
of `E3`. Its right side is independent of the continuous scale `r`. -/
theorem coordinateFiberRadialBracketAverage_le_dyadic
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ x, ‖f x‖ ≤ A)
    (r : ℝ) (hr : 0 < r) (p : E3) :
    coordinateFiberRadialBracketAverage i f r p ≤
      16 * (coordinateDyadicBallMaximal i f p *
        (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) := by
  let e := e3ToFiberDyadicCoordinates i
  let G : FiberDyadicBase × FiberDyadicLine → ℂ := f ∘ e.symm
  let q : FiberDyadicBase × FiberDyadicLine := e p
  have hG : Measurable G := hf.comp e.symm.measurable
  have hGbound : ∀ z, ‖G z‖ ≤ A := by
    intro z
    exact hbound (e.symm z)
  have h := fiberRadialBracket_integral_le_dyadic_average_sup
    G hG A hA hGbound q hr
  change (∫ y : FiberDyadicLine,
    ‖f (e.symm ((e p).1, y))‖ *
      (r⁻¹ * fiberRadialBracket (r⁻¹ • (y - (e p).2)))) ≤ _
  change (∫ y : FiberDyadicLine,
    ‖G (q.1, y)‖ *
      (r⁻¹ * fiberRadialBracket (r⁻¹ • (y - q.2))) ) ≤ _
  simpa only [coordinateDyadicBallMaximal, G, q, e, Function.comp_def] using h

/-- Taking the literal real supremum over all positive continuous scales
does not cost more than the same one-dimensional dyadic maximal function. -/
theorem coordinateFiberRadialBracketMaximal_le_dyadic
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ x, ‖f x‖ ≤ A)
    (p : E3) :
    coordinateFiberRadialBracketMaximal i f p ≤
      16 * (coordinateDyadicBallMaximal i f p *
        (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) := by
  unfold coordinateFiberRadialBracketMaximal
  apply csSup_le
  · exact ⟨coordinateFiberRadialBracketAverage i f 1 p,
      ⟨1, by norm_num, rfl⟩⟩
  · rintro b ⟨r, hr, rfl⟩
    exact coordinateFiberRadialBracketAverage_le_dyadic
      i f hf A hA hbound r hr p
/-- The three-coordinate dyadic majorant with the positive shell constant
inserted between stages. This nesting is designed to consume repeated
positive-kernel dominations without requiring an additional homogeneity lemma
for the real-valued dyadic supremum. -/
noncomputable def scaledIteratedCoordinateDyadicBallMaximal
    (K : ℝ) (f : E3 → ℂ) : E3 → ℂ :=
  (K : ℂ) • coordinateDyadicBallMaximalComplex 2
    ((K : ℂ) • coordinateDyadicBallMaximalComplex 1
      ((K : ℂ) • coordinateDyadicBallMaximalComplex 0 f))

private theorem norm_complex_ofReal_eq_of_nonneg {K : ℝ} (hK : 0 ≤ K) :
    ‖(K : ℂ)‖ = K := by
  simp only [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hK]

/-- Bounded measurable inputs retain every finite `L^p` norm under the
shell-scaled three-coordinate dyadic majorant. -/
theorem scaledIteratedCoordinateDyadicBallMaximal_memLp
    (K : ℝ) (hK : 0 ≤ K) (f : E3 → ℂ)
    (hf : Measurable f) (A : ℝ) (hA : 0 ≤ A)
    (hbound : ∀ x, ‖f x‖ ≤ A)
    {p : ℝ} (hp : 1 < p) (hfp : MemLp f (ENNReal.ofReal p) volume) :
    MemLp (scaledIteratedCoordinateDyadicBallMaximal K f)
      (ENNReal.ofReal p) volume := by
  let f₀ := coordinateDyadicBallMaximalComplex (0 : Fin 3) f
  let g₀ : E3 → ℂ := (K : ℂ) • f₀
  let f₁ := coordinateDyadicBallMaximalComplex (1 : Fin 3) g₀
  let g₁ : E3 → ℂ := (K : ℂ) • f₁
  let f₂ := coordinateDyadicBallMaximalComplex (2 : Fin 3) g₁
  have hnormK : ‖(K : ℂ)‖ = K := norm_complex_ofReal_eq_of_nonneg hK
  have hf₀ : Measurable f₀ := by
    dsimp only [f₀]
    exact coordinateDyadicBallMaximalComplex_measurable 0 f hf
  have hbound₀ : ∀ x, ‖f₀ x‖ ≤ A := by
    dsimp only [f₀]
    exact coordinateDyadicBallMaximalComplex_top_bound 0 f A hA hbound
  have hmem₀ : MemLp f₀ (ENNReal.ofReal p) volume := by
    dsimp only [f₀]
    exact coordinateDyadicBallMaximalComplex_memLp 0 f hf A hA hbound hp hfp
  have hg₀ : Measurable g₀ := by
    dsimp only [g₀]
    exact hf₀.const_smul (K : ℂ)
  have hboundg₀ : ∀ x, ‖g₀ x‖ ≤ K * A := by
    intro x
    change ‖(K : ℂ) • f₀ x‖ ≤ K * A
    rw [norm_smul, hnormK]
    exact mul_le_mul_of_nonneg_left (hbound₀ x) hK
  have hKmulA : 0 ≤ K * A := mul_nonneg hK hA
  have hmemg₀ : MemLp g₀ (ENNReal.ofReal p) volume := by
    dsimp only [g₀]
    exact hmem₀.const_smul (K : ℂ)
  have hf₁ : Measurable f₁ := by
    dsimp only [f₁]
    exact coordinateDyadicBallMaximalComplex_measurable 1 g₀ hg₀
  have hbound₁ : ∀ x, ‖f₁ x‖ ≤ K * A := by
    dsimp only [f₁]
    exact coordinateDyadicBallMaximalComplex_top_bound 1 g₀
      (K * A) hKmulA hboundg₀
  have hmem₁ : MemLp f₁ (ENNReal.ofReal p) volume := by
    dsimp only [f₁]
    exact coordinateDyadicBallMaximalComplex_memLp 1 g₀
      hg₀ (K * A) hKmulA hboundg₀ hp hmemg₀
  have hg₁ : Measurable g₁ := by
    dsimp only [g₁]
    exact hf₁.const_smul (K : ℂ)
  have hboundg₁ : ∀ x, ‖g₁ x‖ ≤ K * (K * A) := by
    intro x
    change ‖(K : ℂ) • f₁ x‖ ≤ K * (K * A)
    rw [norm_smul, hnormK]
    exact mul_le_mul_of_nonneg_left (hbound₁ x) hK
  have hKmulKmulA : 0 ≤ K * (K * A) := mul_nonneg hK hKmulA
  have hmemg₁ : MemLp g₁ (ENNReal.ofReal p) volume := by
    dsimp only [g₁]
    exact hmem₁.const_smul (K : ℂ)
  have hf₂ : Measurable f₂ := by
    dsimp only [f₂]
    exact coordinateDyadicBallMaximalComplex_measurable 2 g₁ hg₁
  have hmem₂ : MemLp f₂ (ENNReal.ofReal p) volume := by
    dsimp only [f₂]
    exact coordinateDyadicBallMaximalComplex_memLp 2 g₁
      hg₁ (K * (K * A)) hKmulKmulA hboundg₁ hp hmemg₁
  change MemLp ((K : ℂ) • f₂) (ENNReal.ofReal p) volume
  exact hmem₂.const_smul (K : ℂ)

/-- Real Schwartz data satisfy the boundedness and finite-`L^p` hypotheses
for the scaled three-coordinate dyadic majorant automatically. -/
theorem scaledIteratedCoordinateDyadicBallMaximal_memLp_of_realSchwartz
    (K : ℝ) (hK : 0 ≤ K) (f : SchwartzMap E3 ℝ)
    {p : ℝ} (hp : 1 < p) :
    MemLp (scaledIteratedCoordinateDyadicBallMaximal K
      (complexifyRealSchwartz f)) (ENNReal.ofReal p) volume := by
  rcases schwartz_continuous_bounded (complexifyRealSchwartz f) with
    ⟨hcont, A, hA, hbound⟩
  exact scaledIteratedCoordinateDyadicBallMaximal_memLp
    K hK (complexifyRealSchwartz f) hcont.measurable A hA hbound hp
    (schwartz_memLp (complexifyRealSchwartz f) (ENNReal.ofReal p))

/-- Every real Schwartz input has finite `L^p` norm after the three literal
coordinatewise dyadic maximal iterations, for every finite exponent above
one. This is the direct interface consumed once the bracket convolution is
pointwise dominated by the iterated operator. -/
theorem iteratedCoordinateDyadicBallMaximal_memLp_of_realSchwartz
    (f : SchwartzMap E3 ℝ) {p : ℝ} (hp : 1 < p) :
    MemLp (iteratedCoordinateDyadicBallMaximal (complexifyRealSchwartz f))
      (ENNReal.ofReal p) volume := by
  rcases schwartz_continuous_bounded (complexifyRealSchwartz f) with
    ⟨hcont, A, hA, hbound⟩
  exact iteratedCoordinateDyadicBallMaximal_memLp
    (complexifyRealSchwartz f) hcont.measurable A hA hbound hp
    (schwartz_memLp (complexifyRealSchwartz f) (ENNReal.ofReal p))
/-- The signed outer fiber integrand of the expanded local model form. -/
noncomputable def truncationFiberIntegrand
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (pt : E3 × ℝ) : ℝ :=
  c pt.2 * (∫ z : ModelE5,
    modelFirstFiber α f pt.1 pt.2 z *
      modelSecondFiber α (f 3) pt.1 pt.2 z *
        modelSignedDensity α u pt.1 pt.2 z)

/-- Restricting the coefficient to a fixed scale set restricts the outer
fiber integral to the corresponding center--scale slab. -/
theorem integral_truncationFiberIntegrand_restrictScale
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (A : Set ℝ) (hA : MeasurableSet A) (hApos : A ⊆ Set.Ioi (0 : ℝ)) :
    (∫ pt in Set.univ ×ˢ A,
      truncationFiberIntegrand α u c f pt ∂cubeScaleMeasure) =
      ∫ pt in Set.univ ×ˢ Set.Ioi (0 : ℝ),
        truncationFiberIntegrand α u (RestrictScaleCoefficient c A) f pt
          ∂cubeScaleMeasure := by
  let V : Set (E3 × ℝ) := Set.univ ×ˢ A
  let P : Set (E3 × ℝ) := Set.univ ×ˢ Set.Ioi (0 : ℝ)
  let g : E3 × ℝ → ℝ := truncationFiberIntegrand α u c f
  have hV : MeasurableSet V := MeasurableSet.univ.prod hA
  have hVP : V ⊆ P := by
    rintro ⟨p, t⟩ ht
    exact ⟨Set.mem_univ _, hApos ht.2⟩
  have hcut : truncationFiberIntegrand α u
      (RestrictScaleCoefficient c A) f = V.indicator g := by
    funext pt
    rcases pt with ⟨p, t⟩
    by_cases ht : t ∈ A
    · simp [truncationFiberIntegrand, RestrictScaleCoefficient, V, g, ht]
    · simp [truncationFiberIntegrand, RestrictScaleCoefficient, V, g, ht]
  change (∫ pt in V, g pt ∂cubeScaleMeasure) =
    ∫ pt in P, truncationFiberIntegrand α u
      (RestrictScaleCoefficient c A) f pt ∂cubeScaleMeasure
  rw [hcut, setIntegral_indicator hV, Set.inter_eq_right.mpr hVP]

/-- For a fixed positive scale band, the finite collections exhaust the
centers while the cutoff coefficient keeps the scale variable fixed. This
is the first, source-faithful limit in `lem:model_convergence`. -/
theorem tendsto_expandedModelLocalForm_centerExhaustion_restrictScale
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (A : Set ℝ) (hA : MeasurableSet A) (hApos : A ⊆ Set.Ioi (0 : ℝ))
    (hglobal : IntegrableOn
      (truncationFiberIntegrand α u (RestrictScaleCoefficient c A) f)
      (Set.univ ×ˢ Set.Ioi (0 : ℝ)) cubeScaleMeasure) :
    Tendsto (fun M ↦ expandedModelLocalForm α (truncationCollection α M) u
      (RestrictScaleCoefficient c A) f) atTop
      (𝓝 (-(∫ pt in Set.univ ×ˢ A,
        truncationFiberIntegrand α u c f pt ∂cubeScaleMeasure))) := by
  have hglobal' : IntegrableOn (fun pt : E3 × ℝ ↦
      RestrictScaleCoefficient c A pt.2 *
        (∫ z : ModelE5,
          modelFirstFiber α f pt.1 pt.2 z *
            modelSecondFiber α (f 3) pt.1 pt.2 z *
              modelSignedDensity α u pt.1 pt.2 z))
      (Set.univ ×ˢ Set.Ioi (0 : ℝ)) cubeScaleMeasure := by
    exact hglobal
  have hlim := tendsto_expandedModelLocalForm_truncationCollection
    α u (RestrictScaleCoefficient c A) f hglobal'
  change Tendsto (fun M ↦ expandedModelLocalForm α
      (truncationCollection α M) u (RestrictScaleCoefficient c A) f) atTop
      (𝓝 (-(∫ pt in Set.univ ×ˢ Set.Ioi (0 : ℝ),
        truncationFiberIntegrand α u (RestrictScaleCoefficient c A) f pt
          ∂cubeScaleMeasure))) at hlim
  rw [← integral_truncationFiberIntegrand_restrictScale
    α u c f A hA hApos] at hlim
  exact hlim

/-- The preceding center exhaustion specialized to the literal dyadic band
of the `N`-th source truncation. -/
theorem tendsto_expandedModelLocalForm_centerExhaustion_truncationScale
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelRealInput) (N : ℕ)
    (hglobal : IntegrableOn
      (truncationFiberIntegrand α u
        (RestrictScaleCoefficient c (truncationScaleSet N)) f)
      (Set.univ ×ˢ Set.Ioi (0 : ℝ)) cubeScaleMeasure) :
    Tendsto (fun M ↦ expandedModelLocalForm α (truncationCollection α M) u
      (RestrictScaleCoefficient c (truncationScaleSet N)) f) atTop
      (𝓝 (-(∫ pt in Set.univ ×ˢ truncationScaleSet N,
        truncationFiberIntegrand α u c f pt ∂cubeScaleMeasure))) := by
  exact tendsto_expandedModelLocalForm_centerExhaustion_restrictScale
    α u c f (truncationScaleSet N) measurableSet_Ioc
    (truncationScaleSet_subset_positive N) hglobal

/-- Opening the translation variable in the second fiber recovers the
intermediate third-coordinate kernel. This is the signed scalar identity
whose orientation is needed before applying the two fiber Fubini steps. -/
theorem modelThirdKernel_eq_integral_shiftedDerivative
    (u s p y : ℝ) (hs : 0 < s) :
    modelThirdKernel u s p y =
      ∫ r : ℝ, gaussianDerivAt s (p + r * s) y *
        conePsiPhysicalReal (r + u) := by
  let a : ℝ := (y - p) / s
  let G : ℝ → ℝ := fun z ↦
    gaussianDeriv z * conePsiPhysicalReal (a - z + u)
  have htranslate : (∫ r : ℝ, G (a - r)) = ∫ z : ℝ, G z :=
    integral_sub_left_eq_self G volume a
  have hpoint (r : ℝ) :
      gaussianDerivAt s (p + r * s) y * conePsiPhysicalReal (r + u) =
        s⁻¹ * G (a - r) := by
    dsimp only [G, a]
    unfold gaussianDerivAt kernelAt kernelDilate
    simp only [smul_eq_mul]
    rw [show (y - (p + r * s)) / s = (y - p) / s - r by
      field_simp [hs.ne']
      ring,
      show (y - p) / s - ((y - p) / s - r) + u = r + u by ring]
    ring
  calc
    modelThirdKernel u s p y = s⁻¹ * ∫ z : ℝ, G z := by
      dsimp only [G, a]
      unfold modelThirdKernel kernelAt kernelDilate
      simp only [smul_eq_mul]
    _ = s⁻¹ * ∫ r : ℝ, G (a - r) := by rw [htranslate]
    _ = ∫ r : ℝ, s⁻¹ * G (a - r) := by
      rw [MeasureTheory.integral_const_mul]
    _ = ∫ r : ℝ, gaussianDerivAt s (p + r * s) y *
        conePsiPhysicalReal (r + u) := by
      apply integral_congr_ae
      filter_upwards [] with r
      exact (hpoint r).symm

/-- The second fiber's translation average is exactly convolution with the
third intermediate kernel, provided the displayed two-variable absolute
integrability condition licenses Fubini. -/
theorem integral_secondFiber_translation_eq_modelThirdKernel
    (f : ℝ → ℝ) (u s p : ℝ) (hs : 0 < s)
    (hjoint : Integrable (Function.uncurry (fun r : ℝ ↦ fun y : ℝ ↦
      f y * gaussianDerivAt s (p + r * s) y *
        conePsiPhysicalReal (r + u)))
      ((volume : Measure ℝ).prod volume)) :
    (∫ r : ℝ,
      (∫ y : ℝ, f y * gaussianDerivAt s (p + r * s) y) *
        conePsiPhysicalReal (r + u)) =
      ∫ y : ℝ, f y * modelThirdKernel u s p y := by
  let H : ℝ → ℝ → ℝ := fun r y ↦
    f y * gaussianDerivAt s (p + r * s) y *
      conePsiPhysicalReal (r + u)
  have hH : Integrable (Function.uncurry H)
      ((volume : Measure ℝ).prod volume) := by
    simpa only [H] using hjoint
  have hleft :
      (∫ r : ℝ,
        (∫ y : ℝ, f y * gaussianDerivAt s (p + r * s) y) *
          conePsiPhysicalReal (r + u)) =
        ∫ r : ℝ, ∫ y : ℝ, H r y := by
    apply integral_congr_ae
    filter_upwards [hH.prod_right_ae] with r hr
    rw [← MeasureTheory.integral_mul_const]
  calc
    (∫ r : ℝ,
      (∫ y : ℝ, f y * gaussianDerivAt s (p + r * s) y) *
        conePsiPhysicalReal (r + u)) =
        ∫ r : ℝ, ∫ y : ℝ, H r y := hleft
    _ = ∫ y : ℝ, ∫ r : ℝ, H r y :=
      MeasureTheory.integral_integral_swap hH
    _ = ∫ y : ℝ, f y * modelThirdKernel u s p y := by
      apply integral_congr_ae
      filter_upwards [] with y
      dsimp only [H]
      rw [show (fun r : ℝ ↦
          f y * gaussianDerivAt s (p + r * s) y *
            conePsiPhysicalReal (r + u)) =
          fun r ↦ f y * (gaussianDerivAt s (p + r * s) y *
            conePsiPhysicalReal (r + u)) by
          funext r
          ring,
        MeasureTheory.integral_const_mul,
        modelThirdKernel_eq_integral_shiftedDerivative u s p y hs]

/-- The fully opened product-space integrand behind the two model fibers.
The last two real variables are respectively the first- and second-fiber
coordinates. -/
noncomputable def modelFiberFullyExpandedIntegrand
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (q : ((E3 × ℝ) × ModelE5) × (ℝ × ℝ)) : ℝ :=
  let pt : E3 × ℝ := q.1.1
  let z : ModelE5 := q.1.2
  let v : ℝ := q.2.1
  let w : ℝ := q.2.2
  c pt.2 *
    ((modelFirstFiberIntegrand f (z 0) (z 1) (z 2) (z 3) v *
        gaussianDerivAt (pt.2 ^ α.weight 2) (pt.1 2) v) *
      (f 3 (modelPoint (z 0) (z 1) w) *
        gaussianDerivAt (pt.2 ^ α.weight 2)
          (pt.1 2 + z 4 * pt.2 ^ α.weight 2) w) *
        modelSignedDensity α u pt.1 pt.2 z)

/-- At each fixed center--scale point and fiber base point, integrating the
opened variables reconstructs the product of the two original fibers. -/
theorem integral_modelFiberFullyExpanded_inner
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (pt : E3 × ℝ) (z : ModelE5) :
    (∫ vw : ℝ × ℝ,
      modelFiberFullyExpandedIntegrand α u c f ((pt, z), vw)) =
      c pt.2 *
        (modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z) := by
  let A : ℝ → ℝ := fun v ↦
    modelFirstFiberIntegrand f (z 0) (z 1) (z 2) (z 3) v *
      gaussianDerivAt (pt.2 ^ α.weight 2) (pt.1 2) v
  let B : ℝ → ℝ := fun w ↦
    f 3 (modelPoint (z 0) (z 1) w) *
      gaussianDerivAt (pt.2 ^ α.weight 2)
        (pt.1 2 + z 4 * pt.2 ^ α.weight 2) w
  have hprod : (∫ vw : ℝ × ℝ, A vw.1 * B vw.2) =
      (∫ v : ℝ, A v) * ∫ w : ℝ, B w :=
    MeasureTheory.integral_prod_mul A B
  change (∫ vw : ℝ × ℝ,
      c pt.2 * (A vw.1 * B vw.2 * modelSignedDensity α u pt.1 pt.2 z)) = _
  rw [show (fun vw : ℝ × ℝ ↦
      c pt.2 * (A vw.1 * B vw.2 * modelSignedDensity α u pt.1 pt.2 z)) =
      fun vw ↦ (c pt.2 * modelSignedDensity α u pt.1 pt.2 z) *
        (A vw.1 * B vw.2) by
        funext vw
        ring,
    MeasureTheory.integral_const_mul, hprod,
    ← modelFirstFiber_eq_integral]
  have hsecond : (∫ w : ℝ, B w) =
      modelSecondFiber α (f 3) pt.1 pt.2 z := by
    rfl
  rw [hsecond]
  ring

/-- Absolute integrability of the fully opened two-fiber integrand licenses
the two Fubini steps which turn the outer fiber expression into one ordinary
product-space integral. -/
theorem integral_truncationFiberIntegrand_eq_fullyExpanded_of_integrable
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (V : Set (E3 × ℝ))
    (hjoint : Integrable (modelFiberFullyExpandedIntegrand α u c f)
      (((cubeScaleMeasure.restrict V).prod (volume : Measure ModelE5)).prod
        ((volume : Measure ℝ).prod volume))) :
    (∫ pt in V, truncationFiberIntegrand α u c f pt ∂cubeScaleMeasure) =
      ∫ q : ((E3 × ℝ) × ModelE5) × (ℝ × ℝ),
        modelFiberFullyExpandedIntegrand α u c f q
        ∂(((cubeScaleMeasure.restrict V).prod (volume : Measure ModelE5)).prod
          ((volume : Measure ℝ).prod volume)) := by
  let : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  let μ : Measure (E3 × ℝ) := cubeScaleMeasure.restrict V
  let : SFinite μ := by
    dsimp only [μ]
    infer_instance
  let G : ((E3 × ℝ) × ModelE5) × (ℝ × ℝ) → ℝ :=
    modelFiberFullyExpandedIntegrand α u c f
  have hG : Integrable G
      ((μ.prod (volume : Measure ModelE5)).prod
        ((volume : Measure ℝ).prod volume)) := by
    simpa only [G, μ] using hjoint
  have hinner : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      ∫ vw : ℝ × ℝ, G (q, vw))
      (μ.prod (volume : Measure ModelE5)) :=
    hG.integral_prod_left
  change (∫ pt : E3 × ℝ,
      truncationFiberIntegrand α u c f pt ∂μ) =
      ∫ q : ((E3 × ℝ) × ModelE5) × (ℝ × ℝ), G q
        ∂((μ.prod (volume : Measure ModelE5)).prod
          ((volume : Measure ℝ).prod volume))
  calc
    (∫ pt : E3 × ℝ,
      truncationFiberIntegrand α u c f pt ∂μ) =
        ∫ pt : E3 × ℝ,
          (∫ z : ModelE5,
            (∫ vw : ℝ × ℝ, G ((pt, z), vw)
              ∂((volume : Measure ℝ).prod volume))
            ∂(volume : Measure ModelE5)) ∂μ := by
          apply integral_congr_ae
          filter_upwards [] with pt
          unfold truncationFiberIntegrand
          rw [← MeasureTheory.integral_const_mul]
          apply integral_congr_ae
          filter_upwards [] with z
          exact (integral_modelFiberFullyExpanded_inner
            α u c f pt z).symm
    _ = ∫ q : (E3 × ℝ) × ModelE5,
        (∫ vw : ℝ × ℝ, G (q, vw)
          ∂((volume : Measure ℝ).prod volume))
        ∂(μ.prod (volume : Measure ModelE5)) := by
          exact (MeasureTheory.integral_prod _ hinner).symm
    _ = ∫ q : ((E3 × ℝ) × ModelE5) × (ℝ × ℝ), G q
        ∂((μ.prod (volume : Measure ModelE5)).prod
          ((volume : Measure ℝ).prod volume)) := by
          exact (MeasureTheory.integral_prod _ hG).symm

/-- The center-expanded integrand before the last translation variable has
been integrated. It is the exact target of the coordinate reordering of
the fully opened two-fiber expression. -/
noncomputable def ModelCenterTranslationIntegrand
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (q : ((E3 × E3) × E3) × ℝ) : ℝ :=
  let x : E3 := q.1.1.1
  let y : E3 := q.1.1.2
  let p : E3 := q.1.2
  let r : ℝ := q.2
  (F 0 x * F 1 (modelPoint (y 0) (x 1) (x 2)) *
      F 2 (modelPoint (x 0) (y 1) (x 2)) *
      F 3 (modelPoint (x 0) (x 1) (y 2))) *
    ((modelPhiAt (t ^ α.weight 0)
          (p 0 + t ^ α.weight 0 * u 0) (x 0) *
        gaussianAt (t ^ α.weight 0) (p 0) (y 0)) *
      (modelPhiAt (t ^ α.weight 1)
          (p 1 + t ^ α.weight 1 * u 1) (x 1) *
        gaussianAt (t ^ α.weight 1) (p 1) (y 1)) *
      (gaussianDerivAt (t ^ α.weight 2) (p 2) (x 2) *
        gaussianDerivAt (t ^ α.weight 2)
          (p 2 + r * t ^ α.weight 2) (y 2) *
          conePsiPhysicalReal (r + u 2)))

/-- At a positive scale, the translation integral of the preceding raw
center integrand is the center-expanded integrand used by the fixed-scale
profile identity. -/
theorem integral_ModelCenterTranslation_inner
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ) (ht : 0 < t)
    (q : (E3 × E3) × E3) :
    (∫ r : ℝ, ModelCenterTranslationIntegrand α u F t (q, r)) =
      ModelCenterExpandedIntegrand α u F t q := by
  let x : E3 := q.1.1
  let y : E3 := q.1.2
  let p : E3 := q.2
  let K : ℝ :=
    (F 0 x * F 1 (modelPoint (y 0) (x 1) (x 2)) *
        F 2 (modelPoint (x 0) (y 1) (x 2)) *
        F 3 (modelPoint (x 0) (x 1) (y 2))) *
      ((modelPhiAt (t ^ α.weight 0)
            (p 0 + t ^ α.weight 0 * u 0) (x 0) *
          gaussianAt (t ^ α.weight 0) (p 0) (y 0)) *
        (modelPhiAt (t ^ α.weight 1)
            (p 1 + t ^ α.weight 1 * u 1) (x 1) *
          gaussianAt (t ^ α.weight 1) (p 1) (y 1)) *
        gaussianDerivAt (t ^ α.weight 2) (p 2) (x 2))
  have hfactor (r : ℝ) :
      ModelCenterTranslationIntegrand α u F t (q, r) =
        K * (gaussianDerivAt (t ^ α.weight 2)
          (p 2 + r * t ^ α.weight 2) (y 2) *
            conePsiPhysicalReal (r + u 2)) := by
    simp only [ModelCenterTranslationIntegrand, x, y, p, K]
    ring
  calc
    (∫ r : ℝ, ModelCenterTranslationIntegrand α u F t (q, r)) =
        ∫ r : ℝ, K * (gaussianDerivAt (t ^ α.weight 2)
          (p 2 + r * t ^ α.weight 2) (y 2) *
            conePsiPhysicalReal (r + u 2)) := by
          apply integral_congr_ae
          filter_upwards [] with r
          exact hfactor r
    _ = K * ∫ r : ℝ, gaussianDerivAt (t ^ α.weight 2)
        (p 2 + r * t ^ α.weight 2) (y 2) *
          conePsiPhysicalReal (r + u 2) := by
          rw [MeasureTheory.integral_const_mul]
    _ = K * modelThirdKernel (u 2) (t ^ α.weight 2) (p 2) (y 2) := by
          rw [← modelThirdKernel_eq_integral_shiftedDerivative
            (u 2) (t ^ α.weight 2) (p 2) (y 2) (pow_pos ht _)]
    _ = ModelCenterExpandedIntegrand α u F t q := by
          simp only [ModelCenterExpandedIntegrand, x, y, p, K]
          ring

/-- The translation-open center integral collapses to the ordinary center
expanded integral whenever its product-space integral is absolutely
integrable. -/
theorem integral_ModelCenterTranslation_eq_ModelCenterExpanded_of_integrable
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ) (ht : 0 < t)
    (hjoint : Integrable (ModelCenterTranslationIntegrand α u F t)
      ((((volume : Measure E3).prod volume).prod volume).prod volume)) :
    (∫ q : ((E3 × E3) × E3) × ℝ,
      ModelCenterTranslationIntegrand α u F t q
      ∂((((volume : Measure E3).prod volume).prod volume).prod volume)) =
      ∫ q : (E3 × E3) × E3,
        ModelCenterExpandedIntegrand α u F t q
        ∂(((volume : Measure E3).prod volume).prod volume) := by
  have hinner : Integrable (fun q : (E3 × E3) × E3 ↦
      ∫ r : ℝ, ModelCenterTranslationIntegrand α u F t (q, r))
      (((volume : Measure E3).prod volume).prod volume) :=
    hjoint.integral_prod_left
  calc
    (∫ q : ((E3 × E3) × E3) × ℝ,
      ModelCenterTranslationIntegrand α u F t q
      ∂((((volume : Measure E3).prod volume).prod volume).prod volume)) =
        ∫ q : (E3 × E3) × E3,
          (∫ r : ℝ, ModelCenterTranslationIntegrand α u F t (q, r))
          ∂(((volume : Measure E3).prod volume).prod volume) :=
      MeasureTheory.integral_prod _ hjoint
    _ = ∫ q : (E3 × E3) × E3,
        ModelCenterExpandedIntegrand α u F t q
        ∂(((volume : Measure E3).prod volume).prod volume) := by
      apply integral_congr_ae
      filter_upwards [] with q
      exact integral_ModelCenterTranslation_inner α u F t ht q

/-- The translation-open center calculation may be performed under a scale
integral as soon as its center--translation fibers are integrable almost
everywhere on the scale band. -/
theorem integral_centerTranslationScale_eq_centerExpandedScale
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (A : Set ℝ) (hA : MeasurableSet A) (hApos : A ⊆ Set.Ioi (0 : ℝ))
    (hraw : ∀ᵐ t ∂((volume : Measure ℝ).withDensity cubeScaleDensity).restrict A,
      Integrable (ModelCenterTranslationIntegrand α u F t)
        ((((volume : Measure E3).prod volume).prod volume).prod volume)) :
    (∫ t in A,
      ∫ q : ((E3 × E3) × E3) × ℝ,
        c t * ModelCenterTranslationIntegrand α u F t q
        ∂((((volume : Measure E3).prod volume).prod volume).prod volume)
      ∂((volume : Measure ℝ).withDensity cubeScaleDensity)) =
      ∫ t in A, c t *
        (∫ q : (E3 × E3) × E3,
          ModelCenterExpandedIntegrand α u F t q
          ∂(((volume : Measure E3).prod volume).prod volume))
        ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
  apply integral_congr_ae
  filter_upwards [hraw, ae_restrict_mem hA] with t htint ht
  calc
    (∫ q : ((E3 × E3) × E3) × ℝ,
      c t * ModelCenterTranslationIntegrand α u F t q
      ∂((((volume : Measure E3).prod volume).prod volume).prod volume)) =
        c t * (∫ q : ((E3 × E3) × E3) × ℝ,
          ModelCenterTranslationIntegrand α u F t q
          ∂((((volume : Measure E3).prod volume).prod volume).prod volume)) := by
            exact MeasureTheory.integral_const_mul (c t)
              (fun q : ((E3 × E3) × E3) × ℝ ↦
                ModelCenterTranslationIntegrand α u F t q)
    _ = c t * (∫ q : (E3 × E3) × E3,
          ModelCenterExpandedIntegrand α u F t q
          ∂(((volume : Measure E3).prod volume).prod volume)) := by
            rw [integral_ModelCenterTranslation_eq_ModelCenterExpanded_of_integrable
              α u F t (hApos ht) htint]

/-- This reduces the fiber-to-profile slab identity to one explicit
coordinate-transport equality. The latter only permutes/open variables;
the signed translation and all fiber Fubini steps are discharged above. -/
theorem truncationFiber_centerFubini_of_fullyExpandedTransport
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (A : Set ℝ) (hA : MeasurableSet A) (hApos : A ⊆ Set.Ioi (0 : ℝ))
    (hfull : Integrable
      (modelFiberFullyExpandedIntegrand α u c (InitialModelRealInput F))
      (((cubeScaleMeasure.restrict (Set.univ ×ˢ A)).prod
        (volume : Measure ModelE5)).prod ((volume : Measure ℝ).prod volume)))
    (hraw : ∀ᵐ t ∂((volume : Measure ℝ).withDensity cubeScaleDensity).restrict A,
      Integrable (ModelCenterTranslationIntegrand α u F t)
        ((((volume : Measure E3).prod volume).prod volume).prod volume))
    (htransport :
      (∫ q : ((E3 × ℝ) × ModelE5) × (ℝ × ℝ),
        modelFiberFullyExpandedIntegrand α u c
          (InitialModelRealInput F) q
        ∂(((cubeScaleMeasure.restrict (Set.univ ×ˢ A)).prod
          (volume : Measure ModelE5)).prod ((volume : Measure ℝ).prod volume))) =
        ∫ t in A,
          ∫ q : ((E3 × E3) × E3) × ℝ,
            c t * ModelCenterTranslationIntegrand α u F t q
            ∂((((volume : Measure E3).prod volume).prod volume).prod volume)
          ∂((volume : Measure ℝ).withDensity cubeScaleDensity)) :
    (∫ pt in Set.univ ×ˢ A,
      truncationFiberIntegrand α u c (InitialModelRealInput F) pt
        ∂cubeScaleMeasure) =
      ∫ t in A, c t *
        (∫ q : (E3 × E3) × E3,
          ModelCenterExpandedIntegrand α u F t q
          ∂(((volume : Measure E3).prod volume).prod volume))
        ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
  calc
    (∫ pt in Set.univ ×ˢ A,
      truncationFiberIntegrand α u c (InitialModelRealInput F) pt
        ∂cubeScaleMeasure) =
        ∫ q : ((E3 × ℝ) × ModelE5) × (ℝ × ℝ),
          modelFiberFullyExpandedIntegrand α u c
            (InitialModelRealInput F) q
          ∂(((cubeScaleMeasure.restrict (Set.univ ×ˢ A)).prod
            (volume : Measure ModelE5)).prod ((volume : Measure ℝ).prod volume)) :=
      integral_truncationFiberIntegrand_eq_fullyExpanded_of_integrable
        α u c (InitialModelRealInput F) (Set.univ ×ˢ A) hfull
    _ = ∫ t in A,
        ∫ q : ((E3 × E3) × E3) × ℝ,
          c t * ModelCenterTranslationIntegrand α u F t q
          ∂((((volume : Measure E3).prod volume).prod volume).prod volume)
        ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := htransport
    _ = ∫ t in A, c t *
        (∫ q : (E3 × E3) × E3,
          ModelCenterExpandedIntegrand α u F t q
          ∂(((volume : Measure E3).prod volume).prod volume))
        ∂((volume : Measure ℝ).withDensity cubeScaleDensity) :=
      integral_centerTranslationScale_eq_centerExpandedScale
        α u c F A hA hApos hraw

/-- The same full product-space hypothesis also gives integrability of the
unopened outer fiber integrand on its center--scale slab. -/
theorem integrableOn_truncationFiberIntegrand_of_fullyExpanded
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (V : Set (E3 × ℝ))
    (hjoint : Integrable (modelFiberFullyExpandedIntegrand α u c f)
      (((cubeScaleMeasure.restrict V).prod (volume : Measure ModelE5)).prod
        ((volume : Measure ℝ).prod volume))) :
    IntegrableOn (truncationFiberIntegrand α u c f) V cubeScaleMeasure := by
  let : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  let μ : Measure (E3 × ℝ) := cubeScaleMeasure.restrict V
  let : SFinite μ := by
    dsimp only [μ]
    infer_instance
  let G : ((E3 × ℝ) × ModelE5) × (ℝ × ℝ) → ℝ :=
    modelFiberFullyExpandedIntegrand α u c f
  have hG : Integrable G
      ((μ.prod (volume : Measure ModelE5)).prod
        ((volume : Measure ℝ).prod volume)) := by
    simpa only [G, μ] using hjoint
  have hinner : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      ∫ vw : ℝ × ℝ, G (q, vw))
      (μ.prod (volume : Measure ModelE5)) :=
    hG.integral_prod_left
  have houter : Integrable (fun pt : E3 × ℝ ↦
      ∫ z : ModelE5, ∫ vw : ℝ × ℝ,
        G ((pt, z), vw) ∂((volume : Measure ℝ).prod volume)) μ := by
    exact hinner.integral_prod_left
  change Integrable (truncationFiberIntegrand α u c f) μ
  apply houter.congr
  filter_upwards [] with pt
  unfold truncationFiberIntegrand
  rw [← MeasureTheory.integral_const_mul]
  apply integral_congr_ae
  filter_upwards [] with z
  exact integral_modelFiberFullyExpanded_inner α u c f pt z

/-- Full opened-integrand integrability on a positive scale band discharges
the cutoff outer-fiber hypothesis in the first two-index limit. -/
theorem integrableOn_truncationFiberIntegrand_restrictScale_of_fullyExpanded
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (A : Set ℝ) (hA : MeasurableSet A) (hApos : A ⊆ Set.Ioi (0 : ℝ))
    (hjoint : Integrable (modelFiberFullyExpandedIntegrand α u c f)
      (((cubeScaleMeasure.restrict (Set.univ ×ˢ A)).prod
        (volume : Measure ModelE5)).prod ((volume : Measure ℝ).prod volume))) :
    IntegrableOn
      (truncationFiberIntegrand α u (RestrictScaleCoefficient c A) f)
      (Set.univ ×ˢ Set.Ioi (0 : ℝ)) cubeScaleMeasure := by
  let V : Set (E3 × ℝ) := Set.univ ×ˢ A
  let P : Set (E3 × ℝ) := Set.univ ×ˢ Set.Ioi (0 : ℝ)
  let g : E3 × ℝ → ℝ := truncationFiberIntegrand α u c f
  have hV : MeasurableSet V := MeasurableSet.univ.prod hA
  have hVP : V ⊆ P := by
    rintro ⟨p, t⟩ ht
    exact ⟨Set.mem_univ _, hApos ht.2⟩
  have hraw : IntegrableOn g V cubeScaleMeasure := by
    simpa only [V, g] using
      integrableOn_truncationFiberIntegrand_of_fullyExpanded
        α u c f (Set.univ ×ˢ A) hjoint
  have hcut : truncationFiberIntegrand α u
      (RestrictScaleCoefficient c A) f = V.indicator g := by
    funext pt
    rcases pt with ⟨p, t⟩
    by_cases ht : t ∈ A
    · simp [truncationFiberIntegrand, RestrictScaleCoefficient, V, g, ht]
    · simp [truncationFiberIntegrand, RestrictScaleCoefficient, V, g, ht]
  rw [hcut, integrableOn_indicator_iff hV]
  change IntegrableOn g (V ∩ P) cubeScaleMeasure
  rw [Set.inter_eq_left.mpr hVP]
  exact hraw

/-- The only nonformal Fubini input in the fixed-scale localization is the
identification of the fully opened fiber slab with the center-expanded
integral. Once it is available, the already proved signed center identity
gives the literal finite scale truncation, with the sign fixed. -/
theorem neg_integral_truncationFiberIntegrand_eq_ModelScaleTruncation_of_centerFubini
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (A : Set ℝ) (hA : MeasurableSet A) (hApos : A ⊆ Set.Ioi (0 : ℝ))
    (hcenterFubini :
      (∫ pt in Set.univ ×ˢ A,
        truncationFiberIntegrand α u c (InitialModelRealInput F) pt
          ∂cubeScaleMeasure) =
        ∫ t in A, c t *
          (∫ q : (E3 × E3) × E3,
            ModelCenterExpandedIntegrand α u F t q
            ∂(((volume : Measure E3).prod volume).prod volume))
          ∂((volume : Measure ℝ).withDensity cubeScaleDensity)) :
    -(∫ pt in Set.univ ×ˢ A,
      truncationFiberIntegrand α u c (InitialModelRealInput F) pt
        ∂cubeScaleMeasure) =
      ∫ t in A, c t * ModelSpatialProfile α u F t
        ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
  rw [hcenterFubini]
  have hrewrite : (fun t : ℝ ↦ c t *
      (∫ q : (E3 × E3) × E3,
        ModelCenterExpandedIntegrand α u F t q
        ∂(((volume : Measure E3).prod volume).prod volume))) =ᵐ[
      ((volume : Measure ℝ).withDensity cubeScaleDensity).restrict A]
      fun t ↦ c t * (-ModelSpatialProfile α u F t) := by
    filter_upwards [ae_restrict_mem hA] with t ht
    have hneg := neg_integral_ModelCenterExpanded_eq_ModelSpatialProfile
      α u F t (hApos ht)
    have hcenter :
        (∫ q : (E3 × E3) × E3,
          ModelCenterExpandedIntegrand α u F t q
          ∂(((volume : Measure E3).prod volume).prod volume)) =
          -ModelSpatialProfile α u F t := by
      have h := congrArg Neg.neg hneg
      simpa using h
    rw [hcenter]
  rw [integral_congr_ae hrewrite]
  rw [show (fun t : ℝ ↦ c t * -ModelSpatialProfile α u F t) =
      fun t ↦ -(c t * ModelSpatialProfile α u F t) by
        funext t
        ring,
    MeasureTheory.integral_neg]
  ring

/-- The preceding Fubini bridge specializes to the exact dyadic scale band
used by the source truncations. -/
theorem neg_integral_truncationFiberIntegrand_eq_ModelScaleTruncation
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput) (N : ℕ)
    (hcenterFubini :
      (∫ pt in Set.univ ×ˢ truncationScaleSet N,
        truncationFiberIntegrand α u c (InitialModelRealInput F) pt
          ∂cubeScaleMeasure) =
        ∫ t in truncationScaleSet N, c t *
          (∫ q : (E3 × E3) × E3,
            ModelCenterExpandedIntegrand α u F t q
            ∂(((volume : Measure E3).prod volume).prod volume))
          ∂((volume : Measure ℝ).withDensity cubeScaleDensity)) :
    -(∫ pt in Set.univ ×ˢ truncationScaleSet N,
      truncationFiberIntegrand α u c (InitialModelRealInput F) pt
        ∂cubeScaleMeasure) = ModelScaleTruncation α u c F N := by
  simpa only [ModelScaleTruncation] using
    neg_integral_truncationFiberIntegrand_eq_ModelScaleTruncation_of_centerFubini
      α u c F (truncationScaleSet N) measurableSet_Ioc
      (truncationScaleSet_subset_positive N) hcenterFubini

/-- The source-faithful two-index localization statement. The scale band
is held fixed while the finite collections exhaust spatial centers. -/
theorem tendsto_expandedModelLocalForm_twoIndex_localization
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput) (N : ℕ)
    (hglobal : IntegrableOn
      (truncationFiberIntegrand α u
        (RestrictScaleCoefficient c (truncationScaleSet N))
        (InitialModelRealInput F))
      (Set.univ ×ˢ Set.Ioi (0 : ℝ)) cubeScaleMeasure)
    (hcenterFubini :
      (∫ pt in Set.univ ×ˢ truncationScaleSet N,
        truncationFiberIntegrand α u c (InitialModelRealInput F) pt
          ∂cubeScaleMeasure) =
        ∫ t in truncationScaleSet N, c t *
          (∫ q : (E3 × E3) × E3,
            ModelCenterExpandedIntegrand α u F t q
            ∂(((volume : Measure E3).prod volume).prod volume))
          ∂((volume : Measure ℝ).withDensity cubeScaleDensity)) :
    Tendsto (fun M ↦ expandedModelLocalForm α (truncationCollection α M) u
      (RestrictScaleCoefficient c (truncationScaleSet N))
      (InitialModelRealInput F)) atTop
      (𝓝 (ModelScaleTruncation α u c F N)) := by
  have hlim := tendsto_expandedModelLocalForm_centerExhaustion_truncationScale
    α u c (InitialModelRealInput F) N hglobal
  rw [neg_integral_truncationFiberIntegrand_eq_ModelScaleTruncation
    α u c F N hcenterFubini] at hlim
  exact hlim

/-- In the two-index localization limit, the cutoff outer-fiber
integrability hypothesis follows from absolute integrability of the fully
opened product-space integrand on the same fixed scale band. -/
theorem tendsto_expandedModelLocalForm_twoIndex_of_fullyExpanded
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput) (N : ℕ)
    (hfull : Integrable
      (modelFiberFullyExpandedIntegrand α u c (InitialModelRealInput F))
      (((cubeScaleMeasure.restrict
        (Set.univ ×ˢ truncationScaleSet N)).prod
          (volume : Measure ModelE5)).prod
        ((volume : Measure ℝ).prod volume)))
    (hcenterFubini :
      (∫ pt in Set.univ ×ˢ truncationScaleSet N,
        truncationFiberIntegrand α u c (InitialModelRealInput F) pt
          ∂cubeScaleMeasure) =
        ∫ t in truncationScaleSet N, c t *
          (∫ q : (E3 × E3) × E3,
            ModelCenterExpandedIntegrand α u F t q
            ∂(((volume : Measure E3).prod volume).prod volume))
          ∂((volume : Measure ℝ).withDensity cubeScaleDensity)) :
    Tendsto (fun M ↦ expandedModelLocalForm α (truncationCollection α M) u
      (RestrictScaleCoefficient c (truncationScaleSet N))
      (InitialModelRealInput F)) atTop
      (𝓝 (ModelScaleTruncation α u c F N)) := by
  apply tendsto_expandedModelLocalForm_twoIndex_localization
    α u c F N
  · exact
      integrableOn_truncationFiberIntegrand_restrictScale_of_fullyExpanded
        α u c (InitialModelRealInput F) (truncationScaleSet N)
          measurableSet_Ioc (truncationScaleSet_subset_positive N) hfull
  · exact hcenterFubini

/-- A uniform bound on the finite center exhaustions transfers to the fixed
scale truncation along the two-index localization limit. -/
theorem modelScaleTruncation_bound_of_twoIndex_localization
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (B : ℝ) (N : ℕ)
    (hlocalization : Tendsto
      (fun M ↦ expandedModelLocalForm α (truncationCollection α M) u
        (RestrictScaleCoefficient c (truncationScaleSet N))
        (InitialModelRealInput F))
      atTop (𝓝 (ModelScaleTruncation α u c F N)))
    (hforest : ∀ M : ℕ,
      |expandedModelLocalForm α (truncationCollection α M) u
        (RestrictScaleCoefficient c (truncationScaleSet N))
        (InitialModelRealInput F)| ≤ B) :
    |ModelScaleTruncation α u c F N| ≤ B := by
  have hlimabs : Tendsto
      (fun M ↦ |expandedModelLocalForm α (truncationCollection α M) u
        (RestrictScaleCoefficient c (truncationScaleSet N))
        (InitialModelRealInput F)|)
      atTop (𝓝 |ModelScaleTruncation α u c F N|) := by
    exact (continuous_abs.tendsto _).comp hlocalization
  apply le_of_tendsto hlimabs
  exact Filter.Eventually.of_forall hforest

/-- The complete source-faithful two-index consumer for real Schwartz data.
The only analytic localization hypotheses left explicit are the cutoff
fiber-integrability and the Fubini identity which opens the two fiber
integrals and integrates their three centers. -/
theorem modelFullForm_bound_of_twoIndex_localization_and_uniformForest
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (B : ℝ) (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hglobal : ∀ N : ℕ, IntegrableOn
      (truncationFiberIntegrand α u
        (RestrictScaleCoefficient c (truncationScaleSet N))
        (InitialModelRealInput F))
      (Set.univ ×ˢ Set.Ioi (0 : ℝ)) cubeScaleMeasure)
    (hcenterFubini : ∀ N : ℕ,
      (∫ pt in Set.univ ×ˢ truncationScaleSet N,
        truncationFiberIntegrand α u c (InitialModelRealInput F) pt
          ∂cubeScaleMeasure) =
        ∫ t in truncationScaleSet N, c t *
          (∫ q : (E3 × E3) × E3,
            ModelCenterExpandedIntegrand α u F t q
            ∂(((volume : Measure E3).prod volume).prod volume))
          ∂((volume : Measure ℝ).withDensity cubeScaleDensity))
    (hforest : ∀ (d : ℝ → ℝ), (∀ t : ℝ, |d t| ≤ 1) → ∀ M : ℕ,
      |expandedModelLocalForm α (truncationCollection α M) u d
        (InitialModelRealInput F)| ≤ B) :
    |ModelFullForm α u c F| ≤ B := by
  have hscale := tendsto_ModelScaleTruncation_of_realSchwartz
    α u c F hcmeas hc
  have hscaleAbs : Tendsto (fun N ↦ |ModelScaleTruncation α u c F N|)
      atTop (𝓝 |ModelFullForm α u c F|) := by
    exact (continuous_abs.tendsto _).comp hscale
  apply le_of_tendsto hscaleAbs
  filter_upwards [] with N
  apply modelScaleTruncation_bound_of_twoIndex_localization
    α u c F B N
  · exact tendsto_expandedModelLocalForm_twoIndex_localization
      α u c F N (hglobal N) (hcenterFubini N)
  · exact hforest (RestrictScaleCoefficient c (truncationScaleSet N))
      (abs_restrictScaleCoefficient_le_one c (truncationScaleSet N) hc)

/-- A version of the two-index consumer whose first localization premise is
already reduced to a literal full product-space integrability assertion. -/
theorem modelFullForm_bound_of_twoIndex_fullyExpanded_and_uniformForest
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (B : ℝ) (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hfull : ∀ N : ℕ, Integrable
      (modelFiberFullyExpandedIntegrand α u c (InitialModelRealInput F))
      (((cubeScaleMeasure.restrict
        (Set.univ ×ˢ truncationScaleSet N)).prod
          (volume : Measure ModelE5)).prod
        ((volume : Measure ℝ).prod volume)))
    (hcenterFubini : ∀ N : ℕ,
      (∫ pt in Set.univ ×ˢ truncationScaleSet N,
        truncationFiberIntegrand α u c (InitialModelRealInput F) pt
          ∂cubeScaleMeasure) =
        ∫ t in truncationScaleSet N, c t *
          (∫ q : (E3 × E3) × E3,
            ModelCenterExpandedIntegrand α u F t q
            ∂(((volume : Measure E3).prod volume).prod volume))
          ∂((volume : Measure ℝ).withDensity cubeScaleDensity))
    (hforest : ∀ (d : ℝ → ℝ), (∀ t : ℝ, |d t| ≤ 1) → ∀ M : ℕ,
      |expandedModelLocalForm α (truncationCollection α M) u d
        (InitialModelRealInput F)| ≤ B) :
    |ModelFullForm α u c F| ≤ B := by
  apply modelFullForm_bound_of_twoIndex_localization_and_uniformForest
    α u c F B hcmeas hc
  · intro N
    exact
      integrableOn_truncationFiberIntegrand_restrictScale_of_fullyExpanded
        α u c (InitialModelRealInput F) (truncationScaleSet N)
          measurableSet_Ioc (truncationScaleSet_subset_positive N) (hfull N)
  · exact hcenterFubini
  · exact hforest

/-- First expose the five passive model coordinates and then move the two
active fiber variables next to them. This is the measure-theoretic core of
the remaining center-translation transport. -/
noncomputable def modelFiberPassiveActiveReorder :
    ((E3 × ℝ) × ModelE5) × (ℝ × ℝ) ≃ᵐ
      (((E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2)) ×
