/-- The passive four-Gaussian factor is measurable when center, tree scale,
fiber variables, and source scale vary jointly. -/
theorem measurable_modelFirstPassiveGaussianWeight_lift
    (α : Anisotropy) :
    Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      modelFirstPassiveGaussianWeight α q.2.2 q.1.1 q.1.2
        (q.2.1 0) (q.2.1 1) (q.2.1 2) (q.2.1 3)) := by
  have ht (i : Fin 3) : Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      q.1.2 ^ α.weight i) :=
    (measurable_snd.comp measurable_fst).pow_const _
  have hp (i : Fin 3) : Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      q.1.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp
      (measurable_fst.comp measurable_fst)
  have hz (i : Fin 5) : Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      q.2.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 5 ↦ ℝ) i).measurable.comp
      (measurable_fst.comp measurable_snd)
  have hlam : Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦ q.2.2) :=
    measurable_snd.comp measurable_snd
  have hs0 : Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      q.2.2 * q.1.2 ^ α.weight 0) := hlam.mul (ht 0)
  have hs1 : Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      q.2.2 * q.1.2 ^ α.weight 1) := hlam.mul (ht 1)
  have hg0x : Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      gaussianAt (q.2.2 * q.1.2 ^ α.weight 0) (q.1.1 0) (q.2.1 0)) := by
    unfold gaussianAt
    exact measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable
      _ _ _ hs0 (hp 0) (hz 0)
  have hg0y : Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      gaussianAt (q.2.2 * q.1.2 ^ α.weight 0) (q.1.1 0) (q.2.1 2)) := by
    unfold gaussianAt
    exact measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable
      _ _ _ hs0 (hp 0) (hz 2)
  have hg1x : Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      gaussianAt (q.2.2 * q.1.2 ^ α.weight 1) (q.1.1 1) (q.2.1 1)) := by
    unfold gaussianAt
    exact measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable
      _ _ _ hs1 (hp 1) (hz 1)
  have hg1y : Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      gaussianAt (q.2.2 * q.1.2 ^ α.weight 1) (q.1.1 1) (q.2.1 3)) := by
    unfold gaussianAt
    exact measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable
      _ _ _ hs1 (hp 1) (hz 3)
  change Measurable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
    (gaussianAt (q.2.2 * q.1.2 ^ α.weight 0) (q.1.1 0) (q.2.1 0) *
      gaussianAt (q.2.2 * q.1.2 ^ α.weight 0) (q.1.1 0) (q.2.1 2)) *
    (gaussianAt (q.2.2 * q.1.2 ^ α.weight 1) (q.1.1 1) (q.2.1 1) *
      gaussianAt (q.2.2 * q.1.2 ^ α.weight 1) (q.1.1 1) (q.2.1 3)))
  exact (hg0x.mul hg0y).mul (hg1x.mul hg1y)

/-- The five independent factors in a passive Gaussian kernel, with an
arbitrary integrable final translation weight. -/
noncomputable def modelPassiveFactor
    (α : Anisotropy) (lam : ℝ) (p : E3) (t : ℝ) (g : ℝ → ℝ)
    (i : Fin 5) (x : ℝ) : ℝ :=
  match i.1 with
  | 0 => gaussianAt (lam * t ^ α.weight 0) (p 0) x
  | 1 => gaussianAt (lam * t ^ α.weight 1) (p 1) x
  | 2 => gaussianAt (lam * t ^ α.weight 0) (p 0) x
  | 3 => gaussianAt (lam * t ^ α.weight 1) (p 1) x
  | _ => g x

/-- Product version of `modelPassiveFactor` on the literal five
model-variable space. -/
noncomputable def modelPassiveKernel
    (α : Anisotropy) (lam : ℝ) (p : E3) (t : ℝ) (g : ℝ → ℝ)
    (z : ModelE5) : ℝ :=
  ∏ i : Fin 5, modelPassiveFactor α lam p t g i (z i)

/-- The literal first-energy passive weight times a fifth-coordinate factor
is the generic five-factor product. -/
theorem modelPassiveKernel_eq
    (α : Anisotropy) (lam : ℝ) (p : E3) (t : ℝ) (g : ℝ → ℝ)
    (z : ModelE5) :
    modelPassiveKernel α lam p t g z =
      modelFirstPassiveGaussianWeight α lam p t
        (z 0) (z 1) (z 2) (z 3) * g (z 4) := by
  simp only [modelPassiveKernel, Fin.prod_univ_succ,
    ]
  simp [modelPassiveFactor, modelFirstPassiveGaussianWeight]
  ring

/-- Each scalar factor of the generic passive kernel is integrable at a
positive tree and source scale. -/
theorem integrable_modelPassiveFactor
    (α : Anisotropy) (lam : ℝ) (p : E3) (t : ℝ) (g : ℝ → ℝ)
    (hg : Integrable g) (hlam : 0 < lam) (ht : 0 < t)
    (i : Fin 5) :
    Integrable (modelPassiveFactor α lam p t g i) := by
  have hs0 : 0 < lam * t ^ α.weight 0 :=
    mul_pos hlam (pow_pos ht _)
  have hs1 : 0 < lam * t ^ α.weight 1 :=
    mul_pos hlam (pow_pos ht _)
  fin_cases i
  · change Integrable (gaussianAt (lam * t ^ α.weight 0) (p 0))
    exact integrable_gaussianAt hs0 _
  · change Integrable (gaussianAt (lam * t ^ α.weight 1) (p 1))
    exact integrable_gaussianAt hs1 _
  · change Integrable (gaussianAt (lam * t ^ α.weight 0) (p 0))
    exact integrable_gaussianAt hs0 _
  · change Integrable (gaussianAt (lam * t ^ α.weight 1) (p 1))
    exact integrable_gaussianAt hs1 _
  · change Integrable g
    exact hg

/-- At fixed positive parameters, the passive kernel is integrable over all
five model variables. -/
theorem integrable_modelPassiveKernel
    (α : Anisotropy) (lam : ℝ) (p : E3) (t : ℝ) (g : ℝ → ℝ)
    (hg : Integrable g) (hlam : 0 < lam) (ht : 0 < t) :
    Integrable (modelPassiveKernel α lam p t g) := by
  rw [← (PiLp.volume_preserving_toLp (Fin 5)).integrable_comp_emb
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  have hfactor : (modelPassiveKernel α lam p t g ∘ WithLp.toLp 2) =
      (fun x : Fin 5 → ℝ ↦
        ∏ i : Fin 5, modelPassiveFactor α lam p t g i (x i)) := by
    funext x
    change modelPassiveKernel α lam p t g (WithLp.toLp 2 x) = _
    rfl
  rw [hfactor]
  exact Integrable.fintype_prod fun i ↦
    integrable_modelPassiveFactor α lam p t g hg hlam ht i

/-- The fixed-parameter passive mass is precisely the mass of its remaining
one-dimensional factor. -/
theorem integral_modelPassiveKernel
    (α : Anisotropy) (lam : ℝ) (p : E3) (t : ℝ) (g : ℝ → ℝ)
    (_hg : Integrable g) (hlam : 0 < lam) (ht : 0 < t) :
    ∫ z : ModelE5, modelPassiveKernel α lam p t g z =
      ∫ r : ℝ, g r := by
  have hs0 : 0 < lam * t ^ α.weight 0 :=
    mul_pos hlam (pow_pos ht _)
  have hs1 : 0 < lam * t ^ α.weight 1 :=
    mul_pos hlam (pow_pos ht _)
  have h0 : ∫ x : ℝ, modelPassiveFactor α lam p t g 0 x = 1 := by
    change ∫ x : ℝ, gaussianAt (lam * t ^ α.weight 0) (p 0) x = 1
    exact integral_gaussianAt hs0 _
  have h1 : ∫ x : ℝ, modelPassiveFactor α lam p t g 1 x = 1 := by
    change ∫ x : ℝ, gaussianAt (lam * t ^ α.weight 1) (p 1) x = 1
    exact integral_gaussianAt hs1 _
  have h2 : ∫ x : ℝ, modelPassiveFactor α lam p t g 2 x = 1 := by
    change ∫ x : ℝ, gaussianAt (lam * t ^ α.weight 0) (p 0) x = 1
    exact integral_gaussianAt hs0 _
  have h3 : ∫ x : ℝ, modelPassiveFactor α lam p t g 3 x = 1 := by
    change ∫ x : ℝ, gaussianAt (lam * t ^ α.weight 1) (p 1) x = 1
    exact integral_gaussianAt hs1 _
  have h4 : ∫ x : ℝ, modelPassiveFactor α lam p t g 4 x =
      ∫ r : ℝ, g r := by
    simp only [modelPassiveFactor]
  rw [← (PiLp.volume_preserving_toLp (Fin 5)).integral_comp
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  have hfactor : (modelPassiveKernel α lam p t g ∘ WithLp.toLp 2) =
      (fun x : Fin 5 → ℝ ↦
        ∏ i : Fin 5, modelPassiveFactor α lam p t g i (x i)) := by
    funext x
    change modelPassiveKernel α lam p t g (WithLp.toLp 2 x) = _
    rfl
  change (∫ x : Fin 5 → ℝ,
    (modelPassiveKernel α lam p t g ∘ WithLp.toLp 2) x) = _
  rw [hfactor, integral_fintype_prod_volume_eq_prod]
  have hfac (i : Fin 5) :
      ∫ x : ℝ, modelPassiveFactor α lam p t g i x =
        match i.1 with
        | 0 => 1
        | 1 => 1
        | 2 => 1
        | 3 => 1
        | _ => ∫ r : ℝ, g r := by
    fin_cases i
    · exact h0
    · exact h1
    · exact h2
    · exact h3
    · exact h4
  simp_rw [hfac]
  simp only [Fin.prod_univ_succ]
  norm_num

/-- Positivity of the passive product follows from positivity of its final
translation factor on the source-scale range. -/
theorem modelPassiveKernel_nonneg
    (α : Anisotropy) (lam : ℝ) (p : E3) (t : ℝ) (g : ℝ → ℝ)
    (hgnonneg : ∀ r, 0 ≤ g r) (hlam : 1 ≤ lam) (ht : 0 < t)
    (z : ModelE5) :
    0 ≤ modelPassiveKernel α lam p t g z := by
  rw [modelPassiveKernel_eq]
  exact mul_nonneg
    (modelFirstPassiveGaussianWeight_nonneg α lam p t
      (z 0) (z 1) (z 2) (z 3) hlam ht)
    (hgnonneg (z 4))

/-- The norm mass of a nonnegative passive kernel is its final scalar mass. -/
theorem integral_norm_modelPassiveKernel
    (α : Anisotropy) (lam : ℝ) (p : E3) (t : ℝ) (g : ℝ → ℝ)
    (hg : Integrable g) (hgnonneg : ∀ r, 0 ≤ g r)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    ∫ z : ModelE5, ‖modelPassiveKernel α lam p t g z‖ =
      ∫ r : ℝ, g r := by
  have hpos : ∀ z : ModelE5, 0 ≤ modelPassiveKernel α lam p t g z :=
    fun z ↦ modelPassiveKernel_nonneg α lam p t g hgnonneg hlam ht z
  calc
    ∫ z : ModelE5, ‖modelPassiveKernel α lam p t g z‖ =
        ∫ z : ModelE5, modelPassiveKernel α lam p t g z := by
      apply integral_congr_ae
      filter_upwards [] with z
      rw [Real.norm_eq_abs, abs_of_nonneg (hpos z)]
    _ = ∫ r : ℝ, g r :=
      integral_modelPassiveKernel α lam p t g hg
        (lt_of_lt_of_le zero_lt_one hlam) ht

/-- At one source scale, a generic passive kernel is integrable jointly over
a finite box collection and all five model variables. -/
theorem integrable_modelPassiveKernel_collection_at_scale
    (α : Anisotropy) (S : BoxCollection α) (lam : ℝ) (g : ℝ → ℝ)
    (hgmeas : Measurable g) (hg : Integrable g) (hgnonneg : ∀ r, 0 ≤ g r)
    (hlam : 1 ≤ lam) :
    Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelPassiveKernel α lam q.1.1 q.1.2 g q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume) := by
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let : IsFiniteMeasure μ := by
    dsimp only [μ]
    exact isFiniteMeasure_cubeScaleCollection α S
  have hpos : ∀ᵐ pt ∂μ, 0 < pt.2 := by
    dsimp only [μ]
    filter_upwards [ae_restrict_mem (measurableSet_collectionRegion α S)]
      with pt hpt
    exact pos_of_mem_collectionRegion α S hpt
  have hparam : Measurable (fun q : (E3 × ℝ) × ModelE5 ↦
      (q.1, (q.2, lam))) :=
    measurable_fst.prodMk (measurable_snd.prodMk measurable_const)
  have hpassive : Measurable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelFirstPassiveGaussianWeight α lam q.1.1 q.1.2
        (q.2 0) (q.2 1) (q.2 2) (q.2 3)) := by
    convert (measurable_modelFirstPassiveGaussianWeight_lift α).comp hparam using 1
    funext q
    rfl
  have hz4 : Measurable (fun q : (E3 × ℝ) × ModelE5 ↦ q.2 4) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 5 ↦ ℝ) 4).measurable.comp
      measurable_snd
  have hmeas : AEStronglyMeasurable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelPassiveKernel α lam q.1.1 q.1.2 g q.2) (μ.prod volume) := by
    rw [show (fun q : (E3 × ℝ) × ModelE5 ↦
        modelPassiveKernel α lam q.1.1 q.1.2 g q.2) =
        (fun q ↦ modelFirstPassiveGaussianWeight α lam q.1.1 q.1.2
          (q.2 0) (q.2 1) (q.2 2) (q.2 3) * g (q.2 4)) by
      funext q
      exact modelPassiveKernel_eq α lam q.1.1 q.1.2 g q.2]
    exact (hpassive.mul (hgmeas.comp hz4)).aestronglyMeasurable
  apply (MeasureTheory.integrable_prod_iff hmeas).mpr
  constructor
  · filter_upwards [hpos] with pt hpt
    exact integrable_modelPassiveKernel α lam pt.1 pt.2 g hg
      (lt_of_lt_of_le zero_lt_one hlam) hpt
  · have hconst : Integrable (fun _ : E3 × ℝ ↦ ∫ r : ℝ, g r) μ :=
      integrable_const _
    refine hconst.congr ?_
    filter_upwards [hpos] with pt hpt
    symm
    exact integral_norm_modelPassiveKernel α lam pt.1 pt.2 g hg
      hgnonneg hlam hpt

/-- A globally measurable representative of the negative source-scale power
which agrees with it on the source range. -/
theorem measurable_safeScaleWeight_negFortySeven :
    Measurable (fun lam : ℝ ↦ (max lam 1) ^ (-47 : ℝ)) := by
  exact ((continuous_id.max continuous_const).rpow_const (fun lam ↦
    Or.inl (ne_of_gt (lt_of_lt_of_le zero_lt_one (le_max_right _ _))))).measurable

/-- The negative source-scale power is a.e.-strongly measurable on its
literal restricted source-scale measure. -/
theorem aestronglyMeasurable_scaleWeight_negFortySeven :
    AEStronglyMeasurable (fun lam : ℝ ↦ lam ^ (-47 : ℝ))
      ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))) := by
  refine measurable_safeScaleWeight_negFortySeven.aestronglyMeasurable.congr ?_
  filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
  rw [max_eq_left hlam]

/-- A finite collection makes the passive Gaussian superposition integrable
jointly in its center--scale variables, the five passive variables, and the
source scale. -/
theorem integrable_modelPassiveKernel_collection_sourceScale
    (α : Anisotropy) (S : BoxCollection α) (g : ℝ → ℝ)
    (hgmeas : Measurable g) (hg : Integrable g) (hgnonneg : ∀ r, 0 ≤ g r) :
    Integrable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
        q.2.2 ^ (-47 : ℝ))
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        ((volume : Measure ModelE5).prod
          ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))))) := by
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let e := outerLambdaShuffleRight (E3 × ℝ) ModelE5
  let : IsFiniteMeasure μ := by
    dsimp only [μ]
    exact isFiniteMeasure_cubeScaleCollection α S
  let : SigmaFinite μ := IsFiniteMeasure.toSigmaFinite μ
  let : SFinite (μ.prod (volume : Measure ModelE5)) := by
    infer_instance
  have hpos : ∀ᵐ pt ∂μ, 0 < pt.2 := by
    dsimp only [μ]
    filter_upwards [ae_restrict_mem (measurableSet_collectionRegion α S)]
      with pt hpt
    exact pos_of_mem_collectionRegion α S hpt
  have hmp : MeasurePreserving e
      (μ.prod ((volume : Measure ModelE5).prod ν))
      (ν.prod (μ.prod (volume : Measure ModelE5))) := by
    simpa only [e] using outerLambdaShuffleRight_measurePreserving
      μ (volume : Measure ModelE5)
  let H : ℝ × ((E3 × ℝ) × ModelE5) → ℝ := fun q ↦
    modelPassiveKernel α q.1 q.2.1.1 q.2.1.2 g q.2.2 *
      q.1 ^ (-47 : ℝ)
  have hparam : Measurable (fun q : ℝ × ((E3 × ℝ) × ModelE5) ↦
      (q.2.1, (q.2.2, q.1))) :=
    (measurable_fst.comp measurable_snd).prodMk
      ((measurable_snd.comp measurable_snd).prodMk measurable_fst)
  have hpassive : Measurable (fun q : ℝ × ((E3 × ℝ) × ModelE5) ↦
      modelFirstPassiveGaussianWeight α q.1 q.2.1.1 q.2.1.2
        (q.2.2 0) (q.2.2 1) (q.2.2 2) (q.2.2 3)) := by
    convert (measurable_modelFirstPassiveGaussianWeight_lift α).comp
      hparam using 1
    funext q
    rfl
  have hz4 : Measurable (fun q : ℝ × ((E3 × ℝ) × ModelE5) ↦ q.2.2 4) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 5 ↦ ℝ) 4).measurable.comp
      (measurable_snd.comp measurable_snd)
  have hsafe : Measurable (fun q : ℝ × ((E3 × ℝ) × ModelE5) ↦
      modelFirstPassiveGaussianWeight α q.1 q.2.1.1 q.2.1.2
        (q.2.2 0) (q.2.2 1) (q.2.2 2) (q.2.2 3) * g (q.2.2 4) *
          (max q.1 1) ^ (-47 : ℝ)) :=
    (hpassive.mul (hgmeas.comp hz4)).mul
      (measurable_safeScaleWeight_negFortySeven.comp measurable_fst)
  have hsourceRange : ∀ᵐ q ∂(ν.prod (μ.prod (volume : Measure ModelE5))),
      q.1 ∈ Set.Ici (1 : ℝ) := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
      exact ae_of_all _ fun _ ↦ hlam
    · exact measurableSet_Ici.preimage measurable_fst
  have hHmeas : AEStronglyMeasurable H
      (ν.prod (μ.prod (volume : Measure ModelE5))) := by
    refine hsafe.aestronglyMeasurable.congr ?_
    filter_upwards [hsourceRange] with q hq
    dsimp only [H]
    rw [modelPassiveKernel_eq, max_eq_left hq]
  have hpowle (lam : ℝ) (hlam : 1 ≤ lam) :
      lam ^ (-47 : ℝ) ≤ lam ^ (-10 : ℝ) := by
    rw [show (-47 : ℝ) = (-10 : ℝ) + (-37 : ℝ) by norm_num,
      Real.rpow_add (lt_of_lt_of_le zero_lt_one hlam)]
    have hsmall : lam ^ (-37 : ℝ) ≤ 1 :=
      Real.rpow_le_one_of_one_le_of_nonpos hlam (by norm_num)
    exact (mul_le_mul_of_nonneg_left hsmall
      (Real.rpow_nonneg (le_trans zero_le_one hlam) _)).trans_eq (by ring)
  let C : ℝ := μ.real Set.univ * ∫ r : ℝ, g r
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg measureReal_nonneg (integral_nonneg hgnonneg)
  have hinner (lam : ℝ) (hlam : 1 ≤ lam) :
      (∫ yz : (E3 × ℝ) × ModelE5, ‖H (lam, yz)‖
        ∂(μ.prod (volume : Measure ModelE5))) =
        lam ^ (-47 : ℝ) * C := by
    have hK := integrable_modelPassiveKernel_collection_at_scale
      α S lam g hgmeas hg hgnonneg hlam
    have hK' : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
        modelPassiveKernel α lam q.1.1 q.1.2 g q.2) (μ.prod volume) := by
      simpa only [μ] using hK
    have hpow : 0 ≤ lam ^ (-47 : ℝ) :=
      Real.rpow_nonneg (le_trans zero_le_one hlam) _
    change (∫ yz : (E3 × ℝ) × ModelE5,
      ‖modelPassiveKernel α lam yz.1.1 yz.1.2 g yz.2 *
        lam ^ (-47 : ℝ)‖ ∂(μ.prod volume)) = _
    calc
      (∫ yz : (E3 × ℝ) × ModelE5,
          ‖modelPassiveKernel α lam yz.1.1 yz.1.2 g yz.2 *
            lam ^ (-47 : ℝ)‖ ∂(μ.prod volume)) =
          ∫ yz : (E3 × ℝ) × ModelE5,
            lam ^ (-47 : ℝ) *
              ‖modelPassiveKernel α lam yz.1.1 yz.1.2 g yz.2‖
            ∂(μ.prod volume) := by
              apply integral_congr_ae
              filter_upwards [] with yz
              rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg hpow,
                Real.norm_eq_abs]
              ring
      _ = lam ^ (-47 : ℝ) *
          ∫ yz : (E3 × ℝ) × ModelE5,
            ‖modelPassiveKernel α lam yz.1.1 yz.1.2 g yz.2‖
            ∂(μ.prod volume) := by
              rw [MeasureTheory.integral_const_mul]
      _ = lam ^ (-47 : ℝ) *
          ∫ pt : E3 × ℝ, ∫ z : ModelE5,
            ‖modelPassiveKernel α lam pt.1 pt.2 g z‖
            ∂volume ∂μ := by
              rw [MeasureTheory.integral_prod _ hK'.norm]
      _ = lam ^ (-47 : ℝ) *
          ∫ pt : E3 × ℝ, ∫ r : ℝ, g r ∂volume ∂μ := by
              congr 1
              apply integral_congr_ae
              filter_upwards [hpos] with pt hpt
              exact integral_norm_modelPassiveKernel α lam pt.1 pt.2 g
                hg hgnonneg hlam hpt
      _ = lam ^ (-47 : ℝ) * C := by
              dsimp only [C]
              rw [MeasureTheory.integral_const]
              simp only [smul_eq_mul]
  have houterMeas : AEStronglyMeasurable
      (fun lam : ℝ ↦ lam ^ (-47 : ℝ) * C) ν := by
    have hsafeouter : Measurable (fun lam : ℝ ↦
        (max lam 1) ^ (-47 : ℝ) * C) :=
      measurable_safeScaleWeight_negFortySeven.mul
        (measurable_const : Measurable (fun _ : ℝ ↦ C))
    refine hsafeouter.aestronglyMeasurable.congr ?_
    filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
    rw [max_eq_left hlam]
  have houter : Integrable (fun lam : ℝ ↦ lam ^ (-47 : ℝ) * C) ν := by
    have hbase : Integrable (fun lam : ℝ ↦ C * lam ^ (-10 : ℝ)) ν := by
      simpa only [ν] using (integrableOn_scaleWeight_negTen.const_mul C)
    apply Integrable.mono' hbase houterMeas
    filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
    have hleft : 0 ≤ lam ^ (-47 : ℝ) * C :=
      mul_nonneg (Real.rpow_nonneg (le_trans zero_le_one hlam) _) hC
    have hright : 0 ≤ C * lam ^ (-10 : ℝ) :=
      mul_nonneg hC (Real.rpow_nonneg (le_trans zero_le_one hlam) _)
    have hineq :
      lam ^ (-47 : ℝ) * C ≤ lam ^ (-10 : ℝ) * C :=
      mul_le_mul_of_nonneg_right (hpowle lam hlam) hC
    have hineq' : lam ^ (-47 : ℝ) * C ≤ C * lam ^ (-10 : ℝ) :=
      hineq.trans_eq (by ring)
    simpa only [Real.norm_eq_abs, abs_of_nonneg hleft, abs_of_nonneg hright]
      using hineq'
  have hH : Integrable H (ν.prod (μ.prod (volume : Measure ModelE5))) := by
    apply (MeasureTheory.integrable_prod_iff hHmeas).mpr
    constructor
    · filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
      have hK := integrable_modelPassiveKernel_collection_at_scale
        α S lam g hgmeas hg hgnonneg hlam
      change Integrable (fun yz : (E3 × ℝ) × ModelE5 ↦
        modelPassiveKernel α lam yz.1.1 yz.1.2 g yz.2 *
          lam ^ (-47 : ℝ)) (μ.prod volume)
      refine (hK.const_mul (lam ^ (-47 : ℝ))).congr ?_
      filter_upwards [] with yz
      ring
    · refine houter.congr ?_
      filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
      symm
      exact hinner lam hlam
  have hback : Integrable (fun q : (E3 × ℝ) × (ModelE5 × ℝ) ↦
      H (e q)) (μ.prod ((volume : Measure ModelE5).prod ν)) :=
    hmp.integrable_comp_of_integrable hH
  refine hback.congr ?_
  filter_upwards [] with q
  rw [outerLambdaShuffleRight_apply]

/-- Bounded continuous data make the full first-energy Gaussian
superposition integrable jointly in the collection variables, passive model
variables, and source scale. -/
theorem integrable_modelFirstSuperpositionJoint_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : ModelRealInput)
    (hfcont : ∀ j, Continuous (f j))
    (hfbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B) :
    Integrable (modelFirstSuperpositionJoint α u f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        ((volume : Measure ModelE5).prod
          ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) ) := by
  rcases hfbound 0 with ⟨B0, hB0, hf0⟩
  rcases hfbound 1 with ⟨B1, hB1, hf1⟩
  rcases hfbound 2 with ⟨B2, hB2, hf2⟩
  let g : ℝ → ℝ := fun r ↦ |conePsiPhysicalReal (r + u 2)|
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let M : ℝ := (B0 * B1 * B2) * ∫ v : ℝ, |gaussianDeriv v|
  have hgmeas : Measurable g := by
    dsimp only [g]
    exact continuous_abs.measurable.comp
      (conePsiPhysicalReal.continuous.measurable.comp
        (measurable_id.add measurable_const))
  have hg : Integrable g := by
    simpa only [g] using
      integrable_abs_conePsiPhysicalReal.comp_add_right (u 2)
  have hgnonneg : ∀ r, 0 ≤ g r := by
    intro r
    exact abs_nonneg _
  have hM : 0 ≤ M := by
    dsimp only [M]
    exact mul_nonneg (mul_nonneg (mul_nonneg hB0 hB1) hB2)
      (integral_nonneg fun v ↦ abs_nonneg (gaussianDeriv v))
  have hkernel := integrable_modelPassiveKernel_collection_sourceScale
    α S g hgmeas hg hgnonneg
  have hscale : ∀ᵐ q ∂(μ.prod ((volume : Measure ModelE5).prod ν)),
      0 < q.1.2 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · dsimp only [μ]
      filter_upwards [ae_restrict_mem (measurableSet_collectionRegion α S)]
        with pt hpt
      exact ae_of_all _ fun _ ↦ pos_of_mem_collectionRegion α S hpt
    · exact measurableSet_Ioi.preimage (measurable_snd.comp measurable_fst)
  have hlambda : ∀ᵐ q ∂(μ.prod ((volume : Measure ModelE5).prod ν)),
      1 ≤ q.2.2 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [] with pt
      rw [Measure.ae_prod_iff_ae_ae]
      · filter_upwards [] with z
        exact ae_restrict_mem measurableSet_Ici
      · exact measurableSet_Ici.preimage measurable_snd
    · exact measurableSet_Ici.preimage (measurable_snd.comp measurable_snd)
  have hmeas : AEStronglyMeasurable (modelFirstSuperpositionJoint α u f)
      (μ.prod ((volume : Measure ModelE5).prod ν)) := by
    have hfiber := aestronglyMeasurable_modelFirstFiber_lift
      α f hfcont (μ.prod ((volume : Measure ModelE5).prod ν))
    refine ((hfiber.pow 2).mul hkernel.aestronglyMeasurable).congr ?_
    filter_upwards [] with q
    change modelFirstFiber α f q.1.1 q.1.2 q.2.1 ^ 2 *
        (modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
          q.2.2 ^ (-47 : ℝ)) = _
    rw [modelPassiveKernel_eq]
    dsimp only [modelFirstSuperpositionJoint, modelFirstSuperpositionIntegrand, g]
    ring
  apply Integrable.mono' (hkernel.const_mul (M ^ 2)) hmeas
  filter_upwards [hscale, hlambda] with q ht hlam
  have hfiber : |modelFirstFiber α f q.1.1 q.1.2 q.2.1| ≤ M := by
    dsimp only [M]
    exact abs_modelFirstFiber_le α f q.1.1 q.2.1 hfcont B0 B1 B2
      hB0 hB1 hB2 hf0 hf1 hf2 ht
  have hsq : (modelFirstFiber α f q.1.1 q.1.2 q.2.1) ^ 2 ≤ M ^ 2 := by
    rw [← sq_abs]
    have hsub : 0 ≤ M - |modelFirstFiber α f q.1.1 q.1.2 q.2.1| :=
      sub_nonneg.mpr hfiber
    have hadd : 0 ≤ M + |modelFirstFiber α f q.1.1 q.1.2 q.2.1| :=
      add_nonneg hM (abs_nonneg _)
    nlinarith [mul_nonneg hsub hadd]
  have hpassive : 0 ≤ modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 :=
    modelPassiveKernel_nonneg α q.2.2 q.1.1 q.1.2 g hgnonneg hlam ht q.2.1
  have hpow : 0 ≤ q.2.2 ^ (-47 : ℝ) :=
    Real.rpow_nonneg (le_trans zero_le_one hlam) _
  have hweight : 0 ≤ modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
      q.2.2 ^ (-47 : ℝ) := mul_nonneg hpassive hpow
  have htargeteq : modelFirstSuperpositionJoint α u f q =
      modelFirstFiber α f q.1.1 q.1.2 q.2.1 ^ 2 *
        (modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
          q.2.2 ^ (-47 : ℝ)) := by
    dsimp only [modelFirstSuperpositionJoint, modelFirstSuperpositionIntegrand, g]
    rw [modelPassiveKernel_eq]
    ring
  have htarget : 0 ≤ modelFirstSuperpositionJoint α u f q := by
    rw [htargeteq]
    exact mul_nonneg (sq_nonneg _) hweight
  have hmajor : 0 ≤ M ^ 2 *
      (modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
        q.2.2 ^ (-47 : ℝ)) := mul_nonneg (sq_nonneg _) hweight
  have hle : modelFirstSuperpositionJoint α u f q ≤ M ^ 2 *
      (modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
        q.2.2 ^ (-47 : ℝ)) := by
    rw [htargeteq]
    exact mul_le_mul_of_nonneg_right hsq hweight
  simpa only [Real.norm_eq_abs, abs_of_nonneg htarget, abs_of_nonneg hmajor]
    using hle

/-- Bounded continuous data make the translated second-energy Gaussian
superposition integrable jointly in the collection variables, passive model
variables, and source scale. -/
theorem integrable_modelSecondSuperpositionJoint_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) :
    Integrable (modelSecondSuperpositionJoint α f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        ((volume : Measure ModelE5).prod
          ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) ) := by
  rcases hfbound with ⟨B, hB, hf⟩
  let g : ℝ → ℝ := fun r ↦ translationWeight r ^ (-50 : ℝ)
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let M : ℝ := B * ∫ v : ℝ, |gaussianDeriv v|
  have hRpos (r : ℝ) : 0 < translationWeight r := by
    unfold translationWeight
    positivity
  have hRone (r : ℝ) : 1 ≤ translationWeight r := by
    unfold translationWeight
    linarith [abs_nonneg r]
  have hgmeas : Measurable g := by
    dsimp only [g]
    exact ((continuous_const.add continuous_abs).rpow_const (fun r ↦
      Or.inl (ne_of_gt (hRpos r)))).measurable
  have hgnonneg : ∀ r, 0 ≤ g r := by
    intro r
    dsimp only [g]
    exact Real.rpow_nonneg (hRpos r).le _
  have hpowle (r : ℝ) :
      translationWeight r ^ (-50 : ℝ) ≤ translationWeight r ^ (-29 : ℝ) := by
    rw [show (-50 : ℝ) = (-29 : ℝ) + (-21 : ℝ) by norm_num,
      Real.rpow_add (hRpos r)]
    have hsmall : translationWeight r ^ (-21 : ℝ) ≤ 1 :=
      Real.rpow_le_one_of_one_le_of_nonpos (hRone r) (by norm_num)
    exact (mul_le_mul_of_nonneg_left hsmall
      (Real.rpow_nonneg (hRpos r).le _)).trans_eq (by ring)
  have hg : Integrable g := by
    apply Integrable.mono' integrable_translationWeight_negTwentyNine
      hgmeas.aestronglyMeasurable
    filter_upwards [] with r
    have hleft : 0 ≤ translationWeight r ^ (-50 : ℝ) := hgnonneg r
    have hright : 0 ≤ translationWeight r ^ (-29 : ℝ) :=
      Real.rpow_nonneg (hRpos r).le _
    simpa only [g, Real.norm_eq_abs, abs_of_nonneg hleft, abs_of_nonneg hright]
      using hpowle r
  have hM : 0 ≤ M := by
    dsimp only [M]
    exact mul_nonneg hB
      (integral_nonneg fun v ↦ abs_nonneg (gaussianDeriv v))
  have hkernel := integrable_modelPassiveKernel_collection_sourceScale
    α S g hgmeas hg hgnonneg
  have hscale : ∀ᵐ q ∂(μ.prod ((volume : Measure ModelE5).prod ν)),
      0 < q.1.2 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · dsimp only [μ]
      filter_upwards [ae_restrict_mem (measurableSet_collectionRegion α S)]
        with pt hpt
      exact ae_of_all _ fun _ ↦ pos_of_mem_collectionRegion α S hpt
    · exact measurableSet_Ioi.preimage (measurable_snd.comp measurable_fst)
  have hlambda : ∀ᵐ q ∂(μ.prod ((volume : Measure ModelE5).prod ν)),
      1 ≤ q.2.2 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [] with pt
      rw [Measure.ae_prod_iff_ae_ae]
      · filter_upwards [] with z
        exact ae_restrict_mem measurableSet_Ici
      · exact measurableSet_Ici.preimage measurable_snd
    · exact measurableSet_Ici.preimage (measurable_snd.comp measurable_snd)
  have hmeas : AEStronglyMeasurable (modelSecondSuperpositionJoint α f)
      (μ.prod ((volume : Measure ModelE5).prod ν)) := by
    have hfiber := aestronglyMeasurable_modelSecondFiber_lift
      α f hfcont (μ.prod ((volume : Measure ModelE5).prod ν))
    refine ((hfiber.pow 2).mul hkernel.aestronglyMeasurable).congr ?_
    filter_upwards [] with q
    change modelSecondFiber α f q.1.1 q.1.2 q.2.1 ^ 2 *
        (modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
          q.2.2 ^ (-47 : ℝ)) = _
    rw [modelPassiveKernel_eq]
    dsimp only [modelSecondSuperpositionJoint,
      modelSecondSuperpositionIntegrand, g]
    ring
  apply Integrable.mono' (hkernel.const_mul (M ^ 2)) hmeas
  filter_upwards [hscale, hlambda] with q ht hlam
  have hfiber : |modelSecondFiber α f q.1.1 q.1.2 q.2.1| ≤ M := by
    dsimp only [M]
    exact abs_modelSecondFiber_le α f q.1.1 q.2.1 hfcont B hB hf ht
  have hsq : (modelSecondFiber α f q.1.1 q.1.2 q.2.1) ^ 2 ≤ M ^ 2 := by
    rw [← sq_abs]
    have hsub : 0 ≤ M - |modelSecondFiber α f q.1.1 q.1.2 q.2.1| :=
      sub_nonneg.mpr hfiber
    have hadd : 0 ≤ M + |modelSecondFiber α f q.1.1 q.1.2 q.2.1| :=
      add_nonneg hM (abs_nonneg _)
    nlinarith [mul_nonneg hsub hadd]
  have hpassive : 0 ≤ modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 :=
    modelPassiveKernel_nonneg α q.2.2 q.1.1 q.1.2 g hgnonneg hlam ht q.2.1
  have hpow : 0 ≤ q.2.2 ^ (-47 : ℝ) :=
    Real.rpow_nonneg (le_trans zero_le_one hlam) _
  have hweight : 0 ≤ modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
      q.2.2 ^ (-47 : ℝ) := mul_nonneg hpassive hpow
  have htargeteq : modelSecondSuperpositionJoint α f q =
      modelSecondFiber α f q.1.1 q.1.2 q.2.1 ^ 2 *
        (modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
          q.2.2 ^ (-47 : ℝ)) := by
    dsimp only [modelSecondSuperpositionJoint,
      modelSecondSuperpositionIntegrand, g]
    rw [modelPassiveKernel_eq]
    ring
  have htarget : 0 ≤ modelSecondSuperpositionJoint α f q := by
    rw [htargeteq]
    exact mul_nonneg (sq_nonneg _) hweight
  have hmajor : 0 ≤ M ^ 2 *
      (modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
        q.2.2 ^ (-47 : ℝ)) := mul_nonneg (sq_nonneg _) hweight
  have hle : modelSecondSuperpositionJoint α f q ≤ M ^ 2 *
      (modelPassiveKernel α q.2.2 q.1.1 q.1.2 g q.2.1 *
        q.2.2 ^ (-47 : ℝ)) := by
    rw [htargeteq]
    exact mul_le_mul_of_nonneg_right hsq hweight
  simpa only [Real.norm_eq_abs, abs_of_nonneg htarget, abs_of_nonneg hmajor]
    using hle

/-- The annular physical cutoff is nonzero, hence its absolute `L¹` mass is
strictly positive. This permits recovery of the first cube form from the
first superposition after its annular variable has been integrated out. -/
theorem conePsiPhysicalRealL1_pos : 0 < conePsiPhysicalRealL1 := by
  have hnonzero : ∃ x : ℝ, conePsiPhysicalReal x ≠ 0 := by
    classical
    by_contra h
    push Not at h
    have hzero : conePsiPhysical = 0 := by
      ext x
      rw [← conePsiPhysical_eq_ofReal x, h x]
      norm_num
    have hfourier : conePsiSchwartz = 0 := by
      have h' := congrArg (fun G : SchwartzMap ℝ ℂ ↦ 𝓕 G) hzero
      simpa only [schwartzFourier_conePsiPhysical,
        FourierTransform.fourier_zero] using h'
    have hvalue := congrArg (fun G : SchwartzMap ℝ ℂ ↦ G (3 / 2 : ℝ)) hfourier
    rw [conePsiSchwartz_apply,
      conePsi_eq_one_on_core (by norm_num : |(3 / 2 : ℝ) - 3 / 2| ≤ 1 / 8)] at hvalue
    norm_num at hvalue
  rcases hnonzero with ⟨x, hx⟩
  unfold conePsiPhysicalRealL1
  exact integral_pos_of_integrable_nonneg_nonzero
    (continuous_abs.comp conePsiPhysicalReal.continuous)
    integrable_abs_conePsiPhysicalReal
    (fun r ↦ abs_nonneg _)
    (abs_ne_zero.mpr hx)

/-- The bounded-continuous first superposition supplies the normalized
source-scale integrability required by the full-cube tree estimate. -/
theorem integrableOn_modelFirstCubeComparison_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : ModelRealInput)
    (hfcont : ∀ j, Continuous (f j))
    (hfbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B) :
    IntegrableOn (fun lam : ℝ ↦
      localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
        lam ^ (-47 : ℝ)) (Set.Ici (1 : ℝ)) := by
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let η : Measure ModelE5 := volume
  let e := outerLambdaShuffleRight (E3 × ℝ) ModelE5
  let H : ℝ → ℝ := fun lam ↦
    ∫ xy : (E3 × ℝ) × ModelE5,
      modelFirstSuperpositionJoint α u f (xy.1, (xy.2, lam)) ∂(μ.prod η)
  have hsuper := integrable_modelFirstSuperpositionJoint_of_boundedContinuous
    α S u f hfcont hfbound
  have hFcont : ∀ j, Continuous (modelFirstCubeTuple f j) :=
    continuous_modelFirstCubeTuple f hfcont
  have hFbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y,
      |modelFirstCubeTuple f j y| ≤ B :=
    bounded_modelFirstCubeTuple f hfbound
  let : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  have hmp : MeasurePreserving e (μ.prod (η.prod ν)) (ν.prod (μ.prod η)) := by
    simpa only [e, μ, η, ν] using
      outerLambdaShuffleRight_measurePreserving μ η
  have htrans : Integrable (fun q : ℝ × ((E3 × ℝ) × ModelE5) ↦
      modelFirstSuperpositionJoint α u f (e.symm q)) (ν.prod (μ.prod η)) := by
    exact (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hsuper
  have hfib : ∀ᵐ lam ∂ν, Integrable (fun xy : (E3 × ℝ) × ModelE5 ↦
      modelFirstSuperpositionJoint α u f
        (xy.1, (xy.2, lam))) (μ.prod η) := by
    have h := (MeasureTheory.integrable_prod_iff htrans.aestronglyMeasurable).mp
      htrans
    filter_upwards [h.1] with lam hlamint
    refine hlamint.congr ?_
    filter_upwards [] with xy
    rw [outerLambdaShuffleRight_symm_apply]
  have hlam : ∀ᵐ lam ∂ν, 1 ≤ lam := by
    filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
    exact hlam
  have hH : Integrable H ν := by
    refine htrans.integral_prod_left.congr ?_
    filter_upwards [] with lam
    dsimp only [H]
    apply integral_congr_ae
    filter_upwards [] with xy
    rw [outerLambdaShuffleRight_symm_apply]
  have hEq : H =ᵐ[ν] fun lam ↦
      conePsiPhysicalRealL1 *
        localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
          lam ^ (-47 : ℝ) := by
    filter_upwards [hfib, hlam] with lam hlamint hlam
    have hpassive := integrable_modelFirstPassiveSquare
      α S lam f false hFcont hFbound hlam
    dsimp only [H]
    calc
      ∫ xy : (E3 × ℝ) × ModelE5,
          modelFirstSuperpositionJoint α u f
            (xy.1, (xy.2, lam)) ∂(μ.prod η) =
          ∫ pt : E3 × ℝ, ∫ z : ModelE5,
            modelFirstSuperpositionJoint α u f
              (pt, (z, lam)) ∂η ∂μ :=
        MeasureTheory.integral_prod _ hlamint
      _ = ∫ pt : E3 × ℝ,
          ((∫ y : TransverseSpace 2 × TransverseSpace 2,
            cubePassiveGaussianKernel α 2 lam 0 pt.2 pt.1 y *
              (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) false
                ((pt.1, pt.2), y)) ^ 2
            ∂((volume : Measure (TransverseSpace 2)).prod
              (volume : Measure (TransverseSpace 2)))) *
            conePsiPhysicalRealL1) * lam ^ (-47 : ℝ) ∂μ := by
          apply integral_congr_ae
          filter_upwards [] with pt
          calc
            ∫ z : ModelE5,
                modelFirstSuperpositionJoint α u f
                  (pt, (z, lam)) ∂η =
                (∫ z : ModelE5,
                  (modelFirstFiber α f pt.1 pt.2 z) ^ 2 *
                    |conePsiPhysicalReal (z 4 + u 2)| *
                    modelFirstPassiveGaussianWeight α lam pt.1 pt.2
                      (z 0) (z 1) (z 2) (z 3)) * lam ^ (-47 : ℝ) := by
                  rw [← MeasureTheory.integral_mul_const]
                  apply integral_congr_ae
                  filter_upwards [] with z
                  dsimp only [modelFirstSuperpositionJoint,
                    modelFirstSuperpositionIntegrand]
            _ = _ := by
              rw [integral_modelFirstFiber_sq_psi_passiveWeight
                α lam f false pt.1 pt.2 (u 2)]
      _ = conePsiPhysicalRealL1 *
          (∫ pt : E3 × ℝ,
            ∫ y : TransverseSpace 2 × TransverseSpace 2,
              cubePassiveGaussianKernel α 2 lam 0 pt.2 pt.1 y *
                (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) false
                  ((pt.1, pt.2), y)) ^ 2
              ∂((volume : Measure (TransverseSpace 2)).prod
                (volume : Measure (TransverseSpace 2))) ∂μ) *
            lam ^ (-47 : ℝ) := by
              rw [show (∫ pt : E3 × ℝ,
                  ((∫ y : TransverseSpace 2 × TransverseSpace 2,
                    cubePassiveGaussianKernel α 2 lam 0 pt.2 pt.1 y *
                      (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) false
                        ((pt.1, pt.2), y)) ^ 2
                    ∂((volume : Measure (TransverseSpace 2)).prod
                      (volume : Measure (TransverseSpace 2)))) *
                    conePsiPhysicalRealL1) * lam ^ (-47 : ℝ) ∂μ) =
                  (conePsiPhysicalRealL1 * lam ^ (-47 : ℝ)) *
                    ∫ pt : E3 × ℝ,
                      ∫ y : TransverseSpace 2 × TransverseSpace 2,
                        cubePassiveGaussianKernel α 2 lam 0 pt.2 pt.1 y *
                          (cubeActiveCSAverage α 2 lam 0 (modelFirstCubeTuple f) false
                            ((pt.1, pt.2), y)) ^ 2
                        ∂((volume : Measure (TransverseSpace 2)).prod
                          (volume : Measure (TransverseSpace 2))) ∂μ by
                    rw [← MeasureTheory.integral_const_mul]
                    apply integral_congr_ae
                    filter_upwards [] with pt
                    ring]
              ring
      _ = conePsiPhysicalRealL1 *
          localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
            lam ^ (-47 : ℝ) := by
              rw [← (MeasureTheory.integral_prod _ hpassive)]
              rw [← localCubeForm_modelFirst_eq_passiveSquare
                α S lam f false hFcont hFbound hlam]
  have hscaled : Integrable (fun lam ↦
      conePsiPhysicalRealL1 *
        localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
          lam ^ (-47 : ℝ)) ν := hH.congr hEq
  have hpositive := conePsiPhysicalRealL1_pos
  have hform := hscaled.const_mul conePsiPhysicalRealL1⁻¹
  refine hform.congr ?_
  filter_upwards [] with lam
  field_simp [ne_of_gt hpositive]

/-- The joint coordinate reordering for the second superposition: source
scale and translation become the two outer variables, while the collection
and transverse passive variables are retained as the inner block. -/
noncomputable def modelSecondSuperpositionShuffle :
    (E3 × ℝ) × (ModelE5 × ℝ) ≃ᵐ
      (ℝ × ℝ) × ((E3 × ℝ) ×
        (TransverseSpace 2 × TransverseSpace 2)) :=
  (((((outerLambdaShuffleRight (E3 × ℝ) ModelE5).trans
    (MeasurableEquiv.prodAssoc.symm :
      ℝ × ((E3 × ℝ) × ModelE5) ≃ᵐ (ℝ × (E3 × ℝ)) × ModelE5)).trans
    (modelFirstPassiveCoordinatesProd (ℝ × (E3 × ℝ)))).trans
    (crossShuffle ℝ (E3 × ℝ)
      (TransverseSpace 2 × TransverseSpace 2) ℝ)).trans
    (MeasurableEquiv.prodComm :
      ((TransverseSpace 2 × TransverseSpace 2) × (E3 × ℝ)) × (ℝ × ℝ) ≃ᵐ
        (ℝ × ℝ) × ((TransverseSpace 2 × TransverseSpace 2) × (E3 × ℝ)))).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (ℝ × ℝ))
      (MeasurableEquiv.prodComm :
        (TransverseSpace 2 × TransverseSpace 2) × (E3 × ℝ) ≃ᵐ
          (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2)))

@[simp] theorem modelSecondSuperpositionShuffle_apply
    (pt : E3 × ℝ) (z : ModelE5) (lam : ℝ) :
    modelSecondSuperpositionShuffle (pt, (z, lam)) =
      ((lam, z 4),
        (pt, modelFirstPassivePair (z 0) (z 1) (z 2) (z 3))) := by
  simp [modelSecondSuperpositionShuffle, outerLambdaShuffleRight,
    MeasurableEquiv.prodAssoc, MeasurableEquiv.prodComm,
    MeasurableEquiv.prodCongr, modelFirstPassiveCoordinatesProd_apply,
    crossShuffle, swapMiddle]

@[simp] theorem modelSecondSuperpositionShuffle_symm_apply
    (lam r : ℝ) (pt : E3 × ℝ)
    (y : TransverseSpace 2 × TransverseSpace 2) :
    modelSecondSuperpositionShuffle.symm ((lam, r), (pt, y)) =
      (pt, (modelFirstPassiveCoordinates.symm (y, r), lam)) := by
  apply modelSecondSuperpositionShuffle.injective
  rw [MeasurableEquiv.apply_symm_apply,
    modelSecondSuperpositionShuffle_apply,
    modelFirstPassiveCoordinates_symm_translation,
    modelFirstPassiveCoordinates_symm_passive]

/-- The second-superposition shuffle preserves the exact product measures
used by the source-scale/translation Fubini argument. -/
theorem modelSecondSuperpositionShuffle_measurePreserving
    (μ : Measure (E3 × ℝ)) [SFinite μ] :
    MeasurePreserving modelSecondSuperpositionShuffle
      (μ.prod ((volume : Measure ModelE5).prod
        ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))))
      ((((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))).prod volume).prod
        (μ.prod ((volume : Measure (TransverseSpace 2)).prod
          (volume : Measure (TransverseSpace 2))))) := by
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let η : Measure ModelE5 := volume
  let κ : Measure (TransverseSpace 2 × TransverseSpace 2) :=
    (volume : Measure (TransverseSpace 2)).prod volume
  let : SFinite ν := by
    dsimp only [ν]
    infer_instance
  let : SFinite (ν.prod (volume : Measure ℝ)) := by
    infer_instance
  have h₁ : MeasurePreserving (outerLambdaShuffleRight (E3 × ℝ) ModelE5)
      (μ.prod (η.prod ν)) (ν.prod (μ.prod η)) := by
    simpa only [ν, η] using
      outerLambdaShuffleRight_measurePreserving μ η
  have h₂ : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        ℝ × ((E3 × ℝ) × ModelE5) ≃ᵐ (ℝ × (E3 × ℝ)) × ModelE5)
      (ν.prod (μ.prod η)) ((ν.prod μ).prod η) :=
    (measurePreserving_prodAssoc ν μ η).symm
  have h₃ : MeasurePreserving
      (modelFirstPassiveCoordinatesProd (ℝ × (E3 × ℝ)))
      ((ν.prod μ).prod η) ((ν.prod μ).prod (κ.prod volume)) := by
    simpa only [κ, η] using
      modelFirstPassiveCoordinatesProd_measurePreserving (ν.prod μ)
  have h₄ : MeasurePreserving
      (crossShuffle ℝ (E3 × ℝ)
        (TransverseSpace 2 × TransverseSpace 2) ℝ)
      ((ν.prod μ).prod (κ.prod volume))
      ((κ.prod μ).prod (ν.prod volume)) := by
    simpa only [κ] using
      crossShuffle_measurePreserving ℝ (E3 × ℝ)
        (TransverseSpace 2 × TransverseSpace 2) ℝ ν μ κ volume
  have h₅ : MeasurePreserving
      (MeasurableEquiv.prodComm :
        ((TransverseSpace 2 × TransverseSpace 2) × (E3 × ℝ)) × (ℝ × ℝ) ≃ᵐ
          (ℝ × ℝ) × ((TransverseSpace 2 × TransverseSpace 2) × (E3 × ℝ)))
      ((κ.prod μ).prod (ν.prod volume))
      ((ν.prod volume).prod (κ.prod μ)) :=
    Measure.measurePreserving_swap
  have h₆ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (ℝ × ℝ))
        (MeasurableEquiv.prodComm :
          (TransverseSpace 2 × TransverseSpace 2) × (E3 × ℝ) ≃ᵐ
            (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2)))
      ((ν.prod volume).prod (κ.prod μ))
      ((ν.prod volume).prod (μ.prod κ)) := by
    convert (MeasurePreserving.id (ν.prod volume)).prod
      (Measure.measurePreserving_swap : MeasurePreserving Prod.swap
        (κ.prod μ) (μ.prod κ)) using 1 <;> try infer_instance
    funext q
    rfl
  simpa only [modelSecondSuperpositionShuffle, ν, η, κ] using
    (((((h₁.trans h₂).trans h₃).trans h₄).trans h₅).trans h₆)

/-- The bounded-continuous second superposition supplies the joint
source-scale/translation integrability required by the edge-tree estimate. -/
theorem integrable_modelSecondCubeComparison_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) :
    Integrable (fun z : ℝ × ℝ ↦
      localCubeForm α S 2 z.1 z.2 (edgeCubeTuple f) *
        translationWeight z.2 ^ (-50 : ℝ) * z.1 ^ (-47 : ℝ))
      (((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))).prod volume) := by
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  let κ : Measure (TransverseSpace 2 × TransverseSpace 2) :=
    (volume : Measure (TransverseSpace 2)).prod volume
  let : IsFiniteMeasure μ := by
    dsimp only [μ]
    exact isFiniteMeasure_cubeScaleCollection α S
  let : SFinite ν := by
    dsimp only [ν]
    infer_instance
  let : SFinite (ν.prod (volume : Measure ℝ)) := by infer_instance
  let : SFinite κ := by
    dsimp only [κ]
    infer_instance
  let : SFinite (μ.prod κ) := by infer_instance
  let e := modelSecondSuperpositionShuffle
  let G : (ℝ × ℝ) × ((E3 × ℝ) ×
      (TransverseSpace 2 × TransverseSpace 2)) → ℝ := fun q ↦
    cubePassiveGaussianKernel α 2 q.1.1 q.1.2 q.2.1.2 q.2.1.1 q.2.2 *
      (cubeActiveCSAverage α 2 q.1.1 q.1.2 (edgeCubeTuple f) false q.2) ^ 2 *
        translationWeight q.1.2 ^ (-50 : ℝ) * q.1.1 ^ (-47 : ℝ)
  have hsuper := integrable_modelSecondSuperpositionJoint_of_boundedContinuous
    α S f hfcont hfbound
  have hmp : MeasurePreserving e
      (μ.prod ((volume : Measure ModelE5).prod ν))
      ((ν.prod volume).prod (μ.prod κ)) := by
    simpa only [e, μ, ν, κ] using
      modelSecondSuperpositionShuffle_measurePreserving μ
  have htransport : Integrable (fun q : (ℝ × ℝ) × ((E3 × ℝ) ×
      (TransverseSpace 2 × TransverseSpace 2)) ↦
      modelSecondSuperpositionJoint α f (e.symm q))
      ((ν.prod volume).prod (μ.prod κ)) := by
    exact (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hsuper
  have hkernel : Integrable G ((ν.prod volume).prod (μ.prod κ)) := by
    refine htransport.congr ?_
    filter_upwards [] with q
    rcases q with ⟨⟨lam, r⟩, ⟨pt, y⟩⟩
    rw [show e = modelSecondSuperpositionShuffle by rfl,
      modelSecondSuperpositionShuffle_symm_apply]
    dsimp only [G, modelSecondSuperpositionJoint,
      modelSecondSuperpositionIntegrand]
    rw [← cubeActiveCSAverage_modelSecond α lam f false pt.1 pt.2
      (modelFirstPassiveCoordinates.symm (y, r)),
      ← cubePassiveGaussianKernel_modelFirst α lam r pt.1 pt.2
        ((modelFirstPassiveCoordinates.symm (y, r)) 0)
        ((modelFirstPassiveCoordinates.symm (y, r)) 1)
        ((modelFirstPassiveCoordinates.symm (y, r)) 2)
        ((modelFirstPassiveCoordinates.symm (y, r)) 3),
      modelFirstPassiveCoordinates_symm_passive,
      modelFirstPassiveCoordinates_symm_translation]
    ring
  have houter : Integrable (fun lr : ℝ × ℝ ↦
      ∫ w : (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2),
        G (lr, w) ∂(μ.prod κ)) (ν.prod volume) :=
    hkernel.integral_prod_left
  have hlam : ∀ᵐ lr ∂(ν.prod (volume : Measure ℝ)), 1 ≤ lr.1 := by
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
      exact ae_of_all _ fun _ ↦ hlam
    · exact measurableSet_Ici.preimage measurable_fst
  refine houter.congr ?_
  filter_upwards [hlam] with lr hlr
  have hform : localCubeForm α S 2 lr.1 lr.2 (edgeCubeTuple f) =
      ∫ w : (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2),
        cubePassiveGaussianKernel α 2 lr.1 lr.2 w.1.2 w.1.1 w.2 *
          (cubeActiveCSAverage α 2 lr.1 lr.2 (edgeCubeTuple f) false w) ^ 2
        ∂(μ.prod κ) := by
    simpa only [μ, κ] using localCubeForm_edge_eq_passiveSquare
      α S lr.1 lr.2 f false hfcont hfbound hlr
  dsimp only [G]
  calc
    (∫ w : (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2),
        cubePassiveGaussianKernel α 2 lr.1 lr.2 w.1.2 w.1.1 w.2 *
          (cubeActiveCSAverage α 2 lr.1 lr.2 (edgeCubeTuple f) false w) ^ 2 *
            translationWeight lr.2 ^ (-50 : ℝ) * lr.1 ^ (-47 : ℝ)
        ∂(μ.prod κ)) =
        (translationWeight lr.2 ^ (-50 : ℝ) * lr.1 ^ (-47 : ℝ)) *
          ∫ w : (E3 × ℝ) × (TransverseSpace 2 × TransverseSpace 2),
            cubePassiveGaussianKernel α 2 lr.1 lr.2 w.1.2 w.1.1 w.2 *
              (cubeActiveCSAverage α 2 lr.1 lr.2 (edgeCubeTuple f) false w) ^ 2
            ∂(μ.prod κ) := by
              rw [← MeasureTheory.integral_const_mul]
              apply integral_congr_ae
              filter_upwards [] with w
              ring
    _ = localCubeForm α S 2 lr.1 lr.2 (edgeCubeTuple f) *
        translationWeight lr.2 ^ (-50 : ℝ) * lr.1 ^ (-47 : ℝ) := by
          rw [← hform]
          ring

/-- Bounded continuous source data meet all four literal integrability inputs
to the source-stopping tree energy estimates. -/
theorem sourceStoppingTreeEnergyIntegrability_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (f : ModelRealInput)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B) :
    sourceStoppingTreeEnergyIntegrability α S hS u f := by
  intro n Q
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact integrable_modelFirstSuperpositionJoint_of_boundedContinuous
      α (sourceStoppingTree α S hS f n Q).boxes u f hcont hbound
  · exact integrableOn_modelFirstCubeComparison_of_boundedContinuous
      α (sourceStoppingTree α S hS f n Q).boxes u f hcont hbound
  · exact integrable_modelSecondSuperpositionJoint_of_boundedContinuous
      α (sourceStoppingTree α S hS f n Q).boxes (f 3) (hcont 3) (hbound 3)
  · exact integrable_modelSecondCubeComparison_of_boundedContinuous
      α (sourceStoppingTree α S hS f n Q).boxes (f 3) (hcont 3) (hbound 3)

/-- The two stopping-tree analytic hypotheses are automatic for bounded
continuous input functions and a bounded measurable scale coefficient. -/
theorem sourceStoppingTreeAnalyticPremises_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (hcmeas : Measurable c)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    sourceStoppingTreeCS α S hS u c f ∧
      sourceStoppingTreeEnergyIntegrability α S hS u f := by
  exact ⟨sourceStoppingTreeCS_of_boundedContinuous
      α S hS u c f hcmeas hcont hbound hc,
    sourceStoppingTreeEnergyIntegrability_of_boundedContinuous
      α S hS u f hcont hbound⟩

/-- The stopping-tree analytic premises specialize directly to real Schwartz
input tuples used in the initial model range. -/
theorem initialModel_sourceStoppingTreeAnalyticPremises
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (F : InitialModelSchwartzInput)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1) :
    sourceStoppingTreeCS α S hS u c (InitialModelRealInput F) ∧
      sourceStoppingTreeEnergyIntegrability α S hS u (InitialModelRealInput F) := by
  exact sourceStoppingTreeAnalyticPremises_of_boundedContinuous
    α S hS u c (InitialModelRealInput F) hcmeas
    (initialModelRealInput_continuous F) (initialModelRealInput_bounded F) hc

/-- Bounded continuous inputs make the literal signed center--scale/fiber
integrand absolutely integrable over every finite collection. -/
theorem integrable_modelSignedIntegrand_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (hcmeas : Measurable c)
    (hfcont : ∀ j, Continuous (f j))
    (hfbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    Integrable (modelSignedIntegrand α u c f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)) := by
  let μ : Measure ((E3 × ℝ) × ModelE5) :=
    (cubeScaleMeasure.restrict (collectionRegion α S)).prod volume
  let A : (E3 × ℝ) × ModelE5 → ℝ := fun q ↦
    modelFirstFiber α f q.1.1 q.1.2 q.2
  let B : (E3 × ℝ) × ModelE5 → ℝ := fun q ↦
    modelSecondFiber α (f 3) q.1.1 q.1.2 q.2
  let C : (E3 × ℝ) × ModelE5 → ℝ := fun q ↦ c q.1.2
  let σ : (E3 × ℝ) × ModelE5 → ℝ := fun q ↦
    modelSignedDensity α u q.1.1 q.1.2 q.2
  let W : (E3 × ℝ) × ModelE5 → ℝ := fun q ↦
    modelEnergyDensity α u q.1.1 q.1.2 q.2
  have hW : ∀ᵐ q ∂μ, 0 ≤ W q := by
    simpa only [μ, W] using ae_modelEnergyDensity_nonneg_collection α S u
  have hσ : ∀ᵐ q ∂μ, |σ q| = W q := by
    simpa only [μ, σ, W] using ae_abs_modelSignedDensity_collection α S u
  have hC : ∀ᵐ q ∂μ, |C q| ≤ 1 :=
    Filter.Eventually.of_forall fun q ↦ hc q.1.2
  have hprodmeas : AEStronglyMeasurable
      (fun q ↦ C q * (A q * B q * σ q)) μ := by
    change AEStronglyMeasurable (modelSignedIntegrand α u c f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)
    exact aestronglyMeasurable_modelSignedIntegrand α u c f hcmeas hfcont μ
  have hfirstmeas : AEStronglyMeasurable
      (fun q ↦ |A q| * √(W q)) μ := by
    change AEStronglyMeasurable (modelFirstWeightedFactor α u f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)
    exact aestronglyMeasurable_modelFirstWeightedFactor α u f hfcont μ
  have hsecondmeas : AEStronglyMeasurable
      (fun q ↦ |B q| * √(W q)) μ := by
    change AEStronglyMeasurable (modelSecondWeightedFactor α u (f 3))
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)
    exact aestronglyMeasurable_modelSecondWeightedFactor α u (f 3) (hfcont 3) μ
  rcases hfbound 0 with ⟨B0, hB0, hf0⟩
  rcases hfbound 1 with ⟨B1, hB1, hf1⟩
  rcases hfbound 2 with ⟨B2, hB2, hf2⟩
  rcases hfbound 3 with ⟨B3, hB3, hf3⟩
  have hweightint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyDensity α u q.1.1 q.1.2 q.2) μ := by
    simpa only [μ] using integrable_modelEnergyDensity_collection α S u
  have hfirstint : Integrable (fun q ↦ (|A q| * √(W q)) ^ 2) μ := by
    simpa only [μ, A, W, modelFirstWeightedFactor] using
      integrable_modelFirstWeightedFactor_sq_of_density
        α S u f hfcont B0 B1 B2 hB0 hB1 hB2 hf0 hf1 hf2 hweightint
  have hsecondint : Integrable (fun q ↦ (|B q| * √(W q)) ^ 2) μ := by
    simpa only [μ, B, W, modelSecondWeightedFactor] using
      integrable_modelSecondWeightedFactor_sq_of_density
        α S u (f 3) (hfcont 3) B3 hB3 hf3 hweightint
  have hjoint := integrable_signedDensity_of_weighted μ A B C σ W
    hprodmeas hfirstmeas hsecondmeas hfirstint hsecondint hC hW hσ
  change Integrable (fun q ↦ C q * (A q * B q * σ q)) μ
  exact hjoint

/-- The signed product's joint absolute integrability gives the literal
outer center--scale integrability used to partition a finite stopping forest. -/
theorem integrable_outerModelSignedFiber_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (hcmeas : Measurable c)
    (hfcont : ∀ j, Continuous (f j))
    (hfbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α f pt.1 pt.2 z *
          modelSecondFiber α (f 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict (collectionRegion α S)) := by
  let μ : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  let : IsFiniteMeasure μ := by
    dsimp only [μ]
    exact isFiniteMeasure_cubeScaleCollection α S
  have hjoint := integrable_modelSignedIntegrand_of_boundedContinuous
    α S u c f hcmeas hfcont hfbound hc
  have houter : Integrable (fun pt : E3 × ℝ ↦
      ∫ z : ModelE5, modelSignedIntegrand α u c f (pt, z)) μ := by
    exact hjoint.integral_prod_left
  refine houter.congr ?_
  filter_upwards [] with pt
  change (∫ z : ModelE5,
      c pt.2 * (modelFirstFiber α f pt.1 pt.2 z *
        modelSecondFiber α (f 3) pt.1 pt.2 z *
          modelSignedDensity α u pt.1 pt.2 z)) = _
  rw [MeasureTheory.integral_const_mul]

/-- The outer signed-form integrability premise is automatic for the real
Schwartz tuples in the initial model range. -/
theorem integrable_outerModelSignedFiber_of_initialModelSchwartz
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (F : InitialModelSchwartzInput) (hcmeas : Measurable c)
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    Integrable (fun pt : E3 × ℝ ↦
      c pt.2 * (∫ z : ModelE5,
        modelFirstFiber α (InitialModelRealInput F) pt.1 pt.2 z *
          modelSecondFiber α (InitialModelRealInput F 3) pt.1 pt.2 z *
            modelSignedDensity α u pt.1 pt.2 z))
      (cubeScaleMeasure.restrict (collectionRegion α S)) := by
  exact integrable_outerModelSignedFiber_of_boundedContinuous
    α S u c (InitialModelRealInput F) hcmeas
    (initialModelRealInput_continuous F) (initialModelRealInput_bounded F) hc

/-- After the finite maximal-level hypothesis, all analytic premises of the
coordinate-level active stopping-forest bound are automatic for bounded
continuous input data. -/
theorem activeStoppingForest_bound_of_coordinateLevel_finite_auto
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (q σ : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (hpos : ∀ r ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) r)
    (hcmeas : Measurable c)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hfinite : ∀ (j : Fin 4) (m : ℤ),
      volume (sourceStoppingMaximalLevelSetAt α f j m) ≠ ∞) :
    ∃ C : ℝ, 0 ≤ C ∧
      |expandedModelLocalForm α S u c f| ≤
        C * sourceWeight u ^ 75 *
          SourceStoppingCoordinateEnvelope α S f q σ hpos := by
  rcases sourceStoppingTreeAnalyticPremises_of_boundedContinuous
    α S hS u c f hcmeas hcont hbound hc with ⟨hcs, henergy⟩
  exact activeStoppingForest_bound_of_coordinateLevel_finite
    α S hS u c f q σ hq hpos hcont hbound hfinite hcs henergy
      (integrable_outerModelSignedFiber_of_boundedContinuous
        α S u c f hcmeas hcont hbound hc)

/-- The initial Schwartz-model active stopping-forest estimate with every
treewise and Fubini analytic condition discharged. -/
theorem activeStoppingForest_bound_of_realSchwartz_auto
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (F : InitialModelSchwartzInput)
    (q σ : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (hpos : ∀ r ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j)
        (InitialModelRealInput F j) r)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hfinite : ∀ (j : Fin 4) (m : ℤ),
      volume (sourceStoppingMaximalLevelSetAt α
        (InitialModelRealInput F) j m) ≠ ∞) :
    ∃ C : ℝ, 0 ≤ C ∧
      |expandedModelLocalForm α S u c (InitialModelRealInput F)| ≤
        C * sourceWeight u ^ 75 *
          SourceStoppingCoordinateEnvelope α S
            (InitialModelRealInput F) q σ hpos := by
  rcases initialModel_sourceStoppingTreeAnalyticPremises
    α S hS u c F hcmeas hc with ⟨hcs, henergy⟩
  exact activeStoppingForest_bound_of_realSchwartz
    α S hS u c F q σ hq hpos hfinite hcs henergy
      (integrable_outerModelSignedFiber_of_initialModelSchwartz
        α S u c F hcmeas hc)

/-- A positive superlevel set has finite volume whenever the function tends
to zero at spatial infinity. This is the topological last step needed for
the stopping maximal-level regions. -/
theorem volume_ne_top_of_tendsto_cocompact_zero
    (g : E3 → ℝ) (θ : ℝ) (hθ : 0 < θ)
    (hzero : Tendsto g (cocompact E3) (𝓝 0)) :
    volume {p | θ < g p} ≠ ∞ := by
  have hIio : Set.Iio θ ∈ 𝓝 (0 : ℝ) := Iio_mem_nhds hθ
  have hsmall : g ⁻¹' Set.Iio θ ∈ cocompact E3 := hzero hIio
  rcases Filter.mem_cocompact.mp hsmall with ⟨K, hK, hKsmall⟩
  have hsub : {p : E3 | θ < g p} ⊆ K := by
    intro p hp
    by_contra hpK
    have hpSmall : g p ∈ Set.Iio θ := hKsmall hpK
    change θ < g p at hp
    change g p < θ at hpSmall
    exact (not_lt_of_ge hpSmall.le) hp
  exact ne_of_lt ((MeasureTheory.measure_mono hsub).trans_lt hK.measure_lt_top)

/-- The measure-theoretic alternative to the compact-tail argument: any
finite-exponent `L^p` maximal estimate gives finite positive superlevel
measure by Chebyshev--Markov. -/
theorem volume_ne_top_of_memLp
    (g : E3 → ℝ) (q : ℝ≥0∞) (hg : MemLp g q volume)
    (hq0 : q ≠ 0) (hqtop : q ≠ ∞) {θ : ℝ} (hθ : 0 < θ) :
    volume {p | θ < g p} ≠ ∞ := by
  have hθnn : (θ.toNNReal : NNReal) ≠ 0 := by
    exact (Real.toNNReal_pos.mpr hθ).ne'
  have hmark : volume {p | (θ.toNNReal : NNReal) ≤ ‖g p‖₊} < ∞ :=
    hg.meas_ge_lt_top hq0 hqtop hθnn
  apply ne_of_lt
  apply (MeasureTheory.measure_mono ?_).trans_lt hmark
  intro p hp
  change θ < g p at hp
  change θ.toNNReal ≤ ‖g p‖₊
  apply Real.toNNReal_le_iff_le_coe.mpr
  change θ ≤ ‖g p‖
  rw [Real.norm_eq_abs, abs_of_nonneg (hθ.le.trans hp.le)]
  exact hp.le

/-- The tail conclusion specialized to one literal coordinate stopping level.
The positive threshold is automatic from the source comparison constant. -/
theorem sourceStoppingMaximalLevelSetAt_finite_of_tendsto_zero
    (α : Anisotropy) (f : ModelRealInput) (j : Fin 4) (m : ℤ)
    (hzero : Tendsto (sourceStoppingMaximal α f j)
      (cocompact E3) (𝓝 0)) :
    volume (sourceStoppingMaximalLevelSetAt α f j m) ≠ ∞ := by
  apply volume_ne_top_of_tendsto_cocompact_zero
    (sourceStoppingMaximal α f j)
    (sourceStoppingComparisonConstant j * (2 : ℝ) ^ (m - 1))
  · exact mul_pos (sourceStoppingComparisonConstant_pos j)
      (zpow_pos (by norm_num) _)
  · exact hzero

/-- A finite-exponent `L^p` estimate for a literal source stopping maximal
function supplies the finiteness hypothesis required by the root-packing
argument at every one of its dyadic levels. -/
theorem sourceStoppingMaximalLevelSetAt_finite_of_memLp
    (α : Anisotropy) (f : ModelRealInput) (j : Fin 4) (m : ℤ)
    (q : ℝ≥0∞) (hmax : MemLp (sourceStoppingMaximal α f j) q volume)
    (hq0 : q ≠ 0) (hqtop : q ≠ ∞) :
    volume (sourceStoppingMaximalLevelSetAt α f j m) ≠ ∞ := by
  apply volume_ne_top_of_memLp (sourceStoppingMaximal α f j) q
    hmax hq0 hqtop
  exact mul_pos (sourceStoppingComparisonConstant_pos j)
    (zpow_pos (by norm_num) _)

/-- Coordinatewise finite-exponent maximal estimates give all finite-measure
level hypotheses for the source stopping construction at once. -/
theorem sourceStopping_coordinateLevel_finite_of_memLp
    (α : Anisotropy) (f : ModelRealInput) (q : Fin 4 → ℝ≥0∞)
    (hmax : ∀ j : Fin 4, MemLp (sourceStoppingMaximal α f j) (q j) volume)
    (hq0 : ∀ j : Fin 4, q j ≠ 0) (hqtop : ∀ j : Fin 4, q j ≠ ∞) :
    ∀ (j : Fin 4) (m : ℤ),
      volume (sourceStoppingMaximalLevelSetAt α f j m) ≠ ∞ := by
  intro j m
  exact sourceStoppingMaximalLevelSetAt_finite_of_memLp
    α f j m (q j) (hmax j) (hq0 j) (hqtop j)

/-- The preceding `L^p` bridge in the native split form of the source
maximal-size lemma: one exponent-two branch and three exponent-four branches. -/
theorem sourceStopping_coordinateLevel_finite_of_branch_memLp
    (α : Anisotropy) (f : ModelRealInput) (q : Fin 4 → ℝ≥0∞)
    (htwo : MemLp (anisotropicMaximalTwo α (f 3)) (q 3) volume)
    (hfour : ∀ j : Fin 4, j ≠ 3 →
      MemLp (anisotropicMaximalFour α (f j)) (q j) volume)
    (hq0 : ∀ j : Fin 4, q j ≠ 0) (hqtop : ∀ j : Fin 4, q j ≠ ∞) :
    ∀ (j : Fin 4) (m : ℤ),
      volume (sourceStoppingMaximalLevelSetAt α f j m) ≠ ∞ := by
  apply sourceStopping_coordinateLevel_finite_of_memLp α f q ?_ hq0 hqtop
  intro j
  by_cases hj : j = 3
  · simpa only [sourceStoppingMaximal, hj, ↓reduceIte] using htwo
  · simpa only [sourceStoppingMaximal, hj, ↓reduceIte] using hfour j hj

/-- A tail estimate for the two-maximal branch and the fourth-maximal branch
gives the corresponding tail estimate for the literal stopping maximal. -/
theorem tendsto_sourceStoppingMaximal_of_tails
    (α : Anisotropy) (f : ModelRealInput)
    (htwo : Tendsto (anisotropicMaximalTwo α (f 3))
      (cocompact E3) (𝓝 0))
    (hfour : ∀ j : Fin 4, j ≠ 3 →
      Tendsto (anisotropicMaximalFour α (f j))
        (cocompact E3) (𝓝 0)) :
    ∀ j : Fin 4, Tendsto (sourceStoppingMaximal α f j)
      (cocompact E3) (𝓝 0) := by
  intro j
  by_cases hj : j = 3
  · simpa only [sourceStoppingMaximal, hj, ↓reduceIte] using htwo
  · simpa only [sourceStoppingMaximal, hj, ↓reduceIte] using hfour j hj

/-- The exact stopping-time finiteness interface obtained from spatial tail
estimates for the two and fourth anisotropic maximal functions. -/
theorem sourceStopping_coordinateLevel_finite_of_maximal_tails
    (α : Anisotropy) (f : ModelRealInput)
    (htwo : Tendsto (anisotropicMaximalTwo α (f 3))
      (cocompact E3) (𝓝 0))
    (hfour : ∀ j : Fin 4, j ≠ 3 →
      Tendsto (anisotropicMaximalFour α (f j))
        (cocompact E3) (𝓝 0)) :
    ∀ (j : Fin 4) (m : ℤ),
      volume (sourceStoppingMaximalLevelSetAt α f j m) ≠ ∞ := by
  intro j m
  apply sourceStoppingMaximalLevelSetAt_finite_of_tendsto_zero
  exact tendsto_sourceStoppingMaximal_of_tails α f htwo hfour j

/-- A bounded continuous input which is nonzero at one point has strictly
positive exponent-two local size on every literal box. -/
theorem boxLocalSize_two_pos_of_continuous_nonzero
    (α : Anisotropy) (q : AnisoBox α) (f : E3 → ℝ)
    (hcont : Continuous f)
    (hbound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f y| ≤ C)
    {y : E3} (hy : f y ≠ 0) :
    0 < boxLocalSize α 2 f q := by
  let K : E3 → ℝ :=
    anisotropicBracketKernel α (boxLength q) (boxCenter α q)
  let g : E3 → ℝ := fun z ↦ |f z| ^ (2 : ℝ) * K z
  have hgcont : Continuous g :=
    (hcont.abs.rpow_const (fun _ ↦ Or.inr (by norm_num))).mul
      (continuous_anisotropicBracketKernel α (boxLength_pos q)
        (boxCenter α q))
  have hgint : Integrable g := by
    rcases hbound with ⟨C, hC, hbound⟩
    have hK : Integrable K :=
      integrable_anisotropicBracketKernel α (boxLength_pos q) (boxCenter α q)
    refine (hK.const_mul (C ^ (2 : ℝ))).mono hgcont.aestronglyMeasurable ?_
    filter_upwards [] with z
    have hpow : |f z| ^ (2 : ℝ) ≤ C ^ (2 : ℝ) :=
      Real.rpow_le_rpow (abs_nonneg _) (hbound z) (by norm_num)
    have hKnonneg : 0 ≤ K z :=
      anisotropicBracketKernel_nonneg α (boxLength_pos q).le (boxCenter α q) z
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg
      (Real.rpow_nonneg (abs_nonneg _) _) hKnonneg),
      Real.norm_eq_abs, abs_of_nonneg (mul_nonneg
        (Real.rpow_nonneg hC _) hKnonneg)]
    exact mul_le_mul_of_nonneg_right hpow hKnonneg
  have hgnonneg : 0 ≤ g := by
    intro z
    exact mul_nonneg (Real.rpow_nonneg (abs_nonneg (f z)) _)
      (anisotropicBracketKernel_nonneg α (boxLength_pos q).le
        (boxCenter α q) z)
  have hgpoint : g y ≠ 0 := by
    apply mul_ne_zero
    · exact (Real.rpow_pos_of_pos (abs_pos.mpr hy) _).ne'
    · exact (anisotropicBracketKernel_pos α (boxLength_pos q)
        (boxCenter α q) y).ne'
  have hpower : 0 < boxLocalPower α 2 f q := by
    change 0 < ∫ z : E3, g z
    exact integral_pos_of_integrable_nonneg_nonzero hgcont hgint hgnonneg hgpoint
  unfold boxLocalSize
  exact Real.rpow_pos_of_pos hpower _

/-- Function-level nonvanishing supplies the point witness required for the
positive exponent-two local-size lemma. -/
theorem boxLocalSize_two_pos_of_continuous_ne_zero
    (α : Anisotropy) (q : AnisoBox α) (f : E3 → ℝ)
    (hcont : Continuous f)
    (hbound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f y| ≤ C)
    (hne : f ≠ 0) :
    0 < boxLocalSize α 2 f q := by
  have hwitness : ∃ y, f y ≠ 0 := by
    by_contra h
    apply hne
    funext y
    by_contra hy
    exact h ⟨y, hy⟩
  rcases hwitness with ⟨y, hy⟩
  exact boxLocalSize_two_pos_of_continuous_nonzero
    α q f hcont hbound hy

/-- Function-level nonvanishing also gives positive exponent-four local
size through the existing fourth-power local-size lemma. -/
theorem boxLocalSize_four_pos_of_continuous_ne_zero
    (α : Anisotropy) (q : AnisoBox α) (f : E3 → ℝ)
    (hcont : Continuous f)
    (hbound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f y| ≤ C)
    (hne : f ≠ 0) :
    0 < boxLocalSize α 4 f q := by
  have hwitness : ∃ y, f y ≠ 0 := by
    by_contra h
    apply hne
    funext y
    by_contra hy
    exact h ⟨y, hy⟩
  rcases hwitness with ⟨y, hy⟩
  exact boxLocalSize_four_pos_of_continuous_nonzero
    α q f hcont hbound hy

/-- Strict positivity propagates from a box local size to its ancestor
stopping datum. -/
theorem stoppingData_pos_of_boxLocalSize_pos
    (α : Anisotropy) (S : BoxCollection α) (s : ℝ) (f : E3 → ℝ)
    {q : AnisoBox α} (hq : q ∈ S)
    (hpos : 0 < boxLocalSize α s f q) :
    0 < stoppingData α S s f q := by
  exact lt_of_lt_of_le hpos (boxLocalSize_le_stoppingData α S s f hq)

/-- A bounded continuous input nonzero somewhere has positive exponent-two
stopping data at every box of the ambient finite collection. -/
theorem stoppingData_two_pos_of_continuous_nonzero
    (α : Anisotropy) (S : BoxCollection α) (f : E3 → ℝ)
    (hcont : Continuous f)
    (hbound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f y| ≤ C)
    {y : E3} (hy : f y ≠ 0)
    {q : AnisoBox α} (hq : q ∈ S) :
    0 < stoppingData α S 2 f q := by
  apply stoppingData_pos_of_boxLocalSize_pos α S 2 f hq
  exact boxLocalSize_two_pos_of_continuous_nonzero
    α q f hcont hbound hy

/-- The function-level form of positivity for exponent-two stopping data. -/
theorem stoppingData_two_pos_of_continuous_ne_zero
    (α : Anisotropy) (S : BoxCollection α) (f : E3 → ℝ)
    (hcont : Continuous f)
    (hbound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f y| ≤ C)
    (hne : f ≠ 0)
    {q : AnisoBox α} (hq : q ∈ S) :
    0 < stoppingData α S 2 f q := by
  apply stoppingData_pos_of_boxLocalSize_pos α S 2 f hq
  exact boxLocalSize_two_pos_of_continuous_ne_zero
    α q f hcont hbound hne

/-- A bounded continuous input nonzero somewhere has positive exponent-four
stopping data at every box of the ambient finite collection. -/
theorem stoppingData_four_pos_of_continuous_nonzero
    (α : Anisotropy) (S : BoxCollection α) (f : E3 → ℝ)
    (hcont : Continuous f)
    (hbound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f y| ≤ C)
    {y : E3} (hy : f y ≠ 0)
    {q : AnisoBox α} (hq : q ∈ S) :
    0 < stoppingData α S 4 f q := by
  apply stoppingData_pos_of_boxLocalSize_pos α S 4 f hq
  exact boxLocalSize_four_pos_of_continuous_nonzero α q f hcont hbound hy

/-- The function-level form of positivity for exponent-four stopping data. -/
theorem stoppingData_four_pos_of_continuous_ne_zero
    (α : Anisotropy) (S : BoxCollection α) (f : E3 → ℝ)
    (hcont : Continuous f)
    (hbound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f y| ≤ C)
    (hne : f ≠ 0)
    {q : AnisoBox α} (hq : q ∈ S) :
    0 < stoppingData α S 4 f q := by
  apply stoppingData_pos_of_boxLocalSize_pos α S 4 f hq
  exact boxLocalSize_four_pos_of_continuous_ne_zero
    α q f hcont hbound hne

/-- Coordinatewise nonzero bounded continuous source inputs provide the
strict stopping-data premise required by the active source stopping forest. -/
theorem sourceStoppingData_pos_of_boundedContinuous_nonzero
    (α : Anisotropy) (S : BoxCollection α) (f : ModelRealInput)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f j y| ≤ C)
    (hnonzero : ∀ j, ∃ y, f j y ≠ 0)
    {q : AnisoBox α} (hq : q ∈ S) (j : Fin 4) :
    0 < stoppingData α S (sourceStoppingExponent j) (f j) q := by
  rcases hnonzero j with ⟨y, hy⟩
  by_cases hj : j = 3
  · subst j
    simpa [sourceStoppingExponent] using
      stoppingData_two_pos_of_continuous_nonzero
        α S (f 3) (hcont 3) (hbound 3) hy hq
  · simpa [sourceStoppingExponent, hj] using
      stoppingData_four_pos_of_continuous_nonzero
        α S (f j) (hcont j) (hbound j) hy hq

/-- A version of the active-source stopping positivity lemma stated with
function-level coordinatewise nonvanishing. -/
theorem sourceStoppingData_pos_of_boundedContinuous_ne_zero
    (α : Anisotropy) (S : BoxCollection α) (f : ModelRealInput)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f j y| ≤ C)
    (hnonzero : ∀ j, f j ≠ 0)
    {q : AnisoBox α} (hq : q ∈ S) (j : Fin 4) :
    0 < stoppingData α S (sourceStoppingExponent j) (f j) q := by
  by_cases hj : j = 3
  · subst j
    simpa [sourceStoppingExponent] using
      stoppingData_two_pos_of_continuous_ne_zero
        α S (f 3) (hcont 3) (hbound 3) (hnonzero 3) hq
  · simpa [sourceStoppingExponent, hj] using
      stoppingData_four_pos_of_continuous_ne_zero
        α S (f j) (hcont j) (hbound j) (hnonzero j) hq

/-- The active-forest premise itself, with all finite-collection boxes and
all four source coordinates quantified in its consumer-facing order. -/
theorem sourceStoppingData_all_pos_of_boundedContinuous_ne_zero
    (α : Anisotropy) (S : BoxCollection α) (f : ModelRealInput)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |f j y| ≤ C)
    (hnonzero : ∀ j, f j ≠ 0) :
    ∀ q ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) q := by
  intro q hq j
  exact sourceStoppingData_pos_of_boundedContinuous_ne_zero
    α S f hcont hbound hnonzero hq j

/-- Nonzero real Schwartz components supply the literal positive stopping
data premise for every finite source collection. -/
theorem initialModel_sourceStoppingData_all_pos_of_ne_zero
    (α : Anisotropy) (S : BoxCollection α) (F : InitialModelSchwartzInput)
    (hFnonzero : ∀ j, F j ≠ 0) :
    ∀ q ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j)
        (InitialModelRealInput F j) q := by
  apply sourceStoppingData_all_pos_of_boundedContinuous_ne_zero
    α S (InitialModelRealInput F)
    (initialModelRealInput_continuous F) (initialModelRealInput_bounded F)
  intro j hzero
  apply hFnonzero j
  ext y
  exact congr_fun hzero y


/-- The finite active stopping-forest estimate for a nonzero real Schwartz
tuple, with all local analytic and stopping-positivity premises discharged. -/
theorem activeStoppingForest_bound_of_realSchwartz_auto_of_ne_zero
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (F : InitialModelSchwartzInput)
    (q σ : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (hFnonzero : ∀ j, F j ≠ 0)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hfinite : ∀ (j : Fin 4) (m : ℤ),
      volume (sourceStoppingMaximalLevelSetAt α
        (InitialModelRealInput F) j m) ≠ ∞) :
    ∃ C : ℝ, 0 ≤ C ∧
      |expandedModelLocalForm α S u c (InitialModelRealInput F)| ≤
        C * sourceWeight u ^ 75 *
          SourceStoppingCoordinateEnvelope α S
            (InitialModelRealInput F) q σ
              (initialModel_sourceStoppingData_all_pos_of_ne_zero
                α S F hFnonzero) := by
  exact activeStoppingForest_bound_of_realSchwartz_auto
    α S hS u c F q σ hq
    (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero)
    hcmeas hc hfinite

/-- The finite real-Schwartz active stopping-forest estimate follows from
the branchwise finite-exponent maximal estimates of the source maximal-size
lemma. Thus only those maximal `L^p` estimates remain analytic input. -/
theorem activeStoppingForest_bound_of_realSchwartz_auto_of_ne_zero_of_branch_memLp
    (α : Anisotropy) (S : BoxCollection α) (hS : IsConvexCollection α S)
    (u : E3) (c : ℝ → ℝ) (F : InitialModelSchwartzInput)
    (q σ : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (hFnonzero : ∀ j, F j ≠ 0)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1)
    (p : Fin 4 → ℝ≥0∞)
    (htwo : MemLp (anisotropicMaximalTwo α (InitialModelRealInput F 3))
      (p 3) volume)
    (hfour : ∀ j : Fin 4, j ≠ 3 →
      MemLp (anisotropicMaximalFour α (InitialModelRealInput F j))
        (p j) volume)
    (hp0 : ∀ j : Fin 4, p j ≠ 0)
    (hptop : ∀ j : Fin 4, p j ≠ ∞) :
    ∃ C : ℝ, 0 ≤ C ∧
      |expandedModelLocalForm α S u c (InitialModelRealInput F)| ≤
        C * sourceWeight u ^ 75 *
          SourceStoppingCoordinateEnvelope α S
            (InitialModelRealInput F) q σ
              (initialModel_sourceStoppingData_all_pos_of_ne_zero
                α S F hFnonzero) := by
  apply activeStoppingForest_bound_of_realSchwartz_auto_of_ne_zero
    α S hS u c F q σ hq hFnonzero hcmeas hc
  exact sourceStopping_coordinateLevel_finite_of_branch_memLp
    α (InitialModelRealInput F) p htwo hfour hp0 hptop

/-- A vanishing first input annihilates the three-input local fiber. -/
theorem modelFirstFiber_eq_zero_of_input_zero
    (α : Anisotropy) (f : ModelRealInput) (p : E3) (t : ℝ) (z : ModelE5)
    (hzero : f 0 = 0) :
    modelFirstFiber α f p t z = 0 := by
  unfold modelFirstFiber
  rw [hzero]
  simp

/-- A vanishing second input annihilates the three-input local fiber. -/
theorem modelFirstFiber_eq_zero_of_input_one
    (α : Anisotropy) (f : ModelRealInput) (p : E3) (t : ℝ) (z : ModelE5)
    (hzero : f 1 = 0) :
    modelFirstFiber α f p t z = 0 := by
  unfold modelFirstFiber
  rw [hzero]
  simp

/-- A vanishing third input annihilates the three-input local fiber. -/
theorem modelFirstFiber_eq_zero_of_input_two
    (α : Anisotropy) (f : ModelRealInput) (p : E3) (t : ℝ) (z : ModelE5)
    (hzero : f 2 = 0) :
    modelFirstFiber α f p t z = 0 := by
  unfold modelFirstFiber
  rw [hzero]
  simp

/-- A vanishing fourth input annihilates the one-input local fiber. -/
theorem modelSecondFiber_eq_zero_of_input_zero
    (α : Anisotropy) (f : E3 → ℝ) (p : E3) (t : ℝ) (z : ModelE5)
    (hzero : f = 0) :
    modelSecondFiber α f p t z = 0 := by
  unfold modelSecondFiber
  rw [hzero]
  simp

/-- Any zero component of the real model input annihilates its expanded
local form on every finite box collection. -/
theorem expandedModelLocalForm_eq_zero_of_component_eq_zero
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (j : Fin 4) (hzero : f j = 0) :
    expandedModelLocalForm α S u c f = 0 := by
  fin_cases j
  · unfold expandedModelLocalForm
    simp_rw [modelFirstFiber_eq_zero_of_input_zero α f _ _ _ hzero]
    simp
  · unfold expandedModelLocalForm
    simp_rw [modelFirstFiber_eq_zero_of_input_one α f _ _ _ hzero]
    simp
  · unfold expandedModelLocalForm
    simp_rw [modelFirstFiber_eq_zero_of_input_two α f _ _ _ hzero]
    simp
  · unfold expandedModelLocalForm
    simp_rw [modelSecondFiber_eq_zero_of_input_zero α (f 3) _ _ _ hzero]
    simp

/-- The finite dyadic local form is zero whenever a real input component is
zero. This is the zero branch needed before invoking strict stopping-data
positivity. -/
theorem expandedModelLocalForm_truncation_eq_zero_of_component_eq_zero
    (α : Anisotropy) (N : ℕ) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (j : Fin 4) (hzero : f j = 0) :
    expandedModelLocalForm α (truncationCollection α N) u c f = 0 := by
  exact expandedModelLocalForm_eq_zero_of_component_eq_zero
    α (truncationCollection α N) u c f j hzero

/-- Any zero Schwartz component annihilates the unexpanded fixed-scale
spatial model integrand. -/
theorem ModelSpatialIntegrand_eq_zero_of_component_eq_zero
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput)
    (t : ℝ) (x : E3) (j : Fin 4) (hzero : F j = 0) :
    ModelSpatialIntegrand α u F t x = 0 := by
  fin_cases j <;> simp only [Fin.zero_eta, Fin.isValue, Fin.mk_one, Fin.reduceFinMk] at hzero
  all_goals unfold ModelSpatialIntegrand
  · rw [hzero]
    simp
  · rw [hzero]
    simp [ModelCoordinateConvolution]
  · rw [hzero]
    simp [ModelCoordinateConvolution]
  · rw [hzero]
    simp [ModelCoordinateConvolution]

/-- A zero Schwartz component annihilates the spatial profile at every
scale. -/
theorem ModelSpatialProfile_eq_zero_of_component_eq_zero
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput)
    (t : ℝ) (j : Fin 4) (hzero : F j = 0) :
    ModelSpatialProfile α u F t = 0 := by
  unfold ModelSpatialProfile
  simp_rw [ModelSpatialIntegrand_eq_zero_of_component_eq_zero
    α u F t _ j hzero]
  simp

/-- A zero Schwartz component annihilates the full model form. -/
theorem ModelFullForm_eq_zero_of_component_eq_zero
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (j : Fin 4) (hzero : F j = 0) :
    ModelFullForm α u c F = 0 := by
  unfold ModelFullForm
  simp_rw [ModelSpatialProfile_eq_zero_of_component_eq_zero
    α u F _ j hzero]
  simp

/-- A zero Schwartz component annihilates every finite-scale truncation of
the unexpanded model form. -/
theorem ModelScaleTruncation_eq_zero_of_component_eq_zero
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (N : ℕ) (j : Fin 4) (hzero : F j = 0) :
    ModelScaleTruncation α u c F N = 0 := by
  unfold ModelScaleTruncation
  simp_rw [ModelSpatialProfile_eq_zero_of_component_eq_zero
    α u F _ j hzero]
  simp

/-- Passing a zero Schwartz component to the real finite-forest input keeps
it identically zero. -/
theorem InitialModelRealInput_component_eq_zero_of_component_eq_zero
    (F : InitialModelSchwartzInput) (j : Fin 4) (hzero : F j = 0) :
    InitialModelRealInput F j = 0 := by
  change (F j : E3 → ℝ) = 0
  rw [hzero]
  rfl

/-- The expanded finite forest form for the real input of a Schwartz tuple
vanishes in the same zero-component branch. -/
theorem expandedModelLocalForm_initialModel_eq_zero_of_component_eq_zero
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (F : InitialModelSchwartzInput) (j : Fin 4) (hzero : F j = 0) :
    expandedModelLocalForm α S u c (InitialModelRealInput F) = 0 := by
  apply expandedModelLocalForm_eq_zero_of_component_eq_zero
    α S u c (InitialModelRealInput F) j
  exact InitialModelRealInput_component_eq_zero_of_component_eq_zero
    F j hzero

/-- The low-frequency kernel in the spatial profile is strongly measurable
in its output coordinate. -/
theorem stronglyMeasurable_ModelLowKernel (u : ℝ) :
    StronglyMeasurable (ModelLowKernel u) := by
  have hgauss : Measurable (fun wz : ℝ × ℝ ↦ gaussian wz.2) :=
    gaussian_contDiff.continuous.measurable.comp measurable_snd
  have hphi : Measurable (fun wz : ℝ × ℝ ↦
      conePhiPhysicalReal (wz.1 - wz.2 - u)) :=
    conePhiPhysicalReal.continuous.measurable.comp
      ((measurable_fst.sub measurable_snd).sub measurable_const)
  have hjoint : StronglyMeasurable (fun wz : ℝ × ℝ ↦
      gaussian wz.2 * conePhiPhysicalReal (wz.1 - wz.2 - u)) :=
    (hgauss.mul hphi).stronglyMeasurable
  change StronglyMeasurable (fun w : ℝ ↦
    ∫ z : ℝ, gaussian z * conePhiPhysicalReal (w - z - u))
  exact hjoint.integral_prod_right'

/-- The translated third-coordinate kernel is strongly measurable in its
spatial variable, before the outer Gaussian-derivative convolution. -/
theorem stronglyMeasurable_modelThirdKernel
    (u s p : ℝ) : StronglyMeasurable (modelThirdKernel u s p) := by
  have hderiv : Measurable gaussianDeriv := by
    unfold gaussianDeriv
    exact (measurable_const.mul measurable_id).mul
      gaussian_contDiff.continuous.measurable
  have hpsi : Measurable (fun wz : ℝ × ℝ ↦
      conePsiPhysicalReal (wz.1 - wz.2 + u)) :=
    conePsiPhysicalReal.continuous.measurable.comp
      ((measurable_fst.sub measurable_snd).add measurable_const)
  have hjoint : StronglyMeasurable (fun wz : ℝ × ℝ ↦
      gaussianDeriv wz.2 * conePsiPhysicalReal (wz.1 - wz.2 + u)) :=
    ((hderiv.comp measurable_snd).mul hpsi).stronglyMeasurable
  have hinter : StronglyMeasurable (fun w : ℝ ↦
      ∫ z : ℝ, gaussianDeriv z * conePsiPhysicalReal (w - z + u)) :=
    hjoint.integral_prod_right'
  unfold modelThirdKernel kernelAt kernelDilate
  change StronglyMeasurable (fun y : ℝ ↦
    s⁻¹ * (∫ z : ℝ,
      gaussianDeriv z * conePsiPhysicalReal (((y - p) / s) - z + u)))
  exact (hinter.comp_measurable
    ((measurable_id.sub measurable_const).div measurable_const)).const_mul s⁻¹

/-- The outer third-coordinate kernel in the profile is strongly measurable. -/
theorem stronglyMeasurable_ModelThirdKernel (u : ℝ) :
    StronglyMeasurable (ModelThirdKernel u) := by
  have hderiv : Measurable gaussianDeriv := by
    unfold gaussianDeriv
    exact (measurable_const.mul measurable_id).mul
      gaussian_contDiff.continuous.measurable
  have hthird : StronglyMeasurable (modelThirdKernel (-u) 1 0) :=
    stronglyMeasurable_modelThirdKernel (-u) 1 0
  have hjoint : StronglyMeasurable (fun wz : ℝ × ℝ ↦
      gaussianDeriv wz.2 * modelThirdKernel (-u) 1 0 (wz.1 - wz.2)) :=
    (hderiv.comp measurable_snd).stronglyMeasurable.mul
      (hthird.comp_measurable (measurable_fst.sub measurable_snd))
  change StronglyMeasurable (fun w : ℝ ↦
    ∫ z : ℝ, gaussianDeriv z * modelThirdKernel (-u) 1 0 (w - z))
  exact hjoint.integral_prod_right'

/-- The two profile kernels are Borel measurable, in forms convenient for
the coordinate-convolution measurability lemma. -/
theorem measurable_ModelLowKernel (u : ℝ) :
    Measurable (ModelLowKernel u) :=
  (stronglyMeasurable_ModelLowKernel u).measurable

theorem measurable_ModelThirdKernel (u : ℝ) :
    Measurable (ModelThirdKernel u) :=
  (stronglyMeasurable_ModelThirdKernel u).measurable

/-- A coordinate convolution is jointly strongly measurable in a scale
parameter and the ambient spatial point whenever its input and kernel are
strongly measurable. -/
theorem stronglyMeasurable_modelCoordinateConvolution_joint
    (i : Fin 3) (n : ℕ) (f : E3 → ℝ) (k : ℝ → ℝ)
    (hf : Measurable f) (hk : Measurable k) :
    StronglyMeasurable (fun tx : ℝ × E3 ↦
      ModelCoordinateConvolution i f k (tx.1 ^ n) tx.2) := by
  have ht : Measurable (fun q : (ℝ × E3) × ℝ ↦ q.1.1 ^ n) :=
    (measurable_fst.comp measurable_fst).pow_const _
  have hx : Measurable (fun q : (ℝ × E3) × ℝ ↦
      q.1.2 - q.2 • Anisotropy.coordinateDirection i) := by
    exact (measurable_snd.comp measurable_fst).sub
      (measurable_snd.smul measurable_const)
  have hr : Measurable (fun q : (ℝ × E3) × ℝ ↦ q.2) := measurable_snd
  have hinput : StronglyMeasurable (fun q : (ℝ × E3) × ℝ ↦
      f (q.1.2 - q.2 • Anisotropy.coordinateDirection i)) :=
    (hf.comp hx).stronglyMeasurable
  have hkernel : StronglyMeasurable (fun q : (ℝ × E3) × ℝ ↦
      kernelDilate k (q.1.1 ^ n) q.2) := by
    unfold kernelDilate
    change StronglyMeasurable (fun q : (ℝ × E3) × ℝ ↦
      (q.1.1 ^ n)⁻¹ * k (q.2 / (q.1.1 ^ n)))
    exact (ht.inv.mul (hk.comp (hr.div ht))).stronglyMeasurable
  have hjoint : StronglyMeasurable (fun q : (ℝ × E3) × ℝ ↦
      f (q.1.2 - q.2 • Anisotropy.coordinateDirection i) *
        kernelDilate k (q.1.1 ^ n) q.2) := hinput.mul hkernel
  change StronglyMeasurable (fun tx : ℝ × E3 ↦
    ∫ r : ℝ, f (tx.2 - r • Anisotropy.coordinateDirection i) *
      kernelDilate k (tx.1 ^ n) r)
  exact hjoint.integral_prod_right'

/-- The literal spatial integrand of the full model profile is jointly
strongly measurable in scale and space for every Schwartz four-tuple. -/
theorem stronglyMeasurable_ModelSpatialIntegrand
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) :
    StronglyMeasurable (fun tx : ℝ × E3 ↦
      ModelSpatialIntegrand α u F tx.1 tx.2) := by
  have h0 : StronglyMeasurable (fun tx : ℝ × E3 ↦ F 0 tx.2) :=
    ((F 0).continuous.measurable.comp measurable_snd).stronglyMeasurable
  have h1 : StronglyMeasurable (fun tx : ℝ × E3 ↦
      ModelCoordinateConvolution 0 (F 1) (ModelLowKernel (u 0))
        (tx.1 ^ α.weight 0) tx.2) :=
    stronglyMeasurable_modelCoordinateConvolution_joint
      0 (α.weight 0) (F 1) (ModelLowKernel (u 0))
      (F 1).continuous.measurable (measurable_ModelLowKernel (u 0))
  have h2 : StronglyMeasurable (fun tx : ℝ × E3 ↦
      ModelCoordinateConvolution 1 (F 2) (ModelLowKernel (u 1))
        (tx.1 ^ α.weight 1) tx.2) :=
    stronglyMeasurable_modelCoordinateConvolution_joint
      1 (α.weight 1) (F 2) (ModelLowKernel (u 1))
      (F 2).continuous.measurable (measurable_ModelLowKernel (u 1))
  have h3 : StronglyMeasurable (fun tx : ℝ × E3 ↦
      ModelCoordinateConvolution 2 (F 3) (ModelThirdKernel (u 2))
        (tx.1 ^ α.weight 2) tx.2) :=
    stronglyMeasurable_modelCoordinateConvolution_joint
      2 (α.weight 2) (F 3) (ModelThirdKernel (u 2))
      (F 3).continuous.measurable (measurable_ModelThirdKernel (u 2))
  change StronglyMeasurable (fun tx : ℝ × E3 ↦
    F 0 tx.2 *
      ModelCoordinateConvolution 0 (F 1) (ModelLowKernel (u 0))
        (tx.1 ^ α.weight 0) tx.2 *
      ModelCoordinateConvolution 1 (F 2) (ModelLowKernel (u 1))
        (tx.1 ^ α.weight 1) tx.2 *
      ModelCoordinateConvolution 2 (F 3) (ModelThirdKernel (u 2))
        (tx.1 ^ α.weight 2) tx.2)
  exact ((h0.mul h1).mul h2).mul h3

/-- A joint strongly measurable spatial integrand has a strongly measurable
scale profile. This is the exact Fubini-measurability step needed by the
full-profile convergence bridge. -/
theorem stronglyMeasurable_modelSpatialProfile_of_joint
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput)
    (hjoint : StronglyMeasurable
      (fun tx : ℝ × E3 ↦ ModelSpatialIntegrand α u F tx.1 tx.2)) :
    StronglyMeasurable (ModelSpatialProfile α u F) := by
  change StronglyMeasurable (fun t : ℝ ↦
    ∫ x : E3, ModelSpatialIntegrand α u F t x)
  exact hjoint.integral_prod_right'

/-- Schwartz inputs make the literal spatial profile strongly measurable,
with no auxiliary integrability hypothesis: the Bochner integral uses its
standard zero convention off integrable fibers. -/
theorem stronglyMeasurable_ModelSpatialProfile
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) :
    StronglyMeasurable (ModelSpatialProfile α u F) :=
  stronglyMeasurable_modelSpatialProfile_of_joint α u F
    (stronglyMeasurable_ModelSpatialIntegrand α u F)

/-- A measurable coefficient times a jointly measurable spatial profile has
the exact a.e.-strong measurability required in the profile convergence
lemma. -/
theorem aestronglyMeasurable_modelScaleProfile_of_joint
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (hcmeas : Measurable c)
    (hjoint : StronglyMeasurable
      (fun tx : ℝ × E3 ↦ ModelSpatialIntegrand α u F tx.1 tx.2)) :
    AEStronglyMeasurable
      (fun t : ℝ ↦ c t * ModelSpatialProfile α u F t)
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))) := by
  exact hcmeas.aestronglyMeasurable.mul
    (stronglyMeasurable_modelSpatialProfile_of_joint α u F hjoint).aestronglyMeasurable

/-- This discharges the `hmeas` premise in the profile-to-full-form bridge
for every measurable bounded coefficient and every Schwartz input tuple. A
bound on `c` is not needed for measurability itself. -/
theorem aestronglyMeasurable_modelScaleProfile_of_measurable
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (hcmeas : Measurable c) :
    AEStronglyMeasurable
      (fun t : ℝ ↦ c t * ModelSpatialProfile α u F t)
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))) := by
  exact aestronglyMeasurable_modelScaleProfile_of_joint
    α u c F hcmeas
    (stronglyMeasurable_ModelSpatialIntegrand α u F)

/-- Measurability is preserved by the literal coefficient cutoff used for
finite scale bands. -/
theorem measurable_RestrictScaleCoefficient
    (c : ℝ → ℝ) (A : Set ℝ) (hcmeas : Measurable c)
    (hAmeas : MeasurableSet A) :
    Measurable (RestrictScaleCoefficient c A) := by
  unfold RestrictScaleCoefficient
  exact hcmeas.indicator hAmeas

/-- The cutoff coefficient on an arbitrary measurable scale set satisfies
the same full-profile measurability premise. -/
theorem aestronglyMeasurable_modelScaleProfile_restrict
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (A : Set ℝ) (hcmeas : Measurable c) (hAmeas : MeasurableSet A) :
    AEStronglyMeasurable
      (fun t : ℝ ↦ RestrictScaleCoefficient c A t *
        ModelSpatialProfile α u F t)
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))) := by
  exact aestronglyMeasurable_modelScaleProfile_of_measurable
    α u (RestrictScaleCoefficient c A) F
    (measurable_RestrictScaleCoefficient c A hcmeas hAmeas)

/-- In particular, every literal dyadic scale cutoff has the profile
measurability needed to invoke the finite-forest localization identity. -/
theorem aestronglyMeasurable_modelScaleProfile_truncation_restrict
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (N : ℕ) (hcmeas : Measurable c) :
    AEStronglyMeasurable
      (fun t : ℝ ↦ RestrictScaleCoefficient c (truncationScaleSet N) t *
        ModelSpatialProfile α u F t)
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))) := by
  exact aestronglyMeasurable_modelScaleProfile_restrict
    α u c F (truncationScaleSet N) hcmeas measurableSet_Ioc

/-- The low-frequency physical kernel is integrable. This is the large-scale
input for the model profile, after its fixed translation in `u`. -/
theorem integrable_ModelLowKernel (u : ℝ) :
    Integrable (ModelLowKernel u) := by
  let K : ℝ → ℝ := gaussian ⋆[ContinuousLinearMap.mul ℝ ℝ] conePhiPhysicalReal
  have hK : Integrable K :=
    integrable_gaussian.integrable_convolution (ContinuousLinearMap.mul ℝ ℝ)
      conePhiPhysicalReal.integrable
  have hshift : Integrable (fun w : ℝ ↦ K (w - u)) := hK.comp_sub_right u
  apply hshift.congr
  filter_upwards [] with w
  dsimp only [K]
  rw [convolution_mul]
  unfold ModelLowKernel
  apply integral_congr_ae
  filter_upwards [] with z
  congr 1
  ring

/-- At unit scale the signed third-coordinate kernel is a translated ordinary
convolution. The equality keeps its sign convention explicit. -/
theorem modelThirdKernel_unit_eq_convolution (u w : ℝ) :
    modelThirdKernel (-u) 1 0 w =
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal) (w - u) := by
  unfold modelThirdKernel kernelAt kernelDilate
  simp only [inv_one, one_smul]
  rw [convolution_mul]
  apply integral_congr_ae
  filter_upwards [] with z
  congr 1
  ring

/-- The unit-scale third-coordinate factor is integrable in its spatial
argument. -/
theorem integrable_modelThirdKernel_unit (u : ℝ) :
    Integrable (modelThirdKernel (-u) 1 0) := by
  let K : ℝ → ℝ := gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal
  have hK : Integrable K :=
    integrable_gaussianDeriv.integrable_convolution (ContinuousLinearMap.mul ℝ ℝ)
      conePsiPhysicalReal.integrable
  have hshift : Integrable (fun w : ℝ ↦ K (w - u)) := hK.comp_sub_right u
  apply hshift.congr
  filter_upwards [] with w
  dsimp only [K]
  exact (modelThirdKernel_unit_eq_convolution u w).symm

/-- The full third model kernel is integrable: it is one more convolution by
the Gaussian derivative of the preceding unit-scale factor. -/
theorem integrable_ModelThirdKernel (u : ℝ) :
    Integrable (ModelThirdKernel u) := by
  let G : ℝ → ℝ := modelThirdKernel (-u) 1 0
  let K : ℝ → ℝ := gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] G
  have hG : Integrable G := by
    simpa only [G] using integrable_modelThirdKernel_unit u
  have hK : Integrable K :=
    integrable_gaussianDeriv.integrable_convolution (ContinuousLinearMap.mul ℝ ℝ) hG
  apply hK.congr
  filter_upwards [] with w
  dsimp only [K, G]
  rw [convolution_mul]
  rfl

/-- The third model kernel has mean zero. Its outer Gaussian-derivative
factor is enough; no cancellation is lost in the translated inner kernel. -/
theorem integral_ModelThirdKernel (u : ℝ) :
    ∫ w : ℝ, ModelThirdKernel u w = 0 := by
  let G : ℝ → ℝ := modelThirdKernel (-u) 1 0
  let K : ℝ → ℝ := gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] G
  have hG : Integrable G := by
    simpa only [G] using integrable_modelThirdKernel_unit u
  have hK : Integrable K :=
    integrable_gaussianDeriv.integrable_convolution (ContinuousLinearMap.mul ℝ ℝ) hG
  have hEq : ModelThirdKernel u = K := by
    funext w
    dsimp only [K, G]
    rw [convolution_mul]
    rfl
  calc
    (∫ w : ℝ, ModelThirdKernel u w) = ∫ w : ℝ, K w := by rw [hEq]
    _ = (ContinuousLinearMap.mul ℝ ℝ)
        (∫ w : ℝ, gaussianDeriv w) (∫ w : ℝ, G w) :=
      integral_convolution (ContinuousLinearMap.mul ℝ ℝ) integrable_gaussianDeriv hG
    _ = 0 := by rw [integral_gaussianDeriv]; simp

/-- Positive normalized dilation preserves absolute `L¹` mass for an arbitrary
real kernel. This packages the recurring change of variables needed for the
three model coordinate convolutions. -/
theorem integral_abs_kernelDilate (k : ℝ → ℝ) {s : ℝ} (hs : 0 < s) :
    ∫ x : ℝ, |kernelDilate k s x| = ∫ x : ℝ, |k x| := by
  unfold kernelDilate
  have hinv : 0 ≤ s⁻¹ := (inv_pos.mpr hs).le
  calc
    (∫ x : ℝ, |s⁻¹ • k (x / s)|) =
        ∫ x : ℝ, s⁻¹ • |k (x / s)| := by
          apply integral_congr_ae
          filter_upwards [] with x
          simp only [smul_eq_mul, abs_mul, abs_of_nonneg hinv]
    _ = s⁻¹ • ∫ x : ℝ, |k (x / s)| := by
          rw [integral_smul]
    _ = _ := by
      rw [Measure.integral_comp_div (fun x : ℝ ↦ |k x|) s]
      simp [smul_eq_mul, abs_of_pos hs, hs.ne']

/-- An integrable kernel remains absolutely integrable after a positive
normalized dilation. -/
theorem integrable_abs_kernelDilate (k : ℝ → ℝ) (hk : Integrable k)
    {s : ℝ} (hs : 0 < s) :
    Integrable (fun x : ℝ ↦ |kernelDilate k s x|) := by
  have hbase : Integrable (fun x : ℝ ↦ |k x|) := by
    simpa only [Real.norm_eq_abs] using hk.norm
  unfold kernelDilate
  refine ((hbase.comp_div hs.ne').smul (s⁻¹ : ℝ)).congr ?_
  filter_upwards [] with x
  simp only [Pi.smul_apply, smul_eq_mul, abs_mul,
    abs_of_pos (inv_pos.mpr hs)]

/-- A bounded continuous input convolved in one coordinate with an
integrable kernel is uniformly controlled by the absolute kernel mass. -/
theorem abs_ModelCoordinateConvolution_le
    (i : Fin 3) (f : E3 → ℝ) (k : ℝ → ℝ) (s : ℝ) (x : E3)
    (hfcont : Continuous f) (B : ℝ) (hf : ∀ y : E3, |f y| ≤ B)
    (hk : Integrable k) (hs : 0 < s) :
    |ModelCoordinateConvolution i f k s x| ≤ B * ∫ r : ℝ, |k r| := by
  let G : ℝ → ℝ := fun r ↦
    f (x - r • Anisotropy.coordinateDirection i) * kernelDilate k s r
  have hmap : Continuous (fun r : ℝ ↦
      x - r • Anisotropy.coordinateDirection i) :=
    continuous_const.sub (continuous_id.smul continuous_const)
  have hkd : Integrable (kernelDilate k s) := by
    unfold kernelDilate
    exact (hk.comp_div hs.ne').smul (s⁻¹ : ℝ)
  have hGmeas : AEStronglyMeasurable G volume :=
    ((hfcont.comp hmap).aestronglyMeasurable.mul hkd.aestronglyMeasurable)
  have hK : Integrable (fun r : ℝ ↦ |kernelDilate k s r|) :=
    integrable_abs_kernelDilate k hk hs
  have hupper : Integrable (fun r : ℝ ↦ B * |kernelDilate k s r|) :=
    hK.const_mul B
  have hG : Integrable G := by
    apply Integrable.mono' hupper hGmeas
    filter_upwards [] with r
    dsimp [G]
    rw [abs_mul]
    exact mul_le_mul_of_nonneg_right (hf _) (abs_nonneg _)
  unfold ModelCoordinateConvolution
  change |∫ r : ℝ, G r| ≤ _
  calc
    |∫ r : ℝ, G r| ≤ ∫ r : ℝ, |G r| :=
      MeasureTheory.abs_integral_le_integral_abs
    _ ≤ ∫ r : ℝ, B * |kernelDilate k s r| := by
      apply integral_mono hG.norm hupper
      intro r
      dsimp [G]
      rw [abs_mul]
      exact mul_le_mul_of_nonneg_right (hf _) (abs_nonneg _)
    _ = B * ∫ r : ℝ, |k r| := by
      rw [integral_const_mul, integral_abs_kernelDilate k hs]

/-- Integrating the low-frequency center pair produces the physical
low-frequency kernel at the difference coordinate. -/
theorem integral_modelPhiAt_mul_gaussianAt_center
    (s u x y : ℝ) (hs : 0 < s) :
    (∫ p : ℝ,
      modelPhiAt s (p + s * u) x * gaussianAt s p y) =
      kernelDilate (ModelLowKernel u) s (x - y) := by
  let w : ℝ := (x - y) / s
  let G : ℝ → ℝ := fun z ↦
    gaussian z * conePhiPhysicalReal (w - z - u)
  have hpoint (p : ℝ) :
      modelPhiAt s (p + s * u) x * gaussianAt s p y =
        s⁻¹ * s⁻¹ * G ((p - y) / s) := by
    dsimp only [G, w]
    unfold modelPhiAt gaussianAt kernelAt kernelDilate
    simp only [smul_eq_mul]
    rw [show (x - (p + s * u)) / s =
        (x - y) / s - (p - y) / s - u by field_simp; ring,
      show (y - p) / s = -((p - y) / s) by ring,
      gaussian_even]
    ring
  calc
    (∫ p : ℝ, modelPhiAt s (p + s * u) x * gaussianAt s p y) =
        ∫ p : ℝ, s⁻¹ * s⁻¹ * G ((p - y) / s) := by
          apply integral_congr_ae
          filter_upwards [] with p
          exact hpoint p
    _ = s⁻¹ * s⁻¹ * ∫ p : ℝ, G ((p - y) / s) := by
          rw [integral_const_mul]
    _ = s⁻¹ * s⁻¹ * (s * ∫ z : ℝ, G z) := by
          rw [integral_sub_right_eq_self (μ := volume)
            (fun p : ℝ ↦ G (p / s)) y,
            Measure.integral_comp_div]
          simp only [smul_eq_mul, abs_of_pos hs]
    _ = kernelDilate (ModelLowKernel u) s (x - y) := by
          dsimp only [G, w]
          unfold ModelLowKernel kernelDilate
          simp only [smul_eq_mul]
          field_simp

/-- Reflecting the center in the third model kernel switches the translation
parameter and contributes the odd Gaussian-derivative sign. -/
theorem modelThirdKernel_reflect
    (u r : ℝ) :
    modelThirdKernel u 1 0 (-r) =
      -modelThirdKernel (-u) 1 0 r := by
  let H : ℝ → ℝ := fun z ↦
    gaussianDeriv z * conePsiPhysicalReal (r - z - u)
  have hneg : MeasurePreserving (fun z : ℝ ↦ -z) volume volume :=
    Measure.measurePreserving_neg (volume : Measure ℝ)
  have hchange : (∫ z : ℝ, H (-z)) = ∫ z : ℝ, H z :=
    hneg.integral_comp (Homeomorph.neg ℝ).measurableEmbedding H
  unfold modelThirdKernel kernelAt kernelDilate
  simp only [inv_one, one_smul, sub_zero, div_one]
  calc
    (∫ z : ℝ, gaussianDeriv z * conePsiPhysicalReal ((-r) - z + u)) =
        -(∫ z : ℝ, H (-z)) := by
          rw [← integral_neg]
          apply integral_congr_ae
          filter_upwards [] with z
          dsimp only [H]
          rw [gaussianDeriv_neg,
            show -r - z + u = -(r + z - u) by ring,
            conePsiPhysicalReal_even]
          ring_nf
    _ = -(∫ z : ℝ, H z) := by rw [hchange]
    _ = -∫ z : ℝ,
        gaussianDeriv z * conePsiPhysicalReal (r - z + (-u)) := by
          dsimp only [H]
          congr 2

/-- Separating the normalized scale from the unit-scale third kernel. -/
theorem modelThirdKernel_eq_scale_dilate
    (u s p y : ℝ) :
    modelThirdKernel u s p y =
      s⁻¹ * modelThirdKernel u 1 0 ((y - p) / s) := by
  unfold modelThirdKernel kernelAt kernelDilate
  simp only [smul_eq_mul, inv_one, one_mul, sub_zero, div_one]

/-- Integrating the derivative/third-kernel center pair gives the third
physical convolution kernel, with its source-mandated minus sign. -/
theorem integral_gaussianDerivAt_mul_modelThirdKernel_center
    (s u x y : ℝ) (hs : 0 < s) :
    (∫ p : ℝ,
      gaussianDerivAt s p x * modelThirdKernel u s p y) =
      -kernelDilate (ModelThirdKernel u) s (x - y) := by
  let w : ℝ := (x - y) / s
  let G : ℝ → ℝ := fun z ↦
    gaussianDeriv z * modelThirdKernel (-u) 1 0 (w - z)
  have hpoint (p : ℝ) :
      gaussianDerivAt s p x * modelThirdKernel u s p y =
        -(s⁻¹ * s⁻¹) * G ((x - p) / s) := by
    rw [modelThirdKernel_eq_scale_dilate]
    dsimp only [G, w]
    unfold gaussianDerivAt kernelAt kernelDilate
    simp only [smul_eq_mul]
    rw [show (y - p) / s =
        -((x - y) / s - (x - p) / s) by field_simp; ring,
      modelThirdKernel_reflect]
    ring
  calc
    (∫ p : ℝ, gaussianDerivAt s p x * modelThirdKernel u s p y) =
        ∫ p : ℝ, -(s⁻¹ * s⁻¹) * G ((x - p) / s) := by
          apply integral_congr_ae
          filter_upwards [] with p
          exact hpoint p
    _ = -(s⁻¹ * s⁻¹) * ∫ p : ℝ, G ((x - p) / s) := by
          rw [integral_const_mul]
    _ = -(s⁻¹ * s⁻¹) * (s * ∫ z : ℝ, G z) := by
          rw [integral_sub_left_eq_self (fun p : ℝ ↦ G (p / s)) volume x,
            Measure.integral_comp_div]
          simp only [smul_eq_mul, abs_of_pos hs]
    _ = -kernelDilate (ModelThirdKernel u) s (x - y) := by
          dsimp only [G, w]
          unfold ModelThirdKernel kernelDilate
          simp only [smul_eq_mul]
          field_simp

/-- The three-center Fubini calculation in the right-associated coordinate
order used by `e3Coordinates`. -/
theorem integral_centerTriple_kernel_product_right
    (s₀ s₁ s₂ u₀ u₁ u₂ x₀ x₁ x₂ y₀ y₁ y₂ : ℝ)
    (hs₀ : 0 < s₀) (hs₁ : 0 < s₁) (hs₂ : 0 < s₂) :
    (∫ p : ℝ × (ℝ × ℝ),
      (modelPhiAt s₀ (p.1 + s₀ * u₀) x₀ * gaussianAt s₀ p.1 y₀) *
        (modelPhiAt s₁ (p.2.1 + s₁ * u₁) x₁ * gaussianAt s₁ p.2.1 y₁) *
        (gaussianDerivAt s₂ p.2.2 x₂ * modelThirdKernel u₂ s₂ p.2.2 y₂)) =
      -(kernelDilate (ModelLowKernel u₀) s₀ (x₀ - y₀) *
        kernelDilate (ModelLowKernel u₁) s₁ (x₁ - y₁) *
        kernelDilate (ModelThirdKernel u₂) s₂ (x₂ - y₂)) := by
  let A₀ : ℝ → ℝ := fun p ↦
    modelPhiAt s₀ (p + s₀ * u₀) x₀ * gaussianAt s₀ p y₀
  let A₁ : ℝ → ℝ := fun p ↦
    modelPhiAt s₁ (p + s₁ * u₁) x₁ * gaussianAt s₁ p y₁
  let A₂ : ℝ → ℝ := fun p ↦
    gaussianDerivAt s₂ p x₂ * modelThirdKernel u₂ s₂ p y₂
  have hA₀ : (∫ p : ℝ, A₀ p) =
      kernelDilate (ModelLowKernel u₀) s₀ (x₀ - y₀) := by
    dsimp only [A₀]
    exact integral_modelPhiAt_mul_gaussianAt_center s₀ u₀ x₀ y₀ hs₀
  have hA₁ : (∫ p : ℝ, A₁ p) =
      kernelDilate (ModelLowKernel u₁) s₁ (x₁ - y₁) := by
    dsimp only [A₁]
    exact integral_modelPhiAt_mul_gaussianAt_center s₁ u₁ x₁ y₁ hs₁
  have hA₂ : (∫ p : ℝ, A₂ p) =
      -kernelDilate (ModelThirdKernel u₂) s₂ (x₂ - y₂) := by
    dsimp only [A₂]
    exact integral_gaussianDerivAt_mul_modelThirdKernel_center
      s₂ u₂ x₂ y₂ hs₂
  change (∫ p : ℝ × (ℝ × ℝ), A₀ p.1 * A₁ p.2.1 * A₂ p.2.2) = _
  rw [Measure.volume_eq_prod]
  calc
    (∫ p : ℝ × (ℝ × ℝ), A₀ p.1 * A₁ p.2.1 * A₂ p.2.2
      ∂((volume : Measure ℝ).prod volume)) =
        (∫ q : ℝ, A₀ q) * ∫ r : ℝ × ℝ, A₁ r.1 * A₂ r.2 := by
          rw [show (fun p : ℝ × (ℝ × ℝ) ↦ A₀ p.1 * A₁ p.2.1 * A₂ p.2.2) =
            fun p ↦ A₀ p.1 * (A₁ p.2.1 * A₂ p.2.2) by
              funext p
              ring]
          exact MeasureTheory.integral_prod_mul A₀
            (fun r : ℝ × ℝ ↦ A₁ r.1 * A₂ r.2)
    _ = (∫ q : ℝ, A₀ q) * ((∫ r : ℝ, A₁ r) * ∫ z : ℝ, A₂ z) := by
          rw [Measure.volume_eq_prod]
          rw [MeasureTheory.integral_prod_mul]
    _ = -(kernelDilate (ModelLowKernel u₀) s₀ (x₀ - y₀) *
        kernelDilate (ModelLowKernel u₁) s₁ (x₁ - y₁) *
        kernelDilate (ModelThirdKernel u₂) s₂ (x₂ - y₂)) := by
          rw [hA₀, hA₁, hA₂]
          ring

/-- Transporting the scalar three-center calculation through the literal
Euclidean-coordinate equivalence gives the center integral occurring in the
three-dimensional model form. -/
theorem integral_E3_centerTriple_kernel_product
    (s₀ s₁ s₂ u₀ u₁ u₂ x₀ x₁ x₂ y₀ y₁ y₂ : ℝ)
    (hs₀ : 0 < s₀) (hs₁ : 0 < s₁) (hs₂ : 0 < s₂) :
    (∫ p : E3,
      (modelPhiAt s₀ (p 0 + s₀ * u₀) x₀ * gaussianAt s₀ (p 0) y₀) *
        (modelPhiAt s₁ (p 1 + s₁ * u₁) x₁ * gaussianAt s₁ (p 1) y₁) *
        (gaussianDerivAt s₂ (p 2) x₂ *
          modelThirdKernel u₂ s₂ (p 2) y₂)) =
      -(kernelDilate (ModelLowKernel u₀) s₀ (x₀ - y₀) *
        kernelDilate (ModelLowKernel u₁) s₁ (x₁ - y₁) *
        kernelDilate (ModelThirdKernel u₂) s₂ (x₂ - y₂)) := by
  let G : E3 → ℝ := fun p ↦
    (modelPhiAt s₀ (p 0 + s₀ * u₀) x₀ * gaussianAt s₀ (p 0) y₀) *
      (modelPhiAt s₁ (p 1 + s₁ * u₁) x₁ * gaussianAt s₁ (p 1) y₁) *
      (gaussianDerivAt s₂ (p 2) x₂ * modelThirdKernel u₂ s₂ (p 2) y₂)
  let e : E3 ≃ᵐ ℝ × (ℝ × ℝ) := e3Coordinates
  have hmp : MeasurePreserving e (volume : Measure E3)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    simpa only [e] using e3Coordinates_measurePreserving
  have htransport : (∫ z : ℝ × (ℝ × ℝ), G (e.symm z)) =
      ∫ p : E3, G p := by
    exact (MeasurePreserving.symm e hmp).integral_comp
      e.symm.measurableEmbedding G
  change (∫ p : E3, G p) = _
  rw [← htransport]
  calc
    (∫ z : ℝ × (ℝ × ℝ), G (e.symm z)) =
        ∫ z : ℝ × (ℝ × ℝ),
          (modelPhiAt s₀ (z.1 + s₀ * u₀) x₀ * gaussianAt s₀ z.1 y₀) *
            (modelPhiAt s₁ (z.2.1 + s₁ * u₁) x₁ * gaussianAt s₁ z.2.1 y₁) *
            (gaussianDerivAt s₂ z.2.2 x₂ * modelThirdKernel u₂ s₂ z.2.2 y₂) := by
          apply integral_congr_ae
          filter_upwards [] with z
          have heq := e.apply_symm_apply z
          have h0 : (e.symm z) 0 = z.1 := by
            simpa only [e, e3Coordinates_apply] using congrArg Prod.fst heq
          have h1 : (e.symm z) 1 = z.2.1 := by
            simpa only [e, e3Coordinates_apply] using
              congrArg (fun q : ℝ × (ℝ × ℝ) ↦ q.2.1) heq
          have h2 : (e.symm z) 2 = z.2.2 := by
            simpa only [e, e3Coordinates_apply] using
              congrArg (fun q : ℝ × (ℝ × ℝ) ↦ q.2.2) heq
          dsimp only [G]
          rw [h0, h1, h2]
    _ = -(kernelDilate (ModelLowKernel u₀) s₀ (x₀ - y₀) *
        kernelDilate (ModelLowKernel u₁) s₁ (x₁ - y₁) *
        kernelDilate (ModelThirdKernel u₂) s₂ (x₂ - y₂)) :=
      integral_centerTriple_kernel_product_right
        s₀ s₁ s₂ u₀ u₁ u₂ x₀ x₁ x₂ y₀ y₁ y₂ hs₀ hs₁ hs₂

/-- Fubini lifts the center calculation through any absolutely integrable
outer parameter. This is the form used when the remaining six spatial
variables carry the four model inputs. -/
theorem integral_centerTriple_weighted_of_integrable
    {X : Type*} [MeasurableSpace X] (μ : Measure X) [SFinite μ]
    (s₀ s₁ s₂ u₀ u₁ u₂ : ℝ)
    (W x₀ x₁ x₂ y₀ y₁ y₂ : X → ℝ)
    (hs₀ : 0 < s₀) (hs₁ : 0 < s₁) (hs₂ : 0 < s₂)
    (hjoint : Integrable (fun q : X × E3 ↦
      W q.1 *
        ((modelPhiAt s₀ (q.2 0 + s₀ * u₀) (x₀ q.1) *
            gaussianAt s₀ (q.2 0) (y₀ q.1)) *
          (modelPhiAt s₁ (q.2 1 + s₁ * u₁) (x₁ q.1) *
            gaussianAt s₁ (q.2 1) (y₁ q.1)) *
          (gaussianDerivAt s₂ (q.2 2) (x₂ q.1) *
            modelThirdKernel u₂ s₂ (q.2 2) (y₂ q.1))))
      (μ.prod volume)) :
    (∫ q : X × E3,
      W q.1 *
        ((modelPhiAt s₀ (q.2 0 + s₀ * u₀) (x₀ q.1) *
            gaussianAt s₀ (q.2 0) (y₀ q.1)) *
          (modelPhiAt s₁ (q.2 1 + s₁ * u₁) (x₁ q.1) *
            gaussianAt s₁ (q.2 1) (y₁ q.1)) *
          (gaussianDerivAt s₂ (q.2 2) (x₂ q.1) *
            modelThirdKernel u₂ s₂ (q.2 2) (y₂ q.1)))
      ∂(μ.prod volume)) =
      -(∫ z : X,
        W z *
          (kernelDilate (ModelLowKernel u₀) s₀ (x₀ z - y₀ z) *
            kernelDilate (ModelLowKernel u₁) s₁ (x₁ z - y₁ z) *
            kernelDilate (ModelThirdKernel u₂) s₂ (x₂ z - y₂ z)) ∂μ) := by
  let C : X → E3 → ℝ := fun z p ↦
    (modelPhiAt s₀ (p 0 + s₀ * u₀) (x₀ z) *
        gaussianAt s₀ (p 0) (y₀ z)) *
      (modelPhiAt s₁ (p 1 + s₁ * u₁) (x₁ z) *
        gaussianAt s₁ (p 1) (y₁ z)) *
      (gaussianDerivAt s₂ (p 2) (x₂ z) *
        modelThirdKernel u₂ s₂ (p 2) (y₂ z))
  let K : X → ℝ := fun z ↦
    kernelDilate (ModelLowKernel u₀) s₀ (x₀ z - y₀ z) *
      kernelDilate (ModelLowKernel u₁) s₁ (x₁ z - y₁ z) *
      kernelDilate (ModelThirdKernel u₂) s₂ (x₂ z - y₂ z)
  change (∫ q : X × E3, W q.1 * C q.1 q.2 ∂(μ.prod volume)) =
    -(∫ z : X, W z * K z ∂μ)
  calc
    (∫ q : X × E3, W q.1 * C q.1 q.2 ∂(μ.prod volume)) =
        ∫ z : X, (∫ p : E3, W z * C z p ∂volume) ∂μ :=
      MeasureTheory.integral_prod _ hjoint
    _ = ∫ z : X, W z * (∫ p : E3, C z p ∂volume) ∂μ := by
      apply integral_congr_ae
      filter_upwards [] with z
      rw [← integral_const_mul]
    _ = ∫ z : X, W z * (-K z) ∂μ := by
      apply integral_congr_ae
      filter_upwards [] with z
      rw [integral_E3_centerTriple_kernel_product
        s₀ s₁ s₂ u₀ u₁ u₂ (x₀ z) (x₁ z) (x₂ z)
          (y₀ z) (y₁ z) (y₂ z) hs₀ hs₁ hs₂]
    _ = -(∫ z : X, W z * K z ∂μ) := by
      rw [← integral_neg]
      apply integral_congr_ae
      filter_upwards [] with z
      ring

/-- Mass-normalized dilation preserves integrability at every nonzero scale. -/
theorem integrable_kernelDilate
    {v : ℝ → ℝ} (hv : Integrable v) {s : ℝ} (hs : s ≠ 0) :
    Integrable (fun x : ℝ ↦ kernelDilate v s x) := by
  unfold kernelDilate
  simp only [smul_eq_mul]
  exact (hv.comp_div hs).const_mul s⁻¹

/-- Both physical low-frequency factors are integrable at every positive
model scale. -/
theorem integrable_ModelLowKernel_dilate
    (u s : ℝ) (hs : 0 < s) :
    Integrable (fun x : ℝ ↦ kernelDilate (ModelLowKernel u) s x) := by
  exact integrable_kernelDilate (integrable_ModelLowKernel u) hs.ne'

/-- The signed third physical factor is integrable at every positive model
scale. -/
theorem integrable_ModelThirdKernel_dilate
    (u s : ℝ) (hs : 0 < s) :
    Integrable (fun x : ℝ ↦ kernelDilate (ModelThirdKernel u) s x) := by
  exact integrable_kernelDilate (integrable_ModelThirdKernel u) hs.ne'

/-! ## Section 6: Schwartz maximal-function bridges

This scratch development keeps the source's literal all-positive-scales
anisotropic maxima. The initial block isolates elementary fixed-scale and
finite-scale facts which are reusable independently of the remaining
Hardy--Littlewood iteration.
-/

/-- The real-valued Schwartz inputs used in the initial model range have an
explicit polynomial tail in the Euclidean norm. This is the real analogue of
the earlier complex Schwartz decay extractor, stated here because Section 6
uses real second and fourth moments. -/
theorem realSchwartz_decay_norm
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f : SchwartzMap E ℝ) (r : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : E, |f x| ≤ C / (1 + ‖x‖) ^ r := by
  let C : ℝ := 2 ^ r *
    (Finset.Iic (r, 0)).sup (fun q ↦ SchwartzMap.seminorm ℝ q.1 q.2) f
  have hC : 0 ≤ C := by
    have h := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ)
      (m := (r, 0)) le_rfl le_rfl f (0 : E)
    have hnonneg : 0 ≤ (1 + ‖(0 : E)‖) ^ r *
        ‖iteratedFDeriv ℝ 0 f (0 : E)‖ :=
      mul_nonneg (pow_nonneg (by positivity) _) (norm_nonneg _)
    exact hnonneg.trans (by simpa [C] using h)
  refine ⟨C, hC, fun x ↦ ?_⟩
  apply (le_div_iff₀ (by positivity)).mpr
  rw [mul_comm]
  simpa [C, Real.norm_eq_abs, norm_iteratedFDeriv_zero] using
    (SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ)
      (m := (r, 0)) le_rfl le_rfl f x)

/-- The Euclidean norm on the literal three-coordinate source space is at
most the coordinate `ℓ¹` norm. Keeping this elementary comparison explicit
lets later kernel estimates reduce spatial escape to one coordinate. -/
theorem norm_le_sum_abs (v : E3) :
    ‖v‖ ≤ |v 0| + |v 1| + |v 2| := by
  rw [EuclideanSpace.norm_eq]
  apply (Real.sqrt_le_iff).mpr
  constructor
  · positivity
  rw [Fin.sum_univ_three]
  simp only [Real.norm_eq_abs]
  have h01 : 0 ≤ |v 0| * |v 1| := mul_nonneg (abs_nonneg _) (abs_nonneg _)
  have h02 : 0 ≤ |v 0| * |v 2| := mul_nonneg (abs_nonneg _) (abs_nonneg _)
  have h12 : 0 ≤ |v 1| * |v 2| := mul_nonneg (abs_nonneg _) (abs_nonneg _)
  nlinarith

/-- The product of the three coordinate Japanese brackets dominates one plus
their sum. -/
theorem one_add_sum_le_prod_one_add
    (a : Fin 3 → ℝ) (ha : ∀ i, 0 ≤ a i) :
    1 + ∑ i, a i ≤ ∏ i, (1 + a i) := by
  rw [Fin.sum_univ_three, Fin.prod_univ_three]
  have h01 : 0 ≤ a 0 * a 1 := mul_nonneg (ha _) (ha _)
  have h02 : 0 ≤ a 0 * a 2 := mul_nonneg (ha _) (ha _)
  have h12 : 0 ≤ a 1 * a 2 := mul_nonneg (ha _) (ha _)
  have h012 : 0 ≤ a 0 * a 1 * a 2 :=
    mul_nonneg h01 (ha _)
  nlinarith

/-- The product bracket on `E3` dominates the usual radial Japanese bracket.
This is the source's elementary product-to-radial tail comparison. -/
theorem one_add_norm_le_prod_one_add_abs (v : E3) :
    1 + ‖v‖ ≤ ∏ i : Fin 3, (1 + |v i|) := by
  calc
    1 + ‖v‖ ≤ 1 + ∑ i, |v i| := by
      gcongr
      simpa only [Fin.sum_univ_three] using norm_le_sum_abs v
    _ ≤ ∏ i : Fin 3, (1 + |v i|) :=
      one_add_sum_le_prod_one_add (fun i ↦ |v i|)
        (fun _ ↦ abs_nonneg _)

/-- After positive coordinate rescaling, the product bracket still dominates
the radial bracket at the sum of the three scales. -/
theorem one_add_norm_div_sum_le_prod_scaled
    (v : E3) (s : Fin 3 → ℝ) (hs : ∀ i, 0 < s i) :
    1 + ‖v‖ / (∑ i, s i) ≤ ∏ i, (1 + |v i / s i|) := by
  let S : ℝ := ∑ i, s i
  have hS : 0 < S := by
    dsimp only [S]
    exact Finset.sum_pos (fun i _ ↦ hs i) (by simp)
  have hsiS (i : Fin 3) : s i ≤ S := by
    dsimp only [S]
    exact Finset.single_le_sum (fun j _ ↦ (hs j).le) (Finset.mem_univ i)
  have hcoord (i : Fin 3) : |v i| / S ≤ |v i / s i| := by
    rw [abs_div, abs_of_pos (hs i)]
    apply (div_le_div_iff₀ hS (hs i)).mpr
    exact mul_le_mul_of_nonneg_left (hsiS i) (abs_nonneg _)
  calc
    1 + ‖v‖ / S ≤ 1 + (∑ i, |v i|) / S := by
      apply add_le_add_right
      exact div_le_div_of_nonneg_right
        (by simpa only [Fin.sum_univ_three] using norm_le_sum_abs v) hS.le
    _ = 1 + ∑ i, |v i| / S := by rw [Finset.sum_div]
    _ ≤ 1 + ∑ i, |v i / s i| := by
      apply add_le_add_right
      exact Finset.sum_le_sum fun i _ ↦ hcoord i
    _ ≤ ∏ i, (1 + |v i / s i|) :=
      one_add_sum_le_prod_one_add (fun i ↦ |v i / s i|)
        (fun _ ↦ abs_nonneg _)

/-- A finite product commutes with the fixed negative bracket exponent on
nonnegative factors. -/
theorem prod_rpow_neg_ten
    (a : Fin 3 → ℝ) (ha : ∀ i, 0 ≤ a i) :
    (∏ i, (a i) ^ (-10 : ℝ)) = (∏ i, a i) ^ (-10 : ℝ) := by
  rw [Fin.prod_univ_three]
  rw [← Real.mul_rpow (ha 0) (ha 1)]
  rw [← Real.mul_rpow (mul_nonneg (ha 0) (ha 1)) (ha 2)]
  rw [Fin.prod_univ_three]

/-- The unnormalized product of three rescaled bracket kernels is controlled
by one radial bracket. -/
theorem prod_bracketKernel_le_radial
    (v : E3) (s : Fin 3 → ℝ) (hs : ∀ i, 0 < s i) :
    (∏ i, bracketKernel (v i / s i)) ≤
      (1 + ‖v‖ / (∑ i, s i)) ^ (-10 : ℝ) := by
  have hS : 0 < ∑ i, s i :=
    Finset.sum_pos (fun i _ ↦ hs i) (by simp)
  have hbracket : ∀ i : Fin 3, bracketKernel (v i / s i) =
      (1 + |v i / s i|) ^ (-10 : ℝ) := by
    intro i
    rfl
  rw [show (∏ i, bracketKernel (v i / s i)) =
      ∏ i, (1 + |v i / s i|) ^ (-10 : ℝ) by
        apply Finset.prod_congr rfl
        intro i _
        exact hbracket i]
  rw [prod_rpow_neg_ten (fun i ↦ 1 + |v i / s i|)
    (fun i ↦ by positivity)]
  exact Real.rpow_le_rpow_of_nonpos
    (add_pos_of_pos_of_nonneg zero_lt_one (div_nonneg (norm_nonneg _) hS.le))
    (one_add_norm_div_sum_le_prod_scaled v s hs)
    (by norm_num)

/-- At each fixed positive anisotropic scale, the literal product comparison
kernel has a radial polynomial tail in the center variable. -/
theorem anisotropicBracketKernel_le_radial
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p y : E3) :
    anisotropicBracketKernel α t p y ≤
      (∏ i : Fin 3, (t ^ α.weight i)⁻¹) *
        (1 + ‖y - p‖ / (∑ i : Fin 3, t ^ α.weight i)) ^ (-10 : ℝ) := by
  have hs (i : Fin 3) : 0 < t ^ α.weight i := pow_pos ht _
  have hrewrite (i : Fin 3) :
      bracketKernelAt (t ^ α.weight i) (p i) (y i) =
        (t ^ α.weight i)⁻¹ * bracketKernel ((y - p) i / (t ^ α.weight i)) := by
    simp only [bracketKernelAt, kernelAt, kernelDilate, smul_eq_mul,
      PiLp.sub_apply]
  calc
    anisotropicBracketKernel α t p y =
        ∏ i : Fin 3, ((t ^ α.weight i)⁻¹ *
          bracketKernel ((y - p) i / (t ^ α.weight i))) := by
      unfold anisotropicBracketKernel
      apply Finset.prod_congr rfl
      intro i _
      exact hrewrite i
    _ = (∏ i : Fin 3, (t ^ α.weight i)⁻¹) *
        ∏ i : Fin 3, bracketKernel ((y - p) i / (t ^ α.weight i)) := by
      rw [Finset.prod_mul_distrib]
    _ ≤ (∏ i : Fin 3, (t ^ α.weight i)⁻¹) *
        (1 + ‖y - p‖ / (∑ i : Fin 3, t ^ α.weight i)) ^ (-10 : ℝ) := by
      apply mul_le_mul_of_nonneg_left
        (prod_bracketKernel_le_radial (y - p)
          (fun i ↦ t ^ α.weight i) hs)
      apply Finset.prod_nonneg
      intro i _
      exact inv_nonneg.mpr (hs i).le

/-- A fixed anisotropic comparison kernel vanishes when its center escapes to
spatial infinity. This is the pointwise tail input for dominated convergence
in the fixed-scale second and fourth moments. -/
theorem tendsto_anisotropicBracketKernel_center
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (y : E3) :
    Tendsto (fun p : E3 ↦ anisotropicBracketKernel α t p y)
      (cocompact E3) (𝓝 0) := by
  let S : ℝ := ∑ i : Fin 3, t ^ α.weight i
  let C : ℝ := ∏ i : Fin 3, (t ^ α.weight i)⁻¹
  have hS : 0 < S := by
    dsimp only [S]
    exact Finset.sum_pos (fun i _ ↦ pow_pos ht _) (by simp)
  have hC : 0 ≤ C := by
    dsimp only [C]
    apply Finset.prod_nonneg
    intro i _
    exact inv_nonneg.mpr (pow_pos ht _).le
  have hdist : Tendsto (fun p : E3 ↦ ‖y - p‖)
      (cocompact E3) atTop := by
    convert tendsto_dist_left_cocompact_atTop y using 1
    ext p
    exact (dist_eq_norm_sub y p).symm
  have hbase : Tendsto (fun p : E3 ↦ 1 + ‖y - p‖ / S)
      (cocompact E3) atTop := by
    exact tendsto_atTop_add_const_left _ 1
      (hdist.atTop_div_const hS)
  have htail : Tendsto (fun p : E3 ↦
      (1 + ‖y - p‖ / S) ^ (-10 : ℝ))
      (cocompact E3) (𝓝 0) := by
    exact (tendsto_rpow_neg_atTop (by norm_num : 0 < (10 : ℝ))).comp hbase
  have hmajor : Tendsto (fun p : E3 ↦ C *
      (1 + ‖y - p‖ / S) ^ (-10 : ℝ))
      (cocompact E3) (𝓝 0) := by
    simpa only [mul_zero] using tendsto_const_nhds.mul htail
  apply squeeze_zero
  · intro p
    exact anisotropicBracketKernel_nonneg α ht.le p y
  · intro p
    simpa only [S, C] using
      anisotropicBracketKernel_le_radial α ht p y
  · exact hmajor

/-- Each one-dimensional comparison bracket is at most one before its scale
normalization. -/
theorem bracketKernel_le_one (x : ℝ) : bracketKernel x ≤ 1 := by
  unfold bracketKernel
  apply Real.rpow_le_one_of_one_le_of_nonpos
  · linarith [abs_nonneg x]
  · norm_num

/-- The literal anisotropic kernel is bounded by its product scale density. -/
theorem anisotropicBracketKernel_le_scaleDensity
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p y : E3) :
    anisotropicBracketKernel α t p y ≤
      ∏ i : Fin 3, (t ^ α.weight i)⁻¹ := by
  have hs (i : Fin 3) : 0 < t ^ α.weight i := pow_pos ht _
  calc
    anisotropicBracketKernel α t p y =
        ∏ i : Fin 3, ((t ^ α.weight i)⁻¹ *
          bracketKernel ((y i - p i) / (t ^ α.weight i))) := by
      unfold anisotropicBracketKernel bracketKernelAt kernelAt kernelDilate
      apply Finset.prod_congr rfl
      intro i _
      simp only [smul_eq_mul]
    _ ≤ ∏ i : Fin 3, ((t ^ α.weight i)⁻¹ * 1) := by
      apply Finset.prod_le_prod₀
      · intro i _
        exact mul_nonneg (inv_nonneg.mpr (hs i).le) (bracketKernel_nonneg _)
      · intro i _
        exact mul_le_mul_of_nonneg_left
          (bracketKernel_le_one _) (inv_nonneg.mpr (hs i).le)
    _ = ∏ i : Fin 3, (t ^ α.weight i)⁻¹ := by simp

/-- Dominated convergence turns the fixed-kernel tail into a tail for a
fixed-scale second moment. The hypotheses are deliberately analytic rather
than Schwartz-specific, so the later Schwartz corollary has no hidden gap. -/
theorem tendsto_cubeSecondMoment_fixedScale
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (f : E3 → ℝ)
    (hfcont : Continuous f) (hfSq : Integrable (fun y : E3 ↦ f y ^ 2)) :
    Tendsto (fun p : E3 ↦ cubeSecondMoment α t p f)
      (cocompact E3) (𝓝 0) := by
  let : (cocompact E3).IsCountablyGenerated := by
    rw [← comap_dist_left_atTop_eq_cocompact (0 : E3)]
    infer_instance
  let C : ℝ := ∏ i : Fin 3, (t ^ α.weight i)⁻¹
  have hC : 0 ≤ C := by
    dsimp only [C]
    apply Finset.prod_nonneg
    intro i _
    exact inv_nonneg.mpr (pow_pos ht _).le
  have hbound : Integrable (fun y : E3 ↦ C * f y ^ 2) :=
    hfSq.const_mul C
  have hdc := tendsto_integral_filter_of_dominated_convergence
    (μ := volume) (l := cocompact E3)
    (F := fun p y ↦ f y ^ 2 * anisotropicBracketKernel α t p y)
    (f := fun _ : E3 ↦ (0 : ℝ))
    (fun y ↦ C * f y ^ 2)
    (Filter.Eventually.of_forall (fun p ↦
      ((hfcont.pow 2).mul (continuous_anisotropicBracketKernel α ht p)).aestronglyMeasurable))
    (Filter.Eventually.of_forall (fun p ↦ Filter.Eventually.of_forall (fun y ↦ by
      rw [Real.norm_eq_abs,
        abs_of_nonneg (mul_nonneg (sq_nonneg _)
          (anisotropicBracketKernel_nonneg α ht.le p y))]
      simpa only [mul_comm] using mul_le_mul_of_nonneg_left
        (anisotropicBracketKernel_le_scaleDensity α ht p y) (sq_nonneg _))))
    hbound
    (Filter.Eventually.of_forall (fun y ↦ by
      have hkernel := tendsto_anisotropicBracketKernel_center α ht y
      simpa only [mul_zero] using tendsto_const_nhds.mul hkernel))
  simpa only [cubeSecondMoment, integral_zero] using hdc

/-- Fixed-scale exponent-two anisotropic averages of a real Schwartz input
vanish at spatial infinity. -/
theorem tendsto_cubeSecondMoment_fixedScale_of_realSchwartz
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (f : SchwartzMap E3 ℝ) :
    Tendsto (fun p : E3 ↦ cubeSecondMoment α t p f)
      (cocompact E3) (𝓝 0) := by
  apply tendsto_cubeSecondMoment_fixedScale α ht f f.continuous
  have hmem : MemLp f (2 : ℝ≥0∞) volume := f.memLp 2 volume
  simpa only [Real.norm_eq_abs, sq_abs] using
    hmem.integrable_norm_pow (by norm_num : (2 : ℕ) ≠ 0)

/-! ### One-dimensional scale-uniform comparison -/

/-- A positive-scale bracket kernel is bounded by its scale density. -/
theorem bracketKernelAt_le_inv_scale {s : ℝ} (hs : 0 < s)
    (p y : ℝ) :
    bracketKernelAt s p y ≤ s⁻¹ := by
  unfold bracketKernelAt kernelAt kernelDilate
  change s⁻¹ * bracketKernel ((y - p) / s) ≤ s⁻¹
  simpa using mul_le_mul_of_nonneg_left
    (bracketKernel_le_one ((y - p) / s)) (inv_nonneg.mpr hs.le)

/-- Away from the center, a small-scale bracket kernel has a uniform
polynomial bound. The deliberately generous constant keeps later
annular bookkeeping elementary. -/
theorem bracketKernelAt_le_remote
    {s p y : ℝ} (hs : 0 < s) (hp : 1 ≤ |p|)
    (hscale : s ≤ |p| / 4) (hy : |y| ≤ |p| / 2) :
    bracketKernelAt s p y ≤ (2 : ℝ) ^ 10 / |p| := by
  have hp0 : 0 < |p| := lt_of_lt_of_le zero_lt_one hp
  have hdist : |p| / 2 ≤ |y - p| := by
    have htri : |p| ≤ |y| + |y - p| := by
      calc
        |p| = |y + (p - y)| := by
          congr 1
          ring
        _ ≤ |y| + |p - y| := abs_add_le _ _
        _ = |y| + |y - p| := by rw [abs_sub_comm]
    linarith
  have hratio : |p| / (2 * s) ≤ |(y - p) / s| := by
    rw [abs_div, abs_of_pos hs]
    calc
      |p| / (2 * s) = (|p| / 2) / s := by field_simp
      _ ≤ |y - p| / s := div_le_div_of_nonneg_right hdist hs.le
  have hbase : |p| / (2 * s) ≤ 1 + |(y - p) / s| := by
    linarith [abs_nonneg ((y - p) / s)]
  have hbasepos : 0 < |p| / (2 * s) := by positivity
  have hpow : (1 + |(y - p) / s|) ^ 10 ≥
      (|p| / (2 * s)) ^ 10 := by
    exact pow_le_pow_left₀ (by positivity) hbase 10
  rw [bracketKernelAt, kernelAt, kernelDilate, smul_eq_mul,
    bracketKernel_eq_inv_pow]
  have hinv : ((1 + |(y - p) / s|) ^ 10)⁻¹ ≤
      ((|p| / (2 * s)) ^ 10)⁻¹ := by
    exact inv_anti₀ (pow_pos hbasepos 10) hpow
  calc
    s⁻¹ * ((1 + |(y - p) / s|) ^ 10)⁻¹ ≤
        s⁻¹ * ((|p| / (2 * s)) ^ 10)⁻¹ :=
      mul_le_mul_of_nonneg_left hinv (inv_nonneg.mpr hs.le)
    _ = (2 : ℝ) ^ 10 * s ^ 9 / |p| ^ 10 := by
      field_simp
    _ ≤ (2 : ℝ) ^ 10 / |p| := by
      have hsle : s ≤ |p| := le_trans hscale (by nlinarith)
      have hspow : s ^ 9 ≤ |p| ^ 9 :=
        pow_le_pow_left₀ hs.le hsle 9
      have hquot : s ^ 9 / |p| ^ 10 ≤ 1 / |p| := by
        apply (div_le_div_iff₀ (pow_pos hp0 10) hp0).mpr
        calc
          s ^ 9 * |p| ≤ |p| ^ 9 * |p| :=
            mul_le_mul_of_nonneg_right hspow hp0.le
          _ = 1 * |p| ^ 10 := by ring
      calc
        (2 : ℝ) ^ 10 * s ^ 9 / |p| ^ 10 =
            (2 : ℝ) ^ 10 * (s ^ 9 / |p| ^ 10) := by ring
        _ ≤ (2 : ℝ) ^ 10 * (1 / |p|) :=
          mul_le_mul_of_nonneg_left hquot (by positivity)
        _ = (2 : ℝ) ^ 10 / |p| := by ring

/-- The unit bracket itself has the matching remote-center estimate. -/
theorem bracketKernel_le_remote
    {p y : ℝ} (hp : 1 ≤ |p|) (hy : |p| / 2 ≤ |y|) :
    bracketKernel y ≤ (2 : ℝ) ^ 10 / |p| := by
  have hp0 : 0 < |p| := lt_of_lt_of_le zero_lt_one hp
  have hbase : |p| / 2 ≤ 1 + |y| := by linarith
  have hbasepos : 0 < |p| / 2 := by positivity
  have hpow : (|p| / 2) ^ 10 ≤ (1 + |y|) ^ 10 :=
    pow_le_pow_left₀ (by positivity) hbase 10
  rw [bracketKernel_eq_inv_pow]
  calc
    ((1 + |y|) ^ 10)⁻¹ ≤ ((|p| / 2) ^ 10)⁻¹ :=
      inv_anti₀ (pow_pos hbasepos 10) hpow
    _ = (2 : ℝ) ^ 10 / |p| ^ 10 := by
      field_simp
    _ ≤ (2 : ℝ) ^ 10 / |p| := by
      have hpow : 1 ≤ |p| ^ 9 :=
        one_le_pow₀ hp
      have hquot : 1 / |p| ^ 10 ≤ 1 / |p| := by
        apply (div_le_div_iff₀ (pow_pos hp0 10) hp0).mpr
        calc
          1 * |p| ≤ |p| ^ 9 * |p| :=
            mul_le_mul_of_nonneg_right hpow hp0.le
          _ = 1 * |p| ^ 10 := by ring
      calc
        (2 : ℝ) ^ 10 / |p| ^ 10 = (2 : ℝ) ^ 10 * (1 / |p| ^ 10) := by ring
        _ ≤ (2 : ℝ) ^ 10 * (1 / |p|) :=
          mul_le_mul_of_nonneg_left hquot (by positivity)
        _ = (2 : ℝ) ^ 10 / |p| := by ring

/-- Products of a unit bracket and a positive-scale bracket kernel are
integrable; this is the basic one-dimensional Fubini input. -/
theorem integrable_bracketKernel_mul_bracketKernelAt
    {s : ℝ} (hs : 0 < s) (p : ℝ) :
    Integrable (fun y : ℝ ↦ bracketKernel y * bracketKernelAt s p y) := by
  refine (integrable_bracketKernelAt hs p).mono
    ((continuous_bracketKernel.mul (continuous_bracketKernelAt hs.ne' p)).aestronglyMeasurable) ?_
  filter_upwards [] with y
  rw [Real.norm_eq_abs,
    abs_of_nonneg (mul_nonneg (bracketKernel_nonneg _)
      (bracketKernelAt_nonneg hs.le)),
    Real.norm_eq_abs, abs_of_nonneg (bracketKernelAt_nonneg hs.le)]
  exact (mul_le_of_le_one_left (bracketKernelAt_nonneg hs.le)
    (bracketKernel_le_one _))

/-- The product bracket average is bounded by the mass of either factor. -/
theorem integral_bracketKernel_mul_bracketKernelAt_le_mass
    {s : ℝ} (hs : 0 < s) (p : ℝ) :
    ∫ y : ℝ, bracketKernel y * bracketKernelAt s p y ≤ 2 / 9 := by
  have hleft := integrable_bracketKernel_mul_bracketKernelAt hs p
  have hright := integrable_bracketKernelAt hs p
  calc
    (∫ y : ℝ, bracketKernel y * bracketKernelAt s p y) ≤
        ∫ y : ℝ, bracketKernelAt s p y :=
      MeasureTheory.integral_mono_ae hleft hright
        (Filter.Eventually.of_forall fun y ↦
          mul_le_of_le_one_left (bracketKernelAt_nonneg hs.le)
            (bracketKernel_le_one _))
    _ = 2 / 9 := integral_bracketKernelAt hs p

/-- At scales no smaller than the escaping coordinate, the product average
is controlled directly by scale density. -/
theorem integral_bracketKernel_mul_bracketKernelAt_le_largeScale
    {s p : ℝ} (hs : 0 < s) (hp : 1 ≤ |p|) (hscale : |p| / 4 ≤ s) :
    ∫ y : ℝ, bracketKernel y * bracketKernelAt s p y ≤
      (4 / |p|) * (2 / 9) := by
  have hp0 : 0 < |p| := lt_of_lt_of_le zero_lt_one hp
  have hquot : s⁻¹ ≤ 4 / |p| := by
    calc
      s⁻¹ ≤ (|p| / 4)⁻¹ := inv_anti₀ (by positivity) hscale
      _ = 4 / |p| := by field_simp
  have hleft := integrable_bracketKernel_mul_bracketKernelAt hs p
  have hright : Integrable (fun y : ℝ ↦ (4 / |p|) * bracketKernel y) :=
    integrable_bracketKernel.const_mul _
  calc
    (∫ y : ℝ, bracketKernel y * bracketKernelAt s p y) ≤
        ∫ y : ℝ, (4 / |p|) * bracketKernel y :=
      MeasureTheory.integral_mono_ae hleft hright
        (Filter.Eventually.of_forall fun y ↦ by
          have hK := bracketKernelAt_le_inv_scale hs p y
          calc
            bracketKernel y * bracketKernelAt s p y ≤
                bracketKernel y * (4 / |p|) :=
              mul_le_mul_of_nonneg_left (hK.trans hquot) (bracketKernel_nonneg _)
            _ = (4 / |p|) * bracketKernel y := by ring)
    _ = (4 / |p|) * (2 / 9) := by
      rw [MeasureTheory.integral_const_mul, integral_bracketKernel]

/-- At smaller scales, either the center kernel is remote or the unit
bracket is remote. This pointwise dichotomy is the core of the uniform
one-dimensional tail estimate. -/
theorem bracketKernel_mul_bracketKernelAt_le_smallScale
    {s p y : ℝ} (hs : 0 < s) (hp : 1 ≤ |p|)
    (hscale : s ≤ |p| / 4) :
    bracketKernel y * bracketKernelAt s p y ≤
      ((2 : ℝ) ^ 10 / |p|) *
        (bracketKernel y + bracketKernelAt s p y) := by
  have hp0 : 0 < |p| := lt_of_lt_of_le zero_lt_one hp
  have hcoeff : 0 ≤ (2 : ℝ) ^ 10 / |p| :=
    div_nonneg (by positivity) hp0.le
  by_cases hy : |y| ≤ |p| / 2
  · have hK := bracketKernelAt_le_remote hs hp hscale hy
    calc
      bracketKernel y * bracketKernelAt s p y ≤
          bracketKernel y * ((2 : ℝ) ^ 10 / |p|) :=
        mul_le_mul_of_nonneg_left hK (bracketKernel_nonneg _)
      _ = ((2 : ℝ) ^ 10 / |p|) * bracketKernel y := by ring
      _ ≤ ((2 : ℝ) ^ 10 / |p|) *
          (bracketKernel y + bracketKernelAt s p y) :=
        mul_le_mul_of_nonneg_left
          (le_add_of_nonneg_right (bracketKernelAt_nonneg hs.le)) hcoeff
  · have hy' : |p| / 2 ≤ |y| := le_of_lt (lt_of_not_ge hy)
    have hB := bracketKernel_le_remote hp hy'
    calc
      bracketKernel y * bracketKernelAt s p y ≤
          ((2 : ℝ) ^ 10 / |p|) * bracketKernelAt s p y :=
        mul_le_mul_of_nonneg_right hB (bracketKernelAt_nonneg hs.le)
      _ ≤ ((2 : ℝ) ^ 10 / |p|) *
          (bracketKernel y + bracketKernelAt s p y) :=
        mul_le_mul_of_nonneg_left
          (le_add_of_nonneg_left (bracketKernel_nonneg _)) hcoeff

/-- The small-scale dichotomy integrates without any unproved Fubini
interchange: both summands have explicit mass. -/
theorem integral_bracketKernel_mul_bracketKernelAt_le_smallScale
    {s p : ℝ} (hs : 0 < s) (hp : 1 ≤ |p|)
    (hscale : s ≤ |p| / 4) :
    ∫ y : ℝ, bracketKernel y * bracketKernelAt s p y ≤
      ((2 : ℝ) ^ 10 / |p|) * ((2 / 9) + (2 / 9)) := by
  have hleft := integrable_bracketKernel_mul_bracketKernelAt hs p
  have hsum : Integrable (fun y : ℝ ↦ bracketKernel y + bracketKernelAt s p y) :=
    integrable_bracketKernel.add (integrable_bracketKernelAt hs p)
  have hright := hsum.const_mul ((2 : ℝ) ^ 10 / |p|)
  calc
    (∫ y : ℝ, bracketKernel y * bracketKernelAt s p y) ≤
        ∫ y : ℝ, ((2 : ℝ) ^ 10 / |p|) *
          (bracketKernel y + bracketKernelAt s p y) :=
      MeasureTheory.integral_mono_ae hleft hright
        (Filter.Eventually.of_forall
          (fun y ↦ bracketKernel_mul_bracketKernelAt_le_smallScale
            hs hp hscale))
    _ = ((2 : ℝ) ^ 10 / |p|) *
        ((∫ y : ℝ, bracketKernel y) + ∫ y : ℝ, bracketKernelAt s p y) := by
      rw [MeasureTheory.integral_const_mul, MeasureTheory.integral_add
        integrable_bracketKernel (integrable_bracketKernelAt hs p)]
    _ = ((2 : ℝ) ^ 10 / |p|) * ((2 / 9) + (2 / 9)) := by
      rw [integral_bracketKernel, integral_bracketKernelAt hs p]

/-- A single, scale-uniform one-dimensional polynomial envelope. This is
the precise replacement for the annular-decomposition step in the source:
the constant is intentionally coarse, while the decay is uniform over every
positive dilation. -/
theorem integral_bracketKernel_mul_bracketKernelAt_le_uniform
    {s : ℝ} (hs : 0 < s) (p : ℝ) :
    ∫ y : ℝ, bracketKernel y * bracketKernelAt s p y ≤
      (2 : ℝ) ^ 13 / (1 + |p|) := by
  by_cases hp : 1 ≤ |p|
  · have hp0 : 0 < |p| := lt_of_lt_of_le zero_lt_one hp
    have hP : ∫ y : ℝ, bracketKernel y * bracketKernelAt s p y ≤
        (2 : ℝ) ^ 12 / |p| := by
      by_cases hscale : s ≤ |p| / 4
      · calc
          (∫ y : ℝ, bracketKernel y * bracketKernelAt s p y) ≤
              ((2 : ℝ) ^ 10 / |p|) * ((2 / 9) + (2 / 9)) :=
            integral_bracketKernel_mul_bracketKernelAt_le_smallScale
              hs hp hscale
          _ = ((2 : ℝ) ^ 10 * ((2 / 9) + (2 / 9))) / |p| := by ring
          _ ≤ (2 : ℝ) ^ 12 / |p| := by
            apply div_le_div_of_nonneg_right _ hp0.le
            norm_num
      · have hscale' : |p| / 4 ≤ s := le_of_not_ge hscale
        calc
          (∫ y : ℝ, bracketKernel y * bracketKernelAt s p y) ≤
              (4 / |p|) * (2 / 9) :=
            integral_bracketKernel_mul_bracketKernelAt_le_largeScale
              hs hp hscale'
          _ = (4 * (2 / 9)) / |p| := by ring
          _ ≤ (2 : ℝ) ^ 12 / |p| := by
            apply div_le_div_of_nonneg_right _ hp0.le
            norm_num
    calc
      (∫ y : ℝ, bracketKernel y * bracketKernelAt s p y) ≤
          (2 : ℝ) ^ 12 / |p| := hP
      _ = 4096 / |p| := by norm_num
      _ ≤ 8192 / (1 + |p|) := by
        apply (div_le_div_iff₀ hp0 (by positivity)).mpr
        nlinarith
      _ = (2 : ℝ) ^ 13 / (1 + |p|) := by norm_num
  · have hp' : |p| ≤ 1 := le_of_not_ge hp
    calc
      (∫ y : ℝ, bracketKernel y * bracketKernelAt s p y) ≤ 2 / 9 :=
        integral_bracketKernel_mul_bracketKernelAt_le_mass hs p
      _ ≤ 8192 / (1 + |p|) := by
        apply (le_div_iff₀ (by positivity)).mpr
        nlinarith [abs_nonneg p]
      _ = (2 : ℝ) ^ 13 / (1 + |p|) := by norm_num

/-! ### Product Schwartz envelopes -/

/-- The product of the three coordinate Japanese brackets is at most the
third power of the Euclidean bracket. -/
theorem prod_one_add_abs_le_one_add_norm_cube (v : E3) :
    (∏ i : Fin 3, (1 + |v i|)) ≤ (1 + ‖v‖) ^ 3 := by
  have hcoord (i : Fin 3) : |v i| ≤ ‖v‖ := by
    simpa only [Real.norm_eq_abs] using PiLp.norm_apply_le v i
  rw [Fin.prod_univ_three]
  have h0 : 1 + |v 0| ≤ 1 + ‖v‖ := by linarith [hcoord 0]
  have h1 : 1 + |v 1| ≤ 1 + ‖v‖ := by linarith [hcoord 1]
  have h2 : 1 + |v 2| ≤ 1 + ‖v‖ := by linarith [hcoord 2]
  calc
    (1 + |v 0|) * (1 + |v 1|) * (1 + |v 2|) ≤
        (1 + ‖v‖) * (1 + ‖v‖) * (1 + ‖v‖) := by gcongr
    _ = (1 + ‖v‖) ^ 3 := by ring

/-- A radial order-thirty bracket is dominated by the product of the three
literal coordinate brackets. -/
theorem radial_bracket_neg_thirty_le_prod_bracketKernel (v : E3) :
    (1 + ‖v‖) ^ (-30 : ℝ) ≤ ∏ i : Fin 3, bracketKernel (v i) := by
  have hprod := prod_one_add_abs_le_one_add_norm_cube v
  have hprodpos : 0 < ∏ i : Fin 3, (1 + |v i|) := by positivity
  rw [show (∏ i : Fin 3, bracketKernel (v i)) =
      (∏ i : Fin 3, (1 + |v i|)) ^ (-10 : ℝ) by
        simpa only [bracketKernel] using
          prod_rpow_neg_ten (fun i ↦ 1 + |v i|)
            (fun _ ↦ by positivity)]
  calc
    (1 + ‖v‖) ^ (-30 : ℝ) = ((1 + ‖v‖) ^ 3) ^ (-10 : ℝ) := by
      rw [← Real.rpow_natCast (1 + ‖v‖) 3, ← Real.rpow_mul (by positivity)]
      norm_num
    _ ≤ (∏ i : Fin 3, (1 + |v i|)) ^ (-10 : ℝ) :=
      Real.rpow_le_rpow_of_nonpos hprodpos hprod (by norm_num)

/-- Squared real Schwartz data have a separable three-coordinate bracket
envelope. Its coefficient is explicit enough for the scale-uniform
convolution calculation, but no choice of a Schwartz seminorm is exposed to
the eventual maximal-function statement. -/
theorem realSchwartz_sq_le_prod_bracketKernel
    (f : SchwartzMap E3 ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ y : E3,
      f y ^ 2 ≤ C * ∏ i : Fin 3, bracketKernel (y i) := by
  rcases realSchwartz_decay_norm f 15 with ⟨A, hA, hdecay⟩
  refine ⟨A ^ 2, pow_nonneg hA _, fun y ↦ ?_⟩
  have hB : 0 < 1 + ‖y‖ := by positivity
  have hdivnonneg : 0 ≤ A / (1 + ‖y‖) ^ 15 :=
    div_nonneg hA (pow_nonneg hB.le _)
  have hsq : |f y| ^ 2 ≤ (A / (1 + ‖y‖) ^ 15) ^ 2 :=
    (sq_le_sq₀ (abs_nonneg _) hdivnonneg).mpr (hdecay y)
  have hradial : f y ^ 2 ≤ A ^ 2 * (1 + ‖y‖) ^ (-30 : ℝ) := by
    calc
      f y ^ 2 = |f y| ^ 2 := by rw [← sq_abs]
      _ ≤ (A / (1 + ‖y‖) ^ 15) ^ 2 := hsq
      _ = A ^ 2 * (1 + ‖y‖) ^ (-30 : ℝ) := by
        rw [div_pow]
        rw [show (1 + ‖y‖) ^ (-30 : ℝ) =
            ((1 + ‖y‖) ^ 30)⁻¹ by
              rw [Real.rpow_neg hB.le]
              congr 1
              exact Real.rpow_natCast _ _]
        field_simp
  calc
    f y ^ 2 ≤ A ^ 2 * (1 + ‖y‖) ^ (-30 : ℝ) := hradial
    _ ≤ A ^ 2 * ∏ i : Fin 3, bracketKernel (y i) :=
      mul_le_mul_of_nonneg_left
        (radial_bracket_neg_thirty_le_prod_bracketKernel y)
        (pow_nonneg hA _)

/-- The same separable bracket envelope also controls the fourth power of a
real Schwartz input (after enlarging its coefficient once). -/
theorem realSchwartz_rpow_four_le_prod_bracketKernel
    (f : SchwartzMap E3 ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ y : E3,
      |f y| ^ (4 : ℝ) ≤ C * ∏ i : Fin 3, bracketKernel (y i) := by
  rcases realSchwartz_sq_le_prod_bracketKernel f with ⟨C, hC, henv⟩
  refine ⟨C ^ 2, pow_nonneg hC _, fun y ↦ ?_⟩
  let P : ℝ := ∏ i : Fin 3, bracketKernel (y i)
  have hP0 : 0 ≤ P := by
    dsimp only [P]
    exact Finset.prod_nonneg fun i _ ↦ bracketKernel_nonneg _
  have hP1 : P ≤ 1 := by
    dsimp only [P]
    apply Finset.prod_le_one₀
    · intro i _
      exact bracketKernel_nonneg _
    · intro i _
      exact bracketKernel_le_one _
  have hCP : 0 ≤ C * P := mul_nonneg hC hP0
  have hsquare : (f y ^ 2) ^ 2 ≤ (C * P) ^ 2 := by
    have hdiff : 0 ≤ (C * P - f y ^ 2) * (C * P + f y ^ 2) :=
      mul_nonneg (sub_nonneg.mpr (henv y)) (add_nonneg hCP (sq_nonneg _))
    nlinarith
  have hP2 : P ^ 2 ≤ P := by
    have hdiff : 0 ≤ P * (1 - P) :=
      mul_nonneg hP0 (sub_nonneg.mpr hP1)
    nlinarith
  calc
    |f y| ^ (4 : ℝ) = (f y ^ 2) ^ 2 := by
      calc
        |f y| ^ (4 : ℝ) = |f y| ^ (4 : ℕ) := Real.rpow_natCast _ _
        _ = (|f y| ^ 2) ^ 2 := by ring
        _ = (f y ^ 2) ^ 2 := by rw [sq_abs]
    _ ≤ (C * P) ^ 2 := hsquare
    _ = C ^ 2 * P ^ 2 := by ring
    _ ≤ C ^ 2 * P := mul_le_mul_of_nonneg_left hP2 (sq_nonneg _)
    _ = C ^ 2 * ∏ i : Fin 3, bracketKernel (y i) := by rfl

/-- The separable bracket envelope times the literal anisotropic kernel is
integrable. This is the exact product-measure statement needed to iterate
the one-dimensional scale-uniform estimate. -/
theorem integrable_prod_bracketKernel_mul_anisotropicBracketKernel
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3) :
    Integrable (fun y : E3 ↦
      (∏ i : Fin 3, bracketKernel (y i)) *
        anisotropicBracketKernel α t p y) := by
  rw [← (PiLp.volume_preserving_toLp (Fin 3)).integrable_comp_emb
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  change Integrable (fun x : Fin 3 → ℝ ↦
    (∏ i : Fin 3, bracketKernel (x i)) *
      ∏ i : Fin 3, bracketKernelAt (t ^ α.weight i) (p i) (x i))
  have hprod (x : Fin 3 → ℝ) :
      (∏ i : Fin 3, bracketKernel (x i)) *
        ∏ i : Fin 3, bracketKernelAt (t ^ α.weight i) (p i) (x i) =
      ∏ i : Fin 3, bracketKernel (x i) *
        bracketKernelAt (t ^ α.weight i) (p i) (x i) := by
    rw [Finset.prod_mul_distrib]
  refine Integrable.congr (Integrable.fintype_prod fun i ↦
    integrable_bracketKernel_mul_bracketKernelAt
      (pow_pos ht _) (p i)) (Filter.Eventually.of_forall fun x ↦ (hprod x).symm)

/-- Fubini factors the separable envelope against the literal anisotropic
kernel into the three one-dimensional bracket convolutions. -/
theorem integral_prod_bracketKernel_mul_anisotropicBracketKernel
    (α : Anisotropy) {t : ℝ} (_ht : 0 < t) (p : E3) :
    ∫ y : E3, (∏ i : Fin 3, bracketKernel (y i)) *
        anisotropicBracketKernel α t p y =
      ∏ i : Fin 3, ∫ x : ℝ,
        bracketKernel x * bracketKernelAt (t ^ α.weight i) (p i) x := by
  rw [← (PiLp.volume_preserving_toLp (Fin 3)).integral_comp
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  change (∫ x : Fin 3 → ℝ,
    (∏ i : Fin 3, bracketKernel (x i)) *
      ∏ i : Fin 3, bracketKernelAt (t ^ α.weight i) (p i) (x i)) = _
  have hprod (x : Fin 3 → ℝ) :
      (∏ i : Fin 3, bracketKernel (x i)) *
        ∏ i : Fin 3, bracketKernelAt (t ^ α.weight i) (p i) (x i) =
      ∏ i : Fin 3, bracketKernel (x i) *
        bracketKernelAt (t ^ α.weight i) (p i) (x i) := by
    rw [Finset.prod_mul_distrib]
  calc
    (∫ x : Fin 3 → ℝ,
      (∏ i : Fin 3, bracketKernel (x i)) *
        ∏ i : Fin 3, bracketKernelAt (t ^ α.weight i) (p i) (x i)) =
        ∫ x : Fin 3 → ℝ, ∏ i : Fin 3, bracketKernel (x i) *
          bracketKernelAt (t ^ α.weight i) (p i) (x i) :=
      integral_congr_ae (Filter.Eventually.of_forall hprod)
    _ = ∏ i : Fin 3, ∫ x : ℝ,
        bracketKernel x * bracketKernelAt (t ^ α.weight i) (p i) x :=
      integral_fintype_prod_volume_eq_prod
        (fun i (x : ℝ) ↦ bracketKernel x *
          bracketKernelAt (t ^ α.weight i) (p i) x)

/-- A separable product bracket envelope for `f²` gives a scale-uniform
three-dimensional estimate for every literal anisotropic average. -/
theorem cubeSecondMoment_le_uniform_product_envelope
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (f : SchwartzMap E3 ℝ) {C : ℝ} (hC : 0 ≤ C)
    (henv : ∀ y : E3, f y ^ 2 ≤ C * ∏ i : Fin 3, bracketKernel (y i)) :
    cubeSecondMoment α t p f ≤ C *
      ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) := by
  let R : E3 → ℝ := fun y ↦
    (∏ i : Fin 3, bracketKernel (y i)) *
      anisotropicBracketKernel α t p y
  have hR : Integrable R :=
    integrable_prod_bracketKernel_mul_anisotropicBracketKernel α ht p
  have hleft : Integrable (fun y : E3 ↦
      f y ^ 2 * anisotropicBracketKernel α t p y) := by
    refine (hR.const_mul C).mono
      ((f.continuous.pow 2).mul
        (continuous_anisotropicBracketKernel α ht p)).aestronglyMeasurable ?_
    filter_upwards [] with y
    have hK : 0 ≤ anisotropicBracketKernel α t p y :=
      anisotropicBracketKernel_nonneg α ht.le p y
    have hRnonneg : 0 ≤ R y := by
      dsimp only [R]
      exact mul_nonneg (Finset.prod_nonneg fun i _ ↦ bracketKernel_nonneg _)
        hK
    rw [Real.norm_eq_abs,
      abs_of_nonneg (mul_nonneg (sq_nonneg _) hK),
      Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hC hRnonneg)]
    calc
      f y ^ 2 * anisotropicBracketKernel α t p y ≤
          (C * ∏ i : Fin 3, bracketKernel (y i)) *
            anisotropicBracketKernel α t p y :=
        mul_le_mul_of_nonneg_right (henv y) hK
      _ = C * R y := by
        dsimp only [R]
        ring
  have hright : Integrable (fun y : E3 ↦ C * R y) := hR.const_mul C
  have hfacnonneg (i : Fin 3) : 0 ≤
      ∫ x : ℝ, bracketKernel x * bracketKernelAt
        (t ^ α.weight i) (p i) x := by
    apply integral_nonneg
    intro x
    exact mul_nonneg (bracketKernel_nonneg _)
      (bracketKernelAt_nonneg (pow_pos ht _).le)
  have hfacbound (i : Fin 3) :
      ∫ x : ℝ, bracketKernel x * bracketKernelAt
        (t ^ α.weight i) (p i) x ≤
        (2 : ℝ) ^ 13 / (1 + |p i|) :=
    integral_bracketKernel_mul_bracketKernelAt_le_uniform
      (pow_pos ht _) (p i)
  have hprod : (∏ i : Fin 3, ∫ x : ℝ,
      bracketKernel x * bracketKernelAt (t ^ α.weight i) (p i) x) ≤
      ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) := by
    apply Finset.prod_le_prod₀
    · intro i _
      exact hfacnonneg i
    · intro i _
      exact hfacbound i
  calc
    cubeSecondMoment α t p f = ∫ y : E3,
        f y ^ 2 * anisotropicBracketKernel α t p y := rfl
    _ ≤ ∫ y : E3, C * R y :=
      MeasureTheory.integral_mono_ae hleft hright
        (Filter.Eventually.of_forall fun y ↦ by
          have hK : 0 ≤ anisotropicBracketKernel α t p y :=
            anisotropicBracketKernel_nonneg α ht.le p y
          calc
            f y ^ 2 * anisotropicBracketKernel α t p y ≤
                (C * ∏ i : Fin 3, bracketKernel (y i)) *
                  anisotropicBracketKernel α t p y :=
              mul_le_mul_of_nonneg_right (henv y) hK
            _ = C * R y := by
              dsimp only [R]
              ring)
    _ = C * ∫ y : E3, R y := by rw [MeasureTheory.integral_const_mul]
    _ = C * ∏ i : Fin 3, ∫ x : ℝ,
        bracketKernel x * bracketKernelAt (t ^ α.weight i) (p i) x := by
      rw [integral_prod_bracketKernel_mul_anisotropicBracketKernel α ht p]
    _ ≤ C * ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) :=
      mul_le_mul_of_nonneg_left hprod hC

/-- Real Schwartz data satisfy a scale-uniform separable tail estimate for
their exponent-two anisotropic averages. -/
theorem cubeSecondMoment_le_uniform_of_realSchwartz
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (f : SchwartzMap E3 ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧
      cubeSecondMoment α t p f ≤ C *
        ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) := by
  rcases realSchwartz_sq_le_prod_bracketKernel f with ⟨C, hC, henv⟩
  exact ⟨C, hC,
    cubeSecondMoment_le_uniform_product_envelope α ht p f hC henv⟩

/-- The preceding bound chooses one coefficient uniformly over all positive
anisotropic scales, which is exactly what is needed to pass through the
literal real supremum in `anisotropicMaximalTwoPower`. -/
theorem cubeSecondMoment_uniform_of_realSchwartz
    (α : Anisotropy) (f : SchwartzMap E3 ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (t : ℝ), 0 < t → ∀ p : E3,
      cubeSecondMoment α t p f ≤ C *
        ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) := by
  rcases realSchwartz_sq_le_prod_bracketKernel f with ⟨C, hC, henv⟩
  refine ⟨C, hC, fun t ht p ↦ ?_⟩
  exact cubeSecondMoment_le_uniform_product_envelope
    α ht p f hC henv

/-- The exponent-two all-positive-scales supremum inherits the same explicit
Schwartz envelope. -/
theorem anisotropicMaximalTwoPower_le_uniform_of_realSchwartz
    (α : Anisotropy) (f : SchwartzMap E3 ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ p : E3,
      anisotropicMaximalTwoPower α f p ≤ C *
        ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) := by
  rcases cubeSecondMoment_uniform_of_realSchwartz α f with
    ⟨C, hC, hmoment⟩
  refine ⟨C, hC, fun p ↦ ?_⟩
  unfold anisotropicMaximalTwoPower
  apply csSup_le
  · exact ⟨cubeSecondMoment α 1 p f, ⟨1, by norm_num, rfl⟩⟩
  · rintro a ⟨t, ht, rfl⟩
    exact hmoment t ht p

/-- The product envelope itself is bounded by one radial reciprocal bracket,
so it vanishes along the cocompact filter. -/
theorem prod_maximalEnvelope_le_radial (p : E3) :
    (∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|))) ≤
      ((2 : ℝ) ^ 13) ^ 3 / (1 + ‖p‖) := by
  have hdenom : 1 + ‖p‖ ≤ ∏ i : Fin 3, (1 + |p i|) :=
    one_add_norm_le_prod_one_add_abs p
  have hdenompos : 0 < 1 + ‖p‖ := by positivity
  have hinv : (∏ i : Fin 3, (1 + |p i|))⁻¹ ≤ (1 + ‖p‖)⁻¹ :=
    inv_anti₀ hdenompos hdenom
  calc
    (∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|))) =
        ∏ i : Fin 3, ((2 : ℝ) ^ 13 * (1 + |p i|)⁻¹) := by
      apply Finset.prod_congr rfl
      intro i _
      ring
    _ = (∏ _i : Fin 3, (2 : ℝ) ^ 13) *
        ∏ i : Fin 3, (1 + |p i|)⁻¹ := by
      rw [Finset.prod_mul_distrib]
    _ = ((2 : ℝ) ^ 13) ^ 3 *
        (∏ i : Fin 3, (1 + |p i|))⁻¹ := by
      rw [Finset.prod_const, Finset.prod_inv_distrib]
      norm_num
    _ ≤ ((2 : ℝ) ^ 13) ^ 3 * (1 + ‖p‖)⁻¹ :=
      mul_le_mul_of_nonneg_left hinv (by positivity)
    _ = ((2 : ℝ) ^ 13) ^ 3 / (1 + ‖p‖) := by ring

/-- Any nonnegative multiple of the explicit product envelope vanishes at
spatial infinity. -/
theorem tendsto_uniform_maximalEnvelope
    (C : ℝ) (hC : 0 ≤ C) :
    Tendsto (fun p : E3 ↦ C *
      ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)))
      (cocompact E3) (𝓝 0) := by
  have hnorm : Tendsto (fun p : E3 ↦ ‖p‖) (cocompact E3) atTop :=
    tendsto_norm_cocompact_atTop
  have hbase : Tendsto (fun p : E3 ↦ 1 + ‖p‖)
      (cocompact E3) atTop :=
    tendsto_atTop_add_const_left _ 1 hnorm
  have hinv : Tendsto (fun p : E3 ↦ (1 + ‖p‖)⁻¹)
      (cocompact E3) (𝓝 0) :=
    tendsto_inv_atTop_zero.comp hbase
  have hradial : Tendsto (fun p : E3 ↦ C *
      (((2 : ℝ) ^ 13) ^ 3 / (1 + ‖p‖)))
      (cocompact E3) (𝓝 0) := by
    have hconst : Tendsto (fun p : E3 ↦ C * ((2 : ℝ) ^ 13) ^ 3)
        (cocompact E3) (𝓝 (C * ((2 : ℝ) ^ 13) ^ 3)) := tendsto_const_nhds
    simpa [div_eq_mul_inv, mul_assoc] using hconst.mul hinv
  apply squeeze_zero
  · intro p
    exact mul_nonneg hC (Finset.prod_nonneg fun i _ ↦ by positivity)
  · intro p
    exact mul_le_mul_of_nonneg_left
      (prod_maximalEnvelope_le_radial p) hC
  · exact hradial

/-- The full literal exponent-two anisotropic maximal function of a real
Schwartz input tends to zero at spatial infinity. This closes the tail
branch of the source stopping-time finiteness interface without invoking an
external maximal theorem. -/
theorem tendsto_anisotropicMaximalTwo_of_realSchwartz
    (α : Anisotropy) (f : SchwartzMap E3 ℝ) :
    Tendsto (anisotropicMaximalTwo α f) (cocompact E3) (𝓝 0) := by
  rcases anisotropicMaximalTwoPower_le_uniform_of_realSchwartz α f
    with ⟨C, hC, hbound⟩
  have henv : Tendsto (fun p : E3 ↦ C *
      ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)))
      (cocompact E3) (𝓝 0) :=
    tendsto_uniform_maximalEnvelope C hC
  have hsqrtenv : Tendsto (fun p : E3 ↦
      √(C * ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|))) )
      (cocompact E3) (𝓝 0) := by
    convert (Real.continuous_sqrt.tendsto 0).comp henv using 1
    · ext p
      rfl
    · simp only [Real.sqrt_zero]
  change Tendsto (fun p : E3 ↦ √(anisotropicMaximalTwoPower α f p))
    (cocompact E3) (𝓝 0)
  apply squeeze_zero
  · intro p
    exact Real.sqrt_nonneg _
  · intro p
    exact Real.sqrt_le_sqrt (hbound p)
  · exact hsqrtenv

/-- The same product-envelope/Fubini calculation applies to the literal
fourth moments. -/
theorem fourthMoment_le_uniform_product_envelope
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (f : SchwartzMap E3 ℝ) {C : ℝ} (hC : 0 ≤ C)
    (henv : ∀ y : E3, |f y| ^ (4 : ℝ) ≤ C *
      ∏ i : Fin 3, bracketKernel (y i)) :
    fourthMoment α t p f ≤ C *
      ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) := by
  let R : E3 → ℝ := fun y ↦
    (∏ i : Fin 3, bracketKernel (y i)) *
      anisotropicBracketKernel α t p y
  have hR : Integrable R :=
    integrable_prod_bracketKernel_mul_anisotropicBracketKernel α ht p
  have hleft : Integrable (fun y : E3 ↦
      |f y| ^ (4 : ℝ) * anisotropicBracketKernel α t p y) := by
    refine (hR.const_mul C).mono
      ((f.continuous.abs.rpow_const (fun _ ↦ Or.inr (by norm_num))).mul
        (continuous_anisotropicBracketKernel α ht p)).aestronglyMeasurable ?_
    filter_upwards [] with y
    have hK : 0 ≤ anisotropicBracketKernel α t p y :=
      anisotropicBracketKernel_nonneg α ht.le p y
    have hRnonneg : 0 ≤ R y := by
      dsimp only [R]
      exact mul_nonneg (Finset.prod_nonneg fun i _ ↦ bracketKernel_nonneg _)
        hK
    rw [Real.norm_eq_abs,
      abs_of_nonneg (mul_nonneg (Real.rpow_nonneg (abs_nonneg _) _) hK),
      Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hC hRnonneg)]
    calc
      |f y| ^ (4 : ℝ) * anisotropicBracketKernel α t p y ≤
          (C * ∏ i : Fin 3, bracketKernel (y i)) *
            anisotropicBracketKernel α t p y :=
        mul_le_mul_of_nonneg_right (henv y) hK
      _ = C * R y := by
        dsimp only [R]
        ring
  have hright : Integrable (fun y : E3 ↦ C * R y) := hR.const_mul C
  have hfacnonneg (i : Fin 3) : 0 ≤
      ∫ x : ℝ, bracketKernel x * bracketKernelAt
        (t ^ α.weight i) (p i) x := by
    apply integral_nonneg
    intro x
    exact mul_nonneg (bracketKernel_nonneg _)
      (bracketKernelAt_nonneg (pow_pos ht _).le)
  have hfacbound (i : Fin 3) :
      ∫ x : ℝ, bracketKernel x * bracketKernelAt
        (t ^ α.weight i) (p i) x ≤
        (2 : ℝ) ^ 13 / (1 + |p i|) :=
    integral_bracketKernel_mul_bracketKernelAt_le_uniform
      (pow_pos ht _) (p i)
  have hprod : (∏ i : Fin 3, ∫ x : ℝ,
      bracketKernel x * bracketKernelAt (t ^ α.weight i) (p i) x) ≤
      ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) := by
    apply Finset.prod_le_prod₀
    · intro i _
      exact hfacnonneg i
    · intro i _
      exact hfacbound i
  calc
    fourthMoment α t p f = ∫ y : E3,
        |f y| ^ (4 : ℝ) * anisotropicBracketKernel α t p y := rfl
    _ ≤ ∫ y : E3, C * R y :=
      MeasureTheory.integral_mono_ae hleft hright
        (Filter.Eventually.of_forall fun y ↦ by
          have hK : 0 ≤ anisotropicBracketKernel α t p y :=
            anisotropicBracketKernel_nonneg α ht.le p y
          calc
            |f y| ^ (4 : ℝ) * anisotropicBracketKernel α t p y ≤
                (C * ∏ i : Fin 3, bracketKernel (y i)) *
                  anisotropicBracketKernel α t p y :=
              mul_le_mul_of_nonneg_right (henv y) hK
            _ = C * R y := by
              dsimp only [R]
              ring)
    _ = C * ∫ y : E3, R y := by rw [MeasureTheory.integral_const_mul]
    _ = C * ∏ i : Fin 3, ∫ x : ℝ,
        bracketKernel x * bracketKernelAt (t ^ α.weight i) (p i) x := by
      rw [integral_prod_bracketKernel_mul_anisotropicBracketKernel α ht p]
    _ ≤ C * ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) :=
      mul_le_mul_of_nonneg_left hprod hC

/-- A single fourth-moment envelope coefficient works simultaneously at all
positive anisotropic scales. -/
theorem fourthMoment_uniform_of_realSchwartz
    (α : Anisotropy) (f : SchwartzMap E3 ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (t : ℝ), 0 < t → ∀ p : E3,
      fourthMoment α t p f ≤ C *
        ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) := by
  rcases realSchwartz_rpow_four_le_prod_bracketKernel f with
    ⟨C, hC, henv⟩
  refine ⟨C, hC, fun t ht p ↦ ?_⟩
  exact fourthMoment_le_uniform_product_envelope α ht p f hC henv

/-- The exponent-four all-positive-scales maximal power inherits the same
explicit product tail. -/
theorem anisotropicMaximalFourPower_le_uniform_of_realSchwartz
    (α : Anisotropy) (f : SchwartzMap E3 ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ p : E3,
      anisotropicMaximalFourPower α f p ≤ C *
        ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) := by
  rcases fourthMoment_uniform_of_realSchwartz α f with
    ⟨C, hC, hmoment⟩
  refine ⟨C, hC, fun p ↦ ?_⟩
  unfold anisotropicMaximalFourPower
  apply csSup_le
  · exact ⟨fourthMoment α 1 p f, ⟨1, by norm_num, rfl⟩⟩
  · rintro a ⟨t, ht, rfl⟩
    exact hmoment t ht p

/-- Taking the positive fourth root preserves the cocompact tail of the
explicit maximal envelope. -/
theorem tendsto_uniform_maximalEnvelope_rpow_four_inv
    (C : ℝ) (hC : 0 ≤ C) :
    Tendsto (fun p : E3 ↦ (C *
      ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|))) ^ ((4 : ℝ)⁻¹))
      (cocompact E3) (𝓝 0) := by
  have henv := tendsto_uniform_maximalEnvelope C hC
  have hcont := (Real.continuous_rpow_const
    (by positivity : 0 ≤ (4 : ℝ)⁻¹)).tendsto 0
  convert hcont.comp henv using 1
  · ext p
    rfl
  · rw [Real.zero_rpow (by positivity : (4 : ℝ)⁻¹ ≠ 0)]

/-- The full literal exponent-four anisotropic maximal function of a real
Schwartz input tends to zero at spatial infinity. -/
theorem tendsto_anisotropicMaximalFour_of_realSchwartz
    (α : Anisotropy) (f : SchwartzMap E3 ℝ) :
    Tendsto (anisotropicMaximalFour α f) (cocompact E3) (𝓝 0) := by
  rcases anisotropicMaximalFourPower_le_uniform_of_realSchwartz α f
    with ⟨C, hC, hbound⟩
  rcases fourthMoment_uniform_of_realSchwartz α f with
    ⟨D, hD, hmoment⟩
  have henv : Tendsto (fun p : E3 ↦ (C *
      ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|))) ^ ((4 : ℝ)⁻¹))
      (cocompact E3) (𝓝 0) :=
    tendsto_uniform_maximalEnvelope_rpow_four_inv C hC
  have hHnonneg (p : E3) : 0 ≤ C *
      ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|)) :=
    mul_nonneg hC (Finset.prod_nonneg fun i _ ↦ by positivity)
  have hmaxnonneg (p : E3) : 0 ≤ anisotropicMaximalFourPower α f p := by
    let H : ℝ := D * ∏ i : Fin 3, ((2 : ℝ) ^ 13 / (1 + |p i|))
    have hbdd : BddAbove {a : ℝ | ∃ t : ℝ, 0 < t ∧
        a = fourthMoment α t p f} := by
      refine ⟨H, ?_⟩
      rintro a ⟨t, ht, rfl⟩
      exact hmoment t ht p
    calc
      0 ≤ fourthMoment α 1 p f := fourthMoment_nonneg α (by norm_num) p f
      _ ≤ anisotropicMaximalFourPower α f p := by
        unfold anisotropicMaximalFourPower
        apply le_csSup hbdd
        exact ⟨1, by norm_num, rfl⟩
  change Tendsto (fun p : E3 ↦
      (anisotropicMaximalFourPower α f p) ^ ((4 : ℝ)⁻¹))
    (cocompact E3) (𝓝 0)
  apply squeeze_zero
  · intro p
    exact Real.rpow_nonneg (hmaxnonneg p) _
  · intro p
    exact Real.rpow_le_rpow (hmaxnonneg p) (hbound p) (by positivity)
  · exact henv

/-- All four literal stopping maximal functions of an initial real Schwartz
tuple vanish at spatial infinity. -/
theorem tendsto_sourceStoppingMaximal_of_initialModelRealSchwartz
    (α : Anisotropy) (F : InitialModelSchwartzInput) :
    ∀ j : Fin 4, Tendsto (sourceStoppingMaximal α (InitialModelRealInput F) j)
      (cocompact E3) (𝓝 0) := by
  apply tendsto_sourceStoppingMaximal_of_tails α (InitialModelRealInput F)
  · simpa only [InitialModelRealInput] using
      tendsto_anisotropicMaximalTwo_of_realSchwartz α (F 3)
  · intro j hj
    simpa only [InitialModelRealInput] using
      tendsto_anisotropicMaximalFour_of_realSchwartz α (F j)

/-- Consequently, every source stopping level of an initial real Schwartz
tuple has finite Lebesgue measure. This is the direct tail-based discharge
of the formerly external maximal-function hypothesis. -/
theorem sourceStopping_coordinateLevel_finite_of_initialModelRealSchwartz
    (α : Anisotropy) (F : InitialModelSchwartzInput) :
    ∀ (j : Fin 4) (m : ℤ),
      volume (sourceStoppingMaximalLevelSetAt α
        (InitialModelRealInput F) j m) ≠ ∞ := by
  apply sourceStopping_coordinateLevel_finite_of_maximal_tails
    α (InitialModelRealInput F)
  · simpa only [InitialModelRealInput] using
      tendsto_anisotropicMaximalTwo_of_realSchwartz α (F 3)
  · intro j hj
    simpa only [InitialModelRealInput] using
      tendsto_anisotropicMaximalFour_of_realSchwartz α (F j)

/-! ### Mean-zero profile-kernel cancellation -/

/-- A real Schwartz function has a global Lipschitz bound supplied by its
first derivative seminorm. -/
theorem schwartz_real_global_lipschitz (f : SchwartzMap E3 ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x y : E3,
      ‖f y - f x‖ ≤ C * ‖y - x‖ := by
  refine ⟨SchwartzMap.seminorm ℝ 0 1 f, ?_, ?_⟩
  · exact le_trans (norm_nonneg (fderiv ℝ f (0 : E3)))
      (by simpa only [norm_iteratedFDeriv_one] using
        SchwartzMap.norm_iteratedFDeriv_le_seminorm ℝ f 1 (0 : E3))
  · intro x y
    apply Convex.norm_image_sub_le_of_norm_fderiv_le (𝕜 := ℝ)
    · intro z _
      exact f.differentiableAt
    · intro z _
      simpa only [norm_iteratedFDeriv_one] using
        SchwartzMap.norm_iteratedFDeriv_le_seminorm ℝ f 1 z
    · exact convex_univ
    · exact Set.mem_univ _
    · exact Set.mem_univ _

/-- The first absolute moment of a normalized positive dilation has the
expected linear scaling. -/
theorem integral_abs_mul_kernelDilate (k : ℝ → ℝ) {s : ℝ}
    (hs : 0 < s) :
    ∫ x : ℝ, |x| * |kernelDilate k s x| =
      s * ∫ z : ℝ, |z| * |k z| := by
  unfold kernelDilate
  have hinv : 0 ≤ s⁻¹ := (inv_pos.mpr hs).le
  have hpoint (x : ℝ) :
      |x| * |s⁻¹ • k (x / s)| =
        s⁻¹ * (s * (|x / s| * |k (x / s)|)) := by
    simp only [smul_eq_mul, abs_mul, abs_of_nonneg hinv]
    rw [abs_div, abs_of_pos hs]
    field_simp [hs.ne']
  calc
    (∫ x : ℝ, |x| * |s⁻¹ • k (x / s)|) =
        ∫ x : ℝ, s⁻¹ * (s * (|x / s| * |k (x / s)|)) := by
          apply integral_congr_ae
          filter_upwards [] with x
          exact hpoint x
    _ = s⁻¹ * (s * ∫ x : ℝ, |x / s| * |k (x / s)|) := by
          rw [integral_const_mul, integral_const_mul]
    _ = s⁻¹ * (s * (s * ∫ z : ℝ, |z| * |k z|)) := by
          have hchange : (∫ x : ℝ, |x / s| * |k (x / s)|) =
              s * ∫ z : ℝ, |z| * |k z| := by
            change (∫ x : ℝ, (fun z : ℝ ↦ |z| * |k z|) (x / s)) = _
            rw [Measure.integral_comp_div (fun z : ℝ ↦ |z| * |k z|) s]
            simp only [smul_eq_mul, abs_of_pos hs]
          rw [hchange]
    _ = s * ∫ z : ℝ, |z| * |k z| := by field_simp

/-- The Euclidean norm of a scalar coordinate displacement is its absolute
scalar size. -/
theorem norm_smul_coordinateDirection (i : Fin 3) (r : ℝ) :
    ‖r • Anisotropy.coordinateDirection i‖ = |r| := by
  rw [norm_smul]
  simp [Anisotropy.coordinateDirection]

/-- Normalized positive dilation preserves the signed integral. -/
theorem integral_kernelDilate (k : ℝ → ℝ) {s : ℝ} (hs : 0 < s) :
    ∫ x : ℝ, kernelDilate k s x = ∫ z : ℝ, k z := by
  unfold kernelDilate
  rw [integral_smul, Measure.integral_comp_div k s]
  simp [smul_eq_mul, abs_of_pos hs, hs.ne']

/-- Finite first absolute moment is preserved under every positive normalized
dilation. -/
theorem integrable_abs_mul_kernelDilate (k : ℝ → ℝ)
    (hk : Integrable (fun z : ℝ ↦ |z| * |k z|)) {s : ℝ} (hs : 0 < s) :
    Integrable (fun x : ℝ ↦ |x| * |kernelDilate k s x|) := by
  have hbase : Integrable (fun x : ℝ ↦ |x / s| * |k (x / s)|) :=
    hk.comp_div hs.ne'
  refine hbase.congr ?_
  filter_upwards [] with x
  unfold kernelDilate
  simp only [smul_eq_mul, abs_mul, abs_of_pos (inv_pos.mpr hs)]
  rw [abs_div, abs_of_pos hs]
  field_simp [hs.ne']

/-- A mean-zero coordinate kernel gains one factor of its scale against a
directionally Lipschitz input. -/
theorem abs_ModelCoordinateConvolution_le_of_mean_zero
    (i : Fin 3) (f : E3 → ℝ) (k : ℝ → ℝ) (s : ℝ) (x : E3)
    (hfcont : Continuous f) (L : ℝ)
    (hLip : ∀ r : ℝ,
      |f (x - r • Anisotropy.coordinateDirection i) - f x| ≤ L * |r|)
    (hk : Integrable k)
    (hkmoment : Integrable (fun r : ℝ ↦ |r| * |k r|))
    (hzero : ∫ r : ℝ, k r = 0) (hs : 0 < s) :
    |ModelCoordinateConvolution i f k s x| ≤
      L * s * ∫ r : ℝ, |r| * |k r| := by
  let kd : ℝ → ℝ := fun r ↦ kernelDilate k s r
  let B : ℝ → ℝ := fun r ↦
    (f (x - r • Anisotropy.coordinateDirection i) - f x) * kd r
  have hkd : Integrable kd := by
    dsimp only [kd]
    exact integrable_kernelDilate hk hs.ne'
  have hmomentd : Integrable (fun r : ℝ ↦ |r| * |kd r|) := by
    dsimp only [kd]
    exact integrable_abs_mul_kernelDilate k hkmoment hs
  have hmap : Continuous (fun r : ℝ ↦
      x - r • Anisotropy.coordinateDirection i) :=
    continuous_const.sub (continuous_id.smul continuous_const)
  have hBmeas : AEStronglyMeasurable B volume := by
    dsimp only [B]
    exact (((hfcont.comp hmap).sub continuous_const).aestronglyMeasurable).mul
      hkd.aestronglyMeasurable
  have hB : Integrable B := by
    apply (hmomentd.const_mul L).mono' hBmeas
    filter_upwards [] with r
    dsimp only [B]
    rw [Real.norm_eq_abs, abs_mul]
    simpa [mul_assoc] using
      (mul_le_mul_of_nonneg_right (hLip r) (abs_nonneg (kd r)))
  have hsplit : (fun r : ℝ ↦
      f (x - r • Anisotropy.coordinateDirection i) * kd r) =
      fun r ↦ B r + f x * kd r := by
    funext r
    dsimp only [B]
    ring
  have hconst : Integrable (fun r : ℝ ↦ f x * kd r) := hkd.const_mul (f x)
  have hzero_d : (∫ r : ℝ, kd r) = 0 := by
    dsimp only [kd]
    rw [integral_kernelDilate k hs, hzero]
  have hrewrite : (∫ r : ℝ,
      f (x - r • Anisotropy.coordinateDirection i) * kd r) = ∫ r : ℝ, B r := by
    rw [hsplit, integral_add hB hconst, integral_const_mul, hzero_d]
    ring
  unfold ModelCoordinateConvolution
  change |∫ r : ℝ,
      f (x - r • Anisotropy.coordinateDirection i) * kd r| ≤ _
  rw [hrewrite]
  calc
    |∫ r : ℝ, B r| ≤ ∫ r : ℝ, |B r| :=
      MeasureTheory.abs_integral_le_integral_abs
    _ ≤ ∫ r : ℝ, L * (|r| * |kd r|) := by
      apply integral_mono hB.norm (hmomentd.const_mul L)
      intro r
      dsimp only [B]
      rw [Real.norm_eq_abs, abs_mul]
      simpa [mul_assoc] using
        (mul_le_mul_of_nonneg_right (hLip r) (abs_nonneg (kd r)))
    _ = L * (s * ∫ r : ℝ, |r| * |k r|) := by
      rw [integral_const_mul, integral_abs_mul_kernelDilate k hs]
    _ = L * s * ∫ r : ℝ, |r| * |k r| := by ring

/-- The preceding cancellation estimate applies directly to a real Schwartz
input, with its global first-derivative seminorm furnishing the Lipschitz
constant. -/
theorem abs_ModelCoordinateConvolution_schwartz_le_of_mean_zero
    (i : Fin 3) (f : SchwartzMap E3 ℝ) (k : ℝ → ℝ) (s : ℝ) (x : E3)
    (hk : Integrable k)
    (hkmoment : Integrable (fun r : ℝ ↦ |r| * |k r|))
    (hzero : ∫ r : ℝ, k r = 0) (hs : 0 < s) :
    ∃ L : ℝ, 0 ≤ L ∧
      |ModelCoordinateConvolution i f k s x| ≤
        L * s * ∫ r : ℝ, |r| * |k r| := by
  rcases schwartz_real_global_lipschitz f with ⟨L, hL, hLip⟩
  refine ⟨L, hL, ?_⟩
  apply abs_ModelCoordinateConvolution_le_of_mean_zero
    i f k s x f.continuous L ?_ hk hkmoment hzero hs
  intro r
  have h := hLip x (x - r • Anisotropy.coordinateDirection i)
  have hv : x - r • Anisotropy.coordinateDirection i - x =
      -(r • Anisotropy.coordinateDirection i) := by abel
  rw [Real.norm_eq_abs, hv, norm_neg,
    norm_smul_coordinateDirection] at h
  exact h

/-- The Gaussian derivative has finite first absolute moment. -/
theorem integrable_abs_mul_gaussianDeriv :
    Integrable (fun x : ℝ ↦ |x| * |gaussianDeriv x|) := by
  have hbase : Integrable (fun x : ℝ ↦ x ^ (2 : ℝ) *
      Real.exp (-Real.pi * x ^ 2)) :=
    integrable_rpow_mul_exp_neg_mul_sq Real.pi_pos (by norm_num)
  have hscaled := hbase.const_mul (2 * Real.pi)
  apply hscaled.congr
  filter_upwards [] with x
  rw [Real.rpow_two]
  simp only [gaussianDeriv, gaussian, abs_mul, abs_of_pos Real.pi_pos,
    abs_of_nonneg (Real.exp_pos _).le]
  norm_num
  have hsq : |x| * |x| = x ^ 2 := by
    rw [← pow_two, sq_abs]
  calc
    2 * Real.pi * (x ^ 2 * Real.exp (-(Real.pi * x ^ 2))) =
        (|x| * |x|) * (2 * Real.pi * Real.exp (-(Real.pi * x ^ 2))) := by
          rw [hsq]
          ring
    _ = |x| * (2 * Real.pi * |x| * Real.exp (-(Real.pi * x ^ 2))) := by
          ring

/-- The fixed annular physical cutoff has finite first absolute moment. -/
theorem integrable_abs_mul_conePsiPhysicalReal :
    Integrable (fun x : ℝ ↦ |x| * |conePsiPhysicalReal x|) := by
  simpa only [Real.norm_eq_abs, pow_one] using
    (conePsiPhysicalReal.integrable_pow_mul volume 1)

/-- A bounded kernel has a scale-decaying coordinate convolution bound once
the input has finite absolute mass on that coordinate line. -/
theorem abs_ModelCoordinateConvolution_le_of_bounded_kernel_line_mass
    (i : Fin 3) (f : E3 → ℝ) (k : ℝ → ℝ) (s : ℝ) (x : E3)
    (hk : Integrable k) (A : ℝ)
    (hkbound : ∀ r : ℝ, |k r| ≤ A)
    (hline : Integrable (fun r : ℝ ↦
      f (x - r • Anisotropy.coordinateDirection i)))
    (hs : 0 < s) :
    |ModelCoordinateConvolution i f k s x| ≤
      s⁻¹ * A * ∫ r : ℝ, |f (x - r • Anisotropy.coordinateDirection i)| := by
  let h : ℝ → ℝ := fun r ↦ f (x - r • Anisotropy.coordinateDirection i)
  let kd : ℝ → ℝ := fun r ↦ kernelDilate k s r
  have hkd : Integrable kd := by
    dsimp only [kd]
    exact integrable_kernelDilate hk hs.ne'
  have hupper : Integrable (fun r : ℝ ↦ s⁻¹ * A * |h r|) :=
    hline.norm.const_mul (s⁻¹ * A)
  have hGmeas : AEStronglyMeasurable (fun r : ℝ ↦ h r * kd r) volume :=
    hline.aestronglyMeasurable.mul hkd.aestronglyMeasurable
  have hG : Integrable (fun r : ℝ ↦ h r * kd r) := by
    apply hupper.mono' hGmeas
    filter_upwards [] with r
    dsimp only [kd]
    rw [Real.norm_eq_abs, abs_mul, kernelDilate, smul_eq_mul, abs_mul,
      abs_of_pos (inv_pos.mpr hs)]
    calc
      |h r| * (s⁻¹ * |k (r / s)|) ≤ |h r| * (s⁻¹ * A) :=
        mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_left (hkbound (r / s)) (inv_pos.mpr hs).le)
          (abs_nonneg _)
      _ = s⁻¹ * A * |h r| := by ring
  unfold ModelCoordinateConvolution
  change |∫ r : ℝ, h r * kd r| ≤ _
  calc
    |∫ r : ℝ, h r * kd r| ≤ ∫ r : ℝ, |h r * kd r| :=
      MeasureTheory.abs_integral_le_integral_abs
    _ ≤ ∫ r : ℝ, s⁻¹ * A * |h r| := by
      apply integral_mono hG.norm hupper
      intro r
      dsimp only [kd]
      rw [Real.norm_eq_abs, abs_mul, kernelDilate, smul_eq_mul, abs_mul,
        abs_of_pos (inv_pos.mpr hs)]
      calc
        |h r| * (s⁻¹ * |k (r / s)|) ≤ |h r| * (s⁻¹ * A) :=
          mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_left (hkbound (r / s)) (inv_pos.mpr hs).le)
            (abs_nonneg _)
        _ = s⁻¹ * A * |h r| := by ring
    _ = s⁻¹ * A * ∫ r : ℝ, |h r| := by
      rw [integral_const_mul]

/-! ### Fixed-scale center localization -/

/-- The measure-preserving shear from a base point and a coordinatewise
difference to the corresponding pair of base and sampled points. -/
noncomputable def modelDifferenceCoordinates : E3 × E3 ≃ᵐ E3 × E3 where
  toEquiv :=
    { toFun := fun z ↦ (z.1, z.1 - z.2)
      invFun := fun z ↦ (z.1, z.1 - z.2)
      left_inv := by
        rintro ⟨x, r⟩
        simp
      right_inv := by
        rintro ⟨x, y⟩
        simp }
  measurable_toFun := measurable_fst.prodMk (measurable_fst.sub measurable_snd)
  measurable_invFun := measurable_fst.prodMk (measurable_fst.sub measurable_snd)

/-- The difference-coordinate shear preserves product Lebesgue measure. -/
theorem modelDifferenceCoordinates_measurePreserving :
    MeasurePreserving modelDifferenceCoordinates
      ((volume : Measure E3).prod volume)
      ((volume : Measure E3).prod volume) := by
  have hneg : MeasurePreserving (fun z : E3 × E3 ↦ (z.1, -z.2))
      ((volume : Measure E3).prod volume)
      ((volume : Measure E3).prod volume) :=
    (MeasurePreserving.id (volume : Measure E3)).prod
      (Measure.measurePreserving_neg (volume : Measure E3))
  have hadd : MeasurePreserving (fun z : E3 × E3 ↦ (z.1, z.2 + z.1))
      ((volume : Measure E3).prod volume)
      ((volume : Measure E3).prod volume) :=
    measurePreserving_prod_add_right (volume : Measure E3) volume
  have h := hadd.comp hneg
  convert h using 1
  funext z
  change (z.1, z.1 - z.2) = (z.1, -z.2 + z.1)
  abel_nf

/-- Subtracting a scalar multiple of the first coordinate direction changes
only the first entry of a literal `modelPoint`. -/
theorem modelPoint_sub_coordinateDirection_zero
    (a b c r : ℝ) :
    modelPoint a b c - r • Anisotropy.coordinateDirection 0 =
      modelPoint (a - r) b c := by
  ext i
  fin_cases i <;> simp [modelPoint, coordinateDirection_apply]

/-- The analogous coordinate identity in the second direction. -/
theorem modelPoint_sub_coordinateDirection_one
    (a b c r : ℝ) :
    modelPoint a b c - r • Anisotropy.coordinateDirection 1 =
      modelPoint a (b - r) c := by
  ext i
  fin_cases i <;> simp [modelPoint, coordinateDirection_apply]

/-- The analogous coordinate identity in the third direction. -/
theorem modelPoint_sub_coordinateDirection_two
    (a b c r : ℝ) :
    modelPoint a b c - r • Anisotropy.coordinateDirection 2 =
      modelPoint a b (c - r) := by
  ext i
  fin_cases i <;> simp [modelPoint, coordinateDirection_apply]

/-- The first coordinate convolution at a literal point can be written in
the sampled-variable convention of the expanded local form. -/
theorem ModelCoordinateConvolution_zero_modelPoint
    (f : E3 → ℝ) (k : ℝ → ℝ) (s a b c : ℝ) :
    ModelCoordinateConvolution 0 f k s (modelPoint a b c) =
      ∫ y : ℝ, f (modelPoint y b c) * kernelDilate k s (a - y) := by
  let G : ℝ → ℝ := fun y ↦
    f (modelPoint y b c) * kernelDilate k s (a - y)
  unfold ModelCoordinateConvolution
  calc
    (∫ r : ℝ, f (modelPoint a b c -
        r • Anisotropy.coordinateDirection 0) * kernelDilate k s r) =
        ∫ r : ℝ, G (a - r) := by
          apply integral_congr_ae
          filter_upwards [] with r
          dsimp only [G]
          rw [modelPoint_sub_coordinateDirection_zero]
          congr 1
          ring_nf
    _ = ∫ y : ℝ, G y := integral_sub_left_eq_self G volume a

/-- The second coordinate convolution at a literal point in sampled-variable
coordinates. -/
theorem ModelCoordinateConvolution_one_modelPoint
    (f : E3 → ℝ) (k : ℝ → ℝ) (s a b c : ℝ) :
    ModelCoordinateConvolution 1 f k s (modelPoint a b c) =
      ∫ y : ℝ, f (modelPoint a y c) * kernelDilate k s (b - y) := by
  let G : ℝ → ℝ := fun y ↦
    f (modelPoint a y c) * kernelDilate k s (b - y)
  unfold ModelCoordinateConvolution
  calc
    (∫ r : ℝ, f (modelPoint a b c -
        r • Anisotropy.coordinateDirection 1) * kernelDilate k s r) =
        ∫ r : ℝ, G (b - r) := by
          apply integral_congr_ae
          filter_upwards [] with r
          dsimp only [G]
          rw [modelPoint_sub_coordinateDirection_one]
          congr 1
          ring_nf
    _ = ∫ y : ℝ, G y := integral_sub_left_eq_self G volume b

/-- The third coordinate convolution at a literal point in sampled-variable
coordinates. -/
theorem ModelCoordinateConvolution_two_modelPoint
    (f : E3 → ℝ) (k : ℝ → ℝ) (s a b c : ℝ) :
    ModelCoordinateConvolution 2 f k s (modelPoint a b c) =
      ∫ y : ℝ, f (modelPoint a b y) * kernelDilate k s (c - y) := by
  let G : ℝ → ℝ := fun y ↦
    f (modelPoint a b y) * kernelDilate k s (c - y)
  unfold ModelCoordinateConvolution
  calc
    (∫ r : ℝ, f (modelPoint a b c -
        r • Anisotropy.coordinateDirection 2) * kernelDilate k s r) =
        ∫ r : ℝ, G (c - r) := by
          apply integral_congr_ae
          filter_upwards [] with r
          dsimp only [G]
          rw [modelPoint_sub_coordinateDirection_two]
          congr 1
          ring_nf
    _ = ∫ y : ℝ, G y := integral_sub_left_eq_self G volume c

/-- At a literal spatial point, the unexpanded model integrand is the product
of the three sampled-variable coordinate convolutions. -/
theorem ModelSpatialIntegrand_modelPoint_expand
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput)
    (t a b c : ℝ) :
    ModelSpatialIntegrand α u F t (modelPoint a b c) =
      F 0 (modelPoint a b c) *
        (∫ y₁ : ℝ,
          F 1 (modelPoint y₁ b c) *
            kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0) (a - y₁)) *
        (∫ y₂ : ℝ,
          F 2 (modelPoint a y₂ c) *
            kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1) (b - y₂)) *
        (∫ y₃ : ℝ,
          F 3 (modelPoint a b y₃) *
            kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2) (c - y₃)) := by
  unfold ModelSpatialIntegrand
  rw [ModelCoordinateConvolution_zero_modelPoint,
    ModelCoordinateConvolution_one_modelPoint,
    ModelCoordinateConvolution_two_modelPoint]

/-- The spatial profile can consequently be written over the three literal
Euclidean coordinates. -/
theorem ModelSpatialProfile_eq_coordinateIntegral
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ) :
    ModelSpatialProfile α u F t =
      ∫ z : ℝ × (ℝ × ℝ),
        F 0 (modelPoint z.1 z.2.1 z.2.2) *
          (∫ y₁ : ℝ,
            F 1 (modelPoint y₁ z.2.1 z.2.2) *
              kernelDilate (ModelLowKernel (u 0))
                (t ^ α.weight 0) (z.1 - y₁)) *
          (∫ y₂ : ℝ,
            F 2 (modelPoint z.1 y₂ z.2.2) *
              kernelDilate (ModelLowKernel (u 1))
                (t ^ α.weight 1) (z.2.1 - y₂)) *
          (∫ y₃ : ℝ,
            F 3 (modelPoint z.1 z.2.1 y₃) *
              kernelDilate (ModelThirdKernel (u 2))
                (t ^ α.weight 2) (z.2.2 - y₃)) := by
  let G : E3 → ℝ := fun x ↦ ModelSpatialIntegrand α u F t x
  let e : E3 ≃ᵐ ℝ × (ℝ × ℝ) := e3Coordinates
  have hmp : MeasurePreserving e (volume : Measure E3)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    simpa only [e] using e3Coordinates_measurePreserving
  change (∫ x : E3, G x) = _
  calc
    (∫ x : E3, G x) = ∫ z : ℝ × (ℝ × ℝ), G (e.symm z) := by
      exact (MeasurePreserving.symm e hmp).integral_comp
        e.symm.measurableEmbedding G |>.symm
    _ = _ := by
      apply integral_congr_ae
      filter_upwards [] with z
      have hcoords : e.symm z = modelPoint z.1 z.2.1 z.2.2 := by
        apply e.injective
        rw [e.apply_symm_apply]
        simp only [e, e3Coordinates_apply, modelPoint_zero,
          modelPoint_one, modelPoint_two]
      have hpoint := ModelSpatialIntegrand_modelPoint_expand
        α u F t z.1 z.2.1 z.2.2
      dsimp only [G]
      rw [hcoords]
      exact hpoint

/-- A product of three one-dimensional factors integrates over `E3` as the
product of its coordinate integrals. -/
theorem integral_E3_coordinate_product
    (A₀ A₁ A₂ : ℝ → ℝ) :
    (∫ y : E3, A₀ (y 0) * A₁ (y 1) * A₂ (y 2)) =
      (∫ r : ℝ, A₀ r) * (∫ r : ℝ, A₁ r) * ∫ r : ℝ, A₂ r := by
  let e : E3 ≃ᵐ ℝ × (ℝ × ℝ) := e3Coordinates
  have hmp : MeasurePreserving e (volume : Measure E3)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    simpa only [e] using e3Coordinates_measurePreserving
  calc
    (∫ y : E3, A₀ (y 0) * A₁ (y 1) * A₂ (y 2)) =
        ∫ z : ℝ × (ℝ × ℝ),
          A₀ ((e.symm z) 0) * A₁ ((e.symm z) 1) * A₂ ((e.symm z) 2) := by
          exact (MeasurePreserving.symm e hmp).integral_comp
            e.symm.measurableEmbedding _ |>.symm
    _ = ∫ z : ℝ × (ℝ × ℝ),
          A₀ z.1 * A₁ z.2.1 * A₂ z.2.2 := by
          apply integral_congr_ae
          filter_upwards [] with z
          have heq := e.apply_symm_apply z
          have h0 : (e.symm z) 0 = z.1 := by
            simpa only [e, e3Coordinates_apply] using congrArg Prod.fst heq
          have h1 : (e.symm z) 1 = z.2.1 := by
            simpa only [e, e3Coordinates_apply] using
              congrArg (fun q : ℝ × (ℝ × ℝ) ↦ q.2.1) heq
          have h2 : (e.symm z) 2 = z.2.2 := by
            simpa only [e, e3Coordinates_apply] using
              congrArg (fun q : ℝ × (ℝ × ℝ) ↦ q.2.2) heq
          rw [h0, h1, h2]
    _ = (∫ r : ℝ, A₀ r) * (∫ r : ℝ, A₁ r) * ∫ r : ℝ, A₂ r := by
          rw [Measure.volume_eq_prod]
          calc
            (∫ z : ℝ × (ℝ × ℝ), A₀ z.1 * A₁ z.2.1 * A₂ z.2.2
              ∂((volume : Measure ℝ).prod volume)) =
                (∫ r : ℝ, A₀ r) *
                  ∫ q : ℝ × ℝ, A₁ q.1 * A₂ q.2 := by
                    rw [show (fun z : ℝ × (ℝ × ℝ) ↦
                      A₀ z.1 * A₁ z.2.1 * A₂ z.2.2) =
                        fun z ↦ A₀ z.1 * (A₁ z.2.1 * A₂ z.2.2) by
                          funext z
                          ring]
                    exact MeasureTheory.integral_prod_mul A₀
                      (fun q : ℝ × ℝ ↦ A₁ q.1 * A₂ q.2)
            _ = (∫ r : ℝ, A₀ r) * (∫ r : ℝ, A₁ r) * ∫ r : ℝ, A₂ r := by
                    rw [Measure.volume_eq_prod]
                    rw [MeasureTheory.integral_prod_mul]
                    ring

/-- The corresponding product of three independent coordinate factors is
integrable on `E3` whenever its one-dimensional factors are integrable. -/
theorem integrable_E3_coordinate_product
    (A₀ A₁ A₂ : ℝ → ℝ)
    (hA₀ : Integrable A₀) (hA₁ : Integrable A₁) (hA₂ : Integrable A₂) :
    Integrable (fun y : E3 ↦ A₀ (y 0) * A₁ (y 1) * A₂ (y 2)) := by
  let e : E3 ≃ᵐ ℝ × (ℝ × ℝ) := e3Coordinates
  have hmp : MeasurePreserving e (volume : Measure E3)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    simpa only [e] using e3Coordinates_measurePreserving
  have hprod : Integrable (fun z : ℝ × (ℝ × ℝ) ↦
      A₀ z.1 * (A₁ z.2.1 * A₂ z.2.2))
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    exact hA₀.mul_prod (hA₁.mul_prod hA₂)
  have htrans : Integrable (fun y : E3 ↦
      A₀ ((e y).1) * (A₁ ((e y).2.1) * A₂ ((e y).2.2))) := by
    exact hmp.integrable_comp_of_integrable hprod
  apply htrans.congr
  filter_upwards [] with y
  simp only [e, e3Coordinates_apply]
  ring

/-- The three sampled coordinate kernels can be recombined into one literal
`E3` integral at a fixed spatial point. -/
theorem ModelSpatialIntegrand_modelPoint_eq_kernelIntegral
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput)
    (t a b c : ℝ) :
    ModelSpatialIntegrand α u F t (modelPoint a b c) =
      F 0 (modelPoint a b c) *
        ∫ y : E3,
          (F 1 (modelPoint (y 0) b c) *
              kernelDilate (ModelLowKernel (u 0))
                (t ^ α.weight 0) (a - y 0)) *
            (F 2 (modelPoint a (y 1) c) *
              kernelDilate (ModelLowKernel (u 1))
                (t ^ α.weight 1) (b - y 1)) *
            (F 3 (modelPoint a b (y 2)) *
              kernelDilate (ModelThirdKernel (u 2))
                (t ^ α.weight 2) (c - y 2)) := by
  let A₀ : ℝ → ℝ := fun y ↦
    F 1 (modelPoint y b c) *
      kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0) (a - y)
  let A₁ : ℝ → ℝ := fun y ↦
    F 2 (modelPoint a y c) *
      kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1) (b - y)
  let A₂ : ℝ → ℝ := fun y ↦
    F 3 (modelPoint a b y) *
      kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2) (c - y)
  have hproduct := integral_E3_coordinate_product A₀ A₁ A₂
  rw [ModelSpatialIntegrand_modelPoint_expand]
  change F 0 (modelPoint a b c) * (∫ y : ℝ, A₀ y) *
      (∫ y : ℝ, A₁ y) * (∫ y : ℝ, A₂ y) = _
  calc
    F 0 (modelPoint a b c) * (∫ y : ℝ, A₀ y) *
        (∫ y : ℝ, A₁ y) * (∫ y : ℝ, A₂ y) =
        F 0 (modelPoint a b c) *
          ((∫ y : ℝ, A₀ y) * (∫ y : ℝ, A₁ y) * ∫ y : ℝ, A₂ y) := by
            ring
    _ = F 0 (modelPoint a b c) *
        (∫ y : E3, A₀ (y 0) * A₁ (y 1) * A₂ (y 2)) := by
          rw [← hproduct]
    _ = _ := by
          rfl

/-- Every ambient point is the literal `modelPoint` assembled from its three
coordinates. -/
theorem modelPoint_components (x : E3) :
    modelPoint (x 0) (x 1) (x 2) = x := by
  ext i
  fin_cases i <;> simp

/-- The coordinate-product expansion of the spatial model integrand, stated
without choosing coordinates for the outer point. -/
theorem ModelSpatialIntegrand_eq_kernelIntegral
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput)
    (t : ℝ) (x : E3) :
    ModelSpatialIntegrand α u F t x =
      F 0 x *
        ∫ y : E3,
          (F 1 (modelPoint (y 0) (x 1) (x 2)) *
              kernelDilate (ModelLowKernel (u 0))
                (t ^ α.weight 0) (x 0 - y 0)) *
            (F 2 (modelPoint (x 0) (y 1) (x 2)) *
              kernelDilate (ModelLowKernel (u 1))
                (t ^ α.weight 1) (x 1 - y 1)) *
            (F 3 (modelPoint (x 0) (x 1) (y 2)) *
              kernelDilate (ModelThirdKernel (u 2))
                (t ^ α.weight 2) (x 2 - y 2)) := by
  have h := ModelSpatialIntegrand_modelPoint_eq_kernelIntegral
    α u F t (x 0) (x 1) (x 2)
  rw [modelPoint_components x] at h
  exact h

/-- The fixed-scale spatial profile after opening all three coordinate
convolutions. -/
theorem ModelSpatialProfile_eq_expandedKernelIntegral
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ) :
    ModelSpatialProfile α u F t =
      ∫ x : E3,
        F 0 x *
          (∫ y : E3,
            (F 1 (modelPoint (y 0) (x 1) (x 2)) *
                kernelDilate (ModelLowKernel (u 0))
                  (t ^ α.weight 0) (x 0 - y 0)) *
              (F 2 (modelPoint (x 0) (y 1) (x 2)) *
                kernelDilate (ModelLowKernel (u 1))
                  (t ^ α.weight 1) (x 1 - y 1)) *
              (F 3 (modelPoint (x 0) (x 1) (y 2)) *
                kernelDilate (ModelThirdKernel (u 2))
                  (t ^ α.weight 2) (x 2 - y 2))) := by
  unfold ModelSpatialProfile
  apply integral_congr_ae
  filter_upwards [] with x
  exact ModelSpatialIntegrand_eq_kernelIntegral α u F t x

/-- The literal center-expanded integrand at one positive model scale. The
outer pair contains the base point and the three sampled coordinates; the
last factor is the three-dimensional center. -/
noncomputable def ModelCenterExpandedIntegrand
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (q : (E3 × E3) × E3) : ℝ :=
  let x : E3 := q.1.1
  let y : E3 := q.1.2
  let p : E3 := q.2
  (F 0 x * F 1 (modelPoint (y 0) (x 1) (x 2)) *
      F 2 (modelPoint (x 0) (y 1) (x 2)) *
      F 3 (modelPoint (x 0) (x 1) (y 2))) *
    ((modelPhiAt (t ^ α.weight 0)
          (p 0 + t ^ α.weight 0 * u 0) (x 0) *
        gaussianAt (t ^ α.weight 0) (p 0) (y 0)) *
      (modelPhiAt (t ^ α.weight 1)
          (p 1 + t ^ α.weight 1 * u 1) (x 1) *
        gaussianAt (t ^ α.weight 1) (p 1) (y 1)) *
      (gaussianDerivAt (t ^ α.weight 2) (p 2) (x 2) *
        modelThirdKernel (u 2) (t ^ α.weight 2) (p 2) (y 2)))

/-- The post-center kernel integrand which remains after the signed third
pair has been evaluated. -/
noncomputable def ModelExpandedKernelIntegrand
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (q : E3 × E3) : ℝ :=
  let x : E3 := q.1
  let y : E3 := q.2
  (F 0 x * F 1 (modelPoint (y 0) (x 1) (x 2)) *
      F 2 (modelPoint (x 0) (y 1) (x 2)) *
      F 3 (modelPoint (x 0) (x 1) (y 2))) *
    (kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0) (x 0 - y 0) *
      kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1) (x 1 - y 1) *
      kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2) (x 2 - y 2))

/-- The product of the absolute physical kernels is integrable in the three
coordinatewise differences at every positive model scale. -/
theorem integrable_ModelKernelAbsProduct
    (α : Anisotropy) (u : E3) (t : ℝ) (ht : 0 < t) :
    Integrable (fun r : E3 ↦
      |kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0) (r 0)| *
        |kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1) (r 1)| *
        |kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2) (r 2)|) := by
  have hs₀ : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs₁ : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs₂ : 0 < t ^ α.weight 2 := pow_pos ht _
  have hK₀ : Integrable (fun r : ℝ ↦
      |kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0) r|) := by
    simpa only [Real.norm_eq_abs] using
      (integrable_ModelLowKernel_dilate (u 0) (t ^ α.weight 0) hs₀).norm
  have hK₁ : Integrable (fun r : ℝ ↦
      |kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1) r|) := by
    simpa only [Real.norm_eq_abs] using
      (integrable_ModelLowKernel_dilate (u 1) (t ^ α.weight 1) hs₁).norm
  have hK₂ : Integrable (fun r : ℝ ↦
      |kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2) r|) := by
    simpa only [Real.norm_eq_abs] using
      (integrable_ModelThirdKernel_dilate (u 2) (t ^ α.weight 2) hs₂).norm
  exact integrable_E3_coordinate_product _ _ _ hK₀ hK₁ hK₂

/-- Uniform bounds on the three convolved inputs, together with the
integrability of the base Schwartz input, make the post-center fixed-scale
kernel integrable. -/
theorem integrable_ModelExpandedKernelIntegrand_of_bounds
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (ht : 0 < t) (B₁ B₂ B₃ : ℝ)
    (hB₁ : 0 ≤ B₁) (hB₂ : 0 ≤ B₂) (hB₃ : 0 ≤ B₃)
    (hF₁ : ∀ x : E3, |F 1 x| ≤ B₁)
    (hF₂ : ∀ x : E3, |F 2 x| ≤ B₂)
    (hF₃ : ∀ x : E3, |F 3 x| ≤ B₃) :
    Integrable (ModelExpandedKernelIntegrand α u F t)
      ((volume : Measure E3).prod volume) := by
  let R : E3 → ℝ := fun r ↦
    |kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0) (r 0)| *
      |kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1) (r 1)| *
      |kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2) (r 2)|
  have hR : Integrable R := by
    simpa only [R] using integrable_ModelKernelAbsProduct α u t ht
  let B : ℝ := B₁ * B₂ * B₃
  have hB : 0 ≤ B := mul_nonneg (mul_nonneg hB₁ hB₂) hB₃
  let A : E3 → ℝ := fun x ↦ B * |F 0 x|
  have hA : Integrable A := by
    simpa only [A, Real.norm_eq_abs] using (F 0).integrable.norm.const_mul B
  have hAR : Integrable (fun q : E3 × E3 ↦ A q.1 * R q.2)
      ((volume : Measure E3).prod volume) := hA.mul_prod hR
  let e : E3 × E3 ≃ᵐ E3 × E3 := modelDifferenceCoordinates
  have hmp : MeasurePreserving e ((volume : Measure E3).prod volume)
      ((volume : Measure E3).prod volume) := by
    simpa only [e] using modelDifferenceCoordinates_measurePreserving
  have hmajorTransport : Integrable (fun q : E3 × E3 ↦
      A ((e.symm q).1) * R ((e.symm q).2))
      ((volume : Measure E3).prod volume) := by
    exact (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hAR
  have hmajor : Integrable (fun q : E3 × E3 ↦ A q.1 * R (q.1 - q.2))
      ((volume : Measure E3).prod volume) := by
    apply hmajorTransport.congr
    filter_upwards [] with q
    have heq : e.symm q = (q.1, q.1 - q.2) := by rfl
    rw [heq]
  have hq₁ (i : Fin 3) : Measurable (fun q : E3 × E3 ↦ q.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp
      measurable_fst
  have hq₂ (i : Fin 3) : Measurable (fun q : E3 × E3 ↦ q.2 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp
      measurable_snd
  have hinput₀ : Measurable (fun q : E3 × E3 ↦ F 0 q.1) :=
    (F 0).continuous.measurable.comp measurable_fst
  have hinput₁ : Measurable (fun q : E3 × E3 ↦
      F 1 (modelPoint (q.2 0) (q.1 1) (q.1 2))) :=
    (F 1).continuous.measurable.comp
      (measurable_modelPoint _ _ _ (hq₂ 0) (hq₁ 1) (hq₁ 2))
  have hinput₂ : Measurable (fun q : E3 × E3 ↦
      F 2 (modelPoint (q.1 0) (q.2 1) (q.1 2))) :=
    (F 2).continuous.measurable.comp
      (measurable_modelPoint _ _ _ (hq₁ 0) (hq₂ 1) (hq₁ 2))
  have hinput₃ : Measurable (fun q : E3 × E3 ↦
      F 3 (modelPoint (q.1 0) (q.1 1) (q.2 2))) :=
    (F 3).continuous.measurable.comp
      (measurable_modelPoint _ _ _ (hq₁ 0) (hq₁ 1) (hq₂ 2))
  have hkernel₀ : Measurable (fun q : E3 × E3 ↦
      kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0) (q.1 0 - q.2 0)) := by
    unfold kernelDilate
    exact (measurable_const.inv.mul
      ((measurable_ModelLowKernel (u 0)).comp
        (((hq₁ 0).sub (hq₂ 0)).div measurable_const)))
  have hkernel₁ : Measurable (fun q : E3 × E3 ↦
      kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1) (q.1 1 - q.2 1)) := by
    unfold kernelDilate
    exact (measurable_const.inv.mul
      ((measurable_ModelLowKernel (u 1)).comp
        (((hq₁ 1).sub (hq₂ 1)).div measurable_const)))
  have hkernel₂ : Measurable (fun q : E3 × E3 ↦
      kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2) (q.1 2 - q.2 2)) := by
    unfold kernelDilate
    exact (measurable_const.inv.mul
      ((measurable_ModelThirdKernel (u 2)).comp
        (((hq₁ 2).sub (hq₂ 2)).div measurable_const)))
  have hmeas : AEStronglyMeasurable
      (ModelExpandedKernelIntegrand α u F t)
      ((volume : Measure E3).prod volume) := by
    change AEStronglyMeasurable (fun q : E3 × E3 ↦
      (F 0 q.1 * F 1 (modelPoint (q.2 0) (q.1 1) (q.1 2)) *
          F 2 (modelPoint (q.1 0) (q.2 1) (q.1 2)) *
          F 3 (modelPoint (q.1 0) (q.1 1) (q.2 2))) *
        (kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0) (q.1 0 - q.2 0) *
          kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1) (q.1 1 - q.2 1) *
          kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2) (q.1 2 - q.2 2)))
      ((volume : Measure E3).prod volume)
    exact (((hinput₀.aestronglyMeasurable.mul hinput₁.aestronglyMeasurable).mul
      hinput₂.aestronglyMeasurable).mul hinput₃.aestronglyMeasurable).mul
      ((hkernel₀.aestronglyMeasurable.mul hkernel₁.aestronglyMeasurable).mul
        hkernel₂.aestronglyMeasurable)
  apply Integrable.mono' hmajor hmeas
  filter_upwards [] with q
  change ‖ModelExpandedKernelIntegrand α u F t q‖ ≤ A q.1 * R (q.1 - q.2)
  simp only [ModelExpandedKernelIntegrand, A, R, B,
    Real.norm_eq_abs, abs_mul]
  calc
    |F 0 q.1| * |F 1 (modelPoint (q.2 0) (q.1 1) (q.1 2))| *
          |F 2 (modelPoint (q.1 0) (q.2 1) (q.1 2))| *
          |F 3 (modelPoint (q.1 0) (q.1 1) (q.2 2))| *
        (|kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0)
            (q.1 0 - q.2 0)| *
          |kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1)
            (q.1 1 - q.2 1)| *
          |kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2)
            (q.1 2 - q.2 2)|) =
        (|F 1 (modelPoint (q.2 0) (q.1 1) (q.1 2))| *
            |F 2 (modelPoint (q.1 0) (q.2 1) (q.1 2))| *
            |F 3 (modelPoint (q.1 0) (q.1 1) (q.2 2))|) * |F 0 q.1| *
          (|kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0)
              (q.1 0 - q.2 0)| *
            |kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1)
              (q.1 1 - q.2 1)| *
            |kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2)
              (q.1 2 - q.2 2)|) := by ring
    _ ≤ (B₁ * B₂ * B₃) * |F 0 q.1| *
          (|kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0)
              (q.1 0 - q.2 0)| *
            |kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1)
              (q.1 1 - q.2 1)| *
            |kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2)
              (q.1 2 - q.2 2)|) := by
          gcongr
          · exact hF₁ _
          · exact hF₂ _
          · exact hF₃ _
    _ = _ := by simp

/-- For Schwartz inputs the three passive factors have global seminorm
bounds, so the post-center fixed-scale integrand is automatically absolutely
integrable. -/
theorem integrable_ModelExpandedKernelIntegrand
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (ht : 0 < t) :
    Integrable (ModelExpandedKernelIntegrand α u F t)
      ((volume : Measure E3).prod volume) := by
  let B₁ : ℝ := SchwartzMap.seminorm ℝ 0 0 (F 1)
  let B₂ : ℝ := SchwartzMap.seminorm ℝ 0 0 (F 2)
  let B₃ : ℝ := SchwartzMap.seminorm ℝ 0 0 (F 3)
  apply integrable_ModelExpandedKernelIntegrand_of_bounds
    α u F t ht B₁ B₂ B₃
  · exact le_trans (norm_nonneg ((F 1) 0))
      (SchwartzMap.norm_le_seminorm ℝ (F 1) 0)
  · exact le_trans (norm_nonneg ((F 2) 0))
      (SchwartzMap.norm_le_seminorm ℝ (F 2) 0)
  · exact le_trans (norm_nonneg ((F 3) 0))
      (SchwartzMap.norm_le_seminorm ℝ (F 3) 0)
  · intro x
    simpa only [B₁, Real.norm_eq_abs] using
      (SchwartzMap.norm_le_seminorm ℝ (F 1) x)
  · intro x
    simpa only [B₂, Real.norm_eq_abs] using
      (SchwartzMap.norm_le_seminorm ℝ (F 2) x)
  · intro x
    simpa only [B₃, Real.norm_eq_abs] using
      (SchwartzMap.norm_le_seminorm ℝ (F 3) x)

/-- At one positive scale, Fubini and the three center identities turn the
literal center-expanded integrand into the negative physical-kernel
integrand. -/
theorem integral_ModelCenterExpanded_eq_neg_kernel_of_integrable
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (ht : 0 < t)
    (hjoint : Integrable (ModelCenterExpandedIntegrand α u F t)
      (((volume : Measure E3).prod volume).prod volume)) :
    (∫ q : (E3 × E3) × E3,
      ModelCenterExpandedIntegrand α u F t q
      ∂(((volume : Measure E3).prod volume).prod volume)) =
      -(∫ q : E3 × E3,
        ModelExpandedKernelIntegrand α u F t q
        ∂((volume : Measure E3).prod volume)) := by
  let W : E3 × E3 → ℝ := fun q ↦
    F 0 q.1 * F 1 (modelPoint (q.2 0) (q.1 1) (q.1 2)) *
      F 2 (modelPoint (q.1 0) (q.2 1) (q.1 2)) *
      F 3 (modelPoint (q.1 0) (q.1 1) (q.2 2))
  have hs₀ : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs₁ : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs₂ : 0 < t ^ α.weight 2 := pow_pos ht _
  let C : (E3 × E3) × E3 → ℝ := fun q ↦
    (modelPhiAt (t ^ α.weight 0)
        (q.2 0 + t ^ α.weight 0 * u 0) (q.1.1 0) *
      gaussianAt (t ^ α.weight 0) (q.2 0) (q.1.2 0)) *
      (modelPhiAt (t ^ α.weight 1)
        (q.2 1 + t ^ α.weight 1 * u 1) (q.1.1 1) *
      gaussianAt (t ^ α.weight 1) (q.2 1) (q.1.2 1)) *
      (gaussianDerivAt (t ^ α.weight 2) (q.2 2) (q.1.1 2) *
        modelThirdKernel (u 2) (t ^ α.weight 2) (q.2 2) (q.1.2 2))
  have hcenter : Integrable (fun q : (E3 × E3) × E3 ↦ W q.1 * C q)
      (((volume : Measure E3).prod volume).prod volume) := by
    apply hjoint.congr
    filter_upwards [] with q
    simp only [ModelCenterExpandedIntegrand, W, C]
  have hmain := integral_centerTriple_weighted_of_integrable
    ((volume : Measure E3).prod volume)
    (t ^ α.weight 0) (t ^ α.weight 1) (t ^ α.weight 2)
    (u 0) (u 1) (u 2)
    W
    (fun q : E3 × E3 ↦ q.1 0)
    (fun q : E3 × E3 ↦ q.1 1)
    (fun q : E3 × E3 ↦ q.1 2)
    (fun q : E3 × E3 ↦ q.2 0)
    (fun q : E3 × E3 ↦ q.2 1)
    (fun q : E3 × E3 ↦ q.2 2)
    hs₀ hs₁ hs₂
    hcenter
  convert hmain using 1 <;>
    simp only [ModelCenterExpandedIntegrand,
      ModelExpandedKernelIntegrand, W]

/-- Opening the three coordinate convolutions recovers the spatial profile
from the post-center kernel integral. -/
theorem integral_ModelExpandedKernel_eq_ModelSpatialProfile_of_integrable
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (hkernel : Integrable (ModelExpandedKernelIntegrand α u F t)
      ((volume : Measure E3).prod volume)) :
    (∫ q : E3 × E3,
      ModelExpandedKernelIntegrand α u F t q
      ∂((volume : Measure E3).prod volume)) =
      ModelSpatialProfile α u F t := by
  calc
    (∫ q : E3 × E3,
      ModelExpandedKernelIntegrand α u F t q
      ∂((volume : Measure E3).prod volume)) =
        ∫ x : E3, ∫ y : E3,
          ModelExpandedKernelIntegrand α u F t (x, y) :=
      MeasureTheory.integral_prod _ hkernel
    _ = ∫ x : E3,
        F 0 x *
          (∫ y : E3,
            (F 1 (modelPoint (y 0) (x 1) (x 2)) *
                kernelDilate (ModelLowKernel (u 0))
                  (t ^ α.weight 0) (x 0 - y 0)) *
              (F 2 (modelPoint (x 0) (y 1) (x 2)) *
                kernelDilate (ModelLowKernel (u 1))
                  (t ^ α.weight 1) (x 1 - y 1)) *
              (F 3 (modelPoint (x 0) (x 1) (y 2)) *
                kernelDilate (ModelThirdKernel (u 2))
                  (t ^ α.weight 2) (x 2 - y 2))) := by
          apply integral_congr_ae
          filter_upwards [] with x
          rw [← integral_const_mul]
          apply integral_congr_ae
          filter_upwards [] with y
          simp only [ModelExpandedKernelIntegrand]
          ring
    _ = ModelSpatialProfile α u F t :=
      (ModelSpatialProfile_eq_expandedKernelIntegral α u F t).symm

/-- The fixed-scale localization identity under the two absolute-integrability
conditions that justify the relevant Fubini steps. -/
theorem integral_ModelCenterExpanded_eq_neg_ModelSpatialProfile_of_integrable
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (ht : 0 < t)
    (hjoint : Integrable (ModelCenterExpandedIntegrand α u F t)
      (((volume : Measure E3).prod volume).prod volume))
    (hkernel : Integrable (ModelExpandedKernelIntegrand α u F t)
      ((volume : Measure E3).prod volume)) :
    (∫ q : (E3 × E3) × E3,
      ModelCenterExpandedIntegrand α u F t q
      ∂(((volume : Measure E3).prod volume).prod volume)) =
      -ModelSpatialProfile α u F t := by
  rw [integral_ModelCenterExpanded_eq_neg_kernel_of_integrable
    α u F t ht hjoint,
    integral_ModelExpandedKernel_eq_ModelSpatialProfile_of_integrable
      α u F t hkernel]

/-- With the outer sign in the local-form convention, the fixed-scale center
expansion is exactly the spatial model profile. -/
theorem neg_integral_ModelCenterExpanded_eq_ModelSpatialProfile_of_integrable
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (ht : 0 < t)
    (hjoint : Integrable (ModelCenterExpandedIntegrand α u F t)
      (((volume : Measure E3).prod volume).prod volume))
    (hkernel : Integrable (ModelExpandedKernelIntegrand α u F t)
      ((volume : Measure E3).prod volume)) :
    -(∫ q : (E3 × E3) × E3,
      ModelCenterExpandedIntegrand α u F t q
      ∂(((volume : Measure E3).prod volume).prod volume)) =
      ModelSpatialProfile α u F t := by
  rw [integral_ModelCenterExpanded_eq_neg_ModelSpatialProfile_of_integrable
    α u F t ht hjoint hkernel]
  ring

/-- A product of an `L¹` base factor and an `L¹` difference factor is
integrable on the corresponding product Euclidean space. -/
theorem integrable_mul_difference
    (f g : E3 → ℝ) (hf : Integrable f) (hg : Integrable g) :
    Integrable (fun q : E3 × E3 ↦ f q.1 * g (q.2 - q.1))
      ((volume : Measure E3).prod volume) := by
  have hprod : Integrable (fun q : E3 × E3 ↦ f q.1 * g q.2)
      ((volume : Measure E3).prod volume) := hf.mul_prod hg
  have hmp : MeasurePreserving (fun q : E3 × E3 ↦ (q.1, q.2 - q.1))
      ((volume : Measure E3).prod volume)
      ((volume : Measure E3).prod volume) :=
    measurePreserving_prod_sub volume volume
  convert hmp.integrable_comp_of_integrable hprod using 1
  rfl

/-- A fixed normalized dilation is measurable after any measurable scalar
parameterization. -/
theorem measurable_kernelDilate
    {X : Type*} [MeasurableSpace X]
    (k : ℝ → ℝ) (hk : Measurable k) (s : ℝ) (r : X → ℝ)
    (hr : Measurable r) :
    Measurable (fun x ↦ kernelDilate k s (r x)) := by
  unfold kernelDilate
  simp only [smul_eq_mul]
  exact measurable_const.mul (hk.comp (hr.div measurable_const))

/-- Two translated `L¹` factors remain jointly integrable with an `L¹` base
factor. This is the product-space Fubini majorant used for a fixed center
expansion. -/
theorem integrable_two_difference_factors
    (f P Q : E3 → ℝ)
    (hf : Integrable f) (hP : Integrable P) (hQ : Integrable Q) :
    Integrable (fun q : (E3 × E3) × E3 ↦
      f q.1.1 * P (q.1.1 - q.1.2) * Q (q.2 - q.1.2))
      (((volume : Measure E3).prod volume).prod volume) := by
  have hPneg : Integrable (fun r : E3 ↦ P (-r)) := hP.comp_neg
  have hbase' : Integrable (fun z : E3 × E3 ↦
      f z.1 * P (-(z.2 - z.1))) ((volume : Measure E3).prod volume) :=
    integrable_mul_difference f (fun r : E3 ↦ P (-r)) hf hPneg
  have hbase : Integrable (fun z : E3 × E3 ↦
      f z.1 * P (z.1 - z.2)) ((volume : Measure E3).prod volume) := by
    apply hbase'.congr
    filter_upwards [] with z
    congr 2
    ext i
    change -(z.2 i - z.1 i) = z.1 i - z.2 i
    ring
  have hprod : Integrable (fun z : (E3 × E3) × E3 ↦
      (f z.1.1 * P (z.1.1 - z.1.2)) * Q z.2)
      (((volume : Measure E3).prod volume).prod volume) :=
    hbase.mul_prod hQ
  let e : (E3 × E3) × E3 ≃ᵐ (E3 × E3) × E3 :=
    (MeasurableEquiv.prodAssoc.trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.shearSubRight E3))).trans
      MeasurableEquiv.prodAssoc.symm
  have hassoc : MeasurePreserving
      (MeasurableEquiv.prodAssoc : (E3 × E3) × E3 ≃ᵐ E3 × (E3 × E3))
      (((volume : Measure E3).prod volume).prod volume)
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume)) :=
    measurePreserving_prodAssoc volume volume volume
  have hshear : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.shearSubRight E3))
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume))
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume)) := by
    have hsub : MeasurePreserving (fun z : E3 × E3 ↦ (z.1, z.2 - z.1))
        ((volume : Measure E3).prod volume)
        ((volume : Measure E3).prod volume) :=
      measurePreserving_prod_sub volume volume
    have hprod := (MeasurePreserving.id (volume : Measure E3)).prod hsub
    convert hprod using 1
    rfl
  have he : MeasurePreserving e
      (((volume : Measure E3).prod volume).prod volume)
      (((volume : Measure E3).prod volume).prod volume) := by
    dsimp only [e]
    exact (hassoc.trans hshear).trans hassoc.symm
  convert he.integrable_comp_of_integrable hprod using 1
  rfl

/-- The same product-space estimate in the `(x,y,p)` order used by the
center-expanded integrand. -/
theorem integrable_two_difference_factors_center_order
    (f P Q : E3 → ℝ)
    (hf : Integrable f) (hP : Integrable P) (hQ : Integrable Q) :
    Integrable (fun q : (E3 × E3) × E3 ↦
      f q.1.1 * P (q.1.1 - q.2) * Q (q.1.2 - q.2))
      (((volume : Measure E3).prod volume).prod volume) := by
  have hbase := integrable_two_difference_factors f P Q hf hP hQ
  let e : (E3 × E3) × E3 ≃ᵐ (E3 × E3) × E3 :=
    (MeasurableEquiv.prodAssoc.trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        MeasurableEquiv.prodComm)).trans MeasurableEquiv.prodAssoc.symm
  have hassoc : MeasurePreserving
      (MeasurableEquiv.prodAssoc : (E3 × E3) × E3 ≃ᵐ E3 × (E3 × E3))
      (((volume : Measure E3).prod volume).prod volume)
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume)) :=
    measurePreserving_prodAssoc volume volume volume
  have hswap : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.prodComm : E3 × E3 ≃ᵐ E3 × E3))
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume))
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume)) := by
    have hprod := (MeasurePreserving.id (volume : Measure E3)).prod
      (MeasureTheory.Measure.measurePreserving_swap (μ := (volume : Measure E3))
        (ν := (volume : Measure E3)))
    convert hprod using 1
    rfl
  have he : MeasurePreserving e
      (((volume : Measure E3).prod volume).prod volume)
      (((volume : Measure E3).prod volume).prod volume) := by
    dsimp only [e]
    exact (hassoc.trans hswap).trans hassoc.symm
  convert he.integrable_comp_of_integrable hbase using 1
  rfl

/-- Moving a center into the output variable leaves a kernel-at expression
unchanged after taking the corresponding difference. -/
theorem kernelAt_center_shift
    (k : ℝ → ℝ) (s p c x : ℝ) :
    kernelAt k s (p + c) x = kernelAt k s c (x - p) := by
  unfold kernelAt
  congr 1
  ring

theorem modelPhiAt_center_shift
    (s p c x : ℝ) :
    modelPhiAt s (p + c) x = modelPhiAt s c (x - p) := by
  exact kernelAt_center_shift conePhiPhysicalReal s p c x

theorem gaussianAt_center_shift
    (s p y : ℝ) :
    gaussianAt s p y = gaussianAt s 0 (y - p) := by
  simpa only [gaussianAt, add_zero] using
    kernelAt_center_shift gaussian s p 0 y

theorem gaussianDerivAt_center_shift
    (s p x : ℝ) :
    gaussianDerivAt s p x = gaussianDerivAt s 0 (x - p) := by
  simpa only [gaussianDerivAt, add_zero] using
    kernelAt_center_shift gaussianDeriv s p 0 x

theorem modelThirdKernel_center_shift
    (u s p y : ℝ) :
    modelThirdKernel u s p y = modelThirdKernel u s 0 (y - p) := by
  unfold modelThirdKernel
  simpa only [add_zero] using kernelAt_center_shift
    (fun w : ℝ ↦ ∫ z : ℝ,
      gaussianDeriv z * conePsiPhysicalReal (w - z + u)) s p 0 y

/-- The third model factor is a translated normalized dilation of its
unit-scale kernel. -/
theorem modelThirdKernel_eq_unit_dilate
    (u s p y : ℝ) :
    modelThirdKernel u s p y =
      kernelDilate (modelThirdKernel u 1 0) s (y - p) := by
  unfold modelThirdKernel kernelAt kernelDilate
  simp only [smul_eq_mul, inv_one, one_mul, sub_zero]
  simp only [div_one]

/-- Fixed positive scales make the literal center-expanded model kernel
absolutely integrable for every real Schwartz input tuple. -/
theorem integrable_ModelCenterExpandedIntegrand
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (ht : 0 < t) :
    Integrable (ModelCenterExpandedIntegrand α u F t)
      (((volume : Measure E3).prod volume).prod volume) := by
  obtain ⟨B₁, hB₁, hF₁⟩ := initialModelRealInput_bounded F 1
  obtain ⟨B₂, hB₂, hF₂⟩ := initialModelRealInput_bounded F 2
  obtain ⟨B₃, hB₃, hF₃⟩ := initialModelRealInput_bounded F 3
  let s₀ : ℝ := t ^ α.weight 0
  let s₁ : ℝ := t ^ α.weight 1
  let s₂ : ℝ := t ^ α.weight 2
  have hs₀ : 0 < s₀ := by
    dsimp only [s₀]
    exact pow_pos ht _
  have hs₁ : 0 < s₁ := by
    dsimp only [s₁]
    exact pow_pos ht _
  have hs₂ : 0 < s₂ := by
    dsimp only [s₂]
    exact pow_pos ht _
  let C : ℝ := B₁ * B₂ * B₃
  have hF₀abs : Integrable (fun x : E3 ↦ |F 0 x|) := by
    simpa only [Real.norm_eq_abs] using (F 0).integrable.norm
  let A : E3 → ℝ := fun x ↦ C * |F 0 x|
  have hA : Integrable A := by
    simpa only [A] using hF₀abs.const_mul C
  have hphi₀ : Integrable (fun r : ℝ ↦
      |modelPhiAt s₀ (s₀ * u 0) r|) := by
    simpa only [modelPhiAt, kernelAt] using
      (integrable_abs_kernelDilate conePhiPhysicalReal
        conePhiPhysicalReal.integrable hs₀).comp_sub_right (s₀ * u 0)
  have hphi₁ : Integrable (fun r : ℝ ↦
      |modelPhiAt s₁ (s₁ * u 1) r|) := by
    simpa only [modelPhiAt, kernelAt] using
      (integrable_abs_kernelDilate conePhiPhysicalReal
        conePhiPhysicalReal.integrable hs₁).comp_sub_right (s₁ * u 1)
  have hderiv : Integrable (fun r : ℝ ↦ |gaussianDerivAt s₂ 0 r|) := by
    simpa only [gaussianDerivAt, kernelAt, sub_zero] using
      integrable_abs_kernelDilate gaussianDeriv integrable_gaussianDeriv hs₂
  have hgauss₀ : Integrable (fun r : ℝ ↦ |gaussianAt s₀ 0 r|) := by
    simpa only [gaussianAt, kernelAt, sub_zero] using
      integrable_abs_kernelDilate gaussian integrable_gaussian hs₀
  have hgauss₁ : Integrable (fun r : ℝ ↦ |gaussianAt s₁ 0 r|) := by
    simpa only [gaussianAt, kernelAt, sub_zero] using
      integrable_abs_kernelDilate gaussian integrable_gaussian hs₁
  have hthirdUnit : Integrable (modelThirdKernel (u 2) 1 0) := by
    simpa only [neg_neg] using integrable_modelThirdKernel_unit (-(u 2))
  have hthird : Integrable (fun r : ℝ ↦
      |modelThirdKernel (u 2) s₂ 0 r|) := by
    let H : ℝ → ℝ := fun r ↦
      |kernelDilate (modelThirdKernel (u 2) 1 0) s₂ r|
    have hH : Integrable H := by
      simpa only [H] using integrable_abs_kernelDilate
        (modelThirdKernel (u 2) 1 0) hthirdUnit hs₂
    apply hH.congr
    filter_upwards [] with r
    dsimp only [H]
    rw [modelThirdKernel_eq_unit_dilate]
    simp
  let P : E3 → ℝ := fun r ↦
    |modelPhiAt s₀ (s₀ * u 0) (r 0)| *
      |modelPhiAt s₁ (s₁ * u 1) (r 1)| *
      |gaussianDerivAt s₂ 0 (r 2)|
  have hP : Integrable P := by
    simpa only [P] using integrable_E3_coordinate_product
      (fun r : ℝ ↦ |modelPhiAt s₀ (s₀ * u 0) r|)
      (fun r : ℝ ↦ |modelPhiAt s₁ (s₁ * u 1) r|)
      (fun r : ℝ ↦ |gaussianDerivAt s₂ 0 r|)
      hphi₀ hphi₁ hderiv
  let Q : E3 → ℝ := fun r ↦
    |gaussianAt s₀ 0 (r 0)| *
      |gaussianAt s₁ 0 (r 1)| *
      |modelThirdKernel (u 2) s₂ 0 (r 2)|
  have hQ : Integrable Q := by
    simpa only [Q] using integrable_E3_coordinate_product
      (fun r : ℝ ↦ |gaussianAt s₀ 0 r|)
      (fun r : ℝ ↦ |gaussianAt s₁ 0 r|)
      (fun r : ℝ ↦ |modelThirdKernel (u 2) s₂ 0 r|)
      hgauss₀ hgauss₁ hthird
  let M : (E3 × E3) × E3 → ℝ := fun q ↦
    A q.1.1 * P (q.1.1 - q.2) * Q (q.1.2 - q.2)
  have hM : Integrable M
      (((volume : Measure E3).prod volume).prod volume) := by
    simpa only [M] using integrable_two_difference_factors_center_order
      A P Q hA hP hQ
  have hx (i : Fin 3) : Measurable
      (fun q : (E3 × E3) × E3 ↦ q.1.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp
      (measurable_fst.comp measurable_fst)
  have hy (i : Fin 3) : Measurable
      (fun q : (E3 × E3) × E3 ↦ q.1.2 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp
      (measurable_snd.comp measurable_fst)
  have hp (i : Fin 3) : Measurable
      (fun q : (E3 × E3) × E3 ↦ q.2 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp
      measurable_snd
  have hmeas : Measurable (ModelCenterExpandedIntegrand α u F t) := by
    have h0 : Measurable (fun q : (E3 × E3) × E3 ↦ F 0 q.1.1) :=
      (F 0).continuous.measurable.comp (measurable_fst.comp measurable_fst)
    have h1 : Measurable (fun q : (E3 × E3) × E3 ↦
        F 1 (modelPoint (q.1.2 0) (q.1.1 1) (q.1.1 2))) :=
      (F 1).continuous.measurable.comp
        (measurable_modelPoint _ _ _ (hy 0) (hx 1) (hx 2))
    have h2 : Measurable (fun q : (E3 × E3) × E3 ↦
        F 2 (modelPoint (q.1.1 0) (q.1.2 1) (q.1.1 2))) :=
      (F 2).continuous.measurable.comp
        (measurable_modelPoint _ _ _ (hx 0) (hy 1) (hx 2))
    have h3 : Measurable (fun q : (E3 × E3) × E3 ↦
        F 3 (modelPoint (q.1.1 0) (q.1.1 1) (q.1.2 2))) :=
      (F 3).continuous.measurable.comp
        (measurable_modelPoint _ _ _ (hx 0) (hx 1) (hy 2))
    have hphi0 : Measurable (fun q : (E3 × E3) × E3 ↦
        modelPhiAt s₀ (q.2 0 + s₀ * u 0) (q.1.1 0)) := by
      change Measurable (fun q : (E3 × E3) × E3 ↦
        kernelDilate conePhiPhysicalReal s₀
          (q.1.1 0 - (q.2 0 + s₀ * u 0)))
      apply measurable_kernelDilate conePhiPhysicalReal
        conePhiPhysicalReal.continuous.measurable s₀
      exact (hx 0).sub ((hp 0).add
        (show Measurable (fun _ : (E3 × E3) × E3 ↦ s₀ * u 0) from
          measurable_const))
    have hgauss0 : Measurable (fun q : (E3 × E3) × E3 ↦
        gaussianAt s₀ (q.2 0) (q.1.2 0)) := by
      change Measurable (fun q : (E3 × E3) × E3 ↦
        kernelDilate gaussian s₀ (q.1.2 0 - q.2 0))
      apply measurable_kernelDilate
        gaussian gaussian_contDiff.continuous.measurable s₀
      exact (hy 0).sub (hp 0)
    have hphi1 : Measurable (fun q : (E3 × E3) × E3 ↦
        modelPhiAt s₁ (q.2 1 + s₁ * u 1) (q.1.1 1)) := by
      change Measurable (fun q : (E3 × E3) × E3 ↦
        kernelDilate conePhiPhysicalReal s₁
          (q.1.1 1 - (q.2 1 + s₁ * u 1)))
      apply measurable_kernelDilate conePhiPhysicalReal
        conePhiPhysicalReal.continuous.measurable s₁
      exact (hx 1).sub ((hp 1).add
        (show Measurable (fun _ : (E3 × E3) × E3 ↦ s₁ * u 1) from
          measurable_const))
    have hgauss1 : Measurable (fun q : (E3 × E3) × E3 ↦
        gaussianAt s₁ (q.2 1) (q.1.2 1)) := by
      change Measurable (fun q : (E3 × E3) × E3 ↦
        kernelDilate gaussian s₁ (q.1.2 1 - q.2 1))
      apply measurable_kernelDilate
        gaussian gaussian_contDiff.continuous.measurable s₁
      exact (hy 1).sub (hp 1)
    have hderiv0 : Measurable (fun q : (E3 × E3) × E3 ↦
        gaussianDerivAt s₂ (q.2 2) (q.1.1 2)) := by
      have hderivmeas : Measurable gaussianDeriv := by
        unfold gaussianDeriv
        exact (measurable_const.mul measurable_id).mul
          gaussian_contDiff.continuous.measurable
      change Measurable (fun q : (E3 × E3) × E3 ↦
        kernelDilate gaussianDeriv s₂ (q.1.1 2 - q.2 2))
      apply measurable_kernelDilate gaussianDeriv hderivmeas s₂
      exact (hx 2).sub (hp 2)
    have hthird0 : Measurable (fun q : (E3 × E3) × E3 ↦
        modelThirdKernel (u 2) s₂ (q.2 2) (q.1.2 2)) := by
      have hunitmeas : Measurable (modelThirdKernel (u 2) 1 0) :=
        (stronglyMeasurable_modelThirdKernel (u 2) 1 0).measurable
      have hkernel : Measurable (fun q : (E3 × E3) × E3 ↦
          kernelDilate (modelThirdKernel (u 2) 1 0) s₂
            (q.1.2 2 - q.2 2)) :=
        measurable_kernelDilate (modelThirdKernel (u 2) 1 0)
          hunitmeas s₂ _ ((hy 2).sub (hp 2))
      convert hkernel using 1
      funext q
      exact modelThirdKernel_eq_unit_dilate
        (u 2) s₂ (q.2 2) (q.1.2 2)
    change Measurable (fun q : (E3 × E3) × E3 ↦
      (F 0 q.1.1 * F 1 (modelPoint (q.1.2 0) (q.1.1 1) (q.1.1 2)) *
          F 2 (modelPoint (q.1.1 0) (q.1.2 1) (q.1.1 2)) *
          F 3 (modelPoint (q.1.1 0) (q.1.1 1) (q.1.2 2))) *
        ((modelPhiAt s₀ (q.2 0 + s₀ * u 0) (q.1.1 0) *
            gaussianAt s₀ (q.2 0) (q.1.2 0)) *
          (modelPhiAt s₁ (q.2 1 + s₁ * u 1) (q.1.1 1) *
            gaussianAt s₁ (q.2 1) (q.1.2 1)) *
          (gaussianDerivAt s₂ (q.2 2) (q.1.1 2) *
            modelThirdKernel (u 2) s₂ (q.2 2) (q.1.2 2))))
    have hkernel := ((hphi0.mul hgauss0).mul (hphi1.mul hgauss1)).mul
      (hderiv0.mul hthird0)
    exact (((h0.mul h1).mul h2).mul h3).mul hkernel
  apply hM.mono' hmeas.aestronglyMeasurable
  filter_upwards [] with q
  rw [Real.norm_eq_abs]
  unfold ModelCenterExpandedIntegrand
  simp only [abs_mul]
  dsimp only [M, A, P, Q, s₀, s₁, s₂, C]
  rw [modelPhiAt_center_shift (t ^ α.weight 0) (q.2 0)
      (t ^ α.weight 0 * u 0) (q.1.1 0),
    gaussianAt_center_shift (t ^ α.weight 0) (q.2 0) (q.1.2 0),
    modelPhiAt_center_shift (t ^ α.weight 1) (q.2 1)
      (t ^ α.weight 1 * u 1) (q.1.1 1),
    gaussianAt_center_shift (t ^ α.weight 1) (q.2 1) (q.1.2 1),
    gaussianDerivAt_center_shift (t ^ α.weight 2) (q.2 2) (q.1.1 2),
    modelThirdKernel_center_shift (u 2) (t ^ α.weight 2)
      (q.2 2) (q.1.2 2)]
  simp only [PiLp.sub_apply]
  set a₀ : ℝ := |F 0 q.1.1|
  set a₁ : ℝ := |F 1 (modelPoint (q.1.2 0) (q.1.1 1) (q.1.1 2))|
  set a₂ : ℝ := |F 2 (modelPoint (q.1.1 0) (q.1.2 1) (q.1.1 2))|
  set a₃ : ℝ := |F 3 (modelPoint (q.1.1 0) (q.1.1 1) (q.1.2 2))|
  set kφ₀ : ℝ := |modelPhiAt (t ^ α.weight 0)
    (t ^ α.weight 0 * u 0) (q.1.1 0 - q.2 0)|
  set kg₀ : ℝ := |gaussianAt (t ^ α.weight 0) 0 (q.1.2 0 - q.2 0)|
  set kφ₁ : ℝ := |modelPhiAt (t ^ α.weight 1)
    (t ^ α.weight 1 * u 1) (q.1.1 1 - q.2 1)|
  set kg₁ : ℝ := |gaussianAt (t ^ α.weight 1) 0 (q.1.2 1 - q.2 1)|
  set kd : ℝ := |gaussianDerivAt (t ^ α.weight 2) 0 (q.1.1 2 - q.2 2)|
  set kt : ℝ := |modelThirdKernel (u 2) (t ^ α.weight 2) 0
    (q.1.2 2 - q.2 2)|
  have ha₁ : a₁ ≤ B₁ := by
    dsimp only [a₁]
    have h := hF₁ (modelPoint (q.1.2 0) (q.1.1 1) (q.1.1 2))
    change |F 1 (modelPoint (q.1.2 0) (q.1.1 1) (q.1.1 2))| ≤ B₁ at h
    exact h
  have ha₂ : a₂ ≤ B₂ := by
    dsimp only [a₂]
    have h := hF₂ (modelPoint (q.1.1 0) (q.1.2 1) (q.1.1 2))
    change |F 2 (modelPoint (q.1.1 0) (q.1.2 1) (q.1.1 2))| ≤ B₂ at h
    exact h
  have ha₃ : a₃ ≤ B₃ := by
    dsimp only [a₃]
    have h := hF₃ (modelPoint (q.1.1 0) (q.1.1 1) (q.1.2 2))
    change |F 3 (modelPoint (q.1.1 0) (q.1.1 1) (q.1.2 2))| ≤ B₃ at h
    exact h
  have ha₁₂ : a₁ * a₂ ≤ B₁ * B₂ :=
    mul_le_mul ha₁ ha₂ (by dsimp only [a₂]; positivity) hB₁
  have ha₁₂₃ : a₁ * a₂ * a₃ ≤ B₁ * B₂ * B₃ :=
    mul_le_mul ha₁₂ ha₃ (by dsimp only [a₃]; positivity)
      (mul_nonneg hB₁ hB₂)
  have hinput : a₀ * (a₁ * a₂ * a₃) ≤
      a₀ * (B₁ * B₂ * B₃) :=
    mul_le_mul_of_nonneg_left ha₁₂₃ (by dsimp only [a₀]; positivity)
  let K : ℝ := (kφ₀ * kg₀) * (kφ₁ * kg₁) * (kd * kt)
  have hK : 0 ≤ K := by
    dsimp only [K]
    positivity
  calc
    a₀ * a₁ * a₂ * a₃ * ((kφ₀ * kg₀) * (kφ₁ * kg₁) * (kd * kt)) =
        (a₀ * (a₁ * a₂ * a₃)) * K := by
          dsimp only [K]
          ring
    _ ≤ (a₀ * (B₁ * B₂ * B₃)) * K :=
      mul_le_mul_of_nonneg_right hinput hK
    _ = B₁ * B₂ * B₃ * a₀ * (kφ₀ * kφ₁ * kd) * (kg₀ * kg₁ * kt) := by
      dsimp only [K]
      ring

/-- At every positive scale, the literal center expansion of a real Schwartz
model tuple is automatically absolutely integrable, and its source sign
recovers the fixed-scale spatial model profile exactly. -/
theorem neg_integral_ModelCenterExpanded_eq_ModelSpatialProfile
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (ht : 0 < t) :
    -(∫ q : (E3 × E3) × E3,
      ModelCenterExpandedIntegrand α u F t q
      ∂(((volume : Measure E3).prod volume).prod volume)) =
      ModelSpatialProfile α u F t := by
  exact neg_integral_ModelCenterExpanded_eq_ModelSpatialProfile_of_integrable
    α u F t ht
    (integrable_ModelCenterExpandedIntegrand α u F t ht)
    (integrable_ModelExpandedKernelIntegrand α u F t ht)


/-! ### A weighted convolution lemma -/

/-- The first absolute moment of a scalar convolution is finite when both
factors have finite absolute mass and first absolute moment. -/
theorem integrable_abs_mul_convolution
    (f g : ℝ → ℝ)
    (hf : Integrable f) (hg : Integrable g)
    (hfm : Integrable (fun x : ℝ ↦ |x| * |f x|))
    (hgm : Integrable (fun x : ℝ ↦ |x| * |g x|)) :
    Integrable (fun x : ℝ ↦ |x| *
      |(f ⋆[ContinuousLinearMap.mul ℝ ℝ] g) x|) := by
  let af : ℝ → ℝ := fun x ↦ |f x|
  let ag : ℝ → ℝ := fun x ↦ |g x|
  let mf : ℝ → ℝ := fun x ↦ |x| * |f x|
  let mg : ℝ → ℝ := fun x ↦ |x| * |g x|
  have haf : Integrable af := by
    simpa only [af, Real.norm_eq_abs] using hf.norm
  have hag : Integrable ag := by
    simpa only [ag, Real.norm_eq_abs] using hg.norm
  have hmf' : Integrable mf := by
    simpa only [mf] using hfm
  have hmg' : Integrable mg := by
    simpa only [mg] using hgm
  have hA : Integrable (mf ⋆[ContinuousLinearMap.mul ℝ ℝ] ag) :=
    hmf'.integrable_convolution (ContinuousLinearMap.mul ℝ ℝ) hag
  have hB : Integrable (af ⋆[ContinuousLinearMap.mul ℝ ℝ] mg) :=
    haf.integrable_convolution (ContinuousLinearMap.mul ℝ ℝ) hmg'
  have hH : Integrable (fun x : ℝ ↦
      (mf ⋆[ContinuousLinearMap.mul ℝ ℝ] ag) x +
        (af ⋆[ContinuousLinearMap.mul ℝ ℝ] mg) x) := hA.add hB
  have hconv : Integrable (f ⋆[ContinuousLinearMap.mul ℝ ℝ] g) :=
    hf.integrable_convolution (ContinuousLinearMap.mul ℝ ℝ) hg
  have hmeas : AEStronglyMeasurable (fun x : ℝ ↦ |x| *
      |(f ⋆[ContinuousLinearMap.mul ℝ ℝ] g) x|) volume := by
    have hid : AEStronglyMeasurable (fun x : ℝ ↦ |x|) volume :=
      continuous_id.abs.aestronglyMeasurable
    change AEStronglyMeasurable
      ((fun x : ℝ ↦ |x|) * fun x ↦ |(f ⋆[ContinuousLinearMap.mul ℝ ℝ] g) x|)
      volume
    exact hid.mul hconv.aestronglyMeasurable.norm
  refine hH.mono' hmeas ?_
  filter_upwards [Integrable.ae_convolution_exists (ContinuousLinearMap.mul ℝ ℝ) hmf' hag,
    Integrable.ae_convolution_exists (ContinuousLinearMap.mul ℝ ℝ) haf hmg',
    Integrable.ae_convolution_exists (ContinuousLinearMap.mul ℝ ℝ) hf hg]
    with x hAexists hBexists hCexists
  have hAint := hAexists.integrable
  have hBint := hBexists.integrable
  have hCint := hCexists.integrable
  change Integrable (fun z : ℝ ↦ mf z * ag (x - z)) at hAint
  change Integrable (fun z : ℝ ↦ af z * mg (x - z)) at hBint
  change Integrable (fun z : ℝ ↦ f z * g (x - z)) at hCint
  have hpoint : ∀ z : ℝ,
      |x| * |f z * g (x - z)| ≤
        (mf z * ag (x - z)) + (af z * mg (x - z)) := by
    intro z
    dsimp [mf, mg, af, ag]
    rw [abs_mul]
    have htri : |x| ≤ |z| + |x - z| := by
      calc
        |x| = |z + (x - z)| := by ring_nf
        _ ≤ |z| + |x - z| := abs_add_le _ _
    calc
      |x| * (|f z| * |g (x - z)|) ≤
          (|z| + |x - z|) * (|f z| * |g (x - z)|) :=
        mul_le_mul_of_nonneg_right htri
          (mul_nonneg (abs_nonneg _) (abs_nonneg _))
      _ = |z| * |f z| * |g (x - z)| +
          |f z| * (|x - z| * |g (x - z)|) := by ring
  have hsumint : Integrable (fun z : ℝ ↦
      mf z * ag (x - z) + af z * mg (x - z)) := hAint.add hBint
  have hleftint : Integrable (fun z : ℝ ↦ |x| * |f z * g (x - z)|) := by
    simpa only [Real.norm_eq_abs] using hCint.norm.const_mul |x|
  have hbound : |x| * |(f ⋆[ContinuousLinearMap.mul ℝ ℝ] g) x| ≤
      (mf ⋆[ContinuousLinearMap.mul ℝ ℝ] ag) x +
        (af ⋆[ContinuousLinearMap.mul ℝ ℝ] mg) x := by
    change |x| * |∫ z : ℝ, f z * g (x - z)| ≤
      (∫ z : ℝ, mf z * ag (x - z)) +
        ∫ z : ℝ, af z * mg (x - z)
    calc
      |x| * |∫ z : ℝ, f z * g (x - z)| ≤
          |x| * ∫ z : ℝ, |f z * g (x - z)| := by
        exact mul_le_mul_of_nonneg_left
          (by simpa only [Real.norm_eq_abs] using
            (norm_integral_le_integral_norm (fun z : ℝ ↦ f z * g (x - z))))
          (abs_nonneg x)
      _ = ∫ z : ℝ, |x| * |f z * g (x - z)| := by
        rw [integral_const_mul]
      _ ≤ ∫ z : ℝ, mf z * ag (x - z) + af z * mg (x - z) :=
        integral_mono hleftint hsumint hpoint
      _ = (∫ z : ℝ, mf z * ag (x - z)) +
          ∫ z : ℝ, af z * mg (x - z) := by
        rw [integral_add hAint hBint]
  have htargetnonneg : 0 ≤ |x| * |(f ⋆[ContinuousLinearMap.mul ℝ ℝ] g) x| :=
    mul_nonneg (abs_nonneg _) (abs_nonneg _)
  rw [Real.norm_eq_abs, abs_of_nonneg htargetnonneg]
  exact hbound

/-! ### Polynomial-decay inputs -/

/-- Fourth-order reciprocal decay gives a finite first absolute moment on the
real line. The exponent is intentionally fixed: it is the common uniform
decay degree supplied by the Gaussian and Schwartz kernel interfaces. -/
theorem integrable_abs_mul_of_decay_four
    (f : ℝ → ℝ) (hf : AEStronglyMeasurable f volume)
    {C : ℝ} (hC : 0 ≤ C)
    (hdecay : ∀ x : ℝ, |f x| ≤ C / (1 + |x|) ^ 4) :
    Integrable (fun x : ℝ ↦ |x| * |f x|) := by
  have hbase : Integrable (fun x : ℝ ↦ (1 + |x|) ^ (-3 : ℝ)) := by
    simpa only [Real.norm_eq_abs] using
      (integrable_one_add_norm (E := ℝ) (μ := volume) (r := (3 : ℝ))
        (by norm_num))
  have hmajor : Integrable (fun x : ℝ ↦ C * (1 + |x|) ^ (-3 : ℝ)) := by
    simpa only [smul_eq_mul] using hbase.const_mul C
  have habs : AEStronglyMeasurable (fun x : ℝ ↦ |f x|) volume := by
    simpa only [Real.norm_eq_abs] using hf.norm
  have htarget : AEStronglyMeasurable (fun x : ℝ ↦ |x| * |f x|) volume := by
    change AEStronglyMeasurable ((fun x : ℝ ↦ |x|) * fun x ↦ |f x|) volume
    exact continuous_id.abs.aestronglyMeasurable.mul habs
  refine hmajor.mono' htarget (Filter.Eventually.of_forall fun x ↦ ?_)
  have hx0 : 0 ≤ |x| * |f x| := mul_nonneg (abs_nonneg _) (abs_nonneg _)
  rw [Real.norm_eq_abs, abs_of_nonneg hx0]
  have hpos : 0 < (1 + |x|) ^ 4 := pow_pos (by positivity) _
  calc
    |x| * |f x| ≤ |x| * (C / (1 + |x|) ^ 4) :=
      mul_le_mul_of_nonneg_left (hdecay x) (abs_nonneg _)
    _ ≤ (1 + |x|) * (C / (1 + |x|) ^ 4) := by
      gcongr
      linarith [abs_nonneg x]
    _ = C * (1 + |x|) ^ (-3 : ℝ) := by
      have hbasepos : 0 < 1 + |x| := by positivity
      rw [show (1 + |x|) ^ (-3 : ℝ) = ((1 + |x|) ^ 3)⁻¹ by
        rw [show (-3 : ℝ) = -(3 : ℝ) by norm_num,
          Real.rpow_neg hbasepos.le]
        exact congrArg (fun y : ℝ ↦ y⁻¹)
          (Real.rpow_natCast (1 + |x|) 3)]
      field_simp

/-- The Gaussian itself has finite first absolute moment. -/
theorem integrable_abs_mul_gaussian :
    Integrable (fun x : ℝ ↦ |x| * |gaussian x|) := by
  rcases gaussian_polynomial_decay 4 with ⟨C, hC, hdecay⟩
  apply integrable_abs_mul_of_decay_four gaussian
    gaussian_contDiff.continuous.aestronglyMeasurable hC
  intro x
  rw [abs_of_nonneg (gaussian_nonneg x)]
  apply (le_div_iff₀ (pow_pos (by positivity) _)).2
  simpa only [mul_comm] using hdecay x

/-- The low-frequency real Schwartz kernel has finite first absolute moment. -/
theorem integrable_abs_mul_conePhiPhysicalReal :
    Integrable (fun x : ℝ ↦ |x| * |conePhiPhysicalReal x|) := by
  rcases conePhiPhysicalReal_decay 4 with ⟨C, hC, hdecay⟩
  exact integrable_abs_mul_of_decay_four conePhiPhysicalReal
    conePhiPhysicalReal.continuous.aestronglyMeasurable hC hdecay

/-! ### Translation of a first moment -/

/-- A fixed translation preserves finiteness of the first absolute moment.
The resulting bound is the elementary inequality
`|x| ≤ |x - u| + |u|`. -/
theorem integrable_abs_mul_sub_right
    (f : ℝ → ℝ) (u : ℝ)
    (hf : Integrable f)
    (hfm : Integrable (fun x : ℝ ↦ |x| * |f x|)) :
    Integrable (fun x : ℝ ↦ |x| * |f (x - u)|) := by
  have hshift : Integrable (fun x : ℝ ↦ f (x - u)) := hf.comp_sub_right u
  have hmass : Integrable (fun x : ℝ ↦ |f (x - u)|) := by
    simpa only [Real.norm_eq_abs] using hshift.norm
  have hfirst : Integrable (fun x : ℝ ↦ |x - u| * |f (x - u)|) :=
    hfm.comp_sub_right u
  have hmajor : Integrable (fun x : ℝ ↦
      |u| * |f (x - u)| + |x - u| * |f (x - u)|) := by
    change Integrable
      ((fun x : ℝ ↦ |u| * |f (x - u)|) +
        fun x ↦ |x - u| * |f (x - u)|) volume
    simpa only [smul_eq_mul] using (hmass.const_mul |u|).add hfirst
  have habs : AEStronglyMeasurable (fun x : ℝ ↦ |f (x - u)|) volume := by
    simpa only [Real.norm_eq_abs] using hshift.aestronglyMeasurable.norm
  have htarget : AEStronglyMeasurable (fun x : ℝ ↦ |x| * |f (x - u)|) volume := by
    change AEStronglyMeasurable ((fun x : ℝ ↦ |x|) * fun x ↦ |f (x - u)|) volume
    exact continuous_id.abs.aestronglyMeasurable.mul habs
  refine hmajor.mono' htarget (Filter.Eventually.of_forall fun x ↦ ?_)
  have hnonneg : 0 ≤ |x| * |f (x - u)| :=
    mul_nonneg (abs_nonneg _) (abs_nonneg _)
  rw [Real.norm_eq_abs, abs_of_nonneg hnonneg]
  have htri : |x| ≤ |x - u| + |u| := by
    calc
      |x| = |(x - u) + u| := by ring_nf
      _ ≤ |x - u| + |u| := abs_add_le _ _
  calc
    |x| * |f (x - u)| ≤ (|x - u| + |u|) * |f (x - u)| :=
      mul_le_mul_of_nonneg_right htri (abs_nonneg _)
    _ = |u| * |f (x - u)| + |x - u| * |f (x - u)| := by ring

/-! ### The two physical model kernels -/

/-- The unit-scale annular third-coordinate factor has finite first absolute
moment, uniformly for each fixed translation parameter. -/
theorem integrable_abs_mul_modelThirdKernel_unit (u : ℝ) :
    Integrable (fun w : ℝ ↦ |w| * |modelThirdKernel (-u) 1 0 w|) := by
  let K : ℝ → ℝ :=
    gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal
  have hK : Integrable K :=
    integrable_gaussianDeriv.integrable_convolution (ContinuousLinearMap.mul ℝ ℝ)
      conePsiPhysicalReal.integrable
  have hKmoment : Integrable (fun w : ℝ ↦ |w| * |K w|) := by
    dsimp only [K]
    exact integrable_abs_mul_convolution gaussianDeriv conePsiPhysicalReal
      integrable_gaussianDeriv conePsiPhysicalReal.integrable
      integrable_abs_mul_gaussianDeriv
      integrable_abs_mul_conePsiPhysicalReal
  have hshift : Integrable (fun w : ℝ ↦ |w| * |K (w - u)|) :=
    integrable_abs_mul_sub_right K u hK hKmoment
  apply hshift.congr
  filter_upwards [] with w
  dsimp only [K]
  rw [← modelThirdKernel_unit_eq_convolution u w]

/-- The full third physical kernel has finite first absolute moment. -/
theorem integrable_abs_mul_ModelThirdKernel (u : ℝ) :
    Integrable (fun w : ℝ ↦ |w| * |ModelThirdKernel u w|) := by
  let G : ℝ → ℝ := modelThirdKernel (-u) 1 0
  let K : ℝ → ℝ := gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] G
  have hG : Integrable G := by
    simpa only [G] using integrable_modelThirdKernel_unit u
  have hGmoment : Integrable (fun w : ℝ ↦ |w| * |G w|) := by
    simpa only [G] using integrable_abs_mul_modelThirdKernel_unit u
  have hKmoment : Integrable (fun w : ℝ ↦ |w| * |K w|) := by
    dsimp only [K]
    exact integrable_abs_mul_convolution gaussianDeriv G
      integrable_gaussianDeriv hG integrable_abs_mul_gaussianDeriv hGmoment
  apply hKmoment.congr
  filter_upwards [] with w
  dsimp only [K, G]
  rw [convolution_mul]
  rfl

/-- The low-frequency physical kernel has finite first absolute moment. -/
theorem integrable_abs_mul_ModelLowKernel (u : ℝ) :
    Integrable (fun w : ℝ ↦ |w| * |ModelLowKernel u w|) := by
  let K : ℝ → ℝ :=
    gaussian ⋆[ContinuousLinearMap.mul ℝ ℝ] conePhiPhysicalReal
  have hK : Integrable K :=
    integrable_gaussian.integrable_convolution (ContinuousLinearMap.mul ℝ ℝ)
      conePhiPhysicalReal.integrable
  have hKmoment : Integrable (fun w : ℝ ↦ |w| * |K w|) := by
    dsimp only [K]
    exact integrable_abs_mul_convolution gaussian conePhiPhysicalReal
      integrable_gaussian conePhiPhysicalReal.integrable
      integrable_abs_mul_gaussian
      integrable_abs_mul_conePhiPhysicalReal
  have hshift : Integrable (fun w : ℝ ↦ |w| * |K (w - u)|) :=
    integrable_abs_mul_sub_right K u hK hKmoment
  apply hshift.congr
  filter_upwards [] with w
  dsimp only [K]
  rw [convolution_mul]
  unfold ModelLowKernel
  apply congrArg (fun z : ℝ ↦ |w| * |z|)
  apply integral_congr_ae
  filter_upwards [] with z
  congr 1
  ring_nf

/-! ### Uniform pointwise convolution bounds -/

/-- Bounding the right factor pointwise bounds a scalar convolution by the
absolute mass of its left factor. -/
theorem abs_convolution_le_integral_abs_mul_bound
    (f g : ℝ → ℝ) (hf : Integrable f)
    {A : ℝ} (hbound : ∀ x : ℝ, |g x| ≤ A)
    (x : ℝ) :
    |(f ⋆[ContinuousLinearMap.mul ℝ ℝ] g) x| ≤
      A * ∫ z : ℝ, |f z| := by
  have hnorm : Integrable (fun z : ℝ ↦ |f z|) := by
    simpa only [Real.norm_eq_abs] using hf.norm
  have hmajor : Integrable (fun z : ℝ ↦ A * |f z|) := by
    simpa only [smul_eq_mul] using hnorm.const_mul A
  calc
    |(f ⋆[ContinuousLinearMap.mul ℝ ℝ] g) x| =
        |∫ z : ℝ, f z * g (x - z)| := by rfl
    _ ≤ ∫ z : ℝ, A * |f z| := by
      simpa only [Real.norm_eq_abs] using
        (norm_integral_le_of_norm_le
          (f := fun z : ℝ ↦ f z * g (x - z)) hmajor
          (Filter.Eventually.of_forall fun z ↦ by
            rw [Real.norm_eq_abs, abs_mul]
            calc
              |f z| * |g (x - z)| ≤ |f z| * A :=
                mul_le_mul_of_nonneg_left (hbound _) (abs_nonneg _)
              _ = A * |f z| := by ring))
    _ = A * ∫ z : ℝ, |f z| := by rw [integral_const_mul]

/-- The annular real Schwartz kernel is uniformly bounded. -/
theorem exists_bound_conePsiPhysicalReal :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ, |conePsiPhysicalReal x| ≤ C := by
  rcases conePsiPhysicalReal_decay 0 with ⟨C, hC, hdecay⟩
  refine ⟨C, hC, fun x ↦ ?_⟩
  simpa using hdecay x

/-- The low-frequency real Schwartz kernel is uniformly bounded. -/
theorem exists_bound_conePhiPhysicalReal :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ, |conePhiPhysicalReal x| ≤ C := by
  rcases conePhiPhysicalReal_decay 0 with ⟨C, hC, hdecay⟩
  refine ⟨C, hC, fun x ↦ ?_⟩
  simpa using hdecay x

/-- A single pointwise constant controls every translated unit-scale
third-coordinate factor. -/
theorem exists_bound_modelThirdKernel_unit :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u w : ℝ),
      |modelThirdKernel (-u) 1 0 w| ≤ C := by
  rcases exists_bound_conePsiPhysicalReal with ⟨C, hC, hpsi⟩
  let B : ℝ := C * ∫ z : ℝ, |gaussianDeriv z|
  have hB : 0 ≤ B := by
    dsimp only [B]
    exact mul_nonneg hC (integral_nonneg fun z ↦ abs_nonneg _)
  refine ⟨B, hB, fun u w ↦ ?_⟩
  have hconv := abs_convolution_le_integral_abs_mul_bound
    gaussianDeriv conePsiPhysicalReal integrable_gaussianDeriv hpsi (w - u)
  change |modelThirdKernel (-u) 1 0 w| ≤ B
  rw [modelThirdKernel_unit_eq_convolution u w]
  simpa only [B] using hconv

/-- The signed physical third model kernel is bounded uniformly in both its
translation parameter and its spatial argument. -/
theorem exists_bound_ModelThirdKernel :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u w : ℝ), |ModelThirdKernel u w| ≤ C := by
  rcases exists_bound_modelThirdKernel_unit with ⟨A, hA, hunit⟩
  let B : ℝ := A * ∫ z : ℝ, |gaussianDeriv z|
  have hB : 0 ≤ B := by
    dsimp only [B]
    exact mul_nonneg hA (integral_nonneg fun z ↦ abs_nonneg _)
  refine ⟨B, hB, fun u w ↦ ?_⟩
  have hconv := abs_convolution_le_integral_abs_mul_bound
    gaussianDeriv (modelThirdKernel (-u) 1 0) integrable_gaussianDeriv
    (hunit u) w
  change |ModelThirdKernel u w| ≤ B
  rw [show ModelThirdKernel u w =
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        modelThirdKernel (-u) 1 0) w by
      rw [convolution_mul]
      rfl]
  simpa only [B] using hconv

/-- The two low-frequency physical kernels are bounded uniformly in their
fixed translation parameter and spatial argument. -/
theorem exists_bound_ModelLowKernel :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u w : ℝ), |ModelLowKernel u w| ≤ C := by
  rcases exists_bound_conePhiPhysicalReal with ⟨A, hA, hphi⟩
  let B : ℝ := A * ∫ z : ℝ, |gaussian z|
  have hB : 0 ≤ B := by
    dsimp only [B]
    exact mul_nonneg hA (integral_nonneg fun z ↦ abs_nonneg _)
  refine ⟨B, hB, fun u w ↦ ?_⟩
  have hconv := abs_convolution_le_integral_abs_mul_bound
    gaussian conePhiPhysicalReal integrable_gaussian hphi (w - u)
  change |ModelLowKernel u w| ≤ B
  have hEq : ModelLowKernel u w =
      (gaussian ⋆[ContinuousLinearMap.mul ℝ ℝ] conePhiPhysicalReal) (w - u) := by
    unfold ModelLowKernel
    rw [convolution_mul]
    apply integral_congr_ae
    filter_upwards [] with z
    congr 1
    ring_nf
  rw [hEq]
  simpa only [B] using hconv

theorem realSchwartz_uniform_coordinate_line_mass
    (i : Fin 3) (f : SchwartzMap E3 ℝ) :
    ∃ Z : ℝ, 0 ≤ Z ∧ ∀ x : E3,
      Integrable (fun r : ℝ ↦
        f (x - r • Anisotropy.coordinateDirection i)) ∧
      ∫ r : ℝ, |f (x - r • Anisotropy.coordinateDirection i)| ≤ Z := by
  rcases realSchwartz_decay_norm f 10 with ⟨C, hC, hdecay⟩
  let Z : ℝ := C * ∫ r : ℝ, bracketKernel r
  have hZ : 0 ≤ Z := by
    dsimp only [Z]
    exact mul_nonneg hC (integral_nonneg fun r ↦ bracketKernel_nonneg r)
  refine ⟨Z, hZ, fun x ↦ ?_⟩
  let g : ℝ → ℝ := fun r ↦
    f (x - r • Anisotropy.coordinateDirection i)
  let q : ℝ → ℝ := fun r ↦ C * bracketKernel (x i - r)
  have hmap : Continuous (fun r : ℝ ↦
      x - r • Anisotropy.coordinateDirection i) :=
    continuous_const.sub (continuous_id.smul continuous_const)
  have hcoord (r : ℝ) :
      (x - r • Anisotropy.coordinateDirection i) i = x i - r := by
    simp [coordinateDirection_apply]
  have hdecayq (r : ℝ) : |g r| ≤ q r := by
    have hcoordle : |(x - r • Anisotropy.coordinateDirection i) i| ≤
        ‖x - r • Anisotropy.coordinateDirection i‖ := by
      simpa only [Real.norm_eq_abs] using
        PiLp.norm_apply_le (x - r • Anisotropy.coordinateDirection i) i
    have hweight : 1 + |x i - r| ≤
        1 + ‖x - r • Anisotropy.coordinateDirection i‖ := by
      rw [← hcoord r]
      linarith
    have hweightpow : (1 + |x i - r|) ^ 10 ≤
        (1 + ‖x - r • Anisotropy.coordinateDirection i‖) ^ 10 := by
      exact pow_le_pow_left₀ (by positivity) hweight 10
    have hdenleft : 0 <
        (1 + ‖x - r • Anisotropy.coordinateDirection i‖) ^ 10 := by
      positivity
    have hdenright : 0 < (1 + |x i - r|) ^ 10 := by
      positivity
    dsimp only [g, q]
    calc
      |f (x - r • Anisotropy.coordinateDirection i)| ≤
          C / (1 + ‖x - r • Anisotropy.coordinateDirection i‖) ^ 10 :=
        hdecay _
      _ ≤ C / (1 + |x i - r|) ^ 10 := by
        apply (div_le_div_iff₀ hdenleft hdenright).mpr
        gcongr
      _ = C * bracketKernel (x i - r) := by
        rw [bracketKernel_eq_inv_pow, div_eq_mul_inv]
  have hq : Integrable q := by
    dsimp only [q]
    exact (integrable_bracketKernel.comp_sub_left (x i)).const_mul C
  have hgmeas : AEStronglyMeasurable g volume := by
    dsimp only [g]
    exact (f.continuous.comp hmap).aestronglyMeasurable
  have hg : Integrable g := by
    apply hq.mono' hgmeas
    filter_upwards [] with r
    simpa only [Real.norm_eq_abs] using hdecayq r
  constructor
  · exact hg
  · calc
      ∫ r : ℝ, |f (x - r • Anisotropy.coordinateDirection i)| =
          ∫ r : ℝ, |g r| := by rfl
      _ ≤ ∫ r : ℝ, q r := by
        apply integral_mono hg.norm hq
        intro r
        simpa only [Real.norm_eq_abs] using hdecayq r
      _ = Z := by
        dsimp only [q, Z]
        rw [integral_const_mul,
          integral_sub_left_eq_self bracketKernel volume (x i)]

/-- Spatial integration of three pointwise coordinate-convolution bounds.
This is the common bookkeeping step behind both ends of the scale range. -/
theorem abs_ModelSpatialProfile_le_of_coordinate_bounds
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (A0 A1 A2 : ℝ) (hA0 : 0 ≤ A0) (hA1 : 0 ≤ A1) (hA2 : 0 ≤ A2)
    (h0 : ∀ x : E3,
      |ModelCoordinateConvolution 0 (F 1) (ModelLowKernel (u 0))
        (t ^ α.weight 0) x| ≤ A0)
    (h1 : ∀ x : E3,
      |ModelCoordinateConvolution 1 (F 2) (ModelLowKernel (u 1))
        (t ^ α.weight 1) x| ≤ A1)
    (h2 : ∀ x : E3,
      |ModelCoordinateConvolution 2 (F 3) (ModelThirdKernel (u 2))
        (t ^ α.weight 2) x| ≤ A2) :
    |ModelSpatialProfile α u F t| ≤
      A0 * A1 * A2 * ∫ x : E3, |F 0 x| := by
  let D : ℝ := A0 * A1 * A2
  have hD : 0 ≤ D := by
    dsimp only [D]
    positivity
  have hF0int : Integrable (fun x : E3 ↦ |F 0 x|) := by
    simpa only [Real.norm_eq_abs] using (F 0).integrable.norm
  let H : E3 → ℝ := fun x ↦ D * |F 0 x|
  have hH : Integrable H := by
    dsimp only [H]
    exact hF0int.const_mul D
  have hImeas : AEStronglyMeasurable
      (fun x : E3 ↦ ModelSpatialIntegrand α u F t x) volume := by
    exact ((stronglyMeasurable_ModelSpatialIntegrand α u F).comp_measurable
      (measurable_const.prodMk measurable_id)).aestronglyMeasurable
  have hpoint (x : E3) :
      |ModelSpatialIntegrand α u F t x| ≤ H x := by
    unfold ModelSpatialIntegrand
    dsimp only [H, D]
    rw [abs_mul, abs_mul, abs_mul]
    calc
      |F 0 x| *
          |ModelCoordinateConvolution 0 (F 1) (ModelLowKernel (u 0))
              (t ^ α.weight 0) x| *
          |ModelCoordinateConvolution 1 (F 2) (ModelLowKernel (u 1))
              (t ^ α.weight 1) x| *
          |ModelCoordinateConvolution 2 (F 3) (ModelThirdKernel (u 2))
              (t ^ α.weight 2) x| ≤
          |F 0 x| * A0 * A1 * A2 := by
            gcongr
            · exact h0 x
            · exact h1 x
            · exact h2 x
      _ = A0 * A1 * A2 * |F 0 x| := by ring
  have hI : Integrable (fun x : E3 ↦ ModelSpatialIntegrand α u F t x) := by
    apply hH.mono' hImeas
    filter_upwards [] with x
    change ‖ModelSpatialIntegrand α u F t x‖ ≤ D * |F 0 x|
    simpa only [Real.norm_eq_abs] using hpoint x
  unfold ModelSpatialProfile
  calc
    |∫ x : E3, ModelSpatialIntegrand α u F t x| ≤
        ∫ x : E3, |ModelSpatialIntegrand α u F t x| :=
      MeasureTheory.abs_integral_le_integral_abs
    _ ≤ ∫ x : E3, H x := by
      apply integral_mono hI.norm hH
      intro x
      exact hpoint x
    _ = A0 * A1 * A2 * ∫ x : E3, |F 0 x| := by
      dsimp only [H, D]
      rw [integral_const_mul]

/-- The small-scale profile constant can be chosen uniformly over all
positive scales. -/
theorem exists_ModelSpatialProfile_small_scale_bound
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput)
    (hthirdmoment : Integrable (fun r : ℝ ↦
      |r| * |ModelThirdKernel (u 2) r|)) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ t : ℝ, 0 < t →
      |ModelSpatialProfile α u F t| ≤ C * t ^ α.weight 2 := by
  let B1 : ℝ := SchwartzMap.seminorm ℝ 0 0 (F 1)
  let B2 : ℝ := SchwartzMap.seminorm ℝ 0 0 (F 2)
  have hB1 : 0 ≤ B1 := by
    exact (norm_nonneg ((F 1) 0)).trans
      (SchwartzMap.norm_le_seminorm ℝ (F 1) (0 : E3))
  have hB2 : 0 ≤ B2 := by
    exact (norm_nonneg ((F 2) 0)).trans
      (SchwartzMap.norm_le_seminorm ℝ (F 2) (0 : E3))
  have hF1 (x : E3) : |F 1 x| ≤ B1 := by
    simpa only [B1, Real.norm_eq_abs] using
      SchwartzMap.norm_le_seminorm ℝ (F 1) x
  have hF2 (x : E3) : |F 2 x| ≤ B2 := by
    simpa only [B2, Real.norm_eq_abs] using
      SchwartzMap.norm_le_seminorm ℝ (F 2) x
  let M1 : ℝ := ∫ r : ℝ, |ModelLowKernel (u 0) r|
  let M2 : ℝ := ∫ r : ℝ, |ModelLowKernel (u 1) r|
  let M3 : ℝ := ∫ r : ℝ, |r| * |ModelThirdKernel (u 2) r|
  have hM1 : 0 ≤ M1 := by
    dsimp only [M1]
    exact integral_nonneg fun _ ↦ abs_nonneg _
  have hM2 : 0 ≤ M2 := by
    dsimp only [M2]
    exact integral_nonneg fun _ ↦ abs_nonneg _
  have hM3 : 0 ≤ M3 := by
    dsimp only [M3]
    exact integral_nonneg fun _ ↦ mul_nonneg (abs_nonneg _) (abs_nonneg _)
  rcases schwartz_real_global_lipschitz (F 3) with ⟨L, hL, hLip⟩
  let C : ℝ := (B1 * M1) * (B2 * M2) * L * M3 *
    ∫ x : E3, |F 0 x|
  have hC : 0 ≤ C := by
    dsimp only [C]
    positivity
  refine ⟨C, hC, fun t ht ↦ ?_⟩
  have hs0 : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs1 : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs2 : 0 < t ^ α.weight 2 := pow_pos ht _
  have hA0 (x : E3) :
      |ModelCoordinateConvolution 0 (F 1) (ModelLowKernel (u 0))
        (t ^ α.weight 0) x| ≤ B1 * M1 := by
    simpa only [M1] using abs_ModelCoordinateConvolution_le
      0 (F 1) (ModelLowKernel (u 0)) (t ^ α.weight 0) x
      (F 1).continuous B1 hF1 (integrable_ModelLowKernel (u 0)) hs0
  have hA1 (x : E3) :
      |ModelCoordinateConvolution 1 (F 2) (ModelLowKernel (u 1))
        (t ^ α.weight 1) x| ≤ B2 * M2 := by
    simpa only [M2] using abs_ModelCoordinateConvolution_le
      1 (F 2) (ModelLowKernel (u 1)) (t ^ α.weight 1) x
      (F 2).continuous B2 hF2 (integrable_ModelLowKernel (u 1)) hs1
  have hA2 (x : E3) :
      |ModelCoordinateConvolution 2 (F 3) (ModelThirdKernel (u 2))
        (t ^ α.weight 2) x| ≤ L * (t ^ α.weight 2) * M3 := by
    simpa only [M3] using abs_ModelCoordinateConvolution_le_of_mean_zero
      2 (F 3) (ModelThirdKernel (u 2)) (t ^ α.weight 2) x
        (F 3).continuous L (by
          intro r
          have h := hLip x (x - r • Anisotropy.coordinateDirection 2)
          have hv : x - r • Anisotropy.coordinateDirection 2 - x =
              -(r • Anisotropy.coordinateDirection 2) := by abel
          rw [Real.norm_eq_abs, hv, norm_neg,
            norm_smul_coordinateDirection] at h
          exact h)
        (integrable_ModelThirdKernel (u 2)) hthirdmoment
        (integral_ModelThirdKernel (u 2)) hs2
  calc
    |ModelSpatialProfile α u F t| ≤
        (B1 * M1) * (B2 * M2) *
          (L * (t ^ α.weight 2) * M3) * ∫ x : E3, |F 0 x| := by
      apply abs_ModelSpatialProfile_le_of_coordinate_bounds
      · exact mul_nonneg hB1 hM1
      · exact mul_nonneg hB2 hM2
      · positivity
      · exact hA0
      · exact hA1
      · exact hA2
    _ = C * t ^ α.weight 2 := by
      dsimp only [C]
      ring

/-- The large-scale profile constant can likewise be chosen uniformly over
all positive scales once the fixed third kernel is pointwise bounded. -/
theorem exists_ModelSpatialProfile_large_scale_bound
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput)
    (A : ℝ) (hkernel : ∀ r : ℝ, |ModelThirdKernel (u 2) r| ≤ A) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ t : ℝ, 0 < t →
      |ModelSpatialProfile α u F t| ≤ C * (t ^ α.weight 2)⁻¹ := by
  let B1 : ℝ := SchwartzMap.seminorm ℝ 0 0 (F 1)
  let B2 : ℝ := SchwartzMap.seminorm ℝ 0 0 (F 2)
  have hB1 : 0 ≤ B1 := by
    exact (norm_nonneg ((F 1) 0)).trans
      (SchwartzMap.norm_le_seminorm ℝ (F 1) (0 : E3))
  have hB2 : 0 ≤ B2 := by
    exact (norm_nonneg ((F 2) 0)).trans
      (SchwartzMap.norm_le_seminorm ℝ (F 2) (0 : E3))
  have hF1 (x : E3) : |F 1 x| ≤ B1 := by
    simpa only [B1, Real.norm_eq_abs] using
      SchwartzMap.norm_le_seminorm ℝ (F 1) x
  have hF2 (x : E3) : |F 2 x| ≤ B2 := by
    simpa only [B2, Real.norm_eq_abs] using
      SchwartzMap.norm_le_seminorm ℝ (F 2) x
  let M1 : ℝ := ∫ r : ℝ, |ModelLowKernel (u 0) r|
  let M2 : ℝ := ∫ r : ℝ, |ModelLowKernel (u 1) r|
  have hM1 : 0 ≤ M1 := by
    dsimp only [M1]
    exact integral_nonneg fun _ ↦ abs_nonneg _
  have hM2 : 0 ≤ M2 := by
    dsimp only [M2]
    exact integral_nonneg fun _ ↦ abs_nonneg _
  have hA : 0 ≤ A := by
    exact (abs_nonneg (ModelThirdKernel (u 2) 0)).trans (hkernel 0)
  rcases realSchwartz_uniform_coordinate_line_mass 2 (F 3)
    with ⟨Z, hZ, hlines⟩
  let C : ℝ := (B1 * M1) * (B2 * M2) * A * Z *
    ∫ x : E3, |F 0 x|
  have hC : 0 ≤ C := by
    dsimp only [C]
    positivity
  refine ⟨C, hC, fun t ht ↦ ?_⟩
  have hs0 : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs1 : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs2 : 0 < t ^ α.weight 2 := pow_pos ht _
  have hA0 (x : E3) :
      |ModelCoordinateConvolution 0 (F 1) (ModelLowKernel (u 0))
        (t ^ α.weight 0) x| ≤ B1 * M1 := by
    simpa only [M1] using abs_ModelCoordinateConvolution_le
      0 (F 1) (ModelLowKernel (u 0)) (t ^ α.weight 0) x
      (F 1).continuous B1 hF1 (integrable_ModelLowKernel (u 0)) hs0
  have hA1 (x : E3) :
      |ModelCoordinateConvolution 1 (F 2) (ModelLowKernel (u 1))
        (t ^ α.weight 1) x| ≤ B2 * M2 := by
    simpa only [M2] using abs_ModelCoordinateConvolution_le
      1 (F 2) (ModelLowKernel (u 1)) (t ^ α.weight 1) x
      (F 2).continuous B2 hF2 (integrable_ModelLowKernel (u 1)) hs1
  have hA2 (x : E3) :
      |ModelCoordinateConvolution 2 (F 3) (ModelThirdKernel (u 2))
        (t ^ α.weight 2) x| ≤ (t ^ α.weight 2)⁻¹ * A * Z := by
    calc
      |ModelCoordinateConvolution 2 (F 3) (ModelThirdKernel (u 2))
          (t ^ α.weight 2) x| ≤
          (t ^ α.weight 2)⁻¹ * A * ∫ r : ℝ,
            |F 3 (x - r • Anisotropy.coordinateDirection 2)| := by
            apply abs_ModelCoordinateConvolution_le_of_bounded_kernel_line_mass
              2 (F 3) (ModelThirdKernel (u 2)) (t ^ α.weight 2) x
              (integrable_ModelThirdKernel (u 2)) A hkernel
              (hlines x).1 hs2
      _ ≤ (t ^ α.weight 2)⁻¹ * A * Z := by
        exact mul_le_mul_of_nonneg_left (hlines x).2 (by positivity)
  calc
    |ModelSpatialProfile α u F t| ≤
        (B1 * M1) * (B2 * M2) *
          ((t ^ α.weight 2)⁻¹ * A * Z) * ∫ x : E3, |F 0 x| := by
      apply abs_ModelSpatialProfile_le_of_coordinate_bounds
      · exact mul_nonneg hB1 hM1
      · exact mul_nonneg hB2 hM2
      · positivity
      · exact hA0
      · exact hA1
      · exact hA2
    _ = C * (t ^ α.weight 2)⁻¹ := by
      dsimp only [C]
      ring

/-- The two uniform scale estimates combine into the exact integrable
small/large envelope required by the full model-profile convergence bridge. -/
theorem exists_ModelSpatialProfile_scale_envelope
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput)
    (hmoment : Integrable (fun r : ℝ ↦
      |r| * |ModelThirdKernel (u 2) r|))
    (A : ℝ) (hkernel : ∀ r : ℝ, |ModelThirdKernel (u 2) r| ≤ A) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ t : ℝ, 0 < t →
      |ModelSpatialProfile α u F t| ≤ C *
        min (t ^ (α.weight 2 : ℝ)) (t ^ (-(α.weight 2 : ℝ))) := by
  rcases exists_ModelSpatialProfile_small_scale_bound α u F hmoment
    with ⟨Cs, hCs, hsmall⟩
  rcases exists_ModelSpatialProfile_large_scale_bound α u F A hkernel
    with ⟨Cl, hCl, hlarge⟩
  refine ⟨Cs + Cl, add_nonneg hCs hCl, fun t ht ↦ ?_⟩
  let s : ℝ := t ^ α.weight 2
  have hs : 0 < s := by
    dsimp only [s]
    exact pow_pos ht _
  have hsmall' : |ModelSpatialProfile α u F t| ≤ Cs * s := by
    simpa only [s] using hsmall t ht
  have hlarge' : |ModelSpatialProfile α u F t| ≤ Cl * s⁻¹ := by
    simpa only [s] using hlarge t ht
  have hrpow : min (t ^ (α.weight 2 : ℝ))
      (t ^ (-(α.weight 2 : ℝ))) = min s s⁻¹ := by
    dsimp only [s]
    rw [Real.rpow_natCast, Real.rpow_neg (le_of_lt ht),
      Real.rpow_natCast]
  rw [hrpow]
  by_cases hsmallscale : s ≤ 1
  · have hmin : min s s⁻¹ = s := by
      apply min_eq_left
      rw [show s⁻¹ = s⁻¹ * 1 by ring]
      apply (le_inv_mul_iff₀ hs).mpr
      nlinarith [mul_nonneg hs.le (sub_nonneg.mpr hsmallscale)]
    rw [hmin]
    calc
      |ModelSpatialProfile α u F t| ≤ Cs * s := hsmall'
      _ ≤ (Cs + Cl) * s := by
        exact mul_le_mul_of_nonneg_right
          (le_add_of_nonneg_right hCl) hs.le
  · have hlargescale : 1 ≤ s := le_of_not_ge hsmallscale
    have hmin : min s s⁻¹ = s⁻¹ := by
      apply min_eq_right
      apply (inv_le_iff_one_le_mul₀ hs).mpr
      nlinarith [mul_nonneg hs.le (sub_nonneg.mpr hlargescale)]
    rw [hmin]
    calc
      |ModelSpatialProfile α u F t| ≤ Cl * s⁻¹ := hlarge'
      _ ≤ (Cs + Cl) * s⁻¹ := by
        exact mul_le_mul_of_nonneg_right
          (le_add_of_nonneg_left hCs) (inv_nonneg.mpr hs.le)

/-- The profile envelope is unconditional for every real Schwartz tuple:
the third-kernel moment and uniform bound have now both been established. -/
theorem exists_ModelSpatialProfile_scale_envelope_unconditional
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ t : ℝ, 0 < t →
      |ModelSpatialProfile α u F t| ≤ C *
        min (t ^ (α.weight 2 : ℝ)) (t ^ (-(α.weight 2 : ℝ))) := by
  rcases exists_bound_ModelThirdKernel with ⟨A, hA, hbound⟩
  exact exists_ModelSpatialProfile_scale_envelope α u F
    (integrable_abs_mul_ModelThirdKernel (u 2)) A (hbound (u 2))

/-- The literal dyadic scale truncations converge to the full model form for
every bounded measurable coefficient and real Schwartz input. -/
theorem tendsto_ModelScaleTruncation_of_realSchwartz
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1) :
    Tendsto (fun N ↦ ModelScaleTruncation α u c F N) atTop
      (𝓝 (ModelFullForm α u c F)) := by
  rcases exists_ModelSpatialProfile_scale_envelope_unconditional α u F
    with ⟨C, hC, hprofile⟩
  apply tendsto_modelScaleTruncation_of_bound
    (a := (α.weight 2 : ℝ)) (C := C)
  · exact_mod_cast α.weight_pos 2
  · exact hc
  · exact aestronglyMeasurable_modelScaleProfile_of_measurable
      α u c F hcmeas
  · exact hprofile

abbrev FiberDyadicBase := EuclideanSpace ℝ (Fin 2)
abbrev FiberDyadicLine := EuclideanSpace ℝ (Fin 1)

/-- The literal product Lebesgue measure used by the fiber operator. Naming
it avoids an ambiguity between the product measurable-space instance and the
derived product `MeasureSpace` instance. -/
abbrev fiberDyadicMeasure :
    @Measure (FiberDyadicBase × FiberDyadicLine) Prod.instMeasurableSpace :=
  (volume : Measure FiberDyadicBase).prod volume

/-- The literal dyadic Hardy--Littlewood maximum in the final coordinate. -/
noncomputable def fiberDyadicBallMaximal
    (G : FiberDyadicBase × FiberDyadicLine → ℂ)
    (q : FiberDyadicBase × FiberDyadicLine) : ℝ :=
  dyadicBallMaximal 1 (fun y => G (q.1, y)) q.2

/-- Bounded input makes every raw fiberwise dyadic supremum finite. -/
theorem fiberDyadicBallMaximalRaw_le_of_norm_le
    (G : FiberDyadicBase × FiberDyadicLine → ℂ)
    (q : FiberDyadicBase × FiberDyadicLine) (a : ℝ) (_ha : 0 ≤ a)
    (hG : ∀ z, ‖G z‖ ≤ a) :
    (⨆ n : ℤ,
      ((volume (Metric.ball q.2 ((2 : ℝ) ^ n)))⁻¹ *
        ∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n), ENNReal.ofReal ‖G (q.1, y)‖)) ≤
      ENNReal.ofReal a := by
  apply iSup_le
  intro n
  let r : ℝ := (2 : ℝ) ^ n
  have hr : 0 < r := by
    dsimp only [r]
    positivity
  have hvolpos : 0 < volume (Metric.ball q.2 r) :=
    Metric.measure_ball_pos volume q.2 hr
  have hvoltop : volume (Metric.ball q.2 r) ≠ (⊤ : ENNReal) :=
    measure_ball_lt_top.ne
  have hlin :
      (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y)‖) ≤
        ENNReal.ofReal a * volume (Metric.ball q.2 r) := by
    calc
      (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y)‖) ≤
          ∫⁻ _y in Metric.ball q.2 r, ENNReal.ofReal a := by
            apply lintegral_mono
            intro y
            exact ENNReal.ofReal_le_ofReal (hG (q.1, y))
      _ = ENNReal.ofReal a * volume (Metric.ball q.2 r) := by
          rw [lintegral_const]
          simp
  change (volume (Metric.ball q.2 r))⁻¹ *
      (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y)‖) ≤
        ENNReal.ofReal a
  calc
    (volume (Metric.ball q.2 r))⁻¹ *
        (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y)‖) ≤
      (volume (Metric.ball q.2 r))⁻¹ *
        (ENNReal.ofReal a * volume (Metric.ball q.2 r)) :=
      mul_le_mul_right hlin _
    _ = ENNReal.ofReal a := by
      calc
        (volume (Metric.ball q.2 r))⁻¹ *
            (ENNReal.ofReal a * volume (Metric.ball q.2 r)) =
          ENNReal.ofReal a *
            ((volume (Metric.ball q.2 r))⁻¹ * volume (Metric.ball q.2 r)) := by
              ac_rfl
        _ = ENNReal.ofReal a := by
            rw [ENNReal.inv_mul_cancel hvolpos.ne' hvoltop]
            simp

/-- A bounded input remains bounded under the literal fiberwise maximal
operator. -/
theorem fiberDyadicBallMaximal_top_bound
    (G : FiberDyadicBase × FiberDyadicLine → ℂ) (a : ℝ) (ha : 0 ≤ a)
    (hG : ∀ z, ‖G z‖ ≤ a) :
    ∀ q, fiberDyadicBallMaximal G q ≤ a := by
  intro q
  have hsup := fiberDyadicBallMaximalRaw_le_of_norm_le G q a ha hG
  unfold fiberDyadicBallMaximal dyadicBallMaximal dyadicBallMaximalRaw
  simpa [ENNReal.toReal_ofReal ha] using
    (ENNReal.toReal_le_toReal
      (ne_top_of_le_ne_top ENNReal.ofReal_ne_top hsup) ENNReal.ofReal_ne_top).mpr hsup

/-- Countability of the dyadic scales makes the literal fiberwise operator
measurable for a jointly measurable input. -/
theorem fiberDyadicBallMaximal_measurable
    (G : FiberDyadicBase × FiberDyadicLine → ℂ) (hG : Measurable G) :
    Measurable (fiberDyadicBallMaximal G) := by
  classical
  unfold fiberDyadicBallMaximal dyadicBallMaximal dyadicBallMaximalRaw
  have hA (n : ℤ) : Measurable (fun q : FiberDyadicBase × FiberDyadicLine =>
      ((volume (Metric.ball q.2 ((2 : ℝ) ^ n)))⁻¹ *
        ∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n), ENNReal.ofReal ‖G (q.1, y)‖)) := by
    let r : ℝ := (2 : ℝ) ^ n
    let S : Set ((FiberDyadicBase × FiberDyadicLine) × FiberDyadicLine) :=
      {a | dist a.1.2 a.2 < r}
    have hS : MeasurableSet S := by
      dsimp only [S]
      exact measurableSet_lt
        (continuous_dist.measurable.comp
          ((measurable_snd.comp measurable_fst).prodMk measurable_snd))
        measurable_const
    let F : (FiberDyadicBase × FiberDyadicLine) × FiberDyadicLine → ℝ≥0∞ := fun a =>
      S.indicator (fun a => ENNReal.ofReal ‖G (a.1.1, a.2)‖) a
    have hF : Measurable F := by
      dsimp only [F]
      have hcomp : Measurable (fun a : (FiberDyadicBase × FiberDyadicLine) ×
          FiberDyadicLine => G (a.1.1, a.2)) :=
        hG.comp ((measurable_fst.comp measurable_fst).prodMk measurable_snd)
      exact hcomp.norm.ennreal_ofReal.indicator hS
    have hI : Measurable (fun q : FiberDyadicBase × FiberDyadicLine =>
        ∫⁻ y : FiberDyadicLine, F (q, y)) := hF.lintegral_prod_right
    have hI' : (fun q : FiberDyadicBase × FiberDyadicLine =>
        ∫⁻ y : FiberDyadicLine, F (q, y)) =
        fun q => ∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y)‖ := by
      funext q
      rw [show (fun y : FiberDyadicLine => F (q, y)) =
          (Metric.ball q.2 r).indicator (fun y => ENNReal.ofReal ‖G (q.1, y)‖) by
        funext y
        have hmem : (q, y) ∈ S ↔ y ∈ Metric.ball q.2 r := by
          simp [S, Metric.mem_ball, dist_comm]
        by_cases hy : y ∈ Metric.ball q.2 r
        · have hs : (q, y) ∈ S := hmem.mpr hy
          simp [F, Set.indicator_apply, hs, hy]
        · have hs : (q, y) ∉ S := mt hmem.mp hy
          simp [F, Set.indicator_apply, hs, hy]]
      rw [lintegral_indicator measurableSet_ball]
    have hvol (q : FiberDyadicBase × FiberDyadicLine) :
        volume (Metric.ball q.2 r) = volume (Metric.ball (0 : FiberDyadicLine) r) := by
      rw [InnerProductSpace.volume_ball, InnerProductSpace.volume_ball]
    have hmain : (fun q : FiberDyadicBase × FiberDyadicLine =>
        ((volume (Metric.ball q.2 r))⁻¹ *
          ∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y)‖)) =
        fun q => (volume (Metric.ball (0 : FiberDyadicLine) r))⁻¹ *
          (∫⁻ y : FiberDyadicLine, F (q, y)) := by
      funext q
      rw [hvol q, ← congrFun hI' q]
    change Measurable (fun q : FiberDyadicBase × FiberDyadicLine =>
      ((volume (Metric.ball q.2 r))⁻¹ *
        ∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y)‖))
    rw [hmain]
    exact measurable_const.mul hI
  exact ENNReal.measurable_toReal.comp (Measurable.iSup hA)

/-- Tonelli lifts the public one-dimensional weak `(1,1)` dyadic maximal
estimate to the final-coordinate product-fiber operator. -/
theorem fiberDyadicBallMaximal_weak_one
    (G : FiberDyadicBase × FiberDyadicLine → ℂ) (hG : Measurable G)
    {s : ℝ} (hs : 0 < s) :
    ENNReal.ofReal s * fiberDyadicMeasure {q | s < fiberDyadicBallMaximal G q} ≤
      ENNReal.ofReal 4 * ∫⁻ q, ENNReal.ofReal ‖G q‖ ∂fiberDyadicMeasure := by
  have hM := fiberDyadicBallMaximal_measurable G hG
  let A : Set (FiberDyadicBase × FiberDyadicLine) :=
    {q | s < fiberDyadicBallMaximal G q}
  have hA : MeasurableSet A := by
    exact measurableSet_lt measurable_const hM
  change ENNReal.ofReal s * ((volume : Measure FiberDyadicBase).prod
    (volume : Measure FiberDyadicLine)) A ≤
      ENNReal.ofReal 4 * ∫⁻ q, ENNReal.ofReal ‖G q‖ ∂
        ((volume : Measure FiberDyadicBase).prod (volume : Measure FiberDyadicLine))
  rw [Measure.prod_apply hA]
  have hfiber (z : FiberDyadicBase) :
      ENNReal.ofReal s * volume (Prod.mk z ⁻¹' A) ≤
        ENNReal.ofReal 4 * ∫⁻ x : FiberDyadicLine, ENNReal.ofReal ‖G (z, x)‖ := by
    change ENNReal.ofReal s * volume {x | s <
      dyadicBallMaximal 1 (fun y => G (z, y)) x} ≤ _
    simpa using
      (dyadic_ball_maximal_toReal_weak_one (d := 1) (by norm_num)
        (fun y => G (z, y)) hs)
  rw [← lintegral_const_mul (μ := volume) (ENNReal.ofReal s)
    (measurable_measure_prodMk_left hA)]
  calc
    (∫⁻ z : FiberDyadicBase, ENNReal.ofReal s * volume (Prod.mk z ⁻¹' A)) ≤
        ∫⁻ z : FiberDyadicBase, ENNReal.ofReal 4 * ∫⁻ x : FiberDyadicLine,
          ENNReal.ofReal ‖G (z, x)‖ := by
      exact lintegral_mono fun z => hfiber z
    _ = ENNReal.ofReal 4 * ∫⁻ z : FiberDyadicBase, ∫⁻ x : FiberDyadicLine,
          ENNReal.ofReal ‖G (z, x)‖ := by
      rw [lintegral_const_mul (μ := volume) (ENNReal.ofReal 4)
        (hG.norm.ennreal_ofReal.lintegral_prod_right')]
    _ = ENNReal.ofReal 4 * ∫⁻ q : FiberDyadicBase × FiberDyadicLine,
          ENNReal.ofReal ‖G q‖ ∂
            ((volume : Measure FiberDyadicBase).prod (volume : Measure FiberDyadicLine)) := by
      rw [← MeasureTheory.lintegral_prod _ (hG.norm.ennreal_ofReal).aemeasurable]

/-- The literal fiberwise dyadic maximal operator is subadditive on bounded
measurable inputs. -/
theorem fiberDyadicBallMaximal_subadditive
    (G H : FiberDyadicBase × FiberDyadicLine → ℂ)
    (hG : Measurable G) (_hH : Measurable H)
    (hGb : ∃ a : ℝ, 0 ≤ a ∧ ∀ q, ‖G q‖ ≤ a)
    (hHb : ∃ a : ℝ, 0 ≤ a ∧ ∀ q, ‖H q‖ ≤ a) :
    ∀ q, fiberDyadicBallMaximal (G + H) q ≤
      fiberDyadicBallMaximal G q + fiberDyadicBallMaximal H q := by
  intro q
  obtain ⟨a, ha, hGa⟩ := hGb
  obtain ⟨b, hb, hHb⟩ := hHb
  let SG : ENNReal := (⨆ n : ℤ,
    ((volume (Metric.ball q.2 ((2 : ℝ) ^ n)))⁻¹ *
      ∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n), ENNReal.ofReal ‖G (q.1, y)‖))
  let SH : ENNReal := (⨆ n : ℤ,
    ((volume (Metric.ball q.2 ((2 : ℝ) ^ n)))⁻¹ *
      ∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n), ENNReal.ofReal ‖H (q.1, y)‖))
  let SGH : ENNReal := (⨆ n : ℤ,
    ((volume (Metric.ball q.2 ((2 : ℝ) ^ n)))⁻¹ *
      ∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n), ENNReal.ofReal ‖(G + H) (q.1, y)‖))
  have hSG : SG ≤ ENNReal.ofReal a :=
    fiberDyadicBallMaximalRaw_le_of_norm_le G q a ha hGa
  have hSH : SH ≤ ENNReal.ofReal b :=
    fiberDyadicBallMaximalRaw_le_of_norm_le H q b hb hHb
  have hSGH : SGH ≤ ENNReal.ofReal (a + b) := by
    apply fiberDyadicBallMaximalRaw_le_of_norm_le (G + H) q (a + b)
      (add_nonneg ha hb)
    intro z
    exact (norm_add_le _ _).trans (add_le_add (hGa z) (hHb z))
  have havgadd (n : ℤ) :
      ((volume (Metric.ball q.2 ((2 : ℝ) ^ n)))⁻¹ *
        ∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n),
          ENNReal.ofReal ‖G (q.1, y) + H (q.1, y)‖) ≤
      ((volume (Metric.ball q.2 ((2 : ℝ) ^ n)))⁻¹ *
        ∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n), ENNReal.ofReal ‖G (q.1, y)‖) +
      ((volume (Metric.ball q.2 ((2 : ℝ) ^ n)))⁻¹ *
        ∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n), ENNReal.ofReal ‖H (q.1, y)‖) := by
    let r : ℝ := (2 : ℝ) ^ n
    have hlin :
        (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y) + H (q.1, y)‖) ≤
          (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y)‖) +
            (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖H (q.1, y)‖) := by
      calc
        (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y) + H (q.1, y)‖) ≤
            ∫⁻ y in Metric.ball q.2 r,
              ENNReal.ofReal ‖G (q.1, y)‖ + ENNReal.ofReal ‖H (q.1, y)‖ := by
                apply lintegral_mono
                intro y
                simpa only [← ENNReal.ofReal_add (norm_nonneg (G (q.1, y)))
                  (norm_nonneg (H (q.1, y)))] using
                  ENNReal.ofReal_le_ofReal (norm_add_le (G (q.1, y)) (H (q.1, y)))
        _ = (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y)‖) +
          (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖H (q.1, y)‖) := by
              apply lintegral_add_left
              exact (hG.comp (measurable_const.prodMk measurable_id)).norm.ennreal_ofReal
    change (volume (Metric.ball q.2 r))⁻¹ *
      (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y) + H (q.1, y)‖) ≤
      (volume (Metric.ball q.2 r))⁻¹ *
        (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y)‖) +
      (volume (Metric.ball q.2 r))⁻¹ *
        (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖H (q.1, y)‖)
    calc
      (volume (Metric.ball q.2 r))⁻¹ *
          (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y) + H (q.1, y)‖) ≤
        (volume (Metric.ball q.2 r))⁻¹ *
          ((∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y)‖) +
            (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖H (q.1, y)‖)) :=
        mul_le_mul_right hlin _
      _ = (volume (Metric.ball q.2 r))⁻¹ *
            (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y)‖) +
          (volume (Metric.ball q.2 r))⁻¹ *
            (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖H (q.1, y)‖) := by
          rw [mul_add]
  have hsub : SGH ≤ SG + SH := by
    apply iSup_le
    intro n
    change ((volume (Metric.ball q.2 ((2 : ℝ) ^ n)))⁻¹ *
      ∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n),
        ENNReal.ofReal ‖G (q.1, y) + H (q.1, y)‖) ≤ SG + SH
    calc
      ((volume (Metric.ball q.2 ((2 : ℝ) ^ n)))⁻¹ *
          ∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n),
            ENNReal.ofReal ‖G (q.1, y) + H (q.1, y)‖) ≤
          ((volume (Metric.ball q.2 ((2 : ℝ) ^ n)))⁻¹ *
            ∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n), ENNReal.ofReal ‖G (q.1, y)‖) +
          ((volume (Metric.ball q.2 ((2 : ℝ) ^ n)))⁻¹ *
            ∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n), ENNReal.ofReal ‖H (q.1, y)‖) :=
        havgadd n
      _ ≤ SG + SH := by
        apply add_le_add
        · exact le_iSup (fun n : ℤ =>
            ((volume (Metric.ball q.2 ((2 : ℝ) ^ n)))⁻¹ *
              ∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n), ENNReal.ofReal ‖G (q.1, y)‖)) n
        · exact le_iSup (fun n : ℤ =>
            ((volume (Metric.ball q.2 ((2 : ℝ) ^ n)))⁻¹ *
              ∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n), ENNReal.ofReal ‖H (q.1, y)‖)) n
  have hSGtop : SG ≠ ⊤ := ne_top_of_le_ne_top ENNReal.ofReal_ne_top hSG
  have hSHtop : SH ≠ ⊤ := ne_top_of_le_ne_top ENNReal.ofReal_ne_top hSH
  have hSGHtop : SGH ≠ ⊤ := ne_top_of_le_ne_top ENNReal.ofReal_ne_top hSGH
  change SGH.toReal ≤ SG.toReal + SH.toReal
  calc
    SGH.toReal ≤ (SG + SH).toReal :=
      (ENNReal.toReal_le_toReal hSGHtop
        (ENNReal.add_ne_top.mpr ⟨hSGtop, hSHtop⟩)).mpr hsub
    _ = SG.toReal + SH.toReal := ENNReal.toReal_add hSGtop hSHtop

/-- The public Marcinkiewicz weak-one/top theorem gives a literal strong
fiberwise dyadic maximal estimate for every bounded measurable input. -/
theorem fiberDyadicBallMaximal_lintegral_bound
    (G : FiberDyadicBase × FiberDyadicLine → ℂ) (hG : Measurable G)
    (hGb : ∃ a : ℝ, 0 ≤ a ∧ ∀ q, ‖G q‖ ≤ a)
    {p : ℝ} (hp : 1 < p) :
    (∫⁻ q, ENNReal.ofReal (fiberDyadicBallMaximal G q ^ p) ∂fiberDyadicMeasure) ≤
      ENNReal.ofReal p *
        (2 * ENNReal.ofReal 4 * (ENNReal.ofReal (p - 1))⁻¹ *
          (ENNReal.ofReal (2 : ℝ)) ^ (p - 1) *
          ∫⁻ q, (ENNReal.ofReal ‖G q‖) ^ p ∂fiberDyadicMeasure) := by
  let D : ENNReal := ENNReal.ofReal 4
  have hnonneg : ∀ (g : FiberDyadicBase × FiberDyadicLine → ℂ) q,
      0 ≤ fiberDyadicBallMaximal g q := fun _ _ => ENNReal.toReal_nonneg
  have hsub : ∀ (g h : FiberDyadicBase × FiberDyadicLine → ℂ), Measurable g →
      Measurable h → (∃ a : ℝ, 0 ≤ a ∧ ∀ q, ‖g q‖ ≤ a) →
      (∃ a : ℝ, 0 ≤ a ∧ ∀ q, ‖h q‖ ≤ a) → ∀ q,
      fiberDyadicBallMaximal (g + h) q ≤
        fiberDyadicBallMaximal g q + fiberDyadicBallMaximal h q := by
    intro g h hg hh hgb hhb q
    exact fiberDyadicBallMaximal_subadditive g h hg hh hgb hhb q
  have hweak : ∀ (g : FiberDyadicBase × FiberDyadicLine → ℂ), Measurable g →
      (∃ a : ℝ, 0 ≤ a ∧ ∀ q, ‖g q‖ ≤ a) → ∀ {s : ℝ}, 0 < s →
      ENNReal.ofReal s * fiberDyadicMeasure {q | s < fiberDyadicBallMaximal g q} ≤
        D * ∫⁻ q, ENNReal.ofReal ‖g q‖ ∂fiberDyadicMeasure := by
    intro g hg _ s hs
    simpa only [D] using fiberDyadicBallMaximal_weak_one g hg hs
  have htop : ∀ (g : FiberDyadicBase × FiberDyadicLine → ℂ) (a : ℝ), 0 ≤ a →
      (∀ q, ‖g q‖ ≤ a) → ∀ q, fiberDyadicBallMaximal g q ≤ a := by
    intro g a ha hga q
    exact fiberDyadicBallMaximal_top_bound g a ha hga q
  simpa only [D] using
    (marcinkiewicz_weak_one_top fiberDyadicBallMaximal hnonneg hsub D hweak htop
      hp G hG hGb (fiberDyadicBallMaximal_measurable G hG).aemeasurable)

/-- The bounded-input product-fiber strong estimate supplies the `MemLp`
conclusion needed for an iterative coordinatewise maximal argument. -/
theorem fiberDyadicBallMaximal_memLp
    (G : FiberDyadicBase × FiberDyadicLine → ℂ) (hG : Measurable G)
    (hGb : ∃ a : ℝ, 0 ≤ a ∧ ∀ q, ‖G q‖ ≤ a)
    {p : ℝ} (hp : 1 < p) (hGp : MemLp G (ENNReal.ofReal p) fiberDyadicMeasure) :
    MemLp (fiberDyadicBallMaximal G) (ENNReal.ofReal p) fiberDyadicMeasure := by
  have hp0 : 0 < p := by linarith
  have hpEN0 : ENNReal.ofReal p ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp0
  have hpENT : ENNReal.ofReal p ≠ ⊤ := ENNReal.ofReal_ne_top
  have hinput : (∫⁻ q, (ENNReal.ofReal ‖G q‖) ^ p ∂fiberDyadicMeasure) < ∞ := by
    have h := (eLpNorm_lt_top_iff_lintegral_rpow_enorm_lt_top hpEN0 hpENT
      hGp.aestronglyMeasurable).mp hGp
    simpa [ENNReal.toReal_ofReal hp0.le, enorm_eq_nnnorm] using h
  have hinv : (ENNReal.ofReal (p - 1))⁻¹ < ∞ := by
    apply ENNReal.inv_lt_top.mpr
    exact ENNReal.ofReal_pos.mpr (by linarith)
  have hpow : (ENNReal.ofReal (2 : ℝ)) ^ (p - 1) < ∞ := by
    apply ENNReal.rpow_lt_top_of_nonneg
    · linarith
    · exact ENNReal.ofReal_ne_top
  have htwofour : (2 : ENNReal) * ENNReal.ofReal 4 < ∞ :=
    ENNReal.mul_lt_top (by norm_num) ENNReal.ofReal_lt_top
  have htwofourinv : (2 : ENNReal) * ENNReal.ofReal 4 *
      (ENNReal.ofReal (p - 1))⁻¹ < ∞ :=
    ENNReal.mul_lt_top htwofour hinv
  have hcoef : 2 * ENNReal.ofReal 4 * (ENNReal.ofReal (p - 1))⁻¹ *
      (ENNReal.ofReal (2 : ℝ)) ^ (p - 1) < ∞ := by
    exact ENNReal.mul_lt_top htwofourinv hpow
  have hright : ENNReal.ofReal p *
      (2 * ENNReal.ofReal 4 * (ENNReal.ofReal (p - 1))⁻¹ *
        (ENNReal.ofReal (2 : ℝ)) ^ (p - 1) *
        ∫⁻ q, (ENNReal.ofReal ‖G q‖) ^ p ∂fiberDyadicMeasure) < ∞ := by
    apply ENNReal.mul_lt_top ENNReal.ofReal_lt_top
    exact ENNReal.mul_lt_top hcoef hinput
  apply memLp_of_lintegral_ofReal_rpow_lt_top
    (fiberDyadicBallMaximal G)
    (fiberDyadicBallMaximal_measurable G hG).aemeasurable
    (fun _ ↦ ENNReal.toReal_nonneg) hp0
  apply lt_of_le_of_lt (fiberDyadicBallMaximal_lintegral_bound G hG hGb hp)
  exact hright
/-- Reindex a literal transverse Euclidean plane as `Fin 2` Euclidean space. -/
noncomputable def transverseToFiberDyadicBase (i : Fin 3) :
    TransverseSpace i ≃ᵐ FiberDyadicBase :=
  ((MeasurableEquiv.toLp 2 ({j : Fin 3 // j ≠ i} → ℝ)).symm.trans
    (MeasurableEquiv.piCongrLeft (fun _ : {j : Fin 3 // j ≠ i} ↦ ℝ)
      (transverseIndexEquiv i)).symm).trans
    (MeasurableEquiv.toLp 2 (Fin 2 → ℝ))

/-- Identify the active real coordinate with one-dimensional Euclidean space. -/
noncomputable def realToFiberDyadicLine : ℝ ≃ᵐ FiberDyadicLine :=
  (MeasurableEquiv.piUnique (fun _ : Fin 1 ↦ ℝ)).symm.trans
    (MeasurableEquiv.toLp 2 (Fin 1 → ℝ))

/-- Split `E3` into an arbitrary transverse plane and the chosen active line,
in the product order expected by `fiberDyadicBallMaximal`. -/
noncomputable def e3ToFiberDyadicCoordinates (i : Fin 3) :
    E3 ≃ᵐ FiberDyadicBase × FiberDyadicLine :=
  (coordinateSplitEquiv i).trans
    ((MeasurableEquiv.prodComm : ℝ × TransverseSpace i ≃ᵐ
      TransverseSpace i × ℝ).trans
      (MeasurableEquiv.prodCongr (transverseToFiberDyadicBase i)
        realToFiberDyadicLine))

theorem transverseToFiberDyadicBase_measurePreserving (i : Fin 3) :
    MeasurePreserving (transverseToFiberDyadicBase i) volume volume := by
  have h0 : MeasurePreserving
      (MeasurableEquiv.toLp 2 ({j : Fin 3 // j ≠ i} → ℝ)).symm volume volume :=
    EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp
      {j : Fin 3 // j ≠ i}
  have h1 : MeasurePreserving
      (MeasurableEquiv.piCongrLeft (fun _ : {j : Fin 3 // j ≠ i} ↦ ℝ)
        (transverseIndexEquiv i)).symm volume volume :=
    (volume_measurePreserving_piCongrLeft
      (fun _ : {j : Fin 3 // j ≠ i} ↦ ℝ) (transverseIndexEquiv i)).symm
  have h2 : MeasurePreserving
      (MeasurableEquiv.toLp 2 (Fin 2 → ℝ)) volume volume :=
    PiLp.volume_preserving_toLp (Fin 2)
  exact h2.comp (h1.comp h0)

theorem realToFiberDyadicLine_measurePreserving :
    MeasurePreserving realToFiberDyadicLine volume volume := by
  have h0 : MeasurePreserving
      (MeasurableEquiv.piUnique (fun _ : Fin 1 ↦ ℝ)).symm volume volume :=
    (volume_preserving_piUnique (fun _ : Fin 1 ↦ ℝ)).symm
  have h1 : MeasurePreserving
      (MeasurableEquiv.toLp 2 (Fin 1 → ℝ)) volume volume :=
    PiLp.volume_preserving_toLp (Fin 1)
  exact h1.comp h0

theorem e3ToFiberDyadicCoordinates_measurePreserving (i : Fin 3) :
    MeasurePreserving (e3ToFiberDyadicCoordinates i) volume fiberDyadicMeasure := by
  have h0 : MeasurePreserving (coordinateSplitEquiv i) volume volume :=
    coordinateSplitEquiv_measurePreserving i
  have h1 : MeasurePreserving
      (MeasurableEquiv.prodComm : ℝ × TransverseSpace i ≃ᵐ
        TransverseSpace i × ℝ) volume volume := by
    change MeasurePreserving Prod.swap
      ((volume : Measure ℝ).prod volume)
      (volume.prod (volume : Measure ℝ))
    exact Measure.measurePreserving_swap
  have h2 : MeasurePreserving
      (MeasurableEquiv.prodCongr (transverseToFiberDyadicBase i)
        realToFiberDyadicLine) volume volume :=
    (transverseToFiberDyadicBase_measurePreserving i).prod
      realToFiberDyadicLine_measurePreserving
  exact h2.comp (h1.comp h0)

/-- The dyadic maximal operator acting in the literal `i`th coordinate of
`E3`, transported through the measure-preserving active/transverse split. -/
noncomputable def coordinateDyadicBallMaximal
    (i : Fin 3) (f : E3 → ℂ) : E3 → ℝ :=
  fun p ↦ fiberDyadicBallMaximal
    (fun z ↦ f ((e3ToFiberDyadicCoordinates i).symm z))
    (e3ToFiberDyadicCoordinates i p)

theorem coordinateDyadicBallMaximal_measurable
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f) :
    Measurable (coordinateDyadicBallMaximal i f) := by
  let e := e3ToFiberDyadicCoordinates i
  let G : FiberDyadicBase × FiberDyadicLine → ℂ := f ∘ e.symm
  have hG : Measurable G := hf.comp e.symm.measurable
  change Measurable (fun p ↦ fiberDyadicBallMaximal G (e p))
  exact (fiberDyadicBallMaximal_measurable G hG).comp e.measurable

theorem coordinateDyadicBallMaximal_top_bound
    (i : Fin 3) (f : E3 → ℂ) (A : ℝ) (hA : 0 ≤ A)
    (hf : ∀ p, ‖f p‖ ≤ A) :
    ∀ p, coordinateDyadicBallMaximal i f p ≤ A := by
  let e := e3ToFiberDyadicCoordinates i
  let G : FiberDyadicBase × FiberDyadicLine → ℂ := f ∘ e.symm
  have hG : ∀ z, ‖G z‖ ≤ A := by
    intro z
    exact hf (e.symm z)
  change ∀ p, fiberDyadicBallMaximal G (e p) ≤ A
  intro p
  exact fiberDyadicBallMaximal_top_bound G A hA hG (e p)

/-- Strong `L^p` control transports from the product-fiber operator back to
each literal coordinate of `E3`. -/
theorem coordinateDyadicBallMaximal_memLp
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ p, ‖f p‖ ≤ A)
    {p : ℝ} (hp : 1 < p) (hfp : MemLp f (ENNReal.ofReal p) volume) :
    MemLp (coordinateDyadicBallMaximal i f) (ENNReal.ofReal p) volume := by
  let e := e3ToFiberDyadicCoordinates i
  let G : FiberDyadicBase × FiberDyadicLine → ℂ := f ∘ e.symm
  have he : MeasurePreserving e volume fiberDyadicMeasure := by
    simpa only [e] using e3ToFiberDyadicCoordinates_measurePreserving i
  have hGmeas : Measurable G := hf.comp e.symm.measurable
  have hGbound : ∀ z, ‖G z‖ ≤ A := by
    intro z
    exact hbound (e.symm z)
  have hGmem : MemLp G (ENNReal.ofReal p) fiberDyadicMeasure := by
    have h := hfp.comp_measurePreserving (MeasurePreserving.symm e he)
    simpa only [G] using h
  have hM := fiberDyadicBallMaximal_memLp G hGmeas ⟨A, hA, hGbound⟩ hp hGmem
  have htransport := hM.comp_measurePreserving he
  change MemLp (fun p ↦ fiberDyadicBallMaximal G (e p))
    (ENNReal.ofReal p) volume
  simpa only [Function.comp_def] using htransport

/-- Complex-valued packaging of the real nonnegative coordinate maximal
operator, so it can be iterated without changing codomain. -/
noncomputable def coordinateDyadicBallMaximalComplex
    (i : Fin 3) (f : E3 → ℂ) : E3 → ℂ :=
  fun p ↦ (coordinateDyadicBallMaximal i f p : ℂ)

theorem coordinateDyadicBallMaximalComplex_measurable
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f) :
    Measurable (coordinateDyadicBallMaximalComplex i f) := by
  exact Complex.continuous_ofReal.measurable.comp
    (coordinateDyadicBallMaximal_measurable i f hf)

theorem coordinateDyadicBallMaximalComplex_top_bound
    (i : Fin 3) (f : E3 → ℂ) (A : ℝ) (hA : 0 ≤ A)
    (hf : ∀ p, ‖f p‖ ≤ A) :
    ∀ p, ‖coordinateDyadicBallMaximalComplex i f p‖ ≤ A := by
  intro p
  have hnonneg : 0 ≤ coordinateDyadicBallMaximal i f p := ENNReal.toReal_nonneg
  change ‖(coordinateDyadicBallMaximal i f p : ℂ)‖ ≤ A
  simpa only [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hnonneg] using
    coordinateDyadicBallMaximal_top_bound i f A hA hf p

theorem coordinateDyadicBallMaximalComplex_memLp
    (i : Fin 3) (f : E3 → ℂ) (hf : Measurable f)
    (A : ℝ) (hA : 0 ≤ A) (hbound : ∀ p, ‖f p‖ ≤ A)
    {p : ℝ} (hp : 1 < p) (hfp : MemLp f (ENNReal.ofReal p) volume) :
    MemLp (coordinateDyadicBallMaximalComplex i f) (ENNReal.ofReal p) volume := by
  change MemLp (fun x ↦ (coordinateDyadicBallMaximal i f x : ℂ))
    (ENNReal.ofReal p) volume
  exact (coordinateDyadicBallMaximal_memLp i f hf A hA hbound hp hfp).ofReal

/-- The three-coordinate iterated dyadic maximal operator. Each stage acts
in one ambient coordinate and is retransported back to `E3` before the next
stage, so no implicit product-coordinate convention is used. -/
noncomputable def iteratedCoordinateDyadicBallMaximal
    (f : E3 → ℂ) : E3 → ℂ :=
  coordinateDyadicBallMaximalComplex (2 : Fin 3)
    (coordinateDyadicBallMaximalComplex (1 : Fin 3)
      (coordinateDyadicBallMaximalComplex (0 : Fin 3) f))

theorem iteratedCoordinateDyadicBallMaximal_measurable
    (f : E3 → ℂ) (hf : Measurable f) :
    Measurable (iteratedCoordinateDyadicBallMaximal f) := by
  let f₀ := coordinateDyadicBallMaximalComplex (0 : Fin 3) f
  let f₁ := coordinateDyadicBallMaximalComplex (1 : Fin 3) f₀
  have hf₀ : Measurable f₀ := by
    dsimp only [f₀]
    exact coordinateDyadicBallMaximalComplex_measurable 0 f hf
  have hf₁ : Measurable f₁ := by
    dsimp only [f₁]
    exact coordinateDyadicBallMaximalComplex_measurable 1 f₀ hf₀
  change Measurable (coordinateDyadicBallMaximalComplex 2 f₁)
  exact coordinateDyadicBallMaximalComplex_measurable 2 f₁ hf₁

theorem iteratedCoordinateDyadicBallMaximal_top_bound
    (f : E3 → ℂ) (A : ℝ) (hA : 0 ≤ A)
    (hbound : ∀ p, ‖f p‖ ≤ A) :
    ∀ p, ‖iteratedCoordinateDyadicBallMaximal f p‖ ≤ A := by
  let f₀ := coordinateDyadicBallMaximalComplex (0 : Fin 3) f
  let f₁ := coordinateDyadicBallMaximalComplex (1 : Fin 3) f₀
  have hbound₀ : ∀ p, ‖f₀ p‖ ≤ A := by
    dsimp only [f₀]
    exact coordinateDyadicBallMaximalComplex_top_bound 0 f A hA hbound
  have hbound₁ : ∀ p, ‖f₁ p‖ ≤ A := by
    dsimp only [f₁]
    exact coordinateDyadicBallMaximalComplex_top_bound 1 f₀ A hA hbound₀
  change ∀ p, ‖coordinateDyadicBallMaximalComplex 2 f₁ p‖ ≤ A
  exact coordinateDyadicBallMaximalComplex_top_bound 2 f₁ A hA hbound₁

/-- Iterating the literal one-dimensional dyadic maximal theorem preserves
every finite `L^p`, provided the initial input is bounded and measurable. -/
theorem iteratedCoordinateDyadicBallMaximal_memLp
    (f : E3 → ℂ) (hf : Measurable f) (A : ℝ) (hA : 0 ≤ A)
    (hbound : ∀ p, ‖f p‖ ≤ A)
    {p : ℝ} (hp : 1 < p) (hfp : MemLp f (ENNReal.ofReal p) volume) :
    MemLp (iteratedCoordinateDyadicBallMaximal f) (ENNReal.ofReal p) volume := by
  let f₀ := coordinateDyadicBallMaximalComplex (0 : Fin 3) f
  let f₁ := coordinateDyadicBallMaximalComplex (1 : Fin 3) f₀
  have hf₀ : Measurable f₀ := by
    dsimp only [f₀]
    exact coordinateDyadicBallMaximalComplex_measurable 0 f hf
  have hbound₀ : ∀ q, ‖f₀ q‖ ≤ A := by
    dsimp only [f₀]
    exact coordinateDyadicBallMaximalComplex_top_bound 0 f A hA hbound
  have hmem₀ : MemLp f₀ (ENNReal.ofReal p) volume := by
    dsimp only [f₀]
    exact coordinateDyadicBallMaximalComplex_memLp 0 f hf A hA hbound hp hfp
  have hf₁ : Measurable f₁ := by
    dsimp only [f₁]
    exact coordinateDyadicBallMaximalComplex_measurable 1 f₀ hf₀
  have hbound₁ : ∀ q, ‖f₁ q‖ ≤ A := by
    dsimp only [f₁]
    exact coordinateDyadicBallMaximalComplex_top_bound 1 f₀ A hA hbound₀
  have hmem₁ : MemLp f₁ (ENNReal.ofReal p) volume := by
    dsimp only [f₁]
    exact coordinateDyadicBallMaximalComplex_memLp 1 f₀ hf₀ A hA hbound₀ hp hmem₀
  change MemLp (coordinateDyadicBallMaximalComplex 2 f₁)
    (ENNReal.ofReal p) volume
  exact coordinateDyadicBallMaximalComplex_memLp 2 f₁ hf₁ A hA hbound₁ hp hmem₁
/-- A bounded measurable fiber has finite mass on every dyadic line ball,
and that mass is controlled by the literal fiberwise dyadic maximum. -/
theorem fiberDyadicBall_integral_le_dyadic_average_sup
    (G : FiberDyadicBase × FiberDyadicLine → ℂ) (hG : Measurable G)
    (a : ℝ) (ha : 0 ≤ a) (hGa : ∀ z, ‖G z‖ ≤ a)
    (q : FiberDyadicBase × FiberDyadicLine) (m : ℤ) :
    (∫ y in Metric.ball q.2 ((2 : ℝ) ^ m), ‖G (q.1, y)‖) ≤
      fiberDyadicBallMaximal G q *
        (volume (Metric.ball q.2 ((2 : ℝ) ^ m))).toReal := by
  let S : ENNReal := ⨆ n : ℤ,
    ((volume (Metric.ball q.2 ((2 : ℝ) ^ n)))⁻¹ *
      ∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n), ENNReal.ofReal ‖G (q.1, y)‖)
  have hSle : S ≤ ENNReal.ofReal a := by
    dsimp only [S]
    exact fiberDyadicBallMaximalRaw_le_of_norm_le G q a ha hGa
  have hSfin : S ≠ ⊤ :=
    ne_top_of_le_ne_top ENNReal.ofReal_ne_top hSle
  let r : ℝ := (2 : ℝ) ^ m
  have hr : 0 < r := by
    dsimp only [r]
    positivity
  have hvolpos : 0 < volume (Metric.ball q.2 r) :=
    Metric.measure_ball_pos volume q.2 hr
  have hvoltop : volume (Metric.ball q.2 r) ≠ (⊤ : ENNReal) :=
    measure_ball_lt_top.ne
  have havg :
      (volume (Metric.ball q.2 r))⁻¹ *
        (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y)‖) ≤ S := by
    dsimp only [S]
    exact le_iSup (fun n : ℤ =>
      (volume (Metric.ball q.2 ((2 : ℝ) ^ n)))⁻¹ *
        ∫⁻ y in Metric.ball q.2 ((2 : ℝ) ^ n), ENNReal.ofReal ‖G (q.1, y)‖) m
  have hlin :
      (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y)‖) ≤
        S * volume (Metric.ball q.2 r) := by
    calc
      (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y)‖) =
          ((volume (Metric.ball q.2 r))⁻¹ *
            (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y)‖)) *
              volume (Metric.ball q.2 r) := by
            calc
              (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y)‖) =
                  1 * (∫⁻ y in Metric.ball q.2 r,
                    ENNReal.ofReal ‖G (q.1, y)‖) := by rw [one_mul]
              _ = ((volume (Metric.ball q.2 r))⁻¹ * volume (Metric.ball q.2 r)) *
                    (∫⁻ y in Metric.ball q.2 r,
                      ENNReal.ofReal ‖G (q.1, y)‖) := by
                    rw [ENNReal.inv_mul_cancel hvolpos.ne' hvoltop]
              _ = ((volume (Metric.ball q.2 r))⁻¹ *
                    (∫⁻ y in Metric.ball q.2 r,
                      ENNReal.ofReal ‖G (q.1, y)‖)) *
                    volume (Metric.ball q.2 r) := by ac_rfl
      _ ≤ S * volume (Metric.ball q.2 r) := by
        calc
          ((volume (Metric.ball q.2 r))⁻¹ *
              (∫⁻ y in Metric.ball q.2 r,
                ENNReal.ofReal ‖G (q.1, y)‖)) * volume (Metric.ball q.2 r) =
              volume (Metric.ball q.2 r) *
                ((volume (Metric.ball q.2 r))⁻¹ *
                  (∫⁻ y in Metric.ball q.2 r,
                    ENNReal.ofReal ‖G (q.1, y)‖)) := by ac_rfl
          _ ≤ volume (Metric.ball q.2 r) * S := mul_le_mul_right havg _
          _ = S * volume (Metric.ball q.2 r) := by ac_rfl
  have hline_meas : Measurable (fun y : FiberDyadicLine => ‖G (q.1, y)‖) :=
    (hG.comp (measurable_const.prodMk measurable_id)).norm
  have hline_int : IntegrableOn (fun y : FiberDyadicLine => ‖G (q.1, y)‖)
      (Metric.ball q.2 r) volume := by
    refine IntegrableOn.of_bound measure_ball_lt_top hline_meas.aestronglyMeasurable a ?_
    filter_upwards [] with y
    rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
    exact hGa (q.1, y)
  have hlinfin :
      (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y)‖) ≠ ⊤ :=
    hline_int.lintegral_lt_top.ne
  have hreal :
      (∫ y in Metric.ball q.2 r, ‖G (q.1, y)‖) =
        (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y)‖).toReal := by
    have hnonneg : 0 ≤ ∫ y in Metric.ball q.2 r, ‖G (q.1, y)‖ :=
      integral_nonneg fun y => norm_nonneg _
    rw [← ENNReal.toReal_ofReal hnonneg,
      MeasureTheory.ofReal_integral_eq_lintegral_ofReal hline_int
        (Filter.Eventually.of_forall fun _ => norm_nonneg _)]
  change (∫ y in Metric.ball q.2 r, ‖G (q.1, y)‖) ≤
    S.toReal * (volume (Metric.ball q.2 r)).toReal
  calc
    (∫ y in Metric.ball q.2 r, ‖G (q.1, y)‖) =
        (∫⁻ y in Metric.ball q.2 r, ENNReal.ofReal ‖G (q.1, y)‖).toReal := hreal
    _ ≤ (S * volume (Metric.ball q.2 r)).toReal :=
      (ENNReal.toReal_le_toReal hlinfin
        (ENNReal.mul_ne_top hSfin hvoltop)).2 hlin
    _ = S.toReal * (volume (Metric.ball q.2 r)).toReal := ENNReal.toReal_mul

/-- The literal fiber maximum controls balls of arbitrary positive radius.
The factor `2` is the sole loss from rounding the radius up to a dyadic one. -/
theorem fiberDyadicBall_integral_le_dyadic_average_sup_any_radius
    (G : FiberDyadicBase × FiberDyadicLine → ℂ) (hG : Measurable G)
    (a : ℝ) (ha : 0 ≤ a) (hGa : ∀ z, ‖G z‖ ≤ a)
    (q : FiberDyadicBase × FiberDyadicLine) {R : ℝ} (hR : 0 < R) :
    (∫ y in Metric.ball q.2 R, ‖G (q.1, y)‖) ≤
      fiberDyadicBallMaximal G q *
        (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal * (2 * R) := by
  obtain ⟨m, hm⟩ := exists_mem_Ico_zpow hR (by norm_num : (1 : ℝ) < 2)
  have hsubset : Metric.ball q.2 R ⊆ Metric.ball q.2 ((2 : ℝ) ^ (m + 1)) :=
    Metric.ball_subset_ball hm.2.le
  have hline_meas : Measurable (fun y : FiberDyadicLine => ‖G (q.1, y)‖) :=
    (hG.comp (measurable_const.prodMk measurable_id)).norm
  have htarget_int : IntegrableOn (fun y : FiberDyadicLine => ‖G (q.1, y)‖)
      (Metric.ball q.2 ((2 : ℝ) ^ (m + 1))) volume := by
    refine IntegrableOn.of_bound measure_ball_lt_top hline_meas.aestronglyMeasurable a ?_
    filter_upwards [] with y
    rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
    exact hGa (q.1, y)
  have hmono :
      (∫ y in Metric.ball q.2 R, ‖G (q.1, y)‖) ≤
        ∫ y in Metric.ball q.2 ((2 : ℝ) ^ (m + 1)), ‖G (q.1, y)‖ := by
    apply MeasureTheory.setIntegral_mono_set htarget_int
    · exact Filter.Eventually.of_forall fun y => norm_nonneg _
    · exact Filter.Eventually.of_forall hsubset
  have hrad : (2 : ℝ) ^ (m + 1) ≤ 2 * R := by
    calc
      (2 : ℝ) ^ (m + 1) = (2 : ℝ) ^ m * (2 : ℝ) ^ (1 : ℤ) :=
        zpow_add₀ (by norm_num) m 1
      _ = 2 * (2 : ℝ) ^ m := by norm_num; ring
      _ ≤ 2 * R := mul_le_mul_of_nonneg_left hm.1 (by norm_num)
  have hradpos : 0 < (2 : ℝ) ^ (m + 1) := by positivity
  have hvol : volume (Metric.ball q.2 ((2 : ℝ) ^ (m + 1))) =
      ENNReal.ofReal ((2 : ℝ) ^ (m + 1)) *
        volume (Metric.ball (0 : FiberDyadicLine) 1) := by
    rw [Measure.addHaar_ball_of_pos volume q.2 hradpos]
    simp only [finrank_euclideanSpace_fin]
    norm_num
  have hdyadic := fiberDyadicBall_integral_le_dyadic_average_sup
    G hG a ha hGa q (m + 1)
  have hfactor_nonneg : 0 ≤
      fiberDyadicBallMaximal G q *
        (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal := by
    exact mul_nonneg ENNReal.toReal_nonneg ENNReal.toReal_nonneg
  calc
    (∫ y in Metric.ball q.2 R, ‖G (q.1, y)‖) ≤
        ∫ y in Metric.ball q.2 ((2 : ℝ) ^ (m + 1)), ‖G (q.1, y)‖ := hmono
    _ ≤ fiberDyadicBallMaximal G q *
        (volume (Metric.ball q.2 ((2 : ℝ) ^ (m + 1)))).toReal := hdyadic
    _ = fiberDyadicBallMaximal G q *
        (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal *
          ((2 : ℝ) ^ (m + 1)) := by
      rw [hvol, ENNReal.toReal_mul,
        ENNReal.toReal_ofReal hradpos.le]
      ring
    _ ≤ fiberDyadicBallMaximal G q *
        (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal * (2 * R) :=
      mul_le_mul_of_nonneg_left hrad hfactor_nonneg

/-- The radial version of the source bracket kernel on the one-dimensional
fiber Euclidean space. This formulation is invariant under later coordinate
reorderings. -/
noncomputable def fiberRadialBracket (z : FiberDyadicLine) : ℝ :=
  (1 + ‖z‖) ^ (-10 : ℝ)

theorem fiberRadialBracket_nonneg (z : FiberDyadicLine) :
    0 ≤ fiberRadialBracket z := by
  unfold fiberRadialBracket
  positivity

theorem fiberRadialBracket_le_one (z : FiberDyadicLine) :
    fiberRadialBracket z ≤ 1 := by
  unfold fiberRadialBracket
  exact Real.rpow_le_one_of_one_le_of_nonpos
    (le_add_of_nonneg_right (norm_nonneg _)) (by norm_num)

theorem integrable_fiberRadialBracket : Integrable fiberRadialBracket := by
  unfold fiberRadialBracket
  exact integrable_one_add_norm (E := FiberDyadicLine) (μ := volume)
    (r := (10 : ℝ)) (by norm_num)

/-- The scale cancellation in the one-dimensional shell decomposition. -/
private theorem fiber_shell_tail_coefficient
    (A r : ℝ) (n : ℕ) (hr : 0 < r) :
    (A * r⁻¹ * (((2 : ℝ)⁻¹) ^ (1 + 3)) ^ n) *
        (2 * ((2 : ℝ) ^ (n + 2) * r)) =
      A * (2 : ℝ) ^ 3 * (1 / 8 : ℝ) ^ n := by
  have hr0 : r ≠ 0 := hr.ne'
  rw [show 2 * ((2 : ℝ) ^ (n + 2) * r) =
      (2 : ℝ) ^ (n + 3) * r by
        rw [show n + 3 = (n + 2) + 1 by omega, pow_succ]
        ring]
  rw [show (((2 : ℝ)⁻¹) ^ (1 + 3)) ^ n =
      ((2 : ℝ)⁻¹) ^ ((1 + 3) * n) by rw [pow_mul]]
  rw [show ((2 : ℝ)⁻¹) ^ ((1 + 3) * n) =
      ((2 : ℝ) ^ ((1 + 3) * n))⁻¹ by rw [inv_pow]]
  rw [show (1 / 8 : ℝ) = ((2 : ℝ)⁻¹) ^ 3 by norm_num]
  rw [← pow_mul, inv_pow]
  norm_num
  field_simp
  ring

private theorem fiber_exists_dyadic_annulus {t : ℝ} (ht : 2 ≤ t) :
    ∃ n : ℕ, (2 : ℝ) ^ n ≤ t ∧ t < (2 : ℝ) ^ (n + 1) := by
  have hpow : Filter.Tendsto (fun n : ℕ => (2 : ℝ) ^ n) Filter.atTop Filter.atTop :=
    tendsto_pow_atTop_atTop_of_one_lt (by norm_num)
  obtain ⟨m, hm⟩ := Filter.eventually_atTop.1 (hpow.eventually_gt_atTop t)
  have hexists : ∃ n : ℕ, t < (2 : ℝ) ^ (n + 1) := by
    refine ⟨m, ?_⟩
    apply (hm m le_rfl).trans_le
    rw [show m + 1 = Nat.succ m by omega, pow_succ]
    have hnonneg : 0 ≤ (2 : ℝ) ^ m := pow_nonneg (by norm_num) _
    nlinarith
  let n : ℕ := Nat.find hexists
  have hnupper : t < (2 : ℝ) ^ (n + 1) := Nat.find_spec hexists
  have hnpos : 0 < n := by
    by_contra h
    have hnzero : n = 0 := Nat.eq_zero_of_not_pos h
    have hsmall : t < 2 := by
      simpa [hnzero] using hnupper
    linarith
  have hnlower : (2 : ℝ) ^ n ≤ t := by
    by_contra h
    have hlt : t < (2 : ℝ) ^ n := lt_of_not_ge h
    have hpred : n - 1 + 1 = n := Nat.sub_add_cancel (Nat.succ_le_iff.2 hnpos)
    have : t < (2 : ℝ) ^ ((n - 1) + 1) := by simpa [hpred] using hlt
    exact (not_lt_of_ge (Nat.find_min' hexists this))
      (Nat.sub_lt hnpos (by omega))
  exact ⟨n, hnlower, hnupper⟩

/-- A bounded measurable one-dimensional fiber is controlled by its literal
dyadic-ball maximal function against every nonnegative summable shell kernel.
The separate integrability hypothesis is discharged below for the bracket
kernel, and is what makes this version reusable after one maximal iteration. -/
theorem fiber_shell_weighted_integral_le_dyadic_average_sup
    (G : FiberDyadicBase × FiberDyadicLine → ℂ) (hG : Measurable G)
    (a : ℝ) (ha : 0 ≤ a) (hGa : ∀ z, ‖G z‖ ≤ a)
    (W : FiberDyadicLine → ℝ)
    {C L r : ℝ} (hC : 0 ≤ C) (hL : 1 ≤ L) (hr : 0 < r)
    (hW_nonneg : ∀ z, 0 ≤ W z)
    (hW_near : ∀ z, W z ≤ C * L)
    (hW_tail : ∀ (z : FiberDyadicLine) (m : ℕ),
      (2 : ℝ) ^ m / L ≤ |‖z‖ - 1| →
        W z ≤ C * L * (((2 : ℝ)⁻¹) ^ (1 + 3)) ^ m)
    (q : FiberDyadicBase × FiberDyadicLine) :
    (∫ y : FiberDyadicLine,
      ‖G (q.1, y)‖ * (r⁻¹ * W (r⁻¹ • (y - q.2)))) ≤
      2 * ((C * L) *
        (fiberDyadicBallMaximal G q *
          (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) *
        (2 : ℝ) ^ 3) := by
  let ρ : ℝ := ((2 : ℝ)⁻¹) ^ (1 + 3)
  let A : ℝ := C * L
  let M : ℝ := fiberDyadicBallMaximal G q *
    (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal
  have hL_nonneg : 0 ≤ L := le_trans zero_le_one hL
  have hA : 0 ≤ A := mul_nonneg hC hL_nonneg
  have hM : 0 ≤ M := by
    dsimp [M]
    exact mul_nonneg ENNReal.toReal_nonneg ENNReal.toReal_nonneg
  have hrinv_nonneg : 0 ≤ r⁻¹ := inv_nonneg.mpr hr.le
  have hρ_nonneg : 0 ≤ ρ := by
    dsimp [ρ]
    positivity
  have hρ_lt_one : ρ < 1 := by
    dsimp [ρ]
    norm_num
  have hρ_norm_lt_one : ‖ρ‖ < 1 := by
    rw [Real.norm_eq_abs, abs_of_nonneg hρ_nonneg]
    exact hρ_lt_one
  have hgeom : Summable fun n : ℕ => ρ ^ n :=
    summable_geometric_of_norm_lt_one hρ_norm_lt_one
  have hline_meas : Measurable (fun y : FiberDyadicLine => ‖G (q.1, y)‖) :=
    (hG.comp (measurable_const.prodMk measurable_id)).norm
  let F : ℕ → FiberDyadicLine → ℝ := fun n y =>
    (A * r⁻¹ * ρ ^ n) *
      (Metric.ball q.2 ((2 : ℝ) ^ (n + 2) * r)).indicator
        (fun z => ‖G (q.1, z)‖) y
  have hF_nonneg (n : ℕ) (y : FiberDyadicLine) : 0 ≤ F n y := by
    dsimp [F]
    apply mul_nonneg
    · exact mul_nonneg (mul_nonneg hA hrinv_nonneg) (pow_nonneg hρ_nonneg _)
    · apply Set.indicator_nonneg
      intro z _
      exact norm_nonneg _
  have hF_le_major (n : ℕ) (y : FiberDyadicLine) :
      F n y ≤ (A * r⁻¹ * a) * ρ ^ n := by
    dsimp [F]
    have hind :
        (Metric.ball q.2 ((2 : ℝ) ^ (n + 2) * r)).indicator
          (fun z => ‖G (q.1, z)‖) y ≤ a := by
      by_cases hy : y ∈ Metric.ball q.2 ((2 : ℝ) ^ (n + 2) * r)
      · simpa [hy] using hGa (q.1, y)
      · simp [hy, ha]
    calc
      (A * r⁻¹ * ρ ^ n) *
          (Metric.ball q.2 ((2 : ℝ) ^ (n + 2) * r)).indicator
            (fun z => ‖G (q.1, z)‖) y ≤
          (A * r⁻¹ * ρ ^ n) * a :=
        mul_le_mul_of_nonneg_left hind
          (mul_nonneg (mul_nonneg hA hrinv_nonneg) (pow_nonneg hρ_nonneg _))
      _ = (A * r⁻¹ * a) * ρ ^ n := by ring
  have hF_pointwise_summable (y : FiberDyadicLine) :
      Summable fun n : ℕ => F n y := by
    refine Summable.of_nonneg_of_le
      (f := fun n : ℕ => (A * r⁻¹ * a) * ρ ^ n)
      (g := fun n : ℕ => F n y) ?_ ?_ ?_
    · intro n
      exact hF_nonneg n y
    · intro n
      exact hF_le_major n y
    · simpa [mul_assoc] using hgeom.mul_left (A * r⁻¹ * a)
  have hball_of_scaled_norm_lt (n : ℕ) (y : FiberDyadicLine)
      (hy : ‖r⁻¹ • (y - q.2)‖ < (2 : ℝ) ^ (n + 2)) :
      y ∈ Metric.ball q.2 ((2 : ℝ) ^ (n + 2) * r) := by
    rw [Metric.mem_ball, dist_eq_norm_sub]
    have hnorm : ‖y - q.2‖ = r * ‖r⁻¹ • (y - q.2)‖ := by
      rw [norm_smul_of_nonneg hrinv_nonneg]
      field_simp [hr.ne']
    calc
      ‖y - q.2‖ = r * ‖r⁻¹ • (y - q.2)‖ := hnorm
      _ < r * (2 : ℝ) ^ (n + 2) := mul_lt_mul_of_pos_left hy hr
      _ = (2 : ℝ) ^ (n + 2) * r := by ring
  have hpointwise (y : FiberDyadicLine) :
      ‖G (q.1, y)‖ * (r⁻¹ * W (r⁻¹ • (y - q.2))) ≤ ∑' n : ℕ, F n y := by
    have hsum := hF_pointwise_summable y
    by_cases hy : ‖r⁻¹ • (y - q.2)‖ < 2
    · have hyball : y ∈ Metric.ball q.2 ((2 : ℝ) ^ (0 + 2) * r) := by
        apply hball_of_scaled_norm_lt 0 y
        calc
          ‖r⁻¹ • (y - q.2)‖ < 2 := hy
          _ < (2 : ℝ) ^ (0 + 2) := by norm_num
      have hterm :
          ‖G (q.1, y)‖ * (r⁻¹ * W (r⁻¹ • (y - q.2))) ≤ F 0 y := by
        have hW := hW_near (r⁻¹ • (y - q.2))
        calc
          ‖G (q.1, y)‖ * (r⁻¹ * W (r⁻¹ • (y - q.2))) ≤
              ‖G (q.1, y)‖ * (r⁻¹ * A) := by
            apply mul_le_mul_of_nonneg_left
            · exact mul_le_mul_of_nonneg_left hW hrinv_nonneg
            · exact norm_nonneg _
          _ = F 0 y := by
            dsimp [F, ρ]
            rw [Set.indicator_of_mem hyball]
            norm_num
            ring
      exact hterm.trans (hsum.le_tsum 0 fun j _ => hF_nonneg j y)
    · have htwo : 2 ≤ ‖r⁻¹ • (y - q.2)‖ := le_of_not_gt hy
      obtain ⟨k, hklow, hkupper⟩ := fiber_exists_dyadic_annulus htwo
      have hkpos : 0 < k := by
        by_contra hk
        have hkzero : k = 0 := Nat.eq_zero_of_not_pos hk
        have hsmall : ‖r⁻¹ • (y - q.2)‖ < 2 := by
          simpa [hkzero] using hkupper
        exact (not_lt_of_ge htwo) hsmall
      let n : ℕ := k - 1
      have hnadd : n + 1 = k := by
        dsimp [n]
        omega
      have hnadd' : n + 2 = k + 1 := by omega
      have hlow : (2 : ℝ) ^ (n + 1) ≤ ‖r⁻¹ • (y - q.2)‖ := by
        simpa [hnadd] using hklow
      have hupp : ‖r⁻¹ • (y - q.2)‖ < (2 : ℝ) ^ (n + 2) := by
        simpa [hnadd'] using hkupper
      have hnorm_one : 1 ≤ ‖r⁻¹ • (y - q.2)‖ := by
        calc
          1 ≤ (2 : ℝ) ^ (n + 1) := one_le_pow₀ (by norm_num)
          _ ≤ ‖r⁻¹ • (y - q.2)‖ := hlow
      have hsub : (2 : ℝ) ^ n ≤ ‖r⁻¹ • (y - q.2)‖ - 1 := by
        have hpow_one : 1 ≤ (2 : ℝ) ^ n := one_le_pow₀ (by norm_num)
        rw [show (2 : ℝ) ^ (n + 1) = 2 * (2 : ℝ) ^ n by
          rw [pow_succ]
          ring] at hlow
        nlinarith
      have habs : (2 : ℝ) ^ n ≤ |‖r⁻¹ • (y - q.2)‖ - 1| := by
        rw [abs_of_nonneg (sub_nonneg.mpr hnorm_one)]
        exact hsub
      have hdiv : (2 : ℝ) ^ n / L ≤ |‖r⁻¹ • (y - q.2)‖ - 1| := by
        calc
          (2 : ℝ) ^ n / L ≤ (2 : ℝ) ^ n := by
            apply (div_le_iff₀ (lt_of_lt_of_le zero_lt_one hL)).2
            calc
              (2 : ℝ) ^ n = (2 : ℝ) ^ n * 1 := by ring
              _ ≤ (2 : ℝ) ^ n * L :=
                mul_le_mul_of_nonneg_left hL (pow_nonneg (by norm_num) _)
          _ ≤ _ := habs
      have hyball : y ∈ Metric.ball q.2 ((2 : ℝ) ^ (n + 2) * r) :=
        hball_of_scaled_norm_lt n y hupp
      have hterm :
          ‖G (q.1, y)‖ * (r⁻¹ * W (r⁻¹ • (y - q.2))) ≤ F n y := by
        have hW := hW_tail (r⁻¹ • (y - q.2)) n hdiv
        calc
          ‖G (q.1, y)‖ * (r⁻¹ * W (r⁻¹ • (y - q.2))) ≤
              ‖G (q.1, y)‖ * (r⁻¹ * (A * ρ ^ n)) := by
            apply mul_le_mul_of_nonneg_left
            · exact mul_le_mul_of_nonneg_left (by simpa [A, ρ] using hW) hrinv_nonneg
            · exact norm_nonneg _
          _ = F n y := by
            dsimp [F]
            rw [Set.indicator_of_mem hyball]
            ring
      exact hterm.trans (hsum.le_tsum n fun j _ => hF_nonneg j y)
  have hF_integrable (n : ℕ) : Integrable (F n) volume := by
    dsimp [F]
    have hline_int : IntegrableOn (fun y : FiberDyadicLine => ‖G (q.1, y)‖)
        (Metric.ball q.2 ((2 : ℝ) ^ (n + 2) * r)) volume := by
      refine IntegrableOn.of_bound measure_ball_lt_top hline_meas.aestronglyMeasurable a ?_
      filter_upwards [] with y
      rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
      exact hGa (q.1, y)
    exact (hline_int.integrable_indicator measurableSet_ball).const_mul
      (A * r⁻¹ * ρ ^ n)
  have hF_integral (n : ℕ) :
      (∫ y : FiberDyadicLine, F n y) =
        (A * r⁻¹ * ρ ^ n) *
          (∫ y in Metric.ball q.2 ((2 : ℝ) ^ (n + 2) * r), ‖G (q.1, y)‖) := by
    dsimp [F]
    rw [integral_const_mul, integral_indicator measurableSet_ball]
  have hF_integral_bound (n : ℕ) :
      (∫ y : FiberDyadicLine, F n y) ≤
        (A * M * (2 : ℝ) ^ 3) * (1 / 8 : ℝ) ^ n := by
    have hradius : 0 < (2 : ℝ) ^ (n + 2) * r :=
      mul_pos (pow_pos (by norm_num) _) hr
    rw [hF_integral]
    calc
      (A * r⁻¹ * ρ ^ n) *
          (∫ y in Metric.ball q.2 ((2 : ℝ) ^ (n + 2) * r), ‖G (q.1, y)‖) ≤
          (A * r⁻¹ * ρ ^ n) *
            (M * (2 * ((2 : ℝ) ^ (n + 2) * r))) :=
        mul_le_mul_of_nonneg_left
          (by
            simpa [M, mul_assoc] using
              (fiberDyadicBall_integral_le_dyadic_average_sup_any_radius
                G hG a ha hGa q hradius))
          (mul_nonneg (mul_nonneg hA hrinv_nonneg) (pow_nonneg hρ_nonneg _))
      _ = (A * M * (2 : ℝ) ^ 3) * (1 / 8 : ℝ) ^ n := by
        dsimp [ρ]
        convert fiber_shell_tail_coefficient (A * M) r n hr using 1
        ring
  have hG_summable : Summable fun n : ℕ =>
      (A * M * (2 : ℝ) ^ 3) * (1 / 8 : ℝ) ^ n := by
    have heighth : ‖(1 / 8 : ℝ)‖ < 1 := by norm_num
    have hbase := (summable_geometric_of_norm_lt_one heighth).mul_left
      (A * M * (2 : ℝ) ^ 3)
    exact hbase
  have hF_summable_integral_norm : Summable fun n : ℕ =>
      ∫ y : FiberDyadicLine, ‖F n y‖ := by
    refine Summable.of_nonneg_of_le
      (f := fun n : ℕ => (A * M * (2 : ℝ) ^ 3) * (1 / 8 : ℝ) ^ n)
      (g := fun n : ℕ => ∫ y : FiberDyadicLine, ‖F n y‖) ?_ ?_ hG_summable
    · intro n
      exact integral_nonneg fun y => norm_nonneg _
    · intro n
      have hnorm : (∫ y : FiberDyadicLine, ‖F n y‖) = ∫ y : FiberDyadicLine, F n y := by
        apply integral_congr_ae
        filter_upwards with y
        rw [Real.norm_of_nonneg (hF_nonneg n y)]
      rw [hnorm]
      exact hF_integral_bound n
  have hF_enorm_sum_lt_top :
      (∑' n : ℕ, ∫⁻ y : FiberDyadicLine, ‖F n y‖ₑ) < ⊤ := by
    calc
      (∑' n : ℕ, ∫⁻ y : FiberDyadicLine, ‖F n y‖ₑ) =
          ∑' n : ℕ, ENNReal.ofReal (∫ y : FiberDyadicLine, ‖F n y‖) := by
        apply tsum_congr
        intro n
        exact (ofReal_integral_norm_eq_lintegral_enorm (hF_integrable n)).symm
      _ < ⊤ := hF_summable_integral_norm.tsum_ofReal_lt_top
  have htsum_measurable : AEStronglyMeasurable
      (fun y : FiberDyadicLine => ∑' n : ℕ, F n y) volume :=
    AEStronglyMeasurable.tsum fun n => (hF_integrable n).aestronglyMeasurable
  have htsum_integrable : Integrable (fun y : FiberDyadicLine => ∑' n : ℕ, F n y) volume := by
    refine ⟨htsum_measurable, ?_⟩
    rw [hasFiniteIntegral_iff_enorm]
    calc
      ∫⁻ y : FiberDyadicLine, ‖∑' n : ℕ, F n y‖ₑ ≤
          ∫⁻ y : FiberDyadicLine, ∑' n : ℕ, ‖F n y‖ₑ :=
        lintegral_mono fun y => enorm_tsum_le_tsum_enorm
      _ = ∑' n : ℕ, ∫⁻ y : FiberDyadicLine, ‖F n y‖ₑ :=
        lintegral_tsum fun n => (hF_integrable n).aestronglyMeasurable.enorm
      _ < ⊤ := hF_enorm_sum_lt_top
  have htsum_integral :
      (∫ y : FiberDyadicLine, ∑' n : ℕ, F n y) =
        ∑' n : ℕ, ∫ y : FiberDyadicLine, F n y := by
    exact (MeasureTheory.integral_tsum_of_summable_integral_norm
      hF_integrable hF_summable_integral_norm).symm
  have hF_summable_integral : Summable fun n : ℕ =>
      ∫ y : FiberDyadicLine, F n y := by
    refine Summable.of_nonneg_of_le
      (f := fun n : ℕ => (A * M * (2 : ℝ) ^ 3) * (1 / 8 : ℝ) ^ n)
      (g := fun n : ℕ => ∫ y : FiberDyadicLine, F n y) ?_ ?_ hG_summable
    · intro n
      exact integral_nonneg fun y => hF_nonneg n y
    · intro n
      exact hF_integral_bound n
  have hD_nonneg : 0 ≤ A * M * (2 : ℝ) ^ 3 := by positivity
  have heighth : ‖(1 / 8 : ℝ)‖ < 1 := by norm_num
  have hsum_eighth : ∑' n : ℕ, (1 / 8 : ℝ) ^ n = 8 / 7 := by
    rw [(hasSum_geometric_of_norm_lt_one heighth).tsum_eq]
    norm_num
  have hsum_integrals_bound :
      (∑' n : ℕ, ∫ y : FiberDyadicLine, F n y) ≤
        2 * (A * M * (2 : ℝ) ^ 3) := by
    calc
      (∑' n : ℕ, ∫ y : FiberDyadicLine, F n y) ≤
          ∑' n : ℕ, (A * M * (2 : ℝ) ^ 3) * (1 / 8 : ℝ) ^ n :=
        Summable.tsum_le_tsum (fun n => hF_integral_bound n)
          hF_summable_integral hG_summable
      _ = (A * M * (2 : ℝ) ^ 3) * ∑' n : ℕ, (1 / 8 : ℝ) ^ n := by
        rw [tsum_mul_left]
      _ = (A * M * (2 : ℝ) ^ 3) * (8 / 7) := by rw [hsum_eighth]
      _ ≤ (A * M * (2 : ℝ) ^ 3) * 2 :=
        mul_le_mul_of_nonneg_left (by norm_num) hD_nonneg
      _ = 2 * (A * M * (2 : ℝ) ^ 3) := by ring
  have hleft_nonneg (y : FiberDyadicLine) :
      0 ≤ ‖G (q.1, y)‖ * (r⁻¹ * W (r⁻¹ • (y - q.2))) := by
    exact mul_nonneg (norm_nonneg _)
      (mul_nonneg hrinv_nonneg (hW_nonneg _))
  calc
    (∫ y : FiberDyadicLine,
        ‖G (q.1, y)‖ * (r⁻¹ * W (r⁻¹ • (y - q.2)))) ≤
        ∫ y : FiberDyadicLine, ∑' n : ℕ, F n y :=
      integral_mono_of_nonneg
        (Filter.Eventually.of_forall hleft_nonneg) htsum_integrable
        (Filter.Eventually.of_forall hpointwise)
    _ = ∑' n : ℕ, ∫ y : FiberDyadicLine, F n y := htsum_integral
    _ ≤ 2 * (A * M * (2 : ℝ) ^ 3) := hsum_integrals_bound
    _ = _ := by
      dsimp [A, M]

theorem fiberRadialBracket_tail (z : FiberDyadicLine) (m : ℕ)
    (h : (2 : ℝ) ^ m ≤ |‖z‖ - 1|) :
    fiberRadialBracket z ≤ (((2 : ℝ)⁻¹) ^ (1 + 3)) ^ m := by
  rcases Nat.eq_zero_or_pos m with rfl | hm
  · simpa using fiberRadialBracket_le_one z
  have hpow_two : 2 ≤ (2 : ℝ) ^ m := by
    calc
      2 = (2 : ℝ) ^ 1 := by norm_num
      _ ≤ (2 : ℝ) ^ m := pow_le_pow_right₀ (by norm_num) (by omega)
  have hsub_nonneg : 0 ≤ ‖z‖ - 1 := by
    by_contra hneg
    have hsubneg : ‖z‖ - 1 < 0 := lt_of_not_ge hneg
    have habs_eq : |‖z‖ - 1| = 1 - ‖z‖ := by
      rw [abs_of_neg hsubneg]
      ring
    have habs_le : |‖z‖ - 1| ≤ 1 := by
      rw [habs_eq]
      linarith [norm_nonneg z]
    nlinarith
  have hbase : (2 : ℝ) ^ m ≤ 1 + ‖z‖ := by
    rw [abs_of_nonneg hsub_nonneg] at h
    linarith
  have hdenom : (2 : ℝ) ^ (4 * m) ≤ (1 + ‖z‖) ^ 10 := by
    calc
      (2 : ℝ) ^ (4 * m) ≤ (2 : ℝ) ^ (10 * m) :=
        pow_le_pow_right₀ (by norm_num) (by omega)
      _ = ((2 : ℝ) ^ m) ^ 10 := by
        calc
          (2 : ℝ) ^ (10 * m) = (2 : ℝ) ^ (m * 10) := by
            congr 1
            omega
          _ = ((2 : ℝ) ^ m) ^ 10 := pow_mul (2 : ℝ) m 10
      _ ≤ (1 + ‖z‖) ^ 10 :=
        pow_le_pow_left₀ (pow_nonneg (by norm_num) _) hbase 10
  have hdenom_pos : 0 < (2 : ℝ) ^ (4 * m) := pow_pos (by norm_num) _
  have htop_pos : 0 < (1 + ‖z‖) ^ 10 := pow_pos (by positivity) _
  have hinv : ((1 + ‖z‖) ^ 10)⁻¹ ≤ ((2 : ℝ) ^ (4 * m))⁻¹ :=
    (inv_le_inv₀ htop_pos hdenom_pos).2 hdenom
  have hbracket_eq : fiberRadialBracket z = ((1 + ‖z‖) ^ 10)⁻¹ := by
    unfold fiberRadialBracket
    rw [Real.rpow_neg (by positivity)]
    exact congrArg Inv.inv (Real.rpow_natCast (1 + ‖z‖) 10)
  have htail_eq : (((2 : ℝ)⁻¹) ^ (1 + 3)) ^ m =
      ((2 : ℝ) ^ (4 * m))⁻¹ := by
    norm_num
    rw [show (1 / 16 : ℝ) = (16 : ℝ)⁻¹ by norm_num, inv_pow]
    congr 1
    calc
      (16 : ℝ) ^ m = ((2 : ℝ) ^ 4) ^ m := by norm_num
      _ = (2 : ℝ) ^ (4 * m) := (pow_mul (2 : ℝ) 4 m).symm
  calc
    fiberRadialBracket z = ((1 + ‖z‖) ^ 10)⁻¹ := hbracket_eq
    _ ≤ ((2 : ℝ) ^ (4 * m))⁻¹ := hinv
    _ = (((2 : ℝ)⁻¹) ^ (1 + 3)) ^ m := htail_eq.symm

/-- The bounded-measurable one-dimensional bracket convolution is pointwise
controlled by the literal fiber dyadic-ball maximal function, uniformly over
all positive continuous scales. -/
theorem fiberRadialBracket_integral_le_dyadic_average_sup
    (G : FiberDyadicBase × FiberDyadicLine → ℂ) (hG : Measurable G)
    (a : ℝ) (ha : 0 ≤ a) (hGa : ∀ z, ‖G z‖ ≤ a)
    (q : FiberDyadicBase × FiberDyadicLine) {r : ℝ} (hr : 0 < r) :
    (∫ y : FiberDyadicLine,
      ‖G (q.1, y)‖ * (r⁻¹ * fiberRadialBracket (r⁻¹ • (y - q.2)))) ≤
      16 * (fiberDyadicBallMaximal G q *
        (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) := by
  have hmain := fiber_shell_weighted_integral_le_dyadic_average_sup
    G hG a ha hGa fiberRadialBracket
    (C := 1) (L := 1) (r := r) (by norm_num) (by norm_num) hr
    fiberRadialBracket_nonneg
    (fun z => by simpa using fiberRadialBracket_le_one z)
    (fun z m hz => by
      simpa using fiberRadialBracket_tail z m (by simpa using hz))
    q
  convert hmain using 1
  norm_num
  ring

/-! ## Dominant stopping-envelope algebra -/

/-- At zero normalization shift, the fiber with dominant coordinate zero has
the exact dyadic exponent prescribed by the reciprocal-sum relation. -/
theorem dominantFiberEnvelope_zero_case0
    (q : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1) (m : ℤ) :
    (2 : ℝ) ^ m * (2 * 2 ^ (q 0 / q 1 * (m : ℝ))) *
      (2 * 2 ^ (q 0 / q 2 * (m : ℝ))) *
      (2 * 2 ^ (q 0 / q 3 * (m : ℝ))) =
        8 * (2 : ℝ) ^ (q 0 * (m : ℝ)) := by
  have hcoeff : (m : ℝ) + q 0 / q 1 * (m : ℝ) +
      q 0 / q 2 * (m : ℝ) + q 0 / q 3 * (m : ℝ) =
        q 0 * (m : ℝ) := by
    have hsum' : (q 0)⁻¹ + (q 1)⁻¹ + (q 2)⁻¹ + (q 3)⁻¹ = 1 := by
      simpa only [Fin.sum_univ_four] using hsum
    field_simp [ne_of_gt (hq 0), ne_of_gt (hq 1), ne_of_gt (hq 2),
      ne_of_gt (hq 3)] at hsum' ⊢
    ring_nf at hsum' ⊢
    linear_combination (m : ℝ) * hsum'
  have htwo : 0 < (2 : ℝ) := by norm_num
  have hpow : (2 : ℝ) ^ m * 2 ^ (q 0 / q 1 * (m : ℝ)) *
      2 ^ (q 0 / q 2 * (m : ℝ)) * 2 ^ (q 0 / q 3 * (m : ℝ)) =
        2 ^ (q 0 * (m : ℝ)) := by
    rw [← Real.rpow_intCast, ← Real.rpow_add htwo,
      ← Real.rpow_add htwo, ← Real.rpow_add htwo, hcoeff]
  calc
    (2 : ℝ) ^ m * (2 * 2 ^ (q 0 / q 1 * (m : ℝ))) *
        (2 * 2 ^ (q 0 / q 2 * (m : ℝ))) *
        (2 * 2 ^ (q 0 / q 3 * (m : ℝ))) =
        8 * ((2 : ℝ) ^ m * 2 ^ (q 0 / q 1 * (m : ℝ)) *
          2 ^ (q 0 / q 2 * (m : ℝ)) * 2 ^ (q 0 / q 3 * (m : ℝ))) := by ring
    _ = 8 * (2 : ℝ) ^ (q 0 * (m : ℝ)) := by rw [hpow]

/-- At zero normalization shift, the fiber with dominant coordinate one has
the exact dyadic exponent prescribed by the reciprocal-sum relation. -/
theorem dominantFiberEnvelope_zero_case1
    (q : Fin 4 → ℝ) (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1) (m : ℤ) :
    (2 * 2 ^ (q 1 / q 0 * (m : ℝ))) * (2 : ℝ) ^ m *
      (2 * 2 ^ (q 1 / q 2 * (m : ℝ))) *
      (2 * 2 ^ (q 1 / q 3 * (m : ℝ))) =
        8 * (2 : ℝ) ^ (q 1 * (m : ℝ)) := by
  have hcoeff : q 1 / q 0 * (m : ℝ) + (m : ℝ) +
      q 1 / q 2 * (m : ℝ) + q 1 / q 3 * (m : ℝ) =
        q 1 * (m : ℝ) := by
    have hsum' : (q 0)⁻¹ + (q 1)⁻¹ + (q 2)⁻¹ + (q 3)⁻¹ = 1 := by
      simpa only [Fin.sum_univ_four] using hsum
    field_simp [ne_of_gt (hq 0), ne_of_gt (hq 1), ne_of_gt (hq 2),
      ne_of_gt (hq 3)] at hsum' ⊢
    ring_nf at hsum' ⊢
    linear_combination (m : ℝ) * hsum'
  have htwo : 0 < (2 : ℝ) := by norm_num
  have hpow : 2 ^ (q 1 / q 0 * (m : ℝ)) * (2 : ℝ) ^ m *
      2 ^ (q 1 / q 2 * (m : ℝ)) * 2 ^ (q 1 / q 3 * (m : ℝ)) =
        2 ^ (q 1 * (m : ℝ)) := by
    rw [← Real.rpow_intCast, ← Real.rpow_add htwo,
      ← Real.rpow_add htwo, ← Real.rpow_add htwo, hcoeff]
  calc
    (2 * 2 ^ (q 1 / q 0 * (m : ℝ))) * (2 : ℝ) ^ m *
        (2 * 2 ^ (q 1 / q 2 * (m : ℝ))) *
        (2 * 2 ^ (q 1 / q 3 * (m : ℝ))) =
        8 * (2 ^ (q 1 / q 0 * (m : ℝ)) * (2 : ℝ) ^ m *
          2 ^ (q 1 / q 2 * (m : ℝ)) * 2 ^ (q 1 / q 3 * (m : ℝ))) := by ring
    _ = 8 * (2 : ℝ) ^ (q 1 * (m : ℝ)) := by rw [hpow]

