/-- The continuity hypotheses in the finite forest theorem are automatic for
real Schwartz inputs. -/
theorem initialModelRealInput_continuous
    (F : InitialModelSchwartzInput) :
    ∀ j : Fin 4, Continuous (InitialModelRealInput F j) := by
  intro j
  exact (F j).continuous

/-- The uniform boundedness hypotheses in the finite forest theorem are
automatic for real Schwartz inputs. -/
theorem initialModelRealInput_bounded
    (F : InitialModelSchwartzInput) :
    ∀ j : Fin 4, ∃ B : ℝ, 0 ≤ B ∧
      ∀ y : E3, |InitialModelRealInput F j y| ≤ B := by
  intro j
  refine ⟨SchwartzMap.seminorm ℝ 0 0 (F j), ?_, ?_⟩
  · exact (norm_nonneg ((F j) 0)).trans
      (SchwartzMap.norm_le_seminorm ℝ (F j) (0 : E3))
  · intro y
    simpa only [InitialModelRealInput, Real.norm_eq_abs] using
      (SchwartzMap.norm_le_seminorm ℝ (F j) y)

