/-- Lift the first fiber's parameter-integral measurability across the
additional source-scale coordinate. -/
theorem aestronglyMeasurable_modelFirstFiber_lift
    (α : Anisotropy) (f : ModelRealInput) (hcont : ∀ j, Continuous (f j))
    (μ : Measure ((E3 × ℝ) × (ModelE5 × ℝ))) :
    AEStronglyMeasurable (fun q ↦
      modelFirstFiber α f q.1.1 q.1.2 q.2.1) μ := by
  have hproj : Measurable (fun qv : ((E3 × ℝ) × (ModelE5 × ℝ)) × ℝ ↦
      ((qv.1.1, qv.1.2.1), qv.2)) := by
    exact ((measurable_fst.comp measurable_fst).prodMk
      (measurable_fst.comp (measurable_snd.comp measurable_fst))).prodMk
        measurable_snd
  have hjoint : AEStronglyMeasurable
      (fun qv : ((E3 × ℝ) × (ModelE5 × ℝ)) × ℝ ↦
        f 0 (modelPoint (qv.1.2.1 0) (qv.1.2.1 1) qv.2) *
        f 1 (modelPoint (qv.1.2.1 2) (qv.1.2.1 1) qv.2) *
        f 2 (modelPoint (qv.1.2.1 0) (qv.1.2.1 3) qv.2) *
        gaussianDerivAt (qv.1.1.2 ^ α.weight 2) (qv.1.1.1 2) qv.2)
      (μ.prod volume) := by
    exact ((measurable_modelFirstFiber_integrand α f hcont).comp hproj).aestronglyMeasurable
  simpa only [modelFirstFiber] using hjoint.integral_prod_right'

