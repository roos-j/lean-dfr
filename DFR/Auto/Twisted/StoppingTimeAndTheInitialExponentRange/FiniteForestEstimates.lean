/-! ### Coefficient cutoffs and finite-forest transfer -/

/-- Restrict a scale coefficient to a measurable scale set. This is the
literal replacement `c ↦ c 1_A` used to transfer finite-forest estimates to
scale truncations. -/
noncomputable def RestrictScaleCoefficient
    (c : ℝ → ℝ) (A : Set ℝ) : ℝ → ℝ :=
  A.indicator c

/-- Restricting a coefficient preserves the unit coefficient hypothesis. -/
theorem abs_restrictScaleCoefficient_le_one
    (c : ℝ → ℝ) (A : Set ℝ) (hc : ∀ t : ℝ, |c t| ≤ 1) :
    ∀ t : ℝ, |RestrictScaleCoefficient c A t| ≤ 1 := by
  intro t
  by_cases ht : t ∈ A
  · rw [RestrictScaleCoefficient, Set.indicator_of_mem ht]
    exact hc t
  · rw [RestrictScaleCoefficient, Set.indicator_of_notMem ht]
    norm_num

/-- Every source dyadic truncation scale is positive. -/
theorem truncationScaleSet_subset_positive (N : ℕ) :
    truncationScaleSet N ⊆ Set.Ioi (0 : ℝ) := by
  intro t ht
  change t ∈ Set.Ioc ((2 : ℝ) ^ (-(N : ℤ) - 1)) ((2 : ℝ) ^ (N : ℤ)) at ht
  exact lt_trans (zpow_pos (by norm_num) _) ht.1

