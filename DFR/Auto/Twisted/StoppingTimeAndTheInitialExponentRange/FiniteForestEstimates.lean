      (ν.prod ((volume : Measure E3).prod (κ.prod volume)))
      (ν.prod (((volume : Measure E3).prod κ).prod volume)) := by
    exact (MeasurePreserving.id ν).prod
      (measurePreserving_prodAssoc volume κ volume).symm
  let h₅ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
        (MeasurableEquiv.prodCongr
