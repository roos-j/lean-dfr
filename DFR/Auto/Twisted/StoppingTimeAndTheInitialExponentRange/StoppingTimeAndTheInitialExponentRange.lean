/-- **`lem:forest_bound`**.

If `p_0,p_1,p_2 > 4`, `2 ≤ p_3 < ∞`, all exponents finite and
`∑_j p_j^{-1} = 1`, then for real Schwartz inputs
`|L_{Q_0,u,c}(f)| ≤ C_{α,p} U(u)^{100} ∏_{j=0}^3 ‖f_j‖_{p_j}`,
uniformly over finite convex collections.

This is the forest sum's reduction to the maximal-level sum. -/
theorem lem_forest_bound
    (α : Anisotropy) (S : BoxCollection α)
    (hS : IsConvexCollection α S) (f : ModelRealInput)
    (hpos : ∀ q ∈ S, ∀ j,
      0 < stoppingData α S (sourceStoppingExponent j) (f j) q)
    (hcont : ∀ j, Continuous (f j))
    (hbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hfinite : ∀ n, volume (sourceStoppingMaximalLevelSet α f n) ≠ ∞) :
    (∑ n ∈ activeStoppingLevels α S sourceStoppingExponent f hpos,
      ∑ Q ∈ (stoppingRoots α S sourceStoppingExponent f n).attach,
        boxMass α Q.1 *
          (∏ j : Fin 4,
            treeLocalSize
              (stoppingTree α S sourceStoppingExponent f n
                (isConvexCollection_stoppingLevel α S hS
                  sourceStoppingExponent f n) Q.1 Q.2)
              (sourceStoppingExponent j) (f j))) ≤
      ∑ n ∈ activeStoppingLevels α S sourceStoppingExponent f hpos,
        (∏ j : Fin 4, (2 : ℝ) ^ n j) *
          (volume (sourceStoppingMaximalLevelSet α f n)).toReal :=
  sourceStoppingForestWeightedSum_le_maximalLevelSum α S hS f hpos hcont hbound hfinite

