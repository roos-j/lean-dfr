/-! ## Cancellation of a selected fiber dyadic bad atom -/

/-- The literal selected bad atom on one source dyadic interval.  It is
supported on the selected rectangle and subtracts the fixed-fiber average. -/
noncomputable def scratch_fiberDyadicSelectedBadAtom
    {Z : Type*} [MeasurableSpace Z] (F : ℝ × Z → ℝ)
    (S : FiberDyadicInterval → Set Z) (I : FiberDyadicInterval) : ℝ × Z → ℝ :=
  (fiberDyadicInterval I ×ˢ S I).indicator
    (fun yz ↦ F yz - fiberDyadicIntervalAverage F I yz.2)

/-- The fixed-fiber selected atom is integrable whenever the input fiber is
integrable.  This is the finite-family summation premise; no measurability of
the selection is needed after a transverse fiber has been fixed. -/
theorem scratch_integrable_fiberDyadicSelectedBadAtom
    {Z : Type*} [MeasurableSpace Z] (F : ℝ × Z → ℝ)
    (S : FiberDyadicInterval → Set Z) (I : FiberDyadicInterval) (z : Z)
    (hF : Integrable (fun y : ℝ ↦ F (y, z))) :
    Integrable (fun y : ℝ ↦ scratch_fiberDyadicSelectedBadAtom F S I (y, z)) := by
  by_cases hz : z ∈ S I
  · have hatom : (fun y : ℝ ↦ scratch_fiberDyadicSelectedBadAtom F S I (y, z)) =
        (fiberDyadicInterval I).indicator
          (fun y ↦ F (y, z) - fiberDyadicIntervalAverage F I z) := by
      funext y
      by_cases hy : y ∈ fiberDyadicInterval I <;>
        simp [scratch_fiberDyadicSelectedBadAtom, hy, hz]
    rw [hatom]
    apply IntegrableOn.integrable_indicator
    · apply hF.integrableOn.sub
      refine integrableOn_const ?_ enorm_ne_top
      rw [measure_fiberDyadicInterval]
      exact ENNReal.ofReal_ne_top
    · exact measurableSet_fiberDyadicInterval I
  · have hzero : (fun y : ℝ ↦ scratch_fiberDyadicSelectedBadAtom F S I (y, z)) = 0 := by
      funext y
      simp [scratch_fiberDyadicSelectedBadAtom, hz]
    rw [hzero]
    exact integrable_zero ℝ ℝ volume

/-- On every selected transverse fiber, the selected dyadic bad atom has
zero integral in the source-fiber coordinate. -/
