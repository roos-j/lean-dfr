  have hmp : MeasurePreserving e ((volume : Measure E3).prod volume)
      ((volume : Measure E3).prod volume) := by
    simpa only [e] using scratch_modelDifferenceCoordinates_measurePreserving
  have hmajorTransport : Integrable (fun q : E3 × E3 ↦
      A ((e.symm q).1) * R ((e.symm q).2))
      ((volume : Measure E3).prod volume) := by
    exact (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hAR
  have hmajor : Integrable (fun q : E3 × E3 ↦ A q.1 * R (q.1 - q.2))
      ((volume : Measure E3).prod volume) := by
    apply hmajorTransport.congr
    filter_upwards [] with q
    have heq : e.symm q = (q.1, q.1 - q.2) := by rfl
    rw [heq]
  have hq₁ (i : Fin 3) : Measurable (fun q : E3 × E3 ↦ q.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp
      measurable_fst
  have hq₂ (i : Fin 3) : Measurable (fun q : E3 × E3 ↦ q.2 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp
      measurable_snd
  have hinput₀ : Measurable (fun q : E3 × E3 ↦ F 0 q.1) :=
    (F 0).continuous.measurable.comp measurable_fst
  have hinput₁ : Measurable (fun q : E3 × E3 ↦
      F 1 (modelPoint (q.2 0) (q.1 1) (q.1 2))) :=
    (F 1).continuous.measurable.comp
      (measurable_modelPoint _ _ _ (hq₂ 0) (hq₁ 1) (hq₁ 2))
  have hinput₂ : Measurable (fun q : E3 × E3 ↦
      F 2 (modelPoint (q.1 0) (q.2 1) (q.1 2))) :=
    (F 2).continuous.measurable.comp
      (measurable_modelPoint _ _ _ (hq₁ 0) (hq₂ 1) (hq₁ 2))
  have hinput₃ : Measurable (fun q : E3 × E3 ↦
      F 3 (modelPoint (q.1 0) (q.1 1) (q.2 2))) :=
    (F 3).continuous.measurable.comp
      (measurable_modelPoint _ _ _ (hq₁ 0) (hq₁ 1) (hq₂ 2))
  have hkernel₀ : Measurable (fun q : E3 × E3 ↦
      kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0) (q.1 0 - q.2 0)) := by
    unfold kernelDilate
    exact (measurable_const.inv.mul
      ((measurable_ModelLowKernel (u 0)).comp
        (((hq₁ 0).sub (hq₂ 0)).div measurable_const)))
  have hkernel₁ : Measurable (fun q : E3 × E3 ↦
      kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1) (q.1 1 - q.2 1)) := by
    unfold kernelDilate
    exact (measurable_const.inv.mul
      ((measurable_ModelLowKernel (u 1)).comp
        (((hq₁ 1).sub (hq₂ 1)).div measurable_const)))
  have hkernel₂ : Measurable (fun q : E3 × E3 ↦
      kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2) (q.1 2 - q.2 2)) := by
    unfold kernelDilate
    exact (measurable_const.inv.mul
      ((measurable_ModelThirdKernel (u 2)).comp
        (((hq₁ 2).sub (hq₂ 2)).div measurable_const)))
  have hmeas : AEStronglyMeasurable
      (scratch_ModelExpandedKernelIntegrand α u F t)
      ((volume : Measure E3).prod volume) := by
    change AEStronglyMeasurable (fun q : E3 × E3 ↦
      (F 0 q.1 * F 1 (modelPoint (q.2 0) (q.1 1) (q.1 2)) *
          F 2 (modelPoint (q.1 0) (q.2 1) (q.1 2)) *
          F 3 (modelPoint (q.1 0) (q.1 1) (q.2 2))) *
        (kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0) (q.1 0 - q.2 0) *
          kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1) (q.1 1 - q.2 1) *
          kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2) (q.1 2 - q.2 2)))
      ((volume : Measure E3).prod volume)
    exact (((hinput₀.aestronglyMeasurable.mul hinput₁.aestronglyMeasurable).mul
      hinput₂.aestronglyMeasurable).mul hinput₃.aestronglyMeasurable).mul
      ((hkernel₀.aestronglyMeasurable.mul hkernel₁.aestronglyMeasurable).mul
        hkernel₂.aestronglyMeasurable)
  apply Integrable.mono' hmajor hmeas
  filter_upwards [] with q
  change ‖scratch_ModelExpandedKernelIntegrand α u F t q‖ ≤ A q.1 * R (q.1 - q.2)
  simp only [scratch_ModelExpandedKernelIntegrand, A, R, B,
    Real.norm_eq_abs, abs_mul]
  calc
    |F 0 q.1| * |F 1 (modelPoint (q.2 0) (q.1 1) (q.1 2))| *
          |F 2 (modelPoint (q.1 0) (q.2 1) (q.1 2))| *
          |F 3 (modelPoint (q.1 0) (q.1 1) (q.2 2))| *
        (|kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0)
            (q.1 0 - q.2 0)| *
          |kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1)
            (q.1 1 - q.2 1)| *
          |kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2)
            (q.1 2 - q.2 2)|) =
        (|F 1 (modelPoint (q.2 0) (q.1 1) (q.1 2))| *
            |F 2 (modelPoint (q.1 0) (q.2 1) (q.1 2))| *
            |F 3 (modelPoint (q.1 0) (q.1 1) (q.2 2))|) * |F 0 q.1| *
          (|kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0)
              (q.1 0 - q.2 0)| *
            |kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1)
              (q.1 1 - q.2 1)| *
            |kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2)
              (q.1 2 - q.2 2)|) := by ring
    _ ≤ (B₁ * B₂ * B₃) * |F 0 q.1| *
          (|kernelDilate (ModelLowKernel (u 0)) (t ^ α.weight 0)
              (q.1 0 - q.2 0)| *
            |kernelDilate (ModelLowKernel (u 1)) (t ^ α.weight 1)
              (q.1 1 - q.2 1)| *
            |kernelDilate (ModelThirdKernel (u 2)) (t ^ α.weight 2)
              (q.1 2 - q.2 2)|) := by
          gcongr
          · exact hF₁ _
          · exact hF₂ _
          · exact hF₃ _
    _ = _ := by simp

/-- For Schwartz inputs the three passive factors have global seminorm
bounds, so the post-center fixed-scale integrand is automatically absolutely
integrable. -/
theorem scratch_integrable_ModelExpandedKernelIntegrand
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (ht : 0 < t) :
    Integrable (scratch_ModelExpandedKernelIntegrand α u F t)
      ((volume : Measure E3).prod volume) := by
  let B₁ : ℝ := SchwartzMap.seminorm ℝ 0 0 (F 1)
  let B₂ : ℝ := SchwartzMap.seminorm ℝ 0 0 (F 2)
  let B₃ : ℝ := SchwartzMap.seminorm ℝ 0 0 (F 3)
  apply scratch_integrable_ModelExpandedKernelIntegrand_of_bounds
    α u F t ht B₁ B₂ B₃
  · exact le_trans (norm_nonneg ((F 1) 0))
      (SchwartzMap.norm_le_seminorm ℝ (F 1) 0)
  · exact le_trans (norm_nonneg ((F 2) 0))
      (SchwartzMap.norm_le_seminorm ℝ (F 2) 0)
  · exact le_trans (norm_nonneg ((F 3) 0))
      (SchwartzMap.norm_le_seminorm ℝ (F 3) 0)
  · intro x
    simpa only [B₁, Real.norm_eq_abs] using
      (SchwartzMap.norm_le_seminorm ℝ (F 1) x)
  · intro x
    simpa only [B₂, Real.norm_eq_abs] using
      (SchwartzMap.norm_le_seminorm ℝ (F 2) x)
  · intro x
    simpa only [B₃, Real.norm_eq_abs] using
      (SchwartzMap.norm_le_seminorm ℝ (F 3) x)

/-- The absolute derivative/third-kernel center pair is integrable in its
center and sampled variable.  This is the third-coordinate analogue of the
two low-frequency/Gaussian pair bounds already available in the source. -/
theorem scratch_integrable_gaussianDerivAt_modelThirdKernel_pair
    (s u x : ℝ) (hs : 0 < s) :
    Integrable (fun z : ℝ × ℝ ↦
      |gaussianDerivAt s z.1 x| * |modelThirdKernel u s z.1 z.2|)
      ((volume : Measure ℝ).prod volume) := by
  let K : ℝ → ℝ := modelThirdKernel u 1 0
  have hK : Integrable K := by
    dsimp only [K]
    simpa using integrable_modelThirdKernel_unit (-u)
  have hKabs : Integrable (fun r : ℝ ↦ |K r|) := by
    simpa only [Real.norm_eq_abs] using hK.norm
  have hderiv : Measurable gaussianDeriv := by
    unfold gaussianDeriv
    exact (measurable_const.mul measurable_id).mul
      gaussian_contDiff.continuous.measurable
  have hderivAt : Measurable (fun z : ℝ × ℝ ↦
      gaussianDerivAt s z.1 x) :=
    measurable_kernelAt gaussianDeriv hderiv _ _ _ measurable_const
      measurable_fst measurable_const
  have hthird : Measurable (fun z : ℝ × ℝ ↦
      modelThirdKernel u s z.1 z.2) := by
    have hraw : Measurable (fun z : ℝ × ℝ ↦
        s⁻¹ * K ((z.2 - z.1) / s)) :=
      measurable_const.mul
        ((stronglyMeasurable_modelThirdKernel u 1 0).measurable.comp
          ((measurable_snd.sub measurable_fst).div measurable_const))
    convert hraw using 1
    funext z
    dsimp only [K]
    rw [modelThirdKernel_eq_scale_dilate]
  have hmeas : AEStronglyMeasurable (fun z : ℝ × ℝ ↦
      |gaussianDerivAt s z.1 x| * |modelThirdKernel u s z.1 z.2|)
      ((volume : Measure ℝ).prod volume) := by
    refine (hderivAt.aestronglyMeasurable.norm.mul
      hthird.aestronglyMeasurable.norm).congr ?_
    filter_upwards [] with z
    rfl
  refine (integrable_prod_iff hmeas).mpr ⟨?_, ?_⟩
  · filter_upwards [] with p
    have hsection : Integrable (fun y : ℝ ↦
        |modelThirdKernel u s p y|) := by
      have hbase : Integrable (fun y : ℝ ↦
          |kernelDilate K s (y - p)|) :=
        (integrable_abs_kernelDilate K hK hs).comp_sub_right p
      apply hbase.congr
      filter_upwards [] with y
      dsimp only [K]
      rw [modelThirdKernel_eq_scale_dilate]
      rfl
    simpa only [mul_comm] using
      hsection.const_mul |gaussianDerivAt s p x|
  · have hderivAbs : Integrable (fun p : ℝ ↦
        |gaussianDerivAt s p x|) := by
      have hbase := integrable_abs_gaussianDerivAt hs x
      apply hbase.congr
      filter_upwards [] with p
      unfold gaussianDerivAt kernelAt kernelDilate
      simp only [smul_eq_mul, abs_mul]
      rw [show (p - x) / s = -((x - p) / s) by ring,
        gaussianDeriv_neg, abs_neg]
    have houter := hderivAbs.const_mul (∫ r : ℝ, |K r|)
    apply houter.congr
    filter_upwards [] with p
    have hmass : (∫ y : ℝ, |modelThirdKernel u s p y|) =
        ∫ r : ℝ, |K r| := by
      calc
        (∫ y : ℝ, |modelThirdKernel u s p y|) =
            ∫ y : ℝ, |kernelDilate K s (y - p)| := by
              apply integral_congr_ae
              filter_upwards [] with y
              dsimp only [K]
              rw [modelThirdKernel_eq_scale_dilate]
              rfl
        _ = ∫ r : ℝ, |kernelDilate K s r| :=
              integral_sub_right_eq_self
                (fun r : ℝ ↦ |kernelDilate K s r|) p
        _ = ∫ r : ℝ, |K r| := integral_abs_kernelDilate K hs
    symm
    calc
      (∫ y : ℝ, ‖|gaussianDerivAt s p x| *
          |modelThirdKernel u s p y|‖) =
          |gaussianDerivAt s p x| *
            ∫ y : ℝ, |modelThirdKernel u s p y| := by
              rw [show (fun y : ℝ ↦ ‖|gaussianDerivAt s p x| *
                  |modelThirdKernel u s p y|‖) =
                    fun y ↦ |gaussianDerivAt s p x| *
                      |modelThirdKernel u s p y| by
                    funext y
                    rw [Real.norm_eq_abs, abs_of_nonneg]
                    exact mul_nonneg (abs_nonneg _) (abs_nonneg _),
                  integral_const_mul]
      _ = (∫ r : ℝ, |K r|) * |gaussianDerivAt s p x| := by
            rw [hmass]
            ring

/-- The absolute mass of the derivative/third-kernel center pair separates
into the two unit-scale kernel masses. -/
theorem scratch_integral_gaussianDerivAt_modelThirdKernel_pair
    (s u x : ℝ) (hs : 0 < s) :
    (∫ z : ℝ × ℝ,
      |gaussianDerivAt s z.1 x| * |modelThirdKernel u s z.1 z.2|) =
      (∫ r : ℝ, |gaussianDeriv r|) *
        ∫ r : ℝ, |modelThirdKernel u 1 0 r| := by
  let P : ℝ × ℝ → ℝ := fun z ↦
    |gaussianDerivAt s z.1 x| * |modelThirdKernel u s z.1 z.2|
  let K : ℝ → ℝ := modelThirdKernel u 1 0
  have hP : Integrable P ((volume : Measure ℝ).prod volume) := by
    simpa only [P] using
      scratch_integrable_gaussianDerivAt_modelThirdKernel_pair s u x hs
  have hmass (p : ℝ) : (∫ y : ℝ, |modelThirdKernel u s p y|) =
      ∫ r : ℝ, |K r| := by
    calc
      (∫ y : ℝ, |modelThirdKernel u s p y|) =
          ∫ y : ℝ, |kernelDilate K s (y - p)| := by
            apply integral_congr_ae
            filter_upwards [] with y
            dsimp only [K]
            rw [modelThirdKernel_eq_scale_dilate]
            rfl
      _ = ∫ r : ℝ, |kernelDilate K s r| :=
            integral_sub_right_eq_self
              (fun r : ℝ ↦ |kernelDilate K s r|) p
      _ = ∫ r : ℝ, |K r| := integral_abs_kernelDilate K hs
  calc
    (∫ z : ℝ × ℝ,
      |gaussianDerivAt s z.1 x| * |modelThirdKernel u s z.1 z.2|) =
        ∫ p : ℝ, ∫ y : ℝ, P (p, y) := integral_prod P hP
    _ = ∫ p : ℝ, |gaussianDerivAt s p x| * ∫ r : ℝ, |K r| := by
          apply integral_congr_ae
          filter_upwards [] with p
          dsimp only [P]
          rw [integral_const_mul, hmass]
    _ = (∫ p : ℝ, |gaussianDerivAt s p x|) * ∫ r : ℝ, |K r| := by
          rw [integral_mul_const]
    _ = (∫ r : ℝ, |gaussianDeriv r|) *
        ∫ r : ℝ, |modelThirdKernel u 1 0 r| := by
          have hderivMass : (∫ p : ℝ, |gaussianDerivAt s p x|) =
              ∫ r : ℝ, |gaussianDeriv r| := by
            calc
              (∫ p : ℝ, |gaussianDerivAt s p x|) =
                  ∫ p : ℝ, |gaussianDerivAt s x p| := by
                    apply integral_congr_ae
                    filter_upwards [] with p
                    unfold gaussianDerivAt kernelAt kernelDilate
                    simp only [smul_eq_mul, abs_mul]
                    rw [show (p - x) / s = -((x - p) / s) by ring,
                      gaussianDeriv_neg, abs_neg]
              _ = ∫ r : ℝ, |gaussianDeriv r| :=
                    integral_abs_gaussianDerivAt hs x
          rw [hderivMass]

/-- At one positive scale, Fubini and the three center identities turn the
literal center-expanded integrand into the negative physical-kernel
integrand. -/
theorem scratch_integral_ModelCenterExpanded_eq_neg_kernel_of_integrable
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (ht : 0 < t)
    (hjoint : Integrable (scratch_ModelCenterExpandedIntegrand α u F t)
      (((volume : Measure E3).prod volume).prod volume)) :
    (∫ q : (E3 × E3) × E3,
      scratch_ModelCenterExpandedIntegrand α u F t q
      ∂(((volume : Measure E3).prod volume).prod volume)) =
      -(∫ q : E3 × E3,
        scratch_ModelExpandedKernelIntegrand α u F t q
        ∂((volume : Measure E3).prod volume)) := by
  let W : E3 × E3 → ℝ := fun q ↦
    F 0 q.1 * F 1 (modelPoint (q.2 0) (q.1 1) (q.1 2)) *
      F 2 (modelPoint (q.1 0) (q.2 1) (q.1 2)) *
      F 3 (modelPoint (q.1 0) (q.1 1) (q.2 2))
  have hs₀ : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs₁ : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs₂ : 0 < t ^ α.weight 2 := pow_pos ht _
  let C : (E3 × E3) × E3 → ℝ := fun q ↦
    (modelPhiAt (t ^ α.weight 0)
        (q.2 0 + t ^ α.weight 0 * u 0) (q.1.1 0) *
      gaussianAt (t ^ α.weight 0) (q.2 0) (q.1.2 0)) *
      (modelPhiAt (t ^ α.weight 1)
        (q.2 1 + t ^ α.weight 1 * u 1) (q.1.1 1) *
      gaussianAt (t ^ α.weight 1) (q.2 1) (q.1.2 1)) *
      (gaussianDerivAt (t ^ α.weight 2) (q.2 2) (q.1.1 2) *
        modelThirdKernel (u 2) (t ^ α.weight 2) (q.2 2) (q.1.2 2))
  have hcenter : Integrable (fun q : (E3 × E3) × E3 ↦ W q.1 * C q)
      (((volume : Measure E3).prod volume).prod volume) := by
    apply hjoint.congr
    filter_upwards [] with q
    simp only [scratch_ModelCenterExpandedIntegrand, W, C]
  have hmain := integral_centerTriple_weighted_of_integrable
    ((volume : Measure E3).prod volume)
    (t ^ α.weight 0) (t ^ α.weight 1) (t ^ α.weight 2)
    (u 0) (u 1) (u 2)
    W
    (fun q : E3 × E3 ↦ q.1 0)
    (fun q : E3 × E3 ↦ q.1 1)
    (fun q : E3 × E3 ↦ q.1 2)
    (fun q : E3 × E3 ↦ q.2 0)
    (fun q : E3 × E3 ↦ q.2 1)
    (fun q : E3 × E3 ↦ q.2 2)
    hs₀ hs₁ hs₂
    hcenter
  convert hmain using 1 <;>
    simp only [scratch_ModelCenterExpandedIntegrand,
      scratch_ModelExpandedKernelIntegrand, W]

/-- Opening the three coordinate convolutions recovers the spatial profile
from the post-center kernel integral.  The displayed product-integrability
hypothesis is precisely the Fubini premise required here. -/
theorem scratch_integral_ModelExpandedKernel_eq_ModelSpatialProfile_of_integrable
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (hkernel : Integrable (scratch_ModelExpandedKernelIntegrand α u F t)
      ((volume : Measure E3).prod volume)) :
    (∫ q : E3 × E3,
      scratch_ModelExpandedKernelIntegrand α u F t q
      ∂((volume : Measure E3).prod volume)) =
      ModelSpatialProfile α u F t := by
  calc
    (∫ q : E3 × E3,
      scratch_ModelExpandedKernelIntegrand α u F t q
      ∂((volume : Measure E3).prod volume)) =
        ∫ x : E3, ∫ y : E3,
          scratch_ModelExpandedKernelIntegrand α u F t (x, y) :=
      MeasureTheory.integral_prod _ hkernel
    _ = ∫ x : E3,
        F 0 x *
          (∫ y : E3,
            (F 1 (modelPoint (y 0) (x 1) (x 2)) *
                kernelDilate (ModelLowKernel (u 0))
                  (t ^ α.weight 0) (x 0 - y 0)) *
              (F 2 (modelPoint (x 0) (y 1) (x 2)) *
                kernelDilate (ModelLowKernel (u 1))
                  (t ^ α.weight 1) (x 1 - y 1)) *
              (F 3 (modelPoint (x 0) (x 1) (y 2)) *
                kernelDilate (ModelThirdKernel (u 2))
                  (t ^ α.weight 2) (x 2 - y 2))) := by
          apply integral_congr_ae
          filter_upwards [] with x
          rw [← integral_const_mul]
          apply integral_congr_ae
          filter_upwards [] with y
          simp only [scratch_ModelExpandedKernelIntegrand]
          ring
    _ = ModelSpatialProfile α u F t :=
      (scratch_ModelSpatialProfile_eq_expandedKernelIntegral α u F t).symm

/-- The fixed-scale localization identity: after imposing exactly the two
absolute-integrability conditions that justify the relevant Fubini steps,
the signed center-expanded form is the negative spatial model profile. -/
theorem scratch_integral_ModelCenterExpanded_eq_neg_ModelSpatialProfile_of_integrable
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (ht : 0 < t)
    (hjoint : Integrable (scratch_ModelCenterExpandedIntegrand α u F t)
      (((volume : Measure E3).prod volume).prod volume))
    (hkernel : Integrable (scratch_ModelExpandedKernelIntegrand α u F t)
      ((volume : Measure E3).prod volume)) :
    (∫ q : (E3 × E3) × E3,
      scratch_ModelCenterExpandedIntegrand α u F t q
      ∂(((volume : Measure E3).prod volume).prod volume)) =
      -ModelSpatialProfile α u F t := by
  rw [scratch_integral_ModelCenterExpanded_eq_neg_kernel_of_integrable
    α u F t ht hjoint,
    scratch_integral_ModelExpandedKernel_eq_ModelSpatialProfile_of_integrable
      α u F t hkernel]

/-- With the outer sign in the local-form convention, the fixed-scale center
expansion is exactly the spatial model profile. -/
theorem scratch_neg_integral_ModelCenterExpanded_eq_ModelSpatialProfile_of_integrable
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (ht : 0 < t)
    (hjoint : Integrable (scratch_ModelCenterExpandedIntegrand α u F t)
      (((volume : Measure E3).prod volume).prod volume))
    (hkernel : Integrable (scratch_ModelExpandedKernelIntegrand α u F t)
      ((volume : Measure E3).prod volume)) :
    -(∫ q : (E3 × E3) × E3,
      scratch_ModelCenterExpandedIntegrand α u F t q
      ∂(((volume : Measure E3).prod volume).prod volume)) =
      ModelSpatialProfile α u F t := by
  rw [scratch_integral_ModelCenterExpanded_eq_neg_ModelSpatialProfile_of_integrable
    α u F t ht hjoint hkernel]
  ring

/-- At every positive scale, the literal center expansion of a real Schwartz
model tuple is automatically absolutely integrable, and its source sign
recovers the fixed-scale spatial model profile exactly. -/
theorem scratch_fixed_neg_integral_ModelCenterExpanded_eq_ModelSpatialProfile
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) (t : ℝ)
    (ht : 0 < t) :
    -(∫ q : (E3 × E3) × E3,
      fixed_ModelCenterExpandedIntegrand α u F t q
      ∂(((volume : Measure E3).prod volume).prod volume)) =
      ModelSpatialProfile α u F t := by
  have hjoint : Integrable (scratch_ModelCenterExpandedIntegrand α u F t)
      (((volume : Measure E3).prod volume).prod volume) := by
    change Integrable (fixed_ModelCenterExpandedIntegrand α u F t)
      (((volume : Measure E3).prod volume).prod volume)
    exact fixed_integrable_ModelCenterExpandedIntegrand α u F t ht
  have hkernel : Integrable (scratch_ModelExpandedKernelIntegrand α u F t)
      ((volume : Measure E3).prod volume) :=
    scratch_integrable_ModelExpandedKernelIntegrand α u F t ht
  change -(∫ q : (E3 × E3) × E3,
      scratch_ModelCenterExpandedIntegrand α u F t q
      ∂(((volume : Measure E3).prod volume).prod volume)) =
      ModelSpatialProfile α u F t
  exact scratch_neg_integral_ModelCenterExpanded_eq_ModelSpatialProfile_of_integrable
    α u F t ht hjoint hkernel

