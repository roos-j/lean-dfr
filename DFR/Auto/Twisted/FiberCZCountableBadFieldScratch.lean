/-! ## Countable selected fiber fields

The literal dyadic stopping family is countable.  Global disjointness of its
selected rectangles makes the pointwise `tsum` locally a single atom, which
is the exact finite-to-countable stabilization interface needed before an
operator convergence/Fubini argument.
-/

/-- The countable selected bad field associated to the literal source
selection. -/
noncomputable def scratch_fiberDyadicCountableBadField
    {Z : Type*} [MeasurableSpace Z] (F : ℝ × Z → ℝ) (Zf : Set Z)
    (A : FiberDyadicInterval → Z → ℝ) (H : ℝ) : ℝ × Z → ℝ :=
  fun yz ↦ ∑' I : FiberDyadicInterval,
    scratch_fiberCZBadAtom F (fiberDyadicSelectionSet Zf A H) I yz

/-- The countable good field is the input after subtracting the countable
selected bad field. -/
noncomputable def scratch_fiberDyadicCountableGoodField
    {Z : Type*} [MeasurableSpace Z] (F : ℝ × Z → ℝ) (Zf : Set Z)
    (A : FiberDyadicInterval → Z → ℝ) (H : ℝ) : ℝ × Z → ℝ :=
  F - scratch_fiberDyadicCountableBadField F Zf A H

/-- The countable selected bad field is measurable. -/
theorem scratch_measurable_fiberDyadicCountableBadField
    {Z : Type*} [MeasurableSpace Z] (F : ℝ × Z → ℝ) (Zf : Set Z)
    (A : FiberDyadicInterval → Z → ℝ) (H : ℝ)
    (hF : Measurable F) (hZf : MeasurableSet Zf)
    (hA : ∀ I, Measurable (A I)) :
    Measurable (scratch_fiberDyadicCountableBadField F Zf A H) := by
  unfold scratch_fiberDyadicCountableBadField
  apply Measurable.tsum
  intro I
  apply scratch_measurable_fiberCZBadAtom F
    (fiberDyadicSelectionSet Zf A H) I hF
  intro J
  exact measurableSet_fiberDyadicSelectionSet Zf hZf A hA H J

/-- The countable selected good field is measurable. -/
theorem scratch_measurable_fiberDyadicCountableGoodField
    {Z : Type*} [MeasurableSpace Z] (F : ℝ × Z → ℝ) (Zf : Set Z)
    (A : FiberDyadicInterval → Z → ℝ) (H : ℝ)
    (hF : Measurable F) (hZf : MeasurableSet Zf)
    (hA : ∀ I, Measurable (A I)) :
    Measurable (scratch_fiberDyadicCountableGoodField F Zf A H) := by
  unfold scratch_fiberDyadicCountableGoodField
  exact hF.sub (scratch_measurable_fiberDyadicCountableBadField
    F Zf A H hF hZf hA)

/-- At a point in one selected rectangle, the countable bad `tsum` reduces
to exactly that rectangle's atom. -/
theorem scratch_fiberDyadicCountableBadField_eq_atom_of_mem
    {Z : Type*} [MeasurableSpace Z] (F : ℝ × Z → ℝ) (Zf : Set Z)
    (A : FiberDyadicInterval → Z → ℝ) (H : ℝ)
    (I : FiberDyadicInterval) (yz : ℝ × Z)
    (hyz : yz ∈ fiberDyadicInterval I ×ˢ
      fiberDyadicSelectionSet Zf A H I) :
    scratch_fiberDyadicCountableBadField F Zf A H yz =
      scratch_fiberCZBadAtom F (fiberDyadicSelectionSet Zf A H) I yz := by
  unfold scratch_fiberDyadicCountableBadField
  apply tsum_eq_single I
  intro J hJI
  have hIJ : I ≠ J := Ne.symm hJI
  have hdisj : Disjoint
      (fiberDyadicInterval I ×ˢ fiberDyadicSelectionSet Zf A H I)
      (fiberDyadicInterval J ×ˢ fiberDyadicSelectionSet Zf A H J) :=
    pairwiseDisjoint_fiberDyadicSelectedRectangles Zf A H
      (Set.mem_univ I) (Set.mem_univ J) hIJ
  have hnot : yz ∉ fiberDyadicInterval J ×ˢ
      fiberDyadicSelectionSet Zf A H J := by
    intro hJ
    exact (Set.disjoint_left.mp hdisj) hyz hJ
  unfold scratch_fiberCZBadAtom
  exact Set.indicator_of_notMem hnot _

/-- Away from the countable source exceptional set, every selected atom and
therefore the countable bad field vanishes. -/
theorem scratch_fiberDyadicCountableBadField_eq_zero_outside_exceptional
    {Z : Type*} [MeasurableSpace Z] (F : ℝ × Z → ℝ) (Zf : Set Z)
    (A : FiberDyadicInterval → Z → ℝ) (H : ℝ) (yz : ℝ × Z)
    (hyz : yz ∉ fiberDyadicExceptionalSet Zf A H) :
    scratch_fiberDyadicCountableBadField F Zf A H yz = 0 := by
  unfold scratch_fiberDyadicCountableBadField
  have hzero : (fun I : FiberDyadicInterval ↦
      scratch_fiberCZBadAtom F (fiberDyadicSelectionSet Zf A H) I yz) =
      fun _ ↦ 0 := by
    funext I
    have hnot : yz ∉ fiberDyadicInterval I ×ˢ
        fiberDyadicSelectionSet Zf A H I := by
      intro hmem
      apply hyz
      exact Set.mem_iUnion.2 ⟨I, hmem⟩
    unfold scratch_fiberCZBadAtom
    exact Set.indicator_of_notMem hnot _
  rw [hzero]
  exact tsum_zero

/-- The countable good--bad fields reconstruct the original input. -/
theorem scratch_fiberDyadicCountableGoodBad_decomposition
    {Z : Type*} [MeasurableSpace Z] (F : ℝ × Z → ℝ) (Zf : Set Z)
    (A : FiberDyadicInterval → Z → ℝ) (H : ℝ) :
    scratch_fiberDyadicCountableGoodField F Zf A H +
      scratch_fiberDyadicCountableBadField F Zf A H = F := by
  funext yz
  change (F yz - scratch_fiberDyadicCountableBadField F Zf A H yz) +
    scratch_fiberDyadicCountableBadField F Zf A H yz = F yz
  ring

/-- Outside the countable exceptional set, the countable good field is
literally unchanged. -/
theorem scratch_fiberDyadicCountableGoodField_eq_self_outside_exceptional
    {Z : Type*} [MeasurableSpace Z] (F : ℝ × Z → ℝ) (Zf : Set Z)
    (A : FiberDyadicInterval → Z → ℝ) (H : ℝ) (yz : ℝ × Z)
    (hyz : yz ∉ fiberDyadicExceptionalSet Zf A H) :
    scratch_fiberDyadicCountableGoodField F Zf A H yz = F yz := by
  unfold scratch_fiberDyadicCountableGoodField
  simp only [Pi.sub_apply]
  rw [scratch_fiberDyadicCountableBadField_eq_zero_outside_exceptional
    F Zf A H yz hyz]
  ring

/-- Global disjointness of the selected rectangles removes the cardinality
loss in the elementary bad-field bound: pointwise, at most one bad atom is
present. -/
theorem scratch_abs_fiberDyadicCountableBadField_le_of_bound
    {Z : Type*} [MeasurableSpace Z] (F : ℝ × Z → ℝ) (Zf : Set Z)
    (A : FiberDyadicInterval → Z → ℝ) (H B : ℝ)
    (hB : 0 ≤ B) (hbound : ∀ yz, |F yz| ≤ B) (yz : ℝ × Z) :
    |scratch_fiberDyadicCountableBadField F Zf A H yz| ≤ 2 * B := by
  by_cases hyz : yz ∈ fiberDyadicExceptionalSet Zf A H
  · rcases Set.mem_iUnion.mp hyz with ⟨I, hI⟩
    rw [scratch_fiberDyadicCountableBadField_eq_atom_of_mem F Zf A H I yz hI]
    exact scratch_abs_fiberCZBadAtom_le_of_bound F
      (fiberDyadicSelectionSet Zf A H) I B hB hbound yz
  · rw [scratch_fiberDyadicCountableBadField_eq_zero_outside_exceptional
      F Zf A H yz hyz]
    simp only [abs_zero]
    positivity

/-- Consequently the countable good field stays uniformly bounded by
`3 B`, independently of the number of selected intervals. -/
theorem scratch_abs_fiberDyadicCountableGoodField_le_of_bound
    {Z : Type*} [MeasurableSpace Z] (F : ℝ × Z → ℝ) (Zf : Set Z)
    (A : FiberDyadicInterval → Z → ℝ) (H B : ℝ)
    (hB : 0 ≤ B) (hbound : ∀ yz, |F yz| ≤ B) (yz : ℝ × Z) :
    |scratch_fiberDyadicCountableGoodField F Zf A H yz| ≤ 3 * B := by
  unfold scratch_fiberDyadicCountableGoodField
  simp only [Pi.sub_apply]
  calc
    |F yz - scratch_fiberDyadicCountableBadField F Zf A H yz| ≤
        |F yz| + |scratch_fiberDyadicCountableBadField F Zf A H yz| :=
      abs_sub _ _
    _ ≤ B + 2 * B := add_le_add (hbound yz)
      (scratch_abs_fiberDyadicCountableBadField_le_of_bound
        F Zf A H B hB hbound yz)
    _ = 3 * B := by ring

/-- Pull the countable literal bad field back to an ambient coordinate. -/
noncomputable def scratch_coordinateFiberDyadicCountableBadField
    (i : Fin 3) (f : E3 → ℝ) (Zf : Set (TransverseSpace i))
    (A : FiberDyadicInterval → TransverseSpace i → ℝ) (H : ℝ) : E3 → ℝ :=
  fun x ↦ scratch_fiberDyadicCountableBadField
    (scratch_coordinateFiberInput i f) Zf A H (coordinateSplit i x)

/-- Pull the countable literal good field back to an ambient coordinate. -/
