/-- The ambient countable good and bad fields reconstruct the original
input pointwise. -/
theorem scratch_coordinateFiberDyadicCountableGoodBad_decomposition
    (i : Fin 3) (f : E3 → ℝ) (Zf : Set (TransverseSpace i))
    (A : FiberDyadicInterval → TransverseSpace i → ℝ) (H : ℝ) :
    scratch_coordinateFiberDyadicCountableGoodField i f Zf A H +
      scratch_coordinateFiberDyadicCountableBadField i f Zf A H = f := by
  funext x
  have h := congrFun (scratch_fiberDyadicCountableGoodBad_decomposition
    (scratch_coordinateFiberInput i f) Zf A H) (coordinateSplit i x)
  change scratch_coordinateFiberDyadicCountableGoodField i f Zf A H x +
      scratch_coordinateFiberDyadicCountableBadField i f Zf A H x = f x
  simpa only [Pi.add_apply, scratch_coordinateFiberDyadicCountableGoodField,
    scratch_coordinateFiberDyadicCountableBadField, scratch_coordinateFiberInput,
    coordinateJoin_split] using h

/-- The actual tuple is unchanged when its selected coordinate is replaced
