/-- Integrating the low-frequency center pair produces the physical
low-frequency kernel at the difference coordinate. -/
theorem scratch_integral_modelPhiAt_mul_gaussianAt_center
    (s u x y : ℝ) (hs : 0 < s) :
    (∫ p : ℝ,
      modelPhiAt s (p + s * u) x * gaussianAt s p y) =
      kernelDilate (ModelLowKernel u) s (x - y) := by
  let w : ℝ := (x - y) / s
  let G : ℝ → ℝ := fun z ↦
    gaussian z * conePhiPhysicalReal (w - z - u)
  have hpoint (p : ℝ) :
      modelPhiAt s (p + s * u) x * gaussianAt s p y =
        s⁻¹ * s⁻¹ * G ((p - y) / s) := by
    dsimp only [G, w]
    unfold modelPhiAt gaussianAt kernelAt kernelDilate
    simp only [smul_eq_mul]
    rw [show (x - (p + s * u)) / s =
        (x - y) / s - (p - y) / s - u by field_simp; ring,
      show (y - p) / s = -((p - y) / s) by ring,
      gaussian_even]
    ring
  calc
    (∫ p : ℝ, modelPhiAt s (p + s * u) x * gaussianAt s p y) =
        ∫ p : ℝ, s⁻¹ * s⁻¹ * G ((p - y) / s) := by
          apply integral_congr_ae
          filter_upwards [] with p
          exact hpoint p
    _ = s⁻¹ * s⁻¹ * ∫ p : ℝ, G ((p - y) / s) := by
          rw [integral_const_mul]
    _ = s⁻¹ * s⁻¹ * (s * ∫ z : ℝ, G z) := by
          rw [integral_sub_right_eq_self (μ := volume)
            (fun p : ℝ ↦ G (p / s)) y,
            Measure.integral_comp_div]
          simp only [smul_eq_mul, abs_of_pos hs]
    _ = kernelDilate (ModelLowKernel u) s (x - y) := by
          dsimp only [G, w]
          unfold ModelLowKernel kernelDilate
          simp only [smul_eq_mul]
          field_simp

/-- Reflecting the center in the third model kernel switches the translation
parameter and contributes the odd Gaussian-derivative sign. -/
theorem scratch_modelThirdKernel_reflect
    (u r : ℝ) :
    modelThirdKernel u 1 0 (-r) =
      -modelThirdKernel (-u) 1 0 r := by
  let H : ℝ → ℝ := fun z ↦
    gaussianDeriv z * conePsiPhysicalReal (r - z - u)
  have hneg : MeasurePreserving (fun z : ℝ ↦ -z) volume volume :=
    Measure.measurePreserving_neg (volume : Measure ℝ)
  have hchange : (∫ z : ℝ, H (-z)) = ∫ z : ℝ, H z :=
    hneg.integral_comp (Homeomorph.neg ℝ).measurableEmbedding H
  unfold modelThirdKernel kernelAt kernelDilate
  simp only [inv_one, one_smul, sub_zero, div_one]
  calc
    (∫ z : ℝ, gaussianDeriv z * conePsiPhysicalReal ((-r) - z + u)) =
        -(∫ z : ℝ, H (-z)) := by
          rw [← integral_neg]
          apply integral_congr_ae
          filter_upwards [] with z
          dsimp only [H]
          rw [gaussianDeriv_neg,
            show -r - z + u = -(r + z - u) by ring,
            conePsiPhysicalReal_even]
          ring_nf
    _ = -(∫ z : ℝ, H z) := by rw [hchange]
    _ = -∫ z : ℝ,
        gaussianDeriv z * conePsiPhysicalReal (r - z + (-u)) := by
          dsimp only [H]
          congr 2

