/-- Transporting the scalar three-center calculation through the literal
Euclidean-coordinate equivalence gives the center integral occurring in the
three-dimensional model form. -/
theorem scratch_integral_E3_centerTriple_kernel_product
    (s₀ s₁ s₂ u₀ u₁ u₂ x₀ x₁ x₂ y₀ y₁ y₂ : ℝ)
    (hs₀ : 0 < s₀) (hs₁ : 0 < s₁) (hs₂ : 0 < s₂) :
    (∫ p : E3,
      (modelPhiAt s₀ (p 0 + s₀ * u₀) x₀ * gaussianAt s₀ (p 0) y₀) *
        (modelPhiAt s₁ (p 1 + s₁ * u₁) x₁ * gaussianAt s₁ (p 1) y₁) *
        (gaussianDerivAt s₂ (p 2) x₂ *
          modelThirdKernel u₂ s₂ (p 2) y₂)) =
      -(kernelDilate (ModelLowKernel u₀) s₀ (x₀ - y₀) *
        kernelDilate (ModelLowKernel u₁) s₁ (x₁ - y₁) *
        kernelDilate (ModelThirdKernel u₂) s₂ (x₂ - y₂)) := by
  let G : E3 → ℝ := fun p ↦
    (modelPhiAt s₀ (p 0 + s₀ * u₀) x₀ * gaussianAt s₀ (p 0) y₀) *
      (modelPhiAt s₁ (p 1 + s₁ * u₁) x₁ * gaussianAt s₁ (p 1) y₁) *
      (gaussianDerivAt s₂ (p 2) x₂ * modelThirdKernel u₂ s₂ (p 2) y₂)
  let e : E3 ≃ᵐ ℝ × (ℝ × ℝ) := e3Coordinates
  have hmp : MeasurePreserving e (volume : Measure E3)
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume)) := by
    simpa only [e] using e3Coordinates_measurePreserving
  have htransport : (∫ z : ℝ × (ℝ × ℝ), G (e.symm z)) =
      ∫ p : E3, G p := by
    exact (MeasurePreserving.symm e hmp).integral_comp
      e.symm.measurableEmbedding G
  change (∫ p : E3, G p) = _
  rw [← htransport]
  calc
    (∫ z : ℝ × (ℝ × ℝ), G (e.symm z)) =
        ∫ z : ℝ × (ℝ × ℝ),
          (modelPhiAt s₀ (z.1 + s₀ * u₀) x₀ * gaussianAt s₀ z.1 y₀) *
            (modelPhiAt s₁ (z.2.1 + s₁ * u₁) x₁ * gaussianAt s₁ z.2.1 y₁) *
            (gaussianDerivAt s₂ z.2.2 x₂ * modelThirdKernel u₂ s₂ z.2.2 y₂) := by
          apply integral_congr_ae
          filter_upwards [] with z
          have heq := e.apply_symm_apply z
          have h0 : (e.symm z) 0 = z.1 := by
            simpa only [e, e3Coordinates_apply] using congrArg Prod.fst heq
          have h1 : (e.symm z) 1 = z.2.1 := by
            simpa only [e, e3Coordinates_apply] using
              congrArg (fun q : ℝ × (ℝ × ℝ) ↦ q.2.1) heq
          have h2 : (e.symm z) 2 = z.2.2 := by
            simpa only [e, e3Coordinates_apply] using
              congrArg (fun q : ℝ × (ℝ × ℝ) ↦ q.2.2) heq
          dsimp only [G]
          rw [h0, h1, h2]
    _ = -(kernelDilate (ModelLowKernel u₀) s₀ (x₀ - y₀) *
        kernelDilate (ModelLowKernel u₁) s₁ (x₁ - y₁) *
        kernelDilate (ModelThirdKernel u₂) s₂ (x₂ - y₂)) :=
      scratch_integral_centerTriple_kernel_product_right
        s₀ s₁ s₂ u₀ u₁ u₂ x₀ x₁ x₂ y₀ y₁ y₂ hs₀ hs₁ hs₂

/-- Fubini lifts the center calculation through any absolutely integrable
outer parameter.  This is the exact form used when the remaining six
spatial variables carry the four model inputs. -/
theorem scratch_integral_centerTriple_weighted_of_integrable
    {X : Type*} [MeasurableSpace X] (μ : Measure X) [SFinite μ]
    (s₀ s₁ s₂ u₀ u₁ u₂ : ℝ)
    (W x₀ x₁ x₂ y₀ y₁ y₂ : X → ℝ)
    (hs₀ : 0 < s₀) (hs₁ : 0 < s₁) (hs₂ : 0 < s₂)
    (hjoint : Integrable (fun q : X × E3 ↦
      W q.1 *
        ((modelPhiAt s₀ (q.2 0 + s₀ * u₀) (x₀ q.1) *
            gaussianAt s₀ (q.2 0) (y₀ q.1)) *
          (modelPhiAt s₁ (q.2 1 + s₁ * u₁) (x₁ q.1) *
            gaussianAt s₁ (q.2 1) (y₁ q.1)) *
          (gaussianDerivAt s₂ (q.2 2) (x₂ q.1) *
            modelThirdKernel u₂ s₂ (q.2 2) (y₂ q.1))))
      (μ.prod volume)) :
    (∫ q : X × E3,
      W q.1 *
        ((modelPhiAt s₀ (q.2 0 + s₀ * u₀) (x₀ q.1) *
            gaussianAt s₀ (q.2 0) (y₀ q.1)) *
          (modelPhiAt s₁ (q.2 1 + s₁ * u₁) (x₁ q.1) *
            gaussianAt s₁ (q.2 1) (y₁ q.1)) *
          (gaussianDerivAt s₂ (q.2 2) (x₂ q.1) *
            modelThirdKernel u₂ s₂ (q.2 2) (y₂ q.1)))
      ∂(μ.prod volume)) =
      -(∫ z : X,
        W z *
          (kernelDilate (ModelLowKernel u₀) s₀ (x₀ z - y₀ z) *
            kernelDilate (ModelLowKernel u₁) s₁ (x₁ z - y₁ z) *
            kernelDilate (ModelThirdKernel u₂) s₂ (x₂ z - y₂ z)) ∂μ) := by
  let C : X → E3 → ℝ := fun z p ↦
    (modelPhiAt s₀ (p 0 + s₀ * u₀) (x₀ z) *
        gaussianAt s₀ (p 0) (y₀ z)) *
      (modelPhiAt s₁ (p 1 + s₁ * u₁) (x₁ z) *
        gaussianAt s₁ (p 1) (y₁ z)) *
      (gaussianDerivAt s₂ (p 2) (x₂ z) *
        modelThirdKernel u₂ s₂ (p 2) (y₂ z))
  let K : X → ℝ := fun z ↦
    kernelDilate (ModelLowKernel u₀) s₀ (x₀ z - y₀ z) *
      kernelDilate (ModelLowKernel u₁) s₁ (x₁ z - y₁ z) *
      kernelDilate (ModelThirdKernel u₂) s₂ (x₂ z - y₂ z)
  change (∫ q : X × E3, W q.1 * C q.1 q.2 ∂(μ.prod volume)) =
    -(∫ z : X, W z * K z ∂μ)
  calc
    (∫ q : X × E3, W q.1 * C q.1 q.2 ∂(μ.prod volume)) =
        ∫ z : X, (∫ p : E3, W z * C z p ∂volume) ∂μ :=
      MeasureTheory.integral_prod _ hjoint
    _ = ∫ z : X, W z * (∫ p : E3, C z p ∂volume) ∂μ := by
      apply integral_congr_ae
      filter_upwards [] with z
      rw [← integral_const_mul]
    _ = ∫ z : X, W z * (-K z) ∂μ := by
      apply integral_congr_ae
      filter_upwards [] with z
      rw [scratch_integral_E3_centerTriple_kernel_product
        s₀ s₁ s₂ u₀ u₁ u₂ (x₀ z) (x₁ z) (x₂ z)
          (y₀ z) (y₁ z) (y₂ z) hs₀ hs₁ hs₂]
    _ = -(∫ z : X, W z * K z ∂μ) := by
      rw [← integral_neg]
      apply integral_congr_ae
      filter_upwards [] with z
      ring

/-- Mass-normalized dilation preserves integrability at every nonzero scale.
Together with the canonical `ModelLowKernel` and `ModelThirdKernel` facts,
this supplies the fixed-scale absolute-kernel input for localization. -/
theorem scratch_integrable_kernelDilate
    {v : ℝ → ℝ} (hv : Integrable v) {s : ℝ} (hs : s ≠ 0) :
    Integrable (fun x : ℝ ↦ kernelDilate v s x) := by
  unfold kernelDilate
  simp only [smul_eq_mul]
  exact (hv.comp_div hs).const_mul s⁻¹

/-- Both physical low-frequency factors are integrable at every positive
model scale. -/
theorem scratch_integrable_ModelLowKernel_dilate
    (u s : ℝ) (hs : 0 < s) :
    Integrable (fun x : ℝ ↦ kernelDilate (ModelLowKernel u) s x) := by
  exact scratch_integrable_kernelDilate (integrable_ModelLowKernel u) hs.ne'

/-- The signed third physical factor is integrable at every positive model
scale. -/
theorem scratch_integrable_ModelThirdKernel_dilate
    (u s : ℝ) (hs : 0 < s) :
    Integrable (fun x : ℝ ↦ kernelDilate (ModelThirdKernel u) s x) := by
  exact scratch_integrable_kernelDilate (integrable_ModelThirdKernel u) hs.ne'

