    (MeasurePreserving.id (volume : Measure ℝ)).prod
      (swapMiddle_measurePreserving ℝ ℝ (ℝ × ℝ)
        volume volume ((volume : Measure ℝ).prod volume))
  let h₃ : MeasurePreserving
      (MeasurableEquiv.prodAssoc.symm :
        ℝ × (ℝ × (ℝ × (ℝ × ℝ))) ≃ᵐ
          (ℝ × ℝ) × (ℝ × (ℝ × ℝ)))
      ((volume : Measure ℝ).prod
        ((volume : Measure ℝ).prod
          ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))))
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))) :=
    (measurePreserving_prodAssoc volume volume
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod volume))).symm
  let h₄ : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl (ℝ × ℝ))
