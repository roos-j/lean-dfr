      cubeSecondMoment α t x (F 3) ≤
        ‖scratch_sourceStoppingPowerMajorant K F 3 x‖)
    (hfour : ∀ (j : Fin 4), j ≠ 3 → ∀ (t : ℝ), 0 < t → ∀ x : E3,
      fourthMoment α t x (F j) ≤
        ‖scratch_sourceStoppingPowerMajorant K F j x‖) :
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
      (fun _ ↦ 0)
      (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
      ∑ j : Fin 4, 8 *
        (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
          (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
            ∫ x : E3,
              scratch_sourceStoppingRootMajorant K F j x ^ q j) := by
  exact scratch_sourceStoppingCoordinateEnvelope_le_of_zero_shift_majorants
    α S (InitialModelRealInput F) q hq hsum
    (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero)
    (initialModelRealInput_continuous F) (initialModelRealInput_bounded F)
    (scratch_sourceStoppingRootMajorant K F)
    (fun j x ↦ scratch_sourceStoppingMaximal_le_rootMajorant_of_fixedScale
      α K F htwo hfour j x)
    (fun j x ↦ scratch_sourceStoppingRootMajorant_nonneg K F j x)
    (fun j ↦ scratch_sourceStoppingRootMajorant_power_measurable K F j
      (q j) (hq j))
    (fun j ↦ scratch_sourceStoppingRootMajorant_power_integrable K hK F j
      (q j) (hqs j))

/-- Equivalent product-norm-ready form of the initial stopping distribution:
the displayed integral is the `q_j / s_j` power integral of the unrooted
three-coordinate dyadic majorant. -/
theorem scratch_initialSourceStoppingCoordinateEnvelope_le_powerDyadic_unrooted
    (α : Anisotropy) (S : BoxCollection α) (F : InitialModelSchwartzInput)
    (q K : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j)
    (hK : ∀ j, 0 ≤ K j)
    (hFnonzero : ∀ j, F j ≠ 0)
    (htwo : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      cubeSecondMoment α t x (F 3) ≤
        ‖scratch_sourceStoppingPowerMajorant K F 3 x‖)
    (hfour : ∀ (j : Fin 4), j ≠ 3 → ∀ (t : ℝ), 0 < t → ∀ x : E3,
      fourthMoment α t x (F j) ≤
        ‖scratch_sourceStoppingPowerMajorant K F j x‖) :
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
      (fun _ ↦ 0)
      (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
      ∑ j : Fin 4, 8 *
        (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
          (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
            ∫ x : E3, ‖scratch_sourceStoppingPowerMajorant K F j x‖ ^
              (q j / sourceStoppingExponent j)) := by
  calc
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
        (fun _ ↦ 0)
        (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
        ∑ j : Fin 4, 8 *
          (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
            (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
              ∫ x : E3,
                scratch_sourceStoppingRootMajorant K F j x ^ q j) :=
      scratch_initialSourceStoppingCoordinateEnvelope_le_powerDyadic
        α S F q K hq hsum hqs hK hFnonzero htwo hfour
    _ = ∑ j : Fin 4, 8 *
        (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
          (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
            ∫ x : E3, ‖scratch_sourceStoppingPowerMajorant K F j x‖ ^
              (q j / sourceStoppingExponent j)) := by
      apply Finset.sum_congr rfl
      intro j _
      congr 2
      apply integral_congr_ae
      filter_upwards [] with x
      unfold scratch_sourceStoppingRootMajorant
      rw [← Real.rpow_mul (norm_nonneg _)]
      congr 1
      field_simp

/-- A quantitative dyadic `L^(q_j/s_j)` estimate for each powered input can
be substituted directly into the initial stopping distribution.  This is the
normalization-ready interface: later one takes `B_j` to be a fixed constant
times the `q_j`-power input norm. -/
theorem scratch_initialSourceStoppingCoordinateEnvelope_le_of_powerDyadic_bounds
    (α : Anisotropy) (S : BoxCollection α) (F : InitialModelSchwartzInput)
    (q K : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j)
    (hK : ∀ j, 0 ≤ K j)
    (hFnonzero : ∀ j, F j ≠ 0)
    (htwo : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      cubeSecondMoment α t x (F 3) ≤
        ‖scratch_sourceStoppingPowerMajorant K F 3 x‖)
    (hfour : ∀ (j : Fin 4), j ≠ 3 → ∀ (t : ℝ), 0 < t → ∀ x : E3,
      fourthMoment α t x (F j) ≤
        ‖scratch_sourceStoppingPowerMajorant K F j x‖)
    (B : Fin 4 → ℝ)
    (hB : ∀ j : Fin 4,
      8 * (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
        (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
          ∫ x : E3, ‖scratch_sourceStoppingPowerMajorant K F j x‖ ^
            (q j / sourceStoppingExponent j)) ≤ B j) :
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
      (fun _ ↦ 0)
      (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
      ∑ j : Fin 4, B j := by
  calc
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
        (fun _ ↦ 0)
        (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
        ∑ j : Fin 4, 8 *
          (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
            (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
              ∫ x : E3, ‖scratch_sourceStoppingPowerMajorant K F j x‖ ^
                (q j / sourceStoppingExponent j)) :=
      scratch_initialSourceStoppingCoordinateEnvelope_le_powerDyadic_unrooted
        α S F q K hq hsum hqs hK hFnonzero htwo hfour
    _ ≤ ∑ j : Fin 4, B j := by
      exact Finset.sum_le_sum fun j _ ↦ hB j

/-- Product-norm-facing specialization of the preceding interface.  A
quantitative dyadic strong-type estimate is supplied exactly in the form
needed to bound each powered-majorant integral by the `q_j`-power integral of
the original input. -/
theorem scratch_initialSourceStoppingCoordinateEnvelope_le_inputPowerIntegrals
    (α : Anisotropy) (S : BoxCollection α) (F : InitialModelSchwartzInput)
    (q K C : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j)
    (hK : ∀ j, 0 ≤ K j)
    (hFnonzero : ∀ j, F j ≠ 0)
    (htwo : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      cubeSecondMoment α t x (F 3) ≤
        ‖scratch_sourceStoppingPowerMajorant K F 3 x‖)
    (hfour : ∀ (j : Fin 4), j ≠ 3 → ∀ (t : ℝ), 0 < t → ∀ x : E3,
      fourthMoment α t x (F j) ≤
        ‖scratch_sourceStoppingPowerMajorant K F j x‖)
    (hdyadic : ∀ j : Fin 4,
      8 * (((1 - ((2 : ℝ) ^ (q j))⁻¹)⁻¹ *
        (sourceStoppingComparisonConstant j / 2) ^ (-(q j))) *
          ∫ x : E3, ‖scratch_sourceStoppingPowerMajorant K F j x‖ ^
            (q j / sourceStoppingExponent j)) ≤
        C j * ∫ x : E3, |F j x| ^ q j) :
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
      (fun _ ↦ 0)
      (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
      ∑ j : Fin 4, C j * ∫ x : E3, |F j x| ^ q j := by
  exact scratch_initialSourceStoppingCoordinateEnvelope_le_of_powerDyadic_bounds
    α S F q K hq hsum hqs hK hFnonzero htwo hfour
    (fun j ↦ C j * ∫ x : E3, |F j x| ^ q j) hdyadic

/-- Fully quantitative initial stopping distribution for real Schwartz
input, conditional only on the literal fixed-scale second/fourth bracket
majorants.  The dyadic strong-type and root conversions have all been
discharged, leaving the explicit coordinate constants below. -/
theorem scratch_initialSourceStoppingCoordinateEnvelope_le_explicitInputPowers
    (α : Anisotropy) (S : BoxCollection α) (F : InitialModelSchwartzInput)
    (q K : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j)
    (hK : ∀ j, 0 ≤ K j)
    (hFnonzero : ∀ j, F j ≠ 0)
    (htwo : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      cubeSecondMoment α t x (F 3) ≤
        ‖scratch_sourceStoppingPowerMajorant K F 3 x‖)
    (hfour : ∀ (j : Fin 4), j ≠ 3 → ∀ (t : ℝ), 0 < t → ∀ x : E3,
      fourthMoment α t x (F j) ≤
        ‖scratch_sourceStoppingPowerMajorant K F j x‖) :
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
      (fun _ ↦ 0)
      (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
      ∑ j : Fin 4, scratch_sourceStoppingDyadicInputConstant K q j *
        ∫ x : E3, |F j x| ^ q j := by
  exact scratch_initialSourceStoppingCoordinateEnvelope_le_inputPowerIntegrals
    α S F q K (scratch_sourceStoppingDyadicInputConstant K q)
    hq hsum hqs hK hFnonzero htwo hfour
    (fun j ↦ scratch_weightedPowerMajorantIntegral_le_inputPowerIntegral
      K q hK F j (hq j) (hqs j))

/-- The initial stopping distribution for real Schwartz data follows from the
literal bracket-kernel shell majorants, with no remaining fixed-scale
assumptions.  The explicit coefficient retains the three coordinate dyadic
strong-type factors and the source layer-cake constants. -/
theorem scratch_initialSourceStoppingCoordinateEnvelope_le_explicitInputPowers_of_realSchwartz
    (α : Anisotropy) (S : BoxCollection α) (F : InitialModelSchwartzInput)
    (q : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j)
    (hFnonzero : ∀ j, F j ≠ 0) :
    SourceStoppingCoordinateEnvelope α S (InitialModelRealInput F) q
      (fun _ ↦ 0)
      (initialModel_sourceStoppingData_all_pos_of_ne_zero α S F hFnonzero) ≤
      ∑ j : Fin 4,
        scratch_sourceStoppingDyadicInputConstant
          (fun _ ↦ scratch_dyadicBracketShellConstant) q j *
          ∫ x : E3, |F j x| ^ q j := by
  let K : Fin 4 → ℝ := fun _ ↦ scratch_dyadicBracketShellConstant
  have hK : ∀ j, 0 ≤ K j := by
    intro j
    dsimp only [K]
    exact scratch_dyadicBracketShellConstant_nonneg
  have htwo : ∀ (t : ℝ), 0 < t → ∀ x : E3,
      cubeSecondMoment α t x (F 3) ≤
        ‖scratch_sourceStoppingPowerMajorant K F 3 x‖ := by
    intro t ht x
    have hpower : ∀ y : E3,
        ‖complexifyRealSchwartz (scratch_sourceStoppingPowerRepresentative F 3) y‖ =
          (F 3 y) ^ 2 := by
      intro y
      rw [complexifyRealSchwartz_apply,
        scratch_sourceStoppingPowerRepresentative_apply_of_eq_three F rfl,
        Complex.norm_real, Real.norm_eq_abs]
      exact abs_of_nonneg (sq_nonneg (F 3 y))
    simpa only [scratch_sourceStoppingPowerMajorant] using
      (scratch_cubeSecondMoment_le_scaledDyadic_of_norm_eq_square
        α (F 3)
        (complexifyRealSchwartz (scratch_sourceStoppingPowerRepresentative F 3))
        hpower ht x)
  have hfour : ∀ (j : Fin 4), j ≠ 3 → ∀ (t : ℝ), 0 < t → ∀ x : E3,
      fourthMoment α t x (F j) ≤
        ‖scratch_sourceStoppingPowerMajorant K F j x‖ := by
    intro j hj t ht x
    have hpower : ∀ y : E3,
        ‖complexifyRealSchwartz (scratch_sourceStoppingPowerRepresentative F j) y‖ =
          |F j y| ^ (4 : ℝ) := by
      intro y
      rw [complexifyRealSchwartz_apply,
        scratch_sourceStoppingPowerRepresentative_apply_of_ne_three F hj,
        Complex.norm_real, Real.norm_eq_abs, abs_pow]
      exact (Real.rpow_natCast (|F j y|) 4).symm
    simpa only [scratch_sourceStoppingPowerMajorant] using
      (scratch_fourthMoment_le_scaledDyadic_of_norm_eq_fourth
        α (F j)
        (complexifyRealSchwartz (scratch_sourceStoppingPowerRepresentative F j))
        hpower ht x)
  simpa only [K] using
    (scratch_initialSourceStoppingCoordinateEnvelope_le_explicitInputPowers
      α S F q K hq hsum hqs hK hFnonzero htwo hfour)

end
