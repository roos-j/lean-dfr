/-- At a fixed positive scale, the literal complex source spatial profile is
exactly the `E9` frequency integral carrying the three actual scalar Fourier
kernel multipliers.  This is the spatial/Fubini interface needed before the
mode multiplier identities substitute their explicit cone symbols. -/
theorem scratch_LiteralModelSpatialProfile_eq_frequencyKernelIntegral
    (α : Anisotropy) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (ht : 0 < t) :
    LiteralModelSpatialProfile α u F t =
      ∫ ζ : Frequency9,
        ((𝓕 (scratch_complexDilatedModelLowKernel (u 0)
          (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
          ((𝓕 (scratch_complexDilatedModelLowKernel (u 1)
            (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
            (𝓕 (scratch_complexDilatedModelThirdKernel (u 2)
              (t ^ α.weight 2))) (frequencyDiagonal ζ 2))) *
          frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ := by
  have hs₀ : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs₁ : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs₂ : 0 < t ^ α.weight 2 := pow_pos ht _
  have hk₀ : Integrable
      (scratch_complexDilatedModelLowKernel (u 0) (t ^ α.weight 0)) :=
    scratch_integrable_complexDilatedModelLowKernel (u 0) (t ^ α.weight 0) hs₀
  have hk₁ : Integrable
      (scratch_complexDilatedModelLowKernel (u 1) (t ^ α.weight 1)) :=
    scratch_integrable_complexDilatedModelLowKernel (u 1) (t ^ α.weight 1) hs₁
  have hk₂ : Integrable
      (scratch_complexDilatedModelThirdKernel (u 2) (t ^ α.weight 2)) :=
    scratch_integrable_complexDilatedModelThirdKernel (u 2) (t ^ α.weight 2) hs₂
  calc
    LiteralModelSpatialProfile α u F t =
        ∫ x : E3, F 0 x *
          ((∫ r : ℝ, F 1 (x - r • Anisotropy.coordinateDirection 0) *
              scratch_complexDilatedModelLowKernel (u 0) (t ^ α.weight 0) r) *
            ((∫ r : ℝ, F 2 (x - r • Anisotropy.coordinateDirection 1) *
                scratch_complexDilatedModelLowKernel (u 1) (t ^ α.weight 1) r) *
              ∫ r : ℝ, F 3 (x - r • Anisotropy.coordinateDirection 2) *
                scratch_complexDilatedModelThirdKernel (u 2)
                  (t ^ α.weight 2) r)) := by
          unfold LiteralModelSpatialProfile
            LiteralComplexInternal.scratch_LiteralModelSpatialProfile
            LiteralComplexInternal.scratch_LiteralModelSpatialIntegrand
            LiteralComplexInternal.scratch_LiteralModelCoordinateConvolution
            scratch_complexDilatedModelLowKernel
            scratch_complexDilatedModelThirdKernel
          apply integral_congr_ae
          filter_upwards [] with x
          ring
    _ = ∫ ζ : Frequency9,
        ((𝓕 (scratch_complexDilatedModelLowKernel (u 0)
          (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
          ((𝓕 (scratch_complexDilatedModelLowKernel (u 1)
            (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
            (𝓕 (scratch_complexDilatedModelThirdKernel (u 2)
              (t ^ α.weight 2))) (frequencyDiagonal ζ 2))) *
          frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ :=
      scratch_threeCoordinateSpatialIntegral_eq_frequencyKernelIntegral
        (F 0) (F 1) (F 2) (F 3)
        (scratch_complexDilatedModelLowKernel (u 0) (t ^ α.weight 0))
        (scratch_complexDilatedModelLowKernel (u 1) (t ^ α.weight 1))
        (scratch_complexDilatedModelThirdKernel (u 2) (t ^ α.weight 2))
        hk₀ hk₁ hk₂

/-- The fixed-scale Fourier multiplier whose value at `-η` is the product of
the three literal spatial kernel multipliers at `η`. -/
noncomputable def scratch_literalModelScaleKernelSymbol
    (α : Anisotropy) (u : E3) (t : ℝ) : E3 → ℂ := fun ξ ↦
  (𝓕 (scratch_complexDilatedModelLowKernel (u 0)
    (t ^ α.weight 0))) (-(ξ 0)) *
    ((𝓕 (scratch_complexDilatedModelLowKernel (u 1)
      (t ^ α.weight 1))) (-(ξ 1)) *
      (𝓕 (scratch_complexDilatedModelThirdKernel (u 2)
        (t ^ α.weight 2))) (-(ξ 2)))

/-- Evaluation of the fixed-scale kernel symbol at the source diagonal
variable exposes the three Fourier multipliers in the spatial bridge. -/
theorem scratch_literalModelScaleKernelSymbol_neg_frequencyDiagonal
    (α : Anisotropy) (u : E3) (t : ℝ) (ζ : Frequency9) :
    scratch_literalModelScaleKernelSymbol α u t (-frequencyDiagonal ζ) =
      (𝓕 (scratch_complexDilatedModelLowKernel (u 0)
        (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
        ((𝓕 (scratch_complexDilatedModelLowKernel (u 1)
          (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
          (𝓕 (scratch_complexDilatedModelThirdKernel (u 2)
            (t ^ α.weight 2))) (frequencyDiagonal ζ 2)) := by
  unfold scratch_literalModelScaleKernelSymbol
  simp only [PiLp.neg_apply, neg_neg]

/-- Fixed-scale literal spatial profile as the project's existing
`frequencyForm`.  This eliminates the remaining notational gap between the
literal convolution formula and the source's `E9` multiplier representation. -/
theorem scratch_LiteralModelSpatialProfile_eq_frequencyForm
    (α : Anisotropy) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (ht : 0 < t) :
    LiteralModelSpatialProfile α u F t =
      frequencyForm (scratch_literalModelScaleKernelSymbol α u t)
        (F 0) (F 1) (F 2) (F 3) := by
  let R : ℂ := frequencyForm (scratch_literalModelScaleKernelSymbol α u t)
    (F 0) (F 1) (F 2) (F 3)
  change LiteralModelSpatialProfile α u F t = R
  calc
    LiteralModelSpatialProfile α u F t =
        ∫ ζ : Frequency9,
          ((𝓕 (scratch_complexDilatedModelLowKernel (u 0)
            (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
            ((𝓕 (scratch_complexDilatedModelLowKernel (u 1)
              (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
              (𝓕 (scratch_complexDilatedModelThirdKernel (u 2)
                (t ^ α.weight 2))) (frequencyDiagonal ζ 2))) *
            frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ :=
      scratch_LiteralModelSpatialProfile_eq_frequencyKernelIntegral α u F t ht
    _ = R := by
      change (∫ ζ : Frequency9,
        ((𝓕 (scratch_complexDilatedModelLowKernel (u 0)
          (t ^ α.weight 0))) (frequencyDiagonal ζ 0) *
          ((𝓕 (scratch_complexDilatedModelLowKernel (u 1)
            (t ^ α.weight 1))) (frequencyDiagonal ζ 1) *
            (𝓕 (scratch_complexDilatedModelThirdKernel (u 2)
              (t ^ α.weight 2))) (frequencyDiagonal ζ 2))) *
          frequencyKernel (F 0) (F 1) (F 2) (F 3) ζ) =
          frequencyForm (scratch_literalModelScaleKernelSymbol α u t)
            (F 0) (F 1) (F 2) (F 3)
      unfold frequencyForm
      rw [frequencyMeasure_eq_volume]
      apply integral_congr_ae
      filter_upwards [] with ζ
      rw [scratch_literalModelScaleKernelSymbol_neg_frequencyDiagonal]

/-- Conditional `multiplierForm` version of the fixed-scale literal spatial
identity.  The only external premise is the standard anisotropic-multiplier
certificate for the compact fixed-scale kernel symbol. -/
theorem scratch_LiteralModelSpatialProfile_eq_multiplierForm
    (α : Anisotropy) (M : ℝ) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (ht : 0 < t)
    (hm : Anisotropy.IsAnisotropicMultiplier α M
      (scratch_literalModelScaleKernelSymbol α u t)) :
    LiteralModelSpatialProfile α u F t =
      multiplierForm (scratch_literalModelScaleKernelSymbol α u t)
        (F 0) (F 1) (F 2) (F 3) := by
  calc
    LiteralModelSpatialProfile α u F t =
        frequencyForm (scratch_literalModelScaleKernelSymbol α u t)
          (F 0) (F 1) (F 2) (F 3) :=
      scratch_LiteralModelSpatialProfile_eq_frequencyForm α u F t ht
    _ = multiplierForm (scratch_literalModelScaleKernelSymbol α u t)
          (F 0) (F 1) (F 2) (F 3) :=
      (multiplierForm_eq_frequencyForm α M
        (scratch_literalModelScaleKernelSymbol α u t) hm
        (F 0) (F 1) (F 2) (F 3)).symm

