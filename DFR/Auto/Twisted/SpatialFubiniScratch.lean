        (scratch_complexDilatedActiveModelKernel i 0 u (t ^ α.weight 0))
        (scratch_complexDilatedActiveModelKernel i 1 u (t ^ α.weight 1))
        (scratch_complexDilatedActiveModelKernel i 2 u (t ^ α.weight 2))
