    {a C : ℝ} (ha : 0 < a)
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ScratchModelSchwartzInput)
    (B : ℝ)
    (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hmeas : AEStronglyMeasurable
      (fun t : ℝ ↦ c t * scratchModelSpatialProfile α u F t)
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))))
    (hprofile : ∀ t : ℝ, 0 < t →
      |scratchModelSpatialProfile α u F t| ≤ C * min (t ^ a) (t ^ (-a)))
    (htrunc : ∀ N : ℕ, |scratchModelScaleTruncation α u c F N| ≤ B) :
    |scratchModelFullForm α u c F| ≤ B := by
  have hlim := scratch_tendsto_modelScaleTruncation_of_bound
    ha α u c F hc hmeas hprofile
  have hlimabs : Tendsto (fun N ↦ |scratchModelScaleTruncation α u c F N|)
      atTop (𝓝 |scratchModelFullForm α u c F|) := by
    exact (continuous_abs.tendsto _).comp hlim
  apply le_of_tendsto hlimabs
  exact Filter.Eventually.of_forall htrunc

/-- In particular, a finite-forest estimate uniform over bounded
coefficients transfers first to all finite dyadic truncations and then to the
full model form. -/
theorem scratch_modelFullForm_bound_of_profile_and_uniform_forest_bound
    {a C : ℝ} (ha : 0 < a)
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ScratchModelSchwartzInput)
    (B : ℝ)
    (hc : ∀ t : ℝ, |c t| ≤ 1)
    (hmeas : AEStronglyMeasurable
      (fun t : ℝ ↦ c t * scratchModelSpatialProfile α u F t)
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))))
    (hprofile : ∀ t : ℝ, 0 < t →
      |scratchModelSpatialProfile α u F t| ≤ C * min (t ^ a) (t ^ (-a)))
    (hforest : ∀ d : ℝ → ℝ, (∀ t : ℝ, |d t| ≤ 1) →
      |scratchModelFullForm α u d F| ≤ B) :
    |scratchModelFullForm α u c F| ≤ B := by
  apply scratch_modelFullForm_bound_of_profile_and_uniform_truncation_bound
    ha α u c F B hc hmeas hprofile
  intro N
  exact scratch_modelScaleTruncation_bound_of_uniform_coefficient_bound
    α u c F B N hc hforest

end

