/-! ## Scaling obstruction for the frozen-slice supplied tail

The ordinary supplied-tail conclusion would control a support-size power
coming from a weak endpoint by the support-size power dictated by the target
source/output pair.  For a frozen Section 8 slice the endpoint power is
strictly larger.  This file proves the elementary unboundedness statement
behind that obstruction, without claiming anything about the model operator
itself.
-/

/-- If `a < b`, the quotient `M^b / M^a` is unbounded as the positive
support-size parameter `M` tends to infinity. -/
theorem scratch_exists_rpow_supportRatio_violation
    {a b C : ℝ} (hab : a < b) :
    ∃ M : ℝ, 1 ≤ M ∧ C * M ^ a < M ^ b := by
  have hpow : Tendsto (fun M : ℝ => M ^ (b - a)) atTop atTop :=
    tendsto_rpow_atTop (sub_pos.mpr hab)
  have hevent : ∀ᶠ M : ℝ in atTop, 1 ≤ M ∧ C < M ^ (b - a) :=
    (eventually_ge_atTop (1 : ℝ)).and (hpow.eventually_gt_atTop C)
  rcases hevent.exists with ⟨M, hMone, hMgap⟩
  refine ⟨M, hMone, ?_⟩
  have hMpos : 0 < M := lt_of_lt_of_le zero_lt_one hMone
  have hMa_pos : 0 < M ^ a := Real.rpow_pos_of_pos hMpos _
  calc
    C * M ^ a < M ^ (b - a) * M ^ a :=
      mul_lt_mul_of_pos_right hMgap hMa_pos
    _ = M ^ b := by
      rw [← Real.rpow_add hMpos]
      congr 1
      ring

/-- Consequently no uniform constant can bound a larger support power by a
smaller one on all finite support sizes. -/
theorem scratch_no_uniform_rpow_supportRatio_bound
    {a b : ℝ} (hab : a < b) :
    ¬ ∃ C : ℝ, ∀ M : ℝ, 1 ≤ M → M ^ b ≤ C * M ^ a := by
  intro h
  rcases h with ⟨C, hC⟩
  rcases scratch_exists_rpow_supportRatio_violation (C := C) hab with
    ⟨M, hMone, hviol⟩
  exact (not_lt_of_ge (hC M hMone)) hviol

/-- In the frozen one-input slice, let `a` be the passive reciprocal sum,
`e` the weak-one endpoint active reciprocal, and `x` the target active
reciprocal.  If `a + e = 1` and `x < e`, then the target support exponent
is strictly below the weak-endpoint support exponent. -/
theorem scratch_frozenSlice_targetSupportExponent_lt_endpoint
    {a e x : ℝ} (ha : 0 < a) (hx : 0 < x)
    (hxe : x < e) (hsum : a + e = 1) :
