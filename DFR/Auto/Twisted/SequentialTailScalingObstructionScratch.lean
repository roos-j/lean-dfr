  have he : 0 < e := by linarith
  have hax : 0 < a + x := add_pos ha hx
  rw [div_lt_iff₀ hax]
  nlinarith

/-- The high-tail support-size comparison demanded by a conventional global
supplied-tail proof is false for every frozen Section 8 slice.  Thus the
