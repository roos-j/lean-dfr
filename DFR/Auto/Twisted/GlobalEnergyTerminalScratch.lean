theorem scratch_modelEnergyTwoOn_global_eq_of_joint_and_fixedFiber
    (α : Anisotropy) (u : E3) (f : SchwartzMap E3 ℝ)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
