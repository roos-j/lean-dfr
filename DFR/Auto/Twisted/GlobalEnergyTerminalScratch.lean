    (hpr : ∀ (x₁ x₂ t : ℝ), 0 < t → Integrable (fun z : ℝ × ℝ ↦
      (modelSecondFiberReduced α f x₁ x₂ z.1 t z.2) ^ 2 *
        |conePsiPhysicalReal (z.2 + u 2)|)
      ((volume : Measure ℝ).prod volume)) :
    modelEnergyTwoOn α (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f =
      (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 *
        conePsiPhysicalRealL1 * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ x : E3, f x ^ 2 := by
  exact scratch_modelEnergyTwoOn_global_eq_of_real_schwartz α u f hjoint
    (scratch_integrable_reordered_scalar_of_joint α u f hjoint) hpr

