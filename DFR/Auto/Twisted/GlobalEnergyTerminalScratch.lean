            exact integral_Ioi_withDensity_cubeScaleDensity_eq
              (fun t : ℝ ↦ A * P * Q x₁ x₂ t)
      _ = A * P * ∫ t : ℝ in Set.Ioi (0 : ℝ), Q x₁ x₂ t / t := by
            rw [show (fun t : ℝ ↦ (A * P * Q x₁ x₂ t) / t) =
              fun t : ℝ ↦ (A * P) * (Q x₁ x₂ t / t) by
                funext t
                ring,
              integral_const_mul]
      _ = A * P * ((Real.pi / (α.weight 2 : ℝ)) *
          ∫ v : ℝ, f (modelPoint x₁ x₂ v) ^ 2) := by
            rw [show (∫ t : ℝ in Set.Ioi (0 : ℝ), Q x₁ x₂ t / t) =
              ∫ t : ℝ in Set.Ioi (0 : ℝ), ∫ q : ℝ,
                (∫ v : ℝ, f (modelPoint x₁ x₂ v) *
                  gaussianDerivAt (t ^ α.weight 2) q v) ^ 2 / t by
                apply setIntegral_congr_fun measurableSet_Ioi
                intro t ht
                dsimp [Q]
                rw [integral_div],
              modelThird_square_function_of_real_schwartz α f x₁ x₂]
      _ = A * P * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ v : ℝ, f (modelPoint x₁ x₂ v) ^ 2 := by ring
  have hfsq : Integrable (fun x : E3 ↦ f x ^ 2) := by
    exact (memLp_two_iff_integrable_sq
      f.continuous.aestronglyMeasurable).mp (f.memLp 2 volume)
  calc
    (∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ p₂ : ℝ,
      ∫ t : ℝ in Set.Ioi (0 : ℝ),
        ((∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
          (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2) *
          (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2)
        ∂((volume : Measure ℝ).withDensity cubeScaleDensity)) =
        ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ p₂ : ℝ,
          ∫ t : ℝ in Set.Ioi (0 : ℝ),
            H ((x₁, x₂), (p₂, t))
            ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
            dsimp [H, A, ν]
            apply integral_congr_ae
            filter_upwards [] with x₁
            apply integral_congr_ae
            filter_upwards [] with x₂
            apply integral_congr_ae
            filter_upwards [] with p₂
            apply integral_congr_ae
            filter_upwards [] with t
            ring
    _ = ∫ w : ScratchModelEnergyOuter, H w
        ∂(((volume : Measure ℝ).prod volume).prod
          ((volume : Measure ℝ).prod ν)) := by
          exact (integral_ScratchModelEnergyOuter_eq_nested ν H hH).symm
    _ = ∫ x : ℝ × ℝ, ∫ pt : ℝ × ℝ, H (x, pt)
        ∂((volume : Measure ℝ).prod ν) := by
          exact integral_prod _ hH
    _ = ∫ x : ℝ × ℝ, J x := by
          apply integral_congr_ae
          filter_upwards [hH.prod_right_ae] with x hx
          calc
            (∫ pt : ℝ × ℝ, H (x, pt)
              ∂((volume : Measure ℝ).prod ν)) =
                ∫ p₂ : ℝ, ∫ t : ℝ, H (x, (p₂, t)) ∂ν :=
              integral_prod _ hx
            _ = J x := hswap x hx
    _ = ∫ x₁ : ℝ, ∫ x₂ : ℝ, J (x₁, x₂) := by
          exact integral_prod _ hJ
    _ = ∫ x₁ : ℝ, ∫ x₂ : ℝ,
        A * P * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ v : ℝ, f (modelPoint x₁ x₂ v) ^ 2 := by
          apply integral_congr_ae
          filter_upwards [] with x₁
          apply integral_congr_ae
          filter_upwards [] with x₂
          exact hJvalue x₁ x₂
    _ = A * P * (Real.pi / (α.weight 2 : ℝ)) *
        ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ v : ℝ,
          f (modelPoint x₁ x₂ v) ^ 2 := by
          let C : ℝ := A * P * (Real.pi / (α.weight 2 : ℝ))
          calc
            (∫ x₁ : ℝ, ∫ x₂ : ℝ,
              A * P * (Real.pi / (α.weight 2 : ℝ)) *
                ∫ v : ℝ, f (modelPoint x₁ x₂ v) ^ 2) =
                ∫ x₁ : ℝ, ∫ x₂ : ℝ,
                  C * ∫ v : ℝ, f (modelPoint x₁ x₂ v) ^ 2 := by
                    apply integral_congr_ae
                    filter_upwards [] with x₁
                    apply integral_congr_ae
                    filter_upwards [] with x₂
                    rfl
            _ = ∫ x₁ : ℝ, C * (∫ x₂ : ℝ, ∫ v : ℝ,
                f (modelPoint x₁ x₂ v) ^ 2) := by
                  apply integral_congr_ae
                  filter_upwards [] with x₁
                  rw [integral_const_mul]
            _ = C * ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ v : ℝ,
                f (modelPoint x₁ x₂ v) ^ 2 := by
                  rw [integral_const_mul]
            _ = A * P * (Real.pi / (α.weight 2 : ℝ)) *
                ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ v : ℝ,
                  f (modelPoint x₁ x₂ v) ^ 2 := by
                    rfl
    _ = A * P * (Real.pi / (α.weight 2 : ℝ)) *
        ∫ x : E3, f x ^ 2 := by
          rw [scratch_integral_modelPoint_sq_eq f hfsq]
    _ = (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 *
        conePsiPhysicalRealL1 * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ x : E3, f x ^ 2 := by
          rfl

/-- Conditional full form of the blueprint's global second-energy identity
for a real Schwartz input.  The hypotheses are exactly the two unresolved
global integrability discharges: the original joint density and the scalar
post-Tonelli `(x₁,x₂,p₂,t)` density. -/
theorem scratch_modelEnergyTwoOn_global_eq_of_real_schwartz
    (α : Anisotropy) (u : E3) (f : SchwartzMap E3 ℝ)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyTwoIntegrand α u f q.1 q.2)
      ((cubeScaleMeasure.restrict (Set.univ ×ˢ Set.Ioi (0 : ℝ))).prod volume))
    (hscalar : Integrable (fun w : ScratchModelEnergyOuter ↦
      (∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
        (modelSecondFiberReduced α f w.1.1 w.1.2 w.2.1 w.2.2 r) ^ 2) *
        (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2)
      (((volume : Measure ℝ).prod volume).prod
        ((volume : Measure ℝ).prod
          (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
            (Set.Ioi (0 : ℝ))))))
    (hpr : ∀ (x₁ x₂ t : ℝ), 0 < t → Integrable (fun z : ℝ × ℝ ↦
      (modelSecondFiberReduced α f x₁ x₂ z.1 t z.2) ^ 2 *
        |conePsiPhysicalReal (z.2 + u 2)|)
      ((volume : Measure ℝ).prod volume)) :
    modelEnergyTwoOn α (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f =
      (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 *
        conePsiPhysicalRealL1 * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ x : E3, f x ^ 2 := by
  calc
    modelEnergyTwoOn α (Set.univ ×ˢ Set.Ioi (0 : ℝ)) u f =
      ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ p₂ : ℝ,
        ∫ t : ℝ in Set.Ioi (0 : ℝ),
          (∫ p₀ : ℝ, ∫ p₁ : ℝ, ∫ y₁ : ℝ, ∫ y₂ : ℝ, ∫ r : ℝ,
            (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2 *
              modelEnergyDensityReordered α u x₁ x₂ t p₀ p₁ y₁ y₂ r)
          ∂((volume : Measure ℝ).withDensity cubeScaleDensity) :=
      scratch_modelEnergyTwoOn_eq_reordered_nested α u f hjoint
    _ = ∫ x₁ : ℝ, ∫ x₂ : ℝ, ∫ p₂ : ℝ,
        ∫ t : ℝ in Set.Ioi (0 : ℝ),
          ((∫ r : ℝ, |conePsiPhysicalReal (r + u 2)| *
            (modelSecondFiberReduced α f x₁ x₂ p₂ t r) ^ 2) *
            (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2)
          ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
            apply integral_congr_ae
            filter_upwards [] with x₁
            apply integral_congr_ae
            filter_upwards [] with x₂
            apply integral_congr_ae
            filter_upwards [] with p₂
            apply setIntegral_congr_fun measurableSet_Ioi
            intro t ht
            exact modelEnergy_reordered_inner_scalar_reduction
              α u f x₁ x₂ p₂ t ht
    _ = (∫ z : ℝ, |conePhiPhysicalReal z|) ^ 2 *
        conePsiPhysicalRealL1 * (Real.pi / (α.weight 2 : ℝ)) *
          ∫ x : E3, f x ^ 2 :=
      scratch_reordered_scalar_energy_eq_global_L2 α u f hscalar hpr

/-- Source-facing conditional global second-energy identity.  All Tonelli
and scalar-mass side conditions are discharged from `hjoint`; only the
fixed-fiber translation integrability remains as an explicit analytic
