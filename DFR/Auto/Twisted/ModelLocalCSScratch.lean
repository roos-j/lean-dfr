/-- Square-integrable square-root weighted factors make the signed product
absolutely integrable whenever the signed density is dominated by the weight.
This is the Fubini input accompanying the weighted Cauchy--Schwarz bound. -/
theorem scratch_integrable_signedDensity_of_weighted
    {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (a b c σ w : X → ℝ)
    (hprodmeas : AEStronglyMeasurable (fun x ↦ c x * (a x * b x * σ x)) μ)
    (hameas : AEStronglyMeasurable (fun x ↦ |a x| * √(w x)) μ)
    (hbmeas : AEStronglyMeasurable (fun x ↦ |b x| * √(w x)) μ)
    (haint : Integrable (fun x ↦ (|a x| * √(w x)) ^ 2) μ)
    (hbint : Integrable (fun x ↦ (|b x| * √(w x)) ^ 2) μ)
    (hc : ∀ᵐ x ∂μ, |c x| ≤ 1)
    (hw : ∀ᵐ x ∂μ, 0 ≤ w x)
    (hσ : ∀ᵐ x ∂μ, |σ x| = w x) :
    Integrable (fun x ↦ c x * (a x * b x * σ x)) μ := by
  let A : X → ℝ := fun x ↦ |a x| * √(w x)
  let B : X → ℝ := fun x ↦ |b x| * √(w x)
  have hAmeas : AEStronglyMeasurable A μ := by
    simpa only [A] using hameas
  have hBmeas : AEStronglyMeasurable B μ := by
    simpa only [B] using hbmeas
  have hAint : Integrable (fun x ↦ A x ^ 2) μ := by
    simpa only [A] using haint
  have hBint : Integrable (fun x ↦ B x ^ 2) μ := by
    simpa only [B] using hbint
  have hABint : Integrable (fun x ↦ A x * B x) μ := by
    exact ((memLp_two_iff_integrable_sq hAmeas).2 hAint).integrable_mul
      ((memLp_two_iff_integrable_sq hBmeas).2 hBint)
  refine hABint.mono' hprodmeas ?_
  filter_upwards [hc, hw, hσ] with x hcx hw' hσ'
  have hab : 0 ≤ |a x| * |b x| * w x := by positivity
  calc
    ‖c x * (a x * b x * σ x)‖ = |c x| * |a x| * |b x| * w x := by
      rw [Real.norm_eq_abs, abs_mul, abs_mul, abs_mul, hσ']
      ring
    _ = |c x| * (|a x| * |b x| * w x) := by ring
    _ ≤ 1 * (|a x| * |b x| * w x) :=
      mul_le_mul_of_nonneg_right hcx hab
    _ = |a x| * |b x| * w x := by ring
    _ = A x * B x := by
      dsimp only [A, B]
      calc
        |a x| * |b x| * w x =
            |a x| * |b x| * (√(w x) * √(w x)) := by
          rw [Real.mul_self_sqrt hw']
        _ = |a x| * √(w x) * (|b x| * √(w x)) := by ring

/-- A uniform bound on a fiber and integrability of a nonnegative density
give the square-integrability of its square-root weighted version. -/
theorem scratch_squareRootWeighted_integrable_of_ae_bound
    {X : Type*} [MeasurableSpace X] (μ : Measure X) (a w : X → ℝ)
    (ha : AEStronglyMeasurable a μ)
    (hwmeas : AEStronglyMeasurable w μ)
    (hwint : Integrable w μ)
    (hw : ∀ᵐ x ∂μ, 0 ≤ w x)
    (M : ℝ) (hM : 0 ≤ M)
    (hbound : ∀ᵐ x ∂μ, |a x| ≤ M) :
    AEStronglyMeasurable (fun x ↦ |a x| * √(w x)) μ ∧
      Integrable (fun x ↦ (|a x| * √(w x)) ^ 2) μ := by
  have hsqrt : AEStronglyMeasurable (fun x ↦ √(w x)) μ :=
    (hwmeas.aemeasurable.sqrt).aestronglyMeasurable
  have hmeas : AEStronglyMeasurable (fun x ↦ |a x| * √(w x)) μ :=
    ha.norm.mul hsqrt
  have hmajor : Integrable (fun x ↦ M ^ 2 * w x) μ := by
    simpa only using hwint.const_mul (M ^ 2)
  refine ⟨hmeas, hmajor.mono' (hmeas.pow 2) ?_⟩
  filter_upwards [hw, hbound] with x hw' hbound'
  rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
  have hsq : |a x| ^ 2 ≤ M ^ 2 :=
    (sq_le_sq₀ (abs_nonneg _) hM).2 hbound'
  calc
    (|a x| * √(w x)) ^ 2 = |a x| ^ 2 * w x := by
      rw [mul_pow, Real.sq_sqrt hw']
    _ ≤ M ^ 2 * w x := mul_le_mul_of_nonneg_right hsq hw'

/-- Cauchy--Schwarz for a signed density whose absolute value is a positive
weight.  The square-root weighted factors are kept explicit: this makes the
lemma applicable before any particular parameter-integral measurability
package has been chosen. -/
theorem scratch_signedDensity_weighted_cauchySchwarz
    {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (a b c σ w : X → ℝ)
    (hprodmeas : AEStronglyMeasurable (fun x ↦ c x * (a x * b x * σ x)) μ)
    (hameas : AEStronglyMeasurable (fun x ↦ |a x| * √(w x)) μ)
    (hbmeas : AEStronglyMeasurable (fun x ↦ |b x| * √(w x)) μ)
    (haint : Integrable (fun x ↦ (|a x| * √(w x)) ^ 2) μ)
    (hbint : Integrable (fun x ↦ (|b x| * √(w x)) ^ 2) μ)
    (hc : ∀ᵐ x ∂μ, |c x| ≤ 1)
    (hw : ∀ᵐ x ∂μ, 0 ≤ w x)
    (hσ : ∀ᵐ x ∂μ, |σ x| = w x) :
    |∫ x, c x * (a x * b x * σ x) ∂μ| ^ 2 ≤
      (∫ x, (|a x| * √(w x)) ^ 2 ∂μ) *
        ∫ x, (|b x| * √(w x)) ^ 2 ∂μ := by
  let A : X → ℝ := fun x ↦ |a x| * √(w x)
  let B : X → ℝ := fun x ↦ |b x| * √(w x)
  have hAmeas : AEStronglyMeasurable A μ := by
    simpa only [A] using hameas
  have hBmeas : AEStronglyMeasurable B μ := by
    simpa only [B] using hbmeas
  have hAint : Integrable (fun x ↦ A x ^ 2) μ := by
    simpa only [A] using haint
  have hBint : Integrable (fun x ↦ B x ^ 2) μ := by
    simpa only [B] using hbint
  have hABint : Integrable (fun x ↦ A x * B x) μ := by
    exact ((memLp_two_iff_integrable_sq hAmeas).2 hAint).integrable_mul
      ((memLp_two_iff_integrable_sq hBmeas).2 hBint)
  have hdom : ∀ᵐ x ∂μ,
      |c x * (a x * b x * σ x)| ≤ A x * B x := by
    filter_upwards [hc, hw, hσ] with x hcx hw' hσ'
    have hab : 0 ≤ |a x| * |b x| * w x := by positivity
    calc
      |c x * (a x * b x * σ x)| = |c x| * |a x| * |b x| * w x := by
        rw [abs_mul, abs_mul, abs_mul, hσ']
        ring
      _ = |c x| * (|a x| * |b x| * w x) := by ring
      _ ≤ 1 * (|a x| * |b x| * w x) :=
        mul_le_mul_of_nonneg_right hcx hab
      _ = |a x| * |b x| * w x := by ring
      _ = A x * B x := by
        dsimp only [A, B]
        calc
          |a x| * |b x| * w x =
              |a x| * |b x| * (√(w x) * √(w x)) := by
            rw [Real.mul_self_sqrt hw']
          _ = |a x| * √(w x) * (|b x| * √(w x)) := by ring
  have hsignedAbsInt : Integrable (fun x ↦ |c x * (a x * b x * σ x)|) μ := by
    refine hABint.mono' hprodmeas.norm ?_
    simpa only [Real.norm_eq_abs, abs_abs] using hdom
  have hbound : |∫ x, c x * (a x * b x * σ x) ∂μ| ≤
      √(∫ x, A x ^ 2 ∂μ) * √(∫ x, B x ^ 2 ∂μ) := by
    calc
      |∫ x, c x * (a x * b x * σ x) ∂μ| ≤
          ∫ x, |c x * (a x * b x * σ x)| ∂μ :=
        MeasureTheory.abs_integral_le_integral_abs
      _ ≤ ∫ x, A x * B x ∂μ :=
        integral_mono_ae hsignedAbsInt hABint hdom
      _ ≤ √(∫ x, A x ^ 2 ∂μ) * √(∫ x, B x ^ 2 ∂μ) :=
        integral_mul_le_sqrt_integral_sq μ A B hAmeas hBmeas
          (Filter.Eventually.of_forall fun x ↦ by positivity)
          (Filter.Eventually.of_forall fun x ↦ by positivity) hAint hBint
  have hAnonnneg : 0 ≤ ∫ x, A x ^ 2 ∂μ :=
    integral_nonneg fun x ↦ sq_nonneg (A x)
  have hBnonnneg : 0 ≤ ∫ x, B x ^ 2 ∂μ :=
    integral_nonneg fun x ↦ sq_nonneg (B x)
  have hright : 0 ≤ √(∫ x, A x ^ 2 ∂μ) * √(∫ x, B x ^ 2 ∂μ) :=
    mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
  calc
    |∫ x, c x * (a x * b x * σ x) ∂μ| ^ 2 ≤
        (√(∫ x, A x ^ 2 ∂μ) * √(∫ x, B x ^ 2 ∂μ)) ^ 2 :=
      (sq_le_sq₀ (abs_nonneg _) hright).2 hbound
    _ = (∫ x, A x ^ 2 ∂μ) * ∫ x, B x ^ 2 ∂μ := by
      rw [mul_pow, Real.sq_sqrt hAnonnneg, Real.sq_sqrt hBnonnneg]
    _ = (∫ x, (|a x| * √(w x)) ^ 2 ∂μ) *
        ∫ x, (|b x| * √(w x)) ^ 2 ∂μ := by
      rfl

/-- The first square-root weighted factor on the joint local-model space. -/
noncomputable def scratch_modelFirstWeightedFactor
    (α : Anisotropy) (u : E3) (f : ModelRealInput)
    (q : (E3 × ℝ) × ModelE5) : ℝ :=
  |modelFirstFiber α f q.1.1 q.1.2 q.2| *
    √(modelEnergyDensity α u q.1.1 q.1.2 q.2)

/-- The second square-root weighted factor on the joint local-model space. -/
noncomputable def scratch_modelSecondWeightedFactor
    (α : Anisotropy) (u : E3) (f : E3 → ℝ)
    (q : (E3 × ℝ) × ModelE5) : ℝ :=
  |modelSecondFiber α f q.1.1 q.1.2 q.2| *
    √(modelEnergyDensity α u q.1.1 q.1.2 q.2)

/-- The signed joint integrand whose iterated integral defines the expanded
local model form. -/
noncomputable def scratch_modelSignedIntegrand
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (q : (E3 × ℝ) × ModelE5) : ℝ :=
  c q.1.2 *
    (modelFirstFiber α f q.1.1 q.1.2 q.2 *
      modelSecondFiber α (f 3) q.1.1 q.1.2 q.2 *
        modelSignedDensity α u q.1.1 q.1.2 q.2)

/-- The joint integrand defining the first local energy. -/
noncomputable def scratch_modelEnergyOneIntegrand
    (α : Anisotropy) (u : E3) (f : ModelRealInput)
    (q : (E3 × ℝ) × ModelE5) : ℝ :=
  (modelFirstFiber α f q.1.1 q.1.2 q.2) ^ 2 *
    modelEnergyDensity α u q.1.1 q.1.2 q.2

/-- The joint integrand defining the second local energy. -/
noncomputable def scratch_modelEnergyTwoIntegrand
    (α : Anisotropy) (u : E3) (f : E3 → ℝ)
    (q : (E3 × ℝ) × ModelE5) : ℝ :=
  (modelSecondFiber α f q.1.1 q.1.2 q.2) ^ 2 *
    modelEnergyDensity α u q.1.1 q.1.2 q.2

/-- Continuous real inputs and a measurable multiplier make the signed local
model product a.e.-strongly measurable on every joint measure. -/
theorem scratch_aestronglyMeasurable_modelSignedIntegrand
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelRealInput)
    (hcmeas : Measurable c) (hfcont : ∀ j, Continuous (f j))
    (μ : Measure ((E3 × ℝ) × ModelE5)) :
    AEStronglyMeasurable (scratch_modelSignedIntegrand α u c f) μ := by
  have hc : AEStronglyMeasurable (fun q : (E3 × ℝ) × ModelE5 ↦ c q.1.2) μ :=
    (hcmeas.comp (measurable_snd.comp measurable_fst)).aestronglyMeasurable
  have hfirst := scratch_aestronglyMeasurable_modelFirstFiber α f hfcont μ
  have hsecond := scratch_aestronglyMeasurable_modelSecondFiber α (f 3)
    (hfcont 3) μ
  have hdensity := scratch_aestronglyMeasurable_modelSignedDensity α u μ
  unfold scratch_modelSignedIntegrand
  exact hc.mul ((hfirst.mul hsecond).mul hdensity)

/-- The first square-root weighted factor is a.e.-strongly measurable for
continuous inputs on every joint measure. -/
theorem scratch_aestronglyMeasurable_modelFirstWeightedFactor
    (α : Anisotropy) (u : E3) (f : ModelRealInput)
    (hfcont : ∀ j, Continuous (f j))
    (μ : Measure ((E3 × ℝ) × ModelE5)) :
    AEStronglyMeasurable (scratch_modelFirstWeightedFactor α u f) μ := by
  have hfirst := scratch_aestronglyMeasurable_modelFirstFiber α f hfcont μ
  have hweight := scratch_aestronglyMeasurable_modelEnergyDensity α u μ
  unfold scratch_modelFirstWeightedFactor
  exact hfirst.norm.mul (hweight.aemeasurable.sqrt).aestronglyMeasurable

/-- The second square-root weighted factor is a.e.-strongly measurable for a
continuous input on every joint measure. -/
theorem scratch_aestronglyMeasurable_modelSecondWeightedFactor
    (α : Anisotropy) (u : E3) (f : E3 → ℝ) (hfcont : Continuous f)
    (μ : Measure ((E3 × ℝ) × ModelE5)) :
    AEStronglyMeasurable (scratch_modelSecondWeightedFactor α u f) μ := by
  have hsecond := scratch_aestronglyMeasurable_modelSecondFiber α f hfcont μ
  have hweight := scratch_aestronglyMeasurable_modelEnergyDensity α u μ
  unfold scratch_modelSecondWeightedFactor
  exact hsecond.norm.mul (hweight.aemeasurable.sqrt).aestronglyMeasurable

/-- The joint center--scale/fiber measure of a finite collection is supported
on strictly positive scales. -/
theorem scratch_ae_pos_scale_modelJoint
    (α : Anisotropy) (S : BoxCollection α) :
    ∀ᵐ q ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
      (volume : Measure ModelE5)), 0 < q.1.2 := by
  let μpt : Measure (E3 × ℝ) :=
    cubeScaleMeasure.restrict (collectionRegion α S)
  have hpt : ∀ᵐ pt ∂μpt, 0 < pt.2 := by
    dsimp [μpt]
    filter_upwards [ae_restrict_mem (measurableSet_collectionRegion α S)]
      with pt hpt
    exact pos_of_mem_closure_collectionRegion α S (subset_closure hpt)
  have hmeas : MeasurableSet {q : (E3 × ℝ) × ModelE5 | 0 < q.1.2} := by
    change MeasurableSet ((fun q : (E3 × ℝ) × ModelE5 ↦ q.1.2) ⁻¹'
      Set.Ioi 0)
    exact measurableSet_preimage (measurable_snd.comp measurable_fst)
      measurableSet_Ioi
  change ∀ᵐ q ∂μpt.prod volume, 0 < q.1.2
  apply (Measure.ae_prod_iff_ae_ae hmeas).2
  filter_upwards [hpt] with pt hpt
  exact Filter.Eventually.of_forall fun _ ↦ hpt

/-- The literal energy density is a.e. nonnegative on the joint local-model
measure. -/
theorem scratch_ae_modelEnergyDensity_nonneg_collection
    (α : Anisotropy) (S : BoxCollection α) (u : E3) :
    ∀ᵐ q ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
      (volume : Measure ModelE5)),
      0 ≤ modelEnergyDensity α u q.1.1 q.1.2 q.2 := by
  filter_upwards [scratch_ae_pos_scale_modelJoint α S] with q hq
  exact modelEnergyDensity_nonneg α u q.1.1 hq.le q.2

/-- On the same joint measure, the signed density has absolute value exactly
the energy density. -/
theorem scratch_ae_abs_modelSignedDensity_collection
    (α : Anisotropy) (S : BoxCollection α) (u : E3) :
    ∀ᵐ q ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
      (volume : Measure ModelE5)),
      |modelSignedDensity α u q.1.1 q.1.2 q.2| =
        modelEnergyDensity α u q.1.1 q.1.2 q.2 := by
  filter_upwards [scratch_ae_pos_scale_modelJoint α S] with q hq
  exact abs_modelSignedDensity α u q.1.1 hq.le q.2

/-- Squaring the first weighted factor recovers the first energy density on
the positive-scale local joint measure. -/
theorem scratch_ae_modelFirstWeightedFactor_sq
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : ModelRealInput) :
    ∀ᵐ q ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
      (volume : Measure ModelE5)),
      (scratch_modelFirstWeightedFactor α u f q) ^ 2 =
        scratch_modelEnergyOneIntegrand α u f q := by
  filter_upwards [scratch_ae_modelEnergyDensity_nonneg_collection α S u]
    with q hq
  unfold scratch_modelFirstWeightedFactor scratch_modelEnergyOneIntegrand
  rw [mul_pow, sq_abs, Real.sq_sqrt hq]

/-- Squaring the second weighted factor recovers the second energy density on
the positive-scale local joint measure. -/
theorem scratch_ae_modelSecondWeightedFactor_sq
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : E3 → ℝ) :
    ∀ᵐ q ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
      (volume : Measure ModelE5)),
      (scratch_modelSecondWeightedFactor α u f q) ^ 2 =
        scratch_modelEnergyTwoIntegrand α u f q := by
  filter_upwards [scratch_ae_modelEnergyDensity_nonneg_collection α S u]
    with q hq
  unfold scratch_modelSecondWeightedFactor scratch_modelEnergyTwoIntegrand
  rw [mul_pow, sq_abs, Real.sq_sqrt hq]

/-- The positive-scale support of a finite collection promotes the fixed-scale
first-fiber estimate to the full local joint measure. -/
theorem scratch_ae_abs_modelFirstFiber_le_collection
    (α : Anisotropy) (S : BoxCollection α) (f : ModelRealInput)
    (hfcont : ∀ j, Continuous (f j))
    (B0 B1 B2 : ℝ) (hB0 : 0 ≤ B0) (hB1 : 0 ≤ B1) (hB2 : 0 ≤ B2)
    (hf0 : ∀ y, |f 0 y| ≤ B0) (hf1 : ∀ y, |f 1 y| ≤ B1)
    (hf2 : ∀ y, |f 2 y| ≤ B2) :
    ∀ᵐ q ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
      (volume : Measure ModelE5)),
      |modelFirstFiber α f q.1.1 q.1.2 q.2| ≤
        (B0 * B1 * B2) * ∫ v : ℝ, |gaussianDeriv v| := by
  filter_upwards [scratch_ae_pos_scale_modelJoint α S] with q hq
  exact abs_modelFirstFiber_le α f q.1.1 q.2 hfcont B0 B1 B2 hB0 hB1 hB2
    hf0 hf1 hf2 hq

/-- The analogous uniform second-fiber estimate on the full local joint
measure. -/
theorem scratch_ae_abs_modelSecondFiber_le_collection
    (α : Anisotropy) (S : BoxCollection α) (f : E3 → ℝ)
    (hfcont : Continuous f)
    (B : ℝ) (hB : 0 ≤ B) (hf : ∀ y, |f y| ≤ B) :
    ∀ᵐ q ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod
      (volume : Measure ModelE5)),
      |modelSecondFiber α f q.1.1 q.1.2 q.2| ≤
        B * ∫ v : ℝ, |gaussianDeriv v| := by
  filter_upwards [scratch_ae_pos_scale_modelJoint α S] with q hq
  exact abs_modelSecondFiber_le α f q.1.1 q.2 hfcont B hB hf hq

/-- Once the positive local density is jointly integrable, the first
square-root weighted fiber is square-integrable under the literal uniform
bounded-continuous hypotheses. -/
theorem scratch_integrable_modelFirstWeightedFactor_sq_of_density
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : ModelRealInput)
    (hfcont : ∀ j, Continuous (f j))
    (B0 B1 B2 : ℝ) (hB0 : 0 ≤ B0) (hB1 : 0 ≤ B1) (hB2 : 0 ≤ B2)
    (hf0 : ∀ y, |f 0 y| ≤ B0) (hf1 : ∀ y, |f 1 y| ≤ B1)
    (hf2 : ∀ y, |f 2 y| ≤ B2)
    (hweightint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5))) :
    Integrable (fun q ↦ (scratch_modelFirstWeightedFactor α u f q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)) := by
  let μ : Measure ((E3 × ℝ) × ModelE5) :=
    (cubeScaleMeasure.restrict (collectionRegion α S)).prod volume
  let A : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelFirstFiber α f q.1.1 q.1.2 q.2
  let W : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelEnergyDensity α u q.1.1 q.1.2 q.2
  let M : ℝ := (B0 * B1 * B2) * ∫ v : ℝ, |gaussianDeriv v|
  have hM : 0 ≤ M := by
    dsimp only [M]
    exact mul_nonneg (mul_nonneg (mul_nonneg hB0 hB1) hB2)
      (integral_nonneg fun v ↦ abs_nonneg (gaussianDeriv v))
  have hAmeas : AEStronglyMeasurable A μ := by
    simpa only [A] using
      scratch_aestronglyMeasurable_modelFirstFiber α f hfcont μ
  have hWmeas : AEStronglyMeasurable W μ := by
    simpa only [W] using scratch_aestronglyMeasurable_modelEnergyDensity α u μ
  have hWint : Integrable W μ := by
    simpa only [μ, W] using hweightint
  have hWnonneg : ∀ᵐ q ∂μ, 0 ≤ W q := by
    simpa only [μ, W] using
      scratch_ae_modelEnergyDensity_nonneg_collection α S u
  have hAbound : ∀ᵐ q ∂μ, |A q| ≤ M := by
    simpa only [μ, A, M] using
      scratch_ae_abs_modelFirstFiber_le_collection α S f hfcont B0 B1 B2
        hB0 hB1 hB2 hf0 hf1 hf2
  have hweighted := scratch_squareRootWeighted_integrable_of_ae_bound
    μ A W hAmeas hWmeas hWint hWnonneg M hM hAbound
  change Integrable (fun q ↦ (|A q| * √(W q)) ^ 2) μ
  exact hweighted.2

/-- The corresponding density-to-square-integrability step for the second
weighted fiber. -/
theorem scratch_integrable_modelSecondWeightedFactor_sq_of_density
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : E3 → ℝ)
    (hfcont : Continuous f) (B : ℝ) (hB : 0 ≤ B) (hf : ∀ y, |f y| ≤ B)
    (hweightint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5))) :
    Integrable (fun q ↦ (scratch_modelSecondWeightedFactor α u f q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)) := by
  let μ : Measure ((E3 × ℝ) × ModelE5) :=
    (cubeScaleMeasure.restrict (collectionRegion α S)).prod volume
  let A : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelSecondFiber α f q.1.1 q.1.2 q.2
  let W : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelEnergyDensity α u q.1.1 q.1.2 q.2
  let M : ℝ := B * ∫ v : ℝ, |gaussianDeriv v|
  have hM : 0 ≤ M := by
    dsimp only [M]
    exact mul_nonneg hB (integral_nonneg fun v ↦ abs_nonneg (gaussianDeriv v))
  have hAmeas : AEStronglyMeasurable A μ := by
    simpa only [A] using
      scratch_aestronglyMeasurable_modelSecondFiber α f hfcont μ
  have hWmeas : AEStronglyMeasurable W μ := by
    simpa only [W] using scratch_aestronglyMeasurable_modelEnergyDensity α u μ
  have hWint : Integrable W μ := by
    simpa only [μ, W] using hweightint
  have hWnonneg : ∀ᵐ q ∂μ, 0 ≤ W q := by
    simpa only [μ, W] using
      scratch_ae_modelEnergyDensity_nonneg_collection α S u
  have hAbound : ∀ᵐ q ∂μ, |A q| ≤ M := by
    simpa only [μ, A, M] using
      scratch_ae_abs_modelSecondFiber_le_collection α S f hfcont B hB hf
  have hweighted := scratch_squareRootWeighted_integrable_of_ae_bound
    μ A W hAmeas hWmeas hWint hWnonneg M hM hAbound
  change Integrable (fun q ↦ (|A q| * √(W q)) ^ 2) μ
  exact hweighted.2

/-- Fubini turns the literal iterated signed-density local form into its
single product-space integral, once absolute integrability is available. -/
theorem scratch_expandedModelLocalForm_eq_neg_jointIntegral_of_integrable
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      c q.1.2 *
        (modelFirstFiber α f q.1.1 q.1.2 q.2 *
          modelSecondFiber α (f 3) q.1.1 q.1.2 q.2 *
            modelSignedDensity α u q.1.1 q.1.2 q.2))
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)) :
    expandedModelLocalForm α S u c f =
      -(∫ q : (E3 × ℝ) × ModelE5,
        c q.1.2 *
          (modelFirstFiber α f q.1.1 q.1.2 q.2 *
            modelSecondFiber α (f 3) q.1.1 q.1.2 q.2 *
              modelSignedDensity α u q.1.1 q.1.2 q.2)
        ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)) := by
  letI : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  unfold expandedModelLocalForm
  calc
    -(∫ pt : E3 × ℝ,
        c pt.2 * (∫ z : ModelE5,
          modelFirstFiber α f pt.1 pt.2 z *
            modelSecondFiber α (f 3) pt.1 pt.2 z *
              modelSignedDensity α u pt.1 pt.2 z)
        ∂(cubeScaleMeasure.restrict (collectionRegion α S))) =
        -(∫ pt : E3 × ℝ,
          (∫ z : ModelE5,
            c pt.2 *
              (modelFirstFiber α f pt.1 pt.2 z *
                modelSecondFiber α (f 3) pt.1 pt.2 z *
                  modelSignedDensity α u pt.1 pt.2 z))
          ∂(cubeScaleMeasure.restrict (collectionRegion α S))) := by
      congr 1
      apply integral_congr_ae
      filter_upwards [] with pt
      rw [← integral_const_mul]
    _ = _ := by
      simpa only using congrArg Neg.neg (MeasureTheory.integral_prod _ hjoint).symm

/-- The first energy is the corresponding product-space integral under the
joint integrability hypothesis supplied by localization. -/
theorem scratch_modelEnergyOne_eq_jointIntegral_of_integrable
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : ModelRealInput)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      (modelFirstFiber α f q.1.1 q.1.2 q.2) ^ 2 *
        modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)) :
    modelEnergyOne α S u f =
      ∫ q : (E3 × ℝ) × ModelE5,
        (modelFirstFiber α f q.1.1 q.1.2 q.2) ^ 2 *
          modelEnergyDensity α u q.1.1 q.1.2 q.2
        ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume) := by
  letI : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  unfold modelEnergyOne
  simpa only using (MeasureTheory.integral_prod _ hjoint).symm

/-- The second finite-collection energy has the same joint-integral form. -/
theorem scratch_modelEnergyTwo_eq_jointIntegral_of_integrable
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (f : E3 → ℝ)
    (hjoint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      (modelSecondFiber α f q.1.1 q.1.2 q.2) ^ 2 *
        modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)) :
    modelEnergyTwo α S u f =
      ∫ q : (E3 × ℝ) × ModelE5,
        (modelSecondFiber α f q.1.1 q.1.2 q.2) ^ 2 *
          modelEnergyDensity α u q.1.1 q.1.2 q.2
        ∂((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume) := by
  letI : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  unfold modelEnergyTwo modelEnergyTwoOn
  simpa only using (MeasureTheory.integral_prod _ hjoint).symm

/-- The literal first local Cauchy--Schwarz inequality.  Its hypotheses are
precisely the joint measurability and square-integrability assertions supplied
by the bounded-continuous localization package; no Fubini equality is left as
an assumption. -/
theorem scratch_expandedModelLocalForm_cauchySchwarz_of_weightedIntegrable
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput)
    (hsignedmeas : AEStronglyMeasurable
      (scratch_modelSignedIntegrand α u c f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hfirstmeas : AEStronglyMeasurable
      (scratch_modelFirstWeightedFactor α u f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hsecondmeas : AEStronglyMeasurable
      (scratch_modelSecondWeightedFactor α u (f 3))
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hfirstint : Integrable
      (fun q ↦ (scratch_modelFirstWeightedFactor α u f q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hsecondint : Integrable
      (fun q ↦ (scratch_modelSecondWeightedFactor α u (f 3) q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    |expandedModelLocalForm α S u c f| ^ 2 ≤
      modelEnergyOne α S u f * modelEnergyTwo α S u (f 3) := by
  letI : SFinite cubeScaleMeasure := by
    change SFinite ((volume : Measure E3).prod
      ((volume : Measure ℝ).withDensity cubeScaleDensity))
    infer_instance
  let μ : Measure ((E3 × ℝ) × ModelE5) :=
    (cubeScaleMeasure.restrict (collectionRegion α S)).prod volume
  let A : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelFirstFiber α f q.1.1 q.1.2 q.2
  let B : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelSecondFiber α (f 3) q.1.1 q.1.2 q.2
  let C : (E3 × ℝ) × ModelE5 → ℝ := fun q ↦ c q.1.2
  let σ : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelSignedDensity α u q.1.1 q.1.2 q.2
  let W : (E3 × ℝ) × ModelE5 → ℝ :=
    fun q ↦ modelEnergyDensity α u q.1.1 q.1.2 q.2
  have hW : ∀ᵐ q ∂μ, 0 ≤ W q := by
    simpa only [μ, W] using
      scratch_ae_modelEnergyDensity_nonneg_collection α S u
  have hσ : ∀ᵐ q ∂μ, |σ q| = W q := by
    simpa only [μ, σ, W] using
      scratch_ae_abs_modelSignedDensity_collection α S u
  have hC : ∀ᵐ q ∂μ, |C q| ≤ 1 :=
    Filter.Eventually.of_forall fun q ↦ hc q.1.2
  have hsignedmeas' : AEStronglyMeasurable
      (fun q ↦ C q * (A q * B q * σ q)) μ := by
    change AEStronglyMeasurable (scratch_modelSignedIntegrand α u c f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)
    exact hsignedmeas
  have hfirstmeas' : AEStronglyMeasurable
      (fun q ↦ |A q| * √(W q)) μ := by
    change AEStronglyMeasurable (scratch_modelFirstWeightedFactor α u f)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)
    exact hfirstmeas
  have hsecondmeas' : AEStronglyMeasurable
      (fun q ↦ |B q| * √(W q)) μ := by
    change AEStronglyMeasurable (scratch_modelSecondWeightedFactor α u (f 3))
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)
    exact hsecondmeas
  have hfirstint' : Integrable (fun q ↦ (|A q| * √(W q)) ^ 2) μ := by
    change Integrable (fun q ↦ (scratch_modelFirstWeightedFactor α u f q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)
    exact hfirstint
  have hsecondint' : Integrable (fun q ↦ (|B q| * √(W q)) ^ 2) μ := by
    change Integrable
      (fun q ↦ (scratch_modelSecondWeightedFactor α u (f 3) q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume)
    exact hsecondint
  have hsignedint' : Integrable (fun q ↦ C q * (A q * B q * σ q)) μ :=
    scratch_integrable_signedDensity_of_weighted μ A B C σ W hsignedmeas'
      hfirstmeas' hsecondmeas' hfirstint' hsecondint' hC hW hσ
  have hfirstEnergyInt : Integrable
      (scratch_modelEnergyOneIntegrand α u f) μ := by
    exact hfirstint.congr (scratch_ae_modelFirstWeightedFactor_sq α S u f)
  have hsecondEnergyInt : Integrable
      (scratch_modelEnergyTwoIntegrand α u (f 3)) μ := by
    exact hsecondint.congr
      (scratch_ae_modelSecondWeightedFactor_sq α S u (f 3))
  have hform : expandedModelLocalForm α S u c f =
      -(∫ q : (E3 × ℝ) × ModelE5,
        C q * (A q * B q * σ q) ∂μ) := by
    simpa [μ, A, B, C, σ, scratch_modelSignedIntegrand] using
      scratch_expandedModelLocalForm_eq_neg_jointIntegral_of_integrable α S u c f
        (by simpa [μ, A, B, C, σ, scratch_modelSignedIntegrand]
          using hsignedint')
  have henergyOne : modelEnergyOne α S u f =
      ∫ q : (E3 × ℝ) × ModelE5,
        scratch_modelEnergyOneIntegrand α u f q ∂μ := by
    unfold modelEnergyOne
    change (∫ pt : E3 × ℝ,
      (∫ z : ModelE5,
        scratch_modelEnergyOneIntegrand α u f (pt, z))
      ∂(cubeScaleMeasure.restrict (collectionRegion α S))) =
        ∫ q : (E3 × ℝ) × ModelE5,
          scratch_modelEnergyOneIntegrand α u f q ∂μ
    simpa only [μ] using
      (MeasureTheory.integral_prod (scratch_modelEnergyOneIntegrand α u f)
        hfirstEnergyInt).symm
  have henergyTwo : modelEnergyTwo α S u (f 3) =
      ∫ q : (E3 × ℝ) × ModelE5,
        scratch_modelEnergyTwoIntegrand α u (f 3) q ∂μ := by
    unfold modelEnergyTwo modelEnergyTwoOn
    change (∫ pt : E3 × ℝ,
      (∫ z : ModelE5,
        scratch_modelEnergyTwoIntegrand α u (f 3) (pt, z))
      ∂(cubeScaleMeasure.restrict (collectionRegion α S))) =
        ∫ q : (E3 × ℝ) × ModelE5,
          scratch_modelEnergyTwoIntegrand α u (f 3) q ∂μ
    simpa only [μ] using
      (MeasureTheory.integral_prod (scratch_modelEnergyTwoIntegrand α u (f 3))
        hsecondEnergyInt).symm
  have hcs := scratch_signedDensity_weighted_cauchySchwarz μ A B C σ W
    hsignedmeas' hfirstmeas' hsecondmeas' hfirstint' hsecondint' hC hW hσ
  have hfirstSquare :
      (∫ q : (E3 × ℝ) × ModelE5,
        (scratch_modelFirstWeightedFactor α u f q) ^ 2 ∂μ) =
      ∫ q : (E3 × ℝ) × ModelE5,
        scratch_modelEnergyOneIntegrand α u f q ∂μ := by
    exact integral_congr_ae (scratch_ae_modelFirstWeightedFactor_sq α S u f)
  have hsecondSquare :
      (∫ q : (E3 × ℝ) × ModelE5,
        (scratch_modelSecondWeightedFactor α u (f 3) q) ^ 2 ∂μ) =
      ∫ q : (E3 × ℝ) × ModelE5,
        scratch_modelEnergyTwoIntegrand α u (f 3) q ∂μ := by
    exact integral_congr_ae
      (scratch_ae_modelSecondWeightedFactor_sq α S u (f 3))
  calc
    |expandedModelLocalForm α S u c f| ^ 2 =
        |∫ q : (E3 × ℝ) × ModelE5, C q * (A q * B q * σ q) ∂μ| ^ 2 := by
      rw [hform, abs_neg]
    _ ≤ (∫ q : (E3 × ℝ) × ModelE5,
          (scratch_modelFirstWeightedFactor α u f q) ^ 2 ∂μ) *
        ∫ q : (E3 × ℝ) × ModelE5,
          (scratch_modelSecondWeightedFactor α u (f 3) q) ^ 2 ∂μ := by
      simpa only [A, B, W, scratch_modelFirstWeightedFactor,
        scratch_modelSecondWeightedFactor] using hcs
    _ = (∫ q : (E3 × ℝ) × ModelE5,
          scratch_modelEnergyOneIntegrand α u f q ∂μ) *
        ∫ q : (E3 × ℝ) × ModelE5,
          scratch_modelEnergyTwoIntegrand α u (f 3) q ∂μ := by
      rw [hfirstSquare, hsecondSquare]
    _ = modelEnergyOne α S u f * modelEnergyTwo α S u (f 3) := by
      rw [← henergyOne, ← henergyTwo]

/-- The conditional local Cauchy--Schwarz theorem with all measurability
premises discharged from continuous inputs and a measurable multiplier. -/
theorem scratch_expandedModelLocalForm_cauchySchwarz_of_continuous_weighted
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (hcmeas : Measurable c)
    (hfcont : ∀ j, Continuous (f j))
    (hfirstint : Integrable
      (fun q ↦ (scratch_modelFirstWeightedFactor α u f q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hsecondint : Integrable
      (fun q ↦ (scratch_modelSecondWeightedFactor α u (f 3) q) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    |expandedModelLocalForm α S u c f| ^ 2 ≤
      modelEnergyOne α S u f * modelEnergyTwo α S u (f 3) := by
  exact scratch_expandedModelLocalForm_cauchySchwarz_of_weightedIntegrable
    α S u c f
    (scratch_aestronglyMeasurable_modelSignedIntegrand α u c f hcmeas hfcont
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume))
    (scratch_aestronglyMeasurable_modelFirstWeightedFactor α u f hfcont
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume))
    (scratch_aestronglyMeasurable_modelSecondWeightedFactor α u (f 3)
      (hfcont 3) ((cubeScaleMeasure.restrict (collectionRegion α S)).prod volume))
    hfirstint hsecondint hc

/-- The bounded-continuous local Cauchy--Schwarz theorem, reduced only to the
finite-collection integrability of the positive model density. -/
theorem scratch_expandedModelLocalForm_cauchySchwarz_of_boundedContinuous_of_density
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (hcmeas : Measurable c)
    (hfcont : ∀ j, Continuous (f j))
    (B0 B1 B2 B3 : ℝ)
    (hB0 : 0 ≤ B0) (hB1 : 0 ≤ B1) (hB2 : 0 ≤ B2) (hB3 : 0 ≤ B3)
    (hf0 : ∀ y, |f 0 y| ≤ B0) (hf1 : ∀ y, |f 1 y| ≤ B1)
    (hf2 : ∀ y, |f 2 y| ≤ B2) (hf3 : ∀ y, |f 3 y| ≤ B3)
    (hweightint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    |expandedModelLocalForm α S u c f| ^ 2 ≤
      modelEnergyOne α S u f * modelEnergyTwo α S u (f 3) := by
  apply scratch_expandedModelLocalForm_cauchySchwarz_of_continuous_weighted
    α S u c f hcmeas hfcont
  · exact scratch_integrable_modelFirstWeightedFactor_sq_of_density
      α S u f hfcont B0 B1 B2 hB0 hB1 hB2 hf0 hf1 hf2 hweightint
  · exact scratch_integrable_modelSecondWeightedFactor_sq_of_density
      α S u (f 3) (hfcont 3) B3 hB3 hf3 hweightint
  · exact hc

/-- Existential uniform bounds in the standard local-form input hypothesis
feed directly into the bounded-continuous Cauchy--Schwarz theorem. -/
theorem scratch_expandedModelLocalForm_cauchySchwarz_of_boundedContinuous
    (α : Anisotropy) (S : BoxCollection α) (u : E3) (c : ℝ → ℝ)
    (f : ModelRealInput) (hcmeas : Measurable c)
    (hfcont : ∀ j, Continuous (f j))
    (hfbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B)
    (hweightint : Integrable (fun q : (E3 × ℝ) × ModelE5 ↦
      modelEnergyDensity α u q.1.1 q.1.2 q.2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        (volume : Measure ModelE5)))
    (hc : ∀ t : ℝ, |c t| ≤ 1) :
    |expandedModelLocalForm α S u c f| ^ 2 ≤
      modelEnergyOne α S u f * modelEnergyTwo α S u (f 3) := by
  rcases hfbound 0 with ⟨B0, hB0, hf0⟩
  rcases hfbound 1 with ⟨B1, hB1, hf1⟩
  rcases hfbound 2 with ⟨B2, hB2, hf2⟩
  rcases hfbound 3 with ⟨B3, hB3, hf3⟩
  exact scratch_expandedModelLocalForm_cauchySchwarz_of_boundedContinuous_of_density
    α S u c f hcmeas hfcont B0 B1 B2 B3 hB0 hB1 hB2 hB3
      hf0 hf1 hf2 hf3 hweightint hc


end

