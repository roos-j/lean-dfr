      (Astop : FiberDyadicInterval → TransverseSpace m → ℝ) (H : ℝ)
      (T : Finset FiberDyadicInterval) (B : Fin 3 → ℝ) (A : ℝ)
      (j₁ j₂ : Fin 3),
      (∀ F : Fin 3 → ℝ, (∏ j ∈ Finset.univ.erase m, F j) = F j₁ * F j₂) →
      0 < a → 0 < lam → 0 ≤ A → Measurable c → (∀ t : ℝ, |c t| ≤ 1) →
      (∀ jj, Measurable (f jj)) → (∀ jj, 0 ≤ B jj) →
