      ∀ j, 0 ≤ (fun i ↦ if i = m then Bw else Bf i) j := by
    intro Bw hBw j
    by_cases hj : j = m
    · simp only [hj]; exact hBw
    · simp only [ite_eq_right hj]; exact hBf0 j
