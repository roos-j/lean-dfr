in the bad-fiber tail estimate. -/
alias integral_scaleBracketKernelAt_eq_inverseSquare :=
  ScaleTailInternal.scratch_integral_Ioi_scale_bracketKernelAt

/-- Integrability of the normalized scalar bracket-kernel scale tail. -/
alias integrableOn_scaleBracketKernelAt :=
  ScaleTailInternal.scratch_integrableOn_Ioi_scale_bracketKernelAt

