/-- One low-frequency model factor and its normalized Gaussian partner are
jointly integrable in their center and spatial variables. -/
theorem integrable_modelPhi_gaussian_pair
    (s c x : ℝ) (hs : 0 < s) :
    Integrable (fun z : ℝ × ℝ ↦
      |modelPhiAt s (z.1 + c) x| * gaussianAt s z.1 z.2)
      ((volume : Measure ℝ).prod volume) := by
  have hphi_meas : Measurable (fun z : ℝ × ℝ ↦
      modelPhiAt s (z.1 + c) x) := by
    unfold modelPhiAt
    apply measurable_kernelAt conePhiPhysicalReal
      conePhiPhysicalReal.continuous.measurable
    · exact measurable_const
    · exact measurable_fst.add measurable_const
    · exact measurable_const
  have hgauss_meas : Measurable (fun z : ℝ × ℝ ↦
      gaussianAt s z.1 z.2) := by
    unfold gaussianAt
    apply measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable
    · exact measurable_const
    · exact measurable_fst
    · exact measurable_snd
  have hmeas : AEStronglyMeasurable (fun z : ℝ × ℝ ↦
      |modelPhiAt s (z.1 + c) x| * gaussianAt s z.1 z.2)
      ((volume : Measure ℝ).prod volume) := by
    have hphi_abs : AEStronglyMeasurable (fun z : ℝ × ℝ ↦
        |modelPhiAt s (z.1 + c) x|) ((volume : Measure ℝ).prod volume) := by
      simpa only [Real.norm_eq_abs] using hphi_meas.aestronglyMeasurable.norm
    exact hphi_abs.mul hgauss_meas.aestronglyMeasurable
  refine (integrable_prod_iff hmeas).mpr ⟨?_, ?_⟩
  · filter_upwards [] with p
    have hgauss : Integrable (gaussianAt s p) := integrable_gaussianAt hs p
    simpa only using hgauss.const_mul |modelPhiAt s (p + c) x|
  · have hphi : Integrable (fun p : ℝ ↦ |modelPhiAt s (p + c) x|) := by
      apply (integrable_abs_modelPhiAt hs (x - c)).congr
      filter_upwards [] with p
      symm
      unfold modelPhiAt kernelAt kernelDilate
      simp only [smul_eq_mul, abs_mul]
      congr 1
      rw [show (x - (p + c)) / s = -((p - (x - c)) / s) by ring,
        conePhiPhysicalReal_even]
    apply hphi.congr
    filter_upwards [] with p
    have hnonneg (y : ℝ) : 0 ≤ gaussianAt s p y := by
      unfold gaussianAt kernelAt kernelDilate
      exact mul_nonneg (inv_pos.mpr hs).le (gaussian_nonneg _)
    symm
    calc
      (∫ y : ℝ, ‖|modelPhiAt s (p + c) x| * gaussianAt s p y‖) =
          ∫ y : ℝ, |modelPhiAt s (p + c) x| * gaussianAt s p y := by
            apply integral_congr_ae
            filter_upwards [] with y
            rw [Real.norm_eq_abs, abs_of_nonneg]
            exact mul_nonneg (abs_nonneg _) (hnonneg y)
      _ = |modelPhiAt s (p + c) x| * ∫ y : ℝ, gaussianAt s p y := by
            rw [integral_const_mul]
      _ = |modelPhiAt s (p + c) x| := by
            rw [integral_gaussianAt hs p]
            ring

