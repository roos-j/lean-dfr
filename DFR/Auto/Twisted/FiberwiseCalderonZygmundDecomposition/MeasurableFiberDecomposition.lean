/-! ### Assembly of the finite scale-tail and disjoint-pairing terminals -/

/-- A bounded measurable fiber weighted by the canonical doubled interval
tail is integrable. This identifies the canonical tail with the exponent-two
tail used in the dyadic maximal comparison. -/
theorem scratchAssembly_integrable_intervalTail_weighted
    (G : FiberDyadicBase × FiberDyadicLine → ℂ) (hG : Measurable G)
    (a : ℝ) (hGa : ∀ q, ‖G q‖ ≤ a)
    (z : FiberDyadicBase) {c r : ℝ} (hr : 0 < r) :
    Integrable (fun x : FiberDyadicLine =>
      ‖G (z, x)‖ * intervalTail c (2 * r)
        (realToFiberDyadicLine.symm x)) := by
  let q : FiberDyadicBase × FiberDyadicLine :=
    (z, realToFiberDyadicLine c)
  have hdouble : 0 < 2 * r := by positivity
  have hbase := scratchLp_integrable_weighted_fiberTailTwo
    G hG a hGa q (r := 2 * r) hdouble
  have htail (x : FiberDyadicLine) :
      intervalTail c (2 * r) (realToFiberDyadicLine.symm x) =
        scratchLp_fiberTailTwo ((2 * r)⁻¹ • (x - q.2)) := by
    change scratchLp_intervalTail c (2 * r)
      (realToFiberDyadicLine.symm x) = _
    rw [scratchLp_intervalTail_eq_fiberTailTwo c (2 * r)
      (realToFiberDyadicLine.symm x) hdouble]
    dsimp [q]
    simp
  refine hbase.congr ?_
  filter_upwards with x
  dsimp [q]
  rw [htail x]

/-- The finite bad-fiber scale tail, tested on any measurable spatial set
lying outside all doubled intervals, is controlled by the dyadic maximal
function over the disjoint interval union. This is the source's actual
finite dual-testing bridge between cancellation/scale integration and the
`1 < p < ∞` interval-tail estimate. -/
theorem scratchAssembly_finset_scaleTail_testing_le_fiberMaximal :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ {ι : Type*} (S : Finset ι)
      (i j : Fin 3) (u : E3) (α A : ℝ) (c r : ι → ℝ)
      (b : ι → ℝ → ℝ) (D : Set FiberDyadicLine),
      0 < α → 0 ≤ A → MeasurableSet D →
      (∀ k ∈ S, 0 < r k) →
      (∀ k ∈ S, Integrable (b k)) →
      (∀ q ∈ D, ∀ k ∈ S, ∀ t : ℝ, t ∈ Set.Ioi 0 →
        Integrable (fun y ↦ b k y *
          kernelDilate (activeModelKernel i j u) (t ^ α)
            (realToFiberDyadicLine.symm q - y))) →
      (∀ k ∈ S, (∫ y : ℝ, b k y) = 0) →
      (∀ k ∈ S, ∀ y : ℝ, b k y ≠ 0 → |y - c k| ≤ r k) →
      (∀ q ∈ D, ∀ k ∈ S,
        2 * r k ≤ |realToFiberDyadicLine.symm q - c k|) →
      (∀ k ∈ S, (∫ y : ℝ, |b k y|) ≤ A * r k) →
      ((↑S : Set ι).PairwiseDisjoint
        (fun k => Ioo (c k - r k) (c k + r k))) →
      ∀ (G : FiberDyadicBase × FiberDyadicLine → ℂ), Measurable G →
        ∀ a : ℝ, 0 ≤ a → (∀ q, ‖G q‖ ≤ a) →
        ∀ z : FiberDyadicBase,
        (∫ q in D, ‖G (z, q)‖ *
          (∑ k ∈ S, ∫ t : ℝ in Set.Ioi 0,
            |∫ y : ℝ, b k y *
              kernelDilate (activeModelKernel i j u) (t ^ α)
                (realToFiberDyadicLine.symm q - y)| * t⁻¹)) ≤
          (C * sourceWeight u ^ 10 * A * (α⁻¹ * (1 / 72))) *
            (64 * ∫ v in ⋃ k ∈ S, Ioo (c k - r k) (c k + r k),
              fiberDyadicBallMaximal G (z, realToFiberDyadicLine v) *
                (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) := by
  rcases scratch_finset_integral_badFiber_scaleTail_le_intervalTail_sum with
    ⟨C, hC, hscale⟩
  refine ⟨C, hC, ?_⟩
  intro ι S i j u α A c r b D hα hA hD hr hb hkernel hzero hsupport hfar
    hmass hdisj G hG a ha hGa z
  let K : ℝ := C * sourceWeight u ^ 10 * A * (α⁻¹ * (1 / 72))
  let B : FiberDyadicLine → ℝ := fun q ↦
    ∑ k ∈ S, ∫ t : ℝ in Set.Ioi 0,
      |∫ y : ℝ, b k y *
        kernelDilate (activeModelKernel i j u) (t ^ α)
          (realToFiberDyadicLine.symm q - y)| * t⁻¹
  let T : FiberDyadicLine → ℝ := fun q ↦
    ∑ k ∈ S, intervalTail (c k) (2 * r k)
      (realToFiberDyadicLine.symm q)
  have hK : 0 ≤ K := by
    dsimp [K]
    positivity
  have hB_nonneg (q : FiberDyadicLine) : 0 ≤ B q := by
    dsimp [B]
    apply Finset.sum_nonneg
    intro k hk
    change 0 ≤ ∫ t : ℝ,
      |∫ y : ℝ, b k y *
        kernelDilate (activeModelKernel i j u) (t ^ α)
          (realToFiberDyadicLine.symm q - y)| * t⁻¹
        ∂volume.restrict (Set.Ioi 0)
    apply integral_nonneg_of_ae
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    exact mul_nonneg (abs_nonneg _)
      (inv_nonneg.mpr (Set.mem_Ioi.mp ht).le)
  have hpoint (q : FiberDyadicLine) (hq : q ∈ D) :
      B q ≤ K * T q := by
    dsimp [B, T, K]
    simpa only using hscale S i j u α (realToFiberDyadicLine.symm q) A c r b
      hα hr hb
      (fun k hk t ht ↦ hkernel q hq k hk t ht)
      hzero hsupport
      (fun k hk ↦ hfar q hq k hk)
      hmass
  have hterm (k : ι) (hk : k ∈ S) :
      Integrable (fun q : FiberDyadicLine =>
        ‖G (z, q)‖ * intervalTail (c k) (2 * r k)
          (realToFiberDyadicLine.symm q)) :=
    scratchAssembly_integrable_intervalTail_weighted G hG a hGa z (hr k hk)
  let R : FiberDyadicLine → ℝ := fun q ↦ ‖G (z, q)‖ * T q
  have hR : Integrable R := by
    have hsum : Integrable (fun q : FiberDyadicLine =>
        ∑ k ∈ S, ‖G (z, q)‖ * intervalTail (c k) (2 * r k)
          (realToFiberDyadicLine.symm q)) :=
      integrable_finsetSum S (fun k hk ↦ hterm k hk)
    refine hsum.congr (Filter.Eventually.of_forall fun q ↦ ?_)
    dsimp [R, T]
    rw [Finset.mul_sum]
  have hR_nonneg (q : FiberDyadicLine) : 0 ≤ R q := by
    dsimp [R, T]
    apply mul_nonneg (norm_nonneg _)
    exact Finset.sum_nonneg fun k hk ↦ intervalTail_nonneg _ _ _
  have hKR_on : IntegrableOn (fun q : FiberDyadicLine =>
      ‖G (z, q)‖ * (K * T q)) D := by
    have hKR : Integrable (fun q : FiberDyadicLine => K * R q) :=
      hR.const_mul K
    refine hKR.integrableOn.congr_fun ?_ hD
    intro q hq
    dsimp [R, T]
    ring
  have hmono :
      (∫ q in D, ‖G (z, q)‖ * B q) ≤
        ∫ q in D, ‖G (z, q)‖ * (K * T q) := by
    apply integral_mono_of_nonneg
    · filter_upwards [ae_restrict_mem hD] with q hq
      exact mul_nonneg (norm_nonneg _) (hB_nonneg q)
    · exact hKR_on
    · filter_upwards [ae_restrict_mem hD] with q hq
      exact mul_le_mul_of_nonneg_left (hpoint q hq) (norm_nonneg _)
  have hpair :
      (∫ q : FiberDyadicLine, R q) ≤
        64 * (∫ v in ⋃ k ∈ S, Ioo (c k - r k) (c k + r k),
          fiberDyadicBallMaximal G (z, realToFiberDyadicLine v) *
            (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) := by
    calc
      (∫ q : FiberDyadicLine, R q) =
          ∑ k ∈ S, ∫ q : FiberDyadicLine,
            ‖G (z, q)‖ * intervalTail (c k) (2 * r k)
              (realToFiberDyadicLine.symm q) := by
        calc
          (∫ q : FiberDyadicLine, R q) =
              ∫ q : FiberDyadicLine, ∑ k ∈ S,
                ‖G (z, q)‖ * intervalTail (c k) (2 * r k)
                  (realToFiberDyadicLine.symm q) := by
            apply integral_congr_ae
            filter_upwards with q
            dsimp [R, T]
            rw [Finset.mul_sum]
          _ = ∑ k ∈ S, ∫ q : FiberDyadicLine,
              ‖G (z, q)‖ * intervalTail (c k) (2 * r k)
                (realToFiberDyadicLine.symm q) := by
            rw [integral_finsetSum S (fun k hk ↦ hterm k hk)]
      _ ≤ 64 * (∫ v in ⋃ k ∈ S, Ioo (c k - r k) (c k + r k),
          fiberDyadicBallMaximal G (z, realToFiberDyadicLine v) *
            (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) := by
        simpa only [intervalTail, scratchLp_intervalTail] using
          (scratchLp_finset_pairwiseDisjoint_intervalTail_pairing_le
            S c r hr hdisj G hG a ha hGa z)
  calc
    (∫ q in D, ‖G (z, q)‖ * B q) ≤
        ∫ q in D, ‖G (z, q)‖ * (K * T q) := hmono
    _ = K * (∫ q in D, R q) := by
      rw [show (fun q : FiberDyadicLine ↦ ‖G (z, q)‖ * (K * T q)) =
          fun q ↦ K * R q by
        funext q
        dsimp [R]
        ring, integral_const_mul]
    _ ≤ K * (∫ q : FiberDyadicLine, R q) := by
      exact mul_le_mul_of_nonneg_left
        (setIntegral_le_integral hR (Filter.Eventually.of_forall hR_nonneg)) hK
    _ ≤ K * (64 * ∫ v in ⋃ k ∈ S, Ioo (c k - r k) (c k + r k),
        fiberDyadicBallMaximal G (z, realToFiberDyadicLine v) *
          (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) :=
      mul_le_mul_of_nonneg_left hpair hK

/-- The preceding finite scale-tail test specialized to a single line. It
uses exactly the line dyadic maximal operator that closes the finite
`L^p` cutoff-duality calculation. -/
theorem scratchAssembly_finset_scaleTail_lineTesting_le_dyadicMaximal :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ {ι : Type*} (S : Finset ι)
      (i j : Fin 3) (u : E3) (α A : ℝ) (c r : ι → ℝ)
      (b : ι → ℝ → ℝ) (D : Set FiberDyadicLine),
      0 < α → 0 ≤ A → MeasurableSet D →
      (∀ k ∈ S, 0 < r k) →
      (∀ k ∈ S, Integrable (b k)) →
      (∀ q ∈ D, ∀ k ∈ S, ∀ t : ℝ, t ∈ Set.Ioi 0 →
        Integrable (fun y ↦ b k y *
          kernelDilate (activeModelKernel i j u) (t ^ α)
            (realToFiberDyadicLine.symm q - y))) →
      (∀ k ∈ S, (∫ y : ℝ, b k y) = 0) →
      (∀ k ∈ S, ∀ y : ℝ, b k y ≠ 0 → |y - c k| ≤ r k) →
      (∀ q ∈ D, ∀ k ∈ S,
        2 * r k ≤ |realToFiberDyadicLine.symm q - c k|) →
      (∀ k ∈ S, (∫ y : ℝ, |b k y|) ≤ A * r k) →
      ((↑S : Set ι).PairwiseDisjoint
        (fun k => Ioo (c k - r k) (c k + r k))) →
      ∀ (g : FiberDyadicLine → ℂ), Measurable g →
        ∀ a : ℝ, 0 ≤ a → (∀ q, ‖g q‖ ≤ a) →
        (∫ q in D, ‖g q‖ *
          (∑ k ∈ S, ∫ t : ℝ in Set.Ioi 0,
            |∫ y : ℝ, b k y *
              kernelDilate (activeModelKernel i j u) (t ^ α)
                (realToFiberDyadicLine.symm q - y)| * t⁻¹)) ≤
          (C * sourceWeight u ^ 10 * A * (α⁻¹ * (1 / 72))) *
            (64 * ∫ v in ⋃ k ∈ S, Ioo (c k - r k) (c k + r k),
              dyadicBallMaximal 1 g (realToFiberDyadicLine v) *
                (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) := by
  rcases scratchAssembly_finset_scaleTail_testing_le_fiberMaximal with
    ⟨C, hC, hmain⟩
  refine ⟨C, hC, ?_⟩
  intro ι S i j u α A c r b D hα hA hD hr hb hkernel hzero hsupport hfar
    hmass hdisj g hg a ha hga
  let G : FiberDyadicBase × FiberDyadicLine → ℂ := fun q ↦ g q.2
  have hG : Measurable G := hg.comp measurable_snd
  have hGa : ∀ q, ‖G q‖ ≤ a := by
    intro q
    exact hga q.2
  have h := hmain S i j u α A c r b D hα hA hD hr hb hkernel hzero hsupport
    hfar hmass hdisj G hG a ha hGa (0 : FiberDyadicBase)
  simpa [G, fiberDyadicBallMaximal] using h

/-- Finite scale-integrated bad-fiber cancellation, paired with a bounded
`L^q` line cutoff, obeys the exact Hölder endpoint used in the source
interval-tail argument. This composes the literal scale calculation with
the checked disjoint-tail/strong-maximal cutoff theorem. -/
theorem scratchAssembly_finset_scaleTail_holder_cutoff_le :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ {ι : Type*} (S : Finset ι)
      (i j : Fin 3) (u : E3) (α A : ℝ) (c r : ι → ℝ)
      (b : ι → ℝ → ℝ) (D : Set FiberDyadicLine),
      0 < α → 0 ≤ A → MeasurableSet D →
      (∀ k ∈ S, 0 < r k) →
      (∀ k ∈ S, Integrable (b k)) →
      (∀ q ∈ D, ∀ k ∈ S, ∀ t : ℝ, t ∈ Set.Ioi 0 →
        Integrable (fun y ↦ b k y *
          kernelDilate (activeModelKernel i j u) (t ^ α)
            (realToFiberDyadicLine.symm q - y))) →
      (∀ k ∈ S, (∫ y : ℝ, b k y) = 0) →
      (∀ k ∈ S, ∀ y : ℝ, b k y ≠ 0 → |y - c k| ≤ r k) →
      (∀ q ∈ D, ∀ k ∈ S,
        2 * r k ≤ |realToFiberDyadicLine.symm q - c k|) →
      (∀ k ∈ S, (∫ y : ℝ, |b k y|) ≤ A * r k) →
      ((↑S : Set ι).PairwiseDisjoint
        (fun k => Ioo (c k - r k) (c k + r k))) →
      ∀ {p q : ℝ}, q.HolderConjugate p → 1 < q →
        ∀ (g : FiberDyadicLine → ℂ), Measurable g →
        ∀ a : ℝ, 0 ≤ a → (∀ q, ‖g q‖ ≤ a) →
        MemLp g (ENNReal.ofReal q) volume →
        (∫ q in D, ‖g q‖ *
          (∑ k ∈ S, ∫ t : ℝ in Set.Ioi 0,
            |∫ y : ℝ, b k y *
              kernelDilate (activeModelKernel i j u) (t ^ α)
                (realToFiberDyadicLine.symm q - y)| * t⁻¹)) ≤
          (C * sourceWeight u ^ 10 * A * (α⁻¹ * (1 / 72))) *
            (64 * (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal *
              (∫ v in ⋃ k ∈ S, Ioo (c k - r k) (c k + r k),
                (dyadicBallMaximal 1 g (realToFiberDyadicLine v)) ^ q) ^ (1 / q) *
              (volume (⋃ k ∈ S, Ioo (c k - r k) (c k + r k))).toReal ^ (1 / p)) := by
  rcases scratch_finset_integral_badFiber_scaleTail_le_intervalTail_sum with
    ⟨C, hC, hscale⟩
  refine ⟨C, hC, ?_⟩
  intro ι S i j u α A c r b D hα hA hD hr hb hkernel hzero hsupport hfar
    hmass hdisj p q hpq hq g hg a ha hga hgp
  let K : ℝ := C * sourceWeight u ^ 10 * A * (α⁻¹ * (1 / 72))
  let B : FiberDyadicLine → ℝ := fun x ↦
    ∑ k ∈ S, ∫ t : ℝ in Set.Ioi 0,
      |∫ y : ℝ, b k y *
        kernelDilate (activeModelKernel i j u) (t ^ α)
          (realToFiberDyadicLine.symm x - y)| * t⁻¹
  let T : FiberDyadicLine → ℝ := fun x ↦
    ∑ k ∈ S, intervalTail (c k) (2 * r k)
      (realToFiberDyadicLine.symm x)
  have hK : 0 ≤ K := by
    dsimp [K]
    positivity
  have hB_nonneg (x : FiberDyadicLine) : 0 ≤ B x := by
    dsimp [B]
    apply Finset.sum_nonneg
    intro k hk
    change 0 ≤ ∫ t : ℝ,
      |∫ y : ℝ, b k y *
        kernelDilate (activeModelKernel i j u) (t ^ α)
          (realToFiberDyadicLine.symm x - y)| * t⁻¹
        ∂volume.restrict (Set.Ioi 0)
    apply integral_nonneg_of_ae
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    exact mul_nonneg (abs_nonneg _)
      (inv_nonneg.mpr (Set.mem_Ioi.mp ht).le)
  have hpoint (x : FiberDyadicLine) (hx : x ∈ D) : B x ≤ K * T x := by
    dsimp [B, T, K]
    simpa only using hscale S i j u α (realToFiberDyadicLine.symm x) A c r b
      hα hr hb
      (fun k hk t ht ↦ hkernel x hx k hk t ht)
      hzero hsupport
      (fun k hk ↦ hfar x hx k hk)
      hmass
  let G : FiberDyadicBase × FiberDyadicLine → ℂ := fun x ↦ g x.2
  have hG : Measurable G := hg.comp measurable_snd
  have hGa : ∀ x, ‖G x‖ ≤ a := by
    intro x
    exact hga x.2
  have hterm (k : ι) (hk : k ∈ S) :
      Integrable (fun x : FiberDyadicLine =>
        ‖g x‖ * intervalTail (c k) (2 * r k)
          (realToFiberDyadicLine.symm x)) := by
    simpa [G] using scratchAssembly_integrable_intervalTail_weighted
      G hG a hGa (0 : FiberDyadicBase) (hr k hk)
  let R : FiberDyadicLine → ℝ := fun x ↦ ‖g x‖ * T x
  have hR : Integrable R := by
    have hsum : Integrable (fun x : FiberDyadicLine =>
        ∑ k ∈ S, ‖g x‖ * intervalTail (c k) (2 * r k)
          (realToFiberDyadicLine.symm x)) :=
      integrable_finsetSum S (fun k hk ↦ hterm k hk)
    refine hsum.congr (Filter.Eventually.of_forall fun x ↦ ?_)
    dsimp [R, T]
    rw [Finset.mul_sum]
  have hR_nonneg (x : FiberDyadicLine) : 0 ≤ R x := by
    dsimp [R, T]
    apply mul_nonneg (norm_nonneg _)
    exact Finset.sum_nonneg fun k hk ↦ intervalTail_nonneg _ _ _
  have hKR_on : IntegrableOn (fun x : FiberDyadicLine =>
      ‖g x‖ * (K * T x)) D := by
    have hKR : Integrable (fun x : FiberDyadicLine => K * R x) :=
      hR.const_mul K
    refine hKR.integrableOn.congr_fun ?_ hD
    intro x hx
    dsimp [R, T]
    ring
  have hmono :
      (∫ x in D, ‖g x‖ * B x) ≤
        ∫ x in D, ‖g x‖ * (K * T x) := by
    apply integral_mono_of_nonneg
    · filter_upwards [ae_restrict_mem hD] with x hx
      exact mul_nonneg (norm_nonneg _) (hB_nonneg x)
    · exact hKR_on
    · filter_upwards [ae_restrict_mem hD] with x hx
      exact mul_le_mul_of_nonneg_left (hpoint x hx) (norm_nonneg _)
  have htail :
      (∫ x : FiberDyadicLine, R x) ≤
        64 * (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal *
          (∫ v in ⋃ k ∈ S, Ioo (c k - r k) (c k + r k),
            (dyadicBallMaximal 1 g (realToFiberDyadicLine v)) ^ q) ^ (1 / q) *
          (volume (⋃ k ∈ S, Ioo (c k - r k) (c k + r k))).toReal ^ (1 / p) := by
    calc
      (∫ x : FiberDyadicLine, R x) =
          ∑ k ∈ S, ∫ x : FiberDyadicLine,
            ‖g x‖ * intervalTail (c k) (2 * r k)
              (realToFiberDyadicLine.symm x) := by
        calc
          (∫ x : FiberDyadicLine, R x) =
              ∫ x : FiberDyadicLine, ∑ k ∈ S,
                ‖g x‖ * intervalTail (c k) (2 * r k)
                  (realToFiberDyadicLine.symm x) := by
            apply integral_congr_ae
            filter_upwards with x
            dsimp [R, T]
            rw [Finset.mul_sum]
          _ = ∑ k ∈ S, ∫ x : FiberDyadicLine,
              ‖g x‖ * intervalTail (c k) (2 * r k)
                (realToFiberDyadicLine.symm x) := by
            rw [integral_finsetSum S (fun k hk ↦ hterm k hk)]
      _ ≤ 64 * (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal *
          (∫ v in ⋃ k ∈ S, Ioo (c k - r k) (c k + r k),
            (dyadicBallMaximal 1 g (realToFiberDyadicLine v)) ^ q) ^ (1 / q) *
          (volume (⋃ k ∈ S, Ioo (c k - r k) (c k + r k))).toReal ^ (1 / p) := by
        simpa only [intervalTail, scratchLp_intervalTail] using
          (scratchLp_finset_pairwiseDisjoint_intervalTail_holder_cutoff_le
            S c r hr hdisj hpq hq g hg a ha hga hgp)
  calc
    (∫ x in D, ‖g x‖ * B x) ≤
        ∫ x in D, ‖g x‖ * (K * T x) := hmono
    _ = K * (∫ x in D, R x) := by
      rw [show (fun x : FiberDyadicLine ↦ ‖g x‖ * (K * T x)) =
          fun x ↦ K * R x by
        funext x
        dsimp [R]
        ring, integral_const_mul]
    _ ≤ K * (∫ x : FiberDyadicLine, R x) := by
      exact mul_le_mul_of_nonneg_left
        (setIntegral_le_integral hR (Filter.Eventually.of_forall hR_nonneg)) hK
    _ ≤ K *
        (64 * (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal *
          (∫ v in ⋃ k ∈ S, Ioo (c k - r k) (c k + r k),
            (dyadicBallMaximal 1 g (realToFiberDyadicLine v)) ^ q) ^ (1 / q) *
          (volume (⋃ k ∈ S, Ioo (c k - r k) (c k + r k))).toReal ^ (1 / p)) :=
      mul_le_mul_of_nonneg_left htail hK

end ScaleTailCutoffInternal

