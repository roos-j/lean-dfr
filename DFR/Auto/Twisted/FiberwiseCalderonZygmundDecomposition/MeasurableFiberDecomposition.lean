alias lineDyadicBallMaximal_memLp :=
  FiberTailCutoffInternal.scratchLp_line_dyadicBallMaximal_memLp

/-- The finite disjoint interval-tail pairing estimate with the dyadic
maximal-function and cutoff factors from the source `L^p` argument. -/
alias finset_pairwiseDisjoint_intervalTail_holder_cutoff_le :=
  FiberTailCutoffInternal.scratchLp_finset_pairwiseDisjoint_canonicalIntervalTail_holder_cutoff_le

/-- Section 8 restricted far-region terminal: finite bad fibers with
cancellation, interval-radius/mass bounds, and a finite `L^p` cutoff test
are controlled by the dyadic maximal-function tail factor. -/
alias finset_badFiber_scaleTail_holder_cutoff_le :=
  ScaleTailCutoffInternal.scratchAssembly_finset_scaleTail_holder_cutoff_le

/-- The positive side length of a literal fiber dyadic interval. -/
def fiberDyadicIntervalLength (I : FiberDyadicInterval) : ℝ :=
  (2 : ℝ) ^ I.1

/-- Literal fiber dyadic intervals are measurable. -/
theorem measurableSet_fiberDyadicInterval (I : FiberDyadicInterval) :
    MeasurableSet (fiberDyadicInterval I) := by
  unfold fiberDyadicInterval
  exact measurableSet_Ico

/-- The fixed dyadic-fiber average in source coordinate order `(y, z)`.
The indicator presentation makes parameter measurability explicit. -/
noncomputable def fiberDyadicIntervalAverage
    {Z : Type*} [MeasurableSpace Z] (F : ℝ × Z → ℝ)
    (I : FiberDyadicInterval) (z : Z) : ℝ :=
  (fiberDyadicIntervalLength I)⁻¹ *
    ∫ y : ℝ, (fiberDyadicInterval I ×ˢ Set.univ).indicator F (y, z)

/-- The indicator presentation of the fiber average is exactly the source
set-integral average over `I`. -/
theorem fiberDyadicIntervalAverage_eq_setIntegral
    {Z : Type*} [MeasurableSpace Z] (F : ℝ × Z → ℝ)
    (I : FiberDyadicInterval) (z : Z) :
    fiberDyadicIntervalAverage F I z =
      (fiberDyadicIntervalLength I)⁻¹ *
        ∫ y : ℝ in fiberDyadicInterval I, F (y, z) := by
  unfold fiberDyadicIntervalAverage
  rw [← integral_indicator (measurableSet_fiberDyadicInterval I)]
  congr 1
  apply integral_congr_ae
  filter_upwards with y
  by_cases hy : y ∈ fiberDyadicInterval I <;> simp [hy]

/-- A jointly measurable scalar fiber field has measurable fixed dyadic
averages. -/
theorem measurable_fiberDyadicIntervalAverage
    {Z : Type*} [MeasurableSpace Z] (F : ℝ × Z → ℝ)
    (hF : Measurable F) (I : FiberDyadicInterval) :
    Measurable (fiberDyadicIntervalAverage F I) := by
  let D : Set (ℝ × Z) := fiberDyadicInterval I ×ˢ Set.univ
  let G : ℝ × Z → ℝ := D.indicator F
  have hD : MeasurableSet D :=
    (measurableSet_fiberDyadicInterval I).prod MeasurableSet.univ
  have hG : Measurable G := hF.indicator hD
  have hInt : Measurable (fun z : Z => ∫ y : ℝ, G (y, z)) :=
    hG.stronglyMeasurable.integral_prod_left'.measurable
  change Measurable (fun z : Z =>
    (fiberDyadicIntervalLength I)⁻¹ * ∫ y : ℝ, G (y, z))
  exact measurable_const.mul hInt

/-- The strict-ancestor relation in the source dyadic grid. -/
def fiberDyadicProperAncestor (I J : FiberDyadicInterval) : Prop :=
  fiberDyadicInterval I ⊂ fiberDyadicInterval J

/-- Fibers of finite nonnegative mass; for `|f|^p` this is the source set
`Z_f`. -/
def fiberFiniteMassSet
    {Z : Type*} [MeasurableSpace Z] (F : ℝ × Z → ℝ≥0∞) : Set Z :=
  {z | (∫⁻ y : ℝ, F (y, z)) < ∞}

/-- The finite-fiber-mass set is measurable for a jointly measurable field. -/
theorem measurableSet_fiberFiniteMassSet
    {Z : Type*} [MeasurableSpace Z] (F : ℝ × Z → ℝ≥0∞)
    (hF : Measurable F) :
    MeasurableSet (fiberFiniteMassSet F) := by
  unfold fiberFiniteMassSet
  exact measurableSet_lt hF.lintegral_prod_left' measurable_const

/-- Section 8's source selection set `S_I`: fibers in `Zf` whose average on
`I` exceeds `H`, while every strict dyadic ancestor average is at most `H`. -/
def fiberDyadicSelectionSet
    {Z : Type*} [MeasurableSpace Z] (Zf : Set Z)
    (A : FiberDyadicInterval → Z → ℝ) (H : ℝ)
    (I : FiberDyadicInterval) : Set Z :=
  (Zf ∩ {z | H < A I z}) ∩
    ⋂ J : FiberDyadicInterval,
      ⋂ (_ : fiberDyadicProperAncestor I J), {z | A J z ≤ H}

/-- The countable dyadic selection set `S_I` is measurable whenever its
fixed-interval averages are measurable. -/
theorem measurableSet_fiberDyadicSelectionSet
    {Z : Type*} [MeasurableSpace Z] (Zf : Set Z)
    (hZf : MeasurableSet Zf)
    (A : FiberDyadicInterval → Z → ℝ)
    (hA : ∀ I, Measurable (A I)) (H : ℝ)
    (I : FiberDyadicInterval) :
    MeasurableSet (fiberDyadicSelectionSet Zf A H I) := by
  unfold fiberDyadicSelectionSet
  refine (hZf.inter (measurableSet_lt measurable_const (hA I))).inter ?_
  refine MeasurableSet.iInter fun J => MeasurableSet.iInter fun _ => ?_
  exact measurableSet_le (hA J) measurable_const

/-- The Section 8 exceptional set `B = ⋃_I (I × S_I)`, retaining the
source coordinate order `(y, z)`. -/
def fiberDyadicExceptionalSet
    {Z : Type*} [MeasurableSpace Z] (Zf : Set Z)
    (A : FiberDyadicInterval → Z → ℝ) (H : ℝ) : Set (ℝ × Z) :=
  ⋃ I : FiberDyadicInterval,
    fiberDyadicInterval I ×ˢ fiberDyadicSelectionSet Zf A H I

/-- The countable Section 8 exceptional set is measurable. -/
theorem measurableSet_fiberDyadicExceptionalSet
    {Z : Type*} [MeasurableSpace Z] (Zf : Set Z)
    (hZf : MeasurableSet Zf)
    (A : FiberDyadicInterval → Z → ℝ)
    (hA : ∀ I, Measurable (A I)) (H : ℝ) :
    MeasurableSet (fiberDyadicExceptionalSet Zf A H) := by
  unfold fiberDyadicExceptionalSet
  refine MeasurableSet.iUnion fun I => ?_
  exact (measurableSet_fiberDyadicInterval I).prod
    (measurableSet_fiberDyadicSelectionSet Zf hZf A hA H I)

/-- A finite truncation of the source exceptional set. -/
def fiberDyadicExceptionalSetFinset
    {Z : Type*} [MeasurableSpace Z] (T : Finset FiberDyadicInterval)
    (Zf : Set Z) (A : FiberDyadicInterval → Z → ℝ)
    (H : ℝ) : Set (ℝ × Z) :=
  ⋃ I ∈ T,
    fiberDyadicInterval I ×ˢ fiberDyadicSelectionSet Zf A H I

/-- Measurability of the finite exceptional-set truncations. -/
theorem measurableSet_fiberDyadicExceptionalSetFinset
    {Z : Type*} [MeasurableSpace Z] (T : Finset FiberDyadicInterval)
    (Zf : Set Z) (hZf : MeasurableSet Zf)
    (A : FiberDyadicInterval → Z → ℝ)
    (hA : ∀ I, Measurable (A I)) (H : ℝ) :
    MeasurableSet (fiberDyadicExceptionalSetFinset T Zf A H) := by
  unfold fiberDyadicExceptionalSetFinset
  exact T.measurableSet_biUnion fun I _ =>
    (measurableSet_fiberDyadicInterval I).prod
      (measurableSet_fiberDyadicSelectionSet Zf hZf A hA H I)

/-- The exceptional-set terminal for fixed interval averages of a jointly
measurable scalar field. -/
theorem measurableSet_fiberDyadicExceptionalSet_of_average
    {Z : Type*} [MeasurableSpace Z] (Zf : Set Z)
    (hZf : MeasurableSet Zf) (F : ℝ × Z → ℝ)
    (hF : Measurable F) (H : ℝ) :
    MeasurableSet
      (fiberDyadicExceptionalSet Zf (fiberDyadicIntervalAverage F) H) := by
  apply measurableSet_fiberDyadicExceptionalSet Zf hZf
  intro I
  exact measurable_fiberDyadicIntervalAverage F hF I

/-- The measurable exceptional-set terminal with a finite fiber-mass set. -/
theorem measurableSet_fiberDyadicExceptionalSet_of_fiberFiniteMass
    {Z : Type*} [MeasurableSpace Z] (M : ℝ × Z → ℝ≥0∞)
    (hM : Measurable M) (F : ℝ × Z → ℝ)
    (hF : Measurable F) (H : ℝ) :
    MeasurableSet
      (fiberDyadicExceptionalSet (fiberFiniteMassSet M)
        (fiberDyadicIntervalAverage F) H) := by
  apply measurableSet_fiberDyadicExceptionalSet_of_average
  · exact measurableSet_fiberFiniteMassSet M hM
  · exact hF

/-- The scalar `|f|^p` field used by the source is jointly measurable. -/
theorem measurable_fiberNormRpow
    {Z : Type*} [MeasurableSpace Z] (f : ℝ × Z → ℂ)
    (hf : Measurable f) (p : ℝ) (hp : 0 ≤ p) :
    Measurable (fun yz : ℝ × Z => ‖f yz‖ ^ p) :=
  (Real.continuous_rpow_const hp).measurable.comp hf.norm

/-- Section 8's literal measurable-fiber-CZ exceptional set: for a jointly
measurable complex `f` and `p ≥ 0`, the countable set built from `Z_f` and
the dyadic averages of `|f|^p` is measurable. -/
theorem measurableSet_fiberDyadicExceptionalSet_of_normRpow
    {Z : Type*} [MeasurableSpace Z] (f : ℝ × Z → ℂ)
    (hf : Measurable f) (p H : ℝ) (hp : 0 ≤ p) :
    MeasurableSet
      (fiberDyadicExceptionalSet
        (fiberFiniteMassSet
          (fun yz : ℝ × Z => ENNReal.ofReal (‖f yz‖ ^ p)))
        (fiberDyadicIntervalAverage
          (fun yz : ℝ × Z => ‖f yz‖ ^ p)) H) := by
  apply measurableSet_fiberDyadicExceptionalSet_of_fiberFiniteMass
  · exact (measurable_fiberNormRpow f hf p hp).ennreal_ofReal
  · exact measurable_fiberNormRpow f hf p hp

/-- The public one-dimensional dyadic-cube index used to certify the literal
source fiber dyadic grid. -/
abbrev FiberDyadicCubeIndex := LacunaryCZDyadicCubeIndex 1

/-- Convert a source fiber dyadic interval index into the public
one-dimensional integer-scale cube index. -/
def fiberDyadicIntervalToCube (I : FiberDyadicInterval) : FiberDyadicCubeIndex :=
  ⟨I.1, fun _ => I.2⟩

/-- Read the unique coordinate of a public one-dimensional dyadic cube as a
source fiber interval index. -/
def fiberDyadicCubeToInterval (q : FiberDyadicCubeIndex) : FiberDyadicInterval :=
  (q.scale, q.translation 0)

@[simp] theorem fiberDyadicCubeToInterval_toCube (I : FiberDyadicInterval) :
    fiberDyadicCubeToInterval (fiberDyadicIntervalToCube I) = I := rfl

@[simp] theorem fiberDyadicIntervalToCube_toInterval (q : FiberDyadicCubeIndex) :
    fiberDyadicIntervalToCube (fiberDyadicCubeToInterval q) = q := by
  cases q with
  | mk k m =>
      dsimp [fiberDyadicIntervalToCube, fiberDyadicCubeToInterval]
      congr
      funext i
      have hi : i = 0 := Subsingleton.elim _ _
      subst i
      rfl

private theorem realToFiberDyadicLine_coordinate_zero (x : ℝ) :
    WithLp.ofLp (realToFiberDyadicLine x) (0 : Fin 1) = x := by
  simp [realToFiberDyadicLine, MeasurableEquiv.piUnique]

/-- Pulling a public one-dimensional dyadic cube back through the canonical
real-line equivalence is literally the source fiber dyadic interval. -/
theorem realToFiber_mem_fiberDyadicCube_iff_mem_fiberDyadicInterval
    (I : FiberDyadicInterval) (x : ℝ) :
    realToFiberDyadicLine x ∈ lacunaryCZDyadicCube
        (fiberDyadicIntervalToCube I) ↔ x ∈ fiberDyadicInterval I := by
  unfold lacunaryCZDyadicCube fiberDyadicIntervalToCube fiberDyadicInterval
  rw [Set.mem_preimage, Set.mem_pi]
  simp only [Set.mem_univ, forall_true_left]
  constructor
  · intro h
    have h0 := h 0
    rw [realToFiberDyadicLine_coordinate_zero] at h0
    exact h0
  · intro h i
    have hi : i = 0 := Subsingleton.elim _ _
    subst i
    rw [realToFiberDyadicLine_coordinate_zero]
    exact h

/-- Set-level form of the literal source-to-public dyadic-grid alignment. -/
theorem fiberDyadicInterval_eq_preimage_cube (I : FiberDyadicInterval) :
    fiberDyadicInterval I = realToFiberDyadicLine ⁻¹'
      lacunaryCZDyadicCube (fiberDyadicIntervalToCube I) := by
  ext x
  exact (realToFiber_mem_fiberDyadicCube_iff_mem_fiberDyadicInterval I x).symm

/-- The immediate dyadic parent of a source fiber interval. -/
def fiberDyadicIntervalParent (I : FiberDyadicInterval) : FiberDyadicInterval :=
  (I.1 + 1, I.2 / 2)

/-- The source parent map agrees definitionally with the public dyadic-cube
parent under the one-dimensional grid alignment. -/
theorem fiberDyadicIntervalToCube_parent (I : FiberDyadicInterval) :
    fiberDyadicIntervalToCube (fiberDyadicIntervalParent I) =
      lacunaryCZDyadicCubeParent (fiberDyadicIntervalToCube I) := rfl

/-- A source fiber dyadic interval is contained in its immediate parent. -/
theorem fiberDyadicInterval_subset_parent (I : FiberDyadicInterval) :
    fiberDyadicInterval I ⊆ fiberDyadicInterval (fiberDyadicIntervalParent I) := by
  intro x hx
  have hxCube : realToFiberDyadicLine x ∈
      lacunaryCZDyadicCube (fiberDyadicIntervalToCube I) :=
    (realToFiber_mem_fiberDyadicCube_iff_mem_fiberDyadicInterval I x).2 hx
  have hxParent := lacunaryCZDyadicCube_subset_parent
    (fiberDyadicIntervalToCube I) hxCube
  rw [← fiberDyadicIntervalToCube_parent] at hxParent
  exact (realToFiber_mem_fiberDyadicCube_iff_mem_fiberDyadicInterval
    (fiberDyadicIntervalParent I) x).1 hxParent

/-- The source parent containment is strict. -/
theorem fiberDyadicInterval_ssub_parent (I : FiberDyadicInterval) :
    fiberDyadicInterval I ⊂ fiberDyadicInterval (fiberDyadicIntervalParent I) := by
  refine ⟨fiberDyadicInterval_subset_parent I, ?_⟩
  intro hrev
  have hcube : lacunaryCZDyadicCube
      (lacunaryCZDyadicCubeParent (fiberDyadicIntervalToCube I)) ⊆
      lacunaryCZDyadicCube (fiberDyadicIntervalToCube I) := by
    intro y hy
    let x : ℝ := realToFiberDyadicLine.symm y
    have hyx : realToFiberDyadicLine x = y :=
      realToFiberDyadicLine.apply_symm_apply y
    have hxParent : x ∈ fiberDyadicInterval (fiberDyadicIntervalParent I) := by
      apply (realToFiber_mem_fiberDyadicCube_iff_mem_fiberDyadicInterval
        (fiberDyadicIntervalParent I) x).1
      rw [fiberDyadicIntervalToCube_parent]
      simpa only [hyx] using hy
    have hx : x ∈ fiberDyadicInterval I := hrev hxParent
    have hxCube : realToFiberDyadicLine x ∈
        lacunaryCZDyadicCube (fiberDyadicIntervalToCube I) :=
      (realToFiber_mem_fiberDyadicCube_iff_mem_fiberDyadicInterval I x).2 hx
    simpa only [hyx] using hxCube
  exact (lacunaryCZDyadicCube_ssub_parent
    (fiberDyadicIntervalToCube I)).2 hcube

/-- The literal source fiber dyadic grid is laminar: two intersecting cells
are nested. -/
theorem fiberDyadicInterval_laminar
    (I J : FiberDyadicInterval)
    (hnot : ¬ Disjoint (fiberDyadicInterval I) (fiberDyadicInterval J)) :
    fiberDyadicInterval I ⊆ fiberDyadicInterval J ∨
      fiberDyadicInterval J ⊆ fiberDyadicInterval I := by
  have hnotCube : ¬ Disjoint
      (lacunaryCZDyadicCube (fiberDyadicIntervalToCube I))
      (lacunaryCZDyadicCube (fiberDyadicIntervalToCube J)) := by
    intro hdisj
    apply hnot
    rw [Set.disjoint_left]
    intro x hxI hxJ
    have hxICube : realToFiberDyadicLine x ∈
        lacunaryCZDyadicCube (fiberDyadicIntervalToCube I) :=
      (realToFiber_mem_fiberDyadicCube_iff_mem_fiberDyadicInterval I x).2 hxI
    have hxJCube : realToFiberDyadicLine x ∈
        lacunaryCZDyadicCube (fiberDyadicIntervalToCube J) :=
      (realToFiber_mem_fiberDyadicCube_iff_mem_fiberDyadicInterval J x).2 hxJ
    exact (Set.disjoint_left.1 hdisj) hxICube hxJCube
  rcases lacunaryCZDyadicCube_laminar
      (fiberDyadicIntervalToCube I)
      (fiberDyadicIntervalToCube J) hnotCube with hIJ | hJI
  · left
    intro x hx
    apply (realToFiber_mem_fiberDyadicCube_iff_mem_fiberDyadicInterval J x).1
    apply hIJ
    exact (realToFiber_mem_fiberDyadicCube_iff_mem_fiberDyadicInterval I x).2 hx
  · right
    intro x hx
    apply (realToFiber_mem_fiberDyadicCube_iff_mem_fiberDyadicInterval I x).1
    apply hJI
    exact (realToFiber_mem_fiberDyadicCube_iff_mem_fiberDyadicInterval J x).2 hx

/-- The literal source fiber dyadic grid has no duplicate interval indices. -/
theorem fiberDyadicInterval_injective : Function.Injective fiberDyadicInterval := by
  intro I J hIJ
  have hpreimage : realToFiberDyadicLine ⁻¹'
      lacunaryCZDyadicCube (fiberDyadicIntervalToCube I) =
      realToFiberDyadicLine ⁻¹'
        lacunaryCZDyadicCube (fiberDyadicIntervalToCube J) := by
    rw [← fiberDyadicInterval_eq_preimage_cube,
      ← fiberDyadicInterval_eq_preimage_cube]
    exact hIJ
  have hcube : lacunaryCZDyadicCube (fiberDyadicIntervalToCube I) =
      lacunaryCZDyadicCube (fiberDyadicIntervalToCube J) := by
    apply Set.Subset.antisymm
    · intro q hq
      obtain ⟨x, rfl⟩ := realToFiberDyadicLine.surjective q
      have hx : x ∈ realToFiberDyadicLine ⁻¹'
          lacunaryCZDyadicCube (fiberDyadicIntervalToCube I) := hq
      have hx' : x ∈ realToFiberDyadicLine ⁻¹'
          lacunaryCZDyadicCube (fiberDyadicIntervalToCube J) := by
        rw [← hpreimage]
        exact hx
      exact hx'
    · intro q hq
      obtain ⟨x, rfl⟩ := realToFiberDyadicLine.surjective q
      have hx : x ∈ realToFiberDyadicLine ⁻¹'
          lacunaryCZDyadicCube (fiberDyadicIntervalToCube J) := hq
      have hx' : x ∈ realToFiberDyadicLine ⁻¹'
          lacunaryCZDyadicCube (fiberDyadicIntervalToCube I) := by
        rw [hpreimage]
        exact hx
      exact hx'
  have hindex : fiberDyadicIntervalToCube I = fiberDyadicIntervalToCube J :=
    lacunaryCZDyadicCube_injective hcube
  simpa only [fiberDyadicCubeToInterval_toCube] using
    congrArg fiberDyadicCubeToInterval hindex

/-- Passing from a fiber dyadic interval to its parent doubles its length. -/
theorem fiberDyadicIntervalLength_parent (I : FiberDyadicInterval) :
    fiberDyadicIntervalLength (fiberDyadicIntervalParent I) =
      2 * fiberDyadicIntervalLength I := by
  unfold fiberDyadicIntervalLength fiberDyadicIntervalParent
  rw [zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
  norm_num
  ring

/-- A literal fiber dyadic interval has positive length. -/
theorem fiberDyadicIntervalLength_pos (I : FiberDyadicInterval) :
    0 < fiberDyadicIntervalLength I := by
  unfold fiberDyadicIntervalLength
  positivity

/-- Given child containment, a nonnegative integrable fiber field has child
average at most twice its parent average. -/
theorem fiberDyadicIntervalAverage_le_two_parent_of_subset
    {Z : Type*} [MeasurableSpace Z] (F : ℝ × Z → ℝ)
    (I : FiberDyadicInterval) (z : Z)
    (hF : Integrable (fun y : ℝ => F (y, z)) volume)
    (hF_nonneg : ∀ y : ℝ, 0 ≤ F (y, z))
    (hsubset : fiberDyadicInterval I ⊆
      fiberDyadicInterval (fiberDyadicIntervalParent I)) :
    fiberDyadicIntervalAverage F I z ≤
      2 * fiberDyadicIntervalAverage F (fiberDyadicIntervalParent I) z := by
  rw [fiberDyadicIntervalAverage_eq_setIntegral,
    fiberDyadicIntervalAverage_eq_setIntegral]
  have hmono :
      (∫ y : ℝ in fiberDyadicInterval I, F (y, z)) ≤
        ∫ y : ℝ in fiberDyadicInterval (fiberDyadicIntervalParent I), F (y, z) := by
    apply MeasureTheory.setIntegral_mono_set hF.integrableOn
    · filter_upwards with y
      exact hF_nonneg y
    · exact Filter.Eventually.of_forall hsubset
  have hlen : 0 < fiberDyadicIntervalLength I := fiberDyadicIntervalLength_pos I
  have hfactor : 2 * (fiberDyadicIntervalLength
      (fiberDyadicIntervalParent I))⁻¹ = (fiberDyadicIntervalLength I)⁻¹ := by
    rw [fiberDyadicIntervalLength_parent]
    field_simp
  calc
    (fiberDyadicIntervalLength I)⁻¹ *
        ∫ y : ℝ in fiberDyadicInterval I, F (y, z) ≤
        (fiberDyadicIntervalLength I)⁻¹ *
          ∫ y : ℝ in fiberDyadicInterval (fiberDyadicIntervalParent I), F (y, z) :=
      mul_le_mul_of_nonneg_left hmono (inv_nonneg.mpr hlen.le)
    _ = 2 * ((fiberDyadicIntervalLength (fiberDyadicIntervalParent I))⁻¹ *
          ∫ y : ℝ in fiberDyadicInterval (fiberDyadicIntervalParent I), F (y, z)) := by
      rw [show (fiberDyadicIntervalLength I)⁻¹ =
          2 * (fiberDyadicIntervalLength (fiberDyadicIntervalParent I))⁻¹ by
        exact hfactor.symm]
      ring

/-- The literal dyadic parent containment gives the child--parent average
comparison without additional geometric hypotheses. -/
theorem fiberDyadicIntervalAverage_le_two_parent
    {Z : Type*} [MeasurableSpace Z] (F : ℝ × Z → ℝ)
    (I : FiberDyadicInterval) (z : Z)
    (hF : Integrable (fun y : ℝ => F (y, z)) volume)
    (hF_nonneg : ∀ y : ℝ, 0 ≤ F (y, z)) :
    fiberDyadicIntervalAverage F I z ≤
      2 * fiberDyadicIntervalAverage F (fiberDyadicIntervalParent I) z :=
  fiberDyadicIntervalAverage_le_two_parent_of_subset F I z hF hF_nonneg
    (fiberDyadicInterval_subset_parent I)

/-- A selected interval excludes every strict dyadic ancestor from having
average above the stopping height. -/
theorem fiberDyadicSelection_ancestor_average_le
    {Z : Type*} [MeasurableSpace Z] (Zf : Set Z)
    (A : FiberDyadicInterval → Z → ℝ) (H : ℝ)
    (I J : FiberDyadicInterval) (z : Z)
    (hIJ : fiberDyadicProperAncestor I J)
    (hz : z ∈ fiberDyadicSelectionSet Zf A H I) :
    A J z ≤ H := by
  exact Set.mem_iInter.mp (Set.mem_iInter.mp hz.2 J) hIJ

/-- The source selection is maximal: no strict dyadic ancestor of a selected
interval remains above the stopping height. -/
theorem fiberDyadicSelection_maximal
    {Z : Type*} [MeasurableSpace Z] (Zf : Set Z)
    (A : FiberDyadicInterval → Z → ℝ) (H : ℝ)
    (I J : FiberDyadicInterval) (z : Z)
    (hIJ : fiberDyadicProperAncestor I J)
    (hz : z ∈ fiberDyadicSelectionSet Zf A H I) :
    ¬ H < A J z := by
  exact not_lt_of_ge (fiberDyadicSelection_ancestor_average_le Zf A H I J z hIJ hz)

/-- If a selected child is controlled by its parent, its average lies in the
exact source range `(H, 2H]`. -/
theorem fiberDyadicSelection_average_lt_and_le_two
    {Z : Type*} [MeasurableSpace Z] (Zf : Set Z)
    (A : FiberDyadicInterval → Z → ℝ) (H : ℝ)
    (I : FiberDyadicInterval) (z : Z)
    (hparent : fiberDyadicProperAncestor I (fiberDyadicIntervalParent I))
    (hchild : A I z ≤ 2 * A (fiberDyadicIntervalParent I) z)
    (hz : z ∈ fiberDyadicSelectionSet Zf A H I) :
    H < A I z ∧ A I z ≤ 2 * H := by
  rcases hz with ⟨⟨_, hlt⟩, hancestors⟩
  have hparent_member : z ∈
      ⋂ (_ : fiberDyadicProperAncestor I (fiberDyadicIntervalParent I)),
        {z | A (fiberDyadicIntervalParent I) z ≤ H} :=
    Set.mem_iInter.mp hancestors (fiberDyadicIntervalParent I)
  have hparent_le : A (fiberDyadicIntervalParent I) z ≤ H :=
    Set.mem_iInter.mp hparent_member hparent
  constructor
  · exact hlt
  · nlinarith

/-- Fixed-fiber source terminal: for actual nonnegative dyadic averages,
every selected interval has average in `(H, 2H]`. -/
theorem fiberDyadicSelection_average_lt_and_le_two_of_nonneg
    {Z : Type*} [MeasurableSpace Z] (Zf : Set Z)
    (F : ℝ × Z → ℝ) (H : ℝ)
    (I : FiberDyadicInterval) (z : Z)
    (hF : Integrable (fun y : ℝ => F (y, z)) volume)
    (hF_nonneg : ∀ y : ℝ, 0 ≤ F (y, z))
    (hz : z ∈ fiberDyadicSelectionSet Zf
      (fiberDyadicIntervalAverage F) H I) :
    H < fiberDyadicIntervalAverage F I z ∧
      fiberDyadicIntervalAverage F I z ≤ 2 * H := by
  apply fiberDyadicSelection_average_lt_and_le_two
    Zf (fiberDyadicIntervalAverage F) H I z
  · exact fiberDyadicInterval_ssub_parent I
  · exact fiberDyadicIntervalAverage_le_two_parent F I z hF hF_nonneg
  · exact hz

/-- In an injectively indexed laminar interval family, source selection gives
pairwise disjoint selected intervals on each fixed fiber. -/
theorem pairwiseDisjoint_fiberDyadicSelectedIntervals_of_laminar
    {Z : Type*} [MeasurableSpace Z] (Zf : Set Z)
    (A : FiberDyadicInterval → Z → ℝ) (H : ℝ) (z : Z)
    (hinjective : Function.Injective fiberDyadicInterval)
    (hlaminar : ∀ I J : FiberDyadicInterval,
      ¬ Disjoint (fiberDyadicInterval I) (fiberDyadicInterval J) →
        fiberDyadicInterval I ⊆ fiberDyadicInterval J ∨
          fiberDyadicInterval J ⊆ fiberDyadicInterval I) :
    ({I : FiberDyadicInterval | z ∈ fiberDyadicSelectionSet Zf A H I}).PairwiseDisjoint
      fiberDyadicInterval := by
  intro I hI J hJ hne
  by_contra hdisjoint
  rcases hlaminar I J hdisjoint with hIJ | hJI
  · have hproper : fiberDyadicProperAncestor I J := by
      refine ⟨hIJ, ?_⟩
      intro hrev
      apply hne
      apply hinjective
      exact Set.Subset.antisymm hIJ hrev
    have hJle := fiberDyadicSelection_ancestor_average_le Zf A H I J z hproper hI
    exact (not_lt_of_ge hJle) hJ.1.2
  · have hproper : fiberDyadicProperAncestor J I := by
      refine ⟨hJI, ?_⟩
      intro hrev
      apply hne.symm
      apply hinjective
      exact Set.Subset.antisymm hJI hrev
    have hIle := fiberDyadicSelection_ancestor_average_le Zf A H J I z hproper hJ
    exact (not_lt_of_ge hIle) hI.1.2

/-- On every fixed fiber, the literal Section 8 selected dyadic intervals
are pairwise disjoint. -/
theorem pairwiseDisjoint_fiberDyadicSelectedIntervals
    {Z : Type*} [MeasurableSpace Z] (Zf : Set Z)
    (A : FiberDyadicInterval → Z → ℝ) (H : ℝ) (z : Z) :
    ({I : FiberDyadicInterval | z ∈ fiberDyadicSelectionSet Zf A H I}).PairwiseDisjoint
      fiberDyadicInterval := by
  apply pairwiseDisjoint_fiberDyadicSelectedIntervals_of_laminar
    Zf A H z fiberDyadicInterval_injective
  exact fiberDyadicInterval_laminar

/-- A finite pairwise-disjoint family of selected source fiber intervals has
total length at most its ambient nonnegative mass divided by the stopping
height. This is the fixed-fiber mass estimate used before the countable
selection exhaustion in the Section 8 weak estimate. -/
theorem fiberDyadic_selected_length_sum_le_inv_mul_integral
    (F : ℝ → ℝ) (H : ℝ) (S : Finset FiberDyadicInterval)
    (hH : 0 < H) (hF : Integrable F volume)
    (hF_nonneg : ∀ x : ℝ, 0 ≤ F x)
    (hdisj : (↑S : Set FiberDyadicInterval).PairwiseDisjoint
      fiberDyadicInterval)
    (hselected : ∀ I ∈ S,
      H < (fiberDyadicIntervalLength I)⁻¹ *
        ∫ x : ℝ in fiberDyadicInterval I, F x) :
    (∑ I ∈ S, fiberDyadicIntervalLength I) ≤
      H⁻¹ * ∫ x : ℝ, F x := by
  have hpoint (I : FiberDyadicInterval) (hI : I ∈ S) :
      H * fiberDyadicIntervalLength I ≤
        ∫ x : ℝ in fiberDyadicInterval I, F x := by
    have hlen : 0 < fiberDyadicIntervalLength I :=
      fiberDyadicIntervalLength_pos I
    have hstrict := mul_lt_mul_of_pos_right (hselected I hI) hlen
    have hcancel :
        ((fiberDyadicIntervalLength I)⁻¹ *
          ∫ x : ℝ in fiberDyadicInterval I, F x) *
            fiberDyadicIntervalLength I =
          ∫ x : ℝ in fiberDyadicInterval I, F x := by
      field_simp
    rw [hcancel] at hstrict
    exact hstrict.le
  have hsum :
      H * (∑ I ∈ S, fiberDyadicIntervalLength I) ≤
        ∑ I ∈ S, ∫ x : ℝ in fiberDyadicInterval I, F x := by
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum fun I hI => hpoint I hI
  have hunion :
      (∑ I ∈ S, ∫ x : ℝ in fiberDyadicInterval I, F x) =
        ∫ x : ℝ in ⋃ I ∈ S, fiberDyadicInterval I, F x := by
    symm
    exact integral_biUnion_finset S
      (fun I _ => measurableSet_fiberDyadicInterval I) hdisj
      (fun _ _ => hF.integrableOn)
  have hglobal :
      (∫ x : ℝ in ⋃ I ∈ S, fiberDyadicInterval I, F x) ≤
        ∫ x : ℝ, F x :=
    setIntegral_le_integral hF
      (Filter.Eventually.of_forall hF_nonneg)
  have hmain :
      H * (∑ I ∈ S, fiberDyadicIntervalLength I) ≤ ∫ x : ℝ, F x := by
    calc
      H * (∑ I ∈ S, fiberDyadicIntervalLength I) ≤
          ∑ I ∈ S, ∫ x : ℝ in fiberDyadicInterval I, F x := hsum
      _ = ∫ x : ℝ in ⋃ I ∈ S, fiberDyadicInterval I, F x := hunion
      _ ≤ ∫ x : ℝ, F x := hglobal
  calc
    (∑ I ∈ S, fiberDyadicIntervalLength I) =
        H⁻¹ * (H * (∑ I ∈ S, fiberDyadicIntervalLength I)) := by
          field_simp
    _ ≤ H⁻¹ * ∫ x : ℝ, F x :=
      mul_le_mul_of_nonneg_left hmain (inv_nonneg.mpr hH.le)

/-- The preceding finite mass estimate applied to any finite subfamily of
the literal dyadic stopping selection on one fixed fiber. -/
theorem fiberDyadicSelection_finset_length_sum_le
    {Z : Type*} [MeasurableSpace Z]
    (F : ℝ × Z → ℝ) (Zf : Set Z) (H : ℝ) (z : Z)
    (S : Finset FiberDyadicInterval)
    (hH : 0 < H) (hF : Integrable (fun y : ℝ => F (y, z)) volume)
    (hF_nonneg : ∀ y : ℝ, 0 ≤ F (y, z))
    (hselected : ∀ I ∈ S, z ∈ fiberDyadicSelectionSet
      Zf (fiberDyadicIntervalAverage F) H I) :
    (∑ I ∈ S, fiberDyadicIntervalLength I) ≤
      H⁻¹ * ∫ y : ℝ, F (y, z) := by
  apply fiberDyadic_selected_length_sum_le_inv_mul_integral
    (fun y : ℝ => F (y, z)) H S hH hF hF_nonneg
  · intro I hI J hJ hne
    exact pairwiseDisjoint_fiberDyadicSelectedIntervals
      Zf (fiberDyadicIntervalAverage F) H z
      (hselected I hI) (hselected J hJ) hne
  · intro I hI
    rw [← fiberDyadicIntervalAverage_eq_setIntegral]
    exact (hselected I hI).1.2

/-- The selected interval rectangles are pairwise disjoint globally: on a
fixed transverse fiber their interval factors are disjoint, while distinct
fibers are already separated by the product coordinate. -/
theorem pairwiseDisjoint_fiberDyadicSelectedRectangles
    {Z : Type*} [MeasurableSpace Z] (Zf : Set Z)
    (A : FiberDyadicInterval → Z → ℝ) (H : ℝ) :
  (Set.univ : Set FiberDyadicInterval).PairwiseDisjoint
      (fun I => fiberDyadicInterval I ×ˢ
        fiberDyadicSelectionSet Zf A H I) := by
  intro I _ J _ hne
  change Disjoint
    (fiberDyadicInterval I ×ˢ fiberDyadicSelectionSet Zf A H I)
    (fiberDyadicInterval J ×ˢ fiberDyadicSelectionSet Zf A H J)
  rw [Set.disjoint_left]
  intro yz hyI hyJ
  have hline : Disjoint (fiberDyadicInterval I) (fiberDyadicInterval J) :=
    pairwiseDisjoint_fiberDyadicSelectedIntervals Zf A H yz.2 hyI.2 hyJ.2 hne
  exact (Set.disjoint_left.mp hline) hyI.1 hyJ.1

/-- The Lebesgue measure of a literal source dyadic interval is its declared
side length. -/
theorem measure_fiberDyadicInterval (I : FiberDyadicInterval) :
    volume (fiberDyadicInterval I) =
      ENNReal.ofReal (fiberDyadicIntervalLength I) := by
  unfold fiberDyadicInterval fiberDyadicIntervalLength
  rw [Real.volume_Ico]
  congr 1
  push_cast
  ring

/-- A finite family of literal stopping rectangles has measure equal to the
sum of its product measures. The equality records the global disjointness
of the maximal selection, before its countable exhaustion. -/
theorem measure_fiberDyadicExceptionalSetFinset_eq
    {Z : Type*} [MeasurableSpace Z] (μ : Measure Z) [SFinite μ]
    (T : Finset FiberDyadicInterval)
    (Zf : Set Z) (hZf : MeasurableSet Zf)
    (A : FiberDyadicInterval → Z → ℝ)
    (hA : ∀ I, Measurable (A I)) (H : ℝ) :
    (volume.prod μ) (fiberDyadicExceptionalSetFinset T Zf A H) =
      ∑ I ∈ T, volume (fiberDyadicInterval I) *
        μ (fiberDyadicSelectionSet Zf A H I) := by
  unfold fiberDyadicExceptionalSetFinset
  rw [measure_biUnion_finset]
  · simp only [Measure.prod_prod]
  · intro I hI J hJ hne
    exact pairwiseDisjoint_fiberDyadicSelectedRectangles Zf A H
      (Set.mem_univ I) (Set.mem_univ J) hne
  · intro I hI
    exact (measurableSet_fiberDyadicInterval I).prod
      (measurableSet_fiberDyadicSelectionSet Zf hZf A hA H I)

/-- The finite selected-length density on transverse fibers. -/
noncomputable def fiberDyadicSelectedLengthDensity
    {Z : Type*} [MeasurableSpace Z] (T : Finset FiberDyadicInterval)
    (Zf : Set Z) (A : FiberDyadicInterval → Z → ℝ) (H : ℝ) : Z → ℝ :=
  fun z => ∑ I ∈ T, fiberDyadicIntervalLength I *
    (fiberDyadicSelectionSet Zf A H I).indicator (fun _ => (1 : ℝ)) z

/-- The finite selected-length density is measurable. -/
theorem measurable_fiberDyadicSelectedLengthDensity
    {Z : Type*} [MeasurableSpace Z] (T : Finset FiberDyadicInterval)
    (Zf : Set Z) (hZf : MeasurableSet Zf)
    (A : FiberDyadicInterval → Z → ℝ)
    (hA : ∀ I, Measurable (A I)) (H : ℝ) :
    Measurable (fiberDyadicSelectedLengthDensity T Zf A H) := by
  unfold fiberDyadicSelectedLengthDensity
  apply Finset.measurable_sum
  intro I hI
  exact measurable_const.mul
    (measurable_const.indicator
      (measurableSet_fiberDyadicSelectionSet Zf hZf A hA H I))

/-- The selected-length density is pointwise nonnegative. -/
theorem fiberDyadicSelectedLengthDensity_nonneg
    {Z : Type*} [MeasurableSpace Z] (T : Finset FiberDyadicInterval)
    (Zf : Set Z) (A : FiberDyadicInterval → Z → ℝ) (H : ℝ) (z : Z) :
    0 ≤ fiberDyadicSelectedLengthDensity T Zf A H z := by
  unfold fiberDyadicSelectedLengthDensity
  apply Finset.sum_nonneg
  intro I hI
  have hlen : 0 ≤ fiberDyadicIntervalLength I :=
    (fiberDyadicIntervalLength_pos I).le
  by_cases hz : z ∈ fiberDyadicSelectionSet Zf A H I
  · simp [Set.indicator_of_mem hz, hlen]
  · simp [Set.indicator_of_notMem hz]

/-- An integrable pointwise majorant of the finite selected-length density
controls its integral. -/
theorem integral_fiberDyadicSelectedLengthDensity_le
    {Z : Type*} [MeasurableSpace Z] (μ : Measure Z)
    (T : Finset FiberDyadicInterval)
    (Zf : Set Z) (hZf : MeasurableSet Zf)
    (A : FiberDyadicInterval → Z → ℝ)
    (hA : ∀ I, Measurable (A I)) (H : ℝ)
    (G : Z → ℝ) (hG : Integrable G μ)
    (hpoint : ∀ z,
      fiberDyadicSelectedLengthDensity T Zf A H z ≤ G z) :
    (∫ z, fiberDyadicSelectedLengthDensity T Zf A H z ∂μ) ≤
      ∫ z, G z ∂μ := by
  have hDmeas := measurable_fiberDyadicSelectedLengthDensity
    T Zf hZf A hA H
  have hDnon (z : Z) :
      0 ≤ fiberDyadicSelectedLengthDensity T Zf A H z :=
    fiberDyadicSelectedLengthDensity_nonneg T Zf A H z
  have hDint : Integrable (fiberDyadicSelectedLengthDensity T Zf A H) μ :=
    hG.mono' hDmeas.aestronglyMeasurable
      (Filter.Eventually.of_forall fun z => by
        rw [Real.norm_eq_abs, abs_of_nonneg (hDnon z)]
        exact hpoint z)
  exact integral_mono hDint hG hpoint

/-- On a finite transverse measure space, integrating the finite selected
length density gives the expected sum of interval lengths times fiber-set
measures. -/
theorem integral_fiberDyadicSelectedLengthDensity_eq_sum
    {Z : Type*} [MeasurableSpace Z] (μ : Measure Z) [IsFiniteMeasure μ]
    (T : Finset FiberDyadicInterval)
    (Zf : Set Z) (hZf : MeasurableSet Zf)
    (A : FiberDyadicInterval → Z → ℝ)
    (hA : ∀ I, Measurable (A I)) (H : ℝ) :
    (∫ z, fiberDyadicSelectedLengthDensity T Zf A H z ∂μ) =
      ∑ I ∈ T, fiberDyadicIntervalLength I *
        μ.real (fiberDyadicSelectionSet Zf A H I) := by
  unfold fiberDyadicSelectedLengthDensity
  rw [integral_finsetSum]
  · apply Finset.sum_congr rfl
    intro I hI
    let S : Set Z := fiberDyadicSelectionSet Zf A H I
    have hS : MeasurableSet S :=
      measurableSet_fiberDyadicSelectionSet Zf hZf A hA H I
    have hrewrite : (fun z : Z => fiberDyadicIntervalLength I *
        S.indicator (fun _ => (1 : ℝ)) z) =
        S.indicator (fun _ => fiberDyadicIntervalLength I) := by
      funext z
      by_cases hz : z ∈ S <;> simp [S, hz]
    rw [hrewrite, integral_indicator_const _ hS]
    simp only [smul_eq_mul]
    ring
  · intro I hI
    let S : Set Z := fiberDyadicSelectionSet Zf A H I
    have hS : MeasurableSet S :=
      measurableSet_fiberDyadicSelectionSet Zf hZf A hA H I
    have hrewrite : (fun z : Z => fiberDyadicIntervalLength I *
        S.indicator (fun _ => (1 : ℝ)) z) =
        S.indicator (fun _ => fiberDyadicIntervalLength I) := by
      funext z
      by_cases hz : z ∈ S <;> simp [S, hz]
    rw [hrewrite, integrable_indicator_iff hS]
    exact integrableOn_const (measure_ne_top μ S)

/-- The literal finite stopping selection has a fiberwise selected-length
majorant by the ambient nonnegative mass. -/
theorem fiberDyadicSelectedLengthDensity_le_inv_mul_fiberIntegral
    {Z : Type*} [MeasurableSpace Z]
    (Zf : Set Z) (F : ℝ × Z → ℝ) (H : ℝ) (z : Z)
    (T : Finset FiberDyadicInterval)
    (hH : 0 < H)
    (hF : z ∈ Zf → Integrable (fun y : ℝ => F (y, z)) volume)
    (hF_nonneg : ∀ y : ℝ, 0 ≤ F (y, z)) :
    fiberDyadicSelectedLengthDensity T Zf
      (fiberDyadicIntervalAverage F) H z ≤
      H⁻¹ * ∫ y : ℝ, F (y, z) := by
  classical
  by_cases hz : z ∈ Zf
  · let S : Finset FiberDyadicInterval := T.filter
      (fun I => z ∈ fiberDyadicSelectionSet Zf
        (fiberDyadicIntervalAverage F) H I)
    have hselected : ∀ I ∈ S, z ∈ fiberDyadicSelectionSet Zf
        (fiberDyadicIntervalAverage F) H I := by
      intro I hI
      exact (Finset.mem_filter.mp hI).2
    have hmain := fiberDyadicSelection_finset_length_sum_le F Zf H z S hH
      (hF hz) hF_nonneg hselected
    have hdensity : fiberDyadicSelectedLengthDensity T Zf
        (fiberDyadicIntervalAverage F) H z =
        ∑ I ∈ S, fiberDyadicIntervalLength I := by
      unfold fiberDyadicSelectedLengthDensity S
      rw [Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro I hI
      by_cases hIselected : z ∈ fiberDyadicSelectionSet Zf
          (fiberDyadicIntervalAverage F) H I <;>
        simp [hIselected]
    rw [hdensity]
    exact hmain
  · have hdensity : fiberDyadicSelectedLengthDensity T Zf
        (fiberDyadicIntervalAverage F) H z = 0 := by
      unfold fiberDyadicSelectedLengthDensity
      apply Finset.sum_eq_zero
      intro I hI
      have hnot : z ∉ fiberDyadicSelectionSet Zf
          (fiberDyadicIntervalAverage F) H I := by
        intro hmem
        exact hz hmem.1.1
      simp [Set.indicator_of_notMem hnot]
    rw [hdensity]
    exact mul_nonneg (inv_nonneg.mpr hH.le)
      (integral_nonneg fun y => hF_nonneg y)

/-- Fubini turns the finite fiberwise stopping estimate into a global bound
for the selected-length density. The fiber-integrability hypothesis is
restricted only to the selected ambient set `Zf`; this is the form used by
the finite-mass fiber selection. -/
theorem integral_fiberDyadicSelectedLengthDensity_le_inv_mul_integral
    {Z : Type*} [MeasurableSpace Z] (μ : Measure Z) [SFinite μ]
    (Zf : Set Z) (hZf : MeasurableSet Zf)
    (F : ℝ × Z → ℝ) (hF : Integrable F (volume.prod μ))
    (hF_nonneg : ∀ yz : ℝ × Z, 0 ≤ F yz)
    (hF_meas : Measurable F)
    (H : ℝ) (hH : 0 < H) (T : Finset FiberDyadicInterval)
    (hfiber : ∀ z ∈ Zf, Integrable (fun y : ℝ => F (y, z)) volume) :
    (∫ z, fiberDyadicSelectedLengthDensity T Zf
        (fiberDyadicIntervalAverage F) H z ∂μ) ≤
      H⁻¹ * ∫ yz, F yz ∂(volume.prod μ) := by
  let G : Z → ℝ := fun z => H⁻¹ * ∫ y : ℝ, F (y, z)
  have hG : Integrable G μ := by
    dsimp only [G]
    exact (hF.integral_prod_right).const_mul H⁻¹
  have hpoint (z : Z) : fiberDyadicSelectedLengthDensity T Zf
      (fiberDyadicIntervalAverage F) H z ≤ G z := by
    dsimp only [G]
    apply fiberDyadicSelectedLengthDensity_le_inv_mul_fiberIntegral
      Zf F H z T hH
    · intro hz
      exact hfiber z hz
    · intro y
      exact hF_nonneg (y, z)
  have hselected := integral_fiberDyadicSelectedLengthDensity_le μ T Zf hZf
    (fiberDyadicIntervalAverage F)
    (fun I => measurable_fiberDyadicIntervalAverage F hF_meas I) H G hG hpoint
  calc
    (∫ z, fiberDyadicSelectedLengthDensity T Zf
        (fiberDyadicIntervalAverage F) H z ∂μ) ≤ ∫ z, G z ∂μ := hselected
    _ = H⁻¹ * ∫ z, ∫ y : ℝ, F (y, z) ∂volume ∂μ := by
      rw [integral_const_mul]
    _ = H⁻¹ * ∫ yz, F yz ∂(volume.prod μ) := by
      rw [← integral_prod_symm F hF]

/-- For a finite transverse measure, the real measure of a finite stopping
exceptional set is exactly the integral of its selected-length density. -/
theorem measureReal_fiberDyadicExceptionalSetFinset_eq_integral
    {Z : Type*} [MeasurableSpace Z] (μ : Measure Z) [IsFiniteMeasure μ]
    (T : Finset FiberDyadicInterval)
    (Zf : Set Z) (hZf : MeasurableSet Zf)
    (A : FiberDyadicInterval → Z → ℝ)
    (hA : ∀ I, Measurable (A I)) (H : ℝ) :
    (volume.prod μ).real (fiberDyadicExceptionalSetFinset T Zf A H) =
      ∫ z, fiberDyadicSelectedLengthDensity T Zf A H z ∂μ := by
  change ((volume.prod μ) (fiberDyadicExceptionalSetFinset T Zf A H)).toReal = _
  rw [measure_fiberDyadicExceptionalSetFinset_eq μ T Zf hZf A hA H]
  rw [ENNReal.toReal_sum]
  · calc
      (∑ I ∈ T, (volume (fiberDyadicInterval I) *
        μ (fiberDyadicSelectionSet Zf A H I)).toReal) =
          ∑ I ∈ T, fiberDyadicIntervalLength I *
            μ.real (fiberDyadicSelectionSet Zf A H I) := by
        apply Finset.sum_congr rfl
        intro I hI
        rw [measure_fiberDyadicInterval, ENNReal.toReal_mul]
        simp only [ENNReal.toReal_ofReal (fiberDyadicIntervalLength_pos I).le]
        rfl
      _ = ∫ z, fiberDyadicSelectedLengthDensity T Zf A H z ∂μ :=
        (integral_fiberDyadicSelectedLengthDensity_eq_sum μ T Zf hZf A hA H).symm
  · intro I hI
    apply ENNReal.mul_ne_top
    · rw [measure_fiberDyadicInterval]
      exact ENNReal.ofReal_ne_top
    · exact
      (measure_ne_top μ (fiberDyadicSelectionSet Zf A H I))

/-- The finite stopping exceptional set satisfies the global weak-one mass
bound in real measure. Countable exhaustion can now be applied without
losing the dyadic maximal-selection disjointness. -/
theorem measureReal_fiberDyadicExceptionalSetFinset_le_inv_mul_integral
    {Z : Type*} [MeasurableSpace Z] (μ : Measure Z) [IsFiniteMeasure μ]
    (Zf : Set Z) (hZf : MeasurableSet Zf)
    (F : ℝ × Z → ℝ) (hF : Integrable F (volume.prod μ))
    (hF_nonneg : ∀ yz : ℝ × Z, 0 ≤ F yz)
    (hF_meas : Measurable F)
    (H : ℝ) (hH : 0 < H) (T : Finset FiberDyadicInterval)
    (hfiber : ∀ z ∈ Zf, Integrable (fun y : ℝ => F (y, z)) volume) :
    (volume.prod μ).real
      (fiberDyadicExceptionalSetFinset T Zf
        (fiberDyadicIntervalAverage F) H) ≤
      H⁻¹ * ∫ yz, F yz ∂(volume.prod μ) := by
  rw [measureReal_fiberDyadicExceptionalSetFinset_eq_integral μ T Zf hZf
    (fiberDyadicIntervalAverage F)
    (fun I => measurable_fiberDyadicIntervalAverage F hF_meas I) H]
  exact integral_fiberDyadicSelectedLengthDensity_le_inv_mul_integral μ Zf hZf
    F hF hF_nonneg hF_meas H hH T hfiber

/-! ### Section 8 countable exceptional-set terminal -/

/-- Membership in the nonnegative finite-fiber-mass set supplies the ordinary
Bochner integrability required by the dyadic stopping estimate. -/
theorem mem_fiberFiniteMassSet_integrable
    {Z : Type*} [MeasurableSpace Z]
    (F : ℝ × Z → ℝ) (hF : Measurable F)
    (hF_nonneg : ∀ yz : ℝ × Z, 0 ≤ F yz)
    (z : Z)
    (hz : z ∈ fiberFiniteMassSet (fun yz : ℝ × Z => ENNReal.ofReal (F yz))) :
    Integrable (fun y : ℝ => F (y, z)) volume := by
  have hslice : Measurable (fun y : ℝ => F (y, z)) :=
    hF.comp (measurable_id.prodMk measurable_const)
  apply (lintegral_ofReal_ne_top_iff_integrable
    hslice.aestronglyMeasurable
    (Filter.Eventually.of_forall fun y => hF_nonneg (y, z))).mp
  exact ne_of_lt hz

/-- The globally pairwise-disjoint dyadic stopping rectangles satisfy the
literal countable exceptional-set weak bound. This upgrades the finite
selected-rectangle estimate through `measure_iUnion`, with no loss from a
union bound. -/
theorem measureReal_fiberDyadicExceptionalSet_le_inv_mul_integral
    {Z : Type*} [MeasurableSpace Z] (μ : Measure Z) [IsFiniteMeasure μ]
    (Zf : Set Z) (hZf : MeasurableSet Zf)
    (F : ℝ × Z → ℝ) (hF : Integrable F (volume.prod μ))
    (hF_nonneg : ∀ yz : ℝ × Z, 0 ≤ F yz)
    (hF_meas : Measurable F)
    (H : ℝ) (hH : 0 < H)
    (hfiber : ∀ z ∈ Zf, Integrable (fun y : ℝ => F (y, z)) volume) :
    (volume.prod μ).real
      (fiberDyadicExceptionalSet Zf (fiberDyadicIntervalAverage F) H) ≤
      H⁻¹ * ∫ yz, F yz ∂(volume.prod μ) := by
  classical
  let R : FiberDyadicInterval → Set (ℝ × Z) := fun I =>
    fiberDyadicInterval I ×ˢ
      fiberDyadicSelectionSet Zf (fiberDyadicIntervalAverage F) H I
  have hRmeas (I : FiberDyadicInterval) : MeasurableSet (R I) := by
    dsimp [R]
    exact (measurableSet_fiberDyadicInterval I).prod
      (measurableSet_fiberDyadicSelectionSet Zf hZf
        (fiberDyadicIntervalAverage F)
        (fun J => measurable_fiberDyadicIntervalAverage F hF_meas J) H I)
  have hRpair : Pairwise (Function.onFun Disjoint R) := by
    intro I J hIJ
    exact pairwiseDisjoint_fiberDyadicSelectedRectangles Zf
      (fiberDyadicIntervalAverage F) H (Set.mem_univ I) (Set.mem_univ J) hIJ
  have hRneTop (I : FiberDyadicInterval) :
      (volume.prod μ) (R I) ≠ ∞ := by
    dsimp [R]
    rw [Measure.prod_prod]
    exact ENNReal.mul_ne_top
      (by rw [measure_fiberDyadicInterval]; exact ENNReal.ofReal_ne_top)
      (measure_ne_top μ _)
  have hrect (I : FiberDyadicInterval) :
      (volume.prod μ).real (R I) =
        fiberDyadicIntervalLength I *
          μ.real (fiberDyadicSelectionSet Zf
            (fiberDyadicIntervalAverage F) H I) := by
    change ((volume.prod μ) (R I)).toReal = _
    dsimp [R]
    rw [Measure.prod_prod, measure_fiberDyadicInterval, ENNReal.toReal_mul]
    simp only [ENNReal.toReal_ofReal (fiberDyadicIntervalLength_pos I).le]
    rfl
  have hfinite (T : Finset FiberDyadicInterval) :
      (∑ I ∈ T, (volume.prod μ).real (R I)) ≤
        H⁻¹ * ∫ yz, F yz ∂(volume.prod μ) := by
    calc
      (∑ I ∈ T, (volume.prod μ).real (R I)) =
          ∑ I ∈ T, fiberDyadicIntervalLength I *
            μ.real (fiberDyadicSelectionSet Zf
              (fiberDyadicIntervalAverage F) H I) := by
            apply Finset.sum_congr rfl
            intro I hI
            exact hrect I
      _ = ∫ z, fiberDyadicSelectedLengthDensity T Zf
          (fiberDyadicIntervalAverage F) H z ∂μ :=
        (integral_fiberDyadicSelectedLengthDensity_eq_sum μ T Zf hZf
          (fiberDyadicIntervalAverage F)
          (fun I => measurable_fiberDyadicIntervalAverage F hF_meas I) H).symm
      _ = (volume.prod μ).real
          (fiberDyadicExceptionalSetFinset T Zf
            (fiberDyadicIntervalAverage F) H) :=
        (measureReal_fiberDyadicExceptionalSetFinset_eq_integral μ T Zf hZf
          (fiberDyadicIntervalAverage F)
          (fun I => measurable_fiberDyadicIntervalAverage F hF_meas I) H).symm
      _ ≤ H⁻¹ * ∫ yz, F yz ∂(volume.prod μ) :=
        measureReal_fiberDyadicExceptionalSetFinset_le_inv_mul_integral μ Zf hZf
          F hF hF_nonneg hF_meas H hH T hfiber
  unfold fiberDyadicExceptionalSet
  change ((volume.prod μ) (⋃ I, R I)).toReal ≤ _
  rw [measure_iUnion hRpair hRmeas, ENNReal.tsum_toReal_eq hRneTop]
  apply Real.tsum_le_of_sum_le
  · intro I
    exact ENNReal.toReal_nonneg
  · intro T
    exact hfinite T

/-- The countable exceptional-set weak bound specialized to the natural
finite-fiber-mass selection. -/
theorem measureReal_fiberDyadicExceptionalSet_le_inv_mul_integral_of_fiberFiniteMass
    {Z : Type*} [MeasurableSpace Z] (μ : Measure Z) [IsFiniteMeasure μ]
    (F : ℝ × Z → ℝ) (hF : Integrable F (volume.prod μ))
    (hF_nonneg : ∀ yz : ℝ × Z, 0 ≤ F yz)
    (hF_meas : Measurable F)
    (H : ℝ) (hH : 0 < H) :
    (volume.prod μ).real
      (fiberDyadicExceptionalSet
        (fiberFiniteMassSet (fun yz : ℝ × Z => ENNReal.ofReal (F yz)))
        (fiberDyadicIntervalAverage F) H) ≤
      H⁻¹ * ∫ yz, F yz ∂(volume.prod μ) := by
  apply measureReal_fiberDyadicExceptionalSet_le_inv_mul_integral μ
    (fiberFiniteMassSet (fun yz : ℝ × Z => ENNReal.ofReal (F yz)))
  · exact measurableSet_fiberFiniteMassSet
      (fun yz : ℝ × Z => ENNReal.ofReal (F yz)) hF_meas.ennreal_ofReal
  · exact hF
  · exact hF_nonneg
  · exact hF_meas
  · exact hH
  · intro z hz
    exact mem_fiberFiniteMassSet_integrable F hF_meas hF_nonneg z hz

/-! ### Sigma-finite transverse stopping terminal -/

/-- A countable pairwise-disjoint measurable union has the expected real
measure bound whenever every member has finite measure and all finite partial
sums obey the same bound. This is the `toReal` additivity step needed when
the transverse fiber measure is Lebesgue measure rather than a finite
localization. -/
theorem measureReal_iUnion_le_of_pairwise_disjoint
    {X ι : Type*} [MeasurableSpace X] [Countable ι] (μ : Measure X)
    (R : ι → Set X)
    (hRmeas : ∀ i, MeasurableSet (R i))
    (hRpair : Pairwise (Function.onFun Disjoint R))
    (hRneTop : ∀ i, μ (R i) ≠ ∞)
    (B : ℝ)
    (hfinite : ∀ T : Finset ι, (∑ i ∈ T, μ.real (R i)) ≤ B) :
    μ.real (⋃ i, R i) ≤ B := by
  change (μ (⋃ i, R i)).toReal ≤ B
  rw [measure_iUnion hRpair hRmeas, ENNReal.tsum_toReal_eq hRneTop]
  apply Real.tsum_le_of_sum_le
  · intro i
    exact ENNReal.toReal_nonneg
  · intro T
    exact hfinite T

/-- The finite selected-length Fubini identity only needs the finitely many
selected transverse fibers to have finite measure; the ambient transverse
measure itself may be sigma-finite. -/
theorem integral_fiberDyadicSelectedLengthDensity_eq_sum_of_measure_ne_top
    {Z : Type*} [MeasurableSpace Z] (μ : Measure Z)
    (T : Finset FiberDyadicInterval)
    (Zf : Set Z) (hZf : MeasurableSet Zf)
    (A : FiberDyadicInterval → Z → ℝ)
    (hA : ∀ I, Measurable (A I)) (H : ℝ)
    (hfinite : ∀ I ∈ T,
      μ (fiberDyadicSelectionSet Zf A H I) ≠ ∞) :
    (∫ z, fiberDyadicSelectedLengthDensity T Zf A H z ∂μ) =
      ∑ I ∈ T, fiberDyadicIntervalLength I *
        μ.real (fiberDyadicSelectionSet Zf A H I) := by
  unfold fiberDyadicSelectedLengthDensity
  rw [integral_finsetSum]
  · apply Finset.sum_congr rfl
    intro I hI
    let S : Set Z := fiberDyadicSelectionSet Zf A H I
    have hS : MeasurableSet S :=
      measurableSet_fiberDyadicSelectionSet Zf hZf A hA H I
    have hrewrite : (fun z : Z => fiberDyadicIntervalLength I *
        S.indicator (fun _ => (1 : ℝ)) z) =
        S.indicator (fun _ => fiberDyadicIntervalLength I) := by
      funext z
      by_cases hz : z ∈ S <;> simp [S, hz]
    rw [hrewrite, integral_indicator_const _ hS]
    simp only [smul_eq_mul]
    ring
  · intro I hI
    let S : Set Z := fiberDyadicSelectionSet Zf A H I
    have hS : MeasurableSet S :=
      measurableSet_fiberDyadicSelectionSet Zf hZf A hA H I
    have hrewrite : (fun z : Z => fiberDyadicIntervalLength I *
        S.indicator (fun _ => (1 : ℝ)) z) =
        S.indicator (fun _ => fiberDyadicIntervalLength I) := by
      funext z
      by_cases hz : z ∈ S <;> simp [S, hz]
    rw [hrewrite, integrable_indicator_iff hS]
    exact integrableOn_const (hfinite I hI)

/-- The real measure of a finite selected exceptional set is its selected
length-density integral under local finiteness of the selected fibers. -/
theorem measureReal_fiberDyadicExceptionalSetFinset_eq_integral_of_measure_ne_top
    {Z : Type*} [MeasurableSpace Z] (μ : Measure Z) [SFinite μ]
    (T : Finset FiberDyadicInterval)
    (Zf : Set Z) (hZf : MeasurableSet Zf)
    (A : FiberDyadicInterval → Z → ℝ)
    (hA : ∀ I, Measurable (A I)) (H : ℝ)
    (hfinite : ∀ I ∈ T,
      μ (fiberDyadicSelectionSet Zf A H I) ≠ ∞) :
    (volume.prod μ).real (fiberDyadicExceptionalSetFinset T Zf A H) =
      ∫ z, fiberDyadicSelectedLengthDensity T Zf A H z ∂μ := by
  change ((volume.prod μ) (fiberDyadicExceptionalSetFinset T Zf A H)).toReal = _
  rw [measure_fiberDyadicExceptionalSetFinset_eq μ T Zf hZf A hA H]
  rw [ENNReal.toReal_sum]
  · calc
      (∑ I ∈ T, (volume (fiberDyadicInterval I) *
        μ (fiberDyadicSelectionSet Zf A H I)).toReal) =
          ∑ I ∈ T, fiberDyadicIntervalLength I *
            μ.real (fiberDyadicSelectionSet Zf A H I) := by
          apply Finset.sum_congr rfl
          intro I hI
          rw [measure_fiberDyadicInterval, ENNReal.toReal_mul]
          simp only [ENNReal.toReal_ofReal (fiberDyadicIntervalLength_pos I).le]
          rfl
      _ = ∫ z, fiberDyadicSelectedLengthDensity T Zf A H z ∂μ :=
        (integral_fiberDyadicSelectedLengthDensity_eq_sum_of_measure_ne_top
          μ T Zf hZf A hA H hfinite).symm
  · intro I hI
    apply ENNReal.mul_ne_top
    · rw [measure_fiberDyadicInterval]
      exact ENNReal.ofReal_ne_top
    · exact hfinite I hI

/-- The finite stopping exceptional set satisfies the source weak-one bound
for a sigma-finite transverse measure when its selected fibers are locally
finite. -/
theorem measureReal_fiberDyadicExceptionalSetFinset_le_inv_mul_integral_of_measure_ne_top
    {Z : Type*} [MeasurableSpace Z] (μ : Measure Z) [SFinite μ]
    (Zf : Set Z) (hZf : MeasurableSet Zf)
    (F : ℝ × Z → ℝ) (hF : Integrable F (volume.prod μ))
    (hF_nonneg : ∀ yz : ℝ × Z, 0 ≤ F yz)
    (hF_meas : Measurable F)
    (H : ℝ) (hH : 0 < H) (T : Finset FiberDyadicInterval)
    (hfiber : ∀ z ∈ Zf, Integrable (fun y : ℝ => F (y, z)) volume)
    (hfinite : ∀ I ∈ T,
      μ (fiberDyadicSelectionSet Zf (fiberDyadicIntervalAverage F) H I) ≠ ∞) :
    (volume.prod μ).real
      (fiberDyadicExceptionalSetFinset T Zf
        (fiberDyadicIntervalAverage F) H) ≤
      H⁻¹ * ∫ yz, F yz ∂(volume.prod μ) := by
  rw [measureReal_fiberDyadicExceptionalSetFinset_eq_integral_of_measure_ne_top
    μ T Zf hZf (fiberDyadicIntervalAverage F)
    (fun I => measurable_fiberDyadicIntervalAverage F hF_meas I) H hfinite]
  exact integral_fiberDyadicSelectedLengthDensity_le_inv_mul_integral μ Zf hZf
    F hF hF_nonneg hF_meas H hH T hfiber

/-- Countable selected rectangles obey the source weak-one measure estimate
over a sigma-finite transverse space once each selected fiber is finite. -/
theorem measureReal_fiberDyadicExceptionalSet_le_inv_mul_integral_of_measure_ne_top
    {Z : Type*} [MeasurableSpace Z] (μ : Measure Z) [SFinite μ]
    (Zf : Set Z) (hZf : MeasurableSet Zf)
    (F : ℝ × Z → ℝ) (hF : Integrable F (volume.prod μ))
    (hF_nonneg : ∀ yz : ℝ × Z, 0 ≤ F yz)
    (hF_meas : Measurable F)
    (H : ℝ) (hH : 0 < H)
    (hfiber : ∀ z ∈ Zf, Integrable (fun y : ℝ => F (y, z)) volume)
    (hfinite : ∀ I : FiberDyadicInterval,
      μ (fiberDyadicSelectionSet Zf (fiberDyadicIntervalAverage F) H I) ≠ ∞) :
    (volume.prod μ).real
      (fiberDyadicExceptionalSet Zf (fiberDyadicIntervalAverage F) H) ≤
      H⁻¹ * ∫ yz, F yz ∂(volume.prod μ) := by
  classical
  let R : FiberDyadicInterval → Set (ℝ × Z) := fun I =>
    fiberDyadicInterval I ×ˢ
      fiberDyadicSelectionSet Zf (fiberDyadicIntervalAverage F) H I
  have hRmeas (I : FiberDyadicInterval) : MeasurableSet (R I) := by
    dsimp [R]
    exact (measurableSet_fiberDyadicInterval I).prod
      (measurableSet_fiberDyadicSelectionSet Zf hZf
        (fiberDyadicIntervalAverage F)
        (fun J => measurable_fiberDyadicIntervalAverage F hF_meas J) H I)
  have hRpair : Pairwise (Function.onFun Disjoint R) := by
    intro I J hIJ
    exact pairwiseDisjoint_fiberDyadicSelectedRectangles Zf
      (fiberDyadicIntervalAverage F) H (Set.mem_univ I) (Set.mem_univ J) hIJ
  have hRneTop (I : FiberDyadicInterval) :
      (volume.prod μ) (R I) ≠ ∞ := by
    dsimp [R]
    rw [Measure.prod_prod]
    exact ENNReal.mul_ne_top
      (by rw [measure_fiberDyadicInterval]; exact ENNReal.ofReal_ne_top)
      (hfinite I)
  have hrect (I : FiberDyadicInterval) :
      (volume.prod μ).real (R I) =
        fiberDyadicIntervalLength I *
          μ.real (fiberDyadicSelectionSet Zf
            (fiberDyadicIntervalAverage F) H I) := by
    change ((volume.prod μ) (R I)).toReal = _
    dsimp [R]
    rw [Measure.prod_prod, measure_fiberDyadicInterval, ENNReal.toReal_mul]
    simp only [ENNReal.toReal_ofReal (fiberDyadicIntervalLength_pos I).le]
    rfl
  have hpartial (T : Finset FiberDyadicInterval) :
      (∑ I ∈ T, (volume.prod μ).real (R I)) ≤
        H⁻¹ * ∫ yz, F yz ∂(volume.prod μ) := by
    calc
      (∑ I ∈ T, (volume.prod μ).real (R I)) =
          ∑ I ∈ T, fiberDyadicIntervalLength I *
            μ.real (fiberDyadicSelectionSet Zf
              (fiberDyadicIntervalAverage F) H I) := by
            apply Finset.sum_congr rfl
            intro I hI
            exact hrect I
      _ = ∫ z, fiberDyadicSelectedLengthDensity T Zf
          (fiberDyadicIntervalAverage F) H z ∂μ :=
        (integral_fiberDyadicSelectedLengthDensity_eq_sum_of_measure_ne_top
          μ T Zf hZf (fiberDyadicIntervalAverage F)
          (fun I => measurable_fiberDyadicIntervalAverage F hF_meas I) H
          (fun I _ => hfinite I)).symm
      _ = (volume.prod μ).real
          (fiberDyadicExceptionalSetFinset T Zf
            (fiberDyadicIntervalAverage F) H) :=
        (measureReal_fiberDyadicExceptionalSetFinset_eq_integral_of_measure_ne_top
          μ T Zf hZf (fiberDyadicIntervalAverage F)
          (fun I => measurable_fiberDyadicIntervalAverage F hF_meas I) H
          (fun I _ => hfinite I)).symm
      _ ≤ H⁻¹ * ∫ yz, F yz ∂(volume.prod μ) :=
        measureReal_fiberDyadicExceptionalSetFinset_le_inv_mul_integral_of_measure_ne_top
          μ Zf hZf F hF hF_nonneg hF_meas H hH T hfiber
          (fun I _ => hfinite I)
  unfold fiberDyadicExceptionalSet
  change (volume.prod μ).real (⋃ I, R I) ≤ _
  exact measureReal_iUnion_le_of_pairwise_disjoint
    (volume.prod μ) R hRmeas hRpair hRneTop
    (H⁻¹ * ∫ yz, F yz ∂(volume.prod μ)) hpartial

/-- Global integrability of the nonnegative stopping field makes every
individual selected transverse fiber set finite. -/
theorem measure_fiberDyadicSelectionSet_ne_top_of_integrable
    {Z : Type*} [MeasurableSpace Z] (μ : Measure Z) [SFinite μ]
    (Zf : Set Z) (F : ℝ × Z → ℝ)
    (hF : Integrable F (volume.prod μ))
    (hF_nonneg : ∀ yz : ℝ × Z, 0 ≤ F yz)
    (H : ℝ) (hH : 0 < H) (I : FiberDyadicInterval) :
    μ (fiberDyadicSelectionSet Zf (fiberDyadicIntervalAverage F) H I) ≠ ∞ := by
  let D : Set (ℝ × Z) := fiberDyadicInterval I ×ˢ Set.univ
  let G : ℝ × Z → ℝ := D.indicator F
  have hD : MeasurableSet D :=
    (measurableSet_fiberDyadicInterval I).prod MeasurableSet.univ
  have hG : Integrable G (volume.prod μ) := by
    dsimp [G]
    exact hF.indicator hD
  let A : Z → ℝ := fiberDyadicIntervalAverage F I
  have hA : Integrable A μ := by
    change Integrable (fun z : Z =>
      (fiberDyadicIntervalLength I)⁻¹ * ∫ y : ℝ, G (y, z)) μ
    exact hG.integral_prod_right.const_mul _
  let Q : Z → ℝ := fun z => H⁻¹ * A z
  have hQ : Integrable Q μ := hA.const_mul H⁻¹
  have hQnonneg (z : Z) : 0 ≤ Q z := by
    dsimp [Q, A]
    apply mul_nonneg
    · exact inv_nonneg.mpr hH.le
    · apply mul_nonneg
      · exact inv_nonneg.mpr (fiberDyadicIntervalLength_pos I).le
      · apply integral_nonneg
        intro y
        dsimp [G, D]
        by_cases hy : y ∈ fiberDyadicInterval I <;>
          simp [hy, hF_nonneg (y, z)]
  let S : Set Z := fiberDyadicSelectionSet Zf (fiberDyadicIntervalAverage F) H I
  have hS : ∀ z ∈ S, 1 ≤ Q z := by
    intro z hz
    have hlt : H < fiberDyadicIntervalAverage F I z := hz.1.2
    have hdiv : 1 < fiberDyadicIntervalAverage F I z / H :=
      (one_lt_div hH).mpr hlt
    have heq : fiberDyadicIntervalAverage F I z / H = Q z := by
      dsimp [Q, A]
      field_simp
    exact hdiv.le.trans_eq heq
  have hmeasure : μ S ≤ ENNReal.ofReal (∫ z, Q z ∂μ) :=
    hQ.measure_le_integral (Filter.Eventually.of_forall hQnonneg) hS
  exact ne_of_lt (hmeasure.trans_lt ENNReal.ofReal_lt_top)

/-- The countable stopping exceptional set has its source weak-one bound on
the actual sigma-finite transverse Lebesgue space. -/
theorem measureReal_fiberDyadicExceptionalSet_le_inv_mul_integral_of_integrable
    {Z : Type*} [MeasurableSpace Z] (μ : Measure Z) [SFinite μ]
    (Zf : Set Z) (hZf : MeasurableSet Zf)
    (F : ℝ × Z → ℝ) (hF : Integrable F (volume.prod μ))
