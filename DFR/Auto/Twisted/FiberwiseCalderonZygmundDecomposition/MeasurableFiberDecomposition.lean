theorem setIntegral_modelScaleProfile_eq_modelFullForm_restrict
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (A : Set ℝ) (hAmeas : MeasurableSet A) (hApos : A ⊆ Set.Ioi (0 : ℝ)) :
    (∫ t in A, c t * ModelSpatialProfile α u F t
      ∂((volume : Measure ℝ).withDensity cubeScaleDensity)) =
      ModelFullForm α u (RestrictScaleCoefficient c A) F := by
  let P : ℝ → ℝ := ModelSpatialProfile α u F
  unfold ModelFullForm
  change (∫ t in A, c t * P t
      ∂((volume : Measure ℝ).withDensity cubeScaleDensity)) =
    ∫ t in Set.Ioi (0 : ℝ),
      RestrictScaleCoefficient c A t * P t
      ∂((volume : Measure ℝ).withDensity cubeScaleDensity)
  rw [← MeasureTheory.integral_indicator hAmeas,
    ← MeasureTheory.integral_indicator measurableSet_Ioi]
  apply integral_congr_ae
  filter_upwards [] with t
  by_cases htA : t ∈ A
  · have htpos : t ∈ Set.Ioi (0 : ℝ) := hApos htA
    rw [Set.indicator_of_mem htA, Set.indicator_of_mem htpos,
      RestrictScaleCoefficient, Set.indicator_of_mem htA]
  · by_cases htpos : t ∈ Set.Ioi (0 : ℝ)
    · rw [Set.indicator_of_notMem htA, Set.indicator_of_mem htpos,
        RestrictScaleCoefficient, Set.indicator_of_notMem htA]
      ring
    · rw [Set.indicator_of_notMem htA, Set.indicator_of_notMem htpos]

