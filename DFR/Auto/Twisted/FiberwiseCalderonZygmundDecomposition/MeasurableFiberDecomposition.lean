/-! ## Section 9 coordinate-permuted finite model forms -/

/-- Extend a spatial-coordinate permutation by fixing the outer model input
and relabeling the three convolved inputs. -/
def modelInputIndex (σ : Equiv.Perm (Fin 3)) : Fin 4 → Fin 4 :=
  Fin.cases 0 (fun j ↦ (σ j).succ)

@[simp] theorem modelInputIndex_zero (σ : Equiv.Perm (Fin 3)) :
    modelInputIndex σ 0 = 0 := rfl

@[simp] theorem modelInputIndex_succ (σ : Equiv.Perm (Fin 3))
    (j : Fin 3) :
    modelInputIndex σ j.succ = (σ j).succ := rfl

/-- Pull a real spatial input back along the inverse coordinate relabeling,
as in the data transformation in `lem:permutation`. -/
noncomputable def coordinatePullback
    (σ : Equiv.Perm (Fin 3)) (f : E3 → ℝ) : E3 → ℝ :=
  fun x ↦ f ((coordinatePermutation σ).symm x)

@[simp] theorem coordinatePullback_apply
    (σ : Equiv.Perm (Fin 3)) (f : E3 → ℝ) (x : E3) :
    coordinatePullback σ f x =
      f ((coordinatePermutation σ).symm x) := rfl

/-- The permuted Schwartz tuple in the source coordinate-permutation lemma. -/
noncomputable def permutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelSchwartzInput) : ModelSchwartzInput :=
  fun j ↦ (SchwartzMap.compCLMOfContinuousLinearEquiv ℝ
    (coordinatePermutation σ).symm.toContinuousLinearEquiv)
      (F (modelInputIndex σ j))

@[simp] theorem permutedModelInput_apply
    (σ : Equiv.Perm (Fin 3)) (F : ModelSchwartzInput)
    (j : Fin 4) (x : E3) :
    permutedModelInput σ F j x =
      F (modelInputIndex σ j) ((coordinatePermutation σ).symm x) := by
  simp [permutedModelInput,
    SchwartzMap.compCLMOfContinuousLinearEquiv_apply]

/-- The corresponding tuple after forgetting Schwartz structure. -/
noncomputable def permutedModelRealInput
    (σ : Equiv.Perm (Fin 3)) (f : ModelRealInput) : ModelRealInput :=
  fun j ↦ coordinatePullback σ (f (modelInputIndex σ j))

@[simp] theorem permutedModelRealInput_apply
    (σ : Equiv.Perm (Fin 3)) (f : ModelRealInput)
    (j : Fin 4) (x : E3) :
    permutedModelRealInput σ f j x =
      f (modelInputIndex σ j) ((coordinatePermutation σ).symm x) := rfl

@[simp] theorem permutedModelRealInput_of_schwartz
    (σ : Equiv.Perm (Fin 3)) (F : ModelSchwartzInput) :
    InitialModelRealInput (permutedModelInput σ F) =
      permutedModelRealInput σ (InitialModelRealInput F) := by
  funext j x
  simp [InitialModelRealInput]

/-- The literal one-dimensional kernel at spatial coordinate `j` when the
annular (third) kernel is active at coordinate `i`. -/
noncomputable def activeModelKernel
    (i j : Fin 3) (u : E3) : ℝ → ℝ :=
  if j = i then ModelThirdKernel (u j) else ModelLowKernel (u j)

/-- The inverse coordinate relabeling has the expected coordinate formula. -/
@[simp] theorem coordinatePermutation_symm_apply
    (σ : Equiv.Perm (Fin 3)) (x : E3) (i : Fin 3) :
    (coordinatePermutation σ).symm x i = x (σ.symm i) := by
  have h := congrArg (fun y : E3 ↦ y (σ.symm i))
    ((coordinatePermutation σ).apply_symm_apply x)
  simpa only [coordinatePermutation_apply, Equiv.apply_symm_apply] using h

/-- Pulling a shifted coordinate line back through the coordinate relabeling
gives the corresponding shifted line in the original coordinate. -/
theorem coordinatePermutation_symm_sub_smul_coordinateDirection
    (σ : Equiv.Perm (Fin 3)) (j : Fin 3) (x : E3) (r : ℝ) :
    (coordinatePermutation σ).symm
      (coordinatePermutation σ x - r • Anisotropy.coordinateDirection j) =
        x - r • Anisotropy.coordinateDirection (σ j) := by
  rw [map_sub, map_smul, (coordinatePermutation σ).symm_apply_apply]
  congr 1
  ext k
  simp [coordinatePermutation_symm_apply, coordinateDirection_apply,
    Equiv.symm_apply_eq]

/-- The forward relabeling sends the original `σ j` coordinate line to the
new `j` coordinate line. -/
theorem coordinatePermutation_coordinateDirection
    (σ : Equiv.Perm (Fin 3)) (j : Fin 3) :
    coordinatePermutation σ (Anisotropy.coordinateDirection (σ j)) =
      Anisotropy.coordinateDirection j := by
  have hsymm : (coordinatePermutation σ).symm
      (Anisotropy.coordinateDirection j) =
        Anisotropy.coordinateDirection (σ j) := by
    ext k
    simp [coordinatePermutation_symm_apply, coordinateDirection_apply,
      Equiv.symm_apply_eq]
  rw [← hsymm, (coordinatePermutation σ).apply_symm_apply]

/-- The forward coordinate change carries the original `σ j` fiber shift to
the standard `j` fiber shift. -/
theorem coordinatePermutation_sub_smul_coordinateDirection
    (σ : Equiv.Perm (Fin 3)) (j : Fin 3) (x : E3) (r : ℝ) :
    coordinatePermutation σ
      (x - r • Anisotropy.coordinateDirection (σ j)) =
        coordinatePermutation σ x - r • Anisotropy.coordinateDirection j := by
  rw [map_sub, map_smul,
    coordinatePermutation_coordinateDirection]

/-- A literal one-coordinate convolution commutes with relabeling its
spatial coordinate. The kernel and its scale parameter remain unchanged. -/
theorem ModelCoordinateConvolution_coordinatePermutation
    (σ : Equiv.Perm (Fin 3)) (j : Fin 3)
    (f : E3 → ℝ) (k : ℝ → ℝ) (s : ℝ) (x : E3) :
    ModelCoordinateConvolution j (coordinatePullback σ f) k s
      (coordinatePermutation σ x) =
        ModelCoordinateConvolution (σ j) f k s x := by
  unfold ModelCoordinateConvolution
  apply integral_congr_ae
  filter_upwards [] with r
  rw [coordinatePullback_apply,
    coordinatePermutation_symm_sub_smul_coordinateDirection]

/-- The active kernel itself transports correctly when `σ 2` is the active
source coordinate. -/
theorem activeModelKernel_coordinatePermutation
    (σ : Equiv.Perm (Fin 3)) (i : Fin 3) (u : E3)
    (hσ : σ 2 = i) (j : Fin 3) :
    activeModelKernel 2 j (coordinatePermutation σ u) =
      activeModelKernel i (σ j) u := by
  by_cases hj : j = 2
  · subst j
    simp [activeModelKernel, hσ]
  · have hσj : σ j ≠ i := by
      intro h
      apply hj
      apply σ.injective
      simpa [hσ] using h
    simp [activeModelKernel, hj, hσj]

/-- Each relabeled convolved input is literally the pullback of the input
whose index was transported by the spatial permutation. -/
theorem permutedModelInput_succ_asFun
    (σ : Equiv.Perm (Fin 3)) (F : ModelSchwartzInput) (j : Fin 3) :
    (permutedModelInput σ F j.succ : E3 → ℝ) =
      coordinatePullback σ (F (σ j).succ : E3 → ℝ) := by
  funext x
  simp [coordinatePullback]

/-- The distinguished outer input is unchanged after evaluating the
relabeled tuple at the correspondingly relabeled point. -/
theorem permutedModelInput_zero_coordinatePermutation
    (σ : Equiv.Perm (Fin 3)) (F : ModelSchwartzInput) (x : E3) :
    permutedModelInput σ F 0 (coordinatePermutation σ x) = F 0 x := by
  rw [permutedModelInput_apply]
  simp only [Fin.isValue, modelInputIndex_zero, LinearIsometryEquiv.symm_apply_apply]

/-- One convolved factor of the active-third model after relabeling is the
factor in the corresponding original spatial coordinate. -/
theorem activeModelCoordinateFactor_permute_to_two
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (F : ModelSchwartzInput) (hσ : σ 2 = i)
    (t : ℝ) (x : E3) (j : Fin 3) :
    ModelCoordinateConvolution j (permutedModelInput σ F j.succ)
        (activeModelKernel 2 j (coordinatePermutation σ u))
        (t ^ (permutedAnisotropy α σ).weight j)
        (coordinatePermutation σ x) =
      ModelCoordinateConvolution (σ j) (F (σ j).succ)
        (activeModelKernel i (σ j) u)
        (t ^ α.weight (σ j)) x := by
  rw [permutedModelInput_succ_asFun,
    activeModelKernel_coordinatePermutation σ i u hσ j,
    permutedAnisotropy_weight]
  exact ModelCoordinateConvolution_coordinatePermutation σ j
    (F (σ j).succ) (activeModelKernel i (σ j) u)
    (t ^ α.weight (σ j)) x

/-- The inverse coordinate map is also Lebesgue-measure preserving. -/
theorem coordinatePermutation_symm_measurePreserving
    (σ : Equiv.Perm (Fin 3)) :
    MeasurePreserving (coordinatePermutation σ).symm volume volume := by
  have hmp : MeasurePreserving (coordinatePermutation σ).toMeasurableEquiv
      volume volume := by
    simpa using coordinatePermutation_measurePreserving σ
  simpa using MeasurePreserving.symm
    (coordinatePermutation σ).toMeasurableEquiv hmp

/-- Pullback along a coordinate permutation preserves all finite or
infinite `L^p` membership statements. -/
theorem memLp_coordinatePullback
    (σ : Equiv.Perm (Fin 3)) (f : E3 → ℝ) (p : ℝ≥0∞)
    (hf : MemLp f p volume) :
    MemLp (coordinatePullback σ f) p volume := by
  change MemLp (f ∘ (coordinatePermutation σ).symm) p volume
  exact hf.comp_measurePreserving
    (coordinatePermutation_symm_measurePreserving σ)

/-- The `L^p` seminorm of a measurable function is unchanged by coordinate
pullback. This is the norm-preservation interface for the permutation
argument. -/
theorem eLpNorm_coordinatePullback
    (σ : Equiv.Perm (Fin 3)) (f : E3 → ℝ) (p : ℝ≥0∞)
    (hf : AEStronglyMeasurable f volume) :
    eLpNorm (coordinatePullback σ f) p volume =
      eLpNorm f p volume := by
  change eLpNorm (f ∘ (coordinatePermutation σ).symm) p volume =
    eLpNorm f p volume
  exact eLpNorm_comp_measurePreserving hf
    (coordinatePermutation_symm_measurePreserving σ)

/-- Componentwise `L^p` membership is preserved by the relabeled Schwartz
tuple. -/
theorem memLp_permutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelSchwartzInput)
    (j : Fin 4) (p : ℝ≥0∞)
    (hF : MemLp (F (modelInputIndex σ j) : E3 → ℝ) p volume) :
    MemLp (permutedModelInput σ F j : E3 → ℝ) p volume := by
  rw [show (permutedModelInput σ F j : E3 → ℝ) =
    coordinatePullback σ (F (modelInputIndex σ j) : E3 → ℝ) by
      funext x
      exact permutedModelInput_apply σ F j x]
  exact memLp_coordinatePullback σ _ p hF

/-- Componentwise `L^p` seminorms of the relabeled Schwartz tuple agree
with the seminorms of the corresponding original components. -/
theorem eLpNorm_permutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelSchwartzInput)
    (j : Fin 4) (p : ℝ≥0∞) :
    eLpNorm (permutedModelInput σ F j : E3 → ℝ) p volume =
      eLpNorm (F (modelInputIndex σ j) : E3 → ℝ) p volume := by
  rw [show (permutedModelInput σ F j : E3 → ℝ) =
    coordinatePullback σ (F (modelInputIndex σ j) : E3 → ℝ) by
      funext x
      exact permutedModelInput_apply σ F j x]
  exact eLpNorm_coordinatePullback σ _ p
    (F (modelInputIndex σ j)).continuous.aestronglyMeasurable

/-- A permutation sending the canonical active-third coordinate to any
specified active coordinate is always available. -/
theorem exists_coordinatePermutation_to_active
    (i : Fin 3) : ∃ σ : Equiv.Perm (Fin 3), σ 2 = i := by
  refine ⟨Equiv.swap 2 i, ?_⟩
  simp only [Fin.isValue, Equiv.swap_apply_left]

/-! ### Blueprint-normalized initial-range weight -/

/-- The strict real initial range can be stated with the blueprint's larger
translation weight exponent. -/
theorem initialModelFullForm_bound_weight100
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : InitialModelSchwartzInput)
    (q : Fin 4 → ℝ)
    (hq : ∀ j : Fin 4, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j : Fin 4, sourceStoppingExponent j < q j)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, |c t| ≤ 1) :
    ∃ C : ℝ, 0 ≤ C ∧
      |ModelFullForm α u c F| ≤ C * sourceWeight u ^ 100 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
  obtain ⟨C, hC, hbound⟩ :=
    initialModelFullForm_bound α u c F q hq hsum hqs hcmeas hc
  refine ⟨C, hC, hbound.trans ?_⟩
  have hweight : 1 ≤ sourceWeight u := by
    unfold sourceWeight
    linarith [abs_nonneg (u 0), abs_nonneg (u 1), abs_nonneg (u 2)]
  have hpow : sourceWeight u ^ 75 ≤ sourceWeight u ^ 100 :=
    pow_le_pow_right₀ hweight (by norm_num)
  have hprod : 0 ≤ ∏ j : Fin 4,
      lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
    exact Finset.prod_nonneg fun j _ ↦ lpNorm_nonneg
  calc
    C * sourceWeight u ^ 75 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume =
        (C * ∏ j : Fin 4,
          lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume) *
          sourceWeight u ^ 75 := by ring
    _ ≤ (C * ∏ j : Fin 4,
          lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume) *
          sourceWeight u ^ 100 :=
      mul_le_mul_of_nonneg_left hpow (mul_nonneg hC hprod)
    _ = C * sourceWeight u ^ 100 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
      ring

/-- The three input slots of the fixed truncated model operator. This is the
operator `U^{a,b}_{u,c}` from Section 8 before pairing with the zeroth input.
-/
abbrev ModelOperatorRealInput := Fin 3 → E3 → ℝ

/-- Drop the zeroth (dual) slot from the four Schwartz inputs of the model
form, preserving the source order `1,2,3`. -/
noncomputable def modelOperatorInput (F : ModelSchwartzInput) :
    ModelOperatorRealInput :=
  fun j ↦ F j.succ

@[simp]
theorem modelOperatorInput_apply (F : ModelSchwartzInput) (j : Fin 3) (x : E3) :
    modelOperatorInput F j x = F j.succ x := rfl

/-- The pointwise integrand of the real fixed truncated model operator. -/
noncomputable def modelTruncatedOperatorIntegrand
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelOperatorRealInput)
    (t : ℝ) (x : E3) : ℝ :=
  c t *
    ModelCoordinateConvolution 0 (f 0) (ModelLowKernel (u 0))
      (t ^ α.weight 0) x *
    ModelCoordinateConvolution 1 (f 1) (ModelLowKernel (u 1))
      (t ^ α.weight 1) x *
    ModelCoordinateConvolution 2 (f 2) (ModelThirdKernel (u 2))
      (t ^ α.weight 2) x

/-- The actual real fixed truncated trilinear operator of Section 8. Its
scale measure is exactly the source measure `1_{t>0} dt/t`. -/
noncomputable def ModelTruncatedOperator
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelOperatorRealInput)
    (a b : ℝ) (x : E3) : ℝ :=
  ∫ t in Set.Ioc a b, modelTruncatedOperatorIntegrand α u c f t x
    ∂((volume : Measure ℝ).withDensity cubeScaleDensity)

@[simp]
theorem modelTruncatedOperatorIntegrand_of_modelOperatorInput
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (t : ℝ) (x : E3) :
    modelTruncatedOperatorIntegrand α u c (modelOperatorInput F) t x =
      c t *
        ModelCoordinateConvolution 0 (F 1) (ModelLowKernel (u 0))
          (t ^ α.weight 0) x *
        ModelCoordinateConvolution 1 (F 2) (ModelLowKernel (u 1))
          (t ^ α.weight 1) x *
        ModelCoordinateConvolution 2 (F 3) (ModelThirdKernel (u 2))
          (t ^ α.weight 2) x := by
  rfl

/-- The four-linear product behind the scale-truncated form, arranged with
space first and scale second for Fubini. -/
noncomputable def modelTruncatedOperatorPairingIntegrand
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (t : ℝ) (x : E3) : ℝ :=
  F 0 x * modelTruncatedOperatorIntegrand α u c (modelOperatorInput F) t x

@[simp]
theorem modelTruncatedOperatorPairingIntegrand_eq_modelSpatialIntegrand
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (t : ℝ) (x : E3) :
    modelTruncatedOperatorPairingIntegrand α u c F t x =
      c t * ModelSpatialIntegrand α u F t x := by
  unfold modelTruncatedOperatorPairingIntegrand ModelSpatialIntegrand
    modelTruncatedOperatorIntegrand modelOperatorInput
  norm_num
  ring

/-- Fubini identifies the pre-existing finite scale form with pairing the
fixed truncated operator against its zeroth input. The explicit joint
integrability premise is precisely the finite-interval Young/Hölder
obligation discharged before the one-fiber Calderón--Zygmund argument. -/
theorem modelScaleIntervalTruncation_eq_modelTruncatedOperator_pairing
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (a b : ℝ)
    (hjoint : Integrable (fun xt : E3 × ℝ ↦
      modelTruncatedOperatorPairingIntegrand α u c F xt.2 xt.1)
      ((volume : Measure E3).prod
        (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
          (Set.Ioc a b)))) :
    ModelScaleIntervalTruncation α u c F a b =
      ∫ x : E3, F 0 x *
        ModelTruncatedOperator α u c (modelOperatorInput F) a b x := by
  let ν : Measure ℝ := (volume : Measure ℝ).withDensity cubeScaleDensity
  let I : Set ℝ := Set.Ioc a b
  let H : E3 × ℝ → ℝ := fun xt ↦
    modelTruncatedOperatorPairingIntegrand α u c F xt.2 xt.1
  have hH : Integrable H ((volume : Measure E3).prod (ν.restrict I)) := by
    simpa only [H, ν, I] using hjoint
  have hleft :
      ModelScaleIntervalTruncation α u c F a b =
        ∫ t : ℝ, ∫ x : E3, H (x, t) ∂volume ∂(ν.restrict I) := by
    unfold ModelScaleIntervalTruncation ModelSpatialProfile
    change (∫ t : ℝ in I, c t *
      (∫ x : E3, ModelSpatialIntegrand α u F t x) ∂ν) = _
    apply integral_congr_ae
    filter_upwards [] with t
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards [] with x
    change c t * ModelSpatialIntegrand α u F t x = H (x, t)
    dsimp only [H]
    exact (modelTruncatedOperatorPairingIntegrand_eq_modelSpatialIntegrand
      α u c F t x).symm
  have hright :
      (∫ x : E3, F 0 x *
        ModelTruncatedOperator α u c (modelOperatorInput F) a b x) =
        ∫ x : E3, ∫ t : ℝ, H (x, t) ∂(ν.restrict I) ∂volume := by
    apply integral_congr_ae
    filter_upwards [] with x
    unfold ModelTruncatedOperator
    change F 0 x * (∫ t : ℝ in I,
      modelTruncatedOperatorIntegrand α u c (modelOperatorInput F) t x ∂ν) = _
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards [] with t
    change F 0 x * modelTruncatedOperatorIntegrand α u c
      (modelOperatorInput F) t x = H (x, t)
    rfl
  calc
    ModelScaleIntervalTruncation α u c F a b =
        ∫ t : ℝ, ∫ x : E3, H (x, t) ∂volume ∂(ν.restrict I) := hleft
    _ = ∫ tx : ℝ × E3, H tx.swap ∂((ν.restrict I).prod volume) := by
      symm
      exact MeasureTheory.integral_prod (fun tx : ℝ × E3 ↦ H tx.swap) hH.swap
    _ = ∫ xt : E3 × ℝ, H xt ∂(volume.prod (ν.restrict I)) :=
      MeasureTheory.integral_prod_swap H
    _ = ∫ x : E3, ∫ t : ℝ, H (x, t) ∂(ν.restrict I) ∂volume :=
      MeasureTheory.integral_prod H hH
    _ = ∫ x : E3, F 0 x *
        ModelTruncatedOperator α u c (modelOperatorInput F) a b x := hright.symm

/-- A continuous scalar function is integrable on every positive finite scale
interval for the model's logarithmic scale measure. -/
theorem integrableOn_modelScaleInterval_of_continuous
    {a b : ℝ} (ha : 0 < a) (f : ℝ → ℝ) (hf : Continuous f) :
    IntegrableOn f (Set.Ioc a b)
      ((volume : Measure ℝ).withDensity cubeScaleDensity) := by
  have htop : ∀ᵐ t ∂(volume.restrict (Set.Ioc a b)), cubeScaleDensity t < ∞ := by
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    rw [cubeScaleDensity_eq_of_pos (lt_trans ha ht.1)]
    exact ENNReal.ofReal_lt_top
  unfold IntegrableOn
  rw [restrict_withDensity measurableSet_Ioc]
  rw [integrable_withDensity_iff measurable_cubeScaleDensity htop]
  have heq : (fun t : ℝ ↦ f t * (cubeScaleDensity t).toReal) =ᵐ[
      volume.restrict (Set.Ioc a b)] (fun t ↦ f t / t) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    rw [cubeScaleDensity_eq_of_pos (lt_trans ha ht.1),
      ENNReal.toReal_ofReal (inv_pos.mpr (lt_trans ha ht.1)).le]
    ring
  rw [integrable_congr heq]
  have hcont : ContinuousOn (fun t : ℝ ↦ f t / t) (Set.Icc a b) :=
    hf.continuousOn.div continuousOn_id
      (fun t ht ↦ ne_of_gt (lt_of_lt_of_le ha ht.1))
  exact (hcont.integrableOn_compact isCompact_Icc).mono_set Set.Ioc_subset_Icc_self

/-- The logarithmic scale measure of a positive finite interval is finite. -/
theorem isFiniteMeasure_modelScaleInterval
    {a b : ℝ} (ha : 0 < a) :
    IsFiniteMeasure (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
      (Set.Ioc a b)) := by
  apply (integrable_const_iff_isFiniteMeasure (by norm_num : (1 : ℝ) ≠ 0)).mp
  simpa only [IntegrableOn] using
    (integrableOn_modelScaleInterval_of_continuous ha (fun _ : ℝ ↦ (1 : ℝ))
      continuous_const)

/-- On a positive finite interval, the model scale measure is literally the
oriented interval integral with integrand divided by `t`. -/
theorem integral_modelScaleInterval_withDensity_eq_intervalIntegral
    {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) (f : ℝ → ℝ) :
    ∫ t in Set.Ioc a b, f t ∂((volume : Measure ℝ).withDensity cubeScaleDensity) =
      ∫ t in a..b, f t / t := by
  have htop : ∀ᵐ t ∂(volume.restrict (Set.Ioc a b)), cubeScaleDensity t < ∞ := by
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    rw [cubeScaleDensity_eq_of_pos (lt_trans ha ht.1)]
    exact ENNReal.ofReal_lt_top
  rw [setIntegral_withDensity_eq_setIntegral_toReal_smul
    measurable_cubeScaleDensity htop f measurableSet_Ioc]
  have hpoint : ∀ t ∈ Set.Ioc a b,
      (cubeScaleDensity t).toReal * f t = f t / t := by
    intro t ht
    rw [cubeScaleDensity_eq_of_pos (lt_trans ha ht.1),
      ENNReal.toReal_ofReal (inv_pos.mpr (lt_trans ha ht.1)).le]
    ring
  calc
    ∫ t in Set.Ioc a b, (cubeScaleDensity t).toReal • f t =
        ∫ t in Set.Ioc a b, f t / t := by
      apply setIntegral_congr_fun measurableSet_Ioc
      intro t ht
      change (cubeScaleDensity t).toReal * f t = f t / t
      exact hpoint t ht
    _ = ∫ t in a..b, f t / t :=
      (intervalIntegral.integral_of_le hab).symm

/-- The elementary `L^∞` Young estimate on one coordinate fiber. It is the
finite-scale boundedness input used before the density and good--bad
identities in Section 8. -/
theorem abs_ModelCoordinateConvolution_le_of_bounded
    (i : Fin 3) (f : E3 → ℝ) (k : ℝ → ℝ) (s : ℝ) (x : E3)
    (hf : Continuous f) (B : ℝ)
    (hfB : ∀ y : E3, |f y| ≤ B) (hk : Integrable k) (hs : 0 < s) :
    |ModelCoordinateConvolution i f k s x| ≤
      B * ∫ r : ℝ, |k r| := by
  let kd : ℝ → ℝ := fun r ↦ kernelDilate k s r
  let G : ℝ → ℝ := fun r ↦
    f (x - r • Anisotropy.coordinateDirection i) * kd r
  have hkd : Integrable kd := by
    dsimp only [kd]
    exact integrable_kernelDilate hk hs.ne'
  have hmap : Continuous (fun r : ℝ ↦
      x - r • Anisotropy.coordinateDirection i) :=
    continuous_const.sub (continuous_id.smul continuous_const)
  have hGmeas : AEStronglyMeasurable G volume := by
    dsimp only [G]
    exact ((hf.comp hmap).aestronglyMeasurable).mul hkd.aestronglyMeasurable
  have hupper : Integrable (fun r : ℝ ↦ B * |kd r|) :=
    hkd.norm.const_mul B
  have hG : Integrable G := by
    apply hupper.mono' hGmeas
    filter_upwards [] with r
    dsimp only [G]
    rw [Real.norm_eq_abs, abs_mul]
    exact mul_le_mul_of_nonneg_right
      (hfB (x - r • Anisotropy.coordinateDirection i)) (abs_nonneg _)
  unfold ModelCoordinateConvolution
  change |∫ r : ℝ, G r| ≤ B * ∫ r : ℝ, |k r|
  calc
    |∫ r : ℝ, G r| ≤ ∫ r : ℝ, |G r| :=
      MeasureTheory.abs_integral_le_integral_abs
    _ ≤ ∫ r : ℝ, B * |kd r| := by
      apply integral_mono hG.norm hupper
      intro r
      dsimp only [G]
      rw [Real.norm_eq_abs, abs_mul]
      exact mul_le_mul_of_nonneg_right
        (hfB (x - r • Anisotropy.coordinateDirection i)) (abs_nonneg _)
    _ = B * ∫ r : ℝ, |kd r| := by
      rw [integral_const_mul]
    _ = B * ∫ r : ℝ, |k r| := by
      rw [integral_abs_kernelDilate k hs]

/-- At one positive scale, the fixed model-operator integrand is bounded by
the product of the three fiber `L^∞` Young bounds. -/
theorem abs_modelTruncatedOperatorIntegrand_le_of_bounded
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelOperatorRealInput)
    (t : ℝ) (x : E3) (ht : 0 < t) (C : ℝ) (B : Fin 3 → ℝ)
    (hC : 0 ≤ C) (hc : |c t| ≤ C)
    (hf : ∀ j, Continuous (f j)) (hB : ∀ j, 0 ≤ B j)
    (hfB : ∀ j, ∀ y : E3, |f j y| ≤ B j) :
    |modelTruncatedOperatorIntegrand α u c f t x| ≤
      C * (B 0 * ∫ r : ℝ, |ModelLowKernel (u 0) r|) *
        (B 1 * ∫ r : ℝ, |ModelLowKernel (u 1) r|) *
          (B 2 * ∫ r : ℝ, |ModelThirdKernel (u 2) r|) := by
  have hs0 : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs1 : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs2 : 0 < t ^ α.weight 2 := pow_pos ht _
  have h0 := abs_ModelCoordinateConvolution_le_of_bounded
    0 (f 0) (ModelLowKernel (u 0)) (t ^ α.weight 0) x
    (hf 0) (B 0) (hfB 0) (integrable_ModelLowKernel (u 0)) hs0
  have h1 := abs_ModelCoordinateConvolution_le_of_bounded
    1 (f 1) (ModelLowKernel (u 1)) (t ^ α.weight 1) x
    (hf 1) (B 1) (hfB 1) (integrable_ModelLowKernel (u 1)) hs1
  have h2 := abs_ModelCoordinateConvolution_le_of_bounded
    2 (f 2) (ModelThirdKernel (u 2)) (t ^ α.weight 2) x
    (hf 2) (B 2) (hfB 2) (integrable_ModelThirdKernel (u 2)) hs2
  have hM0 : 0 ≤ ∫ r : ℝ, |ModelLowKernel (u 0) r| :=
    integral_nonneg fun _ ↦ abs_nonneg _
  have hM1 : 0 ≤ ∫ r : ℝ, |ModelLowKernel (u 1) r| :=
    integral_nonneg fun _ ↦ abs_nonneg _
  have hM2 : 0 ≤ ∫ r : ℝ, |ModelThirdKernel (u 2) r| :=
    integral_nonneg fun _ ↦ abs_nonneg _
  have hD0 : 0 ≤ B 0 * ∫ r : ℝ, |ModelLowKernel (u 0) r| :=
    mul_nonneg (hB 0) hM0
  have hD1 : 0 ≤ B 1 * ∫ r : ℝ, |ModelLowKernel (u 1) r| :=
    mul_nonneg (hB 1) hM1
  have hD2 : 0 ≤ B 2 * ∫ r : ℝ, |ModelThirdKernel (u 2) r| :=
    mul_nonneg (hB 2) hM2
  have hCD0 : 0 ≤ C * (B 0 * ∫ r : ℝ, |ModelLowKernel (u 0) r|) :=
    mul_nonneg hC hD0
  have hCD01 : 0 ≤ C * (B 0 * ∫ r : ℝ, |ModelLowKernel (u 0) r|) *
      (B 1 * ∫ r : ℝ, |ModelLowKernel (u 1) r|) :=
    mul_nonneg hCD0 hD1
  unfold modelTruncatedOperatorIntegrand
  rw [abs_mul, abs_mul, abs_mul]
  gcongr

/-- The product of the three exact one-fiber Young constants at a fixed
parameter `u`. -/
noncomputable def modelTruncatedOperatorFiberBound (u : E3)
    (B : Fin 3 → ℝ) : ℝ :=
  (B 0 * ∫ r : ℝ, |ModelLowKernel (u 0) r|) *
    (B 1 * ∫ r : ℝ, |ModelLowKernel (u 1) r|) *
      (B 2 * ∫ r : ℝ, |ModelThirdKernel (u 2) r|)

/-- The fixed model-operator integrand is jointly strongly measurable in
scale and space for continuous inputs and a measurable coefficient. -/
theorem stronglyMeasurable_modelTruncatedOperatorIntegrand_joint
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelOperatorRealInput)
    (hc : Measurable c) (hf : ∀ j, Continuous (f j)) :
    StronglyMeasurable (fun tx : ℝ × E3 ↦
      modelTruncatedOperatorIntegrand α u c f tx.1 tx.2) := by
  have hc' : StronglyMeasurable (fun tx : ℝ × E3 ↦ c tx.1) :=
    (hc.comp measurable_fst).stronglyMeasurable
  have h0 : StronglyMeasurable (fun tx : ℝ × E3 ↦
      ModelCoordinateConvolution 0 (f 0) (ModelLowKernel (u 0))
        (tx.1 ^ α.weight 0) tx.2) :=
    stronglyMeasurable_modelCoordinateConvolution_joint
      0 (α.weight 0) (f 0) (ModelLowKernel (u 0))
      (hf 0).measurable (measurable_ModelLowKernel (u 0))
  have h1 : StronglyMeasurable (fun tx : ℝ × E3 ↦
      ModelCoordinateConvolution 1 (f 1) (ModelLowKernel (u 1))
        (tx.1 ^ α.weight 1) tx.2) :=
    stronglyMeasurable_modelCoordinateConvolution_joint
      1 (α.weight 1) (f 1) (ModelLowKernel (u 1))
      (hf 1).measurable (measurable_ModelLowKernel (u 1))
  have h2 : StronglyMeasurable (fun tx : ℝ × E3 ↦
      ModelCoordinateConvolution 2 (f 2) (ModelThirdKernel (u 2))
        (tx.1 ^ α.weight 2) tx.2) :=
    stronglyMeasurable_modelCoordinateConvolution_joint
      2 (α.weight 2) (f 2) (ModelThirdKernel (u 2))
      (hf 2).measurable (measurable_ModelThirdKernel (u 2))
  change StronglyMeasurable (fun tx : ℝ × E3 ↦
    c tx.1 *
      ModelCoordinateConvolution 0 (f 0) (ModelLowKernel (u 0))
        (tx.1 ^ α.weight 0) tx.2 *
      ModelCoordinateConvolution 1 (f 1) (ModelLowKernel (u 1))
        (tx.1 ^ α.weight 1) tx.2 *
      ModelCoordinateConvolution 2 (f 2) (ModelThirdKernel (u 2))
        (tx.1 ^ α.weight 2) tx.2)
  exact ((hc'.mul h0).mul h1).mul h2

/-- The real mass of a positive finite scale interval is its logarithmic
length. -/
theorem real_measure_modelScaleInterval
    {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    (((volume : Measure ℝ).withDensity cubeScaleDensity).real (Set.Ioc a b)) =
      Real.log (b / a) := by
  calc
    (((volume : Measure ℝ).withDensity cubeScaleDensity).real (Set.Ioc a b)) =
        ∫ _t in Set.Ioc a b, (1 : ℝ)
          ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
      simp
    _ = ∫ t in a..b, (1 : ℝ) / t :=
      integral_modelScaleInterval_withDensity_eq_intervalIntegral ha hab
        (fun _ : ℝ ↦ (1 : ℝ))
    _ = ∫ t in a..b, t⁻¹ := by
      apply intervalIntegral.integral_congr
      intro t _
      simp
    _ = Real.log (b / a) :=
      integral_inv_of_pos ha (lt_of_lt_of_le ha hab)

/-- The source's elementary finite-interval Young bound for the actual
truncated operator. It is uniform in the coefficient except for its
`L^∞` bound and has the exact logarithmic interval length. -/
theorem abs_ModelTruncatedOperator_le_of_bounded
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (f : ModelOperatorRealInput)
    (a b C : ℝ) (B : Fin 3 → ℝ) (x : E3)
    (ha : 0 < a) (hab : a ≤ b) (hC : 0 ≤ C)
    (hc : ∀ t : ℝ, |c t| ≤ C)
    (hf : ∀ j, Continuous (f j)) (hB : ∀ j, 0 ≤ B j)
    (hfB : ∀ j, ∀ y : E3, |f j y| ≤ B j) :
    |ModelTruncatedOperator α u c f a b x| ≤
      C * modelTruncatedOperatorFiberBound u B * Real.log (b / a) := by
  let ν : Measure ℝ := (volume : Measure ℝ).withDensity cubeScaleDensity
  let I : Set ℝ := Set.Ioc a b
  let Q : ℝ := C * modelTruncatedOperatorFiberBound u B
  have hfinite : ν I < ∞ := by
    let : IsFiniteMeasure (ν.restrict I) := by
      simpa only [ν, I] using isFiniteMeasure_modelScaleInterval ha
    rw [← Measure.restrict_apply_univ]
    exact IsFiniteMeasure.measure_univ_lt_top
  have hpoint : ∀ t ∈ I,
      ‖modelTruncatedOperatorIntegrand α u c f t x‖ ≤ Q := by
    intro t ht
    have htpos : 0 < t := lt_trans ha ht.1
    rw [Real.norm_eq_abs]
    calc
      |modelTruncatedOperatorIntegrand α u c f t x| ≤
          C * (B 0 * ∫ r : ℝ, |ModelLowKernel (u 0) r|) *
            (B 1 * ∫ r : ℝ, |ModelLowKernel (u 1) r|) *
              (B 2 * ∫ r : ℝ, |ModelThirdKernel (u 2) r|) :=
        abs_modelTruncatedOperatorIntegrand_le_of_bounded
          α u c f t x htpos C B hC (hc t) hf hB hfB
      _ = Q := by
        dsimp only [Q, modelTruncatedOperatorFiberBound]
        ring
  change |∫ t in I, modelTruncatedOperatorIntegrand α u c f t x ∂ν| ≤
    C * modelTruncatedOperatorFiberBound u B * Real.log (b / a)
  calc
    |∫ t in I, modelTruncatedOperatorIntegrand α u c f t x ∂ν| =
        ‖∫ t in I, modelTruncatedOperatorIntegrand α u c f t x ∂ν‖ :=
      (Real.norm_eq_abs _).symm
    _ ≤ Q * ν.real I :=
      MeasureTheory.norm_setIntegral_le_of_norm_le_const hfinite hpoint
    _ = C * modelTruncatedOperatorFiberBound u B * Real.log (b / a) := by
      rw [show ν.real I = Real.log (b / a) by
        simpa only [ν, I] using real_measure_modelScaleInterval ha hab]

/-! ### Finite-`L^p` fiber Young inequality -/
theorem coordinate_ennreal_weighted_factor_of_holder
    {p r : ℝ} (hpq : r.HolderConjugate p) (a b : ENNReal) :
    a * b = a ^ r⁻¹ * (a * b ^ p) ^ p⁻¹ := by
  have hp0 : 0 < p := hpq.symm.pos
  have hbinv : (b ^ p) ^ p⁻¹ = b := by
    calc
      (b ^ p) ^ p⁻¹ = b ^ (p * p⁻¹) := (ENNReal.rpow_mul _ _ _).symm
      _ = b := by rw [mul_inv_cancel₀ hp0.ne', ENNReal.rpow_one]
  rw [ENNReal.mul_rpow_of_nonneg _ _ hpq.symm.inv_nonneg]
  rw [hbinv]
  calc
    a * b = a ^ (r⁻¹ + p⁻¹) * b := by
      rw [hpq.inv_add_inv_eq_one, ENNReal.rpow_one]
    _ = (a ^ r⁻¹ * a ^ p⁻¹) * b := by
      rw [ENNReal.rpow_add_of_nonneg _ _ hpq.inv_nonneg hpq.symm.inv_nonneg]
    _ = a ^ r⁻¹ * (a ^ p⁻¹ * b) := by ring

/-- The pointwise weighted Hölder step for convolution along one coordinate
fiber. Unlike a full-space convolution, only the one-dimensional kernel
variable is integrated; translations in the ambient `E3` are retained
explicitly for the later Fubini step. -/
theorem coordinate_lintegral_p_pointwise
    {p r : ℝ} (hpq : r.HolderConjugate p) (i : Fin 3)
    (K : ℝ → ENNReal) (q : E3 → ENNReal)
    (hK : Measurable K) (hq : Measurable q) (x : E3) :
    (∫⁻ y : ℝ, K y * q (x - y • Anisotropy.coordinateDirection i)) ^ p ≤
      (∫⁻ y : ℝ, K y) ^ (p - 1) *
        ∫⁻ y : ℝ, K y * q (x - y • Anisotropy.coordinateDirection i) ^ p := by
  have hp0 : 0 < p := hpq.symm.pos
  have hr0 : 0 < r := hpq.pos
  let A : ℝ → ENNReal := fun y ↦ K y ^ r⁻¹
  let B : ℝ → ENNReal := fun y ↦
    (K y * q (x - y • Anisotropy.coordinateDirection i) ^ p) ^ p⁻¹
  have hqshift : Measurable (fun y : ℝ ↦
      q (x - y • Anisotropy.coordinateDirection i)) :=
    hq.comp (measurable_const.sub (measurable_id.smul measurable_const))
  have hA : AEMeasurable A volume :=
    (hK.pow measurable_const).aemeasurable
  have hB : AEMeasurable B volume :=
    ((hK.mul (hqshift.pow measurable_const)).pow measurable_const).aemeasurable
  have hholder := ENNReal.lintegral_mul_le_Lp_mul_Lq volume hpq hA hB
  have hleft : (∫⁻ y : ℝ, (A * B) y) =
      ∫⁻ y : ℝ, K y * q (x - y • Anisotropy.coordinateDirection i) := by
    apply lintegral_congr
    intro y
    simp only [A, B, Pi.mul_apply]
    exact (coordinate_ennreal_weighted_factor_of_holder hpq
      (K y) (q (x - y • Anisotropy.coordinateDirection i))).symm
  have hfirst : (∫⁻ y : ℝ, A y ^ r) = ∫⁻ y : ℝ, K y := by
    apply lintegral_congr
    intro y
    simp only [A]
    rw [← ENNReal.rpow_mul, inv_mul_cancel₀ hr0.ne', ENNReal.rpow_one]
  have hsecond : (∫⁻ y : ℝ, B y ^ p) =
      ∫⁻ y : ℝ, K y * q (x - y • Anisotropy.coordinateDirection i) ^ p := by
    apply lintegral_congr
    intro y
    simp only [B]
    rw [← ENNReal.rpow_mul, inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one]
  have hholder2 :
      (∫⁻ y : ℝ, K y * q (x - y • Anisotropy.coordinateDirection i)) ≤
        (∫⁻ y : ℝ, K y) ^ r⁻¹ *
          (∫⁻ y : ℝ, K y *
            q (x - y • Anisotropy.coordinateDirection i) ^ p) ^ p⁻¹ := by
    rw [hleft, hfirst, hsecond] at hholder
    simpa only [one_div] using hholder
  have hrp : r⁻¹ * p = p - 1 := by
    rw [← hpq.symm.one_sub_inv]
    field_simp [hp0.ne']
  have hpow := ENNReal.rpow_le_rpow hholder2 hp0.le
  calc
    (∫⁻ y : ℝ, K y * q (x - y • Anisotropy.coordinateDirection i)) ^ p ≤
        ((∫⁻ y : ℝ, K y) ^ r⁻¹ *
          (∫⁻ y : ℝ, K y *
            q (x - y • Anisotropy.coordinateDirection i) ^ p) ^ p⁻¹) ^ p := hpow
    _ = (∫⁻ y : ℝ, K y) ^ (p - 1) *
        ∫⁻ y : ℝ, K y * q (x - y • Anisotropy.coordinateDirection i) ^ p := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
      rw [← ENNReal.rpow_mul, ← ENNReal.rpow_mul, hrp,
        inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one]

/-- Young's inequality for the `p`-moment of a positive convolution along a
single coordinate fiber. The ambient translation in the Tonelli step is
measure preserving, so the constant is the exact one-dimensional kernel
mass. -/
theorem coordinate_lintegral_p_young
    {p r : ℝ} (hpq : r.HolderConjugate p) (i : Fin 3)
    (K : ℝ → ENNReal) (q : E3 → ENNReal)
    (hK : Measurable K) (hq : Measurable q) :
    ∫⁻ x : E3,
        (∫⁻ y : ℝ, K y * q (x - y • Anisotropy.coordinateDirection i)) ^ p ≤
      (∫⁻ y : ℝ, K y) ^ p * ∫⁻ x : E3, q x ^ p := by
  have hp0 : 0 < p := hpq.symm.pos
  have hpone : 1 ≤ p := hpq.symm.lt.le
  let H : E3 × ℝ → ENNReal := fun z ↦
    K z.2 * q (z.1 - z.2 • Anisotropy.coordinateDirection i) ^ p
  have hH : Measurable H :=
    (hK.comp measurable_snd).mul
      ((hq.comp (measurable_fst.sub
        (measurable_snd.smul measurable_const))).pow measurable_const)
  have hinner : Measurable (fun x : E3 ↦
      ∫⁻ y : ℝ, K y * q (x - y • Anisotropy.coordinateDirection i) ^ p) :=
    hH.lintegral_prod_right
  have htranslate (y : ℝ) :
      (∫⁻ x : E3, q (x - y • Anisotropy.coordinateDirection i) ^ p) =
        ∫⁻ x : E3, q x ^ p :=
    (measurePreserving_sub_right (volume : Measure E3)
      (y • Anisotropy.coordinateDirection i)).lintegral_comp
      (hq.pow measurable_const)
  have hqshiftPow (y : ℝ) : Measurable (fun x : E3 ↦
      q (x - y • Anisotropy.coordinateDirection i) ^ p) :=
    (hq.comp (measurable_id.sub measurable_const)).pow measurable_const
  have hdouble :
      (∫⁻ x : E3, ∫⁻ y : ℝ,
        K y * q (x - y • Anisotropy.coordinateDirection i) ^ p) =
        (∫⁻ y : ℝ, K y) * ∫⁻ x : E3, q x ^ p := by
    calc
      (∫⁻ x : E3, ∫⁻ y : ℝ,
          K y * q (x - y • Anisotropy.coordinateDirection i) ^ p) =
          ∫⁻ y : ℝ, ∫⁻ x : E3,
            K y * q (x - y • Anisotropy.coordinateDirection i) ^ p :=
        lintegral_lintegral_swap hH.aemeasurable
      _ = ∫⁻ y : ℝ, K y *
          (∫⁻ x : E3, q (x - y • Anisotropy.coordinateDirection i) ^ p) := by
        apply lintegral_congr
        intro y
        simpa only [Function.comp_apply] using
          (lintegral_const_mul (K y) (hqshiftPow y))
      _ = ∫⁻ y : ℝ, K y * (∫⁻ x : E3, q x ^ p) := by
        apply lintegral_congr
        intro y
        rw [htranslate y]
      _ = (∫⁻ y : ℝ, K y) * ∫⁻ x : E3, q x ^ p :=
        lintegral_mul_const _ hK
  calc
    (∫⁻ x : E3,
        (∫⁻ y : ℝ, K y * q (x - y • Anisotropy.coordinateDirection i)) ^ p) ≤
        ∫⁻ x : E3, (∫⁻ y : ℝ, K y) ^ (p - 1) *
          (∫⁻ y : ℝ,
            K y * q (x - y • Anisotropy.coordinateDirection i) ^ p) := by
      apply lintegral_mono
      intro x
      exact coordinate_lintegral_p_pointwise hpq i K q hK hq x
    _ = (∫⁻ y : ℝ, K y) ^ (p - 1) *
        (∫⁻ x : E3, ∫⁻ y : ℝ,
          K y * q (x - y • Anisotropy.coordinateDirection i) ^ p) := by
      rw [lintegral_const_mul _ hinner]
    _ = (∫⁻ y : ℝ, K y) ^ (p - 1) *
        ((∫⁻ y : ℝ, K y) * ∫⁻ x : E3, q x ^ p) := by
      rw [hdouble]
    _ = (∫⁻ y : ℝ, K y) ^ p * ∫⁻ x : E3, q x ^ p := by
      calc
        (∫⁻ y : ℝ, K y) ^ (p - 1) *
            ((∫⁻ y : ℝ, K y) * ∫⁻ x : E3, q x ^ p) =
            ((∫⁻ y : ℝ, K y) ^ (p - 1) *
              (∫⁻ y : ℝ, K y) ^ (1 : ℝ)) *
              ∫⁻ x : E3, q x ^ p := by
          rw [ENNReal.rpow_one]
          ring
        _ = (∫⁻ y : ℝ, K y) ^ ((p - 1) + 1) *
              ∫⁻ x : E3, q x ^ p := by
          rw [← ENNReal.rpow_add_of_nonneg _ _ (sub_nonneg.mpr hpone)
            (by norm_num : (0 : ℝ) ≤ 1)]
        _ = (∫⁻ y : ℝ, K y) ^ p * ∫⁻ x : E3, q x ^ p := by
          congr 2
          ring

/-- A Borel input and Borel kernel give a strongly measurable literal
coordinate convolution at every positive scale. -/
@[fun_prop] theorem stronglyMeasurable_ModelCoordinateConvolution_of_measurable
    (i : Fin 3) (f : E3 → ℝ) (k : ℝ → ℝ) (s : ℝ)
    (hf : Measurable f) (hk : Measurable k) :
    StronglyMeasurable (ModelCoordinateConvolution i f k s) := by
  have hinput : StronglyMeasurable (fun xr : E3 × ℝ ↦
      f (xr.1 - xr.2 • Anisotropy.coordinateDirection i)) :=
    (hf.comp (measurable_fst.sub
      (measurable_snd.smul measurable_const))).stronglyMeasurable
  have hkernel : StronglyMeasurable (fun xr : E3 × ℝ ↦
      kernelDilate k s xr.2) := by
    unfold kernelDilate
    change StronglyMeasurable (fun xr : E3 × ℝ ↦
      s⁻¹ * k (xr.2 / s))
    exact (measurable_const.mul
      (hk.comp (measurable_snd.div measurable_const))).stronglyMeasurable
  change StronglyMeasurable (fun x : E3 ↦
    ∫ r : ℝ, f (x - r • Anisotropy.coordinateDirection i) *
      kernelDilate k s r)
  exact (hinput.mul hkernel).integral_prod_right'

/-- The finite-`L^p` Young inequality for `ModelCoordinateConvolution`.
This is the literal fiberwise Young input invoked in Section 8 before
Hölder and scale integration. -/
theorem eLpNorm_ModelCoordinateConvolution_le
    (i : Fin 3) (p : ℝ) (hp : 1 < p) (f : E3 → ℝ) (k : ℝ → ℝ)
    (hf : Measurable f) (hk : Measurable k) (hkint : Integrable k)
    {s : ℝ} (hs : 0 < s) :
    eLpNorm (ModelCoordinateConvolution i f k s) (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal (∫ y : ℝ, |k y|) *
        eLpNorm f (ENNReal.ofReal p) volume := by
  have hp0 : 0 < p := lt_trans zero_lt_one hp
  have hpq : p.conjExponent.HolderConjugate p :=
    (Real.HolderConjugate.conjExponent hp).symm
  have hkd : Measurable (fun y : ℝ ↦ kernelDilate k s y) := by
    unfold kernelDilate
    change Measurable (fun y : ℝ ↦ s⁻¹ * k (y / s))
    exact measurable_const.mul
      (hk.comp (measurable_id.div measurable_const))
  have hpoint (x : E3) :
      ‖ModelCoordinateConvolution i f k s x‖ₑ ≤
        ∫⁻ y : ℝ, ‖kernelDilate k s y‖ₑ *
          ‖f (x - y • Anisotropy.coordinateDirection i)‖ₑ := by
    change ‖∫ y : ℝ,
      f (x - y • Anisotropy.coordinateDirection i) * kernelDilate k s y‖ₑ ≤ _
    calc
      ‖∫ y : ℝ,
          f (x - y • Anisotropy.coordinateDirection i) * kernelDilate k s y‖ₑ ≤
          ∫⁻ y : ℝ,
            ‖f (x - y • Anisotropy.coordinateDirection i) * kernelDilate k s y‖ₑ :=
        enorm_integral_le_lintegral_enorm _
      _ = ∫⁻ y : ℝ, ‖kernelDilate k s y‖ₑ *
          ‖f (x - y • Anisotropy.coordinateDirection i)‖ₑ := by
        apply lintegral_congr
        intro y
        rw [enorm_mul]
        ring
  have hmoment :
      (∫⁻ x : E3, ‖ModelCoordinateConvolution i f k s x‖ₑ ^ p) ≤
        (∫⁻ y : ℝ, ‖kernelDilate k s y‖ₑ) ^ p *
          ∫⁻ x : E3, ‖f x‖ₑ ^ p := by
    calc
      (∫⁻ x : E3, ‖ModelCoordinateConvolution i f k s x‖ₑ ^ p) ≤
          ∫⁻ x : E3,
            (∫⁻ y : ℝ, ‖kernelDilate k s y‖ₑ *
              ‖f (x - y • Anisotropy.coordinateDirection i)‖ₑ) ^ p := by
        apply lintegral_mono
        intro x
        exact ENNReal.rpow_le_rpow (hpoint x) (by positivity)
      _ ≤ (∫⁻ y : ℝ, ‖kernelDilate k s y‖ₑ) ^ p *
          ∫⁻ x : E3, ‖f x‖ₑ ^ p :=
        coordinate_lintegral_p_young hpq i
          (fun y ↦ ‖kernelDilate k s y‖ₑ) (fun x ↦ ‖f x‖ₑ)
          hkd.enorm hf.enorm
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top (by fun_prop)]
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top (by fun_prop)]
  simp only [ENNReal.toReal_ofReal hp0.le, one_div]
  have hstep := ENNReal.rpow_le_rpow hmoment
    (by positivity : (0 : ℝ) ≤ p⁻¹)
  calc
    (∫⁻ x : E3, ‖ModelCoordinateConvolution i f k s x‖ₑ ^ p) ^ p⁻¹ ≤
        ((∫⁻ y : ℝ, ‖kernelDilate k s y‖ₑ) ^ p *
          ∫⁻ x : E3, ‖f x‖ₑ ^ p) ^ p⁻¹ := hstep
    _ = (∫⁻ y : ℝ, ‖kernelDilate k s y‖ₑ) *
        (∫⁻ x : E3, ‖f x‖ₑ ^ p) ^ p⁻¹ := by
      rw [ENNReal.mul_rpow_of_nonneg _ _
        (by positivity : (0 : ℝ) ≤ p⁻¹)]
      congr 1
      rw [← ENNReal.rpow_mul, mul_inv_cancel₀ hp0.ne', ENNReal.rpow_one]
    _ = ENNReal.ofReal (∫ y : ℝ, |k y|) *
        (∫⁻ x : E3, ‖f x‖ₑ ^ p) ^ p⁻¹ := by
      have hkdint : Integrable (fun y : ℝ ↦ kernelDilate k s y) :=
        integrable_kernelDilate hkint hs.ne'
      rw [← ofReal_integral_norm_eq_lintegral_enorm hkdint]
      change ENNReal.ofReal (∫ y : ℝ, |kernelDilate k s y|) * _ = _
      rw [integral_abs_kernelDilate k hs]

/-- The literal coordinate convolution maps Borel `L^p` inputs to `L^p` for
every finite exponent strictly above one. -/
theorem memLp_ModelCoordinateConvolution_of_memLp
    (i : Fin 3) (p : ℝ) (hp : 1 < p) (f : E3 → ℝ) (k : ℝ → ℝ)
    (hf : Measurable f) (hk : Measurable k) (hkint : Integrable k)
    {s : ℝ} (hs : 0 < s)
    (hfp : MemLp f (ENNReal.ofReal p) volume) :
    MemLp (ModelCoordinateConvolution i f k s) (ENNReal.ofReal p) volume := by
  exact (eLpNorm_ModelCoordinateConvolution_le i p hp f k hf hk hkint hs).trans_lt
    (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hfp.eLpNorm_lt_top)

/-- A four-factor Hölder package in the association used by the fixed model
form. The three `HolderTriple` assumptions make the intermediate output
exponents explicit, avoiding any hidden interpolation convention. -/
theorem eLpNorm_fourfold_product_le
    {p0 p1 p2 p3 r23 r123 : ENNReal}
    [ENNReal.HolderTriple p2 p3 r23] [ENNReal.HolderTriple p1 r23 r123]
    [ENNReal.HolderTriple p0 r123 1]
    (g0 g1 g2 g3 : E3 → ℝ)
    (hg0 : AEStronglyMeasurable g0 volume)
    (hg1 : AEStronglyMeasurable g1 volume)
    (hg2 : AEStronglyMeasurable g2 volume)
    (hg3 : AEStronglyMeasurable g3 volume) :
    eLpNorm (fun x ↦ g0 x * g1 x * g2 x * g3 x) 1 volume ≤
      eLpNorm g0 p0 volume * eLpNorm g1 p1 volume *
        eLpNorm g2 p2 volume * eLpNorm g3 p3 volume := by
  have h23 : eLpNorm (fun x ↦ g2 x * g3 x) r23 volume ≤
      eLpNorm g2 p2 volume * eLpNorm g3 p3 volume := by
    change eLpNorm (g2 * g3) r23 volume ≤ _
    simpa only [smul_eq_mul] using
      (eLpNorm_smul_le_mul_eLpNorm (μ := volume) hg2 hg3)
  have hm23 : AEStronglyMeasurable (fun x ↦ g2 x * g3 x) volume :=
    hg2.mul hg3
  have h123 : eLpNorm (fun x ↦ g1 x * (g2 x * g3 x)) r123 volume ≤
      eLpNorm g1 p1 volume *
        eLpNorm (fun x ↦ g2 x * g3 x) r23 volume := by
    change eLpNorm (g1 * fun x ↦ g2 x * g3 x) r123 volume ≤ _
    simpa only [smul_eq_mul] using
      (eLpNorm_smul_le_mul_eLpNorm (μ := volume) hg1 hm23)
  have hm123 : AEStronglyMeasurable (fun x ↦
      g1 x * (g2 x * g3 x)) volume := hg1.mul hm23
  have h0123 : eLpNorm (fun x ↦
      g0 x * (g1 x * (g2 x * g3 x))) 1 volume ≤
      eLpNorm g0 p0 volume *
        eLpNorm (fun x ↦ g1 x * (g2 x * g3 x)) r123 volume := by
    change eLpNorm (g0 * fun x ↦ g1 x * (g2 x * g3 x)) 1 volume ≤ _
    simpa only [smul_eq_mul] using
      (eLpNorm_smul_le_mul_eLpNorm (μ := volume) hg0 hm123)
  calc
    eLpNorm (fun x ↦ g0 x * g1 x * g2 x * g3 x) 1 volume =
        eLpNorm (fun x ↦ g0 x * (g1 x * (g2 x * g3 x))) 1 volume := by
      apply eLpNorm_congr_ae
      filter_upwards [] with x
      ring
    _ ≤ eLpNorm g0 p0 volume *
        eLpNorm (fun x ↦ g1 x * (g2 x * g3 x)) r123 volume := h0123
    _ ≤ eLpNorm g0 p0 volume *
        (eLpNorm g1 p1 volume *
          eLpNorm (fun x ↦ g2 x * g3 x) r23 volume) := by
      gcongr
    _ ≤ eLpNorm g0 p0 volume *
        (eLpNorm g1 p1 volume *
          (eLpNorm g2 p2 volume * eLpNorm g3 p3 volume)) := by
      gcongr
    _ = eLpNorm g0 p0 volume * eLpNorm g1 p1 volume *
        eLpNorm g2 p2 volume * eLpNorm g3 p3 volume := by
      ring

/-- The product of the three coordinate convolutions at one fixed scale,
before multiplication by the dual zeroth input or the scale coefficient. -/
noncomputable def modelFixedOperatorSpatialProduct
    (α : Anisotropy) (u : E3) (f : ModelRealInput) (t : ℝ) (x : E3) : ℝ :=
  ModelCoordinateConvolution 0 (f 1) (ModelLowKernel (u 0))
    (t ^ α.weight 0) x *
  ModelCoordinateConvolution 1 (f 2) (ModelLowKernel (u 1))
    (t ^ α.weight 1) x *
  ModelCoordinateConvolution 2 (f 3) (ModelThirdKernel (u 2))
    (t ^ α.weight 2) x

/-- The spatial integrand of the fixed-scale four-linear form, including the
dual zeroth input. -/
noncomputable def modelFixedOperatorFormIntegrand
    (α : Anisotropy) (u : E3) (f : ModelRealInput) (t : ℝ) (x : E3) : ℝ :=
  f 0 x *
  ModelCoordinateConvolution 0 (f 1) (ModelLowKernel (u 0))
    (t ^ α.weight 0) x *
  ModelCoordinateConvolution 1 (f 2) (ModelLowKernel (u 1))
    (t ^ α.weight 1) x *
  ModelCoordinateConvolution 2 (f 3) (ModelThirdKernel (u 2))
    (t ^ α.weight 2) x

/-- Fixed-scale Young followed by the three-stage Hölder product estimate.
This is the elementary spatial estimate that precedes Minkowski's finite
scale integration in the source proof. -/
theorem eLpNorm_modelFixedOperatorFormIntegrand_le
    (α : Anisotropy) (u : E3) (f : ModelRealInput) (t : ℝ) (ht : 0 < t)
    {p0 p1 p2 p3 r23 r123 : ℝ}
    (hp1 : 1 < p1) (hp2 : 1 < p2) (hp3 : 1 < p3)
    [ENNReal.HolderTriple (ENNReal.ofReal p2) (ENNReal.ofReal p3)
      (ENNReal.ofReal r23)]
    [ENNReal.HolderTriple (ENNReal.ofReal p1) (ENNReal.ofReal r23)
      (ENNReal.ofReal r123)]
    [ENNReal.HolderTriple (ENNReal.ofReal p0) (ENNReal.ofReal r123) 1]
    (hf : ∀ j, Measurable (f j)) :
    eLpNorm (modelFixedOperatorFormIntegrand α u f t) 1 volume ≤
      eLpNorm (f 0) (ENNReal.ofReal p0) volume *
        (ENNReal.ofReal (∫ y : ℝ, |ModelLowKernel (u 0) y|) *
          eLpNorm (f 1) (ENNReal.ofReal p1) volume) *
        (ENNReal.ofReal (∫ y : ℝ, |ModelLowKernel (u 1) y|) *
          eLpNorm (f 2) (ENNReal.ofReal p2) volume) *
        (ENNReal.ofReal (∫ y : ℝ, |ModelThirdKernel (u 2) y|) *
          eLpNorm (f 3) (ENNReal.ofReal p3) volume) := by
  have hs0 : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs1 : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs2 : 0 < t ^ α.weight 2 := pow_pos ht _
  have hm0 : AEStronglyMeasurable
      (ModelCoordinateConvolution 0 (f 1) (ModelLowKernel (u 0))
        (t ^ α.weight 0)) volume :=
    (stronglyMeasurable_ModelCoordinateConvolution_of_measurable
      0 (f 1) (ModelLowKernel (u 0)) (t ^ α.weight 0)
      (hf 1) (measurable_ModelLowKernel (u 0))).aestronglyMeasurable
  have hm1 : AEStronglyMeasurable
      (ModelCoordinateConvolution 1 (f 2) (ModelLowKernel (u 1))
        (t ^ α.weight 1)) volume :=
    (stronglyMeasurable_ModelCoordinateConvolution_of_measurable
      1 (f 2) (ModelLowKernel (u 1)) (t ^ α.weight 1)
      (hf 2) (measurable_ModelLowKernel (u 1))).aestronglyMeasurable
  have hm2 : AEStronglyMeasurable
      (ModelCoordinateConvolution 2 (f 3) (ModelThirdKernel (u 2))
        (t ^ α.weight 2)) volume :=
    (stronglyMeasurable_ModelCoordinateConvolution_of_measurable
      2 (f 3) (ModelThirdKernel (u 2)) (t ^ α.weight 2)
      (hf 3) (measurable_ModelThirdKernel (u 2))).aestronglyMeasurable
  have hY0 := eLpNorm_ModelCoordinateConvolution_le
    0 p1 hp1
    (f 1) (ModelLowKernel (u 0)) (hf 1)
    (measurable_ModelLowKernel (u 0)) (integrable_ModelLowKernel (u 0)) hs0
  have hY1 := eLpNorm_ModelCoordinateConvolution_le
    1 p2 hp2
    (f 2) (ModelLowKernel (u 1)) (hf 2)
    (measurable_ModelLowKernel (u 1)) (integrable_ModelLowKernel (u 1)) hs1
  have hY2 := eLpNorm_ModelCoordinateConvolution_le
    2 p3 hp3
    (f 3) (ModelThirdKernel (u 2)) (hf 3)
    (measurable_ModelThirdKernel (u 2)) (integrable_ModelThirdKernel (u 2)) hs2
  have hholder := eLpNorm_fourfold_product_le
    (p0 := ENNReal.ofReal p0) (p1 := ENNReal.ofReal p1)
    (p2 := ENNReal.ofReal p2) (p3 := ENNReal.ofReal p3)
    (r23 := ENNReal.ofReal r23) (r123 := ENNReal.ofReal r123)
    (f 0)
    (ModelCoordinateConvolution 0 (f 1) (ModelLowKernel (u 0))
      (t ^ α.weight 0))
    (ModelCoordinateConvolution 1 (f 2) (ModelLowKernel (u 1))
      (t ^ α.weight 1))
    (ModelCoordinateConvolution 2 (f 3) (ModelThirdKernel (u 2))
      (t ^ α.weight 2))
    (hf 0).aestronglyMeasurable hm0 hm1 hm2
  change eLpNorm (fun x ↦ f 0 x *
    ModelCoordinateConvolution 0 (f 1) (ModelLowKernel (u 0))
      (t ^ α.weight 0) x *
    ModelCoordinateConvolution 1 (f 2) (ModelLowKernel (u 1))
      (t ^ α.weight 1) x *
    ModelCoordinateConvolution 2 (f 3) (ModelThirdKernel (u 2))
      (t ^ α.weight 2) x) 1 volume ≤ _
  calc
    eLpNorm (fun x ↦ f 0 x *
      ModelCoordinateConvolution 0 (f 1) (ModelLowKernel (u 0))
        (t ^ α.weight 0) x *
      ModelCoordinateConvolution 1 (f 2) (ModelLowKernel (u 1))
        (t ^ α.weight 1) x *
      ModelCoordinateConvolution 2 (f 3) (ModelThirdKernel (u 2))
        (t ^ α.weight 2) x) 1 volume ≤
        eLpNorm (f 0) (ENNReal.ofReal p0) volume *
          eLpNorm (ModelCoordinateConvolution 0 (f 1) (ModelLowKernel (u 0))
            (t ^ α.weight 0)) (ENNReal.ofReal p1) volume *
          eLpNorm (ModelCoordinateConvolution 1 (f 2) (ModelLowKernel (u 1))
            (t ^ α.weight 1)) (ENNReal.ofReal p2) volume *
          eLpNorm (ModelCoordinateConvolution 2 (f 3) (ModelThirdKernel (u 2))
            (t ^ α.weight 2)) (ENNReal.ofReal p3) volume := hholder
    _ ≤ eLpNorm (f 0) (ENNReal.ofReal p0) volume *
        (ENNReal.ofReal (∫ y : ℝ, |ModelLowKernel (u 0) y|) *
          eLpNorm (f 1) (ENNReal.ofReal p1) volume) *
        (ENNReal.ofReal (∫ y : ℝ, |ModelLowKernel (u 1) y|) *
          eLpNorm (f 2) (ENNReal.ofReal p2) volume) *
        (ENNReal.ofReal (∫ y : ℝ, |ModelThirdKernel (u 2) y|) *
          eLpNorm (f 3) (ENNReal.ofReal p3) volume) := by
      gcongr

/-! ## Section 9 active-coordinate strict model range -/

/-- Relabel the four exponents by the same permutation that relabels the
three convolved model inputs, while fixing the outer input. -/
def permutedModelExponent
    (σ : Equiv.Perm (Fin 3)) (q : Fin 4 → ℝ) : Fin 4 → ℝ :=
  fun j ↦ q (modelInputIndex σ j)

@[simp] theorem permutedModelExponent_apply
    (σ : Equiv.Perm (Fin 3)) (q : Fin 4 → ℝ) (j : Fin 4) :
    permutedModelExponent σ q j = q (modelInputIndex σ j) := rfl

/-- The stopping threshold for the model in which the annular kernel is
active at spatial coordinate `i`: fourth powers except for the active
convolved input, which uses a second power. -/
def activeSourceStoppingExponent
    (i : Fin 3) : Fin 4 → ℝ :=
  Fin.cases 4 (fun j ↦ if j = i then 2 else 4)

@[simp] theorem activeSourceStoppingExponent_zero
    (i : Fin 3) : activeSourceStoppingExponent i 0 = 4 := rfl

@[simp] theorem activeSourceStoppingExponent_succ
    (i j : Fin 3) :
    activeSourceStoppingExponent i j.succ =
      if j = i then 2 else 4 := rfl

/-- Reindexing a four-term sum by `modelInputIndex` is harmless. -/
theorem sum_modelInputIndex
    (σ : Equiv.Perm (Fin 3)) (g : Fin 4 → ℝ) :
    (∑ j : Fin 4, g (modelInputIndex σ j)) = ∑ j : Fin 4, g j := by
  conv_lhs => rw [Fin.sum_univ_succ]
  conv_rhs => rw [Fin.sum_univ_succ]
  simp only [modelInputIndex_zero, modelInputIndex_succ]
  rw [Equiv.sum_comp σ (fun j : Fin 3 ↦ g j.succ)]

/-- Reindexing a four-term product by `modelInputIndex` is harmless. -/
theorem prod_modelInputIndex
    (σ : Equiv.Perm (Fin 3)) (g : Fin 4 → ℝ) :
    (∏ j : Fin 4, g (modelInputIndex σ j)) = ∏ j : Fin 4, g j := by
  conv_lhs => rw [Fin.prod_univ_succ]
  conv_rhs => rw [Fin.prod_univ_succ]
  simp only [modelInputIndex_zero, modelInputIndex_succ]
  rw [Equiv.prod_comp σ (fun j : Fin 3 ↦ g j.succ)]

/-- The canonical stopping thresholds after permutation coincide with the
active-coordinate thresholds before permutation. -/
theorem sourceStoppingExponent_permute
    (σ : Equiv.Perm (Fin 3)) (i : Fin 3) (hσ : σ 2 = i)
    (j : Fin 4) :
    sourceStoppingExponent j =
      activeSourceStoppingExponent i (modelInputIndex σ j) := by
  refine Fin.cases ?_ ?_ j
  · simp [sourceStoppingExponent, activeSourceStoppingExponent]
  · intro k
    by_cases hk : k = 2
    · subst k
      change 2 = activeSourceStoppingExponent i ((σ 2).succ)
      simp [activeSourceStoppingExponent, hσ]
    · have hσk : σ k ≠ i := by
        intro hki
        apply hk
        exact σ.injective (hki.trans hσ.symm)
      have hksucc : k.succ ≠ (3 : Fin 4) := by
        intro h
        apply hk
        exact (Fin.succ_injective 3) (by simpa using h)
      simp [sourceStoppingExponent, activeSourceStoppingExponent,
        hksucc, hσk]

/-- Positivity of the original active-coordinate exponent tuple transfers to
the canonical tuple after relabeling. -/
theorem permutedModelExponent_pos
    (σ : Equiv.Perm (Fin 3)) (q : Fin 4 → ℝ)
    (hq : ∀ j : Fin 4, 0 < q j) :
    ∀ j : Fin 4, 0 < permutedModelExponent σ q j := by
  intro j
  exact hq (modelInputIndex σ j)

/-- The reciprocal-sum condition is invariant under the four-input
relabeling. -/
theorem sum_inv_permutedModelExponent
    (σ : Equiv.Perm (Fin 3)) (q : Fin 4 → ℝ) :
    (∑ j : Fin 4, (permutedModelExponent σ q j)⁻¹) =
      ∑ j : Fin 4, (q j)⁻¹ := by
  exact sum_modelInputIndex σ (fun j ↦ (q j)⁻¹)

/-- Active-coordinate stopping threshold hypotheses transfer to the initial
active-third model after relabeling. -/
theorem permutedModelExponent_stoppingThreshold
    (σ : Equiv.Perm (Fin 3)) (i : Fin 3) (q : Fin 4 → ℝ)
    (hσ : σ 2 = i)
    (hqs : ∀ j : Fin 4, activeSourceStoppingExponent i j < q j) :
    ∀ j : Fin 4,
      sourceStoppingExponent j < permutedModelExponent σ q j := by
  intro j
  rw [sourceStoppingExponent_permute σ i hσ j]
  exact hqs (modelInputIndex σ j)

/-- The ordinary real `L^p` norm is preserved componentwise by the
coordinate-permuted Schwartz tuple. -/
theorem lpNorm_permutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelSchwartzInput)
    (j : Fin 4) (p : ℝ≥0∞) :
    lpNorm (permutedModelInput σ F j : E3 → ℝ) p volume =
      lpNorm (F (modelInputIndex σ j) : E3 → ℝ) p volume := by
  rw [← toReal_eLpNorm
    ,
    ← toReal_eLpNorm
      ,
    eLpNorm_permutedModelInput]

/-- The product of the four input norms is invariant under simultaneous
permutation of input labels and exponents. -/
theorem prod_lpNorm_permutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelSchwartzInput)
    (q : Fin 4 → ℝ) :
    (∏ j : Fin 4,
      lpNorm (permutedModelInput σ F j : E3 → ℝ)
        (ENNReal.ofReal (permutedModelExponent σ q j)) volume) =
      ∏ j : Fin 4,
        lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
  let G : Fin 4 → ℝ := fun j ↦
    lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume
  calc
    (∏ j : Fin 4,
      lpNorm (permutedModelInput σ F j : E3 → ℝ)
        (ENNReal.ofReal (permutedModelExponent σ q j)) volume) =
        ∏ j : Fin 4, G (modelInputIndex σ j) := by
          apply Finset.prod_congr rfl
          intro j _
          simpa only [G, permutedModelExponent_apply] using
            lpNorm_permutedModelInput σ F j
              (ENNReal.ofReal (q (modelInputIndex σ j)))
    _ = ∏ j : Fin 4, G j := prod_modelInputIndex σ G

/-! ### Section 8 kernel majorants -/

/-- An additional tenth-order reciprocal estimate makes a polynomially
weighted absolute value integrable. This is the weighted input for the
convolutional kernel decay calculation. -/
theorem integrable_weighted_abs_of_decay
    (n : ℕ) (f : ℝ → ℝ) (hf : AEStronglyMeasurable f volume) {C : ℝ}
    (hdecay : ∀ x : ℝ, |f x| ≤ C / (1 + |x|) ^ (n + 10)) :
    Integrable (fun x : ℝ ↦ (1 + |x|) ^ n * |f x|) := by
  have hmajor : Integrable (fun x : ℝ ↦ C * bracketKernel x) :=
    integrable_bracketKernel.const_mul C
  have hfabs : AEStronglyMeasurable (fun x : ℝ ↦ |f x|) volume := by
    simpa only [Real.norm_eq_abs] using hf.norm
  have hweight : AEStronglyMeasurable (fun x : ℝ ↦ (1 + |x|) ^ n) volume :=
    ((continuous_const.add continuous_id.abs).pow n).aestronglyMeasurable
  have hmeas : AEStronglyMeasurable
      (fun x : ℝ ↦ (1 + |x|) ^ n * |f x|) volume :=
    hweight.mul hfabs
  apply hmajor.mono' hmeas
  filter_upwards [] with x
  have htargetnonneg : 0 ≤ (1 + |x|) ^ n * |f x| := by positivity
  rw [Real.norm_eq_abs, abs_of_nonneg htargetnonneg]
  have hW : 0 < (1 + |x|) ^ 10 := by positivity
  have hprod : (1 + |x|) ^ (n + 10) * |f x| ≤ C := by
    simpa [mul_comm] using
      (le_div_iff₀ (pow_pos (by positivity) (n + 10))).mp (hdecay x)
  rw [bracketKernel_eq_inv_pow]
  change (1 + |x|) ^ n * |f x| ≤ C / (1 + |x|) ^ 10
  apply (le_div_iff₀ hW).mpr
  have hpows : (1 + |x|) ^ n * (1 + |x|) ^ 10 =
      (1 + |x|) ^ (n + 10) := by
    rw [← pow_add]
  calc
    ((1 + |x|) ^ n * |f x|) * (1 + |x|) ^ 10 =
        ((1 + |x|) ^ n * (1 + |x|) ^ 10) * |f x| := by ring
    _ = (1 + |x|) ^ (n + 10) * |f x| := by rw [hpows]
    _ ≤ C := hprod

/-- A convolution inherits polynomial decay when one factor has a bounded
weighted absolute value and the other has an integrable weighted absolute
value. The asymmetric form is tailored to the Gaussian--Schwartz kernel
convolutions in the source model. -/
theorem convolution_decay_of_weighted_bound
    (n : ℕ) (f g : ℝ → ℝ) (hf : Measurable f) (hg : Measurable g)
    (hgint : Integrable g)
    (hgw : Integrable (fun y : ℝ ↦ (1 + |y|) ^ n * |g y|))
    {C : ℝ}
    (hfbound : ∀ z : ℝ, (1 + |z|) ^ n * |f z| ≤ C) :
    ∀ x : ℝ, (1 + |x|) ^ n *
      abs ((f ⋆[ContinuousLinearMap.mul ℝ ℝ] g) x) ≤
        C * ∫ y : ℝ, (1 + |y|) ^ n * |g y| := by
  intro x
  let H : ℝ → ℝ := fun z ↦ f z * g (x - z)
  let Q : ℝ → ℝ := fun z ↦ (1 + |x - z|) ^ n * |g (x - z)|
  have hgabs : Integrable (fun z : ℝ ↦ |g (x - z)|) := by
    simpa only [Real.norm_eq_abs] using hgint.norm.comp_sub_left x
  have hHmeas : AEStronglyMeasurable H volume := by
    dsimp only [H]
    exact hf.aestronglyMeasurable.mul
      ((hg.comp (measurable_const.sub measurable_id)).aestronglyMeasurable)
  have hH : Integrable H := by
    apply (hgabs.const_mul C).mono' hHmeas
    filter_upwards [] with z
    have hWone : 1 ≤ (1 + |z|) ^ n := by
      have hbase : (1 : ℝ) ≤ 1 + |z| := by linarith [abs_nonneg z]
      simpa using pow_le_pow_left₀ (by norm_num : (0 : ℝ) ≤ 1) hbase n
    have hfplain : |f z| ≤ C := by
      calc
        |f z| = 1 * |f z| := by ring
        _ ≤ (1 + |z|) ^ n * |f z| :=
          mul_le_mul_of_nonneg_right hWone (abs_nonneg _)
        _ ≤ C := hfbound z
    dsimp only [H]
    rw [Real.norm_eq_abs, abs_mul]
    exact mul_le_mul_of_nonneg_right hfplain (abs_nonneg _)
  have hQ : Integrable Q := by
    dsimp only [Q]
    exact hgw.comp_sub_left x
  have hQscaled : Integrable (fun z : ℝ ↦ C * Q z) := hQ.const_mul C
  have hweightpoint (z : ℝ) :
      (1 + |x|) ^ n * |H z| ≤ C * Q z := by
    have htri : 1 + |x| ≤ (1 + |z|) * (1 + |x - z|) := by
      have habs : |x| ≤ |z| + |x - z| := by
        calc
          |x| = |z + (x - z)| := by ring_nf
          _ ≤ |z| + |x - z| := abs_add_le _ _
      nlinarith [mul_nonneg (abs_nonneg z) (abs_nonneg (x - z))]
    have hpow : (1 + |x|) ^ n ≤
        (1 + |z|) ^ n * (1 + |x - z|) ^ n := by
      calc
        (1 + |x|) ^ n ≤ ((1 + |z|) * (1 + |x - z|)) ^ n :=
          pow_le_pow_left₀ (by positivity) htri n
        _ = (1 + |z|) ^ n * (1 + |x - z|) ^ n := by rw [mul_pow]
    dsimp only [H, Q]
    rw [abs_mul]
    calc
      (1 + |x|) ^ n * (|f z| * |g (x - z)|) ≤
          ((1 + |z|) ^ n * (1 + |x - z|) ^ n) *
            (|f z| * |g (x - z)|) :=
        mul_le_mul_of_nonneg_right hpow
          (mul_nonneg (abs_nonneg _) (abs_nonneg _))
      _ = ((1 + |z|) ^ n * |f z|) *
          ((1 + |x - z|) ^ n * |g (x - z)|) := by ring
      _ ≤ C * ((1 + |x - z|) ^ n * |g (x - z)|) :=
        mul_le_mul_of_nonneg_right (hfbound z)
          (mul_nonneg (pow_nonneg (by positivity) _) (abs_nonneg _))
  have hleft : Integrable (fun z : ℝ ↦ (1 + |x|) ^ n * |H z|) := by
    simpa only [Real.norm_eq_abs] using hH.norm.const_mul ((1 + |x|) ^ n)
  change (1 + |x|) ^ n * |∫ z : ℝ, f z * g (x - z)| ≤ _
  calc
    (1 + |x|) ^ n * |∫ z : ℝ, f z * g (x - z)| ≤
        (1 + |x|) ^ n * ∫ z : ℝ, |H z| := by
      apply mul_le_mul_of_nonneg_left
      · change |∫ z : ℝ, H z| ≤ ∫ z : ℝ, |H z|
        exact MeasureTheory.abs_integral_le_integral_abs
      · positivity
    _ = ∫ z : ℝ, (1 + |x|) ^ n * |H z| := by
      rw [integral_const_mul]
    _ ≤ ∫ z : ℝ, C * Q z := by
      exact integral_mono hleft hQscaled hweightpoint
    _ = C * ∫ z : ℝ, Q z := by rw [integral_const_mul]
    _ = C * ∫ y : ℝ, (1 + |y|) ^ n * |g y| := by
      dsimp only [Q]
      exact congrArg (fun I : ℝ ↦ C * I)
        (integral_sub_left_eq_self
          (fun y : ℝ ↦ (1 + |y|) ^ n * |g y|) volume x)

/-- The low-frequency Gaussian--Schwartz convolution has the source's
order-ten physical decay. -/
theorem low_convolution_polynomial_decay :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      (1 + |x|) ^ 10 *
        |(gaussian ⋆[ContinuousLinearMap.mul ℝ ℝ] conePhiPhysicalReal) x| ≤ C := by
  rcases gaussian_polynomial_decay 10 with ⟨Cg, hCg, hg⟩
  rcases conePhiPhysicalReal_decay 20 with ⟨Cphi, hCphi, hphi⟩
  have hphiweighted : Integrable (fun y : ℝ ↦
      (1 + |y|) ^ 10 * |conePhiPhysicalReal y|) :=
    integrable_weighted_abs_of_decay 10 conePhiPhysicalReal
      conePhiPhysicalReal.continuous.aestronglyMeasurable hphi
  have hgaussian : ∀ z : ℝ, (1 + |z|) ^ 10 * |gaussian z| ≤ Cg := by
    intro z
    rw [abs_of_nonneg (gaussian_nonneg z)]
    exact hg z
  have hconv := convolution_decay_of_weighted_bound 10
    gaussian conePhiPhysicalReal gaussian_contDiff.continuous.measurable
    conePhiPhysicalReal.continuous.measurable conePhiPhysicalReal.integrable
    hphiweighted hgaussian
  let C : ℝ := Cg * ∫ y : ℝ, (1 + |y|) ^ 10 * |conePhiPhysicalReal y|
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg hCg (integral_nonneg fun y ↦ by positivity)
  refine ⟨C, hC, ?_⟩
  intro x
  exact hconv x

/-- The literal low-frequency model kernel obeys a translated bracket
majorant. This is the unit-scale source kernel estimate. -/
theorem ModelLowKernel_translate_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u w : ℝ),
      |ModelLowKernel u w| ≤
        C * translationWeight u ^ 10 * bracketKernel w := by
  rcases low_convolution_polynomial_decay with ⟨C, hC, hdecay⟩
  rcases kernelAt_translate_bracket_of_polynomial_decay
    (gaussian ⋆[ContinuousLinearMap.mul ℝ ℝ] conePhiPhysicalReal)
    ⟨C, hC, hdecay⟩ with ⟨D, hD, htranslate⟩
  refine ⟨D, hD, ?_⟩
  intro u w
  have hEq : ModelLowKernel u w =
      kernelAt (gaussian ⋆[ContinuousLinearMap.mul ℝ ℝ] conePhiPhysicalReal) 1 u w := by
    unfold kernelAt kernelDilate
    simp only [inv_one, one_smul]
    rw [convolution_mul]
    unfold ModelLowKernel
    apply integral_congr_ae
    filter_upwards [] with z
    congr 1
    ring_nf
  rw [hEq]
  exact htranslate u w

/-- Positive mass-normalized dilation preserves the translated bracket
majorant, in the exact form used by one-fiber convolution. -/
theorem kernelDilate_ModelLowKernel_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u s y : ℝ), 0 < s →
      |kernelDilate (ModelLowKernel u) s y| ≤
        C * translationWeight u ^ 10 * bracketKernelAt s 0 y := by
  rcases ModelLowKernel_translate_bracket_majorant with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u s y hs
  have hbase := hbound u (y / s)
  have hsinv : 0 ≤ s⁻¹ := (inv_pos.mpr hs).le
  unfold kernelDilate bracketKernelAt kernelAt kernelDilate
  simp only [sub_zero, smul_eq_mul]
  rw [abs_mul, abs_of_nonneg hsinv]
  calc
    s⁻¹ * |ModelLowKernel u (y / s)| ≤
        s⁻¹ * (C * translationWeight u ^ 10 * bracketKernel (y / s)) :=
      mul_le_mul_of_nonneg_left hbase hsinv
    _ = C * translationWeight u ^ 10 * (s⁻¹ * bracketKernel (y / s)) := by ring

/-- The first Gaussian-derivative/annular-kernel convolution has twentieth
order decay, leaving one order-ten weighted integral for the second
convolution in the third model kernel. -/
theorem annular_convolution_polynomial_decay_twenty :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      (1 + |x|) ^ 20 *
        |(gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal) x| ≤ C := by
  rcases gaussianDeriv_polynomial_decay 20 with ⟨Ch, hCh, hh⟩
  rcases conePsiPhysicalReal_decay 30 with ⟨Cpsi, hCpsi, hpsi⟩
  have hpsiweighted : Integrable (fun y : ℝ ↦
      (1 + |y|) ^ 20 * |conePsiPhysicalReal y|) :=
    integrable_weighted_abs_of_decay 20 conePsiPhysicalReal
      conePsiPhysicalReal.continuous.aestronglyMeasurable hpsi
  have hconv := convolution_decay_of_weighted_bound 20
    gaussianDeriv conePsiPhysicalReal continuous_gaussianDeriv.measurable
    conePsiPhysicalReal.continuous.measurable conePsiPhysicalReal.integrable
    hpsiweighted hh
  let C : ℝ := Ch * ∫ y : ℝ, (1 + |y|) ^ 20 * |conePsiPhysicalReal y|
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg hCh (integral_nonneg fun y ↦ by positivity)
  refine ⟨C, hC, ?_⟩
  intro x
  exact hconv x

/-- The first annular convolution has finite tenth weighted absolute mass. -/
theorem integrable_weighted_annular_convolution :
    Integrable (fun x : ℝ ↦ (1 + |x|) ^ 10 *
      |(gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal) x|) := by
  rcases annular_convolution_polynomial_decay_twenty with ⟨C, hC, hbound⟩
  have hconv : Integrable
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal) :=
    integrable_gaussianDeriv.integrable_convolution (ContinuousLinearMap.mul ℝ ℝ)
      conePsiPhysicalReal.integrable
  apply integrable_weighted_abs_of_decay (C := C) 10
    (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal)
    hconv.aestronglyMeasurable
  intro x
  apply (le_div_iff₀ (pow_pos (by positivity) 20)).mpr
  simpa [mul_comm] using hbound x

/-- The translation-free physical third kernel has order-ten decay. -/
theorem third_convolution_polynomial_decay :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      (1 + |x|) ^ 10 *
        |(gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal)) x| ≤ C := by
  rcases gaussianDeriv_polynomial_decay 10 with ⟨Ch, hCh, hh⟩
  have hinner : Integrable
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal) :=
    integrable_gaussianDeriv.integrable_convolution (ContinuousLinearMap.mul ℝ ℝ)
      conePsiPhysicalReal.integrable
  have hinnermeas : Measurable
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal) := by
    rcases gaussianDeriv_polynomial_decay 0 with ⟨B, hB, hBbound⟩
    have hbounded : BddAbove (Set.range fun x : ℝ ↦ ‖gaussianDeriv x‖) := by
      refine ⟨B, ?_⟩
      rintro _ ⟨x, rfl⟩
      simpa only [Real.norm_eq_abs, pow_zero, one_mul] using hBbound x
    exact (hbounded.continuous_convolution_left_of_integrable
      (ContinuousLinearMap.mul ℝ ℝ) continuous_gaussianDeriv
      conePsiPhysicalReal.integrable).measurable
  have hconv := convolution_decay_of_weighted_bound 10 gaussianDeriv
    (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal)
    continuous_gaussianDeriv.measurable hinnermeas
    hinner integrable_weighted_annular_convolution hh
  let C : ℝ := Ch * ∫ y : ℝ, (1 + |y|) ^ 10 *
    |(gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal) y|
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg hCh (integral_nonneg fun y ↦ by positivity)
  refine ⟨C, hC, ?_⟩
  intro x
  exact hconv x

/-- The literal third model kernel is a translation of the fixed double
Gaussian-derivative/annular convolution. -/
theorem ModelThirdKernel_translate_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u w : ℝ),
      |ModelThirdKernel u w| ≤
        C * translationWeight u ^ 10 * bracketKernel w := by
  rcases third_convolution_polynomial_decay with ⟨C, hC, hdecay⟩
  let K : ℝ → ℝ := gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
    (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePsiPhysicalReal)
  rcases kernelAt_translate_bracket_of_polynomial_decay K
    ⟨C, hC, by simpa only [K] using hdecay⟩ with ⟨D, hD, htranslate⟩
  refine ⟨D, hD, ?_⟩
  intro u w
  have hEq : ModelThirdKernel u w = kernelAt K 1 u w := by
    dsimp only [K]
    unfold kernelAt kernelDilate
    simp only [inv_one, one_smul]
    rw [convolution_mul]
    unfold ModelThirdKernel
    apply integral_congr_ae
    filter_upwards [] with z
    rw [modelThirdKernel_unit_eq_convolution u (w - z)]
    congr 1
    ring
  rw [hEq]
  exact htranslate u w

/-- The dilated third model kernel obeys the same translated bracket
majorant as the low kernels. -/
theorem kernelDilate_ModelThirdKernel_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u s y : ℝ), 0 < s →
      |kernelDilate (ModelThirdKernel u) s y| ≤
        C * translationWeight u ^ 10 * bracketKernelAt s 0 y := by
  rcases ModelThirdKernel_translate_bracket_majorant with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u s y hs
  have hbase := hbound u (y / s)
  have hsinv : 0 ≤ s⁻¹ := (inv_pos.mpr hs).le
  unfold kernelDilate bracketKernelAt kernelAt kernelDilate
  simp only [sub_zero, smul_eq_mul]
  rw [abs_mul, abs_of_nonneg hsinv]
  calc
    s⁻¹ * |ModelThirdKernel u (y / s)| ≤
        s⁻¹ * (C * translationWeight u ^ 10 * bracketKernel (y / s)) :=
      mul_le_mul_of_nonneg_left hbase hsinv
    _ = C * translationWeight u ^ 10 * (s⁻¹ * bracketKernel (y / s)) := by ring

/-- Every scalar coordinate translation is controlled by the source weight
of the full translation vector. -/
theorem translationWeight_coordinate_le_sourceWeight
    (u : E3) (j : Fin 3) :
    translationWeight (u j) ≤ sourceWeight u := by
  fin_cases j <;> simp only [translationWeight, sourceWeight, Fin.reduceFinMk] <;>
    nlinarith [abs_nonneg (u 0), abs_nonneg (u 1), abs_nonneg (u 2)]

/-- The low coordinate kernels have the literal `U(u)^10` fiber majorant. -/
theorem kernelDilate_ModelLowKernel_sourceWeight_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (j : Fin 3) (s y : ℝ), 0 < s →
      |kernelDilate (ModelLowKernel (u j)) s y| ≤
        C * sourceWeight u ^ 10 * bracketKernelAt s 0 y := by
  rcases kernelDilate_ModelLowKernel_bracket_majorant with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u j s y hs
  have hcoord := translationWeight_coordinate_le_sourceWeight u j
  have hpow : translationWeight (u j) ^ 10 ≤ sourceWeight u ^ 10 :=
    pow_le_pow_left₀ (by unfold translationWeight; positivity) hcoord 10
  have hbracket : 0 ≤ bracketKernelAt s 0 y := (bracketKernelAt_pos hs).le
  calc
    |kernelDilate (ModelLowKernel (u j)) s y| ≤
        C * translationWeight (u j) ^ 10 * bracketKernelAt s 0 y :=
      hbound (u j) s y hs
    _ = (C * bracketKernelAt s 0 y) * translationWeight (u j) ^ 10 := by ring
    _ ≤ (C * bracketKernelAt s 0 y) * sourceWeight u ^ 10 :=
      mul_le_mul_of_nonneg_left hpow (mul_nonneg hC hbracket)
    _ = C * sourceWeight u ^ 10 * bracketKernelAt s 0 y := by ring

/-- The third coordinate kernel has the literal `U(u)^10` fiber majorant. -/
theorem kernelDilate_ModelThirdKernel_sourceWeight_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (j : Fin 3) (s y : ℝ), 0 < s →
      |kernelDilate (ModelThirdKernel (u j)) s y| ≤
        C * sourceWeight u ^ 10 * bracketKernelAt s 0 y := by
  rcases kernelDilate_ModelThirdKernel_bracket_majorant with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u j s y hs
  have hcoord := translationWeight_coordinate_le_sourceWeight u j
  have hpow : translationWeight (u j) ^ 10 ≤ sourceWeight u ^ 10 :=
    pow_le_pow_left₀ (by unfold translationWeight; positivity) hcoord 10
  have hbracket : 0 ≤ bracketKernelAt s 0 y := (bracketKernelAt_pos hs).le
  calc
    |kernelDilate (ModelThirdKernel (u j)) s y| ≤
        C * translationWeight (u j) ^ 10 * bracketKernelAt s 0 y :=
      hbound (u j) s y hs
    _ = (C * bracketKernelAt s 0 y) * translationWeight (u j) ^ 10 := by ring
    _ ≤ (C * bracketKernelAt s 0 y) * sourceWeight u ^ 10 :=
      mul_le_mul_of_nonneg_left hpow (mul_nonneg hC hbracket)
    _ = C * sourceWeight u ^ 10 * bracketKernelAt s 0 y := by ring

namespace LiteralComplexInternal

/-! ## Section 7: real-to-complex expansion for the model form -/

/-- The real part of a complex Schwartz input remains a real Schwartz input. -/
noncomputable def scratch_realPartSchwartz (f : SchwartzMap E3 ℂ) :
    SchwartzMap E3 ℝ :=
  f.postcompCLM (𝕜 := ℝ) Complex.reCLM

/-- The imaginary part of a complex Schwartz input remains a real Schwartz input. -/
noncomputable def scratch_imagPartSchwartz (f : SchwartzMap E3 ℂ) :
    SchwartzMap E3 ℝ :=
  f.postcompCLM (𝕜 := ℝ) Complex.imCLM

@[simp] theorem scratch_realPartSchwartz_apply (f : SchwartzMap E3 ℂ) (x : E3) :
    scratch_realPartSchwartz f x = (f x).re := by
  rfl

@[simp] theorem scratch_imagPartSchwartz_apply (f : SchwartzMap E3 ℂ) (x : E3) :
    scratch_imagPartSchwartz f x = (f x).im := by
  rfl

/-- Real part recovers a real Schwartz function after its standard
complexification. -/
theorem scratch_realPartSchwartz_complexifyRealSchwartz (f : SchwartzMap E3 ℝ) :
    scratch_realPartSchwartz (complexifyRealSchwartz f) = f := by
  ext x
  simp only [scratch_realPartSchwartz_apply, complexifyRealSchwartz_apply, Complex.ofReal_re]

/-- Imaginary part vanishes on a standard complexification of real data. -/
theorem scratch_imagPartSchwartz_complexifyRealSchwartz (f : SchwartzMap E3 ℝ) :
    scratch_imagPartSchwartz (complexifyRealSchwartz f) = 0 := by
  ext x
  simp only [scratch_imagPartSchwartz_apply, complexifyRealSchwartz_apply, Complex.ofReal_im,
    zero_apply]

/-- Taking the real part cannot increase a finite `L^p` norm. -/
theorem scratch_lpNorm_realPartSchwartz_le
    (f : SchwartzMap E3 ℂ) (p : ℝ) :
    lpNorm (scratch_realPartSchwartz f : E3 → ℝ) (ENNReal.ofReal p) volume ≤
      lpNorm (f : E3 → ℂ) (ENNReal.ofReal p) volume := by
  rw [← toReal_eLpNorm
    ,
    ← toReal_eLpNorm ]
  apply ENNReal.toReal_mono (f.memLp (ENNReal.ofReal p) volume).eLpNorm_ne_top
  apply eLpNorm_mono (by fun_prop)
  intro x
  change |(f x).re| ≤ ‖f x‖
  exact Complex.abs_re_le_norm _

/-- Taking the imaginary part cannot increase a finite `L^p` norm. -/
theorem scratch_lpNorm_imagPartSchwartz_le
    (f : SchwartzMap E3 ℂ) (p : ℝ) :
    lpNorm (scratch_imagPartSchwartz f : E3 → ℝ) (ENNReal.ofReal p) volume ≤
      lpNorm (f : E3 → ℂ) (ENNReal.ofReal p) volume := by
  rw [← toReal_eLpNorm
    ,
    ← toReal_eLpNorm ]
  apply ENNReal.toReal_mono (f.memLp (ENNReal.ofReal p) volume).eLpNorm_ne_top
  apply eLpNorm_mono (by fun_prop)
  intro x
  change |(f x).im| ≤ ‖f x‖
  exact Complex.abs_im_le_norm _

/-- A complex Schwartz four-tuple for the algebraic complexification of the
real model form. -/
abbrev ScratchModelComplexSchwartzInput := Fin 4 → SchwartzMap E3 ℂ

/-- Select the real or imaginary part of every complex input according to one
of the sixteen terms in the standard multilinear expansion. -/
noncomputable def scratch_complexComponent
    (ε : Fin 4 → Bool) (F : ScratchModelComplexSchwartzInput) :
    ModelSchwartzInput := fun j ↦
  if ε j then scratch_imagPartSchwartz (F j) else scratch_realPartSchwartz (F j)

/-- The coefficient of a real/imaginary component in the standard complex
multilinear expansion. -/
noncomputable def scratch_complexPhase (ε : Fin 4 → Bool) : ℂ :=
  ∏ j : Fin 4, if ε j then Complex.I else 1

/-- The Boolean choice selecting the real part in every coordinate. -/
def scratch_allRealChoices : Fin 4 → Bool := fun _ ↦ false

/-- On a complexification of real data, the all-real choice recovers the
original real tuple. -/
theorem scratch_complexComponent_allRealChoices
    (G : ModelSchwartzInput) :
    scratch_complexComponent scratch_allRealChoices
      (fun j ↦ complexifyRealSchwartz (G j)) = G := by
  funext j
  simp [scratch_complexComponent, scratch_allRealChoices,
    scratch_realPartSchwartz_complexifyRealSchwartz]

/-- Any choice involving an imaginary part has a zero component when the
input tuple is the complexification of real data. -/
theorem scratch_complexComponent_eq_zero_of_choice_true
    (ε : Fin 4 → Bool) (G : ModelSchwartzInput) (j : Fin 4)
    (hε : ε j) :
    scratch_complexComponent ε (fun k ↦ complexifyRealSchwartz (G k)) j = 0 := by
  rw [scratch_complexComponent, ite_eq_left hε]
  exact scratch_imagPartSchwartz_complexifyRealSchwartz (G j)

/-- A Boolean coordinate choice distinct from the all-real selection contains
at least one imaginary component. -/
theorem scratch_exists_choice_true_of_ne_allRealChoices
    (ε : Fin 4 → Bool) (hε : ε ≠ scratch_allRealChoices) :
    ∃ j : Fin 4, ε j := by
  by_contra hnone
  push Not at hnone
  apply hε
  funext j
  exact Bool.eq_false_of_not_eq_true (hnone j)

/-- The algebraic complexification of a real four-linear functional. When
the functional is four-linear, this is its unique complex multilinear
extension. -/
noncomputable def scratch_fourLinearComplexification
    (L : ModelSchwartzInput → ℝ) (F : ScratchModelComplexSchwartzInput) : ℂ :=
  ∑ ε : Fin 4 → Bool,
    scratch_complexPhase ε * (L (scratch_complexComponent ε F) : ℂ)

/-- The algebraic complexification restricts to the original real functional
on the usual embedding of real Schwartz data, provided a zero input makes the
real functional vanish. -/
theorem scratch_fourLinearComplexification_complexifyRealSchwartz
    (L : ModelSchwartzInput → ℝ)
    (hzero : ∀ (H : ModelSchwartzInput) (j : Fin 4), H j = 0 → L H = 0)
    (G : ModelSchwartzInput) :
    scratch_fourLinearComplexification L
      (fun j ↦ complexifyRealSchwartz (G j)) = (L G : ℂ) := by
  classical
  unfold scratch_fourLinearComplexification
  rw [Finset.sum_eq_single scratch_allRealChoices]
  · rw [scratch_complexComponent_allRealChoices]
    simp [scratch_complexPhase, scratch_allRealChoices]
  · intro ε _ hε
    obtain ⟨j, hj⟩ := scratch_exists_choice_true_of_ne_allRealChoices ε hε
    have hcomponent : scratch_complexComponent ε
        (fun k ↦ complexifyRealSchwartz (G k)) j = 0 :=
      scratch_complexComponent_eq_zero_of_choice_true ε G j hj
    have hLzero : L (scratch_complexComponent ε
        (fun k ↦ complexifyRealSchwartz (G k))) = 0 :=
      hzero _ j hcomponent
    simp [hLzero]
  · intro hnot
    exact (hnot (Finset.mem_univ _)).elim

/-- Each real/imaginary component has no larger `L^p` norm than the original
complex Schwartz input. -/
theorem scratch_lpNorm_complexComponent_le
    (ε : Fin 4 → Bool) (F : ScratchModelComplexSchwartzInput)
    (j : Fin 4) (p : ℝ) :
    lpNorm (scratch_complexComponent ε F j : E3 → ℝ) (ENNReal.ofReal p) volume ≤
      lpNorm (F j : E3 → ℂ) (ENNReal.ofReal p) volume := by
  by_cases hε : ε j
  · rw [scratch_complexComponent, ite_eq_left hε]
    exact scratch_lpNorm_imagPartSchwartz_le (F j) p
  · rw [scratch_complexComponent, ite_eq_right hε]
    exact scratch_lpNorm_realPartSchwartz_le (F j) p

/-- The expansion phases all have unit modulus. -/
theorem scratch_norm_complexPhase (ε : Fin 4 → Bool) :
    ‖scratch_complexPhase ε‖ = 1 := by
  rw [scratch_complexPhase, norm_prod]
  apply Finset.prod_eq_one
  intro j _
  split <;> simp

/-- The real/imaginary expansion has exactly sixteen summands. -/
theorem scratch_sum_sixteen (A : ℝ) : (∑ _ : Fin 4 → Bool, A) = 16 * A := by
  norm_num

/-- Products of the selected real/imaginary component norms are bounded by
the product of the original complex input norms. -/
theorem scratch_prod_lpNorm_complexComponent_le
    (ε : Fin 4 → Bool) (F : ScratchModelComplexSchwartzInput)
    (p : Fin 4 → ℝ) :
    (∏ j : Fin 4,
      lpNorm (scratch_complexComponent ε F j : E3 → ℝ)
        (ENNReal.ofReal (p j)) volume) ≤
      ∏ j : Fin 4, lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
  apply Finset.prod_le_prod₀
  · intro j _
    exact lpNorm_nonneg
  · intro j _
    exact scratch_lpNorm_complexComponent_le ε F j (p j)

/-- The standard real/imaginary expansion transfers a product `L^p` bound
for a real four-linear functional to its complexification, at the exact cost
of the sixteen expansion terms from Section 7 of the blueprint. -/
theorem scratch_norm_fourLinearComplexification_le
    (L : ModelSchwartzInput → ℝ) (C : ℝ) (hC : 0 ≤ C)
    (p : Fin 4 → ℝ)
    (hL : ∀ G : ModelSchwartzInput,
      |L G| ≤ C * ∏ j : Fin 4,
        lpNorm (G j : E3 → ℝ) (ENNReal.ofReal (p j)) volume)
    (F : ScratchModelComplexSchwartzInput) :
    ‖scratch_fourLinearComplexification L F‖ ≤
      16 * C * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
  unfold scratch_fourLinearComplexification
  calc
    ‖∑ ε : Fin 4 → Bool,
        scratch_complexPhase ε * (L (scratch_complexComponent ε F) : ℂ)‖ ≤
        ∑ ε : Fin 4 → Bool,
          ‖scratch_complexPhase ε * (L (scratch_complexComponent ε F) : ℂ)‖ :=
      norm_sum_le _ _
    _ = ∑ ε : Fin 4 → Bool, |L (scratch_complexComponent ε F)| := by
      apply Finset.sum_congr rfl
      intro ε _
      rw [norm_mul, scratch_norm_complexPhase, one_mul,
        Complex.norm_real, Real.norm_eq_abs]
    _ ≤ ∑ ε : Fin 4 → Bool, C * ∏ j : Fin 4,
        lpNorm (scratch_complexComponent ε F j : E3 → ℝ)
          (ENNReal.ofReal (p j)) volume := by
      apply Finset.sum_le_sum
      intro ε _
      exact hL (scratch_complexComponent ε F)
    _ ≤ ∑ _ε : Fin 4 → Bool, C * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
      apply Finset.sum_le_sum
      intro ε _
      exact mul_le_mul_of_nonneg_left
        (scratch_prod_lpNorm_complexComponent_le ε F p) hC
    _ = 16 * C * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
      rw [scratch_sum_sixteen]
      ring

/-- The canonical complexification of the source full-scale real model form. -/
noncomputable def scratch_ModelFullFormComplexified
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ)
    (F : ScratchModelComplexSchwartzInput) : ℂ :=
  scratch_fourLinearComplexification (ModelFullForm α u c) F

/-- Select the real or imaginary part of a complex scale coefficient. -/
def scratch_complexCoefficientComponent
    (δ : Bool) (c : ℝ → ℂ) : ℝ → ℝ := fun t ↦
  if δ then (c t).im else (c t).re

/-- The coefficient phase in the real/imaginary expansion. -/
def scratch_complexCoefficientPhase (δ : Bool) : ℂ :=
  if δ then Complex.I else 1

/-- Each real/imaginary coefficient component is measurable when the original
complex coefficient is measurable. -/
theorem scratch_complexCoefficientComponent_measurable
    (δ : Bool) (c : ℝ → ℂ) (hc : Measurable c) :
    Measurable (scratch_complexCoefficientComponent δ c) := by
  cases δ
  · change Measurable (Complex.re ∘ c)
    exact Complex.continuous_re.measurable.comp hc
  · change Measurable (Complex.im ∘ c)
    exact Complex.continuous_im.measurable.comp hc

/-- A complex coefficient bounded by one has both real coefficient components
bounded in absolute value by one. -/
theorem scratch_abs_complexCoefficientComponent_le_one
    (δ : Bool) (c : ℝ → ℂ) (hc : ∀ t : ℝ, ‖c t‖ ≤ 1) :
    ∀ t : ℝ, |scratch_complexCoefficientComponent δ c t| ≤ 1 := by
  intro t
  cases δ
  · change |(c t).re| ≤ 1
    exact (Complex.abs_re_le_norm _).trans (hc t)
  · change |(c t).im| ≤ 1
    exact (Complex.abs_im_le_norm _).trans (hc t)

/-- Coefficient expansion phases have unit modulus. -/
theorem scratch_norm_complexCoefficientPhase (δ : Bool) :
    ‖scratch_complexCoefficientPhase δ‖ = 1 := by
  by_cases hδ : δ <;> simp [scratch_complexCoefficientPhase, hδ]

/-- The algebraic complexification of the model form in its scale coefficient
as well as in its four inputs. This is the literal `2^5` expansion used in
the complex step of blueprint Section 7. -/
noncomputable def scratch_ModelFullFormComplexCoefficientComplexified
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (F : ScratchModelComplexSchwartzInput) : ℂ :=
  ∑ δ : Bool, scratch_complexCoefficientPhase δ *
    scratch_ModelFullFormComplexified α u
      (scratch_complexCoefficientComponent δ c) F

/-- The real full model form vanishes for the zero scale coefficient. -/
theorem scratch_ModelFullForm_zero_coefficient
    (α : Anisotropy) (u : E3) (F : ModelSchwartzInput) :
    ModelFullForm α u (0 : ℝ → ℝ) F = 0 := by
  simp [ModelFullForm]

/-- Complexifying a real scale coefficient and then selecting its real part
recovers the coefficient. -/
theorem scratch_complexCoefficientComponent_realEmbedding_false
    (d : ℝ → ℝ) :
    scratch_complexCoefficientComponent false (fun t ↦ (d t : ℂ)) = d := by
  funext t
  simp [scratch_complexCoefficientComponent]

/-- The imaginary component of a complexified real scale coefficient is zero. -/
theorem scratch_complexCoefficientComponent_realEmbedding_true
    (d : ℝ → ℝ) :
    scratch_complexCoefficientComponent true (fun t ↦ (d t : ℂ)) = 0 := by
  funext t
  simp [scratch_complexCoefficientComponent]

/-- The input-complexified model form vanishes for the zero real coefficient. -/
theorem scratch_ModelFullFormComplexified_zero_coefficient
    (α : Anisotropy) (u : E3) (F : ScratchModelComplexSchwartzInput) :
    scratch_ModelFullFormComplexified α u (0 : ℝ → ℝ) F = 0 := by
  unfold scratch_ModelFullFormComplexified scratch_fourLinearComplexification
  apply Finset.sum_eq_zero
  intro ε _
  rw [scratch_ModelFullForm_zero_coefficient]
  simp only [Complex.ofReal_zero, mul_zero]

/-- The five-variable complexification agrees with the real source model form
when both its coefficient and all four inputs are standard complexifications
of real data. -/
theorem scratch_ModelFullFormComplexCoefficientComplexified_complexifyReal
    (α : Anisotropy) (u : E3) (d : ℝ → ℝ) (G : ModelSchwartzInput) :
    scratch_ModelFullFormComplexCoefficientComplexified α u
      (fun t ↦ (d t : ℂ))
      (fun j ↦ complexifyRealSchwartz (G j)) = (ModelFullForm α u d G : ℂ) := by
  classical
  have hinner : scratch_ModelFullFormComplexified α u d
      (fun j ↦ complexifyRealSchwartz (G j)) = (ModelFullForm α u d G : ℂ) := by
    unfold scratch_ModelFullFormComplexified
    apply scratch_fourLinearComplexification_complexifyRealSchwartz
    intro H j hj
    exact ModelFullForm_eq_zero_of_component_eq_zero α u d H j hj
  unfold scratch_ModelFullFormComplexCoefficientComplexified
  rw [Finset.sum_eq_single false]
  · rw [scratch_complexCoefficientComponent_realEmbedding_false]
    rw [hinner]
    simp [scratch_complexCoefficientPhase]
  · intro δ _ hδ
    cases δ
    · exact (hδ rfl).elim
    · rw [scratch_complexCoefficientComponent_realEmbedding_true]
      rw [scratch_ModelFullFormComplexified_zero_coefficient]
      simp
  · intro hnot
    exact (hnot (Finset.mem_univ _)).elim

/-- The complexified model form agrees with the source real form on real
Schwartz data embedded into the complex Schwartz space. -/
theorem scratch_ModelFullFormComplexified_complexifyRealSchwartz
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (G : ModelSchwartzInput) :
    scratch_ModelFullFormComplexified α u c
      (fun j ↦ complexifyRealSchwartz (G j)) = (ModelFullForm α u c G : ℂ) := by
  unfold scratch_ModelFullFormComplexified
  apply scratch_fourLinearComplexification_complexifyRealSchwartz
  intro H j hj
  exact ModelFullForm_eq_zero_of_component_eq_zero α u c H j hj

/-- A real initial-range product estimate for the source model form transfers
to its complexification with precisely the factor `2^4 = 16` from expanding
the four complex inputs into real and imaginary parts. -/
theorem scratch_norm_ModelFullFormComplexified_le
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ)
    (C : ℝ) (hC : 0 ≤ C) (p : Fin 4 → ℝ)
    (hreal : ∀ G : ModelSchwartzInput,
      |ModelFullForm α u c G| ≤ C * sourceWeight u ^ 75 *
        ∏ j : Fin 4, lpNorm (G j : E3 → ℝ)
          (ENNReal.ofReal (p j)) volume)
    (F : ScratchModelComplexSchwartzInput) :
    ‖scratch_ModelFullFormComplexified α u c F‖ ≤
      16 * C * sourceWeight u ^ 75 * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
  have hsource : 0 ≤ sourceWeight u ^ 75 :=
    pow_nonneg (sourceWeight_nonneg u) _
  have hD : 0 ≤ C * sourceWeight u ^ 75 := mul_nonneg hC hsource
  change ‖scratch_fourLinearComplexification (ModelFullForm α u c) F‖ ≤ _
  calc
    ‖scratch_fourLinearComplexification (ModelFullForm α u c) F‖ ≤
        16 * (C * sourceWeight u ^ 75) * ∏ j : Fin 4,
          lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
      apply scratch_norm_fourLinearComplexification_le
        (L := ModelFullForm α u c) (C := C * sourceWeight u ^ 75) hD p
      intro G
      simpa only [mul_assoc] using hreal G
    _ = 16 * C * sourceWeight u ^ 75 * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
      ring

/-- The same Section 7 complexification bridge at the blueprint's displayed
translation exponent `100`. -/
theorem scratch_norm_ModelFullFormComplexified_le_weight100
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ)
    (C : ℝ) (hC : 0 ≤ C) (p : Fin 4 → ℝ)
    (hreal : ∀ G : ModelSchwartzInput,
      |ModelFullForm α u c G| ≤ C * sourceWeight u ^ 100 *
        ∏ j : Fin 4, lpNorm (G j : E3 → ℝ)
          (ENNReal.ofReal (p j)) volume)
    (F : ScratchModelComplexSchwartzInput) :
    ‖scratch_ModelFullFormComplexified α u c F‖ ≤
      16 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
  have hsource : 0 ≤ sourceWeight u ^ 100 :=
    pow_nonneg (sourceWeight_nonneg u) _
  have hD : 0 ≤ C * sourceWeight u ^ 100 := mul_nonneg hC hsource
  change ‖scratch_fourLinearComplexification (ModelFullForm α u c) F‖ ≤ _
  calc
    ‖scratch_fourLinearComplexification (ModelFullForm α u c) F‖ ≤
        16 * (C * sourceWeight u ^ 100) * ∏ j : Fin 4,
          lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
      apply scratch_norm_fourLinearComplexification_le
        (L := ModelFullForm α u c) (C := C * sourceWeight u ^ 100) hD p
      intro G
      simpa only [mul_assoc] using hreal G
    _ = 16 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
      ring

/-- The real/imaginary expansion of one complex coefficient has two terms. -/
theorem scratch_sum_two (A : ℝ) : (∑ _ : Bool, A) = 2 * A := by
  norm_num

/-- If the real initial estimate is uniform over all measurable real
coefficients bounded by one, it transfers to a complex coefficient and four
complex inputs. The factor `32 = 2^5` is exactly the coefficient choice
times the four input choices in blueprint Section 7. -/
theorem scratch_norm_ModelFullFormComplexCoefficientComplexified_le_weight100
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (C : ℝ) (hC : 0 ≤ C) (p : Fin 4 → ℝ)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, ‖c t‖ ≤ 1)
    (hreal : ∀ (d : ℝ → ℝ), Measurable d → (∀ t : ℝ, |d t| ≤ 1) →
      ∀ G : ModelSchwartzInput,
        |ModelFullForm α u d G| ≤ C * sourceWeight u ^ 100 *
          ∏ j : Fin 4, lpNorm (G j : E3 → ℝ)
            (ENNReal.ofReal (p j)) volume)
    (F : ScratchModelComplexSchwartzInput) :
    ‖scratch_ModelFullFormComplexCoefficientComplexified α u c F‖ ≤
      32 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
  unfold scratch_ModelFullFormComplexCoefficientComplexified
  calc
    ‖∑ δ : Bool, scratch_complexCoefficientPhase δ *
        scratch_ModelFullFormComplexified α u
          (scratch_complexCoefficientComponent δ c) F‖ ≤
        ∑ δ : Bool, ‖scratch_complexCoefficientPhase δ *
          scratch_ModelFullFormComplexified α u
            (scratch_complexCoefficientComponent δ c) F‖ :=
      norm_sum_le _ _
    _ = ∑ δ : Bool, ‖scratch_ModelFullFormComplexified α u
        (scratch_complexCoefficientComponent δ c) F‖ := by
      apply Finset.sum_congr rfl
      intro δ _
      rw [norm_mul, scratch_norm_complexCoefficientPhase, one_mul]
    _ ≤ ∑ _δ : Bool, 16 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
      apply Finset.sum_le_sum
      intro δ _
      apply scratch_norm_ModelFullFormComplexified_le_weight100
        α u (scratch_complexCoefficientComponent δ c) C hC p
      intro G
      exact hreal (scratch_complexCoefficientComponent δ c)
        (scratch_complexCoefficientComponent_measurable δ c hcmeas)
        (scratch_abs_complexCoefficientComponent_le_one δ c hc) G
    _ = 32 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (p j)) volume := by
      rw [scratch_sum_two]
      ring

/-- The forest construction in the real initial range supplies one constant
for every translation, real unit coefficient, and real Schwartz four-tuple.
This puts the quantifiers in the order needed by the complexification step. -/
theorem scratch_exists_uniform_initialModelFullForm_bound_weight75
    (α : Anisotropy) (q : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (c : ℝ → ℝ)
      (F : InitialModelSchwartzInput),
      Measurable c → (∀ t : ℝ, |c t| ≤ 1) →
      |ModelFullForm α u c F| ≤ C * sourceWeight u ^ 75 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume := by
  rcases exists_uniform_activeStoppingForest_constant α with
    ⟨C₀, hC₀, hforest⟩
  let K : Fin 4 → ℝ := fun _ ↦ dyadicBracketShellConstant
  let D : Fin 4 → ℝ := fun j ↦ sourceStoppingDyadicInputConstant K q j
  let C : ℝ := C₀ * ∑ j : Fin 4, D j
  have hD : ∀ j : Fin 4, 0 ≤ D j := by
    intro j
    dsimp only [D]
    exact sourceStoppingDyadicInputConstant_nonneg K q j (hq j)
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg hC₀ (Finset.sum_nonneg fun j _ ↦ hD j)
  refine ⟨C, hC, ?_⟩
  intro u c F hcmeas hc
  by_cases hzero : ∃ j : Fin 4, F j = 0
  · rcases hzero with ⟨j, hj⟩
    rw [ModelFullForm_eq_zero_of_component_eq_zero α u c F j hj]
    have hprod : 0 ≤ ∏ j : Fin 4,
        lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
      exact Finset.prod_nonneg fun j _ ↦ lpNorm_nonneg
    simpa using (mul_nonneg
      (mul_nonneg hC (pow_nonneg (sourceWeight_nonneg u) 75))
      hprod)
  · have hF : ∀ j : Fin 4, F j ≠ 0 := by
      intro j hj
      exact hzero ⟨j, hj⟩
    apply fourlinear_bound_of_normalized_bound
      (L := ModelFullForm α u c)
      (N := fun j f ↦ lpNorm (f : E3 → ℝ)
        (ENNReal.ofReal (q j)) volume)
      (C := C * sourceWeight u ^ 75)
    · exact ModelFullForm_rescale α u c
    · intro G hGunit
      have hG : ∀ j : Fin 4, G j ≠ 0 := by
        intro j hzero
        have hzeroNorm : lpNorm (G j : E3 → ℝ)
            (ENNReal.ofReal (q j)) volume = 0 := by
          rw [hzero]
          change lpNorm (0 : E3 → ℝ) (ENNReal.ofReal (q j)) volume = 0
          exact lpNorm_zero (ENNReal.ofReal (q j)) volume
        linarith [hGunit j]
      let W : ℝ := ∑ j : Fin 4, D j *
        ∫ x : E3, |G j x| ^ q j
      have hfull : ∀ N : ℕ, Integrable
          (modelFiberFullyExpandedIntegrand α u c (InitialModelRealInput G))
          (((cubeScaleMeasure.restrict
            (Set.univ ×ˢ truncationScaleSet N)).prod
              (volume : Measure ModelE5)).prod
            ((volume : Measure ℝ).prod volume)) := by
        intro N
        exact integrable_modelFiberFullyExpanded_truncationScale
          α u c G N hcmeas hc
      have hdistribution : ∀ M : ℕ,
          SourceStoppingCoordinateEnvelope α (truncationCollection α M)
            (InitialModelRealInput G) q (fun _ ↦ 0)
            (initialModel_sourceStoppingData_all_pos_of_ne_zero
              α (truncationCollection α M) G hG) ≤ W := by
        intro M
        dsimp only [W, D, K]
        exact initialSourceStoppingCoordinateEnvelope_le_explicitInputPowers_of_realSchwartz
          α (truncationCollection α M) G q hq hsum hqs hG
      have hglobal :=
        modelFullForm_bound_of_initial_stoppingEnvelope_of_uniformForest
          α C₀ hC₀ hforest u c G q (fun _ ↦ 0) W hq hG hcmeas hc
          hfull hdistribution
      have hpower (j : Fin 4) :
          (∫ x : E3, |G j x| ^ q j) = 1 :=
        integral_abs_rpow_eq_one_of_lpNorm_eq_one
          (G j : E3 → ℝ) (q j) (hq j)
          (G j).continuous.aestronglyMeasurable (hGunit j)
      have hW : W = ∑ j : Fin 4, D j := by
        dsimp only [W]
        apply Finset.sum_congr rfl
        intro j _
        rw [hpower j, mul_one]
      rw [hW] at hglobal
      change |ModelFullForm α u c G| ≤ C * sourceWeight u ^ 75
      dsimp only [C]
      calc
        |ModelFullForm α u c G| ≤
            C₀ * sourceWeight u ^ 75 * ∑ j : Fin 4, D j := hglobal
        _ = (C₀ * ∑ j : Fin 4, D j) * sourceWeight u ^ 75 := by ring
    · intro j
      exact lpNorm_pos_of_realSchwartz_ne_zero
        (F j) (q j) (hq j) (hF j)
    · intro j
      exact lpNorm_inv_smul_eq_one
        (F j : E3 → ℝ) (q j)
        (lpNorm_pos_of_realSchwartz_ne_zero
          (F j) (q j) (hq j) (hF j))

/-- The same uniform real initial range at the larger translation exponent
displayed in the blueprint. -/
theorem scratch_exists_uniform_initialModelFullForm_bound_weight100
    (α : Anisotropy) (q : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (c : ℝ → ℝ)
      (F : InitialModelSchwartzInput),
      Measurable c → (∀ t : ℝ, |c t| ≤ 1) →
      |ModelFullForm α u c F| ≤ C * sourceWeight u ^ 100 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume := by
  rcases scratch_exists_uniform_initialModelFullForm_bound_weight75
    α q hq hsum hqs with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u c F hcmeas hc
  refine (hbound u c F hcmeas hc).trans ?_
  have hweight : 1 ≤ sourceWeight u := by
    unfold sourceWeight
    linarith [abs_nonneg (u 0), abs_nonneg (u 1), abs_nonneg (u 2)]
  have hpow : sourceWeight u ^ 75 ≤ sourceWeight u ^ 100 :=
    pow_le_pow_right₀ hweight (by norm_num)
  have hprod : 0 ≤ ∏ j : Fin 4,
      lpNorm (F j : E3 → ℝ) (ENNReal.ofReal (q j)) volume := by
    exact Finset.prod_nonneg fun j _ ↦ lpNorm_nonneg
  calc
    C * sourceWeight u ^ 75 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume =
        (C * ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume) * sourceWeight u ^ 75 := by ring
    _ ≤ (C * ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume) * sourceWeight u ^ 100 :=
      mul_le_mul_of_nonneg_left hpow (mul_nonneg hC hprod)
    _ = C * sourceWeight u ^ 100 *
        ∏ j : Fin 4, lpNorm (F j : E3 → ℝ)
          (ENNReal.ofReal (q j)) volume := by ring

/-- The complete strict initial range for the literal algebraic
complexification is uniform over translations, complex unit coefficients, and
complex Schwartz four-tuples. -/
theorem scratch_exists_uniform_ModelFullFormComplexCoefficientComplexified_bound_weight100
    (α : Anisotropy) (q : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (c : ℝ → ℂ)
      (F : ScratchModelComplexSchwartzInput),
      Measurable c → (∀ t : ℝ, ‖c t‖ ≤ 1) →
      ‖scratch_ModelFullFormComplexCoefficientComplexified α u c F‖ ≤
        32 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
          lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (q j)) volume := by
  rcases scratch_exists_uniform_initialModelFullForm_bound_weight100
    α q hq hsum hqs with ⟨C, hC, hreal⟩
  refine ⟨C, hC, ?_⟩
  intro u c F hcmeas hc
  apply scratch_norm_ModelFullFormComplexCoefficientComplexified_le_weight100
    α u c C hC q hcmeas hc
  intro d hdmeas hd G
  exact hreal u d G hdmeas hd

/-! ### Literal complex model form -/

/-- The literal complex version of one coordinate convolution in the source
model. The kernel remains real-valued and is embedded into `ℂ` in the
integrand. -/
noncomputable def scratch_LiteralModelCoordinateConvolution
    (i : Fin 3) (f : E3 → ℂ) (k : ℝ → ℝ) (s : ℝ) (x : E3) : ℂ :=
  ∫ r : ℝ, f (x - r • Anisotropy.coordinateDirection i) *
    ((kernelDilate k s r : ℝ) : ℂ)

/-- On real data, the literal complex coordinate convolution is exactly the
standard complex embedding of the source real convolution. -/
theorem scratch_LiteralModelCoordinateConvolution_complexifyRealSchwartz
    (i : Fin 3) (f : SchwartzMap E3 ℝ) (k : ℝ → ℝ) (s : ℝ) (x : E3) :
    scratch_LiteralModelCoordinateConvolution i (complexifyRealSchwartz f) k s x =
      (ModelCoordinateConvolution i f k s x : ℂ) := by
  unfold scratch_LiteralModelCoordinateConvolution ModelCoordinateConvolution
  rw [← integral_complex_ofReal]
  apply integral_congr_ae
  filter_upwards [] with r
  rw [complexifyRealSchwartz_apply]
  norm_cast

/-- The literal complex spatial integrand, with precisely the three source
coordinate convolutions and the original association of the four factors. -/
noncomputable def scratch_LiteralModelSpatialIntegrand
    (α : Anisotropy) (u : E3) (F : ScratchModelComplexSchwartzInput)
    (t : ℝ) (x : E3) : ℂ :=
  F 0 x *
    scratch_LiteralModelCoordinateConvolution 0 (F 1)
      (ModelLowKernel (u 0)) (t ^ α.weight 0) x *
    scratch_LiteralModelCoordinateConvolution 1 (F 2)
      (ModelLowKernel (u 1)) (t ^ α.weight 1) x *
    scratch_LiteralModelCoordinateConvolution 2 (F 3)
      (ModelThirdKernel (u 2)) (t ^ α.weight 2) x

/-- The literal complex spatial profile, before integration in scale. -/
noncomputable def scratch_LiteralModelSpatialProfile
    (α : Anisotropy) (u : E3) (F : ScratchModelComplexSchwartzInput)
    (t : ℝ) : ℂ :=
  ∫ x : E3, scratch_LiteralModelSpatialIntegrand α u F t x

/-- The literal complex-valued full model form: complex coefficient and four
complex inputs, with the exact source convolution and two integrations. -/
noncomputable def scratch_LiteralModelFullForm
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (F : ScratchModelComplexSchwartzInput) : ℂ :=
  ∫ t in Set.Ioi (0 : ℝ), c t * scratch_LiteralModelSpatialProfile α u F t
    ∂((volume : Measure ℝ).withDensity cubeScaleDensity)

/-- The literal complex spatial integrand reduces pointwise to the source
real integrand on real embedded Schwartz data. -/
theorem scratch_LiteralModelSpatialIntegrand_complexifyRealSchwartz
    (α : Anisotropy) (u : E3) (G : ModelSchwartzInput)
    (t : ℝ) (x : E3) :
    scratch_LiteralModelSpatialIntegrand α u
      (fun j ↦ complexifyRealSchwartz (G j)) t x =
        (ModelSpatialIntegrand α u G t x : ℂ) := by
  unfold scratch_LiteralModelSpatialIntegrand ModelSpatialIntegrand
  rw [scratch_LiteralModelCoordinateConvolution_complexifyRealSchwartz,
    scratch_LiteralModelCoordinateConvolution_complexifyRealSchwartz,
    scratch_LiteralModelCoordinateConvolution_complexifyRealSchwartz]
  simp only [complexifyRealSchwartz_apply]
  norm_cast

/-- The literal complex spatial profile reduces to the complex embedding of
the real profile on real embedded data. -/
theorem scratch_LiteralModelSpatialProfile_complexifyRealSchwartz
    (α : Anisotropy) (u : E3) (G : ModelSchwartzInput) (t : ℝ) :
    scratch_LiteralModelSpatialProfile α u
      (fun j ↦ complexifyRealSchwartz (G j)) t =
        (ModelSpatialProfile α u G t : ℂ) := by
  unfold scratch_LiteralModelSpatialProfile ModelSpatialProfile
  calc
    ∫ x : E3, scratch_LiteralModelSpatialIntegrand α u
        (fun j ↦ complexifyRealSchwartz (G j)) t x =
        ∫ x : E3, (ModelSpatialIntegrand α u G t x : ℂ) := by
          apply integral_congr_ae
          filter_upwards [] with x
          exact scratch_LiteralModelSpatialIntegrand_complexifyRealSchwartz α u G t x
    _ = (∫ x : E3, ModelSpatialIntegrand α u G t x : ℝ) :=
      integral_complex_ofReal

/-- The literal complex full form reduces to the complex embedding of the
source real form on a real coefficient and real embedded inputs. -/
theorem scratch_LiteralModelFullForm_complexifyRealSchwartz
    (α : Anisotropy) (u : E3) (d : ℝ → ℝ) (G : ModelSchwartzInput) :
    scratch_LiteralModelFullForm α u (fun t ↦ (d t : ℂ))
      (fun j ↦ complexifyRealSchwartz (G j)) =
        (ModelFullForm α u d G : ℂ) := by
  unfold scratch_LiteralModelFullForm ModelFullForm
  calc
    ∫ t in Set.Ioi (0 : ℝ), (d t : ℂ) *
        scratch_LiteralModelSpatialProfile α u
          (fun j ↦ complexifyRealSchwartz (G j)) t
        ∂((volume : Measure ℝ).withDensity cubeScaleDensity) =
        ∫ t in Set.Ioi (0 : ℝ),
          ((d t * ModelSpatialProfile α u G t : ℝ) : ℂ)
          ∂((volume : Measure ℝ).withDensity cubeScaleDensity) := by
          apply integral_congr_ae
          filter_upwards [] with t
          rw [scratch_LiteralModelSpatialProfile_complexifyRealSchwartz]
          norm_cast
    _ = ((∫ t in Set.Ioi (0 : ℝ), d t * ModelSpatialProfile α u G t
          ∂((volume : Measure ℝ).withDensity cubeScaleDensity) : ℝ) : ℂ) :=
      integral_complex_ofReal

/-- One of the two scalar phases occurring in a single input expansion. -/
def scratch_inputPhase (b : Bool) : ℂ := if b then Complex.I else 1

/-- Select one real component of a single complex Schwartz input. -/
noncomputable def scratch_complexInputComponent
    (b : Bool) (f : SchwartzMap E3 ℂ) : SchwartzMap E3 ℝ :=
  if b then scratch_imagPartSchwartz f else scratch_realPartSchwartz f

@[simp] theorem scratch_complexInputComponent_apply
    (b : Bool) (f : SchwartzMap E3 ℂ) (x : E3) :
    scratch_complexInputComponent b f x =
      if b then (f x).im else (f x).re := by
  cases b <;> rfl

/-- The tuple component selector is the slotwise version of the single-input
component selector. -/
theorem scratch_complexComponent_eq_complexInputComponent
    (ε : Fin 4 → Bool) (F : ScratchModelComplexSchwartzInput) (j : Fin 4) :
    scratch_complexComponent ε F j =
      scratch_complexInputComponent (ε j) (F j) := by
  unfold scratch_complexComponent scratch_complexInputComponent
  split <;> rfl

/-- The real integrand of a coordinate convolution is integrable at a
positive scale for every real Schwartz input and integrable real kernel. -/
theorem scratch_integrable_coordinate_integrand
    (i : Fin 3) (f : SchwartzMap E3 ℝ) (k : ℝ → ℝ) (s : ℝ) (x : E3)
    (hk : Integrable k) (hs : 0 < s) :
    Integrable (fun r : ℝ ↦
      f (x - r • Anisotropy.coordinateDirection i) * kernelDilate k s r) := by
  let B : ℝ := SchwartzMap.seminorm ℝ 0 0 f
  have hbound (y : E3) : |f y| ≤ B := by
    simpa only [B, Real.norm_eq_abs] using
      SchwartzMap.norm_le_seminorm ℝ f y
  have hmap : Continuous (fun r : ℝ ↦ x - r • Anisotropy.coordinateDirection i) :=
    continuous_const.sub (continuous_id.smul continuous_const)
  have hkd : Integrable (fun r : ℝ ↦ kernelDilate k s r) :=
    integrable_kernelDilate hk hs.ne'
  have hmeas : AEStronglyMeasurable (fun r : ℝ ↦
      f (x - r • Anisotropy.coordinateDirection i) * kernelDilate k s r) volume :=
    (f.continuous.comp hmap).aestronglyMeasurable.mul hkd.aestronglyMeasurable
  have hupper : Integrable (fun r : ℝ ↦ B * |kernelDilate k s r|) :=
    (integrable_abs_kernelDilate k hk hs).const_mul B
  apply hupper.mono' hmeas
  filter_upwards [] with r
  change |f (x - r • Anisotropy.coordinateDirection i) * kernelDilate k s r| ≤
    B * |kernelDilate k s r|
  rw [abs_mul]
  exact mul_le_mul_of_nonneg_right (hbound _) (abs_nonneg _)

/-- Pointwise real/imaginary expansion of the literal complex coordinate
integrand. -/
theorem scratch_LiteralModelCoordinateIntegrand_expand
    (f : SchwartzMap E3 ℂ) (y : E3) (k : ℝ) :
    f y * (k : ℂ) = ∑ b : Bool, scratch_inputPhase b *
      ((scratch_complexInputComponent b f y * k : ℝ) : ℂ) := by
  rw [Fintype.sum_bool]
  simp only [scratch_inputPhase, scratch_complexInputComponent_apply]
  simp only [↓reduceIte, Complex.ofReal_mul, Bool.false_eq_true, one_mul]
  calc
    f y * (k : ℂ) = ((f y).re : ℂ) * (k : ℂ) +
        ((f y).im : ℂ) * Complex.I * (k : ℂ) := by
      calc
        f y * (k : ℂ) = (((f y).re : ℂ) +
            ((f y).im : ℂ) * Complex.I) * (k : ℂ) := by
              rw [Complex.re_add_im]
        _ = _ := by ring
    _ = Complex.I * ((f y).im : ℂ) * (k : ℂ) +
        ((f y).re : ℂ) * (k : ℂ) := by ring
  all_goals rw [mul_assoc]

/-- At every positive scale, the literal complex coordinate convolution is
the two-term real/imaginary expansion of the source real convolution. -/
theorem scratch_LiteralModelCoordinateConvolution_expand
    (i : Fin 3) (f : SchwartzMap E3 ℂ) (k : ℝ → ℝ) (s : ℝ) (x : E3)
    (hk : Integrable k) (hs : 0 < s) :
    scratch_LiteralModelCoordinateConvolution i f k s x =
      ∑ b : Bool, scratch_inputPhase b *
        (ModelCoordinateConvolution i (scratch_complexInputComponent b f) k s x : ℂ) := by
  unfold scratch_LiteralModelCoordinateConvolution ModelCoordinateConvolution
  calc
    (∫ r : ℝ, f (x - r • Anisotropy.coordinateDirection i) *
        ((kernelDilate k s r : ℝ) : ℂ)) =
        ∫ r : ℝ, ∑ b : Bool, scratch_inputPhase b *
          ((scratch_complexInputComponent b f
            (x - r • Anisotropy.coordinateDirection i) *
              kernelDilate k s r : ℝ) : ℂ) := by
          apply integral_congr_ae
          filter_upwards [] with r
          exact scratch_LiteralModelCoordinateIntegrand_expand f
            (x - r • Anisotropy.coordinateDirection i) (kernelDilate k s r)
    _ = ∑ b : Bool, ∫ r : ℝ, scratch_inputPhase b *
        ((scratch_complexInputComponent b f
          (x - r • Anisotropy.coordinateDirection i) *
            kernelDilate k s r : ℝ) : ℂ) := by
          simpa using (integral_finsetSum (μ := volume) (s := Finset.univ)
            (f := fun b r ↦ scratch_inputPhase b *
              ((scratch_complexInputComponent b f
                (x - r • Anisotropy.coordinateDirection i) *
                  kernelDilate k s r : ℝ) : ℂ)) (by
                intro b _
                exact ((scratch_integrable_coordinate_integrand
                  i (scratch_complexInputComponent b f) k s x hk hs).ofReal).const_mul
                    (scratch_inputPhase b)))
    _ = ∑ b : Bool, scratch_inputPhase b *
        (∫ r : ℝ, scratch_complexInputComponent b f
          (x - r • Anisotropy.coordinateDirection i) *
            kernelDilate k s r : ℝ) := by
          apply Finset.sum_congr rfl
          intro b _
          rw [integral_const_mul, integral_complex_ofReal]

/-- A product of four binary expansions is the expected sum over the sixteen
choices of real or imaginary part. -/
theorem scratch_prod_binary_expansion
    (z : Fin 4 → ℂ) (r : Bool → Fin 4 → ℂ)
    (hz : ∀ j, z j = ∑ b : Bool, scratch_inputPhase b * r b j) :
    (∏ j : Fin 4, z j) = ∑ ε : Fin 4 → Bool,
      scratch_complexPhase ε * ∏ j : Fin 4, r (ε j) j := by
  calc
    (∏ j : Fin 4, z j) = ∏ j : Fin 4,
        ∑ b : Bool, scratch_inputPhase b * r b j := by
          apply Finset.prod_congr rfl
          intro j _
          exact hz j
    _ = ∑ ε : Fin 4 → Bool,
        ∏ j : Fin 4, scratch_inputPhase (ε j) * r (ε j) j :=
      Fintype.prod_sum _
    _ = ∑ ε : Fin 4 → Bool, scratch_complexPhase ε *
        ∏ j : Fin 4, r (ε j) j := by
      apply Finset.sum_congr rfl
      intro ε _
      rw [Finset.prod_mul_distrib]
      rfl

/-- The four complex factors whose product is the literal complex spatial
integrand, listed in source input order. -/
noncomputable def scratch_LiteralModelSpatialFactors
    (α : Anisotropy) (u : E3) (F : ScratchModelComplexSchwartzInput)
    (t : ℝ) (x : E3) : Fin 4 → ℂ :=
  ![F 0 x,
    scratch_LiteralModelCoordinateConvolution 0 (F 1)
      (ModelLowKernel (u 0)) (t ^ α.weight 0) x,
    scratch_LiteralModelCoordinateConvolution 1 (F 2)
      (ModelLowKernel (u 1)) (t ^ α.weight 1) x,
    scratch_LiteralModelCoordinateConvolution 2 (F 3)
      (ModelThirdKernel (u 2)) (t ^ α.weight 2) x]

/-- The two real factor choices at each of the four source input slots. -/
noncomputable def scratch_ModelSpatialBinaryFactors
    (α : Anisotropy) (u : E3) (F : ScratchModelComplexSchwartzInput)
    (t : ℝ) (x : E3) (b : Bool) : Fin 4 → ℂ :=
  ![(scratch_complexInputComponent b (F 0) x : ℂ),
    (ModelCoordinateConvolution 0 (scratch_complexInputComponent b (F 1))
      (ModelLowKernel (u 0)) (t ^ α.weight 0) x : ℂ),
    (ModelCoordinateConvolution 1 (scratch_complexInputComponent b (F 2))
      (ModelLowKernel (u 1)) (t ^ α.weight 1) x : ℂ),
    (ModelCoordinateConvolution 2 (scratch_complexInputComponent b (F 3))
      (ModelThirdKernel (u 2)) (t ^ α.weight 2) x : ℂ)]

/-- Reassociation identifies the literal spatial integrand with the product
of its four source-ordered factors. -/
theorem scratch_LiteralModelSpatialIntegrand_eq_prod_factors
    (α : Anisotropy) (u : E3) (F : ScratchModelComplexSchwartzInput)
    (t : ℝ) (x : E3) :
    scratch_LiteralModelSpatialIntegrand α u F t x =
      ∏ j : Fin 4, scratch_LiteralModelSpatialFactors α u F t x j := by
  simp [scratch_LiteralModelSpatialIntegrand,
    scratch_LiteralModelSpatialFactors, Fin.prod_univ_succ]
  ring

/-- A complex Schwartz value is the two-term expansion of its real and
imaginary components. -/
theorem scratch_complexInput_expand
    (f : SchwartzMap E3 ℂ) (x : E3) :
    f x = ∑ b : Bool, scratch_inputPhase b *
      (scratch_complexInputComponent b f x : ℂ) := by
  rw [Fintype.sum_bool]
  simp only [scratch_inputPhase, scratch_complexInputComponent_apply]
  simp only [↓reduceIte, Bool.false_eq_true, one_mul]
  calc
    f x = ((f x).re : ℂ) + ((f x).im : ℂ) * Complex.I :=
      (Complex.re_add_im _).symm
    _ = Complex.I * ((f x).im : ℂ) + ((f x).re : ℂ) := by ring

/-- Each factor of the literal spatial integrand has its appropriate binary
real/imaginary expansion at positive scales. -/
theorem scratch_LiteralModelSpatialFactors_expand
    (α : Anisotropy) (u : E3) (F : ScratchModelComplexSchwartzInput)
    (t : ℝ) (x : E3) (ht : 0 < t) (j : Fin 4) :
    scratch_LiteralModelSpatialFactors α u F t x j =
      ∑ b : Bool, scratch_inputPhase b *
        scratch_ModelSpatialBinaryFactors α u F t x b j := by
  have hs0 : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs1 : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs2 : 0 < t ^ α.weight 2 := pow_pos ht _
  fin_cases j
  · simpa [scratch_LiteralModelSpatialFactors,
      scratch_ModelSpatialBinaryFactors] using scratch_complexInput_expand (F 0) x
  · simpa [scratch_LiteralModelSpatialFactors,
      scratch_ModelSpatialBinaryFactors] using
      scratch_LiteralModelCoordinateConvolution_expand 0 (F 1)
        (ModelLowKernel (u 0)) (t ^ α.weight 0) x
        (integrable_ModelLowKernel (u 0)) hs0
  · simpa [scratch_LiteralModelSpatialFactors,
      scratch_ModelSpatialBinaryFactors] using
      scratch_LiteralModelCoordinateConvolution_expand 1 (F 2)
        (ModelLowKernel (u 1)) (t ^ α.weight 1) x
        (integrable_ModelLowKernel (u 1)) hs1
  · simpa [scratch_LiteralModelSpatialFactors,
      scratch_ModelSpatialBinaryFactors] using
      scratch_LiteralModelCoordinateConvolution_expand 2 (F 3)
        (ModelThirdKernel (u 2)) (t ^ α.weight 2) x
        (integrable_ModelThirdKernel (u 2)) hs2

/-- The product of the selected real factors is exactly the real source
spatial integrand for the corresponding four-input component choice. -/
theorem scratch_ModelSpatialBinaryFactors_prod_eq_component
    (α : Anisotropy) (u : E3) (F : ScratchModelComplexSchwartzInput)
    (t : ℝ) (x : E3) (ε : Fin 4 → Bool) :
    (∏ j : Fin 4, scratch_ModelSpatialBinaryFactors α u F t x (ε j) j) =
      (ModelSpatialIntegrand α u (scratch_complexComponent ε F) t x : ℂ) := by
  have h0 := scratch_complexComponent_eq_complexInputComponent ε F 0
  have h1 := scratch_complexComponent_eq_complexInputComponent ε F 1
  have h2 := scratch_complexComponent_eq_complexInputComponent ε F 2
  have h3 := scratch_complexComponent_eq_complexInputComponent ε F 3
  unfold ModelSpatialIntegrand
  rw [h0, h1, h2, h3]
  rw [Fin.prod_univ_four]
  simp [scratch_ModelSpatialBinaryFactors]
  split <;> norm_cast

/-- At every positive scale, the literal complex spatial integrand is the
sixteen-term source real/imaginary expansion. -/
theorem scratch_LiteralModelSpatialIntegrand_expand
    (α : Anisotropy) (u : E3) (F : ScratchModelComplexSchwartzInput)
    (t : ℝ) (x : E3) (ht : 0 < t) :
    scratch_LiteralModelSpatialIntegrand α u F t x =
      ∑ ε : Fin 4 → Bool, scratch_complexPhase ε *
        (ModelSpatialIntegrand α u (scratch_complexComponent ε F) t x : ℂ) := by
  rw [scratch_LiteralModelSpatialIntegrand_eq_prod_factors]
  rw [scratch_prod_binary_expansion]
  · refine Finset.sum_congr rfl (fun ε _ => ?_)
    rw [scratch_ModelSpatialBinaryFactors_prod_eq_component]
  · exact scratch_LiteralModelSpatialFactors_expand α u F t x ht

/-- The real source spatial integrand is integrable at every positive scale
for a real Schwartz four-tuple. This localizes the integrability needed to
pass the sixteen-term expansion through the spatial integral. -/
theorem scratch_integrable_ModelSpatialIntegrand
    (α : Anisotropy) (u : E3) (G : ModelSchwartzInput) (t : ℝ) (ht : 0 < t) :
    Integrable (fun x : E3 ↦ ModelSpatialIntegrand α u G t x) := by
  let B1 : ℝ := SchwartzMap.seminorm ℝ 0 0 (G 1)
  let B2 : ℝ := SchwartzMap.seminorm ℝ 0 0 (G 2)
  let B3 : ℝ := SchwartzMap.seminorm ℝ 0 0 (G 3)
  have hB1 : 0 ≤ B1 := by
    exact (norm_nonneg ((G 1) 0)).trans
      (SchwartzMap.norm_le_seminorm ℝ (G 1) (0 : E3))
  have hB2 : 0 ≤ B2 := by
    exact (norm_nonneg ((G 2) 0)).trans
      (SchwartzMap.norm_le_seminorm ℝ (G 2) (0 : E3))
  have hB3 : 0 ≤ B3 := by
    exact (norm_nonneg ((G 3) 0)).trans
      (SchwartzMap.norm_le_seminorm ℝ (G 3) (0 : E3))
  have hG1 (x : E3) : |G 1 x| ≤ B1 := by
    simpa only [B1, Real.norm_eq_abs] using
      SchwartzMap.norm_le_seminorm ℝ (G 1) x
  have hG2 (x : E3) : |G 2 x| ≤ B2 := by
    simpa only [B2, Real.norm_eq_abs] using
      SchwartzMap.norm_le_seminorm ℝ (G 2) x
  have hG3 (x : E3) : |G 3 x| ≤ B3 := by
    simpa only [B3, Real.norm_eq_abs] using
      SchwartzMap.norm_le_seminorm ℝ (G 3) x
  have hs0 : 0 < t ^ α.weight 0 := pow_pos ht _
  have hs1 : 0 < t ^ α.weight 1 := pow_pos ht _
  have hs2 : 0 < t ^ α.weight 2 := pow_pos ht _
  let A0 : ℝ := B1 * ∫ r : ℝ, |ModelLowKernel (u 0) r|
  let A1 : ℝ := B2 * ∫ r : ℝ, |ModelLowKernel (u 1) r|
  let A2 : ℝ := B3 * ∫ r : ℝ, |ModelThirdKernel (u 2) r|
  have hA0 : ∀ x : E3,
      |ModelCoordinateConvolution 0 (G 1) (ModelLowKernel (u 0))
        (t ^ α.weight 0) x| ≤ A0 := by
    intro x
    simpa only [A0] using abs_ModelCoordinateConvolution_le
      0 (G 1) (ModelLowKernel (u 0)) (t ^ α.weight 0) x
      (G 1).continuous B1 hG1 (integrable_ModelLowKernel (u 0)) hs0
  have hA1 : ∀ x : E3,
      |ModelCoordinateConvolution 1 (G 2) (ModelLowKernel (u 1))
        (t ^ α.weight 1) x| ≤ A1 := by
    intro x
    simpa only [A1] using abs_ModelCoordinateConvolution_le
      1 (G 2) (ModelLowKernel (u 1)) (t ^ α.weight 1) x
      (G 2).continuous B2 hG2 (integrable_ModelLowKernel (u 1)) hs1
  have hA2 : ∀ x : E3,
      |ModelCoordinateConvolution 2 (G 3) (ModelThirdKernel (u 2))
        (t ^ α.weight 2) x| ≤ A2 := by
    intro x
    simpa only [A2] using abs_ModelCoordinateConvolution_le
      2 (G 3) (ModelThirdKernel (u 2)) (t ^ α.weight 2) x
      (G 3).continuous B3 hG3 (integrable_ModelThirdKernel (u 2)) hs2
  have hA0nonneg : 0 ≤ A0 := by
    dsimp only [A0]
    exact mul_nonneg hB1 (integral_nonneg fun _ ↦ abs_nonneg _)
  have hA1nonneg : 0 ≤ A1 := by
    dsimp only [A1]
    exact mul_nonneg hB2 (integral_nonneg fun _ ↦ abs_nonneg _)
  have hA2nonneg : 0 ≤ A2 := by
    dsimp only [A2]
    exact mul_nonneg hB3 (integral_nonneg fun _ ↦ abs_nonneg _)
  let D : ℝ := A0 * A1 * A2
  have hD : 0 ≤ D := by
    dsimp only [D]
    positivity
  have hG0int : Integrable (fun x : E3 ↦ |G 0 x|) := by
    simpa only [Real.norm_eq_abs] using (G 0).integrable.norm
  have hupper : Integrable (fun x : E3 ↦ D * |G 0 x|) :=
    hG0int.const_mul D
  have hmeas : AEStronglyMeasurable
      (fun x : E3 ↦ ModelSpatialIntegrand α u G t x) volume := by
    exact ((stronglyMeasurable_ModelSpatialIntegrand α u G).comp_measurable
      (measurable_const.prodMk measurable_id)).aestronglyMeasurable
  apply hupper.mono' hmeas
  filter_upwards [] with x
  change ‖ModelSpatialIntegrand α u G t x‖ ≤ D * |G 0 x|
  simpa only [Real.norm_eq_abs] using (show
    |ModelSpatialIntegrand α u G t x| ≤ D * |G 0 x| by
      unfold ModelSpatialIntegrand
      dsimp only [D]
      rw [abs_mul, abs_mul, abs_mul]
      calc
        |G 0 x| *
            |ModelCoordinateConvolution 0 (G 1) (ModelLowKernel (u 0))
                (t ^ α.weight 0) x| *
            |ModelCoordinateConvolution 1 (G 2) (ModelLowKernel (u 1))
                (t ^ α.weight 1) x| *
            |ModelCoordinateConvolution 2 (G 3) (ModelThirdKernel (u 2))
                (t ^ α.weight 2) x| ≤
            |G 0 x| * A0 * A1 * A2 := by
              gcongr
              · exact hA0 x
              · exact hA1 x
              · exact hA2 x
        _ = A0 * A1 * A2 * |G 0 x| := by ring)

/-- At every positive scale, the literal complex spatial profile is the
sixteen-term real/imaginary expansion of the source real profiles. -/
theorem scratch_LiteralModelSpatialProfile_expand
    (α : Anisotropy) (u : E3) (F : ScratchModelComplexSchwartzInput)
    (t : ℝ) (ht : 0 < t) :
    scratch_LiteralModelSpatialProfile α u F t =
      ∑ ε : Fin 4 → Bool, scratch_complexPhase ε *
        (ModelSpatialProfile α u (scratch_complexComponent ε F) t : ℂ) := by
  unfold scratch_LiteralModelSpatialProfile ModelSpatialProfile
  calc
    (∫ x : E3, scratch_LiteralModelSpatialIntegrand α u F t x) =
        ∫ x : E3, ∑ ε : Fin 4 → Bool, scratch_complexPhase ε *
          (ModelSpatialIntegrand α u (scratch_complexComponent ε F) t x : ℂ) := by
          apply integral_congr_ae
          filter_upwards [] with x
          exact scratch_LiteralModelSpatialIntegrand_expand α u F t x ht
    _ = ∑ ε : Fin 4 → Bool, ∫ x : E3, scratch_complexPhase ε *
        (ModelSpatialIntegrand α u (scratch_complexComponent ε F) t x : ℂ) := by
          simpa using (integral_finsetSum (μ := volume) (s := Finset.univ)
            (f := fun ε x ↦ scratch_complexPhase ε *
              (ModelSpatialIntegrand α u (scratch_complexComponent ε F) t x : ℂ)) (by
                intro ε _
                exact ((scratch_integrable_ModelSpatialIntegrand
                  α u (scratch_complexComponent ε F) t ht).ofReal).const_mul
                    (scratch_complexPhase ε)))
    _ = ∑ ε : Fin 4 → Bool, scratch_complexPhase ε *
        (∫ x : E3, ModelSpatialIntegrand α u (scratch_complexComponent ε F) t x : ℝ) := by
          apply Finset.sum_congr rfl
          intro ε _
          rw [integral_const_mul, integral_complex_ofReal]

/-- A complex scale coefficient is the two-term expansion of its real and
imaginary parts. -/
theorem scratch_complexCoefficient_expand
    (c : ℝ → ℂ) (t : ℝ) :
    c t = ∑ δ : Bool, scratch_complexCoefficientPhase δ *
      (scratch_complexCoefficientComponent δ c t : ℂ) := by
  rw [Fintype.sum_bool]
  simp only [scratch_complexCoefficientPhase,
    scratch_complexCoefficientComponent]
  simp only [↓reduceIte, Bool.false_eq_true, one_mul]
  calc
    c t = ((c t).re : ℂ) + ((c t).im : ℂ) * Complex.I :=
      (Complex.re_add_im _).symm
    _ = Complex.I * ((c t).im : ℂ) + ((c t).re : ℂ) := by ring

/-- Pointwise expansion of the complex scale integrand into the thirty-two
real source integrands. -/
theorem scratch_LiteralModelFullForm_integrand_expand
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (F : ScratchModelComplexSchwartzInput) (t : ℝ) (ht : 0 < t) :
    c t * scratch_LiteralModelSpatialProfile α u F t =
      ∑ δ : Bool, ∑ ε : Fin 4 → Bool,
        scratch_complexCoefficientPhase δ * scratch_complexPhase ε *
          ((scratch_complexCoefficientComponent δ c t *
            ModelSpatialProfile α u (scratch_complexComponent ε F) t : ℝ) : ℂ) := by
  rw [scratch_complexCoefficient_expand c t,
    scratch_LiteralModelSpatialProfile_expand α u F t ht]
  rw [Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro δ _
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro ε _
  rw [Complex.ofReal_mul]
  ring

/-- Each of the thirty-two real source integrands in the literal expansion
is integrable in scale for a measurable complex unit coefficient. -/
theorem scratch_integrable_LiteralModelFullForm_expansionTerm
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (F : ScratchModelComplexSchwartzInput) (δ : Bool) (ε : Fin 4 → Bool)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, ‖c t‖ ≤ 1) :
    Integrable (fun t : ℝ ↦
      scratch_complexCoefficientPhase δ * scratch_complexPhase ε *
        ((scratch_complexCoefficientComponent δ c t *
          ModelSpatialProfile α u (scratch_complexComponent ε F) t : ℝ) : ℂ))
      (((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (Set.Ioi (0 : ℝ))) := by
  have hbase := integrableOn_modelScaleProfile_of_realSchwartz
    α u (scratch_complexCoefficientComponent δ c)
      (scratch_complexComponent ε F)
      (scratch_complexCoefficientComponent_measurable δ c hcmeas)
      (scratch_abs_complexCoefficientComponent_le_one δ c hc)
  convert (((hbase.ofReal).const_mul (scratch_complexPhase ε)).const_mul
    (scratch_complexCoefficientPhase δ)) using 1
  ext t
  rw [mul_assoc]
  rfl

/-- Integrating one expansion term recovers the corresponding real source
full form, with its two complex phases left outside the integral. -/
theorem scratch_integral_LiteralModelFullForm_expansionTerm_eq
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (F : ScratchModelComplexSchwartzInput) (δ : Bool) (ε : Fin 4 → Bool) :
    ∫ t in Set.Ioi (0 : ℝ),
      scratch_complexCoefficientPhase δ * scratch_complexPhase ε *
        ((scratch_complexCoefficientComponent δ c t *
          ModelSpatialProfile α u (scratch_complexComponent ε F) t : ℝ) : ℂ)
        ∂((volume : Measure ℝ).withDensity cubeScaleDensity) =
      scratch_complexCoefficientPhase δ * scratch_complexPhase ε *
        (ModelFullForm α u (scratch_complexCoefficientComponent δ c)
          (scratch_complexComponent ε F) : ℂ) := by
  unfold ModelFullForm
  rw [integral_const_mul, integral_complex_ofReal]

/-- Under the source measurability and unit-bound hypotheses, the literal
complex convolution/integral model form is exactly its algebraic thirty-two
term real/imaginary expansion. Thus the Section 7 triangle estimate applies
to the actual complex model, not merely to an auxiliary extension. -/
theorem scratch_LiteralModelFullForm_eq_complexCoefficientComplexified
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (F : ScratchModelComplexSchwartzInput)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, ‖c t‖ ≤ 1) :
    scratch_LiteralModelFullForm α u c F =
      scratch_ModelFullFormComplexCoefficientComplexified α u c F := by
  let ν : Measure ℝ := (volume : Measure ℝ).withDensity cubeScaleDensity
  let term : Bool → (Fin 4 → Bool) → ℝ → ℂ := fun δ ε t ↦
    scratch_complexCoefficientPhase δ * scratch_complexPhase ε *
      ((scratch_complexCoefficientComponent δ c t *
        ModelSpatialProfile α u (scratch_complexComponent ε F) t : ℝ) : ℂ)
  have hterm (δ : Bool) (ε : Fin 4 → Bool) :
      Integrable (term δ ε) (ν.restrict (Set.Ioi (0 : ℝ))) := by
    dsimp only [term, ν]
    exact scratch_integrable_LiteralModelFullForm_expansionTerm
      α u c F δ ε hcmeas hc
  have hsum (δ : Bool) :
      Integrable (fun t : ℝ ↦ ∑ ε : Fin 4 → Bool, term δ ε t)
        (ν.restrict (Set.Ioi (0 : ℝ))) := by
    apply integrable_finsetSum
    intro ε _
    exact hterm δ ε
  unfold scratch_LiteralModelFullForm
  change (∫ t : ℝ, c t * scratch_LiteralModelSpatialProfile α u F t
      ∂(ν.restrict (Set.Ioi (0 : ℝ)))) =
    scratch_ModelFullFormComplexCoefficientComplexified α u c F
  calc
    (∫ t : ℝ, c t * scratch_LiteralModelSpatialProfile α u F t
      ∂(ν.restrict (Set.Ioi (0 : ℝ)))) =
        ∫ t : ℝ, ∑ δ : Bool, ∑ ε : Fin 4 → Bool, term δ ε t
          ∂(ν.restrict (Set.Ioi (0 : ℝ))) := by
          apply integral_congr_ae
          filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
          dsimp only [term]
          exact scratch_LiteralModelFullForm_integrand_expand α u c F t ht
    _ = ∑ δ : Bool, ∫ t : ℝ, ∑ ε : Fin 4 → Bool, term δ ε t
          ∂(ν.restrict (Set.Ioi (0 : ℝ))) := by
          simpa using (integral_finsetSum
            (μ := ν.restrict (Set.Ioi (0 : ℝ))) (s := Finset.univ)
            (f := fun δ t ↦ ∑ ε : Fin 4 → Bool, term δ ε t) (by
              intro δ _
              exact hsum δ))
    _ = ∑ δ : Bool, ∑ ε : Fin 4 → Bool, ∫ t : ℝ, term δ ε t
          ∂(ν.restrict (Set.Ioi (0 : ℝ))) := by
          apply Finset.sum_congr rfl
          intro δ _
          simpa using (integral_finsetSum
            (μ := ν.restrict (Set.Ioi (0 : ℝ))) (s := Finset.univ)
            (f := fun ε t ↦ term δ ε t) (by
              intro ε _
              exact hterm δ ε))
    _ = ∑ δ : Bool, ∑ ε : Fin 4 → Bool,
        scratch_complexCoefficientPhase δ * scratch_complexPhase ε *
          (ModelFullForm α u (scratch_complexCoefficientComponent δ c)
            (scratch_complexComponent ε F) : ℂ) := by
          apply Finset.sum_congr rfl
          intro δ _
          apply Finset.sum_congr rfl
          intro ε _
          dsimp only [term, ν]
          exact scratch_integral_LiteralModelFullForm_expansionTerm_eq
            α u c F δ ε
    _ = scratch_ModelFullFormComplexCoefficientComplexified α u c F := by
          unfold scratch_ModelFullFormComplexCoefficientComplexified
            scratch_ModelFullFormComplexified scratch_fourLinearComplexification
          apply Finset.sum_congr rfl
          intro δ _
          rw [Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro ε _
          ring

/-- The strict initial range for the actual literal complex model form is
uniform in the translation, measurable complex unit coefficient, and complex
Schwartz four-tuple. -/
theorem scratch_exists_uniform_LiteralModelFullForm_bound_weight100
    (α : Anisotropy) (q : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (c : ℝ → ℂ)
      (F : ScratchModelComplexSchwartzInput),
      Measurable c → (∀ t : ℝ, ‖c t‖ ≤ 1) →
      ‖scratch_LiteralModelFullForm α u c F‖ ≤
        32 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
          lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (q j)) volume := by
  rcases scratch_exists_uniform_ModelFullFormComplexCoefficientComplexified_bound_weight100
    α q hq hsum hqs with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u c F hcmeas hc
  rw [scratch_LiteralModelFullForm_eq_complexCoefficientComplexified
    α u c F hcmeas hc]
  exact hbound u c F hcmeas hc

end LiteralComplexInternal

/-! ## Section 7 literal complex model bridge -/

/-- Complex Schwartz four-tuples for the literal complex model form. -/
abbrev ModelComplexSchwartzInput :=
  LiteralComplexInternal.ScratchModelComplexSchwartzInput

/-- The literal complex coordinate convolution in the source convention. -/
noncomputable def LiteralModelCoordinateConvolution
    (i : Fin 3) (f : E3 → ℂ) (k : ℝ → ℝ) (s : ℝ) (x : E3) : ℂ :=
  LiteralComplexInternal.scratch_LiteralModelCoordinateConvolution i f k s x

/-- The literal complex source spatial integrand. -/
noncomputable def LiteralModelSpatialIntegrand
    (α : Anisotropy) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (x : E3) : ℂ :=
  LiteralComplexInternal.scratch_LiteralModelSpatialIntegrand α u F t x

/-- The actual complex model form with the source convolution and both
integrations retained literally. -/
noncomputable def LiteralModelFullForm
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (F : ModelComplexSchwartzInput) : ℂ :=
  LiteralComplexInternal.scratch_LiteralModelFullForm α u c F

/-- The algebraic `2^5` real/imaginary expansion of the real source model
form, for a complex coefficient and four complex inputs. -/
noncomputable def ModelFullFormComplexCoefficientComplexified
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (F : ModelComplexSchwartzInput) : ℂ :=
  LiteralComplexInternal.scratch_ModelFullFormComplexCoefficientComplexified α u c F

/-- The literal complex model form agrees with its exact thirty-two-term
real/imaginary expansion under the source coefficient hypotheses. -/
theorem LiteralModelFullForm_eq_complexCoefficientComplexified
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (F : ModelComplexSchwartzInput)
    (hcmeas : Measurable c) (hc : ∀ t : ℝ, ‖c t‖ ≤ 1) :
    LiteralModelFullForm α u c F =
      ModelFullFormComplexCoefficientComplexified α u c F := by
  simpa only [LiteralModelFullForm,
    ModelFullFormComplexCoefficientComplexified] using
    LiteralComplexInternal.scratch_LiteralModelFullForm_eq_complexCoefficientComplexified
      α u c F hcmeas hc

/-- The strict initial range for the actual literal complex model form,
uniform in translations, complex unit coefficients, and complex Schwartz
four-tuples. -/
theorem exists_uniform_LiteralModelFullForm_bound_weight100
    (α : Anisotropy) (q : Fin 4 → ℝ)
    (hq : ∀ j, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j, sourceStoppingExponent j < q j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (c : ℝ → ℂ)
      (F : ModelComplexSchwartzInput),
      Measurable c → (∀ t : ℝ, ‖c t‖ ≤ 1) →
      ‖LiteralModelFullForm α u c F‖ ≤
        32 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
          lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (q j)) volume := by
  simpa only [LiteralModelFullForm] using
    LiteralComplexInternal.scratch_exists_uniform_LiteralModelFullForm_bound_weight100
      α q hq hsum hqs

namespace LiteralComplexActiveInternal

/-- Pull a complex function back along the inverse coordinate relabeling. -/
noncomputable def scratch_complexCoordinatePullback
    (σ : Equiv.Perm (Fin 3)) (f : E3 → ℂ) : E3 → ℂ :=
  fun x ↦ f ((coordinatePermutation σ).symm x)

@[simp] theorem scratch_complexCoordinatePullback_apply
    (σ : Equiv.Perm (Fin 3)) (f : E3 → ℂ) (x : E3) :
    scratch_complexCoordinatePullback σ f x =
      f ((coordinatePermutation σ).symm x) := rfl

/-- Simultaneously relabel the three spatial coordinates and the four complex
source inputs, retaining Schwartz regularity. -/
noncomputable def scratch_complexPermutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelComplexSchwartzInput) :
    ModelComplexSchwartzInput :=
  fun j ↦ (SchwartzMap.compCLMOfContinuousLinearEquiv ℂ
    (coordinatePermutation σ).symm.toContinuousLinearEquiv)
      (F (modelInputIndex σ j))

@[simp] theorem scratch_complexPermutedModelInput_apply
    (σ : Equiv.Perm (Fin 3)) (F : ModelComplexSchwartzInput)
    (j : Fin 4) (x : E3) :
    scratch_complexPermutedModelInput σ F j x =
      F (modelInputIndex σ j) ((coordinatePermutation σ).symm x) := by
  simp [scratch_complexPermutedModelInput,
    SchwartzMap.compCLMOfContinuousLinearEquiv_apply]

/-- The literal complex coordinate convolution commutes with the same
coordinate relabeling as the real model convolution. -/
theorem scratch_LiteralModelCoordinateConvolution_coordinatePermutation
    (σ : Equiv.Perm (Fin 3)) (j : Fin 3)
    (f : E3 → ℂ) (k : ℝ → ℝ) (s : ℝ) (x : E3) :
    LiteralModelCoordinateConvolution j
      (scratch_complexCoordinatePullback σ f) k s
      (coordinatePermutation σ x) =
      LiteralModelCoordinateConvolution (σ j) f k s x := by
  unfold LiteralModelCoordinateConvolution
    LiteralComplexInternal.scratch_LiteralModelCoordinateConvolution
  apply integral_congr_ae
  filter_upwards [] with r
  rw [scratch_complexCoordinatePullback_apply,
    coordinatePermutation_symm_sub_smul_coordinateDirection]

/-- The complex source tuple in a convolved slot is the appropriate complex
coordinate pullback of the source input. -/
theorem scratch_complexPermutedModelInput_succ_asFun
    (σ : Equiv.Perm (Fin 3)) (F : ModelComplexSchwartzInput) (j : Fin 3) :
    (scratch_complexPermutedModelInput σ F j.succ : E3 → ℂ) =
      scratch_complexCoordinatePullback σ (F (σ j).succ : E3 → ℂ) := by
  funext x
  simp [scratch_complexCoordinatePullback]

/-- The distinguished outer complex input is unchanged after evaluating the
relabeled tuple at the correspondingly relabeled spatial point. -/
theorem scratch_complexPermutedModelInput_zero_coordinatePermutation
    (σ : Equiv.Perm (Fin 3)) (F : ModelComplexSchwartzInput) (x : E3) :
    scratch_complexPermutedModelInput σ F 0 (coordinatePermutation σ x) =
      F 0 x := by
  rw [scratch_complexPermutedModelInput_apply]
  simp only [Fin.isValue, modelInputIndex_zero, LinearIsometryEquiv.symm_apply_apply]

/-- The literal complex active-coordinate spatial integrand, retaining all
three source coordinate convolutions. -/
noncomputable def scratch_LiteralActiveModelSpatialIntegrand
    (α : Anisotropy) (i : Fin 3) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (x : E3) : ℂ :=
  F 0 x * ∏ j : Fin 3,
    LiteralModelCoordinateConvolution j (F j.succ)
      (activeModelKernel i j u) (t ^ α.weight j) x

/-- The literal complex active-coordinate spatial profile. -/
noncomputable def scratch_LiteralActiveModelSpatialProfile
    (α : Anisotropy) (i : Fin 3) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) : ℂ :=
  ∫ x : E3, scratch_LiteralActiveModelSpatialIntegrand α i u F t x

/-- The literal complex active-coordinate full form. -/
noncomputable def scratch_LiteralActiveModelFullForm
    (α : Anisotropy) (i : Fin 3) (u : E3) (c : ℝ → ℂ)
    (F : ModelComplexSchwartzInput) : ℂ :=
  ∫ t in Set.Ioi (0 : ℝ), c t *
    scratch_LiteralActiveModelSpatialProfile α i u F t
      ∂((volume : Measure ℝ).withDensity cubeScaleDensity)

/-- At active coordinate three, the literal complex active spatial integrand
is exactly the canonical literal complex spatial integrand. -/
theorem scratch_LiteralActiveModelSpatialIntegrand_two
    (α : Anisotropy) (u : E3) (F : ModelComplexSchwartzInput)
    (t : ℝ) (x : E3) :
    scratch_LiteralActiveModelSpatialIntegrand α 2 u F t x =
      LiteralModelSpatialIntegrand α u F t x := by
  unfold scratch_LiteralActiveModelSpatialIntegrand
    LiteralModelSpatialIntegrand
    LiteralModelCoordinateConvolution
    LiteralComplexInternal.scratch_LiteralModelSpatialIntegrand
  simp only [Fin.prod_univ_succ]
  simp [activeModelKernel]
  ring

/-- At active coordinate three, the literal complex active full form is the
canonical literal complex full form. -/
theorem scratch_LiteralActiveModelFullForm_two
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (F : ModelComplexSchwartzInput) :
    scratch_LiteralActiveModelFullForm α 2 u c F =
      LiteralModelFullForm α u c F := by
  unfold scratch_LiteralActiveModelFullForm LiteralModelFullForm
    scratch_LiteralActiveModelSpatialProfile
    LiteralComplexInternal.scratch_LiteralModelFullForm
    LiteralComplexInternal.scratch_LiteralModelSpatialProfile
  apply integral_congr_ae
  filter_upwards [] with t
  congr 1
  apply integral_congr_ae
  filter_upwards [] with x
  exact scratch_LiteralActiveModelSpatialIntegrand_two α u F t x

/-- One complex convolved factor of the active-third model after relabeling
is the factor in the corresponding original active coordinate. -/
theorem scratch_LiteralActiveModelCoordinateFactor_permute_to_two
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (F : ModelComplexSchwartzInput) (hσ : σ 2 = i)
    (t : ℝ) (x : E3) (j : Fin 3) :
    LiteralModelCoordinateConvolution j
        (scratch_complexPermutedModelInput σ F j.succ)
        (activeModelKernel 2 j (coordinatePermutation σ u))
        (t ^ (permutedAnisotropy α σ).weight j)
        (coordinatePermutation σ x) =
      LiteralModelCoordinateConvolution (σ j) (F (σ j).succ)
        (activeModelKernel i (σ j) u)
        (t ^ α.weight (σ j)) x := by
  rw [scratch_complexPermutedModelInput_succ_asFun,
    activeModelKernel_coordinatePermutation σ i u hσ j,
    permutedAnisotropy_weight]
  exact scratch_LiteralModelCoordinateConvolution_coordinatePermutation σ j
    (F (σ j).succ) (activeModelKernel i (σ j) u)
    (t ^ α.weight (σ j)) x

/-- The arbitrary-active-coordinate literal complex spatial integrand becomes
the active-third literal complex integrand after all spatial/input labels are
permuted. -/
theorem scratch_LiteralActiveModelSpatialIntegrand_permute_to_two
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (F : ModelComplexSchwartzInput) (hσ : σ 2 = i)
    (t : ℝ) (x : E3) :
    scratch_LiteralActiveModelSpatialIntegrand α i u F t x =
      scratch_LiteralActiveModelSpatialIntegrand (permutedAnisotropy α σ) 2
        (coordinatePermutation σ u) (scratch_complexPermutedModelInput σ F)
        t (coordinatePermutation σ x) := by
  unfold scratch_LiteralActiveModelSpatialIntegrand
  rw [scratch_complexPermutedModelInput_zero_coordinatePermutation]
  have hprod :
      (∏ j : Fin 3,
        LiteralModelCoordinateConvolution j
          (scratch_complexPermutedModelInput σ F j.succ)
          (activeModelKernel 2 j (coordinatePermutation σ u))
          (t ^ (permutedAnisotropy α σ).weight j)
          (coordinatePermutation σ x)) =
        ∏ k : Fin 3,
          LiteralModelCoordinateConvolution k (F k.succ)
            (activeModelKernel i k u) (t ^ α.weight k) x := by
    calc
      (∏ j : Fin 3,
        LiteralModelCoordinateConvolution j
          (scratch_complexPermutedModelInput σ F j.succ)
          (activeModelKernel 2 j (coordinatePermutation σ u))
          (t ^ (permutedAnisotropy α σ).weight j)
          (coordinatePermutation σ x)) =
          ∏ j : Fin 3,
            LiteralModelCoordinateConvolution (σ j) (F (σ j).succ)
              (activeModelKernel i (σ j) u) (t ^ α.weight (σ j)) x := by
            apply Finset.prod_congr rfl
            intro j _
            exact scratch_LiteralActiveModelCoordinateFactor_permute_to_two
              α σ i u F hσ t x j
      _ = ∏ k : Fin 3,
          LiteralModelCoordinateConvolution k (F k.succ)
            (activeModelKernel i k u) (t ^ α.weight k) x := by
          simpa using (Equiv.prod_comp σ (fun k : Fin 3 ↦
            LiteralModelCoordinateConvolution k (F k.succ)
              (activeModelKernel i k u) (t ^ α.weight k) x))
  rw [hprod]

/-- The spatial integral in an arbitrary active coordinate transports to the
active-third literal complex spatial profile. -/
theorem scratch_LiteralActiveModelSpatialProfile_permute_to_two
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (F : ModelComplexSchwartzInput) (hσ : σ 2 = i)
    (t : ℝ) :
    scratch_LiteralActiveModelSpatialProfile α i u F t =
      scratch_LiteralActiveModelSpatialProfile (permutedAnisotropy α σ) 2
        (coordinatePermutation σ u) (scratch_complexPermutedModelInput σ F)
        t := by
  unfold scratch_LiteralActiveModelSpatialProfile
  calc
    (∫ x : E3, scratch_LiteralActiveModelSpatialIntegrand α i u F t x) =
        ∫ x : E3,
          scratch_LiteralActiveModelSpatialIntegrand (permutedAnisotropy α σ) 2
            (coordinatePermutation σ u) (scratch_complexPermutedModelInput σ F)
            t (coordinatePermutation σ x) := by
          apply integral_congr_ae
          filter_upwards [] with x
          exact scratch_LiteralActiveModelSpatialIntegrand_permute_to_two
            α σ i u F hσ t x
    _ = ∫ y : E3,
        scratch_LiteralActiveModelSpatialIntegrand (permutedAnisotropy α σ) 2
          (coordinatePermutation σ u) (scratch_complexPermutedModelInput σ F)
          t y := by
        have hmp : MeasurePreserving (coordinatePermutation σ).toMeasurableEquiv
            volume volume := by
          simpa using coordinatePermutation_measurePreserving σ
        simpa using hmp.integral_comp'
          (scratch_LiteralActiveModelSpatialIntegrand
            (permutedAnisotropy α σ) 2 (coordinatePermutation σ u)
            (scratch_complexPermutedModelInput σ F) t)

/-- The full literal complex active-coordinate form transports exactly to the
canonical literal complex model when the permutation sends coordinate three to
the active coordinate. -/
theorem scratch_LiteralActiveModelFullForm_permute_to_third
    (α : Anisotropy) (σ : Equiv.Perm (Fin 3)) (i : Fin 3)
    (u : E3) (c : ℝ → ℂ) (F : ModelComplexSchwartzInput)
    (hσ : σ 2 = i) :
    scratch_LiteralActiveModelFullForm α i u c F =
      LiteralModelFullForm (permutedAnisotropy α σ)
        (coordinatePermutation σ u) c (scratch_complexPermutedModelInput σ F) := by
  rw [← scratch_LiteralActiveModelFullForm_two
    (permutedAnisotropy α σ) (coordinatePermutation σ u) c
    (scratch_complexPermutedModelInput σ F)]
  unfold scratch_LiteralActiveModelFullForm
  apply integral_congr_ae
  filter_upwards [] with t
  congr 1
  exact scratch_LiteralActiveModelSpatialProfile_permute_to_two
    α σ i u F hσ t

/-- Complex `L^p` norms are preserved componentwise by the coordinate/input
permutation used to transport the active model. -/
theorem scratch_lpNorm_complexPermutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelComplexSchwartzInput)
    (j : Fin 4) (p : ℝ≥0∞) :
    lpNorm (scratch_complexPermutedModelInput σ F j : E3 → ℂ) p volume =
      lpNorm (F (modelInputIndex σ j) : E3 → ℂ) p volume := by
  have hfun : (scratch_complexPermutedModelInput σ F j : E3 → ℂ) =
      (F (modelInputIndex σ j) : E3 → ℂ) ∘ (coordinatePermutation σ).symm := by
    funext x
    exact scratch_complexPermutedModelInput_apply σ F j x
  rw [← toReal_eLpNorm
    ,
    ← toReal_eLpNorm
      ,
    hfun,
    eLpNorm_comp_measurePreserving
      (F (modelInputIndex σ j)).continuous.aestronglyMeasurable
      (coordinatePermutation_symm_measurePreserving σ)]

/-- The product of the four complex input norms is invariant under the full
coordinate/input relabeling. -/
theorem scratch_prod_lpNorm_complexPermutedModelInput
    (σ : Equiv.Perm (Fin 3)) (F : ModelComplexSchwartzInput)
    (q : Fin 4 → ℝ) :
    (∏ j : Fin 4,
      lpNorm (scratch_complexPermutedModelInput σ F j : E3 → ℂ)
        (ENNReal.ofReal (permutedModelExponent σ q j)) volume) =
      ∏ j : Fin 4,
        lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (q j)) volume := by
  let G : Fin 4 → ℝ := fun j ↦
    lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (q j)) volume
  calc
    (∏ j : Fin 4,
      lpNorm (scratch_complexPermutedModelInput σ F j : E3 → ℂ)
        (ENNReal.ofReal (permutedModelExponent σ q j)) volume) =
        ∏ j : Fin 4, G (modelInputIndex σ j) := by
          apply Finset.prod_congr rfl
          intro j _
          simpa only [G, permutedModelExponent_apply] using
            scratch_lpNorm_complexPermutedModelInput σ F j
              (ENNReal.ofReal (q (modelInputIndex σ j)))
    _ = ∏ j : Fin 4, G j := prod_modelInputIndex σ G

/-- The strict literal complex model bound holds uniformly at every active
coordinate. The constant is chosen before translation, complex unit
coefficient, and complex Schwartz input. -/
theorem scratch_exists_uniform_LiteralActiveModelFullForm_bound_weight100
    (α : Anisotropy) (i : Fin 3) (q : Fin 4 → ℝ)
    (hq : ∀ j : Fin 4, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j : Fin 4, activeSourceStoppingExponent i j < q j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (c : ℝ → ℂ)
      (F : ModelComplexSchwartzInput),
      Measurable c → (∀ t : ℝ, ‖c t‖ ≤ 1) →
      ‖scratch_LiteralActiveModelFullForm α i u c F‖ ≤
        32 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
          lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (q j)) volume := by
  rcases exists_coordinatePermutation_to_active i with ⟨σ, hσ⟩
  let q' : Fin 4 → ℝ := permutedModelExponent σ q
  have hq' : ∀ j : Fin 4, 0 < q' j := by
    simpa only [q'] using permutedModelExponent_pos σ q hq
  have hsum' : ∑ j : Fin 4, (q' j)⁻¹ = 1 := by
    calc
      (∑ j : Fin 4, (q' j)⁻¹) = ∑ j : Fin 4, (q j)⁻¹ := by
        simpa only [q'] using sum_inv_permutedModelExponent σ q
      _ = 1 := hsum
  have hqs' : ∀ j : Fin 4, sourceStoppingExponent j < q' j := by
    simpa only [q'] using
      permutedModelExponent_stoppingThreshold σ i q hσ hqs
  rcases exists_uniform_LiteralModelFullForm_bound_weight100
    (permutedAnisotropy α σ) q' hq' hsum' hqs' with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u c F hcmeas hc
  rw [scratch_LiteralActiveModelFullForm_permute_to_third α σ i u c F hσ]
  have hbound' := hbound (coordinatePermutation σ u) c
    (scratch_complexPermutedModelInput σ F) hcmeas hc
  rw [sourceWeight_coordinatePermutation σ u,
    scratch_prod_lpNorm_complexPermutedModelInput σ F q] at hbound'
  simpa only [q'] using hbound'

end LiteralComplexActiveInternal

/-- Pull a complex function back along the inverse coordinate relabeling used
by the active-coordinate model transport. -/
noncomputable def complexCoordinatePullback
    (σ : Equiv.Perm (Fin 3)) (f : E3 → ℂ) : E3 → ℂ :=
  LiteralComplexActiveInternal.scratch_complexCoordinatePullback σ f

@[simp] theorem complexCoordinatePullback_apply
    (σ : Equiv.Perm (Fin 3)) (f : E3 → ℂ) (x : E3) :
    complexCoordinatePullback σ f x =
      f ((coordinatePermutation σ).symm x) := by
  rfl

/-- The literal complex full model form with an arbitrary active annular
coordinate. -/
noncomputable def LiteralActiveModelFullForm
    (α : Anisotropy) (i : Fin 3) (u : E3) (c : ℝ → ℂ)
    (F : ModelComplexSchwartzInput) : ℂ :=
  LiteralComplexActiveInternal.scratch_LiteralActiveModelFullForm α i u c F

/-- At active coordinate three, the active literal complex full form is the
canonical literal complex full form. -/
theorem LiteralActiveModelFullForm_two
    (α : Anisotropy) (u : E3) (c : ℝ → ℂ)
    (F : ModelComplexSchwartzInput) :
    LiteralActiveModelFullForm α 2 u c F =
      LiteralModelFullForm α u c F := by
  simpa only [LiteralActiveModelFullForm] using
    LiteralComplexActiveInternal.scratch_LiteralActiveModelFullForm_two α u c F

/-- The strict literal complex model bound holds uniformly for every active
coordinate, complex unit coefficient, and complex Schwartz four-tuple. -/
theorem exists_uniform_LiteralActiveModelFullForm_bound_weight100
    (α : Anisotropy) (i : Fin 3) (q : Fin 4 → ℝ)
    (hq : ∀ j : Fin 4, 0 < q j)
    (hsum : ∑ j : Fin 4, (q j)⁻¹ = 1)
    (hqs : ∀ j : Fin 4, activeSourceStoppingExponent i j < q j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (c : ℝ → ℂ)
      (F : ModelComplexSchwartzInput),
      Measurable c → (∀ t : ℝ, ‖c t‖ ≤ 1) →
      ‖LiteralActiveModelFullForm α i u c F‖ ≤
        32 * C * sourceWeight u ^ 100 * ∏ j : Fin 4,
          lpNorm (F j : E3 → ℂ) (ENNReal.ofReal (q j)) volume := by
  simpa only [LiteralActiveModelFullForm] using
    LiteralComplexActiveInternal.scratch_exists_uniform_LiteralActiveModelFullForm_bound_weight100
      α i q hq hsum hqs

/-- The literal active kernel family obeys the source's order-ten translated
bracket bound, uniformly in the active coordinate. -/
theorem kernelDilate_activeModelKernel_sourceWeight_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i j : Fin 3) (u : E3) (s y : ℝ), 0 < s →
      |kernelDilate (activeModelKernel i j u) s y| ≤
        C * sourceWeight u ^ 10 * bracketKernelAt s 0 y := by
  rcases kernelDilate_ModelLowKernel_sourceWeight_bracket_majorant with
    ⟨Clow, hClow, hlow⟩
  rcases kernelDilate_ModelThirdKernel_sourceWeight_bracket_majorant with
    ⟨Cthird, hCthird, hthird⟩
  refine ⟨max Clow Cthird, le_trans hClow (le_max_left _ _), ?_⟩
  intro i j u s y hs
  have hfactor : 0 ≤ sourceWeight u ^ 10 * bracketKernelAt s 0 y := by
    exact mul_nonneg (pow_nonneg (sourceWeight_nonneg u) _)
      (bracketKernelAt_pos hs).le
  by_cases hji : j = i
  · subst j
    simp only [activeModelKernel]
    calc
      |kernelDilate (ModelThirdKernel (u i)) s y| ≤
          Cthird * sourceWeight u ^ 10 * bracketKernelAt s 0 y :=
        hthird u i s y hs
      _ = Cthird * (sourceWeight u ^ 10 * bracketKernelAt s 0 y) := by ring
      _ ≤ max Clow Cthird * (sourceWeight u ^ 10 * bracketKernelAt s 0 y) :=
        mul_le_mul_of_nonneg_right (le_max_right _ _) hfactor
      _ = max Clow Cthird * sourceWeight u ^ 10 * bracketKernelAt s 0 y := by ring
  · simp only [activeModelKernel, ite_eq_right hji]
    calc
      |kernelDilate (ModelLowKernel (u j)) s y| ≤
          Clow * sourceWeight u ^ 10 * bracketKernelAt s 0 y :=
        hlow u j s y hs
      _ = Clow * (sourceWeight u ^ 10 * bracketKernelAt s 0 y) := by ring
      _ ≤ max Clow Cthird * (sourceWeight u ^ 10 * bracketKernelAt s 0 y) :=
        mul_le_mul_of_nonneg_right (le_max_left _ _) hfactor
      _ = max Clow Cthird * sourceWeight u ^ 10 * bracketKernelAt s 0 y := by ring

/-- Moving only the active coordinate by a scalar displacement preserves the
literal transverse face. -/
theorem faceInsert_sub_coordinateDirection
    (i : Fin 3) (a r : ℝ) (z : TransverseSpace i) :
    faceInsert i a z - r • Anisotropy.coordinateDirection i =
      faceInsert i (a - r) z := by
  ext k
  by_cases hki : k = i
  · subst k
    simp [faceInsert, coordinateDirection_apply]
  · simp [faceInsert, coordinateDirection_apply, hki]

/-- Evenness converts the displacement form of the bracket kernel into its
sampled-coordinate form on a coordinate fiber. -/
theorem bracketKernelAt_displacement_eq_sampled
    (s a r : ℝ) :
    bracketKernelAt s 0 r = bracketKernelAt s a (a - r) := by
  simp only [bracketKernelAt, kernelAt, kernelDilate, smul_eq_mul, sub_zero]
  rw [show (a - r - a) / s = -(r / s) by ring, bracketKernel_even]

/-- The positive displacement bracket integral is exactly the literal
coordinate bracket convolution. -/
theorem displacementBracket_eq_coordinateBracketConvolution
    (i : Fin 3) (f : E3 → ℂ) (s : ℝ) (x : E3) :
    (∫ r : ℝ, ‖f (x - r • Anisotropy.coordinateDirection i)‖ *
      bracketKernelAt s 0 r) = coordinateBracketConvolution i f s x := by
  let a : ℝ := x i
  let z : TransverseSpace i := (coordinateSplit i x).2
  have hx : x = faceInsert i a z := by
    change x = faceInsert i (coordinateSplit i x).1 (coordinateSplit i x).2
    exact (coordinateJoin_split i x).symm
  let F : ℝ → ℝ := fun y ↦ ‖f (faceInsert i y z)‖ * bracketKernelAt s a y
  calc
    (∫ r : ℝ, ‖f (x - r • Anisotropy.coordinateDirection i)‖ *
        bracketKernelAt s 0 r) = ∫ r : ℝ, F (a - r) := by
      apply integral_congr_ae
      filter_upwards [] with r
      dsimp only [F]
      rw [hx, faceInsert_sub_coordinateDirection,
        bracketKernelAt_displacement_eq_sampled]
    _ = ∫ y : ℝ, F y := integral_sub_left_eq_self F volume a
    _ = coordinateBracketConvolution i f s x := by
      unfold coordinateBracketConvolution
      rfl

/-- A pointwise bracket majorant for a real kernel transfers directly to its
literal coordinate convolution against a bounded continuous input. -/
theorem abs_ModelCoordinateConvolution_le_displacementBracket
    (i : Fin 3) (f : E3 → ℝ) (k : ℝ → ℝ) (s : ℝ) (x : E3)
    (hfcont : Continuous f) (B : ℝ) (hfB : ∀ y : E3, |f y| ≤ B)
    (hk : Integrable k) (hs : 0 < s) (C : ℝ) (hC : 0 ≤ C)
    (hmajor : ∀ r : ℝ, |kernelDilate k s r| ≤ C * bracketKernelAt s 0 r) :
    |ModelCoordinateConvolution i f k s x| ≤ C *
      ∫ r : ℝ, |f (x - r • Anisotropy.coordinateDirection i)| *
        bracketKernelAt s 0 r := by
  let h : ℝ → E3 := fun r ↦ x - r • Anisotropy.coordinateDirection i
  let G : ℝ → ℝ := fun r ↦ f (h r) * kernelDilate k s r
  let H : ℝ → ℝ := fun r ↦
    C * (|f (h r)| * bracketKernelAt s 0 r)
  have hmap : Continuous h :=
    continuous_const.sub (continuous_id.smul continuous_const)
  have hB : 0 ≤ B := le_trans (abs_nonneg (f x)) (hfB x)
  have hkd : Integrable (kernelDilate k s) := by
    unfold kernelDilate
    exact (hk.comp_div hs.ne').smul (s⁻¹ : ℝ)
  have hGmeas : AEStronglyMeasurable G volume :=
    ((hfcont.comp hmap).aestronglyMeasurable.mul hkd.aestronglyMeasurable)
  have hK : Integrable (fun r : ℝ ↦ |kernelDilate k s r|) :=
    integrable_abs_kernelDilate k hk hs
  have hupperG : Integrable (fun r : ℝ ↦ B * |kernelDilate k s r|) :=
    hK.const_mul B
  have hG : Integrable G := by
    apply Integrable.mono' hupperG hGmeas
    filter_upwards [] with r
    dsimp only [G]
    rw [Real.norm_eq_abs, abs_mul]
    exact mul_le_mul_of_nonneg_right (hfB _) (abs_nonneg _)
  have hbracket : Integrable (bracketKernelAt s 0) :=
    integrable_bracketKernelAt hs 0
  have hHmeas : AEStronglyMeasurable H volume :=
    ((((hfcont.comp hmap).abs).aestronglyMeasurable.mul
      hbracket.aestronglyMeasurable).const_mul C)
  have hupperH : Integrable (fun r : ℝ ↦
      (C * B) * bracketKernelAt s 0 r) :=
    hbracket.const_mul (C * B)
  have hH : Integrable H := by
    apply Integrable.mono' hupperH hHmeas
    filter_upwards [] with r
    dsimp only [H]
    rw [Real.norm_eq_abs]
    rw [abs_of_nonneg]
    · calc
        C * (|f (h r)| * bracketKernelAt s 0 r) =
            (C * |f (h r)|) * bracketKernelAt s 0 r := by ring
        _ ≤ (C * B) * bracketKernelAt s 0 r :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left (hfB _) hC)
            (bracketKernelAt_pos hs).le
    · exact mul_nonneg hC
        (mul_nonneg (abs_nonneg _) (bracketKernelAt_pos hs).le)
  unfold ModelCoordinateConvolution
  change |∫ r : ℝ, G r| ≤ C * ∫ r : ℝ,
    |f (h r)| * bracketKernelAt s 0 r
  calc
    |∫ r : ℝ, G r| ≤ ∫ r : ℝ, |G r| :=
      MeasureTheory.abs_integral_le_integral_abs
    _ ≤ ∫ r : ℝ, H r := by
      apply integral_mono hG.norm hH
      intro r
      dsimp only [G, H]
      rw [Real.norm_eq_abs, abs_mul]
      calc
        |f (h r)| * |kernelDilate k s r| ≤
            |f (h r)| * (C * bracketKernelAt s 0 r) :=
          mul_le_mul_of_nonneg_left (hmajor r) (abs_nonneg _)
        _ = C * (|f (h r)| * bracketKernelAt s 0 r) := by ring
    _ = C * ∫ r : ℝ, |f (h r)| * bracketKernelAt s 0 r := by
      rw [integral_const_mul]

/-- The preceding domination in the source's sampled-coordinate convention. -/
theorem abs_ModelCoordinateConvolution_le_coordinateBracketConvolution
    (i : Fin 3) (f : E3 → ℝ) (k : ℝ → ℝ) (s : ℝ) (x : E3)
    (hfcont : Continuous f) (B : ℝ) (hfB : ∀ y : E3, |f y| ≤ B)
    (hk : Integrable k) (hs : 0 < s) (C : ℝ) (hC : 0 ≤ C)
    (hmajor : ∀ r : ℝ, |kernelDilate k s r| ≤ C * bracketKernelAt s 0 r) :
    |ModelCoordinateConvolution i f k s x| ≤ C *
      coordinateBracketConvolution i (fun y ↦ (f y : ℂ)) s x := by
  calc
    |ModelCoordinateConvolution i f k s x| ≤ C *
        ∫ r : ℝ, |f (x - r • Anisotropy.coordinateDirection i)| *
          bracketKernelAt s 0 r :=
      abs_ModelCoordinateConvolution_le_displacementBracket
        i f k s x hfcont B hfB hk hs C hC hmajor
    _ = C * coordinateBracketConvolution i (fun y ↦ (f y : ℂ)) s x := by
      rw [← displacementBracket_eq_coordinateBracketConvolution
        i (fun y ↦ (f y : ℂ)) s x]
      simp only [Complex.norm_real, Real.norm_eq_abs]

/-- Every active coordinate kernel is integrable, whether it is a low or the
single annular model kernel. -/
theorem integrable_activeModelKernel
    (i j : Fin 3) (u : E3) :
    Integrable (activeModelKernel i j u) := by
  unfold activeModelKernel
  split_ifs with hji
  · exact integrable_ModelThirdKernel (u j)
  · exact integrable_ModelLowKernel (u j)

/-- The literal active model convolution is dominated by the positive
coordinate bracket convolution with the source translation weight. -/
theorem abs_activeModelCoordinateConvolution_le_coordinateBracketConvolution :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i j : Fin 3) (u : E3) (s : ℝ) (x : E3)
      (f : E3 → ℝ) (B : ℝ), 0 < s → Continuous f →
      (∀ y : E3, |f y| ≤ B) →
      |ModelCoordinateConvolution j f (activeModelKernel i j u) s x| ≤
        C * sourceWeight u ^ 10 *
          coordinateBracketConvolution j (fun y ↦ (f y : ℂ)) s x := by
  rcases kernelDilate_activeModelKernel_sourceWeight_bracket_majorant with
    ⟨C, hC, hmajor⟩
  refine ⟨C, hC, ?_⟩
  intro i j u s x f B hs hfcont hfB
  have hCW : 0 ≤ C * sourceWeight u ^ 10 :=
    mul_nonneg hC (pow_nonneg (sourceWeight_nonneg u) _)
  have hpoint : ∀ r : ℝ,
      |kernelDilate (activeModelKernel i j u) s r| ≤
        (C * sourceWeight u ^ 10) * bracketKernelAt s 0 r := by
    intro r
    calc
      |kernelDilate (activeModelKernel i j u) s r| ≤
          C * sourceWeight u ^ 10 * bracketKernelAt s 0 r :=
        hmajor i j u s r hs
      _ = (C * sourceWeight u ^ 10) * bracketKernelAt s 0 r := by ring
  calc
    |ModelCoordinateConvolution j f (activeModelKernel i j u) s x| ≤
        (C * sourceWeight u ^ 10) *
          coordinateBracketConvolution j (fun y ↦ (f y : ℂ)) s x :=
      abs_ModelCoordinateConvolution_le_coordinateBracketConvolution
        j f (activeModelKernel i j u) s x hfcont B hfB
        (integrable_activeModelKernel i j u) hs
        (C * sourceWeight u ^ 10) hCW hpoint
    _ = C * sourceWeight u ^ 10 *
          coordinateBracketConvolution j (fun y ↦ (f y : ℂ)) s x := by ring

/-- The source's coordinate maximal domination for every active model
convolution, in a form ready to feed the one-fiber weak endpoint. -/
theorem abs_activeModelCoordinateConvolution_le_dyadic :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i j : Fin 3) (u : E3) (s : ℝ) (x : E3)
      (f : E3 → ℝ) (B : ℝ), 0 < s → Continuous f →
      (∀ y : E3, |f y| ≤ B) →
      |ModelCoordinateConvolution j f (activeModelKernel i j u) s x| ≤
        C * sourceWeight u ^ 10 *
          coordinateDyadicBallMaximal j (fun y ↦ (f y : ℂ)) x := by
  rcases abs_activeModelCoordinateConvolution_le_coordinateBracketConvolution with
    ⟨C, hC, hconv⟩
  refine ⟨C * dyadicBracketShellConstant,
    mul_nonneg hC dyadicBracketShellConstant_nonneg, ?_⟩
  intro i j u s x f B hs hfcont hfB
  have hB : 0 ≤ B := le_trans (abs_nonneg (f x)) (hfB x)
  have hfmeas : Measurable (fun y : E3 ↦ (f y : ℂ)) :=
    (Complex.continuous_ofReal.comp hfcont).measurable
  have hfbound : ∀ y : E3, ‖(f y : ℂ)‖ ≤ B := by
    intro y
    rw [Complex.norm_real, Real.norm_eq_abs]
    exact hfB y
  have hfactor : 0 ≤ C * sourceWeight u ^ 10 :=
    mul_nonneg hC (pow_nonneg (sourceWeight_nonneg u) _)
  calc
    |ModelCoordinateConvolution j f (activeModelKernel i j u) s x| ≤
        C * sourceWeight u ^ 10 *
          coordinateBracketConvolution j (fun y ↦ (f y : ℂ)) s x :=
      hconv i j u s x f B hs hfcont hfB
    _ ≤ C * sourceWeight u ^ 10 *
          (dyadicBracketShellConstant *
            coordinateDyadicBallMaximal j (fun y ↦ (f y : ℂ)) x) := by
      exact mul_le_mul_of_nonneg_left
        (coordinateBracketConvolution_le_shell_dyadic
          j (fun y ↦ (f y : ℂ)) hfmeas B hB hfbound s x hs)
        hfactor
    _ = (C * dyadicBracketShellConstant) * sourceWeight u ^ 10 *
          coordinateDyadicBallMaximal j (fun y ↦ (f y : ℂ)) x := by ring

/-- A one-dimensional noncompact differentiation-under-convolution lemma.
The globally bounded kernel and derivative give the integrable majorants
needed for the parametric-integral theorem. -/
theorem hasDerivAt_convolution_right_of_bound
    (f k k' : ℝ → ℝ) (hf : Integrable f)
    (hk : Continuous k) (hk' : Continuous k')
    (hderiv : ∀ x : ℝ, HasDerivAt k (k' x) x)
    (A B : ℝ) (hbound : ∀ x : ℝ, ‖k x‖ ≤ A)
    (hbound' : ∀ x : ℝ, ‖k' x‖ ≤ B) (x : ℝ) :
    HasDerivAt (fun y ↦
      (f ⋆[ContinuousLinearMap.mul ℝ ℝ] k) y)
      ((f ⋆[ContinuousLinearMap.mul ℝ ℝ] k') x) x := by
  let F : ℝ → ℝ → ℝ := fun y t ↦ f t * k (y - t)
  let F' : ℝ → ℝ → ℝ := fun y t ↦ f t * k' (y - t)
  have hmeas (y : ℝ) : AEStronglyMeasurable (F y) volume := by
    exact hf.aestronglyMeasurable.convolution_integrand_snd
      (ContinuousLinearMap.mul ℝ ℝ) hk.aestronglyMeasurable y
  have hmeas' (y : ℝ) : AEStronglyMeasurable (F' y) volume := by
    exact hf.aestronglyMeasurable.convolution_integrand_snd
      (ContinuousLinearMap.mul ℝ ℝ) hk'.aestronglyMeasurable y
  have hFint (y : ℝ) : Integrable (F y) := by
    have hupper : Integrable (fun t : ℝ ↦ ‖f t‖ * A) :=
      hf.norm.mul_const A
    apply Integrable.mono' hupper (hmeas y)
    filter_upwards [] with t
    dsimp only [F]
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (hbound _) (norm_nonneg _)
  have hmajor : Integrable (fun t : ℝ ↦ ‖f t‖ * B) :=
    hf.norm.mul_const B
  have hderiv_integrand (y t : ℝ) :
      HasDerivAt (fun q ↦ F q t) (F' y t) y := by
    dsimp only [F, F']
    convert! (hasDerivAt_const y (f t)).mul
      ((hderiv (y - t)).comp y
        ((hasDerivAt_id y).sub (hasDerivAt_const y t))) using 1 ; ring
  have h := hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := volume) (F := F) (F' := F')
    (bound := fun t : ℝ ↦ ‖f t‖ * B) (s := Set.univ) (x₀ := x)
    univ_mem
    (Filter.Eventually.of_forall hmeas) (hFint x) (hmeas' x)
    (Filter.Eventually.of_forall fun t y hy ↦ by
      dsimp only [F']
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_left (hbound' _) (norm_nonneg _))
    hmajor
    (Filter.Eventually.of_forall fun t y hy ↦ hderiv_integrand y t)
  simpa only [F, F', convolution_mul] using h.2

/-- Scalar convolution is commutative in the exact measure-theoretic
convention used by the model kernels. -/
theorem convolution_mul_comm
    (f g : ℝ → ℝ) (x : ℝ) :
    (f ⋆[ContinuousLinearMap.mul ℝ ℝ] g) x =
      (g ⋆[ContinuousLinearMap.mul ℝ ℝ] f) x := by
  rw [convolution_mul_swap, convolution_mul]
  apply integral_congr_ae
  filter_upwards [] with t
  ring

/-- The unscaled derivative of the translated low-frequency model kernel. -/
noncomputable def ModelLowKernelDeriv (u w : ℝ) : ℝ :=
  (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePhiPhysicalReal) (w - u)

/-- The Gaussian derivative is globally bounded. -/
theorem exists_bound_gaussianDeriv :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ x : ℝ, ‖gaussianDeriv x‖ ≤ B := by
  rcases gaussianDeriv_polynomial_decay 0 with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro x
  rw [Real.norm_eq_abs]
  simpa using hbound x

/-- Differentiating the low Gaussian--Schwartz convolution differentiates
the Gaussian factor. -/
theorem hasDerivAt_low_convolution (w : ℝ) :
    HasDerivAt (fun y ↦
      (gaussian ⋆[ContinuousLinearMap.mul ℝ ℝ] conePhiPhysicalReal) y)
      ((gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        conePhiPhysicalReal) w) w := by
  rcases exists_bound_gaussianDeriv with ⟨B, hB, hderivbound⟩
  have hgaussianbound : ∀ x : ℝ, ‖gaussian x‖ ≤ (1 : ℝ) := by
    intro x
    rw [Real.norm_eq_abs, abs_of_nonneg (gaussian_nonneg x)]
    exact gaussian_le_one x
  have hbase := hasDerivAt_convolution_right_of_bound
    conePhiPhysicalReal gaussian gaussianDeriv
    conePhiPhysicalReal.integrable gaussian_contDiff.continuous
    continuous_gaussianDeriv hasDerivAt_gaussian
    1 B hgaussianbound hderivbound w
  have hfun :
      (fun y ↦ (gaussian ⋆[ContinuousLinearMap.mul ℝ ℝ]
        conePhiPhysicalReal) y) =
        fun y ↦ (conePhiPhysicalReal ⋆[ContinuousLinearMap.mul ℝ ℝ]
          gaussian) y := by
    funext y
    exact convolution_mul_comm gaussian conePhiPhysicalReal y
  have hvalue :
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        conePhiPhysicalReal) w =
        (conePhiPhysicalReal ⋆[ContinuousLinearMap.mul ℝ ℝ]
          gaussianDeriv) w :=
    convolution_mul_comm gaussianDeriv conePhiPhysicalReal w
  rw [hfun, hvalue]
  exact hbase

/-- The literal low kernel is the translated low Gaussian--Schwartz
convolution. -/
theorem ModelLowKernel_eq_convolution_translate (u w : ℝ) :
    ModelLowKernel u w =
      (gaussian ⋆[ContinuousLinearMap.mul ℝ ℝ] conePhiPhysicalReal) (w - u) := by
  rw [convolution_mul]
  unfold ModelLowKernel
  apply integral_congr_ae
  filter_upwards [] with z
  congr 1
  ring

/-- The displayed low-kernel derivative is an actual spatial derivative. -/
theorem hasDerivAt_ModelLowKernel (u w : ℝ) :
    HasDerivAt (ModelLowKernel u) (ModelLowKernelDeriv u w) w := by
  have hbase := hasDerivAt_low_convolution (w - u)
  have htranslate := hbase.comp w
    ((hasDerivAt_id w).sub (hasDerivAt_const w u))
  rw [show ModelLowKernel u = fun y ↦
      (gaussian ⋆[ContinuousLinearMap.mul ℝ ℝ] conePhiPhysicalReal) (y - u) by
        funext y
        exact ModelLowKernel_eq_convolution_translate u y]
  have hcomp :
      (fun y : ℝ ↦ (gaussian ⋆[ContinuousLinearMap.mul ℝ ℝ]
        conePhiPhysicalReal) y) ∘ (id - fun _ : ℝ ↦ u) =
        fun y : ℝ ↦ (gaussian ⋆[ContinuousLinearMap.mul ℝ ℝ]
          conePhiPhysicalReal) (y - u) := by
    funext y
    simp
  rw [hcomp] at htranslate
  simpa only [sub_zero, mul_one, ModelLowKernelDeriv] using htranslate

/-- The low-kernel derivative has the same order-ten polynomial decay as the
source's fixed Schwartz kernel. -/
theorem low_deriv_convolution_polynomial_decay :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      (1 + |x|) ^ 10 *
        |(gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          conePhiPhysicalReal) x| ≤ C := by
  rcases gaussianDeriv_polynomial_decay 10 with ⟨Ch, hCh, hh⟩
  rcases conePhiPhysicalReal_decay 20 with ⟨Cphi, hCphi, hphi⟩
  have hphiweighted : Integrable (fun y : ℝ ↦
      (1 + |y|) ^ 10 * |conePhiPhysicalReal y|) :=
    integrable_weighted_abs_of_decay 10 conePhiPhysicalReal
      conePhiPhysicalReal.continuous.aestronglyMeasurable hphi
  have hconv := convolution_decay_of_weighted_bound 10
    gaussianDeriv conePhiPhysicalReal continuous_gaussianDeriv.measurable
    conePhiPhysicalReal.continuous.measurable conePhiPhysicalReal.integrable
    hphiweighted hh
  let C : ℝ := Ch * ∫ y : ℝ,
    (1 + |y|) ^ 10 * |conePhiPhysicalReal y|
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg hCh (integral_nonneg fun y ↦ by positivity)
  exact ⟨C, hC, fun x ↦ hconv x⟩

/-- The actual low-kernel derivative obeys the translated bracket majorant. -/
theorem ModelLowKernelDeriv_translate_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u w : ℝ),
      |ModelLowKernelDeriv u w| ≤
        C * translationWeight u ^ 10 * bracketKernel w := by
  rcases low_deriv_convolution_polynomial_decay with ⟨C, hC, hdecay⟩
  rcases kernelAt_translate_bracket_of_polynomial_decay
    (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] conePhiPhysicalReal)
    ⟨C, hC, hdecay⟩ with ⟨D, hD, htranslate⟩
  refine ⟨D, hD, ?_⟩
  intro u w
  simpa only [ModelLowKernelDeriv, kernelAt, kernelDilate,
    inv_one, one_smul, div_one] using htranslate u w

/-- Differentiating a mass-normalized kernel dilation contributes precisely
one additional inverse scale. -/
theorem hasDerivAt_kernelDilate_of_hasDerivAt
    (k k' : ℝ → ℝ) (s y : ℝ) (_hs : s ≠ 0)
    (hderiv : HasDerivAt k (k' (y / s)) (y / s)) :
    HasDerivAt (kernelDilate k s)
      (s⁻¹ * kernelDilate k' s y) y := by
  unfold kernelDilate
  simp only [smul_eq_mul]
  have hinner : HasDerivAt (fun q : ℝ ↦ q / s) s⁻¹ y := by
    simpa only [div_eq_mul_inv, id_eq, one_mul] using
      (hasDerivAt_id y).mul_const s⁻¹
  have hmul := (hasDerivAt_const y s⁻¹).mul
    (hderiv.comp y hinner)
  have hfun :
      (fun _ : ℝ ↦ s⁻¹) * (k ∘ fun q : ℝ ↦ q / s) =
        fun q : ℝ ↦ s⁻¹ * k (q / s) := by
    funext q
    simp only [Pi.mul_apply, Function.comp_apply]
  rw [hfun] at hmul
  have hderivEq :
      s⁻¹ * (s⁻¹ * k' (y / s)) =
        0 * (k ∘ fun q : ℝ ↦ q / s) y +
          s⁻¹ * (k' (y / s) * s⁻¹) := by ring
  rw [hderivEq]
  exact hmul

/-- The scaled low-kernel derivative has the order-ten source-weight
bracket majorant needed for the bad-fiber cancellation argument. -/
theorem kernelDilate_ModelLowKernelDeriv_sourceWeight_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (j : Fin 3) (s y : ℝ), 0 < s →
      |kernelDilate (ModelLowKernelDeriv (u j)) s y| ≤
        C * sourceWeight u ^ 10 * bracketKernelAt s 0 y := by
  rcases ModelLowKernelDeriv_translate_bracket_majorant with
    ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u j s y hs
  have hbase := hbound (u j) (y / s)
  have hsinv : 0 ≤ s⁻¹ := (inv_pos.mpr hs).le
  have hcoordinate := translationWeight_coordinate_le_sourceWeight u j
  have hpow : translationWeight (u j) ^ 10 ≤ sourceWeight u ^ 10 :=
    pow_le_pow_left₀ (by unfold translationWeight; positivity) hcoordinate 10
  have hbracket : 0 ≤ bracketKernelAt s 0 y := (bracketKernelAt_pos hs).le
  unfold kernelDilate bracketKernelAt kernelAt kernelDilate
  simp only [sub_zero, smul_eq_mul]
  rw [abs_mul, abs_of_nonneg hsinv]
  calc
    s⁻¹ * |ModelLowKernelDeriv (u j) (y / s)| ≤
        s⁻¹ * (C * translationWeight (u j) ^ 10 *
          bracketKernel (y / s)) :=
      mul_le_mul_of_nonneg_left hbase hsinv
    _ = (C * (s⁻¹ * bracketKernel (y / s))) *
          translationWeight (u j) ^ 10 := by ring
    _ ≤ (C * (s⁻¹ * bracketKernel (y / s))) * sourceWeight u ^ 10 :=
      mul_le_mul_of_nonneg_left hpow
        (mul_nonneg hC (mul_nonneg hsinv (bracketKernel_nonneg _)))
    _ = C * sourceWeight u ^ 10 *
          (s⁻¹ * bracketKernel (y / s)) := by ring

/-- The literal scaled low kernel has an actual spatial derivative obeying
the source's inverse-scale bracket estimate. -/
theorem hasDerivAt_kernelDilate_ModelLowKernel
    (u : E3) (j : Fin 3) (s y : ℝ) (hs : 0 < s) :
    HasDerivAt (kernelDilate (ModelLowKernel (u j)) s)
      (s⁻¹ * kernelDilate (ModelLowKernelDeriv (u j)) s y) y := by
  exact hasDerivAt_kernelDilate_of_hasDerivAt
    (ModelLowKernel (u j)) (ModelLowKernelDeriv (u j)) s y hs.ne'
    (hasDerivAt_ModelLowKernel (u j) (y / s))

/-- The low active derivative satisfies the literal `s⁻¹`-times-bracket
bound. -/
theorem deriv_kernelDilate_ModelLowKernel_sourceWeight_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (j : Fin 3) (s y : ℝ), 0 < s →
      |s⁻¹ * kernelDilate (ModelLowKernelDeriv (u j)) s y| ≤
        C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y := by
  rcases kernelDilate_ModelLowKernelDeriv_sourceWeight_bracket_majorant with
    ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u j s y hs
  have hsinv : 0 ≤ s⁻¹ := (inv_pos.mpr hs).le
  have hmain := hbound u j s y hs
  rw [abs_mul, abs_of_nonneg hsinv]
  calc
    s⁻¹ * |kernelDilate (ModelLowKernelDeriv (u j)) s y| ≤
        s⁻¹ * (C * sourceWeight u ^ 10 * bracketKernelAt s 0 y) :=
      mul_le_mul_of_nonneg_left hmain hsinv
    _ = C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y := by ring



/-- The second derivative of the fixed Gaussian, written in a form adapted
to polynomial decay estimates. -/
noncomputable def gaussianSecondDeriv (x : ℝ) : ℝ :=
  (4 * Real.pi ^ 2 * x ^ 2 - 2 * Real.pi) * gaussian x

/-- The displayed second Gaussian derivative is genuine. -/
theorem hasDerivAt_gaussianDeriv_second (x : ℝ) :
    HasDerivAt gaussianDeriv (gaussianSecondDeriv x) x := by
  have hlinear : HasDerivAt (fun y : ℝ ↦ -2 * Real.pi * y)
      (-2 * Real.pi) x := by
    convert! (hasDerivAt_const x (-2 * Real.pi)).mul
      (hasDerivAt_id x) using 1 ; ring
  have h := hlinear.mul (hasDerivAt_gaussian x)
  unfold gaussianDeriv gaussianSecondDeriv
  convert! h using 1 ; simp only [gaussianDeriv] ; ring

/-- The second Gaussian derivative is continuous. -/
theorem continuous_gaussianSecondDeriv :
    Continuous gaussianSecondDeriv := by
  unfold gaussianSecondDeriv
  apply Continuous.mul
  · fun_prop
  · exact gaussian_contDiff.continuous

/-- Every polynomial weight is bounded against the second Gaussian
derivative. -/
theorem gaussianSecondDeriv_polynomial_decay (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      (1 + |x|) ^ n * |gaussianSecondDeriv x| ≤ C := by
  rcases gaussian_polynomial_decay (n + 2) with ⟨Cg, hCg, hgaussian⟩
  refine ⟨(2 * Real.pi + 4 * Real.pi ^ 2) * Cg,
    mul_nonneg (by positivity) hCg, ?_⟩
  intro x
  have hcoeff : |4 * Real.pi ^ 2 * x ^ 2 - 2 * Real.pi| ≤
      2 * Real.pi + 4 * Real.pi ^ 2 * |x| ^ 2 := by
    calc
      |4 * Real.pi ^ 2 * x ^ 2 - 2 * Real.pi| =
          |4 * Real.pi ^ 2 * x ^ 2 + -(2 * Real.pi)| := by ring
      _ ≤ |4 * Real.pi ^ 2 * x ^ 2| + |-(2 * Real.pi)| :=
        abs_add_le _ _
      _ = 2 * Real.pi + 4 * Real.pi ^ 2 * |x| ^ 2 := by
        simp only [abs_mul, abs_neg, abs_pow,
          abs_of_pos Real.pi_pos]
        norm_num
        ring
  have hfirst :
      (1 + |x|) ^ n * gaussian x ≤
        (1 + |x|) ^ (n + 2) * gaussian x := by
    apply mul_le_mul_of_nonneg_right
      (pow_le_pow_right₀ (a := 1 + |x|) (by linarith [abs_nonneg x])
        (Nat.le_add_right n 2))
      (gaussian_nonneg x)
  have hsecond :
      (1 + |x|) ^ n * |x| ^ 2 * gaussian x ≤
        (1 + |x|) ^ (n + 2) * gaussian x := by
    calc
      (1 + |x|) ^ n * |x| ^ 2 * gaussian x ≤
          ((1 + |x|) ^ n * (1 + |x|) ^ 2) * gaussian x := by
        apply mul_le_mul_of_nonneg_right _ (gaussian_nonneg x)
        apply mul_le_mul_of_nonneg_left _ (pow_nonneg (by positivity) _)
        nlinarith [abs_nonneg x]
      _ = (1 + |x|) ^ (n + 2) * gaussian x := by
        rw [← pow_add]
  unfold gaussianSecondDeriv
  rw [abs_mul, abs_of_nonneg (gaussian_nonneg x)]
  calc
    (1 + |x|) ^ n *
        (|4 * Real.pi ^ 2 * x ^ 2 - 2 * Real.pi| * gaussian x) ≤
        (1 + |x|) ^ n *
          (2 * Real.pi + 4 * Real.pi ^ 2 * |x| ^ 2) * gaussian x := by
      calc
        (1 + |x|) ^ n *
            (|4 * Real.pi ^ 2 * x ^ 2 - 2 * Real.pi| * gaussian x) =
            ((1 + |x|) ^ n *
              |4 * Real.pi ^ 2 * x ^ 2 - 2 * Real.pi|) * gaussian x := by ring
        _ ≤ ((1 + |x|) ^ n *
              (2 * Real.pi + 4 * Real.pi ^ 2 * |x| ^ 2)) * gaussian x := by
          apply mul_le_mul_of_nonneg_right _ (gaussian_nonneg x)
          exact mul_le_mul_of_nonneg_left hcoeff (pow_nonneg (by positivity) _)
        _ = (1 + |x|) ^ n *
            (2 * Real.pi + 4 * Real.pi ^ 2 * |x| ^ 2) * gaussian x := by ring
    _ = 2 * Real.pi * ((1 + |x|) ^ n * gaussian x) +
        4 * Real.pi ^ 2 * ((1 + |x|) ^ n * |x| ^ 2 * gaussian x) := by ring
    _ ≤ 2 * Real.pi * Cg + 4 * Real.pi ^ 2 * Cg := by
      apply add_le_add
      · exact mul_le_mul_of_nonneg_left (hfirst.trans (hgaussian x))
          (by positivity)
      · exact mul_le_mul_of_nonneg_left (hsecond.trans (hgaussian x))
          (by positivity)
    _ = (2 * Real.pi + 4 * Real.pi ^ 2) * Cg := by ring

/-- The second Gaussian derivative is globally bounded. -/
theorem exists_bound_gaussianSecondDeriv :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ x : ℝ, ‖gaussianSecondDeriv x‖ ≤ B := by
  rcases gaussianSecondDeriv_polynomial_decay 0 with
    ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro x
  rw [Real.norm_eq_abs]
  simpa using hbound x

/-- The unscaled derivative of the translated third model kernel. -/
noncomputable def ModelThirdKernelDeriv (u w : ℝ) : ℝ :=
  (gaussianSecondDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
    (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
      conePsiPhysicalReal)) (w - u)

/-- Differentiating the outer Gaussian derivative in the double annular
convolution gives the displayed third-kernel derivative. -/
theorem hasDerivAt_third_convolution (w : ℝ) :
    HasDerivAt (fun y ↦
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          conePsiPhysicalReal)) y)
      ((gaussianSecondDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          conePsiPhysicalReal)) w) w := by
  rcases exists_bound_gaussianDeriv with ⟨A, hA, hgaussianDeriv⟩
  rcases exists_bound_gaussianSecondDeriv with ⟨B, hB, hsecond⟩
  have hinner : Integrable
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        conePsiPhysicalReal) :=
    integrable_gaussianDeriv.integrable_convolution
      (ContinuousLinearMap.mul ℝ ℝ) conePsiPhysicalReal.integrable
  have hbase := hasDerivAt_convolution_right_of_bound
    (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
      conePsiPhysicalReal) gaussianDeriv gaussianSecondDeriv
    hinner continuous_gaussianDeriv continuous_gaussianSecondDeriv
    hasDerivAt_gaussianDeriv_second A B hgaussianDeriv hsecond w
  have hfun :
      (fun y ↦ (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          conePsiPhysicalReal)) y) =
        fun y ↦ ((gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          conePsiPhysicalReal) ⋆[ContinuousLinearMap.mul ℝ ℝ]
          gaussianDeriv) y := by
    funext y
    exact convolution_mul_comm gaussianDeriv
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        conePsiPhysicalReal) y
  have hvalue :
      (gaussianSecondDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          conePsiPhysicalReal)) w =
        ((gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          conePsiPhysicalReal) ⋆[ContinuousLinearMap.mul ℝ ℝ]
          gaussianSecondDeriv) w :=
    convolution_mul_comm gaussianSecondDeriv
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        conePsiPhysicalReal) w
  rw [hfun, hvalue]
  exact hbase

/-- The literal third kernel is the translation of the fixed double
Gaussian-derivative/annular convolution. -/
theorem ModelThirdKernel_eq_convolution_translate (u w : ℝ) :
    ModelThirdKernel u w =
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          conePsiPhysicalReal)) (w - u) := by
  rw [convolution_mul]
  unfold ModelThirdKernel
  apply integral_congr_ae
  filter_upwards [] with z
  rw [modelThirdKernel_unit_eq_convolution u (w - z)]
  congr 1
  ring

/-- The displayed third-kernel derivative is an actual spatial derivative. -/
theorem hasDerivAt_ModelThirdKernel (u w : ℝ) :
    HasDerivAt (ModelThirdKernel u) (ModelThirdKernelDeriv u w) w := by
  have hbase := hasDerivAt_third_convolution (w - u)
  have htranslate := hbase.comp w
    ((hasDerivAt_id w).sub (hasDerivAt_const w u))
  have hcomp :
      (fun y : ℝ ↦ (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          conePsiPhysicalReal)) y) ∘ (id - fun _ : ℝ ↦ u) =
        fun y : ℝ ↦ (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
            conePsiPhysicalReal)) (y - u) := by
    funext y
    simp
  rw [hcomp] at htranslate
  rw [show ModelThirdKernel u = fun y ↦
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          conePsiPhysicalReal)) (y - u) by
        funext y
        exact ModelThirdKernel_eq_convolution_translate u y]
  simpa only [sub_zero, mul_one, ModelThirdKernelDeriv] using htranslate

/-- The third-kernel derivative has order-ten polynomial decay. -/
theorem third_deriv_convolution_polynomial_decay :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ,
      (1 + |x|) ^ 10 *
        |(gaussianSecondDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
          (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
            conePsiPhysicalReal)) x| ≤ C := by
  rcases gaussianSecondDeriv_polynomial_decay 10 with
    ⟨Csecond, hCsecond, hsecond⟩
  have hinner : Integrable
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        conePsiPhysicalReal) :=
    integrable_gaussianDeriv.integrable_convolution
      (ContinuousLinearMap.mul ℝ ℝ) conePsiPhysicalReal.integrable
  have hinnermeas : Measurable
      (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
        conePsiPhysicalReal) := by
    rcases exists_bound_gaussianDeriv with ⟨A, hA, hbound⟩
    have hbounded : BddAbove
        (Set.range fun x : ℝ ↦ ‖gaussianDeriv x‖) := by
      refine ⟨A, ?_⟩
      rintro _ ⟨x, rfl⟩
      exact hbound x
    exact (hbounded.continuous_convolution_left_of_integrable
      (ContinuousLinearMap.mul ℝ ℝ) continuous_gaussianDeriv
      conePsiPhysicalReal.integrable).measurable
  have hconv := convolution_decay_of_weighted_bound 10
    gaussianSecondDeriv
    (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
      conePsiPhysicalReal)
    continuous_gaussianSecondDeriv.measurable hinnermeas
    hinner integrable_weighted_annular_convolution hsecond
  let C : ℝ := Csecond * ∫ y : ℝ, (1 + |y|) ^ 10 *
    |(gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
      conePsiPhysicalReal) y|
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg hCsecond (integral_nonneg fun y ↦ by positivity)
  exact ⟨C, hC, fun x ↦ hconv x⟩

/-- The actual third-kernel derivative obeys the translated bracket
majorant. -/
theorem ModelThirdKernelDeriv_translate_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u w : ℝ),
      |ModelThirdKernelDeriv u w| ≤
        C * translationWeight u ^ 10 * bracketKernel w := by
  rcases third_deriv_convolution_polynomial_decay with
    ⟨C, hC, hdecay⟩
  let K : ℝ → ℝ := gaussianSecondDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
    (gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ]
      conePsiPhysicalReal)
  rcases kernelAt_translate_bracket_of_polynomial_decay K
    ⟨C, hC, by simpa only [K] using hdecay⟩ with ⟨D, hD, htranslate⟩
  refine ⟨D, hD, ?_⟩
  intro u w
  simpa only [ModelThirdKernelDeriv, K, kernelAt, kernelDilate,
    inv_one, one_smul, div_one] using htranslate u w

/-- The scaled third-kernel derivative has the order-ten source-weight
bracket majorant needed for the bad-fiber cancellation argument. -/
theorem kernelDilate_ModelThirdKernelDeriv_sourceWeight_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (j : Fin 3) (s y : ℝ), 0 < s →
      |kernelDilate (ModelThirdKernelDeriv (u j)) s y| ≤
        C * sourceWeight u ^ 10 * bracketKernelAt s 0 y := by
  rcases ModelThirdKernelDeriv_translate_bracket_majorant with
    ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u j s y hs
  have hbase := hbound (u j) (y / s)
  have hsinv : 0 ≤ s⁻¹ := (inv_pos.mpr hs).le
  have hcoordinate := translationWeight_coordinate_le_sourceWeight u j
  have hpow : translationWeight (u j) ^ 10 ≤ sourceWeight u ^ 10 :=
    pow_le_pow_left₀ (by unfold translationWeight; positivity) hcoordinate 10
  have hbracket : 0 ≤ bracketKernelAt s 0 y := (bracketKernelAt_pos hs).le
  unfold kernelDilate bracketKernelAt kernelAt kernelDilate
  simp only [sub_zero, smul_eq_mul]
  rw [abs_mul, abs_of_nonneg hsinv]
  calc
    s⁻¹ * |ModelThirdKernelDeriv (u j) (y / s)| ≤
        s⁻¹ * (C * translationWeight (u j) ^ 10 *
          bracketKernel (y / s)) :=
      mul_le_mul_of_nonneg_left hbase hsinv
    _ = (C * (s⁻¹ * bracketKernel (y / s))) *
          translationWeight (u j) ^ 10 := by ring
    _ ≤ (C * (s⁻¹ * bracketKernel (y / s))) * sourceWeight u ^ 10 :=
      mul_le_mul_of_nonneg_left hpow
        (mul_nonneg hC (mul_nonneg hsinv (bracketKernel_nonneg _)))
    _ = C * sourceWeight u ^ 10 *
          (s⁻¹ * bracketKernel (y / s)) := by ring

/-- The literal scaled third kernel has an actual spatial derivative obeying
the source's inverse-scale bracket estimate. -/
theorem hasDerivAt_kernelDilate_ModelThirdKernel
    (u : E3) (j : Fin 3) (s y : ℝ) (hs : 0 < s) :
    HasDerivAt (kernelDilate (ModelThirdKernel (u j)) s)
      (s⁻¹ * kernelDilate (ModelThirdKernelDeriv (u j)) s y) y := by
  exact hasDerivAt_kernelDilate_of_hasDerivAt
    (ModelThirdKernel (u j)) (ModelThirdKernelDeriv (u j)) s y hs.ne'
    (hasDerivAt_ModelThirdKernel (u j) (y / s))

/-- The third active derivative satisfies the literal `s⁻¹`-times-bracket
bound. -/
theorem deriv_kernelDilate_ModelThirdKernel_sourceWeight_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E3) (j : Fin 3) (s y : ℝ), 0 < s →
      |s⁻¹ * kernelDilate (ModelThirdKernelDeriv (u j)) s y| ≤
        C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y := by
  rcases kernelDilate_ModelThirdKernelDeriv_sourceWeight_bracket_majorant with
    ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro u j s y hs
  have hsinv : 0 ≤ s⁻¹ := (inv_pos.mpr hs).le
  have hmain := hbound u j s y hs
  rw [abs_mul, abs_of_nonneg hsinv]
  calc
    s⁻¹ * |kernelDilate (ModelThirdKernelDeriv (u j)) s y| ≤
        s⁻¹ * (C * sourceWeight u ^ 10 * bracketKernelAt s 0 y) :=
      mul_le_mul_of_nonneg_left hmain hsinv
    _ = C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y := by ring

/-- The spatial derivative of the active kernel, choosing the annular
derivative exactly in the active coordinate. -/
noncomputable def activeModelKernelDeriv
    (i j : Fin 3) (u : E3) : ℝ → ℝ :=
  if j = i then ModelThirdKernelDeriv (u j)
  else ModelLowKernelDeriv (u j)

/-- Every scaled active model kernel has the displayed genuine spatial
derivative. -/
theorem hasDerivAt_kernelDilate_activeModelKernel
    (i j : Fin 3) (u : E3) (s y : ℝ) (hs : 0 < s) :
    HasDerivAt (kernelDilate (activeModelKernel i j u) s)
      (s⁻¹ * kernelDilate (activeModelKernelDeriv i j u) s y) y := by
  by_cases hji : j = i
  · subst j
    simp only [activeModelKernel, activeModelKernelDeriv]
    exact hasDerivAt_kernelDilate_ModelThirdKernel u i s y hs
  · simp only [activeModelKernel, activeModelKernelDeriv, ite_eq_right hji]
    exact hasDerivAt_kernelDilate_ModelLowKernel u j s y hs

/-- Uniform source-weight derivative bracket bound for all three active
kernels. This is the literal derivative clause of `lem:fiber_kernel`. -/
theorem deriv_kernelDilate_activeModelKernel_sourceWeight_bracket_majorant :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i j : Fin 3) (u : E3) (s y : ℝ), 0 < s →
      |s⁻¹ * kernelDilate (activeModelKernelDeriv i j u) s y| ≤
        C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y := by
  rcases deriv_kernelDilate_ModelLowKernel_sourceWeight_bracket_majorant with
    ⟨Clow, hClow, hlow⟩
  rcases deriv_kernelDilate_ModelThirdKernel_sourceWeight_bracket_majorant with
    ⟨Cthird, hCthird, hthird⟩
  refine ⟨max Clow Cthird, le_trans hClow (le_max_left _ _), ?_⟩
  intro i j u s y hs
  have hfactor : 0 ≤ sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y := by
    exact mul_nonneg
      (mul_nonneg (pow_nonneg (sourceWeight_nonneg u) _)
        (inv_pos.mpr hs).le)
      (bracketKernelAt_pos hs).le
  by_cases hji : j = i
  · subst j
    simp only [activeModelKernelDeriv]
    calc
      |s⁻¹ * kernelDilate (ModelThirdKernelDeriv (u i)) s y| ≤
          Cthird * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y :=
        hthird u i s y hs
      _ = Cthird * (sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y) := by ring
      _ ≤ max Clow Cthird *
          (sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y) :=
        mul_le_mul_of_nonneg_right (le_max_right _ _) hfactor
      _ = max Clow Cthird * sourceWeight u ^ 10 * s⁻¹ *
          bracketKernelAt s 0 y := by ring
  · simp only [activeModelKernelDeriv, ite_eq_right hji]
    calc
      |s⁻¹ * kernelDilate (ModelLowKernelDeriv (u j)) s y| ≤
          Clow * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y :=
        hlow u j s y hs
      _ = Clow * (sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y) := by ring
      _ ≤ max Clow Cthird *
          (sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 y) :=
        mul_le_mul_of_nonneg_right (le_max_left _ _) hfactor
      _ = max Clow Cthird * sourceWeight u ^ 10 * s⁻¹ *
          bracketKernelAt s 0 y := by ring


/-- A scalar mean-value inequality localized to the unordered interval
joining its two arguments. -/
theorem abs_sub_le_of_hasDerivAt_bound_uIcc
    (f f' : ℝ → ℝ) (a b C : ℝ)
    (hderiv : ∀ z ∈ Set.uIcc a b, HasDerivAt f (f' z) z)
    (hbound : ∀ z ∈ Set.uIcc a b, |f' z| ≤ C) :
    |f a - f b| ≤ C * |a - b| := by
  have h := (convex_uIcc a b).norm_image_sub_le_of_norm_hasDerivWithin_le
    (f := f) (f' := f')
    (fun z hz ↦ (hderiv z hz).hasDerivWithinAt)
    (fun z hz ↦ by
      rw [Real.norm_eq_abs]
      exact hbound z hz)
    Set.right_mem_uIcc Set.left_mem_uIcc
  simpa only [Real.norm_eq_abs] using h

/-- The active-kernel derivative majorant gives a literal mean-value
comparison whenever the positive bracket is uniformly controlled along the
joining segment. -/
theorem abs_sub_kernelDilate_activeModelKernel_of_segment_bracket_bound :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i j : Fin 3) (u : E3) (s a b A : ℝ), 0 < s →
      (∀ z ∈ Set.uIcc a b, bracketKernelAt s 0 z ≤ A) →
      |kernelDilate (activeModelKernel i j u) s a -
          kernelDilate (activeModelKernel i j u) s b| ≤
        C * sourceWeight u ^ 10 * s⁻¹ * A * |a - b| := by
  rcases deriv_kernelDilate_activeModelKernel_sourceWeight_bracket_majorant with
    ⟨C, hC, hderivbound⟩
  refine ⟨C, hC, ?_⟩
  intro i j u s a b A hs hsegment
  let f : ℝ → ℝ := kernelDilate (activeModelKernel i j u) s
  let f' : ℝ → ℝ := fun z ↦
    s⁻¹ * kernelDilate (activeModelKernelDeriv i j u) s z
  have hderiv : ∀ z ∈ Set.uIcc a b, HasDerivAt f (f' z) z := by
    intro z hz
    exact hasDerivAt_kernelDilate_activeModelKernel i j u s z hs
  have hfactor : 0 ≤ C * sourceWeight u ^ 10 * s⁻¹ := by
    exact mul_nonneg
      (mul_nonneg hC (pow_nonneg (sourceWeight_nonneg u) _))
      (inv_pos.mpr hs).le
  have hbound : ∀ z ∈ Set.uIcc a b, |f' z| ≤
      C * sourceWeight u ^ 10 * s⁻¹ * A := by
    intro z hz
    have hzbound := hderivbound i j u s z hs
    calc
      |f' z| ≤ C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 z := by
        simpa only [f'] using hzbound
      _ = (C * sourceWeight u ^ 10 * s⁻¹) * bracketKernelAt s 0 z := by ring
      _ ≤ (C * sourceWeight u ^ 10 * s⁻¹) * A :=
        mul_le_mul_of_nonneg_left (hsegment z hz) hfactor
      _ = C * sourceWeight u ^ 10 * s⁻¹ * A := by ring
  simpa only [f] using
    abs_sub_le_of_hasDerivAt_bound_uIcc f f' a b
      (C * sourceWeight u ^ 10 * s⁻¹ * A) hderiv hbound

/-- Every point between the two cancellation arguments remains at least half
the center distance from the origin once the interval radius is at most half
that distance. -/
theorem half_distance_le_abs_of_mem_cancellation_segment
    {x y c z : ℝ} (hremote : 2 * |y - c| ≤ |x - c|)
    (hz : z ∈ Set.uIcc (x - y) (x - c)) :
    |x - c| / 2 ≤ |z| := by
  have hz' : z ∈ Set.uIcc (x - c) (x - y) := by
    simpa only [Set.uIcc_comm] using hz
  have hnear : |z - (x - c)| ≤ |(x - y) - (x - c)| :=
    Set.abs_sub_left_of_mem_uIcc hz'
  have hnear' : |z - (x - c)| ≤ |y - c| := by
    calc
      |z - (x - c)| ≤ |(x - y) - (x - c)| := hnear
      _ = |y - c| := by rw [show (x - y) - (x - c) = -(y - c) by ring, abs_neg]
  have htri : |x - c| ≤ |z| + |z - (x - c)| := by
    calc
      |x - c| = |z + ((x - c) - z)| := by ring_nf
      _ ≤ |z| + |(x - c) - z| := abs_add_le _ _
      _ = |z| + |z - (x - c)| := by rw [abs_sub_comm]
  linarith

/-- A point at least half as far from the origin as a reference point has a
bracket kernel no larger than the reference bracket, up to the fixed
order-ten factor. -/
theorem bracketKernelAt_le_two_pow_ten_of_half_distance
    {s w z : ℝ} (hs : 0 < s) (hhalf : |w| / 2 ≤ |z|) :
    bracketKernelAt s 0 z ≤ (2 : ℝ) ^ 10 * bracketKernelAt s 0 w := by
  have hscaled : |w / s| / 2 ≤ |z / s| := by
    rw [abs_div, abs_div, abs_of_pos hs]
    calc
      (|w| / s) / 2 = (|w| / 2) / s := by ring
      _ ≤ |z| / s := div_le_div_of_nonneg_right hhalf hs.le
  have hbase : 1 + |w / s| ≤ 2 * (1 + |z / s|) := by
    linarith
  have hpow : (1 + |w / s|) ^ 10 ≤
      (2 : ℝ) ^ 10 * (1 + |z / s|) ^ 10 := by
    calc
      (1 + |w / s|) ^ 10 ≤ (2 * (1 + |z / s|)) ^ 10 :=
        pow_le_pow_left₀ (by positivity) hbase 10
      _ = (2 : ℝ) ^ 10 * (1 + |z / s|) ^ 10 := by rw [mul_pow]
  have hwpos : 0 < (1 + |w / s|) ^ 10 := by positivity
  have hzpos : 0 < (1 + |z / s|) ^ 10 := by positivity
  have hinv : ((1 + |z / s|) ^ 10)⁻¹ ≤
      (2 : ℝ) ^ 10 * ((1 + |w / s|) ^ 10)⁻¹ := by
    rw [inv_eq_one_div]
    have hdiv : 1 / (1 + |z / s|) ^ 10 ≤
        (2 : ℝ) ^ 10 / (1 + |w / s|) ^ 10 :=
      (div_le_div_iff₀ hzpos hwpos).mpr (by simpa only [one_mul] using hpow)
    convert hdiv using 1 ; ring
  unfold bracketKernelAt kernelAt kernelDilate
  simp only [sub_zero, smul_eq_mul, bracketKernel_eq_inv_pow]
  calc
    s⁻¹ * ((1 + |z / s|) ^ 10)⁻¹ ≤
        s⁻¹ * ((2 : ℝ) ^ 10 * ((1 + |w / s|) ^ 10)⁻¹) :=
      mul_le_mul_of_nonneg_left hinv (inv_nonneg.mpr hs.le)
    _ = (2 : ℝ) ^ 10 *
        (s⁻¹ * ((1 + |w / s|) ^ 10)⁻¹) := by ring

/-- The literal off-interval cancellation difference for every active model
kernel. This is the mean-value estimate used for a bad fiber: the two
arguments are `x-y` and `x-c`, and the remote hypothesis is exactly the
source condition needed along their joining segment. -/
theorem abs_sub_kernelDilate_activeModelKernel_cancellation :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i j : Fin 3) (u : E3) (s x y c : ℝ), 0 < s →
      2 * |y - c| ≤ |x - c| →
      |kernelDilate (activeModelKernel i j u) s (x - y) -
          kernelDilate (activeModelKernel i j u) s (x - c)| ≤
        C * sourceWeight u ^ 10 * |y - c| * s⁻¹ *
          bracketKernelAt s 0 (x - c) := by
  rcases abs_sub_kernelDilate_activeModelKernel_of_segment_bracket_bound with
    ⟨C, hC, hmean⟩
  refine ⟨C * (2 : ℝ) ^ 10, mul_nonneg hC (by positivity), ?_⟩
  intro i j u s x y c hs hremote
  have hsegment : ∀ z ∈ Set.uIcc (x - y) (x - c),
      bracketKernelAt s 0 z ≤ (2 : ℝ) ^ 10 * bracketKernelAt s 0 (x - c) := by
    intro z hz
    exact bracketKernelAt_le_two_pow_ten_of_half_distance hs
      (half_distance_le_abs_of_mem_cancellation_segment hremote hz)
  have hmean' := hmean i j u s (x - y) (x - c)
    ((2 : ℝ) ^ 10 * bracketKernelAt s 0 (x - c)) hs hsegment
  have hab : |(x - y) - (x - c)| = |y - c| := by
    rw [show (x - y) - (x - c) = -(y - c) by ring, abs_neg]
  calc
    |kernelDilate (activeModelKernel i j u) s (x - y) -
        kernelDilate (activeModelKernel i j u) s (x - c)| ≤
        C * sourceWeight u ^ 10 * s⁻¹ *
          ((2 : ℝ) ^ 10 * bracketKernelAt s 0 (x - c)) *
          |(x - y) - (x - c)| := hmean'
    _ = (C * (2 : ℝ) ^ 10) * sourceWeight u ^ 10 * |y - c| * s⁻¹ *
          bracketKernelAt s 0 (x - c) := by rw [hab]; ring

/-- Mean-zero input cancellation rewrites a kernel convolution by subtracting
the kernel at an arbitrary fixed center. -/
theorem integral_mul_kernel_sub_center_of_integral_zero
    (b k : ℝ → ℝ) (x c : ℝ)
    (hb : Integrable b)
    (hmain : Integrable (fun y ↦ b y * k (x - y)))
    (hzero : ∫ y : ℝ, b y = 0) :
    (∫ y : ℝ, b y * k (x - y)) =
      ∫ y : ℝ, b y * (k (x - y) - k (x - c)) := by
  let q : ℝ → ℝ := fun y ↦ b y * k (x - c)
  let h : ℝ → ℝ := fun y ↦ b y * (k (x - y) - k (x - c))
  have hq : Integrable q := by
    dsimp only [q]
    exact hb.mul_const (k (x - c))
  have hh : Integrable h := by
    have heq : h = (fun y ↦ b y * k (x - y)) - q := by
      funext y
      dsimp only [h, q, Pi.sub_apply]
      ring
    rw [heq]
    exact hmain.sub hq
  have hsplit : (fun y ↦ b y * k (x - y)) = fun y ↦ h y + q y := by
    funext y
    dsimp only [h, q]
    ring
  calc
    (∫ y : ℝ, b y * k (x - y)) = ∫ y : ℝ, h y + q y := by rw [← hsplit]
    _ = (∫ y : ℝ, h y) + ∫ y : ℝ, q y := integral_add hh hq
    _ = (∫ y : ℝ, h y) + (∫ y : ℝ, b y) * k (x - c) := by
      congr 1
      dsimp only [q]
      rw [integral_mul_const]
    _ = ∫ y : ℝ, h y := by rw [hzero]; ring
    _ = ∫ y : ℝ, b y * (k (x - y) - k (x - c)) := rfl

/-- The active-kernel cancellation difference integrates against a mean-zero
bad fiber with its exact first absolute moment. -/
theorem abs_integral_activeModelKernel_badFiber_cancellation :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i j : Fin 3) (u : E3) (s x c : ℝ)
      (b : ℝ → ℝ), 0 < s → Integrable b →
      Integrable (fun y ↦ |b y| * |y - c|) →
      Integrable (fun y ↦ b y *
        kernelDilate (activeModelKernel i j u) s (x - y)) →
      (∫ y : ℝ, b y) = 0 →
      (∀ y : ℝ, b y ≠ 0 → 2 * |y - c| ≤ |x - c|) →
      |∫ y : ℝ, b y *
          kernelDilate (activeModelKernel i j u) s (x - y)| ≤
        C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 (x - c) *
          ∫ y : ℝ, |b y| * |y - c| := by
  rcases abs_sub_kernelDilate_activeModelKernel_cancellation with
    ⟨C, hC, hkernel⟩
  refine ⟨C, hC, ?_⟩
  intro i j u s x c b hs hb hmoment hmain hzero hremote
  let k : ℝ → ℝ := kernelDilate (activeModelKernel i j u) s
  let h : ℝ → ℝ := fun y ↦ b y * (k (x - y) - k (x - c))
  let P : ℝ := C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 (x - c)
  have hP : 0 ≤ P := by
    dsimp only [P]
    exact mul_nonneg
      (mul_nonneg
        (mul_nonneg hC (pow_nonneg (sourceWeight_nonneg u) _))
        (inv_pos.mpr hs).le)
      (bracketKernelAt_pos hs).le
  have hq : Integrable (fun y ↦ b y * k (x - c)) := by
    exact hb.mul_const (k (x - c))
  have hmaink : Integrable (fun y ↦ b y * k (x - y)) := by
    simpa only [k] using hmain
  have hh : Integrable h := by
    have heq : h = (fun y ↦ b y * k (x - y)) -
        fun y ↦ b y * k (x - c) := by
      funext y
      dsimp only [h, Pi.sub_apply]
      ring
    rw [heq]
    exact hmaink.sub hq
  have hupper : Integrable (fun y ↦ P * (|b y| * |y - c|)) :=
    hmoment.const_mul P
  have hpoint : ∀ y : ℝ, |h y| ≤ P * (|b y| * |y - c|) := by
    intro y
    by_cases hy : b y = 0
    · simp [h, hy]
    · have hdiff := hkernel i j u s x y c hs (hremote y hy)
      dsimp only [h, P]
      rw [abs_mul]
      calc
        |b y| * |k (x - y) - k (x - c)| ≤
            |b y| * (C * sourceWeight u ^ 10 * |y - c| * s⁻¹ *
              bracketKernelAt s 0 (x - c)) :=
          mul_le_mul_of_nonneg_left (by simpa only [k] using hdiff) (abs_nonneg _)
        _ = P * (|b y| * |y - c|) := by ring
  have hrewrite : (∫ y : ℝ, b y * k (x - y)) = ∫ y : ℝ, h y := by
    exact integral_mul_kernel_sub_center_of_integral_zero
      b k x c hb hmaink hzero
  change |∫ y : ℝ, b y * k (x - y)| ≤ P * ∫ y : ℝ, |b y| * |y - c|
  rw [hrewrite]
  calc
    |∫ y : ℝ, h y| ≤ ∫ y : ℝ, |h y| :=
      MeasureTheory.abs_integral_le_integral_abs
    _ ≤ ∫ y : ℝ, P * (|b y| * |y - c|) := by
      apply integral_mono hh.norm hupper
      intro y
      simpa only [Real.norm_eq_abs] using hpoint y
    _ = P * ∫ y : ℝ, |b y| * |y - c| := by rw [integral_const_mul]

/-! ### Interval-radius bad-fiber cancellation -/

/-- A bad fiber supported in the interval of radius `r` about `c` has a
finite first absolute moment. -/
theorem integrable_badFiber_firstMoment_of_interval_radius
    (b : ℝ → ℝ) (c r : ℝ) (_hr : 0 ≤ r) (hb : Integrable b)
    (hsupport : ∀ y : ℝ, b y ≠ 0 → |y - c| ≤ r) :
    Integrable (fun y : ℝ ↦ |b y| * |y - c|) := by
  have habs : Integrable (fun y : ℝ ↦ |b y|) := by
    simpa only [Real.norm_eq_abs] using hb.norm
  have hmeas : AEStronglyMeasurable (fun y : ℝ ↦ |b y| * |y - c|) volume := by
    have hdist : Measurable (fun y : ℝ ↦ |y - c|) :=
      by
        have hsub : Measurable (fun y : ℝ ↦ y - c) :=
          measurable_id.sub measurable_const
        have hnorm : Measurable (fun y : ℝ ↦ ‖y - c‖) := hsub.norm
        exact hnorm
    exact (hb.aestronglyMeasurable.norm.mul hdist.aestronglyMeasurable).congr
      (Filter.Eventually.of_forall fun y ↦ by rfl)
  refine (habs.const_mul r).mono' hmeas (Filter.Eventually.of_forall fun y ↦ ?_)
  change ‖|b y| * |y - c|‖ ≤ r * |b y|
  have hleft : 0 ≤ |b y| * |y - c| := mul_nonneg (abs_nonneg _) (abs_nonneg _)
  rw [Real.norm_eq_abs, abs_of_nonneg hleft]
  by_cases hy : b y = 0
  · simp [hy]
  · calc
      |b y| * |y - c| ≤ |b y| * r :=
        mul_le_mul_of_nonneg_left (hsupport y hy) (abs_nonneg _)
      _ = r * |b y| := by ring

/-- The first absolute moment of a radius-`r` bad fiber is at most its
absolute mass times `r`. -/
theorem badFiber_firstMoment_le_radius_mul_mass
    (b : ℝ → ℝ) (c r : ℝ) (hr : 0 ≤ r) (hb : Integrable b)
    (hsupport : ∀ y : ℝ, b y ≠ 0 → |y - c| ≤ r) :
    ∫ y : ℝ, |b y| * |y - c| ≤ r * ∫ y : ℝ, |b y| := by
  have hmoment := integrable_badFiber_firstMoment_of_interval_radius
    b c r hr hb hsupport
  have habs : Integrable (fun y : ℝ ↦ |b y|) := by
    simpa only [Real.norm_eq_abs] using hb.norm
  calc
    (∫ y : ℝ, |b y| * |y - c|) ≤ ∫ y : ℝ, r * |b y| := by
      apply integral_mono hmoment (habs.const_mul r)
      intro y
      by_cases hy : b y = 0
      · simp [hy]
      · calc
          |b y| * |y - c| ≤ |b y| * r :=
            mul_le_mul_of_nonneg_left (hsupport y hy) (abs_nonneg _)
          _ = r * |b y| := by ring
    _ = r * ∫ y : ℝ, |b y| := by rw [integral_const_mul]

/-- Outside the doubled interval, every point in a radius-`r` bad fiber
satisfies the remote hypothesis of the active-kernel cancellation estimate. -/
theorem badFiber_interval_radius_remote
    {b : ℝ → ℝ} {c r x y : ℝ} (hsupport : ∀ q : ℝ, b q ≠ 0 → |q - c| ≤ r)
    (hfar : 2 * r ≤ |x - c|) (hy : b y ≠ 0) :
    2 * |y - c| ≤ |x - c| := by
  calc
    2 * |y - c| ≤ 2 * r :=
      mul_le_mul_of_nonneg_left (hsupport y hy) (by norm_num)
    _ ≤ |x - c| := hfar

/-- The canonical bad-fiber cancellation bound specialized to an interval
of radius `r` and a point outside its double. -/
theorem abs_integral_activeModelKernel_badFiber_of_interval_radius :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i j : Fin 3) (u : E3) (s x c r : ℝ)
      (b : ℝ → ℝ), 0 < s → 0 ≤ r → Integrable b →
      Integrable (fun y ↦ b y *
        kernelDilate (activeModelKernel i j u) s (x - y)) →
      (∫ y : ℝ, b y) = 0 →
      (∀ y : ℝ, b y ≠ 0 → |y - c| ≤ r) →
      2 * r ≤ |x - c| →
      |∫ y : ℝ, b y *
          kernelDilate (activeModelKernel i j u) s (x - y)| ≤
        C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 (x - c) *
          r * ∫ y : ℝ, |b y| := by
  rcases abs_integral_activeModelKernel_badFiber_cancellation with
    ⟨C, hC, hcancel⟩
  refine ⟨C, hC, ?_⟩
  intro i j u s x c r b hs hr hb hmain hzero hsupport hfar
  have hmoment := integrable_badFiber_firstMoment_of_interval_radius
    b c r hr hb hsupport
  have hmoment_bound := badFiber_firstMoment_le_radius_mul_mass
    b c r hr hb hsupport
  have hremote : ∀ y : ℝ, b y ≠ 0 → 2 * |y - c| ≤ |x - c| := by
    intro y hy
    exact badFiber_interval_radius_remote hsupport hfar hy
  have hbase := hcancel i j u s x c b hs hb hmoment hmain hzero hremote
  have hfactor : 0 ≤ C * sourceWeight u ^ 10 * s⁻¹ *
      bracketKernelAt s 0 (x - c) := by
    exact mul_nonneg
      (mul_nonneg
        (mul_nonneg hC (pow_nonneg (sourceWeight_nonneg u) _))
        (inv_pos.mpr hs).le)
      (bracketKernelAt_pos hs).le
  calc
    |∫ y : ℝ, b y * kernelDilate (activeModelKernel i j u) s (x - y)| ≤
        (C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 (x - c)) *
          ∫ y : ℝ, |b y| * |y - c| := by
      simpa only [mul_assoc] using hbase
    _ ≤ (C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 (x - c)) *
          (r * ∫ y : ℝ, |b y|) :=
      mul_le_mul_of_nonneg_left hmoment_bound hfactor
    _ = C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 (x - c) *
          r * ∫ y : ℝ, |b y| := by ring

/-- Combining the radius support and source mass bounds gives the exact
quadratic interval-size factor used before summing bad-fiber tails. -/
theorem abs_integral_activeModelKernel_badFiber_of_interval_radius_mass :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i j : Fin 3) (u : E3) (s x c r M : ℝ)
      (b : ℝ → ℝ), 0 < s → 0 ≤ r → 0 ≤ M → Integrable b →
      Integrable (fun y ↦ b y *
        kernelDilate (activeModelKernel i j u) s (x - y)) →
      (∫ y : ℝ, b y) = 0 →
      (∀ y : ℝ, b y ≠ 0 → |y - c| ≤ r) →
      2 * r ≤ |x - c| →
      (∫ y : ℝ, |b y|) ≤ M * (2 * r) →
      |∫ y : ℝ, b y *
          kernelDilate (activeModelKernel i j u) s (x - y)| ≤
        C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 (x - c) *
          M * r ^ 2 := by
  rcases abs_integral_activeModelKernel_badFiber_of_interval_radius with
    ⟨C, hC, hcancel⟩
  refine ⟨2 * C, mul_nonneg (by norm_num) hC, ?_⟩
  intro i j u s x c r M b hs hr hM hb hmain hzero hsupport hfar hmass
  have hbase := hcancel i j u s x c r b hs hr hb hmain hzero hsupport hfar
  have hfactor : 0 ≤ C * sourceWeight u ^ 10 * s⁻¹ *
      bracketKernelAt s 0 (x - c) * r := by
    exact mul_nonneg
      (mul_nonneg
        (mul_nonneg
          (mul_nonneg hC (pow_nonneg (sourceWeight_nonneg u) _))
          (inv_pos.mpr hs).le)
        (bracketKernelAt_pos hs).le)
      hr
  calc
    |∫ y : ℝ, b y * kernelDilate (activeModelKernel i j u) s (x - y)| ≤
        (C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 (x - c) * r) *
          ∫ y : ℝ, |b y| := by
      simpa only [mul_assoc] using hbase
    _ ≤ (C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 (x - c) * r) *
          (M * (2 * r)) :=
      mul_le_mul_of_nonneg_left hmass hfactor
    _ = (2 * C) * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 (x - c) *
          M * r ^ 2 := by ring

/-- A source-ready mass-coefficient form: if the bad-fiber `L¹` mass is at
most `A r`, cancellation supplies an `A r²` tail factor. -/
theorem abs_integral_activeModelKernel_badFiber_of_interval_radius_mass_bound :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i j : Fin 3) (u : E3) (s x c r A : ℝ)
      (b : ℝ → ℝ), 0 < s → 0 ≤ r → Integrable b →
      Integrable (fun y ↦ b y *
        kernelDilate (activeModelKernel i j u) s (x - y)) →
      (∫ y : ℝ, b y) = 0 →
      (∀ y : ℝ, b y ≠ 0 → |y - c| ≤ r) →
      2 * r ≤ |x - c| →
      (∫ y : ℝ, |b y|) ≤ A * r →
      |∫ y : ℝ, b y *
          kernelDilate (activeModelKernel i j u) s (x - y)| ≤
        C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 (x - c) *
          A * r ^ 2 := by
  rcases abs_integral_activeModelKernel_badFiber_of_interval_radius with
    ⟨C, hC, hcancel⟩
  refine ⟨C, hC, ?_⟩
  intro i j u s x c r A b hs hr hb hmain hzero hsupport hfar hmass
  have hbase := hcancel i j u s x c r b hs hr hb hmain hzero hsupport hfar
  have hfactor : 0 ≤ C * sourceWeight u ^ 10 * s⁻¹ *
      bracketKernelAt s 0 (x - c) * r := by
    exact mul_nonneg
      (mul_nonneg
        (mul_nonneg
          (mul_nonneg hC (pow_nonneg (sourceWeight_nonneg u) _))
          (inv_pos.mpr hs).le)
        (bracketKernelAt_pos hs).le)
      hr
  calc
    |∫ y : ℝ, b y * kernelDilate (activeModelKernel i j u) s (x - y)| ≤
        (C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 (x - c) * r) *
          ∫ y : ℝ, |b y| := by
      simpa only [mul_assoc] using hbase
    _ ≤ (C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 (x - c) * r) *
          (A * r) :=
      mul_le_mul_of_nonneg_left hmass hfactor
    _ = C * sourceWeight u ^ 10 * s⁻¹ * bracketKernelAt s 0 (x - c) *
          A * r ^ 2 := by ring

/-! ### Finite bad-fiber tail summation -/

/-- The dimension-one interval tail appearing after the scale integration in
the source bad-fiber argument. -/
noncomputable def intervalTail (c r x : ℝ) : ℝ :=
  (1 + |(x - c) / r|) ^ (-2 : ℝ)

/-- The fixed, finite mass of the unit interval tail. The source only uses
that this universal constant is finite; its elementary exact value is not
needed for the finite-tail summation interface. -/
noncomputable def intervalTailMass : ℝ :=
  ∫ x : ℝ, (1 + |x|) ^ (-2 : ℝ)

theorem integrable_unit_intervalTail :
    Integrable (fun x : ℝ ↦ (1 + |x|) ^ (-2 : ℝ)) := by
  simpa only [Real.norm_eq_abs] using
    (integrable_one_add_norm (E := ℝ) (μ := volume) (r := (2 : ℝ)) (by norm_num))

theorem intervalTail_nonneg (c r x : ℝ) :
    0 ≤ intervalTail c r x := by
  unfold intervalTail
  positivity

/-- Every positive-radius interval tail is integrable. -/
theorem integrable_intervalTail (c r : ℝ) (hr : 0 < r) :
    Integrable (intervalTail c r) := by
  unfold intervalTail
  exact (integrable_unit_intervalTail.comp_div hr.ne').comp_sub_right c

/-- Translation and positive dilation scale the interval-tail mass by its
radius. -/
theorem integral_intervalTail (c r : ℝ) (hr : 0 < r) :
    ∫ x : ℝ, intervalTail c r x = r * intervalTailMass := by
  unfold intervalTail intervalTailMass
  rw [integral_sub_right_eq_self (μ := volume)
    (fun x : ℝ ↦ (1 + |x / r|) ^ (-2 : ℝ)) c]
  let G : ℝ → ℝ := fun x ↦ (1 + |x|) ^ (-2 : ℝ)
  change (∫ x : ℝ, G (x / r)) = r * ∫ x : ℝ, G x
  calc
    (∫ x : ℝ, G (x / r)) = |r| • ∫ x : ℝ, G x :=
      Measure.integral_comp_div G r
    _ = r * ∫ x : ℝ, G x := by
      rw [abs_of_pos hr]
      rfl

/-- A finite sum of interval tails has exactly the sum of their scaled
universal masses. No overlap hypothesis is needed at this `L¹` stage. -/
theorem integral_finset_intervalTails
    {ι : Type*} (S : Finset ι) (c r : ι → ℝ)
    (hr : ∀ i ∈ S, 0 < r i) :
    (∫ x : ℝ, ∑ i ∈ S, intervalTail (c i) (r i) x) =
      intervalTailMass * ∑ i ∈ S, r i := by
  rw [integral_finsetSum S (fun i hi ↦ integrable_intervalTail (c i) (r i)
    (hr i hi))]
  calc
    (∑ i ∈ S, ∫ x : ℝ, intervalTail (c i) (r i) x) =
        ∑ i ∈ S, r i * intervalTailMass := by
      apply Finset.sum_congr rfl
      intro i hi
      rw [integral_intervalTail (c i) (r i) (hr i hi)]
    _ = intervalTailMass * ∑ i ∈ S, r i := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i hi
      ring

/-- The finite `L¹` tail estimate in the exact form consumed by the
one-fiber bad-part argument. -/
theorem integral_finset_intervalTails_le
    {ι : Type*} (S : Finset ι) (c r : ι → ℝ)
    (hr : ∀ i ∈ S, 0 < r i) :
    (∫ x : ℝ, ∑ i ∈ S, intervalTail (c i) (r i) x) ≤
      intervalTailMass * ∑ i ∈ S, r i := by
  exact le_of_eq (integral_finset_intervalTails S c r hr)

/-- The quadratic size-over-distance factor produced by the scale integral is
pointwise bounded by the source interval tail outside the doubled interval.
Here `r` is the interval radius, so the tail has scale `2 * r`, its length. -/
theorem radius_sq_div_distance_sq_le_intervalTail_of_double_far
    {c r x : ℝ} (hr : 0 < r) (hfar : 2 * r ≤ |x - c|) :
    r ^ 2 / |x - c| ^ 2 ≤ intervalTail c (2 * r) x := by
  have hden : 0 < |x - c| := by
    exact lt_of_lt_of_le (by nlinarith) hfar
  have htwor : 0 < 2 * r := by positivity
  have hbase : 0 < 1 + |x - c| / (2 * r) := by positivity
  have hratio : r / |x - c| ≤ (1 + |x - c| / (2 * r))⁻¹ := by
    rw [inv_eq_one_div]
    apply (div_le_div_iff₀ hden hbase).mpr
    field_simp [hr.ne']
    nlinarith
  have hratio0 : 0 ≤ r / |x - c| := div_nonneg hr.le hden.le
  have hsquare : (r / |x - c|) ^ 2 ≤
      ((1 + |x - c| / (2 * r))⁻¹) ^ 2 :=
    pow_le_pow_left₀ hratio0 hratio 2
  unfold intervalTail
  rw [abs_div, abs_of_pos htwor]
  calc
    r ^ 2 / |x - c| ^ 2 = (r / |x - c|) ^ 2 := by field_simp
    _ ≤ ((1 + |x - c| / (2 * r))⁻¹) ^ 2 := hsquare
    _ = (1 + |x - c| / (2 * r)) ^ (-2 : ℝ) := by
      calc
        ((1 + |x - c| / (2 * r))⁻¹) ^ 2 =
            ((1 + |x - c| / (2 * r)) ^ (2 : ℕ))⁻¹ := inv_pow _ 2
        _ = ((1 + |x - c| / (2 * r)) ^ (2 : ℝ))⁻¹ :=
          congrArg Inv.inv (Real.rpow_natCast _ 2).symm
        _ = (1 + |x - c| / (2 * r)) ^ (-2 : ℝ) :=
          (Real.rpow_neg hbase.le (2 : ℝ)).symm

/-- On the common exterior of finitely many doubled bad intervals, the sum
of the quadratic distance factors is dominated by the source interval-tail
sum. -/
theorem finset_quadratic_badFiberTail_le_intervalTail_sum
    {ι : Type*} (S : Finset ι) (c r : ι → ℝ) (x : ℝ)
    (hr : ∀ i ∈ S, 0 < r i)
    (hfar : ∀ i ∈ S, 2 * r i ≤ |x - c i|) :
    (∑ i ∈ S, r i ^ 2 / |x - c i| ^ 2) ≤
      ∑ i ∈ S, intervalTail (c i) (2 * r i) x := by
  apply Finset.sum_le_sum
  intro i hi
  exact radius_sq_div_distance_sq_le_intervalTail_of_double_far
    (hr i hi) (hfar i hi)

theorem intervalTailMass_nonneg : 0 ≤ intervalTailMass := by
  unfold intervalTailMass
  exact integral_nonneg fun x ↦ by positivity

/-- The finite tail sum at the doubled radii has total `L¹` mass exactly
twice the unit-tail mass times the sum of the original interval radii. -/
theorem integral_finset_double_intervalTails
    {ι : Type*} (S : Finset ι) (c r : ι → ℝ)
    (hr : ∀ i ∈ S, 0 < r i) :
    (∫ x : ℝ, ∑ i ∈ S, intervalTail (c i) (2 * r i) x) =
      (2 * intervalTailMass) * ∑ i ∈ S, r i := by
  have hdouble : ∀ i ∈ S, 0 < 2 * r i := by
    intro i hi
    nlinarith [hr i hi]
  rw [integral_finset_intervalTails S c (fun i ↦ 2 * r i) hdouble]
  rw [← Finset.mul_sum]
  ring

/-- The finite bad-fiber tail sum is controlled by any available bound on
the sum of its interval radii. This is the `p = 1` summation step in the
source interval-tail lemma. -/
theorem integral_finset_double_intervalTails_le_of_radius_sum
    {ι : Type*} (S : Finset ι) (c r : ι → ℝ) (A : ℝ)
    (hr : ∀ i ∈ S, 0 < r i)
    (hsum : ∑ i ∈ S, r i ≤ A) :
    (∫ x : ℝ, ∑ i ∈ S, intervalTail (c i) (2 * r i) x) ≤
      (2 * intervalTailMass) * A := by
  rw [integral_finset_double_intervalTails S c r hr]
  exact mul_le_mul_of_nonneg_left hsum
    (mul_nonneg (by norm_num) intervalTailMass_nonneg)

local instance : Fact (0 < (8 : ℝ)) := ⟨by norm_num⟩

namespace ScaleTailInternal

/-! ### Scalar scale-tail integration -/

/-- The elementary shifted power integral needed after the substitution in
the bad-fiber scale tail. -/
theorem scratch_integral_Ioi_one_add_rpow (n : ℝ) (hn : 1 < n) :
    ∫ t : ℝ in Set.Ioi 0, (t + 1) ^ (-n) = (n - 1)⁻¹ := by
  have hd : ∀ x ∈ Set.Ici (0 : ℝ),
      HasDerivAt (fun t : ℝ ↦ (t + 1) ^ ((-n) + 1) / ((-n) + 1))
        ((x + 1) ^ (-n)) x := by
    intro x hx
    convert! (((hasDerivAt_id x).add_const 1).rpow_const _).div_const _ using 1
    · simp [show (-n) + 1 ≠ 0 by linarith]
    · left
      simp only [id_eq]
      linarith [Set.mem_Ici.mp hx]
  have hint : IntegrableOn (fun t : ℝ ↦ (t + 1) ^ (-n)) (Set.Ioi 0) := by
    simpa only using
      (integrableOn_add_rpow_Ioi_of_lt (a := -n) (c := 0) (m := 1)
        (by linarith) (by norm_num))
  have ht : Tendsto (fun t : ℝ ↦ (t + 1) ^ ((-n) + 1) / ((-n) + 1))
      atTop (nhds (0 / ((-n) + 1))) := by
    rw [← neg_neg ((-n) + 1)]
    exact (tendsto_rpow_neg_atTop (by linarith : 0 < -((-n) + 1))).comp
      (tendsto_atTop_add_const_right _ 1 tendsto_id) |>.div_const _
  have hmain := integral_Ioi_of_hasDerivAt_of_tendsto' hd hint ht
  rw [hmain]
  simp only [zero_div, zero_add, Real.one_rpow, zero_sub]
  rw [one_div, ← inv_neg]
  ring

/-- The beta-type scalar integral in the source scale calculation. -/
theorem scratch_integral_Ioi_weighted_one_add_tail :
    ∫ y : ℝ in Set.Ioi 0, y * (y + 1) ^ (-10 : ℝ) = 1 / 72 := by
  have h9 : IntegrableOn (fun y : ℝ ↦ (y + 1) ^ (-9 : ℝ)) (Set.Ioi 0) := by
    simpa using
      (integrableOn_add_rpow_Ioi_of_lt (a := (-9 : ℝ)) (c := 0) (m := 1)
        (by norm_num) (by norm_num))
  have h10 : IntegrableOn (fun y : ℝ ↦ (y + 1) ^ (-10 : ℝ)) (Set.Ioi 0) := by
    simpa using
      (integrableOn_add_rpow_Ioi_of_lt (a := (-10 : ℝ)) (c := 0) (m := 1)
        (by norm_num) (by norm_num))
  have hident : ∀ y ∈ Set.Ioi (0 : ℝ),
      y * (y + 1) ^ (-10 : ℝ) =
        (y + 1) ^ (-9 : ℝ) - (y + 1) ^ (-10 : ℝ) := by
    intro y hy
    have hy1 : 0 < y + 1 := by linarith [Set.mem_Ioi.mp hy]
    rw [Real.rpow_neg hy1.le, Real.rpow_neg hy1.le]
    field_simp
    calc
      y * (y + 1) ^ (9 : ℝ) = ((y + 1) - 1) * (y + 1) ^ (9 : ℝ) := by ring
      _ = (y + 1) ^ (10 : ℝ) - (y + 1) ^ (9 : ℝ) := by
        rw [show (10 : ℝ) = 9 + 1 by norm_num, Real.rpow_add hy1,
          Real.rpow_one]
        ring
  calc
    (∫ y : ℝ in Set.Ioi 0, y * (y + 1) ^ (-10 : ℝ)) =
        ∫ y : ℝ in Set.Ioi 0,
          ((y + 1) ^ (-9 : ℝ) - (y + 1) ^ (-10 : ℝ)) := by
      apply MeasureTheory.setIntegral_congr_fun measurableSet_Ioi
      intro y hy
      exact hident y hy
    _ = (∫ y : ℝ in Set.Ioi 0, (y + 1) ^ (-9 : ℝ)) -
        ∫ y : ℝ in Set.Ioi 0, (y + 1) ^ (-10 : ℝ) := by
      exact MeasureTheory.integral_sub h9 h10
    _ = 1 / 72 := by
      rw [scratch_integral_Ioi_one_add_rpow 9 (by norm_num),
        scratch_integral_Ioi_one_add_rpow 10 (by norm_num)]
      norm_num

/-- Scaling the beta-type tail supplies the distance-squared decay produced
by the bad-fiber scale integration. -/
theorem scratch_integral_Ioi_scaled_weighted_one_add_tail (d : ℝ) (hd : 0 < d) :
    ∫ x : ℝ in Set.Ioi 0, x * (1 + d * x) ^ (-10 : ℝ) = d⁻¹ ^ 2 * (1 / 72) := by
  let g : ℝ → ℝ := fun y ↦ y * (y + 1) ^ (-10 : ℝ)
  have hcomp := MeasureTheory.integral_comp_mul_left_Ioi g 0 hd
  have hfun : (fun x : ℝ ↦ g (d * x)) =
      fun x ↦ d * (x * (1 + d * x) ^ (-10 : ℝ)) := by
    funext x
    dsimp only [g]
    have hbase : d * x + 1 = 1 + d * x := by ring
    rw [hbase]
    ring
  have hgint : ∫ x : ℝ in Set.Ioi (d * 0), g x = 1 / 72 := by
    simp only [mul_zero, g]
    exact scratch_integral_Ioi_weighted_one_add_tail
  rw [hfun, integral_const_mul, hgint] at hcomp
  have hcomp' : d * (∫ x : ℝ in Set.Ioi 0,
      x * (1 + d * x) ^ (-10 : ℝ)) = d⁻¹ * (1 / 72) := by
    simpa only [smul_eq_mul] using hcomp
  calc
    (∫ x : ℝ in Set.Ioi 0, x * (1 + d * x) ^ (-10 : ℝ)) =
        d⁻¹ * (d * (∫ x : ℝ in Set.Ioi 0,
          x * (1 + d * x) ^ (-10 : ℝ))) := by
      symm
      rw [← mul_assoc, inv_mul_cancel₀ hd.ne', one_mul]
    _ = d⁻¹ * (d⁻¹ * (1 / 72)) := by rw [hcomp']
    _ = d⁻¹ ^ 2 * (1 / 72) := by ring

/-- The exact scalar scale integral in the bad-fiber calculation. The
substitution is `x = t^{-α}` and its Jacobian is kept explicit. -/
theorem scratch_integral_Ioi_scale_badFiber_tail
    (α d : ℝ) (hα : 0 < α) (hd : 0 < d) :
    (∫ t : ℝ in Set.Ioi 0,
      t ^ (-2 * α) * (1 + d * t ^ (-α)) ^ (-10 : ℝ) * t⁻¹) =
      α⁻¹ * d⁻¹ ^ 2 * (1 / 72) := by
  let g : ℝ → ℝ := fun x ↦ α⁻¹ * (x * (1 + d * x) ^ (-10 : ℝ))
  have hchange := MeasureTheory.integral_comp_rpow_Ioi g
    (show (-α) ≠ 0 by linarith)
  have hleft :
      (∫ t : ℝ in Set.Ioi 0,
        (|(-α)| * t ^ ((-α) - 1)) • g (t ^ (-α))) =
        ∫ t : ℝ in Set.Ioi 0,
          t ^ (-2 * α) * (1 + d * t ^ (-α)) ^ (-10 : ℝ) * t⁻¹ := by
    apply MeasureTheory.setIntegral_congr_fun measurableSet_Ioi
    intro t ht
    have ht0 : 0 < t := Set.mem_Ioi.mp ht
    dsimp only [g]
    rw [abs_neg, abs_of_pos hα, smul_eq_mul]
    calc
      (α * t ^ ((-α) - 1)) *
          (α⁻¹ * (t ^ (-α) * (1 + d * t ^ (-α)) ^ (-10 : ℝ))) =
          (α * α⁻¹) * (t ^ ((-α) - 1) * t ^ (-α)) *
            (1 + d * t ^ (-α)) ^ (-10 : ℝ) := by ring
      _ = t ^ (((-α) - 1) + (-α)) *
            (1 + d * t ^ (-α)) ^ (-10 : ℝ) := by
          rw [mul_inv_cancel₀ hα.ne', one_mul, ← Real.rpow_add ht0]
      _ = t ^ (-2 * α) * (1 + d * t ^ (-α)) ^ (-10 : ℝ) * t⁻¹ := by
          rw [show ((-α) - 1) + (-α) = (-2 * α) + (-1 : ℝ) by ring,
            Real.rpow_add ht0, Real.rpow_neg_one]
          ring
  have hright : (∫ x : ℝ in Set.Ioi 0, g x) =
      α⁻¹ * (d⁻¹ ^ 2 * (1 / 72)) := by
    dsimp only [g]
    rw [integral_const_mul, scratch_integral_Ioi_scaled_weighted_one_add_tail d hd]
  calc
    (∫ t : ℝ in Set.Ioi 0,
      t ^ (-2 * α) * (1 + d * t ^ (-α)) ^ (-10 : ℝ) * t⁻¹) =
        ∫ t : ℝ in Set.Ioi 0,
          (|(-α)| * t ^ ((-α) - 1)) • g (t ^ (-α)) := hleft.symm
    _ = ∫ x : ℝ in Set.Ioi 0, g x := hchange
    _ = α⁻¹ * d⁻¹ ^ 2 * (1 / 72) := by
      rw [hright]
      ring

/-- The source bracket kernel, with its outer cancellation derivative factor,
is literally the scalar scale-tail integrand. -/
theorem scratch_scale_bracketKernelAt_eq_badFiber_tail
    (t α d : ℝ) (ht : 0 < t) :
    (t ^ α)⁻¹ * bracketKernelAt (t ^ α) 0 d =
      t ^ (-2 * α) * (1 + |d| * t ^ (-α)) ^ (-10 : ℝ) := by
  have hs : 0 < t ^ α := Real.rpow_pos_of_pos ht _
  unfold bracketKernelAt kernelAt kernelDilate bracketKernel
  simp only [sub_zero, smul_eq_mul, abs_div, abs_of_pos hs]
  rw [← Real.rpow_neg ht.le]
  calc
    t ^ (-α) * (t ^ (-α) *
        (1 + |d| / t ^ α) ^ (-10 : ℝ)) =
        (t ^ (-α) * t ^ (-α)) * (1 + |d| / t ^ α) ^ (-10 : ℝ) := by ring
    _ = t ^ ((-α) + (-α)) * (1 + |d| / t ^ α) ^ (-10 : ℝ) := by
      rw [← Real.rpow_add ht]
    _ = t ^ (-2 * α) * (1 + |d| * t ^ (-α)) ^ (-10 : ℝ) := by
      rw [show (-α) + (-α) = -2 * α by ring]
      congr 2
      rw [div_eq_mul_inv, ← Real.rpow_neg ht.le]

/-- Integrating the derivative-sized bracket majorant over all scales gives
the exact inverse-square distance tail used outside a doubled bad interval. -/
theorem scratch_integral_Ioi_scale_bracketKernelAt
    (α d : ℝ) (hα : 0 < α) (hd : 0 < |d|) :
    (∫ t : ℝ in Set.Ioi 0,
      (t ^ α)⁻¹ * bracketKernelAt (t ^ α) 0 d * t⁻¹) =
      α⁻¹ * |d|⁻¹ ^ 2 * (1 / 72) := by
  calc
    (∫ t : ℝ in Set.Ioi 0,
      (t ^ α)⁻¹ * bracketKernelAt (t ^ α) 0 d * t⁻¹) =
        ∫ t : ℝ in Set.Ioi 0,
          t ^ (-2 * α) * (1 + |d| * t ^ (-α)) ^ (-10 : ℝ) * t⁻¹ := by
      apply MeasureTheory.setIntegral_congr_fun measurableSet_Ioi
      intro t ht
      change (t ^ α)⁻¹ * bracketKernelAt (t ^ α) 0 d * t⁻¹ =
        t ^ (-2 * α) * (1 + |d| * t ^ (-α)) ^ (-10 : ℝ) * t⁻¹
      rw [scratch_scale_bracketKernelAt_eq_badFiber_tail t α d (Set.mem_Ioi.mp ht)]
    _ = α⁻¹ * |d|⁻¹ ^ 2 * (1 / 72) :=
      scratch_integral_Ioi_scale_badFiber_tail α |d| hα hd

/-- The literal scale bracket majorant is integrable on the positive scale
half-line. This removes the remaining scalar side condition from the
scale-integrated bad-fiber estimate. -/
theorem scratch_integrableOn_Ioi_scale_bracketKernelAt
    (α d : ℝ) (hα : 0 < α) (hd : 0 < |d|) :
    IntegrableOn (fun t : ℝ ↦
      (t ^ α)⁻¹ * bracketKernelAt (t ^ α) 0 d * t⁻¹) (Set.Ioi 0) := by
  let G : ℝ → ℝ := fun y ↦ y * (y + 1) ^ (-10 : ℝ)
  have hG₉ : IntegrableOn (fun y : ℝ ↦ (y + 1) ^ (-9 : ℝ))
      (Set.Ioi 0) := by
    simpa using
      (integrableOn_add_rpow_Ioi_of_lt (a := (-9 : ℝ)) (c := 0) (m := 1)
        (by norm_num) (by norm_num))
  have hG₁₀ : IntegrableOn (fun y : ℝ ↦ (y + 1) ^ (-10 : ℝ))
      (Set.Ioi 0) := by
    simpa using
      (integrableOn_add_rpow_Ioi_of_lt (a := (-10 : ℝ)) (c := 0) (m := 1)
        (by norm_num) (by norm_num))
  have hG_ident : ∀ y ∈ Set.Ioi (0 : ℝ),
      G y = (y + 1) ^ (-9 : ℝ) - (y + 1) ^ (-10 : ℝ) := by
    intro y hy
    dsimp only [G]
    have hy1 : 0 < y + 1 := by linarith [Set.mem_Ioi.mp hy]
    rw [Real.rpow_neg hy1.le, Real.rpow_neg hy1.le]
    field_simp
    calc
      y * (y + 1) ^ (9 : ℝ) = ((y + 1) - 1) * (y + 1) ^ (9 : ℝ) := by ring
      _ = (y + 1) ^ (10 : ℝ) - (y + 1) ^ (9 : ℝ) := by
        rw [show (10 : ℝ) = 9 + 1 by norm_num, Real.rpow_add hy1,
          Real.rpow_one]
        ring
  have hG : IntegrableOn G (Set.Ioi 0) := by
    refine (hG₉.sub hG₁₀).congr_fun ?_ measurableSet_Ioi
    intro y hy
    exact (hG_ident y hy).symm
  have hscaled_raw : IntegrableOn (fun y : ℝ ↦ G (|d| * y))
      (Set.Ioi 0) :=
    (integrableOn_Ioi_comp_mul_left_iff G 0 hd).mpr (by
      simpa only [mul_zero] using hG)
  have hscaled : IntegrableOn (fun y : ℝ ↦
      y * (1 + |d| * y) ^ (-10 : ℝ)) (Set.Ioi 0) := by
    refine IntegrableOn.congr_fun (hscaled_raw.const_mul |d|⁻¹) ?_ measurableSet_Ioi
    intro y hy
    dsimp only [G]
    have hd0 : |d| ≠ 0 := ne_of_gt hd
    have hbase : |d| * y + 1 = 1 + |d| * y := by ring
    rw [hbase]
    field_simp
  let g : ℝ → ℝ := fun y ↦ α⁻¹ *
    (y * (1 + |d| * y) ^ (-10 : ℝ))
  have hg : IntegrableOn g (Set.Ioi 0) := by
    exact hscaled.const_mul α⁻¹
  have hchange : IntegrableOn (fun t : ℝ ↦
      (|(-α)| * t ^ ((-α) - 1)) • g (t ^ (-α))) (Set.Ioi 0) :=
    (integrableOn_Ioi_comp_rpow_iff g (show (-α) ≠ 0 by linarith)).mpr hg
  refine hchange.congr_fun ?_ measurableSet_Ioi
  intro t ht
  have ht0 : 0 < t := Set.mem_Ioi.mp ht
  dsimp only [g]
  rw [scratch_scale_bracketKernelAt_eq_badFiber_tail t α d ht0,
    abs_neg, abs_of_pos hα, smul_eq_mul]
  calc
    (α * t ^ ((-α) - 1)) *
        (α⁻¹ * (t ^ (-α) * (1 + |d| * t ^ (-α)) ^ (-10 : ℝ))) =
        (α * α⁻¹) * (t ^ ((-α) - 1) * t ^ (-α)) *
          (1 + |d| * t ^ (-α)) ^ (-10 : ℝ) := by ring
    _ = t ^ (((-α) - 1) + (-α)) *
          (1 + |d| * t ^ (-α)) ^ (-10 : ℝ) := by
      rw [mul_inv_cancel₀ hα.ne', one_mul, ← Real.rpow_add ht0]
    _ = t ^ (-2 * α) * (1 + |d| * t ^ (-α)) ^ (-10 : ℝ) * t⁻¹ := by
      rw [show ((-α) - 1) + (-α) = (-2 * α) + (-1 : ℝ) by ring,
        Real.rpow_add ht0, Real.rpow_neg_one]
      ring

/-- Integrating the canonical interval-radius cancellation bound across the
source scale measure gives the exact inverse-square bad-fiber tail. The
explicit integrability hypothesis is the only remaining Fubini-facing
interface at this point. -/
theorem scratch_integral_badFiber_scaleTail_of_interval_radius_mass_bound :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i j : Fin 3) (u : E3) (α x c r A : ℝ)
      (b : ℝ → ℝ), 0 < α → 0 < r → Integrable b →
      (∀ t : ℝ, t ∈ Set.Ioi 0 → Integrable (fun y ↦ b y *
        kernelDilate (activeModelKernel i j u) (t ^ α) (x - y))) →
      (∫ y : ℝ, b y) = 0 →
      (∀ y : ℝ, b y ≠ 0 → |y - c| ≤ r) →
      2 * r ≤ |x - c| →
      (∫ y : ℝ, |b y|) ≤ A * r →
      IntegrableOn (fun t : ℝ ↦
        (t ^ α)⁻¹ * bracketKernelAt (t ^ α) 0 (x - c) * t⁻¹) (Set.Ioi 0) →
      (∫ t : ℝ in Set.Ioi 0,
        |∫ y : ℝ, b y *
          kernelDilate (activeModelKernel i j u) (t ^ α) (x - y)| * t⁻¹) ≤
        C * sourceWeight u ^ 10 * A * r ^ 2 *
          (α⁻¹ * |x - c|⁻¹ ^ 2 * (1 / 72)) := by
  rcases abs_integral_activeModelKernel_badFiber_of_interval_radius_mass_bound with
    ⟨C, hC, hcancel⟩
  refine ⟨C, hC, ?_⟩
  intro i j u α x c r A b hα hr hb hkernel hzero hsupport hfar hmass hmajor
  have hd : 0 < |x - c| := by
    exact lt_of_lt_of_le (by nlinarith) hfar
  let Q : ℝ := C * sourceWeight u ^ 10 * A * r ^ 2
  let K : ℝ → ℝ := fun t ↦
    (t ^ α)⁻¹ * bracketKernelAt (t ^ α) 0 (x - c) * t⁻¹
  have hpoint (t : ℝ) (ht : t ∈ Set.Ioi 0) :
      |∫ y : ℝ, b y *
        kernelDilate (activeModelKernel i j u) (t ^ α) (x - y)| * t⁻¹ ≤
        Q * K t := by
    have hs : 0 < t ^ α := Real.rpow_pos_of_pos (Set.mem_Ioi.mp ht) _
    have hbase := hcancel i j u (t ^ α) x c r A b hs hr.le hb
      (hkernel t ht) hzero hsupport hfar hmass
    calc
      |∫ y : ℝ, b y *
          kernelDilate (activeModelKernel i j u) (t ^ α) (x - y)| * t⁻¹ ≤
          (C * sourceWeight u ^ 10 * (t ^ α)⁻¹ *
            bracketKernelAt (t ^ α) 0 (x - c) * A * r ^ 2) * t⁻¹ :=
        mul_le_mul_of_nonneg_right hbase (inv_nonneg.mpr (Set.mem_Ioi.mp ht).le)
      _ = Q * K t := by
        dsimp only [Q, K]
        ring
  have hmono :
      (∫ t : ℝ in Set.Ioi 0,
        |∫ y : ℝ, b y *
          kernelDilate (activeModelKernel i j u) (t ^ α) (x - y)| * t⁻¹) ≤
        ∫ t : ℝ in Set.Ioi 0, Q * K t := by
    apply integral_mono_of_nonneg
    · filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
      exact mul_nonneg (abs_nonneg _) (inv_nonneg.mpr (Set.mem_Ioi.mp ht).le)
    · change Integrable (fun t ↦ Q * K t) (volume.restrict (Set.Ioi 0))
      exact hmajor.const_mul Q
    · filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
      exact hpoint t ht
  calc
    (∫ t : ℝ in Set.Ioi 0,
      |∫ y : ℝ, b y *
        kernelDilate (activeModelKernel i j u) (t ^ α) (x - y)| * t⁻¹) ≤
        ∫ t : ℝ in Set.Ioi 0, Q * K t := hmono
    _ = Q * ∫ t : ℝ in Set.Ioi 0, K t := by rw [integral_const_mul]
    _ = Q * (α⁻¹ * |x - c|⁻¹ ^ 2 * (1 / 72)) := by
      rw [scratch_integral_Ioi_scale_bracketKernelAt α (x - c) hα hd]
    _ = C * sourceWeight u ^ 10 * A * r ^ 2 *
        (α⁻¹ * |x - c|⁻¹ ^ 2 * (1 / 72)) := by
      rfl

/-- Outside the doubled interval, the scale-integrated cancellation term is
controlled directly by the source interval tail. This is the pointwise
bad-coordinate input to the subsequent three-factor Hölder step. -/
theorem scratch_integral_badFiber_scaleTail_le_intervalTail :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i j : Fin 3) (u : E3) (α x c r A : ℝ)
      (b : ℝ → ℝ), 0 < α → 0 < r → Integrable b →
      (∀ t : ℝ, t ∈ Set.Ioi 0 → Integrable (fun y ↦ b y *
        kernelDilate (activeModelKernel i j u) (t ^ α) (x - y))) →
      (∫ y : ℝ, b y) = 0 →
      (∀ y : ℝ, b y ≠ 0 → |y - c| ≤ r) →
      2 * r ≤ |x - c| →
      (∫ y : ℝ, |b y|) ≤ A * r →
      IntegrableOn (fun t : ℝ ↦
        (t ^ α)⁻¹ * bracketKernelAt (t ^ α) 0 (x - c) * t⁻¹) (Set.Ioi 0) →
      (∫ t : ℝ in Set.Ioi 0,
        |∫ y : ℝ, b y *
          kernelDilate (activeModelKernel i j u) (t ^ α) (x - y)| * t⁻¹) ≤
        C * sourceWeight u ^ 10 * A * (α⁻¹ * (1 / 72)) *
          intervalTail c (2 * r) x := by
  rcases scratch_integral_badFiber_scaleTail_of_interval_radius_mass_bound with
    ⟨C, hC, hscale⟩
  refine ⟨C, hC, ?_⟩
  intro i j u α x c r A b hα hr hb hkernel hzero hsupport hfar hmass hmajor
  have hd : 0 < |x - c| := by
    exact lt_of_lt_of_le (by nlinarith) hfar
  have hA : 0 ≤ A := by
    have hAr : 0 ≤ A * r :=
      le_trans (integral_nonneg fun y ↦ abs_nonneg (b y)) hmass
    nlinarith
  have htail := radius_sq_div_distance_sq_le_intervalTail_of_double_far hr hfar
  have hbase := hscale i j u α x c r A b hα hr hb hkernel hzero hsupport hfar
    hmass hmajor
  have hfactor : 0 ≤ C * sourceWeight u ^ 10 * A * (α⁻¹ * (1 / 72)) := by
    positivity
  have hinv : |x - c|⁻¹ ^ 2 = 1 / |x - c| ^ 2 := by
    field_simp [hd.ne']
  calc
    (∫ t : ℝ in Set.Ioi 0,
      |∫ y : ℝ, b y *
        kernelDilate (activeModelKernel i j u) (t ^ α) (x - y)| * t⁻¹) ≤
        C * sourceWeight u ^ 10 * A * r ^ 2 *
          (α⁻¹ * |x - c|⁻¹ ^ 2 * (1 / 72)) := hbase
    _ = (C * sourceWeight u ^ 10 * A * (α⁻¹ * (1 / 72))) *
        (r ^ 2 / |x - c| ^ 2) := by
      rw [hinv]
      field_simp [hd.ne']
    _ ≤ (C * sourceWeight u ^ 10 * A * (α⁻¹ * (1 / 72))) *
        intervalTail c (2 * r) x :=
      mul_le_mul_of_nonneg_left htail hfactor

/-- The scale-majorant integrability in the preceding interval-tail estimate
is automatic; this is the literal no-extra-hypothesis scalar terminal used
by a finite bad-fiber sum. -/
theorem scratch_integral_badFiber_scaleTail_of_interval_radius_mass_bound_unconditional :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i j : Fin 3) (u : E3) (α x c r A : ℝ)
      (b : ℝ → ℝ), 0 < α → 0 < r → Integrable b →
      (∀ t : ℝ, t ∈ Set.Ioi 0 → Integrable (fun y ↦ b y *
        kernelDilate (activeModelKernel i j u) (t ^ α) (x - y))) →
      (∫ y : ℝ, b y) = 0 →
      (∀ y : ℝ, b y ≠ 0 → |y - c| ≤ r) →
      2 * r ≤ |x - c| →
      (∫ y : ℝ, |b y|) ≤ A * r →
      (∫ t : ℝ in Set.Ioi 0,
        |∫ y : ℝ, b y *
          kernelDilate (activeModelKernel i j u) (t ^ α) (x - y)| * t⁻¹) ≤
        C * sourceWeight u ^ 10 * A * r ^ 2 *
          (α⁻¹ * |x - c|⁻¹ ^ 2 * (1 / 72)) := by
  rcases scratch_integral_badFiber_scaleTail_of_interval_radius_mass_bound with
    ⟨C, hC, hmain⟩
  refine ⟨C, hC, ?_⟩
  intro i j u α x c r A b hα hr hb hkernel hzero hsupport hfar hmass
  exact hmain i j u α x c r A b hα hr hb hkernel hzero hsupport hfar hmass
    (scratch_integrableOn_Ioi_scale_bracketKernelAt α (x - c) hα (by
      exact lt_of_lt_of_le (by nlinarith) hfar))

/-- Outside a doubled bad interval, the scale-integrated cancellation tail
has the source interval-tail bound with no auxiliary integrability premise. -/
theorem scratch_integral_badFiber_scaleTail_le_intervalTail_unconditional :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (i j : Fin 3) (u : E3) (α x c r A : ℝ)
      (b : ℝ → ℝ), 0 < α → 0 < r → Integrable b →
      (∀ t : ℝ, t ∈ Set.Ioi 0 → Integrable (fun y ↦ b y *
        kernelDilate (activeModelKernel i j u) (t ^ α) (x - y))) →
      (∫ y : ℝ, b y) = 0 →
      (∀ y : ℝ, b y ≠ 0 → |y - c| ≤ r) →
      2 * r ≤ |x - c| →
      (∫ y : ℝ, |b y|) ≤ A * r →
      (∫ t : ℝ in Set.Ioi 0,
        |∫ y : ℝ, b y *
          kernelDilate (activeModelKernel i j u) (t ^ α) (x - y)| * t⁻¹) ≤
        C * sourceWeight u ^ 10 * A * (α⁻¹ * (1 / 72)) *
          intervalTail c (2 * r) x := by
  rcases scratch_integral_badFiber_scaleTail_le_intervalTail with
    ⟨C, hC, hmain⟩
  refine ⟨C, hC, ?_⟩
  intro i j u α x c r A b hα hr hb hkernel hzero hsupport hfar hmass
  exact hmain i j u α x c r A b hα hr hb hkernel hzero hsupport hfar hmass
    (scratch_integrableOn_Ioi_scale_bracketKernelAt α (x - c) hα (by
      exact lt_of_lt_of_le (by nlinarith) hfar))

/-- Summing the literal scale-integrated cancellation estimate over a finite
bad-interval family produces the exact positive interval-tail majorant. The
same mass coefficient `A` is the source `H^(1/p)` factor. -/
theorem scratch_finset_integral_badFiber_scaleTail_le_intervalTail_sum :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ {ι : Type*} (S : Finset ι)
      (i j : Fin 3) (u : E3) (α x A : ℝ) (c r : ι → ℝ)
      (b : ι → ℝ → ℝ), 0 < α →
      (∀ k ∈ S, 0 < r k) →
      (∀ k ∈ S, Integrable (b k)) →
      (∀ k ∈ S, ∀ t : ℝ, t ∈ Set.Ioi 0 → Integrable (fun y ↦ b k y *
        kernelDilate (activeModelKernel i j u) (t ^ α) (x - y))) →
      (∀ k ∈ S, (∫ y : ℝ, b k y) = 0) →
      (∀ k ∈ S, ∀ y : ℝ, b k y ≠ 0 → |y - c k| ≤ r k) →
      (∀ k ∈ S, 2 * r k ≤ |x - c k|) →
      (∀ k ∈ S, (∫ y : ℝ, |b k y|) ≤ A * r k) →
      (∑ k ∈ S, ∫ t : ℝ in Set.Ioi 0,
        |∫ y : ℝ, b k y *
          kernelDilate (activeModelKernel i j u) (t ^ α) (x - y)| * t⁻¹) ≤
        C * sourceWeight u ^ 10 * A * (α⁻¹ * (1 / 72)) *
          ∑ k ∈ S, intervalTail (c k) (2 * r k) x := by
  rcases scratch_integral_badFiber_scaleTail_le_intervalTail_unconditional with
    ⟨C, hC, hmain⟩
  refine ⟨C, hC, ?_⟩
  intro ι S i j u α x A c r b hα hr hb hkernel hzero hsupport hfar hmass
  let K : ℝ := C * sourceWeight u ^ 10 * A * (α⁻¹ * (1 / 72))
  have hterm (k : ι) (hk : k ∈ S) :
      (∫ t : ℝ in Set.Ioi 0,
        |∫ y : ℝ, b k y *
          kernelDilate (activeModelKernel i j u) (t ^ α) (x - y)| * t⁻¹) ≤
        K * intervalTail (c k) (2 * r k) x := by
    simpa only [K] using
      hmain i j u α x (c k) (r k) A (b k) hα (hr k hk) (hb k hk)
        (hkernel k hk) (hzero k hk) (hsupport k hk) (hfar k hk) (hmass k hk)
  calc
    (∑ k ∈ S, ∫ t : ℝ in Set.Ioi 0,
      |∫ y : ℝ, b k y *
        kernelDilate (activeModelKernel i j u) (t ^ α) (x - y)| * t⁻¹) ≤
        ∑ k ∈ S, K * intervalTail (c k) (2 * r k) x := by
      exact Finset.sum_le_sum fun k hk ↦ hterm k hk
    _ = K * ∑ k ∈ S, intervalTail (c k) (2 * r k) x := by
      rw [Finset.mul_sum]


end ScaleTailInternal

namespace FiberTailCutoffInternal

/-- The dimension-one tail in the interval-tail lemma, kept local while the
general `L^p` duality route is developed independently of the sibling scratch. -/
noncomputable def scratchLp_intervalTail (c r x : ℝ) : ℝ :=
  (1 + |(x - c) / r|) ^ (-2 : ℝ)

/-- Moving the center by at most one radius changes the exponent-two tail by
at most the harmless factor four. -/
theorem scratchLp_intervalTail_le_four_intervalTail_of_center_dist
    {c r x y : ℝ} (hr : 0 < r) (hy : |y - c| ≤ r) :
    scratchLp_intervalTail c (2 * r) x ≤
      4 * scratchLp_intervalTail y (2 * r) x := by
  have hs : 0 < 2 * r := by positivity
  have hdist : |x - y| ≤ |x - c| + r := by
    calc
      |x - y| ≤ |x - c| + |c - y| := abs_sub_le x c y
      _ = |x - c| + |y - c| := by rw [abs_sub_comm c y]
      _ ≤ |x - c| + r := by gcongr
  have hdiv : |x - y| / (2 * r) ≤ (|x - c| + r) / (2 * r) :=
    (div_le_div_iff_of_pos_right hs).2 hdist
  have hApos : 0 < 1 + |x - c| / (2 * r) := by positivity
  have hBpos : 0 < 1 + |x - y| / (2 * r) := by positivity
  have hbase : 1 + |x - y| / (2 * r) ≤
      2 * (1 + |x - c| / (2 * r)) := by
    calc
      1 + |x - y| / (2 * r) ≤ 1 + (|x - c| + r) / (2 * r) := by
        gcongr
      _ = 3 / 2 + |x - c| / (2 * r) := by
        field_simp [hs.ne']
        ring
      _ ≤ 2 * (1 + |x - c| / (2 * r)) := by
        have hnonneg : 0 ≤ |x - c| / (2 * r) :=
          div_nonneg (abs_nonneg _) hs.le
        nlinarith
  have hpow : (1 + |x - y| / (2 * r)) ^ 2 ≤
      4 * (1 + |x - c| / (2 * r)) ^ 2 := by
    calc
      (1 + |x - y| / (2 * r)) ^ 2 ≤
          (2 * (1 + |x - c| / (2 * r))) ^ 2 :=
        pow_le_pow_left₀ hBpos.le hbase 2
      _ = 4 * (1 + |x - c| / (2 * r)) ^ 2 := by ring
  have hleftpos : 0 < (1 + |x - y| / (2 * r)) ^ 2 := pow_pos hBpos _
  have hrightpos : 0 < 4 * (1 + |x - c| / (2 * r)) ^ 2 := by positivity
  have hinv : (4 * (1 + |x - c| / (2 * r)) ^ 2)⁻¹ ≤
      ((1 + |x - y| / (2 * r)) ^ 2)⁻¹ :=
    (inv_le_inv₀ hrightpos hleftpos).2 hpow
  have htailc : scratchLp_intervalTail c (2 * r) x =
      ((1 + |x - c| / (2 * r)) ^ 2)⁻¹ := by
    unfold scratchLp_intervalTail
    rw [abs_div, abs_of_pos hs, Real.rpow_neg hApos.le]
    exact congrArg Inv.inv (Real.rpow_natCast (1 + |x - c| / (2 * r)) 2)
  have htaily : scratchLp_intervalTail y (2 * r) x =
      ((1 + |x - y| / (2 * r)) ^ 2)⁻¹ := by
    unfold scratchLp_intervalTail
    rw [abs_div, abs_of_pos hs, Real.rpow_neg hBpos.le]
    exact congrArg Inv.inv (Real.rpow_natCast (1 + |x - y| / (2 * r)) 2)
  rw [htailc, htaily]
  calc
    ((1 + |x - c| / (2 * r)) ^ 2)⁻¹ =
        4 * (4 * (1 + |x - c| / (2 * r)) ^ 2)⁻¹ := by
      field_simp
    _ ≤ 4 * ((1 + |x - y| / (2 * r)) ^ 2)⁻¹ :=
      mul_le_mul_of_nonneg_left hinv (by norm_num)

/-- The exponent-two radial tail needed after the scale integration in the
one-fiber Calderón--Zygmund argument. -/
noncomputable def scratchLp_fiberTailTwo (z : FiberDyadicLine) : ℝ :=
  (1 + ‖z‖) ^ (-2 : ℝ)

/-- The real interval tail is literally the transported fiber tail. The
positive-radius hypothesis is only used to normalize the scalar action. -/
theorem scratchLp_intervalTail_eq_fiberTailTwo (c r x : ℝ) (hr : 0 < r) :
    scratchLp_intervalTail c r x =
      scratchLp_fiberTailTwo
        (r⁻¹ • (realToFiberDyadicLine x - realToFiberDyadicLine c)) := by
  unfold scratchLp_intervalTail scratchLp_fiberTailTwo
  rw [norm_scaled_fiber_sub r c (realToFiberDyadicLine x) hr]
  simp only [Real.rpow_neg_ofNat, Int.reduceNeg, zpow_neg, zpow_ofNat,
    MeasurableEquiv.symm_apply_apply]

theorem scratchLp_fiberTailTwo_nonneg (z : FiberDyadicLine) :
    0 ≤ scratchLp_fiberTailTwo z := by
  unfold scratchLp_fiberTailTwo
  positivity

/-- The scaled translated exponent-two tail is integrable on a fiber. -/
theorem scratchLp_integrable_scaled_fiberTailTwo
    (q : FiberDyadicLine) {r : ℝ} (hr : 0 < r) :
    Integrable (fun y : FiberDyadicLine =>
      scratchLp_fiberTailTwo (r⁻¹ • (y - q))) := by
  have hbase : Integrable scratchLp_fiberTailTwo := by
    unfold scratchLp_fiberTailTwo
    exact integrable_one_add_norm (E := FiberDyadicLine) (μ := volume)
      (r := (2 : ℝ)) (by norm_num)
  exact (hbase.comp_smul (inv_ne_zero hr.ne')).comp_sub_right q

/-- A bounded measurable fiber remains integrable after multiplication by a
scaled exponent-two tail. -/
theorem scratchLp_integrable_weighted_fiberTailTwo
    (G : FiberDyadicBase × FiberDyadicLine → ℂ) (hG : Measurable G)
    (a : ℝ) (hGa : ∀ z, ‖G z‖ ≤ a)
    (q : FiberDyadicBase × FiberDyadicLine) {r : ℝ} (hr : 0 < r) :
    Integrable (fun y : FiberDyadicLine =>
      ‖G (q.1, y)‖ * scratchLp_fiberTailTwo (r⁻¹ • (y - q.2))) := by
  have htail := scratchLp_integrable_scaled_fiberTailTwo q.2 hr
  have htail_meas : Measurable (fun y : FiberDyadicLine =>
      scratchLp_fiberTailTwo (r⁻¹ • (y - q.2))) := by
    unfold scratchLp_fiberTailTwo
    fun_prop
  refine (htail.const_mul a).mono' ?_ ?_
  · exact ((hG.comp (measurable_const.prodMk measurable_id)).norm.mul
      htail_meas).aestronglyMeasurable
  · filter_upwards [] with y
    rw [Real.norm_eq_abs, abs_of_nonneg]
    · exact mul_le_mul_of_nonneg_right (hGa (q.1, y))
        (scratchLp_fiberTailTwo_nonneg _)
    · exact mul_nonneg (norm_nonneg _) (scratchLp_fiberTailTwo_nonneg _)

theorem scratchLp_fiberTailTwo_le_one (z : FiberDyadicLine) :
    scratchLp_fiberTailTwo z ≤ 1 := by
  unfold scratchLp_fiberTailTwo
  exact Real.rpow_le_one_of_one_le_of_nonpos
    (le_add_of_nonneg_right (norm_nonneg _)) (by norm_num)

/-- The dyadic annular decay needed to sum the exponent-two tail against a
fiber maximal function. -/
theorem scratchLp_fiberTailTwo_tail (z : FiberDyadicLine) (m : ℕ)
    (h : (2 : ℝ) ^ m ≤ |‖z‖ - 1|) :
    scratchLp_fiberTailTwo z ≤ (((2 : ℝ)⁻¹) ^ (1 + 1)) ^ m := by
  have hbase : (2 : ℝ) ^ m ≤ 1 + ‖z‖ := by
    by_cases hm : m = 0
    · subst m
      norm_num
    · have hmpos : 0 < m := Nat.pos_of_ne_zero hm
      have hpow_two : 2 ≤ (2 : ℝ) ^ m := by
        calc
          2 = (2 : ℝ) ^ 1 := by norm_num
          _ ≤ (2 : ℝ) ^ m := pow_le_pow_right₀ (by norm_num) (by omega)
      have hsub_nonneg : 0 ≤ ‖z‖ - 1 := by
        by_contra hneg
        have hsubneg : ‖z‖ - 1 < 0 := lt_of_not_ge hneg
        have habs_eq : |‖z‖ - 1| = 1 - ‖z‖ := by
          rw [abs_of_neg hsubneg]
          ring
        have habs_le : |‖z‖ - 1| ≤ 1 := by
          rw [habs_eq]
          linarith [norm_nonneg z]
        nlinarith
      rw [abs_of_nonneg hsub_nonneg] at h
      linarith
  have hdenom : (2 : ℝ) ^ (2 * m) ≤ (1 + ‖z‖) ^ 2 := by
    calc
      (2 : ℝ) ^ (2 * m) = ((2 : ℝ) ^ m) ^ 2 := by
        rw [← pow_mul]
        congr 1
        omega
      _ ≤ (1 + ‖z‖) ^ 2 :=
        pow_le_pow_left₀ (pow_nonneg (by norm_num) _) hbase 2
  have hdenom_pos : 0 < (2 : ℝ) ^ (2 * m) := pow_pos (by norm_num) _
  have htop_pos : 0 < (1 + ‖z‖) ^ 2 := pow_pos (by positivity) _
  have hinv : ((1 + ‖z‖) ^ 2)⁻¹ ≤ ((2 : ℝ) ^ (2 * m))⁻¹ :=
    (inv_le_inv₀ htop_pos hdenom_pos).2 hdenom
  have htail_eq : (((2 : ℝ)⁻¹) ^ (1 + 1)) ^ m =
      ((2 : ℝ) ^ (2 * m))⁻¹ := by
    norm_num
    rw [show (1 / 4 : ℝ) = (4 : ℝ)⁻¹ by norm_num, inv_pow]
    congr 1
    calc
      (4 : ℝ) ^ m = ((2 : ℝ) ^ 2) ^ m := by norm_num
      _ = (2 : ℝ) ^ (2 * m) := (pow_mul (2 : ℝ) 2 m).symm
  have htail_def : scratchLp_fiberTailTwo z = ((1 + ‖z‖) ^ 2)⁻¹ := by
    unfold scratchLp_fiberTailTwo
    rw [Real.rpow_neg (by positivity)]
    exact congrArg Inv.inv (Real.rpow_natCast (1 + ‖z‖) 2)
  calc
    scratchLp_fiberTailTwo z = ((1 + ‖z‖) ^ 2)⁻¹ := htail_def
    _ ≤ ((2 : ℝ) ^ (2 * m))⁻¹ := hinv
    _ = (((2 : ℝ)⁻¹) ^ (1 + 1)) ^ m := htail_eq.symm

theorem scratchLp_one_le_three_pow_ten_mul_fiberRadialBracket_of_norm_lt_two
    (z : FiberDyadicLine) (hz : ‖z‖ < 2) :
    1 ≤ (3 : ℝ) ^ 10 * fiberRadialBracket z := by
  have hbase_pos : 0 < 1 + ‖z‖ := by positivity
  have hbase : 1 + ‖z‖ ≤ 3 := by linarith
  have hpow : (1 + ‖z‖) ^ 10 ≤ (3 : ℝ) ^ 10 :=
    pow_le_pow_left₀ (by positivity) hbase 10
  have hdenom_pos : 0 < (1 + ‖z‖) ^ 10 := pow_pos hbase_pos _
  unfold fiberRadialBracket
  rw [Real.rpow_neg (by positivity)]
  have hdiv : 1 ≤ (3 : ℝ) ^ 10 / (1 + ‖z‖) ^ 10 :=
    (one_le_div₀ hdenom_pos).mpr hpow
  simpa [div_eq_mul_inv] using hdiv

private theorem scratchLp_exists_dyadic_annulus {t : ℝ} (ht : 2 ≤ t) :
    ∃ n : ℕ, (2 : ℝ) ^ n ≤ t ∧ t < (2 : ℝ) ^ (n + 1) := by
  have hpow : Filter.Tendsto (fun n : ℕ => (2 : ℝ) ^ n) Filter.atTop Filter.atTop :=
    tendsto_pow_atTop_atTop_of_one_lt (by norm_num)
  obtain ⟨m, hm⟩ := Filter.eventually_atTop.1 (hpow.eventually_gt_atTop t)
  have hexists : ∃ n : ℕ, t < (2 : ℝ) ^ (n + 1) := by
    refine ⟨m, ?_⟩
    apply (hm m le_rfl).trans_le
    rw [show m + 1 = Nat.succ m by omega, pow_succ]
    have hnonneg : 0 ≤ (2 : ℝ) ^ m := pow_nonneg (by norm_num) _
    nlinarith
  let n : ℕ := Nat.find hexists
  have hnupper : t < (2 : ℝ) ^ (n + 1) := Nat.find_spec hexists
  have hnpos : 0 < n := by
    by_contra h
    have hnzero : n = 0 := Nat.eq_zero_of_not_pos h
    have hsmall : t < 2 := by
      simpa [hnzero] using hnupper
    linarith
  have hnlower : (2 : ℝ) ^ n ≤ t := by
    by_contra h
    have hlt : t < (2 : ℝ) ^ n := lt_of_not_ge h
    have hpred : n - 1 + 1 = n := Nat.sub_add_cancel (Nat.succ_le_iff.2 hnpos)
    have : t < (2 : ℝ) ^ ((n - 1) + 1) := by simpa [hpred] using hlt
    exact (not_lt_of_ge (Nat.find_min' hexists this))
      (Nat.sub_lt hnpos (by omega))
  exact ⟨n, hnlower, hnupper⟩

private theorem scratchLp_fiber_shell_tail_two_coefficient
    (A r : ℝ) (n : ℕ) (hr : 0 < r) :
    (A * r⁻¹ * (((2 : ℝ)⁻¹) ^ (1 + 1)) ^ n) *
        (2 * ((2 : ℝ) ^ (n + 2) * r)) =
      A * (2 : ℝ) ^ 3 * (1 / 2 : ℝ) ^ n := by
  have hr0 : r ≠ 0 := hr.ne'
  rw [show 2 * ((2 : ℝ) ^ (n + 2) * r) =
      (2 : ℝ) ^ (n + 3) * r by
        rw [show n + 3 = (n + 2) + 1 by omega, pow_succ]
        ring]
  rw [show (((2 : ℝ)⁻¹) ^ (1 + 1)) ^ n =
      ((2 : ℝ)⁻¹) ^ ((1 + 1) * n) by rw [pow_mul]]
  rw [show ((2 : ℝ)⁻¹) ^ ((1 + 1) * n) =
      ((2 : ℝ) ^ ((1 + 1) * n))⁻¹ by rw [inv_pow]]
  rw [show (1 / 2 : ℝ) = ((2 : ℝ)⁻¹) ^ 1 by norm_num]
  rw [← pow_mul, inv_pow]
  norm_num
  field_simp
  ring

/-- The exponent-two interval tail is controlled, on every bounded measurable
fiber, by the existing dyadic fiber maximal operator. This is the annular
comparison required in the `1 < p < ∞` interval-tail argument. -/
theorem scratchLp_fiberTailTwo_weighted_integral_le_dyadic_average_sup
    (G : FiberDyadicBase × FiberDyadicLine → ℂ) (hG : Measurable G)
    (a : ℝ) (ha : 0 ≤ a) (hGa : ∀ z, ‖G z‖ ≤ a)
    (q : FiberDyadicBase × FiberDyadicLine) {r : ℝ} (hr : 0 < r) :
    (∫ y : FiberDyadicLine,
      ‖G (q.1, y)‖ *
        (r⁻¹ * scratchLp_fiberTailTwo (r⁻¹ • (y - q.2)))) ≤
      16 * (fiberDyadicBallMaximal G q *
        (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) := by
  let ρ : ℝ := ((2 : ℝ)⁻¹) ^ (1 + 1)
  let M : ℝ := fiberDyadicBallMaximal G q *
    (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal
  have hM : 0 ≤ M := by
    dsimp [M]
    exact mul_nonneg ENNReal.toReal_nonneg ENNReal.toReal_nonneg
  have hrinv_nonneg : 0 ≤ r⁻¹ := inv_nonneg.mpr hr.le
  have hρ_nonneg : 0 ≤ ρ := by
    dsimp [ρ]
    positivity
  have hρ_lt_one : ρ < 1 := by
    dsimp [ρ]
    norm_num
  have hρ_norm_lt_one : ‖ρ‖ < 1 := by
    rw [Real.norm_eq_abs, abs_of_nonneg hρ_nonneg]
    exact hρ_lt_one
  have hgeom : Summable fun n : ℕ => ρ ^ n :=
    summable_geometric_of_norm_lt_one hρ_norm_lt_one
  have hline_meas : Measurable (fun y : FiberDyadicLine => ‖G (q.1, y)‖) :=
    (hG.comp (measurable_const.prodMk measurable_id)).norm
  let F : ℕ → FiberDyadicLine → ℝ := fun n y =>
    (r⁻¹ * ρ ^ n) *
      (Metric.ball q.2 ((2 : ℝ) ^ (n + 2) * r)).indicator
        (fun z => ‖G (q.1, z)‖) y
  have hF_nonneg (n : ℕ) (y : FiberDyadicLine) : 0 ≤ F n y := by
    dsimp [F]
    apply mul_nonneg
    · exact mul_nonneg hrinv_nonneg (pow_nonneg hρ_nonneg _)
    · apply Set.indicator_nonneg
      intro z _
      exact norm_nonneg _
  have hF_le_major (n : ℕ) (y : FiberDyadicLine) :
      F n y ≤ (r⁻¹ * a) * ρ ^ n := by
    dsimp [F]
    have hind :
        (Metric.ball q.2 ((2 : ℝ) ^ (n + 2) * r)).indicator
          (fun z => ‖G (q.1, z)‖) y ≤ a := by
      by_cases hy : y ∈ Metric.ball q.2 ((2 : ℝ) ^ (n + 2) * r)
      · simpa [hy] using hGa (q.1, y)
      · simp [hy, ha]
    calc
      (r⁻¹ * ρ ^ n) *
          (Metric.ball q.2 ((2 : ℝ) ^ (n + 2) * r)).indicator
            (fun z => ‖G (q.1, z)‖) y ≤
          (r⁻¹ * ρ ^ n) * a :=
        mul_le_mul_of_nonneg_left hind
          (mul_nonneg hrinv_nonneg (pow_nonneg hρ_nonneg _))
      _ = (r⁻¹ * a) * ρ ^ n := by ring
  have hF_pointwise_summable (y : FiberDyadicLine) :
      Summable fun n : ℕ => F n y := by
    refine Summable.of_nonneg_of_le
      (f := fun n : ℕ => (r⁻¹ * a) * ρ ^ n)
      (g := fun n : ℕ => F n y) ?_ ?_ ?_
    · intro n
      exact hF_nonneg n y
    · intro n
      exact hF_le_major n y
    · simpa [mul_assoc] using hgeom.mul_left (r⁻¹ * a)
  have hball_of_scaled_norm_lt (n : ℕ) (y : FiberDyadicLine)
      (hy : ‖r⁻¹ • (y - q.2)‖ < (2 : ℝ) ^ (n + 2)) :
      y ∈ Metric.ball q.2 ((2 : ℝ) ^ (n + 2) * r) := by
    rw [Metric.mem_ball, dist_eq_norm_sub]
    have hnorm : ‖y - q.2‖ = r * ‖r⁻¹ • (y - q.2)‖ := by
      rw [norm_smul_of_nonneg hrinv_nonneg]
      field_simp [hr.ne']
    calc
      ‖y - q.2‖ = r * ‖r⁻¹ • (y - q.2)‖ := hnorm
      _ < r * (2 : ℝ) ^ (n + 2) := mul_lt_mul_of_pos_left hy hr
      _ = (2 : ℝ) ^ (n + 2) * r := by ring
  have hpointwise (y : FiberDyadicLine) :
      ‖G (q.1, y)‖ *
          (r⁻¹ * scratchLp_fiberTailTwo (r⁻¹ • (y - q.2))) ≤
        ∑' n : ℕ, F n y := by
    have hsum := hF_pointwise_summable y
    by_cases hy : ‖r⁻¹ • (y - q.2)‖ < 2
    · have hyball : y ∈ Metric.ball q.2 ((2 : ℝ) ^ (0 + 2) * r) := by
        apply hball_of_scaled_norm_lt 0 y
        calc
          ‖r⁻¹ • (y - q.2)‖ < 2 := hy
          _ < (2 : ℝ) ^ (0 + 2) := by norm_num
      have hterm :
          ‖G (q.1, y)‖ *
              (r⁻¹ * scratchLp_fiberTailTwo (r⁻¹ • (y - q.2))) ≤ F 0 y := by
        have hW := scratchLp_fiberTailTwo_le_one (r⁻¹ • (y - q.2))
        calc
          ‖G (q.1, y)‖ *
              (r⁻¹ * scratchLp_fiberTailTwo (r⁻¹ • (y - q.2))) ≤
              ‖G (q.1, y)‖ * r⁻¹ := by
            apply mul_le_mul_of_nonneg_left
            · simpa [mul_comm] using mul_le_mul_of_nonneg_left hW hrinv_nonneg
            · exact norm_nonneg _
          _ = F 0 y := by
            dsimp [F, ρ]
            rw [Set.indicator_of_mem hyball]
            norm_num
            ring
      exact hterm.trans (hsum.le_tsum 0 fun j _ => hF_nonneg j y)
    · have htwo : 2 ≤ ‖r⁻¹ • (y - q.2)‖ := le_of_not_gt hy
      obtain ⟨k, hklow, hkupper⟩ := scratchLp_exists_dyadic_annulus htwo
      have hkpos : 0 < k := by
        by_contra hk
        have hkzero : k = 0 := Nat.eq_zero_of_not_pos hk
        have hsmall : ‖r⁻¹ • (y - q.2)‖ < 2 := by
          simpa [hkzero] using hkupper
        exact (not_lt_of_ge htwo) hsmall
      let n : ℕ := k - 1
      have hnadd : n + 1 = k := by
        dsimp [n]
        omega
      have hnadd' : n + 2 = k + 1 := by omega
      have hlow : (2 : ℝ) ^ (n + 1) ≤ ‖r⁻¹ • (y - q.2)‖ := by
        simpa [hnadd] using hklow
      have hupp : ‖r⁻¹ • (y - q.2)‖ < (2 : ℝ) ^ (n + 2) := by
        simpa [hnadd'] using hkupper
      have hnorm_one : 1 ≤ ‖r⁻¹ • (y - q.2)‖ := by
        calc
          1 ≤ (2 : ℝ) ^ (n + 1) := one_le_pow₀ (by norm_num)
          _ ≤ ‖r⁻¹ • (y - q.2)‖ := hlow
      have hsub : (2 : ℝ) ^ n ≤ ‖r⁻¹ • (y - q.2)‖ - 1 := by
        have hpow_one : 1 ≤ (2 : ℝ) ^ n := one_le_pow₀ (by norm_num)
        rw [show (2 : ℝ) ^ (n + 1) = 2 * (2 : ℝ) ^ n by
          rw [pow_succ]
          ring] at hlow
        nlinarith
      have habs : (2 : ℝ) ^ n ≤ |‖r⁻¹ • (y - q.2)‖ - 1| := by
        rw [abs_of_nonneg (sub_nonneg.mpr hnorm_one)]
        exact hsub
      have hyball : y ∈ Metric.ball q.2 ((2 : ℝ) ^ (n + 2) * r) :=
        hball_of_scaled_norm_lt n y hupp
      have hterm :
          ‖G (q.1, y)‖ *
              (r⁻¹ * scratchLp_fiberTailTwo (r⁻¹ • (y - q.2))) ≤ F n y := by
        have hW := scratchLp_fiberTailTwo_tail
          (r⁻¹ • (y - q.2)) n habs
        calc
          ‖G (q.1, y)‖ *
              (r⁻¹ * scratchLp_fiberTailTwo (r⁻¹ • (y - q.2))) ≤
              ‖G (q.1, y)‖ * (r⁻¹ * ρ ^ n) := by
            apply mul_le_mul_of_nonneg_left
            · exact mul_le_mul_of_nonneg_left (by simpa [ρ] using hW) hrinv_nonneg
            · exact norm_nonneg _
          _ = F n y := by
            dsimp [F]
            rw [Set.indicator_of_mem hyball]
            ring
      exact hterm.trans (hsum.le_tsum n fun j _ => hF_nonneg j y)
  have hF_integrable (n : ℕ) : Integrable (F n) volume := by
    dsimp [F]
    have hline_int : IntegrableOn (fun y : FiberDyadicLine => ‖G (q.1, y)‖)
        (Metric.ball q.2 ((2 : ℝ) ^ (n + 2) * r)) volume := by
      refine IntegrableOn.of_bound measure_ball_lt_top hline_meas.aestronglyMeasurable a ?_
      filter_upwards [] with y
      rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
      exact hGa (q.1, y)
    exact (hline_int.integrable_indicator measurableSet_ball).const_mul
      (r⁻¹ * ρ ^ n)
  have hF_integral (n : ℕ) :
      (∫ y : FiberDyadicLine, F n y) =
        (r⁻¹ * ρ ^ n) *
          (∫ y in Metric.ball q.2 ((2 : ℝ) ^ (n + 2) * r), ‖G (q.1, y)‖) := by
    dsimp [F]
    rw [integral_const_mul, integral_indicator measurableSet_ball]
  have hF_integral_bound (n : ℕ) :
      (∫ y : FiberDyadicLine, F n y) ≤
        (M * (2 : ℝ) ^ 3) * (1 / 2 : ℝ) ^ n := by
    have hradius : 0 < (2 : ℝ) ^ (n + 2) * r :=
      mul_pos (pow_pos (by norm_num) _) hr
    rw [hF_integral]
    calc
      (r⁻¹ * ρ ^ n) *
          (∫ y in Metric.ball q.2 ((2 : ℝ) ^ (n + 2) * r), ‖G (q.1, y)‖) ≤
          (r⁻¹ * ρ ^ n) *
            (M * (2 * ((2 : ℝ) ^ (n + 2) * r))) :=
        mul_le_mul_of_nonneg_left
          (by
            simpa [M, mul_assoc] using
              (fiberDyadicBall_integral_le_dyadic_average_sup_any_radius
                G hG a ha hGa q hradius))
          (mul_nonneg hrinv_nonneg (pow_nonneg hρ_nonneg _))
      _ = (M * (2 : ℝ) ^ 3) * (1 / 2 : ℝ) ^ n := by
        dsimp [ρ]
        convert scratchLp_fiber_shell_tail_two_coefficient M r n hr using 1
        ring
  have hG_summable : Summable fun n : ℕ =>
      (M * (2 : ℝ) ^ 3) * (1 / 2 : ℝ) ^ n := by
    have heighth : ‖(1 / 2 : ℝ)‖ < 1 := by norm_num
    exact (summable_geometric_of_norm_lt_one heighth).mul_left
      (M * (2 : ℝ) ^ 3)
  have hF_summable_integral_norm : Summable fun n : ℕ =>
      ∫ y : FiberDyadicLine, ‖F n y‖ := by
    refine Summable.of_nonneg_of_le
      (f := fun n : ℕ => (M * (2 : ℝ) ^ 3) * (1 / 2 : ℝ) ^ n)
      (g := fun n : ℕ => ∫ y : FiberDyadicLine, ‖F n y‖) ?_ ?_ hG_summable
    · intro n
      exact integral_nonneg fun y => norm_nonneg _
    · intro n
      have hnorm : (∫ y : FiberDyadicLine, ‖F n y‖) =
          ∫ y : FiberDyadicLine, F n y := by
        apply integral_congr_ae
        filter_upwards with y
        rw [Real.norm_of_nonneg (hF_nonneg n y)]
      rw [hnorm]
      exact hF_integral_bound n
  have hF_enorm_sum_lt_top :
      (∑' n : ℕ, ∫⁻ y : FiberDyadicLine, ‖F n y‖ₑ) < ⊤ := by
    calc
      (∑' n : ℕ, ∫⁻ y : FiberDyadicLine, ‖F n y‖ₑ) =
          ∑' n : ℕ, ENNReal.ofReal (∫ y : FiberDyadicLine, ‖F n y‖) := by
        apply tsum_congr
        intro n
        exact (ofReal_integral_norm_eq_lintegral_enorm (hF_integrable n)).symm
      _ < ⊤ := hF_summable_integral_norm.tsum_ofReal_lt_top
  have htsum_measurable : AEStronglyMeasurable
      (fun y : FiberDyadicLine => ∑' n : ℕ, F n y) volume :=
    AEStronglyMeasurable.tsum fun n => (hF_integrable n).aestronglyMeasurable
  have htsum_integrable : Integrable (fun y : FiberDyadicLine => ∑' n : ℕ, F n y) volume := by
    refine ⟨htsum_measurable, ?_⟩
    rw [hasFiniteIntegral_iff_enorm]
    calc
      ∫⁻ y : FiberDyadicLine, ‖∑' n : ℕ, F n y‖ₑ ≤
          ∫⁻ y : FiberDyadicLine, ∑' n : ℕ, ‖F n y‖ₑ :=
        lintegral_mono fun y => enorm_tsum_le_tsum_enorm
      _ = ∑' n : ℕ, ∫⁻ y : FiberDyadicLine, ‖F n y‖ₑ :=
        lintegral_tsum fun n => (hF_integrable n).aestronglyMeasurable.enorm
      _ < ⊤ := hF_enorm_sum_lt_top
  have htsum_integral :
      (∫ y : FiberDyadicLine, ∑' n : ℕ, F n y) =
        ∑' n : ℕ, ∫ y : FiberDyadicLine, F n y := by
    exact (MeasureTheory.integral_tsum_of_summable_integral_norm
      hF_integrable hF_summable_integral_norm).symm
  have hF_summable_integral : Summable fun n : ℕ =>
      ∫ y : FiberDyadicLine, F n y := by
    refine Summable.of_nonneg_of_le
      (f := fun n : ℕ => (M * (2 : ℝ) ^ 3) * (1 / 2 : ℝ) ^ n)
      (g := fun n : ℕ => ∫ y : FiberDyadicLine, F n y) ?_ ?_ hG_summable
    · intro n
      exact integral_nonneg fun y => hF_nonneg n y
    · intro n
      exact hF_integral_bound n
  have hD_nonneg : 0 ≤ M * (2 : ℝ) ^ 3 := by positivity
  have heighth : ‖(1 / 2 : ℝ)‖ < 1 := by norm_num
  have hsum_half : ∑' n : ℕ, (1 / 2 : ℝ) ^ n = 2 := by
    rw [(hasSum_geometric_of_norm_lt_one heighth).tsum_eq]
    norm_num
  have hsum_integrals_bound :
      (∑' n : ℕ, ∫ y : FiberDyadicLine, F n y) ≤
        2 * (M * (2 : ℝ) ^ 3) := by
    calc
      (∑' n : ℕ, ∫ y : FiberDyadicLine, F n y) ≤
          ∑' n : ℕ, (M * (2 : ℝ) ^ 3) * (1 / 2 : ℝ) ^ n :=
        Summable.tsum_le_tsum (fun n => hF_integral_bound n)
          hF_summable_integral hG_summable
      _ = (M * (2 : ℝ) ^ 3) * ∑' n : ℕ, (1 / 2 : ℝ) ^ n := by
        rw [tsum_mul_left]
      _ = (M * (2 : ℝ) ^ 3) * 2 := by rw [hsum_half]
      _ = 2 * (M * (2 : ℝ) ^ 3) := by ring
  have hleft_nonneg (y : FiberDyadicLine) :
      0 ≤ ‖G (q.1, y)‖ *
        (r⁻¹ * scratchLp_fiberTailTwo (r⁻¹ • (y - q.2))) := by
    exact mul_nonneg (norm_nonneg _)
      (mul_nonneg hrinv_nonneg (scratchLp_fiberTailTwo_nonneg _))
  calc
    (∫ y : FiberDyadicLine,
        ‖G (q.1, y)‖ *
          (r⁻¹ * scratchLp_fiberTailTwo (r⁻¹ • (y - q.2)))) ≤
        ∫ y : FiberDyadicLine, ∑' n : ℕ, F n y :=
      integral_mono_of_nonneg
        (Filter.Eventually.of_forall hleft_nonneg) htsum_integrable
        (Filter.Eventually.of_forall hpointwise)
    _ = ∑' n : ℕ, ∫ y : FiberDyadicLine, F n y := htsum_integral
    _ ≤ 2 * (M * (2 : ℝ) ^ 3) := hsum_integrals_bound
    _ = 16 * (fiberDyadicBallMaximal G q *
        (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) := by
      dsimp [M]
      ring

/-- Removing the normalization factor from the tail costs exactly one radius. -/
theorem scratchLp_fiberTailTwo_pairing_le_dyadic_average_sup
    (G : FiberDyadicBase × FiberDyadicLine → ℂ) (hG : Measurable G)
    (a : ℝ) (ha : 0 ≤ a) (hGa : ∀ z, ‖G z‖ ≤ a)
    (q : FiberDyadicBase × FiberDyadicLine) {r : ℝ} (hr : 0 < r) :
    (∫ y : FiberDyadicLine,
      ‖G (q.1, y)‖ * scratchLp_fiberTailTwo (r⁻¹ • (y - q.2))) ≤
      16 * r * (fiberDyadicBallMaximal G q *
        (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) := by
  have hmain := scratchLp_fiberTailTwo_weighted_integral_le_dyadic_average_sup
    G hG a ha hGa q hr
  calc
    (∫ y : FiberDyadicLine,
        ‖G (q.1, y)‖ * scratchLp_fiberTailTwo (r⁻¹ • (y - q.2))) =
        ∫ y : FiberDyadicLine,
          r * (‖G (q.1, y)‖ *
            (r⁻¹ * scratchLp_fiberTailTwo (r⁻¹ • (y - q.2)))) := by
      apply integral_congr_ae
      filter_upwards with y
      field_simp [hr.ne']
    _ = r * (∫ y : FiberDyadicLine,
        ‖G (q.1, y)‖ *
          (r⁻¹ * scratchLp_fiberTailTwo (r⁻¹ • (y - q.2)))) := by
      rw [integral_const_mul]
    _ ≤ r * (16 * (fiberDyadicBallMaximal G q *
        (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal)) :=
      mul_le_mul_of_nonneg_left hmain hr.le
    _ = 16 * r * (fiberDyadicBallMaximal G q *
        (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) := by ring

/-- If `y` lies in the radius-`r` interval about `c`, pairing the doubled
interval tail with a bounded fiber is controlled at the point `y` by the
fiber dyadic maximal function. This is the pointwise input averaged over
each bad interval in the disjoint-tail argument. -/
theorem scratchLp_intervalTail_pairing_le_fiberDyadicBallMaximal
    (G : FiberDyadicBase × FiberDyadicLine → ℂ) (hG : Measurable G)
    (a : ℝ) (ha : 0 ≤ a) (hGa : ∀ z, ‖G z‖ ≤ a)
    (z : FiberDyadicBase) {c r y : ℝ} (hr : 0 < r) (hy : |y - c| ≤ r) :
    (∫ x : FiberDyadicLine,
      ‖G (z, x)‖ * scratchLp_intervalTail c (2 * r)
        (realToFiberDyadicLine.symm x)) ≤
      128 * r * (fiberDyadicBallMaximal G (z, realToFiberDyadicLine y) *
        (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) := by
  let q : FiberDyadicBase × FiberDyadicLine := (z, realToFiberDyadicLine y)
  have hdouble : 0 < 2 * r := by positivity
  have htail_integrable := scratchLp_integrable_weighted_fiberTailTwo
    G hG a hGa q (r := 2 * r) hdouble
  have htail_le (x : FiberDyadicLine) :
      scratchLp_intervalTail c (2 * r) (realToFiberDyadicLine.symm x) ≤
        4 * scratchLp_fiberTailTwo ((2 * r)⁻¹ • (x - q.2)) := by
    calc
      scratchLp_intervalTail c (2 * r) (realToFiberDyadicLine.symm x) ≤
          4 * scratchLp_intervalTail y (2 * r)
            (realToFiberDyadicLine.symm x) :=
        scratchLp_intervalTail_le_four_intervalTail_of_center_dist hr hy
      _ = 4 * scratchLp_fiberTailTwo ((2 * r)⁻¹ • (x - q.2)) := by
        rw [scratchLp_intervalTail_eq_fiberTailTwo y (2 * r)
          (realToFiberDyadicLine.symm x) hdouble]
        dsimp [q]
        simp
  have hleft_nonneg (x : FiberDyadicLine) :
      0 ≤ ‖G (z, x)‖ * scratchLp_intervalTail c (2 * r)
        (realToFiberDyadicLine.symm x) := by
    exact mul_nonneg (norm_nonneg _) (by
      unfold scratchLp_intervalTail
      positivity)
  have hpointwise (x : FiberDyadicLine) :
      ‖G (z, x)‖ * scratchLp_intervalTail c (2 * r)
        (realToFiberDyadicLine.symm x) ≤
        4 * (‖G (q.1, x)‖ *
          scratchLp_fiberTailTwo ((2 * r)⁻¹ • (x - q.2))) := by
    dsimp [q]
    calc
      ‖G (z, x)‖ * scratchLp_intervalTail c (2 * r)
          (realToFiberDyadicLine.symm x) ≤
          ‖G (z, x)‖ *
            (4 * scratchLp_fiberTailTwo ((2 * r)⁻¹ •
              (x - realToFiberDyadicLine y))) :=
        mul_le_mul_of_nonneg_left (htail_le x) (norm_nonneg _)
      _ = 4 * (‖G (z, x)‖ * scratchLp_fiberTailTwo ((2 * r)⁻¹ •
          (x - realToFiberDyadicLine y))) := by ring
  have hpair := scratchLp_fiberTailTwo_pairing_le_dyadic_average_sup
    G hG a ha hGa q hdouble
  calc
    (∫ x : FiberDyadicLine,
        ‖G (z, x)‖ * scratchLp_intervalTail c (2 * r)
          (realToFiberDyadicLine.symm x)) ≤
        ∫ x : FiberDyadicLine,
          4 * (‖G (q.1, x)‖ *
            scratchLp_fiberTailTwo ((2 * r)⁻¹ • (x - q.2))) :=
      integral_mono_of_nonneg
        (Filter.Eventually.of_forall hleft_nonneg) (htail_integrable.const_mul 4)
        (Filter.Eventually.of_forall hpointwise)
    _ = 4 * (∫ x : FiberDyadicLine,
        ‖G (q.1, x)‖ *
          scratchLp_fiberTailTwo ((2 * r)⁻¹ • (x - q.2))) := by
      rw [integral_const_mul]
    _ ≤ 4 * (16 * (2 * r) * (fiberDyadicBallMaximal G q *
        (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal)) :=
      mul_le_mul_of_nonneg_left hpair (by norm_num)
    _ = 128 * r * (fiberDyadicBallMaximal G (z, realToFiberDyadicLine y) *
        (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) := by
      dsimp [q]
      ring

/-- Averaging the point-pairing estimate over its radius-`r` interval yields
the form that sums over a finite disjoint interval family. -/
theorem scratchLp_intervalTail_pairing_average_le
    (G : FiberDyadicBase × FiberDyadicLine → ℂ) (hG : Measurable G)
    (a : ℝ) (ha : 0 ≤ a) (hGa : ∀ z, ‖G z‖ ≤ a)
    (z : FiberDyadicBase) {c r : ℝ} (hr : 0 < r) :
    (∫ x : FiberDyadicLine,
      ‖G (z, x)‖ * scratchLp_intervalTail c (2 * r)
        (realToFiberDyadicLine.symm x)) ≤
      64 * (∫ u in Ioo (c - r) (c + r),
        fiberDyadicBallMaximal G (z, realToFiberDyadicLine u) *
          (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) := by
  let V : ℝ := (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal
  let M : ℝ → ℝ := fun u =>
    fiberDyadicBallMaximal G (z, realToFiberDyadicLine u) * V
  let A : ℝ := ∫ x : FiberDyadicLine,
    ‖G (z, x)‖ * scratchLp_intervalTail c (2 * r)
      (realToFiberDyadicLine.symm x)
  have hV : 0 ≤ V := by
    dsimp [V]
    exact ENNReal.toReal_nonneg
  have hM_nonneg (u : ℝ) : 0 ≤ M u := by
    dsimp [M]
    exact mul_nonneg ENNReal.toReal_nonneg hV
  have hM_meas : Measurable M := by
    dsimp [M]
    exact ((fiberDyadicBallMaximal_measurable G hG).comp
      (measurable_const.prodMk realToFiberDyadicLine.measurable)).mul measurable_const
  have hM_bound (u : ℝ) : M u ≤ a * V := by
    dsimp [M]
    exact mul_le_mul_of_nonneg_right
      (fiberDyadicBallMaximal_top_bound G a ha hGa
        (z, realToFiberDyadicLine u)) hV
  have hM_int : IntegrableOn M (Ioo (c - r) (c + r)) volume := by
    refine IntegrableOn.of_bound measure_Ioo_lt_top hM_meas.aestronglyMeasurable
      (a * V) ?_
    filter_upwards [] with u
    rw [Real.norm_eq_abs, abs_of_nonneg (hM_nonneg u)]
    exact hM_bound u
  have hA_nonneg : 0 ≤ A := by
    dsimp [A]
    exact integral_nonneg fun x => mul_nonneg (norm_nonneg _) (by
      unfold scratchLp_intervalTail
      positivity)
  have hpoint (u : ℝ) (hu : u ∈ Ioo (c - r) (c + r)) :
      A ≤ 128 * r * M u := by
    have huc : |u - c| ≤ r := by
      exact abs_le.mpr ⟨by linarith [hu.1], by linarith [hu.2]⟩
    simpa [A, M, V] using
      (scratchLp_intervalTail_pairing_le_fiberDyadicBallMaximal
        G hG a ha hGa z hr huc)
  have havg :
      (∫ u in Ioo (c - r) (c + r), A) ≤
        ∫ u in Ioo (c - r) (c + r), 128 * r * M u := by
    exact integral_mono_of_nonneg
      (Filter.Eventually.of_forall fun _ => hA_nonneg)
      (hM_int.const_mul (128 * r))
      (ae_restrict_of_forall_mem measurableSet_Ioo hpoint)
  have hvol : (volume (Ioo (c - r) (c + r))).toReal = 2 * r := by
    rw [Real.volume_Ioo, ENNReal.toReal_ofReal (by linarith [hr])]
    ring
  have hconst : (∫ _u in Ioo (c - r) (c + r), A) = (2 * r) * A := by
    rw [setIntegral_const, smul_eq_mul]
    change (volume (Ioo (c - r) (c + r))).toReal * A = (2 * r) * A
    rw [hvol]
  have hright :
      (∫ u in Ioo (c - r) (c + r), 128 * r * M u) =
        (128 * r) * (∫ u in Ioo (c - r) (c + r), M u) := by
    rw [integral_const_mul]
  apply le_of_mul_le_mul_left (a := 2 * r) ?_ (by positivity : 0 < 2 * r)
  calc
    (2 * r) * A = ∫ _u in Ioo (c - r) (c + r), A := hconst.symm
    _ ≤ ∫ u in Ioo (c - r) (c + r), 128 * r * M u := havg
    _ = (128 * r) * (∫ u in Ioo (c - r) (c + r), M u) := hright
    _ = (2 * r) *
        (64 * (∫ u in Ioo (c - r) (c + r), M u)) := by ring

/-- The averaged interval pairing sums over every finite family; disjointness
is only needed in the subsequent union-of-intervals rewrite. -/
theorem scratchLp_finset_intervalTail_pairing_average_le
    {ι : Type*} (S : Finset ι) (c r : ι → ℝ)
    (hr : ∀ i ∈ S, 0 < r i)
    (G : FiberDyadicBase × FiberDyadicLine → ℂ) (hG : Measurable G)
    (a : ℝ) (ha : 0 ≤ a) (hGa : ∀ z, ‖G z‖ ≤ a)
    (z : FiberDyadicBase) :
    (∑ i ∈ S, ∫ x : FiberDyadicLine,
      ‖G (z, x)‖ * scratchLp_intervalTail (c i) (2 * r i)
        (realToFiberDyadicLine.symm x)) ≤
      64 * ∑ i ∈ S, ∫ u in Ioo (c i - r i) (c i + r i),
        fiberDyadicBallMaximal G (z, realToFiberDyadicLine u) *
          (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal := by
  calc
    (∑ i ∈ S, ∫ x : FiberDyadicLine,
        ‖G (z, x)‖ * scratchLp_intervalTail (c i) (2 * r i)
          (realToFiberDyadicLine.symm x)) ≤
        ∑ i ∈ S, 64 * (∫ u in Ioo (c i - r i) (c i + r i),
          fiberDyadicBallMaximal G (z, realToFiberDyadicLine u) *
            (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) := by
      apply Finset.sum_le_sum
      intro i hi
      exact scratchLp_intervalTail_pairing_average_le G hG a ha hGa z (hr i hi)
    _ = 64 * ∑ i ∈ S, ∫ u in Ioo (c i - r i) (c i + r i),
        fiberDyadicBallMaximal G (z, realToFiberDyadicLine u) *
          (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal := by
      rw [Finset.mul_sum]

/-- For a finite pairwise-disjoint family of radius intervals, the summed
tail pairings are controlled by one maximal-function integral over their
union. This is the finite disjoint-interval terminal used before Hölder. -/
theorem scratchLp_finset_pairwiseDisjoint_intervalTail_pairing_le
    {ι : Type*} (S : Finset ι) (c r : ι → ℝ)
    (hr : ∀ i ∈ S, 0 < r i)
    (hdisj : (↑S : Set ι).PairwiseDisjoint
      (fun i => Ioo (c i - r i) (c i + r i)))
    (G : FiberDyadicBase × FiberDyadicLine → ℂ) (hG : Measurable G)
    (a : ℝ) (ha : 0 ≤ a) (hGa : ∀ z, ‖G z‖ ≤ a)
    (z : FiberDyadicBase) :
    (∑ i ∈ S, ∫ x : FiberDyadicLine,
      ‖G (z, x)‖ * scratchLp_intervalTail (c i) (2 * r i)
        (realToFiberDyadicLine.symm x)) ≤
      64 * (∫ u in ⋃ i ∈ S, Ioo (c i - r i) (c i + r i),
        fiberDyadicBallMaximal G (z, realToFiberDyadicLine u) *
          (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) := by
  classical
  let V : ℝ := (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal
  let M : ℝ → ℝ := fun u =>
    fiberDyadicBallMaximal G (z, realToFiberDyadicLine u) * V
  have hV : 0 ≤ V := by
    dsimp [V]
    exact ENNReal.toReal_nonneg
  have hM_nonneg (u : ℝ) : 0 ≤ M u := by
    dsimp [M]
    exact mul_nonneg ENNReal.toReal_nonneg hV
  have hM_meas : Measurable M := by
    dsimp [M]
    exact ((fiberDyadicBallMaximal_measurable G hG).comp
      (measurable_const.prodMk realToFiberDyadicLine.measurable)).mul measurable_const
  have hM_bound (u : ℝ) : M u ≤ a * V := by
    dsimp [M]
    exact mul_le_mul_of_nonneg_right
      (fiberDyadicBallMaximal_top_bound G a ha hGa
        (z, realToFiberDyadicLine u)) hV
  have hM_int (i : ι) (hi : i ∈ S) :
      IntegrableOn M (Ioo (c i - r i) (c i + r i)) volume := by
    refine IntegrableOn.of_bound measure_Ioo_lt_top hM_meas.aestronglyMeasurable
      (a * V) ?_
    filter_upwards [] with u
    rw [Real.norm_eq_abs, abs_of_nonneg (hM_nonneg u)]
    exact hM_bound u
  have hsum := scratchLp_finset_intervalTail_pairing_average_le S c r hr
    G hG a ha hGa z
  have hunion :
      (∫ u in ⋃ i ∈ S, Ioo (c i - r i) (c i + r i), M u) =
        ∑ i ∈ S, ∫ u in Ioo (c i - r i) (c i + r i), M u := by
    exact integral_biUnion_finset S
      (fun i _ => measurableSet_Ioo) hdisj hM_int
  calc
    (∑ i ∈ S, ∫ x : FiberDyadicLine,
        ‖G (z, x)‖ * scratchLp_intervalTail (c i) (2 * r i)
          (realToFiberDyadicLine.symm x)) ≤
        64 * ∑ i ∈ S, ∫ u in Ioo (c i - r i) (c i + r i), M u := by
      simpa [M, V] using hsum
    _ = 64 * (∫ u in ⋃ i ∈ S, Ioo (c i - r i) (c i + r i), M u) := by
      rw [hunion]
    _ = 64 * (∫ u in ⋃ i ∈ S, Ioo (c i - r i) (c i + r i),
        fiberDyadicBallMaximal G (z, realToFiberDyadicLine u) *
          (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) := by
      rfl

/-- The strong line maximal estimate in `MemLp` form. -/
theorem scratchLp_line_dyadicBallMaximal_memLp
    (g : FiberDyadicLine → ℂ) (hg : Measurable g)
    (hgb : ∃ a : ℝ, 0 ≤ a ∧ ∀ x, ‖g x‖ ≤ a)
    {p : ℝ} (hp : 1 < p)
    (hgp : MemLp g (ENNReal.ofReal p) volume) :
    MemLp (dyadicBallMaximal 1 g) (ENNReal.ofReal p) volume := by
  have hp0 : 0 < p := by linarith
  have hpEN0 : ENNReal.ofReal p ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp0
  have hpENT : ENNReal.ofReal p ≠ ⊤ := ENNReal.ofReal_ne_top
  have hinput : (∫⁻ x : FiberDyadicLine,
      (ENNReal.ofReal ‖g x‖) ^ p) < ∞ := by
    have h := (eLpNorm_lt_top_iff_lintegral_rpow_enorm_lt_top hpEN0 hpENT
      hgp.aestronglyMeasurable).mp hgp
    simpa [ENNReal.toReal_ofReal hp0.le, enorm_eq_nnnorm] using h
  have hinv : (ENNReal.ofReal (p - 1))⁻¹ < ∞ := by
    apply ENNReal.inv_lt_top.mpr
    exact ENNReal.ofReal_pos.mpr (by linarith)
  have hpow : (ENNReal.ofReal (2 : ℝ)) ^ (p - 1) < ∞ := by
    apply ENNReal.rpow_lt_top_of_nonneg
    · linarith
    · exact ENNReal.ofReal_ne_top
  have htwofour : (2 : ENNReal) * ENNReal.ofReal 4 < ∞ :=
    ENNReal.mul_lt_top (by norm_num) ENNReal.ofReal_lt_top
  have htwofourinv : (2 : ENNReal) * ENNReal.ofReal 4 *
      (ENNReal.ofReal (p - 1))⁻¹ < ∞ :=
    ENNReal.mul_lt_top htwofour hinv
  have hcoef : 2 * ENNReal.ofReal 4 * (ENNReal.ofReal (p - 1))⁻¹ *
      (ENNReal.ofReal (2 : ℝ)) ^ (p - 1) < ∞ := by
    exact ENNReal.mul_lt_top htwofourinv hpow
  have hright : ENNReal.ofReal p *
      (2 * ENNReal.ofReal 4 * (ENNReal.ofReal (p - 1))⁻¹ *
        (ENNReal.ofReal (2 : ℝ)) ^ (p - 1) *
        ∫⁻ x : FiberDyadicLine, (ENNReal.ofReal ‖g x‖) ^ p) < ∞ := by
    apply ENNReal.mul_lt_top ENNReal.ofReal_lt_top
    exact ENNReal.mul_lt_top hcoef hinput
  apply memLp_of_lintegral_ofReal_rpow_lt_top
    (dyadicBallMaximal 1 g)
    (scratchLp_line_dyadicBallMaximal_measurable g hg).aemeasurable
    (fun _ ↦ ENNReal.toReal_nonneg) hp0
  apply lt_of_le_of_lt (scratchLp_line_dyadicBallMaximal_lintegral_bound g hg hgb hp)
  exact hright

/-- Transport the strong line maximal estimate back to the literal real
coordinate used by the interval family. -/
theorem scratchLp_real_dyadicBallMaximal_memLp
    (g : FiberDyadicLine → ℂ) (hg : Measurable g)
    (hgb : ∃ a : ℝ, 0 ≤ a ∧ ∀ x, ‖g x‖ ≤ a)
    {p : ℝ} (hp : 1 < p)
    (hgp : MemLp g (ENNReal.ofReal p) volume) :
    MemLp (fun u : ℝ => dyadicBallMaximal 1 g (realToFiberDyadicLine u))
      (ENNReal.ofReal p) volume := by
  have h := scratchLp_line_dyadicBallMaximal_memLp g hg hgb hp hgp
  exact h.comp_measurePreserving realToFiberDyadicLine_measurePreserving

/-- The finite disjoint-interval testing inequality with a genuinely
one-dimensional cutoff. It is the source tail estimate after the passive
fiber coordinate has been eliminated. -/
theorem scratchLp_finset_pairwiseDisjoint_intervalTail_lineTesting_le
    {ι : Type*} (S : Finset ι) (c r : ι → ℝ)
    (hr : ∀ i ∈ S, 0 < r i)
    (hdisj : (↑S : Set ι).PairwiseDisjoint
      (fun i => Ioo (c i - r i) (c i + r i)))
    (g : FiberDyadicLine → ℂ) (hg : Measurable g)
    (a : ℝ) (ha : 0 ≤ a) (hga : ∀ x, ‖g x‖ ≤ a) :
    (∑ i ∈ S, ∫ x : FiberDyadicLine,
      ‖g x‖ * scratchLp_intervalTail (c i) (2 * r i)
        (realToFiberDyadicLine.symm x)) ≤
      64 * (∫ u in ⋃ i ∈ S, Ioo (c i - r i) (c i + r i),
        dyadicBallMaximal 1 g (realToFiberDyadicLine u) *
          (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal) := by
  let G : FiberDyadicBase × FiberDyadicLine → ℂ := fun q => g q.2
  have hG : Measurable G := hg.comp measurable_snd
  have hGa : ∀ q, ‖G q‖ ≤ a := by
    intro q
    exact hga q.2
  have h := scratchLp_finset_pairwiseDisjoint_intervalTail_pairing_le
    S c r hr hdisj G hG a ha hGa (0 : FiberDyadicBase)
  simpa [G, fiberDyadicBallMaximal] using h

private theorem scratchLp_measure_union_finset_intervals_lt_top
    {ι : Type*} (S : Finset ι) (c r : ι → ℝ) :
    volume (⋃ i ∈ S, Ioo (c i - r i) (c i + r i)) < ∞ := by
  calc
    volume (⋃ i ∈ S, Ioo (c i - r i) (c i + r i)) ≤
        ∑ i ∈ S, volume (Ioo (c i - r i) (c i + r i)) :=
      measure_biUnion_finset_le S (fun i => Ioo (c i - r i) (c i + r i))
    _ < ∞ := ENNReal.sum_lt_top.2 fun i hi => measure_Ioo_lt_top

/-- The source's finite-​interval dual test, now closed by the literal
strong line maximal theorem. This is deliberately a bounded-cutoff
statement: it is exactly the input to the standard `L^p` duality passage,
without relying on an unexposed library theorem identifying the dual norm. -/
theorem scratchLp_finset_pairwiseDisjoint_intervalTail_holder_cutoff_le
    {ι : Type*} (S : Finset ι) (c r : ι → ℝ)
    (hr : ∀ i ∈ S, 0 < r i)
    (hdisj : (↑S : Set ι).PairwiseDisjoint
      (fun i => Ioo (c i - r i) (c i + r i)))
    {p q : ℝ} (hpq : q.HolderConjugate p) (hq : 1 < q)
    (g : FiberDyadicLine → ℂ) (hg : Measurable g)
    (a : ℝ) (ha : 0 ≤ a) (hga : ∀ x, ‖g x‖ ≤ a)
    (hgp : MemLp g (ENNReal.ofReal q) volume) :
    (∑ i ∈ S, ∫ x : FiberDyadicLine,
      ‖g x‖ * scratchLp_intervalTail (c i) (2 * r i)
        (realToFiberDyadicLine.symm x)) ≤
      64 * (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal *
        (∫ u in ⋃ i ∈ S, Ioo (c i - r i) (c i + r i),
          (dyadicBallMaximal 1 g (realToFiberDyadicLine u)) ^ q) ^ (1 / q) *
        (volume (⋃ i ∈ S, Ioo (c i - r i) (c i + r i))).toReal ^ (1 / p) := by
  let U : Set ℝ := ⋃ i ∈ S, Ioo (c i - r i) (c i + r i)
  let M : ℝ → ℝ := fun u => dyadicBallMaximal 1 g (realToFiberDyadicLine u)
  let V : ℝ := (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal
  have hUfinite : volume U < ∞ := by
    simpa [U] using scratchLp_measure_union_finset_intervals_lt_top S c r
  let : IsFiniteMeasure (volume.restrict U) := ⟨by
    simpa only [Measure.restrict_apply_univ] using hUfinite⟩
  have hMmem : MemLp M (ENNReal.ofReal q) volume := by
    simpa [M] using scratchLp_real_dyadicBallMaximal_memLp
      g hg ⟨a, ha, hga⟩ hq hgp
  have hMnonneg (u : ℝ) : 0 ≤ M u := by
    dsimp [M]
    exact ENNReal.toReal_nonneg
  have hVnonneg : 0 ≤ V := by
    dsimp [V]
    exact ENNReal.toReal_nonneg
  have htest := scratchLp_finset_pairwiseDisjoint_intervalTail_lineTesting_le
    S c r hr hdisj g hg a ha hga
  have htest' :
      (∑ i ∈ S, ∫ x : FiberDyadicLine,
        ‖g x‖ * scratchLp_intervalTail (c i) (2 * r i)
          (realToFiberDyadicLine.symm x)) ≤
        (64 * V) * ∫ u in U, M u := by
    calc
      (∑ i ∈ S, ∫ x : FiberDyadicLine,
          ‖g x‖ * scratchLp_intervalTail (c i) (2 * r i)
            (realToFiberDyadicLine.symm x)) ≤
          64 * (∫ u in U, M u * V) := by
        simpa [U, M, V] using htest
      _ = (64 * V) * ∫ u in U, M u := by
        rw [integral_mul_const]
        ring
  have hholder := integral_mul_norm_le_Lp_mul_Lq hpq
    (hMmem.restrict U)
    (memLp_const (1 : ℝ) : MemLp (fun _ : ℝ => (1 : ℝ))
      (ENNReal.ofReal p) (volume.restrict U))
  have hleft : (∫ u in U, M u) =
      ∫ u, ‖M u‖ * ‖(1 : ℝ)‖ ∂(volume.restrict U) := by
    apply integral_congr_ae
    filter_upwards with u
    rw [Real.norm_of_nonneg (hMnonneg u), norm_one, mul_one]
  have hfirst :
      (∫ u, ‖M u‖ ^ q ∂(volume.restrict U)) =
        ∫ u in U, (M u) ^ q := by
    apply integral_congr_ae
    filter_upwards with u
    rw [Real.norm_of_nonneg (hMnonneg u)]
  have hsecond :
      (∫ u, ‖(1 : ℝ)‖ ^ p ∂(volume.restrict U)) =
        (volume U).toReal := by
    rw [norm_one, Real.one_rpow]
    change (∫ _u in U, (1 : ℝ)) = (volume U).toReal
    rw [setIntegral_const, smul_eq_mul]
    simp [Measure.real]
  have hcut : (∫ u in U, M u) ≤
      (∫ u in U, (M u) ^ q) ^ (1 / q) *
        (volume U).toReal ^ (1 / p) := by
    calc
      (∫ u in U, M u) =
          ∫ u, ‖M u‖ * ‖(1 : ℝ)‖ ∂(volume.restrict U) := hleft
      _ ≤ (∫ u, ‖M u‖ ^ q ∂(volume.restrict U)) ^ (1 / q) *
          (∫ u, ‖(1 : ℝ)‖ ^ p ∂(volume.restrict U)) ^ (1 / p) := hholder
      _ = (∫ u in U, (M u) ^ q) ^ (1 / q) *
          (volume U).toReal ^ (1 / p) := by rw [hfirst, hsecond]
  calc
    (∑ i ∈ S, ∫ x : FiberDyadicLine,
        ‖g x‖ * scratchLp_intervalTail (c i) (2 * r i)
          (realToFiberDyadicLine.symm x)) ≤
        (64 * V) * ∫ u in U, M u := htest'
    _ ≤ (64 * V) *
        ((∫ u in U, (M u) ^ q) ^ (1 / q) *
          (volume U).toReal ^ (1 / p)) :=
      mul_le_mul_of_nonneg_left hcut (mul_nonneg (by norm_num) hVnonneg)
    _ = 64 * (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal *
        (∫ u in ⋃ i ∈ S, Ioo (c i - r i) (c i + r i),
          (dyadicBallMaximal 1 g (realToFiberDyadicLine u)) ^ q) ^ (1 / q) *
        (volume (⋃ i ∈ S, Ioo (c i - r i) (c i + r i))).toReal ^ (1 / p) := by
      simp [U, M, V]
      ring

/-- The same cutoff terminal stated with the canonical interval tail used by
the scale-integrated bad-fiber estimate. This is a definitional bridge, but
keeping it named removes all local-tail rewriting at the scale interface. -/
theorem scratchLp_finset_pairwiseDisjoint_canonicalIntervalTail_holder_cutoff_le
    {ι : Type*} (S : Finset ι) (c r : ι → ℝ)
    (hr : ∀ i ∈ S, 0 < r i)
    (hdisj : (↑S : Set ι).PairwiseDisjoint
      (fun i => Ioo (c i - r i) (c i + r i)))
    {p q : ℝ} (hpq : q.HolderConjugate p) (hq : 1 < q)
    (g : FiberDyadicLine → ℂ) (hg : Measurable g)
    (a : ℝ) (ha : 0 ≤ a) (hga : ∀ x, ‖g x‖ ≤ a)
    (hgp : MemLp g (ENNReal.ofReal q) volume) :
    (∑ i ∈ S, ∫ x : FiberDyadicLine,
      ‖g x‖ * intervalTail (c i) (2 * r i)
        (realToFiberDyadicLine.symm x)) ≤
      64 * (volume (Metric.ball (0 : FiberDyadicLine) 1)).toReal *
        (∫ u in ⋃ i ∈ S, Ioo (c i - r i) (c i + r i),
          (dyadicBallMaximal 1 g (realToFiberDyadicLine u)) ^ q) ^ (1 / q) *
        (volume (⋃ i ∈ S, Ioo (c i - r i) (c i + r i))).toReal ^ (1 / p) := by
  simpa only [scratchLp_intervalTail, intervalTail] using
    scratchLp_finset_pairwiseDisjoint_intervalTail_holder_cutoff_le
      S c r hr hdisj hpq hq g hg a ha hga hgp


