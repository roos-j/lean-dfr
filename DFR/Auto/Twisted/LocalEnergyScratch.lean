/-- The literal model-energy density separates into the four passive factors
and the translated annular factor. -/
theorem scratch_modelEnergyDensity_eq_core_mul_annular
    (α : Anisotropy) (u p : E3) (t : ℝ) (z : ModelE5) :
    modelEnergyDensity α u p t z =
      scratch_modelFirstEnergyDensityCore α u p t
        (z 0) (z 1) (z 2) (z 3) *
      |conePsiPhysicalReal (z 4 + u 2)| := by
  rfl

/-- The energy density admits the scaled Gaussian-superposition domination
used in both Section 5 local-energy estimates. -/
theorem scratch_modelEnergyDensity_le_superposition :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (α : Anisotropy) (u p : E3)
      (t : ℝ) (z : ModelE5), 0 < t →
      modelEnergyDensity α u p t z ≤
        C * sourceWeight u ^ 50 * |conePsiPhysicalReal (z 4 + u 2)| *
          ∫ lam in Set.Ici (1 : ℝ),
            scratch_modelFirstPassiveGaussianWeight α lam p t
              (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ) := by
  rcases scratch_modelFirstEnergyDensityCore_le_superposition with
    ⟨C, hC, hcore⟩
  refine ⟨C, hC, ?_⟩
  intro α u p t z ht
  have h := hcore α u p t (z 0) (z 1) (z 2) (z 3) ht
  have hann : 0 ≤ |conePsiPhysicalReal (z 4 + u 2)| := abs_nonneg _
  rw [scratch_modelEnergyDensity_eq_core_mul_annular]
  calc
    scratch_modelFirstEnergyDensityCore α u p t
          (z 0) (z 1) (z 2) (z 3) *
        |conePsiPhysicalReal (z 4 + u 2)| ≤
        (C * sourceWeight u ^ 50 *
          ∫ lam in Set.Ici (1 : ℝ),
            scratch_modelFirstPassiveGaussianWeight α lam p t
              (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ)) *
          |conePsiPhysicalReal (z 4 + u 2)| :=
      mul_le_mul_of_nonneg_right h hann
    _ = C * sourceWeight u ^ 50 * |conePsiPhysicalReal (z 4 + u 2)| *
          ∫ lam in Set.Ici (1 : ℝ),
            scratch_modelFirstPassiveGaussianWeight α lam p t
              (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ) := by ring

/-- The four-Gaussian passive weight is nonnegative in the source scale
range. -/
theorem scratch_modelFirstPassiveGaussianWeight_nonneg
    (α : Anisotropy) (lam : ℝ) (p : E3) (t x₁ x₂ y₁ y₂ : ℝ)
    (hlam : 1 ≤ lam) (ht : 0 < t) :
    0 ≤ scratch_modelFirstPassiveGaussianWeight α lam p t x₁ x₂ y₁ y₂ := by
  have hs0 : 0 < lam * t ^ α.weight 0 :=
    mul_pos (by linarith) (pow_pos ht _)
  have hs1 : 0 < lam * t ^ α.weight 1 :=
    mul_pos (by linarith) (pow_pos ht _)
  unfold scratch_modelFirstPassiveGaussianWeight gaussianAt kernelAt kernelDilate
  simp only [smul_eq_mul]
  repeat' apply mul_nonneg
  all_goals first | exact inv_nonneg.mpr hs0.le | exact inv_nonneg.mpr hs1.le |
    exact gaussian_nonneg _

/-- The passive superposition integral is nonnegative on the source scale
range. -/
theorem scratch_integral_modelFirstPassiveGaussianWeight_nonneg
    (α : Anisotropy) (p : E3) (t x₁ x₂ y₁ y₂ : ℝ) (ht : 0 < t) :
    0 ≤ ∫ lam in Set.Ici (1 : ℝ),
      scratch_modelFirstPassiveGaussianWeight α lam p t x₁ x₂ y₁ y₂ *
        lam ^ (-47 : ℝ) := by
  apply integral_nonneg_of_ae
  filter_upwards [ae_restrict_mem measurableSet_Ici] with lam hlam
  exact mul_nonneg
    (scratch_modelFirstPassiveGaussianWeight_nonneg α lam p t x₁ x₂ y₁ y₂
      hlam ht)
    (Real.rpow_nonneg (le_trans zero_le_one hlam) _)

/-- Combining the four-factor superposition with the translated annular
decay yields the `U(u)^100 R(r)^{-50}` pointwise majorant used for the
second local energy. -/
theorem scratch_modelEnergyDensity_le_second_superposition :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (α : Anisotropy) (u p : E3)
      (t : ℝ) (z : ModelE5), 0 < t →
      modelEnergyDensity α u p t z ≤
        C * sourceWeight u ^ 100 * translationWeight (z 4) ^ (-50 : ℝ) *
          ∫ lam in Set.Ici (1 : ℝ),
            scratch_modelFirstPassiveGaussianWeight α lam p t
              (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ) := by
  rcases scratch_modelEnergyDensity_le_superposition with ⟨C₁, hC₁, hfirst⟩
  rcases conePsiPhysicalReal_translate_decay with ⟨C₂, hC₂, hpsi⟩
  refine ⟨C₁ * C₂, mul_nonneg hC₁ hC₂, ?_⟩
  intro α u p t z ht
  let I : ℝ := ∫ lam in Set.Ici (1 : ℝ),
    scratch_modelFirstPassiveGaussianWeight α lam p t
      (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ)
  have hI : 0 ≤ I := by
    exact scratch_integral_modelFirstPassiveGaussianWeight_nonneg
      α p t (z 0) (z 1) (z 2) (z 3) ht
  have hA : 0 ≤ C₁ * sourceWeight u ^ 50 * I := by
    exact mul_nonneg (mul_nonneg hC₁ (pow_nonneg (sourceWeight_nonneg u) _)) hI
  have hψ : |conePsiPhysicalReal (z 4 + u 2)| ≤
      C₂ * sourceWeight u ^ 50 * translationWeight (z 4) ^ (-50 : ℝ) :=
    (hpsi (z 4) u).1
  have hfirst' : modelEnergyDensity α u p t z ≤
      (C₁ * sourceWeight u ^ 50 * I) *
        |conePsiPhysicalReal (z 4 + u 2)| := by
    calc
      modelEnergyDensity α u p t z ≤
          C₁ * sourceWeight u ^ 50 *
            |conePsiPhysicalReal (z 4 + u 2)| * I :=
        hfirst α u p t z ht
      _ = (C₁ * sourceWeight u ^ 50 * I) *
            |conePsiPhysicalReal (z 4 + u 2)| := by ring
  calc
    modelEnergyDensity α u p t z ≤
        (C₁ * sourceWeight u ^ 50 * I) *
          |conePsiPhysicalReal (z 4 + u 2)| := hfirst'
    _ ≤ (C₁ * sourceWeight u ^ 50 * I) *
        (C₂ * sourceWeight u ^ 50 * translationWeight (z 4) ^ (-50 : ℝ)) :=
      mul_le_mul_of_nonneg_left hψ hA
    _ = (C₁ * C₂) * (sourceWeight u ^ 50 * sourceWeight u ^ 50) *
        translationWeight (z 4) ^ (-50 : ℝ) * I := by ring
    _ = (C₁ * C₂) * sourceWeight u ^ 100 *
        translationWeight (z 4) ^ (-50 : ℝ) * I := by
      rw [← pow_add]
    _ = (C₁ * C₂) * sourceWeight u ^ 100 *
        translationWeight (z 4) ^ (-50 : ℝ) *
          ∫ lam in Set.Ici (1 : ℝ),
            scratch_modelFirstPassiveGaussianWeight α lam p t
              (z 0) (z 1) (z 2) (z 3) * lam ^ (-47 : ℝ) := by
      rfl

/-- The passive Gaussian weight in the third-active local cube form is the
four Gaussian product `D_{λ,p,t}` from the first-energy superposition. -/
theorem scratch_cubePassiveGaussianKernel_modelFirst
    (α : Anisotropy) (lam r : ℝ) (p : E3) (t x₁ x₂ y₁ y₂ : ℝ) :
    cubePassiveGaussianKernel α 2 lam r t p
      (scratch_modelFirstPassivePair x₁ x₂ y₁ y₂) =
      scratch_modelFirstPassiveGaussianWeight α lam p t x₁ x₂ y₁ y₂ := by
  simp [cubePassiveGaussianKernel, cubeGaussianKernel, Fin.prod_univ_three,
    scratch_modelFirstPassivePair, scratch_modelFirstPassiveGaussianWeight,
    cubeWidth, cubeCenterShift]

/-- The literal fixed-center, fixed-scale change of variables for the first
local energy: the local cube integrand is the product of two first-fiber
integrands and the four-factor Gaussian superposition weight. -/
theorem scratch_localCubeIntegrand_modelFirst_activePassiveSplit_symm
    (α : Anisotropy) (lam : ℝ) (f : ModelRealInput)
    (p : E3) (t x₁ x₂ y₁ y₂ v w : ℝ) :
    cubeSignedInputProduct (scratch_modelFirstCubeTuple f)
      ((cubeActivePassiveSplit 2).symm
        ((v, w), scratch_modelFirstPassivePair x₁ x₂ y₁ y₂)) *
      localCubeKernel α 2 lam 0 t p
        ((cubeActivePassiveSplit 2).symm
          ((v, w), scratch_modelFirstPassivePair x₁ x₂ y₁ y₂)) =
      (scratch_modelFirstFiberIntegrand f x₁ x₂ y₁ y₂ v *
        gaussianDerivAt (t ^ α.weight 2) (p 2) v) *
      (scratch_modelFirstFiberIntegrand f x₁ x₂ y₁ y₂ w *
        gaussianDerivAt (t ^ α.weight 2) (p 2) w) *
      scratch_modelFirstPassiveGaussianWeight α lam p t x₁ x₂ y₁ y₂ := by
  rw [scratch_cubeSignedInputProduct_modelFirst_cubeActivePassiveSplit_symm,
    localCubeKernel_cubeActivePassiveSplit_symm,
    scratch_cubePassiveGaussianKernel_modelFirst]
  simp [cubeGaussianDerivKernel]
  ring

/-- Integrating the two active variables in the fixed first-energy cube
integrand gives the square of the first fiber times the passive four-Gaussian
weight.  This is the literal fixed-`(p,t,x₁,x₂,y₁,y₂)` identity behind the
first local-energy cube comparison. -/
theorem scratch_integral_localCubeIntegrand_modelFirst_active
    (α : Anisotropy) (lam : ℝ) (f : ModelRealInput)
    (p : E3) (t : ℝ) (z : ModelE5) :
    ∫ vw : ℝ × ℝ,
      cubeSignedInputProduct (scratch_modelFirstCubeTuple f)
        ((cubeActivePassiveSplit 2).symm
          ((vw.1, vw.2), scratch_modelFirstPassivePair
            (z 0) (z 1) (z 2) (z 3))) *
        localCubeKernel α 2 lam 0 t p
          ((cubeActivePassiveSplit 2).symm
            ((vw.1, vw.2), scratch_modelFirstPassivePair
              (z 0) (z 1) (z 2) (z 3))) =
      (modelFirstFiber α f p t z) ^ 2 *
        scratch_modelFirstPassiveGaussianWeight α lam p t
          (z 0) (z 1) (z 2) (z 3) := by
  let A : ℝ → ℝ := fun v ↦
    scratch_modelFirstFiberIntegrand f (z 0) (z 1) (z 2) (z 3) v *
      gaussianDerivAt (t ^ α.weight 2) (p 2) v
  let D : ℝ := scratch_modelFirstPassiveGaussianWeight α lam p t
    (z 0) (z 1) (z 2) (z 3)
  have hA : (∫ v : ℝ, A v) = modelFirstFiber α f p t z := by
    dsimp [A]
    rw [← scratch_modelFirstFiber_eq_integral]
  calc
    ∫ vw : ℝ × ℝ,
        cubeSignedInputProduct (scratch_modelFirstCubeTuple f)
          ((cubeActivePassiveSplit 2).symm
            ((vw.1, vw.2), scratch_modelFirstPassivePair
              (z 0) (z 1) (z 2) (z 3))) *
          localCubeKernel α 2 lam 0 t p
            ((cubeActivePassiveSplit 2).symm
              ((vw.1, vw.2), scratch_modelFirstPassivePair
                (z 0) (z 1) (z 2) (z 3))) =
        ∫ vw : ℝ × ℝ, D * (A vw.1 * A vw.2) := by
          apply integral_congr_ae
          filter_upwards [] with vw
          dsimp [A, D]
          rw [scratch_localCubeIntegrand_modelFirst_activePassiveSplit_symm]
          ring
    _ = D * ∫ vw : ℝ × ℝ, A vw.1 * A vw.2 :=
      MeasureTheory.integral_const_mul D _
    _ = D * ((∫ v : ℝ, A v) * ∫ w : ℝ, A w) := by
      congr 1
      rw [Measure.volume_eq_prod]
      exact MeasureTheory.integral_prod_mul A A
    _ = (modelFirstFiber α f p t z) ^ 2 *
        scratch_modelFirstPassiveGaussianWeight α lam p t
          (z 0) (z 1) (z 2) (z 3) := by
      rw [hA]
      dsimp [D]
      ring

/-- For the edge tuple, the two third-active cube variables are exactly the
two copies of the one-input second fiber integrand. -/
theorem scratch_cubeSignedInputProduct_edgeCubeTuple_activePassiveSplit_symm
    (f : E3 → ℝ) (x₁ x₂ y₁ y₂ v w : ℝ) :
    cubeSignedInputProduct (edgeCubeTuple f)
      ((cubeActivePassiveSplit 2).symm
        ((v, w), scratch_modelFirstPassivePair x₁ x₂ y₁ y₂)) =
      f (modelPoint x₁ x₂ v) * f (modelPoint x₁ x₂ w) := by
  have hp0 :
      faceInsert 2 v (cubePassiveProjection 2 (cubePairVertex false false)
        (scratch_modelFirstPassivePair x₁ x₂ y₁ y₂)) =
        modelPoint x₁ x₂ v := by
    ext k
    fin_cases k <;>
      simp [scratch_modelFirstPassivePair, cubePassiveProjection, faceInsert,
        cubePairVertex, modelPoint]
  have hp1 :
      faceInsert 2 w (cubePassiveProjection 2 (cubePairVertex false true)
        (scratch_modelFirstPassivePair x₁ x₂ y₁ y₂)) =
        modelPoint x₁ x₂ w := by
    ext k
    fin_cases k <;>
      simp [scratch_modelFirstPassivePair, cubePassiveProjection, faceInsert,
        cubePairVertex, modelPoint]
  rw [cubeSignedInputProduct_edgeCubeTuple,
    cubeProjection_cubeActivePassiveSplit_symm,
    cubeProjection_cubeActivePassiveSplit_symm]
  have h00 : ¬ cubePairVertex false false 2 = true := by
    simp [cubePairVertex]
  have h01 : cubePairVertex false true 2 = true := by
    simp [cubePairVertex]
  simp only [h00, h01, Bool.false_eq_true, ↓reduceIte]
  rw [hp0, hp1]

/-- The fixed-center, fixed-scale edge cube integrand is the product of two
second-fiber integrands and the same passive four-Gaussian weight. -/
theorem scratch_localCubeIntegrand_modelSecond_activePassiveSplit_symm
    (α : Anisotropy) (lam r : ℝ) (f : E3 → ℝ)
    (p : E3) (t x₁ x₂ y₁ y₂ v w : ℝ) :
    cubeSignedInputProduct (edgeCubeTuple f)
      ((cubeActivePassiveSplit 2).symm
        ((v, w), scratch_modelFirstPassivePair x₁ x₂ y₁ y₂)) *
      localCubeKernel α 2 lam r t p
        ((cubeActivePassiveSplit 2).symm
          ((v, w), scratch_modelFirstPassivePair x₁ x₂ y₁ y₂)) =
      (f (modelPoint x₁ x₂ v) *
        gaussianDerivAt (t ^ α.weight 2)
          (p 2 + r * t ^ α.weight 2) v) *
      (f (modelPoint x₁ x₂ w) *
        gaussianDerivAt (t ^ α.weight 2)
          (p 2 + r * t ^ α.weight 2) w) *
      scratch_modelFirstPassiveGaussianWeight α lam p t x₁ x₂ y₁ y₂ := by
  rw [scratch_cubeSignedInputProduct_edgeCubeTuple_activePassiveSplit_symm,
    localCubeKernel_cubeActivePassiveSplit_symm,
    scratch_cubePassiveGaussianKernel_modelFirst]
  simp [cubeGaussianDerivKernel]
  ring

/-- Integrating the two active variables in the edge cube integrand gives
the square of the second fiber, with its fifth model coordinate supplying
the translated third-coordinate center. -/
theorem scratch_integral_localCubeIntegrand_modelSecond_active
    (α : Anisotropy) (lam : ℝ) (f : E3 → ℝ)
    (p : E3) (t : ℝ) (z : ModelE5) :
    ∫ vw : ℝ × ℝ,
      cubeSignedInputProduct (edgeCubeTuple f)
        ((cubeActivePassiveSplit 2).symm
          ((vw.1, vw.2), scratch_modelFirstPassivePair
            (z 0) (z 1) (z 2) (z 3))) *
        localCubeKernel α 2 lam (z 4) t p
          ((cubeActivePassiveSplit 2).symm
            ((vw.1, vw.2), scratch_modelFirstPassivePair
              (z 0) (z 1) (z 2) (z 3))) =
      (modelSecondFiber α f p t z) ^ 2 *
        scratch_modelFirstPassiveGaussianWeight α lam p t
          (z 0) (z 1) (z 2) (z 3) := by
  let A : ℝ → ℝ := fun v ↦
    f (modelPoint (z 0) (z 1) v) *
      gaussianDerivAt (t ^ α.weight 2)
        (p 2 + z 4 * t ^ α.weight 2) v
  let D : ℝ := scratch_modelFirstPassiveGaussianWeight α lam p t
    (z 0) (z 1) (z 2) (z 3)
  have hA : (∫ v : ℝ, A v) = modelSecondFiber α f p t z := by
    dsimp [A]
    rfl
  calc
    ∫ vw : ℝ × ℝ,
        cubeSignedInputProduct (edgeCubeTuple f)
          ((cubeActivePassiveSplit 2).symm
            ((vw.1, vw.2), scratch_modelFirstPassivePair
              (z 0) (z 1) (z 2) (z 3))) *
          localCubeKernel α 2 lam (z 4) t p
            ((cubeActivePassiveSplit 2).symm
              ((vw.1, vw.2), scratch_modelFirstPassivePair
                (z 0) (z 1) (z 2) (z 3))) =
        ∫ vw : ℝ × ℝ, D * (A vw.1 * A vw.2) := by
          apply integral_congr_ae
          filter_upwards [] with vw
          dsimp [A, D]
          rw [scratch_localCubeIntegrand_modelSecond_activePassiveSplit_symm]
          ring
    _ = D * ∫ vw : ℝ × ℝ, A vw.1 * A vw.2 :=
      MeasureTheory.integral_const_mul D _
    _ = D * ((∫ v : ℝ, A v) * ∫ w : ℝ, A w) := by
      congr 1
      rw [Measure.volume_eq_prod]
      exact MeasureTheory.integral_prod_mul A A
    _ = (modelSecondFiber α f p t z) ^ 2 *
        scratch_modelFirstPassiveGaussianWeight α lam p t
          (z 0) (z 1) (z 2) (z 3) := by
      rw [hA]
      dsimp [D]
      ring

end

