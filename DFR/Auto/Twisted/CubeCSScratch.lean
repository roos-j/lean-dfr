/-- The signed real Cauchy--Schwarz estimate in squared form.  This is the
analytic inequality used after the active-coordinate Fubini factorization in
the cubical Cauchy--Schwarz argument. -/
theorem abs_integral_mul_sq_le_integral_sq_mul
    {X : Type*} [MeasurableSpace X] (μ : Measure X) (f g : X → ℝ)
    (hfmeas : AEStronglyMeasurable f μ) (hgmeas : AEStronglyMeasurable g μ)
    (hfsq : Integrable (fun x ↦ f x ^ 2) μ)
    (hgsq : Integrable (fun x ↦ g x ^ 2) μ) :
    |∫ x, f x * g x ∂μ| ^ 2 ≤
      (∫ x, f x ^ 2 ∂μ) * ∫ x, g x ^ 2 ∂μ := by
  have hfsqabs : Integrable (fun x ↦ |f x| ^ 2) μ := by
    simpa only [sq_abs] using hfsq
  have hgsqabs : Integrable (fun x ↦ |g x| ^ 2) μ := by
    simpa only [sq_abs] using hgsq
  have hcs := integral_mul_le_sqrt_integral_sq μ (fun x ↦ |f x|)
    (fun x ↦ |g x|) hfmeas.norm hgmeas.norm
    (Filter.Eventually.of_forall fun x ↦ abs_nonneg (f x))
    (Filter.Eventually.of_forall fun x ↦ abs_nonneg (g x)) hfsqabs hgsqabs
  have habs : |∫ x, f x * g x ∂μ| ≤ ∫ x, |f x| * |g x| ∂μ := by
    calc
      |∫ x, f x * g x ∂μ| ≤ ∫ x, |f x * g x| ∂μ :=
        MeasureTheory.abs_integral_le_integral_abs
      _ = ∫ x, |f x| * |g x| ∂μ := by
        apply integral_congr_ae
        filter_upwards [] with x
        rw [abs_mul]
  have hbound : |∫ x, f x * g x ∂μ| ≤
      √(∫ x, f x ^ 2 ∂μ) * √(∫ x, g x ^ 2 ∂μ) := by
    simpa only [sq_abs] using habs.trans hcs
  have hfnonneg : 0 ≤ ∫ x, f x ^ 2 ∂μ :=
    integral_nonneg fun x ↦ sq_nonneg (f x)
  have hgnonneg : 0 ≤ ∫ x, g x ^ 2 ∂μ :=
    integral_nonneg fun x ↦ sq_nonneg (g x)
  have hright : 0 ≤ √(∫ x, f x ^ 2 ∂μ) * √(∫ x, g x ^ 2 ∂μ) :=
    mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
  calc
    |∫ x, f x * g x ∂μ| ^ 2 ≤
        (√(∫ x, f x ^ 2 ∂μ) * √(∫ x, g x ^ 2 ∂μ)) ^ 2 :=
      (sq_le_sq₀ (abs_nonneg _) hright).2 hbound
    _ = (∫ x, f x ^ 2 ∂μ) * ∫ x, g x ^ 2 ∂μ := by
      rw [mul_pow, Real.sq_sqrt hfnonneg, Real.sq_sqrt hgnonneg]

