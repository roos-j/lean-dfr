                (E3 × E3) × (E3 × ℝ) ≃ᵐ E3 × (E3 × (E3 × ℝ)))
              (((volume : Measure E3).prod volume).prod
                ((volume : Measure E3).prod volume))
              ((volume : Measure E3).prod
                ((volume : Measure E3).prod ((volume : Measure E3).prod volume))) :=
            measurePreserving_prodAssoc volume volume
              ((volume : Measure E3).prod volume)
          calc
            (∫ q : (E3 × E3) × (E3 × ℝ), H q) =
                ∫ q : (E3 × E3) × (E3 × ℝ),
                  A (MeasurableEquiv.prodAssoc q).1 *
                    (P (MeasurableEquiv.prodAssoc q).2.1 *
                      Q (MeasurableEquiv.prodAssoc q).2.2) := by
                apply integral_congr_ae
                filter_upwards [] with q
                rcases q with ⟨⟨x, a⟩, br⟩
                change A x * P a * Q br = A x * (P a * Q br)
                ring
            _ =
                ∫ q : E3 × (E3 × (E3 × ℝ)),
                  A q.1 * (P q.2.1 * Q q.2.2) :=
              by
                exact hassoc.integral_comp
                  MeasurableEquiv.prodAssoc.measurableEmbedding
                  (fun q : E3 × (E3 × (E3 × ℝ)) ↦ A q.1 *
                    (P q.2.1 * Q q.2.2))
            _ = (∫ x : E3, A x) *
                ∫ q : E3 × (E3 × ℝ), P q.1 * Q q.2 := by
              exact integral_prod_mul A (fun q : E3 × (E3 × ℝ) ↦ P q.1 * Q q.2)
            _ = (∫ x : E3, A x) *
                ((∫ a : E3, P a) * ∫ br : E3 × ℝ, Q br) := by
              congr 1
              exact integral_prod_mul P Q
    _ = |c t| * (∫ x : E3, A x) *
          ((∫ r : ℝ, |conePhiPhysicalReal r|) ^ 2 *
            ∫ r : ℝ, |gaussianDeriv r|) *
          ((∫ r : ℝ, |gaussianDeriv r|) * conePsiPhysicalRealL1) := by
          rw [show (∫ a : E3, P a) =
              (∫ r : ℝ, |conePhiPhysicalReal r|) ^ 2 *
                ∫ r : ℝ, |gaussianDeriv r| by
                dsimp only [P]
                exact scratch_integral_centerP_neg α u t ht,
            show (∫ br : E3 × ℝ, Q br) =
              (∫ r : ℝ, |gaussianDeriv r|) * conePsiPhysicalRealL1 by
                dsimp only [Q]
                exact scratch_integral_centerQ α u t ht]
          ring

/-- The separated center majorant is measurable jointly in scale and all
center/difference variables whenever its base factor and coefficient are
measurable. -/
theorem scratch_measurable_centerMajorant_joint
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (A : E3 → ℝ)
    (hc : Measurable c) (hA : Measurable A) :
    Measurable (fun z : ℝ × ((E3 × E3) × (E3 × ℝ)) ↦
      scratch_centerMajorant α u c A z.1 z.2) := by
  let X := ℝ × ((E3 × E3) × (E3 × ℝ))
  have ht : Measurable (fun z : X ↦ z.1) := measurable_fst
  have hx : Measurable (fun z : X ↦ z.2.1.1) :=
    measurable_fst.comp (measurable_fst.comp measurable_snd)
  have ha : Measurable (fun z : X ↦ z.2.1.2) :=
    measurable_snd.comp (measurable_fst.comp measurable_snd)
  have hb : Measurable (fun z : X ↦ z.2.2.1) :=
    measurable_fst.comp (measurable_snd.comp measurable_snd)
  have hr : Measurable (fun z : X ↦ z.2.2.2) :=
    measurable_snd.comp (measurable_snd.comp measurable_snd)
  have hxi (i : Fin 3) : Measurable (fun z : X ↦ z.2.1.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp hx
  have hai (i : Fin 3) : Measurable (fun z : X ↦ z.2.1.2 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp ha
  have hbi (i : Fin 3) : Measurable (fun z : X ↦ z.2.2.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp hb
  have hderiv : Measurable gaussianDeriv := by
    unfold gaussianDeriv
    exact (measurable_const.mul measurable_id).mul
      gaussian_contDiff.continuous.measurable
  have hphi₀ : Measurable (fun z : X ↦
      modelPhiAt (z.1 ^ α.weight 0) (z.1 ^ α.weight 0 * u 0)
        (-(z.2.1.2 0))) := by
    unfold modelPhiAt
    exact measurable_kernelAt conePhiPhysicalReal
      conePhiPhysicalReal.continuous.measurable _ _ _
      (ht.pow_const _) ((ht.pow_const _).mul measurable_const) (hai 0).neg
  have hphi₁ : Measurable (fun z : X ↦
      modelPhiAt (z.1 ^ α.weight 1) (z.1 ^ α.weight 1 * u 1)
        (-(z.2.1.2 1))) := by
    unfold modelPhiAt
    exact measurable_kernelAt conePhiPhysicalReal
      conePhiPhysicalReal.continuous.measurable _ _ _
      (ht.pow_const _) ((ht.pow_const _).mul measurable_const) (hai 1).neg
  have hderiv₀ : Measurable (fun z : X ↦
      gaussianDerivAt (z.1 ^ α.weight 2) 0 (-(z.2.1.2 2))) := by
    unfold gaussianDerivAt
    exact measurable_kernelAt gaussianDeriv hderiv _ _ _
      (ht.pow_const _) measurable_const (hai 2).neg
  have hgauss₀ : Measurable (fun z : X ↦
      gaussianAt (z.1 ^ α.weight 0) 0 (z.2.2.1 0)) := by
    unfold gaussianAt
    exact measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable
      _ _ _ (ht.pow_const _) measurable_const (hbi 0)
  have hgauss₁ : Measurable (fun z : X ↦
      gaussianAt (z.1 ^ α.weight 1) 0 (z.2.2.1 1)) := by
    unfold gaussianAt
    exact measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable
      _ _ _ (ht.pow_const _) measurable_const (hbi 1)
  have hderiv₁ : Measurable (fun z : X ↦
      gaussianDerivAt (z.1 ^ α.weight 2)
        (z.2.2.2 * z.1 ^ α.weight 2) (z.2.2.1 2)) := by
    unfold gaussianDerivAt
    exact measurable_kernelAt gaussianDeriv hderiv _ _ _
      (ht.pow_const _) (hr.mul (ht.pow_const _)) (hbi 2)
  have hpsi : Measurable (fun z : X ↦
      conePsiPhysicalReal (z.2.2.2 + u 2)) :=
    conePsiPhysicalReal.continuous.measurable.comp (hr.add measurable_const)
  have hc' : Measurable (fun z : X ↦ c z.1) := hc.comp ht
  have hcabs : Measurable (fun z : X ↦ |c z.1|) :=
    continuous_abs.measurable.comp hc'
  have hA' : Measurable (fun z : X ↦ A z.2.1.1) := hA.comp hx
  have hphi₀abs : Measurable (fun z : X ↦
      |modelPhiAt (z.1 ^ α.weight 0) (z.1 ^ α.weight 0 * u 0)
        (-(z.2.1.2 0))|) := continuous_abs.measurable.comp hphi₀
  have hphi₁abs : Measurable (fun z : X ↦
      |modelPhiAt (z.1 ^ α.weight 1) (z.1 ^ α.weight 1 * u 1)
        (-(z.2.1.2 1))|) := continuous_abs.measurable.comp hphi₁
  have hderiv₀abs : Measurable (fun z : X ↦
      |gaussianDerivAt (z.1 ^ α.weight 2) 0 (-(z.2.1.2 2))|) :=
    continuous_abs.measurable.comp hderiv₀
  have hgauss₀abs : Measurable (fun z : X ↦
      |gaussianAt (z.1 ^ α.weight 0) 0 (z.2.2.1 0)|) :=
    continuous_abs.measurable.comp hgauss₀
  have hgauss₁abs : Measurable (fun z : X ↦
      |gaussianAt (z.1 ^ α.weight 1) 0 (z.2.2.1 1)|) :=
    continuous_abs.measurable.comp hgauss₁
  have hderiv₁abs : Measurable (fun z : X ↦
      |gaussianDerivAt (z.1 ^ α.weight 2)
        (z.2.2.2 * z.1 ^ α.weight 2) (z.2.2.1 2)|) :=
    continuous_abs.measurable.comp hderiv₁
  have hpsiabs : Measurable (fun z : X ↦
      |conePsiPhysicalReal (z.2.2.2 + u 2)|) :=
    continuous_abs.measurable.comp hpsi
  have hleft : Measurable (fun z : X ↦
      |c z.1| * A z.2.1.1 *
        |modelPhiAt (z.1 ^ α.weight 0) (z.1 ^ α.weight 0 * u 0)
          (-(z.2.1.2 0))| *
        |modelPhiAt (z.1 ^ α.weight 1) (z.1 ^ α.weight 1 * u 1)
          (-(z.2.1.2 1))| *
        |gaussianDerivAt (z.1 ^ α.weight 2) 0 (-(z.2.1.2 2))|) :=
    ((((hcabs.mul hA').mul hphi₀abs).mul hphi₁abs).mul hderiv₀abs)
  have hright : Measurable (fun z : X ↦
      (|gaussianAt (z.1 ^ α.weight 0) 0 (z.2.2.1 0)| *
        |gaussianAt (z.1 ^ α.weight 1) 0 (z.2.2.1 1)|) *
      (|gaussianDerivAt (z.1 ^ α.weight 2)
          (z.2.2.2 * z.1 ^ α.weight 2) (z.2.2.1 2)| *
        |conePsiPhysicalReal (z.2.2.2 + u 2)|)) :=
    (hgauss₀abs.mul hgauss₁abs).mul (hderiv₁abs.mul hpsiabs)
  change Measurable (fun z : X ↦
    |c z.1| * A z.2.1.1 *
      (|modelPhiAt (z.1 ^ α.weight 0) (z.1 ^ α.weight 0 * u 0)
          ((-z.2.1.2) 0)| *
        |modelPhiAt (z.1 ^ α.weight 1) (z.1 ^ α.weight 1 * u 1)
          ((-z.2.1.2) 1)| *
        |gaussianDerivAt (z.1 ^ α.weight 2) 0 ((-z.2.1.2) 2)|) *
      ((|gaussianAt (z.1 ^ α.weight 0) 0 (z.2.2.1 0)| *
          |gaussianAt (z.1 ^ α.weight 1) 0 (z.2.2.1 1)|) *
        (|gaussianDerivAt (z.1 ^ α.weight 2)
            (z.2.2.2 * z.1 ^ α.weight 2) (z.2.2.1 2)| *
          |conePsiPhysicalReal (z.2.2.2 + u 2)|)))
  convert
    (((hcabs.mul hA').mul ((hphi₀abs.mul hphi₁abs).mul hderiv₀abs)).mul
      ((hgauss₀abs.mul hgauss₁abs).mul (hderiv₁abs.mul hpsiabs))) using 1
  rfl

/-- On every finite positive scale measure, the separated center majorant is
jointly integrable.  Its spatial mass is independent of the scale. -/
theorem scratch_integrable_centerMajorant_joint_of_isFinite
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (A : E3 → ℝ)
    (ν : Measure ℝ) [IsFiniteMeasure ν]
    (hc : Measurable c) (hcBound : ∀ t : ℝ, |c t| ≤ 1)
    (hAmeas : Measurable A) (hAint : Integrable A)
    (hAnonneg : ∀ x : E3, 0 ≤ A x)
    (hpos : ∀ᵐ t ∂ν, 0 < t) :
    Integrable (fun z : ℝ × ((E3 × E3) × (E3 × ℝ)) ↦
      scratch_centerMajorant α u c A z.1 z.2)
      (ν.prod (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume))) := by
  let μ : Measure ((E3 × E3) × (E3 × ℝ)) :=
    ((volume : Measure E3).prod volume).prod
      ((volume : Measure E3).prod volume)
  let Pmass : ℝ :=
    (∫ r : ℝ, |conePhiPhysicalReal r|) ^ 2 *
      ∫ r : ℝ, |gaussianDeriv r|
  let Qmass : ℝ :=
    (∫ r : ℝ, |gaussianDeriv r|) * conePsiPhysicalRealL1
  let K : ℝ := (∫ x : E3, A x) * Pmass * Qmass
  have hmeas : AEStronglyMeasurable (fun z : ℝ × ((E3 × E3) × (E3 × ℝ)) ↦
      scratch_centerMajorant α u c A z.1 z.2) (ν.prod μ) :=
    (scratch_measurable_centerMajorant_joint α u c A hc hAmeas).aestronglyMeasurable
  refine (integrable_prod_iff hmeas).mpr ⟨?_, ?_⟩
  · filter_upwards [hpos] with t ht
    simpa only [μ] using
      scratch_integrable_centerMajorant_fixed α u c A hAint t ht
  · have hAint_nonneg : 0 ≤ ∫ x : E3, A x :=
      integral_nonneg hAnonneg
    have hphi_nonneg : 0 ≤ ∫ r : ℝ, |conePhiPhysicalReal r| :=
      integral_nonneg fun _ ↦ abs_nonneg _
    have hderiv_nonneg : 0 ≤ ∫ r : ℝ, |gaussianDeriv r| :=
      integral_nonneg fun _ ↦ abs_nonneg _
    have hPmass_nonneg : 0 ≤ Pmass := by
      dsimp only [Pmass]
      exact mul_nonneg (sq_nonneg _) hderiv_nonneg
    have hQmass_nonneg : 0 ≤ Qmass := by
      dsimp only [Qmass]
      exact mul_nonneg hderiv_nonneg conePsiPhysicalRealL1_pos.le
    have hKnonneg : 0 ≤ K := by
      dsimp only [K]
      exact mul_nonneg (mul_nonneg hAint_nonneg hPmass_nonneg) hQmass_nonneg
    have hcoeff_meas : AEStronglyMeasurable (fun t : ℝ ↦ |c t| * K) ν :=
      ((continuous_abs.measurable.comp hc).mul measurable_const).aestronglyMeasurable
    have hcoeff : Integrable (fun t : ℝ ↦ |c t| * K) ν := by
      refine (integrable_const K).mono' hcoeff_meas ?_
      filter_upwards [] with t
      rw [Real.norm_eq_abs, abs_of_nonneg]
      · nlinarith [hcBound t, abs_nonneg (c t)]
      · exact mul_nonneg (abs_nonneg _) hKnonneg
    apply hcoeff.congr
    filter_upwards [hpos] with t ht
    symm
    calc
      (∫ q : (E3 × E3) × (E3 × ℝ),
        ‖scratch_centerMajorant α u c A t q‖) =
          ∫ q : (E3 × E3) × (E3 × ℝ),
            scratch_centerMajorant α u c A t q := by
              apply integral_congr_ae
              filter_upwards [] with q
              rw [Real.norm_eq_abs, abs_of_nonneg]
              have hP : 0 ≤ scratch_centerP α u t (-q.1.2) := by
                unfold scratch_centerP
                positivity
              have hQ : 0 ≤ scratch_centerQ α u t q.2 := by
                unfold scratch_centerQ
                positivity
              exact mul_nonneg
                (mul_nonneg
                  (mul_nonneg (abs_nonneg _) (hAnonneg q.1.1)) hP) hQ
      _ = |c t| * (∫ x : E3, A x) * Pmass * Qmass := by
            dsimp only [Pmass, Qmass]
            exact scratch_integral_centerMajorant_fixed α u c A hAint t ht
      _ = |c t| * K := by
            dsimp only [K]
            ring

/-- The two spatial difference shears carrying the raw center variables to
the separated majorant coordinates. -/
noncomputable def scratch_centerRawReorder :
    ((E3 × E3) × E3) × ℝ ≃ᵐ (E3 × E3) × (E3 × ℝ) :=
  let e₃ : (E3 × E3) × E3 ≃ᵐ (E3 × E3) × E3 :=
    ((MeasurableEquiv.prodAssoc.trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.prodComm : E3 × E3 ≃ᵐ E3 × E3))).trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.shearSubRight E3))).trans
      MeasurableEquiv.prodAssoc.symm
  ((MeasurableEquiv.prodCongr e₃ (MeasurableEquiv.refl ℝ)).trans
    MeasurableEquiv.prodAssoc).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.shearSubRight E3)
      (MeasurableEquiv.refl (E3 × ℝ)))

/-- The raw-center difference shear preserves the four-dimensional product
Lebesgue measure. -/
theorem scratch_centerRawReorder_measurePreserving :
    MeasurePreserving scratch_centerRawReorder
      ((((volume : Measure E3).prod volume).prod volume).prod volume)
      (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume)) := by
  let e₃ : (E3 × E3) × E3 ≃ᵐ (E3 × E3) × E3 :=
    ((MeasurableEquiv.prodAssoc.trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.prodComm : E3 × E3 ≃ᵐ E3 × E3))).trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.shearSubRight E3))).trans
      MeasurableEquiv.prodAssoc.symm
  let e : ((E3 × E3) × E3) × ℝ ≃ᵐ
      (E3 × E3) × (E3 × ℝ) :=
    (MeasurableEquiv.prodCongr e₃ (MeasurableEquiv.refl ℝ)).trans
      MeasurableEquiv.prodAssoc
  have hassoc : MeasurePreserving
      (MeasurableEquiv.prodAssoc : (E3 × E3) × E3 ≃ᵐ E3 × (E3 × E3))
      (((volume : Measure E3).prod volume).prod volume)
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume)) :=
    measurePreserving_prodAssoc volume volume volume
  have hswap : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.prodComm : E3 × E3 ≃ᵐ E3 × E3))
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume))
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume)) := by
    exact (MeasurePreserving.id (volume : Measure E3)).prod
      (MeasureTheory.Measure.measurePreserving_swap
        (μ := (volume : Measure E3)) (ν := (volume : Measure E3)))
  have hshear : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl E3)
        (MeasurableEquiv.shearSubRight E3))
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume))
      ((volume : Measure E3).prod ((volume : Measure E3).prod volume)) := by
    have hsub : MeasurePreserving (fun z : E3 × E3 ↦ (z.1, z.2 - z.1))
        ((volume : Measure E3).prod volume)
        ((volume : Measure E3).prod volume) :=
      measurePreserving_prod_sub volume volume
    have hprod := (MeasurePreserving.id (volume : Measure E3)).prod hsub
    convert hprod using 1
    rfl
  have he₃ : MeasurePreserving e₃
      (((volume : Measure E3).prod volume).prod volume)
      (((volume : Measure E3).prod volume).prod volume) := by
    dsimp only [e₃]
    exact ((hassoc.trans hswap).trans hshear).trans hassoc.symm
  have he : MeasurePreserving e
      ((((volume : Measure E3).prod volume).prod volume).prod volume)
      (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume)) := by
    dsimp only [e]
    exact (he₃.prod (MeasurePreserving.id (volume : Measure ℝ))).trans
      (measurePreserving_prodAssoc
        ((volume : Measure E3).prod volume) volume volume)
  have hlast : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.shearSubRight E3)
        (MeasurableEquiv.refl (E3 × ℝ)))
      (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume))
      (((volume : Measure E3).prod volume).prod
        ((volume : Measure E3).prod volume)) := by
    have hsub : MeasurePreserving (fun z : E3 × E3 ↦ (z.1, z.2 - z.1))
        ((volume : Measure E3).prod volume)
        ((volume : Measure E3).prod volume) :=
      measurePreserving_prod_sub volume volume
    have hprod := hsub.prod
      (MeasurePreserving.id
        ((volume : Measure E3).prod (volume : Measure ℝ)))
    convert hprod using 1
    rfl
  change MeasurePreserving
    (((MeasurableEquiv.prodCongr e₃ (MeasurableEquiv.refl ℝ)).trans
      MeasurableEquiv.prodAssoc).trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.shearSubRight E3)
        (MeasurableEquiv.refl (E3 × ℝ)))) _ _
  exact he.trans hlast

@[simp] theorem scratch_centerRawReorder_apply
    (x y p : E3) (r : ℝ) :
    scratch_centerRawReorder (((x, y), p), r) =
      ((x, p - x), (y - p, r)) := by
  simp [scratch_centerRawReorder, MeasurableEquiv.trans_apply,
    MeasurableEquiv.prodCongr, MeasurableEquiv.prodAssoc,
    MeasurableEquiv.prodComm, MeasurableEquiv.shearSubRight]

/-- The pulled-back separated majorant in the original raw center order. -/
noncomputable def scratch_rawCenterMajorant
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (A : E3 → ℝ)
    (z : ℝ × (((E3 × E3) × E3) × ℝ)) : ℝ :=
  scratch_centerMajorant α u c A z.1 (scratch_centerRawReorder z.2)

/-- Pulling the separated majorant through the two spatial shears preserves
joint integrability. -/
theorem scratch_integrable_rawCenterMajorant_of_isFinite
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (A : E3 → ℝ)
    (ν : Measure ℝ) [IsFiniteMeasure ν]
    (hc : Measurable c) (hcBound : ∀ t : ℝ, |c t| ≤ 1)
    (hAmeas : Measurable A) (hAint : Integrable A)
    (hAnonneg : ∀ x : E3, 0 ≤ A x)
    (hpos : ∀ᵐ t ∂ν, 0 < t) :
    Integrable (scratch_rawCenterMajorant α u c A)
      (ν.prod ((((volume : Measure E3).prod volume).prod volume).prod volume)) := by
  let η : Measure (((E3 × E3) × E3) × ℝ) :=
    (((volume : Measure E3).prod volume).prod volume).prod volume
  let μ : Measure ((E3 × E3) × (E3 × ℝ)) :=
    ((volume : Measure E3).prod volume).prod
      ((volume : Measure E3).prod volume)
  have hbase : Integrable (fun z : ℝ × ((E3 × E3) × (E3 × ℝ)) ↦
      scratch_centerMajorant α u c A z.1 z.2) (ν.prod μ) := by
    simpa only [μ] using scratch_integrable_centerMajorant_joint_of_isFinite
      α u c A ν hc hcBound hAmeas hAint hAnonneg hpos
  have hmp : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ) scratch_centerRawReorder)
      (ν.prod η) (ν.prod μ) := by
    exact (MeasurePreserving.id ν).prod scratch_centerRawReorder_measurePreserving
  apply hmp.integrable_comp_of_integrable hbase |>.congr
  filter_upwards [] with z
  rfl

/-- The raw center-translation integrand, including a measurable scale
coefficient, is jointly measurable before any estimate is applied. -/
theorem scratch_measurable_coefficient_centerTranslation
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (hc : Measurable c) :
    Measurable (fun z : ℝ × (((E3 × E3) × E3) × ℝ) ↦
      c z.1 * ModelCenterTranslationIntegrand α u F z.1 z.2) := by
  let X := ℝ × (((E3 × E3) × E3) × ℝ)
  have ht : Measurable (fun z : X ↦ z.1) := measurable_fst
  have hx : Measurable (fun z : X ↦ z.2.1.1.1) :=
    measurable_fst.comp (measurable_fst.comp (measurable_fst.comp measurable_snd))
  have hy : Measurable (fun z : X ↦ z.2.1.1.2) :=
    measurable_snd.comp (measurable_fst.comp (measurable_fst.comp measurable_snd))
  have hp : Measurable (fun z : X ↦ z.2.1.2) :=
    measurable_snd.comp (measurable_fst.comp measurable_snd)
  have hr : Measurable (fun z : X ↦ z.2.2) :=
    measurable_snd.comp measurable_snd
  have hxi (i : Fin 3) : Measurable (fun z : X ↦ z.2.1.1.1 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp hx
  have hyi (i : Fin 3) : Measurable (fun z : X ↦ z.2.1.1.2 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp hy
  have hpi (i : Fin 3) : Measurable (fun z : X ↦ z.2.1.2 i) :=
    (PiLp.continuous_apply (p := 2) (β := fun _ : Fin 3 ↦ ℝ) i).measurable.comp hp
  have hderiv : Measurable gaussianDeriv := by
    unfold gaussianDeriv
    exact (measurable_const.mul measurable_id).mul
      gaussian_contDiff.continuous.measurable
  have h0 : Measurable (fun z : X ↦ F 0 z.2.1.1.1) :=
    (F 0).continuous.measurable.comp hx
  have h1 : Measurable (fun z : X ↦
      F 1 (modelPoint (z.2.1.1.2 0) (z.2.1.1.1 1) (z.2.1.1.1 2))) :=
    (F 1).continuous.measurable.comp
      (measurable_modelPoint _ _ _ (hyi 0) (hxi 1) (hxi 2))
  have h2 : Measurable (fun z : X ↦
      F 2 (modelPoint (z.2.1.1.1 0) (z.2.1.1.2 1) (z.2.1.1.1 2))) :=
    (F 2).continuous.measurable.comp
      (measurable_modelPoint _ _ _ (hxi 0) (hyi 1) (hxi 2))
  have h3 : Measurable (fun z : X ↦
      F 3 (modelPoint (z.2.1.1.1 0) (z.2.1.1.1 1) (z.2.1.1.2 2))) :=
    (F 3).continuous.measurable.comp
      (measurable_modelPoint _ _ _ (hxi 0) (hxi 1) (hyi 2))
  have hphi0 : Measurable (fun z : X ↦
      modelPhiAt (z.1 ^ α.weight 0)
        (z.2.1.2 0 + z.1 ^ α.weight 0 * u 0) (z.2.1.1.1 0)) :=
    measurable_kernelAt conePhiPhysicalReal
      conePhiPhysicalReal.continuous.measurable _ _ _
      (ht.pow_const _) ((hpi 0).add ((ht.pow_const _).mul measurable_const)) (hxi 0)
  have hgauss0 : Measurable (fun z : X ↦
      gaussianAt (z.1 ^ α.weight 0) (z.2.1.2 0) (z.2.1.1.2 0)) :=
    measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable _ _ _
      (ht.pow_const _) (hpi 0) (hyi 0)
  have hphi1 : Measurable (fun z : X ↦
      modelPhiAt (z.1 ^ α.weight 1)
        (z.2.1.2 1 + z.1 ^ α.weight 1 * u 1) (z.2.1.1.1 1)) :=
    measurable_kernelAt conePhiPhysicalReal
      conePhiPhysicalReal.continuous.measurable _ _ _
      (ht.pow_const _) ((hpi 1).add ((ht.pow_const _).mul measurable_const)) (hxi 1)
  have hgauss1 : Measurable (fun z : X ↦
      gaussianAt (z.1 ^ α.weight 1) (z.2.1.2 1) (z.2.1.1.2 1)) :=
    measurable_kernelAt gaussian gaussian_contDiff.continuous.measurable _ _ _
      (ht.pow_const _) (hpi 1) (hyi 1)
  have hderiv0 : Measurable (fun z : X ↦
      gaussianDerivAt (z.1 ^ α.weight 2) (z.2.1.2 2) (z.2.1.1.1 2)) :=
    measurable_kernelAt gaussianDeriv hderiv _ _ _
      (ht.pow_const _) (hpi 2) (hxi 2)
  have hderiv1 : Measurable (fun z : X ↦
      gaussianDerivAt (z.1 ^ α.weight 2)
        (z.2.1.2 2 + z.2.2 * z.1 ^ α.weight 2) (z.2.1.1.2 2)) :=
    measurable_kernelAt gaussianDeriv hderiv _ _ _
      (ht.pow_const _) ((hpi 2).add (hr.mul (ht.pow_const _))) (hyi 2)
  have hpsi : Measurable (fun z : X ↦
      conePsiPhysicalReal (z.2.2 + u 2)) :=
    conePsiPhysicalReal.continuous.measurable.comp (hr.add measurable_const)
  have hc' : Measurable (fun z : X ↦ c z.1) := hc.comp ht
  change Measurable (fun z : X ↦ c z.1 *
    ((F 0 z.2.1.1.1 * F 1 (modelPoint (z.2.1.1.2 0)
          (z.2.1.1.1 1) (z.2.1.1.1 2)) *
        F 2 (modelPoint (z.2.1.1.1 0) (z.2.1.1.2 1) (z.2.1.1.1 2)) *
        F 3 (modelPoint (z.2.1.1.1 0) (z.2.1.1.1 1) (z.2.1.1.2 2))) *
      ((modelPhiAt (z.1 ^ α.weight 0)
          (z.2.1.2 0 + z.1 ^ α.weight 0 * u 0) (z.2.1.1.1 0) *
        gaussianAt (z.1 ^ α.weight 0) (z.2.1.2 0) (z.2.1.1.2 0)) *
      (modelPhiAt (z.1 ^ α.weight 1)
          (z.2.1.2 1 + z.1 ^ α.weight 1 * u 1) (z.2.1.1.1 1) *
        gaussianAt (z.1 ^ α.weight 1) (z.2.1.2 1) (z.2.1.1.2 1)) *
      (gaussianDerivAt (z.1 ^ α.weight 2) (z.2.1.2 2) (z.2.1.1.1 2) *
        gaussianDerivAt (z.1 ^ α.weight 2)
          (z.2.1.2 2 + z.2.2 * z.1 ^ α.weight 2) (z.2.1.1.2 2) *
          conePsiPhysicalReal (z.2.2 + u 2)))))
  exact hc'.mul
    ((((h0.mul h1).mul h2).mul h3).mul
      (((hphi0.mul hgauss0).mul (hphi1.mul hgauss1)).mul
        ((hderiv0.mul hderiv1).mul hpsi)))

/-- A bounded measurable scale coefficient times the raw center integrand
is jointly integrable over every finite positive scale measure. -/
theorem scratch_integrable_coefficient_centerTranslation_of_isFinite
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (ν : Measure ℝ) [IsFiniteMeasure ν]
    (hc : Measurable c) (hcBound : ∀ t : ℝ, |c t| ≤ 1)
    (hpos : ∀ᵐ t ∂ν, 0 < t) :
    Integrable (fun z : ℝ × (((E3 × E3) × E3) × ℝ) ↦
      c z.1 * ModelCenterTranslationIntegrand α u F z.1 z.2)
      (ν.prod ((((volume : Measure E3).prod volume).prod volume).prod volume)) := by
  obtain ⟨B₁, hB₁, hF₁⟩ := initialModelRealInput_bounded F 1
  obtain ⟨B₂, hB₂, hF₂⟩ := initialModelRealInput_bounded F 2
  obtain ⟨B₃, hB₃, hF₃⟩ := initialModelRealInput_bounded F 3
  let C : ℝ := B₁ * B₂ * B₃
  let A : E3 → ℝ := fun x ↦ C * |F 0 x|
  have hAmeas : Measurable A := by
    dsimp only [A]
    exact measurable_const.mul ((F 0).continuous.measurable.norm)
  have hAint : Integrable A := by
    have hF₀ : Integrable (fun x : E3 ↦ |F 0 x|) := by
      simpa only [Real.norm_eq_abs] using (F 0).integrable.norm
    simpa only [A] using hF₀.const_mul C
  have hAnonneg : ∀ x : E3, 0 ≤ A x := by
    intro x
    dsimp only [A, C]
    exact mul_nonneg (mul_nonneg (mul_nonneg hB₁ hB₂) hB₃) (abs_nonneg _)
  have hmajor : Integrable (scratch_rawCenterMajorant α u c A)
      (ν.prod ((((volume : Measure E3).prod volume).prod volume).prod volume)) :=
    scratch_integrable_rawCenterMajorant_of_isFinite
      α u c A ν hc hcBound hAmeas hAint hAnonneg hpos
  have hmeas : AEStronglyMeasurable
      (fun z : ℝ × (((E3 × E3) × E3) × ℝ) ↦
        c z.1 * ModelCenterTranslationIntegrand α u F z.1 z.2)
      (ν.prod ((((volume : Measure E3).prod volume).prod volume).prod volume)) :=
    (scratch_measurable_coefficient_centerTranslation α u c F hc).aestronglyMeasurable
  apply hmajor.mono' hmeas
  filter_upwards [] with z
  rcases z with ⟨t, ⟨⟨⟨x, y⟩, p⟩, r⟩⟩
  change ‖c t * ModelCenterTranslationIntegrand α u F t (((x, y), p), r)‖ ≤
    scratch_rawCenterMajorant α u c A (t, (((x, y), p), r))
  rw [Real.norm_eq_abs]
  simp only [ModelCenterTranslationIntegrand, abs_mul,
    scratch_rawCenterMajorant, scratch_centerRawReorder_apply,
    scratch_centerMajorant, scratch_centerP, scratch_centerQ]
  rw [modelPhiAt_center_shift (t ^ α.weight 0) (p 0)
      (t ^ α.weight 0 * u 0) (x 0),
    gaussianAt_center_shift (t ^ α.weight 0) (p 0) (y 0),
    modelPhiAt_center_shift (t ^ α.weight 1) (p 1)
      (t ^ α.weight 1 * u 1) (x 1),
    gaussianAt_center_shift (t ^ α.weight 1) (p 1) (y 1),
    gaussianDerivAt_center_shift (t ^ α.weight 2) (p 2) (x 2),
    show gaussianDerivAt (t ^ α.weight 2)
        (p 2 + r * t ^ α.weight 2) (y 2) =
        gaussianDerivAt (t ^ α.weight 2)
          (r * t ^ α.weight 2) (y 2 - p 2) by
        simpa only [gaussianDerivAt] using
          kernelAt_center_shift gaussianDeriv (t ^ α.weight 2)
            (p 2) (r * t ^ α.weight 2) (y 2)]
  simp only [PiLp.sub_apply, neg_sub]
  have hinput :
      |F 1 (modelPoint (y 0) (x 1) (x 2))| *
        |F 2 (modelPoint (x 0) (y 1) (x 2))| *
          |F 3 (modelPoint (x 0) (x 1) (y 2))| ≤ C := by
    dsimp only [C]
    gcongr
    · exact hF₁ _
    · exact hF₂ _
    · exact hF₃ _
  have hkernel : 0 ≤
      (|modelPhiAt (t ^ α.weight 0)
          (t ^ α.weight 0 * u 0) (x 0 - p 0)| *
        |modelPhiAt (t ^ α.weight 1)
          (t ^ α.weight 1 * u 1) (x 1 - p 1)| *
        |gaussianDerivAt (t ^ α.weight 2) 0 (x 2 - p 2)|) *
      ((|gaussianAt (t ^ α.weight 0) 0 (y 0 - p 0)| *
          |gaussianAt (t ^ α.weight 1) 0 (y 1 - p 1)|) *
        (|gaussianDerivAt (t ^ α.weight 2)
            (r * t ^ α.weight 2) (y 2 - p 2)| *
          |conePsiPhysicalReal (r + u 2)|)) := by
    positivity
  have hinputF0 :
      (|F 1 (modelPoint (y 0) (x 1) (x 2))| *
        |F 2 (modelPoint (x 0) (y 1) (x 2))| *
        |F 3 (modelPoint (x 0) (x 1) (y 2))|) * |F 0 x| ≤
        C * |F 0 x| :=
    mul_le_mul_of_nonneg_right hinput (abs_nonneg _)
  have hinside :
      ((|F 1 (modelPoint (y 0) (x 1) (x 2))| *
        |F 2 (modelPoint (x 0) (y 1) (x 2))| *
        |F 3 (modelPoint (x 0) (x 1) (y 2))|) * |F 0 x|) *
        ((|modelPhiAt (t ^ α.weight 0)
            (t ^ α.weight 0 * u 0) (x 0 - p 0)| *
          |modelPhiAt (t ^ α.weight 1)
            (t ^ α.weight 1 * u 1) (x 1 - p 1)| *
          |gaussianDerivAt (t ^ α.weight 2) 0 (x 2 - p 2)|) *
          ((|gaussianAt (t ^ α.weight 0) 0 (y 0 - p 0)| *
            |gaussianAt (t ^ α.weight 1) 0 (y 1 - p 1)|) *
            (|gaussianDerivAt (t ^ α.weight 2)
                (r * t ^ α.weight 2) (y 2 - p 2)| *
              |conePsiPhysicalReal (r + u 2)|))) ≤
      (C * |F 0 x|) *
        ((|modelPhiAt (t ^ α.weight 0)
            (t ^ α.weight 0 * u 0) (x 0 - p 0)| *
          |modelPhiAt (t ^ α.weight 1)
            (t ^ α.weight 1 * u 1) (x 1 - p 1)| *
          |gaussianDerivAt (t ^ α.weight 2) 0 (x 2 - p 2)|) *
          ((|gaussianAt (t ^ α.weight 0) 0 (y 0 - p 0)| *
            |gaussianAt (t ^ α.weight 1) 0 (y 1 - p 1)|) *
            (|gaussianDerivAt (t ^ α.weight 2)
                (r * t ^ α.weight 2) (y 2 - p 2)| *
              |conePsiPhysicalReal (r + u 2)|))) :=
    mul_le_mul_of_nonneg_right hinputF0 hkernel
  have htotal := mul_le_mul_of_nonneg_left hinside (abs_nonneg (c t))
  calc
    |c t| *
        (|F 0 x| * |F 1 (modelPoint (y 0) (x 1) (x 2))| *
          |F 2 (modelPoint (x 0) (y 1) (x 2))| *
          |F 3 (modelPoint (x 0) (x 1) (y 2))| *
          ((|modelPhiAt (t ^ α.weight 0)
              (t ^ α.weight 0 * u 0) (x 0 - p 0)| *
            |gaussianAt (t ^ α.weight 0) 0 (y 0 - p 0)|) *
            (|modelPhiAt (t ^ α.weight 1)
              (t ^ α.weight 1 * u 1) (x 1 - p 1)| *
            |gaussianAt (t ^ α.weight 1) 0 (y 1 - p 1)|) *
            (|gaussianDerivAt (t ^ α.weight 2) 0 (x 2 - p 2)| *
            |gaussianDerivAt (t ^ α.weight 2)
              (r * t ^ α.weight 2) (y 2 - p 2)| *
              |conePsiPhysicalReal (r + u 2)|))) =
      |c t| *
        ((|F 1 (modelPoint (y 0) (x 1) (x 2))| *
          |F 2 (modelPoint (x 0) (y 1) (x 2))| *
          |F 3 (modelPoint (x 0) (x 1) (y 2))|) * |F 0 x| *
        ((|modelPhiAt (t ^ α.weight 0)
            (t ^ α.weight 0 * u 0) (x 0 - p 0)| *
          |modelPhiAt (t ^ α.weight 1)
            (t ^ α.weight 1 * u 1) (x 1 - p 1)| *
          |gaussianDerivAt (t ^ α.weight 2) 0 (x 2 - p 2)|) *
          ((|gaussianAt (t ^ α.weight 0) 0 (y 0 - p 0)| *
            |gaussianAt (t ^ α.weight 1) 0 (y 1 - p 1)|) *
            (|gaussianDerivAt (t ^ α.weight 2)
                (r * t ^ α.weight 2) (y 2 - p 2)| *
              |conePsiPhysicalReal (r + u 2)|)))) := by ring
    _ ≤ |c t| *
        ((C * |F 0 x|) *
        ((|modelPhiAt (t ^ α.weight 0)
            (t ^ α.weight 0 * u 0) (x 0 - p 0)| *
          |modelPhiAt (t ^ α.weight 1)
            (t ^ α.weight 1 * u 1) (x 1 - p 1)| *
          |gaussianDerivAt (t ^ α.weight 2) 0 (x 2 - p 2)|) *
          ((|gaussianAt (t ^ α.weight 0) 0 (y 0 - p 0)| *
            |gaussianAt (t ^ α.weight 1) 0 (y 1 - p 1)|) *
            (|gaussianDerivAt (t ^ α.weight 2)
                (r * t ^ α.weight 2) (y 2 - p 2)| *
              |conePsiPhysicalReal (r + u 2)|)))) := htotal
    _ = _ := by
      dsimp only [A]
      ring

/-- The raw center-translation expression is jointly integrable on every
literal finite truncation scale band. -/
theorem scratch_integrable_coefficient_centerTranslation_truncationScale
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (N : ℕ) (hc : Measurable c) (hcBound : ∀ t : ℝ, |c t| ≤ 1) :
    Integrable (fun z : ℝ × (((E3 × E3) × E3) × ℝ) ↦
      c z.1 * ModelCenterTranslationIntegrand α u F z.1 z.2)
      ((((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
        (truncationScaleSet N)).prod
        ((((volume : Measure E3).prod volume).prod volume).prod volume)) := by
  let ν : Measure ℝ := ((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
    (truncationScaleSet N)
  letI : IsFiniteMeasure ν := by
    dsimp only [ν]
    exact scratch_isFiniteMeasure_truncationScaleSet N
  apply scratch_integrable_coefficient_centerTranslation_of_isFinite
    α u c F ν hc hcBound
  filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
  exact truncationScaleSet_subset_positive N ht

/-- The fully opened fiber integrand is absolutely integrable on each
finite truncation slab for every bounded measurable coefficient and real
Schwartz input. -/
theorem scratch_integrable_modelFiberFullyExpanded_truncationScale
    (α : Anisotropy) (u : E3) (c : ℝ → ℝ) (F : ModelSchwartzInput)
    (N : ℕ) (hc : Measurable c) (hcBound : ∀ t : ℝ, |c t| ≤ 1) :
    Integrable (modelFiberFullyExpandedIntegrand α u c (InitialModelRealInput F))
      (((cubeScaleMeasure.restrict (Set.univ ×ˢ truncationScaleSet N)).prod
        (volume : Measure ModelE5)).prod ((volume : Measure ℝ).prod volume)) := by
  let ν : Measure ℝ := ((volume : Measure ℝ).withDensity cubeScaleDensity).restrict
    (truncationScaleSet N)
  let η : Measure (((E3 × E3) × E3) × ℝ) :=
    (((volume : Measure E3).prod volume).prod volume).prod volume
  let e := modelFiberCenterReorder
  have hraw : Integrable (fun z : ℝ × (((E3 × E3) × E3) × ℝ) ↦
      c z.1 * ModelCenterTranslationIntegrand α u F z.1 z.2) (ν.prod η) := by
    simpa only [ν, η] using
      scratch_integrable_coefficient_centerTranslation_truncationScale
        α u c F N hc hcBound
  have hscale : cubeScaleMeasure.restrict
      (Set.univ ×ˢ truncationScaleSet N) = (volume : Measure E3).prod ν := by
    unfold cubeScaleMeasure ν
    rw [← Measure.prod_restrict]
    simp
  have hmp : MeasurePreserving e
      (((((volume : Measure E3).prod ν).prod
        (volume : Measure ModelE5)).prod ((volume : Measure ℝ).prod volume)))
      (ν.prod η) := by
    simpa only [e, η] using modelFiberCenterReorder_measurePreserving ν
  have htransport : Integrable (fun q : ((E3 × ℝ) × ModelE5) × (ℝ × ℝ) ↦
      (fun z : ℝ × (((E3 × E3) × E3) × ℝ) ↦
        c z.1 * ModelCenterTranslationIntegrand α u F z.1 z.2) (e q))
      (((((volume : Measure E3).prod ν).prod
        (volume : Measure ModelE5)).prod ((volume : Measure ℝ).prod volume))) :=
    hmp.integrable_comp_of_integrable hraw
  rw [hscale]
  apply htransport.congr
  filter_upwards [] with q
  rcases hq : e q with ⟨t, ⟨⟨⟨x, y⟩, p⟩, r⟩⟩
  rw [← e.symm_apply_apply q, hq]
  simpa only [e] using
    (modelFiberFullyExpandedIntegrand_centerReorder_symm
      α u c F t x y p r).symm

end
