    X × (Y × ℝ) ≃ᵐ ℝ × (X × Y) :=
  (MeasurableEquiv.prodAssoc.symm : X × (Y × ℝ) ≃ᵐ ((X × Y) × ℝ)).trans
    (MeasurableEquiv.prodComm : ((X × Y) × ℝ) ≃ᵐ ℝ × (X × Y))

@[simp] theorem scratch_outerLambdaShuffleRight_apply
    (X Y : Type*) [MeasurableSpace X] [MeasurableSpace Y]
