      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B) →
      Integrable (scratch_modelFirstSuperpositionJoint α u f)
        ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
          ((volume : Measure ModelE5).prod
            ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) ) →
      modelEnergyOne α S u f ≤
        C * sourceWeight u ^ 50 * conePsiPhysicalRealL1 *
          ∫ lam in Set.Ici (1 : ℝ),
            localCubeForm α S 2 lam 0 (modelFirstCubeTuple f) *
              lam ^ (-47 : ℝ) := by
  rcases scratch_modelEnergyOne_le_cubeComparison_of_fubini with ⟨C, hC, hmain⟩
  refine ⟨C, hC, ?_⟩
  intro α S u f b hfcont hfbound hsuper
  apply hmain α S u f b
  · exact scratch_integrable_modelEnergyOne_of_boundedContinuous
      α S u f hfcont hfbound
  · exact hsuper
  exact scratch_outerFirstSuperposition_eq_cubeComparison α S u f b
    (scratch_continuous_modelFirstCubeTuple f hfcont)
    (scratch_bounded_modelFirstCubeTuple f hfbound) hsuper

/-- The second local energy satisfies the literal edge-cube comparison under
bounded continuity and the one remaining joint superposition integrability
hypothesis. -/
theorem scratch_modelEnergyTwo_le_cubeComparison_of_boundedContinuous :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (α : Anisotropy) (S : BoxCollection α)
      (u : E3) (f : E3 → ℝ) (b : Bool),
      Continuous f →
      (∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) →
      Integrable (scratch_modelSecondSuperpositionJoint α f)
        ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
          ((volume : Measure ModelE5).prod
            ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) ) →
      modelEnergyTwo α S u f ≤
        C * sourceWeight u ^ 100 *
          ∫ lam in Set.Ici (1 : ℝ),
            (∫ r : ℝ,
              localCubeForm α S 2 lam r (edgeCubeTuple f) *
                translationWeight r ^ (-50 : ℝ)) * lam ^ (-47 : ℝ) := by
  rcases scratch_modelEnergyTwo_le_cubeComparison_of_fubini with ⟨C, hC, hmain⟩
  refine ⟨C, hC, ?_⟩
  intro α S u f b hfcont hfbound hsuper
  apply hmain α S u f b
  · exact scratch_integrable_modelEnergyTwo_of_boundedContinuous
      α S u f hfcont hfbound
  · exact hsuper
  exact scratch_outerSecondSuperposition_eq_cubeComparison
    α S f b hfcont hfbound hsuper

/-- Constant cube slots have fourth tree local size at most one. -/
theorem scratch_treeLocalSize_four_one_le_one
    (α : Anisotropy) (T : FiniteConvexTree α) :
    treeLocalSize T 4 (fun _ : E3 ↦ (1 : ℝ)) ≤ 1 := by
  change collectionLocalSize α T.boxes 4 (fun _ : E3 ↦ (1 : ℝ)) ≤ 1
  rw [collectionLocalSize_eq_sup' T.boxes T.nonempty]
  apply Finset.sup'_le
  intro q hq
  unfold boxLocalSize boxLocalPower
  rw [show (fun y : E3 ↦ |(1 : ℝ)| ^ (4 : ℝ) *
      anisotropicBracketKernel α (boxLength q) (boxCenter α q) y) =
        anisotropicBracketKernel α (boxLength q) (boxCenter α q) by
      funext y
      norm_num]
  rw [integral_anisotropicBracketKernel α (boxLength_pos q) (boxCenter α q)]
  apply Real.rpow_le_one <;> norm_num

/-- An explicit enumeration of the eight cube vertices for finite-product
bookkeeping in the first energy estimate. -/
theorem scratch_cubeVertex_univ :
    (Finset.univ : Finset CubeVertex) =
      {cubeVertex false false false, cubeVertex false false true,
        cubeVertex false true false, cubeVertex false true true,
        cubeVertex true false false, cubeVertex true false true,
        cubeVertex true true false, cubeVertex true true true} := by
  decide

/-- The eight first-energy cube slots contribute the square of the three
nonconstant fourth local sizes; the two constant slots are harmless. -/
theorem scratch_modelFirstCubeTuple_treeLocalSize_product_le
    (α : Anisotropy) (T : FiniteConvexTree α) (f : ModelRealInput) :
    (∏ j : CubeVertex, treeLocalSize T 4 (modelFirstCubeTuple f j)) ≤
      (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
        treeLocalSize T 4 (f 2)) ^ 2 := by
  let K : ℝ := treeLocalSize T 4 (fun _ : E3 ↦ (1 : ℝ))
  let M0 : ℝ := treeLocalSize T 4 (f 0)
  let M1 : ℝ := treeLocalSize T 4 (f 1)
  let M2 : ℝ := treeLocalSize T 4 (f 2)
  have hK0 : 0 ≤ K := by
    dsimp only [K]
    exact treeLocalSize_four_nonneg T _
  have hK1 : K ≤ 1 := by
    dsimp only [K]
    exact scratch_treeLocalSize_four_one_le_one α T
  have hKsq : K * K ≤ 1 := by
    calc
      K * K ≤ 1 * K := mul_le_mul_of_nonneg_right hK1 hK0
      _ ≤ 1 * 1 := mul_le_mul_of_nonneg_left hK1 zero_le_one
      _ = 1 := by ring
  have hM0 : 0 ≤ M0 := by
    dsimp only [M0]
    exact treeLocalSize_four_nonneg T _
  have hM1 : 0 ≤ M1 := by
    dsimp only [M1]
    exact treeLocalSize_four_nonneg T _
  have hM2 : 0 ≤ M2 := by
    dsimp only [M2]
    exact treeLocalSize_four_nonneg T _
  have hP : 0 ≤ (M0 * M1 * M2) ^ 2 := sq_nonneg _
  have h000 : cubeVertex false false false ∉
      ({cubeVertex false false true, cubeVertex false true false,
        cubeVertex false true true, cubeVertex true false false,
        cubeVertex true false true, cubeVertex true true false,
        cubeVertex true true true} : Finset CubeVertex) := by decide
  have h001 : cubeVertex false false true ∉
      ({cubeVertex false true false, cubeVertex false true true,
        cubeVertex true false false, cubeVertex true false true,
        cubeVertex true true false, cubeVertex true true true} : Finset CubeVertex) := by decide
  have h010 : cubeVertex false true false ∉
      ({cubeVertex false true true, cubeVertex true false false,
        cubeVertex true false true, cubeVertex true true false,
        cubeVertex true true true} : Finset CubeVertex) := by decide
  have h011 : cubeVertex false true true ∉
      ({cubeVertex true false false, cubeVertex true false true,
        cubeVertex true true false, cubeVertex true true true} : Finset CubeVertex) := by decide
  have h100 : cubeVertex true false false ∉
      ({cubeVertex true false true, cubeVertex true true false,
        cubeVertex true true true} : Finset CubeVertex) := by decide
  have h101 : cubeVertex true false true ∉
      ({cubeVertex true true false, cubeVertex true true true} : Finset CubeVertex) := by decide
  have h110 : cubeVertex true true false ∉
      ({cubeVertex true true true} : Finset CubeVertex) := by decide
  rw [scratch_cubeVertex_univ]
  rw [Finset.prod_insert h000, Finset.prod_insert h001,
    Finset.prod_insert h010, Finset.prod_insert h011,
    Finset.prod_insert h100, Finset.prod_insert h101,
    Finset.prod_insert h110, Finset.prod_singleton]
  simp [modelFirstCubeTuple]
  change M0 * (M0 * (M2 * (M2 * (M1 * (M1 * (K * K)))))) ≤
    (M0 * M1 * M2) ^ 2
  calc
    M0 * (M0 * (M2 * (M2 * (M1 * (M1 * (K * K)))))) =
        (M0 * M1 * M2) ^ 2 * (K * K) := by ring
    _ ≤ (M0 * M1 * M2) ^ 2 * 1 :=
      mul_le_mul_of_nonneg_left hKsq hP
    _ = (M0 * M1 * M2) ^ 2 := by ring

/-- At a fixed positive scale, the full-cube tree estimate leaves exactly the
`λ⁻¹⁰` scale weight after the first-energy normalization. -/
theorem scratch_modelFirst_fixed_majorant
    (α : Anisotropy) (T : FiniteConvexTree α) (f : ModelRealInput)
    (lam : ℝ) (C : ℝ)
    (hC : 0 ≤ C)
    (htree : |localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f)| ≤
      C * lam ^ (37 : ℕ) * translationWeight 0 ^ (21 : ℕ) *
        (∏ j : CubeVertex, treeLocalSize T 4 (modelFirstCubeTuple f j)) *
          boxMass α T.root)
    (hlam : 1 ≤ lam) :
    localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) * lam ^ (-47 : ℝ) ≤
      (C *
        (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
          treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root) *
        lam ^ (-10 : ℝ) := by
  have hlam0 : 0 ≤ lam := le_trans zero_le_one hlam
  have hlampos : 0 < lam := lt_of_lt_of_le zero_lt_one hlam
  have hpow47 : 0 ≤ lam ^ (-47 : ℝ) := Real.rpow_nonneg hlam0 _
  have hR0 : translationWeight (0 : ℝ) = 1 := by
    norm_num [translationWeight]
  have hbase : 0 ≤ C * lam ^ (37 : ℕ) * translationWeight 0 ^ (21 : ℕ) := by
    positivity
  have hmass : 0 ≤ boxMass α T.root := (boxMass_pos α T.root).le
  have hprod := scratch_modelFirstCubeTuple_treeLocalSize_product_le α T f
  have htree' : |localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f)| ≤
      C * lam ^ (37 : ℕ) * translationWeight 0 ^ (21 : ℕ) *
        (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
          treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root := by
    exact htree.trans
      (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left hprod hbase) hmass)
  have hpow : lam ^ (37 : ℕ) * lam ^ (-47 : ℝ) = lam ^ (-10 : ℝ) := by
    rw [← Real.rpow_natCast]
    rw [← Real.rpow_add hlampos]
    norm_num
  calc
    localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) * lam ^ (-47 : ℝ) ≤
        (C * lam ^ (37 : ℕ) * translationWeight 0 ^ (21 : ℕ) *
          (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
            treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root) *
            lam ^ (-47 : ℝ) :=
      mul_le_mul_of_nonneg_right ((le_abs_self _).trans htree') hpow47
    _ = (C *
        (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
          treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root) *
        lam ^ (-10 : ℝ) := by
      rw [hR0]
      simp only [one_pow, mul_one]
      calc
        C * lam ^ (37 : ℕ) *
              (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
                treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root *
                lam ^ (-47 : ℝ) =
            (C *
              (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
                treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root) *
              (lam ^ (37 : ℕ) * lam ^ (-47 : ℝ)) := by ring
        _ = _ := by rw [hpow]

/-- At a fixed positive scale, the edge-tree estimate leaves the product
`λ⁻¹⁰ R⁻²⁹` after the second-energy normalization. -/
theorem scratch_edge_fixed_majorant
    (α : Anisotropy) (T : FiniteConvexTree α) (f : E3 → ℝ)
    (lam r C : ℝ)
    (hC : 0 ≤ C)
    (htree : localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) ≤
      C * lam ^ (37 : ℕ) * translationWeight r ^ (21 : ℕ) *
        treeLocalSize T 2 f ^ 2 * boxMass α T.root)
    (hlam : 1 ≤ lam) :
    localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
        translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ) ≤
      (C * treeLocalSize T 2 f ^ 2 * boxMass α T.root) *
        lam ^ (-10 : ℝ) * translationWeight r ^ (-29 : ℝ) := by
  have hlam0 : 0 ≤ lam := le_trans zero_le_one hlam
  have hlampos : 0 < lam := lt_of_lt_of_le zero_lt_one hlam
  have hRpos : 0 < translationWeight r := by
    unfold translationWeight
    positivity
  have hR0 : 0 ≤ translationWeight r := hRpos.le
  have hpowlam47 : 0 ≤ lam ^ (-47 : ℝ) := Real.rpow_nonneg hlam0 _
  have hpowR50 : 0 ≤ translationWeight r ^ (-50 : ℝ) := Real.rpow_nonneg hR0 _
  have hbase : 0 ≤ C * lam ^ (37 : ℕ) * translationWeight r ^ (21 : ℕ) := by
    positivity
  have hM2 : 0 ≤ treeLocalSize T 2 f ^ 2 := sq_nonneg _
  have hmass : 0 ≤ boxMass α T.root := (boxMass_pos α T.root).le
  have hpowlam : lam ^ (37 : ℕ) * lam ^ (-47 : ℝ) = lam ^ (-10 : ℝ) := by
    rw [← Real.rpow_natCast]
    rw [← Real.rpow_add hlampos]
    norm_num
  have hpowR : translationWeight r ^ (21 : ℕ) *
      translationWeight r ^ (-50 : ℝ) = translationWeight r ^ (-29 : ℝ) := by
    rw [← Real.rpow_natCast]
    rw [← Real.rpow_add hRpos]
    norm_num
  calc
    localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
          translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ) ≤
        (C * lam ^ (37 : ℕ) * translationWeight r ^ (21 : ℕ) *
          treeLocalSize T 2 f ^ 2 * boxMass α T.root) *
          translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ) := by
      gcongr
    _ = (C * treeLocalSize T 2 f ^ 2 * boxMass α T.root) *
          lam ^ (-10 : ℝ) * translationWeight r ^ (-29 : ℝ) := by
      calc
        (C * lam ^ (37 : ℕ) * translationWeight r ^ (21 : ℕ) *
            treeLocalSize T 2 f ^ 2 * boxMass α T.root) *
            translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ) =
          (C * treeLocalSize T 2 f ^ 2 * boxMass α T.root) *
            (lam ^ (37 : ℕ) * lam ^ (-47 : ℝ)) *
              (translationWeight r ^ (21 : ℕ) *
                translationWeight r ^ (-50 : ℝ)) := by ring
        _ = _ := by rw [hpowlam, hpowR]

/-- Integration of the first fixed-scale majorant uses the exact remaining
scale mass `∫₁∞ λ⁻¹⁰ = 1/9`. -/
theorem scratch_modelFirst_integral_majorant
    (α : Anisotropy) (T : FiniteConvexTree α) (f : ModelRealInput)
    (C : ℝ) (hC : 0 ≤ C)
    (htree : ∀ lam : ℝ, 1 ≤ lam →
      |localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f)| ≤
        C * lam ^ (37 : ℕ) * translationWeight 0 ^ (21 : ℕ) *
          (∏ j : CubeVertex, treeLocalSize T 4 (modelFirstCubeTuple f j)) *
            boxMass α T.root)
    (hform : IntegrableOn (fun lam : ℝ ↦
      localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) *
        lam ^ (-47 : ℝ)) (Set.Ici (1 : ℝ))) :
    ∫ lam : ℝ in Set.Ici (1 : ℝ),
      localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) *
        lam ^ (-47 : ℝ) ≤
      (C *
        (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
          treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root) / 9 := by
  let D : ℝ := C *
    (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
      treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root
  have hweight : Integrable (fun lam : ℝ ↦ lam ^ (-10 : ℝ))
      ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))) := by
    exact integrableOn_scaleWeight_negTen
  have hmajor : Integrable (fun lam : ℝ ↦ D * lam ^ (-10 : ℝ))
      ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))) :=
    hweight.const_mul D
  have hAE : ∀ᵐ lam : ℝ ∂(volume.restrict (Set.Ici (1 : ℝ))),
      localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) *
          lam ^ (-47 : ℝ) ≤ D * lam ^ (-10 : ℝ) := by
    filter_upwards [ae_restrict_mem (measurableSet_Ici : MeasurableSet (Set.Ici (1 : ℝ)))]
      with lam hlam
    exact scratch_modelFirst_fixed_majorant α T f lam C hC (htree lam hlam) hlam
  calc
    ∫ lam : ℝ in Set.Ici (1 : ℝ),
        localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) *
          lam ^ (-47 : ℝ) ≤
        ∫ lam : ℝ in Set.Ici (1 : ℝ), D * lam ^ (-10 : ℝ) :=
      integral_mono_ae hform hmajor hAE
    _ = D * (∫ lam : ℝ in Set.Ici (1 : ℝ), lam ^ (-10 : ℝ)) := by
      rw [MeasureTheory.integral_const_mul]
    _ = (C *
        (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
          treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root) / 9 := by
      rw [integralOn_scaleWeight_negTen]
      dsimp only [D]
      ring

/-- Integration of the edge fixed-scale majorant uses the two exact remaining
masses `1/9` and `1/14`, hence the factor `1/126`. -/
theorem scratch_edge_integral_majorant
    (α : Anisotropy) (T : FiniteConvexTree α) (f : E3 → ℝ)
    (C : ℝ) (hC : 0 ≤ C)
    (htree : ∀ (lam r : ℝ), 1 ≤ lam →
      localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) ≤
        C * lam ^ (37 : ℕ) * translationWeight r ^ (21 : ℕ) *
          treeLocalSize T 2 f ^ 2 * boxMass α T.root)
    (hform : Integrable (fun z : ℝ × ℝ ↦
      localCubeForm α T.boxes 2 z.1 z.2 (edgeCubeTuple f) *
          translationWeight z.2 ^ (-50 : ℝ) * z.1 ^ (-47 : ℝ))
      (((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))).prod volume)) :
    ∫ lam : ℝ in Set.Ici (1 : ℝ),
        (∫ r : ℝ,
          localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
            translationWeight r ^ (-50 : ℝ)) * lam ^ (-47 : ℝ) ≤
      (C * treeLocalSize T 2 f ^ 2 * boxMass α T.root) / 126 := by
  let D : ℝ := C * treeLocalSize T 2 f ^ 2 * boxMass α T.root
  let nu : Measure ℝ := (volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))
  have hweightlam : Integrable (fun lam : ℝ ↦ lam ^ (-10 : ℝ)) nu := by
    exact integrableOn_scaleWeight_negTen
  have hweightr : Integrable (fun r : ℝ ↦ translationWeight r ^ (-29 : ℝ))
      (volume : Measure ℝ) := integrable_translationWeight_negTwentyNine
  have hmajor : Integrable (fun z : ℝ × ℝ ↦
      D * z.1 ^ (-10 : ℝ) * translationWeight z.2 ^ (-29 : ℝ))
      (nu.prod volume) := by
    simpa only [mul_assoc] using (hweightlam.mul_prod hweightr).const_mul D
  have hinner : ∀ᵐ lam : ℝ ∂nu,
      (∫ r : ℝ,
        localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
          translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ)) ≤
        ∫ r : ℝ, D * lam ^ (-10 : ℝ) * translationWeight r ^ (-29 : ℝ) := by
    filter_upwards [hform.prod_right_ae, hmajor.prod_right_ae,
      ae_restrict_mem (measurableSet_Ici : MeasurableSet (Set.Ici (1 : ℝ)))]
      with lam hformlam hmajorlam hlam
    apply integral_mono_ae hformlam hmajorlam
    filter_upwards [] with r
    exact scratch_edge_fixed_majorant α T f lam r C hC (htree lam r hlam) hlam
  have houter :
      (∫ lam : ℝ in Set.Ici (1 : ℝ),
        ∫ r : ℝ,
          localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
            translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ)) ≤
        ∫ lam : ℝ in Set.Ici (1 : ℝ),
          ∫ r : ℝ, D * lam ^ (-10 : ℝ) * translationWeight r ^ (-29 : ℝ) := by
    exact integral_mono_ae hform.integral_prod_left hmajor.integral_prod_left hinner
  have hrewrite :
      (∫ lam : ℝ in Set.Ici (1 : ℝ),
        (∫ r : ℝ,
          localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
            translationWeight r ^ (-50 : ℝ)) * lam ^ (-47 : ℝ)) =
      ∫ lam : ℝ in Set.Ici (1 : ℝ),
        ∫ r : ℝ,
          localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
            translationWeight r ^ (-50 : ℝ) * lam ^ (-47 : ℝ) := by
    apply integral_congr_ae
    filter_upwards [] with lam
    rw [MeasureTheory.integral_mul_const]
  have heval :
      (∫ lam : ℝ in Set.Ici (1 : ℝ),
        ∫ r : ℝ, D * lam ^ (-10 : ℝ) * translationWeight r ^ (-29 : ℝ)) =
      D / 126 := by
    calc
      (∫ lam : ℝ in Set.Ici (1 : ℝ),
        ∫ r : ℝ, D * lam ^ (-10 : ℝ) * translationWeight r ^ (-29 : ℝ)) =
          ∫ lam : ℝ in Set.Ici (1 : ℝ),
            (D * lam ^ (-10 : ℝ)) *
              (∫ r : ℝ, translationWeight r ^ (-29 : ℝ)) := by
        apply integral_congr_ae
        filter_upwards [] with lam
        rw [MeasureTheory.integral_const_mul]
      _ = ∫ lam : ℝ in Set.Ici (1 : ℝ),
            (D / 14) * lam ^ (-10 : ℝ) := by
        apply integral_congr_ae
        filter_upwards [] with lam
        rw [integral_translationWeight_negTwentyNine]
        ring
      _ = (D / 14) *
          (∫ lam : ℝ in Set.Ici (1 : ℝ), lam ^ (-10 : ℝ)) := by
        rw [MeasureTheory.integral_const_mul]
      _ = D / 126 := by
        rw [integralOn_scaleWeight_negTen]
        ring
  rw [hrewrite]
  exact houter.trans_eq heval

/-- The first model energy is controlled by the full-cube tree estimate.  The
only analytic hypothesis left explicit is the exact normalized scale
integrability used to justify the comparison integral. -/
theorem scratch_modelEnergyOne_tree_bound_of_boundedContinuous
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α)
      (u : E3) (f : ModelRealInput) (b : Bool),
      (∀ j, Continuous (f j)) →
      (∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f j y| ≤ B) →
      Integrable (scratch_modelFirstSuperpositionJoint α u f)
        ((cubeScaleMeasure.restrict (collectionRegion α T.boxes)).prod
          ((volume : Measure ModelE5).prod
            ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) ) →
      IntegrableOn (fun lam : ℝ ↦
        localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) *
          lam ^ (-47 : ℝ)) (Set.Ici (1 : ℝ)) →
      modelEnergyOne α T.boxes u f ≤
        C * sourceWeight u ^ 50 * boxMass α T.root *
          (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
            treeLocalSize T 4 (f 2)) ^ 2 := by
  rcases scratch_modelEnergyOne_le_cubeComparison_of_boundedContinuous with
    ⟨CE, hCE, henergy⟩
  rcases fullCubeTreeEstimate_of_boundedContinuous α with ⟨CT, hCT, htree⟩
  refine ⟨CE * CT * conePsiPhysicalRealL1 / 9, ?_, ?_⟩
  · have hL1 : 0 ≤ conePsiPhysicalRealL1 := by
      unfold conePsiPhysicalRealL1
      exact integral_nonneg fun r ↦ abs_nonneg _
    positivity
  intro T u f b hfcont hfbound hsuper hform
  have hL1 : 0 ≤ conePsiPhysicalRealL1 := by
    unfold conePsiPhysicalRealL1
    exact integral_nonneg fun r ↦ abs_nonneg _
  have htree' : ∀ lam : ℝ, 1 ≤ lam →
      |localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f)| ≤
        CT * lam ^ (37 : ℕ) * translationWeight 0 ^ (21 : ℕ) *
          (∏ j : CubeVertex, treeLocalSize T 4 (modelFirstCubeTuple f j)) *
            boxMass α T.root := by
    intro lam hlam
    exact htree T lam 0 (modelFirstCubeTuple f) 2
      (scratch_continuous_modelFirstCubeTuple f hfcont)
      (scratch_bounded_modelFirstCubeTuple f hfbound) hlam
  have hI := scratch_modelFirst_integral_majorant α T f CT hCT htree' hform
  have henergy' := henergy α T.boxes u f b hfcont hfbound hsuper
  have hfac : 0 ≤ CE * sourceWeight u ^ 50 * conePsiPhysicalRealL1 := by
    positivity
  calc
    modelEnergyOne α T.boxes u f ≤
        CE * sourceWeight u ^ 50 * conePsiPhysicalRealL1 *
          ∫ lam : ℝ in Set.Ici (1 : ℝ),
            localCubeForm α T.boxes 2 lam 0 (modelFirstCubeTuple f) *
              lam ^ (-47 : ℝ) := henergy'
    _ ≤ CE * sourceWeight u ^ 50 * conePsiPhysicalRealL1 *
        ((CT *
          (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
            treeLocalSize T 4 (f 2)) ^ 2 * boxMass α T.root) / 9) :=
      mul_le_mul_of_nonneg_left hI hfac
    _ = (CE * CT * conePsiPhysicalRealL1 / 9) *
        sourceWeight u ^ 50 * boxMass α T.root *
          (treeLocalSize T 4 (f 0) * treeLocalSize T 4 (f 1) *
            treeLocalSize T 4 (f 2)) ^ 2 := by ring

/-- The second model energy is controlled by the edge-cube tree estimate.
The remaining hypothesis is precisely the joint scale--translation
integrability needed for the Fubini comparison. -/
theorem scratch_modelEnergyTwo_tree_bound_of_boundedContinuous
    (α : Anisotropy) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : FiniteConvexTree α)
      (u : E3) (f : E3 → ℝ) (b : Bool),
      Continuous f →
      (∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B) →
      Integrable (scratch_modelSecondSuperpositionJoint α f)
        ((cubeScaleMeasure.restrict (collectionRegion α T.boxes)).prod
          ((volume : Measure ModelE5).prod
            ((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ)))) ) →
      Integrable (fun z : ℝ × ℝ ↦
        localCubeForm α T.boxes 2 z.1 z.2 (edgeCubeTuple f) *
          translationWeight z.2 ^ (-50 : ℝ) * z.1 ^ (-47 : ℝ))
        (((volume : Measure ℝ).restrict (Set.Ici (1 : ℝ))).prod volume) →
      modelEnergyTwo α T.boxes u f ≤
        C * sourceWeight u ^ 100 * boxMass α T.root * treeLocalSize T 2 f ^ 2 := by
  rcases scratch_modelEnergyTwo_le_cubeComparison_of_boundedContinuous with
    ⟨CE, hCE, henergy⟩
  rcases edgeTreeEstimate_of_boundedContinuous α with ⟨CT, hCT, htree⟩
  refine ⟨CE * CT / 126, ?_, ?_⟩
  · positivity
  intro T u f b hfcont hfbound hsuper hform
  have htree' : ∀ (lam r : ℝ), 1 ≤ lam →
      localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) ≤
        CT * lam ^ (37 : ℕ) * translationWeight r ^ (21 : ℕ) *
          treeLocalSize T 2 f ^ 2 * boxMass α T.root := by
    intro lam r hlam
    exact (htree T lam r f hfcont hfbound hlam).2.2.2
  have hI := scratch_edge_integral_majorant α T f CT hCT htree' hform
  have henergy' := henergy α T.boxes u f b hfcont hfbound hsuper
  have hfac : 0 ≤ CE * sourceWeight u ^ 100 := by
    positivity
  calc
    modelEnergyTwo α T.boxes u f ≤
        CE * sourceWeight u ^ 100 *
          ∫ lam : ℝ in Set.Ici (1 : ℝ),
            (∫ r : ℝ,
              localCubeForm α T.boxes 2 lam r (edgeCubeTuple f) *
                translationWeight r ^ (-50 : ℝ)) * lam ^ (-47 : ℝ) := henergy'
    _ ≤ CE * sourceWeight u ^ 100 *
        ((CT * treeLocalSize T 2 f ^ 2 * boxMass α T.root) / 126) :=
      mul_le_mul_of_nonneg_left hI hfac
    _ = (CE * CT / 126) * sourceWeight u ^ 100 *
        boxMass α T.root * treeLocalSize T 2 f ^ 2 := by ring

end

