      (MeasurableEquiv.prodComm : ((X × Y) × Z) ≃ᵐ Z × (X × Y))
      ((μ.prod ν).prod ρ) (ρ.prod (μ.prod ν)) :=
    Measure.measurePreserving_swap
  change MeasurePreserving (scratch_outerProductShuffleRight X Y Z)
    (μ.prod (ν.prod ρ)) (ρ.prod (μ.prod ν))
  convert h1.trans h2 using 1
  funext q
  rfl

/-- Fubini after the generic right-associated product shuffle. -/
theorem scratch_integral_outerProductShuffleRight
    {X Y Z : Type*} [MeasurableSpace X] [MeasurableSpace Y]
    [MeasurableSpace Z] (μ : Measure X) (ν : Measure Y) (ρ : Measure Z)
    [SFinite μ] [SFinite ν] [SFinite ρ] (G : X × (Y × Z) → ℝ)
    (hG : Integrable G (μ.prod (ν.prod ρ))) :
    ∫ q : X × (Y × Z), G q ∂(μ.prod (ν.prod ρ)) =
      ∫ z : Z, ∫ xy : X × Y, G (xy.1, (xy.2, z)) ∂(μ.prod ν) ∂ρ := by
  let e := scratch_outerProductShuffleRight X Y Z
  have hmp : MeasurePreserving e (μ.prod (ν.prod ρ)) (ρ.prod (μ.prod ν)) := by
    simpa only [e] using scratch_outerProductShuffleRight_measurePreserving μ ν ρ
  have htrans : Integrable (fun q : Z × (X × Y) ↦ G (e.symm q))
      (ρ.prod (μ.prod ν)) := by
    exact (MeasurePreserving.symm e hmp).integrable_comp_of_integrable hG
  calc
    ∫ q : X × (Y × Z), G q ∂(μ.prod (ν.prod ρ)) =
        ∫ q : Z × (X × Y), G (e.symm q) ∂(ρ.prod (μ.prod ν)) := by
          symm
          exact (MeasurePreserving.symm e hmp).integral_comp' G
    _ = ∫ z : Z, ∫ xy : X × Y, G (e.symm (z, xy)) ∂(μ.prod ν) ∂ρ :=
      MeasureTheory.integral_prod _ htrans
    _ = _ := by
      apply integral_congr_ae
      filter_upwards [] with z
      apply integral_congr_ae
      filter_upwards [] with xy
      rw [scratch_outerProductShuffleRight_symm_apply]

/-- The first-energy superposition has the literal outer source-scale Fubini
identity once its joint integrand is integrable. -/
theorem scratch_outerFirstSuperposition_eq_cubeComparison
    (α : Anisotropy) (S : BoxCollection α) (u : E3)
    (f : ModelRealInput) (b : Bool)
    (hFcont : ∀ j, Continuous (modelFirstCubeTuple f j))
