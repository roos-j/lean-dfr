/-- At each source scale and translation the edge tuple's passive square is
integrable over the full center--scale/passive product measure. -/
theorem scratch_integrable_modelSecondPassiveSquare
    (α : Anisotropy) (S : BoxCollection α) (lam r : ℝ)
    (f : E3 → ℝ) (b : Bool) (hfcont : Continuous f)
    (hfbound : ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |f y| ≤ B)
    (hlam : 1 ≤ lam) :
    Integrable (fun w : (E3 × ℝ) ×
      (TransverseSpace 2 × TransverseSpace 2) ↦
      cubePassiveGaussianKernel α 2 lam r w.1.2 w.1.1 w.2 *
        (cubeActiveCSAverage α 2 lam r (edgeCubeTuple f) b w) ^ 2)
      ((cubeScaleMeasure.restrict (collectionRegion α S)).prod
        ((volume : Measure (TransverseSpace 2)).prod
          (volume : Measure (TransverseSpace 2)))) := by
  have hcont := continuous_edgeCubeTuple f hfcont
  have hbound := bounded_edgeCubeTuple f hfbound
  have hweighted := integrable_cubeActiveCSWeightedAverage_sq
    α S 2 lam r (edgeCubeTuple f) b hcont hbound hlam
  refine hweighted.congr ?_
  have hpos : ∀ᵐ w ∂((cubeScaleMeasure.restrict
      (collectionRegion α S)).prod
      ((volume : Measure (TransverseSpace 2)).prod
        (volume : Measure (TransverseSpace 2)))), 0 < w.1.2 := by
    simpa only using ae_pos_scale_cubePassiveMeasure α S 2
  filter_upwards [hpos] with w hw
  exact cubeActiveCSWeightedAverage_sq_of_pos
    α 2 lam r (edgeCubeTuple f) b w hlam hw

