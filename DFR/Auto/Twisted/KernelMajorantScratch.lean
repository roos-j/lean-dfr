    (n : ℕ) (f : ℝ → ℝ) (hf : AEStronglyMeasurable f volume) {C : ℝ}
    (hdecay : ∀ x : ℝ, |f x| ≤ C / (1 + |x|) ^ (n + 10)) :
    Integrable (fun x : ℝ ↦ (1 + |x|) ^ n * |f x|) := by
  have hmajor : Integrable (fun x : ℝ ↦ C * bracketKernel x) :=
    integrable_bracketKernel.const_mul C
  have hfabs : AEStronglyMeasurable (fun x : ℝ ↦ |f x|) volume := by
    simpa only [Real.norm_eq_abs] using hf.norm
  have hweight : AEStronglyMeasurable (fun x : ℝ ↦ (1 + |x|) ^ n) volume :=
    ((continuous_const.add continuous_id.abs).pow n).aestronglyMeasurable
  have hmeas : AEStronglyMeasurable
      (fun x : ℝ ↦ (1 + |x|) ^ n * |f x|) volume :=
    hweight.mul hfabs
