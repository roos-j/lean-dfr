  filter_upwards [] with x
  have htargetnonneg : 0 ≤ (1 + |x|) ^ n * |f x| := by positivity
  rw [Real.norm_eq_abs, abs_of_nonneg htargetnonneg]
  have hW : 0 < (1 + |x|) ^ 10 := by positivity
  have hprod : (1 + |x|) ^ (n + 10) * |f x| ≤ C := by
    simpa [mul_comm] using
      (le_div_iff₀ (pow_pos (by positivity) (n + 10))).mp (hdecay x)
  rw [bracketKernel_eq_inv_pow]
  change (1 + |x|) ^ n * |f x| ≤ C / (1 + |x|) ^ 10
  apply (le_div_iff₀ hW).mpr
  have hpows : (1 + |x|) ^ n * (1 + |x|) ^ 10 =
      (1 + |x|) ^ (n + 10) := by
    rw [← pow_add]
  calc
    ((1 + |x|) ^ n * |f x|) * (1 + |x|) ^ 10 =
        ((1 + |x|) ^ n * (1 + |x|) ^ 10) * |f x| := by ring
    _ = (1 + |x|) ^ (n + 10) * |f x| := by rw [hpows]
    _ ≤ C := hprod

