    rwa [intervalIntegrable_iff_integrableOn_Ioc_of_le hc.le] at h
  have hval : ∫ t in Ioc (0 : ℝ) c, t ^ a = c ^ (a + 1) / (a + 1) := by
    have h := integral_rpow (a := (0 : ℝ)) (b := c) (r := a) (Or.inl ha)
    rw [intervalIntegral.integral_of_le hc.le] at h
