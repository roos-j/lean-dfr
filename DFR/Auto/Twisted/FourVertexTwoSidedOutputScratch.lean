/-! ## Two-sided finite output-layer summation

For the four-vertex argument, weak `L¹` controls low output layers while a
previous strong estimate at an exponent strictly larger than the target
controls high layers.  The finite theorem below is the scalar part of that
argument.  It is deliberately stated for arbitrary geometric bases: in the
application they are `2^(R - 1)` and `2^(R₀ - R)`.
-/

/-- A finite family of integer geometric levels above a lower level is
dominated by the forward geometric tail beginning at that level. -/
theorem scratch_sum_zpow_le_geometric_lower
    (a : ℝ) (ha : 1 < a) (N : Finset ℤ) (K : ℤ)
    (hN : ∀ n ∈ N, K ≤ n) :
    (∑ n ∈ N, a ^ (-n)) ≤ a ^ (-K) * (1 - a⁻¹)⁻¹ := by
  classical
  let Nneg : Finset ℤ := N.image (fun n : ℤ => -n)
  have hNneg : ∀ m ∈ Nneg, m ≤ -K := by
    intro m hm
    rcases Finset.mem_image.mp hm with ⟨n, hn, rfl⟩
    omega
  have hupper := sum_zpow_le_geometric_upper a ha Nneg (-K) hNneg
  have hrewrite : (∑ n ∈ N, a ^ (-n)) = ∑ m ∈ Nneg, a ^ m := by
    symm
    dsimp only [Nneg]
    rw [Finset.sum_image]
    · rfl
    · intro x hx y hy hxy
      omega
  rw [hrewrite]
  exact hupper

/-- A finite output-layer moment is bounded uniformly when its low layers
have weak-one geometric growth and its high layers have geometric decay from
a stronger output exponent.  `K` is the atom-dependent crossover level.

No cardinality of `L` occurs in the conclusion.  Thus this is the exact
replacement for the otherwise sharp weak-one `L.card` loss. -/
theorem scratch_twoSidedOutputLayer_sum_le
    (a b Aweak Astrong : ℝ) (ha : 1 < a) (hb : 1 < b)
    (hAweak : 0 ≤ Aweak) (hAstrong : 0 ≤ Astrong)
    (L : Finset ℤ) (K : ℤ) (W : ℤ → ℝ)
    (hlow : ∀ ell ∈ L, ell ≤ K → W ell ≤ Aweak * a ^ ell)
    (hhigh : ∀ ell ∈ L, K < ell → W ell ≤ Astrong * b ^ (-ell)) :
    (∑ ell ∈ L, W ell) ≤
      Aweak * (a ^ K * (1 - a⁻¹)⁻¹) +
        Astrong * (b ^ (-K) * (1 - b⁻¹)⁻¹) := by
  classical
  let Llow : Finset ℤ := L.filter (fun ell => ell ≤ K)
  let Lhigh : Finset ℤ := L.filter (fun ell => ¬ ell ≤ K)
  have hlow_levels : ∀ ell ∈ Llow, ell ≤ K := by
    intro ell hell
    exact (Finset.mem_filter.mp hell).2
  have hhigh_levels : ∀ ell ∈ Lhigh, K ≤ ell := by
    intro ell hell
    have hnot : ¬ ell ≤ K := (Finset.mem_filter.mp hell).2
    omega
  have hlow_sum :
      (∑ ell ∈ Llow, W ell) ≤
        Aweak * (a ^ K * (1 - a⁻¹)⁻¹) := by
    calc
      (∑ ell ∈ Llow, W ell) ≤ ∑ ell ∈ Llow, Aweak * a ^ ell := by
        apply Finset.sum_le_sum
        intro ell hell
        have hellL : ell ∈ L := (Finset.mem_filter.mp hell).1
        exact hlow ell hellL (hlow_levels ell hell)
      _ = Aweak * (∑ ell ∈ Llow, a ^ ell) := by
        rw [Finset.mul_sum]
      _ ≤ Aweak * (a ^ K * (1 - a⁻¹)⁻¹) := by
        apply mul_le_mul_of_nonneg_left
          (sum_zpow_le_geometric_upper a ha Llow K hlow_levels)
        exact hAweak
  have hhigh_sum :
      (∑ ell ∈ Lhigh, W ell) ≤
        Astrong * (b ^ (-K) * (1 - b⁻¹)⁻¹) := by
    calc
      (∑ ell ∈ Lhigh, W ell) ≤ ∑ ell ∈ Lhigh, Astrong * b ^ (-ell) := by
        apply Finset.sum_le_sum
        intro ell hell
        have hellL : ell ∈ L := (Finset.mem_filter.mp hell).1
        have hlt : K < ell := by omega
        exact hhigh ell hellL hlt
      _ = Astrong * (∑ ell ∈ Lhigh, b ^ (-ell)) := by
        rw [Finset.mul_sum]
      _ ≤ Astrong * (b ^ (-K) * (1 - b⁻¹)⁻¹) := by
        apply mul_le_mul_of_nonneg_left
          (scratch_sum_zpow_le_geometric_lower b hb Lhigh K hhigh_levels)
        exact hAstrong
  calc
    (∑ ell ∈ L, W ell) =
        (∑ ell ∈ Llow, W ell) + ∑ ell ∈ Lhigh, W ell := by
          dsimp only [Llow, Lhigh]
          rw [← Finset.sum_filter_add_sum_filter_not]
    _ ≤ Aweak * (a ^ K * (1 - a⁻¹)⁻¹) +
        Astrong * (b ^ (-K) * (1 - b⁻¹)⁻¹) :=
      add_le_add hlow_sum hhigh_sum

end
