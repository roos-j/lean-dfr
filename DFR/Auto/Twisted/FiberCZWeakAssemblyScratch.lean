    {α : Type*} [MeasurableSpace α] (μ : Measure α) (T : α → ℝ)
    (E : Set α) {a : ℝ} (_ha : 0 < a)
    (hT : Integrable T (μ.restrict Eᶜ)) :
    ENNReal.ofReal a * μ ({x | a < T x} ∩ Eᶜ) ≤
      ∫⁻ x in Eᶜ, ENNReal.ofReal (T x) ∂μ := by
  have hmarkov := mul_meas_ge_le_lintegral₀
    hT.1.aemeasurable.ennreal_ofReal (ENNReal.ofReal a)
  have hsub : ({x | a < T x} ∩ Eᶜ) ⊆
      {x | ENNReal.ofReal a ≤ ENNReal.ofReal (T x)} ∩ Eᶜ := by
    intro x hx
    exact ⟨ENNReal.ofReal_le_ofReal hx.1.le, hx.2⟩
  calc
    ENNReal.ofReal a * μ ({x | a < T x} ∩ Eᶜ) ≤
        ENNReal.ofReal a * (μ.restrict Eᶜ)
          {x | ENNReal.ofReal a ≤ ENNReal.ofReal (T x)} := by
      apply mul_le_mul_right
      exact (measure_mono hsub).trans (Measure.le_restrict_apply Eᶜ _)
