/-! ## Measure-level finite fiber Calderón--Zygmund assembly

The finite one-fiber decomposition supplies a pointwise good-part plus
unsigned bad-tail bound away from its exceptional set.  These elementary
lemmas isolate the subsequent weak `(1,1)` union and Chebyshev bookkeeping
without choosing a particular fiber operator.
-/

/-- Away from an exceptional set, a good-part plus nonnegative-tail pointwise
bound gives the standard three-piece Calderón--Zygmund level-set inclusion. -/
theorem scratch_fiberCZ_level_subset_exceptional_good_badTail
    {α : Type*} [MeasurableSpace α] (F G : α → ℂ) (T : α → ℝ)
    (E : Set α) (lambda : ℝ)
    (hpoint : ∀ x, x ∉ E → ‖F x‖ ≤ ‖G x‖ + T x) :
    {x | lambda < ‖F x‖} ⊆ E ∪
      ({x | lambda / 2 < ‖G x‖} ∪
        ({x | lambda / 2 < T x} ∩ Eᶜ)) := by
  intro x hx
  by_cases hxE : x ∈ E
  · exact Or.inl hxE
  · refine Or.inr ?_
    by_cases hgood : lambda / 2 < ‖G x‖
    · exact Or.inl hgood
    · refine Or.inr ⟨?_, by simpa using hxE⟩
      by_contra htail
      have hgood' : ‖G x‖ ≤ lambda / 2 := le_of_not_gt hgood
      have htail' : T x ≤ lambda / 2 := le_of_not_gt htail
      have hbound : ‖F x‖ ≤ lambda := by
        calc
          ‖F x‖ ≤ ‖G x‖ + T x := hpoint x hxE
          _ ≤ lambda / 2 + lambda / 2 := add_le_add hgood' htail'
          _ = lambda := by ring
      exact (not_lt_of_ge hbound) hx

/-- The measure form of the finite fiber Calderón--Zygmund level split.  No
measurability is needed for this outer-union estimate. -/
theorem scratch_fiberCZ_measure_level_le_exceptional_good_badTail
    {α : Type*} [MeasurableSpace α] (μ : Measure α)
    (F G : α → ℂ) (T : α → ℝ) (E : Set α) (lambda : ℝ)
    (hpoint : ∀ x, x ∉ E → ‖F x‖ ≤ ‖G x‖ + T x) :
    μ {x | lambda < ‖F x‖} ≤
      μ E + (μ {x | lambda / 2 < ‖G x‖} +
        μ ({x | lambda / 2 < T x} ∩ Eᶜ)) := by
  have hsub := scratch_fiberCZ_level_subset_exceptional_good_badTail
    F G T E lambda hpoint
  calc
    μ {x | lambda < ‖F x‖} ≤
        μ (E ∪ ({x | lambda / 2 < ‖G x‖} ∪
          ({x | lambda / 2 < T x} ∩ Eᶜ))) := measure_mono hsub
    _ ≤ μ E + μ ({x | lambda / 2 < ‖G x‖} ∪
          ({x | lambda / 2 < T x} ∩ Eᶜ)) := measure_union_le _ _
    _ ≤ μ E + (μ {x | lambda / 2 < ‖G x‖} +
          μ ({x | lambda / 2 < T x} ∩ Eᶜ)) :=
      add_le_add le_rfl (measure_union_le _ _)

/-- Quantitative weak-one bookkeeping for the preceding level split.  The
three supplied terms may come respectively from the stopping exceptional-set
bound, a good-part Chebyshev estimate, and an exterior bad-tail Chebyshev
estimate. -/
theorem scratch_fiberCZ_weakOne_assembly
    {α : Type*} [MeasurableSpace α] (μ : Measure α)
    (F G : α → ℂ) (T : α → ℝ) (E : Set α) (lambda : ℝ)
    (hpoint : ∀ x, x ∉ E → ‖F x‖ ≤ ‖G x‖ + T x)
    (Aexception Agood Atail : ℝ≥0∞)
    (hexception : ENNReal.ofReal lambda * μ E ≤ Aexception)
    (hgood : ENNReal.ofReal (lambda / 2) *
      μ {x | lambda / 2 < ‖G x‖} ≤ Agood)
    (htail : ENNReal.ofReal (lambda / 2) *
      μ ({x | lambda / 2 < T x} ∩ Eᶜ) ≤ Atail) :
    ENNReal.ofReal lambda * μ {x | lambda < ‖F x‖} ≤
      Aexception + 2 * Agood + 2 * Atail := by
  have hmeasure := scratch_fiberCZ_measure_level_le_exceptional_good_badTail
    μ F G T E lambda hpoint
  have hlambda : ENNReal.ofReal lambda =
      2 * ENNReal.ofReal (lambda / 2) := by
    rw [show lambda = 2 * (lambda / 2) by ring,
      ENNReal.ofReal_mul (by norm_num)]
    norm_num
  calc
    ENNReal.ofReal lambda * μ {x | lambda < ‖F x‖} ≤
        ENNReal.ofReal lambda * (μ E +
          (μ {x | lambda / 2 < ‖G x‖} +
            μ ({x | lambda / 2 < T x} ∩ Eᶜ))) :=
      mul_le_mul_right hmeasure _
    _ = ENNReal.ofReal lambda * μ E +
        (2 * (ENNReal.ofReal (lambda / 2) *
          μ {x | lambda / 2 < ‖G x‖}) +
        2 * (ENNReal.ofReal (lambda / 2) *
          μ ({x | lambda / 2 < T x} ∩ Eᶜ))) := by
      rw [hlambda]
      ring
    _ ≤ Aexception + (2 * Agood + 2 * Atail) :=
      add_le_add hexception
        (add_le_add
          (mul_le_mul_of_nonneg_left hgood (by norm_num))
          (mul_le_mul_of_nonneg_left htail (by norm_num)))
    _ = Aexception + 2 * Agood + 2 * Atail := by ring

/-- Markov's inequality for the exterior real bad tail in the exact strict
level-set form used by the fiber CZ assembly. -/
