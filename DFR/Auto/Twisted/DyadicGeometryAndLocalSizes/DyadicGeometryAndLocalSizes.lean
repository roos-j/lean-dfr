  unfold bracketKernel
  change (∫ x : ℝ, (fun y : ℝ ↦ (1 + y) ^ (-10 : ℝ)) |x|) = 2 / 9
  rw [integral_comp_abs (f := fun y : ℝ ↦ (1 + y) ^ (-10 : ℝ))]
