/-! ### One-dimensional kernel dilations

These definitions retain the normalization and translation convention fixed
at the start of the blueprint: `v_(s)(x) = s⁻¹ v(x / s)` and
`v_(s,a)(x) = v_(s)(x-a)`. -/

/-- Mass-normalized one-dimensional dilation of a scalar-valued kernel. -/
def kernelDilate {V : Type*} [SMul ℝ V] (v : ℝ → V) (s x : ℝ) : V :=
  s⁻¹ • v (x / s)

/-- The translated, mass-normalized kernel `v_{s,a}`. -/
def kernelAt {V : Type*} [SMul ℝ V] (v : ℝ → V) (s a x : ℝ) : V :=
  kernelDilate v s (x - a)

theorem kernelAt_one (v : ℝ → ℝ) (a x : ℝ) : kernelAt v 1 a x = v (x - a) := by
  simp [kernelAt, kernelDilate]

/-- The precise nested-dilation convention used repeatedly in the source. -/
theorem kernelAt_dilate_translate {V : Type*} [AddCommMonoid V] [Module ℝ V] (v : ℝ → V)
    {s : ℝ} (hs : s ≠ 0) (r a x : ℝ) :
    kernelAt (kernelAt v 1 r) s a x = kernelAt v s (a + s * r) x := by
  simp only [kernelAt, kernelDilate, inv_one, one_smul]
  congr 2
  field_simp
  ring

/-- The translated and mass-normalized comparison kernel. -/
def bracketKernelAt (s a x : ℝ) : ℝ := kernelAt bracketKernel s a x

theorem integrable_bracketKernelAt {s : ℝ} (hs : 0 < s) (a : ℝ) :
    Integrable (bracketKernelAt s a) := by
  unfold bracketKernelAt kernelAt kernelDilate
  exact ((integrable_bracketKernel.comp_div hs.ne').comp_sub_right a).smul (s⁻¹ : ℝ)

theorem integral_bracketKernelAt {s : ℝ} (hs : 0 < s) (a : ℝ) :
    ∫ x : ℝ, bracketKernelAt s a x = 2 / 9 := by
  unfold bracketKernelAt kernelAt kernelDilate
  rw [integral_smul]
  rw [integral_sub_right_eq_self (μ := volume) (fun x : ℝ ↦ bracketKernel (x / s)) a]
  rw [Measure.integral_comp_div]
  simp [abs_of_pos hs, integral_bracketKernel, hs.ne']

/-- A one-coordinate comparison of bracket kernels.  It is the elementary
scale-and-center estimate behind the local-size comparison: `s` is no larger
than `L`, is at least `L / b`, and the two centers are within `L / 2`. -/
theorem bracketKernelAt_le_of_scale_center
    {s L b p c y : ℝ} (hs : 0 < s) (hL : 0 < L)
    (hscaleLower : L ≤ b * s) (hscaleUpper : s ≤ L)
    (hcenter : |p - c| ≤ L / 2) :
    bracketKernelAt s p y ≤
      b * (3 / 2 : ℝ) ^ 10 * bracketKernelAt L c y := by
  let A : ℝ := 1 + |(y - p) / s|
  let B : ℝ := 1 + |(y - c) / L|
  let C : ℝ := 3 / 2
  have hApos : 0 < A := by
    dsimp [A]
    positivity
  have hBpos : 0 < B := by
    dsimp [B]
    positivity
  have hCpos : 0 < C := by
    dsimp [C]
    norm_num
  have hbpos : 0 < b := by
    nlinarith [hscaleLower]
  have hdist : |y - c| ≤ |y - p| + |p - c| := by
    calc
      |y - c| = |(y - p) + (p - c)| := by congr 1 ; ring
      _ ≤ |y - p| + |p - c| := abs_add_le _ _
  have hpc : |p - c| / L ≤ 1 / 2 := by
    apply (div_le_iff₀ hL).mpr
    nlinarith [hcenter]
  have hratio : |y - p| / L ≤ |y - p| / s :=
    div_le_div_of_nonneg_left (abs_nonneg _) hs hscaleUpper
  have hdistdiv : |y - c| / L ≤ |y - p| / s + 1 / 2 := by
    calc
      |y - c| / L ≤ (|y - p| + |p - c|) / L :=
        div_le_div_of_nonneg_right hdist hL.le
      _ = |y - p| / L + |p - c| / L := by ring
      _ ≤ |y - p| / s + 1 / 2 := by gcongr
  have hBA : B ≤ C * A := by
    have habsdiv : |(y - p) / s| = |y - p| / s := by
      rw [abs_div, abs_of_pos hs]
    have habsdiv' : |(y - c) / L| = |y - c| / L := by
      rw [abs_div, abs_of_pos hL]
    have hquotient_nonneg : 0 ≤ |y - p| / s :=
      div_nonneg (abs_nonneg _) hs.le
    dsimp [A, B, C]
    rw [habsdiv, habsdiv']
    nlinarith [hdistdiv, hquotient_nonneg]
  have hBApow : B ^ 10 ≤ C ^ 10 * A ^ 10 := by
    calc
      B ^ 10 ≤ (C * A) ^ 10 := pow_le_pow_left₀ hBpos.le hBA 10
      _ = C ^ 10 * A ^ 10 := by rw [mul_pow]
  have hA10pos : 0 < A ^ 10 := pow_pos hApos _
  have hB10pos : 0 < B ^ 10 := pow_pos hBpos _
  have hinv : (A ^ 10)⁻¹ ≤ C ^ 10 * (B ^ 10)⁻¹ := by
    rw [← one_div, ← div_eq_mul_inv]
    exact (div_le_div_iff₀ hA10pos hB10pos).mpr (by simpa using hBApow)
  have hscaleInv : s⁻¹ ≤ b * L⁻¹ := by
    rw [← one_div, ← div_eq_mul_inv]
    exact (div_le_div_iff₀ hs hL).mpr (by simpa using hscaleLower)
  have hmain : s⁻¹ * (A ^ 10)⁻¹ ≤
      (b * L⁻¹) * (C ^ 10 * (B ^ 10)⁻¹) := by
    exact mul_le_mul hscaleInv hinv (by positivity) (by positivity)
  simpa only [bracketKernelAt, kernelAt, kernelDilate, smul_eq_mul,
    bracketKernel_eq_inv_pow, A, B, C] using
    (hmain.trans_eq (by ring))

/-! ## Anisotropic dyadic boxes

This is the literal integer-level grid from `def:tree`.  In particular,
parents use Euclidean division on `ℤ`; this is the floor operation stipulated
by the source even for negative coordinate indices.
-/

/-- A source dyadic box is determined by an integral scale and three integral
coordinate indices. -/
structure AnisoBox (α : Anisotropy) where
  level : ℤ
  index : Fin 3 → ℤ
  deriving DecidableEq

/-- The number of children in coordinate `i`. -/
def anisoRadix (α : Anisotropy) (i : Fin 3) : ℕ := 2 ^ α.weight i

/-- A coordinatewise child digit. -/
abbrev AnisoDigit (α : Anisotropy) := (i : Fin 3) → Fin (anisoRadix α i)

theorem anisoRadix_pos (α : Anisotropy) (i : Fin 3) : 0 < anisoRadix α i := by
  exact Nat.pow_pos (by norm_num)

/-- The side length in coordinate `i` of an anisotropic box. -/
noncomputable def boxSide (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) : ℝ :=
  (2 : ℝ) ^ (q.level * (α.weight i : ℤ))

/-- The source scale `\(\ell(Q)\)`. -/
noncomputable def boxLength (q : AnisoBox α) : ℝ := (2 : ℝ) ^ q.level

theorem boxSide_eq_length_pow (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    boxSide α q i = boxLength q ^ α.weight i := by
  simp only [boxSide, boxLength, ← zpow_natCast, zpow_mul]

theorem boxSide_pos (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    0 < boxSide α q i := by
  exact zpow_pos (by norm_num) _

theorem boxLength_pos (q : AnisoBox α) : 0 < boxLength q := by
  exact zpow_pos (by norm_num) _

/-- The half-open coordinate interval of a box. -/
noncomputable def boxInterval (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    Set ℝ :=
  Set.Ico ((q.index i : ℝ) * boxSide α q i)
    (((q.index i + 1 : ℤ) : ℝ) * boxSide α q i)

/-- The spatial half-open box `Q(k,n)`. -/
noncomputable def boxSet (α : Anisotropy) (q : AnisoBox α) : Set E3 :=
  Set.preimage (WithLp.ofLp : E3 → Fin 3 → ℝ)
    (Set.pi Set.univ (fun i ↦ boxInterval α q i))

/-- The source parent box, using integer floor division coordinatewise. -/
def boxParent (α : Anisotropy) (q : AnisoBox α) : AnisoBox α :=
  ⟨q.level + 1, fun i ↦ q.index i / (anisoRadix α i : ℤ)⟩

/-- The child selected by a coordinatewise digit. -/
def boxChild (α : Anisotropy) (q : AnisoBox α) (v : AnisoDigit α) : AnisoBox α :=
  ⟨q.level - 1, fun i ↦ (anisoRadix α i : ℤ) * q.index i + (v i : ℤ)⟩

/-- The finite family of source children. -/
def boxChildren (α : Anisotropy) (q : AnisoBox α) : Finset (AnisoBox α) :=
  Finset.univ.image (boxChild α q)

theorem boxParent_child (α : Anisotropy) (q : AnisoBox α) (v : AnisoDigit α) :
    boxParent α (boxChild α q v) = q := by
  cases q with
  | mk level index =>
    simp only [boxParent, boxChild, AnisoBox.mk.injEq]
    constructor
    · omega
    · funext i
      rw [Int.mul_add_ediv_left]
      · rw [Int.ediv_eq_zero_of_lt]
        · simp
        · exact_mod_cast Nat.zero_le (v i).val
        · exact_mod_cast (v i).isLt
      · exact_mod_cast (Nat.ne_of_gt (anisoRadix_pos α i))

theorem boxChild_injective (α : Anisotropy) (q : AnisoBox α) :
    Function.Injective (boxChild α q) := by
  intro v w h
  funext i
  have hi := congrFun (congrArg AnisoBox.index h) i
  dsimp [boxChild] at hi
  apply Fin.ext
  have hval : (v i : ℤ) = (w i : ℤ) := by linarith
  exact_mod_cast hval

/-- Every box has exactly `2^A` children, as in `lem:geometry`. -/
theorem card_boxChildren (α : Anisotropy) (q : AnisoBox α) :
    (boxChildren α q).card = 2 ^ α.homogeneousDimension := by
  unfold boxChildren
  rw [Finset.card_image_iff.mpr (boxChild_injective α q).injOn]
  rw [Finset.card_univ, Fintype.card_pi]
  have hc (i : Fin 3) : Fintype.card (Fin (anisoRadix α i)) = anisoRadix α i :=
    Fintype.card_fin _
  simp_rw [hc]
  unfold anisoRadix Anisotropy.homogeneousDimension
  rw [Finset.prod_pow_eq_pow_sum]

theorem measurableSet_boxSet (α : Anisotropy) (q : AnisoBox α) :
    MeasurableSet (boxSet α q) := by
  unfold boxSet
  apply (PiLp.volume_preserving_ofLp (Fin 3)).measurable
  apply MeasurableSet.pi Set.countable_univ
  intro i _
  exact measurableSet_Ico

/-- Integer division reconstructs every child digit, including at negative
indices.  This is the converse to `boxParent_child`. -/
theorem exists_boxChild_eq_of_boxParent_eq
    (α : Anisotropy) (q r : AnisoBox α)
    (h : boxParent α r = q) :
    ∃ v : AnisoDigit α, boxChild α q v = r := by
  cases q with
  | mk qlevel qindex =>
    cases r with
    | mk rlevel rindex =>
      simp only [boxParent, AnisoBox.mk.injEq] at h
      rcases h with ⟨hlevel, hindex⟩
      let v : AnisoDigit α := fun i ↦
        ⟨(rindex i % (anisoRadix α i : ℤ)).toNat, by
          rw [Int.toNat_lt
            (Int.emod_nonneg _ (by
              exact_mod_cast (Nat.ne_of_gt (anisoRadix_pos α i))))]
          exact Int.emod_lt_of_pos _ (by
            exact_mod_cast (anisoRadix_pos α i))⟩
      refine ⟨v, ?_⟩
      simp only [boxChild, AnisoBox.mk.injEq]
      constructor
      · omega
      · funext i
        have hrem :
            ((rindex i % (anisoRadix α i : ℤ)).toNat : ℤ) =
              rindex i % (anisoRadix α i : ℤ) :=
          Int.toNat_of_nonneg (Int.emod_nonneg _ (by
            exact_mod_cast (Nat.ne_of_gt (anisoRadix_pos α i))))
        dsimp [v]
        rw [← congrFun hindex i, hrem, Int.mul_ediv_add_emod]

theorem boxParent_eq_iff_exists_boxChild (α : Anisotropy) (q r : AnisoBox α) :
    boxParent α r = q ↔ ∃ v : AnisoDigit α, boxChild α q v = r := by
  constructor
  · exact exists_boxChild_eq_of_boxParent_eq α q r
  · rintro ⟨v, rfl⟩
    exact boxParent_child α q v

theorem boxSide_parent (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    boxSide α (boxParent α q) i =
      (anisoRadix α i : ℝ) * boxSide α q i := by
  unfold boxSide boxParent anisoRadix
  have hexp : (q.level + 1) * (α.weight i : ℤ) =
      q.level * (α.weight i : ℤ) + (α.weight i : ℤ) := by ring
  rw [hexp, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_natCast]
  norm_cast
  ring

theorem boxInterval_subset_parent (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    boxInterval α q i ⊆ boxInterval α (boxParent α q) i := by
  unfold boxInterval
  rw [boxSide_parent]
  simp only [boxParent]
  have hlt : (q.index i : ℝ) < ((q.index i + 1 : ℤ) : ℝ) := by
    have hltZ : q.index i < q.index i + 1 := by omega
    exact_mod_cast hltZ
  have hnonempty : (q.index i : ℝ) * boxSide α q i <
      ((q.index i + 1 : ℤ) : ℝ) * boxSide α q i :=
    mul_lt_mul_of_pos_right hlt (boxSide_pos α q i)
  apply (Set.Ico_subset_Ico_iff hnonempty).2
  constructor
  · let R : ℤ := anisoRadix α i
    have hRne : R ≠ 0 := by
      dsimp [R]
      exact_mod_cast (Nat.ne_of_gt (anisoRadix_pos α i))
    have hlowZ : (q.index i / R) * R ≤ q.index i :=
      Int.ediv_mul_le _ hRne
    have hlow : ((q.index i / R : ℤ) : ℝ) * (R : ℝ) ≤ q.index i := by
      exact_mod_cast hlowZ
    change ((q.index i / R : ℤ) : ℝ) * ((R : ℝ) * boxSide α q i) ≤
      (q.index i : ℝ) * boxSide α q i
    rw [← mul_assoc]
    exact mul_le_mul_of_nonneg_right hlow (boxSide_pos α q i).le
  · let R : ℤ := anisoRadix α i
    have hRpos : 0 < R := by
      dsimp [R]
      exact_mod_cast anisoRadix_pos α i
    have hrem : q.index i % R < R := Int.emod_lt_of_pos _ hRpos
    have hdecomp : q.index i % R + R * (q.index i / R) = q.index i :=
      Int.emod_add_mul_ediv _ _
    have huZ : q.index i + 1 ≤ (q.index i / R + 1) * R := by
      calc
        q.index i + 1 = q.index i % R + R * (q.index i / R) + 1 := by
          rw [hdecomp]
        _ ≤ R * (q.index i / R) + R := by linarith
        _ = (q.index i / R + 1) * R := by ring
    have hu : ((q.index i + 1 : ℤ) : ℝ) ≤
        ((q.index i / R + 1 : ℤ) : ℝ) * (R : ℝ) := by
      exact_mod_cast huZ
    change ((q.index i + 1 : ℤ) : ℝ) * boxSide α q i ≤
      ((q.index i / R + 1 : ℤ) : ℝ) * ((R : ℝ) * boxSide α q i)
    rw [← mul_assoc]
    exact mul_le_mul_of_nonneg_right hu (boxSide_pos α q i).le

theorem boxSet_subset_parent (α : Anisotropy) (q : AnisoBox α) :
    boxSet α q ⊆ boxSet α (boxParent α q) := by
  intro x hx
  rw [boxSet, Set.mem_preimage, Set.mem_pi] at hx ⊢
  intro i _
  exact boxInterval_subset_parent α q i (hx i (Set.mem_univ i))

/-- Boxes at a common grid level have common side lengths. -/
theorem boxSide_eq_of_level (α : Anisotropy) {q r : AnisoBox α}
    (hlevel : q.level = r.level) (i : Fin 3) :
    boxSide α q i = boxSide α r i := by
  unfold boxSide
  rw [hlevel]

/-- Distinct integer coordinate intervals at a fixed level are disjoint. -/
theorem boxInterval_disjoint_of_eq_level_of_ne_index
    (α : Anisotropy) {q r : AnisoBox α} (i : Fin 3)
    (hlevel : q.level = r.level) (hindex : q.index i ≠ r.index i) :
    Disjoint (boxInterval α q i) (boxInterval α r i) := by
  have hside : boxSide α r i = boxSide α q i :=
    (boxSide_eq_of_level α hlevel i).symm
  rw [boxInterval, boxInterval, hside]
  have hs : 0 < boxSide α q i := boxSide_pos α q i
  apply Set.disjoint_left.2
  intro x hx hy
  rcases hx with ⟨hxlo, hxhi⟩
  rcases hy with ⟨hylo, hyhi⟩
  rcases lt_or_gt_of_ne hindex with hlt | hgt
  · have hstep : q.index i + 1 ≤ r.index i := by omega
    have hstepR : ((q.index i + 1 : ℤ) : ℝ) * boxSide α q i ≤
        (r.index i : ℝ) * boxSide α q i := by
      apply mul_le_mul_of_nonneg_right _ hs.le
      exact_mod_cast hstep
    exact (not_le_of_gt hxhi) (hstepR.trans hylo)
  · have hstep : r.index i + 1 ≤ q.index i := by omega
    have hstepR : ((r.index i + 1 : ℤ) : ℝ) * boxSide α q i ≤
        (q.index i : ℝ) * boxSide α q i := by
      apply mul_le_mul_of_nonneg_right _ hs.le
      exact_mod_cast hstep
    exact (not_le_of_gt hyhi) (hstepR.trans hxlo)

/-- A disjoint coordinate interval makes the corresponding spatial boxes disjoint. -/
theorem boxSet_disjoint_of_disjoint_interval
    (α : Anisotropy) {q r : AnisoBox α} (i : Fin 3)
    (hi : Disjoint (boxInterval α q i) (boxInterval α r i)) :
    Disjoint (boxSet α q) (boxSet α r) := by
  apply Set.disjoint_left.2
  intro x hx hy
  rw [boxSet, Set.mem_preimage, Set.mem_pi] at hx hy
  exact (Set.disjoint_left.1 hi)
    (hx i (Set.mem_univ i)) (hy i (Set.mem_univ i))

/-- Distinct boxes at a common level are disjoint. -/
theorem boxSet_disjoint_of_eq_level_of_ne
    (α : Anisotropy) {q r : AnisoBox α}
    (hlevel : q.level = r.level) (hne : q ≠ r) :
    Disjoint (boxSet α q) (boxSet α r) := by
  have hindex : q.index ≠ r.index := by
    intro h
    apply hne
    cases q with
    | mk qlevel qindex =>
      cases r with
      | mk rlevel rindex =>
        simp only [AnisoBox.mk.injEq]
        exact ⟨hlevel, h⟩
  obtain ⟨i, hi⟩ : ∃ i, q.index i ≠ r.index i := by
    by_contra h
    push Not at h
    apply hindex
    funext i
    exact h i
  exact boxSet_disjoint_of_disjoint_interval α i
    (boxInterval_disjoint_of_eq_level_of_ne_index α i hlevel hi)

/-- The finite parent iterate used to compare boxes across levels. -/
def boxAncestor (α : Anisotropy) (n : ℕ) (q : AnisoBox α) : AnisoBox α :=
  (boxParent α)^[n] q

theorem boxAncestor_level (α : Anisotropy) (n : ℕ) (q : AnisoBox α) :
    (boxAncestor α n q).level = q.level + n := by
  induction n generalizing q with
  | zero => simp [boxAncestor]
  | succ n ih =>
    have ih' : ((boxParent α)^[n] q).level = q.level + n := by
      simpa [boxAncestor] using ih q
    simp only [boxAncestor, Function.iterate_succ_apply', Nat.cast_add,
      Nat.cast_one]
    change ((boxParent α ((boxParent α)^[n] q)).level) = q.level + (↑n + 1)
    simp only [boxParent]
    rw [ih']
    ring

theorem boxAncestor_subset (α : Anisotropy) (n : ℕ) (q : AnisoBox α) :
    boxSet α q ⊆ boxSet α (boxAncestor α n q) := by
  induction n with
  | zero => simp [boxAncestor]
  | succ n ih =>
    rw [boxAncestor, Function.iterate_succ_apply']
    exact ih.trans (boxSet_subset_parent α _)

/-- Intersecting grid boxes are nested when their levels are ordered. -/
theorem boxSet_nested_of_inter_nonempty (α : Anisotropy)
    {q r : AnisoBox α} (hlevel : q.level ≤ r.level)
    (hinter : (boxSet α q ∩ boxSet α r).Nonempty) :
    boxSet α q ⊆ boxSet α r := by
  let n : ℕ := (r.level - q.level).toNat
  have hn : (n : ℤ) = r.level - q.level := by
    dsimp [n]
    rw [Int.toNat_of_nonneg (sub_nonneg.mpr hlevel)]
  have hAncestorLevel : (boxAncestor α n q).level = r.level := by
    rw [boxAncestor_level, hn]
    ring
  have hAncestorEq : boxAncestor α n q = r := by
    by_contra hne
    have hdisj := boxSet_disjoint_of_eq_level_of_ne α hAncestorLevel hne
    rcases hinter with ⟨x, hx⟩
    exact (Set.disjoint_left.1 hdisj)
      (boxAncestor_subset α n q hx.1) hx.2
  simpa [hAncestorEq] using boxAncestor_subset α n q

/-- The coordinate side length at the child level. -/
noncomputable def boxSubside (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) : ℝ :=
  (2 : ℝ) ^ ((q.level - 1) * (α.weight i : ℤ))

/-- The `d`-th coordinate child interval of a box. -/
noncomputable def boxChildInterval (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) (d : Fin (anisoRadix α i)) : Set ℝ :=
  Set.Ico
    (((((anisoRadix α i : ℤ) * q.index i + (d : ℤ)) : ℤ) : ℝ) *
      boxSubside α q i)
    (((((anisoRadix α i : ℤ) * q.index i + (d : ℤ) + 1 : ℤ) : ℤ) : ℝ) *
      boxSubside α q i)

theorem boxSide_eq_radix_mul_subside (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    boxSide α q i = (anisoRadix α i : ℝ) * boxSubside α q i := by
  unfold boxSide anisoRadix boxSubside
  have hexp : q.level * (α.weight i : ℤ) =
      (q.level - 1) * (α.weight i : ℤ) + (α.weight i : ℤ) := by ring
  rw [hexp, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_natCast]
  norm_cast
  ring

theorem boxChildInterval_eq_boxInterval_child
    (α : Anisotropy) (q : AnisoBox α) (v : AnisoDigit α) (i : Fin 3) :
    boxChildInterval α q i (v i) = boxInterval α (boxChild α q v) i := by
  rfl

/-- A parent coordinate interval is covered by its finitely many child intervals. -/
theorem boxInterval_subset_iUnion_childInterval
    (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    boxInterval α q i ⊆
      ⋃ d : Fin (anisoRadix α i), boxChildInterval α q i d := by
  let R : ℕ := anisoRadix α i
  let a : ℕ → ℝ := fun d ↦ ((R : ℤ) * q.index i + d : ℤ) * boxSubside α q i
  have htiling := Ico_subset_biUnion_Ico R a
  intro x hx
  have hzero : a 0 = (q.index i : ℝ) * boxSide α q i := by
    dsimp [a, R]
    rw [boxSide_eq_radix_mul_subside]
    push_cast
    ring
  have htop : a R = ((q.index i + 1 : ℤ) : ℝ) * boxSide α q i := by
    dsimp [a, R]
    rw [boxSide_eq_radix_mul_subside]
    push_cast
    ring
  have hx' : x ∈ Set.Ico (a 0) (a R) := by
    rw [hzero, htop]
    exact hx
  rcases Set.mem_iUnion.1 (htiling hx') with ⟨d, hd⟩
  rcases Set.mem_iUnion.1 hd with ⟨hdR, hxd⟩
  let e : Fin (anisoRadix α i) := ⟨d, by
    simpa only [R] using Finset.mem_range.mp hdR⟩
  refine Set.mem_iUnion.2 ⟨e, ?_⟩
  have ha : a d =
      (((((anisoRadix α i : ℤ) * q.index i + (e : ℤ)) : ℤ) : ℝ) *
        boxSubside α q i) := by
    dsimp [a, R, e]
  have hanext : a (d + 1) =
      (((((anisoRadix α i : ℤ) * q.index i + (e : ℤ) + 1 : ℤ) : ℤ) : ℝ) *
        boxSubside α q i) := by
    dsimp [a, R, e]
    push_cast
    ring
  simpa only [boxChildInterval, ← ha, ← hanext] using hxd

/-- The spatial box is covered by the union of its finitely many children. -/
theorem boxSet_subset_children_union (α : Anisotropy) (q : AnisoBox α) :
    boxSet α q ⊆ ⋃ r ∈ boxChildren α q, boxSet α r := by
  intro x hx
  rw [boxSet, Set.mem_preimage, Set.mem_pi] at hx
  have hcoord : ∀ i, ∃ d : Fin (anisoRadix α i),
      (WithLp.ofLp x : Fin 3 → ℝ) i ∈ boxChildInterval α q i d := by
    intro i
    rcases Set.mem_iUnion.1
      (boxInterval_subset_iUnion_childInterval α q i
        (hx i (Set.mem_univ i))) with ⟨d, hd⟩
    exact ⟨d, hd⟩
  choose d hd using hcoord
  let v : AnisoDigit α := fun i ↦ d i
  have hchild : x ∈ boxSet α (boxChild α q v) := by
    rw [boxSet, Set.mem_preimage, Set.mem_pi]
    intro i _
    rw [← boxChildInterval_eq_boxInterval_child]
    exact hd i
  refine Set.mem_iUnion.2 ⟨boxChild α q v, ?_⟩
  refine Set.mem_iUnion.2 ⟨?_, hchild⟩
  exact Finset.mem_image.2 ⟨v, Finset.mem_univ v, rfl⟩

theorem children_union_subset_boxSet (α : Anisotropy) (q : AnisoBox α) :
    (⋃ r ∈ boxChildren α q, boxSet α r) ⊆ boxSet α q := by
  intro x hx
  rcases Set.mem_iUnion.1 hx with ⟨r, hr⟩
  rcases Set.mem_iUnion.1 hr with ⟨hrmem, hxr⟩
  rcases Finset.mem_image.1 hrmem with ⟨v, hv, rfl⟩
  simpa only [boxParent_child] using boxSet_subset_parent α (boxChild α q v) hxr

/-- Exact finite child partition of a grid box. -/
theorem boxSet_eq_children_union (α : Anisotropy) (q : AnisoBox α) :
    boxSet α q = ⋃ r ∈ boxChildren α q, boxSet α r := by
  exact Set.Subset.antisymm (boxSet_subset_children_union α q)
    (children_union_subset_boxSet α q)

/-! ### Finite convex trees and scale regions

This is the finite combinatorial form of `def:tree`.  It intentionally keeps
the tree as a `Finset` of literal grid boxes, so every union and boundary sum
in the source remains finite and exact.
-/

/-- A finite collection of anisotropic grid boxes. -/
abbrev BoxCollection (α : Anisotropy) := Finset (AnisoBox α)

/-- Convexity of a finite collection in the grid-inclusion order. -/
def IsConvexCollection (α : Anisotropy) (S : BoxCollection α) : Prop :=
  ∀ ⦃q r w : AnisoBox α⦄, q ∈ S → r ∈ S →
    boxSet α q ⊆ boxSet α w → boxSet α w ⊆ boxSet α r → w ∈ S

/-- A source convex tree: a nonempty finite convex collection together with
its largest (root) box. -/
structure FiniteConvexTree (α : Anisotropy) where
  boxes : BoxCollection α
  nonempty : boxes.Nonempty
  root : AnisoBox α
  root_mem : root ∈ boxes
  convex : IsConvexCollection α boxes
  below_root : ∀ q : AnisoBox α, q ∈ boxes → boxSet α q ⊆ boxSet α root

/-- The boxes of a tree at a literal integer level. -/
def treeAtLevel {α : Anisotropy} (T : FiniteConvexTree α) (k : ℤ) :
    BoxCollection α :=
  T.boxes.filter fun q ↦ q.level = k

/-- The spatial union at one tree level. -/
noncomputable def treeLevelSet {α : Anisotropy} (T : FiniteConvexTree α) (k : ℤ) :
    Set E3 :=
  ⋃ q ∈ treeAtLevel T k, boxSet α q

/-- The leaves are exactly the first children outside the finite tree. -/
def treeLeaves {α : Anisotropy} (T : FiniteConvexTree α) : BoxCollection α :=
  T.boxes.biUnion fun q ↦ (boxChildren α q).filter fun l ↦ l ∉ T.boxes

/-- The upper half-open scale band attached to a box. -/
noncomputable def boxScaleBand (q : AnisoBox α) : Set ℝ :=
  Set.Ioc (boxLength q / 2) (boxLength q)

/-- The box-scale cell in `E_3 × ℝ`. -/
noncomputable def boxScaleRegion (α : Anisotropy) (q : AnisoBox α) : Set (E3 × ℝ) :=
  boxSet α q ×ˢ boxScaleBand q

/-- The source region `Ω_𝒬` for an arbitrary finite collection. -/
noncomputable def collectionRegion (α : Anisotropy) (S : BoxCollection α) : Set (E3 × ℝ) :=
  ⋃ q ∈ S, boxScaleRegion α q

/-- A tree's source region. -/
noncomputable def treeRegion {α : Anisotropy} (T : FiniteConvexTree α) : Set (E3 × ℝ) :=
  collectionRegion α T.boxes

theorem mem_treeAtLevel_iff {α : Anisotropy} (T : FiniteConvexTree α)
    (k : ℤ) (q : AnisoBox α) :
    q ∈ treeAtLevel T k ↔ q ∈ T.boxes ∧ q.level = k := by
  simp [treeAtLevel]

theorem boxChildren_level (α : Anisotropy) {q r : AnisoBox α}
    (hr : r ∈ boxChildren α q) :
    r.level = q.level - 1 := by
  rcases Finset.mem_image.mp hr with ⟨v, _, rfl⟩
  rfl

/-- Literal leaf membership is equivalent to the parent formulation in the
source definition. -/
theorem mem_treeLeaves_iff {α : Anisotropy} (T : FiniteConvexTree α)
    (l : AnisoBox α) :
    l ∈ treeLeaves T ↔ l ∉ T.boxes ∧ boxParent α l ∈ T.boxes := by
  constructor
  · intro hl
    rw [treeLeaves, Finset.mem_biUnion] at hl
    rcases hl with ⟨q, hq, hl⟩
    rw [Finset.mem_filter] at hl
    constructor
    · exact hl.2
    · rcases Finset.mem_image.mp hl.1 with ⟨v, hv, hchild⟩
      subst l
      simpa only [boxParent_child] using hq
  · rintro ⟨hlnot, hlparent⟩
    rw [treeLeaves, Finset.mem_biUnion]
    refine ⟨boxParent α l, hlparent, ?_⟩
    rw [Finset.mem_filter]
    constructor
    · rcases (boxParent_eq_iff_exists_boxChild α (boxParent α l) l).mp rfl with
        ⟨v, hv⟩
      exact Finset.mem_image.mpr ⟨v, Finset.mem_univ _, hv⟩
    · exact hlnot

theorem treeLeaves_not_mem {α : Anisotropy} (T : FiniteConvexTree α)
    {l : AnisoBox α} (hl : l ∈ treeLeaves T) : l ∉ T.boxes :=
  (mem_treeLeaves_iff T l).mp hl |>.1

theorem treeLeaves_parent_mem {α : Anisotropy} (T : FiniteConvexTree α)
    {l : AnisoBox α} (hl : l ∈ treeLeaves T) : boxParent α l ∈ T.boxes :=
  (mem_treeLeaves_iff T l).mp hl |>.2

theorem boxSet_leaf_subset_root {α : Anisotropy} (T : FiniteConvexTree α)
    {l : AnisoBox α} (hl : l ∈ treeLeaves T) :
    boxSet α l ⊆ boxSet α T.root :=
  (boxSet_subset_parent α l).trans (T.below_root _ (treeLeaves_parent_mem T hl))

theorem pairwiseDisjoint_treeAtLevel {α : Anisotropy} (T : FiniteConvexTree α)
    (k : ℤ) :
    (↑(treeAtLevel T k) : Set (AnisoBox α)).PairwiseDisjoint (boxSet α) := by
  intro q hq r hr hne
  have hqlevel : q.level = k := (mem_treeAtLevel_iff T k q).mp hq |>.2
  have hrlevel : r.level = k := (mem_treeAtLevel_iff T k r).mp hr |>.2
  exact boxSet_disjoint_of_eq_level_of_ne α (hqlevel.trans hrlevel.symm) hne

theorem measurableSet_treeLevelSet {α : Anisotropy} (T : FiniteConvexTree α)
    (k : ℤ) : MeasurableSet (treeLevelSet T k) := by
  unfold treeLevelSet
  exact Finset.measurableSet_biUnion (treeAtLevel T k)
    (fun q _ ↦ measurableSet_boxSet α q)

/-- Finiteness supplies a first absent child over every point of the root. -/
theorem boxSet_root_subset_leaves_union {α : Anisotropy} (T : FiniteConvexTree α) :
    boxSet α T.root ⊆ ⋃ l ∈ treeLeaves T, boxSet α l := by
  classical
  intro x hx
  let relevant : Finset (AnisoBox α) :=
    T.boxes.filter fun q ↦ x ∈ boxSet α q
  have hrelne : relevant.Nonempty := by
    refine ⟨T.root, Finset.mem_filter.mpr ⟨T.root_mem, hx⟩⟩
  let levels : Finset ℤ := relevant.image AnisoBox.level
  have hlevelsne : levels.Nonempty := hrelne.image AnisoBox.level
  let m : ℤ := levels.min' hlevelsne
  have hm : m ∈ levels := by
    dsimp [m]
    exact Finset.min'_mem levels hlevelsne
  rcases Finset.mem_image.mp hm with ⟨q, hqrel, hqlevel⟩
  have hqT : q ∈ T.boxes := (Finset.mem_filter.mp hqrel).1
  have hxq : x ∈ boxSet α q := (Finset.mem_filter.mp hqrel).2
  have hxchildren : x ∈ ⋃ r ∈ boxChildren α q, boxSet α r := by
    rw [← boxSet_eq_children_union α q]
    exact hxq
  rcases Set.mem_iUnion.1 hxchildren with ⟨r, hr⟩
  rcases Set.mem_iUnion.1 hr with ⟨hrchild, hxr⟩
  have hrnot : r ∉ T.boxes := by
    intro hrT
    have hrrel : r ∈ relevant := Finset.mem_filter.mpr ⟨hrT, hxr⟩
    have hrlevels : r.level ∈ levels := Finset.mem_image.mpr ⟨r, hrrel, rfl⟩
    have hmin := Finset.min'_le levels r.level hrlevels
    have hlevel := boxChildren_level α hrchild
    change m ≤ r.level at hmin
    omega
  have hrleaf : r ∈ treeLeaves T := by
    apply (mem_treeLeaves_iff T r).mpr
    constructor
    · exact hrnot
    · rcases Finset.mem_image.mp hrchild with ⟨v, hv, hr⟩
      subst r
      simpa only [boxParent_child] using hqT
  exact Set.mem_iUnion.2 ⟨r, Set.mem_iUnion.2 ⟨hrleaf, hxr⟩⟩

theorem leaves_union_subset_boxSet_root {α : Anisotropy} (T : FiniteConvexTree α) :
    (⋃ l ∈ treeLeaves T, boxSet α l) ⊆ boxSet α T.root := by
  intro x hx
  rcases Set.mem_iUnion.1 hx with ⟨l, hl⟩
  rcases Set.mem_iUnion.1 hl with ⟨hlleaf, hxl⟩
  exact boxSet_leaf_subset_root T hlleaf hxl

/-- The leaves cover the root exactly; pairwise disjointness is established
separately from convexity below. -/
theorem boxSet_root_eq_leaves_union {α : Anisotropy} (T : FiniteConvexTree α) :
    boxSet α T.root = ⋃ l ∈ treeLeaves T, boxSet α l :=
  Set.Subset.antisymm (boxSet_root_subset_leaves_union T)
    (leaves_union_subset_boxSet_root T)

/-- Convexity excludes nested distinct leaves, so the leaf boxes are pairwise
disjoint exactly (not only almost everywhere). -/
theorem pairwiseDisjoint_boxSet_treeLeaves {α : Anisotropy} (T : FiniteConvexTree α) :
    (↑(treeLeaves T) : Set (AnisoBox α)).PairwiseDisjoint (boxSet α) := by
  intro l hl r hr hne
  apply Set.disjoint_left.2
  intro x hxl hxr
  rcases lt_trichotomy l.level r.level with hlt | heq | hgt
  · have hparentNested : boxSet α (boxParent α l) ⊆ boxSet α r := by
      have hparentLevel : (boxParent α l).level = l.level + 1 := rfl
      apply boxSet_nested_of_inter_nonempty α (by omega)
      exact ⟨x, boxSet_subset_parent α l hxl, hxr⟩
    have hrT : r ∈ T.boxes :=
      T.convex (treeLeaves_parent_mem T hl) (treeLeaves_parent_mem T hr)
        hparentNested (boxSet_subset_parent α r)
    exact (treeLeaves_not_mem T hr) hrT
  · have hdisj := boxSet_disjoint_of_eq_level_of_ne α heq hne
    exact (Set.disjoint_left.1 hdisj) hxl hxr
  · have hparentNested : boxSet α (boxParent α r) ⊆ boxSet α l := by
      have hparentLevel : (boxParent α r).level = r.level + 1 := rfl
      apply boxSet_nested_of_inter_nonempty α (by omega)
      exact ⟨x, boxSet_subset_parent α r hxr, hxl⟩
    have hlT : l ∈ T.boxes :=
      T.convex (treeLeaves_parent_mem T hr) (treeLeaves_parent_mem T hl)
        hparentNested (boxSet_subset_parent α l)
    exact (treeLeaves_not_mem T hl) hlT

theorem measure_leaves_union {α : Anisotropy} (T : FiniteConvexTree α) :
    volume (⋃ l ∈ treeLeaves T, boxSet α l) =
      ∑ l ∈ treeLeaves T, volume (boxSet α l) := by
  exact MeasureTheory.measure_biUnion_finset
    (pairwiseDisjoint_boxSet_treeLeaves T)
    (fun l hl ↦ measurableSet_boxSet α l)

/-- The exact finite leaf-volume partition from `lem:geometry`. -/
theorem volume_root_eq_sum_volume_leaves {α : Anisotropy} (T : FiniteConvexTree α) :
    volume (boxSet α T.root) = ∑ l ∈ treeLeaves T, volume (boxSet α l) := by
  rw [boxSet_root_eq_leaves_union T]
  exact measure_leaves_union T

/-! ### Oriented grid faces

The face layer retains the source's incident-box encoding.  This makes the
surviving-face cancellation later a finite equality of explicitly indexed
objects rather than an informal boundary convention.
-/

/-- The two outward orientations of a coordinate face. -/
inductive FaceOrientation where
  | lower
  | upper
  deriving DecidableEq

instance : Fintype FaceOrientation where
  elems := {FaceOrientation.lower, FaceOrientation.upper}
  complete := by
    intro ε
    cases ε <;> simp

/-- The source sign `ε ∈ {-1,1}`. -/
def FaceOrientation.sign : FaceOrientation → ℤ
  | .lower => -1
  | .upper => 1

/-- The orientation viewed from the adjacent incident box. -/
def FaceOrientation.opposite : FaceOrientation → FaceOrientation
  | .lower => .upper
  | .upper => .lower

@[simp]
theorem FaceOrientation.opposite_opposite (ε : FaceOrientation) :
    ε.opposite.opposite = ε := by
  cases ε <;> rfl

@[simp]
theorem FaceOrientation.sign_opposite (ε : FaceOrientation) :
    ε.opposite.sign = -ε.sign := by
  cases ε <;> rfl

theorem FaceOrientation.opposite_ne (ε : FaceOrientation) : ε.opposite ≠ ε := by
  cases ε <;> decide

/-- The coordinate position of an oriented face. -/
noncomputable def boxFaceCoordinate (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) : FaceOrientation → ℝ
  | .lower => (q.index i : ℝ) * boxSide α q i
  | .upper => ((q.index i + 1 : ℤ) : ℝ) * boxSide α q i

/-- The spatial closed face, represented in ambient coordinates. -/
noncomputable def boxFaceSet (α : Anisotropy) (q : AnisoBox α) (i : Fin 3)
    (ε : FaceOrientation) : Set E3 :=
  {p | p i = boxFaceCoordinate α q i ε ∧
    ∀ j : Fin 3, j ≠ i →
      p j ∈ Set.Icc ((q.index j : ℝ) * boxSide α q j)
        (((q.index j + 1 : ℤ) : ℝ) * boxSide α q j)}

/-- The closed coordinate interval used on a face.  The spatial boxes remain
half-open; this closed version is only for the face containment argument in
the boundary packing proof. -/
noncomputable def boxClosedInterval (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) : Set ℝ :=
  Set.Icc ((q.index i : ℝ) * boxSide α q i)
    (((q.index i + 1 : ℤ) : ℝ) * boxSide α q i)

/-- The transverse half-open rectangle used as the integration domain of a
face.  It is embedded in ambient coordinates only to keep its indices literal. -/
noncomputable def boxTransverseSet (α : Anisotropy) (q : AnisoBox α)
    (i : Fin 3) : Set E3 :=
  {p | ∀ j : Fin 3, j ≠ i → p j ∈ boxInterval α q j}

/-- The product of transverse side lengths, i.e. the source coordinate area. -/
noncomputable def boxFaceArea (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) : ℝ :=
  ∏ j ∈ Finset.univ.erase i, boxSide α q j

/-! ### Local anisotropic sizes

These definitions are the literal positive quantities from `def:size`; their
analytic comparison estimates are developed before the tree-form bounds.
-/

/-- The product comparison kernel `Θ_t(p-y)`. -/
noncomputable def anisotropicBracketKernel (α : Anisotropy) (t : ℝ)
    (p y : E3) : ℝ :=
  ∏ i : Fin 3, bracketKernelAt (t ^ α.weight i) (p i) (y i)

/-- Positivity of every factor in the comparison kernel.  The scale is kept
nonnegative here because later tree scales are positive by construction. -/
theorem bracketKernelAt_nonneg {s a x : ℝ} (hs : 0 ≤ s) :
    0 ≤ bracketKernelAt s a x := by
  unfold bracketKernelAt kernelAt kernelDilate
  exact smul_nonneg (inv_nonneg.mpr hs) (bracketKernel_nonneg _)

theorem anisotropicBracketKernel_nonneg (α : Anisotropy) {t : ℝ}
    (ht : 0 ≤ t) (p y : E3) :
    0 ≤ anisotropicBracketKernel α t p y := by
  unfold anisotropicBracketKernel
  apply Finset.prod_nonneg
  intro i _
  exact bracketKernelAt_nonneg (pow_nonneg ht _)

/-- Exact mass of the three-dimensional comparison kernel.  Its value is
less than one, as required in the cube and edge Brascamp--Lieb estimates. -/
theorem integral_anisotropicBracketKernel (α : Anisotropy) {t : ℝ}
    (ht : 0 < t) (p : E3) :
    ∫ y : E3, anisotropicBracketKernel α t p y = (2 / 9 : ℝ) ^ 3 := by
  rw [← (PiLp.volume_preserving_toLp (Fin 3)).integral_comp
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  change (∫ x : Fin 3 → ℝ,
    ∏ i : Fin 3, bracketKernelAt (t ^ α.weight i) (p i) (x i)) = _
  rw [integral_fintype_prod_volume_eq_prod]
  have hfac (i : Fin 3) :
      ∫ x : ℝ, bracketKernelAt (t ^ α.weight i) (p i) x = 2 / 9 :=
    integral_bracketKernelAt (pow_pos ht _) (p i)
  simp_rw [hfac]
  norm_num [Finset.prod_const, Fintype.card_fin]

/-- The center of a literal anisotropic box. -/
noncomputable def boxCenter (α : Anisotropy) (q : AnisoBox α) : E3 :=
  WithLp.toLp 2 fun i ↦ ((q.index i : ℝ) + 1 / 2) * boxSide α q i

@[simp]
theorem boxCenter_apply (α : Anisotropy) (q : AnisoBox α) (i : Fin 3) :
    boxCenter α q i = ((q.index i : ℝ) + 1 / 2) * boxSide α q i := by
  simp [boxCenter]

/-- The indicated center really is an interior point of its half-open grid
box.  This is the coordinate fact needed when the local kernel is compared
on a box closure. -/
theorem boxCenter_mem_boxSet (α : Anisotropy) (q : AnisoBox α) :
    boxCenter α q ∈ boxSet α q := by
  rw [boxSet, Set.mem_preimage, Set.mem_pi]
  intro i _
  rw [boxInterval, boxCenter_apply]
  push_cast
  constructor <;> nlinarith [boxSide_pos α q i]

/-- The weighted local `L^s` average assigned to one box. -/
noncomputable def boxLocalPower (α : Anisotropy) (s : ℝ)
    (f : E3 → ℝ) (q : AnisoBox α) : ℝ :=
  ∫ y : E3, |f y| ^ s *
    anisotropicBracketKernel α (boxLength q) (boxCenter α q) y

/-- The source local size contribution of one box. -/
noncomputable def boxLocalSize (α : Anisotropy) (s : ℝ)
    (f : E3 → ℝ) (q : AnisoBox α) : ℝ :=
  (boxLocalPower α s f q) ^ s⁻¹

/-- The maximum local size over a finite collection; it is zero for the empty
collection exactly as stipulated in the source. -/
noncomputable def collectionLocalSize (α : Anisotropy) (S : BoxCollection α)
    (s : ℝ) (f : E3 → ℝ) : ℝ :=
  if h : S.Nonempty then S.sup' h (boxLocalSize α s f) else 0

noncomputable def treeLocalSize {α : Anisotropy} (T : FiniteConvexTree α)
    (s : ℝ) (f : E3 → ℝ) : ℝ :=
  collectionLocalSize α T.boxes s f

theorem collectionLocalSize_empty (α : Anisotropy) (s : ℝ) (f : E3 → ℝ) :
    collectionLocalSize α ∅ s f = 0 := by
  simp [collectionLocalSize]

theorem collectionLocalSize_eq_sup' {α : Anisotropy} (S : BoxCollection α)
    (hS : S.Nonempty) (s : ℝ) (f : E3 → ℝ) :
    collectionLocalSize α S s f = S.sup' hS (boxLocalSize α s f) := by
  simp [collectionLocalSize, hS]

theorem boxLocalSize_le_collectionLocalSize {α : Anisotropy}
    (S : BoxCollection α) {q : AnisoBox α} (hq : q ∈ S)
    (s : ℝ) (f : E3 → ℝ) :
    boxLocalSize α s f q ≤ collectionLocalSize α S s f := by
  rw [collectionLocalSize_eq_sup' S ⟨q, hq⟩ s f]
  exact Finset.le_sup' (boxLocalSize α s f) hq

/-! ### Cubical coordinates for the local Brascamp--Lieb forms

The source uses two copies of each spatial coordinate.  Keeping this as an
actual six-dimensional Euclidean space, rather than an informal tuple,
makes the product measure and every projection below literal.
-/

/-- The eight vertices of the three-dimensional binary cube. -/
abbrev CubeVertex := Fin 3 → Bool

/-- The six scalar variables `x_i^b` in the source cube integral. -/
abbrev E6 := EuclideanSpace ℝ (Fin 3 × Bool)

/-- The opposite vertex of the binary cube. -/
def cubeComplement (j : CubeVertex) : CubeVertex := fun i ↦ !(j i)

@[simp]
theorem cubeComplement_apply (j : CubeVertex) (i : Fin 3) :
    cubeComplement j i = !(j i) := rfl

@[simp]
theorem cubeComplement_complement (j : CubeVertex) :
    cubeComplement (cubeComplement j) = j := by
  funext i
  simp [cubeComplement]

/-- The vertex projection `Π_j(x)=(x_1^{j_1},x_2^{j_2},x_3^{j_3})`. -/
noncomputable def cubeProjection (j : CubeVertex) (x : E6) : E3 :=
  WithLp.toLp 2 fun i ↦ x (i, j i)

@[simp]
theorem cubeProjection_apply (j : CubeVertex) (x : E6) (i : Fin 3) :
    cubeProjection j x i = x (i, j i) := by
  simp [cubeProjection]

theorem cubeProjection_continuous (j : CubeVertex) :
    Continuous (cubeProjection j) := by
  exact (PiLp.continuous_toLp 2 (fun _ : Fin 3 ↦ ℝ)).comp (by
    rw [continuous_pi_iff]
    intro i
    exact PiLp.continuous_apply (p := 2)
      (β := fun _ : Fin 3 × Bool ↦ ℝ) (i, j i))

/-- The six-fold product of the one-dimensional comparison densities. -/
noncomputable def cubeBracketWeight (α : Anisotropy) (t : ℝ) (p : E3)
    (x : E6) : ℝ :=
  ∏ q : Fin 3 × Bool,
    bracketKernelAt (t ^ α.weight q.1) (p q.1) (x q)

theorem cubeBracketWeight_nonneg (α : Anisotropy) {t : ℝ} (ht : 0 ≤ t)
    (p : E3) (x : E6) : 0 ≤ cubeBracketWeight α t p x := by
  unfold cubeBracketWeight
  apply Finset.prod_nonneg
  intro q _
  exact bracketKernelAt_nonneg (pow_nonneg ht _)

theorem integrable_cubeBracketWeight (α : Anisotropy) {t : ℝ} (ht : 0 < t)
    (p : E3) : Integrable (cubeBracketWeight α t p) := by
  rw [← (PiLp.volume_preserving_toLp (Fin 3 × Bool)).integrable_comp_emb
    (MeasurableEquiv.toLp 2 _).measurableEmbedding]
  change Integrable (fun x : Fin 3 × Bool → ℝ ↦
    ∏ q : Fin 3 × Bool,
      bracketKernelAt (t ^ α.weight q.1) (p q.1) (x q))
  exact Integrable.fintype_prod fun q ↦
    integrable_bracketKernelAt (pow_pos ht _) (p q.1)

/-- The nonnegative product of the eight vertex inputs. -/
noncomputable def cubeInputProduct (F : CubeVertex → E3 → ℝ) (x : E6) : ℝ :=
  ∏ j : CubeVertex, |F j (cubeProjection j x)|

theorem cubeInputProduct_nonneg (F : CubeVertex → E3 → ℝ) (x : E6) :
    0 ≤ cubeInputProduct F x := by
  unfold cubeInputProduct
  exact Finset.prod_nonneg fun _ _ ↦ abs_nonneg _

/-- The coordinate split attached to an arbitrary pair of opposite cube
vertices. -/
def cubeVertexIndexEquiv (j : CubeVertex) : Fin 3 ⊕ Fin 3 ≃ Fin 3 × Bool where
  toFun := fun q ↦ match q with
    | .inl i => (i, j i)
    | .inr i => (i, !(j i))
  invFun := fun q ↦ if q.2 = j q.1 then .inl q.1 else .inr q.1
  left_inv := by
    intro q
    rcases q with i | i <;> cases h : j i <;> simp [h]
  right_inv := by
    rintro ⟨i, b⟩
    cases hb : b <;> cases hj : j i <;> simp_all

noncomputable def cubeVertexSplit (j : CubeVertex) : E6 ≃ᵐ E3 × E3 :=
  ((LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ (cubeVertexIndexEquiv j).symm).trans
    (PiLp.sumPiLpEquivProdLpPiLp 2 (fun _ : Fin 3 ⊕ Fin 3 => ℝ))).toMeasurableEquiv.trans
    (MeasurableEquiv.toLp 2 (E3 × E3)).symm

theorem cubeVertexSplit_measurePreserving (j : CubeVertex) :
    MeasurePreserving (cubeVertexSplit j) := by
  exact (WithLp.volume_preserving_symm_measurableEquiv_toLp_prod
    (U := E3) (V := E3)).comp
    (LinearIsometryEquiv.measurePreserving
      ((LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ (cubeVertexIndexEquiv j).symm).trans
        (PiLp.sumPiLpEquivProdLpPiLp 2 (fun _ : Fin 3 ⊕ Fin 3 => ℝ))))

theorem cubeVertexSplit_apply (j : CubeVertex) (x : E6) :
    cubeVertexSplit j x =
      (cubeProjection j x, cubeProjection (cubeComplement j) x) := by
  ext i <;>
    simp [cubeVertexSplit, cubeProjection, cubeVertexIndexEquiv,
      LinearIsometryEquiv.piLpCongrLeft_apply, PiLp.sumPiLpEquivProdLpPiLp,
      WithLp.ofLp_toLp]

/-- Exact Fubini factorization for every opposite pair of cube vertices. -/
theorem integral_cube_opposite_pair_pow_four
    (α : Anisotropy) (t : ℝ) (p : E3) (j : CubeVertex) (F0 F1 : E3 → ℝ) :
    ∫ x : E6,
        (F0 (cubeProjection j x) *
          F1 (cubeProjection (cubeComplement j) x)) ^ 4 *
          cubeBracketWeight α t p x =
      (∫ y : E3, F0 y ^ 4 * anisotropicBracketKernel α t p y) *
        ∫ z : E3, F1 z ^ 4 * anisotropicBracketKernel α t p z := by
  let A : E3 → ℝ := fun y => F0 y ^ 4 * anisotropicBracketKernel α t p y
  let C : E3 → ℝ := fun z => F1 z ^ 4 * anisotropicBracketKernel α t p z
  let G : E3 × E3 → ℝ := fun yz => A yz.1 * C yz.2
  have hW (x : E6) :
      cubeBracketWeight α t p x =
        anisotropicBracketKernel α t p (cubeProjection j x) *
          anisotropicBracketKernel α t p (cubeProjection (cubeComplement j) x) := by
    simp only [cubeBracketWeight, anisotropicBracketKernel, cubeProjection, cubeComplement]
    rw [Fintype.prod_prod_type]
    have hEach (i : Fin 3) :
        (∏ b : Bool, bracketKernelAt (t ^ α.weight i) (p i) (x (i, b))) =
          bracketKernelAt (t ^ α.weight i) (p i) (x (i, j i)) *
            bracketKernelAt (t ^ α.weight i) (p i) (x (i, !(j i))) := by
      cases h : j i <;> simp [mul_comm]
    simp_rw [hEach]
    rw [Finset.prod_mul_distrib]
  calc
    _ = ∫ x : E6, G (cubeVertexSplit j x) := by
      apply integral_congr_ae
      filter_upwards [] with x
      rw [cubeVertexSplit_apply]
      simp only [G, A, C]
      rw [hW x, mul_pow]
      ring
    _ = ∫ yz : E3 × E3, G yz :=
      (cubeVertexSplit_measurePreserving j).integral_comp' G
    _ = _ := by exact integral_prod_mul A C

/-- One canonical representative from each opposite pair, exactly the
source set `J₀={0}×{0,1}²`. -/
abbrev CubePairRepresentative := {j : CubeVertex // j 0 = false}

def cubeComplementRepresentativeEquiv :
    CubePairRepresentative ≃ {j : CubeVertex // ¬ j 0 = false} where
  toFun := fun j ↦ ⟨cubeComplement j.1, by simp [cubeComplement, j.2]⟩
  invFun := fun j ↦ ⟨cubeComplement j.1, by
    cases h : j.1 0
    · exact False.elim (j.2 h)
    · simp [cubeComplement, h]⟩
  left_inv := by rintro ⟨j, hj⟩; simp [cubeComplement_complement]
  right_inv := by rintro ⟨j, hj⟩; simp [cubeComplement_complement]

/-- Factor a product over the cube into its four complementary vertex pairs. -/
theorem cubeVertexProduct_pair_factorization (H : CubeVertex → ℝ) :
    (∏ j : CubeVertex, H j) =
      ∏ j : CubePairRepresentative, H j.1 * H (cubeComplement j.1) := by
  symm
  rw [Finset.prod_mul_distrib]
  change (∏ j : CubePairRepresentative, H j.1) *
      ∏ j : CubePairRepresentative,
        (fun q : {j : CubeVertex // ¬ j 0 = false} ↦ H q.1)
          (cubeComplementRepresentativeEquiv j) = ∏ j : CubeVertex, H j
  rw [Equiv.prod_comp cubeComplementRepresentativeEquiv
    (fun q : {j : CubeVertex // ¬ j 0 = false} ↦ H q.1)]
  exact Fintype.prod_subtype_mul_prod_subtype
    (fun j : CubeVertex ↦ j 0 = false) H

/-- Literal pairing of the eight vertex factors into the four opposite
pairs used in the first Cauchy--Schwarz step. -/
theorem cubeInputProduct_pair_factorization (F : CubeVertex → E3 → ℝ) (x : E6) :
    cubeInputProduct F x =
      ∏ j : CubePairRepresentative,
        |F j.1 (cubeProjection j.1 x)| *
          |F (cubeComplement j.1) (cubeProjection (cubeComplement j.1) x)| := by
  let H : CubeVertex → ℝ := fun j ↦ |F j (cubeProjection j x)|
  change (∏ j : CubeVertex, H j) = _
  symm
  rw [Finset.prod_mul_distrib]
  change (∏ j : CubePairRepresentative, H j.1) *
      ∏ j : CubePairRepresentative,
        (fun q : {j : CubeVertex // ¬ j 0 = false} ↦ H q.1)
          (cubeComplementRepresentativeEquiv j) = ∏ j : CubeVertex, H j
  rw [Equiv.prod_comp cubeComplementRepresentativeEquiv
    (fun q : {j : CubeVertex // ¬ j 0 = false} ↦ H q.1)]
  exact Fintype.prod_subtype_mul_prod_subtype (fun j : CubeVertex ↦ j 0 = false) H

/-- The local cube average occurring in `def:size` and `lem:bl`. -/
noncomputable def cubeBracketAverage (α : Anisotropy) (t : ℝ) (p : E3)
    (F : CubeVertex → E3 → ℝ) : ℝ :=
  ∫ x : E6, cubeInputProduct F x * cubeBracketWeight α t p x

/-- The source local cube size over the closure of a finite box-scale
region.  The set-theoretic supremum is intentionally literal; finiteness is
proved later from the Brascamp--Lieb bound for bounded inputs. -/
noncomputable def collectionCubeSize (α : Anisotropy) (S : BoxCollection α)
    (F : CubeVertex → E3 → ℝ) : ℝ :=
  sSup {a : ℝ | ∃ z : E3 × ℝ, z ∈ closure (collectionRegion α S) ∧
    a = cubeBracketAverage α z.2 z.1 F}

noncomputable def treeCubeSize {α : Anisotropy} (T : FiniteConvexTree α)
    (F : CubeVertex → E3 → ℝ) : ℝ :=
  collectionCubeSize α T.boxes F

/-- The nonnegative real Cauchy--Schwarz inequality in the exact integral
form used twice in the proof of `lem:bl`.  Isolating it here keeps the later
cube proof about the coordinate factorization rather than `L²` coercions. -/
theorem integral_mul_le_sqrt_integral_sq
    {X : Type*} [MeasurableSpace X] (μ : Measure X) (f g : X → ℝ)
    (hfmeas : AEStronglyMeasurable f μ) (hgmeas : AEStronglyMeasurable g μ)
    (hfnonneg : 0 ≤ᵐ[μ] f) (hgnonneg : 0 ≤ᵐ[μ] g)
    (hfsq : Integrable (fun x ↦ f x ^ 2) μ)
    (hgsq : Integrable (fun x ↦ g x ^ 2) μ) :
    ∫ x, f x * g x ∂μ ≤
      √(∫ x, f x ^ 2 ∂μ) * √(∫ x, g x ^ 2 ∂μ) := by
  have hpq : (2 : ℝ).HolderConjugate 2 := by
    rw [Real.holderConjugate_iff]
    norm_num
  have hf : MemLp f 2 μ := (memLp_two_iff_integrable_sq hfmeas).mpr hfsq
  have hg : MemLp g 2 μ := (memLp_two_iff_integrable_sq hgmeas).mpr hgsq
  simpa [Real.sqrt_eq_rpow] using
    (integral_mul_le_Lp_mul_Lq_of_nonneg hpq hfnonneg hgnonneg
      (by convert hf using 1 ; norm_num)
      (by convert hg using 1 ; norm_num))

/-! ### Measurability of the local comparison measures

The two Cauchy--Schwarz applications in `lem:bl` are most naturally made
with respect to the finite product density occurring in the source.  The
following elementary continuity facts make that density an actual measure,
rather than a formal notation for a weighted integral.
-/

theorem continuous_bracketKernel : Continuous bracketKernel := by
  unfold bracketKernel
  rw [continuous_iff_continuousAt]
  intro x
  apply ContinuousAt.rpow_const
  · fun_prop
  · left
    positivity

theorem continuous_bracketKernelAt {s : ℝ} (_hs : s ≠ 0) (a : ℝ) :
    Continuous (bracketKernelAt s a) := by
  unfold bracketKernelAt kernelAt kernelDilate
  change Continuous fun x : ℝ ↦ s⁻¹ * bracketKernel ((x - a) / s)
  exact continuous_const.mul
    (continuous_bracketKernel.comp
      ((continuous_id.sub continuous_const).div_const s))

theorem continuous_cubeBracketWeight (α : Anisotropy) {t : ℝ}
    (ht : 0 < t) (p : E3) :
    Continuous (cubeBracketWeight α t p) := by
  unfold cubeBracketWeight
  apply continuous_finsetProd Finset.univ
  intro q _
  exact (continuous_bracketKernelAt (pow_ne_zero _ ht.ne') (p q.1)).comp
    (PiLp.continuous_apply (p := 2)
      (β := fun _ : Fin 3 × Bool ↦ ℝ) q)

theorem measurable_cubeBracketWeight (α : Anisotropy) {t : ℝ}
    (ht : 0 < t) (p : E3) :
    Measurable (cubeBracketWeight α t p) :=
  (continuous_cubeBracketWeight α ht p).measurable

/-- The finite six-coordinate measure used in the two source
Cauchy--Schwarz steps. -/
noncomputable def cubeBracketMeasure (α : Anisotropy) (t : ℝ) (p : E3) :
    Measure E6 :=
  volume.withDensity (fun x ↦ ENNReal.ofReal (cubeBracketWeight α t p x))

theorem integral_cubeBracketMeasure_eq (α : Anisotropy) {t : ℝ}
    (ht : 0 < t) (p : E3) (f : E6 → ℝ) :
    ∫ x, f x ∂cubeBracketMeasure α t p =
      ∫ x, cubeBracketWeight α t p x * f x := by
  unfold cubeBracketMeasure
  rw [integral_withDensity_eq_integral_toReal_smul
    (measurable_cubeBracketWeight α ht p).ennreal_ofReal
    (Filter.Eventually.of_forall fun x ↦ ENNReal.ofReal_lt_top)]
  apply integral_congr_ae
  filter_upwards [] with x
  rw [ENNReal.toReal_ofReal (cubeBracketWeight_nonneg α ht.le p x)]
  simp only [smul_eq_mul]

theorem isFiniteMeasure_cubeBracketMeasure (α : Anisotropy) {t : ℝ}
    (ht : 0 < t) (p : E3) : IsFiniteMeasure (cubeBracketMeasure α t p) := by
  unfold cubeBracketMeasure
  exact isFiniteMeasure_withDensity_ofReal
    (integrable_cubeBracketWeight α ht p).hasFiniteIntegral

/-- The two Cauchy--Schwarz steps from the full-cube estimate, isolated in a
four-function form.  Keeping the nested square roots is intentional: it is
the literal output of the two steps and avoids hiding any integrability
assumption in a fourth-root notation. -/
theorem integral_mul_mul_mul_le_two_cs
    {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (a b c d : X → ℝ)
    (ha : AEStronglyMeasurable a μ) (hb : AEStronglyMeasurable b μ)
    (hc : AEStronglyMeasurable c μ) (hd : AEStronglyMeasurable d μ)
    (hanonneg : 0 ≤ᵐ[μ] a) (hbnonneg : 0 ≤ᵐ[μ] b)
    (hcnonneg : 0 ≤ᵐ[μ] c) (hdnonneg : 0 ≤ᵐ[μ] d)
    (ha4 : Integrable (fun x ↦ a x ^ 4) μ)
    (hb4 : Integrable (fun x ↦ b x ^ 4) μ)
    (hc4 : Integrable (fun x ↦ c x ^ 4) μ)
    (hd4 : Integrable (fun x ↦ d x ^ 4) μ)
    (hab2 : Integrable (fun x ↦ (a x * b x) ^ 2) μ)
    (hcd2 : Integrable (fun x ↦ (c x * d x) ^ 2) μ) :
    ∫ x, a x * b x * c x * d x ∂μ ≤
      √(√(∫ x, a x ^ 4 ∂μ) * √(∫ x, b x ^ 4 ∂μ)) *
        √(√(∫ x, c x ^ 4 ∂μ) * √(∫ x, d x ^ 4 ∂μ)) := by
  have hab : ∫ x, (a x * b x) ^ 2 ∂μ ≤
      √(∫ x, a x ^ 4 ∂μ) * √(∫ x, b x ^ 4 ∂μ) := by
    have h := integral_mul_le_sqrt_integral_sq μ (fun x ↦ a x ^ 2)
      (fun x ↦ b x ^ 2) (ha.pow 2) (hb.pow 2)
      (hanonneg.mono fun x hx ↦ sq_nonneg (a x))
      (hbnonneg.mono fun x hx ↦ sq_nonneg (b x))
      (by convert ha4 using 1 ; ext x ; ring)
      (by convert hb4 using 1 ; ext x ; ring)
    convert h using 1 <;> ring
  have hcd : ∫ x, (c x * d x) ^ 2 ∂μ ≤
      √(∫ x, c x ^ 4 ∂μ) * √(∫ x, d x ^ 4 ∂μ) := by
    have h := integral_mul_le_sqrt_integral_sq μ (fun x ↦ c x ^ 2)
      (fun x ↦ d x ^ 2) (hc.pow 2) (hd.pow 2)
      (hcnonneg.mono fun x hx ↦ sq_nonneg (c x))
      (hdnonneg.mono fun x hx ↦ sq_nonneg (d x))
      (by convert hc4 using 1 ; ext x ; ring)
      (by convert hd4 using 1 ; ext x ; ring)
    convert h using 1 <;> ring
  have hfirst := integral_mul_le_sqrt_integral_sq μ
    (fun x ↦ a x * b x) (fun x ↦ c x * d x)
    (ha.mul hb) (hc.mul hd)
    (by
      filter_upwards [hanonneg, hbnonneg] with x hax hbx
      exact mul_nonneg hax hbx)
    (by
      filter_upwards [hcnonneg, hdnonneg] with x hcx hdx
      exact mul_nonneg hcx hdx) hab2 hcd2
  have hsab : √(∫ x, (a x * b x) ^ 2 ∂μ) ≤
      √(√(∫ x, a x ^ 4 ∂μ) * √(∫ x, b x ^ 4 ∂μ)) :=
    Real.sqrt_le_sqrt hab
  have hscd : √(∫ x, (c x * d x) ^ 2 ∂μ) ≤
      √(√(∫ x, c x ^ 4 ∂μ) * √(∫ x, d x ^ 4 ∂μ)) :=
    Real.sqrt_le_sqrt hcd
  calc
    ∫ x, a x * b x * c x * d x ∂μ =
        ∫ x, (a x * b x) * (c x * d x) ∂μ := by
          apply integral_congr_ae
          filter_upwards [] with x
          ring
    _ ≤ √(∫ x, (a x * b x) ^ 2 ∂μ) *
          √(∫ x, (c x * d x) ^ 2 ∂μ) := hfirst
    _ ≤ _ := mul_le_mul hsab hscd (Real.sqrt_nonneg _) (by positivity)

theorem sqrt_sqrt_eq_rpow_one_div_four {x : ℝ} (hx : 0 ≤ x) :
    √(√x) = x ^ ((4 : ℝ)⁻¹) := by
  rw [Real.sqrt_eq_rpow, Real.sqrt_eq_rpow, ← Real.rpow_mul hx]
  norm_num

/-- The nested square roots produced by two Cauchy--Schwarz steps are the
four corresponding fourth roots. -/
theorem sqrt_nested_four_moments (a b c d : ℝ)
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) (hd : 0 ≤ d) :
    √(√(a * b) * √(c * d)) =
      a ^ ((4 : ℝ)⁻¹) * b ^ ((4 : ℝ)⁻¹) *
        c ^ ((4 : ℝ)⁻¹) * d ^ ((4 : ℝ)⁻¹) := by
  rw [Real.sqrt_mul (Real.sqrt_nonneg _)]
  rw [sqrt_sqrt_eq_rpow_one_div_four (mul_nonneg ha hb),
    sqrt_sqrt_eq_rpow_one_div_four (mul_nonneg hc hd)]
  rw [Real.mul_rpow ha hb, Real.mul_rpow hc hd]
  ring

/-- The four representatives `000,001,010,011` of opposite pairs, written
as a genuine equivalence rather than an implicit enumeration. -/
def cubePairVertex (b c : Bool) : CubeVertex := ![false, b, c]

@[simp]
theorem cubePairVertex_zero (b c : Bool) : cubePairVertex b c 0 = false := by
  simp [cubePairVertex]

@[simp]
theorem cubePairVertex_one (b c : Bool) : cubePairVertex b c 1 = b := by
  simp [cubePairVertex]

@[simp]
theorem cubePairVertex_two (b c : Bool) : cubePairVertex b c 2 = c := by
  simp [cubePairVertex]

def cubePairRepresentativeEquiv : Bool × Bool ≃ CubePairRepresentative where
  toFun := fun bc ↦ ⟨cubePairVertex bc.1 bc.2, cubePairVertex_zero _ _⟩
  invFun := fun j ↦ (j.1 1, j.1 2)
  left_inv := by
    rintro ⟨b, c⟩
    simp
  right_inv := by
    rintro ⟨j, hj⟩
    apply Subtype.ext
    funext i
    fin_cases i <;> simp [cubePairVertex, hj]

/-- One of the four opposite-pair factors in the first cube
Cauchy--Schwarz step. -/
noncomputable def cubePairFactor (F : CubeVertex → E3 → ℝ)
    (b c : Bool) (x : E6) : ℝ :=
  |F (cubePairVertex b c) (cubeProjection (cubePairVertex b c) x)| *
    |F (cubeComplement (cubePairVertex b c))
      (cubeProjection (cubeComplement (cubePairVertex b c)) x)|

theorem cubeInputProduct_eq_four_pairFactors (F : CubeVertex → E3 → ℝ)
    (x : E6) :
    cubeInputProduct F x =
      cubePairFactor F false false x * cubePairFactor F false true x *
        cubePairFactor F true false x * cubePairFactor F true true x := by
  calc
    cubeInputProduct F x = ∏ j : CubePairRepresentative,
        |F j.1 (cubeProjection j.1 x)| *
          |F (cubeComplement j.1) (cubeProjection (cubeComplement j.1) x)| :=
      cubeInputProduct_pair_factorization F x
    _ = ∏ bc : Bool × Bool,
        |F (cubePairRepresentativeEquiv bc).1
            (cubeProjection (cubePairRepresentativeEquiv bc).1 x)| *
          |F (cubeComplement (cubePairRepresentativeEquiv bc).1)
            (cubeProjection (cubeComplement (cubePairRepresentativeEquiv bc).1) x)| := by
      symm
      exact Equiv.prod_comp cubePairRepresentativeEquiv
        (fun j : CubePairRepresentative ↦
          |F j.1 (cubeProjection j.1 x)| *
            |F (cubeComplement j.1)
              (cubeProjection (cubeComplement j.1) x)|)
    _ = _ := by
      rw [Fintype.prod_prod_type]
      simp [cubePairFactor, cubePairRepresentativeEquiv]
      ring

/-! ### Exact fourth moments of the four cube pairs -/

theorem cubePairFactor_nonneg (F : CubeVertex → E3 → ℝ)
    (b c : Bool) (x : E6) : 0 ≤ cubePairFactor F b c x := by
  unfold cubePairFactor
  positivity

theorem measurable_cubePairFactor (F : CubeVertex → E3 → ℝ)
    (hF : ∀ j, Measurable (F j)) (b c : Bool) :
    Measurable (cubePairFactor F b c) := by
  unfold cubePairFactor
  apply Measurable.mul
  · exact (continuous_abs.measurable).comp
      ((hF _).comp (cubeProjection_continuous _).measurable)
  · exact (continuous_abs.measurable).comp
      ((hF _).comp (cubeProjection_continuous _).measurable)

theorem integral_cubePairFactor_pow_four
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (F : CubeVertex → E3 → ℝ) (b c : Bool) :
    ∫ x, (cubePairFactor F b c x) ^ 4 ∂cubeBracketMeasure α t p =
      (∫ y : E3, |F (cubePairVertex b c) y| ^ 4 *
        anisotropicBracketKernel α t p y) *
        ∫ z : E3, |F (cubeComplement (cubePairVertex b c)) z| ^ 4 *
          anisotropicBracketKernel α t p z := by
  rw [integral_cubeBracketMeasure_eq α ht p]
  have h := integral_cube_opposite_pair_pow_four α t p (cubePairVertex b c)
    (fun y ↦ |F (cubePairVertex b c) y|)
    (fun z ↦ |F (cubeComplement (cubePairVertex b c)) z|)
  simpa only [cubePairFactor] using (by
    calc
      ∫ x : E6, cubeBracketWeight α t p x *
          (|F (cubePairVertex b c) (cubeProjection (cubePairVertex b c) x)| *
            |F (cubeComplement (cubePairVertex b c))
              (cubeProjection (cubeComplement (cubePairVertex b c)) x)|) ^ 4 =
          ∫ x : E6,
            (|F (cubePairVertex b c) (cubeProjection (cubePairVertex b c) x)| *
              |F (cubeComplement (cubePairVertex b c))
                (cubeProjection (cubeComplement (cubePairVertex b c)) x)|) ^ 4 *
              cubeBracketWeight α t p x := by
                apply integral_congr_ae
                filter_upwards [] with x
                ring
      _ = _ := h)

/-- A bounded measurable nonnegative source input, in the precise form used
by `lem:bl`.  The explicit bound avoids silently replacing the source's
pointwise bounded representatives by equivalence classes. -/
def IsBoundedMeasurableNonneg (f : E3 → ℝ) : Prop :=
  Measurable f ∧ ∃ C : ℝ, 0 ≤ C ∧ ∀ y, 0 ≤ f y ∧ f y ≤ C

theorem integrable_cubePairFactor_pow_of_bounded
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (F : CubeVertex → E3 → ℝ)
    (hFmeas : ∀ j, Measurable (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (b c : Bool) (n : ℕ) :
    Integrable (fun x ↦ cubePairFactor F b c x ^ n)
      (cubeBracketMeasure α t p) := by
  letI : IsFiniteMeasure (cubeBracketMeasure α t p) :=
    isFiniteMeasure_cubeBracketMeasure α ht p
  change Integrable ((cubePairFactor F b c) ^ n) (cubeBracketMeasure α t p)
  rcases hFbound (cubePairVertex b c) with ⟨C₀, hC₀, hbound₀⟩
  rcases hFbound (cubeComplement (cubePairVertex b c)) with ⟨C₁, hC₁, hbound₁⟩
  refine Integrable.of_bound
    ((measurable_cubePairFactor F hFmeas b c).pow_const n).aestronglyMeasurable
    ((C₀ * C₁) ^ n) ?_
  filter_upwards [] with x
  simp only [Pi.pow_apply]
  rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (cubePairFactor_nonneg F b c x) _)]
  apply pow_le_pow_left₀ (cubePairFactor_nonneg F b c x)
  unfold cubePairFactor
  exact mul_le_mul (hbound₀ _) (hbound₁ _) (abs_nonneg _) hC₀

theorem integrable_mul_cubePairFactor_pow_of_bounded
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (F : CubeVertex → E3 → ℝ)
    (hFmeas : ∀ j, Measurable (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (b₀ c₀ b₁ c₁ : Bool) (n : ℕ) :
    Integrable (fun x ↦
      (cubePairFactor F b₀ c₀ x * cubePairFactor F b₁ c₁ x) ^ n)
      (cubeBracketMeasure α t p) := by
  letI : IsFiniteMeasure (cubeBracketMeasure α t p) :=
    isFiniteMeasure_cubeBracketMeasure α ht p
  change Integrable ((cubePairFactor F b₀ c₀ * cubePairFactor F b₁ c₁) ^ n)
    (cubeBracketMeasure α t p)
  rcases hFbound (cubePairVertex b₀ c₀) with ⟨C₀, hC₀, hbound₀⟩
  rcases hFbound (cubeComplement (cubePairVertex b₀ c₀)) with ⟨C₁, hC₁, hbound₁⟩
  rcases hFbound (cubePairVertex b₁ c₁) with ⟨C₂, hC₂, hbound₂⟩
  rcases hFbound (cubeComplement (cubePairVertex b₁ c₁)) with ⟨C₃, hC₃, hbound₃⟩
  refine Integrable.of_bound
    (((measurable_cubePairFactor F hFmeas b₀ c₀).mul
      (measurable_cubePairFactor F hFmeas b₁ c₁)).pow_const n).aestronglyMeasurable
    (((C₀ * C₁) * (C₂ * C₃)) ^ n) ?_
  filter_upwards [] with x
  simp only [Pi.pow_apply, Pi.mul_apply]
  rw [Real.norm_eq_abs,
    abs_of_nonneg (pow_nonneg
      (mul_nonneg (cubePairFactor_nonneg F b₀ c₀ x)
        (cubePairFactor_nonneg F b₁ c₁ x)) _)]
  apply pow_le_pow_left₀
    (mul_nonneg (cubePairFactor_nonneg F b₀ c₀ x)
      (cubePairFactor_nonneg F b₁ c₁ x))
  apply mul_le_mul
  · unfold cubePairFactor
    exact mul_le_mul (hbound₀ _) (hbound₁ _) (abs_nonneg _) hC₀
  · unfold cubePairFactor
    exact mul_le_mul (hbound₂ _) (hbound₃ _) (abs_nonneg _) hC₂
  · exact cubePairFactor_nonneg F b₁ c₁ x
  · exact mul_nonneg hC₀ hC₁

/-- The weighted fourth moment appearing in the right side of the cube
Brascamp--Lieb estimate. -/
noncomputable def cubeFourthMoment (α : Anisotropy) (t : ℝ) (p : E3)
    (F : CubeVertex → E3 → ℝ) (j : CubeVertex) : ℝ :=
  ∫ y : E3, |F j y| ^ 4 * anisotropicBracketKernel α t p y

theorem cubeFourthMoment_nonneg (α : Anisotropy) {t : ℝ} (ht : 0 ≤ t)
    (p : E3) (F : CubeVertex → E3 → ℝ) (j : CubeVertex) :
    0 ≤ cubeFourthMoment α t p F j := by
  unfold cubeFourthMoment
  apply integral_nonneg
  intro y
  exact mul_nonneg (pow_nonneg (abs_nonneg _) _)
    (anisotropicBracketKernel_nonneg α ht p y)

/-- At a literal tree box, a fourth moment is exactly the fourth power
appearing in the source local size. -/
theorem cubeFourthMoment_rpow_eq_boxLocalSize
    (α : Anisotropy) (q : AnisoBox α)
    (F : CubeVertex → E3 → ℝ) (j : CubeVertex) :
    cubeFourthMoment α (boxLength q) (boxCenter α q) F j ^ ((4 : ℝ)⁻¹) =
      boxLocalSize α 4 (F j) q := by
  unfold cubeFourthMoment boxLocalSize boxLocalPower
  congr 1
  apply integral_congr_ae
  filter_upwards [] with y
  norm_num [Real.rpow_natCast]

theorem cubeFourthMoment_rpow_at_box_le_treeLocalSize
    {α : Anisotropy} (T : FiniteConvexTree α) {q : AnisoBox α}
    (hq : q ∈ T.boxes) (F : CubeVertex → E3 → ℝ) (j : CubeVertex) :
    cubeFourthMoment α (boxLength q) (boxCenter α q) F j ^ ((4 : ℝ)⁻¹) ≤
      treeLocalSize T 4 (F j) := by
  rw [cubeFourthMoment_rpow_eq_boxLocalSize]
  change boxLocalSize α 4 (F j) q ≤ collectionLocalSize α T.boxes 4 (F j)
  exact boxLocalSize_le_collectionLocalSize T.boxes hq 4 (F j)

theorem cubeFourthMoment_product_at_box_le_treeLocalSize_product
    {α : Anisotropy} (T : FiniteConvexTree α) {q : AnisoBox α}
    (hq : q ∈ T.boxes) (F : CubeVertex → E3 → ℝ) :
    (∏ j : CubeVertex,
      cubeFourthMoment α (boxLength q) (boxCenter α q) F j ^ ((4 : ℝ)⁻¹)) ≤
      ∏ j : CubeVertex, treeLocalSize T 4 (F j) := by
  apply Finset.prod_le_prod
  · intro j _
    exact Real.rpow_nonneg
      (cubeFourthMoment_nonneg α (boxLength_pos q).le (boxCenter α q) F j) _
  · intro j _
    exact cubeFourthMoment_rpow_at_box_le_treeLocalSize T hq F j

/-- Reassemble the four complementary-pair factors into the usual product
over all eight cube vertices. -/
theorem cubeFourthMoment_nested_roots_eq_product
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (F : CubeVertex → E3 → ℝ) :
    √(√(cubeFourthMoment α t p F (cubePairVertex false false) *
          cubeFourthMoment α t p F
            (cubeComplement (cubePairVertex false false))) *
        √(cubeFourthMoment α t p F (cubePairVertex false true) *
          cubeFourthMoment α t p F
            (cubeComplement (cubePairVertex false true)))) *
      √(√(cubeFourthMoment α t p F (cubePairVertex true false) *
          cubeFourthMoment α t p F
            (cubeComplement (cubePairVertex true false))) *
        √(cubeFourthMoment α t p F (cubePairVertex true true) *
          cubeFourthMoment α t p F
            (cubeComplement (cubePairVertex true true)))) =
      ∏ j : CubeVertex, cubeFourthMoment α t p F j ^ ((4 : ℝ)⁻¹) := by
  rw [sqrt_nested_four_moments _ _ _ _
    (cubeFourthMoment_nonneg α ht.le p F _)
    (cubeFourthMoment_nonneg α ht.le p F _)
    (cubeFourthMoment_nonneg α ht.le p F _)
    (cubeFourthMoment_nonneg α ht.le p F _)]
  rw [sqrt_nested_four_moments _ _ _ _
    (cubeFourthMoment_nonneg α ht.le p F _)
    (cubeFourthMoment_nonneg α ht.le p F _)
    (cubeFourthMoment_nonneg α ht.le p F _)
    (cubeFourthMoment_nonneg α ht.le p F _)]
  rw [cubeVertexProduct_pair_factorization
    (fun j ↦ cubeFourthMoment α t p F j ^ ((4 : ℝ)⁻¹))]
  rw [← Equiv.prod_comp cubePairRepresentativeEquiv
    (fun j : CubePairRepresentative ↦
      cubeFourthMoment α t p F j.1 ^ ((4 : ℝ)⁻¹) *
        cubeFourthMoment α t p F (cubeComplement j.1) ^ ((4 : ℝ)⁻¹))]
  rw [Fintype.prod_prod_type]
  simp [cubePairRepresentativeEquiv]
  ring

/-- The full-cube Brascamp--Lieb estimate in the literal four-pair form
obtained by the two Cauchy--Schwarz steps.  The next algebraic lemma turns
this into the usual product over all eight vertices. -/
theorem cubeBracketAverage_le_two_cs
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (F : CubeVertex → E3 → ℝ)
    (hFmeas : ∀ j, Measurable (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C) :
    cubeBracketAverage α t p F ≤
      √(√(cubeFourthMoment α t p F (cubePairVertex false false) *
          cubeFourthMoment α t p F
            (cubeComplement (cubePairVertex false false))) *
        √(cubeFourthMoment α t p F (cubePairVertex false true) *
          cubeFourthMoment α t p F
            (cubeComplement (cubePairVertex false true)))) *
        √(√(cubeFourthMoment α t p F (cubePairVertex true false) *
          cubeFourthMoment α t p F
            (cubeComplement (cubePairVertex true false))) *
          √(cubeFourthMoment α t p F (cubePairVertex true true) *
            cubeFourthMoment α t p F
              (cubeComplement (cubePairVertex true true))) ) := by
  have hmeasure : cubeBracketAverage α t p F =
      ∫ x, cubeInputProduct F x ∂cubeBracketMeasure α t p := by
    unfold cubeBracketAverage
    rw [integral_cubeBracketMeasure_eq α ht p]
    apply integral_congr_ae
    filter_upwards [] with x
    ring
  calc
    cubeBracketAverage α t p F =
        ∫ x, cubeInputProduct F x ∂cubeBracketMeasure α t p := hmeasure
    _ = ∫ x,
        cubePairFactor F false false x * cubePairFactor F false true x *
          cubePairFactor F true false x * cubePairFactor F true true x
          ∂cubeBracketMeasure α t p := by
      apply integral_congr_ae
      filter_upwards [] with x
      rw [cubeInputProduct_eq_four_pairFactors]
    _ ≤ √(√(∫ x, (cubePairFactor F false false x) ^ 4
          ∂cubeBracketMeasure α t p) *
          √(∫ x, (cubePairFactor F false true x) ^ 4
            ∂cubeBracketMeasure α t p)) *
        √(√(∫ x, (cubePairFactor F true false x) ^ 4
          ∂cubeBracketMeasure α t p) *
          √(∫ x, (cubePairFactor F true true x) ^ 4
            ∂cubeBracketMeasure α t p)) := by
      apply integral_mul_mul_mul_le_two_cs
      · exact (measurable_cubePairFactor F hFmeas false false).aestronglyMeasurable
      · exact (measurable_cubePairFactor F hFmeas false true).aestronglyMeasurable
      · exact (measurable_cubePairFactor F hFmeas true false).aestronglyMeasurable
      · exact (measurable_cubePairFactor F hFmeas true true).aestronglyMeasurable
      · filter_upwards [] with x
        exact cubePairFactor_nonneg F false false x
      · filter_upwards [] with x
        exact cubePairFactor_nonneg F false true x
      · filter_upwards [] with x
        exact cubePairFactor_nonneg F true false x
      · filter_upwards [] with x
        exact cubePairFactor_nonneg F true true x
      · exact integrable_cubePairFactor_pow_of_bounded α ht p F hFmeas hFbound false false 4
      · exact integrable_cubePairFactor_pow_of_bounded α ht p F hFmeas hFbound false true 4
      · exact integrable_cubePairFactor_pow_of_bounded α ht p F hFmeas hFbound true false 4
      · exact integrable_cubePairFactor_pow_of_bounded α ht p F hFmeas hFbound true true 4
      · exact integrable_mul_cubePairFactor_pow_of_bounded α ht p F hFmeas hFbound
          false false false true 2
      · exact integrable_mul_cubePairFactor_pow_of_bounded α ht p F hFmeas hFbound
          true false true true 2
    _ = _ := by
      simp only [cubeFourthMoment]
      rw [integral_cubePairFactor_pow_four α ht p F false false,
        integral_cubePairFactor_pow_four α ht p F false true,
        integral_cubePairFactor_pow_four α ht p F true false,
        integral_cubePairFactor_pow_four α ht p F true true]

/-- The full-cube Brascamp--Lieb inequality in the source's product-over-
vertices form. -/
theorem cubeBracketAverage_le_fourth_moments
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (F : CubeVertex → E3 → ℝ)
    (hFmeas : ∀ j, Measurable (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C) :
    cubeBracketAverage α t p F ≤
      ∏ j : CubeVertex, cubeFourthMoment α t p F j ^ ((4 : ℝ)⁻¹) := by
  calc
    cubeBracketAverage α t p F ≤
        √(√(cubeFourthMoment α t p F (cubePairVertex false false) *
            cubeFourthMoment α t p F
              (cubeComplement (cubePairVertex false false))) *
          √(cubeFourthMoment α t p F (cubePairVertex false true) *
            cubeFourthMoment α t p F
              (cubeComplement (cubePairVertex false true)))) *
          √(√(cubeFourthMoment α t p F (cubePairVertex true false) *
            cubeFourthMoment α t p F
              (cubeComplement (cubePairVertex true false))) *
            √(cubeFourthMoment α t p F (cubePairVertex true true) *
              cubeFourthMoment α t p F
                (cubeComplement (cubePairVertex true true)))) :=
      cubeBracketAverage_le_two_cs α ht p F hFmeas hFbound
    _ = _ := cubeFourthMoment_nested_roots_eq_product α ht p F

theorem cubeBracketAverage_at_box_le_treeLocalSize_product
    {α : Anisotropy} (T : FiniteConvexTree α) {q : AnisoBox α}
    (hq : q ∈ T.boxes) (F : CubeVertex → E3 → ℝ)
    (hFmeas : ∀ j, Measurable (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C) :
    cubeBracketAverage α (boxLength q) (boxCenter α q) F ≤
      ∏ j : CubeVertex, treeLocalSize T 4 (F j) := by
  exact (cubeBracketAverage_le_fourth_moments α (boxLength_pos q)
    (boxCenter α q) F hFmeas hFbound).trans
      (cubeFourthMoment_product_at_box_le_treeLocalSize_product T hq F)

/-- One vertex factor for the edge Brascamp--Lieb form. -/
noncomputable def cubeVertexFactor (F : E3 → ℝ) (j : CubeVertex) (x : E6) : ℝ :=
  F (cubeProjection j x)

/-- The weighted second moment appearing in the edge estimate. -/
noncomputable def cubeSecondMoment (α : Anisotropy) (t : ℝ) (p : E3)
    (F : E3 → ℝ) : ℝ :=
  ∫ y : E3, F y ^ 2 * anisotropicBracketKernel α t p y

/-- The literal six-variable edge average with the two active vertices
`000` and `001`. -/
noncomputable def cubeEdgeBracketAverage (α : Anisotropy) (t : ℝ) (p : E3)
    (F0 F1 : E3 → ℝ) : ℝ :=
  ∫ x : E6,
    F0 (cubeProjection (cubePairVertex false false) x) *
      F1 (cubeProjection (cubePairVertex false true) x) *
        cubeBracketWeight α t p x

theorem measurable_cubeVertexFactor (F : E3 → ℝ) (hF : Measurable F)
    (j : CubeVertex) : Measurable (cubeVertexFactor F j) := by
  unfold cubeVertexFactor
  exact hF.comp (cubeProjection_continuous j).measurable

theorem cubeVertexFactor_nonneg (F : E3 → ℝ) (hF : ∀ y, 0 ≤ F y)
    (j : CubeVertex) (x : E6) : 0 ≤ cubeVertexFactor F j x := by
  unfold cubeVertexFactor
  exact hF _

theorem integrable_cubeVertexFactor_pow_of_bounded
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (F : E3 → ℝ) (hFmeas : Measurable F)
    (hFnonneg : ∀ y, 0 ≤ F y)
    (hFbound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, F y ≤ C)
    (j : CubeVertex) (n : ℕ) :
    Integrable (fun x ↦ cubeVertexFactor F j x ^ n)
      (cubeBracketMeasure α t p) := by
  letI : IsFiniteMeasure (cubeBracketMeasure α t p) :=
    isFiniteMeasure_cubeBracketMeasure α ht p
  change Integrable ((cubeVertexFactor F j) ^ n) (cubeBracketMeasure α t p)
  rcases hFbound with ⟨C, hC, hbound⟩
  refine Integrable.of_bound
    ((measurable_cubeVertexFactor F hFmeas j).pow_const n).aestronglyMeasurable
    (C ^ n) ?_
  filter_upwards [] with x
  simp only [Pi.pow_apply]
  rw [Real.norm_eq_abs,
    abs_of_nonneg (pow_nonneg (cubeVertexFactor_nonneg F hFnonneg j x) _)]
  apply pow_le_pow_left₀ (cubeVertexFactor_nonneg F hFnonneg j x)
  unfold cubeVertexFactor
  exact hbound _

theorem cubeSecondMoment_nonneg (α : Anisotropy) {t : ℝ} (ht : 0 ≤ t)
    (p : E3) (F : E3 → ℝ) :
    0 ≤ cubeSecondMoment α t p F := by
  unfold cubeSecondMoment
  apply integral_nonneg
  intro y
  exact mul_nonneg (sq_nonneg _) (anisotropicBracketKernel_nonneg α ht p y)

theorem integral_cubeVertexFactor_pow_two
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (F : E3 → ℝ) (j : CubeVertex) :
    ∫ x, cubeVertexFactor F j x ^ 2 ∂cubeBracketMeasure α t p =
      cubeSecondMoment α t p F * (2 / 9 : ℝ) ^ 3 := by
  rw [integral_cubeBracketMeasure_eq α ht p]
  let A : E3 → ℝ := fun y ↦ F y ^ 2 * anisotropicBracketKernel α t p y
  let C : E3 → ℝ := fun z ↦ anisotropicBracketKernel α t p z
  let G : E3 × E3 → ℝ := fun yz ↦ A yz.1 * C yz.2
  have hW (x : E6) :
      cubeBracketWeight α t p x =
        anisotropicBracketKernel α t p (cubeProjection j x) *
          anisotropicBracketKernel α t p (cubeProjection (cubeComplement j) x) := by
    simp only [cubeBracketWeight, anisotropicBracketKernel, cubeProjection, cubeComplement]
    rw [Fintype.prod_prod_type]
    have hEach (i : Fin 3) :
        (∏ b : Bool, bracketKernelAt (t ^ α.weight i) (p i) (x (i, b))) =
          bracketKernelAt (t ^ α.weight i) (p i) (x (i, j i)) *
            bracketKernelAt (t ^ α.weight i) (p i) (x (i, !(j i))) := by
      cases h : j i <;> simp [mul_comm]
    simp_rw [hEach]
    rw [Finset.prod_mul_distrib]
  calc
    _ = ∫ x : E6, G (cubeVertexSplit j x) := by
      apply integral_congr_ae
      filter_upwards [] with x
      rw [cubeVertexSplit_apply]
      simp only [G, A, C, cubeVertexFactor]
      rw [hW x]
      ring
    _ = ∫ yz : E3 × E3, G yz :=
      (cubeVertexSplit_measurePreserving j).integral_comp' G
    _ = (∫ y : E3, A y) * ∫ z : E3, C z := by
      change (∫ yz : E3 × E3, A yz.1 * C yz.2) = _
      exact integral_prod_mul A C
    _ = _ := by
      simp only [A, C, cubeSecondMoment]
      rw [integral_anisotropicBracketKernel α ht p]

/-- The edge Brascamp--Lieb inequality from `lem:bl`, retaining the literal
six-dimensional comparison measure and its unused-coordinate mass. -/
theorem cubeEdgeBracketAverage_le_product_secondMoments
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (F0 F1 : E3 → ℝ)
    (hF0meas : Measurable F0) (hF1meas : Measurable F1)
    (hF0nonneg : ∀ y, 0 ≤ F0 y) (hF1nonneg : ∀ y, 0 ≤ F1 y)
    (hF0bound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, F0 y ≤ C)
    (hF1bound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, F1 y ≤ C) :
    cubeEdgeBracketAverage α t p F0 F1 ≤
      √(cubeSecondMoment α t p F0) * √(cubeSecondMoment α t p F1) := by
  let j0 : CubeVertex := cubePairVertex false false
  let j1 : CubeVertex := cubePairVertex false true
  have hmeasure : cubeEdgeBracketAverage α t p F0 F1 =
      ∫ x, cubeVertexFactor F0 j0 x * cubeVertexFactor F1 j1 x
        ∂cubeBracketMeasure α t p := by
    unfold cubeEdgeBracketAverage cubeVertexFactor
    rw [integral_cubeBracketMeasure_eq α ht p]
    apply integral_congr_ae
    filter_upwards [] with x
    ring
  have hcs := integral_mul_le_sqrt_integral_sq (cubeBracketMeasure α t p)
    (cubeVertexFactor F0 j0) (cubeVertexFactor F1 j1)
    (measurable_cubeVertexFactor F0 hF0meas j0).aestronglyMeasurable
    (measurable_cubeVertexFactor F1 hF1meas j1).aestronglyMeasurable
    (by
      filter_upwards [] with x
      exact cubeVertexFactor_nonneg F0 hF0nonneg j0 x)
    (by
      filter_upwards [] with x
      exact cubeVertexFactor_nonneg F1 hF1nonneg j1 x)
    (integrable_cubeVertexFactor_pow_of_bounded α ht p F0 hF0meas hF0nonneg
      hF0bound j0 2)
    (integrable_cubeVertexFactor_pow_of_bounded α ht p F1 hF1meas hF1nonneg
      hF1bound j1 2)
  have hM0 : 0 ≤ cubeSecondMoment α t p F0 :=
    cubeSecondMoment_nonneg α ht.le p F0
  have hM1 : 0 ≤ cubeSecondMoment α t p F1 :=
    cubeSecondMoment_nonneg α ht.le p F1
  have hmass : (2 / 9 : ℝ) ^ 3 ≤ 1 := by norm_num
  have hs0 : √(cubeSecondMoment α t p F0 * (2 / 9 : ℝ) ^ 3) ≤
      √(cubeSecondMoment α t p F0) :=
    Real.sqrt_le_sqrt (mul_le_of_le_one_right hM0 hmass)
  have hs1 : √(cubeSecondMoment α t p F1 * (2 / 9 : ℝ) ^ 3) ≤
      √(cubeSecondMoment α t p F1) :=
    Real.sqrt_le_sqrt (mul_le_of_le_one_right hM1 hmass)
  calc
    cubeEdgeBracketAverage α t p F0 F1 =
        ∫ x, cubeVertexFactor F0 j0 x * cubeVertexFactor F1 j1 x
          ∂cubeBracketMeasure α t p := hmeasure
    _ ≤ √(∫ x, cubeVertexFactor F0 j0 x ^ 2 ∂cubeBracketMeasure α t p) *
        √(∫ x, cubeVertexFactor F1 j1 x ^ 2 ∂cubeBracketMeasure α t p) := hcs
    _ = √(cubeSecondMoment α t p F0 * (2 / 9 : ℝ) ^ 3) *
        √(cubeSecondMoment α t p F1 * (2 / 9 : ℝ) ^ 3) := by
      rw [integral_cubeVertexFactor_pow_two α ht p F0 j0,
        integral_cubeVertexFactor_pow_two α ht p F1 j1]
    _ ≤ _ := mul_le_mul hs0 hs1 (Real.sqrt_nonneg _) (by positivity)

/-- The signed product of the eight cube inputs. -/
def cubeSignedInputProduct (F : CubeVertex → E3 → ℝ) (x : E6) : ℝ :=
  ∏ j : CubeVertex, F j (cubeProjection j x)

/-! ### Compact local-integrability package

The source local-integrability lemma first fixes a positive scale and the six
spatial variables.  Literal boxes and transverse rectangles are half-open, so
we place each in its compact coordinatewise closure and apply continuity there.
-/

/-- Compact coordinatewise closure used to establish integrability on a
literal half-open source box. -/
noncomputable def boxClosedSet (α : Anisotropy) (q : AnisoBox α) : Set E3 :=
  (WithLp.toLp 2) '' Set.pi Set.univ (fun i ↦
    Set.Icc ((q.index i : ℝ) * boxSide α q i)
      (((q.index i + 1 : ℤ) : ℝ) * boxSide α q i))

theorem isCompact_boxClosedSet (α : Anisotropy) (q : AnisoBox α) :
    IsCompact (boxClosedSet α q) := by
  unfold boxClosedSet
  let K : Set (Fin 3 → ℝ) := Set.pi Set.univ (fun i ↦
    Set.Icc ((q.index i : ℝ) * boxSide α q i)
      (((q.index i + 1 : ℤ) : ℝ) * boxSide α q i))
  change IsCompact ((WithLp.toLp 2) '' K)
  have hK : IsCompact K := by
    dsimp only [K]
    exact isCompact_univ_pi fun _ ↦ isCompact_Icc
  exact hK.image (PiLp.continuous_toLp 2 _)

theorem boxSet_subset_boxClosedSet (α : Anisotropy) (q : AnisoBox α) :
    boxSet α q ⊆ boxClosedSet α q := by
  intro p hp
  refine ⟨WithLp.ofLp p, ?_, ?_⟩
  · rw [Set.mem_pi]
    intro i _
    rw [boxSet, Set.mem_preimage, Set.mem_pi] at hp
    exact Set.Ico_subset_Icc_self (hp i (Set.mem_univ i))
  · simp

/-- A uniform bound for the eightfold input product. -/
theorem exists_bound_cubeSignedInputProduct
    (F : CubeVertex → E3 → ℝ)
    (hF : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ x, |cubeSignedInputProduct F x| ≤ B := by
  classical
  choose B hB using hF
  refine ⟨∏ j : CubeVertex, B j, Finset.prod_nonneg (fun j _ ↦ (hB j).1), ?_⟩
  intro x
  rw [cubeSignedInputProduct, Finset.abs_prod]
  exact Finset.prod_le_prod (fun j _ ↦ abs_nonneg _) (fun j _ ↦ (hB j).2 _)

/-! ### Spatial bracket-average bounds -/

/-- The unsigned cube input product is exactly the absolute value of the
signed product used in the local forms. -/
theorem abs_cubeSignedInputProduct_eq_cubeInputProduct
    (F : CubeVertex → E3 → ℝ) (x : E6) :
    |cubeSignedInputProduct F x| = cubeInputProduct F x := by
  rw [cubeSignedInputProduct, cubeInputProduct, Finset.abs_prod]

/-- The positive bracket average has an integrable spatial integrand for
bounded continuous cube data. -/
theorem integrable_cubeInputProduct_mul_cubeBracketWeight
    (α : Anisotropy) (t : ℝ) (p : E3) (F : CubeVertex → E3 → ℝ)
    (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ C : ℝ, 0 ≤ C ∧ ∀ y, |F j y| ≤ C)
    (ht : 0 < t) :
    Integrable (fun x : E6 ↦
      cubeInputProduct F x * cubeBracketWeight α t p x) := by
  rcases exists_bound_cubeSignedInputProduct F hFbound with ⟨B, hB, hinput⟩
  have hmajor : Integrable (fun x : E6 ↦
      B * cubeBracketWeight α t p x) := by
    simpa only [smul_eq_mul] using
      (integrable_cubeBracketWeight α ht p).const_mul B
  have hcontInput : Continuous (cubeInputProduct F) := by
    unfold cubeInputProduct
    apply continuous_finsetProd Finset.univ
    intro j _
    exact ((hFcont j).comp (cubeProjection_continuous j)).abs
  have hmeas : AEStronglyMeasurable (fun x : E6 ↦
      cubeInputProduct F x * cubeBracketWeight α t p x) volume :=
    (hcontInput.mul (continuous_cubeBracketWeight α ht p)).aestronglyMeasurable
  refine hmajor.mono hmeas (Filter.Eventually.of_forall ?_)
  intro x
  have hinput' : cubeInputProduct F x ≤ B := by
    rw [← abs_cubeSignedInputProduct_eq_cubeInputProduct]
    exact hinput x
  have hweight : 0 ≤ cubeBracketWeight α t p x :=
    cubeBracketWeight_nonneg α ht.le p x
  have hleft : 0 ≤ cubeInputProduct F x * cubeBracketWeight α t p x :=
    mul_nonneg (cubeInputProduct_nonneg F x) hweight
  have hright : 0 ≤ B * cubeBracketWeight α t p x :=
    mul_nonneg hB hweight
  simpa only [Real.norm_eq_abs, abs_of_nonneg hleft, abs_of_nonneg hright] using
    (mul_le_mul_of_nonneg_right hinput' hweight)

theorem abs_sub_boxCenter_le_half_side
    (α : Anisotropy) (q : AnisoBox α) {p : E3}
    (hp : p ∈ boxClosedSet α q) (i : Fin 3) :
    |p i - boxCenter α q i| ≤ boxSide α q i / 2 := by
  rcases hp with ⟨u, hu, hEq⟩
  have hui : u i ∈ Set.Icc ((q.index i : ℝ) * boxSide α q i)
      (((q.index i + 1 : ℤ) : ℝ) * boxSide α q i) := by
    exact (Set.mem_pi.mp hu) i (Set.mem_univ i)
  rw [← hEq, boxCenter_apply]
  change |u i - (((q.index i : ℝ) + 1 / 2) * boxSide α q i)| ≤
    boxSide α q i / 2
  push_cast at hui
  have hlo := hui.1
  have hhi := hui.2
  rw [abs_le]
  constructor <;> nlinarith [boxSide_pos α q i]

/-- The closure of one literal box-scale cell imposes the source's center
and scale comparisons with its underlying box. -/
theorem mem_closure_boxScaleRegion_bounds
    (α : Anisotropy) (q : AnisoBox α) {p : E3} {t : ℝ}
    (hpt : (p, t) ∈ closure (boxScaleRegion α q)) :
    p ∈ boxClosedSet α q ∧
      boxLength q / 2 ≤ t ∧ t ≤ boxLength q := by
  rw [boxScaleRegion, closure_prod_eq] at hpt
  rcases hpt with ⟨hp, ht⟩
  have hne : boxLength q / 2 ≠ boxLength q := by
    nlinarith [boxLength_pos q]
  rw [boxScaleBand, closure_Ioc hne] at ht
  refine ⟨?_, ?_, ?_⟩
  · exact closure_minimal (boxSet_subset_boxClosedSet α q)
      (isCompact_boxClosedSet α q).isClosed hp
  · exact ht.1
  · exact ht.2

/-- A point in the closure of a finite source region belongs to the closure
of one of its literal box-scale cells. -/
theorem mem_closure_collectionRegion_exists_bounds
    (α : Anisotropy) (S : BoxCollection α) {p : E3} {t : ℝ}
    (hpt : (p, t) ∈ closure (collectionRegion α S)) :
    ∃ q ∈ S, p ∈ boxClosedSet α q ∧
      boxLength q / 2 ≤ t ∧ t ≤ boxLength q := by
  rw [collectionRegion, Finset.closure_biUnion] at hpt
  rcases Set.mem_iUnion₂.mp hpt with ⟨q, hq, hqpt⟩
  exact ⟨q, hq, mem_closure_boxScaleRegion_bounds α q hqpt⟩

/-- Raising a scale in `[L/2,L]` to an integral anisotropic weight gives the
precise factor `2^n` used in the one-coordinate bracket comparison. -/
theorem pow_scale_bounds {L t : ℝ} (hL : 0 < L) (ht : 0 < t)
    (hlower : L / 2 ≤ t) (hupper : t ≤ L) (n : ℕ) :
    L ^ n ≤ (2 : ℝ) ^ n * t ^ n ∧ t ^ n ≤ L ^ n := by
  have hdouble : L ≤ 2 * t := by linarith
  constructor
  · calc
      L ^ n ≤ (2 * t) ^ n := pow_le_pow_left₀ hL.le hdouble n
      _ = (2 : ℝ) ^ n * t ^ n := by rw [mul_pow]
  · exact pow_le_pow_left₀ ht.le hupper n

/-- The product of the six elementary scale-and-center comparison constants.
It depends only on the fixed anisotropy. -/
noncomputable def boxScaleComparisonConstant (α : Anisotropy) : ℝ :=
  ∏ u : Fin 3 × Bool,
    (2 : ℝ) ^ α.weight u.1 * (3 / 2 : ℝ) ^ 10

theorem boxScaleComparisonConstant_nonneg (α : Anisotropy) :
    0 ≤ boxScaleComparisonConstant α := by
  unfold boxScaleComparisonConstant
  apply Finset.prod_nonneg
  intro u _
  positivity

/-- On the closure of one box-scale cell, the sixfold comparison weight is
controlled by the box-center comparison weight with an anisotropy-only
constant. -/
theorem cubeBracketWeight_le_boxCenterWeight
    (α : Anisotropy) (q : AnisoBox α) {p : E3} {t : ℝ}
    (hp : p ∈ boxClosedSet α q)
    (ht : 0 < t) (hlower : boxLength q / 2 ≤ t)
    (hupper : t ≤ boxLength q) (x : E6) :
    cubeBracketWeight α t p x ≤
      boxScaleComparisonConstant α *
        cubeBracketWeight α (boxLength q) (boxCenter α q) x := by
  have hfactor (u : Fin 3 × Bool) :
      bracketKernelAt (t ^ α.weight u.1) (p u.1) (x u) ≤
        ((2 : ℝ) ^ α.weight u.1 * (3 / 2 : ℝ) ^ 10) *
          bracketKernelAt (boxLength q ^ α.weight u.1)
            (boxCenter α q u.1) (x u) := by
    have hpow := pow_scale_bounds (boxLength_pos q) ht hlower hupper
      (α.weight u.1)
    have hcenter : |p u.1 - boxCenter α q u.1| ≤
        boxLength q ^ α.weight u.1 / 2 := by
      simpa only [boxSide_eq_length_pow] using
        abs_sub_boxCenter_le_half_side α q hp u.1
    exact bracketKernelAt_le_of_scale_center
      (pow_pos ht _) (pow_pos (boxLength_pos q) _)
      hpow.1 hpow.2 hcenter
  unfold cubeBracketWeight boxScaleComparisonConstant
  calc
    (∏ u : Fin 3 × Bool,
        bracketKernelAt (t ^ α.weight u.1) (p u.1) (x u)) ≤
        ∏ u : Fin 3 × Bool,
          ((2 : ℝ) ^ α.weight u.1 * (3 / 2 : ℝ) ^ 10) *
            bracketKernelAt (boxLength q ^ α.weight u.1)
              (boxCenter α q u.1) (x u) := by
      apply Finset.prod_le_prod
      · intro u hu
        exact bracketKernelAt_nonneg (pow_pos ht _).le
      · intro u hu
        exact hfactor u
    _ = (∏ u : Fin 3 × Bool,
          (2 : ℝ) ^ α.weight u.1 * (3 / 2 : ℝ) ^ 10) *
        ∏ u : Fin 3 × Bool,
          bracketKernelAt (boxLength q ^ α.weight u.1)
            (boxCenter α q u.1) (x u) := by
      rw [Finset.prod_mul_distrib]

/-- The source cube bracket average at any center-scale point in one closed
cell is controlled by the average at that box's designated center and scale. -/
theorem cubeBracketAverage_le_boxCenterAverage
    (α : Anisotropy) (q : AnisoBox α) {p : E3} {t : ℝ}
    (F : CubeVertex → E3 → ℝ)
    (hFcont : ∀ j, Continuous (F j))
    (hFbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B)
    (hp : p ∈ boxClosedSet α q)
    (ht : 0 < t) (hlower : boxLength q / 2 ≤ t)
    (hupper : t ≤ boxLength q) :
    cubeBracketAverage α t p F ≤
      boxScaleComparisonConstant α *
        cubeBracketAverage α (boxLength q) (boxCenter α q) F := by
  let C : ℝ := boxScaleComparisonConstant α
  let f : E6 → ℝ := fun x ↦
    cubeInputProduct F x * cubeBracketWeight α t p x
  let g : E6 → ℝ := fun x ↦
    C * (cubeInputProduct F x *
      cubeBracketWeight α (boxLength q) (boxCenter α q) x)
  have hf : Integrable f :=
    integrable_cubeInputProduct_mul_cubeBracketWeight
      α t p F hFcont hFbound ht
  have hbase : Integrable (fun x : E6 ↦
      cubeInputProduct F x *
        cubeBracketWeight α (boxLength q) (boxCenter α q) x) :=
    integrable_cubeInputProduct_mul_cubeBracketWeight
      α (boxLength q) (boxCenter α q) F hFcont hFbound (boxLength_pos q)
  have hg : Integrable g := by
    simpa only [g, smul_eq_mul] using hbase.const_mul C
  have hpointwise (x : E6) : f x ≤ g x := by
    have hweight := cubeBracketWeight_le_boxCenterWeight α q hp ht
      hlower hupper x
    have hinput : 0 ≤ cubeInputProduct F x := cubeInputProduct_nonneg F x
    change cubeInputProduct F x * cubeBracketWeight α t p x ≤
      C * (cubeInputProduct F x *
        cubeBracketWeight α (boxLength q) (boxCenter α q) x)
    calc
      cubeInputProduct F x * cubeBracketWeight α t p x ≤
          cubeInputProduct F x *
            (C * cubeBracketWeight α (boxLength q) (boxCenter α q) x) :=
        mul_le_mul_of_nonneg_left hweight hinput
      _ = C * (cubeInputProduct F x *
        cubeBracketWeight α (boxLength q) (boxCenter α q) x) := by ring
  calc
    cubeBracketAverage α t p F = ∫ x : E6, f x := by rfl
    _ ≤ ∫ x : E6, g x :=
      MeasureTheory.integral_mono_ae hf hg (Filter.Eventually.of_forall hpointwise)
    _ = C * cubeBracketAverage α (boxLength q) (boxCenter α q) F := by
      rw [show g = fun x : E6 ↦ C *
        (cubeInputProduct F x *
          cubeBracketWeight α (boxLength q) (boxCenter α q) x) by rfl,
        cubeBracketAverage, MeasureTheory.integral_const_mul]
    _ = _ := rfl

/-- The local Brascamp--Lieb average on the closure of a finite tree region
is bounded by an anisotropy-only constant times the product of the tree's
eight fourth local sizes.  This is the source `lem:size`/`lem:bl` bridge used
in the remainder estimate. -/
theorem cubeBracketAverage_le_treeLocalSize_product_of_mem_closure
    {α : Anisotropy} (T : FiniteConvexTree α) (F : CubeVertex → E3 → ℝ)
    (hFcont : ∀ j, Continuous (F j))
    (hFmeas : ∀ j, Measurable (F j))
    (hFbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B)
    {p : E3} {t : ℝ} (hpt : (p, t) ∈ closure (collectionRegion α T.boxes)) :
    cubeBracketAverage α t p F ≤
      boxScaleComparisonConstant α *
        ∏ j : CubeVertex, treeLocalSize T 4 (F j) := by
  rcases mem_closure_collectionRegion_exists_bounds α T.boxes hpt with
    ⟨q, hq, hp, hlower, hupper⟩
  have ht : 0 < t := by
    have hhalf : 0 < boxLength q / 2 :=
      div_pos (boxLength_pos q) (by norm_num)
    exact lt_of_lt_of_le hhalf hlower
  have hcell := cubeBracketAverage_le_boxCenterAverage
    α q F hFcont hFbound hp ht hlower hupper
  have hsize := cubeBracketAverage_at_box_le_treeLocalSize_product
    T hq F hFmeas hFbound
  exact hcell.trans
    (mul_le_mul_of_nonneg_left hsize
      (boxScaleComparisonConstant_nonneg α))

local instance : Fact (0 < (8 : ℝ)) := ⟨by norm_num⟩


/-- **`lem:geometry`** (Dyadic facts and boundary packing).

Intersecting boxes are nested.  A box has `2^A` children, which partition it,
and the leaves of a finite convex tree partition its root.

This is the count of children. -/
theorem lem_geometry_card_boxChildren (α : Anisotropy) (q : AnisoBox α) :
    (boxChildren α q).card = 2 ^ α.homogeneousDimension :=
  card_boxChildren α q

/-- **`lem:geometry`** (Dyadic facts and boundary packing).

The leaves of a finite convex tree partition its root; all these sets are
measurable.

This is the resulting additivity of the measure. -/
theorem lem_geometry_volume_root_eq_sum_volume_leaves
    {α : Anisotropy} (T : FiniteConvexTree α) :
    volume (boxSet α T.root) = ∑ l ∈ treeLeaves T, volume (boxSet α l) :=
  volume_root_eq_sum_volume_leaves T

/-- **`lem:size`** (Size comparison and zero size).

There is `C_{α,s}` such that
`M_{T,s}(f) ≤ sup_{(p,t) ∈ closure Ω_T} (|f|^s * Θ_t(p))^{1/s}
   ≤ C_{α,s} M_{T,s}(f)`.

This is the comparison at a point of the closure, in the product form the
cubical estimates use. -/
theorem lem_size_cubeBracketAverage_le
    {α : Anisotropy} (T : FiniteConvexTree α) (F : CubeVertex → E3 → ℝ)
    (hFcont : ∀ j, Continuous (F j))
    (hFmeas : ∀ j, Measurable (F j))
    (hFbound : ∀ j, ∃ B : ℝ, 0 ≤ B ∧ ∀ y, |F j y| ≤ B)
    {p : E3} {t : ℝ} (hpt : (p, t) ∈ closure (collectionRegion α T.boxes)) :
    cubeBracketAverage α t p F ≤
      boxScaleComparisonConstant α *
        ∏ j : CubeVertex, treeLocalSize T 4 (F j) :=
  cubeBracketAverage_le_treeLocalSize_product_of_mem_closure T F hFcont hFmeas
    hFbound hpt

/-- **`lem:bl`** (Full-cube and edge Brascamp--Lieb inequalities),
equation `eq:bl2`.

If only `F_{000} = F_0` and `F_{001} = F_1` differ from `1`, the left side is
at most `(F_0^2 * Θ_t(p))^{1/2} (F_1^2 * Θ_t(p))^{1/2}`. -/
theorem lem_bl_cubeEdgeBracketAverage_le
    (α : Anisotropy) {t : ℝ} (ht : 0 < t) (p : E3)
    (F0 F1 : E3 → ℝ)
    (hF0meas : Measurable F0) (hF1meas : Measurable F1)
    (hF0nonneg : ∀ y, 0 ≤ F0 y) (hF1nonneg : ∀ y, 0 ≤ F1 y)
    (hF0bound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, F0 y ≤ C)
    (hF1bound : ∃ C : ℝ, 0 ≤ C ∧ ∀ y, F1 y ≤ C) :
    cubeEdgeBracketAverage α t p F0 F1 ≤
      √(cubeSecondMoment α t p F0) * √(cubeSecondMoment α t p F1) :=
  cubeEdgeBracketAverage_le_product_secondMoments α ht p F0 F1 hF0meas hF1meas
    hF0nonneg hF1nonneg hF0bound hF1bound

