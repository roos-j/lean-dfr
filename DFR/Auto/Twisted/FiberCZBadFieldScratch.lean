  unfold scratch_coordinateFiberBadField
  apply scratch_fiberCZBadField_eq_zero_of_not_mem_iUnion
    (scratch_coordinateFiberInput i f) T
    (fiberDyadicSelectionSet Zf A H) (coordinateSplit i x)
  simpa only [fiberDyadicExceptionalSetFinset] using hx

