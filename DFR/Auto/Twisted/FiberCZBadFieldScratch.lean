/-- The pulled-back coordinate good and bad fields reconstruct the original
ambient input pointwise. -/
theorem scratch_coordinateFiberGoodField_add_badField
    (i : Fin 3) (f : E3 → ℝ) (T : Finset FiberDyadicInterval)
    (S : FiberDyadicInterval → Set (TransverseSpace i)) :
    scratch_coordinateFiberGoodField i f T S +
      scratch_coordinateFiberBadField i f T S = f := by
  funext x
  have h := congrFun
    (scratch_fiberCZGoodField_add_badField
      (scratch_coordinateFiberInput i f) T S) (coordinateSplit i x)
  change scratch_coordinateFiberGoodField i f T S x +
      scratch_coordinateFiberBadField i f T S x = f x
  simpa only [Pi.add_apply, scratch_coordinateFiberGoodField,
    scratch_coordinateFiberBadField, scratch_coordinateFiberInput,
    coordinateJoin_split] using h

