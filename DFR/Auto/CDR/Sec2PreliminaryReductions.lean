    refine ⟨S.min' (Finset.nonempty_iff_ne_empty.2 hS), S.max' (Finset.nonempty_iff_ne_empty.2 hS),
      fun m hm => Finset.mem_Icc.2 ⟨Finset.min'_le _ _ hm, Finset.le_max' _ _ hm⟩⟩
  have hsub : ∑ m ∈ S, monoPsiA (ξ / 2 ^ m) ≤ ∑ m ∈ Finset.Icc a b, monoPsiA (ξ / 2 ^ m) :=
    Finset.sum_le_sum_of_subset_of_nonneg hab fun m _ _ => monoPsiA_nonneg _
  refine hsub.trans ?_
  -- telescoping over the offsets `a + n`
  have htel : ∀ n : ℕ, ∑ i ∈ Finset.range (n + 1), monoPsiA (ξ / 2 ^ (a + i)) =
      monoPhi (ξ / 2 ^ (a + n)) - monoPhi (ξ / 2 ^ (a - 1)) := by
    intro n
    induction n with
    | zero =>
      simp only [zero_add, Finset.range_one, Finset.sum_singleton, Nat.cast_zero, add_zero,
        monoPsiA]
      congr 2
      rw [zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_one]; field_simp
    | succ n ih =>
      rw [Finset.sum_range_succ, ih]
      simp only [monoPsiA]
      have : 2 * (ξ / 2 ^ (a + ((n + 1 : ℕ) : ℤ))) = ξ / 2 ^ (a + n) := by
        rw [show a + ((n + 1 : ℕ) : ℤ) = (a + n) + 1 by push_cast; ring,
          zpow_add_one₀ (by norm_num : (2 : ℝ) ≠ 0)]; field_simp
      rw [this]; ring
  rcases le_or_gt a b with h | h
  · obtain ⟨n, hn⟩ : ∃ n : ℕ, b = a + n := ⟨(b - a).toNat, by omega⟩
    have hre : ∑ m ∈ Finset.Icc a b, monoPsiA (ξ / 2 ^ m) =
        ∑ i ∈ Finset.range (n + 1), monoPsiA (ξ / 2 ^ (a + i)) := by
      refine Finset.sum_nbij' (fun m => (m - a).toNat) (fun i => a + i) ?_ ?_ ?_ ?_ ?_
      · intro m hm; rw [Finset.mem_Icc] at hm; rw [Finset.mem_range]; omega
      · intro i hi; rw [Finset.mem_range] at hi; rw [Finset.mem_Icc]; omega
      · intro m hm; rw [Finset.mem_Icc] at hm; simp; omega
      · intro i _; simp
      · intro m hm; rw [Finset.mem_Icc] at hm; congr 3; omega
    rw [hre, htel n]
    linarith [monoPhi_le_one (ξ / 2 ^ (a + n)), monoPhi_nonneg (ξ / 2 ^ (a - 1))]
  · rw [Finset.Icc_eq_empty (by omega), Finset.sum_empty]; norm_num

/-- **Square-sum bound**: `∑_{m ∈ S} ‖Δ^{(ℓ)}_m g‖_2^2 ≤ ‖g‖_2^2`. -/
theorem sum_lintegral_lpD_sq_le (ℓ : Fin 2) (S : Finset ℤ) {g : ℝ × ℝ → ℂ} (hg : Measurable g)
    (hfib : FibL12 ℓ g) {M : ℝ} (hM : ∀ z, ‖g z‖ ≤ M) :
    ∑ m ∈ S, ∫⁻ z, ‖lpD ℓ m g z‖ₑ ^ 2 ≤ ∫⁻ z, ‖g z‖ₑ ^ 2 := by
  have hS : ∀ m, FibL12 ℓ (lpS ℓ m g) := fun m => fibL12_monoCConv ℓ
    (integrable_kerScaled monoKPhi m) (fun p => (hfib p).1) hM
  have h := sum_lintegral_sq_le_of_fibF S ℓ (G := fun m => lpD ℓ m g)
    (fun m => measurable_lpD ℓ m hg)
    hg (fun m => fibL12_sub (hS m) (hS (m - 1))) hfib zero_le_one (fun q => by
      simp_rw [fibF_lpD ℓ _ (fun p => (hfib p).1), norm_mul, mul_pow]
      rw [← Finset.sum_mul, one_mul]
      refine mul_le_of_le_one_left (by positivity) ?_
      calc ∑ m ∈ S, ‖(monoPsiA (q.2 / 2 ^ m) : ℂ)‖ ^ 2 ≤ ∑ m ∈ S, monoPsiA (q.2 / 2 ^ m) := by
            refine Finset.sum_le_sum fun m _ => ?_
            rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (monoPsiA_nonneg _), sq]
            exact mul_le_of_le_one_left (monoPsiA_nonneg _) (by
              have := ms8_abs_monoPsiA_le (q.2 / 2 ^ m)
              rwa [abs_of_nonneg (monoPsiA_nonneg _)] at this)
        _ ≤ 1 := sum_monoPsiA_le_one S q.2)
  simpa using h

/-! ### The single-scale averages `M_j` (§2.6) -/

/-- `M_j(g_1,g_2)(x,y) = ∫ g_1(x+t,y) g_2(x,y+t^2) ψ(2^j t) 2^j dt`. -/
def Mj (j : ℤ) (g₁ g₂ : ℝ × ℝ → ℂ) : ℝ × ℝ → ℂ :=
  ms8AvgP 1 2 (fun t => (2 : ℝ) ^ j * monoPsiA ((2 : ℝ) ^ j * t)) g₁ g₂

/-- The positive-time part `∫_{t>0}` of `M_j`. -/
def Aplus (j : ℤ) (g₁ g₂ : ℝ × ℝ → ℂ) : ℝ × ℝ → ℂ :=
  ms8AvgP 1 2 (fun t => (2 : ℝ) ^ j * psiPlus ((2 : ℝ) ^ j * t)) g₁ g₂

/-- The reflection `g(x,y) ↦ g(-x,y)`. -/
def refl (g : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℂ := g (-z.1, z.2)

theorem measurable_refl {g : ℝ × ℝ → ℂ} (hg : Measurable g) : Measurable (refl g) :=
  hg.comp (measurable_fst.neg.prodMk measurable_snd)

theorem measurePreserving_reflPt :
    MeasurePreserving (fun z : ℝ × ℝ => (-z.1, z.2)) volume volume := by
  rw [Measure.volume_eq_prod]
  exact (Measure.measurePreserving_neg volume).prod (MeasurePreserving.id volume)

theorem eLpNorm_comp_reflPt {g : ℝ × ℝ → ℂ} (hg : Measurable g) (p : ℝ≥0∞) :
    eLpNorm (fun z : ℝ × ℝ => g (-z.1, z.2)) p volume = eLpNorm g p volume :=
  eLpNorm_comp_measurePreserving hg.aestronglyMeasurable measurePreserving_reflPt

theorem eLpNorm_refl {g : ℝ × ℝ → ℂ} (hg : Measurable g) (p : ℝ≥0∞) :
    eLpNorm (refl g) p volume = eLpNorm g p volume := eLpNorm_comp_reflPt hg p

theorem fourier_comp_neg (F : ℝ → ℂ) (ξ : ℝ) : 𝓕 (fun a => F (-a)) ξ = 𝓕 F (-ξ) := by
  rw [Real.fourier_real_eq, Real.fourier_real_eq]
  rw [← integral_neg_eq_self (fun v => 𝐞 (-(v * -ξ)) • F v)]
  congr 1; ext v; simp [neg_mul, mul_neg]

theorem psiPlus_hasCompactSupport : HasCompactSupport psiPlus :=
  isCompact_Icc.of_isClosed_subset (isClosed_tsupport _) psiPlus_tsupport

theorem integrable_dilZ {φ : ℝ → ℝ} (hc : Continuous φ) (hcs : HasCompactSupport φ) (j : ℤ) :
    Integrable fun t => (2 : ℝ) ^ j * φ ((2 : ℝ) ^ j * t) := by
  refine (continuous_const.mul (hc.comp (continuous_const.mul
    continuous_id))).integrable_of_hasCompactSupport ?_
  exact (hcs.comp_smul (by positivity : (2 : ℝ) ^ j ≠ 0)).mul_left

theorem Mj_eq_Aplus (j : ℤ) {g₁ g₂ : ℝ × ℝ → ℂ} (h₁ : Measurable g₁) (h₂ : Measurable g₂)
    {M₁ M₂ : ℝ} (hM₁ : ∀ z, ‖g₁ z‖ ≤ M₁) (hM₂ : ∀ z, ‖g₂ z‖ ≤ M₂) (z : ℝ × ℝ) :
    Mj j g₁ g₂ z = Aplus j g₁ g₂ z + Aplus j (refl g₁) (refl g₂) (-z.1, z.2) := by
  set G : ℝ → ℂ := fun t => g₁ (z.1 + t ^ 1, z.2) * g₂ (z.1, z.2 + t ^ 2) with hG
  have hGm : Measurable G := (h₁.comp (by fun_prop)).mul (h₂.comp (by fun_prop))
  have hGb : ∀ t, ‖G t‖ ≤ M₁ * M₂ := fun t => by
    simp only [G, norm_mul]
    exact mul_le_mul (hM₁ _) (hM₂ _) (norm_nonneg _) ((norm_nonneg _).trans (hM₁ z))
  have hint : ∀ {φ : ℝ → ℝ}, Continuous φ → HasCompactSupport φ →
      Integrable fun t => ((((2 : ℝ) ^ j * φ ((2 : ℝ) ^ j * t)) : ℝ) : ℂ) * G t := by
    intro φ hc hcs
    exact (integrable_dilZ hc hcs j).ofReal.mul_bdd (c := M₁ * M₂) hGm.aestronglyMeasurable
      (Eventually.of_forall hGb)
  have hneg : Continuous fun u => psiPlus (-u) := psiPlus_contDiff.continuous.comp continuous_neg
  have hnegc : HasCompactSupport fun u => psiPlus (-u) :=
    psiPlus_hasCompactSupport.comp_homeomorph (Homeomorph.neg ℝ)
  unfold Mj Aplus ms8AvgP
  have e : ∀ t : ℝ, (((2 : ℝ) ^ j * monoPsiA ((2 : ℝ) ^ j * t) : ℝ) : ℂ) * G t =
      (((2 : ℝ) ^ j * psiPlus ((2 : ℝ) ^ j * t) : ℝ) : ℂ) * G t +
      (((2 : ℝ) ^ j * psiPlus (-((2 : ℝ) ^ j * t)) : ℝ) : ℂ) * G t := by
    intro t
    rw [← add_mul, ← Complex.ofReal_add, ← mul_add, psiPlus_add_neg]
  have hL : (∫ t, (((2 : ℝ) ^ j * monoPsiA ((2 : ℝ) ^ j * t) : ℝ) : ℂ) * G t) =
      (∫ t, (((2 : ℝ) ^ j * psiPlus ((2 : ℝ) ^ j * t) : ℝ) : ℂ) * G t) +
      ∫ t, (((2 : ℝ) ^ j * psiPlus (-((2 : ℝ) ^ j * t)) : ℝ) : ℂ) * G t := by
    rw [← integral_add (hint psiPlus_contDiff.continuous psiPlus_hasCompactSupport)
      (hint hneg hnegc)]
    exact integral_congr_ae (Eventually.of_forall e)
  have hQ : (∫ t, (((2 : ℝ) ^ j * psiPlus (-((2 : ℝ) ^ j * t)) : ℝ) : ℂ) * G t) =
      ∫ s, (((2 : ℝ) ^ j * psiPlus ((2 : ℝ) ^ j * s) : ℝ) : ℂ) *
        (refl g₁ ((-z.1, z.2).1 + s ^ 1, (-z.1, z.2).2) *
          refl g₂ ((-z.1, z.2).1, (-z.1, z.2).2 + s ^ 2)) := by
    rw [← integral_neg_eq_self]
    refine integral_congr_ae (Eventually.of_forall fun s => ?_)
    simp only [G, refl, pow_one, mul_neg, neg_neg, even_two, Even.neg_pow]
    congr 3
    ring_nf
  exact hL.trans (by rw [hQ])

theorem integrable_fib0_refl {g : ℝ × ℝ → ℂ} (hg : ∀ p, Integrable (monoFib 0 g p)) (p : ℝ) :
    Integrable (monoFib 0 (refl g) p) := by
  have e : monoFib 0 (refl g) p = fun a => monoFib 0 g p (-a) := by
    ext a; simp [monoFib, monoPt, refl]
  rw [e]; exact (hg p).comp_neg

theorem integrable_fib1_refl {g : ℝ × ℝ → ℂ} (hg : ∀ p, Integrable (monoFib 1 g p)) (p : ℝ) :
    Integrable (monoFib 1 (refl g) p) := by
  have e : monoFib 1 (refl g) p = monoFib 1 g (-p) := by
    ext a; simp [monoFib, monoPt, refl]
  rw [e]; exact hg (-p)

theorem fourier_fib0_refl (g : ℝ × ℝ → ℂ) (p ξ : ℝ) :
    𝓕 (monoFib 0 (refl g) p) ξ = 𝓕 (monoFib 0 g p) (-ξ) := by
  have e : monoFib 0 (refl g) p = fun a => monoFib 0 g p (-a) := by
    ext a; simp [monoFib, monoPt, refl]
  rw [e, fourier_comp_neg]

theorem fourier_fib1_refl (g : ℝ × ℝ → ℂ) (p ξ : ℝ) :
    𝓕 (monoFib 1 (refl g) p) ξ = 𝓕 (monoFib 1 g (-p)) ξ := by
  have e : monoFib 1 (refl g) p = monoFib 1 g (-p) := by
    ext a; simp [monoFib, monoPt, refl]
  rw [e]

/-- **The `L^2` gain for `M_j`** (`eqn:max-l2-decay` with the global smoothing inequality): if
`g₁` has fiberwise frequencies `≥ Λ 2^j` or `g₂` has frequencies `≥ Λ 4^j`, then
`‖M_j(g₁, g₂)‖_1 ≤ C Λ^{-δ} ‖g₁‖_2 ‖g₂‖_2`. -/
theorem Mj_gain : ∃ C δ : ℝ, 0 < C ∧ 0 < δ ∧ ∀ (j : ℤ) (Λ : ℝ), 1 ≤ Λ →
    ∀ g₁ g₂ : ℝ × ℝ → ℂ, Measurable g₁ → Measurable g₂ →
    ∀ M₁ M₂ : ℝ, (∀ z, ‖g₁ z‖ ≤ M₁) → (∀ z, ‖g₂ z‖ ≤ M₂) →
    (∀ p, Integrable (monoFib 0 g₁ p) volume) → (∀ p, Integrable (monoFib 1 g₂ p) volume) →
    eLpNorm g₁ 2 volume ≠ ⊤ → eLpNorm g₂ 2 volume ≠ ⊤ →
    ((∀ p ξ, |ξ| < Λ * 2 ^ j → 𝓕 (monoFib 0 g₁ p) ξ = 0) ∨
      (∀ p ξ, |ξ| < Λ * ((2 : ℝ) ^ j) ^ 2 → 𝓕 (monoFib 1 g₂ p) ξ = 0)) →
    eLpNorm (Mj j g₁ g₂) 1 volume ≤
      ENNReal.ofReal (2 * C * Λ ^ (-δ)) * (eLpNorm g₁ 2 volume * eLpNorm g₂ 2 volume) := by
  obtain ⟨C, δ, hC, hδ, hS⟩ := scaled_smoothing_psi
  refine ⟨C, δ, hC, hδ, fun j Λ hΛ g₁ g₂ h₁ h₂ M₁ M₂ hM₁ hM₂ hf₁ hf₂ hn₁ hn₂ hF => ?_⟩
  have hj : (0 : ℝ) < 2 ^ j := by positivity
  have hA := hS (2 ^ j) Λ hj hΛ g₁ g₂ h₁ h₂ M₁ M₂ hM₁ hM₂ hf₁ hf₂ hn₁ hn₂ hF
  have hR := hS (2 ^ j) Λ hj hΛ (refl g₁) (refl g₂) (measurable_refl h₁) (measurable_refl h₂)
    M₁ M₂ (fun z => hM₁ _) (fun z => hM₂ _) (integrable_fib0_refl hf₁)
    (integrable_fib1_refl hf₂) (by rwa [eLpNorm_refl h₁]) (by rwa [eLpNorm_refl h₂]) (by
      rcases hF with hF | hF
      · left; intro p ξ hξ; rw [fourier_fib0_refl]; exact hF p (-ξ) (by rwa [abs_neg])
      · right; intro p ξ hξ; rw [fourier_fib1_refl]; exact hF (-p) ξ hξ)
  rw [eLpNorm_refl h₁, eLpNorm_refl h₂] at hR
  have hmA : Measurable (Aplus j g₁ g₂) := measurable_ms8AvgP
    (continuous_const.mul (psiPlus_contDiff.continuous.comp (continuous_const.mul
      continuous_id))).measurable h₁ h₂
  have hmR : Measurable (Aplus j (refl g₁) (refl g₂)) := measurable_ms8AvgP
    (continuous_const.mul (psiPlus_contDiff.continuous.comp (continuous_const.mul
      continuous_id))).measurable (measurable_refl h₁) (measurable_refl h₂)
  have e : Mj j g₁ g₂ = fun z => Aplus j g₁ g₂ z + Aplus j (refl g₁) (refl g₂) (-z.1, z.2) :=
    funext (Mj_eq_Aplus j h₁ h₂ hM₁ hM₂)
  rw [e]
  refine (eLpNorm_add_le hmA.aestronglyMeasurable
    (hmR.comp (measurable_fst.neg.prodMk measurable_snd)).aestronglyMeasurable le_rfl).trans ?_
  have hrefl : eLpNorm ((Aplus j (refl g₁) (refl g₂)) ∘ fun a : ℝ × ℝ => (-a.1, a.2)) 1 volume =
      eLpNorm (Aplus j (refl g₁) (refl g₂)) 1 volume := eLpNorm_comp_reflPt hmR 1
  erw [hrefl]
  unfold Aplus at hmA hmR ⊢
  calc eLpNorm (ms8AvgP 1 2 (fun t => (2 : ℝ) ^ j * psiPlus ((2 : ℝ) ^ j * t)) g₁ g₂) 1 volume +
        eLpNorm (ms8AvgP 1 2 (fun t => (2 : ℝ) ^ j * psiPlus ((2 : ℝ) ^ j * t)) (refl g₁)
          (refl g₂)) 1 volume
      ≤ ENNReal.ofReal (C * Λ ^ (-δ)) * (eLpNorm g₁ 2 volume * eLpNorm g₂ 2 volume) +
        ENNReal.ofReal (C * Λ ^ (-δ)) * (eLpNorm g₁ 2 volume * eLpNorm g₂ 2 volume) :=
        add_le_add hA hR
    _ = ENNReal.ofReal (2 * C * Λ ^ (-δ)) * (eLpNorm g₁ 2 volume * eLpNorm g₂ 2 volume) := by
        rw [← add_mul, ← ENNReal.ofReal_add (by positivity) (by positivity)]; ring_nf

/-! ### The maximal operator of Theorem 3 and the reduction to `sup_j M_j` -/

/-- The bilinear maximal operator of Theorem 3,
`M(f_1,f_2)(x,y) = sup_{r > 0} (2r)^{-1} ∫_{-r}^{r} |f_1(x+t,y) f_2(x,y+t^2)| dt`
(with values in `[0, ∞]`). -/
def maxOp (f₁ f₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℝ≥0∞ :=
  ⨆ (r : ℝ) (_ : 0 < r), ENNReal.ofReal (1 / (2 * r)) *
    ∫⁻ t in Icc (-r) r, ‖f₁ (z.1 + t, z.2)‖ₑ * ‖f₂ (z.1, z.2 + t ^ 2)‖ₑ

/-- `M_j(|f_1|, |f_2|)` with values in `[0, ∞]`. -/
def MjE (j : ℤ) (f₁ f₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℝ≥0∞ :=
  ∫⁻ t, ENNReal.ofReal ((2 : ℝ) ^ j * monoPsiA ((2 : ℝ) ^ j * t)) *
    (‖f₁ (z.1 + t, z.2)‖ₑ * ‖f₂ (z.1, z.2 + t ^ 2)‖ₑ)

/-- `∑_{j = j₀}^{j₀ + n} ψ(2^j t) = φ(2^{j₀} t) - φ(2^{j₀+n+1} t)`. -/
theorem sum_monoPsiA_zpow (j₀ : ℤ) (n : ℕ) (t : ℝ) :
    ∑ i ∈ Finset.range (n + 1), monoPsiA ((2 : ℝ) ^ (j₀ + i) * t) =
      monoPhi ((2 : ℝ) ^ j₀ * t) - monoPhi ((2 : ℝ) ^ (j₀ + n + 1) * t) := by
  induction n with
  | zero =>
    simp only [zero_add, Finset.range_one, Finset.sum_singleton, Nat.cast_zero, add_zero,
      monoPsiA]
    rw [zpow_add_one₀ (by norm_num : (2 : ℝ) ≠ 0)]; ring_nf
  | succ n ih =>
    rw [Finset.sum_range_succ, ih]
    simp only [monoPsiA]
    rw [show j₀ + ((n + 1 : ℕ) : ℤ) = j₀ + n + 1 by push_cast; ring,
      zpow_add_one₀ (by norm_num : (2 : ℝ) ≠ 0) (j₀ + n + 1)]
    ring_nf

/-- For `2^{j₀} r ≤ 1` and `2^{-J} ≤ |t| ≤ r`: `∑_{j=j₀}^{J} ψ(2^j t) = 1`. -/
theorem sum_monoPsiA_eq_one {j₀ : ℤ} {n : ℕ} {r t : ℝ} (hj₀ : (2 : ℝ) ^ j₀ * r ≤ 1)
    (ht : |t| ≤ r) (ht' : 2 ≤ (2 : ℝ) ^ (j₀ + n + 1) * |t|) :
    ∑ i ∈ Finset.range (n + 1), monoPsiA ((2 : ℝ) ^ (j₀ + i) * t) = 1 := by
  rw [sum_monoPsiA_zpow]
  have h1 : monoPhi ((2 : ℝ) ^ j₀ * t) = 1 := monoPhi_eq_one (by
    rw [abs_mul, abs_of_pos (by positivity)]
    exact (mul_le_mul_of_nonneg_left ht (by positivity)).trans hj₀)
  have h2 : monoPhi ((2 : ℝ) ^ (j₀ + n + 1) * t) = 0 := monoPhi_eq_zero (by
    rw [abs_mul, abs_of_pos (by positivity)]; exact ht')
  rw [h1, h2, sub_zero]

/-- **The reduction of §2.6** (lines 649-651): `M(f_1,f_2) ≤ 2 sup_j M_j(|f_1|, |f_2|)`. -/
theorem maxOp_le_iSup_MjE (f₁ f₂ : ℝ × ℝ → ℂ) (hf₁ : Measurable f₁) (hf₂ : Measurable f₂)
    (z : ℝ × ℝ) : maxOp f₁ f₂ z ≤ 2 * ⨆ j : ℤ, MjE j f₁ f₂ z := by
  set S := ⨆ j : ℤ, MjE j f₁ f₂ z
  set G : ℝ → ℝ≥0∞ := fun t => ‖f₁ (z.1 + t, z.2)‖ₑ * ‖f₂ (z.1, z.2 + t ^ 2)‖ₑ with hG
  have hGm : Measurable G :=
    (hf₁.comp (by fun_prop)).enorm.mul (hf₂.comp (by fun_prop)).enorm
  refine iSup₂_le fun r hr => ?_
  -- choose `j₀` with `2^{j₀} ≤ 1/r < 2^{j₀+1}`
  obtain ⟨j₀, hj₀⟩ := exists_mem_Ico_zpow (show (0 : ℝ) < 1 / r by positivity)
    (show (1 : ℝ) < 2 by norm_num)
  have hj₀a : (2 : ℝ) ^ j₀ * r ≤ 1 := by
    have := hj₀.1; rw [le_div_iff₀ hr] at this; exact this
  have hj₀b : 1 < (2 : ℝ) ^ (j₀ + 1) * r := by
    have := hj₀.2; rw [div_lt_iff₀ hr] at this; exact this
  -- the finite sums `∑_{j=j₀}^{j₀+n}` dominate `1_{2^{-(j₀+n)} ≤ |t| ≤ r}`
  have hbound : ∀ n : ℕ, ∫⁻ t in Icc (-r) r ∩ {t | 2 ≤ (2 : ℝ) ^ (j₀ + n + 1) * |t|}, G t ≤
      ENNReal.ofReal ((2 : ℝ) ^ (1 - j₀)) * S := by
    intro n
    have hSm : MeasurableSet (Icc (-r) r ∩ {t : ℝ | 2 ≤ (2 : ℝ) ^ (j₀ + n + 1) * |t|}) :=
      measurableSet_Icc.inter (measurableSet_le measurable_const (by fun_prop))
    calc ∫⁻ t in Icc (-r) r ∩ {t | 2 ≤ (2 : ℝ) ^ (j₀ + n + 1) * |t|}, G t
        ≤ ∫⁻ t, ∑ i ∈ Finset.range (n + 1),
            ENNReal.ofReal (monoPsiA ((2 : ℝ) ^ (j₀ + i) * t)) * G t := by
          rw [← lintegral_indicator hSm]
          refine lintegral_mono fun t => ?_
          by_cases ht : t ∈ Icc (-r) r ∩ {t | 2 ≤ (2 : ℝ) ^ (j₀ + n + 1) * |t|}
          · rw [indicator_of_mem ht, ← Finset.sum_mul, ← ENNReal.ofReal_sum_of_nonneg
              (fun i _ => monoPsiA_nonneg _),
              sum_monoPsiA_eq_one hj₀a (abs_le.2 ht.1) ht.2, ENNReal.ofReal_one, one_mul]
          · rw [indicator_of_notMem ht]; exact bot_le
      _ = ∑ i ∈ Finset.range (n + 1), ENNReal.ofReal ((2 : ℝ) ^ (-(j₀ + i))) *
            MjE (j₀ + i) f₁ f₂ z := by
          rw [lintegral_finsetSum (Finset.range (n + 1))
            (f := fun i t => ENNReal.ofReal (monoPsiA ((2 : ℝ) ^ (j₀ + i) * t)) * G t)
            fun i _ => (ENNReal.measurable_ofReal.comp
              (monoPsiA_contDiff.continuous.measurable.comp (measurable_const.mul
                measurable_id))).mul hGm]
          refine Finset.sum_congr rfl fun i _ => ?_
          unfold MjE
          rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
          refine lintegral_congr fun t => ?_
          have h : (2 : ℝ) ^ (-(j₀ + i)) * ((2 : ℝ) ^ (j₀ + i) * monoPsiA ((2 : ℝ) ^ (j₀ + i) * t))
              = monoPsiA ((2 : ℝ) ^ (j₀ + i) * t) := by
            rw [← mul_assoc, ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), neg_add_cancel, zpow_zero,
              one_mul]
          rw [← mul_assoc (ENNReal.ofReal _) (ENNReal.ofReal _),
            ← ENNReal.ofReal_mul (by positivity), h]
      _ ≤ ∑ i ∈ Finset.range (n + 1), ENNReal.ofReal ((2 : ℝ) ^ (-(j₀ + i))) * S := by
          gcongr with i
          exact le_iSup (fun j : ℤ => MjE j f₁ f₂ z) (j₀ + i)
      _ ≤ ENNReal.ofReal ((2 : ℝ) ^ (1 - j₀)) * S := by
          rw [← Finset.sum_mul]
          gcongr
          rw [← ENNReal.ofReal_sum_of_nonneg (fun i _ => by positivity)]
          refine ENNReal.ofReal_le_ofReal ?_
          have hgeom : ∀ i : ℕ, (2 : ℝ) ^ (-(j₀ + i)) = (2 : ℝ) ^ (-j₀) * (1 / 2) ^ i := by
            intro i
            rw [neg_add, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_neg (2 : ℝ) (i : ℤ),
              zpow_natCast, one_div, inv_pow]
          simp_rw [hgeom, ← Finset.mul_sum]
          have : ∑ i ∈ Finset.range (n + 1), (1 / 2 : ℝ) ^ i ≤ 2 := by
            have := sum_geometric_two_le (n + 1)
            simpa using this
          calc (2 : ℝ) ^ (-j₀) * ∑ i ∈ Finset.range (n + 1), (1 / 2 : ℝ) ^ i
              ≤ (2 : ℝ) ^ (-j₀) * 2 := by gcongr
            _ = (2 : ℝ) ^ (1 - j₀) := by
                rw [sub_eq_add_neg, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_one]; ring
  -- let `n → ∞`
  have hlim : ∫⁻ t in Icc (-r) r, G t ≤ ENNReal.ofReal ((2 : ℝ) ^ (1 - j₀)) * S := by
    have hnull : volume ({0} : Set ℝ) = 0 := measure_singleton 0
    have hunion : Icc (-r) r \ {0} ⊆
        ⋃ n : ℕ, Icc (-r) r ∩ {t | 2 ≤ (2 : ℝ) ^ (j₀ + n + 1) * |t|} := by
      intro t ht
      have ht0 : 0 < |t| := abs_pos.2 ht.2
      obtain ⟨n, hn⟩ :=
        pow_unbounded_of_one_lt (2 / (2 ^ (j₀ + 1) * |t|)) (by norm_num : (1 : ℝ) < 2)
      refine mem_iUnion.2 ⟨n, ht.1, ?_⟩
      have : (2 : ℝ) ^ (j₀ + n + 1) = 2 ^ (j₀ + 1) * 2 ^ n := by
        rw [show j₀ + n + 1 = (j₀ + 1) + n by ring, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0),
          zpow_natCast]
      rw [mem_setOf_eq, this]
      rw [div_lt_iff₀ (by positivity)] at hn
      nlinarith
    calc ∫⁻ t in Icc (-r) r, G t = ∫⁻ t in Icc (-r) r \ {0}, G t :=
          setLIntegral_congr (sdiff_null_ae_eq_self hnull).symm
      _ ≤ ∫⁻ t in ⋃ n : ℕ, Icc (-r) r ∩ {t | 2 ≤ (2 : ℝ) ^ (j₀ + n + 1) * |t|}, G t :=
          lintegral_mono_set hunion
      _ = ⨆ n : ℕ, ∫⁻ t in Icc (-r) r ∩ {t | 2 ≤ (2 : ℝ) ^ (j₀ + n + 1) * |t|}, G t := by
          refine setLIntegral_iUnion_of_directed G (Monotone.directed_le fun n m hnm => ?_)
          intro t ht
          refine ⟨ht.1, ?_⟩
          have h2 : 2 ≤ (2 : ℝ) ^ (j₀ + n + 1) * |t| := ht.2
          change 2 ≤ (2 : ℝ) ^ (j₀ + m + 1) * |t|
          refine h2.trans (mul_le_mul_of_nonneg_right (zpow_le_zpow_right₀ (by norm_num)
            (by have : (n : ℤ) ≤ m := by exact_mod_cast hnm
                omega)) (abs_nonneg _))
      _ ≤ _ := iSup_le hbound
  calc ENNReal.ofReal (1 / (2 * r)) * ∫⁻ t in Icc (-r) r, G t
      ≤ ENNReal.ofReal (1 / (2 * r)) * (ENNReal.ofReal ((2 : ℝ) ^ (1 - j₀)) * S) := by gcongr
    _ = ENNReal.ofReal (1 / (2 * r) * (2 : ℝ) ^ (1 - j₀)) * S := by
        rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
    _ ≤ 2 * S := by
        gcongr
        rw [show (2 : ℝ≥0∞) = ENNReal.ofReal 2 by simp]
        refine ENNReal.ofReal_le_ofReal ?_
        have h2 : (2 : ℝ) ^ (1 - j₀) = 2 / 2 ^ j₀ := by
          rw [sub_eq_add_neg, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_one, zpow_neg,
            div_eq_mul_inv]
        rw [h2]
        have hpos : (0 : ℝ) < 2 ^ j₀ := by positivity
        rw [div_mul_div_comm, div_le_iff₀ (by positivity)]
        have := hj₀b
        rw [zpow_add_one₀ (by norm_num : (2 : ℝ) ≠ 0)] at this
        nlinarith

/-! ### The Hardy-Littlewood maximal function and kernel domination -/

/-- The centered dyadic Hardy-Littlewood maximal function on `ℝ`,
`𝓜 g(x) = sup_s 2^{-s} ∫_{|t| ≤ 2^{s-1}} |g(x+t)| dt` (the shifted maximal function with
`σ = -1/2`). -/
abbrev hlMax (g : ℝ → ℂ) (x : ℝ) : ℝ := shiftedMaximal (-1 / 2) g x

theorem lintegral_symm_interval_le {g : ℝ → ℂ} (hg : Measurable g) {a : ℝ} (hga : ∀ x, ‖g x‖ ≤ a)
    (x : ℝ) (k : ℤ) :
    ∫⁻ u in Icc (-((2 : ℝ) ^ k / 2)) ((2 : ℝ) ^ k / 2), ‖g (x - u)‖ₑ ≤
      ENNReal.ofReal ((2 : ℝ) ^ k * hlMax g x) := by
  have ha : 0 ≤ a := (norm_nonneg _).trans (hga 0)
  have hk : (0 : ℝ) < 2 ^ k := by positivity
  have hfin : IntegrableOn (fun t => g (x + t)) (Icc ((-1 / 2) * 2 ^ k) ((-1 / 2 + 1) * 2 ^ k)) :=
    Measure.integrableOn_of_bounded measure_Icc_lt_top.ne
      (hg.comp (measurable_const_add x)).aestronglyMeasurable
      (Eventually.of_forall fun t => hga _)
  have e1 : ∫⁻ u in Icc (-((2 : ℝ) ^ k / 2)) ((2 : ℝ) ^ k / 2), ‖g (x - u)‖ₑ =
      ∫⁻ t in Icc ((-1 / 2) * (2 : ℝ) ^ k) ((-1 / 2 + 1) * 2 ^ k), ‖g (x + t)‖ₑ := by
    have hI : Icc ((-1 / 2) * (2 : ℝ) ^ k) ((-1 / 2 + 1) * 2 ^ k) =
        Icc (-((2 : ℝ) ^ k / 2)) ((2 : ℝ) ^ k / 2) := by congr 1 <;> ring
    rw [hI, ← lintegral_indicator measurableSet_Icc, ← lintegral_indicator measurableSet_Icc,
      ← lintegral_neg_eq_self]
    refine lintegral_congr fun u => ?_
    by_cases hu : -u ∈ Icc (-((2 : ℝ) ^ k / 2)) ((2 : ℝ) ^ k / 2)
    · have hu' : u ∈ Icc (-((2 : ℝ) ^ k / 2)) ((2 : ℝ) ^ k / 2) := by
        rw [mem_Icc] at hu ⊢; constructor <;> linarith [hu.1, hu.2]
      rw [indicator_of_mem hu, indicator_of_mem hu', sub_neg_eq_add]
    · have hu' : u ∉ Icc (-((2 : ℝ) ^ k / 2)) ((2 : ℝ) ^ k / 2) := fun h => hu (by
        rw [mem_Icc] at h ⊢; constructor <;> linarith [h.1, h.2])
      rw [indicator_of_notMem hu, indicator_of_notMem hu']
  rw [e1, ← ofReal_integral_norm_eq_lintegral_enorm hfin]
  refine ENNReal.ofReal_le_ofReal ?_
  have h := shiftedAverage_le_shiftedMaximal (-1 / 2) hga x k
  unfold shiftedAverage at h
  have : ∫ t in Icc ((-1 / 2) * (2 : ℝ) ^ k) ((-1 / 2 + 1) * 2 ^ k), ‖g (x + t)‖ =
      2 ^ k * ((2 : ℝ) ^ (-k) * ∫ t in Icc ((-1 / 2) * (2 : ℝ) ^ k) ((-1 / 2 + 1) * 2 ^ k),
        ‖g (x + t)‖) := by
    rw [← mul_assoc, ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), add_neg_cancel, zpow_zero, one_mul]
  rw [this]
  exact mul_le_mul_of_nonneg_left h hk.le

/-- The dyadic majorant of `A L (1 + L|u|)^{-2}`: for `L = 2^m`,
`A L (1 + L|u|)^{-2} ≤ ∑_i 4 A 2^{-i} (L 2^{-i}) 1_{|u| ≤ 2^i/L}`. -/
theorem kernel_majorant {A : ℝ} (hA : 0 ≤ A) (m : ℤ) (u : ℝ) :
    ENNReal.ofReal (A * 2 ^ m / (1 + 2 ^ m * |u|) ^ 2) ≤
      ∑' i : ℕ, ENNReal.ofReal (4 * A * (1 / 2) ^ i * (2 ^ m * (1 / 2) ^ i)) *
        (Icc (-((2 : ℝ) ^ ((i : ℤ) + 1 - m) / 2))
          ((2 : ℝ) ^ ((i : ℤ) + 1 - m) / 2)).indicator 1 u := by
  have hm : (0 : ℝ) < 2 ^ m := by positivity
  have hex : ∃ i : ℕ, |u| ≤ (2 : ℝ) ^ ((i : ℤ) + 1 - m) / 2 := by
    obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt (2 ^ m * |u|) (by norm_num : (1 : ℝ) < 2)
    refine ⟨n, ?_⟩
    have : (2 : ℝ) ^ ((n : ℤ) + 1 - m) / 2 = 2 ^ n / 2 ^ m := by
      rw [show (n : ℤ) + 1 - m = n + (1 - m) by ring, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0),
        zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_one, zpow_natCast]
      field_simp
    rw [this, le_div_iff₀ hm]; linarith
  classical
  set i₀ := Nat.find hex
  have hi₀ : |u| ≤ (2 : ℝ) ^ ((i₀ : ℤ) + 1 - m) / 2 := Nat.find_spec hex
  have hterm := ENNReal.le_tsum (f := fun i : ℕ => ENNReal.ofReal (4 * A * (1 / 2) ^ i *
      (2 ^ m * (1 / 2) ^ i)) *
      (Icc (-((2 : ℝ) ^ ((i : ℤ) + 1 - m) / 2)) ((2 : ℝ) ^ ((i : ℤ) + 1 - m) / 2)).indicator 1 u) i₀
  refine le_trans ?_ hterm
  rw [indicator_of_mem (by rw [mem_Icc]; constructor <;> linarith [abs_le.1 hi₀]), Pi.one_apply,
    mul_one]
  refine ENNReal.ofReal_le_ofReal ?_
  have hpow : ∀ i : ℕ, (2 : ℝ) ^ ((i : ℤ) + 1 - m) / 2 = 2 ^ i / 2 ^ m := by
    intro i
    rw [show (i : ℤ) + 1 - m = i + (1 - m) by ring, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0),
      zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_one, zpow_natCast]
    field_simp
  rcases Nat.eq_zero_or_pos i₀ with h0 | hpos
  · rw [h0]
    simp only [pow_zero, mul_one]
    have : 1 ≤ (1 + 2 ^ m * |u|) ^ 2 := one_le_pow₀ (by have := abs_nonneg u; nlinarith)
    rw [div_le_iff₀ (by positivity)]
    nlinarith [mul_nonneg hA hm.le]
  · have hprev := Nat.find_min hex (Nat.sub_lt hpos one_pos)
    rw [not_le, hpow] at hprev
    rw [div_lt_iff₀ hm] at hprev
    have h1 : (2 : ℝ) ^ (i₀ - 1) ≤ 2 ^ m * |u| := by linarith
    have h2 : (2 : ℝ) ^ (i₀ - 1) * 2 = 2 ^ i₀ := by
      rw [← pow_succ, Nat.sub_add_cancel hpos]
    have hsq : ((2 : ℝ) ^ i₀) ^ 2 ≤ 4 * (1 + 2 ^ m * |u|) ^ 2 := by
      have : (2 : ℝ) ^ i₀ ≤ 2 * (1 + 2 ^ m * |u|) := by
        nlinarith [pow_pos (by norm_num : (0:ℝ) < 2) (i₀ - 1)]
      nlinarith [pow_pos (by norm_num : (0:ℝ) < 2) i₀]
    rw [div_le_iff₀ (by positivity)]
    have e : (1 / 2 : ℝ) ^ i₀ * (1 / 2) ^ i₀ * ((2 : ℝ) ^ i₀) ^ 2 = 1 := by
      rw [show (1 / 2 : ℝ) ^ i₀ * (1 / 2) ^ i₀ * ((2 : ℝ) ^ i₀) ^ 2 =
        ((1 / 2 : ℝ) ^ i₀ * 2 ^ i₀) ^ 2 by ring, ← mul_pow]; norm_num
    have hq : 0 ≤ (1 / 2 : ℝ) ^ i₀ * (1 / 2) ^ i₀ := by positivity
    calc A * 2 ^ m = A * 2 ^ m * ((1 / 2 : ℝ) ^ i₀ * (1 / 2) ^ i₀ * ((2 : ℝ) ^ i₀) ^ 2) := by
          rw [e, mul_one]
      _ ≤ A * 2 ^ m * ((1 / 2 : ℝ) ^ i₀ * (1 / 2) ^ i₀ * (4 * (1 + 2 ^ m * |u|) ^ 2)) := by
          gcongr
      _ = 4 * A * (1 / 2) ^ i₀ * (2 ^ m * (1 / 2) ^ i₀) * (1 + 2 ^ m * |u|) ^ 2 := by ring

/-- **Kernel domination**: if `|K(u)| ≤ A L (1 + L|u|)^{-2}` with `L = 2^m`, then
`∫ |K(u)| |g(x-u)| du ≤ 16 A 𝓜 g(x)`. -/
theorem lintegral_kernel_le_hlMax {K : ℝ → ℂ} {A : ℝ} (hA : 0 ≤ A) (m : ℤ)
    (hK : ∀ u, ‖K u‖ ≤ A * 2 ^ m / (1 + 2 ^ m * |u|) ^ 2) {g : ℝ → ℂ} (hg : Measurable g)
    {a : ℝ} (hga : ∀ x, ‖g x‖ ≤ a) (x : ℝ) :
    ∫⁻ u, ‖K u‖ₑ * ‖g (x - u)‖ₑ ≤ ENNReal.ofReal (16 * A * hlMax g x) := by
  have hgm : Measurable fun u => ‖g (x - u)‖ₑ :=
    (hg.comp (measurable_const.sub measurable_id)).enorm
  set I : ℕ → Set ℝ := fun i =>
    Icc (-((2 : ℝ) ^ ((i : ℤ) + 1 - m) / 2)) ((2 : ℝ) ^ ((i : ℤ) + 1 - m) / 2)
  set c : ℕ → ℝ := fun i => 4 * A * (1 / 2) ^ i * (2 ^ m * (1 / 2) ^ i)
  have hM : 0 ≤ hlMax g x := shiftedMaximal_nonneg _ _ _
  calc ∫⁻ u, ‖K u‖ₑ * ‖g (x - u)‖ₑ
      ≤ ∫⁻ u, (∑' i, ENNReal.ofReal (c i) * (I i).indicator 1 u) * ‖g (x - u)‖ₑ := by
        refine lintegral_mono fun u => ?_
        gcongr
        rw [← ofReal_norm]
        exact (ENNReal.ofReal_le_ofReal (hK u)).trans (kernel_majorant hA m u)
    _ = ∑' i, ENNReal.ofReal (c i) * ∫⁻ u in I i, ‖g (x - u)‖ₑ := by
        simp_rw [← ENNReal.tsum_mul_right]
        rw [lintegral_tsum (f := fun i u => ENNReal.ofReal (c i) * (I i).indicator 1 u *
          ‖g (x - u)‖ₑ) fun i => ((measurable_const.mul ((measurable_one.indicator
            measurableSet_Icc))).mul hgm).aemeasurable]
        refine tsum_congr fun i => ?_
        rw [← lintegral_indicator measurableSet_Icc, ← lintegral_const_mul _
          (hgm.indicator measurableSet_Icc)]
        refine lintegral_congr fun u => ?_
        by_cases hu : u ∈ I i
        · simp only [I] at hu ⊢
          simp only [indicator_of_mem hu, Pi.one_apply, mul_one]
        · simp only [I] at hu ⊢
          simp only [indicator_of_notMem hu, mul_zero, zero_mul]
    _ ≤ ∑' i, ENNReal.ofReal (c i) * ENNReal.ofReal ((2 : ℝ) ^ ((i : ℤ) + 1 - m) * hlMax g x) := by
        gcongr with i
        exact lintegral_symm_interval_le hg hga x _
    _ = ∑' i : ℕ, ENNReal.ofReal (8 * A * hlMax g x) * (1 / 2) ^ i := by
        refine tsum_congr fun i => ?_
        rw [← ENNReal.ofReal_mul (by positivity)]
        have hpow : (2 : ℝ) ^ ((i : ℤ) + 1 - m) = 2 * 2 ^ i / 2 ^ m := by
          rw [show (i : ℤ) + 1 - m = i + (1 - m) by ring, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0),
            zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_one, zpow_natCast]
          field_simp
        have h12 : (1 / 2 : ℝ) ^ i * 2 ^ i = 1 := by rw [← mul_pow]; norm_num
        have hm0 : (2 : ℝ) ^ m ≠ 0 := by positivity
        have e : c i * (2 * 2 ^ i / 2 ^ m * hlMax g x) = 8 * A * hlMax g x * (1 / 2) ^ i := by
          simp only [c]
          rw [show 4 * A * (1 / 2) ^ i * (2 ^ m * (1 / 2) ^ i) * (2 * 2 ^ i / 2 ^ m * hlMax g x) =
            8 * A * hlMax g x * (1 / 2) ^ i * ((1 / 2) ^ i * 2 ^ i) * (2 ^ m / 2 ^ m) by ring,
            h12, div_self hm0]
          ring
        rw [hpow, e, ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_pow (by norm_num)]
        congr 2
        rw [one_div, ENNReal.ofReal_inv_of_pos (by norm_num), ENNReal.ofReal_ofNat, one_div]
    _ = ENNReal.ofReal (16 * A * hlMax g x) := by
        rw [ENNReal.tsum_mul_left, ENNReal.tsum_geometric, one_div, ENNReal.one_sub_inv_two,
          inv_inv, show (2 : ℝ≥0∞) = ENNReal.ofReal 2 by simp,
          ← ENNReal.ofReal_mul (by positivity)]
        ring_nf

/-! ### Maximal functions in one coordinate and pointwise bounds for `S_m`, `Δ_m` -/

/-- The scaled kernel `2^m κ(2^m s)` of `S_m` (`κ = φ̌`). -/
def kS (m : ℤ) (s : ℝ) : ℂ := (((2 : ℝ) ^ m : ℝ) : ℂ) * monoKPhi ((2 : ℝ) ^ m * s)

/-- The Hardy-Littlewood maximal function in the coordinate `ℓ` of `ℝ^2`. -/
def cMax (ℓ : Fin 2) (g : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℝ :=
  hlMax (monoFib ℓ g (monoPas ℓ z)) (monoAct ℓ z)

theorem cMax_nonneg (ℓ : Fin 2) (g : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : 0 ≤ cMax ℓ g z :=
  shiftedMaximal_nonneg _ _ _

theorem lpS_apply (ℓ : Fin 2) (m : ℤ) (g : ℝ × ℝ → ℂ) (a p : ℝ) :
    lpS ℓ m g (monoPt ℓ a p) = ∫ s, kS m s * monoFib ℓ g p (a - s) := by
  unfold lpS monoP monoCConv
  refine integral_congr_ae (Eventually.of_forall fun s => ?_)
  simp only [kS, monoFib, monoPt_sub_E]

theorem monoPt_act_pas' (ℓ : Fin 2) (z : ℝ × ℝ) : z = monoPt ℓ (monoAct ℓ z) (monoPas ℓ z) :=
  (monoPt_act_pas ℓ z).symm

/-- The decay `|κ(u)| ≤ C (1+|u|)^{-2}` of `κ = φ̌`. -/
theorem kS_decay : ∃ C : ℝ, 0 ≤ C ∧ ∀ (m : ℤ) (u : ℝ),
    ‖kS m u‖ ≤ C * 2 ^ m / (1 + 2 ^ m * |u|) ^ 2 := by
  obtain ⟨C, hC, hb⟩ := mono_schwartz_decay_two monoKPhi
  refine ⟨C, hC, fun m u => ?_⟩
  have hm : (0 : ℝ) < 2 ^ m := by positivity
  rw [kS, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hm]
  have := hb ((2 : ℝ) ^ m * u)
  rw [abs_mul, abs_of_pos hm] at this
  calc (2 : ℝ) ^ m * ‖monoKPhi ((2 : ℝ) ^ m * u)‖ ≤ 2 ^ m * (C / (1 + 2 ^ m * |u|) ^ 2) :=
        mul_le_mul_of_nonneg_left this hm.le
    _ = C * 2 ^ m / (1 + 2 ^ m * |u|) ^ 2 := by ring

/-- The shifted kernel bound: `A L (1 + L|u + τ|)^{-2} ≤ (1 + L|τ|)^2 A L (1 + L|u|)^{-2}`. -/
theorem kernel_shift_le {A : ℝ} (hA : 0 ≤ A) (m : ℤ) (τ u : ℝ) :
    A * 2 ^ m / (1 + 2 ^ m * |u + τ|) ^ 2 ≤
      (A * (1 + 2 ^ m * |τ|) ^ 2) * 2 ^ m / (1 + 2 ^ m * |u|) ^ 2 := by
  have hm : (0 : ℝ) < 2 ^ m := by positivity
  have h1 : 1 + 2 ^ m * |u| ≤ (1 + 2 ^ m * |τ|) * (1 + 2 ^ m * |u + τ|) := by
    have := abs_sub_abs_le_abs_sub u (-τ)
    rw [sub_neg_eq_add, abs_neg] at this
    nlinarith [abs_nonneg τ, abs_nonneg (u + τ), mul_nonneg hm.le (abs_nonneg τ),
      mul_nonneg hm.le (abs_nonneg (u + τ))]
  rw [div_le_div_iff₀ (by positivity) (by positivity)]
  have h2 : (1 + 2 ^ m * |u|) ^ 2 ≤ ((1 + 2 ^ m * |τ|) * (1 + 2 ^ m * |u + τ|)) ^ 2 :=
    pow_le_pow_left₀ (by positivity) h1 2
  have hAm : 0 ≤ A * 2 ^ m := mul_nonneg hA hm.le
  nlinarith [mul_le_mul_of_nonneg_left h2 hAm]

theorem measurable_kS (m : ℤ) : Measurable (kS m) :=
  (continuous_const.mul (monoKPhi.continuous.comp (continuous_const.mul continuous_id))).measurable

/-- **Pointwise domination of `S_m`**, with a shift: for bounded measurable `g`,
`|S^{(ℓ)}_m g(z + τ e_ℓ)| ≤ 16 C (1 + 2^m |τ|)^2 𝓜^{(ℓ)} g(z)`. -/
theorem norm_lpS_shift_le : ∃ C : ℝ, 0 ≤ C ∧ ∀ (ℓ : Fin 2) (m : ℤ) {g : ℝ × ℝ → ℂ},
    Measurable g → ∀ {M : ℝ}, (∀ z, ‖g z‖ ≤ M) → ∀ (a p τ : ℝ),
    ‖lpS ℓ m g (monoPt ℓ (a + τ) p)‖ ≤
      16 * (C * (1 + 2 ^ m * |τ|) ^ 2) * cMax ℓ g (monoPt ℓ a p) := by
  obtain ⟨C, hC, hdec⟩ := kS_decay
  refine ⟨C, hC, fun ℓ m g hg M hM a p τ => ?_⟩
  have hF : Measurable (monoFib ℓ g p) := measurable_monoFib hg p
  have hFb : ∀ x, ‖monoFib ℓ g p x‖ ≤ M := fun x => hM _
  rw [lpS_apply]
  have e : ∫ s, kS m s * monoFib ℓ g p (a + τ - s) = ∫ s, kS m (s + τ) * monoFib ℓ g p (a - s) := by
    rw [← integral_add_right_eq_self (μ := volume) (fun s => kS m s * monoFib ℓ g p (a + τ - s)) τ]
    congr 1; ext s; congr 2; ring
  rw [e]
  have hK : ∀ u, ‖kS m (u + τ)‖ ≤ (C * (1 + 2 ^ m * |τ|) ^ 2) * 2 ^ m / (1 + 2 ^ m * |u|) ^ 2 :=
    fun u => (hdec m (u + τ)).trans (kernel_shift_le hC m τ u)
  have hL := lintegral_kernel_le_hlMax (by positivity) m hK hF hFb a
  have hc : cMax ℓ g (monoPt ℓ a p) = hlMax (monoFib ℓ g p) a := by
    simp only [cMax, monoAct_pt, monoPas_pt]
  rw [hc]
  refine (norm_integral_le_integral_norm _).trans ?_
  rw [← ENNReal.ofReal_le_ofReal_iff (mul_nonneg (by positivity) (shiftedMaximal_nonneg _ _ _)),
    ofReal_integral_norm_eq_lintegral_enorm]
  · refine le_trans (le_of_eq ?_) hL
    refine lintegral_congr fun u => ?_
    rw [enorm_mul]
  · refine Integrable.mul_bdd (c := M) ?_
      (hF.comp (measurable_const.sub measurable_id)).aestronglyMeasurable
      (Eventually.of_forall fun u => hFb _)
    exact (integrable_kerScaled monoKPhi m).comp_add_right τ

/-- The shifted maximal function in the coordinate `ℓ` of `ℝ^2`. -/
def cShift (ℓ : Fin 2) (σ : ℝ) (g : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℝ :=
  shiftedMaximal σ (monoFib ℓ g (monoPas ℓ z)) (monoAct ℓ z)

theorem cMax_eq_cShift (ℓ : Fin 2) (g : ℝ × ℝ → ℂ) : cMax ℓ g = cShift ℓ (-1 / 2) g := rfl

theorem cShift_nonneg (ℓ : Fin 2) (σ : ℝ) (g : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : 0 ≤ cShift ℓ σ g z :=
  shiftedMaximal_nonneg _ _ _

theorem cShift_le_of_bound (ℓ : Fin 2) (σ : ℝ) {g : ℝ × ℝ → ℂ} {M : ℝ} (hM : ∀ z, ‖g z‖ ≤ M)
    (z : ℝ × ℝ) : cShift ℓ σ g z ≤ M :=
  (shiftedMaximal_le_of_bound σ (fun _ => hM _) _).2

theorem measurable_monoAct (ℓ : Fin 2) : Measurable (monoAct ℓ) := by
  unfold monoAct
  by_cases h : ℓ = 0 <;> simp only [h, if_true, if_false] <;> fun_prop

theorem measurable_monoPas (ℓ : Fin 2) : Measurable (monoPas ℓ) := by
  unfold monoPas
  by_cases h : ℓ = 0 <;> simp only [h, if_true, if_false] <;> fun_prop

theorem measurable_cShift (ℓ : Fin 2) (σ : ℝ) {g : ℝ × ℝ → ℂ} (hg : Measurable g) :
    Measurable (cShift ℓ σ g) := by
  unfold cShift shiftedMaximal
  refine Measurable.iSup fun s => ?_
  refine measurable_const.mul ?_
  refine (StronglyMeasurable.integral_prod_right' (ν := volume.restrict
    (Icc (σ * 2 ^ s) ((σ + 1) * 2 ^ s)))
    (f := fun q : (ℝ × ℝ) × ℝ => ‖monoFib ℓ g (monoPas ℓ q.1) (monoAct ℓ q.1 + q.2)‖) ?_).measurable
  refine Measurable.stronglyMeasurable ?_
  exact (hg.comp ((measurable_monoPt ℓ).comp (((measurable_monoAct ℓ).comp measurable_fst).add
    measurable_snd |>.prodMk ((measurable_monoPas ℓ).comp measurable_fst)))).norm

/-- **`L^p` bound for the coordinate shifted maximal function**:
`∫ (𝓜^{(ℓ)}_σ g)^p ≤ C_p log(2+|σ|) ∫ |g|^p` on `ℝ^2`. -/
theorem lintegral_cShift_rpow_le (ℓ : Fin 2) (σ : ℝ) {p : ℝ} (hp : 1 < p) {g : ℝ × ℝ → ℂ}
    (hg : Measurable g) {M : ℝ} (hM : ∀ z, ‖g z‖ ≤ M) :
    ∫⁻ z, ENNReal.ofReal (cShift ℓ σ g z ^ p) ≤
      ENNReal.ofReal (shiftedMaximalLpConst p * Real.log (2 + |σ|)) *
        ∫⁻ z, ENNReal.ofReal ‖g z‖ ^ p := by
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  have hcm := measurable_cShift ℓ σ hg
  rw [lintegral_monoPt ℓ (F := fun z => ENNReal.ofReal (cShift ℓ σ g z ^ p))
      (ENNReal.measurable_ofReal.comp (hcm.pow_const p)),
    lintegral_monoPt ℓ (F := fun z => ENNReal.ofReal ‖g z‖ ^ p)
      ((ENNReal.measurable_ofReal.comp hg.norm).pow_const p),
    ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine lintegral_mono fun q => ?_
  have h := shiftedMaximal_lintegral_rpow_le σ hp (measurable_monoFib (j := ℓ) hg q)
    ⟨M, hM0, fun _ => hM _⟩
  simp only [cShift, monoAct_pt, monoPas_pt]
  exact h

theorem eLpNorm_cShift_le (ℓ : Fin 2) (σ : ℝ) {p : ℝ} (hp : 1 < p) {g : ℝ × ℝ → ℂ}
    (hg : Measurable g) {M : ℝ} (hM : ∀ z, ‖g z‖ ≤ M) :
    eLpNorm (cShift ℓ σ g) (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal ((shiftedMaximalLpConst p * Real.log (2 + |σ|)) ^ (1 / p)) *
        eLpNorm g (ENNReal.ofReal p) volume := by
  have hp0 : 0 < p := by linarith
  have hC : 0 ≤ shiftedMaximalLpConst p * Real.log (2 + |σ|) :=
    mul_nonneg (shiftedMaximalLpConst_pos hp).le (Real.log_nonneg (by linarith [abs_nonneg σ]))
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simp [hp0]) ENNReal.ofReal_ne_top,
    eLpNorm_eq_lintegral_rpow_enorm_toReal (by simp [hp0]) ENNReal.ofReal_ne_top,
    ENNReal.toReal_ofReal hp0.le]
  have h := lintegral_cShift_rpow_le ℓ σ hp hg hM
  have e1 : ∫⁻ z, ‖cShift ℓ σ g z‖ₑ ^ p = ∫⁻ z, ENNReal.ofReal (cShift ℓ σ g z ^ p) := by
    refine lintegral_congr fun z => ?_
    rw [Real.enorm_eq_ofReal (cShift_nonneg _ _ _ _), ENNReal.ofReal_rpow_of_nonneg
      (cShift_nonneg _ _ _ _) hp0.le]
  have e2 : ∫⁻ z, ‖g z‖ₑ ^ p = ∫⁻ z, ENNReal.ofReal ‖g z‖ ^ p := by
    refine lintegral_congr fun z => ?_
    rw [← ofReal_norm]
  rw [e1, e2]
  calc (∫⁻ z, ENNReal.ofReal (cShift ℓ σ g z ^ p)) ^ (1 / p)
      ≤ (ENNReal.ofReal (shiftedMaximalLpConst p * Real.log (2 + |σ|)) *
          ∫⁻ z, ENNReal.ofReal ‖g z‖ ^ p) ^ (1 / p) :=
        ENNReal.rpow_le_rpow h (by positivity)
    _ = _ := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ENNReal.ofReal_rpow_of_nonneg hC
          (by positivity)]

/-! ### Pointwise domination of the low-frequency parts of `M_j` -/

theorem monoPsiA_le_one (x : ℝ) : monoPsiA x ≤ 1 := by
  unfold monoPsiA
  linarith [ms7_monoPhi_le_one x, ms7_monoPhi_nonneg (2 * x)]

/-- The `L^1`-normalized bump `ψ_j(t) = 2^j ψ(2^j t)` of `M_j`. -/
def psiJ (j : ℤ) (t : ℝ) : ℝ := (2 : ℝ) ^ j * monoPsiA ((2 : ℝ) ^ j * t)

theorem psiJ_nonneg (j : ℤ) (t : ℝ) : 0 ≤ psiJ j t :=
  mul_nonneg (by positivity) (monoPsiA_nonneg _)

theorem psiJ_le (j : ℤ) (t : ℝ) : psiJ j t ≤ 2 ^ j :=
  mul_le_of_le_one_right (by positivity) (monoPsiA_le_one _)

theorem psiJ_even (j : ℤ) (t : ℝ) : psiJ j (-t) = psiJ j t := by
  rw [psiJ, psiJ, mul_neg, monoPsiA_even]

theorem psiJ_eq_zero_of_le {j : ℤ} {t : ℝ} (h : 2 ≤ (2 : ℝ) ^ j * |t|) : psiJ j t = 0 := by
  have hj : (0 : ℝ) < 2 ^ j := by positivity
  rw [psiJ, monoPsiA_eq_zero_of_le_abs (by rwa [abs_mul, abs_of_pos hj]), mul_zero]

theorem psiJ_eq_zero_of_ge {j : ℤ} {t : ℝ} (h : (2 : ℝ) ^ j * |t| ≤ 1 / 2) : psiJ j t = 0 := by
  have hj : (0 : ℝ) < 2 ^ j := by positivity
  rw [psiJ, monoPsiA_eq_zero_of_abs_le (by rwa [abs_mul, abs_of_pos hj]), mul_zero]

theorem abs_lt_of_psiJ_ne {j : ℤ} {t : ℝ} (h : psiJ j t ≠ 0) : (2 : ℝ) ^ j * |t| < 2 :=
  not_le.1 fun h' => h (psiJ_eq_zero_of_le h')

theorem lt_abs_of_psiJ_ne {j : ℤ} {t : ℝ} (h : psiJ j t ≠ 0) : 1 / 2 < (2 : ℝ) ^ j * |t| :=
  not_le.1 fun h' => h (psiJ_eq_zero_of_ge h')

theorem continuous_psiJ (j : ℤ) : Continuous (psiJ j) :=
  continuous_const.mul (monoPsiA_contDiff.continuous.comp (continuous_const.mul continuous_id))

theorem integrable_psiJ (j : ℤ) : Integrable (psiJ j) :=
  integrable_dilZ monoPsiA_contDiff.continuous monoPsiA_hasCompactSupport j

theorem Mj_apply (j : ℤ) (g₁ g₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) :
    Mj j g₁ g₂ z = ∫ t, (psiJ j t : ℂ) * (g₁ (z.1 + t, z.2) * g₂ (z.1, z.2 + t ^ 2)) := by
  simp only [Mj, ms8AvgP, psiJ, pow_one]

theorem lintegral_comp_neg' (f : ℝ → ℝ≥0∞) : ∫⁻ t, f (-t) = ∫⁻ t, f t :=
  (Measure.measurePreserving_neg (volume : Measure ℝ)).lintegral_comp_emb
    (MeasurableEquiv.neg ℝ).measurableEmbedding f

theorem psiJ_kernel_bound (j : ℤ) (u : ℝ) :
    ‖((psiJ j u : ℝ) : ℂ)‖ ≤ 9 * 2 ^ j / (1 + 2 ^ j * |u|) ^ 2 := by
  have hj : (0 : ℝ) < 2 ^ j := by positivity
  rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (psiJ_nonneg j u)]
  by_cases h : psiJ j u = 0
  · rw [h]; positivity
  · have h1 := abs_lt_of_psiJ_ne h
    rw [le_div_iff₀ (by positivity)]
    have h2 : (1 + 2 ^ j * |u|) ^ 2 ≤ 9 := by nlinarith [mul_nonneg hj.le (abs_nonneg u)]
    calc psiJ j u * (1 + 2 ^ j * |u|) ^ 2 ≤ 2 ^ j * 9 :=
          mul_le_mul (psiJ_le j u) h2 (by positivity) hj.le
      _ = 9 * 2 ^ j := by ring

/-- The horizontal average: `∫ ψ_j(t) |g(x+t)| dt ≤ 144 𝓜 g(x)`. -/
theorem lintegral_psiJ_le_hlMax (j : ℤ) {g : ℝ → ℂ} (hg : Measurable g) {a : ℝ}
    (hga : ∀ x, ‖g x‖ ≤ a) (x : ℝ) :
    ∫⁻ t, ENNReal.ofReal (psiJ j t) * ‖g (x + t)‖ₑ ≤ ENNReal.ofReal (144 * hlMax g x) := by
  rw [← lintegral_comp_neg' (fun t => ENNReal.ofReal (psiJ j t) * ‖g (x + t)‖ₑ)]
  have h := lintegral_kernel_le_hlMax (K := fun u => ((psiJ j u : ℝ) : ℂ)) (by norm_num) j
    (psiJ_kernel_bound j) hg hga x
  refine le_trans (le_of_eq ?_) (h.trans (le_of_eq (by ring_nf)))
  refine lintegral_congr fun u => ?_
  rw [psiJ_even, ← sub_eq_add_neg]
  congr 1
  rw [← ofReal_norm, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (psiJ_nonneg j u)]

/-- The kernel of the parabolic average after the substitution `u = t^2`. -/
def kPar (j : ℤ) (u : ℝ) : ℝ := psiJ j (Real.sqrt u) / (2 * Real.sqrt u)

theorem kPar_nonneg (j : ℤ) (u : ℝ) : 0 ≤ kPar j u :=
  div_nonneg (psiJ_nonneg _ _) (by positivity)

theorem kPar_bound (j : ℤ) (u : ℝ) :
    ‖((kPar j u : ℝ) : ℂ)‖ ≤ 25 * 2 ^ (2 * j) / (1 + 2 ^ (2 * j) * |u|) ^ 2 := by
  have hj : (0 : ℝ) < 2 ^ j := by positivity
  have e2 : (2 : ℝ) ^ (2 * j) = (2 ^ j) ^ 2 := by
    rw [mul_comm, zpow_mul]; norm_cast
  rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (kPar_nonneg j u), e2]
  by_cases h : psiJ j (Real.sqrt u) = 0
  · rw [kPar, h, zero_div]; positivity
  · have h1 := abs_lt_of_psiJ_ne h
    have h2 := lt_abs_of_psiJ_ne h
    rw [abs_of_nonneg (Real.sqrt_nonneg u)] at h1 h2
    have hs : 0 < Real.sqrt u := by
      by_contra hc; push Not at hc
      have : Real.sqrt u = 0 := le_antisymm hc (Real.sqrt_nonneg u)
      rw [this, mul_zero] at h2; norm_num at h2
    have hu : 0 < u := Real.sqrt_pos.1 hs
    have hsq : Real.sqrt u ^ 2 = u := Real.sq_sqrt hu.le
    have hu4 : (2 ^ j) ^ 2 * |u| < 4 := by
      rw [abs_of_pos hu, ← hsq]; nlinarith
    have hk : kPar j u ≤ (2 ^ j) ^ 2 := by
      rw [kPar, div_le_iff₀ (by positivity)]
      have := psiJ_le j (Real.sqrt u)
      nlinarith
    rw [le_div_iff₀ (by positivity)]
    have h3 : (1 + (2 ^ j) ^ 2 * |u|) ^ 2 ≤ 25 := by
      nlinarith [mul_nonneg (pow_nonneg hj.le 2) (abs_nonneg u)]
    calc kPar j u * (1 + (2 ^ j) ^ 2 * |u|) ^ 2 ≤ (2 ^ j) ^ 2 * 25 :=
          mul_le_mul hk h3 (by positivity) (by positivity)
      _ = 25 * (2 ^ j) ^ 2 := by ring

theorem measurable_kPar (j : ℤ) : Measurable (kPar j) :=
  ((continuous_psiJ j).measurable.comp Real.continuous_sqrt.measurable).div
    (measurable_const.mul Real.continuous_sqrt.measurable)

/-- The parabolic average: `∫ ψ_j(t) |g(y+t^2)| dt ≤ 800 𝓜 g(y)`. -/
theorem lintegral_psiJ_par_le_hlMax (j : ℤ) {g : ℝ → ℂ} (hg : Measurable g) {a : ℝ}
    (hga : ∀ x, ‖g x‖ ≤ a) (y : ℝ) :
    ∫⁻ t, ENNReal.ofReal (psiJ j t) * ‖g (y + t ^ 2)‖ₑ ≤ ENNReal.ofReal (800 * hlMax g y) := by
  set F : ℝ → ℝ≥0∞ := fun t => ENNReal.ofReal (psiJ j t) * ‖g (y + t ^ 2)‖ₑ with hF
  have hFm : Measurable F :=
    (ENNReal.measurable_ofReal.comp (continuous_psiJ j).measurable).mul
      (hg.comp (measurable_const.add (measurable_id.pow_const 2))).enorm
  have hFe : ∀ t, F (-t) = F t := fun t => by simp only [hF, psiJ_even, neg_sq]
  -- the half-line integral after the substitution `u = t^2`
  have hhalf : ∫⁻ t in Ioi 0, F t ≤ ENNReal.ofReal (400 * hlMax g y) := by
    have hsub := lintegral_image_eq_lintegral_abs_deriv_mul (s := Ioi (0 : ℝ))
      (f := fun t => t ^ 2) (f' := fun t => 2 * t) measurableSet_Ioi
      (fun t _ => by simpa using (hasDerivAt_pow 2 t).hasDerivWithinAt)
      (fun a ha b hb hab => (pow_left_inj₀ (le_of_lt ha) (le_of_lt hb) two_ne_zero).1 hab)
      (fun u => ENNReal.ofReal (kPar j u) * ‖g (y + u)‖ₑ)
    have e : ∫⁻ t in Ioi 0, F t = ∫⁻ t in Ioi 0, ENNReal.ofReal |2 * t| *
        (ENNReal.ofReal (kPar j (t ^ 2)) * ‖g (y + t ^ 2)‖ₑ) := by
      refine setLIntegral_congr_fun measurableSet_Ioi fun t ht => ?_
      have ht0 : 0 < t := ht
      simp only [hF]
      have hk : psiJ j t = |2 * t| * kPar j (t ^ 2) := by
        rw [kPar, Real.sqrt_sq ht0.le, abs_of_pos (by positivity : 0 < 2 * t)]
        field_simp
      rw [hk, ENNReal.ofReal_mul (abs_nonneg _), mul_assoc]
    rw [e, ← hsub]
    refine (setLIntegral_le_lintegral _ _).trans ?_
    rw [← lintegral_comp_neg' (fun u => ENNReal.ofReal (kPar j u) * ‖g (y + u)‖ₑ)]
    have h := lintegral_kernel_le_hlMax (K := fun u => ((kPar j (-u) : ℝ) : ℂ)) (A := 25)
      (by norm_num)
      (2 * j) (fun u => by simpa [abs_neg] using kPar_bound j (-u)) hg hga y
    refine le_trans (le_of_eq ?_) (h.trans (le_of_eq (by ring_nf)))
    refine lintegral_congr fun u => ?_
    rw [← sub_eq_add_neg]
    congr 1
    rw [← ofReal_norm, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (kPar_nonneg j _)]
  have hsplit : ∫⁻ t, F t ≤ (∫⁻ t in Iic 0, F t) + ∫⁻ t in Ioi 0, F t := by
    rw [← lintegral_union measurableSet_Ioi (Set.disjoint_left.2 fun t h1 h2 =>
      absurd (mem_Ioi.1 h2) (not_lt.2 (mem_Iic.1 h1))), Iic_union_Ioi, Measure.restrict_univ]
  have hneg : ∫⁻ t in Iic 0, F t ≤ ∫⁻ t in Ioi 0, F t := by
    have h0 : ∫⁻ t in Iic 0, F t = ∫⁻ t in Iio 0, F t :=
      setLIntegral_congr Iio_ae_eq_Iic.symm
    rw [h0, ← lintegral_indicator measurableSet_Iio, ← lintegral_indicator measurableSet_Ioi,
      ← lintegral_comp_neg' ((Ioi (0 : ℝ)).indicator F)]
    refine lintegral_mono fun t => le_of_eq ?_
    by_cases ht : t < 0
    · rw [indicator_of_mem (mem_Iio.2 ht), indicator_of_mem (mem_Ioi.2 (neg_pos.2 ht)), hFe]
    · rw [indicator_of_notMem (fun h => ht (mem_Iio.1 h)),
        indicator_of_notMem (fun h => ht (neg_pos.1 (mem_Ioi.1 h)))]
  calc ∫⁻ t, F t ≤ (∫⁻ t in Ioi 0, F t) + ∫⁻ t in Ioi 0, F t :=
        hsplit.trans (add_le_add_left hneg _)
    _ ≤ ENNReal.ofReal (400 * hlMax g y) + ENNReal.ofReal (400 * hlMax g y) :=
        add_le_add hhalf hhalf
    _ = ENNReal.ofReal (800 * hlMax g y) := by
        rw [← ENNReal.ofReal_add (by positivity [shiftedMaximal_nonneg (-1/2) g y])
          (by positivity [shiftedMaximal_nonneg (-1/2) g y])]; ring_nf

theorem lintegral_psiJ_le (j : ℤ) : ∫⁻ t, ENNReal.ofReal (psiJ j t) ≤ 4 := by
  have hj : (0 : ℝ) < 2 ^ j := by positivity
  have h : ∀ t, ENNReal.ofReal (psiJ j t) ≤ (Icc (-(2 * 2 ^ (-j) : ℝ)) (2 * 2 ^ (-j))).indicator
      (fun _ => ENNReal.ofReal (2 ^ j)) t := by
    intro t
    by_cases h0 : psiJ j t = 0
    · rw [h0, ENNReal.ofReal_zero]; exact bot_le
    · have h1 := abs_lt_of_psiJ_ne h0
      have ht : |t| ≤ 2 * 2 ^ (-j) := by
        rw [zpow_neg, ← div_eq_mul_inv, le_div_iff₀ hj]; linarith
      rw [indicator_of_mem (mem_Icc.2 (abs_le.1 ht))]
      exact ENNReal.ofReal_le_ofReal (psiJ_le j t)
  refine (lintegral_mono h).trans ?_
  rw [lintegral_indicator_const measurableSet_Icc, Real.volume_Icc, ← ENNReal.ofReal_mul hj.le]
  refine le_of_eq ?_
  rw [show 2 * 2 ^ (-j) - -(2 * 2 ^ (-j)) = 4 * (2 : ℝ) ^ (-j) by ring, ← mul_assoc,
    mul_comm _ (4 : ℝ), mul_assoc, ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), add_neg_cancel,
    zpow_zero, mul_one]
  norm_num

theorem integrable_Mj_integrand (j : ℤ) {g₁ g₂ : ℝ × ℝ → ℂ} (h₁ : Measurable g₁)
    (h₂ : Measurable g₂) {M₁ M₂ : ℝ} (hM₁ : ∀ z, ‖g₁ z‖ ≤ M₁) (hM₂ : ∀ z, ‖g₂ z‖ ≤ M₂)
    (z : ℝ × ℝ) :
    Integrable fun t => (psiJ j t : ℂ) * (g₁ (z.1 + t, z.2) * g₂ (z.1, z.2 + t ^ 2)) := by
  refine Integrable.mul_bdd (c := M₁ * M₂) (integrable_psiJ j).ofReal ?_
    (Eventually.of_forall fun t => ?_)
  · exact ((h₁.comp ((measurable_const.add measurable_id).prodMk measurable_const)).mul
      (h₂.comp (measurable_const.prodMk (measurable_const.add
        (measurable_id.pow_const 2))))).aestronglyMeasurable
  · rw [norm_mul]
    exact mul_le_mul (hM₁ _) (hM₂ _) (norm_nonneg _) ((norm_nonneg _).trans (hM₁ 0))

theorem Mj_sub_left (j : ℤ) {g₁ g₁' g₂ : ℝ × ℝ → ℂ} (h₁ : Measurable g₁) (h₁' : Measurable g₁')
    (h₂ : Measurable g₂) {M₁ M₁' M₂ : ℝ} (hM₁ : ∀ z, ‖g₁ z‖ ≤ M₁) (hM₁' : ∀ z, ‖g₁' z‖ ≤ M₁')
    (hM₂ : ∀ z, ‖g₂ z‖ ≤ M₂) (z : ℝ × ℝ) :
    Mj j (g₁ - g₁') g₂ z = Mj j g₁ g₂ z - Mj j g₁' g₂ z := by
  rw [Mj_apply, Mj_apply, Mj_apply, ← integral_sub (integrable_Mj_integrand j h₁ h₂ hM₁ hM₂ z)
    (integrable_Mj_integrand j h₁' h₂ hM₁' hM₂ z)]
  congr 1; ext t; simp only [Pi.sub_apply]; ring

theorem Mj_sub_right (j : ℤ) {g₁ g₂ g₂' : ℝ × ℝ → ℂ} (h₁ : Measurable g₁) (h₂ : Measurable g₂)
    (h₂' : Measurable g₂') {M₁ M₂ M₂' : ℝ} (hM₁ : ∀ z, ‖g₁ z‖ ≤ M₁) (hM₂ : ∀ z, ‖g₂ z‖ ≤ M₂)
    (hM₂' : ∀ z, ‖g₂' z‖ ≤ M₂') (z : ℝ × ℝ) :
    Mj j g₁ (g₂ - g₂') z = Mj j g₁ g₂ z - Mj j g₁ g₂' z := by
  rw [Mj_apply, Mj_apply, Mj_apply, ← integral_sub (integrable_Mj_integrand j h₁ h₂ hM₁ hM₂ z)
    (integrable_Mj_integrand j h₁ h₂' hM₁ hM₂' z)]
  congr 1; ext t; simp only [Pi.sub_apply]; ring

theorem enorm_ofReal_psiJ (j : ℤ) (t : ℝ) :
    ‖((psiJ j t : ℝ) : ℂ)‖ₑ = ENNReal.ofReal (psiJ j t) := by
  rw [← ofReal_norm, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (psiJ_nonneg j t)]

theorem enorm_le_ofReal {x : ℂ} {β : ℝ} (h : ‖x‖ ≤ β) : ‖x‖ₑ ≤ ENNReal.ofReal β := by
  rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal h

theorem cMax_zero_eq (g : ℝ × ℝ → ℂ) (z : ℝ × ℝ) :
    cMax 0 g z = hlMax (fun s => g (s, z.2)) z.1 := by
  simp only [cMax, monoAct, monoPas, if_true]; rfl

theorem cMax_one_eq (g : ℝ × ℝ → ℂ) (z : ℝ × ℝ) :
    cMax 1 g z = hlMax (fun s => g (z.1, s)) z.2 := by
  simp only [cMax, monoAct, monoPas, one_ne_zero, if_false]; rfl

/-- `|M_j(g_1,g_2)| ≤ β · 144 𝓜^{(1)} g_1` if `|g_2| ≤ β` along the parabola. -/
theorem enorm_Mj_le_of_right (j : ℤ) {g₁ g₂ : ℝ × ℝ → ℂ} (h₁ : Measurable g₁) {a : ℝ}
    (ha : ∀ z, ‖g₁ z‖ ≤ a) (z : ℝ × ℝ) {β : ℝ}
    (hβ : ∀ t, psiJ j t ≠ 0 → ‖g₂ (z.1, z.2 + t ^ 2)‖ ≤ β) :
    ‖Mj j g₁ g₂ z‖ₑ ≤ ENNReal.ofReal β * ENNReal.ofReal (144 * cMax 0 g₁ z) := by
  rw [Mj_apply]
  refine (enorm_integral_le_lintegral_enorm _).trans ?_
  have hg : Measurable fun s => g₁ (s, z.2) := h₁.comp (measurable_id.prodMk measurable_const)
  have h := lintegral_psiJ_le_hlMax j hg (fun s => ha _) z.1
  rw [cMax_zero_eq]
  calc ∫⁻ t, ‖(psiJ j t : ℂ) * (g₁ (z.1 + t, z.2) * g₂ (z.1, z.2 + t ^ 2))‖ₑ
      ≤ ∫⁻ t, ENNReal.ofReal β * (ENNReal.ofReal (psiJ j t) * ‖g₁ (z.1 + t, z.2)‖ₑ) := by
        refine lintegral_mono fun t => ?_
        by_cases h0 : psiJ j t = 0
        · simp [h0]
        rw [enorm_mul, enorm_mul, enorm_ofReal_psiJ]
        have h2 := enorm_le_ofReal (hβ t h0)
        calc ENNReal.ofReal (psiJ j t) * (‖g₁ (z.1 + t, z.2)‖ₑ * ‖g₂ (z.1, z.2 + t ^ 2)‖ₑ)
            = ENNReal.ofReal (psiJ j t) * ‖g₁ (z.1 + t, z.2)‖ₑ * ‖g₂ (z.1, z.2 + t ^ 2)‖ₑ := by
              ring
          _ ≤ ENNReal.ofReal (psiJ j t) * ‖g₁ (z.1 + t, z.2)‖ₑ * ENNReal.ofReal β := by gcongr
          _ = _ := by ring
    _ = ENNReal.ofReal β * ∫⁻ t, ENNReal.ofReal (psiJ j t) * ‖g₁ (z.1 + t, z.2)‖ₑ :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
    _ ≤ _ := by gcongr

/-- `|M_j(g_1,g_2)| ≤ α · 800 𝓜^{(2)} g_2` if `|g_1| ≤ α` along the horizontal segment. -/
theorem enorm_Mj_le_of_left (j : ℤ) {g₁ g₂ : ℝ × ℝ → ℂ} (h₂ : Measurable g₂) {b : ℝ}
    (hb : ∀ z, ‖g₂ z‖ ≤ b) (z : ℝ × ℝ) {α : ℝ}
    (hα : ∀ t, psiJ j t ≠ 0 → ‖g₁ (z.1 + t, z.2)‖ ≤ α) :
    ‖Mj j g₁ g₂ z‖ₑ ≤ ENNReal.ofReal α * ENNReal.ofReal (800 * cMax 1 g₂ z) := by
  rw [Mj_apply]
  refine (enorm_integral_le_lintegral_enorm _).trans ?_
  have hg : Measurable fun s => g₂ (z.1, s) := h₂.comp (measurable_const.prodMk measurable_id)
  have h := lintegral_psiJ_par_le_hlMax j hg (fun s => hb _) z.2
  rw [cMax_one_eq]
  calc ∫⁻ t, ‖(psiJ j t : ℂ) * (g₁ (z.1 + t, z.2) * g₂ (z.1, z.2 + t ^ 2))‖ₑ
      ≤ ∫⁻ t, ENNReal.ofReal α * (ENNReal.ofReal (psiJ j t) * ‖g₂ (z.1, z.2 + t ^ 2)‖ₑ) := by
        refine lintegral_mono fun t => ?_
        by_cases h0 : psiJ j t = 0
        · simp [h0]
        rw [enorm_mul, enorm_mul, enorm_ofReal_psiJ]
        have h2 := enorm_le_ofReal (hα t h0)
        calc ENNReal.ofReal (psiJ j t) * (‖g₁ (z.1 + t, z.2)‖ₑ * ‖g₂ (z.1, z.2 + t ^ 2)‖ₑ)
            = ‖g₁ (z.1 + t, z.2)‖ₑ * (ENNReal.ofReal (psiJ j t) * ‖g₂ (z.1, z.2 + t ^ 2)‖ₑ) := by
              ring
          _ ≤ ENNReal.ofReal α * (ENNReal.ofReal (psiJ j t) * ‖g₂ (z.1, z.2 + t ^ 2)‖ₑ) := by
              gcongr
    _ = ENNReal.ofReal α * ∫⁻ t, ENNReal.ofReal (psiJ j t) * ‖g₂ (z.1, z.2 + t ^ 2)‖ₑ :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
    _ ≤ _ := by gcongr

/-- `|M_j(g_1,g_2)| ≤ 4 α β` if `|g_1| ≤ α` and `|g_2| ≤ β` along the curves. -/
theorem enorm_Mj_le_of_both (j : ℤ) {g₁ g₂ : ℝ × ℝ → ℂ} (z : ℝ × ℝ) {α β : ℝ} (hα0 : 0 ≤ α)
    (hβ0 : 0 ≤ β) (hα : ∀ t, psiJ j t ≠ 0 → ‖g₁ (z.1 + t, z.2)‖ ≤ α)
    (hβ : ∀ t, psiJ j t ≠ 0 → ‖g₂ (z.1, z.2 + t ^ 2)‖ ≤ β) :
    ‖Mj j g₁ g₂ z‖ₑ ≤ ENNReal.ofReal (4 * α * β) := by
  rw [Mj_apply]
  refine (enorm_integral_le_lintegral_enorm _).trans ?_
  calc ∫⁻ t, ‖(psiJ j t : ℂ) * (g₁ (z.1 + t, z.2) * g₂ (z.1, z.2 + t ^ 2))‖ₑ
      ≤ ∫⁻ t, ENNReal.ofReal (α * β) * ENNReal.ofReal (psiJ j t) := by
        refine lintegral_mono fun t => ?_
        by_cases h0 : psiJ j t = 0
        · simp [h0]
        rw [enorm_mul, enorm_mul, enorm_ofReal_psiJ, ENNReal.ofReal_mul hα0]
        have h1 := enorm_le_ofReal (hα t h0)
        have h2 := enorm_le_ofReal (hβ t h0)
        calc ENNReal.ofReal (psiJ j t) * (‖g₁ (z.1 + t, z.2)‖ₑ * ‖g₂ (z.1, z.2 + t ^ 2)‖ₑ)
            ≤ ENNReal.ofReal (psiJ j t) * (ENNReal.ofReal α * ENNReal.ofReal β) := by gcongr
          _ = _ := by ring
    _ = ENNReal.ofReal (α * β) * ∫⁻ t, ENNReal.ofReal (psiJ j t) :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
    _ ≤ ENNReal.ofReal (α * β) * 4 := by gcongr; exact lintegral_psiJ_le j
    _ = _ := by
        rw [← ENNReal.ofReal_ofNat 4, ← ENNReal.ofReal_mul (by positivity)]; ring_nf

/-- **The low-frequency part of `M_j`**: `M_j(a,b) - M_j(a - S_j a, b - S_{2j} b)` is dominated
by `𝓜^{(1)} a · 𝓜^{(2)} b`. -/
theorem lowPart_bound : ∃ C : ℝ, 0 ≤ C ∧ ∀ (j : ℤ) {a b : ℝ × ℝ → ℂ}, Measurable a →
    Measurable b → ∀ {A B : ℝ}, (∀ z, ‖a z‖ ≤ A) → (∀ z, ‖b z‖ ≤ B) → ∀ z,
    ‖Mj j a b z - Mj j (a - lpS 0 j a) (b - lpS 1 (2 * j) b) z‖ₑ ≤
      ENNReal.ofReal (C * (cMax 0 a z * cMax 1 b z)) := by
  obtain ⟨C, hC, hS⟩ := norm_lpS_shift_le
  refine ⟨400 * C * 144 + 144 * C * 800 + 4 * (144 * C) * (400 * C), by positivity,
    fun j a b ha hb A B hA hB z => ?_⟩
  have hj : (0 : ℝ) < 2 ^ j := by positivity
  set Sa := lpS 0 j a
  set Sb := lpS 1 (2 * j) b
  have hSa : Measurable Sa := measurable_lpS 0 j ha
  have hSb : Measurable Sb := measurable_lpS 1 (2 * j) hb
  have hSaB : ∀ z, ‖Sa z‖ ≤ (∫ s, ‖monoKPhi s‖) * A := norm_lpS_le 0 j hA
  have hSbB : ∀ z, ‖Sb z‖ ≤ (∫ s, ‖monoKPhi s‖) * B := norm_lpS_le 1 (2 * j) hB
  have hc0 := cMax_nonneg 0 a z
  have hc1 := cMax_nonneg 1 b z
  have hα : ∀ t, psiJ j t ≠ 0 → ‖Sa (z.1 + t, z.2)‖ ≤ 144 * C * cMax 0 a z := by
    intro t ht
    have h1 := abs_lt_of_psiJ_ne ht
    have h := hS 0 j ha hA z.1 z.2 t
    have e1 : monoPt 0 (z.1 + t) z.2 = (z.1 + t, z.2) := by simp [monoPt]
    have e2 : monoPt 0 z.1 z.2 = z := by simp [monoPt]
    rw [e1, e2] at h
    refine h.trans ?_
    have : (1 + 2 ^ j * |t|) ^ 2 ≤ 9 := by nlinarith [mul_nonneg hj.le (abs_nonneg t)]
    calc 16 * (C * (1 + 2 ^ j * |t|) ^ 2) * cMax 0 a z ≤ 16 * (C * 9) * cMax 0 a z := by
          gcongr
      _ = 144 * C * cMax 0 a z := by ring
  have hβ : ∀ t, psiJ j t ≠ 0 → ‖Sb (z.1, z.2 + t ^ 2)‖ ≤ 400 * C * cMax 1 b z := by
    intro t ht
    have h1 := abs_lt_of_psiJ_ne ht
    have h := hS 1 (2 * j) hb hB z.2 z.1 (t ^ 2)
    have e1 : monoPt 1 (z.2 + t ^ 2) z.1 = (z.1, z.2 + t ^ 2) := by simp [monoPt]
    have e2 : monoPt 1 z.2 z.1 = z := by simp [monoPt]
    rw [e1, e2] at h
    refine h.trans ?_
    have e3 : (2 : ℝ) ^ (2 * j) * |t ^ 2| = (2 ^ j * |t|) ^ 2 := by
      rw [mul_comm 2 j, zpow_mul, abs_pow]; norm_cast; ring
    rw [e3]
    have h0 : 0 ≤ 2 ^ j * |t| := mul_nonneg hj.le (abs_nonneg t)
    have hx : (2 ^ j * |t|) ^ 2 ≤ 4 := by nlinarith
    have : (1 + (2 ^ j * |t|) ^ 2) ^ 2 ≤ 25 := by nlinarith
    calc 16 * (C * (1 + (2 ^ j * |t|) ^ 2) ^ 2) * cMax 1 b z ≤ 16 * (C * 25) * cMax 1 b z := by
          gcongr
      _ = 400 * C * cMax 1 b z := by ring
  have hsplit : Mj j a b z - Mj j (a - Sa) (b - Sb) z =
      Mj j a Sb z + Mj j Sa b z - Mj j Sa Sb z := by
    rw [Mj_sub_left j ha hSa (hb.sub hSb) hA hSaB (fun z => (norm_sub_le _ _).trans
      (add_le_add (hB z) (hSbB z))), Mj_sub_right j ha hb hSb hA hB hSbB,
      Mj_sub_right j hSa hb hSb hSaB hB hSbB]
    ring
  rw [hsplit]
  have e1 := enorm_Mj_le_of_right j ha hA z hβ
  have e2 := enorm_Mj_le_of_left j hb hB z hα
  have e3 := enorm_Mj_le_of_both j z (by positivity) (by positivity) hα hβ
  calc ‖Mj j a Sb z + Mj j Sa b z - Mj j Sa Sb z‖ₑ
      ≤ ‖Mj j a Sb z‖ₑ + ‖Mj j Sa b z‖ₑ + ‖Mj j Sa Sb z‖ₑ :=
        enorm_sub_le.trans (add_le_add_left (enorm_add_le _ _) _)
    _ ≤ ENNReal.ofReal (400 * C * cMax 1 b z) * ENNReal.ofReal (144 * cMax 0 a z) +
        ENNReal.ofReal (144 * C * cMax 0 a z) * ENNReal.ofReal (800 * cMax 1 b z) +
        ENNReal.ofReal (4 * (144 * C * cMax 0 a z) * (400 * C * cMax 1 b z)) := by
        gcongr
    _ = _ := by
        rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_add (by positivity) (by positivity),
          ← ENNReal.ofReal_add (by positivity) (by positivity)]
        congr 1; ring

/-! ### Domination of the high-frequency pieces by shifted maximal functions
(`lem:shiftedmaxfct`, carried out directly at the scale `2^{-j}`) -/

theorem schwartz_decay_four (f : 𝓢(ℝ, ℂ)) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ u, ‖f u‖ ≤ C / (1 + |u|) ^ 4 := by
  set C : ℝ := 2 ^ 4 *
    (Finset.Iic ((4 : ℕ), (0 : ℕ))).sup (fun m => SchwartzMap.seminorm ℝ m.1 m.2) f
  refine ⟨C, by positivity, fun u => ?_⟩
  have h := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := ((4 : ℕ), (0 : ℕ)))
    (k := 4) (n := 0) le_rfl le_rfl f u
  rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at h
  rw [le_div_iff₀ (by positivity), mul_comm]
  exact h

/-- The kernel `2^m κ̌(2^m s) - 2^{m-1} κ̌(2^{m-1} s)` of `Δ_m`. -/
def kDel (m : ℤ) (s : ℝ) : ℂ := kS m s - kS (m - 1) s

theorem kDel_decay : ∃ C : ℝ, 0 ≤ C ∧ ∀ (m : ℤ) (u : ℝ),
    ‖kDel m u‖ ≤ C * 2 ^ m / (1 + 2 ^ m * |u|) ^ 4 := by
  obtain ⟨C, hC, hb⟩ := schwartz_decay_four monoKPhi
  have hk : ∀ (m : ℤ) (u : ℝ), ‖kS m u‖ ≤ C * 2 ^ m / (1 + 2 ^ m * |u|) ^ 4 := by
    intro m u
    have hm : (0 : ℝ) < 2 ^ m := by positivity
    rw [kS, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hm]
    have := hb ((2 : ℝ) ^ m * u)
    rw [abs_mul, abs_of_pos hm] at this
    calc (2 : ℝ) ^ m * ‖monoKPhi ((2 : ℝ) ^ m * u)‖ ≤ 2 ^ m * (C / (1 + 2 ^ m * |u|) ^ 4) :=
          mul_le_mul_of_nonneg_left this hm.le
      _ = C * 2 ^ m / (1 + 2 ^ m * |u|) ^ 4 := by ring
  refine ⟨9 * C, by positivity, fun m u => ?_⟩
  have hm : (0 : ℝ) < 2 ^ m := by positivity
  have e : (2 : ℝ) ^ (m - 1) = 2 ^ m / 2 := by
    rw [zpow_sub₀ (by norm_num), zpow_one]
  have h1 := hk m u
  have h2 := hk (m - 1) u
  rw [e] at h2
  have hu : 0 ≤ 2 ^ m * |u| := mul_nonneg hm.le (abs_nonneg u)
  have h3 : C * (2 ^ m / 2) / (1 + 2 ^ m / 2 * |u|) ^ 4 ≤
      8 * C * 2 ^ m / (1 + 2 ^ m * |u|) ^ 4 := by
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    have h4 : (1 + 2 ^ m * |u|) ^ 4 ≤ 16 * (1 + 2 ^ m / 2 * |u|) ^ 4 := by
      have h5 : 1 + 2 ^ m * |u| ≤ 2 * (1 + 2 ^ m / 2 * |u|) := by nlinarith
      calc (1 + 2 ^ m * |u|) ^ 4 ≤ (2 * (1 + 2 ^ m / 2 * |u|)) ^ 4 :=
            pow_le_pow_left₀ (by positivity) h5 4
        _ = 16 * (1 + 2 ^ m / 2 * |u|) ^ 4 := by ring
    have hC2 : 0 ≤ C * (2 ^ m / 2) := by positivity
    nlinarith [mul_le_mul_of_nonneg_left h4 hC2]
  calc ‖kDel m u‖ ≤ ‖kS m u‖ + ‖kS (m - 1) u‖ := norm_sub_le _ _
    _ ≤ C * 2 ^ m / (1 + 2 ^ m * |u|) ^ 4 + 8 * C * 2 ^ m / (1 + 2 ^ m * |u|) ^ 4 :=
        add_le_add h1 (h2.trans h3)
    _ = 9 * C * 2 ^ m / (1 + 2 ^ m * |u|) ^ 4 := by ring

/-- The cell bound: on `2^m s ∈ [n, n+1]`, `|kDel m s| ≤ 16 C 2^m (1 + |n|)^{-4}`. -/
theorem kDel_cell_le {C : ℝ} (hC : 0 ≤ C)
    (hdec : ∀ (m : ℤ) (u : ℝ), ‖kDel m u‖ ≤ C * 2 ^ m / (1 + 2 ^ m * |u|) ^ 4)
    (m : ℤ) (n : ℤ) {s : ℝ} (h1 : (n : ℝ) ≤ 2 ^ m * s) (h2 : 2 ^ m * s ≤ n + 1) :
    ‖kDel m s‖ ≤ 16 * C * 2 ^ m / (1 + |(n : ℝ)|) ^ 4 := by
  have hm : (0 : ℝ) < 2 ^ m := by positivity
  have hcell : 1 + |(n : ℝ)| ≤ 2 * (1 + 2 ^ m * |s|) := by
    have hs : 2 ^ m * |s| = |2 ^ m * s| := by rw [abs_mul, abs_of_pos hm]
    rw [hs]
    rcases le_or_gt 0 (n : ℝ) with hn | hn
    · rw [abs_of_nonneg hn]
      have : (n : ℝ) ≤ |2 ^ m * s| := h1.trans (le_abs_self _)
      linarith [abs_nonneg (2 ^ m * s)]
    · rw [abs_of_neg hn]
      have hn1 : (n : ℝ) + 1 ≤ 0 := by
        have : n < 0 := by exact_mod_cast hn
        have : n + 1 ≤ 0 := by omega
        exact_mod_cast this
      have : -((n : ℝ) + 1) ≤ |2 ^ m * s| := by
        rw [abs_of_nonpos (h2.trans hn1)]; linarith
      linarith [abs_nonneg (2 ^ m * s)]
  refine (hdec m s).trans ?_
  rw [div_le_div_iff₀ (by positivity) (by positivity)]
  have h4 : (1 + |(n : ℝ)|) ^ 4 ≤ 16 * (1 + 2 ^ m * |s|) ^ 4 := by
    calc (1 + |(n : ℝ)|) ^ 4 ≤ (2 * (1 + 2 ^ m * |s|)) ^ 4 :=
          pow_le_pow_left₀ (by positivity) hcell 4
      _ = 16 * (1 + 2 ^ m * |s|) ^ 4 := by ring
  have hCm : 0 ≤ C * 2 ^ m := by positivity
  nlinarith [mul_le_mul_of_nonneg_left h4 hCm]

theorem lpD_apply (ℓ : Fin 2) (m : ℤ) {g : ℝ × ℝ → ℂ} (hg : Measurable g) {M : ℝ}
    (hM : ∀ z, ‖g z‖ ≤ M) (a p : ℝ) :
    lpD ℓ m g (monoPt ℓ a p) = ∫ s, kDel m s * monoFib ℓ g p (a - s) := by
  have hF : Measurable (monoFib ℓ g p) := measurable_monoFib hg p
  have hi : ∀ m' : ℤ, Integrable fun s => kS m' s * monoFib ℓ g p (a - s) := fun m' =>
    Integrable.mul_bdd (c := M) (integrable_kerScaled monoKPhi m')
      (hF.comp (measurable_const.sub measurable_id)).aestronglyMeasurable
      (Eventually.of_forall fun u => hM _)
  rw [lpD, Pi.sub_apply, lpS_apply, lpS_apply, ← integral_sub (hi m) (hi (m - 1))]
  congr 1; ext s; rw [kDel]; ring

/-- Every point lies in one of the cells `[c - (n+1)δ, c - nδ]`. -/
theorem le_tsum_indicator_cells {δ : ℝ} (hδ : 0 < δ) (c v : ℝ) (f : ℝ → ℝ≥0∞) :
    f v ≤ ∑' n : ℤ, (Icc (c - (n + 1) * δ) (c - n * δ)).indicator f v := by
  set n := ⌊(c - v) / δ⌋
  have h1 : (n : ℝ) ≤ (c - v) / δ := Int.floor_le _
  have h2 : (c - v) / δ < n + 1 := Int.lt_floor_add_one _
  rw [le_div_iff₀ hδ] at h1
  rw [div_lt_iff₀ hδ] at h2
  refine le_trans (le_of_eq ?_) (ENNReal.le_tsum n)
  rw [indicator_of_mem]
  rw [mem_Icc]; constructor <;> linarith

theorem lintegral_le_tsum_cells {f : ℝ → ℝ≥0∞} (hf : Measurable f) {δ : ℝ} (hδ : 0 < δ)
    (c : ℝ) : ∫⁻ v, f v ≤ ∑' n : ℤ, ∫⁻ v in Icc (c - (n + 1) * δ) (c - n * δ), f v := by
  simp_rw [← lintegral_indicator measurableSet_Icc]
  rw [← lintegral_tsum fun n => (hf.indicator measurableSet_Icc).aemeasurable]
  exact lintegral_mono fun v => le_tsum_indicator_cells hδ c v f

/-- The integral of `|g(x + ·)|` over a shifted dyadic interval is controlled by `𝓜_σ g`. -/
theorem setLIntegral_shift_le {g : ℝ → ℂ} (hg : Measurable g) {a : ℝ} (hga : ∀ x, ‖g x‖ ≤ a)
    (σ x : ℝ) (k : ℤ) :
    ∫⁻ v in Icc (σ * 2 ^ k) ((σ + 1) * 2 ^ k), ‖g (x + v)‖ₑ ≤
      ENNReal.ofReal ((2 : ℝ) ^ k * shiftedMaximal σ g x) := by
  have hk : (0 : ℝ) < 2 ^ k := by positivity
  have hfin : IntegrableOn (fun t => g (x + t)) (Icc (σ * 2 ^ k) ((σ + 1) * 2 ^ k)) :=
    Measure.integrableOn_of_bounded measure_Icc_lt_top.ne
      (hg.comp (measurable_const_add x)).aestronglyMeasurable
      (Eventually.of_forall fun t => hga _)
  rw [← ofReal_integral_norm_eq_lintegral_enorm hfin]
  refine ENNReal.ofReal_le_ofReal ?_
  have h := shiftedAverage_le_shiftedMaximal σ hga x k
  unfold shiftedAverage at h
  have : ∫ t in Icc (σ * (2 : ℝ) ^ k) ((σ + 1) * 2 ^ k), ‖g (x + t)‖ =
      2 ^ k * ((2 : ℝ) ^ (-k) * ∫ t in Icc (σ * (2 : ℝ) ^ k) ((σ + 1) * 2 ^ k),
        ‖g (x + t)‖) := by
    rw [← mul_assoc, ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), add_neg_cancel, zpow_zero, one_mul]
  rw [this]
  exact mul_le_mul_of_nonneg_left h hk.le

theorem cShift_zero_eq (σ : ℝ) (g : ℝ × ℝ → ℂ) (z : ℝ × ℝ) :
    cShift 0 σ g z = shiftedMaximal σ (fun s => g (s, z.2)) z.1 := by
  simp only [cShift, monoAct, monoPas, if_true]; rfl

theorem cShift_one_eq (σ : ℝ) (g : ℝ × ℝ → ℂ) (z : ℝ × ℝ) :
    cShift 1 σ g z = shiftedMaximal σ (fun s => g (z.1, s)) z.2 := by
  simp only [cShift, monoAct, monoPas, one_ne_zero, if_false]; rfl

/-- The `t`-cells: `ψ_j(t) ≤ ∑_{|l| ≤ 2^{κ+1}} 2^j 1_{[lη, (l+1)η)}(t)`, `η = 2^{-j-κ}`. -/
theorem ofReal_psiJ_le_sum (j : ℤ) (κ : ℕ) (t : ℝ) :
    ENNReal.ofReal (psiJ j t) ≤ ∑ l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)),
      (Ico ((l : ℝ) * 2 ^ (-j - κ)) ((l + 1) * 2 ^ (-j - κ))).indicator
        (fun _ => ENNReal.ofReal (2 ^ j)) t := by
  by_cases h0 : psiJ j t = 0
  · rw [h0, ENNReal.ofReal_zero]; exact bot_le
  have hj : (0 : ℝ) < 2 ^ j := by positivity
  have hη : (0 : ℝ) < 2 ^ (-j - κ) := by positivity
  have h1 := abs_lt_of_psiJ_ne h0
  have he : (2 : ℝ) ^ j * 2 ^ (-j - κ) * 2 ^ ((κ : ℤ) + 1) = 2 := by
    rw [← zpow_add₀ (by norm_num), ← zpow_add₀ (by norm_num)]
    rw [show j + (-j - κ) + (κ + 1) = 1 by ring, zpow_one]
  set N : ℤ := 2 ^ (κ + 1) with hNdef
  have hκ : (N : ℝ) = (2 : ℝ) ^ ((κ : ℤ) + 1) := by
    rw [hNdef, zpow_add₀ (by norm_num), zpow_natCast, zpow_one]; push_cast; ring
  set n := ⌊t / 2 ^ (-j - κ)⌋
  have hn1 : (n : ℝ) ≤ t / 2 ^ (-j - κ) := Int.floor_le _
  have hn2 : t / 2 ^ (-j - κ) < n + 1 := Int.lt_floor_add_one _
  have ht : |t| * 2 ^ j < 2 := by linarith [mul_comm ((2 : ℝ) ^ j) |t|]
  have hT : |t / 2 ^ (-j - κ)| < 2 ^ ((κ : ℤ) + 1) := by
    rw [abs_div, abs_of_pos hη, div_lt_iff₀ hη]
    have : |t| * 2 ^ j < 2 ^ j * 2 ^ (-j - κ) * 2 ^ ((κ : ℤ) + 1) := by rw [he]; exact ht
    nlinarith
  have hmem : n ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)) := by
    rw [Finset.mem_Ico]
    have a1 := (abs_lt.1 hT).1
    have a2 := (abs_lt.1 hT).2
    constructor
    · have : -(N : ℝ) < (n : ℝ) + 1 := by rw [hκ]; linarith
      have : -N < n + 1 := by exact_mod_cast this
      omega
    · have : (n : ℝ) < (N : ℝ) := by rw [hκ]; linarith
      exact_mod_cast this
  refine le_trans ?_ (Finset.single_le_sum (f := fun l : ℤ =>
    (Ico ((l : ℝ) * 2 ^ (-j - κ)) ((l + 1) * 2 ^ (-j - κ))).indicator
      (fun _ => ENNReal.ofReal (2 ^ j)) t) (fun _ _ => bot_le) hmem)
  rw [indicator_of_mem]
  · exact ENNReal.ofReal_le_ofReal (psiJ_le j t)
  · rw [mem_Ico]
    rw [le_div_iff₀ hη] at hn1
    rw [div_lt_iff₀ hη] at hn2
    exact ⟨hn1, hn2⟩

theorem measurable_kDel (m : ℤ) : Measurable (kDel m) :=
  (measurable_kS m).sub (measurable_kS (m - 1))

/-- The shift parameters `σ_{l,n} = (l^2 2^{-κ} - n - 5)/16` of `lem:shiftedmaxfct`. -/
def sigmaH (κ : ℕ) (l n : ℤ) : ℝ := ((l : ℝ) ^ 2 * 2 ^ (-(κ : ℤ)) - n - 5) / 16

/-- **Lemma `lem:shiftedmaxfct`** (at scale `2^{-j}`): for `κ ≥ 0`,
`|M_j(F, Δ^{(2)}_{2j+κ} G)| ≤ ∑_{|l| ≤ 2^{κ+1}} ∑_{n ∈ ℤ} C 2^{-κ} (1+|n|)^{-4}
  𝓜^{(1)}_{l} F · 𝓜^{(2)}_{σ_{l,n}} G`. -/
theorem enorm_Mj_lpD_le : ∃ C : ℝ, 0 ≤ C ∧ ∀ (j : ℤ) (κ : ℕ) {F G : ℝ × ℝ → ℂ},
    Measurable F → Measurable G → ∀ {A B : ℝ}, (∀ z, ‖F z‖ ≤ A) → (∀ z, ‖G z‖ ≤ B) →
    ∀ z : ℝ × ℝ, ‖Mj j F (lpD 1 (2 * j + κ) G) z‖ₑ ≤
      ∑ l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)), ∑' n : ℤ,
        ENNReal.ofReal (C * 2 ^ (-(κ : ℤ)) / (1 + |(n : ℝ)|) ^ 4) *
          (ENNReal.ofReal (cShift 0 l F z) * ENNReal.ofReal (cShift 1 (sigmaH κ l n) G z)) := by
  obtain ⟨C, hC, hdec⟩ := kDel_decay
  refine ⟨256 * C, by positivity, fun j κ F G hF hG A B hA hB z => ?_⟩
  set m : ℤ := 2 * j + κ with hm
  set η : ℝ := (2 : ℝ) ^ (-j - κ) with hη
  set δ : ℝ := (2 : ℝ) ^ (-m) with hδ
  have hη0 : 0 < η := by positivity
  have hδ0 : 0 < δ := by positivity
  have hj0 : (0 : ℝ) < 2 ^ (-j) := by positivity
  have hmδ : (2 : ℝ) ^ m * δ = 1 := by
    rw [hδ, ← zpow_add₀ (by norm_num), add_neg_cancel, zpow_zero]
  have hηj : η * 2 ^ (-j) = δ := by
    rw [hη, hδ, ← zpow_add₀ (by norm_num)]; congr 1; rw [hm]; ring
  have hη2 : η ^ 2 = 2 ^ (-(κ : ℤ)) * δ := by
    rw [hη, hδ, ← zpow_natCast, ← zpow_mul, ← zpow_add₀ (by norm_num)]
    congr 1; rw [hm]; push_cast; ring
  have hjη : (2 : ℝ) ^ j * η = 2 ^ (-(κ : ℤ)) := by
    rw [hη, ← zpow_add₀ (by norm_num)]; congr 1; ring
  have h16 : (2 : ℝ) ^ (4 - m) = 16 * δ := by
    rw [hδ, zpow_sub₀ (by norm_num), zpow_neg, div_eq_mul_inv]; norm_num
  set f : ℝ → ℂ := fun s => F (s, z.2) with hf
  set g : ℝ → ℂ := fun s => G (z.1, s) with hg
  have hfm : Measurable f := hF.comp (measurable_id.prodMk measurable_const)
  have hgm : Measurable g := hG.comp (measurable_const.prodMk measurable_id)
  have hfb : ∀ s, ‖f s‖ ≤ A := fun s => hA _
  have hgb : ∀ s, ‖g s‖ ≤ B := fun s => hB _
  -- the kernel representation of `Δ_m G` along the vertical line through `z`
  have hD : ∀ w, ‖lpD 1 m G (z.1, w)‖ₑ ≤ ∫⁻ s, ‖kDel m s‖ₑ * ‖g (w - s)‖ₑ := by
    intro w
    have h := lpD_apply 1 m hG hB w z.1
    have e : monoPt 1 w z.1 = (z.1, w) := by simp [monoPt]
    rw [e] at h
    rw [h]
    refine (enorm_integral_le_lintegral_enorm _).trans (le_of_eq ?_)
    refine lintegral_congr fun s => ?_
    rw [enorm_mul]
    simp [monoFib, monoPt, hg]
  -- the bound on the `t`-cell `[lη, (l+1)η)`
  set Y : ℤ → ℝ≥0∞ := fun l => ∑' n : ℤ, ENNReal.ofReal (16 * C * 2 ^ m / (1 + |(n : ℝ)|) ^ 4) *
    ENNReal.ofReal (16 * δ * cShift 1 (sigmaH κ l n) G z) with hY
  have hX : ∀ l : ℤ, |(l : ℝ) * η| ≤ 2 * 2 ^ (-j) → ∀ t, t ∈ Ico ((l : ℝ) * η) ((l + 1) * η) →
      |t| ≤ 2 * 2 ^ (-j) → ‖lpD 1 m G (z.1, z.2 + t ^ 2)‖ₑ ≤ Y l := by
    intro l hl t ht htb
    refine (hD _).trans ?_
    have e1 : ∫⁻ s, ‖kDel m s‖ₑ * ‖g (z.2 + t ^ 2 - s)‖ₑ =
        ∫⁻ v, ‖kDel m (t ^ 2 - v)‖ₑ * ‖g (z.2 + v)‖ₑ := by
      rw [← lintegral_sub_left_eq_self (fun s => ‖kDel m s‖ₑ * ‖g (z.2 + t ^ 2 - s)‖ₑ) (t ^ 2)]
      congr 1; ext v; congr 3; ring
    rw [e1]
    have hmeas : Measurable fun v => ‖kDel m (t ^ 2 - v)‖ₑ * ‖g (z.2 + v)‖ₑ :=
      ((measurable_kDel m).comp (measurable_const.sub measurable_id)).enorm.mul
        (hgm.comp (measurable_const.add measurable_id)).enorm
    refine (lintegral_le_tsum_cells hmeas hδ0 (t ^ 2)).trans ?_
    refine ENNReal.tsum_le_tsum fun n => ?_
    have hc2 : ((l : ℝ) * η) ^ 2 = (l : ℝ) ^ 2 * 2 ^ (-(κ : ℤ)) * δ := by
      rw [mul_pow, hη2]; ring
    have hd : |t ^ 2 - ((l : ℝ) * η) ^ 2| ≤ 4 * δ := by
      rw [show t ^ 2 - ((l : ℝ) * η) ^ 2 = (t - l * η) * (t + l * η) by ring, abs_mul]
      have h1 : |t - l * η| ≤ η := by
        rw [abs_le]; constructor <;> linarith [ht.1, ht.2]
      have h2 : |t + l * η| ≤ 4 * 2 ^ (-j) := (abs_add_le _ _).trans (by linarith)
      calc |t - l * η| * |t + l * η| ≤ η * (4 * 2 ^ (-j)) :=
            mul_le_mul h1 h2 (abs_nonneg _) hη0.le
        _ = 4 * δ := by rw [← hηj]; ring
    have hs1 : sigmaH κ l n * 2 ^ (4 - m) = ((l : ℝ) * η) ^ 2 - (n + 5) * δ := by
      rw [h16, hc2, sigmaH]; ring
    have hs2 : (sigmaH κ l n + 1) * 2 ^ (4 - m) = ((l : ℝ) * η) ^ 2 - (n + 5) * δ + 16 * δ := by
      rw [h16, hc2, sigmaH]; ring
    calc ∫⁻ v in Icc (t ^ 2 - (n + 1) * δ) (t ^ 2 - n * δ), ‖kDel m (t ^ 2 - v)‖ₑ * ‖g (z.2 + v)‖ₑ
        ≤ ∫⁻ v in Icc (t ^ 2 - (n + 1) * δ) (t ^ 2 - n * δ),
            ENNReal.ofReal (16 * C * 2 ^ m / (1 + |(n : ℝ)|) ^ 4) * ‖g (z.2 + v)‖ₑ := by
          refine setLIntegral_mono' measurableSet_Icc fun v hv => ?_
          gcongr
          refine enorm_le_ofReal (kDel_cell_le hC hdec m n ?_ ?_)
          · have : (n : ℝ) * δ ≤ t ^ 2 - v := by linarith [hv.2]
            have := mul_le_mul_of_nonneg_left this (by positivity : (0 : ℝ) ≤ 2 ^ m)
            calc (n : ℝ) = 2 ^ m * (n * δ) := by rw [mul_left_comm, hmδ, mul_one]
              _ ≤ _ := this
          · have : t ^ 2 - v ≤ (n + 1) * δ := by linarith [hv.1]
            have := mul_le_mul_of_nonneg_left this (by positivity : (0 : ℝ) ≤ 2 ^ m)
            calc 2 ^ m * (t ^ 2 - v) ≤ 2 ^ m * ((n + 1) * δ) := this
              _ = n + 1 := by rw [mul_left_comm, hmδ, mul_one]
      _ = ENNReal.ofReal (16 * C * 2 ^ m / (1 + |(n : ℝ)|) ^ 4) *
            ∫⁻ v in Icc (t ^ 2 - (n + 1) * δ) (t ^ 2 - n * δ), ‖g (z.2 + v)‖ₑ :=
          lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
      _ ≤ ENNReal.ofReal (16 * C * 2 ^ m / (1 + |(n : ℝ)|) ^ 4) *
            ENNReal.ofReal (16 * δ * cShift 1 (sigmaH κ l n) G z) := by
          gcongr
          rw [cShift_one_eq, ← h16]
          refine le_trans (lintegral_mono_set (Icc_subset_Icc ?_ ?_))
            (setLIntegral_shift_le hgm hgb (sigmaH κ l n) z.2 (4 - m))
          · rw [hs1]; linarith [(abs_le.1 hd).1]
          · rw [hs2]; linarith [(abs_le.1 hd).2]
  -- assembly
  set N : ℤ := 2 ^ (κ + 1) with hNdef
  have hNc : (N : ℝ) = (2 : ℝ) ^ ((κ : ℤ) + 1) := by
    rw [hNdef, zpow_add₀ (by norm_num), zpow_natCast, zpow_one]; push_cast; ring
  have hN : (N : ℝ) * η = 2 * 2 ^ (-j) := by
    rw [hNc, hη, ← zpow_add₀ (by norm_num), show (κ : ℤ) + 1 + (-j - κ) = 1 + -j by ring,
      zpow_add₀ (by norm_num), zpow_one]
  set I : ℤ → Set ℝ := fun l => Ico ((l : ℝ) * η) ((l + 1) * η) with hI
  have hrange : ∀ l ∈ Finset.Ico (-N) N, ∀ t ∈ I l,
      |(l : ℝ) * η| ≤ 2 * 2 ^ (-j) ∧ |t| ≤ 2 * 2 ^ (-j) := by
    intro l hl t ht
    rw [Finset.mem_Ico] at hl
    have h1 : (-N : ℝ) ≤ l := by exact_mod_cast hl.1
    have h2 : (l : ℝ) + 1 ≤ N := by exact_mod_cast hl.2
    have ht1 := ht.1
    have ht2 := ht.2
    have a1 : -(N : ℝ) * η ≤ l * η := mul_le_mul_of_nonneg_right h1 hη0.le
    have a2 : ((l : ℝ) + 1) * η ≤ N * η := mul_le_mul_of_nonneg_right h2 hη0.le
    rw [neg_mul, hN] at a1
    rw [hN] at a2
    refine ⟨abs_le.2 ⟨by linarith, by nlinarith⟩, abs_le.2 ⟨by linarith, by linarith⟩⟩
  rw [Mj_apply]
  refine (enorm_integral_le_lintegral_enorm _).trans ?_
  have hfz : ∀ t, F (z.1 + t, z.2) = f (z.1 + t) := fun t => rfl
  calc ∫⁻ t, ‖(psiJ j t : ℂ) * (F (z.1 + t, z.2) * lpD 1 m G (z.1, z.2 + t ^ 2))‖ₑ
      = ∫⁻ t, ENNReal.ofReal (psiJ j t) *
          (‖f (z.1 + t)‖ₑ * ‖lpD 1 m G (z.1, z.2 + t ^ 2)‖ₑ) := by
        refine lintegral_congr fun t => ?_
        rw [enorm_mul, enorm_mul, enorm_ofReal_psiJ, hfz]
    _ ≤ ∫⁻ t, ∑ l ∈ Finset.Ico (-N) N,
          (I l).indicator (fun t => ENNReal.ofReal (2 ^ j) * (‖f (z.1 + t)‖ₑ * Y l)) t := by
        refine lintegral_mono fun t => ?_
        have hψ := ofReal_psiJ_le_sum j κ t
        calc ENNReal.ofReal (psiJ j t) * (‖f (z.1 + t)‖ₑ * ‖lpD 1 m G (z.1, z.2 + t ^ 2)‖ₑ)
            ≤ (∑ l ∈ Finset.Ico (-N) N, (I l).indicator (fun _ => ENNReal.ofReal (2 ^ j)) t) *
                (‖f (z.1 + t)‖ₑ * ‖lpD 1 m G (z.1, z.2 + t ^ 2)‖ₑ) := by gcongr
          _ = ∑ l ∈ Finset.Ico (-N) N, (I l).indicator (fun _ => ENNReal.ofReal (2 ^ j)) t *
                (‖f (z.1 + t)‖ₑ * ‖lpD 1 m G (z.1, z.2 + t ^ 2)‖ₑ) := Finset.sum_mul _ _ _
          _ ≤ _ := by
              refine Finset.sum_le_sum fun l hl => ?_
              by_cases ht : t ∈ I l
              · rw [indicator_of_mem ht, indicator_of_mem ht]
                obtain ⟨hl1, ht1⟩ := hrange l hl t ht
                gcongr
                exact hX l hl1 t ht ht1
              · rw [indicator_of_notMem ht, indicator_of_notMem ht, zero_mul]
    _ = ∑ l ∈ Finset.Ico (-N) N, ∫⁻ t in I l, ENNReal.ofReal (2 ^ j) * (‖f (z.1 + t)‖ₑ * Y l) := by
        rw [lintegral_finsetSum (f := fun l t => (I l).indicator
          (fun t => ENNReal.ofReal (2 ^ j) * (‖f (z.1 + t)‖ₑ * Y l)) t) _
          fun l _ => ((measurable_const.mul
          ((hfm.comp (measurable_const.add measurable_id)).enorm.mul measurable_const)).indicator
            measurableSet_Ico)]
        refine Finset.sum_congr rfl fun l _ => ?_
        rw [lintegral_indicator (s := I l) measurableSet_Ico]
    _ ≤ ∑ l ∈ Finset.Ico (-N) N, ENNReal.ofReal (2 ^ j) *
          (ENNReal.ofReal (η * cShift 0 l F z) * Y l) := by
        refine Finset.sum_le_sum fun l _ => ?_
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
          lintegral_mul_const (Y l) (show Measurable fun a => ‖f (z.1 + a)‖ₑ from
            (hfm.comp (measurable_const.add measurable_id)).enorm)]
        gcongr
        rw [cShift_zero_eq, hη]
        refine le_trans (lintegral_mono_set ((Ico_subset_Icc_self).trans (Icc_subset_Icc ?_ ?_)))
          (setLIntegral_shift_le hfm hfb (l : ℝ) z.1 (-j - κ))
        · exact le_rfl
        · exact le_rfl
    _ = _ := by
        refine Finset.sum_congr rfl fun l _ => ?_
        rw [hY, ← mul_assoc, ← ENNReal.tsum_mul_left]
        refine tsum_congr fun n => ?_
        have h0 := cShift_nonneg 0 (l : ℝ) F z
        have h1 := cShift_nonneg 1 (sigmaH κ l n) G z
        rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_mul (by positivity)]
        congr 1
        rw [show (2 : ℝ) ^ j = 2 ^ (-(κ : ℤ)) * η⁻¹ by rw [← hjη]; field_simp,
          show (2 : ℝ) ^ m = δ⁻¹ from eq_inv_of_mul_eq_one_left hmδ]
        field_simp
        ring

/-! ### Countable Minkowski inequality, Hölder's inequality and coefficient bounds -/

theorem iSup_rpow_ennreal {ι : Sort*} (f : ι → ℝ≥0∞) {p : ℝ} (hp : 0 < p) :
    (⨆ i, f i) ^ p = ⨆ i, f i ^ p := by
  exact (ENNReal.orderIsoRpow p hp).map_iSup f

theorem eLpNorm_iSup_nat_le {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {F : ℕ → X → ℝ≥0∞} (hF : ∀ n, Measurable (F n)) (hmono : Monotone F) {r : ℝ≥0∞}
    (hr0 : r ≠ 0) (hrt : r ≠ ⊤) :
    eLpNorm (fun x => ⨆ n, F n x) r μ ≤ ⨆ n, eLpNorm (F n) r μ := by
  have hp : 0 < r.toReal := ENNReal.toReal_pos hr0 hrt
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hr0 hrt]
  simp_rw [enorm_eq_self]
  rw [show (fun x => (⨆ n, F n x) ^ r.toReal) = fun x => ⨆ n, F n x ^ r.toReal from
    funext fun x => iSup_rpow_ennreal _ hp]
  rw [lintegral_iSup (fun n => (hF n).pow_const _)
    (fun a b hab x => ENNReal.rpow_le_rpow (hmono hab x) hp.le),
    iSup_rpow_ennreal _ (by positivity : 0 < 1 / r.toReal)]
  refine iSup_mono fun n => le_of_eq ?_
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hr0 hrt]
  simp_rw [enorm_eq_self]

/-- **Minkowski's inequality for countable sums** of `[0, ∞]`-valued functions. -/
theorem eLpNorm_tsum_nat_le {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {F : ℕ → X → ℝ≥0∞} (hF : ∀ n, Measurable (F n)) {r : ℝ≥0∞} (hr : 1 ≤ r) (hrt : r ≠ ⊤) :
    eLpNorm (fun x => ∑' n, F n x) r μ ≤ ∑' n, eLpNorm (F n) r μ := by
  have e : (fun x => ∑' n, F n x) = fun x => ⨆ N, ∑ n ∈ Finset.range N, F n x :=
    funext fun x => ENNReal.tsum_eq_iSup_nat
  rw [e]
  refine (eLpNorm_iSup_nat_le (fun N => Finset.measurable_sum _ fun n _ => hF n)
    (fun a b hab x => Finset.sum_le_sum_of_subset (Finset.range_mono hab))
    (zero_lt_one.trans_le hr).ne' hrt).trans ?_
  refine iSup_le fun N => ?_
  have h := eLpNorm_sum_le (μ := μ) (s := Finset.range N) (f := F)
    (fun n _ => (hF n).aestronglyMeasurable) hr
  rw [Finset.sum_fn] at h
  exact h.trans (ENNReal.sum_le_tsum _)

theorem eLpNorm_tsum_le {X ι : Type*} [MeasurableSpace X] [Denumerable ι] {μ : Measure X}
    {F : ι → X → ℝ≥0∞} (hF : ∀ i, Measurable (F i)) {r : ℝ≥0∞} (hr : 1 ≤ r) (hrt : r ≠ ⊤) :
    eLpNorm (fun x => ∑' i, F i x) r μ ≤ ∑' i, eLpNorm (F i) r μ := by
  set e : ℕ ≃ ι := (Denumerable.eqv ι).symm
  have h1 : (fun x => ∑' i, F i x) = fun x => ∑' n, F (e n) x :=
    funext fun x => (e.tsum_eq fun i => F i x).symm
  rw [h1, ← e.tsum_eq fun i => eLpNorm (F i) r μ]
  exact eLpNorm_tsum_nat_le (fun n => hF (e n)) hr hrt

theorem eLpNorm_finset_sum_le {X ι : Type*} [MeasurableSpace X] {μ : Measure X} (s : Finset ι)
    {F : ι → X → ℝ≥0∞} (hF : ∀ i, Measurable (F i)) {r : ℝ≥0∞} (hr : 1 ≤ r) :
    eLpNorm (fun x => ∑ i ∈ s, F i x) r μ ≤ ∑ i ∈ s, eLpNorm (F i) r μ := by
  have h := eLpNorm_sum_le (μ := μ) (s := s) (f := F) (fun n _ => (hF n).aestronglyMeasurable) hr
  rwa [Finset.sum_fn] at h

/-- **Hölder's inequality** for products of real functions. -/
theorem eLpNorm_mul_le_holder {X : Type*} [MeasurableSpace X] {μ : Measure X} {u v : X → ℝ}
    (hu : AEStronglyMeasurable u μ) (hv : AEStronglyMeasurable v μ) {p q r : ℝ≥0∞}
    (hpqr : p⁻¹ + q⁻¹ = r⁻¹) :
    eLpNorm (fun x => u x * v x) r μ ≤ eLpNorm u p μ * eLpNorm v q μ := by
  haveI : ENNReal.HolderTriple p q r := ⟨hpqr⟩
  have h := eLpNorm_smul_le_mul_eLpNorm (μ := μ) (p := p) (q := q) (r := r) (f := v) hv
    (φ := u) hu
  convert h using 1
  congr 1

theorem summable_one_div_one_add_abs_sq :
    Summable fun n : ℤ => 1 / (1 + |(n : ℝ)|) ^ 2 := by
  have h : Summable fun n : ℕ => 1 / (1 + (n : ℝ)) ^ 2 := by
    have := (summable_nat_add_iff 1).2 (Real.summable_one_div_nat_pow.2 one_lt_two)
    refine this.congr fun n => ?_
    push_cast; ring
  refine summable_int_iff_summable_nat_and_neg.2 ⟨h.congr fun n => ?_, h.congr fun n => ?_⟩
  · simp
  · simp

/-- Monotonicity of the shifted maximal function. -/
theorem shiftedMaximal_mono (σ : ℝ) {g h : ℝ → ℂ} (hh : Measurable h) {b : ℝ}
    (hhb : ∀ x, ‖h x‖ ≤ b) (hgh : ∀ x, ‖g x‖ ≤ ‖h x‖) (x : ℝ) :
    shiftedMaximal σ g x ≤ shiftedMaximal σ h x := by
  unfold shiftedMaximal
  refine ciSup_le fun k => ?_
  refine le_trans ?_ (shiftedAverage_le_shiftedMaximal σ hhb x k)
  unfold shiftedAverage
  refine mul_le_mul_of_nonneg_left ?_ (by positivity)
  refine integral_mono_of_nonneg (Eventually.of_forall fun t => norm_nonneg _)
    (integrableOn_norm_comp_add hh hhb x _ _) (Eventually.of_forall fun t => hgh _)

theorem cShift_mono (ℓ : Fin 2) (σ : ℝ) {g h : ℝ × ℝ → ℂ} (hh : Measurable h) {b : ℝ}
    (hhb : ∀ z, ‖h z‖ ≤ b) (hgh : ∀ z, ‖g z‖ ≤ ‖h z‖) (z : ℝ × ℝ) :
    cShift ℓ σ g z ≤ cShift ℓ σ h z :=
  shiftedMaximal_mono σ (measurable_monoFib hh _) (fun _ => hhb _) (fun _ => hgh _) _

/-- `x^{1/p} ≤ 1 + x` for `x ≥ 0`, `p ≥ 1`. -/
theorem rpow_one_div_le_one_add {x p : ℝ} (hx : 0 ≤ x) (hp : 1 ≤ p) : x ^ (1 / p) ≤ 1 + x := by
  have h1p : 1 / p ≤ 1 := by rw [div_le_one (by linarith)]; exact hp
  rcases le_total x 1 with h | h
  · linarith [Real.rpow_le_one hx h (by positivity : (0 : ℝ) ≤ 1 / p)]
  · calc x ^ (1 / p) ≤ x ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le h h1p
      _ ≤ 1 + x := by rw [Real.rpow_one]; linarith

/-- The `L^p` operator norm coefficient of the shifted maximal function, linearized. -/
theorem shiftCoeff_le {p : ℝ} (hp : 1 < p) (σ : ℝ) :
    (shiftedMaximalLpConst p * Real.log (2 + |σ|)) ^ (1 / p) ≤
      (shiftedMaximalLpConst p + 1) * (1 + Real.log (2 + |σ|)) := by
  have hc := (shiftedMaximalLpConst_pos hp).le
  have hL : 0 ≤ Real.log (2 + |σ|) := Real.log_nonneg (by linarith [abs_nonneg σ])
  refine (rpow_one_div_le_one_add (mul_nonneg hc hL) hp.le).trans ?_
  nlinarith

theorem log_two_pow_le (k : ℕ) : Real.log ((2 : ℝ) ^ k) ≤ k := by
  rw [Real.log_pow]
  have := Real.log_two_lt_d9
  nlinarith [(Nat.cast_nonneg k : (0 : ℝ) ≤ k)]

theorem log_two_add_abs_l_le (κ : ℕ) {l : ℤ}
    (hl : l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1))) :
    Real.log (2 + |(l : ℝ)|) ≤ κ + 2 := by
  rw [Finset.mem_Ico] at hl
  have h1 : |(l : ℝ)| ≤ 2 ^ (κ + 1) := by
    rw [abs_le]
    constructor
    · have : (-(2 : ℤ) ^ (κ + 1) : ℤ) ≤ l := hl.1
      have : ((-(2 : ℤ) ^ (κ + 1) : ℤ) : ℝ) ≤ l := by exact_mod_cast this
      push_cast at this; linarith
    · have : l ≤ 2 ^ (κ + 1) := hl.2.le
      have : (l : ℝ) ≤ ((2 ^ (κ + 1) : ℤ) : ℝ) := by exact_mod_cast this
      push_cast at this; linarith
  have h2 : 2 + |(l : ℝ)| ≤ 2 ^ (κ + 2) := by
    have : (1 : ℝ) ≤ 2 ^ κ := one_le_pow₀ (by norm_num)
    rw [pow_succ, pow_succ] at *; nlinarith
  calc Real.log (2 + |(l : ℝ)|) ≤ Real.log (2 ^ (κ + 2)) :=
        Real.log_le_log (by positivity) h2
    _ ≤ ((κ + 2 : ℕ) : ℝ) := log_two_pow_le _
    _ = κ + 2 := by push_cast; ring

theorem log_two_add_abs_sigmaH_le (κ : ℕ) {l : ℤ}
    (hl : l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1))) (n : ℤ) :
    Real.log (2 + |sigmaH κ l n|) ≤ κ + 4 + |(n : ℝ)| := by
  rw [Finset.mem_Ico] at hl
  have h1 : |(l : ℝ)| ≤ 2 ^ (κ + 1) := by
    rw [abs_le]
    constructor
    · have : (-(2 : ℤ) ^ (κ + 1) : ℤ) ≤ l := hl.1
      have : ((-(2 : ℤ) ^ (κ + 1) : ℤ) : ℝ) ≤ l := by exact_mod_cast this
      push_cast at this; linarith
    · have : l ≤ 2 ^ (κ + 1) := hl.2.le
      have : (l : ℝ) ≤ ((2 ^ (κ + 1) : ℤ) : ℝ) := by exact_mod_cast this
      push_cast at this; linarith
  have hk : (0 : ℝ) < 2 ^ κ := by positivity
  have hl2 : (l : ℝ) ^ 2 * 2 ^ (-(κ : ℤ)) ≤ 4 * 2 ^ κ := by
    have : (l : ℝ) ^ 2 ≤ (2 ^ (κ + 1)) ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) h1 2
    rw [zpow_neg, zpow_natCast, ← div_eq_mul_inv, div_le_iff₀ hk]
    calc (l : ℝ) ^ 2 ≤ (2 ^ (κ + 1)) ^ 2 := this
      _ = 4 * 2 ^ κ * 2 ^ κ := by ring
  have hs : |sigmaH κ l n| ≤ 4 * 2 ^ κ + |(n : ℝ)| + 5 := by
    rw [sigmaH, abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 16), div_le_iff₀ (by norm_num)]
    have h0 : 0 ≤ (l : ℝ) ^ 2 * 2 ^ (-(κ : ℤ)) := by positivity
    calc |(l : ℝ) ^ 2 * 2 ^ (-(κ : ℤ)) - n - 5|
        ≤ |(l : ℝ) ^ 2 * 2 ^ (-(κ : ℤ))| + |(n : ℝ)| + |(5 : ℝ)| := by
          calc _ ≤ |(l : ℝ) ^ 2 * 2 ^ (-(κ : ℤ)) - n| + |(5 : ℝ)| := abs_sub _ _
            _ ≤ _ := by gcongr; exact abs_sub _ _
      _ ≤ 4 * 2 ^ κ + |(n : ℝ)| + 5 := by
          rw [abs_of_nonneg h0, abs_of_pos (by norm_num : (0 : ℝ) < 5)]; linarith
      _ ≤ (4 * 2 ^ κ + |(n : ℝ)| + 5) * 16 := by nlinarith [abs_nonneg (n : ℝ)]
  have h2 : 2 + |sigmaH κ l n| ≤ 2 ^ (κ + 4) * (1 + |(n : ℝ)|) := by
    have : (1 : ℝ) ≤ 2 ^ κ := one_le_pow₀ (by norm_num)
    rw [show (2 : ℝ) ^ (κ + 4) = 16 * 2 ^ κ by ring]
    nlinarith [abs_nonneg (n : ℝ)]
  calc Real.log (2 + |sigmaH κ l n|) ≤ Real.log (2 ^ (κ + 4) * (1 + |(n : ℝ)|)) :=
        Real.log_le_log (by positivity) h2
    _ = Real.log (2 ^ (κ + 4)) + Real.log (1 + |(n : ℝ)|) :=
        Real.log_mul (by positivity) (by positivity)
    _ ≤ ((κ + 4 : ℕ) : ℝ) + |(n : ℝ)| := by
        gcongr
        · exact log_two_pow_le _
        · linarith [Real.log_le_sub_one_of_pos (by positivity : (0 : ℝ) < 1 + |(n : ℝ)|)]
    _ = κ + 4 + |(n : ℝ)| := by push_cast; ring

/-! ### `L^p` bounds with polynomial loss for the high-frequency pieces -/

theorem card_Ico_pow (κ : ℕ) :
    ((Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1))).card : ℝ) = 2 ^ (κ + 2) := by
  rw [Int.card_Ico, show (2 : ℤ) ^ (κ + 1) - -2 ^ (κ + 1) = 2 ^ (κ + 2) by ring]
  have : (0 : ℤ) ≤ 2 ^ (κ + 2) := by positivity
  rw [show (((2 : ℤ) ^ (κ + 2)).toNat : ℝ) = (((2 : ℤ) ^ (κ + 2)).toNat : ℤ) by norm_cast,
    Int.toNat_of_nonneg this]
  push_cast; ring

/-- The coefficient sum `∑_{l,n} a_{l,n} log(2+|σ_{1}|)^{1/p} log(2+|σ_2|)^{1/q} ≲ κ^2`
(eq. `eqn:shiftedmaxfct-coeff`). -/
theorem coeffSum_le {p q : ℝ} (hp : 1 < p) (hq : 1 < q) {C : ℝ} (hC : 0 ≤ C) (κ : ℕ) :
    ∑ l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)), ∑' n : ℤ,
      ENNReal.ofReal (C * 2 ^ (-(κ : ℤ)) / (1 + |(n : ℝ)|) ^ 4) *
        (ENNReal.ofReal ((shiftedMaximalLpConst p * Real.log (2 + |(l : ℝ)|)) ^ (1 / p)) *
          ENNReal.ofReal ((shiftedMaximalLpConst q * Real.log (2 + |sigmaH κ l n|)) ^ (1 / q)))
      ≤ ENNReal.ofReal (4 * C * (shiftedMaximalLpConst p + 1) * (shiftedMaximalLpConst q + 1) *
          (∑' n : ℤ, 1 / (1 + |(n : ℝ)|) ^ 2) * (κ + 5) ^ 2) := by
  set Cp := shiftedMaximalLpConst p
  set Cq := shiftedMaximalLpConst q
  have hCp : 0 ≤ Cp := (shiftedMaximalLpConst_pos hp).le
  have hCq : 0 ≤ Cq := (shiftedMaximalLpConst_pos hq).le
  set W : ℝ := C * (Cp + 1) * (Cq + 1) * (κ + 5) ^ 2 * 2 ^ (-(κ : ℤ)) with hW
  have hW0 : 0 ≤ W := by positivity
  set g : ℤ → ℝ := fun n => 1 / (1 + |(n : ℝ)|) ^ 2
  have hg0 : ∀ n, 0 ≤ g n := fun n => by positivity
  have hgs : Summable g := summable_one_div_one_add_abs_sq
  have hterm : ∀ l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)), ∀ n : ℤ,
      ENNReal.ofReal (C * 2 ^ (-(κ : ℤ)) / (1 + |(n : ℝ)|) ^ 4) *
        (ENNReal.ofReal ((Cp * Real.log (2 + |(l : ℝ)|)) ^ (1 / p)) *
          ENNReal.ofReal ((Cq * Real.log (2 + |sigmaH κ l n|)) ^ (1 / q))) ≤
        ENNReal.ofReal (W * g n) := by
    intro l hl n
    have hn : 0 ≤ |(n : ℝ)| := abs_nonneg _
    have h1 : (Cp * Real.log (2 + |(l : ℝ)|)) ^ (1 / p) ≤ (Cp + 1) * (κ + 5) := by
      refine (shiftCoeff_le hp _).trans (mul_le_mul_of_nonneg_left ?_ (by positivity))
      linarith [log_two_add_abs_l_le κ hl]
    have h2 : (Cq * Real.log (2 + |sigmaH κ l n|)) ^ (1 / q) ≤
        (Cq + 1) * ((κ + 5) * (1 + |(n : ℝ)|)) := by
      refine (shiftCoeff_le hq _).trans (mul_le_mul_of_nonneg_left ?_ (by positivity))
      have hκ : (0 : ℝ) ≤ κ := Nat.cast_nonneg κ
      nlinarith [log_two_add_abs_sigmaH_le κ hl n]
    have hc0 : 0 ≤ C * 2 ^ (-(κ : ℤ)) / (1 + |(n : ℝ)|) ^ 4 := by positivity
    have hP1 : 0 ≤ (Cp * Real.log (2 + |(l : ℝ)|)) ^ (1 / p) :=
      Real.rpow_nonneg (mul_nonneg hCp (Real.log_nonneg (by linarith [abs_nonneg (l : ℝ)]))) _
    have hP2 : 0 ≤ (Cq * Real.log (2 + |sigmaH κ l n|)) ^ (1 / q) :=
      Real.rpow_nonneg (mul_nonneg hCq (Real.log_nonneg
        (by linarith [abs_nonneg (sigmaH κ l n)]))) _
    rw [← ENNReal.ofReal_mul hP1, ← ENNReal.ofReal_mul hc0]
    refine ENNReal.ofReal_le_ofReal ?_
    calc C * 2 ^ (-(κ : ℤ)) / (1 + |(n : ℝ)|) ^ 4 *
          ((Cp * Real.log (2 + |(l : ℝ)|)) ^ (1 / p) *
            (Cq * Real.log (2 + |sigmaH κ l n|)) ^ (1 / q))
        ≤ C * 2 ^ (-(κ : ℤ)) / (1 + |(n : ℝ)|) ^ 4 *
          ((Cp + 1) * (κ + 5) * ((Cq + 1) * ((κ + 5) * (1 + |(n : ℝ)|)))) := by
          gcongr
      _ = W * (1 / (1 + |(n : ℝ)|) ^ 3) := by
          rw [hW]; field_simp
      _ ≤ W * g n := mul_le_mul_of_nonneg_left (one_div_le_one_div_of_le (by positivity)
          (pow_le_pow_right₀ (by linarith) (by norm_num))) hW0
  calc ∑ l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)), ∑' n : ℤ,
        ENNReal.ofReal (C * 2 ^ (-(κ : ℤ)) / (1 + |(n : ℝ)|) ^ 4) *
          (ENNReal.ofReal ((Cp * Real.log (2 + |(l : ℝ)|)) ^ (1 / p)) *
            ENNReal.ofReal ((Cq * Real.log (2 + |sigmaH κ l n|)) ^ (1 / q)))
      ≤ ∑ l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)), ∑' n : ℤ,
          ENNReal.ofReal (W * g n) :=
        Finset.sum_le_sum fun l hl => ENNReal.tsum_le_tsum fun n => hterm l hl n
    _ = ∑ l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)),
          ENNReal.ofReal (W * ∑' n : ℤ, g n) := by
        refine Finset.sum_congr rfl fun l _ => ?_
        rw [← tsum_mul_left,
          ENNReal.ofReal_tsum_of_nonneg (fun n => mul_nonneg hW0 (hg0 n)) (hgs.mul_left W)]
    _ = ENNReal.ofReal (2 ^ (κ + 2) * (W * ∑' n : ℤ, g n)) := by
        rw [Finset.sum_const, nsmul_eq_mul,
          ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ 2 ^ (κ + 2)), ← card_Ico_pow κ,
          ENNReal.ofReal_natCast]
    _ = _ := by
        congr 1
        rw [hW, show (2 : ℝ) ^ (κ + 2) = 4 * 2 ^ (κ : ℤ) by rw [zpow_natCast]; ring]
        have : (2 : ℝ) ^ (κ : ℤ) * 2 ^ (-(κ : ℤ)) = 1 := by
          rw [← zpow_add₀ (by norm_num), add_neg_cancel, zpow_zero]
        calc 4 * 2 ^ (κ : ℤ) * (C * (Cp + 1) * (Cq + 1) * (κ + 5) ^ 2 * 2 ^ (-(κ : ℤ)) *
              ∑' n : ℤ, g n)
            = 4 * ((2 : ℝ) ^ (κ : ℤ) * 2 ^ (-(κ : ℤ))) * (C * (Cp + 1) * (Cq + 1) * (κ + 5) ^ 2 *
              ∑' n : ℤ, g n) := by ring
          _ = _ := by rw [this]; ring

theorem measurable_tsum_ennreal {X ι : Type*} [MeasurableSpace X] [Countable ι]
    {f : ι → X → ℝ≥0∞} (h : ∀ i, Measurable (f i)) : Measurable fun x => ∑' i, f i x := by
  simp_rw [ENNReal.tsum_eq_iSup_sum]
  exact .iSup fun s => s.measurable_fun_sum fun i _ => h i

/-- Hölder for `[0,∞]`-valued products of nonnegative real functions. -/
theorem eLpNorm_ofReal_mul_le {X : Type*} [MeasurableSpace X] {μ : Measure X} {u v : X → ℝ}
    (hu0 : ∀ x, 0 ≤ u x) (hv0 : ∀ x, 0 ≤ v x) (hu : AEStronglyMeasurable u μ)
    (hv : AEStronglyMeasurable v μ) {c : ℝ} (hc : 0 ≤ c) {p q r : ℝ≥0∞}
    (hpqr : p⁻¹ + q⁻¹ = r⁻¹) :
    eLpNorm (fun x => ENNReal.ofReal c * (ENNReal.ofReal (u x) * ENNReal.ofReal (v x))) r μ ≤
      ENNReal.ofReal c * (eLpNorm u p μ * eLpNorm v q μ) := by
  have e : (fun x => ENNReal.ofReal c * (ENNReal.ofReal (u x) * ENNReal.ofReal (v x))) =
      fun x => ‖c * (u x * v x)‖ₑ := by
    funext x
    rw [← ENNReal.ofReal_mul (hu0 x), ← ENNReal.ofReal_mul hc, Real.enorm_eq_ofReal
      (mul_nonneg hc (mul_nonneg (hu0 x) (hv0 x)))]
  rw [e, eLpNorm_enorm]
  have h2 : eLpNorm (fun x => c * (u x * v x)) r μ = ‖c‖ₑ * eLpNorm (fun x => u x * v x) r μ := by
    rw [← eLpNorm_const_smul]; rfl
  rw [h2, Real.enorm_eq_ofReal hc]
  gcongr
  exact eLpNorm_mul_le_holder hu hv hpqr

theorem eLpNorm_ofReal_cast {X : Type*} [MeasurableSpace X] {μ : Measure X} (x : X → ℝ)
    (p : ℝ≥0∞) : eLpNorm (fun z => ((x z : ℝ) : ℂ)) p μ = eLpNorm x p μ :=
  eLpNorm_congr_norm_ae (Eventually.of_forall fun _ => Complex.norm_real _)

/-- **The `L^p` bound with polynomial loss** for the high-frequency maximal pieces
(`eqn:shiftedmax-max` and the estimate following it): a common majorant of
`|M_j(Δ_{j+k_1} a, Δ_{2j+k_2} b)|` over all `j` with `L^r` norm `≲ (k_2+5)^2 ‖a‖_p ‖b‖_q`. -/
theorem highPiece_Lp {p q r : ℝ} (hp : 1 < p) (hq : 1 < q) (hr : 1 ≤ r)
    (hpqr : 1 / p + 1 / q = 1 / r) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (k₁ k₂ : ℕ) {a b : ℝ × ℝ → ℂ}, Measurable a → Measurable b →
    ∀ {A B : ℝ}, (∀ z, ‖a z‖ ≤ A) → (∀ z, ‖b z‖ ≤ B) →
    ∃ P : ℝ × ℝ → ℝ≥0∞, Measurable P ∧
      (∀ (j : ℤ) z, ‖Mj j (lpD 0 (j + k₁) a) (lpD 1 (2 * j + k₂) b) z‖ₑ ≤ P z) ∧
      eLpNorm P (ENNReal.ofReal r) volume ≤ ENNReal.ofReal (K * (k₂ + 5) ^ 2) *
        (eLpNorm a (ENNReal.ofReal p) volume * eLpNorm b (ENNReal.ofReal q) volume) := by
  obtain ⟨C, hC, hS⟩ := enorm_Mj_lpD_le
  obtain ⟨C', hC', hS'⟩ := norm_lpS_shift_le
  have hp0 : 0 < p := by linarith
  have hq0 : 0 < q := by linarith
  have hr0 : 0 < r := by linarith
  set Cp := shiftedMaximalLpConst p
  set Cq := shiftedMaximalLpConst q
  have hCp : 0 ≤ Cp := (shiftedMaximalLpConst_pos hp).le
  have hCq : 0 ≤ Cq := (shiftedMaximalLpConst_pos hq).le
  set Z : ℝ := ∑' n : ℤ, 1 / (1 + |(n : ℝ)|) ^ 2
  have hZ : 0 ≤ Z := tsum_nonneg fun n => by positivity
  set La : ℝ := (Cp * Real.log (2 + |(-1 / 2 : ℝ)|)) ^ (1 / p)
  have hLa : 0 ≤ La := by
    have : 0 ≤ Real.log (2 + |(-1 / 2 : ℝ)|) := Real.log_nonneg (by norm_num)
    positivity
  refine ⟨4 * C * (Cp + 1) * (Cq + 1) * Z * (32 * C' * La), by positivity,
    fun k₁ k₂ a b ha hb A B hA hB => ?_⟩
  have hA0 : 0 ≤ A := (norm_nonneg _).trans (hA 0)
  -- the majorant `H = 32 C' 𝓜^{(1)} a` of all `Δ^{(1)}_m a`
  set H : ℝ × ℝ → ℂ := fun z => ((32 * C' * cMax 0 a z : ℝ) : ℂ) with hHdef
  have hHm : Measurable H := by
    refine Complex.measurable_ofReal.comp (measurable_const.mul ?_)
    rw [cMax_eq_cShift]; exact measurable_cShift 0 _ ha
  have hHb : ∀ z, ‖H z‖ ≤ 32 * C' * A := by
    intro z
    rw [hHdef, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by
      have := cMax_nonneg 0 a z; positivity)]
    have := (shiftedMaximal_le_of_bound (-1 / 2) (g := monoFib 0 a (monoPas 0 z))
      (fun _ => hA _) (monoAct 0 z)).2
    have hc : cMax 0 a z ≤ A := this
    gcongr
  have hdom : ∀ (m : ℤ) w, ‖lpD 0 m a w‖ ≤ ‖H w‖ := by
    intro m w
    have h1 := hS' 0 m ha hA w.1 w.2 0
    have h2 := hS' 0 (m - 1) ha hA w.1 w.2 0
    have e : monoPt 0 (w.1 + 0) w.2 = w := by simp [monoPt]
    have e' : monoPt 0 w.1 w.2 = w := by simp [monoPt]
    rw [e, e'] at h1 h2
    simp only [abs_zero, mul_zero, add_zero, one_pow, mul_one] at h1 h2
    rw [hHdef, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by
      have := cMax_nonneg 0 a w; positivity)]
    calc ‖lpD 0 m a w‖ ≤ ‖lpS 0 m a w‖ + ‖lpS 0 (m - 1) a w‖ := by
          rw [lpD, Pi.sub_apply]; exact norm_sub_le _ _
      _ ≤ 16 * C' * cMax 0 a w + 16 * C' * cMax 0 a w := add_le_add h1 h2
      _ = 32 * C' * cMax 0 a w := by ring
  set κ := k₂
  set Q : ℤ → ℤ → ℝ × ℝ → ℝ≥0∞ := fun l n z =>
    ENNReal.ofReal (C * 2 ^ (-(κ : ℤ)) / (1 + |(n : ℝ)|) ^ 4) *
      (ENNReal.ofReal (cShift 0 l H z) * ENNReal.ofReal (cShift 1 (sigmaH κ l n) b z)) with hQ
  have hQm : ∀ l n, Measurable (Q l n) := fun l n =>
    measurable_const.mul ((ENNReal.measurable_ofReal.comp (measurable_cShift 0 _ hHm)).mul
      (ENNReal.measurable_ofReal.comp (measurable_cShift 1 _ hb)))
  refine ⟨fun z => ∑ l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)), ∑' n : ℤ, Q l n z,
    Finset.measurable_sum _ fun l _ => measurable_tsum_ennreal (fun n => hQm l n), ?_, ?_⟩
  · intro j z
    refine (hS j κ (measurable_lpD 0 (j + k₁) ha) hb (fun w => norm_lpD_le 0 (j + k₁) hA w)
      hB z).trans ?_
    refine Finset.sum_le_sum fun l _ => ENNReal.tsum_le_tsum fun n => ?_
    simp only [hQ]
    gcongr
    exact cShift_mono 0 _ hHm hHb (hdom (j + k₁)) z
  · have hr1 : 1 ≤ ENNReal.ofReal r := by
      rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hr
    have hpqr' : (ENNReal.ofReal p)⁻¹ + (ENNReal.ofReal q)⁻¹ = (ENNReal.ofReal r)⁻¹ := by
      rw [← ENNReal.ofReal_inv_of_pos hp0, ← ENNReal.ofReal_inv_of_pos hq0,
        ← ENNReal.ofReal_inv_of_pos hr0, ← ENNReal.ofReal_add (by positivity) (by positivity)]
      congr 1; rw [← one_div, ← one_div, ← one_div, hpqr]
    -- norms of the two maximal factors
    have hHn : eLpNorm H (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal (32 * C' * La) * eLpNorm a (ENNReal.ofReal p) volume := by
      rw [hHdef, eLpNorm_ofReal_cast]
      have h1 : eLpNorm (fun z => 32 * C' * cMax 0 a z) (ENNReal.ofReal p) volume =
          ENNReal.ofReal (32 * C') * eLpNorm (cMax 0 a) (ENNReal.ofReal p) volume := by
        rw [← Real.enorm_eq_ofReal (show (0 : ℝ) ≤ 32 * C' by positivity),
          ← eLpNorm_const_smul]; rfl
      calc eLpNorm (fun z => 32 * C' * cMax 0 a z) (ENNReal.ofReal p) volume
          = ENNReal.ofReal (32 * C') * eLpNorm (cShift 0 (-1 / 2) a) (ENNReal.ofReal p) volume := by
            rw [h1, cMax_eq_cShift]
        _ ≤ ENNReal.ofReal (32 * C') *
              (ENNReal.ofReal La * eLpNorm a (ENNReal.ofReal p) volume) := by
            gcongr; exact eLpNorm_cShift_le 0 (-1 / 2) hp ha hA
        _ = _ := by rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
    have hterm : ∀ l n, eLpNorm (Q l n) (ENNReal.ofReal r) volume ≤
        ENNReal.ofReal (C * 2 ^ (-(κ : ℤ)) / (1 + |(n : ℝ)|) ^ 4) *
          ((ENNReal.ofReal ((Cp * Real.log (2 + |(l : ℝ)|)) ^ (1 / p)) *
            eLpNorm H (ENNReal.ofReal p) volume) *
          (ENNReal.ofReal ((Cq * Real.log (2 + |sigmaH κ l n|)) ^ (1 / q)) *
            eLpNorm b (ENNReal.ofReal q) volume)) := by
      intro l n
      refine (eLpNorm_ofReal_mul_le (cShift_nonneg _ _ _) (cShift_nonneg _ _ _)
        (measurable_cShift 0 _ hHm).aestronglyMeasurable
        (measurable_cShift 1 _ hb).aestronglyMeasurable (by positivity) hpqr').trans ?_
      gcongr
      · exact eLpNorm_cShift_le 0 _ hp hHm hHb
      · exact eLpNorm_cShift_le 1 _ hq hb hB
    calc eLpNorm (fun z => ∑ l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)),
          ∑' n : ℤ, Q l n z) (ENNReal.ofReal r) volume
        ≤ ∑ l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)),
            eLpNorm (fun z => ∑' n : ℤ, Q l n z) (ENNReal.ofReal r) volume :=
          eLpNorm_finset_sum_le _ (fun l => measurable_tsum_ennreal (fun n => hQm l n)) hr1
      _ ≤ ∑ l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)), ∑' n : ℤ,
            eLpNorm (Q l n) (ENNReal.ofReal r) volume :=
          Finset.sum_le_sum fun l _ => eLpNorm_tsum_le (hQm l) hr1 ENNReal.ofReal_ne_top
      _ ≤ ∑ l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)), ∑' n : ℤ,
            ENNReal.ofReal (C * 2 ^ (-(κ : ℤ)) / (1 + |(n : ℝ)|) ^ 4) *
              (ENNReal.ofReal ((Cp * Real.log (2 + |(l : ℝ)|)) ^ (1 / p)) *
                ENNReal.ofReal ((Cq * Real.log (2 + |sigmaH κ l n|)) ^ (1 / q))) *
            (eLpNorm H (ENNReal.ofReal p) volume * eLpNorm b (ENNReal.ofReal q) volume) := by
          refine Finset.sum_le_sum fun l _ => ENNReal.tsum_le_tsum fun n => ?_
          refine (hterm l n).trans (le_of_eq ?_)
          ring
      _ = (∑ l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)), ∑' n : ℤ,
            ENNReal.ofReal (C * 2 ^ (-(κ : ℤ)) / (1 + |(n : ℝ)|) ^ 4) *
              (ENNReal.ofReal ((Cp * Real.log (2 + |(l : ℝ)|)) ^ (1 / p)) *
                ENNReal.ofReal ((Cq * Real.log (2 + |sigmaH κ l n|)) ^ (1 / q)))) *
            (eLpNorm H (ENNReal.ofReal p) volume * eLpNorm b (ENNReal.ofReal q) volume) := by
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl fun l _ => ?_
          rw [ENNReal.tsum_mul_right]
      _ ≤ ENNReal.ofReal (4 * C * (Cp + 1) * (Cq + 1) * Z * (κ + 5) ^ 2) *
            ((ENNReal.ofReal (32 * C' * La) * eLpNorm a (ENNReal.ofReal p) volume) *
              eLpNorm b (ENNReal.ofReal q) volume) := by
          gcongr
          · exact coeffSum_le hp hq hC κ
      _ = _ := by
          rw [mul_assoc (ENNReal.ofReal (32 * C' * La)), ← mul_assoc,
            ← ENNReal.ofReal_mul (by positivity)]
          congr 1; congr 1; ring

/-! ### The `L^2 × L^2 → L^1` decay of the high-frequency pieces (`eqn:max-l2-decay`) -/

theorem memLp_two_of_bdd' {X : Type*} [MeasurableSpace X] {μ : Measure X} {G : X → ℂ}
    (hG : Integrable G μ) {M : ℝ} (hM : ∀ x, ‖G x‖ ≤ M) : MemLp G 2 μ := by
  refine (memLp_two_iff_integrable_sq_norm hG.1).mpr ?_
  refine (hG.norm.const_mul M).mono' (hG.1.norm.pow 2) (Eventually.of_forall fun x => ?_)
  rw [Real.norm_eq_abs, abs_of_nonneg (by positivity), sq]
  exact mul_le_mul_of_nonneg_right (hM x) (norm_nonneg _)

theorem fibL12_of_bdd (ℓ : Fin 2) {g : ℝ × ℝ → ℂ} {M : ℝ} (hM : ∀ z, ‖g z‖ ≤ M)
    (hfib : ∀ p, Integrable (monoFib ℓ g p)) : FibL12 ℓ g :=
  fun p => ⟨hfib p, memLp_two_of_bdd (hfib p) (fun _ => hM _)⟩

theorem lpD_fourier_eq_zero (ℓ : Fin 2) (m : ℤ) {g : ℝ × ℝ → ℂ}
    (hfib : ∀ p, Integrable (monoFib ℓ g p)) (p ξ : ℝ) (hξ : |ξ| < 2 ^ (m - 1)) :
    𝓕 (monoFib ℓ (lpD ℓ m g) p) ξ = 0 := by
  have h := fibF_lpD ℓ m hfib (p, ξ)
  simp only [fibF] at h
  rw [h, monoPsiA_eq_zero_of_abs_le, Complex.ofReal_zero, zero_mul]
  have hm : (0 : ℝ) < 2 ^ m := by positivity
  rw [abs_div, abs_of_pos hm, div_le_iff₀ hm]
  have : (2 : ℝ) ^ (m - 1) = 2 ^ m / 2 := by rw [zpow_sub₀ (by norm_num), zpow_one]
  rw [this] at hξ; linarith

theorem eLpNorm_lpD_sq_le (ℓ : Fin 2) (m : ℤ) {g : ℝ × ℝ → ℂ} (hg : Measurable g)
    {M : ℝ} (hM : ∀ z, ‖g z‖ ≤ M) (hfib : ∀ p, Integrable (monoFib ℓ g p)) :
    ∫⁻ z, ‖lpD ℓ m g z‖ₑ ^ 2 ≤ ∫⁻ z, ‖g z‖ₑ ^ 2 := by
  have h := sum_lintegral_lpD_sq_le ℓ {m} hg (fibL12_of_bdd ℓ hM hfib) hM
  simpa using h

theorem eLpNorm_lpD_le (ℓ : Fin 2) (m : ℤ) {g : ℝ × ℝ → ℂ} (hg : Measurable g)
    {M : ℝ} (hM : ∀ z, ‖g z‖ ≤ M) (hfib : ∀ p, Integrable (monoFib ℓ g p)) :
    eLpNorm (lpD ℓ m g) 2 volume ≤ eLpNorm g 2 volume := by
  rw [eLpNorm_two_eq_lintegral_nat, eLpNorm_two_eq_lintegral_nat]
  exact ENNReal.rpow_le_rpow (eLpNorm_lpD_sq_le ℓ m hg hM hfib) (by norm_num)

/-- One piece: `‖M_j(Δ_{j+k_1+1} f, Δ_{2j+k_2+1} g)‖_1 ≲ 2^{-δ max(k_1,k_2)}
‖Δ f‖_2 ‖Δ g‖_2` (Theorem 5 through `Mj_gain`). -/
theorem Mj_piece_L1 : ∃ C δ : ℝ, 0 < C ∧ 0 < δ ∧ ∀ (j : ℤ) (k₁ k₂ : ℕ) {f g : ℝ × ℝ → ℂ},
    Measurable f → Measurable g → ∀ {A B : ℝ}, (∀ z, ‖f z‖ ≤ A) → (∀ z, ‖g z‖ ≤ B) →
    (∀ p, Integrable (monoFib 0 f p)) → (∀ p, Integrable (monoFib 1 g p)) →
    eLpNorm f 2 volume ≠ ⊤ → eLpNorm g 2 volume ≠ ⊤ →
    eLpNorm (Mj j (lpD 0 (j + (k₁ + 1 : ℕ)) f) (lpD 1 (2 * j + (k₂ + 1 : ℕ)) g)) 1 volume ≤
      ENNReal.ofReal (2 * C * ((2 : ℝ) ^ (max k₁ k₂)) ^ (-δ)) *
        (eLpNorm (lpD 0 (j + (k₁ + 1 : ℕ)) f) 2 volume *
          eLpNorm (lpD 1 (2 * j + (k₂ + 1 : ℕ)) g) 2 volume) := by
  obtain ⟨C, δ, hC, hδ, hG⟩ := Mj_gain
  refine ⟨C, δ, hC, hδ, fun j k₁ k₂ f g hf hg A B hA hB hfi hgi hf2 hg2 => ?_⟩
  set m₁ : ℤ := j + (k₁ + 1 : ℕ) with hm₁
  set m₂ : ℤ := 2 * j + (k₂ + 1 : ℕ) with hm₂
  have hΛ : (1 : ℝ) ≤ 2 ^ (max k₁ k₂) := one_le_pow₀ (by norm_num)
  have hD1 : ∀ z, ‖lpD 0 m₁ f z‖ ≤ 2 * ((∫ s, ‖monoKPhi s‖) * A) := norm_lpD_le 0 m₁ hA
  have hD2 : ∀ z, ‖lpD 1 m₂ g z‖ ≤ 2 * ((∫ s, ‖monoKPhi s‖) * B) := norm_lpD_le 1 m₂ hB
  have h2f : eLpNorm (lpD 0 m₁ f) 2 volume ≠ ⊤ :=
    ne_top_of_le_ne_top hf2 (eLpNorm_lpD_le 0 m₁ hf hA hfi)
  have h2g : eLpNorm (lpD 1 m₂ g) 2 volume ≠ ⊤ :=
    ne_top_of_le_ne_top hg2 (eLpNorm_lpD_le 1 m₂ hg hB hgi)
  refine hG j _ hΛ _ _ (measurable_lpD 0 m₁ hf) (measurable_lpD 1 m₂ hg) _ _ hD1 hD2
    (integrable_fib_lpD 0 m₁ hfi) (integrable_fib_lpD 1 m₂ hgi) h2f h2g ?_
  have hj : (0 : ℝ) < 2 ^ j := by positivity
  rcases le_total k₂ k₁ with hk | hk
  · left
    intro p ξ hξ
    refine lpD_fourier_eq_zero 0 m₁ hfi p ξ (lt_of_lt_of_le hξ (le_of_eq ?_))
    rw [max_eq_left hk, ← zpow_natCast, ← zpow_add₀ (by norm_num)]
    congr 1; rw [hm₁]; push_cast; ring
  · right
    intro p ξ hξ
    refine lpD_fourier_eq_zero 1 m₂ hgi p ξ (lt_of_lt_of_le hξ (le_of_eq ?_))
    rw [max_eq_right hk, ← zpow_natCast, ← zpow_natCast (2 ^ j : ℝ) 2, ← zpow_mul,
      ← zpow_add₀ (by norm_num)]
    congr 1; rw [hm₂]; push_cast; ring

/-- Cauchy-Schwarz over the scales: `∑_j ‖Δ_{j+k_1+1} f‖_2 ‖Δ_{2j+k_2+1} g‖_2 ≤ ‖f‖_2 ‖g‖_2`. -/
theorem sum_eLpNorm_lpD_mul_le (k₁ k₂ : ℕ) (F : Finset ℤ) {f g : ℝ × ℝ → ℂ}
    (hf : Measurable f) (hg : Measurable g) {A B : ℝ} (hA : ∀ z, ‖f z‖ ≤ A)
    (hB : ∀ z, ‖g z‖ ≤ B) (hfi : ∀ p, Integrable (monoFib 0 f p))
    (hgi : ∀ p, Integrable (monoFib 1 g p)) :
    ∑ j ∈ F, eLpNorm (lpD 0 (j + (k₁ + 1 : ℕ)) f) 2 volume *
      eLpNorm (lpD 1 (2 * j + (k₂ + 1 : ℕ)) g) 2 volume ≤
      eLpNorm f 2 volume * eLpNorm g 2 volume := by
  have hcs := ENNReal.inner_le_Lp_mul_Lq F (fun j => eLpNorm (lpD 0 (j + (k₁ + 1 : ℕ)) f) 2 volume)
    (fun j => eLpNorm (lpD 1 (2 * j + (k₂ + 1 : ℕ)) g) 2 volume) Real.HolderConjugate.two_two
  refine hcs.trans ?_
  have hsq : ∀ (ℓ : Fin 2) (G : ℝ × ℝ → ℂ), eLpNorm G 2 volume ^ (2 : ℝ) = ∫⁻ z, ‖G z‖ₑ ^ 2 := by
    intro ℓ G
    rw [eLpNorm_two_eq_lintegral_nat, ← ENNReal.rpow_mul]; norm_num
  have h1 : ∑ j ∈ F, eLpNorm (lpD 0 (j + (k₁ + 1 : ℕ)) f) 2 volume ^ (2 : ℝ) ≤
      eLpNorm f 2 volume ^ (2 : ℝ) := by
    simp_rw [hsq 0]
    have hinj : Set.InjOn (fun j : ℤ => j + (k₁ + 1 : ℕ)) F := fun a _ b _ h => by
      simpa using h
    have := sum_lintegral_lpD_sq_le 0 (F.image fun j : ℤ => j + (k₁ + 1 : ℕ)) hf
      (fibL12_of_bdd 0 hA hfi) hA
    rwa [Finset.sum_image hinj] at this
  have h2 : ∑ j ∈ F, eLpNorm (lpD 1 (2 * j + (k₂ + 1 : ℕ)) g) 2 volume ^ (2 : ℝ) ≤
      eLpNorm g 2 volume ^ (2 : ℝ) := by
    simp_rw [hsq 1]
    have hinj : Set.InjOn (fun j : ℤ => 2 * j + (k₂ + 1 : ℕ)) F := fun a _ b _ h => by
      simp only at h; omega
    have := sum_lintegral_lpD_sq_le 1 (F.image fun j : ℤ => 2 * j + (k₂ + 1 : ℕ)) hg
      (fibL12_of_bdd 1 hB hgi) hB
    rwa [Finset.sum_image hinj] at this
  calc (∑ j ∈ F, eLpNorm (lpD 0 (j + (k₁ + 1 : ℕ)) f) 2 volume ^ (2 : ℝ)) ^ (1 / (2 : ℝ)) *
        (∑ j ∈ F, eLpNorm (lpD 1 (2 * j + (k₂ + 1 : ℕ)) g) 2 volume ^ (2 : ℝ)) ^ (1 / (2 : ℝ))
      ≤ (eLpNorm f 2 volume ^ (2 : ℝ)) ^ (1 / (2 : ℝ)) *
          (eLpNorm g 2 volume ^ (2 : ℝ)) ^ (1 / (2 : ℝ)) := by
        gcongr
    _ = _ := by
        rw [← ENNReal.rpow_mul, ← ENNReal.rpow_mul]; norm_num

/-- Modification on a null set of fibres: a bounded integrable function agrees, off the fibres
over a null set, with a function all of whose fibres are integrable. -/
theorem exists_fib_integrable_modification (ℓ : Fin 2) {f : ℝ × ℝ → ℂ} (hf : Measurable f)
    (hfi : Integrable f) {M : ℝ} (hM : ∀ z, ‖f z‖ ≤ M) :
    ∃ f' : ℝ × ℝ → ℂ, Measurable f' ∧ (∀ z, ‖f' z‖ ≤ M) ∧
      (∀ p, Integrable (monoFib ℓ f' p)) ∧ ∃ N : Set ℝ, volume N = 0 ∧
        ∀ z, monoPas ℓ z ∉ N → f' z = f z := by
  classical
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  have hae : ∀ᵐ p, Integrable (monoFib ℓ f p) := by
    fin_cases ℓ
    · have h := hfi.prod_left_ae
      refine h.mono fun p hp => ?_
      have e : monoFib 0 f p = fun x => f (x, p) := by funext x; simp [monoFib, monoPt]
      change Integrable (monoFib 0 f p) volume
      rw [e]; exact hp
    · have h := hfi.prod_right_ae
      refine h.mono fun p hp => ?_
      have e : monoFib 1 f p = fun x => f (p, x) := by funext x; simp [monoFib, monoPt]
      change Integrable (monoFib 1 f p) volume
      rw [e]; exact hp
  obtain ⟨N, hN, hNm, hN0⟩ := exists_measurable_superset_of_null (ae_iff.1 hae)
  refine ⟨fun z => if monoPas ℓ z ∈ N then 0 else f z, ?_, ?_, ?_, N, hN0, ?_⟩
  · exact Measurable.ite (hNm.preimage (measurable_monoPas ℓ)) measurable_const hf
  · intro z; by_cases h : monoPas ℓ z ∈ N
    · simp [h, hM0]
    · simp [h, hM z]
  · intro p
    by_cases h : p ∈ N
    · have : monoFib ℓ (fun z => if monoPas ℓ z ∈ N then 0 else f z) p = fun _ => 0 := by
        funext a; simp [monoFib, monoPas_pt, h]
      rw [this]; exact integrable_zero _ _ _
    · have : monoFib ℓ (fun z => if monoPas ℓ z ∈ N then 0 else f z) p = monoFib ℓ f p := by
        funext a; simp [monoFib, monoPas_pt, h]
      rw [this]
      by_contra hc
      exact h (hN hc)
  · intro z hz; simp [hz]

theorem lpS_congr_fib (ℓ : Fin 2) (m : ℤ) {G G' : ℝ × ℝ → ℂ} (z : ℝ × ℝ)
    (h : ∀ s, G (monoPt ℓ s (monoPas ℓ z)) = G' (monoPt ℓ s (monoPas ℓ z))) :
    lpS ℓ m G z = lpS ℓ m G' z := by
  unfold lpS monoP monoCConv
  congr 1; funext s
  rw [← monoPt_act_pas ℓ z, monoPt_sub_E, h]

theorem lpD_congr_fib (ℓ : Fin 2) (m : ℤ) {G G' : ℝ × ℝ → ℂ} (z : ℝ × ℝ)
    (h : ∀ s, G (monoPt ℓ s (monoPas ℓ z)) = G' (monoPt ℓ s (monoPas ℓ z))) :
    lpD ℓ m G z = lpD ℓ m G' z := by
  rw [lpD, lpD, Pi.sub_apply, Pi.sub_apply, lpS_congr_fib ℓ m z h, lpS_congr_fib ℓ (m - 1) z h]

theorem volume_snd_preimage_null {N : Set ℝ} (hN : volume N = 0) :
    volume {z : ℝ × ℝ | z.2 ∈ N} = 0 := by
  have : {z : ℝ × ℝ | z.2 ∈ N} = univ ×ˢ N := by ext z; simp
  obtain ⟨N', hN', hN'm, hN'0⟩ := exists_measurable_superset_of_null hN
  refine measure_mono_null (t := univ ×ˢ N') (by rw [this]; exact prod_mono le_rfl hN') ?_
  rw [Measure.volume_eq_prod, Measure.prod_prod, hN'0, mul_zero]

theorem volume_fst_preimage_null {N : Set ℝ} (hN : volume N = 0) :
    volume {z : ℝ × ℝ | z.1 ∈ N} = 0 := by
  have : {z : ℝ × ℝ | z.1 ∈ N} = N ×ˢ univ := by ext z; simp
  obtain ⟨N', hN', hN'm, hN'0⟩ := exists_measurable_superset_of_null hN
  refine measure_mono_null (t := N' ×ˢ univ) (by rw [this]; exact prod_mono hN' le_rfl) ?_
  rw [Measure.volume_eq_prod, Measure.prod_prod, hN'0, zero_mul]

/-- **`eqn:Mk-l2-decay`**: for bounded integrable `f, g` and finite `F ⊆ ℤ`,
`∑_{j ∈ F} ‖M_j(Δ_{j+k_1+1} f, Δ_{2j+k_2+1} g)‖_1 ≲ 2^{-δ max(k_1,k_2)} ‖f‖_2 ‖g‖_2`. -/
theorem sum_Mj_piece_L1 : ∃ C δ : ℝ, 0 < C ∧ 0 < δ ∧ ∀ (k₁ k₂ : ℕ) (F : Finset ℤ)
    {f g : ℝ × ℝ → ℂ}, Measurable f → Measurable g → Integrable f → Integrable g →
    ∀ {A B : ℝ}, (∀ z, ‖f z‖ ≤ A) → (∀ z, ‖g z‖ ≤ B) →
    ∑ j ∈ F, eLpNorm (Mj j (lpD 0 (j + (k₁ + 1 : ℕ)) f) (lpD 1 (2 * j + (k₂ + 1 : ℕ)) g)) 1
      volume ≤ ENNReal.ofReal (2 * C * ((2 : ℝ) ^ (max k₁ k₂)) ^ (-δ)) *
        (eLpNorm f 2 volume * eLpNorm g 2 volume) := by
  obtain ⟨C, δ, hC, hδ, hP⟩ := Mj_piece_L1
  refine ⟨C, δ, hC, hδ, fun k₁ k₂ F f g hf hg hfi hgi A B hA hB => ?_⟩
  obtain ⟨f', hf'm, hf'b, hf'i, Nf, hNf, hf'e⟩ := exists_fib_integrable_modification 0 hf hfi hA
  obtain ⟨g', hg'm, hg'b, hg'i, Ng, hNg, hg'e⟩ := exists_fib_integrable_modification 1 hg hgi hB
  have hff : f' =ᵐ[volume] f := by
    refine measure_mono_null (fun z hz => ?_) (volume_snd_preimage_null hNf)
    by_contra h
    exact hz (hf'e z (by simpa [monoPas] using h))
  have hgg : g' =ᵐ[volume] g := by
    refine measure_mono_null (fun z hz => ?_) (volume_fst_preimage_null hNg)
    by_contra h
    exact hz (hg'e z (by simpa [monoPas] using h))
  have hf2 : eLpNorm f' 2 volume ≠ ⊤ := by
    rw [eLpNorm_congr_ae hff]; exact (memLp_two_of_bdd' hfi hA).eLpNorm_ne_top
  have hg2 : eLpNorm g' 2 volume ≠ ⊤ := by
    rw [eLpNorm_congr_ae hgg]; exact (memLp_two_of_bdd' hgi hB).eLpNorm_ne_top
  -- `M_j` of the modified functions agrees a.e. with the original
  have hMae : ∀ j : ℤ,
      Mj j (lpD 0 (j + (k₁ + 1 : ℕ)) f') (lpD 1 (2 * j + (k₂ + 1 : ℕ)) g') =ᵐ[volume]
      Mj j (lpD 0 (j + (k₁ + 1 : ℕ)) f) (lpD 1 (2 * j + (k₂ + 1 : ℕ)) g) := by
    intro j
    have hnull : volume ({z : ℝ × ℝ | z.2 ∈ Nf} ∪ {z | z.1 ∈ Ng}) = 0 :=
      measure_union_null (volume_snd_preimage_null hNf) (volume_fst_preimage_null hNg)
    refine measure_mono_null (fun z hz => ?_) hnull
    by_contra h
    simp only [mem_union, mem_setOf_eq, not_or] at h
    apply hz
    change Mj j _ _ z = Mj j _ _ z
    rw [Mj_apply, Mj_apply]
    congr 1; funext t
    rw [lpD_congr_fib 0 _ (z.1 + t, z.2) (G := f') (G' := f) (fun s => hf'e _ (by
        simpa [monoPas, monoPt] using h.1)),
      lpD_congr_fib 1 _ (z.1, z.2 + t ^ 2) (G := g') (G' := g) (fun s => hg'e _ (by
        simpa [monoPas, monoPt] using h.2))]
  calc ∑ j ∈ F, eLpNorm (Mj j (lpD 0 (j + (k₁ + 1 : ℕ)) f) (lpD 1 (2 * j + (k₂ + 1 : ℕ)) g)) 1
        volume
      = ∑ j ∈ F, eLpNorm (Mj j (lpD 0 (j + (k₁ + 1 : ℕ)) f') (lpD 1 (2 * j + (k₂ + 1 : ℕ)) g'))
          1 volume := Finset.sum_congr rfl fun j _ => (eLpNorm_congr_ae (hMae j)).symm
    _ ≤ ∑ j ∈ F, ENNReal.ofReal (2 * C * ((2 : ℝ) ^ (max k₁ k₂)) ^ (-δ)) *
          (eLpNorm (lpD 0 (j + (k₁ + 1 : ℕ)) f') 2 volume *
            eLpNorm (lpD 1 (2 * j + (k₂ + 1 : ℕ)) g') 2 volume) :=
        Finset.sum_le_sum fun j _ => hP j k₁ k₂ hf'm hg'm hf'b hg'b hf'i hg'i hf2 hg2
    _ = ENNReal.ofReal (2 * C * ((2 : ℝ) ^ (max k₁ k₂)) ^ (-δ)) *
          ∑ j ∈ F, eLpNorm (lpD 0 (j + (k₁ + 1 : ℕ)) f') 2 volume *
            eLpNorm (lpD 1 (2 * j + (k₂ + 1 : ℕ)) g') 2 volume := by rw [Finset.mul_sum]
    _ ≤ ENNReal.ofReal (2 * C * ((2 : ℝ) ^ (max k₁ k₂)) ^ (-δ)) *
          (eLpNorm f' 2 volume * eLpNorm g' 2 volume) := by
        gcongr
        exact sum_eLpNorm_lpD_mul_le k₁ k₂ F hf'm hg'm hf'b hg'b hf'i hg'i
    _ = _ := by rw [eLpNorm_congr_ae hff, eLpNorm_congr_ae hgg]

/-! ### Linearity, a measurable selector, and the linearized maximal pieces -/

theorem measurable_Mj (j : ℤ) {g₁ g₂ : ℝ × ℝ → ℂ} (h₁ : Measurable g₁) (h₂ : Measurable g₂) :
    Measurable (Mj j g₁ g₂) :=
  measurable_ms8AvgP (continuous_psiJ j).measurable h₁ h₂

theorem integrable_kS_mul (ℓ : Fin 2) (m : ℤ) {g : ℝ × ℝ → ℂ} (hg : Measurable g) {M : ℝ}
    (hM : ∀ z, ‖g z‖ ≤ M) (z : ℝ × ℝ) :
    Integrable fun s => (((2 : ℝ) ^ m : ℝ) : ℂ) * monoKPhi ((2 : ℝ) ^ m * s) *
      g (z - monoEj ℓ s) :=
  Integrable.mul_bdd (c := M) (integrable_kerScaled monoKPhi m)
    (hg.comp (measurable_const.sub ((continuous_monoPt ℓ).measurable.comp
      (measurable_id.prodMk measurable_const)))).aestronglyMeasurable
    (Eventually.of_forall fun _ => hM _)

theorem lpS_add (ℓ : Fin 2) (m : ℤ) {f g : ℝ × ℝ → ℂ} (hf : Measurable f) (hg : Measurable g)
    {A B : ℝ} (hA : ∀ z, ‖f z‖ ≤ A) (hB : ∀ z, ‖g z‖ ≤ B) :
    lpS ℓ m (f + g) = lpS ℓ m f + lpS ℓ m g := by
  funext z
  simp only [lpS, monoP, monoCConv, Pi.add_apply, mul_add]
  exact integral_add (integrable_kS_mul ℓ m hf hA z) (integrable_kS_mul ℓ m hg hB z)

theorem lpS_smul (ℓ : Fin 2) (m : ℤ) (c : ℂ) (f : ℝ × ℝ → ℂ) :
    lpS ℓ m (c • f) = c • lpS ℓ m f := by
  funext z
  simp only [lpS, monoP, monoCConv, Pi.smul_apply, smul_eq_mul]
  rw [← integral_const_mul]
  congr 1; funext s; ring

theorem lpD_add (ℓ : Fin 2) (m : ℤ) {f g : ℝ × ℝ → ℂ} (hf : Measurable f) (hg : Measurable g)
    {A B : ℝ} (hA : ∀ z, ‖f z‖ ≤ A) (hB : ∀ z, ‖g z‖ ≤ B) :
    lpD ℓ m (f + g) = lpD ℓ m f + lpD ℓ m g := by
  rw [lpD, lpD, lpD, lpS_add ℓ m hf hg hA hB, lpS_add ℓ (m - 1) hf hg hA hB]; abel

theorem lpD_smul (ℓ : Fin 2) (m : ℤ) (c : ℂ) (f : ℝ × ℝ → ℂ) :
    lpD ℓ m (c • f) = c • lpD ℓ m f := by
  rw [lpD, lpD, lpS_smul, lpS_smul, smul_sub]

theorem Mj_add_left (j : ℤ) {g₁ g₁' g₂ : ℝ × ℝ → ℂ} (h₁ : Measurable g₁) (h₁' : Measurable g₁')
    (h₂ : Measurable g₂) {M₁ M₁' M₂ : ℝ} (hM₁ : ∀ z, ‖g₁ z‖ ≤ M₁) (hM₁' : ∀ z, ‖g₁' z‖ ≤ M₁')
    (hM₂ : ∀ z, ‖g₂ z‖ ≤ M₂) : Mj j (g₁ + g₁') g₂ = Mj j g₁ g₂ + Mj j g₁' g₂ := by
  funext z
  rw [Pi.add_apply, Mj_apply, Mj_apply, Mj_apply, ← integral_add
    (integrable_Mj_integrand j h₁ h₂ hM₁ hM₂ z) (integrable_Mj_integrand j h₁' h₂ hM₁' hM₂ z)]
  congr 1; ext t; simp only [Pi.add_apply]; ring

theorem Mj_add_right (j : ℤ) {g₁ g₂ g₂' : ℝ × ℝ → ℂ} (h₁ : Measurable g₁) (h₂ : Measurable g₂)
    (h₂' : Measurable g₂') {M₁ M₂ M₂' : ℝ} (hM₁ : ∀ z, ‖g₁ z‖ ≤ M₁) (hM₂ : ∀ z, ‖g₂ z‖ ≤ M₂)
    (hM₂' : ∀ z, ‖g₂' z‖ ≤ M₂') : Mj j g₁ (g₂ + g₂') = Mj j g₁ g₂ + Mj j g₁ g₂' := by
  funext z
  rw [Pi.add_apply, Mj_apply, Mj_apply, Mj_apply, ← integral_add
    (integrable_Mj_integrand j h₁ h₂ hM₁ hM₂ z) (integrable_Mj_integrand j h₁ h₂' hM₁ hM₂' z)]
  congr 1; ext t; simp only [Pi.add_apply]; ring

theorem Mj_smul_left (j : ℤ) (c : ℂ) (g₁ g₂ : ℝ × ℝ → ℂ) :
    Mj j (c • g₁) g₂ = c • Mj j g₁ g₂ := by
  funext z
  rw [Pi.smul_apply, Mj_apply, Mj_apply, smul_eq_mul, ← integral_const_mul]
  congr 1; ext t; simp only [Pi.smul_apply, smul_eq_mul]; ring

theorem Mj_smul_right (j : ℤ) (c : ℂ) (g₁ g₂ : ℝ × ℝ → ℂ) :
    Mj j g₁ (c • g₂) = c • Mj j g₁ g₂ := by
  funext z
  rw [Pi.smul_apply, Mj_apply, Mj_apply, smul_eq_mul, ← integral_const_mul]
  congr 1; ext t; simp only [Pi.smul_apply, smul_eq_mul]; ring

/-- A measurable choice of a maximizing index among finitely many measurable functions. -/
theorem exists_measurable_argmax {X : Type*} [MeasurableSpace X] (F : Finset ℤ)
    (hF : F.Nonempty) (G : ℤ → X → ℝ) (hG : ∀ j, Measurable (G j)) :
    ∃ σ : X → ℤ, Measurable σ ∧ ∀ x, σ x ∈ F ∧ ∀ j ∈ F, G j x ≤ G (σ x) x := by
  classical
  set S : X → Finset ℤ := fun x => F.filter fun j => ∀ i ∈ F, G i x ≤ G j x with hS
  have hSne : ∀ x, (S x).Nonempty := by
    intro x
    obtain ⟨j, hj, hjmax⟩ := F.exists_max_image (fun j => G j x) hF
    exact ⟨j, Finset.mem_filter.2 ⟨hj, hjmax⟩⟩
  set σ : X → ℤ := fun x => (S x).min' (hSne x) with hσ
  have hσS : ∀ x, σ x ∈ S x := fun x => Finset.min'_mem _ _
  refine ⟨σ, ?_, fun x => ?_⟩
  · refine measurable_to_countable' fun k => ?_
    have e : σ ⁻¹' {k} = {x | k ∈ F ∧ (∀ i ∈ F, G i x ≤ G k x) ∧
        ∀ i ∈ F, (∀ i' ∈ F, G i' x ≤ G i x) → k ≤ i} := by
      ext x
      simp only [mem_preimage, mem_singleton_iff, mem_setOf_eq]
      constructor
      · intro h
        have h1 := hσS x
        rw [h, hS, Finset.mem_filter] at h1
        refine ⟨h1.1, h1.2, fun i hi hmax => ?_⟩
        rw [← h]
        exact Finset.min'_le _ _ (Finset.mem_filter.2 ⟨hi, hmax⟩)
      · rintro ⟨h1, h2, h3⟩
        refine le_antisymm (Finset.min'_le _ _ (Finset.mem_filter.2 ⟨h1, h2⟩)) ?_
        have := hσS x
        rw [hS, Finset.mem_filter] at this
        exact h3 _ this.1 this.2
    rw [e]
    refine measurableSet_setOf.2 ?_
    refine Measurable.and measurable_const (Measurable.and ?_ ?_)
    · refine Measurable.forall fun i => Measurable.imp measurable_const ?_
      exact measurableSet_setOf.1 (measurableSet_le (hG i) (hG k))
    · refine Measurable.forall fun i => Measurable.imp measurable_const (Measurable.imp ?_
        measurable_const)
      refine Measurable.forall fun i' => Measurable.imp measurable_const ?_
      exact measurableSet_setOf.1 (measurableSet_le (hG i') (hG i))
  · have := hσS x
    rw [hS, Finset.mem_filter] at this
    exact this

theorem measurable_comp_selector {X : Type*} [MeasurableSpace X] {σ : X → ℤ}
    (hσ : Measurable σ) {H : ℤ → X → ℂ} (hH : ∀ j, Measurable (H j)) :
    Measurable fun x => H (σ x) x := by
  have h : Measurable fun q : ℤ × X => H q.1 q.2 :=
    measurable_from_prod_countable_right fun j => hH j
  exact h.comp (hσ.prodMk measurable_id)

/-- The linearized high-frequency piece `u(z) M_{σ(z)}(Δ_{σ(z)+k_1+1} f, Δ_{2σ(z)+k_2+1} g)(z)`. -/
def Bfun (σ : ℝ × ℝ → ℤ) (u : ℝ × ℝ → ℂ) (k₁ k₂ : ℕ) (f g : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℂ :=
  u z * Mj (σ z) (lpD 0 (σ z + (k₁ + 1 : ℕ)) f) (lpD 1 (2 * σ z + (k₂ + 1 : ℕ)) g) z

theorem measurable_Bfun {σ : ℝ × ℝ → ℤ} (hσ : Measurable σ) {u : ℝ × ℝ → ℂ}
    (hu : Measurable u) (k₁ k₂ : ℕ) {f g : ℝ × ℝ → ℂ} (hf : Measurable f) (hg : Measurable g) :
    Measurable (Bfun σ u k₁ k₂ f g) :=
  hu.mul (measurable_comp_selector hσ (H := fun j => Mj j (lpD 0 (j + (k₁ + 1 : ℕ)) f)
    (lpD 1 (2 * j + (k₂ + 1 : ℕ)) g)) fun j =>
      measurable_Mj j (measurable_lpD 0 _ hf) (measurable_lpD 1 _ hg))

/-- The linearized piece as a bilinear map on simple functions. -/
def Bsel (σ : ℝ × ℝ → ℤ) (u : ℝ × ℝ → ℂ) (k₁ k₂ : ℕ) :
    SimpleFunc (ℝ × ℝ) ℂ →ₗ[ℂ] SimpleFunc (ℝ × ℝ) ℂ →ₗ[ℂ] (ℝ × ℝ → ℂ) :=
  LinearMap.mk₂ ℂ (fun f g => Bfun σ u k₁ k₂ f g)
    (fun f f' g => by
      obtain ⟨A, hA⟩ := f.exists_forall_norm_le
      obtain ⟨A', hA'⟩ := f'.exists_forall_norm_le
      obtain ⟨B, hB⟩ := g.exists_forall_norm_le
      funext z
      simp only [Bfun, SimpleFunc.coe_add, Pi.add_apply]
      rw [lpD_add 0 _ f.measurable f'.measurable hA hA', Mj_add_left _
        (measurable_lpD 0 _ f.measurable) (measurable_lpD 0 _ f'.measurable)
        (measurable_lpD 1 _ g.measurable) (norm_lpD_le 0 _ hA) (norm_lpD_le 0 _ hA')
        (norm_lpD_le 1 _ hB), Pi.add_apply, mul_add])
    (fun c f g => by
      funext z
      simp only [Bfun, SimpleFunc.coe_smul, Pi.smul_apply, smul_eq_mul]
      rw [lpD_smul, Mj_smul_left, Pi.smul_apply, smul_eq_mul]; ring)
    (fun f g g' => by
      obtain ⟨A, hA⟩ := f.exists_forall_norm_le
      obtain ⟨B, hB⟩ := g.exists_forall_norm_le
      obtain ⟨B', hB'⟩ := g'.exists_forall_norm_le
      funext z
      simp only [Bfun, SimpleFunc.coe_add, Pi.add_apply]
      rw [lpD_add 1 _ g.measurable g'.measurable hB hB', Mj_add_right _
        (measurable_lpD 0 _ f.measurable) (measurable_lpD 1 _ g.measurable)
        (measurable_lpD 1 _ g'.measurable) (norm_lpD_le 0 _ hA) (norm_lpD_le 1 _ hB)
        (norm_lpD_le 1 _ hB'), Pi.add_apply, mul_add])
    (fun c f g => by
      funext z
      simp only [Bfun, SimpleFunc.coe_smul, Pi.smul_apply, smul_eq_mul]
      rw [lpD_smul, Mj_smul_right, Pi.smul_apply, smul_eq_mul]; ring)

theorem Bsel_apply (σ : ℝ × ℝ → ℤ) (u : ℝ × ℝ → ℂ) (k₁ k₂ : ℕ) (f g : SimpleFunc (ℝ × ℝ) ℂ) :
    Bsel σ u k₁ k₂ f g = Bfun σ u k₁ k₂ f g := rfl

/-! ### Interpolation of the linearized pieces (lines 689-692) -/

/-- The interpolation endpoint: `(1/p, 1/q) = ε (1/2, 1/2) + (1 - ε)(1/p_1, 1/q_1)`. -/
theorem interp_endpoint {p q r : ℝ} (hp : 1 < p) (hq : 1 < q) (hr : 1 ≤ r)
    (hpqr : 1 / p + 1 / q = 1 / r) :
    ∃ ε p₁ q₁ r₁ : ℝ, 0 < ε ∧ ε < 1 ∧ 1 < p₁ ∧ 1 < q₁ ∧ 1 ≤ r₁ ∧ 1 / p₁ + 1 / q₁ = 1 / r₁ ∧
      1 / p = ε / 2 + (1 - ε) / p₁ ∧ 1 / q = ε / 2 + (1 - ε) / q₁ ∧
      1 / r = ε / 1 + (1 - ε) / r₁ := by
  have hp1 : 1 / p < 1 := by rw [div_lt_one (by linarith)]; exact hp
  have hq1 : 1 / q < 1 := by rw [div_lt_one (by linarith)]; exact hq
  have hp0 : 0 < 1 / p := by positivity
  have hq0 : 0 < 1 / q := by positivity
  have hr1 : 1 / r ≤ 1 := by rw [div_le_one (by linarith)]; exact hr
  set ε := min (min (1 / p) (1 / q)) (min (1 - 1 / p) (1 - 1 / q)) with hε
  have hε0 : 0 < ε := lt_min (lt_min hp0 hq0) (lt_min (by linarith) (by linarith))
  have hεp : ε ≤ 1 / p := (min_le_left _ _).trans (min_le_left _ _)
  have hεq : ε ≤ 1 / q := (min_le_left _ _).trans (min_le_right _ _)
  have hεp' : ε ≤ 1 - 1 / p := (min_le_right _ _).trans (min_le_left _ _)
  have hεq' : ε ≤ 1 - 1 / q := (min_le_right _ _).trans (min_le_right _ _)
  have hε1 : ε < 1 := by linarith
  have hap : 0 < 1 / p - ε / 2 := by linarith
  have haq : 0 < 1 / q - ε / 2 := by linarith
  have har : 0 < 1 / r - ε := by linarith
  refine ⟨ε, (1 - ε) / (1 / p - ε / 2), (1 - ε) / (1 / q - ε / 2), (1 - ε) / (1 / r - ε),
    hε0, hε1, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [lt_div_iff₀ hap]; linarith
  · rw [lt_div_iff₀ haq]; linarith
  · rw [le_div_iff₀ har]; linarith
  · have h1 : (1 - ε) ≠ 0 := by linarith
    rw [one_div_div, one_div_div, one_div_div, ← add_div, ← hpqr]; ring
  · have h1 : (1 - ε) ≠ 0 := by linarith
    rw [div_div_cancel₀ h1]; ring
  · have h1 : (1 - ε) ≠ 0 := by linarith
    rw [div_div_cancel₀ h1]; ring
  · have h1 : (1 - ε) ≠ 0 := by linarith
    rw [div_div_cancel₀ h1]; ring

theorem ennreal_inv_interp {x y z θ : ℝ} (hx : 0 < x) (hy : 0 < y) (hz : 0 < z) (hθ0 : 0 ≤ θ)
    (hθ1 : θ ≤ 1) (h : 1 / z = (1 - θ) / x + θ / y) :
    (ENNReal.ofReal z)⁻¹ = ENNReal.ofReal (1 - θ) * (ENNReal.ofReal x)⁻¹ +
      ENNReal.ofReal θ * (ENNReal.ofReal y)⁻¹ := by
  rw [← ENNReal.ofReal_inv_of_pos hx, ← ENNReal.ofReal_inv_of_pos hy,
    ← ENNReal.ofReal_inv_of_pos hz, ← ENNReal.ofReal_mul (by linarith),
    ← ENNReal.ofReal_mul hθ0, ← ENNReal.ofReal_add (by positivity) (by positivity)]
  congr 1
  rw [← one_div, ← one_div, ← one_div, h]; ring

/-- **The interpolated bound for the linearized pieces** (simple functions). -/
theorem Bsel_interp {p q r : ℝ} (hp : 1 < p) (hq : 1 < q) (hr : 1 ≤ r)
    (hpqr : 1 / p + 1 / q = 1 / r) :
    ∃ θ C₀ δ K : ℝ, θ ∈ Ioo 0 1 ∧ 0 < C₀ ∧ 0 < δ ∧ 0 ≤ K ∧ ∀ (k₁ k₂ : ℕ)
    {σ : ℝ × ℝ → ℤ} {u : ℝ × ℝ → ℂ}, Measurable σ → Measurable u → (∀ z, ‖u z‖ ≤ 1) →
    ∀ (F : Finset ℤ), (∀ z, σ z ∈ F) → ∀ (f g : SimpleFunc (ℝ × ℝ) ℂ),
    Integrable f → Integrable g →
    eLpNorm (Bfun σ u k₁ k₂ f g) (ENNReal.ofReal r) volume ≤
      ENNReal.ofReal ((C₀ * ((2 : ℝ) ^ (max k₁ k₂)) ^ (-δ)) ^ (1 - θ) *
        (K * (k₂ + 6) ^ 2 + 1) ^ θ) *
        eLpNorm (f : ℝ × ℝ → ℂ) (ENNReal.ofReal p) volume *
          eLpNorm (g : ℝ × ℝ → ℂ) (ENNReal.ofReal q) volume := by
  obtain ⟨ε, p₁, q₁, r₁, hε0, hε1, hp₁, hq₁, hr₁, hpqr₁, ep, eq, er⟩ :=
    interp_endpoint hp hq hr hpqr
  obtain ⟨K, hK, hH⟩ := highPiece_Lp hp₁ hq₁ hr₁ hpqr₁
  obtain ⟨C, δ, hC, hδ, hL2⟩ := sum_Mj_piece_L1
  refine ⟨1 - ε, 2 * C, δ, K, ⟨by linarith, by linarith⟩, by positivity, hδ, hK,
    fun k₁ k₂ σ u hσ hu hu1 F hσF f g hf hg => ?_⟩
  have hθ : (1 : ℝ) - (1 - ε) = ε := by ring
  -- the pointwise domination by the pieces
  have hdom : ∀ (f g : ℝ × ℝ → ℂ) (z : ℝ × ℝ), ‖Bfun σ u k₁ k₂ f g z‖ₑ ≤
      ‖Mj (σ z) (lpD 0 (σ z + (k₁ + 1 : ℕ)) f) (lpD 1 (2 * σ z + (k₂ + 1 : ℕ)) g) z‖ₑ := by
    intro f g z
    rw [Bfun, enorm_mul]
    calc ‖u z‖ₑ * _ ≤ 1 * _ := by
          gcongr
          rw [← ofReal_norm, ← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (hu1 z)
      _ = _ := one_mul _
  have hsum : ∀ (f g : ℝ × ℝ → ℂ) (z : ℝ × ℝ), ‖Bfun σ u k₁ k₂ f g z‖ₑ ≤
      ∑ j ∈ F, ‖Mj j (lpD 0 (j + (k₁ + 1 : ℕ)) f) (lpD 1 (2 * j + (k₂ + 1 : ℕ)) g) z‖ₑ :=
    fun f g z => (hdom f g z).trans (Finset.single_le_sum (f := fun j =>
      ‖Mj j (lpD 0 (j + (k₁ + 1 : ℕ)) f) (lpD 1 (2 * j + (k₂ + 1 : ℕ)) g) z‖ₑ)
      (fun _ _ => bot_le) (hσF z))
  -- the `L^2 × L^2 → L^1` endpoint
  have hB₀ : ∀ (f g : SimpleFunc (ℝ × ℝ) ℂ), Integrable f → Integrable g →
      eLpNorm (Bsel σ u k₁ k₂ f g) 1 volume ≤
        ENNReal.ofReal (2 * C * ((2 : ℝ) ^ (max k₁ k₂)) ^ (-δ)) *
          eLpNorm (f : ℝ × ℝ → ℂ) 2 volume * eLpNorm (g : ℝ × ℝ → ℂ) 2 volume := by
    intro f g hf hg
    obtain ⟨A, hA⟩ := f.exists_forall_norm_le
    obtain ⟨B, hB⟩ := g.exists_forall_norm_le
    rw [Bsel_apply, mul_assoc]
    calc eLpNorm (Bfun σ u k₁ k₂ f g) 1 volume
        ≤ eLpNorm (fun z => ∑ j ∈ F, ‖Mj j (lpD 0 (j + (k₁ + 1 : ℕ)) f)
            (lpD 1 (2 * j + (k₂ + 1 : ℕ)) g) z‖ₑ) 1 volume :=
          eLpNorm_mono_enorm fun z => (hsum f g z).trans (le_of_eq (enorm_eq_self _).symm)
      _ ≤ ∑ j ∈ F, eLpNorm (fun z => ‖Mj j (lpD 0 (j + (k₁ + 1 : ℕ)) f)
            (lpD 1 (2 * j + (k₂ + 1 : ℕ)) g) z‖ₑ) 1 volume :=
          eLpNorm_finset_sum_le F (fun j => (measurable_Mj j (measurable_lpD 0 _ f.measurable)
            (measurable_lpD 1 _ g.measurable)).enorm) le_rfl
      _ = ∑ j ∈ F, eLpNorm (Mj j (lpD 0 (j + (k₁ + 1 : ℕ)) f)
            (lpD 1 (2 * j + (k₂ + 1 : ℕ)) g)) 1 volume :=
          Finset.sum_congr rfl fun j _ => eLpNorm_enorm _
      _ ≤ _ := hL2 k₁ k₂ F f.measurable g.measurable hf hg hA hB
  have hBm : ∀ (f g : SimpleFunc (ℝ × ℝ) ℂ), Measurable (Bsel σ u k₁ k₂ f g) := fun f g =>
    measurable_Bfun hσ hu k₁ k₂ f.measurable g.measurable
  have hBi : ∀ (f g : SimpleFunc (ℝ × ℝ) ℂ), Integrable f → Integrable g →
      Integrable (Bsel σ u k₁ k₂ f g) := by
    intro f g hf hg
    obtain ⟨A, hA⟩ := f.exists_forall_norm_le
    obtain ⟨B, hB⟩ := g.exists_forall_norm_le
    rw [← memLp_one_iff_integrable]
    refine ⟨(hBm f g).aestronglyMeasurable, lt_of_le_of_lt (hB₀ f g hf hg) ?_⟩
    exact ENNReal.mul_lt_top (ENNReal.mul_lt_top ENNReal.ofReal_lt_top
      (memLp_two_of_bdd' hf hA).eLpNorm_lt_top) (memLp_two_of_bdd' hg hB).eLpNorm_lt_top
  -- the `L^{p_1} × L^{q_1} → L^{r_1}` endpoint
  have hB₁ : ∀ (f g : SimpleFunc (ℝ × ℝ) ℂ), Integrable f → Integrable g →
      eLpNorm (Bsel σ u k₁ k₂ f g) (ENNReal.ofReal r₁) volume ≤
        ENNReal.ofReal (K * (k₂ + 6) ^ 2 + 1) *
          eLpNorm (f : ℝ × ℝ → ℂ) (ENNReal.ofReal p₁) volume *
            eLpNorm (g : ℝ × ℝ → ℂ) (ENNReal.ofReal q₁) volume := by
    intro f g _ _
    obtain ⟨A, hA⟩ := f.exists_forall_norm_le
    obtain ⟨B, hB⟩ := g.exists_forall_norm_le
    obtain ⟨P, -, hPdom, hPn⟩ := hH (k₁ + 1) (k₂ + 1) f.measurable g.measurable hA hB
    rw [Bsel_apply, mul_assoc]
    calc eLpNorm (Bfun σ u k₁ k₂ f g) (ENNReal.ofReal r₁) volume
        ≤ eLpNorm P (ENNReal.ofReal r₁) volume :=
          eLpNorm_mono_enorm fun z => (hdom f g z).trans ((hPdom (σ z) z).trans
            (le_of_eq (enorm_eq_self _).symm))
      _ ≤ _ := hPn.trans (by
          gcongr
          push_cast
          nlinarith [sq_nonneg ((k₂ : ℝ) + 6)])
  have h2 : (1 : ℝ≥0∞) ≤ 2 := by norm_num
  have hp₁' : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p₁ := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp₁.le
  have hq₁' : (1 : ℝ≥0∞) ≤ ENNReal.ofReal q₁ := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hq₁.le
  have hr₁' : (1 : ℝ≥0∞) ≤ ENNReal.ofReal r₁ := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hr₁
  have hres := bilinear_interpolation (Bsel σ u k₁ k₂) hBm hBi
    (p₀ := 2) (q₀ := 2) (r₀ := 1) (p₁ := ENNReal.ofReal p₁) (q₁ := ENNReal.ofReal q₁)
    (r₁ := ENNReal.ofReal r₁) (p := ENNReal.ofReal p) (q := ENNReal.ofReal q)
    (r := ENNReal.ofReal r) h2 hp₁' h2 hq₁' le_rfl hr₁'
    (θ := 1 - ε) ⟨by linarith, by linarith⟩ ?_ ?_ ?_ ENNReal.ofReal_ne_top
    (M₀ := 2 * C * ((2 : ℝ) ^ (max k₁ k₂)) ^ (-δ)) (M₁ := K * (k₂ + 6) ^ 2 + 1)
    (by positivity) (by positivity) hB₀ hB₁ f g hf hg
  · rw [Bsel_apply] at hres
    exact hres
  · rw [show (2 : ℝ≥0∞) = ENNReal.ofReal 2 by simp]
    exact ennreal_inv_interp (by norm_num) (by linarith) (by linarith) (by linarith)
      (by linarith) (by rw [ep]; ring)
  · rw [show (2 : ℝ≥0∞) = ENNReal.ofReal 2 by simp]
    exact ennreal_inv_interp (by norm_num) (by linarith) (by linarith) (by linarith)
      (by linarith) (by rw [eq]; ring)
  · rw [show (1 : ℝ≥0∞) = ENNReal.ofReal 1 by simp]
    exact ennreal_inv_interp (by norm_num) (by linarith) (by linarith) (by linarith)
      (by linarith) (by rw [er]; ring)

/-! ### From simple functions to bounded functions, and from finitely many scales to `sup_j` -/

theorem integrable_kDel (m : ℤ) : Integrable (kDel m) :=
  (integrable_kerScaled monoKPhi m).sub (integrable_kerScaled monoKPhi (m - 1))

theorem lpD_tendsto (ℓ : Fin 2) (m : ℤ) {G : ℕ → ℝ × ℝ → ℂ} {G₀ : ℝ × ℝ → ℂ}
    (hG : ∀ n, Measurable (G n)) (hG₀ : Measurable G₀) {M : ℝ} (hM : ∀ n z, ‖G n z‖ ≤ M)
    (hM₀ : ∀ z, ‖G₀ z‖ ≤ M) (hlim : ∀ z, Tendsto (fun n => G n z) atTop (𝓝 (G₀ z)))
    (w : ℝ × ℝ) : Tendsto (fun n => lpD ℓ m (G n) w) atTop (𝓝 (lpD ℓ m G₀ w)) := by
  rw [← monoPt_act_pas ℓ w]
  simp_rw [lpD_apply ℓ m (hG _) (hM _), lpD_apply ℓ m hG₀ hM₀]
  refine tendsto_integral_of_dominated_convergence (fun s => ‖kDel m s‖ * M) (fun n => ?_)
    ((integrable_kDel m).norm.mul_const M) (fun n => Eventually.of_forall fun s => ?_)
    (Eventually.of_forall fun s => ?_)
  · exact ((measurable_kDel m).mul ((measurable_monoFib (hG n) _).comp
      (measurable_const.sub measurable_id))).aestronglyMeasurable
  · rw [norm_mul]; exact mul_le_mul_of_nonneg_left (hM n _) (norm_nonneg _)
  · exact (hlim _).const_mul _

theorem Mj_tendsto (j : ℤ) {G₁ G₂ : ℕ → ℝ × ℝ → ℂ} {H₁ H₂ : ℝ × ℝ → ℂ}
    (hG₁ : ∀ n, Measurable (G₁ n)) (hG₂ : ∀ n, Measurable (G₂ n)) {M₁ M₂ : ℝ}
    (hM₁ : ∀ n z, ‖G₁ n z‖ ≤ M₁) (hM₂ : ∀ n z, ‖G₂ n z‖ ≤ M₂)
    (hl₁ : ∀ z, Tendsto (fun n => G₁ n z) atTop (𝓝 (H₁ z)))
    (hl₂ : ∀ z, Tendsto (fun n => G₂ n z) atTop (𝓝 (H₂ z))) (z : ℝ × ℝ) :
    Tendsto (fun n => Mj j (G₁ n) (G₂ n) z) atTop (𝓝 (Mj j H₁ H₂ z)) := by
  simp_rw [Mj_apply]
  refine tendsto_integral_of_dominated_convergence (fun t => psiJ j t * (M₁ * M₂))
    (fun n => ?_) ((integrable_psiJ j).mul_const _) (fun n => Eventually.of_forall fun t => ?_)
    (Eventually.of_forall fun t => ?_)
  · exact (integrable_Mj_integrand j (hG₁ n) (hG₂ n) (hM₁ n) (hM₂ n) z).aestronglyMeasurable
  · rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (psiJ_nonneg j t)]
    exact mul_le_mul_of_nonneg_left (mul_le_mul (hM₁ n _) (hM₂ n _) (norm_nonneg _)
      ((norm_nonneg _).trans (hM₁ n 0))) (psiJ_nonneg j t)
  · exact ((hl₁ _).mul (hl₂ _)).const_mul _

/-- The simple approximations `approxOn f univ 0`. -/
def sApprox {f : ℝ × ℝ → ℂ} (hf : Measurable f) (n : ℕ) : SimpleFunc (ℝ × ℝ) ℂ :=
  SimpleFunc.approxOn f hf univ 0 (mem_univ 0) n

theorem sApprox_tendsto {f : ℝ × ℝ → ℂ} (hf : Measurable f) (z : ℝ × ℝ) :
    Tendsto (fun n => sApprox hf n z) atTop (𝓝 (f z)) :=
  SimpleFunc.tendsto_approxOn hf (mem_univ 0) (by rw [closure_univ]; exact mem_univ _)

theorem norm_sApprox_le {f : ℝ × ℝ → ℂ} (hf : Measurable f) (n : ℕ) (z : ℝ × ℝ) :
    ‖sApprox hf n z‖ ≤ 2 * ‖f z‖ := by
  have := SimpleFunc.norm_approxOn_y₀_le hf (mem_univ 0) z n
  simp only [sub_zero] at this
  unfold sApprox; linarith

theorem integrable_sApprox {f : ℝ × ℝ → ℂ} (hf : Measurable f) (hfi : Integrable f) (n : ℕ) :
    Integrable (sApprox hf n) :=
  Integrable.mono' (hfi.norm.const_mul 2) (sApprox hf n).aestronglyMeasurable
    (Eventually.of_forall fun z => norm_sApprox_le hf n z)

theorem eLpNorm_sApprox_le {f : ℝ × ℝ → ℂ} (hf : Measurable f) (n : ℕ) (p : ℝ≥0∞) :
    eLpNorm (sApprox hf n : ℝ × ℝ → ℂ) p volume ≤ 2 * eLpNorm f p volume := by
  calc eLpNorm (sApprox hf n : ℝ × ℝ → ℂ) p volume ≤ eLpNorm ((2 : ℂ) • f) p volume :=
        eLpNorm_mono fun z => by
          rw [Pi.smul_apply, smul_eq_mul, norm_mul]; simpa using norm_sApprox_le hf n z
    _ = 2 * eLpNorm f p volume := by
        rw [eLpNorm_const_smul, ← ofReal_norm]; norm_num

/-- **The interpolated bound for bounded integrable functions.** -/
theorem Bfun_bound {p q r : ℝ} (hp : 1 < p) (hq : 1 < q) (hr : 1 ≤ r)
    (hpqr : 1 / p + 1 / q = 1 / r) :
    ∃ θ C₀ δ K : ℝ, θ ∈ Ioo 0 1 ∧ 0 < C₀ ∧ 0 < δ ∧ 0 ≤ K ∧ ∀ (k₁ k₂ : ℕ)
    {σ : ℝ × ℝ → ℤ} {u : ℝ × ℝ → ℂ}, Measurable σ → Measurable u → (∀ z, ‖u z‖ ≤ 1) →
    ∀ (F : Finset ℤ), (∀ z, σ z ∈ F) → ∀ {a b : ℝ × ℝ → ℂ}, Measurable a → Measurable b →
    Integrable a → Integrable b → ∀ {A B : ℝ}, (∀ z, ‖a z‖ ≤ A) → (∀ z, ‖b z‖ ≤ B) →
    eLpNorm (Bfun σ u k₁ k₂ a b) (ENNReal.ofReal r) volume ≤
      4 * ENNReal.ofReal ((C₀ * ((2 : ℝ) ^ (max k₁ k₂)) ^ (-δ)) ^ (1 - θ) *
        (K * (k₂ + 6) ^ 2 + 1) ^ θ) *
        eLpNorm a (ENNReal.ofReal p) volume * eLpNorm b (ENNReal.ofReal q) volume := by
  obtain ⟨θ, C₀, δ, K, hθ, hC₀, hδ, hK, hI⟩ := Bsel_interp hp hq hr hpqr
  refine ⟨θ, C₀, δ, K, hθ, hC₀, hδ, hK, fun k₁ k₂ σ u hσ hu hu1 F hσF a b ha hb hai hbi A B hA hB
    => ?_⟩
  set c := ENNReal.ofReal ((C₀ * ((2 : ℝ) ^ (max k₁ k₂)) ^ (-δ)) ^ (1 - θ) *
    (K * (k₂ + 6) ^ 2 + 1) ^ θ)
  set an := fun n => (sApprox ha n : ℝ × ℝ → ℂ)
  set bn := fun n => (sApprox hb n : ℝ × ℝ → ℂ)
  have hA0 : 0 ≤ A := (norm_nonneg _).trans (hA 0)
  have hB0 : 0 ≤ B := (norm_nonneg _).trans (hB 0)
  have hanb : ∀ n z, ‖an n z‖ ≤ 2 * A := fun n z =>
    (norm_sApprox_le ha n z).trans (by linarith [hA z])
  have hbnb : ∀ n z, ‖bn n z‖ ≤ 2 * B := fun n z =>
    (norm_sApprox_le hb n z).trans (by linarith [hB z])
  have hlim : ∀ z, Tendsto (fun n => Bfun σ u k₁ k₂ (an n) (bn n) z) atTop
      (𝓝 (Bfun σ u k₁ k₂ a b z)) := by
    intro z
    unfold Bfun
    refine Tendsto.const_mul _ (Mj_tendsto (σ z)
      (fun n => measurable_lpD 0 _ (sApprox ha n).measurable)
      (fun n => measurable_lpD 1 _ (sApprox hb n).measurable)
      (fun n => norm_lpD_le 0 _ (hanb n)) (fun n => norm_lpD_le 1 _ (hbnb n))
      (lpD_tendsto 0 _ (fun n => (sApprox ha n).measurable) ha hanb
        (fun z => (hA z).trans (by linarith)) (sApprox_tendsto ha))
      (lpD_tendsto 1 _ (fun n => (sApprox hb n).measurable) hb hbnb
        (fun z => (hB z).trans (by linarith)) (sApprox_tendsto hb)) z)
  have hmeas : ∀ n, AEStronglyMeasurable (Bfun σ u k₁ k₂ (an n) (bn n)) volume := fun n =>
    (measurable_Bfun hσ hu k₁ k₂ (sApprox ha n).measurable
      (sApprox hb n).measurable).aestronglyMeasurable
  refine (Lp.eLpNorm_lim_le_liminf_eLpNorm hmeas _ (Eventually.of_forall hlim)).trans ?_
  have hbd : ∀ n, eLpNorm (Bfun σ u k₁ k₂ (an n) (bn n)) (ENNReal.ofReal r) volume ≤
      4 * c * eLpNorm a (ENNReal.ofReal p) volume * eLpNorm b (ENNReal.ofReal q) volume := by
    intro n
    refine (hI k₁ k₂ hσ hu hu1 F hσF (sApprox ha n) (sApprox hb n) (integrable_sApprox ha hai n)
      (integrable_sApprox hb hbi n)).trans ?_
    calc c * eLpNorm (an n) (ENNReal.ofReal p) volume * eLpNorm (bn n) (ENNReal.ofReal q) volume
        ≤ c * (2 * eLpNorm a (ENNReal.ofReal p) volume) *
            (2 * eLpNorm b (ENNReal.ofReal q) volume) := by
          gcongr
          · exact eLpNorm_sApprox_le ha n _
          · exact eLpNorm_sApprox_le hb n _
      _ = _ := by ring
  refine (Filter.liminf_le_liminf (Eventually.of_forall hbd)).trans ?_
  rw [Filter.liminf_const]

/-- `sup_{j ∈ F} |M_j(Δ_{j+k_1+1} a, Δ_{2j+k_2+1} b)|` is the linearized piece for a measurable
selector `σ` and phase `u`. -/
theorem iSup_finset_eq_Bfun (k₁ k₂ : ℕ) (F : Finset ℤ) (hF : F.Nonempty) {a b : ℝ × ℝ → ℂ}
    (ha : Measurable a) (hb : Measurable b) :
    ∃ σ : ℝ × ℝ → ℤ, ∃ u : ℝ × ℝ → ℂ, Measurable σ ∧ Measurable u ∧ (∀ z, ‖u z‖ ≤ 1) ∧
      (∀ z, σ z ∈ F) ∧ ∀ z, (⨆ j ∈ F, ‖Mj j (lpD 0 (j + (k₁ + 1 : ℕ)) a)
        (lpD 1 (2 * j + (k₂ + 1 : ℕ)) b) z‖ₑ) = ‖Bfun σ u k₁ k₂ a b z‖ₑ := by
  set H : ℤ → ℝ × ℝ → ℂ := fun j => Mj j (lpD 0 (j + (k₁ + 1 : ℕ)) a)
    (lpD 1 (2 * j + (k₂ + 1 : ℕ)) b) with hHdef
  have hH : ∀ j, Measurable (H j) := fun j =>
    measurable_Mj j (measurable_lpD 0 _ ha) (measurable_lpD 1 _ hb)
  obtain ⟨σ, hσ, hσF⟩ := exists_measurable_argmax F hF (fun j z => ‖H j z‖)
    (fun j => (hH j).norm)
  set W : ℝ × ℝ → ℂ := fun z => H (σ z) z
  have hW : Measurable W := measurable_comp_selector hσ hH
  refine ⟨σ, fun z => (starRingEnd ℂ) (W z) / (‖W z‖ : ℂ), hσ,
    ((Complex.continuous_conj.measurable.comp hW).div
      (Complex.measurable_ofReal.comp hW.norm)), fun z => ?_, fun z => (hσF z).1, fun z => ?_⟩
  · rw [norm_div, Complex.norm_conj, Complex.norm_real, Real.norm_eq_abs, abs_norm]
    exact div_self_le_one _
  · have hB : Bfun σ (fun z => (starRingEnd ℂ) (W z) / (‖W z‖ : ℂ)) k₁ k₂ a b z =
        ((‖W z‖ : ℝ) : ℂ) := by
      unfold Bfun
      change (starRingEnd ℂ) (W z) / (‖W z‖ : ℂ) * W z = _
      by_cases h0 : W z = 0
      · simp [h0]
      · have hn : (‖W z‖ : ℂ) ≠ 0 := by exact_mod_cast norm_ne_zero_iff.2 h0
        rw [div_mul_eq_mul_div, mul_comm, Complex.mul_conj, Complex.normSq_eq_norm_sq]
        field_simp
        push_cast; ring
    rw [hB, ← ofReal_norm, Complex.norm_real, Real.norm_eq_abs, abs_norm, ofReal_norm]
    refine le_antisymm (iSup₂_le fun j hj => ?_) (le_iSup₂_of_le (σ z) (hσF z).1 le_rfl)
    rw [enorm_le_iff_norm_le]
    exact (hσF z).2 j hj

/-- **The bound for `M^{(k)}`** (lines 689-692): for bounded integrable `a, b`,
`‖sup_j |M_j(Δ_{j+k_1+1} a, Δ_{2j+k_2+1} b)|‖_r ≲ 2^{-δ'max(k_1,k_2)} (k_2+6)^{2θ} ‖a‖_p ‖b‖_q`. -/
theorem MkH_bound {p q r : ℝ} (hp : 1 < p) (hq : 1 < q) (hr : 1 ≤ r)
    (hpqr : 1 / p + 1 / q = 1 / r) :
    ∃ θ C₀ δ K : ℝ, θ ∈ Ioo 0 1 ∧ 0 < C₀ ∧ 0 < δ ∧ 0 ≤ K ∧ ∀ (k₁ k₂ : ℕ)
    {a b : ℝ × ℝ → ℂ}, Measurable a → Measurable b →
    Integrable a → Integrable b → ∀ {A B : ℝ}, (∀ z, ‖a z‖ ≤ A) → (∀ z, ‖b z‖ ≤ B) →
    eLpNorm (fun z => ⨆ j : ℤ, ‖Mj j (lpD 0 (j + (k₁ + 1 : ℕ)) a)
        (lpD 1 (2 * j + (k₂ + 1 : ℕ)) b) z‖ₑ) (ENNReal.ofReal r) volume ≤
      4 * ENNReal.ofReal ((C₀ * ((2 : ℝ) ^ (max k₁ k₂)) ^ (-δ)) ^ (1 - θ) *
        (K * (k₂ + 6) ^ 2 + 1) ^ θ) *
        eLpNorm a (ENNReal.ofReal p) volume * eLpNorm b (ENNReal.ofReal q) volume := by
  obtain ⟨θ, C₀, δ, K, hθ, hC₀, hδ, hK, hI⟩ := Bfun_bound hp hq hr hpqr
  refine ⟨θ, C₀, δ, K, hθ, hC₀, hδ, hK, fun k₁ k₂ a b ha hb hai hbi A B hA hB => ?_⟩
  set H : ℤ → ℝ × ℝ → ℝ≥0∞ := fun j z => ‖Mj j (lpD 0 (j + (k₁ + 1 : ℕ)) a)
    (lpD 1 (2 * j + (k₂ + 1 : ℕ)) b) z‖ₑ with hHdef
  have hHm : ∀ j, Measurable (H j) := fun j =>
    (measurable_Mj j (measurable_lpD 0 _ ha) (measurable_lpD 1 _ hb)).enorm
  set FN : ℕ → ℝ × ℝ → ℝ≥0∞ := fun N z => ⨆ j ∈ Finset.Icc (-(N : ℤ)) N, H j z with hFN
  have hFNm : ∀ N, Measurable (FN N) := fun N =>
    Measurable.iSup fun j => Measurable.iSup fun _ => hHm j
  have hmono : Monotone FN := by
    intro N N' hN z
    refine iSup₂_le fun j hj => le_iSup₂_of_le j ?_ le_rfl
    rw [Finset.mem_Icc] at hj ⊢
    constructor <;> omega
  have hsup : (fun z => ⨆ j : ℤ, H j z) = fun z => ⨆ N, FN N z := by
    funext z
    refine le_antisymm (iSup_le fun j => ?_)
      (iSup_le fun N => iSup₂_le fun j _ => le_iSup (fun j => H j z) j)
    refine le_iSup_of_le j.natAbs (le_iSup₂_of_le j ?_ le_rfl)
    rw [Finset.mem_Icc]; constructor <;> omega
  rw [hsup]
  refine (eLpNorm_iSup_nat_le hFNm hmono (by simp; linarith) ENNReal.ofReal_ne_top).trans ?_
  refine iSup_le fun N => ?_
  obtain ⟨σ, u, hσ, hu, hu1, hσF, he⟩ := iSup_finset_eq_Bfun k₁ k₂ (Finset.Icc (-(N : ℤ)) N)
    ⟨0, by simp⟩ ha hb
  calc eLpNorm (FN N) (ENNReal.ofReal r) volume
      = eLpNorm (Bfun σ u k₁ k₂ a b) (ENNReal.ofReal r) volume := by
        refine eLpNorm_congr_enorm_ae (Eventually.of_forall fun z => ?_)
        rw [enorm_eq_self]; exact he z
    _ ≤ _ := hI k₁ k₂ hσ hu hu1 _ hσF ha hb hai hbi hA hB

/-! ### The telescoping expansion `a - S_j a = ∑_{k ≥ 1} Δ_{j+k} a` -/

theorem integral_monoKPhi : ∫ s, monoKPhi s = 1 := by
  have h := ms8_fourier_KPhi 0
  rw [Real.fourier_real_eq_integral_exp_smul] at h
  simp only [mul_zero, Complex.ofReal_zero, zero_mul, Complex.exp_zero, one_smul] at h
  rw [h]
  have : monoPhi 0 = 1 := by
    unfold monoPhi
    exact Real.smoothTransition.one_of_one_le (by norm_num)
  rw [this, Complex.ofReal_one]

/-- `S_m g → g` pointwise as `m → ∞` for continuous bounded `g`. -/
theorem lpS_tendsto_self (ℓ : Fin 2) {g : ℝ × ℝ → ℂ} (hg : Continuous g) {M : ℝ}
    (hM : ∀ z, ‖g z‖ ≤ M) (z : ℝ × ℝ) (j : ℤ) :
    Tendsto (fun K : ℕ => lpS ℓ (j + K) g z) atTop (𝓝 (g z)) := by
  have e : ∀ m : ℤ, lpS ℓ m g z = ∫ u, monoKPhi u * g (z - monoEj ℓ ((2 : ℝ) ^ (-m) * u)) := by
    intro m
    have hm : (0 : ℝ) < 2 ^ m := by positivity
    unfold lpS monoP monoCConv
    have h := Measure.integral_comp_mul_left
      (fun u => (((2 : ℝ) ^ m : ℝ) : ℂ) * (monoKPhi u * g (z - monoEj ℓ ((2 : ℝ) ^ (-m) * u))))
      ((2 : ℝ) ^ m)
    have e2 : ∀ s : ℝ, (2 : ℝ) ^ (-m) * ((2 : ℝ) ^ m * s) = s := fun s => by
      rw [← mul_assoc, ← zpow_add₀ (by norm_num), neg_add_cancel, zpow_zero, one_mul]
    simp_rw [e2] at h
    rw [show (fun s => (((2 : ℝ) ^ m : ℝ) : ℂ) * monoKPhi ((2 : ℝ) ^ m * s) * g (z - monoEj ℓ s))
        = fun s => (((2 : ℝ) ^ m : ℝ) : ℂ) * (monoKPhi ((2 : ℝ) ^ m * s) * g (z - monoEj ℓ s)) from
        funext fun s => by ring, h, integral_const_mul, abs_inv, abs_of_pos hm,
      Complex.real_smul, ← mul_assoc, Complex.ofReal_inv,
      inv_mul_cancel₀ (by exact_mod_cast hm.ne' : (((2 : ℝ) ^ m : ℝ) : ℂ) ≠ 0), one_mul]
  simp_rw [e]
  have hlim : (𝓝 (g z)) = 𝓝 (∫ u, monoKPhi u * g (z - monoEj ℓ (0 * u))) := by
    simp only [zero_mul]
    rw [show monoEj ℓ 0 = 0 by simp [monoEj, monoPt], sub_zero, integral_mul_const,
      integral_monoKPhi, one_mul]
  rw [hlim]
  have hz : Tendsto (fun K : ℕ => (2 : ℝ) ^ (-(j + (K : ℤ)))) atTop (𝓝 0) := by
    have e3 : ∀ K : ℕ, (2 : ℝ) ^ (-(j + (K : ℤ))) = (2 ^ j)⁻¹ * (1 / 2) ^ K := fun K => by
      rw [zpow_neg, zpow_add₀ (by norm_num), zpow_natCast, mul_inv, one_div, inv_pow]
    simp_rw [e3]
    rw [show (0 : ℝ) = (2 ^ j)⁻¹ * 0 by ring]
    exact tendsto_const_nhds.mul (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num)
      (by norm_num))
  refine tendsto_integral_filter_of_dominated_convergence (fun u => ‖monoKPhi u‖ * M)
    (Eventually.of_forall fun m => ?_) (Eventually.of_forall fun m => Eventually.of_forall
      fun u => ?_) (monoKPhi.integrable.norm.mul_const M) (Eventually.of_forall fun u => ?_)
  · exact (monoKPhi.continuous.mul (hg.comp (continuous_const.sub
      ((continuous_monoPt ℓ).comp ((continuous_const.mul continuous_id).prodMk
        continuous_const))))).aestronglyMeasurable
  · rw [norm_mul]; exact mul_le_mul_of_nonneg_left (hM _) (norm_nonneg _)
  · refine Tendsto.const_mul _ ((hg.tendsto _).comp ?_)
    refine tendsto_const_nhds.sub ?_
    have hc : Continuous fun c : ℝ => monoEj ℓ (c * u) :=
      (continuous_monoPt ℓ).comp ((continuous_id.mul continuous_const).prodMk continuous_const)
    exact (hc.tendsto 0).comp hz

theorem sum_lpD_telescope (ℓ : Fin 2) (j : ℤ) (g : ℝ × ℝ → ℂ) (K : ℕ) :
    ∑ k ∈ Finset.range K, lpD ℓ (j + (k + 1 : ℕ)) g = lpS ℓ (j + K) g - lpS ℓ j g := by
  induction K with
  | zero => simp
  | succ K ih =>
    rw [Finset.sum_range_succ, ih, lpD]
    have : j + ((K + 1 : ℕ) : ℤ) - 1 = j + K := by push_cast; ring
    rw [this]; push_cast; abel

theorem norm_sum_le_of_bdd {X ι : Type*} (s : Finset ι) {F : ι → X → ℂ} {M : ι → ℝ}
    (hF : ∀ i z, ‖F i z‖ ≤ M i) (z : X) : ‖(∑ i ∈ s, F i) z‖ ≤ ∑ i ∈ s, M i := by
  rw [Finset.sum_apply]
  exact (norm_sum_le _ _).trans (Finset.sum_le_sum fun i _ => hF i z)

/-- Bilinear expansion of `M_j` over finite sums. -/
theorem Mj_sum_sum (j : ℤ) (s t : Finset ℕ) {F G : ℕ → ℝ × ℝ → ℂ}
    (hF : ∀ i, Measurable (F i)) (hG : ∀ i, Measurable (G i)) {MF MG : ℕ → ℝ}
    (hMF : ∀ i z, ‖F i z‖ ≤ MF i) (hMG : ∀ i z, ‖G i z‖ ≤ MG i) (z : ℝ × ℝ) :
    Mj j (∑ i ∈ s, F i) (∑ i ∈ t, G i) z = ∑ i ∈ s, ∑ i' ∈ t, Mj j (F i) (G i') z := by
  simp_rw [Mj_apply, Finset.sum_apply]
  have hin : ∀ i ∈ s, ∑ i' ∈ t, ∫ t', (psiJ j t' : ℂ) * (F i (z.1 + t', z.2) *
      G i' (z.1, z.2 + t' ^ 2)) = ∫ t', ∑ i' ∈ t, (psiJ j t' : ℂ) * (F i (z.1 + t', z.2) *
      G i' (z.1, z.2 + t' ^ 2)) := fun i _ => (integral_finsetSum _ fun i' _ =>
        integrable_Mj_integrand j (hF i) (hG i') (hMF i) (hMG i') z).symm
  rw [Finset.sum_congr rfl hin, ← integral_finsetSum _ fun i _ => integrable_finsetSum _
    fun i' _ => integrable_Mj_integrand j (hF i) (hG i') (hMF i) (hMG i') z]
  congr 1; funext t'
  rw [Finset.sum_mul_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Finset.mul_sum]

theorem ennreal_sum_range_prod_le_tsum (f : ℕ × ℕ → ℝ≥0∞) (K : ℕ) :
    ∑ i ∈ Finset.range K, ∑ i' ∈ Finset.range K, f (i, i') ≤ ∑' k : ℕ × ℕ, f k := by
  rw [← Finset.sum_product']
  exact ENNReal.sum_le_tsum _

/-- **The high-frequency part as a sum of pieces**:
`|M_j(a - S_j a, b - S_{2j} b)| ≤ ∑_{k_1, k_2 ≥ 0} |M_j(Δ_{j+k_1+1} a, Δ_{2j+k_2+1} b)|`
for continuous bounded `a, b`. -/
theorem enorm_Mj_high_le (j : ℤ) {a b : ℝ × ℝ → ℂ} (ha : Continuous a) (hb : Continuous b)
    {A B : ℝ} (hA : ∀ z, ‖a z‖ ≤ A) (hB : ∀ z, ‖b z‖ ≤ B) (z : ℝ × ℝ) :
    ‖Mj j (a - lpS 0 j a) (b - lpS 1 (2 * j) b) z‖ₑ ≤
      ∑' k : ℕ × ℕ, ‖Mj j (lpD 0 (j + (k.1 + 1 : ℕ)) a) (lpD 1 (2 * j + (k.2 + 1 : ℕ)) b) z‖ₑ := by
  set κ1 := ∫ s, ‖monoKPhi s‖
  have hκ1 : 0 ≤ κ1 := integral_nonneg fun s => norm_nonneg _
  set G₁ : ℕ → ℝ × ℝ → ℂ := fun K => lpS 0 (j + K) a - lpS 0 j a
  set G₂ : ℕ → ℝ × ℝ → ℂ := fun K => lpS 1 (2 * j + K) b - lpS 1 (2 * j) b
  have hG₁b : ∀ K z, ‖G₁ K z‖ ≤ 2 * (κ1 * A) := fun K z => by
    simp only [G₁, Pi.sub_apply]
    exact (norm_sub_le _ _).trans (by linarith [norm_lpS_le 0 (j + K) hA z, norm_lpS_le 0 j hA z])
  have hG₂b : ∀ K z, ‖G₂ K z‖ ≤ 2 * (κ1 * B) := fun K z => by
    simp only [G₂, Pi.sub_apply]
    exact (norm_sub_le _ _).trans (by
      linarith [norm_lpS_le 1 (2 * j + K) hB z, norm_lpS_le 1 (2 * j) hB z])
  have hl₁ : ∀ w, Tendsto (fun K => G₁ K w) atTop (𝓝 ((a - lpS 0 j a) w)) := fun w =>
    (lpS_tendsto_self 0 ha hA w j).sub tendsto_const_nhds
  have hl₂ : ∀ w, Tendsto (fun K => G₂ K w) atTop (𝓝 ((b - lpS 1 (2 * j) b) w)) := fun w =>
    (lpS_tendsto_self 1 hb hB w (2 * j)).sub tendsto_const_nhds
  have hG₁m : ∀ K, Measurable (G₁ K) := fun K =>
    (measurable_lpS 0 _ ha.measurable).sub (measurable_lpS 0 _ ha.measurable)
  have hG₂m : ∀ K, Measurable (G₂ K) := fun K =>
    (measurable_lpS 1 _ hb.measurable).sub (measurable_lpS 1 _ hb.measurable)
  have hlim := Mj_tendsto j hG₁m hG₂m hG₁b hG₂b hl₁ hl₂ z
  refine le_of_tendsto' (hlim.enorm) fun K => ?_
  have e1 : G₁ K = ∑ k ∈ Finset.range K, lpD 0 (j + (k + 1 : ℕ)) a :=
    (sum_lpD_telescope 0 j a K).symm
  have e2 : G₂ K = ∑ k ∈ Finset.range K, lpD 1 (2 * j + (k + 1 : ℕ)) b :=
    (sum_lpD_telescope 1 (2 * j) b K).symm
  rw [e1, e2, Mj_sum_sum j _ _ (fun i => measurable_lpD 0 _ ha.measurable)
    (fun i => measurable_lpD 1 _ hb.measurable) (fun i => norm_lpD_le 0 _ hA)
    (fun i => norm_lpD_le 1 _ hB)]
  refine (enorm_sum_le _ _).trans ?_
  refine le_trans (Finset.sum_le_sum fun i _ => enorm_sum_le _ _) ?_
  exact ennreal_sum_range_prod_le_tsum (fun k => ‖Mj j (lpD 0 (j + (k.1 + 1 : ℕ)) a)
    (lpD 1 (2 * j + (k.2 + 1 : ℕ)) b) z‖ₑ) K

/-! ### Proof of Theorem 3 -/

theorem MjE_le_enorm_Mj (j : ℤ) {f₁ f₂ : ℝ × ℝ → ℂ} (h₁ : Measurable f₁) (h₂ : Measurable f₂)
    {A B : ℝ} (hA : ∀ z, ‖f₁ z‖ ≤ A) (hB : ∀ z, ‖f₂ z‖ ≤ B) (z : ℝ × ℝ) :
    MjE j f₁ f₂ z ≤ ‖Mj j (fun w => ((‖f₁ w‖ : ℝ) : ℂ)) (fun w => ((‖f₂ w‖ : ℝ) : ℂ)) z‖ₑ := by
  set a : ℝ × ℝ → ℂ := fun w => ((‖f₁ w‖ : ℝ) : ℂ)
  set b : ℝ × ℝ → ℂ := fun w => ((‖f₂ w‖ : ℝ) : ℂ)
  have ha : Measurable a := Complex.measurable_ofReal.comp h₁.norm
  have hb : Measurable b := Complex.measurable_ofReal.comp h₂.norm
  have hab : ∀ w, ‖a w‖ ≤ A := fun w => by simp [a, hA w]
  have hbb : ∀ w, ‖b w‖ ≤ B := fun w => by simp [b, hB w]
  set h : ℝ → ℝ := fun t => psiJ j t * (‖f₁ (z.1 + t, z.2)‖ * ‖f₂ (z.1, z.2 + t ^ 2)‖)
  have hh0 : ∀ t, 0 ≤ h t := fun t => mul_nonneg (psiJ_nonneg j t) (by positivity)
  have hint := integrable_Mj_integrand j ha hb hab hbb z
  have e1 : (fun t => (psiJ j t : ℂ) * (a (z.1 + t, z.2) * b (z.1, z.2 + t ^ 2))) =
      fun t => ((h t : ℝ) : ℂ) := by
    funext t; simp only [a, b, h]; push_cast; ring
  have hhi : Integrable h := by
    have := hint.norm
    refine this.congr (Eventually.of_forall fun t => ?_)
    change ‖(psiJ j t : ℂ) * (a (z.1 + t, z.2) * b (z.1, z.2 + t ^ 2))‖ = h t
    rw [show (psiJ j t : ℂ) * (a (z.1 + t, z.2) * b (z.1, z.2 + t ^ 2)) = ((h t : ℝ) : ℂ) from
      congrFun e1 t, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hh0 t)]
  rw [Mj_apply, e1, integral_complex_ofReal, ← ofReal_norm, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (integral_nonneg hh0), ofReal_integral_eq_lintegral_ofReal hhi
    (Eventually.of_forall hh0)]
  refine le_of_eq (lintegral_congr fun t => ?_)
  simp only [h]
  rw [ENNReal.ofReal_mul (psiJ_nonneg j t), ENNReal.ofReal_mul (norm_nonneg _), ofReal_norm,
    ofReal_norm]
  rfl

theorem summable_highCoeff {θ C₀ δ K : ℝ} (hθ : θ ∈ Ioo 0 1) (hC₀ : 0 < C₀) (hδ : 0 < δ)
    (hK : 0 ≤ K) :
    Summable fun k : ℕ × ℕ => (C₀ * ((2 : ℝ) ^ (max k.1 k.2)) ^ (-δ)) ^ (1 - θ) *
      (K * (k.2 + 6) ^ 2 + 1) ^ θ := by
  set ρ : ℝ := (2 : ℝ) ^ (-(δ * (1 - θ) / 2))
  have hρ0 : 0 < ρ := by positivity
  have hρ1 : ρ < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num)
    (by have := hθ.2; nlinarith)
  have hg1 : Summable fun n : ℕ => ρ ^ n := summable_geometric_of_lt_one hρ0.le hρ1
  have hpow : ∀ k : ℕ, Summable fun n : ℕ => (n : ℝ) ^ k * ρ ^ n := fun k =>
    summable_pow_mul_geometric_of_norm_lt_one k
      (by rw [Real.norm_eq_abs, abs_of_pos hρ0]; exact hρ1)
  have hg2 : Summable fun n : ℕ => ρ ^ n * (K * (n + 6) ^ 2 + 1) := by
    have : (fun n : ℕ => ρ ^ n * (K * (n + 6) ^ 2 + 1)) = fun n : ℕ =>
        K * ((n : ℝ) ^ 2 * ρ ^ n) + 12 * K * ((n : ℝ) ^ 1 * ρ ^ n) + (36 * K + 1) * ρ ^ n := by
      funext n; ring
    rw [this]
    exact (((hpow 2).mul_left K).add ((hpow 1).mul_left (12 * K))).add (hg1.mul_left _)
  have hprod := Summable.mul_of_nonneg (hg1.mul_left (C₀ ^ (1 - θ))) hg2
    (fun n => by positivity) (fun n => by positivity)
  refine Summable.of_nonneg_of_le (fun k => by positivity) (fun k => ?_) hprod
  have h1 : (C₀ * ((2 : ℝ) ^ (max k.1 k.2)) ^ (-δ)) ^ (1 - θ) ≤
      C₀ ^ (1 - θ) * (ρ ^ k.1 * ρ ^ k.2) := by
    rw [Real.mul_rpow hC₀.le (Real.rpow_nonneg (by positivity) _)]
    gcongr
    have hx : ((2 : ℝ) ^ (max k.1 k.2)) ^ (-δ) = (2 : ℝ) ^ (-δ * ((max k.1 k.2 : ℕ) : ℝ)) := by
      rw [← Real.rpow_natCast (2 : ℝ) (max k.1 k.2), ← Real.rpow_mul (by norm_num)]; ring_nf
    have hρk : ρ ^ k.1 * ρ ^ k.2 = (2 : ℝ) ^ (-(δ * (1 - θ) / 2) * ((k.1 : ℝ) + k.2)) := by
      rw [← Real.rpow_natCast ρ k.1, ← Real.rpow_natCast ρ k.2, ← Real.rpow_mul (by norm_num),
        ← Real.rpow_mul (by norm_num), ← Real.rpow_add (by norm_num)]; ring_nf
    rw [hx, ← Real.rpow_mul (by norm_num), hρk]
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
    have hmax : ((k.1 : ℝ) + k.2) / 2 ≤ (max k.1 k.2 : ℕ) := by
      rcases le_total k.1 k.2 with h | h
      · rw [max_eq_right h]; have : (k.1 : ℝ) ≤ k.2 := by exact_mod_cast h
        linarith
      · rw [max_eq_left h]; have : (k.2 : ℝ) ≤ k.1 := by exact_mod_cast h
        linarith
    have h1θ : 0 < 1 - θ := by linarith [hθ.2]
    nlinarith [mul_pos hδ h1θ]
  have h2 : (K * ((k.2 : ℝ) + 6) ^ 2 + 1) ^ θ ≤ K * ((k.2 : ℝ) + 6) ^ 2 + 1 := by
    have hb : 1 ≤ K * ((k.2 : ℝ) + 6) ^ 2 + 1 := by nlinarith [sq_nonneg ((k.2 : ℝ) + 6)]
    calc (K * ((k.2 : ℝ) + 6) ^ 2 + 1) ^ θ ≤ (K * ((k.2 : ℝ) + 6) ^ 2 + 1) ^ (1 : ℝ) :=
          Real.rpow_le_rpow_of_exponent_le hb hθ.2.le
      _ = _ := Real.rpow_one _
  calc (C₀ * ((2 : ℝ) ^ (max k.1 k.2)) ^ (-δ)) ^ (1 - θ) * (K * ((k.2 : ℝ) + 6) ^ 2 + 1) ^ θ
      ≤ C₀ ^ (1 - θ) * (ρ ^ k.1 * ρ ^ k.2) * (K * ((k.2 : ℝ) + 6) ^ 2 + 1) :=
        mul_le_mul h1 h2 (by positivity) (by positivity)
    _ = C₀ ^ (1 - θ) * ρ ^ k.1 * (ρ ^ k.2 * (K * ((k.2 : ℝ) + 6) ^ 2 + 1)) := by ring

theorem eLpNorm_two_mul_le {X : Type*} [MeasurableSpace X] {μ : Measure X} {F : X → ℝ≥0∞}
    (hF : Measurable F) {r : ℝ≥0∞} (hr : 1 ≤ r) :
    eLpNorm (fun x => 2 * F x) r μ ≤ 2 * eLpNorm F r μ := by
  have e : (fun x => 2 * F x) = F + F := by funext x; simp [two_mul]
  rw [e, two_mul]
  exact eLpNorm_add_le hF.aestronglyMeasurable hF.aestronglyMeasurable hr

/-- **Theorem 3** (`thm:maxfct`): for `p, q ∈ (1, ∞)`, `r ∈ [1, ∞)` with `1/p + 1/q = 1/r`,
`‖M(f_1, f_2)‖_{L^r} ≤ C ‖f_1‖_{L^p} ‖f_2‖_{L^q}` for all test functions `f_1, f_2`, where
`M(f_1,f_2)(x,y) = sup_{r>0} (2r)^{-1} ∫_{-r}^{r} |f_1(x+t,y) f_2(x,y+t^2)| dt`. -/
theorem thm_maxfct {p q r : ℝ} (hp : 1 < p) (hq : 1 < q) (hr : 1 ≤ r)
    (hpqr : 1 / p + 1 / q = 1 / r) :
    ∃ C : ℝ, 0 < C ∧ ∀ f₁ f₂ : ℝ × ℝ → ℂ, ContDiff ℝ ∞ f₁ → HasCompactSupport f₁ →
      ContDiff ℝ ∞ f₂ → HasCompactSupport f₂ →
      eLpNorm (maxOp f₁ f₂) (ENNReal.ofReal r) volume ≤
        ENNReal.ofReal C * eLpNorm f₁ (ENNReal.ofReal p) volume *
          eLpNorm f₂ (ENNReal.ofReal q) volume := by
  obtain ⟨CL, hCL, hlow⟩ := lowPart_bound
  obtain ⟨θ, C₀, δ, K, hθ, hC₀, hδ, hK, hMk⟩ := MkH_bound hp hq hr hpqr
  have hp0 : 0 < p := by linarith
  have hq0 : 0 < q := by linarith
  have hr0 : 0 < r := by linarith
  set ck : ℕ × ℕ → ℝ := fun k => (C₀ * ((2 : ℝ) ^ (max k.1 k.2)) ^ (-δ)) ^ (1 - θ) *
    (K * (k.2 + 6) ^ 2 + 1) ^ θ with hck
  have hck0 : ∀ k, 0 ≤ ck k := fun k => by positivity
  have hcks : Summable ck := summable_highCoeff hθ hC₀ hδ hK
  set S : ℝ := ∑' k, ck k
  have hS : ∑' k, ENNReal.ofReal (ck k) = ENNReal.ofReal S :=
    (ENNReal.ofReal_tsum_of_nonneg hck0 hcks).symm
  set Lp : ℝ := (shiftedMaximalLpConst p * Real.log (2 + |(-1 / 2 : ℝ)|)) ^ (1 / p)
  set Lq : ℝ := (shiftedMaximalLpConst q * Real.log (2 + |(-1 / 2 : ℝ)|)) ^ (1 / q)
  have hlog : 0 ≤ Real.log (2 + |(-1 / 2 : ℝ)|) := Real.log_nonneg (by norm_num)
  have hLp : 0 ≤ Lp := Real.rpow_nonneg (mul_nonneg (shiftedMaximalLpConst_pos hp).le hlog) _
  have hLq : 0 ≤ Lq := Real.rpow_nonneg (mul_nonneg (shiftedMaximalLpConst_pos hq).le hlog) _
  have hS0 : 0 ≤ S := tsum_nonneg hck0
  refine ⟨2 * (CL * (Lp * Lq) + 4 * S) + 1, by positivity,
    fun f₁ f₂ hf₁ hcs₁ hf₂ hcs₂ => ?_⟩
  have hc₁ : Continuous f₁ := hf₁.continuous
  have hc₂ : Continuous f₂ := hf₂.continuous
  obtain ⟨A, hA⟩ := hcs₁.exists_bound_of_continuous hc₁
  obtain ⟨B, hB⟩ := hcs₂.exists_bound_of_continuous hc₂
  set a : ℝ × ℝ → ℂ := fun w => ((‖f₁ w‖ : ℝ) : ℂ) with hadef
  set b : ℝ × ℝ → ℂ := fun w => ((‖f₂ w‖ : ℝ) : ℂ) with hbdef
  have hac : Continuous a := Complex.continuous_ofReal.comp hc₁.norm
  have hbc : Continuous b := Complex.continuous_ofReal.comp hc₂.norm
  have ha : Measurable a := hac.measurable
  have hb : Measurable b := hbc.measurable
  have hab : ∀ w, ‖a w‖ ≤ A := fun w => by simp [a, hA w]
  have hbb : ∀ w, ‖b w‖ ≤ B := fun w => by simp [b, hB w]
  have hai : Integrable a := (hc₁.integrable_of_hasCompactSupport hcs₁).norm.ofReal
  have hbi : Integrable b := (hc₂.integrable_of_hasCompactSupport hcs₂).norm.ofReal
  have hna : eLpNorm a (ENNReal.ofReal p) volume = eLpNorm f₁ (ENNReal.ofReal p) volume := by
    rw [hadef, eLpNorm_ofReal_cast, eLpNorm_norm]
  have hnb : eLpNorm b (ENNReal.ofReal q) volume = eLpNorm f₂ (ENNReal.ofReal q) volume := by
    rw [hbdef, eLpNorm_ofReal_cast, eLpNorm_norm]
  -- the pointwise decomposition
  set P : ℕ × ℕ → ℝ × ℝ → ℝ≥0∞ := fun k z => ⨆ j : ℤ, ‖Mj j (lpD 0 (j + (k.1 + 1 : ℕ)) a)
    (lpD 1 (2 * j + (k.2 + 1 : ℕ)) b) z‖ₑ with hP
  have hPm : ∀ k, Measurable (P k) := fun k => Measurable.iSup fun j =>
    (measurable_Mj j (measurable_lpD 0 _ ha) (measurable_lpD 1 _ hb)).enorm
  set L : ℝ × ℝ → ℝ≥0∞ := fun z => ENNReal.ofReal CL *
    (ENNReal.ofReal (cMax 0 a z) * ENNReal.ofReal (cMax 1 b z)) with hL
  have hLm : Measurable L := by
    refine measurable_const.mul ((ENNReal.measurable_ofReal.comp ?_).mul
      (ENNReal.measurable_ofReal.comp ?_))
    · rw [cMax_eq_cShift]; exact measurable_cShift 0 _ ha
    · rw [cMax_eq_cShift]; exact measurable_cShift 1 _ hb
  have hpt : ∀ z, maxOp f₁ f₂ z ≤ 2 * (L z + ∑' k, P k z) := by
    intro z
    refine (maxOp_le_iSup_MjE f₁ f₂ hc₁.measurable hc₂.measurable z).trans ?_
    gcongr
    refine iSup_le fun j => (MjE_le_enorm_Mj j hc₁.measurable hc₂.measurable hA hB z).trans ?_
    have h1 := hlow j ha hb hab hbb z
    have h2 := enorm_Mj_high_le j hac hbc hab hbb z
    calc ‖Mj j a b z‖ₑ ≤ ‖Mj j a b z - Mj j (a - lpS 0 j a) (b - lpS 1 (2 * j) b) z‖ₑ +
          ‖Mj j (a - lpS 0 j a) (b - lpS 1 (2 * j) b) z‖ₑ := by
          refine le_trans (le_of_eq ?_) (enorm_add_le _ _); congr 1; abel
      _ ≤ L z + ∑' k, P k z := by
          gcongr
          · refine h1.trans (le_of_eq ?_)
            rw [hL, ENNReal.ofReal_mul hCL, ENNReal.ofReal_mul (cMax_nonneg 0 a z)]
          · exact h2.trans (ENNReal.tsum_le_tsum fun k => le_iSup (fun j => ‖Mj j
              (lpD 0 (j + (k.1 + 1 : ℕ)) a) (lpD 1 (2 * j + (k.2 + 1 : ℕ)) b) z‖ₑ) j)
  have hr1 : 1 ≤ ENNReal.ofReal r := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hr
  have hpqr' : (ENNReal.ofReal p)⁻¹ + (ENNReal.ofReal q)⁻¹ = (ENNReal.ofReal r)⁻¹ := by
    rw [← ENNReal.ofReal_inv_of_pos hp0, ← ENNReal.ofReal_inv_of_pos hq0,
      ← ENNReal.ofReal_inv_of_pos hr0, ← ENNReal.ofReal_add (by positivity) (by positivity)]
    congr 1; rw [← one_div, ← one_div, ← one_div, hpqr]
  have hTm : Measurable fun z => ∑' k, P k z := measurable_tsum_ennreal hPm
  set Na := eLpNorm f₁ (ENNReal.ofReal p) volume
  set Nb := eLpNorm f₂ (ENNReal.ofReal q) volume
  -- the low part
  have hLn : eLpNorm L (ENNReal.ofReal r) volume ≤
      ENNReal.ofReal CL * (ENNReal.ofReal Lp * Na * (ENNReal.ofReal Lq * Nb)) := by
    refine (eLpNorm_ofReal_mul_le (cMax_nonneg 0 a) (cMax_nonneg 1 b) ?_ ?_ hCL hpqr').trans ?_
    · rw [cMax_eq_cShift]; exact (measurable_cShift 0 _ ha).aestronglyMeasurable
    · rw [cMax_eq_cShift]; exact (measurable_cShift 1 _ hb).aestronglyMeasurable
    gcongr
    · rw [cMax_eq_cShift, ← hna]; exact eLpNorm_cShift_le 0 (-1 / 2) hp ha hab
    · rw [cMax_eq_cShift, ← hnb]; exact eLpNorm_cShift_le 1 (-1 / 2) hq hb hbb
  -- the high part
  have hTn : eLpNorm (fun z => ∑' k, P k z) (ENNReal.ofReal r) volume ≤
      4 * ENNReal.ofReal S * Na * Nb := by
    refine (eLpNorm_tsum_le hPm hr1 ENNReal.ofReal_ne_top).trans ?_
    calc ∑' k, eLpNorm (P k) (ENNReal.ofReal r) volume
        ≤ ∑' k, 4 * ENNReal.ofReal (ck k) * Na * Nb := by
          refine ENNReal.tsum_le_tsum fun k => ?_
          have := hMk k.1 k.2 ha hb hai hbi hab hbb
          rw [hna, hnb] at this
          exact this
      _ = 4 * ENNReal.ofReal S * Na * Nb := by
          rw [ENNReal.tsum_mul_right, ENNReal.tsum_mul_right, ENNReal.tsum_mul_left, hS]
  calc eLpNorm (maxOp f₁ f₂) (ENNReal.ofReal r) volume
      ≤ eLpNorm (fun z => 2 * (L z + ∑' k, P k z)) (ENNReal.ofReal r) volume :=
        eLpNorm_mono_enorm fun z => by simpa using hpt z
    _ ≤ 2 * eLpNorm (fun z => L z + ∑' k, P k z) (ENNReal.ofReal r) volume :=
        eLpNorm_two_mul_le (hLm.add hTm) hr1
    _ ≤ 2 * (eLpNorm L (ENNReal.ofReal r) volume +
          eLpNorm (fun z => ∑' k, P k z) (ENNReal.ofReal r) volume) := by
        gcongr
        have e : (fun z => L z + ∑' k, P k z) = L + (fun z => ∑' k, P k z) := rfl
        rw [e]
        exact eLpNorm_add_le hLm.aestronglyMeasurable hTm.aestronglyMeasurable hr1
    _ ≤ 2 * (ENNReal.ofReal CL * (ENNReal.ofReal Lp * Na * (ENNReal.ofReal Lq * Nb)) +
          4 * ENNReal.ofReal S * Na * Nb) := by gcongr
    _ = ENNReal.ofReal (2 * (CL * (Lp * Lq) + 4 * S)) * Na * Nb := by
        have e : ENNReal.ofReal (2 * (CL * (Lp * Lq) + 4 * S)) =
            2 * (ENNReal.ofReal CL * (ENNReal.ofReal Lp * ENNReal.ofReal Lq) +
              4 * ENNReal.ofReal S) := by
          rw [ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2),
            ENNReal.ofReal_add (by positivity) (by positivity), ENNReal.ofReal_mul hCL,
            ENNReal.ofReal_mul hLp, ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 4),
            ENNReal.ofReal_ofNat, ENNReal.ofReal_ofNat]
        rw [e]
        ring
    _ ≤ ENNReal.ofReal (2 * (CL * (Lp * Lq) + 4 * S) + 1) * Na * Nb := by
        gcongr; linarith

end

