/-! ### Partial Littlewood-Paley operators on `ℝ^2` (§2.1) -/

/-- `S^{(ℓ)}_m g`: the multiplier `φ(ξ_ℓ / 2^m)` in the coordinate `ℓ`. -/
def lpS (ℓ : Fin 2) (m : ℤ) (g : ℝ × ℝ → ℂ) : ℝ × ℝ → ℂ := monoP ℓ monoKPhi ((2 : ℝ) ^ m) g

/-- `Δ^{(ℓ)}_m g = S^{(ℓ)}_m g - S^{(ℓ)}_{m-1} g`: the multiplier `ψ(ξ_ℓ / 2^m)`,
`ψ = φ - φ(2·)`. -/
def lpD (ℓ : Fin 2) (m : ℤ) (g : ℝ × ℝ → ℂ) : ℝ × ℝ → ℂ := lpS ℓ m g - lpS ℓ (m - 1) g

theorem fibF_lpS (ℓ : Fin 2) (m : ℤ) {g : ℝ × ℝ → ℂ} (hg : ∀ p, Integrable (monoFib ℓ g p))
    (q : ℝ × ℝ) : fibF ℓ (lpS ℓ m g) q = (monoPhi (q.2 / 2 ^ m) : ℂ) * fibF ℓ g q :=
  mloc_P_fib_fourier ℓ monoPhi_contDiff monoPhi_hasCompactSupport (by positivity) (hg q.1) q.2

theorem integrable_kerScaled (Kf : 𝓢(ℝ, ℂ)) (m : ℤ) :
    Integrable fun s => (((2 : ℝ) ^ m : ℝ) : ℂ) * Kf ((2 : ℝ) ^ m * s) :=
  mloc_integrable_dil Kf (by positivity)

theorem integral_norm_kerScaled (Kf : 𝓢(ℝ, ℂ)) (m : ℤ) :
    ∫ s, ‖(((2 : ℝ) ^ m : ℝ) : ℂ) * Kf ((2 : ℝ) ^ m * s)‖ = ∫ s, ‖Kf s‖ := by
  have hm : (0 : ℝ) < 2 ^ m := by positivity
  simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hm]
  rw [integral_const_mul, Measure.integral_comp_mul_left (fun s => ‖Kf s‖) (2 ^ m), abs_inv,
    abs_of_pos hm, smul_eq_mul, ← mul_assoc, mul_inv_cancel₀ hm.ne', one_mul]


theorem measurable_lpS (ℓ : Fin 2) (m : ℤ) {g : ℝ × ℝ → ℂ} (hg : Measurable g) :
    Measurable (lpS ℓ m g) :=
  measurable_monoCConv (continuous_const.mul (monoKPhi.continuous.comp
    (continuous_const.mul continuous_id))).measurable hg


theorem norm_lpS_le (ℓ : Fin 2) (m : ℤ) {g : ℝ × ℝ → ℂ} {M : ℝ} (hM : ∀ z, ‖g z‖ ≤ M)
    (z : ℝ × ℝ) : ‖lpS ℓ m g z‖ ≤ (∫ s, ‖monoKPhi s‖) * M := by
  unfold lpS monoP
  refine (norm_monoCConv_le (integrable_kerScaled monoKPhi m) hM z).trans (le_of_eq ?_)
  rw [integral_norm_kerScaled]


theorem integrable_fib_lpS (ℓ : Fin 2) (m : ℤ) {g : ℝ × ℝ → ℂ}
    (hg : ∀ p, Integrable (monoFib ℓ g p)) (p : ℝ) : Integrable (monoFib ℓ (lpS ℓ m g) p) :=
  integrable_fib_monoCConv ℓ (integrable_kerScaled monoKPhi m) hg p

theorem measurable_lpD (ℓ : Fin 2) (m : ℤ) {g : ℝ × ℝ → ℂ} (hg : Measurable g) :
    Measurable (lpD ℓ m g) := (measurable_lpS ℓ m hg).sub (measurable_lpS ℓ (m - 1) hg)

theorem norm_lpD_le (ℓ : Fin 2) (m : ℤ) {g : ℝ × ℝ → ℂ} {M : ℝ} (hM : ∀ z, ‖g z‖ ≤ M)
    (z : ℝ × ℝ) : ‖lpD ℓ m g z‖ ≤ 2 * ((∫ s, ‖monoKPhi s‖) * M) := by
  unfold lpD; rw [Pi.sub_apply]
  refine (norm_sub_le _ _).trans ?_
  linarith [norm_lpS_le ℓ m hM z, norm_lpS_le ℓ (m - 1) hM z]

theorem integrable_fib_lpD (ℓ : Fin 2) (m : ℤ) {g : ℝ × ℝ → ℂ}
    (hg : ∀ p, Integrable (monoFib ℓ g p)) (p : ℝ) : Integrable (monoFib ℓ (lpD ℓ m g) p) :=
  (integrable_fib_lpS ℓ m hg p).sub (integrable_fib_lpS ℓ (m - 1) hg p)

theorem fibF_lpD (ℓ : Fin 2) (m : ℤ) {g : ℝ × ℝ → ℂ} (hg : ∀ p, Integrable (monoFib ℓ g p))
    (q : ℝ × ℝ) : fibF ℓ (lpD ℓ m g) q = (monoPsiA (q.2 / 2 ^ m) : ℂ) * fibF ℓ g q := by
