theorem contDiff_halfCut : ContDiff ℝ ∞ (fun t => ((halfCut t : ℝ) : ℂ)) :=
  Complex.ofRealCLM.contDiff.comp (Real.smoothTransition.contDiff.comp (by fun_prop))

theorem AmpII.pos_supp {a : ℝ → ℂ} (ha : AmpII a) :
    ∀ t, t ∉ Icc (1 / 2 : ℝ) 2 → ((halfCut t : ℝ) : ℂ) * a t = 0 := by
  intro t ht
  rw [mem_Icc, not_and_or, not_le, not_le] at ht
  rcases ht with ht | ht
  · rcases le_or_gt t (1 / 4) with h | h
    · rw [halfCut, Real.smoothTransition.zero_of_nonpos (by linarith)]; simp
    · rw [ha.2 t ⟨by linarith, ht⟩, mul_zero]
  · rw [ha.1.2 t (fun h => by linarith [h.2]), mul_zero]

theorem AmpII.neg_supp {a : ℝ → ℂ} (ha : AmpII a) :
    ∀ t, t ∉ Icc (-2 : ℝ) (-(1 / 2)) → (1 - ((halfCut t : ℝ) : ℂ)) * a t = 0 := by
  intro t ht
  rw [mem_Icc, not_and_or, not_le, not_le] at ht
  rcases ht with ht | ht
  · rw [ha.1.2 t (fun h => by linarith [h.1]), mul_zero]
  · rcases le_or_gt (1 / 2) t with h | h
    · rw [halfCut, Real.smoothTransition.one_of_one_le (by linarith)]; simp
    · rw [ha.2 t ⟨ht, h⟩, mul_zero]

theorem AmpII.hD_pos (r : ℝ) (hr : r ∈ Icc (-(1 / 8 : ℝ)) (1 / 8)) (t : ℝ)
    (ht : t ∈ Icc (1 / 4 : ℝ) (5 / 2)) : 1 / 4 ≤ |2 * t + r| := by
  rw [abs_of_pos (by linarith [hr.1, ht.1])]
  linarith [hr.1, ht.1]

theorem AmpII.hD_neg (r : ℝ) (hr : r ∈ Icc (-(1 / 8 : ℝ)) (1 / 8)) (t : ℝ)
    (ht : t ∈ Icc (-(5 / 2) : ℝ) (-(1 / 4))) : 1 / 4 ≤ |2 * t + r| := by
  rw [abs_of_neg (by linarith [hr.2, ht.2])]
  linarith [hr.2, ht.2]

/-- `ϑ_a(ξ,η) = O(|η|^{-N})` on `|ξ| ≤ |η|/8`. -/
theorem AmpII.decay {a : ℝ → ℂ} (ha : AmpII a) (M : ℕ) :
    ∃ C, ∀ w : ℝ × ℝ, |w.1| ≤ |w.2| / 8 → ‖oscIntC a w‖ * (1 + ‖w‖) ^ M ≤ C := by
  have hP := fun r t => hasDerivAt_phaseII r t
  obtain ⟨C₁, hC₁, hb₁⟩ := ibp_bound (contDiff_halfCut.mul ha.1.1) (α := 1 / 4) (α' := 1 / 2)
    (β' := 2) (β := 5 / 2) (by norm_num) (by norm_num) (by norm_num) ha.pos_supp
    (P := fun r t => t ^ 2 + r * t) (D := fun p => 2 * p.2 + p.1) (by fun_prop) hP
    (fun r hr t ht => AmpII.hD_pos r hr t ht) M
  obtain ⟨C₂, hC₂, hb₂⟩ := ibp_bound ((contDiff_const.sub contDiff_halfCut).mul ha.1.1)
    (α := -(5 / 2)) (α' := -2) (β' := -(1 / 2)) (β := -(1 / 4)) (by norm_num) (by norm_num)
    (by norm_num) ha.neg_supp (P := fun r t => t ^ 2 + r * t) (D := fun p => 2 * p.2 + p.1)
    (by fun_prop) hP (fun r hr t ht => AmpII.hD_neg r hr t ht) M
  have hB : 0 ≤ ∫ t, ‖a t‖ := integral_nonneg fun _ => norm_nonneg _
  refine ⟨2 ^ M * ((∫ t, ‖a t‖) + C₁ + C₂), fun w hw => ?_⟩
  have hnw : ‖w‖ ≤ |w.2| := by
    rw [Prod.norm_def, Real.norm_eq_abs, Real.norm_eq_abs]
    exact max_le (by linarith [abs_nonneg w.2]) le_rfl
  have h2M : (0 : ℝ) < 2 ^ M := by positivity
  rcases le_or_gt |w.2| 1 with h1 | h1
  · calc ‖oscIntC a w‖ * (1 + ‖w‖) ^ M ≤ (∫ t, ‖a t‖) * 2 ^ M := by
          gcongr
          · exact norm_oscIntC_le a w
          · linarith
      _ ≤ 2 ^ M * ((∫ t, ‖a t‖) + C₁ + C₂) := by nlinarith
  · have hw2 : w.2 ≠ 0 := fun h => by rw [h, abs_zero] at h1; linarith
    have hpos : 0 < |w.2| := abs_pos.2 hw2
    have hr : w.1 / w.2 ∈ Icc (-(1 / 8 : ℝ)) (1 / 8) := by
      rw [mem_Icc, ← abs_le, abs_div, div_le_iff₀ hpos]
      linarith
    have hf : 2 * Real.pi * w.2 ≠ 0 := by positivity
    have hph : ∀ t, 2 * Real.pi * (t * w.1 + t ^ 2 * w.2) =
        2 * Real.pi * w.2 * (t ^ 2 + w.1 / w.2 * t) := fun t => by field_simp; ring
    have hsplit : oscIntC a w = oscIntC (fun t => ((halfCut t : ℝ) : ℂ) * a t) w +
        oscIntC (fun t => (1 - ((halfCut t : ℝ) : ℂ)) * a t) w := by
      unfold oscIntC
      rw [← integral_add (integrable_oscIntC (ha.1.mul_left contDiff_halfCut) w)
        (integrable_oscIntC (ha.1.mul_left (contDiff_const.sub contDiff_halfCut)) w)]
      congr 1
      funext t
      ring
    rw [hsplit, oscIntC_eq_interval (α := 1 / 4) (α' := 1 / 2) (β' := 2) (β := 5 / 2)
      (by norm_num) (by norm_num) (by norm_num) ha.pos_supp w _ _ hph,
      oscIntC_eq_interval (α := -(5 / 2)) (α' := -2) (β' := -(1 / 2)) (β := -(1 / 4))
      (by norm_num) (by norm_num) (by norm_num) ha.neg_supp w _ _ hph]
    have hpi : 1 ≤ Real.pi := by linarith [Real.pi_gt_three]
    have hq : (1 / |2 * Real.pi * w.2|) ^ M * (2 * |w.2|) ^ M ≤ 1 := by
      rw [← mul_pow]
      apply pow_le_one₀ (by positivity)
      rw [abs_mul, abs_mul, abs_of_pos Real.pi_pos, abs_two, div_mul_eq_mul_div, one_mul,
        div_le_one (by positivity)]
      nlinarith
    have h1w : (1 + ‖w‖) ^ M ≤ (2 * |w.2|) ^ M := by gcongr; linarith
    have e1 := hb₁ _ hr _ hf
    have e2 := hb₂ _ hr _ hf
    calc ‖(∫ t in 1 / 4..5 / 2, ((halfCut t : ℝ) : ℂ) * a t *
            nonstationaryPhaseExp (2 * Real.pi * w.2) (fun t => t ^ 2 + w.1 / w.2 * t) t) +
          ∫ t in -(5 / 2)..-(1 / 4), (1 - ((halfCut t : ℝ) : ℂ)) * a t *
            nonstationaryPhaseExp (2 * Real.pi * w.2) (fun t => t ^ 2 + w.1 / w.2 * t) t‖ *
          (1 + ‖w‖) ^ M
        ≤ (C₁ * (1 / |2 * Real.pi * w.2|) ^ M + C₂ * (1 / |2 * Real.pi * w.2|) ^ M) *
            (2 * |w.2|) ^ M := by
          gcongr
          exact (norm_add_le _ _).trans (add_le_add e1 e2)
      _ = (C₁ + C₂) * ((1 / |2 * Real.pi * w.2|) ^ M * (2 * |w.2|) ^ M) := by ring
      _ ≤ (C₁ + C₂) * 1 := by gcongr
      _ ≤ 2 ^ M * ((∫ t, ‖a t‖) + C₁ + C₂) := by
          have : (1 : ℝ) ≤ 2 ^ M := one_le_pow₀ (by norm_num)
          nlinarith

/-! ### Decay of the derivatives of `ϑ` -/

theorem contDiff_dotL_parab (v : ℝ × ℝ) :
    ContDiff ℝ ∞ (fun t => ((dotL (parab t) v : ℝ) : ℂ)) := by
  simp only [dotL_apply, parab]
  exact Complex.ofRealCLM.contDiff.comp
    ((contDiff_id.mul contDiff_const).add ((contDiff_id.pow 2).mul contDiff_const))

/-- The amplitude of `D^n ϑ_a` in the directions `basis2 ∘ σ`. -/
def derivAmp (a : ℝ → ℂ) {n : ℕ} (σ : Fin n → Fin 2) (t : ℝ) : ℂ :=
  (∏ i, (2 * Real.pi * Complex.I * ((dotL (parab t) (basis2 (σ i)) : ℝ) : ℂ))) * a t

theorem contDiff_derivAmp_factor {n : ℕ} (σ : Fin n → Fin 2) :
    ContDiff ℝ ∞ (fun t => ∏ i, (2 * Real.pi * Complex.I *
      ((dotL (parab t) (basis2 (σ i)) : ℝ) : ℂ))) :=
  contDiff_prod fun _ _ => contDiff_const.mul (contDiff_dotL_parab _)

theorem norm_iteratedFDeriv_oscIntC_le {a : ℝ → ℂ} (ha : AmpI a) (n : ℕ) (w : ℝ × ℝ) :
    ‖iteratedFDeriv ℝ n (oscIntC a) w‖ ≤ ∑ σ : Fin n → Fin 2, ‖oscIntC (derivAmp a σ) w‖ := by
  refine (norm_le_sum_basis2 _).trans (le_of_eq ?_)
  congr 1
  funext σ
  rw [iteratedFDeriv_oscIntC_apply ha.1.continuous ha.hasCompactSupport]
  rfl

theorem AmpI.deriv_decay {a : ℝ → ℂ} (ha : AmpI a) (n M : ℕ) :
    ∃ C, ∀ w : ℝ × ℝ, |w.2| ≤ |w.1| / 8 →
      ‖iteratedFDeriv ℝ n (oscIntC a) w‖ * (1 + ‖w‖) ^ M ≤ C := by
  choose C hC using fun σ : Fin n → Fin 2 =>
    (ha.mul_left (contDiff_derivAmp_factor σ)).decay M
  refine ⟨∑ σ, C σ, fun w hw => ?_⟩
  calc ‖iteratedFDeriv ℝ n (oscIntC a) w‖ * (1 + ‖w‖) ^ M
      ≤ (∑ σ : Fin n → Fin 2, ‖oscIntC (derivAmp a σ) w‖) * (1 + ‖w‖) ^ M := by
        gcongr
        exact norm_iteratedFDeriv_oscIntC_le ha n w
    _ = ∑ σ : Fin n → Fin 2, ‖oscIntC (derivAmp a σ) w‖ * (1 + ‖w‖) ^ M := Finset.sum_mul _ _ _
    _ ≤ ∑ σ, C σ := Finset.sum_le_sum fun σ _ => hC σ w hw

theorem AmpII.deriv_decay {a : ℝ → ℂ} (ha : AmpII a) (n M : ℕ) :
    ∃ C, ∀ w : ℝ × ℝ, |w.1| ≤ |w.2| / 8 →
      ‖iteratedFDeriv ℝ n (oscIntC a) w‖ * (1 + ‖w‖) ^ M ≤ C := by
  choose C hC using fun σ : Fin n → Fin 2 =>
    (ha.mul_left (contDiff_derivAmp_factor σ)).decay M
  refine ⟨∑ σ, C σ, fun w hw => ?_⟩
  calc ‖iteratedFDeriv ℝ n (oscIntC a) w‖ * (1 + ‖w‖) ^ M
      ≤ (∑ σ : Fin n → Fin 2, ‖oscIntC (derivAmp a σ) w‖) * (1 + ‖w‖) ^ M := by
        gcongr
        exact norm_iteratedFDeriv_oscIntC_le ha.1 n w
    _ = ∑ σ : Fin n → Fin 2, ‖oscIntC (derivAmp a σ) w‖ * (1 + ‖w‖) ^ M := Finset.sum_mul _ _ _
    _ ≤ ∑ σ, C σ := Finset.sum_le_sum fun σ _ => hC σ w hw

/-! ### Products with cutoffs supported in a cone -/

theorem symDecay_mul {O : ℝ × ℝ → ℂ} {S : ℝ × ℝ → ℝ} (hO : ContDiff ℝ ∞ O)
    (hS : ContDiff ℝ ∞ S) {Ω : Set (ℝ × ℝ)} (hsupp : tsupport S ⊆ Ω)
    (hOd : ∀ n M : ℕ, ∃ C, ∀ w ∈ Ω, ‖iteratedFDeriv ℝ n O w‖ * (1 + ‖w‖) ^ M ≤ C)
    (hSb : ∀ n : ℕ, ∃ B, ∀ w, ‖iteratedFDeriv ℝ n S w‖ ≤ B * (1 + ‖w‖)) :
    SymDecay (fun w => O w * (S w : ℂ)) := by
  intro n
  choose C hC using fun i => hOd i (2 * n + 2)
  choose B hB using hSb
  refine ⟨∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * (max (C i) 0 * max (B (n - i)) 0),
    fun w => ?_⟩
  have hS' : ContDiff ℝ ∞ (fun w => (S w : ℂ)) := Complex.ofRealCLM.contDiff.comp hS
  have hnS : ∀ j : ℕ, ‖iteratedFDeriv ℝ j (fun w => (S w : ℂ)) w‖ =
      ‖iteratedFDeriv ℝ j S w‖ := fun j =>
    LinearIsometry.norm_iteratedFDeriv_comp_left (f := S) Complex.ofRealLI hS.contDiffAt
      (by exact_mod_cast le_top)
  have hw1 : (0 : ℝ) ≤ 1 + ‖w‖ := by positivity
  have key : ∀ i ∈ Finset.range (n + 1), ‖iteratedFDeriv ℝ i O w‖ *
      ‖iteratedFDeriv ℝ (n - i) S w‖ * (1 + ‖w‖) ^ (2 * n + 1) ≤
        max (C i) 0 * max (B (n - i)) 0 := by
    intro i _
    by_cases hw : w ∈ tsupport S
    · have h1 := hC i w (hsupp hw)
      have h2 : ‖iteratedFDeriv ℝ (n - i) S w‖ ≤ max (B (n - i)) 0 * (1 + ‖w‖) :=
        (hB (n - i) w).trans (mul_le_mul_of_nonneg_right (le_max_left _ _) hw1)
      calc ‖iteratedFDeriv ℝ i O w‖ * ‖iteratedFDeriv ℝ (n - i) S w‖ * (1 + ‖w‖) ^ (2 * n + 1)
          ≤ ‖iteratedFDeriv ℝ i O w‖ * (max (B (n - i)) 0 * (1 + ‖w‖)) *
              (1 + ‖w‖) ^ (2 * n + 1) := by gcongr
        _ = max (B (n - i)) 0 * (‖iteratedFDeriv ℝ i O w‖ * (1 + ‖w‖) ^ (2 * n + 2)) := by
            ring
        _ ≤ max (B (n - i)) 0 * max (C i) 0 :=
            mul_le_mul_of_nonneg_left (h1.trans (le_max_left _ _)) (le_max_right _ _)
        _ = _ := mul_comm _ _
    · have h0 : iteratedFDeriv ℝ (n - i) S w = 0 :=
        Function.notMem_support.1 fun h => hw (support_iteratedFDeriv_subset _ h)
      rw [h0, norm_zero, mul_zero, zero_mul]
      positivity
  calc ‖iteratedFDeriv ℝ n (fun w => O w * (S w : ℂ)) w‖ * (1 + ‖w‖) ^ (2 * n + 1)
      ≤ (∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * ‖iteratedFDeriv ℝ i O w‖ *
          ‖iteratedFDeriv ℝ (n - i) (fun w => (S w : ℂ)) w‖) * (1 + ‖w‖) ^ (2 * n + 1) := by
        gcongr
        exact norm_iteratedFDeriv_mul_le hO hS' w (by exact_mod_cast le_top)
    _ = ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * (‖iteratedFDeriv ℝ i O w‖ *
          ‖iteratedFDeriv ℝ (n - i) S w‖ * (1 + ‖w‖) ^ (2 * n + 1)) := by
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [hnS]
        ring
    _ ≤ _ := Finset.sum_le_sum fun i hi =>
        mul_le_mul_of_nonneg_left (key i hi) (Nat.cast_nonneg _)

/-! ### The cutoffs of the mixed terms -/

/-- The `k`-th cutoff `ψ(2^{-k-1} ξ) φ(2^{100-k} η)` of `I`. -/
def cutTerm (k : ℕ) (w : ℝ × ℝ) : ℝ :=
  monoPsiA (w.1 / 2 ^ (k + 1)) * monoPhi (w.2 * (2 : ℝ) ^ ((100 : ℤ) - k))

/-- `∑_k ψ(2^{-k-1} ξ) φ(2^{100-k} η)`. -/
def mixCut (w : ℝ × ℝ) : ℝ := ∑' k : ℕ, cutTerm k w

theorem two_zpow_sub (k : ℕ) : (2 : ℝ) ^ ((100 : ℤ) - k) = 2 ^ 100 / 2 ^ k := by
  rw [zpow_sub₀ two_ne_zero, zpow_natCast]
  norm_num

theorem cutTerm_ne_zero {k : ℕ} {w : ℝ × ℝ} (h : cutTerm k w ≠ 0) :
    (2 : ℝ) ^ k < |w.1| ∧ |w.2| * 2 ^ 100 < 2 * 2 ^ k := by
  have h1 : monoPsiA (w.1 / 2 ^ (k + 1)) ≠ 0 := left_ne_zero_of_mul h
  have h2 : monoPhi (w.2 * (2 : ℝ) ^ ((100 : ℤ) - k)) ≠ 0 := right_ne_zero_of_mul h
  have a1 := (mloc_psiA_ne_zero h1).1
  have b := mloc_phi_ne_zero h2
  have hk : (0 : ℝ) < 2 ^ k := by positivity
  rw [abs_div, abs_of_pos (by positivity : (0 : ℝ) < 2 ^ (k + 1)), lt_div_iff₀ (by positivity),
    pow_succ] at a1
  rw [two_zpow_sub, abs_mul, abs_div, abs_of_pos hk, abs_of_pos (by positivity : (0 : ℝ) < 2 ^ 100),
    mul_div_assoc', div_lt_iff₀ hk] at b
  constructor <;> linarith

theorem cutTerm_support {k : ℕ} {w : ℝ × ℝ} (h : cutTerm k w ≠ 0) : |w.2| ≤ |w.1| / 8 := by
  obtain ⟨h1, h2⟩ := cutTerm_ne_zero h
  have : (8 : ℝ) ≤ 2 ^ 100 / 2 := by norm_num
  nlinarith [abs_nonneg w.2]

theorem mixCut_ne_zero {w : ℝ × ℝ} (h : mixCut w ≠ 0) : ∃ k, cutTerm k w ≠ 0 := by
  by_contra h'
  simp only [not_exists, ne_eq, not_not] at h'
  exact h (by simp [mixCut, h'])

theorem mixCut_support {w : ℝ × ℝ} (h : mixCut w ≠ 0) : |w.2| ≤ |w.1| / 8 := by
  obtain ⟨k, hk⟩ := mixCut_ne_zero h
  exact cutTerm_support hk

theorem mixCut_zero : mixCut 0 = 0 := by
  simp [mixCut, cutTerm, monoPsiA]

theorem contDiff_cutTerm (k : ℕ) : ContDiff ℝ ∞ (cutTerm k) :=
  (monoPsiA_contDiff.comp (contDiff_fst.div_const _)).mul
    (monoPhi_contDiff.comp (contDiff_snd.mul contDiff_const))

theorem mixCut_eventuallyEq (w : ℝ × ℝ) :
    mixCut =ᶠ[𝓝 w] fun v => ∑ k ∈ Finset.range (⌈|w.1|⌉₊ + 1), cutTerm k v := by
  have hU : {v : ℝ × ℝ | |v.1| < |w.1| + 1} ∈ 𝓝 w :=
    (isOpen_lt (by fun_prop) continuous_const).mem_nhds (by simp)
  filter_upwards [hU] with v hv
  apply tsum_eq_sum
  intro k hk
  by_contra h
  apply hk
  rw [Finset.mem_range]
  have h1 := (cutTerm_ne_zero h).1
  have hc : |w.1| ≤ ⌈|w.1|⌉₊ := Nat.le_ceil _
  have h2k : (k : ℝ) < 2 ^ k := by exact_mod_cast Nat.lt_two_pow_self
  have hv' : |v.1| < |w.1| + 1 := hv
  have : (k : ℝ) < ⌈|w.1|⌉₊ + 1 := by linarith
  exact_mod_cast this

theorem contDiff_mixCut : ContDiff ℝ ∞ mixCut :=
  contDiff_iff_contDiffAt.2 fun w =>
    (ContDiff.sum fun k _ => contDiff_cutTerm k).contDiffAt.congr_of_eventuallyEq
      (mixCut_eventuallyEq w)

theorem norm_iteratedFDeriv_comp_clm_le {g : ℝ → ℝ} (hg : ContDiff ℝ ∞ g)
    (L : ℝ × ℝ →L[ℝ] ℝ) (i : ℕ) (v : ℝ × ℝ) :
    ‖iteratedFDeriv ℝ i (fun v => g (L v)) v‖ ≤ ‖iteratedFDeriv ℝ i g (L v)‖ * ‖L‖ ^ i := by
  have e := L.iteratedFDeriv_comp_right hg v (i := i) (by exact_mod_cast le_top)
  change ‖iteratedFDeriv ℝ i (g ∘ L) v‖ ≤ _
  rw [e]
  refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans (le_of_eq ?_)
  rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]

theorem bound_iteratedFDeriv_of_compact {g : ℝ → ℝ} (hg : ContDiff ℝ ∞ g)
    (hc : HasCompactSupport g) (i : ℕ) : ∃ G, 0 ≤ G ∧ ∀ x, ‖iteratedFDeriv ℝ i g x‖ ≤ G := by
  obtain ⟨G, hG⟩ := Continuous.bounded_above_of_compact_support
    (hg.continuous_iteratedFDeriv (by exact_mod_cast le_top)) (hc.iteratedFDeriv i)
  exact ⟨max G 0, le_max_right _ _, fun x => (hG x).trans (le_max_left _ _)⟩

theorem cutTerm_eq (k : ℕ) : cutTerm k = fun v =>
    monoPsiA ((((2 : ℝ) ^ (k + 1))⁻¹ • ContinuousLinearMap.fst ℝ ℝ ℝ) v) *
      monoPhi ((((2 : ℝ) ^ ((100 : ℤ) - k)) • ContinuousLinearMap.snd ℝ ℝ ℝ) v) := by
  funext v
  simp [cutTerm, div_eq_inv_mul, mul_comm]

theorem norm_clm_fst_le (c : ℝ) : ‖c • ContinuousLinearMap.fst ℝ ℝ ℝ‖ ≤ |c| := by
  calc ‖c • ContinuousLinearMap.fst ℝ ℝ ℝ‖ ≤ ‖c‖ * ‖ContinuousLinearMap.fst ℝ ℝ ℝ‖ :=
        ContinuousLinearMap.opNorm_smul_le _ _
    _ ≤ ‖c‖ * 1 := by gcongr; exact ContinuousLinearMap.norm_fst_le ℝ ℝ ℝ
    _ = |c| := by rw [mul_one, Real.norm_eq_abs]

theorem norm_clm_snd_le (c : ℝ) : ‖c • ContinuousLinearMap.snd ℝ ℝ ℝ‖ ≤ |c| := by
  calc ‖c • ContinuousLinearMap.snd ℝ ℝ ℝ‖ ≤ ‖c‖ * ‖ContinuousLinearMap.snd ℝ ℝ ℝ‖ :=
        ContinuousLinearMap.opNorm_smul_le _ _
    _ ≤ ‖c‖ * 1 := by gcongr; exact ContinuousLinearMap.norm_snd_le ℝ ℝ ℝ
    _ = |c| := by rw [mul_one, Real.norm_eq_abs]

theorem cutTerm_deriv_bound (n : ℕ) :
    ∃ B, 0 ≤ B ∧ ∀ (k : ℕ) (v : ℝ × ℝ), ‖iteratedFDeriv ℝ n (cutTerm k) v‖ ≤ B := by
  choose P hP0 hP using bound_iteratedFDeriv_of_compact monoPsiA_contDiff
    monoPsiA_hasCompactSupport
  choose Q hQ0 hQ using bound_iteratedFDeriv_of_compact monoPhi_contDiff
    monoPhi_hasCompactSupport
  refine ⟨∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * P i * (Q (n - i) * (2 ^ 100) ^ (n - i)),
    Finset.sum_nonneg fun i _ => by have := hP0 i; have := hQ0 (n - i); positivity,
    fun k v => ?_⟩
  set L₁ := ((2 : ℝ) ^ (k + 1))⁻¹ • ContinuousLinearMap.fst ℝ ℝ ℝ with hL₁
  set L₂ := ((2 : ℝ) ^ ((100 : ℤ) - k)) • ContinuousLinearMap.snd ℝ ℝ ℝ with hL₂
  have hn1 : ‖L₁‖ ≤ 1 := (norm_clm_fst_le _).trans (by
    rw [abs_inv, abs_of_pos (by positivity)]
    exact inv_le_one_of_one_le₀ (one_le_pow₀ (by norm_num)))
  have hn2 : ‖L₂‖ ≤ 2 ^ 100 := (norm_clm_snd_le _).trans (by
    rw [abs_of_pos (by positivity), two_zpow_sub]
    exact div_le_self (by positivity) (one_le_pow₀ (by norm_num)))
  rw [cutTerm_eq]
  refine (norm_iteratedFDeriv_mul_le (monoPsiA_contDiff.comp L₁.contDiff)
    (monoPhi_contDiff.comp L₂.contDiff) v (by exact_mod_cast le_top)).trans
      (Finset.sum_le_sum fun i _ => ?_)
  have e1 : ‖iteratedFDeriv ℝ i (fun v => monoPsiA (L₁ v)) v‖ ≤ P i :=
    (norm_iteratedFDeriv_comp_clm_le monoPsiA_contDiff L₁ i v).trans
      ((mul_le_of_le_one_right (norm_nonneg _) (pow_le_one₀ (norm_nonneg _) hn1)).trans
        (hP i _))
  have e2 : ‖iteratedFDeriv ℝ (n - i) (fun v => monoPhi (L₂ v)) v‖ ≤
      Q (n - i) * (2 ^ 100) ^ (n - i) :=
    (norm_iteratedFDeriv_comp_clm_le monoPhi_contDiff L₂ (n - i) v).trans
      (mul_le_mul (hQ _ _) (pow_le_pow_left₀ (norm_nonneg _) hn2 _) (by positivity)
        (hQ0 _))
  rw [mul_assoc, mul_assoc]
  exact mul_le_mul_of_nonneg_left (mul_le_mul e1 e2 (norm_nonneg _) (hP0 i))
    (Nat.cast_nonneg _)

theorem mixCut_deriv_bound (n : ℕ) :
    ∃ B, ∀ w, ‖iteratedFDeriv ℝ n mixCut w‖ ≤ B * (1 + ‖w‖) := by
  obtain ⟨B, hB0, hB⟩ := cutTerm_deriv_bound n
  refine ⟨2 * B, fun w => ?_⟩
  rw [((mixCut_eventuallyEq w).iteratedFDeriv ℝ n).eq_of_nhds,
    iteratedFDeriv_sum fun k _ => (contDiff_cutTerm k).of_le (by exact_mod_cast le_top),
    Finset.sum_apply]
  refine (norm_sum_le _ _).trans ((Finset.sum_le_sum fun k _ => hB k w).trans ?_)
  rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  have h1 : |w.1| ≤ ‖w‖ := by simpa using norm_fst_le w
  have h2 : (⌈|w.1|⌉₊ : ℝ) < |w.1| + 1 := Nat.ceil_lt_add_one (abs_nonneg _)
  push_cast
  nlinarith [norm_nonneg w]

/-! ### The mixed-frequency symbols -/

/-- The normalized symbol of `I`: `ϑ(ξ,η) ∑_k ψ(2^{-k-1} ξ) φ(2^{100-k} η)`. -/
def mixNuI (w : ℝ × ℝ) : ℂ := oscInt tjBump w.1 w.2 *
  ∑' k : ℕ, ((monoPsiA (w.1 / 2 ^ (k + 1)) * monoPhi (w.2 * (2 : ℝ) ^ ((100 : ℤ) - k)) : ℝ) : ℂ)

/-- The normalized symbol of `II`: `ϑ(ξ,η) ∑_k φ(2^{100-k} ξ) ψ(2^{-k-1} η)`. -/
def mixNuII (w : ℝ × ℝ) : ℂ := oscInt tjBump w.1 w.2 *
  ∑' k : ℕ, ((monoPhi (w.1 * (2 : ℝ) ^ ((100 : ℤ) - k)) * monoPsiA (w.2 / 2 ^ (k + 1)) : ℝ) : ℂ)

theorem mixNuI_eq : mixNuI = fun w => oscIntC (fun t => (tjBump t : ℂ)) w * (mixCut w : ℂ) := by
  funext w
  rw [mixNuI, mixCut, Complex.ofReal_tsum]
  rfl

theorem mixNuII_eq :
    mixNuII = fun w => oscIntC (fun t => (tjBump t : ℂ)) w * (mixCut w.swap : ℂ) := by
  funext w
  rw [mixNuII, mixCut, Complex.ofReal_tsum]
  congr 1
  refine tsum_congr fun k => ?_
  simp only [cutTerm, Prod.fst_swap, Prod.snd_swap]
  rw [mul_comm]

theorem ampII_tjBump : AmpII (fun t => (tjBump t : ℂ)) := by
  refine ⟨⟨Complex.ofRealCLM.contDiff.comp tjBump_contDiff, fun t ht => ?_⟩, fun t ht => ?_⟩
  · change ((tjBump t : ℝ) : ℂ) = 0
    rw [mem_Icc, not_and_or, not_le, not_le] at ht
    rw [tjBump_eq_zero (Or.inr ?_), Complex.ofReal_zero]
    rcases ht with ht | ht
    · rw [abs_of_neg (by linarith)]; linarith
    · rw [abs_of_pos (by linarith)]; linarith
  · change ((tjBump t : ℝ) : ℂ) = 0
    rw [tjBump_eq_zero (Or.inl (abs_le.2 ⟨ht.1.le, ht.2.le⟩)), Complex.ofReal_zero]

theorem contDiff_oscIntC_tjBump : ContDiff ℝ ∞ (oscIntC (fun t => (tjBump t : ℂ))) :=
  contDiff_oscIntC ampII_tjBump.1.1.continuous ampII_tjBump.1.hasCompactSupport

theorem contDiff_mixNuI : ContDiff ℝ ∞ mixNuI := by
  rw [mixNuI_eq]
  exact contDiff_oscIntC_tjBump.mul (Complex.ofRealCLM.contDiff.comp contDiff_mixCut)

theorem contDiff_mixNuII : ContDiff ℝ ∞ mixNuII := by
  rw [mixNuII_eq]
  exact contDiff_oscIntC_tjBump.mul (Complex.ofRealCLM.contDiff.comp
    (contDiff_mixCut.comp (contDiff_snd.prodMk contDiff_fst)))

theorem mixNuI_zero : mixNuI 0 = 0 := by
  rw [mixNuI_eq]
  simp [mixCut_zero]

theorem mixNuII_zero : mixNuII 0 = 0 := by
  rw [mixNuII_eq]
  simp [mixCut_zero]

theorem symDecay_mixNuI : SymDecay mixNuI := by
  rw [mixNuI_eq]
  refine symDecay_mul contDiff_oscIntC_tjBump contDiff_mixCut (Ω := {w | |w.2| ≤ |w.1| / 8})
    (closure_minimal (fun w hw => mixCut_support hw) (isClosed_le (by fun_prop) (by fun_prop)))
    (fun n M => ?_) mixCut_deriv_bound
  obtain ⟨C, hC⟩ := ampII_tjBump.1.deriv_decay n M
  exact ⟨C, fun w hw => hC w hw⟩

theorem symDecay_mixNuII : SymDecay mixNuII := by
  rw [mixNuII_eq]
  refine symDecay_mul contDiff_oscIntC_tjBump
    (contDiff_mixCut.comp (contDiff_snd.prodMk contDiff_fst))
    (Ω := {w | |w.1| ≤ |w.2| / 8})
    (closure_minimal (fun w hw => by simpa using mixCut_support hw)
      (isClosed_le (by fun_prop) (by fun_prop))) (fun n M => ?_) (fun n => ?_)
  · obtain ⟨C, hC⟩ := ampII_tjBump.deriv_decay n M
    exact ⟨C, fun w hw => hC w hw⟩
  · obtain ⟨B, hB⟩ := mixCut_deriv_bound n
    refine ⟨B, fun w => ?_⟩
    have e := LinearIsometryEquiv.norm_iteratedFDeriv_comp_right
      (LinearIsometryEquiv.prodComm ℝ ℝ ℝ) mixCut w n
    have hn : ‖(LinearIsometryEquiv.prodComm ℝ ℝ ℝ) w‖ = ‖w‖ :=
      LinearIsometryEquiv.norm_map _ _
    change ‖iteratedFDeriv ℝ n (mixCut ∘ (LinearIsometryEquiv.prodComm ℝ ℝ ℝ)) w‖ ≤ _
    rw [e]
    exact (hB _).trans (le_of_eq (by rw [hn]))

/-- **Mixed frequencies, term `I`** (`sec:mixed-red`, `est-statph`): the symbols
`∑_{j ∈ F} ν_I(-2^{-j} ξ, -4^{-j} η)` with `ν_I(ξ,η) = ϑ(ξ,η) ∑_{k ≥ 0} ψ(2^{-k-1} ξ)
φ(2^{100-k} η)` satisfy the anisotropic symbol estimates uniformly in `F`. -/
theorem mixNuI_isAnisoSymbol (N : ℕ) :
    ∃ C, ∀ F : Finset ℤ, IsAnisoSymbol 1 2 N C (symSum mixNuI F) :=
  isAnisoSymbol_symSum contDiff_mixNuI mixNuI_zero symDecay_mixNuI N

/-- **Mixed frequencies, term `II`**: the same for
`ν_II(ξ,η) = ϑ(ξ,η) ∑_{k ≥ 0} φ(2^{100-k} ξ) ψ(2^{-k-1} η)`. -/
theorem mixNuII_isAnisoSymbol (N : ℕ) :
    ∃ C, ∀ F : Finset ℤ, IsAnisoSymbol 1 2 N C (symSum mixNuII F) :=
  isAnisoSymbol_symSum contDiff_mixNuII mixNuII_zero symDecay_mixNuII N

end

