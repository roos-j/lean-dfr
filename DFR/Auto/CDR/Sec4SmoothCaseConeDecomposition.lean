  ContDiffOn ℝ N m {0}ᶜ ∧ Measurable m ∧
    ∀ k ℓ : ℕ, k + ℓ ≤ N → ∀ p : ℝ × ℝ, p ≠ 0 →
      ‖iteratedFDeriv ℝ (k + ℓ) m p
          (Fin.append (fun _ : Fin k => ((1 : ℝ), (0 : ℝ)))
            (fun _ : Fin ℓ => ((0 : ℝ), (1 : ℝ))))‖ ≤
        C * (|p.1| ^ ((α : ℝ)⁻¹) + |p.2| ^ ((β : ℝ)⁻¹)) ^ (-((α * k + β * ℓ : ℕ) : ℝ))

/-- The operator `T_m(f₁,f₂)(x,y) = ∫∫ f₁(x+s,y) f₂(x,y+t) K(s,t) ds dt` with `K̂ = m`, written
on the frequency side: with `𝓕 f(ξ) = ∫ f(x) e^{-2πixξ} dx`,
`f₁(x+s,y) = ∫ 𝓕₁f₁(ξ,y) e^{2πi(x+s)ξ} dξ` and `f₂(x,y+t) = ∫ 𝓕₂f₂(x,η) e^{2πi(y+t)η} dη`, so
pairing with `K` produces `∫ K(s,t) e^{2πi(sξ+tη)} ds dt = K̂(-ξ,-η) = m(-ξ,-η)`. -/
def Tm (m : ℝ × ℝ → ℂ) (f₁ f₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℂ :=
  ∫ ξ, ∫ η, m (-ξ, -η) * 𝓕 (fun x => f₁ (x, z.2)) ξ * 𝓕 (fun y => f₂ (z.1, y)) η *
    Complex.exp (2 * π * Complex.I * (z.1 * ξ + z.2 * η))

/-- The untruncated model operator
`U(f₁,f₂)(x,y) = ∫_0^∞ c(t) (f₁ *₁ φ_{t^α})(x,y) (f₂ *₂ ρ_{t^β})(x,y) dt/t`. -/
