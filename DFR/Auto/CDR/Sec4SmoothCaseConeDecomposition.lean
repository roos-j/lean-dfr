  ∫ t in Ioi 0, c t * ((∫ x', f₁ (x', z.2) * ((kernelAt φ (t ^ α) x' z.1 : ℝ) : ℂ)) *
    (∫ y', f₂ (z.1, y') * ((kernelAt ρ (t ^ β) y' z.2 : ℝ) : ℂ))) / t

/-- `g * Φ`. -/
def gconv (Φ : ℝ → ℝ) (x : ℝ) : ℝ := ∫ y, gaussian (x - y) * Φ y

/-- `h * h`, `h = g'`. -/
def hh : ℝ → ℝ := gaussianDeriv ⋆ gaussianDeriv

/-- `h * h * Ψ`. -/
def hhconv (Ψ : ℝ → ℝ) (x : ℝ) : ℝ := ∫ y, hh (x - y) * Ψ y

/-- Bounds `‖U(f₁,f₂)‖_r ≤ C (A B + 1)^D ‖f₁‖_p ‖f₂‖_q` for the model operators with kernels
