      ‖iteratedFDeriv ℝ k μ p (fun _ => ((0 : ℝ), (1 : ℝ)))‖ ≤
        C * anisoRadius α β p ^ (-((β * k : ℕ) : ℝ)))

theorem iteratedFDeriv_append_nil_left (m : ℝ × ℝ → ℂ) (p : ℝ × ℝ) (ℓ : ℕ) :
