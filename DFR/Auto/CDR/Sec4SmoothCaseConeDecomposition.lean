  refine ⟨max B 0, le_max_right _ _, fun x => ?_⟩
  rw [← norm_iteratedFDeriv_eq_norm_iteratedDeriv]
  exact (hB ⟨x, rfl⟩).trans (le_max_left _ _)

end Cone


namespace Cone

/-! ### The Calderón reproducing formula `mdecompose2` -/

/-- `ψ(x) h(x)^2`. -/
def psiH (x : ℝ) : ℝ := conePsi x * gaussianDeriv x ^ 2

/-- The density `β φ(t^α ξ) ψ(t^β η) h(t^β η)^2 / t` of the first cone. -/
def w1 (α β : ℕ) (p : ℝ × ℝ) (t : ℝ) : ℝ := β * conePhi (t ^ α * p.1) * psiH (t ^ β * p.2) / t

/-- The density `α ψ(t^α ξ) h(t^α ξ)^2 φ(t^β η) / t` of the second cone. -/
def w2 (α β : ℕ) (p : ℝ × ℝ) (t : ℝ) : ℝ := α * psiH (t ^ α * p.1) * conePhi (t ^ β * p.2) / t

theorem w2_eq_w1_swap (α β : ℕ) (p : ℝ × ℝ) (t : ℝ) : w2 α β p t = w1 β α p.swap t := by
  simp only [w1, w2, Prod.fst_swap, Prod.snd_swap]; ring

theorem psiH_nonneg (x : ℝ) : 0 ≤ psiH x :=
  mul_nonneg (Auto.Twisted.conePsi_nonneg x) (sq_nonneg _)

theorem psiH_eq_zero_of_abs_le_one {x : ℝ} (hx : |x| ≤ 1) : psiH x = 0 := by
  simp [psiH, Auto.Twisted.conePsi_eq_zero_of_abs_le_one hx]

theorem psiH_eq_zero_of_two_le_abs {x : ℝ} (hx : 2 ≤ |x|) : psiH x = 0 := by
  simp [psiH, Auto.Twisted.conePsi_eq_zero_of_two_le_abs hx]

theorem continuous_gaussianDeriv : Continuous gaussianDeriv := by
  unfold Auto.Twisted.gaussianDeriv Auto.Twisted.gaussian; fun_prop

theorem continuous_psiH : Continuous psiH :=
  Auto.Twisted.conePsi_contDiff.continuous.mul (continuous_gaussianDeriv.pow 2)

theorem continuous_conePhi : Continuous conePhi := Auto.Twisted.conePhi_contDiff.continuous

theorem w1_nonneg (α β : ℕ) (p : ℝ × ℝ) {t : ℝ} (ht : 0 < t) : 0 ≤ w1 α β p t := by
  unfold w1
  have := Auto.Twisted.conePhi_nonneg (t ^ α * p.1)
  have := psiH_nonneg (t ^ β * p.2)
  positivity

theorem w2_nonneg (α β : ℕ) (p : ℝ × ℝ) {t : ℝ} (ht : 0 < t) : 0 ≤ w2 α β p t := by
  unfold w2
  have := Auto.Twisted.conePhi_nonneg (t ^ β * p.2)
  have := psiH_nonneg (t ^ α * p.1)
  positivity

/-- `t ⋅ (d/dt) φ(t^n x) = -n ψ(t^n x) h(t^n x)^2`. -/
theorem mul_deriv_conePhi_scale {n : ℕ} (hn : 0 < n) (x t : ℝ) :
    t * (-coneWeight (t ^ n * x) * ((n : ℝ) * t ^ (n - 1) * x)) = -(n * psiH (t ^ n * x)) := by
  have hpow : t * t ^ (n - 1) = t ^ n := by
    rw [← pow_succ']; congr 1; omega
  unfold psiH coneWeight gaussianDeriv
  rw [← hpow]
  ring

theorem hasDerivAt_conePhi_scale (n : ℕ) (x t : ℝ) :
    HasDerivAt (conePhi ∘ fun s : ℝ => s ^ n * x)
      (-coneWeight (t ^ n * x) * ((n : ℝ) * t ^ (n - 1) * x)) t := by
  have hpow : HasDerivAt (fun s : ℝ => s ^ n * x) ((n : ℝ) * t ^ (n - 1) * x) t := by
    simpa using (hasDerivAt_pow n t).mul_const x
  exact (Auto.Twisted.hasDerivAt_conePhi (t ^ n * x)).comp t hpow

/-- Finite-scale form of the two-cone Calderón identity. -/
theorem integral_w_interval {α β : ℕ} (hα : 0 < α) (hβ : 0 < β) (p : ℝ × ℝ) {a b : ℝ}
    (ha : 0 < a) (hab : a ≤ b) :
    ∫ t in a..b, (w1 α β p t + w2 α β p t) =
      conePhi (a ^ α * p.1) * conePhi (a ^ β * p.2) -
        conePhi (b ^ α * p.1) * conePhi (b ^ β * p.2) := by
  let F : ℝ → ℝ := (conePhi ∘ fun s : ℝ => s ^ α * p.1) * (conePhi ∘ fun s : ℝ => s ^ β * p.2)
  let F' : ℝ → ℝ := fun s =>
    (-coneWeight (s ^ α * p.1) * ((α : ℝ) * s ^ (α - 1) * p.1)) * conePhi (s ^ β * p.2) +
      conePhi (s ^ α * p.1) * (-coneWeight (s ^ β * p.2) * ((β : ℝ) * s ^ (β - 1) * p.2))
  have hF : ∀ s, HasDerivAt F (F' s) s := fun s =>
    (hasDerivAt_conePhi_scale α p.1 s).mul (hasDerivAt_conePhi_scale β p.2 s)
  have hcw : Continuous coneWeight := Auto.Twisted.coneWeight_contDiff.continuous
  have hF'c : Continuous F' := by
    simp only [F']
    have := continuous_conePhi
    fun_prop
  have hFTC := intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le hab
    (fun s _ => (hF s).continuousAt.continuousWithinAt) (fun s _ => hF s)
    (hF'c.intervalIntegrable a b)
  have hpt : ∀ t ∈ uIcc a b, w1 α β p t + w2 α β p t = -F' t := by
    intro t ht
    rw [uIcc_of_le hab] at ht
    have ht0 : 0 < t := ha.trans_le ht.1
    have e1 := mul_deriv_conePhi_scale hα p.1 t
    have e2 := mul_deriv_conePhi_scale hβ p.2 t
    simp only [w1, w2, F']
    rw [← add_div, div_eq_iff ht0.ne']
    linear_combination (conePhi (t ^ β * p.2)) * e1 + conePhi (t ^ α * p.1) * e2
  rw [intervalIntegral.integral_congr hpt, intervalIntegral.integral_neg, hFTC]
  simp only [F, Pi.mul_apply, Function.comp_apply]
  ring

/-- The scale integrands vanish near `t = 0` and for large `t`. -/
theorem w_eq_zero_of_small (α β : ℕ) (hα : 0 < α) (hβ : 0 < β) (p : ℝ × ℝ) {t : ℝ} (ht : 0 < t)
    (hs : t ≤ 1 / (1 + |p.1| + |p.2|)) : w1 α β p t = 0 ∧ w2 α β p t = 0 := by
  have hD : 0 < 1 + |p.1| + |p.2| := by positivity
  have ht1 : t ≤ 1 := hs.trans (by rw [div_le_one hD]; linarith [abs_nonneg p.1, abs_nonneg p.2])
  have key : ∀ (n : ℕ), 0 < n → ∀ x : ℝ, |x| ≤ |p.1| + |p.2| → |t ^ n * x| ≤ 1 := by
    intro n hn x hx
    rw [abs_mul, abs_of_pos (pow_pos ht n)]
    have h1 : t ^ n ≤ t := pow_le_of_le_one ht.le ht1 hn.ne'
    have h2 : t * (1 + |p.1| + |p.2|) ≤ 1 := by rwa [le_div_iff₀ hD] at hs
    nlinarith [abs_nonneg x, pow_pos ht n]
  have k1 := key α hα p.1 (by linarith [abs_nonneg p.2])
  have k2 := key β hβ p.2 (by linarith [abs_nonneg p.1])
  exact ⟨by simp [w1, psiH_eq_zero_of_abs_le_one k2], by simp [w2, psiH_eq_zero_of_abs_le_one k1]⟩

theorem w_eq_zero_of_large (α β : ℕ) (hα : 0 < α) (hβ : 0 < β) {p : ℝ × ℝ} (hp : p ≠ 0) {t : ℝ}
    (hs : 2 + 2 / |p.1| + 2 / |p.2| ≤ t) :
    (2 ≤ |t ^ α * p.1| ∨ 2 ≤ |t ^ β * p.2|) ∧ w1 α β p t = 0 ∧ w2 α β p t = 0 := by
  have h2 : 2 / |p.1| ≥ 0 := by positivity
  have h3 : 2 / |p.2| ≥ 0 := by positivity
  have ht1 : 1 ≤ t := by linarith
  have key : ∀ (n : ℕ), 0 < n → ∀ x : ℝ, x ≠ 0 → 2 / |x| ≤ t → 2 ≤ |t ^ n * x| := by
    intro n hn x hx hxt
    have hx' : 0 < |x| := abs_pos.2 hx
    rw [abs_mul, abs_of_pos (pow_pos (by linarith) n)]
    have h1 : t ≤ t ^ n := le_self_pow₀ ht1 hn.ne'
    rw [div_le_iff₀ hx'] at hxt
    nlinarith
  have hor : 2 ≤ |t ^ α * p.1| ∨ 2 ≤ |t ^ β * p.2| := by
    by_cases h1 : p.1 = 0
    · have h2' : p.2 ≠ 0 := fun h => hp (Prod.ext h1 h)
      exact Or.inr (key β hβ p.2 h2' (by linarith))
    · exact Or.inl (key α hα p.1 h1 (by linarith))
  refine ⟨hor, ?_, ?_⟩
  · rcases hor with h | h
    · simp [w1, Auto.Twisted.conePhi_eq_zero_of_two_le_abs h]
    · simp [w1, psiH_eq_zero_of_two_le_abs h]
  · rcases hor with h | h
    · simp [w2, psiH_eq_zero_of_two_le_abs h]
    · simp [w2, Auto.Twisted.conePhi_eq_zero_of_two_le_abs h]

theorem continuousOn_w1 (α β : ℕ) (p : ℝ × ℝ) : ContinuousOn (w1 α β p) (Ioi 0) := by
  intro t ht
  have := continuous_conePhi
  have := continuous_psiH
  exact (by fun_prop : Continuous fun t : ℝ =>
    (β : ℝ) * conePhi (t ^ α * p.1) * psiH (t ^ β * p.2)).continuousAt.continuousWithinAt.div
      continuousWithinAt_id (ne_of_gt ht)

theorem continuousOn_w2 (α β : ℕ) (p : ℝ × ℝ) : ContinuousOn (w2 α β p) (Ioi 0) := by
  intro t ht
  have := continuous_conePhi
  have := continuous_psiH
  exact (by fun_prop : Continuous fun t : ℝ =>
    (α : ℝ) * psiH (t ^ α * p.1) * conePhi (t ^ β * p.2)).continuousAt.continuousWithinAt.div
      continuousWithinAt_id (ne_of_gt ht)

/-- The two-cone Calderón identity: `∫_0^∞ (w₁ + w₂) dt = c_Ψ^2` for `(ξ, η) ≠ 0`, together
with the integrability of both densities. -/
theorem calderon {α β : ℕ} (hα : 0 < α) (hβ : 0 < β) {p : ℝ × ℝ} (hp : p ≠ 0) :
    IntegrableOn (w1 α β p) (Ioi 0) ∧ IntegrableOn (w2 α β p) (Ioi 0) ∧
      (∫ t in Ioi 0, w1 α β p t) + (∫ t in Ioi 0, w2 α β p t) = cPsi ^ 2 := by
  set a : ℝ := 1 / (1 + |p.1| + |p.2|) with ha_def
  set b : ℝ := 2 + 2 / |p.1| + 2 / |p.2| with hb_def
  have ha : 0 < a := by positivity
  have hb2 : 2 ≤ b := by
    have h2 : 2 / |p.1| ≥ 0 := by positivity
    have h3 : 2 / |p.2| ≥ 0 := by positivity
    linarith
  have ha1 : a ≤ 1 := by
    rw [ha_def, div_le_one (by positivity)]; linarith [abs_nonneg p.1, abs_nonneg p.2]
  have hab : a ≤ b := by linarith
  have hsub : Ioc a b ⊆ Ioi 0 := fun t ht => ha.trans ht.1
  have hzero : ∀ t ∈ Ioi (0 : ℝ) \ Ioc a b, w1 α β p t = 0 ∧ w2 α β p t = 0 := by
    intro t ⟨ht0, htab⟩
    simp only [mem_Ioc, not_and_or, not_lt, not_le] at htab
    rcases htab with h | h
    · exact w_eq_zero_of_small α β hα hβ p ht0 h
    · exact (w_eq_zero_of_large α β hα hβ hp h.le).2
  have hI1 : IntegrableOn (w1 α β p) (Ioc a b) :=
    ((continuousOn_w1 α β p).mono (Icc_subset_Ioi_iff hab |>.2 ha)).integrableOn_Icc.mono_set
      Ioc_subset_Icc_self
  have hI2 : IntegrableOn (w2 α β p) (Ioc a b) :=
    ((continuousOn_w2 α β p).mono (Icc_subset_Ioi_iff hab |>.2 ha)).integrableOn_Icc.mono_set
      Ioc_subset_Icc_self
  have e1 := setIntegral_eq_of_subset_of_forall_sdiff_eq_zero (μ := volume) measurableSet_Ioi hsub
    (fun t ht => (hzero t ht).1)
  have e2 := setIntegral_eq_of_subset_of_forall_sdiff_eq_zero (μ := volume) measurableSet_Ioi hsub
    (fun t ht => (hzero t ht).2)
  refine ⟨hI1.of_forall_sdiff_eq_zero measurableSet_Ioi (fun t ht => (hzero t ht).1),
    hI2.of_forall_sdiff_eq_zero measurableSet_Ioi (fun t ht => (hzero t ht).2), ?_⟩
  rw [e1, e2, ← integral_add hI1 hI2, ← intervalIntegral.integral_of_le hab,
    integral_w_interval hα hβ p ha hab]
  have hFa : conePhi (a ^ α * p.1) * conePhi (a ^ β * p.2) = cPsi ^ 2 := by
    have := (w_eq_zero_of_small α β hα hβ p ha le_rfl)
    have key : ∀ (n : ℕ), 0 < n → ∀ x : ℝ, |x| ≤ |p.1| + |p.2| → |a ^ n * x| ≤ 1 := by
      intro n hn x hx
      rw [abs_mul, abs_of_pos (pow_pos ha n)]
      have h1 : a ^ n ≤ a := pow_le_of_le_one ha.le ha1 hn.ne'
      have h2 : a * (1 + |p.1| + |p.2|) ≤ 1 := by
        rw [ha_def, div_mul_cancel₀]; positivity
      nlinarith [abs_nonneg x, pow_pos ha n]
    rw [Auto.Twisted.conePhi_eq_cPsi_of_abs_le_one (key α hα p.1 (by linarith [abs_nonneg p.2])),
      Auto.Twisted.conePhi_eq_cPsi_of_abs_le_one (key β hβ p.2 (by linarith [abs_nonneg p.1]))]
    ring
  have hFb : conePhi (b ^ α * p.1) * conePhi (b ^ β * p.2) = 0 := by
    rcases (w_eq_zero_of_large α β hα hβ hp le_rfl).1 with h | h
    · rw [Auto.Twisted.conePhi_eq_zero_of_two_le_abs h, zero_mul]
    · rw [Auto.Twisted.conePhi_eq_zero_of_two_le_abs h, mul_zero]
  rw [hFa, hFb, sub_zero]

theorem integrableOn_w1 {α β : ℕ} (hα : 0 < α) (hβ : 0 < β) (p : ℝ × ℝ) :
    IntegrableOn (w1 α β p) (Ioi 0) := by
  by_cases hp : p = 0
  · subst hp
    have : w1 α β 0 = fun _ => 0 := by
      funext t; simp [w1, psiH_eq_zero_of_abs_le_one]
    rw [this]; exact integrableOn_zero
  · exact (calderon hα hβ hp).1

theorem integral_w1_nonneg (α β : ℕ) (p : ℝ × ℝ) : 0 ≤ ∫ t in Ioi 0, w1 α β p t :=
  setIntegral_nonneg measurableSet_Ioi fun _ ht => w1_nonneg α β p ht

theorem integral_w1_le {α β : ℕ} (hα : 0 < α) (hβ : 0 < β) (p : ℝ × ℝ) :
    ∫ t in Ioi 0, w1 α β p t ≤ cPsi ^ 2 := by
  by_cases hp : p = 0
  · subst hp
    have : w1 α β 0 = fun _ => 0 := by
      funext t; simp [w1, psiH_eq_zero_of_abs_le_one]
    rw [this]; simp only [integral_zero]; positivity
  · have h := (calderon hα hβ hp).2.2
    have h2 : 0 ≤ ∫ t in Ioi 0, w2 α β p t :=
      setIntegral_nonneg measurableSet_Ioi fun _ ht => w2_nonneg α β p ht
    linarith

end Cone


namespace Cone

/-! ### The localized symbols `m^{(t)}` -/

/-- `φ̃(x) / g(x)`, the low-frequency cutoff divided by the Gaussian. -/
def kap (x : ℝ) : ℂ := ((localConePhi x / gaussian x : ℝ) : ℂ)

/-- `ψ̃`, the annular cutoff. -/
def lam (y : ℝ) : ℂ := ((localConePsi y : ℝ) : ℂ)

/-- The localized symbol `m^{(t)}`, in the coordinates of the unit torus
(frequency `(a, b) = (8x, 8y)`):
`(x, y) ↦ μ(8x/t^α, 8y/t^β) φ̃(8x) g(8x)^{-1} ψ̃(8y)`. -/
def locSym (α β : ℕ) (μ : ℝ × ℝ → ℂ) (t : ℝ) (q : ℝ × ℝ) : ℂ :=
  μ (8 * q.1 / t ^ α, 8 * q.2 / t ^ β) * (kap (8 * q.1) * lam (8 * q.2))

theorem kap_contDiff : ContDiff ℝ ∞ kap := by
  unfold kap
  refine Complex.ofRealCLM.contDiff.comp ?_
  exact Auto.Twisted.localConePhi_contDiff.div Auto.Twisted.gaussian_contDiff
    (fun x => (Auto.Twisted.gaussian_pos x).ne')

theorem lam_contDiff : ContDiff ℝ ∞ lam :=
  Complex.ofRealCLM.contDiff.comp Auto.Twisted.localConePsi_contDiff

theorem kap_eq_zero {x : ℝ} (hx : 3 ≤ |x|) : kap x = 0 := by
  simp [kap, Auto.Twisted.localConePhi_eq_zero hx]

theorem lam_eq_zero_of_large {y : ℝ} (hy : 5 / 2 ≤ |y|) : lam y = 0 := by
  simp [lam, Auto.Twisted.localConePsi_eq_zero_of_five_halves_le_abs hy]

theorem lam_eq_zero_of_small {y : ℝ} (hy : |y| ≤ 1 / 2) : lam y = 0 := by
  simp [lam, Auto.Twisted.localConePsi_eq_zero_of_abs_le_half hy]

theorem kap_hasCompactSupport : HasCompactSupport kap := by
  apply HasCompactSupport.intro (isCompact_closedBall (0 : ℝ) 3)
  intro x hx
  exact kap_eq_zero (by
    simp only [Metric.mem_closedBall, Real.dist_eq, sub_zero, not_le] at hx; exact hx.le)

theorem lam_hasCompactSupport : HasCompactSupport lam := by
  apply HasCompactSupport.intro (isCompact_closedBall (0 : ℝ) 3)
  intro x hx
  exact lam_eq_zero_of_large (by
    simp only [Metric.mem_closedBall, Real.dist_eq, sub_zero, not_le] at hx; linarith)

/-- On the support of `φ`, `φ̃ g^{-1} ⋅ g φ = φ`. -/
theorem kap_mul_gaussian_conePhi (a : ℝ) :
    kap a * ((gaussian a * conePhi a : ℝ) : ℂ) = (conePhi a : ℂ) := by
  by_cases h : conePhi a = 0
  · simp [h]
  · rw [kap, Auto.Twisted.localConePhi_eq_one_of_conePhi_ne_zero h, ← Complex.ofReal_mul]
    congr 1
    have := (Auto.Twisted.gaussian_pos a).ne'
    field_simp

theorem lam_mul_psiH (b : ℝ) : lam b * (psiH b : ℂ) = (psiH b : ℂ) := by
  by_cases h : conePsi b = 0
  · simp [psiH, h]
  · rw [lam, Auto.Twisted.localConePsi_eq_one_of_conePsi_ne_zero h]; simp

theorem locSym_eq_zero_x {α β : ℕ} {μ : ℝ × ℝ → ℂ} {t : ℝ} {q : ℝ × ℝ} (hq : 3 / 8 ≤ |q.1|) :
    locSym α β μ t q = 0 := by
  have : 3 ≤ |8 * q.1| := by rw [abs_mul]; norm_num; linarith
  simp [locSym, kap_eq_zero this]

theorem locSym_eq_zero_y_large {α β : ℕ} {μ : ℝ × ℝ → ℂ} {t : ℝ} {q : ℝ × ℝ}
    (hq : 5 / 16 ≤ |q.2|) : locSym α β μ t q = 0 := by
  have : 5 / 2 ≤ |8 * q.2| := by rw [abs_mul]; norm_num; linarith
  simp [locSym, lam_eq_zero_of_large this]

theorem locSym_eq_zero_y_small {α β : ℕ} {μ : ℝ × ℝ → ℂ} {t : ℝ} {q : ℝ × ℝ}
    (hq : |q.2| ≤ 1 / 16) : locSym α β μ t q = 0 := by
  have : |8 * q.2| ≤ 1 / 2 := by rw [abs_mul]; norm_num; linarith
  simp [locSym, lam_eq_zero_of_small this]

/-! ### Anisotropic scaling of the derivative bounds -/

theorem PureBounds.nonneg {α β N : ℕ} {C : ℝ} {μ : ℝ × ℝ → ℂ} (hμ : PureBounds α β N C μ) :
    0 ≤ C := by
  have h := hμ.2.2.1 0 (Nat.zero_le _) ((0 : ℝ), (1 : ℝ)) (by simp [Prod.ext_iff])
  simp only [mul_zero, CharP.cast_eq_zero, neg_zero, Real.rpow_zero, mul_one] at h
  exact (norm_nonneg _).trans h

theorem PureBounds.norm_le {α β N : ℕ} {C : ℝ} {μ : ℝ × ℝ → ℂ} (hμ : PureBounds α β N C μ)
    {p : ℝ × ℝ} (hp : p ≠ 0) : ‖μ p‖ ≤ C := by
  have h := hμ.2.2.1 0 (Nat.zero_le _) p hp
  simpa using h

theorem anisoRadius_div {α β : ℕ} (hα : 0 < α) (hβ : 0 < β) {t : ℝ} (ht : 0 < t) (a b : ℝ) :
    anisoRadius α β (a / t ^ α, b / t ^ β) = anisoRadius α β (a, b) / t := by
  unfold anisoRadius
  simp only
  rw [abs_div, abs_div, abs_of_pos (pow_pos ht α), abs_of_pos (pow_pos ht β),
    Real.div_rpow (abs_nonneg _) (pow_nonneg ht.le _),
    Real.div_rpow (abs_nonneg _) (pow_nonneg ht.le _),
    Real.pow_rpow_inv_natCast ht.le hα.ne', Real.pow_rpow_inv_natCast ht.le hβ.ne', add_div]

theorem half_le_anisoRadius {α β : ℕ} (hβ : 0 < β) (a : ℝ) {b : ℝ} (hb : 1 / 2 ≤ |b|) :
    1 / 2 ≤ anisoRadius α β (a, b) := by
  unfold anisoRadius
  simp only
  have h1 : (1 / 2 : ℝ) ^ ((β : ℝ)⁻¹) ≤ |b| ^ ((β : ℝ)⁻¹) :=
    Real.rpow_le_rpow (by norm_num) hb (by positivity)
  have h2 : (1 / 2 : ℝ) ^ (1 : ℝ) ≤ (1 / 2 : ℝ) ^ ((β : ℝ)⁻¹) := by
    apply Real.rpow_le_rpow_of_exponent_ge (by norm_num) (by norm_num)
    rw [inv_le_one₀ (by exact_mod_cast hβ)]; exact_mod_cast hβ
  have h3 : 0 ≤ |a| ^ ((α : ℝ)⁻¹) := by positivity
  rw [Real.rpow_one] at h2
  linarith

/-- `(R/t)^{-n} = t^n / R^n`. -/
theorem div_rpow_neg_natCast {R t : ℝ} (hR : 0 < R) (ht : 0 < t) (n : ℕ) :
    (R / t) ^ (-(n : ℝ)) = t ^ n / R ^ n := by
  rw [Real.rpow_neg (div_nonneg hR.le ht.le), Real.rpow_natCast, div_pow, inv_div]

/-- The rescaled derivative bound: for `p = (a/t^α, b/t^β)` with `|b| ≥ 1/2`,
`s^n (C ρ(p)^{-wn}) ≤ 8^n C 2^{wn}` when `s = 8/t^w`. -/
theorem scaled_bound {α β : ℕ} (hα : 0 < α) (hβ : 0 < β) {C : ℝ} (hC : 0 ≤ C) {t : ℝ}
    (ht : 0 < t) (a : ℝ) {b : ℝ} (hb : 1 / 2 ≤ |b|) (w n : ℕ) :
    (8 / t ^ w) ^ n * (C * anisoRadius α β (a / t ^ α, b / t ^ β) ^ (-((w * n : ℕ) : ℝ))) ≤
      8 ^ n * C * 2 ^ (w * n) := by
  have hR := half_le_anisoRadius (α := α) hβ a hb
  have hR0 : 0 < anisoRadius α β (a, b) := by linarith
  rw [anisoRadius_div hα hβ ht, div_rpow_neg_natCast hR0 ht]
  have hRn : (1 / 2 : ℝ) ^ (w * n) ≤ anisoRadius α β (a, b) ^ (w * n) :=
    pow_le_pow_left₀ (by norm_num) hR _
  have hRn0 : 0 < anisoRadius α β (a, b) ^ (w * n) := pow_pos hR0 _
  have e : (8 / t ^ w) ^ n * (C * (t ^ (w * n) / anisoRadius α β (a, b) ^ (w * n))) =
      8 ^ n * C / anisoRadius α β (a, b) ^ (w * n) := by
    rw [div_pow, ← pow_mul]
    field_simp
  rw [e, div_le_iff₀ hRn0]
  calc 8 ^ n * C = 8 ^ n * C * 2 ^ (w * n) * (1 / 2) ^ (w * n) := by
        rw [mul_assoc (8 ^ n * C), ← mul_pow]; norm_num
    _ ≤ 8 ^ n * C * 2 ^ (w * n) * anisoRadius α β (a, b) ^ (w * n) := by gcongr

/-- The norm of a derivative along `s • e`. -/
theorem norm_iteratedFDeriv_smul_dir (μ : ℝ × ℝ → ℂ) (n : ℕ) (p e : ℝ × ℝ) (s : ℝ) :
    ‖iteratedFDeriv ℝ n μ p (fun _ => s • e)‖ =
      |s| ^ n * ‖iteratedFDeriv ℝ n μ p (fun _ => e)‖ := by
  rw [ContinuousMultilinearMap.map_smul_univ (iteratedFDeriv ℝ n μ p) (fun _ => s) (fun _ => e),
    norm_smul]
  simp

/-- The pure `x`-derivatives of the `μ`-factor of `m^{(t)}`. -/
theorem norm_iteratedDeriv_mu_x {α β N : ℕ} (hα : 0 < α) (hβ : 0 < β) {C : ℝ}
    {μ : ℝ × ℝ → ℂ} (hμ : PureBounds α β N C μ) {t : ℝ} (ht : 0 < t) {y : ℝ}
    (hy : 1 / 2 ≤ |8 * y|) (x : ℝ) {i : ℕ} (hi : i ≤ N) :
    ‖iteratedDeriv i (fun x => μ (8 * x / t ^ α, 8 * y / t ^ β)) x‖ ≤
      8 ^ i * C * 2 ^ (α * i) := by
  have hC : 0 ≤ C := hμ.nonneg
  have hne : ∀ x' : ℝ, ((0 : ℝ), 8 * y / t ^ β) + x' • ((8 / t ^ α : ℝ), (0 : ℝ)) ≠ 0 := by
    intro x' h
    have h2 := congrArg Prod.snd h
    simp only [Prod.snd_add, Prod.smul_snd, smul_zero, add_zero, Prod.snd_zero] at h2
    rcases div_eq_zero_iff.1 h2 with h | h
    · rw [h] at hy; norm_num at hy
    · exact pow_ne_zero _ ht.ne' h
  have e : (fun x => μ (8 * x / t ^ α, 8 * y / t ^ β)) =
      fun x => μ (((0 : ℝ), 8 * y / t ^ β) + x • ((8 / t ^ α : ℝ), (0 : ℝ))) := by
    funext x'; congr 1; ext <;> simp; ring
  rw [e, iteratedDeriv_line isOpen_compl_singleton hμ.1 _ _ (hne x) hi]
  have e2 : ((8 / t ^ α : ℝ), (0 : ℝ)) = (8 / t ^ α) • ((1 : ℝ), (0 : ℝ)) := by
    ext <;> simp
  rw [e2, norm_iteratedFDeriv_smul_dir, abs_of_pos (by positivity)]
  have hp : ((0 : ℝ), 8 * y / t ^ β) + x • (8 / t ^ α) • ((1 : ℝ), (0 : ℝ)) =
      (8 * x / t ^ α, 8 * y / t ^ β) := by ext <;> simp; ring
  rw [hp]
  calc (8 / t ^ α) ^ i * ‖iteratedFDeriv ℝ i μ (8 * x / t ^ α, 8 * y / t ^ β)
        (fun _ => ((1 : ℝ), (0 : ℝ)))‖
      ≤ (8 / t ^ α) ^ i * (C * anisoRadius α β (8 * x / t ^ α, 8 * y / t ^ β) ^
          (-((α * i : ℕ) : ℝ))) := by
        gcongr
        exact hμ.2.2.1 i hi _ (by rw [← hp, ← e2]; exact hne x)
    _ ≤ 8 ^ i * C * 2 ^ (α * i) := scaled_bound hα hβ hC ht _ hy α i

theorem pt_ne_zero {α β : ℕ} {t : ℝ} (ht : 0 < t) (x : ℝ) {y : ℝ} (hy : y ≠ 0) :
    ((8 * x / t ^ α, 8 * y / t ^ β) : ℝ × ℝ) ≠ 0 := by
  intro h
  have h2 := congrArg Prod.snd h
  simp only [Prod.snd_zero] at h2
  rcases div_eq_zero_iff.1 h2 with h | h
  · exact hy (by linarith)
  · exact pow_ne_zero _ ht.ne' h

/-- The pure `y`-derivatives of the `μ`-factor of `m^{(t)}`. -/
theorem norm_iteratedDeriv_mu_y {α β N : ℕ} (hα : 0 < α) (hβ : 0 < β) {C : ℝ}
    {μ : ℝ × ℝ → ℂ} (hμ : PureBounds α β N C μ) {t : ℝ} (ht : 0 < t) (x : ℝ) {y : ℝ}
    (hy : 1 / 2 ≤ |8 * y|) {i : ℕ} (hi : i ≤ N) :
    ‖iteratedDeriv i (fun y => μ (8 * x / t ^ α, 8 * y / t ^ β)) y‖ ≤
      8 ^ i * C * 2 ^ (β * i) := by
  have hC : 0 ≤ C := hμ.nonneg
  have hy0 : y ≠ 0 := by rintro rfl; norm_num at hy
  have e : (fun y => μ (8 * x / t ^ α, 8 * y / t ^ β)) =
      fun y => μ ((8 * x / t ^ α, (0 : ℝ)) + y • ((0 : ℝ), (8 / t ^ β : ℝ))) := by
    funext y'; congr 1; ext <;> simp; ring
  have hp : (8 * x / t ^ α, (0 : ℝ)) + y • ((0 : ℝ), (8 / t ^ β : ℝ)) =
      (8 * x / t ^ α, 8 * y / t ^ β) := by ext <;> simp; ring
  have hmem : (8 * x / t ^ α, (0 : ℝ)) + y • ((0 : ℝ), (8 / t ^ β : ℝ)) ∈ ({0}ᶜ : Set (ℝ × ℝ)) := by
    rw [hp]; exact pt_ne_zero ht x hy0
  rw [e, iteratedDeriv_line isOpen_compl_singleton hμ.1 _ _ hmem hi, hp]
  have e2 : ((0 : ℝ), (8 / t ^ β : ℝ)) = (8 / t ^ β) • ((0 : ℝ), (1 : ℝ)) := by
    ext <;> simp
  rw [e2, norm_iteratedFDeriv_smul_dir, abs_of_pos (by positivity)]
  calc (8 / t ^ β) ^ i * ‖iteratedFDeriv ℝ i μ (8 * x / t ^ α, 8 * y / t ^ β)
        (fun _ => ((0 : ℝ), (1 : ℝ)))‖
      ≤ (8 / t ^ β) ^ i * (C * anisoRadius α β (8 * x / t ^ α, 8 * y / t ^ β) ^
          (-((β * i : ℕ) : ℝ))) := by
        gcongr
        exact hμ.2.2.2 i hi _ (pt_ne_zero ht x hy0)
    _ ≤ 8 ^ i * C * 2 ^ (β * i) := scaled_bound hα hβ hC ht _ hy β i

/-! ### Uniform bounds for the derivatives of `m^{(t)}` -/

/-- Bounds for the derivatives of `φ̃ g^{-1}`. -/
def bk (j : ℕ) : ℝ :=
  Classical.choose (exists_bound_iteratedDeriv kap_contDiff kap_hasCompactSupport j)

/-- Bounds for the derivatives of `ψ̃`. -/
def bl (j : ℕ) : ℝ :=
  Classical.choose (exists_bound_iteratedDeriv lam_contDiff lam_hasCompactSupport j)

theorem bk_nonneg (j : ℕ) : 0 ≤ bk j :=
  (Classical.choose_spec (exists_bound_iteratedDeriv kap_contDiff kap_hasCompactSupport j)).1

theorem bl_nonneg (j : ℕ) : 0 ≤ bl j :=
  (Classical.choose_spec (exists_bound_iteratedDeriv lam_contDiff lam_hasCompactSupport j)).1

theorem norm_iteratedDeriv_kap_le (j : ℕ) (x : ℝ) : ‖iteratedDeriv j kap x‖ ≤ bk j :=
  (Classical.choose_spec (exists_bound_iteratedDeriv kap_contDiff kap_hasCompactSupport j)).2 x

theorem norm_iteratedDeriv_lam_le (j : ℕ) (x : ℝ) : ‖iteratedDeriv j lam x‖ ≤ bl j :=
  (Classical.choose_spec (exists_bound_iteratedDeriv lam_contDiff lam_hasCompactSupport j)).2 x

theorem norm_kap_le (x : ℝ) : ‖kap x‖ ≤ bk 0 := by
  simpa using norm_iteratedDeriv_kap_le 0 x

theorem norm_lam_le (x : ℝ) : ‖lam x‖ ≤ bl 0 := by
  simpa using norm_iteratedDeriv_lam_le 0 x

theorem norm_iteratedDeriv_kap_scale (j : ℕ) (x : ℝ) :
    ‖iteratedDeriv j (fun x => kap (8 * x)) x‖ ≤ 8 ^ j * bk j := by
  rw [iteratedDeriv_comp_const_smul (kap_contDiff.of_le (by exact_mod_cast le_top)) (8 : ℝ)]
  rw [norm_smul]
  simp only [norm_pow, Real.norm_ofNat]
  gcongr
  exact norm_iteratedDeriv_kap_le j _

theorem norm_iteratedDeriv_lam_scale (j : ℕ) (x : ℝ) :
    ‖iteratedDeriv j (fun x => lam (8 * x)) x‖ ≤ 8 ^ j * bl j := by
  rw [iteratedDeriv_comp_const_smul (lam_contDiff.of_le (by exact_mod_cast le_top)) (8 : ℝ)]
  rw [norm_smul]
  simp only [norm_pow, Real.norm_ofNat]
  gcongr
  exact norm_iteratedDeriv_lam_le j _

/-- The uniform bound for `∂_x^M m^{(t)}`. -/
def SX (α : ℕ) (C : ℝ) (M : ℕ) : ℝ :=
  ∑ i ∈ Finset.range (M + 1), (M.choose i : ℝ) * (8 ^ i * C * 2 ^ (α * i)) *
    (8 ^ (M - i) * bk (M - i) * bl 0)

/-- The uniform bound for `∂_y^M m^{(t)}`. -/
def SY (β : ℕ) (C : ℝ) (M : ℕ) : ℝ :=
  ∑ i ∈ Finset.range (M + 1), (M.choose i : ℝ) * (8 ^ i * C * 2 ^ (β * i)) *
    (bk 0 * (8 ^ (M - i) * bl (M - i)))

theorem SX_nonneg (α : ℕ) {C : ℝ} (hC : 0 ≤ C) (M : ℕ) : 0 ≤ SX α C M :=
  Finset.sum_nonneg fun i _ => by
    have := bk_nonneg (M - i); have := bl_nonneg 0; positivity

theorem SY_nonneg (β : ℕ) {C : ℝ} (hC : 0 ≤ C) (M : ℕ) : 0 ≤ SY β C M :=
  Finset.sum_nonneg fun i _ => by
    have := bk_nonneg 0; have := bl_nonneg (M - i); positivity

theorem contDiff_mu_x {α β N : ℕ} {C : ℝ} {μ : ℝ × ℝ → ℂ} (hμ : PureBounds α β N C μ) {t : ℝ}
    (ht : 0 < t) {y : ℝ} (hy : y ≠ 0) :
    ContDiff ℝ N (fun x => μ (8 * x / t ^ α, 8 * y / t ^ β)) := by
  have h : ContDiff ℝ N (fun x : ℝ => ((8 * x / t ^ α, 8 * y / t ^ β) : ℝ × ℝ)) := by
    fun_prop
  exact hμ.1.comp_contDiff h (fun x => pt_ne_zero ht x hy)

theorem contDiffOn_mu_y {α β N : ℕ} {C : ℝ} {μ : ℝ × ℝ → ℂ} (hμ : PureBounds α β N C μ) {t : ℝ}
    (ht : 0 < t) (x : ℝ) :
    ContDiffOn ℝ N (fun y => μ (8 * x / t ^ α, 8 * y / t ^ β)) {0}ᶜ := by
  have h : ContDiff ℝ N (fun y : ℝ => ((8 * x / t ^ α, 8 * y / t ^ β) : ℝ × ℝ)) := by
    fun_prop
  exact hμ.1.comp h.contDiffOn (fun y hy => pt_ne_zero ht x hy)

theorem locSym_x_eq_zero_of_lam {α β : ℕ} {μ : ℝ × ℝ → ℂ} {t y : ℝ} (hy : lam (8 * y) = 0) :
    (fun x => locSym α β μ t (x, y)) = fun _ => 0 := by
  funext x; simp [locSym, hy]

theorem half_le_of_lam_ne_zero {y : ℝ} (hy : lam (8 * y) ≠ 0) : 1 / 2 ≤ |8 * y| := by
  by_contra h
  exact hy (lam_eq_zero_of_small (not_le.1 h).le)

theorem contDiff_locSym_x {α β N : ℕ} {C : ℝ} {μ : ℝ × ℝ → ℂ} (hμ : PureBounds α β N C μ)
    {t : ℝ} (ht : 0 < t) (y : ℝ) : ContDiff ℝ N (fun x => locSym α β μ t (x, y)) := by
  by_cases hy : lam (8 * y) = 0
  · rw [locSym_x_eq_zero_of_lam hy]; exact contDiff_const
  · have hy0 : y ≠ 0 := by
      intro h; have := half_le_of_lam_ne_zero hy; rw [h] at this; norm_num at this
    change ContDiff ℝ N (fun x => μ (8 * x / t ^ α, 8 * y / t ^ β) * (kap (8 * x) * lam (8 * y)))
    have hk : ContDiff ℝ N (fun x : ℝ => kap (8 * x)) :=
      (contDiff_infty.1 kap_contDiff _).comp (contDiff_const.mul contDiff_id)
    exact (contDiff_mu_x hμ ht hy0).mul (hk.mul contDiff_const)

theorem locSym_y_eventually_zero {α β : ℕ} {μ : ℝ × ℝ → ℂ} {t x y : ℝ} (hy : |8 * y| < 1 / 2) :
    (fun y => locSym α β μ t (x, y)) =ᶠ[𝓝 y] fun _ => 0 := by
  have hy' : |y| < 1 / 16 := by rw [abs_mul] at hy; norm_num at hy; linarith
  have : ∀ᶠ y' in 𝓝 y, |y'| < 1 / 16 :=
    (continuous_abs.tendsto y).eventually (gt_mem_nhds hy')
  filter_upwards [this] with y' hy'
  exact locSym_eq_zero_y_small (by simp only; linarith)

theorem contDiff_locSym_y {α β N : ℕ} {C : ℝ} {μ : ℝ × ℝ → ℂ} (hμ : PureBounds α β N C μ)
    {t : ℝ} (ht : 0 < t) (x : ℝ) : ContDiff ℝ N (fun y => locSym α β μ t (x, y)) := by
  rw [contDiff_iff_contDiffAt]
  intro y
  by_cases hy : y = 0
  · subst hy
    exact (contDiffAt_const (c := (0 : ℂ))).congr_of_eventuallyEq
      (locSym_y_eventually_zero (by norm_num))
  · have h1 := (contDiffOn_mu_y hμ ht x).contDiffAt (isOpen_compl_singleton.mem_nhds hy)
    have hl : ContDiff ℝ N (fun y : ℝ => lam (8 * y)) :=
      (contDiff_infty.1 lam_contDiff _).comp (contDiff_const.mul contDiff_id)
    change ContDiffAt ℝ N
      (fun y => μ (8 * x / t ^ α, 8 * y / t ^ β) * (kap (8 * x) * lam (8 * y))) y
    exact h1.mul (contDiffAt_const.mul hl.contDiffAt)

theorem norm_iteratedDeriv_locSym_x {α β N : ℕ} (hα : 0 < α) (hβ : 0 < β) {C : ℝ}
    {μ : ℝ × ℝ → ℂ} (hμ : PureBounds α β N C μ) {t : ℝ} (ht : 0 < t) {M : ℕ} (hM : M ≤ N)
    (x y : ℝ) : ‖iteratedDeriv M (fun x => locSym α β μ t (x, y)) x‖ ≤ SX α C M := by
  have hC := hμ.nonneg
  by_cases hy : lam (8 * y) = 0
  · rw [locSym_x_eq_zero_of_lam hy, iteratedDeriv_const]
    split_ifs <;> simp [SX_nonneg α hC M]
  · have hy8 := half_le_of_lam_ne_zero hy
    have hy0 : y ≠ 0 := by intro h; rw [h] at hy8; norm_num at hy8
    have hf : ContDiff ℝ M _ := (contDiff_mu_x hμ ht hy0).of_le (by exact_mod_cast hM)
    have hg : ContDiff ℝ M (fun x => kap (8 * x) * lam (8 * y)) :=
      ((contDiff_infty.1 kap_contDiff _).comp (contDiff_const.mul contDiff_id)).mul
        contDiff_const
    have h := norm_iteratedDeriv_mul_le_of_isOpen isOpen_univ hf.contDiffOn hg.contDiffOn
      (mem_univ x) le_rfl
    refine h.trans (Finset.sum_le_sum fun i hi => ?_)
    have hi' : i ≤ M := Nat.lt_succ_iff.1 (Finset.mem_range.1 hi)
    have b1 := norm_iteratedDeriv_mu_x hα hβ hμ ht hy8 x (hi'.trans hM)
    have b2 : ‖iteratedDeriv (M - i) (fun x => kap (8 * x) * lam (8 * y)) x‖ ≤
        8 ^ (M - i) * bk (M - i) * bl 0 := by
      rw [iteratedDeriv_mul_const_field, norm_mul]
      exact mul_le_mul (norm_iteratedDeriv_kap_scale _ _) (norm_lam_le _) (norm_nonneg _)
        (by have := bk_nonneg (M - i); positivity)
    gcongr

theorem norm_iteratedDeriv_locSym_y {α β N : ℕ} (hα : 0 < α) (hβ : 0 < β) {C : ℝ}
    {μ : ℝ × ℝ → ℂ} (hμ : PureBounds α β N C μ) {t : ℝ} (ht : 0 < t) {M : ℕ} (hM : M ≤ N)
    (x y : ℝ) : ‖iteratedDeriv M (fun y => locSym α β μ t (x, y)) y‖ ≤ SY β C M := by
  have hC := hμ.nonneg
  by_cases hy : |8 * y| < 1 / 2
  · rw [(locSym_y_eventually_zero hy).iteratedDeriv_eq, iteratedDeriv_const]
    split_ifs <;> simp [SY_nonneg β hC M]
  · have hy8 : 1 / 2 ≤ |8 * y| := not_lt.1 hy
    have hy0 : y ≠ 0 := by intro h; rw [h] at hy8; norm_num at hy8
    have hf : ContDiffOn ℝ M _ _ := (contDiffOn_mu_y hμ ht x).of_le (by exact_mod_cast hM)
    have hg : ContDiff ℝ M (fun y => kap (8 * x) * lam (8 * y)) :=
      contDiff_const.mul
        ((contDiff_infty.1 lam_contDiff _).comp (contDiff_const.mul contDiff_id))
    have h := norm_iteratedDeriv_mul_le_of_isOpen isOpen_compl_singleton hf hg.contDiffOn
      (show y ∈ ({0}ᶜ : Set ℝ) from hy0) le_rfl
    refine h.trans (Finset.sum_le_sum fun i hi => ?_)
    have hi' : i ≤ M := Nat.lt_succ_iff.1 (Finset.mem_range.1 hi)
    have b1 := norm_iteratedDeriv_mu_y hα hβ hμ ht x hy8 (hi'.trans hM)
    have b2 : ‖iteratedDeriv (M - i) (fun y => kap (8 * x) * lam (8 * y)) y‖ ≤
        bk 0 * (8 ^ (M - i) * bl (M - i)) := by
      rw [iteratedDeriv_const_mul_field, norm_mul]
      exact mul_le_mul (norm_kap_le _) (norm_iteratedDeriv_lam_scale _ _) (norm_nonneg _)
        (bk_nonneg 0)
    gcongr

theorem norm_locSym_le {α β N : ℕ} {C : ℝ} {μ : ℝ × ℝ → ℂ} (hμ : PureBounds α β N C μ) {t : ℝ}
    (ht : 0 < t) (q : ℝ × ℝ) : ‖locSym α β μ t q‖ ≤ C * (bk 0 * bl 0) := by
  have hC := hμ.nonneg
  by_cases hy : lam (8 * q.2) = 0
  · simp only [locSym, hy, mul_zero, norm_zero]
    have := bk_nonneg 0; have := bl_nonneg 0; positivity
  · have hy8 := half_le_of_lam_ne_zero hy
    have hy0 : q.2 ≠ 0 := by intro h; rw [h] at hy8; norm_num at hy8
    rw [locSym, norm_mul, norm_mul]
    exact mul_le_mul (hμ.norm_le (pt_ne_zero ht q.1 hy0))
      (mul_le_mul (norm_kap_le _) (norm_lam_le _) (norm_nonneg _) (bk_nonneg 0))
      (by positivity) hC

theorem continuous_locSym {α β N : ℕ} {C : ℝ} {μ : ℝ × ℝ → ℂ} (hμ : PureBounds α β N C μ)
    {t : ℝ} (ht : 0 < t) : Continuous (locSym α β μ t) := by
  rw [continuous_iff_continuousAt]
  intro q
  by_cases hq : q.2 = 0
  · have hz : locSym α β μ t =ᶠ[𝓝 q] fun _ => 0 := by
      have : ∀ᶠ q' in 𝓝 q, |q'.2| < 1 / 16 :=
        ((continuous_abs.comp continuous_snd).tendsto q).eventually
          (gt_mem_nhds (by simp [hq]))
      filter_upwards [this] with q' hq'
      exact locSym_eq_zero_y_small hq'.le
    exact continuousAt_const.congr hz.symm
  · have hpt : Continuous fun q : ℝ × ℝ => ((8 * q.1 / t ^ α, 8 * q.2 / t ^ β) : ℝ × ℝ) := by
      fun_prop
    have h1 : ContinuousAt (μ ∘ fun q : ℝ × ℝ => ((8 * q.1 / t ^ α, 8 * q.2 / t ^ β) : ℝ × ℝ))
        q :=
      ContinuousAt.comp ((hμ.1.continuousOn).continuousAt
        (isOpen_compl_singleton.mem_nhds (pt_ne_zero ht q.1 hq))) hpt.continuousAt
    have h2 : Continuous fun q : ℝ × ℝ => kap (8 * q.1) * lam (8 * q.2) :=
      (kap_contDiff.continuous.comp (continuous_const.mul continuous_fst)).mul
        (lam_contDiff.continuous.comp (continuous_const.mul continuous_snd))
    exact h1.mul h2.continuousAt

theorem measurable_locSym {α β N : ℕ} {C : ℝ} {μ : ℝ × ℝ → ℂ} (hμ : PureBounds α β N C μ) :
    Measurable fun w : ℝ × (ℝ × ℝ) => locSym α β μ w.1 w.2 := by
  unfold locSym
  have hk := kap_contDiff.continuous.measurable
  have hl := lam_contDiff.continuous.measurable
  have hm := hμ.2.1
  fun_prop

end Cone


namespace Cone

/-! ### Double Fourier series on the unit torus -/

/-- Lift of a function on `[-1/2, 1/2)` to the unit circle. -/
def cLift (f : ℝ → ℂ) : UnitAddCircle → ℂ := AddCircle.liftIco 1 (-(1 / 2)) f

theorem coe_half_eq : ((1 / 2 : ℝ) : UnitAddCircle) = ((-(1 / 2) : ℝ) : UnitAddCircle) := by
  have h : ((-(1 / 2 : ℝ) + 1 : ℝ) : UnitAddCircle) = ((-(1 / 2) : ℝ) : UnitAddCircle) :=
    AddCircle.coe_add_period 1 _
  rw [← h]
  congr 1
  norm_num

theorem cLift_coe {f : ℝ → ℂ} (hb : f (-(1 / 2)) = f (1 / 2)) {r : ℝ}
    (hr : r ∈ Icc (-(1 / 2) : ℝ) (1 / 2)) : cLift f r = f r := by
  rcases eq_or_lt_of_le hr.2 with h | h
  · subst h
    rw [coe_half_eq, cLift, AddCircle.liftIco_coe_apply (by norm_num), hb]
  · rw [cLift, AddCircle.liftIco_coe_apply ⟨hr.1, by norm_num; linarith⟩]

theorem cLift_zero : cLift (fun _ => 0) = fun _ => 0 := by
  funext q; simp [cLift, AddCircle.liftIco]

theorem continuous_cLift_param {X : Type*} [TopologicalSpace X] [LocallyCompactSpace X]
    (f : ℝ → X → ℂ) (hb : ∀ x, f (-(1 / 2)) x = f (1 / 2) x)
    (hc : Continuous (fun p : ℝ × X => f p.1 p.2)) :
    Continuous (fun p : UnitAddCircle × X => cLift (fun r => f r p.2) p.1) := by
  let F : C(ℝ × X, ℂ) := ⟨fun p => f p.1 p.2, hc⟩
  let G : C(ℝ, C(X, ℂ)) := ContinuousMap.curry F
  have hG : G (-(1 / 2)) = G (-(1 / 2) + 1) := by
    ext x
    have : (-(1 / 2) + 1 : ℝ) = 1 / 2 := by norm_num
    simp only [G, F, ContinuousMap.curry_apply, ContinuousMap.coe_mk, this]
    exact hb x
  let H : C(UnitAddCircle, C(X, ℂ)) :=
    ⟨AddCircle.liftIco 1 (-(1 / 2)) G, AddCircle.liftIco_continuous hG G.continuous.continuousOn⟩
  have hunc : Continuous (fun p : UnitAddCircle × X => H p.1 p.2) :=
    ContinuousMap.continuous_uncurry_of_continuous H
  refine hunc.congr ?_
  intro p
  rfl

/-- The periodic extension to the unit torus of a function on `[-1/2,1/2]^2`. -/
def tLift (G : ℝ × ℝ → ℂ) (x : UnitAddTorus (Fin 2)) : ℂ :=
  cLift (fun r => cLift (fun s => G (r, s)) (x 1)) (x 0)

/-- Vanishing on the boundary of `[-1/2,1/2]^2`. -/
def BoxZero (G : ℝ × ℝ → ℂ) : Prop :=
  ∀ q : ℝ × ℝ, G q ≠ 0 → |q.1| < 1 / 2 ∧ |q.2| < 1 / 2

theorem BoxZero.eq_zero {G : ℝ × ℝ → ℂ} (h : BoxZero G) {q : ℝ × ℝ}
    (hq : 1 / 2 ≤ |q.1| ∨ 1 / 2 ≤ |q.2|) : G q = 0 := by
  by_contra h0
  have := h q h0
  rcases hq with hq | hq <;> linarith [this.1, this.2]

theorem continuous_tLift {G : ℝ × ℝ → ℂ} (hG : Continuous G) (hz : BoxZero G) :
    Continuous (tLift G) := by
  have hb2 : ∀ r : ℝ, G (r, -(1 / 2)) = G (r, 1 / 2) := fun r => by
    rw [hz.eq_zero (Or.inr (by norm_num)), hz.eq_zero (Or.inr (by norm_num))]
  have h1 := continuous_cLift_param (fun s r => G (r, s)) hb2
    (hG.comp (continuous_snd.prodMk continuous_fst))
  have hb1 : ∀ q : UnitAddCircle, cLift (fun s => G (-(1 / 2), s)) q =
      cLift (fun s => G (1 / 2, s)) q := fun q => by
    have e1 : (fun s => G (-(1 / 2), s)) = fun _ => 0 :=
      funext fun s => hz.eq_zero (Or.inl (by norm_num))
    have e2 : (fun s => G (1 / 2, s)) = fun _ => 0 :=
      funext fun s => hz.eq_zero (Or.inl (by norm_num))
    rw [e1, e2]
  have h2 := continuous_cLift_param (fun r q => cLift (fun s => G (r, s)) q) hb1
    (h1.comp (continuous_snd.prodMk continuous_fst))
  have h3 : Continuous fun x : UnitAddTorus (Fin 2) => (x 0, x 1) :=
    (continuous_apply 0).prodMk (continuous_apply 1)
  exact h2.comp h3

theorem tLift_coe {G : ℝ × ℝ → ℂ} (hz : BoxZero G) {x y : ℝ} (hx : x ∈ Icc (-(1 / 2) : ℝ) (1 / 2))
    (hy : y ∈ Icc (-(1 / 2) : ℝ) (1 / 2)) :
    tLift G (fun i => (((![x, y] : Fin 2 → ℝ) i : ℝ) : UnitAddCircle)) = G (x, y) := by
  unfold tLift
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
  have hin : ∀ r : ℝ, cLift (fun s => G (r, s)) y = G (r, y) := fun r => cLift_coe (by
    rw [hz.eq_zero (Or.inr (by norm_num)), hz.eq_zero (Or.inr (by norm_num))]) hy
  simp only [hin]
  exact cLift_coe (by
    rw [hz.eq_zero (Or.inl (by norm_num)), hz.eq_zero (Or.inl (by norm_num))]) hx

theorem fourier_coe_eq (k : ℤ) (x : ℝ) :
    (fourier k (x : UnitAddCircle) : ℂ) = (Real.fourierChar (x * k) : ℂ) := by
  rw [fourier_coe_apply, Real.fourierChar_apply]
  congr 1
  push_cast
  ring

theorem mFourier_two (n : Fin 2 → ℤ) (v : Fin 2 → ℝ) :
    UnitAddTorus.mFourier n (fun i => ((v i : ℝ) : UnitAddCircle)) =
      (Real.fourierChar (v 0 * n 0) : ℂ) * (Real.fourierChar (v 1 * n 1) : ℂ) := by
  simp only [UnitAddTorus.mFourier, ContinuousMap.coe_mk, Fin.prod_univ_two, fourier_coe_eq]

/-- The Fourier coefficients of the periodic extension are integrals over the plane. -/
theorem mFourierCoeff_tLift {G : ℝ × ℝ → ℂ} (hz : BoxZero G) (n : Fin 2 → ℤ) :
    UnitAddTorus.mFourierCoeff (tLift G) n =
      ∫ q : ℝ × ℝ, (Real.fourierChar (-(q.1 * n 0)) : ℂ) *
        ((Real.fourierChar (-(q.2 * n 1)) : ℂ) * G q) := by
  rw [UnitAddTorus.mFourierCoeff_eq_integral (tLift G) n (fun _ => -(1 / 2))]
  let Φ : ℝ × ℝ → ℂ := fun q => (Real.fourierChar (-(q.1 * n 0)) : ℂ) *
    ((Real.fourierChar (-(q.2 * n 1)) : ℂ) * G q)
  have hset : MeasurableSet {x : Fin 2 → ℝ | ∀ i, x i ∈ Ioc (-(1 / 2) : ℝ) (-(1 / 2) + 1)} := by
    simp only [setOf_forall]
    exact MeasurableSet.iInter fun i => measurableSet_Ioc.preimage (measurable_pi_apply i)
  have hon : ∀ x ∈ {x : Fin 2 → ℝ | ∀ i, x i ∈ Ioc (-(1 / 2) : ℝ) (-(1 / 2) + 1)},
      UnitAddTorus.mFourier (-n) (fun i => ((x i : ℝ) : UnitAddCircle)) •
        tLift G (fun i => ((x i : ℝ) : UnitAddCircle)) = Φ (x 0, x 1) := by
    intro x hx
    have h0 := hx 0
    have h1 := hx 1
    norm_num at h0 h1
    have ex : (fun i => ((x i : ℝ) : UnitAddCircle)) =
        fun i => (((![x 0, x 1] : Fin 2 → ℝ) i : ℝ) : UnitAddCircle) := by
      funext i; fin_cases i <;> rfl
    rw [ex, tLift_coe hz ⟨by linarith [h0.1], h0.2⟩ ⟨by linarith [h1.1], h1.2⟩, smul_eq_mul,
      mFourier_two]
    simp only [Φ, Matrix.cons_val_zero, Matrix.cons_val_one, Pi.neg_apply, Int.cast_neg, mul_neg]
    ring
  rw [setIntegral_congr_fun hset hon]
  rw [setIntegral_eq_integral_of_forall_compl_eq_zero]
  · exact (volume_preserving_finTwoArrow ℝ).integral_comp' Φ
  · intro x hx
    simp only [mem_setOf_eq, not_forall] at hx
    obtain ⟨i, hi⟩ := hx
    simp only [Φ]
    have : G (x 0, x 1) = 0 := by
      by_contra h0
      have := hz _ h0
      apply hi
      fin_cases i
      · simp only [Fin.zero_eta]
        constructor <;> [linarith [(abs_lt.1 this.1).1]; linarith [(abs_lt.1 this.1).2]]
      · simp only [Fin.mk_one]
        constructor <;> [linarith [(abs_lt.1 this.2).1]; linarith [(abs_lt.1 this.2).2]]
    rw [this, mul_zero, mul_zero]

/-! ### Decay of the Fourier coefficients -/

theorem norm_fourier_le_integral_norm (f : ℝ → ℂ) (w : ℝ) : ‖𝓕 f w‖ ≤ ∫ v, ‖f v‖ := by
  rw [Real.fourier_real_eq]
  refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
  congr 1; funext v
  rw [Circle.smul_def, norm_smul, Circle.norm_coe, one_mul]

theorem integral_le_of_box {f : ℝ → ℝ} (hf0 : ∀ y, 0 ≤ f y) {S : ℝ}
    (hf : ∀ y, f y ≤ (Icc (-(1 / 2) : ℝ) (1 / 2)).indicator (fun _ => S) y) : ∫ y, f y ≤ S := by
  have hS : 0 ≤ S := by have := hf 0; simp at this; linarith [hf0 0]
  have hint : Integrable ((Icc (-(1 / 2) : ℝ) (1 / 2)).indicator (fun _ => S)) :=
    (integrable_indicator_iff measurableSet_Icc).2 (integrableOn_const (by simp))
  calc ∫ y, f y ≤ ∫ y, (Icc (-(1 / 2) : ℝ) (1 / 2)).indicator (fun _ => S) y :=
        integral_mono_of_nonneg (Eventually.of_forall hf0) hint (Eventually.of_forall hf)
    _ = S := by
        rw [integral_indicator_const _ measurableSet_Icc]
        norm_num

theorem iteratedDeriv_eq_zero_of_far {f : ℝ → ℂ} (hz : ∀ y, 1 / 2 ≤ |y| → f y = 0) (j : ℕ)
    {y : ℝ} (hy : 1 / 2 < |y|) : iteratedDeriv j f y = 0 := by
  have : f =ᶠ[𝓝 y] fun _ => 0 := by
    have h : ∀ᶠ y' in 𝓝 y, 1 / 2 < |y'| := (continuous_abs.tendsto y).eventually (lt_mem_nhds hy)
    filter_upwards [h] with y' hy'
    exact hz y' hy'.le
  rw [this.iteratedDeriv_eq, iteratedDeriv_const]
  split_ifs <;> rfl

/-- `|𝓕 f(w)| (2π|w|)^M ≤ sup |f^{(M)}|` for `f` supported in `[-1/2,1/2]`. -/
theorem norm_fourier_mul_le {f : ℝ → ℂ} {M : ℕ} (hf : ContDiff ℝ M f)
    (hz : ∀ y, 1 / 2 ≤ |y| → f y = 0) {S : ℝ} (hS : ∀ y, ‖iteratedDeriv M f y‖ ≤ S) (w : ℝ) :
    ‖𝓕 f w‖ * (2 * π * |w|) ^ M ≤ S := by
  have hint : ∀ j : ℕ, (j : ℕ∞) ≤ M → Integrable (iteratedDeriv j f) := by
    intro j hj
    have hc : Continuous (iteratedDeriv j f) :=
      hf.continuous_iteratedDeriv j (by exact_mod_cast hj)
    refine hc.integrable_of_hasCompactSupport ?_
    apply HasCompactSupport.intro (isCompact_closedBall (0 : ℝ) 1)
    intro y hy
    simp only [Metric.mem_closedBall, Real.dist_eq, sub_zero, not_le] at hy
    exact iteratedDeriv_eq_zero_of_far hz j (by linarith)
  have hF := congrFun (Real.fourier_iteratedDeriv (N := (M : ℕ∞)) (by exact_mod_cast hf) hint
    le_rfl) w
  have h1 : ‖𝓕 (iteratedDeriv M f) w‖ ≤ S := by
    refine (norm_fourier_le_integral_norm _ w).trans (integral_le_of_box (fun _ => norm_nonneg _)
      fun y => ?_)
    by_cases hy : |y| ≤ 1 / 2
    · rw [indicator_of_mem (by rw [mem_Icc]; constructor <;> linarith [abs_le.1 hy])]
      exact hS y
    · rw [iteratedDeriv_eq_zero_of_far hz M (not_le.1 hy), norm_zero]
      rw [indicator_of_notMem (by rw [mem_Icc]; intro h; exact hy (abs_le.2 ⟨h.1, h.2⟩))]
  rw [hF, norm_smul] at h1
  have e : ‖(2 * (π : ℂ) * Complex.I * w) ^ M‖ = (2 * π * |w|) ^ M := by
    rw [norm_pow]
    congr 1
    simp [abs_of_pos Real.pi_pos]
  rw [e] at h1
  linarith [mul_comm ‖𝓕 f w‖ ((2 * π * |w|) ^ M)]

/-- The weight `((1 + |u|)(1 + |v|))^{-K}`. -/
def wt (K : ℕ) (u v : ℤ) : ℝ := 1 / ((1 + |(u : ℝ)|) * (1 + |(v : ℝ)|)) ^ K

theorem wt_pos (K : ℕ) (u v : ℤ) : 0 < wt K u v := by unfold wt; positivity

theorem le_wt {X S : ℝ} (K : ℕ) (u v : ℤ) (hX0 : 0 ≤ X) (h0 : X ≤ S)
    (hu : X * (2 * π * |(u : ℝ)|) ^ (2 * K) ≤ S) (hv : X * (2 * π * |(v : ℝ)|) ^ (2 * K) ≤ S) :
    X ≤ 4 ^ K * S * wt K u v := by
  have hS : 0 ≤ S := hX0.trans h0
  have hP : 0 < ((1 + |(u : ℝ)|) * (1 + |(v : ℝ)|)) ^ K := by positivity
  unfold wt
  rw [mul_one_div, le_div_iff₀ hP]
  have key : ∀ a b : ℤ, |(b : ℝ)| ≤ |(a : ℝ)| → a ≠ 0 →
      X * (2 * π * |(a : ℝ)|) ^ (2 * K) ≤ S →
      X * ((1 + |(a : ℝ)|) * (1 + |(b : ℝ)|)) ^ K ≤ 4 ^ K * S := by
    intro a b hab ha h
    have ha1 : 1 ≤ |(a : ℝ)| := by
      have : (1 : ℝ) ≤ |(a : ℝ)| := by exact_mod_cast Int.one_le_abs ha
      exact this
    have hP1 : (1 + |(a : ℝ)|) * (1 + |(b : ℝ)|) ≤ 4 * |(a : ℝ)| ^ 2 := by
      nlinarith [abs_nonneg (b : ℝ)]
    have hpi : |(a : ℝ)| ≤ 2 * π * |(a : ℝ)| := by
      nlinarith [Real.pi_gt_three, abs_nonneg (a : ℝ)]
    calc X * ((1 + |(a : ℝ)|) * (1 + |(b : ℝ)|)) ^ K ≤ X * (4 * |(a : ℝ)| ^ 2) ^ K := by
          gcongr
      _ = 4 ^ K * (X * |(a : ℝ)| ^ (2 * K)) := by rw [mul_pow, ← pow_mul]; ring
      _ ≤ 4 ^ K * (X * (2 * π * |(a : ℝ)|) ^ (2 * K)) := by gcongr
      _ ≤ 4 ^ K * S := by gcongr
  by_cases hu0 : u = 0
  · by_cases hv0 : v = 0
    · subst hu0; subst hv0
      simp only [Int.cast_zero, abs_zero, add_zero, mul_one, one_pow]
      calc X ≤ S := h0
        _ ≤ 4 ^ K * S := le_mul_of_one_le_left hS (one_le_pow₀ (by norm_num))
    · have := key v u (by rw [hu0]; simp) hv0 hv
      rw [mul_comm (1 + |(u : ℝ)|)]; exact this
  · rcases le_total |(v : ℝ)| |(u : ℝ)| with h | h
    · exact key u v h hu0 hu
    · by_cases hv0 : v = 0
      · exact key u v (by rw [hv0]; simp) hu0 hu
      · have := key v u h hv0 hv
        rw [mul_comm (1 + |(u : ℝ)|)]; exact this

theorem summable_wt {K : ℕ} (hK : 2 ≤ K) : Summable fun n : ℤ × ℤ => wt K n.1 n.2 := by
  have h1 : Summable fun u : ℤ => 1 / (1 + |(u : ℝ)|) ^ K := by
    refine Summable.of_nonneg_of_le (fun u => by positivity) (fun u => ?_)
      summable_one_div_one_add_abs_sq
    have h : 1 ≤ 1 + |(u : ℝ)| := by linarith [abs_nonneg (u : ℝ)]
    exact one_div_le_one_div_of_le (by positivity) (pow_le_pow_right₀ h hK)
  have := Summable.mul_of_nonneg h1 h1 (fun u => by positivity) (fun u => by positivity)
  refine this.congr fun n => ?_
  simp only [wt, mul_pow]
  ring

end Cone


namespace Cone

theorem BoxZero.hasCompactSupport {G : ℝ × ℝ → ℂ} (hz : BoxZero G) : HasCompactSupport G := by
  apply HasCompactSupport.intro (isCompact_Icc.prod isCompact_Icc :
    IsCompact (Icc (-(1 / 2) : ℝ) (1 / 2) ×ˢ Icc (-(1 / 2) : ℝ) (1 / 2)))
  intro q hq
  by_contra h0
  have := hz q h0
  exact hq ⟨⟨by linarith [(abs_lt.1 this.1).1], by linarith [(abs_lt.1 this.1).2]⟩,
    ⟨by linarith [(abs_lt.1 this.2).1], by linarith [(abs_lt.1 this.2).2]⟩⟩

/-- The integrand of a Fourier coefficient. -/
def phase (a b : ℝ) (G : ℝ × ℝ → ℂ) (q : ℝ × ℝ) : ℂ :=
  (Real.fourierChar (-(q.1 * a)) : ℂ) * ((Real.fourierChar (-(q.2 * b)) : ℂ) * G q)

theorem integrable_phase {G : ℝ × ℝ → ℂ} (hG : Continuous G) (hz : BoxZero G) (a b : ℝ) :
    Integrable (phase a b G) := by
  have hc : Continuous (phase a b G) := by
    unfold phase
    have h1 : Continuous fun q : ℝ × ℝ => (Real.fourierChar (-(q.1 * a)) : ℂ) :=
      continuous_subtype_val.comp (Real.continuous_fourierChar.comp (by fun_prop))
    have h2 : Continuous fun q : ℝ × ℝ => (Real.fourierChar (-(q.2 * b)) : ℂ) :=
      continuous_subtype_val.comp (Real.continuous_fourierChar.comp (by fun_prop))
    exact h1.mul (h2.mul hG)
  refine hc.integrable_of_hasCompactSupport ?_
  exact hz.hasCompactSupport.mul_left.mul_left

theorem fourier_zero_fun (w : ℝ) : 𝓕 (fun _ : ℝ => (0 : ℂ)) w = 0 := by
  rw [Real.fourier_real_eq]; simp

theorem coeff_decay_y {G : ℝ × ℝ → ℂ} (hG : Continuous G) (hz : BoxZero G) {M : ℕ}
    (hd : ∀ x, ContDiff ℝ M (fun y => G (x, y))) {S : ℝ}
    (hS : ∀ x y, ‖iteratedDeriv M (fun y => G (x, y)) y‖ ≤ S) (a b : ℝ) :
    ‖∫ q, phase a b G q‖ * (2 * π * |b|) ^ M ≤ S := by
  rw [Measure.volume_eq_prod, integral_prod _ (integrable_phase hG hz a b)]
  have e : ∀ x, ∫ y, phase a b G (x, y) =
      (Real.fourierChar (-(x * a)) : ℂ) * 𝓕 (fun y => G (x, y)) b := by
    intro x
    simp only [phase]
    rw [integral_const_mul, Real.fourier_real_eq]
    congr 1
  simp only [e]
  have hpt : ∀ x, ‖(Real.fourierChar (-(x * a)) : ℂ) * 𝓕 (fun y => G (x, y)) b‖ *
      (2 * π * |b|) ^ M ≤ (Icc (-(1 / 2) : ℝ) (1 / 2)).indicator (fun _ => S) x := by
    intro x
    rw [norm_mul, Circle.norm_coe, one_mul]
    by_cases hx : |x| ≤ 1 / 2
    · rw [indicator_of_mem (by rw [mem_Icc]; constructor <;> linarith [abs_le.1 hx])]
      exact norm_fourier_mul_le (hd x) (fun y hy => hz.eq_zero (Or.inr hy)) (hS x) b
    · rw [indicator_of_notMem (by rw [mem_Icc]; intro h; exact hx (abs_le.2 ⟨h.1, h.2⟩))]
      have : (fun y => G (x, y)) = fun _ => 0 :=
        funext fun y => hz.eq_zero (Or.inl (not_le.1 hx).le)
      rw [this, fourier_zero_fun]; simp
  calc ‖∫ x, (Real.fourierChar (-(x * a)) : ℂ) * 𝓕 (fun y => G (x, y)) b‖ * (2 * π * |b|) ^ M
      ≤ (∫ x, ‖(Real.fourierChar (-(x * a)) : ℂ) * 𝓕 (fun y => G (x, y)) b‖) *
          (2 * π * |b|) ^ M := by
        gcongr; exact norm_integral_le_integral_norm _
    _ = ∫ x, ‖(Real.fourierChar (-(x * a)) : ℂ) * 𝓕 (fun y => G (x, y)) b‖ *
          (2 * π * |b|) ^ M := (integral_mul_const _ _).symm
    _ ≤ S := integral_le_of_box (fun _ => by positivity) hpt

theorem coeff_decay_x {G : ℝ × ℝ → ℂ} (hG : Continuous G) (hz : BoxZero G) {M : ℕ}
    (hd : ∀ y, ContDiff ℝ M (fun x => G (x, y))) {S : ℝ}
    (hS : ∀ x y, ‖iteratedDeriv M (fun x => G (x, y)) x‖ ≤ S) (a b : ℝ) :
    ‖∫ q, phase a b G q‖ * (2 * π * |a|) ^ M ≤ S := by
  rw [Measure.volume_eq_prod, integral_prod_symm _ (integrable_phase hG hz a b)]
  have e : ∀ y, ∫ x, phase a b G (x, y) =
      (Real.fourierChar (-(y * b)) : ℂ) * 𝓕 (fun x => G (x, y)) a := by
    intro y
    simp only [phase]
    rw [Real.fourier_real_eq, ← integral_const_mul]
    congr 1; funext x
    rw [Circle.smul_def, smul_eq_mul]
    ring
  simp only [e]
  have hpt : ∀ y, ‖(Real.fourierChar (-(y * b)) : ℂ) * 𝓕 (fun x => G (x, y)) a‖ *
      (2 * π * |a|) ^ M ≤ (Icc (-(1 / 2) : ℝ) (1 / 2)).indicator (fun _ => S) y := by
    intro y
    rw [norm_mul, Circle.norm_coe, one_mul]
    by_cases hy : |y| ≤ 1 / 2
    · rw [indicator_of_mem (by rw [mem_Icc]; constructor <;> linarith [abs_le.1 hy])]
      exact norm_fourier_mul_le (hd y) (fun x hx => hz.eq_zero (Or.inl hx))
        (fun x => hS x y) a
    · rw [indicator_of_notMem (by rw [mem_Icc]; intro h; exact hy (abs_le.2 ⟨h.1, h.2⟩))]
      have : (fun x => G (x, y)) = fun _ => 0 :=
        funext fun x => hz.eq_zero (Or.inr (not_le.1 hy).le)
      rw [this, fourier_zero_fun]; simp
  calc ‖∫ y, (Real.fourierChar (-(y * b)) : ℂ) * 𝓕 (fun x => G (x, y)) a‖ * (2 * π * |a|) ^ M
      ≤ (∫ y, ‖(Real.fourierChar (-(y * b)) : ℂ) * 𝓕 (fun x => G (x, y)) a‖) *
          (2 * π * |a|) ^ M := by
        gcongr; exact norm_integral_le_integral_norm _
    _ = ∫ y, ‖(Real.fourierChar (-(y * b)) : ℂ) * 𝓕 (fun x => G (x, y)) a‖ *
          (2 * π * |a|) ^ M := (integral_mul_const _ _).symm
    _ ≤ S := integral_le_of_box (fun _ => by positivity) hpt

/-! ### The Fourier coefficients of `m^{(t)}` -/

/-- The Fourier coefficients `c_t(u, v)` of `m^{(t)}`. -/
def coef (α β : ℕ) (μ : ℝ × ℝ → ℂ) (t : ℝ) (n : ℤ × ℤ) : ℂ :=
  UnitAddTorus.mFourierCoeff (tLift (locSym α β μ t)) ![n.1, n.2]

theorem boxZero_locSym (α β : ℕ) (μ : ℝ × ℝ → ℂ) (t : ℝ) : BoxZero (locSym α β μ t) := by
  intro q hq
  constructor
  · by_contra h
    exact hq (locSym_eq_zero_x (by linarith [not_lt.1 h]))
  · by_contra h
    exact hq (locSym_eq_zero_y_large (by linarith [not_lt.1 h]))

theorem coef_eq (α β : ℕ) (μ : ℝ × ℝ → ℂ) (t : ℝ) (n : ℤ × ℤ) :
    coef α β μ t n = ∫ q, phase n.1 n.2 (locSym α β μ t) q := by
  rw [coef, mFourierCoeff_tLift (boxZero_locSym α β μ t)]
  rfl

theorem measurable_coef {α β N : ℕ} {C : ℝ} {μ : ℝ × ℝ → ℂ} (hμ : PureBounds α β N C μ)
    (n : ℤ × ℤ) : Measurable fun t => coef α β μ t n := by
  simp only [coef_eq]
  have hm := measurable_locSym hμ
  have h : Measurable fun w : ℝ × (ℝ × ℝ) => phase n.1 n.2 (locSym α β μ w.1) w.2 := by
    unfold phase
    have h1 : Measurable fun w : ℝ × (ℝ × ℝ) => (Real.fourierChar (-(w.2.1 * n.1)) : ℂ) :=
      (continuous_subtype_val.comp (Real.continuous_fourierChar.comp (by fun_prop))).measurable
    have h2 : Measurable fun w : ℝ × (ℝ × ℝ) => (Real.fourierChar (-(w.2.2 * n.2)) : ℂ) :=
      (continuous_subtype_val.comp (Real.continuous_fourierChar.comp (by fun_prop))).measurable
    exact h1.mul (h2.mul hm)
  exact (h.stronglyMeasurable.integral_prod_right' (ν := volume)).measurable

/-- The uniform constant in the coefficient decay. -/
def coefConst (α β : ℕ) (C : ℝ) (K : ℕ) : ℝ :=
  4 ^ K * max (C * (bk 0 * bl 0)) (max (SX α C (2 * K)) (SY β C (2 * K)))

/-- `|c_t(u,v)| ≲ (1+|u|)^{-K} (1+|v|)^{-K}` uniformly in `t > 0`, with `2K` derivatives. -/
theorem norm_coef_le {α β N : ℕ} (hα : 0 < α) (hβ : 0 < β) {C : ℝ} {μ : ℝ × ℝ → ℂ}
    (hμ : PureBounds α β N C μ) {K : ℕ} (hK : 2 * K ≤ N) {t : ℝ} (ht : 0 < t) (n : ℤ × ℤ) :
    ‖coef α β μ t n‖ ≤ coefConst α β C K * wt K n.1 n.2 := by
  have hC := hμ.nonneg
  have hG := continuous_locSym hμ ht
  have hz := boxZero_locSym α β μ t
  rw [coef_eq]
  set X := ‖∫ q, phase n.1 n.2 (locSym α β μ t) q‖
  set S := max (C * (bk 0 * bl 0)) (max (SX α C (2 * K)) (SY β C (2 * K)))
  have h0 : X ≤ S := by
    have := coeff_decay_y hG hz (M := 0) (fun x => (contDiff_locSym_y hμ ht x).of_le
      (by exact_mod_cast Nat.zero_le N)) (S := C * (bk 0 * bl 0))
      (fun x y => by simpa using norm_locSym_le hμ ht (x, y)) n.1 n.2
    simp only [pow_zero, mul_one] at this
    exact this.trans (le_max_left _ _)
  have hx := coeff_decay_x hG hz (M := 2 * K) (fun y => (contDiff_locSym_x hμ ht y).of_le
    (by exact_mod_cast hK)) (fun x y => norm_iteratedDeriv_locSym_x hα hβ hμ ht hK x y) n.1 n.2
  have hy := coeff_decay_y hG hz (M := 2 * K) (fun x => (contDiff_locSym_y hμ ht x).of_le
    (by exact_mod_cast hK)) (fun x y => norm_iteratedDeriv_locSym_y hα hβ hμ ht hK x y) n.1 n.2
  have := le_wt K n.1 n.2 (norm_nonneg _) h0
    (hx.trans ((le_max_left _ _).trans (le_max_right _ _)))
    (hy.trans ((le_max_right _ _).trans (le_max_right _ _)))
  simpa [coefConst, mul_assoc] using this

theorem coefConst_nonneg (α β : ℕ) {C : ℝ} (hC : 0 ≤ C) (K : ℕ) : 0 ≤ coefConst α β C K := by
  unfold coefConst
  have := bk_nonneg 0; have := bl_nonneg 0
  positivity

/-- The double Fourier series of `m^{(t)}` converges to it on `[-1/2,1/2]^2`. -/
theorem hasSum_locSym {α β N : ℕ} (hα : 0 < α) (hβ : 0 < β) {C : ℝ} {μ : ℝ × ℝ → ℂ}
    (hμ : PureBounds α β N C μ) {K : ℕ} (hK2 : 2 ≤ K) (hK : 2 * K ≤ N) {t : ℝ} (ht : 0 < t)
    {x y : ℝ} (hx : x ∈ Icc (-(1 / 2) : ℝ) (1 / 2)) (hy : y ∈ Icc (-(1 / 2) : ℝ) (1 / 2)) :
    HasSum (fun n : ℤ × ℤ => coef α β μ t n *
      ((Real.fourierChar (x * n.1) : ℂ) * (Real.fourierChar (y * n.2) : ℂ)))
      (locSym α β μ t (x, y)) := by
  have hz := boxZero_locSym α β μ t
  let f : C(UnitAddTorus (Fin 2), ℂ) := ⟨tLift (locSym α β μ t),
    continuous_tLift (continuous_locSym hμ ht) hz⟩
  let e : ℤ × ℤ ≃ (Fin 2 → ℤ) := (finTwoArrowEquiv ℤ).symm
  have he : ∀ n : ℤ × ℤ, e n = ![n.1, n.2] := fun n => rfl
  have hsum : Summable (UnitAddTorus.mFourierCoeff f) := by
    rw [← e.summable_iff]
    refine Summable.of_norm_bounded ((summable_wt hK2).mul_left (coefConst α β C K)) ?_
    intro n
    have := norm_coef_le hα hβ hμ hK ht n
    simpa [coef, he, f] using this
  have h := UnitAddTorus.hasSum_mFourier_series_apply_of_summable hsum
    (fun i => (((![x, y] : Fin 2 → ℝ) i : ℝ) : UnitAddCircle))
  rw [← e.hasSum_iff] at h
  have hv : f (fun i => (((![x, y] : Fin 2 → ℝ) i : ℝ) : UnitAddCircle)) = locSym α β μ t (x, y) :=
    tLift_coe hz hx hy
  rw [hv] at h
  refine h.congr_fun fun n => ?_
  simp only [Function.comp_apply, he, smul_eq_mul, mFourier_two, coef, f]
  rfl

end Cone


namespace Cone

/-! ### The physical kernels `g * φ̌_{1,u}` and `h * h * ψ̌_{1,v}` -/

/-- The translate `φ̌(· - u)` of the spatial low-frequency kernel `φ̌ = 𝓕^{-1} φ`. -/
def phiU (u : ℝ) (y : ℝ) : ℝ := conePhiPhysicalReal (y - u)

/-- The translate `ψ̌(· - v)` of the spatial annular kernel `ψ̌ = 𝓕^{-1} ψ`. -/
def psiU (v : ℝ) (y : ℝ) : ℝ := conePsiPhysicalReal (y - v)

/-- The frequency multiplier of `g * φ̌(· - u)`. -/
def A1 (u a : ℝ) : ℂ := (Real.fourierChar (-(u * a)) : ℂ) * ((gaussian a : ℂ) * (conePhi a : ℂ))

/-- The frequency multiplier of `h * h * ψ̌(· - v)`. -/
def A2 (v b : ℝ) : ℂ :=
  (Real.fourierChar (-(v * b)) : ℂ) * (-((gaussianDeriv b : ℂ) ^ 2 * (conePsi b : ℂ)))

theorem continuous_A1 (u : ℝ) : Continuous (A1 u) := by
  unfold A1
  have h1 : Continuous fun a : ℝ => (Real.fourierChar (-(u * a)) : ℂ) :=
    continuous_subtype_val.comp (Real.continuous_fourierChar.comp (by fun_prop))
  have h2 := Auto.Twisted.gaussian_contDiff.continuous
  have h3 := continuous_conePhi
  exact h1.mul ((Complex.continuous_ofReal.comp h2).mul (Complex.continuous_ofReal.comp h3))

theorem continuous_A2 (v : ℝ) : Continuous (A2 v) := by
  unfold A2
  have h1 : Continuous fun a : ℝ => (Real.fourierChar (-(v * a)) : ℂ) :=
    continuous_subtype_val.comp (Real.continuous_fourierChar.comp (by fun_prop))
  have h2 := continuous_gaussianDeriv
  have h3 := Auto.Twisted.conePsi_contDiff.continuous
  exact h1.mul (((Complex.continuous_ofReal.comp h2).pow 2).mul
    (Complex.continuous_ofReal.comp h3)).neg

theorem norm_A1 (u a : ℝ) : ‖A1 u a‖ = gaussian a * conePhi a := by
  rw [A1, norm_mul, Circle.norm_coe, one_mul, ← Complex.ofReal_mul, Complex.norm_real,
    Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (Auto.Twisted.gaussian_nonneg a)
      (Auto.Twisted.conePhi_nonneg a))]

theorem norm_A1_le (u a : ℝ) : ‖A1 u a‖ ≤ conePhi a := by
  rw [norm_A1]
  exact mul_le_of_le_one_left (Auto.Twisted.conePhi_nonneg a) (Auto.Twisted.gaussian_le_one a)

theorem norm_A2 (v b : ℝ) : ‖A2 v b‖ = psiH b := by
  rw [A2, norm_mul, Circle.norm_coe, one_mul, norm_neg, ← Complex.ofReal_pow,
    ← Complex.ofReal_mul, Complex.norm_real, Real.norm_eq_abs, mul_comm]
  exact abs_of_nonneg (psiH_nonneg b)

theorem A1_eq_zero {u a : ℝ} (ha : 2 ≤ |a|) : A1 u a = 0 := by
  simp [A1, Auto.Twisted.conePhi_eq_zero_of_two_le_abs ha]

theorem A2_eq_zero {v b : ℝ} (hb : 2 ≤ |b|) : A2 v b = 0 := by
  simp [A2, Auto.Twisted.conePsi_eq_zero_of_two_le_abs hb]

theorem integrable_A1 (u : ℝ) : Integrable (A1 u) := by
  refine (continuous_A1 u).integrable_of_hasCompactSupport ?_
  apply HasCompactSupport.intro (isCompact_closedBall (0 : ℝ) 2)
  intro a ha
  simp only [Metric.mem_closedBall, Real.dist_eq, sub_zero, not_le] at ha
  exact A1_eq_zero ha.le

theorem integrable_A2 (v : ℝ) : Integrable (A2 v) := by
  refine (continuous_A2 v).integrable_of_hasCompactSupport ?_
  apply HasCompactSupport.intro (isCompact_closedBall (0 : ℝ) 2)
  intro a ha
  simp only [Metric.mem_closedBall, Real.dist_eq, sub_zero, not_le] at ha
  exact A2_eq_zero ha.le

theorem gconv_eq_convolution (Φ : ℝ → ℝ) :
    gconv Φ = Φ ⋆[ContinuousLinearMap.mul ℝ ℝ] gaussian := by
  funext x
  rw [convolution_mul, gconv]
  congr 1; funext y; ring

theorem hh_eq_convolution : hh = gaussianDeriv ⋆[ContinuousLinearMap.mul ℝ ℝ] gaussianDeriv := by
  funext x
  rw [hh, convolution_lsmul, convolution_mul]
  rfl

theorem hhconv_eq_convolution (Ψ : ℝ → ℝ) :
    hhconv Ψ = Ψ ⋆[ContinuousLinearMap.mul ℝ ℝ] hh := by
  funext x
  rw [convolution_mul, hhconv]
  congr 1; funext y; ring

theorem integrable_hh : Integrable hh := by
  rw [hh_eq_convolution]
  exact Auto.Twisted.integrable_gaussianDeriv.integrable_convolution _
    Auto.Twisted.integrable_gaussianDeriv

theorem phiU_integrable (u : ℝ) : Integrable (phiU u) :=
  conePhiPhysicalReal.integrable.comp_sub_right u

theorem psiU_integrable (v : ℝ) : Integrable (psiU v) :=
  conePsiPhysicalReal.integrable.comp_sub_right v

theorem phiU_continuous (u : ℝ) : Continuous (phiU u) :=
  conePhiPhysicalReal.continuous.comp (continuous_id.sub continuous_const)

theorem psiU_continuous (v : ℝ) : Continuous (psiU v) :=
  conePsiPhysicalReal.continuous.comp (continuous_id.sub continuous_const)

theorem phiU_bdd (u : ℝ) : BddAbove (range fun y => ‖phiU u y‖) := by
  obtain ⟨C, -, hC⟩ := Auto.Twisted.conePhiPhysicalReal_decay 0
  exact ⟨C, by rintro _ ⟨y, rfl⟩; simpa [phiU] using hC (y - u)⟩

theorem psiU_bdd (v : ℝ) : BddAbove (range fun y => ‖psiU v y‖) := by
  obtain ⟨C, -, hC⟩ := Auto.Twisted.conePsiPhysicalReal_decay 0
  exact ⟨C, by rintro _ ⟨y, rfl⟩; simpa [psiU] using hC (y - v)⟩

theorem continuous_gconv_phiU (u : ℝ) : Continuous (gconv (phiU u)) := by
  rw [gconv_eq_convolution]
  exact (phiU_bdd u).continuous_convolution_left_of_integrable _ (phiU_continuous u)
    Auto.Twisted.integrable_gaussian

theorem continuous_hhconv_psiU (v : ℝ) : Continuous (hhconv (psiU v)) := by
  rw [hhconv_eq_convolution]
  exact (psiU_bdd v).continuous_convolution_left_of_integrable _ (psiU_continuous v)
    integrable_hh

theorem integrable_gconv_phiU (u : ℝ) : Integrable (gconv (phiU u)) := by
  rw [gconv_eq_convolution]
  exact (phiU_integrable u).integrable_convolution _ Auto.Twisted.integrable_gaussian

theorem integrable_hhconv_psiU (v : ℝ) : Integrable (hhconv (psiU v)) := by
  rw [hhconv_eq_convolution]
  exact (psiU_integrable v).integrable_convolution _ integrable_hh

theorem fourier_gconv_phiU (u : ℝ) :
    𝓕 (fun x => ((gconv (phiU u) x : ℝ) : ℂ)) = A1 u := by
  funext ξ
  have e : (fun x => ((gconv (phiU u) x : ℝ) : ℂ)) =
      (fun y => ((phiU u y : ℝ) : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (fun y => ((gaussian y : ℝ) : ℂ)) := by
    funext x
    rw [gconv_eq_convolution, Auto.Twisted.ofReal_convolution]
  rw [e]
  refine (Real.fourier_mul_convolution_eq (phiU_integrable u).ofReal
    Auto.Twisted.integrable_gaussian.ofReal ξ).trans ?_
  change 𝓕 (fun x => ((phiU u x : ℝ) : ℂ)) ξ * 𝓕 (fun x => ((gaussian x : ℝ) : ℂ)) ξ = A1 u ξ
  rw [Auto.Twisted.fourier_gaussian]
  simp only [phiU]
  rw [Auto.Twisted.fourier_translate_sub (fun x => ((conePhiPhysicalReal x : ℝ) : ℂ)) u,
    Auto.Twisted.fourier_conePhiPhysicalReal, A1]
  ring

theorem fourier_hhconv_psiU (v : ℝ) :
    𝓕 (fun x => ((hhconv (psiU v) x : ℝ) : ℂ)) = A2 v := by
  funext ξ
  have ehh : (fun x => ((hh x : ℝ) : ℂ)) =
      (fun y => ((gaussianDeriv y : ℝ) : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (fun y => ((gaussianDeriv y : ℝ) : ℂ)) := by
    funext x
    rw [hh_eq_convolution, Auto.Twisted.ofReal_convolution]
  have e : (fun x => ((hhconv (psiU v) x : ℝ) : ℂ)) =
      (fun y => ((psiU v y : ℝ) : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (fun y => ((hh y : ℝ) : ℂ)) := by
    funext x
    rw [hhconv_eq_convolution, Auto.Twisted.ofReal_convolution]
  have hhint : Integrable (fun y => ((hh y : ℝ) : ℂ)) := integrable_hh.ofReal
  rw [e]
  refine (Real.fourier_mul_convolution_eq (psiU_integrable v).ofReal hhint ξ).trans ?_
  change 𝓕 (fun x => ((psiU v x : ℝ) : ℂ)) ξ * 𝓕 (fun x => ((hh x : ℝ) : ℂ)) ξ = A2 v ξ
  rw [ehh]
  have hh2 : 𝓕 ((fun y => ((gaussianDeriv y : ℝ) : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (fun y => ((gaussianDeriv y : ℝ) : ℂ))) ξ =
      (-Complex.I * (gaussianDeriv ξ : ℂ)) * (-Complex.I * (gaussianDeriv ξ : ℂ)) := by
    refine (Real.fourier_mul_convolution_eq Auto.Twisted.integrable_complexGaussianDeriv
      Auto.Twisted.integrable_complexGaussianDeriv ξ).trans ?_
    change 𝓕 (fun x => ((gaussianDeriv x : ℝ) : ℂ)) ξ *
      𝓕 (fun x => ((gaussianDeriv x : ℝ) : ℂ)) ξ = _
    rw [Auto.Twisted.fourier_gaussianDeriv]
  rw [hh2]
  simp only [psiU]
  rw [Auto.Twisted.fourier_translate_sub (fun x => ((conePsiPhysicalReal x : ℝ) : ℂ)) v,
    Auto.Twisted.fourier_conePsiPhysicalReal, A2]
  ring_nf
  rw [Complex.I_sq]
  ring

/-! ### From the frequency side to the physical side -/

/-- `∫ 𝓕f(ξ) e^{2πixξ} 𝓕K(sξ) dξ = ∫ f(x') K_s(x - x') dx'`. -/
theorem spatial_id {f : ℝ → ℂ} (hf : Integrable f) {K : ℝ → ℝ} (hKc : Continuous K)
    (hKi : Integrable K) (hFKc : Continuous (𝓕 fun w => ((K w : ℝ) : ℂ)))
    (hFKi : Integrable (𝓕 fun w => ((K w : ℝ) : ℂ))) {s : ℝ} (hs : 0 < s) (x : ℝ) :
    ∫ ξ, 𝓕 f ξ * (Real.fourierChar (x * ξ) : ℂ) * (𝓕 fun w => ((K w : ℝ) : ℂ)) (s * ξ) =
      ∫ x', f x' * ((kernelAt K s x' x : ℝ) : ℂ) := by
  set FK := 𝓕 fun w => ((K w : ℝ) : ℂ)
  let H : ℝ × ℝ → ℂ := fun p => (Real.fourierChar (-(p.2 * p.1)) : ℂ) * f p.2 *
    ((Real.fourierChar (x * p.1) : ℂ) * FK (s * p.1))
  have hFKs : Integrable fun ξ => FK (s * ξ) := hFKi.comp_mul_left' hs.ne'
  have hH : Integrable H (volume.prod volume) := by
    have hprod := hFKs.mul_prod hf
    refine hprod.mono ?_ (Eventually.of_forall fun p => ?_)
    · have h1 : Continuous fun p : ℝ × ℝ => (Real.fourierChar (-(p.2 * p.1)) : ℂ) :=
        continuous_subtype_val.comp (Real.continuous_fourierChar.comp (by fun_prop))
      have h2 : Continuous fun p : ℝ × ℝ => (Real.fourierChar (x * p.1) : ℂ) :=
        continuous_subtype_val.comp (Real.continuous_fourierChar.comp (by fun_prop))
      have h3 : Continuous fun p : ℝ × ℝ => FK (s * p.1) := hFKc.comp (by fun_prop)
      exact (h1.aestronglyMeasurable.mul (hf.1.comp_snd)).mul
        (h2.aestronglyMeasurable.mul h3.aestronglyMeasurable)
    · simp only [H, norm_mul, Circle.norm_coe, one_mul]
      exact le_of_eq (by ring)
  have e1 : ∀ ξ, 𝓕 f ξ * (Real.fourierChar (x * ξ) : ℂ) * FK (s * ξ) = ∫ v, H (ξ, v) := by
    intro ξ
    rw [Real.fourier_real_eq, mul_assoc, ← integral_mul_const]
    congr 1
  simp_rw [e1]
  rw [integral_integral_swap hH]
  congr 1; funext v
  have e2 : ∫ ξ, H (ξ, v) = f v * ∫ ξ, (Real.fourierChar ((x - v) * ξ) : ℂ) * FK (s * ξ) := by
    rw [← integral_const_mul]
    congr 1; funext ξ
    simp only [H]
    have : (Real.fourierChar ((x - v) * ξ) : ℂ) =
        (Real.fourierChar (-(v * ξ)) : ℂ) * (Real.fourierChar (x * ξ) : ℂ) := by
      rw [← Circle.coe_mul, ← AddChar.map_add_eq_mul]; congr 2; ring
    rw [this]; ring
  rw [e2]
  congr 1
  have e3 : ∫ ξ, (Real.fourierChar ((x - v) * ξ) : ℂ) * FK (s * ξ) =
      (s⁻¹ : ℂ) * 𝓕⁻ FK ((x - v) / s) := by
    have hcomp := Measure.integral_comp_mul_left
      (fun ξ' : ℝ => (Real.fourierChar ((x - v) / s * ξ') : ℂ) * FK ξ') s
    have e4 : (fun ξ => (Real.fourierChar ((x - v) / s * (s * ξ)) : ℂ) * FK (s * ξ)) =
        fun ξ => (Real.fourierChar ((x - v) * ξ) : ℂ) * FK (s * ξ) := by
      funext ξ
      rw [show (x - v) / s * (s * ξ) = (x - v) * ξ by field_simp]
    rw [e4] at hcomp
    rw [hcomp, Real.fourierInv_eq, abs_of_pos (inv_pos.2 hs), Complex.real_smul]
    congr 1
    push_cast; ring
  have hinv : 𝓕⁻ FK = fun w => ((K w : ℝ) : ℂ) :=
    Continuous.fourierInv_fourier_eq (f := fun w => ((K w : ℝ) : ℂ))
      (Complex.continuous_ofReal.comp hKc) hKi.ofReal hFKi
  rw [e3, hinv]
  simp only [kernelAt, kernelDilate, smul_eq_mul]
  push_cast
  ring_nf

end Cone


namespace Cone

/-! ### The bilinear multiplier operator with a general symbol -/

/-- The bilinear operator with multiplier `M` (so `Tm m = TOp (m ∘ neg)`). -/
def TOp (M : ℝ × ℝ → ℂ) (f₁ f₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℂ :=
  ∫ ξ, ∫ η, M (ξ, η) * 𝓕 (fun x => f₁ (x, z.2)) ξ * 𝓕 (fun y => f₂ (z.1, y)) η *
    Complex.exp (2 * π * Complex.I * (z.1 * ξ + z.2 * η))

theorem Tm_eq_TOp (m : ℝ × ℝ → ℂ) (f₁ f₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) :
    Tm m f₁ f₂ z = TOp (fun p => m (-p)) f₁ f₂ z := rfl

/-- `𝓕₁f₁(ξ, y) e^{2πixξ}`. -/
def fr1 (f₁ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) (ξ : ℝ) : ℂ :=
  𝓕 (fun x => f₁ (x, z.2)) ξ * (Real.fourierChar (z.1 * ξ) : ℂ)

/-- `𝓕₂f₂(x, η) e^{2πiyη}`. -/
def fr2 (f₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) (η : ℝ) : ℂ :=
  𝓕 (fun y => f₂ (z.1, y)) η * (Real.fourierChar (z.2 * η) : ℂ)

theorem TOp_integrand (M : ℝ × ℝ → ℂ) (f₁ f₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) (ξ η : ℝ) :
    M (ξ, η) * 𝓕 (fun x => f₁ (x, z.2)) ξ * 𝓕 (fun y => f₂ (z.1, y)) η *
      Complex.exp (2 * π * Complex.I * (z.1 * ξ + z.2 * η)) =
      M (ξ, η) * (fr1 f₁ z ξ * fr2 f₂ z η) := by
  simp only [fr1, fr2, Real.fourierChar_apply]
  rw [show (2 * π * Complex.I * (z.1 * ξ + z.2 * η) : ℂ) =
    (↑(2 * π * (z.1 * ξ)) * Complex.I) + (↑(2 * π * (z.2 * η)) * Complex.I) by push_cast; ring,
    Complex.exp_add]
  ring

/-! ### Test functions -/

/-- A smooth compactly supported function on the plane. -/
def IsTest (f : ℝ × ℝ → ℂ) : Prop := ContDiff ℝ ∞ f ∧ HasCompactSupport f

theorem IsTest.section1 {f : ℝ × ℝ → ℂ} (hf : IsTest f) (c : ℝ) :
    ContDiff ℝ ∞ (fun x => f (x, c)) ∧ HasCompactSupport (fun x => f (x, c)) := by
  refine ⟨hf.1.comp (contDiff_id.prodMk contDiff_const), ?_⟩
  apply HasCompactSupport.intro (hf.2.isCompact.image continuous_fst)
  intro x hx
  exact image_eq_zero_of_notMem_tsupport fun h => hx ⟨(x, c), h, rfl⟩

theorem IsTest.section2 {f : ℝ × ℝ → ℂ} (hf : IsTest f) (c : ℝ) :
    ContDiff ℝ ∞ (fun y => f (c, y)) ∧ HasCompactSupport (fun y => f (c, y)) := by
  refine ⟨hf.1.comp (contDiff_const.prodMk contDiff_id), ?_⟩
  apply HasCompactSupport.intro (hf.2.isCompact.image continuous_snd)
  intro y hy
  exact image_eq_zero_of_notMem_tsupport fun h => hy ⟨(c, y), h, rfl⟩

theorem integrable_fourier_of_test {g : ℝ → ℂ} (h1 : ContDiff ℝ ∞ g) (h2 : HasCompactSupport g) :
    Integrable (𝓕 g) ∧ Continuous (𝓕 g) := by
  have h := (𝓕 (h2.toSchwartzMap h1)).integrable (μ := volume)
  have hc := (𝓕 (h2.toSchwartzMap h1)).continuous
  rw [SchwartzMap.fourier_coe] at h hc
  exact ⟨h, hc⟩

theorem integrable_test_section {g : ℝ → ℂ} (h1 : ContDiff ℝ ∞ g) (h2 : HasCompactSupport g) :
    Integrable g :=
  h1.continuous.integrable_of_hasCompactSupport h2

theorem continuous_fourierChar_mul (c : ℝ) :
    Continuous fun ξ : ℝ => (Real.fourierChar (c * ξ) : ℂ) :=
  continuous_subtype_val.comp (Real.continuous_fourierChar.comp (by fun_prop))

theorem integrable_fr1 {f₁ : ℝ × ℝ → ℂ} (hf : IsTest f₁) (z : ℝ × ℝ) :
    Integrable (fr1 f₁ z) ∧ Continuous (fr1 f₁ z) := by
  obtain ⟨hi, hc⟩ := integrable_fourier_of_test (hf.section1 z.2).1 (hf.section1 z.2).2
  refine ⟨?_, hc.mul (continuous_fourierChar_mul _)⟩
  refine hi.mono (hc.mul (continuous_fourierChar_mul _)).aestronglyMeasurable
    (Eventually.of_forall fun ξ => ?_)
  simp [fr1, Circle.norm_coe]

theorem integrable_fr2 {f₂ : ℝ × ℝ → ℂ} (hf : IsTest f₂) (z : ℝ × ℝ) :
    Integrable (fr2 f₂ z) ∧ Continuous (fr2 f₂ z) := by
  obtain ⟨hi, hc⟩ := integrable_fourier_of_test (hf.section2 z.1).1 (hf.section2 z.1).2
  refine ⟨?_, hc.mul (continuous_fourierChar_mul _)⟩
  refine hi.mono (hc.mul (continuous_fourierChar_mul _)).aestronglyMeasurable
    (Eventually.of_forall fun ξ => ?_)
  simp [fr2, Circle.norm_coe]

/-- The frequency-side product `P(ξ, η)`. -/
def frP (f₁ f₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) (q : ℝ × ℝ) : ℂ := fr1 f₁ z q.1 * fr2 f₂ z q.2

theorem integrable_frP {f₁ f₂ : ℝ × ℝ → ℂ} (h₁ : IsTest f₁) (h₂ : IsTest f₂) (z : ℝ × ℝ) :
    Integrable (frP f₁ f₂ z) :=
  (integrable_fr1 h₁ z).1.mul_prod (integrable_fr2 h₂ z).1

theorem continuous_frP {f₁ f₂ : ℝ × ℝ → ℂ} (h₁ : IsTest f₁) (h₂ : IsTest f₂) (z : ℝ × ℝ) :
    Continuous (frP f₁ f₂ z) :=
  ((integrable_fr1 h₁ z).2.comp continuous_fst).mul ((integrable_fr2 h₂ z).2.comp continuous_snd)

/-- For bounded measurable `M`, `TOp M` is a planar integral. -/
theorem TOp_eq_integral {M : ℝ × ℝ → ℂ} (hM : Measurable M) {B : ℝ} (hB : ∀ q, ‖M q‖ ≤ B)
    {f₁ f₂ : ℝ × ℝ → ℂ} (h₁ : IsTest f₁) (h₂ : IsTest f₂) (z : ℝ × ℝ) :
    TOp M f₁ f₂ z = ∫ q, M q * frP f₁ f₂ z q := by
  have hint : Integrable (fun q => M q * frP f₁ f₂ z q) :=
    (integrable_frP h₁ h₂ z).bdd_mul hM.aestronglyMeasurable (Eventually.of_forall hB)
  rw [Measure.volume_eq_prod, integral_prod _ hint]
  unfold TOp
  congr 1; funext ξ; congr 1; funext η
  rw [TOp_integrand]
  rfl

/-! ### The first cone -/

/-- The first-cone part `m(ξ,η) c_Ψ^{-2} ∫_0^∞ β φ(t^α ξ) ψ(t^β η) h(t^β η)^2 dt/t` of the
symbol. -/
def cone1Sym (α β : ℕ) (μ : ℝ × ℝ → ℂ) (p : ℝ × ℝ) : ℂ :=
  μ p * (((cPsi ^ 2)⁻¹ * ∫ t in Ioi 0, w1 α β p t : ℝ) : ℂ)

theorem cPsi_sq_pos : 0 < cPsi ^ 2 := pow_pos Auto.Twisted.cPsi_pos 2

theorem norm_cone1Sym_le {α β N : ℕ} (hα : 0 < α) (hβ : 0 < β) {C : ℝ} {μ : ℝ × ℝ → ℂ}
    (hμ : PureBounds α β N C μ) (p : ℝ × ℝ) : ‖cone1Sym α β μ p‖ ≤ C := by
  have hC := hμ.nonneg
  have h0 := integral_w1_nonneg α β p
  have h1 := integral_w1_le hα hβ p
  have hf0 : 0 ≤ (cPsi ^ 2)⁻¹ * ∫ t in Ioi 0, w1 α β p t := by
    have := cPsi_sq_pos; positivity
  have hf1 : (cPsi ^ 2)⁻¹ * ∫ t in Ioi 0, w1 α β p t ≤ 1 := by
    rw [inv_mul_le_iff₀ cPsi_sq_pos, mul_one]; exact h1
  rw [cone1Sym, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hf0]
  by_cases hp : p = 0
  · subst hp
    have : (∫ t in Ioi 0, w1 α β 0 t) = 0 := by
      have e : w1 α β 0 = fun _ => 0 := by
        funext t; simp [w1, psiH_eq_zero_of_abs_le_one]
      rw [e]; simp
    rw [this]; simp [hC]
  · calc ‖μ p‖ * ((cPsi ^ 2)⁻¹ * ∫ t in Ioi 0, w1 α β p t) ≤ C * 1 :=
          mul_le_mul (hμ.norm_le hp) hf1 hf0 hC
      _ = C := mul_one C

theorem measurable_w1 (α β : ℕ) : Measurable fun w : (ℝ × ℝ) × ℝ => w1 α β w.1 w.2 := by
  unfold w1
  have := continuous_conePhi.measurable
  have := continuous_psiH.measurable
  fun_prop

theorem measurable_cone1Sym {α β N : ℕ} {C : ℝ} {μ : ℝ × ℝ → ℂ} (hμ : PureBounds α β N C μ) :
    Measurable (cone1Sym α β μ) := by
  unfold cone1Sym
  have h := ((measurable_w1 α β).stronglyMeasurable.integral_prod_right'
    (ν := volume.restrict (Ioi 0))).measurable
  exact hμ.2.1.mul (Complex.measurable_ofReal.comp (measurable_const.mul h))

/-- The `(u, v)`-th term `(β/t) c_t(u,v) A₁(t^α ξ) A₂(t^β η)` of the expansion. -/
def termN (α β : ℕ) (μ : ℝ × ℝ → ℂ) (n : ℤ × ℤ) (p : ℝ × ℝ) (t : ℝ) : ℂ :=
  ((β : ℂ) / t) * coef α β μ t n *
    (A1 (-(n.1 : ℝ) / 8) (t ^ α * p.1) * A2 (-(n.2 : ℝ) / 8) (t ^ β * p.2))

theorem measurable_termN {α β N : ℕ} {C : ℝ} {μ : ℝ × ℝ → ℂ} (hμ : PureBounds α β N C μ)
    (n : ℤ × ℤ) : Measurable fun w : (ℝ × ℝ) × ℝ => termN α β μ n w.1 w.2 := by
  unfold termN
  have hc : Measurable fun w : (ℝ × ℝ) × ℝ => coef α β μ w.2 n :=
    (measurable_coef hμ n).comp measurable_snd
  have h1 := (continuous_A1 (-(n.1 : ℝ) / 8)).measurable
  have h2 := (continuous_A2 (-(n.2 : ℝ) / 8)).measurable
  have ht : Measurable fun w : (ℝ × ℝ) × ℝ => ((β : ℂ) / (w.2 : ℂ)) :=
    measurable_const.div (Complex.measurable_ofReal.comp measurable_snd)
  have hA1 : Measurable fun w : (ℝ × ℝ) × ℝ => A1 (-(n.1 : ℝ) / 8) (w.2 ^ α * w.1.1) :=
    h1.comp (by fun_prop)
  have hA2 : Measurable fun w : (ℝ × ℝ) × ℝ => A2 (-(n.2 : ℝ) / 8) (w.2 ^ β * w.1.2) :=
    h2.comp (by fun_prop)
  exact (ht.mul hc).mul (hA1.mul hA2)

/-- The termwise bound `|term| ≤ B (1+|u|)^{-K}(1+|v|)^{-K} w₁`. -/
theorem norm_termN_le {α β N : ℕ} (hα : 0 < α) (hβ : 0 < β) {C : ℝ} {μ : ℝ × ℝ → ℂ}
    (hμ : PureBounds α β N C μ) {K : ℕ} (hK : 2 * K ≤ N) (n : ℤ × ℤ) (p : ℝ × ℝ) {t : ℝ}
    (ht : 0 < t) :
    ‖termN α β μ n p t‖ ≤ coefConst α β C K * wt K n.1 n.2 * w1 α β p t := by
  unfold termN w1
  rw [norm_mul, norm_mul, norm_mul, norm_A2, norm_div, Complex.norm_natCast, Complex.norm_real,
    Real.norm_eq_abs, abs_of_pos ht]
  have hc := norm_coef_le hα hβ hμ hK ht n
  have ha := norm_A1_le (-(n.1 : ℝ) / 8) (t ^ α * p.1)
  have hp0 := psiH_nonneg (t ^ β * p.2)
  have hphi := Auto.Twisted.conePhi_nonneg (t ^ α * p.1)
  have := coefConst_nonneg α β hμ.nonneg K
  have := wt_pos K n.1 n.2
  calc (β : ℝ) / t * ‖coef α β μ t n‖ * (‖A1 (-(n.1 : ℝ) / 8) (t ^ α * p.1)‖ * psiH (t ^ β * p.2))
      ≤ (β : ℝ) / t * (coefConst α β C K * wt K n.1 n.2) *
          (conePhi (t ^ α * p.1) * psiH (t ^ β * p.2)) := by gcongr
    _ = _ := by ring

/-- `μ(ξ,η) β φ(t^α ξ) ψ(t^β η) h(t^β η)^2 / t = -∑_{u,v} term`. -/
theorem hasSum_termN {α β N : ℕ} (hα : 0 < α) (hβ : 0 < β) {C : ℝ} {μ : ℝ × ℝ → ℂ}
    (hμ : PureBounds α β N C μ) {K : ℕ} (hK2 : 2 ≤ K) (hK : 2 * K ≤ N) (p : ℝ × ℝ) {t : ℝ}
    (ht : 0 < t) :
    HasSum (fun n => termN α β μ n p t) (-(μ p * (w1 α β p t : ℂ))) := by
  set a := t ^ α * p.1
  set b := t ^ β * p.2
  by_cases hz : conePhi a = 0 ∨ conePsi b = 0
  · have h0 : ∀ n, termN α β μ n p t = 0 := by
      intro n
      unfold termN
      rcases hz with h | h
      · simp [A1, h, a]
      · simp [A2, h, b]
    have hw : w1 α β p t = 0 := by
      unfold w1
      rcases hz with h | h
      · simp [h, a]
      · simp [psiH, h, b]
    simp only [h0, hw, Complex.ofReal_zero, mul_zero, neg_zero]
    exact hasSum_zero
  · simp only [not_or] at hz
    have ha : |a| < 2 := by
      by_contra h; exact hz.1 (Auto.Twisted.conePhi_eq_zero_of_two_le_abs (not_lt.1 h))
    have hb : |b| < 2 := by
      by_contra h; exact hz.2 (Auto.Twisted.conePsi_eq_zero_of_two_le_abs (not_lt.1 h))
    have hx : a / 8 ∈ Icc (-(1 / 2) : ℝ) (1 / 2) := by
      rw [mem_Icc]; constructor <;> linarith [abs_lt.1 ha]
    have hy : b / 8 ∈ Icc (-(1 / 2) : ℝ) (1 / 2) := by
      rw [mem_Icc]; constructor <;> linarith [abs_lt.1 hb]
    have h := hasSum_locSym hα hβ hμ hK2 hK ht hx hy
    have hloc : locSym α β μ t (a / 8, b / 8) = μ p * (kap a * lam b) := by
      unfold locSym
      simp only [a, b]
      rw [show 8 * (t ^ α * p.1 / 8) = t ^ α * p.1 by ring,
        show 8 * (t ^ β * p.2 / 8) = t ^ β * p.2 by ring,
        mul_div_cancel_left₀ _ (pow_ne_zero _ ht.ne'),
        mul_div_cancel_left₀ _ (pow_ne_zero _ ht.ne')]
    rw [hloc] at h
    set c : ℂ := -((β : ℂ) / t) * ((gaussian a * conePhi a : ℝ) : ℂ) * (psiH b : ℂ)
    have h2 := h.mul_right c
    have hval : μ p * (kap a * lam b) * c = -(μ p * (w1 α β p t : ℂ)) := by
      have e1 := kap_mul_gaussian_conePhi a
      push_cast at e1
      have e2 := lam_mul_psiH b
      simp only [c, w1]
      push_cast
      linear_combination (-(μ p) * (β : ℂ) / t) *
        (lam b * (psiH b : ℂ) * e1 + (conePhi a : ℂ) * e2)
    rw [hval] at h2
    refine h2.congr_fun fun n => ?_
    simp only [termN, A1, A2, c, psiH]
    have e3 : (Real.fourierChar (-(-(n.1 : ℝ) / 8 * a)) : ℂ) =
        (Real.fourierChar (a / 8 * n.1) : ℂ) := by congr 2; ring
    have e4 : (Real.fourierChar (-(-(n.2 : ℝ) / 8 * b)) : ℂ) =
        (Real.fourierChar (b / 8 * n.2) : ℂ) := by congr 2; ring
    rw [e3, e4]
    push_cast
    ring

end Cone


namespace Cone

/-! ### The expansion of the first-cone operator into model operators -/

/-- The normalizing constant of the coefficients. -/
def bc (α β : ℕ) (C : ℝ) (K : ℕ) : ℝ := coefConst α β C K + 1

/-- The normalized coefficient `c(t) = c_t(u,v) / (B (1+|u|)^{-K}(1+|v|)^{-K})`, `|c| ≤ 1`. -/
def cfun (α β : ℕ) (μ : ℝ × ℝ → ℂ) (C : ℝ) (K : ℕ) (n : ℤ × ℤ) (t : ℝ) : ℂ :=
  if 0 < t then coef α β μ t n / ((bc α β C K * wt K n.1 n.2 : ℝ) : ℂ) else 0

/-- The first kernel `g * φ̌(· + u/8)`. -/
def K1 (n : ℤ × ℤ) : ℝ → ℝ := gconv (phiU (-(n.1 : ℝ) / 8))

/-- The second kernel `h * h * ψ̌(· + v/8)`. -/
def K2 (n : ℤ × ℤ) : ℝ → ℝ := hhconv (psiU (-(n.2 : ℝ) / 8))

/-- The weight of the `(u, v)`-th model operator. -/
def wN (β : ℕ) (b : ℝ) (K : ℕ) (n : ℤ × ℤ) : ℂ :=
  ((-(cPsi ^ 2)⁻¹ * β * (b * wt K n.1 n.2) : ℝ) : ℂ)

theorem bc_pos (α β : ℕ) {C : ℝ} (hC : 0 ≤ C) (K : ℕ) : 0 < bc α β C K := by
  have := coefConst_nonneg α β hC K
  unfold bc; linarith

theorem measurable_cfun {α β N : ℕ} {C : ℝ} {μ : ℝ × ℝ → ℂ} (hμ : PureBounds α β N C μ) (K : ℕ)
    (n : ℤ × ℤ) : Measurable (cfun α β μ C K n) := by
  unfold cfun
  exact Measurable.ite measurableSet_Ioi ((measurable_coef hμ n).div_const _) measurable_const

theorem norm_cfun_le {α β N : ℕ} (hα : 0 < α) (hβ : 0 < β) {C : ℝ} {μ : ℝ × ℝ → ℂ}
    (hμ : PureBounds α β N C μ) {K : ℕ} (hK : 2 * K ≤ N) (n : ℤ × ℤ) (t : ℝ) :
    ‖cfun α β μ C K n t‖ ≤ 1 := by
  unfold cfun
  split_ifs with ht
  · have hb := bc_pos α β hμ.nonneg K
    have hw := wt_pos K n.1 n.2
    have hbw : 0 < bc α β C K * wt K n.1 n.2 := mul_pos hb hw
    rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hbw, div_le_one hbw]
    refine (norm_coef_le hα hβ hμ hK ht n).trans ?_
    unfold bc
    exact mul_le_mul_of_nonneg_right (by linarith) hw.le
  · simp

theorem integrableOn_termN {α β N : ℕ} (hα : 0 < α) (hβ : 0 < β) {C : ℝ} {μ : ℝ × ℝ → ℂ}
    (hμ : PureBounds α β N C μ) {K : ℕ} (hK : 2 * K ≤ N) (n : ℤ × ℤ) (q : ℝ × ℝ) :
    IntegrableOn (termN α β μ n q) (Ioi 0) := by
  have hm : Measurable (termN α β μ n q) := by
    have h := (measurable_termN hμ n).comp (f := fun t : ℝ => (q, t)) (by fun_prop)
    exact h
  have hg : IntegrableOn (fun t => coefConst α β C K * wt K n.1 n.2 * w1 α β q t) (Ioi 0) :=
    (integrableOn_w1 hα hβ q).const_mul _
  refine Integrable.mono' hg hm.aestronglyMeasurable ?_
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
  exact norm_termN_le hα hβ hμ hK n q ht

theorem integral_norm_termN_le {α β N : ℕ} (hα : 0 < α) (hβ : 0 < β) {C : ℝ} {μ : ℝ × ℝ → ℂ}
    (hμ : PureBounds α β N C μ) {K : ℕ} (hK : 2 * K ≤ N) (n : ℤ × ℤ) (q : ℝ × ℝ) :
    ∫ t in Ioi 0, ‖termN α β μ n q t‖ ≤ coefConst α β C K * wt K n.1 n.2 * cPsi ^ 2 := by
  have hb := coefConst_nonneg α β hμ.nonneg K
  have hw := wt_pos K n.1 n.2
  calc ∫ t in Ioi 0, ‖termN α β μ n q t‖
      ≤ ∫ t in Ioi 0, coefConst α β C K * wt K n.1 n.2 * w1 α β q t := by
        refine integral_mono_of_nonneg (Eventually.of_forall fun _ => norm_nonneg _)
          ((integrableOn_w1 hα hβ q).const_mul _) ?_
        filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
        exact norm_termN_le hα hβ hμ hK n q ht
    _ = coefConst α β C K * wt K n.1 n.2 * ∫ t in Ioi 0, w1 α β q t := integral_const_mul _ _
    _ ≤ coefConst α β C K * wt K n.1 n.2 * cPsi ^ 2 := by
        gcongr; exact integral_w1_le hα hβ q

theorem summable_integral_norm_termN {α β N : ℕ} (hα : 0 < α) (hβ : 0 < β) {C : ℝ}
    {μ : ℝ × ℝ → ℂ} (hμ : PureBounds α β N C μ) {K : ℕ} (hK2 : 2 ≤ K) (hK : 2 * K ≤ N)
    (q : ℝ × ℝ) : Summable fun n => ∫ t in Ioi 0, ‖termN α β μ n q t‖ := by
  refine Summable.of_nonneg_of_le (fun n => integral_nonneg fun _ => norm_nonneg _)
    (fun n => (integral_norm_termN_le hα hβ hμ hK n q).trans (le_of_eq ?_))
    (((summable_wt hK2).mul_left (coefConst α β C K)).mul_right (cPsi ^ 2))
  ring

/-- The first-cone symbol as a sum of scale integrals. -/
theorem cone1Sym_eq_tsum {α β N : ℕ} (hα : 0 < α) (hβ : 0 < β) {C : ℝ} {μ : ℝ × ℝ → ℂ}
    (hμ : PureBounds α β N C μ) {K : ℕ} (hK2 : 2 ≤ K) (hK : 2 * K ≤ N) (q : ℝ × ℝ) :
    cone1Sym α β μ q = -((cPsi ^ 2)⁻¹ : ℂ) * ∑' n, ∫ t in Ioi 0, termN α β μ n q t := by
  rw [integral_tsum_of_summable_integral_norm (fun n => integrableOn_termN hα hβ hμ hK n q)
    (summable_integral_norm_termN hα hβ hμ hK2 hK q)]
  have e : ∫ t in Ioi 0, ∑' n, termN α β μ n q t =
      ∫ t in Ioi 0, -(μ q * (w1 α β q t : ℂ)) := by
    refine setIntegral_congr_fun measurableSet_Ioi fun t ht => ?_
    exact (hasSum_termN hα hβ hμ hK2 hK q ht).tsum_eq
  rw [e, integral_neg, integral_const_mul, integral_complex_ofReal, cone1Sym]
  push_cast
  ring

theorem measurable_Theta {α β N : ℕ} {C : ℝ} {μ : ℝ × ℝ → ℂ} (hμ : PureBounds α β N C μ)
    (n : ℤ × ℤ) : Measurable fun q => ∫ t in Ioi 0, termN α β μ n q t :=
  ((measurable_termN hμ n).stronglyMeasurable.integral_prod_right'
    (ν := volume.restrict (Ioi 0))).measurable

theorem norm_Theta_le {α β N : ℕ} (hα : 0 < α) (hβ : 0 < β) {C : ℝ} {μ : ℝ × ℝ → ℂ}
    (hμ : PureBounds α β N C μ) {K : ℕ} (hK : 2 * K ≤ N) (n : ℤ × ℤ) (q : ℝ × ℝ) :
    ‖∫ t in Ioi 0, termN α β μ n q t‖ ≤ coefConst α β C K * wt K n.1 n.2 * cPsi ^ 2 :=
  (norm_integral_le_integral_norm _).trans (integral_norm_termN_le hα hβ hμ hK n q)

/-- Fubini in `(ξ, η)` and `t` for a single mode. -/
theorem integral_Theta_mul {α β N : ℕ} (hα : 0 < α) (hβ : 0 < β) {C : ℝ} {μ : ℝ × ℝ → ℂ}
    (hμ : PureBounds α β N C μ) {K : ℕ} (hK : 2 * K ≤ N) (n : ℤ × ℤ) {P : ℝ × ℝ → ℂ}
    (hP : Integrable P) (hPc : Continuous P) :
    ∫ q, (∫ t in Ioi 0, termN α β μ n q t) * P q =
      ∫ t in Ioi 0, ∫ q, termN α β μ n q t * P q := by
  have e : ∀ q, (∫ t in Ioi 0, termN α β μ n q t) * P q = ∫ t in Ioi 0, termN α β μ n q t * P q :=
    fun q => (integral_mul_const _ _).symm
  simp_rw [e]
  have hmeas : Measurable fun w : (ℝ × ℝ) × ℝ => termN α β μ n w.1 w.2 * P w.1 :=
    (measurable_termN hμ n).mul (hPc.measurable.comp measurable_fst)
  refine integral_integral_swap ?_
  change Integrable (fun w : (ℝ × ℝ) × ℝ => termN α β μ n w.1 w.2 * P w.1) _
  rw [integrable_prod_iff hmeas.aestronglyMeasurable]
  refine ⟨Eventually.of_forall fun q => (integrableOn_termN hα hβ hμ hK n q).mul_const (P q), ?_⟩
  have hb := coefConst_nonneg α β hμ.nonneg K
  have hw := wt_pos K n.1 n.2
  refine Integrable.mono' (hP.norm.const_mul (coefConst α β C K * wt K n.1 n.2 * cPsi ^ 2))
    (hmeas.norm.stronglyMeasurable.integral_prod_right'
      (ν := volume.restrict (Ioi 0))).aestronglyMeasurable (Eventually.of_forall fun q => ?_)
  simp only [norm_mul]
  rw [integral_mul_const, Real.norm_eq_abs,
    abs_of_nonneg (mul_nonneg (integral_nonneg fun _ => norm_nonneg _) (norm_nonneg _))]
  exact mul_le_mul_of_nonneg_right (integral_norm_termN_le hα hβ hμ hK n q) (norm_nonneg _)

/-- The inner integrals of the model operator are the frequency-side pairings. -/
theorem integral_termN_mul_frP {α β : ℕ} (μ : ℝ × ℝ → ℂ) (n : ℤ × ℤ) {f₁ f₂ : ℝ × ℝ → ℂ}
    (h₁ : IsTest f₁) (h₂ : IsTest f₂) (z : ℝ × ℝ) {t : ℝ} (ht : 0 < t) :
    ∫ q, termN α β μ n q t * frP f₁ f₂ z q =
      ((β : ℂ) / t) * coef α β μ t n *
        ((∫ x', f₁ (x', z.2) * ((kernelAt (K1 n) (t ^ α) x' z.1 : ℝ) : ℂ)) *
          (∫ y', f₂ (z.1, y') * ((kernelAt (K2 n) (t ^ β) y' z.2 : ℝ) : ℂ))) := by
  have e : ∀ q, termN α β μ n q t * frP f₁ f₂ z q =
      ((β : ℂ) / t) * coef α β μ t n *
        ((fr1 f₁ z q.1 * A1 (-(n.1 : ℝ) / 8) (t ^ α * q.1)) *
          (fr2 f₂ z q.2 * A2 (-(n.2 : ℝ) / 8) (t ^ β * q.2))) := by
    intro q; simp only [termN, frP]; ring
  simp_rw [e]
  rw [integral_const_mul, Measure.volume_eq_prod,
    integral_prod_mul (fun x => fr1 f₁ z x * A1 (-(n.1 : ℝ) / 8) (t ^ α * x))
      (fun y => fr2 f₂ z y * A2 (-(n.2 : ℝ) / 8) (t ^ β * y))]
  congr 2
  · have h := spatial_id (f := fun x => f₁ (x, z.2))
      (integrable_test_section (h₁.section1 z.2).1 (h₁.section1 z.2).2)
      (K := K1 n) (continuous_gconv_phiU _) (integrable_gconv_phiU _)
      (by rw [K1, fourier_gconv_phiU]; exact continuous_A1 _)
      (by rw [K1, fourier_gconv_phiU]; exact integrable_A1 _) (pow_pos ht α) z.1
    rw [← h, K1, fourier_gconv_phiU]
    rfl
  · have h := spatial_id (f := fun y => f₂ (z.1, y))
      (integrable_test_section (h₂.section2 z.1).1 (h₂.section2 z.1).2)
      (K := K2 n) (continuous_hhconv_psiU _) (integrable_hhconv_psiU _)
      (by rw [K2, fourier_hhconv_psiU]; exact continuous_A2 _)
      (by rw [K2, fourier_hhconv_psiU]; exact integrable_A2 _) (pow_pos ht β) z.2
    rw [← h, K2, fourier_hhconv_psiU]
    rfl

/-- **The cone decomposition of the first cone**: for test functions,
`T¹(f₁,f₂)(z) = ∑_{u,v} w(u,v) U^{(u,v)}(f₁,f₂)(z)` with
`w(u,v) = -c_Ψ^{-2} β B (1+|u|)^{-K}(1+|v|)^{-K}` and model operators `U^{(u,v)}` with kernels
`g * φ̌(· + u/8)` and `h * h * ψ̌(· + v/8)` and coefficients `|c| ≤ 1`. -/
theorem hasSum_TOp_cone1 {α β N : ℕ} (hα : 0 < α) (hβ : 0 < β) {C : ℝ} {μ : ℝ × ℝ → ℂ}
    (hμ : PureBounds α β N C μ) {K : ℕ} (hK2 : 2 ≤ K) (hK : 2 * K ≤ N) {f₁ f₂ : ℝ × ℝ → ℂ}
    (h₁ : IsTest f₁) (h₂ : IsTest f₂) (z : ℝ × ℝ) :
    HasSum (fun n => wN β (bc α β C K) K n *
      modelOpFull α β (cfun α β μ C K n) (K1 n) (K2 n) f₁ f₂ z)
      (TOp (cone1Sym α β μ) f₁ f₂ z) := by
  rw [TOp_eq_integral (measurable_cone1Sym hμ) (norm_cone1Sym_le hα hβ hμ) h₁ h₂ z]
  set P := frP f₁ f₂ z
  have hP := integrable_frP h₁ h₂ z
  have hPc := continuous_frP h₁ h₂ z
  have hb := coefConst_nonneg α β hμ.nonneg K
  have e1 : ∀ q, cone1Sym α β μ q * P q =
      -((cPsi ^ 2)⁻¹ : ℂ) * ∑' n, (∫ t in Ioi 0, termN α β μ n q t) * P q := by
    intro q
    rw [cone1Sym_eq_tsum hα hβ hμ hK2 hK q, tsum_mul_right]
    ring
  simp_rw [e1]
  have hint : ∀ n, Integrable fun q => (∫ t in Ioi 0, termN α β μ n q t) * P q := fun n =>
    hP.bdd_mul (measurable_Theta hμ n).aestronglyMeasurable
      (Eventually.of_forall fun q => norm_Theta_le hα hβ hμ hK n q)
  have hnorm : ∀ n, ∫ q, ‖(∫ t in Ioi 0, termN α β μ n q t) * P q‖ ≤
      coefConst α β C K * wt K n.1 n.2 * cPsi ^ 2 * ∫ q, ‖P q‖ := by
    intro n
    rw [← integral_const_mul]
    refine integral_mono_of_nonneg (Eventually.of_forall fun _ => norm_nonneg _)
      (hP.norm.const_mul _) (Eventually.of_forall fun q => ?_)
    dsimp only
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (norm_Theta_le hα hβ hμ hK n q) (norm_nonneg _)
  have hsum : Summable fun n => ∫ q, ‖(∫ t in Ioi 0, termN α β μ n q t) * P q‖ :=
    Summable.of_nonneg_of_le (fun n => integral_nonneg fun _ => norm_nonneg _) hnorm
      ((((summable_wt hK2).mul_left (coefConst α β C K)).mul_right (cPsi ^ 2)).mul_right
        (∫ q, ‖P q‖))
  rw [integral_const_mul, ← integral_tsum_of_summable_integral_norm hint hsum]
  have hsum2 : Summable fun n => ∫ q, (∫ t in Ioi 0, termN α β μ n q t) * P q :=
    Summable.of_norm_bounded hsum fun n => norm_integral_le_integral_norm _
  have h := (hsum2.hasSum.mul_left (-((cPsi ^ 2)⁻¹ : ℂ)))
  refine h.congr_fun fun n => ?_
  rw [integral_Theta_mul hα hβ hμ hK n hP hPc]
  have e2 : ∫ t in Ioi 0, ∫ q, termN α β μ n q t * P q =
      ∫ t in Ioi 0, ((β : ℂ) * ((bc α β C K * wt K n.1 n.2 : ℝ) : ℂ)) *
        (cfun α β μ C K n t *
          ((∫ x', f₁ (x', z.2) * ((kernelAt (K1 n) (t ^ α) x' z.1 : ℝ) : ℂ)) *
            (∫ y', f₂ (z.1, y') * ((kernelAt (K2 n) (t ^ β) y' z.2 : ℝ) : ℂ))) / t) := by
    refine setIntegral_congr_fun measurableSet_Ioi fun t ht => ?_
    rw [integral_termN_mul_frP μ n h₁ h₂ z ht]
    have hbw : ((bc α β C K * wt K n.1 n.2 : ℝ) : ℂ) ≠ 0 := by
      have := bc_pos α β hμ.nonneg K; have := wt_pos K n.1 n.2
      exact_mod_cast (by positivity : (0 : ℝ) < bc α β C K * wt K n.1 n.2).ne'
    have ht0 : (t : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt ht)
    unfold cfun
    rw [if_pos (show (0 : ℝ) < t from ht)]
    field_simp
  rw [e2, integral_const_mul, wN, modelOpFull]
  push_cast
  ring

end Cone


namespace Cone

/-! ### Summation of the model bounds -/

theorem stronglyMeasurable_modelOpFull (α β : ℕ) {c : ℝ → ℂ} (hc : Measurable c) {φ ρ : ℝ → ℝ}
    (hφ : Measurable φ) (hρ : Measurable ρ) {f₁ f₂ : ℝ × ℝ → ℂ} (h₁ : Measurable f₁)
    (h₂ : Measurable f₂) : StronglyMeasurable (modelOpFull α β c φ ρ f₁ f₂) :=
  StronglyMeasurable.integral_prod_right' (ν := volume.restrict (Ioi 0))
    (FiberCZ.measurable_integrand α β hc hφ hρ h₁ h₂).stronglyMeasurable

/-- `(∑ aᵢ)^r ≤ ∑ aᵢ^r` for `0 < r ≤ 1`. -/
theorem tsum_rpow_le {ι : Type*} (a : ι → ℝ≥0∞) {r : ℝ} (hr0 : 0 < r) (hr1 : r ≤ 1) :
    (∑' i, a i) ^ r ≤ ∑' i, a i ^ r := by
  rw [ENNReal.tsum_eq_iSup_sum, iSup_rpow_ennreal _ hr0]
  refine iSup_le fun s => ?_
  classical
  have h : (∑ i ∈ s, a i) ^ r ≤ ∑ i ∈ s, a i ^ r := by
    induction s using Finset.induction_on with
    | empty => simp [ENNReal.zero_rpow_of_pos hr0]
    | insert j s hj ih =>
      rw [Finset.sum_insert hj, Finset.sum_insert hj]
      exact (ENNReal.rpow_add_le_add_rpow _ _ hr0.le hr1).trans (add_le_add le_rfl ih)
  exact h.trans (ENNReal.sum_le_tsum _)

/-- The `r`-triangle inequality for countable sums, `0 < r ≤ 1`. -/
theorem eLpNorm_tsum_le_of_le_one {X ι : Type*} [MeasurableSpace X] [Countable ι] {μ : Measure X}
    {F : ι → X → ℝ≥0∞} (hF : ∀ i, Measurable (F i)) {r : ℝ} (hr0 : 0 < r) (hr1 : r ≤ 1) :
    eLpNorm (fun x => ∑' i, F i x) (ENNReal.ofReal r) μ ≤
      (∑' i, eLpNorm (F i) (ENNReal.ofReal r) μ ^ r) ^ (1 / r) := by
  have hr : ENNReal.ofReal r ≠ 0 := by simpa using hr0
  have hrt : (ENNReal.ofReal r).toReal = r := ENNReal.toReal_ofReal hr0.le
  have e : ∀ G : X → ℝ≥0∞, eLpNorm G (ENNReal.ofReal r) μ = (∫⁻ x, G x ^ r ∂μ) ^ (1 / r) := by
    intro G
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hr ENNReal.ofReal_ne_top, hrt]
    simp only [enorm_eq_self]
  rw [e]
  have e2 : ∀ i, eLpNorm (F i) (ENNReal.ofReal r) μ ^ r = ∫⁻ x, F i x ^ r ∂μ := by
    intro i
    rw [e, ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hr0.ne', ENNReal.rpow_one]
  simp_rw [e2]
  rw [← lintegral_tsum fun i => ((hF i).pow_const r).aemeasurable]
  gcongr with x
  exact tsum_rpow_le _ hr0 hr1

/-- A summed family of model bounds gives a bound for the majorant. -/
theorem eLpNorm_tsum_le_of_bounds {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {F : ℤ × ℤ → X → ℝ≥0∞} (hF : ∀ n, Measurable (F n)) {r : ℝ} (hr0 : 0 < r) {c : ℤ × ℤ → ℝ}
    (hc0 : ∀ n, 0 ≤ c n) (hcs : Summable c) (hcr : Summable fun n => c n ^ r) {Y : ℝ≥0∞}
    (hb : ∀ n, eLpNorm (F n) (ENNReal.ofReal r) μ ≤ ENNReal.ofReal (c n) * Y) :
    eLpNorm (fun x => ∑' n, F n x) (ENNReal.ofReal r) μ ≤
      ENNReal.ofReal (max (∑' n, c n) ((∑' n, c n ^ r) ^ (1 / r))) * Y := by
  rcases le_total 1 r with h1 | h1
  · have h := eLpNorm_tsum_le (μ := μ) hF (show (1 : ℝ≥0∞) ≤ ENNReal.ofReal r by simpa using h1)
      ENNReal.ofReal_ne_top
    refine h.trans ((ENNReal.tsum_le_tsum hb).trans ?_)
    rw [ENNReal.tsum_mul_right, ← ENNReal.ofReal_tsum_of_nonneg hc0 hcs]
    gcongr
    exact le_max_left _ _
  · have h := eLpNorm_tsum_le_of_le_one (μ := μ) hF hr0 h1
    refine h.trans ?_
    have hb' : ∀ n, eLpNorm (F n) (ENNReal.ofReal r) μ ^ r ≤ ENNReal.ofReal (c n ^ r) * Y ^ r := by
      intro n
      rw [← ENNReal.ofReal_rpow_of_nonneg (hc0 n) hr0.le, ← ENNReal.mul_rpow_of_nonneg _ _ hr0.le]
      exact ENNReal.rpow_le_rpow (hb n) hr0.le
    refine (ENNReal.rpow_le_rpow (ENNReal.tsum_le_tsum hb') (by positivity)).trans ?_
    rw [ENNReal.tsum_mul_right, ← ENNReal.ofReal_tsum_of_nonneg (fun n => by
      have := hc0 n; positivity) hcr, ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
      ← ENNReal.rpow_mul, mul_one_div_cancel hr0.ne', ENNReal.rpow_one,
      ENNReal.ofReal_rpow_of_nonneg (tsum_nonneg fun n => by have := hc0 n; positivity)
        (by positivity)]
    gcongr
    exact le_max_right _ _

theorem summable_one_add_abs_rpow {s : ℝ} (hs : 1 < s) :
    Summable fun u : ℤ => (1 + |(u : ℝ)|) ^ (-s) := by
  have h1 : Summable fun u : ℤ => |(u : ℝ)| ^ (-s) := Real.summable_abs_int_rpow hs
  have h2 : Summable fun u : ℤ => if u = 0 then (1 : ℝ) else 0 :=
    summable_of_ne_finset_zero (s := {0}) (fun u hu => by simp at hu; simp [hu])
  refine Summable.of_nonneg_of_le (fun u => by positivity) (fun u => ?_) (h1.add h2)
  by_cases hu : u = 0
  · subst hu
    simp [Real.zero_rpow (by linarith : -s ≠ 0)]
  · have hu1 : (1 : ℝ) ≤ |(u : ℝ)| := by exact_mod_cast Int.one_le_abs hu
    simp only [hu, if_false, add_zero]
    exact Real.rpow_le_rpow_of_nonpos (by linarith) (by linarith) (by linarith)

theorem summable_wt_two_rpow {r : ℝ} (hr : 1 / 2 < r) :
    Summable fun n : ℤ × ℤ => wt 2 n.1 n.2 ^ r := by
  have hs : 1 < 2 * r := by linarith
  have h := Summable.mul_of_nonneg (summable_one_add_abs_rpow hs) (summable_one_add_abs_rpow hs)
    (fun u => by positivity) (fun u => by positivity)
  refine h.congr fun n => ?_
  have ha : 0 < 1 + |(n.1 : ℝ)| := by positivity
  have hb : 0 < 1 + |(n.2 : ℝ)| := by positivity
  simp only [wt]
  rw [one_div, Real.inv_rpow (by positivity), ← Real.rpow_natCast, ← Real.rpow_mul (by positivity),
    Real.mul_rpow ha.le hb.le, mul_inv, Real.rpow_neg ha.le, Real.rpow_neg hb.le]
  norm_num

end Cone


namespace Cone

/-! ### Bounds for the first cone -/

theorem translate_decay {f : ℝ → ℝ} {D : ℕ} {C : ℝ} (hf : ∀ y, |f y| ≤ C / (1 + |y|) ^ D)
    (u x : ℝ) : |f (x - u)| ≤ C * (1 + |u|) ^ D * (1 + |x|) ^ (-(D : ℝ)) := by
  have hC : 0 ≤ C := by have := (abs_nonneg _).trans (hf 0); simpa using this
  have hx : 0 < 1 + |x| := by positivity
  have hxu : 0 < 1 + |x - u| := by positivity
  rw [Real.rpow_neg hx.le, Real.rpow_natCast]
  refine (hf (x - u)).trans ?_
  rw [div_le_iff₀ (pow_pos hxu D), mul_assoc, mul_assoc]
  have hP : (1 + |x|) ≤ (1 + |x - u|) * (1 + |u|) := by
    have := abs_sub_abs_le_abs_sub x u
    nlinarith [abs_nonneg (x - u), abs_nonneg u]
  have hP' : (1 + |x|) ^ D ≤ (1 + |x - u|) ^ D * (1 + |u|) ^ D := by
    rw [← mul_pow]; exact pow_le_pow_left₀ hx.le hP D
  have key : 1 ≤ (1 + |u|) ^ D * (((1 + |x|) ^ D)⁻¹ * (1 + |x - u|) ^ D) := by
    rw [show (1 + |u|) ^ D * (((1 + |x|) ^ D)⁻¹ * (1 + |x - u|) ^ D) =
      ((1 + |x - u|) ^ D * (1 + |u|) ^ D) / (1 + |x|) ^ D by rw [div_eq_mul_inv]; ring,
      le_div_iff₀ (pow_pos hx D), one_mul]
    exact hP'
  calc C = C * 1 := (mul_one C).symm
    _ ≤ C * ((1 + |u|) ^ D * (((1 + |x|) ^ D)⁻¹ * (1 + |x - u|) ^ D)) :=
      mul_le_mul_of_nonneg_left key hC

theorem phiU_decay (D : ℕ) : ∃ A : ℝ, 0 ≤ A ∧
    ∀ u x, |phiU u x| ≤ A * (1 + |u|) ^ D * (1 + |x|) ^ (-(D : ℝ)) := by
  obtain ⟨C, hC, h⟩ := Auto.Twisted.conePhiPhysicalReal_decay D
  exact ⟨C, hC, fun u x => translate_decay h u x⟩

theorem psiU_decay (D : ℕ) : ∃ A : ℝ, 0 ≤ A ∧
    ∀ v x, |psiU v x| ≤ A * (1 + |v|) ^ D * (1 + |x|) ^ (-(D : ℝ)) := by
  obtain ⟨C, hC, h⟩ := Auto.Twisted.conePsiPhysicalReal_decay D
  exact ⟨C, hC, fun v x => translate_decay h v x⟩

theorem phiU_contDiff (u : ℝ) : ContDiff ℝ ∞ (phiU u) :=
  (conePhiPhysicalReal.smooth ⊤).comp (contDiff_id.sub contDiff_const)

theorem psiU_contDiff (v : ℝ) : ContDiff ℝ ∞ (psiU v) :=
  (conePsiPhysicalReal.smooth ⊤).comp (contDiff_id.sub contDiff_const)

/-- The majorant `∑ |w(u,v)| |U^{(u,v)}(f₁,f₂)|` of the first-cone operator. -/
def major (α β : ℕ) (μ : ℝ × ℝ → ℂ) (C : ℝ) (K : ℕ) (f₁ f₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℝ≥0∞ :=
  ∑' n, ‖wN β (bc α β C K) K n‖ₑ *
    ‖modelOpFull α β (cfun α β μ C K n) (K1 n) (K2 n) f₁ f₂ z‖ₑ

theorem measurable_modelN {α β N : ℕ} {C : ℝ} {μ : ℝ × ℝ → ℂ} (hμ : PureBounds α β N C μ)
    (K : ℕ) (n : ℤ × ℤ) {f₁ f₂ : ℝ × ℝ → ℂ} (h₁ : IsTest f₁) (h₂ : IsTest f₂) :
    Measurable (modelOpFull α β (cfun α β μ C K n) (K1 n) (K2 n) f₁ f₂) :=
  (stronglyMeasurable_modelOpFull α β (measurable_cfun hμ K n)
    (continuous_gconv_phiU _).measurable (continuous_hhconv_psiU _).measurable
    h₁.1.continuous.measurable h₂.1.continuous.measurable).measurable

theorem measurable_major {α β N : ℕ} {C : ℝ} {μ : ℝ × ℝ → ℂ} (hμ : PureBounds α β N C μ)
    (K : ℕ) {f₁ f₂ : ℝ × ℝ → ℂ} (h₁ : IsTest f₁) (h₂ : IsTest f₂) :
    Measurable (major α β μ C K f₁ f₂) :=
  Measurable.tsum fun n => measurable_const.mul (measurable_modelN hμ K n h₁ h₂).enorm

theorem enorm_TOp_cone1_le {α β N : ℕ} (hα : 0 < α) (hβ : 0 < β) {C : ℝ} {μ : ℝ × ℝ → ℂ}
    (hμ : PureBounds α β N C μ) {K : ℕ} (hK2 : 2 ≤ K) (hK : 2 * K ≤ N) {f₁ f₂ : ℝ × ℝ → ℂ}
    (h₁ : IsTest f₁) (h₂ : IsTest f₂) (z : ℝ × ℝ) :
    ‖TOp (cone1Sym α β μ) f₁ f₂ z‖ₑ ≤ major α β μ C K f₁ f₂ z := by
  rw [← (hasSum_TOp_cone1 hα hβ hμ hK2 hK h₁ h₂ z).tsum_eq]
  refine enorm_tsum_le_tsum_enorm.trans (le_of_eq ?_)
  unfold major
  congr 1; funext n
  rw [enorm_mul]

/-- **Bound for the first cone** from the model-operator bound, uniform over symbols with the
same constant. -/
theorem major_bound {α β : ℕ} (hα : 0 < α) (hβ : 0 < β) {p q r : ℝ} {D : ℕ} (hr : 1 / 2 < r)
    (hMB : ModelBound α β p q r D) (C₀ : ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ μ : ℝ × ℝ → ℂ, PureBounds α β (2 * (D ^ 2 + 2)) C₀ μ →
      ∀ f₁ f₂ : ℝ × ℝ → ℂ, IsTest f₁ → IsTest f₂ →
        eLpNorm (major α β μ C₀ (D ^ 2 + 2) f₁ f₂) (ENNReal.ofReal r) volume ≤
          ENNReal.ofReal C * eLpNorm f₁ (ENNReal.ofReal p) volume *
            eLpNorm f₂ (ENNReal.ofReal q) volume := by
  obtain ⟨CM, hCM0, hCM⟩ := hMB
  obtain ⟨Cφ, hCφ, hφ⟩ := phiU_decay D
  obtain ⟨Cψ, hCψ, hψ⟩ := psiU_decay D
  set K := D ^ 2 + 2 with hKdef
  have hr0 : 0 < r := by linarith
  -- the constant `B` only depends on `C₀`
  by_cases hC₀ : 0 ≤ C₀
  swap
  · refine ⟨0, le_rfl, fun μ hμ => absurd hμ.nonneg hC₀⟩
  set B := bc α β C₀ K
  have hB : 0 < B := bc_pos α β hC₀ K
  set c : ℤ × ℤ → ℝ := fun n =>
    (cPsi ^ 2)⁻¹ * β * B * CM * (Cφ * Cψ + 1) ^ D * wt 2 n.1 n.2 with hc_def
  have hc0 : ∀ n, 0 ≤ c n := fun n => by
    have := wt_pos 2 n.1 n.2; have := cPsi_sq_pos; simp only [c]; positivity
  have hcs : Summable c := (summable_wt le_rfl).mul_left _
  have hcr : Summable fun n => c n ^ r := by
    refine ((summable_wt_two_rpow hr).mul_left
      (((cPsi ^ 2)⁻¹ * β * B * CM * (Cφ * Cψ + 1) ^ D) ^ r)).congr fun n => ?_
    simp only [c]
    rw [Real.mul_rpow (by have := cPsi_sq_pos; positivity) (wt_pos 2 n.1 n.2).le]
  refine ⟨max (∑' n, c n) ((∑' n, c n ^ r) ^ (1 / r)), le_max_of_le_left (tsum_nonneg hc0),
    fun μ hμ f₁ f₂ h₁ h₂ => ?_⟩
  have hK2 : 2 ≤ K := by omega
  have hK : 2 * K ≤ 2 * (D ^ 2 + 2) := le_rfl
  rw [mul_assoc]
  refine eLpNorm_tsum_le_of_bounds (F := fun n z => ‖wN β B K n‖ₑ *
    ‖modelOpFull α β (cfun α β μ C₀ K n) (K1 n) (K2 n) f₁ f₂ z‖ₑ) (fun n => measurable_const.mul
    (measurable_modelN hμ K n h₁ h₂).enorm) hr0 hc0 hcs hcr fun n => ?_
  -- the bound for a single mode
  set u : ℝ := -(n.1 : ℝ) / 8
  set v : ℝ := -(n.2 : ℝ) / 8
  have hmod := hCM (phiU u) (psiU v) (Cφ * (1 + |u|) ^ D) (Cψ * (1 + |v|) ^ D)
    (phiU_contDiff u) (psiU_contDiff v) (hφ u) (hψ v) (cfun α β μ C₀ K n)
    (measurable_cfun hμ K n) (norm_cfun_le hα hβ hμ hK n) f₁ f₂ h₁.1 h₁.2 h₂.1 h₂.2
  have e : (fun z => ‖wN β B K n‖ₑ *
      ‖modelOpFull α β (cfun α β μ C₀ K n) (K1 n) (K2 n) f₁ f₂ z‖ₑ) =
      fun z => ‖(wN β B K n • modelOpFull α β (cfun α β μ C₀ K n) (K1 n) (K2 n) f₁ f₂) z‖ₑ := by
    funext z; rw [Pi.smul_apply, enorm_smul]
  rw [e, eLpNorm_enorm, eLpNorm_const_smul]
  have hpos : 0 ≤ (cPsi ^ 2)⁻¹ * β * (B * wt K n.1 n.2) := by
    have := wt_pos K n.1 n.2; have := cPsi_sq_pos; positivity
  have hw : ‖wN β B K n‖ₑ = ENNReal.ofReal ((cPsi ^ 2)⁻¹ * β * (B * wt K n.1 n.2)) := by
    rw [wN, ← ofReal_norm, Complex.norm_real, Real.norm_eq_abs, neg_mul, neg_mul, abs_neg,
      abs_of_nonneg hpos]
  rw [hw]
  refine (mul_le_mul' le_rfl hmod).trans ?_
  rw [← mul_assoc, ← mul_assoc, ← ENNReal.ofReal_mul hpos, mul_assoc]
  gcongr
  -- the real inequality
  simp only [c]
  set X := (1 + |(n.1 : ℝ)|) * (1 + |(n.2 : ℝ)|)
  have hX1 : 1 ≤ X := by
    have h1 : 1 ≤ 1 + |(n.1 : ℝ)| := by linarith [abs_nonneg (n.1 : ℝ)]
    have h2 : 1 ≤ 1 + |(n.2 : ℝ)| := by linarith [abs_nonneg (n.2 : ℝ)]
    nlinarith
  have hX0 : 0 < X := by linarith
  have hu : 1 + |u| ≤ 1 + |(n.1 : ℝ)| := by
    simp only [u, abs_div, abs_neg]; norm_num
    exact div_le_self (abs_nonneg _) (by norm_num)
  have hv : 1 + |v| ≤ 1 + |(n.2 : ℝ)| := by
    simp only [v, abs_div, abs_neg]; norm_num
    exact div_le_self (abs_nonneg _) (by norm_num)
  have hAB : Cφ * (1 + |u|) ^ D * (Cψ * (1 + |v|) ^ D) + 1 ≤ (Cφ * Cψ + 1) * X ^ D := by
    have h1 : (1 + |u|) ^ D * (1 + |v|) ^ D ≤ X ^ D := by
      rw [show X ^ D = (1 + |(n.1 : ℝ)|) ^ D * (1 + |(n.2 : ℝ)|) ^ D from mul_pow _ _ _]
      gcongr
    have h2 : 1 ≤ X ^ D := one_le_pow₀ hX1
    nlinarith [mul_nonneg hCφ hCψ]
  have hABD : (Cφ * (1 + |u|) ^ D * (Cψ * (1 + |v|) ^ D) + 1) ^ D ≤
      (Cφ * Cψ + 1) ^ D * X ^ (D * D) := by
    rw [pow_mul, ← mul_pow]
    exact pow_le_pow_left₀ (by positivity) hAB D
  have hwt : wt K n.1 n.2 * X ^ (D * D) = wt 2 n.1 n.2 := by
    simp only [wt, hKdef]
    rw [show D ^ 2 + 2 = D * D + 2 by ring, pow_add]
    field_simp
    rfl
  have hcPsi := cPsi_sq_pos
  have hwK := wt_pos K n.1 n.2
  calc (cPsi ^ 2)⁻¹ * β * (B * wt K n.1 n.2) *
        (CM * (Cφ * (1 + |u|) ^ D * (Cψ * (1 + |v|) ^ D) + 1) ^ D)
      ≤ (cPsi ^ 2)⁻¹ * β * (B * wt K n.1 n.2) * (CM * ((Cφ * Cψ + 1) ^ D * X ^ (D * D))) := by
        gcongr
    _ = (cPsi ^ 2)⁻¹ * β * B * CM * (Cφ * Cψ + 1) ^ D * (wt K n.1 n.2 * X ^ (D * D)) := by ring
    _ = _ := by rw [hwt]

end Cone


namespace Cone

/-! ### The two cones and the coordinate swap -/

theorem TOp_eq_integral_ae {M : ℝ × ℝ → ℂ} (hM : AEStronglyMeasurable M) {B : ℝ}
    (hB : ∀ᵐ q, ‖M q‖ ≤ B) {f₁ f₂ : ℝ × ℝ → ℂ} (h₁ : IsTest f₁) (h₂ : IsTest f₂) (z : ℝ × ℝ) :
    TOp M f₁ f₂ z = ∫ q, M q * frP f₁ f₂ z q := by
  have hint : Integrable (fun q => M q * frP f₁ f₂ z q) :=
    (integrable_frP h₁ h₂ z).bdd_mul hM hB
  rw [Measure.volume_eq_prod, integral_prod _ hint]
  unfold TOp
  congr 1; funext ξ; congr 1; funext η
  rw [TOp_integrand]
  rfl

theorem IsTest.swap {f : ℝ × ℝ → ℂ} (hf : IsTest f) : IsTest (f ∘ Prod.swap) :=
  ⟨hf.1.comp (contDiff_snd.prodMk contDiff_fst),
    hf.2.comp_homeomorph (Homeomorph.prodComm ℝ ℝ)⟩

theorem frP_swap (f₁ f₂ : ℝ × ℝ → ℂ) (z q : ℝ × ℝ) :
    frP (f₂ ∘ Prod.swap) (f₁ ∘ Prod.swap) z.swap q = frP f₁ f₂ z q.swap := by
  simp only [frP, fr1, fr2, Function.comp_def, Prod.swap]
  ring

/-- Exchanging the coordinates exchanges the roles of `f₁` and `f₂`. -/
theorem TOp_swap {M : ℝ × ℝ → ℂ} (hM : Measurable M) {B : ℝ} (hB : ∀ q, ‖M q‖ ≤ B)
    {f₁ f₂ : ℝ × ℝ → ℂ} (h₁ : IsTest f₁) (h₂ : IsTest f₂) (z : ℝ × ℝ) :
    TOp (M ∘ Prod.swap) f₁ f₂ z = TOp M (f₂ ∘ Prod.swap) (f₁ ∘ Prod.swap) z.swap := by
  rw [TOp_eq_integral (hM.comp measurable_swap) (fun q => hB q.swap) h₁ h₂,
    TOp_eq_integral hM hB h₂.swap h₁.swap]
  simp_rw [frP_swap]
  rw [Measure.volume_eq_prod]
  rw [← integral_prod_swap (fun q => M q * frP f₁ f₂ z q.swap)]
  simp only [Function.comp_apply, Prod.swap_swap]

theorem eLpNorm_comp_swap {E : Type*} [TopologicalSpace E] [ContinuousENorm E] (G : ℝ × ℝ → E)
    (p : ℝ≥0∞) :
    eLpNorm (G ∘ Prod.swap) p volume = eLpNorm G p volume := by
  have h := (MeasurableEquiv.prodComm (α := ℝ) (β := ℝ)).measurableEmbedding.eLpNorm_map_measure
    (g := G) (p := p) (μ := volume)
  have hmap : Measure.map (MeasurableEquiv.prodComm (α := ℝ) (β := ℝ))
      (volume : Measure (ℝ × ℝ)) = volume := by
    rw [Measure.volume_eq_prod]; exact Measure.prod_swap
  rw [hmap] at h
  exact h.symm

/-- The two-cone splitting `m = m^{(1)} + m^{(2)}` (`mdecompose2`). -/
theorem TOp_split {α β N : ℕ} (hα : 0 < α) (hβ : 0 < β) {C : ℝ} {μ : ℝ × ℝ → ℂ}
    (hμ : PureBounds α β N C μ) {f₁ f₂ : ℝ × ℝ → ℂ} (h₁ : IsTest f₁) (h₂ : IsTest f₂)
    (z : ℝ × ℝ) :
    TOp μ f₁ f₂ z = TOp (cone1Sym α β μ) f₁ f₂ z +
      TOp (cone1Sym β α (μ ∘ Prod.swap) ∘ Prod.swap) f₁ f₂ z := by
  have hne : ∀ᵐ q : ℝ × ℝ, q ≠ 0 := by
    rw [ae_iff]
    have e0 : {a : ℝ × ℝ | ¬a ≠ 0} = {0} := by ext a; simp
    rw [e0]; exact measure_singleton 0
  have hμs := hμ.swap
  rw [TOp_eq_integral_ae hμ.2.1.aestronglyMeasurable
      (hne.mono fun q hq => hμ.norm_le hq) h₁ h₂ z,
    TOp_eq_integral (measurable_cone1Sym hμ) (norm_cone1Sym_le hα hβ hμ) h₁ h₂ z,
    TOp_eq_integral ((measurable_cone1Sym hμs).comp measurable_swap)
      (fun q => norm_cone1Sym_le hβ hα hμs q.swap) h₁ h₂ z]
  have hP := integrable_frP h₁ h₂ z
  rw [← integral_add
    (hP.bdd_mul (measurable_cone1Sym hμ).aestronglyMeasurable
      (Eventually.of_forall (norm_cone1Sym_le hα hβ hμ)))
    (hP.bdd_mul ((measurable_cone1Sym hμs).comp measurable_swap).aestronglyMeasurable
      (Eventually.of_forall fun q => norm_cone1Sym_le hβ hα hμs q.swap))]
  refine integral_congr_ae (hne.mono fun q hq => ?_)
  obtain ⟨-, -, hcal⟩ := calderon hα hβ hq
  simp only [Function.comp_apply, cone1Sym, Prod.swap_swap]
  have e : ∀ t, w1 β α q.swap t = w2 α β q t := fun t => (w2_eq_w1_swap α β q t).symm
  simp only [e]
  have hc : (cPsi ^ 2)⁻¹ * (∫ t in Ioi 0, w1 α β q t) + (cPsi ^ 2)⁻¹ * ∫ t in Ioi 0, w2 α β q t =
      1 := by
    rw [← mul_add, hcal, inv_mul_cancel₀ cPsi_sq_pos.ne']
  have hc' : ((((cPsi ^ 2)⁻¹ * ∫ t in Ioi 0, w1 α β q t : ℝ) : ℂ) +
      (((cPsi ^ 2)⁻¹ * ∫ t in Ioi 0, w2 α β q t : ℝ) : ℂ)) = 1 := by
    exact_mod_cast hc
  linear_combination (-(μ q * frP f₁ f₂ z q)) * hc'

end Cone

open Cone

/-- **Theorem 2** (`thm:anisotp`) for test functions, from the bounds for the model operators
(`prop:twisted`): for `1 < p, q`, `1/2 < r < 2` with `1/p + 1/q = 1/r`, and symbols satisfying
`symest` up to order `N₁ = 2 (D^2 + 2)`,
`‖T_m(f₁,f₂)‖_r ≤ C ‖f₁‖_p ‖f₂‖_q`, with `C` depending only on the symbol constant `C₀`. -/
theorem thm_anisotp_of_modelBound {α β : ℕ} (hα : 0 < α) (hβ : 0 < β) {D : ℕ}
    (hM : ∀ p q r : ℝ, 1 < p → 1 < q → 1 / 2 < r → r < 2 → 1 / p + 1 / q = 1 / r →
      ModelBound α β p q r D ∧ ModelBound β α q p r D) :
    ∃ N₁ : ℕ, ∀ (C₀ : ℝ) (p q r : ℝ), 1 < p → 1 < q → 1 / 2 < r → r < 2 →
      1 / p + 1 / q = 1 / r →
      ∃ C : ℝ, 0 ≤ C ∧ ∀ m : ℝ × ℝ → ℂ, IsAnisoSymbol α β N₁ C₀ m →
        ∀ f₁ f₂ : ℝ × ℝ → ℂ, ContDiff ℝ ∞ f₁ → HasCompactSupport f₁ →
          ContDiff ℝ ∞ f₂ → HasCompactSupport f₂ →
          eLpNorm (Tm m f₁ f₂) (ENNReal.ofReal r) volume ≤
            ENNReal.ofReal C * eLpNorm f₁ (ENNReal.ofReal p) volume *
              eLpNorm f₂ (ENNReal.ofReal q) volume := by
  refine ⟨2 * (D ^ 2 + 2), fun C₀ p q r hp hq hr1 hr2 hpqr => ?_⟩
  obtain ⟨hM1, hM2⟩ := hM p q r hp hq hr1 hr2 hpqr
  obtain ⟨C1, hC1, h1⟩ := major_bound hα hβ hr1 hM1 C₀
  obtain ⟨C2, hC2, h2⟩ := major_bound hβ hα hr1 hM2 C₀
  set L := (ENNReal.ofReal r).LpAddConst
  have hL : L ≠ ⊤ := (ENNReal.LpAddConst_lt_top _).ne
  refine ⟨L.toReal * (C1 + C2), by positivity, fun m hm f₁ f₂ hf₁ hc₁ hf₂ hc₂ => ?_⟩
  have ht₁ : IsTest f₁ := ⟨hf₁, hc₁⟩
  have ht₂ : IsTest f₂ := ⟨hf₂, hc₂⟩
  set μ : ℝ × ℝ → ℂ := fun p => m (-p)
  have hμ : PureBounds α β (2 * (D ^ 2 + 2)) C₀ μ := (Cone.IsAnisoSymbol.pureBounds hm).neg
  have hμs := hμ.swap
  set G1 := major α β μ C₀ (D ^ 2 + 2) f₁ f₂
  set G2 := major β α (μ ∘ Prod.swap) C₀ (D ^ 2 + 2) (f₂ ∘ Prod.swap) (f₁ ∘ Prod.swap)
  have hK2 : 2 ≤ D ^ 2 + 2 := by omega
  have hpt : ∀ z, ‖Tm m f₁ f₂ z‖ₑ ≤ ‖(G1 + G2 ∘ Prod.swap) z‖ₑ := by
    intro z
    rw [Tm_eq_TOp, TOp_split hα hβ hμ ht₁ ht₂ z,
      TOp_swap (measurable_cone1Sym hμs) (norm_cone1Sym_le hβ hα hμs) ht₁ ht₂ z, enorm_eq_self]
    refine (enorm_add_le _ _).trans (add_le_add ?_ ?_)
    · exact enorm_TOp_cone1_le hα hβ hμ hK2 le_rfl ht₁ ht₂ z
    · exact enorm_TOp_cone1_le hβ hα hμs hK2 le_rfl ht₂.swap ht₁.swap z.swap
  have hG1 : Measurable G1 := measurable_major hμ _ ht₁ ht₂
  have hG2 : Measurable G2 := measurable_major hμs _ ht₂.swap ht₁.swap
  calc eLpNorm (Tm m f₁ f₂) (ENNReal.ofReal r) volume
      ≤ eLpNorm (G1 + G2 ∘ Prod.swap) (ENNReal.ofReal r) volume := eLpNorm_mono_enorm hpt
    _ ≤ L * (eLpNorm G1 (ENNReal.ofReal r) volume +
          eLpNorm (G2 ∘ Prod.swap) (ENNReal.ofReal r) volume) :=
        eLpNorm_add_le' hG1.aestronglyMeasurable
          (hG2.comp measurable_swap).aestronglyMeasurable _
    _ = L * (eLpNorm G1 (ENNReal.ofReal r) volume + eLpNorm G2 (ENNReal.ofReal r) volume) := by
        rw [eLpNorm_comp_swap]
    _ ≤ L * (ENNReal.ofReal C1 * eLpNorm f₁ (ENNReal.ofReal p) volume *
            eLpNorm f₂ (ENNReal.ofReal q) volume +
          ENNReal.ofReal C2 * eLpNorm (f₂ ∘ Prod.swap) (ENNReal.ofReal q) volume *
            eLpNorm (f₁ ∘ Prod.swap) (ENNReal.ofReal p) volume) := by
        gcongr
        · exact h1 μ hμ f₁ f₂ ht₁ ht₂
        · exact h2 (μ ∘ Prod.swap) hμs (f₂ ∘ Prod.swap) (f₁ ∘ Prod.swap) ht₂.swap ht₁.swap
    _ = ENNReal.ofReal (L.toReal * (C1 + C2)) * eLpNorm f₁ (ENNReal.ofReal p) volume *
          eLpNorm f₂ (ENNReal.ofReal q) volume := by
        rw [eLpNorm_comp_swap, eLpNorm_comp_swap, ENNReal.ofReal_mul ENNReal.toReal_nonneg,
          ENNReal.ofReal_add hC1 hC2, ENNReal.ofReal_toReal hL]
        ring


end

