    iteratedFDeriv ℝ ℓ m p (fun _ => ((0 : ℝ), (1 : ℝ))) := by
  rw [Fin.append_left_nil _ _ rfl]
  rw [show ((fun _ : Fin ℓ => ((0 : ℝ), (1 : ℝ))) ∘ Fin.cast (Nat.zero_add ℓ)) =
    fun _ => ((0 : ℝ), (1 : ℝ)) from rfl]
