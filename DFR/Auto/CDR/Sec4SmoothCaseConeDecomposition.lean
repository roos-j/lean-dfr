/-- Derivatives of a function along an affine line. -/
theorem iteratedDeriv_line {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] {m : E → F} {U : Set E} (hU : IsOpen U) {N : ℕ}
    (hm : ContDiffOn ℝ N m U) (c v : E) {y : ℝ} (hy : c + y • v ∈ U) {i : ℕ} (hi : i ≤ N) :
    iteratedDeriv i (fun y => m (c + y • v)) y = iteratedFDeriv ℝ i m (c + y • v) (fun _ => v) := by
  let L : ℝ →L[ℝ] E := (ContinuousLinearMap.id ℝ ℝ).smulRight v
  let m' : E → F := fun w => m (c + w)
  let U' : Set E := (fun w => c + w) ⁻¹' U
  have hU' : IsOpen U' := hU.preimage (continuous_const.add continuous_id)
  have hm' : ContDiffOn ℝ N m' U' :=
    hm.comp (contDiff_const.add contDiff_id).contDiffOn (fun w hw => hw)
  have hLU : IsOpen (L ⁻¹' U') := hU'.preimage L.continuous
  have hyL : L y ∈ U' := by simpa [L, U'] using hy
  have key := L.iteratedFDerivWithin_comp_right hm' hU'.uniqueDiffOn hLU.uniqueDiffOn
    (x := y) hyL (by exact_mod_cast hi)
  rw [iteratedFDerivWithin_of_isOpen _ hLU hyL, iteratedFDerivWithin_of_isOpen _ hU' hyL] at key
  rw [iteratedDeriv_eq_iteratedFDeriv]
  have e : (fun y => m (c + y • v)) = m' ∘ L := by
    funext y; simp [L, m']
  rw [e, key]
  simp [L, m', iteratedFDeriv_comp_add_left]

/-- The Leibniz bound on an open set. -/
theorem norm_iteratedDeriv_mul_le_of_isOpen {f g : ℝ → ℂ} {s : Set ℝ} (hs : IsOpen s) {N : ℕ}
    (hf : ContDiffOn ℝ N f s) (hg : ContDiffOn ℝ N g s) {y : ℝ} (hy : y ∈ s) {n : ℕ}
    (hn : n ≤ N) :
    ‖iteratedDeriv n (fun y => f y * g y) y‖ ≤ ∑ i ∈ Finset.range (n + 1),
      (n.choose i : ℝ) * ‖iteratedDeriv i f y‖ * ‖iteratedDeriv (n - i) g y‖ := by
  simp only [← norm_iteratedFDeriv_eq_norm_iteratedDeriv]
  rw [← iteratedFDerivWithin_of_isOpen _ hs hy]
  have h := norm_iteratedFDerivWithin_mul_le hf hg hs.uniqueDiffOn hy (by exact_mod_cast hn)
  refine h.trans (le_of_eq (Finset.sum_congr rfl fun i _ => ?_))
  rw [iteratedFDerivWithin_of_isOpen _ hs hy, iteratedFDerivWithin_of_isOpen _ hs hy]

