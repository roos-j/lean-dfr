    (g : ℝ × ℝ → E) :
    eLpNorm g (ENNReal.ofReal q) volume = (∫⁻ z, ENNReal.ofReal (‖g z‖ ^ q)) ^ (1 / q) := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hq) ENNReal.ofReal_ne_top,
    ENNReal.toReal_ofReal hq.le]
  congr 2
  funext z
  rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hq.le]

/-- **The partial Littlewood-Paley square function inequality** (§2.1): for `1 < q < ∞`,
`‖(∑_{m ∈ K} |Δ^{(ℓ)}_m f|^2)^{1/2}‖_q ≤ C ‖f‖_q`, uniformly in the finite set `K`, for measurable
`f` whose `ℓ`-fibers are smooth and compactly supported. -/
theorem eLpNorm_lpD_square_le (ℓ : Fin 2) {q : ℝ} (hq : 1 < q) :
    ∃ C : ℝ, 0 < C ∧ ∀ (K : Finset ℤ) (f : ℝ × ℝ → ℂ), Measurable f →
      (∀ p, ContDiff ℝ ∞ (monoFib ℓ f p)) → (∀ p, HasCompactSupport (monoFib ℓ f p)) →
      eLpNorm (fun z => √(∑ m ∈ K, ‖lpD ℓ m f z‖ ^ 2)) (ENNReal.ofReal q) volume ≤
        ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal q) volume := by
  obtain ⟨A, hA, hLP⟩ := lintegral_lpD_square_le ℓ hq
  have hq0 : 0 < q := by linarith
  refine ⟨A ^ (1 / q), by positivity, fun K f hf hs hcs => ?_⟩
  rw [eLpNorm_ofReal_eq q hq0, eLpNorm_ofReal_eq q hq0,
    ← ENNReal.ofReal_rpow_of_pos hA, ← ENNReal.mul_rpow_of_nonneg _ _ (by positivity)]
  refine ENNReal.rpow_le_rpow (le_of_eq_of_le (lintegral_congr fun z => ?_) (hLP K f hf hs hcs))
    (by positivity)
  have h0 : 0 ≤ ∑ m ∈ K, ‖lpD ℓ m f z‖ ^ 2 := Finset.sum_nonneg fun m _ => sq_nonneg _
  rw [Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _), Real.sqrt_eq_rpow, ← Real.rpow_mul h0,
    one_div_mul_eq_div]


/-! ### Test functions -/

theorem contDiff_monoFib (ℓ : Fin 2) {f : ℝ × ℝ → ℂ} (hf : ContDiff ℝ ∞ f) (p : ℝ) :
    ContDiff ℝ ∞ (monoFib ℓ f p) := by
  fin_cases ℓ
  · exact hf.comp (contDiff_id.prodMk contDiff_const)
  · exact hf.comp (contDiff_const.prodMk contDiff_id)

theorem continuous_monoAct (ℓ : Fin 2) : Continuous (monoAct ℓ) := by
  fin_cases ℓ
  · exact continuous_fst
  · exact continuous_snd

theorem hasCompactSupport_monoFib (ℓ : Fin 2) {f : ℝ × ℝ → ℂ} (hf : HasCompactSupport f)
    (p : ℝ) : HasCompactSupport (monoFib ℓ f p) := by
  refine HasCompactSupport.of_support_subset_isCompact (hf.isCompact.image (continuous_monoAct ℓ))
    fun a ha => ⟨monoPt ℓ a p, subset_tsupport _ ha, monoAct_pt ℓ a p⟩

/-- **The partial Littlewood-Paley square function inequality for test functions**. -/
theorem eLpNorm_lpD_square_le_of_testFunction (ℓ : Fin 2) {q : ℝ} (hq : 1 < q) :
    ∃ C : ℝ, 0 < C ∧ ∀ (K : Finset ℤ) (f : ℝ × ℝ → ℂ), ContDiff ℝ ∞ f → HasCompactSupport f →
      eLpNorm (fun z => √(∑ m ∈ K, ‖lpD ℓ m f z‖ ^ 2)) (ENNReal.ofReal q) volume ≤
        ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal q) volume := by
  obtain ⟨C, hC, h⟩ := eLpNorm_lpD_square_le ℓ hq
  exact ⟨C, hC, fun K f hf hcs => h K f hf.continuous.measurable (contDiff_monoFib ℓ hf)
    (hasCompactSupport_monoFib ℓ hcs)⟩


/-! ### The fattened projections `Δ̃^{(ℓ)}_m` -/

/-- Minkowski's inequality in `ℓ^2` of a finite set. -/
theorem sqrt_sum_norm_add_sq_le {ι : Type*} (s : Finset ι) (x y : ι → ℂ) :
    √(∑ i ∈ s, ‖x i + y i‖ ^ 2) ≤ √(∑ i ∈ s, ‖x i‖ ^ 2) + √(∑ i ∈ s, ‖y i‖ ^ 2) := by
  have h := norm_add_le (WithLp.toLp 2 (fun i : s => x i) : EuclideanSpace ℂ s)
    (WithLp.toLp 2 (fun i : s => y i))
  rw [← WithLp.toLp_add, EuclideanSpace.norm_eq, EuclideanSpace.norm_eq,
    EuclideanSpace.norm_eq] at h
  have e : ∀ F : ι → ℝ, ∑ i ∈ s.attach, F i = ∑ i ∈ s, F i := fun F => Finset.sum_attach s F
  simpa [e (fun i => ‖x i + y i‖ ^ 2), e (fun i => ‖x i‖ ^ 2), e (fun i => ‖y i‖ ^ 2)] using h

/-- The fattened projection `Δ̃^{(ℓ)}_m = Δ^{(ℓ)}_{m-1} + Δ^{(ℓ)}_m + Δ^{(ℓ)}_{m+1}`, the
multiplier `ψ̃(ξ_ℓ/2^m)` with `ψ̃ = ψ(2·) + ψ + ψ(·/2) = φ(·/2) - φ(4·)`. -/
def lpDfat (ℓ : Fin 2) (m : ℤ) (g : ℝ × ℝ → ℂ) : ℝ × ℝ → ℂ :=
  lpD ℓ (m - 1) g + lpD ℓ m g + lpD ℓ (m + 1) g

theorem sum_image_shift (K : Finset ℤ) (c : ℤ) (F : ℤ → ℝ) :
    ∑ m ∈ K.image (fun m => m + c), F m = ∑ m ∈ K, F (m + c) :=
  Finset.sum_image fun a _ b _ h => by simpa using h

theorem measurable_lpD_sqrt (ℓ : Fin 2) (K : Finset ℤ) {f : ℝ × ℝ → ℂ} (hf : Measurable f) :
    Measurable fun z => √(∑ m ∈ K, ‖lpD ℓ m f z‖ ^ 2) :=
  (Finset.measurable_sum _ fun m _ => ((measurable_lpD ℓ m hf).norm.pow_const 2)).sqrt

/-- **The square function inequality for the fattened projections**. -/
theorem eLpNorm_lpDfat_square_le (ℓ : Fin 2) {q : ℝ} (hq : 1 < q) :
    ∃ C : ℝ, 0 < C ∧ ∀ (K : Finset ℤ) (f : ℝ × ℝ → ℂ), Measurable f →
      (∀ p, ContDiff ℝ ∞ (monoFib ℓ f p)) → (∀ p, HasCompactSupport (monoFib ℓ f p)) →
      eLpNorm (fun z => √(∑ m ∈ K, ‖lpDfat ℓ m f z‖ ^ 2)) (ENNReal.ofReal q) volume ≤
        ENNReal.ofReal (3 * C) * eLpNorm f (ENNReal.ofReal q) volume := by
  obtain ⟨C, hC, h⟩ := eLpNorm_lpD_square_le ℓ hq
  refine ⟨C, hC, fun K f hf hs hcs => ?_⟩
  have hq1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal q := ENNReal.one_le_ofReal.2 hq.le
  set Sq : Finset ℤ → ℝ × ℝ → ℝ := fun K' z => √(∑ m ∈ K', ‖lpD ℓ m f z‖ ^ 2) with hSq
  have hpt : ∀ z, ‖√(∑ m ∈ K, ‖lpDfat ℓ m f z‖ ^ 2)‖ ≤
      Sq (K.image fun m => m + -1) z + Sq K z + Sq (K.image fun m => m + 1) z := by
    intro z
    rw [Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _)]
    simp only [hSq, sum_image_shift]
    unfold lpDfat
    simp only [Pi.add_apply]
    refine (sqrt_sum_norm_add_sq_le K _ _).trans (add_le_add_left ?_ _)
    refine (sqrt_sum_norm_add_sq_le K _ _).trans (le_of_eq ?_)
    simp only [sub_eq_add_neg]
  have hm : ∀ K', AEStronglyMeasurable (Sq K') volume := fun K' =>
    (measurable_lpD_sqrt ℓ K' hf).aestronglyMeasurable
  refine (eLpNorm_mono_real hpt).trans ?_
  refine (eLpNorm_add_le ((hm _).add (hm _)) (hm _) hq1).trans ?_
  refine (add_le_add_left (eLpNorm_add_le (hm _) (hm _) hq1) _).trans ?_
  have e3 : ENNReal.ofReal (3 * C) = ENNReal.ofReal C + ENNReal.ofReal C + ENNReal.ofReal C := by
    rw [← ENNReal.ofReal_add hC.le hC.le, ← ENNReal.ofReal_add (by positivity) hC.le]; ring_nf
  rw [e3, add_mul, add_mul]
  exact add_le_add (add_le_add (h _ f hf hs hcs) (h _ f hf hs hcs)) (h _ f hf hs hcs)


/-! ### The reproducing identity `Δ_m Δ̃_m = Δ_m` -/

/-- `ψ · (ψ(2·) + ψ + ψ(·/2)) = ψ`, since `ψ(2·) + ψ + ψ(·/2) = φ(·/2) - φ(4·) = 1` on
`supp ψ ⊆ {1/2 ≤ |x| ≤ 2}`. -/
theorem monoPsiA_mul_fat (x : ℝ) :
    monoPsiA x * (monoPsiA (2 * x) + monoPsiA x + monoPsiA (x / 2)) = monoPsiA x := by
  by_cases hx : monoPsiA x = 0
  · rw [hx, zero_mul]
  have hb := mloc_psiA_ne_zero hx
  have e : monoPsiA (2 * x) + monoPsiA x + monoPsiA (x / 2) = 1 := by
    unfold monoPsiA
    rw [show 2 * (x / 2) = x by ring, show 2 * (2 * x) = 4 * x by ring,
      monoPhi_eq_one (x := x / 2) (by rw [abs_div, abs_two]; linarith),
      monoPhi_eq_zero (x := 4 * x) (by rw [abs_mul]; norm_num; linarith)]
    ring
  rw [e, mul_one]

theorem psiMul_mul_fat (m : ℤ) (ξ : ℝ) :
    psiMul m ξ * (psiMul (m - 1) ξ + psiMul m ξ + psiMul (m + 1) ξ) = psiMul m ξ := by
  have h1 : ξ / 2 ^ (m - 1) = 2 * (ξ / 2 ^ m) := by
    rw [zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_one]; field_simp
  have h2 : ξ / 2 ^ (m + 1) = ξ / 2 ^ m / 2 := by
    rw [zpow_add_one₀ (by norm_num : (2 : ℝ) ≠ 0)]; field_simp
  unfold psiMul
  rw [h1, h2]
  exact_mod_cast congrArg (fun r : ℝ => (r : ℂ)) (monoPsiA_mul_fat (ξ / 2 ^ m))

theorem fourier_lp1DS (m : ℤ) (U : 𝓢(ℝ, ℂ)) :
    𝓕 (lp1DS m U) = SchwartzMap.smulLeftCLM ℂ (psiMul m) (𝓕 U) :=
  FourierInvPair.fourier_fourierInv_eq _

/-- The one-dimensional reproducing identity `Δ_m Δ̃_m = Δ_m` on Schwartz functions. -/
theorem lp1DS_fat (m : ℤ) (U : 𝓢(ℝ, ℂ)) :
    lp1DS m (lp1DS (m - 1) U + lp1DS m U + lp1DS (m + 1) U) = lp1DS m U := by
  unfold lp1DS
  congr 1
  ext ξ
  rw [FourierAdd.fourier_add, FourierAdd.fourier_add, ← lp1DS, ← lp1DS, ← lp1DS,
    fourier_lp1DS, fourier_lp1DS, fourier_lp1DS]
  simp only [SchwartzMap.smulLeftCLM_apply_apply (psiMul_hasTemperateGrowth _),
    add_apply, smul_eq_mul]
  rw [← add_mul, ← add_mul, ← mul_assoc, psiMul_mul_fat]

/-- **The reproducing identity** `Δ^{(ℓ)}_m Δ̃^{(ℓ)}_m f = Δ^{(ℓ)}_m f` for `f` with smooth
compactly supported `ℓ`-fibers. -/
theorem lpD_lpDfat (ℓ : Fin 2) (m : ℤ) {f : ℝ × ℝ → ℂ} (hs : ∀ p, ContDiff ℝ ∞ (monoFib ℓ f p))
    (hcs : ∀ p, HasCompactSupport (monoFib ℓ f p)) : lpD ℓ m (lpDfat ℓ m f) = lpD ℓ m f := by
  have hfib : ∀ p, monoFib ℓ (lpDfat ℓ m f) p = ⇑(lp1DS (m - 1) (fibS ℓ hs hcs p) +
      lp1DS m (fibS ℓ hs hcs p) + lp1DS (m + 1) (fibS ℓ hs hcs p)) := by
    intro p
    funext a
    simp only [add_apply, ← monoFib_lpD_eq_lp1DS ℓ _ hs hcs p]
    rfl
  have hint : ∀ p, Integrable (monoFib ℓ (lpDfat ℓ m f) p) := fun p => by
    rw [hfib]; exact SchwartzMap.integrable _
  funext z
  rw [← monoPt_act_pas ℓ z]
  change monoFib ℓ (lpD ℓ m (lpDfat ℓ m f)) (monoPas ℓ z) (monoAct ℓ z) =
    monoFib ℓ (lpD ℓ m f) (monoPas ℓ z) (monoAct ℓ z)
  rw [monoFib_lpD_eq_lp1D ℓ m hint (by rw [hfib]; exact SchwartzMap.continuous _) (by
      rw [hfib]
      exact ⟨_, Set.forall_mem_range.2 fun a => SchwartzMap.norm_le_seminorm ℂ _ a⟩),
    hfib, lp1D_eq_lp1DS, lp1DS_fat, monoFib_lpD_eq_lp1DS ℓ m hs hcs]


/-- The fattened square function inequality for test functions. -/
theorem eLpNorm_lpDfat_square_le_of_testFunction (ℓ : Fin 2) {q : ℝ} (hq : 1 < q) :
    ∃ C : ℝ, 0 < C ∧ ∀ (K : Finset ℤ) (f : ℝ × ℝ → ℂ), ContDiff ℝ ∞ f → HasCompactSupport f →
      eLpNorm (fun z => √(∑ m ∈ K, ‖lpDfat ℓ m f z‖ ^ 2)) (ENNReal.ofReal q) volume ≤
        ENNReal.ofReal (3 * C) * eLpNorm f (ENNReal.ofReal q) volume := by
  obtain ⟨C, hC, h⟩ := eLpNorm_lpDfat_square_le ℓ hq
  exact ⟨C, hC, fun K f hf hcs => h K f hf.continuous.measurable (contDiff_monoFib ℓ hf)
    (hasCompactSupport_monoFib ℓ hcs)⟩

/-- The reproducing identity for test functions. -/
theorem lpD_lpDfat_of_testFunction (ℓ : Fin 2) (m : ℤ) {f : ℝ × ℝ → ℂ} (hf : ContDiff ℝ ∞ f)
    (hcs : HasCompactSupport f) : lpD ℓ m (lpDfat ℓ m f) = lpD ℓ m f :=
  lpD_lpDfat ℓ m (contDiff_monoFib ℓ hf) (hasCompactSupport_monoFib ℓ hcs)

/-! ### Schwartz inputs on the plane -/

/-- The coordinate embedding `a ↦ a e_ℓ`. -/
def fibLin (ℓ : Fin 2) : ℝ →L[ℝ] ℝ × ℝ :=
  if ℓ = 0 then ContinuousLinearMap.inl ℝ ℝ ℝ else ContinuousLinearMap.inr ℝ ℝ ℝ

theorem fibLin_apply (ℓ : Fin 2) (a : ℝ) : fibLin ℓ a = monoEj ℓ a := by
  fin_cases ℓ <;> simp [fibLin, monoEj, monoPt]

theorem antilipschitz_fibLin (ℓ : Fin 2) : AntilipschitzWith 1 (fibLin ℓ) := by
  refine AntilipschitzWith.of_le_mul_dist fun x y => ?_
  rw [fibLin_apply, fibLin_apply]
  fin_cases ℓ <;> simp [monoEj, monoPt, Prod.dist_eq]

/-- The `ℓ`-fiber of a Schwartz function on the plane, as a Schwartz function on `ℝ`. -/
def fibSchwartz (ℓ : Fin 2) (p : ℝ) (F : 𝓢(ℝ × ℝ, ℂ)) : 𝓢(ℝ, ℂ) :=
  SchwartzMap.compCLMOfAntilipschitz ℂ (fibLin ℓ).hasTemperateGrowth (antilipschitz_fibLin ℓ)
    (SchwartzMap.compSubConstCLM ℂ (-monoPt ℓ 0 p) F)

theorem fibSchwartz_coe (ℓ : Fin 2) (p : ℝ) (F : 𝓢(ℝ × ℝ, ℂ)) :
    (fibSchwartz ℓ p F : ℝ → ℂ) = monoFib ℓ F p := by
  funext a
  simp only [fibSchwartz, SchwartzMap.compCLMOfAntilipschitz_apply, Function.comp_apply,
    SchwartzMap.compSubConstCLM_apply, sub_neg_eq_add, fibLin_apply, monoFib]
  rw [add_comm, monoPt_add_E, zero_add]


theorem monoFib_lpD_eq_of_schwartz (ℓ : Fin 2) (m : ℤ) {f : ℝ × ℝ → ℂ} (U : ℝ → 𝓢(ℝ, ℂ))
    (hU : ∀ p, (U p : ℝ → ℂ) = monoFib ℓ f p) (p : ℝ) :
    monoFib ℓ (lpD ℓ m f) p = lp1DS m (U p) := by
  rw [← lp1D_eq_lp1DS, hU]
  refine monoFib_lpD_eq_lp1D ℓ m (fun p => by rw [← hU]; exact (U p).integrable)
    (by rw [← hU]; exact (U p).continuous) ?_
  rw [← hU]
  exact ⟨_, forall_mem_range.2 fun a => SchwartzMap.norm_le_seminorm ℂ _ a⟩

/-- The integral form of the square function inequality for `f` with Schwartz fibers. -/
theorem lintegral_lpD_square_le_of_schwartzFib (ℓ : Fin 2) {q : ℝ} (hq : 1 < q) :
    ∃ A : ℝ, 0 < A ∧ ∀ (K : Finset ℤ) (f : ℝ × ℝ → ℂ), Measurable f →
      ∀ U : ℝ → 𝓢(ℝ, ℂ), (∀ p, (U p : ℝ → ℂ) = monoFib ℓ f p) →
      ∫⁻ z, ENNReal.ofReal ((∑ m ∈ K, ‖lpD ℓ m f z‖ ^ 2) ^ (q / 2)) ≤
        ENNReal.ofReal A * ∫⁻ z, ENNReal.ofReal (‖f z‖ ^ q) := by
  obtain ⟨A, hA, hLP⟩ := lp1D_littlewoodPaley hq
  refine ⟨A, hA, fun K f hf U hU => ?_⟩
  rw [lintegral_monoPt ℓ (measurable_lpD_energy ℓ K hf q), lintegral_monoPt ℓ
    (F := fun z => ENNReal.ofReal (‖f z‖ ^ q))
    (ENNReal.measurable_ofReal.comp (hf.norm.pow_const q)), ← lintegral_const_mul' _ _
    ENNReal.ofReal_ne_top]
  refine lintegral_mono fun p => ?_
  have h := hLP K (U p)
  rw [hU] at h
  refine le_of_eq_of_le (lintegral_congr fun a => ?_) h
  refine congrArg (fun x => ENNReal.ofReal (x ^ (q / 2))) (Finset.sum_congr rfl fun m _ => ?_)
  rw [← hU p, lp1D_eq_lp1DS, ← monoFib_lpD_eq_of_schwartz ℓ m U hU p]
  rfl

theorem eLpNorm_ofReal_eq' {α : Type*} [MeasurableSpace α] (μ : Measure α) (q : ℝ) (hq : 0 < q)
    {E : Type*} [NormedAddCommGroup E] (g : α → E) :
    eLpNorm g (ENNReal.ofReal q) μ = (∫⁻ z, ENNReal.ofReal (‖g z‖ ^ q) ∂μ) ^ (1 / q) := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hq) ENNReal.ofReal_ne_top,
    ENNReal.toReal_ofReal hq.le]
  congr 2
  funext z
  rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hq.le]

/-- From `∫ S^{q/2} ≤ A ∫ |f|^q` to `‖S^{1/2}‖_q ≤ A^{1/q} ‖f‖_q`. -/
theorem eLpNorm_sqrt_le_of_lintegral {α : Type*} [MeasurableSpace α] {μ : Measure α} {q A : ℝ}
    (hq : 0 < q) (hA : 0 < A) {S : α → ℝ} (hS : ∀ z, 0 ≤ S z) {f : α → ℂ}
    (h : ∫⁻ z, ENNReal.ofReal (S z ^ (q / 2)) ∂μ ≤
      ENNReal.ofReal A * ∫⁻ z, ENNReal.ofReal (‖f z‖ ^ q) ∂μ) :
    eLpNorm (fun z => √(S z)) (ENNReal.ofReal q) μ ≤
      ENNReal.ofReal (A ^ (1 / q)) * eLpNorm f (ENNReal.ofReal q) μ := by
  rw [eLpNorm_ofReal_eq' μ q hq, eLpNorm_ofReal_eq' μ q hq,
    ← ENNReal.ofReal_rpow_of_pos hA, ← ENNReal.mul_rpow_of_nonneg _ _ (by positivity)]
  refine ENNReal.rpow_le_rpow (le_of_eq_of_le (lintegral_congr fun z => ?_) h) (by positivity)
  rw [Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _), Real.sqrt_eq_rpow,
    ← Real.rpow_mul (hS z), one_div_mul_eq_div]

/-- **The square function inequality for Schwartz functions on the plane**. -/
theorem eLpNorm_lpD_square_le_of_schwartz (ℓ : Fin 2) {q : ℝ} (hq : 1 < q) :
    ∃ C : ℝ, 0 < C ∧ ∀ (K : Finset ℤ) (F : 𝓢(ℝ × ℝ, ℂ)),
      eLpNorm (fun z => √(∑ m ∈ K, ‖lpD ℓ m F z‖ ^ 2)) (ENNReal.ofReal q) volume ≤
        ENNReal.ofReal C * eLpNorm F (ENNReal.ofReal q) volume := by
  obtain ⟨A, hA, h⟩ := lintegral_lpD_square_le_of_schwartzFib ℓ hq
  refine ⟨A ^ (1 / q), by positivity, fun K F => ?_⟩
  exact eLpNorm_sqrt_le_of_lintegral (by linarith) hA
    (fun z => Finset.sum_nonneg fun m _ => sq_nonneg _)
    (h K F F.continuous.measurable (fun p => fibSchwartz ℓ p F) (fun p => fibSchwartz_coe ℓ p F))


/-! ### Rough inputs: bounded integrable functions -/

theorem memLp_of_bdd_integrable {f : ℝ × ℝ → ℂ} (hf : Measurable f) {M : ℝ}
    (hM : ∀ z, ‖f z‖ ≤ M) (hi : Integrable f) {q : ℝ} (hq : 1 ≤ q) :
    MemLp f (ENNReal.ofReal q) volume := by
  have hq0 : 0 < q := by linarith
  rw [← integrable_norm_rpow_iff hf.aestronglyMeasurable (by simpa using hq0)
    ENNReal.ofReal_ne_top, ENNReal.toReal_ofReal hq0.le]
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  refine (hi.norm.const_mul (M ^ (q - 1))).mono' (hf.norm.pow_const q).aestronglyMeasurable
    (Eventually.of_forall fun z => ?_)
  rw [Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)]
  calc ‖f z‖ ^ q = ‖f z‖ ^ (q - 1) * ‖f z‖ ^ (1 : ℝ) := by
        rw [← Real.rpow_add' (norm_nonneg _) (by linarith)]; ring_nf
    _ ≤ M ^ (q - 1) * ‖f z‖ := by
        rw [Real.rpow_one]
        exact mul_le_mul_of_nonneg_right (Real.rpow_le_rpow (norm_nonneg _) (hM z)
          (by linarith)) (norm_nonneg _)

/-- Schwartz functions are dense in `L^q(ℝ^2)`, `1 ≤ q < ∞`. -/
theorem exists_schwartz_eLpNorm_sub_le {g : ℝ × ℝ → ℂ} {q : ℝ} (hq : 1 ≤ q)
    (hg : MemLp g (ENNReal.ofReal q) volume) {δ : ℝ≥0∞} (hδ : 0 < δ) :
    ∃ F : 𝓢(ℝ × ℝ, ℂ), eLpNorm (g - ⇑F) (ENNReal.ofReal q) volume ≤ δ := by
  haveI : Fact (1 ≤ ENNReal.ofReal q) := ⟨ENNReal.one_le_ofReal.2 hq⟩
  obtain ⟨r, hr0, hr, hrδ⟩ := ENNReal.lt_iff_exists_real_btwn.1 hδ
  have hrpos : 0 < r := by
    by_contra h; push Not at h; rw [ENNReal.ofReal_of_nonpos h] at hr; exact lt_irrefl _ hr
  obtain ⟨F, hF⟩ := (SchwartzMap.denseRange_toLpCLM (E := ℝ × ℝ) (F := ℂ)
    ENNReal.ofReal_ne_top (μ := volume)).exists_dist_lt (hg.toLp g) hrpos
  refine ⟨F, ?_⟩
  rw [SchwartzMap.toLpCLM_apply, ← edist_lt_ofReal] at hF
  have e : edist (hg.toLp g) (F.toLp (ENNReal.ofReal q) volume) =
      eLpNorm (g - ⇑F) (ENNReal.ofReal q) volume :=
    Lp.edist_toLp_toLp g F hg (F.memLp _ _)
  rw [e] at hF
  exact (hF.trans hrδ).le


/-- Young's inequality for `Δ^{(ℓ)}_m`: `‖Δ^{(ℓ)}_m g‖_q ≤ 2 ‖κ‖_1 ‖g‖_q`. -/
theorem eLpNorm_lpD_le_q (ℓ : Fin 2) (m : ℤ) {g : ℝ × ℝ → ℂ} (hg : Measurable g) {q : ℝ}
    (hq : 1 < q) : eLpNorm (lpD ℓ m g) (ENNReal.ofReal q) volume ≤
      2 * (∫⁻ s, ‖monoKPhi s‖ₑ) * eLpNorm g (ENNReal.ofReal q) volume := by
  have hq1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal q := ENNReal.one_le_ofReal.2 hq.le
  have hqr : 1 < (ENNReal.ofReal q).toReal := by rwa [ENNReal.toReal_ofReal (by linarith)]
  unfold lpD
  refine (eLpNorm_sub_le (measurable_lpS ℓ m hg).aestronglyMeasurable
    (measurable_lpS ℓ (m - 1) hg).aestronglyMeasurable hq1).trans ?_
  unfold lpS
  rw [two_mul, add_mul]
  exact add_le_add (ms7_P_young ℓ monoKPhi (by positivity) hqr hg)
    (ms7_P_young ℓ monoKPhi (by positivity) hqr hg)

theorem sqrt_sum_sq_le_sum {ι : Type*} (s : Finset ι) {a : ι → ℝ} (ha : ∀ i, 0 ≤ a i) :
    √(∑ i ∈ s, a i ^ 2) ≤ ∑ i ∈ s, a i := by
  rw [Real.sqrt_le_left (Finset.sum_nonneg fun i _ => ha i)]
  exact Finset.sum_sq_le_sq_sum_of_nonneg fun i _ => ha i


/-- **The partial Littlewood-Paley square function inequality for bounded integrable `f`**:
for `1 < q < ∞`, `‖(∑_{m ∈ K} |Δ^{(ℓ)}_m f|^2)^{1/2}‖_q ≤ C ‖f‖_q` uniformly in the finite set `K`,
for measurable bounded integrable `f` (by Schwartz approximation in `L^q`, the Schwartz case, and
Young's inequality for each `Δ^{(ℓ)}_m`). -/
theorem eLpNorm_lpD_square_le_of_bdd (ℓ : Fin 2) {q : ℝ} (hq : 1 < q) :
    ∃ C : ℝ, 0 < C ∧ ∀ (K : Finset ℤ) (f : ℝ × ℝ → ℂ), Measurable f →
      (∃ M, ∀ z, ‖f z‖ ≤ M) → Integrable f →
      eLpNorm (fun z => √(∑ m ∈ K, ‖lpD ℓ m f z‖ ^ 2)) (ENNReal.ofReal q) volume ≤
        ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal q) volume := by
  obtain ⟨C, hC, hS⟩ := eLpNorm_lpD_square_le_of_schwartz ℓ hq
  refine ⟨C, hC, fun K f hf ⟨M, hM⟩ hi => ?_⟩
  have hq1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal q := ENNReal.one_le_ofReal.2 hq.le
  have hKn : (∫⁻ s, ‖monoKPhi s‖ₑ) ≠ ⊤ := (ms7_kerL1_lt_top monoKPhi).ne
  have hB : ENNReal.ofReal C + K.card * (2 * ∫⁻ s, ‖monoKPhi s‖ₑ) ≠ ⊤ :=
    ENNReal.add_ne_top.2 ⟨ENNReal.ofReal_ne_top, ENNReal.mul_ne_top (ENNReal.natCast_ne_top _)
      (ENNReal.mul_ne_top ENNReal.ofNat_ne_top hKn)⟩
  refine ENNReal.le_of_forall_pos_le_add fun ε hε _ => ?_
  obtain ⟨F, hF⟩ := exists_schwartz_eLpNorm_sub_le hq.le (memLp_of_bdd_integrable hf hM hi hq.le)
    (δ := (ε : ℝ≥0∞) / (ENNReal.ofReal C + K.card * (2 * ∫⁻ s, ‖monoKPhi s‖ₑ) + 1))
    (ENNReal.div_pos (by exact_mod_cast hε.ne') (ENNReal.add_ne_top.2 ⟨hB, ENNReal.one_ne_top⟩))
  have hFm : Measurable F := F.continuous.measurable
  have hGm : Measurable (f - ⇑F) := hf.sub hFm
  have hFb : ∀ z, ‖F z‖ ≤ SchwartzMap.seminorm ℂ 0 0 F := SchwartzMap.norm_le_seminorm ℂ F
  have hGb : ∀ z, ‖(f - ⇑F) z‖ ≤ M + SchwartzMap.seminorm ℂ 0 0 F := fun z =>
    (norm_sub_le _ _).trans (add_le_add (hM z) (hFb z))
  have hsplit : ∀ m, lpD ℓ m f = lpD ℓ m F + lpD ℓ m (f - ⇑F) := fun m => by
    rw [← lpD_add ℓ m hFm hGm hFb hGb, add_sub_cancel]
  have hpt : ∀ z, ‖√(∑ m ∈ K, ‖lpD ℓ m f z‖ ^ 2)‖ ≤
      √(∑ m ∈ K, ‖lpD ℓ m F z‖ ^ 2) + ∑ m ∈ K, ‖lpD ℓ m (f - ⇑F) z‖ := by
    intro z
    rw [Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _)]
    simp only [hsplit, Pi.add_apply]
    refine (sqrt_sum_norm_add_sq_le K _ _).trans ?_
    gcongr
    exact sqrt_sum_sq_le_sum K fun m => norm_nonneg _
  have hmS : AEStronglyMeasurable (fun z => √(∑ m ∈ K, ‖lpD ℓ m F z‖ ^ 2)) volume :=
    (measurable_lpD_sqrt ℓ K hFm).aestronglyMeasurable
  have hmG : AEStronglyMeasurable (fun z => ∑ m ∈ K, ‖lpD ℓ m (f - ⇑F) z‖) volume :=
    (Finset.measurable_sum _ fun m _ => (measurable_lpD ℓ m hGm).norm).aestronglyMeasurable
  have hsum : eLpNorm (fun z => ∑ m ∈ K, ‖lpD ℓ m (f - ⇑F) z‖) (ENNReal.ofReal q) volume ≤
      ∑ m ∈ K, eLpNorm (fun z => ‖lpD ℓ m (f - ⇑F) z‖) (ENNReal.ofReal q) volume := by
    have h := eLpNorm_sum_le (f := fun m z => ‖lpD ℓ m (f - ⇑F) z‖) (s := K) (μ := volume)
      (fun m _ => (measurable_lpD ℓ m hGm).norm.aestronglyMeasurable) hq1
    convert h using 2
    funext z
    simp [Finset.sum_apply]
  have hYoung : ∀ m, eLpNorm (fun z => ‖lpD ℓ m (f - ⇑F) z‖) (ENNReal.ofReal q) volume ≤
      2 * (∫⁻ s, ‖monoKPhi s‖ₑ) *
        ((ε : ℝ≥0∞) / (ENNReal.ofReal C + K.card * (2 * ∫⁻ s, ‖monoKPhi s‖ₑ) + 1)) := fun m => by
    rw [eLpNorm_norm]; refine (eLpNorm_lpD_le_q ℓ m hGm hq).trans ?_; gcongr
  have hFn : eLpNorm F (ENNReal.ofReal q) volume ≤ eLpNorm f (ENNReal.ofReal q) volume +
      (ε : ℝ≥0∞) / (ENNReal.ofReal C + K.card * (2 * ∫⁻ s, ‖monoKPhi s‖ₑ) + 1) := by
    have h := eLpNorm_sub_le (μ := volume) hf.aestronglyMeasurable hGm.aestronglyMeasurable hq1
    rw [sub_sub_cancel] at h
    exact h.trans (by gcongr)
  have hBδ : (ENNReal.ofReal C + K.card * (2 * ∫⁻ s, ‖monoKPhi s‖ₑ)) *
      ((ε : ℝ≥0∞) / (ENNReal.ofReal C + K.card * (2 * ∫⁻ s, ‖monoKPhi s‖ₑ) + 1)) ≤ ε :=
    (mul_le_mul_of_nonneg_right le_self_add zero_le).trans ENNReal.mul_div_le
  calc eLpNorm (fun z => √(∑ m ∈ K, ‖lpD ℓ m f z‖ ^ 2)) (ENNReal.ofReal q) volume
      ≤ eLpNorm (fun z => √(∑ m ∈ K, ‖lpD ℓ m F z‖ ^ 2) + ∑ m ∈ K, ‖lpD ℓ m (f - ⇑F) z‖)
          (ENNReal.ofReal q) volume := eLpNorm_mono_real hpt
    _ ≤ eLpNorm (fun z => √(∑ m ∈ K, ‖lpD ℓ m F z‖ ^ 2)) (ENNReal.ofReal q) volume +
          eLpNorm (fun z => ∑ m ∈ K, ‖lpD ℓ m (f - ⇑F) z‖) (ENNReal.ofReal q) volume :=
        eLpNorm_add_le hmS hmG hq1
    _ ≤ ENNReal.ofReal C * eLpNorm F (ENNReal.ofReal q) volume + ∑ _m ∈ K, 2 *
          (∫⁻ s, ‖monoKPhi s‖ₑ) *
          ((ε : ℝ≥0∞) / (ENNReal.ofReal C + K.card * (2 * ∫⁻ s, ‖monoKPhi s‖ₑ) + 1)) :=
        add_le_add (hS K F) (hsum.trans (Finset.sum_le_sum fun m _ => hYoung m))
    _ ≤ ENNReal.ofReal C * (eLpNorm f (ENNReal.ofReal q) volume +
          (ε : ℝ≥0∞) / (ENNReal.ofReal C + K.card * (2 * ∫⁻ s, ‖monoKPhi s‖ₑ) + 1)) +
          K.card * (2 * (∫⁻ s, ‖monoKPhi s‖ₑ) *
          ((ε : ℝ≥0∞) / (ENNReal.ofReal C + K.card * (2 * ∫⁻ s, ‖monoKPhi s‖ₑ) + 1))) := by
        rw [Finset.sum_const, nsmul_eq_mul]; gcongr
    _ = ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal q) volume +
          (ENNReal.ofReal C + K.card * (2 * ∫⁻ s, ‖monoKPhi s‖ₑ)) *
          ((ε : ℝ≥0∞) / (ENNReal.ofReal C + K.card * (2 * ∫⁻ s, ‖monoKPhi s‖ₑ) + 1)) := by ring
    _ ≤ ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal q) volume + ε := by gcongr


/-- The fattened square function bound from the square function bounds for all finite sets. -/
theorem eLpNorm_lpDfat_square_le_of_forall (ℓ : Fin 2) {f : ℝ × ℝ → ℂ} (hf : Measurable f)
    {q C : ℝ} (hq : 1 < q) (hC : 0 < C) (h : ∀ K' : Finset ℤ,
      eLpNorm (fun z => √(∑ m ∈ K', ‖lpD ℓ m f z‖ ^ 2)) (ENNReal.ofReal q) volume ≤
        ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal q) volume) (K : Finset ℤ) :
    eLpNorm (fun z => √(∑ m ∈ K, ‖lpDfat ℓ m f z‖ ^ 2)) (ENNReal.ofReal q) volume ≤
      ENNReal.ofReal (3 * C) * eLpNorm f (ENNReal.ofReal q) volume := by
  have hq1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal q := ENNReal.one_le_ofReal.2 hq.le
  set Sq : Finset ℤ → ℝ × ℝ → ℝ := fun K' z => √(∑ m ∈ K', ‖lpD ℓ m f z‖ ^ 2) with hSq
  have hpt : ∀ z, ‖√(∑ m ∈ K, ‖lpDfat ℓ m f z‖ ^ 2)‖ ≤
      Sq (K.image fun m => m + -1) z + Sq K z + Sq (K.image fun m => m + 1) z := by
    intro z
    rw [Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _)]
    simp only [hSq, sum_image_shift]
    unfold lpDfat
    simp only [Pi.add_apply]
    refine (sqrt_sum_norm_add_sq_le K _ _).trans ?_
    gcongr
    refine (sqrt_sum_norm_add_sq_le K _ _).trans (le_of_eq ?_)
    simp only [sub_eq_add_neg]
  have hm : ∀ K', AEStronglyMeasurable (Sq K') volume := fun K' =>
    (measurable_lpD_sqrt ℓ K' hf).aestronglyMeasurable
  refine (eLpNorm_mono_real hpt).trans ?_
  refine (eLpNorm_add_le ((hm _).add (hm _)) (hm _) hq1).trans ?_
  refine (add_le_add_left (eLpNorm_add_le (hm _) (hm _) hq1) _).trans ?_
  have e3 : ENNReal.ofReal (3 * C) = ENNReal.ofReal C + ENNReal.ofReal C + ENNReal.ofReal C := by
    rw [← ENNReal.ofReal_add hC.le hC.le, ← ENNReal.ofReal_add (by positivity) hC.le]; ring_nf
  rw [e3, add_mul, add_mul]
  exact add_le_add (add_le_add (h _) (h _)) (h _)

/-- **The fattened square function inequality for bounded integrable `f`**. -/
theorem eLpNorm_lpDfat_square_le_of_bdd (ℓ : Fin 2) {q : ℝ} (hq : 1 < q) :
    ∃ C : ℝ, 0 < C ∧ ∀ (K : Finset ℤ) (f : ℝ × ℝ → ℂ), Measurable f →
      (∃ M, ∀ z, ‖f z‖ ≤ M) → Integrable f →
      eLpNorm (fun z => √(∑ m ∈ K, ‖lpDfat ℓ m f z‖ ^ 2)) (ENNReal.ofReal q) volume ≤
        ENNReal.ofReal (3 * C) * eLpNorm f (ENNReal.ofReal q) volume := by
  obtain ⟨C, hC, h⟩ := eLpNorm_lpD_square_le_of_bdd ℓ hq
  exact ⟨C, hC, fun K f hf hM hi =>
    eLpNorm_lpDfat_square_le_of_forall ℓ hf hq hC (fun K' => h K' f hf hM hi) K⟩

/-! ### The reproducing identity for rough inputs -/

theorem fourier_add_of_integrable {f g : ℝ → ℂ} (hf : Integrable f volume)
    (hg : Integrable g volume) (ξ : ℝ) : 𝓕 (fun x => f x + g x) ξ = 𝓕 f ξ + 𝓕 g ξ := by
  simp only [Real.fourier_real_eq, smul_add]
  exact integral_add ((Real.fourierIntegral_convergent_iff ξ).2 hf |>.congr
    (Eventually.of_forall fun x => by simp [mul_comm]))
    ((Real.fourierIntegral_convergent_iff ξ).2 hg |>.congr
      (Eventually.of_forall fun x => by simp [mul_comm]))

theorem integrable_fib_lpS_of (ℓ : Fin 2) (m : ℤ) {g : ℝ × ℝ → ℂ} {p : ℝ}
    (hu : Integrable (monoFib ℓ g p)) : Integrable (monoFib ℓ (lpS ℓ m g) p) := by
  unfold lpS
  rw [mloc_P_fib]
  exact (mloc_integrable_dil monoKPhi (by positivity)).integrable_convolution _ hu

theorem integrable_fib_lpD_of (ℓ : Fin 2) (m : ℤ) {g : ℝ × ℝ → ℂ} {p : ℝ}
    (hu : Integrable (monoFib ℓ g p)) : Integrable (monoFib ℓ (lpD ℓ m g) p) :=
  (integrable_fib_lpS_of ℓ m hu).sub (integrable_fib_lpS_of ℓ (m - 1) hu)

theorem fourier_fib_lpD_of (ℓ : Fin 2) (m : ℤ) {g : ℝ × ℝ → ℂ} {p : ℝ}
    (hu : Integrable (monoFib ℓ g p)) (ξ : ℝ) :
    𝓕 (monoFib ℓ (lpD ℓ m g) p) ξ = psiMul m ξ * 𝓕 (monoFib ℓ g p) ξ := by
  rw [monoFib_lpD]
  rw [show monoFib ℓ (lpS ℓ m g) p - monoFib ℓ (lpS ℓ (m - 1) g) p =
    fun x => monoFib ℓ (lpS ℓ m g) p x - monoFib ℓ (lpS ℓ (m - 1) g) p x from rfl,
    fourier_sub' (integrable_fib_lpS_of ℓ m hu) (integrable_fib_lpS_of ℓ (m - 1) hu)]
  unfold lpS monoKPhi
  rw [mloc_P_fib_fourier ℓ monoPhi_contDiff monoPhi_hasCompactSupport (by positivity) hu,
    mloc_P_fib_fourier ℓ monoPhi_contDiff monoPhi_hasCompactSupport (by positivity) hu,
    ← sub_mul, psiMul, monoPsiA]
  congr 1
  push_cast
  congr 2
  rw [zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_one]; field_simp

theorem bddAbove_kerScaled (m : ℤ) :
    BddAbove (range fun s => ‖(((2 : ℝ) ^ m : ℝ) : ℂ) * monoKPhi ((2 : ℝ) ^ m * s)‖) := by
  refine ⟨(2 : ℝ) ^ m * SchwartzMap.seminorm ℂ 0 0 monoKPhi, forall_mem_range.2 fun s => ?_⟩
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
  exact mul_le_mul_of_nonneg_left (SchwartzMap.norm_le_seminorm ℂ _ _) (by positivity)

theorem continuous_fib_lpS_of (ℓ : Fin 2) (m : ℤ) {g : ℝ × ℝ → ℂ} {p : ℝ}
    (hu : Integrable (monoFib ℓ g p)) : Continuous (monoFib ℓ (lpS ℓ m g) p) := by
  unfold lpS
  rw [mloc_P_fib]
  exact (bddAbove_kerScaled m).continuous_convolution_left_of_integrable _
    (continuous_const.mul (monoKPhi.continuous.comp (continuous_const.mul continuous_id))) hu

/-- The fibers of `Δ^{(ℓ)}_m g` through an integrable fiber `u` are `𝓕⁻¹(ψ(·/2^m) 𝓕 u)`. -/
theorem monoFib_lpD_eq_lp1D_of (ℓ : Fin 2) (m : ℤ) {g : ℝ × ℝ → ℂ} {p : ℝ}
    (hu : Integrable (monoFib ℓ g p)) :
    monoFib ℓ (lpD ℓ m g) p = lp1D m (monoFib ℓ g p) := by
  have hF : 𝓕 (monoFib ℓ (lpD ℓ m g) p) = fun ξ => psiMul m ξ * 𝓕 (monoFib ℓ g p) ξ :=
    funext (fourier_fib_lpD_of ℓ m hu)
  have hFint : Integrable (𝓕 (monoFib ℓ (lpD ℓ m g) p)) := by
    rw [hF]
    exact ((psiMul_contDiff m).continuous.mul (continuous_fourier_real hu)
      ).integrable_of_hasCompactSupport (psiMul_hasCompactSupport m).mul_right
  have hcont : Continuous (monoFib ℓ (lpD ℓ m g) p) :=
    (continuous_fib_lpS_of ℓ m hu).sub (continuous_fib_lpS_of ℓ (m - 1) hu)
  rw [← hcont.fourierInv_fourier_eq (integrable_fib_lpD_of ℓ m hu) hFint, hF]
  rfl

/-- The reproducing identity on one fiber: if the `p`-fiber of `f` is integrable, then the
`p`-fibers of `Δ^{(ℓ)}_m Δ̃^{(ℓ)}_m f` and `Δ^{(ℓ)}_m f` coincide. -/
theorem monoFib_lpD_lpDfat (ℓ : Fin 2) (m : ℤ) {f : ℝ × ℝ → ℂ} {p : ℝ}
    (hu : Integrable (monoFib ℓ f p)) :
    monoFib ℓ (lpD ℓ m (lpDfat ℓ m f)) p = monoFib ℓ (lpD ℓ m f) p := by
  have h1 := integrable_fib_lpD_of ℓ (m - 1) hu
  have h2 := integrable_fib_lpD_of ℓ m hu
  have h3 := integrable_fib_lpD_of ℓ (m + 1) hu
  have hfat : Integrable (monoFib ℓ (lpDfat ℓ m f) p) := (h1.add h2).add h3
  rw [monoFib_lpD_eq_lp1D_of ℓ m hfat, monoFib_lpD_eq_lp1D_of ℓ m hu]
  unfold lp1D
  refine congrArg (fun F : ℝ → ℂ => 𝓕⁻ F) (funext fun ξ => ?_)
  have e : monoFib ℓ (lpDfat ℓ m f) p = fun x => (monoFib ℓ (lpD ℓ (m - 1) f) p +
      monoFib ℓ (lpD ℓ m f) p) x + monoFib ℓ (lpD ℓ (m + 1) f) p x := rfl
  have e2 : 𝓕 (monoFib ℓ (lpD ℓ (m - 1) f) p + monoFib ℓ (lpD ℓ m f) p) ξ =
      𝓕 (monoFib ℓ (lpD ℓ (m - 1) f) p) ξ + 𝓕 (monoFib ℓ (lpD ℓ m f) p) ξ :=
    fourier_add_of_integrable h1 h2 ξ
  rw [e, fourier_add_of_integrable (h1.add h2) h3, e2,
    fourier_fib_lpD_of ℓ _ hu, fourier_fib_lpD_of ℓ _ hu, fourier_fib_lpD_of ℓ _ hu,
    ← add_mul, ← add_mul, ← mul_assoc]
  change psiMul m ξ * _ * _ = psiMul m ξ * _
  rw [psiMul_mul_fat]

/-- **The reproducing identity, everywhere**, for `f` all of whose `ℓ`-fibers are integrable. -/
theorem lpD_lpDfat_of_fibInt (ℓ : Fin 2) (m : ℤ) {f : ℝ × ℝ → ℂ}
    (hint : ∀ p, Integrable (monoFib ℓ f p)) : lpD ℓ m (lpDfat ℓ m f) = lpD ℓ m f := by
  funext z
  rw [← monoPt_act_pas ℓ z]
  exact congrFun (monoFib_lpD_lpDfat ℓ m (hint (monoPas ℓ z))) (monoAct ℓ z)

theorem measurable_lpDfat (ℓ : Fin 2) (m : ℤ) {f : ℝ × ℝ → ℂ} (hf : Measurable f) :
    Measurable (lpDfat ℓ m f) :=
  ((measurable_lpD ℓ _ hf).add (measurable_lpD ℓ _ hf)).add (measurable_lpD ℓ _ hf)

/-- Almost every fiber of an integrable function is integrable. -/
theorem ae_integrable_monoFib (ℓ : Fin 2) {f : ℝ × ℝ → ℂ} (hf : Measurable f)
    (hi : Integrable f) : ∀ᵐ p, Integrable (monoFib ℓ f p) := by
  have hm : Measurable fun p => ∫⁻ a, ‖f (monoPt ℓ a p)‖ₑ :=
    Measurable.lintegral_prod_right' (f := fun q : ℝ × ℝ => ‖f (monoPt ℓ q.2 q.1)‖ₑ)
      (hf.comp ((measurable_monoPt ℓ).comp (measurable_snd.prodMk measurable_fst))).enorm
  have hfin : ∫⁻ p, ∫⁻ a, ‖f (monoPt ℓ a p)‖ₑ < ⊤ := by
    rw [← lintegral_monoPt ℓ (F := fun z => ‖f z‖ₑ) hf.enorm]; exact hi.hasFiniteIntegral
  filter_upwards [ae_lt_top hm hfin.ne] with p hp
  exact ⟨(measurable_monoFib hf p).aestronglyMeasurable, hp⟩

/-- **The reproducing identity, almost everywhere**, for measurable integrable `f`; it holds at
every point `z` whose `ℓ`-fiber of `f` is integrable. -/
theorem lpD_lpDfat_ae (ℓ : Fin 2) (m : ℤ) {f : ℝ × ℝ → ℂ} (hf : Measurable f)
    (hi : Integrable f) : lpD ℓ m (lpDfat ℓ m f) =ᵐ[volume] lpD ℓ m f := by
  have hA := measurable_lpD ℓ m (measurable_lpDfat ℓ m hf)
  have hB := measurable_lpD ℓ m hf
  have hE : MeasurableSet {z | lpD ℓ m (lpDfat ℓ m f) z ≠ lpD ℓ m f z} :=
    (measurableSet_eq_fun hA hB).compl
  rw [EventuallyEq, ae_iff, ← lintegral_indicator_one hE,
    lintegral_monoPt ℓ (F := {z | lpD ℓ m (lpDfat ℓ m f) z ≠ lpD ℓ m f z}.indicator 1)
      (measurable_one.indicator hE)]
  refine (lintegral_congr_ae ?_).trans lintegral_zero
  filter_upwards [ae_integrable_monoFib ℓ hf hi] with p hp
  refine (lintegral_congr fun a => ?_).trans lintegral_zero
  have h := congrFun (monoFib_lpD_lpDfat ℓ m hp) a
  simp only [monoFib] at h
  simp [h]

/-- **The reproducing identity for bounded integrable `f`**, almost everywhere. -/
theorem lpD_lpDfat_of_bdd (ℓ : Fin 2) (m : ℤ) {f : ℝ × ℝ → ℂ} (hf : Measurable f)
    (hi : Integrable f) : lpD ℓ m (lpDfat ℓ m f) =ᵐ[volume] lpD ℓ m f :=
  lpD_lpDfat_ae ℓ m hf hi

end
