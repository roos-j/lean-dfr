  have h := hLP K (fibS ℓ hs hcs p)
  rw [fibS_coe] at h
  refine le_of_eq_of_le (lintegral_congr fun a => ?_) h
  refine congrArg (fun x => ENNReal.ofReal (x ^ (q / 2))) (Finset.sum_congr rfl fun m _ => ?_)
  change _ = ‖lp1D m (fibS ℓ hs hcs p) a‖ ^ 2
  rw [lp1D_eq_lp1DS, ← monoFib_lpD_eq_lp1DS ℓ m hs hcs p]
  rfl

