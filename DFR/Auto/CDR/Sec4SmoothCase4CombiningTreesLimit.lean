/-! ### The collection of all rectangles of a box -/

/-- The number of rectangles of level `l` per half side: `M 2^{(K₂-l)α}`. -/
def boxIndex (α : ℕ) (K₂ l : ℤ) (M : ℕ) : ℤ := M * 2 ^ ((K₂ - l).toNat * α)

/-- The half side `M 2^{K₂ α}` of the box `[-M 2^{K₂α}, M 2^{K₂α}) × [-M 2^{K₂β}, M 2^{K₂β})`. -/
def boxX (α : ℕ) (K₂ : ℤ) (M : ℕ) : ℝ := M * (2 : ℝ) ^ (K₂ * α)

/-- All dyadic rectangles `⟨l, m, n⟩` with `K₁ ≤ l ≤ K₂`, `-M 2^{(K₂-l)α} ≤ m < M 2^{(K₂-l)α}`,
`-M 2^{(K₂-l)β} ≤ n < M 2^{(K₂-l)β}`; at each level they tile the box
`[-M 2^{K₂α}, M 2^{K₂α}) × [-M 2^{K₂β}, M 2^{K₂β})`. -/
def boxColl (α β : ℕ) (K₁ K₂ : ℤ) (M : ℕ) : Finset DyRect :=
  (Finset.Icc K₁ K₂).biUnion fun l =>
    (Finset.Ico (-boxIndex α K₂ l M) (boxIndex α K₂ l M) ×ˢ
      Finset.Ico (-boxIndex β K₂ l M) (boxIndex β K₂ l M)).image
        fun mn => (⟨l, mn.1, mn.2⟩ : DyRect)

theorem mem_boxColl {α β : ℕ} {K₁ K₂ : ℤ} {M : ℕ} {Q : DyRect} :
    Q ∈ boxColl α β K₁ K₂ M ↔ K₁ ≤ Q.lev ∧ Q.lev ≤ K₂ ∧
      -((M : ℤ) * 2 ^ ((K₂ - Q.lev).toNat * α)) ≤ Q.m ∧ Q.m < M * 2 ^ ((K₂ - Q.lev).toNat * α) ∧
      -((M : ℤ) * 2 ^ ((K₂ - Q.lev).toNat * β)) ≤ Q.n ∧ Q.n < M * 2 ^ ((K₂ - Q.lev).toNat * β) := by
  simp only [boxColl, boxIndex, Finset.mem_biUnion, Finset.mem_Icc, Finset.mem_image,
    Finset.mem_product, Finset.mem_Ico, Prod.exists]
  constructor
  · rintro ⟨l, hl, m, n, h, rfl⟩
    exact ⟨hl.1, hl.2, h.1.1, h.1.2, h.2.1, h.2.2⟩
  · rintro ⟨h1, h2, h3, h4, h5, h6⟩
    exact ⟨Q.lev, ⟨h1, h2⟩, Q.m, Q.n, ⟨⟨h3, h4⟩, h5, h6⟩, rfl⟩

theorem boxIndex_mul {α : ℕ} {K₂ l : ℤ} (M : ℕ) (hl : l ≤ K₂) :
    (boxIndex α K₂ l M : ℝ) * (2 : ℝ) ^ (l * α) = boxX α K₂ M := by
  unfold boxIndex boxX
  push_cast
  rw [mul_assoc, ← zpow_natCast, ← zpow_add₀ (by norm_num)]
  congr 2
  rw [Nat.cast_mul, Int.toNat_of_nonneg (by omega)]
  ring

/-! ### One-dimensional tiling by intervals `[m s, m s + s)` -/

theorem exists_Ico_tile {s : ℝ} (hs : 0 < s) {A : ℤ} {p : ℝ}
    (hp : p ∈ Ico (-(A * s)) (A * s)) :
    ∃ m : ℤ, -A ≤ m ∧ m < A ∧ p ∈ Ico (m * s) (m * s + s) := by
  refine ⟨⌊p / s⌋, ?_, ?_, ?_, ?_⟩
  · rw [Int.le_floor, le_div_iff₀ hs]; push_cast; linarith [hp.1]
  · rw [Int.floor_lt, div_lt_iff₀ hs]; exact hp.2
  · have := Int.floor_le (p / s)
    rw [le_div_iff₀ hs] at this; exact this
  · have := Int.lt_floor_add_one (p / s)
    rw [div_lt_iff₀ hs] at this; linarith

theorem Ico_tile_subset {s : ℝ} (hs : 0 < s) {A m : ℤ} (h1 : -A ≤ m) (h2 : m < A) :
    Ico ((m : ℝ) * s) (m * s + s) ⊆ Ico (-(A * s)) (A * s) := by
  have e1 : (-A : ℝ) ≤ m := by exact_mod_cast h1
  have e2 : (m : ℝ) + 1 ≤ A := by exact_mod_cast h2
  intro p hp
  constructor
  · nlinarith [hp.1]
  · nlinarith [hp.2]

theorem Ico_tile_bounds {s : ℝ} (hs : 0 < s) {A m : ℤ}
    (h : Ico ((m : ℝ) * s) (m * s + s) ⊆ Ico (-(A * s)) (A * s)) : -A ≤ m ∧ m < A := by
  have h0 := h ⟨le_refl _, by linarith⟩
  have e1 : (-A : ℝ) ≤ m := by
    have := h0.1; rw [neg_mul_eq_neg_mul] at this
    exact le_of_mul_le_mul_right this hs
  have e2 : (m : ℝ) + 1 ≤ A := by
    by_contra hc
    push Not at hc
    have hmem : max ((m : ℝ) * s) (A * s) ∈ Ico ((m : ℝ) * s) (m * s + s) :=
      ⟨le_max_left _ _, max_lt (by linarith) (by nlinarith)⟩
    have := (h hmem).2
    linarith [le_max_right ((m : ℝ) * s) (A * s)]
  exact ⟨by exact_mod_cast e1, by exact_mod_cast (by linarith : (m : ℝ) < A)⟩

theorem Ico_tile_disjoint {s : ℝ} (hs : 0 < s) {m m' : ℤ} (h : m ≠ m') :
    Disjoint (Ico ((m : ℝ) * s) (m * s + s)) (Ico ((m' : ℝ) * s) (m' * s + s)) := by
  rw [Set.disjoint_left]
  intro p hp hp'
  have a1 : (m : ℝ) < m' + 1 := by
    by_contra hc; push Not at hc; nlinarith [hp.1, hp'.2]
  have a2 : (m' : ℝ) < m + 1 := by
    by_contra hc; push Not at hc; nlinarith [hp'.1, hp.2]
  have b1 : m < m' + 1 := by exact_mod_cast a1
  have b2 : m' < m + 1 := by exact_mod_cast a2
  omega

/-! ### Membership in the box collection -/

theorem DyRect.ix_eq_box (α : ℕ) (Q : DyRect) :
    Q.ix α = Ico ((Q.m : ℝ) * Q.sx α) (Q.m * Q.sx α + Q.sx α) := rfl

theorem DyRect.iy_eq_box (β : ℕ) (Q : DyRect) :
    Q.iy β = Ico ((Q.n : ℝ) * Q.sy β) (Q.n * Q.sy β + Q.sy β) := rfl

/-- The box `[-M 2^{K₂α}, M 2^{K₂α}) × [-M 2^{K₂β}, M 2^{K₂β})`. -/
def boxRegion (α β : ℕ) (K₂ : ℤ) (M : ℕ) : Set (ℝ × ℝ) :=
  Ico (-boxX α K₂ M) (boxX α K₂ M) ×ˢ Ico (-boxX β K₂ M) (boxX β K₂ M)

theorem toSet_subset_boxRegion {α β : ℕ} {K₁ K₂ : ℤ} {M : ℕ} {Q : DyRect}
    (hQ : Q ∈ boxColl α β K₁ K₂ M) : Q.toSet α β ⊆ boxRegion α β K₂ M := by
  obtain ⟨_, h2, h3, h4, h5, h6⟩ := mem_boxColl.1 hQ
  unfold DyRect.toSet boxRegion
  refine Set.prod_mono ?_ ?_
  · rw [DyRect.ix_eq_box, ← boxIndex_mul M h2]
    exact Ico_tile_subset (Q.sx_pos α) h3 h4
  · rw [DyRect.iy_eq_box, ← boxIndex_mul M h2]
    exact Ico_tile_subset (Q.sy_pos β) h5 h6

/-- A rectangle with level in `[K₁, K₂]` contained in the box belongs to `boxColl`. -/
theorem mem_boxColl_of_subset {α β : ℕ} {K₁ K₂ : ℤ} {M : ℕ} {Q : DyRect} (h1 : K₁ ≤ Q.lev)
    (h2 : Q.lev ≤ K₂) (hs : Q.toSet α β ⊆ boxRegion α β K₂ M) : Q ∈ boxColl α β K₁ K₂ M := by
  unfold DyRect.toSet boxRegion at hs
  have hne : (Q.ix α ×ˢ Q.iy β).Nonempty :=
    ⟨(Q.x0 α, Q.y0 β), ⟨le_refl _, by linarith [Q.sx_pos α]⟩, ⟨le_refl _, by linarith [Q.sy_pos β]⟩⟩
  rw [Set.prod_subset_prod_iff] at hs
  rcases hs with ⟨hx, hy⟩ | h | h
  · rw [DyRect.ix_eq_box, ← boxIndex_mul M h2] at hx
    rw [DyRect.iy_eq_box, ← boxIndex_mul M h2] at hy
    obtain ⟨a1, a2⟩ := Ico_tile_bounds (Q.sx_pos α) hx
    obtain ⟨b1, b2⟩ := Ico_tile_bounds (Q.sy_pos β) hy
    exact mem_boxColl.2 ⟨h1, h2, a1, a2, b1, b2⟩
  · exact absurd (Set.prod_eq_empty_iff.2 (Or.inl h)) hne.ne_empty
  · exact absurd (Set.prod_eq_empty_iff.2 (Or.inr h)) hne.ne_empty

/-- `boxColl` is convex: a rectangle between two members (in level and inclusion) is a
member. -/
theorem boxColl_convex {α β : ℕ} {K₁ K₂ : ℤ} {M : ℕ} {Q Q' Q'' : DyRect}
    (hQ : Q ∈ boxColl α β K₁ K₂ M) (hQ'' : Q'' ∈ boxColl α β K₁ K₂ M)
    (hl : Q.lev ≤ Q'.lev) (hl' : Q'.lev ≤ Q''.lev) (hs : Q'.toSet α β ⊆ Q''.toSet α β) :
    Q' ∈ boxColl α β K₁ K₂ M :=
  mem_boxColl_of_subset ((mem_boxColl.1 hQ).1.trans hl) (hl'.trans (mem_boxColl.1 hQ'').2.1)
    (hs.trans (toSet_subset_boxRegion hQ''))

/-! ### Cells and their disjointness -/

/-- The cell `(ℓ(Q)/2, ℓ(Q)] × Q` in `(t, (p, q))` coordinates. -/
def tCell (α β : ℕ) (Q : DyRect) : Set (ℝ × ℝ × ℝ) :=
  Ioc (Q.len / 2) Q.len ×ˢ Q.toSet α β

theorem two_zpow_div_two (l : ℤ) : (2 : ℝ) ^ l / 2 = 2 ^ (l - 1) := by
  rw [zpow_sub_one₀ (by norm_num)]; ring

theorem lev_eq_of_mem_Ioc {l l' : ℤ} {t : ℝ} (h : t ∈ Ioc ((2 : ℝ) ^ l / 2) (2 ^ l))
    (h' : t ∈ Ioc ((2 : ℝ) ^ l' / 2) (2 ^ l')) : l = l' := by
  rw [two_zpow_div_two] at h h'
  have a : (2 : ℝ) ^ (l - 1) < 2 ^ l' := h.1.trans_le h'.2
  have b : (2 : ℝ) ^ (l' - 1) < 2 ^ l := h'.1.trans_le h.2
  rw [zpow_lt_zpow_iff_right₀ one_lt_two] at a b
  omega

theorem tCell_disjoint (α β : ℕ) {Q Q' : DyRect} (h : Q ≠ Q') :
    Disjoint (tCell α β Q) (tCell α β Q') := by
  rw [Set.disjoint_left]
  rintro ⟨t, p, q⟩ ⟨ht, hp, hq⟩ ⟨ht', hp', hq'⟩
  have hl : Q.lev = Q'.lev := lev_eq_of_mem_Ioc ht ht'
  apply h
  have hsx : Q.sx α = Q'.sx α := by unfold DyRect.sx; rw [hl]
  have hsy : Q.sy β = Q'.sy β := by unfold DyRect.sy; rw [hl]
  ext
  · exact hl
  · by_contra hm
    have := Ico_tile_disjoint (Q.sx_pos α) hm
    rw [Set.disjoint_left] at this
    rw [DyRect.ix_eq_box] at hp
    rw [DyRect.ix_eq_box, ← hsx] at hp'
    exact this hp hp'
  · by_contra hm
    have := Ico_tile_disjoint (Q.sy_pos β) hm
    rw [Set.disjoint_left] at this
    rw [DyRect.iy_eq_box] at hq
    rw [DyRect.iy_eq_box, ← hsy] at hq'
    exact this hq hq'

/-- The cells of `boxColl` tile `(2^{K₁}/2, 2^{K₂}] × box`. -/
theorem biUnion_tCell_boxColl (α β : ℕ) (K₁ K₂ : ℤ) (M : ℕ) :
    ⋃ Q ∈ boxColl α β K₁ K₂ M, tCell α β Q =
      Ioc ((2 : ℝ) ^ K₁ / 2) (2 ^ K₂) ×ˢ boxRegion α β K₂ M := by
  ext ⟨t, p, q⟩
  simp only [Set.mem_iUnion, Set.mem_prod, exists_prop]
  constructor
  · rintro ⟨Q, hQ, ht, hpq⟩
    obtain ⟨h1, h2, -⟩ := mem_boxColl.1 hQ
    have e1 : (2 : ℝ) ^ K₁ ≤ 2 ^ Q.lev := zpow_le_zpow_right₀ one_le_two h1
    have e2 : (2 : ℝ) ^ Q.lev ≤ 2 ^ K₂ := zpow_le_zpow_right₀ one_le_two h2
    refine ⟨⟨by unfold DyRect.len at ht; linarith [ht.1], by
      unfold DyRect.len at ht; linarith [ht.2]⟩, toSet_subset_boxRegion hQ hpq⟩
  · rintro ⟨ht, hp, hq⟩
    obtain ⟨n, hn⟩ := exists_mem_Ioc_zpow (lt_of_le_of_lt (by positivity) ht.1) one_lt_two
    have hn1 : (2 : ℝ) ^ (n + 1) / 2 = 2 ^ n := by
      rw [two_zpow_div_two]; simp
    have hK1 : K₁ ≤ n + 1 := by
      have : (2 : ℝ) ^ (K₁ - 1) < 2 ^ (n + 1) := by
        rw [← two_zpow_div_two]; exact ht.1.trans_le hn.2
      rw [zpow_lt_zpow_iff_right₀ one_lt_two] at this; omega
    have hK2 : n + 1 ≤ K₂ := by
      have : (2 : ℝ) ^ n < 2 ^ K₂ := hn.1.trans_le ht.2
      rw [zpow_lt_zpow_iff_right₀ one_lt_two] at this; omega
    have hsx : (0 : ℝ) < 2 ^ ((n + 1) * α) := by positivity
    have hsy : (0 : ℝ) < 2 ^ ((n + 1) * β) := by positivity
    rw [← boxIndex_mul M hK2] at hp hq
    obtain ⟨m, hm1, hm2, hm⟩ := exists_Ico_tile hsx hp
    obtain ⟨k, hk1, hk2, hk⟩ := exists_Ico_tile hsy hq
    refine ⟨⟨n + 1, m, k⟩, ?_, ?_, hm, hk⟩
    · exact mem_boxColl.2 ⟨hK1, hK2, hm1, hm2, hk1, hk2⟩
    · simp only [DyRect.len]; rw [hn1]; exact hn

/-! ### Integrals over cells and boxes -/

/-- Bounded integrands are integrable on `(a, b] × S` with respect to `dt/t dp dq`, `a > 0`. -/
theorem integrableOn_Ioc_prod_of_bdd {G : ℝ → ℝ → ℝ → ℝ}
    (hm : Measurable fun z : ℝ × ℝ × ℝ => G z.1 z.2.1 z.2.2) {C : ℝ}
    (hC : ∀ t, 0 < t → ∀ p q, |G t p q| ≤ C) {a b : ℝ} (ha : 0 < a) {S : Set (ℝ × ℝ)}
    (hS : MeasurableSet S) (hSf : volume S ≠ ⊤) :
    IntegrableOn (fun z : ℝ × ℝ × ℝ => z.1⁻¹ * G z.1 z.2.1 z.2.2) (Ioc a b ×ˢ S) := by
  refine Measure.integrableOn_of_bounded (M := a⁻¹ * C) ?_
    ((measurable_fst.inv.mul hm).aestronglyMeasurable) ?_
  · rw [Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Ioc]
    exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top hSf
  · refine (ae_restrict_iff' (measurableSet_Ioc.prod hS)).2 (Eventually.of_forall fun z hz => ?_)
    have ht : 0 < z.1 := ha.trans hz.1.1
    rw [Real.norm_eq_abs, abs_mul, abs_of_pos (inv_pos.2 ht)]
    exact mul_le_mul (inv_anti₀ ha hz.1.1.le) (hC z.1 ht _ _) (abs_nonneg _)
      (inv_pos.2 ha).le

theorem volume_Ico_prod_ne_top (a b c d : ℝ) : volume (Ico a b ×ˢ Ico c d) ≠ ⊤ := by
  rw [Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Ico, Real.volume_Ico]
  exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top

/-- `∫_{(a,b] × S × T} G dt/t dp dq` as an iterated integral. -/
theorem setIntegral_Ioc_prod_eq {G : ℝ → ℝ → ℝ → ℝ}
    (hm : Measurable fun z : ℝ × ℝ × ℝ => G z.1 z.2.1 z.2.2) {C : ℝ}
    (hC : ∀ t, 0 < t → ∀ p q, |G t p q| ≤ C) {a b : ℝ} (ha : 0 < a) (a' b' c' d' : ℝ) :
    ∫ z in Ioc a b ×ˢ (Ico a' b' ×ˢ Ico c' d'), z.1⁻¹ * G z.1 z.2.1 z.2.2 =
      ∫ t in Ioc a b, t⁻¹ * ∫ p in Ico a' b', ∫ q in Ico c' d', G t p q := by
  have hI := integrableOn_Ioc_prod_of_bdd hm hC ha (measurableSet_Ico.prod measurableSet_Ico)
    (volume_Ico_prod_ne_top a' b' c' d') (b := b)
  rw [Measure.volume_eq_prod, setIntegral_prod _ hI]
  refine setIntegral_congr_fun measurableSet_Ioc fun t ht => ?_
  have ht0 : 0 < t := ha.trans ht.1
  have hIt : IntegrableOn (fun w : ℝ × ℝ => G t w.1 w.2) (Ico a' b' ×ˢ Ico c' d') := by
    refine Measure.integrableOn_of_bounded (M := C) (volume_Ico_prod_ne_top a' b' c' d')
      ((hm.comp (measurable_const.prodMk measurable_id)).aestronglyMeasurable) ?_
    exact Eventually.of_forall fun w => by rw [Real.norm_eq_abs]; exact hC t ht0 _ _
  simp only
  rw [integral_const_mul, Measure.volume_eq_prod, setIntegral_prod _ hIt]

theorem cellInt_eq_setIntegral_tCell {α β : ℕ} (Q : DyRect) {G : ℝ → ℝ → ℝ → ℝ}
    (hm : Measurable fun z : ℝ × ℝ × ℝ => G z.1 z.2.1 z.2.2) {C : ℝ}
    (hC : ∀ t, 0 < t → ∀ p q, |G t p q| ≤ C) :
    cellInt α β Q G = ∫ z in tCell α β Q, z.1⁻¹ * G z.1 z.2.1 z.2.2 := by
  unfold tCell DyRect.toSet DyRect.ix DyRect.iy
  rw [setIntegral_Ioc_prod_eq hm hC (div_pos Q.len_pos two_pos)]
  rfl

/-- **Tiling.** The integral over the cells of `boxColl` is the integral over
`(2^{K₁}/2, 2^{K₂}] × box` with respect to `dt/t dp dq`. -/
theorem collInt_boxColl_eq_setIntegral (α β : ℕ) (K₁ K₂ : ℤ) (M : ℕ) {G : ℝ → ℝ → ℝ → ℝ}
    (hm : Measurable fun z : ℝ × ℝ × ℝ => G z.1 z.2.1 z.2.2) {C : ℝ}
    (hC : ∀ t, 0 < t → ∀ p q, |G t p q| ≤ C) :
    collInt α β (boxColl α β K₁ K₂ M) G =
      ∫ z in Ioc ((2 : ℝ) ^ K₁ / 2) (2 ^ K₂) ×ˢ boxRegion α β K₂ M, z.1⁻¹ * G z.1 z.2.1 z.2.2 := by
  rw [← biUnion_tCell_boxColl, integral_biUnion_finset]
  · exact Finset.sum_congr rfl fun Q _ => cellInt_eq_setIntegral_tCell Q hm hC
  · intro Q _
    exact measurableSet_Ioc.prod (measurableSet_Ico.prod measurableSet_Ico)
  · intro Q _ Q' _ h
    exact tCell_disjoint α β h
  · intro Q _
    exact integrableOn_Ioc_prod_of_bdd hm hC (div_pos Q.len_pos two_pos)
      (measurableSet_Ico.prod measurableSet_Ico) (volume_Ico_prod_ne_top _ _ _ _)

/-- **Tiling**, iterated form: `∑_{Q ∈ boxColl} ∫_{ℓ(Q)/2}^{ℓ(Q)} ∫_Q G dp dq dt/t =
∫_{2^{K₁}/2}^{2^{K₂}} ∫_{-X}^{X} ∫_{-Y}^{Y} G dq dp dt/t`, `X = M 2^{K₂α}`, `Y = M 2^{K₂β}`. -/
theorem collInt_boxColl_eq (α β : ℕ) (K₁ K₂ : ℤ) (M : ℕ) {G : ℝ → ℝ → ℝ → ℝ}
    (hm : Measurable fun z : ℝ × ℝ × ℝ => G z.1 z.2.1 z.2.2) {C : ℝ}
    (hC : ∀ t, 0 < t → ∀ p q, |G t p q| ≤ C) :
    collInt α β (boxColl α β K₁ K₂ M) G =
      ∫ t in Ioc ((2 : ℝ) ^ K₁ / 2) (2 ^ K₂), t⁻¹ * ∫ p in Ico (-boxX α K₂ M) (boxX α K₂ M),
        ∫ q in Ico (-boxX β K₂ M) (boxX β K₂ M), G t p q := by
  rw [collInt_boxColl_eq_setIntegral α β K₁ K₂ M hm hC, boxRegion,
    setIntegral_Ioc_prod_eq hm hC (by positivity)]

/-! ### Kernel identities -/

theorem kernelAt_eq_mul (k : ℝ → ℝ) (s a x : ℝ) : kernelAt k s a x = s⁻¹ * k ((x - a) / s) := by
  simp [kernelAt, Auto.Twisted.kernelDilate, smul_eq_mul]

theorem measurable_kernelAt_comp {W : Type*} [MeasurableSpace W] {k : ℝ → ℝ} (hk : Measurable k)
    {s a x : W → ℝ} (hs : Measurable s) (ha : Measurable a) (hx : Measurable x) :
    Measurable fun w => kernelAt k (s w) (a w) (x w) := by
  simp only [kernelAt_eq_mul]
  exact hs.inv.mul (hk.comp ((hx.sub ha).div hs))

theorem integrable_kernelAt_right {k : ℝ → ℝ} (hk : Integrable k) (s a : ℝ) :
    Integrable (kernelAt k s a) := by
  have e : kernelAt k s a = fun x => s⁻¹ * k ((x - a) / s) := funext (kernelAt_eq_mul k s a)
  rw [e]
  rcases eq_or_ne s 0 with rfl | hs
  · simp
  · exact ((hk.comp_div hs).comp_sub_right a).const_mul _

theorem integral_abs_kernelAt_right (k : ℝ → ℝ) {s : ℝ} (hs : 0 < s) (a : ℝ) :
    ∫ x, |kernelAt k s a x| = ∫ x, |k x| := by
  simp_rw [kernelAt_eq_mul, abs_mul, abs_of_pos (inv_pos.2 hs)]
  rw [integral_const_mul, integral_sub_right_eq_self (μ := volume)
    (fun x => |k (x / s)|) a, Measure.integral_comp_div (fun x => |k x|) s, abs_of_pos hs,
    smul_eq_mul, ← mul_assoc, inv_mul_cancel₀ hs.ne', one_mul]

/-- The kernel `a ↦ k_{s,a}(x)` as a function of the translation parameter. -/
theorem kernelAt_left_eq (k : ℝ → ℝ) (s x : ℝ) :
    (fun a => kernelAt k s a x) = fun a => (fun v => s⁻¹ * k (v / s)) (x - a) :=
  funext fun a => kernelAt_eq_mul k s a x

theorem integrable_kernelAt_left {k : ℝ → ℝ} (hk : Integrable k) (s x : ℝ) :
    Integrable fun a => kernelAt k s a x := by
  rw [kernelAt_left_eq]
  rcases eq_or_ne s 0 with rfl | hs
  · simp
  · exact ((hk.comp_div hs).const_mul _).comp_sub_left x

theorem integral_abs_kernelAt_left (k : ℝ → ℝ) {s : ℝ} (hs : 0 < s) (x : ℝ) :
    ∫ a, |kernelAt k s a x| = ∫ u, |k u| := by
  have e : (fun a => |kernelAt k s a x|) = fun a => (fun v => |s⁻¹ * k (v / s)|) (x - a) :=
    funext fun a => by rw [kernelAt_eq_mul]
  rw [e, integral_sub_left_eq_self (fun v => |s⁻¹ * k (v / s)|) volume x]
  simp_rw [abs_mul, abs_of_pos (inv_pos.2 hs)]
  rw [integral_const_mul, Measure.integral_comp_div (fun x => |k x|) s, abs_of_pos hs,
    smul_eq_mul, ← mul_assoc, inv_mul_cancel₀ hs.ne', one_mul]

/-! ### The correlation kernels -/

/-- The correlation `corrK k k' (w) = ∫ k(u) k'(u - w) du`, so that
`∫ k_{s,p}(x) k'_{s,p}(x') dp = (corrK k k')_{s,x'}(x)` (`kernelAt_corrK`). -/
def corrK (k k' : ℝ → ℝ) (w : ℝ) : ℝ := ∫ u, k u * k' (u - w)

/-- `∫ k_{s,p}(x) k'_{s,p}(x') dp = s⁻¹ corrK k k' ((x - x')/s) = (corrK k k')_{s,x'}(x)`. -/
theorem kernelAt_corrK (k k' : ℝ → ℝ) {s : ℝ} (hs : 0 < s) (x x' : ℝ) :
    ∫ p, kernelAt k s p x * kernelAt k' s p x' = kernelAt (corrK k k') s x' x := by
  have e : (fun p => kernelAt k s p x * kernelAt k' s p x') = fun p =>
      (fun v => (s⁻¹ * s⁻¹) * (fun u => k u * k' (u - (x - x') / s)) (v / s)) (x - p) := by
    funext p
    simp only [kernelAt_eq_mul]
    have : (x' - p) / s = (x - p) / s - (x - x') / s := by ring
    rw [this]; ring
  rw [e, integral_sub_left_eq_self
    (fun v => (s⁻¹ * s⁻¹) * (fun u => k u * k' (u - (x - x') / s)) (v / s)) volume x,
    integral_const_mul,
    Measure.integral_comp_div (fun u => k u * k' (u - (x - x') / s)) s, abs_of_pos hs,
    smul_eq_mul, kernelAt_eq_mul, corrK]
  field_simp

theorem measurable_corrK {k k' : ℝ → ℝ} (hk : Measurable k) (hk' : Measurable k') :
    Measurable (corrK k k') := by
  have hm : Measurable (Function.uncurry fun (w u : ℝ) => k u * k' (u - w)) :=
    (hk.comp measurable_snd).mul (hk'.comp (measurable_snd.sub measurable_fst))
  exact (hm.stronglyMeasurable.integral_prod_right' (ν := volume)).measurable

theorem integrable_corrK {k k' : ℝ → ℝ} (hk : Measurable k) (hk' : Measurable k')
    (ik : Integrable k) (ik' : Integrable k') : Integrable (corrK k k') := by
  have hm : Measurable fun z : ℝ × ℝ => k z.1 * k' (z.1 - z.2) :=
    (hk.comp measurable_fst).mul (hk'.comp (measurable_fst.sub measurable_snd))
  have hI : Integrable (fun z : ℝ × ℝ => k z.1 * k' (z.1 - z.2)) (volume.prod volume) := by
    refine (integrable_prod_iff hm.aestronglyMeasurable).2 ⟨Eventually.of_forall fun u => ?_, ?_⟩
    · change Integrable (fun w => k u * k' (u - w))
      exact (ik'.comp_sub_left u).const_mul _
    · have e : (fun u => ∫ w, ‖k (u, w).1 * k' ((u, w).1 - (u, w).2)‖) =
          fun u => |k u| * ∫ w, |k' w| := by
        funext u
        simp only [Real.norm_eq_abs, abs_mul]
        rw [integral_const_mul, integral_sub_left_eq_self (fun v => |k' v|) volume u]
      rw [e]
      exact ik.abs.mul_const _
  exact hI.integral_prod_right

/-- Continuity of the correlation kernel. -/
theorem continuous_corrK {k k' : ℝ → ℝ} (ik : Integrable k) (hk' : Continuous k') {B : ℝ}
    (hB : ∀ u, |k' u| ≤ B) : Continuous (corrK k k') := by
  unfold corrK
  refine continuous_of_dominated (bound := fun u => |k u| * B) (fun w => ?_) (fun w => ?_)
    (ik.abs.mul_const B) (Eventually.of_forall fun u => by fun_prop)
  · exact ik.aestronglyMeasurable.mul (hk'.comp (by fun_prop)).aestronglyMeasurable
  · refine Eventually.of_forall fun u => ?_
    rw [Real.norm_eq_abs, abs_mul]
    exact mul_le_mul_of_nonneg_left (hB _) (abs_nonneg _)

theorem one_add_abs_le_mul (u w : ℝ) : 1 + |w| ≤ (1 + |u|) * (1 + |u - w|) := by
  have h : |w| ≤ |u| + |u - w| := by
    calc |w| = |u - (u - w)| := by ring_nf
      _ ≤ |u| + |u - w| := abs_sub _ _
  nlinarith [abs_nonneg u, abs_nonneg (u - w)]

theorem decay_mul_le (N : ℝ) (hN : 0 ≤ N) (u w : ℝ) :
    (1 + |u|) ^ (-(N + 2)) * (1 + |u - w|) ^ (-N) ≤
      (1 + |u|) ^ (-(2 : ℝ)) * (1 + |w|) ^ (-N) := by
  have hA : 0 < 1 + |u| := by positivity
  have hB : 0 < 1 + |u - w| := by positivity
  have hW : 0 < 1 + |w| := by positivity
  have h1 : ((1 + |u|) * (1 + |u - w|)) ^ (-N) ≤ (1 + |w|) ^ (-N) :=
    Real.rpow_le_rpow_of_nonpos hW (one_add_abs_le_mul u w) (by linarith)
  rw [Real.mul_rpow hA.le hB.le] at h1
  rw [show -(N + 2) = -(2 : ℝ) + -N by ring, Real.rpow_add hA, mul_assoc]
  exact mul_le_mul_of_nonneg_left h1 (by positivity)

/-- Decay of the correlation kernel: if `|k(u)| ≤ C (1+|u|)^{-N-2}` and
`|k'(u)| ≤ C' (1+|u|)^{-N}`, then `|corrK k k' (w)| ≤ C C' c₀ (1+|w|)^{-N}`, where
`c₀ = ∫ (1+|u|)^{-2} du`. -/
theorem abs_corrK_le {k k' : ℝ → ℝ} {C C' N : ℝ}
    (hN : 0 ≤ N) (hC' : 0 ≤ C') (hdk : ∀ u, |k u| ≤ C * (1 + |u|) ^ (-(N + 2)))
    (hdk' : ∀ u, |k' u| ≤ C' * (1 + |u|) ^ (-N)) (w : ℝ) :
    |corrK k k' w| ≤ C * C' * (∫ u : ℝ, (1 + |u|) ^ (-(2 : ℝ))) * (1 + |w|) ^ (-N) := by
  have hint : Integrable fun u : ℝ => (1 + |u|) ^ (-(2 : ℝ)) := by
    have := integrable_one_add_norm (E := ℝ) (μ := volume) (r := 2) (by norm_num)
    simpa [Real.norm_eq_abs] using this
  have hC : 0 ≤ C := by
    have h := (abs_nonneg _).trans (hdk 0)
    exact nonneg_of_mul_nonneg_left h (by positivity)
  unfold corrK
  rw [← Real.norm_eq_abs]
  have hb : Integrable fun u : ℝ => C * C' * (1 + |w|) ^ (-N) * (1 + |u|) ^ (-(2 : ℝ)) :=
    hint.const_mul _
  refine (norm_integral_le_of_norm_le hb (Eventually.of_forall fun u => ?_)).trans
    (le_of_eq ?_)
  · rw [Real.norm_eq_abs, abs_mul]
    calc |k u| * |k' (u - w)|
        ≤ (C * (1 + |u|) ^ (-(N + 2))) * (C' * (1 + |u - w|) ^ (-N)) :=
          mul_le_mul (hdk u) (hdk' _) (abs_nonneg _) (by positivity)
      _ = C * C' * ((1 + |u|) ^ (-(N + 2)) * (1 + |u - w|) ^ (-N)) := by ring
      _ ≤ C * C' * ((1 + |u|) ^ (-(2 : ℝ)) * (1 + |w|) ^ (-N)) :=
          mul_le_mul_of_nonneg_left (decay_mul_le N hN u w) (by positivity)
      _ = _ := by ring
  · rw [integral_const_mul]; ring

/-! ### Fubini in `(p, q)` -/

theorem measurable_integral_of_uncurry {W Y : Type*} [MeasurableSpace W] [MeasureSpace Y]
    [SFinite (volume : Measure Y)] {G : W → Y → ℝ}
    (hG : Measurable (Function.uncurry G)) : Measurable fun w => ∫ x, G w x :=
  (hG.stronglyMeasurable.integral_prod_right' (ν := volume)).measurable

/-- The form with `f_4 = 1`, integrated in the order `x, y, x', y'`. -/
theorem quadForm_one_eq {f₁ f₂ f₃ : ℝ × ℝ → ℝ} (h₁ : Measurable f₁) (h₃ : Measurable f₃)
    {B : ℝ} (hb₁ : ∀ z, |f₁ z| ≤ B) (hb₃ : ∀ z, |f₃ z| ≤ B) {A Bk C D : ℝ → ℝ}
    (iB : Integrable Bk) (iC : Integrable C) :
    quadForm f₁ f₂ f₃ (fun _ => 1) A Bk C D = ∫ x, ∫ y, f₃ (x, y) *
      ((A x * ∫ x', f₁ (x', y) * Bk x') * (C y * ∫ y', f₂ (x, y') * D y')) := by
  unfold quadForm
  refine integral_congr_ae (Eventually.of_forall fun x => ?_)
  have h1 : ∀ x' y, ∫ y', quadF f₁ f₂ f₃ (fun _ => 1) x x' y y' * (A x * Bk x' * (C y * D y')) =
      (A x * ∫ y', f₂ (x, y') * D y') * ((f₁ (x', y) * f₃ (x, y)) * (Bk x' * C y)) := by
    intro x' y
    have e : ∀ y', quadF f₁ f₂ f₃ (fun _ => 1) x x' y y' * (A x * Bk x' * (C y * D y')) =
        ((f₁ (x', y) * f₃ (x, y)) * (Bk x' * C y) * A x) * (f₂ (x, y') * D y') := by
      intro y'; unfold quadF; ring
    simp_rw [e]; rw [integral_const_mul]; ring
  simp_rw [h1]
  have hint : Integrable (Function.uncurry fun x' y =>
      (A x * ∫ y', f₂ (x, y') * D y') * ((f₁ (x', y) * f₃ (x, y)) * (Bk x' * C y)))
      (volume.prod volume) := by
    have e : (Function.uncurry fun x' y =>
        (A x * ∫ y', f₂ (x, y') * D y') * ((f₁ (x', y) * f₃ (x, y)) * (Bk x' * C y))) =
        fun z : ℝ × ℝ => ((A x * ∫ y', f₂ (x, y') * D y') * (f₁ z * f₃ (x, z.2))) *
          (Bk z.1 * C z.2) := by
      funext z; simp only [Function.uncurry]; ring
    rw [e]
    refine (iB.mul_prod iC).bdd_mul (c := |A x * ∫ y', f₂ (x, y') * D y'| * (B * B)) ?_ ?_
    · exact (measurable_const.mul (h₁.mul (h₃.comp (measurable_const.prodMk
        measurable_snd)))).aestronglyMeasurable
    · refine Eventually.of_forall fun z => ?_
      simp only [Real.norm_eq_abs, abs_mul]
      have hB : 0 ≤ B := (abs_nonneg _).trans (hb₁ 0)
      exact mul_le_mul_of_nonneg_left (mul_le_mul (hb₁ z) (hb₃ _) (abs_nonneg _) hB)
        (by positivity)
  rw [integral_integral_swap hint]
  refine integral_congr_ae (Eventually.of_forall fun y => ?_)
  have e : ∀ x', (A x * ∫ y', f₂ (x, y') * D y') * ((f₁ (x', y) * f₃ (x, y)) * (Bk x' * C y)) =
      ((A x * ∫ y', f₂ (x, y') * D y') * f₃ (x, y) * C y) * (f₁ (x', y) * Bk x') := by
    intro x'; ring
  simp_rw [e]; rw [integral_const_mul]; ring

/-- `|∫ g(x') k_{s,a}(x') dx'| ≤ B ∫ |k|` for `|g| ≤ B`. -/
theorem abs_integral_mul_kernelAt_right_le {g : ℝ → ℝ} {B : ℝ} (hg : ∀ x, |g x| ≤ B)
    {k : ℝ → ℝ} (ik : Integrable k) {s : ℝ} (hs : 0 < s) (a : ℝ) :
    |∫ x', g x' * kernelAt k s a x'| ≤ B * ∫ u, |k u| := by
  rw [← Real.norm_eq_abs, ← integral_abs_kernelAt_right k hs a, ← integral_const_mul]
  refine norm_integral_le_of_norm_le ((integrable_kernelAt_right ik s a).abs.const_mul B)
    (Eventually.of_forall fun x' => ?_)
  rw [Real.norm_eq_abs, abs_mul]
  exact mul_le_mul_of_nonneg_right (hg x') (abs_nonneg _)

/-- `|∫ g(x') k_{s,x'}(x) dx'| ≤ B ∫ |k|` for `|g| ≤ B`. -/
theorem abs_integral_mul_kernelAt_left_le {g : ℝ → ℝ} {B : ℝ} (hg : ∀ x, |g x| ≤ B)
    {k : ℝ → ℝ} (ik : Integrable k) {s : ℝ} (hs : 0 < s) (x : ℝ) :
    |∫ x', g x' * kernelAt k s x' x| ≤ B * ∫ u, |k u| := by
  rw [← Real.norm_eq_abs, ← integral_abs_kernelAt_left k hs x, ← integral_const_mul]
  refine norm_integral_le_of_norm_le ((integrable_kernelAt_left ik s x).abs.const_mul B)
    (Eventually.of_forall fun x' => ?_)
  rw [Real.norm_eq_abs, abs_mul]
  exact mul_le_mul_of_nonneg_right (hg x') (abs_nonneg _)

/-- `(p, x') ↦ |k_{s,p}(x)| |k'_{s,p}(x')|` is integrable. -/
theorem integrable_kernelAt_pair {k k' : ℝ → ℝ} (hk : Measurable k) (hk' : Measurable k')
    (ik : Integrable k) (ik' : Integrable k') {s : ℝ} (hs : 0 < s) (x : ℝ) :
    Integrable fun z : ℝ × ℝ => |kernelAt k s z.1 x| * |kernelAt k' s z.1 z.2| := by
  have hm : Measurable fun z : ℝ × ℝ => |kernelAt k s z.1 x| * |kernelAt k' s z.1 z.2| :=
    (measurable_kernelAt_comp hk measurable_const measurable_fst measurable_const).abs.mul
      (measurable_kernelAt_comp hk' measurable_const measurable_fst measurable_snd).abs
  rw [Measure.volume_eq_prod]
  refine (integrable_prod_iff hm.aestronglyMeasurable).2 ⟨Eventually.of_forall fun p => ?_, ?_⟩
  · change Integrable (fun x' => |kernelAt k s p x| * |kernelAt k' s p x'|)
    exact (integrable_kernelAt_right ik' s p).abs.const_mul _
  · have e : (fun p => ∫ x', ‖|kernelAt k s (p, x').1 x| * |kernelAt k' s (p, x').1 (p, x').2|‖) =
        fun p => |kernelAt k s p x| * ∫ u, |k' u| := by
      funext p
      simp only [Real.norm_eq_abs, abs_mul, abs_abs]
      rw [integral_const_mul, integral_abs_kernelAt_right k' hs p]
    rw [e]
    exact (integrable_kernelAt_left ik s x).abs.mul_const _

/-- `∫ k_{s,p}(x) (∫ g(x') k'_{s,p}(x') dx') dp = ∫ g(x') (corrK k k')_{s,x'}(x) dx'`. -/
theorem integral_kernelAt_mul_integral {g : ℝ → ℝ} (hg : Measurable g) {B : ℝ}
    (hgB : ∀ x, |g x| ≤ B) {k k' : ℝ → ℝ} (hk : Measurable k) (hk' : Measurable k')
    (ik : Integrable k) (ik' : Integrable k') {s : ℝ} (hs : 0 < s) (x : ℝ) :
    ∫ p, kernelAt k s p x * ∫ x', g x' * kernelAt k' s p x' =
      ∫ x', g x' * kernelAt (corrK k k') s x' x := by
  have hB : 0 ≤ B := (abs_nonneg _).trans (hgB 0)
  have hint : Integrable (Function.uncurry fun p x' =>
      kernelAt k s p x * (g x' * kernelAt k' s p x')) (volume.prod volume) := by
    have hm : Measurable (Function.uncurry fun p x' =>
        kernelAt k s p x * (g x' * kernelAt k' s p x')) :=
      (measurable_kernelAt_comp hk measurable_const measurable_fst measurable_const).mul
        ((hg.comp measurable_snd).mul
          (measurable_kernelAt_comp hk' measurable_const measurable_fst measurable_snd))
    rw [← Measure.volume_eq_prod]
    refine ((integrable_kernelAt_pair hk hk' ik ik' hs x).const_mul B).mono'
      hm.aestronglyMeasurable (Eventually.of_forall fun z => ?_)
    simp only [Function.uncurry, Real.norm_eq_abs, abs_mul]
    calc |kernelAt k s z.1 x| * (|g z.2| * |kernelAt k' s z.1 z.2|)
        ≤ |kernelAt k s z.1 x| * (B * |kernelAt k' s z.1 z.2|) := by gcongr; exact hgB _
      _ = _ := by ring
  simp_rw [← integral_const_mul]
  rw [integral_integral_swap hint]
  refine integral_congr_ae (Eventually.of_forall fun x' => ?_)
  have e : ∀ p, kernelAt k s p x * (g x' * kernelAt k' s p x') =
      g x' * (kernelAt k s p x * kernelAt k' s p x') := fun p => by ring
  simp_rw [e]
  rw [integral_const_mul, kernelAt_corrK k k' hs]

/-- The integrand of the `(x, y, p, q)` form, `v = ((x, y), (p, q))`. -/
def fubW (f₁ f₂ f₃ : ℝ × ℝ → ℝ) (k₁ k₂ k₃ k₄ : ℝ → ℝ) (s σ : ℝ)
    (v : (ℝ × ℝ) × (ℝ × ℝ)) : ℝ :=
  f₃ v.1 * ((kernelAt k₁ s v.2.1 v.1.1 * ∫ x', f₁ (x', v.1.2) * kernelAt k₂ s v.2.1 x') *
    (kernelAt k₃ σ v.2.2 v.1.2 * ∫ y', f₂ (v.1.1, y') * kernelAt k₄ σ v.2.2 y'))

/-- The dominating function of `fubW`. -/
def fubDom (f₃ : ℝ × ℝ → ℝ) (k₁ k₃ : ℝ → ℝ) (s σ : ℝ) (v : (ℝ × ℝ) × (ℝ × ℝ)) : ℝ :=
  |f₃ v.1| * (|kernelAt k₁ s v.2.1 v.1.1| * |kernelAt k₃ σ v.2.2 v.1.2|)

theorem measurable_fubW {f₁ f₂ f₃ : ℝ × ℝ → ℝ} (h₁ : Measurable f₁) (h₂ : Measurable f₂)
    (h₃ : Measurable f₃) {k₁ k₂ k₃ k₄ : ℝ → ℝ} (hk₁ : Measurable k₁) (hk₂ : Measurable k₂)
    (hk₃ : Measurable k₃) (hk₄ : Measurable k₄) (s σ : ℝ) :
    Measurable (fubW f₁ f₂ f₃ k₁ k₂ k₃ k₄ s σ) := by
  unfold fubW
  have mE : Measurable fun v : (ℝ × ℝ) × (ℝ × ℝ) => ∫ x', f₁ (x', v.1.2) * kernelAt k₂ s v.2.1 x' :=
    measurable_integral_of_uncurry (G := fun (v : (ℝ × ℝ) × (ℝ × ℝ)) x' =>
      f₁ (x', v.1.2) * kernelAt k₂ s v.2.1 x')
      ((h₁.comp (measurable_snd.prodMk measurable_fst.fst.snd)).mul
        (measurable_kernelAt_comp hk₂ measurable_const measurable_fst.snd.fst measurable_snd))
  have mD : Measurable fun v : (ℝ × ℝ) × (ℝ × ℝ) => ∫ y', f₂ (v.1.1, y') * kernelAt k₄ σ v.2.2 y' :=
    measurable_integral_of_uncurry (G := fun (v : (ℝ × ℝ) × (ℝ × ℝ)) y' =>
      f₂ (v.1.1, y') * kernelAt k₄ σ v.2.2 y')
      ((h₂.comp (measurable_fst.fst.fst.prodMk measurable_snd)).mul
        (measurable_kernelAt_comp hk₄ measurable_const measurable_fst.snd.snd measurable_snd))
  exact (h₃.comp measurable_fst).mul
    (((measurable_kernelAt_comp hk₁ measurable_const measurable_snd.fst measurable_fst.fst).mul
      mE).mul ((measurable_kernelAt_comp hk₃ measurable_const measurable_snd.snd
        measurable_fst.snd).mul mD))

theorem measurable_fubDom {f₃ : ℝ × ℝ → ℝ} (h₃ : Measurable f₃) {k₁ k₃ : ℝ → ℝ}
    (hk₁ : Measurable k₁) (hk₃ : Measurable k₃) (s σ : ℝ) :
    Measurable (fubDom f₃ k₁ k₃ s σ) := by
  unfold fubDom
  exact (h₃.comp measurable_fst).abs.mul
    ((measurable_kernelAt_comp hk₁ measurable_const measurable_snd.fst measurable_fst.fst).abs.mul
      (measurable_kernelAt_comp hk₃ measurable_const measurable_snd.snd measurable_fst.snd).abs)

theorem abs_fubW_le {f₁ f₂ f₃ : ℝ × ℝ → ℝ} {B : ℝ} (hb₁ : ∀ z, |f₁ z| ≤ B)
    (hb₂ : ∀ z, |f₂ z| ≤ B) {k₁ k₂ k₃ k₄ : ℝ → ℝ} (ik₂ : Integrable k₂) (ik₄ : Integrable k₄)
    {s σ : ℝ} (hs : 0 < s) (hσ : 0 < σ) (v : (ℝ × ℝ) × (ℝ × ℝ)) :
    |fubW f₁ f₂ f₃ k₁ k₂ k₃ k₄ s σ v| ≤
      (B * ∫ u, |k₂ u|) * (B * ∫ u, |k₄ u|) * fubDom f₃ k₁ k₃ s σ v := by
  unfold fubW fubDom
  have e1 := abs_integral_mul_kernelAt_right_le (g := fun x' => f₁ (x', v.1.2))
    (fun x' => hb₁ _) ik₂ hs v.2.1
  have e2 := abs_integral_mul_kernelAt_right_le (g := fun y' => f₂ (v.1.1, y'))
    (fun y' => hb₂ _) ik₄ hσ v.2.2
  simp only [abs_mul]
  calc |f₃ v.1| * (|kernelAt k₁ s v.2.1 v.1.1| * |∫ x', f₁ (x', v.1.2) * kernelAt k₂ s v.2.1 x'| *
        (|kernelAt k₃ σ v.2.2 v.1.2| * |∫ y', f₂ (v.1.1, y') * kernelAt k₄ σ v.2.2 y'|))
      ≤ |f₃ v.1| * (|kernelAt k₁ s v.2.1 v.1.1| * (B * ∫ u, |k₂ u|) *
        (|kernelAt k₃ σ v.2.2 v.1.2| * (B * ∫ u, |k₄ u|))) := by
        have hB : 0 ≤ B := (abs_nonneg _).trans (hb₁ 0)
        have hB2 : 0 ≤ B * ∫ u, |k₂ u| := mul_nonneg hB (integral_nonneg fun _ => abs_nonneg _)
        gcongr
    _ = _ := by ring

theorem integrable_fubDom {f₃ : ℝ × ℝ → ℝ} (h₃ : Measurable f₃) (if₃ : Integrable f₃)
    {k₁ k₃ : ℝ → ℝ} (hk₁ : Measurable k₁) (hk₃ : Measurable k₃) (ik₁ : Integrable k₁)
    (ik₃ : Integrable k₃) {s σ : ℝ} (hs : 0 < s) (hσ : 0 < σ) :
    Integrable (fubDom f₃ k₁ k₃ s σ) ∧
      ∫ v, fubDom f₃ k₁ k₃ s σ v = (∫ z, |f₃ z|) * ((∫ u, |k₁ u|) * ∫ u, |k₃ u|) := by
  have hs1 : ∀ xy : ℝ × ℝ, (fun pq : ℝ × ℝ => fubDom f₃ k₁ k₃ s σ (xy, pq)) =
      fun pq => |f₃ xy| * (|kernelAt k₁ s pq.1 xy.1| * |kernelAt k₃ σ pq.2 xy.2|) :=
    fun xy => rfl
  have hs2 : ∀ xy : ℝ × ℝ, ∫ pq : ℝ × ℝ, fubDom f₃ k₁ k₃ s σ (xy, pq) =
      |f₃ xy| * ((∫ u, |k₁ u|) * ∫ u, |k₃ u|) := by
    intro xy
    rw [hs1, integral_const_mul, Measure.volume_eq_prod,
      integral_prod_mul (fun p => |kernelAt k₁ s p xy.1|) (fun q => |kernelAt k₃ σ q xy.2|),
      integral_abs_kernelAt_left k₁ hs, integral_abs_kernelAt_left k₃ hσ]
  have hI : Integrable (fubDom f₃ k₁ k₃ s σ) := by
    rw [Measure.volume_eq_prod]
    refine (integrable_prod_iff (measurable_fubDom h₃ hk₁ hk₃ s σ).aestronglyMeasurable).2
      ⟨Eventually.of_forall fun xy => ?_, ?_⟩
    · rw [hs1, Measure.volume_eq_prod]
      exact ((integrable_kernelAt_left ik₁ s xy.1).abs.mul_prod
        (integrable_kernelAt_left ik₃ σ xy.2).abs).const_mul _
    · have e : (fun xy : ℝ × ℝ => ∫ pq : ℝ × ℝ, ‖fubDom f₃ k₁ k₃ s σ (xy, pq)‖) =
          fun xy => |f₃ xy| * ((∫ u, |k₁ u|) * ∫ u, |k₃ u|) := by
        funext xy
        rw [← hs2 xy]
        refine integral_congr_ae (Eventually.of_forall fun pq => ?_)
        simp only [Real.norm_eq_abs]
        exact abs_of_nonneg (by unfold fubDom; positivity)
      rw [e]
      exact if₃.abs.mul_const _
  refine ⟨hI, ?_⟩
  rw [Measure.volume_eq_prod, integral_prod _ (by rw [← Measure.volume_eq_prod]; exact hI)]
  simp_rw [hs2]
  rw [integral_mul_const]

theorem integrable_fubW {f₁ f₂ f₃ : ℝ × ℝ → ℝ} (h₁ : Measurable f₁) (h₂ : Measurable f₂)
    (h₃ : Measurable f₃) {B : ℝ} (hb₁ : ∀ z, |f₁ z| ≤ B) (hb₂ : ∀ z, |f₂ z| ≤ B)
    (if₃ : Integrable f₃) {k₁ k₂ k₃ k₄ : ℝ → ℝ} (hk₁ : Measurable k₁) (hk₂ : Measurable k₂)
    (hk₃ : Measurable k₃) (hk₄ : Measurable k₄) (ik₁ : Integrable k₁) (ik₂ : Integrable k₂)
    (ik₃ : Integrable k₃) (ik₄ : Integrable k₄) {s σ : ℝ} (hs : 0 < s) (hσ : 0 < σ) :
    Integrable (fubW f₁ f₂ f₃ k₁ k₂ k₃ k₄ s σ) :=
  ((integrable_fubDom h₃ if₃ hk₁ hk₃ ik₁ ik₃ hs hσ).1.const_mul _).mono'
    (measurable_fubW h₁ h₂ h₃ hk₁ hk₂ hk₃ hk₄ s σ).aestronglyMeasurable
    (Eventually.of_forall fun v => by
      rw [Real.norm_eq_abs]; exact abs_fubW_le hb₁ hb₂ ik₂ ik₄ hs hσ v)

theorem integrable_fubW_slice {f₁ f₂ f₃ : ℝ × ℝ → ℝ} (h₁ : Measurable f₁) (h₂ : Measurable f₂)
    (h₃ : Measurable f₃) {B : ℝ} (hb₁ : ∀ z, |f₁ z| ≤ B) (hb₂ : ∀ z, |f₂ z| ≤ B)
    (hb₃ : ∀ z, |f₃ z| ≤ B) {k₁ k₂ k₃ k₄ : ℝ → ℝ} (hk₁ : Measurable k₁) (hk₂ : Measurable k₂)
    (hk₃ : Measurable k₃) (hk₄ : Measurable k₄) (ik₁ : Integrable k₁) (ik₂ : Integrable k₂)
    (ik₃ : Integrable k₃) (ik₄ : Integrable k₄) {s σ : ℝ} (hs : 0 < s) (hσ : 0 < σ)
    (pq : ℝ × ℝ) :
    Integrable (fun xy => fubW f₁ f₂ f₃ k₁ k₂ k₃ k₄ s σ (xy, pq)) (volume.prod volume) := by
  have hB : 0 ≤ B := (abs_nonneg _).trans (hb₁ 0)
  refine (((integrable_kernelAt_right ik₁ s pq.1).abs.mul_prod
    (integrable_kernelAt_right ik₃ σ pq.2).abs).const_mul
      ((B * ∫ u, |k₂ u|) * (B * ∫ u, |k₄ u|) * B)).mono' ?_ (Eventually.of_forall fun xy => ?_)
  · exact ((measurable_fubW h₁ h₂ h₃ hk₁ hk₂ hk₃ hk₄ s σ).comp
      (measurable_id.prodMk measurable_const)).aestronglyMeasurable
  · rw [Real.norm_eq_abs]
    refine (abs_fubW_le hb₁ hb₂ ik₂ ik₄ hs hσ (xy, pq)).trans (le_of_eq_of_le rfl ?_)
    unfold fubDom
    have h2 : 0 ≤ (B * ∫ u, |k₂ u|) * (B * ∫ u, |k₄ u|) :=
      mul_nonneg (mul_nonneg hB (integral_nonneg fun _ => abs_nonneg _))
        (mul_nonneg hB (integral_nonneg fun _ => abs_nonneg _))
    calc (B * ∫ u, |k₂ u|) * (B * ∫ u, |k₄ u|) *
          (|f₃ xy| * (|kernelAt k₁ s pq.1 xy.1| * |kernelAt k₃ σ pq.2 xy.2|))
        ≤ (B * ∫ u, |k₂ u|) * (B * ∫ u, |k₄ u|) *
          (B * (|kernelAt k₁ s pq.1 xy.1| * |kernelAt k₃ σ pq.2 xy.2|)) := by
          gcongr; exact hb₃ _
      _ = _ := by ring

/-- `quadForm` with `f_4 = 1` and kernels at `(s, p)`, `(σ, q)` as an integral of `fubW`. -/
theorem quadForm_kernelAt_eq_fubW {f₁ f₂ f₃ : ℝ × ℝ → ℝ} (h₁ : Measurable f₁)
    (h₂ : Measurable f₂) (h₃ : Measurable f₃) {B : ℝ} (hb₁ : ∀ z, |f₁ z| ≤ B)
    (hb₂ : ∀ z, |f₂ z| ≤ B) (hb₃ : ∀ z, |f₃ z| ≤ B) {k₁ k₂ k₃ k₄ : ℝ → ℝ}
    (hk₁ : Measurable k₁) (hk₂ : Measurable k₂) (hk₃ : Measurable k₃) (hk₄ : Measurable k₄)
    (ik₁ : Integrable k₁) (ik₂ : Integrable k₂) (ik₃ : Integrable k₃) (ik₄ : Integrable k₄)
    {s σ : ℝ} (hs : 0 < s) (hσ : 0 < σ) (p q : ℝ) :
    quadForm f₁ f₂ f₃ (fun _ => 1) (kernelAt k₁ s p) (kernelAt k₂ s p) (kernelAt k₃ σ q)
      (kernelAt k₄ σ q) = ∫ xy, fubW f₁ f₂ f₃ k₁ k₂ k₃ k₄ s σ (xy, (p, q)) := by
  rw [quadForm_one_eq h₁ h₃ hb₁ hb₃ (integrable_kernelAt_right ik₂ s p)
    (integrable_kernelAt_right ik₃ σ q)]
  exact (integral_prod _ (integrable_fubW_slice h₁ h₂ h₃ hb₁ hb₂ hb₃ hk₁ hk₂ hk₃ hk₄
    ik₁ ik₂ ik₃ ik₄ hs hσ (p, q))).symm

theorem integrable_quadForm_kernelAt {f₁ f₂ f₃ : ℝ × ℝ → ℝ} (h₁ : Measurable f₁)
    (h₂ : Measurable f₂) (h₃ : Measurable f₃) {B : ℝ} (hb₁ : ∀ z, |f₁ z| ≤ B)
    (hb₂ : ∀ z, |f₂ z| ≤ B) (hb₃ : ∀ z, |f₃ z| ≤ B) (if₃ : Integrable f₃) {k₁ k₂ k₃ k₄ : ℝ → ℝ}
    (hk₁ : Measurable k₁) (hk₂ : Measurable k₂) (hk₃ : Measurable k₃) (hk₄ : Measurable k₄)
    (ik₁ : Integrable k₁) (ik₂ : Integrable k₂) (ik₃ : Integrable k₃) (ik₄ : Integrable k₄)
    {s σ : ℝ} (hs : 0 < s) (hσ : 0 < σ) :
    Integrable fun pq : ℝ × ℝ => quadForm f₁ f₂ f₃ (fun _ => 1) (kernelAt k₁ s pq.1)
      (kernelAt k₂ s pq.1) (kernelAt k₃ σ pq.2) (kernelAt k₄ σ pq.2) := by
  have hW := integrable_fubW h₁ h₂ h₃ hb₁ hb₂ if₃ hk₁ hk₂ hk₃ hk₄ ik₁ ik₂ ik₃ ik₄ hs hσ
  rw [Measure.volume_eq_prod (α := ℝ × ℝ)] at hW
  refine hW.integral_prod_right.congr (Eventually.of_forall fun pq => ?_)
  exact (quadForm_kernelAt_eq_fubW h₁ h₂ h₃ hb₁ hb₂ hb₃ hk₁ hk₂ hk₃ hk₄ ik₁ ik₂ ik₃ ik₄ hs hσ
    pq.1 pq.2).symm

/-- **Fubini in `(p, q)`**: for `s, σ > 0`,
`∫∫ Λ(f_1, f_2, f_3, 1; (k_1)_{s,p}, (k_2)_{s,p}, (k_3)_{σ,q}, (k_4)_{σ,q}) dp dq =
∫ f_3(z) (∫ f_1(x', z_2) (corrK k_1 k_2)_{s,x'}(z_1) dx')
(∫ f_2(z_1, y') (corrK k_3 k_4)_{σ,y'}(z_2) dy') dz`. -/
theorem integral_integral_quadForm_kernelAt {f₁ f₂ f₃ : ℝ × ℝ → ℝ} (h₁ : Measurable f₁)
    (h₂ : Measurable f₂) (h₃ : Measurable f₃) {B : ℝ} (hb₁ : ∀ z, |f₁ z| ≤ B)
    (hb₂ : ∀ z, |f₂ z| ≤ B) (hb₃ : ∀ z, |f₃ z| ≤ B) (if₃ : Integrable f₃) {k₁ k₂ k₃ k₄ : ℝ → ℝ}
    (hk₁ : Measurable k₁) (hk₂ : Measurable k₂) (hk₃ : Measurable k₃) (hk₄ : Measurable k₄)
    (ik₁ : Integrable k₁) (ik₂ : Integrable k₂) (ik₃ : Integrable k₃) (ik₄ : Integrable k₄)
    {s σ : ℝ} (hs : 0 < s) (hσ : 0 < σ) :
    ∫ p, ∫ q, quadForm f₁ f₂ f₃ (fun _ => 1) (kernelAt k₁ s p) (kernelAt k₂ s p)
      (kernelAt k₃ σ q) (kernelAt k₄ σ q) =
    ∫ z, f₃ z * (∫ x', f₁ (x', z.2) * kernelAt (corrK k₁ k₂) s x' z.1) *
      (∫ y', f₂ (z.1, y') * kernelAt (corrK k₃ k₄) σ y' z.2) := by
  have hW := integrable_fubW h₁ h₂ h₃ hb₁ hb₂ if₃ hk₁ hk₂ hk₃ hk₄ ik₁ ik₂ ik₃ ik₄ hs hσ
  rw [Measure.volume_eq_prod (α := ℝ × ℝ)] at hW
  have hQ := integrable_quadForm_kernelAt h₁ h₂ h₃ hb₁ hb₂ hb₃ if₃ hk₁ hk₂ hk₃ hk₄
    ik₁ ik₂ ik₃ ik₄ hs hσ
  rw [Measure.volume_eq_prod] at hQ
  have hpt : ∀ xy : ℝ × ℝ, ∫ pq : ℝ × ℝ, fubW f₁ f₂ f₃ k₁ k₂ k₃ k₄ s σ (xy, pq) =
      f₃ xy * (∫ x', f₁ (x', xy.2) * kernelAt (corrK k₁ k₂) s x' xy.1) *
        (∫ y', f₂ (xy.1, y') * kernelAt (corrK k₃ k₄) σ y' xy.2) := by
    intro xy
    unfold fubW
    simp only
    rw [integral_const_mul, Measure.volume_eq_prod,
      integral_prod_mul (fun p => kernelAt k₁ s p xy.1 * ∫ x', f₁ (x', xy.2) * kernelAt k₂ s p x')
        (fun q => kernelAt k₃ σ q xy.2 * ∫ y', f₂ (xy.1, y') * kernelAt k₄ σ q y'),
      integral_kernelAt_mul_integral (g := fun x' => f₁ (x', xy.2))
        (h₁.comp (measurable_id.prodMk measurable_const)) (fun _ => hb₁ _) hk₁ hk₂ ik₁ ik₂ hs,
      integral_kernelAt_mul_integral (g := fun y' => f₂ (xy.1, y'))
        (h₂.comp (measurable_const.prodMk measurable_id)) (fun _ => hb₂ _) hk₃ hk₄ ik₃ ik₄ hσ]
    ring
  calc ∫ p, ∫ q, quadForm f₁ f₂ f₃ (fun _ => 1) (kernelAt k₁ s p) (kernelAt k₂ s p)
        (kernelAt k₃ σ q) (kernelAt k₄ σ q)
      = ∫ pq : ℝ × ℝ, quadForm f₁ f₂ f₃ (fun _ => 1) (kernelAt k₁ s pq.1) (kernelAt k₂ s pq.1)
          (kernelAt k₃ σ pq.2) (kernelAt k₄ σ pq.2) := (integral_prod _ hQ).symm
    _ = ∫ pq : ℝ × ℝ, ∫ xy : ℝ × ℝ, fubW f₁ f₂ f₃ k₁ k₂ k₃ k₄ s σ (xy, pq) :=
        integral_congr_ae (Eventually.of_forall fun pq =>
          quadForm_kernelAt_eq_fubW h₁ h₂ h₃ hb₁ hb₂ hb₃ hk₁ hk₂ hk₃ hk₄ ik₁ ik₂ ik₃ ik₄ hs hσ
            pq.1 pq.2)
    _ = ∫ v, fubW f₁ f₂ f₃ k₁ k₂ k₃ k₄ s σ v := (integral_prod_symm _ hW).symm
    _ = ∫ xy : ℝ × ℝ, ∫ pq : ℝ × ℝ, fubW f₁ f₂ f₃ k₁ k₂ k₃ k₄ s σ (xy, pq) :=
        integral_prod _ hW
    _ = _ := integral_congr_ae (Eventually.of_forall hpt)

/-- `∫∫ |Λ(...; (k_1)_{s,p}, ..., (k_4)_{σ,q})| dp dq ≤ B^2 ‖f_3‖_1 ∏ ‖k_i‖_1`, uniformly in
`s, σ > 0`. -/
theorem integral_abs_quadForm_kernelAt_le {f₁ f₂ f₃ : ℝ × ℝ → ℝ} (h₁ : Measurable f₁)
    (h₂ : Measurable f₂) (h₃ : Measurable f₃) {B : ℝ} (hb₁ : ∀ z, |f₁ z| ≤ B)
    (hb₂ : ∀ z, |f₂ z| ≤ B) (hb₃ : ∀ z, |f₃ z| ≤ B) (if₃ : Integrable f₃) {k₁ k₂ k₃ k₄ : ℝ → ℝ}
    (hk₁ : Measurable k₁) (hk₂ : Measurable k₂) (hk₃ : Measurable k₃) (hk₄ : Measurable k₄)
    (ik₁ : Integrable k₁) (ik₂ : Integrable k₂) (ik₃ : Integrable k₃) (ik₄ : Integrable k₄)
    {s σ : ℝ} (hs : 0 < s) (hσ : 0 < σ) :
    ∫ pq : ℝ × ℝ, |quadForm f₁ f₂ f₃ (fun _ => 1) (kernelAt k₁ s pq.1) (kernelAt k₂ s pq.1)
      (kernelAt k₃ σ pq.2) (kernelAt k₄ σ pq.2)| ≤
    (B * ∫ u, |k₂ u|) * (B * ∫ u, |k₄ u|) *
      ((∫ z, |f₃ z|) * ((∫ u, |k₁ u|) * ∫ u, |k₃ u|)) := by
  have hW := integrable_fubW h₁ h₂ h₃ hb₁ hb₂ if₃ hk₁ hk₂ hk₃ hk₄ ik₁ ik₂ ik₃ ik₄ hs hσ
  obtain ⟨hD, hDi⟩ := integrable_fubDom h₃ if₃ hk₁ hk₃ ik₁ ik₃ hs hσ
  rw [← hDi, ← integral_const_mul]
  have hWa : Integrable (fun v => |fubW f₁ f₂ f₃ k₁ k₂ k₃ k₄ s σ v|) := hW.abs
  rw [Measure.volume_eq_prod (α := ℝ × ℝ)] at hWa
  calc ∫ pq : ℝ × ℝ, |quadForm f₁ f₂ f₃ (fun _ => 1) (kernelAt k₁ s pq.1) (kernelAt k₂ s pq.1)
        (kernelAt k₃ σ pq.2) (kernelAt k₄ σ pq.2)|
      ≤ ∫ pq : ℝ × ℝ, ∫ xy : ℝ × ℝ, |fubW f₁ f₂ f₃ k₁ k₂ k₃ k₄ s σ (xy, pq)| := by
        refine integral_mono (integrable_quadForm_kernelAt h₁ h₂ h₃ hb₁ hb₂ hb₃ if₃ hk₁ hk₂ hk₃
          hk₄ ik₁ ik₂ ik₃ ik₄ hs hσ).abs hWa.integral_prod_right fun pq => ?_
        simp only
        rw [quadForm_kernelAt_eq_fubW h₁ h₂ h₃ hb₁ hb₂ hb₃ hk₁ hk₂ hk₃ hk₄ ik₁ ik₂ ik₃ ik₄ hs hσ]
        exact abs_integral_le_integral_abs
    _ = ∫ v, |fubW f₁ f₂ f₃ k₁ k₂ k₃ k₄ s σ v| := (integral_prod_symm _ hWa).symm
    _ ≤ _ := integral_mono hW.abs (hD.const_mul _) fun v => abs_fubW_le hb₁ hb₂ ik₂ ik₄ hs hσ v

/-- The uniform bound `|Λ(...; (k_1)_{s,p}, ..., (k_4)_{σ,q})| ≤ B^3 ∏ ‖k_i‖_1`. -/
theorem abs_quadForm_kernelAt_le {f₁ f₂ f₃ : ℝ × ℝ → ℝ} (h₁ : Measurable f₁)
    (h₂ : Measurable f₂) (h₃ : Measurable f₃) {B : ℝ} (hb₁ : ∀ z, |f₁ z| ≤ B)
    (hb₂ : ∀ z, |f₂ z| ≤ B) (hb₃ : ∀ z, |f₃ z| ≤ B) {k₁ k₂ k₃ k₄ : ℝ → ℝ}
    (hk₁ : Measurable k₁) (hk₂ : Measurable k₂) (hk₃ : Measurable k₃) (hk₄ : Measurable k₄)
    (ik₁ : Integrable k₁) (ik₂ : Integrable k₂) (ik₃ : Integrable k₃) (ik₄ : Integrable k₄)
    {s σ : ℝ} (hs : 0 < s) (hσ : 0 < σ) (p q : ℝ) :
    |quadForm f₁ f₂ f₃ (fun _ => 1) (kernelAt k₁ s p) (kernelAt k₂ s p) (kernelAt k₃ σ q)
      (kernelAt k₄ σ q)| ≤
    (B * ∫ u, |k₂ u|) * (B * ∫ u, |k₄ u|) * (B * ((∫ u, |k₁ u|) * ∫ u, |k₃ u|)) := by
  have hB : 0 ≤ B := (abs_nonneg _).trans (hb₁ 0)
  rw [quadForm_kernelAt_eq_fubW h₁ h₂ h₃ hb₁ hb₂ hb₃ hk₁ hk₂ hk₃ hk₄ ik₁ ik₂ ik₃ ik₄ hs hσ]
  have hdom : Integrable (fun xy : ℝ × ℝ => (B * ∫ u, |k₂ u|) * (B * ∫ u, |k₄ u|) *
      (B * (|kernelAt k₁ s p xy.1| * |kernelAt k₃ σ q xy.2|))) (volume.prod volume) :=
    (((integrable_kernelAt_right ik₁ s p).abs.mul_prod
      (integrable_kernelAt_right ik₃ σ q).abs).const_mul B).const_mul _
  rw [← Real.norm_eq_abs]
  refine (norm_integral_le_of_norm_le hdom (Eventually.of_forall fun xy => ?_)).trans
    (le_of_eq ?_)
  · rw [Real.norm_eq_abs]
    refine (abs_fubW_le hb₁ hb₂ ik₂ ik₄ hs hσ (xy, (p, q))).trans ?_
    unfold fubDom
    gcongr; exact hb₃ _
  · rw [integral_const_mul, integral_const_mul,
      integral_prod_mul (fun x => |kernelAt k₁ s p x|) (fun y => |kernelAt k₃ σ q y|),
      integral_abs_kernelAt_right k₁ hs, integral_abs_kernelAt_right k₃ hσ]

/-! ### The limiting argument -/

theorem measurable_quadForm_of_param {W : Type*} [MeasurableSpace W] {f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ}
    (h₁ : Measurable f₁) (h₂ : Measurable f₂) (h₃ : Measurable f₃) (h₄ : Measurable f₄)
    {K₁ K₂ K₃ K₄ : W → ℝ → ℝ} (hK₁ : Measurable (Function.uncurry K₁))
    (hK₂ : Measurable (Function.uncurry K₂)) (hK₃ : Measurable (Function.uncurry K₃))
    (hK₄ : Measurable (Function.uncurry K₄)) :
    Measurable fun w => quadForm f₁ f₂ f₃ f₄ (K₁ w) (K₂ w) (K₃ w) (K₄ w) := by
  unfold quadForm quadF
  have m0 : Measurable fun q : (((W × ℝ) × ℝ) × ℝ) × ℝ =>
      f₁ (q.1.1.2, q.1.2) * f₂ (q.1.1.1.2, q.2) * f₃ (q.1.1.1.2, q.1.2) * f₄ (q.1.1.2, q.2) *
        (K₁ q.1.1.1.1 q.1.1.1.2 * K₂ q.1.1.1.1 q.1.1.2 *
          (K₃ q.1.1.1.1 q.1.2 * K₄ q.1.1.1.1 q.2)) := by
    have a1 : Measurable fun q : (((W × ℝ) × ℝ) × ℝ) × ℝ => q.1.1.1.1 :=
      measurable_fst.fst.fst.fst
    have ax : Measurable fun q : (((W × ℝ) × ℝ) × ℝ) × ℝ => q.1.1.1.2 :=
      measurable_fst.fst.fst.snd
    have ax' : Measurable fun q : (((W × ℝ) × ℝ) × ℝ) × ℝ => q.1.1.2 := measurable_fst.fst.snd
    have ay : Measurable fun q : (((W × ℝ) × ℝ) × ℝ) × ℝ => q.1.2 := measurable_fst.snd
    have ay' : Measurable fun q : (((W × ℝ) × ℝ) × ℝ) × ℝ => q.2 := measurable_snd
    refine ((((h₁.comp (ax'.prodMk ay)).mul (h₂.comp (ax.prodMk ay'))).mul
      (h₃.comp (ax.prodMk ay))).mul (h₄.comp (ax'.prodMk ay'))).mul ?_
    exact ((hK₁.comp (a1.prodMk ax)).mul (hK₂.comp (a1.prodMk ax'))).mul
      ((hK₃.comp (a1.prodMk ay)).mul (hK₄.comp (a1.prodMk ay')))
  have m1 := measurable_integral_of_uncurry (G := fun (q : ((W × ℝ) × ℝ) × ℝ) y' =>
    f₁ (q.1.2, q.2) * f₂ (q.1.1.2, y') * f₃ (q.1.1.2, q.2) * f₄ (q.1.2, y') *
      (K₁ q.1.1.1 q.1.1.2 * K₂ q.1.1.1 q.1.2 * (K₃ q.1.1.1 q.2 * K₄ q.1.1.1 y'))) m0
  have m2 := measurable_integral_of_uncurry (G := fun (q : (W × ℝ) × ℝ) y => ∫ y',
    f₁ (q.2, y) * f₂ (q.1.2, y') * f₃ (q.1.2, y) * f₄ (q.2, y') *
      (K₁ q.1.1 q.1.2 * K₂ q.1.1 q.2 * (K₃ q.1.1 y * K₄ q.1.1 y'))) m1
  have m3 := measurable_integral_of_uncurry (G := fun (q : W × ℝ) x' => ∫ y, ∫ y',
    f₁ (x', y) * f₂ (q.2, y') * f₃ (q.2, y) * f₄ (x', y') *
      (K₁ q.1 q.2 * K₂ q.1 x' * (K₃ q.1 y * K₄ q.1 y'))) m2
  exact measurable_integral_of_uncurry (G := fun w x => ∫ x', ∫ y, ∫ y',
    f₁ (x', y) * f₂ (x, y') * f₃ (x, y) * f₄ (x', y') *
      (K₁ w x * K₂ w x' * (K₃ w y * K₄ w y'))) m3

/-- The integrand of the localized form with `f_4 = 1`. -/
def locG (α β : ℕ) (c : ℝ → ℝ) (k₁ k₂ k₃ k₄ : ℝ → ℝ) (f₁ f₂ f₃ : ℝ × ℝ → ℝ) (t p q : ℝ) : ℝ :=
  c t * quadForm f₁ f₂ f₃ (fun _ => 1) (kernelAt k₁ (t ^ α) p) (kernelAt k₂ (t ^ α) p)
    (kernelAt k₃ (t ^ β) q) (kernelAt k₄ (t ^ β) q)

theorem locForm_eq_collInt_locG (α β : ℕ) (𝒬 : Finset DyRect) (c : ℝ → ℝ)
    (k₁ k₂ k₃ k₄ : ℝ → ℝ) (f₁ f₂ f₃ : ℝ × ℝ → ℝ) :
    locForm α β 𝒬 c k₁ k₂ k₃ k₄ f₁ f₂ f₃ (fun _ => 1) =
      collInt α β 𝒬 (locG α β c k₁ k₂ k₃ k₄ f₁ f₂ f₃) := rfl

theorem measurable_locG (α β : ℕ) {c : ℝ → ℝ} (hc : Measurable c) {f₁ f₂ f₃ : ℝ × ℝ → ℝ}
    (h₁ : Measurable f₁) (h₂ : Measurable f₂) (h₃ : Measurable f₃) {k₁ k₂ k₃ k₄ : ℝ → ℝ}
    (hk₁ : Measurable k₁) (hk₂ : Measurable k₂) (hk₃ : Measurable k₃) (hk₄ : Measurable k₄) :
    Measurable fun z : ℝ × ℝ × ℝ => locG α β c k₁ k₂ k₃ k₄ f₁ f₂ f₃ z.1 z.2.1 z.2.2 := by
  unfold locG
  refine (hc.comp measurable_fst).mul ?_
  exact measurable_quadForm_of_param (W := ℝ × ℝ × ℝ) h₁ h₂ h₃ measurable_const
    (K₁ := fun w => kernelAt k₁ (w.1 ^ α) w.2.1) (K₂ := fun w => kernelAt k₂ (w.1 ^ α) w.2.1)
    (K₃ := fun w => kernelAt k₃ (w.1 ^ β) w.2.2) (K₄ := fun w => kernelAt k₄ (w.1 ^ β) w.2.2)
    (measurable_kernelAt_comp hk₁ (measurable_fst.fst.pow_const α) measurable_fst.snd.fst
      measurable_snd)
    (measurable_kernelAt_comp hk₂ (measurable_fst.fst.pow_const α) measurable_fst.snd.fst
      measurable_snd)
    (measurable_kernelAt_comp hk₃ (measurable_fst.fst.pow_const β) measurable_fst.snd.snd
      measurable_snd)
    (measurable_kernelAt_comp hk₄ (measurable_fst.fst.pow_const β) measurable_fst.snd.snd
      measurable_snd)

theorem abs_locG_le (α β : ℕ) {c : ℝ → ℝ} {Cc : ℝ} (hcb : ∀ t, |c t| ≤ Cc)
    {f₁ f₂ f₃ : ℝ × ℝ → ℝ} (h₁ : Measurable f₁) (h₂ : Measurable f₂) (h₃ : Measurable f₃)
    {B : ℝ} (hb₁ : ∀ z, |f₁ z| ≤ B) (hb₂ : ∀ z, |f₂ z| ≤ B) (hb₃ : ∀ z, |f₃ z| ≤ B)
    {k₁ k₂ k₃ k₄ : ℝ → ℝ}
    (hk₁ : Measurable k₁) (hk₂ : Measurable k₂) (hk₃ : Measurable k₃) (hk₄ : Measurable k₄)
    (ik₁ : Integrable k₁) (ik₂ : Integrable k₂) (ik₃ : Integrable k₃) (ik₄ : Integrable k₄)
    (t : ℝ) (ht : 0 < t) (p q : ℝ) :
    |locG α β c k₁ k₂ k₃ k₄ f₁ f₂ f₃ t p q| ≤
      Cc * ((B * ∫ u, |k₂ u|) * (B * ∫ u, |k₄ u|) * (B * ((∫ u, |k₁ u|) * ∫ u, |k₃ u|))) := by
  unfold locG
  rw [abs_mul]
  exact mul_le_mul (hcb t) (abs_quadForm_kernelAt_le h₁ h₂ h₃ hb₁ hb₂ hb₃ hk₁ hk₂ hk₃ hk₄
    ik₁ ik₂ ik₃ ik₄ (pow_pos ht α) (pow_pos ht β) p q) (abs_nonneg _)
    ((abs_nonneg _).trans (hcb 0))

/-- The localized form over `boxColl` as an integral over `(2^{K₁}/2, 2^{K₂}] × box`. -/
theorem locForm_boxColl_eq (α β : ℕ) (K₁ K₂ : ℤ) (M : ℕ) {c : ℝ → ℝ} (hc : Measurable c)
    {Cc : ℝ} (hcb : ∀ t, |c t| ≤ Cc)
    {f₁ f₂ f₃ : ℝ × ℝ → ℝ} (h₁ : Measurable f₁) (h₂ : Measurable f₂) (h₃ : Measurable f₃)
    {B : ℝ} (hb₁ : ∀ z, |f₁ z| ≤ B) (hb₂ : ∀ z, |f₂ z| ≤ B) (hb₃ : ∀ z, |f₃ z| ≤ B)
    {k₁ k₂ k₃ k₄ : ℝ → ℝ}
    (hk₁ : Measurable k₁) (hk₂ : Measurable k₂) (hk₃ : Measurable k₃) (hk₄ : Measurable k₄)
    (ik₁ : Integrable k₁) (ik₂ : Integrable k₂) (ik₃ : Integrable k₃) (ik₄ : Integrable k₄) :
    locForm α β (boxColl α β K₁ K₂ M) c k₁ k₂ k₃ k₄ f₁ f₂ f₃ (fun _ => 1) =
      ∫ z in Ioc ((2 : ℝ) ^ K₁ / 2) (2 ^ K₂) ×ˢ boxRegion α β K₂ M,
        z.1⁻¹ * locG α β c k₁ k₂ k₃ k₄ f₁ f₂ f₃ z.1 z.2.1 z.2.2 :=
  collInt_boxColl_eq_setIntegral α β K₁ K₂ M (measurable_locG α β hc h₁ h₂ h₃ hk₁ hk₂ hk₃ hk₄)
    (abs_locG_le α β hcb h₁ h₂ h₃ hb₁ hb₂ hb₃ hk₁ hk₂ hk₃ hk₄ ik₁ ik₂ ik₃ ik₄)

theorem boxX_mono (α : ℕ) (K₂ : ℤ) : Monotone (boxX α K₂) := by
  intro M M' h
  unfold boxX
  have : (M : ℝ) ≤ M' := by exact_mod_cast h
  have h0 : (0 : ℝ) < 2 ^ (K₂ * α) := by positivity
  nlinarith

theorem boxRegion_mono (α β : ℕ) (K₂ : ℤ) : Monotone (boxRegion α β K₂) := by
  intro M M' h
  unfold boxRegion
  have h1 := boxX_mono α K₂ h
  have h2 := boxX_mono β K₂ h
  exact Set.prod_mono (Set.Ico_subset_Ico (by linarith) h1) (Set.Ico_subset_Ico (by linarith) h2)

theorem exists_nat_mem_Ico_boxX (α : ℕ) (K₂ : ℤ) (p : ℝ) :
    ∃ M : ℕ, p ∈ Ico (-boxX α K₂ M) (boxX α K₂ M) := by
  have h0 : (0 : ℝ) < 2 ^ (K₂ * α) := by positivity
  obtain ⟨M, hM⟩ := exists_nat_gt (|p| / 2 ^ (K₂ * α))
  refine ⟨M, ?_, ?_⟩ <;> unfold boxX <;> rw [div_lt_iff₀ h0] at hM
  · linarith [neg_abs_le p]
  · linarith [le_abs_self p]

theorem iUnion_boxRegion (α β : ℕ) (K₂ : ℤ) : ⋃ M, boxRegion α β K₂ M = univ := by
  refine Set.eq_univ_of_forall fun pq => ?_
  obtain ⟨M₁, h₁⟩ := exists_nat_mem_Ico_boxX α K₂ pq.1
  obtain ⟨M₂, h₂⟩ := exists_nat_mem_Ico_boxX β K₂ pq.2
  refine Set.mem_iUnion.2 ⟨max M₁ M₂, ?_, ?_⟩
  · have hm := boxX_mono α K₂ (le_max_left M₁ M₂)
    exact Set.Ico_subset_Ico (neg_le_neg hm) hm h₁
  · have hm := boxX_mono β K₂ (le_max_right M₁ M₂)
    exact Set.Ico_subset_Ico (neg_le_neg hm) hm h₂

/-! ### Ancestor convexity of `boxColl` -/

theorem Ico_subset_parent {s : ℝ} (hs : 0 < s) (m : ℤ) {d : ℤ} (hd : 0 < d) :
    Ico ((m : ℝ) * s) (m * s + s) ⊆
      Ico (((m / d : ℤ) : ℝ) * (d * s)) ((m / d : ℤ) * (d * s) + d * s) := by
  have h1 : m / d * d ≤ m := Int.ediv_mul_le m hd.ne'
  have h2 : m < (m / d + 1) * d := Int.lt_ediv_add_one_mul_self m hd
  have e1 : ((m / d : ℤ) : ℝ) * d ≤ m := by exact_mod_cast h1
  have e2 : (m : ℝ) + 1 ≤ ((m / d : ℤ) + 1) * d := by
    have : m + 1 ≤ (m / d + 1) * d := h2
    exact_mod_cast this
  intro p hp
  constructor
  · nlinarith [hp.1]
  · nlinarith [hp.2]

theorem toSet_subset_parent (α β : ℕ) (Q : DyRect) :
    Q.toSet α β ⊆ (DyRect.parent α β Q).toSet α β := by
  unfold DyRect.toSet
  refine Set.prod_mono ?_ ?_
  · rw [DyRect.ix_eq_box, DyRect.ix_eq_box]
    have e : (DyRect.parent α β Q).sx α = ((2 ^ α : ℤ) : ℝ) * Q.sx α := by
      simp only [DyRect.sx, DyRect.parent]
      push_cast
      rw [← zpow_natCast, ← zpow_add₀ (by norm_num)]
      congr 1; ring
    rw [e]
    exact Ico_subset_parent (Q.sx_pos α) Q.m (by positivity)
  · rw [DyRect.iy_eq_box, DyRect.iy_eq_box]
    have e : (DyRect.parent α β Q).sy β = ((2 ^ β : ℤ) : ℝ) * Q.sy β := by
      simp only [DyRect.sy, DyRect.parent]
      push_cast
      rw [← zpow_natCast, ← zpow_add₀ (by norm_num)]
      congr 1; ring
    rw [e]
    exact Ico_subset_parent (Q.sy_pos β) Q.n (by positivity)

theorem toSet_subset_anc (α β : ℕ) (j : ℕ) (Q : DyRect) :
    Q.toSet α β ⊆ (DyRect.anc α β j Q).toSet α β := by
  induction j with
  | zero => exact le_refl _
  | succ j ih => exact ih.trans (toSet_subset_parent α β _)

/-- `boxColl` is convex in the sense of trees: if an ancestor of `Q ∈ boxColl` lies in `boxColl`,
then so do all intermediate ancestors. -/
theorem boxColl_ancConvex {α β : ℕ} {K₁ K₂ : ℤ} {M : ℕ} :
    ∀ Q ∈ boxColl α β K₁ K₂ M, ∀ i j : ℕ, DyRect.anc α β (i + j) Q ∈ boxColl α β K₁ K₂ M →
      DyRect.anc α β i Q ∈ boxColl α β K₁ K₂ M := by
  intro Q hQ i j h
  have hl := (mem_boxColl.1 hQ).1
  have hl' := (mem_boxColl.1 h).2.1
  rw [DyRect.anc_lev] at hl'
  refine mem_boxColl_of_subset ?_ ?_ ?_
  · rw [DyRect.anc_lev]; omega
  · rw [DyRect.anc_lev]; push_cast at hl'; omega
  · have e : DyRect.anc α β (i + j) Q = DyRect.anc α β j (DyRect.anc α β i Q) := by
      rw [add_comm, DyRect.anc_add]
    rw [e] at h
    exact (toSet_subset_anc α β j _).trans (toSet_subset_boxRegion h)

/-- `∫ f_1(x', z_2) φ_{s,x'}(z_1) dx'`. -/
def phiA (f₁ : ℝ × ℝ → ℝ) (φ : ℝ → ℝ) (s : ℝ) (z : ℝ × ℝ) : ℝ :=
  ∫ x', f₁ (x', z.2) * kernelAt φ s x' z.1

/-- `∫ f_2(z_1, y') ρ_{σ,y'}(z_2) dy'`. -/
def phiB (f₂ : ℝ × ℝ → ℝ) (ρ : ℝ → ℝ) (σ : ℝ) (z : ℝ × ℝ) : ℝ :=
  ∫ y', f₂ (z.1, y') * kernelAt ρ σ y' z.2

theorem measurable_phiA (α : ℕ) {f₁ : ℝ × ℝ → ℝ} (h₁ : Measurable f₁) {φ : ℝ → ℝ}
    (hφ : Measurable φ) : Measurable fun v : ℝ × (ℝ × ℝ) => phiA f₁ φ (v.1 ^ α) v.2 :=
  measurable_integral_of_uncurry (G := fun (v : ℝ × (ℝ × ℝ)) x' =>
    f₁ (x', v.2.2) * kernelAt φ (v.1 ^ α) x' v.2.1)
    ((h₁.comp (measurable_snd.prodMk measurable_fst.snd.snd)).mul
      (measurable_kernelAt_comp hφ (measurable_fst.fst.pow_const α) measurable_snd
        measurable_fst.snd.fst))

theorem measurable_phiB (β : ℕ) {f₂ : ℝ × ℝ → ℝ} (h₂ : Measurable f₂) {ρ : ℝ → ℝ}
    (hρ : Measurable ρ) : Measurable fun v : ℝ × (ℝ × ℝ) => phiB f₂ ρ (v.1 ^ β) v.2 :=
  measurable_integral_of_uncurry (G := fun (v : ℝ × (ℝ × ℝ)) y' =>
    f₂ (v.2.1, y') * kernelAt ρ (v.1 ^ β) y' v.2.2)
    ((h₂.comp (measurable_fst.snd.fst.prodMk measurable_snd)).mul
      (measurable_kernelAt_comp hρ (measurable_fst.fst.pow_const β) measurable_snd
        measurable_fst.snd.snd))

theorem abs_phiA_le {f₁ : ℝ × ℝ → ℝ} {B : ℝ} (hb₁ : ∀ z, |f₁ z| ≤ B) {φ : ℝ → ℝ}
    (iφ : Integrable φ) {s : ℝ} (hs : 0 < s) (z : ℝ × ℝ) :
    |phiA f₁ φ s z| ≤ B * ∫ u, |φ u| :=
  abs_integral_mul_kernelAt_left_le (g := fun x' => f₁ (x', z.2)) (fun _ => hb₁ _) iφ hs z.1

theorem abs_phiB_le {f₂ : ℝ × ℝ → ℝ} {B : ℝ} (hb₂ : ∀ z, |f₂ z| ≤ B) {ρ : ℝ → ℝ}
    (iρ : Integrable ρ) {σ : ℝ} (hσ : 0 < σ) (z : ℝ × ℝ) :
    |phiB f₂ ρ σ z| ≤ B * ∫ u, |ρ u| :=
  abs_integral_mul_kernelAt_left_le (g := fun y' => f₂ (z.1, y')) (fun _ => hb₂ _) iρ hσ z.2

/-- Integrability of the cell integrand on `(a, b] × ℝ^2`, `a > 0`. -/
theorem integrableOn_locG (α β : ℕ) {c : ℝ → ℝ} (hc : Measurable c) {Cc : ℝ}
    (hcb : ∀ t, |c t| ≤ Cc)
    {f₁ f₂ f₃ : ℝ × ℝ → ℝ} (h₁ : Measurable f₁) (h₂ : Measurable f₂) (h₃ : Measurable f₃)
    {B : ℝ} (hb₁ : ∀ z, |f₁ z| ≤ B) (hb₂ : ∀ z, |f₂ z| ≤ B) (hb₃ : ∀ z, |f₃ z| ≤ B)
    (if₃ : Integrable f₃) {k₁ k₂ k₃ k₄ : ℝ → ℝ}
    (hk₁ : Measurable k₁) (hk₂ : Measurable k₂) (hk₃ : Measurable k₃) (hk₄ : Measurable k₄)
    (ik₁ : Integrable k₁) (ik₂ : Integrable k₂) (ik₃ : Integrable k₃) (ik₄ : Integrable k₄)
    {a : ℝ} (ha : 0 < a) (b : ℝ) :
    IntegrableOn (fun z : ℝ × ℝ × ℝ => z.1⁻¹ * locG α β c k₁ k₂ k₃ k₄ f₁ f₂ f₃ z.1 z.2.1 z.2.2)
      (Ioc a b ×ˢ univ) := by
  have hm : Measurable fun z : ℝ × ℝ × ℝ =>
      z.1⁻¹ * locG α β c k₁ k₂ k₃ k₄ f₁ f₂ f₃ z.1 z.2.1 z.2.2 :=
    measurable_fst.inv.mul (measurable_locG α β hc h₁ h₂ h₃ hk₁ hk₂ hk₃ hk₄)
  rw [IntegrableOn, Measure.volume_eq_prod, ← Measure.prod_restrict, Measure.restrict_univ]
  refine (integrable_prod_iff hm.aestronglyMeasurable).2 ⟨?_, ?_⟩
  · refine (ae_restrict_iff' measurableSet_Ioc).2 (Eventually.of_forall fun t ht => ?_)
    have ht0 : 0 < t := ha.trans ht.1
    have hQ := integrable_quadForm_kernelAt h₁ h₂ h₃ hb₁ hb₂ hb₃ if₃ hk₁ hk₂ hk₃ hk₄
      ik₁ ik₂ ik₃ ik₄ (pow_pos ht0 α) (pow_pos ht0 β)
    exact (hQ.const_mul (c t)).const_mul t⁻¹
  · refine Measure.integrableOn_of_bounded (M := a⁻¹ * (Cc * ((B * ∫ u, |k₂ u|) *
      (B * ∫ u, |k₄ u|) * ((∫ z, |f₃ z|) * ((∫ u, |k₁ u|) * ∫ u, |k₃ u|)))))
      (by rw [Real.volume_Ioc]; exact ENNReal.ofReal_ne_top) ?_ ?_
    · exact (measurable_integral_of_uncurry (G := fun (t : ℝ) (pq : ℝ × ℝ) =>
        ‖t⁻¹ * locG α β c k₁ k₂ k₃ k₄ f₁ f₂ f₃ t pq.1 pq.2‖) hm.norm).aestronglyMeasurable
    · refine (ae_restrict_iff' measurableSet_Ioc).2 (Eventually.of_forall fun t ht => ?_)
      have ht0 : 0 < t := ha.trans ht.1
      have e : (fun pq : ℝ × ℝ => ‖t⁻¹ * locG α β c k₁ k₂ k₃ k₄ f₁ f₂ f₃ t pq.1 pq.2‖) =
          fun pq => (t⁻¹ * |c t|) * |quadForm f₁ f₂ f₃ (fun _ => 1) (kernelAt k₁ (t ^ α) pq.1)
            (kernelAt k₂ (t ^ α) pq.1) (kernelAt k₃ (t ^ β) pq.2) (kernelAt k₄ (t ^ β) pq.2)| := by
        funext pq
        simp only [locG, Real.norm_eq_abs, abs_mul, abs_inv, abs_of_pos ht0]
        ring
      simp only
      rw [e, integral_const_mul, Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (by positivity)
        (integral_nonneg fun _ => abs_nonneg _))]
      have hCc : 0 ≤ Cc := (abs_nonneg _).trans (hcb 0)
      calc t⁻¹ * |c t| * ∫ pq : ℝ × ℝ, |quadForm f₁ f₂ f₃ (fun _ => 1) (kernelAt k₁ (t ^ α) pq.1)
            (kernelAt k₂ (t ^ α) pq.1) (kernelAt k₃ (t ^ β) pq.2) (kernelAt k₄ (t ^ β) pq.2)|
          ≤ a⁻¹ * Cc * ((B * ∫ u, |k₂ u|) * (B * ∫ u, |k₄ u|) *
            ((∫ z, |f₃ z|) * ((∫ u, |k₁ u|) * ∫ u, |k₃ u|))) := by
            refine mul_le_mul (mul_le_mul (inv_anti₀ ha ht.1.le) (hcb t) (abs_nonneg _)
              (inv_pos.2 ha).le) (integral_abs_quadForm_kernelAt_le h₁ h₂ h₃ hb₁ hb₂ hb₃ if₃
                hk₁ hk₂ hk₃ hk₄ ik₁ ik₂ ik₃ ik₄ (pow_pos ht0 α) (pow_pos ht0 β))
              (integral_nonneg fun _ => abs_nonneg _) (by positivity)
        _ = _ := by ring

/-- The limit over the exhausting boxes, iterated in `t` and then `(p, q)`. -/
theorem setIntegral_locG_univ (α β : ℕ) {c : ℝ → ℝ} (hc : Measurable c) {Cc : ℝ}
    (hcb : ∀ t, |c t| ≤ Cc)
    {f₁ f₂ f₃ : ℝ × ℝ → ℝ} (h₁ : Measurable f₁) (h₂ : Measurable f₂) (h₃ : Measurable f₃)
    {B : ℝ} (hb₁ : ∀ z, |f₁ z| ≤ B) (hb₂ : ∀ z, |f₂ z| ≤ B) (hb₃ : ∀ z, |f₃ z| ≤ B)
    (if₃ : Integrable f₃) {k₁ k₂ k₃ k₄ : ℝ → ℝ}
    (hk₁ : Measurable k₁) (hk₂ : Measurable k₂) (hk₃ : Measurable k₃) (hk₄ : Measurable k₄)
    (ik₁ : Integrable k₁) (ik₂ : Integrable k₂) (ik₃ : Integrable k₃) (ik₄ : Integrable k₄)
    {a : ℝ} (ha : 0 < a) (b : ℝ) :
    ∫ z : ℝ × ℝ × ℝ in Ioc a b ×ˢ univ, z.1⁻¹ * locG α β c k₁ k₂ k₃ k₄ f₁ f₂ f₃ z.1 z.2.1 z.2.2 =
      ∫ t in Ioc a b, t⁻¹ * (c t * ∫ z, f₃ z * phiA f₁ (corrK k₁ k₂) (t ^ α) z *
        phiB f₂ (corrK k₃ k₄) (t ^ β) z) := by
  have hI := integrableOn_locG α β hc hcb h₁ h₂ h₃ hb₁ hb₂ hb₃ if₃ hk₁ hk₂ hk₃ hk₄
    ik₁ ik₂ ik₃ ik₄ ha b
  rw [Measure.volume_eq_prod] at hI ⊢
  rw [setIntegral_prod _ hI]
  refine setIntegral_congr_fun measurableSet_Ioc fun t ht => ?_
  have ht0 : 0 < t := ha.trans ht.1
  have hQ := integrable_quadForm_kernelAt h₁ h₂ h₃ hb₁ hb₂ hb₃ if₃ hk₁ hk₂ hk₃ hk₄
    ik₁ ik₂ ik₃ ik₄ (pow_pos ht0 α) (pow_pos ht0 β)
  have e : ∫ pq : ℝ × ℝ, quadForm f₁ f₂ f₃ (fun _ => 1) (kernelAt k₁ (t ^ α) pq.1)
      (kernelAt k₂ (t ^ α) pq.1) (kernelAt k₃ (t ^ β) pq.2) (kernelAt k₄ (t ^ β) pq.2) =
      ∫ p, ∫ q, quadForm f₁ f₂ f₃ (fun _ => 1) (kernelAt k₁ (t ^ α) p) (kernelAt k₂ (t ^ α) p)
        (kernelAt k₃ (t ^ β) q) (kernelAt k₄ (t ^ β) q) := integral_prod _ hQ
  simp only [Measure.restrict_univ, locG]
  rw [integral_const_mul, integral_const_mul, e,
    integral_integral_quadForm_kernelAt h₁ h₂ h₃ hb₁ hb₂ hb₃ if₃ hk₁ hk₂ hk₃ hk₄
      ik₁ ik₂ ik₃ ik₄ (pow_pos ht0 α) (pow_pos ht0 β)]
  rfl

/-- Fubini in `t` versus `z`. -/
theorem integral_t_swap (α β : ℕ) {c : ℝ → ℝ} (hc : Measurable c) {Cc : ℝ}
    (hcb : ∀ t, |c t| ≤ Cc)
    {f₁ f₂ f₃ : ℝ × ℝ → ℝ} (h₁ : Measurable f₁) (h₂ : Measurable f₂) (h₃ : Measurable f₃)
    {B : ℝ} (hb₁ : ∀ z, |f₁ z| ≤ B) (hb₂ : ∀ z, |f₂ z| ≤ B)
    (if₃ : Integrable f₃) {φ ρ : ℝ → ℝ} (hφ : Measurable φ) (hρ : Measurable ρ)
    (iφ : Integrable φ) (iρ : Integrable ρ) {a : ℝ} (ha : 0 < a) (b : ℝ) :
    ∫ t in Ioc a b, t⁻¹ * (c t * ∫ z, f₃ z * phiA f₁ φ (t ^ α) z * phiB f₂ ρ (t ^ β) z) =
      ∫ z, f₃ z * ∫ t in Ioc a b, c t * (phiA f₁ φ (t ^ α) z * phiB f₂ ρ (t ^ β) z) / t := by
  have hB : 0 ≤ B := (abs_nonneg _).trans (hb₁ 0)
  have hCc : 0 ≤ Cc := (abs_nonneg _).trans (hcb 0)
  have hint : Integrable (Function.uncurry fun t z =>
      t⁻¹ * (c t * (f₃ z * phiA f₁ φ (t ^ α) z * phiB f₂ ρ (t ^ β) z)))
      ((volume.restrict (Ioc a b)).prod volume) := by
    have hm : Measurable (Function.uncurry fun t z =>
        t⁻¹ * (c t * (f₃ z * phiA f₁ φ (t ^ α) z * phiB f₂ ρ (t ^ β) z))) :=
      measurable_fst.inv.mul ((hc.comp measurable_fst).mul
        (((h₃.comp measurable_snd).mul (measurable_phiA α h₁ hφ)).mul (measurable_phiB β h₂ hρ)))
    have hdom : Integrable (fun v : ℝ × (ℝ × ℝ) =>
        (a⁻¹ * Cc * ((B * ∫ u, |φ u|) * (B * ∫ u, |ρ u|))) * |f₃ v.2|)
        ((volume.restrict (Ioc a b)).prod volume) :=
      (integrable_const _).mul_prod if₃.abs
    have hae : ∀ᵐ v : ℝ × (ℝ × ℝ) ∂((volume.restrict (Ioc a b)).prod volume), v.1 ∈ Ioc a b :=
      Measure.quasiMeasurePreserving_fst.ae (ae_restrict_mem measurableSet_Ioc)
    refine hdom.mono' hm.aestronglyMeasurable (hae.mono fun v hv => ?_)
    have ht0 : 0 < v.1 := ha.trans hv.1
    simp only [Function.uncurry, Real.norm_eq_abs, abs_mul, abs_inv, abs_of_pos ht0]
    have e1 := abs_phiA_le hb₁ iφ (pow_pos ht0 α) v.2
    have e2 := abs_phiB_le hb₂ iρ (pow_pos ht0 β) v.2
    calc v.1⁻¹ * (|c v.1| * (|f₃ v.2| * |phiA f₁ φ (v.1 ^ α) v.2| * |phiB f₂ ρ (v.1 ^ β) v.2|))
        ≤ a⁻¹ * (Cc * (|f₃ v.2| * (B * ∫ u, |φ u|) * (B * ∫ u, |ρ u|))) := by
          have hφ0 : 0 ≤ B * ∫ u, |φ u| := mul_nonneg hB (integral_nonneg fun _ => abs_nonneg _)
          gcongr
          · exact hv.1.le
          · exact hcb _
      _ = _ := by ring
  have e1 : ∀ t, t⁻¹ * (c t * ∫ z, f₃ z * phiA f₁ φ (t ^ α) z * phiB f₂ ρ (t ^ β) z) =
      ∫ z, t⁻¹ * (c t * (f₃ z * phiA f₁ φ (t ^ α) z * phiB f₂ ρ (t ^ β) z)) := by
    intro t; rw [integral_const_mul, integral_const_mul]
  simp_rw [e1]
  rw [integral_integral_swap hint]
  refine integral_congr_ae (Eventually.of_forall fun z => ?_)
  have e2 : ∀ t, t⁻¹ * (c t * (f₃ z * phiA f₁ φ (t ^ α) z * phiB f₂ ρ (t ^ β) z)) =
      f₃ z * (c t * (phiA f₁ φ (t ^ α) z * phiB f₂ ρ (t ^ β) z) / t) := by
    intro t; rw [div_eq_inv_mul]; ring
  simp_rw [e2]
  rw [integral_const_mul]

/-! ### The main limit -/

/-- **The limiting argument of §4.4.** As the box exhausts `ℝ^2`, the localized form over all
rectangles of the box with levels in `[K₁, K₂]` converges to the trilinear form of the model
operator with kernels `corrK k₁ k₂`, `corrK k₃ k₄`:
`Λ_{boxColl}(f_1, f_2, f_3, 1) → ∫ f_3(z) ∫_{2^{K₁}/2}^{2^{K₂}} c(t)
(f_1 *_1 (corrK k_1 k_2)_{t^α})(z) (f_2 *_2 (corrK k_3 k_4)_{t^β})(z) dt/t dz`. -/
theorem locForm_boxColl_tendsto (α β : ℕ) (K₁ K₂ : ℤ) {c : ℝ → ℝ} (hc : Measurable c)
    {Cc : ℝ} (hcb : ∀ t, |c t| ≤ Cc)
    {f₁ f₂ f₃ : ℝ × ℝ → ℝ} (h₁ : Measurable f₁) (h₂ : Measurable f₂) (h₃ : Measurable f₃)
    {B : ℝ} (hb₁ : ∀ z, |f₁ z| ≤ B) (hb₂ : ∀ z, |f₂ z| ≤ B) (hb₃ : ∀ z, |f₃ z| ≤ B)
    (if₃ : Integrable f₃) {k₁ k₂ k₃ k₄ : ℝ → ℝ}
    (hk₁ : Measurable k₁) (hk₂ : Measurable k₂) (hk₃ : Measurable k₃) (hk₄ : Measurable k₄)
    (ik₁ : Integrable k₁) (ik₂ : Integrable k₂) (ik₃ : Integrable k₃) (ik₄ : Integrable k₄) :
    Tendsto (fun M : ℕ => locForm α β (boxColl α β K₁ K₂ M) c k₁ k₂ k₃ k₄ f₁ f₂ f₃ (fun _ => 1))
      atTop (𝓝 (∫ z, f₃ z * ∫ t in Ioc ((2 : ℝ) ^ K₁ / 2) (2 ^ K₂),
        c t * ((∫ x', f₁ (x', z.2) * kernelAt (corrK k₁ k₂) (t ^ α) x' z.1) *
          (∫ y', f₂ (z.1, y') * kernelAt (corrK k₃ k₄) (t ^ β) y' z.2)) / t)) := by
  have ha : (0 : ℝ) < 2 ^ K₁ / 2 := by positivity
  have e : (fun M : ℕ => locForm α β (boxColl α β K₁ K₂ M) c k₁ k₂ k₃ k₄ f₁ f₂ f₃
      (fun _ => 1)) = fun M : ℕ => ∫ z in Ioc ((2 : ℝ) ^ K₁ / 2) (2 ^ K₂) ×ˢ boxRegion α β K₂ M,
        z.1⁻¹ * locG α β c k₁ k₂ k₃ k₄ f₁ f₂ f₃ z.1 z.2.1 z.2.2 :=
    funext fun M => locForm_boxColl_eq α β K₁ K₂ M hc hcb h₁ h₂ h₃ hb₁ hb₂ hb₃ hk₁ hk₂ hk₃ hk₄
      ik₁ ik₂ ik₃ ik₄
  rw [e]
  have hU : ⋃ M : ℕ, Ioc ((2 : ℝ) ^ K₁ / 2) (2 ^ K₂) ×ˢ boxRegion α β K₂ M =
      Ioc ((2 : ℝ) ^ K₁ / 2) (2 ^ K₂) ×ˢ univ := by
    rw [← Set.prod_iUnion, iUnion_boxRegion]
  have hI := integrableOn_locG α β hc hcb h₁ h₂ h₃ hb₁ hb₂ hb₃ if₃ hk₁ hk₂ hk₃ hk₄
    ik₁ ik₂ ik₃ ik₄ ha (2 ^ K₂)
  rw [← hU] at hI
  have hT := tendsto_setIntegral_of_monotone
    (s := fun M : ℕ => Ioc ((2 : ℝ) ^ K₁ / 2) (2 ^ K₂) ×ˢ boxRegion α β K₂ M)
    (fun M => measurableSet_Ioc.prod (measurableSet_Ico.prod measurableSet_Ico))
    (fun M M' h => Set.prod_mono le_rfl (boxRegion_mono α β K₂ h)) hI
  rw [hU, setIntegral_locG_univ α β hc hcb h₁ h₂ h₃ hb₁ hb₂ hb₃ if₃ hk₁ hk₂ hk₃ hk₄
    ik₁ ik₂ ik₃ ik₄ ha, integral_t_swap α β hc hcb h₁ h₂ h₃ hb₁ hb₂ if₃
      (measurable_corrK hk₁ hk₂) (measurable_corrK hk₃ hk₄) (integrable_corrK hk₁ hk₂ ik₁ ik₂)
      (integrable_corrK hk₃ hk₄ ik₃ ik₄) ha] at hT
  exact hT

/-- The complex-valued bridge: for real `f_1, f_2, c`, the inner `t`-integral of the limit is
the truncated model operator `U_{a,b}(f_1, f_2)(z)` with kernels `φ`, `ρ`. -/
theorem ofReal_integral_eq_modelOp (α β : ℕ) (c : ℝ → ℝ) (φ ρ : ℝ → ℝ) (a b : ℝ)
    (f₁ f₂ : ℝ × ℝ → ℝ) (z : ℝ × ℝ) :
    ((∫ t in Ioc a b, c t * ((∫ x', f₁ (x', z.2) * kernelAt φ (t ^ α) x' z.1) *
      (∫ y', f₂ (z.1, y') * kernelAt ρ (t ^ β) y' z.2)) / t : ℝ) : ℂ) =
      modelOp α β (fun t => (c t : ℂ)) φ ρ a b (fun z => (f₁ z : ℂ)) (fun z => (f₂ z : ℂ)) z := by
  unfold modelOp
  rw [← integral_complex_ofReal]
  refine integral_congr_ae (Eventually.of_forall fun t => ?_)
  simp only [Complex.ofReal_div, Complex.ofReal_mul]
  rw [← integral_complex_ofReal, ← integral_complex_ofReal]
  simp only [Complex.ofReal_mul]

/-- The limit of `locForm_boxColl_tendsto`, written with the model operator. -/
theorem locForm_boxColl_tendsto_modelOp (α β : ℕ) (K₁ K₂ : ℤ) {c : ℝ → ℝ} (hc : Measurable c)
    {Cc : ℝ} (hcb : ∀ t, |c t| ≤ Cc)
    {f₁ f₂ f₃ : ℝ × ℝ → ℝ} (h₁ : Measurable f₁) (h₂ : Measurable f₂) (h₃ : Measurable f₃)
    {B : ℝ} (hb₁ : ∀ z, |f₁ z| ≤ B) (hb₂ : ∀ z, |f₂ z| ≤ B) (hb₃ : ∀ z, |f₃ z| ≤ B)
    (if₃ : Integrable f₃) {k₁ k₂ k₃ k₄ : ℝ → ℝ}
    (hk₁ : Measurable k₁) (hk₂ : Measurable k₂) (hk₃ : Measurable k₃) (hk₄ : Measurable k₄)
    (ik₁ : Integrable k₁) (ik₂ : Integrable k₂) (ik₃ : Integrable k₃) (ik₄ : Integrable k₄) :
    Tendsto (fun M : ℕ =>
      ((locForm α β (boxColl α β K₁ K₂ M) c k₁ k₂ k₃ k₄ f₁ f₂ f₃ (fun _ => 1) : ℝ) : ℂ))
      atTop (𝓝 (∫ z, (f₃ z : ℂ) * modelOp α β (fun t => (c t : ℂ)) (corrK k₁ k₂) (corrK k₃ k₄)
        ((2 : ℝ) ^ K₁ / 2) (2 ^ K₂) (fun z => (f₁ z : ℂ)) (fun z => (f₂ z : ℂ)) z)) := by
  have h := (Complex.continuous_ofReal.tendsto _).comp
    (locForm_boxColl_tendsto α β K₁ K₂ hc hcb h₁ h₂ h₃ hb₁ hb₂ hb₃ if₃ hk₁ hk₂ hk₃ hk₄
      ik₁ ik₂ ik₃ ik₄)
  rw [← integral_complex_ofReal] at h
  simp_rw [Complex.ofReal_mul, ofReal_integral_eq_modelOp] at h
  exact h

/-- Continuous kernels with polynomial decay of order `> 1` are measurable and integrable. -/
theorem integrable_of_poly_decay {k : ℝ → ℝ} (hk : Continuous k) {C N : ℝ} (hN : 1 < N)
    (hd : ∀ u, |k u| ≤ C * (1 + |u|) ^ (-N)) : Integrable k := by
  have hint : Integrable fun u : ℝ => (1 + |u|) ^ (-N) := by
    have := integrable_one_add_norm (E := ℝ) (μ := volume) (r := N) (by simpa using hN)
    simpa [Real.norm_eq_abs] using this
  refine (hint.const_mul C).mono' hk.aestronglyMeasurable (Eventually.of_forall fun u => ?_)
  rw [Real.norm_eq_abs]; exact hd u

/-! ### The initial range (`pt2`) -/

theorem hconv_eq_convolution (Ψ : ℝ → ℝ) :
    hconv Ψ = Ψ ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] Twisted.gaussianDeriv := by
  funext y
  rw [hconv, convolution_def]
  congr 1; funext r; simp [mul_comm]

theorem integrable_hconv {Ψ : ℝ → ℝ} (iΨ : Integrable Ψ) : Integrable (hconv Ψ) := by
  rw [hconv_eq_convolution]
  exact iΨ.integrable_convolution _ Twisted.integrable_gaussianDeriv

theorem measurable_hconv {Ψ : ℝ → ℝ} (hΨ : Measurable Ψ) : Measurable (hconv Ψ) := by
  have : Measurable fun w : ℝ × ℝ => Twisted.gaussianDeriv (w.1 - w.2) * Ψ w.2 :=
    (Twisted.continuous_gaussianDeriv.measurable.comp (measurable_fst.sub measurable_snd)).mul
      (hΨ.comp measurable_snd)
  exact this.stronglyMeasurable.integral_prod_right'.measurable

/-- `pt2` in trilinear form (CDR §4.4, lines 1900-1910): for `2 < p, q, p₃` with
`1/p + 1/q + 1/p₃ = 1` the trilinear form of the truncated model operator is bounded by
`‖f₁‖_p ‖f₂‖_q ‖f₃‖_{p₃}` (limit of `combining_trees` over the box collections). -/
theorem modelForm_initial {α β : ℕ} (hα : 0 < α) (hβ : 0 < β) :
    ∃ N : ℕ, ∀ {p q p₃ : ℝ}, 2 < p → 2 < q → 2 < p₃ → 1 / p + 1 / q + 1 / p₃ = 1 →
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (Φ Ψ : ℝ → ℝ) (A B : ℝ), Continuous Φ → Continuous Ψ →
      (∀ x, |Φ x| ≤ A * (1 + |x|) ^ (-(N : ℝ))) → (∀ x, |Ψ x| ≤ B * (1 + |x|) ^ (-(N : ℝ))) →
      ∀ (K₁ K₂ : ℤ) (c : ℝ → ℝ), Measurable c → (∀ t, |c t| ≤ 1) →
      ∀ (f₁ f₂ f₃ : ℝ × ℝ → ℝ), Measurable f₁ → Measurable f₂ → Measurable f₃ →
      ∀ M : ℝ, (∀ z, |f₁ z| ≤ M) → (∀ z, |f₂ z| ≤ M) → (∀ z, |f₃ z| ≤ M) → Integrable f₃ →
      ENNReal.ofReal |∫ z, f₃ z * ∫ t in Ioc ((2 : ℝ) ^ K₁ / 2) (2 ^ K₂), c t *
          ((∫ x', f₁ (x', z.2) * kernelAt (corrK Twisted.gaussian Φ) (t ^ α) x' z.1) *
            (∫ y', f₂ (z.1, y') *
              kernelAt (corrK Twisted.gaussianDeriv (hconv Ψ)) (t ^ β) y' z.2)) / t| ≤
        ENNReal.ofReal (C * A * B) * eLpNorm f₁ (ENNReal.ofReal p) volume *
          eLpNorm f₂ (ENNReal.ofReal q) volume * eLpNorm f₃ (ENNReal.ofReal p₃) volume := by
  obtain ⟨N, HN⟩ := combining_trees_uniform hα hβ
  refine ⟨N + 2, fun {p q p₃} hp hq hp₃ hsum => ?_⟩
  obtain ⟨C, hC, H⟩ := HN hp hq hp₃ hsum
  refine ⟨C, hC, fun Φ Ψ A B hΦ hΨ hdΦ hdΨ K₁ K₂ c hc hc1 f₁ f₂ f₃ h₁ h₂ h₃ M hb₁ hb₂ hb₃
    if₃ => ?_⟩
  have hmono : ∀ x : ℝ, (1 + |x|) ^ (-((N + 2 : ℕ) : ℝ)) ≤ (1 + |x|) ^ (-(N : ℝ)) := fun x =>
    Real.rpow_le_rpow_of_exponent_le (by linarith [abs_nonneg x]) (by push_cast; linarith)
  have hA : 0 ≤ A := by
    have h0 := (abs_nonneg (Φ 0)).trans (hdΦ 0)
    have : 0 < (1 + |(0 : ℝ)|) ^ (-((N + 2 : ℕ) : ℝ)) := by positivity
    exact nonneg_of_mul_nonneg_left h0 this
  have hB : 0 ≤ B := by
    have h0 := (abs_nonneg (Ψ 0)).trans (hdΨ 0)
    have : 0 < (1 + |(0 : ℝ)|) ^ (-((N + 2 : ℕ) : ℝ)) := by positivity
    exact nonneg_of_mul_nonneg_left h0 this
  have hdΦ' : ∀ x, |Φ x| ≤ A * (1 + |x|) ^ (-(N : ℝ)) := fun x =>
    (hdΦ x).trans (mul_le_mul_of_nonneg_left (hmono x) hA)
  have hdΨ' : ∀ x, |Ψ x| ≤ B * (1 + |x|) ^ (-(N : ℝ)) := fun x =>
    (hdΨ x).trans (mul_le_mul_of_nonneg_left (hmono x) hB)
  have hN1 : (1 : ℝ) < ((N + 2 : ℕ) : ℝ) := by push_cast; linarith [(N.cast_nonneg : (0:ℝ) ≤ N)]
  have iΦ : Integrable Φ := integrable_of_poly_decay hΦ hN1 hdΦ
  have iΨ : Integrable Ψ := integrable_of_poly_decay hΨ hN1 hdΨ
  have hT := locForm_boxColl_tendsto α β K₁ K₂ hc hc1 h₁ h₂ h₃ hb₁ hb₂ hb₃ if₃
    continuous_gaussian'.measurable hΦ.measurable Twisted.continuous_gaussianDeriv.measurable
    (measurable_hconv hΨ.measurable) Twisted.integrable_gaussian iΦ
    Twisted.integrable_gaussianDeriv (integrable_hconv iΨ)
  have hT' := ((continuous_abs.tendsto _).comp hT)
  have hT'' := (ENNReal.continuous_ofReal.tendsto _).comp hT'
  refine le_of_tendsto' hT'' fun M' => ?_
  exact H Φ Ψ A B hΦ hΨ hdΦ' hdΨ' _ boxColl_ancConvex c hc hc1 f₁ f₂ f₃ h₁ h₂ h₃ M hb₁ hb₂ hb₃

end

