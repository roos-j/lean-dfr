/-! ### Trees -/

/-- A finite convex tree of dyadic rectangles: a finite collection with a root such that every
rectangle has the root among its ancestors and all intermediate ancestors belong to the tree. -/
structure DyTree (α β : ℕ) where
  /-- The rectangles of the tree. -/
  rects : Finset DyRect
  /-- The root `Q_𝒯`. -/
  root : DyRect
  root_mem : root ∈ rects
  le_root : ∀ Q ∈ rects, ∃ j : ℕ, DyRect.anc α β j Q = root
  convex : ∀ Q ∈ rects, ∀ i j : ℕ, DyRect.anc α β (i + j) Q = root →
    DyRect.anc α β i Q ∈ rects

namespace DyTree

variable {α β : ℕ}

/-- The leaves `𝓛(𝒯)`: children of rectangles of the tree that are not in the tree. -/
def leaves (T : DyTree α β) : Finset DyRect :=
  (T.rects.biUnion (DyRect.children α β)).filter fun R => R ∉ T.rects

theorem lev_le_root (T : DyTree α β) {Q : DyRect} (hQ : Q ∈ T.rects) : Q.lev ≤ T.root.lev := by
  obtain ⟨j, hj⟩ := T.le_root Q hQ
  rw [← hj, DyRect.anc_lev]; omega

theorem parent_mem (T : DyTree α β) {Q : DyRect} (hQ : Q ∈ T.rects) (hne : Q ≠ T.root) :
    DyRect.parent α β Q ∈ T.rects := by
  obtain ⟨j, hj⟩ := T.le_root Q hQ
  cases j with
  | zero => exact absurd hj hne
  | succ j =>
    have := T.convex Q hQ 1 j (by rw [show 1 + j = j + 1 by ring]; exact hj)
    simpa [DyRect.anc] using this

theorem root_not_mem_children (T : DyTree α β) {Q : DyRect} (hQ : Q ∈ T.rects) :
    T.root ∉ Q.children α β := by
  intro h
  have hl := DyRect.lev_of_mem_children α β h
  have := T.lev_le_root hQ
  omega

/-- The children of the tree rectangles are exactly the non-root rectangles and the leaves. -/
theorem biUnion_children_eq (T : DyTree α β) :
    T.rects.biUnion (DyRect.children α β) = T.rects.erase T.root ∪ T.leaves := by
  ext R
  simp only [Finset.mem_biUnion, Finset.mem_union, Finset.mem_erase, leaves,
    Finset.mem_filter]
  constructor
  · rintro ⟨Q, hQ, hR⟩
    by_cases hRT : R ∈ T.rects
    · left
      exact ⟨fun h => T.root_not_mem_children hQ (h ▸ hR), hRT⟩
    · right; exact ⟨⟨Q, hQ, hR⟩, hRT⟩
  · rintro (⟨hne, hR⟩ | ⟨h, _⟩)
    · exact ⟨_, T.parent_mem hR hne, DyRect.mem_children_parent α β R⟩
    · exact h

theorem disjoint_erase_leaves (T : DyTree α β) : Disjoint (T.rects.erase T.root) T.leaves := by
  rw [Finset.disjoint_left]
  intro R hR hL
  simp only [leaves, Finset.mem_filter] at hL
  exact hL.2 (Finset.mem_of_mem_erase hR)

/-- `∑_{Q ∈ 𝒯} ∑_{Q' child of Q} X(Q') = ∑_{Q ∈ 𝒯, Q ≠ Q_𝒯} X(Q) + ∑_{Q ∈ 𝓛(𝒯)} X(Q)`. -/
theorem sum_children_eq {M : Type*} [AddCommMonoid M] (T : DyTree α β) (X : DyRect → M) :
    ∑ Q ∈ T.rects, ∑ R ∈ Q.children α β, X R =
      ∑ R ∈ T.rects.erase T.root, X R + ∑ R ∈ T.leaves, X R := by
  rw [← Finset.sum_biUnion, biUnion_children_eq, Finset.sum_union (disjoint_erase_leaves T)]
  intro Q _ Q' _ hne
  rw [Function.onFun, Finset.disjoint_left]
  intro R h1 h2
  exact hne ((DyRect.parent_of_mem_children α β h1).symm.trans
    (DyRect.parent_of_mem_children α β h2))

theorem sum_children_sub (T : DyTree α β) (X : DyRect → ℝ) :
    ∑ Q ∈ T.rects, (∑ R ∈ Q.children α β, X R - X Q) = ∑ R ∈ T.leaves, X R - X T.root := by
  rw [Finset.sum_sub_distrib, sum_children_eq, ← Finset.add_sum_erase _ _ T.root_mem]
  ring

end DyTree

/-! ### The four-function forms -/

/-- `f_1(x',y) f_2(x,y') f_3(x,y) f_4(x',y')`. -/
def quadF (f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ) (x x' y y' : ℝ) : ℝ :=
  f₁ (x', y) * f₂ (x, y') * f₃ (x, y) * f₄ (x', y')

/-- `∫_{ℝ^4} f_1(x',y) f_2(x,y') f_3(x,y) f_4(x',y') k_1(x) k_2(x') k_3(y) k_4(y')`. -/
def quadForm (f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ) (k₁ k₂ k₃ k₄ : ℝ → ℝ) : ℝ :=
  ∫ x, ∫ x', ∫ y, ∫ y', quadF f₁ f₂ f₃ f₄ x x' y y' * (k₁ x * k₂ x' * (k₃ y * k₄ y'))

/-- The integral over the cell `Q × (ℓ(Q)/2, ℓ(Q)]` with respect to `dp dq dt/t`. -/
def cellInt (α β : ℕ) (Q : DyRect) (G : ℝ → ℝ → ℝ → ℝ) : ℝ :=
  ∫ t in Ioc (Q.len / 2) Q.len, t⁻¹ * ∫ p in Q.ix α, ∫ q in Q.iy β, G t p q

/-- The integral over `Ω_𝒬` for a finite collection `𝒬` (the cells are disjoint). -/
def collInt (α β : ℕ) (𝒬 : Finset DyRect) (G : ℝ → ℝ → ℝ → ℝ) : ℝ :=
  ∑ Q ∈ 𝒬, cellInt α β Q G

/-- The localized form
`∫_{Ω_𝒬} c(t) ∫_{ℝ^4} f_1(x',y)f_2(x,y')f_3(x,y)f_4(x',y') (k_1)_{t^α,p}(x) (k_2)_{t^α,p}(x')
(k_3)_{t^β,q}(y) (k_4)_{t^β,q}(y') dx dy dx' dy' dp dq dt/t`
(`Λ^{(u,v)}_𝒬` for `k_1 = (φ̌)_{1,u}`, `k_2 = g`, `k_3 = h * (ψ̌)_{1,v}`, `k_4 = h`). -/
def locForm (α β : ℕ) (𝒬 : Finset DyRect) (c : ℝ → ℝ) (k₁ k₂ k₃ k₄ : ℝ → ℝ)
    (f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ) : ℝ :=
  collInt α β 𝒬 fun t p q => c t * quadForm f₁ f₂ f₃ f₄ (kernelAt k₁ (t ^ α) p)
    (kernelAt k₂ (t ^ α) p) (kernelAt k₃ (t ^ β) q) (kernelAt k₄ (t ^ β) q)

/-- `Θ^{(1)}_{𝒬,λ,r}`: kernels
`h_{λt^α,p}(x) h_{λt^α,p}(x') g_{t^β,q+rt^β}(y) g_{t^β,q+rt^β}(y')`. -/
def theta1 (α β : ℕ) (𝒬 : Finset DyRect) (lam r : ℝ) (f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ) : ℝ :=
  collInt α β 𝒬 fun t p q => quadForm f₁ f₂ f₃ f₄ (scalarH lam 0 α t p) (scalarH lam 0 α t p)
    (scalarG 1 r β t q) (scalarG 1 r β t q)

/-- `Θ^{(2)}_{𝒬,λ,r}`: kernels
`g_{λt^α,p}(x) g_{λt^α,p}(x') h_{t^β,q+rt^β}(y) h_{t^β,q+rt^β}(y')`. -/
def theta2 (α β : ℕ) (𝒬 : Finset DyRect) (lam r : ℝ) (f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ) : ℝ :=
  collInt α β 𝒬 fun t p q => quadForm f₁ f₂ f₃ f₄ (scalarG lam 0 α t p) (scalarG lam 0 α t p)
    (scalarH 1 r β t q) (scalarH 1 r β t q)

/-- `Ξ_{𝒬,λ,r} = π ∑_{Q ∈ 𝒬} ∫_Q ∫_{ℝ^4} ... g_{λℓ(Q)^α,p}(x) g_{λℓ(Q)^α,p}(x')
g_{ℓ(Q)^β,q+rℓ(Q)^β}(y) g_{ℓ(Q)^β,q+rℓ(Q)^β}(y') ... dp dq`. -/
def xiForm (α β : ℕ) (𝒬 : Finset DyRect) (lam r : ℝ) (f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ) : ℝ :=
  Real.pi * ∑ Q ∈ 𝒬, ∫ p in Q.ix α, ∫ q in Q.iy β,
    quadForm f₁ f₂ f₃ f₄ (scalarG lam 0 α Q.len p) (scalarG lam 0 α Q.len p)
      (scalarG 1 r β Q.len q) (scalarG 1 r β Q.len q)

/-! ### Local sizes -/

/-- `|f|^2 * (θ_{a} ⊗ θ_{b})(p,q)`, `θ(x) = (1+|x|)^{-10}`. -/
def sizeAt (f : ℝ × ℝ → ℝ) (a b p q : ℝ) : ℝ :=
  ∫ x, ∫ y, f (x, y) ^ 2 * (bracketKernelAt a p x * bracketKernelAt b q y)

/-- `(|f|^2 * (θ_{ℓ(Q)^α} ⊗ θ_{ℓ(Q)^β})(c(Q)))^{1/2}`. -/
def sizeQ (α β : ℕ) (f : ℝ × ℝ → ℝ) (Q : DyRect) : ℝ :=
  Real.sqrt (sizeAt f (Q.sx α) (Q.sy β) (Q.center α β).1 (Q.center α β).2)

/-- `𝓜_𝒬(f) = sup_{Q ∈ 𝒬} (|f|^2 * (θ_{ℓ(Q)^α} ⊗ θ_{ℓ(Q)^β})(c(Q)))^{1/2}` (`def:mq`). -/
def Msize (α β : ℕ) (𝒬 : Finset DyRect) (f : ℝ × ℝ → ℝ) : ℝ :=
  ⨆ Q : 𝒬, sizeQ α β f Q

theorem sizeQ_nonneg (α β : ℕ) (f : ℝ × ℝ → ℝ) (Q : DyRect) : 0 ≤ sizeQ α β f Q :=
  Real.sqrt_nonneg _

theorem Msize_nonneg (α β : ℕ) (𝒬 : Finset DyRect) (f : ℝ × ℝ → ℝ) :
    0 ≤ Msize α β 𝒬 f := by
  unfold Msize
  rcases isEmpty_or_nonempty 𝒬 with h | h
  · simp
  · exact le_ciSup_of_le (Set.finite_range _).bddAbove (Classical.arbitrary 𝒬)
      (sizeQ_nonneg α β f _)

theorem sizeQ_le_Msize (α β : ℕ) {𝒬 : Finset DyRect} (f : ℝ × ℝ → ℝ) {Q : DyRect}
    (hQ : Q ∈ 𝒬) : sizeQ α β f Q ≤ Msize α β 𝒬 f :=
  le_ciSup (f := fun Q : 𝒬 => sizeQ α β f Q) (Set.finite_range _).bddAbove ⟨Q, hQ⟩

/-! ### The truncated model operators -/

/-- The truncated model operator
`U_{a,b}(f_1,f_2)(x,y) = ∫_{a<t≤b} c(t) (f_1 *_1 φ_{t^α})(x,y) (f_2 *_2 ρ_{t^β})(x,y) dt/t`
(`§4.1` and `§4.5`; the translations `t^α u`, `t^β v` are absorbed into `φ`, `ρ`). -/
def modelOp (α β : ℕ) (c : ℝ → ℂ) (φ ρ : ℝ → ℝ) (a b : ℝ) (f₁ f₂ : ℝ × ℝ → ℂ)
    (z : ℝ × ℝ) : ℂ :=
  ∫ t in Ioc a b, c t * ((∫ x', f₁ (x', z.2) * ((kernelAt φ (t ^ α) x' z.1 : ℝ) : ℂ)) *
    (∫ y', f₂ (z.1, y') * ((kernelAt ρ (t ^ β) y' z.2 : ℝ) : ℂ))) / t

end

