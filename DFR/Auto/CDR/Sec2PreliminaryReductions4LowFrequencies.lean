    (h : SymDecay ν) (k ℓ : ℕ) :
    ∃ K, 0 ≤ K ∧ ∀ (F : Finset ℤ) (p : ℝ × ℝ), p ≠ 0 →
      ‖iteratedFDeriv ℝ (k + ℓ) (symSum ν F) p (pureVec k ℓ)‖ ≤
        K * (lowRad p ^ (k + 2 * ℓ))⁻¹ := by
  obtain ⟨A, hA, hlip⟩ := h.lipschitz hν h0
  obtain ⟨C, hC, hb⟩ := h.bound (k + ℓ)
  have hS : 0 ≤ ∑' i : ℤ, 2 * (1 / 2 : ℝ) ^ i.natAbs := tsum_nonneg fun i => by positivity
  refine ⟨(A + C + 2 ^ (k + 2 * ℓ + 1) * C) * ∑' i : ℤ, 2 * (1 / 2 : ℝ) ^ i.natAbs,
    by positivity, fun F p hp => ?_⟩
  have hR := lowRad_pos hp
  have hterm : ∀ j : ℤ, ‖iteratedFDeriv ℝ (k + ℓ) (ν ∘ symDil j) p (pureVec k ℓ)‖ ≤
      (A + C + 2 ^ (k + 2 * ℓ + 1) * C) * (lowRad p ^ (k + 2 * ℓ))⁻¹ *
        min (lowRad p / 2 ^ j) (lowRad p / 2 ^ j)⁻¹ := by
    intro j
    have hj : (0 : ℝ) < 2 ^ j := zpow_pos (by norm_num) j
    have e : (((2 : ℝ) ^ j) ^ (k + 2 * ℓ))⁻¹ =
        (lowRad p ^ (k + 2 * ℓ))⁻¹ * (lowRad p / 2 ^ j) ^ (k + 2 * ℓ) := by
      rw [div_pow]; field_simp
    calc ‖iteratedFDeriv ℝ (k + ℓ) (ν ∘ symDil j) p (pureVec k ℓ)‖
        ≤ (((2 : ℝ) ^ j) ^ (k + 2 * ℓ))⁻¹ * ‖iteratedFDeriv ℝ (k + ℓ) ν (symDil j p)‖ :=
          norm_iteratedFDeriv_symDil_le hν j k ℓ p
      _ = (lowRad p ^ (k + 2 * ℓ))⁻¹ * ((lowRad p / 2 ^ j) ^ (k + 2 * ℓ) *
            ‖iteratedFDeriv ℝ (k + ℓ) ν (symDil j p)‖) := by rw [e, mul_assoc]
      _ ≤ (lowRad p ^ (k + 2 * ℓ))⁻¹ * ((A + C + 2 ^ (k + 2 * ℓ + 1) * C) *
            min (lowRad p / 2 ^ j) (lowRad p / 2 ^ j)⁻¹) := by
          exact mul_le_mul_of_nonneg_left
            (term_bound_aux hA hC hC hlip (fun w => (hb w).1) (fun w => (hb w).2) j hp)
            (by positivity)
      _ = _ := by ring
  rw [symSum_eq, iteratedFDeriv_sum fun j _ => (hν.comp (symDil j).contDiff).of_le
    (by exact_mod_cast le_top), Finset.sum_apply, _root_.sum_apply]
  calc ‖∑ j ∈ F, iteratedFDeriv ℝ (k + ℓ) (ν ∘ symDil j) p (pureVec k ℓ)‖
      ≤ ∑ j ∈ F, ‖iteratedFDeriv ℝ (k + ℓ) (ν ∘ symDil j) p (pureVec k ℓ)‖ := norm_sum_le _ _
    _ ≤ ∑ j ∈ F, (A + C + 2 ^ (k + 2 * ℓ + 1) * C) * (lowRad p ^ (k + 2 * ℓ))⁻¹ *
          min (lowRad p / 2 ^ j) (lowRad p / 2 ^ j)⁻¹ := Finset.sum_le_sum fun j _ => hterm j
    _ = (A + C + 2 ^ (k + 2 * ℓ + 1) * C) * (lowRad p ^ (k + 2 * ℓ))⁻¹ *
          ∑ j ∈ F, min (lowRad p / 2 ^ j) (lowRad p / 2 ^ j)⁻¹ := by rw [Finset.mul_sum]
    _ ≤ (A + C + 2 ^ (k + 2 * ℓ + 1) * C) * (lowRad p ^ (k + 2 * ℓ))⁻¹ *
          ∑' i : ℤ, 2 * (1 / 2 : ℝ) ^ i.natAbs := by
        gcongr
        exact sum_min_dil_le _ hR F
    _ = _ := by ring

/-- **Symbol estimates for sums of dilates.** If `ν` is smooth, vanishes at the origin and its
derivatives satisfy `‖D^n ν(w)‖ ≤ C_n (1 + ‖w‖)^{-(2n+1)}`, then the finite sums
`∑_{j ∈ F} ν(-2^{-j} ξ, -4^{-j} η)` satisfy the anisotropic symbol estimates (`sym-est`)
uniformly in `F`. -/
theorem isAnisoSymbol_symSum {ν : ℝ × ℝ → ℂ} (hν : ContDiff ℝ ∞ ν) (h0 : ν 0 = 0)
    (h : SymDecay ν) (N : ℕ) : ∃ C, ∀ F : Finset ℤ, IsAnisoSymbol 1 2 N C (symSum ν F) := by
  choose K hK0 hK using symSum_pure_bound hν h0 h
  refine ⟨∑ k ∈ Finset.range (N + 1), ∑ ℓ ∈ Finset.range (N + 1), K k ℓ, fun F =>
    ⟨((contDiff_symSum hν F).of_le (by exact_mod_cast le_top)).contDiffOn,
      (contDiff_symSum hν F).continuous.measurable, fun k ℓ hkl p hp => ?_⟩⟩
  rw [aniso_one_two_eq hp, one_mul]
  refine (hK k ℓ F p hp).trans (mul_le_mul_of_nonneg_right ?_
    (inv_nonneg.2 (pow_nonneg (lowRad_pos hp).le _)))
  have hk : k ∈ Finset.range (N + 1) := Finset.mem_range.2 (by omega)
  have hl : ℓ ∈ Finset.range (N + 1) := Finset.mem_range.2 (by omega)
  calc K k ℓ ≤ ∑ ℓ' ∈ Finset.range (N + 1), K k ℓ' :=
        Finset.single_le_sum (fun ℓ' _ => hK0 k ℓ') hl
    _ ≤ ∑ k' ∈ Finset.range (N + 1), ∑ ℓ' ∈ Finset.range (N + 1), K k' ℓ' :=
        Finset.single_le_sum (f := fun k' => ∑ ℓ' ∈ Finset.range (N + 1), K k' ℓ')
          (fun k' _ => Finset.sum_nonneg fun ℓ' _ => hK0 k' ℓ') hk

theorem symDecay_of_hasCompactSupport {ν : ℝ × ℝ → ℂ} (hν : ContDiff ℝ ∞ ν)
    (hc : HasCompactSupport ν) : SymDecay ν := by
  intro n
  have hcont : Continuous (fun w => ‖iteratedFDeriv ℝ n ν w‖ * (1 + ‖w‖) ^ (2 * n + 1)) :=
    (hν.continuous_iteratedFDeriv (by exact_mod_cast le_top)).norm.mul (by fun_prop)
  have hsupp : HasCompactSupport
      (fun w => ‖iteratedFDeriv ℝ n ν w‖ * (1 + ‖w‖) ^ (2 * n + 1)) :=
    (hc.iteratedFDeriv n).norm.mul_right
  obtain ⟨C, hC⟩ := hcont.bounded_above_of_compact_support hsupp
  exact ⟨C, fun w => (le_abs_self _).trans (hC w)⟩

/-! ### The oscillatory integral `ϑ` -/

/-- `∫ a(t) e^{2πi(tξ + t²η)} dt` for a complex amplitude `a`. -/
def oscIntC (a : ℝ → ℂ) (w : ℝ × ℝ) : ℂ :=
  ∫ t, a t * Complex.exp (2 * Real.pi * Complex.I * (t * w.1 + t ^ 2 * w.2))

theorem oscInt_eq_oscIntC (b : ℝ → ℝ) (ξ η : ℝ) :
    oscInt b ξ η = oscIntC (fun t => (b t : ℂ)) (ξ, η) := rfl

/-- The pairing `(v, w) ↦ v₁ w₁ + v₂ w₂`. -/
def dotL : (ℝ × ℝ) →L[ℝ] (ℝ × ℝ) →L[ℝ] ℝ :=
  (ContinuousLinearMap.mul ℝ ℝ).bilinearComp (ContinuousLinearMap.fst ℝ ℝ ℝ)
      (ContinuousLinearMap.fst ℝ ℝ ℝ) +
    (ContinuousLinearMap.mul ℝ ℝ).bilinearComp (ContinuousLinearMap.snd ℝ ℝ ℝ)
      (ContinuousLinearMap.snd ℝ ℝ ℝ)

theorem dotL_apply (v w : ℝ × ℝ) : dotL v w = v.1 * w.1 + v.2 * w.2 := by
  simp [dotL]

/-- The parabola `t ↦ (t, t²)`. -/
def parab (t : ℝ) : ℝ × ℝ := (t, t ^ 2)

theorem continuous_parab : Continuous parab := by unfold parab; fun_prop

/-- The pushforward of the Lebesgue measure to the parabola. -/
def parabMeasure : Measure (ℝ × ℝ) := Measure.map parab volume

theorem oscIntC_eq_fourierIntegral {a : ℝ → ℂ} (ha : Continuous a) :
    oscIntC a = VectorFourier.fourierIntegral Real.fourierChar parabMeasure
      (-dotL).toLinearMap₁₂ (fun v => a v.1) := by
  funext w
  have hfun : (fun v : ℝ × ℝ => Real.fourierChar (-((-dotL).toLinearMap₁₂ v) w) • a v.1) =
      fun v => Complex.exp (↑(2 * Real.pi * (v.1 * w.1 + v.2 * w.2)) * Complex.I) * a v.1 := by
    funext v
    simp only [ContinuousLinearMap.toLinearMap₁₂_apply, neg_apply, neg_neg, dotL_apply,
      Circle.smul_def, Real.fourierChar_apply, smul_eq_mul]
  simp only [VectorFourier.fourierIntegral, parabMeasure]
  rw [hfun, integral_map continuous_parab.measurable.aemeasurable
    (Continuous.aestronglyMeasurable (by fun_prop))]
  simp only [oscIntC, parab]
  congr 1
  funext t
  rw [mul_comm]
  congr 2
  push_cast
  ring

theorem integrable_parabMeasure {a : ℝ → ℂ} (ha : Continuous a) (hc : HasCompactSupport a)
    (n : ℕ) : Integrable (fun v : ℝ × ℝ => ‖v‖ ^ n * ‖a v.1‖) parabMeasure := by
  rw [parabMeasure, integrable_map_measure (by fun_prop)
    continuous_parab.measurable.aemeasurable]
  exact Continuous.integrable_of_hasCompactSupport
    ((continuous_norm.comp continuous_parab).pow n |>.mul ha.norm) hc.norm.mul_left

theorem contDiff_oscIntC {a : ℝ → ℂ} (ha : Continuous a) (hc : HasCompactSupport a) :
    ContDiff ℝ ∞ (oscIntC a) := by
  rw [oscIntC_eq_fourierIntegral ha]
  exact VectorFourier.contDiff_fourierIntegral _ fun n _ => integrable_parabMeasure ha hc n

/-! ### The bump `ψ(t)/t` -/

theorem monoPhi_neg (x : ℝ) : monoPhi (-x) = monoPhi x := by
  simp [monoPhi]

theorem monoPsiA_neg (x : ℝ) : monoPsiA (-x) = monoPsiA x := by
  simp [monoPsiA, monoPhi_neg, mul_neg]

theorem tjBump_neg (u : ℝ) : tjBump (-u) = -tjBump u := by
  simp [tjBump, monoPsiA_neg, div_neg]

theorem tjBump_ne_zero {u : ℝ} (hu : tjBump u ≠ 0) : 1 / 2 < |u| ∧ |u| < 2 := by
  apply mloc_psiA_ne_zero
  intro h
  exact hu (by simp [tjBump, h])

theorem tjBump_eq_zero {u : ℝ} (hu : |u| ≤ 1 / 2 ∨ 2 ≤ |u|) : tjBump u = 0 := by
  by_contra h
  have := tjBump_ne_zero h
  rcases hu with hu | hu <;> linarith [this.1, this.2]

theorem tjBump_contDiff : ContDiff ℝ ∞ tjBump := by
  rw [contDiff_iff_contDiffAt]
  intro u
  by_cases hu : u = 0
  · subst hu
    apply contDiffAt_const (c := (0 : ℝ)).congr_of_eventuallyEq
    have : Ioo (-(1 / 2 : ℝ)) (1 / 2) ∈ 𝓝 (0 : ℝ) := Ioo_mem_nhds (by norm_num) (by norm_num)
    filter_upwards [this] with s hs
    exact tjBump_eq_zero (Or.inl (abs_le.2 ⟨hs.1.le, hs.2.le⟩))
  · exact (monoPsiA_contDiff.contDiffAt).div contDiffAt_id hu

theorem tjBump_hasCompactSupport : HasCompactSupport tjBump := by
  refine HasCompactSupport.intro (isCompact_Icc (a := -2) (b := 2)) fun u hu => ?_
  apply tjBump_eq_zero
  right
  rw [mem_Icc, not_and_or, not_le, not_le] at hu
  rcases hu with hu | hu
  · rw [abs_of_neg (by linarith)]; linarith
  · rw [abs_of_pos (by linarith)]; linarith

theorem integral_tjBump : ∫ u, tjBump u = 0 := by
  have h := integral_neg_eq_self tjBump (volume : Measure ℝ)
  simp only [tjBump_neg, integral_neg] at h
  linarith

theorem oscInt_tjBump_zero : oscInt tjBump 0 0 = 0 := by
  simp only [oscInt, Complex.ofReal_zero, mul_zero, add_zero, Complex.exp_zero, mul_one]
  rw [integral_complex_ofReal, integral_tjBump, Complex.ofReal_zero]

theorem contDiff_oscInt_tjBump :
    ContDiff ℝ ∞ (fun w : ℝ × ℝ => oscInt tjBump w.1 w.2) :=
  contDiff_oscIntC (Complex.continuous_ofReal.comp tjBump_contDiff.continuous)
    (tjBump_hasCompactSupport.comp_left Complex.ofReal_zero)

/-! ### The low-frequency symbol -/

theorem contDiff_lowNu : ContDiff ℝ ∞ lowNu := by
  have h1 : ContDiff ℝ ∞ (fun w : ℝ × ℝ => (monoPhi w.1 : ℂ)) :=
    Complex.ofRealCLM.contDiff.comp (monoPhi_contDiff.comp contDiff_fst)
  have h2 : ContDiff ℝ ∞ (fun w : ℝ × ℝ => (monoPhi w.2 : ℂ)) :=
    Complex.ofRealCLM.contDiff.comp (monoPhi_contDiff.comp contDiff_snd)
  exact (h1.mul h2).mul contDiff_oscInt_tjBump

theorem lowNu_hasCompactSupport : HasCompactSupport lowNu := by
  refine HasCompactSupport.intro ((isCompact_Icc (a := -2) (b := 2)).prod
    (isCompact_Icc (a := -2) (b := 2))) fun w hw => ?_
  have key : ∀ x : ℝ, x ∉ Icc (-2 : ℝ) 2 → monoPhi x = 0 := by
    intro x hx
    apply monoPhi_eq_zero
    rw [mem_Icc, not_and_or, not_le, not_le] at hx
    rcases hx with hx | hx
    · rw [abs_of_neg (by linarith)]; linarith
    · rw [abs_of_pos (by linarith)]; linarith
  rw [mem_prod, not_and_or] at hw
  rcases hw with hw | hw <;> simp [lowNu, key _ hw]

theorem lowNu_zero : lowNu 0 = 0 := by
  simp [lowNu, oscInt_tjBump_zero]

/-- **Low frequencies** (`sec:low-red`, `sym-est`): the symbols
`∑_{j ∈ F} ν(-2^{-j} ξ, -4^{-j} η)` with `ν(ξ,η) = φ(ξ) φ(η) ϑ(ξ,η)` satisfy the anisotropic
symbol estimates of Theorem 2 with `(α, β) = (1, 2)` uniformly in the finite set `F`. -/
theorem lowNu_isAnisoSymbol (N : ℕ) :
    ∃ C, ∀ F : Finset ℤ, IsAnisoSymbol 1 2 N C (symSum lowNu F) :=
  isAnisoSymbol_symSum contDiff_lowNu lowNu_zero
    (symDecay_of_hasCompactSupport contDiff_lowNu lowNu_hasCompactSupport) N

end

