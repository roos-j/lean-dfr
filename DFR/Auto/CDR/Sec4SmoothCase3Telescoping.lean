@[fun_prop]
theorem measurable_scalarE' {X : Type*} [MeasurableSpace X] (mu sig : ℝ) (n : ℕ)
    {f g h k : X → ℝ} (hf : Measurable f) (hg : Measurable g) (hh : Measurable h)
    (hk : Measurable k) :
    Measurable (fun a => scalarE mu sig n (f a) (g a) (h a) (k a)) := by
  unfold scalarE scalarW scalarD; fun_prop

@[fun_prop]
theorem measurable_scalarDdot' {X : Type*} [MeasurableSpace X] (mu sig : ℝ) (n : ℕ)
