theorem factor_12 (A B : ℝ → ℝ) (f₁ f₂ : ℝ × ℝ → ℝ) :
    ∫ x, ∫ x', ∫ y, ∫ y', f₁ (x', y) ^ 2 * f₂ (x, y') ^ 2 * wt A B x x' y y' =
