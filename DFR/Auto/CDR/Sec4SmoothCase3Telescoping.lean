    (hk : Measurable k) :
    Measurable (fun a => scalarDdot mu sig n (f a) (g a) (h a) (k a)) := by
  unfold scalarDdot; fun_prop

/-- The three profiles `g`, `h`, `z h(z)` are dominated by `θ`. -/
theorem profile_bounds : ∃ C : ℝ, 0 ≤ C ∧ ∀ v : ℝ, |gaussian v| ≤ C * bracketKernel v ∧
    |gaussianDeriv v| ≤ C * bracketKernel v ∧ |v * gaussianDeriv v| ≤ C * bracketKernel v := by
  obtain ⟨C₁, hC₁, h₁⟩ := Auto.Twisted.gaussian_polynomial_decay 10
  obtain ⟨C₂, hC₂, h₂⟩ := Auto.Twisted.gaussianDeriv_polynomial_decay 10
  obtain ⟨C₃, hC₃, h₃⟩ := Auto.Twisted.gaussianDeriv_polynomial_decay 11
  refine ⟨C₁ + C₂ + C₃, by positivity, fun v => ?_⟩
  have hpos : 0 < (1 + |v|) ^ 10 := by positivity
  have key : ∀ a : ℝ, 0 ≤ a → (1 + |v|) ^ 10 * a ≤ C₁ + C₂ + C₃ →
      a ≤ (C₁ + C₂ + C₃) * bracketKernel v := by
    intro a _ ha
    rw [Auto.Twisted.bracketKernel_eq_inv_pow, ← div_eq_mul_inv, le_div_iff₀ hpos]
    linarith
  refine ⟨key _ (abs_nonneg _) ?_, key _ (abs_nonneg _) ?_, key _ (abs_nonneg _) ?_⟩
  · rw [abs_of_nonneg (Auto.Twisted.gaussian_nonneg v)]
    have := h₁ v; linarith
  · have := h₂ v; linarith
  · have h3 := h₃ v
    have : (1 + |v|) ^ 10 * |v * gaussianDeriv v| ≤ (1 + |v|) ^ 11 * |gaussianDeriv v| := by
      rw [abs_mul, pow_succ]
      have : |v| ≤ 1 + |v| := by linarith
      have := abs_nonneg (gaussianDeriv v)
      calc _ = (1 + |v|) ^ 10 * |gaussianDeriv v| * |v| := by ring
        _ ≤ (1 + |v|) ^ 10 * |gaussianDeriv v| * (1 + |v|) := by gcongr
        _ = _ := by ring
    linarith

/-- The common profile constant. -/
def C0 : ℝ := profile_bounds.choose

theorem C0_nonneg : 0 ≤ C0 := profile_bounds.choose_spec.1

theorem abs_gaussian_le (v : ℝ) : |gaussian v| ≤ C0 * bracketKernel v :=
  (profile_bounds.choose_spec.2 v).1

theorem abs_gaussianDeriv_le (v : ℝ) : |gaussianDeriv v| ≤ C0 * bracketKernel v :=
  (profile_bounds.choose_spec.2 v).2.1

theorem abs_mul_gaussianDeriv_le (v : ℝ) : |v * gaussianDeriv v| ≤ C0 * bracketKernel v :=
  (profile_bounds.choose_spec.2 v).2.2

theorem abs_kernelAt_le {φ : ℝ → ℝ} {Cφ : ℝ} (hφ : ∀ v, |φ v| ≤ Cφ * bracketKernel v)
    {S c u : ℝ} (hS : 0 < S) : |kernelAt φ S c u| ≤ Cφ * bracketKernelAt S c u := by
  unfold kernelAt kernelDilate bracketKernelAt
  simp only [kernelAt, kernelDilate, smul_eq_mul]
  rw [abs_mul, abs_of_pos (inv_pos.mpr hS)]
  calc _ ≤ S⁻¹ * (Cφ * bracketKernel ((u - c) / S)) :=
        mul_le_mul_of_nonneg_left (hφ _) (inv_nonneg.mpr hS.le)
    _ = _ := by ring

theorem bracketKernelAt_dilate_le {s μ c u : ℝ} (hs : 0 < s) (hμ : 1 ≤ μ) (σ : ℝ) :
    bracketKernelAt (μ * s) (c + σ * s) u ≤ μ ^ 9 * (1 + |σ|) ^ 10 * bracketKernelAt s c u := by
  have hμ0 : 0 < μ := by linarith
  simp only [bracketKernelAt, kernelAt, kernelDilate, smul_eq_mul,
    Auto.Twisted.bracketKernel_eq_inv_pow]
  set a := |(u - (c + σ * s)) / (μ * s)| with ha
  set X := 1 + |(u - c) / s| with hX
  have hXpos : 0 < X := by positivity
  have hkey : X ≤ μ * (1 + |σ|) * (1 + a) := by
    have e : (u - c) / s = μ * ((u - (c + σ * s)) / (μ * s)) + σ := by
      field_simp; ring
    have h1 : |(u - c) / s| ≤ μ * a + |σ| := by
      rw [e]
      refine (abs_add_le _ _).trans ?_
      rw [abs_mul, abs_of_pos hμ0]
    have ha0 : 0 ≤ a := abs_nonneg _
    have hσ : 0 ≤ |σ| := abs_nonneg _
    rw [hX]
    nlinarith [mul_nonneg (sub_nonneg.2 hμ) hσ, mul_nonneg (mul_nonneg hμ0.le hσ) ha0]
  have e2 : (μ * s)⁻¹ * ((1 + a) ^ 10)⁻¹ =
      μ ^ 9 * (1 + |σ|) ^ 10 * s⁻¹ * ((μ * (1 + |σ|) * (1 + a)) ^ 10)⁻¹ := by
    have : 0 < 1 + |σ| := by positivity
    have : 0 < 1 + a := by positivity
    field_simp
  rw [e2]
  have hpow : X ^ 10 ≤ (μ * (1 + |σ|) * (1 + a)) ^ 10 := pow_le_pow_left₀ hXpos.le hkey 10
  have : ((μ * (1 + |σ|) * (1 + a)) ^ 10)⁻¹ ≤ (X ^ 10)⁻¹ :=
    inv_anti₀ (by positivity) hpow
  calc _ ≤ μ ^ 9 * (1 + |σ|) ^ 10 * s⁻¹ * (X ^ 10)⁻¹ := by gcongr
    _ = _ := by ring

theorem bracketKernelAt_scale_le {n : ℕ} {ℓ t p c₀ u : ℝ} (hℓ : 0 < ℓ)
    (ht : t ∈ Icc (ℓ / 2) ℓ) (hp : |p - c₀| ≤ ℓ ^ n / 2) :
    bracketKernelAt (t ^ n) p u ≤ 2 ^ n * (3 / 2 : ℝ) ^ 10 * bracketKernelAt (ℓ ^ n) c₀ u := by
  have ht0 : 0 < t := lt_of_lt_of_le (half_pos hℓ) ht.1
  refine Auto.Twisted.bracketKernelAt_le_of_scale_center (by positivity) (by positivity) ?_ ?_ hp
  · have : (ℓ / 2) ^ n ≤ t ^ n := pow_le_pow_left₀ (by positivity) ht.1 n
    calc ℓ ^ n = 2 ^ n * (ℓ / 2) ^ n := by rw [← mul_pow]; ring_nf
      _ ≤ _ := by gcongr
  · exact pow_le_pow_left₀ ht0.le ht.2 n

/-- The factor constant `κ_n = C₀ 2^n (3/2)^{10}`. -/
def kap (n : ℕ) : ℝ := C0 * 2 ^ n * (3 / 2 : ℝ) ^ 10

theorem kap_nonneg (n : ℕ) : 0 ≤ kap n := by unfold kap; have := C0_nonneg; positivity

/-- The scale weight `μ^9 (1+|σ|)^{10}`. -/
def rho (mu sig : ℝ) : ℝ := mu ^ 9 * (1 + |sig|) ^ 10

theorem rho_nonneg {mu : ℝ} (hmu : 1 ≤ mu) (sig : ℝ) : 0 ≤ rho mu sig := by
  unfold rho; have : 0 ≤ mu := by linarith
  positivity

section family

variable {mu sig : ℝ} {n : ℕ} {ℓ t p c₀ : ℝ}

theorem kernel_family_le {φ : ℝ → ℝ} (hφ : ∀ v, |φ v| ≤ C0 * bracketKernel v)
    (hmu : 1 ≤ mu) (hℓ : 0 < ℓ) (ht : t ∈ Icc (ℓ / 2) ℓ) (hp : |p - c₀| ≤ ℓ ^ n / 2) (u : ℝ) :
    |kernelAt φ (mu * t ^ n) (p + sig * t ^ n) u| ≤
      kap n * rho mu sig * bracketKernelAt (ℓ ^ n) c₀ u := by
  have ht0 : 0 < t := lt_of_lt_of_le (half_pos hℓ) ht.1
  have hs : 0 < t ^ n := by positivity
  have hmu0 : 0 < mu := by linarith
  have h1 := abs_kernelAt_le hφ (S := mu * t ^ n) (c := p + sig * t ^ n) (u := u)
    (by positivity)
  have h2 := bracketKernelAt_dilate_le (c := p) (u := u) hs hmu sig
  have h3 := bracketKernelAt_scale_le (u := u) hℓ ht hp
  have := C0_nonneg
  calc _ ≤ C0 * bracketKernelAt (mu * t ^ n) (p + sig * t ^ n) u := h1
    _ ≤ C0 * (mu ^ 9 * (1 + |sig|) ^ 10 * bracketKernelAt (t ^ n) p u) := by gcongr
    _ ≤ C0 * (mu ^ 9 * (1 + |sig|) ^ 10 *
        (2 ^ n * (3 / 2 : ℝ) ^ 10 * bracketKernelAt (ℓ ^ n) c₀ u)) := by
        have : 0 ≤ mu ^ 9 * (1 + |sig|) ^ 10 := by positivity
        gcongr
    _ = _ := by unfold kap rho; ring

theorem abs_scalarG_le (hmu : 1 ≤ mu) (hℓ : 0 < ℓ) (ht : t ∈ Icc (ℓ / 2) ℓ)
    (hp : |p - c₀| ≤ ℓ ^ n / 2) (u : ℝ) :
    |scalarG mu sig n t p u| ≤ kap n * rho mu sig * bracketKernelAt (ℓ ^ n) c₀ u :=
  kernel_family_le abs_gaussian_le hmu hℓ ht hp u

theorem abs_scalarH_le (hmu : 1 ≤ mu) (hℓ : 0 < ℓ) (ht : t ∈ Icc (ℓ / 2) ℓ)
    (hp : |p - c₀| ≤ ℓ ^ n / 2) (u : ℝ) :
    |scalarH mu sig n t p u| ≤ kap n * rho mu sig * bracketKernelAt (ℓ ^ n) c₀ u :=
  kernel_family_le abs_gaussianDeriv_le hmu hℓ ht hp u

theorem scalarZ_mul_scalarH (mu sig : ℝ) (n : ℕ) (t p u : ℝ) :
    scalarZ mu sig n t p u * scalarH mu sig n t p u =
      kernelAt (fun v => v * gaussianDeriv v) (mu * t ^ n) (p + sig * t ^ n) u := by
  simp only [scalarZ, scalarH, gaussianDerivAt, kernelAt, kernelDilate, smul_eq_mul]
  ring

theorem abs_scalarZH_le (hmu : 1 ≤ mu) (hℓ : 0 < ℓ) (ht : t ∈ Icc (ℓ / 2) ℓ)
    (hp : |p - c₀| ≤ ℓ ^ n / 2) (u : ℝ) :
    |scalarZ mu sig n t p u * scalarH mu sig n t p u| ≤
      kap n * rho mu sig * bracketKernelAt (ℓ ^ n) c₀ u := by
  rw [scalarZ_mul_scalarH]
  exact kernel_family_le abs_mul_gaussianDeriv_le hmu hℓ ht hp u

/-- Shorthand for the comparison kernel `θ_{ℓ^n, c₀}`. -/
local notation "Θ" => bracketKernelAt (ℓ ^ n) c₀

theorem abs_scalarD_le (hmu : 1 ≤ mu) (hℓ : 0 < ℓ) (ht : t ∈ Icc (ℓ / 2) ℓ)
    (hp : |p - c₀| ≤ ℓ ^ n / 2) (u0 u1 : ℝ) :
    |scalarD mu sig n t p u0 u1| ≤ (kap n * rho mu sig) ^ 2 * (Θ u0 * Θ u1) := by
  unfold scalarD
  rw [abs_mul]
  have h0 := abs_scalarG_le (sig := sig) hmu hℓ ht hp u0
  have h1 := abs_scalarG_le (sig := sig) hmu hℓ ht hp u1
  have := mul_le_mul h0 h1 (abs_nonneg _)
    (mul_nonneg (mul_nonneg (kap_nonneg n) (rho_nonneg hmu sig))
      (Auto.Twisted.bracketKernelAt_pos (by positivity)).le)
  calc _ ≤ _ := this
    _ = _ := by ring

theorem abs_scalarP_le (hmu : 1 ≤ mu) (hℓ : 0 < ℓ) (ht : t ∈ Icc (ℓ / 2) ℓ)
    (hp : |p - c₀| ≤ ℓ ^ n / 2) (u0 u1 : ℝ) :
    |scalarP mu sig n t p u0 u1| ≤ (kap n * rho mu sig) ^ 2 * (Θ u0 * Θ u1) := by
  unfold scalarP
  rw [abs_mul]
  have h0 := abs_scalarH_le (sig := sig) hmu hℓ ht hp u0
  have h1 := abs_scalarH_le (sig := sig) hmu hℓ ht hp u1
  have := mul_le_mul h0 h1 (abs_nonneg _)
    (mul_nonneg (mul_nonneg (kap_nonneg n) (rho_nonneg hmu sig))
      (Auto.Twisted.bracketKernelAt_pos (by positivity)).le)
  calc _ ≤ _ := this
    _ = _ := by ring

theorem abs_scalarW_le (hmu : 1 ≤ mu) (hℓ : 0 < ℓ) (ht : t ∈ Icc (ℓ / 2) ℓ)
    (hp : |p - c₀| ≤ ℓ ^ n / 2) (u0 u1 : ℝ) :
    |scalarW mu sig n t p u0 u1| ≤ 2 * (kap n * rho mu sig) ^ 2 * (Θ u0 * Θ u1) := by
  unfold scalarW
  have hk : 0 ≤ kap n * rho mu sig := mul_nonneg (kap_nonneg n) (rho_nonneg hmu sig)
  have hΘ0 := (Auto.Twisted.bracketKernelAt_pos (a := c₀) (x := u0)
    (by positivity : (0 : ℝ) < ℓ ^ n)).le
  have hΘ1 := (Auto.Twisted.bracketKernelAt_pos (a := c₀) (x := u1)
    (by positivity : (0 : ℝ) < ℓ ^ n)).le
  have a1 := abs_scalarH_le (sig := sig) hmu hℓ ht hp u0
  have a2 := abs_scalarG_le (sig := sig) hmu hℓ ht hp u1
  have a3 := abs_scalarG_le (sig := sig) hmu hℓ ht hp u0
  have a4 := abs_scalarH_le (sig := sig) hmu hℓ ht hp u1
  refine (abs_add_le _ _).trans ?_
  rw [abs_mul, abs_mul]
  have b1 := mul_le_mul a1 a2 (abs_nonneg _) (mul_nonneg hk hΘ0)
  have b2 := mul_le_mul a3 a4 (abs_nonneg _) (mul_nonneg hk hΘ0)
  nlinarith

theorem abs_scalarE_le (hmu : 1 ≤ mu) (hℓ : 0 < ℓ) (ht : t ∈ Icc (ℓ / 2) ℓ)
    (hp : |p - c₀| ≤ ℓ ^ n / 2) (u0 u1 : ℝ) :
    |scalarE mu sig n t p u0 u1| ≤
      (mu + |sig|) * (2 * (kap n * rho mu sig) ^ 2) * (Θ u0 * Θ u1) := by
  unfold scalarE
  have hmu0 : 0 ≤ mu := by linarith
  have hk : 0 ≤ kap n * rho mu sig := mul_nonneg (kap_nonneg n) (rho_nonneg hmu sig)
  have hΘ0 := (Auto.Twisted.bracketKernelAt_pos (a := c₀) (x := u0)
    (by positivity : (0 : ℝ) < ℓ ^ n)).le
  have hΘ1 := (Auto.Twisted.bracketKernelAt_pos (a := c₀) (x := u1)
    (by positivity : (0 : ℝ) < ℓ ^ n)).le
  have hW := abs_scalarW_le (sig := sig) hmu hℓ ht hp u0 u1
  have hD := abs_scalarD_le (sig := sig) hmu hℓ ht hp u0 u1
  have hpi : mu / (2 * Real.pi) ≤ mu := by
    rw [div_le_iff₀ (by positivity)]
    have := Real.pi_gt_three
    nlinarith
  refine (abs_sub _ _).trans ?_
  rw [abs_mul, abs_mul, abs_of_nonneg (by positivity : 0 ≤ mu / (2 * Real.pi))]
  set T := (kap n * rho mu sig) ^ 2 * (Θ u0 * Θ u1)
  have hT : 0 ≤ T := by positivity
  calc _ ≤ mu * (2 * T) + |sig| * T := by
        gcongr
        · calc _ ≤ _ := hW
            _ = 2 * T := by ring
    _ ≤ _ := by
        have : 0 ≤ |sig| := abs_nonneg _
        nlinarith

theorem abs_scalarDdot_le (hmu : 1 ≤ mu) (hℓ : 0 < ℓ) (ht : t ∈ Icc (ℓ / 2) ℓ)
    (hp : |p - c₀| ≤ ℓ ^ n / 2) (u0 u1 : ℝ) :
    |scalarDdot mu sig n t p u0 u1| ≤
      2 * n / ℓ * (4 + 2 * |sig|) * (kap n * rho mu sig) ^ 2 * (Θ u0 * Θ u1) := by
  unfold scalarDdot
  have ht0 : 0 < t := lt_of_lt_of_le (half_pos hℓ) ht.1
  have hmu0 : 0 < mu := by linarith
  have hk : 0 ≤ kap n * rho mu sig := mul_nonneg (kap_nonneg n) (rho_nonneg hmu sig)
  have hΘ0 := (Auto.Twisted.bracketKernelAt_pos (a := c₀) (x := u0)
    (by positivity : (0 : ℝ) < ℓ ^ n)).le
  have hΘ1 := (Auto.Twisted.bracketKernelAt_pos (a := c₀) (x := u1)
    (by positivity : (0 : ℝ) < ℓ ^ n)).le
  set κ := kap n * rho mu sig
  set T := κ ^ 2 * (Θ u0 * Θ u1)
  have hT : 0 ≤ T := by positivity
  have hsig : |sig / mu| ≤ |sig| := by
    rw [abs_div, abs_of_pos hmu0]
    exact div_le_self (abs_nonneg _) hmu
  -- the bracket
  have hD := abs_scalarD_le (sig := sig) hmu hℓ ht hp u0 u1
  have g0 := abs_scalarG_le (sig := sig) hmu hℓ ht hp u0
  have g1 := abs_scalarG_le (sig := sig) hmu hℓ ht hp u1
  have h0 := abs_scalarH_le (sig := sig) hmu hℓ ht hp u0
  have h1 := abs_scalarH_le (sig := sig) hmu hℓ ht hp u1
  have z0 := abs_scalarZH_le (sig := sig) hmu hℓ ht hp u0
  have z1 := abs_scalarZH_le (sig := sig) hmu hℓ ht hp u1
  have e0 : (scalarZ mu sig n t p u0 + sig / mu) * scalarH mu sig n t p u0 *
      scalarG mu sig n t p u1 = (scalarZ mu sig n t p u0 * scalarH mu sig n t p u0 +
        sig / mu * scalarH mu sig n t p u0) * scalarG mu sig n t p u1 := by ring
  have e1 : (scalarZ mu sig n t p u1 + sig / mu) * scalarG mu sig n t p u0 *
      scalarH mu sig n t p u1 = scalarG mu sig n t p u0 *
        (scalarZ mu sig n t p u1 * scalarH mu sig n t p u1 +
          sig / mu * scalarH mu sig n t p u1) := by ring
  have hB0 : |scalarZ mu sig n t p u0 * scalarH mu sig n t p u0 +
      sig / mu * scalarH mu sig n t p u0| ≤ (1 + |sig|) * (κ * Θ u0) := by
    refine (abs_add_le _ _).trans ?_
    rw [abs_mul (sig / mu)]
    have := mul_le_mul hsig h0 (abs_nonneg _) (abs_nonneg _)
    nlinarith
  have hB1 : |scalarZ mu sig n t p u1 * scalarH mu sig n t p u1 +
      sig / mu * scalarH mu sig n t p u1| ≤ (1 + |sig|) * (κ * Θ u1) := by
    refine (abs_add_le _ _).trans ?_
    rw [abs_mul (sig / mu)]
    have := mul_le_mul hsig h1 (abs_nonneg _) (abs_nonneg _)
    nlinarith
  have hbr : |2 * scalarD mu sig n t p u0 u1 +
      (scalarZ mu sig n t p u0 + sig / mu) * scalarH mu sig n t p u0 * scalarG mu sig n t p u1 +
      (scalarZ mu sig n t p u1 + sig / mu) * scalarG mu sig n t p u0 * scalarH mu sig n t p u1|
      ≤ (4 + 2 * |sig|) * T := by
    rw [e0, e1]
    have t1 : |2 * scalarD mu sig n t p u0 u1| ≤ 2 * T := by
      rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2)]; linarith
    have t2 : |(scalarZ mu sig n t p u0 * scalarH mu sig n t p u0 +
        sig / mu * scalarH mu sig n t p u0) * scalarG mu sig n t p u1| ≤ (1 + |sig|) * T := by
      rw [abs_mul]
      have := mul_le_mul hB0 g1 (abs_nonneg _) (by positivity)
      calc _ ≤ _ := this
        _ = _ := by ring
    have t3 : |scalarG mu sig n t p u0 * (scalarZ mu sig n t p u1 * scalarH mu sig n t p u1 +
        sig / mu * scalarH mu sig n t p u1)| ≤ (1 + |sig|) * T := by
      rw [abs_mul]
      have := mul_le_mul g0 hB1 (abs_nonneg _) (by positivity)
      calc _ ≤ _ := this
        _ = _ := by ring
    refine (abs_add_le _ _).trans ?_
    have := abs_add_le (2 * scalarD mu sig n t p u0 u1) ((scalarZ mu sig n t p u0 *
      scalarH mu sig n t p u0 + sig / mu * scalarH mu sig n t p u0) * scalarG mu sig n t p u1)
    linarith
  rw [abs_mul]
  have hnt : |-(n : ℝ) / t| ≤ 2 * n / ℓ := by
    rw [abs_div, abs_neg, abs_of_nonneg (Nat.cast_nonneg n), abs_of_pos ht0,
      div_le_div_iff₀ ht0 hℓ]
    have := ht.1
    have : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    nlinarith
  calc _ ≤ 2 * n / ℓ * ((4 + 2 * |sig|) * T) :=
        mul_le_mul hnt hbr (abs_nonneg _) (by positivity)
    _ = _ := by ring

end family


/-! ### Elementary integrability facts on bounded intervals -/

theorem integrableOn_of_bdd {S : Set ℝ} (hS : MeasurableSet S) (hSf : volume S < ∞)
    {f : ℝ → ℝ} (hf : Measurable f) (C : ℝ) (h : ∀ x ∈ S, |f x| ≤ C) : IntegrableOn f S :=
  IntegrableOn.of_bound hSf hf.aestronglyMeasurable C
    (ae_restrict_of_forall_mem hS fun x hx => by rw [Real.norm_eq_abs]; exact h x hx)

theorem integrableOn_Ioc_of_bdd {u v : ℝ} {f : ℝ → ℝ} (hf : Measurable f) (C : ℝ)
    (h : ∀ x ∈ Icc u v, |f x| ≤ C) : IntegrableOn f (Ioc u v) :=
  integrableOn_of_bdd measurableSet_Ioc measure_Ioc_lt_top hf C fun x hx =>
    h x (Ioc_subset_Icc_self hx)

theorem integrableOn_Ico_of_bdd {u v : ℝ} {f : ℝ → ℝ} (hf : Measurable f) (C : ℝ)
    (h : ∀ x ∈ Icc u v, |f x| ≤ C) : IntegrableOn f (Ico u v) :=
  integrableOn_of_bdd measurableSet_Ico measure_Ico_lt_top hf C fun x hx =>
    h x (Ico_subset_Icc_self hx)

theorem measurable_param {F : ℝ → ℝ → ℝ} (hF : Measurable (fun z : ℝ × ℝ => F z.1 z.2))
    (S : Set ℝ) : Measurable (fun t => ∫ p in S, F t p) :=
  (hF.stronglyMeasurable.integral_prod_right' (ν := volume.restrict S)).measurable

theorem abs_setIntegral_Ico_le {u v : ℝ} {f : ℝ → ℝ} {C : ℝ} (h : ∀ x ∈ Icc u v, |f x| ≤ C) :
    |∫ x in Ico u v, f x| ≤ C * volume.real (Ico u v) := by
  rw [← Real.norm_eq_abs]
  exact norm_setIntegral_le_of_norm_le_const measure_Ico_lt_top fun x hx => by
    rw [Real.norm_eq_abs]; exact h x (Ico_subset_Icc_self hx)

/-- Fubini for bounded measurable functions on products of bounded sets. -/
theorem swap_restrict {S T : Set ℝ} (hS : MeasurableSet S) (hT : MeasurableSet T)
    (hSf : volume S < ∞) (hTf : volume T < ∞) {F : ℝ → ℝ → ℝ}
    (hF : Measurable (fun z : ℝ × ℝ => F z.1 z.2)) (C : ℝ)
    (hC : ∀ a ∈ S, ∀ b ∈ T, |F a b| ≤ C) :
    ∫ a in S, ∫ b in T, F a b = ∫ b in T, ∫ a in S, F a b := by
  haveI : IsFiniteMeasure (volume.restrict S) := isFiniteMeasure_restrict.2 hSf.ne
  haveI : IsFiniteMeasure (volume.restrict T) := isFiniteMeasure_restrict.2 hTf.ne
  refine integral_integral_swap ?_
  refine Integrable.of_bound hF.aestronglyMeasurable C ?_
  rw [Measure.prod_restrict]
  filter_upwards [ae_restrict_mem (hS.prod hT)] with z hz
  rw [Real.norm_eq_abs]; exact hC _ hz.1 _ hz.2

theorem sep_add {S T : Set ℝ} {f₁ g₁ f₂ g₂ : ℝ → ℝ} (hf₁ : IntegrableOn f₁ S)
    (hf₂ : IntegrableOn f₂ S) (hg₁ : IntegrableOn g₁ T) (hg₂ : IntegrableOn g₂ T) :
    ∫ p in S, ∫ q in T, (f₁ p * g₁ q + f₂ p * g₂ q) =
      (∫ p in S, f₁ p) * (∫ q in T, g₁ q) + (∫ p in S, f₂ p) * (∫ q in T, g₂ q) := by
  have e : ∀ p, ∫ q in T, (f₁ p * g₁ q + f₂ p * g₂ q) =
      f₁ p * (∫ q in T, g₁ q) + f₂ p * (∫ q in T, g₂ q) := by
    intro p
    rw [integral_add (hg₁.const_mul _) (hg₂.const_mul _), integral_const_mul, integral_const_mul]
  simp_rw [e]
  rw [integral_add (hf₁.mul_const _) (hf₂.mul_const _), integral_mul_const, integral_mul_const]

theorem sep_mul (S T : Set ℝ) (f g : ℝ → ℝ) :
    ∫ p in S, ∫ q in T, f p * g q = (∫ p in S, f p) * (∫ q in T, g q) := by
  simp_rw [integral_const_mul]
  rw [integral_mul_const]

theorem setIntegral_Ico_eq_interval {u v : ℝ} (huv : u ≤ v) (f : ℝ → ℝ) :
    ∫ x in Ico u v, f x = ∫ x in u..v, f x := by
  rw [intervalIntegral.integral_of_le huv, integral_Ico_eq_integral_Ioo,
    integral_Ioc_eq_integral_Ioo]

/-! ### Bounds for a scalar family on a closed cell -/

theorem fam_bound {mu sig : ℝ} {n : ℕ} (hmu : 1 ≤ mu) {ℓ : ℝ} (hℓ : 0 < ℓ) (a u0 u1 : ℝ) :
    ∃ C, ∀ t ∈ Icc (ℓ / 2) ℓ, ∀ p ∈ Icc a (a + ℓ ^ n),
      |scalarD mu sig n t p u0 u1| ≤ C ∧ |scalarP mu sig n t p u0 u1| ≤ C ∧
        |scalarE mu sig n t p u0 u1| ≤ C ∧ |scalarDdot mu sig n t p u0 u1| ≤ C := by
  set Θ := bracketKernelAt (ℓ ^ n) (a + ℓ ^ n / 2)
  set T := (kap n * rho mu sig) ^ 2 * (Θ u0 * Θ u1)
  have hΘ0 := (Auto.Twisted.bracketKernelAt_pos (a := a + ℓ ^ n / 2) (x := u0)
    (by positivity : (0 : ℝ) < ℓ ^ n)).le
  have hΘ1 := (Auto.Twisted.bracketKernelAt_pos (a := a + ℓ ^ n / 2) (x := u1)
    (by positivity : (0 : ℝ) < ℓ ^ n)).le
  have hT : 0 ≤ T := by positivity
  have hmu0 : 0 ≤ mu := by linarith
  have hn : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  refine ⟨T + 2 * (mu + |sig|) * T + 2 * n / ℓ * (4 + 2 * |sig|) * T, fun t ht p hp => ?_⟩
  have hc : |p - (a + ℓ ^ n / 2)| ≤ ℓ ^ n / 2 := by
    rw [abs_le]; constructor <;> linarith [hp.1, hp.2]
  have h1 := abs_scalarD_le (sig := sig) hmu hℓ ht hc u0 u1
  have h2 := abs_scalarP_le (sig := sig) hmu hℓ ht hc u0 u1
  have h3 := abs_scalarE_le (sig := sig) hmu hℓ ht hc u0 u1
  have h4 := abs_scalarDdot_le (sig := sig) hmu hℓ ht hc u0 u1
  have e3 : (mu + |sig|) * (2 * (kap n * rho mu sig) ^ 2) * (Θ u0 * Θ u1) =
      2 * (mu + |sig|) * T := by ring
  have e4 : 2 * n / ℓ * (4 + 2 * |sig|) * (kap n * rho mu sig) ^ 2 * (Θ u0 * Θ u1) =
      2 * n / ℓ * (4 + 2 * |sig|) * T := by ring
  rw [e3] at h3; rw [e4] at h4
  have p1 : 0 ≤ 2 * (mu + |sig|) * T := by positivity
  have p2 : 0 ≤ 2 * n / ℓ * (4 + 2 * |sig|) * T := by positivity
  refine ⟨by linarith, by linarith, by linarith, by linarith⟩

/-! ### The one-dimensional telescope on a half-open interval -/

theorem oneDim_Ico {mu sig : ℝ} {n : ℕ} (hmu : mu ≠ 0) {t : ℝ} (ht : t ≠ 0) {a b : ℝ}
    (hab : a ≤ b) (u0 u1 : ℝ) :
    -t * ∫ p in Ico a b, scalarDdot mu sig n t p u0 u1 =
      (n : ℝ) / Real.pi * (∫ p in Ico a b, scalarP mu sig n t p u0 u1) +
        (n : ℝ) * t ^ n * (scalarE mu sig n t b u0 u1 - scalarE mu sig n t a u0 u1) := by
  have h := Auto.Twisted.scalar_oneDim_telescoping_of_ne_zero (mu := mu) (sig := sig)
    (n := n) (a := a) (b := b) (u0 := u0) (u1 := u1) hmu ht
  have e : ∀ p, deriv (fun q : ℝ => scalarD mu sig n q p u0 u1) t =
      scalarDdot mu sig n t p u0 u1 := fun p => (hasDerivAt_scalarD hmu ht).deriv
  simp_rw [e] at h
  rw [setIntegral_Ico_eq_interval hab, setIntegral_Ico_eq_interval hab, ← h,
    intervalIntegral.integral_const_mul]

/-! ### The single-cell identity at a fixed point `(x, x', y, y')` -/

section cell

variable {mu1 sig1 mu2 sig2 : ℝ} {n1 n2 : ℕ} {ℓ : ℝ}

/-- The bark term in the first variable at the vertical face `{e} × J`. -/
def barkX (mu1 sig1 mu2 sig2 : ℝ) (n1 n2 : ℕ) (ℓ c e u0 u1 v0 v1 : ℝ) : ℝ :=
  ∫ t in Ioc (ℓ / 2) ℓ, t⁻¹ * ((n1 : ℝ) * t ^ n1 * scalarE mu1 sig1 n1 t e u0 u1 *
    ∫ q in Ico c (c + ℓ ^ n2), scalarD mu2 sig2 n2 t q v0 v1)

/-- The bark term in the second variable at the horizontal face `I × {e}`. -/
def barkY (mu1 sig1 mu2 sig2 : ℝ) (n1 n2 : ℕ) (ℓ a e u0 u1 v0 v1 : ℝ) : ℝ :=
  ∫ t in Ioc (ℓ / 2) ℓ, t⁻¹ * ((n2 : ℝ) * t ^ n2 *
    (∫ p in Ico a (a + ℓ ^ n1), scalarD mu1 sig1 n1 t p u0 u1) * scalarE mu2 sig2 n2 t e v0 v1)

theorem cell_identity (hmu1 : 1 ≤ mu1) (hmu2 : 1 ≤ mu2) (hℓ : 0 < ℓ)
    (a c u0 u1 v0 v1 : ℝ) :
    (n1 : ℝ) * (∫ t in Ioc (ℓ / 2) ℓ, t⁻¹ * ∫ p in Ico a (a + ℓ ^ n1),
        ∫ q in Ico c (c + ℓ ^ n2), scalarP mu1 sig1 n1 t p u0 u1 * scalarD mu2 sig2 n2 t q v0 v1) +
      (n2 : ℝ) * (∫ t in Ioc (ℓ / 2) ℓ, t⁻¹ * ∫ p in Ico a (a + ℓ ^ n1),
        ∫ q in Ico c (c + ℓ ^ n2), scalarD mu1 sig1 n1 t p u0 u1 * scalarP mu2 sig2 n2 t q v0 v1) =
    Real.pi * ((∫ p in Ico a (a + ℓ ^ n1), scalarD mu1 sig1 n1 (ℓ / 2) p u0 u1) *
        (∫ q in Ico c (c + ℓ ^ n2), scalarD mu2 sig2 n2 (ℓ / 2) q v0 v1) -
      (∫ p in Ico a (a + ℓ ^ n1), scalarD mu1 sig1 n1 ℓ p u0 u1) *
        (∫ q in Ico c (c + ℓ ^ n2), scalarD mu2 sig2 n2 ℓ q v0 v1)) -
    Real.pi * ((barkX mu1 sig1 mu2 sig2 n1 n2 ℓ c (a + ℓ ^ n1) u0 u1 v0 v1 -
        barkX mu1 sig1 mu2 sig2 n1 n2 ℓ c a u0 u1 v0 v1) +
      (barkY mu1 sig1 mu2 sig2 n1 n2 ℓ a (c + ℓ ^ n2) u0 u1 v0 v1 -
        barkY mu1 sig1 mu2 sig2 n1 n2 ℓ a c u0 u1 v0 v1)) := by
  set b := a + ℓ ^ n1 with hb
  set d := c + ℓ ^ n2 with hd
  have hab : a ≤ b := by rw [hb]; have : 0 < ℓ ^ n1 := by positivity
                         linarith
  have hcd : c ≤ d := by rw [hd]; have : 0 < ℓ ^ n2 := by positivity
                         linarith
  have hmu1' : mu1 ≠ 0 := by linarith
  have hmu2' : mu2 ≠ 0 := by linarith
  obtain ⟨C1, hC1⟩ := fam_bound (sig := sig1) (n := n1) hmu1 hℓ a u0 u1
  obtain ⟨C2, hC2⟩ := fam_bound (sig := sig2) (n := n2) hmu2 hℓ c v0 v1
  have hC1n : 0 ≤ C1 := (abs_nonneg _).trans
    (hC1 ℓ ⟨by linarith, le_rfl⟩ a ⟨le_rfl, hab⟩).1
  have hC2n : 0 ≤ C2 := (abs_nonneg _).trans
    (hC2 ℓ ⟨by linarith, le_rfl⟩ c ⟨le_rfl, hcd⟩).1
  -- names for the one-dimensional integrals
  set aD : ℝ → ℝ := fun t => ∫ p in Ico a b, scalarD mu1 sig1 n1 t p u0 u1 with haD
  set aP : ℝ → ℝ := fun t => ∫ p in Ico a b, scalarP mu1 sig1 n1 t p u0 u1 with haP
  set aDd : ℝ → ℝ := fun t => ∫ p in Ico a b, scalarDdot mu1 sig1 n1 t p u0 u1 with haDd
  set bD : ℝ → ℝ := fun t => ∫ q in Ico c d, scalarD mu2 sig2 n2 t q v0 v1 with hbD
  set bP : ℝ → ℝ := fun t => ∫ q in Ico c d, scalarP mu2 sig2 n2 t q v0 v1 with hbP
  set bDd : ℝ → ℝ := fun t => ∫ q in Ico c d, scalarDdot mu2 sig2 n2 t q v0 v1 with hbDd
  set E1 : ℝ → ℝ → ℝ := fun t e => scalarE mu1 sig1 n1 t e u0 u1 with hE1
  set E2 : ℝ → ℝ → ℝ := fun t e => scalarE mu2 sig2 n2 t e v0 v1 with hE2
  set la := volume.real (Ico a b)
  set lc := volume.real (Ico c d)
  have hla : 0 ≤ la := measureReal_nonneg
  have hlc : 0 ≤ lc := measureReal_nonneg
  -- bounds for the one-dimensional integrals
  have baD : ∀ t ∈ Icc (ℓ / 2) ℓ, |aD t| ≤ C1 * la := fun t ht =>
    abs_setIntegral_Ico_le fun p hp => (hC1 t ht p hp).1
  have baP : ∀ t ∈ Icc (ℓ / 2) ℓ, |aP t| ≤ C1 * la := fun t ht =>
    abs_setIntegral_Ico_le fun p hp => (hC1 t ht p hp).2.1
  have baDd : ∀ t ∈ Icc (ℓ / 2) ℓ, |aDd t| ≤ C1 * la := fun t ht =>
    abs_setIntegral_Ico_le fun p hp => (hC1 t ht p hp).2.2.2
  have bbD : ∀ t ∈ Icc (ℓ / 2) ℓ, |bD t| ≤ C2 * lc := fun t ht =>
    abs_setIntegral_Ico_le fun p hp => (hC2 t ht p hp).1
  have bbP : ∀ t ∈ Icc (ℓ / 2) ℓ, |bP t| ≤ C2 * lc := fun t ht =>
    abs_setIntegral_Ico_le fun p hp => (hC2 t ht p hp).2.1
  have bbDd : ∀ t ∈ Icc (ℓ / 2) ℓ, |bDd t| ≤ C2 * lc := fun t ht =>
    abs_setIntegral_Ico_le fun p hp => (hC2 t ht p hp).2.2.2
  -- measurability
  have maD : Measurable aD := measurable_param (by fun_prop) _
  have maP : Measurable aP := measurable_param (by fun_prop) _
  have maDd : Measurable aDd := measurable_param (by fun_prop) _
  have mbD : Measurable bD := measurable_param (by fun_prop) _
  have mbP : Measurable bP := measurable_param (by fun_prop) _
  have mbDd : Measurable bDd := measurable_param (by fun_prop) _
  have mE1 : ∀ e, Measurable fun t => E1 t e := fun e => by simp only [hE1]; fun_prop
  have mE2 : ∀ e, Measurable fun t => E2 t e := fun e => by simp only [hE2]; fun_prop
  have hinv : ∀ t ∈ Icc (ℓ / 2) ℓ, |t⁻¹| ≤ 2 / ℓ := by
    intro t ht
    have ht0 : 0 < t := lt_of_lt_of_le (half_pos hℓ) ht.1
    rw [abs_of_pos (inv_pos.mpr ht0), inv_le_comm₀ ht0 (by positivity), inv_div]
    exact ht.1
  have hpow : ∀ (k : ℕ), ∀ t ∈ Icc (ℓ / 2) ℓ, |t ^ k| ≤ ℓ ^ k := by
    intro k t ht
    have ht0 : 0 < t := lt_of_lt_of_le (half_pos hℓ) ht.1
    rw [abs_of_pos (pow_pos ht0 k)]
    exact pow_le_pow_left₀ ht0.le ht.2 k
  have hE1b : ∀ e ∈ Icc a b, ∀ t ∈ Icc (ℓ / 2) ℓ, |E1 t e| ≤ C1 := fun e he t ht =>
    (hC1 t ht e he).2.2.1
  have hE2b : ∀ e ∈ Icc c d, ∀ t ∈ Icc (ℓ / 2) ℓ, |E2 t e| ≤ C2 := fun e he t ht =>
    (hC2 t ht e he).2.2.1
  -- Step 1: separation of the cell integrals
  have s1 : ∀ t, ∫ p in Ico a b, ∫ q in Ico c d,
      scalarP mu1 sig1 n1 t p u0 u1 * scalarD mu2 sig2 n2 t q v0 v1 = aP t * bD t :=
    fun t => sep_mul _ _ _ _
  have s2 : ∀ t, ∫ p in Ico a b, ∫ q in Ico c d,
      scalarD mu1 sig1 n1 t p u0 u1 * scalarP mu2 sig2 n2 t q v0 v1 = aD t * bP t :=
    fun t => sep_mul _ _ _ _
  simp_rw [s1, s2]
  -- integrability in `t`
  have iA : IntegrableOn (fun t => t⁻¹ * (aP t * bD t)) (Ioc (ℓ / 2) ℓ) := by
    refine integrableOn_Ioc_of_bdd (measurable_inv.mul (maP.mul mbD))
      (2 / ℓ * (C1 * la * (C2 * lc))) fun t ht => ?_
    rw [abs_mul, abs_mul]
    gcongr
    exacts [hinv t ht, baP t ht, bbD t ht]
  have iB : IntegrableOn (fun t => t⁻¹ * (aD t * bP t)) (Ioc (ℓ / 2) ℓ) := by
    refine integrableOn_Ioc_of_bdd (measurable_inv.mul (maD.mul mbP))
      (2 / ℓ * (C1 * la * (C2 * lc))) fun t ht => ?_
    rw [abs_mul, abs_mul]
    gcongr
    exacts [hinv t ht, baD t ht, bbP t ht]
  have iT : IntegrableOn (fun t => aDd t * bD t + aD t * bDd t) (Ioc (ℓ / 2) ℓ) := by
    refine integrableOn_Ioc_of_bdd ((maDd.mul mbD).add (maD.mul mbDd))
      (C1 * la * (C2 * lc) + C1 * la * (C2 * lc)) fun t ht => ?_
    refine (abs_add_le _ _).trans ?_
    rw [abs_mul, abs_mul]
    gcongr
    exacts [baDd t ht, bbD t ht, baD t ht, bbDd t ht]
  have iX : ∀ e ∈ Icc a b, IntegrableOn
      (fun t => t⁻¹ * ((n1 : ℝ) * t ^ n1 * E1 t e * bD t)) (Ioc (ℓ / 2) ℓ) := by
    intro e he
    refine integrableOn_Ioc_of_bdd (measurable_inv.mul
      (((measurable_const.mul (measurable_id.pow_const _)).mul (mE1 e)).mul mbD))
      (2 / ℓ * ((n1 : ℝ) * ℓ ^ n1 * C1 * (C2 * lc))) fun t ht => ?_
    rw [abs_mul, abs_mul, abs_mul, abs_mul, Nat.abs_cast]
    gcongr
    exacts [hinv t ht, hpow n1 t ht, hE1b e he t ht, bbD t ht]
  have iY : ∀ e ∈ Icc c d, IntegrableOn
      (fun t => t⁻¹ * ((n2 : ℝ) * t ^ n2 * aD t * E2 t e)) (Ioc (ℓ / 2) ℓ) := by
    intro e he
    refine integrableOn_Ioc_of_bdd (measurable_inv.mul
      (((measurable_const.mul (measurable_id.pow_const _)).mul maD).mul (mE2 e)))
      (2 / ℓ * ((n2 : ℝ) * ℓ ^ n2 * (C1 * la) * C2)) fun t ht => ?_
    rw [abs_mul, abs_mul, abs_mul, abs_mul, Nat.abs_cast]
    gcongr
    exacts [hinv t ht, hpow n2 t ht, baD t ht, hE2b e he t ht]
  -- Step 2: the pointwise identity in `t`
  have pt : ∀ t ∈ Ioc (ℓ / 2) ℓ,
      (n1 : ℝ) * (t⁻¹ * (aP t * bD t)) + (n2 : ℝ) * (t⁻¹ * (aD t * bP t)) =
        -Real.pi * (aDd t * bD t + aD t * bDd t) -
          Real.pi * ((t⁻¹ * ((n1 : ℝ) * t ^ n1 * E1 t b * bD t) -
              t⁻¹ * ((n1 : ℝ) * t ^ n1 * E1 t a * bD t)) +
            (t⁻¹ * ((n2 : ℝ) * t ^ n2 * aD t * E2 t d) -
              t⁻¹ * ((n2 : ℝ) * t ^ n2 * aD t * E2 t c))) := by
    intro t ht
    have ht0 : 0 < t := lt_of_lt_of_le (half_pos hℓ) ht.1.le
    have h1 := oneDim_Ico (sig := sig1) (n := n1) hmu1' ht0.ne' hab u0 u1
    have h2 := oneDim_Ico (sig := sig2) (n := n2) hmu2' ht0.ne' hcd v0 v1
    simp only [haD, haP, haDd, hbD, hbP, hbDd, hE1, hE2] at h1 h2 ⊢
    have hpi := Real.pi_pos.ne'
    have hA : (n1 : ℝ) * (∫ p in Ico a b, scalarP mu1 sig1 n1 t p u0 u1) =
        Real.pi * (-t * (∫ p in Ico a b, scalarDdot mu1 sig1 n1 t p u0 u1) -
          (n1 : ℝ) * t ^ n1 * (scalarE mu1 sig1 n1 t b u0 u1 - scalarE mu1 sig1 n1 t a u0 u1)) := by
      rw [h1]; field_simp; ring
    have hB : (n2 : ℝ) * (∫ q in Ico c d, scalarP mu2 sig2 n2 t q v0 v1) =
        Real.pi * (-t * (∫ q in Ico c d, scalarDdot mu2 sig2 n2 t q v0 v1) -
          (n2 : ℝ) * t ^ n2 * (scalarE mu2 sig2 n2 t d v0 v1 - scalarE mu2 sig2 n2 t c v0 v1)) := by
      rw [h2]; field_simp; ring
    have e1 : (n1 : ℝ) * (t⁻¹ * ((∫ p in Ico a b, scalarP mu1 sig1 n1 t p u0 u1) *
        ∫ q in Ico c d, scalarD mu2 sig2 n2 t q v0 v1)) =
        t⁻¹ * ((n1 : ℝ) * (∫ p in Ico a b, scalarP mu1 sig1 n1 t p u0 u1)) *
          ∫ q in Ico c d, scalarD mu2 sig2 n2 t q v0 v1 := by ring
    have e2 : (n2 : ℝ) * (t⁻¹ * ((∫ p in Ico a b, scalarD mu1 sig1 n1 t p u0 u1) *
        ∫ q in Ico c d, scalarP mu2 sig2 n2 t q v0 v1)) =
        t⁻¹ * (∫ p in Ico a b, scalarD mu1 sig1 n1 t p u0 u1) *
          ((n2 : ℝ) * ∫ q in Ico c d, scalarP mu2 sig2 n2 t q v0 v1) := by ring
    rw [e1, e2, hA, hB]
    field_simp
    ring
  -- Step 3: integrate in `t`
  have step3 : (n1 : ℝ) * (∫ t in Ioc (ℓ / 2) ℓ, t⁻¹ * (aP t * bD t)) +
      (n2 : ℝ) * (∫ t in Ioc (ℓ / 2) ℓ, t⁻¹ * (aD t * bP t)) =
      -Real.pi * (∫ t in Ioc (ℓ / 2) ℓ, (aDd t * bD t + aD t * bDd t)) -
        Real.pi * ((barkX mu1 sig1 mu2 sig2 n1 n2 ℓ c b u0 u1 v0 v1 -
            barkX mu1 sig1 mu2 sig2 n1 n2 ℓ c a u0 u1 v0 v1) +
          (barkY mu1 sig1 mu2 sig2 n1 n2 ℓ a d u0 u1 v0 v1 -
            barkY mu1 sig1 mu2 sig2 n1 n2 ℓ a c u0 u1 v0 v1)) := by
    have hbm : b ∈ Icc a b := ⟨hab, le_rfl⟩
    have ham : a ∈ Icc a b := ⟨le_rfl, hab⟩
    have hdm : d ∈ Icc c d := ⟨hcd, le_rfl⟩
    have hcm : c ∈ Icc c d := ⟨le_rfl, hcd⟩
    unfold barkX barkY
    rw [← integral_const_mul, ← integral_const_mul, ← integral_add (iA.const_mul _)
      (iB.const_mul _), setIntegral_congr_fun measurableSet_Ioc pt,
      integral_sub (iT.const_mul _), integral_const_mul, integral_const_mul]
    · congr 2
      rw [integral_add, integral_sub (iX b hbm) (iX a ham), integral_sub (iY d hdm) (iY c hcm)]
      · exact (iX b hbm).sub (iX a ham)
      · exact (iY d hdm).sub (iY c hcm)
    · exact ((((iX b hbm).sub (iX a ham)).add ((iY d hdm).sub (iY c hcm))).const_mul _)
  rw [step3]
  -- Step 4: the scale integral by Fubini and the fundamental theorem of calculus
  have fubini : ∫ t in Ioc (ℓ / 2) ℓ, (aDd t * bD t + aD t * bDd t) =
      aD ℓ * bD ℓ - aD (ℓ / 2) * bD (ℓ / 2) := by
    set G : ℝ → ℝ → ℝ → ℝ := fun t p q =>
      scalarDdot mu1 sig1 n1 t p u0 u1 * scalarD mu2 sig2 n2 t q v0 v1 +
        scalarD mu1 sig1 n1 t p u0 u1 * scalarDdot mu2 sig2 n2 t q v0 v1 with hG
    have hGb : ∀ t ∈ Icc (ℓ / 2) ℓ, ∀ p ∈ Icc a b, ∀ q ∈ Icc c d,
        |G t p q| ≤ C1 * C2 + C1 * C2 := by
      intro t ht p hp q hq
      refine (abs_add_le _ _).trans ?_
      rw [abs_mul, abs_mul]
      gcongr
      exacts [(hC1 t ht p hp).2.2.2, (hC2 t ht q hq).1, (hC1 t ht p hp).1,
        (hC2 t ht q hq).2.2.2]
    have hGm : Measurable (fun z : ℝ × ℝ × ℝ => G z.1 z.2.1 z.2.2) := by
      simp only [hG]; fun_prop
    -- inner separation
    have sepG : ∀ t ∈ Ioc (ℓ / 2) ℓ, aDd t * bD t + aD t * bDd t =
        ∫ p in Ico a b, ∫ q in Ico c d, G t p q := by
      intro t ht
      have ht' : t ∈ Icc (ℓ / 2) ℓ := Ioc_subset_Icc_self ht
      simp only [hG]
      rw [sep_add]
      · exact integrableOn_Ico_of_bdd (by fun_prop) C1 fun p hp => (hC1 t ht' p hp).2.2.2
      · exact integrableOn_Ico_of_bdd (by fun_prop) C1 fun p hp => (hC1 t ht' p hp).1
      · exact integrableOn_Ico_of_bdd (by fun_prop) C2 fun q hq => (hC2 t ht' q hq).1
      · exact integrableOn_Ico_of_bdd (by fun_prop) C2 fun q hq => (hC2 t ht' q hq).2.2.2
    rw [setIntegral_congr_fun measurableSet_Ioc sepG]
    -- swap `t` and `p`
    have sw1 : ∫ t in Ioc (ℓ / 2) ℓ, ∫ p in Ico a b, ∫ q in Ico c d, G t p q =
        ∫ p in Ico a b, ∫ t in Ioc (ℓ / 2) ℓ, ∫ q in Ico c d, G t p q := by
      refine swap_restrict measurableSet_Ioc measurableSet_Ico measure_Ioc_lt_top
        measure_Ico_lt_top ?_ ((C1 * C2 + C1 * C2) * lc) fun t ht p hp => ?_
      · have hm : Measurable (fun z : (ℝ × ℝ) × ℝ => G z.1.1 z.1.2 z.2) :=
          hGm.comp ((measurable_fst.comp measurable_fst).prodMk
            ((measurable_snd.comp measurable_fst).prodMk measurable_snd))
        exact (hm.stronglyMeasurable.integral_prod_right'
          (ν := volume.restrict (Ico c d))).measurable
      · exact abs_setIntegral_Ico_le fun q hq =>
          hGb t (Ioc_subset_Icc_self ht) p (Ico_subset_Icc_self hp) q hq
    rw [sw1]
    have sw2 : ∀ p ∈ Ico a b, ∫ t in Ioc (ℓ / 2) ℓ, ∫ q in Ico c d, G t p q =
        ∫ q in Ico c d, ∫ t in Ioc (ℓ / 2) ℓ, G t p q := by
      intro p hp
      refine swap_restrict measurableSet_Ioc measurableSet_Ico measure_Ioc_lt_top
        measure_Ico_lt_top ?_ (C1 * C2 + C1 * C2) fun t ht q hq =>
          hGb t (Ioc_subset_Icc_self ht) p (Ico_subset_Icc_self hp) q (Ico_subset_Icc_self hq)
      exact hGm.comp (measurable_fst.prodMk (measurable_const.prodMk measurable_snd))
    rw [setIntegral_congr_fun measurableSet_Ico sw2]
    -- the fundamental theorem of calculus in `t`
    have ftc : ∀ p ∈ Ico a b, ∀ q ∈ Ico c d, ∫ t in Ioc (ℓ / 2) ℓ, G t p q =
        scalarD mu1 sig1 n1 ℓ p u0 u1 * scalarD mu2 sig2 n2 ℓ q v0 v1 -
          scalarD mu1 sig1 n1 (ℓ / 2) p u0 u1 * scalarD mu2 sig2 n2 (ℓ / 2) q v0 v1 := by
      intro p hp q hq
      have hle : ℓ / 2 ≤ ℓ := by linarith
      rw [← intervalIntegral.integral_of_le hle]
      refine intervalIntegral.integral_eq_sub_of_hasDerivAt (f := fun t =>
        scalarD mu1 sig1 n1 t p u0 u1 * scalarD mu2 sig2 n2 t q v0 v1) (fun t ht => ?_) ?_
      · rw [uIcc_of_le hle] at ht
        have ht0 : t ≠ 0 := (lt_of_lt_of_le (half_pos hℓ) ht.1).ne'
        exact (hasDerivAt_scalarD (sig := sig1) (n := n1) (p := p) (u0 := u0) (u1 := u1)
          hmu1' ht0).mul (hasDerivAt_scalarD (sig := sig2) (n := n2) (p := q) (u0 := v0)
            (u1 := v1) hmu2' ht0)
      · rw [intervalIntegrable_iff_integrableOn_Ioc_of_le hle]
        refine integrableOn_Ioc_of_bdd ?_ (C1 * C2 + C1 * C2) fun t ht =>
          hGb t ht p (Ico_subset_Icc_self hp) q (Ico_subset_Icc_self hq)
        exact hGm.comp (measurable_id.prodMk (measurable_const.prodMk measurable_const))
    have ftc' : ∀ p ∈ Ico a b, ∫ q in Ico c d, ∫ t in Ioc (ℓ / 2) ℓ, G t p q =
        scalarD mu1 sig1 n1 ℓ p u0 u1 * bD ℓ -
          scalarD mu1 sig1 n1 (ℓ / 2) p u0 u1 * bD (ℓ / 2) := by
      intro p hp
      rw [setIntegral_congr_fun measurableSet_Ico (ftc p hp), integral_sub,
        integral_const_mul, integral_const_mul]
      · exact (integrableOn_Ico_of_bdd (by fun_prop) C2 fun q hq =>
          (hC2 ℓ ⟨by linarith, le_rfl⟩ q hq).1).const_mul _
      · exact (integrableOn_Ico_of_bdd (by fun_prop) C2 fun q hq =>
          (hC2 (ℓ / 2) ⟨le_rfl, by linarith⟩ q hq).1).const_mul _
    rw [setIntegral_congr_fun measurableSet_Ico ftc', integral_sub, integral_mul_const,
      integral_mul_const]
    · exact (integrableOn_Ico_of_bdd (by fun_prop) C1 fun p hp =>
        (hC1 ℓ ⟨by linarith, le_rfl⟩ p hp).1).mul_const _
    · exact (integrableOn_Ico_of_bdd (by fun_prop) C1 fun p hp =>
        (hC1 (ℓ / 2) ⟨le_rfl, by linarith⟩ p hp).1).mul_const _
  rw [fubini]
  ring

end cell


end Telescoping

namespace DyRect

/-- The right neighbour `Q + e₁` (same scale). -/
def shx (Q : DyRect) : DyRect := ⟨Q.lev, Q.m + 1, Q.n⟩

/-- The upper neighbour `Q + e₂` (same scale). -/
def shy (Q : DyRect) : DyRect := ⟨Q.lev, Q.m, Q.n + 1⟩

variable (α β : ℕ) (Q : DyRect)

theorem shx_x0 : (shx Q).x0 α = Q.x0 α + Q.sx α := by
  simp only [shx, x0, sx]; push_cast; ring

theorem shy_y0 : (shy Q).y0 β = Q.y0 β + Q.sy β := by
  simp only [shy, y0, sy]; push_cast; ring

theorem ix_eq : Q.ix α = Ico (Q.x0 α) (Q.x0 α + Q.len ^ α) := by rw [ix, sx_eq_len_pow]

theorem iy_eq : Q.iy β = Ico (Q.y0 β) (Q.y0 β + Q.len ^ β) := by rw [iy, sy_eq_len_pow]

theorem center_fst : (Q.center α β).1 = Q.x0 α + Q.sx α / 2 := rfl

theorem center_snd : (Q.center α β).2 = Q.y0 β + Q.sy β / 2 := rfl

theorem abs_sub_center_fst {p : ℝ} (hp : p ∈ Icc (Q.x0 α) (Q.x0 α + Q.sx α)) :
    |p - (Q.center α β).1| ≤ Q.len ^ α / 2 := by
  rw [center_fst, ← sx_eq_len_pow, abs_le]
  constructor <;> linarith [hp.1, hp.2]

theorem abs_sub_center_snd {q : ℝ} (hq : q ∈ Icc (Q.y0 β) (Q.y0 β + Q.sy β)) :
    |q - (Q.center α β).2| ≤ Q.len ^ β / 2 := by
  rw [center_snd, ← sy_eq_len_pow, abs_le]
  constructor <;> linarith [hq.1, hq.2]

end DyRect

namespace Telescoping

/-! ### The comparison weights of a rectangle -/

/-- `θ_{ℓ(Q)^α, c(Q)_1}`. -/
def wx (α β : ℕ) (Q : DyRect) : ℝ → ℝ := bracketKernelAt (Q.sx α) (Q.center α β).1

/-- `θ_{ℓ(Q)^β, c(Q)_2}`. -/
def wy (α β : ℕ) (Q : DyRect) : ℝ → ℝ := bracketKernelAt (Q.sy β) (Q.center α β).2

theorem wts_Q (α β : ℕ) (Q : DyRect) : Wts (wx α β Q) (wy α β Q) :=
  wts_bracket (Q.sx_pos α) (Q.sy_pos β) _ _

theorem wx_nonneg (α β : ℕ) (Q : DyRect) (x : ℝ) : 0 ≤ wx α β Q x :=
  (Auto.Twisted.bracketKernelAt_pos (Q.sx_pos α)).le

theorem wy_nonneg (α β : ℕ) (Q : DyRect) (y : ℝ) : 0 ≤ wy α β Q y :=
  (Auto.Twisted.bracketKernelAt_pos (Q.sy_pos β)).le

theorem sizeQ_eq (α β : ℕ) (f : ℝ × ℝ → ℝ) (Q : DyRect) :
    sizeQ α β f Q = √(sizeAt f (Q.sx α) (Q.sy β) (Q.center α β).1 (Q.center α β).2) := rfl

/-! ### Kernel bounds on a closed cell -/

/-- The constant of the first-variable kernels, `(κ_α λ^9)^2`. -/
def Kx (α : ℕ) (lam : ℝ) : ℝ := (kap α * rho lam 0) ^ 2

/-- The constant of the second-variable kernels, `(κ_β (1+|r|)^{10})^2`. -/
def Ky (β : ℕ) (r : ℝ) : ℝ := (kap β * rho 1 r) ^ 2

theorem Kx_nonneg (α : ℕ) (lam : ℝ) : 0 ≤ Kx α lam := sq_nonneg _

theorem Ky_nonneg (β : ℕ) (r : ℝ) : 0 ≤ Ky β r := sq_nonneg _

section bounds

variable {α β : ℕ} {lam r : ℝ} (Q : DyRect) {t p q : ℝ}

theorem xD_le (hlam : 1 ≤ lam) (ht : t ∈ Icc (Q.len / 2) Q.len)
    (hp : p ∈ Icc (Q.x0 α) (Q.x0 α + Q.sx α)) (x x' : ℝ) :
    |scalarD lam 0 α t p x x'| ≤ Kx α lam * (wx α β Q x * wx α β Q x') := by
  have h := abs_scalarD_le (sig := 0) hlam Q.len_pos ht (Q.abs_sub_center_fst α β hp) x x'
  rwa [← DyRect.sx_eq_len_pow] at h

theorem xP_le (hlam : 1 ≤ lam) (ht : t ∈ Icc (Q.len / 2) Q.len)
    (hp : p ∈ Icc (Q.x0 α) (Q.x0 α + Q.sx α)) (x x' : ℝ) :
    |scalarP lam 0 α t p x x'| ≤ Kx α lam * (wx α β Q x * wx α β Q x') := by
  have h := abs_scalarP_le (sig := 0) hlam Q.len_pos ht (Q.abs_sub_center_fst α β hp) x x'
  rwa [← DyRect.sx_eq_len_pow] at h

theorem xE_le (hlam : 1 ≤ lam) (ht : t ∈ Icc (Q.len / 2) Q.len)
    (hp : p ∈ Icc (Q.x0 α) (Q.x0 α + Q.sx α)) (x x' : ℝ) :
    |scalarE lam 0 α t p x x'| ≤ lam * (2 * Kx α lam) * (wx α β Q x * wx α β Q x') := by
  have h := abs_scalarE_le (sig := 0) hlam Q.len_pos ht (Q.abs_sub_center_fst α β hp) x x'
  rw [← DyRect.sx_eq_len_pow] at h
  simpa [Kx, wx] using h

theorem yD_le (ht : t ∈ Icc (Q.len / 2) Q.len)
    (hq : q ∈ Icc (Q.y0 β) (Q.y0 β + Q.sy β)) (y y' : ℝ) :
    |scalarD 1 r β t q y y'| ≤ Ky β r * (wy α β Q y * wy α β Q y') := by
  have h := abs_scalarD_le (sig := r) le_rfl Q.len_pos ht (Q.abs_sub_center_snd α β hq) y y'
  rwa [← DyRect.sy_eq_len_pow] at h

theorem yP_le (ht : t ∈ Icc (Q.len / 2) Q.len)
    (hq : q ∈ Icc (Q.y0 β) (Q.y0 β + Q.sy β)) (y y' : ℝ) :
    |scalarP 1 r β t q y y'| ≤ Ky β r * (wy α β Q y * wy α β Q y') := by
  have h := abs_scalarP_le (sig := r) le_rfl Q.len_pos ht (Q.abs_sub_center_snd α β hq) y y'
  rwa [← DyRect.sy_eq_len_pow] at h

theorem yE_le (ht : t ∈ Icc (Q.len / 2) Q.len)
    (hq : q ∈ Icc (Q.y0 β) (Q.y0 β + Q.sy β)) (y y' : ℝ) :
    |scalarE 1 r β t q y y'| ≤ (1 + |r|) * (2 * Ky β r) * (wy α β Q y * wy α β Q y') := by
  have h := abs_scalarE_le (sig := r) le_rfl Q.len_pos ht (Q.abs_sub_center_snd α β hq) y y'
  rwa [← DyRect.sy_eq_len_pow] at h

end bounds

/-! ### Bounds for the cell integral -/

theorem abs_cellInt_le_area {α β : ℕ} (Q : DyRect) {G : ℝ → ℝ → ℝ → ℝ} {C : ℝ}
    (hG : ∀ t p q, InCell α β Q t p q → |G t p q| ≤ C) :
    |cellInt α β Q G| ≤ C * Q.area α β := by
  have hℓ := Q.len_pos
  have hsx := Q.sx_pos α
  have hsy := Q.sy_pos β
  unfold cellInt
  rw [← Real.norm_eq_abs]
  have hvt : volume.real (Ioc (Q.len / 2) Q.len) = Q.len / 2 := by
    rw [Real.volume_real_Ioc_of_le (by linarith)]; ring
  have hvx : volume.real (Q.ix α) = Q.sx α := by
    rw [DyRect.ix, Real.volume_real_Ico_of_le (by linarith)]; ring
  have hvy : volume.real (Q.iy β) = Q.sy β := by
    rw [DyRect.iy, Real.volume_real_Ico_of_le (by linarith)]; ring
  refine (norm_setIntegral_le_of_norm_le_const (C := 2 / Q.len * (C * Q.sy β * Q.sx α))
    measure_Ioc_lt_top fun t ht => ?_).trans_eq ?_
  · have ht0 : 0 < t := lt_of_lt_of_le (half_pos hℓ) ht.1.le
    rw [norm_mul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr ht0)]
    have hinv : t⁻¹ ≤ 2 / Q.len := by
      rw [inv_le_comm₀ ht0 (by positivity), inv_div]; exact ht.1.le
    have hin : ‖∫ p in Q.ix α, ∫ q in Q.iy β, G t p q‖ ≤ C * Q.sy β * Q.sx α := by
      refine (norm_setIntegral_le_of_norm_le_const (C := C * Q.sy β)
        (by unfold DyRect.ix; exact measure_Ico_lt_top) fun p hp => ?_).trans_eq
          (by rw [hvx])
      refine (norm_setIntegral_le_of_norm_le_const (C := C)
        (by unfold DyRect.iy; exact measure_Ico_lt_top) fun q hq => ?_).trans_eq
          (by rw [hvy])
      rw [Real.norm_eq_abs]
      unfold DyRect.ix at hp; unfold DyRect.iy at hq
      exact hG t p q ⟨Ioc_subset_Icc_self ht, Ico_subset_Icc_self hp, Ico_subset_Icc_self hq⟩
    have hCn : 0 ≤ C * Q.sy β * Q.sx α := (norm_nonneg _).trans hin
    calc _ ≤ 2 / Q.len * ‖∫ p in Q.ix α, ∫ q in Q.iy β, G t p q‖ :=
          mul_le_mul_of_nonneg_right hinv (norm_nonneg _)
      _ ≤ _ := mul_le_mul_of_nonneg_left hin (by positivity)
  · rw [hvt, DyRect.area]; field_simp

/-- A cell integral of a dominated kernel is dominated. -/
theorem dom_cellInt {α β : ℕ} (Q : DyRect) {A B : ℝ → ℝ} {c : ℝ}
    (K : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ)
    (hK : Measurable (fun p : (ℝ × ℝ × ℝ) × W4 =>
      K p.1.1 p.1.2.1 p.1.2.2 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2))
    (hdom : ∀ t p q, InCell α β Q t p q → ∀ x x' y y',
      |K t p q x x' y y'| ≤ c * wt A B x x' y y') :
    Dom A B (c * Q.area α β)
      (fun x x' y y' => cellInt α β Q (fun t p q => K t p q x x' y y')) := by
  refine ⟨?_, fun x x' y y' => ?_⟩
  · have hbd : ∀ t p q, InCell α β Q t p q → ∀ x x' y y',
        |t⁻¹ * K t p q x x' y y'| ≤ (2 / Q.len * c) * wt A B x x' y y' := by
      intro t p q h x x' y y'
      have ht := inCell_t_pos h
      have ht' : t⁻¹ ≤ 2 / Q.len := by
        rw [inv_le_comm₀ ht (by have := Q.len_pos; positivity)]
        have := h.1.1; rw [inv_div]; exact this
      rw [abs_mul, abs_of_pos (inv_pos.mpr ht), mul_assoc]
      exact mul_le_mul ht' (hdom t p q h x x' y y') (abs_nonneg _)
        (by have := Q.len_pos; positivity)
    have hK' : Measurable (fun p : (ℝ × ℝ × ℝ) × W4 =>
        p.1.1⁻¹ * K p.1.1 p.1.2.1 p.1.2.2 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2) :=
      (measurable_fst.comp measurable_fst).inv.mul hK
    have e : (fun w : W4 => cellInt α β Q (fun t p q => K t p q w.1 w.2.1 w.2.2.1 w.2.2.2)) =
        fun w => ∫ z, z.1⁻¹ * K z.1 z.2.1 z.2.2 w.1 w.2.1 w.2.2.1 w.2.2.2
          ∂(cellMeasure α β Q) := by
      funext w
      refine cellInt_eq_integral α β Q _ (integrable_cell ?_
        (2 / Q.len * c * wt A B w.1 w.2.1 w.2.2.1 w.2.2.2) fun t p q h => hbd t p q h _ _ _ _)
      exact (hK'.comp (measurable_id.prodMk
        (measurable_const (a := w)))).aestronglyMeasurable
    rw [e]
    exact hK'.stronglyMeasurable.integral_prod_left'.measurable
  · have := abs_cellInt_le_area (α := α) (β := β) Q (G := fun t p q => K t p q x x' y y')
      (C := c * wt A B x x' y y') fun t p q h => hdom t p q h x x' y y'
    calc _ ≤ _ := this
      _ = _ := by ring


theorem measurable_param' {X : Type*} [MeasurableSpace X] {F : X → ℝ → ℝ}
    (hF : Measurable (fun z : X × ℝ => F z.1 z.2)) (S : Set ℝ) :
    Measurable (fun x => ∫ p in S, F x p) :=
  (hF.stronglyMeasurable.integral_prod_right' (ν := volume.restrict S)).measurable

/-! ### The kernels of the single-rectangle identity -/

/-- The endpoint kernel of `R` at scale `s`:
`∫_{I_R} g_{λs^α,p}(x) g_{λs^α,p}(x') dp ∫_{J_R} g_{s^β,q+rs^β}(y) g_{s^β,q+rs^β}(y') dq`. -/
def endK (α β : ℕ) (lam r : ℝ) (R : DyRect) (s : ℝ) (x x' y y' : ℝ) : ℝ :=
  (∫ p in R.ix α, scalarD lam 0 α s p x x') * (∫ q in R.iy β, scalarD 1 r β s q y y')

/-- The bark kernel of `R` on its left face `{x_0(R)} × J_R`. -/
def barkXK (α β : ℕ) (lam r : ℝ) (R : DyRect) (x x' y y' : ℝ) : ℝ :=
  barkX lam 0 1 r α β R.len (R.y0 β) (R.x0 α) x x' y y'

/-- The bark kernel of `R` on its lower face `I_R × {y_0(R)}`. -/
def barkYK (α β : ℕ) (lam r : ℝ) (R : DyRect) (x x' y y' : ℝ) : ℝ :=
  barkY lam 0 1 r α β R.len (R.x0 α) (R.y0 β) x x' y y'

section doms

variable {α β : ℕ} {lam r : ℝ}

theorem dom_endK (hlam : 1 ≤ lam) (P R : DyRect) {s : ℝ} (hs : s ∈ Icc (P.len / 2) P.len)
    (hI : ∀ p ∈ R.ix α, p ∈ Icc (P.x0 α) (P.x0 α + P.sx α))
    (hJ : ∀ q ∈ R.iy β, q ∈ Icc (P.y0 β) (P.y0 β + P.sy β)) :
    Dom (wx α β P) (wy α β P) (Kx α lam * Ky β r * R.area α β) (endK α β lam r R s) := by
  refine ⟨?_, fun x x' y y' => ?_⟩
  · unfold endK
    refine Measurable.mul ?_ ?_
    · exact (measurable_param' (X := W4) (F := fun w p => scalarD lam 0 α s p w.1 w.2.1)
        (by fun_prop) _)
    · exact (measurable_param' (X := W4)
        (F := fun w q => scalarD 1 r β s q w.2.2.1 w.2.2.2) (by fun_prop) _)
  · have hvx : volume.real (R.ix α) = R.sx α := by
      rw [DyRect.ix, Real.volume_real_Ico_of_le (by linarith [R.sx_pos α])]; ring
    have hvy : volume.real (R.iy β) = R.sy β := by
      rw [DyRect.iy, Real.volume_real_Ico_of_le (by linarith [R.sy_pos β])]; ring
    have h1 : |∫ p in R.ix α, scalarD lam 0 α s p x x'| ≤
        Kx α lam * (wx α β P x * wx α β P x') * R.sx α := by
      rw [← Real.norm_eq_abs, ← hvx]
      exact norm_setIntegral_le_of_norm_le_const (by unfold DyRect.ix; exact measure_Ico_lt_top)
        fun p hp => by rw [Real.norm_eq_abs]; exact xD_le P hlam hs (hI p hp) x x'
    have h2 : |∫ q in R.iy β, scalarD 1 r β s q y y'| ≤
        Ky β r * (wy α β P y * wy α β P y') * R.sy β := by
      rw [← Real.norm_eq_abs, ← hvy]
      exact norm_setIntegral_le_of_norm_le_const (by unfold DyRect.iy; exact measure_Ico_lt_top)
        fun q hq => by rw [Real.norm_eq_abs]; exact yD_le P hs (hJ q hq) y y'
    unfold endK
    rw [abs_mul]
    have := mul_le_mul h1 h2 (abs_nonneg _) (by
      have := Kx_nonneg α lam; have := wx_nonneg α β P x; have := wx_nonneg α β P x'
      have := R.sx_pos α
      positivity)
    calc _ ≤ _ := this
      _ = _ := by unfold wt DyRect.area; ring

/-- The bark kernels of `barkX` type are dominated. -/
theorem dom_barkX (hlam : 1 ≤ lam) (Q : DyRect) {e : ℝ}
    (he : e ∈ Icc (Q.x0 α) (Q.x0 α + Q.sx α)) :
    Dom (wx α β Q) (wy α β Q) ((α : ℝ) * (lam * (2 * Kx α lam)) * Ky β r * Q.area α β)
      (fun x x' y y' => barkX lam 0 1 r α β Q.len (Q.y0 β) e x x' y y') := by
  have hℓ := Q.len_pos
  refine ⟨?_, fun x x' y y' => ?_⟩
  · unfold barkX
    have hin : Measurable (fun z : W4 × ℝ =>
        ∫ q in Ico (Q.y0 β) (Q.y0 β + Q.len ^ β), scalarD 1 r β z.2 q z.1.2.2.1 z.1.2.2.2) :=
      measurable_param' (X := W4 × ℝ) (F := fun z q => scalarD 1 r β z.2 q z.1.2.2.1 z.1.2.2.2)
        (by fun_prop) _
    refine measurable_param' (X := W4) (F := fun w t => t⁻¹ * ((α : ℝ) * t ^ α *
      scalarE lam 0 α t e w.1 w.2.1 * ∫ q in Ico (Q.y0 β) (Q.y0 β + Q.len ^ β),
        scalarD 1 r β t q w.2.2.1 w.2.2.2)) ?_ _
    exact measurable_snd.inv.mul (((measurable_const.mul (measurable_snd.pow_const _)).mul
      (by fun_prop)).mul hin)
  · unfold barkX
    rw [← DyRect.iy_eq]
    have hvt : volume.real (Ioc (Q.len / 2) Q.len) = Q.len / 2 := by
      rw [Real.volume_real_Ioc_of_le (by linarith)]; ring
    have hvy : volume.real (Q.iy β) = Q.sy β := by
      rw [DyRect.iy, Real.volume_real_Ico_of_le (by linarith [Q.sy_pos β])]; ring
    set Cx := lam * (2 * Kx α lam) * (wx α β Q x * wx α β Q x')
    set Cy := Ky β r * (wy α β Q y * wy α β Q y') * Q.sy β
    have hCx : 0 ≤ Cx := by
      have := Kx_nonneg α lam; have := wx_nonneg α β Q x; have := wx_nonneg α β Q x'
      have : 0 ≤ lam := by linarith
      positivity
    rw [← Real.norm_eq_abs]
    refine (norm_setIntegral_le_of_norm_le_const
      (C := 2 / Q.len * ((α : ℝ) * Q.len ^ α * Cx * Cy)) measure_Ioc_lt_top
      fun t ht => ?_).trans_eq ?_
    · have ht' : t ∈ Icc (Q.len / 2) Q.len := Ioc_subset_Icc_self ht
      have ht0 : 0 < t := lt_of_lt_of_le (half_pos hℓ) ht.1.le
      have hinv : |t⁻¹| ≤ 2 / Q.len := by
        rw [abs_of_pos (inv_pos.mpr ht0), inv_le_comm₀ ht0 (by positivity), inv_div]
        exact ht.1.le
      have hpow : |t ^ α| ≤ Q.len ^ α := by
        rw [abs_of_pos (pow_pos ht0 α)]; exact pow_le_pow_left₀ ht0.le ht.2 α
      have hE := xE_le (β := β) Q hlam ht' he x x'
      have hD : |∫ q in Q.iy β, scalarD 1 r β t q y y'| ≤ Cy := by
        rw [← Real.norm_eq_abs]
        refine (norm_setIntegral_le_of_norm_le_const
          (by unfold DyRect.iy; exact measure_Ico_lt_top)
          fun q hq => by
            rw [Real.norm_eq_abs]
            unfold DyRect.iy at hq
            exact yD_le (α := α) Q ht' (Ico_subset_Icc_self hq) y y').trans_eq (by rw [hvy])
      rw [Real.norm_eq_abs, abs_mul, abs_mul, abs_mul, abs_mul, Nat.abs_cast]
      gcongr
    · rw [hvt, ← DyRect.sx_eq_len_pow]
      unfold wt DyRect.area
      simp only [Cx, Cy]
      field_simp

/-- The bark kernels of `barkY` type are dominated. -/
theorem dom_barkY (hlam : 1 ≤ lam) (Q : DyRect) {e : ℝ}
    (he : e ∈ Icc (Q.y0 β) (Q.y0 β + Q.sy β)) :
    Dom (wx α β Q) (wy α β Q)
      ((β : ℝ) * ((1 + |r|) * (2 * Ky β r)) * Kx α lam * Q.area α β)
      (fun x x' y y' => barkY lam 0 1 r α β Q.len (Q.x0 α) e x x' y y') := by
  have hℓ := Q.len_pos
  refine ⟨?_, fun x x' y y' => ?_⟩
  · unfold barkY
    have hin : Measurable (fun z : W4 × ℝ =>
        ∫ p in Ico (Q.x0 α) (Q.x0 α + Q.len ^ α), scalarD lam 0 α z.2 p z.1.1 z.1.2.1) :=
      measurable_param' (X := W4 × ℝ) (F := fun z p => scalarD lam 0 α z.2 p z.1.1 z.1.2.1)
        (by fun_prop) _
    refine measurable_param' (X := W4) (F := fun w t => t⁻¹ * ((β : ℝ) * t ^ β *
      (∫ p in Ico (Q.x0 α) (Q.x0 α + Q.len ^ α), scalarD lam 0 α t p w.1 w.2.1) *
        scalarE 1 r β t e w.2.2.1 w.2.2.2)) ?_ _
    exact measurable_snd.inv.mul (((measurable_const.mul (measurable_snd.pow_const _)).mul
      hin).mul (by fun_prop))
  · unfold barkY
    rw [← DyRect.ix_eq]
    have hvt : volume.real (Ioc (Q.len / 2) Q.len) = Q.len / 2 := by
      rw [Real.volume_real_Ioc_of_le (by linarith)]; ring
    have hvx : volume.real (Q.ix α) = Q.sx α := by
      rw [DyRect.ix, Real.volume_real_Ico_of_le (by linarith [Q.sx_pos α])]; ring
    set Cx := Kx α lam * (wx α β Q x * wx α β Q x') * Q.sx α
    set Cy := (1 + |r|) * (2 * Ky β r) * (wy α β Q y * wy α β Q y')
    have hCx : 0 ≤ Cx := by
      have := Kx_nonneg α lam; have := wx_nonneg α β Q x; have := wx_nonneg α β Q x'
      have := Q.sx_pos α
      positivity
    rw [← Real.norm_eq_abs]
    refine (norm_setIntegral_le_of_norm_le_const
      (C := 2 / Q.len * ((β : ℝ) * Q.len ^ β * Cx * Cy)) measure_Ioc_lt_top
      fun t ht => ?_).trans_eq ?_
    · have ht' : t ∈ Icc (Q.len / 2) Q.len := Ioc_subset_Icc_self ht
      have ht0 : 0 < t := lt_of_lt_of_le (half_pos hℓ) ht.1.le
      have hinv : |t⁻¹| ≤ 2 / Q.len := by
        rw [abs_of_pos (inv_pos.mpr ht0), inv_le_comm₀ ht0 (by positivity), inv_div]
        exact ht.1.le
      have hpow : |t ^ β| ≤ Q.len ^ β := by
        rw [abs_of_pos (pow_pos ht0 β)]; exact pow_le_pow_left₀ ht0.le ht.2 β
      have hE := yE_le (α := α) (r := r) Q ht' he y y'
      have hD : |∫ p in Q.ix α, scalarD lam 0 α t p x x'| ≤ Cx := by
        rw [← Real.norm_eq_abs]
        refine (norm_setIntegral_le_of_norm_le_const
          (by unfold DyRect.ix; exact measure_Ico_lt_top)
          fun p hp => by
            rw [Real.norm_eq_abs]
            unfold DyRect.ix at hp
            exact xD_le (β := β) Q hlam ht' (Ico_subset_Icc_self hp) x x').trans_eq (by rw [hvx])
      rw [Real.norm_eq_abs, abs_mul, abs_mul, abs_mul, abs_mul, Nat.abs_cast]
      gcongr
    · rw [hvt, ← DyRect.sy_eq_len_pow]
      unfold wt DyRect.area
      simp only [Cx, Cy]
      field_simp

end doms


end Telescoping

namespace DyRect

theorem shx_len (Q : DyRect) : (shx Q).len = Q.len := rfl

theorem shy_len (Q : DyRect) : (shy Q).len = Q.len := rfl

theorem shx_y0 (β : ℕ) (Q : DyRect) : (shx Q).y0 β = Q.y0 β := rfl

theorem shy_x0 (α : ℕ) (Q : DyRect) : (shy Q).x0 α = Q.x0 α := rfl

theorem child_len (α β : ℕ) (Q : DyRect) (i i' : ℕ) : (Q.child α β i i').len = Q.len / 2 := by
  simp only [len, child]
  rw [zpow_sub_one₀ (by norm_num)]; ring

theorem child_injective (α β : ℕ) (Q : DyRect) {i i' j j' : ℕ}
    (h : Q.child α β i i' = Q.child α β j j') : i = j ∧ i' = j' := by
  simp only [child, DyRect.mk.injEq, true_and] at h
  obtain ⟨h1, h2⟩ := h
  exact ⟨by exact_mod_cast (by linarith : (i : ℤ) = j),
    by exact_mod_cast (by linarith : (i' : ℤ) = j')⟩

theorem child_ix (α β : ℕ) (Q : DyRect) (i i' : ℕ) :
    (Q.child α β i i').ix α = Ico (Q.x0 α + i * (Q.child α β 0 0).sx α)
      (Q.x0 α + (i + 1) * (Q.child α β 0 0).sx α) := by
  have hs := child_sx α β Q 0 0
  have e : (Q.child α β i i').sx α = (Q.child α β 0 0).sx α := rfl
  simp only [ix, x0]
  rw [e, ← hs]
  simp only [child]
  push_cast
  congr 1 <;> ring

theorem child_iy (α β : ℕ) (Q : DyRect) (i i' : ℕ) :
    (Q.child α β i i').iy β = Ico (Q.y0 β + i' * (Q.child α β 0 0).sy β)
      (Q.y0 β + (i' + 1) * (Q.child α β 0 0).sy β) := by
  have hs := child_sy α β Q 0 0
  have e : (Q.child α β i i').sy β = (Q.child α β 0 0).sy β := rfl
  simp only [iy, y0]
  rw [e, ← hs]
  simp only [child]
  push_cast
  congr 1 <;> ring

theorem ix_eq_child (α β : ℕ) (Q : DyRect) :
    Q.ix α = Ico (Q.x0 α) (Q.x0 α + ((2 ^ α : ℕ) : ℝ) * (Q.child α β 0 0).sx α) := by
  rw [ix, ← child_sx α β Q 0 0]; push_cast; ring_nf

theorem iy_eq_child (α β : ℕ) (Q : DyRect) :
    Q.iy β = Ico (Q.y0 β) (Q.y0 β + ((2 ^ β : ℕ) : ℝ) * (Q.child α β 0 0).sy β) := by
  rw [iy, ← child_sy α β Q 0 0]; push_cast; ring_nf

theorem child_ix_subset (α β : ℕ) (Q : DyRect) {i i' : ℕ} (hi : i < 2 ^ α) :
    ∀ p ∈ (Q.child α β i i').ix α, p ∈ Icc (Q.x0 α) (Q.x0 α + Q.sx α) := by
  intro p hp
  rw [child_ix] at hp
  have hs := child_sx α β Q 0 0
  have hpos := (Q.child α β 0 0).sx_pos α
  have hi' : (i : ℝ) + 1 ≤ 2 ^ α := by exact_mod_cast hi
  have hi0 : (0 : ℝ) ≤ i := Nat.cast_nonneg i
  constructor
  · nlinarith [hp.1]
  · rw [← hs]; nlinarith [hp.2]

theorem child_iy_subset (α β : ℕ) (Q : DyRect) {i i' : ℕ} (hi : i' < 2 ^ β) :
    ∀ q ∈ (Q.child α β i i').iy β, q ∈ Icc (Q.y0 β) (Q.y0 β + Q.sy β) := by
  intro q hq
  rw [child_iy] at hq
  have hs := child_sy α β Q 0 0
  have hpos := (Q.child α β 0 0).sy_pos β
  have hi' : (i' : ℝ) + 1 ≤ 2 ^ β := by exact_mod_cast hi
  have hi0 : (0 : ℝ) ≤ i' := Nat.cast_nonneg i'
  constructor
  · nlinarith [hq.1]
  · rw [← hs]; nlinarith [hq.2]

end DyRect

namespace Telescoping

theorem integral_Ico_split (f : ℝ → ℝ) (a s : ℝ) (hs : 0 ≤ s) (N : ℕ)
    (hf : IntegrableOn f (Ico a (a + N * s))) :
    ∫ x in Ico a (a + N * s), f x =
      ∑ i ∈ Finset.range N, ∫ x in Ico (a + i * s) (a + (i + 1) * s), f x := by
  induction N with
  | zero => simp
  | succ N ih =>
    have h1 : a ≤ a + N * s := by have : (0 : ℝ) ≤ N * s := by positivity
                                  linarith
    have h2 : a + N * s ≤ a + ((N + 1 : ℕ) : ℝ) * s := by push_cast; nlinarith
    have hU : Ico a (a + ((N + 1 : ℕ) : ℝ) * s) =
        Ico a (a + N * s) ∪ Ico (a + N * s) (a + ((N + 1 : ℕ) : ℝ) * s) :=
      (Ico_union_Ico_eq_Ico h1 h2).symm
    rw [hU] at hf ⊢
    rw [setIntegral_union (Ico_disjoint_Ico_same) measurableSet_Ico
      (hf.mono_set subset_union_left) (hf.mono_set subset_union_right),
      ih (hf.mono_set subset_union_left), Finset.sum_range_succ]
    simp only [Nat.cast_add, Nat.cast_one]

section children

variable {α β : ℕ} {lam r : ℝ}

theorem endK_half_eq_sum (hlam : 1 ≤ lam) (Q : DyRect) (x x' y y' : ℝ) :
    endK α β lam r Q (Q.len / 2) x x' y y' =
      ∑ R ∈ Q.children α β, endK α β lam r R R.len x x' y y' := by
  have hlen : 0 < Q.len := Q.len_pos
  set s₁ := (Q.child α β 0 0).sx α
  set s₂ := (Q.child α β 0 0).sy β
  have hs₁ : 0 ≤ s₁ := ((Q.child α β 0 0).sx_pos α).le
  have hs₂ : 0 ≤ s₂ := ((Q.child α β 0 0).sy_pos β).le
  have ht : Q.len / 2 ∈ Icc (Q.len / 2) Q.len := ⟨le_rfl, by linarith⟩
  unfold DyRect.children
  rw [Finset.sum_image (fun a _ b _ h => by
    obtain ⟨h1, h2⟩ := DyRect.child_injective α β Q h
    exact Prod.ext h1 h2)]
  rw [Finset.sum_product]
  simp only [endK, DyRect.child_len, DyRect.child_ix, DyRect.child_iy]
  rw [← Finset.sum_mul_sum]
  rw [DyRect.ix_eq_child α β Q, DyRect.iy_eq_child α β Q,
    integral_Ico_split _ _ _ hs₁, integral_Ico_split _ _ _ hs₂]
  · have e : Q.y0 β + ((2 ^ β : ℕ) : ℝ) * s₂ = Q.y0 β + Q.sy β := by
      rw [← DyRect.child_sy α β Q 0 0]; push_cast; ring
    rw [e]
    exact integrableOn_Ico_of_bdd (by fun_prop) _ fun q hq => yD_le (α := α) Q ht hq y y'
  · have e : Q.x0 α + ((2 ^ α : ℕ) : ℝ) * s₁ = Q.x0 α + Q.sx α := by
      rw [← DyRect.child_sx α β Q 0 0]; push_cast; ring
    rw [e]
    exact integrableOn_Ico_of_bdd (by fun_prop) _ fun p hp => xD_le (β := β) Q hlam ht hp x x'

end children


section single

variable {α β : ℕ} {lam r : ℝ} {f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ} {M : ℝ}

theorem dom_PD (hlam : 1 ≤ lam) (Q : DyRect) {t p q : ℝ} (h : InCell α β Q t p q)
    (x x' y y' : ℝ) :
    |scalarP lam 0 α t p x x' * scalarD 1 r β t q y y'| ≤
      Kx α lam * Ky β r * wt (wx α β Q) (wy α β Q) x x' y y' := by
  rw [abs_mul]
  have h1 := xP_le (β := β) Q hlam h.1 h.2.1 x x'
  have h2 := yD_le (α := α) (r := r) Q h.1 h.2.2 y y'
  have := Kx_nonneg α lam; have := wx_nonneg α β Q x; have := wx_nonneg α β Q x'
  calc _ ≤ (Kx α lam * (wx α β Q x * wx α β Q x')) * (Ky β r * (wy α β Q y * wy α β Q y')) :=
        mul_le_mul h1 h2 (abs_nonneg _) (by positivity)
    _ = _ := by unfold wt; ring

theorem dom_DP (hlam : 1 ≤ lam) (Q : DyRect) {t p q : ℝ} (h : InCell α β Q t p q)
    (x x' y y' : ℝ) :
    |scalarD lam 0 α t p x x' * scalarP 1 r β t q y y'| ≤
      Kx α lam * Ky β r * wt (wx α β Q) (wy α β Q) x x' y y' := by
  rw [abs_mul]
  have h1 := xD_le (β := β) Q hlam h.1 h.2.1 x x'
  have h2 := yP_le (α := α) (r := r) Q h.1 h.2.2 y y'
  have := Kx_nonneg α lam; have := wx_nonneg α β Q x; have := wx_nonneg α β Q x'
  calc _ ≤ (Kx α lam * (wx α β Q x * wx α β Q x')) * (Ky β r * (wy α β Q y * wy α β Q y')) :=
        mul_le_mul h1 h2 (abs_nonneg _) (by positivity)
    _ = _ := by unfold wt; ring

theorem theta1_cell (hlam : 1 ≤ lam) (hf : Good f₁ f₂ f₃ f₄ M) (Q : DyRect) :
    cellInt α β Q (fun t p q => quadForm f₁ f₂ f₃ f₄ (scalarH lam 0 α t p)
      (scalarH lam 0 α t p) (scalarG 1 r β t q) (scalarG 1 r β t q)) =
    quadInt f₁ f₂ f₃ f₄ (fun x x' y y' => cellInt α β Q
      (fun t p q => scalarP lam 0 α t p x x' * scalarD 1 r β t q y y')) :=
  cellInt_quadInt hf (wts_Q α β Q) Q (c := Kx α lam * Ky β r)
    (fun t p q x x' y y' => scalarP lam 0 α t p x x' * scalarD 1 r β t q y y') (by fun_prop)
    fun _ _ _ h x x' y y' => dom_PD hlam Q h x x' y y'

theorem theta2_cell (hlam : 1 ≤ lam) (hf : Good f₁ f₂ f₃ f₄ M) (Q : DyRect) :
    cellInt α β Q (fun t p q => quadForm f₁ f₂ f₃ f₄ (scalarG lam 0 α t p)
      (scalarG lam 0 α t p) (scalarH 1 r β t q) (scalarH 1 r β t q)) =
    quadInt f₁ f₂ f₃ f₄ (fun x x' y y' => cellInt α β Q
      (fun t p q => scalarD lam 0 α t p x x' * scalarP 1 r β t q y y')) :=
  cellInt_quadInt hf (wts_Q α β Q) Q (c := Kx α lam * Ky β r)
    (fun t p q x x' y y' => scalarD lam 0 α t p x x' * scalarP 1 r β t q y y') (by fun_prop)
    fun _ _ _ h x x' y y' => dom_DP hlam Q h x x' y y'

theorem dom_barkXK (hlam : 1 ≤ lam) (Q : DyRect) :
    Dom (wx α β Q) (wy α β Q) ((α : ℝ) * (lam * (2 * Kx α lam)) * Ky β r * Q.area α β)
      (barkXK α β lam r Q) :=
  dom_barkX hlam Q ⟨le_rfl, by linarith [Q.sx_pos α]⟩

theorem dom_barkXK_shx (hlam : 1 ≤ lam) (Q : DyRect) :
    Dom (wx α β Q) (wy α β Q) ((α : ℝ) * (lam * (2 * Kx α lam)) * Ky β r * Q.area α β)
      (barkXK α β lam r Q.shx) := by
  have h := dom_barkX (r := r) (β := β) hlam Q (e := Q.shx.x0 α)
    ⟨by rw [DyRect.shx_x0]; linarith [Q.sx_pos α], by rw [DyRect.shx_x0]⟩
  exact h

theorem dom_barkYK (hlam : 1 ≤ lam) (Q : DyRect) :
    Dom (wx α β Q) (wy α β Q) ((β : ℝ) * ((1 + |r|) * (2 * Ky β r)) * Kx α lam * Q.area α β)
      (barkYK α β lam r Q) :=
  dom_barkY hlam Q ⟨le_rfl, by linarith [Q.sy_pos β]⟩

theorem dom_barkYK_shy (hlam : 1 ≤ lam) (Q : DyRect) :
    Dom (wx α β Q) (wy α β Q) ((β : ℝ) * ((1 + |r|) * (2 * Ky β r)) * Kx α lam * Q.area α β)
      (barkYK α β lam r Q.shy) := by
  have h := dom_barkY (r := r) (α := α) hlam Q (e := Q.shy.y0 β)
    ⟨by rw [DyRect.shy_y0]; linarith [Q.sy_pos β], by rw [DyRect.shy_y0]⟩
  exact h

theorem dom_endK_self (hlam : 1 ≤ lam) (Q : DyRect) {s : ℝ}
    (hs : s ∈ Icc (Q.len / 2) Q.len) :
    Dom (wx α β Q) (wy α β Q) (Kx α lam * Ky β r * Q.area α β) (endK α β lam r Q s) :=
  dom_endK hlam Q Q hs (fun p hp => by unfold DyRect.ix at hp; exact Ico_subset_Icc_self hp)
    (fun q hq => by unfold DyRect.iy at hq; exact Ico_subset_Icc_self hq)

theorem dom_endK_child (hlam : 1 ≤ lam) (Q : DyRect) {R : DyRect} (hR : R ∈ Q.children α β) :
    Dom (wx α β Q) (wy α β Q) (Kx α lam * Ky β r * R.area α β) (endK α β lam r R R.len) := by
  obtain ⟨i, hi, i', hi', rfl⟩ := (DyRect.mem_children α β Q R).1 hR
  have hl : (Q.child α β i i').len = Q.len / 2 := DyRect.child_len α β Q i i'
  refine dom_endK hlam Q _ ?_ (DyRect.child_ix_subset α β Q hi) (DyRect.child_iy_subset α β Q hi')
  rw [hl]; exact ⟨le_rfl, by linarith [Q.len_pos]⟩

/-- The single-rectangle telescoping identity (`T = {Q}`), integrated against the inputs. -/
theorem single_identity (hlam : 1 ≤ lam) (hf : Good f₁ f₂ f₃ f₄ M) (Q : DyRect) :
    (α : ℝ) * cellInt α β Q (fun t p q => quadForm f₁ f₂ f₃ f₄ (scalarH lam 0 α t p)
      (scalarH lam 0 α t p) (scalarG 1 r β t q) (scalarG 1 r β t q)) +
    (β : ℝ) * cellInt α β Q (fun t p q => quadForm f₁ f₂ f₃ f₄ (scalarG lam 0 α t p)
      (scalarG lam 0 α t p) (scalarH 1 r β t q) (scalarH 1 r β t q)) =
    Real.pi * (quadInt f₁ f₂ f₃ f₄ (endK α β lam r Q (Q.len / 2)) -
        quadInt f₁ f₂ f₃ f₄ (endK α β lam r Q Q.len)) -
      Real.pi * ((quadInt f₁ f₂ f₃ f₄ (barkXK α β lam r Q.shx) -
          quadInt f₁ f₂ f₃ f₄ (barkXK α β lam r Q)) +
        (quadInt f₁ f₂ f₃ f₄ (barkYK α β lam r Q.shy) -
          quadInt f₁ f₂ f₃ f₄ (barkYK α β lam r Q))) := by
  have hw := wts_Q α β Q
  have hlen := Q.len_pos
  rw [theta1_cell hlam hf Q, theta2_cell hlam hf Q]
  have hk1 := dom_cellInt (α := α) (β := β) Q (c := Kx α lam * Ky β r)
    (fun t p q x x' y y' => scalarP lam 0 α t p x x' * scalarD 1 r β t q y y') (by fun_prop)
    fun _ _ _ h x x' y y' => dom_PD hlam Q h x x' y y'
  have hk2 := dom_cellInt (α := α) (β := β) Q (c := Kx α lam * Ky β r)
    (fun t p q x x' y y' => scalarD lam 0 α t p x x' * scalarP 1 r β t q y y') (by fun_prop)
    fun _ _ _ h x x' y y' => dom_DP hlam Q h x x' y y'
  have dH := dom_endK_self (r := r) (α := α) (β := β) hlam Q
    (s := Q.len / 2) ⟨le_rfl, by linarith⟩
  have dF := dom_endK_self (r := r) (α := α) (β := β) hlam Q (s := Q.len) ⟨by linarith, le_rfl⟩
  have dX := dom_barkXK (r := r) (α := α) (β := β) hlam Q
  have dXs := dom_barkXK_shx (r := r) (α := α) (β := β) hlam Q
  have dY := dom_barkYK (r := r) (α := α) (β := β) hlam Q
  have dYs := dom_barkYK_shy (r := r) (α := α) (β := β) hlam Q
  have pw : ∀ x x' y y',
      (α : ℝ) * cellInt α β Q (fun t p q => scalarP lam 0 α t p x x' * scalarD 1 r β t q y y') +
      (β : ℝ) * cellInt α β Q (fun t p q => scalarD lam 0 α t p x x' * scalarP 1 r β t q y y') =
      Real.pi * (endK α β lam r Q (Q.len / 2) x x' y y' - endK α β lam r Q Q.len x x' y y') -
        Real.pi * ((barkXK α β lam r Q.shx x x' y y' - barkXK α β lam r Q x x' y y') +
          (barkYK α β lam r Q.shy x x' y y' - barkYK α β lam r Q x x' y y')) := by
    intro x x' y y'
    have h := cell_identity (mu1 := lam) (sig1 := 0) (mu2 := 1) (sig2 := r) (n1 := α)
      (n2 := β) hlam le_rfl hlen (Q.x0 α) (Q.y0 β) x x' y y'
    simp only [cellInt, endK, barkXK, barkYK, DyRect.shx_len, DyRect.shx_y0, DyRect.shy_len,
      DyRect.shy_x0, DyRect.shx_x0, DyRect.shy_y0, DyRect.ix_eq, DyRect.iy_eq,
      DyRect.sx_eq_len_pow, DyRect.sy_eq_len_pow]
    linarith [h]
  calc _ = quadInt f₁ f₂ f₃ f₄ (fun x x' y y' =>
        (α : ℝ) * cellInt α β Q (fun t p q => scalarP lam 0 α t p x x' * scalarD 1 r β t q y y') +
        (β : ℝ) * cellInt α β Q (fun t p q => scalarD lam 0 α t p x x' *
          scalarP 1 r β t q y y')) := by
        rw [quadInt_add hf hw (hk1.const_mul _) (hk2.const_mul _), quadInt_const_mul,
          quadInt_const_mul]
    _ = quadInt f₁ f₂ f₃ f₄ (fun x x' y y' =>
        Real.pi * (endK α β lam r Q (Q.len / 2) x x' y y' - endK α β lam r Q Q.len x x' y y') -
        Real.pi * ((barkXK α β lam r Q.shx x x' y y' - barkXK α β lam r Q x x' y y') +
          (barkYK α β lam r Q.shy x x' y y' - barkYK α β lam r Q x x' y y'))) := by
        congr 1; funext x x' y y'; exact pw x x' y y'
    _ = _ := by
        rw [quadInt_sub hf hw ((dH.sub dF).const_mul _)
          (((dXs.sub dX).add (dYs.sub dY)).const_mul _), quadInt_const_mul, quadInt_const_mul,
          quadInt_sub hf hw dH dF, quadInt_add hf hw (dXs.sub dX) (dYs.sub dY),
          quadInt_sub hf hw dXs dX, quadInt_sub hf hw dYs dY]

theorem quadInt_endK_half (hlam : 1 ≤ lam) (hf : Good f₁ f₂ f₃ f₄ M) (Q : DyRect) :
    quadInt f₁ f₂ f₃ f₄ (endK α β lam r Q (Q.len / 2)) =
      ∑ R ∈ Q.children α β, quadInt f₁ f₂ f₃ f₄ (endK α β lam r R R.len) := by
  rw [← quadInt_finset_sum hf (wts_Q α β Q) (Q.children α β)
    (fun R hR => dom_endK_child (r := r) hlam Q hR)]
  congr 1; funext x x' y y'
  exact endK_half_eq_sum hlam Q x x' y y'

/-- The rectangle integrals of `Ξ` as four-function forms. -/
theorem xi_summand_eq (hlam : 1 ≤ lam) (hf : Good f₁ f₂ f₃ f₄ M) (Q : DyRect) :
    ∫ p in Q.ix α, ∫ q in Q.iy β, quadForm f₁ f₂ f₃ f₄ (scalarG lam 0 α Q.len p)
      (scalarG lam 0 α Q.len p) (scalarG 1 r β Q.len q) (scalarG 1 r β Q.len q) =
    quadInt f₁ f₂ f₃ f₄ (endK α β lam r Q Q.len) := by
  have ht : Q.len ∈ Icc (Q.len / 2) Q.len := ⟨by linarith [Q.len_pos], le_rfl⟩
  have h := rectInt_quadInt hf (wts_Q α β Q) (α := α) (β := β) Q (c := Kx α lam * Ky β r)
    (fun p q x x' y y' => scalarD lam 0 α Q.len p x x' * scalarD 1 r β Q.len q y y')
    (by fun_prop) fun p q hp hq x x' y y' => by
      rw [abs_mul]
      have h1 := xD_le (β := β) Q hlam ht hp x x'
      have h2 := yD_le (α := α) (r := r) Q ht hq y y'
      have := Kx_nonneg α lam; have := wx_nonneg α β Q x; have := wx_nonneg α β Q x'
      calc _ ≤ (Kx α lam * (wx α β Q x * wx α β Q x')) *
            (Ky β r * (wy α β Q y * wy α β Q y')) :=
            mul_le_mul h1 h2 (abs_nonneg _) (by positivity)
        _ = _ := by unfold wt; ring
  refine h.trans ?_
  congr 1; funext x x' y y'
  exact sep_mul _ _ _ _

end single

end Telescoping

open Telescoping

/-! ### The telescoping identity for a convex tree -/

/-- The bark form `𝓑_{𝒬,λ,r}`: the boundary terms of the cells of `𝒬`, from the
integrations by parts in `p` and `q`. -/
def barkForm (α β : ℕ) (𝒬 : Finset DyRect) (lam r : ℝ) (f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ) : ℝ :=
  ∑ Q ∈ 𝒬, ((quadInt f₁ f₂ f₃ f₄ (barkXK α β lam r Q.shx) -
      quadInt f₁ f₂ f₃ f₄ (barkXK α β lam r Q)) +
    (quadInt f₁ f₂ f₃ f₄ (barkYK α β lam r Q.shy) - quadInt f₁ f₂ f₃ f₄ (barkYK α β lam r Q)))

/-- `lemma:telescoping` (the identity `eqn:telescoping`): for a convex tree `𝒯`, `λ ≥ 1` and
bounded measurable inputs,
`α Θ^{(1)}_𝒯 + β Θ^{(2)}_𝒯 = Ξ_{𝓛(𝒯)} - Ξ_{{Q_𝒯}} - π 𝓑_𝒯`. -/
theorem telescoping_identity {α β : ℕ} (T : DyTree α β) {lam : ℝ} (r : ℝ) (hlam : 1 ≤ lam)
    {f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ} {M : ℝ} (hf : Good f₁ f₂ f₃ f₄ M) :
    (α : ℝ) * theta1 α β T.rects lam r f₁ f₂ f₃ f₄ +
        (β : ℝ) * theta2 α β T.rects lam r f₁ f₂ f₃ f₄ =
      xiForm α β T.leaves lam r f₁ f₂ f₃ f₄ - xiForm α β {T.root} lam r f₁ f₂ f₃ f₄ -
        Real.pi * barkForm α β T.rects lam r f₁ f₂ f₃ f₄ := by
  unfold theta1 theta2 collInt xiForm barkForm
  rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
  simp_rw [single_identity hlam hf, quadInt_endK_half hlam hf, xi_summand_eq hlam hf]
  rw [Finset.sum_sub_distrib, ← Finset.mul_sum, ← Finset.mul_sum, DyTree.sum_children_sub,
    Finset.sum_singleton]
  ring


namespace Telescoping

/-! ### Counting the boundary faces of a convex tree (`eqn:treecountingest`) -/

end Telescoping

namespace DyRect

/-- The left neighbour `Q - e₁`. -/
def shxm (Q : DyRect) : DyRect := ⟨Q.lev, Q.m - 1, Q.n⟩

/-- The lower neighbour `Q - e₂`. -/
def shym (Q : DyRect) : DyRect := ⟨Q.lev, Q.m, Q.n - 1⟩

theorem shxm_shx (Q : DyRect) : shxm (shx Q) = Q := by ext <;> simp [shxm, shx]

theorem shx_shxm (Q : DyRect) : shx (shxm Q) = Q := by ext <;> simp [shxm, shx]

theorem shym_shy (Q : DyRect) : shym (shy Q) = Q := by ext <;> simp [shym, shy]

theorem shy_shym (Q : DyRect) : shy (shym Q) = Q := by ext <;> simp [shym, shy]

theorem area_shx (α β : ℕ) (Q : DyRect) : (shx Q).area α β = Q.area α β := rfl

theorem area_shxm (α β : ℕ) (Q : DyRect) : (shxm Q).area α β = Q.area α β := rfl

theorem area_shy (α β : ℕ) (Q : DyRect) : (shy Q).area α β = Q.area α β := rfl

theorem area_shym (α β : ℕ) (Q : DyRect) : (shym Q).area α β = Q.area α β := rfl

theorem shx_injective : Function.Injective shx := fun a b h => by
  rw [← shxm_shx a, h, shxm_shx]

theorem shxm_injective : Function.Injective shxm := fun a b h => by
  rw [← shx_shxm a, h, shx_shxm]

theorem shy_injective : Function.Injective shy := fun a b h => by
  rw [← shym_shy a, h, shym_shy]

theorem shym_injective : Function.Injective shym := fun a b h => by
  rw [← shy_shym a, h, shy_shym]

theorem child_area_eq (α β : ℕ) (Q : DyRect) (i i' : ℕ) :
    (Q.child α β i i').area α β = Q.area α β / (2 ^ α * 2 ^ β) := by
  rw [← child_area α β Q i i']; field_simp

/-- Every rectangle is the child of its parent with digits `(m mod 2^α, n mod 2^β)`. -/
theorem eq_child_parent (α β : ℕ) (Q : DyRect) :
    Q = (parent α β Q).child α β (Q.m % 2 ^ α).toNat (Q.n % 2 ^ β).toNat := by
  have h1 : (0 : ℤ) < 2 ^ α := by positivity
  have h2 : (0 : ℤ) < 2 ^ β := by positivity
  have h0 := Int.emod_nonneg Q.m h1.ne'
  have h0' := Int.emod_nonneg Q.n h2.ne'
  ext
  · simp [child, parent]
  · simp only [child, parent]
    rw [Int.toNat_of_nonneg h0]
    exact (Int.mul_ediv_add_emod Q.m (2 ^ α)).symm
  · simp only [child, parent]
    rw [Int.toNat_of_nonneg h0']
    exact (Int.mul_ediv_add_emod Q.n (2 ^ β)).symm

end DyRect

namespace Telescoping

theorem ediv_succ_of_ne {m N : ℤ} (hN : 0 < N) (h : (m + 1) / N ≠ m / N) :
    (m + 1) / N = m / N + 1 ∧ m % N = N - 1 := by
  have e := Int.mul_ediv_add_emod m N
  have h0 := Int.emod_nonneg m hN.ne'
  have h1 := Int.emod_lt_of_pos m hN
  by_cases hc : m % N + 1 < N
  · exfalso; apply h
    exact ((Int.ediv_emod_unique hN).2 ⟨by linarith, by linarith, hc⟩).1
  · have hr : m % N = N - 1 := by omega
    refine ⟨((Int.ediv_emod_unique hN).2 ⟨?_, le_rfl, hN⟩).1, hr⟩
    rw [hr] at e; linarith

theorem ediv_pred_of_ne {m N : ℤ} (hN : 0 < N) (h : (m - 1) / N ≠ m / N) :
    (m - 1) / N = m / N - 1 ∧ m % N = 0 := by
  have e := Int.mul_ediv_add_emod m N
  have h0 := Int.emod_nonneg m hN.ne'
  have h1 := Int.emod_lt_of_pos m hN
  by_cases hc : 1 ≤ m % N
  · exfalso; apply h
    exact ((Int.ediv_emod_unique (r := m % N - 1) hN).2
      ⟨by linarith, by linarith, by linarith⟩).1
  · have hr : m % N = 0 := by omega
    refine ⟨((Int.ediv_emod_unique (r := N - 1) hN).2 ⟨?_, by linarith, by linarith⟩).1, hr⟩
    rw [hr] at e; linarith

section counting

variable {α β : ℕ}

theorem sum_leaves_area (T : DyTree α β) :
    ∑ L ∈ T.leaves, L.area α β = T.root.area α β := by
  have h := T.sum_children_sub (fun R => R.area α β)
  have hc : ∀ Q ∈ T.rects, ∑ R ∈ Q.children α β, R.area α β - Q.area α β = 0 := by
    intro Q _
    unfold DyRect.children
    rw [Finset.sum_image (fun a _ b _ h => by
      obtain ⟨h1, h2⟩ := DyRect.child_injective α β Q h
      exact Prod.ext h1 h2)]
    simp only [DyRect.child_area_eq, Finset.sum_const, Finset.card_product, Finset.card_range,
      nsmul_eq_mul]
    push_cast
    field_simp
    ring
  rw [Finset.sum_congr rfl hc, Finset.sum_const_zero] at h
  linarith

/-- The abstract counting argument: a shift `sh` whose parents either agree or are the shifts of
the parents along an edge family `E` of total relative area `≤ c < 1`. -/
theorem sum_area_boundary_le (T : DyTree α β) (sh : DyRect → DyRect)
    (hinj : Function.Injective sh) (harea : ∀ Q, (sh Q).area α β = Q.area α β)
    (E : DyRect → Finset DyRect) {c : ℝ}
    (hE : ∀ P, ∑ Q ∈ E P, Q.area α β ≤ c * P.area α β)
    (hpar : ∀ Q, DyRect.parent α β (sh Q) ≠ DyRect.parent α β Q →
      DyRect.parent α β (sh Q) = sh (DyRect.parent α β Q) ∧ Q ∈ E (DyRect.parent α β Q)) :
    (1 - c) * ∑ Q ∈ T.rects.filter (fun Q => sh Q ∉ T.rects), Q.area α β ≤
      2 * T.root.area α β := by
  classical
  set S := T.rects.filter (fun Q => sh Q ∉ T.rects) with hS
  set X := ∑ Q ∈ S, Q.area α β with hX
  have hapos : ∀ Q : DyRect, 0 ≤ Q.area α β := fun Q => (Q.area_pos α β).le
  set S₁ := S.filter (fun Q => DyRect.parent α β (sh Q) ∈ T.rects)
  set S₂ := S.filter (fun Q => DyRect.parent α β (sh Q) ∉ T.rects)
  set S₃ := S₂.filter (fun Q => Q = T.root)
  set S₄ := S₂.filter (fun Q => Q ≠ T.root)
  have hsplit : X = ∑ Q ∈ S₁, Q.area α β + (∑ Q ∈ S₃, Q.area α β + ∑ Q ∈ S₄, Q.area α β) := by
    rw [hX, ← Finset.sum_filter_add_sum_filter_not S
      (fun Q => DyRect.parent α β (sh Q) ∈ T.rects),
      ← Finset.sum_filter_add_sum_filter_not S₂ (fun Q => Q = T.root)]
  -- the first part: shifts are leaves
  have h1 : ∑ Q ∈ S₁, Q.area α β ≤ T.root.area α β := by
    rw [← sum_leaves_area T]
    calc ∑ Q ∈ S₁, Q.area α β = ∑ Q ∈ S₁.image sh, Q.area α β := by
          rw [Finset.sum_image (fun a _ b _ h => hinj h)]
          exact Finset.sum_congr rfl fun Q _ => (harea Q).symm
      _ ≤ _ := by
          refine Finset.sum_le_sum_of_subset_of_nonneg ?_ fun Q _ _ => hapos Q
          intro R hR
          obtain ⟨Q, hQ, rfl⟩ := Finset.mem_image.1 hR
          simp only [S₁, hS, Finset.mem_filter] at hQ
          simp only [DyTree.leaves, Finset.mem_filter, Finset.mem_biUnion]
          exact ⟨⟨_, hQ.2, DyRect.mem_children_parent α β (sh Q)⟩, hQ.1.2⟩
  -- the root
  have h3 : ∑ Q ∈ S₃, Q.area α β ≤ T.root.area α β := by
    calc _ ≤ ∑ Q ∈ ({T.root} : Finset DyRect), Q.area α β := by
          refine Finset.sum_le_sum_of_subset_of_nonneg ?_ fun Q _ _ => hapos Q
          intro Q hQ
          simp only [S₃, Finset.mem_filter] at hQ
          rw [Finset.mem_singleton]; exact hQ.2
      _ = _ := Finset.sum_singleton _ _
  -- the remaining part: edge children of boundary rectangles
  have h4 : ∑ Q ∈ S₄, Q.area α β ≤ c * X := by
    have hmaps : ∀ Q ∈ S₄, DyRect.parent α β Q ∈ S := by
      intro Q hQ
      simp only [S₄, S₂, hS, Finset.mem_filter] at hQ
      obtain ⟨⟨⟨hQT, _⟩, hpQ⟩, hne⟩ := hQ
      have hP := T.parent_mem hQT hne
      have hneq : DyRect.parent α β (sh Q) ≠ DyRect.parent α β Q := fun h => hpQ (h ▸ hP)
      obtain ⟨he, _⟩ := hpar Q hneq
      simp only [hS, Finset.mem_filter]
      exact ⟨hP, he ▸ hpQ⟩
    rw [← Finset.sum_fiberwise_of_maps_to hmaps, hX, Finset.mul_sum]
    refine Finset.sum_le_sum fun P _ => ?_
    refine le_trans ?_ (hE P)
    refine Finset.sum_le_sum_of_subset_of_nonneg ?_ fun Q _ _ => hapos Q
    intro Q hQ
    simp only [S₄, S₂, hS, Finset.mem_filter] at hQ
    obtain ⟨⟨⟨⟨hQT, _⟩, hpQ⟩, hne⟩, rfl⟩ := hQ
    have hP := T.parent_mem hQT hne
    have hneq : DyRect.parent α β (sh Q) ≠ DyRect.parent α β Q := fun h => hpQ (h ▸ hP)
    exact (hpar Q hneq).2
  have := hsplit
  nlinarith

/-- The edge children `{child(P, i, i') : i' < 2^β}` for a fixed first digit `i`. -/
def edgeX (α β : ℕ) (i : ℕ) (P : DyRect) : Finset DyRect :=
  (Finset.range (2 ^ β)).image fun i' => P.child α β i i'

/-- The edge children `{child(P, i, i') : i < 2^α}` for a fixed second digit `i'`. -/
def edgeY (α β : ℕ) (i' : ℕ) (P : DyRect) : Finset DyRect :=
  (Finset.range (2 ^ α)).image fun i => P.child α β i i'

theorem sum_edgeX (hα : 0 < α) (i : ℕ) (P : DyRect) :
    ∑ Q ∈ edgeX α β i P, Q.area α β ≤ (1 / 2) * P.area α β := by
  unfold edgeX
  rw [Finset.sum_image (fun a _ b _ h => (DyRect.child_injective α β P h).2)]
  simp only [DyRect.child_area_eq, Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  have h2 : (2 : ℝ) ≤ 2 ^ α := by
    calc (2 : ℝ) = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ α := pow_le_pow_right₀ (by norm_num) hα
  have hA := P.area_pos α β
  push_cast
  rw [mul_div_assoc', div_le_iff₀ (by positivity)]
  have : (0 : ℝ) < 2 ^ β := by positivity
  have := mul_le_mul_of_nonneg_left h2 (mul_pos this hA).le
  linarith

theorem sum_edgeY (hβ : 0 < β) (i' : ℕ) (P : DyRect) :
    ∑ Q ∈ edgeY α β i' P, Q.area α β ≤ (1 / 2) * P.area α β := by
  unfold edgeY
  rw [Finset.sum_image (fun a _ b _ h => (DyRect.child_injective α β P h).1)]
  simp only [DyRect.child_area_eq, Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  have h2 : (2 : ℝ) ≤ 2 ^ β := by
    calc (2 : ℝ) = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ β := pow_le_pow_right₀ (by norm_num) hβ
  have hA := P.area_pos α β
  push_cast
  rw [mul_div_assoc', div_le_iff₀ (by positivity)]
  have : (0 : ℝ) < 2 ^ α := by positivity
  have := mul_le_mul_of_nonneg_left h2 (mul_pos this hA).le
  linarith

theorem two_pow_sub_one_cast (k : ℕ) : (((2 ^ k - 1 : ℕ)) : ℤ) = 2 ^ k - 1 := by
  have : 1 ≤ 2 ^ k := Nat.one_le_two_pow
  push_cast [this]; ring

theorem count_shx (hα : 0 < α) (T : DyTree α β) :
    ∑ Q ∈ T.rects.filter (fun Q => Q.shx ∉ T.rects), Q.area α β ≤ 4 * T.root.area α β := by
  have h := sum_area_boundary_le T DyRect.shx DyRect.shx_injective (DyRect.area_shx α β)
    (edgeX α β (2 ^ α - 1)) (sum_edgeX hα _) fun Q hQ => by
      have hN : (0 : ℤ) < 2 ^ α := by positivity
      have hne : (Q.m + 1) / 2 ^ α ≠ Q.m / 2 ^ α := fun h => hQ (by
        simp only [DyRect.parent, DyRect.shx, h])
      obtain ⟨e1, e2⟩ := ediv_succ_of_ne hN hne
      refine ⟨by simp only [DyRect.parent, DyRect.shx, e1], ?_⟩
      unfold edgeX
      rw [Finset.mem_image]
      refine ⟨(Q.n % 2 ^ β).toNat, ?_, ?_⟩
      · have h0 := Int.emod_nonneg Q.n (by positivity : (2 : ℤ) ^ β ≠ 0)
        have := Int.emod_lt_of_pos Q.n (by positivity : (0 : ℤ) < 2 ^ β)
        rw [Finset.mem_range]
        exact (Int.toNat_lt h0).2 (by exact_mod_cast this)
      · conv_rhs => rw [DyRect.eq_child_parent α β Q]
        congr 1
        rw [e2, ← two_pow_sub_one_cast, Int.toNat_natCast]
  linarith

theorem count_shxm (hα : 0 < α) (T : DyTree α β) :
    ∑ Q ∈ T.rects.filter (fun Q => Q.shxm ∉ T.rects), Q.area α β ≤ 4 * T.root.area α β := by
  have h := sum_area_boundary_le T DyRect.shxm DyRect.shxm_injective (DyRect.area_shxm α β)
    (edgeX α β 0) (sum_edgeX hα _) fun Q hQ => by
      have hN : (0 : ℤ) < 2 ^ α := by positivity
      have hne : (Q.m - 1) / 2 ^ α ≠ Q.m / 2 ^ α := fun h => hQ (by
        simp only [DyRect.parent, DyRect.shxm, h])
      obtain ⟨e1, e2⟩ := ediv_pred_of_ne hN hne
      refine ⟨by simp only [DyRect.parent, DyRect.shxm, e1], ?_⟩
      unfold edgeX
      rw [Finset.mem_image]
      refine ⟨(Q.n % 2 ^ β).toNat, ?_, ?_⟩
      · have h0 := Int.emod_nonneg Q.n (by positivity : (2 : ℤ) ^ β ≠ 0)
        have := Int.emod_lt_of_pos Q.n (by positivity : (0 : ℤ) < 2 ^ β)
        rw [Finset.mem_range]
        exact (Int.toNat_lt h0).2 (by exact_mod_cast this)
      · conv_rhs => rw [DyRect.eq_child_parent α β Q]
        congr 1
        rw [e2]
        simp
  linarith

theorem count_shy (hβ : 0 < β) (T : DyTree α β) :
    ∑ Q ∈ T.rects.filter (fun Q => Q.shy ∉ T.rects), Q.area α β ≤ 4 * T.root.area α β := by
  have h := sum_area_boundary_le T DyRect.shy DyRect.shy_injective (DyRect.area_shy α β)
    (edgeY α β (2 ^ β - 1)) (sum_edgeY hβ _) fun Q hQ => by
      have hN : (0 : ℤ) < 2 ^ β := by positivity
      have hne : (Q.n + 1) / 2 ^ β ≠ Q.n / 2 ^ β := fun h => hQ (by
        simp only [DyRect.parent, DyRect.shy, h])
      obtain ⟨e1, e2⟩ := ediv_succ_of_ne hN hne
      refine ⟨by simp only [DyRect.parent, DyRect.shy, e1], ?_⟩
      unfold edgeY
      rw [Finset.mem_image]
      refine ⟨(Q.m % 2 ^ α).toNat, ?_, ?_⟩
      · have h0 := Int.emod_nonneg Q.m (by positivity : (2 : ℤ) ^ α ≠ 0)
        have := Int.emod_lt_of_pos Q.m (by positivity : (0 : ℤ) < 2 ^ α)
        rw [Finset.mem_range]
        exact (Int.toNat_lt h0).2 (by exact_mod_cast this)
      · conv_rhs => rw [DyRect.eq_child_parent α β Q]
        congr 1
        rw [e2, ← two_pow_sub_one_cast, Int.toNat_natCast]
  linarith

theorem count_shym (hβ : 0 < β) (T : DyTree α β) :
    ∑ Q ∈ T.rects.filter (fun Q => Q.shym ∉ T.rects), Q.area α β ≤ 4 * T.root.area α β := by
  have h := sum_area_boundary_le T DyRect.shym DyRect.shym_injective (DyRect.area_shym α β)
    (edgeY α β 0) (sum_edgeY hβ _) fun Q hQ => by
      have hN : (0 : ℤ) < 2 ^ β := by positivity
      have hne : (Q.n - 1) / 2 ^ β ≠ Q.n / 2 ^ β := fun h => hQ (by
        simp only [DyRect.parent, DyRect.shym, h])
      obtain ⟨e1, e2⟩ := ediv_pred_of_ne hN hne
      refine ⟨by simp only [DyRect.parent, DyRect.shym, e1], ?_⟩
      unfold edgeY
      rw [Finset.mem_image]
      refine ⟨(Q.m % 2 ^ α).toNat, ?_, ?_⟩
      · have h0 := Int.emod_nonneg Q.m (by positivity : (2 : ℤ) ^ α ≠ 0)
        have := Int.emod_lt_of_pos Q.m (by positivity : (0 : ℤ) < 2 ^ α)
        rw [Finset.mem_range]
        exact (Int.toNat_lt h0).2 (by exact_mod_cast this)
      · conv_rhs => rw [DyRect.eq_child_parent α β Q]
        congr 1
        rw [e2]
        simp
  linarith

end counting


/-! ### The bounds -/

theorem sum_shift_sub {s : Finset DyRect} (sh shm : DyRect → DyRect)
    (h1 : ∀ Q, shm (sh Q) = Q) (h2 : ∀ Q, sh (shm Q) = Q) (Y : DyRect → ℝ) :
    ∑ Q ∈ s, (Y (sh Q) - Y Q) =
      ∑ Q ∈ s.filter (fun Q => sh Q ∉ s), Y (sh Q) - ∑ Q ∈ s.filter (fun Q => shm Q ∉ s), Y Q := by
  classical
  rw [Finset.sum_sub_distrib, ← Finset.sum_filter_add_sum_filter_not s (fun Q => sh Q ∈ s),
    ← Finset.sum_filter_add_sum_filter_not s (fun Q => shm Q ∈ s) Y]
  have e : ∑ Q ∈ s.filter (fun Q => sh Q ∈ s), Y (sh Q) =
      ∑ Q ∈ s.filter (fun Q => shm Q ∈ s), Y Q := by
    refine Finset.sum_nbij' sh shm ?_ ?_ (fun Q _ => h1 Q) (fun Q _ => h2 Q) (fun Q _ => rfl)
    · intro Q hQ
      simp only [Finset.mem_filter] at hQ ⊢
      exact ⟨hQ.2, by rw [h1]; exact hQ.1⟩
    · intro Q hQ
      simp only [Finset.mem_filter] at hQ ⊢
      exact ⟨hQ.2, by rw [h2]; exact hQ.1⟩
  rw [e]
  ring

theorem abs_sum_shift_sub_le {s : Finset DyRect} (sh shm : DyRect → DyRect)
    (h1 : ∀ Q, shm (sh Q) = Q) (h2 : ∀ Q, sh (shm Q) = Q) (Y : DyRect → ℝ) (a : DyRect → ℝ)
    (hY : ∀ Q ∈ s, |Y (sh Q)| ≤ a Q ∧ |Y Q| ≤ a Q) :
    |∑ Q ∈ s, (Y (sh Q) - Y Q)| ≤
      ∑ Q ∈ s.filter (fun Q => sh Q ∉ s), a Q + ∑ Q ∈ s.filter (fun Q => shm Q ∉ s), a Q := by
  rw [sum_shift_sub sh shm h1 h2]
  refine (abs_sub _ _).trans (add_le_add ?_ ?_)
  · refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun Q hQ => ?_)
    exact (hY Q (Finset.mem_filter.1 hQ).1).1
  · refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun Q hQ => ?_)
    exact (hY Q (Finset.mem_filter.1 hQ).1).2

section bound

variable {α β : ℕ} {lam r : ℝ} {f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ} {M : ℝ}

/-- `lem:bdbymax` combined with `𝓜_𝒬 ≥ (|f|^2 * (θ ⊗ θ)(c(Q)))^{1/2}`. -/
theorem abs_quadInt_le_Msize (hf : Good f₁ f₂ f₃ f₄ M) {𝒬 : Finset DyRect} {Q : DyRect}
    (hQ : Q ∈ 𝒬) {c : ℝ} {k : ℝ → ℝ → ℝ → ℝ → ℝ} (hk : Dom (wx α β Q) (wy α β Q) c k) :
    |quadInt f₁ f₂ f₃ f₄ k| ≤
      c * (Msize α β 𝒬 f₁ * Msize α β 𝒬 f₂ * Msize α β 𝒬 f₃ * Msize α β 𝒬 f₄) := by
  have h := bdbymax hf (Q.sx_pos α) (Q.sy_pos β) hk
  have hc : 0 ≤ c := by
    have h0 := (abs_nonneg _).trans (hk.2 0 0 0 0)
    have hw : 0 < wt (wx α β Q) (wy α β Q) 0 0 0 0 := by
      unfold wt wx wy
      have := Auto.Twisted.bracketKernelAt_pos (a := (Q.center α β).1) (x := 0) (Q.sx_pos α)
      have := Auto.Twisted.bracketKernelAt_pos (a := (Q.center α β).2) (x := 0) (Q.sy_pos β)
      positivity
    exact nonneg_of_mul_nonneg_left h0 hw
  refine h.trans (mul_le_mul_of_nonneg_left ?_ hc)
  rw [← sizeQ_eq, ← sizeQ_eq, ← sizeQ_eq, ← sizeQ_eq]
  have n1 := sizeQ_nonneg α β f₁ Q; have n2 := sizeQ_nonneg α β f₂ Q
  have n3 := sizeQ_nonneg α β f₃ Q; have n4 := sizeQ_nonneg α β f₄ Q
  have s1 := sizeQ_le_Msize α β f₁ hQ; have s2 := sizeQ_le_Msize α β f₂ hQ
  have s3 := sizeQ_le_Msize α β f₃ hQ; have s4 := sizeQ_le_Msize α β f₄ hQ
  have e12 := mul_le_mul s1 s2 n2 (n1.trans s1)
  have e123 := mul_le_mul e12 s3 n3 (mul_nonneg (n1.trans s1) (n2.trans s2))
  exact mul_le_mul e123 s4 n4 (mul_nonneg (mul_nonneg (n1.trans s1) (n2.trans s2)) (n3.trans s3))

theorem abs_xiForm_leaves_le (hlam : 1 ≤ lam) (hf : Good f₁ f₂ f₃ f₄ M) (T : DyTree α β) :
    |xiForm α β T.leaves lam r f₁ f₂ f₃ f₄| ≤ Real.pi * (Kx α lam * Ky β r) *
      T.root.area α β * (Msize α β T.rects f₁ * Msize α β T.rects f₂ * Msize α β T.rects f₃ *
        Msize α β T.rects f₄) := by
  unfold xiForm
  simp_rw [xi_summand_eq hlam hf]
  rw [abs_mul, abs_of_pos Real.pi_pos]
  set PP := Msize α β T.rects f₁ * Msize α β T.rects f₂ * Msize α β T.rects f₃ *
    Msize α β T.rects f₄
  have key : |∑ L ∈ T.leaves, quadInt f₁ f₂ f₃ f₄ (endK α β lam r L L.len)| ≤
      ∑ L ∈ T.leaves, Kx α lam * Ky β r * L.area α β * PP := by
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun L hL => ?_)
    have hL' := hL
    simp only [DyTree.leaves, Finset.mem_filter, Finset.mem_biUnion] at hL'
    obtain ⟨⟨P, hP, hLP⟩, _⟩ := hL'
    exact abs_quadInt_le_Msize hf hP (dom_endK_child (r := r) hlam P hLP)
  have e : ∑ L ∈ T.leaves, Kx α lam * Ky β r * L.area α β * PP =
      Kx α lam * Ky β r * T.root.area α β * PP := by
    rw [← Finset.sum_mul, ← Finset.mul_sum, sum_leaves_area]
  rw [e] at key
  calc _ ≤ Real.pi * (Kx α lam * Ky β r * T.root.area α β * PP) :=
        mul_le_mul_of_nonneg_left key Real.pi_pos.le
    _ = _ := by ring

theorem abs_xiForm_root_le (hlam : 1 ≤ lam) (hf : Good f₁ f₂ f₃ f₄ M) (T : DyTree α β) :
    |xiForm α β {T.root} lam r f₁ f₂ f₃ f₄| ≤ Real.pi * (Kx α lam * Ky β r) *
      T.root.area α β * (Msize α β T.rects f₁ * Msize α β T.rects f₂ * Msize α β T.rects f₃ *
        Msize α β T.rects f₄) := by
  unfold xiForm
  rw [Finset.sum_singleton, xi_summand_eq hlam hf, abs_mul, abs_of_pos Real.pi_pos]
  have h := abs_quadInt_le_Msize (f₁ := f₁) (f₂ := f₂) (f₃ := f₃) (f₄ := f₄) hf T.root_mem
    (dom_endK_self (r := r) (α := α) (β := β) hlam T.root (s := T.root.len)
      ⟨by linarith [T.root.len_pos], le_rfl⟩)
  calc _ ≤ Real.pi * (Kx α lam * Ky β r * T.root.area α β *
        (Msize α β T.rects f₁ * Msize α β T.rects f₂ * Msize α β T.rects f₃ *
          Msize α β T.rects f₄)) := mul_le_mul_of_nonneg_left h Real.pi_pos.le
    _ = _ := by ring

theorem abs_barkForm_le (hα : 0 < α) (hβ : 0 < β) (hlam : 1 ≤ lam)
    (hf : Good f₁ f₂ f₃ f₄ M) (T : DyTree α β) :
    |barkForm α β T.rects lam r f₁ f₂ f₃ f₄| ≤
      8 * ((α : ℝ) * (lam * (2 * Kx α lam)) * Ky β r +
        (β : ℝ) * ((1 + |r|) * (2 * Ky β r)) * Kx α lam) * T.root.area α β *
      (Msize α β T.rects f₁ * Msize α β T.rects f₂ * Msize α β T.rects f₃ *
        Msize α β T.rects f₄) := by
  set PP := Msize α β T.rects f₁ * Msize α β T.rects f₂ * Msize α β T.rects f₃ *
    Msize α β T.rects f₄ with hPP
  have hPPn : 0 ≤ PP := by
    have := Msize_nonneg α β T.rects f₁; have := Msize_nonneg α β T.rects f₂
    have := Msize_nonneg α β T.rects f₃; have := Msize_nonneg α β T.rects f₄
    positivity
  set cX := (α : ℝ) * (lam * (2 * Kx α lam)) * Ky β r
  set cY := (β : ℝ) * ((1 + |r|) * (2 * Ky β r)) * Kx α lam
  have hcX : 0 ≤ cX := by
    have := Kx_nonneg α lam; have := Ky_nonneg β r; have : 0 ≤ lam := by linarith
    positivity
  have hcY : 0 ≤ cY := by
    have := Kx_nonneg α lam; have := Ky_nonneg β r
    positivity
  unfold barkForm
  rw [Finset.sum_add_distrib]
  have hX := abs_sum_shift_sub_le (s := T.rects) DyRect.shx DyRect.shxm DyRect.shxm_shx
    DyRect.shx_shxm (fun R => quadInt f₁ f₂ f₃ f₄ (barkXK α β lam r R))
    (fun Q => cX * Q.area α β * PP) fun Q hQ =>
      ⟨abs_quadInt_le_Msize hf hQ (dom_barkXK_shx hlam Q),
        abs_quadInt_le_Msize hf hQ (dom_barkXK hlam Q)⟩
  have hY := abs_sum_shift_sub_le (s := T.rects) DyRect.shy DyRect.shym DyRect.shym_shy
    DyRect.shy_shym (fun R => quadInt f₁ f₂ f₃ f₄ (barkYK α β lam r R))
    (fun Q => cY * Q.area α β * PP) fun Q hQ =>
      ⟨abs_quadInt_le_Msize hf hQ (dom_barkYK_shy hlam Q),
        abs_quadInt_le_Msize hf hQ (dom_barkYK hlam Q)⟩
  rw [← Finset.sum_mul, ← Finset.mul_sum, ← Finset.sum_mul, ← Finset.mul_sum] at hX hY
  have c1 := count_shx hα T
  have c2 := count_shxm hα T
  have c3 := count_shy hβ T
  have c4 := count_shym hβ T
  refine (abs_add_le _ _).trans (add_le_add hX hY |>.trans ?_)
  have hA := T.root.area_pos α β
  have e1 := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left c1 hcX) hPPn
  have e2 := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left c2 hcX) hPPn
  have e3 := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left c3 hcY) hPPn
  have e4 := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left c4 hcY) hPPn
  nlinarith

end bound

end Telescoping

/-- `lemma:telescoping` (the estimate `eqn:barkest-final` combined with the bounds for `Ξ`):
`|α Θ^{(1)}_𝒯 + β Θ^{(2)}_𝒯| ≤ C (λ(1+|r|))^N |Q_𝒯| ∏_j 𝓜_𝒯(f_j)` for convex trees `𝒯`,
`λ ≥ 1` and bounded measurable inputs. -/
theorem telescoping_bound {α β : ℕ} (hα : 0 < α) (hβ : 0 < β) :
    ∃ (C : ℝ) (N : ℕ), 0 ≤ C ∧ ∀ (T : DyTree α β) (lam r : ℝ), 1 ≤ lam →
    ∀ (f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ), Measurable f₁ → Measurable f₂ → Measurable f₃ →
      Measurable f₄ → ∀ M : ℝ, (∀ z, |f₁ z| ≤ M) → (∀ z, |f₂ z| ≤ M) → (∀ z, |f₃ z| ≤ M) →
      (∀ z, |f₄ z| ≤ M) →
      |(α : ℝ) * theta1 α β T.rects lam r f₁ f₂ f₃ f₄ +
          (β : ℝ) * theta2 α β T.rects lam r f₁ f₂ f₃ f₄| ≤
        C * (lam * (1 + |r|)) ^ N * T.root.area α β *
          (Msize α β T.rects f₁ * Msize α β T.rects f₂ * Msize α β T.rects f₃ *
            Msize α β T.rects f₄) := by
  refine ⟨Real.pi * (kap α ^ 2 * kap β ^ 2 * (2 + 16 * α + 16 * β)), 21, by positivity, ?_⟩
  intro T lam r hlam f₁ f₂ f₃ f₄ m₁ m₂ m₃ m₄ M b₁ b₂ b₃ b₄
  have hf : Good f₁ f₂ f₃ f₄ M := ⟨m₁, m₂, m₃, m₄, b₁, b₂, b₃, b₄⟩
  set PP := Msize α β T.rects f₁ * Msize α β T.rects f₂ * Msize α β T.rects f₃ *
    Msize α β T.rects f₄ with hPP
  have hPPn : 0 ≤ PP := by
    have := Msize_nonneg α β T.rects f₁; have := Msize_nonneg α β T.rects f₂
    have := Msize_nonneg α β T.rects f₃; have := Msize_nonneg α β T.rects f₄
    positivity
  rw [telescoping_identity T r hlam hf]
  have h1 := abs_xiForm_leaves_le (r := r) hlam hf T
  have h2 := abs_xiForm_root_le (r := r) hlam hf T
  have h3 := abs_barkForm_le (r := r) hα hβ hlam hf T
  rw [← hPP] at h1 h2 h3
  set A := T.root.area α β
  have hA : 0 < A := T.root.area_pos α β
  -- the constants
  set K := lam * (1 + |r|) with hK
  have hr1 : 1 ≤ 1 + |r| := by linarith [abs_nonneg r]
  have hlam0 : 0 ≤ lam := by linarith
  have hK1 : 1 ≤ K := by nlinarith
  have hlamK : lam ≤ K := by nlinarith
  have hrK : 1 + |r| ≤ K := by nlinarith
  have hKx : Kx α lam = kap α ^ 2 * lam ^ 18 := by
    unfold Kx rho; simp; ring
  have hKy : Ky β r = kap β ^ 2 * (1 + |r|) ^ 20 := by
    unfold Ky rho; simp; ring
  set KK := Kx α lam * Ky β r with hKKdef
  have hKK : KK ≤ kap α ^ 2 * kap β ^ 2 * K ^ 20 := by
    rw [hKKdef, hKx, hKy, hK, mul_pow]
    have : lam ^ 18 ≤ lam ^ 20 := pow_le_pow_right₀ hlam (by norm_num)
    have := kap_nonneg α; have := kap_nonneg β
    have : 0 ≤ (1 + |r|) ^ 20 := by positivity
    have : 0 ≤ kap α ^ 2 * kap β ^ 2 := by positivity
    calc kap α ^ 2 * lam ^ 18 * (kap β ^ 2 * (1 + |r|) ^ 20) =
          (kap α ^ 2 * kap β ^ 2) * (lam ^ 18 * (1 + |r|) ^ 20) := by ring
      _ ≤ (kap α ^ 2 * kap β ^ 2) * (lam ^ 20 * (1 + |r|) ^ 20) := by gcongr
      _ = _ := by ring
  have hKKn : 0 ≤ KK := mul_nonneg (Kx_nonneg α lam) (Ky_nonneg β r)
  clear_value K KK PP A
  have hk4 : 0 ≤ kap α ^ 2 * kap β ^ 2 := by positivity
  have hK20 : 0 ≤ K ^ 20 := by positivity
  have hK21 : K ^ 21 = K * K ^ 20 := by ring
  -- combine
  have hbark : 8 * ((α : ℝ) * (lam * (2 * Kx α lam)) * Ky β r +
      (β : ℝ) * ((1 + |r|) * (2 * Ky β r)) * Kx α lam) =
      16 * (α : ℝ) * lam * KK + 16 * (β : ℝ) * (1 + |r|) * KK := by
    rw [hKKdef]; ring
  rw [hbark] at h3
  have hα0 : (0 : ℝ) ≤ α := Nat.cast_nonneg α
  have hβ0 : (0 : ℝ) ≤ β := Nat.cast_nonneg β
  have hsum : 2 * KK + 16 * (α : ℝ) * lam * KK + 16 * (β : ℝ) * (1 + |r|) * KK ≤
      kap α ^ 2 * kap β ^ 2 * (2 + 16 * α + 16 * β) * K ^ 21 := by
    have a1 : KK ≤ kap α ^ 2 * kap β ^ 2 * K ^ 21 := by
      rw [hK21]
      calc KK ≤ kap α ^ 2 * kap β ^ 2 * K ^ 20 := hKK
        _ ≤ kap α ^ 2 * kap β ^ 2 * (K * K ^ 20) := by
          have : K ^ 20 ≤ K * K ^ 20 := le_mul_of_one_le_left hK20 hK1
          gcongr
    have a2 : lam * KK ≤ kap α ^ 2 * kap β ^ 2 * K ^ 21 := by
      rw [hK21]
      calc lam * KK ≤ K * (kap α ^ 2 * kap β ^ 2 * K ^ 20) := by gcongr
        _ = _ := by ring
    have a3 : (1 + |r|) * KK ≤ kap α ^ 2 * kap β ^ 2 * K ^ 21 := by
      rw [hK21]
      calc (1 + |r|) * KK ≤ K * (kap α ^ 2 * kap β ^ 2 * K ^ 20) := by gcongr
        _ = _ := by ring
    have b2 := mul_le_mul_of_nonneg_left a2 hα0
    have b3 := mul_le_mul_of_nonneg_left a3 hβ0
    nlinarith
  have hAPP : 0 ≤ A * PP := mul_nonneg hA.le hPPn
  calc _ ≤ |xiForm α β T.leaves lam r f₁ f₂ f₃ f₄| + |xiForm α β {T.root} lam r f₁ f₂ f₃ f₄| +
        Real.pi * |barkForm α β T.rects lam r f₁ f₂ f₃ f₄| := by
        refine (abs_sub _ _).trans ?_
        rw [abs_mul, abs_of_pos Real.pi_pos]
        have := abs_sub (xiForm α β T.leaves lam r f₁ f₂ f₃ f₄)
          (xiForm α β {T.root} lam r f₁ f₂ f₃ f₄)
        linarith
    _ ≤ Real.pi * KK * A * PP + Real.pi * KK * A * PP + Real.pi *
        ((16 * (α : ℝ) * lam * KK + 16 * (β : ℝ) * (1 + |r|) * KK) * A * PP) := by
        gcongr
    _ = Real.pi * (A * PP) * (2 * KK + 16 * (α : ℝ) * lam * KK +
        16 * (β : ℝ) * (1 + |r|) * KK) := by ring
    _ ≤ Real.pi * (A * PP) * (kap α ^ 2 * kap β ^ 2 * (2 + 16 * α + 16 * β) * K ^ 21) := by
        gcongr
    _ = _ := by ring

end

