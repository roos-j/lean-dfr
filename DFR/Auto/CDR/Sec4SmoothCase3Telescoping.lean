  · exact (hf.measurable_quadF.mul hk.1).aestronglyMeasurable
  · refine Eventually.of_forall fun w => ?_
    rw [Real.norm_eq_abs, abs_mul, mul_assoc]
    exact mul_le_mul (hf.abs_quadF_le _ _ _ _) (hk.2 _ _ _ _) (abs_nonneg _)
      (pow_nonneg hf.M_nonneg _)

theorem quadInt_eq_integral (hf : Good f₁ f₂ f₃ f₄ M) (hw : Wts A B) {c : ℝ}
    {k : ℝ → ℝ → ℝ → ℝ → ℝ} (hk : Dom A B c k) :
    quadInt f₁ f₂ f₃ f₄ k = ∫ w : W4, quadF f₁ f₂ f₃ f₄ w.1 w.2.1 w.2.2.1 w.2.2.2 *
      k w.1 w.2.1 w.2.2.1 w.2.2.2 := by
  have h := integrable_quad hf hw hk
  rw [volume_W4] at h ⊢
  exact nest4 (g := fun x x' y y' => quadF f₁ f₂ f₃ f₄ x x' y y' * k x x' y y') h

theorem quadInt_add (hf : Good f₁ f₂ f₃ f₄ M) (hw : Wts A B) {c c' : ℝ}
    {k k' : ℝ → ℝ → ℝ → ℝ → ℝ} (hk : Dom A B c k) (hk' : Dom A B c' k') :
    quadInt f₁ f₂ f₃ f₄ (fun x x' y y' => k x x' y y' + k' x x' y y') =
      quadInt f₁ f₂ f₃ f₄ k + quadInt f₁ f₂ f₃ f₄ k' := by
  have hs : Dom A B (c + c') (fun x x' y y' => k x x' y y' + k' x x' y y') := by
    refine ⟨hk.1.add hk'.1, fun x x' y y' => ?_⟩
    calc _ ≤ |k x x' y y'| + |k' x x' y y'| := abs_add_le _ _
      _ ≤ _ := by rw [add_mul]; exact add_le_add (hk.2 _ _ _ _) (hk'.2 _ _ _ _)
  rw [quadInt_eq_integral hf hw hs, quadInt_eq_integral hf hw hk,
    quadInt_eq_integral hf hw hk', ← integral_add (integrable_quad hf hw hk)
      (integrable_quad hf hw hk')]
  congr 1; funext w; ring

theorem quadInt_const_mul (a : ℝ) (k : ℝ → ℝ → ℝ → ℝ → ℝ) :
    quadInt f₁ f₂ f₃ f₄ (fun x x' y y' => a * k x x' y y') = a * quadInt f₁ f₂ f₃ f₄ k := by
  unfold quadInt
  rw [← integral_const_mul]; congr 1; funext x
  rw [← integral_const_mul]; congr 1; funext x'
  rw [← integral_const_mul]; congr 1; funext y
  rw [← integral_const_mul]; congr 1; funext y'
  ring

theorem Dom.const_mul {c : ℝ} {k : ℝ → ℝ → ℝ → ℝ → ℝ} (hk : Dom A B c k) (a : ℝ) :
    Dom A B (|a| * c) (fun x x' y y' => a * k x x' y y') := by
  refine ⟨hk.1.const_mul a, fun x x' y y' => ?_⟩
  rw [abs_mul, mul_assoc]
  exact mul_le_mul_of_nonneg_left (hk.2 _ _ _ _) (abs_nonneg a)

theorem Dom.add {c c' : ℝ} {k k' : ℝ → ℝ → ℝ → ℝ → ℝ} (hk : Dom A B c k)
    (hk' : Dom A B c' k') : Dom A B (c + c') (fun x x' y y' => k x x' y y' + k' x x' y y') := by
  refine ⟨hk.1.add hk'.1, fun x x' y y' => ?_⟩
  calc _ ≤ |k x x' y y'| + |k' x x' y y'| := abs_add_le _ _
    _ ≤ _ := by rw [add_mul]; exact add_le_add (hk.2 _ _ _ _) (hk'.2 _ _ _ _)

theorem Dom.neg {c : ℝ} {k : ℝ → ℝ → ℝ → ℝ → ℝ} (hk : Dom A B c k) :
    Dom A B c (fun x x' y y' => -k x x' y y') :=
  ⟨hk.1.neg, fun x x' y y' => by rw [abs_neg]; exact hk.2 _ _ _ _⟩

theorem Dom.sub {c c' : ℝ} {k k' : ℝ → ℝ → ℝ → ℝ → ℝ} (hk : Dom A B c k)
    (hk' : Dom A B c' k') : Dom A B (c + c') (fun x x' y y' => k x x' y y' - k' x x' y y') := by
  have := hk.add hk'.neg
  simpa [sub_eq_add_neg] using this

theorem quadInt_neg (k : ℝ → ℝ → ℝ → ℝ → ℝ) :
    quadInt f₁ f₂ f₃ f₄ (fun x x' y y' => -k x x' y y') = -quadInt f₁ f₂ f₃ f₄ k := by
  have := quadInt_const_mul (f₁ := f₁) (f₂ := f₂) (f₃ := f₃) (f₄ := f₄) (-1) k
  simpa using this

theorem quadInt_sub (hf : Good f₁ f₂ f₃ f₄ M) (hw : Wts A B) {c c' : ℝ}
    {k k' : ℝ → ℝ → ℝ → ℝ → ℝ} (hk : Dom A B c k) (hk' : Dom A B c' k') :
    quadInt f₁ f₂ f₃ f₄ (fun x x' y y' => k x x' y y' - k' x x' y y') =
      quadInt f₁ f₂ f₃ f₄ k - quadInt f₁ f₂ f₃ f₄ k' := by
  have := quadInt_add hf hw hk hk'.neg
  rw [quadInt_neg] at this
  simpa [sub_eq_add_neg] using this

theorem Dom.mono {c c' : ℝ} {k : ℝ → ℝ → ℝ → ℝ → ℝ} (hw : Wts A B) (hk : Dom A B c k)
    (hc : c ≤ c') : Dom A B c' k :=
  ⟨hk.1, fun _ _ _ _ => (hk.2 _ _ _ _).trans
    (mul_le_mul_of_nonneg_right hc (hw.wt_nonneg _ _ _ _))⟩

theorem Dom.finset_sum {ι : Type*} (s : Finset ι) {c : ι → ℝ}
    {k : ι → ℝ → ℝ → ℝ → ℝ → ℝ} (hk : ∀ i ∈ s, Dom A B (c i) (k i)) :
    Dom A B (∑ i ∈ s, c i) (fun x x' y y' => ∑ i ∈ s, k i x x' y y') := by
  classical
  induction s using Finset.induction_on with
  | empty => exact ⟨measurable_const, fun _ _ _ _ => by simp⟩
  | insert a s ha ih =>
    have h1 := hk a (Finset.mem_insert_self a s)
    have h2 := ih fun i hi => hk i (Finset.mem_insert_of_mem hi)
    simp only [Finset.sum_insert ha]
    exact h1.add h2

theorem quadInt_finset_sum (hf : Good f₁ f₂ f₃ f₄ M) (hw : Wts A B) {ι : Type*}
    (s : Finset ι) {c : ι → ℝ} {k : ι → ℝ → ℝ → ℝ → ℝ → ℝ}
    (hk : ∀ i ∈ s, Dom A B (c i) (k i)) :
    quadInt f₁ f₂ f₃ f₄ (fun x x' y y' => ∑ i ∈ s, k i x x' y y') =
      ∑ i ∈ s, quadInt f₁ f₂ f₃ f₄ (k i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [quadInt]
  | insert a s ha ih =>
    have h1 := hk a (Finset.mem_insert_self a s)
    have h2 := Dom.finset_sum s fun i hi => hk i (Finset.mem_insert_of_mem hi)
    simp only [Finset.sum_insert ha]
    rw [quadInt_add hf hw h1 h2, ih fun i hi => hk i (Finset.mem_insert_of_mem hi)]

end quad


