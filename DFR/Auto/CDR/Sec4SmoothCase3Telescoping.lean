@[fun_prop]
theorem measurable_scalarP' {X : Type*} [MeasurableSpace X] (mu sig : ℝ) (n : ℕ)
    {f g h k : X → ℝ} (hf : Measurable f) (hg : Measurable g) (hh : Measurable h)
    (hk : Measurable k) :
    Measurable (fun a => scalarP mu sig n (f a) (g a) (h a) (k a)) := by
