/-! ### Nested integrals and product integrals -/

section nest

variable {μ₁ μ₂ μ₃ μ₄ : Measure ℝ} [SFinite μ₁] [SFinite μ₂] [SFinite μ₃] [SFinite μ₄]

theorem nest2 {g : ℝ → ℝ → ℝ} (h : Integrable (fun z : ℝ × ℝ => g z.1 z.2) (μ₁.prod μ₂)) :
    ∫ a, ∫ b, g a b ∂μ₂ ∂μ₁ = ∫ z, g z.1 z.2 ∂(μ₁.prod μ₂) :=
  (integral_prod _ h).symm

theorem nest3 {g : ℝ → ℝ → ℝ → ℝ}
    (h : Integrable (fun z : ℝ × ℝ × ℝ => g z.1 z.2.1 z.2.2) (μ₁.prod (μ₂.prod μ₃))) :
    ∫ a, ∫ b, ∫ c, g a b c ∂μ₃ ∂μ₂ ∂μ₁ = ∫ z, g z.1 z.2.1 z.2.2 ∂(μ₁.prod (μ₂.prod μ₃)) := by
  rw [integral_prod _ h]
  refine integral_congr_ae ?_
  filter_upwards [h.prod_right_ae] with a ha
  exact nest2 (g := fun b c => g a b c) ha

theorem nest4 {g : ℝ → ℝ → ℝ → ℝ → ℝ}
    (h : Integrable (fun z : ℝ × ℝ × ℝ × ℝ => g z.1 z.2.1 z.2.2.1 z.2.2.2)
      (μ₁.prod (μ₂.prod (μ₃.prod μ₄)))) :
    ∫ a, ∫ b, ∫ c, ∫ d, g a b c d ∂μ₄ ∂μ₃ ∂μ₂ ∂μ₁ =
      ∫ z, g z.1 z.2.1 z.2.2.1 z.2.2.2 ∂(μ₁.prod (μ₂.prod (μ₃.prod μ₄))) := by
  rw [integral_prod _ h]
  refine integral_congr_ae ?_
  filter_upwards [h.prod_right_ae] with a ha
  exact nest3 (g := fun b c d => g a b c d) ha

end nest

/-- The space `ℝ^4` of the variables `(x, x', y, y')`. -/
abbrev W4 := ℝ × ℝ × ℝ × ℝ

theorem volume_W4 : (volume : Measure W4) = volume.prod (volume.prod (volume.prod volume)) := by
  rfl

/-- `∫_{ℝ^4} f_1(x',y) f_2(x,y') f_3(x,y) f_4(x',y') k(x,x',y,y')`, as a nested integral. -/
def quadInt (f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ) (k : ℝ → ℝ → ℝ → ℝ → ℝ) : ℝ :=
  ∫ x, ∫ x', ∫ y, ∫ y', quadF f₁ f₂ f₃ f₄ x x' y y' * k x x' y y'

theorem quadForm_eq_quadInt (f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ) (k₁ k₂ k₃ k₄ : ℝ → ℝ) :
    quadForm f₁ f₂ f₃ f₄ k₁ k₂ k₃ k₄ =
      quadInt f₁ f₂ f₃ f₄ (fun x x' y y' => k₁ x * k₂ x' * (k₃ y * k₄ y')) := rfl

/-- Bounded measurable inputs. -/
structure Good (f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ) (M : ℝ) : Prop where
  m₁ : Measurable f₁
  m₂ : Measurable f₂
  m₃ : Measurable f₃
  m₄ : Measurable f₄
  b₁ : ∀ z, |f₁ z| ≤ M
  b₂ : ∀ z, |f₂ z| ≤ M
  b₃ : ∀ z, |f₃ z| ≤ M
  b₄ : ∀ z, |f₄ z| ≤ M

namespace Good

variable {f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ} {M : ℝ}

theorem M_nonneg (hf : Good f₁ f₂ f₃ f₄ M) : 0 ≤ M := (abs_nonneg _).trans (hf.b₁ 0)

theorem measurable_quadF (hf : Good f₁ f₂ f₃ f₄ M) :
    Measurable (fun w : W4 => quadF f₁ f₂ f₃ f₄ w.1 w.2.1 w.2.2.1 w.2.2.2) := by
  have := hf.m₁; have := hf.m₂; have := hf.m₃; have := hf.m₄
  unfold quadF; fun_prop

theorem abs_quadF_le (hf : Good f₁ f₂ f₃ f₄ M) (x x' y y' : ℝ) :
    |quadF f₁ f₂ f₃ f₄ x x' y y'| ≤ M ^ 4 := by
  unfold quadF
  rw [abs_mul, abs_mul, abs_mul, pow_succ, pow_succ, pow_succ, pow_one]
  have h0 := hf.M_nonneg
  gcongr
  exacts [hf.b₁ _, hf.b₂ _, hf.b₃ _, hf.b₄ _]

end Good

/-- The product weight `A(x) A(x') B(y) B(y')`. -/
def wt (A B : ℝ → ℝ) (x x' y y' : ℝ) : ℝ := A x * A x' * (B y * B y')

theorem integrable_wt {A B : ℝ → ℝ} (hA : Integrable A) (hB : Integrable B) :
    Integrable (fun w : W4 => wt A B w.1 w.2.1 w.2.2.1 w.2.2.2) := by
  have h := hA.mul_prod (hA.mul_prod (hB.mul_prod hB))
  rw [volume_W4]
  refine h.congr (Eventually.of_forall fun w => ?_)
  simp only [wt]; ring

/-- A kernel dominated by `c A(x) A(x') B(y) B(y')`. -/
def Dom (A B : ℝ → ℝ) (c : ℝ) (k : ℝ → ℝ → ℝ → ℝ → ℝ) : Prop :=
  Measurable (fun w : W4 => k w.1 w.2.1 w.2.2.1 w.2.2.2) ∧
    ∀ x x' y y', |k x x' y y'| ≤ c * wt A B x x' y y'

/-- Admissible weights: integrable and nonnegative. -/
structure Wts (A B : ℝ → ℝ) : Prop where
  intA : Integrable A
  intB : Integrable B
  nnA : ∀ x, 0 ≤ A x
  nnB : ∀ y, 0 ≤ B y

theorem Wts.wt_nonneg {A B : ℝ → ℝ} (h : Wts A B) (x x' y y' : ℝ) : 0 ≤ wt A B x x' y y' := by
  unfold wt
  have := h.nnA x; have := h.nnA x'; have := h.nnB y; have := h.nnB y'
  positivity

section quad

variable {f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ} {M : ℝ} {A B : ℝ → ℝ}

theorem integrable_quad (hf : Good f₁ f₂ f₃ f₄ M) (hw : Wts A B) {c : ℝ}
    {k : ℝ → ℝ → ℝ → ℝ → ℝ} (hk : Dom A B c k) :
