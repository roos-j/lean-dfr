      rw [div_mul_eq_mul_div, div_le_iff₀ had]
      have : a ^ 2 ≤ (a + δ) ^ 2 := by nlinarith
      nlinarith
    have h2 : (a + δ) / (b + δ) * b ^ 2 ≤ (b + δ) * (a + δ) := by
      rw [div_mul_eq_mul_div, div_le_iff₀ hbd]
