  have e : ∀ x x' y y', f₁ (x', y) ^ 2 * f₂ (x, y') ^ 2 * wt A B x x' y y' =
      (f₁ (x', y) ^ 2 * (A x' * B y)) * (f₂ (x, y') ^ 2 * (A x * B y')) := by
    intros; unfold wt; ring
  simp_rw [e]
  calc _ = ∫ x, ∫ x', ∫ y, (f₁ (x', y) ^ 2 * (A x' * B y)) *
        ∫ y', f₂ (x, y') ^ 2 * (A x * B y') := by
        congr 1; funext x; congr 1; funext x'; congr 1; funext y
        rw [integral_const_mul]
    _ = ∫ x, ∫ x', (∫ y, f₁ (x', y) ^ 2 * (A x' * B y)) *
        ∫ y', f₂ (x, y') ^ 2 * (A x * B y') := by
        congr 1; funext x; congr 1; funext x'
        rw [integral_mul_const]
    _ = ∫ x, (∫ x', ∫ y, f₁ (x', y) ^ 2 * (A x' * B y)) *
        ∫ y', f₂ (x, y') ^ 2 * (A x * B y') := by
        congr 1; funext x
        rw [integral_mul_const]
    _ = _ := by rw [integral_const_mul]

theorem factor_34 (A B : ℝ → ℝ) (f₃ f₄ : ℝ × ℝ → ℝ) :
    ∫ x, ∫ x', ∫ y, ∫ y', f₃ (x, y) ^ 2 * f₄ (x', y') ^ 2 * wt A B x x' y y' =
      (∫ x, ∫ y, f₃ (x, y) ^ 2 * (A x * B y)) * ∫ x, ∫ y, f₄ (x, y) ^ 2 * (A x * B y) := by
  have e : ∀ x x' y y', f₃ (x, y) ^ 2 * f₄ (x', y') ^ 2 * wt A B x x' y y' =
      (f₃ (x, y) ^ 2 * (A x * B y)) * (f₄ (x', y') ^ 2 * (A x' * B y')) := by
    intros; unfold wt; ring
  simp_rw [e]
  calc _ = ∫ x, ∫ x', ∫ y, (f₃ (x, y) ^ 2 * (A x * B y)) *
        ∫ y', f₄ (x', y') ^ 2 * (A x' * B y') := by
        congr 1; funext x; congr 1; funext x'; congr 1; funext y
        rw [integral_const_mul]
    _ = ∫ x, ∫ x', (∫ y, f₃ (x, y) ^ 2 * (A x * B y)) *
        ∫ y', f₄ (x', y') ^ 2 * (A x' * B y') := by
        congr 1; funext x; congr 1; funext x'
        rw [integral_mul_const]
    _ = ∫ x, (∫ y, f₃ (x, y) ^ 2 * (A x * B y)) *
        ∫ x', ∫ y', f₄ (x', y') ^ 2 * (A x' * B y') := by
        congr 1; funext x
        rw [integral_const_mul]
    _ = _ := by rw [integral_mul_const]

theorem amgm_four (a b c d ε : ℝ) (hε : 0 < ε) :
    |a * b * c * d| ≤ (ε * (a ^ 2 * b ^ 2) + ε⁻¹ * (c ^ 2 * d ^ 2)) / 2 := by
  have h0 : 0 ≤ ε⁻¹ * (ε * |a * b| - |c * d|) ^ 2 := by positivity
  have h1 : ε⁻¹ * (ε * |a * b| - |c * d|) ^ 2 =
      ε * |a * b| ^ 2 - 2 * (|a * b| * |c * d|) + ε⁻¹ * |c * d| ^ 2 := by
    field_simp
    ring
  rw [h1, sq_abs, sq_abs] at h0
  have h2 : |a * b * c * d| = |a * b| * |c * d| := by rw [← abs_mul]; ring_nf
  rw [h2]
  have : (a * b) ^ 2 = a ^ 2 * b ^ 2 := by ring
  have : (c * d) ^ 2 = c ^ 2 * d ^ 2 := by ring
  nlinarith

/-- `lem:bdbymax`, in the form used below: a kernel dominated by
`c θ_{L₁,c₁}(x) θ_{L₁,c₁}(x') θ_{L₂,c₂}(y) θ_{L₂,c₂}(y')` gives a form bounded by
`c ∏_j (f_j^2 * (θ_{L₁} ⊗ θ_{L₂})(c₁,c₂))^{1/2}`. -/
theorem bdbymax (hf : Good f₁ f₂ f₃ f₄ M) {L₁ L₂ c₁ c₂ c : ℝ} (h₁ : 0 < L₁)
    (h₂ : 0 < L₂) {k : ℝ → ℝ → ℝ → ℝ → ℝ}
    (hk : Dom (bracketKernelAt L₁ c₁) (bracketKernelAt L₂ c₂) c k) :
    |quadInt f₁ f₂ f₃ f₄ k| ≤ c * (√(sizeAt f₁ L₁ L₂ c₁ c₂) * √(sizeAt f₂ L₁ L₂ c₁ c₂) *
      √(sizeAt f₃ L₁ L₂ c₁ c₂) * √(sizeAt f₄ L₁ L₂ c₁ c₂)) := by
  set A := bracketKernelAt L₁ c₁ with hA
  set B := bracketKernelAt L₂ c₂ with hB
  have hw : Wts A B := wts_bracket h₁ h₂ c₁ c₂
  have hwpos : ∀ x x' y y', 0 < wt A B x x' y y' := by
    intro x x' y y'
    unfold wt
    have := Auto.Twisted.bracketKernelAt_pos (a := c₁) (x := x) h₁
    have := Auto.Twisted.bracketKernelAt_pos (a := c₁) (x := x') h₁
    have := Auto.Twisted.bracketKernelAt_pos (a := c₂) (x := y) h₂
    have := Auto.Twisted.bracketKernelAt_pos (a := c₂) (x := y') h₂
    positivity
  have hc : 0 ≤ c := by
    have h := (abs_nonneg _).trans (hk.2 0 0 0 0)
    exact nonneg_of_mul_nonneg_left h (hwpos 0 0 0 0)
  have hM := hf.M_nonneg
  set q : W4 → ℝ := fun w => quadF f₁ f₂ f₃ f₄ w.1 w.2.1 w.2.2.1 w.2.2.2 with hq
  set ω : W4 → ℝ := fun w => wt A B w.1 w.2.1 w.2.2.1 w.2.2.2 with hω
  have hωint : Integrable ω := integrable_wt hw.intA hw.intB
  have hωm : Measurable ω := by
    have := hk.1
    simp only [hω, wt, hA, hB, bracketKernelAt, kernelAt, kernelDilate,
      Auto.Twisted.bracketKernel]
    fun_prop
  have hdomM : ∀ (g : W4 → ℝ), Measurable g → (∀ w, |g w| ≤ M ^ 4 * ω w) → Integrable g :=
    fun g hg hb => Integrable.mono' (hωint.const_mul (M ^ 4)) hg.aestronglyMeasurable
      (Eventually.of_forall fun w => by rw [Real.norm_eq_abs]; exact hb w)
  have hFint : Integrable (fun w => |q w| * ω w) := by
    refine hdomM _ (hf.measurable_quadF.abs.mul hωm) fun w => ?_
    rw [abs_mul, abs_abs, abs_of_pos (hwpos _ _ _ _)]
    exact mul_le_mul_of_nonneg_right (hf.abs_quadF_le _ _ _ _) (hwpos _ _ _ _).le
  -- Step 1
  have step1 : |quadInt f₁ f₂ f₃ f₄ k| ≤ c * ∫ w, |q w| * ω w := by
    rw [quadInt_eq_integral hf hw hk, ← integral_const_mul]
    refine (abs_integral_le_integral_abs).trans (integral_mono
      (integrable_quad hf hw hk).abs (hFint.const_mul c) fun w => ?_)
    simp only [hq, hω]
    rw [abs_mul]
    calc _ ≤ |quadF f₁ f₂ f₃ f₄ w.1 w.2.1 w.2.2.1 w.2.2.2| *
        (c * wt A B w.1 w.2.1 w.2.2.1 w.2.2.2) :=
          mul_le_mul_of_nonneg_left (hk.2 _ _ _ _) (abs_nonneg _)
      _ = _ := by ring
  -- Step 2
  set s₁ := sizeAt f₁ L₁ L₂ c₁ c₂
  set s₂ := sizeAt f₂ L₁ L₂ c₁ c₂
  set s₃ := sizeAt f₃ L₁ L₂ c₁ c₂
  set s₄ := sizeAt f₄ L₁ L₂ c₁ c₂
  have hs₁ : 0 ≤ s₁ := sizeAt_nonneg _ h₁ h₂ _ _
  have hs₂ : 0 ≤ s₂ := sizeAt_nonneg _ h₁ h₂ _ _
  have hs₃ : 0 ≤ s₃ := sizeAt_nonneg _ h₁ h₂ _ _
  have hs₄ : 0 ≤ s₄ := sizeAt_nonneg _ h₁ h₂ _ _
  set G₁₂ : W4 → ℝ := fun w => f₁ (w.2.1, w.2.2.1) ^ 2 * f₂ (w.1, w.2.2.2) ^ 2 * ω w
    with hG₁₂
  set G₃₄ : W4 → ℝ := fun w => f₃ (w.1, w.2.2.1) ^ 2 * f₄ (w.2.1, w.2.2.2) ^ 2 * ω w
    with hG₃₄
  have hb2 : ∀ (g : ℝ × ℝ → ℝ), (∀ z, |g z| ≤ M) → ∀ z, g z ^ 2 ≤ M ^ 2 := by
    intro g hg z
    have := hg z
    rw [← sq_abs]
    exact pow_le_pow_left₀ (abs_nonneg _) this 2
  have hG₁₂int : Integrable G₁₂ := by
    refine hdomM _ ?_ fun w => ?_
    · have := hf.m₁; have := hf.m₂
      simp only [hG₁₂]; fun_prop
    · simp only [hG₁₂]
      rw [abs_of_nonneg (by have := hwpos w.1 w.2.1 w.2.2.1 w.2.2.2; positivity)]
      have h1 := hb2 _ hf.b₁ (w.2.1, w.2.2.1)
      have h2 := hb2 _ hf.b₂ (w.1, w.2.2.2)
      have h3 := (hwpos w.1 w.2.1 w.2.2.1 w.2.2.2).le
      calc _ ≤ M ^ 2 * M ^ 2 * ω w := by gcongr
        _ = _ := by ring
  have hG₃₄int : Integrable G₃₄ := by
    refine hdomM _ ?_ fun w => ?_
    · have := hf.m₃; have := hf.m₄
      simp only [hG₃₄]; fun_prop
    · simp only [hG₃₄]
      rw [abs_of_nonneg (by have := hwpos w.1 w.2.1 w.2.2.1 w.2.2.2; positivity)]
      have h1 := hb2 _ hf.b₃ (w.1, w.2.2.1)
      have h2 := hb2 _ hf.b₄ (w.2.1, w.2.2.2)
      have h3 := (hwpos w.1 w.2.1 w.2.2.1 w.2.2.2).le
      calc _ ≤ M ^ 2 * M ^ 2 * ω w := by gcongr
        _ = _ := by ring
  have hI₁₂ : ∫ w, G₁₂ w = s₁ * s₂ := by
    have := factor_12 A B f₁ f₂
    rw [nest4 (g := fun x x' y y' => f₁ (x', y) ^ 2 * f₂ (x, y') ^ 2 * wt A B x x' y y')
      (by rw [← volume_W4]; exact hG₁₂int)] at this
    rw [volume_W4]; exact this
  have hI₃₄ : ∫ w, G₃₄ w = s₃ * s₄ := by
    have := factor_34 A B f₃ f₄
    rw [nest4 (g := fun x x' y y' => f₃ (x, y) ^ 2 * f₄ (x', y') ^ 2 * wt A B x x' y y')
      (by rw [← volume_W4]; exact hG₃₄int)] at this
    rw [volume_W4]; exact this
  have step2 : ∫ w, |q w| * ω w ≤ (√s₁ * √s₂) * (√s₃ * √s₄) := by
    refine le_mul_of_forall_eps (by positivity) (by positivity) fun ε hε => ?_
    rw [mul_pow, mul_pow, Real.sq_sqrt hs₁, Real.sq_sqrt hs₂, Real.sq_sqrt hs₃,
      Real.sq_sqrt hs₄, ← hI₁₂, ← hI₃₄, ← integral_const_mul, ← integral_const_mul,
      ← integral_add (hG₁₂int.const_mul ε) (hG₃₄int.const_mul ε⁻¹), ← integral_div]
    refine integral_mono hFint (((hG₁₂int.const_mul ε).add
      (hG₃₄int.const_mul ε⁻¹)).div_const 2) fun w => ?_
    simp only [hq, hG₁₂, hG₃₄, quadF]
    have h := amgm_four (f₁ (w.2.1, w.2.2.1)) (f₂ (w.1, w.2.2.2)) (f₃ (w.1, w.2.2.1))
      (f₄ (w.2.1, w.2.2.2)) ε hε
    have hωn := (hwpos w.1 w.2.1 w.2.2.1 w.2.2.2).le
    calc _ ≤ (ε * (f₁ (w.2.1, w.2.2.1) ^ 2 * f₂ (w.1, w.2.2.2) ^ 2) +
          ε⁻¹ * (f₃ (w.1, w.2.2.1) ^ 2 * f₄ (w.2.1, w.2.2.2) ^ 2)) / 2 * ω w :=
          mul_le_mul_of_nonneg_right h hωn
      _ = _ := by ring
  calc _ ≤ c * ∫ w, |q w| * ω w := step1
    _ ≤ c * ((√s₁ * √s₂) * (√s₃ * √s₄)) := mul_le_mul_of_nonneg_left step2 hc
    _ = _ := by ring

end


/-! ### Interchanging the cell integrals with the `ℝ^4` integral -/

section swap

variable {f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ} {M : ℝ} {A B : ℝ → ℝ}

theorem swap_quad {Z : Type*} [MeasurableSpace Z] (μ : Measure Z) [IsFiniteMeasure μ]
    (hf : Good f₁ f₂ f₃ f₄ M) (hw : Wts A B) {c : ℝ} (K : Z → ℝ → ℝ → ℝ → ℝ → ℝ)
    (hK : Measurable (fun p : Z × W4 => K p.1 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2))
    (hdom : ∀ᵐ z ∂μ, ∀ x x' y y', |K z x x' y y'| ≤ c * wt A B x x' y y') :
    Integrable (fun z => quadInt f₁ f₂ f₃ f₄ (K z)) μ ∧
    ∫ z, quadInt f₁ f₂ f₃ f₄ (K z) ∂μ =
      quadInt f₁ f₂ f₃ f₄ (fun x x' y y' => ∫ z, K z x x' y y' ∂μ) := by
  set Φ : Z → W4 → ℝ := fun z w => quadF f₁ f₂ f₃ f₄ w.1 w.2.1 w.2.2.1 w.2.2.2 *
    K z w.1 w.2.1 w.2.2.1 w.2.2.2 with hΦ
  have hΦm : Measurable (Function.uncurry Φ) :=
    (hf.measurable_quadF.comp measurable_snd).mul hK
  have hΦint : Integrable (Function.uncurry Φ) (μ.prod volume) := by
    refine Integrable.mono' (((integrable_const (M ^ 4 * c)).mul_prod
      (integrable_wt hw.intA hw.intB))) hΦm.aestronglyMeasurable ?_
    filter_upwards [Measure.quasiMeasurePreserving_fst.ae hdom] with p hp
    simp only [Function.uncurry, hΦ, Real.norm_eq_abs]
    rw [abs_mul, mul_assoc]
    exact mul_le_mul (hf.abs_quadF_le _ _ _ _) (hp _ _ _ _) (abs_nonneg _)
      (pow_nonneg hf.M_nonneg _)
  have hslice : ∀ᵐ z ∂μ, quadInt f₁ f₂ f₃ f₄ (K z) = ∫ w, Φ z w := by
    filter_upwards [hdom] with z hz
    exact quadInt_eq_integral hf hw ⟨hK.comp (measurable_const.prodMk measurable_id), hz⟩
  have hint : Integrable (fun z => ∫ w, Φ z w) μ := hΦint.integral_prod_left
  refine ⟨hint.congr (hslice.mono fun z hz => hz.symm), ?_⟩
  rw [integral_congr_ae hslice, integral_integral_swap hΦint]
  have hbar : Dom A B (c * μ.real univ) (fun x x' y y' => ∫ z, K z x x' y y' ∂μ) := by
    refine ⟨hK.stronglyMeasurable.integral_prod_left'.measurable, fun x x' y y' => ?_⟩
    rw [← Real.norm_eq_abs]
    refine (norm_integral_le_of_norm_le_const (C := c * wt A B x x' y y') ?_).trans_eq
      (by ring)
    filter_upwards [hdom] with z hz
    rw [Real.norm_eq_abs]; exact hz _ _ _ _
  rw [quadInt_eq_integral hf hw hbar]
  congr 1; funext w; simp only [hΦ]; rw [integral_const_mul]

end swap

/-- The closed cell `Q̄ × [ℓ(Q)/2, ℓ(Q)]`. -/
def InCell (α β : ℕ) (Q : DyRect) (t p q : ℝ) : Prop :=
  t ∈ Icc (Q.len / 2) Q.len ∧ p ∈ Icc (Q.x0 α) (Q.x0 α + Q.sx α) ∧
    q ∈ Icc (Q.y0 β) (Q.y0 β + Q.sy β)

/-- The measure `dt dp dq` on the cell `(ℓ(Q)/2, ℓ(Q)] × I × J`. -/
def cellMeasure (α β : ℕ) (Q : DyRect) : Measure (ℝ × ℝ × ℝ) :=
  (volume.restrict (Ioc (Q.len / 2) Q.len)).prod
    ((volume.restrict (Q.ix α)).prod (volume.restrict (Q.iy β)))

/-- The measure `dp dq` on `Q = I × J`. -/
def rectMeasure (α β : ℕ) (Q : DyRect) : Measure (ℝ × ℝ) :=
  (volume.restrict (Q.ix α)).prod (volume.restrict (Q.iy β))

instance (α : ℕ) (Q : DyRect) : IsFiniteMeasure (volume.restrict (Q.ix α)) := by
  unfold DyRect.ix; infer_instance

instance (β : ℕ) (Q : DyRect) : IsFiniteMeasure (volume.restrict (Q.iy β)) := by
  unfold DyRect.iy; infer_instance

instance (α β : ℕ) (Q : DyRect) : IsFiniteMeasure (cellMeasure α β Q) := by
  unfold cellMeasure; infer_instance

instance (α β : ℕ) (Q : DyRect) : IsFiniteMeasure (rectMeasure α β Q) := by
  unfold rectMeasure; infer_instance

theorem ae_inCell (α β : ℕ) (Q : DyRect) :
    ∀ᵐ z ∂(cellMeasure α β Q), InCell α β Q z.1 z.2.1 z.2.2 := by
  have e : cellMeasure α β Q = (volume : Measure (ℝ × ℝ × ℝ)).restrict
      (Ioc (Q.len / 2) Q.len ×ˢ (Q.ix α ×ˢ Q.iy β)) := by
    unfold cellMeasure; rw [Measure.prod_restrict, Measure.prod_restrict]; rfl
  rw [e]
  have hm : MeasurableSet (Ioc (Q.len / 2) Q.len ×ˢ (Q.ix α ×ˢ Q.iy β)) := by
    unfold DyRect.ix DyRect.iy
    exact measurableSet_Ioc.prod (measurableSet_Ico.prod measurableSet_Ico)
  filter_upwards [ae_restrict_mem hm] with z hz
  obtain ⟨h1, h2, h3⟩ := hz
  exact ⟨Ioc_subset_Icc_self h1, Ico_subset_Icc_self h2, Ico_subset_Icc_self h3⟩

theorem ae_inRect (α β : ℕ) (Q : DyRect) :
    ∀ᵐ z ∂(rectMeasure α β Q), z.1 ∈ Icc (Q.x0 α) (Q.x0 α + Q.sx α) ∧
      z.2 ∈ Icc (Q.y0 β) (Q.y0 β + Q.sy β) := by
  have e : rectMeasure α β Q = (volume : Measure (ℝ × ℝ)).restrict (Q.ix α ×ˢ Q.iy β) := by
    unfold rectMeasure; rw [Measure.prod_restrict]; rfl
  rw [e]
  have hm : MeasurableSet (Q.ix α ×ˢ Q.iy β) := by
    unfold DyRect.ix DyRect.iy
    exact measurableSet_Ico.prod measurableSet_Ico
  filter_upwards [ae_restrict_mem hm] with z hz
  exact ⟨Ico_subset_Icc_self hz.1, Ico_subset_Icc_self hz.2⟩

theorem inCell_t_pos {α β : ℕ} {Q : DyRect} {t p q : ℝ} (h : InCell α β Q t p q) : 0 < t :=
  lt_of_lt_of_le (half_pos Q.len_pos) h.1.1

theorem cellInt_eq_integral (α β : ℕ) (Q : DyRect) (G : ℝ → ℝ → ℝ → ℝ)
    (hG : Integrable (fun z : ℝ × ℝ × ℝ => z.1⁻¹ * G z.1 z.2.1 z.2.2) (cellMeasure α β Q)) :
    cellInt α β Q G = ∫ z, z.1⁻¹ * G z.1 z.2.1 z.2.2 ∂(cellMeasure α β Q) := by
  unfold cellInt
  have e : ∀ t, t⁻¹ * ∫ p in Q.ix α, ∫ q in Q.iy β, G t p q =
      ∫ p in Q.ix α, ∫ q in Q.iy β, t⁻¹ * G t p q := by
    intro t
    rw [← integral_const_mul]
    congr 1; funext p; rw [integral_const_mul]
  simp_rw [e]
  exact nest3 (g := fun t p q => t⁻¹ * G t p q) hG

theorem rectInt_eq_integral (α β : ℕ) (Q : DyRect) (G : ℝ → ℝ → ℝ)
    (hG : Integrable (fun z : ℝ × ℝ => G z.1 z.2) (rectMeasure α β Q)) :
    ∫ p in Q.ix α, ∫ q in Q.iy β, G p q = ∫ z, G z.1 z.2 ∂(rectMeasure α β Q) :=
  nest2 (g := G) hG

theorem integrable_cell {α β : ℕ} {Q : DyRect} {g : ℝ × ℝ × ℝ → ℝ}
    (hg : AEStronglyMeasurable g (cellMeasure α β Q)) (C : ℝ)
    (hb : ∀ t p q, InCell α β Q t p q → |g (t, p, q)| ≤ C) :
    Integrable g (cellMeasure α β Q) :=
  Integrable.of_bound hg C ((ae_inCell α β Q).mono fun z hz => by
    rw [Real.norm_eq_abs]; exact hb _ _ _ hz)

theorem integrable_rect {α β : ℕ} {Q : DyRect} {g : ℝ × ℝ → ℝ}
    (hg : AEStronglyMeasurable g (rectMeasure α β Q)) (C : ℝ)
    (hb : ∀ p q, p ∈ Icc (Q.x0 α) (Q.x0 α + Q.sx α) → q ∈ Icc (Q.y0 β) (Q.y0 β + Q.sy β) →
      |g (p, q)| ≤ C) :
    Integrable g (rectMeasure α β Q) :=
  Integrable.of_bound hg C ((ae_inRect α β Q).mono fun z hz => by
    rw [Real.norm_eq_abs]; exact hb _ _ hz.1 hz.2)

section swapcell

variable {f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ} {M : ℝ} {A B : ℝ → ℝ}

/-- Fubini for a cell integral of the four-function form. -/
theorem cellInt_quadInt (hf : Good f₁ f₂ f₃ f₄ M) (hw : Wts A B) {α β : ℕ} (Q : DyRect)
    {c : ℝ} (K : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ)
    (hK : Measurable (fun p : (ℝ × ℝ × ℝ) × W4 =>
      K p.1.1 p.1.2.1 p.1.2.2 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2))
    (hdom : ∀ t p q, InCell α β Q t p q → ∀ x x' y y',
      |K t p q x x' y y'| ≤ c * wt A B x x' y y') :
    cellInt α β Q (fun t p q => quadInt f₁ f₂ f₃ f₄ (K t p q)) =
      quadInt f₁ f₂ f₃ f₄ (fun x x' y y' => cellInt α β Q (fun t p q => K t p q x x' y y')) := by
  set K' : ℝ × ℝ × ℝ → ℝ → ℝ → ℝ → ℝ → ℝ :=
    fun z x x' y y' => z.1⁻¹ * K z.1 z.2.1 z.2.2 x x' y y' with hK'
  have hK'm : Measurable (fun p : (ℝ × ℝ × ℝ) × W4 => K' p.1 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2) :=
    (measurable_fst.comp measurable_fst).inv.mul hK
  have hbd : ∀ t p q, InCell α β Q t p q → ∀ x x' y y',
      |t⁻¹ * K t p q x x' y y'| ≤ (2 / Q.len * c) * wt A B x x' y y' := by
    intro t p q h x x' y y'
    have ht := inCell_t_pos h
    have ht' : t⁻¹ ≤ 2 / Q.len := by
      rw [inv_le_comm₀ ht (by have := Q.len_pos; positivity)]
      have := h.1.1; rw [inv_div]; exact this
    rw [abs_mul, abs_of_pos (inv_pos.mpr ht), mul_assoc]
    exact mul_le_mul ht' (hdom t p q h x x' y y') (abs_nonneg _)
      (by have := Q.len_pos; positivity)
  have hdom' : ∀ᵐ z ∂(cellMeasure α β Q), ∀ x x' y y',
      |K' z x x' y y'| ≤ (2 / Q.len * c) * wt A B x x' y y' :=
    (ae_inCell α β Q).mono fun z hz => hbd _ _ _ hz
  obtain ⟨hI, hE⟩ := swap_quad (cellMeasure α β Q) hf hw K' hK'm hdom'
  have e1 : ∀ z : ℝ × ℝ × ℝ, z.1⁻¹ * quadInt f₁ f₂ f₃ f₄ (K z.1 z.2.1 z.2.2) =
      quadInt f₁ f₂ f₃ f₄ (K' z) := fun z => (quadInt_const_mul _ _).symm
  rw [cellInt_eq_integral α β Q _ (by simp_rw [e1]; exact hI)]
  simp_rw [e1]
  rw [hE]
  congr 1; funext x x' y y'
  symm
  refine cellInt_eq_integral α β Q _ (integrable_cell ?_ (2 / Q.len * c * wt A B x x' y y')
    fun t p q h => hbd t p q h x x' y y')
  exact (hK'm.comp (measurable_id.prodMk
    (measurable_const (a := ((x, x', y, y') : W4))))).aestronglyMeasurable

/-- Fubini for a rectangle integral of the four-function form. -/
theorem rectInt_quadInt (hf : Good f₁ f₂ f₃ f₄ M) (hw : Wts A B) {α β : ℕ} (Q : DyRect)
    {c : ℝ} (K : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ)
    (hK : Measurable (fun p : (ℝ × ℝ) × W4 =>
      K p.1.1 p.1.2 p.2.1 p.2.2.1 p.2.2.2.1 p.2.2.2.2))
    (hdom : ∀ p q, p ∈ Icc (Q.x0 α) (Q.x0 α + Q.sx α) → q ∈ Icc (Q.y0 β) (Q.y0 β + Q.sy β) →
      ∀ x x' y y', |K p q x x' y y'| ≤ c * wt A B x x' y y') :
    ∫ p in Q.ix α, ∫ q in Q.iy β, quadInt f₁ f₂ f₃ f₄ (K p q) =
      quadInt f₁ f₂ f₃ f₄ (fun x x' y y' => ∫ p in Q.ix α, ∫ q in Q.iy β, K p q x x' y y') := by
  set K' : ℝ × ℝ → ℝ → ℝ → ℝ → ℝ → ℝ := fun z => K z.1 z.2 with hK'
  have hdom' : ∀ᵐ z ∂(rectMeasure α β Q), ∀ x x' y y',
      |K' z x x' y y'| ≤ c * wt A B x x' y y' :=
    (ae_inRect α β Q).mono fun z hz => hdom _ _ hz.1 hz.2
  obtain ⟨hI, hE⟩ := swap_quad (rectMeasure α β Q) hf hw K' hK hdom'
  rw [rectInt_eq_integral α β Q (fun p q => quadInt f₁ f₂ f₃ f₄ (K p q)) hI, hE]
  congr 1; funext x x' y y'
  symm
  refine rectInt_eq_integral α β Q _ (integrable_rect ?_ (c * wt A B x x' y y')
    fun p q hp hq => hdom p q hp hq x x' y y')
  exact (hK.comp (measurable_id.prodMk
    (measurable_const (a := ((x, x', y, y') : W4))))).aestronglyMeasurable

end swapcell


/-! ### Pointwise domination of the kernels (`domfct`) -/

/-- The scale derivative of `D = G(u₀) G(u₁)` (see `Auto.Twisted.hasDerivAt_scalarD_scale`). -/
def scalarDdot (mu sig : ℝ) (n : ℕ) (t p u0 u1 : ℝ) : ℝ :=
  -(n : ℝ) / t * (2 * scalarD mu sig n t p u0 u1 +
    (scalarZ mu sig n t p u0 + sig / mu) * scalarH mu sig n t p u0 * scalarG mu sig n t p u1 +
    (scalarZ mu sig n t p u1 + sig / mu) * scalarG mu sig n t p u0 * scalarH mu sig n t p u1)

theorem hasDerivAt_scalarD {mu sig : ℝ} {n : ℕ} {t p u0 u1 : ℝ} (hmu : mu ≠ 0) (ht : t ≠ 0) :
    HasDerivAt (fun s => scalarD mu sig n s p u0 u1) (scalarDdot mu sig n t p u0 u1) t :=
  Auto.Twisted.hasDerivAt_scalarD_scale hmu ht

theorem measurable_gaussian : Measurable gaussian := by
  unfold gaussian; fun_prop

theorem measurable_gaussianDeriv : Measurable gaussianDeriv := by
  unfold gaussianDeriv; have := measurable_gaussian; fun_prop

@[fun_prop]
theorem measurable_scalarG' {X : Type*} [MeasurableSpace X] (mu sig : ℝ) (n : ℕ)
    {f g h : X → ℝ} (hf : Measurable f) (hg : Measurable g) (hh : Measurable h) :
    Measurable (fun a => scalarG mu sig n (f a) (g a) (h a)) := by
  unfold scalarG gaussianAt kernelAt kernelDilate
  have := measurable_gaussian
  simp only [smul_eq_mul]
  fun_prop

@[fun_prop]
theorem measurable_scalarH' {X : Type*} [MeasurableSpace X] (mu sig : ℝ) (n : ℕ)
    {f g h : X → ℝ} (hf : Measurable f) (hg : Measurable g) (hh : Measurable h) :
    Measurable (fun a => scalarH mu sig n (f a) (g a) (h a)) := by
  unfold scalarH gaussianDerivAt kernelAt kernelDilate
  have := measurable_gaussianDeriv
  simp only [smul_eq_mul]
  fun_prop

@[fun_prop]
theorem measurable_scalarZ' {X : Type*} [MeasurableSpace X] (mu sig : ℝ) (n : ℕ)
    {f g h : X → ℝ} (hf : Measurable f) (hg : Measurable g) (hh : Measurable h) :
    Measurable (fun a => scalarZ mu sig n (f a) (g a) (h a)) := by
  unfold scalarZ
  fun_prop

@[fun_prop]
theorem measurable_scalarD' {X : Type*} [MeasurableSpace X] (mu sig : ℝ) (n : ℕ)
    {f g h k : X → ℝ} (hf : Measurable f) (hg : Measurable g) (hh : Measurable h)
    (hk : Measurable k) :
    Measurable (fun a => scalarD mu sig n (f a) (g a) (h a) (k a)) := by
