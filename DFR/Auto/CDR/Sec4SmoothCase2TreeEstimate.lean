    Measurable fun w => quadForm f₁ f₂ f₃ f₄ (K₁ w) (K₂ w) (K₃ w) (K₄ w) := by
  unfold quadForm quadF
  set H : W → ℝ → ℝ → ℝ → ℝ → ℝ := fun w x x' y y' =>
    f₁ (x', y) * f₂ (x, y') * f₃ (x, y) * f₄ (x', y') * (K₁ w x * K₂ w x' * (K₃ w y * K₄ w y'))
  have m0 : Measurable fun q : (((W × ℝ) × ℝ) × ℝ) × ℝ =>
      H q.1.1.1.1 q.1.1.1.2 q.1.1.2 q.1.2 q.2 := by
    simp only [H]
    have a1 : Measurable fun q : (((W × ℝ) × ℝ) × ℝ) × ℝ => q.1.1.1.1 :=
      measurable_fst.fst.fst.fst
    have ax : Measurable fun q : (((W × ℝ) × ℝ) × ℝ) × ℝ => q.1.1.1.2 :=
      measurable_fst.fst.fst.snd
    have ax' : Measurable fun q : (((W × ℝ) × ℝ) × ℝ) × ℝ => q.1.1.2 := measurable_fst.fst.snd
    have ay : Measurable fun q : (((W × ℝ) × ℝ) × ℝ) × ℝ => q.1.2 := measurable_fst.snd
    have ay' : Measurable fun q : (((W × ℝ) × ℝ) × ℝ) × ℝ => q.2 := measurable_snd
    refine ((((h₁.comp (ax'.prodMk ay)).mul (h₂.comp (ax.prodMk ay'))).mul
      (h₃.comp (ax.prodMk ay))).mul (h₄.comp (ax'.prodMk ay'))).mul ?_
    exact ((hK₁.comp (a1.prodMk ax)).mul (hK₂.comp (a1.prodMk ax'))).mul
      ((hK₃.comp (a1.prodMk ay)).mul (hK₄.comp (a1.prodMk ay')))
  have m1 : Measurable fun q : ((W × ℝ) × ℝ) × ℝ => ∫ y', H q.1.1.1 q.1.1.2 q.1.2 q.2 y' :=
    measurable_integral_param
      (G := fun (q : ((W × ℝ) × ℝ) × ℝ) y' => H q.1.1.1 q.1.1.2 q.1.2 q.2 y') m0
  have m2 : Measurable fun q : (W × ℝ) × ℝ => ∫ y, ∫ y', H q.1.1 q.1.2 q.2 y y' :=
    measurable_integral_param
      (G := fun (q : (W × ℝ) × ℝ) y => ∫ y', H q.1.1 q.1.2 q.2 y y') m1
  have m3 : Measurable fun q : W × ℝ => ∫ x', ∫ y, ∫ y', H q.1 q.2 x' y y' :=
    measurable_integral_param
      (G := fun (q : W × ℝ) x' => ∫ y, ∫ y', H q.1 q.2 x' y y') m2
  exact measurable_integral_param (G := fun w x => ∫ x', ∫ y, ∫ y', H w x x' y y') m3

/-! ### Gaussian domination (`eqn:dominatebygaussians`) -/

theorem gaussian_eq_exp (u : ℝ) : gaussian u = Real.exp (-Real.pi * u ^ 2) := rfl

theorem gaussianAt_eq (s p x : ℝ) :
    gaussianAt s p x = s⁻¹ * gaussian ((x - p) / s) := by
  simp [gaussianAt, kernelAt, Auto.Twisted.kernelDilate, smul_eq_mul]

theorem kernelAt_real_eq (Φ : ℝ → ℝ) (s p x : ℝ) :
    kernelAt Φ s p x = s⁻¹ * Φ ((x - p) / s) := by
  simp [kernelAt, Auto.Twisted.kernelDilate, smul_eq_mul]

/-- The lower bound `∫_1^∞ λ^{-N-1} e^{-π(u^2+u'^2)/λ^2} dλ ≥ e^{-π} 2^{-N-1} (1+|u|+|u'|)^{-N}`. -/
theorem lintegral_gauss_superposition_lower (N : ℕ) (u u' : ℝ) :
    ENNReal.ofReal (Real.exp (-Real.pi) * 2 ^ (-((N : ℝ) + 1)) *
        (1 + |u| + |u'|) ^ (-(N : ℝ))) ≤
      ∫⁻ lam in Ici (1 : ℝ), ENNReal.ofReal (lam ^ (-((N : ℝ) + 1)) *
        (gaussian (u / lam) * gaussian (u' / lam))) := by
  set R : ℝ := 1 + |u| + |u'| with hR
  have hR1 : 1 ≤ R := by rw [hR]; linarith [abs_nonneg u, abs_nonneg u']
  have hR0 : 0 < R := by linarith
  have hsub : Icc R (2 * R) ⊆ Ici (1 : ℝ) := fun l hl => le_trans hR1 hl.1
  refine le_trans ?_ (lintegral_mono_set hsub)
  have hpt : ∀ lam ∈ Icc R (2 * R), ENNReal.ofReal (Real.exp (-Real.pi) *
      (2 * R) ^ (-((N : ℝ) + 1))) ≤ ENNReal.ofReal (lam ^ (-((N : ℝ) + 1)) *
        (gaussian (u / lam) * gaussian (u' / lam))) := by
    intro lam hl
    have hl0 : 0 < lam := lt_of_lt_of_le hR0 hl.1
    refine ENNReal.ofReal_le_ofReal ?_
    have hpow : (2 * R) ^ (-((N : ℝ) + 1)) ≤ lam ^ (-((N : ℝ) + 1)) :=
      Real.rpow_le_rpow_of_nonpos hl0 hl.2 (by linarith [(Nat.cast_nonneg N : (0 : ℝ) ≤ N)])
    have hg : Real.exp (-Real.pi) ≤ gaussian (u / lam) * gaussian (u' / lam) := by
      rw [gaussian_eq_exp, gaussian_eq_exp, ← Real.exp_add]
      refine Real.exp_le_exp.2 ?_
      have h1 : |u| / lam ≤ 1 := by
        rw [div_le_one hl0]; linarith [abs_nonneg u', hl.1]
      have h2 : |u'| / lam ≤ 1 := by
        rw [div_le_one hl0]; linarith [abs_nonneg u, hl.1]
      have h3 : (u / lam) ^ 2 + (u' / lam) ^ 2 ≤ 1 := by
        have e1 : (u / lam) ^ 2 = (|u| / lam) ^ 2 := by rw [div_pow, div_pow, sq_abs]
        have e2 : (u' / lam) ^ 2 = (|u'| / lam) ^ 2 := by rw [div_pow, div_pow, sq_abs]
        have hsum : |u| / lam + |u'| / lam ≤ 1 := by
          rw [← add_div, div_le_one hl0]; linarith [hl.1]
        have hn1 : 0 ≤ |u| / lam := by positivity
        have hn2 : 0 ≤ |u'| / lam := by positivity
        rw [e1, e2]; nlinarith
      nlinarith [Real.pi_pos]
    calc Real.exp (-Real.pi) * (2 * R) ^ (-((N : ℝ) + 1))
        ≤ (gaussian (u / lam) * gaussian (u' / lam)) * lam ^ (-((N : ℝ) + 1)) :=
          mul_le_mul hg hpow (Real.rpow_nonneg (by linarith) _)
            (mul_nonneg (Auto.Twisted.gaussian_nonneg _) (Auto.Twisted.gaussian_nonneg _))
      _ = _ := by ring
  refine le_trans ?_ (setLIntegral_mono' measurableSet_Icc hpt)
  rw [setLIntegral_const, Real.volume_Icc, ← ENNReal.ofReal_mul (by positivity)]
  refine ENNReal.ofReal_le_ofReal (le_of_eq ?_)
  rw [show 2 * R - R = R by ring, Real.mul_rpow (by norm_num) hR0.le]
  have : R ^ (-((N : ℝ) + 1)) * R = R ^ (-(N : ℝ)) := by
    rw [← Real.rpow_add_one hR0.ne']; ring_nf
  calc Real.exp (-Real.pi) * 2 ^ (-((N : ℝ) + 1)) * R ^ (-(N : ℝ))
      = Real.exp (-Real.pi) * 2 ^ (-((N : ℝ) + 1)) * (R ^ (-((N : ℝ) + 1)) * R) := by rw [this]
    _ = _ := by ring

/-- **`eqn:dominatebygaussians`** (dilated): for `|Φ(x)| ≤ A (1+|x|)^{-N}`,
`g_{s,p}(x) |Φ_{s,p}(x')| ≤ C A ∫_1^∞ λ^{-N+1} g_{λs,p}(x) g_{λs,p}(x') dλ`. -/
theorem gauss_dom (N : ℕ) : ∃ C : ℝ, 0 ≤ C ∧ ∀ (A : ℝ) (Φ : ℝ → ℝ),
    (∀ x, |Φ x| ≤ A * (1 + |x|) ^ (-(N : ℝ))) → ∀ (s : ℝ), 0 < s → ∀ p x x' : ℝ,
    ENNReal.ofReal (gaussianAt s p x * |kernelAt Φ s p x'|) ≤
      ENNReal.ofReal (C * A) * ∫⁻ lam in Ici (1 : ℝ), ENNReal.ofReal (lam ^ (-(N : ℝ) + 1) *
        (gaussianAt (lam * s) p x * gaussianAt (lam * s) p x')) := by
  obtain ⟨Cg, hCg, hg⟩ := Auto.Twisted.gaussian_polynomial_decay N
  refine ⟨Cg * Real.exp Real.pi * 2 ^ ((N : ℝ) + 1), by positivity, fun A Φ hΦ s hs p x x' => ?_⟩
  set u := (x - p) / s
  set u' := (x' - p) / s
  have hA : 0 ≤ A := by
    have := (abs_nonneg _).trans (hΦ 0)
    have h1 : (0 : ℝ) < (1 + |(0 : ℝ)|) ^ (-(N : ℝ)) := by positivity
    exact nonneg_of_mul_nonneg_left this h1
  -- the integrand after scaling
  have hint : ∫⁻ lam in Ici (1 : ℝ), ENNReal.ofReal (lam ^ (-(N : ℝ) + 1) *
      (gaussianAt (lam * s) p x * gaussianAt (lam * s) p x')) =
      ENNReal.ofReal (s⁻¹ * s⁻¹) * ∫⁻ lam in Ici (1 : ℝ), ENNReal.ofReal
        (lam ^ (-((N : ℝ) + 1)) * (gaussian (u / lam) * gaussian (u' / lam))) := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine setLIntegral_congr_fun measurableSet_Ici fun lam hl => ?_
    have hl0 : 0 < lam := lt_of_lt_of_le one_pos hl
    rw [← ENNReal.ofReal_mul (by positivity)]
    congr 1
    rw [gaussianAt_eq, gaussianAt_eq]
    have e1 : (x - p) / (lam * s) = u / lam := by simp only [u]; field_simp
    have e2 : (x' - p) / (lam * s) = u' / lam := by simp only [u']; field_simp
    rw [e1, e2, show -(N : ℝ) + 1 = -((N : ℝ) + 1) + 2 by ring,
      Real.rpow_add hl0, Real.rpow_two, mul_inv]
    field_simp
  rw [hint]
  have hlow := lintegral_gauss_superposition_lower N u u'
  have hgu : gaussian u ≤ Cg * (1 + |u|) ^ (-(N : ℝ)) := by
    have := hg u
    rw [Real.rpow_neg (by positivity), Real.rpow_natCast, ← div_eq_mul_inv,
      le_div_iff₀ (by positivity)]
    linarith [mul_comm ((1 + |u|) ^ N) (gaussian u)]
  have hΦu : |Φ u'| ≤ A * (1 + |u'|) ^ (-(N : ℝ)) := hΦ u'
  have hprod : (1 + |u|) ^ (-(N : ℝ)) * (1 + |u'|) ^ (-(N : ℝ)) ≤
      (1 + |u| + |u'|) ^ (-(N : ℝ)) := by
    rw [← Real.mul_rpow (by positivity) (by positivity)]
    refine Real.rpow_le_rpow_of_nonpos (by positivity) ?_ (by simp)
    nlinarith [abs_nonneg u, abs_nonneg u', mul_nonneg (abs_nonneg u) (abs_nonneg u')]
  have hlhs : gaussianAt s p x * |kernelAt Φ s p x'| =
      s⁻¹ * s⁻¹ * (gaussian u * |Φ u'|) := by
    rw [gaussianAt_eq, kernelAt_real_eq, abs_mul, abs_of_pos (inv_pos.2 hs)]; ring
  rw [hlhs]
  calc ENNReal.ofReal (s⁻¹ * s⁻¹ * (gaussian u * |Φ u'|))
      ≤ ENNReal.ofReal (s⁻¹ * s⁻¹ * (Cg * A * (1 + |u| + |u'|) ^ (-(N : ℝ)))) := by
        refine ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left ?_ (by positivity))
        calc gaussian u * |Φ u'| ≤ (Cg * (1 + |u|) ^ (-(N : ℝ))) *
              (A * (1 + |u'|) ^ (-(N : ℝ))) :=
              mul_le_mul hgu hΦu (abs_nonneg _) (by positivity)
          _ = Cg * A * ((1 + |u|) ^ (-(N : ℝ)) * (1 + |u'|) ^ (-(N : ℝ))) := by ring
          _ ≤ _ := mul_le_mul_of_nonneg_left hprod (by positivity)
    _ = ENNReal.ofReal (Cg * Real.exp Real.pi * 2 ^ ((N : ℝ) + 1) * A) *
          (ENNReal.ofReal (s⁻¹ * s⁻¹) * ENNReal.ofReal (Real.exp (-Real.pi) *
            2 ^ (-((N : ℝ) + 1)) * (1 + |u| + |u'|) ^ (-(N : ℝ)))) := by
        rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
        congr 1
        have h1 : Real.exp Real.pi * Real.exp (-Real.pi) = 1 := by
          rw [← Real.exp_add, add_neg_cancel, Real.exp_zero]
        have h2 : (2 : ℝ) ^ ((N : ℝ) + 1) * 2 ^ (-((N : ℝ) + 1)) = 1 := by
          rw [← Real.rpow_add (by norm_num), add_neg_cancel, Real.rpow_zero]
        calc s⁻¹ * s⁻¹ * (Cg * A * (1 + |u| + |u'|) ^ (-(N : ℝ)))
            = s⁻¹ * s⁻¹ * (Cg * A * (1 + |u| + |u'|) ^ (-(N : ℝ))) *
                ((Real.exp Real.pi * Real.exp (-Real.pi)) *
                  ((2 : ℝ) ^ ((N : ℝ) + 1) * 2 ^ (-((N : ℝ) + 1)))) := by rw [h1, h2]; ring
          _ = _ := by ring
    _ ≤ _ := by gcongr

/-! ### Integrals over a cell `(ℓ/2, ℓ] × I × J` -/

/-- The cell `(ℓ(Q)/2, ℓ(Q)] × I × J` in `(t, (p, q))` coordinates. -/
def cellSet (α β : ℕ) (Q : DyRect) : Set (ℝ × ℝ × ℝ) :=
  Ioc (Q.len / 2) Q.len ×ˢ (Q.ix α ×ˢ Q.iy β)

theorem measurableSet_cellSet (α β : ℕ) (Q : DyRect) : MeasurableSet (cellSet α β Q) :=
  measurableSet_Ioc.prod (measurableSet_Ico.prod measurableSet_Ico)

theorem volume_cellSet_lt_top (α β : ℕ) (Q : DyRect) : volume (cellSet α β Q) < ⊤ := by
  unfold cellSet DyRect.ix DyRect.iy
  rw [Measure.volume_eq_prod, Measure.prod_prod, Measure.volume_eq_prod, Measure.prod_prod]
  simp only [Real.volume_Ioc, Real.volume_Ico]
  exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top
    (ENNReal.mul_lt_top ENNReal.ofReal_lt_top ENNReal.ofReal_lt_top)

theorem pos_of_mem_cellSet {α β : ℕ} {Q : DyRect} {z : ℝ × ℝ × ℝ} (hz : z ∈ cellSet α β Q) :
    0 < z.1 :=
  lt_trans (div_pos Q.len_pos (by norm_num)) hz.1.1

theorem inv_le_of_mem_cellSet {α β : ℕ} {Q : DyRect} {z : ℝ × ℝ × ℝ} (hz : z ∈ cellSet α β Q) :
    z.1⁻¹ ≤ 2 / Q.len := by
  rw [inv_le_comm₀ (pos_of_mem_cellSet hz) (by have := Q.len_pos; positivity)]
  have := hz.1.1
  rw [inv_div]; linarith

/-- A cell integrand: jointly measurable and bounded on the cell. -/
def CellOK (α β : ℕ) (Q : DyRect) (G : ℝ → ℝ → ℝ → ℝ) : Prop :=
  Measurable (fun z : ℝ × ℝ × ℝ => G z.1 z.2.1 z.2.2) ∧
    ∃ B : ℝ, ∀ z ∈ cellSet α β Q, |G z.1 z.2.1 z.2.2| ≤ B

theorem integrableOn_cell {α β : ℕ} {Q : DyRect} {G : ℝ → ℝ → ℝ → ℝ} (hG : CellOK α β Q G) :
    IntegrableOn (fun z : ℝ × ℝ × ℝ => z.1⁻¹ * G z.1 z.2.1 z.2.2) (cellSet α β Q) := by
  obtain ⟨hm, B, hB⟩ := hG
  refine Measure.integrableOn_of_bounded (M := 2 / Q.len * B) (volume_cellSet_lt_top α β Q).ne
    ((measurable_fst.inv.mul hm).aestronglyMeasurable) ?_
  refine (ae_restrict_iff' (measurableSet_cellSet α β Q)).2 (Eventually.of_forall fun z hz => ?_)
  rw [Real.norm_eq_abs, abs_mul, abs_of_pos (inv_pos.2 (pos_of_mem_cellSet hz))]
  exact mul_le_mul (inv_le_of_mem_cellSet hz) (hB z hz) (abs_nonneg _)
    (by have := Q.len_pos; positivity)

/-- `cellInt` as a single integral over the cell. -/
theorem cellInt_eq_setIntegral {α β : ℕ} {Q : DyRect} {G : ℝ → ℝ → ℝ → ℝ}
    (hG : CellOK α β Q G) :
    cellInt α β Q G = ∫ z in cellSet α β Q, z.1⁻¹ * G z.1 z.2.1 z.2.2 := by
  have hI := integrableOn_cell hG
  unfold cellSet at hI ⊢
  rw [Measure.volume_eq_prod, setIntegral_prod _ hI]
  unfold cellInt
  refine setIntegral_congr_fun measurableSet_Ioc fun t ht => ?_
  have ht0 : 0 < t := lt_trans (div_pos Q.len_pos (by norm_num)) ht.1
  have hIt : IntegrableOn (fun w : ℝ × ℝ => G t w.1 w.2) (Q.ix α ×ˢ Q.iy β) := by
    obtain ⟨hm, B, hB⟩ := hG
    refine Measure.integrableOn_of_bounded (M := B) ?_
      ((hm.comp (measurable_const.prodMk measurable_id)).aestronglyMeasurable) ?_
    · unfold DyRect.ix DyRect.iy
      rw [Measure.volume_eq_prod, Measure.prod_prod]
      simp only [Real.volume_Ico]
      exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top
    · refine (ae_restrict_iff' (measurableSet_Ico.prod measurableSet_Ico)).2
        (Eventually.of_forall fun w hw => ?_)
      rw [Real.norm_eq_abs]
      exact hB (t, w) ⟨ht, hw⟩
  simp only
  rw [integral_const_mul, Measure.volume_eq_prod, setIntegral_prod _ hIt]

theorem cellInt_mono {α β : ℕ} {Q : DyRect} {G₁ G₂ : ℝ → ℝ → ℝ → ℝ}
    (h₁ : CellOK α β Q G₁) (h₂ : CellOK α β Q G₂)
    (h : ∀ z ∈ cellSet α β Q, G₁ z.1 z.2.1 z.2.2 ≤ G₂ z.1 z.2.1 z.2.2) :
    cellInt α β Q G₁ ≤ cellInt α β Q G₂ := by
  rw [cellInt_eq_setIntegral h₁, cellInt_eq_setIntegral h₂]
  refine setIntegral_mono_on (integrableOn_cell h₁) (integrableOn_cell h₂)
    (measurableSet_cellSet α β Q) fun z hz => ?_
  exact mul_le_mul_of_nonneg_left (h z hz) (inv_nonneg.2 (pos_of_mem_cellSet hz).le)

theorem cellOK_add {α β : ℕ} {Q : DyRect} {G₁ G₂ : ℝ → ℝ → ℝ → ℝ}
    (h₁ : CellOK α β Q G₁) (h₂ : CellOK α β Q G₂) :
    CellOK α β Q (fun t p q => G₁ t p q + G₂ t p q) := by
  obtain ⟨m₁, B₁, hB₁⟩ := h₁
  obtain ⟨m₂, B₂, hB₂⟩ := h₂
  exact ⟨m₁.add m₂, B₁ + B₂, fun z hz => (abs_add_le _ _).trans (add_le_add (hB₁ z hz) (hB₂ z hz))⟩

theorem cellOK_const_mul {α β : ℕ} {Q : DyRect} {G : ℝ → ℝ → ℝ → ℝ} (a : ℝ)
    (h : CellOK α β Q G) : CellOK α β Q (fun t p q => a * G t p q) := by
  obtain ⟨m, B, hB⟩ := h
  exact ⟨measurable_const.mul m, |a| * B, fun z hz => by
    rw [abs_mul]; exact mul_le_mul_of_nonneg_left (hB z hz) (abs_nonneg a)⟩

theorem cellInt_add {α β : ℕ} {Q : DyRect} {G₁ G₂ : ℝ → ℝ → ℝ → ℝ}
    (h₁ : CellOK α β Q G₁) (h₂ : CellOK α β Q G₂) :
    cellInt α β Q (fun t p q => G₁ t p q + G₂ t p q) = cellInt α β Q G₁ + cellInt α β Q G₂ := by
  rw [cellInt_eq_setIntegral (cellOK_add h₁ h₂), cellInt_eq_setIntegral h₁,
    cellInt_eq_setIntegral h₂, ← integral_add (integrableOn_cell h₁) (integrableOn_cell h₂)]
  congr 1; funext z; ring

theorem cellInt_const_mul {α β : ℕ} {Q : DyRect} {G : ℝ → ℝ → ℝ → ℝ} (a : ℝ) :
    cellInt α β Q (fun t p q => a * G t p q) = a * cellInt α β Q G := by
  unfold cellInt
  simp_rw [integral_const_mul]
  rw [← integral_const_mul]
  congr 1; funext t; ring

/-- `‖cellInt G‖ₑ ≤ ∫⁻ t⁻¹ ∫⁻ ∫⁻ ‖G‖ₑ`. -/
theorem enorm_cellInt_le (α β : ℕ) (Q : DyRect) (G : ℝ → ℝ → ℝ → ℝ) :
    ‖cellInt α β Q G‖ₑ ≤ ∫⁻ t in Ioc (Q.len / 2) Q.len, ENNReal.ofReal t⁻¹ *
      ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, ‖G t p q‖ₑ := by
  unfold cellInt
  refine (enorm_integral_le_lintegral_enorm _).trans ?_
  refine setLIntegral_mono' measurableSet_Ioc fun t ht => ?_
  have ht0 : 0 < t := lt_trans (div_pos Q.len_pos (by norm_num)) ht.1
  rw [enorm_mul, Real.enorm_eq_ofReal (inv_nonneg.2 ht0.le)]
  gcongr
  refine (enorm_integral_le_lintegral_enorm _).trans ?_
  exact lintegral_mono fun p => enorm_integral_le_lintegral_enorm _

/-- For a nonnegative cell integrand, `ofReal (cellInt G)` is the iterated lower integral. -/
theorem ofReal_cellInt {α β : ℕ} {Q : DyRect} {G : ℝ → ℝ → ℝ → ℝ} (hG : CellOK α β Q G)
    (h0 : ∀ z ∈ cellSet α β Q, 0 ≤ G z.1 z.2.1 z.2.2) :
    ENNReal.ofReal (cellInt α β Q G) = ∫⁻ t in Ioc (Q.len / 2) Q.len, ENNReal.ofReal t⁻¹ *
      ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, ENNReal.ofReal (G t p q) := by
  rw [cellInt_eq_setIntegral hG, ofReal_integral_eq_lintegral_ofReal (integrableOn_cell hG)
    ((ae_restrict_iff' (measurableSet_cellSet α β Q)).2 (Eventually.of_forall fun z hz =>
      mul_nonneg (inv_nonneg.2 (pos_of_mem_cellSet hz).le) (h0 z hz)))]
  have hm : Measurable fun z : ℝ × ℝ × ℝ => ENNReal.ofReal (z.1⁻¹ * G z.1 z.2.1 z.2.2) :=
    ENNReal.measurable_ofReal.comp (measurable_fst.inv.mul hG.1)
  unfold cellSet
  rw [Measure.volume_eq_prod, ← Measure.prod_restrict, lintegral_prod _ hm.aemeasurable]
  refine setLIntegral_congr_fun measurableSet_Ioc fun t ht => ?_
  have ht0 : 0 < t := lt_trans (div_pos Q.len_pos (by norm_num)) ht.1
  have hm' : Measurable fun w : ℝ × ℝ => ENNReal.ofReal (G t w.1 w.2) :=
    ENNReal.measurable_ofReal.comp (hG.1.comp (measurable_const.prodMk measurable_id))
  simp_rw [ENNReal.ofReal_mul (inv_nonneg.2 ht0.le)]
  rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, Measure.volume_eq_prod,
    ← Measure.prod_restrict, lintegral_prod _ hm'.aemeasurable]

/-! ### Uniform bounds for parametrized forms -/

theorem abs_quadForm_le {f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ} (h₁ : Measurable f₁)
    (h₂ : Measurable f₂) (h₃ : Measurable f₃) (h₄ : Measurable f₄) {M : ℝ}
    (hb₁ : ∀ z, |f₁ z| ≤ M) (hb₂ : ∀ z, |f₂ z| ≤ M) (hb₃ : ∀ z, |f₃ z| ≤ M)
    (hb₄ : ∀ z, |f₄ z| ≤ M) {k₁ k₂ k₃ k₄ : ℝ → ℝ} (hk₁ : Measurable k₁) (hk₂ : Measurable k₂)
    (hk₃ : Measurable k₃) (hk₄ : Measurable k₄) (ik₁ : Integrable k₁) (ik₂ : Integrable k₂)
    (ik₃ : Integrable k₃) (ik₄ : Integrable k₄) :
    |quadForm f₁ f₂ f₃ f₄ k₁ k₂ k₃ k₄| ≤
      M ^ 4 * ((∫ x, |k₁ x|) * (∫ x, |k₂ x|) * ((∫ x, |k₃ x|) * (∫ x, |k₄ x|))) := by
  rw [quadForm_eq_integral h₁ h₂ h₃ h₄ hb₁ hb₂ hb₃ hb₄ hk₁ hk₂ hk₃ hk₄ ik₁ ik₂ ik₃ ik₄]
  have hdom : Integrable (fun w : (ℝ × ℝ) × (ℝ × ℝ) =>
      M ^ 4 * (|k₁ w.1.1| * |k₂ w.1.2| * (|k₃ w.2.1| * |k₄ w.2.2|))) :=
    (Integrable.mul_prod (ik₁.abs.mul_prod ik₂.abs) (ik₃.abs.mul_prod ik₄.abs)).const_mul _
  refine (abs_integral_le_integral_abs).trans ?_
  refine (integral_mono_of_nonneg (Eventually.of_forall fun w => abs_nonneg _) hdom
    (Eventually.of_forall fun w => ?_)).trans (le_of_eq ?_)
  · exact (Real.norm_eq_abs _).symm.le.trans
      (norm_quadIntegrand_le hb₁ hb₂ hb₃ hb₄ k₁ k₂ k₃ k₄ w)
  · rw [integral_const_mul]
    congr 1
    have e2 : ∫ a : ℝ × ℝ, |k₁ a.1| * |k₂ a.2| = (∫ x, |k₁ x|) * (∫ x, |k₂ x|) :=
      integral_prod_mul (fun a : ℝ => |k₁ a|) (fun b : ℝ => |k₂ b|)
    have e3 : ∫ b : ℝ × ℝ, |k₃ b.1| * |k₄ b.2| = (∫ x, |k₃ x|) * (∫ x, |k₄ x|) :=
      integral_prod_mul (fun a : ℝ => |k₃ a|) (fun b : ℝ => |k₄ b|)
    calc ∫ w : (ℝ × ℝ) × (ℝ × ℝ), |k₁ w.1.1| * |k₂ w.1.2| * (|k₃ w.2.1| * |k₄ w.2.2|)
        = (∫ a : ℝ × ℝ, |k₁ a.1| * |k₂ a.2|) * (∫ b : ℝ × ℝ, |k₃ b.1| * |k₄ b.2|) :=
          integral_prod_mul (fun a : ℝ × ℝ => |k₁ a.1| * |k₂ a.2|)
            (fun b : ℝ × ℝ => |k₃ b.1| * |k₄ b.2|)
      _ = _ := by rw [e2, e3]

theorem integral_abs_kernelAt (k : ℝ → ℝ) {s : ℝ} (hs : 0 < s) (a : ℝ) :
    ∫ x, |kernelAt k s a x| = ∫ x, |k x| := by
  simp_rw [kernelAt_real_eq, abs_mul, abs_of_pos (inv_pos.2 hs)]
  rw [integral_const_mul, integral_sub_right_eq_self (μ := volume)
    (fun x => |k (x / s)|) a, Measure.integral_comp_div (fun x => |k x|) s, abs_of_pos hs,
    smul_eq_mul, ← mul_assoc, inv_mul_cancel₀ hs.ne', one_mul]

theorem integrable_kernelAt {k : ℝ → ℝ} (hk : Integrable k) {s : ℝ} (hs : 0 < s) (a : ℝ) :
    Integrable (kernelAt k s a) := by
  unfold kernelAt Auto.Twisted.kernelDilate
  exact ((hk.comp_div hs.ne').comp_sub_right a).smul (s⁻¹ : ℝ)

theorem measurable_kernelAt {k : ℝ → ℝ} (hk : Measurable k) (s a : ℝ) :
    Measurable (kernelAt k s a) := by
  have e : kernelAt k s a = fun x => s⁻¹ * k ((x - a) / s) := funext (kernelAt_real_eq k s a)
  rw [e]
  exact measurable_const.mul (hk.comp ((measurable_id.sub_const a).div_const s))

theorem measurable_kernelAt_param {W : Type*} [MeasurableSpace W] {k : ℝ → ℝ}
    (hk : Measurable k) {a b : W → ℝ} (ha : Measurable a) (hb : Measurable b) :
    Measurable (Function.uncurry fun w x => kernelAt k (a w) (b w) x) := by
  simp only [kernelAt_real_eq]
  exact (ha.comp measurable_fst).inv.mul (hk.comp ((measurable_snd.sub
    (hb.comp measurable_fst)).div (ha.comp measurable_fst)))

/-- Cell integrands `c(t) quadForm f (k₁)_{a₁,b₁} (k₂)_{a₂,b₂} (k₃)_{a₃,b₃} (k₄)_{a₄,b₄}` are
`CellOK`. -/
theorem cellOK_quadForm {α β : ℕ} {Q : DyRect} {f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ}
    (h₁ : Measurable f₁) (h₂ : Measurable f₂) (h₃ : Measurable f₃) (h₄ : Measurable f₄)
    {M : ℝ} (hb₁ : ∀ z, |f₁ z| ≤ M) (hb₂ : ∀ z, |f₂ z| ≤ M) (hb₃ : ∀ z, |f₃ z| ≤ M)
    (hb₄ : ∀ z, |f₄ z| ≤ M) {k₁ k₂ k₃ k₄ : ℝ → ℝ} (hk₁ : Measurable k₁) (hk₂ : Measurable k₂)
    (hk₃ : Measurable k₃) (hk₄ : Measurable k₄) (ik₁ : Integrable k₁) (ik₂ : Integrable k₂)
    (ik₃ : Integrable k₃) (ik₄ : Integrable k₄)
    {a₁ b₁ a₂ b₂ a₃ b₃ a₄ b₄ : ℝ × ℝ × ℝ → ℝ} (ha₁ : Measurable a₁) (hb'₁ : Measurable b₁)
    (ha₂ : Measurable a₂) (hb'₂ : Measurable b₂) (ha₃ : Measurable a₃) (hb'₃ : Measurable b₃)
    (ha₄ : Measurable a₄) (hb'₄ : Measurable b₄)
    (hpos : ∀ z ∈ cellSet α β Q, 0 < a₁ z ∧ 0 < a₂ z ∧ 0 < a₃ z ∧ 0 < a₄ z)
    {c : ℝ → ℝ} (hc : Measurable c) {Cc : ℝ} (hcb : ∀ t, |c t| ≤ Cc) :
    CellOK α β Q fun t p q => c t * quadForm f₁ f₂ f₃ f₄
      (kernelAt k₁ (a₁ (t, p, q)) (b₁ (t, p, q))) (kernelAt k₂ (a₂ (t, p, q)) (b₂ (t, p, q)))
      (kernelAt k₃ (a₃ (t, p, q)) (b₃ (t, p, q))) (kernelAt k₄ (a₄ (t, p, q)) (b₄ (t, p, q))) := by
  refine ⟨?_, Cc * (M ^ 4 * ((∫ x, |k₁ x|) * (∫ x, |k₂ x|) * ((∫ x, |k₃ x|) * (∫ x, |k₄ x|)))),
    fun z hz => ?_⟩
  · refine (hc.comp measurable_fst).mul ?_
    have := measurable_quadForm_param h₁ h₂ h₃ h₄ (measurable_kernelAt_param hk₁ ha₁ hb'₁)
      (measurable_kernelAt_param hk₂ ha₂ hb'₂) (measurable_kernelAt_param hk₃ ha₃ hb'₃)
      (measurable_kernelAt_param hk₄ ha₄ hb'₄)
    exact this
  · obtain ⟨p₁, p₂, p₃, p₄⟩ := hpos z hz
    rw [abs_mul]
    have hq := abs_quadForm_le h₁ h₂ h₃ h₄ hb₁ hb₂ hb₃ hb₄
      (measurable_kernelAt hk₁ (a₁ z) (b₁ z)) (measurable_kernelAt hk₂ (a₂ z) (b₂ z))
      (measurable_kernelAt hk₃ (a₃ z) (b₃ z)) (measurable_kernelAt hk₄ (a₄ z) (b₄ z))
      (integrable_kernelAt ik₁ p₁ (b₁ z)) (integrable_kernelAt ik₂ p₂ (b₂ z))
      (integrable_kernelAt ik₃ p₃ (b₃ z)) (integrable_kernelAt ik₄ p₄ (b₄ z))
    rw [integral_abs_kernelAt k₁ p₁, integral_abs_kernelAt k₂ p₂, integral_abs_kernelAt k₃ p₃,
      integral_abs_kernelAt k₄ p₄] at hq
    have hM : 0 ≤ M := (abs_nonneg _).trans (hb₁ 0)
    exact mul_le_mul (hcb z.1) hq (abs_nonneg _) ((abs_nonneg _).trans (hcb 0))

/-! ### Positivity and Cauchy-Schwarz for the `x`-kernels -/

/-- `U_f(y,y') = ∫ f(x,y') f(x,y) k(x) dx`. -/
def uForm (f : ℝ × ℝ → ℝ) (k : ℝ → ℝ) (y y' : ℝ) : ℝ := ∫ x, f (x, y') * f (x, y) * k x

theorem measurable_uForm {f : ℝ × ℝ → ℝ} (hf : Measurable f) {k : ℝ → ℝ} (hk : Measurable k) :
    Measurable fun v : ℝ × ℝ => uForm f k v.1 v.2 := by
  unfold uForm
  refine measurable_integral_param (G := fun (v : ℝ × ℝ) x => f (x, v.2) * f (x, v.1) * k x) ?_
  exact ((hf.comp (measurable_snd.prodMk measurable_fst.snd)).mul
    (hf.comp (measurable_snd.prodMk measurable_fst.fst))).mul (hk.comp measurable_snd)

theorem abs_uForm_le {f : ℝ × ℝ → ℝ} {M : ℝ} (hb : ∀ z, |f z| ≤ M) {k : ℝ → ℝ}
    (hk : Integrable k) (y y' : ℝ) : |uForm f k y y'| ≤ M ^ 2 * ∫ x, |k x| := by
  unfold uForm
  refine (abs_integral_le_integral_abs).trans ?_
  rw [← integral_const_mul]
  refine integral_mono_of_nonneg (Eventually.of_forall fun x => abs_nonneg _)
    (hk.abs.const_mul _) (Eventually.of_forall fun x => ?_)
  simp only [abs_mul]
  have hM : 0 ≤ M := (abs_nonneg _).trans (hb 0)
  calc |f (x, y')| * |f (x, y)| * |k x| ≤ M * M * |k x| :=
        mul_le_mul_of_nonneg_right (mul_le_mul (hb _) (hb _) (abs_nonneg _) hM) (abs_nonneg _)
    _ = M ^ 2 * |k x| := by ring

/-- `quadForm a b b a k k k₃ k₄` in terms of `U_a`, `U_b`. -/
theorem quadForm_abba_eq {a b : ℝ × ℝ → ℝ} (ha : Measurable a) (hb : Measurable b) {M : ℝ}
    (hba : ∀ z, |a z| ≤ M) (hbb : ∀ z, |b z| ≤ M) {k k₃ k₄ : ℝ → ℝ} (hk : Measurable k)
    (hk₃ : Measurable k₃) (hk₄ : Measurable k₄) (ik : Integrable k) (ik₃ : Integrable k₃)
    (ik₄ : Integrable k₄) :
    quadForm a b b a k k k₃ k₄ = ∫ y, ∫ y', k₃ y * k₄ y' * (uForm b k y y' * uForm a k y y') := by
  rw [quadForm_eq_factor_swap ha hb hb ha hba hbb hbb hba hk hk hk₃ hk₄ ik ik ik₃ ik₄]
  refine integral_congr_ae (Eventually.of_forall fun y => ?_)
  refine integral_congr_ae (Eventually.of_forall fun y' => ?_)
  unfold uForm
  beta_reduce
  congr 2
  congr 1; funext x; ring

theorem integrable_uForm_mul {a b : ℝ × ℝ → ℝ} (ha : Measurable a) (hb : Measurable b) {M : ℝ}
    (hba : ∀ z, |a z| ≤ M) (hbb : ∀ z, |b z| ≤ M) {k k₃ k₄ : ℝ → ℝ} (hk : Measurable k)
    (hk₃ : Measurable k₃) (hk₄ : Measurable k₄) (ik : Integrable k) (ik₃ : Integrable k₃)
    (ik₄ : Integrable k₄) :
    Integrable fun v : ℝ × ℝ => k₃ v.1 * k₄ v.2 * (uForm b k v.1 v.2 * uForm a k v.1 v.2) := by
  have hdom : Integrable fun v : ℝ × ℝ =>
      (M ^ 2 * ∫ x, |k x|) * (M ^ 2 * ∫ x, |k x|) * (|k₃ v.1| * |k₄ v.2|) :=
    (ik₃.abs.mul_prod ik₄.abs).const_mul _
  refine hdom.mono' ?_ (Eventually.of_forall fun v => ?_)
  · exact (((hk₃.comp measurable_fst).mul (hk₄.comp measurable_snd)).mul
      ((measurable_uForm hb hk).mul (measurable_uForm ha hk))).aestronglyMeasurable
  · rw [Real.norm_eq_abs, abs_mul, abs_mul, abs_mul]
    have h1 := abs_uForm_le hbb ik v.1 v.2
    have h2 := abs_uForm_le hba ik v.1 v.2
    calc |k₃ v.1| * |k₄ v.2| * (|uForm b k v.1 v.2| * |uForm a k v.1 v.2|)
        ≤ |k₃ v.1| * |k₄ v.2| * ((M ^ 2 * ∫ x, |k x|) * (M ^ 2 * ∫ x, |k x|)) := by
          gcongr
      _ = _ := by ring

/-- **AM-GM form of Cauchy-Schwarz** for `Θ^{(1)}`-type forms:
`|quadForm a b b a k k k₃ k₄| ≤ (ε quadForm a a a a ... + ε⁻¹ quadForm b b b b ...)/2`. -/
theorem abs_quadForm_abba_le {a b : ℝ × ℝ → ℝ} (ha : Measurable a) (hb : Measurable b)
    {M : ℝ} (hba : ∀ z, |a z| ≤ M) (hbb : ∀ z, |b z| ≤ M) {k k₃ k₄ : ℝ → ℝ}
    (hk : Measurable k) (hk₃ : Measurable k₃) (hk₄ : Measurable k₄) (ik : Integrable k)
    (ik₃ : Integrable k₃) (ik₄ : Integrable k₄) (hw : ∀ y y', 0 ≤ k₃ y * k₄ y') {ε : ℝ}
    (hε : 0 < ε) :
    |quadForm a b b a k k k₃ k₄| ≤
      (ε * quadForm a a a a k k k₃ k₄ + ε⁻¹ * quadForm b b b b k k k₃ k₄) / 2 := by
  rw [quadForm_abba_eq ha hb hba hbb hk hk₃ hk₄ ik ik₃ ik₄,
    quadForm_abba_eq ha ha hba hba hk hk₃ hk₄ ik ik₃ ik₄,
    quadForm_abba_eq hb hb hbb hbb hk hk₃ hk₄ ik ik₃ ik₄]
  have I₁ := integrable_uForm_mul ha hb hba hbb hk hk₃ hk₄ ik ik₃ ik₄
  have I₂ := integrable_uForm_mul ha ha hba hba hk hk₃ hk₄ ik ik₃ ik₄
  have I₃ := integrable_uForm_mul hb hb hbb hbb hk hk₃ hk₄ ik ik₃ ik₄
  rw [← integral_prod (fun v : ℝ × ℝ => k₃ v.1 * k₄ v.2 *
      (uForm b k v.1 v.2 * uForm a k v.1 v.2)) I₁,
    ← integral_prod (fun v : ℝ × ℝ => k₃ v.1 * k₄ v.2 *
      (uForm a k v.1 v.2 * uForm a k v.1 v.2)) I₂,
    ← integral_prod (fun v : ℝ × ℝ => k₃ v.1 * k₄ v.2 *
      (uForm b k v.1 v.2 * uForm b k v.1 v.2)) I₃, ← Measure.volume_eq_prod,
    ← integral_const_mul, ← integral_const_mul, ← integral_add (I₂.const_mul _) (I₃.const_mul _),
    ← integral_div]
  refine (abs_integral_le_integral_abs).trans (integral_mono_of_nonneg
    (Eventually.of_forall fun v => abs_nonneg _)
    (((I₂.const_mul _).add (I₃.const_mul _)).div_const _)
    (Eventually.of_forall fun v => ?_))
  have hwv := hw v.1 v.2
  set A := uForm a k v.1 v.2
  set B := uForm b k v.1 v.2
  have hAB : |B * A| ≤ (ε * (A * A) + ε⁻¹ * (B * B)) / 2 := by
    rw [abs_mul]
    have h1 : 0 ≤ (Real.sqrt ε * |A| - Real.sqrt ε⁻¹ * |B|) ^ 2 := sq_nonneg _
    have hs1 : Real.sqrt ε * Real.sqrt ε = ε := Real.mul_self_sqrt hε.le
    have hs2 : Real.sqrt ε⁻¹ * Real.sqrt ε⁻¹ = ε⁻¹ := Real.mul_self_sqrt (inv_nonneg.2 hε.le)
    have hs3 : Real.sqrt ε * Real.sqrt ε⁻¹ = 1 := by
      rw [← Real.sqrt_mul hε.le, mul_inv_cancel₀ hε.ne', Real.sqrt_one]
    have hA2 : |A| * |A| = A * A := abs_mul_abs_self A
    have hB2 : |B| * |B| = B * B := abs_mul_abs_self B
    have hexp : (Real.sqrt ε * |A| - Real.sqrt ε⁻¹ * |B|) ^ 2 =
        ε * (A * A) - 2 * (|B| * |A|) + ε⁻¹ * (B * B) := by
      calc (Real.sqrt ε * |A| - Real.sqrt ε⁻¹ * |B|) ^ 2
          = (Real.sqrt ε * Real.sqrt ε) * (|A| * |A|) -
              2 * (Real.sqrt ε * Real.sqrt ε⁻¹) * (|B| * |A|) +
              (Real.sqrt ε⁻¹ * Real.sqrt ε⁻¹) * (|B| * |B|) := by ring
        _ = _ := by rw [hs1, hs2, hs3, hA2, hB2]; ring
    linarith
  calc |k₃ v.1 * k₄ v.2 * (B * A)| = k₃ v.1 * k₄ v.2 * |B * A| := by
        rw [abs_mul, abs_of_nonneg hwv]
    _ ≤ k₃ v.1 * k₄ v.2 * ((ε * (A * A) + ε⁻¹ * (B * B)) / 2) :=
        mul_le_mul_of_nonneg_left hAB hwv
    _ = _ := by ring

/-! ### Bounds for `Θ^{(1)}`, `Θ^{(2)}` from the telescoping bound -/

/-- The conclusion of `lemma:telescoping` with `eqn:barkest-final` (proved in §4.3). -/
def TelescopingBound (α β : ℕ) : Prop :=
  ∃ (C : ℝ) (N : ℕ), 0 ≤ C ∧ ∀ (T : DyTree α β) (lam r : ℝ), 1 ≤ lam →
    ∀ (f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ), Measurable f₁ → Measurable f₂ → Measurable f₃ →
      Measurable f₄ → ∀ M : ℝ, (∀ z, |f₁ z| ≤ M) → (∀ z, |f₂ z| ≤ M) → (∀ z, |f₃ z| ≤ M) →
      (∀ z, |f₄ z| ≤ M) →
      |(α : ℝ) * theta1 α β T.rects lam r f₁ f₂ f₃ f₄ +
          (β : ℝ) * theta2 α β T.rects lam r f₁ f₂ f₃ f₄| ≤
        C * (lam * (1 + |r|)) ^ N * T.root.area α β *
          (Msize α β T.rects f₁ * Msize α β T.rects f₂ * Msize α β T.rects f₃ *
            Msize α β T.rects f₄)

theorem continuous_gaussian' : Continuous gaussian :=
  Real.continuous_exp.comp (continuous_const.mul (continuous_pow 2))

theorem scalarG_eq_kernelAt (mu sig : ℝ) (n : ℕ) (t p : ℝ) :
    scalarG mu sig n t p = kernelAt gaussian (mu * t ^ n) (p + sig * t ^ n) := rfl

theorem scalarH_eq_kernelAt (mu sig : ℝ) (n : ℕ) (t p : ℝ) :
    scalarH mu sig n t p = kernelAt gaussianDeriv (mu * t ^ n) (p + sig * t ^ n) := rfl

theorem cellInt_nonneg {α β : ℕ} {Q : DyRect} {G : ℝ → ℝ → ℝ → ℝ}
    (h : ∀ z ∈ cellSet α β Q, 0 ≤ G z.1 z.2.1 z.2.2) : 0 ≤ cellInt α β Q G := by
  unfold cellInt
  refine setIntegral_nonneg measurableSet_Ioc fun t ht => ?_
  have ht0 : 0 < t := lt_trans (div_pos Q.len_pos (by norm_num)) ht.1
  refine mul_nonneg (inv_nonneg.2 ht0.le) (setIntegral_nonneg measurableSet_Ico fun p hp =>
    setIntegral_nonneg measurableSet_Ico fun q hq => h (t, p, q) ⟨ht, hp, hq⟩)

theorem collInt_nonneg {α β : ℕ} {𝒬 : Finset DyRect} {G : ℝ → ℝ → ℝ → ℝ}
    (h : ∀ Q ∈ 𝒬, ∀ z ∈ cellSet α β Q, 0 ≤ G z.1 z.2.1 z.2.2) : 0 ≤ collInt α β 𝒬 G :=
  Finset.sum_nonneg fun Q hQ => cellInt_nonneg (h Q hQ)

theorem cellOK_abs {α β : ℕ} {Q : DyRect} {G : ℝ → ℝ → ℝ → ℝ} (h : CellOK α β Q G) :
    CellOK α β Q fun t p q => |G t p q| := by
  obtain ⟨m, B, hB⟩ := h
  exact ⟨m.abs, B, fun z hz => by rw [abs_abs]; exact hB z hz⟩

theorem abs_cellInt_le {α β : ℕ} {Q : DyRect} {G : ℝ → ℝ → ℝ → ℝ} (h : CellOK α β Q G) :
    |cellInt α β Q G| ≤ cellInt α β Q fun t p q => |G t p q| := by
  rw [cellInt_eq_setIntegral h, cellInt_eq_setIntegral (cellOK_abs h)]
  refine (abs_integral_le_integral_abs).trans (le_of_eq ?_)
  refine setIntegral_congr_fun (measurableSet_cellSet α β Q) fun z hz => ?_
  rw [abs_mul, abs_of_pos (inv_pos.2 (pos_of_mem_cellSet hz))]

/-- The `Θ`-cell integrands are `CellOK`. -/
theorem cellOK_theta {α β : ℕ} {Q : DyRect} {f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ}
    (h₁ : Measurable f₁) (h₂ : Measurable f₂) (h₃ : Measurable f₃) (h₄ : Measurable f₄)
    {M : ℝ} (hb₁ : ∀ z, |f₁ z| ≤ M) (hb₂ : ∀ z, |f₂ z| ≤ M) (hb₃ : ∀ z, |f₃ z| ≤ M)
    (hb₄ : ∀ z, |f₄ z| ≤ M) {k₁ k₂ : ℝ → ℝ} (hk₁ : Continuous k₁) (hk₂ : Continuous k₂)
    (ik₁ : Integrable k₁) (ik₂ : Integrable k₂) {lam r : ℝ} (hlam : 0 < lam) :
    CellOK α β Q fun t p q => quadForm f₁ f₂ f₃ f₄
      (kernelAt k₁ (lam * t ^ α) (p + 0 * t ^ α)) (kernelAt k₁ (lam * t ^ α) (p + 0 * t ^ α))
      (kernelAt k₂ (1 * t ^ β) (q + r * t ^ β)) (kernelAt k₂ (1 * t ^ β) (q + r * t ^ β)) := by
  have h := cellOK_quadForm (α := α) (β := β) (Q := Q) h₁ h₂ h₃ h₄ hb₁ hb₂ hb₃ hb₄
    hk₁.measurable hk₁.measurable hk₂.measurable hk₂.measurable ik₁ ik₁ ik₂ ik₂
    (a₁ := fun z => lam * z.1 ^ α) (b₁ := fun z => z.2.1 + 0 * z.1 ^ α)
    (a₂ := fun z => lam * z.1 ^ α) (b₂ := fun z => z.2.1 + 0 * z.1 ^ α)
    (a₃ := fun z => 1 * z.1 ^ β) (b₃ := fun z => z.2.2 + r * z.1 ^ β)
    (a₄ := fun z => 1 * z.1 ^ β) (b₄ := fun z => z.2.2 + r * z.1 ^ β)
    (by fun_prop) (by fun_prop) (by fun_prop) (by fun_prop) (by fun_prop) (by fun_prop)
    (by fun_prop) (by fun_prop) (fun z hz => by
      have := pos_of_mem_cellSet hz
      exact ⟨by positivity, by positivity, by positivity, by positivity⟩)
    (c := fun _ => 1) measurable_const (Cc := 1) (fun _ => by norm_num)
  obtain ⟨m, B, hB⟩ := h
  exact ⟨by simpa using m, B, fun z hz => by simpa using hB z hz⟩

theorem gaussianAt_nonneg' {s : ℝ} (hs : 0 ≤ s) (a x : ℝ) : 0 ≤ gaussianAt s a x := by
  rw [gaussianAt_eq]; exact mul_nonneg (inv_nonneg.2 hs) (Auto.Twisted.gaussian_nonneg _)

theorem theta2_abba_nonneg (α β : ℕ) (𝒬 : Finset DyRect) {lam : ℝ} (hlam : 0 ≤ lam) (r : ℝ)
    (a b : ℝ × ℝ → ℝ) : 0 ≤ theta2 α β 𝒬 lam r a b b a := by
  unfold theta2
  refine collInt_nonneg fun Q _ z hz => quadForm_diag_nonneg fun x x' => ?_
  have ht := pos_of_mem_cellSet hz
  have hs : 0 ≤ lam * z.1 ^ α := by positivity
  exact mul_nonneg (gaussianAt_nonneg' hs _ _) (gaussianAt_nonneg' hs _ _)

theorem theta1_diag_nonneg (α β : ℕ) (𝒬 : Finset DyRect) {lam : ℝ} (hlam : 0 < lam) (r : ℝ)
    {a : ℝ × ℝ → ℝ} (ha : Measurable a) {M : ℝ} (hba : ∀ z, |a z| ≤ M) :
    0 ≤ theta1 α β 𝒬 lam r a a a a := by
  unfold theta1
  refine collInt_nonneg fun Q _ z hz => ?_
  have ht := pos_of_mem_cellSet hz
  have hs : 0 < lam * z.1 ^ α := by positivity
  have hs' : 0 < 1 * z.1 ^ β := by positivity
  rw [scalarH_eq_kernelAt, scalarG_eq_kernelAt, quadForm_abba_eq ha ha hba hba
    (measurable_kernelAt Auto.Twisted.continuous_gaussianDeriv.measurable _ _)
    (measurable_kernelAt continuous_gaussian'.measurable _ _)
    (measurable_kernelAt continuous_gaussian'.measurable _ _)
    (integrable_kernelAt Auto.Twisted.integrable_gaussianDeriv hs _)
    (integrable_kernelAt Auto.Twisted.integrable_gaussian hs' _)
    (integrable_kernelAt Auto.Twisted.integrable_gaussian hs' _)]
  refine integral_nonneg fun y => integral_nonneg fun y' => ?_
  exact mul_nonneg (mul_nonneg (gaussianAt_nonneg' hs'.le _ _) (gaussianAt_nonneg' hs'.le _ _))
    (mul_self_nonneg _)

/-- Cauchy-Schwarz for `Θ^{(1)}` in AM-GM form. -/
theorem abs_theta1_abba_le (α β : ℕ) (𝒬 : Finset DyRect) {lam : ℝ} (hlam : 0 < lam) (r : ℝ)
    {a b : ℝ × ℝ → ℝ} (ha : Measurable a) (hb : Measurable b) {M : ℝ} (hba : ∀ z, |a z| ≤ M)
    (hbb : ∀ z, |b z| ≤ M) {ε : ℝ} (hε : 0 < ε) :
    |theta1 α β 𝒬 lam r a b b a| ≤
      2⁻¹ * (ε * theta1 α β 𝒬 lam r a a a a + ε⁻¹ * theta1 α β 𝒬 lam r b b b b) := by
  have hg := continuous_gaussian'
  have hh := Auto.Twisted.continuous_gaussianDeriv
  have ig := Auto.Twisted.integrable_gaussian
  have ih := Auto.Twisted.integrable_gaussianDeriv
  unfold theta1 collInt
  simp only [scalarH_eq_kernelAt, scalarG_eq_kernelAt]
  rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib, Finset.mul_sum]
  refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun Q _ => ?_)
  have U := cellOK_theta (α := α) (β := β) (Q := Q) ha hb hb ha hba hbb hbb hba hh hg ih ig
    (r := r) hlam
  have V₁ := cellOK_theta (α := α) (β := β) (Q := Q) ha ha ha ha hba hba hba hba hh hg ih ig
    (r := r) hlam
  have V₂ := cellOK_theta (α := α) (β := β) (Q := Q) hb hb hb hb hbb hbb hbb hbb hh hg ih ig
    (r := r) hlam
  refine (abs_cellInt_le U).trans ?_
  rw [← cellInt_const_mul, ← cellInt_const_mul, ← cellInt_add (cellOK_const_mul _ V₁)
    (cellOK_const_mul _ V₂), ← cellInt_const_mul]
  refine cellInt_mono (cellOK_abs U)
    (cellOK_const_mul _ (cellOK_add (cellOK_const_mul _ V₁) (cellOK_const_mul _ V₂)))
    fun z hz => ?_
  have ht := pos_of_mem_cellSet hz
  have hs : 0 < lam * z.1 ^ α := by positivity
  have hs' : 0 < 1 * z.1 ^ β := by positivity
  have h := abs_quadForm_abba_le ha hb hba hbb
    (measurable_kernelAt hh.measurable (lam * z.1 ^ α) (z.2.1 + 0 * z.1 ^ α))
    (measurable_kernelAt hg.measurable (1 * z.1 ^ β) (z.2.2 + r * z.1 ^ β))
    (measurable_kernelAt hg.measurable (1 * z.1 ^ β) (z.2.2 + r * z.1 ^ β))
    (integrable_kernelAt ih hs _) (integrable_kernelAt ig hs' _) (integrable_kernelAt ig hs' _)
    (fun y y' => mul_nonneg (gaussianAt_nonneg' hs'.le _ _) (gaussianAt_nonneg' hs'.le _ _)) hε
  linarith

/-- `X ≤ (εP + ε⁻¹R)/2` for all `ε > 0` implies `X ≤ √(PR)`. -/
theorem le_sqrt_of_forall_amgm {X P R : ℝ} (hP : 0 ≤ P) (hR : 0 ≤ R)
    (h : ∀ ε : ℝ, 0 < ε → X ≤ 2⁻¹ * (ε * P + ε⁻¹ * R)) : X ≤ Real.sqrt (P * R) := by
  by_cases hX : X ≤ 0
  · exact hX.trans (Real.sqrt_nonneg _)
  push Not at hX
  rcases hP.lt_or_eq with hP' | hP'
  · rcases hR.lt_or_eq with hR' | hR'
    · have hε : 0 < Real.sqrt (R / P) := Real.sqrt_pos.2 (div_pos hR' hP')
      have h1 := h _ hε
      have e1 : Real.sqrt (R / P) * P = Real.sqrt (P * R) := by
        rw [show P * R = (R / P) * (P * P) by field_simp, Real.sqrt_mul (div_pos hR' hP').le,
          Real.sqrt_mul_self hP'.le]
      have e2 : (Real.sqrt (R / P))⁻¹ * R = Real.sqrt (P * R) := by
        rw [← Real.sqrt_inv, inv_div, show P * R = (P / R) * (R * R) by field_simp,
          Real.sqrt_mul (div_pos hP' hR').le, Real.sqrt_mul_self hR'.le]
      rw [e1, e2] at h1; linarith
    · exfalso
      have h1 := h (X / P) (div_pos hX hP')
      rw [← hR', mul_zero, add_zero, div_mul_cancel₀ _ hP'.ne'] at h1
      linarith
  · exfalso
    rcases hR.lt_or_eq with hR' | hR'
    · have h1 := h (2 * R / X) (by positivity)
      have e : (2 * R / X)⁻¹ * R = X / 2 := by field_simp
      rw [← hP', mul_zero, zero_add, e] at h1
      linarith
    · have h1 := h 1 one_pos
      rw [← hP', ← hR'] at h1; simp at h1; linarith

/-- **The bound for `Θ^{(2)}(a,b,b,a)`** from the telescoping bound, Cauchy-Schwarz and
positivity (the argument of §4.2 after `eqn:dominatebygaussians`). -/
theorem theta2_abba_le {α β : ℕ} (hα : 0 < α) (hβ : 0 < β) {C₀ : ℝ} {N₀ : ℕ} (hC₀ : 0 ≤ C₀)
    (htel : ∀ (T : DyTree α β) (lam r : ℝ), 1 ≤ lam →
      ∀ (f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ), Measurable f₁ → Measurable f₂ → Measurable f₃ →
        Measurable f₄ → ∀ M : ℝ, (∀ z, |f₁ z| ≤ M) → (∀ z, |f₂ z| ≤ M) → (∀ z, |f₃ z| ≤ M) →
        (∀ z, |f₄ z| ≤ M) →
        |(α : ℝ) * theta1 α β T.rects lam r f₁ f₂ f₃ f₄ +
            (β : ℝ) * theta2 α β T.rects lam r f₁ f₂ f₃ f₄| ≤
          C₀ * (lam * (1 + |r|)) ^ N₀ * T.root.area α β *
            (Msize α β T.rects f₁ * Msize α β T.rects f₂ * Msize α β T.rects f₃ *
              Msize α β T.rects f₄))
    (T : DyTree α β) {lam : ℝ} (hlam : 1 ≤ lam) (r : ℝ) {a b : ℝ × ℝ → ℝ}
    (ha : Measurable a) (hb : Measurable b) {M : ℝ} (hba : ∀ z, |a z| ≤ M)
    (hbb : ∀ z, |b z| ≤ M) :
    theta2 α β T.rects lam r a b b a ≤ 2 * C₀ / β * (lam * (1 + |r|)) ^ N₀ * T.root.area α β *
      (Msize α β T.rects a ^ 2 * Msize α β T.rects b ^ 2) := by
  have hlam0 : 0 < lam := lt_of_lt_of_le one_pos hlam
  have hαr : (0 : ℝ) < α := by exact_mod_cast hα
  have hβr : (0 : ℝ) < β := by exact_mod_cast hβ
  set L := C₀ * (lam * (1 + |r|)) ^ N₀ * T.root.area α β with hL
  have hL0 : 0 ≤ L := by
    have := T.root.area_pos α β
    have : 0 ≤ lam * (1 + |r|) := by positivity
    positivity
  set Ma := Msize α β T.rects a
  set Mb := Msize α β T.rects b
  have hMa : 0 ≤ Ma := Msize_nonneg α β _ _
  have hMb : 0 ≤ Mb := Msize_nonneg α β _ _
  -- the diagonal bounds
  have hdiag : ∀ (f : ℝ × ℝ → ℝ), Measurable f → (∀ z, |f z| ≤ M) →
      theta1 α β T.rects lam r f f f f ≤ L / α * Msize α β T.rects f ^ 4 := by
    intro f hf hfb
    have h := htel T lam r hlam f f f f hf hf hf hf M hfb hfb hfb hfb
    have h2 := theta2_abba_nonneg α β T.rects hlam0.le r f f
    rw [div_mul_eq_mul_div, le_div_iff₀ hαr]
    have := (le_abs_self _).trans h
    rw [← hL] at this
    nlinarith [Msize_nonneg α β T.rects f]
  have hA := hdiag a ha hba
  have hB := hdiag b hb hbb
  -- Cauchy-Schwarz
  have hCS : |theta1 α β T.rects lam r a b b a| ≤ L / α * (Ma ^ 2 * Mb ^ 2) := by
    have h := le_sqrt_of_forall_amgm (X := |theta1 α β T.rects lam r a b b a|)
      (P := L / α * Ma ^ 4) (R := L / α * Mb ^ 4) (by positivity) (by positivity)
      fun ε hε => (abs_theta1_abba_le α β T.rects hlam0 r ha hb hba hbb hε).trans
        (by gcongr)
    refine h.trans (le_of_eq ?_)
    rw [show L / α * Ma ^ 4 * (L / α * Mb ^ 4) = (L / α * (Ma ^ 2 * Mb ^ 2)) ^ 2 by ring,
      Real.sqrt_sq (by positivity)]
  have h := htel T lam r hlam a b b a ha hb hb ha M hba hbb hbb hba
  rw [← hL] at h
  set θ1 := theta1 α β T.rects lam r a b b a
  set θ2 := theta2 α β T.rects lam r a b b a
  have h1 : (α : ℝ) * θ1 + β * θ2 ≤ L * (Ma ^ 2 * Mb ^ 2) := by
    refine (le_abs_self _).trans (h.trans (le_of_eq ?_)); ring
  have h2 : -((α : ℝ) * θ1) ≤ α * (L / α * (Ma ^ 2 * Mb ^ 2)) := by
    have := neg_abs_le θ1
    nlinarith [hCS]
  have h3 : (α : ℝ) * (L / α * (Ma ^ 2 * Mb ^ 2)) = L * (Ma ^ 2 * Mb ^ 2) := by
    field_simp
  have key : (β : ℝ) * θ2 ≤ 2 * L * (Ma ^ 2 * Mb ^ 2) := by linarith
  rw [show 2 * C₀ / β * (lam * (1 + |r|)) ^ N₀ * T.root.area α β * (Ma ^ 2 * Mb ^ 2) =
    2 * L * (Ma ^ 2 * Mb ^ 2) / β by rw [hL]; ring, le_div_iff₀ hβr]
  linarith

/-! ### The pointwise Cauchy-Schwarz step -/

/-- The kernel `h * Ψ`. -/
def hconv (Ψ : ℝ → ℝ) (y : ℝ) : ℝ := ∫ r, gaussianDeriv (y - r) * Ψ r

/-- `(h * Ψ)_{σ,q}(y') = ∫ Ψ(r) h_{σ, q + σ r}(y') dr`. -/
theorem kernelAt_hconv {σ : ℝ} (hσ : 0 < σ) (Ψ : ℝ → ℝ) (q y' : ℝ) :
    kernelAt (hconv Ψ) σ q y' = ∫ r, Ψ r * kernelAt gaussianDeriv σ (q + σ * r) y' := by
  rw [kernelAt_real_eq, hconv, ← integral_const_mul]
  congr 1; funext r
  rw [kernelAt_real_eq]
  have : (y' - q) / σ - r = (y' - (q + σ * r)) / σ := by field_simp; ring
  rw [this]; ring

/-- `A(x,x') = ∫ f_1(x',y) f_3(x,y) h_{σ,q}(y) dy`. -/
def aForm (f₁ f₃ : ℝ × ℝ → ℝ) (σ q : ℝ) (x x' : ℝ) : ℝ :=
  ∫ y, f₁ (x', y) * f₃ (x, y) * kernelAt gaussianDeriv σ q y

/-- `B_r(x,x') = ∫ f_2(x,y') f_4(x',y') h_{σ,q+σr}(y') dy'`. -/
def bForm (f₂ f₄ : ℝ × ℝ → ℝ) (σ q r : ℝ) (x x' : ℝ) : ℝ :=
  ∫ y', f₂ (x, y') * f₄ (x', y') * kernelAt gaussianDeriv σ (q + σ * r) y'

theorem abs_aForm_le {f₁ f₃ : ℝ × ℝ → ℝ} {M : ℝ} (hb₁ : ∀ z, |f₁ z| ≤ M)
    (hb₃ : ∀ z, |f₃ z| ≤ M) {σ : ℝ} (hσ : 0 < σ) (q x x' : ℝ) :
    |aForm f₁ f₃ σ q x x'| ≤ M ^ 2 * ∫ y, |gaussianDeriv y| := by
  have hM : 0 ≤ M := (abs_nonneg _).trans (hb₁ 0)
  unfold aForm
  refine (abs_integral_le_integral_abs).trans ?_
  rw [← integral_abs_kernelAt gaussianDeriv hσ q, ← integral_const_mul]
  refine integral_mono_of_nonneg (Eventually.of_forall fun y => abs_nonneg _)
    ((integrable_kernelAt Auto.Twisted.integrable_gaussianDeriv hσ q).abs.const_mul _)
    (Eventually.of_forall fun y => ?_)
  simp only [abs_mul]
  calc |f₁ (x', y)| * |f₃ (x, y)| * |kernelAt gaussianDeriv σ q y| ≤
      M * M * |kernelAt gaussianDeriv σ q y| :=
        mul_le_mul_of_nonneg_right (mul_le_mul (hb₁ _) (hb₃ _) (abs_nonneg _) hM) (abs_nonneg _)
    _ = _ := by ring

/-- The `y'`-integral against `(h * Ψ)_{σ,q}` as a superposition of the `B_r` (Fubini). -/
theorem integral_hconv_eq {f₂ f₄ : ℝ × ℝ → ℝ} (h₂ : Measurable f₂) (h₄ : Measurable f₄)
    {M : ℝ} (hb₂ : ∀ z, |f₂ z| ≤ M) (hb₄ : ∀ z, |f₄ z| ≤ M) {Ψ : ℝ → ℝ} (hΨ : Continuous Ψ)
    (iΨ : Integrable Ψ) {σ : ℝ} (hσ : 0 < σ) (q x x' : ℝ) :
    ∫ y', f₂ (x, y') * f₄ (x', y') * kernelAt (hconv Ψ) σ q y' =
      ∫ r, Ψ r * bForm f₂ f₄ σ q r x x' := by
  have hM : 0 ≤ M := (abs_nonneg _).trans (hb₂ 0)
  set H : ℝ × ℝ → ℝ := fun v => f₂ (x, v.1) * f₄ (x', v.1) *
    (Ψ v.2 * kernelAt gaussianDeriv σ (q + σ * v.2) v.1) with hH
  have hHm : Measurable H := by
    simp only [hH, kernelAt_real_eq]
    have hh := Auto.Twisted.continuous_gaussianDeriv.measurable
    refine ((h₂.comp (measurable_const.prodMk measurable_fst)).mul
      (h₄.comp (measurable_const.prodMk measurable_fst))).mul
      ((hΨ.measurable.comp measurable_snd).mul (measurable_const.mul (hh.comp ?_)))
    exact (measurable_fst.sub (measurable_const.add
      (measurable_const.mul measurable_snd))).div_const σ
  have hI : Integrable H (volume.prod volume) := by
    refine (integrable_prod_iff' hHm.aestronglyMeasurable).2 ⟨Eventually.of_forall fun r => ?_, ?_⟩
    · have hk := integrable_kernelAt Auto.Twisted.integrable_gaussianDeriv hσ (q + σ * r)
      refine (hk.abs.const_mul (M * M * |Ψ r|)).mono' (hHm.comp (measurable_id.prodMk
        measurable_const)).aestronglyMeasurable (Eventually.of_forall fun y' => ?_)
      simp only [hH, Real.norm_eq_abs, abs_mul]
      calc |f₂ (x, y')| * |f₄ (x', y')| * (|Ψ r| * |kernelAt gaussianDeriv σ (q + σ * r) y'|)
          ≤ M * M * (|Ψ r| * |kernelAt gaussianDeriv σ (q + σ * r) y'|) :=
            mul_le_mul_of_nonneg_right (mul_le_mul (hb₂ _) (hb₄ _) (abs_nonneg _) hM)
              (by positivity)
        _ = _ := by ring
    · refine (iΨ.abs.const_mul (M * M * ∫ y, |gaussianDeriv y|)).mono'
        ?_ (Eventually.of_forall fun r => ?_)
      · exact (measurable_integral_param (G := fun r y' => ‖H (y', r)‖)
          ((hHm.comp measurable_swap).norm)).aestronglyMeasurable
      · rw [Real.norm_eq_abs, abs_of_nonneg (integral_nonneg fun _ => norm_nonneg _)]
        have hk := integrable_kernelAt Auto.Twisted.integrable_gaussianDeriv hσ (q + σ * r)
        calc ∫ y', ‖H (y', r)‖ ≤ ∫ y', M * M * |Ψ r| * |kernelAt gaussianDeriv σ (q + σ * r) y'| :=
              integral_mono_of_nonneg (Eventually.of_forall fun _ => norm_nonneg _)
                (hk.abs.const_mul _) (Eventually.of_forall fun y' => by
                  simp only [hH, Real.norm_eq_abs, abs_mul]
                  calc |f₂ (x, y')| * |f₄ (x', y')| * (|Ψ r| *
                        |kernelAt gaussianDeriv σ (q + σ * r) y'|) ≤ M * M * (|Ψ r| *
                        |kernelAt gaussianDeriv σ (q + σ * r) y'|) :=
                        mul_le_mul_of_nonneg_right (mul_le_mul (hb₂ _) (hb₄ _) (abs_nonneg _) hM)
                          (by positivity)
                    _ = _ := by ring)
          _ = M * M * |Ψ r| * ∫ y, |gaussianDeriv y| := by
              rw [integral_const_mul, integral_abs_kernelAt gaussianDeriv hσ]
          _ = _ := by ring
  have e1 : ∀ y', f₂ (x, y') * f₄ (x', y') * kernelAt (hconv Ψ) σ q y' = ∫ r, H (y', r) := by
    intro y'
    rw [kernelAt_hconv hσ, ← integral_const_mul]
  simp_rw [e1]
  rw [integral_integral_swap (f := fun y' r => H (y', r)) hI]
  refine integral_congr_ae (Eventually.of_forall fun r => ?_)
  simp only [hH, bForm]
  rw [← integral_const_mul]
  congr 1; funext y'; ring

theorem measurable_aForm {f₁ f₃ : ℝ × ℝ → ℝ} (h₁ : Measurable f₁) (h₃ : Measurable f₃)
    (σ q : ℝ) : Measurable fun v : ℝ × ℝ => aForm f₁ f₃ σ q v.1 v.2 := by
  unfold aForm
  refine measurable_integral_param
    (G := fun (v : ℝ × ℝ) y => f₁ (v.2, y) * f₃ (v.1, y) * kernelAt gaussianDeriv σ q y) ?_
  exact ((h₁.comp (measurable_fst.snd.prodMk measurable_snd)).mul
    (h₃.comp (measurable_fst.fst.prodMk measurable_snd))).mul
    ((measurable_kernelAt Auto.Twisted.continuous_gaussianDeriv.measurable σ q).comp
      measurable_snd)

theorem measurable_bForm {f₂ f₄ : ℝ × ℝ → ℝ} (h₂ : Measurable f₂) (h₄ : Measurable f₄)
    (σ q : ℝ) : Measurable fun w : ℝ × ℝ × ℝ => bForm f₂ f₄ σ q w.1 w.2.1 w.2.2 := by
  unfold bForm
  refine measurable_integral_param (G := fun (w : ℝ × ℝ × ℝ) y' =>
    f₂ (w.2.1, y') * f₄ (w.2.2, y') * kernelAt gaussianDeriv σ (q + σ * w.1) y') ?_
  refine ((h₂.comp (measurable_fst.snd.fst.prodMk measurable_snd)).mul
    (h₄.comp (measurable_fst.snd.snd.prodMk measurable_snd))).mul ?_
  exact measurable_kernelAt_param (W := ℝ × ℝ × ℝ) (k := gaussianDeriv)
    Auto.Twisted.continuous_gaussianDeriv.measurable (a := fun _ => σ)
    (b := fun w => q + σ * w.1) measurable_const (by fun_prop) |>.comp
      (measurable_fst.prodMk measurable_snd)

theorem enorm_mul_le_amgm (A B : ℝ) {ε : ℝ} (hε : 0 < ε) :
    ‖A‖ₑ * ‖B‖ₑ ≤ ENNReal.ofReal (2⁻¹ * ε) * ENNReal.ofReal (A ^ 2) +
      ENNReal.ofReal (2⁻¹ * ε⁻¹) * ENNReal.ofReal (B ^ 2) := by
  rw [← ofReal_norm, ← ofReal_norm, ← ENNReal.ofReal_mul (norm_nonneg _),
    ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity),
    ← ENNReal.ofReal_add (by positivity) (by positivity)]
  refine ENNReal.ofReal_le_ofReal ?_
  rw [Real.norm_eq_abs, Real.norm_eq_abs]
  have h1 : 0 ≤ (Real.sqrt ε * |A| - Real.sqrt ε⁻¹ * |B|) ^ 2 := sq_nonneg _
  have hs1 : Real.sqrt ε * Real.sqrt ε = ε := Real.mul_self_sqrt hε.le
  have hs2 : Real.sqrt ε⁻¹ * Real.sqrt ε⁻¹ = ε⁻¹ := Real.mul_self_sqrt (inv_nonneg.2 hε.le)
  have hs3 : Real.sqrt ε * Real.sqrt ε⁻¹ = 1 := by
    rw [← Real.sqrt_mul hε.le, mul_inv_cancel₀ hε.ne', Real.sqrt_one]
  have hexp : (Real.sqrt ε * |A| - Real.sqrt ε⁻¹ * |B|) ^ 2 =
      ε * A ^ 2 - 2 * (|A| * |B|) + ε⁻¹ * B ^ 2 := by
    calc (Real.sqrt ε * |A| - Real.sqrt ε⁻¹ * |B|) ^ 2
        = (Real.sqrt ε * Real.sqrt ε) * |A| ^ 2 - 2 * (Real.sqrt ε * Real.sqrt ε⁻¹) * (|A| * |B|) +
            (Real.sqrt ε⁻¹ * Real.sqrt ε⁻¹) * |B| ^ 2 := by ring
      _ = _ := by rw [hs1, hs2, hs3, sq_abs, sq_abs]; ring
  nlinarith

/-- Splitting a double lower integral of a pointwise sum. -/
theorem lintegral_lintegral_add_le {F : ℝ → ℝ → ℝ≥0∞} {F₁ F₂ : ℝ → ℝ → ℝ≥0∞} (c₁ c₂ : ℝ≥0∞)
    (hF₁ : Measurable fun v : ℝ × ℝ => F₁ v.1 v.2) (hF₂ : Measurable fun v : ℝ × ℝ => F₂ v.1 v.2)
    (h : ∀ x x', F x x' ≤ c₁ * F₁ x x' + c₂ * F₂ x x') :
    ∫⁻ x, ∫⁻ x', F x x' ≤ c₁ * (∫⁻ x, ∫⁻ x', F₁ x x') + c₂ * ∫⁻ x, ∫⁻ x', F₂ x x' := by
  have i1 : ∀ x, Measurable fun x' => F₁ x x' := fun x => hF₁.comp measurable_prodMk_left
  have i2 : ∀ x, Measurable fun x' => F₂ x x' := fun x => hF₂.comp measurable_prodMk_left
  have o1 : Measurable fun x => ∫⁻ x', F₁ x x' := hF₁.lintegral_prod_right'
  have o2 : Measurable fun x => ∫⁻ x', F₂ x x' := hF₂.lintegral_prod_right'
  have inner : ∀ x, ∫⁻ x', F x x' ≤ c₁ * (∫⁻ x', F₁ x x') + c₂ * ∫⁻ x', F₂ x x' := fun x => by
    calc ∫⁻ x', F x x' ≤ ∫⁻ x', (c₁ * F₁ x x' + c₂ * F₂ x x') := lintegral_mono (h x)
      _ = (∫⁻ x', c₁ * F₁ x x') + ∫⁻ x', c₂ * F₂ x x' :=
          lintegral_add_left ((i1 x).const_mul c₁) _
      _ = _ := by
          congr 1
          · exact lintegral_const_mul c₁ (i1 x)
          · exact lintegral_const_mul c₂ (i2 x)
  calc ∫⁻ x, ∫⁻ x', F x x' ≤ ∫⁻ x, (c₁ * (∫⁻ x', F₁ x x') + c₂ * ∫⁻ x', F₂ x x') :=
        lintegral_mono inner
    _ = (∫⁻ x, c₁ * ∫⁻ x', F₁ x x') + ∫⁻ x, c₂ * ∫⁻ x', F₂ x x' :=
        lintegral_add_left (o1.const_mul c₁) _
    _ = _ := by
        congr 1
        · exact lintegral_const_mul c₁ o1
        · exact lintegral_const_mul c₂ o2

/-- The pointwise integrand bound behind `aftercs1`, `aftercs2`. -/
theorem enorm_factor_integrand_le {f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ} (h₂ : Measurable f₂)
    (h₄ : Measurable f₄) {M : ℝ} (hb₂ : ∀ z, |f₂ z| ≤ M) (hb₄ : ∀ z, |f₄ z| ≤ M)
    {Φ Ψ : ℝ → ℝ} (hΨ : Continuous Ψ) (iΨ : Integrable Ψ) {s σ : ℝ} (hs : 0 < s) (hσ : 0 < σ)
    (p q : ℝ) {ε : ℝ} (hε : 0 < ε) (x x' : ℝ) :
    ‖kernelAt gaussian s p x * kernelAt Φ s p x' *
      ((∫ y, f₁ (x', y) * f₃ (x, y) * kernelAt gaussianDeriv σ q y) *
        (∫ y', f₂ (x, y') * f₄ (x', y') * kernelAt (hconv Ψ) σ q y'))‖ₑ ≤
      (ENNReal.ofReal (2⁻¹ * ε) * (∫⁻ r, ‖Ψ r‖ₑ)) *
          (ENNReal.ofReal (kernelAt gaussian s p x * |kernelAt Φ s p x'|) *
            ENNReal.ofReal (aForm f₁ f₃ σ q x x' ^ 2)) +
        ENNReal.ofReal (2⁻¹ * ε⁻¹) *
          (ENNReal.ofReal (kernelAt gaussian s p x * |kernelAt Φ s p x'|) *
            ∫⁻ r, ‖Ψ r‖ₑ * ENNReal.ofReal (bForm f₂ f₄ σ q r x x' ^ 2)) := by
  have hBm := measurable_bForm h₂ h₄ σ q
  rw [integral_hconv_eq h₂ h₄ hb₂ hb₄ hΨ iΨ hσ q x x']
  change ‖kernelAt gaussian s p x * kernelAt Φ s p x' *
    (aForm f₁ f₃ σ q x x' * ∫ r, Ψ r * bForm f₂ f₄ σ q r x x')‖ₑ ≤ _
  rw [enorm_mul (kernelAt gaussian s p x * kernelAt Φ s p x'),
    enorm_mul (aForm f₁ f₃ σ q x x')]
  have hg : ‖kernelAt gaussian s p x * kernelAt Φ s p x'‖ₑ =
      ENNReal.ofReal (kernelAt gaussian s p x * |kernelAt Φ s p x'|) := by
    rw [← ofReal_norm, Real.norm_eq_abs, abs_mul,
      abs_of_nonneg (show 0 ≤ kernelAt gaussian s p x from gaussianAt_nonneg' hs.le p x)]
  rw [hg]
  have hB : ‖∫ r, Ψ r * bForm f₂ f₄ σ q r x x'‖ₑ ≤
      ∫⁻ r, ‖Ψ r‖ₑ * ‖bForm f₂ f₄ σ q r x x'‖ₑ := by
    refine (enorm_integral_le_lintegral_enorm _).trans (le_of_eq ?_)
    exact lintegral_congr fun r => enorm_mul _ _
  set a₀ := ENNReal.ofReal (2⁻¹ * ε) * ENNReal.ofReal (aForm f₁ f₃ σ q x x' ^ 2)
  set c₂ := ENNReal.ofReal (2⁻¹ * ε⁻¹)
  have hBr : Measurable fun r => ‖Ψ r‖ₑ * ENNReal.ofReal (bForm f₂ f₄ σ q r x x' ^ 2) :=
    (hΨ.measurable.enorm).mul (ENNReal.measurable_ofReal.comp
      ((hBm.comp (measurable_id.prodMk (measurable_const (a := (x, x'))))).pow_const 2))
  have hAB : ‖aForm f₁ f₃ σ q x x'‖ₑ * ∫⁻ r, ‖Ψ r‖ₑ * ‖bForm f₂ f₄ σ q r x x'‖ₑ ≤
      a₀ * (∫⁻ r, ‖Ψ r‖ₑ) + c₂ * ∫⁻ r, ‖Ψ r‖ₑ * ENNReal.ofReal (bForm f₂ f₄ σ q r x x' ^ 2) := by
    have e1 : a₀ * (∫⁻ r, ‖Ψ r‖ₑ) + c₂ * ∫⁻ r, ‖Ψ r‖ₑ *
        ENNReal.ofReal (bForm f₂ f₄ σ q r x x' ^ 2) = ∫⁻ r, (a₀ * ‖Ψ r‖ₑ + c₂ * (‖Ψ r‖ₑ *
          ENNReal.ofReal (bForm f₂ f₄ σ q r x x' ^ 2))) := by
      rw [lintegral_add_left (hΨ.measurable.enorm.const_mul a₀)]
      congr 1
      · exact (lintegral_const_mul a₀ hΨ.measurable.enorm).symm
      · exact (lintegral_const_mul c₂ hBr).symm
    rw [e1, ← lintegral_const_mul' _ _ enorm_ne_top]
    refine lintegral_mono fun r => ?_
    have := enorm_mul_le_amgm (aForm f₁ f₃ σ q x x') (bForm f₂ f₄ σ q r x x') hε
    calc ‖aForm f₁ f₃ σ q x x'‖ₑ * (‖Ψ r‖ₑ * ‖bForm f₂ f₄ σ q r x x'‖ₑ)
        = ‖Ψ r‖ₑ * (‖aForm f₁ f₃ σ q x x'‖ₑ * ‖bForm f₂ f₄ σ q r x x'‖ₑ) := by ring
      _ ≤ ‖Ψ r‖ₑ * (a₀ + c₂ * ENNReal.ofReal (bForm f₂ f₄ σ q r x x' ^ 2)) := by gcongr
      _ = _ := by ring
  calc ENNReal.ofReal (kernelAt gaussian s p x * |kernelAt Φ s p x'|) *
        (‖aForm f₁ f₃ σ q x x'‖ₑ * ‖∫ r, Ψ r * bForm f₂ f₄ σ q r x x'‖ₑ)
      ≤ ENNReal.ofReal (kernelAt gaussian s p x * |kernelAt Φ s p x'|) *
        (a₀ * (∫⁻ r, ‖Ψ r‖ₑ) + c₂ * ∫⁻ r, ‖Ψ r‖ₑ *
          ENNReal.ofReal (bForm f₂ f₄ σ q r x x' ^ 2)) := by
        gcongr
        calc ‖aForm f₁ f₃ σ q x x'‖ₑ * ‖∫ r, Ψ r * bForm f₂ f₄ σ q r x x'‖ₑ
            ≤ ‖aForm f₁ f₃ σ q x x'‖ₑ * ∫⁻ r, ‖Ψ r‖ₑ * ‖bForm f₂ f₄ σ q r x x'‖ₑ := by gcongr
          _ ≤ _ := hAB
    _ = _ := by simp only [a₀]; ring

/-- The pointwise Cauchy-Schwarz step of §4.2 (`aftercs1`, `aftercs2`), in AM-GM form. -/
theorem enorm_quadForm_le_split {f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ} (h₁ : Measurable f₁)
    (h₂ : Measurable f₂) (h₃ : Measurable f₃) (h₄ : Measurable f₄) {M : ℝ}
    (hb₂ : ∀ z, |f₂ z| ≤ M) (hb₄ : ∀ z, |f₄ z| ≤ M)
    {Φ Ψ : ℝ → ℝ} (hΦ : Continuous Φ) (hΨ : Continuous Ψ) (iΨ : Integrable Ψ)
    {s σ : ℝ} (hs : 0 < s) (hσ : 0 < σ) (p q : ℝ) {ε : ℝ} (hε : 0 < ε) :
    ‖quadForm f₁ f₂ f₃ f₄ (kernelAt gaussian s p) (kernelAt Φ s p) (kernelAt gaussianDeriv σ q)
        (kernelAt (hconv Ψ) σ q)‖ₑ ≤
      (ENNReal.ofReal (2⁻¹ * ε) * (∫⁻ r, ‖Ψ r‖ₑ)) * (∫⁻ x, ∫⁻ x',
        ENNReal.ofReal (kernelAt gaussian s p x * |kernelAt Φ s p x'|) *
          ENNReal.ofReal (aForm f₁ f₃ σ q x x' ^ 2)) +
      ENNReal.ofReal (2⁻¹ * ε⁻¹) * ∫⁻ x, ∫⁻ x',
        ENNReal.ofReal (kernelAt gaussian s p x * |kernelAt Φ s p x'|) *
          ∫⁻ r, ‖Ψ r‖ₑ * ENNReal.ofReal (bForm f₂ f₄ σ q r x x' ^ 2) := by
  have hGm : Measurable fun v : ℝ × ℝ =>
      ENNReal.ofReal (kernelAt gaussian s p v.1 * |kernelAt Φ s p v.2|) :=
    ENNReal.measurable_ofReal.comp
      (((measurable_kernelAt continuous_gaussian'.measurable s p).comp measurable_fst).mul
        ((measurable_kernelAt hΦ.measurable s p).comp measurable_snd).abs)
  have hAm := measurable_aForm h₁ h₃ σ q
  have hBm := measurable_bForm h₂ h₄ σ q
  have hF₂m : Measurable fun v : ℝ × ℝ =>
      ENNReal.ofReal (kernelAt gaussian s p v.1 * |kernelAt Φ s p v.2|) *
        ∫⁻ r, ‖Ψ r‖ₑ * ENNReal.ofReal (bForm f₂ f₄ σ q r v.1 v.2 ^ 2) := by
    refine hGm.mul ?_
    have : Measurable fun w : (ℝ × ℝ) × ℝ =>
        ‖Ψ w.2‖ₑ * ENNReal.ofReal (bForm f₂ f₄ σ q w.2 w.1.1 w.1.2 ^ 2) :=
      (hΨ.measurable.comp measurable_snd).enorm.mul (ENNReal.measurable_ofReal.comp
        ((hBm.comp (measurable_snd.prodMk measurable_fst)).pow_const 2))
    exact this.lintegral_prod_right'
  rw [quadForm_eq_factor]
  refine (enorm_integral_le_lintegral_enorm _).trans ?_
  refine le_trans (lintegral_mono fun x => enorm_integral_le_lintegral_enorm _) ?_
  exact lintegral_lintegral_add_le _ _ (hGm.mul (ENNReal.measurable_ofReal.comp
    (hAm.pow_const 2))) hF₂m fun x x' =>
      enorm_factor_integrand_le h₂ h₄ hb₂ hb₄ hΨ iΨ hs hσ p q hε x x'

/-! ### From the `g|Φ|`-weighted squares to `Θ^{(2)}` -/

/-- `ofReal` of an iterated integral of a nonnegative function as an iterated lower integral. -/
theorem ofReal_integral_integral {G : ℝ → ℝ → ℝ} (h0 : ∀ x x', 0 ≤ G x x')
    (ix : ∀ x, Integrable fun x' => G x x') (hI : Integrable fun x => ∫ x', G x x') :
    ENNReal.ofReal (∫ x, ∫ x', G x x') = ∫⁻ x, ∫⁻ x', ENNReal.ofReal (G x x') := by
  rw [ofReal_integral_eq_lintegral_ofReal hI (Eventually.of_forall fun x =>
    integral_nonneg fun x' => h0 x x')]
  refine lintegral_congr fun x => ?_
  exact ofReal_integral_eq_lintegral_ofReal (ix x) (Eventually.of_forall fun x' => h0 x x')

/-- The `Θ^{(2)}(f_1,f_3,f_3,f_1)` cell integrand as `∫∫ g_{μ,p} g_{μ,p} A^2`. -/
theorem ofReal_quadForm_diag {f₁ f₃ : ℝ × ℝ → ℝ} (h₁ : Measurable f₁) (h₃ : Measurable f₃)
    {M : ℝ} (hb₁ : ∀ z, |f₁ z| ≤ M) (hb₃ : ∀ z, |f₃ z| ≤ M) {μs σ : ℝ} (hμ : 0 < μs)
    (hσ : 0 < σ) (p q : ℝ) :
    ENNReal.ofReal (quadForm f₁ f₃ f₃ f₁ (kernelAt gaussian μs p) (kernelAt gaussian μs p)
      (kernelAt gaussianDeriv σ q) (kernelAt gaussianDeriv σ q)) =
    ∫⁻ x, ∫⁻ x', ENNReal.ofReal (kernelAt gaussian μs p x * kernelAt gaussian μs p x') *
      ENNReal.ofReal (aForm f₁ f₃ σ q x x' ^ 2) := by
  set Bh := M ^ 2 * ∫ y, |gaussianDeriv y|
  have hk := continuous_gaussian'.measurable
  have ik : Integrable (kernelAt gaussian μs p) :=
    integrable_kernelAt Auto.Twisted.integrable_gaussian hμ p
  have k0 : ∀ x, 0 ≤ kernelAt gaussian μs p x := fun x => gaussianAt_nonneg' hμ.le p x
  have hA : ∀ x x', aForm f₁ f₃ σ q x x' ^ 2 ≤ Bh ^ 2 := fun x x' => by
    have := abs_aForm_le hb₁ hb₃ hσ q x x'
    rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) this 2
  have hAm := measurable_aForm h₁ h₃ σ q
  have hKm := measurable_kernelAt hk μs p
  rw [quadForm_eq_factor]
  have e : ∀ x x', kernelAt gaussian μs p x * kernelAt gaussian μs p x' *
      ((∫ y, f₁ (x', y) * f₃ (x, y) * kernelAt gaussianDeriv σ q y) *
        (∫ y', f₃ (x, y') * f₁ (x', y') * kernelAt gaussianDeriv σ q y')) =
      kernelAt gaussian μs p x * (kernelAt gaussian μs p x' * aForm f₁ f₃ σ q x x' ^ 2) := by
    intro x x'
    have : (∫ y', f₃ (x, y') * f₁ (x', y') * kernelAt gaussianDeriv σ q y') =
        aForm f₁ f₃ σ q x x' := by unfold aForm; congr 1; funext y; ring
    rw [this]; unfold aForm; ring
  simp_rw [e]
  have ix : ∀ x, Integrable fun x' =>
      kernelAt gaussian μs p x * (kernelAt gaussian μs p x' * aForm f₁ f₃ σ q x x' ^ 2) := by
    intro x
    refine Integrable.const_mul ?_ _
    refine (ik.mul_const (Bh ^ 2)).mono' ((hKm.mul ((hAm.comp measurable_prodMk_left).pow_const
      2)).aestronglyMeasurable) (Eventually.of_forall fun x' => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (k0 x') (sq_nonneg _))]
    exact mul_le_mul_of_nonneg_left (hA x x') (k0 x')
  have hI : Integrable fun x => ∫ x',
      kernelAt gaussian μs p x * (kernelAt gaussian μs p x' * aForm f₁ f₃ σ q x x' ^ 2) := by
    have hm : Measurable fun x => ∫ x',
        kernelAt gaussian μs p x * (kernelAt gaussian μs p x' * aForm f₁ f₃ σ q x x' ^ 2) :=
      measurable_integral_param (G := fun x x' =>
        kernelAt gaussian μs p x * (kernelAt gaussian μs p x' * aForm f₁ f₃ σ q x x' ^ 2))
        ((hKm.comp measurable_fst).mul ((hKm.comp measurable_snd).mul (hAm.pow_const 2)))
    refine (ik.mul_const ((∫ x', kernelAt gaussian μs p x') * Bh ^ 2)).mono'
      hm.aestronglyMeasurable (Eventually.of_forall fun x => ?_)
    rw [integral_const_mul, Real.norm_eq_abs, abs_mul, abs_of_nonneg (k0 x),
      abs_of_nonneg (integral_nonneg fun x' => mul_nonneg (k0 x') (sq_nonneg _))]
    refine mul_le_mul_of_nonneg_left ?_ (k0 x)
    rw [← integral_mul_const]
    exact integral_mono_of_nonneg (Eventually.of_forall fun x' => mul_nonneg (k0 x')
      (sq_nonneg _)) (ik.mul_const _) (Eventually.of_forall fun x' =>
        mul_le_mul_of_nonneg_left (hA x x') (k0 x'))
  rw [ofReal_integral_integral (fun x x' => mul_nonneg (k0 x) (mul_nonneg (k0 x')
    (sq_nonneg _))) ix hI]
  refine lintegral_congr fun x => lintegral_congr fun x' => ?_
  rw [← ENNReal.ofReal_mul (mul_nonneg (k0 x) (k0 x')), ← mul_assoc]

theorem bForm_eq_aForm (f₂ f₄ : ℝ × ℝ → ℝ) (σ q r x x' : ℝ) :
    bForm f₂ f₄ σ q r x x' = aForm f₄ f₂ σ (q + σ * r) x x' := by
  unfold bForm aForm; congr 1; funext y; ring

/-- Domination of the `g|Φ|`-weighted square by a superposition of `Θ^{(2)}` cell integrands. -/
theorem lintegral_weighted_sq_le {f₁ f₃ : ℝ × ℝ → ℝ} (h₁ : Measurable f₁)
    (h₃ : Measurable f₃) {M : ℝ} (hb₁ : ∀ z, |f₁ z| ≤ M) (hb₃ : ∀ z, |f₃ z| ≤ M) {N : ℕ}
    {Cd : ℝ} (hdom : ∀ (A : ℝ) (Φ : ℝ → ℝ),
      (∀ x, |Φ x| ≤ A * (1 + |x|) ^ (-(N : ℝ))) → ∀ (s : ℝ), 0 < s → ∀ p x x' : ℝ,
      ENNReal.ofReal (gaussianAt s p x * |kernelAt Φ s p x'|) ≤
        ENNReal.ofReal (Cd * A) * ∫⁻ lam in Ici (1 : ℝ), ENNReal.ofReal (lam ^ (-(N : ℝ) + 1) *
          (gaussianAt (lam * s) p x * gaussianAt (lam * s) p x')))
    {A : ℝ} {Φ : ℝ → ℝ} (hΦ : ∀ x, |Φ x| ≤ A * (1 + |x|) ^ (-(N : ℝ)))
    {s σ : ℝ} (hs : 0 < s) (hσ : 0 < σ) (p q : ℝ) :
    ∫⁻ x, ∫⁻ x', ENNReal.ofReal (kernelAt gaussian s p x * |kernelAt Φ s p x'|) *
        ENNReal.ofReal (aForm f₁ f₃ σ q x x' ^ 2) ≤
      ENNReal.ofReal (Cd * A) * ∫⁻ lam in Ici (1 : ℝ), ENNReal.ofReal (lam ^ (-(N : ℝ) + 1)) *
        ENNReal.ofReal (quadForm f₁ f₃ f₃ f₁ (kernelAt gaussian (lam * s) p)
          (kernelAt gaussian (lam * s) p) (kernelAt gaussianDeriv σ q)
          (kernelAt gaussianDeriv σ q)) := by
  have hk := continuous_gaussian'.measurable
  have hAm := measurable_aForm h₁ h₃ σ q
  set H : ℝ → ℝ → ℝ → ℝ≥0∞ := fun lam x x' => ENNReal.ofReal (lam ^ (-(N : ℝ) + 1) *
    (gaussianAt (lam * s) p x * gaussianAt (lam * s) p x')) *
      ENNReal.ofReal (aForm f₁ f₃ σ q x x' ^ 2) with hH
  have hHm : Measurable fun w : ℝ × ℝ × ℝ => H w.1 w.2.1 w.2.2 := by
    simp only [hH, gaussianAt_eq]
    refine ENNReal.measurable_ofReal.comp ?_ |>.mul
      (ENNReal.measurable_ofReal.comp ((hAm.comp measurable_snd).pow_const 2))
    refine (measurable_fst.pow_const _).mul ((((measurable_fst.mul measurable_const).inv).mul
      (hk.comp ((measurable_snd.fst.sub measurable_const).div
        (measurable_fst.mul measurable_const)))).mul
      (((measurable_fst.mul measurable_const).inv).mul
      (hk.comp ((measurable_snd.snd.sub measurable_const).div
        (measurable_fst.mul measurable_const)))))
  calc ∫⁻ x, ∫⁻ x', ENNReal.ofReal (kernelAt gaussian s p x * |kernelAt Φ s p x'|) *
        ENNReal.ofReal (aForm f₁ f₃ σ q x x' ^ 2)
      ≤ ∫⁻ x, ∫⁻ x', ENNReal.ofReal (Cd * A) * ∫⁻ lam in Ici (1 : ℝ), H lam x x' := by
        refine lintegral_mono fun x => lintegral_mono fun x' => ?_
        have h := hdom A Φ hΦ s hs p x x'
        calc ENNReal.ofReal (kernelAt gaussian s p x * |kernelAt Φ s p x'|) *
              ENNReal.ofReal (aForm f₁ f₃ σ q x x' ^ 2)
            ≤ (ENNReal.ofReal (Cd * A) * ∫⁻ lam in Ici (1 : ℝ), ENNReal.ofReal
                (lam ^ (-(N : ℝ) + 1) * (gaussianAt (lam * s) p x * gaussianAt (lam * s) p x'))) *
                ENNReal.ofReal (aForm f₁ f₃ σ q x x' ^ 2) := by gcongr; exact h
          _ = _ := by
              rw [mul_assoc, ← lintegral_mul_const' _ _ ENNReal.ofReal_ne_top]
    _ = ENNReal.ofReal (Cd * A) * ∫⁻ lam in Ici (1 : ℝ), ∫⁻ x, ∫⁻ x', H lam x x' := by
        simp_rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
        congr 1
        have s1 : ∀ x, ∫⁻ x', ∫⁻ lam in Ici (1 : ℝ), H lam x x' =
            ∫⁻ lam in Ici (1 : ℝ), ∫⁻ x', H lam x x' := fun x =>
          lintegral_lintegral_swap ((hHm.comp (measurable_snd.prodMk
            (measurable_const.prodMk measurable_fst))).aemeasurable)
        simp_rw [s1]
        have hm2 : Measurable fun w : ℝ × ℝ => ∫⁻ x', H w.2 w.1 x' :=
          (hHm.comp (measurable_fst.snd.prodMk (measurable_fst.fst.prodMk
            measurable_snd))).lintegral_prod_right'
        exact lintegral_lintegral_swap hm2.aemeasurable
    _ = _ := by
        congr 1
        refine setLIntegral_congr_fun measurableSet_Ici fun lam hl => ?_
        have hl0 : 0 < lam * s := mul_pos (lt_of_lt_of_le one_pos hl) hs
        rw [ofReal_quadForm_diag h₁ h₃ hb₁ hb₃ hl0 hσ p q, ← lintegral_const_mul' _ _
          ENNReal.ofReal_ne_top]
        refine lintegral_congr fun x => ?_
        rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
        refine lintegral_congr fun x' => ?_
        simp only [hH]
        rw [ENNReal.ofReal_mul (Real.rpow_nonneg (lt_of_lt_of_le one_pos hl).le _), mul_assoc]
        rfl

/-- The `B`-part: `∫∫ g|Φ| ∫ |Ψ(r)| B_r^2 ≤ C A ∫ |Ψ(r)| ∫_1^∞ λ^{-N+1} Θ^{(2)}_{cell,λ,r}`. -/
theorem lintegral_weighted_sqB_le {f₂ f₄ : ℝ × ℝ → ℝ} (h₂ : Measurable f₂)
    (h₄ : Measurable f₄) {M : ℝ} (hb₂ : ∀ z, |f₂ z| ≤ M) (hb₄ : ∀ z, |f₄ z| ≤ M) {N : ℕ}
    {Cd : ℝ} (hdom : ∀ (A : ℝ) (Φ : ℝ → ℝ),
      (∀ x, |Φ x| ≤ A * (1 + |x|) ^ (-(N : ℝ))) → ∀ (s : ℝ), 0 < s → ∀ p x x' : ℝ,
      ENNReal.ofReal (gaussianAt s p x * |kernelAt Φ s p x'|) ≤
        ENNReal.ofReal (Cd * A) * ∫⁻ lam in Ici (1 : ℝ), ENNReal.ofReal (lam ^ (-(N : ℝ) + 1) *
          (gaussianAt (lam * s) p x * gaussianAt (lam * s) p x')))
    {A : ℝ} {Φ Ψ : ℝ → ℝ} (hΦ : ∀ x, |Φ x| ≤ A * (1 + |x|) ^ (-(N : ℝ))) (hΦc : Continuous Φ)
    (hΨ : Continuous Ψ) {s σ : ℝ} (hs : 0 < s) (hσ : 0 < σ) (p q : ℝ) :
    ∫⁻ x, ∫⁻ x', ENNReal.ofReal (kernelAt gaussian s p x * |kernelAt Φ s p x'|) *
        ∫⁻ r, ‖Ψ r‖ₑ * ENNReal.ofReal (bForm f₂ f₄ σ q r x x' ^ 2) ≤
      ENNReal.ofReal (Cd * A) * ∫⁻ r, ‖Ψ r‖ₑ * ∫⁻ lam in Ici (1 : ℝ),
        ENNReal.ofReal (lam ^ (-(N : ℝ) + 1)) *
        ENNReal.ofReal (quadForm f₄ f₂ f₂ f₄ (kernelAt gaussian (lam * s) p)
          (kernelAt gaussian (lam * s) p) (kernelAt gaussianDeriv σ (q + σ * r))
          (kernelAt gaussianDeriv σ (q + σ * r))) := by
  have hGm : Measurable fun v : ℝ × ℝ =>
      ENNReal.ofReal (kernelAt gaussian s p v.1 * |kernelAt Φ s p v.2|) :=
    ENNReal.measurable_ofReal.comp
      (((measurable_kernelAt continuous_gaussian'.measurable s p).comp measurable_fst).mul
        ((measurable_kernelAt hΦc.measurable s p).comp measurable_snd).abs)
  have hBm := measurable_bForm h₂ h₄ σ q
  set H : ℝ → ℝ → ℝ → ℝ≥0∞ := fun r x x' =>
    ‖Ψ r‖ₑ * (ENNReal.ofReal (kernelAt gaussian s p x * |kernelAt Φ s p x'|) *
      ENNReal.ofReal (bForm f₂ f₄ σ q r x x' ^ 2)) with hH
  have hHm : Measurable fun w : ℝ × ℝ × ℝ => H w.1 w.2.1 w.2.2 :=
    (hΨ.measurable.comp measurable_fst).enorm.mul ((hGm.comp measurable_snd).mul
      (ENNReal.measurable_ofReal.comp (hBm.pow_const 2)))
  calc ∫⁻ x, ∫⁻ x', ENNReal.ofReal (kernelAt gaussian s p x * |kernelAt Φ s p x'|) *
        ∫⁻ r, ‖Ψ r‖ₑ * ENNReal.ofReal (bForm f₂ f₄ σ q r x x' ^ 2)
      = ∫⁻ x, ∫⁻ x', ∫⁻ r, H r x x' := by
        refine lintegral_congr fun x => lintegral_congr fun x' => ?_
        rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
        refine lintegral_congr fun r => ?_
        simp only [hH]; ring
    _ = ∫⁻ r, ∫⁻ x, ∫⁻ x', H r x x' := by
        have s1 : ∀ x, ∫⁻ x', ∫⁻ r, H r x x' = ∫⁻ r, ∫⁻ x', H r x x' := fun x =>
          lintegral_lintegral_swap ((hHm.comp (measurable_snd.prodMk
            (measurable_const.prodMk measurable_fst))).aemeasurable)
        simp_rw [s1]
        have hm2 : Measurable fun w : ℝ × ℝ => ∫⁻ x', H w.2 w.1 x' :=
          (hHm.comp (measurable_fst.snd.prodMk (measurable_fst.fst.prodMk
            measurable_snd))).lintegral_prod_right'
        exact lintegral_lintegral_swap hm2.aemeasurable
    _ ≤ ∫⁻ r, ‖Ψ r‖ₑ * (ENNReal.ofReal (Cd * A) * ∫⁻ lam in Ici (1 : ℝ),
          ENNReal.ofReal (lam ^ (-(N : ℝ) + 1)) *
          ENNReal.ofReal (quadForm f₄ f₂ f₂ f₄ (kernelAt gaussian (lam * s) p)
            (kernelAt gaussian (lam * s) p) (kernelAt gaussianDeriv σ (q + σ * r))
            (kernelAt gaussianDeriv σ (q + σ * r)))) := by
        refine lintegral_mono fun r => ?_
        have h := lintegral_weighted_sq_le h₄ h₂ hb₄ hb₂ hdom hΦ hs hσ p (q + σ * r)
        simp_rw [← bForm_eq_aForm] at h
        calc ∫⁻ x, ∫⁻ x', H r x x' = ‖Ψ r‖ₑ * ∫⁻ x, ∫⁻ x',
              ENNReal.ofReal (kernelAt gaussian s p x * |kernelAt Φ s p x'|) *
                ENNReal.ofReal (bForm f₂ f₄ σ q r x x' ^ 2) := by
              rw [← lintegral_const_mul' _ _ enorm_ne_top]
              refine lintegral_congr fun x => ?_
              rw [← lintegral_const_mul' _ _ enorm_ne_top]
          _ ≤ _ := by gcongr
    _ = _ := by
        rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
        refine lintegral_congr fun r => ?_
        ring

/-! ### Summation over the cells -/

theorem enorm_collInt_le (α β : ℕ) (𝒬 : Finset DyRect) (G : ℝ → ℝ → ℝ → ℝ) :
    ‖collInt α β 𝒬 G‖ₑ ≤ ∑ Q ∈ 𝒬, ∫⁻ t in Ioc (Q.len / 2) Q.len, ENNReal.ofReal t⁻¹ *
      ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, ‖G t p q‖ₑ := by
  unfold collInt
  refine (enorm_sum_le _ _).trans (Finset.sum_le_sum fun Q _ => enorm_cellInt_le α β Q G)

theorem ofReal_collInt {α β : ℕ} {𝒬 : Finset DyRect} {G : ℝ → ℝ → ℝ → ℝ}
    (hG : ∀ Q ∈ 𝒬, CellOK α β Q G) (h0 : ∀ Q ∈ 𝒬, ∀ z ∈ cellSet α β Q, 0 ≤ G z.1 z.2.1 z.2.2) :
    ENNReal.ofReal (collInt α β 𝒬 G) = ∑ Q ∈ 𝒬, ∫⁻ t in Ioc (Q.len / 2) Q.len,
      ENNReal.ofReal t⁻¹ * ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, ENNReal.ofReal (G t p q) := by
  unfold collInt
  rw [ENNReal.ofReal_sum_of_nonneg fun Q hQ => cellInt_nonneg (h0 Q hQ)]
  exact Finset.sum_congr rfl fun Q hQ => ofReal_cellInt (hG Q hQ) (h0 Q hQ)

/-- Tonelli: a parameter integral passes through a cell integral. -/
theorem cell_lintegral_swap (α β : ℕ) (Q : DyRect) (S : Set ℝ) {H : ℝ → ℝ → ℝ → ℝ → ℝ≥0∞}
    (hH : Measurable fun w : ℝ × ℝ × ℝ × ℝ => H w.1 w.2.1 w.2.2.1 w.2.2.2) :
    ∫⁻ t in Ioc (Q.len / 2) Q.len, ENNReal.ofReal t⁻¹ * ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β,
      ∫⁻ l in S, H l t p q =
    ∫⁻ l in S, ∫⁻ t in Ioc (Q.len / 2) Q.len, ENNReal.ofReal t⁻¹ * ∫⁻ p in Q.ix α,
      ∫⁻ q in Q.iy β, H l t p q := by
  have m1 : ∀ t p, Measurable fun w : ℝ × ℝ => H w.2 t p w.1 := fun t p =>
    hH.comp (measurable_snd.prodMk (measurable_const.prodMk (measurable_const.prodMk
      measurable_fst)))
  have e1 : ∀ t p, ∫⁻ q in Q.iy β, ∫⁻ l in S, H l t p q = ∫⁻ l in S, ∫⁻ q in Q.iy β, H l t p q :=
    fun t p => lintegral_lintegral_swap (f := fun q l => H l t p q) (m1 t p).aemeasurable
  simp_rw [e1]
  have m2 : ∀ t, Measurable fun w : ℝ × ℝ => ∫⁻ q in Q.iy β, H w.2 t w.1 q := fun t =>
    (hH.comp (measurable_fst.snd.prodMk (measurable_const.prodMk (measurable_fst.fst.prodMk
      measurable_snd)))).lintegral_prod_right'
  have e2 : ∀ t, ∫⁻ p in Q.ix α, ∫⁻ l in S, ∫⁻ q in Q.iy β, H l t p q =
      ∫⁻ l in S, ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, H l t p q :=
    fun t => lintegral_lintegral_swap (f := fun p l => ∫⁻ q in Q.iy β, H l t p q)
      (m2 t).aemeasurable
  simp_rw [e2]
  have m3 : Measurable fun w : ℝ × ℝ =>
      ENNReal.ofReal w.1⁻¹ * ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, H w.2 w.1 p q := by
    refine (ENNReal.measurable_ofReal.comp measurable_fst.inv).mul ?_
    have : Measurable fun u : (ℝ × ℝ) × ℝ => ∫⁻ q in Q.iy β, H u.1.2 u.1.1 u.2 q :=
      (hH.comp (measurable_fst.fst.snd.prodMk (measurable_fst.fst.fst.prodMk
        (measurable_fst.snd.prodMk measurable_snd)))).lintegral_prod_right'
    exact this.lintegral_prod_right'
  have e3 : ∀ t, ENNReal.ofReal t⁻¹ * ∫⁻ l in S, ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, H l t p q =
      ∫⁻ l in S, ENNReal.ofReal t⁻¹ * ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, H l t p q := fun t =>
    (lintegral_const_mul' _ _ ENNReal.ofReal_ne_top).symm
  simp_rw [e3]
  exact lintegral_lintegral_swap (f := fun t l =>
    ENNReal.ofReal t⁻¹ * ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, H l t p q) m3.aemeasurable

/-- Additivity of the cell lower integral. -/
theorem cell_lintegral_add (α β : ℕ) (Q : DyRect) {F₁ F₂ : ℝ → ℝ → ℝ → ℝ≥0∞} (c₁ c₂ : ℝ≥0∞)
    (h₁ : Measurable fun w : ℝ × ℝ × ℝ => F₁ w.1 w.2.1 w.2.2)
    (h₂ : Measurable fun w : ℝ × ℝ × ℝ => F₂ w.1 w.2.1 w.2.2) :
    ∫⁻ t in Ioc (Q.len / 2) Q.len, ENNReal.ofReal t⁻¹ * ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β,
      (c₁ * F₁ t p q + c₂ * F₂ t p q) =
    c₁ * (∫⁻ t in Ioc (Q.len / 2) Q.len, ENNReal.ofReal t⁻¹ * ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β,
      F₁ t p q) + c₂ * ∫⁻ t in Ioc (Q.len / 2) Q.len, ENNReal.ofReal t⁻¹ *
        ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, F₂ t p q := by
  have q1 : ∀ t p, Measurable fun q => F₁ t p q := fun t p =>
    h₁.comp (measurable_const.prodMk (measurable_const.prodMk measurable_id))
  have q2 : ∀ t p, Measurable fun q => F₂ t p q := fun t p =>
    h₂.comp (measurable_const.prodMk (measurable_const.prodMk measurable_id))
  have p1 : ∀ t, Measurable fun p => ∫⁻ q in Q.iy β, F₁ t p q := fun t =>
    (h₁.comp (measurable_const.prodMk (measurable_fst.prodMk measurable_snd))).lintegral_prod_right'
  have p2 : ∀ t, Measurable fun p => ∫⁻ q in Q.iy β, F₂ t p q := fun t =>
    (h₂.comp (measurable_const.prodMk (measurable_fst.prodMk measurable_snd))).lintegral_prod_right'
  have X1 : Measurable fun t => ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, F₁ t p q := by
    have : Measurable fun u : ℝ × ℝ => ∫⁻ q in Q.iy β, F₁ u.1 u.2 q :=
      (h₁.comp (measurable_fst.fst.prodMk (measurable_fst.snd.prodMk
        measurable_snd))).lintegral_prod_right'
    exact this.lintegral_prod_right'
  have X2 : Measurable fun t => ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, F₂ t p q := by
    have : Measurable fun u : ℝ × ℝ => ∫⁻ q in Q.iy β, F₂ u.1 u.2 q :=
      (h₂.comp (measurable_fst.fst.prodMk (measurable_fst.snd.prodMk
        measurable_snd))).lintegral_prod_right'
    exact this.lintegral_prod_right'
  have hw : Measurable fun t : ℝ => ENNReal.ofReal t⁻¹ := ENNReal.measurable_ofReal.comp
    measurable_id.inv
  have e1 : ∀ t p, ∫⁻ q in Q.iy β, (c₁ * F₁ t p q + c₂ * F₂ t p q) =
      c₁ * (∫⁻ q in Q.iy β, F₁ t p q) + c₂ * ∫⁻ q in Q.iy β, F₂ t p q := fun t p => by
    rw [lintegral_add_left ((q1 t p).const_mul c₁)]
    congr 1
    · exact lintegral_const_mul c₁ (q1 t p)
    · exact lintegral_const_mul c₂ (q2 t p)
  have e2 : ∀ t, ∫⁻ p in Q.ix α, (c₁ * (∫⁻ q in Q.iy β, F₁ t p q) + c₂ * ∫⁻ q in Q.iy β,
      F₂ t p q) = c₁ * (∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, F₁ t p q) +
        c₂ * ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, F₂ t p q := fun t => by
    rw [lintegral_add_left ((p1 t).const_mul c₁)]
    congr 1
    · exact lintegral_const_mul c₁ (p1 t)
    · exact lintegral_const_mul c₂ (p2 t)
  have e3 : ∀ t, ENNReal.ofReal t⁻¹ * (c₁ * (∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, F₁ t p q) +
      c₂ * ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, F₂ t p q) =
      c₁ * (ENNReal.ofReal t⁻¹ * ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, F₁ t p q) +
      c₂ * (ENNReal.ofReal t⁻¹ * ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, F₂ t p q) := fun t => by ring
  have m1 : Measurable fun t => ENNReal.ofReal t⁻¹ * ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, F₁ t p q :=
    hw.mul X1
  have m2 : Measurable fun t => ENNReal.ofReal t⁻¹ * ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, F₂ t p q :=
    hw.mul X2
  simp_rw [e1, e2, e3]
  rw [lintegral_add_left (m1.const_mul c₁)]
  congr 1
  · exact lintegral_const_mul c₁ m1
  · exact lintegral_const_mul c₂ m2

/-! ### The scale and translation integrals -/

theorem lintegral_Ici_rpow_neg_two :
    ∫⁻ lam in Ici (1 : ℝ), ENNReal.ofReal (lam ^ (-2 : ℝ)) = 1 := by
  rw [← setLIntegral_congr Ioi_ae_eq_Ici, ← ofReal_integral_eq_lintegral_ofReal
    (integrableOn_Ioi_rpow_of_lt (by norm_num) one_pos)
    ((ae_restrict_iff' measurableSet_Ioi).2 (Eventually.of_forall fun x hx =>
      Real.rpow_nonneg (le_of_lt (lt_trans one_pos hx)) _)),
    integral_Ioi_rpow_of_lt (by norm_num) one_pos]
  norm_num

theorem lintegral_scale_le (N₀ : ℕ) :
    ∫⁻ lam in Ici (1 : ℝ), ENNReal.ofReal (lam ^ (-((N₀ + 3 : ℕ) : ℝ) + 1)) *
      ENNReal.ofReal (lam ^ N₀) = 1 := by
  rw [← lintegral_Ici_rpow_neg_two]
  refine setLIntegral_congr_fun measurableSet_Ici fun lam hl => ?_
  have hl0 : 0 < lam := lt_of_lt_of_le one_pos hl
  rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hl0.le _), ← Real.rpow_natCast lam N₀,
    ← Real.rpow_add hl0]
  congr 2; push_cast; ring

/-- `I_3 = ∫ (1+|r|)^{-3} dr`. -/
def bracketThree : ℝ := ∫ r : ℝ, (1 + |r|) ^ (-(3 : ℝ))

theorem integrable_bracketThree : Integrable fun r : ℝ => (1 + |r|) ^ (-(3 : ℝ)) := by
  have := integrable_one_add_norm (E := ℝ) (μ := volume) (r := 3) (by norm_num)
  simpa [Real.norm_eq_abs] using this

theorem bracketThree_nonneg : 0 ≤ bracketThree :=
  integral_nonneg fun r => by positivity

/-- `∫ |Ψ(r)| (1+|r|)^{N_0} dr ≤ B I_3` for `|Ψ(r)| ≤ B (1+|r|)^{-(N_0+3)}`. -/
theorem lintegral_Psi_weight_le {Ψ : ℝ → ℝ} {B : ℝ} {N₀ : ℕ}
    (hΨ : ∀ r, |Ψ r| ≤ B * (1 + |r|) ^ (-((N₀ + 3 : ℕ) : ℝ))) :
    ∫⁻ r, ‖Ψ r‖ₑ * ENNReal.ofReal ((1 + |r|) ^ N₀) ≤ ENNReal.ofReal (B * bracketThree) := by
  have hB : 0 ≤ B := by
    have h := (abs_nonneg _).trans (hΨ 0)
    have h1 : (0 : ℝ) < (1 + |(0 : ℝ)|) ^ (-((N₀ + 3 : ℕ) : ℝ)) := by positivity
    exact nonneg_of_mul_nonneg_left h h1
  rw [bracketThree, ← integral_const_mul, ofReal_integral_eq_lintegral_ofReal
    (integrable_bracketThree.const_mul B) (Eventually.of_forall fun r => by positivity)]
  refine lintegral_mono fun r => ?_
  rw [← ofReal_norm, ← ENNReal.ofReal_mul (norm_nonneg _)]
  refine ENNReal.ofReal_le_ofReal ?_
  have h1 : (0 : ℝ) < 1 + |r| := by positivity
  rw [Real.norm_eq_abs]
  calc |Ψ r| * (1 + |r|) ^ N₀ ≤ B * (1 + |r|) ^ (-((N₀ + 3 : ℕ) : ℝ)) * (1 + |r|) ^ N₀ :=
        mul_le_mul_of_nonneg_right (hΨ r) (by positivity)
    _ = B * (1 + |r|) ^ (-(3 : ℝ)) := by
        rw [mul_assoc, ← Real.rpow_natCast (1 + |r|) N₀, ← Real.rpow_add h1]
        congr 2; push_cast; ring

theorem lintegral_Psi_le {Ψ : ℝ → ℝ} {B : ℝ} {N₀ : ℕ}
    (hΨ : ∀ r, |Ψ r| ≤ B * (1 + |r|) ^ (-((N₀ + 3 : ℕ) : ℝ))) :
    ∫⁻ r, ‖Ψ r‖ₑ ≤ ENNReal.ofReal (B * bracketThree) := by
  refine le_trans (lintegral_mono fun r => ?_) (lintegral_Psi_weight_le hΨ)
  have : (1 : ℝ) ≤ (1 + |r|) ^ N₀ := one_le_pow₀ (by linarith [abs_nonneg r])
  calc ‖Ψ r‖ₑ = ‖Ψ r‖ₑ * 1 := (mul_one _).symm
    _ ≤ ‖Ψ r‖ₑ * ENNReal.ofReal ((1 + |r|) ^ N₀) := by
        gcongr; rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal this

/-! ### The two collection sums -/

theorem cell_lintegral_const_mul (α β : ℕ) (Q : DyRect) {c : ℝ≥0∞} (hc : c ≠ ⊤)
    (F : ℝ → ℝ → ℝ → ℝ≥0∞) :
    ∫⁻ t in Ioc (Q.len / 2) Q.len, ENNReal.ofReal t⁻¹ * ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β,
      c * F t p q = c * ∫⁻ t in Ioc (Q.len / 2) Q.len, ENNReal.ofReal t⁻¹ *
        ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, F t p q := by
  simp_rw [lintegral_const_mul' _ _ hc, mul_left_comm (ENNReal.ofReal _) c]
  rw [lintegral_const_mul' _ _ hc]

/-- The cell integrand of `Θ^{(2)}_{λ,r}(f, f', f', f)`. -/
def thetaCell (α β : ℕ) (f f' : ℝ × ℝ → ℝ) (lam r t p q : ℝ) : ℝ :=
  quadForm f f' f' f (kernelAt gaussian (lam * t ^ α) p) (kernelAt gaussian (lam * t ^ α) p)
    (kernelAt gaussianDeriv (t ^ β) (q + t ^ β * r))
    (kernelAt gaussianDeriv (t ^ β) (q + t ^ β * r))

theorem theta2_eq_collInt (α β : ℕ) (𝒬 : Finset DyRect) (lam r : ℝ) (f f' : ℝ × ℝ → ℝ) :
    theta2 α β 𝒬 lam r f f' f' f = collInt α β 𝒬 fun t p q => thetaCell α β f f' lam r t p q := by
  unfold theta2 thetaCell
  simp only [scalarG_eq_kernelAt, scalarH_eq_kernelAt, zero_mul, add_zero, one_mul, mul_comm r]

theorem measurable_thetaCell {α β : ℕ} {f f' : ℝ × ℝ → ℝ} (hf : Measurable f)
    (hf' : Measurable f') :
    Measurable fun w : ℝ × ℝ × ℝ × ℝ × ℝ => thetaCell α β f f' w.1 w.2.1 w.2.2.1 w.2.2.2.1
      w.2.2.2.2 := by
  unfold thetaCell
  have hg := continuous_gaussian'.measurable
  have hh := Auto.Twisted.continuous_gaussianDeriv.measurable
  refine measurable_quadForm_param hf hf' hf' hf ?_ ?_ ?_ ?_
  · exact measurable_kernelAt_param hg (by fun_prop) (by fun_prop)
  · exact measurable_kernelAt_param hg (by fun_prop) (by fun_prop)
  · exact measurable_kernelAt_param hh (by fun_prop) (by fun_prop)
  · exact measurable_kernelAt_param hh (by fun_prop) (by fun_prop)

theorem thetaCell_nonneg {α β : ℕ} (f f' : ℝ × ℝ → ℝ) {lam : ℝ} (hlam : 0 ≤ lam) (r : ℝ)
    {t : ℝ} (ht : 0 < t) (p q : ℝ) : 0 ≤ thetaCell α β f f' lam r t p q := by
  unfold thetaCell
  refine quadForm_diag_nonneg fun x x' => ?_
  have hs : 0 ≤ lam * t ^ α := by positivity
  exact mul_nonneg (gaussianAt_nonneg' hs _ _) (gaussianAt_nonneg' hs _ _)

theorem cellOK_thetaCell {α β : ℕ} (Q : DyRect) {f f' : ℝ × ℝ → ℝ} (hf : Measurable f)
    (hf' : Measurable f') {M : ℝ} (hb : ∀ z, |f z| ≤ M) (hb' : ∀ z, |f' z| ≤ M) {lam : ℝ}
    (hlam : 0 < lam) (r : ℝ) :
    CellOK α β Q fun t p q => thetaCell α β f f' lam r t p q := by
  have h := cellOK_theta (α := α) (β := β) (Q := Q) hf hf' hf' hf hb hb' hb' hb
    continuous_gaussian' Auto.Twisted.continuous_gaussianDeriv Auto.Twisted.integrable_gaussian
    Auto.Twisted.integrable_gaussianDeriv (r := r) hlam
  unfold thetaCell
  simpa only [zero_mul, add_zero, one_mul, mul_comm r] using h

/-- `ofReal Θ^{(2)}_{𝒯,λ,r}(f,f',f',f)` as a sum of iterated cell lower integrals. -/
theorem ofReal_theta2 {α β : ℕ} (𝒬 : Finset DyRect) {f f' : ℝ × ℝ → ℝ} (hf : Measurable f)
    (hf' : Measurable f') {M : ℝ} (hb : ∀ z, |f z| ≤ M) (hb' : ∀ z, |f' z| ≤ M) {lam : ℝ}
    (hlam : 0 < lam) (r : ℝ) :
    ENNReal.ofReal (theta2 α β 𝒬 lam r f f' f' f) = ∑ Q ∈ 𝒬, ∫⁻ t in Ioc (Q.len / 2) Q.len,
      ENNReal.ofReal t⁻¹ * ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β,
        ENNReal.ofReal (thetaCell α β f f' lam r t p q) := by
  rw [theta2_eq_collInt]
  exact ofReal_collInt (fun Q _ => cellOK_thetaCell Q hf hf' hb hb' hlam r)
    (fun Q _ z hz => thetaCell_nonneg f f' hlam.le r (pos_of_mem_cellSet hz) _ _)

theorem measurable_cell_param (α β : ℕ) (Q : DyRect) {H : ℝ → ℝ → ℝ → ℝ → ℝ≥0∞}
    (hH : Measurable fun w : ℝ × ℝ × ℝ × ℝ => H w.1 w.2.1 w.2.2.1 w.2.2.2) :
    Measurable fun l => ∫⁻ t in Ioc (Q.len / 2) Q.len, ENNReal.ofReal t⁻¹ *
      ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, H l t p q := by
  have m3 : Measurable fun u : (ℝ × ℝ) × ℝ => ∫⁻ q in Q.iy β, H u.1.1 u.1.2 u.2 q :=
    (hH.comp (measurable_fst.fst.fst.prodMk (measurable_fst.fst.snd.prodMk
      (measurable_fst.snd.prodMk measurable_snd)))).lintegral_prod_right'
  have m2 : Measurable fun u : ℝ × ℝ =>
      ENNReal.ofReal u.2⁻¹ * ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, H u.1 u.2 p q :=
    (ENNReal.measurable_ofReal.comp measurable_snd.inv).mul m3.lintegral_prod_right'
  exact m2.lintegral_prod_right'

/-- **The `λ`-superposition of `Θ^{(2)}` over a tree**:
`∑_Q ∫_{cell} ∫_1^∞ λ^{-N+1} Θ^{(2)}_{cell,λ,r}(a,b,b,a) dλ ≲ (1+|r|)^{N_0} |Q_𝒯| 𝓜(a)^2 𝓜(b)^2`. -/
theorem cells_lambda_bound {α β : ℕ} (hα : 0 < α) (hβ : 0 < β) {C₀ : ℝ} {N₀ : ℕ} (hC₀ : 0 ≤ C₀)
    (htel : ∀ (T : DyTree α β) (lam r : ℝ), 1 ≤ lam →
      ∀ (f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ), Measurable f₁ → Measurable f₂ → Measurable f₃ →
        Measurable f₄ → ∀ M : ℝ, (∀ z, |f₁ z| ≤ M) → (∀ z, |f₂ z| ≤ M) → (∀ z, |f₃ z| ≤ M) →
        (∀ z, |f₄ z| ≤ M) →
        |(α : ℝ) * theta1 α β T.rects lam r f₁ f₂ f₃ f₄ +
            (β : ℝ) * theta2 α β T.rects lam r f₁ f₂ f₃ f₄| ≤
          C₀ * (lam * (1 + |r|)) ^ N₀ * T.root.area α β *
            (Msize α β T.rects f₁ * Msize α β T.rects f₂ * Msize α β T.rects f₃ *
              Msize α β T.rects f₄))
    (T : DyTree α β) (r : ℝ) {a b : ℝ × ℝ → ℝ} (ha : Measurable a) (hb : Measurable b) {M : ℝ}
    (hba : ∀ z, |a z| ≤ M) (hbb : ∀ z, |b z| ≤ M) :
    ∑ Q ∈ T.rects, ∫⁻ t in Ioc (Q.len / 2) Q.len, ENNReal.ofReal t⁻¹ * ∫⁻ p in Q.ix α,
      ∫⁻ q in Q.iy β, ∫⁻ lam in Ici (1 : ℝ), ENNReal.ofReal (lam ^ (-((N₀ + 3 : ℕ) : ℝ) + 1)) *
        ENNReal.ofReal (thetaCell α β a b lam r t p q) ≤
      ENNReal.ofReal (2 * C₀ / β * T.root.area α β *
        (Msize α β T.rects a ^ 2 * Msize α β T.rects b ^ 2) * (1 + |r|) ^ N₀) := by
  set K := 2 * C₀ / β * T.root.area α β * (Msize α β T.rects a ^ 2 * Msize α β T.rects b ^ 2) *
    (1 + |r|) ^ N₀ with hK
  have hθm := measurable_thetaCell (α := α) (β := β) ha hb
  have hH : Measurable fun w : ℝ × ℝ × ℝ × ℝ =>
      ENNReal.ofReal (w.1 ^ (-((N₀ + 3 : ℕ) : ℝ) + 1)) *
        ENNReal.ofReal (thetaCell α β a b w.1 r w.2.1 w.2.2.1 w.2.2.2) := by
    refine (ENNReal.measurable_ofReal.comp (measurable_fst.pow_const _)).mul
      (ENNReal.measurable_ofReal.comp ?_)
    exact hθm.comp (measurable_fst.prodMk (measurable_const.prodMk measurable_snd))
  have hsw := fun Q => cell_lintegral_swap α β Q (Ici (1 : ℝ)) (H := fun l t p q =>
    ENNReal.ofReal (l ^ (-((N₀ + 3 : ℕ) : ℝ) + 1)) * ENNReal.ofReal (thetaCell α β a b l r t p q))
    hH
  simp_rw [hsw]
  rw [← lintegral_finsetSum' _ fun Q _ => (measurable_cell_param α β Q (H := fun l t p q =>
    ENNReal.ofReal (l ^ (-((N₀ + 3 : ℕ) : ℝ) + 1)) * ENNReal.ofReal (thetaCell α β a b l r t p q))
    hH).aemeasurable]
  calc ∫⁻ lam in Ici (1 : ℝ), ∑ Q ∈ T.rects, ∫⁻ t in Ioc (Q.len / 2) Q.len, ENNReal.ofReal t⁻¹ *
        ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, ENNReal.ofReal (lam ^ (-((N₀ + 3 : ℕ) : ℝ) + 1)) *
          ENNReal.ofReal (thetaCell α β a b lam r t p q)
      = ∫⁻ lam in Ici (1 : ℝ), ENNReal.ofReal (lam ^ (-((N₀ + 3 : ℕ) : ℝ) + 1)) *
          ENNReal.ofReal (theta2 α β T.rects lam r a b b a) := by
        refine setLIntegral_congr_fun measurableSet_Ici fun lam hl => ?_
        have hl0 : 0 < lam := lt_of_lt_of_le one_pos hl
        simp_rw [cell_lintegral_const_mul α β _ ENNReal.ofReal_ne_top]
        rw [← Finset.mul_sum, ofReal_theta2 T.rects ha hb hba hbb hl0 r]
    _ ≤ ∫⁻ lam in Ici (1 : ℝ), ENNReal.ofReal (lam ^ (-((N₀ + 3 : ℕ) : ℝ) + 1)) *
          (ENNReal.ofReal K * ENNReal.ofReal (lam ^ N₀)) := by
        refine setLIntegral_mono' measurableSet_Ici fun lam hl => ?_
        have hl0 : 0 < lam := lt_of_lt_of_le one_pos hl
        gcongr
        rw [← ENNReal.ofReal_mul (by
          have := T.root.area_pos α β
          have := Msize_nonneg α β T.rects a
          positivity)]
        refine ENNReal.ofReal_le_ofReal ((theta2_abba_le hα hβ hC₀ htel T hl r ha hb hba
          hbb).trans (le_of_eq ?_))
        rw [hK, mul_pow]; ring
    _ = ENNReal.ofReal K := by
        simp_rw [mul_left_comm _ (ENNReal.ofReal K)]
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, lintegral_scale_le, mul_one]

/-! ### Proof of the tree estimate -/

theorem measurable_lam_thetaCell {α β : ℕ} {a b : ℝ × ℝ → ℝ} (ha : Measurable a)
    (hb : Measurable b) (N : ℕ) :
    Measurable fun w : ℝ × ℝ × ℝ × ℝ => ∫⁻ lam in Ici (1 : ℝ),
      ENNReal.ofReal (lam ^ (-(N : ℝ) + 1)) *
        ENNReal.ofReal (thetaCell α β a b lam w.1 w.2.1 w.2.2.1 w.2.2.2) := by
  have hθ := measurable_thetaCell (α := α) (β := β) ha hb
  have : Measurable fun u : (ℝ × ℝ × ℝ × ℝ) × ℝ => ENNReal.ofReal (u.2 ^ (-(N : ℝ) + 1)) *
      ENNReal.ofReal (thetaCell α β a b u.2 u.1.1 u.1.2.1 u.1.2.2.1 u.1.2.2.2) :=
    (ENNReal.measurable_ofReal.comp (measurable_snd.pow_const _)).mul
      (ENNReal.measurable_ofReal.comp (hθ.comp (measurable_snd.prodMk measurable_fst)))
  exact this.lintegral_prod_right'


theorem integrable_of_decay {Ψ : ℝ → ℝ} (hΨ : Continuous Ψ) {B : ℝ} {N₀ : ℕ}
    (hd : ∀ r, |Ψ r| ≤ B * (1 + |r|) ^ (-((N₀ + 3 : ℕ) : ℝ))) : Integrable Ψ := by
  refine (integrable_bracketThree.const_mul B).mono' hΨ.aestronglyMeasurable
    (Eventually.of_forall fun r => ?_)
  rw [Real.norm_eq_abs]
  refine (hd r).trans ?_
  have hB : 0 ≤ B := by
    have h := (abs_nonneg _).trans (hd 0)
    have h1 : (0 : ℝ) < (1 + |(0 : ℝ)|) ^ (-((N₀ + 3 : ℕ) : ℝ)) := by positivity
    exact nonneg_of_mul_nonneg_left h h1
  refine mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le
    (by linarith [abs_nonneg r]) ?_) hB
  push_cast; linarith [(Nat.cast_nonneg N₀ : (0 : ℝ) ≤ N₀)]

/-- **The tree estimate** (`prop:tree`): for the localized model form with kernels
`g, Φ, h, h * Ψ` (`Φ = (φ̌)_{1,u}`, `Ψ = (ψ̌)_{1,v}` in the source),
`|Λ_𝒯(f_1,f_2,f_3,f_4)| ≤ C A B |Q_𝒯| ∏_j 𝓜_𝒯(f_j)`, where `A, B` are the order-`N` decay constants
of `Φ, Ψ` (polynomial in `u`, `v` for the kernels of the cone decomposition). -/
theorem tree_estimate {α β : ℕ} (hα : 0 < α) (hβ : 0 < β) :
    ∃ (N : ℕ) (C : ℝ), 0 ≤ C ∧ ∀ (Φ Ψ : ℝ → ℝ) (A B : ℝ), Continuous Φ → Continuous Ψ →
      (∀ x, |Φ x| ≤ A * (1 + |x|) ^ (-(N : ℝ))) → (∀ x, |Ψ x| ≤ B * (1 + |x|) ^ (-(N : ℝ))) →
      ∀ (T : DyTree α β) (c : ℝ → ℝ), Measurable c → (∀ t, |c t| ≤ 1) →
      ∀ (f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ), Measurable f₁ → Measurable f₂ → Measurable f₃ →
        Measurable f₄ → ∀ M : ℝ, (∀ z, |f₁ z| ≤ M) → (∀ z, |f₂ z| ≤ M) →
        (∀ z, |f₃ z| ≤ M) → (∀ z, |f₄ z| ≤ M) →
        |locForm α β T.rects c gaussian Φ gaussianDeriv (hconv Ψ) f₁ f₂ f₃ f₄| ≤
          C * A * B * T.root.area α β *
            (Msize α β T.rects f₁ * Msize α β T.rects f₂ * Msize α β T.rects f₃ *
              Msize α β T.rects f₄) := by
  obtain ⟨C₀, N₀, hC₀, htel⟩ := telescoping_bound hα hβ
  obtain ⟨Cd, hCd, hdom⟩ := gauss_dom (N₀ + 3)
  have hβr : (0 : ℝ) < β := by exact_mod_cast hβ
  refine ⟨N₀ + 3, Cd * bracketThree * (2 * C₀ / β), by
    have := bracketThree_nonneg; positivity, fun Φ Ψ A B hΦc hΨc hΦ hΨ T c hc hc1 f₁ f₂ f₃ f₄
      h₁ h₂ h₃ h₄ M hb₁ hb₂ hb₃ hb₄ => ?_⟩
  have hA : 0 ≤ A := by
    have h := (abs_nonneg _).trans (hΦ 0)
    have h1 : (0 : ℝ) < (1 + |(0 : ℝ)|) ^ (-((N₀ + 3 : ℕ) : ℝ)) := by positivity
    exact nonneg_of_mul_nonneg_left h h1
  have hB : 0 ≤ B := by
    have h := (abs_nonneg _).trans (hΨ 0)
    have h1 : (0 : ℝ) < (1 + |(0 : ℝ)|) ^ (-((N₀ + 3 : ℕ) : ℝ)) := by positivity
    exact nonneg_of_mul_nonneg_left h h1
  have iΨ : Integrable Ψ := integrable_of_decay hΨc hΨ
  have hI3 := bracketThree_nonneg
  set area := T.root.area α β
  have harea : 0 < area := T.root.area_pos α β
  set M₁ := Msize α β T.rects f₁
  set M₂ := Msize α β T.rects f₂
  set M₃ := Msize α β T.rects f₃
  set M₄ := Msize α β T.rects f₄
  have hM₁ : 0 ≤ M₁ := Msize_nonneg α β _ _
  have hM₂ : 0 ≤ M₂ := Msize_nonneg α β _ _
  have hM₃ : 0 ≤ M₃ := Msize_nonneg α β _ _
  have hM₄ : 0 ≤ M₄ := Msize_nonneg α β _ _
  set K₁ := 2 * C₀ / β * area * (M₁ ^ 2 * M₃ ^ 2)
  set K₂ := 2 * C₀ / β * area * (M₄ ^ 2 * M₂ ^ 2)
  have hK₁ : 0 ≤ K₁ := by positivity
  have hK₂ : 0 ≤ K₂ := by positivity
  set P := B * bracketThree * (Cd * A) * K₁
  set R := Cd * A * (K₂ * (B * bracketThree))
  have hP : 0 ≤ P := by positivity
  have hR : 0 ≤ R := by positivity
  -- the bound for each `ε > 0`
  have hmain : ∀ ε : ℝ, 0 < ε →
      |locForm α β T.rects c gaussian Φ gaussianDeriv (hconv Ψ) f₁ f₂ f₃ f₄| ≤
        2⁻¹ * (ε * P + ε⁻¹ * R) := by
    intro ε hε
    set c₁ := ENNReal.ofReal (2⁻¹ * ε) * ∫⁻ r, ‖Ψ r‖ₑ
    set c₂ := ENNReal.ofReal (2⁻¹ * ε⁻¹)
    set L₁ : ℝ × ℝ × ℝ × ℝ → ℝ≥0∞ := fun w => ∫⁻ lam in Ici (1 : ℝ),
      ENNReal.ofReal (lam ^ (-((N₀ + 3 : ℕ) : ℝ) + 1)) *
        ENNReal.ofReal (thetaCell α β f₁ f₃ lam w.1 w.2.1 w.2.2.1 w.2.2.2) with hL₁
    set L₂ : ℝ × ℝ × ℝ × ℝ → ℝ≥0∞ := fun w => ∫⁻ lam in Ici (1 : ℝ),
      ENNReal.ofReal (lam ^ (-((N₀ + 3 : ℕ) : ℝ) + 1)) *
        ENNReal.ofReal (thetaCell α β f₄ f₂ lam w.1 w.2.1 w.2.2.1 w.2.2.2) with hL₂
    have hL₁m : Measurable L₁ := measurable_lam_thetaCell h₁ h₃ (N₀ + 3)
    have hL₂m : Measurable L₂ := measurable_lam_thetaCell h₄ h₂ (N₀ + 3)
    set W₁ : ℝ → ℝ → ℝ → ℝ≥0∞ := fun t p q => ENNReal.ofReal (Cd * A) * L₁ (0, t, p, q)
      with hW₁
    set W₂ : ℝ → ℝ → ℝ → ℝ≥0∞ := fun t p q => ENNReal.ofReal (Cd * A) *
      ∫⁻ r, ‖Ψ r‖ₑ * L₂ (r, t, p, q) with hW₂
    have hW₁m : Measurable fun w : ℝ × ℝ × ℝ => W₁ w.1 w.2.1 w.2.2 :=
      measurable_const.mul (hL₁m.comp (measurable_const.prodMk measurable_id))
    have hW₂m : Measurable fun w : ℝ × ℝ × ℝ => W₂ w.1 w.2.1 w.2.2 := by
      refine measurable_const.mul ?_
      have : Measurable fun u : (ℝ × ℝ × ℝ) × ℝ => ‖Ψ u.2‖ₑ * L₂ (u.2, u.1) :=
        (hΨc.measurable.comp measurable_snd).enorm.mul
          (hL₂m.comp (measurable_snd.prodMk measurable_fst))
      exact this.lintegral_prod_right'
    -- step 1: pointwise
    have hpt : ∀ Q ∈ T.rects, ∀ t ∈ Ioc (Q.len / 2) Q.len, ∀ p q,
        ‖c t * quadForm f₁ f₂ f₃ f₄ (kernelAt gaussian (t ^ α) p) (kernelAt Φ (t ^ α) p)
          (kernelAt gaussianDeriv (t ^ β) q) (kernelAt (hconv Ψ) (t ^ β) q)‖ₑ ≤
        c₁ * W₁ t p q + c₂ * W₂ t p q := by
      intro Q _ t ht p q
      have ht0 : 0 < t := lt_trans (div_pos Q.len_pos (by norm_num)) ht.1
      have hs : 0 < t ^ α := by positivity
      have hσ : 0 < t ^ β := by positivity
      have hc' : ‖c t‖ₑ ≤ 1 := by
        rw [← ofReal_norm, ← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (hc1 t)
      rw [enorm_mul]
      refine (mul_le_of_le_one_left bot_le hc').trans ?_
      refine (enorm_quadForm_le_split h₁ h₂ h₃ h₄ hb₂ hb₄ hΦc hΨc iΨ hs hσ p q hε).trans ?_
      refine add_le_add ?_ ?_
      · gcongr
        refine (lintegral_weighted_sq_le h₁ h₃ hb₁ hb₃ hdom hΦ hs hσ p q).trans (le_of_eq ?_)
        simp only [hW₁, hL₁, thetaCell, mul_zero, add_zero]
      · gcongr
        refine (lintegral_weighted_sqB_le h₂ h₄ hb₂ hb₄ hdom hΦ hΦc hΨc hs hσ p q).trans
          (le_of_eq ?_)
        simp only [hW₂, hL₂, thetaCell]
    -- step 2: the sum over cells
    have hstep : ‖locForm α β T.rects c gaussian Φ gaussianDeriv (hconv Ψ) f₁ f₂ f₃ f₄‖ₑ ≤
        c₁ * (∑ Q ∈ T.rects, ∫⁻ t in Ioc (Q.len / 2) Q.len, ENNReal.ofReal t⁻¹ *
          ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, W₁ t p q) +
        c₂ * ∑ Q ∈ T.rects, ∫⁻ t in Ioc (Q.len / 2) Q.len, ENNReal.ofReal t⁻¹ *
          ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, W₂ t p q := by
      refine (enorm_collInt_le α β T.rects _).trans ?_
      rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_le_sum fun Q hQ => ?_
      rw [← cell_lintegral_add α β Q c₁ c₂ hW₁m hW₂m]
      refine setLIntegral_mono' measurableSet_Ioc fun t ht => ?_
      gcongr
      exact hpt Q hQ t ht _ _
    -- step 3: the two sums
    have hS₁ : ∑ Q ∈ T.rects, ∫⁻ t in Ioc (Q.len / 2) Q.len, ENNReal.ofReal t⁻¹ *
        ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, W₁ t p q ≤
        ENNReal.ofReal (Cd * A) * ENNReal.ofReal K₁ := by
      simp_rw [W₁, cell_lintegral_const_mul α β _ ENNReal.ofReal_ne_top]
      rw [← Finset.mul_sum]
      gcongr
      have h := cells_lambda_bound hα hβ hC₀ htel T 0 h₁ h₃ hb₁ hb₃
      simp only [abs_zero, add_zero, one_pow, mul_one] at h
      exact h
    have hS₂ : ∑ Q ∈ T.rects, ∫⁻ t in Ioc (Q.len / 2) Q.len, ENNReal.ofReal t⁻¹ *
        ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, W₂ t p q ≤
        ENNReal.ofReal (Cd * A) * (ENNReal.ofReal K₂ * ENNReal.ofReal (B * bracketThree)) := by
      simp_rw [W₂, cell_lintegral_const_mul α β _ ENNReal.ofReal_ne_top]
      rw [← Finset.mul_sum]
      gcongr
      have hH : Measurable fun w : ℝ × ℝ × ℝ × ℝ => ‖Ψ w.1‖ₑ * L₂ w :=
        (hΨc.measurable.comp measurable_fst).enorm.mul hL₂m
      have hsw := fun Q => cell_lintegral_swap α β Q univ
        (H := fun r t p q => ‖Ψ r‖ₑ * L₂ (r, t, p, q)) hH
      simp only [Measure.restrict_univ] at hsw
      simp_rw [hsw]
      rw [← lintegral_finsetSum' _ fun Q _ => (measurable_cell_param α β Q
        (H := fun r t p q => ‖Ψ r‖ₑ * L₂ (r, t, p, q)) hH).aemeasurable]
      calc ∫⁻ r, ∑ Q ∈ T.rects, ∫⁻ t in Ioc (Q.len / 2) Q.len, ENNReal.ofReal t⁻¹ *
            ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, ‖Ψ r‖ₑ * L₂ (r, t, p, q)
          ≤ ∫⁻ r, ‖Ψ r‖ₑ * (ENNReal.ofReal K₂ * ENNReal.ofReal ((1 + |r|) ^ N₀)) := by
            refine lintegral_mono fun r => ?_
            simp_rw [cell_lintegral_const_mul α β _ enorm_ne_top]
            rw [← Finset.mul_sum]
            gcongr
            rw [← ENNReal.ofReal_mul hK₂]
            exact cells_lambda_bound hα hβ hC₀ htel T r h₄ h₂ hb₄ hb₂
        _ = ENNReal.ofReal K₂ * ∫⁻ r, ‖Ψ r‖ₑ * ENNReal.ofReal ((1 + |r|) ^ N₀) := by
            rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
            refine lintegral_congr fun r => ?_; ring
        _ ≤ _ := by gcongr; exact lintegral_Psi_weight_le hΨ
    have hc₁ : c₁ ≤ ENNReal.ofReal (2⁻¹ * ε) * ENNReal.ofReal (B * bracketThree) := by
      have := lintegral_Psi_le hΨ
      calc c₁ = ENNReal.ofReal (2⁻¹ * ε) * ∫⁻ r, ‖Ψ r‖ₑ := rfl
        _ ≤ _ := by gcongr
    have hfin : ‖locForm α β T.rects c gaussian Φ gaussianDeriv (hconv Ψ) f₁ f₂ f₃ f₄‖ₑ ≤
        ENNReal.ofReal (2⁻¹ * (ε * P + ε⁻¹ * R)) := by
      refine hstep.trans ?_
      calc c₁ * (∑ Q ∈ T.rects, ∫⁻ t in Ioc (Q.len / 2) Q.len, ENNReal.ofReal t⁻¹ *
            ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, W₁ t p q) +
          c₂ * ∑ Q ∈ T.rects, ∫⁻ t in Ioc (Q.len / 2) Q.len, ENNReal.ofReal t⁻¹ *
            ∫⁻ p in Q.ix α, ∫⁻ q in Q.iy β, W₂ t p q
          ≤ (ENNReal.ofReal (2⁻¹ * ε) * ENNReal.ofReal (B * bracketThree)) *
              (ENNReal.ofReal (Cd * A) * ENNReal.ofReal K₁) +
            c₂ * (ENNReal.ofReal (Cd * A) * (ENNReal.ofReal K₂ *
              ENNReal.ofReal (B * bracketThree))) := by
            gcongr
        _ = _ := by
            simp only [c₂]
            rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity),
              ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity),
              ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity),
              ← ENNReal.ofReal_add (by positivity) (by positivity)]
            congr 1
            simp only [P, R]; ring
    rw [Real.enorm_eq_ofReal_abs] at hfin
    exact (ENNReal.ofReal_le_ofReal_iff (by positivity)).1 hfin
  refine (le_sqrt_of_forall_amgm hP hR hmain).trans (le_of_eq ?_)
  rw [show P * R = (Cd * bracketThree * (2 * C₀ / β) * A * B * area * (M₁ * M₂ * M₃ * M₄)) ^ 2
    by simp only [P, R, K₁, K₂]; ring, Real.sqrt_sq (by positivity)]

