/-! ### Positivity on the diagonal and Cauchy-Schwarz -/

/-- `quadForm f f' f' f k₁ k₂ k k ≥ 0` if `k₁(x) k₂(x') ≥ 0` (positivity of `Θ^{(2)}`). -/
theorem quadForm_diag_nonneg {f f' : ℝ × ℝ → ℝ} {k₁ k₂ k : ℝ → ℝ}
    (hk : ∀ x x', 0 ≤ k₁ x * k₂ x') : 0 ≤ quadForm f f' f' f k₁ k₂ k k := by
  rw [quadForm_eq_factor]
  refine integral_nonneg fun x => integral_nonneg fun x' => ?_
  have e : (∫ y', f' (x, y') * f (x', y') * k y') = ∫ y, f (x', y) * f' (x, y) * k y := by
    congr 1; funext y; ring
  rw [e]
  exact mul_nonneg (hk x x') (mul_self_nonneg _)

/-- Weighted Cauchy-Schwarz: `|∫ w U V| ≤ (∫ w U^2)^{1/2} (∫ w V^2)^{1/2}` for `w ≥ 0`. -/
theorem abs_integral_mul_le_wcs {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {w U V : X → ℝ} (hw : ∀ x, 0 ≤ w x) (hwm : Measurable w)
    (hUm : Measurable U) (hVm : Measurable V)
    (hwU : Integrable (fun x => w x * U x ^ 2) μ) (hwV : Integrable (fun x => w x * V x ^ 2) μ) :
    |∫ x, w x * U x * V x ∂μ| ≤
      Real.sqrt (∫ x, w x * U x ^ 2 ∂μ) * Real.sqrt (∫ x, w x * V x ^ 2 ∂μ) := by
  set F : X → ℝ := fun x => Real.sqrt (w x) * U x
  set G : X → ℝ := fun x => Real.sqrt (w x) * V x
  have hF2 : ∀ x, ‖F x‖ ^ (2 : ℝ) = w x * U x ^ 2 := fun x => by
    rw [Real.rpow_two, Real.norm_eq_abs, sq_abs]
    simp only [F]; rw [mul_pow, Real.sq_sqrt (hw x)]
  have hG2 : ∀ x, ‖G x‖ ^ (2 : ℝ) = w x * V x ^ 2 := fun x => by
    rw [Real.rpow_two, Real.norm_eq_abs, sq_abs]
    simp only [G]; rw [mul_pow, Real.sq_sqrt (hw x)]
  have hFm : AEStronglyMeasurable F μ := (hwm.sqrt.mul hUm).aestronglyMeasurable
  have hGm : AEStronglyMeasurable G μ := (hwm.sqrt.mul hVm).aestronglyMeasurable
  have hFL : MemLp F (ENNReal.ofReal 2) μ := by
    rw [ENNReal.ofReal_ofNat, memLp_two_iff_integrable_sq hFm]
    refine hwU.congr (Eventually.of_forall fun x => ?_)
    simp only [F]; rw [mul_pow, Real.sq_sqrt (hw x)]
  have hGL : MemLp G (ENNReal.ofReal 2) μ := by
    rw [ENNReal.ofReal_ofNat, memLp_two_iff_integrable_sq hGm]
    refine hwV.congr (Eventually.of_forall fun x => ?_)
    simp only [G]; rw [mul_pow, Real.sq_sqrt (hw x)]
  have h := integral_mul_norm_le_Lp_mul_Lq Real.HolderConjugate.two_two hFL hGL
  simp_rw [hF2, hG2] at h
  have e : ∀ x, ‖F x‖ * ‖G x‖ = |w x * U x * V x| := fun x => by
    simp only [F, G, Real.norm_eq_abs, ← abs_mul]
    congr 1
    rw [show Real.sqrt (w x) * U x * (Real.sqrt (w x) * V x) =
      (Real.sqrt (w x) * Real.sqrt (w x)) * U x * V x by ring, Real.mul_self_sqrt (hw x)]
  simp_rw [e] at h
  refine (abs_integral_le_integral_abs).trans (h.trans (le_of_eq ?_))
  rw [Real.sqrt_eq_rpow, Real.sqrt_eq_rpow]

