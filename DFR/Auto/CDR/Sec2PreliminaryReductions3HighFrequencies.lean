  rw [eLpNorm_refl h₁, eLpNorm_refl h₂] at hR
  have hmA := measurable_Bj_of_contDiff (bumpPos_contDiff hb) j h₁ h₂
  have hmR := measurable_Bj_of_contDiff (bumpNeg_contDiff hb) j (measurable_refl h₁)
    (measurable_refl h₂)
  have e : Bj b j g₁ g₂ = fun z =>
      Bj (bumpPos b) j g₁ g₂ z + Bj (bumpNeg b) j (refl g₁) (refl g₂) (-z.1, z.2) :=
    funext (Bj_eq_split hb hs j h₁ h₂ hM₁ hM₂)
  rw [e]
  refine (eLpNorm_add_le hmA.aestronglyMeasurable
    (hmR.comp (measurable_fst.neg.prodMk measurable_snd)).aestronglyMeasurable le_rfl).trans ?_
  have hrefl : eLpNorm ((Bj (bumpNeg b) j (refl g₁) (refl g₂)) ∘
      fun a : ℝ × ℝ => (-a.1, a.2)) 1 volume =
      eLpNorm (Bj (bumpNeg b) j (refl g₁) (refl g₂)) 1 volume := eLpNorm_comp_reflPt hmR 1
  erw [hrefl]
  have hΛ0 : 0 ≤ Λ ^ (-δ) := by positivity
  calc eLpNorm (Bj (bumpPos b) j g₁ g₂) 1 volume +
        eLpNorm (Bj (bumpNeg b) j (refl g₁) (refl g₂)) 1 volume
      ≤ ENNReal.ofReal (C₀ * bumpConst (bumpPos b) * Λ ^ (-δ)) *
          (eLpNorm g₁ 2 volume * eLpNorm g₂ 2 volume) +
        ENNReal.ofReal (C₀ * bumpConst (bumpNeg b) * Λ ^ (-δ)) *
          (eLpNorm g₁ 2 volume * eLpNorm g₂ 2 volume) := add_le_add hA hR
    _ = ENNReal.ofReal ((C₀ * (bumpConst (bumpPos b) + bumpConst (bumpNeg b))) * Λ ^ (-δ)) *
          (eLpNorm g₁ 2 volume * eLpNorm g₂ 2 volume) := by
        rw [← add_mul, ← ENNReal.ofReal_add (by positivity) (by positivity)]; ring_nf
    _ ≤ _ := by
        refine mul_le_mul_left (ENNReal.ofReal_le_ofReal ?_) _
        nlinarith [mul_nonneg (mul_nonneg hC₀.le (add_nonneg hP0 hN0)) hΛ0]

/-! ### The singular-integral pieces `T_j` -/

/-- The profile `b(u) = ψ(u)/u` of `T_j`. -/
def tauB (u : ℝ) : ℝ := monoPsiA u / u

theorem tauB_support {u : ℝ} (h : tauB u ≠ 0) : 1 / 2 < |u| ∧ |u| < 2 :=
  mloc_psiA_ne_zero fun h0 => h (by rw [tauB, h0, zero_div])

theorem tauB_contDiff : ContDiff ℝ ∞ tauB := by
  rw [contDiff_iff_contDiffAt]
  intro u
  rcases eq_or_ne u 0 with rfl | hu
  · refine (contDiffAt_const (c := (0 : ℝ))).congr_of_eventuallyEq ?_
    filter_upwards [Metric.ball_mem_nhds (0 : ℝ) (by norm_num : (0 : ℝ) < 1 / 2)] with v hv
    rw [mem_ball_zero_iff, Real.norm_eq_abs] at hv
    rw [tauB, monoPsiA_eq_zero_of_abs_le hv.le, zero_div]
  · exact monoPsiA_contDiff.contDiffAt.div contDiffAt_id hu

/-- `T_j(g₁,g₂)(x,y) = ∫ g₁(x+t,y) g₂(x,y+t^2) ψ(2^j t) t^{-1} dt`, written with the
`L^1`-normalized bump `2^j b(2^j t)`, `b(u) = ψ(u)/u`. -/
def Tj (j : ℤ) (g₁ g₂ : ℝ × ℝ → ℂ) : ℝ × ℝ → ℂ :=
  ms8AvgP 1 2 (fun t => (2 : ℝ) ^ j * (monoPsiA ((2 : ℝ) ^ j * t) / ((2 : ℝ) ^ j * t))) g₁ g₂

theorem Tj_eq_Bj (j : ℤ) (g₁ g₂ : ℝ × ℝ → ℂ) : Tj j g₁ g₂ = Bj tauB j g₁ g₂ := rfl

theorem Tj_apply (j : ℤ) (g₁ g₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) :
    Tj j g₁ g₂ z = ∫ t, g₁ (z.1 + t, z.2) * g₂ (z.1, z.2 + t ^ 2) *
      ((monoPsiA ((2 : ℝ) ^ j * t) / t : ℝ) : ℂ) := by
  unfold Tj ms8AvgP
  refine integral_congr_ae (Eventually.of_forall fun t => ?_)
  have hj : (2 : ℝ) ^ j ≠ 0 := by positivity
  have e : (2 : ℝ) ^ j * (monoPsiA ((2 : ℝ) ^ j * t) / ((2 : ℝ) ^ j * t)) =
      monoPsiA ((2 : ℝ) ^ j * t) / t := by
    rw [mul_div_assoc', mul_div_mul_left _ _ hj]
  simp only [pow_one]
  rw [e]; ring

/-- **The `L^2` gain for `T_j`**: the analogue of `Mj_gain`. -/
theorem Tj_gain : ∃ C δ : ℝ, 0 < C ∧ 0 < δ ∧ ∀ (j : ℤ) (Λ : ℝ), 1 ≤ Λ →
    ∀ g₁ g₂ : ℝ × ℝ → ℂ, Measurable g₁ → Measurable g₂ →
    ∀ M₁ M₂ : ℝ, (∀ z, ‖g₁ z‖ ≤ M₁) → (∀ z, ‖g₂ z‖ ≤ M₂) →
    (∀ p, Integrable (monoFib 0 g₁ p) volume) → (∀ p, Integrable (monoFib 1 g₂ p) volume) →
    eLpNorm g₁ 2 volume ≠ ⊤ → eLpNorm g₂ 2 volume ≠ ⊤ →
    ((∀ p ξ, |ξ| < Λ * 2 ^ j → 𝓕 (monoFib 0 g₁ p) ξ = 0) ∨
      (∀ p ξ, |ξ| < Λ * ((2 : ℝ) ^ j) ^ 2 → 𝓕 (monoFib 1 g₂ p) ξ = 0)) →
    eLpNorm (Tj j g₁ g₂) 1 volume ≤
      ENNReal.ofReal (2 * C * Λ ^ (-δ)) * (eLpNorm g₁ 2 volume * eLpNorm g₂ 2 volume) := by
  simp_rw [Tj_eq_Bj]
  exact Bj_gain (tauB_contDiff.of_le (by norm_num)) fun _ h => tauB_support h

/-! ### Fixed-scale shifted averages in the coordinates of `ℝ^2` -/

/-- The single-scale shifted average in the coordinate `ℓ` of `ℝ^2`:
`2^{-k} ∫_{[σ 2^k, (σ+1) 2^k]} |g(z + s e_ℓ)| ds`. -/
def cAvg (ℓ : Fin 2) (σ : ℝ) (k : ℤ) (g : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℝ :=
  shiftedAverage σ (monoFib ℓ g (monoPas ℓ z)) (monoAct ℓ z) k

theorem cAvg_nonneg (ℓ : Fin 2) (σ : ℝ) (k : ℤ) (g : ℝ × ℝ → ℂ) (z : ℝ × ℝ) :
    0 ≤ cAvg ℓ σ k g z :=
  shiftedAverage_nonneg _ _ _ _

theorem cAvg_le_cShift (ℓ : Fin 2) (σ : ℝ) (k : ℤ) {g : ℝ × ℝ → ℂ} {M : ℝ}
    (hM : ∀ z, ‖g z‖ ≤ M) (z : ℝ × ℝ) : cAvg ℓ σ k g z ≤ cShift ℓ σ g z :=
  shiftedAverage_le_shiftedMaximal σ (fun _ => hM _) _ k

theorem cAvg_zero_eq (σ : ℝ) (k : ℤ) (g : ℝ × ℝ → ℂ) (z : ℝ × ℝ) :
    cAvg 0 σ k g z = shiftedAverage σ (fun s => g (s, z.2)) z.1 k := by
  simp only [cAvg, monoAct, monoPas, if_true]; rfl

theorem cAvg_one_eq (σ : ℝ) (k : ℤ) (g : ℝ × ℝ → ℂ) (z : ℝ × ℝ) :
    cAvg 1 σ k g z = shiftedAverage σ (fun s => g (z.1, s)) z.2 k := by
  simp only [cAvg, monoAct, monoPas, one_ne_zero, if_false]; rfl

/-- The integral of `|g(x + ·)|` over a shifted dyadic interval is `2^k` times the average. -/
theorem setLIntegral_shift_eq {g : ℝ → ℂ} (hg : Measurable g) {a : ℝ} (hga : ∀ x, ‖g x‖ ≤ a)
    (σ x : ℝ) (k : ℤ) :
    ∫⁻ v in Icc (σ * 2 ^ k) ((σ + 1) * 2 ^ k), ‖g (x + v)‖ₑ =
      ENNReal.ofReal ((2 : ℝ) ^ k * shiftedAverage σ g x k) := by
  have hfin : IntegrableOn (fun t => g (x + t)) (Icc (σ * 2 ^ k) ((σ + 1) * 2 ^ k)) :=
    Measure.integrableOn_of_bounded measure_Icc_lt_top.ne
      (hg.comp (measurable_const_add x)).aestronglyMeasurable
      (Eventually.of_forall fun t => hga _)
  rw [← ofReal_integral_norm_eq_lintegral_enorm hfin]
  congr 1
  unfold shiftedAverage
  rw [← mul_assoc, ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), add_neg_cancel, zpow_zero, one_mul]

/-! ### The fixed-scale form of `lem:shiftedmaxfct` for a general kernel (`κ ≥ 0`) -/

theorem ms8AvgP_one_two_apply (β : ℝ → ℝ) (g₁ g₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) :
    ms8AvgP 1 2 β g₁ g₂ z = ∫ t, (β t : ℂ) * (g₁ (z.1 + t, z.2) * g₂ (z.1, z.2 + t ^ 2)) := by
  simp only [ms8AvgP, pow_one]

theorem enorm_ofReal_real' (x : ℝ) : ‖((x : ℝ) : ℂ)‖ₑ = ENNReal.ofReal |x| := by
  rw [← ofReal_norm, Complex.norm_real, Real.norm_eq_abs]

theorem nonneg_of_abs_le_mul_zpow {β : ℝ → ℝ} {c : ℝ} {j : ℤ} (h : ∀ t, |β t| ≤ c * 2 ^ j) :
    0 ≤ c := by
  have hj : (0 : ℝ) < 2 ^ j := by positivity
  by_contra hc; push Not at hc
  nlinarith [(abs_nonneg (β 0)).trans (h 0)]

/-- The `t`-cells: `|β(t)| ≤ ∑_{|l| ≤ 2^{κ+1}} c 2^j 1_{[lη, (l+1)η)}(t)`, `η = 2^{-j-κ}`, for a
kernel `β` bounded by `c 2^j` and supported in `2^j |t| < 2`. -/
theorem ofReal_abs_le_sum_cells {β : ℝ → ℝ} {c : ℝ} (j : ℤ) (κ : ℕ)
    (hβb : ∀ t, |β t| ≤ c * 2 ^ j) (hβs : ∀ t, β t ≠ 0 → 2 ^ j * |t| < 2) (t : ℝ) :
    ENNReal.ofReal |β t| ≤ ∑ l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)),
      (Ico ((l : ℝ) * 2 ^ (-j - κ)) ((l + 1) * 2 ^ (-j - κ))).indicator
        (fun _ => ENNReal.ofReal (c * 2 ^ j)) t := by
  by_cases h0 : β t = 0
  · rw [h0, abs_zero, ENNReal.ofReal_zero]; exact bot_le
  have hj : (0 : ℝ) < 2 ^ j := by positivity
  have hη : (0 : ℝ) < 2 ^ (-j - κ) := by positivity
  have h1 := hβs t h0
  have he : (2 : ℝ) ^ j * 2 ^ (-j - κ) * 2 ^ ((κ : ℤ) + 1) = 2 := by
    rw [← zpow_add₀ (by norm_num), ← zpow_add₀ (by norm_num)]
    rw [show j + (-j - κ) + (κ + 1) = 1 by ring, zpow_one]
  set N : ℤ := 2 ^ (κ + 1) with hNdef
  have hκ : (N : ℝ) = (2 : ℝ) ^ ((κ : ℤ) + 1) := by
    rw [hNdef, zpow_add₀ (by norm_num), zpow_natCast, zpow_one]; push_cast; ring
  set n := ⌊t / 2 ^ (-j - κ)⌋
  have hn1 : (n : ℝ) ≤ t / 2 ^ (-j - κ) := Int.floor_le _
  have hn2 : t / 2 ^ (-j - κ) < n + 1 := Int.lt_floor_add_one _
  have ht : |t| * 2 ^ j < 2 := by linarith [mul_comm ((2 : ℝ) ^ j) |t|]
  have hT : |t / 2 ^ (-j - κ)| < 2 ^ ((κ : ℤ) + 1) := by
    rw [abs_div, abs_of_pos hη, div_lt_iff₀ hη]
    have : |t| * 2 ^ j < 2 ^ j * 2 ^ (-j - κ) * 2 ^ ((κ : ℤ) + 1) := by rw [he]; exact ht
    nlinarith
  have hmem : n ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)) := by
    rw [Finset.mem_Ico]
    have a1 := (abs_lt.1 hT).1
    have a2 := (abs_lt.1 hT).2
    constructor
    · have : -(N : ℝ) < (n : ℝ) + 1 := by rw [hκ]; linarith
      have : -N < n + 1 := by exact_mod_cast this
      omega
    · have : (n : ℝ) < (N : ℝ) := by rw [hκ]; linarith
      exact_mod_cast this
  refine le_trans ?_ (Finset.single_le_sum (f := fun l : ℤ =>
    (Ico ((l : ℝ) * 2 ^ (-j - κ)) ((l + 1) * 2 ^ (-j - κ))).indicator
      (fun _ => ENNReal.ofReal (c * 2 ^ j)) t) (fun _ _ => bot_le) hmem)
  rw [indicator_of_mem]
  · exact ENNReal.ofReal_le_ofReal (hβb t)
  · rw [mem_Ico]
    rw [le_div_iff₀ hη] at hn1
    rw [div_lt_iff₀ hη] at hn2
    exact ⟨hn1, hn2⟩

/-- **`lem:shiftedmaxfct` with fixed-scale averages** (`κ ≥ 0`), for any kernel `β` with
`|β| ≤ c 2^j` supported in `2^j |t| < 2`: with `m = 2j + κ`,
`|A_β(F, Δ^{(2)}_m G)(z)| ≤ ∑_{|l| ≤ 2^{κ+1}} ∑_{n ∈ ℤ} C c 2^{-κ} (1+|n|)^{-4}
  · cAvg^{(1)}_{l, -j-κ} F(z) · cAvg^{(2)}_{σ_{l,n}, 4-m} G(z)`,
i.e. the `F`-average is over `[l 2^{-j-κ}, (l+1) 2^{-j-κ}]` (scale `k = -j-κ`, shift `l`) and the
`G`-average over `[σ_{l,n} 2^{4-m}, (σ_{l,n}+1) 2^{4-m}]` (scale `k = 4-2j-κ`, shift
`σ_{l,n} = sigmaH κ l n`). -/
theorem enorm_avg_lpD_le : ∃ C : ℝ, 0 ≤ C ∧ ∀ (j : ℤ) (κ : ℕ) {β : ℝ → ℝ} {c : ℝ},
    (∀ t, |β t| ≤ c * 2 ^ j) → (∀ t, β t ≠ 0 → 2 ^ j * |t| < 2) →
    ∀ {F G : ℝ × ℝ → ℂ}, Measurable F → Measurable G → ∀ {A B : ℝ}, (∀ z, ‖F z‖ ≤ A) →
    (∀ z, ‖G z‖ ≤ B) → ∀ z : ℝ × ℝ, ‖ms8AvgP 1 2 β F (lpD 1 (2 * j + κ) G) z‖ₑ ≤
      ∑ l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)), ∑' n : ℤ,
        ENNReal.ofReal (C * c * 2 ^ (-(κ : ℤ)) / (1 + |(n : ℝ)|) ^ 4) *
          (ENNReal.ofReal (cAvg 0 l (-j - κ) F z) *
            ENNReal.ofReal (cAvg 1 (sigmaH κ l n) (4 - (2 * j + κ)) G z)) := by
  obtain ⟨C, hC, hdec⟩ := kDel_decay
  refine ⟨256 * C, by positivity, fun j κ β c hβb hβs F G hF hG A B hA hB z => ?_⟩
  have hc : 0 ≤ c := nonneg_of_abs_le_mul_zpow hβb
  set m : ℤ := 2 * j + κ with hm
  set η : ℝ := (2 : ℝ) ^ (-j - κ) with hη
  set δ : ℝ := (2 : ℝ) ^ (-m) with hδ
  have hη0 : 0 < η := by positivity
  have hδ0 : 0 < δ := by positivity
  have hj0 : (0 : ℝ) < 2 ^ (-j) := by positivity
  have hmδ : (2 : ℝ) ^ m * δ = 1 := by
    rw [hδ, ← zpow_add₀ (by norm_num), add_neg_cancel, zpow_zero]
  have hηj : η * 2 ^ (-j) = δ := by
    rw [hη, hδ, ← zpow_add₀ (by norm_num)]; congr 1; rw [hm]; ring
  have hη2 : η ^ 2 = 2 ^ (-(κ : ℤ)) * δ := by
    rw [hη, hδ, ← zpow_natCast, ← zpow_mul, ← zpow_add₀ (by norm_num)]
    congr 1; rw [hm]; push_cast; ring
  have hjη : (2 : ℝ) ^ j * η = 2 ^ (-(κ : ℤ)) := by
    rw [hη, ← zpow_add₀ (by norm_num)]; congr 1; ring
  have h16 : (2 : ℝ) ^ (4 - m) = 16 * δ := by
    rw [hδ, zpow_sub₀ (by norm_num), zpow_neg, div_eq_mul_inv]; norm_num
  set f : ℝ → ℂ := fun s => F (s, z.2) with hf
  set g : ℝ → ℂ := fun s => G (z.1, s) with hg
  have hfm : Measurable f := hF.comp (measurable_id.prodMk measurable_const)
  have hgm : Measurable g := hG.comp (measurable_const.prodMk measurable_id)
  have hfb : ∀ s, ‖f s‖ ≤ A := fun s => hA _
  have hgb : ∀ s, ‖g s‖ ≤ B := fun s => hB _
  -- the kernel representation of `Δ_m G` along the vertical line through `z`
  have hD : ∀ w, ‖lpD 1 m G (z.1, w)‖ₑ ≤ ∫⁻ s, ‖kDel m s‖ₑ * ‖g (w - s)‖ₑ := by
    intro w
    have h := lpD_apply 1 m hG hB w z.1
    have e : monoPt 1 w z.1 = (z.1, w) := by simp [monoPt]
    rw [e] at h
    rw [h]
    refine (enorm_integral_le_lintegral_enorm _).trans (le_of_eq ?_)
    refine lintegral_congr fun s => ?_
    rw [enorm_mul]
    simp [monoFib, monoPt, hg]
  -- the bound on the `t`-cell `[lη, (l+1)η)`
  set Y : ℤ → ℝ≥0∞ := fun l => ∑' n : ℤ, ENNReal.ofReal (16 * C * 2 ^ m / (1 + |(n : ℝ)|) ^ 4) *
    ENNReal.ofReal (16 * δ * cAvg 1 (sigmaH κ l n) (4 - m) G z) with hY
  have hX : ∀ l : ℤ, |(l : ℝ) * η| ≤ 2 * 2 ^ (-j) → ∀ t, t ∈ Ico ((l : ℝ) * η) ((l + 1) * η) →
      |t| ≤ 2 * 2 ^ (-j) → ‖lpD 1 m G (z.1, z.2 + t ^ 2)‖ₑ ≤ Y l := by
    intro l hl t ht htb
    refine (hD _).trans ?_
    have e1 : ∫⁻ s, ‖kDel m s‖ₑ * ‖g (z.2 + t ^ 2 - s)‖ₑ =
        ∫⁻ v, ‖kDel m (t ^ 2 - v)‖ₑ * ‖g (z.2 + v)‖ₑ := by
      rw [← lintegral_sub_left_eq_self (fun s => ‖kDel m s‖ₑ * ‖g (z.2 + t ^ 2 - s)‖ₑ) (t ^ 2)]
      congr 1; ext v; congr 3; ring
    rw [e1]
    have hmeas : Measurable fun v => ‖kDel m (t ^ 2 - v)‖ₑ * ‖g (z.2 + v)‖ₑ :=
      ((measurable_kDel m).comp (measurable_const.sub measurable_id)).enorm.mul
        (hgm.comp (measurable_const.add measurable_id)).enorm
    refine (lintegral_le_tsum_cells hmeas hδ0 (t ^ 2)).trans ?_
    refine ENNReal.tsum_le_tsum fun n => ?_
    have hc2 : ((l : ℝ) * η) ^ 2 = (l : ℝ) ^ 2 * 2 ^ (-(κ : ℤ)) * δ := by
      rw [mul_pow, hη2]; ring
    have hd : |t ^ 2 - ((l : ℝ) * η) ^ 2| ≤ 4 * δ := by
      rw [show t ^ 2 - ((l : ℝ) * η) ^ 2 = (t - l * η) * (t + l * η) by ring, abs_mul]
      have h1 : |t - l * η| ≤ η := by
        rw [abs_le]; constructor <;> linarith [ht.1, ht.2]
      have h2 : |t + l * η| ≤ 4 * 2 ^ (-j) := (abs_add_le _ _).trans (by linarith)
      calc |t - l * η| * |t + l * η| ≤ η * (4 * 2 ^ (-j)) :=
            mul_le_mul h1 h2 (abs_nonneg _) hη0.le
        _ = 4 * δ := by rw [← hηj]; ring
    have hs1 : sigmaH κ l n * 2 ^ (4 - m) = ((l : ℝ) * η) ^ 2 - (n + 5) * δ := by
      rw [h16, hc2, sigmaH]; ring
    have hs2 : (sigmaH κ l n + 1) * 2 ^ (4 - m) = ((l : ℝ) * η) ^ 2 - (n + 5) * δ + 16 * δ := by
      rw [h16, hc2, sigmaH]; ring
    calc ∫⁻ v in Icc (t ^ 2 - (n + 1) * δ) (t ^ 2 - n * δ), ‖kDel m (t ^ 2 - v)‖ₑ * ‖g (z.2 + v)‖ₑ
        ≤ ∫⁻ v in Icc (t ^ 2 - (n + 1) * δ) (t ^ 2 - n * δ),
            ENNReal.ofReal (16 * C * 2 ^ m / (1 + |(n : ℝ)|) ^ 4) * ‖g (z.2 + v)‖ₑ := by
          refine setLIntegral_mono' measurableSet_Icc fun v hv => ?_
          gcongr
          refine enorm_le_ofReal (kDel_cell_le hC hdec m n ?_ ?_)
          · have : (n : ℝ) * δ ≤ t ^ 2 - v := by linarith [hv.2]
            have := mul_le_mul_of_nonneg_left this (by positivity : (0 : ℝ) ≤ 2 ^ m)
            calc (n : ℝ) = 2 ^ m * (n * δ) := by rw [mul_left_comm, hmδ, mul_one]
              _ ≤ _ := this
          · have : t ^ 2 - v ≤ (n + 1) * δ := by linarith [hv.1]
            have := mul_le_mul_of_nonneg_left this (by positivity : (0 : ℝ) ≤ 2 ^ m)
            calc 2 ^ m * (t ^ 2 - v) ≤ 2 ^ m * ((n + 1) * δ) := this
              _ = n + 1 := by rw [mul_left_comm, hmδ, mul_one]
      _ = ENNReal.ofReal (16 * C * 2 ^ m / (1 + |(n : ℝ)|) ^ 4) *
            ∫⁻ v in Icc (t ^ 2 - (n + 1) * δ) (t ^ 2 - n * δ), ‖g (z.2 + v)‖ₑ :=
          lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
      _ ≤ ENNReal.ofReal (16 * C * 2 ^ m / (1 + |(n : ℝ)|) ^ 4) *
            ENNReal.ofReal (16 * δ * cAvg 1 (sigmaH κ l n) (4 - m) G z) := by
          gcongr
          rw [cAvg_one_eq, ← h16]
          refine le_trans (lintegral_mono_set (Icc_subset_Icc ?_ ?_))
            (le_of_eq (setLIntegral_shift_eq hgm hgb (sigmaH κ l n) z.2 (4 - m)))
          · rw [hs1]; linarith [(abs_le.1 hd).1]
          · rw [hs2]; linarith [(abs_le.1 hd).2]
  -- assembly
  set N : ℤ := 2 ^ (κ + 1) with hNdef
  have hNc : (N : ℝ) = (2 : ℝ) ^ ((κ : ℤ) + 1) := by
    rw [hNdef, zpow_add₀ (by norm_num), zpow_natCast, zpow_one]; push_cast; ring
  have hN : (N : ℝ) * η = 2 * 2 ^ (-j) := by
    rw [hNc, hη, ← zpow_add₀ (by norm_num), show (κ : ℤ) + 1 + (-j - κ) = 1 + -j by ring,
      zpow_add₀ (by norm_num), zpow_one]
  set I : ℤ → Set ℝ := fun l => Ico ((l : ℝ) * η) ((l + 1) * η) with hI
  have hrange : ∀ l ∈ Finset.Ico (-N) N, ∀ t ∈ I l,
      |(l : ℝ) * η| ≤ 2 * 2 ^ (-j) ∧ |t| ≤ 2 * 2 ^ (-j) := by
    intro l hl t ht
    rw [Finset.mem_Ico] at hl
    have h1 : (-N : ℝ) ≤ l := by exact_mod_cast hl.1
    have h2 : (l : ℝ) + 1 ≤ N := by exact_mod_cast hl.2
    have ht1 := ht.1
    have ht2 := ht.2
    have a1 : -(N : ℝ) * η ≤ l * η := mul_le_mul_of_nonneg_right h1 hη0.le
    have a2 : ((l : ℝ) + 1) * η ≤ N * η := mul_le_mul_of_nonneg_right h2 hη0.le
    rw [neg_mul, hN] at a1
    rw [hN] at a2
    refine ⟨abs_le.2 ⟨by linarith, by nlinarith⟩, abs_le.2 ⟨by linarith, by linarith⟩⟩
  rw [ms8AvgP_one_two_apply]
  refine (enorm_integral_le_lintegral_enorm _).trans ?_
  have hfz : ∀ t, F (z.1 + t, z.2) = f (z.1 + t) := fun t => rfl
  calc ∫⁻ t, ‖(β t : ℂ) * (F (z.1 + t, z.2) * lpD 1 m G (z.1, z.2 + t ^ 2))‖ₑ
      = ∫⁻ t, ENNReal.ofReal |β t| *
          (‖f (z.1 + t)‖ₑ * ‖lpD 1 m G (z.1, z.2 + t ^ 2)‖ₑ) := by
        refine lintegral_congr fun t => ?_
        rw [enorm_mul, enorm_mul, enorm_ofReal_real', hfz]
    _ ≤ ∫⁻ t, ∑ l ∈ Finset.Ico (-N) N,
          (I l).indicator (fun t => ENNReal.ofReal (c * 2 ^ j) * (‖f (z.1 + t)‖ₑ * Y l)) t := by
        refine lintegral_mono fun t => ?_
        have hψ := ofReal_abs_le_sum_cells j κ hβb hβs t
        calc ENNReal.ofReal |β t| * (‖f (z.1 + t)‖ₑ * ‖lpD 1 m G (z.1, z.2 + t ^ 2)‖ₑ)
            ≤ (∑ l ∈ Finset.Ico (-N) N,
                (I l).indicator (fun _ => ENNReal.ofReal (c * 2 ^ j)) t) *
                (‖f (z.1 + t)‖ₑ * ‖lpD 1 m G (z.1, z.2 + t ^ 2)‖ₑ) := by gcongr
          _ = ∑ l ∈ Finset.Ico (-N) N,
                (I l).indicator (fun _ => ENNReal.ofReal (c * 2 ^ j)) t *
                (‖f (z.1 + t)‖ₑ * ‖lpD 1 m G (z.1, z.2 + t ^ 2)‖ₑ) := Finset.sum_mul _ _ _
          _ ≤ _ := by
              refine Finset.sum_le_sum fun l hl => ?_
              by_cases ht : t ∈ I l
              · rw [indicator_of_mem ht, indicator_of_mem ht]
                obtain ⟨hl1, ht1⟩ := hrange l hl t ht
                gcongr
                exact hX l hl1 t ht ht1
              · rw [indicator_of_notMem ht, indicator_of_notMem ht, zero_mul]
    _ = ∑ l ∈ Finset.Ico (-N) N,
          ∫⁻ t in I l, ENNReal.ofReal (c * 2 ^ j) * (‖f (z.1 + t)‖ₑ * Y l) := by
        rw [lintegral_finsetSum (f := fun l t => (I l).indicator
          (fun t => ENNReal.ofReal (c * 2 ^ j) * (‖f (z.1 + t)‖ₑ * Y l)) t) _
          fun l _ => ((measurable_const.mul
          ((hfm.comp (measurable_const.add measurable_id)).enorm.mul measurable_const)).indicator
            measurableSet_Ico)]
        refine Finset.sum_congr rfl fun l _ => ?_
        rw [lintegral_indicator (s := I l) measurableSet_Ico]
    _ ≤ ∑ l ∈ Finset.Ico (-N) N, ENNReal.ofReal (c * 2 ^ j) *
          (ENNReal.ofReal (η * cAvg 0 l (-j - κ) F z) * Y l) := by
        refine Finset.sum_le_sum fun l _ => ?_
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
          lintegral_mul_const (Y l) (show Measurable fun a => ‖f (z.1 + a)‖ₑ from
            (hfm.comp (measurable_const.add measurable_id)).enorm)]
        gcongr
        rw [cAvg_zero_eq, hη]
        exact le_trans (lintegral_mono_set Ico_subset_Icc_self)
          (le_of_eq (setLIntegral_shift_eq hfm hfb (l : ℝ) z.1 (-j - κ)))
    _ = _ := by
        refine Finset.sum_congr rfl fun l _ => ?_
        rw [hY, ← mul_assoc, ← ENNReal.tsum_mul_left]
        refine tsum_congr fun n => ?_
        have h0 := cAvg_nonneg 0 (l : ℝ) (-j - κ) F z
        have h1 := cAvg_nonneg 1 (sigmaH κ l n) (4 - m) G z
        rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_mul (by positivity)]
        congr 1
        rw [show (2 : ℝ) ^ j = 2 ^ (-(κ : ℤ)) * η⁻¹ by rw [← hjη]; field_simp,
          show (2 : ℝ) ^ m = δ⁻¹ from eq_inv_of_mul_eq_one_left hmδ]
        field_simp
        ring

/-! ### Specializations to `T_j` and `M_j` (`κ ≥ 0`) -/

theorem abs_tauB_le (u : ℝ) : |tauB u| ≤ 2 := by
  by_cases h : tauB u = 0
  · rw [h, abs_zero]; norm_num
  have hu := tauB_support h
  rw [tauB, abs_div, abs_of_nonneg (monoPsiA_nonneg u), div_le_iff₀ (by linarith)]
  linarith [monoPsiA_le_one u]

theorem abs_dilB_tauB_le (j : ℤ) (t : ℝ) : |dilB tauB j t| ≤ 2 * 2 ^ j := by
  have hj : (0 : ℝ) < 2 ^ j := by positivity
  rw [dilB, abs_mul, abs_of_pos hj, mul_comm (2 : ℝ)]
  exact mul_le_mul_of_nonneg_left (abs_tauB_le _) hj.le

theorem dilB_tauB_support (j : ℤ) (t : ℝ) (h : dilB tauB j t ≠ 0) :
    (2 : ℝ) ^ j * |t| < 2 := by
  have hj : (0 : ℝ) < 2 ^ j := by positivity
  have := (tauB_support (right_ne_zero_of_mul h)).2
  rwa [abs_mul, abs_of_pos hj] at this

/-- **`lem:shiftedmaxfct` for `T_j` with fixed-scale averages** (`κ ≥ 0`, `m = 2j + κ`):
`|T_j(F, Δ^{(2)}_m G)(z)| ≤ ∑_{|l| ≤ 2^{κ+1}} ∑_n C 2^{-κ} (1+|n|)^{-4}
  · cAvg^{(1)}_{l, -j-κ} F(z) · cAvg^{(2)}_{σ_{l,n}, 4-m} G(z)`. -/
theorem enorm_Tj_lpD_le : ∃ C : ℝ, 0 ≤ C ∧ ∀ (j : ℤ) (κ : ℕ) {F G : ℝ × ℝ → ℂ},
    Measurable F → Measurable G → ∀ {A B : ℝ}, (∀ z, ‖F z‖ ≤ A) → (∀ z, ‖G z‖ ≤ B) →
    ∀ z : ℝ × ℝ, ‖Tj j F (lpD 1 (2 * j + κ) G) z‖ₑ ≤
      ∑ l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)), ∑' n : ℤ,
        ENNReal.ofReal (C * 2 ^ (-(κ : ℤ)) / (1 + |(n : ℝ)|) ^ 4) *
          (ENNReal.ofReal (cAvg 0 l (-j - κ) F z) *
            ENNReal.ofReal (cAvg 1 (sigmaH κ l n) (4 - (2 * j + κ)) G z)) := by
  obtain ⟨C, hC, h⟩ := enorm_avg_lpD_le
  refine ⟨C * 2, by positivity, fun j κ F G hF hG A B hA hB z => ?_⟩
  rw [Tj_eq_Bj]
  exact h j κ (abs_dilB_tauB_le j) (dilB_tauB_support j) hF hG hA hB z

/-- Sanity check: the fixed-scale bound for `M_j`, which implies `enorm_Mj_lpD_le` via
`cAvg_le_cShift`. -/
theorem enorm_Mj_lpD_le_cAvg : ∃ C : ℝ, 0 ≤ C ∧ ∀ (j : ℤ) (κ : ℕ) {F G : ℝ × ℝ → ℂ},
    Measurable F → Measurable G → ∀ {A B : ℝ}, (∀ z, ‖F z‖ ≤ A) → (∀ z, ‖G z‖ ≤ B) →
    ∀ z : ℝ × ℝ, ‖Mj j F (lpD 1 (2 * j + κ) G) z‖ₑ ≤
      ∑ l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)), ∑' n : ℤ,
        ENNReal.ofReal (C * 2 ^ (-(κ : ℤ)) / (1 + |(n : ℝ)|) ^ 4) *
          (ENNReal.ofReal (cAvg 0 l (-j - κ) F z) *
            ENNReal.ofReal (cAvg 1 (sigmaH κ l n) (4 - (2 * j + κ)) G z)) := by
  obtain ⟨C, hC, h⟩ := enorm_avg_lpD_le
  refine ⟨C * 1, by positivity, fun j κ F G hF hG A B hA hB z => ?_⟩
  have hb : ∀ t, |psiJ j t| ≤ 1 * 2 ^ j := fun t => by
    rw [abs_of_nonneg (psiJ_nonneg j t), one_mul]; exact psiJ_le j t
  exact h j κ hb (fun t ht => abs_lt_of_psiJ_ne ht) hF hG hA hB z

/-! ### The analogue for `κ ≤ 0` -/

/-- The wide-cell bound: on `2^m s ∈ [n, n+5]`, `|kDel m s| ≤ 1296 C 2^m (1 + |n|)^{-4}`. -/
theorem kDel_wide_cell_le {C : ℝ} (hC : 0 ≤ C)
    (hdec : ∀ (m : ℤ) (u : ℝ), ‖kDel m u‖ ≤ C * 2 ^ m / (1 + 2 ^ m * |u|) ^ 4)
    (m : ℤ) (n : ℤ) {s : ℝ} (h1 : (n : ℝ) ≤ 2 ^ m * s) (h2 : 2 ^ m * s ≤ n + 5) :
    ‖kDel m s‖ ≤ 1296 * C * 2 ^ m / (1 + |(n : ℝ)|) ^ 4 := by
  have hm : (0 : ℝ) < 2 ^ m := by positivity
  have hs : 2 ^ m * |s| = |2 ^ m * s| := by rw [abs_mul, abs_of_pos hm]
  have hn : |(n : ℝ)| ≤ |2 ^ m * s| + 5 :=
    abs_le.2 ⟨by linarith [neg_abs_le (2 ^ m * s)], by linarith [le_abs_self (2 ^ m * s)]⟩
  have hcell : 1 + |(n : ℝ)| ≤ 6 * (1 + 2 ^ m * |s|) := by
    rw [hs]; linarith [abs_nonneg (2 ^ m * s)]
  refine (hdec m s).trans ?_
  rw [div_le_div_iff₀ (by positivity) (by positivity)]
  have h4 : (1 + |(n : ℝ)|) ^ 4 ≤ 1296 * (1 + 2 ^ m * |s|) ^ 4 := by
    calc (1 + |(n : ℝ)|) ^ 4 ≤ (6 * (1 + 2 ^ m * |s|)) ^ 4 :=
          pow_le_pow_left₀ (by positivity) hcell 4
      _ = 1296 * (1 + 2 ^ m * |s|) ^ 4 := by ring
  have hCm : 0 ≤ C * 2 ^ m := by positivity
  nlinarith [mul_le_mul_of_nonneg_left h4 hCm]

/-- `2^m t^2 < 4` when `m ≤ 2j` and `2^j |t| < 2`. -/
theorem zpow_mul_sq_lt {j m : ℤ} (hm : m ≤ 2 * j) {t : ℝ} (ht : (2 : ℝ) ^ j * |t| < 2) :
    (2 : ℝ) ^ m * t ^ 2 < 4 := by
  have hj : (0 : ℝ) < 2 ^ j := by positivity
  have e2 : (2 : ℝ) ^ (2 * j) = (2 ^ j) ^ 2 := by
    rw [mul_comm, zpow_mul]; norm_cast
  have h1 : (2 : ℝ) ^ m ≤ (2 ^ j) ^ 2 := by
    rw [← e2]; exact zpow_le_zpow_right₀ (by norm_num) hm
  have h2 : ((2 : ℝ) ^ j) ^ 2 * t ^ 2 < 4 := by
    have : ((2 : ℝ) ^ j * |t|) ^ 2 < 2 ^ 2 :=
      pow_lt_pow_left₀ ht (by positivity) (by norm_num)
    rw [mul_pow, sq_abs] at this; linarith
  nlinarith [sq_nonneg t]

/-- **The fixed-scale bound for `κ ≤ 0`** for any kernel `β` with `|β| ≤ c 2^j` supported in
`2^j |t| < 2`: with `m = 2j + κ ≤ 2j`,
`|A_β(F, Δ^{(2)}_m G)(z)| ≤ ∑_{n ∈ ℤ} C c (1+|n|)^{-4}
  · cAvg^{(1)}_{-1/2, 2-j} F(z) · cAvg^{(2)}_{-n-1, -m} G(z)`,
i.e. the `F`-average is over `[-2 · 2^{-j}, 2 · 2^{-j}]` (scale `k = 2-j`, shift `-1/2`) and the
`G`-average over `[(-n-1) 2^{-m}, -n 2^{-m}]` (scale `k = -m = -2j-κ`, shift `-n-1`). -/
theorem enorm_avg_lpD_le_nonpos : ∃ C : ℝ, 0 ≤ C ∧ ∀ (j κ : ℤ), κ ≤ 0 → ∀ {β : ℝ → ℝ} {c : ℝ},
    (∀ t, |β t| ≤ c * 2 ^ j) → (∀ t, β t ≠ 0 → 2 ^ j * |t| < 2) →
    ∀ {F G : ℝ × ℝ → ℂ}, Measurable F → Measurable G → ∀ {A B : ℝ}, (∀ z, ‖F z‖ ≤ A) →
    (∀ z, ‖G z‖ ≤ B) → ∀ z : ℝ × ℝ, ‖ms8AvgP 1 2 β F (lpD 1 (2 * j + κ) G) z‖ₑ ≤
      ∑' n : ℤ, ENNReal.ofReal (C * c / (1 + |(n : ℝ)|) ^ 4) *
        (ENNReal.ofReal (cAvg 0 (-1 / 2) (2 - j) F z) *
          ENNReal.ofReal (cAvg 1 (-(n : ℝ) - 1) (-(2 * j + κ)) G z)) := by
  obtain ⟨C, hC, hdec⟩ := kDel_decay
  refine ⟨4 * 1296 * C, by positivity, fun j κ hκ β c hβb hβs F G hF hG A B hA hB z => ?_⟩
  have hc : 0 ≤ c := nonneg_of_abs_le_mul_zpow hβb
  have hj : (0 : ℝ) < 2 ^ j := by positivity
  set m : ℤ := 2 * j + κ with hm
  set δ : ℝ := (2 : ℝ) ^ (-m) with hδ
  have hm0 : (0 : ℝ) < 2 ^ m := by positivity
  have hδ0 : 0 < δ := by positivity
  have hmδ : (2 : ℝ) ^ m * δ = 1 := by
    rw [hδ, ← zpow_add₀ (by norm_num), add_neg_cancel, zpow_zero]
  have hmj : m ≤ 2 * j := by omega
  set P : ℝ := (2 : ℝ) ^ (2 - j) with hP
  have hPj : (2 : ℝ) ^ j * P = 4 := by
    rw [hP, ← zpow_add₀ (by norm_num), show j + (2 - j) = 2 by ring]; norm_num
  set f : ℝ → ℂ := fun s => F (s, z.2) with hf
  set g : ℝ → ℂ := fun s => G (z.1, s) with hg
  have hfm : Measurable f := hF.comp (measurable_id.prodMk measurable_const)
  have hgm : Measurable g := hG.comp (measurable_const.prodMk measurable_id)
  have hfb : ∀ s, ‖f s‖ ≤ A := fun s => hA _
  have hgb : ∀ s, ‖g s‖ ≤ B := fun s => hB _
  have hD : ∀ w, ‖lpD 1 m G (z.1, w)‖ₑ ≤ ∫⁻ s, ‖kDel m s‖ₑ * ‖g (w - s)‖ₑ := by
    intro w
    have h := lpD_apply 1 m hG hB w z.1
    have e : monoPt 1 w z.1 = (z.1, w) := by simp [monoPt]
    rw [e] at h
    rw [h]
    refine (enorm_integral_le_lintegral_enorm _).trans (le_of_eq ?_)
    refine lintegral_congr fun s => ?_
    rw [enorm_mul]
    simp [monoFib, monoPt, hg]
  set Y : ℝ≥0∞ := ∑' n : ℤ, ENNReal.ofReal (1296 * C * 2 ^ m / (1 + |(n : ℝ)|) ^ 4) *
    ENNReal.ofReal (δ * cAvg 1 (-(n : ℝ) - 1) (-m) G z) with hY
  have hX : ∀ t, (2 : ℝ) ^ j * |t| < 2 → ‖lpD 1 m G (z.1, z.2 + t ^ 2)‖ₑ ≤ Y := by
    intro t ht
    refine (hD _).trans ?_
    have e1 : ∫⁻ s, ‖kDel m s‖ₑ * ‖g (z.2 + t ^ 2 - s)‖ₑ =
        ∫⁻ v, ‖kDel m (t ^ 2 - v)‖ₑ * ‖g (z.2 + v)‖ₑ := by
      rw [← lintegral_sub_left_eq_self (fun s => ‖kDel m s‖ₑ * ‖g (z.2 + t ^ 2 - s)‖ₑ) (t ^ 2)]
      congr 1; ext v; congr 3; ring
    rw [e1]
    have hmeas : Measurable fun v => ‖kDel m (t ^ 2 - v)‖ₑ * ‖g (z.2 + v)‖ₑ :=
      ((measurable_kDel m).comp (measurable_const.sub measurable_id)).enorm.mul
        (hgm.comp (measurable_const.add measurable_id)).enorm
    refine (lintegral_le_tsum_cells hmeas hδ0 0).trans ?_
    refine ENNReal.tsum_le_tsum fun n => ?_
    have ht4 := zpow_mul_sq_lt hmj ht
    have ht0 : 0 ≤ (2 : ℝ) ^ m * t ^ 2 := by positivity
    have hI : Icc (0 - ((n : ℝ) + 1) * δ) (0 - n * δ) =
        Icc ((-(n : ℝ) - 1) * 2 ^ (-m)) ((-(n : ℝ) - 1 + 1) * 2 ^ (-m)) := by
      rw [hδ]; congr 1 <;> ring
    calc ∫⁻ v in Icc (0 - ((n : ℝ) + 1) * δ) (0 - n * δ),
          ‖kDel m (t ^ 2 - v)‖ₑ * ‖g (z.2 + v)‖ₑ
        ≤ ∫⁻ v in Icc (0 - ((n : ℝ) + 1) * δ) (0 - n * δ),
            ENNReal.ofReal (1296 * C * 2 ^ m / (1 + |(n : ℝ)|) ^ 4) * ‖g (z.2 + v)‖ₑ := by
          refine setLIntegral_mono' measurableSet_Icc fun v hv => ?_
          gcongr
          have hv1 : -((n : ℝ) + 1) ≤ 2 ^ m * v := by
            have := mul_le_mul_of_nonneg_left hv.1 hm0.le
            rwa [zero_sub, mul_neg, mul_left_comm, hmδ, mul_one] at this
          have hv2 : 2 ^ m * v ≤ -(n : ℝ) := by
            have := mul_le_mul_of_nonneg_left hv.2 hm0.le
            rwa [zero_sub, mul_neg, mul_left_comm, hmδ, mul_one] at this
          refine enorm_le_ofReal (kDel_wide_cell_le hC hdec m n ?_ ?_)
          · rw [mul_sub]; linarith
          · rw [mul_sub]; linarith
      _ = ENNReal.ofReal (1296 * C * 2 ^ m / (1 + |(n : ℝ)|) ^ 4) *
            ∫⁻ v in Icc (0 - ((n : ℝ) + 1) * δ) (0 - n * δ), ‖g (z.2 + v)‖ₑ :=
          lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
      _ = ENNReal.ofReal (1296 * C * 2 ^ m / (1 + |(n : ℝ)|) ^ 4) *
            ENNReal.ofReal (δ * cAvg 1 (-(n : ℝ) - 1) (-m) G z) := by
          rw [hI, setLIntegral_shift_eq hgm hgb, cAvg_one_eq]
  have hmemI : ∀ t, (2 : ℝ) ^ j * |t| < 2 → t ∈ Icc ((-1 / 2 : ℝ) * P) ((-1 / 2 + 1) * P) := by
    intro t ht
    have h : |t| < 1 / 2 * P := by
      by_contra h; push Not at h
      have := mul_le_mul_of_nonneg_left h hj.le
      nlinarith
    have := abs_lt.1 h
    exact ⟨by linarith, by linarith⟩
  have hfmeas : Measurable fun a => ‖f (z.1 + a)‖ₑ :=
    (hfm.comp (measurable_const.add measurable_id)).enorm
  rw [ms8AvgP_one_two_apply]
  refine (enorm_integral_le_lintegral_enorm _).trans ?_
  calc ∫⁻ t, ‖(β t : ℂ) * (F (z.1 + t, z.2) * lpD 1 m G (z.1, z.2 + t ^ 2))‖ₑ
      ≤ ∫⁻ t, (Icc ((-1 / 2 : ℝ) * P) ((-1 / 2 + 1) * P)).indicator
          (fun t => ENNReal.ofReal (c * 2 ^ j) * (‖f (z.1 + t)‖ₑ * Y)) t := by
        refine lintegral_mono fun t => ?_
        rw [enorm_mul, enorm_mul, enorm_ofReal_real']
        by_cases h0 : β t = 0
        · rw [h0, abs_zero, ENNReal.ofReal_zero, zero_mul]; exact bot_le
        · have ht := hβs t h0
          rw [indicator_of_mem (hmemI t ht)]
          exact mul_le_mul' (ENNReal.ofReal_le_ofReal (hβb t)) (mul_le_mul' le_rfl (hX t ht))
    _ = ∫⁻ t in Icc ((-1 / 2 : ℝ) * P) ((-1 / 2 + 1) * P),
          ENNReal.ofReal (c * 2 ^ j) * (‖f (z.1 + t)‖ₑ * Y) :=
        lintegral_indicator measurableSet_Icc _
    _ = ENNReal.ofReal (c * 2 ^ j) *
          ((∫⁻ t in Icc ((-1 / 2 : ℝ) * P) ((-1 / 2 + 1) * P), ‖f (z.1 + t)‖ₑ) * Y) := by
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, lintegral_mul_const Y hfmeas]
    _ = ENNReal.ofReal (c * 2 ^ j) *
          (ENNReal.ofReal (P * cAvg 0 (-1 / 2) (2 - j) F z) * Y) := by
        rw [cAvg_zero_eq, hP, setLIntegral_shift_eq hfm hfb]
    _ = _ := by
        rw [hY, ← ENNReal.tsum_mul_left, ← ENNReal.tsum_mul_left]
        refine tsum_congr fun n => ?_
        have h0 := cAvg_nonneg 0 (-1 / 2) (2 - j) F z
        have h1 := cAvg_nonneg 1 (-(n : ℝ) - 1) (-m) G z
        rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_mul (by positivity)]
        congr 1
        rw [show P = 4 * ((2 : ℝ) ^ j)⁻¹ by rw [← hPj]; field_simp,
          show δ = ((2 : ℝ) ^ m)⁻¹ from eq_inv_of_mul_eq_one_right hmδ]
        field_simp

/-- **The fixed-scale bound for `T_j` and `κ ≤ 0`** (`m = 2j + κ`):
`|T_j(F, Δ^{(2)}_m G)(z)| ≤ ∑_{n ∈ ℤ} C (1+|n|)^{-4}
  · cAvg^{(1)}_{-1/2, 2-j} F(z) · cAvg^{(2)}_{-n-1, -m} G(z)`. -/
theorem enorm_Tj_lpD_le_nonpos : ∃ C : ℝ, 0 ≤ C ∧ ∀ (j κ : ℤ), κ ≤ 0 →
    ∀ {F G : ℝ × ℝ → ℂ}, Measurable F → Measurable G → ∀ {A B : ℝ}, (∀ z, ‖F z‖ ≤ A) →
    (∀ z, ‖G z‖ ≤ B) → ∀ z : ℝ × ℝ, ‖Tj j F (lpD 1 (2 * j + κ) G) z‖ₑ ≤
      ∑' n : ℤ, ENNReal.ofReal (C / (1 + |(n : ℝ)|) ^ 4) *
        (ENNReal.ofReal (cAvg 0 (-1 / 2) (2 - j) F z) *
          ENNReal.ofReal (cAvg 1 (-(n : ℝ) - 1) (-(2 * j + κ)) G z)) := by
  obtain ⟨C, hC, h⟩ := enorm_avg_lpD_le_nonpos
  refine ⟨C * 2, by positivity, fun j κ hκ F G hF hG A B hA hB z => ?_⟩
  rw [Tj_eq_Bj]
  exact h j κ hκ (abs_dilB_tauB_le j) (dilB_tauB_support j) hF hG hA hB z

/-! ### Elementary properties of `T_j` -/

theorem tauB_hasCompactSupport : HasCompactSupport tauB := by
  refine HasCompactSupport.intro (isCompact_Icc (a := -2) (b := 2)) fun u hu => ?_
  by_contra h
  have h2 := (tauB_support h).2
  rw [abs_lt] at h2
  exact hu ⟨h2.1.le, h2.2.le⟩

theorem integrable_dilB_tauB (j : ℤ) : Integrable (dilB tauB j) :=
  integrable_dilZ tauB_contDiff.continuous tauB_hasCompactSupport j

theorem continuous_dilB_tauB (j : ℤ) : Continuous (dilB tauB j) :=
  continuous_const.mul (tauB_contDiff.continuous.comp (continuous_const.mul continuous_id))

theorem Tj_apply' (j : ℤ) (g₁ g₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) :
    Tj j g₁ g₂ z = ∫ t, (dilB tauB j t : ℂ) * (g₁ (z.1 + t, z.2) * g₂ (z.1, z.2 + t ^ 2)) :=
  ms8AvgP_one_two_apply _ _ _ _

theorem measurable_Tj (j : ℤ) {g₁ g₂ : ℝ × ℝ → ℂ} (h₁ : Measurable g₁) (h₂ : Measurable g₂) :
    Measurable (Tj j g₁ g₂) := by
  rw [Tj_eq_Bj]
  exact measurable_Bj_of_contDiff (tauB_contDiff.of_le (by norm_num)) j h₁ h₂

theorem integrable_Tj_integrand (j : ℤ) {g₁ g₂ : ℝ × ℝ → ℂ} (h₁ : Measurable g₁)
    (h₂ : Measurable g₂) {M₁ M₂ : ℝ} (hM₁ : ∀ z, ‖g₁ z‖ ≤ M₁) (hM₂ : ∀ z, ‖g₂ z‖ ≤ M₂)
    (z : ℝ × ℝ) :
    Integrable fun t => (dilB tauB j t : ℂ) * (g₁ (z.1 + t, z.2) * g₂ (z.1, z.2 + t ^ 2)) := by
  refine Integrable.mul_bdd (c := M₁ * M₂) (integrable_dilB_tauB j).ofReal ?_
    (Eventually.of_forall fun t => ?_)
  · exact ((h₁.comp ((measurable_const.add measurable_id).prodMk measurable_const)).mul
      (h₂.comp (measurable_const.prodMk (measurable_const.add
        (measurable_id.pow_const 2))))).aestronglyMeasurable
  · rw [norm_mul]
    exact mul_le_mul (hM₁ _) (hM₂ _) (norm_nonneg _) ((norm_nonneg _).trans (hM₁ 0))

theorem Tj_add_left (j : ℤ) {g₁ g₁' g₂ : ℝ × ℝ → ℂ} (h₁ : Measurable g₁) (h₁' : Measurable g₁')
    (h₂ : Measurable g₂) {M₁ M₁' M₂ : ℝ} (hM₁ : ∀ z, ‖g₁ z‖ ≤ M₁) (hM₁' : ∀ z, ‖g₁' z‖ ≤ M₁')
    (hM₂ : ∀ z, ‖g₂ z‖ ≤ M₂) : Tj j (g₁ + g₁') g₂ = Tj j g₁ g₂ + Tj j g₁' g₂ := by
  funext z
  rw [Pi.add_apply, Tj_apply', Tj_apply', Tj_apply', ← integral_add
    (integrable_Tj_integrand j h₁ h₂ hM₁ hM₂ z) (integrable_Tj_integrand j h₁' h₂ hM₁' hM₂ z)]
  congr 1; ext t; simp only [Pi.add_apply]; ring

theorem Tj_add_right (j : ℤ) {g₁ g₂ g₂' : ℝ × ℝ → ℂ} (h₁ : Measurable g₁) (h₂ : Measurable g₂)
    (h₂' : Measurable g₂') {M₁ M₂ M₂' : ℝ} (hM₁ : ∀ z, ‖g₁ z‖ ≤ M₁) (hM₂ : ∀ z, ‖g₂ z‖ ≤ M₂)
    (hM₂' : ∀ z, ‖g₂' z‖ ≤ M₂') : Tj j g₁ (g₂ + g₂') = Tj j g₁ g₂ + Tj j g₁ g₂' := by
  funext z
  rw [Pi.add_apply, Tj_apply', Tj_apply', Tj_apply', ← integral_add
    (integrable_Tj_integrand j h₁ h₂ hM₁ hM₂ z) (integrable_Tj_integrand j h₁ h₂' hM₁ hM₂' z)]
  congr 1; ext t; simp only [Pi.add_apply]; ring

theorem Tj_smul_left (j : ℤ) (c : ℂ) (g₁ g₂ : ℝ × ℝ → ℂ) :
    Tj j (c • g₁) g₂ = c • Tj j g₁ g₂ := by
  funext z
  rw [Pi.smul_apply, Tj_apply', Tj_apply', smul_eq_mul, ← integral_const_mul]
  congr 1; ext t; simp only [Pi.smul_apply, smul_eq_mul]; ring

theorem Tj_smul_right (j : ℤ) (c : ℂ) (g₁ g₂ : ℝ × ℝ → ℂ) :
    Tj j g₁ (c • g₂) = c • Tj j g₁ g₂ := by
  funext z
  rw [Pi.smul_apply, Tj_apply', Tj_apply', smul_eq_mul, ← integral_const_mul]
  congr 1; ext t; simp only [Pi.smul_apply, smul_eq_mul]; ring

theorem Tj_tendsto (j : ℤ) {G₁ G₂ : ℕ → ℝ × ℝ → ℂ} {H₁ H₂ : ℝ × ℝ → ℂ}
    (hG₁ : ∀ n, Measurable (G₁ n)) (hG₂ : ∀ n, Measurable (G₂ n)) {M₁ M₂ : ℝ}
    (hM₁ : ∀ n z, ‖G₁ n z‖ ≤ M₁) (hM₂ : ∀ n z, ‖G₂ n z‖ ≤ M₂)
    (hl₁ : ∀ z, Tendsto (fun n => G₁ n z) atTop (𝓝 (H₁ z)))
    (hl₂ : ∀ z, Tendsto (fun n => G₂ n z) atTop (𝓝 (H₂ z))) (z : ℝ × ℝ) :
    Tendsto (fun n => Tj j (G₁ n) (G₂ n) z) atTop (𝓝 (Tj j H₁ H₂ z)) := by
  simp_rw [Tj_apply']
  refine tendsto_integral_of_dominated_convergence (fun t => ‖dilB tauB j t‖ * (M₁ * M₂))
    (fun n => ?_) ((integrable_dilB_tauB j).norm.mul_const _)
    (fun n => Eventually.of_forall fun t => ?_) (Eventually.of_forall fun t => ?_)
  · exact (integrable_Tj_integrand j (hG₁ n) (hG₂ n) (hM₁ n) (hM₂ n) z).aestronglyMeasurable
  · rw [norm_mul, norm_mul, Complex.norm_real]
    exact mul_le_mul_of_nonneg_left (mul_le_mul (hM₁ n _) (hM₂ n _) (norm_nonneg _)
      ((norm_nonneg _).trans (hM₁ n 0))) (norm_nonneg _)
  · exact ((hl₁ _).mul (hl₂ _)).const_mul _

/-! ### The pieces `T^{(k)}` -/

/-- `T^{(k)}_F(f₁, f₂) = ∑_{j ∈ F} T_j(Δ^{(1)}_{j+k₁} f₁, Δ^{(2)}_{2j+k₂} f₂)`, the truncation to
the finite set of scales `F` of the operator `T^{(k)}` of §2.3. -/
def TkF (k₁ k₂ : ℤ) (F : Finset ℤ) (f₁ f₂ : ℝ × ℝ → ℂ) : ℝ × ℝ → ℂ :=
  ∑ j ∈ F, Tj j (lpD 0 (j + k₁) f₁) (lpD 1 (2 * j + k₂) f₂)

theorem TkF_apply (k₁ k₂ : ℤ) (F : Finset ℤ) (f₁ f₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) :
    TkF k₁ k₂ F f₁ f₂ z = ∑ j ∈ F, Tj j (lpD 0 (j + k₁) f₁) (lpD 1 (2 * j + k₂) f₂) z := by
  rw [TkF, Finset.sum_apply]

theorem measurable_TkF (k₁ k₂ : ℤ) (F : Finset ℤ) {f₁ f₂ : ℝ × ℝ → ℂ} (h₁ : Measurable f₁)
    (h₂ : Measurable f₂) : Measurable (TkF k₁ k₂ F f₁ f₂) := by
  rw [show TkF k₁ k₂ F f₁ f₂ = fun z => ∑ j ∈ F, Tj j (lpD 0 (j + k₁) f₁)
    (lpD 1 (2 * j + k₂) f₂) z from funext (TkF_apply k₁ k₂ F f₁ f₂)]
  exact Finset.measurable_sum _ fun j _ => measurable_Tj j (measurable_lpD 0 _ h₁)
    (measurable_lpD 1 _ h₂)

theorem enorm_TkF_le (k₁ k₂ : ℤ) (F : Finset ℤ) (f₁ f₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) :
    ‖TkF k₁ k₂ F f₁ f₂ z‖ₑ ≤
      ∑ j ∈ F, ‖Tj j (lpD 0 (j + k₁) f₁) (lpD 1 (2 * j + k₂) f₂) z‖ₑ := by
  rw [TkF_apply]; exact enorm_sum_le _ _

/-- Modifying the inputs on the fibres over null sets changes `T^{(k)}_F` only on a null set. -/
theorem TkF_ae_congr (k₁ k₂ : ℤ) (F : Finset ℤ) {f₁ f₁' f₂ f₂' : ℝ × ℝ → ℂ} {N₁ N₂ : Set ℝ}
    (hN₁ : volume N₁ = 0) (hN₂ : volume N₂ = 0) (h₁ : ∀ z, monoPas 0 z ∉ N₁ → f₁' z = f₁ z)
    (h₂ : ∀ z, monoPas 1 z ∉ N₂ → f₂' z = f₂ z) :
    TkF k₁ k₂ F f₁' f₂' =ᵐ[volume] TkF k₁ k₂ F f₁ f₂ := by
  have hnull : volume ({z : ℝ × ℝ | z.2 ∈ N₁} ∪ {z | z.1 ∈ N₂}) = 0 :=
    measure_union_null (volume_snd_preimage_null hN₁) (volume_fst_preimage_null hN₂)
  refine measure_mono_null (fun z hz => ?_) hnull
  by_contra h
  simp only [mem_union, mem_setOf_eq, not_or] at h
  apply hz
  change TkF k₁ k₂ F f₁' f₂' z = TkF k₁ k₂ F f₁ f₂ z
  rw [TkF_apply, TkF_apply]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [Tj_apply', Tj_apply']
  congr 1; funext t
  rw [lpD_congr_fib 0 _ (z.1 + t, z.2) (G := f₁') (G' := f₁) (fun s => h₁ _ (by
      simpa [monoPas, monoPt] using h.1)),
    lpD_congr_fib 1 _ (z.1, z.2 + t ^ 2) (G := f₂') (G' := f₂) (fun s => h₂ _ (by
      simpa [monoPas, monoPt] using h.2))]

/-! ### The vector-valued fixed-scale bound in the coordinates of `ℝ^2` -/

theorem measurable_cAvg (ℓ : Fin 2) (σ : ℝ) (k : ℤ) {g : ℝ × ℝ → ℂ} (hg : Measurable g) :
    Measurable (cAvg ℓ σ k g) := by
  unfold cAvg shiftedAverage
  refine measurable_const.mul ?_
  refine (StronglyMeasurable.integral_prod_right' (ν := volume.restrict
    (Icc (σ * 2 ^ k) ((σ + 1) * 2 ^ k)))
    (f := fun q : (ℝ × ℝ) × ℝ => ‖monoFib ℓ g (monoPas ℓ q.1) (monoAct ℓ q.1 + q.2)‖) ?_).measurable
  refine Measurable.stronglyMeasurable ?_
  exact (hg.comp ((measurable_monoPt ℓ).comp (((measurable_monoAct ℓ).comp measurable_fst).add
    measurable_snd |>.prodMk ((measurable_monoPas ℓ).comp measurable_fst)))).norm

theorem cAvg_monoPt (ℓ : Fin 2) (σ : ℝ) (k : ℤ) (g : ℝ × ℝ → ℂ) (a p : ℝ) :
    cAvg ℓ σ k g (monoPt ℓ a p) = shiftedAverage σ (monoFib ℓ g p) a k := by
  simp only [cAvg, monoAct_pt, monoPas_pt]

/-- From `X^{1/p} ≤ c Y^{1/p}` to `X ≤ c^p Y`. -/
theorem ennreal_le_of_rpow_le {X Y c : ℝ≥0∞} {p : ℝ} (hp : 0 < p)
    (h : X ^ (1 / p) ≤ c * Y ^ (1 / p)) : X ≤ c ^ p * Y := by
  have h' := ENNReal.rpow_le_rpow h hp.le
  rwa [ENNReal.mul_rpow_of_nonneg _ _ hp.le, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
    one_div_mul_cancel hp.ne', ENNReal.rpow_one, ENNReal.rpow_one] at h'

theorem measurable_sqrt_sum_sq {ι : Type*} (s : Finset ι) {u : ι → ℝ × ℝ → ℝ}
    (hu : ∀ i, Measurable (u i)) : Measurable fun z => √(∑ i ∈ s, u i z ^ 2) :=
  (Finset.measurable_sum _ fun i _ => (hu i).pow_const 2).sqrt

/-- **The vector-valued fixed-scale shifted average bound in the coordinate `ℓ` of `ℝ^2`**:
`‖(∑ᵢ (cAvg^{(ℓ)}_{σ,kᵢ} gᵢ)²)^{1/2}‖_p ≤ C_p log (2 + |σ|) ‖(∑ᵢ |gᵢ|²)^{1/2}‖_p`, from the
one-dimensional bound `exists_eLpNorm_sqrt_sum_sq_shiftedAverage_le` on every fibre and Tonelli. -/
theorem eLpNorm_sqrt_sum_sq_cAvg_le (ℓ : Fin 2) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 < C ∧ ∀ (s : Finset ℤ) (σ : ℝ) (k : ℤ → ℤ) (g : ℤ → ℝ × ℝ → ℂ),
      (∀ i, Measurable (g i)) → ∀ a : ℝ, (∀ i z, ‖g i z‖ ≤ a) →
      eLpNorm (fun z => √(∑ i ∈ s, cAvg ℓ σ (k i) (g i) z ^ 2)) (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal (C * Real.log (2 + |σ|)) *
          eLpNorm (fun z => √(∑ i ∈ s, ‖g i z‖ ^ 2)) (ENNReal.ofReal p) volume := by
  obtain ⟨C, hC, h1⟩ := exists_eLpNorm_sqrt_sum_sq_shiftedAverage_le hp
  refine ⟨C, hC, fun s σ k g hg a hga => ?_⟩
  have hp0 : 0 < p := by linarith
  set c := ENNReal.ofReal (C * Real.log (2 + |σ|))
  have hm1 : Measurable fun z => ENNReal.ofReal
      (‖√(∑ i ∈ s, cAvg ℓ σ (k i) (g i) z ^ 2)‖ ^ p) :=
    ENNReal.measurable_ofReal.comp ((measurable_sqrt_sum_sq s fun i =>
      measurable_cAvg ℓ σ (k i) (hg i)).norm.pow_const p)
  have hm2 : Measurable fun z => ENNReal.ofReal (‖√(∑ i ∈ s, ‖g i z‖ ^ 2)‖ ^ p) :=
    ENNReal.measurable_ofReal.comp ((measurable_sqrt_sum_sq s fun i =>
      (hg i).norm).norm.pow_const p)
  have hfib : ∀ w : ℝ,
      ∫⁻ x, ENNReal.ofReal (‖√(∑ i ∈ s, cAvg ℓ σ (k i) (g i) (monoPt ℓ x w) ^ 2)‖ ^ p) ≤
        c ^ p * ∫⁻ x, ENNReal.ofReal (‖√(∑ i ∈ s, ‖g i (monoPt ℓ x w)‖ ^ 2)‖ ^ p) := by
    intro w
    have h := h1 s σ k (fun i => monoFib ℓ (g i) w) (fun i => measurable_monoFib (hg i) w) a
      (fun i x => hga i _)
    rw [eLpNorm_ofReal_eq' volume p hp0, eLpNorm_ofReal_eq' volume p hp0] at h
    refine le_of_eq_of_le ?_ (ennreal_le_of_rpow_le hp0 h)
    simp only [cAvg_monoPt]
  rw [eLpNorm_ofReal_eq' volume p hp0, eLpNorm_ofReal_eq' volume p hp0,
    lintegral_monoPt ℓ hm1, lintegral_monoPt ℓ hm2]
  calc (∫⁻ w, ∫⁻ x, ENNReal.ofReal
        (‖√(∑ i ∈ s, cAvg ℓ σ (k i) (g i) (monoPt ℓ x w) ^ 2)‖ ^ p)) ^ (1 / p)
      ≤ (∫⁻ w, c ^ p * ∫⁻ x, ENNReal.ofReal
          (‖√(∑ i ∈ s, ‖g i (monoPt ℓ x w)‖ ^ 2)‖ ^ p)) ^ (1 / p) :=
        ENNReal.rpow_le_rpow (lintegral_mono hfib) (by positivity)
    _ = c * (∫⁻ w, ∫⁻ x, ENNReal.ofReal
          (‖√(∑ i ∈ s, ‖g i (monoPt ℓ x w)‖ ^ 2)‖ ^ p)) ^ (1 / p) := by
        rw [lintegral_const_mul' _ _ (ENNReal.rpow_ne_top_of_nonneg hp0.le ENNReal.ofReal_ne_top),
          ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hp0.ne', ENNReal.rpow_one]

/-! ### Cauchy-Schwarz over the scales and Hölder -/

/-- Pointwise Cauchy-Schwarz: `∑ᵢ aᵢ bᵢ ≤ (∑ aᵢ²)^{1/2} (∑ bᵢ²)^{1/2}` in `[0, ∞]`. -/
theorem sum_ofReal_mul_le_sqrt {ι : Type*} (s : Finset ι) {a b : ι → ℝ} (ha : ∀ i, 0 ≤ a i)
    (hb : ∀ i, 0 ≤ b i) :
    ∑ i ∈ s, ENNReal.ofReal (a i) * ENNReal.ofReal (b i) ≤
      ENNReal.ofReal √(∑ i ∈ s, a i ^ 2) * ENNReal.ofReal √(∑ i ∈ s, b i ^ 2) := by
  rw [← ENNReal.ofReal_mul (Real.sqrt_nonneg _)]
  calc ∑ i ∈ s, ENNReal.ofReal (a i) * ENNReal.ofReal (b i)
      = ENNReal.ofReal (∑ i ∈ s, a i * b i) := by
        rw [ENNReal.ofReal_sum_of_nonneg fun i _ => mul_nonneg (ha i) (hb i)]
        exact Finset.sum_congr rfl fun i _ => (ENNReal.ofReal_mul (ha i)).symm
    _ ≤ _ := ENNReal.ofReal_le_ofReal (Real.sum_mul_le_sqrt_mul_sqrt s a b)

theorem holder_triple_ofReal {p q r : ℝ} (hp : 0 < p) (hq : 0 < q) (hr : 0 < r)
    (hpqr : 1 / p + 1 / q = 1 / r) :
    (ENNReal.ofReal p)⁻¹ + (ENNReal.ofReal q)⁻¹ = (ENNReal.ofReal r)⁻¹ := by
  rw [← ENNReal.ofReal_inv_of_pos hp, ← ENNReal.ofReal_inv_of_pos hq,
    ← ENNReal.ofReal_inv_of_pos hr, ← ENNReal.ofReal_add (by positivity) (by positivity)]
  congr 1; rw [← one_div, ← one_div, ← one_div, hpqr]

/-- **The square-function form of the shifted-average domination** (the proof of the polynomial
bound in §2.3): if each `H_j` is dominated by `∑_l ∑_n c_{l,n} cAvg^{(1)}(U_j) cAvg^{(2)}(V_j)` with
shifts independent of `j`, then `‖∑_j H_j‖_r` is bounded by the coefficient sum with the losses
`log(2+|σ|)` times the square functions `‖(∑_j |U_j|²)^{1/2}‖_p ‖(∑_j |V_j|²)^{1/2}‖_q`. -/
theorem eLpNorm_sum_le_of_cAvg_dom {p q r : ℝ} (hp : 1 < p) (hq : 1 < q) (hr : 1 ≤ r)
    (hpqr : 1 / p + 1 / q = 1 / r) :
    ∃ C₁ C₂ : ℝ, 0 < C₁ ∧ 0 < C₂ ∧ ∀ (F L : Finset ℤ) (H : ℤ → ℝ × ℝ → ℂ)
      (c : ℤ → ℤ → ℝ) (σ₁ : ℤ → ℝ) (σ₂ : ℤ → ℤ → ℝ) (s₁ s₂ : ℤ → ℤ)
      (U V : ℤ → ℝ × ℝ → ℂ), (∀ l n, 0 ≤ c l n) → (∀ j, Measurable (U j)) →
      (∀ j, Measurable (V j)) → ∀ A B : ℝ, (∀ j z, ‖U j z‖ ≤ A) → (∀ j z, ‖V j z‖ ≤ B) →
      (∀ j ∈ F, ∀ z, ‖H j z‖ₑ ≤ ∑ l ∈ L, ∑' n : ℤ, ENNReal.ofReal (c l n) *
        (ENNReal.ofReal (cAvg 0 (σ₁ l) (s₁ j) (U j) z) *
          ENNReal.ofReal (cAvg 1 (σ₂ l n) (s₂ j) (V j) z))) →
      eLpNorm (fun z => ∑ j ∈ F, H j z) (ENNReal.ofReal r) volume ≤
        (∑ l ∈ L, ∑' n : ℤ, ENNReal.ofReal (c l n) *
          (ENNReal.ofReal (C₁ * Real.log (2 + |σ₁ l|)) *
            ENNReal.ofReal (C₂ * Real.log (2 + |σ₂ l n|)))) *
        (eLpNorm (fun z => √(∑ j ∈ F, ‖U j z‖ ^ 2)) (ENNReal.ofReal p) volume *
          eLpNorm (fun z => √(∑ j ∈ F, ‖V j z‖ ^ 2)) (ENNReal.ofReal q) volume) := by
  obtain ⟨C₁, hC₁, h₁⟩ := eLpNorm_sqrt_sum_sq_cAvg_le 0 hp
  obtain ⟨C₂, hC₂, h₂⟩ := eLpNorm_sqrt_sum_sq_cAvg_le 1 hq
  refine ⟨C₁, C₂, hC₁, hC₂, fun F L H c σ₁ σ₂ s₁ s₂ U V hc hU hV A B hA hB hdom => ?_⟩
  have hr1 : 1 ≤ ENNReal.ofReal r := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hr
  have hpqr' := holder_triple_ofReal (by linarith) (by linarith) (by linarith) hpqr
  set Su : ℤ → ℝ × ℝ → ℝ := fun l z => √(∑ j ∈ F, cAvg 0 (σ₁ l) (s₁ j) (U j) z ^ 2) with hSu
  set Sv : ℤ → ℤ → ℝ × ℝ → ℝ := fun l n z =>
    √(∑ j ∈ F, cAvg 1 (σ₂ l n) (s₂ j) (V j) z ^ 2) with hSv
  have hSum : ∀ l, Measurable (Su l) := fun l =>
    measurable_sqrt_sum_sq F fun j => measurable_cAvg 0 _ _ (hU j)
  have hSvm : ∀ l n, Measurable (Sv l n) := fun l n =>
    measurable_sqrt_sum_sq F fun j => measurable_cAvg 1 _ _ (hV j)
  set Q : ℤ → ℤ → ℝ × ℝ → ℝ≥0∞ := fun l n z =>
    ENNReal.ofReal (c l n) * (ENNReal.ofReal (Su l z) * ENNReal.ofReal (Sv l n z)) with hQ
  have hQm : ∀ l n, Measurable (Q l n) := fun l n =>
    measurable_const.mul ((ENNReal.measurable_ofReal.comp (hSum l)).mul
      (ENNReal.measurable_ofReal.comp (hSvm l n)))
  have hpt : ∀ z, ‖∑ j ∈ F, H j z‖ₑ ≤ ∑ l ∈ L, ∑' n : ℤ, Q l n z := by
    intro z
    refine (enorm_sum_le _ _).trans ?_
    refine (Finset.sum_le_sum fun j hj => hdom j hj z).trans ?_
    rw [Finset.sum_comm]
    refine Finset.sum_le_sum fun l _ => ?_
    rw [← Summable.tsum_finsetSum (fun _ _ => ENNReal.summable)]
    refine ENNReal.tsum_le_tsum fun n => ?_
    rw [← Finset.mul_sum]
    exact mul_le_mul_right (sum_ofReal_mul_le_sqrt F (fun j => cAvg_nonneg _ _ _ _ _)
      (fun j => cAvg_nonneg _ _ _ _ _)) _
  have hterm : ∀ l n, eLpNorm (Q l n) (ENNReal.ofReal r) volume ≤
      ENNReal.ofReal (c l n) *
        ((ENNReal.ofReal (C₁ * Real.log (2 + |σ₁ l|)) *
          eLpNorm (fun z => √(∑ j ∈ F, ‖U j z‖ ^ 2)) (ENNReal.ofReal p) volume) *
        (ENNReal.ofReal (C₂ * Real.log (2 + |σ₂ l n|)) *
          eLpNorm (fun z => √(∑ j ∈ F, ‖V j z‖ ^ 2)) (ENNReal.ofReal q) volume)) := by
    intro l n
    refine (eLpNorm_ofReal_mul_le (fun z => Real.sqrt_nonneg _) (fun z => Real.sqrt_nonneg _)
      (hSum l).aestronglyMeasurable (hSvm l n).aestronglyMeasurable (hc l n) hpqr').trans ?_
    gcongr
    · exact h₁ F (σ₁ l) s₁ U hU A hA
    · exact h₂ F (σ₂ l n) s₂ V hV B hB
  calc eLpNorm (fun z => ∑ j ∈ F, H j z) (ENNReal.ofReal r) volume
      ≤ eLpNorm (fun z => ∑ l ∈ L, ∑' n : ℤ, Q l n z) (ENNReal.ofReal r) volume :=
        eLpNorm_mono_enorm fun z => (hpt z).trans (le_of_eq (enorm_eq_self _).symm)
    _ ≤ ∑ l ∈ L, eLpNorm (fun z => ∑' n : ℤ, Q l n z) (ENNReal.ofReal r) volume :=
        eLpNorm_finset_sum_le _ (fun l => measurable_tsum_ennreal (fun n => hQm l n)) hr1
    _ ≤ ∑ l ∈ L, ∑' n : ℤ, eLpNorm (Q l n) (ENNReal.ofReal r) volume :=
        Finset.sum_le_sum fun l _ => eLpNorm_tsum_le (hQm l) hr1 ENNReal.ofReal_ne_top
    _ ≤ ∑ l ∈ L, ∑' n : ℤ, ENNReal.ofReal (c l n) *
          (ENNReal.ofReal (C₁ * Real.log (2 + |σ₁ l|)) *
            ENNReal.ofReal (C₂ * Real.log (2 + |σ₂ l n|))) *
          (eLpNorm (fun z => √(∑ j ∈ F, ‖U j z‖ ^ 2)) (ENNReal.ofReal p) volume *
            eLpNorm (fun z => √(∑ j ∈ F, ‖V j z‖ ^ 2)) (ENNReal.ofReal q) volume) := by
        refine Finset.sum_le_sum fun l _ => ENNReal.tsum_le_tsum fun n => ?_
        refine (hterm l n).trans (le_of_eq ?_)
        ring
    _ = _ := by
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl fun l _ => ?_
        rw [ENNReal.tsum_mul_right]

/-! ### The coefficient sums -/

theorem tsum_le_ofReal_of_le {a : ℤ → ℝ≥0∞} {W : ℝ} (hW : 0 ≤ W)
    (h : ∀ n, a n ≤ ENNReal.ofReal (W / (1 + |(n : ℝ)|) ^ 2)) :
    ∑' n, a n ≤ ENNReal.ofReal (W * ∑' n : ℤ, 1 / (1 + |(n : ℝ)|) ^ 2) := by
  refine (ENNReal.tsum_le_tsum h).trans (le_of_eq ?_)
  rw [← tsum_mul_left, ENNReal.ofReal_tsum_of_nonneg (fun n => by positivity)
    (summable_one_div_one_add_abs_sq.mul_left W)]
  congr 1; funext n; rw [mul_one_div]

theorem div_pow_four_mul_le {W x : ℝ} (hW : 0 ≤ W) (hx : 0 ≤ x) :
    W / (1 + x) ^ 4 * (1 + x) ≤ W / (1 + x) ^ 2 := by
  have h1 : 0 < 1 + x := by linarith
  rw [div_mul_eq_mul_div, div_le_div_iff₀ (by positivity) (by positivity)]
  have : (1 + x) ^ 2 ≤ (1 + x) ^ 3 := pow_le_pow_right₀ (by linarith) (by norm_num)
  calc W * (1 + x) * (1 + x) ^ 2 ≤ W * (1 + x) * (1 + x) ^ 3 := by gcongr
    _ = W * (1 + x) ^ 4 := by ring

/-- The coefficient sum for `κ ≥ 0`:
`∑_{|l| ≤ 2^{κ+1}} ∑_n C 2^{-κ} (1+|n|)^{-4} C₁ log(2+|l|) C₂ log(2+|σ_{l,n}|) ≲ (κ+5)^2`. -/
theorem coeffSumT_le {C C₁ C₂ : ℝ} (hC : 0 ≤ C) (hC₁ : 0 ≤ C₁) (hC₂ : 0 ≤ C₂) (κ : ℕ) :
    ∑ l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)), ∑' n : ℤ,
      ENNReal.ofReal (C * 2 ^ (-(κ : ℤ)) / (1 + |(n : ℝ)|) ^ 4) *
        (ENNReal.ofReal (C₁ * Real.log (2 + |(l : ℝ)|)) *
          ENNReal.ofReal (C₂ * Real.log (2 + |sigmaH κ l n|)))
      ≤ ENNReal.ofReal (4 * C * C₁ * C₂ * (∑' n : ℤ, 1 / (1 + |(n : ℝ)|) ^ 2) * (κ + 5) ^ 2) := by
  set W : ℝ := C * C₁ * C₂ * (κ + 5) ^ 2 * 2 ^ (-(κ : ℤ)) with hW
  have hW0 : 0 ≤ W := by positivity
  set Z : ℝ := ∑' n : ℤ, 1 / (1 + |(n : ℝ)|) ^ 2
  have hκ : (0 : ℝ) ≤ κ := Nat.cast_nonneg κ
  have hl : ∀ l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)),
      ∑' n : ℤ, ENNReal.ofReal (C * 2 ^ (-(κ : ℤ)) / (1 + |(n : ℝ)|) ^ 4) *
        (ENNReal.ofReal (C₁ * Real.log (2 + |(l : ℝ)|)) *
          ENNReal.ofReal (C₂ * Real.log (2 + |sigmaH κ l n|))) ≤ ENNReal.ofReal (W * Z) := by
    intro l hl
    refine tsum_le_ofReal_of_le hW0 fun n => ?_
    have hn : 0 ≤ |(n : ℝ)| := abs_nonneg _
    have hL1 : 0 ≤ Real.log (2 + |(l : ℝ)|) := Real.log_nonneg (by linarith [abs_nonneg (l : ℝ)])
    have hL2 : 0 ≤ Real.log (2 + |sigmaH κ l n|) :=
      Real.log_nonneg (by linarith [abs_nonneg (sigmaH κ l n)])
    have h1 : Real.log (2 + |(l : ℝ)|) ≤ κ + 5 := by linarith [log_two_add_abs_l_le κ hl]
    have h2 : Real.log (2 + |sigmaH κ l n|) ≤ (κ + 5) * (1 + |(n : ℝ)|) := by
      nlinarith [log_two_add_abs_sigmaH_le κ hl n]
    rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
    refine ENNReal.ofReal_le_ofReal ?_
    calc C * 2 ^ (-(κ : ℤ)) / (1 + |(n : ℝ)|) ^ 4 *
          (C₁ * Real.log (2 + |(l : ℝ)|) * (C₂ * Real.log (2 + |sigmaH κ l n|)))
        ≤ C * 2 ^ (-(κ : ℤ)) / (1 + |(n : ℝ)|) ^ 4 *
          (C₁ * (κ + 5) * (C₂ * ((κ + 5) * (1 + |(n : ℝ)|)))) := by gcongr
      _ = W / (1 + |(n : ℝ)|) ^ 4 * (1 + |(n : ℝ)|) := by rw [hW]; ring
      _ ≤ W / (1 + |(n : ℝ)|) ^ 2 := div_pow_four_mul_le hW0 hn
  calc _ ≤ ∑ l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)), ENNReal.ofReal (W * Z) :=
        Finset.sum_le_sum hl
    _ = ENNReal.ofReal (2 ^ (κ + 2) * (W * Z)) := by
        rw [Finset.sum_const, nsmul_eq_mul,
          ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ 2 ^ (κ + 2)), ← card_Ico_pow κ,
          ENNReal.ofReal_natCast]
    _ = _ := by
        congr 1
        rw [hW, show (2 : ℝ) ^ (κ + 2) = 4 * 2 ^ (κ : ℤ) by rw [zpow_natCast]; ring]
        have : (2 : ℝ) ^ (κ : ℤ) * 2 ^ (-(κ : ℤ)) = 1 := by
          rw [← zpow_add₀ (by norm_num), add_neg_cancel, zpow_zero]
        calc 4 * 2 ^ (κ : ℤ) * (C * C₁ * C₂ * (κ + 5) ^ 2 * 2 ^ (-(κ : ℤ)) * Z)
            = 4 * ((2 : ℝ) ^ (κ : ℤ) * 2 ^ (-(κ : ℤ))) * (C * C₁ * C₂ * (κ + 5) ^ 2 * Z) := by
              ring
          _ = _ := by rw [this]; ring

/-- The coefficient sum for `κ ≤ 0`. -/
theorem coeffSumT_le_nonpos {C C₁ C₂ : ℝ} (hC : 0 ≤ C) (hC₁ : 0 ≤ C₁) (hC₂ : 0 ≤ C₂) :
    ∑ _l ∈ ({0} : Finset ℤ), ∑' n : ℤ, ENNReal.ofReal (C / (1 + |(n : ℝ)|) ^ 4) *
        (ENNReal.ofReal (C₁ * Real.log (2 + |(-1 / 2 : ℝ)|)) *
          ENNReal.ofReal (C₂ * Real.log (2 + |-(n : ℝ) - 1|)))
      ≤ ENNReal.ofReal (4 * C * C₁ * C₂ * ∑' n : ℤ, 1 / (1 + |(n : ℝ)|) ^ 2) := by
  rw [Finset.sum_singleton]
  refine tsum_le_ofReal_of_le (by positivity) fun n => ?_
  have hn : 0 ≤ |(n : ℝ)| := abs_nonneg _
  have hL1 : 0 ≤ Real.log (2 + |(-1 / 2 : ℝ)|) := Real.log_nonneg (by norm_num)
  have hL2 : 0 ≤ Real.log (2 + |-(n : ℝ) - 1|) :=
    Real.log_nonneg (by linarith [abs_nonneg (-(n : ℝ) - 1)])
  have h1 : Real.log (2 + |(-1 / 2 : ℝ)|) ≤ 2 := by
    have := Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2 + |(-1 / 2 : ℝ)|)
    have e : |(-1 / 2 : ℝ)| = 1 / 2 := by norm_num [abs_of_neg]
    rw [e] at this ⊢; linarith
  have h2 : Real.log (2 + |-(n : ℝ) - 1|) ≤ 2 * (1 + |(n : ℝ)|) := by
    have := Real.log_le_sub_one_of_pos (by positivity : (0 : ℝ) < 2 + |-(n : ℝ) - 1|)
    have e : |-(n : ℝ) - 1| ≤ |(n : ℝ)| + 1 := by
      calc |-(n : ℝ) - 1| ≤ |-(n : ℝ)| + |(1 : ℝ)| := abs_sub _ _
        _ = |(n : ℝ)| + 1 := by rw [abs_neg, abs_one]
    linarith
  rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
  refine ENNReal.ofReal_le_ofReal ?_
  calc C / (1 + |(n : ℝ)|) ^ 4 *
        (C₁ * Real.log (2 + |(-1 / 2 : ℝ)|) * (C₂ * Real.log (2 + |-(n : ℝ) - 1|)))
      ≤ C / (1 + |(n : ℝ)|) ^ 4 * (C₁ * 2 * (C₂ * (2 * (1 + |(n : ℝ)|)))) := by gcongr
    _ = 4 * C * C₁ * C₂ / (1 + |(n : ℝ)|) ^ 4 * (1 + |(n : ℝ)|) := by ring
    _ ≤ 4 * C * C₁ * C₂ / (1 + |(n : ℝ)|) ^ 2 := div_pow_four_mul_le (by positivity) hn

/-! ### `L^p` bounds with polynomial loss for `T^{(k)}` -/

theorem eLpNorm_sqrt_sum_lpD_comp_le (ℓ : Fin 2) {q : ℝ} (hq : 1 < q) :
    ∃ C : ℝ, 0 < C ∧ ∀ (F : Finset ℤ) (e : ℤ → ℤ), Function.Injective e →
      ∀ f : ℝ × ℝ → ℂ, Measurable f → (∃ M, ∀ z, ‖f z‖ ≤ M) → Integrable f →
      eLpNorm (fun z => √(∑ j ∈ F, ‖lpD ℓ (e j) f z‖ ^ 2)) (ENNReal.ofReal q) volume ≤
        ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal q) volume := by
  obtain ⟨C, hC, h⟩ := eLpNorm_lpD_square_le_of_bdd ℓ hq
  refine ⟨C, hC, fun F e he f hf hM hi => ?_⟩
  have := h (F.image e) f hf hM hi
  simp only [Finset.sum_image fun a _ b _ hab => he hab] at this
  exact this

theorem eLpNorm_sqrt_sum_lpDfat_comp_le (ℓ : Fin 2) {q : ℝ} (hq : 1 < q) :
    ∃ C : ℝ, 0 < C ∧ ∀ (F : Finset ℤ) (e : ℤ → ℤ), Function.Injective e →
      ∀ f : ℝ × ℝ → ℂ, Measurable f → (∃ M, ∀ z, ‖f z‖ ≤ M) → Integrable f →
      eLpNorm (fun z => √(∑ j ∈ F, ‖lpDfat ℓ (e j) f z‖ ^ 2)) (ENNReal.ofReal q) volume ≤
        ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal q) volume := by
  obtain ⟨C, hC, h⟩ := eLpNorm_lpDfat_square_le_of_bdd ℓ hq
  refine ⟨3 * C, by positivity, fun F e he f hf hM hi => ?_⟩
  have := h (F.image e) f hf hM hi
  simp only [Finset.sum_image fun a _ b _ hab => he hab] at this
  exact this

theorem norm_lpDfat_le (ℓ : Fin 2) (m : ℤ) {g : ℝ × ℝ → ℂ} {M : ℝ} (hM : ∀ z, ‖g z‖ ≤ M)
    (z : ℝ × ℝ) : ‖lpDfat ℓ m g z‖ ≤ 3 * (2 * ((∫ s, ‖monoKPhi s‖) * M)) := by
  unfold lpDfat
  simp only [Pi.add_apply]
  refine (norm_add_le _ _).trans ?_
  have h1 := norm_lpD_le ℓ (m - 1) hM z
  have h2 := norm_lpD_le ℓ m hM z
  have h3 := norm_lpD_le ℓ (m + 1) hM z
  linarith [norm_add_le (lpD ℓ (m - 1) g z) (lpD ℓ m g z)]

theorem eLpNorm_TkF_eq_sum (k₁ k₂ : ℤ) (F : Finset ℤ) (f₁ f₂ : ℝ × ℝ → ℂ) (r : ℝ≥0∞) :
    eLpNorm (TkF k₁ k₂ F f₁ f₂) r volume = eLpNorm (fun z => ∑ j ∈ F,
      Tj j (lpD 0 (j + k₁) f₁) (lpD 1 (2 * j + k₂) f₂) z) r volume := by
  congr 1; funext z; exact TkF_apply k₁ k₂ F f₁ f₂ z

/-- The final constant bookkeeping of the polynomial bounds. -/
theorem ennreal_bound_assoc (a b c : ℝ) (ha : 0 ≤ a) (hb : 0 ≤ b) (X Y : ℝ≥0∞) :
    ENNReal.ofReal a * ((ENNReal.ofReal b * X) * (ENNReal.ofReal c * Y)) =
      ENNReal.ofReal (a * b * c) * X * Y := by
  rw [ENNReal.ofReal_mul (mul_nonneg ha hb), ENNReal.ofReal_mul ha]; ring

/-- **The polynomial bound for `κ = k₂ ≥ 0`**, for inputs `f₂` whose `y`-fibres are
integrable. -/
theorem TkF_poly_nat {p q r : ℝ} (hp : 1 < p) (hq : 1 < q) (hr : 1 ≤ r)
    (hpqr : 1 / p + 1 / q = 1 / r) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (k₁ : ℤ) (κ : ℕ) (F : Finset ℤ) {f₁ f₂ : ℝ × ℝ → ℂ},
    Measurable f₁ → Measurable f₂ → Integrable f₁ → Integrable f₂ →
    (∀ p, Integrable (monoFib 1 f₂ p)) → ∀ {A B : ℝ}, (∀ z, ‖f₁ z‖ ≤ A) → (∀ z, ‖f₂ z‖ ≤ B) →
    eLpNorm (TkF k₁ κ F f₁ f₂) (ENNReal.ofReal r) volume ≤
      ENNReal.ofReal (K * (κ + 5) ^ 2) * eLpNorm f₁ (ENNReal.ofReal p) volume *
        eLpNorm f₂ (ENNReal.ofReal q) volume := by
  obtain ⟨C, hC, hT⟩ := enorm_Tj_lpD_le
  obtain ⟨C₁, C₂, hC₁, hC₂, hD⟩ := eLpNorm_sum_le_of_cAvg_dom hp hq hr hpqr
  obtain ⟨D₁, hD₁, hS₁⟩ := eLpNorm_sqrt_sum_lpD_comp_le 0 hp
  obtain ⟨D₂, hD₂, hS₂⟩ := eLpNorm_sqrt_sum_lpDfat_comp_le 1 hq
  set Z : ℝ := ∑' n : ℤ, 1 / (1 + |(n : ℝ)|) ^ 2
  have hZ : 0 ≤ Z := tsum_nonneg fun n => by positivity
  refine ⟨4 * C * C₁ * C₂ * Z * D₁ * D₂, by positivity,
    fun k₁ κ F f₁ f₂ hf₁ hf₂ hi₁ hi₂ hfib A B hA hB => ?_⟩
  have hdom : ∀ j ∈ F, ∀ z, ‖Tj j (lpD 0 (j + k₁) f₁) (lpD 1 (2 * j + (κ : ℤ)) f₂) z‖ₑ ≤
      ∑ l ∈ Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)), ∑' n : ℤ,
        ENNReal.ofReal (C * 2 ^ (-(κ : ℤ)) / (1 + |(n : ℝ)|) ^ 4) *
          (ENNReal.ofReal (cAvg 0 l (-j - κ) (lpD 0 (j + k₁) f₁) z) *
            ENNReal.ofReal (cAvg 1 (sigmaH κ l n) (4 - (2 * j + κ))
              (lpDfat 1 (2 * j + κ) f₂) z)) := by
    intro j _ z
    have h := hT j κ (measurable_lpD 0 (j + k₁) hf₁) (measurable_lpDfat 1 (2 * j + κ) hf₂)
      (norm_lpD_le 0 (j + k₁) hA) (norm_lpDfat_le 1 (2 * j + κ) hB) z
    rwa [lpD_lpDfat_of_fibInt 1 _ hfib] at h
  have hmain := hD F (Finset.Ico (-(2 : ℤ) ^ (κ + 1)) (2 ^ (κ + 1)))
    (fun j => Tj j (lpD 0 (j + k₁) f₁) (lpD 1 (2 * j + (κ : ℤ)) f₂))
    (fun _ n => C * 2 ^ (-(κ : ℤ)) / (1 + |(n : ℝ)|) ^ 4) (fun l => (l : ℝ))
    (fun l n => sigmaH κ l n) (fun j => -j - κ) (fun j => 4 - (2 * j + κ))
    (fun j => lpD 0 (j + k₁) f₁) (fun j => lpDfat 1 (2 * j + κ) f₂)
    (fun _ _ => by positivity) (fun j => measurable_lpD 0 _ hf₁)
    (fun j => measurable_lpDfat 1 _ hf₂) _ _ (fun j => norm_lpD_le 0 _ hA)
    (fun j => norm_lpDfat_le 1 _ hB) hdom
  rw [eLpNorm_TkF_eq_sum]
  refine hmain.trans ?_
  have hc := coeffSumT_le hC hC₁.le hC₂.le κ
  have h1 := hS₁ F (fun j => j + k₁) (fun a b h => by simpa using h) f₁ hf₁ ⟨A, hA⟩ hi₁
  have h2 := hS₂ F (fun j => 2 * j + (κ : ℤ)) (fun a b h => by simp only at h; omega) f₂ hf₂
    ⟨B, hB⟩ hi₂
  calc _ ≤ ENNReal.ofReal (4 * C * C₁ * C₂ * Z * (κ + 5) ^ 2) *
        ((ENNReal.ofReal D₁ * eLpNorm f₁ (ENNReal.ofReal p) volume) *
          (ENNReal.ofReal D₂ * eLpNorm f₂ (ENNReal.ofReal q) volume)) := by
        gcongr
    _ = _ := by
        rw [ennreal_bound_assoc _ _ _ (by positivity) hD₁.le]
        congr 3; ring

/-- **The polynomial bound for `κ = k₂ ≤ 0`**, for inputs `f₂` whose `y`-fibres are
integrable. -/
theorem TkF_poly_nonpos {p q r : ℝ} (hp : 1 < p) (hq : 1 < q) (hr : 1 ≤ r)
    (hpqr : 1 / p + 1 / q = 1 / r) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (k₁ κ : ℤ), κ ≤ 0 → ∀ (F : Finset ℤ) {f₁ f₂ : ℝ × ℝ → ℂ},
    Measurable f₁ → Measurable f₂ → Integrable f₁ → Integrable f₂ →
    (∀ p, Integrable (monoFib 1 f₂ p)) → ∀ {A B : ℝ}, (∀ z, ‖f₁ z‖ ≤ A) → (∀ z, ‖f₂ z‖ ≤ B) →
    eLpNorm (TkF k₁ κ F f₁ f₂) (ENNReal.ofReal r) volume ≤
      ENNReal.ofReal K * eLpNorm f₁ (ENNReal.ofReal p) volume *
        eLpNorm f₂ (ENNReal.ofReal q) volume := by
  obtain ⟨C, hC, hT⟩ := enorm_Tj_lpD_le_nonpos
  obtain ⟨C₁, C₂, hC₁, hC₂, hD⟩ := eLpNorm_sum_le_of_cAvg_dom hp hq hr hpqr
  obtain ⟨D₁, hD₁, hS₁⟩ := eLpNorm_sqrt_sum_lpD_comp_le 0 hp
  obtain ⟨D₂, hD₂, hS₂⟩ := eLpNorm_sqrt_sum_lpDfat_comp_le 1 hq
  set Z : ℝ := ∑' n : ℤ, 1 / (1 + |(n : ℝ)|) ^ 2
  have hZ : 0 ≤ Z := tsum_nonneg fun n => by positivity
  refine ⟨4 * C * C₁ * C₂ * Z * D₁ * D₂, by positivity,
    fun k₁ κ hκ F f₁ f₂ hf₁ hf₂ hi₁ hi₂ hfib A B hA hB => ?_⟩
  have hdom : ∀ j ∈ F, ∀ z, ‖Tj j (lpD 0 (j + k₁) f₁) (lpD 1 (2 * j + κ) f₂) z‖ₑ ≤
      ∑ _l ∈ ({0} : Finset ℤ), ∑' n : ℤ, ENNReal.ofReal (C / (1 + |(n : ℝ)|) ^ 4) *
        (ENNReal.ofReal (cAvg 0 (-1 / 2) (2 - j) (lpD 0 (j + k₁) f₁) z) *
          ENNReal.ofReal (cAvg 1 (-(n : ℝ) - 1) (-(2 * j + κ))
            (lpDfat 1 (2 * j + κ) f₂) z)) := by
    intro j _ z
    have h := hT j κ hκ (measurable_lpD 0 (j + k₁) hf₁) (measurable_lpDfat 1 (2 * j + κ) hf₂)
      (norm_lpD_le 0 (j + k₁) hA) (norm_lpDfat_le 1 (2 * j + κ) hB) z
    rw [lpD_lpDfat_of_fibInt 1 _ hfib] at h
    rwa [Finset.sum_singleton]
  have hmain := hD F {0}
    (fun j => Tj j (lpD 0 (j + k₁) f₁) (lpD 1 (2 * j + κ) f₂))
    (fun _ n => C / (1 + |(n : ℝ)|) ^ 4) (fun _ => -1 / 2)
    (fun _ n => -(n : ℝ) - 1) (fun j => 2 - j) (fun j => -(2 * j + κ))
    (fun j => lpD 0 (j + k₁) f₁) (fun j => lpDfat 1 (2 * j + κ) f₂)
    (fun _ _ => by positivity) (fun j => measurable_lpD 0 _ hf₁)
    (fun j => measurable_lpDfat 1 _ hf₂) _ _ (fun j => norm_lpD_le 0 _ hA)
    (fun j => norm_lpDfat_le 1 _ hB) hdom
  rw [eLpNorm_TkF_eq_sum]
  refine hmain.trans ?_
  have hc := coeffSumT_le_nonpos hC hC₁.le hC₂.le
  have h1 := hS₁ F (fun j => j + k₁) (fun a b h => by simpa using h) f₁ hf₁ ⟨A, hA⟩ hi₁
  have h2 := hS₂ F (fun j => 2 * j + κ) (fun a b h => by simp only at h; omega) f₂ hf₂
    ⟨B, hB⟩ hi₂
  calc _ ≤ ENNReal.ofReal (4 * C * C₁ * C₂ * Z) *
        ((ENNReal.ofReal D₁ * eLpNorm f₁ (ENNReal.ofReal p) volume) *
          (ENNReal.ofReal D₂ * eLpNorm f₂ (ENNReal.ofReal q) volume)) := by
        gcongr
    _ = _ := by
        rw [ennreal_bound_assoc _ _ _ (by positivity) hD₁.le]

/-- A bounded integrable function agrees a.e. with its modification on a null set of fibres. -/
theorem ae_eq_of_fib_modification (ℓ : Fin 2) {f f' : ℝ × ℝ → ℂ} {N : Set ℝ}
    (hN : volume N = 0) (h : ∀ z, monoPas ℓ z ∉ N → f' z = f z) : f' =ᵐ[volume] f := by
  fin_cases ℓ
  · refine measure_mono_null (fun z hz => ?_) (volume_snd_preimage_null hN)
    by_contra h'
    exact hz (h z (by simpa [monoPas] using h'))
  · refine measure_mono_null (fun z hz => ?_) (volume_fst_preimage_null hN)
    by_contra h'
    exact hz (h z (by simpa [monoPas] using h'))

/-- **The `L^p × L^q → L^r` bound with polynomial loss** (§2.3, lines 539-548):
`‖T^{(k)}_F(f₁, f₂)‖_r ≤ K (|k₂| + 5)^2 ‖f₁‖_p ‖f₂‖_q` for all `k₁, k₂ ∈ ℤ`, uniformly in the
finite set of scales `F`, for measurable bounded integrable `f₁, f₂`. -/
theorem TkF_poly {p q r : ℝ} (hp : 1 < p) (hq : 1 < q) (hr : 1 ≤ r)
    (hpqr : 1 / p + 1 / q = 1 / r) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (k₁ k₂ : ℤ) (F : Finset ℤ) {f₁ f₂ : ℝ × ℝ → ℂ},
    Measurable f₁ → Measurable f₂ → Integrable f₁ → Integrable f₂ →
    ∀ {A B : ℝ}, (∀ z, ‖f₁ z‖ ≤ A) → (∀ z, ‖f₂ z‖ ≤ B) →
    eLpNorm (TkF k₁ k₂ F f₁ f₂) (ENNReal.ofReal r) volume ≤
      ENNReal.ofReal (K * (|(k₂ : ℝ)| + 5) ^ 2) * eLpNorm f₁ (ENNReal.ofReal p) volume *
        eLpNorm f₂ (ENNReal.ofReal q) volume := by
  obtain ⟨K₁, hK₁, h₁⟩ := TkF_poly_nat hp hq hr hpqr
  obtain ⟨K₂, hK₂, h₂⟩ := TkF_poly_nonpos hp hq hr hpqr
  refine ⟨K₁ + K₂, by positivity, fun k₁ k₂ F f₁ f₂ hf₁ hf₂ hi₁ hi₂ A B hA hB => ?_⟩
  obtain ⟨g, hgm, hgb, hgi, N, hN, hge⟩ := exists_fib_integrable_modification 1 hf₂ hi₂ hB
  have hgg : g =ᵐ[volume] f₂ := ae_eq_of_fib_modification 1 hN hge
  have hT : TkF k₁ k₂ F f₁ g =ᵐ[volume] TkF k₁ k₂ F f₁ f₂ :=
    TkF_ae_congr k₁ k₂ F (N₁ := ∅) measure_empty hN (fun _ _ => rfl) hge
  rw [← eLpNorm_congr_ae hT, ← eLpNorm_congr_ae hgg]
  have hg1 : Integrable g := hi₂.congr hgg.symm
  have hk : (1 : ℝ) ≤ (|(k₂ : ℝ)| + 5) ^ 2 := by nlinarith [abs_nonneg (k₂ : ℝ)]
  rcases le_or_gt 0 k₂ with hk₂ | hk₂
  · obtain ⟨κ, rfl⟩ := Int.eq_ofNat_of_zero_le hk₂
    refine (h₁ k₁ κ F hf₁ hgm hi₁ hg1 hgi hA hgb).trans ?_
    gcongr ENNReal.ofReal ?_ * _ * _
    have e : |((κ : ℤ) : ℝ)| = κ := by push_cast; exact abs_of_nonneg (Nat.cast_nonneg κ)
    rw [e]; nlinarith [mul_nonneg hK₂ (sq_nonneg ((κ : ℝ) + 5))]
  · refine (h₂ k₁ k₂ hk₂.le F hf₁ hgm hi₁ hg1 hgi hA hgb).trans ?_
    gcongr ENNReal.ofReal ?_ * _ * _
    nlinarith [mul_nonneg hK₁ (sq_nonneg (|(k₂ : ℝ)| + 5))]

/-! ### The `L^2 × L^2 → L^1` decay of `T^{(k)}` (`eqn:HHT0`, `eqn:Tk-l2-decay`) -/

/-- Cauchy-Schwarz over the scales and orthogonality:
`∑_j ‖Δ_{j+k₁} f‖_2 ‖Δ_{2j+k₂} g‖_2 ≤ ‖f‖_2 ‖g‖_2` for all `k₁, k₂ ∈ ℤ`. -/
theorem sum_eLpNorm_lpD_mul_le_int (k₁ k₂ : ℤ) (F : Finset ℤ) {f g : ℝ × ℝ → ℂ}
    (hf : Measurable f) (hg : Measurable g) {A B : ℝ} (hA : ∀ z, ‖f z‖ ≤ A)
    (hB : ∀ z, ‖g z‖ ≤ B) (hfi : ∀ p, Integrable (monoFib 0 f p))
    (hgi : ∀ p, Integrable (monoFib 1 g p)) :
    ∑ j ∈ F, eLpNorm (lpD 0 (j + k₁) f) 2 volume * eLpNorm (lpD 1 (2 * j + k₂) g) 2 volume ≤
      eLpNorm f 2 volume * eLpNorm g 2 volume := by
  have hcs := ENNReal.inner_le_Lp_mul_Lq F (fun j => eLpNorm (lpD 0 (j + k₁) f) 2 volume)
    (fun j => eLpNorm (lpD 1 (2 * j + k₂) g) 2 volume) Real.HolderConjugate.two_two
  refine hcs.trans ?_
  have hsq : ∀ G : ℝ × ℝ → ℂ, eLpNorm G 2 volume ^ (2 : ℝ) = ∫⁻ z, ‖G z‖ₑ ^ 2 := by
    intro G
    rw [eLpNorm_two_eq_lintegral_nat, ← ENNReal.rpow_mul]; norm_num
  have h1 : ∑ j ∈ F, eLpNorm (lpD 0 (j + k₁) f) 2 volume ^ (2 : ℝ) ≤
      eLpNorm f 2 volume ^ (2 : ℝ) := by
    simp_rw [hsq]
    have hinj : Set.InjOn (fun j : ℤ => j + k₁) F := fun a _ b _ h => by simpa using h
    have := sum_lintegral_lpD_sq_le 0 (F.image fun j : ℤ => j + k₁) hf
      (fibL12_of_bdd 0 hA hfi) hA
    rwa [Finset.sum_image hinj] at this
  have h2 : ∑ j ∈ F, eLpNorm (lpD 1 (2 * j + k₂) g) 2 volume ^ (2 : ℝ) ≤
      eLpNorm g 2 volume ^ (2 : ℝ) := by
    simp_rw [hsq]
    have hinj : Set.InjOn (fun j : ℤ => 2 * j + k₂) F := fun a _ b _ h => by
      simp only at h; omega
    have := sum_lintegral_lpD_sq_le 1 (F.image fun j : ℤ => 2 * j + k₂) hg
      (fibL12_of_bdd 1 hB hgi) hB
    rwa [Finset.sum_image hinj] at this
  calc (∑ j ∈ F, eLpNorm (lpD 0 (j + k₁) f) 2 volume ^ (2 : ℝ)) ^ (1 / (2 : ℝ)) *
        (∑ j ∈ F, eLpNorm (lpD 1 (2 * j + k₂) g) 2 volume ^ (2 : ℝ)) ^ (1 / (2 : ℝ))
      ≤ (eLpNorm f 2 volume ^ (2 : ℝ)) ^ (1 / (2 : ℝ)) *
          (eLpNorm g 2 volume ^ (2 : ℝ)) ^ (1 / (2 : ℝ)) := by
        gcongr
    _ = _ := by
        rw [← ENNReal.rpow_mul, ← ENNReal.rpow_mul]; norm_num

theorem rpow_zpow_sub_one (δ : ℝ) (m : ℤ) :
    ((2 : ℝ) ^ (m - 1)) ^ (-δ) = 2 ^ δ * 2 ^ (-δ * (m : ℝ)) := by
  rw [← Real.rpow_intCast, ← Real.rpow_mul (by norm_num), ← Real.rpow_add (by norm_num)]
  congr 1; push_cast; ring

/-- **`eqn:HHT0`**: `‖T_j(Δ_{j+k₁} f, Δ_{2j+k₂} g)‖_1 ≲ 2^{-δ max(k₁,k₂)} ‖Δ f‖_2 ‖Δ g‖_2` for
`max(k₁, k₂) ≥ 1` (Theorem 5 through `Tj_gain`). -/
theorem Tj_piece_L1 : ∃ C δ : ℝ, 0 < C ∧ 0 < δ ∧ ∀ (j k₁ k₂ : ℤ), 1 ≤ max k₁ k₂ →
    ∀ {f g : ℝ × ℝ → ℂ}, Measurable f → Measurable g → ∀ {A B : ℝ}, (∀ z, ‖f z‖ ≤ A) →
    (∀ z, ‖g z‖ ≤ B) → (∀ p, Integrable (monoFib 0 f p)) → (∀ p, Integrable (monoFib 1 g p)) →
    eLpNorm f 2 volume ≠ ⊤ → eLpNorm g 2 volume ≠ ⊤ →
    eLpNorm (Tj j (lpD 0 (j + k₁) f) (lpD 1 (2 * j + k₂) g)) 1 volume ≤
      ENNReal.ofReal (C * (2 : ℝ) ^ (-δ * ((max k₁ k₂ : ℤ) : ℝ))) *
        (eLpNorm (lpD 0 (j + k₁) f) 2 volume * eLpNorm (lpD 1 (2 * j + k₂) g) 2 volume) := by
  obtain ⟨C, δ, hC, hδ, hG⟩ := Tj_gain
  refine ⟨2 * C * 2 ^ δ, δ, by positivity, hδ,
    fun j k₁ k₂ hk f g hf hg A B hA hB hfi hgi hf2 hg2 => ?_⟩
  set m₁ : ℤ := j + k₁ with hm₁
  set m₂ : ℤ := 2 * j + k₂ with hm₂
  have hΛ : (1 : ℝ) ≤ 2 ^ (max k₁ k₂ - 1) := one_le_zpow₀ (by norm_num) (by omega)
  have hD1 : ∀ z, ‖lpD 0 m₁ f z‖ ≤ 2 * ((∫ s, ‖monoKPhi s‖) * A) := norm_lpD_le 0 m₁ hA
  have hD2 : ∀ z, ‖lpD 1 m₂ g z‖ ≤ 2 * ((∫ s, ‖monoKPhi s‖) * B) := norm_lpD_le 1 m₂ hB
  have h2f : eLpNorm (lpD 0 m₁ f) 2 volume ≠ ⊤ :=
    ne_top_of_le_ne_top hf2 (eLpNorm_lpD_le 0 m₁ hf hA hfi)
  have h2g : eLpNorm (lpD 1 m₂ g) 2 volume ≠ ⊤ :=
    ne_top_of_le_ne_top hg2 (eLpNorm_lpD_le 1 m₂ hg hB hgi)
  have hmain := hG j _ hΛ _ _ (measurable_lpD 0 m₁ hf) (measurable_lpD 1 m₂ hg) _ _ hD1 hD2
    (integrable_fib_lpD 0 m₁ hfi) (integrable_fib_lpD 1 m₂ hgi) h2f h2g (by
      rcases le_total k₂ k₁ with hk' | hk'
      · left
        intro p ξ hξ
        refine lpD_fourier_eq_zero 0 m₁ hfi p ξ (lt_of_lt_of_le hξ (le_of_eq ?_))
        rw [max_eq_left hk', ← zpow_add₀ (by norm_num)]
        congr 1; rw [hm₁]; ring
      · right
        intro p ξ hξ
        refine lpD_fourier_eq_zero 1 m₂ hgi p ξ (lt_of_lt_of_le hξ (le_of_eq ?_))
        rw [max_eq_right hk', ← zpow_natCast (2 ^ j : ℝ) 2, ← zpow_mul,
          ← zpow_add₀ (by norm_num)]
        congr 1; rw [hm₂]; push_cast; ring)
  refine hmain.trans (le_of_eq ?_)
  rw [rpow_zpow_sub_one]; congr 2; ring

/-- **`eqn:Tk-l2-decay`**: for `max(k₁, k₂) ≥ 1`, finite `F ⊆ ℤ` and measurable bounded
integrable `f₁, f₂`, `‖T^{(k)}_F(f₁, f₂)‖_1 ≤ C 2^{-δ max(k₁,k₂)} ‖f₁‖_2 ‖f₂‖_2`. -/
theorem TkF_L2 : ∃ C δ : ℝ, 0 < C ∧ 0 < δ ∧ ∀ (k₁ k₂ : ℤ), 1 ≤ max k₁ k₂ →
    ∀ (F : Finset ℤ) {f₁ f₂ : ℝ × ℝ → ℂ}, Measurable f₁ → Measurable f₂ → Integrable f₁ →
    Integrable f₂ → ∀ {A B : ℝ}, (∀ z, ‖f₁ z‖ ≤ A) → (∀ z, ‖f₂ z‖ ≤ B) →
    eLpNorm (TkF k₁ k₂ F f₁ f₂) 1 volume ≤
      ENNReal.ofReal (C * (2 : ℝ) ^ (-δ * ((max k₁ k₂ : ℤ) : ℝ))) * eLpNorm f₁ 2 volume *
        eLpNorm f₂ 2 volume := by
  obtain ⟨C, δ, hC, hδ, hP⟩ := Tj_piece_L1
  refine ⟨C, δ, hC, hδ, fun k₁ k₂ hk F f g hf hg hfi hgi A B hA hB => ?_⟩
  obtain ⟨f', hf'm, hf'b, hf'i, Nf, hNf, hf'e⟩ := exists_fib_integrable_modification 0 hf hfi hA
  obtain ⟨g', hg'm, hg'b, hg'i, Ng, hNg, hg'e⟩ := exists_fib_integrable_modification 1 hg hgi hB
  have hff : f' =ᵐ[volume] f := ae_eq_of_fib_modification 0 hNf hf'e
  have hgg : g' =ᵐ[volume] g := ae_eq_of_fib_modification 1 hNg hg'e
  have hf2 : eLpNorm f' 2 volume ≠ ⊤ := by
    rw [eLpNorm_congr_ae hff]; exact (memLp_two_of_bdd' hfi hA).eLpNorm_ne_top
  have hg2 : eLpNorm g' 2 volume ≠ ⊤ := by
    rw [eLpNorm_congr_ae hgg]; exact (memLp_two_of_bdd' hgi hB).eLpNorm_ne_top
  rw [← eLpNorm_congr_ae (TkF_ae_congr k₁ k₂ F hNf hNg hf'e hg'e), ← eLpNorm_congr_ae hff,
    ← eLpNorm_congr_ae hgg]
  set c := ENNReal.ofReal (C * (2 : ℝ) ^ (-δ * ((max k₁ k₂ : ℤ) : ℝ)))
  calc eLpNorm (TkF k₁ k₂ F f' g') 1 volume
      ≤ ∑ j ∈ F, eLpNorm (Tj j (lpD 0 (j + k₁) f') (lpD 1 (2 * j + k₂) g')) 1 volume :=
        eLpNorm_sum_le (fun j _ => (measurable_Tj j (measurable_lpD 0 _ hf'm)
          (measurable_lpD 1 _ hg'm)).aestronglyMeasurable) le_rfl
    _ ≤ ∑ j ∈ F, c * (eLpNorm (lpD 0 (j + k₁) f') 2 volume *
          eLpNorm (lpD 1 (2 * j + k₂) g') 2 volume) :=
        Finset.sum_le_sum fun j _ => hP j k₁ k₂ hk hf'm hg'm hf'b hg'b hf'i hg'i hf2 hg2
    _ = c * ∑ j ∈ F, eLpNorm (lpD 0 (j + k₁) f') 2 volume *
          eLpNorm (lpD 1 (2 * j + k₂) g') 2 volume := by rw [Finset.mul_sum]
    _ ≤ c * (eLpNorm f' 2 volume * eLpNorm g' 2 volume) := by
        gcongr
        exact sum_eLpNorm_lpD_mul_le_int k₁ k₂ F hf'm hg'm hf'b hg'b hf'i hg'i
    _ = _ := by rw [mul_assoc]

/-! ### Bilinearity of `T^{(k)}_F` on simple functions -/

theorem TkF_add_left (k₁ k₂ : ℤ) (F : Finset ℤ) {f f' g : ℝ × ℝ → ℂ} (hf : Measurable f)
    (hf' : Measurable f') (hg : Measurable g) {A A' B : ℝ} (hA : ∀ z, ‖f z‖ ≤ A)
    (hA' : ∀ z, ‖f' z‖ ≤ A') (hB : ∀ z, ‖g z‖ ≤ B) :
    TkF k₁ k₂ F (f + f') g = TkF k₁ k₂ F f g + TkF k₁ k₂ F f' g := by
  unfold TkF
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [lpD_add 0 _ hf hf' hA hA', Tj_add_left _ (measurable_lpD 0 _ hf) (measurable_lpD 0 _ hf')
    (measurable_lpD 1 _ hg) (norm_lpD_le 0 _ hA) (norm_lpD_le 0 _ hA') (norm_lpD_le 1 _ hB)]

theorem TkF_add_right (k₁ k₂ : ℤ) (F : Finset ℤ) {f g g' : ℝ × ℝ → ℂ} (hf : Measurable f)
    (hg : Measurable g) (hg' : Measurable g') {A B B' : ℝ} (hA : ∀ z, ‖f z‖ ≤ A)
    (hB : ∀ z, ‖g z‖ ≤ B) (hB' : ∀ z, ‖g' z‖ ≤ B') :
    TkF k₁ k₂ F f (g + g') = TkF k₁ k₂ F f g + TkF k₁ k₂ F f g' := by
  unfold TkF
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [lpD_add 1 _ hg hg' hB hB', Tj_add_right _ (measurable_lpD 0 _ hf) (measurable_lpD 1 _ hg)
    (measurable_lpD 1 _ hg') (norm_lpD_le 0 _ hA) (norm_lpD_le 1 _ hB) (norm_lpD_le 1 _ hB')]

theorem TkF_smul_left (k₁ k₂ : ℤ) (F : Finset ℤ) (c : ℂ) (f g : ℝ × ℝ → ℂ) :
    TkF k₁ k₂ F (c • f) g = c • TkF k₁ k₂ F f g := by
  unfold TkF
  rw [Finset.smul_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [lpD_smul, Tj_smul_left]

theorem TkF_smul_right (k₁ k₂ : ℤ) (F : Finset ℤ) (c : ℂ) (f g : ℝ × ℝ → ℂ) :
    TkF k₁ k₂ F f (c • g) = c • TkF k₁ k₂ F f g := by
  unfold TkF
  rw [Finset.smul_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [lpD_smul, Tj_smul_right]

/-- `T^{(k)}_F` as a bilinear map on simple functions. -/
def TkSel (k₁ k₂ : ℤ) (F : Finset ℤ) :
    SimpleFunc (ℝ × ℝ) ℂ →ₗ[ℂ] SimpleFunc (ℝ × ℝ) ℂ →ₗ[ℂ] (ℝ × ℝ → ℂ) :=
  LinearMap.mk₂ ℂ (fun f g => TkF k₁ k₂ F f g)
    (fun f f' g => by
      obtain ⟨A, hA⟩ := f.exists_forall_norm_le
      obtain ⟨A', hA'⟩ := f'.exists_forall_norm_le
      obtain ⟨B, hB⟩ := g.exists_forall_norm_le
      simp only [SimpleFunc.coe_add]
      exact TkF_add_left k₁ k₂ F f.measurable f'.measurable g.measurable hA hA' hB)
    (fun c f g => by
      simp only [SimpleFunc.coe_smul]
      exact TkF_smul_left k₁ k₂ F c f g)
    (fun f g g' => by
      obtain ⟨A, hA⟩ := f.exists_forall_norm_le
      obtain ⟨B, hB⟩ := g.exists_forall_norm_le
      obtain ⟨B', hB'⟩ := g'.exists_forall_norm_le
      simp only [SimpleFunc.coe_add]
      exact TkF_add_right k₁ k₂ F f.measurable g.measurable g'.measurable hA hB hB')
    (fun c f g => by
      simp only [SimpleFunc.coe_smul]
      exact TkF_smul_right k₁ k₂ F c f g)

theorem TkSel_apply (k₁ k₂ : ℤ) (F : Finset ℤ) (f g : SimpleFunc (ℝ × ℝ) ℂ) :
    TkSel k₁ k₂ F f g = TkF k₁ k₂ F f g := rfl

/-! ### Interpolation (§2.3, lines 549-550) -/

/-- **The interpolated bound for `T^{(k)}_F` on simple functions**: interpolation between the
`L^2 × L^2 → L^1` decay `TkF_L2` and the polynomial bound `TkF_poly` at an endpoint
`(p₁, q₁, r₁)` on the ray from `(1/2, 1/2)` through `(1/p, 1/q)`. -/
theorem TkF_interp_simple {p q r : ℝ} (hp : 1 < p) (hq : 1 < q) (hr : 1 ≤ r)
    (hpqr : 1 / p + 1 / q = 1 / r) :
    ∃ θ C₀ δ K : ℝ, θ ∈ Ioo 0 1 ∧ 0 < C₀ ∧ 0 < δ ∧ 0 ≤ K ∧ ∀ (k₁ k₂ : ℤ), 1 ≤ max k₁ k₂ →
    ∀ (F : Finset ℤ) (f g : SimpleFunc (ℝ × ℝ) ℂ), Integrable f → Integrable g →
    eLpNorm (TkF k₁ k₂ F f g) (ENNReal.ofReal r) volume ≤
      ENNReal.ofReal ((C₀ * (2 : ℝ) ^ (-δ * ((max k₁ k₂ : ℤ) : ℝ))) ^ (1 - θ) *
        (K * (|(k₂ : ℝ)| + 5) ^ 2 + 1) ^ θ) *
        eLpNorm (f : ℝ × ℝ → ℂ) (ENNReal.ofReal p) volume *
          eLpNorm (g : ℝ × ℝ → ℂ) (ENNReal.ofReal q) volume := by
  obtain ⟨ε, p₁, q₁, r₁, hε0, hε1, hp₁, hq₁, hr₁, hpqr₁, ep, eq, er⟩ :=
    interp_endpoint hp hq hr hpqr
  obtain ⟨K, hK, hH⟩ := TkF_poly hp₁ hq₁ hr₁ hpqr₁
  obtain ⟨C, δ, hC, hδ, hL2⟩ := TkF_L2
  refine ⟨1 - ε, C, δ, K, ⟨by linarith, by linarith⟩, hC, hδ, hK,
    fun k₁ k₂ hk F f g hf hg => ?_⟩
  have hB₀ : ∀ (f g : SimpleFunc (ℝ × ℝ) ℂ), Integrable f → Integrable g →
      eLpNorm (TkSel k₁ k₂ F f g) 1 volume ≤
        ENNReal.ofReal (C * (2 : ℝ) ^ (-δ * ((max k₁ k₂ : ℤ) : ℝ))) *
          eLpNorm (f : ℝ × ℝ → ℂ) 2 volume * eLpNorm (g : ℝ × ℝ → ℂ) 2 volume := by
    intro f g hf hg
    obtain ⟨A, hA⟩ := f.exists_forall_norm_le
    obtain ⟨B, hB⟩ := g.exists_forall_norm_le
    exact hL2 k₁ k₂ hk F f.measurable g.measurable hf hg hA hB
  have hBm : ∀ (f g : SimpleFunc (ℝ × ℝ) ℂ), Measurable (TkSel k₁ k₂ F f g) := fun f g =>
    measurable_TkF k₁ k₂ F f.measurable g.measurable
  have hBi : ∀ (f g : SimpleFunc (ℝ × ℝ) ℂ), Integrable f → Integrable g →
      Integrable (TkSel k₁ k₂ F f g) := by
    intro f g hf hg
    obtain ⟨A, hA⟩ := f.exists_forall_norm_le
    obtain ⟨B, hB⟩ := g.exists_forall_norm_le
    rw [← memLp_one_iff_integrable]
    refine ⟨(hBm f g).aestronglyMeasurable, lt_of_le_of_lt (hB₀ f g hf hg) ?_⟩
    exact ENNReal.mul_lt_top (ENNReal.mul_lt_top ENNReal.ofReal_lt_top
      (memLp_two_of_bdd' hf hA).eLpNorm_lt_top) (memLp_two_of_bdd' hg hB).eLpNorm_lt_top
  have hB₁ : ∀ (f g : SimpleFunc (ℝ × ℝ) ℂ), Integrable f → Integrable g →
      eLpNorm (TkSel k₁ k₂ F f g) (ENNReal.ofReal r₁) volume ≤
        ENNReal.ofReal (K * (|(k₂ : ℝ)| + 5) ^ 2 + 1) *
          eLpNorm (f : ℝ × ℝ → ℂ) (ENNReal.ofReal p₁) volume *
            eLpNorm (g : ℝ × ℝ → ℂ) (ENNReal.ofReal q₁) volume := by
    intro f g hf hg
    obtain ⟨A, hA⟩ := f.exists_forall_norm_le
    obtain ⟨B, hB⟩ := g.exists_forall_norm_le
    refine (hH k₁ k₂ F f.measurable g.measurable hf hg hA hB).trans ?_
    gcongr ENNReal.ofReal ?_ * _ * _
    linarith
  have h2 : (1 : ℝ≥0∞) ≤ 2 := by norm_num
  have hp₁' : (1 : ℝ≥0∞) ≤ ENNReal.ofReal p₁ := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp₁.le
  have hq₁' : (1 : ℝ≥0∞) ≤ ENNReal.ofReal q₁ := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hq₁.le
  have hr₁' : (1 : ℝ≥0∞) ≤ ENNReal.ofReal r₁ := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hr₁
  have hres := bilinear_interpolation (TkSel k₁ k₂ F) hBm hBi
    (p₀ := 2) (q₀ := 2) (r₀ := 1) (p₁ := ENNReal.ofReal p₁) (q₁ := ENNReal.ofReal q₁)
    (r₁ := ENNReal.ofReal r₁) (p := ENNReal.ofReal p) (q := ENNReal.ofReal q)
    (r := ENNReal.ofReal r) h2 hp₁' h2 hq₁' le_rfl hr₁'
    (θ := 1 - ε) ⟨by linarith, by linarith⟩ ?_ ?_ ?_ ENNReal.ofReal_ne_top
    (M₀ := C * (2 : ℝ) ^ (-δ * ((max k₁ k₂ : ℤ) : ℝ))) (M₁ := K * (|(k₂ : ℝ)| + 5) ^ 2 + 1)
    (by positivity) (by positivity) hB₀ hB₁ f g hf hg
  · rw [TkSel_apply] at hres
    exact hres
  · rw [show (2 : ℝ≥0∞) = ENNReal.ofReal 2 by simp]
    exact ennreal_inv_interp (by norm_num) (by linarith) (by linarith) (by linarith)
      (by linarith) (by rw [ep]; ring)
  · rw [show (2 : ℝ≥0∞) = ENNReal.ofReal 2 by simp]
    exact ennreal_inv_interp (by norm_num) (by linarith) (by linarith) (by linarith)
      (by linarith) (by rw [eq]; ring)
  · rw [show (1 : ℝ≥0∞) = ENNReal.ofReal 1 by simp]
    exact ennreal_inv_interp (by norm_num) (by linarith) (by linarith) (by linarith)
      (by linarith) (by rw [er]; ring)

theorem TkF_tendsto (k₁ k₂ : ℤ) (F : Finset ℤ) {G₁ G₂ : ℕ → ℝ × ℝ → ℂ} {H₁ H₂ : ℝ × ℝ → ℂ}
    (hG₁ : ∀ n, Measurable (G₁ n)) (hG₂ : ∀ n, Measurable (G₂ n)) (hH₁ : Measurable H₁)
    (hH₂ : Measurable H₂) {M₁ M₂ : ℝ} (hM₁ : ∀ n z, ‖G₁ n z‖ ≤ M₁) (hM₂ : ∀ n z, ‖G₂ n z‖ ≤ M₂)
    (hN₁ : ∀ z, ‖H₁ z‖ ≤ M₁) (hN₂ : ∀ z, ‖H₂ z‖ ≤ M₂)
    (hl₁ : ∀ z, Tendsto (fun n => G₁ n z) atTop (𝓝 (H₁ z)))
    (hl₂ : ∀ z, Tendsto (fun n => G₂ n z) atTop (𝓝 (H₂ z))) (z : ℝ × ℝ) :
    Tendsto (fun n => TkF k₁ k₂ F (G₁ n) (G₂ n) z) atTop (𝓝 (TkF k₁ k₂ F H₁ H₂ z)) := by
  simp_rw [TkF_apply]
  refine tendsto_finsetSum _ fun j _ => ?_
  exact Tj_tendsto j (fun n => measurable_lpD 0 _ (hG₁ n)) (fun n => measurable_lpD 1 _ (hG₂ n))
    (fun n => norm_lpD_le 0 _ (hM₁ n)) (fun n => norm_lpD_le 1 _ (hM₂ n))
    (lpD_tendsto 0 _ hG₁ hH₁ hM₁ hN₁ hl₁) (lpD_tendsto 1 _ hG₂ hH₂ hM₂ hN₂ hl₂) z

/-- **The interpolated bound for bounded integrable functions** (simple-function approximation
and Fatou's lemma). -/
theorem TkF_interp {p q r : ℝ} (hp : 1 < p) (hq : 1 < q) (hr : 1 ≤ r)
    (hpqr : 1 / p + 1 / q = 1 / r) :
    ∃ θ C₀ δ K : ℝ, θ ∈ Ioo 0 1 ∧ 0 < C₀ ∧ 0 < δ ∧ 0 ≤ K ∧ ∀ (k₁ k₂ : ℤ), 1 ≤ max k₁ k₂ →
    ∀ (F : Finset ℤ) {a b : ℝ × ℝ → ℂ}, Measurable a → Measurable b →
    Integrable a → Integrable b → ∀ {A B : ℝ}, (∀ z, ‖a z‖ ≤ A) → (∀ z, ‖b z‖ ≤ B) →
    eLpNorm (TkF k₁ k₂ F a b) (ENNReal.ofReal r) volume ≤
      4 * ENNReal.ofReal ((C₀ * (2 : ℝ) ^ (-δ * ((max k₁ k₂ : ℤ) : ℝ))) ^ (1 - θ) *
        (K * (|(k₂ : ℝ)| + 5) ^ 2 + 1) ^ θ) *
        eLpNorm a (ENNReal.ofReal p) volume * eLpNorm b (ENNReal.ofReal q) volume := by
  obtain ⟨θ, C₀, δ, K, hθ, hC₀, hδ, hK, hI⟩ := TkF_interp_simple hp hq hr hpqr
  refine ⟨θ, C₀, δ, K, hθ, hC₀, hδ, hK, fun k₁ k₂ hk F a b ha hb hai hbi A B hA hB => ?_⟩
  set c := ENNReal.ofReal ((C₀ * (2 : ℝ) ^ (-δ * ((max k₁ k₂ : ℤ) : ℝ))) ^ (1 - θ) *
    (K * (|(k₂ : ℝ)| + 5) ^ 2 + 1) ^ θ)
  set an := fun n => (sApprox ha n : ℝ × ℝ → ℂ)
  set bn := fun n => (sApprox hb n : ℝ × ℝ → ℂ)
  have hanb : ∀ n z, ‖an n z‖ ≤ 2 * A := fun n z =>
    (norm_sApprox_le ha n z).trans (by linarith [hA z])
  have hbnb : ∀ n z, ‖bn n z‖ ≤ 2 * B := fun n z =>
    (norm_sApprox_le hb n z).trans (by linarith [hB z])
  have hA0 : 0 ≤ A := (norm_nonneg _).trans (hA 0)
  have hB0 : 0 ≤ B := (norm_nonneg _).trans (hB 0)
  have hlim : ∀ z, Tendsto (fun n => TkF k₁ k₂ F (an n) (bn n) z) atTop
      (𝓝 (TkF k₁ k₂ F a b z)) :=
    TkF_tendsto k₁ k₂ F (fun n => (sApprox ha n).measurable) (fun n => (sApprox hb n).measurable)
      ha hb hanb hbnb (fun z => (hA z).trans (by linarith)) (fun z => (hB z).trans (by linarith))
      (sApprox_tendsto ha) (sApprox_tendsto hb)
  have hmeas : ∀ n, AEStronglyMeasurable (TkF k₁ k₂ F (an n) (bn n)) volume := fun n =>
    (measurable_TkF k₁ k₂ F (sApprox ha n).measurable
      (sApprox hb n).measurable).aestronglyMeasurable
  refine (Lp.eLpNorm_lim_le_liminf_eLpNorm hmeas _ (Eventually.of_forall hlim)).trans ?_
  have hbd : ∀ n, eLpNorm (TkF k₁ k₂ F (an n) (bn n)) (ENNReal.ofReal r) volume ≤
      4 * c * eLpNorm a (ENNReal.ofReal p) volume * eLpNorm b (ENNReal.ofReal q) volume := by
    intro n
    refine (hI k₁ k₂ hk F (sApprox ha n) (sApprox hb n) (integrable_sApprox ha hai n)
      (integrable_sApprox hb hbi n)).trans ?_
    calc c * eLpNorm (an n) (ENNReal.ofReal p) volume * eLpNorm (bn n) (ENNReal.ofReal q) volume
        ≤ c * (2 * eLpNorm a (ENNReal.ofReal p) volume) *
            (2 * eLpNorm b (ENNReal.ofReal q) volume) := by
          gcongr
          · exact eLpNorm_sApprox_le ha n _
          · exact eLpNorm_sApprox_le hb n _
      _ = _ := by ring
  refine (Filter.liminf_le_liminf (Eventually.of_forall hbd)).trans ?_
  rw [Filter.liminf_const]

/-! ### Exponential decay of `T^{(k)}` on `𝔉_H` -/

theorem sq_mul_two_rpow_le {a : ℝ} (ha : 0 < a) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 0 ≤ x →
      x ^ 2 * (2 : ℝ) ^ (-a * x) ≤ C * (2 : ℝ) ^ (-(a / 2) * x) := by
  set b := Real.log 2 * (a / 2) with hb
  have hb0 : 0 < b := mul_pos (Real.log_pos one_lt_two) (by positivity)
  refine ⟨2 / b ^ 2, by positivity, fun x hx => ?_⟩
  have e1 : (2 : ℝ) ^ (-a * x) = (2 : ℝ) ^ (-(a / 2) * x) * (2 : ℝ) ^ (-(a / 2) * x) := by
    rw [← Real.rpow_add (by norm_num)]; ring_nf
  have e2 : (2 : ℝ) ^ (-(a / 2) * x) = Real.exp (-(b * x)) := by
    rw [Real.rpow_def_of_pos (by norm_num), hb]; ring_nf
  have hbx : 0 ≤ b * x := mul_nonneg hb0.le hx
  have hexp := Real.quadratic_le_exp_of_nonneg hbx
  have key : x ^ 2 * Real.exp (-(b * x)) ≤ 2 / b ^ 2 := by
    rw [Real.exp_neg, ← div_eq_mul_inv, div_le_div_iff₀ (Real.exp_pos _) (by positivity)]
    nlinarith [sq_nonneg (b * x)]
  calc x ^ 2 * (2 : ℝ) ^ (-a * x)
      = (x ^ 2 * (2 : ℝ) ^ (-(a / 2) * x)) * (2 : ℝ) ^ (-(a / 2) * x) := by rw [e1]; ring
    _ ≤ (2 / b ^ 2) * (2 : ℝ) ^ (-(a / 2) * x) := by
        gcongr
        rw [e2]; exact key

theorem abs_add_five_le_of_mem {k₁ k₂ : ℤ} (hk : 0 < max k₁ k₂) (hd : |k₁ - k₂| ≤ 100) :
    |(k₂ : ℝ)| + 5 ≤ 106 * ((max k₁ k₂ : ℤ) : ℝ) := by
  have hm : (1 : ℝ) ≤ ((max k₁ k₂ : ℤ) : ℝ) := by exact_mod_cast hk
  have h2 : k₂ ≤ max k₁ k₂ := le_max_right _ _
  have h3 : -(max k₁ k₂) - 100 ≤ k₂ := by
    rw [abs_le] at hd
    rcases le_total k₁ k₂ with h | h
    · rw [max_eq_right h]; omega
    · rw [max_eq_left h]; omega
  have h2' : (k₂ : ℝ) ≤ ((max k₁ k₂ : ℤ) : ℝ) := by exact_mod_cast h2
  have h3' : -((max k₁ k₂ : ℤ) : ℝ) - 100 ≤ (k₂ : ℝ) := by exact_mod_cast h3
  rw [abs_le'] at *
  have : |(k₂ : ℝ)| ≤ ((max k₁ k₂ : ℤ) : ℝ) + 100 := abs_le.2 ⟨by linarith, by linarith⟩
  linarith

/-- **The high-frequency bound for `T^{(k)}`** (§2.3): for `p, q ∈ (1, ∞)`, `r ∈ [1, ∞)` with
`1/p + 1/q = 1/r` there are `C, δ > 0` such that for all `k = (k₁, k₂) ∈ 𝔉_H`
(`max(k₁, k₂) > 0`, `|k₁ - k₂| ≤ 100`), all finite sets of scales `F ⊆ ℤ` and all measurable
bounded integrable `f₁, f₂`,
`‖∑_{j ∈ F} T_j(Δ^{(1)}_{j+k₁} f₁, Δ^{(2)}_{2j+k₂} f₂)‖_r ≤ C 2^{-δ max(k₁,k₂)} ‖f₁‖_p ‖f₂‖_q`. -/
theorem TkF_decay {p q r : ℝ} (hp : 1 < p) (hq : 1 < q) (hr : 1 ≤ r)
    (hpqr : 1 / p + 1 / q = 1 / r) :
    ∃ C δ : ℝ, 0 < C ∧ 0 < δ ∧ ∀ (k₁ k₂ : ℤ), 0 < max k₁ k₂ → |k₁ - k₂| ≤ 100 →
    ∀ (F : Finset ℤ) {f₁ f₂ : ℝ × ℝ → ℂ}, Measurable f₁ → Measurable f₂ →
    Integrable f₁ → Integrable f₂ → ∀ {A B : ℝ}, (∀ z, ‖f₁ z‖ ≤ A) → (∀ z, ‖f₂ z‖ ≤ B) →
    eLpNorm (TkF k₁ k₂ F f₁ f₂) (ENNReal.ofReal r) volume ≤
      ENNReal.ofReal (C * (2 : ℝ) ^ (-δ * ((max k₁ k₂ : ℤ) : ℝ))) *
        eLpNorm f₁ (ENNReal.ofReal p) volume * eLpNorm f₂ (ENNReal.ofReal q) volume := by
  obtain ⟨θ, C₀, δ, K, hθ, hC₀, hδ, hK, hI⟩ := TkF_interp hp hq hr hpqr
  have ha : 0 < δ * (1 - θ) := mul_pos hδ (by linarith [hθ.2])
  obtain ⟨D, hD, hsq⟩ := sq_mul_two_rpow_le ha
  refine ⟨4 * (C₀ ^ (1 - θ) * (K * 106 ^ 2 + 1) * D), δ * (1 - θ) / 2, by positivity,
    by positivity, fun k₁ k₂ hk hd F f₁ f₂ hf₁ hf₂ hi₁ hi₂ A B hA hB => ?_⟩
  refine (hI k₁ k₂ hk F hf₁ hf₂ hi₁ hi₂ hA hB).trans ?_
  set m : ℝ := ((max k₁ k₂ : ℤ) : ℝ) with hm
  have hm1 : (1 : ℝ) ≤ m := by rw [hm]; exact_mod_cast hk
  have hk₂ := abs_add_five_le_of_mem hk hd
  rw [← hm] at hk₂
  have hpoly : (K * (|(k₂ : ℝ)| + 5) ^ 2 + 1) ^ θ ≤ (K * 106 ^ 2 + 1) * m ^ 2 := by
    have hb : 1 ≤ K * (|(k₂ : ℝ)| + 5) ^ 2 + 1 := by
      nlinarith [mul_nonneg hK (sq_nonneg (|(k₂ : ℝ)| + 5))]
    calc (K * (|(k₂ : ℝ)| + 5) ^ 2 + 1) ^ θ ≤ (K * (|(k₂ : ℝ)| + 5) ^ 2 + 1) ^ (1 : ℝ) :=
          Real.rpow_le_rpow_of_exponent_le hb hθ.2.le
      _ = K * (|(k₂ : ℝ)| + 5) ^ 2 + 1 := Real.rpow_one _
      _ ≤ K * (106 * m) ^ 2 + 1 * m ^ 2 := by
          gcongr; nlinarith
      _ = (K * 106 ^ 2 + 1) * m ^ 2 := by ring
  have hdec : (C₀ * (2 : ℝ) ^ (-δ * m)) ^ (1 - θ) =
      C₀ ^ (1 - θ) * (2 : ℝ) ^ (-(δ * (1 - θ)) * m) := by
    rw [Real.mul_rpow hC₀.le (by positivity), ← Real.rpow_mul (by norm_num)]
    congr 2; ring
  have hfin : (C₀ * (2 : ℝ) ^ (-δ * m)) ^ (1 - θ) * (K * (|(k₂ : ℝ)| + 5) ^ 2 + 1) ^ θ ≤
      C₀ ^ (1 - θ) * (K * 106 ^ 2 + 1) * D * (2 : ℝ) ^ (-(δ * (1 - θ) / 2) * m) := by
    rw [hdec]
    calc C₀ ^ (1 - θ) * (2 : ℝ) ^ (-(δ * (1 - θ)) * m) * (K * (|(k₂ : ℝ)| + 5) ^ 2 + 1) ^ θ
        ≤ C₀ ^ (1 - θ) * (2 : ℝ) ^ (-(δ * (1 - θ)) * m) * ((K * 106 ^ 2 + 1) * m ^ 2) := by
          gcongr
      _ = C₀ ^ (1 - θ) * (K * 106 ^ 2 + 1) * (m ^ 2 * (2 : ℝ) ^ (-(δ * (1 - θ)) * m)) := by
          ring
      _ ≤ C₀ ^ (1 - θ) * (K * 106 ^ 2 + 1) * (D * (2 : ℝ) ^ (-(δ * (1 - θ) / 2) * m)) := by
          exact mul_le_mul_of_nonneg_left (hsq m (by linarith)) (by positivity)
      _ = _ := by ring
  have h4 : (4 : ℝ≥0∞) = ENNReal.ofReal 4 := by simp
  rw [h4, ← ENNReal.ofReal_mul (by norm_num)]
  gcongr ENNReal.ofReal ?_ * _ * _
  calc 4 * ((C₀ * (2 : ℝ) ^ (-δ * m)) ^ (1 - θ) * (K * (|(k₂ : ℝ)| + 5) ^ 2 + 1) ^ θ)
      ≤ 4 * (C₀ ^ (1 - θ) * (K * 106 ^ 2 + 1) * D * (2 : ℝ) ^ (-(δ * (1 - θ) / 2) * m)) := by
        gcongr
    _ = _ := by ring_nf

end

