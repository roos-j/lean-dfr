    Real.rpow_le_rpow_of_exponent_le (by linarith [abs_nonneg x]) (by linarith)
  obtain ⟨d₁, -, b₁, b₁'⟩ := H₁ Φ' hΦ fun x => (hdΦ x).trans (hmono x)
  obtain ⟨d₂, -, b₂, b₂'⟩ := H₂ Ψ' hΨ fun x => (hdΨ x).trans (hmono x)
  have hw : ∀ u : ℝ, 0 ≤ (1 + |u|) ^ (-12 : ℝ) := fun u => by positivity
  have l₁ : ∀ u : ℝ, A₁ * (1 + |u|) ^ (-12 : ℝ) ≤ (A₁ + A₂) * (1 + |u|) ^ (-12 : ℝ) :=
    fun u => mul_le_mul_of_nonneg_right (by linarith) (hw u)
  have l₂ : ∀ u : ℝ, A₂ * (1 + |u|) ^ (-12 : ℝ) ≤ (A₁ + A₂) * (1 + |u|) ^ (-12 : ℝ) :=
    fun u => mul_le_mul_of_nonneg_right (by linarith) (hw u)
  exact ⟨d₁, d₂, fun u => (b₁ u).trans (l₁ u), fun u => (b₁' u).trans (l₁ u),
    fun u => (b₂ u).trans (l₂ u), fun u => (b₂' u).trans (l₂ u)⟩

/-! ### Bounds for the inner integrals -/

theorem integral_kernelAt_left' (ρ : ℝ → ℝ) {s : ℝ} (hs : 0 < s) (x : ℝ) :
    ∫ y', kernelAt ρ s y' x = ∫ u, ρ u := by
  simp_rw [FiberCZ.kernelAt_eq]
  rw [integral_const_mul, integral_sub_left_eq_self (fun u => ρ (u / s)) volume x,
    Measure.integral_comp_div (fun u => ρ u) s, abs_of_pos hs, smul_eq_mul, ← mul_assoc,
    inv_mul_cancel₀ hs.ne', one_mul]

/-- `|(f₁ *₁ φ_s)(z)| ≤ ‖φ‖_∞ s⁻¹ ∫ |f₁(x', z₂)| dx'`. -/
theorem norm_inner1_le_of_bdd {φ : ℝ → ℝ} {Bφ : ℝ} (hφB : ∀ u, |φ u| ≤ Bφ)
    {f₁ : ℝ × ℝ → ℂ} (z : ℝ × ℝ) (hfib : Integrable fun x' => f₁ (x', z.2)) (α : ℕ) {t : ℝ}
    (ht : 0 < t) :
    ‖FiberCZ.inner1 α φ f₁ t z‖ ≤ Bφ * (t ^ α)⁻¹ * ∫ x', ‖f₁ (x', z.2)‖ := by
  unfold FiberCZ.inner1
  rw [← integral_const_mul]
  refine norm_integral_le_of_norm_le (hfib.norm.const_mul _) (Eventually.of_forall fun x' => ?_)
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, FiberCZ.kernelAt_eq, abs_mul,
    abs_of_pos (inv_pos.2 (pow_pos ht α))]
  have h1 := hφB ((z.1 - x') / t ^ α)
  have h0 : 0 ≤ (t ^ α)⁻¹ := by positivity
  calc ‖f₁ (x', z.2)‖ * ((t ^ α)⁻¹ * |φ ((z.1 - x') / t ^ α)|)
      ≤ ‖f₁ (x', z.2)‖ * ((t ^ α)⁻¹ * Bφ) := by gcongr
    _ = Bφ * (t ^ α)⁻¹ * ‖f₁ (x', z.2)‖ := by ring

/-- Mean zero and the Lipschitz bound: `|(f₂ *₂ ρ_s)(z)| ≤ L s ∫ |u| |ρ(u)| du`. -/
theorem norm_inner2_le_of_lip {ρ : ℝ → ℝ} (iρ : Integrable ρ)
    (iρ1 : Integrable fun u => |u| * |ρ u|) (hρ0 : ∫ u, ρ u = 0) {f₂ : ℝ × ℝ → ℂ}
    (h₂ : Measurable f₂) {M₂ : ℝ} (hM₂ : ∀ z, ‖f₂ z‖ ≤ M₂) {L : ℝ}
    (hL : ∀ x y y', ‖f₂ (x, y) - f₂ (x, y')‖ ≤ L * |y - y'|) (β : ℕ) {t : ℝ} (ht : 0 < t)
    (z : ℝ × ℝ) :
    ‖FiberCZ.inner2 β ρ f₂ t z‖ ≤ L * t ^ β * ∫ u, |u| * |ρ u| := by
  have hs : 0 < t ^ β := pow_pos ht β
  unfold FiberCZ.inner2
  have hsec : Measurable fun y' => f₂ (z.1, y') :=
    h₂.comp (measurable_const.prodMk measurable_id)
  have i1 : Integrable fun y' => f₂ (z.1, y') * ((kernelAt ρ (t ^ β) y' z.2 : ℝ) : ℂ) :=
    FiberCZ.integrable_mul_kernelAt hsec (fun _ => hM₂ _) iρ hs z.2
  have i2 : Integrable fun y' => f₂ (z.1, z.2) * ((kernelAt ρ (t ^ β) y' z.2 : ℝ) : ℂ) :=
    ((FiberCZ.integrable_kernelAt iρ hs z.2).ofReal).const_mul _
  have hz : ∫ y', f₂ (z.1, z.2) * ((kernelAt ρ (t ^ β) y' z.2 : ℝ) : ℂ) = 0 := by
    rw [integral_const_mul, integral_complex_ofReal, integral_kernelAt_left' ρ hs, hρ0]
    simp
  have e : ∫ y', f₂ (z.1, y') * ((kernelAt ρ (t ^ β) y' z.2 : ℝ) : ℂ) =
      ∫ y', (f₂ (z.1, y') - f₂ (z.1, z.2)) * ((kernelAt ρ (t ^ β) y' z.2 : ℝ) : ℂ) := by
    simp_rw [sub_mul]; rw [integral_sub i1 i2, hz, sub_zero]
  rw [e]
  have iG : Integrable fun y' => kernelAt (fun u => |u| * |ρ u|) (t ^ β) y' z.2 :=
    FiberCZ.integrable_kernelAt iρ1 hs z.2
  refine (norm_integral_le_of_norm_le (iG.const_mul (L * t ^ β))
    (Eventually.of_forall fun y' => ?_)).trans (le_of_eq ?_)
  · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, FiberCZ.kernelAt_eq, FiberCZ.kernelAt_eq,
      abs_mul, abs_of_pos (inv_pos.2 hs)]
    have key : |y' - z.2| = t ^ β * |(z.2 - y') / t ^ β| := by
      rw [abs_div, abs_of_pos hs, abs_sub_comm]; field_simp
    calc ‖f₂ (z.1, y') - f₂ (z.1, z.2)‖ * ((t ^ β)⁻¹ * |ρ ((z.2 - y') / t ^ β)|)
        ≤ (L * |y' - z.2|) * ((t ^ β)⁻¹ * |ρ ((z.2 - y') / t ^ β)|) :=
          mul_le_mul_of_nonneg_right (hL _ _ _) (by positivity)
      _ = L * t ^ β * ((t ^ β)⁻¹ * (|(z.2 - y') / t ^ β| * |ρ ((z.2 - y') / t ^ β)|)) := by
          rw [key]; ring
  · rw [integral_const_mul, integral_kernelAt_left' _ hs]

/-! ### Integrability of the untruncated integrand and the limit `a → 0`, `b → ∞` -/

theorem nonneg_of_lip {f₂ : ℝ × ℝ → ℂ} {L : ℝ}
    (hL : ∀ x y y', ‖f₂ (x, y) - f₂ (x, y')‖ ≤ L * |y - y'|) : 0 ≤ L := by
  have := (norm_nonneg _).trans (hL 0 1 0)
  simpa using this

/-- The `t`-integrand of the untruncated model operator is integrable on `(0, ∞)`: near `0`
the second factor is `O(t^β)` (mean zero of `ρ`, Lipschitz `f₂`), near `∞` the first is
`O(t^{-α})` (`φ` bounded, the fiber of `f₁` integrable). -/
theorem integrableOn_integrand_Ioi {α β : ℕ} (hα : 0 < α) (hβ : 0 < β) {c : ℝ → ℂ}
    (hc : Measurable c) (hc1 : ∀ t, ‖c t‖ ≤ 1) {φ ρ : ℝ → ℝ} (hφm : Measurable φ)
    (iφ : Integrable φ) {Bφ : ℝ} (hφB : ∀ u, |φ u| ≤ Bφ) (hρm : Measurable ρ)
    (iρ : Integrable ρ) (iρ1 : Integrable fun u => |u| * |ρ u|) (hρ0 : ∫ u, ρ u = 0)
    {f₁ f₂ : ℝ × ℝ → ℂ} (h₁ : Measurable f₁) (h₂ : Measurable f₂) {M₁ M₂ : ℝ}
    (hM₁ : ∀ z, ‖f₁ z‖ ≤ M₁) (hM₂ : ∀ z, ‖f₂ z‖ ≤ M₂) {L : ℝ}
    (hL : ∀ x y y', ‖f₂ (x, y) - f₂ (x, y')‖ ≤ L * |y - y'|) (z : ℝ × ℝ)
    (hfib : Integrable fun x' => f₁ (x', z.2)) :
    IntegrableOn (fun t => c t * (FiberCZ.inner1 α φ f₁ t z * FiberCZ.inner2 β ρ f₂ t z) / t)
      (Ioi 0) := by
  have hmeas : Measurable
      (fun t => c t * (FiberCZ.inner1 α φ f₁ t z * FiberCZ.inner2 β ρ f₂ t z) / t) :=
    (FiberCZ.measurable_integrand α β hc hφm hρm h₁ h₂).comp
      (measurable_const.prodMk measurable_id)
  have hM₁0 : 0 ≤ M₁ := (norm_nonneg _).trans (hM₁ 0)
  have hM₂0 : 0 ≤ M₂ := (norm_nonneg _).trans (hM₂ 0)
  have hB0 : 0 ≤ Bφ := (abs_nonneg _).trans (hφB 0)
  have hL0 : 0 ≤ L := nonneg_of_lip hL
  have hI1 : 0 ≤ ∫ u, |φ u| := integral_nonneg fun _ => abs_nonneg _
  have hI2 : 0 ≤ ∫ u, |ρ u| := integral_nonneg fun _ => abs_nonneg _
  have hI3 : 0 ≤ ∫ u, |u| * |ρ u| := integral_nonneg fun _ => by positivity
  have hI4 : 0 ≤ ∫ x', ‖f₁ (x', z.2)‖ := integral_nonneg fun _ => norm_nonneg _
  have hnorm : ∀ t, 0 < t →
      ‖c t * (FiberCZ.inner1 α φ f₁ t z * FiberCZ.inner2 β ρ f₂ t z) / t‖ ≤
        ‖FiberCZ.inner1 α φ f₁ t z‖ * ‖FiberCZ.inner2 β ρ f₂ t z‖ / t := by
    intro t ht
    rw [norm_div, norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht]
    refine div_le_div_of_nonneg_right ?_ ht.le
    calc ‖c t‖ * (‖FiberCZ.inner1 α φ f₁ t z‖ * ‖FiberCZ.inner2 β ρ f₂ t z‖)
        ≤ 1 * (‖FiberCZ.inner1 α φ f₁ t z‖ * ‖FiberCZ.inner2 β ρ f₂ t z‖) := by
          gcongr; exact hc1 t
      _ = _ := one_mul _
  have h1 : IntegrableOn
      (fun t => c t * (FiberCZ.inner1 α φ f₁ t z * FiberCZ.inner2 β ρ f₂ t z) / t)
      (Ioc 0 1) := by
    refine Measure.integrableOn_of_bounded
      (M := (M₁ * ∫ u, |φ u|) * (L * ∫ u, |u| * |ρ u|))
      measure_Ioc_lt_top.ne hmeas.aestronglyMeasurable ?_
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    have ht0 : 0 < t := ht.1
    have i1 := FiberCZ.norm_inner1_le iφ hM₁ α ht0 z
    have i2 := norm_inner2_le_of_lip iρ iρ1 hρ0 h₂ hM₂ hL β ht0 z
    have htb : t ^ β ≤ t := pow_le_of_le_one ht0.le ht.2 hβ.ne'
    refine (hnorm t ht0).trans ?_
    rw [div_le_iff₀ ht0]
    calc ‖FiberCZ.inner1 α φ f₁ t z‖ * ‖FiberCZ.inner2 β ρ f₂ t z‖
        ≤ (M₁ * ∫ u, |φ u|) * (L * t ^ β * ∫ u, |u| * |ρ u|) :=
          mul_le_mul i1 i2 (norm_nonneg _) (mul_nonneg hM₁0 hI1)
      _ = (M₁ * ∫ u, |φ u|) * (L * ∫ u, |u| * |ρ u|) * t ^ β := by ring
      _ ≤ (M₁ * ∫ u, |φ u|) * (L * ∫ u, |u| * |ρ u|) * t :=
          mul_le_mul_of_nonneg_left htb (by positivity)
  have h2 : IntegrableOn
      (fun t => c t * (FiberCZ.inner1 α φ f₁ t z * FiberCZ.inner2 β ρ f₂ t z) / t)
      (Ioi 1) := by
    have hg : IntegrableOn (fun t : ℝ => (Bφ * (∫ x', ‖f₁ (x', z.2)‖) * (M₂ * ∫ u, |ρ u|)) *
        t ^ (-2 : ℝ)) (Ioi 1) :=
      (integrableOn_Ioi_rpow_of_lt (by norm_num : (-2 : ℝ) < -1) zero_lt_one).const_mul _
    refine hg.mono' hmeas.aestronglyMeasurable ?_
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    have ht1 : (1 : ℝ) < t := ht
    have ht0 : 0 < t := zero_lt_one.trans ht1
    have i1 := norm_inner1_le_of_bdd hφB z hfib α ht0
    have i2 := FiberCZ.norm_inner2_le iρ hM₂ β ht0 z
    have hta : (t ^ α)⁻¹ ≤ t⁻¹ := inv_anti₀ ht0 (le_self_pow₀ ht1.le hα.ne')
    have e : t ^ (-2 : ℝ) = t⁻¹ / t := by
      rw [Real.rpow_neg ht0.le, show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, Real.rpow_natCast]
      field_simp
    refine (hnorm t ht0).trans ?_
    rw [e]
    have : ‖FiberCZ.inner1 α φ f₁ t z‖ * ‖FiberCZ.inner2 β ρ f₂ t z‖ ≤
        (Bφ * (∫ x', ‖f₁ (x', z.2)‖) * (M₂ * ∫ u, |ρ u|)) * t⁻¹ := by
      calc ‖FiberCZ.inner1 α φ f₁ t z‖ * ‖FiberCZ.inner2 β ρ f₂ t z‖
          ≤ (Bφ * (t ^ α)⁻¹ * ∫ x', ‖f₁ (x', z.2)‖) * (M₂ * ∫ u, |ρ u|) :=
            mul_le_mul i1 i2 (norm_nonneg _) (by positivity)
        _ = (Bφ * (∫ x', ‖f₁ (x', z.2)‖) * (M₂ * ∫ u, |ρ u|)) * (t ^ α)⁻¹ := by ring
        _ ≤ _ := mul_le_mul_of_nonneg_left hta (by positivity)
    calc ‖FiberCZ.inner1 α φ f₁ t z‖ * ‖FiberCZ.inner2 β ρ f₂ t z‖ / t
        ≤ (Bφ * (∫ x', ‖f₁ (x', z.2)‖) * (M₂ * ∫ u, |ρ u|)) * t⁻¹ / t :=
          div_le_div_of_nonneg_right this ht0.le
      _ = _ := by ring
  rw [← Ioc_union_Ioi_eq_Ioi zero_le_one]
  exact h1.union h2

theorem iUnion_Ioc_two_pow : (⋃ n : ℕ, Ioc ((2 : ℝ) ^ (-(n : ℤ))) (2 ^ n)) = Ioi 0 := by
  ext t
  simp only [mem_iUnion, mem_Ioc, mem_Ioi]
  constructor
  · rintro ⟨n, h1, -⟩
    exact lt_trans (by positivity) h1
  · intro ht
    obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt (max t t⁻¹) (by norm_num : (1 : ℝ) < 2)
    refine ⟨n, ?_, (le_max_left _ _).trans hn.le⟩
    rw [zpow_neg, zpow_natCast]
    have h : t⁻¹ < 2 ^ n := (le_max_right _ _).trans_lt hn
    exact (inv_lt_comm₀ ht (by positivity)).1 h

theorem monotone_Ioc_two_pow : Monotone fun n : ℕ => Ioc ((2 : ℝ) ^ (-(n : ℤ))) (2 ^ n) := by
  intro m n hmn
  apply Ioc_subset_Ioc
  · exact zpow_le_zpow_right₀ (by norm_num) (by simpa using hmn)
  · exact pow_le_pow_right₀ (by norm_num) hmn

/-- `∫_{2^{-n}}^{2^n} F → ∫_0^∞ F` for `F` integrable on `(0, ∞)`. -/
theorem tendsto_setIntegral_Ioc_two_pow {F : ℝ → ℂ} (hF : IntegrableOn F (Ioi 0)) :
    Tendsto (fun n : ℕ => ∫ t in Ioc ((2 : ℝ) ^ (-(n : ℤ))) (2 ^ n), F t) atTop
      (𝓝 (∫ t in Ioi 0, F t)) := by
  have := tendsto_setIntegral_of_monotone (μ := volume) (f := F)
    (fun n => measurableSet_Ioc) monotone_Ioc_two_pow (by rw [iUnion_Ioc_two_pow]; exact hF)
  rwa [iUnion_Ioc_two_pow] at this

/-! ### The kernels `g * Φ` and `h * h * Ψ` -/

theorem measurable_gconv {Φ : ℝ → ℝ} (hΦ : Measurable Φ) : Measurable (gconv Φ) := by
  rw [gconv_eq_corrK]
  exact measurable_corrK continuous_gaussian.measurable (hΦ.comp measurable_neg)

theorem decay_gconv {Φ : ℝ → ℝ} {N A : ℝ} (hN : 0 ≤ N)
    (hd : ∀ x, |Φ x| ≤ A * (1 + |x|) ^ (-N)) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x, |gconv Φ x| ≤ C * (1 + |x|) ^ (-N) := by
  obtain ⟨Cg, hCg, hg⟩ := gaussian_decay (N + 2)
  have hA := nonneg_of_decay_bound hd
  refine ⟨Cg * A * c0, mul_nonneg (mul_nonneg hCg hA) c0_nonneg, fun x => ?_⟩
  rw [gconv_eq_corrK]
  exact abs_corrK_le_of_decay hN hg hA (fun y => by simpa [abs_neg] using hd (-y)) x

theorem measurable_hhconv {Ψ : ℝ → ℝ} (hΨ : Measurable Ψ) (iΨ : Integrable Ψ) :
    Measurable (hhconv Ψ) := by
  rw [hhconv_eq_corrK iΨ]
  exact measurable_corrK Twisted.continuous_gaussianDeriv.measurable
    (measurable_hconv (hΨ.comp measurable_neg).neg)

theorem decay_hhconv {Ψ : ℝ → ℝ} (iΨ : Integrable Ψ) {N B : ℝ} (hN : 0 ≤ N)
    (hd : ∀ x, |Ψ x| ≤ B * (1 + |x|) ^ (-N)) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x, |hhconv Ψ x| ≤ C * (1 + |x|) ^ (-N) := by
  obtain ⟨Ch, hCh, hh'⟩ := gaussianDeriv_decay (N + 2)
  have hB := nonneg_of_decay_bound hd
  have hd' : ∀ x, |(fun y => -Ψ (-y)) x| ≤ B * (1 + |x|) ^ (-N) := fun x => by
    simpa [abs_neg] using hd (-x)
  have hH := abs_hconv_le hN hh' hd'
  have hB' : 0 ≤ Ch * B * c0 := mul_nonneg (mul_nonneg hCh hB) c0_nonneg
  refine ⟨Ch * (Ch * B * c0) * c0, mul_nonneg (mul_nonneg hCh hB') c0_nonneg, fun x => ?_⟩
  rw [hhconv_eq_corrK iΨ]
  exact abs_corrK_le_of_decay hN hh' hB' hH x

/-- `∫ h * h * Ψ = 0`, since `∫ h = 0`. -/
theorem integral_hhconv {Ψ : ℝ → ℝ} (iΨ : Integrable Ψ) : ∫ x, hhconv Ψ x = 0 := by
  have hhh : ∫ x, hh x = 0 := by
    rw [Cone.hh_eq_convolution, integral_convolution _ Twisted.integrable_gaussianDeriv
      Twisted.integrable_gaussianDeriv, Twisted.integral_gaussianDeriv]
    simp
  rw [Cone.hhconv_eq_convolution, integral_convolution _ iΨ Cone.integrable_hh, hhh]
  simp

theorem abs_le_of_decay {v : ℝ → ℝ} {C N : ℝ} (hN : 0 ≤ N) (hC : 0 ≤ C)
    (h : ∀ x, |v x| ≤ C * (1 + |x|) ^ (-N)) (x : ℝ) : |v x| ≤ C := by
  refine (h x).trans ?_
  have : (1 + |x|) ^ (-N) ≤ 1 :=
    Real.rpow_le_one_of_one_le_of_nonpos (by linarith [abs_nonneg x]) (by linarith)
  nlinarith

theorem integrable_mul_abs_of_decay {v : ℝ → ℝ} (hv : Measurable v) {C N : ℝ} (hN : 2 < N)
    (h : ∀ x, |v x| ≤ C * (1 + |x|) ^ (-N)) : Integrable fun u => |u| * |v u| := by
  have hC := nonneg_of_decay_bound h
  refine integrable_of_decay' (measurable_id.abs.mul hv.abs) (C := C) (N := N - 1)
    (by linarith) fun u => ?_
  have h0 : (0 : ℝ) < 1 + |u| := by positivity
  rw [abs_of_nonneg (by positivity), show -(N - 1) = 1 + -N by ring, Real.rpow_add h0,
    Real.rpow_one]
  calc |u| * |v u| ≤ (1 + |u|) * (C * (1 + |u|) ^ (-N)) :=
        mul_le_mul (by linarith) (h u) (abs_nonneg _) h0.le
    _ = C * ((1 + |u|) * (1 + |u|) ^ (-N)) := by ring

/-! ### Test functions -/

theorem lip_of_test {f₂ : ℝ × ℝ → ℂ} (h₂ : ContDiff ℝ ∞ f₂) (h₂c : HasCompactSupport f₂) :
    ∃ L : ℝ, ∀ x y y', ‖f₂ (x, y) - f₂ (x, y')‖ ≤ L * |y - y'| := by
  obtain ⟨K, hK⟩ := ContDiff.lipschitzWith_of_hasCompactSupport h₂c h₂ (by simp)
  refine ⟨K, fun x y y' => ?_⟩
  have := hK.dist_le_mul (x, y) (x, y')
  rw [dist_eq_norm, Prod.dist_eq, dist_self, Real.dist_eq,
    max_eq_right (abs_nonneg _)] at this
  exact this

/-! ### Main results: untruncation of the model operator -/

/-- For test functions `f₁, f₂`, measurable `|c| ≤ 1` and continuous `Φ, Ψ` with
`|Φ(x)| ≤ A (1+|x|)^{-N}`, `|Ψ(x)| ≤ B (1+|x|)^{-N}`, `N > 2`, the `t`-integrand of
`modelOpFull α β c (g * Φ) (h * h * Ψ) f₁ f₂ z` is integrable on `(0, ∞)`. -/
theorem integrableOn_modelOpFull_integrand {α β : ℕ} (hα : 0 < α) (hβ : 0 < β)
    {c : ℝ → ℂ} (hc : Measurable c) (hc1 : ∀ t, ‖c t‖ ≤ 1) {Φ Ψ : ℝ → ℝ}
    (hΦ : Continuous Φ) (hΨ : Continuous Ψ) {N A B : ℝ} (hN : 2 < N)
    (hdΦ : ∀ x, |Φ x| ≤ A * (1 + |x|) ^ (-N)) (hdΨ : ∀ x, |Ψ x| ≤ B * (1 + |x|) ^ (-N))
    {f₁ f₂ : ℝ × ℝ → ℂ} (h₁ : ContDiff ℝ ∞ f₁) (h₁c : HasCompactSupport f₁)
    (h₂ : ContDiff ℝ ∞ f₂) (h₂c : HasCompactSupport f₂) (z : ℝ × ℝ) :
    IntegrableOn (fun t => c t *
      ((∫ x', f₁ (x', z.2) * ((kernelAt (gconv Φ) (t ^ α) x' z.1 : ℝ) : ℂ)) *
        (∫ y', f₂ (z.1, y') * ((kernelAt (hhconv Ψ) (t ^ β) y' z.2 : ℝ) : ℂ))) / t)
      (Ioi 0) := by
  have hN0 : 0 ≤ N := by linarith
  have hN1 : 1 < N := by linarith
  have iΨ : Integrable Ψ := integrable_of_decay' hΨ.measurable hN1 hdΨ
  obtain ⟨Cφ, hCφ, hφd⟩ := decay_gconv hN0 hdΦ
  obtain ⟨Cρ, hCρ, hρd⟩ := decay_hhconv iΨ hN0 hdΨ
  have hφm := measurable_gconv hΦ.measurable
  have hρm := measurable_hhconv hΨ.measurable iΨ
  obtain ⟨M₁, hM₁⟩ := h₁.continuous.bounded_above_of_compact_support h₁c
  obtain ⟨M₂, hM₂⟩ := h₂.continuous.bounded_above_of_compact_support h₂c
  obtain ⟨L, hL⟩ := lip_of_test h₂ h₂c
  have hsec := Cone.IsTest.section1 ⟨h₁, h₁c⟩ z.2
  exact integrableOn_integrand_Ioi hα hβ hc hc1 hφm (integrable_of_decay' hφm hN1 hφd)
    (abs_le_of_decay hN0 hCφ hφd) hρm (integrable_of_decay' hρm hN1 hρd)
    (integrable_mul_abs_of_decay hρm hN hρd) (integral_hhconv iΨ) h₁.continuous.measurable
    h₂.continuous.measurable hM₁ hM₂ hL z (Cone.integrable_test_section hsec.1 hsec.2)

/-- **Untruncation**: `U_{2^{-n}, 2^n}(f₁, f₂)(z) → U(f₁, f₂)(z)` as `n → ∞`, for the kernels
`g * Φ`, `h * h * Ψ` (hypotheses of `integrableOn_modelOpFull_integrand`). -/
theorem tendsto_modelOp_modelOpFull {α β : ℕ} (hα : 0 < α) (hβ : 0 < β)
    {c : ℝ → ℂ} (hc : Measurable c) (hc1 : ∀ t, ‖c t‖ ≤ 1) {Φ Ψ : ℝ → ℝ}
    (hΦ : Continuous Φ) (hΨ : Continuous Ψ) {N A B : ℝ} (hN : 2 < N)
    (hdΦ : ∀ x, |Φ x| ≤ A * (1 + |x|) ^ (-N)) (hdΨ : ∀ x, |Ψ x| ≤ B * (1 + |x|) ^ (-N))
    {f₁ f₂ : ℝ × ℝ → ℂ} (h₁ : ContDiff ℝ ∞ f₁) (h₁c : HasCompactSupport f₁)
    (h₂ : ContDiff ℝ ∞ f₂) (h₂c : HasCompactSupport f₂) (z : ℝ × ℝ) :
    Tendsto (fun n : ℕ => modelOp α β c (gconv Φ) (hhconv Ψ) ((2 : ℝ) ^ (-(n : ℤ))) (2 ^ n)
      f₁ f₂ z) atTop (𝓝 (modelOpFull α β c (gconv Φ) (hhconv Ψ) f₁ f₂ z)) :=
  tendsto_setIntegral_Ioc_two_pow (integrableOn_modelOpFull_integrand hα hβ hc hc1 hΦ hΨ hN
    hdΦ hdΨ h₁ h₁c h₂ h₂c z)

/-- Measurability of the untruncated model operator with the kernels `g * Φ`, `h * h * Ψ`. -/
theorem measurable_modelOpFull_gconv_hhconv (α β : ℕ) {c : ℝ → ℂ} (hc : Measurable c)
    {Φ Ψ : ℝ → ℝ} (hΦ : Measurable Φ) (hΨ : Measurable Ψ) (iΨ : Integrable Ψ)
    {f₁ f₂ : ℝ × ℝ → ℂ} (h₁ : Measurable f₁) (h₂ : Measurable f₂) :
    Measurable (modelOpFull α β c (gconv Φ) (hhconv Ψ) f₁ f₂) :=
  (Cone.stronglyMeasurable_modelOpFull α β hc (measurable_gconv hΦ)
    (measurable_hhconv hΨ iΨ) h₁ h₂).measurable

end

