/-- `(f₂ *₂ ρ_{t^β})(z)`. -/
def inner2 (β : ℕ) (ρ : ℝ → ℝ) (f₂ : ℝ × ℝ → ℂ) (t : ℝ) (z : ℝ × ℝ) : ℂ :=
