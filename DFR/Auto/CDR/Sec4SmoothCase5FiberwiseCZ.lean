    push_cast at this
    linarith
  have hKb : ∀ u, ‖K u‖ ≤ (2 * A₀) * 2 ^ m / (1 + 2 ^ m * |u|) ^ 2 := by
    intro u
    have hX : 0 ≤ |u| / s := div_nonneg (abs_nonneg _) hs.le
    have h1 : |ρ (u / s)| ≤ A₀ * (1 / (1 + |u| / s) ^ 2) := by
      refine (hρ _).trans (mul_le_mul_of_nonneg_left ?_ hA₀)
      rw [abs_div, abs_of_pos hs]
      exact one_add_rpow_neg12_le hX
    have hm0 : (0 : ℝ) < 2 ^ m := by positivity
    have h2 : 1 + 2 ^ m * |u| ≤ 1 + |u| / s := by
      have : 2 ^ m * |u| ≤ L * |u| := mul_le_mul_of_nonneg_right hm1 (abs_nonneg _)
      rw [hL] at this
      rw [div_eq_inv_mul]; linarith
    have h3 : 1 / (1 + |u| / s) ^ 2 ≤ 1 / (1 + 2 ^ m * |u|) ^ 2 :=
      one_div_le_one_div_of_le (by positivity) (pow_le_pow_left₀ (by positivity) h2 2)
    rw [hK, Complex.norm_real, Real.norm_eq_abs, abs_mul, abs_of_pos hL0]
    calc L * |ρ (u / s)| ≤ (2 * 2 ^ m) * (A₀ * (1 / (1 + 2 ^ m * |u|) ^ 2)) := by
          gcongr
          exact h1.trans (mul_le_mul_of_nonneg_left h3 hA₀)
      _ = (2 * A₀) * 2 ^ m / (1 + 2 ^ m * |u|) ^ 2 := by ring
  have hmax := lintegral_kernel_le_hlMax (by positivity) m hKb hg (fun x => hM _) z.2
  rw [e1, hcm]
  refine (norm_integral_le_lintegral_norm _).trans ?_
  have e2 : ∫⁻ u, ENNReal.ofReal ‖K u * g (z.2 - u)‖ = ∫⁻ u, ‖K u‖ₑ * ‖g (z.2 - u)‖ₑ := by
    refine lintegral_congr fun u => ?_
    rw [norm_mul, ENNReal.ofReal_mul (norm_nonneg _), ofReal_norm, ofReal_norm]
  rw [e2]
  have hM' : 0 ≤ hlMax g z.2 := shiftedMaximal_nonneg _ _ _
  calc (∫⁻ u, ‖K u‖ₑ * ‖g (z.2 - u)‖ₑ).toReal
      ≤ (ENNReal.ofReal (16 * (2 * A₀) * hlMax g z.2)).toReal :=
        ENNReal.toReal_mono ENNReal.ofReal_ne_top hmax
    _ = 32 * A₀ * hlMax g z.2 := by
        rw [ENNReal.toReal_ofReal (by positivity)]; ring

theorem norm_inner2_le_cMax {ρ : ℝ → ℝ} {A₀ : ℝ} (hA₀ : 0 ≤ A₀)
    (hρ : ∀ u, |ρ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ)) {f₂ : ℝ × ℝ → ℂ} (h₂ : Measurable f₂)
    {M : ℝ} (hM : ∀ z, ‖f₂ z‖ ≤ M) (β : ℕ) {t : ℝ} (ht : 0 < t) (z : ℝ × ℝ) :
    ‖inner2 β ρ f₂ t z‖ ≤ 32 * A₀ * cMax 1 f₂ z :=
  norm_integral_kernel_le_cMax hA₀ hρ h₂ hM (pow_pos ht β) z

/-! ### The mean value estimate for the dilated kernels -/

/-- The majorant `s^{-2} (1 + d/(2s))^{-12}` of the derivative of `φ_s` at distance `d/2`. -/
def kdb (s d : ℝ) : ℝ := (s ^ 2)⁻¹ * (1 + d / (2 * s)) ^ (-12 : ℝ)

theorem kdb_nonneg {s : ℝ} (hs : 0 < s) {d : ℝ} (hd : 0 ≤ d) : 0 ≤ kdb s d := by
  unfold kdb; positivity

theorem nonneg_of_decay {v : ℝ → ℝ} {A₀ : ℝ} (hv : ∀ u, |v u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ)) :
    0 ≤ A₀ := by
  have h := hv 0
  simp only [abs_zero, add_zero, Real.one_rpow, mul_one] at h
  exact (abs_nonneg _).trans h

/-- **Mean value theorem** for the dilated kernel `φ_s(x - ·)` away from the point `c`. -/
theorem abs_kernelAt_sub_le {φ : ℝ → ℝ} (hφd : Differentiable ℝ φ) {A₀ : ℝ}
    (hφ' : ∀ u, |deriv φ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ)) {s : ℝ} (hs : 0 < s) {w c x : ℝ}
    (hwc : 2 * |w - c| ≤ |x - c|) :
    |kernelAt φ s w x - kernelAt φ s c x| ≤ A₀ * |w - c| * kdb s |x - c| := by
  have hA₀ : 0 ≤ A₀ := nonneg_of_decay hφ'
  set u₁ := (x - w) / s with hu₁
  set u₂ := (x - c) / s with hu₂
  have hdiff : |u₁ - u₂| = |w - c| / s := by
    rw [hu₁, hu₂, ← sub_div, abs_div, abs_of_pos hs]
    congr 1; rw [show x - w - (x - c) = -(w - c) by ring, abs_neg]
  have hu₂abs : |u₂| = |x - c| / s := by rw [hu₂, abs_div, abs_of_pos hs]
  have hseg : ∀ ξ ∈ uIcc u₂ u₁, ‖deriv φ ξ‖ ≤ A₀ * (1 + |x - c| / (2 * s)) ^ (-12 : ℝ) := by
    intro ξ hξ
    have h1 := abs_sub_left_of_mem_uIcc hξ
    have h3 : |x - c| / (2 * s) ≤ |ξ| := by
      have h4 : |u₂| - |ξ - u₂| ≤ |ξ| := by
        have := abs_sub_abs_le_abs_sub u₂ ξ
        rw [abs_sub_comm ξ u₂]; linarith
      have h5 : |w - c| / s ≤ |x - c| / (2 * s) := by
        rw [div_le_div_iff₀ hs (by positivity)]; nlinarith
      have h6 : |x - c| / s = |x - c| / (2 * s) + |x - c| / (2 * s) := by field_simp; ring
      linarith
    rw [Real.norm_eq_abs]
    refine (hφ' ξ).trans (mul_le_mul_of_nonneg_left ?_ hA₀)
    exact Real.rpow_le_rpow_of_nonpos (by positivity) (by linarith) (by norm_num)
  have hmv := Convex.norm_image_sub_le_of_norm_deriv_le (f := φ) (s := uIcc u₂ u₁)
    (fun ξ _ => (hφd ξ)) hseg (convex_uIcc u₂ u₁) left_mem_uIcc right_mem_uIcc
  rw [Real.norm_eq_abs, Real.norm_eq_abs, hdiff] at hmv
  rw [kernelAt_eq, kernelAt_eq, ← hu₁, ← hu₂, ← mul_sub, abs_mul, abs_inv, abs_of_pos hs]
  calc s⁻¹ * |φ u₁ - φ u₂| ≤ s⁻¹ * (A₀ * (1 + |x - c| / (2 * s)) ^ (-12 : ℝ) * (|w - c| / s)) :=
        mul_le_mul_of_nonneg_left hmv (by positivity)
    _ = A₀ * |w - c| * kdb s |x - c| := by unfold kdb; field_simp

/-! ### The scale integral -/

theorem kdb_le_small {s d : ℝ} (hs : 0 < s) (hsd : s ≤ d / 2) :
    kdb s d ≤ 16 * s ^ 2 / d ^ 4 := by
  have hd : 0 < d := by linarith
  set X := d / (2 * s) with hX
  have hX1 : 1 ≤ X := by rw [hX, le_div_iff₀ (by positivity)]; linarith
  have hX0 : 0 < X := by linarith
  have h1 : (1 + X) ^ (-12 : ℝ) ≤ X ^ (-12 : ℝ) :=
    Real.rpow_le_rpow_of_nonpos hX0 (by linarith) (by norm_num)
  have h2 : X ^ (-12 : ℝ) ≤ X ^ (-4 : ℝ) := Real.rpow_le_rpow_of_exponent_le hX1 (by norm_num)
  have h3 : X ^ (-4 : ℝ) = 16 * s ^ 4 / d ^ 4 := by
    rw [Real.rpow_neg hX0.le, show (4 : ℝ) = ((4 : ℕ) : ℝ) by norm_num, Real.rpow_natCast, hX]
    field_simp
    ring
  unfold kdb
  calc (s ^ 2)⁻¹ * (1 + X) ^ (-12 : ℝ) ≤ (s ^ 2)⁻¹ * (16 * s ^ 4 / d ^ 4) := by
        gcongr; exact (h1.trans h2).trans h3.le
    _ = 16 * s ^ 2 / d ^ 4 := by field_simp

theorem kdb_le_large {s d : ℝ} (hs : 0 < s) (hd : 0 ≤ d) : kdb s d ≤ (s ^ 2)⁻¹ := by
  unfold kdb
  have h0 : 0 ≤ d / (2 * s) := by positivity
  have : (1 + d / (2 * s)) ^ (-12 : ℝ) ≤ 1 :=
    Real.rpow_le_one_of_one_le_of_nonpos (by linarith) (by norm_num)
  calc (s ^ 2)⁻¹ * (1 + d / (2 * s)) ^ (-12 : ℝ) ≤ (s ^ 2)⁻¹ * 1 := by gcongr
    _ = (s ^ 2)⁻¹ := mul_one _

/-- **The scale integral**: `∫_0^∞ t^{-2α} (1 + d/(2t^α))^{-12} dt/t ≤ 4/(α d^2)`. -/
theorem lintegral_kdb_le (α : ℕ) (hα : 0 < α) {d : ℝ} (hd : 0 < d) :
    ∫⁻ t in Ioi (0 : ℝ), ENNReal.ofReal (kdb (t ^ α) d) * ENNReal.ofReal t⁻¹ ≤
      ENNReal.ofReal (4 / (α * d ^ 2)) := by
  set a : ℝ := (α : ℝ) with ha
  have ha0 : 0 < a := by rw [ha]; exact_mod_cast hα
  set t₀ : ℝ := (d / 2) ^ (1 / a) with ht₀
  have hd2 : 0 < d / 2 := by positivity
  have ht₀0 : 0 < t₀ := Real.rpow_pos_of_pos hd2 _
  have ht₀a : t₀ ^ α = d / 2 := by
    rw [ht₀, ← Real.rpow_natCast, ← Real.rpow_mul hd2.le, ← ha, one_div_mul_cancel ha0.ne',
      Real.rpow_one]
  have ht₀2a : t₀ ^ (2 * a) = (d / 2) ^ 2 := by
    rw [ht₀, ← Real.rpow_mul hd2.le, show 1 / a * (2 * a) = ((2 : ℕ) : ℝ) by
      field_simp; norm_num, Real.rpow_natCast]
  have hpow : ∀ t : ℝ, 0 < t → (t ^ α) ^ 2 = t ^ (2 * a) := by
    intro t ht
    rw [ha, show 2 * (α : ℝ) = ((2 * α : ℕ) : ℝ) by push_cast; ring, Real.rpow_natCast,
      ← pow_mul, mul_comm]
  have hsplit : Ioi (0 : ℝ) = Ioc 0 t₀ ∪ Ioi t₀ := (Ioc_union_Ioi_eq_Ioi ht₀0.le).symm
  rw [hsplit]
  refine (lintegral_union_le _ _ _).trans ?_
  have hI1 : ∫⁻ t in Ioc 0 t₀, ENNReal.ofReal (kdb (t ^ α) d) * ENNReal.ofReal t⁻¹ ≤
      ENNReal.ofReal (2 / (a * d ^ 2)) := by
    calc ∫⁻ t in Ioc 0 t₀, ENNReal.ofReal (kdb (t ^ α) d) * ENNReal.ofReal t⁻¹
        ≤ ∫⁻ t in Ioc 0 t₀, ENNReal.ofReal (16 / d ^ 4) * ENNReal.ofReal (t ^ (2 * a - 1)) := by
          refine setLIntegral_mono' measurableSet_Ioc fun t ht => ?_
          have ht0 : 0 < t := ht.1
          have hs : 0 < t ^ α := pow_pos ht0 α
          have hsd : t ^ α ≤ d / 2 := ht₀a ▸ pow_le_pow_left₀ ht0.le ht.2 α
          rw [← ENNReal.ofReal_mul (kdb_nonneg hs hd.le), ← ENNReal.ofReal_mul (by positivity)]
          refine ENNReal.ofReal_le_ofReal ?_
          calc kdb (t ^ α) d * t⁻¹ ≤ 16 * (t ^ α) ^ 2 / d ^ 4 * t⁻¹ :=
                mul_le_mul_of_nonneg_right (kdb_le_small hs hsd) (by positivity)
            _ = 16 / d ^ 4 * t ^ (2 * a - 1) := by
                rw [hpow t ht0, Real.rpow_sub ht0, Real.rpow_one]; ring
      _ = ENNReal.ofReal (16 / d ^ 4) *
            ENNReal.ofReal (t₀ ^ (2 * a - 1 + 1) / (2 * a - 1 + 1)) := by
          rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
            Auto.Twisted.lintegral_Ioc_zero_rpow (by linarith) ht₀0]
      _ = ENNReal.ofReal (2 / (a * d ^ 2)) := by
          rw [← ENNReal.ofReal_mul (by positivity), show 2 * a - 1 + 1 = 2 * a by ring, ht₀2a]
          congr 1; field_simp; ring
  have hI2 : ∫⁻ t in Ioi t₀, ENNReal.ofReal (kdb (t ^ α) d) * ENNReal.ofReal t⁻¹ ≤
      ENNReal.ofReal (2 / (a * d ^ 2)) := by
    calc ∫⁻ t in Ioi t₀, ENNReal.ofReal (kdb (t ^ α) d) * ENNReal.ofReal t⁻¹
        ≤ ∫⁻ t in Ioi t₀, ENNReal.ofReal (t ^ (-(2 * a) - 1)) := by
          refine setLIntegral_mono' measurableSet_Ioi fun t ht => ?_
          have ht0 : 0 < t := ht₀0.trans ht
          have hs : 0 < t ^ α := pow_pos ht0 α
          rw [← ENNReal.ofReal_mul (kdb_nonneg hs hd.le)]
          refine ENNReal.ofReal_le_ofReal ?_
          calc kdb (t ^ α) d * t⁻¹ ≤ ((t ^ α) ^ 2)⁻¹ * t⁻¹ :=
                mul_le_mul_of_nonneg_right (kdb_le_large hs hd.le) (by positivity)
            _ = t ^ (-(2 * a) - 1) := by
                rw [hpow t ht0, Real.rpow_sub ht0, Real.rpow_one, Real.rpow_neg ht0.le]; ring
      _ = ENNReal.ofReal (-t₀ ^ (-(2 * a) - 1 + 1) / (-(2 * a) - 1 + 1)) :=
          Auto.Twisted.lintegral_Ioi_rpow (by linarith) ht₀0
      _ = ENNReal.ofReal (2 / (a * d ^ 2)) := by
          rw [show -(2 * a) - 1 + 1 = -(2 * a) by ring, Real.rpow_neg ht₀0.le, ht₀2a]
          congr 1; field_simp
  calc _ ≤ ENNReal.ofReal (2 / (a * d ^ 2)) + ENNReal.ofReal (2 / (a * d ^ 2)) := add_le_add hI1 hI2
    _ = ENNReal.ofReal (4 / (α * d ^ 2)) := by
        rw [← ENNReal.ofReal_add (by positivity) (by positivity), ← ha]; congr 1; ring

/-! ### The fiber-wise Calderón-Zygmund decomposition in the first variable -/

/-- The stopping averages `|I|^{-1} ∫_I |F(x, y)|^p dx`. -/
abbrev czAvg (F : ℝ × ℝ → ℝ) (p : ℝ) : FiberDyadicInterval → ℝ → ℝ :=
  fiberDyadicIntervalAverage (fun yz => |F yz| ^ p)

/-- The selection set `{y : I is a maximal interval of the fiber F(·, y) at height H}`. -/
abbrev czSel (F : ℝ × ℝ → ℝ) (p H : ℝ) (I : FiberDyadicInterval) : Set ℝ :=
  fiberDyadicSelectionSet (sourceFiberFiniteMassSet F p) (czAvg F p) H I

/-- The bad part `b`. -/
abbrev czBad (F : ℝ × ℝ → ℝ) (p H : ℝ) : ℝ × ℝ → ℝ :=
  fiberDyadicCountableBadField F (sourceFiberFiniteMassSet F p) (czAvg F p) H

/-- The good part `g`. -/
abbrev czGood (F : ℝ × ℝ → ℝ) (p H : ℝ) : ℝ × ℝ → ℝ :=
  fiberDyadicCountableGoodField F (sourceFiberFiniteMassSet F p) (czAvg F p) H

theorem measurable_czAvg {F : ℝ × ℝ → ℝ} (hF : Measurable F) (p : ℝ) (I : FiberDyadicInterval) :
    Measurable (czAvg F p I) :=
  Auto.Twisted.measurable_fiberDyadicIntervalAverage _ (by fun_prop) I

theorem measurableSet_czSel {F : ℝ × ℝ → ℝ} (hF : Measurable F) (p H : ℝ)
    (I : FiberDyadicInterval) : MeasurableSet (czSel F p H I) :=
  Auto.Twisted.measurableSet_fiberDyadicSelectionSet _
    (Auto.Twisted.measurableSet_sourceFiberFiniteMassSet F p hF) _ (measurable_czAvg hF p) H I

theorem measurable_czBad {F : ℝ × ℝ → ℝ} (hF : Measurable F) (p H : ℝ) :
    Measurable (czBad F p H) :=
  Auto.Twisted.measurable_fiberDyadicCountableBadField F _ _ H hF
    (Auto.Twisted.measurableSet_sourceFiberFiniteMassSet F p hF) (measurable_czAvg hF p)

theorem measurable_czGood {F : ℝ × ℝ → ℝ} (hF : Measurable F) (p H : ℝ) :
    Measurable (czGood F p H) :=
  Auto.Twisted.measurable_fiberDyadicCountableGoodField F _ _ H hF
    (Auto.Twisted.measurableSet_sourceFiberFiniteMassSet F p hF) (measurable_czAvg hF p)

theorem integrable_of_mem_czSel {F : ℝ × ℝ → ℝ} (hF : Measurable F) {p H : ℝ}
    {I : FiberDyadicInterval} {y : ℝ} (hy : y ∈ czSel F p H I) :
    Integrable (fun x => |F (x, y)| ^ p) :=
  Auto.Twisted.mem_fiberFiniteMassSet_integrable (fun yz => |F yz| ^ p) (by fun_prop)
    (fun _ => Real.rpow_nonneg (abs_nonneg _) _) y hy.1.1

theorem czAvg_le_of_mem_czSel {F : ℝ × ℝ → ℝ} (hF : Measurable F) {p H : ℝ}
    {I : FiberDyadicInterval} {y : ℝ} (hy : y ∈ czSel F p H I) : czAvg F p I y ≤ 2 * H :=
  (Auto.Twisted.fiberDyadicSelection_average_lt_and_le_two_of_nonneg _ (fun yz => |F yz| ^ p)
    H I y (integrable_of_mem_czSel hF hy) (fun _ => Real.rpow_nonneg (abs_nonneg _) _) hy).2

theorem volume_fiberDyadicInterval_ne_top (I : FiberDyadicInterval) :
    volume (fiberDyadicInterval I) ≠ ⊤ := by
  rw [Auto.Twisted.measure_fiberDyadicInterval]; exact ENNReal.ofReal_ne_top

theorem measureReal_fiberDyadicInterval (I : FiberDyadicInterval) :
    volume.real (fiberDyadicInterval I) = fiberDyadicIntervalLength I := by
  rw [measureReal_def, Auto.Twisted.measure_fiberDyadicInterval,
    ENNReal.toReal_ofReal (Auto.Twisted.fiberDyadicIntervalLength_pos I).le]

theorem integrableOn_fiber_of_bound {F : ℝ × ℝ → ℝ} (hF : Measurable F) {M : ℝ}
    (hM : ∀ z, |F z| ≤ M) (I : FiberDyadicInterval) (y : ℝ) :
    IntegrableOn (fun w => F (w, y)) (fiberDyadicInterval I) :=
  Measure.integrableOn_of_bounded (volume_fiberDyadicInterval_ne_top I)
    (hF.comp (measurable_id.prodMk measurable_const)).aestronglyMeasurable
    (Eventually.of_forall fun w => by rw [Real.norm_eq_abs]; exact hM _)

/-- `∫_I |f - f_I| ≤ 2 |I| (2H)^{1/p}` for a selected interval. -/
theorem integral_abs_sub_avg_le {F : ℝ × ℝ → ℝ} (hF : Measurable F) {M : ℝ}
    (hM : ∀ z, |F z| ≤ M) {p H : ℝ} (hp : 1 ≤ p) {I : FiberDyadicInterval} {y : ℝ}
    (hy : y ∈ czSel F p H I) :
    ∫ w in fiberDyadicInterval I, |F (w, y) - fiberDyadicIntervalAverage F I y| ≤
      2 * fiberDyadicIntervalLength I * (2 * H) ^ (1 / p) := by
  set L := fiberDyadicIntervalLength I with hL
  have hL0 : 0 < L := Auto.Twisted.fiberDyadicIntervalLength_pos I
  have hFI := integrableOn_fiber_of_bound hF hM I y
  have hconst : IntegrableOn (fun _ : ℝ => |fiberDyadicIntervalAverage F I y|)
      (fiberDyadicInterval I) := integrableOn_const (volume_fiberDyadicInterval_ne_top I)
  have havg : |fiberDyadicIntervalAverage F I y| ≤
      L⁻¹ * ∫ w in fiberDyadicInterval I, |F (w, y)| := by
    rw [Auto.Twisted.fiberDyadicIntervalAverage_eq_setIntegral, abs_mul,
      abs_of_pos (inv_pos.2 hL0)]
    exact mul_le_mul_of_nonneg_left (abs_integral_le_integral_abs) (inv_pos.2 hL0).le
  have h1 : ∫ w in fiberDyadicInterval I, |F (w, y) - fiberDyadicIntervalAverage F I y| ≤
      2 * ∫ w in fiberDyadicInterval I, |F (w, y)| := by
    calc ∫ w in fiberDyadicInterval I, |F (w, y) - fiberDyadicIntervalAverage F I y|
        ≤ ∫ w in fiberDyadicInterval I, (|F (w, y)| + |fiberDyadicIntervalAverage F I y|) := by
          refine integral_mono_of_nonneg (Eventually.of_forall fun _ => abs_nonneg _)
            (hFI.abs.add hconst) (Eventually.of_forall fun w => abs_sub _ _)
      _ = (∫ w in fiberDyadicInterval I, |F (w, y)|) + L * |fiberDyadicIntervalAverage F I y| := by
          rw [integral_add hFI.abs hconst, setIntegral_const, measureReal_fiberDyadicInterval,
            smul_eq_mul]
      _ ≤ (∫ w in fiberDyadicInterval I, |F (w, y)|) +
            L * (L⁻¹ * ∫ w in fiberDyadicInterval I, |F (w, y)|) := by gcongr
      _ = 2 * ∫ w in fiberDyadicInterval I, |F (w, y)| := by field_simp; ring
  have hjen := Auto.Twisted.abs_fiberDyadicIntervalAverage_le_rpow (fun yz => |F yz|) I y hp
    (hF.comp (measurable_id.prodMk measurable_const)).abs.aestronglyMeasurable
    (by simpa only [abs_abs] using (integrable_of_mem_czSel hF hy).integrableOn)
  simp only [abs_abs] at hjen
  have h2 : ∫ w in fiberDyadicInterval I, |F (w, y)| =
      L * fiberDyadicIntervalAverage (fun yz => |F yz|) I y := by
    rw [Auto.Twisted.fiberDyadicIntervalAverage_eq_setIntegral, ← mul_assoc,
      mul_inv_cancel₀ hL0.ne', one_mul]
  have h3 : fiberDyadicIntervalAverage (fun yz => |F yz|) I y ≤ (2 * H) ^ (1 / p) := by
    refine (le_abs_self _).trans (hjen.trans ?_)
    refine Real.rpow_le_rpow ?_ (czAvg_le_of_mem_czSel hF hy) (by positivity)
    rw [Auto.Twisted.fiberDyadicIntervalAverage_eq_setIntegral]
    exact mul_nonneg (inv_pos.2 hL0).le (integral_nonneg fun _ => Real.rpow_nonneg (abs_nonneg _) _)
  calc _ ≤ 2 * ∫ w in fiberDyadicInterval I, |F (w, y)| := h1
    _ = 2 * L * fiberDyadicIntervalAverage (fun yz => |F yz|) I y := by rw [h2]; ring
    _ ≤ 2 * L * (2 * H) ^ (1 / p) := by gcongr

theorem abs_sub_center_le {I : FiberDyadicInterval} {w : ℝ} (hw : w ∈ fiberDyadicInterval I) :
    2 * |w - fiberDyadicIntervalCenter I| ≤ fiberDyadicIntervalLength I := by
  rw [Auto.Twisted.fiberDyadicInterval_eq_Ico_center_radius] at hw
  have h2 := Auto.Twisted.two_mul_fiberDyadicIntervalRadius I
  have h3 : |w - fiberDyadicIntervalCenter I| ≤ fiberDyadicIntervalRadius I :=
    abs_le.2 ⟨by linarith [hw.1], by linarith [hw.2]⟩
  linarith

theorem abs_kernelAt_le {φ : ℝ → ℝ} {A₀ : ℝ} (hφ : ∀ u, |φ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ))
    {s : ℝ} (hs : 0 < s) (w x : ℝ) : |kernelAt φ s w x| ≤ s⁻¹ * A₀ := by
  have hA₀ := nonneg_of_decay hφ
  rw [kernelAt_eq, abs_mul, abs_of_pos (inv_pos.2 hs)]
  refine mul_le_mul_of_nonneg_left ((hφ _).trans ?_) (inv_pos.2 hs).le
  have : (1 + |(x - w) / s|) ^ (-12 : ℝ) ≤ 1 :=
    Real.rpow_le_one_of_one_le_of_nonpos (by linarith [abs_nonneg ((x - w) / s)]) (by norm_num)
  nlinarith

/-- The cancellation estimate for one bad atom `b_{y,I}` tested against `φ_s(x - ·)` with `x`
outside `2I`. -/
theorem abs_setIntegral_bad_kernel_le {F : ℝ × ℝ → ℝ} (hF : Measurable F) {M : ℝ}
    (hM : ∀ z, |F z| ≤ M) {p H : ℝ} (hp : 1 ≤ p) {I : FiberDyadicInterval} {y : ℝ}
    (hy : y ∈ czSel F p H I) {φ : ℝ → ℝ} (hφd : Differentiable ℝ φ) {A₀ : ℝ}
    (hφ : ∀ u, |φ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ))
    (hφ' : ∀ u, |deriv φ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ)) {s : ℝ} (hs : 0 < s) {x : ℝ}
    (hfar : fiberDyadicIntervalLength I ≤ |x - fiberDyadicIntervalCenter I|) :
    |∫ w in fiberDyadicInterval I, (F (w, y) - fiberDyadicIntervalAverage F I y) *
        kernelAt φ s w x| ≤
      A₀ * (2 * H) ^ (1 / p) * fiberDyadicIntervalLength I ^ 2 *
        kdb s |x - fiberDyadicIntervalCenter I| := by
  have hA₀ := nonneg_of_decay hφ
  set L := fiberDyadicIntervalLength I with hL
  set c := fiberDyadicIntervalCenter I with hc
  set avg := fiberDyadicIntervalAverage F I y with havg
  set K : ℝ → ℝ := fun w => kernelAt φ s w x with hK
  have hKm : Measurable K := by
    have := hφd.continuous.measurable
    simp only [hK, kernelAt_eq]; fun_prop
  have hKb : ∀ w, ‖K w‖ ≤ s⁻¹ * A₀ := fun w => by
    rw [Real.norm_eq_abs]; exact abs_kernelAt_le hφ hs w x
  have hFI := integrableOn_fiber_of_bound hF hM I y
  have hconst : IntegrableOn (fun _ : ℝ => avg) (fiberDyadicInterval I) :=
    integrableOn_const (volume_fiberDyadicInterval_ne_top I)
  have hsub : IntegrableOn (fun w => F (w, y) - avg) (fiberDyadicInterval I) := hFI.sub hconst
  have hmean : ∫ w in fiberDyadicInterval I, (F (w, y) - avg) = 0 := by
    rw [integral_sub hFI hconst, setIntegral_const, measureReal_fiberDyadicInterval, smul_eq_mul,
      havg, Auto.Twisted.fiberDyadicIntervalAverage_eq_setIntegral, ← mul_assoc,
      mul_inv_cancel₀ (Auto.Twisted.fiberDyadicIntervalLength_pos I).ne', one_mul, sub_self]
  have hint1 : IntegrableOn (fun w => (F (w, y) - avg) * K w) (fiberDyadicInterval I) :=
    hsub.mul_bdd hKm.aestronglyMeasurable (Eventually.of_forall hKb)
  have hint2 : IntegrableOn (fun w => (F (w, y) - avg) * K c) (fiberDyadicInterval I) :=
    hsub.mul_const _
  have hsplit : ∫ w in fiberDyadicInterval I, (F (w, y) - avg) * K w =
      ∫ w in fiberDyadicInterval I, (F (w, y) - avg) * (K w - K c) := by
    have e : (fun w => (F (w, y) - avg) * (K w - K c)) =
        fun w => (F (w, y) - avg) * K w - (F (w, y) - avg) * K c := by funext w; ring
    rw [e, integral_sub hint1 hint2, integral_mul_const, hmean, zero_mul, sub_zero]
  have hbd : ∀ᵐ w ∂(volume.restrict (fiberDyadicInterval I)),
      ‖(F (w, y) - avg) * (K w - K c)‖ ≤ |F (w, y) - avg| * (A₀ * (L / 2) * kdb s |x - c|) := by
    filter_upwards [ae_restrict_mem (Auto.Twisted.measurableSet_fiberDyadicInterval I)] with w hw
    have hwc := abs_sub_center_le hw
    rw [Real.norm_eq_abs, abs_mul]
    refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
    refine (abs_kernelAt_sub_le hφd hφ' hs (by linarith)).trans ?_
    have := kdb_nonneg hs (abs_nonneg (x - c))
    gcongr
    linarith
  have hJ := integral_abs_sub_avg_le hF hM hp hy
  rw [hsplit]
  calc |∫ w in fiberDyadicInterval I, (F (w, y) - avg) * (K w - K c)|
      ≤ ∫ w in fiberDyadicInterval I, |F (w, y) - avg| * (A₀ * (L / 2) * kdb s |x - c|) := by
        rw [← Real.norm_eq_abs]
        exact norm_integral_le_of_norm_le (hsub.abs.mul_const _) hbd
    _ = (∫ w in fiberDyadicInterval I, |F (w, y) - avg|) * (A₀ * (L / 2) * kdb s |x - c|) :=
        integral_mul_const _ _
    _ ≤ (2 * L * (2 * H) ^ (1 / p)) * (A₀ * (L / 2) * kdb s |x - c|) := by
        have := kdb_nonneg hs (abs_nonneg (x - c))
        have : 0 < L := Auto.Twisted.fiberDyadicIntervalLength_pos I
        gcongr
    _ = A₀ * (2 * H) ^ (1 / p) * L ^ 2 * kdb s |x - c| := by ring

/-- The bad part `b(·, y)` tested against `φ_s(x - ·)` for `x` outside all `2 I_{y,j}`. -/
theorem enorm_integral_bad_kernel_le {F : ℝ × ℝ → ℝ} (hF : Measurable F) {M : ℝ}
    (hM : ∀ z, |F z| ≤ M) {p H : ℝ} (hp : 1 ≤ p) {φ : ℝ → ℝ} (hφd : Differentiable ℝ φ)
    {A₀ : ℝ} (hφ : ∀ u, |φ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ))
    (hφ' : ∀ u, |deriv φ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ)) {s : ℝ} (hs : 0 < s) (x y : ℝ)
    (hfar : ∀ I, y ∈ czSel F p H I →
      fiberDyadicIntervalLength I ≤ |x - fiberDyadicIntervalCenter I|) :
    ‖∫ w, ((czBad F p H (w, y) : ℝ) : ℂ) * ((kernelAt φ s w x : ℝ) : ℂ)‖ₑ ≤
      ∑' I, (czSel F p H I).indicator 1 y * ENNReal.ofReal (A₀ * (2 * H) ^ (1 / p) *
        fiberDyadicIntervalLength I ^ 2 * kdb s |x - fiberDyadicIntervalCenter I|) := by
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  have e0 : (∫ w, ((czBad F p H (w, y) : ℝ) : ℂ) * ((kernelAt φ s w x : ℝ) : ℂ)) =
      ((∫ w, czBad F p H (w, y) * kernelAt φ s w x : ℝ) : ℂ) := by
    simp_rw [← Complex.ofReal_mul]; exact integral_complex_ofReal
  rw [e0, Auto.monoEnorm_ofReal]
  set sI : FiberDyadicInterval → Set ℝ := fun I =>
    (fun w => (w, y)) ⁻¹' (fiberDyadicInterval I ×ˢ czSel F p H I) with hsIdef
  have hsm : ∀ I, MeasurableSet (sI I) := fun I =>
    (measurable_id.prodMk measurable_const)
      ((Auto.Twisted.measurableSet_fiberDyadicInterval I).prod (measurableSet_czSel hF p H I))
  have hsd : Pairwise (Function.onFun Disjoint sI) := fun I J hIJ =>
    (Auto.Twisted.pairwiseDisjoint_fiberDyadicSelectedRectangles _ _ H (mem_univ I)
      (mem_univ J) hIJ).preimage _
  have hzero : ∀ w ∉ ⋃ I, sI I, czBad F p H (w, y) * kernelAt φ s w x = 0 := by
    intro w hw
    have h0 : czBad F p H (w, y) = 0 :=
      Auto.Twisted.fiberDyadicCountableBadField_eq_zero_outside_exceptional _ _ _ _ _ (by
        intro hmem
        obtain ⟨I, hI⟩ := mem_iUnion.1 hmem
        exact hw (mem_iUnion.2 ⟨I, hI⟩))
    rw [h0, zero_mul]
  have hφint : Integrable φ := integrable_of_decay hφd.continuous.measurable hφ
  have hint : Integrable (fun w => czBad F p H (w, y) * kernelAt φ s w x) :=
    (integrable_kernelAt hφint hs x).bdd_mul
      ((measurable_czBad hF p H).comp (measurable_id.prodMk measurable_const)).aestronglyMeasurable
      (Eventually.of_forall fun w => by
        rw [Real.norm_eq_abs]
        exact Auto.Twisted.abs_fiberDyadicCountableBadField_le_of_bound F _ _ H M hM0 hM _)
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero hzero,
    integral_iUnion hsm hsd hint.integrableOn]
  refine enorm_tsum_le_tsum_enorm.trans (ENNReal.tsum_le_tsum fun I => ?_)
  by_cases hyI : y ∈ czSel F p H I
  · have hsI : sI I = fiberDyadicInterval I := by ext w; simp [hsIdef, hyI]
    rw [hsI, indicator_of_mem hyI, Pi.one_apply, one_mul]
    have e1 : ∫ w in fiberDyadicInterval I, czBad F p H (w, y) * kernelAt φ s w x =
        ∫ w in fiberDyadicInterval I,
          (F (w, y) - fiberDyadicIntervalAverage F I y) * kernelAt φ s w x := by
      refine setIntegral_congr_fun (Auto.Twisted.measurableSet_fiberDyadicInterval I)
        fun w hw => ?_
      have h1 : czBad F p H (w, y) = Auto.Twisted.fiberCZBadAtom F (czSel F p H) I (w, y) :=
        Auto.Twisted.fiberDyadicCountableBadField_eq_atom_of_mem F _ _ H I (w, y) ⟨hw, hyI⟩
      rw [h1]
      unfold Auto.Twisted.fiberCZBadAtom
      rw [indicator_of_mem (show (w, y) ∈ fiberDyadicInterval I ×ˢ czSel F p H I from ⟨hw, hyI⟩)]
    rw [e1, Real.enorm_eq_ofReal_abs]
    exact ENNReal.ofReal_le_ofReal
      (abs_setIntegral_bad_kernel_le hF hM hp hyI hφd hφ hφ' hs (hfar I hyI))
  · have hsI : sI I = ∅ := by ext w; simp [hsIdef, hyI]
    rw [hsI, Measure.restrict_empty, integral_zero_measure, enorm_zero]
    exact bot_le

/-! ### The tail function `h` -/

/-- `h(x, y) = ∑_{I ∈ 𝓘_y} (1 + |x - c_I|/|I|)^{-2}` (an `ℝ≥0∞`-valued function). -/
def tailFn (F : ℝ × ℝ → ℝ) (p H : ℝ) (z : ℝ × ℝ) : ℝ≥0∞ :=
  ∑' I : FiberDyadicInterval, (czSel F p H I).indicator 1 z.2 *
    ENNReal.ofReal (intervalTail (fiberDyadicIntervalCenter I) (fiberDyadicIntervalLength I) z.1)

theorem measurable_tailFn {F : ℝ × ℝ → ℝ} (hF : Measurable F) (p H : ℝ) :
    Measurable (tailFn F p H) := by
  unfold tailFn
  refine Measurable.tsum fun I => ?_
  refine Measurable.mul ?_ ?_
  · exact (measurable_one.indicator (measurableSet_czSel hF p H I)).comp measurable_snd
  · unfold intervalTail; fun_prop

theorem far_of_tailFn_lt {F : ℝ × ℝ → ℝ} {p H : ℝ} {z : ℝ × ℝ}
    (hz : tailFn F p H z < ENNReal.ofReal (1 / 4)) (I : FiberDyadicInterval)
    (hI : z.2 ∈ czSel F p H I) :
    fiberDyadicIntervalLength I ≤ |z.1 - fiberDyadicIntervalCenter I| := by
  by_contra hlt
  push Not at hlt
  have hL0 := Auto.Twisted.fiberDyadicIntervalLength_pos I
  have hterm := ENNReal.le_tsum (f := fun I : FiberDyadicInterval =>
    (czSel F p H I).indicator 1 z.2 *
      ENNReal.ofReal (intervalTail (fiberDyadicIntervalCenter I) (fiberDyadicIntervalLength I)
        z.1)) I
  rw [indicator_of_mem hI, Pi.one_apply, one_mul] at hterm
  have hu : |(z.1 - fiberDyadicIntervalCenter I) / fiberDyadicIntervalLength I| ≤ 1 := by
    rw [abs_div, abs_of_pos hL0, div_le_one hL0]; exact hlt.le
  have h14 : (1 / 4 : ℝ) ≤ intervalTail (fiberDyadicIntervalCenter I)
      (fiberDyadicIntervalLength I) z.1 := by
    unfold intervalTail
    have h2 : (2 : ℝ) ^ (-2 : ℝ) = 1 / 4 := by rw [Real.rpow_neg (by norm_num)]; norm_num
    rw [← h2]
    exact Real.rpow_le_rpow_of_nonpos (by positivity) (by linarith) (by norm_num)
  have := (ENNReal.ofReal_le_ofReal h14).trans (hterm.trans_eq rfl)
  exact absurd (lt_of_le_of_lt this hz) (lt_irrefl _)

theorem lintegral_intervalTail (c r : ℝ) (hr : 0 < r) :
    ∫⁻ x, ENNReal.ofReal (intervalTail c r x) = ENNReal.ofReal (r * intervalTailMass) := by
  rw [← Auto.Twisted.integral_intervalTail c r hr,
    ofReal_integral_eq_lintegral_ofReal (Auto.Twisted.integrable_intervalTail c r hr)
      (Eventually.of_forall fun x => Auto.Twisted.intervalTail_nonneg c r x)]

/-- `∑_{I ∈ 𝓘_y} |I| ≤ H^{-1} ∫ |F(x, y)|^p dx`. -/
theorem tsum_czSel_length_le {F : ℝ × ℝ → ℝ} (hF : Measurable F) {p H : ℝ} (hH : 0 < H)
    (y : ℝ) :
    ∑' I : FiberDyadicInterval, (czSel F p H I).indicator 1 y *
        ENNReal.ofReal (fiberDyadicIntervalLength I) ≤
      ENNReal.ofReal H⁻¹ * ∫⁻ x, ENNReal.ofReal (|F (x, y)| ^ p) := by
  classical
  by_cases hy : y ∈ sourceFiberFiniteMassSet F p
  · have hint : Integrable (fun x => |F (x, y)| ^ p) :=
      Auto.Twisted.mem_fiberFiniteMassSet_integrable (fun yz => |F yz| ^ p) (by fun_prop)
        (fun _ => Real.rpow_nonneg (abs_nonneg _) _) y hy
    rw [ENNReal.tsum_eq_iSup_sum]
    refine iSup_le fun s => ?_
    have e1 : ∑ I ∈ s, (czSel F p H I).indicator 1 y *
          ENNReal.ofReal (fiberDyadicIntervalLength I) =
        ENNReal.ofReal (∑ I ∈ s with y ∈ czSel F p H I, fiberDyadicIntervalLength I) := by
      rw [ENNReal.ofReal_sum_of_nonneg (fun I _ =>
        (Auto.Twisted.fiberDyadicIntervalLength_pos I).le), Finset.sum_filter]
      refine Finset.sum_congr rfl fun I _ => ?_
      by_cases h : y ∈ czSel F p H I
      · rw [indicator_of_mem h, Pi.one_apply, one_mul, if_pos h]
      · rw [indicator_of_notMem h, zero_mul, if_neg h]
    rw [e1, ← ofReal_integral_eq_lintegral_ofReal hint
      (Eventually.of_forall fun _ => Real.rpow_nonneg (abs_nonneg _) _),
      ← ENNReal.ofReal_mul (inv_pos.2 hH).le]
    refine ENNReal.ofReal_le_ofReal ?_
    refine Auto.Twisted.fiberDyadicSelection_finset_length_sum_le (fun yz => |F yz| ^ p)
      (sourceFiberFiniteMassSet F p) H y _
      hH hint (fun _ => Real.rpow_nonneg (abs_nonneg _) _) ?_
    intro I hI
    exact (Finset.mem_filter.1 hI).2
  · have h0 : ∀ I, (czSel F p H I).indicator (1 : ℝ → ℝ≥0∞) y = 0 := fun I =>
      indicator_of_notMem (fun h => hy h.1.1) _
    simp only [h0, zero_mul, tsum_zero]
    exact bot_le

/-- `‖h‖_1 ≲ H^{-1} ‖F‖_p^p`. -/
theorem lintegral_tailFn_le {F : ℝ × ℝ → ℝ} (hF : Measurable F) {p H : ℝ} (hH : 0 < H) :
    ∫⁻ z, tailFn F p H z ≤
      ENNReal.ofReal (intervalTailMass * H⁻¹) * ∫⁻ z, ENNReal.ofReal (|F z| ^ p) := by
  have hm : Measurable (fun z : ℝ × ℝ => ENNReal.ofReal (|F z| ^ p)) := by fun_prop
  rw [Measure.volume_eq_prod, lintegral_prod_symm _ (measurable_tailFn hF p H).aemeasurable,
    lintegral_prod_symm _ hm.aemeasurable, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine lintegral_mono fun y => ?_
  have hmass := Auto.Twisted.intervalTailMass_nonneg
  unfold tailFn
  have hmI : ∀ I : FiberDyadicInterval, Measurable (fun x : ℝ =>
      ENNReal.ofReal (intervalTail (fiberDyadicIntervalCenter I)
        (fiberDyadicIntervalLength I) x)) := by
    intro I; unfold intervalTail; fun_prop
  rw [lintegral_tsum fun I => (((hmI I).const_mul ((czSel F p H I).indicator 1 y))
    : Measurable (fun x : ℝ => (czSel F p H I).indicator 1 (x, y).2 *
      ENNReal.ofReal (intervalTail (fiberDyadicIntervalCenter I)
        (fiberDyadicIntervalLength I) (x, y).1))).aemeasurable]
  calc ∑' I, ∫⁻ x, (czSel F p H I).indicator 1 (x, y).2 *
        ENNReal.ofReal (intervalTail (fiberDyadicIntervalCenter I)
          (fiberDyadicIntervalLength I) (x, y).1)
      = ∑' I, ENNReal.ofReal intervalTailMass * ((czSel F p H I).indicator 1 y *
          ENNReal.ofReal (fiberDyadicIntervalLength I)) := by
        refine tsum_congr fun I => ?_
        dsimp only
        rw [lintegral_const_mul' _ _ (by
          by_cases h : y ∈ czSel F p H I <;> simp [indicator, h]),
          lintegral_intervalTail _ _ (Auto.Twisted.fiberDyadicIntervalLength_pos I),
          ENNReal.ofReal_mul (Auto.Twisted.fiberDyadicIntervalLength_pos I).le]
        ring
    _ = ENNReal.ofReal intervalTailMass * ∑' I, (czSel F p H I).indicator 1 y *
          ENNReal.ofReal (fiberDyadicIntervalLength I) := ENNReal.tsum_mul_left
    _ ≤ ENNReal.ofReal intervalTailMass *
          (ENNReal.ofReal H⁻¹ * ∫⁻ x, ENNReal.ofReal (|F (x, y)| ^ p)) := by
        gcongr; exact tsum_czSel_length_le hF hH y
    _ = ENNReal.ofReal (intervalTailMass * H⁻¹) * ∫⁻ x, ENNReal.ofReal (|F (x, y)| ^ p) := by
        rw [ENNReal.ofReal_mul hmass, mul_assoc]

theorem measurable_kdb (α : ℕ) (d : ℝ) : Measurable (fun t : ℝ => kdb (t ^ α) d) := by
  unfold kdb; fun_prop

/-- **The bad part off the exceptional set**: if `h(z) < 1/4` then
`|U(b, f₂)(z)| ≲ H^{1/p} h(z) 𝓜^{(2)} f₂(z)`. -/
theorem enorm_modelOp_bad_le {α β : ℕ} (hα : 0 < α) {c : ℝ → ℂ} (hc1 : ∀ t, ‖c t‖ ≤ 1)
    {φ ρ : ℝ → ℝ} (hφd : Differentiable ℝ φ) {A₀ : ℝ}
    (hφ : ∀ u, |φ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ))
    (hφ' : ∀ u, |deriv φ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ))
    (hρ : ∀ u, |ρ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ)) {a b : ℝ} (ha : 0 < a)
    {F : ℝ × ℝ → ℝ} (hF : Measurable F) {M : ℝ} (hM : ∀ z, |F z| ≤ M) {p H : ℝ} (hp : 1 ≤ p)
    (hH : 0 < H) {f₂ : ℝ × ℝ → ℂ} (h₂ : Measurable f₂) {M₂ : ℝ} (hM₂ : ∀ z, ‖f₂ z‖ ≤ M₂)
    (z : ℝ × ℝ) (hz : tailFn F p H z < ENNReal.ofReal (1 / 4)) :
    ‖modelOp α β c φ ρ a b (fun w => ((czBad F p H w : ℝ) : ℂ)) f₂ z‖ₑ ≤
      ENNReal.ofReal (32 * A₀ * cMax 1 f₂ z) *
        (ENNReal.ofReal (16 * A₀ * (2 * H) ^ (1 / p) / α) * tailFn F p H z) := by
  have hA₀ := nonneg_of_decay hφ
  have hfar := far_of_tailFn_lt hz
  have hMf : 0 ≤ cMax 1 f₂ z := cMax_nonneg _ _ _
  have hHp : 0 ≤ (2 * H) ^ (1 / p) := Real.rpow_nonneg (by linarith) _
  set B : ℝ × ℝ → ℂ := fun w => ((czBad F p H w : ℝ) : ℂ) with hBdef
  set D : FiberDyadicInterval → ℝ := fun I =>
    A₀ * (2 * H) ^ (1 / p) * fiberDyadicIntervalLength I ^ 2 with hD
  have hD0 : ∀ I, 0 ≤ D I := fun I => by simp only [hD]; positivity
  set d : FiberDyadicInterval → ℝ := fun I => |z.1 - fiberDyadicIntervalCenter I| with hd
  set ind : FiberDyadicInterval → ℝ≥0∞ := fun I => (czSel F p H I).indicator 1 z.2 with hind
  have hind_ne : ∀ I, ind I * ENNReal.ofReal (D I) ≠ ⊤ := fun I => by
    refine ENNReal.mul_ne_top ?_ ENNReal.ofReal_ne_top
    by_cases h : z.2 ∈ czSel F p H I <;> simp [hind, h]
  have hI1 : ∀ t : ℝ, 0 < t → ‖inner1 α φ B t z‖ₑ ≤
      ∑' I, ind I * ENNReal.ofReal (D I * kdb (t ^ α) (d I)) := fun t ht =>
    enorm_integral_bad_kernel_le hF hM hp hφd hφ hφ' (pow_pos ht α) z.1 z.2 (fun I hI => hfar I hI)
  set Cρ : ℝ := 32 * A₀ * cMax 1 f₂ z with hCρ
  have hCρ0 : 0 ≤ Cρ := by positivity
  calc ‖modelOp α β c φ ρ a b B f₂ z‖ₑ
      ≤ ∫⁻ t in Ioc a b, ‖c t * (inner1 α φ B t z * inner2 β ρ f₂ t z) / t‖ₑ :=
        enorm_integral_le_lintegral_enorm _
    _ ≤ ∫⁻ t in Ioi 0, ENNReal.ofReal Cρ * (‖inner1 α φ B t z‖ₑ * ENNReal.ofReal t⁻¹) := by
        refine (setLIntegral_mono' measurableSet_Ioc fun t ht => ?_).trans
          (lintegral_mono_set fun t ht => ha.trans ht.1)
        have ht0 : 0 < t := ha.trans ht.1
        have h2 := norm_inner2_le_cMax hA₀ hρ h₂ hM₂ β ht0 z
        rw [← ofReal_norm, ← ofReal_norm, ← ENNReal.ofReal_mul (norm_nonneg _),
          ← ENNReal.ofReal_mul hCρ0]
        refine ENNReal.ofReal_le_ofReal ?_
        rw [norm_div, norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht0,
          div_eq_mul_inv]
        calc ‖c t‖ * (‖inner1 α φ B t z‖ * ‖inner2 β ρ f₂ t z‖) * t⁻¹
            ≤ 1 * (‖inner1 α φ B t z‖ * Cρ) * t⁻¹ := by
              gcongr
              · exact hc1 t
            _ = Cρ * (‖inner1 α φ B t z‖ * t⁻¹) := by ring
    _ = ENNReal.ofReal Cρ * ∫⁻ t in Ioi 0, ‖inner1 α φ B t z‖ₑ * ENNReal.ofReal t⁻¹ :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
    _ ≤ ENNReal.ofReal Cρ * ∫⁻ t in Ioi 0, ∑' I, ind I * ENNReal.ofReal (D I) *
          (ENNReal.ofReal (kdb (t ^ α) (d I)) * ENNReal.ofReal t⁻¹) := by
        refine mul_le_mul' le_rfl ?_
        refine setLIntegral_mono' measurableSet_Ioi fun t ht => ?_
        calc ‖inner1 α φ B t z‖ₑ * ENNReal.ofReal t⁻¹
            ≤ (∑' I, ind I * ENNReal.ofReal (D I * kdb (t ^ α) (d I))) * ENNReal.ofReal t⁻¹ :=
              mul_le_mul' (hI1 t ht) le_rfl
          _ = ∑' I, ind I * ENNReal.ofReal (D I) *
                (ENNReal.ofReal (kdb (t ^ α) (d I)) * ENNReal.ofReal t⁻¹) := by
              rw [← ENNReal.tsum_mul_right]
              refine tsum_congr fun I => ?_
              rw [ENNReal.ofReal_mul (hD0 I)]; ring
    _ = ENNReal.ofReal Cρ * ∑' I, ind I * ENNReal.ofReal (D I) *
          ∫⁻ t in Ioi 0, ENNReal.ofReal (kdb (t ^ α) (d I)) * ENNReal.ofReal t⁻¹ := by
        congr 1
        have hmeasI : ∀ I, AEMeasurable (fun t : ℝ => ind I * ENNReal.ofReal (D I) *
            (ENNReal.ofReal (kdb (t ^ α) (d I)) * ENNReal.ofReal t⁻¹))
            (volume.restrict (Ioi 0)) := fun I => by
          have := measurable_kdb α (d I)
          exact Measurable.aemeasurable (by fun_prop)
        rw [lintegral_tsum hmeasI]
        exact tsum_congr fun I => lintegral_const_mul' _ _ (hind_ne I)
    _ ≤ ENNReal.ofReal Cρ * ∑' I, ENNReal.ofReal (16 * A₀ * (2 * H) ^ (1 / p) / α) *
          (ind I * ENNReal.ofReal (intervalTail (fiberDyadicIntervalCenter I)
            (fiberDyadicIntervalLength I) z.1)) := by
        refine mul_le_mul' le_rfl ?_
        refine ENNReal.tsum_le_tsum fun I => ?_
        by_cases hI : z.2 ∈ czSel F p H I
        · have hiI : ind I = 1 := by simp only [hind, indicator_of_mem hI, Pi.one_apply]
          rw [hiI, one_mul, one_mul]
          have hL0 := Auto.Twisted.fiberDyadicIntervalLength_pos I
          have hdL : fiberDyadicIntervalLength I ≤ d I := hfar I hI
          have hd0 : 0 < d I := hL0.trans_le hdL
          have htail := Auto.Twisted.radius_sq_div_distance_sq_le_intervalTail_of_double_far
            (c := fiberDyadicIntervalCenter I) (x := z.1)
            (r := fiberDyadicIntervalLength I / 2) (by positivity) (by
              rw [show 2 * (fiberDyadicIntervalLength I / 2) = fiberDyadicIntervalLength I by
                ring]
              exact hdL)
          rw [show 2 * (fiberDyadicIntervalLength I / 2) = fiberDyadicIntervalLength I by ring]
            at htail
          have hα0 : (0 : ℝ) < α := by exact_mod_cast hα
          calc ENNReal.ofReal (D I) *
                ∫⁻ t in Ioi 0, ENNReal.ofReal (kdb (t ^ α) (d I)) * ENNReal.ofReal t⁻¹
              ≤ ENNReal.ofReal (D I) * ENNReal.ofReal (4 / (α * d I ^ 2)) := by
                gcongr; exact lintegral_kdb_le α hα hd0
            _ = ENNReal.ofReal (D I * (4 / (α * d I ^ 2))) :=
                (ENNReal.ofReal_mul (hD0 I)).symm
            _ ≤ ENNReal.ofReal (16 * A₀ * (2 * H) ^ (1 / p) / α *
                  intervalTail (fiberDyadicIntervalCenter I) (fiberDyadicIntervalLength I)
                    z.1) := by
                refine ENNReal.ofReal_le_ofReal ?_
                have e : D I * (4 / (α * d I ^ 2)) = 16 * A₀ * (2 * H) ^ (1 / p) / α *
                    ((fiberDyadicIntervalLength I / 2) ^ 2 / d I ^ 2) := by
                  simp only [hD]; field_simp; ring
                rw [e]
                exact mul_le_mul_of_nonneg_left htail (by positivity)
            _ = _ := ENNReal.ofReal_mul (by positivity)
        · have hiI : ind I = 0 := by simp only [hind, indicator_of_notMem hI]
          rw [hiI]; simp
    _ = ENNReal.ofReal Cρ *
          (ENNReal.ofReal (16 * A₀ * (2 * H) ^ (1 / p) / α) * tailFn F p H z) := by
        rw [ENNReal.tsum_mul_left]; rfl

/-! ### Chebyshev-type helpers -/

theorem meas_lt_norm_le_of_eLpNorm_le {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {f : X → ℂ} (hf : AEStronglyMeasurable f μ) {s : ℝ} (hs : 0 < s) {lam : ℝ} (hl : 0 < lam)
    {B : ℝ} (hB : 0 ≤ B) (h : eLpNorm f (ENNReal.ofReal s) μ ≤ ENNReal.ofReal B) :
    μ {z | lam < ‖f z‖} ≤ ENNReal.ofReal ((B / lam) ^ s) := by
  have hsub : {z | lam < ‖f z‖} ⊆ {z | ENNReal.ofReal lam ≤ ‖f z‖ₑ} := fun z hz => by
    simp only [mem_setOf_eq] at hz ⊢
    rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal hz.le
  refine (measure_mono hsub).trans ?_
  refine (meas_ge_le_mul_pow_eLpNorm_enorm (p := ENNReal.ofReal s) μ (by simp [hs])
    ENNReal.ofReal_ne_top hf (ε := ENNReal.ofReal lam) (by simp [hl])
    (fun h' => absurd h' ENNReal.ofReal_ne_top)).trans ?_
  rw [ENNReal.toReal_ofReal hs.le, ← ENNReal.ofReal_inv_of_pos hl]
  calc ENNReal.ofReal lam⁻¹ ^ s * eLpNorm f (ENNReal.ofReal s) μ ^ s
      ≤ ENNReal.ofReal lam⁻¹ ^ s * ENNReal.ofReal B ^ s := by gcongr
    _ = ENNReal.ofReal ((B / lam) ^ s) := by
        rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) hs.le,
          ENNReal.ofReal_rpow_of_nonneg hB hs.le, ← ENNReal.ofReal_mul (by positivity),
          ← Real.mul_rpow (by positivity) hB, div_eq_mul_inv, mul_comm B]

theorem lintegral_enorm_rpow_le_of_eLpNorm_le {X : Type*} [MeasurableSpace X] {μ : Measure X}
    {f : X → ℂ} {s : ℝ} (hs : 0 < s) {K : ℝ≥0∞} (h : eLpNorm f (ENNReal.ofReal s) μ ≤ K) :
    ∫⁻ z, ‖f z‖ₑ ^ s ∂μ ≤ K ^ s := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simp [hs]) ENNReal.ofReal_ne_top,
    ENNReal.toReal_ofReal hs.le] at h
  calc ∫⁻ z, ‖f z‖ₑ ^ s ∂μ = ((∫⁻ z, ‖f z‖ₑ ^ s ∂μ) ^ (1 / s)) ^ s := by
        rw [one_div, ENNReal.rpow_inv_rpow hs.ne']
    _ ≤ K ^ s := ENNReal.rpow_le_rpow h hs.le

/-- The assumed strong `L^{p₀} × L^{q₀} → L^{r₀}` bound for the truncated model operators. -/
def StrongBound (α β : ℕ) (φ ρ : ℝ → ℝ) (p₀ q₀ r₀ A : ℝ) : Prop :=
  ∀ (a b : ℝ) (c : ℝ → ℂ), 0 < a → a < b → Measurable c → (∀ t, ‖c t‖ ≤ 1) →
    ∀ f₁ f₂ : ℝ × ℝ → ℂ, Measurable f₁ → Measurable f₂ → (∃ M, ∀ z, ‖f₁ z‖ ≤ M) →
    (∃ M, ∀ z, ‖f₂ z‖ ≤ M) → MemLp f₁ (ENNReal.ofReal p₀) → MemLp f₂ (ENNReal.ofReal q₀) →
    eLpNorm (modelOp α β c φ ρ a b f₁ f₂) (ENNReal.ofReal r₀) volume ≤
      ENNReal.ofReal A * eLpNorm f₁ (ENNReal.ofReal p₀) volume *
        eLpNorm f₂ (ENNReal.ofReal q₀) volume

theorem lintegral_ofReal_abs_rpow_le_one {F : ℝ × ℝ → ℝ} {p : ℝ} (hp : 0 < p)
    (hF : eLpNorm (fun z => (F z : ℂ)) (ENNReal.ofReal p) volume ≤ 1) :
    ∫⁻ z, ENNReal.ofReal (|F z| ^ p) ≤ 1 := by
  have h := lintegral_enorm_rpow_le_of_eLpNorm_le hp hF
  rw [ENNReal.one_rpow] at h
  refine le_of_eq_of_le (lintegral_congr fun z => ?_) h
  rw [Auto.monoEnorm_ofReal, Real.enorm_eq_ofReal_abs, ENNReal.ofReal_rpow_of_nonneg
    (abs_nonneg _) hp.le]

/-- **The good part**: Chebyshev and the strong bound. -/
theorem good_part {α β : ℕ} {φ ρ : ℝ → ℝ} (hφm : Measurable φ) (hρm : Measurable ρ)
    {p₀ q₀ r₀ A : ℝ} (hp₀ : 0 < p₀) (hr₀ : 0 < r₀) (hstrong : StrongBound α β φ ρ p₀ q₀ r₀ A)
    {a b : ℝ} {c : ℝ → ℂ} (ha : 0 < a) (hab : a < b) (hc : Measurable c) (hc1 : ∀ t, ‖c t‖ ≤ 1)
    {G : ℝ × ℝ → ℝ} (hG : Measurable G) {MG : ℝ} (hMG : ∀ z, |G z| ≤ MG) {X : ℝ} (hX : 0 ≤ X)
    (hGX : ∫⁻ z, ENNReal.ofReal (|G z| ^ p₀) ≤ ENNReal.ofReal X)
    {f₂ : ℝ × ℝ → ℂ} (h₂ : Measurable f₂) {M₂ : ℝ} (hM₂ : ∀ z, ‖f₂ z‖ ≤ M₂)
    (hf₂ : eLpNorm f₂ (ENNReal.ofReal q₀) volume ≤ 1) {lam : ℝ} (hl : 0 < lam) :
    volume {z | lam < ‖modelOp α β c φ ρ a b (fun z => (G z : ℂ)) f₂ z‖} ≤
      ENNReal.ofReal ((max A 0 * X ^ (1 / p₀) / lam) ^ r₀) := by
  have hGe : eLpNorm (fun z => (G z : ℂ)) (ENNReal.ofReal p₀) volume ≤
      ENNReal.ofReal (X ^ (1 / p₀)) := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simp [hp₀]) ENNReal.ofReal_ne_top,
      ENNReal.toReal_ofReal hp₀.le]
    have e : ∫⁻ z, ‖(G z : ℂ)‖ₑ ^ p₀ = ∫⁻ z, ENNReal.ofReal (|G z| ^ p₀) :=
      lintegral_congr fun z => by
        rw [Auto.monoEnorm_ofReal, Real.enorm_eq_ofReal_abs,
          ENNReal.ofReal_rpow_of_nonneg (abs_nonneg _) hp₀.le]
    rw [e]
    calc (∫⁻ z, ENNReal.ofReal (|G z| ^ p₀)) ^ (1 / p₀) ≤ ENNReal.ofReal X ^ (1 / p₀) :=
          ENNReal.rpow_le_rpow hGX (by positivity)
      _ = ENNReal.ofReal (X ^ (1 / p₀)) := ENNReal.ofReal_rpow_of_nonneg hX (by positivity)
  have hGm : Measurable (fun z => (G z : ℂ)) := Complex.measurable_ofReal.comp hG
  have hmemG : MemLp (fun z => (G z : ℂ)) (ENNReal.ofReal p₀) :=
    ⟨hGm.aestronglyMeasurable, hGe.trans_lt ENNReal.ofReal_lt_top⟩
  have hmem2 : MemLp f₂ (ENNReal.ofReal q₀) :=
    ⟨h₂.aestronglyMeasurable, hf₂.trans_lt ENNReal.one_lt_top⟩
  have hs := hstrong a b c ha hab hc hc1 _ f₂ hGm h₂
    ⟨MG, fun z => by rw [Complex.norm_real, Real.norm_eq_abs]; exact hMG z⟩ ⟨M₂, hM₂⟩ hmemG hmem2
  have hs' : eLpNorm (modelOp α β c φ ρ a b (fun z => (G z : ℂ)) f₂) (ENNReal.ofReal r₀) volume ≤
      ENNReal.ofReal (max A 0 * X ^ (1 / p₀)) := by
    calc _ ≤ _ := hs
      _ ≤ ENNReal.ofReal (max A 0) * ENNReal.ofReal (X ^ (1 / p₀)) * 1 := by
          gcongr
          exact le_max_left _ _
      _ = ENNReal.ofReal (max A 0 * X ^ (1 / p₀)) := by
          rw [mul_one, ENNReal.ofReal_mul (le_max_right _ _)]
  exact meas_lt_norm_le_of_eLpNorm_le
    (stronglyMeasurable_modelOp α β hc hφm hρm a b hGm h₂).aestronglyMeasurable hr₀ hl
    (by positivity) hs'

/-- **The maximal part**: the weak-type bound for `𝓜^{(2)} f₂`. -/
theorem max_part {q₀ : ℝ} (hq₀ : 1 < q₀) {f₂ : ℝ × ℝ → ℂ} (h₂ : Measurable f₂) {M₂ : ℝ}
    (hM₂ : ∀ z, ‖f₂ z‖ ≤ M₂) (hf₂ : eLpNorm f₂ (ENNReal.ofReal q₀) volume ≤ 1) {μ : ℝ}
    (hμ : 0 < μ) :
    volume {z | μ < cMax 1 f₂ z} ≤ ENNReal.ofReal
      (shiftedMaximalLpConst q₀ * Real.log (2 + |(-1 / 2 : ℝ)|) * (μ ^ q₀)⁻¹) := by
  have hq0 : 0 < q₀ := by linarith
  set Cm := shiftedMaximalLpConst q₀ * Real.log (2 + |(-1 / 2 : ℝ)|) with hCm
  have hCm0 : 0 ≤ Cm := mul_nonneg (shiftedMaximalLpConst_pos hq₀).le
    (Real.log_nonneg (by linarith [abs_nonneg (-1 / 2 : ℝ)]))
  have hsub : {z | μ < cMax 1 f₂ z} ⊆
      {z | ENNReal.ofReal (μ ^ q₀) ≤ ENNReal.ofReal (cMax 1 f₂ z ^ q₀)} := fun z hz =>
    ENNReal.ofReal_le_ofReal (Real.rpow_le_rpow hμ.le (le_of_lt hz) hq0.le)
  have hmeas : Measurable (fun z => ENNReal.ofReal (cMax 1 f₂ z ^ q₀)) :=
    ((measurable_cShift 1 (-1 / 2) h₂).pow_const q₀).ennreal_ofReal
  have hμq : 0 < μ ^ q₀ := Real.rpow_pos_of_pos hμ q₀
  refine (measure_mono hsub).trans ((meas_ge_le_lintegral_div hmeas.aemeasurable
    (by simp [hμq]) ENNReal.ofReal_ne_top).trans ?_)
  have hL := lintegral_cShift_rpow_le 1 (-1 / 2) hq₀ h₂ hM₂
  have h1 : ∫⁻ z, ENNReal.ofReal ‖f₂ z‖ ^ q₀ ≤ 1 := by
    have := lintegral_enorm_rpow_le_of_eLpNorm_le hq0 hf₂
    rw [ENNReal.one_rpow] at this
    simpa only [ofReal_norm] using this
  calc (∫⁻ z, ENNReal.ofReal (cMax 1 f₂ z ^ q₀)) / ENNReal.ofReal (μ ^ q₀)
      ≤ (ENNReal.ofReal Cm * 1) / ENNReal.ofReal (μ ^ q₀) := by
        refine ENNReal.div_le_div_right ?_ _
        exact hL.trans (mul_le_mul' le_rfl h1)
    _ = ENNReal.ofReal (Cm * (μ ^ q₀)⁻¹) := by
        rw [mul_one, ← ENNReal.ofReal_div_of_pos hμq, div_eq_mul_inv]

/-- **The exceptional set**: `|{h ≥ 1/4}| ≤ 4 ‖h‖_1 ≲ H^{-1}`. -/
theorem tail_part {F : ℝ × ℝ → ℝ} (hF : Measurable F) {p H : ℝ} (hH : 0 < H)
    (hFp : ∫⁻ z, ENNReal.ofReal (|F z| ^ p) ≤ 1) :
    volume {z | ENNReal.ofReal (1 / 4) ≤ tailFn F p H z} ≤
      ENNReal.ofReal (4 * intervalTailMass * H⁻¹) := by
  have hmass := Auto.Twisted.intervalTailMass_nonneg
  refine (meas_ge_le_lintegral_div (measurable_tailFn hF p H).aemeasurable (by norm_num)
    ENNReal.ofReal_ne_top).trans ?_
  calc (∫⁻ z, tailFn F p H z) / ENNReal.ofReal (1 / 4)
      ≤ (ENNReal.ofReal (intervalTailMass * H⁻¹) * 1) / ENNReal.ofReal (1 / 4) :=
        ENNReal.div_le_div_right ((lintegral_tailFn_le hF hH).trans (mul_le_mul' le_rfl hFp)) _
    _ = ENNReal.ofReal (4 * intervalTailMass * H⁻¹) := by
        rw [mul_one, ← ENNReal.ofReal_div_of_pos (by norm_num)]
        congr 1; ring

/-- The exponent bookkeeping of the good part. -/
theorem good_algebra {A' lam p p₀ q₀ : ℝ} (hA' : 0 ≤ A') (hl : 0 < lam) (hp : 0 < p)
    (hp₀ : 0 < p₀) (hq₀ : 0 < q₀) :
    (A' * ((2 * lam ^ (1 / (1 / p + 1 / q₀))) ^ ((p₀ - p) / p)) ^ (1 / p₀) / lam) ^
        (1 / (1 / p₀ + 1 / q₀)) =
      A' ^ (1 / (1 / p₀ + 1 / q₀)) * 2 ^ ((p₀ - p) / p * (1 / p₀) * (1 / (1 / p₀ + 1 / q₀))) *
        lam ^ (-(1 / (1 / p + 1 / q₀))) := by
  set r := 1 / (1 / p + 1 / q₀) with hr
  set r₀ := 1 / (1 / p₀ + 1 / q₀) with hr₀
  set e := (p₀ - p) / p * (1 / p₀) * r₀ with he
  have h2l : 0 ≤ 2 * lam ^ r := by positivity
  have hX : 0 ≤ ((2 * lam ^ r) ^ ((p₀ - p) / p)) ^ (1 / p₀) := by positivity
  rw [Real.div_rpow (mul_nonneg hA' hX) hl.le, Real.mul_rpow hA' hX, ← Real.rpow_mul
    (Real.rpow_nonneg h2l _), ← Real.rpow_mul h2l, Real.mul_rpow (by norm_num) (by positivity),
    ← Real.rpow_mul hl.le]
  have he' : (p₀ - p) / p * (1 / p₀ * r₀) = e := by rw [he]; ring
  rw [he']
  have hexp : r * e - r₀ = -r := by
    rw [he, hr, hr₀]; field_simp; ring
  have : lam ^ (r * e) / lam ^ r₀ = lam ^ (-r) := by
    rw [← Real.rpow_sub hl, hexp]
  rw [mul_div_assoc, mul_assoc, mul_div_assoc, this]

/-- **The normalized weak-type estimate for real inputs in the first slot**, with a constant
depending only on `α, A₀, p₀, q₀, A, p` (chosen before the kernels). -/
theorem core_weak {α β : ℕ} (hα : 0 < α) {A₀ : ℝ} (hA₀ : 0 ≤ A₀)
    {p₀ q₀ r₀ : ℝ} (hp₀ : 1 < p₀) (hq₀ : 1 < q₀) (hr₀ : 1 / r₀ = 1 / p₀ + 1 / q₀) {A : ℝ}
    {p : ℝ} (hp : 1 ≤ p) (hpp : p ≤ p₀) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (φ ρ : ℝ → ℝ), Differentiable ℝ φ → Differentiable ℝ ρ →
      (∀ u, |φ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ)) →
      (∀ u, |deriv φ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ)) →
      (∀ u, |ρ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ)) →
      StrongBound α β φ ρ p₀ q₀ r₀ A → ∀ (a b : ℝ) (c : ℝ → ℂ), 0 < a → a < b → Measurable c →
      (∀ t, ‖c t‖ ≤ 1) → ∀ (F : ℝ × ℝ → ℝ) (f₂ : ℝ × ℝ → ℂ), Measurable F → Measurable f₂ →
      (∃ M, ∀ z, |F z| ≤ M) → (∃ M, ∀ z, ‖f₂ z‖ ≤ M) →
      eLpNorm (fun z => (F z : ℂ)) (ENNReal.ofReal p) volume ≤ 1 →
      eLpNorm f₂ (ENNReal.ofReal q₀) volume ≤ 1 → ∀ lam : ℝ, 0 < lam →
        volume {z | lam < ‖modelOp α β c φ ρ a b (fun z => (F z : ℂ)) f₂ z‖} ≤
          ENNReal.ofReal (C * lam ^ (-(1 / (1 / p + 1 / q₀)))) := by
  have hr₀' : r₀ = 1 / (1 / p₀ + 1 / q₀) := by rw [← hr₀, one_div_one_div]
  subst hr₀'
  have hp0 : 0 < p := by linarith
  have hp₀0 : 0 < p₀ := by linarith
  have hq0 : 0 < q₀ := by linarith
  set r := 1 / (1 / p + 1 / q₀) with hr
  set r₀ := 1 / (1 / p₀ + 1 / q₀) with hr₀def
  have hr0 : 0 < r := by rw [hr]; positivity
  have hr₀0 : 0 < r₀ := by rw [hr₀def]; positivity
  have hrsum : r / q₀ + r / p = 1 := by rw [hr]; field_simp; ring
  have hα0 : (0 : ℝ) < α := by exact_mod_cast hα
  have hmass := Auto.Twisted.intervalTailMass_nonneg
  set Kb : ℝ := 32 * A₀ * (16 * A₀ * 2 ^ (1 / p) / α) / 4 with hKb
  have hKb0 : 0 ≤ Kb := by positivity
  set Cg : ℝ := max A 0 ^ r₀ * 2 ^ ((p₀ - p) / p * (1 / p₀) * r₀) with hCg
  set Ct : ℝ := 4 * intervalTailMass with hCt
  set Cm : ℝ := shiftedMaximalLpConst q₀ * Real.log (2 + |(-1 / 2 : ℝ)|) with hCm
  have hCg0 : 0 ≤ Cg := by positivity
  have hCm0 : 0 ≤ Cm := mul_nonneg (shiftedMaximalLpConst_pos hq₀).le
    (Real.log_nonneg (by linarith [abs_nonneg (-1 / 2 : ℝ)]))
  set Ctot := Cg + Ct + Cm with hCtot
  have hCtot0 : 0 ≤ Ctot := by positivity
  refine ⟨Ctot * (1 + Kb) ^ r, by positivity, ?_⟩
  intro φ ρ hφd hρd hφ hφ' hρ hstrong a b c ha hab hc hc1 F f₂ hF h₂ hFb hf₂b hF1 hf₂1 lam hlam
  obtain ⟨M, hM⟩ := hFb
  obtain ⟨M₂, hM₂⟩ := hf₂b
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  have hFp := lintegral_ofReal_abs_rpow_le_one hp0 hF1
  have hφm := hφd.continuous.measurable
  have hρm := hρd.continuous.measurable
  have hφi := integrable_of_decay hφm hφ
  have hρi := integrable_of_decay hρm hρ
  have claim : ∀ l : ℝ, 0 < l → volume {z | (1 + Kb) * l <
      ‖modelOp α β c φ ρ a b (fun z => (F z : ℂ)) f₂ z‖} ≤ ENNReal.ofReal (Ctot * l ^ (-r)) := by
    intro l hl
    set H := l ^ r with hH
    have hH0 : 0 < H := Real.rpow_pos_of_pos hl r
    set G := czGood F p H with hG
    set B := czBad F p H with hB
    have hGm : Measurable G := measurable_czGood hF p H
    have hBm : Measurable B := measurable_czBad hF p H
    have hGb : ∀ z, ‖(G z : ℂ)‖ ≤ 3 * M := fun z => by
      rw [Complex.norm_real, Real.norm_eq_abs]
      exact Auto.Twisted.abs_fiberDyadicCountableGoodField_le_of_bound F _ _ H M hM0 hM z
    have hBb : ∀ z, ‖(B z : ℂ)‖ ≤ 2 * M := fun z => by
      rw [Complex.norm_real, Real.norm_eq_abs]
      exact Auto.Twisted.abs_fiberDyadicCountableBadField_le_of_bound F _ _ H M hM0 hM z
    have hdec : ∀ z, modelOp α β c φ ρ a b (fun z => (F z : ℂ)) f₂ z =
        modelOp α β c φ ρ a b (fun z => (G z : ℂ)) f₂ z +
          modelOp α β c φ ρ a b (fun z => (B z : ℂ)) f₂ z := by
      intro z
      have e : (fun w => (F w : ℂ)) = (fun w => (G w : ℂ)) + (fun w => (B w : ℂ)) := by
        funext w
        have := congrFun (Auto.Twisted.fiberDyadicCountableGoodBad_decomposition F
          (sourceFiberFiniteMassSet F p) (czAvg F p) H) w
        simp only [Pi.add_apply] at this ⊢
        rw [← this]; push_cast; ring
      rw [e]
      exact modelOp_add_left α β hc hc1 hφm hρm hφi hρi ha
        (Complex.measurable_ofReal.comp hGm) (Complex.measurable_ofReal.comp hBm) h₂ hGb hBb
        hM₂ z
    set μ := l ^ (r / q₀) with hμ
    have hμ0 : 0 < μ := Real.rpow_pos_of_pos hl _
    have hsub : {z | (1 + Kb) * l < ‖modelOp α β c φ ρ a b (fun z => (F z : ℂ)) f₂ z‖} ⊆
        {z | l < ‖modelOp α β c φ ρ a b (fun z => (G z : ℂ)) f₂ z‖} ∪
          ({z | ENNReal.ofReal (1 / 4) ≤ tailFn F p H z} ∪ {z | μ < cMax 1 f₂ z}) := by
      intro z hz
      by_contra hn
      simp only [mem_union, mem_setOf_eq, not_or, not_lt, not_le] at hn hz
      obtain ⟨h1, h2, h3⟩ := hn
      have hb := enorm_modelOp_bad_le (β := β) (b := b) hα hc1 hφd hφ hφ' hρ ha hF hM hp hH0
        h₂ hM₂ z h2
      have hD' : 0 ≤ 16 * A₀ * (2 * H) ^ (1 / p) / α := by
        have : 0 ≤ (2 * H) ^ (1 / p) := Real.rpow_nonneg (by positivity) _
        positivity
      have step : ‖modelOp α β c φ ρ a b (fun w => ((czBad F p H w : ℝ) : ℂ)) f₂ z‖ₑ ≤
          ENNReal.ofReal (32 * A₀ * μ) *
            (ENNReal.ofReal (16 * A₀ * (2 * H) ^ (1 / p) / α) * ENNReal.ofReal (1 / 4)) :=
        hb.trans (mul_le_mul' (ENNReal.ofReal_le_ofReal (by gcongr))
          (mul_le_mul' le_rfl h2.le))
      rw [← ENNReal.ofReal_mul hD', ← ENNReal.ofReal_mul (by positivity)] at step
      have hHp : (2 * H) ^ (1 / p) = 2 ^ (1 / p) * l ^ (r / p) := by
        rw [Real.mul_rpow (by norm_num) hH0.le, hH, ← Real.rpow_mul hl.le, mul_one_div]
      have hμl : μ * l ^ (r / p) = l := by
        rw [hμ, ← Real.rpow_add hl, hrsum, Real.rpow_one]
      have hval : 32 * A₀ * μ * (16 * A₀ * (2 * H) ^ (1 / p) / α * (1 / 4)) = Kb * l := by
        rw [hHp, show 32 * A₀ * μ * (16 * A₀ * (2 ^ (1 / p) * l ^ (r / p)) / α * (1 / 4)) =
          Kb * (μ * l ^ (r / p)) by rw [hKb]; ring, hμl]
      rw [hval, ← ofReal_norm] at step
      have hb' := (ENNReal.ofReal_le_ofReal_iff (by positivity)).1 step
      have htri := norm_add_le (modelOp α β c φ ρ a b (fun z => (G z : ℂ)) f₂ z)
        (modelOp α β c φ ρ a b (fun z => (B z : ℂ)) f₂ z)
      rw [← hdec] at htri
      linarith
    have hGX : ∫⁻ z, ENNReal.ofReal (|G z| ^ p₀) ≤
        ENNReal.ofReal ((2 * H) ^ ((p₀ - p) / p)) := by
      have h := Auto.Twisted.lintegral_prod_rpow_fiberDyadicCountableGoodField_le
        (volume : Measure ℝ) F hp hpp hH0 hF
      rw [← Measure.volume_eq_prod] at h
      exact h.trans (le_of_le_of_eq (mul_le_mul' le_rfl hFp) (mul_one _))
    have hgood := good_part hφm hρm hp₀0 hr₀0 hstrong ha hab hc hc1 hGm
      (fun z => (Auto.Twisted.abs_fiberDyadicCountableGoodField_le_of_bound F _ _ H M hM0 hM z))
      (Real.rpow_nonneg (by positivity) _) hGX h₂ hM₂ hf₂1 hl
    rw [hH, good_algebra (le_max_right A 0) hl hp0 hp₀0 hq0] at hgood
    have htail := tail_part hF hH0 hFp
    rw [hH, ← Real.rpow_neg hl.le] at htail
    have hmax := max_part hq₀ h₂ hM₂ hf₂1 hμ0
    rw [hμ, ← Real.rpow_mul hl.le, div_mul_cancel₀ _ hq0.ne', ← Real.rpow_neg hl.le] at hmax
    calc volume {z | (1 + Kb) * l < ‖modelOp α β c φ ρ a b (fun z => (F z : ℂ)) f₂ z‖}
        ≤ volume ({z | l < ‖modelOp α β c φ ρ a b (fun z => (G z : ℂ)) f₂ z‖} ∪
          ({z | ENNReal.ofReal (1 / 4) ≤ tailFn F p H z} ∪ {z | μ < cMax 1 f₂ z})) :=
          measure_mono hsub
      _ ≤ volume {z | l < ‖modelOp α β c φ ρ a b (fun z => (G z : ℂ)) f₂ z‖} +
          (volume {z | ENNReal.ofReal (1 / 4) ≤ tailFn F p H z} +
            volume {z | μ < cMax 1 f₂ z}) :=
          (measure_union_le _ _).trans (add_le_add le_rfl (measure_union_le _ _))
      _ ≤ ENNReal.ofReal (Cg * l ^ (-r)) +
          (ENNReal.ofReal (4 * intervalTailMass * l ^ (-r)) + ENNReal.ofReal (Cm * l ^ (-r))) :=
          add_le_add hgood (add_le_add htail hmax)
      _ = ENNReal.ofReal (Ctot * l ^ (-r)) := by
          have hlr : 0 ≤ l ^ (-r) := Real.rpow_nonneg hl.le _
          rw [← ENNReal.ofReal_add (by positivity) (by positivity),
            ← ENNReal.ofReal_add (by positivity) (by positivity)]
          congr 1; rw [hCtot, hCt]; ring
  have hK1 : 0 < 1 + Kb := by linarith
  have h := claim (lam / (1 + Kb)) (div_pos hlam hK1)
  rw [mul_div_cancel₀ _ hK1.ne'] at h
  refine h.trans (le_of_eq ?_)
  congr 1
  rw [Real.div_rpow hlam.le hK1.le, Real.rpow_neg hK1.le, div_inv_eq_mul]
  ring

/-- **Homogeneity and complex inputs**: the weak bound at fixed upper bounds `k₁, k₂` for the
norms. -/
theorem weak_of_bounds {α β : ℕ} {c : ℝ → ℂ} (hc : Measurable c) (hc1 : ∀ t, ‖c t‖ ≤ 1)
    {φ ρ : ℝ → ℝ} (hφm : Measurable φ) (hρm : Measurable ρ) (hφi : Integrable φ)
    (hρi : Integrable ρ) {a b : ℝ} (ha : 0 < a) {p q r C : ℝ}
    (hC : ∀ (F : ℝ × ℝ → ℝ) (f₂ : ℝ × ℝ → ℂ), Measurable F → Measurable f₂ →
      (∃ M, ∀ z, |F z| ≤ M) → (∃ M, ∀ z, ‖f₂ z‖ ≤ M) →
      eLpNorm (fun z => (F z : ℂ)) (ENNReal.ofReal p) volume ≤ 1 →
      eLpNorm f₂ (ENNReal.ofReal q) volume ≤ 1 → ∀ lam : ℝ, 0 < lam →
        volume {z | lam < ‖modelOp α β c φ ρ a b (fun z => (F z : ℂ)) f₂ z‖} ≤
          ENNReal.ofReal (C * lam ^ (-r)))
    (hC0 : 0 ≤ C)
    {f₁ f₂ : ℝ × ℝ → ℂ} (h₁ : Measurable f₁) (h₂ : Measurable f₂) {M₁ M₂ : ℝ}
    (hM₁ : ∀ z, ‖f₁ z‖ ≤ M₁) (hM₂ : ∀ z, ‖f₂ z‖ ≤ M₂) {k₁ k₂ : ℝ} (hk₁ : 0 < k₁) (hk₂ : 0 < k₂)
    (hf₁ : eLpNorm f₁ (ENNReal.ofReal p) volume ≤ ENNReal.ofReal k₁)
    (hf₂ : eLpNorm f₂ (ENNReal.ofReal q) volume ≤ ENNReal.ofReal k₂) {lam : ℝ} (hlam : 0 < lam) :
    volume {z | lam < ‖modelOp α β c φ ρ a b f₁ f₂ z‖} ≤
      ENNReal.ofReal (2 * 2 ^ r * C * lam ^ (-r) * (k₁ * k₂) ^ r) := by
  set u : ℝ × ℝ → ℝ := fun z => (f₁ z).re / k₁ with hu
  set v : ℝ × ℝ → ℝ := fun z => (f₁ z).im / k₁ with hv
  set g : ℝ × ℝ → ℂ := fun z => ((k₂⁻¹ : ℝ) : ℂ) * f₂ z with hg
  have hum : Measurable u := (Complex.measurable_re.comp h₁).div_const _
  have hvm : Measurable v := (Complex.measurable_im.comp h₁).div_const _
  have hgm : Measurable g := measurable_const.mul h₂
  have hub : ∀ z, |u z| ≤ M₁ / k₁ := fun z => by
    rw [hu, abs_div, abs_of_pos hk₁]
    exact div_le_div_of_nonneg_right ((Complex.abs_re_le_norm _).trans (hM₁ z)) hk₁.le
  have hvb : ∀ z, |v z| ≤ M₁ / k₁ := fun z => by
    rw [hv, abs_div, abs_of_pos hk₁]
    exact div_le_div_of_nonneg_right ((Complex.abs_im_le_norm _).trans (hM₁ z)) hk₁.le
  have hgb : ∀ z, ‖g z‖ ≤ k₂⁻¹ * M₂ := fun z => by
    rw [hg, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (inv_pos.2 hk₂)]
    exact mul_le_mul_of_nonneg_left (hM₂ z) (inv_pos.2 hk₂).le
  have hscale : ∀ {k : ℝ}, 0 < k → ∀ {f : ℝ × ℝ → ℂ} {s : ℝ},
      eLpNorm f (ENNReal.ofReal s) volume ≤ ENNReal.ofReal k →
      eLpNorm (fun z => ((k⁻¹ : ℝ) : ℂ) * f z) (ENNReal.ofReal s) volume ≤ 1 := by
    intro k hk f s hf
    have e : (fun z => ((k⁻¹ : ℝ) : ℂ) * f z) = ((k⁻¹ : ℝ) : ℂ) • f := rfl
    rw [e, eLpNorm_const_smul, Auto.monoEnorm_ofReal, Real.enorm_eq_ofReal_abs,
      abs_of_pos (inv_pos.2 hk)]
    calc ENNReal.ofReal k⁻¹ * eLpNorm f (ENNReal.ofReal s) volume
        ≤ ENNReal.ofReal k⁻¹ * ENNReal.ofReal k := mul_le_mul' le_rfl hf
      _ = 1 := by
          rw [← ENNReal.ofReal_mul (inv_pos.2 hk).le, inv_mul_cancel₀ hk.ne', ENNReal.ofReal_one]
  have hu1 : eLpNorm (fun z => (u z : ℂ)) (ENNReal.ofReal p) volume ≤ 1 := by
    refine (eLpNorm_mono fun z => ?_).trans (hscale hk₁ hf₁)
    rw [hu, Complex.norm_real, Real.norm_eq_abs, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_div, abs_of_pos hk₁, abs_of_pos (inv_pos.2 hk₁), div_eq_inv_mul]
    exact mul_le_mul_of_nonneg_left (Complex.abs_re_le_norm _) (inv_pos.2 hk₁).le
  have hv1 : eLpNorm (fun z => (v z : ℂ)) (ENNReal.ofReal p) volume ≤ 1 := by
    refine (eLpNorm_mono fun z => ?_).trans (hscale hk₁ hf₁)
    rw [hv, Complex.norm_real, Real.norm_eq_abs, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_div, abs_of_pos hk₁, abs_of_pos (inv_pos.2 hk₁), div_eq_inv_mul]
    exact mul_le_mul_of_nonneg_left (Complex.abs_im_le_norm _) (inv_pos.2 hk₁).le
  have hg1 : eLpNorm g (ENNReal.ofReal q) volume ≤ 1 := hscale hk₂ hf₂
  have hcmu : Measurable (fun z => (u z : ℂ)) := Complex.measurable_ofReal.comp hum
  have hcmv : Measurable (fun z => Complex.I * (v z : ℂ)) :=
    measurable_const.mul (Complex.measurable_ofReal.comp hvm)
  have hcub : ∀ z, ‖(u z : ℂ)‖ ≤ M₁ / k₁ := fun z => by
    rw [Complex.norm_real, Real.norm_eq_abs]; exact hub z
  have hcvb : ∀ z, ‖Complex.I * (v z : ℂ)‖ ≤ M₁ / k₁ := fun z => by
    rw [norm_mul, Complex.norm_I, one_mul, Complex.norm_real, Real.norm_eq_abs]; exact hvb z
  have hdec : ∀ z, modelOp α β c φ ρ a b f₁ f₂ z = ((k₁ * k₂ : ℝ) : ℂ) *
      (modelOp α β c φ ρ a b (fun z => (u z : ℂ)) g z +
        Complex.I * modelOp α β c φ ρ a b (fun z => (v z : ℂ)) g z) := by
    intro z
    have e1 : f₁ = fun w =>
        (k₁ : ℂ) * ((fun w => (u w : ℂ)) + fun w => Complex.I * (v w : ℂ)) w := by
      have hk₁0 : k₁ ≠ 0 := hk₁.ne'
      funext w
      apply Complex.ext <;> simp [hu, hv] <;> field_simp
    have e2 : f₂ = fun w => (k₂ : ℂ) * g w := by
      funext w
      rw [hg, ← mul_assoc, ← Complex.ofReal_mul, mul_inv_cancel₀ hk₂.ne', Complex.ofReal_one,
        one_mul]
    rw [e1, e2, modelOp_smul_left, modelOp_smul_right,
      modelOp_add_left α β hc hc1 hφm hρm hφi hρi ha hcmu hcmv hgm hcub hcvb hgb z,
      modelOp_smul_left]
    push_cast; ring
  have hk : 0 < k₁ * k₂ := mul_pos hk₁ hk₂
  set l := lam / (2 * (k₁ * k₂)) with hl
  have hl0 : 0 < l := by positivity
  have hsub : {z | lam < ‖modelOp α β c φ ρ a b f₁ f₂ z‖} ⊆
      {z | l < ‖modelOp α β c φ ρ a b (fun z => (u z : ℂ)) g z‖} ∪
        {z | l < ‖modelOp α β c φ ρ a b (fun z => (v z : ℂ)) g z‖} := by
    intro z hz
    by_contra hn
    simp only [mem_union, mem_setOf_eq, not_or, not_lt] at hn hz
    rw [hdec, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hk] at hz
    have h3 := norm_add_le (modelOp α β c φ ρ a b (fun z => (u z : ℂ)) g z)
      (Complex.I * modelOp α β c φ ρ a b (fun z => (v z : ℂ)) g z)
    rw [norm_mul, Complex.norm_I, one_mul] at h3
    have h4 : (k₁ * k₂) * ‖modelOp α β c φ ρ a b (fun z => (u z : ℂ)) g z +
        Complex.I * modelOp α β c φ ρ a b (fun z => (v z : ℂ)) g z‖ ≤ (k₁ * k₂) * (2 * l) := by
      gcongr; linarith [hn.1, hn.2]
    have h5 : (k₁ * k₂) * (2 * l) = lam := by rw [hl]; field_simp
    linarith
  have hU := hC u g hum hgm ⟨_, hub⟩ ⟨_, hgb⟩ hu1 hg1 l hl0
  have hV := hC v g hvm hgm ⟨_, hvb⟩ ⟨_, hgb⟩ hv1 hg1 l hl0
  calc volume {z | lam < ‖modelOp α β c φ ρ a b f₁ f₂ z‖}
      ≤ ENNReal.ofReal (C * l ^ (-r)) + ENNReal.ofReal (C * l ^ (-r)) :=
        (measure_mono hsub).trans ((measure_union_le _ _).trans (add_le_add hU hV))
    _ = ENNReal.ofReal (2 * 2 ^ r * C * lam ^ (-r) * (k₁ * k₂) ^ r) := by
        rw [← ENNReal.ofReal_add (by positivity) (by positivity)]
        congr 1
        have hy : (0 : ℝ) ≤ 2 * (k₁ * k₂) := by positivity
        rw [hl, Real.div_rpow hlam.le hy, Real.rpow_neg hy, div_inv_eq_mul,
          Real.mul_rpow (by norm_num) hk.le]
        ring

/-- Passing from the weak bound at all upper bounds `k₁ > ‖f₁‖`, `k₂ > ‖f₂‖` to the norms. -/
theorem le_of_forall_bounds {S : ℝ≥0∞} {N₁ N₂ : ℝ≥0∞} (h₁ : N₁ ≠ ⊤) (h₂ : N₂ ≠ ⊤) {K r : ℝ}
    (hK : 0 ≤ K) (hr : 0 < r)
    (h : ∀ k₁ k₂ : ℝ, 0 < k₁ → 0 < k₂ → N₁ ≤ ENNReal.ofReal k₁ → N₂ ≤ ENNReal.ofReal k₂ →
      S ≤ ENNReal.ofReal (K * (k₁ * k₂) ^ r)) :
    S ≤ ENNReal.ofReal K * (N₁ * N₂) ^ r := by
  set n₁ := N₁.toReal
  set n₂ := N₂.toReal
  have hn₁ : 0 ≤ n₁ := ENNReal.toReal_nonneg
  have hn₂ : 0 ≤ n₂ := ENNReal.toReal_nonneg
  have hf : Tendsto (fun ε : ℝ => ENNReal.ofReal (K * ((n₁ + ε) * (n₂ + ε)) ^ r)) (𝓝[>] 0)
      (𝓝 (ENNReal.ofReal (K * ((n₁ + 0) * (n₂ + 0)) ^ r))) := by
    refine tendsto_nhdsWithin_of_tendsto_nhds (ENNReal.continuous_ofReal.continuousAt.tendsto.comp
      ?_)
    refine Continuous.tendsto ?_ 0
    exact continuous_const.mul (((continuous_const.add continuous_id).mul
      (continuous_const.add continuous_id)).rpow_const fun _ => Or.inr hr.le)
  have hev : ∀ᶠ ε in 𝓝[>] (0 : ℝ), S ≤ ENNReal.ofReal (K * ((n₁ + ε) * (n₂ + ε)) ^ r) := by
    filter_upwards [self_mem_nhdsWithin] with ε hε
    have hε0 : 0 < ε := hε
    refine h _ _ (by positivity) (by positivity) ?_ ?_
    · rw [← ENNReal.ofReal_toReal h₁]; exact ENNReal.ofReal_le_ofReal (by linarith)
    · rw [← ENNReal.ofReal_toReal h₂]; exact ENNReal.ofReal_le_ofReal (by linarith)
  refine (ge_of_tendsto hf hev).trans (le_of_eq ?_)
  rw [add_zero, add_zero, ENNReal.ofReal_mul hK, ← ENNReal.ofReal_rpow_of_nonneg (by positivity)
    hr.le, ENNReal.ofReal_mul hn₁, ENNReal.ofReal_toReal h₁, ENNReal.ofReal_toReal h₂]

end

end FiberCZ

open MeasureTheory Set Filter
open scoped ENNReal Topology

open FiberCZ in
/-- **Weak-type estimate via the fiber-wise Calderón-Zygmund decomposition in the first
fiber**, uniform version: the constant depends only on `α, β, A₀, p₀, q₀, r₀, A, p` and is chosen
before the kernels `φ, ρ`. -/
theorem modelOp_weak_fiber1_uniform {α β : ℕ} (hα : 0 < α) (hβ : 0 < β) {A₀ : ℝ}
    {p₀ q₀ r₀ : ℝ} (hp₀ : 1 < p₀) (hq₀ : 1 < q₀) (hr₀ : 1 / r₀ = 1 / p₀ + 1 / q₀) {A : ℝ}
    {p : ℝ} (hp : 1 ≤ p) (hpp : p ≤ p₀) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (φ ρ : ℝ → ℝ), Differentiable ℝ φ → Differentiable ℝ ρ →
      (∀ u, |φ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ)) →
      (∀ u, |deriv φ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ)) →
      (∀ u, |ρ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ)) →
      (∀ u, |deriv ρ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ)) →
      (∀ (a b : ℝ) (c : ℝ → ℂ), 0 < a → a < b → Measurable c → (∀ t, ‖c t‖ ≤ 1) →
        ∀ f₁ f₂ : ℝ × ℝ → ℂ, Measurable f₁ → Measurable f₂ → (∃ M, ∀ z, ‖f₁ z‖ ≤ M) →
        (∃ M, ∀ z, ‖f₂ z‖ ≤ M) → MemLp f₁ (ENNReal.ofReal p₀) → MemLp f₂ (ENNReal.ofReal q₀) →
        eLpNorm (modelOp α β c φ ρ a b f₁ f₂) (ENNReal.ofReal r₀) volume ≤
          ENNReal.ofReal A * eLpNorm f₁ (ENNReal.ofReal p₀) volume *
            eLpNorm f₂ (ENNReal.ofReal q₀) volume) →
      ∀ (a b : ℝ) (c : ℝ → ℂ), 0 < a → a < b → Measurable c → (∀ t, ‖c t‖ ≤ 1) →
      ∀ f₁ f₂ : ℝ × ℝ → ℂ, Measurable f₁ → Measurable f₂ → (∃ M, ∀ z, ‖f₁ z‖ ≤ M) →
      (∃ M, ∀ z, ‖f₂ z‖ ≤ M) → MemLp f₁ (ENNReal.ofReal p) → MemLp f₂ (ENNReal.ofReal q₀) →
      ∀ lam : ℝ, 0 < lam →
        volume {z | lam < ‖modelOp α β c φ ρ a b f₁ f₂ z‖} ≤
          ENNReal.ofReal (C * lam ^ (-(1 / (1 / p + 1 / q₀)))) *
            (eLpNorm f₁ (ENNReal.ofReal p) volume * eLpNorm f₂ (ENNReal.ofReal q₀) volume) ^
              (1 / (1 / p + 1 / q₀)) := by
  -- `β > 0` and the derivative bound for `ρ` are only needed for the second fiber
  have _uβ := hβ
  by_cases hA₀ : 0 ≤ A₀
  swap
  · exact ⟨0, le_rfl, fun φ _ _ _ hφ _ _ _ _ => absurd (nonneg_of_decay hφ) hA₀⟩
  obtain ⟨C, hC0, hC⟩ := core_weak (β := β) (A := A) hα hA₀ hp₀ hq₀ hr₀ hp hpp
  set r := 1 / (1 / p + 1 / q₀) with hr
  have hp0 : 0 < p := by linarith
  have hq0 : 0 < q₀ := by linarith
  have hr0 : 0 < r := by rw [hr]; positivity
  refine ⟨2 * 2 ^ r * C, by positivity, ?_⟩
  intro φ ρ hφd hρd hφ hφ' hρ _hρ' hstrong a b c ha hab hc hc1 f₁ f₂ h₁ h₂ hb₁ hb₂ hf₁ hf₂ lam
    hlam
  obtain ⟨M₁, hM₁⟩ := hb₁
  obtain ⟨M₂, hM₂⟩ := hb₂
  have hφm := hφd.continuous.measurable
  have hρm := hρd.continuous.measurable
  have hK : 0 ≤ 2 * 2 ^ r * C * lam ^ (-r) := by positivity
  refine le_of_forall_bounds hf₁.eLpNorm_ne_top hf₂.eLpNorm_ne_top hK hr0 ?_
  intro k₁ k₂ hk₁ hk₂ hn₁ hn₂
  exact weak_of_bounds hc hc1 hφm hρm (integrable_of_decay hφm hφ) (integrable_of_decay hρm hρ)
    ha (hC φ ρ hφd hρd hφ hφ' hρ hstrong a b c ha hab hc hc1) hC0 h₁ h₂ hM₁ hM₂ hk₁ hk₂ hn₁ hn₂
    hlam

/-- **Weak-type estimate via the fiber-wise Calderón-Zygmund decomposition in the first
fiber** (§4.5 of the source): from the strong bound at `(p₀, q₀, r₀)`, the truncated model operator
maps `L^p × L^{q₀} → L^{r, ∞}` for `1 ≤ p ≤ p₀`, `1/r = 1/p + 1/q₀`. -/
theorem modelOp_weak_fiber1 {α β : ℕ} (hα : 0 < α) (hβ : 0 < β) {φ ρ : ℝ → ℝ} {A₀ : ℝ}
    (hφd : Differentiable ℝ φ) (hρd : Differentiable ℝ ρ)
    (hφ : ∀ u, |φ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ))
    (hφ' : ∀ u, |deriv φ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ))
    (hρ : ∀ u, |ρ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ))
    (hρ' : ∀ u, |deriv ρ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ))
    {p₀ q₀ r₀ : ℝ} (hp₀ : 1 < p₀) (hq₀ : 1 < q₀) (hr₀ : 1 / r₀ = 1 / p₀ + 1 / q₀) {A : ℝ}
    (hstrong : ∀ (a b : ℝ) (c : ℝ → ℂ), 0 < a → a < b → Measurable c → (∀ t, ‖c t‖ ≤ 1) →
      ∀ f₁ f₂ : ℝ × ℝ → ℂ, Measurable f₁ → Measurable f₂ → (∃ M, ∀ z, ‖f₁ z‖ ≤ M) →
      (∃ M, ∀ z, ‖f₂ z‖ ≤ M) → MemLp f₁ (ENNReal.ofReal p₀) → MemLp f₂ (ENNReal.ofReal q₀) →
      eLpNorm (modelOp α β c φ ρ a b f₁ f₂) (ENNReal.ofReal r₀) volume ≤
        ENNReal.ofReal A * eLpNorm f₁ (ENNReal.ofReal p₀) volume *
          eLpNorm f₂ (ENNReal.ofReal q₀) volume)
    {p : ℝ} (hp : 1 ≤ p) (hpp : p ≤ p₀) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (a b : ℝ) (c : ℝ → ℂ), 0 < a → a < b → Measurable c → (∀ t, ‖c t‖ ≤ 1) →
      ∀ f₁ f₂ : ℝ × ℝ → ℂ, Measurable f₁ → Measurable f₂ → (∃ M, ∀ z, ‖f₁ z‖ ≤ M) →
      (∃ M, ∀ z, ‖f₂ z‖ ≤ M) → MemLp f₁ (ENNReal.ofReal p) → MemLp f₂ (ENNReal.ofReal q₀) →
      ∀ lam : ℝ, 0 < lam →
        volume {z | lam < ‖modelOp α β c φ ρ a b f₁ f₂ z‖} ≤
          ENNReal.ofReal (C * lam ^ (-(1 / (1 / p + 1 / q₀)))) *
            (eLpNorm f₁ (ENNReal.ofReal p) volume * eLpNorm f₂ (ENNReal.ofReal q₀) volume) ^
              (1 / (1 / p + 1 / q₀)) := by
  obtain ⟨C, hC0, hC⟩ := modelOp_weak_fiber1_uniform (A₀ := A₀) (A := A) hα hβ hp₀ hq₀ hr₀ hp hpp
  exact ⟨C, hC0, hC φ ρ hφd hρd hφ hφ' hρ hρ' hstrong⟩

open FiberCZ in
/-- **Weak-type estimate via the fiber-wise Calderón-Zygmund decomposition in the second
fiber**, uniform version: the constant depends only on `α, β, A₀, p₀, q₀, r₀, A, q`. This is
`modelOp_weak_fiber1_uniform` for the operator with the two coordinates exchanged
(`modelOp_swap`). -/
theorem modelOp_weak_fiber2_uniform {α β : ℕ} (hα : 0 < α) (hβ : 0 < β) {A₀ : ℝ}
    {p₀ q₀ r₀ : ℝ} (hp₀ : 1 < p₀) (hq₀ : 1 < q₀) (hr₀ : 1 / r₀ = 1 / p₀ + 1 / q₀) {A : ℝ}
    {q : ℝ} (hq : 1 ≤ q) (hqq : q ≤ q₀) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (φ ρ : ℝ → ℝ), Differentiable ℝ φ → Differentiable ℝ ρ →
      (∀ u, |φ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ)) →
      (∀ u, |deriv φ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ)) →
      (∀ u, |ρ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ)) →
      (∀ u, |deriv ρ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ)) →
      (∀ (a b : ℝ) (c : ℝ → ℂ), 0 < a → a < b → Measurable c → (∀ t, ‖c t‖ ≤ 1) →
        ∀ f₁ f₂ : ℝ × ℝ → ℂ, Measurable f₁ → Measurable f₂ → (∃ M, ∀ z, ‖f₁ z‖ ≤ M) →
        (∃ M, ∀ z, ‖f₂ z‖ ≤ M) → MemLp f₁ (ENNReal.ofReal p₀) → MemLp f₂ (ENNReal.ofReal q₀) →
        eLpNorm (modelOp α β c φ ρ a b f₁ f₂) (ENNReal.ofReal r₀) volume ≤
          ENNReal.ofReal A * eLpNorm f₁ (ENNReal.ofReal p₀) volume *
            eLpNorm f₂ (ENNReal.ofReal q₀) volume) →
      ∀ (a b : ℝ) (c : ℝ → ℂ), 0 < a → a < b → Measurable c → (∀ t, ‖c t‖ ≤ 1) →
      ∀ f₁ f₂ : ℝ × ℝ → ℂ, Measurable f₁ → Measurable f₂ → (∃ M, ∀ z, ‖f₁ z‖ ≤ M) →
      (∃ M, ∀ z, ‖f₂ z‖ ≤ M) → MemLp f₁ (ENNReal.ofReal p₀) → MemLp f₂ (ENNReal.ofReal q) →
      ∀ lam : ℝ, 0 < lam →
        volume {z | lam < ‖modelOp α β c φ ρ a b f₁ f₂ z‖} ≤
          ENNReal.ofReal (C * lam ^ (-(1 / (1 / p₀ + 1 / q)))) *
            (eLpNorm f₁ (ENNReal.ofReal p₀) volume * eLpNorm f₂ (ENNReal.ofReal q) volume) ^
              (1 / (1 / p₀ + 1 / q)) := by
  have hsw : MeasurePreserving (Prod.swap : ℝ × ℝ → ℝ × ℝ) volume volume := by
    rw [Measure.volume_eq_prod]; exact Measure.measurePreserving_swap
  have hemb : MeasurableEmbedding (Prod.swap : ℝ × ℝ → ℝ × ℝ) :=
    MeasurableEquiv.prodComm.measurableEmbedding
  have hss : ∀ f : ℝ × ℝ → ℂ, (f ∘ Prod.swap) ∘ Prod.swap = f := fun f => by
    funext z; simp
  obtain ⟨C, hC0, hC⟩ := modelOp_weak_fiber1_uniform (A₀ := A₀) (A := A) hβ hα hq₀ hp₀
    (by rw [hr₀, add_comm]) hq hqq
  refine ⟨C, hC0, ?_⟩
  intro φ ρ hφd hρd hφ hφ' hρ hρ' hstrong a b c ha hab hc hc1 f₁ f₂ h₁ h₂ hb₁ hb₂ hf₁ hf₂ lam
    hlam
  have hφm := hφd.continuous.measurable
  have hρm := hρd.continuous.measurable
  have hstrong' : ∀ (a b : ℝ) (c : ℝ → ℂ), 0 < a → a < b → Measurable c → (∀ t, ‖c t‖ ≤ 1) →
      ∀ g₁ g₂ : ℝ × ℝ → ℂ, Measurable g₁ → Measurable g₂ → (∃ M, ∀ z, ‖g₁ z‖ ≤ M) →
      (∃ M, ∀ z, ‖g₂ z‖ ≤ M) → MemLp g₁ (ENNReal.ofReal q₀) → MemLp g₂ (ENNReal.ofReal p₀) →
      eLpNorm (modelOp β α c ρ φ a b g₁ g₂) (ENNReal.ofReal r₀) volume ≤
        ENNReal.ofReal A * eLpNorm g₁ (ENNReal.ofReal q₀) volume *
          eLpNorm g₂ (ENNReal.ofReal p₀) volume := by
    intro a b c ha hab hc hc1 g₁ g₂ hg₁ hg₂ hb₁ hb₂ hm₁ hm₂
    obtain ⟨M₁, hM₁⟩ := hb₁
    obtain ⟨M₂, hM₂⟩ := hb₂
    have e : modelOp β α c ρ φ a b g₁ g₂ =
        (modelOp α β c φ ρ a b (g₂ ∘ Prod.swap) (g₁ ∘ Prod.swap)) ∘ Prod.swap := by
      funext z
      rw [Function.comp_apply, modelOp_swap α β c φ ρ a b (g₂ ∘ Prod.swap) (g₁ ∘ Prod.swap),
        hss, hss, Prod.swap_swap]
    rw [e, eLpNorm_comp_measurePreserving (stronglyMeasurable_modelOp α β hc hφm hρm a b
      (hg₂.comp measurable_swap) (hg₁.comp measurable_swap)).aestronglyMeasurable hsw]
    have h := hstrong a b c ha hab hc hc1 (g₂ ∘ Prod.swap) (g₁ ∘ Prod.swap)
      (hg₂.comp measurable_swap) (hg₁.comp measurable_swap) ⟨M₂, fun z => hM₂ _⟩
      ⟨M₁, fun z => hM₁ _⟩ (hm₂.comp_measurePreserving hsw) (hm₁.comp_measurePreserving hsw)
    rw [eLpNorm_comp_measurePreserving hg₂.aestronglyMeasurable hsw,
      eLpNorm_comp_measurePreserving hg₁.aestronglyMeasurable hsw] at h
    calc _ ≤ _ := h
      _ = _ := by ring
  obtain ⟨M₁, hM₁⟩ := hb₁
  obtain ⟨M₂, hM₂⟩ := hb₂
  have h := hC ρ φ hρd hφd hρ hρ' hφ hφ' hstrong' a b c ha hab hc hc1 (f₂ ∘ Prod.swap)
    (f₁ ∘ Prod.swap) (h₂.comp measurable_swap) (h₁.comp measurable_swap) ⟨M₂, fun z => hM₂ _⟩
    ⟨M₁, fun z => hM₁ _⟩ (hf₂.comp_measurePreserving hsw) (hf₁.comp_measurePreserving hsw) lam
    hlam
  have hset : {z | lam < ‖modelOp α β c φ ρ a b f₁ f₂ z‖} = Prod.swap ⁻¹'
      {w | lam < ‖modelOp β α c ρ φ a b (f₂ ∘ Prod.swap) (f₁ ∘ Prod.swap) w‖} := by
    ext z
    simp only [mem_setOf_eq, mem_preimage]
    rw [modelOp_swap]
  rw [hset, hsw.measure_preimage_emb hemb]
  rw [eLpNorm_comp_measurePreserving h₂.aestronglyMeasurable hsw,
    eLpNorm_comp_measurePreserving h₁.aestronglyMeasurable hsw, add_comm (1 / q),
    mul_comm (eLpNorm f₂ _ _)] at h
  exact h

/-- **Weak-type estimate via the fiber-wise Calderón-Zygmund decomposition in the second
fiber**: from the strong bound at `(p₀, q₀, r₀)`, the truncated model operator maps
`L^{p₀} × L^q → L^{r, ∞}` for `1 ≤ q ≤ q₀`, `1/r = 1/p₀ + 1/q`. -/
theorem modelOp_weak_fiber2 {α β : ℕ} (hα : 0 < α) (hβ : 0 < β) {φ ρ : ℝ → ℝ} {A₀ : ℝ}
    (hφd : Differentiable ℝ φ) (hρd : Differentiable ℝ ρ)
    (hφ : ∀ u, |φ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ))
    (hφ' : ∀ u, |deriv φ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ))
    (hρ : ∀ u, |ρ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ))
    (hρ' : ∀ u, |deriv ρ u| ≤ A₀ * (1 + |u|) ^ (-12 : ℝ))
    {p₀ q₀ r₀ : ℝ} (hp₀ : 1 < p₀) (hq₀ : 1 < q₀) (hr₀ : 1 / r₀ = 1 / p₀ + 1 / q₀) {A : ℝ}
    (hstrong : ∀ (a b : ℝ) (c : ℝ → ℂ), 0 < a → a < b → Measurable c → (∀ t, ‖c t‖ ≤ 1) →
      ∀ f₁ f₂ : ℝ × ℝ → ℂ, Measurable f₁ → Measurable f₂ → (∃ M, ∀ z, ‖f₁ z‖ ≤ M) →
      (∃ M, ∀ z, ‖f₂ z‖ ≤ M) → MemLp f₁ (ENNReal.ofReal p₀) → MemLp f₂ (ENNReal.ofReal q₀) →
      eLpNorm (modelOp α β c φ ρ a b f₁ f₂) (ENNReal.ofReal r₀) volume ≤
        ENNReal.ofReal A * eLpNorm f₁ (ENNReal.ofReal p₀) volume *
          eLpNorm f₂ (ENNReal.ofReal q₀) volume)
    {q : ℝ} (hq : 1 ≤ q) (hqq : q ≤ q₀) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (a b : ℝ) (c : ℝ → ℂ), 0 < a → a < b → Measurable c → (∀ t, ‖c t‖ ≤ 1) →
      ∀ f₁ f₂ : ℝ × ℝ → ℂ, Measurable f₁ → Measurable f₂ → (∃ M, ∀ z, ‖f₁ z‖ ≤ M) →
      (∃ M, ∀ z, ‖f₂ z‖ ≤ M) → MemLp f₁ (ENNReal.ofReal p₀) → MemLp f₂ (ENNReal.ofReal q) →
      ∀ lam : ℝ, 0 < lam →
        volume {z | lam < ‖modelOp α β c φ ρ a b f₁ f₂ z‖} ≤
          ENNReal.ofReal (C * lam ^ (-(1 / (1 / p₀ + 1 / q)))) *
            (eLpNorm f₁ (ENNReal.ofReal p₀) volume * eLpNorm f₂ (ENNReal.ofReal q) volume) ^
              (1 / (1 / p₀ + 1 / q)) := by
  obtain ⟨C, hC0, hC⟩ := modelOp_weak_fiber2_uniform (A₀ := A₀) (A := A) hα hβ hp₀ hq₀ hr₀ hq hqq
  exact ⟨C, hC0, hC φ ρ hφd hρd hφ hφ' hρ hρ' hstrong⟩

