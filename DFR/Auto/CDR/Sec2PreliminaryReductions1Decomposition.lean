      if m ≤ 0 then monoPsiA (a / 2 ^ m) else 0) m = 0 := fun m hm => by
    simp only [if_pos hm, sub_self]
  have h2 := (hasSum_int_iff_nat_succ hf).2 h
  convert h2 using 2 with k
  rw [if_neg (by omega), sub_zero, two_zpow_natCast_add_one]

theorem sub_div_zpow_eq_mul (b : ℝ) (k : ℕ) :
    b / 2 ^ (((k : ℤ) + 1) - 101) = b * (2 : ℝ) ^ ((100 : ℤ) - k) := by
  rw [div_eq_mul_inv, ← zpow_neg]
  congr 2
  ring

/-- The first mixed region: `∑_{k₁ ≥ 1, k₂ ≤ k₁ - 101} u_{k₁} v_{k₂} =
∑_{k ≥ 0} u_{k+1} V_{k-100}` when `∑_{m ≤ n} v_m = V_n`. -/
theorem hasSum_mixed_region {u v : ℤ → ℝ} {V : ℤ → ℝ}
    (hv : ∀ n, HasSum (fun m : ℤ => if m ≤ n then v m else 0) (V n))
    (hs : Summable ({k : ℤ × ℤ | 0 < k.1 ∧ k.2 ≤ k.1 - 101}.indicator
      (fun k => u k.1 * v k.2))) :
    HasSum (fun k : ℕ => u ((k : ℤ) + 1) * V (((k : ℤ) + 1) - 101))
      (∑' k : ℤ × ℤ, {k : ℤ × ℤ | 0 < k.1 ∧ k.2 ≤ k.1 - 101}.indicator
        (fun k => u k.1 * v k.2) k) := by
  have hfib := hs.hasSum.prod_fiberwise (g := fun k₁ : ℤ =>
    if 0 < k₁ then u k₁ * V (k₁ - 101) else 0) (fun k₁ => by
      by_cases h : 0 < k₁
      · rw [if_pos h]
        refine (congrArg (fun F : ℤ → ℝ => HasSum F (u k₁ * V (k₁ - 101)))
          (funext fun k₂ => ?_)).mpr ((hv (k₁ - 101)).mul_left (u k₁))
        simp only [Set.indicator, Set.mem_setOf_eq]
        split_ifs <;> first | rfl | (exfalso; omega) | simp
      · rw [if_neg h]
        refine (congrArg (fun F : ℤ → ℝ => HasSum F 0)
          (funext fun k₂ => ?_)).mpr hasSum_zero
        simp only [Set.indicator, Set.mem_setOf_eq]
        rw [if_neg (by omega)])
  have hf : ∀ m : ℤ, m ≤ 0 → (fun k₁ : ℤ => if 0 < k₁ then u k₁ * V (k₁ - 101) else 0) m = 0 :=
    fun m hm => by simp only; rw [if_neg (by omega)]
  have h2 := (hasSum_int_iff_nat_succ hf).2 hfib
  convert h2 using 2 with k
  rw [if_pos (by omega)]

/-- The pointwise partition of `ℤ²` into the regions `𝔉_L`, `𝔉_M` (two parts), `𝔉_H`. -/
theorem indicator_partition (f : ℤ × ℤ → ℝ) (k : ℤ × ℤ) :
    f k = {k : ℤ × ℤ | k.1 ≤ 0 ∧ k.2 ≤ 0}.indicator f k +
      {k : ℤ × ℤ | 0 < k.1 ∧ k.2 ≤ k.1 - 101}.indicator f k +
      {k : ℤ × ℤ | 0 < k.2 ∧ k.1 ≤ k.2 - 101}.indicator f k +
      {k : ℤ × ℤ | 0 < max k.1 k.2 ∧ |k.1 - k.2| ≤ 100}.indicator f k := by
  simp only [Set.indicator, Set.mem_setOf_eq]
  split_ifs <;> (try simp only [lt_max_iff, abs_le, not_and_or, not_or, not_le, not_lt] at *) <;>
    first | omega | simp

theorem summable_indicator_of_nonneg {f : ℤ × ℤ → ℝ} (hf0 : ∀ k, 0 ≤ f k) (hf : Summable f)
    (s : Set (ℤ × ℤ)) : Summable (s.indicator f) :=
  Summable.of_nonneg_of_le (fun k => Set.indicator_nonneg (fun k _ => hf0 k) k)
    (fun k => Set.indicator_le_self' (fun k _ => hf0 k) k) hf

-- The index set `𝔉_H = {k ∈ ℤ² : max(k₁,k₂) > 0, |k₁ - k₂| ≤ 100}` (`eqn:basic-freq-dec`).
set_option quotPrecheck false in
local notation "𝔉H" => {k : ℤ × ℤ // 0 < max k.1 k.2 ∧ |k.1 - k.2| ≤ 100}

theorem summable_monoPsiA_norm {a : ℝ} (ha : a ≠ 0) :
    Summable fun m : ℤ => ‖monoPsiA (a / 2 ^ m)‖ := by
  simpa only [Real.norm_eq_abs] using (hasSum_monoPsiA ha).summable.abs

/-- **The partition of unity** behind `eqn:basicfreqdecomp`, for `a, b ≠ 0`. -/
theorem partition_unity_of_ne {a b : ℝ} (ha : a ≠ 0) (hb : b ≠ 0) :
    monoPhi a * monoPhi b +
      ∑' k : ℕ, monoPsiA (a / 2 ^ (k + 1)) * monoPhi (b * (2 : ℝ) ^ ((100 : ℤ) - k)) +
      ∑' k : ℕ, monoPhi (a * (2 : ℝ) ^ ((100 : ℤ) - k)) * monoPsiA (b / 2 ^ (k + 1)) +
      ∑' k : 𝔉H, monoPsiA (a / 2 ^ k.1.1) * monoPsiA (b / 2 ^ k.1.2) = 1 := by
  have f0 : ∀ k : ℤ × ℤ, 0 ≤ monoPsiA (a / 2 ^ k.1) * monoPsiA (b / 2 ^ k.2) :=
    fun k => mul_nonneg (monoPsiA_nonneg _) (monoPsiA_nonneg _)
  have hprod : HasSum (fun k : ℤ × ℤ => monoPsiA (a / 2 ^ k.1) * monoPsiA (b / 2 ^ k.2)) 1 := by
    have hs : Summable fun k : ℤ × ℤ => monoPsiA (a / 2 ^ k.1) * monoPsiA (b / 2 ^ k.2) :=
      summable_mul_of_summable_norm (f := fun m : ℤ => monoPsiA (a / 2 ^ m))
        (g := fun m : ℤ => monoPsiA (b / 2 ^ m)) (summable_monoPsiA_norm ha)
        (summable_monoPsiA_norm hb)
    have h := (hasSum_monoPsiA ha).mul (hasSum_monoPsiA hb) hs
    rw [one_mul] at h
    exact h
  have hs := fun s => summable_indicator_of_nonneg f0 hprod.summable s
  -- the low region
  have eL : (fun k : ℤ × ℤ => (if k.1 ≤ 0 then monoPsiA (a / 2 ^ k.1) else 0) *
      (if k.2 ≤ 0 then monoPsiA (b / 2 ^ k.2) else 0)) =
      {k : ℤ × ℤ | k.1 ≤ 0 ∧ k.2 ≤ 0}.indicator
        (fun k => monoPsiA (a / 2 ^ k.1) * monoPsiA (b / 2 ^ k.2)) := by
    funext k
    simp only [Set.indicator, Set.mem_setOf_eq]
    split_ifs <;> first | rfl | (exfalso; tauto) | simp
  have hL := (hasSum_monoPsiA_le ha 0).mul (hasSum_monoPsiA_le hb 0) (by rw [eL]; exact hs _)
  rw [eL, zpow_zero, div_one, div_one] at hL
  -- the first mixed region
  have hI := hasSum_mixed_region (u := fun m => monoPsiA (a / 2 ^ m))
    (hasSum_monoPsiA_le hb) (hs {k : ℤ × ℤ | 0 < k.1 ∧ k.2 ≤ k.1 - 101})
  simp only [two_zpow_natCast_add_one, sub_div_zpow_eq_mul] at hI
  -- the second mixed region, by exchanging the coordinates
  have hI' := hasSum_mixed_region (u := fun m => monoPsiA (b / 2 ^ m))
    (hasSum_monoPsiA_le ha) (summable_indicator_of_nonneg
      (fun k => mul_nonneg (monoPsiA_nonneg _) (monoPsiA_nonneg _))
      ((Equiv.prodComm ℤ ℤ).summable_iff.2 hprod.summable |>.congr fun k => mul_comm _ _)
      {k : ℤ × ℤ | 0 < k.1 ∧ k.2 ≤ k.1 - 101})
  simp only [two_zpow_natCast_add_one, sub_div_zpow_eq_mul] at hI'
  have eII : ∑' k : ℤ × ℤ, {k : ℤ × ℤ | 0 < k.1 ∧ k.2 ≤ k.1 - 101}.indicator
      (fun k => monoPsiA (b / 2 ^ k.1) * monoPsiA (a / 2 ^ k.2)) k =
      ∑' k : ℤ × ℤ, {k : ℤ × ℤ | 0 < k.2 ∧ k.1 ≤ k.2 - 101}.indicator
      (fun k => monoPsiA (a / 2 ^ k.1) * monoPsiA (b / 2 ^ k.2)) k := by
    rw [← (Equiv.prodComm ℤ ℤ).tsum_eq]
    refine tsum_congr fun k => ?_
    by_cases h : 0 < k.2 ∧ k.1 ≤ k.2 - 101
    · rw [Set.indicator_of_mem (show (Equiv.prodComm ℤ ℤ) k ∈
        {k : ℤ × ℤ | 0 < k.1 ∧ k.2 ≤ k.1 - 101} from h), Set.indicator_of_mem
        (show k ∈ {k : ℤ × ℤ | 0 < k.2 ∧ k.1 ≤ k.2 - 101} from h)]
      exact mul_comm _ _
    · rw [Set.indicator_of_notMem (show (Equiv.prodComm ℤ ℤ) k ∉
        {k : ℤ × ℤ | 0 < k.1 ∧ k.2 ≤ k.1 - 101} from h), Set.indicator_of_notMem
        (show k ∉ {k : ℤ × ℤ | 0 < k.2 ∧ k.1 ≤ k.2 - 101} from h)]
  rw [eII] at hI'
  have hH : (∑' k : 𝔉H, monoPsiA (a / 2 ^ k.1.1) * monoPsiA (b / 2 ^ k.1.2)) =
      ∑' k : ℤ × ℤ, {k : ℤ × ℤ | 0 < max k.1 k.2 ∧ |k.1 - k.2| ≤ 100}.indicator
        (fun k => monoPsiA (a / 2 ^ k.1) * monoPsiA (b / 2 ^ k.2)) k :=
    tsum_subtype {k : ℤ × ℤ | 0 < max k.1 k.2 ∧ |k.1 - k.2| ≤ 100}
      (fun k => monoPsiA (a / 2 ^ k.1) * monoPsiA (b / 2 ^ k.2))
  have htot := hprod.tsum_eq
  rw [show (fun k : ℤ × ℤ => monoPsiA (a / 2 ^ k.1) * monoPsiA (b / 2 ^ k.2)) = _ from
    funext (indicator_partition _), Summable.tsum_add ((hs _).add (hs _) |>.add (hs _)) (hs _),
    Summable.tsum_add ((hs _).add (hs _)) (hs _), Summable.tsum_add (hs _) (hs _),
    hL.tsum_eq] at htot
  rw [hI.tsum_eq, hH, ← htot]
  congr 2
  rw [← hI'.tsum_eq]
  exact tsum_congr fun k => mul_comm _ _

theorem monoPsiA_zero : monoPsiA 0 = 0 := monoPsiA_eq_zero_of_abs_le (by norm_num)

theorem monoPhi_zero : monoPhi 0 = 1 := monoPhi_eq_one (by norm_num)

/-- **The partition of unity** behind `eqn:basicfreqdecomp`:
`φ(a)φ(b) + ∑_{k≥0} ψ(a/2^{k+1})φ(b 2^{100-k}) + ∑_{k≥0} φ(a 2^{100-k})ψ(b/2^{k+1}) +
∑_{k ∈ 𝔉_H} ψ(a/2^{k₁})ψ(b/2^{k₂}) = 1` for all `a, b`. -/
theorem partition_unity (a b : ℝ) :
    monoPhi a * monoPhi b +
      ∑' k : ℕ, monoPsiA (a / 2 ^ (k + 1)) * monoPhi (b * (2 : ℝ) ^ ((100 : ℤ) - k)) +
      ∑' k : ℕ, monoPhi (a * (2 : ℝ) ^ ((100 : ℤ) - k)) * monoPsiA (b / 2 ^ (k + 1)) +
      ∑' k : 𝔉H, monoPsiA (a / 2 ^ k.1.1) * monoPsiA (b / 2 ^ k.1.2) = 1 := by
  rcases eq_or_ne a 0 with rfl | ha
  · simp only [zero_div, zero_mul, monoPsiA_zero, monoPhi_zero, one_mul, tsum_zero, add_zero]
    rw [(hasSum_monoPsiA_succ b).tsum_eq]
    ring
  rcases eq_or_ne b 0 with rfl | hb
  · simp only [zero_div, zero_mul, monoPsiA_zero, monoPhi_zero, mul_one, mul_zero, tsum_zero,
      add_zero]
    rw [(hasSum_monoPsiA_succ a).tsum_eq]
    ring
  exact partition_unity_of_ne ha hb

/-- `∑_{k ∈ s} ψ(a/2^{k₁}) ψ(b/2^{k₂}) ≤ 1` for every finite `s ⊆ ℤ²`. -/
theorem sum_psi_psi_le_one (s : Finset (ℤ × ℤ)) (a b : ℝ) :
    ∑ k ∈ s, monoPsiA (a / 2 ^ k.1) * monoPsiA (b / 2 ^ k.2) ≤ 1 := by
  calc ∑ k ∈ s, monoPsiA (a / 2 ^ k.1) * monoPsiA (b / 2 ^ k.2)
      ≤ ∑ k ∈ s.image Prod.fst ×ˢ s.image Prod.snd,
          monoPsiA (a / 2 ^ k.1) * monoPsiA (b / 2 ^ k.2) :=
        Finset.sum_le_sum_of_subset_of_nonneg (fun k hk => Finset.mem_product.2
          ⟨Finset.mem_image_of_mem _ hk, Finset.mem_image_of_mem _ hk⟩)
          (fun _ _ _ => mul_nonneg (monoPsiA_nonneg _) (monoPsiA_nonneg _))
    _ = (∑ m ∈ s.image Prod.fst, monoPsiA (a / 2 ^ m)) *
          ∑ n ∈ s.image Prod.snd, monoPsiA (b / 2 ^ n) := by
        rw [Finset.sum_mul_sum, Finset.sum_product]
    _ ≤ 1 * 1 := mul_le_mul (sum_monoPsiA_le_one _ _) (sum_monoPsiA_le_one _ _)
          (Finset.sum_nonneg fun _ _ => monoPsiA_nonneg _) zero_le_one
    _ = 1 := one_mul 1

theorem sum_highIdx_le_one (u : Finset 𝔉H) (a b : ℝ) :
    ∑ k ∈ u, monoPsiA (a / 2 ^ k.1.1) * monoPsiA (b / 2 ^ k.1.2) ≤ 1 := by
  have h := sum_psi_psi_le_one (u.map (Function.Embedding.subtype _)) a b
  rwa [Finset.sum_map] at h

theorem summable_highIdx (a b : ℝ) :
    Summable fun k : 𝔉H => monoPsiA (a / 2 ^ k.1.1) * monoPsiA (b / 2 ^ k.1.2) :=
  summable_of_sum_le (fun _ => mul_nonneg (monoPsiA_nonneg _) (monoPsiA_nonneg _))
    fun u => sum_highIdx_le_one u a b

/-! ### The oscillatory integral `ϑ` -/

theorem continuous_tjBump : Continuous tjBump := tauB_contDiff.continuous

theorem integrable_tjBump : Integrable tjBump :=
  tauB_contDiff.continuous.integrable_of_hasCompactSupport tauB_hasCompactSupport

theorem norm_exp_two_pi_I_mul (r : ℝ) : ‖Complex.exp (2 * π * Complex.I * r)‖ = 1 := by
  rw [show (2 * π * Complex.I * r : ℂ) = ((2 * π * r : ℝ) : ℂ) * Complex.I by push_cast; ring]
  exact Complex.norm_exp_ofReal_mul_I _

/-- The integrand of `ϑ = oscInt tjBump`, with a single real phase. -/
def oscIntegrand (ξ η u : ℝ) : ℂ :=
  ((tjBump u : ℝ) : ℂ) * Complex.exp (2 * π * Complex.I * ((u * ξ + u ^ 2 * η : ℝ) : ℂ))

theorem oscInt_eq_integral (ξ η : ℝ) : oscInt tjBump ξ η = ∫ u, oscIntegrand ξ η u := by
  unfold oscInt oscIntegrand
  push_cast
  rfl

/-- `C_ϑ = ∫ |ψ(u)/u| du`, a bound for `|ϑ|`. -/
def oscBound : ℝ := ∫ t, |tjBump t|

theorem norm_oscInt_le (ξ η : ℝ) : ‖oscInt tjBump ξ η‖ ≤ oscBound := by
  rw [oscInt_eq_integral]
  refine (norm_integral_le_integral_norm _).trans
    (le_of_eq (integral_congr_ae (Eventually.of_forall fun t => ?_)))
  simp only [oscIntegrand]
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, norm_exp_two_pi_I_mul, mul_one]

theorem oscBound_nonneg : 0 ≤ oscBound := integral_nonneg fun _ => abs_nonneg _

theorem continuous_oscInt : Continuous fun w : ℝ × ℝ => oscInt tjBump w.1 w.2 := by
  simp_rw [oscInt_eq_integral]
  have hc := continuous_tjBump
  refine continuous_of_dominated (bound := fun t => |tjBump t|)
    (fun w => (Continuous.aestronglyMeasurable (by unfold oscIntegrand; fun_prop)))
    (fun w => Eventually.of_forall fun t => ?_) integrable_tjBump.abs
    (Eventually.of_forall fun t => by unfold oscIntegrand; fun_prop)
  simp only [oscIntegrand]
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, norm_exp_two_pi_I_mul, mul_one]

theorem continuous_oscInt_comp {X : Type*} [TopologicalSpace X] {f g : X → ℝ}
    (hf : Continuous f) (hg : Continuous g) : Continuous fun x => oscInt tjBump (f x) (g x) :=
  continuous_oscInt.comp (hf.prodMk hg)

/-! ### Fourier representation of `T_j` -/

theorem fourierInv_eq_integral (F : ℝ → ℂ) (x : ℝ) :
    𝓕⁻ F x = ∫ ξ, F ξ * Complex.exp (2 * π * Complex.I * (x * ξ)) := by
  rw [Real.fourierInv_eq']
  refine integral_congr_ae (Eventually.of_forall fun ξ => ?_)
  simp only [smul_eq_mul, RCLike.inner_apply, conj_trivial]
  rw [mul_comm]
  congr 1
  push_cast
  ring_nf

theorem integrable_bdd_mul_of {α : Type*} [MeasurableSpace α] {μ : Measure α} {f g : α → ℂ}
    (hf : Integrable f μ) (hg : AEStronglyMeasurable g μ) {C : ℝ} (hC : ∀ x, ‖g x‖ ≤ C) :
    Integrable (fun x => g x * f x) μ := by
  have h := hf.mul_bdd hg (Eventually.of_forall hC)
  simpa only [mul_comm] using h

/-- **Fubini for `T_j` on the frequency side**: if `u₁ = ∫ F₁ e^{2πi·ξ}`,
`u₂ = ∫ F₂ e^{2πi·η}` with `F₁, F₂, w` integrable, then
`∫ u₁(x+t) u₂(y+t²) w(t) dt = ∫∫ (∫ w(t) e^{2πi(tξ+t²η)} dt) F₁(ξ) F₂(η) e^{2πi(xξ+yη)}`. -/
theorem integral_fourier_repr {w : ℝ → ℂ} (hw : Integrable w) {F₁ F₂ : ℝ → ℂ}
    (hF₁ : Integrable F₁) (hF₂ : Integrable F₂) {u₁ u₂ : ℝ → ℂ}
    (hu₁ : ∀ s, u₁ s = ∫ ξ, F₁ ξ * Complex.exp (2 * π * Complex.I * (s * ξ)))
    (hu₂ : ∀ s, u₂ s = ∫ η, F₂ η * Complex.exp (2 * π * Complex.I * (s * η))) (x y : ℝ) :
    ∫ t, u₁ (x + t) * u₂ (y + t ^ 2) * w t =
      ∫ p : ℝ × ℝ, (∫ t, w t * Complex.exp (2 * π * Complex.I * (t * p.1 + t ^ 2 * p.2))) *
        F₁ p.1 * F₂ p.2 * Complex.exp (2 * π * Complex.I * (x * p.1 + y * p.2)) := by
  have hE : ∀ (t : ℝ) (p : ℝ × ℝ),
      Complex.exp (2 * π * Complex.I * (((x + t : ℝ) : ℂ) * p.1)) *
        Complex.exp (2 * π * Complex.I * (((y + t ^ 2 : ℝ) : ℂ) * p.2)) =
      Complex.exp (2 * π * Complex.I * (t * p.1 + t ^ 2 * p.2)) *
        Complex.exp (2 * π * Complex.I * (x * p.1 + y * p.2)) := by
    intro t p
    rw [← Complex.exp_add, ← Complex.exp_add]
    congr 1
    push_cast
    ring
  -- step 1: the product of the two inversion integrals as one integral over `ℝ²`
  have h1 : ∀ t : ℝ, u₁ (x + t) * u₂ (y + t ^ 2) * w t = ∫ p : ℝ × ℝ,
      w t * (F₁ p.1 * F₂ p.2) * (Complex.exp (2 * π * Complex.I * (t * p.1 + t ^ 2 * p.2)) *
        Complex.exp (2 * π * Complex.I * (x * p.1 + y * p.2))) := by
    intro t
    rw [hu₁, hu₂, Measure.volume_eq_prod, ← integral_prod_mul, ← integral_mul_const]
    refine integral_congr_ae (Eventually.of_forall fun p => ?_)
    simp only
    rw [← hE]
    ring
  rw [integral_congr_ae (Eventually.of_forall h1)]
  -- step 2: Fubini
  have hint : Integrable (Function.uncurry fun (t : ℝ) (p : ℝ × ℝ) =>
      w t * (F₁ p.1 * F₂ p.2) * (Complex.exp (2 * π * Complex.I * (t * p.1 + t ^ 2 * p.2)) *
        Complex.exp (2 * π * Complex.I * (x * p.1 + y * p.2)))) (volume.prod volume) := by
    refine (hw.mul_prod (hF₁.mul_prod hF₂)).mul_bdd (c := 1)
      (Continuous.aestronglyMeasurable (by fun_prop)) (Eventually.of_forall fun q => ?_)
    rw [norm_mul]
    have h1 := norm_exp_two_pi_I_mul (q.1 * q.2.1 + q.1 ^ 2 * q.2.2)
    have h2 := norm_exp_two_pi_I_mul (x * q.2.1 + y * q.2.2)
    push_cast at h1 h2
    rw [h1, h2, mul_one]
  rw [integral_integral_swap hint]
  -- step 3: the inner `t`-integral
  refine integral_congr_ae (Eventually.of_forall fun p => ?_)
  simp only
  rw [← integral_mul_const, ← integral_mul_const, ← integral_mul_const]
  refine integral_congr_ae (Eventually.of_forall fun t => ?_)
  simp only
  ring

theorem dilB_tauB_eq (j : ℤ) (t : ℝ) : dilB tauB j t = monoPsiA ((2 : ℝ) ^ j * t) / t := by
  rw [dilB, tauB, mul_div_assoc', mul_div_mul_left _ _ (by positivity : (2 : ℝ) ^ j ≠ 0)]

/-- The substitution `t = 2^{-j} u`:
`∫ ψ(2^j t) t^{-1} e^{2πi(tξ+t²η)} dt = ϑ(2^{-j} ξ, 4^{-j} η)`. -/
theorem integral_dil_osc (j : ℤ) (ξ η : ℝ) :
    ∫ t, ((monoPsiA ((2 : ℝ) ^ j * t) / t : ℝ) : ℂ) *
        Complex.exp (2 * π * Complex.I * (t * ξ + t ^ 2 * η)) =
      oscInt tjBump (ξ / 2 ^ j) (η / 4 ^ j) := by
  have hc : (0 : ℝ) < 2 ^ j := by positivity
  have h4 : (4 : ℝ) ^ j = 2 ^ j * 2 ^ j := by rw [← mul_zpow]; norm_num
  have e : ∀ t : ℝ, ((monoPsiA ((2 : ℝ) ^ j * t) / t : ℝ) : ℂ) *
      Complex.exp (2 * π * Complex.I * (t * ξ + t ^ 2 * η)) =
      (((2 : ℝ) ^ j : ℝ) : ℂ) * oscIntegrand (ξ / 2 ^ j) (η / 4 ^ j) ((2 : ℝ) ^ j * t) := by
    intro t
    have key : t * ξ + t ^ 2 * η =
        (2 ^ j * t) * (ξ / 2 ^ j) + (2 ^ j * t) ^ 2 * (η / 4 ^ j) := by
      rw [h4]; field_simp
    have e1 : monoPsiA ((2 : ℝ) ^ j * t) / t = 2 ^ j * tjBump (2 ^ j * t) :=
      (dilB_tauB_eq j t).symm
    unfold oscIntegrand
    rw [e1, ← key]
    push_cast
    ring
  rw [integral_congr_ae (Eventually.of_forall e), integral_const_mul,
    Measure.integral_comp_mul_left (oscIntegrand (ξ / 2 ^ j) (η / 4 ^ j)), abs_inv,
    abs_of_pos hc, Complex.real_smul, ← mul_assoc, ← Complex.ofReal_mul,
    mul_inv_cancel₀ hc.ne', Complex.ofReal_one, one_mul, oscInt_eq_integral]

theorem integrable_Tj_weight (j : ℤ) :
    Integrable fun t : ℝ => ((monoPsiA ((2 : ℝ) ^ j * t) / t : ℝ) : ℂ) :=
  (integrable_dilB_tauB j).ofReal.congr (Eventually.of_forall fun t => by
    beta_reduce; rw [dilB_tauB_eq]; rfl)

/-- `T_j` on the frequency side, for inputs whose relevant fibers are inverse Fourier
integrals of integrable `F₁, F₂`. -/
theorem Tj_eq_integral_of_repr (j : ℤ) {g₁ g₂ : ℝ × ℝ → ℂ} {F₁ F₂ : ℝ → ℂ}
    (hF₁ : Integrable F₁) (hF₂ : Integrable F₂) (z : ℝ × ℝ)
    (hg₁ : ∀ s, g₁ (s, z.2) = ∫ ξ, F₁ ξ * Complex.exp (2 * π * Complex.I * (s * ξ)))
    (hg₂ : ∀ s, g₂ (z.1, s) = ∫ η, F₂ η * Complex.exp (2 * π * Complex.I * (s * η))) :
    Tj j g₁ g₂ z = ∫ p : ℝ × ℝ, oscInt tjBump (p.1 / 2 ^ j) (p.2 / 4 ^ j) * F₁ p.1 * F₂ p.2 *
      Complex.exp (2 * π * Complex.I * (z.1 * p.1 + z.2 * p.2)) := by
  rw [Tj_apply]
  refine (integral_fourier_repr (u₁ := fun s => g₁ (s, z.2)) (u₂ := fun s => g₂ (z.1, s))
    (integrable_Tj_weight j) hF₁ hF₂ hg₁ hg₂ z.1 z.2).trans
    (integral_congr_ae (Eventually.of_forall fun p => ?_))
  beta_reduce
  rw [integral_dil_osc]

/-! ### `T_m` as an integral over `ℝ²` -/

/-- The factor `𝓕₁f₁(ξ, z₂) 𝓕₂f₂(z₁, η) e^{2πi(z₁ξ + z₂η)}` of `T_m`. -/
def tmPhase (f₁ f₂ : ℝ × ℝ → ℂ) (z p : ℝ × ℝ) : ℂ :=
  𝓕 (fun x => f₁ (x, z.2)) p.1 * 𝓕 (fun y => f₂ (z.1, y)) p.2 *
    Complex.exp (2 * π * Complex.I * (z.1 * p.1 + z.2 * p.2))

theorem integrable_tmPhase {f₁ f₂ : ℝ × ℝ → ℂ} {z : ℝ × ℝ}
    (h₁ : Integrable (𝓕 fun x => f₁ (x, z.2))) (h₂ : Integrable (𝓕 fun y => f₂ (z.1, y))) :
    Integrable (tmPhase f₁ f₂ z) := by
  refine (h₁.mul_prod h₂).mul_bdd (c := 1) (Continuous.aestronglyMeasurable (by fun_prop))
    (Eventually.of_forall fun p => ?_)
  have h := norm_exp_two_pi_I_mul (z.1 * p.1 + z.2 * p.2)
  push_cast at h
  rw [h]

theorem integrable_mul_tmPhase {f₁ f₂ : ℝ × ℝ → ℂ} {z : ℝ × ℝ}
    (hΦ : Integrable (tmPhase f₁ f₂ z)) {m : ℝ × ℝ → ℂ} (hm : Measurable m) {C : ℝ}
    (hC : ∀ w, ‖m w‖ ≤ C) : Integrable fun p => m p * tmPhase f₁ f₂ z p :=
  integrable_bdd_mul_of hΦ hm.aestronglyMeasurable hC

theorem measurable_neg_pair : Measurable fun p : ℝ × ℝ => (-p.1, -p.2) :=
  measurable_fst.neg.prodMk measurable_snd.neg

/-- `T_m(f₁,f₂)(z) = ∫_{ℝ²} m(-p) 𝓕₁f₁ 𝓕₂f₂ e^{2πi⟨z,p⟩} dp` for bounded measurable `m`. -/
theorem Tm_eq_integral {m : ℝ × ℝ → ℂ} (hm : Measurable m) {C : ℝ} (hC : ∀ w, ‖m w‖ ≤ C)
    {f₁ f₂ : ℝ × ℝ → ℂ} {z : ℝ × ℝ} (hΦ : Integrable (tmPhase f₁ f₂ z)) :
    Tm m f₁ f₂ z = ∫ p, m (-p.1, -p.2) * tmPhase f₁ f₂ z p := by
  have hint : Integrable fun p : ℝ × ℝ => m (-p.1, -p.2) * tmPhase f₁ f₂ z p :=
    integrable_mul_tmPhase hΦ (hm.comp measurable_neg_pair) (fun w => hC _)
  rw [Measure.volume_eq_prod] at hint ⊢
  rw [integral_prod _ hint]
  unfold Tm tmPhase
  refine integral_congr_ae (Eventually.of_forall fun ξ =>
    integral_congr_ae (Eventually.of_forall fun η => ?_))
  simp only
  ring

/-! ### Fiber multipliers -/

theorem monoFib_zero_eq (f : ℝ × ℝ → ℂ) (p : ℝ) : monoFib 0 f p = fun x => f (x, p) := by
  funext x; simp [monoFib, monoPt]

theorem monoFib_one_eq (f : ℝ × ℝ → ℂ) (p : ℝ) : monoFib 1 f p = fun y => f (p, y) := by
  funext y; simp [monoFib, monoPt]

theorem integrable_fourier_monoFib (ℓ : Fin 2) {f : ℝ × ℝ → ℂ} (hs : ContDiff ℝ ∞ f)
    (hc : HasCompactSupport f) (p : ℝ) : Integrable (𝓕 (monoFib ℓ f p)) := by
  have h := (𝓕 ((hasCompactSupport_monoFib ℓ hc p).toSchwartzMap
    (contDiff_monoFib ℓ hs p))).integrable (μ := volume)
  rw [SchwartzMap.fourier_coe] at h
  exact h

theorem integrable_monoFib (ℓ : Fin 2) {f : ℝ × ℝ → ℂ} (hs : ContDiff ℝ ∞ f)
    (hc : HasCompactSupport f) (p : ℝ) : Integrable (monoFib ℓ f p) :=
  (contDiff_monoFib ℓ hs p).continuous.integrable_of_hasCompactSupport
    (hasCompactSupport_monoFib ℓ hc p)

theorem integrable_tmPhase_of_test {f₁ f₂ : ℝ × ℝ → ℂ} (hs₁ : ContDiff ℝ ∞ f₁)
    (hc₁ : HasCompactSupport f₁) (hs₂ : ContDiff ℝ ∞ f₂) (hc₂ : HasCompactSupport f₂)
    (z : ℝ × ℝ) : Integrable (tmPhase f₁ f₂ z) := by
  have h₁ := integrable_fourier_monoFib 0 hs₁ hc₁ z.2
  have h₂ := integrable_fourier_monoFib 1 hs₂ hc₂ z.1
  rw [monoFib_zero_eq] at h₁
  rw [monoFib_one_eq] at h₂
  exact integrable_tmPhase h₁ h₂

/-- `P` acts on the `ℓ`-fibers of test functions as the Fourier multiplier `a`
(bounded, measurable): `(P f)(·, p) = 𝓕⁻¹(a · 𝓕 f(·, p))`. -/
def FibMult (ℓ : Fin 2) (P : (ℝ × ℝ → ℂ) → ℝ × ℝ → ℂ) (a : ℝ → ℂ) : Prop :=
  Measurable a ∧ (∃ C, ∀ ξ, ‖a ξ‖ ≤ C) ∧ ∀ f : ℝ × ℝ → ℂ, ContDiff ℝ ∞ f →
    HasCompactSupport f → ∀ p, monoFib ℓ (P f) p = 𝓕⁻ (fun ξ => a ξ * 𝓕 (monoFib ℓ f p) ξ)

/-- The identity is the multiplier `1`. -/
theorem fibMult_id (ℓ : Fin 2) : FibMult ℓ id fun _ => 1 := by
  refine ⟨measurable_const, ⟨1, fun _ => by simp⟩, fun _f hs hc p => ?_⟩
  simp only [one_mul, id]
  exact ((contDiff_monoFib ℓ hs p).continuous.fourierInv_fourier_eq
    (integrable_monoFib ℓ hs hc p) (integrable_fourier_monoFib ℓ hs hc p)).symm

theorem norm_psiMul_le (m : ℤ) (ξ : ℝ) : ‖psiMul m ξ‖ ≤ 1 := by
  rw [psiMul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (monoPsiA_nonneg _)]
  exact monoPsiA_le_one _

/-- `Δ^{(ℓ)}_m` is the multiplier `ψ(·/2^m)`. -/
theorem fibMult_lpD (ℓ : Fin 2) (m : ℤ) : FibMult ℓ (lpD ℓ m) (psiMul m) :=
  ⟨(psiMul_contDiff m).continuous.measurable, ⟨1, norm_psiMul_le m⟩, fun _f hs hc p =>
    monoFib_lpD_eq_lp1D_of ℓ m (integrable_monoFib ℓ hs hc p)⟩

/-- The multiplier `ξ ↦ φ(ξ/2^m)`. -/
def phiMul (m : ℤ) (ξ : ℝ) : ℂ := ((monoPhi (ξ / 2 ^ m) : ℝ) : ℂ)

theorem continuous_phiMul (m : ℤ) : Continuous (phiMul m) :=
  Complex.continuous_ofReal.comp (monoPhi_contDiff.continuous.comp (continuous_id.div_const _))

theorem norm_phiMul_le (m : ℤ) (ξ : ℝ) : ‖phiMul m ξ‖ ≤ 1 := by
  rw [phiMul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (monoPhi_nonneg _)]
  exact monoPhi_le_one _

/-- `S^{(ℓ)}_m` is the multiplier `φ(·/2^m)`. -/
theorem fibMult_lpS (ℓ : Fin 2) (m : ℤ) : FibMult ℓ (lpS ℓ m) (phiMul m) := by
  refine ⟨(continuous_phiMul m).measurable, ⟨1, norm_phiMul_le m⟩, fun f hs hc p => ?_⟩
  have hu := integrable_monoFib ℓ hs hc p
  have hF : 𝓕 (monoFib ℓ (lpS ℓ m f) p) = fun ξ => phiMul m ξ * 𝓕 (monoFib ℓ f p) ξ := by
    funext ξ
    unfold lpS monoKPhi
    rw [mloc_P_fib_fourier ℓ monoPhi_contDiff monoPhi_hasCompactSupport (by positivity) hu]
    rfl
  have hFint : Integrable (𝓕 (monoFib ℓ (lpS ℓ m f) p)) := by
    rw [hF]
    exact integrable_bdd_mul_of (integrable_fourier_monoFib ℓ hs hc p)
      (continuous_phiMul m).aestronglyMeasurable (norm_phiMul_le m)
  rw [← (continuous_fib_lpS_of ℓ m hu).fourierInv_fourier_eq (integrable_fib_lpS_of ℓ m hu) hFint,
    hF]

/-- **Fourier representation of `T_j` with fiber multipliers**, as an integral over `ℝ²`:
`T_j(P₁f₁, P₂f₂)(z) = ∫ a₁(ξ) a₂(η) ϑ(2^{-j}ξ, 4^{-j}η) 𝓕₁f₁(ξ,z₂) 𝓕₂f₂(z₁,η)
e^{2πi(z₁ξ+z₂η)} dξ dη`. -/
theorem Tj_eq_integral_of_fibMult (j : ℤ) {P₁ P₂ : (ℝ × ℝ → ℂ) → ℝ × ℝ → ℂ} {a₁ a₂ : ℝ → ℂ}
    (h₁ : FibMult 0 P₁ a₁) (h₂ : FibMult 1 P₂ a₂) {f₁ f₂ : ℝ × ℝ → ℂ}
    (hs₁ : ContDiff ℝ ∞ f₁) (hc₁ : HasCompactSupport f₁) (hs₂ : ContDiff ℝ ∞ f₂)
    (hc₂ : HasCompactSupport f₂) (z : ℝ × ℝ) :
    Tj j (P₁ f₁) (P₂ f₂) z = ∫ p : ℝ × ℝ, a₁ p.1 * a₂ p.2 *
      oscInt tjBump (p.1 / 2 ^ j) (p.2 / 4 ^ j) * tmPhase f₁ f₂ z p := by
  obtain ⟨hm₁, ⟨C₁, hC₁⟩, hr₁⟩ := h₁
  obtain ⟨hm₂, ⟨C₂, hC₂⟩, hr₂⟩ := h₂
  have hv₁ := integrable_fourier_monoFib 0 hs₁ hc₁ z.2
  have hv₂ := integrable_fourier_monoFib 1 hs₂ hc₂ z.1
  rw [monoFib_zero_eq] at hv₁
  rw [monoFib_one_eq] at hv₂
  have e₁ := hr₁ f₁ hs₁ hc₁ z.2
  have e₂ := hr₂ f₂ hs₂ hc₂ z.1
  rw [monoFib_zero_eq, monoFib_zero_eq] at e₁
  rw [monoFib_one_eq, monoFib_one_eq] at e₂
  rw [Tj_eq_integral_of_repr j (integrable_bdd_mul_of hv₁ hm₁.aestronglyMeasurable hC₁)
    (integrable_bdd_mul_of hv₂ hm₂.aestronglyMeasurable hC₂) z
    (fun s => (congrFun e₁ s).trans (fourierInv_eq_integral _ s))
    (fun s => (congrFun e₂ s).trans (fourierInv_eq_integral _ s))]
  refine integral_congr_ae (Eventually.of_forall fun p => ?_)
  simp only [tmPhase]
  ring

/-- **Fourier representation of `T_j` with fiber multipliers**:
`T_j(P₁f₁, P₂f₂) = T_m(f₁, f₂)` with `m(w) = a₁(-w₁) a₂(-w₂) ϑ(-2^{-j}w₁, -4^{-j}w₂)`. -/
theorem Tj_eq_Tm_of_fibMult (j : ℤ) {P₁ P₂ : (ℝ × ℝ → ℂ) → ℝ × ℝ → ℂ} {a₁ a₂ : ℝ → ℂ}
    (h₁ : FibMult 0 P₁ a₁) (h₂ : FibMult 1 P₂ a₂) {f₁ f₂ : ℝ × ℝ → ℂ}
    (hs₁ : ContDiff ℝ ∞ f₁) (hc₁ : HasCompactSupport f₁) (hs₂ : ContDiff ℝ ∞ f₂)
    (hc₂ : HasCompactSupport f₂) (z : ℝ × ℝ) :
    Tj j (P₁ f₁) (P₂ f₂) z = Tm (fun w => a₁ (-w.1) * a₂ (-w.2) *
      oscInt tjBump (-(w.1 / 2 ^ j)) (-(w.2 / 4 ^ j))) f₁ f₂ z := by
  rw [Tj_eq_integral_of_fibMult j h₁ h₂ hs₁ hc₁ hs₂ hc₂ z]
  obtain ⟨hm₁, ⟨C₁, hC₁⟩, -⟩ := h₁
  obtain ⟨hm₂, ⟨C₂, hC₂⟩, -⟩ := h₂
  have hosc : Continuous fun w : ℝ × ℝ => oscInt tjBump (-(w.1 / 2 ^ j)) (-(w.2 / 4 ^ j)) :=
    continuous_oscInt_comp (by fun_prop) (by fun_prop)
  have h3 := hosc.measurable
  have hmeas : Measurable fun w : ℝ × ℝ => a₁ (-w.1) * a₂ (-w.2) *
      oscInt tjBump (-(w.1 / 2 ^ j)) (-(w.2 / 4 ^ j)) := by fun_prop
  have hb : ∀ w : ℝ × ℝ, ‖a₁ (-w.1) * a₂ (-w.2) *
      oscInt tjBump (-(w.1 / 2 ^ j)) (-(w.2 / 4 ^ j))‖ ≤ C₁ * C₂ * oscBound := by
    intro w
    rw [norm_mul, norm_mul]
    have h0 : 0 ≤ C₁ := (norm_nonneg _).trans (hC₁ 0)
    exact mul_le_mul (mul_le_mul (hC₁ _) (hC₂ _) (norm_nonneg _) h0) (norm_oscInt_le _ _)
      (norm_nonneg _) (mul_nonneg h0 ((norm_nonneg _).trans (hC₂ 0)))
  rw [Tm_eq_integral hmeas hb (integrable_tmPhase_of_test hs₁ hc₁ hs₂ hc₂ z)]
  refine integral_congr_ae (Eventually.of_forall fun p => ?_)
  simp only [neg_neg, neg_div]

/-- `T_j = T_m` with `m(w) = ϑ(-2^{-j}w₁, -4^{-j}w₂)`, for test functions. -/
theorem Tj_eq_Tm (j : ℤ) {f₁ f₂ : ℝ × ℝ → ℂ} (hs₁ : ContDiff ℝ ∞ f₁)
    (hc₁ : HasCompactSupport f₁) (hs₂ : ContDiff ℝ ∞ f₂) (hc₂ : HasCompactSupport f₂)
    (z : ℝ × ℝ) :
    Tj j f₁ f₂ z = Tm (fun w => oscInt tjBump (-(w.1 / 2 ^ j)) (-(w.2 / 4 ^ j))) f₁ f₂ z := by
  have h := Tj_eq_Tm_of_fibMult j (fibMult_id 0) (fibMult_id 1) hs₁ hc₁ hs₂ hc₂ z
  simpa only [id, one_mul] using h

/-- `T_j(Δ^{(1)}_{m₁} f₁, Δ^{(2)}_{m₂} f₂) = T_m(f₁, f₂)` with
`m(w) = ψ(-w₁/2^{m₁}) ψ(-w₂/2^{m₂}) ϑ(-2^{-j}w₁, -4^{-j}w₂)`. -/
theorem Tj_lpD_lpD_eq_Tm (j m₁ m₂ : ℤ) {f₁ f₂ : ℝ × ℝ → ℂ} (hs₁ : ContDiff ℝ ∞ f₁)
    (hc₁ : HasCompactSupport f₁) (hs₂ : ContDiff ℝ ∞ f₂) (hc₂ : HasCompactSupport f₂)
    (z : ℝ × ℝ) :
    Tj j (lpD 0 m₁ f₁) (lpD 1 m₂ f₂) z = Tm (fun w => psiMul m₁ (-w.1) * psiMul m₂ (-w.2) *
      oscInt tjBump (-(w.1 / 2 ^ j)) (-(w.2 / 4 ^ j))) f₁ f₂ z :=
  Tj_eq_Tm_of_fibMult j (fibMult_lpD 0 m₁) (fibMult_lpD 1 m₂) hs₁ hc₁ hs₂ hc₂ z

/-- `T_j(Δ^{(1)}_{m₁} f₁, S^{(2)}_{m₂} f₂) = T_m(f₁, f₂)` with
`m(w) = ψ(-w₁/2^{m₁}) φ(-w₂/2^{m₂}) ϑ(-2^{-j}w₁, -4^{-j}w₂)`. -/
theorem Tj_lpD_lpS_eq_Tm (j m₁ m₂ : ℤ) {f₁ f₂ : ℝ × ℝ → ℂ} (hs₁ : ContDiff ℝ ∞ f₁)
    (hc₁ : HasCompactSupport f₁) (hs₂ : ContDiff ℝ ∞ f₂) (hc₂ : HasCompactSupport f₂)
    (z : ℝ × ℝ) :
    Tj j (lpD 0 m₁ f₁) (lpS 1 m₂ f₂) z = Tm (fun w => psiMul m₁ (-w.1) * phiMul m₂ (-w.2) *
      oscInt tjBump (-(w.1 / 2 ^ j)) (-(w.2 / 4 ^ j))) f₁ f₂ z :=
  Tj_eq_Tm_of_fibMult j (fibMult_lpD 0 m₁) (fibMult_lpS 1 m₂) hs₁ hc₁ hs₂ hc₂ z

/-- `T_j(S^{(1)}_{m₁} f₁, Δ^{(2)}_{m₂} f₂) = T_m(f₁, f₂)` with
`m(w) = φ(-w₁/2^{m₁}) ψ(-w₂/2^{m₂}) ϑ(-2^{-j}w₁, -4^{-j}w₂)`. -/
theorem Tj_lpS_lpD_eq_Tm (j m₁ m₂ : ℤ) {f₁ f₂ : ℝ × ℝ → ℂ} (hs₁ : ContDiff ℝ ∞ f₁)
    (hc₁ : HasCompactSupport f₁) (hs₂ : ContDiff ℝ ∞ f₂) (hc₂ : HasCompactSupport f₂)
    (z : ℝ × ℝ) :
    Tj j (lpS 0 m₁ f₁) (lpD 1 m₂ f₂) z = Tm (fun w => phiMul m₁ (-w.1) * psiMul m₂ (-w.2) *
      oscInt tjBump (-(w.1 / 2 ^ j)) (-(w.2 / 4 ^ j))) f₁ f₂ z :=
  Tj_eq_Tm_of_fibMult j (fibMult_lpS 0 m₁) (fibMult_lpD 1 m₂) hs₁ hc₁ hs₂ hc₂ z

/-- `T_j(S^{(1)}_{m₁} f₁, S^{(2)}_{m₂} f₂) = T_m(f₁, f₂)` with
`m(w) = φ(-w₁/2^{m₁}) φ(-w₂/2^{m₂}) ϑ(-2^{-j}w₁, -4^{-j}w₂)`. -/
theorem Tj_lpS_lpS_eq_Tm (j m₁ m₂ : ℤ) {f₁ f₂ : ℝ × ℝ → ℂ} (hs₁ : ContDiff ℝ ∞ f₁)
    (hc₁ : HasCompactSupport f₁) (hs₂ : ContDiff ℝ ∞ f₂) (hc₂ : HasCompactSupport f₂)
    (z : ℝ × ℝ) :
    Tj j (lpS 0 m₁ f₁) (lpS 1 m₂ f₂) z = Tm (fun w => phiMul m₁ (-w.1) * phiMul m₂ (-w.2) *
      oscInt tjBump (-(w.1 / 2 ^ j)) (-(w.2 / 4 ^ j))) f₁ f₂ z :=
  Tj_eq_Tm_of_fibMult j (fibMult_lpS 0 m₁) (fibMult_lpS 1 m₂) hs₁ hc₁ hs₂ hc₂ z

/-! ### The symbols `ν_L`, `ν_I`, `ν_II` -/

theorem continuous_lowNu : Continuous lowNu := by
  have h := continuous_oscInt
  unfold lowNu
  have hφ := monoPhi_contDiff.continuous
  fun_prop

theorem norm_lowNu_le (w : ℝ × ℝ) : ‖lowNu w‖ ≤ oscBound := by
  unfold lowNu
  rw [norm_mul, norm_mul, Complex.norm_real, Complex.norm_real, Real.norm_eq_abs,
    Real.norm_eq_abs, abs_of_nonneg (monoPhi_nonneg _), abs_of_nonneg (monoPhi_nonneg _)]
  have h1 := monoPhi_le_one w.1
  have h2 := monoPhi_le_one w.2
  have h3 := norm_oscInt_le w.1 w.2
  have h4 := monoPhi_nonneg w.1
  have h5 := monoPhi_nonneg w.2
  calc monoPhi w.1 * monoPhi w.2 * ‖oscInt tjBump w.1 w.2‖ ≤ 1 * 1 * oscBound := by gcongr
    _ = oscBound := by ring

/-- A series `∑ c_k ψ(a/2^{k+1})` with `0 ≤ c_k ≤ 1` is summable with sum in `[0, 1]`. -/
theorem summable_psi_series (a : ℝ) {c : ℕ → ℝ} (h0 : ∀ k, 0 ≤ c k) (h1 : ∀ k, c k ≤ 1) :
    Summable (fun k : ℕ => monoPsiA (a / 2 ^ (k + 1)) * c k) ∧
      0 ≤ ∑' k : ℕ, monoPsiA (a / 2 ^ (k + 1)) * c k ∧
      ∑' k : ℕ, monoPsiA (a / 2 ^ (k + 1)) * c k ≤ 1 := by
  have hle : ∀ k : ℕ, monoPsiA (a / 2 ^ (k + 1)) * c k ≤ monoPsiA (a / 2 ^ (k + 1)) :=
    fun k => mul_le_of_le_one_right (monoPsiA_nonneg _) (h1 k)
  have hnn : ∀ k : ℕ, 0 ≤ monoPsiA (a / 2 ^ (k + 1)) * c k :=
    fun k => mul_nonneg (monoPsiA_nonneg _) (h0 k)
  have hs := Summable.of_nonneg_of_le hnn hle (hasSum_monoPsiA_succ a).summable
  refine ⟨hs, tsum_nonneg hnn, ?_⟩
  have := hasSum_le hle hs.hasSum (hasSum_monoPsiA_succ a)
  linarith [monoPhi_nonneg a]

theorem measurable_tsum_ofReal {c : ℕ → ℝ × ℝ → ℝ} (hc : ∀ k, Continuous (c k)) :
    Measurable fun w => ∑' k : ℕ, ((c k w : ℝ) : ℂ) :=
  Measurable.tsum fun k => (Complex.continuous_ofReal.comp (hc k)).measurable

theorem norm_tsum_ofReal_le_one {c : ℕ → ℝ} (h0 : 0 ≤ ∑' k, c k) (h1 : ∑' k, c k ≤ 1) :
    ‖∑' k : ℕ, ((c k : ℝ) : ℂ)‖ ≤ 1 := by
  rw [← Complex.ofReal_tsum, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg h0]
  exact h1

theorem measurable_mixNuI : Measurable mixNuI := by
  unfold mixNuI
  refine continuous_oscInt.measurable.mul (measurable_tsum_ofReal fun k => ?_)
  exact (monoPsiA_contDiff.continuous.comp (continuous_fst.div_const _)).mul
    (monoPhi_contDiff.continuous.comp (continuous_snd.mul continuous_const))

theorem measurable_mixNuII : Measurable mixNuII := by
  unfold mixNuII
  refine continuous_oscInt.measurable.mul (measurable_tsum_ofReal fun k => ?_)
  exact (monoPhi_contDiff.continuous.comp (continuous_fst.mul continuous_const)).mul
    (monoPsiA_contDiff.continuous.comp (continuous_snd.div_const _))

theorem norm_mixNuI_le (w : ℝ × ℝ) : ‖mixNuI w‖ ≤ oscBound := by
  unfold mixNuI
  obtain ⟨-, h0, h1⟩ := summable_psi_series w.1 (c := fun k : ℕ =>
    monoPhi (w.2 * (2 : ℝ) ^ ((100 : ℤ) - k))) (fun _ => monoPhi_nonneg _)
    (fun _ => monoPhi_le_one _)
  rw [norm_mul]
  calc ‖oscInt tjBump w.1 w.2‖ * _ ≤ oscBound * 1 :=
        mul_le_mul (norm_oscInt_le _ _) (norm_tsum_ofReal_le_one h0 h1) (norm_nonneg _)
          oscBound_nonneg
    _ = oscBound := mul_one _

theorem norm_mixNuII_le (w : ℝ × ℝ) : ‖mixNuII w‖ ≤ oscBound := by
  unfold mixNuII
  obtain ⟨-, h0, h1⟩ := summable_psi_series w.2 (c := fun k : ℕ =>
    monoPhi (w.1 * (2 : ℝ) ^ ((100 : ℤ) - k))) (fun _ => monoPhi_nonneg _)
    (fun _ => monoPhi_le_one _)
  have e : ∀ k : ℕ, monoPhi (w.1 * (2 : ℝ) ^ ((100 : ℤ) - k)) * monoPsiA (w.2 / 2 ^ (k + 1)) =
      monoPsiA (w.2 / 2 ^ (k + 1)) * monoPhi (w.1 * (2 : ℝ) ^ ((100 : ℤ) - k)) :=
    fun k => mul_comm _ _
  simp_rw [e]
  rw [norm_mul]
  calc ‖oscInt tjBump w.1 w.2‖ * _ ≤ oscBound * 1 :=
        mul_le_mul (norm_oscInt_le _ _) (norm_tsum_ofReal_le_one h0 h1) (norm_nonneg _)
          oscBound_nonneg
    _ = oscBound := mul_one _

/-- **The decomposition of `ϑ`** along the partition of unity:
`ϑ = ν_L + ν_I + ν_II + ∑_{k ∈ 𝔉_H} ψ(·/2^{k₁}) ψ(·/2^{k₂}) ϑ`. -/
theorem oscInt_decomp (a b : ℝ) :
    oscInt tjBump a b = lowNu (a, b) + mixNuI (a, b) + mixNuII (a, b) +
      ∑' k : 𝔉H, ((monoPsiA (a / 2 ^ k.1.1) * monoPsiA (b / 2 ^ k.1.2) : ℝ) : ℂ) *
        oscInt tjBump a b := by
  have h := congrArg (fun r : ℝ => (r : ℂ)) (partition_unity a b)
  simp only [Complex.ofReal_add, Complex.ofReal_tsum, Complex.ofReal_one] at h
  simp only [lowNu, mixNuI, mixNuII]
  rw [tsum_mul_right]
  linear_combination (norm := skip) (-oscInt tjBump a b) * h
  push_cast
  ring

/-! ### The frequency-side integrands -/

theorem two_zpow_two_mul (j : ℤ) : (2 : ℝ) ^ (2 * j) = 4 ^ j := by
  rw [zpow_mul]; norm_num

theorem div_two_zpow_add (x : ℝ) (j k : ℤ) : x / 2 ^ (j + k) = x / 2 ^ j / 2 ^ k := by
  rw [zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), div_div]

theorem div_two_zpow_two_mul_add (x : ℝ) (j k : ℤ) :
    x / 2 ^ (2 * j + k) = x / 4 ^ j / 2 ^ k := by
  rw [div_two_zpow_add, two_zpow_two_mul]

/-- The `(j, k)` high-frequency integrand
`ψ(2^{-j}ξ/2^{k₁}) ψ(4^{-j}η/2^{k₂}) ϑ(2^{-j}ξ, 4^{-j}η)`. -/
def highInt (j : ℤ) (k : ℤ × ℤ) (p : ℝ × ℝ) : ℂ :=
  ((monoPsiA (p.1 / 2 ^ j / 2 ^ k.1) * monoPsiA (p.2 / 4 ^ j / 2 ^ k.2) : ℝ) : ℂ) *
    oscInt tjBump (p.1 / 2 ^ j) (p.2 / 4 ^ j)

theorem continuous_highInt (j : ℤ) (k : ℤ × ℤ) : Continuous (highInt j k) := by
  have h := continuous_oscInt_comp (X := ℝ × ℝ) (f := fun p => p.1 / 2 ^ j)
    (g := fun p => p.2 / 4 ^ j) (by fun_prop) (by fun_prop)
  have hψ := monoPsiA_contDiff.continuous
  unfold highInt
  fun_prop

theorem norm_highInt_le (j : ℤ) (k : ℤ × ℤ) (p : ℝ × ℝ) :
    ‖highInt j k p‖ ≤ monoPsiA (p.1 / 2 ^ j / 2 ^ k.1) * monoPsiA (p.2 / 4 ^ j / 2 ^ k.2) *
      oscBound := by
  unfold highInt
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (mul_nonneg (monoPsiA_nonneg _) (monoPsiA_nonneg _))]
  exact mul_le_mul_of_nonneg_left (norm_oscInt_le _ _)
    (mul_nonneg (monoPsiA_nonneg _) (monoPsiA_nonneg _))

theorem continuous_oscInt_dil (j : ℤ) :
    Continuous fun p : ℝ × ℝ => oscInt tjBump (p.1 / 2 ^ j) (p.2 / 4 ^ j) :=
  continuous_oscInt_comp (by fun_prop) (by fun_prop)

theorem integrable_sum_mul_tmPhase {f₁ f₂ : ℝ × ℝ → ℂ} {z : ℝ × ℝ}
    (hΦ : Integrable (tmPhase f₁ f₂ z)) (F : Finset ℤ) {g : ℤ → ℝ × ℝ → ℂ}
    (hg : ∀ j, Measurable (g j)) {C : ℝ} (hC : ∀ j p, ‖g j p‖ ≤ C) :
    Integrable fun p => (∑ j ∈ F, g j p) * tmPhase f₁ f₂ z p :=
  integrable_mul_tmPhase hΦ (Finset.measurable_sum F fun j _ => hg j) (C := F.card * C)
    fun p => (norm_sum_le _ _).trans ((Finset.sum_le_sum fun j _ => hC j p).trans
      (by rw [Finset.sum_const, nsmul_eq_mul]))

/-- `T_j(f₁, f₂)(z) = ∫ ϑ(2^{-j}ξ, 4^{-j}η) Φ(ξ, η)`. -/
theorem Tj_eq_integral (j : ℤ) {f₁ f₂ : ℝ × ℝ → ℂ} (hs₁ : ContDiff ℝ ∞ f₁)
    (hc₁ : HasCompactSupport f₁) (hs₂ : ContDiff ℝ ∞ f₂) (hc₂ : HasCompactSupport f₂)
    (z : ℝ × ℝ) : Tj j f₁ f₂ z =
      ∫ p, oscInt tjBump (p.1 / 2 ^ j) (p.2 / 4 ^ j) * tmPhase f₁ f₂ z p := by
  have h := Tj_eq_integral_of_fibMult j (fibMult_id 0) (fibMult_id 1) hs₁ hc₁ hs₂ hc₂ z
  simpa only [id, one_mul] using h

/-- `T_j(Δ^{(1)}_{j+k₁} f₁, Δ^{(2)}_{2j+k₂} f₂)(z) = ∫ highInt j k Φ`. -/
theorem Tj_lpD_eq_integral (j : ℤ) (k : ℤ × ℤ) {f₁ f₂ : ℝ × ℝ → ℂ} (hs₁ : ContDiff ℝ ∞ f₁)
    (hc₁ : HasCompactSupport f₁) (hs₂ : ContDiff ℝ ∞ f₂) (hc₂ : HasCompactSupport f₂)
    (z : ℝ × ℝ) : Tj j (lpD 0 (j + k.1) f₁) (lpD 1 (2 * j + k.2) f₂) z =
      ∫ p, highInt j k p * tmPhase f₁ f₂ z p := by
  rw [Tj_eq_integral_of_fibMult j (fibMult_lpD 0 _) (fibMult_lpD 1 _) hs₁ hc₁ hs₂ hc₂ z]
  refine integral_congr_ae (Eventually.of_forall fun p => ?_)
  simp only [highInt, psiMul, div_two_zpow_add, two_zpow_two_mul, Complex.ofReal_mul]

theorem symSum_neg (ν : ℝ × ℝ → ℂ) (F : Finset ℤ) (p : ℝ × ℝ) :
    symSum ν F (-p.1, -p.2) = ∑ j ∈ F, ν (p.1 / 2 ^ j, p.2 / 4 ^ j) := by
  simp only [symSum, neg_div, neg_neg]

/-- `T_{Σν}(f₁, f₂)(z) = ∫ (∑_{j ∈ F} ν(2^{-j}ξ, 4^{-j}η)) Φ(ξ, η)` for bounded measurable `ν`. -/
theorem Tm_symSum_eq {ν : ℝ × ℝ → ℂ} (hν : Measurable ν) {C : ℝ} (hC : ∀ w, ‖ν w‖ ≤ C)
    (F : Finset ℤ) {f₁ f₂ : ℝ × ℝ → ℂ} {z : ℝ × ℝ} (hΦ : Integrable (tmPhase f₁ f₂ z)) :
    Tm (symSum ν F) f₁ f₂ z =
      ∫ p, (∑ j ∈ F, ν (p.1 / 2 ^ j, p.2 / 4 ^ j)) * tmPhase f₁ f₂ z p := by
  have hm : Measurable (symSum ν F) := by
    unfold symSum
    exact Finset.measurable_sum F fun j _ => hν.comp (by fun_prop)
  rw [Tm_eq_integral hm (C := F.card * C) (fun w => (norm_sum_le _ _).trans
    ((Finset.sum_le_sum fun j _ => hC _).trans (by rw [Finset.sum_const, nsmul_eq_mul]))) hΦ]
  simp only [symSum_neg]

/-! ### The decomposition `eqn:basicfreqdecomp` -/

theorem summable_highInt (j : ℤ) (p : ℝ × ℝ) : Summable fun k : 𝔉H => highInt j k.1 p :=
  (Complex.summable_ofReal.2 (summable_highIdx (p.1 / 2 ^ j) (p.2 / 4 ^ j))).mul_right _

/-- Pointwise form of the decomposition, summed over `j ∈ F`. -/
theorem sum_oscInt_decomp (F : Finset ℤ) (p : ℝ × ℝ) :
    ∑ j ∈ F, oscInt tjBump (p.1 / 2 ^ j) (p.2 / 4 ^ j) =
      (∑ j ∈ F, lowNu (p.1 / 2 ^ j, p.2 / 4 ^ j)) + (∑ j ∈ F, mixNuI (p.1 / 2 ^ j, p.2 / 4 ^ j)) +
      (∑ j ∈ F, mixNuII (p.1 / 2 ^ j, p.2 / 4 ^ j)) +
      ∑' k : 𝔉H, ∑ j ∈ F, highInt j k.1 p := by
  rw [Summable.tsum_finsetSum fun j _ => summable_highInt j p, ← Finset.sum_add_distrib,
    ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [oscInt_decomp]
  rfl

theorem norm_sum_highInt_le (F : Finset ℤ) (u : Finset 𝔉H) (p : ℝ × ℝ) :
    ∑ k ∈ u, ‖∑ j ∈ F, highInt j k.1 p‖ ≤ F.card * oscBound := by
  calc ∑ k ∈ u, ‖∑ j ∈ F, highInt j k.1 p‖
      ≤ ∑ k ∈ u, ∑ j ∈ F, monoPsiA (p.1 / 2 ^ j / 2 ^ k.1.1) *
          monoPsiA (p.2 / 4 ^ j / 2 ^ k.1.2) * oscBound :=
        Finset.sum_le_sum fun k _ => (norm_sum_le _ _).trans
          (Finset.sum_le_sum fun j _ => norm_highInt_le j k.1 p)
    _ = ∑ j ∈ F, (∑ k ∈ u, monoPsiA (p.1 / 2 ^ j / 2 ^ k.1.1) *
          monoPsiA (p.2 / 4 ^ j / 2 ^ k.1.2)) * oscBound := by
        rw [Finset.sum_comm]
        exact Finset.sum_congr rfl fun j _ => (Finset.sum_mul _ _ _).symm
    _ ≤ ∑ _j ∈ F, 1 * oscBound :=
        Finset.sum_le_sum fun j _ => mul_le_mul_of_nonneg_right
          (sum_highIdx_le_one u _ _) oscBound_nonneg
    _ = F.card * oscBound := by rw [Finset.sum_const, nsmul_eq_mul, one_mul]

theorem integrable_highInt_mul (j : ℤ) (k : ℤ × ℤ) {f₁ f₂ : ℝ × ℝ → ℂ} {z : ℝ × ℝ}
    (hΦ : Integrable (tmPhase f₁ f₂ z)) : Integrable fun p => highInt j k p * tmPhase f₁ f₂ z p :=
  integrable_mul_tmPhase hΦ (continuous_highInt j k).measurable (C := oscBound) fun p =>
    (norm_highInt_le j k p).trans (by
      have h1 := monoPsiA_le_one (p.1 / 2 ^ j / 2 ^ k.1)
      have h2 := monoPsiA_le_one (p.2 / 4 ^ j / 2 ^ k.2)
      have h3 := monoPsiA_nonneg (p.1 / 2 ^ j / 2 ^ k.1)
      have h4 := monoPsiA_nonneg (p.2 / 4 ^ j / 2 ^ k.2)
      have h5 := oscBound_nonneg
      calc monoPsiA (p.1 / 2 ^ j / 2 ^ k.1) * monoPsiA (p.2 / 4 ^ j / 2 ^ k.2) * oscBound
          ≤ 1 * 1 * oscBound := by gcongr
        _ = oscBound := by ring)

theorem integrable_sum_highInt_mul (F : Finset ℤ) (k : ℤ × ℤ) {f₁ f₂ : ℝ × ℝ → ℂ}
    {z : ℝ × ℝ} (hΦ : Integrable (tmPhase f₁ f₂ z)) :
    Integrable fun p => (∑ j ∈ F, highInt j k p) * tmPhase f₁ f₂ z p := by
  simp_rw [Finset.sum_mul]
  exact integrable_finsetSum F fun j _ => integrable_highInt_mul j k hΦ

/-- **Absolute summability of the high-frequency part**:
`∑_{k ∈ 𝔉_H} ∫ |∑_{j ∈ F} highInt j k · Φ| ≤ |F| C_ϑ ∫ |Φ|`. -/
theorem summable_integral_norm_highInt (F : Finset ℤ) {f₁ f₂ : ℝ × ℝ → ℂ} {z : ℝ × ℝ}
    (hΦ : Integrable (tmPhase f₁ f₂ z)) :
    Summable fun k : 𝔉H => ∫ p, ‖(∑ j ∈ F, highInt j k.1 p) * tmPhase f₁ f₂ z p‖ := by
  refine summable_of_sum_le (c := F.card * oscBound * ∫ p, ‖tmPhase f₁ f₂ z p‖)
    (fun k => integral_nonneg fun _ => norm_nonneg _) fun u => ?_
  rw [← integral_finsetSum u fun k _ => (integrable_sum_highInt_mul F k.1 hΦ).norm,
    ← integral_const_mul]
  refine integral_mono (integrable_finsetSum u fun k _ =>
    (integrable_sum_highInt_mul F k.1 hΦ).norm) (hΦ.norm.const_mul _) fun p => ?_
  simp only [norm_mul]
  rw [← Finset.sum_mul]
  exact mul_le_mul_of_nonneg_right (norm_sum_highInt_le F u p) (norm_nonneg _)

theorem sum_Tj_lpD_eq_integral (F : Finset ℤ) (k : ℤ × ℤ) {f₁ f₂ : ℝ × ℝ → ℂ}
    (hs₁ : ContDiff ℝ ∞ f₁) (hc₁ : HasCompactSupport f₁) (hs₂ : ContDiff ℝ ∞ f₂)
    (hc₂ : HasCompactSupport f₂) (z : ℝ × ℝ) :
    ∑ j ∈ F, Tj j (lpD 0 (j + k.1) f₁) (lpD 1 (2 * j + k.2) f₂) z =
      ∫ p, (∑ j ∈ F, highInt j k p) * tmPhase f₁ f₂ z p := by
  have hΦ := integrable_tmPhase_of_test hs₁ hc₁ hs₂ hc₂ z
  simp_rw [Finset.sum_mul]
  rw [integral_finsetSum F fun j _ => integrable_highInt_mul j k hΦ]
  exact Finset.sum_congr rfl fun j _ => Tj_lpD_eq_integral j k hs₁ hc₁ hs₂ hc₂ z

/-- `k ↦ ∑_{j ∈ F} T_j(Δ^{(1)}_{j+k₁} f₁, Δ^{(2)}_{2j+k₂} f₂)(z)` is absolutely summable over
`𝔉_H`, and its sum is the `𝔉_H`-part of the frequency integral. -/
theorem hasSum_high (F : Finset ℤ) {f₁ f₂ : ℝ × ℝ → ℂ} (hs₁ : ContDiff ℝ ∞ f₁)
    (hc₁ : HasCompactSupport f₁) (hs₂ : ContDiff ℝ ∞ f₂) (hc₂ : HasCompactSupport f₂)
    (z : ℝ × ℝ) :
    HasSum (fun k : 𝔉H => ∑ j ∈ F, Tj j (lpD 0 (j + k.1.1) f₁) (lpD 1 (2 * j + k.1.2) f₂) z)
      (∫ p, ∑' k : 𝔉H, (∑ j ∈ F, highInt j k.1 p) * tmPhase f₁ f₂ z p) := by
  have hΦ := integrable_tmPhase_of_test hs₁ hc₁ hs₂ hc₂ z
  have h := hasSum_integral_of_summable_integral_norm
    (F := fun (k : 𝔉H) p => (∑ j ∈ F, highInt j k.1 p) * tmPhase f₁ f₂ z p)
    (fun k => integrable_sum_highInt_mul F k.1 hΦ) (summable_integral_norm_highInt F hΦ)
  refine (congrArg (fun G : 𝔉H → ℂ => HasSum G _) (funext fun k => ?_)).mpr h
  exact sum_Tj_lpD_eq_integral F k.1 hs₁ hc₁ hs₂ hc₂ z

/-- **Absolute summability** of the high-frequency series. -/
theorem summable_norm_high (F : Finset ℤ) {f₁ f₂ : ℝ × ℝ → ℂ} (hs₁ : ContDiff ℝ ∞ f₁)
    (hc₁ : HasCompactSupport f₁) (hs₂ : ContDiff ℝ ∞ f₂) (hc₂ : HasCompactSupport f₂)
    (z : ℝ × ℝ) :
    Summable fun k : 𝔉H =>
      ‖∑ j ∈ F, Tj j (lpD 0 (j + k.1.1) f₁) (lpD 1 (2 * j + k.1.2) f₂) z‖ := by
  have hΦ := integrable_tmPhase_of_test hs₁ hc₁ hs₂ hc₂ z
  refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun k => ?_)
    (summable_integral_norm_highInt F hΦ)
  rw [sum_Tj_lpD_eq_integral F k.1 hs₁ hc₁ hs₂ hc₂ z]
  exact norm_integral_le_integral_norm _

/-- **The decomposition `T = T^L + T^M + T^H`** (`eqn:basicfreqdecomp`, `eqn:basic-freq-dec`),
for the finite partial sums `∑_{j ∈ F} T_j` and test functions: the low and mixed parts are the
operators `T_m` with the symbols `∑_{j ∈ F} ν(-2^{-j}·, -4^{-j}·)`, `ν = ν_L, ν_I, ν_II`, and the
high part is `∑_{k ∈ 𝔉_H} ∑_{j ∈ F} T_j(Δ^{(1)}_{j+k₁} f₁, Δ^{(2)}_{2j+k₂} f₂)`
(absolutely summable, `Auto.CDR.summable_norm_high`). -/
theorem sum_Tj_decomp (F : Finset ℤ) {f₁ f₂ : ℝ × ℝ → ℂ} (hs₁ : ContDiff ℝ ∞ f₁)
    (hc₁ : HasCompactSupport f₁) (hs₂ : ContDiff ℝ ∞ f₂) (hc₂ : HasCompactSupport f₂)
    (z : ℝ × ℝ) :
    ∑ j ∈ F, Tj j f₁ f₂ z = Tm (symSum lowNu F) f₁ f₂ z + Tm (symSum mixNuI F) f₁ f₂ z +
      Tm (symSum mixNuII F) f₁ f₂ z +
      ∑' k : {k : ℤ × ℤ // 0 < max k.1 k.2 ∧ |k.1 - k.2| ≤ 100},
        ∑ j ∈ F, Tj j (lpD 0 (j + k.1.1) f₁) (lpD 1 (2 * j + k.1.2) f₂) z := by
  have hΦ := integrable_tmPhase_of_test hs₁ hc₁ hs₂ hc₂ z
  have iO := integrable_sum_mul_tmPhase hΦ F (fun j => (continuous_oscInt_dil j).measurable)
    (fun j p => norm_oscInt_le _ _)
  have iX := integrable_sum_mul_tmPhase hΦ F
    (g := fun j p => lowNu (p.1 / 2 ^ j, p.2 / 4 ^ j))
    (fun j => continuous_lowNu.measurable.comp (by fun_prop)) (fun j p => norm_lowNu_le _)
  have iY := integrable_sum_mul_tmPhase hΦ F
    (g := fun j p => mixNuI (p.1 / 2 ^ j, p.2 / 4 ^ j))
    (fun j => measurable_mixNuI.comp (by fun_prop)) (fun j p => norm_mixNuI_le _)
  have iZ := integrable_sum_mul_tmPhase hΦ F
    (g := fun j p => mixNuII (p.1 / 2 ^ j, p.2 / 4 ^ j))
    (fun j => measurable_mixNuII.comp (by fun_prop)) (fun j p => norm_mixNuII_le _)
  have hW : ∀ p : ℝ × ℝ, ∑' k : 𝔉H, (∑ j ∈ F, highInt j k.1 p) * tmPhase f₁ f₂ z p =
      (∑ j ∈ F, oscInt tjBump (p.1 / 2 ^ j) (p.2 / 4 ^ j)) * tmPhase f₁ f₂ z p -
        (∑ j ∈ F, lowNu (p.1 / 2 ^ j, p.2 / 4 ^ j)) * tmPhase f₁ f₂ z p -
        (∑ j ∈ F, mixNuI (p.1 / 2 ^ j, p.2 / 4 ^ j)) * tmPhase f₁ f₂ z p -
        (∑ j ∈ F, mixNuII (p.1 / 2 ^ j, p.2 / 4 ^ j)) * tmPhase f₁ f₂ z p := by
    intro p
    rw [tsum_mul_right, sum_oscInt_decomp]
    ring
  have hT : ∑ j ∈ F, Tj j f₁ f₂ z =
      ∫ p, (∑ j ∈ F, oscInt tjBump (p.1 / 2 ^ j) (p.2 / 4 ^ j)) * tmPhase f₁ f₂ z p := by
    simp_rw [Finset.sum_mul]
    rw [integral_finsetSum F fun j _ => integrable_mul_tmPhase hΦ
      (continuous_oscInt_dil j).measurable (fun p => norm_oscInt_le _ _)]
    exact Finset.sum_congr rfl fun j _ => Tj_eq_integral j hs₁ hc₁ hs₂ hc₂ z
  have i2 : Integrable fun p : ℝ × ℝ =>
      (∑ j ∈ F, oscInt tjBump (p.1 / 2 ^ j) (p.2 / 4 ^ j)) * tmPhase f₁ f₂ z p -
        (∑ j ∈ F, lowNu (p.1 / 2 ^ j, p.2 / 4 ^ j)) * tmPhase f₁ f₂ z p := iO.sub iX
  have i3 : Integrable fun p : ℝ × ℝ =>
      (∑ j ∈ F, oscInt tjBump (p.1 / 2 ^ j) (p.2 / 4 ^ j)) * tmPhase f₁ f₂ z p -
        (∑ j ∈ F, lowNu (p.1 / 2 ^ j, p.2 / 4 ^ j)) * tmPhase f₁ f₂ z p -
        (∑ j ∈ F, mixNuI (p.1 / 2 ^ j, p.2 / 4 ^ j)) * tmPhase f₁ f₂ z p := i2.sub iY
  rw [(hasSum_high F hs₁ hc₁ hs₂ hc₂ z).tsum_eq, integral_congr_ae (Eventually.of_forall hW),
    integral_sub i3 iZ, integral_sub i2 iY, integral_sub iO iX,
    Tm_symSum_eq continuous_lowNu.measurable norm_lowNu_le F hΦ,
    Tm_symSum_eq measurable_mixNuI norm_mixNuI_le F hΦ,
    Tm_symSum_eq measurable_mixNuII norm_mixNuII_le F hΦ, hT]
  ring

/-- The high-frequency series over `𝔉_H` is summable. -/
theorem summable_high (F : Finset ℤ) {f₁ f₂ : ℝ × ℝ → ℂ} (hs₁ : ContDiff ℝ ∞ f₁)
    (hc₁ : HasCompactSupport f₁) (hs₂ : ContDiff ℝ ∞ f₂) (hc₂ : HasCompactSupport f₂)
    (z : ℝ × ℝ) :
    Summable fun k : {k : ℤ × ℤ // 0 < max k.1 k.2 ∧ |k.1 - k.2| ≤ 100} =>
      ∑ j ∈ F, Tj j (lpD 0 (j + k.1.1) f₁) (lpD 1 (2 * j + k.1.2) f₂) z :=
  (hasSum_high F hs₁ hc₁ hs₂ hc₂ z).summable

/-! ### The principal value `T = p.v. ∫ · dt/t` (`eqn:thtc`) and `T = ∑_j T_j` -/

/-- `T(f₁,f₂)(z) = p.v. ∫ f₁(z₁+t, z₂) f₂(z₁, z₂+t²) dt/t` (`eqn:thtc`), the limit of the
truncations `∫_{|t| > ε}` as `ε → 0⁺`. -/
def pvT (f₁ f₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℂ :=
  limUnder (𝓝[>] (0 : ℝ)) fun ε =>
    ∫ t in {t : ℝ | ε < |t|}, f₁ (z.1 + t, z.2) * f₂ (z.1, z.2 + t ^ 2) / t

/-- `G(t) = f₁(z₁+t, z₂) f₂(z₁, z₂+t²)`. -/
def pvG (f₁ f₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) (t : ℝ) : ℂ := f₁ (z.1 + t, z.2) * f₂ (z.1, z.2 + t ^ 2)

/-- `H(t) = (G(t) - G(0) 1_{[-1,1]}(t))/t`, integrable for test functions. -/
def pvH (f₁ f₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) (t : ℝ) : ℂ :=
  (pvG f₁ f₂ z t - (Icc (-1 : ℝ) 1).indicator (fun _ => pvG f₁ f₂ z 0) t) / t

theorem pvH_zero (f₁ f₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : pvH f₁ f₂ z 0 = 0 := by
  simp [pvH]

theorem integral_odd_eq_zero {f : ℝ → ℂ} (hf : ∀ t, f (-t) = -f t) : ∫ t, f t = 0 := by
  have h := integral_neg_eq_self f volume
  simp_rw [hf, integral_neg] at h
  linear_combination (-1 / 2 : ℂ) * h

theorem neg_mem_Icc_one (t : ℝ) : -t ∈ Icc (-1 : ℝ) 1 ↔ t ∈ Icc (-1 : ℝ) 1 := by
  simp only [mem_Icc]
  constructor <;> intro h <;> constructor <;> linarith [h.1, h.2]

theorem indicator_neg_eq {S : Set ℝ} (hS : ∀ t, -t ∈ S ↔ t ∈ S) {f : ℝ → ℂ}
    (hf : ∀ t, f (-t) = -f t) (t : ℝ) : S.indicator f (-t) = -S.indicator f t := by
  by_cases ht : t ∈ S
  · rw [Set.indicator_of_mem ((hS t).2 ht), Set.indicator_of_mem ht, hf]
  · rw [Set.indicator_of_notMem (fun h => ht ((hS t).1 h)), Set.indicator_of_notMem ht, neg_zero]

theorem indicator_const_neg (c : ℂ) (t : ℝ) :
    (Icc (-1 : ℝ) 1).indicator (fun _ => c) (-t) = (Icc (-1 : ℝ) 1).indicator (fun _ => c) t := by
  by_cases ht : t ∈ Icc (-1 : ℝ) 1
  · rw [Set.indicator_of_mem ((neg_mem_Icc_one t).2 ht), Set.indicator_of_mem ht]
  · rw [Set.indicator_of_notMem (fun h => ht ((neg_mem_Icc_one t).1 h)),
      Set.indicator_of_notMem ht]

section TestFunctions

variable {f₁ f₂ : ℝ × ℝ → ℂ}

theorem contDiff_pvG (hs₁ : ContDiff ℝ ∞ f₁) (hs₂ : ContDiff ℝ ∞ f₂) (z : ℝ × ℝ) :
    ContDiff ℝ ∞ (pvG f₁ f₂ z) := by
  unfold pvG
  fun_prop

theorem hasCompactSupport_pvG (hc₁ : HasCompactSupport f₁) (z : ℝ × ℝ) :
    HasCompactSupport (pvG f₁ f₂ z) := by
  have e : (fun t => f₁ (z.1 + t, z.2)) = monoFib 0 f₁ z.2 ∘ Homeomorph.addLeft z.1 := by
    funext t; simp [monoFib, monoPt]
  have h : HasCompactSupport fun t => f₁ (z.1 + t, z.2) := by
    rw [e]; exact (hasCompactSupport_monoFib 0 hc₁ z.2).comp_homeomorph _
  exact h.mul_right

theorem integrable_pvG (hs₁ : ContDiff ℝ ∞ f₁) (hc₁ : HasCompactSupport f₁)
    (hs₂ : ContDiff ℝ ∞ f₂) (z : ℝ × ℝ) : Integrable (pvG f₁ f₂ z) :=
  (contDiff_pvG hs₁ hs₂ z).continuous.integrable_of_hasCompactSupport
    (hasCompactSupport_pvG hc₁ z)

theorem exists_bound_pvG (hs₁ : ContDiff ℝ ∞ f₁) (hc₁ : HasCompactSupport f₁)
    (hs₂ : ContDiff ℝ ∞ f₂) (z : ℝ × ℝ) : ∃ M, ∀ t, ‖pvG f₁ f₂ z t‖ ≤ M := by
  obtain ⟨M, hM⟩ := (contDiff_pvG hs₁ hs₂ z).continuous.norm.bddAbove_range_of_hasCompactSupport
    (hasCompactSupport_pvG hc₁ z).norm
  exact ⟨M, fun t => hM ⟨t, rfl⟩⟩

theorem measurable_pvH (hs₁ : ContDiff ℝ ∞ f₁) (hs₂ : ContDiff ℝ ∞ f₂) (z : ℝ × ℝ) :
    Measurable (pvH f₁ f₂ z) :=
  ((contDiff_pvG hs₁ hs₂ z).continuous.measurable.sub
    (measurable_const.indicator measurableSet_Icc)).div Complex.measurable_ofReal

/-- `H` is integrable: `|H| ≤ L 1_{[-1,1]} + |G|` with `L` the Lipschitz constant of `G`. -/
theorem integrable_pvH (hs₁ : ContDiff ℝ ∞ f₁) (hc₁ : HasCompactSupport f₁)
    (hs₂ : ContDiff ℝ ∞ f₂) (z : ℝ × ℝ) : Integrable (pvH f₁ f₂ z) := by
  obtain ⟨L, hL⟩ := ContDiff.lipschitzWith_of_hasCompactSupport (hasCompactSupport_pvG hc₁ z)
    (contDiff_pvG hs₁ hs₂ z) (by simp)
  have hb : Integrable fun t : ℝ => (Icc (-1 : ℝ) 1).indicator (fun _ => (L : ℝ)) t +
      ‖pvG f₁ f₂ z t‖ :=
    (continuous_const.integrableOn_Icc.integrable_indicator measurableSet_Icc).add
      (integrable_pvG hs₁ hc₁ hs₂ z).norm
  refine hb.mono' (measurable_pvH hs₁ hs₂ z).aestronglyMeasurable
    (Eventually.of_forall fun t => ?_)
  rcases eq_or_ne t 0 with rfl | ht
  · rw [pvH_zero, norm_zero]
    exact add_nonneg (Set.indicator_nonneg (fun _ _ => L.2) _) (norm_nonneg _)
  have hta : 0 < |t| := abs_pos.2 ht
  by_cases hI : t ∈ Icc (-1 : ℝ) 1
  · rw [pvH, Set.indicator_of_mem hI, Set.indicator_of_mem hI, norm_div, Complex.norm_real,
      Real.norm_eq_abs, div_le_iff₀ hta]
    have h1 := hL.norm_sub_le t 0
    rw [sub_zero, Real.norm_eq_abs] at h1
    nlinarith [norm_nonneg (pvG f₁ f₂ z t)]
  · rw [pvH, Set.indicator_of_notMem hI, Set.indicator_of_notMem hI, sub_zero, zero_add,
      norm_div, Complex.norm_real, Real.norm_eq_abs]
    have h1 : 1 < |t| := by
      simp only [mem_Icc, not_and_or, not_le] at hI
      rcases hI with h | h
      · rw [abs_of_neg (by linarith)]; linarith
      · rw [abs_of_pos (by linarith)]; linarith
    exact div_le_self (norm_nonneg _) h1.le

/-- `T_j(f₁,f₂)(z) = ∫ H(t) ψ(2^j t) dt`: the subtracted term `G(0) 1_{[-1,1]}(t) ψ(2^j t)/t` is
odd. -/
theorem Tj_eq_integral_pvH (j : ℤ) (hs₁ : ContDiff ℝ ∞ f₁) (hc₁ : HasCompactSupport f₁)
    (hs₂ : ContDiff ℝ ∞ f₂) (z : ℝ × ℝ) :
    Tj j f₁ f₂ z = ∫ t, pvH f₁ f₂ z t * ((monoPsiA ((2 : ℝ) ^ j * t) : ℝ) : ℂ) := by
  obtain ⟨M, hM⟩ := exists_bound_pvG hs₁ hc₁ hs₂ z
  have hGw : Integrable fun t => pvG f₁ f₂ z t * ((monoPsiA ((2 : ℝ) ^ j * t) / t : ℝ) : ℂ) :=
    integrable_bdd_mul_of (integrable_Tj_weight j)
      (contDiff_pvG hs₁ hs₂ z).continuous.aestronglyMeasurable hM
  have hHψ : Integrable fun t => pvH f₁ f₂ z t * ((monoPsiA ((2 : ℝ) ^ j * t) : ℝ) : ℂ) :=
    (integrable_pvH hs₁ hc₁ hs₂ z).mul_bdd (c := 1)
      (Continuous.aestronglyMeasurable (by
        have := monoPsiA_contDiff.continuous
        fun_prop))
      (Eventually.of_forall fun t => by
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (monoPsiA_nonneg _)]
        exact monoPsiA_le_one _)
  have hodd : ∫ t, ((pvG f₁ f₂ z t * ((monoPsiA ((2 : ℝ) ^ j * t) / t : ℝ) : ℂ)) -
      pvH f₁ f₂ z t * ((monoPsiA ((2 : ℝ) ^ j * t) : ℝ) : ℂ)) = 0 := by
    have e : ∀ t, pvG f₁ f₂ z t * ((monoPsiA ((2 : ℝ) ^ j * t) / t : ℝ) : ℂ) -
        pvH f₁ f₂ z t * ((monoPsiA ((2 : ℝ) ^ j * t) : ℝ) : ℂ) =
        (Icc (-1 : ℝ) 1).indicator (fun _ => pvG f₁ f₂ z 0) t *
          ((monoPsiA ((2 : ℝ) ^ j * t) / t : ℝ) : ℂ) := by
      intro t
      simp only [pvH]
      push_cast
      ring
    simp_rw [e]
    refine integral_odd_eq_zero fun t => ?_
    rw [indicator_const_neg, mul_neg, monoPsiA_even, div_neg, Complex.ofReal_neg, mul_neg]
  rw [Tj_apply]
  have h := integral_sub hGw hHψ
  rw [hodd] at h
  exact (sub_eq_zero.1 h.symm).trans rfl

theorem sum_monoPsiA_zpow_mul_le_one (u : Finset ℤ) (t : ℝ) :
    ∑ j ∈ u, monoPsiA ((2 : ℝ) ^ j * t) ≤ 1 := by
  have e : ∀ j : ℤ, (2 : ℝ) ^ j * t = t / 2 ^ (-j) := fun j => by
    rw [div_eq_mul_inv, ← zpow_neg, neg_neg, mul_comm]
  simp_rw [e]
  rw [← Finset.sum_image (f := fun m : ℤ => monoPsiA (t / 2 ^ m))
    (fun a _ b _ h => neg_injective h)]
  exact sum_monoPsiA_le_one _ t

theorem hasSum_monoPsiA_zpow_mul {t : ℝ} (ht : t ≠ 0) :
    HasSum (fun j : ℤ => monoPsiA ((2 : ℝ) ^ j * t)) 1 := by
  have h := (Equiv.neg ℤ).hasSum_iff.2 (hasSum_monoPsiA ht)
  refine (congrArg (fun F : ℤ → ℝ => HasSum F 1) (funext fun j => ?_)).mpr h
  simp only [Function.comp, Equiv.neg_apply]
  rw [div_eq_mul_inv, ← zpow_neg, neg_neg, mul_comm]

/-- **`T = ∑_j T_j`**: `∑_j T_j(f₁,f₂)(z) = ∫ H` (absolutely: `∑_j ∫ |H| ψ(2^j·) ≤ ∫ |H|`). -/
theorem hasSum_Tj_integral_pvH (hs₁ : ContDiff ℝ ∞ f₁) (hc₁ : HasCompactSupport f₁)
    (hs₂ : ContDiff ℝ ∞ f₂) (z : ℝ × ℝ) :
    HasSum (fun j : ℤ => Tj j f₁ f₂ z) (∫ t, pvH f₁ f₂ z t) := by
  have hH := integrable_pvH hs₁ hc₁ hs₂ z
  have hint : ∀ j : ℤ, Integrable fun t => pvH f₁ f₂ z t * ((monoPsiA ((2 : ℝ) ^ j * t) : ℝ) : ℂ) :=
    fun j => hH.mul_bdd (c := 1)
      (Continuous.aestronglyMeasurable (by
        have := monoPsiA_contDiff.continuous
        fun_prop))
      (Eventually.of_forall fun t => by
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (monoPsiA_nonneg _)]
        exact monoPsiA_le_one _)
  have hnorm : ∀ j : ℤ, ∀ t, ‖pvH f₁ f₂ z t * ((monoPsiA ((2 : ℝ) ^ j * t) : ℝ) : ℂ)‖ =
      ‖pvH f₁ f₂ z t‖ * monoPsiA ((2 : ℝ) ^ j * t) := fun j t => by
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (monoPsiA_nonneg _)]
  have hsum : Summable fun j : ℤ =>
      ∫ t, ‖pvH f₁ f₂ z t * ((monoPsiA ((2 : ℝ) ^ j * t) : ℝ) : ℂ)‖ := by
    refine summable_of_sum_le (c := ∫ t, ‖pvH f₁ f₂ z t‖)
      (fun j => integral_nonneg fun _ => norm_nonneg _) fun u => ?_
    rw [← integral_finsetSum u fun j _ => (hint j).norm]
    refine integral_mono (integrable_finsetSum u fun j _ => (hint j).norm) hH.norm
      fun t => ?_
    simp only [hnorm]
    rw [← Finset.mul_sum]
    exact mul_le_of_le_one_right (norm_nonneg _) (sum_monoPsiA_zpow_mul_le_one u t)
  have h := hasSum_integral_of_summable_integral_norm hint hsum
  have e : ∀ t, ∑' j : ℤ, pvH f₁ f₂ z t * ((monoPsiA ((2 : ℝ) ^ j * t) : ℝ) : ℂ) =
      pvH f₁ f₂ z t := fun t => by
    rw [tsum_mul_left]
    rcases eq_or_ne t 0 with rfl | ht
    · rw [pvH_zero, zero_mul]
    · rw [(Complex.hasSum_ofReal.2 (hasSum_monoPsiA_zpow_mul ht)).tsum_eq, Complex.ofReal_one,
        mul_one]
  simp_rw [e] at h
  exact (congrArg (fun F : ℤ → ℂ => HasSum F _) (funext fun j =>
    Tj_eq_integral_pvH j hs₁ hc₁ hs₂ z)).mpr h

/-- The truncations: for `ε > 0`, `∫_{|t| > ε} G(t)/t dt = ∫_{|t| > ε} H`. -/
theorem truncation_eq (hs₁ : ContDiff ℝ ∞ f₁) (hc₁ : HasCompactSupport f₁)
    (hs₂ : ContDiff ℝ ∞ f₂) (z : ℝ × ℝ) {ε : ℝ} (hε : 0 < ε) :
    ∫ t in {t : ℝ | ε < |t|}, f₁ (z.1 + t, z.2) * f₂ (z.1, z.2 + t ^ 2) / t =
      ∫ t, {t : ℝ | ε < |t|}.indicator (pvH f₁ f₂ z) t := by
  have hS : MeasurableSet {t : ℝ | ε < |t|} := measurableSet_lt measurable_const measurable_abs
  have hSs : ∀ t : ℝ, -t ∈ {t : ℝ | ε < |t|} ↔ t ∈ {t : ℝ | ε < |t|} := fun t => by
    simp only [mem_setOf_eq, abs_neg]
  change ∫ t in {t : ℝ | ε < |t|}, pvG f₁ f₂ z t / t = _
  rw [← integral_indicator hS]
  have hG := integrable_pvG hs₁ hc₁ hs₂ z
  have h1 : Integrable ({t : ℝ | ε < |t|}.indicator fun t => pvG f₁ f₂ z t / t) := by
    refine (hG.norm.div_const ε).mono' ((((contDiff_pvG hs₁ hs₂ z).continuous.measurable.div
      Complex.measurable_ofReal)).indicator hS).aestronglyMeasurable
      (Eventually.of_forall fun t => ?_)
    by_cases ht : t ∈ {t : ℝ | ε < |t|}
    · rw [Set.indicator_of_mem ht, norm_div, Complex.norm_real, Real.norm_eq_abs]
      exact div_le_div_of_nonneg_left (norm_nonneg _) hε (le_of_lt ht)
    · rw [Set.indicator_of_notMem ht, norm_zero]
      exact div_nonneg (norm_nonneg _) hε.le
  have h2 : Integrable ({t : ℝ | ε < |t|}.indicator (pvH f₁ f₂ z)) :=
    (integrable_pvH hs₁ hc₁ hs₂ z).indicator hS
  have hodd : ∫ t, ({t : ℝ | ε < |t|}.indicator (fun t => pvG f₁ f₂ z t / t) t -
      {t : ℝ | ε < |t|}.indicator (pvH f₁ f₂ z) t) = 0 := by
    have e : ∀ t, {t : ℝ | ε < |t|}.indicator (fun t => pvG f₁ f₂ z t / t) t -
        {t : ℝ | ε < |t|}.indicator (pvH f₁ f₂ z) t = {t : ℝ | ε < |t|}.indicator
          (fun t => (Icc (-1 : ℝ) 1).indicator (fun _ => pvG f₁ f₂ z 0) t / t) t := by
      intro t
      by_cases ht : t ∈ {t : ℝ | ε < |t|}
      · rw [Set.indicator_of_mem ht, Set.indicator_of_mem ht, Set.indicator_of_mem ht, pvH,
          sub_div, sub_sub_cancel]
      · rw [Set.indicator_of_notMem ht, Set.indicator_of_notMem ht,
          Set.indicator_of_notMem ht, sub_zero]
    simp_rw [e]
    refine integral_odd_eq_zero fun t => indicator_neg_eq hSs (fun t => ?_) t
    rw [indicator_const_neg, Complex.ofReal_neg, div_neg]
  have h := integral_sub h1 h2
  rw [hodd] at h
  exact sub_eq_zero.1 h.symm

/-- **The principal value exists**: the truncations converge as `ε → 0⁺`. -/
theorem tendsto_truncation_integral_pvH (hs₁ : ContDiff ℝ ∞ f₁) (hc₁ : HasCompactSupport f₁)
    (hs₂ : ContDiff ℝ ∞ f₂) (z : ℝ × ℝ) :
    Tendsto (fun ε : ℝ =>
      ∫ t in {t : ℝ | ε < |t|}, f₁ (z.1 + t, z.2) * f₂ (z.1, z.2 + t ^ 2) / t)
      (𝓝[>] 0) (𝓝 (∫ t, pvH f₁ f₂ z t)) := by
  have hH := integrable_pvH hs₁ hc₁ hs₂ z
  have hlim : Tendsto (fun ε : ℝ => ∫ t, {t : ℝ | ε < |t|}.indicator (pvH f₁ f₂ z) t)
      (𝓝[>] 0) (𝓝 (∫ t, pvH f₁ f₂ z t)) := by
    refine tendsto_integral_filter_of_dominated_convergence (fun t => ‖pvH f₁ f₂ z t‖)
      (Eventually.of_forall fun ε => ((measurable_pvH hs₁ hs₂ z).indicator
        (measurableSet_lt measurable_const measurable_abs)).aestronglyMeasurable)
      (Eventually.of_forall fun ε => Eventually.of_forall fun t =>
        norm_indicator_le_norm_self _ _) hH.norm (Eventually.of_forall fun t => ?_)
    rcases eq_or_ne t 0 with rfl | ht
    · have e : ∀ ε : ℝ, {t : ℝ | ε < |t|}.indicator (pvH f₁ f₂ z) 0 = pvH f₁ f₂ z 0 :=
        fun ε => by
          by_cases h0 : (0 : ℝ) ∈ {t : ℝ | ε < |t|}
          · rw [Set.indicator_of_mem h0]
          · rw [Set.indicator_of_notMem h0, pvH_zero]
      simp_rw [e]
      exact tendsto_const_nhds
    · refine tendsto_const_nhds.congr' ?_
      filter_upwards [Ioo_mem_nhdsGT (abs_pos.2 ht)] with ε hε
      rw [Set.indicator_of_mem (show t ∈ {t : ℝ | ε < |t|} from hε.2)]
  refine hlim.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with ε hε
  exact (truncation_eq hs₁ hc₁ hs₂ z hε).symm

theorem pvT_eq_integral (hs₁ : ContDiff ℝ ∞ f₁) (hc₁ : HasCompactSupport f₁)
    (hs₂ : ContDiff ℝ ∞ f₂) (z : ℝ × ℝ) : pvT f₁ f₂ z = ∫ t, pvH f₁ f₂ z t :=
  (tendsto_truncation_integral_pvH hs₁ hc₁ hs₂ z).limUnder_eq

/-- **The principal value `eqn:thtc` exists** for test functions: the truncated integrals
`∫_{|t| > ε} f₁(z₁+t, z₂) f₂(z₁, z₂+t²) dt/t` converge to `T(f₁,f₂)(z)` as `ε → 0⁺`. -/
theorem tendsto_pvT (hs₁ : ContDiff ℝ ∞ f₁) (hc₁ : HasCompactSupport f₁)
    (hs₂ : ContDiff ℝ ∞ f₂) (z : ℝ × ℝ) :
    Tendsto (fun ε : ℝ =>
      ∫ t in {t : ℝ | ε < |t|}, f₁ (z.1 + t, z.2) * f₂ (z.1, z.2 + t ^ 2) / t)
      (𝓝[>] 0) (𝓝 (pvT f₁ f₂ z)) := by
  rw [pvT_eq_integral hs₁ hc₁ hs₂ z]
  exact tendsto_truncation_integral_pvH hs₁ hc₁ hs₂ z

/-- **`T = ∑_{j ∈ ℤ} T_j`** for test functions, pointwise (absolutely convergent). -/
theorem hasSum_Tj_pvT (hs₁ : ContDiff ℝ ∞ f₁) (hc₁ : HasCompactSupport f₁)
    (hs₂ : ContDiff ℝ ∞ f₂) (z : ℝ × ℝ) : HasSum (fun j : ℤ => Tj j f₁ f₂ z) (pvT f₁ f₂ z) := by
  rw [pvT_eq_integral hs₁ hc₁ hs₂ z]
  exact hasSum_Tj_integral_pvH hs₁ hc₁ hs₂ z

theorem pvT_eq_tsum (hs₁ : ContDiff ℝ ∞ f₁) (hc₁ : HasCompactSupport f₁)
    (hs₂ : ContDiff ℝ ∞ f₂) : pvT f₁ f₂ = fun z => ∑' j : ℤ, Tj j f₁ f₂ z :=
  funext fun z => (hasSum_Tj_pvT hs₁ hc₁ hs₂ z).tsum_eq.symm

theorem measurable_pvT (hs₁ : ContDiff ℝ ∞ f₁) (hc₁ : HasCompactSupport f₁)
    (hs₂ : ContDiff ℝ ∞ f₂) : Measurable (pvT f₁ f₂) := by
  rw [pvT_eq_tsum hs₁ hc₁ hs₂]
  exact Measurable.tsum fun j =>
    measurable_Tj j hs₁.continuous.measurable hs₂.continuous.measurable

theorem aestronglyMeasurable_pvT (hs₁ : ContDiff ℝ ∞ f₁) (hc₁ : HasCompactSupport f₁)
    (hs₂ : ContDiff ℝ ∞ f₂) : AEStronglyMeasurable (pvT f₁ f₂) :=
  (measurable_pvT hs₁ hc₁ hs₂).aestronglyMeasurable

end TestFunctions

end


section TheoremOne

open MeasureTheory Set Filter
open scoped ENNReal Topology ContDiff FourierTransform Real

noncomputable section

/-! ### Assembly of Theorem 1 (§2: Theorem 1 from Theorems 2 and 5) -/

namespace Assembly

/-- The high-frequency index set `𝔉_H`. -/
abbrev FH : Type := {k : ℤ × ℤ // 0 < max k.1 k.2 ∧ |k.1 - k.2| ≤ 100}

/-- The code `(max k - 1, k₁ - k₂ + 100)` of `k ∈ 𝔉_H`. -/
def fhCode (k : FH) : ℕ × Fin 201 :=
  ((max k.1.1 k.1.2 - 1).toNat, ⟨(k.1.1 - k.1.2 + 100).toNat, by
    have h := k.2.2; rw [abs_le] at h; omega⟩)

theorem fhCode_injective : Function.Injective fhCode := by
  rintro ⟨⟨a, b⟩, ha, hb⟩ ⟨⟨c, d⟩, hc, hd⟩ h
  simp only [fhCode, Prod.mk.injEq, Fin.mk.injEq] at h
  obtain ⟨h1, h2⟩ := h
  simp only at ha hb hc hd h1 h2
  rw [abs_le] at hb hd
  have e1 : max a b = max c d := by omega
  have e2 : a - b = c - d := by omega
  have : a = c ∧ b = d := by
    simp only [max_def] at e1; split_ifs at e1 <;> omega
  obtain ⟨rfl, rfl⟩ := this
  rfl

theorem two_rpow_max_eq (δ : ℝ) (k : FH) :
    (2 : ℝ) ^ (-δ * ((max k.1.1 k.1.2 : ℤ) : ℝ)) =
      (2 : ℝ) ^ (-δ) * ((2 : ℝ) ^ (-δ)) ^ (fhCode k).1 := by
  have hk := k.2.1
  have hm : ((max k.1.1 k.1.2 : ℤ) : ℝ) = 1 + (((max k.1.1 k.1.2 - 1).toNat : ℕ) : ℝ) := by
    have : ((max k.1.1 k.1.2 - 1).toNat : ℤ) = max k.1.1 k.1.2 - 1 := Int.toNat_of_nonneg (by omega)
    have h' : (((max k.1.1 k.1.2 - 1).toNat : ℕ) : ℝ) = ((max k.1.1 k.1.2 : ℤ) : ℝ) - 1 := by
      rw [← Int.cast_natCast, this]; push_cast; ring
    rw [h']; ring
  rw [hm, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num), ← Real.rpow_add (by norm_num)]
  simp only [fhCode]; ring_nf

theorem tsum_FH_le {δ : ℝ} (hδ : 0 < δ) :
    ∑' k : FH, ENNReal.ofReal ((2 : ℝ) ^ (-δ * ((max k.1.1 k.1.2 : ℤ) : ℝ))) ≤
      ENNReal.ofReal (201 * (1 - (2 : ℝ) ^ (-δ))⁻¹) := by
  set ρ : ℝ := (2 : ℝ) ^ (-δ) with hρ
  have hρ0 : 0 < ρ := by positivity
  have hρ1 : ρ < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  calc ∑' k : FH, ENNReal.ofReal ((2 : ℝ) ^ (-δ * ((max k.1.1 k.1.2 : ℤ) : ℝ)))
      = ∑' k : FH, (fun n : ℕ × Fin 201 => ENNReal.ofReal (ρ * ρ ^ n.1)) (fhCode k) := by
        congr 1; funext k; rw [two_rpow_max_eq]
    _ ≤ ∑' n : ℕ × Fin 201, ENNReal.ofReal (ρ * ρ ^ n.1) :=
        ENNReal.tsum_comp_le_tsum_of_injective fhCode_injective _
    _ = ∑' n : ℕ, ∑' _ : Fin 201, ENNReal.ofReal (ρ * ρ ^ n) :=
        ENNReal.tsum_prod (f := fun (n : ℕ) (_ : Fin 201) => ENNReal.ofReal (ρ * ρ ^ n))
    _ = ∑' n : ℕ, 201 * ENNReal.ofReal ρ * ENNReal.ofReal ρ ^ n := by
        congr 1; funext n
        rw [tsum_fintype, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
          ENNReal.ofReal_mul hρ0.le, ENNReal.ofReal_pow hρ0.le]
        push_cast; ring
    _ = 201 * ENNReal.ofReal ρ * (1 - ENNReal.ofReal ρ)⁻¹ := by
        rw [ENNReal.tsum_mul_left, ENNReal.tsum_geometric]
    _ ≤ ENNReal.ofReal (201 * (1 - ρ)⁻¹) := by
        rw [← ENNReal.ofReal_one, ← ENNReal.ofReal_sub _ hρ0.le,
          ← ENNReal.ofReal_inv_of_pos (by linarith), ENNReal.ofReal_mul (by norm_num)]
        calc (201 : ℝ≥0∞) * ENNReal.ofReal ρ * ENNReal.ofReal (1 - ρ)⁻¹
            ≤ 201 * 1 * ENNReal.ofReal (1 - ρ)⁻¹ := by
              gcongr; exact ENNReal.ofReal_le_one.2 hρ1.le
          _ = _ := by rw [mul_one]; norm_num

noncomputable instance : Encodable FH := by
  classical
  unfold FH; exact Subtype.encodable

instance : Infinite FH :=
  Infinite.of_injective (fun n : ℕ => (⟨((n : ℤ) + 1, (n : ℤ) + 1), by simp⟩ : FH))
    (fun a b h => by simpa using congrArg (fun k : FH => k.1.1) h)

noncomputable instance : Denumerable FH := Denumerable.ofEncodableOfInfinite FH

theorem measurable_TkF (k₁ k₂ : ℤ) (F : Finset ℤ) {f₁ f₂ : ℝ × ℝ → ℂ} (h₁ : Measurable f₁)
    (h₂ : Measurable f₂) : Measurable (TkF k₁ k₂ F f₁ f₂) := by
  unfold TkF
  have := Finset.measurable_sum F fun j _ =>
    measurable_Tj j (measurable_lpD 0 (j + k₁) h₁) (measurable_lpD 1 (2 * j + k₂) h₂)
  convert this using 1; ext z; simp [Finset.sum_apply]

/-- The high-frequency part `T^H = ∑_{k ∈ 𝔉_H} T^{(k)}` (`§2.3`, summation over `k`). -/
theorem high_bound {p q r : ℝ} (hp : 1 < p) (hq : 1 < q) (hr : 1 ≤ r)
    (hpqr : 1 / p + 1 / q = 1 / r) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (F : Finset ℤ) {f₁ f₂ : ℝ × ℝ → ℂ}, Measurable f₁ → Measurable f₂ →
      Integrable f₁ → Integrable f₂ → ∀ {A B : ℝ}, (∀ z, ‖f₁ z‖ ≤ A) → (∀ z, ‖f₂ z‖ ≤ B) →
      eLpNorm (fun z => ∑' k : FH, TkF k.1.1 k.1.2 F f₁ f₂ z) (ENNReal.ofReal r) volume ≤
        ENNReal.ofReal C * eLpNorm f₁ (ENNReal.ofReal p) volume *
          eLpNorm f₂ (ENNReal.ofReal q) volume := by
  obtain ⟨C, δ, hC, hδ, hT⟩ := TkF_decay hp hq hr hpqr
  refine ⟨C * (201 * (1 - (2 : ℝ) ^ (-δ))⁻¹), ?_, fun F f₁ f₂ h₁ h₂ i₁ i₂ A B hA hB => ?_⟩
  · have : (2 : ℝ) ^ (-δ) < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
    have : 0 < 1 - (2 : ℝ) ^ (-δ) := by linarith
    positivity
  have hr1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal r := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hr
  set X := eLpNorm f₁ (ENNReal.ofReal p) volume * eLpNorm f₂ (ENNReal.ofReal q) volume
  calc eLpNorm (fun z => ∑' k : FH, TkF k.1.1 k.1.2 F f₁ f₂ z) (ENNReal.ofReal r) volume
      ≤ eLpNorm (fun z => ∑' k : FH, ‖TkF k.1.1 k.1.2 F f₁ f₂ z‖ₑ) (ENNReal.ofReal r) volume :=
        eLpNorm_mono_enorm fun z => by
          simpa using (enorm_tsum_le_tsum_enorm (f := fun k : FH => TkF k.1.1 k.1.2 F f₁ f₂ z))
    _ ≤ ∑' k : FH, eLpNorm (fun z => ‖TkF k.1.1 k.1.2 F f₁ f₂ z‖ₑ) (ENNReal.ofReal r) volume :=
        eLpNorm_tsum_le (fun k => (measurable_TkF _ _ F h₁ h₂).enorm) hr1 ENNReal.ofReal_ne_top
    _ ≤ ∑' k : FH, ENNReal.ofReal ((2 : ℝ) ^ (-δ * ((max k.1.1 k.1.2 : ℤ) : ℝ))) *
          (ENNReal.ofReal C * X) := by
        refine ENNReal.tsum_le_tsum fun k => ?_
        rw [eLpNorm_enorm]
        refine (hT k.1.1 k.1.2 k.2.1 k.2.2 F h₁ h₂ i₁ i₂ hA hB).trans (le_of_eq ?_)
        rw [ENNReal.ofReal_mul hC.le]; simp only [X]; ring
    _ = (∑' k : FH, ENNReal.ofReal ((2 : ℝ) ^ (-δ * ((max k.1.1 k.1.2 : ℤ) : ℝ)))) *
          (ENNReal.ofReal C * X) := ENNReal.tsum_mul_right
    _ ≤ ENNReal.ofReal (201 * (1 - (2 : ℝ) ^ (-δ))⁻¹) * (ENNReal.ofReal C * X) := by
        gcongr; exact tsum_FH_le hδ
    _ = _ := by
        rw [ENNReal.ofReal_mul hC.le]; simp only [X]; ring

/-- Theorem 2 applied to the symbols of `T^L` and `T^M = I + II` (§2.4, §2.5), uniformly in the
finite range of scales. -/
theorem symSum_bound {ν : ℝ × ℝ → ℂ}
    (hν : ∀ N : ℕ, ∃ C, ∀ F : Finset ℤ, IsAnisoSymbol 1 2 N C (symSum ν F))
    {p q r : ℝ} (hp : 1 < p) (hq : 1 < q) (hr : 1 / 2 < r) (hr2 : r < 2)
    (hpqr : 1 / p + 1 / q = 1 / r) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (F : Finset ℤ) (f₁ f₂ : ℝ × ℝ → ℂ), ContDiff ℝ ∞ f₁ →
      HasCompactSupport f₁ → ContDiff ℝ ∞ f₂ → HasCompactSupport f₂ →
      eLpNorm (Tm (symSum ν F) f₁ f₂) (ENNReal.ofReal r) volume ≤
        ENNReal.ofReal C * eLpNorm f₁ (ENNReal.ofReal p) volume *
          eLpNorm f₂ (ENNReal.ofReal q) volume := by
  obtain ⟨N₁, hT⟩ := thm_anisotp (α := 1) (β := 2) (by norm_num) (by norm_num)
  obtain ⟨C₀, hC₀⟩ := hν N₁
  obtain ⟨C, hC, hb⟩ := hT C₀ p q r hp hq hr hr2 hpqr
  exact ⟨C, hC, fun F f₁ f₂ h₁ h₁c h₂ h₂c => hb _ (hC₀ F) f₁ f₂ h₁ h₁c h₂ h₂c⟩

theorem measurable_fourier_fib0 {f : ℝ × ℝ → ℂ} (hf : Continuous f) :
    Measurable fun q : ℝ × ℝ => 𝓕 (fun x => f (x, q.1)) q.2 := by
  have e : (fun q : ℝ × ℝ => 𝓕 (fun x => f (x, q.1)) q.2) = fun q => ∫ v : ℝ,
      Complex.exp (↑(-2 * π * v * q.2) * Complex.I) • f (v, q.1) := by
    funext q; exact Real.fourier_real_eq_integral_exp_smul _ _
  rw [e]
  have : Measurable fun w : (ℝ × ℝ) × ℝ =>
      Complex.exp (↑(-2 * π * w.2 * w.1.2) * Complex.I) • f (w.2, w.1.1) := by
    apply Continuous.measurable; fun_prop
  exact this.stronglyMeasurable.integral_prod_right'.measurable

theorem measurable_tmPhase {f₁ f₂ : ℝ × ℝ → ℂ} (h₁ : Continuous f₁) (h₂ : Continuous f₂) :
    Measurable fun w : (ℝ × ℝ) × (ℝ × ℝ) => tmPhase f₁ f₂ w.1 w.2 := by
  have hF₁ := measurable_fourier_fib0 h₁
  have hf₂' : Continuous fun z : ℝ × ℝ => f₂ (z.2, z.1) := h₂.comp (by fun_prop)
  have hF₂ := measurable_fourier_fib0 hf₂'
  unfold tmPhase
  refine ((hF₁.comp (measurable_fst.snd.prodMk measurable_snd.fst)).mul
    (hF₂.comp (measurable_fst.fst.prodMk measurable_snd.snd))).mul ?_
  apply Continuous.measurable; fun_prop

theorem aestronglyMeasurable_Tm {m : ℝ × ℝ → ℂ} (hm : Measurable m) {C : ℝ}
    (hC : ∀ w, ‖m w‖ ≤ C) {f₁ f₂ : ℝ × ℝ → ℂ} (hs₁ : ContDiff ℝ ∞ f₁)
    (hc₁ : HasCompactSupport f₁) (hs₂ : ContDiff ℝ ∞ f₂) (hc₂ : HasCompactSupport f₂) :
    AEStronglyMeasurable (Tm m f₁ f₂) volume := by
  have e : Tm m f₁ f₂ = fun z => ∫ p, m (-p.1, -p.2) * tmPhase f₁ f₂ z p := by
    funext z; exact Tm_eq_integral hm hC (integrable_tmPhase_of_test hs₁ hc₁ hs₂ hc₂ z)
  rw [e]
  have : Measurable fun w : (ℝ × ℝ) × (ℝ × ℝ) => m (-w.2.1, -w.2.2) * tmPhase f₁ f₂ w.1 w.2 :=
    (hm.comp (measurable_neg_pair.comp measurable_snd)).mul
      (measurable_tmPhase hs₁.continuous hs₂.continuous)
  exact this.stronglyMeasurable.integral_prod_right'.aestronglyMeasurable

theorem measurable_symSum {ν : ℝ × ℝ → ℂ} (hν : Measurable ν) (F : Finset ℤ) :
    Measurable (symSum ν F) := by
  unfold symSum
  exact Finset.measurable_sum F fun j _ => hν.comp
    ((measurable_fst.div_const _).neg.prodMk (measurable_snd.div_const _).neg)

theorem norm_symSum_le {ν : ℝ × ℝ → ℂ} {B : ℝ} (hν : ∀ w, ‖ν w‖ ≤ B) (F : Finset ℤ)
    (w : ℝ × ℝ) : ‖symSum ν F w‖ ≤ F.card * B := by
  unfold symSum
  refine (norm_sum_le _ _).trans ?_
  calc ∑ j ∈ F, ‖ν (-(w.1 / 2 ^ j), -(w.2 / 4 ^ j))‖ ≤ ∑ _j ∈ F, B :=
        Finset.sum_le_sum fun j _ => hν _
    _ = F.card * B := by rw [Finset.sum_const, nsmul_eq_mul]

theorem aesm_Tm_symSum {ν : ℝ × ℝ → ℂ} (hν : Measurable ν) {B : ℝ} (hB : ∀ w, ‖ν w‖ ≤ B)
    (F : Finset ℤ) {f₁ f₂ : ℝ × ℝ → ℂ} (hs₁ : ContDiff ℝ ∞ f₁) (hc₁ : HasCompactSupport f₁)
    (hs₂ : ContDiff ℝ ∞ f₂) (hc₂ : HasCompactSupport f₂) :
    AEStronglyMeasurable (Tm (symSum ν F) f₁ f₂) volume :=
  aestronglyMeasurable_Tm (measurable_symSum hν F) (norm_symSum_le hB F) hs₁ hc₁ hs₂ hc₂

theorem test_bdd' {f : ℝ × ℝ → ℂ} (h : ContDiff ℝ ∞ f) (hc : HasCompactSupport f) :
    ∃ M, ∀ z, ‖f z‖ ≤ M := by
  obtain ⟨M, hM⟩ := h.continuous.bounded_above_of_compact_support hc
  exact ⟨M, hM⟩

/-- The bound for the truncated sums `∑_{|j| ≤ J} T_j`. -/
theorem partial_bound {p q r : ℝ} (hp : 1 < p) (hq : 1 < q) (hr : 1 ≤ r) (hr2 : r < 2)
    (hpqr : 1 / p + 1 / q = 1 / r) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (F : Finset ℤ) (f₁ f₂ : ℝ × ℝ → ℂ), ContDiff ℝ ∞ f₁ →
      HasCompactSupport f₁ → ContDiff ℝ ∞ f₂ → HasCompactSupport f₂ →
      eLpNorm (fun z => ∑ j ∈ F, Tj j f₁ f₂ z) (ENNReal.ofReal r) volume ≤
        ENNReal.ofReal C * eLpNorm f₁ (ENNReal.ofReal p) volume *
          eLpNorm f₂ (ENNReal.ofReal q) volume := by
  have hr' : 1 / 2 < r := by linarith
  obtain ⟨CL, hCL, hL⟩ := symSum_bound lowNu_isAnisoSymbol hp hq hr' hr2 hpqr
  obtain ⟨CI, hCI, hI⟩ := symSum_bound mixNuI_isAnisoSymbol hp hq hr' hr2 hpqr
  obtain ⟨CJ, hCJ, hJ⟩ := symSum_bound mixNuII_isAnisoSymbol hp hq hr' hr2 hpqr
  obtain ⟨CH, hCH, hH⟩ := high_bound hp hq hr hpqr
  refine ⟨CL + CI + CJ + CH, by positivity, fun F f₁ f₂ hs₁ hc₁ hs₂ hc₂ => ?_⟩
  have hr1 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal r := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hr
  have h₁ := hs₁.continuous.measurable
  have h₂ := hs₂.continuous.measurable
  obtain ⟨A, hA⟩ := test_bdd' hs₁ hc₁
  obtain ⟨B, hB⟩ := test_bdd' hs₂ hc₂
  have i₁ : Integrable f₁ volume := hs₁.continuous.integrable_of_hasCompactSupport hc₁
  have i₂ : Integrable f₂ volume := hs₂.continuous.integrable_of_hasCompactSupport hc₂
  set L := Tm (symSum lowNu F) f₁ f₂
  set I := Tm (symSum mixNuI F) f₁ f₂
  set J := Tm (symSum mixNuII F) f₁ f₂
  set H : ℝ × ℝ → ℂ := fun z => ∑' k : FH, TkF k.1.1 k.1.2 F f₁ f₂ z
  have hdec : (fun z => ∑ j ∈ F, Tj j f₁ f₂ z) = fun z => L z + I z + J z + H z := by
    funext z; rw [sum_Tj_decomp F hs₁ hc₁ hs₂ hc₂ z]; simp only [H, TkF, Finset.sum_apply]; rfl
  have mL : AEStronglyMeasurable L volume :=
    aesm_Tm_symSum continuous_lowNu.measurable norm_lowNu_le F hs₁ hc₁ hs₂ hc₂
  have mI : AEStronglyMeasurable I volume :=
    aesm_Tm_symSum measurable_mixNuI norm_mixNuI_le F hs₁ hc₁ hs₂ hc₂
  have mJ : AEStronglyMeasurable J volume :=
    aesm_Tm_symSum measurable_mixNuII norm_mixNuII_le F hs₁ hc₁ hs₂ hc₂
  have mH : AEStronglyMeasurable H volume :=
    (Measurable.tsum fun k => measurable_TkF _ _ F h₁ h₂).aestronglyMeasurable
  set X := eLpNorm f₁ (ENNReal.ofReal p) volume * eLpNorm f₂ (ENNReal.ofReal q) volume
  rw [hdec]
  calc eLpNorm (fun z => L z + I z + J z + H z) (ENNReal.ofReal r) volume
      ≤ eLpNorm L (ENNReal.ofReal r) volume + eLpNorm I (ENNReal.ofReal r) volume +
          eLpNorm J (ENNReal.ofReal r) volume + eLpNorm H (ENNReal.ofReal r) volume := by
        refine (eLpNorm_add_le ((mL.add mI).add mJ) mH hr1).trans ?_
        gcongr
        refine (eLpNorm_add_le (mL.add mI) mJ hr1).trans ?_
        gcongr
        exact eLpNorm_add_le mL mI hr1
    _ ≤ ENNReal.ofReal CL * X + ENNReal.ofReal CI * X + ENNReal.ofReal CJ * X +
          ENNReal.ofReal CH * X := by
        gcongr
        · exact (hL F f₁ f₂ hs₁ hc₁ hs₂ hc₂).trans_eq (by simp only [X]; ring)
        · exact (hI F f₁ f₂ hs₁ hc₁ hs₂ hc₂).trans_eq (by simp only [X]; ring)
        · exact (hJ F f₁ f₂ hs₁ hc₁ hs₂ hc₂).trans_eq (by simp only [X]; ring)
        · exact (hH F h₁ h₂ i₁ i₂ hA hB).trans_eq (by simp only [X]; ring)
    _ = _ := by
        rw [ENNReal.ofReal_add (by positivity) hCH, ENNReal.ofReal_add (by positivity) hCJ,
          ENNReal.ofReal_add hCL hCI]
        simp only [X]; ring

end Assembly

open Assembly in
/-- **Theorem 1** (`thm:singint`): for `p, q ∈ (1, ∞)`, `r ∈ [1, 2)` with `1/p + 1/q = 1/r`,
the triangular Hilbert transform with curvature
`T(f₁, f₂)(x, y) = p.v. ∫ f₁(x + t, y) f₂(x, y + t²) dt/t` satisfies
`‖T(f₁, f₂)‖_r ≤ C ‖f₁‖_p ‖f₂‖_q` for test functions (hence extends to a bounded operator
`L^p × L^q → L^r`). The principal value exists for test functions (`tendsto_pvT`). -/
theorem thm_singint {p q r : ℝ} (hp : 1 < p) (hq : 1 < q) (hr : 1 ≤ r) (hr2 : r < 2)
    (hpqr : 1 / p + 1 / q = 1 / r) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ f₁ f₂ : ℝ × ℝ → ℂ, ContDiff ℝ ∞ f₁ → HasCompactSupport f₁ →
      ContDiff ℝ ∞ f₂ → HasCompactSupport f₂ →
      eLpNorm (pvT f₁ f₂) (ENNReal.ofReal r) volume ≤
        ENNReal.ofReal C * eLpNorm f₁ (ENNReal.ofReal p) volume *
          eLpNorm f₂ (ENNReal.ofReal q) volume := by
  obtain ⟨C, hC, hb⟩ := partial_bound hp hq hr hr2 hpqr
  refine ⟨C, hC, fun f₁ f₂ hs₁ hc₁ hs₂ hc₂ => ?_⟩
  have hmono : Monotone fun J : ℕ => Finset.Icc (-(J : ℤ)) J := fun a b hab =>
    Finset.Icc_subset_Icc (by simp; omega) (by simp; omega)
  have hcov : ∀ j : ℤ, ∃ J : ℕ, j ∈ Finset.Icc (-(J : ℤ)) J := fun j =>
    ⟨j.natAbs, Finset.mem_Icc.2 ⟨by omega, by omega⟩⟩
  have hlim := Lp.eLpNorm_lim_le_liminf_eLpNorm (p := ENNReal.ofReal r) (μ := volume)
    (f := fun (J : ℕ) z => ∑ j ∈ Finset.Icc (-(J : ℤ)) J, Tj j f₁ f₂ z)
    (fun J => (Finset.measurable_sum _ fun j _ => measurable_Tj j hs₁.continuous.measurable
      hs₂.continuous.measurable).aestronglyMeasurable) (pvT f₁ f₂)
    (Eventually.of_forall fun z =>
      (hasSum_Tj_pvT hs₁ hc₁ hs₂ z).comp (tendsto_atTop_finset_of_monotone hmono hcov))
  refine hlim.trans ?_
  exact Filter.liminf_le_of_frequently_le' (Frequently.of_forall fun J =>
    hb _ f₁ f₂ hs₁ hc₁ hs₂ hc₂)


end

