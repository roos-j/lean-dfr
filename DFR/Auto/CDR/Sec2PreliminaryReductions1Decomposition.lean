/-- `ψ(a/2^m) = φ(a/2^m) - φ(a/2^{m-1})`. -/
theorem monoPsiA_div_zpow (a : ℝ) (m : ℤ) :
    monoPsiA (a / 2 ^ m) = monoPhi (a / 2 ^ m) - monoPhi (a / 2 ^ (m - 1)) := by
  rw [monoPsiA]
  congr 2
  rw [zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_one]
  field_simp

/-- Telescoping on `ℤ`: if `Φ` vanishes on `(-∞, lo]`, then
`∑_{m ≤ n} (Φ m - Φ (m - 1)) = Φ n`. -/
theorem hasSum_telescope_le {Φ : ℤ → ℝ} {lo : ℤ} (hlo : ∀ m ≤ lo, Φ m = 0) (n : ℤ) :
    HasSum (fun m : ℤ => if m ≤ n then Φ m - Φ (m - 1) else 0) (Φ n) := by
  have hfin : ∀ K : ℕ, ∑ i ∈ Finset.range K, (Φ (n - i) - Φ (n - i - 1)) =
      Φ n - Φ (n - K) := by
    intro K
    induction K with
    | zero => simp
    | succ K ih =>
      rw [Finset.sum_range_succ, ih]
      push_cast
      ring_nf
  have hinj : Set.InjOn (fun i : ℕ => n - (i : ℤ)) ↑(Finset.range (n - lo).toNat) := by
    intro i _ i' _ h
    simp only at h
    omega
  have hS := hasSum_sum_of_ne_finset_zero
    (f := fun m : ℤ => if m ≤ n then Φ m - Φ (m - 1) else 0)
    (s := (Finset.range (n - lo).toNat).image (fun i : ℕ => n - (i : ℤ)))
    (L := SummationFilter.unconditional ℤ) ?_
  · convert hS using 1
    rw [Finset.sum_image hinj]
    have e : ∀ i ∈ Finset.range (n - lo).toNat,
        (if n - (i : ℤ) ≤ n then Φ (n - i) - Φ (n - i - 1) else 0) =
          Φ (n - i) - Φ (n - i - 1) := fun i _ => if_pos (by omega)
    rw [Finset.sum_congr rfl e, hfin, hlo (n - ((n - lo).toNat : ℕ)) (by omega), sub_zero]
  · intro m hm
    by_cases h : m ≤ n
    · rw [if_pos h]
      by_cases hl : m ≤ lo
      · rw [hlo m hl, hlo (m - 1) (by omega), sub_zero]
      · exact absurd (Finset.mem_image.2 ⟨(n - m).toNat, Finset.mem_range.2 (by omega),
          by omega⟩) hm
    · rw [if_neg h]

/-- The scale of a nonzero `a`: `φ(a/2^m)` vanishes for `m ≤ n₀ - 1` and is `1` for
`m ≥ n₀ + 1`. -/
theorem exists_monoPhi_scale {a : ℝ} (ha : a ≠ 0) : ∃ n₀ : ℤ,
    (∀ m ≤ n₀ - 1, monoPhi (a / 2 ^ m) = 0) ∧ (∀ m, n₀ + 1 ≤ m → monoPhi (a / 2 ^ m) = 1) := by
  obtain ⟨n₀, h1, h2⟩ := exists_mem_Ico_zpow (abs_pos.2 ha) (by norm_num : (1 : ℝ) < 2)
  refine ⟨n₀, fun m hm => monoPhi_eq_zero ?_, fun m hm => monoPhi_eq_one ?_⟩
  · rw [abs_div, abs_of_pos (by positivity : (0 : ℝ) < 2 ^ m), le_div_iff₀ (by positivity)]
    calc 2 * 2 ^ m ≤ 2 * (2 : ℝ) ^ (n₀ - 1) := by
          gcongr
          · norm_num
      _ = 2 ^ n₀ := by rw [zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_one]; field_simp
      _ ≤ |a| := h1
  · rw [abs_div, abs_of_pos (by positivity : (0 : ℝ) < 2 ^ m), div_le_one (by positivity)]
    exact h2.le.trans (zpow_le_zpow_right₀ (by norm_num) hm)

/-- `∑_{m ≤ n} ψ(a/2^m) = φ(a/2^n)` for `a ≠ 0`. -/
theorem hasSum_monoPsiA_le {a : ℝ} (ha : a ≠ 0) (n : ℤ) :
    HasSum (fun m : ℤ => if m ≤ n then monoPsiA (a / 2 ^ m) else 0) (monoPhi (a / 2 ^ n)) := by
  obtain ⟨n₀, h0, -⟩ := exists_monoPhi_scale ha
  simp_rw [monoPsiA_div_zpow]
  exact hasSum_telescope_le (Φ := fun m => monoPhi (a / 2 ^ m)) (lo := n₀ - 1) h0 n

/-- `∑_{m ∈ ℤ} ψ(a/2^m) = 1` for `a ≠ 0`. -/
theorem hasSum_monoPsiA {a : ℝ} (ha : a ≠ 0) : HasSum (fun m : ℤ => monoPsiA (a / 2 ^ m)) 1 := by
  obtain ⟨n₀, -, h1⟩ := exists_monoPhi_scale ha
  have h := hasSum_monoPsiA_le ha (n₀ + 1)
  rw [h1 _ le_rfl] at h
  convert h using 2 with m
  split_ifs with hm
  · rfl
  · rw [monoPsiA_div_zpow, h1 m (by omega), h1 (m - 1) (by omega), sub_self]

/-- A function on `ℤ` vanishing on `(-∞, 0]` has the same sum as its restriction to `ℕ + 1`. -/
theorem hasSum_int_iff_nat_succ {M : Type*} [AddCommMonoid M] [TopologicalSpace M]
    {f : ℤ → M} (hf : ∀ m ≤ 0, f m = 0) {s : M} :
    HasSum (fun k : ℕ => f ((k : ℤ) + 1)) s ↔ HasSum f s := by
  have hg : Function.Injective (fun k : ℕ => (k : ℤ) + 1) := fun a b h => by
    simp only [add_left_inj, Nat.cast_inj] at h; exact h
  refine hg.hasSum_iff fun x hx => hf x ?_
  by_contra h
  exact hx ⟨(x - 1).toNat, by simp only; omega⟩

theorem two_zpow_natCast_add_one (k : ℕ) : (2 : ℝ) ^ ((k : ℤ) + 1) = 2 ^ (k + 1) := by
  rw [← zpow_natCast]; push_cast; rfl

/-- `φ(a) + ∑_{k ≥ 0} ψ(a/2^{k+1}) = 1`, for every `a`. -/
theorem hasSum_monoPsiA_succ (a : ℝ) :
    HasSum (fun k : ℕ => monoPsiA (a / 2 ^ (k + 1))) (1 - monoPhi a) := by
  rcases eq_or_ne a 0 with rfl | ha
