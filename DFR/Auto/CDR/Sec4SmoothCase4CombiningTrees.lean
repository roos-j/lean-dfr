/-! ### The ancestor order -/

/-- `Q ⊆ R` in the dyadic sense: `R` is an ancestor of `Q`. -/
def IsAnc (α β : ℕ) (Q R : DyRect) : Prop := ∃ i : ℕ, DyRect.anc α β i Q = R

theorem isAnc_refl (Q : DyRect) : IsAnc α β Q Q := ⟨0, rfl⟩

