/-! ### Sizes along ancestor chains -/

theorem Msize_le {s : Finset DyRect} {f : ℝ × ℝ → ℝ} {a : ℝ} (h : ∀ Q ∈ s, sizeQ α β f Q ≤ a)
    (ha : 0 ≤ a) : Msize α β s f ≤ a :=
  Real.iSup_le (fun Q => h Q Q.2) ha

theorem Msize_mono {s t : Finset DyRect} (hst : s ⊆ t) (f : ℝ × ℝ → ℝ) :
    Msize α β s f ≤ Msize α β t f :=
  Msize_le (fun _ hQ => sizeQ_le_Msize α β f (hst hQ)) (Msize_nonneg α β t f)

open Classical in
/-- The ancestors of `Q` in `𝒬`. -/
def ancs (α β : ℕ) (𝒬 : Finset DyRect) (Q : DyRect) : Finset DyRect := 𝒬.filter (IsAnc α β Q)

/-- `sup_{𝒬 ∋ Q' ⊇ Q} 𝓜_{\{Q'\}}(f)`. -/
def supSize (α β : ℕ) (𝒬 : Finset DyRect) (f : ℝ × ℝ → ℝ) (Q : DyRect) : ℝ :=
  Msize α β (ancs α β 𝒬 Q) f

theorem supSize_anti {𝒬 : Finset DyRect} (f : ℝ × ℝ → ℝ) {Q R : DyRect} (h : IsAnc α β Q R) :
    supSize α β 𝒬 f R ≤ supSize α β 𝒬 f Q := by
  refine Msize_mono (fun Q' hQ' => ?_) f
  simp only [ancs, Finset.mem_filter] at hQ' ⊢
  exact ⟨hQ'.1, h.trans hQ'.2⟩

theorem sizeQ_le_supSize {𝒬 : Finset DyRect} (f : ℝ × ℝ → ℝ) {Q : DyRect} (hQ : Q ∈ 𝒬) :
    sizeQ α β f Q ≤ supSize α β 𝒬 f Q := by
  classical
  exact sizeQ_le_Msize α β f (Finset.mem_filter.2 ⟨hQ, isAnc_refl Q⟩)

theorem supSize_nonneg (𝒬 : Finset DyRect) (f : ℝ × ℝ → ℝ) (Q : DyRect) :
    0 ≤ supSize α β 𝒬 f Q :=
  Msize_nonneg α β _ f

/-! ### Dyadic bands -/

/-- The integer `n` with `2^{n-1} < x ≤ 2^n`. -/
def band (x : ℝ) : ℤ := ⌈Real.logb 2 x⌉

theorem le_two_zpow_band {x : ℝ} (hx : 0 < x) : x ≤ (2 : ℝ) ^ band x := by
  conv_lhs => rw [← Real.rpow_logb (by norm_num : (0 : ℝ) < 2) (by norm_num) hx]
  rw [← Real.rpow_intCast]
  exact Real.rpow_le_rpow_of_exponent_le (by norm_num) (Int.le_ceil _)

theorem two_zpow_band_lt {x : ℝ} (hx : 0 < x) : (2 : ℝ) ^ (band x - 1) < x := by
  conv_rhs => rw [← Real.rpow_logb (by norm_num : (0 : ℝ) < 2) (by norm_num) hx]
  rw [← Real.rpow_intCast]
  refine Real.rpow_lt_rpow_of_exponent_lt (by norm_num) ?_
  have := Int.ceil_lt_add_one (Real.logb 2 x)
  push_cast [band]
  linarith

theorem band_mono {x y : ℝ} (hx : 0 < x) (h : x ≤ y) : band x ≤ band y :=
  Int.ceil_mono (Real.logb_le_logb_of_le (by norm_num) hx h)

theorem two_zpow_band_le {x : ℝ} (hx : 0 < x) : (2 : ℝ) ^ band x ≤ 2 * x := by
  have := two_zpow_band_lt hx
  rw [zpow_sub_one₀ (by norm_num)] at this
  linarith

/-! ### The trees -/

section trees

variable (α β) (𝒬 : Finset DyRect) (F : Fin 3 → ℝ × ℝ → ℝ)

open Classical in
/-- The rectangles with all three sizes `S_j(Q)` positive. -/
def posColl : Finset DyRect := 𝒬.filter fun Q => ∀ k, 0 < supSize α β 𝒬 (F k) Q

/-- The band vector `𝐧(Q)`, `2^{n_j - 1} < S_j(Q) ≤ 2^{n_j}`. -/
def idx (Q : DyRect) : Fin 3 → ℤ := fun k => band (supSize α β 𝒬 (F k) Q)

open Classical in
/-- The tree `𝒯_R = {Q ∈ 𝒫_𝐧 : Q ⊆ R}`, `𝐧 = 𝐧(R)`. -/
def treeOf (R : DyRect) : Finset DyRect :=
  (posColl α β 𝒬 F).filter fun Q => IsAnc α β Q R ∧ idx α β 𝒬 F Q = idx α β 𝒬 F R

open Classical in
/-- The maximal rectangles `⋃_𝐧 𝒫_𝐧^max`. -/
def roots : Finset DyRect :=
  (posColl α β 𝒬 F).filter fun R => ∀ R' ∈ posColl α β 𝒬 F, IsAnc α β R R' →
    idx α β 𝒬 F R' = idx α β 𝒬 F R → R' = R

variable {α β 𝒬 F}

theorem mem_posColl {Q : DyRect} :
    Q ∈ posColl α β 𝒬 F ↔ Q ∈ 𝒬 ∧ ∀ k, 0 < supSize α β 𝒬 (F k) Q := by
  classical
  exact Finset.mem_filter

theorem mem_treeOf {Q R : DyRect} : Q ∈ treeOf α β 𝒬 F R ↔
    Q ∈ posColl α β 𝒬 F ∧ IsAnc α β Q R ∧ idx α β 𝒬 F Q = idx α β 𝒬 F R := by
  simp only [treeOf, Finset.mem_filter]

theorem mem_roots {R : DyRect} : R ∈ roots α β 𝒬 F ↔ R ∈ posColl α β 𝒬 F ∧
    ∀ R' ∈ posColl α β 𝒬 F, IsAnc α β R R' → idx α β 𝒬 F R' = idx α β 𝒬 F R → R' = R := by
  classical
  exact Finset.mem_filter

theorem tree_convex (h𝒬 : IsConvexColl α β 𝒬) {R Q : DyRect} (hRp : R ∈ posColl α β 𝒬 F)
    (hQ : Q ∈ treeOf α β 𝒬 F R) (i j : ℕ) (h : DyRect.anc α β (i + j) Q = R) :
    DyRect.anc α β i Q ∈ treeOf α β 𝒬 F R := by
  rw [mem_treeOf] at hQ ⊢
  obtain ⟨hQp, -, hidx⟩ := hQ
  have hQ𝒬 := (mem_posColl.1 hQp).1
  have hR𝒬 := (mem_posColl.1 hRp).1
  have h1 : IsAnc α β Q (DyRect.anc α β i Q) := ⟨i, rfl⟩
  have h2 : IsAnc α β (DyRect.anc α β i Q) R := ⟨j, by rw [← DyRect.anc_add, add_comm]; exact h⟩
  have hle : ∀ k, supSize α β 𝒬 (F k) R ≤ supSize α β 𝒬 (F k) (DyRect.anc α β i Q) :=
    fun k => supSize_anti _ h2
  have hle' : ∀ k, supSize α β 𝒬 (F k) (DyRect.anc α β i Q) ≤ supSize α β 𝒬 (F k) Q :=
    fun k => supSize_anti _ h1
  refine ⟨mem_posColl.2 ⟨h𝒬 Q hQ𝒬 i j (h ▸ hR𝒬), fun k => ?_⟩, h2, ?_⟩
  · exact ((mem_posColl.1 hRp).2 k).trans_le (hle k)
  · funext k
    have hp := (mem_posColl.1 hRp).2 k
    have e := congrFun hidx k
    simp only [idx] at e ⊢
    refine le_antisymm ?_ (band_mono hp (hle k))
    rw [← e]
    exact band_mono (hp.trans_le (hle k)) (hle' k)

/-- The tree `𝒯_R` as a convex tree. -/
def mkTree (h𝒬 : IsConvexColl α β 𝒬) (R : DyRect) (hR : R ∈ posColl α β 𝒬 F) : DyTree α β where
  rects := treeOf α β 𝒬 F R
  root := R
  root_mem := mem_treeOf.2 ⟨hR, isAnc_refl R, rfl⟩
  le_root := fun _ hQ => (mem_treeOf.1 hQ).2.1
  convex := fun _ hQ i j h => tree_convex h𝒬 hR hQ i j h

theorem exists_root {Q : DyRect} (hQ : Q ∈ posColl α β 𝒬 F) :
    ∃ R ∈ roots α β 𝒬 F, Q ∈ treeOf α β 𝒬 F R := by
  classical
  set s := (posColl α β 𝒬 F).filter fun R => IsAnc α β Q R ∧ idx α β 𝒬 F R = idx α β 𝒬 F Q
  have hs : s.Nonempty := ⟨Q, Finset.mem_filter.2 ⟨hQ, isAnc_refl Q, rfl⟩⟩
  obtain ⟨R, hRs, hmax⟩ := s.exists_max_image DyRect.lev hs
  obtain ⟨hRp, hQR, hidx⟩ := Finset.mem_filter.1 hRs
  refine ⟨R, mem_roots.2 ⟨hRp, fun R' hR'p hRR' hidx' => ?_⟩, mem_treeOf.2 ⟨hQ, hQR, hidx.symm⟩⟩
  have hR's : R' ∈ s := Finset.mem_filter.2 ⟨hR'p, hQR.trans hRR', hidx'.trans hidx⟩
  exact hRR'.eq_of_lev_le (hmax R' hR's)

theorem root_unique {R₁ R₂ Q : DyRect} (h₁ : R₁ ∈ roots α β 𝒬 F) (h₂ : R₂ ∈ roots α β 𝒬 F)
    (hQ₁ : Q ∈ treeOf α β 𝒬 F R₁) (hQ₂ : Q ∈ treeOf α β 𝒬 F R₂) : R₁ = R₂ := by
  rw [mem_treeOf] at hQ₁ hQ₂
  rw [mem_roots] at h₁ h₂
  rcases isAnc_total hQ₁.2.1 hQ₂.2.1 with h | h
  · exact (h₁.2 R₂ h₂.1 h (hQ₂.2.2.symm.trans hQ₁.2.2)).symm
  · exact h₂.2 R₁ h₁.1 h (hQ₁.2.2.symm.trans hQ₂.2.2)

theorem roots_eq_of_mem {R₁ R₂ : DyRect} {z : ℝ × ℝ} (h₁ : R₁ ∈ roots α β 𝒬 F)
    (h₂ : R₂ ∈ roots α β 𝒬 F) (hz₁ : z ∈ R₁.toSet α β) (hz₂ : z ∈ R₂.toSet α β)
    (hidx : idx α β 𝒬 F R₁ = idx α β 𝒬 F R₂) : R₁ = R₂ := by
  rw [mem_roots] at h₁ h₂
  rcases isAnc_or_of_mem hz₁ hz₂ with h | h
  · exact (h₁.2 R₂ h₂.1 h hidx.symm).symm
  · exact h₂.2 R₁ h₁.1 h hidx

theorem posColl_eq_biUnion :
    posColl α β 𝒬 F = (roots α β 𝒬 F).biUnion (treeOf α β 𝒬 F) := by
  ext Q
  rw [Finset.mem_biUnion]
  constructor
  · exact exists_root
  · rintro ⟨R, -, hQ⟩
    exact (mem_treeOf.1 hQ).1

theorem sum_posColl_eq {M : Type*} [AddCommMonoid M] (X : DyRect → M) :
    ∑ Q ∈ posColl α β 𝒬 F, X Q = ∑ R ∈ roots α β 𝒬 F, ∑ Q ∈ treeOf α β 𝒬 F R, X Q := by
  rw [posColl_eq_biUnion, Finset.sum_biUnion]
  intro R₁ h₁ R₂ h₂ hne
  rw [Function.onFun, Finset.disjoint_left]
  intro Q hQ₁ hQ₂
  exact hne (root_unique h₁ h₂ hQ₁ hQ₂)

end trees

/-! ### Domination of the local sizes by a maximal function -/

/-- The constant `(3/2)^{10} · 16` of the one-dimensional domination. -/
def KK : ℝ := (3 / 2) ^ 10 * 16

theorem KK_pos : 0 < KK := by unfold KK; positivity

theorem bracket_shift_le {s c z : ℝ} (hs : 0 < s) (hz : |z - c| ≤ s / 2) (x : ℝ) :
    bracketKernelAt s c x ≤ (3 / 2) ^ 10 * bracketKernelAt s z x := by
  have h := Telescoping.bracketKernelAt_dilate_le (μ := 1) (c := z) (u := x) hs le_rfl
    ((c - z) / s)
  have e2 : z + (c - z) / s * s = c := by field_simp; ring
  rw [one_mul, e2, one_pow, one_mul] at h
  have hσ : |(c - z) / s| ≤ 1 / 2 := by
    rw [abs_div, abs_of_pos hs, div_le_iff₀ hs, abs_sub_comm]; linarith
  refine h.trans ?_
  have h0 := (Auto.Twisted.bracketKernelAt_pos (a := z) (x := x) hs).le
  gcongr
  linarith

theorem norm_bracket_le (k : ℤ) (z u : ℝ) :
    ‖((bracketKernelAt ((2 : ℝ) ^ k) z (z - u) : ℝ) : ℂ)‖ ≤
      1 * 2 ^ (-k) / (1 + 2 ^ (-k) * |u|) ^ 2 := by
  have hs : (0 : ℝ) < 2 ^ k := by positivity
  rw [Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos (Auto.Twisted.bracketKernelAt_pos hs)]
  simp only [bracketKernelAt, kernelAt, kernelDilate, smul_eq_mul,
    Auto.Twisted.bracketKernel_eq_inv_pow]
  rw [zpow_neg, one_mul]
  have e : |(z - u - z) / (2 : ℝ) ^ k| = ((2 : ℝ) ^ k)⁻¹ * |u| := by
    rw [show z - u - z = -u by ring, abs_div, abs_neg, abs_of_pos hs]; ring
  rw [e]
  set X := 1 + ((2 : ℝ) ^ k)⁻¹ * |u| with hX
  have hX1 : 1 ≤ X := le_add_of_nonneg_right (by positivity)
  have hp : X ^ 2 ≤ X ^ 10 := pow_le_pow_right₀ hX1 (by norm_num)
  rw [div_eq_mul_inv]
  gcongr

theorem integral_bracket_le_hlMax {g : ℝ → ℝ} (hg : Measurable g) {M : ℝ}
    (hg0 : ∀ y, 0 ≤ g y) (hgM : ∀ y, g y ≤ M) (k : ℤ) {c z : ℝ}
    (hz : |z - c| ≤ (2 : ℝ) ^ k / 2) :
    ∫ y, g y * bracketKernelAt ((2 : ℝ) ^ k) c y ≤ KK * hlMax (fun y => (g y : ℂ)) z := by
  set s : ℝ := (2 : ℝ) ^ k with hs_def
  have hs : 0 < s := by positivity
  have hint : ∀ a, Integrable (fun y => g y * bracketKernelAt s a y) := by
    intro a
    refine ((Auto.Twisted.integrable_bracketKernelAt hs a).const_mul M).mono'
      (hg.mul (Auto.Twisted.measurable_bracketKernelAt hs.ne' a)).aestronglyMeasurable
      (Eventually.of_forall fun y => ?_)
    have h0 := (Auto.Twisted.bracketKernelAt_pos (a := a) (x := y) hs).le
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (hg0 y) h0)]
    exact mul_le_mul_of_nonneg_right (hgM y) h0
  have h1 : ∫ y, g y * bracketKernelAt s c y ≤
      ∫ y, (3 / 2) ^ 10 * (g y * bracketKernelAt s z y) := by
    refine integral_mono_of_nonneg (Eventually.of_forall fun y => ?_) ((hint z).const_mul _)
      (Eventually.of_forall fun y => ?_)
    · exact mul_nonneg (hg0 y) (Auto.Twisted.bracketKernelAt_pos hs).le
    · calc g y * bracketKernelAt s c y ≤ g y * ((3 / 2) ^ 10 * bracketKernelAt s z y) :=
            mul_le_mul_of_nonneg_left (bracket_shift_le hs hz y) (hg0 y)
        _ = _ := by ring
  rw [integral_const_mul] at h1
  have hgc : ∀ x, ‖(g x : ℂ)‖ ≤ M := fun x => by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hg0 x)]; exact hgM x
  have hmax0 := shiftedMaximal_nonneg (-1 / 2) (fun y => (g y : ℂ)) z
  have h2 : ∫ y, g y * bracketKernelAt s z y ≤ 16 * hlMax (fun y => (g y : ℂ)) z := by
    rw [← ENNReal.ofReal_le_ofReal_iff (by positivity),
      ofReal_integral_eq_lintegral_ofReal (hint z) (Eventually.of_forall fun y =>
        mul_nonneg (hg0 y) (Auto.Twisted.bracketKernelAt_pos hs).le)]
    have hL := lintegral_kernel_le_hlMax
      (K := fun u => ((bracketKernelAt ((2 : ℝ) ^ k) z (z - u) : ℝ) : ℂ)) zero_le_one (-k)
      (fun u => norm_bracket_le k z u) (g := fun y => (g y : ℂ))
      (Complex.measurable_ofReal.comp hg) hgc z
    rw [← lintegral_sub_left_eq_self
      (fun y => ENNReal.ofReal (g y * bracketKernelAt s z y)) z]
    rw [mul_one] at hL
    refine le_trans (le_of_eq ?_) hL
    refine lintegral_congr fun u => ?_
    have h0 := (Auto.Twisted.bracketKernelAt_pos (a := z) (x := z - u) hs).le
    rw [ENNReal.ofReal_mul (hg0 _), mul_comm]
    congr 1
    · rw [← ofReal_norm, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg h0]
    · rw [← ofReal_norm, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hg0 _)]
  calc _ ≤ _ := h1
    _ ≤ (3 / 2) ^ 10 * (16 * hlMax (fun y => (g y : ℂ)) z) := by gcongr
    _ = _ := by unfold KK; ring


/-- `|f|^2` as a complex-valued function. -/
def sqF (f : ℝ × ℝ → ℝ) (w : ℝ × ℝ) : ℂ := ((f w ^ 2 : ℝ) : ℂ)

/-- The iterated maximal function `𝓜^{(1)} 𝓜^{(2)} |f|^2`. -/
def iterMax (f : ℝ × ℝ → ℝ) (z : ℝ × ℝ) : ℝ :=
  cMax 0 (fun w => ((cMax 1 (sqF f) w : ℝ) : ℂ)) z

/-- The majorant `(𝓜^{(1)} 𝓜^{(2)} |f|^2)^{1/2}` of the maximal function `𝓜_HL f`. -/
def mHL (f : ℝ × ℝ → ℝ) (z : ℝ × ℝ) : ℝ := Real.sqrt (iterMax f z)

theorem measurable_sqF {f : ℝ × ℝ → ℝ} (hf : Measurable f) : Measurable (sqF f) :=
  Complex.measurable_ofReal.comp (hf.pow_const 2)

theorem norm_sqF_le {f : ℝ × ℝ → ℝ} {M : ℝ} (hM : ∀ z, |f z| ≤ M) (w : ℝ × ℝ) :
    ‖sqF f w‖ ≤ M ^ 2 := by
  rw [sqF, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _), ← sq_abs]
  exact pow_le_pow_left₀ (abs_nonneg _) (hM w) 2

theorem measurable_iterMax {f : ℝ × ℝ → ℝ} (hf : Measurable f) : Measurable (iterMax f) :=
  measurable_cShift 0 (-1 / 2)
    (Complex.measurable_ofReal.comp (measurable_cShift 1 (-1 / 2) (measurable_sqF hf)))

theorem measurable_mHL {f : ℝ × ℝ → ℝ} (hf : Measurable f) : Measurable (mHL f) :=
  (measurable_iterMax hf).sqrt

theorem mHL_nonneg (f : ℝ × ℝ → ℝ) (z : ℝ × ℝ) : 0 ≤ mHL f z := Real.sqrt_nonneg _

theorem sizeAt_le_iterMax {f : ℝ × ℝ → ℝ} (hf : Measurable f) {M : ℝ} (hM : ∀ z, |f z| ≤ M)
    (k₁ k₂ : ℤ) {c₁ c₂ : ℝ} {z : ℝ × ℝ} (h₁ : |z.1 - c₁| ≤ (2 : ℝ) ^ k₁ / 2)
    (h₂ : |z.2 - c₂| ≤ (2 : ℝ) ^ k₂ / 2) :
    sizeAt f ((2 : ℝ) ^ k₁) ((2 : ℝ) ^ k₂) c₁ c₂ ≤ KK ^ 2 * iterMax f z := by
  have hs₁ : (0 : ℝ) < 2 ^ k₁ := by positivity
  have hF := measurable_sqF hf
  have hFb := norm_sqF_le hM
  set G : ℝ → ℝ := fun x => cMax 1 (sqF f) (x, z.2) with hG
  have hGm : Measurable G :=
    (measurable_cShift 1 (-1 / 2) hF).comp (measurable_id.prodMk measurable_const)
  have hG0 : ∀ x, 0 ≤ G x := fun x => cMax_nonneg _ _ _
  have hGb : ∀ x, G x ≤ M ^ 2 := fun x => cShift_le_of_bound 1 (-1 / 2) hFb _
  have inner : ∀ x, ∫ y, f (x, y) ^ 2 * (bracketKernelAt ((2 : ℝ) ^ k₁) c₁ x *
      bracketKernelAt ((2 : ℝ) ^ k₂) c₂ y) ≤ KK * (G x * bracketKernelAt ((2 : ℝ) ^ k₁) c₁ x) := by
    intro x
    have e : (fun y => f (x, y) ^ 2 * (bracketKernelAt ((2 : ℝ) ^ k₁) c₁ x *
        bracketKernelAt ((2 : ℝ) ^ k₂) c₂ y)) = fun y => bracketKernelAt ((2 : ℝ) ^ k₁) c₁ x *
        (f (x, y) ^ 2 * bracketKernelAt ((2 : ℝ) ^ k₂) c₂ y) := by funext y; ring
    rw [e, integral_const_mul]
    have h := integral_bracket_le_hlMax (g := fun y => f (x, y) ^ 2)
      ((hf.comp measurable_prodMk_left).pow_const 2) (M := M ^ 2) (fun y => sq_nonneg _)
      (fun y => by rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) (hM _) 2) k₂ h₂
    have hc : hlMax (fun y => ((f (x, y) ^ 2 : ℝ) : ℂ)) z.2 = G x := by
      rw [hG]; simp only; rw [cMax_one_eq]; rfl
    rw [hc] at h
    have h0 := (Auto.Twisted.bracketKernelAt_pos (a := c₁) (x := x) hs₁).le
    calc _ ≤ bracketKernelAt ((2 : ℝ) ^ k₁) c₁ x * (KK * G x) :=
          mul_le_mul_of_nonneg_left h h0
      _ = _ := by ring
  have hint : Integrable (fun x => G x * bracketKernelAt ((2 : ℝ) ^ k₁) c₁ x) := by
    refine ((Auto.Twisted.integrable_bracketKernelAt hs₁ c₁).const_mul (M ^ 2)).mono'
      (hGm.mul (Auto.Twisted.measurable_bracketKernelAt hs₁.ne' c₁)).aestronglyMeasurable
      (Eventually.of_forall fun y => ?_)
    have h0 := (Auto.Twisted.bracketKernelAt_pos (a := c₁) (x := y) hs₁).le
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (hG0 y) h0)]
    exact mul_le_mul_of_nonneg_right (hGb y) h0
  have hfin : iterMax f z = hlMax (fun x => (G x : ℂ)) z.1 := by
    rw [iterMax, cMax_zero_eq]
  unfold sizeAt
  calc _ ≤ ∫ x, KK * (G x * bracketKernelAt ((2 : ℝ) ^ k₁) c₁ x) := by
        refine integral_mono_of_nonneg (Eventually.of_forall fun x => ?_) (hint.const_mul _)
          (Eventually.of_forall inner)
        refine integral_nonneg fun y => ?_
        have := (Auto.Twisted.bracketKernelAt_pos (a := c₁) (x := x) hs₁).le
        have := (Auto.Twisted.bracketKernelAt_pos (a := c₂) (x := y)
          (by positivity : (0 : ℝ) < 2 ^ k₂)).le
        positivity
    _ = KK * ∫ x, G x * bracketKernelAt ((2 : ℝ) ^ k₁) c₁ x := integral_const_mul _ _
    _ ≤ KK * (KK * hlMax (fun x => (G x : ℂ)) z.1) := by
        gcongr
        · exact KK_pos.le
        · exact integral_bracket_le_hlMax hGm hG0 hGb k₁ h₁
    _ = KK ^ 2 * iterMax f z := by rw [hfin]; ring

theorem sizeQ_le_mHL {α β : ℕ} {f : ℝ × ℝ → ℝ} (hf : Measurable f) {M : ℝ}
    (hM : ∀ z, |f z| ≤ M) {Q : DyRect} {z : ℝ × ℝ} (hz : z ∈ Q.toSet α β) :
    sizeQ α β f Q ≤ KK * mHL f z := by
  simp only [DyRect.toSet, DyRect.ix, DyRect.iy, mem_prod, mem_Ico] at hz
  have h₁ : |z.1 - (Q.center α β).1| ≤ (2 : ℝ) ^ (Q.lev * (α : ℤ)) / 2 := by
    change |z.1 - (Q.x0 α + Q.sx α / 2)| ≤ Q.sx α / 2
    rw [abs_le]; constructor <;> linarith [hz.1.1, hz.1.2]
  have h₂ : |z.2 - (Q.center α β).2| ≤ (2 : ℝ) ^ (Q.lev * (β : ℤ)) / 2 := by
    change |z.2 - (Q.y0 β + Q.sy β / 2)| ≤ Q.sy β / 2
    rw [abs_le]; constructor <;> linarith [hz.2.1, hz.2.2]
  have h := sizeAt_le_iterMax hf hM _ _ h₁ h₂
  rw [sizeQ, mHL]
  calc √(sizeAt f (Q.sx α) (Q.sy β) (Q.center α β).1 (Q.center α β).2)
      ≤ √(KK ^ 2 * iterMax f z) := Real.sqrt_le_sqrt h
    _ = KK * √(iterMax f z) := by rw [Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq KK_pos.le]

/-! ### `L^p` bounds for the maximal function -/

/-- The `L^{p/2}` constant of the coordinate maximal functions. -/
def lpC (p : ℝ) : ℝ := shiftedMaximalLpConst (p / 2) * Real.log (2 + |(-1 / 2 : ℝ)|)

theorem lpC_nonneg {p : ℝ} (hp : 2 < p) : 0 ≤ lpC p :=
  mul_nonneg (shiftedMaximalLpConst_pos (by linarith)).le
    (Real.log_nonneg (by linarith [abs_nonneg (-1 / 2 : ℝ)]))

theorem lintegral_mHL_rpow_le {f : ℝ × ℝ → ℝ} (hf : Measurable f) {M : ℝ}
    (hM : ∀ z, |f z| ≤ M) {p : ℝ} (hp : 2 < p) :
    ∫⁻ z, ENNReal.ofReal (mHL f z) ^ p ≤
      ENNReal.ofReal (lpC p) * ENNReal.ofReal (lpC p) * ∫⁻ z, ‖f z‖ₑ ^ p := by
  have hp2 : 1 < p / 2 := by linarith
  have hF := measurable_sqF hf
  have hFb := norm_sqF_le hM
  have hG : Measurable fun w => ((cMax 1 (sqF f) w : ℝ) : ℂ) :=
    Complex.measurable_ofReal.comp (measurable_cShift 1 (-1 / 2) hF)
  have hGb : ∀ w, ‖((cMax 1 (sqF f) w : ℝ) : ℂ)‖ ≤ M ^ 2 := fun w => by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (cMax_nonneg _ _ _)]
    exact cShift_le_of_bound 1 (-1 / 2) hFb _
  have h1 := lintegral_cShift_rpow_le 0 (-1 / 2) hp2 hG hGb
  have h2 := lintegral_cShift_rpow_le 1 (-1 / 2) hp2 hF hFb
  have e1 : ∫⁻ z, ENNReal.ofReal (mHL f z) ^ p = ∫⁻ z, ENNReal.ofReal
      (cShift 0 (-1 / 2) (fun w => ((cMax 1 (sqF f) w : ℝ) : ℂ)) z ^ (p / 2)) := by
    refine lintegral_congr fun z => ?_
    rw [mHL, ENNReal.ofReal_rpow_of_nonneg (Real.sqrt_nonneg _) (by linarith),
      Real.sqrt_eq_rpow, ← Real.rpow_mul (show 0 ≤ iterMax f z from cMax_nonneg _ _ _)]
    change _ = ENNReal.ofReal (iterMax f z ^ (p / 2))
    congr 2; ring
  have e2 : ∫⁻ z, ENNReal.ofReal ‖((cMax 1 (sqF f) z : ℝ) : ℂ)‖ ^ (p / 2) =
      ∫⁻ z, ENNReal.ofReal (cShift 1 (-1 / 2) (sqF f) z ^ (p / 2)) := by
    refine lintegral_congr fun z => ?_
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (cMax_nonneg _ _ _),
      ENNReal.ofReal_rpow_of_nonneg (cMax_nonneg _ _ _) (by linarith)]
    rfl
  have e3 : ∫⁻ z, ENNReal.ofReal ‖sqF f z‖ ^ (p / 2) = ∫⁻ z, ‖f z‖ₑ ^ p := by
    refine lintegral_congr fun z => ?_
    rw [sqF, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _), ← sq_abs,
      ENNReal.ofReal_pow (abs_nonneg _), ← Real.enorm_eq_ofReal_abs, ← ENNReal.rpow_natCast,
      ← ENNReal.rpow_mul]
    congr 1; push_cast; ring
  calc _ = _ := e1
    _ ≤ _ := h1
    _ = ENNReal.ofReal (lpC p) *
          ∫⁻ z, ENNReal.ofReal (cShift 1 (-1 / 2) (sqF f) z ^ (p / 2)) := by
        rw [e2]; rfl
    _ ≤ ENNReal.ofReal (lpC p) * (ENNReal.ofReal (lpC p) *
          ∫⁻ z, ENNReal.ofReal ‖sqF f z‖ ^ (p / 2)) := by
        gcongr; exact h2
    _ = _ := by rw [e3, mul_assoc]

/-! ### Counting the trees through a point -/

theorem sum_two_zpow_le (s : Finset ℤ) {y : ℝ} (hy : 0 ≤ y) (h : ∀ m ∈ s, (2 : ℝ) ^ m ≤ y) :
    ∑ m ∈ s, (2 : ℝ) ^ m ≤ 2 * y := by
  induction s using Finset.induction_on_max generalizing y with
  | empty => simp only [Finset.sum_empty]; linarith
  | insert a s ha ih =>
    rw [Finset.sum_insert (fun h => lt_irrefl a (ha a h))]
    have hs := ih (y := 2 ^ (a - 1)) (by positivity) (fun m hm =>
      zpow_le_zpow_right₀ (by norm_num) (by have := ha m hm; omega))
    have ha' := h a (Finset.mem_insert_self a s)
    have e : (2 : ℝ) ^ a = 2 * 2 ^ (a - 1) := by
      rw [zpow_sub_one₀ two_ne_zero]; ring
    linarith

section count

variable {𝒬 : Finset DyRect} {F : Fin 3 → ℝ × ℝ → ℝ} {M : ℝ}

theorem two_zpow_idx_le (hF : ∀ k, Measurable (F k)) (hM : ∀ k z, |F k z| ≤ M) {R : DyRect}
    (hR : R ∈ posColl α β 𝒬 F) {z : ℝ × ℝ} (hz : z ∈ R.toSet α β) (k : Fin 3) :
    (2 : ℝ) ^ idx α β 𝒬 F R k ≤ 2 * KK * mHL (F k) z := by
  classical
  have hp := (mem_posColl.1 hR).2 k
  have h1 := two_zpow_band_le hp
  have h2 : supSize α β 𝒬 (F k) R ≤ KK * mHL (F k) z := by
    refine Msize_le (fun Q' hQ' => sizeQ_le_mHL (hF k) (hM k) ?_)
      (mul_nonneg KK_pos.le (mHL_nonneg _ _))
    obtain ⟨i, rfl⟩ := (Finset.mem_filter.1 hQ').2
    exact mem_anc hz i
  simp only [idx]
  linarith

open Classical in
theorem sum_roots_le (hF : ∀ k, Measurable (F k)) (hM : ∀ k z, |F k z| ≤ M) (z : ℝ × ℝ) :
    ∑ R ∈ (roots α β 𝒬 F).filter (fun R => z ∈ R.toSet α β),
      ∏ k, (2 : ℝ) ^ idx α β 𝒬 F R k ≤ ∏ k, (4 * KK * mHL (F k) z) := by
  set Rz := (roots α β 𝒬 F).filter (fun R => z ∈ R.toSet α β) with hRz
  have hinj : Set.InjOn (idx α β 𝒬 F) Rz := fun R₁ h₁ R₂ h₂ he => by
    rw [Finset.mem_coe, Finset.mem_filter] at h₁ h₂
    exact roots_eq_of_mem h₁.1 h₂.1 h₁.2 h₂.2 he
  rw [← Finset.sum_image (f := fun n : Fin 3 → ℤ => ∏ k, (2 : ℝ) ^ n k) hinj]
  have hsub : Rz.image (idx α β 𝒬 F) ⊆
      Fintype.piFinset fun k => Rz.image fun R => idx α β 𝒬 F R k := by
    intro n hn
    obtain ⟨R, hR, rfl⟩ := Finset.mem_image.1 hn
    exact Fintype.mem_piFinset.2 fun k => Finset.mem_image_of_mem _ hR
  calc _ ≤ ∑ n ∈ Fintype.piFinset (fun k => Rz.image fun R => idx α β 𝒬 F R k),
          ∏ k, (2 : ℝ) ^ n k :=
        Finset.sum_le_sum_of_subset_of_nonneg hsub (fun _ _ _ => by positivity)
    _ = ∏ k, ∑ m ∈ Rz.image (fun R => idx α β 𝒬 F R k), (2 : ℝ) ^ m :=
        (Finset.prod_univ_sum _ _).symm
    _ ≤ ∏ k, (4 * KK * mHL (F k) z) := by
        refine Finset.prod_le_prod (fun k _ => by positivity) (fun k _ => ?_)
        have hK := KK_pos
        have hm := mHL_nonneg (F k) z
        have := sum_two_zpow_le (Rz.image fun R => idx α β 𝒬 F R k)
          (y := 2 * KK * mHL (F k) z) (by positivity) (fun m hm => by
            obtain ⟨R, hR, rfl⟩ := Finset.mem_image.1 hm
            have hR' := Finset.mem_filter.1 hR
            exact two_zpow_idx_le hF hM (mem_roots.1 hR'.1).1 hR'.2 k)
        linarith

theorem sum_roots_area_le (hF : ∀ k, Measurable (F k)) (hM : ∀ k z, |F k z| ≤ M) :
    ∑ R ∈ roots α β 𝒬 F, ENNReal.ofReal (R.area α β * ∏ k, (2 : ℝ) ^ idx α β 𝒬 F R k) ≤
      ENNReal.ofReal ((4 * KK) ^ 3) * ∫⁻ z, ∏ k, ENNReal.ofReal (mHL (F k) z) := by
  classical
  have e1 : ∀ R ∈ roots α β 𝒬 F,
      ENNReal.ofReal (R.area α β * ∏ k, (2 : ℝ) ^ idx α β 𝒬 F R k) =
        ∫⁻ z, (R.toSet α β).indicator
          (fun _ => ENNReal.ofReal (∏ k, (2 : ℝ) ^ idx α β 𝒬 F R k)) z := by
    intro R _
    rw [lintegral_indicator_const (measurableSet_toSet R), volume_toSet,
      ENNReal.ofReal_mul (R.area_pos α β).le, mul_comm]
  rw [Finset.sum_congr rfl e1, ← lintegral_finsetSum _ (fun R _ =>
    measurable_const.indicator (measurableSet_toSet R)),
    ← lintegral_const_mul _ (Finset.measurable_prod _ fun k _ =>
      (measurable_mHL (hF k)).ennreal_ofReal)]
  refine lintegral_mono fun z => ?_
  simp only [Set.indicator_apply]
  rw [← Finset.sum_filter, ← ENNReal.ofReal_sum_of_nonneg (fun _ _ => by positivity),
    ← ENNReal.ofReal_prod_of_nonneg (fun k _ => mHL_nonneg _ _),
    ← ENNReal.ofReal_mul (by have := KK_pos; positivity)]
  refine ENNReal.ofReal_le_ofReal ((sum_roots_le hF hM z).trans (le_of_eq ?_))
  rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin]

theorem lintegral_prod_mHL_le (hF : ∀ k, Measurable (F k)) (hM : ∀ k z, |F k z| ≤ M)
    {p : Fin 3 → ℝ} (hp : ∀ k, 2 < p k) (hsum : ∑ k, 1 / p k = 1) :
    ∫⁻ z, ∏ k, ENNReal.ofReal (mHL (F k) z) ≤
      ∏ k, (ENNReal.ofReal (lpC (p k) * lpC (p k)) ^ (1 / p k) *
        eLpNorm (F k) (ENNReal.ofReal (p k)) volume) := by
  have h := ENNReal.lintegral_prod_norm_pow_le (μ := volume) Finset.univ
    (f := fun k z => ENNReal.ofReal (mHL (F k) z) ^ p k)
    (fun k _ => ((measurable_mHL (hF k)).ennreal_ofReal.pow_const _).aemeasurable)
    (p := fun k => 1 / p k) hsum (fun k _ => by have := hp k; positivity)
  have e : ∀ z, ∏ k, (ENNReal.ofReal (mHL (F k) z) ^ p k) ^ (1 / p k) =
      ∏ k, ENNReal.ofReal (mHL (F k) z) := fun z => Finset.prod_congr rfl fun k _ => by
    rw [← ENNReal.rpow_mul, mul_one_div_cancel (by linarith [hp k] : p k ≠ 0),
      ENNReal.rpow_one]
  simp only [e] at h
  refine h.trans (Finset.prod_le_prod' fun k _ => ?_)
  have hpk : 0 < p k := by linarith [hp k]
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simp [hpk]) ENNReal.ofReal_ne_top,
    ENNReal.toReal_ofReal hpk.le, ← ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
    ENNReal.ofReal_mul (lpC_nonneg (hp k))]
  exact ENNReal.rpow_le_rpow (lintegral_mHL_rpow_le (hF k) (hM k) (hp k)) (by positivity)

end count

/-! ### Singleton trees and the size of the constant function -/

/-- The convex tree `{Q}`. -/
def single (α β : ℕ) (Q : DyRect) : DyTree α β where
  rects := {Q}
  root := Q
  root_mem := Finset.mem_singleton_self Q
  le_root := fun Q' h => ⟨0, by rw [Finset.mem_singleton.1 h]; rfl⟩
  convex := fun Q' h i j hij => by
    rw [Finset.mem_singleton] at h ⊢
    subst h
    have hl := congrArg DyRect.lev hij
    rw [DyRect.anc_lev] at hl
    have : i = 0 := by omega
    subst this; rfl

theorem sizeQ_one_le (Q : DyRect) : sizeQ α β (fun _ => 1) Q ≤ 1 := by
  have hx := Q.sx_pos α
  have hy := Q.sy_pos β
  have e : sizeAt (fun _ => (1 : ℝ)) (Q.sx α) (Q.sy β) (Q.center α β).1 (Q.center α β).2 =
      2 / 9 * (2 / 9) := by
    simp only [sizeAt, one_pow, one_mul, integral_const_mul, integral_mul_const,
      Auto.Twisted.integral_bracketKernelAt hy, Auto.Twisted.integral_bracketKernelAt hx]
  rw [sizeQ, e, ← Real.sqrt_one]
  exact Real.sqrt_le_sqrt (by norm_num)

theorem Msize_one_le (s : Finset DyRect) : Msize α β s (fun _ => 1) ≤ 1 :=
  Msize_le (fun Q _ => sizeQ_one_le Q) zero_le_one

theorem locForm_eq_sum (𝒮 : Finset DyRect) (c : ℝ → ℝ) (k₁ k₂ k₃ k₄ : ℝ → ℝ)
    (f₁ f₂ f₃ f₄ : ℝ × ℝ → ℝ) :
    locForm α β 𝒮 c k₁ k₂ k₃ k₄ f₁ f₂ f₃ f₄ =
      ∑ Q ∈ 𝒮, locForm α β {Q} c k₁ k₂ k₃ k₄ f₁ f₂ f₃ f₄ := by
  simp only [locForm, collInt, Finset.sum_singleton]

end Planting

open Planting in
/-- **Combining the trees** (`sec:planting`, the case `2 < p, q < ∞`, `1 < r < 2` of
`prop:twisted`): for a finite convex collection `𝒬` of dyadic rectangles and exponents
`2 < p_1, p_2, p_3` with `1/p_1 + 1/p_2 + 1/p_3 = 1`,
`|Λ_𝒬(f_1, f_2, f_3, 1)| ≤ C A B ‖f_1‖_{p_1} ‖f_2‖_{p_2} ‖f_3‖_{p_3}`. -/
theorem combining_trees_uniform {α β : ℕ} (hα : 0 < α) (hβ : 0 < β) :
    ∃ N : ℕ, ∀ {p₁ p₂ p₃ : ℝ}, 2 < p₁ → 2 < p₂ → 2 < p₃ → 1 / p₁ + 1 / p₂ + 1 / p₃ = 1 →
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (Φ Ψ : ℝ → ℝ) (A B : ℝ), Continuous Φ → Continuous Ψ →
      (∀ x, |Φ x| ≤ A * (1 + |x|) ^ (-(N : ℝ))) → (∀ x, |Ψ x| ≤ B * (1 + |x|) ^ (-(N : ℝ))) →
      ∀ (𝒬 : Finset DyRect), IsConvexColl α β 𝒬 → ∀ (c : ℝ → ℝ), Measurable c →
      (∀ t, |c t| ≤ 1) → ∀ (f₁ f₂ f₃ : ℝ × ℝ → ℝ), Measurable f₁ → Measurable f₂ →
      Measurable f₃ → ∀ M : ℝ, (∀ z, |f₁ z| ≤ M) → (∀ z, |f₂ z| ≤ M) → (∀ z, |f₃ z| ≤ M) →
      ENNReal.ofReal |locForm α β 𝒬 c gaussian Φ gaussianDeriv (hconv Ψ) f₁ f₂ f₃ (fun _ => 1)| ≤
        ENNReal.ofReal (C * A * B) * eLpNorm f₁ (ENNReal.ofReal p₁) volume *
          eLpNorm f₂ (ENNReal.ofReal p₂) volume * eLpNorm f₃ (ENNReal.ofReal p₃) volume := by
  classical
  obtain ⟨N, C, hC, hT⟩ := tree_estimate hα hβ
  refine ⟨N, fun {p₁ p₂ p₃} h₁ h₂ h₃ hsum => ?_⟩
  obtain ⟨P, hP0, hP1, hP2⟩ : ∃ P : Fin 3 → ℝ, P 0 = p₁ ∧ P 1 = p₂ ∧ P 2 = p₃ :=
    ⟨![p₁, p₂, p₃], rfl, rfl, rfl⟩
  have hPk : ∀ k, 2 < P k := fun k => match k with
    | 0 => hP0 ▸ h₁
    | 1 => hP1 ▸ h₂
    | 2 => hP2 ▸ h₃
  have hPsum : ∑ k, 1 / P k = 1 := by rw [Fin.sum_univ_three, hP0, hP1, hP2, hsum]
  have hl : ∀ k, 0 ≤ lpC (P k) * lpC (P k) := fun k =>
    mul_nonneg (lpC_nonneg (hPk k)) (lpC_nonneg (hPk k))
  set D : ℝ := ∏ k, (lpC (P k) * lpC (P k)) ^ (1 / P k) with hD
  have hD0 : 0 ≤ D := Finset.prod_nonneg fun k _ => Real.rpow_nonneg (hl k) _
  have hK := KK_pos
  refine ⟨C * ((4 * KK) ^ 3 * D), by positivity, ?_⟩
  intro Φ Ψ A B hΦ hΨ hΦd hΨd 𝒬 h𝒬 c hc hc1 f₁ f₂ f₃ hf₁ hf₂ hf₃ M hM₁ hM₂ hM₃
  have hA : 0 ≤ A := by
    have := hΦd 0
    simp only [abs_zero, add_zero, Real.one_rpow, mul_one] at this
    exact (abs_nonneg _).trans this
  have hB : 0 ≤ B := by
    have := hΨd 0
    simp only [abs_zero, add_zero, Real.one_rpow, mul_one] at this
    exact (abs_nonneg _).trans this
  have hCAB : 0 ≤ C * A * B := by positivity
  obtain ⟨F, hF0, hF1, hF2⟩ : ∃ F : Fin 3 → ℝ × ℝ → ℝ, F 0 = f₁ ∧ F 1 = f₂ ∧ F 2 = f₃ :=
    ⟨![f₁, f₂, f₃], rfl, rfl, rfl⟩
  set M' := max M 1 with hM'
  have hF : ∀ k, Measurable (F k) := fun k => match k with
    | 0 => hF0 ▸ hf₁
    | 1 => hF1 ▸ hf₂
    | 2 => hF2 ▸ hf₃
  have hM₁' : ∀ z, |f₁ z| ≤ M' := fun z => (hM₁ z).trans (le_max_left _ _)
  have hM₂' : ∀ z, |f₂ z| ≤ M' := fun z => (hM₂ z).trans (le_max_left _ _)
  have hM₃' : ∀ z, |f₃ z| ≤ M' := fun z => (hM₃ z).trans (le_max_left _ _)
  have h1M : ∀ z : ℝ × ℝ, |(fun _ => (1 : ℝ)) z| ≤ M' := fun z => by
    simp only [abs_one]; exact le_max_right _ _
  have hFM : ∀ k z, |F k z| ≤ M' := fun k => match k with
    | 0 => hF0 ▸ hM₁'
    | 1 => hF1 ▸ hM₂'
    | 2 => hF2 ▸ hM₃'
  set L : Finset DyRect → ℝ := fun 𝒮 =>
    locForm α β 𝒮 c gaussian Φ gaussianDeriv (hconv Ψ) f₁ f₂ f₃ (fun _ => 1) with hL
  have hTr : ∀ T : DyTree α β, |L T.rects| ≤ C * A * B * T.root.area α β *
      (Msize α β T.rects f₁ * Msize α β T.rects f₂ * Msize α β T.rects f₃ *
        Msize α β T.rects (fun _ => 1)) := fun T =>
    hT Φ Ψ A B hΦ hΨ hΦd hΨd T c hc hc1 f₁ f₂ f₃ _ hf₁ hf₂ hf₃ measurable_const M' hM₁' hM₂'
      hM₃' h1M
  -- the rectangles with a vanishing size contribute nothing
  have hzero : ∀ Q ∈ 𝒬, Q ∉ posColl α β 𝒬 F → L {Q} = 0 := by
    intro Q hQ hQp
    have hk : ∃ k, supSize α β 𝒬 (F k) Q = 0 := by
      by_contra hcon
      push Not at hcon
      exact hQp (mem_posColl.2 ⟨hQ, fun k =>
        lt_of_le_of_ne (supSize_nonneg _ _ _) (hcon k).symm⟩)
    obtain ⟨k, hk⟩ := hk
    have hsub : ({Q} : Finset DyRect) ⊆ ancs α β 𝒬 Q := by
      intro x hx
      rw [Finset.mem_singleton] at hx
      subst hx
      exact Finset.mem_filter.2 ⟨hQ, isAnc_refl _⟩
    have hm : ∏ j, Msize α β {Q} (F j) = 0 :=
      Finset.prod_eq_zero (Finset.mem_univ k)
        (le_antisymm ((Msize_mono hsub _).trans hk.le) (Msize_nonneg _ _ _ _))
    rw [Fin.prod_univ_three, hF0, hF1, hF2] at hm
    have h := hTr (single α β Q)
    change |L {Q}| ≤ C * A * B * Q.area α β * (Msize α β {Q} f₁ * Msize α β {Q} f₂ *
      Msize α β {Q} f₃ * Msize α β {Q} (fun _ => 1)) at h
    rw [hm, zero_mul, mul_zero] at h
    exact abs_nonpos_iff.1 h
  -- the tree estimate on each tree `𝒯_R`
  have hroot : ∀ R ∈ roots α β 𝒬 F, |L (treeOf α β 𝒬 F R)| ≤
      C * A * B * (R.area α β * ∏ k, (2 : ℝ) ^ idx α β 𝒬 F R k) := by
    intro R hR
    have hRp := (mem_roots.1 hR).1
    have h := hTr (mkTree h𝒬 R hRp)
    change |L (treeOf α β 𝒬 F R)| ≤ C * A * B * R.area α β *
      (Msize α β (treeOf α β 𝒬 F R) f₁ * Msize α β (treeOf α β 𝒬 F R) f₂ *
        Msize α β (treeOf α β 𝒬 F R) f₃ * Msize α β (treeOf α β 𝒬 F R) (fun _ => 1)) at h
    have hMs : ∀ k, Msize α β (treeOf α β 𝒬 F R) (F k) ≤ (2 : ℝ) ^ idx α β 𝒬 F R k := by
      intro k
      refine Msize_le (fun Q hQ => ?_) (by positivity)
      obtain ⟨hQp, -, hidx⟩ := mem_treeOf.1 hQ
      calc sizeQ α β (F k) Q ≤ supSize α β 𝒬 (F k) Q :=
            sizeQ_le_supSize _ (mem_posColl.1 hQp).1
        _ ≤ 2 ^ band (supSize α β 𝒬 (F k) Q) := le_two_zpow_band ((mem_posColl.1 hQp).2 k)
        _ = 2 ^ idx α β 𝒬 F R k := by rw [← hidx]; rfl
    have m0 := hMs 0
    have m1 := hMs 1
    have m2 := hMs 2
    rw [hF0] at m0
    rw [hF1] at m1
    rw [hF2] at m2
    have m3 := Msize_one_le (α := α) (β := β) (treeOf α β 𝒬 F R)
    have hR0 := (R.area_pos α β).le
    have n0 := Msize_nonneg α β (treeOf α β 𝒬 F R) f₁
    have n1 := Msize_nonneg α β (treeOf α β 𝒬 F R) f₂
    have n2 := Msize_nonneg α β (treeOf α β 𝒬 F R) f₃
    have n3 := Msize_nonneg α β (treeOf α β 𝒬 F R) (fun _ => 1)
    refine h.trans ?_
    rw [Fin.prod_univ_three]
    calc C * A * B * R.area α β *
          (Msize α β (treeOf α β 𝒬 F R) f₁ * Msize α β (treeOf α β 𝒬 F R) f₂ *
            Msize α β (treeOf α β 𝒬 F R) f₃ * Msize α β (treeOf α β 𝒬 F R) (fun _ => 1))
        ≤ C * A * B * R.area α β * ((2 : ℝ) ^ idx α β 𝒬 F R 0 * 2 ^ idx α β 𝒬 F R 1 *
            2 ^ idx α β 𝒬 F R 2 * 1) := by gcongr
      _ = _ := by ring
  -- the trees partition the collection
  have hsplit : L 𝒬 = ∑ R ∈ roots α β 𝒬 F, L (treeOf α β 𝒬 F R) := by
    simp only [hL]
    rw [locForm_eq_sum, ← Finset.sum_filter_add_sum_filter_not 𝒬
      (fun Q => ∀ k, 0 < supSize α β 𝒬 (F k) Q)]
    rw [Finset.sum_eq_zero (s := 𝒬.filter fun Q => ¬∀ k, 0 < supSize α β 𝒬 (F k) Q)
      (fun Q hQ => by
        rw [Finset.mem_filter] at hQ
        exact hzero Q hQ.1 fun h => hQ.2 (mem_posColl.1 h).2), add_zero]
    change ∑ Q ∈ posColl α β 𝒬 F, _ = _
    rw [sum_posColl_eq]
    exact Finset.sum_congr rfl fun R _ => (locForm_eq_sum _ _ _ _ _ _ _ _ _ _).symm
  have hbound : |L 𝒬| ≤ ∑ R ∈ roots α β 𝒬 F,
      C * A * B * (R.area α β * ∏ k, (2 : ℝ) ^ idx α β 𝒬 F R k) := by
    rw [hsplit]
    exact (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum hroot)
  have hAr := sum_roots_area_le (α := α) (β := β) (𝒬 := 𝒬) hF hFM
  have hH := lintegral_prod_mHL_le hF hFM hPk hPsum
  have eD : ENNReal.ofReal D = ∏ k, ENNReal.ofReal (lpC (P k) * lpC (P k)) ^ (1 / P k) := by
    rw [hD, ENNReal.ofReal_prod_of_nonneg (fun k _ => Real.rpow_nonneg (hl k) _)]
    refine Finset.prod_congr rfl fun k _ => ?_
    rw [ENNReal.ofReal_rpow_of_nonneg (hl k) (by have := hPk k; positivity)]
  have eC : ENNReal.ofReal (C * ((4 * KK) ^ 3 * D) * A * B) =
      ENNReal.ofReal (C * A * B) * (ENNReal.ofReal ((4 * KK) ^ 3) * ENNReal.ofReal D) := by
    rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul hCAB]
    congr 1; ring
  calc ENNReal.ofReal |L 𝒬|
      ≤ ENNReal.ofReal (∑ R ∈ roots α β 𝒬 F,
          C * A * B * (R.area α β * ∏ k, (2 : ℝ) ^ idx α β 𝒬 F R k)) :=
        ENNReal.ofReal_le_ofReal hbound
    _ = ENNReal.ofReal (C * A * B) * ∑ R ∈ roots α β 𝒬 F,
          ENNReal.ofReal (R.area α β * ∏ k, (2 : ℝ) ^ idx α β 𝒬 F R k) := by
        rw [← Finset.mul_sum, ENNReal.ofReal_mul hCAB, ENNReal.ofReal_sum_of_nonneg
          (fun R _ => mul_nonneg (R.area_pos α β).le
            (Finset.prod_nonneg fun _ _ => by positivity))]
    _ ≤ ENNReal.ofReal (C * A * B) * (ENNReal.ofReal ((4 * KK) ^ 3) *
          ∏ k, (ENNReal.ofReal (lpC (P k) * lpC (P k)) ^ (1 / P k) *
            eLpNorm (F k) (ENNReal.ofReal (P k)) volume)) := by
        gcongr
        exact hAr.trans (by gcongr)
    _ = _ := by
        rw [eC, eD, Finset.prod_mul_distrib,
          Fin.prod_univ_three (fun k => eLpNorm (F k) (ENNReal.ofReal (P k)) volume),
          hF0, hF1, hF2, hP0, hP1, hP2]
        ring



open Planting in
/-- `combining_trees_uniform` with the decay order chosen after the exponents. -/
theorem combining_trees {α β : ℕ} (hα : 0 < α) (hβ : 0 < β) {p₁ p₂ p₃ : ℝ}
    (h₁ : 2 < p₁) (h₂ : 2 < p₂) (h₃ : 2 < p₃) (hsum : 1 / p₁ + 1 / p₂ + 1 / p₃ = 1) :
    ∃ (N : ℕ) (C : ℝ), 0 ≤ C ∧ ∀ (Φ Ψ : ℝ → ℝ) (A B : ℝ), Continuous Φ → Continuous Ψ →
      (∀ x, |Φ x| ≤ A * (1 + |x|) ^ (-(N : ℝ))) → (∀ x, |Ψ x| ≤ B * (1 + |x|) ^ (-(N : ℝ))) →
      ∀ (𝒬 : Finset DyRect), IsConvexColl α β 𝒬 → ∀ (c : ℝ → ℝ), Measurable c →
      (∀ t, |c t| ≤ 1) → ∀ (f₁ f₂ f₃ : ℝ × ℝ → ℝ), Measurable f₁ → Measurable f₂ →
      Measurable f₃ → ∀ M : ℝ, (∀ z, |f₁ z| ≤ M) → (∀ z, |f₂ z| ≤ M) → (∀ z, |f₃ z| ≤ M) →
      ENNReal.ofReal |locForm α β 𝒬 c gaussian Φ gaussianDeriv (hconv Ψ) f₁ f₂ f₃ (fun _ => 1)| ≤
        ENNReal.ofReal (C * A * B) * eLpNorm f₁ (ENNReal.ofReal p₁) volume *
          eLpNorm f₂ (ENNReal.ofReal p₂) volume * eLpNorm f₃ (ENNReal.ofReal p₃) volume := by
  obtain ⟨N, hN⟩ := combining_trees_uniform hα hβ
  obtain ⟨C, hC, h⟩ := hN h₁ h₂ h₃ hsum
  exact ⟨N, C, hC, h⟩
end

