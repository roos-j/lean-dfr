      ((hf.comp (measurable_fst.fst.prodMk measurable_snd)).mul
        (hf.comp (measurable_fst.snd.prodMk measurable_snd))).stronglyMeasurable).measurable
  have hGb : ∀ p, |G p| ≤ 1 := fun p => abs_integral_μI_le fun y => hff _ _
  have hKint : ∫ p, dyKer k p.1 p.2 ∂ν = 1 := by
    rw [hν, integral_prod _ (integrable_of_abs_le hK (2 ^ k) hKb)]
    have : ∀ᵐ x ∂μI, ∫ x', dyKer k x x' ∂μI = 1 := by
      filter_upwards [ae_restrict_mem measurableSet_Ico] with x hx
      have := mart_one (k := k) hx
      simpa [mart] using this
    rw [integral_congr_ae this]
    simp
  have hKG2 : ∀ p, |dyKer k p.1 p.2 * G p ^ 2| ≤ 2 ^ k * 1 := fun p => by
    rw [abs_mul, abs_pow]
    exact mul_le_mul (hKb p) (pow_le_one₀ (abs_nonneg _) (hGb p)) (by positivity) (by positivity)
  -- Step 3: Cauchy-Schwarz with weight `K_k`
  have hCS := sq_integral_mul_le (ν := ν) (w := fun p => dyKer k p.1 p.2) (G := G)
    (fun p => dyKer_nonneg _ _ _) (integrable_of_abs_le hK (2 ^ k) hKb)
    (integrable_of_abs_le (hK.mul hGm) (2 ^ k * 1) fun p => by
      rw [abs_mul]; exact mul_le_mul (hKb p) (hGb p) (abs_nonneg _) (by positivity))
    (integrable_of_abs_le (hK.mul (hGm.pow_const 2)) (2 ^ k * 1) hKG2)
  rw [hKint, one_mul] at hCS
  -- Step 4: `G^2 ≤ ∫_y f(x,y) f(x',y) E^{(2)}_l f(x,y)`
  have hG2 : ∀ p : ℝ × ℝ, G p ^ 2 ≤ ∫ y, f (p.1, y) * f (p.2, y) * e2 l f (p.1, y) ∂μI := by
    intro p
    have hH : Measurable fun y => f (p.1, y) * f (p.2, y) := (hfx _).mul (hfx _)
    have hHb : ∀ y, |f (p.1, y) * f (p.2, y)| ≤ 1 := fun y => hff _ _
    refine (sq_integral_le_integral_mul_mart l hH 1 hHb).trans (integral_mono ?_ ?_ fun y => ?_)
    · exact integrable_of_abs_le (hH.mul (measurable_mart l hH)) (1 * (2 ^ l * 1)) fun y => by
        rw [abs_mul]; exact mul_le_mul (hHb y) (abs_mart_le l hHb y) (abs_nonneg _) zero_le_one
    · refine integrable_of_abs_le (hH.mul ((measurable_e2 l hf).comp
        (measurable_const.prodMk measurable_id))) (1 * (2 ^ l * 1)) fun y => ?_
      rw [abs_mul]; exact mul_le_mul (hHb y) (he2 _) (abs_nonneg _) zero_le_one
    · refine mul_le_mul_of_nonneg_left ?_ (mul_nonneg (h0 _) (h0 _))
      have hKl : Measurable fun y' => dyKer l y y' :=
        (measurable_dyKer l).comp (measurable_const.prodMk measurable_id)
      refine integral_mono ?_ ?_ fun y' => ?_
      · exact integrable_of_abs_le (hKl.mul hH) (2 ^ l * 1) fun y' => by
          rw [abs_mul, abs_of_nonneg (dyKer_nonneg _ _ _)]
          exact mul_le_mul (dyKer_le _ _ _) (hHb _) (abs_nonneg _) (by positivity)
      · exact integrable_of_abs_le (hKl.mul (hfx p.1)) (2 ^ l * 1) fun y' => by
          rw [abs_mul, abs_of_nonneg (dyKer_nonneg _ _ _)]
          exact mul_le_mul (dyKer_le _ _ _) (hfa _) (abs_nonneg _) (by positivity)
      · refine mul_le_mul_of_nonneg_left ?_ (dyKer_nonneg _ _ _)
        calc f (p.1, y') * f (p.2, y') ≤ f (p.1, y') * 1 :=
              mul_le_mul_of_nonneg_left (h1 _) (h0 _)
          _ = f (p.1, y') := mul_one _
  -- Step 5: integrate Step 4 against `K_k`, and swap back
  set Ψ : (ℝ × ℝ) × ℝ → ℝ := fun q => dyKer k q.1.1 q.1.2 * (f (q.1.1, q.2) * f (q.1.2, q.2) *
    e2 l f (q.1.1, q.2)) with hΨ
  have hΨm : Measurable Ψ :=
    ((measurable_dyKer k).comp measurable_fst).mul
      (((hf.comp (measurable_fst.fst.prodMk measurable_snd)).mul
        (hf.comp (measurable_fst.snd.prodMk measurable_snd))).mul
        ((measurable_e2 l hf).comp (measurable_fst.fst.prodMk measurable_snd)))
  have hΨb : ∀ q, |Ψ q| ≤ 2 ^ k * (1 * (2 ^ l * 1)) := fun q => by
    simp only [hΨ]
    rw [abs_mul, abs_of_nonneg (dyKer_nonneg _ _ _), abs_mul]
    exact mul_le_mul (dyKer_le _ _ _) (mul_le_mul (hff _ _) (he2 _) (abs_nonneg _) zero_le_one)
      (by positivity) (by positivity)
  have hstep5 : ∫ p, dyKer k p.1 p.2 * G p ^ 2 ∂ν ≤ ∫ p, ∫ y, Ψ (p, y) ∂μI ∂ν := by
    refine integral_mono ?_ ?_ fun p => ?_
    · exact integrable_of_abs_le (hK.mul (hGm.pow_const 2)) (2 ^ k * 1) hKG2
    · exact integrable_of_abs_le (StronglyMeasurable.integral_prod_right' (ν := μI) (f := Ψ)
        hΨm.stronglyMeasurable).measurable (2 ^ k * (1 * (2 ^ l * 1)))
        fun p => abs_integral_μI_le fun y => hΨb _
    · simp only [hΨ]
      rw [integral_const_mul]
      exact mul_le_mul_of_nonneg_left (hG2 p) (dyKer_nonneg _ _ _)
  have hback : ∫ p, ∫ y, Ψ (p, y) ∂μI ∂ν =
      ∫ y, ∫ x, f (x, y) * e1 k f (x, y) * e2 l f (x, y) ∂μI ∂μI := by
    rw [← swap3 hΨm _ hΨb]
    refine integral_congr_ae (Eventually.of_forall fun y => integral_congr_ae
      (Eventually.of_forall fun x => ?_))
    simp only [hΨ, e1, mart]
    have e : (f (x, y) * ∫ x', dyKer k x x' * f (x', y) ∂μI) * e2 l f (x, y) =
        ∫ x', (f (x, y) * e2 l f (x, y)) * (dyKer k x x' * f (x', y)) ∂μI := by
      rw [integral_const_mul]; ring
    rw [e]
    congr 1; ext x'; ring
  -- assembly
  have hQ2 : 0 ≤ (∫ y, ∫ x, f (x, y) ∂μI ∂μI) ^ 2 := sq_nonneg _
  calc (∫ y, ∫ x, f (x, y) ∂μI ∂μI) ^ 4 = ((∫ y, ∫ x, f (x, y) ∂μI ∂μI) ^ 2) ^ 2 := by ring
    _ ≤ S ^ 2 := pow_le_pow_left₀ hQ2 hQS 2
    _ = (∫ p, dyKer k p.1 p.2 * G p ∂ν) ^ 2 := by rw [hS2]
    _ ≤ ∫ p, dyKer k p.1 p.2 * G p ^ 2 ∂ν := hCS
    _ ≤ _ := hstep5.trans hback.le

/-- Partial convolution in the first variable, `(f *₁ φ)(x,y) = ∫ f(x-u,y) φ(u) du`. -/
def conv1 (f : ℝ × ℝ → ℝ) (φ : ℝ → ℝ) (z : ℝ × ℝ) : ℝ := ∫ u, f (z.1 - u, z.2) * φ u

/-- Partial convolution in the second variable, `(f *₂ φ)(x,y) = ∫ f(x,y-u) φ(u) du`. -/
def conv2 (f : ℝ × ℝ → ℝ) (φ : ℝ → ℝ) (z : ℝ × ℝ) : ℝ := ∫ u, f (z.1, z.2 - u) * φ u

/-- The `L^1`-normalized dilation `φ_k(x) = 2^k φ(2^k x)`. -/
def dil (φ : ℝ → ℝ) (k : ℕ) (u : ℝ) : ℝ := 2 ^ k * φ (2 ^ k * u)

/-- A bump `ϑ ≥ 0` constant on `[-1,1]`, supported in `[-2,2]`, monotone on `[1,2]` and even with
`∫ ϑ = 1` (the hypotheses of `lem:lowerbd`) is positive at the origin. -/
theorem theta_zero_pos {ϑ : ℝ → ℝ} (hc : Continuous ϑ) (hnn : ∀ x, 0 ≤ ϑ x)
    (heven : ∀ x, ϑ (-x) = ϑ x) (hsupp : Function.support ϑ ⊆ Icc (-2) 2)
    (hconst : ∀ x ∈ Icc (-1 : ℝ) 1, ϑ x = ϑ 0)
    (hmono : MonotoneOn ϑ (Icc 1 2) ∨ AntitoneOn ϑ (Icc 1 2)) (hnorm : ∫ x, ϑ x = 1) :
    0 < ϑ 0 := by
  by_contra h
  have h0 : ϑ 0 = 0 := le_antisymm (not_lt.1 h) (hnn 0)
  have hout : ∀ x, x ∉ Icc (-2 : ℝ) 2 → ϑ x = 0 := fun x hx =>
    Function.notMem_support.1 fun hs => hx (hsupp hs)
  have h2 : ϑ 2 = 0 := by
    have hcl : IsClosed {x : ℝ | ϑ x = 0} := isClosed_eq hc continuous_const
    have hsub : Ioi (2 : ℝ) ⊆ {x : ℝ | ϑ x = 0} := fun x hx => hout x fun h => by
      rw [mem_Icc] at h; rw [mem_Ioi] at hx; linarith
    have := (hcl.closure_subset_iff.2 hsub)
    rw [closure_Ioi] at this
    exact this (mem_Ici.2 le_rfl)
  have h1 : ϑ 1 = 0 := (hconst 1 ⟨by norm_num, le_rfl⟩).trans h0
  have hmid : ∀ x ∈ Icc (1 : ℝ) 2, ϑ x = 0 := by
    intro x hx
    have h1m : (1 : ℝ) ∈ Icc (1 : ℝ) 2 := ⟨le_rfl, by norm_num⟩
    have h2m : (2 : ℝ) ∈ Icc (1 : ℝ) 2 := ⟨by norm_num, le_rfl⟩
    rcases hmono with hm | hm
    · have a := hm h1m hx hx.1
      have b := hm hx h2m hx.2
      linarith
    · have a := hm h1m hx hx.1
      have b := hm hx h2m hx.2
      linarith
  have hzero : ∀ x, ϑ x = 0 := by
    intro x
    by_cases hx1 : |x| ≤ 1
    · exact (hconst x (abs_le.1 hx1)).trans h0
    by_cases hx2 : |x| ≤ 2
    · replace hx1 := not_le.1 hx1
      rcases le_or_gt 0 x with hx | hx
      · rw [abs_of_nonneg hx] at hx1 hx2
        exact hmid x ⟨hx1.le, hx2⟩
      · rw [abs_of_neg hx] at hx1 hx2
        rw [← heven x]
        exact hmid (-x) ⟨hx1.le, hx2⟩
    · replace hx2 := not_le.1 hx2
      exact hout x fun h => by
        have := abs_le.2 (mem_Icc.1 h); linarith
  have : ∫ x, ϑ x = 0 := by simp [hzero]
  rw [hnorm] at this
  exact one_ne_zero this

theorem dyKer_le_dil {ϑ : ℝ → ℝ} (hnn : ∀ x, 0 ≤ ϑ x) (hconst : ∀ x ∈ Icc (-1 : ℝ) 1, ϑ x = ϑ 0)
    (k : ℕ) (x x' : ℝ) : ϑ 0 * dyKer k x x' ≤ dil ϑ k (x - x') := by
  unfold dyKer dil
  split_ifs with h
  · have := Int.abs_sub_lt_one_of_floor_eq_floor h
    rw [← mul_sub] at this
    rw [hconst _ (abs_le.1 this.le)]
    ring_nf; exact le_rfl
  · rw [mul_zero]; exact mul_nonneg (by positivity) (hnn _)

theorem measurable_conv1 {f : ℝ × ℝ → ℝ} (hf : Measurable f) {φ : ℝ → ℝ} (hφ : Measurable φ) :
    Measurable (conv1 f φ) :=
  (StronglyMeasurable.integral_prod_right' (ν := volume)
    (f := fun q : (ℝ × ℝ) × ℝ => f (q.1.1 - q.2, q.1.2) * φ q.2)
    ((hf.comp ((measurable_fst.fst.sub measurable_snd).prodMk measurable_fst.snd)).mul
      (hφ.comp measurable_snd)).stronglyMeasurable).measurable

theorem measurable_conv2 {f : ℝ × ℝ → ℝ} (hf : Measurable f) {φ : ℝ → ℝ} (hφ : Measurable φ) :
    Measurable (conv2 f φ) :=
  (StronglyMeasurable.integral_prod_right' (ν := volume)
    (f := fun q : (ℝ × ℝ) × ℝ => f (q.1.1, q.1.2 - q.2) * φ q.2)
    ((hf.comp (measurable_fst.fst.prodMk (measurable_fst.snd.sub measurable_snd))).mul
      (hφ.comp measurable_snd)).stronglyMeasurable).measurable

theorem abs_conv_le {g φ : ℝ → ℝ} (hφ : Integrable φ) (hg : ∀ u, |g u| ≤ 1) :
    |∫ u, g u * φ u| ≤ ∫ u, |φ u| := by
  rw [← Real.norm_eq_abs]
  refine (norm_integral_le_integral_norm _).trans ?_
  refine integral_mono_of_nonneg (Eventually.of_forall fun u => norm_nonneg _) hφ.abs
    (Eventually.of_forall fun u => ?_)
  change ‖g u * φ u‖ ≤ |φ u|
  rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs]
  exact (mul_le_mul_of_nonneg_right (hg u) (abs_nonneg _)).trans (by rw [one_mul])

/-- `f *₁ ϑ_k ≥ ϑ(0) E^{(1)}_k f` for `0 ≤ f ≤ 1` (the pointwise bound `E_k g ≲ g * ϑ_k` in the
proof of `lem:lowerbd`). -/
theorem conv1_ge_e1 {ϑ : ℝ → ℝ} (hc : Continuous ϑ) (hcs : HasCompactSupport ϑ)
    (hnn : ∀ x, 0 ≤ ϑ x) (hconst : ∀ x ∈ Icc (-1 : ℝ) 1, ϑ x = ϑ 0) (k : ℕ)
    {f : ℝ × ℝ → ℝ} (hf : Measurable f) (h0 : ∀ z, 0 ≤ f z) (h1 : ∀ z, f z ≤ 1) (z : ℝ × ℝ) :
    ϑ 0 * e1 k f z ≤ conv1 f (dil ϑ k) z := by
  obtain ⟨x, y⟩ := z
  have hdc : Continuous (dil ϑ k) :=
    continuous_const.mul (hc.comp (continuous_const.mul continuous_id))
  have hdi : Integrable (dil ϑ k) := by
    refine hdc.integrable_of_hasCompactSupport ?_
    have : dil ϑ k = fun u => 2 ^ k * ϑ ((2 ^ k : ℝ) * u) := rfl
    rw [this]
    exact (hcs.comp_smul (by positivity : (2 : ℝ) ^ k ≠ 0)).mul_left
  have hfy : Measurable fun x' => f (x', y) := hf.comp (measurable_id.prodMk measurable_const)
  have hfa : ∀ z, |f z| ≤ 1 := fun z => by rw [abs_of_nonneg (h0 z)]; exact h1 z
  have hsub : conv1 f (dil ϑ k) (x, y) = ∫ x', f (x', y) * dil ϑ k (x - x') := by
    unfold conv1
    have := integral_sub_left_eq_self (fun v => f (v, y) * dil ϑ k (x - v)) volume x
    simp only [sub_sub_cancel] at this
    exact this
  have hint : Integrable fun x' => f (x', y) * dil ϑ k (x - x') :=
    (hdi.comp_sub_left x).bdd_mul hfy.aestronglyMeasurable
      (Eventually.of_forall fun x' => by rw [Real.norm_eq_abs]; exact hfa _)
  rw [hsub]
  refine le_trans ?_ (setIntegral_le_integral (s := Ico (0 : ℝ) 1) hint
    (Eventually.of_forall fun x' =>
    mul_nonneg (h0 _) (by unfold dil; exact mul_nonneg (by positivity) (hnn _))))
  change ϑ 0 * ∫ x', dyKer k x x' * f (x', y) ∂μI ≤ ∫ x', f (x', y) * dil ϑ k (x - x') ∂μI
  rw [← integral_const_mul]
  refine integral_mono ?_ hint.integrableOn fun x' => ?_
  · refine integrable_of_abs_le ((((measurable_dyKer k).comp (measurable_const.prodMk
      measurable_id)).mul hfy).const_mul (ϑ 0)) (|ϑ 0| * (2 ^ k * 1)) fun x' => ?_
    change |ϑ 0 * (dyKer k x x' * f (x', y))| ≤ _
    rw [abs_mul, abs_mul, abs_of_nonneg (dyKer_nonneg _ _ _)]
    exact mul_le_mul_of_nonneg_left (mul_le_mul (dyKer_le _ _ _) (hfa _) (abs_nonneg _)
      (by positivity)) (abs_nonneg _)
  · calc ϑ 0 * (dyKer k x x' * f (x', y)) = (ϑ 0 * dyKer k x x') * f (x', y) := by ring
      _ ≤ dil ϑ k (x - x') * f (x', y) :=
        mul_le_mul_of_nonneg_right (dyKer_le_dil hnn hconst k x x') (h0 _)
      _ = f (x', y) * dil ϑ k (x - x') := mul_comm _ _

open scoped ContDiff

theorem integrable_dil {ϑ : ℝ → ℝ} (hc : Continuous ϑ) (hcs : HasCompactSupport ϑ) (k : ℕ) :
    Integrable (dil ϑ k) := by
  have hdc : Continuous (dil ϑ k) :=
    continuous_const.mul (hc.comp (continuous_const.mul continuous_id))
  refine hdc.integrable_of_hasCompactSupport ?_
  have : dil ϑ k = fun u => 2 ^ k * ϑ ((2 ^ k : ℝ) * u) := rfl
  rw [this]
  exact (hcs.comp_smul (by positivity : (2 : ℝ) ^ k ≠ 0)).mul_left

theorem dil_nonneg {ϑ : ℝ → ℝ} (hnn : ∀ x, 0 ≤ ϑ x) (k : ℕ) (u : ℝ) : 0 ≤ dil ϑ k u :=
  mul_nonneg (by positivity) (hnn _)

/-- `f *₂ ϑ_l ≥ ϑ(0) E^{(2)}_l f` for `0 ≤ f ≤ 1`. -/
theorem conv2_ge_e2 {ϑ : ℝ → ℝ} (hc : Continuous ϑ) (hcs : HasCompactSupport ϑ)
    (hnn : ∀ x, 0 ≤ ϑ x) (hconst : ∀ x ∈ Icc (-1 : ℝ) 1, ϑ x = ϑ 0) (l : ℕ)
    {f : ℝ × ℝ → ℝ} (hf : Measurable f) (h0 : ∀ z, 0 ≤ f z) (h1 : ∀ z, f z ≤ 1) (z : ℝ × ℝ) :
    ϑ 0 * e2 l f z ≤ conv2 f (dil ϑ l) z := by
  obtain ⟨x, y⟩ := z
  have hdi := integrable_dil hc hcs l
  have hfx : Measurable fun y' => f (x, y') := hf.comp (measurable_const.prodMk measurable_id)
  have hfa : ∀ z, |f z| ≤ 1 := fun z => by rw [abs_of_nonneg (h0 z)]; exact h1 z
  have hsub : conv2 f (dil ϑ l) (x, y) = ∫ y', f (x, y') * dil ϑ l (y - y') := by
    unfold conv2
    have := integral_sub_left_eq_self (fun v => f (x, v) * dil ϑ l (y - v)) volume y
    simp only [sub_sub_cancel] at this
    exact this
  have hint : Integrable fun y' => f (x, y') * dil ϑ l (y - y') :=
    (hdi.comp_sub_left y).bdd_mul hfx.aestronglyMeasurable
      (Eventually.of_forall fun y' => by rw [Real.norm_eq_abs]; exact hfa _)
  rw [hsub]
  refine le_trans ?_ (setIntegral_le_integral (s := Ico (0 : ℝ) 1) hint
    (Eventually.of_forall fun y' => mul_nonneg (h0 _) (dil_nonneg hnn _ _)))
  change ϑ 0 * ∫ y', dyKer l y y' * f (x, y') ∂μI ≤ ∫ y', f (x, y') * dil ϑ l (y - y') ∂μI
  rw [← integral_const_mul]
  refine integral_mono ?_ hint.integrableOn fun y' => ?_
  · refine integrable_of_abs_le ((((measurable_dyKer l).comp (measurable_const.prodMk
      measurable_id)).mul hfx).const_mul (ϑ 0)) (|ϑ 0| * (2 ^ l * 1)) fun y' => ?_
    change |ϑ 0 * (dyKer l y y' * f (x, y'))| ≤ _
    rw [abs_mul, abs_mul, abs_of_nonneg (dyKer_nonneg _ _ _)]
    exact mul_le_mul_of_nonneg_left (mul_le_mul (dyKer_le _ _ _) (hfa _) (abs_nonneg _)
      (by positivity)) (abs_nonneg _)
  · calc ϑ 0 * (dyKer l y y' * f (x, y')) = (ϑ 0 * dyKer l y y') * f (x, y') := by ring
      _ ≤ dil ϑ l (y - y') * f (x, y') :=
        mul_le_mul_of_nonneg_right (dyKer_le_dil hnn hconst l y y') (h0 _)
      _ = f (x, y') * dil ϑ l (y - y') := mul_comm _ _

/-- Integrals over the unit square `[0,1]^2` as iterated integrals over `[0,1)`. -/
theorem setIntegral_unitSquare {F : ℝ × ℝ → ℝ} (hF : Measurable F) (C : ℝ)
    (hC : ∀ z, |F z| ≤ C) :
    ∫ z in Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1, F z = ∫ y, ∫ x, F (x, y) ∂μI ∂μI := by
  have hae : (Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1 : Set (ℝ × ℝ)) =ᵐ[volume] Ico 0 1 ×ˢ Ico 0 1 := by
    rw [Measure.volume_eq_prod]
    exact Measure.set_prod_ae_eq Ico_ae_eq_Icc.symm Ico_ae_eq_Icc.symm
  rw [setIntegral_congr_set hae, Measure.volume_eq_prod, ← Measure.prod_restrict]
  exact integral_prod_symm F (integrable_of_abs_le hF C hC)

/-- The bound of `lem:lowerbd` for a continuous compactly supported `ϑ ≥ 0` constant on `[-1,1]`
with `ϑ(0) > 0`, with the constant `c₀ = ϑ(0)^2`. -/
theorem lowerbd_core {ϑ : ℝ → ℝ} (hc : Continuous ϑ) (hcs : HasCompactSupport ϑ)
    (hnn : ∀ x, 0 ≤ ϑ x) (hconst : ∀ x ∈ Icc (-1 : ℝ) 1, ϑ x = ϑ 0) (h0pos : 0 < ϑ 0)
    {f : ℝ × ℝ → ℝ} (hf : Measurable f) (h0 : ∀ z, 0 ≤ f z) (h1 : ∀ z, f z ≤ 1) (k l : ℕ) :
    ϑ 0 ^ 2 * (∫ z in Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1, f z) ^ 4 ≤
      ∫ z in Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1, f z * conv1 f (dil ϑ k) z * conv2 f (dil ϑ l) z := by
  have hfa : ∀ z, |f z| ≤ 1 := fun z => by rw [abs_of_nonneg (h0 z)]; exact h1 z
  set B1 := ∫ u, |dil ϑ k u|
  set B2 := ∫ u, |dil ϑ l u|
  have hc1 : ∀ z, |conv1 f (dil ϑ k) z| ≤ B1 := fun z =>
    abs_conv_le (integrable_dil hc hcs k) fun u => hfa _
  have hc2 : ∀ z, |conv2 f (dil ϑ l) z| ≤ B2 := fun z =>
    abs_conv_le (integrable_dil hc hcs l) fun u => hfa _
  have hP : Measurable fun z => f z * conv1 f (dil ϑ k) z * conv2 f (dil ϑ l) z :=
    (hf.mul (measurable_conv1 hf (hc.comp (continuous_const.mul continuous_id)
      |> continuous_const.mul).measurable)).mul
      (measurable_conv2 hf (hc.comp (continuous_const.mul continuous_id)
      |> continuous_const.mul).measurable)
  have hPb : ∀ z, |f z * conv1 f (dil ϑ k) z * conv2 f (dil ϑ l) z| ≤ 1 * B1 * B2 := fun z => by
    rw [abs_mul, abs_mul]
    exact mul_le_mul (mul_le_mul (hfa z) (hc1 z) (abs_nonneg _) zero_le_one) (hc2 z)
      (abs_nonneg _) (by have := (abs_nonneg _).trans (hc1 z); positivity)
  rw [setIntegral_unitSquare hf 1 hfa, setIntegral_unitSquare hP _ hPb]
  have he1 : ∀ z, |e1 k f z| ≤ 2 ^ k * 1 := fun z => abs_mart_le k (fun x => hfa _) z.1
  have he2 : ∀ z, |e2 l f z| ≤ 2 ^ l * 1 := fun z => abs_mart_le l (fun x => hfa _) z.2
  have he1n : ∀ z, 0 ≤ e1 k f z := fun z => mart_nonneg k (fun x => h0 _) z.1
  have he2n : ∀ z, 0 ≤ e2 l f z := fun z => mart_nonneg l (fun x => h0 _) z.2
  have hQ := pow_four_le_integral_mul_e1_e2 k l hf h0 h1
  have hE : Measurable fun z => f z * e1 k f z * e2 l f z :=
    (hf.mul (measurable_e1 k hf)).mul (measurable_e2 l hf)
  have hEb : ∀ z, |f z * e1 k f z * e2 l f z| ≤ 1 * (2 ^ k * 1) * (2 ^ l * 1) := fun z => by
    rw [abs_mul, abs_mul]
    exact mul_le_mul (mul_le_mul (hfa z) (he1 z) (abs_nonneg _) zero_le_one) (he2 z)
      (abs_nonneg _) (by positivity)
  have hinner : ∀ {F : ℝ × ℝ → ℝ}, Measurable F → ∀ C, (∀ z, |F z| ≤ C) →
      Integrable (fun y => ∫ x, F (x, y) ∂μI) μI := fun {F} hF C hC =>
    integrable_of_abs_le (StronglyMeasurable.integral_prod_right' (ν := μI)
      (f := fun q : ℝ × ℝ => F (q.2, q.1)) (hF.comp measurable_swap).stronglyMeasurable).measurable
      C fun y => abs_integral_μI_le fun x => hC _
  calc ϑ 0 ^ 2 * (∫ y, ∫ x, f (x, y) ∂μI ∂μI) ^ 4
      ≤ ϑ 0 ^ 2 * ∫ y, ∫ x, f (x, y) * e1 k f (x, y) * e2 l f (x, y) ∂μI ∂μI :=
        mul_le_mul_of_nonneg_left hQ (by positivity)
    _ = ∫ y, ∫ x, f (x, y) * (ϑ 0 * e1 k f (x, y)) * (ϑ 0 * e2 l f (x, y)) ∂μI ∂μI := by
        rw [← integral_const_mul]
        refine integral_congr_ae (Eventually.of_forall fun y => ?_)
        dsimp only
        rw [← integral_const_mul]
        congr 1; ext x; ring
    _ ≤ ∫ y, ∫ x, f (x, y) * conv1 f (dil ϑ k) (x, y) * conv2 f (dil ϑ l) (x, y) ∂μI ∂μI := by
        refine integral_mono ?_ (hinner hP _ hPb) fun y => integral_mono ?_ ?_ fun x => ?_
        · refine hinner ((hf.mul ((measurable_e1 k hf).const_mul _)).mul
            ((measurable_e2 l hf).const_mul _)) (1 * (|ϑ 0| * (2 ^ k * 1)) * (|ϑ 0| * (2 ^ l * 1)))
            fun z => ?_
          change |f z * (ϑ 0 * e1 k f z) * (ϑ 0 * e2 l f z)| ≤ _
          rw [abs_mul, abs_mul, abs_mul, abs_mul]
          exact mul_le_mul (mul_le_mul (hfa z) (mul_le_mul_of_nonneg_left (he1 z) (abs_nonneg _))
            (by positivity) zero_le_one) (mul_le_mul_of_nonneg_left (he2 z) (abs_nonneg _))
            (by positivity) (by positivity)
        · refine integrable_of_abs_le ((hf.mul ((measurable_e1 k hf).const_mul _)).mul
            ((measurable_e2 l hf).const_mul _) |>.comp (measurable_id.prodMk measurable_const))
            (1 * (|ϑ 0| * (2 ^ k * 1)) * (|ϑ 0| * (2 ^ l * 1))) fun x => ?_
          show |f (x, y) * (ϑ 0 * e1 k f (x, y)) * (ϑ 0 * e2 l f (x, y))| ≤ _
          rw [abs_mul, abs_mul, abs_mul, abs_mul]
          exact mul_le_mul (mul_le_mul (hfa _) (mul_le_mul_of_nonneg_left (he1 _) (abs_nonneg _))
            (by positivity) zero_le_one) (mul_le_mul_of_nonneg_left (he2 _) (abs_nonneg _))
            (by positivity) (by positivity)
        · exact integrable_of_abs_le (hP.comp (measurable_id.prodMk measurable_const)) _
            fun x => hPb _
        · have a := conv1_ge_e1 hc hcs hnn hconst k hf h0 h1 (x, y)
          have b := conv2_ge_e2 hc hcs hnn hconst l hf h0 h1 (x, y)
          have a0 : 0 ≤ ϑ 0 * e1 k f (x, y) := mul_nonneg h0pos.le (he1n _)
          have b0 : 0 ≤ ϑ 0 * e2 l f (x, y) := mul_nonneg h0pos.le (he2n _)
          exact mul_le_mul (mul_le_mul_of_nonneg_left a (h0 _)) b b0
            (mul_nonneg (h0 _) (a0.trans a))


/-- **Lemma `lem:lowerbd`** (CDR, Section 5.1; an analogue of Bourgain's Lemma 6). Let `ϑ ≥ 0` be
an even smooth function supported in `[-2,2]`, constant on `[-1,1]`, monotone on `[1,2]` and
normalized by `ϑ̂(0) = ∫ ϑ = 1`, and `ϑ_k(x) = 2^k ϑ(2^k x)`. There is `c₀ > 0`, depending only on
`ϑ`, such that for every measurable `f` on `ℝ^2` with `0 ≤ f ≤ 1` and all `k, l ∈ ℕ`,
`∫_{[0,1]^2} f (f *₁ ϑ_k)(f *₂ ϑ_l) ≥ c₀ (∫_{[0,1]^2} f)^4`.
(The source assumes in addition that `f` is supported in `[0,1]^2`; the bound holds without it.) -/
theorem lem_lowerbd {ϑ : ℝ → ℝ} (hϑ : ContDiff ℝ ∞ ϑ) (hnn : ∀ x, 0 ≤ ϑ x)
    (heven : ∀ x, ϑ (-x) = ϑ x) (hsupp : Function.support ϑ ⊆ Icc (-2) 2)
    (hconst : ∀ x ∈ Icc (-1 : ℝ) 1, ϑ x = ϑ 0)
    (hmono : MonotoneOn ϑ (Icc 1 2) ∨ AntitoneOn ϑ (Icc 1 2)) (hnorm : ∫ x, ϑ x = 1) :
    ∃ c₀ : ℝ, 0 < c₀ ∧ ∀ f : ℝ × ℝ → ℝ, Measurable f → (∀ z, 0 ≤ f z) → (∀ z, f z ≤ 1) →
      ∀ k l : ℕ, c₀ * (∫ z in Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1, f z) ^ 4 ≤
        ∫ z in Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1, f z * conv1 f (dil ϑ k) z * conv2 f (dil ϑ l) z := by
  have hc : Continuous ϑ := hϑ.continuous
  have hcs : HasCompactSupport ϑ := HasCompactSupport.intro isCompact_Icc fun x hx =>
    Function.notMem_support.1 fun hs => hx (hsupp hs)
  have h0pos := theta_zero_pos hc hnn heven hsupp hconst hmono hnorm
  exact ⟨ϑ 0 ^ 2, by positivity, fun f hf h0 h1 k l =>
    lowerbd_core hc hcs hnn hconst h0pos hf h0 h1 k l⟩


/-- A real kernel as a complex function. -/
def cK (a : ℝ → ℝ) (u : ℝ) : ℂ := (a u : ℂ)

theorem integrable_cK {a : ℝ → ℝ} (ha : Integrable a) : Integrable (cK a) :=
  ha.ofReal

theorem norm_fourier_le_integral_norm (g : ℝ → ℂ) (ξ : ℝ) : ‖𝓕 g ξ‖ ≤ ∫ u, ‖g u‖ := by
  rw [Real.fourier_real_eq]
  refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
  congr 1; ext u
  rw [Circle.smul_def, smul_eq_mul, norm_mul, Circle.norm_coe, one_mul]

/-- `|â| ≤ 1` for a probability density `a`. -/
theorem norm_fourier_cK_le_one {a : ℝ → ℝ} (hnn : ∀ u, 0 ≤ a u) (hint : ∫ u, a u = 1) (ξ : ℝ) :
    ‖𝓕 (cK a) ξ‖ ≤ 1 := by
  refine (norm_fourier_le_integral_norm _ ξ).trans (le_of_eq ?_)
  simp only [cK, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hnn _), hint]

/-- `|1 - â(ξ)| ≤ 2π |ξ| ∫ |u| a(u) du` for a probability density `a` with finite first moment. -/
theorem norm_one_sub_fourier_cK_le {a : ℝ → ℝ} (hnn : ∀ u, 0 ≤ a u) (hai : Integrable a)
    (hint : ∫ u, a u = 1) (hm : Integrable fun u => |u| * a u) (ξ : ℝ) :
    ‖1 - 𝓕 (cK a) ξ‖ ≤ 2 * π * |ξ| * ∫ u, |u| * a u := by
  have h1 : (1 : ℂ) = ∫ u, cK a u := by
    rw [show (∫ u, cK a u) = ((∫ u, a u : ℝ) : ℂ) from integral_ofReal, hint, Complex.ofReal_one]
  have hI : Integrable fun u => (𝐞 (-(u * ξ)) : ℂ) * cK a u := by
    refine (integrable_cK hai).bdd_mul (c := 1) (by fun_prop) (Eventually.of_forall fun u => ?_)
    exact (Circle.norm_coe _).le
  have e : 1 - 𝓕 (cK a) ξ = ∫ u, (1 - (𝐞 (-(u * ξ)) : ℂ)) * cK a u := by
    have h2 : ∫ u, (1 - (𝐞 (-(u * ξ)) : ℂ)) * cK a u =
        (∫ u, cK a u) - ∫ u, (𝐞 (-(u * ξ)) : ℂ) * cK a u := by
      rw [← integral_sub (integrable_cK hai) hI]; congr 1; ext u; ring
    rw [h2, ← h1, Real.fourier_real_eq]
    simp only [Circle.smul_def, smul_eq_mul]
  rw [e]
  refine (norm_integral_le_integral_norm _).trans ?_
  rw [← integral_const_mul]
  refine integral_mono_of_nonneg (Eventually.of_forall fun u => norm_nonneg _)
    (hm.const_mul _) (Eventually.of_forall fun u => ?_)
  simp only [norm_mul, cK, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hnn u)]
  have hb : ‖(1 : ℂ) - 𝐞 (-(u * ξ))‖ ≤ 2 * π * |u * ξ| := by
    rw [Real.fourierChar_apply, norm_sub_rev]
    have := Real.norm_exp_I_mul_ofReal_sub_one_le (x := 2 * π * -(u * ξ))
    rw [mul_comm Complex.I] at this
    push_cast at this ⊢
    refine this.trans (le_of_eq ?_)
    rw [Real.norm_eq_abs, abs_mul, abs_neg, abs_of_pos (by positivity : (0 : ℝ) < 2 * π)]
  calc ‖(1 : ℂ) - 𝐞 (-(u * ξ))‖ * a u ≤ 2 * π * |u * ξ| * a u :=
        mul_le_mul_of_nonneg_right hb (hnn u)
    _ = 2 * π * |ξ| * (|u| * a u) := by rw [abs_mul]; ring

/-- `|â(ξ)| ≤ ‖a'‖₁ / (2π|ξ|)` for a `C¹` compactly supported real `a`. -/
theorem norm_fourier_cK_le_deriv {a : ℝ → ℝ} (ha : ContDiff ℝ 1 a) (hc : HasCompactSupport a)
    {ξ : ℝ} (hξ : ξ ≠ 0) :
    ‖𝓕 (cK a) ξ‖ ≤ (∫ u, |deriv a u|) / (2 * π * |ξ|) := by
  have hcd : ContDiff ℝ 1 (cK a) := Complex.ofRealCLM.contDiff.comp ha
  have hcc : HasCompactSupport (cK a) := hc.comp_left Complex.ofReal_zero
  have hdiff : Differentiable ℝ (cK a) := hcd.differentiable one_ne_zero
  have hderiv : deriv (cK a) = cK (deriv a) := by
    ext u
    simp only [cK]
    exact ((ha.differentiable one_ne_zero u).hasDerivAt.ofReal_comp).deriv
  have hdc : Continuous (deriv a) := ha.continuous_deriv le_rfl
  have hdcs : HasCompactSupport (deriv a) := hc.deriv
  have hdi : Integrable (cK (deriv a)) :=
    integrable_cK (hdc.integrable_of_hasCompactSupport hdcs)
  have hF := congrFun (Real.fourier_deriv (hcd.continuous.integrable_of_hasCompactSupport hcc)
    hdiff (by rw [hderiv]; exact hdi)) ξ
  rw [hderiv, smul_eq_mul] at hF
  have hpos : 0 < 2 * π * |ξ| := by positivity
  have hn : ‖(2 * π * Complex.I * ξ : ℂ)‖ = 2 * π * |ξ| := by
    simp [Complex.norm_real, abs_of_pos Real.pi_pos]
  rw [le_div_iff₀ hpos, ← hn, ← norm_mul, mul_comm, ← hF]
  refine (norm_fourier_le_integral_norm _ ξ).trans (le_of_eq ?_)
  simp [cK, Complex.norm_real, Real.norm_eq_abs]

/-- `𝓕(φ_k)(ξ) = 𝓕 φ(ξ/2^k)` for `φ_k = 2^k φ(2^k ·)`. -/
theorem fourier_cK_dil (a : ℝ → ℝ) (k : ℕ) (ξ : ℝ) :
    𝓕 (cK (dil a k)) ξ = 𝓕 (cK a) (ξ / 2 ^ k) := by
  have e : cK (dil a k) = fun s => ((2 ^ k : ℝ) : ℂ) * cK a ((2 ^ k : ℝ) * s) := by
    ext s; simp [cK, dil]
  rw [e, mloc_fourier_dil (cK a) (by positivity : (0 : ℝ) < 2 ^ k) ξ]

/-- Every fiber of `G` along coordinate `j` lies in `L¹ ∩ L²(ℝ)`. -/
def FibL12 (j : Fin 2) (G : ℝ × ℝ → ℂ) : Prop :=
  ∀ p, Integrable (monoFib j G p) ∧ MemLp (monoFib j G p) 2

/-- The fiberwise Fourier transform `(p, ξ) ↦ 𝓕(G(·, p))(ξ)`. -/
def fibF (j : Fin 2) (G : ℝ × ℝ → ℂ) (q : ℝ × ℝ) : ℂ := 𝓕 (monoFib j G q.1) q.2

theorem measurable_fibF (j : Fin 2) {G : ℝ × ℝ → ℂ} (hG : Measurable G) : Measurable (fibF j G) :=
  measurable_fourier_fib j hG

theorem lintegral_sq_eq_fibF (j : Fin 2) {G : ℝ × ℝ → ℂ} (hG : Measurable G)
    (hfib : FibL12 j G) :
    ∫⁻ z, ‖G z‖ₑ ^ 2 = ∫⁻ q, ‖fibF j G q‖ₑ ^ 2 := by
  rw [lintegral_monoPt j (hG.enorm.pow_const 2), Measure.volume_eq_prod,
    lintegral_prod _ ((measurable_fibF j hG).enorm.pow_const 2).aemeasurable]
  refine lintegral_congr fun p => ?_
  exact (lintegral_fourier_sq_eq (hfib p).1 (hfib p).2).symm

theorem eLpNorm_two_eq_lintegral_nat {f : ℝ × ℝ → ℂ} :
    eLpNorm f 2 volume = (∫⁻ z, ‖f z‖ₑ ^ 2) ^ (1 / 2 : ℝ) := by
  rw [eLpNorm_two_eq_lintegral]
  congr 1
  refine lintegral_congr fun z => ?_
  exact ENNReal.rpow_two _

theorem eLpNorm_eq_fibF (j : Fin 2) {G : ℝ × ℝ → ℂ} (hG : Measurable G) (hfib : FibL12 j G) :
    eLpNorm G 2 volume = eLpNorm (fibF j G) 2 volume := by
  rw [eLpNorm_two_eq_lintegral_nat, eLpNorm_two_eq_lintegral_nat, lintegral_sq_eq_fibF j hG hfib]

/-- **Fiberwise Plancherel comparison.** If the fiberwise Fourier transforms satisfy
`|Ĝ₁| ≤ |Ĝ₂| + c |F̂|` pointwise, then `‖G₁‖₂ ≤ ‖G₂‖₂ + c ‖F‖₂`. -/
theorem eLpNorm_le_of_fibF_le (j : Fin 2) {G₁ G₂ F : ℝ × ℝ → ℂ} (h₁ : Measurable G₁)
    (h₂ : Measurable G₂) (hF : Measurable F) (f₁ : FibL12 j G₁) (f₂ : FibL12 j G₂)
    (fF : FibL12 j F) {c : ℝ} (hc : 0 ≤ c)
    (hle : ∀ q, ‖fibF j G₁ q‖ ≤ ‖fibF j G₂ q‖ + c * ‖fibF j F q‖) :
    eLpNorm G₁ 2 volume ≤ eLpNorm G₂ 2 volume + ENNReal.ofReal c * eLpNorm F 2 volume := by
  rw [eLpNorm_eq_fibF j h₁ f₁, eLpNorm_eq_fibF j h₂ f₂, eLpNorm_eq_fibF j hF fF]
  have m₂ := (measurable_fibF j h₂).norm
  have mF := ((measurable_fibF j hF).norm).const_mul c
  calc eLpNorm (fibF j G₁) 2 volume
      ≤ eLpNorm (fun q => ‖fibF j G₂ q‖ + c * ‖fibF j F q‖) 2 volume := by
        refine eLpNorm_mono fun q => ?_
        rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
        exact hle q
    _ ≤ eLpNorm (fun q => ‖fibF j G₂ q‖) 2 volume +
          eLpNorm (fun q => c * ‖fibF j F q‖) 2 volume :=
        eLpNorm_add_le m₂.aestronglyMeasurable mF.aestronglyMeasurable (by norm_num)
    _ = eLpNorm (fibF j G₂) 2 volume + ENNReal.ofReal c * eLpNorm (fibF j F) 2 volume := by
        congr 1
        · exact eLpNorm_norm _
        · rw [show (fun q => c * ‖fibF j F q‖) = c • fun q => ‖fibF j F q‖ from rfl,
            eLpNorm_const_smul, eLpNorm_norm, Real.enorm_eq_ofReal hc]

/-- **Fiberwise almost orthogonality.** If `∑_l |Ĝ_l|^2 ≤ B |F̂|^2` pointwise then
`∑_l ‖G_l‖_2^2 ≤ B ‖F‖_2^2`. -/
theorem sum_lintegral_sq_le_of_fibF {ι : Type*} (S : Finset ι) (j : Fin 2) {G : ι → ℝ × ℝ → ℂ}
    {F : ℝ × ℝ → ℂ} (hG : ∀ l, Measurable (G l)) (hF : Measurable F)
    (fG : ∀ l, FibL12 j (G l)) (fF : FibL12 j F) {B : ℝ} (hB : 0 ≤ B)
    (hle : ∀ q, ∑ l ∈ S, ‖fibF j (G l) q‖ ^ 2 ≤ B * ‖fibF j F q‖ ^ 2) :
    ∑ l ∈ S, ∫⁻ z, ‖G l z‖ₑ ^ 2 ≤ ENNReal.ofReal B * ∫⁻ z, ‖F z‖ₑ ^ 2 := by
  simp_rw [lintegral_sq_eq_fibF j (hG _) (fG _), lintegral_sq_eq_fibF j hF fF]
  rw [← lintegral_finsetSum _ fun l _ => ((measurable_fibF j (hG l)).enorm.pow_const 2),
    ← lintegral_const_mul _ ((measurable_fibF j hF).enorm.pow_const 2)]
  refine lintegral_mono fun q => ?_
  have h := hle q
  have e : ∀ x : ℂ, ‖x‖ₑ ^ 2 = ENNReal.ofReal (‖x‖ ^ 2) := fun x => by
    rw [← ofReal_norm, ENNReal.ofReal_pow (norm_nonneg _)]
  simp_rw [e]
  rw [← ENNReal.ofReal_sum_of_nonneg (fun l _ => by positivity), ← ENNReal.ofReal_mul hB]
  exact ENNReal.ofReal_le_ofReal h

/-- The fiber of a coordinate convolution is a convolution, with Fourier transform `K̂ F̂`. -/
theorem fibF_monoCConv (j : Fin 2) {K : ℝ → ℂ} (hK : Integrable K) {F : ℝ × ℝ → ℂ}
    (hF : ∀ p, Integrable (monoFib j F p)) (q : ℝ × ℝ) :
    fibF j (monoCConv j K F) q = 𝓕 K q.2 * fibF j F q := by
  unfold fibF
  have e : monoFib j (monoCConv j K F) q.1 = K ⋆[ContinuousLinearMap.mul ℂ ℂ] monoFib j F q.1 :=
    funext (monoCConv_fib j K F q.1)
  rw [e]
  exact Real.fourier_mul_convolution_eq hK (hF q.1) q.2

theorem integrable_fib_monoCConv (j : Fin 2) {K : ℝ → ℂ} (hK : Integrable K) {F : ℝ × ℝ → ℂ}
    (hF : ∀ p, Integrable (monoFib j F p)) (p : ℝ) :
    Integrable (monoFib j (monoCConv j K F) p) := by
  have e : monoFib j (monoCConv j K F) p = K ⋆[ContinuousLinearMap.mul ℂ ℂ] monoFib j F p :=
    funext (monoCConv_fib j K F p)
  rw [e]
  exact hK.integrable_convolution _ (hF p)

theorem fibL12_monoCConv (j : Fin 2) {K : ℝ → ℂ} (hK : Integrable K) {F : ℝ × ℝ → ℂ}
    (hF : ∀ p, Integrable (monoFib j F p)) {M : ℝ} (hM : ∀ z, ‖F z‖ ≤ M) :
    FibL12 j (monoCConv j K F) := fun p =>
  ⟨integrable_fib_monoCConv j hK hF p, memLp_two_of_bdd (integrable_fib_monoCConv j hK hF p)
    fun _ => norm_monoCConv_le hK hM _⟩

/-! ### The fixed bumps `ϑ` and `τ` of the proof of Theorem 4 -/

/-- The bump underlying `ϑ`: equal to `1` on `[-1,1]`, supported in `(-2,2)`. -/
def thetaBump : ContDiffBump (0 : ℝ) := ⟨1, 2, one_pos, one_lt_two⟩

/-- `ϑ`: the normalized bump (`∫ ϑ = 1`), constant on `[-1,1]`, supported in `[-2,2]`. -/
def thetaC : ℝ → ℝ := thetaBump.normed volume

/-- The bump underlying `τ`: supported in `(1/2, 2)`. -/
def tauBump : ContDiffBump (5 / 4 : ℝ) := ⟨1 / 2, 3 / 4, by norm_num, by norm_num⟩

/-- `τ`: smooth, supported in `[1/2,2]`, with values in `[0,1]` and `∫ τ = 1`. -/
def tauC : ℝ → ℝ := tauBump.normed volume

theorem thetaC_contDiff : ContDiff ℝ ∞ thetaC := thetaBump.contDiff_normed
theorem tauC_contDiff : ContDiff ℝ ∞ tauC := tauBump.contDiff_normed
theorem thetaC_nonneg (x : ℝ) : 0 ≤ thetaC x := thetaBump.nonneg_normed x
theorem tauC_nonneg (x : ℝ) : 0 ≤ tauC x := tauBump.nonneg_normed x
theorem thetaC_integral : ∫ x, thetaC x = 1 := thetaBump.integral_normed
theorem tauC_integral : ∫ x, tauC x = 1 := tauBump.integral_normed
theorem thetaC_hasCompactSupport : HasCompactSupport thetaC := thetaBump.hasCompactSupport_normed
theorem tauC_hasCompactSupport : HasCompactSupport tauC := tauBump.hasCompactSupport_normed
theorem thetaC_integrable : Integrable thetaC := thetaBump.integrable_normed
theorem tauC_integrable : Integrable tauC := tauBump.integrable_normed

theorem thetaC_support : Function.support thetaC ⊆ Icc (-2) 2 := by
  rw [thetaC, thetaBump.support_normed_eq, Real.ball_eq_Ioo]
  intro x hx; simp only [thetaBump, mem_Ioo, zero_sub, zero_add] at hx
  exact ⟨hx.1.le, hx.2.le⟩

theorem tauC_tsupport : tsupport tauC ⊆ Icc (1 / 2) 2 := by
  rw [tauC, tauBump.tsupport_normed_eq, Real.closedBall_eq_Icc]
  intro x hx; simp only [tauBump, mem_Icc] at hx
  constructor <;> linarith [hx.1, hx.2]

theorem tauC_eq_zero {x : ℝ} (hx : x ∉ Icc (1 / 2 : ℝ) 2) : tauC x = 0 :=
  image_eq_zero_of_notMem_tsupport fun h => hx (tauC_tsupport h)

theorem tauC_le_one (x : ℝ) : tauC x ≤ 1 := by
  have h := tauBump.normed_le_div_measure_closedBall_rIn volume x
  have hv : volume.real (Metric.closedBall (5 / 4 : ℝ) tauBump.rIn) = 1 := by
    rw [Real.closedBall_eq_Icc, Measure.real, Real.volume_Icc, ENNReal.toReal_ofReal]
    · norm_num [tauBump]
    · norm_num [tauBump]
  rw [hv, div_one] at h
  exact h

theorem thetaC_const {x : ℝ} (hx : x ∈ Icc (-1 : ℝ) 1) : thetaC x = thetaC 0 := by
  have h1 : ∀ y ∈ Metric.closedBall (0 : ℝ) thetaBump.rIn, thetaBump y = 1 := fun y hy =>
    thetaBump.one_of_mem_closedBall hy
  rw [thetaC, thetaBump.normed_def, thetaBump.normed_def, h1 x, h1 0]
  · simp [thetaBump]
  · rw [Real.closedBall_eq_Icc]; simpa [thetaBump] using hx

theorem thetaC_zero_pos : 0 < thetaC 0 := by
  rw [thetaC, thetaBump.normed_def, thetaBump.one_of_mem_closedBall (by simp [thetaBump])]
  exact one_div_pos.2 (thetaBump.integral_pos)

theorem integrable_moment_of_hasCompactSupport {a : ℝ → ℝ} (hc : Continuous a)
    (hcs : HasCompactSupport a) : Integrable fun u => |u| * a u :=
  (continuous_abs.mul hc).integrable_of_hasCompactSupport (hcs.mul_left)

theorem thetaC_dil_integral (k : ℕ) : ∫ u, dil thetaC k u = 1 := by
  simp only [dil]
  rw [integral_const_mul, Measure.integral_comp_mul_left (fun u => thetaC u), thetaC_integral,
    abs_inv, abs_of_pos (by positivity : (0 : ℝ) < 2 ^ k), smul_eq_mul, mul_one]
  field_simp

theorem dil_integral {a : ℝ → ℝ} (ha : ∫ u, a u = 1) (k : ℕ) : ∫ u, dil a k u = 1 := by
  simp only [dil]
  rw [integral_const_mul, Measure.integral_comp_mul_left (fun u => a u), ha,
    abs_inv, abs_of_pos (by positivity : (0 : ℝ) < 2 ^ k), smul_eq_mul, mul_one]
  field_simp

/-! ### Functions on the unit square -/

/-- The unit square `[0,1]^2`. -/
abbrev sq01 : Set (ℝ × ℝ) := Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1

/-- `f` is measurable, `0 ≤ f ≤ 1`, and `f` vanishes off `[0,1]^2`. -/
structure SqFun (f : ℝ × ℝ → ℝ) : Prop where
  meas : Measurable f
  nonneg : ∀ z, 0 ≤ f z
  le_one : ∀ z, f z ≤ 1
  supp : ∀ z ∉ sq01, f z = 0

/-- `f` as a complex function. -/
def fc (f : ℝ × ℝ → ℝ) (z : ℝ × ℝ) : ℂ := (f z : ℂ)

theorem volume_sq01 : volume sq01 = 1 := by
  change volume (Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1) = 1
  rw [Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Icc]; simp

namespace SqFun

variable {f : ℝ × ℝ → ℝ} (hf : SqFun f)
include hf

theorem abs_le (z : ℝ × ℝ) : |f z| ≤ 1 := by rw [abs_of_nonneg (hf.nonneg z)]; exact hf.le_one z

theorem norm_fc_le (z : ℝ × ℝ) : ‖fc f z‖ ≤ 1 := by
  rw [fc, Complex.norm_real, Real.norm_eq_abs]; exact hf.abs_le z

theorem measurable_fc : Measurable (fc f) := Complex.measurable_ofReal.comp hf.meas

theorem norm_fc_le_indicator (z : ℝ × ℝ) : ‖fc f z‖ ≤ sq01.indicator 1 z := by
  by_cases h : z ∈ sq01
  · rw [indicator_of_mem h]; exact hf.norm_fc_le z
  · rw [indicator_of_notMem h, fc, hf.supp z h]; simp

theorem enorm_fc_le_indicator (z : ℝ × ℝ) : ‖fc f z‖ₑ ≤ sq01.indicator 1 z := by
  have h := hf.norm_fc_le_indicator z
  rw [← ofReal_norm]
  by_cases hz : z ∈ sq01
  · rw [indicator_of_mem hz] at h ⊢
    simpa using ENNReal.ofReal_le_ofReal h
  · rw [indicator_of_notMem hz] at h ⊢
    simp [le_antisymm h (norm_nonneg _)]

theorem lintegral_enorm_fc_le : ∫⁻ z, ‖fc f z‖ₑ ≤ 1 := by
  calc ∫⁻ z, ‖fc f z‖ₑ ≤ ∫⁻ z, sq01.indicator 1 z := lintegral_mono hf.enorm_fc_le_indicator
    _ = 1 := by
      rw [lintegral_indicator (measurableSet_Icc.prod measurableSet_Icc)]
      simp only [Pi.one_apply, setLIntegral_one, volume_sq01]

theorem lintegral_enorm_fc_sq_le : ∫⁻ z, ‖fc f z‖ₑ ^ 2 ≤ 1 := by
  calc ∫⁻ z, ‖fc f z‖ₑ ^ 2 ≤ ∫⁻ z, ‖fc f z‖ₑ := lintegral_mono fun z => by
        have h1 : ‖fc f z‖ₑ ≤ 1 := by
          rw [← ofReal_norm]; simpa using ENNReal.ofReal_le_ofReal (hf.norm_fc_le z)
        calc ‖fc f z‖ₑ ^ 2 = ‖fc f z‖ₑ * ‖fc f z‖ₑ := sq _
          _ ≤ ‖fc f z‖ₑ * 1 := by gcongr
          _ = ‖fc f z‖ₑ := mul_one _
    _ ≤ 1 := hf.lintegral_enorm_fc_le

theorem eLpNorm_fc_le : eLpNorm (fc f) 2 volume ≤ 1 := by
  rw [eLpNorm_two_eq_lintegral_nat]
  calc (∫⁻ z, ‖fc f z‖ₑ ^ 2) ^ (1 / 2 : ℝ) ≤ 1 ^ (1 / 2 : ℝ) :=
        ENNReal.rpow_le_rpow hf.lintegral_enorm_fc_sq_le (by norm_num)
    _ = 1 := ENNReal.one_rpow _

theorem fib_eq_zero (j : Fin 2) (p : ℝ) {a : ℝ} (ha : a ∉ Icc (0 : ℝ) 1) :
    monoFib j (fc f) p a = 0 := by
  rw [monoFib, fc, hf.supp, Complex.ofReal_zero]
  intro h
  fin_cases j
  · simp only [monoPt, Fin.zero_eta, if_true, Set.mem_prod] at h; exact ha h.1
  · simp only [monoPt, Fin.mk_one, one_ne_zero, if_false, Set.mem_prod] at h; exact ha h.2

theorem integrable_fib (j : Fin 2) (p : ℝ) : Integrable (monoFib j (fc f) p) := by
  have hm : Measurable (monoFib j (fc f) p) := measurable_monoFib hf.measurable_fc p
  have hcs : ∀ a, a ∉ Icc (0 : ℝ) 1 → monoFib j (fc f) p a = 0 := fun a ha => hf.fib_eq_zero j p ha
  have hi : IntegrableOn (monoFib j (fc f) p) (Icc (0 : ℝ) 1) :=
    Measure.integrableOn_of_bounded (M := 1) (by simp) hm.aestronglyMeasurable
      (Eventually.of_forall fun a => hf.norm_fc_le _)
  exact (integrableOn_iff_integrable_of_support_subset fun a ha => by
    by_contra h; exact ha (hcs a h)).1 hi

theorem fibL12 (j : Fin 2) : FibL12 j (fc f) := fun p =>
  ⟨hf.integrable_fib j p, memLp_two_of_bdd (hf.integrable_fib j p) fun _ => hf.norm_fc_le _⟩

end SqFun

/-! ### The bilinear average along `(t, t^2)` and the elementary bound (1.2) -/

theorem measurable_shift1 : Measurable fun p : (ℝ × ℝ) × ℝ => (p.1.1 + p.2 ^ 1, p.1.2) := by
  fun_prop

theorem measurable_shift2 : Measurable fun p : (ℝ × ℝ) × ℝ => (p.1.1, p.1.2 + p.2 ^ 2) := by
  fun_prop

/-- **The elementary bound (1.2)** for `A_ψ = ms8AvgP 1 2 ψ`:
`‖A_ψ(f_1,f_2)‖_1 ≤ ‖ψ‖_1 ‖f_1‖_2 ‖f_2‖_2`. -/
theorem eLpNorm_ms8AvgP_le {ψ : ℝ → ℝ} (hψ : Measurable ψ) {f₁ f₂ : ℝ × ℝ → ℂ}
    (hf₁ : Measurable f₁) (hf₂ : Measurable f₂) :
    eLpNorm (ms8AvgP 1 2 ψ f₁ f₂) 1 volume
      ≤ (∫⁻ t, ‖ψ t‖ₑ) * (eLpNorm f₁ 2 volume * eLpNorm f₂ 2 volume) := by
  rw [eLpNorm_one_eq_lintegral_enorm]
  have hmeas : Measurable (Function.uncurry fun (z : ℝ × ℝ) (t : ℝ) =>
      ‖ψ t‖ₑ * (‖f₁ (z.1 + t ^ 1, z.2)‖ₑ * ‖f₂ (z.1, z.2 + t ^ 2)‖ₑ)) :=
    (hψ.comp measurable_snd).enorm.mul ((hf₁.comp measurable_shift1).enorm.mul
      (hf₂.comp measurable_shift2).enorm)
  have hpt : ∀ z, ‖ms8AvgP 1 2 ψ f₁ f₂ z‖ₑ ≤
      ∫⁻ t, ‖ψ t‖ₑ * (‖f₁ (z.1 + t ^ 1, z.2)‖ₑ * ‖f₂ (z.1, z.2 + t ^ 2)‖ₑ) := fun z => by
    unfold ms8AvgP
    refine (enorm_integral_le_lintegral_enorm _).trans (le_of_eq (lintegral_congr fun t => ?_))
    simp only [enorm_mul, monoEnorm_ofReal]
  calc ∫⁻ z : ℝ × ℝ, ‖ms8AvgP 1 2 ψ f₁ f₂ z‖ₑ
      ≤ ∫⁻ z : ℝ × ℝ, ∫⁻ t : ℝ, ‖ψ t‖ₑ * (‖f₁ (z.1 + t ^ 1, z.2)‖ₑ * ‖f₂ (z.1, z.2 + t ^ 2)‖ₑ) :=
        lintegral_mono hpt
    _ = ∫⁻ t : ℝ, ∫⁻ z : ℝ × ℝ, ‖ψ t‖ₑ * (‖f₁ (z.1 + t ^ 1, z.2)‖ₑ * ‖f₂ (z.1, z.2 + t ^ 2)‖ₑ) :=
        lintegral_lintegral_swap hmeas.aemeasurable
    _ = ∫⁻ t : ℝ, ‖ψ t‖ₑ * ∫⁻ z : ℝ × ℝ, ‖f₁ (z + (t ^ 1, 0))‖ₑ * ‖f₂ (z + (0, t ^ 2))‖ₑ := by
        refine lintegral_congr fun t => ?_
        rw [← lintegral_const_mul]
        · refine lintegral_congr fun z => ?_
          rw [show z + (t ^ 1, 0) = (z.1 + t ^ 1, z.2) from Prod.ext rfl (add_zero _),
            show z + (0, t ^ 2) = (z.1, z.2 + t ^ 2) from Prod.ext (add_zero _) rfl]
        · exact ((hf₁.comp (measurable_add_const _)).enorm.mul
            (hf₂.comp (measurable_add_const _)).enorm)
    _ ≤ ∫⁻ t : ℝ, ‖ψ t‖ₑ * (eLpNorm f₁ 2 volume * eLpNorm f₂ 2 volume) := by
        gcongr with t
        exact lintegral_translate_mul_le hf₁ hf₂ _ _
    _ = _ := by rw [lintegral_mul_const _ hψ.enorm]

/-- The trilinear quantity `W_ψ(h) = ∫ f(z) A_ψ(f, h)(z) dz`. -/
def Wform (f : ℝ × ℝ → ℝ) (ψ : ℝ → ℝ) (h : ℝ × ℝ → ℂ) : ℂ :=
  ∫ z, fc f z * ms8AvgP 1 2 ψ (fc f) h z

theorem enorm_Wform_le {f : ℝ × ℝ → ℝ} (hf : SqFun f) (ψ : ℝ → ℝ) (h : ℝ × ℝ → ℂ) :
    ‖Wform f ψ h‖ₑ ≤ eLpNorm (ms8AvgP 1 2 ψ (fc f) h) 1 volume := by
  rw [eLpNorm_one_eq_lintegral_enorm]
  refine (enorm_integral_le_lintegral_enorm _).trans (lintegral_mono fun z => ?_)
  rw [enorm_mul]
  have h1 : ‖fc f z‖ₑ ≤ 1 := by
    rw [← ofReal_norm]; simpa using ENNReal.ofReal_le_ofReal (hf.norm_fc_le z)
  calc ‖fc f z‖ₑ * ‖ms8AvgP 1 2 ψ (fc f) h z‖ₑ ≤ 1 * ‖ms8AvgP 1 2 ψ (fc f) h z‖ₑ := by gcongr
    _ = _ := one_mul _

/-- `|W_ψ(h)| ≤ ‖ψ‖_1 ‖h‖_2`. -/
theorem enorm_Wform_le_L2 {f : ℝ × ℝ → ℝ} (hf : SqFun f) {ψ : ℝ → ℝ} (hψ : Measurable ψ)
    {h : ℝ × ℝ → ℂ} (hh : Measurable h) :
    ‖Wform f ψ h‖ₑ ≤ (∫⁻ t, ‖ψ t‖ₑ) * eLpNorm h 2 volume := by
  refine (enorm_Wform_le hf ψ h).trans ((eLpNorm_ms8AvgP_le hψ hf.measurable_fc hh).trans ?_)
  calc (∫⁻ t, ‖ψ t‖ₑ) * (eLpNorm (fc f) 2 volume * eLpNorm h 2 volume)
      ≤ (∫⁻ t, ‖ψ t‖ₑ) * (1 * eLpNorm h 2 volume) := by gcongr; exact hf.eLpNorm_fc_le
    _ = _ := by rw [one_mul]

/-! ### Rescaling the smoothing inequality -/

theorem lintegral_comp_mul_left' {g : ℝ → ℝ≥0∞} (hg : Measurable g) {a : ℝ} (ha : a ≠ 0) :
    ∫⁻ x, g (a * x) = ENNReal.ofReal |a⁻¹| * ∫⁻ x, g x := by
  rw [← lintegral_map hg (measurable_const_mul a), Real.map_volume_mul_left ha,
    lintegral_smul_measure, smul_eq_mul]

/-- `∫⁻ F(a x, b y) = |a|⁻¹ |b|⁻¹ ∫⁻ F` on `ℝ × ℝ`. -/
theorem lintegral_comp_diag {F : ℝ × ℝ → ℝ≥0∞} (hF : Measurable F) {a b : ℝ} (ha : a ≠ 0)
    (hb : b ≠ 0) :
    ∫⁻ z : ℝ × ℝ, F (a * z.1, b * z.2) =
      ENNReal.ofReal |a⁻¹| * ENNReal.ofReal |b⁻¹| * ∫⁻ z, F z := by
  have hm : Measurable fun z : ℝ × ℝ => F (a * z.1, b * z.2) :=
    hF.comp ((measurable_const.mul measurable_fst).prodMk (measurable_const.mul measurable_snd))
  rw [Measure.volume_eq_prod, lintegral_prod _ hm.aemeasurable, lintegral_prod _ hF.aemeasurable]
  have h1 : ∀ x, ∫⁻ y, F (a * x, b * y) = ENNReal.ofReal |b⁻¹| * ∫⁻ y, F (a * x, y) := fun x =>
    lintegral_comp_mul_left' (hF.comp (measurable_const.prodMk measurable_id)) hb
  simp_rw [h1]
  have hg : Measurable fun x => ∫⁻ y, F (x, y) := hF.lintegral_prod_right'
  have e1 := lintegral_const_mul (μ := volume) (ENNReal.ofReal |b⁻¹|)
    (f := fun x => ∫⁻ y, F (a * x, y))
    (hg.comp (measurable_const_mul a))
  have e2 : ∫⁻ x, ∫⁻ y, F (a * x, y) = ENNReal.ofReal |a⁻¹| * ∫⁻ x, ∫⁻ y, F (x, y) :=
    lintegral_comp_mul_left' (g := fun x => ∫⁻ y, F (x, y)) hg ha
  rw [e1, e2]
  ring

/-- The diagonal dilation `D_s(u,v) = (s u, s^2 v)`. -/
def dS (s : ℝ) (z : ℝ × ℝ) : ℝ × ℝ := (s * z.1, s ^ 2 * z.2)

theorem measurable_dS (s : ℝ) : Measurable (dS s) :=
  (measurable_const.mul measurable_fst).prodMk (measurable_const.mul measurable_snd)

theorem ms8AvgP_dil_eq (ψ : ℝ → ℝ) (k : ℕ) (f₁ f₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) :
    ms8AvgP 1 2 (dil ψ k) f₁ f₂ z =
      ms8AvgP 1 2 ψ (f₁ ∘ dS (2 ^ k)⁻¹) (f₂ ∘ dS (2 ^ k)⁻¹) (2 ^ k * z.1, (2 ^ k) ^ 2 * z.2) := by
  have hk : (0 : ℝ) < 2 ^ k := by positivity
  unfold ms8AvgP
  set G : ℝ → ℂ := fun r => (ψ r : ℂ) * (f₁ (z.1 + (2 ^ k)⁻¹ * r, z.2) *
    f₂ (z.1, z.2 + ((2 ^ k)⁻¹) ^ 2 * r ^ 2)) with hG
  have e1 : ∀ t : ℝ, ((dil ψ k t : ℝ) : ℂ) * (f₁ (z.1 + t ^ 1, z.2) * f₂ (z.1, z.2 + t ^ 2)) =
      ((2 ^ k : ℝ) : ℂ) * G (2 ^ k * t) := by
    intro t
    simp only [hG, dil, pow_one]
    have : (2 ^ k : ℝ)⁻¹ * (2 ^ k * t) = t := by field_simp
    rw [this, show ((2 ^ k : ℝ)⁻¹) ^ 2 * (2 ^ k * t) ^ 2 = t ^ 2 by field_simp]
    push_cast; ring
  simp_rw [e1]
  rw [integral_const_mul, Measure.integral_comp_mul_left G (2 ^ k), abs_inv, abs_of_pos hk,
    Complex.real_smul, ← mul_assoc, Complex.ofReal_inv]
  rw [mul_inv_cancel₀ (by exact_mod_cast hk.ne'), one_mul]
  refine integral_congr_ae (Eventually.of_forall fun r => ?_)
  simp only [hG, dS, Function.comp, pow_one]
  congr 3
  · ext <;> simp; field_simp
  · ext <;> simp; field_simp

theorem fourier_comp_mul (F : ℝ → ℂ) {c : ℝ} (hc : 0 < c) (ξ : ℝ) :
    𝓕 (fun a => F (c * a)) ξ = ((c⁻¹ : ℝ) : ℂ) * 𝓕 F (ξ / c) := by
  rw [Real.fourier_real_eq, Real.fourier_real_eq]
  have h := Measure.integral_comp_mul_left (fun t => 𝐞 (-(t * (ξ / c))) • F t) c
  have e : ∀ a : ℝ, 𝐞 (-(a * ξ)) • F (c * a) = 𝐞 (-(c * a * (ξ / c))) • F (c * a) := by
    intro a; rw [show c * a * (ξ / c) = a * ξ by field_simp]
  simp_rw [e]
  rw [h, abs_inv, abs_of_pos hc, Complex.real_smul, Complex.ofReal_inv]

theorem lintegral_enorm_sq_comp_dS {f : ℝ × ℝ → ℂ} (hf : Measurable f) (k : ℕ) :
    ∫⁻ z, ‖(f ∘ dS (2 ^ k)⁻¹) z‖ₑ ^ 2 = ENNReal.ofReal (2 ^ k * 4 ^ k) * ∫⁻ z, ‖f z‖ₑ ^ 2 := by
  have h := lintegral_comp_diag (F := fun z => ‖f z‖ₑ ^ 2) (hf.enorm.pow_const 2)
    (a := (2 ^ k : ℝ)⁻¹) (b := ((2 ^ k : ℝ)⁻¹) ^ 2) (by positivity) (by positivity)
  simp only [Function.comp, dS]
  rw [h, ← ENNReal.ofReal_mul (abs_nonneg _)]
  congr 2
  rw [inv_inv, abs_of_pos (by positivity), inv_pow, inv_inv, abs_of_pos (by positivity)]
  rw [show (4 : ℝ) ^ k = (2 ^ k) ^ 2 by rw [← pow_mul, mul_comm, pow_mul]; norm_num]

theorem eLpNorm_comp_dS {f : ℝ × ℝ → ℂ} (hf : Measurable f) (k : ℕ) :
    eLpNorm (f ∘ dS (2 ^ k)⁻¹) 2 volume =
      ENNReal.ofReal (2 ^ k * 4 ^ k) ^ (1 / 2 : ℝ) * eLpNorm f 2 volume := by
  rw [eLpNorm_two_eq_lintegral_nat, eLpNorm_two_eq_lintegral_nat, lintegral_enorm_sq_comp_dS hf,
    ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]

/-- **The smoothing inequality at scale `2^{-k}`** (global form of Theorem 5 for the curve
`(t, t^2)`, from `Auto.ms8_plane`): for `Λ ≥ 4^k` and `f₂` with fibers of frequency `≥ Λ` in
the second variable, `‖A_{τ_k}(f₁, f₂)‖_1 ≤ C (Λ / 4^k)^{-δ} ‖f₁‖_2 ‖f₂‖_2`. -/
theorem scaled_smoothing : ∃ C δ : ℝ, 0 < C ∧ 0 < δ ∧ ∀ (k : ℕ) (Λ : ℝ), (4 : ℝ) ^ k ≤ Λ →
    ∀ f₁ f₂ : ℝ × ℝ → ℂ, Measurable f₁ → Measurable f₂ →
    ∀ M₁ M₂ : ℝ, (∀ z, ‖f₁ z‖ ≤ M₁) → (∀ z, ‖f₂ z‖ ≤ M₂) →
    (∀ p, Integrable (monoFib 0 f₁ p) volume) → (∀ p, Integrable (monoFib 1 f₂ p) volume) →
    eLpNorm f₁ 2 volume ≠ ⊤ → eLpNorm f₂ 2 volume ≠ ⊤ →
    (∀ p ξ, |ξ| < Λ → 𝓕 (monoFib 1 f₂ p) ξ = 0) →
    eLpNorm (ms8AvgP 1 2 (dil tauC k) f₁ f₂) 1 volume ≤
      ENNReal.ofReal (C * (Λ / 4 ^ k) ^ (-δ)) * (eLpNorm f₁ 2 volume * eLpNorm f₂ 2 volume) := by
  obtain ⟨C, δ, hC, hδ, hpl⟩ := ms8_plane
    (fun _ _ _ hr hA hAB => ms7_global hr hA hAB (mono_local61 hr hA hAB (mlc_locCorr hr hA hAB)))
    (m := 1) (n := 2) one_pos (by norm_num) (a := 1 / 2) (b := 2) (by norm_num) (by norm_num)
  set Cτ := (⨆ t, |tauC t|) + ∫ t, |deriv tauC t|
  have hCτ : 0 ≤ Cτ := by
    have h1 : 0 ≤ ⨆ t, |tauC t| := Real.iSup_nonneg fun t => abs_nonneg _
    have h2 : 0 ≤ ∫ t, |deriv tauC t| := integral_nonneg fun t => abs_nonneg _
    linarith
  refine ⟨C * Cτ + 1, δ, by positivity, hδ, ?_⟩
  intro k Λ hΛ f₁ f₂ hf₁ hf₂ M₁ M₂ hM₁ hM₂ hfib₁ hfib₂ h2₁ h2₂ hF
  have hk : (0 : ℝ) < 2 ^ k := by positivity
  have h4 : (0 : ℝ) < 4 ^ k := by positivity
  set s : ℝ := (2 ^ k)⁻¹ with hs
  have hspos : 0 < s := by positivity
  set g₁ := f₁ ∘ dS s
  set g₂ := f₂ ∘ dS s
  have hg₁ : Measurable g₁ := hf₁.comp (measurable_dS s)
  have hg₂ : Measurable g₂ := hf₂.comp (measurable_dS s)
  have hΛ' : 1 ≤ Λ / 4 ^ k := by rw [le_div_iff₀ h4]; linarith
  have hs2 : s ^ 2 = (4 ^ k)⁻¹ := by
    rw [hs, inv_pow, ← pow_mul, mul_comm, pow_mul]; norm_num
  -- the hypotheses of `ms8_plane` for the rescaled inputs
  have hfibg₁ : ∀ p, Integrable (monoFib 0 g₁ p) volume := fun p => by
    have e : monoFib 0 g₁ p = fun a => monoFib 0 f₁ (s ^ 2 * p) (s * a) := by
      ext a; simp [monoFib, monoPt, g₁, dS]
    rw [e]; exact (hfib₁ _).comp_mul_left' hspos.ne'
  have hfibg₂ : ∀ p, Integrable (monoFib 1 g₂ p) volume := fun p => by
    have e : monoFib 1 g₂ p = fun a => monoFib 1 f₂ (s * p) (s ^ 2 * a) := by
      ext a; simp [monoFib, monoPt, g₂, dS]
    rw [e]; exact (hfib₂ _).comp_mul_left' (by positivity)
  have hX : ENNReal.ofReal (2 ^ k * 4 ^ k) ^ (1 / 2 : ℝ) ≠ ⊤ :=
    ENNReal.rpow_ne_top_of_nonneg (by norm_num) ENNReal.ofReal_ne_top
  have hn₁ : eLpNorm g₁ 2 volume ≠ ⊤ := by
    rw [eLpNorm_comp_dS hf₁ k]; exact ENNReal.mul_ne_top hX h2₁
  have hn₂ : eLpNorm g₂ 2 volume ≠ ⊤ := by
    rw [eLpNorm_comp_dS hf₂ k]; exact ENNReal.mul_ne_top hX h2₂
  have hFg : ∀ p ξ, |ξ| < Λ / 4 ^ k → 𝓕 (monoFib 1 g₂ p) ξ = 0 := by
    intro p ξ hξ
    have e : monoFib 1 g₂ p = fun a => monoFib 1 f₂ (s * p) (s ^ 2 * a) := by
      ext a; simp [monoFib, monoPt, g₂, dS]
    rw [e, fourier_comp_mul _ (by positivity), hF, mul_zero]
    rw [abs_div, abs_of_pos (by positivity : (0 : ℝ) < s ^ 2), hs2, div_inv_eq_mul]
    rw [lt_div_iff₀ h4] at hξ
    linarith
  have hmain := hpl tauC (tauC_contDiff.of_le (by norm_num)) tauC_tsupport (Λ / 4 ^ k) hΛ' g₁ g₂
    hg₁ hg₂ M₁ M₂ (fun z => hM₁ _) (fun z => hM₂ _) hfibg₁ hfibg₂ hn₁ hn₂ (Or.inr hFg)
  -- undo the scaling
  have hscale : eLpNorm (ms8AvgP 1 2 (dil tauC k) f₁ f₂) 1 volume =
      ENNReal.ofReal (2 ^ k * 4 ^ k)⁻¹ * eLpNorm (ms8AvgP 1 2 tauC g₁ g₂) 1 volume := by
    rw [eLpNorm_one_eq_lintegral_enorm, eLpNorm_one_eq_lintegral_enorm]
    have hm : Measurable fun z => ‖ms8AvgP 1 2 tauC g₁ g₂ z‖ₑ := by
      refine (StronglyMeasurable.integral_prod_right' (ν := volume)
        (f := fun q : (ℝ × ℝ) × ℝ => (tauC q.2 : ℂ) * (g₁ (q.1.1 + q.2 ^ 1, q.1.2) *
          g₂ (q.1.1, q.1.2 + q.2 ^ 2))) ?_).measurable.enorm
      exact ((Complex.measurable_ofReal.comp (tauC_contDiff.continuous.measurable.comp
        measurable_snd)).mul ((hg₁.comp measurable_shift1).mul
        (hg₂.comp measurable_shift2))).stronglyMeasurable
    simp_rw [ms8AvgP_dil_eq tauC k f₁ f₂]
    rw [lintegral_comp_diag (F := fun z => ‖ms8AvgP 1 2 tauC g₁ g₂ z‖ₑ) hm hk.ne' (by positivity),
      ← ENNReal.ofReal_mul (abs_nonneg _)]
    congr 2
    rw [abs_of_pos (by positivity), abs_of_pos (by positivity), ← mul_inv]
    congr 1
    rw [show (4 : ℝ) ^ k = (2 ^ k) ^ 2 by rw [← pow_mul, mul_comm, pow_mul]; norm_num]
  rw [hscale]
  have hnorms : eLpNorm g₁ 2 volume * eLpNorm g₂ 2 volume =
      ENNReal.ofReal (2 ^ k * 4 ^ k) * (eLpNorm f₁ 2 volume * eLpNorm f₂ 2 volume) := by
    rw [eLpNorm_comp_dS hf₁ k, eLpNorm_comp_dS hf₂ k]
    have hX0 : ENNReal.ofReal (2 ^ k * 4 ^ k) ≠ 0 := by
      rw [Ne, ENNReal.ofReal_eq_zero, not_le]; positivity
    have : ENNReal.ofReal (2 ^ k * 4 ^ k) ^ (1 / 2 : ℝ) * ENNReal.ofReal (2 ^ k * 4 ^ k) ^ (1 / 2
        : ℝ)
        = ENNReal.ofReal (2 ^ k * 4 ^ k) := by
      rw [← ENNReal.rpow_add _ _ hX0 ENNReal.ofReal_ne_top]; norm_num
    calc ENNReal.ofReal (2 ^ k * 4 ^ k) ^ (1 / 2 : ℝ) * eLpNorm f₁ 2 volume *
          (ENNReal.ofReal (2 ^ k * 4 ^ k) ^ (1 / 2 : ℝ) * eLpNorm f₂ 2 volume)
        = (ENNReal.ofReal (2 ^ k * 4 ^ k) ^ (1 / 2 : ℝ) *
            ENNReal.ofReal (2 ^ k * 4 ^ k) ^ (1 / 2 : ℝ)) *
            (eLpNorm f₁ 2 volume * eLpNorm f₂ 2 volume) := by ring
      _ = _ := by rw [this]
  calc ENNReal.ofReal (2 ^ k * 4 ^ k)⁻¹ * eLpNorm (ms8AvgP 1 2 tauC g₁ g₂) 1 volume
      ≤ ENNReal.ofReal (2 ^ k * 4 ^ k)⁻¹ * (ENNReal.ofReal (C * Cτ * (Λ / 4 ^ k) ^ (-δ)) *
          (eLpNorm g₁ 2 volume * eLpNorm g₂ 2 volume)) := by gcongr
    _ = (ENNReal.ofReal (2 ^ k * 4 ^ k)⁻¹ * ENNReal.ofReal (2 ^ k * 4 ^ k)) *
          (ENNReal.ofReal (C * Cτ * (Λ / 4 ^ k) ^ (-δ)) *
          (eLpNorm f₁ 2 volume * eLpNorm f₂ 2 volume)) := by rw [hnorms]; ring
    _ = ENNReal.ofReal (C * Cτ * (Λ / 4 ^ k) ^ (-δ)) *
          (eLpNorm f₁ 2 volume * eLpNorm f₂ 2 volume) := by
        rw [← ENNReal.ofReal_mul (by positivity), inv_mul_cancel₀ (by positivity),
          ENNReal.ofReal_one, one_mul]
    _ ≤ _ := by
        gcongr
        have : 0 ≤ (Λ / 4 ^ k) ^ (-δ) := by positivity
        nlinarith

/-! ### Linearity and the main term -/

theorem dil_tauC_continuous (k : ℕ) : Continuous (dil tauC k) :=
  continuous_const.mul (tauC_contDiff.continuous.comp (continuous_const.mul continuous_id))

theorem dil_tauC_nonneg (k : ℕ) (t : ℝ) : 0 ≤ dil tauC k t := dil_nonneg tauC_nonneg k t

theorem dil_tauC_le (k : ℕ) (t : ℝ) : dil tauC k t ≤ 2 ^ k := by
  unfold dil
  calc (2 : ℝ) ^ k * tauC (2 ^ k * t) ≤ 2 ^ k * 1 := by gcongr; exact tauC_le_one _
    _ = 2 ^ k := mul_one _

theorem dil_tauC_eq_zero {k : ℕ} (hk : 1 ≤ k) {t : ℝ} (ht : t ∉ Icc (0 : ℝ) 1) :
    dil tauC k t = 0 := by
  unfold dil
  rw [tauC_eq_zero, mul_zero]
  intro h
  rw [mem_Icc] at h ht
  have h2 : (2 : ℝ) ≤ 2 ^ k := by
    calc (2 : ℝ) = 2 ^ 1 := (pow_one 2).symm
      _ ≤ 2 ^ k := pow_le_pow_right₀ (by norm_num) hk
  apply ht
  constructor
  · by_contra hneg; push Not at hneg
    have : 2 ^ k * t < 0 := mul_neg_of_pos_of_neg (by positivity) hneg
    linarith [h.1]
  · by_contra hgt; push Not at hgt
    have : 2 ^ k * t > 2 := by nlinarith
    linarith [h.2]

theorem integrable_dil_tauC (k : ℕ) : Integrable (dil tauC k) :=
  integrable_dil tauC_contDiff.continuous tauC_hasCompactSupport k

theorem lintegral_enorm_dil_tauC (k : ℕ) : ∫⁻ t, ‖dil tauC k t‖ₑ = 1 := by
  rw [lintegral_enorm_of_nonneg (dil_tauC_nonneg k)]
  rw [← ofReal_integral_eq_lintegral_ofReal (integrable_dil_tauC k)
    (Eventually.of_forall (dil_tauC_nonneg k)), dil_integral tauC_integral, ENNReal.ofReal_one]

/-- The `t`-integrand of `A_ψ(fc f, h)(z)` is integrable for bounded measurable `h`. -/
theorem integrable_ms8_integrand {f : ℝ × ℝ → ℝ} (hf : SqFun f) {ψ : ℝ → ℝ}
    (hψ : Integrable ψ) {h : ℝ × ℝ → ℂ} (hh : Measurable h) {M : ℝ} (hM : ∀ z, ‖h z‖ ≤ M)
    (z : ℝ × ℝ) :
    Integrable fun t : ℝ => (ψ t : ℂ) * (fc f (z.1 + t ^ 1, z.2) * h (z.1, z.2 + t ^ 2)) := by
  refine (hψ.ofReal).mul_bdd (c := 1 * M) ?_ (Eventually.of_forall fun t => ?_)
  · exact ((hf.measurable_fc.comp (by fun_prop : Measurable fun t : ℝ => (z.1 + t ^ 1, z.2))).mul
      (hh.comp (by fun_prop : Measurable fun t : ℝ => (z.1, z.2 + t ^ 2)))).aestronglyMeasurable
  · rw [norm_mul]; exact mul_le_mul (hf.norm_fc_le _) (hM _) (norm_nonneg _) zero_le_one

theorem measurable_ms8AvgP {ψ : ℝ → ℝ} (hψ : Measurable ψ) {f₁ f₂ : ℝ × ℝ → ℂ}
    (h₁ : Measurable f₁) (h₂ : Measurable f₂) : Measurable (ms8AvgP 1 2 ψ f₁ f₂) :=
  (StronglyMeasurable.integral_prod_right' (ν := volume)
    (f := fun q : (ℝ × ℝ) × ℝ => (ψ q.2 : ℂ) * (f₁ (q.1.1 + q.2 ^ 1, q.1.2) *
      f₂ (q.1.1, q.1.2 + q.2 ^ 2)))
    ((Complex.measurable_ofReal.comp (hψ.comp measurable_snd)).mul
      ((h₁.comp measurable_shift1).mul (h₂.comp measurable_shift2))).stronglyMeasurable).measurable

theorem norm_ms8AvgP_le {f : ℝ × ℝ → ℝ} (hf : SqFun f) {ψ : ℝ → ℝ} (hψ : Integrable ψ)
    {h : ℝ × ℝ → ℂ} {M : ℝ} (hM : ∀ z, ‖h z‖ ≤ M) (z : ℝ × ℝ) :
    ‖ms8AvgP 1 2 ψ (fc f) h z‖ ≤ (∫ t, |ψ t|) * M := by
  unfold ms8AvgP
  refine (norm_integral_le_integral_norm _).trans ?_
  rw [← integral_mul_const]
  refine integral_mono_of_nonneg (Eventually.of_forall fun t => norm_nonneg _)
    (hψ.abs.mul_const M) (Eventually.of_forall fun t => ?_)
  simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs]
  exact mul_le_mul_of_nonneg_left ((mul_le_mul (hf.norm_fc_le _) (hM _) (norm_nonneg _)
    zero_le_one).trans (by rw [one_mul])) (abs_nonneg _)

theorem integrable_f {f : ℝ × ℝ → ℝ} (hf : SqFun f) : Integrable f := by
  refine (integrableOn_iff_integrable_of_support_subset (s := sq01) fun z hz => ?_).1 ?_
  · by_contra h; exact hz (hf.supp z h)
  · exact Measure.integrableOn_of_bounded (M := 1) (by rw [volume_sq01]; simp)
      hf.meas.aestronglyMeasurable (Eventually.of_forall fun z => by
        rw [Real.norm_eq_abs]; exact hf.abs_le z)

theorem integrable_fc {f : ℝ × ℝ → ℝ} (hf : SqFun f) : Integrable (fc f) := by
  refine (integrableOn_iff_integrable_of_support_subset (s := sq01) fun z hz => ?_).1 ?_
  · by_contra h; exact hz (by rw [fc, hf.supp z h, Complex.ofReal_zero])
  · exact Measure.integrableOn_of_bounded (M := 1) (by rw [volume_sq01]; simp)
      hf.measurable_fc.aestronglyMeasurable (Eventually.of_forall fun z => hf.norm_fc_le z)

/-- `W_ψ(h₁ + h₂) = W_ψ(h₁) + W_ψ(h₂)` for bounded measurable `h₁, h₂`. -/
theorem Wform_add {f : ℝ × ℝ → ℝ} (hf : SqFun f) {ψ : ℝ → ℝ} (hψ : Integrable ψ)
    (hψm : Measurable ψ) {h₁ h₂ : ℝ × ℝ → ℂ} (hh₁ : Measurable h₁) (hh₂ : Measurable h₂)
    {M₁ M₂ : ℝ} (hM₁ : ∀ z, ‖h₁ z‖ ≤ M₁) (hM₂ : ∀ z, ‖h₂ z‖ ≤ M₂) :
    Wform f ψ (fun z => h₁ z + h₂ z) = Wform f ψ h₁ + Wform f ψ h₂ := by
  have hA : ∀ z, ms8AvgP 1 2 ψ (fc f) (fun z => h₁ z + h₂ z) z =
      ms8AvgP 1 2 ψ (fc f) h₁ z + ms8AvgP 1 2 ψ (fc f) h₂ z := by
    intro z
    unfold ms8AvgP
    rw [← integral_add (integrable_ms8_integrand hf hψ hh₁ hM₁ z)
      (integrable_ms8_integrand hf hψ hh₂ hM₂ z)]
    congr 1; ext t; ring
  have hI : ∀ {h : ℝ × ℝ → ℂ}, Measurable h → ∀ {M : ℝ}, (∀ z, ‖h z‖ ≤ M) →
      Integrable fun z => fc f z * ms8AvgP 1 2 ψ (fc f) h z := by
    intro h hh M hM
    refine (integrable_fc hf).mul_bdd (c := (∫ t, |ψ t|) * M)
      (measurable_ms8AvgP hψm hf.measurable_fc hh).aestronglyMeasurable
      (Eventually.of_forall fun z => norm_ms8AvgP_le hf hψ hM z)
  unfold Wform
  simp_rw [hA, mul_add]
  exact integral_add (hI hh₁ hM₁) (hI hh₂ hM₂)

/-- The pattern integral `PI(f) = ∫_z f(z) ∫_{t ∈ [0,1]} f(x+t,y) f(x,y+t^2)`. -/
def patI (f : ℝ × ℝ → ℝ) : ℝ := ∫ z, f z * ∫ t in Icc (0 : ℝ) 1, f (z.1 + t, z.2) * f (z.1, z.2 +
    t ^ 2)

/-- `|W_{τ_k}(f)| ≤ 2^k PI(f)` (the estimate `2^{k'} I ≥ ...` of the source). -/
theorem norm_Wform_fc_le {f : ℝ × ℝ → ℝ} (hf : SqFun f) {k : ℕ} (hk : 1 ≤ k) :
    ‖Wform f (dil tauC k) (fc f)‖ ≤ 2 ^ k * patI f := by
  have hreal : Wform f (dil tauC k) (fc f) = ((∫ z, f z * ∫ t, dil tauC k t *
      (f (z.1 + t, z.2) * f (z.1, z.2 + t ^ 2)) : ℝ) : ℂ) := by
    unfold Wform ms8AvgP fc
    rw [← integral_complex_ofReal]
    congr 1; ext z
    rw [Complex.ofReal_mul, ← integral_complex_ofReal]
    congr 2; ext t; push_cast; simp [pow_one]
  rw [hreal, Complex.norm_real, Real.norm_eq_abs]
  have hG : ∀ z : ℝ × ℝ, 0 ≤ ∫ t, dil tauC k t * (f (z.1 + t, z.2) * f (z.1, z.2 + t ^ 2)) := fun
      z =>
    integral_nonneg fun t => mul_nonneg (dil_tauC_nonneg k t) (mul_nonneg (hf.nonneg _) (hf.nonneg
        _))
  rw [abs_of_nonneg (integral_nonneg fun z => mul_nonneg (hf.nonneg z) (hG z))]
  unfold patI
  rw [← integral_const_mul]
  have hfa := hf.abs_le
  have hmeasF : ∀ z : ℝ × ℝ, Measurable fun t : ℝ => f (z.1 + t, z.2) * f (z.1, z.2 + t ^ 2) :=
      fun z =>
    (hf.meas.comp (by fun_prop : Measurable fun t : ℝ => (z.1 + t, z.2))).mul
      (hf.meas.comp (by fun_prop : Measurable fun t : ℝ => (z.1, z.2 + t ^ 2)))
  have hpt : ∀ z : ℝ × ℝ, ∫ t, dil tauC k t * (f (z.1 + t, z.2) * f (z.1, z.2 + t ^ 2)) ≤
      2 ^ k * ∫ t in Icc (0 : ℝ) 1, f (z.1 + t, z.2) * f (z.1, z.2 + t ^ 2) := by
    intro z
    have hsupp : ∀ t ∉ Icc (0 : ℝ) 1, dil tauC k t * (f (z.1 + t, z.2) * f (z.1, z.2 + t ^ 2)) = 0
        :=
      fun t ht => by rw [dil_tauC_eq_zero hk ht, zero_mul]
    rw [← setIntegral_eq_integral_of_forall_compl_eq_zero hsupp, ← integral_const_mul]
    refine setIntegral_mono_on ?_ ?_ measurableSet_Icc fun t _ => ?_
    · exact Measure.integrableOn_of_bounded (M := 2 ^ k * 1) (by simp)
        ((dil_tauC_continuous k).measurable.mul (hmeasF z)).aestronglyMeasurable
        (Eventually.of_forall fun t => by
          rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (dil_tauC_nonneg _ _),
            abs_mul]
          exact mul_le_mul (dil_tauC_le _ _) ((mul_le_mul (hfa _) (hfa _) (abs_nonneg _)
            zero_le_one).trans (by norm_num)) (by positivity) (by positivity))
    · exact Measure.integrableOn_of_bounded (M := 2 ^ k * 1) (by simp)
        ((hmeasF z).const_mul _).aestronglyMeasurable
        (Eventually.of_forall fun t => by
          rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_pos (by positivity), abs_mul]
          exact mul_le_mul_of_nonneg_left ((mul_le_mul (hfa _) (hfa _) (abs_nonneg _)
            zero_le_one).trans (by norm_num)) (by positivity))
    · exact mul_le_mul_of_nonneg_right (dil_tauC_le k t)
        (mul_nonneg (hf.nonneg _) (hf.nonneg _))
  have hF2 : Measurable fun q : (ℝ × ℝ) × ℝ => f (q.1.1 + q.2, q.1.2) * f (q.1.1, q.1.2 + q.2 ^ 2)
      :=
    (hf.meas.comp (by fun_prop)).mul (hf.meas.comp (by fun_prop))
  have hint1 : Integrable fun z : ℝ × ℝ =>
      f z * ∫ t, dil tauC k t * (f (z.1 + t, z.2) * f (z.1, z.2 + t ^ 2)) := by
    refine (integrable_f hf).mul_bdd (c := 1)
      (StronglyMeasurable.integral_prod_right' (ν := volume)
        (f := fun q : (ℝ × ℝ) × ℝ => dil tauC k q.2 * (f (q.1.1 + q.2, q.1.2) *
          f (q.1.1, q.1.2 + q.2 ^ 2)))
        (((dil_tauC_continuous k).measurable.comp measurable_snd).mul hF2).stronglyMeasurable
        ).aestronglyMeasurable (Eventually.of_forall fun z => ?_)
    rw [Real.norm_eq_abs]
    refine (abs_integral_le_integral_abs).trans ?_
    calc ∫ t, |dil tauC k t * (f (z.1 + t, z.2) * f (z.1, z.2 + t ^ 2))| ≤ ∫ t, dil tauC k t := by
          refine integral_mono_of_nonneg (Eventually.of_forall fun t => abs_nonneg _)
            (integrable_dil_tauC k) (Eventually.of_forall fun t => ?_)
          dsimp only
          rw [abs_mul, abs_of_nonneg (dil_tauC_nonneg _ _), abs_mul]
          exact (mul_le_mul_of_nonneg_left ((mul_le_mul (hfa _) (hfa _) (abs_nonneg _)
            zero_le_one).trans (le_of_eq (one_mul 1))) (dil_tauC_nonneg _ _)).trans
            (le_of_eq (mul_one _))
      _ = 1 := dil_integral tauC_integral k
  have hint2 : Integrable fun z : ℝ × ℝ => 2 ^ k * (f z *
      ∫ t in Icc (0 : ℝ) 1, f (z.1 + t, z.2) * f (z.1, z.2 + t ^ 2)) := by
    refine ((integrable_f hf).mul_bdd (c := 1)
      (StronglyMeasurable.integral_prod_right' (ν := volume.restrict (Icc (0 : ℝ) 1))
        (f := fun q : (ℝ × ℝ) × ℝ => f (q.1.1 + q.2, q.1.2) * f (q.1.1, q.1.2 + q.2 ^ 2))
        hF2.stronglyMeasurable).aestronglyMeasurable
      (Eventually.of_forall fun z => ?_)).const_mul _
    rw [Real.norm_eq_abs]
    refine (abs_integral_le_integral_abs).trans ?_
    calc ∫ t in Icc (0 : ℝ) 1, |f (z.1 + t, z.2) * f (z.1, z.2 + t ^ 2)| ≤ ∫ t in Icc (0 : ℝ) 1, 1
        := by
          refine setIntegral_mono_on ?_ (by simp) measurableSet_Icc fun t _ => ?_
          · exact Measure.integrableOn_of_bounded (M := 1) (by simp)
              ((hmeasF z).abs).aestronglyMeasurable (Eventually.of_forall fun t => by
                rw [Real.norm_eq_abs, abs_abs, abs_mul]
                exact (mul_le_mul (hfa _) (hfa _) (abs_nonneg _) zero_le_one).trans (by norm_num))
          · rw [abs_mul]
            exact (mul_le_mul (hfa _) (hfa _) (abs_nonneg _) zero_le_one).trans (by norm_num)
      _ = 1 := by simp
  refine integral_mono hint1 hint2 fun z => ?_
  calc f z * ∫ t, dil tauC k t * (f (z.1 + t, z.2) * f (z.1, z.2 + t ^ 2))
      ≤ f z * (2 ^ k * ∫ t in Icc (0 : ℝ) 1, f (z.1 + t, z.2) * f (z.1, z.2 + t ^ 2)) :=
        mul_le_mul_of_nonneg_left (hpt z) (hf.nonneg z)
    _ = _ := by ring

/-! ### The convolutions `f *_j ϑ_m` -/

/-- `H_{j,m} = f *_j ϑ_m` as a complex coordinate convolution. -/
def Hc (f : ℝ × ℝ → ℝ) (j : Fin 2) (m : ℕ) : ℝ × ℝ → ℂ := monoCConv j (cK (dil thetaC m)) (fc f)

theorem integrable_cK_dil_theta (m : ℕ) : Integrable (cK (dil thetaC m)) :=
  integrable_cK (integrable_dil thetaC_contDiff.continuous thetaC_hasCompactSupport m)

theorem integral_norm_cK_dil_theta (m : ℕ) : ∫ s, ‖cK (dil thetaC m) s‖ = 1 := by
  simp only [cK, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (dil_nonneg thetaC_nonneg m _)]
  exact dil_integral thetaC_integral m

theorem continuous_dil {a : ℝ → ℝ} (ha : Continuous a) (m : ℕ) : Continuous (dil a m) :=
  continuous_const.mul (ha.comp (continuous_const.mul continuous_id))

theorem measurable_cK_dil {a : ℝ → ℝ} (ha : Continuous a) (m : ℕ) : Measurable (cK (dil a m)) :=
  Complex.measurable_ofReal.comp (continuous_dil ha m).measurable

theorem measurable_Hc {f : ℝ × ℝ → ℝ} (hf : SqFun f) (j : Fin 2) (m : ℕ) :
    Measurable (Hc f j m) :=
  measurable_monoCConv (measurable_cK_dil thetaC_contDiff.continuous m) hf.measurable_fc

theorem norm_Hc_le {f : ℝ × ℝ → ℝ} (hf : SqFun f) (j : Fin 2) (m : ℕ) (z : ℝ × ℝ) :
    ‖Hc f j m z‖ ≤ 1 := by
  have := norm_monoCConv_le (j := j) (integrable_cK_dil_theta m) hf.norm_fc_le z
  rwa [integral_norm_cK_dil_theta, one_mul] at this

theorem Hc_zero_eq {f : ℝ × ℝ → ℝ} (m : ℕ) (z : ℝ × ℝ) :
    Hc f 0 m z = (conv1 f (dil thetaC m) z : ℂ) := by
  unfold Hc monoCConv conv1
  rw [← integral_complex_ofReal]
  congr 1; ext s
  simp only [cK, fc, monoEj, monoPt, if_true]
  rw [show z - (s, 0) = (z.1 - s, z.2) from Prod.ext rfl (sub_zero _)]; push_cast; ring

theorem Hc_one_eq {f : ℝ × ℝ → ℝ} (m : ℕ) (z : ℝ × ℝ) :
    Hc f 1 m z = (conv2 f (dil thetaC m) z : ℂ) := by
  unfold Hc monoCConv conv2
  rw [← integral_complex_ofReal]
  congr 1; ext s
  simp only [cK, fc, monoEj, monoPt, one_ne_zero, if_false]
  rw [show z - (0, s) = (z.1, z.2 - s) from Prod.ext (sub_zero _) rfl]; push_cast; ring

/-- `I_6 = ∫ f (f *_1 ϑ_k)(f *_2 ϑ_k) ≥ ϑ(0)^2 (∫ f)^4` (`lem:lowerbd`). -/
theorem I6_ge {f : ℝ × ℝ → ℝ} (hf : SqFun f) (k : ℕ) :
    thetaC 0 ^ 2 * (∫ z, f z) ^ 4 ≤
      (∫ z, fc f z * Hc f 0 k z * Hc f 1 k z).re := by
  have hcore := lowerbd_core thetaC_contDiff.continuous thetaC_hasCompactSupport thetaC_nonneg
    (fun x hx => thetaC_const hx) thetaC_zero_pos hf.meas hf.nonneg hf.le_one k k
  have e1 : ∫ z in Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1, f z = ∫ z, f z :=
    setIntegral_eq_integral_of_forall_compl_eq_zero fun z hz => hf.supp z hz
  have e2 : ∫ z in Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1,
      f z * conv1 f (dil thetaC k) z * conv2 f (dil thetaC k) z =
      ∫ z, f z * conv1 f (dil thetaC k) z * conv2 f (dil thetaC k) z :=
    setIntegral_eq_integral_of_forall_compl_eq_zero fun z hz => by rw [hf.supp z hz]; ring
  rw [e1, e2] at hcore
  refine hcore.trans (le_of_eq ?_)
  have : (∫ z, fc f z * Hc f 0 k z * Hc f 1 k z) =
      ((∫ z, f z * conv1 f (dil thetaC k) z * conv2 f (dil thetaC k) z : ℝ) : ℂ) := by
    rw [← integral_complex_ofReal]
    congr 1; ext z
    rw [Hc_zero_eq, Hc_one_eq, fc]; push_cast; ring
  rw [this, Complex.ofReal_re]

/-! ### The term `I_4` -/

theorem thetaC_lipschitz : ∃ L : NNReal, LipschitzWith L thetaC :=
  thetaC_contDiff.lipschitzWith_of_hasCompactSupport thetaC_hasCompactSupport (by simp)

theorem thetaC_eq_zero {x : ℝ} (hx : 2 < |x|) : thetaC x = 0 :=
  Function.notMem_support.1 fun h => by
    have := thetaC_support h; rw [mem_Icc] at this
    have := abs_le.2 this; linarith

/-- `∫ |ϑ_m(s+h) - ϑ_m(s)| ds ≤ 6 L 2^m |h|` for `2^m |h| ≤ 1`. -/
theorem integral_dil_theta_sub_le {L : NNReal} (hL : LipschitzWith L thetaC) (m : ℕ) {h : ℝ}
    (hh : 2 ^ m * |h| ≤ 1) :
    ∫ s, ‖cK (dil thetaC m) (s + h) - cK (dil thetaC m) s‖ ≤ 6 * L * 2 ^ m * |h| := by
  have hm : (0 : ℝ) < 2 ^ m := by positivity
  set B : ℝ := 4 ^ m * L * |h|
  have hpt : ∀ s, ‖cK (dil thetaC m) (s + h) - cK (dil thetaC m) s‖ ≤
      (Icc (-(3 / 2 ^ m)) (3 / 2 ^ m)).indicator (fun _ => B) s := by
    intro s
    have e : ‖cK (dil thetaC m) (s + h) - cK (dil thetaC m) s‖ =
        2 ^ m * |thetaC (2 ^ m * s + 2 ^ m * h) - thetaC (2 ^ m * s)| := by
      simp only [cK, dil, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs, mul_add]
      rw [← mul_sub, abs_mul, abs_of_pos hm]
    rw [e]
    by_cases hs : s ∈ Icc (-(3 / 2 ^ m)) (3 / 2 ^ m)
    · rw [indicator_of_mem hs]
      have hl := hL.dist_le_mul (2 ^ m * s + 2 ^ m * h) (2 ^ m * s)
      rw [Real.dist_eq, Real.dist_eq, show 2 ^ m * s + 2 ^ m * h - 2 ^ m * s = 2 ^ m * h by ring,
        abs_mul, abs_of_pos hm] at hl
      calc 2 ^ m * |thetaC (2 ^ m * s + 2 ^ m * h) - thetaC (2 ^ m * s)|
          ≤ 2 ^ m * (L * (2 ^ m * |h|)) := by gcongr
        _ = B := by simp only [B]; rw [show (4 : ℝ) ^ m = 2 ^ m * 2 ^ m by
              rw [← mul_pow]; norm_num]; ring
    · rw [indicator_of_notMem hs]
      have hs' : 3 < |2 ^ m * s| := by
        rw [mem_Icc, not_and_or, not_le, not_le] at hs
        rw [abs_mul, abs_of_pos hm]
        rcases hs with hs | hs
        · rw [lt_neg] at hs
          have : 3 / 2 ^ m < |s| := lt_of_lt_of_le hs (neg_le_abs s)
          rw [div_lt_iff₀ hm] at this; linarith
        · have : 3 / 2 ^ m < |s| := lt_of_lt_of_le hs (le_abs_self s)
          rw [div_lt_iff₀ hm] at this; linarith
      have h1 : thetaC (2 ^ m * s) = 0 := thetaC_eq_zero (by linarith)
      have h2 : thetaC (2 ^ m * s + 2 ^ m * h) = 0 := by
        refine thetaC_eq_zero ?_
        have : |2 ^ m * h| ≤ 1 := by rw [abs_mul, abs_of_pos hm]; exact hh
        have := abs_sub_abs_le_abs_sub (2 ^ m * s) (-(2 ^ m * h))
        rw [abs_neg, sub_neg_eq_add] at this
        linarith
      rw [h1, h2]; simp
  calc ∫ s, ‖cK (dil thetaC m) (s + h) - cK (dil thetaC m) s‖
      ≤ ∫ s : ℝ, (Icc (-(3 / 2 ^ m)) (3 / 2 ^ m)).indicator (fun _ => B) s := by
        refine integral_mono_of_nonneg (Eventually.of_forall fun s => norm_nonneg _) ?_
          (Eventually.of_forall hpt)
        exact (continuous_const.integrableOn_Icc).integrable_indicator measurableSet_Icc
    _ = 6 * L * 2 ^ m * |h| := by
        rw [integral_indicator measurableSet_Icc, setIntegral_const, smul_eq_mul,
          Measure.real, Real.volume_Icc, ENNReal.toReal_ofReal (by
            have : 0 < 3 / (2 : ℝ) ^ m := by positivity
            linarith)]
        simp only [B]
        rw [show (4 : ℝ) ^ m = 2 ^ m * 2 ^ m by rw [← mul_pow]; norm_num]
        field_simp
        ring

/-- The Lipschitz bound for `f *_2 ϑ_m` in the second variable. -/
theorem norm_Hc_one_sub_le {f : ℝ × ℝ → ℝ} (hf : SqFun f) {L : NNReal}
    (hL : LipschitzWith L thetaC) (m : ℕ) {h : ℝ} (hh : 2 ^ m * |h| ≤ 1) (x y : ℝ) :
    ‖Hc f 1 m (x, y + h) - Hc f 1 m (x, y)‖ ≤ 6 * L * 2 ^ m * |h| := by
  set K := cK (dil thetaC m)
  have hK := integrable_cK_dil_theta m
  have hFm : Measurable fun s => fc f (x, y - s) :=
    hf.measurable_fc.comp (by fun_prop)
  have e1 : Hc f 1 m (x, y + h) = ∫ s, K (s + h) * fc f (x, y - s) := by
    unfold Hc monoCConv
    have := integral_add_right_eq_self (μ := volume)
      (fun s => K s * fc f ((x, y + h) - monoEj 1 s)) h
    rw [← this]
    congr 1; ext s
    simp only [monoEj, monoPt, one_ne_zero, if_false]
    congr 2
    exact Prod.ext (sub_zero _) (by simp)
  have e2 : Hc f 1 m (x, y) = ∫ s, K s * fc f (x, y - s) := by
    unfold Hc monoCConv
    congr 1; ext s
    simp only [monoEj, monoPt, one_ne_zero, if_false]
    congr 2
    exact Prod.ext (sub_zero _) rfl
  have hb : ∀ {G : ℝ → ℂ}, Integrable G → Integrable fun s => G s * fc f (x, y - s) :=
    fun hG => hG.mul_bdd (c := 1) hFm.aestronglyMeasurable
      (Eventually.of_forall fun s => hf.norm_fc_le _)
  rw [e1, e2, ← integral_sub (hb (hK.comp_add_right h)) (hb hK)]
  refine (norm_integral_le_integral_norm _).trans ?_
  refine le_trans ?_ (integral_dil_theta_sub_le hL m hh)
  refine integral_mono_of_nonneg (Eventually.of_forall fun s => norm_nonneg _)
    ((hK.comp_add_right h).sub hK).norm (Eventually.of_forall fun s => ?_)
  dsimp only
  rw [← sub_mul, norm_mul]
  calc ‖K (s + h) - K s‖ * ‖fc f (x, y - s)‖ ≤ ‖K (s + h) - K s‖ * 1 := by
        gcongr; exact hf.norm_fc_le _
    _ = _ := mul_one _

/-- `(f *_1 τ̃_k)(x,y) = ∫ τ_k(t) f(x+t, y) dt`. -/
def Qτ (f : ℝ × ℝ → ℝ) (k : ℕ) : ℝ × ℝ → ℂ :=
  monoCConv 0 (cK fun u => dil tauC k (-u)) (fc f)

theorem Qτ_eq (f : ℝ × ℝ → ℝ) (k : ℕ) (z : ℝ × ℝ) :
    Qτ f k z = ∫ t, (dil tauC k t : ℂ) * fc f (z.1 + t, z.2) := by
  unfold Qτ monoCConv
  rw [← integral_neg_eq_self (fun t => (dil tauC k t : ℂ) * fc f (z.1 + t, z.2))]
  congr 1; ext s
  simp only [cK, monoEj, monoPt, if_true]
  congr 2
  exact Prod.ext (by simp; ring) (sub_zero _)

theorem dil_tauC_support {k : ℕ} {t : ℝ} (ht : dil tauC k t ≠ 0) : 0 < t ∧ t ≤ 2 / 2 ^ k := by
  have hk : (0 : ℝ) < 2 ^ k := by positivity
  have hmem : 2 ^ k * t ∈ Icc (1 / 2 : ℝ) 2 := by
    by_contra h
    exact ht (by unfold dil; rw [tauC_eq_zero h, mul_zero])
  rw [mem_Icc] at hmem
  constructor
  · by_contra hn; push Not at hn; nlinarith [hmem.1]
  · rw [le_div_iff₀ hk]; linarith [hmem.2]

theorem integrable_dil_tauC_mul_bdd {k : ℕ} {G : ℝ → ℂ} (hG : Measurable G) {M : ℝ}
    (hM : ∀ t, ‖G t‖ ≤ M) : Integrable fun t => (dil tauC k t : ℂ) * G t :=
  (integrable_dil_tauC k).ofReal.mul_bdd (c := M) hG.aestronglyMeasurable
    (Eventually.of_forall hM)

/-- **The term `I_4`**: `|W_{τ_k}(f *_2 ϑ_m) - ∫ f (f *_1 τ̃_k)(f *_2 ϑ_m)| ≤ 6 L 2^m (4/4^k)`
when `2^m · 4/4^k ≤ 1`, by the mean value theorem for `f *_2 ϑ_m`. -/
theorem I4_bound {f : ℝ × ℝ → ℝ} (hf : SqFun f) {L : NNReal} (hL : LipschitzWith L thetaC)
    {k m : ℕ} (hkm : 2 ^ m * (4 / 4 ^ k) ≤ (1 : ℝ)) :
    ‖Wform f (dil tauC k) (Hc f 1 m) - ∫ z, fc f z * Qτ f k z * Hc f 1 m z‖ ≤
      6 * L * 2 ^ m * (4 / 4 ^ k) := by
  set H := Hc f 1 m
  have hHm := measurable_Hc hf 1 m
  have hHb := norm_Hc_le hf 1 m
  set osc : ℝ := 6 * L * 2 ^ m * (4 / 4 ^ k)
  have hosc0 : 0 ≤ osc := by positivity
  -- the pointwise oscillation bound on the support of `τ_k`
  have hOsc : ∀ (z : ℝ × ℝ) (t : ℝ), dil tauC k t ≠ 0 →
      ‖H (z.1, z.2 + t ^ 2) - H z‖ ≤ osc := by
    intro z t ht
    obtain ⟨ht0, ht1⟩ := dil_tauC_support ht
    have ht2 : t ^ 2 ≤ 4 / 4 ^ k := by
      calc t ^ 2 ≤ (2 / 2 ^ k) ^ 2 := pow_le_pow_left₀ ht0.le ht1 2
        _ = 4 / 4 ^ k := by rw [div_pow, ← pow_mul, mul_comm, pow_mul]; norm_num
    have hh : 2 ^ m * |t ^ 2| ≤ 1 := by
      rw [abs_of_nonneg (sq_nonneg _)]
      exact (mul_le_mul_of_nonneg_left ht2 (by positivity)).trans hkm
    have := norm_Hc_one_sub_le hf hL m hh z.1 z.2
    refine this.trans ?_
    rw [abs_of_nonneg (sq_nonneg _)]
    exact mul_le_mul_of_nonneg_left ht2 (by positivity)
  have hfcm := hf.measurable_fc
  have hshift1 : ∀ z : ℝ × ℝ, Measurable fun t : ℝ => fc f (z.1 + t, z.2) := fun z =>
    hfcm.comp (by fun_prop)
  have hshift2 : ∀ z : ℝ × ℝ, Measurable fun t : ℝ => H (z.1, z.2 + t ^ 2) := fun z =>
    hHm.comp (by fun_prop)
  -- rewrite both terms as integrals over `z` of integrals over `t`
  have hW : Wform f (dil tauC k) H =
      ∫ z, fc f z * ∫ t, (dil tauC k t : ℂ) * (fc f (z.1 + t, z.2) * H (z.1, z.2 + t ^ 2)) := by
    unfold Wform ms8AvgP; simp only [pow_one]
  have hV : (∫ z, fc f z * Qτ f k z * H z) =
      ∫ z, fc f z * ∫ t, (dil tauC k t : ℂ) * (fc f (z.1 + t, z.2) * H z) := by
    congr 1; ext z
    rw [Qτ_eq, mul_assoc, ← integral_mul_const]
    congr 2; ext t; ring
  have hin1 : ∀ z : ℝ × ℝ, Integrable fun t : ℝ =>
      (dil tauC k t : ℂ) * (fc f (z.1 + t, z.2) * H (z.1, z.2 + t ^ 2)) := fun z =>
    integrable_dil_tauC_mul_bdd ((hshift1 z).mul (hshift2 z)) (M := 1) fun t => by
      rw [norm_mul]; exact (mul_le_mul (hf.norm_fc_le _) (hHb _) (norm_nonneg _) zero_le_one).trans
        (le_of_eq (one_mul 1))
  have hin2 : ∀ z : ℝ × ℝ, Integrable fun t : ℝ =>
      (dil tauC k t : ℂ) * (fc f (z.1 + t, z.2) * H z) := fun z =>
    integrable_dil_tauC_mul_bdd ((hshift1 z).mul measurable_const) (M := 1) fun t => by
      rw [norm_mul]; exact (mul_le_mul (hf.norm_fc_le _) (hHb _) (norm_nonneg _) zero_le_one).trans
        (le_of_eq (one_mul 1))
  have hτ1 : ∫ t, dil tauC k t = 1 := dil_integral tauC_integral k
  have hinner_bd : ∀ (z : ℝ × ℝ) {G : ℝ → ℂ}, Measurable G → (∀ t, ‖G t‖ ≤ 1) →
      ‖∫ t, (dil tauC k t : ℂ) * G t‖ ≤ 1 := by
    intro z G hG hGb
    refine (norm_integral_le_integral_norm _).trans ?_
    calc ∫ t, ‖(dil tauC k t : ℂ) * G t‖ ≤ ∫ t, dil tauC k t := by
          refine integral_mono_of_nonneg (Eventually.of_forall fun t => norm_nonneg _)
            (integrable_dil_tauC k) (Eventually.of_forall fun t => ?_)
          dsimp only
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (dil_tauC_nonneg _ _)]
          exact (mul_le_mul_of_nonneg_left (hGb t) (dil_tauC_nonneg _ _)).trans (le_of_eq (mul_one
              _))
      _ = 1 := hτ1
  have hmeasI : ∀ {G : (ℝ × ℝ) × ℝ → ℂ}, Measurable G →
      Measurable fun z : ℝ × ℝ => ∫ t, (dil tauC k t : ℂ) * G (z, t) := fun {G} hG =>
    (StronglyMeasurable.integral_prod_right' (ν := volume)
      (f := fun q : (ℝ × ℝ) × ℝ => (dil tauC k q.2 : ℂ) * G q)
      ((Complex.measurable_ofReal.comp ((dil_tauC_continuous k).measurable.comp
        measurable_snd)).mul hG).stronglyMeasurable).measurable
  have hG1 : Measurable fun q : (ℝ × ℝ) × ℝ => fc f (q.1.1 + q.2, q.1.2) * H (q.1.1, q.1.2 + q.2 ^
      2) :=
    (hfcm.comp (by fun_prop)).mul (hHm.comp (by fun_prop))
  have hG2 : Measurable fun q : (ℝ × ℝ) × ℝ => fc f (q.1.1 + q.2, q.1.2) * H q.1 :=
    (hfcm.comp (by fun_prop)).mul (hHm.comp measurable_fst)
  have hout1 : Integrable fun z : ℝ × ℝ =>
      fc f z * ∫ t, (dil tauC k t : ℂ) * (fc f (z.1 + t, z.2) * H (z.1, z.2 + t ^ 2)) :=
    (integrable_fc hf).mul_bdd (c := 1) (hmeasI hG1).aestronglyMeasurable
      (Eventually.of_forall fun z => hinner_bd z ((hshift1 z).mul (hshift2 z)) fun t => by
        rw [norm_mul]; exact (mul_le_mul (hf.norm_fc_le _) (hHb _) (norm_nonneg _)
          zero_le_one).trans (le_of_eq (one_mul 1)))
  have hout2 : Integrable fun z : ℝ × ℝ =>
      fc f z * ∫ t, (dil tauC k t : ℂ) * (fc f (z.1 + t, z.2) * H z) :=
    (integrable_fc hf).mul_bdd (c := 1) (hmeasI hG2).aestronglyMeasurable
      (Eventually.of_forall fun z => hinner_bd z ((hshift1 z).mul measurable_const) fun t => by
        rw [norm_mul]; exact (mul_le_mul (hf.norm_fc_le _) (hHb _) (norm_nonneg _)
          zero_le_one).trans (le_of_eq (one_mul 1)))
  rw [hW, hV, ← integral_sub hout1 hout2]
  refine (norm_integral_le_integral_norm _).trans ?_
  calc _ ≤ ∫ z, ‖fc f z‖ * osc := by
        refine integral_mono_of_nonneg (Eventually.of_forall fun z => norm_nonneg _)
          ((integrable_fc hf).norm.mul_const osc) (Eventually.of_forall fun z => ?_)
        dsimp only
        rw [← mul_sub, norm_mul, ← integral_sub (hin1 z) (hin2 z)]
        refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
        refine (norm_integral_le_integral_norm _).trans ?_
        calc _ ≤ ∫ t, dil tauC k t * osc := by
              refine integral_mono_of_nonneg (Eventually.of_forall fun t => norm_nonneg _)
                ((integrable_dil_tauC k).mul_const osc) (Eventually.of_forall fun t => ?_)
              dsimp only
              rw [← mul_sub, ← mul_sub, norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs,
                abs_of_nonneg (dil_tauC_nonneg _ _)]
              by_cases ht : dil tauC k t = 0
              · rw [ht]; simp
              · refine mul_le_mul_of_nonneg_left ?_ (dil_tauC_nonneg _ _)
                calc ‖fc f (z.1 + t, z.2)‖ * ‖H (z.1, z.2 + t ^ 2) - H z‖ ≤ 1 * osc :=
                      mul_le_mul (hf.norm_fc_le _) (hOsc z t ht) (norm_nonneg _) zero_le_one
                  _ = osc := one_mul _
          _ = osc := by rw [integral_mul_const, hτ1, one_mul]
    _ = (∫ z, ‖fc f z‖) * osc := integral_mul_const _ _
    _ ≤ 1 * osc := by
        refine mul_le_mul_of_nonneg_right ?_ hosc0
        have h := hf.lintegral_enorm_fc_le
        rw [integral_norm_eq_lintegral_enorm hf.measurable_fc.aestronglyMeasurable]
        exact ENNReal.toReal_le_of_le_ofReal zero_le_one (by simpa using h)
    _ = _ := one_mul _


/-! ### The term `I_5` -/

theorem fibL12_sub {j : Fin 2} {G₁ G₂ : ℝ × ℝ → ℂ} (h₁ : FibL12 j G₁) (h₂ : FibL12 j G₂) :
    FibL12 j (G₁ - G₂) := fun p =>
  ⟨(h₁ p).1.sub (h₂ p).1, (h₁ p).2.sub (h₂ p).2⟩

theorem fibF_sub {j : Fin 2} {G₁ G₂ : ℝ × ℝ → ℂ} (h₁ : ∀ p, Integrable (monoFib j G₁ p))
    (h₂ : ∀ p, Integrable (monoFib j G₂ p)) (q : ℝ × ℝ) :
    fibF j (G₁ - G₂) q = fibF j G₁ q - fibF j G₂ q := by
  unfold fibF
  exact fourier_sub' (h₁ q.1) (h₂ q.1) q.2

/-- The reflected bump `τ̃(u) = τ(-u)`. -/
def tauR (u : ℝ) : ℝ := tauC (-u)

theorem tauR_contDiff : ContDiff ℝ ∞ tauR := tauC_contDiff.comp contDiff_neg
theorem tauR_nonneg (u : ℝ) : 0 ≤ tauR u := tauC_nonneg _
theorem tauR_hasCompactSupport : HasCompactSupport tauR := tauC_hasCompactSupport.comp_homeomorph
  (Homeomorph.neg ℝ)
theorem tauR_integral : ∫ u, tauR u = 1 := by
  change ∫ u, tauC (-u) = 1
  rw [integral_neg_eq_self (fun u => tauC u), tauC_integral]
theorem tauR_integrable : Integrable tauR := tauC_integrable.comp_neg

theorem dil_tauR (k : ℕ) (u : ℝ) : dil tauC k (-u) = dil tauR k u := by
  simp [dil, tauR, mul_neg]

/-- The kernel constants: `D(a) = ∫ |a'|`, `M(a) = ∫ |u| a(u)`. -/
def kD (a : ℝ → ℝ) : ℝ := ∫ u, |deriv a u|
def kM (a : ℝ → ℝ) : ℝ := ∫ u, |u| * a u

theorem kD_nonneg (a : ℝ → ℝ) : 0 ≤ kD a := integral_nonneg fun _ => abs_nonneg _

theorem kM_nonneg {a : ℝ → ℝ} (ha : ∀ u, 0 ≤ a u) : 0 ≤ kM a :=
  integral_nonneg fun u => mul_nonneg (abs_nonneg _) (ha u)

/-- `|â(ξ/2^m)| · |1 - b̂(ξ/2^n)| ≤ D(a) M(b) 2^{m-n}` for the bumps used here. -/
theorem norm_mul_one_sub_le {a b : ℝ → ℝ} (ha : ContDiff ℝ 1 a) (hac : HasCompactSupport a)
    (hbn : ∀ u, 0 ≤ b u) (hbi : Integrable b) (hb1 : ∫ u, b u = 1)
    (hbm : Integrable fun u => |u| * b u) (m n : ℕ) (ξ : ℝ) :
    ‖𝓕 (cK a) (ξ / 2 ^ m)‖ * ‖1 - 𝓕 (cK b) (ξ / 2 ^ n)‖ ≤ kD a * kM b * (2 ^ m / 2 ^ n) := by
  by_cases hξ : ξ = 0
  · have : 1 - 𝓕 (cK b) (ξ / 2 ^ n) = 0 := by
      have h := norm_one_sub_fourier_cK_le hbn hbi hb1 hbm (ξ / 2 ^ n)
      rw [hξ, zero_div, abs_zero, mul_zero, zero_mul] at h
      rw [hξ, zero_div]
      exact norm_le_zero_iff.1 h
    rw [this, norm_zero, mul_zero]
    exact mul_nonneg (mul_nonneg (kD_nonneg a) (kM_nonneg hbn)) (by positivity)
  have hη : ξ / 2 ^ m ≠ 0 := div_ne_zero hξ (by positivity)
  have h1 := norm_fourier_cK_le_deriv ha hac hη
  have h2 := norm_one_sub_fourier_cK_le hbn hbi hb1 hbm (ξ / 2 ^ n)
  have hpos : 0 < 2 * π * |ξ / 2 ^ m| := by positivity
  calc ‖𝓕 (cK a) (ξ / 2 ^ m)‖ * ‖1 - 𝓕 (cK b) (ξ / 2 ^ n)‖
      ≤ (kD a / (2 * π * |ξ / 2 ^ m|)) * (2 * π * |ξ / 2 ^ n| * kM b) :=
        mul_le_mul h1 h2 (norm_nonneg _) (div_nonneg (kD_nonneg a) hpos.le)
    _ = kD a * kM b * (2 ^ m / 2 ^ n) := by
        rw [abs_div, abs_div, abs_of_pos (by positivity : (0 : ℝ) < 2 ^ m),
          abs_of_pos (by positivity : (0 : ℝ) < 2 ^ n)]
        have : |ξ| ≠ 0 := abs_ne_zero.2 hξ
        field_simp

/-- `|τ̂ - ϑ̂_k| ≤ |ϑ̂_{k''} - ϑ̂_k| + E` with `E = D(τ̃)M(ϑ) 2^{k'-k''} + D(ϑ)M(τ̃) 2^{k-k'}`. -/
theorem norm_tau_sub_theta_le (k k' k'' : ℕ) (ξ : ℝ) :
    ‖𝓕 (cK (dil tauR k')) ξ - 𝓕 (cK (dil thetaC k)) ξ‖ ≤
      ‖𝓕 (cK (dil thetaC k'')) ξ - 𝓕 (cK (dil thetaC k)) ξ‖ +
        (kD tauR * kM thetaC * (2 ^ k' / 2 ^ k'') + kD thetaC * kM tauR * (2 ^ k / 2 ^ k')) := by
  rw [fourier_cK_dil, fourier_cK_dil, fourier_cK_dil]
  set A := 𝓕 (cK tauR) (ξ / 2 ^ k')
  set B := 𝓕 (cK thetaC) (ξ / 2 ^ k)
  set B'' := 𝓕 (cK thetaC) (ξ / 2 ^ k'')
  have hA : ‖A‖ ≤ 1 := norm_fourier_cK_le_one tauR_nonneg tauR_integral _
  have e : A - B = A * (B'' - B) + A * (1 - B'') - B * (1 - A) := by ring
  have h1 := norm_mul_one_sub_le (a := tauR) (b := thetaC) (tauR_contDiff.of_le (by norm_num))
    tauR_hasCompactSupport thetaC_nonneg thetaC_integrable thetaC_integral
    (integrable_moment_of_hasCompactSupport thetaC_contDiff.continuous thetaC_hasCompactSupport)
    k' k'' ξ
  have h2 := norm_mul_one_sub_le (a := thetaC) (b := tauR) (thetaC_contDiff.of_le (by norm_num))
    thetaC_hasCompactSupport tauR_nonneg tauR_integrable tauR_integral
    (integrable_moment_of_hasCompactSupport tauR_contDiff.continuous tauR_hasCompactSupport)
    k k' ξ
  rw [e]
  calc ‖A * (B'' - B) + A * (1 - B'') - B * (1 - A)‖
      ≤ ‖A * (B'' - B)‖ + ‖A * (1 - B'')‖ + ‖B * (1 - A)‖ := by
        refine (norm_sub_le _ _).trans ?_
        gcongr
        exact norm_add_le _ _
    _ ≤ ‖B'' - B‖ + (kD tauR * kM thetaC * (2 ^ k' / 2 ^ k'') +
          kD thetaC * kM tauR * (2 ^ k / 2 ^ k')) := by
        rw [norm_mul, norm_mul, norm_mul]
        have : ‖A‖ * ‖B'' - B‖ ≤ ‖B'' - B‖ :=
          (mul_le_mul_of_nonneg_right hA (norm_nonneg _)).trans (le_of_eq (one_mul _))
        linarith

theorem fibL12_fc_conv {f : ℝ × ℝ → ℝ} (hf : SqFun f) (j : Fin 2) {K : ℝ → ℂ}
    (hK : Integrable K) : FibL12 j (monoCConv j K (fc f)) :=
  fibL12_monoCConv j hK (fun p => (hf.fibL12 j p).1) hf.norm_fc_le

theorem fibL12_Hc {f : ℝ × ℝ → ℝ} (hf : SqFun f) (j : Fin 2) (m : ℕ) : FibL12 j (Hc f j m) :=
  fibL12_fc_conv hf j (integrable_cK_dil_theta m)

theorem fibF_Hc {f : ℝ × ℝ → ℝ} (hf : SqFun f) (j : Fin 2) (m : ℕ) (q : ℝ × ℝ) :
    fibF j (Hc f j m) q = 𝓕 (cK (dil thetaC m)) q.2 * fibF j (fc f) q :=
  fibF_monoCConv j (integrable_cK_dil_theta m) (fun p => (hf.fibL12 j p).1) q

/-- Cauchy-Schwarz against the unit square: `∫ 1_{[0,1]^2} |D| ≤ ‖D‖_2`. -/
theorem lintegral_sq01_mul_le {D : ℝ × ℝ → ℂ} (hD : Measurable D) :
    ∫⁻ z, sq01.indicator 1 z * ‖D z‖ₑ ≤ eLpNorm D 2 volume := by
  have hmeas : MeasurableSet sq01 := measurableSet_Icc.prod measurableSet_Icc
  have h := ENNReal.lintegral_mul_le_Lp_mul_Lq volume Real.HolderConjugate.two_two
    ((measurable_one.indicator hmeas).aemeasurable) hD.enorm.aemeasurable
  refine h.trans (le_of_eq ?_)
  have hi : ∫⁻ z, (sq01.indicator (1 : ℝ × ℝ → ℝ≥0∞) z) ^ (2 : ℝ) = 1 := by
    have e : ∀ z, (sq01.indicator (1 : ℝ × ℝ → ℝ≥0∞) z) ^ (2 : ℝ) = sq01.indicator 1 z := by
      intro z
      by_cases hz : z ∈ sq01
      · rw [indicator_of_mem hz, Pi.one_apply, ENNReal.one_rpow]
      · rw [indicator_of_notMem hz, ENNReal.zero_rpow_of_pos (by norm_num)]
    simp_rw [e]
    rw [lintegral_indicator hmeas]
    simp only [Pi.one_apply, setLIntegral_one, volume_sq01]
  rw [hi, ENNReal.one_rpow, one_mul, eLpNorm_two_eq_lintegral]

/-- **The term `I_5`**: `|∫ f (f *_1 τ̃_{k'} - f *_1 ϑ_k)(f *_2 ϑ_k)|
≤ ‖f *_1 ϑ_{k''} - f *_1 ϑ_k‖_2 + E`. -/
theorem I5_bound {f : ℝ × ℝ → ℝ} (hf : SqFun f) (k k' k'' : ℕ) :
    ‖(∫ z, fc f z * Qτ f k' z * Hc f 1 k z) - ∫ z, fc f z * Hc f 0 k z * Hc f 1 k z‖ₑ ≤
      eLpNorm (Hc f 0 k'' - Hc f 0 k) 2 volume +
        ENNReal.ofReal (kD tauR * kM thetaC * (2 ^ k' / 2 ^ k'') +
          kD thetaC * kM tauR * (2 ^ k / 2 ^ k')) := by
  set E := kD tauR * kM thetaC * (2 ^ k' / 2 ^ k'') + kD thetaC * kM tauR * (2 ^ k / 2 ^ k')
  have hE : 0 ≤ E := by
    have := kD_nonneg tauR; have := kD_nonneg thetaC
    have := kM_nonneg thetaC_nonneg; have := kM_nonneg tauR_nonneg
    positivity
  have hKτ : Integrable (cK (dil tauR k')) :=
    integrable_cK (integrable_dil tauR_contDiff.continuous tauR_hasCompactSupport k')
  have hQ : Qτ f k' = monoCConv 0 (cK (dil tauR k')) (fc f) := by
    unfold Qτ; congr 1; ext u; simp only [cK, dil_tauR]
  set D : ℝ × ℝ → ℂ := Qτ f k' - Hc f 0 k
  have hQm : Measurable (Qτ f k') := by
    rw [hQ]; exact measurable_monoCConv (measurable_cK_dil tauR_contDiff.continuous k')
      hf.measurable_fc
  have hDm : Measurable D := hQm.sub (measurable_Hc hf 0 k)
  have hQb : ∀ z, ‖Qτ f k' z‖ ≤ 1 := fun z => by
    have := norm_monoCConv_le (j := 0) hKτ hf.norm_fc_le z
    rw [hQ]; refine this.trans (le_of_eq ?_)
    simp only [cK, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (dil_nonneg tauR_nonneg k' _), mul_one]
    exact dil_integral tauR_integral k'
  -- step 1: linearity
  have hint : ∀ {G : ℝ × ℝ → ℂ}, Measurable G → (∀ z, ‖G z‖ ≤ 1) →
      Integrable fun z => fc f z * G z * Hc f 1 k z := by
    intro G hG hGb
    refine ((integrable_fc hf).mul_bdd (c := 1) hG.aestronglyMeasurable
      (Eventually.of_forall hGb)).mul_bdd (c := 1) (measurable_Hc hf 1 k).aestronglyMeasurable
      (Eventually.of_forall (norm_Hc_le hf 1 k))
  rw [← integral_sub (hint hQm hQb) (hint (measurable_Hc hf 0 k) (norm_Hc_le hf 0 k))]
  -- step 2: Cauchy-Schwarz against the unit square
  refine (enorm_integral_le_lintegral_enorm _).trans ?_
  calc ∫⁻ z, ‖fc f z * Qτ f k' z * Hc f 1 k z - fc f z * Hc f 0 k z * Hc f 1 k z‖ₑ
      ≤ ∫⁻ z, sq01.indicator 1 z * ‖D z‖ₑ := by
        refine lintegral_mono fun z => ?_
        rw [show fc f z * Qτ f k' z * Hc f 1 k z - fc f z * Hc f 0 k z * Hc f 1 k z =
          fc f z * D z * Hc f 1 k z by simp only [D, Pi.sub_apply]; ring, enorm_mul, enorm_mul]
        have h1 : ‖Hc f 1 k z‖ₑ ≤ 1 := by
          rw [← ofReal_norm]; simpa using ENNReal.ofReal_le_ofReal (norm_Hc_le hf 1 k z)
        calc ‖fc f z‖ₑ * ‖D z‖ₑ * ‖Hc f 1 k z‖ₑ ≤ sq01.indicator 1 z * ‖D z‖ₑ * 1 := by
              gcongr; exact hf.enorm_fc_le_indicator z
          _ = _ := mul_one _
    _ ≤ eLpNorm D 2 volume := lintegral_sq01_mul_le hDm
    _ ≤ eLpNorm (Hc f 0 k'' - Hc f 0 k) 2 volume +
          ENNReal.ofReal E * eLpNorm (fc f) 2 volume := by
        have hfibQ : FibL12 0 (Qτ f k') := by rw [hQ]; exact fibL12_fc_conv hf 0 hKτ
        refine eLpNorm_le_of_fibF_le 0 hDm ((measurable_Hc hf 0 k'').sub (measurable_Hc hf 0 k))
          hf.measurable_fc (fibL12_sub hfibQ (fibL12_Hc hf 0 k))
          (fibL12_sub (fibL12_Hc hf 0 k'') (fibL12_Hc hf 0 k)) (hf.fibL12 0) hE fun q => ?_
        rw [fibF_sub (fun p => (hfibQ p).1) (fun p => (fibL12_Hc hf 0 k p).1),
          fibF_sub (fun p => (fibL12_Hc hf 0 k'' p).1) (fun p => (fibL12_Hc hf 0 k p).1),
          fibF_Hc hf, fibF_Hc hf]
        have hQF : fibF 0 (Qτ f k') q = 𝓕 (cK (dil tauR k')) q.2 * fibF 0 (fc f) q := by
          rw [hQ]; exact fibF_monoCConv 0 hKτ (fun p => (hf.fibL12 0 p).1) q
        rw [hQF, ← sub_mul, ← sub_mul, norm_mul, norm_mul]
        have := norm_tau_sub_theta_le k k' k'' q.2
        calc ‖𝓕 (cK (dil tauR k')) q.2 - 𝓕 (cK (dil thetaC k)) q.2‖ * ‖fibF 0 (fc f) q‖
            ≤ (‖𝓕 (cK (dil thetaC k'')) q.2 - 𝓕 (cK (dil thetaC k)) q.2‖ + E) *
                ‖fibF 0 (fc f) q‖ := mul_le_mul_of_nonneg_right this (norm_nonneg _)
          _ = _ := by ring
    _ ≤ _ := by
        gcongr
        calc ENNReal.ofReal E * eLpNorm (fc f) 2 volume ≤ ENNReal.ofReal E * 1 := by
              gcongr; exact hf.eLpNorm_fc_le
          _ = _ := mul_one _

/-- **The term `I_2`**:
`|W_{τ_{k'}}(f *_2 ϑ_{k''} - f *_2 ϑ_k)| ≤ ‖f *_2 ϑ_{k''} - f *_2 ϑ_k‖_2`. -/
theorem I2_bound {f : ℝ × ℝ → ℝ} (hf : SqFun f) (k k' k'' : ℕ) :
    ‖Wform f (dil tauC k') (Hc f 1 k'' - Hc f 1 k)‖ₑ ≤
      eLpNorm (Hc f 1 k'' - Hc f 1 k) 2 volume := by
  refine (enorm_Wform_le_L2 hf (dil_tauC_continuous k').measurable
    ((measurable_Hc hf 1 k'').sub (measurable_Hc hf 1 k))).trans (le_of_eq ?_)
  rw [lintegral_enorm_dil_tauC, one_mul]

/-! ### The term `I_3` -/

/-- `g = f - f *_2 ϑ_m`. -/
def gF (f : ℝ × ℝ → ℝ) (m : ℕ) : ℝ × ℝ → ℂ := fc f - Hc f 1 m

/-- The kernel of `φ(D/Λ)`. -/
def kerΛ (Λ : ℝ) (s : ℝ) : ℂ := (Λ : ℂ) * monoKPhi (Λ * s)

/-- The low-frequency part `g_lo = φ(D_2/Λ) g`. -/
def gLo (f : ℝ × ℝ → ℝ) (m : ℕ) (Λ : ℝ) : ℝ × ℝ → ℂ := monoCConv 1 (kerΛ Λ) (gF f m)

/-- The high-frequency part `g_hi = g - g_lo`. -/
def gHi (f : ℝ × ℝ → ℝ) (m : ℕ) (Λ : ℝ) : ℝ × ℝ → ℂ := gF f m - gLo f m Λ

theorem integrable_kerΛ {Λ : ℝ} (hΛ : 0 < Λ) : Integrable (kerΛ Λ) :=
  mloc_integrable_dil monoKPhi hΛ.ne'

theorem fourier_kerΛ {Λ : ℝ} (hΛ : 0 < Λ) (ξ : ℝ) : 𝓕 (kerΛ Λ) ξ = (monoPhi (ξ / Λ) : ℂ) := by
  unfold kerΛ
  rw [mloc_fourier_dil _ hΛ]
  exact congrFun (mloc_fourier_multK monoPhi_contDiff monoPhi_hasCompactSupport) _

theorem integral_norm_kerΛ {Λ : ℝ} (hΛ : 0 < Λ) : ∫ s, ‖kerΛ Λ s‖ = ∫ s, ‖monoKPhi s‖ := by
  unfold kerΛ
  simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hΛ]
  rw [integral_const_mul, Measure.integral_comp_mul_left (fun s => ‖monoKPhi s‖) Λ, abs_inv,
    abs_of_pos hΛ, smul_eq_mul, ← mul_assoc, mul_inv_cancel₀ hΛ.ne', one_mul]

theorem continuous_kerΛ (Λ : ℝ) : Continuous (kerΛ Λ) :=
  continuous_const.mul (monoKPhi.continuous.comp (continuous_const.mul continuous_id))

theorem monoPhi_nonneg (x : ℝ) : 0 ≤ monoPhi x := Real.smoothTransition.nonneg _
theorem monoPhi_le_one (x : ℝ) : monoPhi x ≤ 1 := Real.smoothTransition.le_one _

section gparts

variable {f : ℝ × ℝ → ℝ} (hf : SqFun f)
include hf

theorem measurable_gF (m : ℕ) : Measurable (gF f m) := hf.measurable_fc.sub (measurable_Hc hf 1 m)

theorem norm_gF_le (m : ℕ) (z : ℝ × ℝ) : ‖gF f m z‖ ≤ 2 := by
  unfold gF; rw [Pi.sub_apply]
  refine (norm_sub_le _ _).trans ?_
  linarith [hf.norm_fc_le z, norm_Hc_le hf 1 m z]

theorem fibL12_gF (m : ℕ) : FibL12 1 (gF f m) := fibL12_sub (hf.fibL12 1) (fibL12_Hc hf 1 m)

theorem measurable_gLo (m : ℕ) (Λ : ℝ) : Measurable (gLo f m Λ) :=
  measurable_monoCConv (continuous_kerΛ Λ).measurable (measurable_gF hf m)

theorem norm_gLo_le (m : ℕ) {Λ : ℝ} (hΛ : 0 < Λ) (z : ℝ × ℝ) :
    ‖gLo f m Λ z‖ ≤ (∫ s, ‖monoKPhi s‖) * 2 := by
  have := norm_monoCConv_le (j := 1) (integrable_kerΛ hΛ) (norm_gF_le hf m) z
  rwa [integral_norm_kerΛ hΛ] at this

theorem fibL12_gLo (m : ℕ) {Λ : ℝ} (hΛ : 0 < Λ) : FibL12 1 (gLo f m Λ) :=
  fibL12_monoCConv 1 (integrable_kerΛ hΛ) (fun p => (fibL12_gF hf m p).1) (norm_gF_le hf m)

theorem measurable_gHi (m : ℕ) (Λ : ℝ) : Measurable (gHi f m Λ) :=
  (measurable_gF hf m).sub (measurable_gLo hf m Λ)

theorem norm_gHi_le (m : ℕ) {Λ : ℝ} (hΛ : 0 < Λ) (z : ℝ × ℝ) :
    ‖gHi f m Λ z‖ ≤ 2 + (∫ s, ‖monoKPhi s‖) * 2 := by
  unfold gHi; rw [Pi.sub_apply]
  exact (norm_sub_le _ _).trans (add_le_add (norm_gF_le hf m z) (norm_gLo_le hf m hΛ z))

theorem fibL12_gHi (m : ℕ) {Λ : ℝ} (hΛ : 0 < Λ) : FibL12 1 (gHi f m Λ) :=
  fibL12_sub (fibL12_gF hf m) (fibL12_gLo hf m hΛ)

theorem fibF_gF (m : ℕ) (q : ℝ × ℝ) :
    fibF 1 (gF f m) q = (1 - 𝓕 (cK (dil thetaC m)) q.2) * fibF 1 (fc f) q := by
  unfold gF
  rw [fibF_sub (fun p => (hf.fibL12 1 p).1) (fun p => (fibL12_Hc hf 1 m p).1), fibF_Hc hf]
  ring

theorem fibF_gLo (m : ℕ) {Λ : ℝ} (hΛ : 0 < Λ) (q : ℝ × ℝ) :
    fibF 1 (gLo f m Λ) q = (monoPhi (q.2 / Λ) : ℂ) * fibF 1 (gF f m) q := by
  unfold gLo
  rw [fibF_monoCConv 1 (integrable_kerΛ hΛ) (fun p => (fibL12_gF hf m p).1), fourier_kerΛ hΛ]

theorem fibF_gHi (m : ℕ) {Λ : ℝ} (hΛ : 0 < Λ) (q : ℝ × ℝ) :
    fibF 1 (gHi f m Λ) q = (1 - (monoPhi (q.2 / Λ) : ℂ)) * fibF 1 (gF f m) q := by
  unfold gHi
  rw [fibF_sub (fun p => (fibL12_gF hf m p).1) (fun p => (fibL12_gLo hf m hΛ p).1),
    fibF_gLo hf m hΛ]
  ring

/-- `‖g_lo‖_2 ≤ 4π M(ϑ) (Λ / 2^m)`: the multiplier `φ(ξ/Λ)(1 - ϑ̂(ξ/2^m))` is small. -/
theorem eLpNorm_gLo_le (m : ℕ) {Λ : ℝ} (hΛ : 0 < Λ) :
    eLpNorm (gLo f m Λ) 2 volume ≤ ENNReal.ofReal (4 * π * kM thetaC * (Λ / 2 ^ m)) := by
  have hc : 0 ≤ 4 * π * kM thetaC * (Λ / 2 ^ m) := by
    have := kM_nonneg thetaC_nonneg; positivity
  have h := eLpNorm_le_of_fibF_le 1 (measurable_gLo hf m Λ) (measurable_const (a := (0 : ℂ)))
    hf.measurable_fc (fibL12_gLo hf m hΛ) (fun p => ⟨integrable_zero _ _ _, MemLp.zero⟩)
    (hf.fibL12 1) hc (fun q => ?_)
  · rw [eLpNorm_zero', zero_add] at h
    refine h.trans ?_
    calc ENNReal.ofReal (4 * π * kM thetaC * (Λ / 2 ^ m)) * eLpNorm (fc f) 2 volume
        ≤ ENNReal.ofReal (4 * π * kM thetaC * (Λ / 2 ^ m)) * 1 := by gcongr; exact hf.eLpNorm_fc_le
      _ = _ := mul_one _
  · have h0 : fibF 1 (fun _ : ℝ × ℝ => (0 : ℂ)) q = 0 := by
      unfold fibF monoFib; simp [Real.fourier_real_eq]
    rw [h0, norm_zero, zero_add, fibF_gLo hf m hΛ, fibF_gF hf m, ← mul_assoc, norm_mul]
    refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (monoPhi_nonneg _)]
    by_cases hq : 2 ≤ |q.2 / Λ|
    · rw [monoPhi_eq_zero hq, zero_mul]; exact hc
    · push Not at hq
      have h1 := norm_one_sub_fourier_cK_le thetaC_nonneg thetaC_integrable thetaC_integral
        (integrable_moment_of_hasCompactSupport thetaC_contDiff.continuous
          thetaC_hasCompactSupport) (q.2 / 2 ^ m)
      rw [← fourier_cK_dil] at h1
      have hq' : |q.2| ≤ 2 * Λ := by
        rw [abs_div, abs_of_pos hΛ, div_lt_iff₀ hΛ] at hq; linarith
      calc monoPhi (q.2 / Λ) * ‖1 - 𝓕 (cK (dil thetaC m)) q.2‖
          ≤ 1 * (2 * π * |q.2 / 2 ^ m| * kM thetaC) :=
            mul_le_mul (monoPhi_le_one _) h1 (norm_nonneg _) zero_le_one
        _ ≤ 4 * π * kM thetaC * (Λ / 2 ^ m) := by
            rw [one_mul, abs_div, abs_of_pos (by positivity : (0 : ℝ) < 2 ^ m)]
            have := kM_nonneg thetaC_nonneg
            have hm : (0 : ℝ) < 2 ^ m := by positivity
            rw [div_eq_mul_inv, div_eq_mul_inv]
            have hinv : 0 < (2 ^ m : ℝ)⁻¹ := inv_pos.2 hm
            calc 2 * π * (|q.2| * (2 ^ m)⁻¹) * kM thetaC
                ≤ 2 * π * (2 * Λ * (2 ^ m)⁻¹) * kM thetaC := by gcongr
              _ = 4 * π * kM thetaC * (Λ * (2 ^ m)⁻¹) := by ring

theorem eLpNorm_gHi_le (m : ℕ) {Λ : ℝ} (hΛ : 0 < Λ) : eLpNorm (gHi f m Λ) 2 volume ≤ 2 := by
  have h := eLpNorm_le_of_fibF_le 1 (measurable_gHi hf m Λ) (measurable_const (a := (0 : ℂ)))
    hf.measurable_fc (fibL12_gHi hf m hΛ) (fun p => ⟨integrable_zero _ _ _, MemLp.zero⟩)
    (hf.fibL12 1) (c := 2) (by norm_num) (fun q => ?_)
  · rw [eLpNorm_zero', zero_add] at h
    refine h.trans ?_
    calc ENNReal.ofReal 2 * eLpNorm (fc f) 2 volume ≤ ENNReal.ofReal 2 * 1 := by
          gcongr; exact hf.eLpNorm_fc_le
      _ = 2 := by rw [mul_one]; simp
  · have h0 : fibF 1 (fun _ : ℝ × ℝ => (0 : ℂ)) q = 0 := by
      unfold fibF monoFib; simp [Real.fourier_real_eq]
    rw [h0, norm_zero, zero_add, fibF_gHi hf m hΛ, fibF_gF hf m, ← mul_assoc, norm_mul]
    refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
    rw [norm_mul]
    have ha : ‖(1 : ℂ) - (monoPhi (q.2 / Λ) : ℂ)‖ ≤ 1 := by
      rw [← Complex.ofReal_one, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (by linarith [monoPhi_le_one (q.2 / Λ)])]
      linarith [monoPhi_nonneg (q.2 / Λ)]
    have hb : ‖1 - 𝓕 (cK (dil thetaC m)) q.2‖ ≤ 2 := by
      refine (norm_sub_le _ _).trans ?_
      rw [norm_one]
      linarith [norm_fourier_cK_le_one (dil_nonneg thetaC_nonneg m)
        (dil_integral thetaC_integral m) q.2]
    calc ‖(1 : ℂ) - (monoPhi (q.2 / Λ) : ℂ)‖ * ‖1 - 𝓕 (cK (dil thetaC m)) q.2‖ ≤ 1 * 2 :=
          mul_le_mul ha hb (norm_nonneg _) zero_le_one
      _ = 2 := one_mul _

theorem fibF_gHi_eq_zero (m : ℕ) {Λ : ℝ} (hΛ : 0 < Λ) (p ξ : ℝ) (hξ : |ξ| < Λ) :
    𝓕 (monoFib 1 (gHi f m Λ) p) ξ = 0 := by
  have := fibF_gHi hf m hΛ (p, ξ)
  unfold fibF at this
  rw [this, monoPhi_eq_one, Complex.ofReal_one, sub_self, zero_mul]
  rw [abs_div, abs_of_pos hΛ, div_le_one hΛ]; exact hξ.le

end gparts

theorem fibF_zero (j : Fin 2) (q : ℝ × ℝ) : fibF j (fun _ : ℝ × ℝ => (0 : ℂ)) q = 0 := by
  unfold fibF monoFib; simp [Real.fourier_real_eq]

theorem fibL12_zero (j : Fin 2) : FibL12 j (fun _ : ℝ × ℝ => (0 : ℂ)) :=
  fun _ => ⟨integrable_zero _ _ _, MemLp.zero⟩

theorem eLpNorm_Hc_sub_le {f : ℝ × ℝ → ℝ} (hf : SqFun f) (j : Fin 2) (m m' : ℕ) :
    eLpNorm (Hc f j m - Hc f j m') 2 volume ≤ 2 := by
  have h := eLpNorm_le_of_fibF_le j ((measurable_Hc hf j m).sub (measurable_Hc hf j m'))
    (measurable_const (a := (0 : ℂ))) hf.measurable_fc
    (fibL12_sub (fibL12_Hc hf j m) (fibL12_Hc hf j m')) (fibL12_zero j) (hf.fibL12 j)
    (c := 2) (by norm_num) (fun q => ?_)
  · rw [eLpNorm_zero', zero_add] at h
    refine h.trans ?_
    calc ENNReal.ofReal 2 * eLpNorm (fc f) 2 volume ≤ ENNReal.ofReal 2 * 1 := by
          gcongr; exact hf.eLpNorm_fc_le
      _ = 2 := by rw [mul_one]; simp
  · rw [fibF_zero, norm_zero, zero_add, fibF_sub (fun p => (fibL12_Hc hf j m p).1)
      (fun p => (fibL12_Hc hf j m' p).1), fibF_Hc hf, fibF_Hc hf, ← sub_mul, norm_mul]
    refine mul_le_mul_of_nonneg_right ((norm_sub_le _ _).trans ?_) (norm_nonneg _)
    linarith [norm_fourier_cK_le_one (dil_nonneg thetaC_nonneg m) (dil_integral thetaC_integral m)
      q.2, norm_fourier_cK_le_one (dil_nonneg thetaC_nonneg m') (dil_integral thetaC_integral m')
          q.2]

/-- **The term `I_3`**: `|W_{τ_{k'}}(f - f *_2 ϑ_m)| ≤ 4π M(ϑ) Λ/2^m + 2 C (Λ/4^{k'})^{-δ}` for
every `Λ ≥ 4^{k'}`, splitting `f - f *_2 ϑ_m` at frequency `Λ` and applying the smoothing
inequality to the high part. -/
theorem I3_bound : ∃ C δ : ℝ, 0 < C ∧ 0 < δ ∧ ∀ f : ℝ × ℝ → ℝ, SqFun f → ∀ (m k' : ℕ) (Λ : ℝ),
    (4 : ℝ) ^ k' ≤ Λ →
    ‖Wform f (dil tauC k') (gF f m)‖ ≤
      4 * π * kM thetaC * (Λ / 2 ^ m) + 2 * C * (Λ / 4 ^ k') ^ (-δ) := by
  obtain ⟨C, δ, hC, hδ, hS⟩ := scaled_smoothing
  refine ⟨C, δ, hC, hδ, fun f hf m k' Λ hΛ => ?_⟩
  have hΛ0 : 0 < Λ := lt_of_lt_of_le (by positivity) hΛ
  have hτi := integrable_dil_tauC k'
  have hτm := (dil_tauC_continuous k').measurable
  have hsplit : gF f m = fun z => gLo f m Λ z + gHi f m Λ z := by
    ext z; simp [gHi]
  rw [hsplit, Wform_add hf hτi hτm (measurable_gLo hf m Λ) (measurable_gHi hf m Λ)
    (norm_gLo_le hf m hΛ0) (norm_gHi_le hf m hΛ0)]
  have hlo : ‖Wform f (dil tauC k') (gLo f m Λ)‖ ≤ 4 * π * kM thetaC * (Λ / 2 ^ m) := by
    have h := enorm_Wform_le_L2 hf hτm (measurable_gLo hf m Λ)
    rw [lintegral_enorm_dil_tauC, one_mul] at h
    have h2 := h.trans (eLpNorm_gLo_le hf m hΛ0)
    have hc : 0 ≤ 4 * π * kM thetaC * (Λ / 2 ^ m) := by
      have := kM_nonneg thetaC_nonneg; positivity
    rw [← ofReal_norm] at h2
    exact (ENNReal.ofReal_le_ofReal_iff hc).1 h2
  have hhi : ‖Wform f (dil tauC k') (gHi f m Λ)‖ ≤ 2 * C * (Λ / 4 ^ k') ^ (-δ) := by
    have h := (enorm_Wform_le hf _ _).trans (hS k' Λ hΛ (fc f) (gHi f m Λ) hf.measurable_fc
      (measurable_gHi hf m Λ) 1 _ hf.norm_fc_le (norm_gHi_le hf m hΛ0)
      (fun p => (hf.fibL12 0 p).1) (fun p => (fibL12_gHi hf m hΛ0 p).1)
      (ne_top_of_le_ne_top ENNReal.one_ne_top hf.eLpNorm_fc_le)
      (ne_top_of_le_ne_top ENNReal.ofNat_ne_top (eLpNorm_gHi_le hf m hΛ0))
      (fun p ξ hξ => fibF_gHi_eq_zero hf m hΛ0 p ξ hξ))
    have hb : eLpNorm (fc f) 2 volume * eLpNorm (gHi f m Λ) 2 volume ≤ 2 := by
      calc eLpNorm (fc f) 2 volume * eLpNorm (gHi f m Λ) 2 volume ≤ 1 * 2 :=
            mul_le_mul' hf.eLpNorm_fc_le (eLpNorm_gHi_le hf m hΛ0)
        _ = 2 := one_mul _
    have h3 : ‖Wform f (dil tauC k') (gHi f m Λ)‖ₑ ≤ ENNReal.ofReal (C * (Λ / 4 ^ k') ^ (-δ)) * 2 :=
      h.trans (by gcongr)
    rw [← ofReal_norm, show (2 : ℝ≥0∞) = ENNReal.ofReal 2 by simp,
      ← ENNReal.ofReal_mul (by positivity)] at h3
    have := (ENNReal.ofReal_le_ofReal_iff (by positivity)).1 h3
    linarith
  exact (norm_add_le _ _).trans (add_le_add hlo hhi)

/-- `D_j(k, m) = ‖f *_j ϑ_m - f *_j ϑ_k‖_2`. -/
def Dj (f : ℝ × ℝ → ℝ) (j : Fin 2) (k m : ℕ) : ℝ := (eLpNorm (Hc f j m - Hc f j k) 2 volume).toReal

theorem Dj_nonneg (f : ℝ × ℝ → ℝ) (j : Fin 2) (k m : ℕ) : 0 ≤ Dj f j k m := ENNReal.toReal_nonneg

theorem norm_le_Dj {f : ℝ × ℝ → ℝ} (hf : SqFun f) (j : Fin 2) (k m : ℕ) {x : ℂ}
    (hx : ‖x‖ₑ ≤ eLpNorm (Hc f j m - Hc f j k) 2 volume) : ‖x‖ ≤ Dj f j k m := by
  have hfin : eLpNorm (Hc f j m - Hc f j k) 2 volume ≠ ⊤ :=
    ne_top_of_le_ne_top ENNReal.ofNat_ne_top (eLpNorm_Hc_sub_le hf j m k)
  rw [← ofReal_norm] at hx
  exact (ENNReal.ofReal_le_iff_le_toReal hfin).1 hx

/-- **The one-step inequality** (the display `c_0 ε^4 ≤ 2^{k'} I + ‖f *_2 ϑ_{k''} - f *_2 ϑ_k‖_2 +
‖f *_1 ϑ_{k''} - f *_1 ϑ_k‖_2 + 2^{-100} c_0 ε^4` of the source, lines 2086-2087), with
`k' = 2k`, `k'' = 6k` and an explicit error `C 2^{-δ k}`. -/
theorem one_step : ∃ C δ : ℝ, 0 < C ∧ 0 < δ ∧ δ ≤ 1 ∧ ∀ f : ℝ × ℝ → ℝ, SqFun f → ∀ k : ℕ, 1 ≤ k →
    thetaC 0 ^ 2 * (∫ z, f z) ^ 4 ≤
      2 ^ (2 * k) * patI f + Dj f 0 k (6 * k) + Dj f 1 k (6 * k) + C * ((2 : ℝ) ^ k) ^ (-δ) := by
  obtain ⟨C₃, δ₃, hC₃, hδ₃, hI3⟩ := I3_bound
  obtain ⟨L, hL⟩ := thetaC_lipschitz
  set δ := min δ₃ 1
  have hδ : 0 < δ := lt_min hδ₃ one_pos
  set A := kD tauR * kM thetaC + kD thetaC * kM tauR
  have hA : 0 ≤ A := by
    have := kD_nonneg tauR; have := kD_nonneg thetaC
    have := kM_nonneg thetaC_nonneg; have := kM_nonneg tauR_nonneg
    positivity
  have hM := kM_nonneg thetaC_nonneg
  refine ⟨4 * π * kM thetaC + 2 * C₃ + 24 * L + A + 1, δ, by positivity, hδ, min_le_right _ _,
    fun f hf k hk => ?_⟩
  set k' := 2 * k
  set k'' := 6 * k
  set Λ : ℝ := 2 ^ (5 * k)
  have h2k : (1 : ℝ) ≤ 2 ^ k := one_le_pow₀ (by norm_num)
  set x : ℝ := (2 : ℝ) ^ k with hxdef
  have hx2 : (2 : ℝ) ≤ x := by
    calc (2 : ℝ) = 2 ^ 1 := by norm_num
      _ ≤ x := pow_le_pow_right₀ (by norm_num) hk
  have hx0 : 0 < x := by positivity
  have hpw : ∀ n : ℕ, (2 : ℝ) ^ (n * k) = x ^ n := fun n => by rw [mul_comm, pow_mul]
  have h4 : (4 : ℝ) ^ k' = x ^ 4 := by
    simp only [k']; rw [show (4 : ℝ) = 2 ^ 2 by norm_num, ← pow_mul, ← hpw 4]; ring_nf
  have hΛx : Λ = x ^ 5 := hpw 5
  have h6 : (2 : ℝ) ^ k'' = x ^ 6 := hpw 6
  have h2' : (2 : ℝ) ^ k' = x ^ 2 := hpw 2
  have hΛ : (4 : ℝ) ^ k' ≤ Λ := by
    rw [h4, hΛx]; exact pow_le_pow_right₀ (by linarith) (by norm_num)
  -- the decomposition `f = f *_2 ϑ_k + (f *_2 ϑ_{k''} - f *_2 ϑ_k) + (f - f *_2 ϑ_{k''})`
  have hτi := integrable_dil_tauC k'
  have hτm := (dil_tauC_continuous k').measurable
  have hd : ∀ z, ‖(Hc f 1 k'' - Hc f 1 k) z‖ ≤ 2 := fun z => by
    rw [Pi.sub_apply]; refine (norm_sub_le _ _).trans ?_
    linarith [norm_Hc_le hf 1 k'' z, norm_Hc_le hf 1 k z]
  have hsplit : fc f = fun z => (fun z => Hc f 1 k z + (Hc f 1 k'' - Hc f 1 k) z) z + gF f k'' z
      := by
    ext z; simp [gF]
  have hW : Wform f (dil tauC k') (fc f) = Wform f (dil tauC k') (Hc f 1 k) +
      Wform f (dil tauC k') (Hc f 1 k'' - Hc f 1 k) + Wform f (dil tauC k') (gF f k'') := by
    conv_lhs => rw [hsplit]
    rw [Wform_add (h₁ := fun z => Hc f 1 k z + (Hc f 1 k'' - Hc f 1 k) z) (h₂ := gF f k'')
        hf hτi hτm ((measurable_Hc hf 1 k).add ((measurable_Hc hf 1 k'').sub
        (measurable_Hc hf 1 k))) (measurable_gF hf k'') (M₁ := 1 + 2)
        (fun z => (norm_add_le _ _).trans (add_le_add (norm_Hc_le hf 1 k z) (hd z)))
        (norm_gF_le hf k''),
      Wform_add (h₁ := Hc f 1 k) (h₂ := Hc f 1 k'' - Hc f 1 k) hf hτi hτm (measurable_Hc hf 1 k)
        ((measurable_Hc hf 1 k'').sub
        (measurable_Hc hf 1 k)) (norm_Hc_le hf 1 k) hd]
  set V := ∫ z, fc f z * Qτ f k' z * Hc f 1 k z
  set I6 := ∫ z, fc f z * Hc f 0 k z * Hc f 1 k z
  have hI6 : I6 = Wform f (dil tauC k') (fc f) - Wform f (dil tauC k') (Hc f 1 k'' - Hc f 1 k) -
      Wform f (dil tauC k') (gF f k'') - (Wform f (dil tauC k') (Hc f 1 k) - V) - (V - I6) := by
    linear_combination (-1 : ℂ) * hW
  -- the individual bounds
  have b1 : ‖Wform f (dil tauC k') (fc f)‖ ≤ 2 ^ (2 * k) * patI f :=
    norm_Wform_fc_le hf (by omega)
  have b2 : ‖Wform f (dil tauC k') (Hc f 1 k'' - Hc f 1 k)‖ ≤ Dj f 1 k k'' :=
    norm_le_Dj hf 1 k k'' (I2_bound hf k k' k'')
  have b3 := hI3 f hf k'' k' Λ hΛ
  have hkm : (2 : ℝ) ^ k * (4 / 4 ^ k') ≤ 1 := by
    rw [h4, ← hxdef, mul_div_assoc', div_le_one (by positivity)]
    have : (8 : ℝ) ≤ x ^ 3 := by nlinarith
    nlinarith
  have b4 := I4_bound hf hL hkm
  have hE5 : ‖V - I6‖ ≤ Dj f 0 k k'' + (kD tauR * kM thetaC * (2 ^ k' / 2 ^ k'') +
      kD thetaC * kM tauR * (2 ^ k / 2 ^ k')) := by
    have h5 := I5_bound hf k k' k''
    have hfin : eLpNorm (Hc f 0 k'' - Hc f 0 k) 2 volume ≠ ⊤ :=
      ne_top_of_le_ne_top ENNReal.ofNat_ne_top (eLpNorm_Hc_sub_le hf 0 k'' k)
    rw [← ofReal_norm] at h5
    have hE0 : 0 ≤ kD tauR * kM thetaC * (2 ^ k' / 2 ^ k'') +
        kD thetaC * kM tauR * (2 ^ k / 2 ^ k') := by
      have := kD_nonneg tauR; have := kD_nonneg thetaC
      have := kM_nonneg thetaC_nonneg; have := kM_nonneg tauR_nonneg
      positivity
    rw [← ENNReal.ofReal_toReal hfin, ← ENNReal.ofReal_add ENNReal.toReal_nonneg hE0] at h5
    exact (ENNReal.ofReal_le_ofReal_iff (add_nonneg ENNReal.toReal_nonneg hE0)).1 h5
  -- the powers of two
  have hinv : (2 : ℝ) ^ k ≠ 0 := by positivity
  have hdec : ((2 : ℝ) ^ k)⁻¹ ≤ ((2 : ℝ) ^ k) ^ (-δ) := by
    rw [← Real.rpow_neg_one]
    exact Real.rpow_le_rpow_of_exponent_le h2k (by linarith [min_le_right δ₃ 1])
  have hdec' : ((2 : ℝ) ^ k) ^ (-δ₃) ≤ ((2 : ℝ) ^ k) ^ (-δ) :=
    Real.rpow_le_rpow_of_exponent_le h2k (by linarith [min_le_left δ₃ 1])
  have e3 : Λ / 2 ^ k'' = ((2 : ℝ) ^ k)⁻¹ := by
    rw [hΛx, h6, ← hxdef]; field_simp
  have e3' : Λ / 4 ^ k' = (2 : ℝ) ^ k := by
    rw [hΛx, h4, ← hxdef]; field_simp
  have e4 : (2 : ℝ) ^ k * (4 / 4 ^ k') ≤ 4 * ((2 : ℝ) ^ k)⁻¹ := by
    rw [h4, ← hxdef, mul_div_assoc', div_le_iff₀ (by positivity)]
    field_simp
    nlinarith
  have e5a : (2 : ℝ) ^ k' / 2 ^ k'' ≤ ((2 : ℝ) ^ k)⁻¹ := by
    rw [h2', h6, ← hxdef, div_le_iff₀ (by positivity)]
    field_simp
    nlinarith [pow_pos hx0 3]
  have e5b : (2 : ℝ) ^ k / 2 ^ k' = ((2 : ℝ) ^ k)⁻¹ := by
    rw [h2', ← hxdef]; field_simp
  -- assembly
  have hre : thetaC 0 ^ 2 * (∫ z, f z) ^ 4 ≤ ‖I6‖ := (I6_ge hf k).trans (Complex.re_le_norm _)
  rw [hI6] at hre
  have htri : ‖Wform f (dil tauC k') (fc f) - Wform f (dil tauC k') (Hc f 1 k'' - Hc f 1 k) -
      Wform f (dil tauC k') (gF f k'') - (Wform f (dil tauC k') (Hc f 1 k) - V) - (V - I6)‖ ≤
      ‖Wform f (dil tauC k') (fc f)‖ + ‖Wform f (dil tauC k') (Hc f 1 k'' - Hc f 1 k)‖ +
      ‖Wform f (dil tauC k') (gF f k'')‖ + ‖Wform f (dil tauC k') (Hc f 1 k) - V‖ + ‖V - I6‖ := by
    refine (norm_sub_le _ _).trans ?_
    gcongr
    refine (norm_sub_le _ _).trans ?_
    gcongr
    refine (norm_sub_le _ _).trans ?_
    gcongr
    exact norm_sub_le _ _
  refine hre.trans (htri.trans ?_)
  rw [e3, e3'] at b3
  set u := ((2 : ℝ) ^ k) ^ (-δ)
  have hu : 0 ≤ u := by positivity
  have hkDM : 0 ≤ kD tauR * kM thetaC := mul_nonneg (kD_nonneg _) (kM_nonneg thetaC_nonneg)
  have hkDM' : 0 ≤ kD thetaC * kM tauR := mul_nonneg (kD_nonneg _) (kM_nonneg tauR_nonneg)
  have hE5' : ‖V - I6‖ ≤ Dj f 0 k k'' + A * u := by
    refine hE5.trans ?_
    have := mul_le_mul_of_nonneg_left (e5a.trans hdec) hkDM
    have := mul_le_mul_of_nonneg_left ((le_of_eq e5b).trans hdec) hkDM'
    simp only [A]; nlinarith
  have hb4 : ‖Wform f (dil tauC k') (Hc f 1 k) - V‖ ≤ 24 * L * u := by
    refine b4.trans ?_
    have hL0 : (0 : ℝ) ≤ L := L.2
    calc 6 * (L : ℝ) * 2 ^ k * (4 / 4 ^ k') = 6 * L * (2 ^ k * (4 / 4 ^ k')) := by ring
      _ ≤ 6 * L * (4 * ((2 : ℝ) ^ k)⁻¹) := by gcongr
      _ ≤ 6 * L * (4 * u) := by gcongr
      _ = 24 * L * u := by ring
  have hb3 : ‖Wform f (dil tauC k') (gF f k'')‖ ≤ (4 * π * kM thetaC + 2 * C₃) * u := by
    refine b3.trans ?_
    have h1 := mul_le_mul_of_nonneg_left hdec (by positivity : (0 : ℝ) ≤ 4 * π * kM thetaC)
    have h2 := mul_le_mul_of_nonneg_left hdec' (by positivity : (0 : ℝ) ≤ 2 * C₃)
    calc 4 * π * kM thetaC * ((2 : ℝ) ^ k)⁻¹ + 2 * C₃ * ((2 : ℝ) ^ k) ^ (-δ₃)
        ≤ 4 * π * kM thetaC * u + 2 * C₃ * u := add_le_add h1 h2
      _ = _ := by ring
  have hsum : (4 * π * kM thetaC + 2 * C₃ + 24 * L + A + 1) * u =
      (4 * π * kM thetaC + 2 * C₃) * u + 24 * L * u + A * u + u := by ring
  linarith [b1, b2, hb3, hb4, hE5']

/-! ### Almost orthogonality of the increments `f *_j ϑ_{k_{l+1}} - f *_j ϑ_{k_l}` -/

/-- The telescoping weight `Φ(s) = s^2 / (1 + s^2)`. -/
def phiT (s : ℝ) : ℝ := s ^ 2 / (1 + s ^ 2)

theorem phiT_nonneg (s : ℝ) : 0 ≤ phiT s := by unfold phiT; positivity

theorem phiT_le_one (s : ℝ) : phiT s ≤ 1 := by
  unfold phiT; rw [div_le_one (by positivity)]; linarith

/-- `min(1, s^2, 1/s'^2) ≤ (16/3)(Φ(s) - Φ(s'))` for `0 < s' ≤ s/2`. -/
theorem min_le_phiT_sub {s s' : ℝ} (hs' : 0 < s') (hss : 2 * s' ≤ s) :
    min 1 (min (s ^ 2) (1 / s' ^ 2)) ≤ 16 / 3 * (phiT s - phiT s') := by
  have hs : 0 < s := by linarith
  have hd : phiT s - phiT s' = (s ^ 2 - s' ^ 2) / ((1 + s ^ 2) * (1 + s' ^ 2)) := by
    unfold phiT; field_simp; ring
  have h34 : 3 / 4 * s ^ 2 ≤ s ^ 2 - s' ^ 2 := by nlinarith
  rw [hd]
  have hP : 0 < (1 + s ^ 2) * (1 + s' ^ 2) := by positivity
  rcases le_or_gt s 1 with h1 | h1
  · -- `s ≤ 1`
    refine (min_le_right _ _).trans ((min_le_left _ _).trans ?_)
    rw [mul_div_assoc', le_div_iff₀ hP]
    have : s' ≤ 1 := by linarith
    have hs2 : s ^ 2 ≤ 1 := by nlinarith
    have hs'2 : s' ^ 2 ≤ 1 := by nlinarith
    nlinarith [mul_le_mul hs2 hs'2 (by positivity) zero_le_one]
  rcases le_or_gt 1 s' with h2 | h2
  · -- `s' ≥ 1`
    refine (min_le_right _ _).trans ((min_le_right _ _).trans ?_)
    rw [mul_div_assoc', div_le_div_iff₀ (by positivity) hP]
    have hs2 : 1 ≤ s ^ 2 := by nlinarith
    have hs'2 : 1 ≤ s' ^ 2 := by nlinarith
    nlinarith [mul_le_mul_of_nonneg_left hs'2 (by positivity : (0 : ℝ) ≤ s ^ 2)]
  · -- `s' < 1 < s`
    refine (min_le_left _ _).trans ?_
    rw [mul_div_assoc', le_div_iff₀ hP]
    have hs2 : 1 ≤ s ^ 2 := by nlinarith
    have hs'2 : s' ^ 2 ≤ 1 := by nlinarith
    nlinarith [mul_le_mul_of_nonneg_left hs'2 (by positivity : (0 : ℝ) ≤ 1 + s ^ 2)]

/-- `|ϑ̂(ξ/2^n) - ϑ̂(ξ/2^m)|^2 ≤ 4 c^2 min(1, s^2, 1/s'^2)` with `s = |ξ|/2^m`, `s' = |ξ|/2^n`. -/
theorem sq_norm_theta_diff_le {m n : ℕ} (hmn : m ≤ n) (ξ : ℝ) (hξ : ξ ≠ 0) :
    ‖𝓕 (cK (dil thetaC n)) ξ - 𝓕 (cK (dil thetaC m)) ξ‖ ^ 2 ≤
      4 * (1 + 2 * π * kM thetaC + kD thetaC / (2 * π)) ^ 2 *
        min 1 (min ((|ξ| / 2 ^ m) ^ 2) (1 / (|ξ| / 2 ^ n) ^ 2)) := by
  rw [fourier_cK_dil, fourier_cK_dil]
  set c := 1 + 2 * π * kM thetaC + kD thetaC / (2 * π)
  have hM := kM_nonneg thetaC_nonneg
  have hD := kD_nonneg thetaC
  have hc1 : 1 ≤ c := by have : 0 ≤ kD thetaC / (2 * π) := by positivity
                         simp only [c]; nlinarith [Real.pi_pos]
  have hmom := integrable_moment_of_hasCompactSupport thetaC_contDiff.continuous
    thetaC_hasCompactSupport
  set s := |ξ| / 2 ^ m
  set s' := |ξ| / 2 ^ n
  have hsabs : |ξ / 2 ^ m| = s := by rw [abs_div, abs_of_pos (by positivity : (0 : ℝ) < 2 ^ m)]
  have hs'abs : |ξ / 2 ^ n| = s' := by
    rw [abs_div, abs_of_pos (by positivity : (0 : ℝ) < 2 ^ n)]
  have h1A : ‖1 - 𝓕 (cK thetaC) (ξ / 2 ^ n)‖ ≤ 2 * π * s' * kM thetaC := by
    have := norm_one_sub_fourier_cK_le thetaC_nonneg thetaC_integrable thetaC_integral hmom
      (ξ / 2 ^ n)
    rwa [hs'abs] at this
  have h1B : ‖1 - 𝓕 (cK thetaC) (ξ / 2 ^ m)‖ ≤ 2 * π * s * kM thetaC := by
    have := norm_one_sub_fourier_cK_le thetaC_nonneg thetaC_integrable thetaC_integral hmom
      (ξ / 2 ^ m)
    rwa [hsabs] at this
  have hdA : ‖𝓕 (cK thetaC) (ξ / 2 ^ n)‖ ≤ kD thetaC / (2 * π * s') := by
    have := norm_fourier_cK_le_deriv (thetaC_contDiff.of_le (by norm_num))
      thetaC_hasCompactSupport (div_ne_zero hξ (by positivity : (2 : ℝ) ^ n ≠ 0))
    rwa [hs'abs] at this
  have hdB : ‖𝓕 (cK thetaC) (ξ / 2 ^ m)‖ ≤ kD thetaC / (2 * π * s) := by
    have := norm_fourier_cK_le_deriv (thetaC_contDiff.of_le (by norm_num))
      thetaC_hasCompactSupport (div_ne_zero hξ (by positivity : (2 : ℝ) ^ m ≠ 0))
    rwa [hsabs] at this
  have hA1 : ‖𝓕 (cK thetaC) (ξ / 2 ^ n)‖ ≤ 1 :=
    norm_fourier_cK_le_one thetaC_nonneg thetaC_integral _
  have hB1 : ‖𝓕 (cK thetaC) (ξ / 2 ^ m)‖ ≤ 1 :=
    norm_fourier_cK_le_one thetaC_nonneg thetaC_integral _
  set A := 𝓕 (cK thetaC) (ξ / 2 ^ n)
  set B := 𝓕 (cK thetaC) (ξ / 2 ^ m)
  have hs'pos : 0 < s' := by positivity
  have hspos : 0 < s := by positivity
  have hstri : ‖A - B‖ ≤ 2 := (norm_sub_le _ _).trans (by linarith)
  have hss : s' ≤ s := by
    simp only [s, s']
    exact div_le_div_of_nonneg_left (abs_nonneg _) (by positivity)
      (pow_le_pow_right₀ (by norm_num) hmn)
  have hcM : 2 * π * kM thetaC ≤ c := by
    have : 0 ≤ kD thetaC / (2 * π) := by positivity
    simp only [c]; linarith
  have hcD : kD thetaC / (2 * π) ≤ c := by simp only [c]; nlinarith [Real.pi_pos]
  -- three bounds for `‖A - B‖`
  have b1 : ‖A - B‖ ≤ 2 * c := by linarith
  have b2 : ‖A - B‖ ≤ 2 * c * s := by
    have : A - B = (1 - B) - (1 - A) := by ring
    rw [this]
    refine (norm_sub_le _ _).trans ?_
    have : 2 * π * s' * kM thetaC ≤ 2 * π * s * kM thetaC := by gcongr
    nlinarith
  have b3 : ‖A - B‖ ≤ 2 * c * (1 / s') := by
    refine (norm_sub_le _ _).trans ?_
    have e1 : kD thetaC / (2 * π * s') = kD thetaC / (2 * π) * (1 / s') := by field_simp
    have e2 : kD thetaC / (2 * π * s) ≤ kD thetaC / (2 * π) * (1 / s') := by
      rw [div_mul_div_comm, mul_one]
      exact div_le_div_of_nonneg_left hD (by positivity) (by nlinarith [Real.pi_pos])
    rw [e1] at hdA
    have : kD thetaC / (2 * π) * (1 / s') ≤ c * (1 / s') :=
      mul_le_mul_of_nonneg_right hcD (by positivity)
    linarith
  have hAB : ‖A - B‖ ≤ 2 * c * min 1 (min s (1 / s')) := by
    rcases min_choice 1 (min s (1 / s')) with h | h <;> rw [h]
    · linarith
    · rcases min_choice s (1 / s') with h' | h' <;> rw [h']
      · exact b2
      · exact b3
  set m0 := min 1 (min s (1 / s'))
  have hm0 : 0 ≤ m0 := le_min zero_le_one (le_min hspos.le (by positivity))
  have hm0sq : m0 ^ 2 ≤ min 1 (min (s ^ 2) (1 / s' ^ 2)) := by
    have h1 : m0 ≤ 1 := min_le_left _ _
    have h2 : m0 ≤ s := (min_le_right _ _).trans (min_le_left _ _)
    have h3 : m0 ≤ 1 / s' := (min_le_right _ _).trans (min_le_right _ _)
    refine le_min ?_ (le_min ?_ ?_)
    · nlinarith
    · exact pow_le_pow_left₀ hm0 h2 2
    · rw [one_div, ← inv_pow]; rw [one_div] at h3; exact pow_le_pow_left₀ hm0 h3 2
  calc ‖A - B‖ ^ 2 ≤ (2 * c * m0) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hAB 2
    _ = 4 * c ^ 2 * m0 ^ 2 := by ring
    _ ≤ 4 * c ^ 2 * min 1 (min (s ^ 2) (1 / s' ^ 2)) := by gcongr

theorem fourier_cK_dil_theta_zero (m : ℕ) : 𝓕 (cK (dil thetaC m)) 0 = 1 := by
  rw [Real.fourier_real_eq]
  simp only [mul_zero, neg_zero, AddChar.map_zero_eq_one, one_smul]
  rw [show (∫ v, cK (dil thetaC m) v) = ((∫ v, dil thetaC m v : ℝ) : ℂ) from integral_ofReal,
    dil_integral thetaC_integral m, Complex.ofReal_one]

/-- The constant of the almost orthogonality. -/
def orthoB : ℝ := 4 * (1 + 2 * π * kM thetaC + kD thetaC / (2 * π)) ^ 2 * (16 / 3)

theorem orthoB_nonneg : 0 ≤ orthoB := by unfold orthoB; positivity

/-- For the lacunary sequence `k_l = 6^l k₀`:
`∑_{l < L} |ϑ̂(ξ/2^{k_{l+1}}) - ϑ̂(ξ/2^{k_l})|^2 ≤ B`. -/
theorem sum_sq_theta_diff_le (k0 : ℕ) (hk0 : 1 ≤ k0) (L : ℕ) (ξ : ℝ) :
    ∑ l ∈ Finset.range L, ‖𝓕 (cK (dil thetaC (6 ^ (l + 1) * k0))) ξ -
      𝓕 (cK (dil thetaC (6 ^ l * k0))) ξ‖ ^ 2 ≤ orthoB := by
  by_cases hξ : ξ = 0
  · subst hξ
    simp only [fourier_cK_dil_theta_zero, sub_self, norm_zero, ne_eq, OfNat.ofNat_ne_zero,
      not_false_eq_true, zero_pow, Finset.sum_const_zero]
    exact orthoB_nonneg
  set c := 1 + 2 * π * kM thetaC + kD thetaC / (2 * π)
  set s : ℕ → ℝ := fun l => |ξ| / 2 ^ (6 ^ l * k0)
  have hs : ∀ l, 0 < s l := fun l => by simp only [s]; positivity
  have hs2 : ∀ l, 2 * s (l + 1) ≤ s l := by
    intro l
    simp only [s]
    rw [mul_div_assoc', div_le_div_iff₀ (by positivity) (by positivity)]
    have hexp : 6 ^ l * k0 + 1 ≤ 6 ^ (l + 1) * k0 := by
      rw [pow_succ]; nlinarith [Nat.one_le_pow l 6 (by norm_num)]
    have : (2 : ℝ) ^ (6 ^ l * k0) * 2 ≤ 2 ^ (6 ^ (l + 1) * k0) := by
      rw [← pow_succ]; exact pow_le_pow_right₀ (by norm_num) hexp
    nlinarith [abs_nonneg ξ, (by positivity : (0 : ℝ) < 2 ^ (6 ^ l * k0))]
  have hterm : ∀ l, ‖𝓕 (cK (dil thetaC (6 ^ (l + 1) * k0))) ξ -
      𝓕 (cK (dil thetaC (6 ^ l * k0))) ξ‖ ^ 2 ≤
      4 * c ^ 2 * (16 / 3 * (phiT (s l) - phiT (s (l + 1)))) := by
    intro l
    have hmn : 6 ^ l * k0 ≤ 6 ^ (l + 1) * k0 := by
      rw [pow_succ]; exact Nat.mul_le_mul_right k0 (Nat.le_mul_of_pos_right _ (by norm_num))
    refine (sq_norm_theta_diff_le hmn ξ hξ).trans ?_
    gcongr
    exact min_le_phiT_sub (hs (l + 1)) (hs2 l)
  calc ∑ l ∈ Finset.range L, ‖𝓕 (cK (dil thetaC (6 ^ (l + 1) * k0))) ξ -
        𝓕 (cK (dil thetaC (6 ^ l * k0))) ξ‖ ^ 2
      ≤ ∑ l ∈ Finset.range L, 4 * c ^ 2 * (16 / 3 * (phiT (s l) - phiT (s (l + 1)))) :=
        Finset.sum_le_sum fun l _ => hterm l
    _ = 4 * c ^ 2 * (16 / 3 * (phiT (s 0) - phiT (s L))) := by
        rw [← Finset.mul_sum, ← Finset.mul_sum, Finset.sum_range_sub']
    _ ≤ 4 * c ^ 2 * (16 / 3 * 1) := by
        gcongr
        linarith [phiT_le_one (s 0), phiT_nonneg (s L)]
    _ = orthoB := by simp only [orthoB, c]; ring

theorem eLpNorm_sq_toReal {G : ℝ × ℝ → ℂ} :
    (eLpNorm G 2 volume).toReal ^ 2 = (∫⁻ z, ‖G z‖ₑ ^ 2).toReal := by
  rw [eLpNorm_two_eq_lintegral_nat, ← ENNReal.toReal_rpow, ← Real.rpow_natCast,
    ← Real.rpow_mul ENNReal.toReal_nonneg]
  norm_num

/-- **Almost orthogonality** (the Plancherel step, lines 2103-2106):
`∑_{l<L} ‖f *_j ϑ_{k_{l+1}} - f *_j ϑ_{k_l}‖_2^2 ≤ B` for `k_l = 6^l k₀`. -/
theorem sum_Dj_sq_le {f : ℝ × ℝ → ℝ} (hf : SqFun f) (j : Fin 2) (k0 : ℕ) (hk0 : 1 ≤ k0)
    (L : ℕ) :
    ∑ l ∈ Finset.range L, Dj f j (6 ^ l * k0) (6 ^ (l + 1) * k0) ^ 2 ≤ orthoB := by
  set G : ℕ → ℝ × ℝ → ℂ := fun l => Hc f j (6 ^ (l + 1) * k0) - Hc f j (6 ^ l * k0)
  have hG : ∀ l, Measurable (G l) := fun l => (measurable_Hc hf j _).sub (measurable_Hc hf j _)
  have hfG : ∀ l, FibL12 j (G l) := fun l => fibL12_sub (fibL12_Hc hf j _) (fibL12_Hc hf j _)
  have hsum := sum_lintegral_sq_le_of_fibF (Finset.range L) j hG hf.measurable_fc hfG
    (hf.fibL12 j) orthoB_nonneg (fun q => by
      have e : ∀ l, fibF j (G l) q = (𝓕 (cK (dil thetaC (6 ^ (l + 1) * k0))) q.2 -
          𝓕 (cK (dil thetaC (6 ^ l * k0))) q.2) * fibF j (fc f) q := fun l => by
        simp only [G]
        rw [fibF_sub (fun p => (fibL12_Hc hf j _ p).1) (fun p => (fibL12_Hc hf j _ p).1),
          fibF_Hc hf, fibF_Hc hf, sub_mul]
      simp_rw [e, norm_mul, mul_pow]
      rw [← Finset.sum_mul]
      exact mul_le_mul_of_nonneg_right (sum_sq_theta_diff_le k0 hk0 L q.2) (by positivity))
  have hfin : ∀ l ∈ Finset.range L, ∫⁻ z, ‖G l z‖ₑ ^ 2 ≠ ⊤ := fun l _ => by
    have h := eLpNorm_Hc_sub_le hf j (6 ^ (l + 1) * k0) (6 ^ l * k0)
    rw [eLpNorm_two_eq_lintegral_nat] at h
    intro htop
    rw [show G l = Hc f j (6 ^ (l + 1) * k0) - Hc f j (6 ^ l * k0) from rfl] at htop
    rw [htop, ENNReal.top_rpow_of_pos (by norm_num)] at h
    exact absurd h (by simp)
  calc ∑ l ∈ Finset.range L, Dj f j (6 ^ l * k0) (6 ^ (l + 1) * k0) ^ 2
      = (∑ l ∈ Finset.range L, ∫⁻ z, ‖G l z‖ₑ ^ 2).toReal := by
        rw [ENNReal.toReal_sum hfin]
        refine Finset.sum_congr rfl fun l _ => ?_
        exact eLpNorm_sq_toReal
    _ ≤ (ENNReal.ofReal orthoB * ∫⁻ z, ‖fc f z‖ₑ ^ 2).toReal := by
        refine ENNReal.toReal_mono (ENNReal.mul_ne_top ENNReal.ofReal_ne_top
          (ne_top_of_le_ne_top ENNReal.one_ne_top hf.lintegral_enorm_fc_sq_le)) hsum
    _ ≤ orthoB * 1 := by
        rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal orthoB_nonneg]
        exact mul_le_mul_of_nonneg_left (ENNReal.toReal_le_of_le_ofReal zero_le_one
          (by simpa using hf.lintegral_enorm_fc_sq_le)) orthoB_nonneg
    _ = orthoB := mul_one _

/-! ### The iteration (lines 2093-2108) -/

theorem half_le_two_rpow {y : ℝ} (hy : 0 ≤ y) : y / 2 ≤ (2 : ℝ) ^ y := by
  rw [Real.rpow_def_of_pos (by norm_num)]
  have h1 := Real.add_one_le_exp (Real.log 2 * y)
  have h2 : (1 / 2 : ℝ) < Real.log 2 := by
    have := Real.log_two_gt_d9; linarith
  nlinarith

/-- **The iteration**: for `0 < ε ≤ 1` and `f` with `∫ f ≥ ε` there are `L ≲ ε^{-8}`,
`k₀ ≲ ε^{-4}` with `PI(f) ≥ (c₀ ε^4 / 4) 2^{-2·6^L k₀}`. -/
theorem iteration : ∃ c₀ K₁ K₂ : ℝ, 0 < c₀ ∧ 0 < K₁ ∧ 0 < K₂ ∧
    ∀ ε : ℝ, 0 < ε → ε ≤ 1 → ∀ f : ℝ × ℝ → ℝ, SqFun f → ε ≤ ∫ z, f z →
    ∃ L k₀ : ℕ, (L : ℝ) ≤ K₂ * ε⁻¹ ^ 8 ∧ (k₀ : ℝ) ≤ K₁ * ε⁻¹ ^ 4 ∧
      c₀ * ε ^ 4 / 4 * (2 : ℝ) ^ (-(2 * 6 ^ L * k₀ : ℝ)) ≤ patI f := by
  obtain ⟨C₁, δ, hC₁, hδ, hδ1, hstep⟩ := one_step
  set c₀ := thetaC 0 ^ 2
  have hc₀ : 0 < c₀ := by have := thetaC_zero_pos; positivity
  set B := orthoB
  have hB := orthoB_nonneg
  refine ⟨c₀, 4 * C₁ / (c₀ * δ) + 2, 64 * B / c₀ ^ 2 + 2, hc₀, by positivity, by positivity, ?_⟩
  intro ε hε hε1 f hf hint
  set a := c₀ * ε ^ 4
  have ha : 0 < a := by positivity
  have hε4 : 1 ≤ ε⁻¹ ^ 4 := one_le_pow₀ (one_le_inv₀ hε |>.2 hε1)
  have hε8 : 1 ≤ ε⁻¹ ^ 8 := one_le_pow₀ (one_le_inv₀ hε |>.2 hε1)
  have hint0 : 0 ≤ ∫ z, f z := hε.le.trans hint
  have hmain : a ≤ c₀ * (∫ z, f z) ^ 4 :=
    mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hε.le hint 4) hc₀.le
  set k₀ : ℕ := ⌈4 * C₁ / (a * δ)⌉₊ + 1
  have hk₀ : 1 ≤ k₀ := by omega
  have hk₀b : (k₀ : ℝ) ≤ (4 * C₁ / (c₀ * δ) + 2) * ε⁻¹ ^ 4 := by
    have h1 : (k₀ : ℝ) ≤ 4 * C₁ / (a * δ) + 2 := by
      have := Nat.ceil_lt_add_one (by positivity : (0 : ℝ) ≤ 4 * C₁ / (a * δ))
      simp only [k₀]; push_cast; linarith
    have e : 4 * C₁ / (a * δ) = 4 * C₁ / (c₀ * δ) * ε⁻¹ ^ 4 := by
      simp only [a]; field_simp
    rw [e] at h1
    nlinarith [(by positivity : (0 : ℝ) ≤ 4 * C₁ / (c₀ * δ))]
  -- the error is at most `a/2` for all `k ≥ k₀`
  have herr : ∀ k : ℕ, k₀ ≤ k → C₁ * ((2 : ℝ) ^ k) ^ (-δ) ≤ a / 2 := by
    intro k hk
    have hkδ : 4 * C₁ / (a * δ) ≤ k := by
      have := Nat.le_ceil (4 * C₁ / (a * δ))
      have : (k₀ : ℝ) ≤ k := by exact_mod_cast hk
      simp only [k₀] at this; push_cast at this; linarith
    have hpow : ((2 : ℝ) ^ k) ^ δ = (2 : ℝ) ^ ((k : ℝ) * δ) := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]
    have hge : 2 * C₁ / a ≤ ((2 : ℝ) ^ k) ^ δ := by
      rw [hpow]
      refine le_trans ?_ (half_le_two_rpow (by positivity))
      rw [le_div_iff₀ (by norm_num : (0 : ℝ) < 2)]
      rw [div_le_iff₀ (by positivity)] at hkδ
      calc 2 * C₁ / a * 2 = 4 * C₁ / a := by ring
        _ ≤ k * δ := by rw [div_le_iff₀ ha]; nlinarith
    rw [Real.rpow_neg (by positivity), ← div_eq_mul_inv, div_le_iff₀ (by positivity)]
    rw [div_le_iff₀ ha] at hge
    linarith
  set L : ℕ := ⌈64 * B / a ^ 2⌉₊ + 1
  have hLb : (L : ℝ) ≤ (64 * B / c₀ ^ 2 + 2) * ε⁻¹ ^ 8 := by
    have h1 : (L : ℝ) ≤ 64 * B / a ^ 2 + 2 := by
      have := Nat.ceil_lt_add_one (by positivity : (0 : ℝ) ≤ 64 * B / a ^ 2)
      simp only [L]; push_cast; linarith
    have e : 64 * B / a ^ 2 = 64 * B / c₀ ^ 2 * ε⁻¹ ^ 8 := by
      simp only [a]; field_simp
    rw [e] at h1
    nlinarith [(by positivity : (0 : ℝ) ≤ 64 * B / c₀ ^ 2)]
  -- the dichotomy at the scales `k_l = 6^l k₀`
  have hex : ∃ l < L, a / 4 ≤ 2 ^ (2 * (6 ^ l * k₀)) * patI f := by
    by_contra hno
    push Not at hno
    have hD : ∀ l < L, a ^ 2 / 32 < Dj f 0 (6 ^ l * k₀) (6 ^ (l + 1) * k₀) ^ 2 +
        Dj f 1 (6 ^ l * k₀) (6 ^ (l + 1) * k₀) ^ 2 := by
      intro l hl
      have hs := hstep f hf (6 ^ l * k₀) (le_trans hk₀ (Nat.le_mul_of_pos_left _ (by positivity)))
      have he := herr (6 ^ l * k₀) (Nat.le_mul_of_pos_left _ (by positivity))
      rw [show 6 * (6 ^ l * k₀) = 6 ^ (l + 1) * k₀ by ring] at hs
      have h1 := hno l hl
      set x := Dj f 0 (6 ^ l * k₀) (6 ^ (l + 1) * k₀)
      set y := Dj f 1 (6 ^ l * k₀) (6 ^ (l + 1) * k₀)
      have hxy : a / 4 < x + y := by linarith
      have hx := Dj_nonneg f 0 (6 ^ l * k₀) (6 ^ (l + 1) * k₀)
      have hy := Dj_nonneg f 1 (6 ^ l * k₀) (6 ^ (l + 1) * k₀)
      nlinarith [sq_nonneg (x - y)]
    have hsum0 := sum_Dj_sq_le hf 0 k₀ hk₀ L
    have hsum1 := sum_Dj_sq_le hf 1 k₀ hk₀ L
    have hlow : (L : ℝ) * (a ^ 2 / 32) < ∑ l ∈ Finset.range L,
        (Dj f 0 (6 ^ l * k₀) (6 ^ (l + 1) * k₀) ^ 2 + Dj f 1 (6 ^ l * k₀) (6 ^ (l + 1) * k₀) ^ 2)
            := by
      have hL0 : 0 < L := by omega
      calc (L : ℝ) * (a ^ 2 / 32) = ∑ l ∈ Finset.range L, a ^ 2 / 32 := by simp
        _ < _ := Finset.sum_lt_sum_of_nonempty ⟨0, Finset.mem_range.2 hL0⟩
            fun l hl => hD l (Finset.mem_range.1 hl)
    rw [Finset.sum_add_distrib] at hlow
    have hceil : 64 * B / a ^ 2 < L := by
      have := Nat.le_ceil (64 * B / a ^ 2)
      simp only [L]; push_cast; linarith
    rw [div_lt_iff₀ (by positivity)] at hceil
    nlinarith
  obtain ⟨l, hlL, hl⟩ := hex
  refine ⟨L, k₀, hLb, hk₀b, ?_⟩
  have hPI : 0 ≤ patI f := by
    unfold patI
    refine integral_nonneg fun z => mul_nonneg (hf.nonneg z) (setIntegral_nonneg measurableSet_Icc
      fun t _ => mul_nonneg (hf.nonneg _) (hf.nonneg _))
  have hpos : (0 : ℝ) < 2 ^ (2 * (6 ^ l * k₀)) := by positivity
  have h1 : a / 4 * ((2 : ℝ) ^ (2 * (6 ^ l * k₀)))⁻¹ ≤ patI f := by
    rw [← div_eq_mul_inv, div_le_iff₀ hpos]; linarith
  refine le_trans ?_ h1
  have hrp : (2 : ℝ) ^ (-(2 * 6 ^ L * k₀ : ℝ)) ≤ ((2 : ℝ) ^ (2 * (6 ^ l * k₀)))⁻¹ := by
    rw [Real.rpow_neg (by norm_num)]
    refine inv_anti₀ (by positivity) ?_
    rw [← Real.rpow_natCast]
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num : (1 : ℝ) ≤ 2) ?_
    push_cast
    have : (6 : ℝ) ^ l ≤ 6 ^ L := pow_le_pow_right₀ (by norm_num) hlL.le
    have hk : (0 : ℝ) ≤ k₀ := by positivity
    nlinarith
  calc c₀ * ε ^ 4 / 4 * (2 : ℝ) ^ (-(2 * 6 ^ L * k₀ : ℝ)) = a / 4 * (2 : ℝ) ^ (-(2 * 6 ^ L * k₀ :
      ℝ)) := by
        simp only [a]
    _ ≤ a / 4 * ((2 : ℝ) ^ (2 * (6 ^ l * k₀)))⁻¹ := by gcongr

/-! ### The double exponential bound and the conclusion -/

theorem le_exp_self (x : ℝ) : x ≤ Real.exp x := by linarith [Real.add_one_le_exp x]

theorem six_pow_le_exp (L : ℕ) : (6 : ℝ) ^ L ≤ Real.exp (2 * L) := by
  have h6 : (6 : ℝ) ≤ Real.exp 2 := by
    have := Real.exp_one_gt_d9
    rw [show (2 : ℝ) = 1 + 1 by norm_num, Real.exp_add]
    nlinarith
  calc (6 : ℝ) ^ L ≤ Real.exp 2 ^ L := pow_le_pow_left₀ (by norm_num) h6 L
    _ = Real.exp (2 * L) := by rw [← Real.exp_nat_mul]; ring_nf

/-- The bookkeeping of lines 2106-2108: `(c₀ ε^4/4) 2^{-2·6^L k₀} > exp(-exp(ε^{-C}))` when
`L ≤ K₂ ε^{-8}` and `k₀ ≤ K₁ ε^{-4}`. -/
theorem double_exp_bound {c₀ K₁ K₂ : ℝ} (hc₀ : 0 < c₀) (hK₁ : 0 < K₁) (hK₂ : 0 < K₂) :
    ∃ C : ℝ, 0 < C ∧ ∀ ε : ℝ, 0 < ε → ε < 1 / 2 → ∀ L k₀ : ℕ,
      (L : ℝ) ≤ K₂ * ε⁻¹ ^ 8 → (k₀ : ℝ) ≤ K₁ * ε⁻¹ ^ 4 →
      Real.exp (-Real.exp (ε ^ (-C))) < c₀ * ε ^ 4 / 4 * (2 : ℝ) ^ (-(2 * 6 ^ L * k₀ : ℝ)) := by
  set K₀ := 2 * K₁ + 4 / c₀
  set K₇ := K₀ + 1 + 2 * K₂
  obtain ⟨N, hN⟩ := exists_nat_gt K₇
  refine ⟨8 + N, by positivity, fun ε hε hε2 L k₀ hL hk => ?_⟩
  set X := ε⁻¹
  have hX : 2 < X := by
    simp only [X]; rw [lt_inv_comm₀ (by norm_num) hε]; linarith
  have hX1 : 1 ≤ X := by linarith
  have hX0 : 0 < X := by linarith
  set M : ℝ := 2 * 6 ^ L * k₀
  have hM0 : 0 ≤ M := by positivity
  -- the right-hand side as an exponential
  have hR : c₀ * ε ^ 4 / 4 * (2 : ℝ) ^ (-M) =
      Real.exp (-(M * Real.log 2 + Real.log (4 * X ^ 4 / c₀))) := by
    have e1 : (2 : ℝ) ^ (-M) = Real.exp (-(M * Real.log 2)) := by
      rw [Real.rpow_def_of_pos (by norm_num)]; ring_nf
    have e2 : c₀ * ε ^ 4 / 4 = Real.exp (-Real.log (4 * X ^ 4 / c₀)) := by
      rw [Real.exp_neg, Real.exp_log (by positivity)]
      have : X = ε⁻¹ := rfl
      rw [this]; field_simp
    rw [e1, e2, ← Real.exp_add]; congr 1; ring
  rw [hR, Real.exp_lt_exp, neg_lt_neg_iff]
  -- the bound `M log 2 + log(4X^4/c₀) ≤ exp(K₇ X^8)`
  have hX48 : X ^ 4 ≤ X ^ 8 := pow_le_pow_right₀ hX1 (by norm_num)
  have hX8 : 1 ≤ X ^ 8 := one_le_pow₀ hX1
  have hT : M * Real.log 2 + Real.log (4 * X ^ 4 / c₀) ≤ Real.exp (K₇ * X ^ 8) := by
    have hlog2 : Real.log 2 ≤ 1 := by
      have := Real.log_two_lt_d9; linarith
    have hl : Real.log (4 * X ^ 4 / c₀) ≤ 4 / c₀ * X ^ 4 := by
      refine (Real.log_le_sub_one_of_pos (by positivity)).trans ?_
      rw [div_mul_eq_mul_div]; linarith [(by positivity : (0 : ℝ) < 4 * X ^ 4 / c₀)]
    have hM : M ≤ 2 * K₁ * X ^ 4 * Real.exp (2 * K₂ * X ^ 8) := by
      simp only [M]
      have h6 := six_pow_le_exp L
      have h6' : Real.exp (2 * L) ≤ Real.exp (2 * K₂ * X ^ 8) := by
        rw [Real.exp_le_exp]; linarith
      have hk0 : (0 : ℝ) ≤ k₀ := by positivity
      calc 2 * 6 ^ L * (k₀ : ℝ) ≤ 2 * Real.exp (2 * K₂ * X ^ 8) * (K₁ * X ^ 4) := by
            gcongr; exact h6.trans h6'
        _ = 2 * K₁ * X ^ 4 * Real.exp (2 * K₂ * X ^ 8) := by ring
    have hE1 : 1 ≤ Real.exp (2 * K₂ * X ^ 8) := Real.one_le_exp (by positivity)
    have hsum : M * Real.log 2 + Real.log (4 * X ^ 4 / c₀) ≤
        K₀ * X ^ 4 * Real.exp (2 * K₂ * X ^ 8) := by
      have := mul_le_mul_of_nonneg_left hlog2 hM0
      have h4 : 4 / c₀ * X ^ 4 ≤ 4 / c₀ * X ^ 4 * Real.exp (2 * K₂ * X ^ 8) :=
        le_mul_of_one_le_right (by positivity) hE1
      simp only [K₀]; nlinarith
    refine hsum.trans ?_
    have hX4e : X ^ 4 ≤ Real.exp (X ^ 8) := hX48.trans (le_exp_self _)
    have hK0e : K₀ ≤ Real.exp K₀ := le_exp_self _
    calc K₀ * X ^ 4 * Real.exp (2 * K₂ * X ^ 8)
        ≤ Real.exp K₀ * Real.exp (X ^ 8) * Real.exp (2 * K₂ * X ^ 8) := by gcongr
      _ = Real.exp (K₀ + (1 + 2 * K₂) * X ^ 8) := by rw [← Real.exp_add, ← Real.exp_add]; ring_nf
      _ ≤ Real.exp (K₇ * X ^ 8) := by
          rw [Real.exp_le_exp]; simp only [K₇]
          have : K₀ ≤ K₀ * X ^ 8 := le_mul_of_one_le_right (by positivity) hX8
          nlinarith
  refine lt_of_le_of_lt hT ?_
  rw [Real.exp_lt_exp]
  -- `K₇ X^8 < X^{8+N} = ε^{-(8+N)}`
  have hXC : ε ^ (-(8 + N : ℝ)) = X ^ 8 * X ^ N := by
    simp only [X]
    rw [Real.rpow_neg hε.le, ← Real.inv_rpow hε.le, Real.rpow_add (by positivity),
      Real.rpow_natCast, show ((8 : ℝ)) = ((8 : ℕ) : ℝ) by norm_num, Real.rpow_natCast]
  rw [hXC]
  have hN2 : (N : ℝ) < 2 ^ N := by exact_mod_cast Nat.lt_two_pow_self
  have hXN : (2 : ℝ) ^ N ≤ X ^ N := pow_le_pow_left₀ (by norm_num) hX.le N
  have hK7N : K₇ < X ^ N := by linarith
  calc K₇ * X ^ 8 < X ^ N * X ^ 8 := mul_lt_mul_of_pos_right hK7N (by positivity)
    _ = X ^ 8 * X ^ N := mul_comm _ _

instance : IsFiniteMeasure (volume.restrict sq01) :=
  ⟨by rw [Measure.restrict_apply_univ, volume_sq01]; exact ENNReal.one_lt_top⟩

theorem patI_eq {f : ℝ × ℝ → ℝ} (hf : SqFun f) :
    patI f = ∫ t in Icc (0 : ℝ) 1, ∫ z in sq01, f z * f (z.1 + t, z.2) * f (z.1, z.2 + t ^ 2) := by
  have hF : Measurable fun q : (ℝ × ℝ) × ℝ => f q.1 * f (q.1.1 + q.2, q.1.2) * f (q.1.1, q.1.2 +
      q.2 ^ 2) :=
    ((hf.meas.comp measurable_fst).mul (hf.meas.comp (by fun_prop))).mul (hf.meas.comp (by
        fun_prop))
  have hFb : ∀ q : (ℝ × ℝ) × ℝ, |f q.1 * f (q.1.1 + q.2, q.1.2) * f (q.1.1, q.1.2 + q.2 ^ 2)| ≤ 1
      := by
    intro q; rw [abs_mul, abs_mul]
    have := hf.abs_le
    calc |f q.1| * |f (q.1.1 + q.2, q.1.2)| * |f (q.1.1, q.1.2 + q.2 ^ 2)| ≤ 1 * 1 * 1 := by
          gcongr <;> exact this _
      _ = 1 := by norm_num
  unfold patI
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero (s := sq01) fun z hz => by
    rw [hf.supp z hz, zero_mul]]
  simp_rw [← integral_const_mul, ← mul_assoc]
  exact integral_integral_swap (f := fun z t => f z * f (z.1 + t, z.2) * f (z.1, z.2 + t ^ 2))
    (integrable_of_abs_le (μ := (volume.restrict sq01).prod (volume.restrict (Icc (0 : ℝ) 1)))
      hF 1 hFb)

/-- **`eqn:patternpenult`** (CDR, Section 5.1, lines 2027-2031): there is `C > 0` such that for
every `ε ∈ (0, 1/2)` and every measurable `f` on `[0,1]^2` with `0 ≤ f ≤ 1` and `∫ f ≥ ε`,
`∫_{[0,1]^3} f(x,y) f(x+t,y) f(x,y+t^2) dx dy dt > exp(-exp(ε^{-C}))`. Functions on `[0,1]^2`
are functions on `ℝ^2` vanishing off `[0,1]^2`. -/
theorem eqn_patternpenult : ∃ C : ℝ, 0 < C ∧ ∀ ε : ℝ, 0 < ε → ε < 1 / 2 →
    ∀ f : ℝ × ℝ → ℝ, Measurable f → (∀ z, 0 ≤ f z) → (∀ z, f z ≤ 1) →
    (∀ z ∉ Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1, f z = 0) →
    ε ≤ ∫ z in Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1, f z →
    Real.exp (-Real.exp (ε ^ (-C))) <
      ∫ t in Icc (0 : ℝ) 1, ∫ z in Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1,
        f z * f (z.1 + t, z.2) * f (z.1, z.2 + t ^ 2) := by
  obtain ⟨c₀, K₁, K₂, hc₀, hK₁, hK₂, hit⟩ := iteration
  obtain ⟨C, hC, hbd⟩ := double_exp_bound hc₀ hK₁ hK₂
  refine ⟨C, hC, fun ε hε hε2 f hm h0 h1 hs hint => ?_⟩
  have hf : SqFun f := ⟨hm, h0, h1, hs⟩
  have hint' : ε ≤ ∫ z, f z := by
    rwa [← setIntegral_eq_integral_of_forall_compl_eq_zero (s := sq01) fun z hz => hs z hz]
  obtain ⟨L, k₀, hL, hk, hP⟩ := hit ε hε (by linarith) f hf hint'
  rw [← patI_eq hf]
  exact lt_of_lt_of_le (hbd ε hε hε2 L k₀ hL hk) hP

theorem exp_neg_exp_half {u u' : ℝ} (hu : 1 ≤ u) (hu' : 2 * u ≤ u') :
    2 * Real.exp (-Real.exp u') ≤ Real.exp (-Real.exp u) := by
  have h1 : Real.exp u + 1 ≤ Real.exp u' := by
    have he : Real.exp (2 * u) = Real.exp u * Real.exp u := by rw [two_mul, Real.exp_add]
    have hge : 2 ≤ Real.exp u := by linarith [Real.add_one_le_exp u]
    calc Real.exp u + 1 ≤ Real.exp u * Real.exp u := by nlinarith
      _ = Real.exp (2 * u) := he.symm
      _ ≤ Real.exp u' := Real.exp_le_exp.2 hu'
  have h3 : Real.exp (-Real.exp u') ≤ Real.exp (-Real.exp u) / Real.exp 1 := by
    rw [← Real.exp_sub]; exact Real.exp_le_exp.2 (by linarith)
  have he : (2 : ℝ) < Real.exp 1 := by have := Real.exp_one_gt_d9; linarith
  have hpos := Real.exp_pos (-Real.exp u)
  calc 2 * Real.exp (-Real.exp u') ≤ 2 * (Real.exp (-Real.exp u) / Real.exp 1) := by linarith
    _ ≤ Real.exp (-Real.exp u) := by
        rw [mul_div_assoc', div_le_iff₀ (Real.exp_pos 1)]; nlinarith

/-- **Theorem 4** (`thm:patterns`, CDR lines 311-318). There is `C > 0` such that for every
`ε ∈ (0, 1/2)` and every measurable `E ⊆ [0,1]^2` with `|E| ≥ ε` there are
`(x,y), (x+t,y), (x,y+t^2) ∈ E` with `t > exp(-exp(ε^{-C}))`. -/
theorem thm_patterns : ∃ C : ℝ, 0 < C ∧ ∀ ε : ℝ, 0 < ε → ε < 1 / 2 →
    ∀ E : Set (ℝ × ℝ), MeasurableSet E → E ⊆ Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1 →
    ENNReal.ofReal ε ≤ volume E →
    ∃ x y t : ℝ, (x, y) ∈ E ∧ (x + t, y) ∈ E ∧ (x, y + t ^ 2) ∈ E ∧
      Real.exp (-Real.exp (ε ^ (-C))) < t := by
  obtain ⟨C, hC, hpen⟩ := eqn_patternpenult
  refine ⟨C + 1, by linarith, fun ε hε hε2 E hE hEs hEv => ?_⟩
  set f : ℝ × ℝ → ℝ := E.indicator 1
  have hf : SqFun f := by
    refine ⟨measurable_one.indicator hE, fun z => ?_, fun z => ?_, fun z hz => ?_⟩
    · by_cases h : z ∈ E <;> simp [f, h]
    · by_cases h : z ∈ E <;> simp [f, h]
    · simp only [f]; rw [indicator_of_notMem (fun h => hz (hEs h))]
  have hvol : volume E ≠ ⊤ := ne_top_of_le_ne_top (by rw [volume_sq01]; exact ENNReal.one_ne_top)
    (measure_mono hEs)
  have hint : ε ≤ ∫ z in Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1, f z := by
    rw [setIntegral_eq_integral_of_forall_compl_eq_zero fun z hz => hf.supp z hz]
    simp only [f]
    rw [integral_indicator_one hE]
    exact (ENNReal.ofReal_le_iff_le_toReal hvol).1 hEv
  have hJ := hpen ε hε hε2 f hf.meas hf.nonneg hf.le_one hf.supp hint
  set δ := Real.exp (-Real.exp (ε ^ (-C)))
  set δ' := Real.exp (-Real.exp (ε ^ (-(C + 1))))
  have hδ' : 2 * δ' ≤ δ := by
    refine exp_neg_exp_half ?_ ?_
    · exact Real.one_le_rpow_of_pos_of_le_one_of_nonpos hε (by linarith) (by linarith)
    · rw [neg_add, Real.rpow_add hε, Real.rpow_neg_one]
      have : 2 ≤ ε⁻¹ := by rw [le_inv_comm₀ (by norm_num) hε]; linarith
      have : 0 ≤ ε ^ (-C) := by positivity
      nlinarith
  by_contra hno
  push Not at hno
  -- the `t`-integrand vanishes for `t > δ'`
  set G : ℝ → ℝ := fun t => ∫ z in Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1,
    f z * f (z.1 + t, z.2) * f (z.1, z.2 + t ^ 2)
  have hG0 : ∀ t, δ' < t → G t = 0 := by
    intro t ht
    refine setIntegral_eq_zero_of_forall_eq_zero fun z _ => ?_
    by_contra hne
    have h1 : z ∈ E := by by_contra h; exact hne (by simp [f, h])
    have h2 : (z.1 + t, z.2) ∈ E := by by_contra h; exact hne (by simp [f, h])
    have h3 : (z.1, z.2 + t ^ 2) ∈ E := by by_contra h; exact hne (by simp [f, h])
    exact absurd (hno z.1 z.2 t h1 h2 h3) (not_le.2 ht)
  have hG1 : ∀ t, G t ≤ 1 := by
    intro t
    calc G t ≤ ∫ z in Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1, (1 : ℝ) := by
          refine setIntegral_mono_on ?_
            (continuousOn_const.integrableOn_compact (isCompact_Icc.prod isCompact_Icc))
            (measurableSet_Icc.prod measurableSet_Icc) fun z _ => ?_
          · exact Measure.integrableOn_of_bounded (M := 1) (by rw [volume_sq01]; simp)
              (((hf.meas.mul (hf.meas.comp (by fun_prop))).mul
                (hf.meas.comp (by fun_prop)))).aestronglyMeasurable
              (Eventually.of_forall fun z => by
                rw [Real.norm_eq_abs, abs_mul, abs_mul]
                have := hf.abs_le
                calc |f z| * |f (z.1 + t, z.2)| * |f (z.1, z.2 + t ^ 2)| ≤ 1 * 1 * 1 := by
                      gcongr <;> exact this _
                  _ = 1 := by norm_num)
          · calc f z * f (z.1 + t, z.2) * f (z.1, z.2 + t ^ 2) ≤ 1 * 1 * 1 :=
                  mul_le_mul (mul_le_mul (hf.le_one _) (hf.le_one _) (hf.nonneg _) zero_le_one)
                    (hf.le_one _) (hf.nonneg _) (by norm_num)
              _ = 1 := by norm_num
      _ = 1 := by
          rw [setIntegral_const, smul_eq_mul, mul_one, Measure.real, volume_sq01,
            ENNReal.toReal_one]
  have hGle : ∀ t ∈ Icc (0 : ℝ) 1, G t ≤ (Icc (0 : ℝ) δ').indicator 1 t := by
    intro t ht
    by_cases h : t ≤ δ'
    · rw [indicator_of_mem (show t ∈ Icc (0 : ℝ) δ' from ⟨ht.1, h⟩)]; exact hG1 t
    · rw [hG0 t (not_le.1 h), indicator_of_notMem fun hm => h hm.2]
  have hδ'pos : 0 < δ' := Real.exp_pos _
  have hupper : ∫ t in Icc (0 : ℝ) 1, G t ≤ δ' := by
    calc ∫ t in Icc (0 : ℝ) 1, G t ≤ ∫ t in Icc (0 : ℝ) 1, (Icc (0 : ℝ) δ').indicator 1 t := by
          refine setIntegral_mono_on ?_ ?_ measurableSet_Icc hGle
          · have hGm : Measurable G := (StronglyMeasurable.integral_prod_right'
              (ν := volume.restrict sq01)
              (f := fun q : ℝ × (ℝ × ℝ) => f q.2 * f (q.2.1 + q.1, q.2.2) * f (q.2.1, q.2.2 + q.1
                  ^ 2))
              (((hf.meas.comp measurable_snd).mul (hf.meas.comp (by fun_prop))).mul
                (hf.meas.comp (by fun_prop))).stronglyMeasurable).measurable
            have hGn : ∀ t, 0 ≤ G t := fun t => setIntegral_nonneg
              (measurableSet_Icc.prod measurableSet_Icc) fun z _ =>
                mul_nonneg (mul_nonneg (hf.nonneg _) (hf.nonneg _)) (hf.nonneg _)
            exact Measure.integrableOn_of_bounded (M := 1) (by simp) hGm.aestronglyMeasurable
              (Eventually.of_forall fun t => by
                rw [Real.norm_eq_abs, abs_of_nonneg (hGn t)]; exact hG1 t)
          · exact ((continuous_const.integrableOn_Icc (μ := volume)).integrable_indicator
              measurableSet_Icc).integrableOn
      _ ≤ ∫ t, (Icc (0 : ℝ) δ').indicator (1 : ℝ → ℝ) t := by
          refine setIntegral_le_integral ((continuous_const.integrableOn_Icc
            (μ := volume)).integrable_indicator measurableSet_Icc) ?_
          exact Eventually.of_forall fun t => indicator_nonneg (fun _ _ => zero_le_one) t
      _ = δ' := by
          rw [integral_indicator_one measurableSet_Icc, Measure.real, Real.volume_Icc,
            ENNReal.toReal_ofReal (by linarith), sub_zero]
  have : δ < δ := lt_of_lt_of_le hJ (hupper.trans (by linarith))
  exact lt_irrefl _ this

end

