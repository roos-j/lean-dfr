  have h2 : (0 : ℝ) < 2 ^ k := zpow_pos (by norm_num) k
  have hlt : s * 2 ^ k < ∫ t in Set.Icc (σ * 2 ^ k) ((σ + 1) * 2 ^ k), ‖g (x + t)‖ := by
    have h' : s < (2 : ℝ) ^ (-k) * ∫ t in Set.Icc (σ * 2 ^ k) ((σ + 1) * 2 ^ k), ‖g (x + t)‖ := h
    rwa [zpow_neg, inv_mul_eq_div, lt_div_iff₀ h2] at h'
  have hIeq : ∫ t in Set.Icc (σ * 2 ^ k) ((σ + 1) * 2 ^ k), ‖g (x + t)‖ =
      (∫⁻ t in Set.Icc (σ * 2 ^ k) ((σ + 1) * 2 ^ k), ENNReal.ofReal ‖g (x + t)‖).toReal :=
    integral_eq_lintegral_of_nonneg_ae (ae_of_all _ fun _ => norm_nonneg _)
      ((hg.comp (measurable_const_add x)).norm.aestronglyMeasurable)
  have htrans : ∫⁻ t in Set.Icc (σ * 2 ^ k) ((σ + 1) * 2 ^ k), ENNReal.ofReal ‖g (x + t)‖ =
      ∫⁻ y in Metric.ball (shiftedCenter σ (x, k)) (shiftedRadius (x, k)),
        ENNReal.ofReal ‖g y‖ := by
    have hmp := (measurePreserving_add_left volume x).setLIntegral_comp_preimage_emb
      (measurableEmbedding_addLeft x) (fun y => ENNReal.ofReal ‖g y‖)
      (Set.Ioo (x + σ * 2 ^ k) (x + (σ + 1) * 2 ^ k))
    rw [preimage_const_add_Ioo] at hmp
    simp only [add_sub_cancel_left] at hmp
    rw [shiftedBall_eq]
    dsimp only
    rw [← hmp]
    exact (setLIntegral_congr Ioo_ae_eq_Icc).symm
  calc ENNReal.ofReal (s * 2 ^ k)
      < ENNReal.ofReal (∫ t in Set.Icc (σ * 2 ^ k) ((σ + 1) * 2 ^ k), ‖g (x + t)‖) :=
        (ENNReal.ofReal_lt_ofReal_iff ((mul_pos hs h2).trans hlt)).2 hlt
    _ ≤ _ := by rw [hIeq]; exact ENNReal.ofReal_toReal_le
    _ = _ := htrans

/-- The number `⌈log₂ (8|σ| + 4)⌉` of dyadic scales on which the shift is not negligible. -/
def shiftedLogCount (σ : ℝ) : ℕ := ⌈Real.logb 2 (8 * |σ| + 4)⌉₊

/-- The defining property of `shiftedLogCount`. -/
theorem le_two_pow_shiftedLogCount (σ : ℝ) :
    8 * |σ| + 4 ≤ (2 : ℝ) ^ shiftedLogCount σ := by
  have hy : 0 < 8 * |σ| + 4 := by positivity
  calc 8 * |σ| + 4 = (2 : ℝ) ^ Real.logb 2 (8 * |σ| + 4) :=
        (Real.rpow_logb (by norm_num) (by norm_num) hy).symm
    _ ≤ (2 : ℝ) ^ (shiftedLogCount σ : ℝ) :=
        Real.rpow_le_rpow_of_exponent_le (by norm_num) (Nat.le_ceil _)
    _ = 2 ^ shiftedLogCount σ := Real.rpow_natCast _ _

/-- The counting constant of the covering argument is `O(log (2 + |σ|))`. -/
theorem shiftedLogCount_bound (σ : ℝ) :
    5 + 4 * (shiftedLogCount σ : ℝ) ≤ 50 * Real.log (2 + |σ|) := by
  have hL2 := Real.log_two_gt_d9
  have hL2pos : 0 < Real.log 2 := Real.log_pos one_lt_two
  have hσ := abs_nonneg σ
  have hΛ : Real.log 2 ≤ Real.log (2 + |σ|) := Real.log_le_log (by norm_num) (by linarith)
  have hy : 0 < 8 * |σ| + 4 := by positivity
  have hlogy : Real.log (8 * |σ| + 4) ≤ 3 * Real.log 2 + Real.log (2 + |σ|) := by
    have h8 : Real.log (8 * (2 + |σ|)) = 3 * Real.log 2 + Real.log (2 + |σ|) := by
      rw [Real.log_mul (by norm_num) (by positivity), show (8 : ℝ) = 2 ^ 3 by norm_num,
        Real.log_pow]
      push_cast
      ring
    rw [← h8]
    exact Real.log_le_log hy (by linarith)
  have hlogb_nonneg : 0 ≤ Real.logb 2 (8 * |σ| + 4) :=
    Real.logb_nonneg (by norm_num) (by linarith)
  have hN := Nat.ceil_lt_add_one hlogb_nonneg
  have hlogb : Real.logb 2 (8 * |σ| + 4) * Real.log 2 = Real.log (8 * |σ| + 4) := by
    rw [Real.logb, div_mul_cancel₀ _ hL2pos.ne']
  have hNL : (shiftedLogCount σ : ℝ) * Real.log 2 <
      (Real.logb 2 (8 * |σ| + 4) + 1) * Real.log 2 :=
    mul_lt_mul_of_pos_right hN hL2pos
  have hmain : (5 + 4 * (shiftedLogCount σ : ℝ)) * Real.log 2 <
      (50 * Real.log (2 + |σ|)) * Real.log 2 := by
    nlinarith
  exact (lt_of_mul_lt_mul_right hmain hL2pos.le).le

/-- The geometric heart of the covering argument: the set of base points `x` whose shifted
interval at some scale lies in the four-fold enlargement of the interval attached to `b` has
measure at most `(5 + 4 N) 2^{k_b}`, where `N = shiftedLogCount σ`. -/
theorem volume_shiftedCoverSet_le (σ : ℝ) (b : ℝ × ℤ) :
    volume {x | ∃ k : ℤ, Metric.ball (shiftedCenter σ (x, k)) (shiftedRadius (x, k)) ⊆
        Metric.ball (shiftedCenter σ b) (4 * shiftedRadius b)} ≤
      ENNReal.ofReal ((5 + 4 * (shiftedLogCount σ : ℝ)) * 2 ^ b.2) := by
  have hm : (0 : ℝ) < 2 ^ b.2 := zpow_pos (by norm_num) _
  have hsub : {x | ∃ k : ℤ, Metric.ball (shiftedCenter σ (x, k)) (shiftedRadius (x, k)) ⊆
        Metric.ball (shiftedCenter σ b) (4 * shiftedRadius b)} ⊆
      Set.Icc (shiftedCenter σ b - 5 * (2 ^ b.2 / 2)) (shiftedCenter σ b + 5 * (2 ^ b.2 / 2)) ∪
        ⋃ j ∈ Finset.range (shiftedLogCount σ),
          Set.Ioo (shiftedCenter σ b - 2 * 2 ^ b.2 - (σ + 1 / 2) * 2 ^ (b.2 + 2 - (j : ℤ)))
            (shiftedCenter σ b + 2 * 2 ^ b.2 - (σ + 1 / 2) * 2 ^ (b.2 + 2 - (j : ℤ))) := by
    rintro x ⟨k, hk⟩
    have hk2 : (0 : ℝ) < 2 ^ k := zpow_pos (by norm_num) k
    rw [shiftedBall_eq, Real.ball_eq_Ioo, Set.Ioo_subset_Ioo_iff (by simp; linarith)] at hk
    obtain ⟨h1, h2⟩ := hk
    simp only [shiftedRadius] at h1 h2
    simp only [shiftedCenter] at h1 h2 ⊢
    have hkm' : (2 : ℝ) ^ k ≤ 2 ^ (b.2 + 2) := by
      rw [zpow_add₀ two_ne_zero]
      norm_num
      linarith
    have hkm : k ≤ b.2 + 2 := (zpow_le_zpow_iff_right₀ one_lt_two).1 hkm'
    by_cases hcase : |σ + 1 / 2| * 2 ^ k ≤ 2 ^ b.2 / 2
    · left
      have habs := abs_le.1 (by rwa [abs_mul, abs_of_pos hk2] :
        |(σ + 1 / 2) * 2 ^ k| ≤ 2 ^ b.2 / 2)
      constructor <;> nlinarith [habs.1, habs.2]
    · right
      push Not at hcase
      set j := (b.2 + 2 - k).toNat with hjdef
      have hj : (j : ℤ) = b.2 + 2 - k := Int.toNat_of_nonneg (by omega)
      have hkj : b.2 + 2 - (j : ℤ) = k := by omega
      simp only [mem_iUnion, Finset.mem_range]
      refine ⟨j, ?_, ?_⟩
      · have h4 : (2 : ℝ) ^ (b.2 + 2) = 2 ^ k * 2 ^ j := by
          rw [← zpow_natCast, ← zpow_add₀ two_ne_zero]
          congr 1
          omega
        have h5 : (2 : ℝ) ^ (b.2 + 2) = 2 ^ b.2 * 4 := by
          rw [zpow_add₀ two_ne_zero]
          norm_num
        have hβ : |σ + 1 / 2| ≤ |σ| + 1 / 2 :=
          (abs_add_le _ _).trans (by norm_num)
        have hpow := le_two_pow_shiftedLogCount σ
        have hlt : (2 : ℝ) ^ j < 2 ^ shiftedLogCount σ := by
          have h6 : 2 ^ k * 2 ^ j < 2 ^ k * (8 * |σ + 1 / 2|) := by nlinarith
          have := lt_of_mul_lt_mul_left h6 hk2.le
          linarith
        exact (pow_lt_pow_iff_right₀ one_lt_two).1 hlt
      · rw [hkj]
        constructor <;> nlinarith
  calc _ ≤ _ := measure_mono hsub
    _ ≤ _ := measure_union_le _ _
    _ ≤ _ := add_le_add le_rfl (measure_biUnion_finset_le _ _)
    _ = ENNReal.ofReal (5 * 2 ^ b.2) + ∑ _j ∈ Finset.range (shiftedLogCount σ),
          ENNReal.ofReal (4 * 2 ^ b.2) := by
        rw [Real.volume_Icc]
        congr 1
        · congr 1
          ring
        · refine Finset.sum_congr rfl fun j _ => ?_
          rw [Real.volume_Ioo]
          congr 1
          ring
    _ = _ := by
        rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul, ← ENNReal.ofReal_natCast,
          ← ENNReal.ofReal_mul (Nat.cast_nonneg _),
          ← ENNReal.ofReal_add (by positivity) (by positivity)]
        congr 1
        ring

/-- The absolute constant in the weak type `(1,1)` bound for the shifted maximal function. -/
def shiftedMaximalWeakConst : ℝ := 50

/-- **Weak type `(1,1)` bound with logarithmic constant** for the shifted maximal function:
`s |{𝓜_σ g > s}| ≤ C log (2 + |σ|) ‖g‖₁` with the absolute constant
`C = shiftedMaximalWeakConst`. -/
theorem shiftedMaximal_weak_one (σ : ℝ) {g : ℝ → ℂ} (hg : Measurable g) {s : ℝ}
    (hs : 0 < s) :
    ENNReal.ofReal s * volume {x | s < shiftedMaximal σ g x} ≤
      ENNReal.ofReal (shiftedMaximalWeakConst * Real.log (2 + |σ|)) *
        ∫⁻ x, ENNReal.ofReal ‖g x‖ := by
  set L := ∫⁻ x, ENNReal.ofReal ‖g x‖ with hLdef
  have hΛ : 0 < Real.log (2 + |σ|) := Real.log_pos (by linarith [abs_nonneg σ])
  by_cases hL : L = ⊤
  · rw [hL, ENNReal.mul_top (ENNReal.ofReal_pos.2 (by
      simp only [shiftedMaximalWeakConst]; positivity)).ne']
    exact le_top
  let t : Set (ℝ × ℤ) := {a | ENNReal.ofReal (s * 2 ^ a.2) <
    ∫⁻ y in Metric.ball (shiftedCenter σ a) (shiftedRadius a), ENNReal.ofReal ‖g y‖}
  have hr : ∀ a ∈ t, shiftedRadius a ≤ L.toReal / s := by
    intro a ha
    have h1 : ENNReal.ofReal (s * 2 ^ a.2) < L :=
      lt_of_lt_of_le ha (setLIntegral_le_lintegral _ _)
    have h2 := (ENNReal.ofReal_lt_iff_lt_toReal (by positivity) hL).1 h1
    have hpos : (0 : ℝ) < 2 ^ a.2 := zpow_pos (by norm_num) _
    rw [le_div_iff₀ hs]
    simp only [shiftedRadius]
    nlinarith
  obtain ⟨u, hut, hdisj, hcover⟩ :=
    Vitali.exists_disjoint_subfamily_covering_enlargement_ball t (shiftedCenter σ)
      shiftedRadius (L.toReal / s) hr 4 (by norm_num)
  have hucount : u.Countable :=
    hdisj.countable_of_isOpen (fun _ _ => Metric.isOpen_ball)
      (fun a _ => Metric.nonempty_ball.mpr (by simp only [shiftedRadius]; positivity))
  let F : ℝ × ℤ → Set ℝ := fun b => {x | ∃ k : ℤ,
    Metric.ball (shiftedCenter σ (x, k)) (shiftedRadius (x, k)) ⊆
      Metric.ball (shiftedCenter σ b) (4 * shiftedRadius b)}
  have hE : {x | s < shiftedMaximal σ g x} ⊆ ⋃ b ∈ u, F b := by
    intro x hx
    obtain ⟨k, hk⟩ := exists_lt_of_lt_ciSup (show s < ⨆ k, shiftedAverage σ g x k from hx)
    have ha : ((x, k) : ℝ × ℤ) ∈ t := shiftedAverage_lt_lintegral σ hg hs hk
    obtain ⟨b, hb, hsub⟩ := hcover _ ha
    exact mem_iUnion₂.2 ⟨b, hb, k, hsub⟩
  have hK : (0 : ℝ) ≤ 5 + 4 * (shiftedLogCount σ : ℝ) := by positivity
  have hF : ∀ b : ℝ × ℤ, volume (F b) ≤ ENNReal.ofReal (5 + 4 * (shiftedLogCount σ : ℝ)) *
      volume (Metric.ball (shiftedCenter σ b) (shiftedRadius b)) := by
    intro b
    rw [volume_shiftedBall, ← ENNReal.ofReal_mul hK]
    exact volume_shiftedCoverSet_le σ b
  have hsel : ∀ b ∈ u, ENNReal.ofReal s *
      volume (Metric.ball (shiftedCenter σ b) (shiftedRadius b)) ≤
      ∫⁻ y in Metric.ball (shiftedCenter σ b) (shiftedRadius b), ENNReal.ofReal ‖g y‖ := by
    intro b hb
    rw [volume_shiftedBall, ← ENNReal.ofReal_mul hs.le]
    exact (hut hb).le
  calc ENNReal.ofReal s * volume {x | s < shiftedMaximal σ g x}
      ≤ ENNReal.ofReal s * ∑' b : u, volume (F b) := by
        gcongr
        exact (measure_mono hE).trans (measure_biUnion_le _ hucount _)
    _ ≤ ENNReal.ofReal s * ∑' b : u, ENNReal.ofReal (5 + 4 * (shiftedLogCount σ : ℝ)) *
          volume (Metric.ball (shiftedCenter σ b) (shiftedRadius b)) := by
        gcongr with b
        exact hF b
    _ = ENNReal.ofReal (5 + 4 * (shiftedLogCount σ : ℝ)) * ∑' b : u, ENNReal.ofReal s *
          volume (Metric.ball (shiftedCenter σ b) (shiftedRadius b)) := by
        rw [ENNReal.tsum_mul_left, ENNReal.tsum_mul_left]
        ring
    _ ≤ ENNReal.ofReal (5 + 4 * (shiftedLogCount σ : ℝ)) * ∑' b : u,
          ∫⁻ y in Metric.ball (shiftedCenter σ b) (shiftedRadius b), ENNReal.ofReal ‖g y‖ := by
        gcongr with b
        exact hsel b b.2
    _ = ENNReal.ofReal (5 + 4 * (shiftedLogCount σ : ℝ)) *
          ∫⁻ y in ⋃ b ∈ u, Metric.ball (shiftedCenter σ b) (shiftedRadius b),
            ENNReal.ofReal ‖g y‖ := by
        rw [lintegral_biUnion hucount (fun _ _ => measurableSet_ball) hdisj]
    _ ≤ ENNReal.ofReal (5 + 4 * (shiftedLogCount σ : ℝ)) * L := by
        gcongr
        exact setLIntegral_le_lintegral _ _
    _ ≤ _ := by
        gcongr
        exact shiftedLogCount_bound σ

/-- Existential form of the weak type `(1,1)` bound: there is an absolute constant `C` with
`s |{𝓜_σ g > s}| ≤ C log (2 + |σ|) ‖g‖₁` for all `σ`, all measurable `g` and all `s > 0`. -/
theorem exists_shiftedMaximal_weak_one :
    ∃ C : ℝ, 0 < C ∧ ∀ (σ : ℝ) (g : ℝ → ℂ), Measurable g → ∀ s : ℝ, 0 < s →
      ENNReal.ofReal s * volume {x | s < shiftedMaximal σ g x} ≤
        ENNReal.ofReal (C * Real.log (2 + |σ|)) * ∫⁻ x, ENNReal.ofReal ‖g x‖ :=
  ⟨shiftedMaximalWeakConst, by norm_num [shiftedMaximalWeakConst],
    fun σ _ hg _ hs => shiftedMaximal_weak_one σ hg hs⟩

/-- The constant `C_p = p · 2 C (p - 1)⁻¹ 2^{p-1}` in the `L^p` bound, where
`C = shiftedMaximalWeakConst` is the weak type `(1,1)` constant. -/
def shiftedMaximalLpConst (p : ℝ) : ℝ :=
  p * (2 * shiftedMaximalWeakConst * (p - 1)⁻¹ * 2 ^ (p - 1))

/-- The constant `shiftedMaximalLpConst p` is positive for `p > 1`. -/
theorem shiftedMaximalLpConst_pos {p : ℝ} (hp : 1 < p) : 0 < shiftedMaximalLpConst p := by
  have hp1 : 0 < (p - 1)⁻¹ := inv_pos.2 (sub_pos.2 hp)
  unfold shiftedMaximalLpConst shiftedMaximalWeakConst
  have : (0 : ℝ) < 2 ^ (p - 1) := Real.rpow_pos_of_pos (by norm_num) _
  have : 0 < p := by linarith
  positivity

/-- **`L^p` bound with logarithmic constant** for the shifted maximal function, in integral
form: `∫ (𝓜_σ g)^p ≤ C_p log (2 + |σ|) ∫ |g|^p` for bounded measurable `g` and `p > 1`. -/
theorem shiftedMaximal_lintegral_rpow_le (σ : ℝ) {p : ℝ} (hp : 1 < p) {g : ℝ → ℂ}
    (hg : Measurable g) (hbdd : ∃ a : ℝ, 0 ≤ a ∧ ∀ x, ‖g x‖ ≤ a) :
    ∫⁻ x, ENNReal.ofReal (shiftedMaximal σ g x ^ p) ≤
      ENNReal.ofReal (shiftedMaximalLpConst p * Real.log (2 + |σ|)) *
        ∫⁻ x, ENNReal.ofReal ‖g x‖ ^ p := by
  have hΛ : 0 < Real.log (2 + |σ|) := Real.log_pos (by linarith [abs_nonneg σ])
  have h := Spherical.Auxiliary.marcinkiewicz_weak_one_top (μ := volume) (shiftedMaximal σ)
    (shiftedMaximal_nonneg σ)
    (fun _ _ hg hh hga hhb x =>
      shiftedMaximal_add_le σ hg hh hga.choose_spec.2 hhb.choose_spec.2 x)
    (ENNReal.ofReal (shiftedMaximalWeakConst * Real.log (2 + |σ|)))
    (fun _ hg _ _ hs => shiftedMaximal_weak_one σ hg hs)
    (fun _ _ _ hga x => (shiftedMaximal_le_of_bound σ hga x).2)
    hp g hg hbdd (measurable_shiftedMaximal σ hg hbdd.choose_spec.2).aemeasurable
  refine h.trans (le_of_eq ?_)
  set c := shiftedMaximalWeakConst * Real.log (2 + |σ|) with hc
  have hc0 : 0 ≤ c := by rw [hc, shiftedMaximalWeakConst]; positivity
  have hA : (0 : ℝ) ≤ 2 * c := by positivity
  have hB : (0 : ℝ) ≤ 2 * c * (p - 1)⁻¹ :=
    mul_nonneg hA (inv_nonneg.2 (sub_nonneg.2 hp.le))
  have hC : (0 : ℝ) ≤ p := by linarith
  have hcoef : ENNReal.ofReal p * (2 * ENNReal.ofReal c * (ENNReal.ofReal (p - 1))⁻¹ *
      ENNReal.ofReal 2 ^ (p - 1)) =
      ENNReal.ofReal (shiftedMaximalLpConst p * Real.log (2 + |σ|)) := by
    rw [← ENNReal.ofReal_inv_of_pos (sub_pos.2 hp),
      ENNReal.ofReal_rpow_of_nonneg (by norm_num) (by linarith),
      show (2 : ENNReal) = ENNReal.ofReal 2 by simp,
      ← ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2), ← ENNReal.ofReal_mul hA,
      ← ENNReal.ofReal_mul hB, ← ENNReal.ofReal_mul hC]
    congr 1
    rw [hc, shiftedMaximalLpConst]
    ring
  rw [← hcoef]
  ring

/-- **`L^p` bound with logarithmic constant** for the shifted maximal function, in `eLpNorm`
form: `‖𝓜_σ g‖_p ≤ (C_p log (2 + |σ|))^{1/p} ‖g‖_p` for bounded measurable `g` and `p > 1`. -/
theorem shiftedMaximal_eLpNorm_le (σ : ℝ) {p : ℝ} (hp : 1 < p) {g : ℝ → ℂ}
    (hg : Measurable g) (hbdd : ∃ a : ℝ, 0 ≤ a ∧ ∀ x, ‖g x‖ ≤ a) :
    eLpNorm (shiftedMaximal σ g) (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal ((shiftedMaximalLpConst p * Real.log (2 + |σ|)) ^ (1 / p)) *
        eLpNorm g (ENNReal.ofReal p) volume := by
  have hΛ : 0 < Real.log (2 + |σ|) := Real.log_pos (by linarith [abs_nonneg σ])
  have hp0 : ENNReal.ofReal p ≠ 0 := by simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]; linarith
  have hK : 0 ≤ shiftedMaximalLpConst p * Real.log (2 + |σ|) :=
    (mul_pos (shiftedMaximalLpConst_pos hp) hΛ).le
  have hq : (0 : ℝ) ≤ 1 / p := div_nonneg zero_le_one (by linarith)
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 ENNReal.ofReal_ne_top,
    eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 ENNReal.ofReal_ne_top,
    ENNReal.toReal_ofReal (by linarith), ← ENNReal.ofReal_rpow_of_nonneg hK hq,
    ← ENNReal.mul_rpow_of_nonneg _ _ hq]
  refine ENNReal.rpow_le_rpow ?_ hq
  have h1 : (fun x => ‖shiftedMaximal σ g x‖ₑ ^ p) =
      fun x => ENNReal.ofReal (shiftedMaximal σ g x ^ p) := by
    funext x
    rw [Real.enorm_eq_ofReal (shiftedMaximal_nonneg σ g x),
      ENNReal.ofReal_rpow_of_nonneg (shiftedMaximal_nonneg σ g x) (by linarith)]
  have h2 : (fun x => ‖g x‖ₑ ^ p) = fun x => ENNReal.ofReal ‖g x‖ ^ p := by
    funext x
    rw [ofReal_norm]
  rw [h1, h2]
  exact shiftedMaximal_lintegral_rpow_le σ hp hg hbdd

/-- Existential form of the `L^p` bound: for every `p > 1` there is `C_p > 0` such that
`∫ (𝓜_σ g)^p ≤ C_p log (2 + |σ|) ∫ |g|^p` for all `σ` and all bounded measurable `g`. -/
theorem exists_shiftedMaximal_lintegral_rpow_le {p : ℝ} (hp : 1 < p) :
    ∃ Cp : ℝ, 0 < Cp ∧ ∀ (σ : ℝ) (g : ℝ → ℂ), Measurable g →
      (∃ a : ℝ, 0 ≤ a ∧ ∀ x, ‖g x‖ ≤ a) →
      ∫⁻ x, ENNReal.ofReal (shiftedMaximal σ g x ^ p) ≤
        ENNReal.ofReal (Cp * Real.log (2 + |σ|)) * ∫⁻ x, ENNReal.ofReal ‖g x‖ ^ p :=
  ⟨shiftedMaximalLpConst p, shiftedMaximalLpConst_pos hp,
    fun σ _ hg hbdd => shiftedMaximal_lintegral_rpow_le σ hp hg hbdd⟩

/-! ### Vector-valued single-scale averages

The square-function bound `exists_eLpNorm_sqrt_sum_sq_shiftedAverage_le`. For `p ≥ 2` it follows
from Cauchy-Schwarz `(A g)² ≤ A(|g|²)`, the adjoint identity `∫ (A_{σ,k} f) w = ∫ f A_{-σ-1,k} w`
(`lintegral_shiftedLAvg_mul`), Hölder and the `L^{(p/2)'}` bound for `𝓜_{-σ-1}`; for `1 < p < 2`
it follows by duality, testing against `hᵢ = (A_{σ,kᵢ} gᵢ) S^{p-2}` with `S` the square function
of the averages. -/

/-- The single-scale shifted average of a function `f : ℝ → ℝ≥0∞`, as a lower Lebesgue
integral: `2^{-k} ∫⁻_{[σ 2^k, (σ+1) 2^k]} f(x+t) dt`. -/
def shiftedLAvg (σ : ℝ) (k : ℤ) (f : ℝ → ENNReal) (x : ℝ) : ENNReal :=
  ENNReal.ofReal ((2 : ℝ) ^ (-k)) * ∫⁻ t in Set.Icc (σ * 2 ^ k) ((σ + 1) * 2 ^ k), f (x + t)

/-- For bounded measurable `g`, the single-scale average as a lower Lebesgue integral. -/
theorem ofReal_shiftedAverage (σ : ℝ) {g : ℝ → ℂ} (hg : Measurable g) {a : ℝ}
    (hga : ∀ x, ‖g x‖ ≤ a) (x : ℝ) (k : ℤ) :
    ENNReal.ofReal (shiftedAverage σ g x k) = shiftedLAvg σ k (fun y => ‖g y‖ₑ) x := by
  unfold shiftedAverage shiftedLAvg
  rw [ENNReal.ofReal_mul (by positivity), ofReal_integral_eq_lintegral_ofReal
    (integrableOn_norm_comp_add hg hga x _ _) (ae_of_all _ fun _ => norm_nonneg _)]
  simp only [ofReal_norm]

/-- The single-scale averages of a bounded measurable function are measurable in `x`. -/
theorem measurable_shiftedAverage (σ : ℝ) {g : ℝ → ℂ} (hg : Measurable g) {a : ℝ}
    (hga : ∀ x, ‖g x‖ ≤ a) (k : ℤ) : Measurable fun x => shiftedAverage σ g x k := by
  have hF := intervalIntegral.continuous_primitive (μ := volume)
    (intervalIntegrable_norm_of_bound hg hga) 0
  have : (fun x => shiftedAverage σ g x k) = fun x => (2 : ℝ) ^ (-k) *
      ((∫ y in (0 : ℝ)..(x + (σ + 1) * 2 ^ k), ‖g y‖) -
        ∫ y in (0 : ℝ)..(x + σ * 2 ^ k), ‖g y‖) :=
    funext fun x => shiftedAverage_eq_primitive σ hg hga x k
  rw [this]
  exact (continuous_const.mul ((hF.comp (continuous_add_const _)).sub
    (hF.comp (continuous_add_const _)))).measurable

/-- Cauchy-Schwarz for the averages: `(A f)^2 ≤ A (f^2)`. -/
theorem shiftedLAvg_sq_le (σ : ℝ) (k : ℤ) {f : ℝ → ENNReal} (hf : Measurable f) (x : ℝ) :
    shiftedLAvg σ k f x ^ 2 ≤ shiftedLAvg σ k (fun y => f y ^ 2) x := by
  have h2 : (0 : ℝ) < 2 ^ k := zpow_pos (by norm_num) k
  set I := Set.Icc (σ * (2 : ℝ) ^ k) ((σ + 1) * 2 ^ k) with hI
  have hvol : volume I = ENNReal.ofReal (2 ^ k) := by
    rw [hI, Real.volume_Icc, show (σ + 1) * (2 : ℝ) ^ k - σ * 2 ^ k = 2 ^ k by ring]
  have hH := ENNReal.lintegral_mul_le_Lp_mul_Lq (volume.restrict I) Real.HolderConjugate.two_two
    (f := fun t => f (x + t)) (g := fun _ => 1) (hf.comp (measurable_const_add x)).aemeasurable
    aemeasurable_const
  simp only [Pi.mul_apply, mul_one, ENNReal.one_rpow, lintegral_const, Measure.restrict_apply,
    MeasurableSet.univ, univ_inter, hvol] at hH
  have hsq : (∫⁻ t in I, f (x + t)) ^ 2 ≤ (∫⁻ t in I, f (x + t) ^ 2) * ENNReal.ofReal (2 ^ k) := by
    calc (∫⁻ t in I, f (x + t)) ^ 2
        ≤ ((∫⁻ t in I, f (x + t) ^ (2 : ℝ)) ^ (1 / (2 : ℝ)) *
          ENNReal.ofReal (2 ^ k) ^ (1 / (2 : ℝ))) ^ 2 := by gcongr; simpa using hH
      _ = (∫⁻ t in I, f (x + t) ^ 2) * ENNReal.ofReal (2 ^ k) := by
        rw [mul_pow, ← ENNReal.rpow_natCast, ← ENNReal.rpow_natCast, ← ENNReal.rpow_mul,
          ← ENNReal.rpow_mul]
        norm_num
  unfold shiftedLAvg
  rw [← hI]
  have hc : ENNReal.ofReal ((2 : ℝ) ^ (-k)) * ENNReal.ofReal (2 ^ k) = 1 := by
    rw [← ENNReal.ofReal_mul (by positivity), zpow_neg, inv_mul_cancel₀ h2.ne',
      ENNReal.ofReal_one]
  calc (ENNReal.ofReal ((2 : ℝ) ^ (-k)) * ∫⁻ t in I, f (x + t)) ^ 2
      = ENNReal.ofReal ((2 : ℝ) ^ (-k)) * ENNReal.ofReal (2 ^ (-k)) *
          (∫⁻ t in I, f (x + t)) ^ 2 := by ring
    _ ≤ ENNReal.ofReal ((2 : ℝ) ^ (-k)) * ENNReal.ofReal (2 ^ (-k)) *
          ((∫⁻ t in I, f (x + t) ^ 2) * ENNReal.ofReal (2 ^ k)) := by gcongr
    _ = ENNReal.ofReal ((2 : ℝ) ^ (-k)) * ∫⁻ t in I, f (x + t) ^ 2 := by
        rw [show ∀ a b c d : ENNReal, a * b * (c * d) = a * c * (b * d) by intros; ring, hc,
          mul_one]

/-- Reflection of a lower Lebesgue integral over an interval. -/
theorem shiftedSq_lintegral_Icc_comp_neg (φ : ℝ → ENNReal) (a b : ℝ) :
    ∫⁻ t in Set.Icc a b, φ (-t) = ∫⁻ u in Set.Icc (-b) (-a), φ u := by
  rw [← lintegral_indicator measurableSet_Icc, ← lintegral_indicator measurableSet_Icc,
    ← lintegral_neg_eq_self (fun u => (Set.Icc (-b) (-a)).indicator φ u)]
  congr 1
  funext t
  have : -t ∈ Set.Icc (-b) (-a) ↔ t ∈ Set.Icc a b := by
    simp only [Set.mem_Icc]; constructor <;> rintro ⟨h1, h2⟩ <;> constructor <;> linarith
  by_cases ht : t ∈ Set.Icc a b
  · rw [indicator_of_mem ht, indicator_of_mem (this.2 ht)]
  · rw [indicator_of_notMem ht, indicator_of_notMem (fun h => ht (this.1 h))]

/-- The adjoint of the average `A_{σ,k}` is the reflected average `A_{-σ-1,k}`:
`∫ (A_{σ,k} f) w = ∫ f (A_{-σ-1,k} w)` for measurable `f, w ≥ 0`. -/
theorem lintegral_shiftedLAvg_mul (σ : ℝ) (k : ℤ) {f w : ℝ → ENNReal} (hf : Measurable f)
    (hw : Measurable w) :
    ∫⁻ x, shiftedLAvg σ k f x * w x = ∫⁻ y, f y * shiftedLAvg (-σ - 1) k w y := by
  unfold shiftedLAvg
  have hc : ENNReal.ofReal ((2 : ℝ) ^ (-k)) ≠ ⊤ := ENNReal.ofReal_ne_top
  have hrefl : ∀ y, ∫⁻ t in Set.Icc (σ * (2 : ℝ) ^ k) ((σ + 1) * 2 ^ k), w (y + -t) =
      ∫⁻ u in Set.Icc ((-σ - 1) * (2 : ℝ) ^ k) ((-σ - 1 + 1) * 2 ^ k), w (y + u) := by
    intro y
    rw [shiftedSq_lintegral_Icc_comp_neg (fun u => w (y + u)),
      show -((σ + 1) * (2 : ℝ) ^ k) = (-σ - 1) * 2 ^ k by ring,
      show -(σ * (2 : ℝ) ^ k) = (-σ - 1 + 1) * 2 ^ k by ring]
  simp_rw [← hrefl, mul_left_comm (f _), mul_assoc]
  rw [lintegral_const_mul' _ _ hc, lintegral_const_mul' _ _ hc]
  congr 1
  have h1 : ∀ x, (∫⁻ t in Set.Icc (σ * (2 : ℝ) ^ k) ((σ + 1) * 2 ^ k), f (x + t)) * w x =
      ∫⁻ t in Set.Icc (σ * (2 : ℝ) ^ k) ((σ + 1) * 2 ^ k), f (x + t) * w x := fun x =>
    (lintegral_mul_const _ (hf.comp (measurable_const_add x))).symm
  have h2 : ∀ y, f y * ∫⁻ t in Set.Icc (σ * (2 : ℝ) ^ k) ((σ + 1) * 2 ^ k), w (y + -t) =
      ∫⁻ t in Set.Icc (σ * (2 : ℝ) ^ k) ((σ + 1) * 2 ^ k), f y * w (y + -t) := fun y =>
    (lintegral_const_mul _ (hw.comp (measurable_const_add y |>.comp measurable_neg))).symm
  simp_rw [h1, h2]
  rw [lintegral_lintegral_swap (by fun_prop)]
  symm
  rw [lintegral_lintegral_swap (by fun_prop)]
  congr 1
  funext t
  rw [← lintegral_add_right_eq_self (fun y => f y * w (y + -t)) t]
  simp only [add_neg_cancel_right]

/-- Measurability of the lower Lebesgue integral averages. -/
theorem measurable_shiftedLAvg (σ : ℝ) (k : ℤ) {f : ℝ → ENNReal} (hf : Measurable f) :
    Measurable (shiftedLAvg σ k f) :=
  measurable_const.mul (Measurable.lintegral_prod_right' (hf.comp measurable_add))

/-- The averages of a bounded measurable `w` are dominated by `𝓜_σ w`. -/
theorem shiftedLAvg_le_shiftedMaximal (σ : ℝ) (k : ℤ) {w : ℝ → ℂ} (hw : Measurable w) {a : ℝ}
    (hwa : ∀ x, ‖w x‖ ≤ a) (x : ℝ) :
    shiftedLAvg σ k (fun y => ‖w y‖ₑ) x ≤ ENNReal.ofReal (shiftedMaximal σ w x) := by
  rw [← ofReal_shiftedAverage σ hw hwa]
  exact ENNReal.ofReal_le_ofReal (shiftedAverage_le_shiftedMaximal σ hwa x k)

/-- Pointwise Cauchy-Schwarz: `∑ᵢ (A_{σ,kᵢ} gᵢ)² ≤ ∑ᵢ A_{σ,kᵢ}(|gᵢ|²)`. -/
theorem ofReal_sum_sq_shiftedAverage_le {ι : Type*} (s : Finset ι) (σ : ℝ) (k : ι → ℤ)
    {g : ι → ℝ → ℂ} (hg : ∀ i, Measurable (g i)) {a : ℝ} (hga : ∀ i x, ‖g i x‖ ≤ a) (x : ℝ) :
    ENNReal.ofReal (∑ i ∈ s, shiftedAverage σ (g i) x (k i) ^ 2) ≤
      ∑ i ∈ s, shiftedLAvg σ (k i) (fun y => ‖g i y‖ₑ ^ 2) x := by
  rw [ENNReal.ofReal_sum_of_nonneg fun i _ => by positivity]
  refine Finset.sum_le_sum fun i _ => ?_
  rw [ENNReal.ofReal_pow (shiftedAverage_nonneg _ _ _ _), ofReal_shiftedAverage σ (hg i) (hga i)]
  exact shiftedLAvg_sq_le σ (k i) (hg i).enorm x

/-- The square-function form of the adjoint bound: testing `∑ᵢ (A_{σ,kᵢ} gᵢ)²` against a
bounded weight `|W|` is controlled by `∑ᵢ |gᵢ|²` tested against `𝓜_{-σ-1} W`. -/
theorem lintegral_sum_sq_shiftedAverage_mul_le {ι : Type*} (s : Finset ι) (σ : ℝ) (k : ι → ℤ)
    {g : ι → ℝ → ℂ} (hg : ∀ i, Measurable (g i)) {a : ℝ} (hga : ∀ i x, ‖g i x‖ ≤ a)
    {W : ℝ → ℂ} (hW : Measurable W) {b : ℝ} (hWb : ∀ x, ‖W x‖ ≤ b) :
    ∫⁻ x, ENNReal.ofReal (∑ i ∈ s, shiftedAverage σ (g i) x (k i) ^ 2) * ‖W x‖ₑ ≤
      ∫⁻ x, ENNReal.ofReal (∑ i ∈ s, ‖g i x‖ ^ 2) *
        ENNReal.ofReal (shiftedMaximal (-σ - 1) W x) := by
  have hM := (measurable_shiftedMaximal (-σ - 1) hW hWb).ennreal_ofReal
  calc ∫⁻ x, ENNReal.ofReal (∑ i ∈ s, shiftedAverage σ (g i) x (k i) ^ 2) * ‖W x‖ₑ
      ≤ ∫⁻ x, (∑ i ∈ s, shiftedLAvg σ (k i) (fun y => ‖g i y‖ₑ ^ 2) x) * ‖W x‖ₑ :=
        lintegral_mono fun x => by
          gcongr; exact ofReal_sum_sq_shiftedAverage_le s σ k hg hga x
    _ = ∑ i ∈ s, ∫⁻ x, shiftedLAvg σ (k i) (fun y => ‖g i y‖ₑ ^ 2) x * ‖W x‖ₑ := by
        simp_rw [Finset.sum_mul]
        exact lintegral_finsetSum _ fun i _ =>
          (measurable_shiftedLAvg σ (k i) ((hg i).enorm.pow_const 2)).mul hW.enorm
    _ = ∑ i ∈ s, ∫⁻ x, ‖g i x‖ₑ ^ 2 * shiftedLAvg (-σ - 1) (k i) (fun y => ‖W y‖ₑ) x := by
        refine Finset.sum_congr rfl fun i _ => ?_
        exact lintegral_shiftedLAvg_mul σ (k i) ((hg i).enorm.pow_const 2) hW.enorm
    _ ≤ ∑ i ∈ s, ∫⁻ x, ‖g i x‖ₑ ^ 2 * ENNReal.ofReal (shiftedMaximal (-σ - 1) W x) := by
        gcongr with i hi x
        exact shiftedLAvg_le_shiftedMaximal (-σ - 1) (k i) hW hWb x
    _ = ∫⁻ x, (∑ i ∈ s, ‖g i x‖ₑ ^ 2) * ENNReal.ofReal (shiftedMaximal (-σ - 1) W x) := by
        simp_rw [Finset.sum_mul]
        exact (lintegral_finsetSum _ fun i _ => ((hg i).enorm.pow_const 2).mul hM).symm
    _ = ∫⁻ x, ENNReal.ofReal (∑ i ∈ s, ‖g i x‖ ^ 2) *
          ENNReal.ofReal (shiftedMaximal (-σ - 1) W x) := by
        congr 1; funext x
        rw [ENNReal.ofReal_sum_of_nonneg fun i _ => by positivity]
        simp only [ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm]

/-- If `X ≤ Y X^θ` with `X < ∞` and `α + θ = 1`, `α > 0`, then `X^α ≤ Y`. -/
theorem shiftedSq_rpow_le_of_le_mul_rpow {X Y : ENNReal} {α θ : ℝ} (hα : 0 < α) (hθ : 0 ≤ θ)
    (hαθ : α + θ = 1) (hX : X ≠ ⊤) (h : X ≤ Y * X ^ θ) : X ^ α ≤ Y := by
  rcases eq_or_ne X 0 with rfl | hX0
  · rw [ENNReal.zero_rpow_of_pos hα]; exact zero_le
  have hXθ0 : X ^ θ ≠ 0 := (ENNReal.rpow_pos (pos_iff_ne_zero.2 hX0) hX).ne'
  have hXθt : X ^ θ ≠ ⊤ := ENNReal.rpow_ne_top_of_nonneg hθ hX
  have hXe : X = X ^ α * X ^ θ := by
    rw [← ENNReal.rpow_add _ _ hX0 hX, hαθ, ENNReal.rpow_one]
  exact (ENNReal.mul_le_mul_iff_left hXθ0 hXθt).1 (hXe.symm.le.trans h)

/-- `L^p` norms of nonnegative real functions as lower Lebesgue integrals. -/
theorem shiftedSq_eLpNorm_ofReal_eq {f : ℝ → ℝ} (hf : ∀ x, 0 ≤ f x) {p : ℝ} (hp : 0 < p) :
    eLpNorm f (ENNReal.ofReal p) volume = (∫⁻ x, ENNReal.ofReal (f x) ^ p) ^ (1 / p) := by
  have hp0 : ENNReal.ofReal p ≠ 0 := by simpa using hp
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 ENNReal.ofReal_ne_top,
    ENNReal.toReal_ofReal hp.le]
  simp only [Real.enorm_eq_ofReal (hf _)]

/-- `L^p` norms of square roots of nonnegative real functions. -/
theorem shiftedSq_eLpNorm_sqrt_eq {F : ℝ → ℝ} (hF : ∀ x, 0 ≤ F x) {p : ℝ} (hp : 0 < p) :
    eLpNorm (fun x => √(F x)) (ENNReal.ofReal p) volume =
      (∫⁻ x, ENNReal.ofReal (F x) ^ (p / 2)) ^ (1 / p) := by
  rw [shiftedSq_eLpNorm_ofReal_eq (fun x => Real.sqrt_nonneg _) hp]
  congr 2; funext x
  rw [ENNReal.ofReal_rpow_of_nonneg (Real.sqrt_nonneg _) hp.le,
    ENNReal.ofReal_rpow_of_nonneg (hF x) (by positivity), Real.sqrt_eq_rpow, ← Real.rpow_mul (hF x)]
  ring_nf

/-- A bound can always be taken nonnegative. -/
theorem shiftedSq_exists_nonneg_bound {g : ℝ → ℂ} {a : ℝ} (hga : ∀ x, ‖g x‖ ≤ a) :
    ∃ b : ℝ, 0 ≤ b ∧ ∀ x, ‖g x‖ ≤ b :=
  ⟨max a 0, le_max_right _ _, fun x => (hga x).trans (le_max_left _ _)⟩

/-- A uniform bound on the square sum of the averages of bounded functions. -/
theorem sum_sq_shiftedAverage_le {ι : Type*} (s : Finset ι) (σ : ℝ) (k : ι → ℤ)
    {g : ι → ℝ → ℂ} {a : ℝ} (hga : ∀ i x, ‖g i x‖ ≤ a) (x : ℝ) :
    ∑ i ∈ s, shiftedAverage σ (g i) x (k i) ^ 2 ≤ ∑ _i ∈ s, a ^ 2 :=
  Finset.sum_le_sum fun i _ => pow_le_pow_left₀ (shiftedAverage_nonneg _ _ _ _)
    (shiftedAverage_le_of_bound σ (hga i) x (k i)) 2

/-- Measurability of the square sum of the averages. -/
theorem measurable_sum_sq_shiftedAverage {ι : Type*} (s : Finset ι) (σ : ℝ) (k : ι → ℤ)
    {g : ι → ℝ → ℂ} (hg : ∀ i, Measurable (g i)) {a : ℝ} (hga : ∀ i x, ‖g i x‖ ≤ a) :
    Measurable fun x => ∑ i ∈ s, shiftedAverage σ (g i) x (k i) ^ 2 :=
  Finset.measurable_fun_sum s fun i _ =>
    (measurable_shiftedAverage σ (hg i) (hga i) (k i)).pow_const 2

/-- Finiteness: the square function of the single-scale averages is in `L^p` whenever the
square function of the `gᵢ` is. -/
theorem eLpNorm_sqrt_sum_sq_shiftedAverage_ne_top {ι : Type*} (s : Finset ι) (σ : ℝ)
    (k : ι → ℤ) {g : ι → ℝ → ℂ} (hg : ∀ i, Measurable (g i)) {a : ℝ}
    (hga : ∀ i x, ‖g i x‖ ≤ a) {p : ℝ} (hp : 1 < p)
    (hG : eLpNorm (fun x => √(∑ i ∈ s, ‖g i x‖ ^ 2)) (ENNReal.ofReal p) volume ≠ ⊤) :
    eLpNorm (fun x => √(∑ i ∈ s, shiftedAverage σ (g i) x (k i) ^ 2)) (ENNReal.ofReal p)
      volume ≠ ⊤ := by
  have h1 : eLpNorm (fun x => √(∑ i ∈ s, shiftedAverage σ (g i) x (k i) ^ 2))
      (ENNReal.ofReal p) volume ≤
      eLpNorm (∑ i ∈ s, fun x => shiftedAverage σ (g i) x (k i)) (ENNReal.ofReal p) volume := by
    refine eLpNorm_mono_real fun x => ?_
    rw [Real.norm_of_nonneg (Real.sqrt_nonneg _), Finset.sum_apply]
    exact Real.sqrt_le_iff.2 ⟨Finset.sum_nonneg fun i _ => shiftedAverage_nonneg _ _ _ _,
      Finset.sum_sq_le_sq_sum_of_nonneg fun i _ => shiftedAverage_nonneg _ _ _ _⟩
  refine ne_top_of_le_ne_top ?_ (h1.trans (eLpNorm_sum_le (fun i _ =>
    (measurable_shiftedAverage σ (hg i) (hga i) (k i)).aestronglyMeasurable)
    (by simpa using hp.le)))
  refine (ENNReal.sum_lt_top.2 fun i hi => ?_).ne
  obtain ⟨b, hb0, hb⟩ := shiftedSq_exists_nonneg_bound (hga i)
  have h2 : eLpNorm (fun x => shiftedAverage σ (g i) x (k i)) (ENNReal.ofReal p) volume ≤
      eLpNorm (shiftedMaximal σ (g i)) (ENNReal.ofReal p) volume :=
    eLpNorm_mono_real fun x => by
      rw [Real.norm_of_nonneg (shiftedAverage_nonneg _ _ _ _)]
      exact shiftedAverage_le_shiftedMaximal σ (hga i) x (k i)
  have h3 : eLpNorm (g i) (ENNReal.ofReal p) volume ≤
      eLpNorm (fun x => √(∑ i ∈ s, ‖g i x‖ ^ 2)) (ENNReal.ofReal p) volume :=
    eLpNorm_mono_real fun x => Real.le_sqrt_of_sq_le
      (Finset.single_le_sum (f := fun j => ‖g j x‖ ^ 2) (fun j _ => by positivity) hi)
  refine lt_of_le_of_lt (h2.trans ((shiftedMaximal_eLpNorm_le σ hp (hg i) ⟨b, hb0, hb⟩).trans
    (mul_le_mul_right h3 _))) ?_
  exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top hG.lt_top

/-- The case `p > 2` of the square-function bound, with explicit constant. -/
theorem eLpNorm_sqrt_sum_sq_shiftedAverage_le_of_two_lt {ι : Type*} (s : Finset ι) (σ : ℝ)
    (k : ι → ℤ) {g : ι → ℝ → ℂ} (hg : ∀ i, Measurable (g i)) {a : ℝ}
    (hga : ∀ i x, ‖g i x‖ ≤ a) {p : ℝ} (hp : 2 < p) :
    eLpNorm (fun x => √(∑ i ∈ s, shiftedAverage σ (g i) x (k i) ^ 2)) (ENNReal.ofReal p)
      volume ≤
      ENNReal.ofReal ((shiftedMaximalLpConst (p / (p - 2)) * Real.log (2 + |-σ - 1|)) ^
        ((p - 2) / (2 * p))) *
        eLpNorm (fun x => √(∑ i ∈ s, ‖g i x‖ ^ 2)) (ENNReal.ofReal p) volume := by
  have hp0 : 0 < p := by linarith
  have hq1 : 1 < p / 2 := by linarith
  have hqq : (p / 2).HolderConjugate (p / (p - 2)) :=
    (Real.holderConjugate_iff_eq_conjExponent hq1).2 (by field_simp)
  have hq' : 1 < p / (p - 2) := hqq.symm.lt
  have hΛ : 0 < Real.log (2 + |-σ - 1|) := Real.log_pos (by linarith [abs_nonneg (-σ - 1)])
  have hc0 : 0 < shiftedMaximalLpConst (p / (p - 2)) * Real.log (2 + |-σ - 1|) :=
    mul_pos (shiftedMaximalLpConst_pos hq') hΛ
  by_cases hY : eLpNorm (fun x => √(∑ i ∈ s, ‖g i x‖ ^ 2)) (ENNReal.ofReal p) volume = ⊤
  · rw [hY, ENNReal.mul_top (by simpa using Real.rpow_pos_of_pos hc0 _)]
    exact le_top
  have hXne := eLpNorm_sqrt_sum_sq_shiftedAverage_ne_top s σ k hg hga (by linarith) hY
  obtain ⟨F, hF⟩ : ∃ F : ℝ → ℝ, F = fun x => ∑ i ∈ s, shiftedAverage σ (g i) x (k i) ^ 2 :=
    ⟨_, rfl⟩
  obtain ⟨G, hG⟩ : ∃ G : ℝ → ℝ, G = fun x => ∑ i ∈ s, ‖g i x‖ ^ 2 := ⟨_, rfl⟩
  have hF0 : ∀ x, 0 ≤ F x := fun x => by rw [hF]; positivity
  have hG0 : ∀ x, 0 ≤ G x := fun x => by rw [hG]; positivity
  have hFm : Measurable F := hF ▸ measurable_sum_sq_shiftedAverage s σ k hg hga
  have hGm : Measurable G := hG ▸ Finset.measurable_fun_sum s fun i _ =>
    (hg i).norm.pow_const 2
  have hp2 : p - 2 ≠ 0 := by linarith
  have hFb : ∀ x, F x ≤ ∑ _i ∈ s, a ^ 2 := fun x => by
    rw [hF]; exact sum_sq_shiftedAverage_le s σ k hga x
  have eF : (fun x => √(∑ i ∈ s, shiftedAverage σ (g i) x (k i) ^ 2)) = fun x => √(F x) := by
    rw [hF]
  have eG : (fun x => √(∑ i ∈ s, ‖g i x‖ ^ 2)) = fun x => √(G x) := by rw [hG]
  rw [eF] at hXne ⊢
  rw [eG] at hY ⊢
  rw [shiftedSq_eLpNorm_sqrt_eq hF0 hp0] at hXne ⊢
  rw [shiftedSq_eLpNorm_sqrt_eq hG0 hp0] at hY ⊢
  have hX : ∫⁻ x, ENNReal.ofReal (F x) ^ (p / 2) ≠ ⊤ := by
    intro h; rw [h, ENNReal.top_rpow_of_pos (by positivity)] at hXne; exact hXne rfl
  -- the weight `W = F^{q-1}`
  obtain ⟨W, hW⟩ : ∃ W : ℝ → ℂ, W = fun x => ((F x ^ (p / 2 - 1) : ℝ) : ℂ) := ⟨_, rfl⟩
  have hWn : ∀ x, ‖W x‖ = F x ^ (p / 2 - 1) := fun x => by
    rw [hW, Complex.norm_real, Real.norm_of_nonneg (Real.rpow_nonneg (hF0 x) _)]
  have hWm : Measurable W := hW ▸ Complex.measurable_ofReal.comp (hFm.pow_const _)
  have hWb : ∀ x, ‖W x‖ ≤ (∑ _i ∈ s, a ^ 2) ^ (p / 2 - 1) := fun x => by
    rw [hWn]; exact Real.rpow_le_rpow (hF0 x) (hFb x) (by linarith)
  have key : ∫⁻ x, ENNReal.ofReal (F x) * ‖W x‖ₑ ≤
      ∫⁻ x, ENNReal.ofReal (G x) * ENNReal.ofReal (shiftedMaximal (-σ - 1) W x) := by
    rw [hF, hG]; exact lintegral_sum_sq_shiftedAverage_mul_le s σ k hg hga hWm hWb
  have hXeq : ∫⁻ x, ENNReal.ofReal (F x) ^ (p / 2) =
      ∫⁻ x, ENNReal.ofReal (F x) * ‖W x‖ₑ := by
    congr 1; funext x
    rw [← ofReal_norm, hWn, ← ENNReal.ofReal_mul (hF0 x),
      ENNReal.ofReal_rpow_of_nonneg (hF0 x) (by positivity)]
    congr 1
    conv_lhs => rw [show p / 2 = 1 + (p / 2 - 1) by ring]
    rw [Real.rpow_add' (hF0 x) (by linarith), Real.rpow_one]
  have hMm := (measurable_shiftedMaximal (-σ - 1) hWm hWb).ennreal_ofReal
  have hHol := ENNReal.lintegral_mul_le_Lp_mul_Lq volume hqq
    (f := fun x => ENNReal.ofReal (G x))
    (g := fun x => ENNReal.ofReal (shiftedMaximal (-σ - 1) W x))
    hGm.ennreal_ofReal.aemeasurable hMm.aemeasurable
  obtain ⟨b, hb0, hb⟩ := shiftedSq_exists_nonneg_bound hWb
  have hMax := shiftedMaximal_lintegral_rpow_le (-σ - 1) hq' hWm ⟨b, hb0, hb⟩
  have hWX : ∫⁻ x, ENNReal.ofReal ‖W x‖ ^ (p / (p - 2)) = ∫⁻ x, ENNReal.ofReal (F x) ^ (p / 2) := by
    congr 1; funext x
    rw [hWn, ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg (hF0 x) _) (by linarith),
      ← Real.rpow_mul (hF0 x), ENNReal.ofReal_rpow_of_nonneg (hF0 x) (by linarith)]
    congr 2
    field_simp
  have hMax' : ∫⁻ x, ENNReal.ofReal (shiftedMaximal (-σ - 1) W x) ^ (p / (p - 2)) ≤
      ENNReal.ofReal (shiftedMaximalLpConst (p / (p - 2)) * Real.log (2 + |-σ - 1|)) *
        ∫⁻ x, ENNReal.ofReal (F x) ^ (p / 2) := by
    rw [← hWX]
    refine le_trans (le_of_eq ?_) hMax
    congr 1; funext x
    exact ENNReal.ofReal_rpow_of_nonneg (shiftedMaximal_nonneg _ _ _) (by linarith)
  simp only [Pi.mul_apply] at hHol
  have hmain : ∫⁻ x, ENNReal.ofReal (F x) ^ (p / 2) ≤
      ((∫⁻ x, ENNReal.ofReal (G x) ^ (p / 2)) ^ (1 / (p / 2)) *
        ENNReal.ofReal (shiftedMaximalLpConst (p / (p - 2)) * Real.log (2 + |-σ - 1|)) ^
          (1 / (p / (p - 2)))) * (∫⁻ x, ENNReal.ofReal (F x) ^ (p / 2)) ^ (1 / (p / (p - 2))) := by
    rw [mul_assoc, ← ENNReal.mul_rpow_of_nonneg _ _ (by positivity)]
    calc ∫⁻ x, ENNReal.ofReal (F x) ^ (p / 2) = ∫⁻ x, ENNReal.ofReal (F x) * ‖W x‖ₑ := hXeq
      _ ≤ _ := key
      _ ≤ _ := hHol
      _ ≤ _ := by gcongr
  have hθ := shiftedSq_rpow_le_of_le_mul_rpow (α := 1 / (p / 2)) (θ := 1 / (p / (p - 2)))
    (by positivity) (by positivity)
    (by rw [one_div, one_div]; exact hqq.inv_add_inv_eq_one) hX hmain
  calc (∫⁻ x, ENNReal.ofReal (F x) ^ (p / 2)) ^ (1 / p)
      = ((∫⁻ x, ENNReal.ofReal (F x) ^ (p / 2)) ^ (1 / (p / 2))) ^ (1 / (2 : ℝ)) := by
        rw [← ENNReal.rpow_mul]; congr 1; field_simp
    _ ≤ ((∫⁻ x, ENNReal.ofReal (G x) ^ (p / 2)) ^ (1 / (p / 2)) *
        ENNReal.ofReal (shiftedMaximalLpConst (p / (p - 2)) * Real.log (2 + |-σ - 1|)) ^
          (1 / (p / (p - 2)))) ^ (1 / (2 : ℝ)) := by gcongr
    _ = _ := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
          ENNReal.ofReal_rpow_of_nonneg hc0.le (by positivity), mul_comm]
        congr 2
        · congr 1; field_simp
        · field_simp

/-- The case `p = 2` of the square-function bound, with constant `1`. -/
theorem eLpNorm_sqrt_sum_sq_shiftedAverage_le_two {ι : Type*} (s : Finset ι) (σ : ℝ)
    (k : ι → ℤ) {g : ι → ℝ → ℂ} (hg : ∀ i, Measurable (g i)) {a : ℝ}
    (hga : ∀ i x, ‖g i x‖ ≤ a) :
    eLpNorm (fun x => √(∑ i ∈ s, shiftedAverage σ (g i) x (k i) ^ 2)) (ENNReal.ofReal 2)
      volume ≤ eLpNorm (fun x => √(∑ i ∈ s, ‖g i x‖ ^ 2)) (ENNReal.ofReal 2) volume := by
  rw [shiftedSq_eLpNorm_sqrt_eq (fun x => by positivity) two_pos,
    shiftedSq_eLpNorm_sqrt_eq (fun x => by positivity) two_pos]
  gcongr ?_ ^ _
  simp only [div_self (two_ne_zero' ℝ), ENNReal.rpow_one]
  have hW : ∀ x, ‖(fun _ : ℝ => (1 : ℂ)) x‖ ≤ 1 := fun x => by simp
  have key := lintegral_sum_sq_shiftedAverage_mul_le s σ k hg hga measurable_const hW
  simp only [enorm_one, mul_one] at key
  refine key.trans (lintegral_mono fun x => ?_)
  calc ENNReal.ofReal (∑ i ∈ s, ‖g i x‖ ^ 2) *
        ENNReal.ofReal (shiftedMaximal (-σ - 1) (fun _ => 1) x)
      ≤ ENNReal.ofReal (∑ i ∈ s, ‖g i x‖ ^ 2) * ENNReal.ofReal 1 := by
        gcongr; exact (shiftedMaximal_le_of_bound _ hW x).2
    _ = _ := by rw [ENNReal.ofReal_one, mul_one]

/-- The logarithmic loss at the reflected shift `-σ-1`. -/
theorem log_two_add_abs_neg_sub_one_le (σ : ℝ) :
    Real.log (2 + |-σ - 1|) ≤ 2 * Real.log (2 + |σ|) := by
  have h1 : |-σ - 1| ≤ |σ| + 1 := by
    rw [show -σ - 1 = -(σ + 1) by ring, abs_neg]
    exact (abs_add_le _ _).trans (by simp)
  rw [show (2 : ℝ) * Real.log (2 + |σ|) = Real.log ((2 + |σ|) ^ 2) by
    rw [Real.log_pow]; norm_num]
  exact Real.log_le_log (by positivity) (by nlinarith [abs_nonneg σ])

/-- `x^θ ≤ 1 + x` for `x ≥ 0` and `θ ∈ [0, 1]`. -/
theorem shiftedSq_rpow_le_one_add {x θ : ℝ} (hx : 0 ≤ x) (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1) :
    x ^ θ ≤ 1 + x := by
  rcases le_total x 1 with h | h
  · linarith [Real.rpow_le_one hx h hθ0]
  · have := Real.rpow_le_rpow_of_exponent_le h hθ1
    rw [Real.rpow_one] at this
    linarith

/-- `1 ≤ log (2 + |σ|) / log 2`. -/
theorem one_le_log_two_add_abs_div (σ : ℝ) : 1 ≤ Real.log (2 + |σ|) / Real.log 2 := by
  rw [le_div_iff₀ (Real.log_pos one_lt_two), one_mul]
  exact Real.log_le_log two_pos (by linarith [abs_nonneg σ])

/-- **Vector-valued single-scale shifted averages, `p ≥ 2`.** -/
theorem exists_eLpNorm_sqrt_sum_sq_shiftedAverage_le_of_two_le {p : ℝ} (hp : 2 ≤ p) :
    ∃ C : ℝ, 0 < C ∧ ∀ {ι : Type*} (s : Finset ι) (σ : ℝ) (k : ι → ℤ) (g : ι → ℝ → ℂ),
      (∀ i, Measurable (g i)) → ∀ a : ℝ, (∀ i x, ‖g i x‖ ≤ a) →
      eLpNorm (fun x => √(∑ i ∈ s, shiftedAverage σ (g i) x (k i) ^ 2)) (ENNReal.ofReal p)
        volume ≤ ENNReal.ofReal (C * Real.log (2 + |σ|)) *
          eLpNorm (fun x => √(∑ i ∈ s, ‖g i x‖ ^ 2)) (ENNReal.ofReal p) volume := by
  have hl2 : 0 < Real.log 2 := Real.log_pos one_lt_two
  rcases hp.eq_or_lt with rfl | hp2
  · refine ⟨1 / Real.log 2, by positivity, fun s σ k g hg a hga => ?_⟩
    refine (eLpNorm_sqrt_sum_sq_shiftedAverage_le_two s σ k hg hga).trans ?_
    refine le_mul_of_one_le_left zero_le ?_
    rw [← ENNReal.ofReal_one]
    refine ENNReal.ofReal_le_ofReal ?_
    have := one_le_log_two_add_abs_div σ
    rw [one_div_mul_eq_div]; exact this
  have hq' : 1 < p / (p - 2) := by rw [one_lt_div (by linarith)]; linarith
  have hc := shiftedMaximalLpConst_pos hq'
  refine ⟨1 / Real.log 2 + 2 * shiftedMaximalLpConst (p / (p - 2)), by positivity,
    fun s σ k g hg a hga => ?_⟩
  refine (eLpNorm_sqrt_sum_sq_shiftedAverage_le_of_two_lt s σ k hg hga hp2).trans ?_
  gcongr
  have hΛ : 0 < Real.log (2 + |-σ - 1|) := Real.log_pos (by linarith [abs_nonneg (-σ - 1)])
  have hθ0 : 0 ≤ (p - 2) / (2 * p) := div_nonneg (by linarith) (by linarith)
  have hθ1 : (p - 2) / (2 * p) ≤ 1 := by rw [div_le_one (by linarith)]; linarith
  refine (shiftedSq_rpow_le_one_add (mul_pos hc hΛ).le hθ0 hθ1).trans ?_
  have h1 := log_two_add_abs_neg_sub_one_le σ
  have h2 := one_le_log_two_add_abs_div σ
  have h3 : 1 ≤ 1 / Real.log 2 * Real.log (2 + |σ|) := by rwa [one_div_mul_eq_div]
  nlinarith [mul_le_mul_of_nonneg_left h1 hc.le]

/-- Duality step: testing the averages `A_{σ,kᵢ} gᵢ` against weights `|Hᵢ|` is controlled by the
square functions of the `gᵢ` and of the reflected averages `A_{-σ-1,kᵢ} Hᵢ`. -/
theorem lintegral_sum_shiftedAverage_mul_le {ι : Type*} (s : Finset ι) (σ : ℝ) (k : ι → ℤ)
    {g : ι → ℝ → ℂ} (hg : ∀ i, Measurable (g i)) {a : ℝ} (hga : ∀ i x, ‖g i x‖ ≤ a)
    {H : ι → ℝ → ℂ} (hH : ∀ i, Measurable (H i)) {b : ℝ} (hHb : ∀ i x, ‖H i x‖ ≤ b) :
    ∫⁻ x, ∑ i ∈ s, ENNReal.ofReal (shiftedAverage σ (g i) x (k i)) * ‖H i x‖ₑ ≤
      ∫⁻ x, ENNReal.ofReal (√(∑ i ∈ s, ‖g i x‖ ^ 2)) *
        ENNReal.ofReal (√(∑ i ∈ s, shiftedAverage (-σ - 1) (H i) x (k i) ^ 2)) := by
  calc ∫⁻ x, ∑ i ∈ s, ENNReal.ofReal (shiftedAverage σ (g i) x (k i)) * ‖H i x‖ₑ
      = ∑ i ∈ s, ∫⁻ x, shiftedLAvg σ (k i) (fun y => ‖g i y‖ₑ) x * ‖H i x‖ₑ := by
        simp_rw [ofReal_shiftedAverage σ (hg _) (hga _)]
        exact lintegral_finsetSum _ fun i _ =>
          (measurable_shiftedLAvg σ (k i) (hg i).enorm).mul (hH i).enorm
    _ = ∑ i ∈ s, ∫⁻ x, ‖g i x‖ₑ * shiftedLAvg (-σ - 1) (k i) (fun y => ‖H i y‖ₑ) x := by
        refine Finset.sum_congr rfl fun i _ => ?_
        exact lintegral_shiftedLAvg_mul σ (k i) (hg i).enorm (hH i).enorm
    _ = ∫⁻ x, ∑ i ∈ s, ENNReal.ofReal (‖g i x‖ * shiftedAverage (-σ - 1) (H i) x (k i)) := by
        simp_rw [← ofReal_shiftedAverage (-σ - 1) (hH _) (hHb _),
          ENNReal.ofReal_mul (norm_nonneg _), ofReal_norm]
        exact (lintegral_finsetSum _ fun i _ => (hg i).enorm.mul
          (measurable_shiftedAverage (-σ - 1) (hH i) (hHb i) (k i)).ennreal_ofReal).symm
    _ ≤ _ := by
        refine lintegral_mono fun x => ?_
        rw [← ENNReal.ofReal_sum_of_nonneg fun i _ =>
          mul_nonneg (norm_nonneg _) (shiftedAverage_nonneg _ _ _ _),
          ← ENNReal.ofReal_mul (Real.sqrt_nonneg _)]
        exact ENNReal.ofReal_le_ofReal (Real.sum_mul_le_sqrt_mul_sqrt s _ _)

/-- Hölder's inequality for nonnegative real functions in `eLpNorm` form. -/
theorem shiftedSq_lintegral_ofReal_mul_le {u v : ℝ → ℝ} (hu : Measurable u)
    (hv : Measurable v) (hu0 : ∀ x, 0 ≤ u x) (hv0 : ∀ x, 0 ≤ v x) {p q : ℝ}
    (hpq : p.HolderConjugate q) :
    ∫⁻ x, ENNReal.ofReal (u x) * ENNReal.ofReal (v x) ≤
      eLpNorm u (ENNReal.ofReal p) volume * eLpNorm v (ENNReal.ofReal q) volume := by
  rw [shiftedSq_eLpNorm_ofReal_eq hu0 hpq.pos, shiftedSq_eLpNorm_ofReal_eq hv0 hpq.symm.pos]
  exact ENNReal.lintegral_mul_le_Lp_mul_Lq volume hpq hu.ennreal_ofReal.aemeasurable
    hv.ennreal_ofReal.aemeasurable

/-- The case `1 < p < 2` of the square-function bound, by duality from the dual exponent
`q > 2`. -/
theorem eLpNorm_sqrt_sum_sq_shiftedAverage_le_of_lt_two {p q : ℝ} (hpq : p.HolderConjugate q)
    (hp2 : p < 2) {C : ℝ} (hC : 0 < C)
    (hCq : ∀ (s : Finset ι) (σ : ℝ) (k : ι → ℤ) (g : ι → ℝ → ℂ),
      (∀ i, Measurable (g i)) → ∀ a : ℝ, (∀ i x, ‖g i x‖ ≤ a) →
      eLpNorm (fun x => √(∑ i ∈ s, shiftedAverage σ (g i) x (k i) ^ 2)) (ENNReal.ofReal q)
        volume ≤ ENNReal.ofReal (C * Real.log (2 + |σ|)) *
          eLpNorm (fun x => √(∑ i ∈ s, ‖g i x‖ ^ 2)) (ENNReal.ofReal q) volume)
    (s : Finset ι) (σ : ℝ) (k : ι → ℤ) {g : ι → ℝ → ℂ} (hg : ∀ i, Measurable (g i)) {a : ℝ}
    (hga : ∀ i x, ‖g i x‖ ≤ a) :
    eLpNorm (fun x => √(∑ i ∈ s, shiftedAverage σ (g i) x (k i) ^ 2)) (ENNReal.ofReal p)
      volume ≤ ENNReal.ofReal (2 * C * Real.log (2 + |σ|)) *
        eLpNorm (fun x => √(∑ i ∈ s, ‖g i x‖ ^ 2)) (ENNReal.ofReal p) volume := by
  classical
  have hp1 : 1 < p := hpq.lt
  have hp0 : 0 < p := by linarith
  have hΛ : 0 < Real.log (2 + |σ|) := Real.log_pos (by linarith [abs_nonneg σ])
  by_cases hY : eLpNorm (fun x => √(∑ i ∈ s, ‖g i x‖ ^ 2)) (ENNReal.ofReal p) volume = ⊤
  · rw [hY, ENNReal.mul_top (by simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]; positivity)]
    exact le_top
  have hXne := eLpNorm_sqrt_sum_sq_shiftedAverage_ne_top s σ k hg hga hp1 hY
  obtain ⟨S, hS⟩ : ∃ S : ℝ → ℝ, S = fun x => √(∑ i ∈ s, shiftedAverage σ (g i) x (k i) ^ 2) :=
    ⟨_, rfl⟩
  rw [← hS] at hXne ⊢
  have hS0 : ∀ x, 0 ≤ S x := fun x => by rw [hS]; exact Real.sqrt_nonneg _
  have hSm : Measurable S := hS ▸ (measurable_sum_sq_shiftedAverage s σ k hg hga).sqrt
  have hSsq : ∀ x, S x ^ 2 = ∑ i ∈ s, shiftedAverage σ (g i) x (k i) ^ 2 := fun x => by
    rw [hS]; exact Real.sq_sqrt (by positivity)
  have hSb : ∀ x, S x ≤ √(∑ _i ∈ s, a ^ 2) := fun x => by
    rw [hS]; exact Real.sqrt_le_sqrt (sum_sq_shiftedAverage_le s σ k hga x)
  have hAS : ∀ i ∈ s, ∀ x, shiftedAverage σ (g i) x (k i) ≤ S x := fun i hi x => by
    rw [hS]
    exact Real.le_sqrt_of_sq_le (Finset.single_le_sum
      (f := fun j => shiftedAverage σ (g j) x (k j) ^ 2) (fun j _ => by positivity) hi)
  -- the extremal test functions `hᵢ = Aᵢ S^{p-2}` (for `i ∈ s`)
  obtain ⟨h, hh⟩ : ∃ h : ι → ℝ → ℝ, h = fun i x =>
      if i ∈ s then shiftedAverage σ (g i) x (k i) * S x ^ (p - 2) else 0 := ⟨_, rfl⟩
  have hh0 : ∀ i x, 0 ≤ h i x := fun i x => by
    rw [hh]; dsimp only; split_ifs
    · exact mul_nonneg (shiftedAverage_nonneg _ _ _ _) (Real.rpow_nonneg (hS0 x) _)
    · exact le_rfl
  have hhm : ∀ i, Measurable (h i) := fun i => by
    rw [hh]; dsimp only; split_ifs
    · exact (measurable_shiftedAverage σ (hg i) (hga i) (k i)).mul (hSm.pow_const _)
    · exact measurable_const
  have hhb : ∀ i x, h i x ≤ (√(∑ _i ∈ s, a ^ 2)) ^ (p - 1) := fun i x => by
    have hB : 0 ≤ (√(∑ _i ∈ s, a ^ 2)) ^ (p - 1) := Real.rpow_nonneg (Real.sqrt_nonneg _) _
    rw [hh]; dsimp only; split_ifs with hi
    · refine le_trans ?_ (Real.rpow_le_rpow (hS0 x) (hSb x) (by linarith))
      rcases (hS0 x).eq_or_lt with h0 | hpos
      · have : shiftedAverage σ (g i) x (k i) = 0 :=
          le_antisymm (h0 ▸ hAS i hi x) (shiftedAverage_nonneg _ _ _ _)
        rw [this, zero_mul]; exact Real.rpow_nonneg (hS0 x) _
      · calc shiftedAverage σ (g i) x (k i) * S x ^ (p - 2) ≤ S x * S x ^ (p - 2) :=
              mul_le_mul_of_nonneg_right (hAS i hi x) (Real.rpow_nonneg (hS0 x) _)
          _ = S x ^ (p - 1) := by
              rw [show p - 1 = 1 + (p - 2) by ring, Real.rpow_add hpos, Real.rpow_one]
    · exact hB
  obtain ⟨H, hH⟩ : ∃ H : ι → ℝ → ℂ, H = fun i x => ((h i x : ℝ) : ℂ) := ⟨_, rfl⟩
  have hHn : ∀ i x, ‖H i x‖ = h i x := fun i x => by
    rw [hH, Complex.norm_real, Real.norm_of_nonneg (hh0 i x)]
  have hHm : ∀ i, Measurable (H i) := fun i => hH ▸ Complex.measurable_ofReal.comp (hhm i)
  have hHb : ∀ i x, ‖H i x‖ ≤ (√(∑ _i ∈ s, a ^ 2)) ^ (p - 1) := fun i x => by
    rw [hHn]; exact hhb i x
  have hT : ∀ i ∈ s, ∀ x, h i x = shiftedAverage σ (g i) x (k i) * S x ^ (p - 2) :=
    fun i hi x => by rw [hh]; dsimp only; rw [if_pos hi]
  have hid1 : ∀ x, ENNReal.ofReal (S x) ^ p =
      ∑ i ∈ s, ENNReal.ofReal (shiftedAverage σ (g i) x (k i)) * ‖H i x‖ₑ := by
    intro x
    rw [ENNReal.ofReal_rpow_of_nonneg (hS0 x) hp0.le]
    simp_rw [← ofReal_norm, hHn, ← ENNReal.ofReal_mul (shiftedAverage_nonneg _ _ _ _)]
    rw [← ENNReal.ofReal_sum_of_nonneg
      (fun i _ => mul_nonneg (shiftedAverage_nonneg _ _ _ _) (hh0 i x))]
    congr 1
    have : ∑ i ∈ s, shiftedAverage σ (g i) x (k i) * h i x = S x ^ 2 * S x ^ (p - 2) := by
      rw [hSsq, Finset.sum_mul]
      exact Finset.sum_congr rfl fun i hi => by rw [hT i hi x]; ring
    rw [this, ← Real.rpow_two, ← Real.rpow_add' (hS0 x) (by linarith),
      show (2 : ℝ) + (p - 2) = p by ring]
  have hid2 : ∀ x, √(∑ i ∈ s, ‖H i x‖ ^ 2) = S x ^ (p - 1) := by
    intro x
    simp_rw [hHn]
    have : ∑ i ∈ s, h i x ^ 2 = (S x * S x ^ (p - 2)) ^ 2 := by
      rw [mul_pow, hSsq, Finset.sum_mul]
      exact Finset.sum_congr rfl fun i hi => by rw [hT i hi x]; ring
    rw [this, Real.sqrt_sq (mul_nonneg (hS0 x) (Real.rpow_nonneg (hS0 x) _)),
      show p - 1 = 1 + (p - 2) by ring, Real.rpow_add' (hS0 x) (by linarith), Real.rpow_one]
  have hD := lintegral_sum_shiftedAverage_mul_le s σ k hg hga hHm hHb
  have hBm : Measurable fun x =>
      √(∑ i ∈ s, shiftedAverage (-σ - 1) (H i) x (k i) ^ 2) :=
    (measurable_sum_sq_shiftedAverage s (-σ - 1) k hHm hHb).sqrt
  have hGm : Measurable fun x => √(∑ i ∈ s, ‖g i x‖ ^ 2) :=
    (Finset.measurable_fun_sum s fun i _ => (hg i).norm.pow_const 2).sqrt
  have hHol := shiftedSq_lintegral_ofReal_mul_le hGm hBm (fun _ => Real.sqrt_nonneg _)
    (fun _ => Real.sqrt_nonneg _) hpq
  have hq := hCq s (-σ - 1) k H hHm _ hHb
  have hHS : eLpNorm (fun x => √(∑ i ∈ s, ‖H i x‖ ^ 2)) (ENNReal.ofReal q) volume =
      (∫⁻ x, ENNReal.ofReal (S x) ^ p) ^ (1 / q) := by
    simp_rw [hid2]
    rw [shiftedSq_eLpNorm_ofReal_eq (fun x => Real.rpow_nonneg (hS0 x) _) hpq.symm.pos]
    congr 2; funext x
    rw [ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg (hS0 x) _) hpq.symm.pos.le,
      ← Real.rpow_mul (hS0 x), hpq.sub_one_mul_conj,
      ENNReal.ofReal_rpow_of_nonneg (hS0 x) hp0.le]
  have hXeq : eLpNorm S (ENNReal.ofReal p) volume =
      (∫⁻ x, ENNReal.ofReal (S x) ^ p) ^ (1 / p) := shiftedSq_eLpNorm_ofReal_eq hS0 hp0
  have hX : ∫⁻ x, ENNReal.ofReal (S x) ^ p ≠ ⊤ := by
    intro h; rw [hXeq, h, ENNReal.top_rpow_of_pos (by positivity)] at hXne; exact hXne rfl
  have hmain : ∫⁻ x, ENNReal.ofReal (S x) ^ p ≤
      (eLpNorm (fun x => √(∑ i ∈ s, ‖g i x‖ ^ 2)) (ENNReal.ofReal p) volume *
        ENNReal.ofReal (C * Real.log (2 + |-σ - 1|))) *
        (∫⁻ x, ENNReal.ofReal (S x) ^ p) ^ (1 / q) := by
    calc ∫⁻ x, ENNReal.ofReal (S x) ^ p
        = ∫⁻ x, ∑ i ∈ s, ENNReal.ofReal (shiftedAverage σ (g i) x (k i)) * ‖H i x‖ₑ :=
          lintegral_congr fun x => hid1 x
      _ ≤ _ := hD
      _ ≤ _ := hHol
      _ ≤ eLpNorm (fun x => √(∑ i ∈ s, ‖g i x‖ ^ 2)) (ENNReal.ofReal p) volume *
          (ENNReal.ofReal (C * Real.log (2 + |-σ - 1|)) *
            eLpNorm (fun x => √(∑ i ∈ s, ‖H i x‖ ^ 2)) (ENNReal.ofReal q) volume) := by
          gcongr
      _ = _ := by rw [hHS, mul_assoc]
  have hfin := shiftedSq_rpow_le_of_le_mul_rpow (α := 1 / p) (θ := 1 / q) (by positivity)
    (by have := hpq.symm.pos; positivity)
    (by rw [one_div, one_div]; exact hpq.inv_add_inv_eq_one) hX hmain
  rw [hXeq]
  refine hfin.trans (le_of_le_of_eq (mul_le_mul_right (ENNReal.ofReal_le_ofReal ?_) _)
    (mul_comm _ _))
  have h1 := mul_le_mul_of_nonneg_left (log_two_add_abs_neg_sub_one_le σ) hC.le
  linarith

/-- **Vector-valued single-scale shifted averages.** For `1 < p < ∞` there is `C_p > 0` such
that for every shift `σ`, every finite family of scales `kᵢ ∈ ℤ` (`i ∈ s`) and all bounded
measurable `gᵢ : ℝ → ℂ`,
`‖(∑ᵢ |A_{σ,kᵢ} gᵢ|²)^{1/2}‖_p ≤ C_p log (2 + |σ|) ‖(∑ᵢ |gᵢ|²)^{1/2}‖_p`,
where `A_{σ,k} g(x) = 2^{-k} ∫_{[σ 2^k, (σ+1) 2^k]} |g(x+t)| dt` (`shiftedAverage`). -/
theorem exists_eLpNorm_sqrt_sum_sq_shiftedAverage_le {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 < C ∧ ∀ {ι : Type*} (s : Finset ι) (σ : ℝ) (k : ι → ℤ) (g : ι → ℝ → ℂ),
      (∀ i, Measurable (g i)) → ∀ a : ℝ, (∀ i x, ‖g i x‖ ≤ a) →
      eLpNorm (fun x => √(∑ i ∈ s, shiftedAverage σ (g i) x (k i) ^ 2)) (ENNReal.ofReal p)
        volume ≤ ENNReal.ofReal (C * Real.log (2 + |σ|)) *
          eLpNorm (fun x => √(∑ i ∈ s, ‖g i x‖ ^ 2)) (ENNReal.ofReal p) volume := by
  rcases le_or_gt 2 p with hp2 | hp2
  · exact exists_eLpNorm_sqrt_sum_sq_shiftedAverage_le_of_two_le hp2
  have hpq := Real.HolderConjugate.conjExponent hp
  have hq2 : 2 ≤ p.conjExponent := by
    rw [Real.conjExponent, le_div_iff₀ (by linarith)]; linarith
  obtain ⟨C, hC, hCq⟩ := exists_eLpNorm_sqrt_sum_sq_shiftedAverage_le_of_two_le hq2
  exact ⟨2 * C, by positivity, fun s σ k g hg a hga =>
    eLpNorm_sqrt_sum_sq_shiftedAverage_le_of_lt_two hpq hp2 hC
      (fun s σ k g hg a hga => hCq s σ k g hg a hga) s σ k hg hga⟩

end

