/-- The midpoint `x + (σ + 1/2) 2^k` of the shifted interval attached to `a = (x, k)`. -/
def shiftedCenter (σ : ℝ) (a : ℝ × ℤ) : ℝ := a.1 + (σ + 1 / 2) * 2 ^ a.2

/-- The half-length `2^k / 2` of the shifted interval attached to `a = (x, k)`. -/
def shiftedRadius (a : ℝ × ℤ) : ℝ := 2 ^ a.2 / 2

/-- The ball with centre `shiftedCenter σ a` and radius `shiftedRadius a` is the open shifted
interval `x + (σ 2^k, (σ+1) 2^k)`. -/
theorem shiftedBall_eq (σ : ℝ) (a : ℝ × ℤ) :
    Metric.ball (shiftedCenter σ a) (shiftedRadius a) =
      Set.Ioo (a.1 + σ * 2 ^ a.2) (a.1 + (σ + 1) * 2 ^ a.2) := by
  rw [Real.ball_eq_Ioo]
  congr 1 <;> simp only [shiftedCenter, shiftedRadius] <;> ring

/-- The shifted ball attached to `(x, k)` has measure `2^k`. -/
theorem volume_shiftedBall (σ : ℝ) (a : ℝ × ℤ) :
    volume (Metric.ball (shiftedCenter σ a) (shiftedRadius a)) = ENNReal.ofReal (2 ^ a.2) := by
  rw [Real.volume_ball]
  congr 1
  simp only [shiftedRadius]
  ring

/-- If a single-scale average exceeds `s`, then the corresponding integral of `|g|` over the
open shifted interval exceeds `s 2^k`. -/
theorem shiftedAverage_lt_lintegral (σ : ℝ) {g : ℝ → ℂ} (hg : Measurable g) {x s : ℝ} {k : ℤ}
