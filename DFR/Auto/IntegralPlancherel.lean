      ∫ x, inner ℂ ((hf2.toLp f : Lp ℂ 2 (volume : Measure V)) x)
        ((hg2.toLp g : Lp ℂ 2 (volume : Measure V)) x) := by
    apply integral_congr_ae
    filter_upwards [hf2.coeFn_toLp, hg2.coeFn_toLp] with x hf hg
    rw [hf, hg, RCLike.inner_apply']
