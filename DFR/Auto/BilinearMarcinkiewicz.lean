/-- The weak `L^r` quasinorm `sup_{τ > 0} τ ρ{|v| > τ}^{1/r}`. -/
def weakLpNorm {Z : Type*} [MeasurableSpace Z] (ρ : Measure Z) (r : ℝ) (v : Z → ℂ) : ENNReal :=
  ⨆ (τ : ℝ) (_ : 0 < τ), ENNReal.ofReal τ * ρ {z | τ < ‖v z‖} ^ (1 / r)

/-- Corner offsets `±δ`. -/
def cornerShift (δ : ℝ) (b : Bool) : ℝ := if b then δ else -δ

