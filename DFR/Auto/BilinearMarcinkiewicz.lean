    (huv : u + v = 1) : P ^ u * Q ^ v ≤ P + Q := by
  calc P ^ u * Q ^ v ≤ max P Q ^ u * max P Q ^ v :=
        mul_le_mul' (ENNReal.rpow_le_rpow (le_max_left _ _) hu)
          (ENNReal.rpow_le_rpow (le_max_right _ _) hv)
    _ = max P Q := by rw [← ENNReal.rpow_add_of_nonneg _ _ hu hv, huv, ENNReal.rpow_one]
    _ ≤ P + Q := max_le le_self_add le_add_self

