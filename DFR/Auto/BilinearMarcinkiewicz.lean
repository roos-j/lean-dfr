/-- A crude form of the corner estimate. If `(L/4) m^{s'+t'} ≤ A X^{s'} Y^{t'}` (a weak-type
bound at height `L/4`, with `X`, `Y` the `L^{1/s'}`, `L^{1/t'}` integrals), then
`L^{r-1} m ≤ (4A)^{1/(s'+t')} (L^{r-1-a} X + L^{r-1-b} Y)` whenever `a s' + b t' = 1`. -/
lemma corner_bound {A L s' t' r a b : ℝ} (hA : 0 < A) (hL : 0 < L) (hs' : 0 < s')
    (ht' : 0 < t') (hab : a * s' + b * t' = 1) {m X Y : ℝ≥0∞}
    (h : ENNReal.ofReal (L / 4) * m ^ (s' + t') ≤ ENNReal.ofReal A * X ^ s' * Y ^ t') :
    ENNReal.ofReal (L ^ (r - 1)) * m ≤ ENNReal.ofReal ((4 * A) ^ (s' + t')⁻¹) *
      (ENNReal.ofReal (L ^ (r - 1 - a)) * X + ENNReal.ofReal (L ^ (r - 1 - b)) * Y) := by
  have hσ : 0 < s' + t' := add_pos hs' ht'
  have hσi : 0 ≤ (s' + t')⁻¹ := inv_nonneg.mpr hσ.le
  have hu : 0 ≤ s' / (s' + t') := by positivity
  have hv : 0 ≤ t' / (s' + t') := by positivity
  have huv : s' / (s' + t') + t' / (s' + t') = 1 := by rw [← add_div, div_self hσ.ne']
  have h1 : m ^ (s' + t') ≤ ENNReal.ofReal (4 * A / L) * (X ^ s' * Y ^ t') := by
    have h4 : ENNReal.ofReal (4 / L) * ENNReal.ofReal (L / 4) = 1 := by
      rw [← ENNReal.ofReal_mul (by positivity), div_mul_div_comm, mul_comm 4 L,
        div_self (by positivity), ENNReal.ofReal_one]
    calc m ^ (s' + t') = ENNReal.ofReal (4 / L) * (ENNReal.ofReal (L / 4) * m ^ (s' + t')) := by
          rw [← mul_assoc, h4, one_mul]
      _ ≤ ENNReal.ofReal (4 / L) * (ENNReal.ofReal A * X ^ s' * Y ^ t') := by gcongr
      _ = _ := by
          rw [show 4 * A / L = 4 / L * A by ring, ENNReal.ofReal_mul (by positivity)]
          ring
  have h2 : m ≤ ENNReal.ofReal ((4 * A / L) ^ (s' + t')⁻¹) *
      (X ^ (s' / (s' + t')) * Y ^ (t' / (s' + t'))) := by
    have := ENNReal.rpow_le_rpow h1 hσi
    rwa [ENNReal.rpow_rpow_inv hσ.ne', ENNReal.mul_rpow_of_nonneg _ _ hσi,
      ENNReal.mul_rpow_of_nonneg _ _ hσi, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
      ENNReal.ofReal_rpow_of_nonneg (by positivity) hσi, ← div_eq_mul_inv,
      ← div_eq_mul_inv] at this
  have he : (r - 1 - a) * (s' / (s' + t')) + (r - 1 - b) * (t' / (s' + t')) =
      (r - 1) - (s' + t')⁻¹ := by
    calc _ = (r - 1) * ((s' + t') / (s' + t')) - (a * s' + b * t') / (s' + t') := by ring
      _ = _ := by rw [div_self hσ.ne', hab]; ring
  have h3 : L ^ (r - 1) * (4 * A / L) ^ (s' + t')⁻¹ =
      (4 * A) ^ (s' + t')⁻¹ * ((L ^ (r - 1 - a)) ^ (s' / (s' + t')) *
        (L ^ (r - 1 - b)) ^ (t' / (s' + t'))) := by
    rw [Real.div_rpow (by positivity) hL.le, ← Real.rpow_mul hL.le, ← Real.rpow_mul hL.le,
      ← Real.rpow_add hL, he, Real.rpow_sub hL (r - 1) (s' + t')⁻¹]
    ring
  calc ENNReal.ofReal (L ^ (r - 1)) * m
      ≤ ENNReal.ofReal (L ^ (r - 1)) * (ENNReal.ofReal ((4 * A / L) ^ (s' + t')⁻¹) *
          (X ^ (s' / (s' + t')) * Y ^ (t' / (s' + t')))) := by gcongr
    _ = ENNReal.ofReal ((4 * A) ^ (s' + t')⁻¹) *
          ((ENNReal.ofReal (L ^ (r - 1 - a)) * X) ^ (s' / (s' + t')) *
            (ENNReal.ofReal (L ^ (r - 1 - b)) * Y) ^ (t' / (s' + t'))) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hu, ENNReal.mul_rpow_of_nonneg _ _ hv,
          ENNReal.ofReal_rpow_of_nonneg (by positivity) hu,
          ENNReal.ofReal_rpow_of_nonneg (by positivity) hv, ← mul_assoc,
          ← ENNReal.ofReal_mul (by positivity), h3, ENNReal.ofReal_mul (by positivity),
          ENNReal.ofReal_mul (by positivity)]
        ring
    _ ≤ _ := by gcongr; exact rpow_mul_rpow_le_add _ _ hu hv huv

section SimpleFunctions

variable {X : Type*} [MeasurableSpace X] {μ : Measure X}

/-- The truncation of a simple function at height `h` (large part for `b = true`, small part
for `b = false`). -/
def piece (f : SimpleFunc X ℂ) (h : ℝ) (b : Bool) : SimpleFunc X ℂ := f.map (cut h b)

/-- Pointwise values of a truncation. -/
lemma piece_apply (f : SimpleFunc X ℂ) (h : ℝ) (b : Bool) (x : X) :
    piece f h b x = cut h b (f x) :=
  rfl

/-- The two truncations add up to the simple function. -/
lemma piece_add (f : SimpleFunc X ℂ) (h : ℝ) : piece f h true + piece f h false = f := by
  ext x
  simp [piece_apply, cut_add]

/-- Truncations of a finitely supported simple function are finitely supported. -/
lemma finMeasSupp_piece {f : SimpleFunc X ℂ} (hf : f.FinMeasSupp μ) (h : ℝ) (b : Bool) :
    (piece f h b).FinMeasSupp μ :=
  hf.map (cut_zero h b)

/-- The integral of `φ ∘ f` for a simple function `f` is a finite sum. -/
lemma lintegral_comp_simpleFunc (f : SimpleFunc X ℂ) (φ : ℂ → ℝ≥0∞) :
    ∫⁻ x, φ (f x) ∂μ = ∑ y ∈ f.range, φ y * μ (f ⁻¹' {y}) := by
  rw [← SimpleFunc.map_lintegral, ← SimpleFunc.lintegral_eq_lintegral]
  rfl

/-- Measurability in the parameter of a parametrised integral of a simple function. -/
lemma measurable_lintegral_comp_simpleFunc (f : SimpleFunc X ℂ) {Φ : ℝ → ℂ → ℝ≥0∞}
    (hΦ : ∀ y, Measurable fun l => Φ l y) : Measurable fun l => ∫⁻ x, Φ l (f x) ∂μ := by
  have h : (fun l => ∫⁻ x, Φ l (f x) ∂μ) = fun l => ∑ y ∈ f.range, Φ l y * μ (f ⁻¹' {y}) :=
    funext fun l => lintegral_comp_simpleFunc f (Φ l)
  rw [h]
  exact Finset.measurable_sum _ fun y _ => (hΦ y).mul_const _

/-- Tonelli's theorem for a simple function: the order of integration may be swapped. -/
lemma lintegral_lintegral_simpleFunc_swap {ν : Measure ℝ} (f : SimpleFunc X ℂ) {Φ : ℝ → ℂ → ℝ≥0∞}
    (hΦ : ∀ y, Measurable fun l => Φ l y) :
    ∫⁻ l, ∫⁻ x, Φ l (f x) ∂μ ∂ν = ∫⁻ x, ∫⁻ l, Φ l (f x) ∂ν ∂μ := by
  have h : (fun l => ∫⁻ x, Φ l (f x) ∂μ) = fun l => ∑ y ∈ f.range, Φ l y * μ (f ⁻¹' {y}) :=
    funext fun l => lintegral_comp_simpleFunc f (Φ l)
  rw [h, lintegral_finsetSum _ fun y _ => (hΦ y).mul_const _,
    lintegral_comp_simpleFunc f (fun y => ∫⁻ l, Φ l y ∂ν)]
  exact Finset.sum_congr rfl fun y _ => lintegral_mul_const _ (hΦ y)

/-- Measurability of a truncation in the height parameter. -/
lemma measurable_cut_rpow (κ q : ℝ) (b : Bool) (y : ℂ) :
    Measurable fun l : ℝ => ‖cut (l ^ κ) b y‖ₑ ^ q := by
  have : Measurable fun l : ℝ => cut (l ^ κ) b y := by
    unfold cut
    exact Measurable.ite (measurableSet_le (by fun_prop) measurable_const) measurable_const
      measurable_const
  exact this.enorm.pow_const q

/-- The weighted truncated integral `λ^α ∫ ‖cut_{λ^κ}^b f‖^q dμ`, as a function of `λ`. -/
def pieceIntegral (μ : Measure X) (f : SimpleFunc X ℂ) (κ α q : ℝ) (b : Bool) (l : ℝ) : ℝ≥0∞ :=
  ENNReal.ofReal (l ^ α) * ∫⁻ x, ‖piece f (l ^ κ) b x‖ₑ ^ q ∂μ

/-- The weighted truncated integral is measurable in the height parameter. -/
lemma measurable_pieceIntegral (f : SimpleFunc X ℂ) (κ α q : ℝ) (b : Bool) :
    Measurable (pieceIntegral μ f κ α q b) := by
  unfold pieceIntegral
  simp only [piece_apply]
  exact (by fun_prop : Measurable fun l : ℝ => ENNReal.ofReal (l ^ α)).mul
    (measurable_lintegral_comp_simpleFunc f (Φ := fun l y => ‖cut (l ^ κ) b y‖ₑ ^ q)
      fun y => measurable_cut_rpow κ q b y)

/-- Integrating the weighted truncated integral in `λ` reproduces `∫ ‖f‖^p`. -/
lemma lintegral_pieceIntegral_le (f : SimpleFunc X ℂ) (b : Bool) {κ α q p : ℝ} (hκ : 0 < κ)
    (hα : if b then -1 < α else α < -1) (hq : 0 < q) (hp0 : 0 ≤ p)
    (hp : q + (α + 1) / κ = p) :
    ∫⁻ l in Ioi 0, pieceIntegral μ f κ α q b l ≤
      ENNReal.ofReal (|α + 1|⁻¹) * ∫⁻ x, ‖f x‖ₑ ^ p ∂μ := by
  unfold pieceIntegral
  simp only [piece_apply]
  simp_rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  rw [lintegral_lintegral_simpleFunc_swap f
      (Φ := fun l y => ENNReal.ofReal (l ^ α) * ‖cut (l ^ κ) b y‖ₑ ^ q)
      (fun y => (by fun_prop : Measurable fun l : ℝ => ENNReal.ofReal (l ^ α)).mul
        (measurable_cut_rpow κ q b y))]
  exact lintegral_mono fun x => lintegral_cut_le b hκ hα hq hp0 hp (f x)

/-- The `L^{r}` quasinorm with `r σ = 1` in terms of the integral of `‖f‖^r`. -/
lemma eLpNorm_ofReal_eq {f : X → ℂ} {r σ : ℝ} (hr : 0 < r) (hrσ : r * σ = 1) :
    eLpNorm f (ENNReal.ofReal r) μ = (∫⁻ x, ‖f x‖ₑ ^ r ∂μ) ^ σ := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by simpa using hr) ENNReal.ofReal_ne_top,
    ENNReal.toReal_ofReal hr.le, show 1 / r = σ by field_simp; linarith]

/-- The integral of `‖f‖^r` in terms of the `L^{r}` quasinorm, `r σ = 1`. -/
lemma lintegral_eq_eLpNorm_rpow {f : X → ℂ} {r σ : ℝ} (hr : 0 < r) (hrσ : r * σ = 1) :
    ∫⁻ x, ‖f x‖ₑ ^ r ∂μ = eLpNorm f (ENNReal.ofReal r) μ ^ r := by
  rw [eLpNorm_ofReal_eq hr hrσ, ← ENNReal.rpow_mul, mul_comm, hrσ, ENNReal.rpow_one]

end SimpleFunctions

/-- The shifted exponents `s ± δ` are positive. -/
lemma shift_pos {s δ : ℝ} (hδ : 0 < δ) (hs : δ < s) (i : Bool) : 0 < s + cornerShift δ i := by
  cases i <;> simp [cornerShift] <;> linarith

/-- The exponent `α_i = r - 1 - r s/(s ± δ)` attached to a corner. -/
def cornerAlpha (r s δ : ℝ) (i : Bool) : ℝ := r - 1 - r * s / (s + cornerShift δ i)

/-- `α_i > -1` for the large part and `α_i < -1` for the small part. -/
lemma cornerAlpha_cond {r s δ : ℝ} (hr : 0 < r) (hδ : 0 < δ) (hs : δ < s) (i : Bool) :
    if i then -1 < cornerAlpha r s δ i else cornerAlpha r s δ i < -1 := by
  cases i
  · simp only [cornerAlpha, cornerShift, Bool.false_eq_true, if_false]
    have : r < r * s / (s + -δ) := by
      rw [lt_div_iff₀ (by linarith)]; nlinarith
    linarith
  · simp only [cornerAlpha, cornerShift, if_true]
    have : r * s / (s + δ) < r := by
      rw [div_lt_iff₀ (by linarith)]; nlinarith
    linarith

/-- The exponent identity `p_i + (α_i + 1)/(r s) = p` with `p_i = 1/(s ± δ)`, `p = 1/s`. -/
lemma cornerAlpha_exponent {r s δ : ℝ} (hr : 0 < r) (hδ : 0 < δ) (hs : δ < s) (i : Bool) :
    1 / (s + cornerShift δ i) + (cornerAlpha r s δ i + 1) / (r * s) = 1 / s := by
  have h1 := (shift_pos hδ hs i).ne'
  have h2 : s ≠ 0 := by linarith
  have h3 := hr.ne'
  unfold cornerAlpha
  field_simp
  ring

/-- The constant `(4A)^{1/(s_i + t_j)}` of a corner. -/
def cornerConst (A s t δ : ℝ) (i j : Bool) : ℝ≥0∞ :=
  ENNReal.ofReal ((4 * A) ^ (s + cornerShift δ i + (t + cornerShift δ j))⁻¹)

section Bilinear

variable {X Y Z : Type*} [MeasurableSpace X] [MeasurableSpace Y] [MeasurableSpace Z]
  {μ : Measure X} {ν : Measure Y} {ρ : Measure Z}

/-- Extracting the distribution function bound from a weak quasinorm bound. -/
lemma weak_apply {e : ℝ} {v : Z → ℂ} {W : ℝ≥0∞} (h : weakLpNorm ρ e v ≤ W) {τ : ℝ}
    (hτ : 0 < τ) : ENNReal.ofReal τ * ρ {z | τ < ‖v z‖} ^ (1 / e) ≤ W :=
  le_trans (le_iSup₂ (f := fun τ (_ : 0 < τ) => ENNReal.ofReal τ * ρ {z | τ < ‖v z‖} ^ (1 / e))
    τ hτ) h

/-- The layer-cake formula `∫ ‖v‖^r = r ∫_0^∞ ρ{‖v‖ > λ} λ^{r-1} dλ`. -/
lemma lintegral_enorm_rpow_eq_layercake {v : Z → ℂ} (hv : AEStronglyMeasurable v ρ) {r : ℝ}
    (hr : 0 < r) : ∫⁻ z, ‖v z‖ₑ ^ r ∂ρ =
      ENNReal.ofReal r * ∫⁻ l in Ioi 0, ρ {z | l < ‖v z‖} * ENNReal.ofReal (l ^ (r - 1)) := by
  rw [← lintegral_rpow_eq_lintegral_meas_lt_mul ρ (ae_of_all _ fun z => norm_nonneg (v z))
    hv.norm.aemeasurable hr]
  refine lintegral_congr fun z => ?_
  rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hr.le]

/-- A function with vanishing weak quasinorm has vanishing `L^r` quasinorm. -/
lemma eLpNorm_eq_zero_of_weakLpNorm_le_zero {v : Z → ℂ} (hv : AEStronglyMeasurable v ρ)
    {e : ℝ} (he : 0 < e) (h : weakLpNorm ρ e v ≤ 0) {r : ℝ} (hr : 0 < r) :
    eLpNorm v (ENNReal.ofReal r) ρ = 0 := by
  have hm : ∀ l ∈ Ioi (0 : ℝ), ρ {z | l < ‖v z‖} = 0 := by
    intro l hl
    have h1 := weak_apply h hl
    rw [nonpos_iff_eq_zero, mul_eq_zero] at h1
    rcases h1 with h1 | h1
    · exact absurd h1 (by simpa using hl)
    · exact (ENNReal.rpow_eq_zero_iff_of_pos (by positivity)).mp h1
  rw [eLpNorm_ofReal_eq hr (mul_inv_cancel₀ hr.ne'), lintegral_enorm_rpow_eq_layercake hv hr,
    setLIntegral_congr_fun measurableSet_Ioi (g := fun _ => 0)
      (fun l hl => by simp only [hm l hl, zero_mul]),
    lintegral_zero, mul_zero, ENNReal.zero_rpow_of_pos (by positivity)]

/-- If `‖∑_{i,j} v_{ij}‖ > λ` then some `‖v_{ij}‖ > λ/4`. -/
lemma measure_lt_norm_sum_le (v : Bool → Bool → Z → ℂ) (l : ℝ) :
    ρ {z | l < ‖∑ i, ∑ j, v i j z‖} ≤ ∑ i, ∑ j, ρ {z | l / 4 < ‖v i j z‖} := by
  calc ρ {z | l < ‖∑ i, ∑ j, v i j z‖} ≤ ρ (⋃ i, ⋃ j, {z | l / 4 < ‖v i j z‖}) := by
        refine measure_mono fun z hz => ?_
        by_contra hcon
        simp only [mem_iUnion, mem_setOf_eq, not_exists, not_lt] at hcon hz
        simp only [Fintype.sum_bool] at hz
        have h1 := norm_add_le (v true true z + v true false z)
          (v false true z + v false false z)
        have h2 := norm_add_le (v true true z) (v true false z)
        have h3 := norm_add_le (v false true z) (v false false z)
        linarith [hcon true true, hcon true false, hcon false true, hcon false false]
    _ ≤ ∑ i, ρ (⋃ j, {z | l / 4 < ‖v i j z‖}) := measure_iUnion_fintype_le _ _
    _ ≤ ∑ i, ∑ j, ρ {z | l / 4 < ‖v i j z‖} :=
        Finset.sum_le_sum fun i _ => measure_iUnion_fintype_le _ _

omit [MeasurableSpace Z] in
/-- Bilinear decomposition along the truncations. -/
lemma bilinear_apply_eq_sum (T : SimpleFunc X ℂ →ₗ[ℂ] SimpleFunc Y ℂ →ₗ[ℂ] (Z → ℂ))
    (f : SimpleFunc X ℂ) (g : SimpleFunc Y ℂ) (h h' : ℝ) (z : Z) :
    T f g z = ∑ i, ∑ j, T (piece f h i) (piece g h' j) z := by
  conv_lhs => rw [← piece_add f h, ← piece_add g h']
  simp only [map_add, LinearMap.add_apply, Pi.add_apply, Fintype.sum_bool]
  abel

end Bilinear

section Main

variable {X Y Z : Type*} [MeasurableSpace X] [MeasurableSpace Y] [MeasurableSpace Z]
  {μ : Measure X} {ν : Measure Y} {ρ : Measure Z}

/-- The four-corner estimate of the distribution function at height `λ`, after splitting `f`
at height `λ^{r s}` and `g` at height `λ^{r t}`. -/
lemma distribution_le_corners (T : SimpleFunc X ℂ →ₗ[ℂ] SimpleFunc Y ℂ →ₗ[ℂ] (Z → ℂ))
    {s t δ : ℝ} (hδ : 0 < δ) (hs : δ < s) (ht : δ < t) {A : ℝ} (hA : 0 < A)
    (hw : ∀ (i j : Bool) (f : SimpleFunc X ℂ) (g : SimpleFunc Y ℂ), f.FinMeasSupp μ →
      g.FinMeasSupp ν →
      weakLpNorm ρ (1 / (s + cornerShift δ i + (t + cornerShift δ j))) (T f g) ≤
        ENNReal.ofReal A * eLpNorm (f : X → ℂ) (ENNReal.ofReal (1 / (s + cornerShift δ i))) μ *
          eLpNorm (g : Y → ℂ) (ENNReal.ofReal (1 / (t + cornerShift δ j))) ν)
    {r : ℝ} (hr : r * (s + t) = 1) {f : SimpleFunc X ℂ} {g : SimpleFunc Y ℂ}
    (hf : f.FinMeasSupp μ) (hg : g.FinMeasSupp ν) {l : ℝ} (hl : 0 < l) :
    ENNReal.ofReal (l ^ (r - 1)) * ρ {z | l < ‖T f g z‖} ≤
      ∑ i, ∑ j, cornerConst A s t δ i j *
        (pieceIntegral μ f (r * s) (cornerAlpha r s δ i) (1 / (s + cornerShift δ i)) i l +
          pieceIntegral ν g (r * t) (cornerAlpha r t δ j) (1 / (t + cornerShift δ j)) j l) := by
  simp_rw [bilinear_apply_eq_sum T f g (l ^ (r * s)) (l ^ (r * t))]
  refine (mul_le_mul_right (measure_lt_norm_sum_le _ l) _).trans ?_
  simp_rw [Finset.mul_sum]
  refine Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => ?_
  have hsi := shift_pos hδ hs i
  have htj := shift_pos hδ ht j
  have hweak := weak_apply (hw i j _ _ (finMeasSupp_piece hf (l ^ (r * s)) i)
    (finMeasSupp_piece hg (l ^ (r * t)) j)) (div_pos hl four_pos)
  rw [one_div_one_div, eLpNorm_ofReal_eq (by positivity) (one_div_mul_cancel hsi.ne'),
    eLpNorm_ofReal_eq (by positivity) (one_div_mul_cancel htj.ne')] at hweak
  refine corner_bound (r := r) (a := r * s / (s + cornerShift δ i))
    (b := r * t / (t + cornerShift δ j)) hA hl hsi htj ?_ hweak
  rw [div_mul_cancel₀ _ hsi.ne', div_mul_cancel₀ _ htj.ne', ← mul_add, hr]

/-- The main estimate in normalized form: if `∫ ‖f‖^p ≤ 1` and `∫ ‖g‖^q ≤ 1`, then
`∫ ‖T f g‖^r` is bounded by an explicit constant. -/
lemma lintegral_rpow_le_of_normalized
    (T : SimpleFunc X ℂ →ₗ[ℂ] SimpleFunc Y ℂ →ₗ[ℂ] (Z → ℂ))
    (hTm : ∀ f g, AEStronglyMeasurable (T f g) ρ)
    {s t δ : ℝ} (hδ : 0 < δ) (hs : δ < s) (ht : δ < t) {A : ℝ} (hA : 0 < A)
    (hw : ∀ (i j : Bool) (f : SimpleFunc X ℂ) (g : SimpleFunc Y ℂ), f.FinMeasSupp μ →
      g.FinMeasSupp ν →
      weakLpNorm ρ (1 / (s + cornerShift δ i + (t + cornerShift δ j))) (T f g) ≤
        ENNReal.ofReal A * eLpNorm (f : X → ℂ) (ENNReal.ofReal (1 / (s + cornerShift δ i))) μ *
          eLpNorm (g : Y → ℂ) (ENNReal.ofReal (1 / (t + cornerShift δ j))) ν)
    {r : ℝ} (hr0 : 0 < r) (hr : r * (s + t) = 1) {f : SimpleFunc X ℂ} {g : SimpleFunc Y ℂ}
    (hf : f.FinMeasSupp μ) (hg : g.FinMeasSupp ν)
    (hF : ∫⁻ x, ‖f x‖ₑ ^ (1 / s) ∂μ ≤ 1) (hG : ∫⁻ y, ‖g y‖ₑ ^ (1 / t) ∂ν ≤ 1) :
    ∫⁻ z, ‖T f g z‖ₑ ^ r ∂ρ ≤ ENNReal.ofReal r * ∑ i, ∑ j, cornerConst A s t δ i j *
      (ENNReal.ofReal (|cornerAlpha r s δ i + 1|⁻¹) +
        ENNReal.ofReal (|cornerAlpha r t δ j + 1|⁻¹)) := by
  have hs0 : 0 < s := hδ.trans hs
  have ht0 : 0 < t := hδ.trans ht
  set P : Bool → ℝ → ℝ≥0∞ := fun i =>
    pieceIntegral μ f (r * s) (cornerAlpha r s δ i) (1 / (s + cornerShift δ i)) i with hP
  set Q : Bool → ℝ → ℝ≥0∞ := fun j =>
    pieceIntegral ν g (r * t) (cornerAlpha r t δ j) (1 / (t + cornerShift δ j)) j with hQ
  have hPm : ∀ i, Measurable (P i) := fun i => measurable_pieceIntegral _ _ _ _ _
  have hQm : ∀ j, Measurable (Q j) := fun j => measurable_pieceIntegral _ _ _ _ _
  have hPi : ∀ i, ∫⁻ l in Ioi 0, P i l ≤ ENNReal.ofReal (|cornerAlpha r s δ i + 1|⁻¹) := by
    intro i
    calc ∫⁻ l in Ioi 0, P i l
        ≤ ENNReal.ofReal (|cornerAlpha r s δ i + 1|⁻¹) * ∫⁻ x, ‖f x‖ₑ ^ (1 / s) ∂μ :=
          lintegral_pieceIntegral_le f i (by positivity) (cornerAlpha_cond hr0 hδ hs i)
            (one_div_pos.mpr (shift_pos hδ hs i)) (by positivity)
            (cornerAlpha_exponent hr0 hδ hs i)
      _ ≤ ENNReal.ofReal (|cornerAlpha r s δ i + 1|⁻¹) * 1 := by gcongr
      _ = _ := mul_one _
  have hQi : ∀ j, ∫⁻ l in Ioi 0, Q j l ≤ ENNReal.ofReal (|cornerAlpha r t δ j + 1|⁻¹) := by
    intro j
    calc ∫⁻ l in Ioi 0, Q j l
        ≤ ENNReal.ofReal (|cornerAlpha r t δ j + 1|⁻¹) * ∫⁻ y, ‖g y‖ₑ ^ (1 / t) ∂ν :=
          lintegral_pieceIntegral_le g j (by positivity) (cornerAlpha_cond hr0 hδ ht j)
            (one_div_pos.mpr (shift_pos hδ ht j)) (by positivity)
            (cornerAlpha_exponent hr0 hδ ht j)
      _ ≤ ENNReal.ofReal (|cornerAlpha r t δ j + 1|⁻¹) * 1 := by gcongr
      _ = _ := mul_one _
  rw [lintegral_enorm_rpow_eq_layercake (hTm f g) hr0]
  gcongr
  calc ∫⁻ l in Ioi 0, ρ {z | l < ‖T f g z‖} * ENNReal.ofReal (l ^ (r - 1))
      ≤ ∫⁻ l in Ioi 0, ∑ i, ∑ j, cornerConst A s t δ i j * (P i l + Q j l) := by
        refine setLIntegral_mono' measurableSet_Ioi fun l hl => ?_
        rw [mul_comm]
        exact distribution_le_corners T hδ hs ht hA hw hr hf hg hl
    _ = ∑ i, ∑ j, cornerConst A s t δ i j *
          ((∫⁻ l in Ioi 0, P i l) + ∫⁻ l in Ioi 0, Q j l) := by
        rw [lintegral_finsetSum Finset.univ
          (f := fun i l => ∑ j, cornerConst A s t δ i j * (P i l + Q j l))
          fun i _ => Finset.measurable_sum _ fun j _ => ((hPm i).add (hQm j)).const_mul _]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [lintegral_finsetSum Finset.univ
          (f := fun j l => cornerConst A s t δ i j * (P i l + Q j l))
          fun j _ => ((hPm i).add (hQm j)).const_mul _]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [lintegral_const_mul _ (f := fun l => P i l + Q j l) ((hPm i).add (hQm j)),
          lintegral_add_left (hPm i)]
    _ ≤ _ := Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ =>
        mul_le_mul_right (add_le_add (hPi i) (hQi j)) _

/-- For a simple function, vanishing of one `L^p` quasinorm implies vanishing of all others. -/
lemma eLpNorm_eq_zero_of_eLpNorm_eq_zero {W : Type*} [MeasurableSpace W] {κ : Measure W}
    {f : SimpleFunc W ℂ} {p p' : ℝ≥0∞} (hp : p ≠ 0) (h : eLpNorm (f : W → ℂ) p κ = 0)
    (hp' : p' ≠ 0) : eLpNorm (f : W → ℂ) p' κ = 0 :=
  (eLpNorm_eq_zero_iff f.aestronglyMeasurable hp').mpr
    ((eLpNorm_eq_zero_iff f.aestronglyMeasurable hp).mp h)

/-- The norm of the complex scalar `(F.toReal)⁻¹` is `F⁻¹`. -/
lemma enorm_inv_toReal {F : ℝ≥0∞} (hF0 : F ≠ 0) (hFtop : F ≠ ⊤) :
    ‖(((F.toReal)⁻¹ : ℝ) : ℂ)‖ₑ = F⁻¹ := by
  rw [← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg (by positivity),
    ENNReal.ofReal_inv_of_pos (ENNReal.toReal_pos hF0 hFtop), ENNReal.ofReal_toReal hFtop]

/-- **Bilinear Marcinkiewicz interpolation** with a uniform constant: the constant depends only
on `s, t, δ, A`, not on the operator. -/
theorem bilinear_marcinkiewicz_uniform {s t δ : ℝ} (hδ : 0 < δ) (hs : δ < s) (ht : δ < t)
    {A : ℝ} (hA : 0 < A) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (T : SimpleFunc X ℂ →ₗ[ℂ] SimpleFunc Y ℂ →ₗ[ℂ] (Z → ℂ)),
      (∀ f g, AEStronglyMeasurable (T f g) ρ) →
      (∀ (i j : Bool) (f : SimpleFunc X ℂ) (g : SimpleFunc Y ℂ), f.FinMeasSupp μ →
        g.FinMeasSupp ν →
        weakLpNorm ρ (1 / (s + cornerShift δ i + (t + cornerShift δ j))) (T f g) ≤
          ENNReal.ofReal A * eLpNorm (f : X → ℂ) (ENNReal.ofReal (1 / (s + cornerShift δ i))) μ *
            eLpNorm (g : Y → ℂ) (ENNReal.ofReal (1 / (t + cornerShift δ j))) ν) →
      ∀ (f : SimpleFunc X ℂ) (g : SimpleFunc Y ℂ), f.FinMeasSupp μ → g.FinMeasSupp ν →
        eLpNorm (T f g) (ENNReal.ofReal (1 / (s + t))) ρ ≤
          ENNReal.ofReal C * eLpNorm (f : X → ℂ) (ENNReal.ofReal (1 / s)) μ *
            eLpNorm (g : Y → ℂ) (ENNReal.ofReal (1 / t)) ν := by
  have hs0 : 0 < s := hδ.trans hs
  have ht0 : 0 < t := hδ.trans ht
  have hst : 0 < s + t := add_pos hs0 ht0
  have hr0 : 0 < 1 / (s + t) := one_div_pos.mpr hst
  have hr : 1 / (s + t) * (s + t) = 1 := one_div_mul_cancel hst.ne'
  set B : ℝ≥0∞ := ENNReal.ofReal (1 / (s + t)) * ∑ i, ∑ j, cornerConst A s t δ i j *
    (ENNReal.ofReal (|cornerAlpha (1 / (s + t)) s δ i + 1|⁻¹) +
      ENNReal.ofReal (|cornerAlpha (1 / (s + t)) t δ j + 1|⁻¹)) with hB
  have hBtop : B ≠ ⊤ :=
    ENNReal.mul_ne_top ENNReal.ofReal_ne_top (ENNReal.sum_ne_top.mpr fun i _ =>
      ENNReal.sum_ne_top.mpr fun j _ => ENNReal.mul_ne_top ENNReal.ofReal_ne_top
        (ENNReal.add_ne_top.mpr ⟨ENNReal.ofReal_ne_top, ENNReal.ofReal_ne_top⟩))
  have hBst : B ^ (s + t) ≠ ⊤ := ENNReal.rpow_ne_top_of_nonneg hst.le hBtop
  refine ⟨(B ^ (s + t)).toReal, ENNReal.toReal_nonneg, fun T hTm hw f g hf hg => ?_⟩
  rw [ENNReal.ofReal_toReal hBst]
  set F := eLpNorm (f : X → ℂ) (ENNReal.ofReal (1 / s)) μ with hFdef
  set G := eLpNorm (g : Y → ℂ) (ENNReal.ofReal (1 / t)) ν with hGdef
  by_cases hF0 : F = 0
  · have h0 := hw true true f g hf hg
    rw [eLpNorm_eq_zero_of_eLpNorm_eq_zero (by simpa using hs0) hF0
      (by simpa using shift_pos hδ hs true), mul_zero,
      zero_mul] at h0
    rw [eLpNorm_eq_zero_of_weakLpNorm_le_zero (hTm f g)
      (one_div_pos.mpr (add_pos (shift_pos hδ hs true) (shift_pos hδ ht true))) h0 hr0]
    exact zero_le
  by_cases hG0 : G = 0
  · have h0 := hw true true f g hf hg
    rw [eLpNorm_eq_zero_of_eLpNorm_eq_zero (by simpa using ht0) hG0
      (by simpa using shift_pos hδ ht true), mul_zero] at h0
    rw [eLpNorm_eq_zero_of_weakLpNorm_le_zero (hTm f g)
      (one_div_pos.mpr (add_pos (shift_pos hδ hs true) (shift_pos hδ ht true))) h0 hr0]
    exact zero_le
  have hFtop : F ≠ ⊤ :=
    ((SimpleFunc.memLp_iff_finMeasSupp (by simpa using hs0) ENNReal.ofReal_ne_top).mpr
      hf).eLpNorm_ne_top
  have hGtop : G ≠ ⊤ :=
    ((SimpleFunc.memLp_iff_finMeasSupp (by simpa using ht0) ENNReal.ofReal_ne_top).mpr
      hg).eLpNorm_ne_top
  set c : ℂ := (((F.toReal)⁻¹ : ℝ) : ℂ) with hc
  set d : ℂ := (((G.toReal)⁻¹ : ℝ) : ℂ) with hd
  have hcn : ‖c‖ₑ = F⁻¹ := enorm_inv_toReal hF0 hFtop
  have hdn : ‖d‖ₑ = G⁻¹ := enorm_inv_toReal hG0 hGtop
  have hf' : (c • f).FinMeasSupp μ := hf.map (smul_zero c)
  have hg' : (d • g).FinMeasSupp ν := hg.map (smul_zero d)
  have hF' : ∫⁻ x, ‖(c • f) x‖ₑ ^ (1 / s) ∂μ ≤ 1 := by
    rw [lintegral_eq_eLpNorm_rpow (f := ⇑(c • f)) (one_div_pos.mpr hs0)
      (one_div_mul_cancel hs0.ne'), SimpleFunc.coe_smul, eLpNorm_const_smul, hcn, ← hFdef,
      ENNReal.inv_mul_cancel hF0 hFtop, ENNReal.one_rpow]
  have hG' : ∫⁻ y, ‖(d • g) y‖ₑ ^ (1 / t) ∂ν ≤ 1 := by
    rw [lintegral_eq_eLpNorm_rpow (f := ⇑(d • g)) (one_div_pos.mpr ht0)
      (one_div_mul_cancel ht0.ne'), SimpleFunc.coe_smul, eLpNorm_const_smul, hdn, ← hGdef,
      ENNReal.inv_mul_cancel hG0 hGtop, ENNReal.one_rpow]
  have hmain := lintegral_rpow_le_of_normalized T hTm hδ hs ht hA hw hr0 hr hf' hg' hF' hG'
  rw [← hB] at hmain
  have hT : (T (c • f) (d • g) : Z → ℂ) = c • d • T f g := by
    rw [map_smul (T (c • f)) d g, map_smul T c f, LinearMap.smul_apply, smul_comm]
  have hE : F⁻¹ * (G⁻¹ * eLpNorm (T f g) (ENNReal.ofReal (1 / (s + t))) ρ) ≤ B ^ (s + t) := by
    rw [← hcn, ← hdn, ← eLpNorm_const_smul, ← eLpNorm_const_smul, ← hT,
      eLpNorm_ofReal_eq hr0 hr]
    exact ENNReal.rpow_le_rpow hmain hst.le
  calc eLpNorm (T f g) (ENNReal.ofReal (1 / (s + t))) ρ
      = (F * F⁻¹) * (G * G⁻¹) * eLpNorm (T f g) (ENNReal.ofReal (1 / (s + t))) ρ := by
        rw [ENNReal.mul_inv_cancel hF0 hFtop, ENNReal.mul_inv_cancel hG0 hGtop, one_mul,
          one_mul]
    _ = F * G * (F⁻¹ * (G⁻¹ * eLpNorm (T f g) (ENNReal.ofReal (1 / (s + t))) ρ)) := by ring
    _ ≤ F * G * B ^ (s + t) := by gcongr
    _ = B ^ (s + t) * F * G := by ring

/-- **Bilinear Marcinkiewicz interpolation** with quasi-Banach target. Weak-type bounds at the
four corners `(s ± δ, t ± δ)` of reciprocal exponents imply the strong-type bound
`‖T f g‖_{1/(s+t)} ≤ C ‖f‖_{1/s} ‖g‖_{1/t}` for simple functions of finite measure support. -/
theorem bilinear_marcinkiewicz
    (T : SimpleFunc X ℂ →ₗ[ℂ] SimpleFunc Y ℂ →ₗ[ℂ] (Z → ℂ))
    (hTm : ∀ f g, AEStronglyMeasurable (T f g) ρ)
    {s t δ : ℝ} (hδ : 0 < δ) (hs : δ < s) (ht : δ < t) {A : ℝ} (hA : 0 < A)
    (hw : ∀ (i j : Bool) (f : SimpleFunc X ℂ) (g : SimpleFunc Y ℂ), f.FinMeasSupp μ →
      g.FinMeasSupp ν →
      weakLpNorm ρ (1 / (s + cornerShift δ i + (t + cornerShift δ j))) (T f g) ≤
        ENNReal.ofReal A * eLpNorm (f : X → ℂ) (ENNReal.ofReal (1 / (s + cornerShift δ i))) μ *
          eLpNorm (g : Y → ℂ) (ENNReal.ofReal (1 / (t + cornerShift δ j))) ν) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (f : SimpleFunc X ℂ) (g : SimpleFunc Y ℂ), f.FinMeasSupp μ →
      g.FinMeasSupp ν →
      eLpNorm (T f g) (ENNReal.ofReal (1 / (s + t))) ρ ≤
        ENNReal.ofReal C * eLpNorm (f : X → ℂ) (ENNReal.ofReal (1 / s)) μ *
          eLpNorm (g : Y → ℂ) (ENNReal.ofReal (1 / t)) ν := by
  obtain ⟨C, hC, h⟩ := bilinear_marcinkiewicz_uniform (μ := μ) (ν := ν) (ρ := ρ) hδ hs ht hA
  exact ⟨C, hC, h T hTm hw⟩
end Main

end BilMarc

export BilMarc (bilinear_marcinkiewicz bilinear_marcinkiewicz_uniform)

