/-- Truncation of a complex number at height `h`: the large part (`b = true`) keeps `y` when
`h ≤ ‖y‖`, the small part (`b = false`) keeps `y` when `‖y‖ < h`. -/
def cut (h : ℝ) (b : Bool) (y : ℂ) : ℂ :=
  if h ≤ ‖y‖ then (if b then y else 0) else (if b then 0 else y)

/-- Truncations vanish at zero. -/
lemma cut_zero (h : ℝ) (b : Bool) : cut h b 0 = 0 := by
  cases b <;> simp [cut]

/-- The large and the small part add up to the original number. -/
lemma cut_add (h : ℝ) (y : ℂ) : cut h true y + cut h false y = y := by
  by_cases h' : h ≤ ‖y‖ <;> simp [cut, h']

/-- A crude weighted AM-GM inequality: `P^u Q^v ≤ P + Q` when `u, v ≥ 0` and `u + v = 1`. -/
