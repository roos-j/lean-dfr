/-- Hirschman's lemma for a function that is merely **bounded** on the closed strip.  All four
integrability hypotheses of `Auto.norm_le_geom_mean_strip_zero` and its growth hypothesis follow
from the bound, the former because the harmonic densities and `1 / cosh (π t)` are integrable. -/
theorem norm_le_geom_mean_strip_bdd {H : ℂ → ℂ} {θ s C : ℝ}
    (hθ : θ ∈ Ioo (0 : ℝ) 1) (hs : 0 < s)
    (hHc : ContinuousOn H {z : ℂ | z.re ∈ Icc (0 : ℝ) 1})
    (hHd : DifferentiableOn ℂ H {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1})
    (hC : ∀ z : ℂ, z.re ∈ Icc (0 : ℝ) 1 → ‖H z‖ ≤ C) :
    ‖H (θ : ℂ)‖
      ≤ (∫ t : ℝ, ‖H ((t : ℂ) * Complex.I)‖ ^ s * (poissonStrip θ 1 t / (1 - θ)))
          ^ ((1 - θ) / s)
        * (∫ t : ℝ, ‖H (1 + (t : ℂ) * Complex.I)‖ ^ s * (poissonStrip θ (-1) t / θ))
          ^ (θ / s) := by
  obtain ⟨hθ0, hθ1⟩ := hθ
  have h1θ : (0 : ℝ) < 1 - θ := by linarith
  have hmemL : ∀ t : ℝ, ((t : ℂ) * Complex.I) ∈ {z : ℂ | z.re ∈ Icc (0 : ℝ) 1} := by
    intro t; simp [Set.mem_Icc]
  have hmemR : ∀ t : ℝ, ((1 : ℂ) + (t : ℂ) * Complex.I) ∈ {z : ℂ | z.re ∈ Icc (0 : ℝ) 1} := by
    intro t; simp [Set.mem_Icc]
  have hF₀c : Continuous fun t : ℝ => ‖H ((t : ℂ) * Complex.I)‖ :=
    (hHc.comp_continuous (by fun_prop) hmemL).norm
  have hF₁c : Continuous fun t : ℝ => ‖H ((1 : ℂ) + (t : ℂ) * Complex.I)‖ :=
    (hHc.comp_continuous (by fun_prop) hmemR).norm
  set D : ℝ := max C 1 with hDdef
  have hD1 : (1 : ℝ) ≤ D := le_max_right _ _
  have hD0 : (0 : ℝ) < D := lt_of_lt_of_le one_pos hD1
  have hCD : ∀ z : ℂ, z.re ∈ Icc (0 : ℝ) 1 → ‖H z‖ ≤ D := fun z hz =>
    (hC z hz).trans (le_max_left _ _)
  have hgrow : ∀ z : ℂ, z.re ∈ Ioo (0 : ℝ) 1 →
      ‖H z‖ ≤ Real.exp (Real.log D * Real.exp (0 * |z.im|)) := by
    intro z hz
    rw [zero_mul, Real.exp_zero, mul_one, Real.exp_log hD0]
    exact hCD z ⟨hz.1.le, hz.2.le⟩
  have hlog : ∀ F : ℝ → ℝ, Continuous F → (∀ t, 0 ≤ F t) → (∀ t, F t ≤ D) →
      Integrable fun t : ℝ => |Real.log (F t + 1)| / Real.cosh (π * t) := by
    intro F hFc hF0 hFD
    refine Integrable.mono' (integrable_inv_cosh.const_mul (Real.log (D + 1))) ?_ ?_
    · refine (Continuous.div ?_ (by fun_prop) fun t => (Real.cosh_pos _).ne').aestronglyMeasurable
      refine continuous_abs.comp (continuous_iff_continuousAt.mpr fun t => ?_)
      exact ((hFc.add continuous_const).continuousAt).log
        (by linarith [hF0 t] : (0 : ℝ) < F t + 1).ne'
    · filter_upwards with t
      have hCt : (0 : ℝ) < Real.cosh (π * t) := Real.cosh_pos _
      have hpos : (0 : ℝ) ≤ Real.log (F t + 1) := Real.log_nonneg (by linarith [hF0 t])
      have hle : Real.log (F t + 1) ≤ Real.log (D + 1) :=
        Real.log_le_log (by linarith [hF0 t]) (by linarith [hFD t])
      rw [Real.norm_eq_abs, abs_of_nonneg (by positivity), abs_of_nonneg hpos, mul_one_div]
      exact (div_le_div_iff_of_pos_right hCt).mpr hle
  have hpow : ∀ F : ℝ → ℝ, Continuous F → (∀ t, 0 ≤ F t) → (∀ t, F t ≤ D) →
      ∀ w : ℝ → ℝ, Continuous w → (∀ t, 0 ≤ w t) → Integrable w →
      Integrable fun t : ℝ => (F t + 1) ^ s * w t := by
    intro F hFc hF0 hFD w hwc hw0 hwi
    refine Integrable.mono' (hwi.const_mul ((D + 1) ^ s)) ?_ ?_
    · refine (Continuous.mul ?_ hwc).aestronglyMeasurable
      refine continuous_iff_continuousAt.mpr fun t => ?_
      exact (Real.continuousAt_rpow_const _ _ (Or.inr hs.le)).comp
        ((hFc.add continuous_const).continuousAt)
    · filter_upwards with t
      have h1 : (0 : ℝ) ≤ (F t + 1) ^ s := Real.rpow_nonneg (by linarith [hF0 t]) s
      rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg h1 (hw0 t))]
      exact mul_le_mul_of_nonneg_right
        (Real.rpow_le_rpow (by linarith [hF0 t]) (by linarith [hFD t]) hs.le) (hw0 t)
  have hw₀c : Continuous fun t : ℝ => poissonStrip θ 1 t / (1 - θ) :=
    (continuous_poissonStrip ⟨hθ0, hθ1⟩ (by norm_num : |(1 : ℝ)| ≤ 1)).div_const _
  have hw₁c : Continuous fun t : ℝ => poissonStrip θ (-1) t / θ :=
    (continuous_poissonStrip ⟨hθ0, hθ1⟩ (by norm_num : |(-1 : ℝ)| ≤ 1)).div_const _
  have hw₀0 : ∀ t : ℝ, 0 ≤ poissonStrip θ 1 t / (1 - θ) := fun t => by
    have h := (poissonStrip_pos ⟨hθ0, hθ1⟩ (by norm_num : |(1 : ℝ)| ≤ 1) t).le
