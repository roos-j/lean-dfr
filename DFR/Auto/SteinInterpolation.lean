    (integrable_poissonStrip ⟨hθ0, hθ1⟩ (by norm_num : |(-1 : ℝ)| ≤ 1)).div_const _
  exact norm_le_geom_mean_strip_zero ⟨hθ0, hθ1⟩ hs hHc hHd le_rfl Real.pi_pos hgrow
    (hlog _ hF₀c (fun t => norm_nonneg _) (fun t => hCD _ (hmemL t)))
    (hlog _ hF₁c (fun t => norm_nonneg _) (fun t => hCD _ (hmemR t)))
    (hpow _ hF₀c (fun t => norm_nonneg _) (fun t => hCD _ (hmemL t)) _ hw₀c hw₀0 hw₀i)
    (hpow _ hF₁c (fun t => norm_nonneg _) (fun t => hCD _ (hmemR t)) _ hw₁c hw₁0 hw₁i)


/-! ### Auxiliary integrability and conversion lemmas -/

/-- A bounded continuous function raised to a positive power, against an integrable weight. -/
theorem integrable_rpow_mul_weight {F w : ℝ → ℝ} {s D : ℝ} (hs : 0 < s)
    (hFc : Continuous F) (hF0 : ∀ t, 0 ≤ F t) (hFD : ∀ t, F t ≤ D)
    (hwc : Continuous w) (hw0 : ∀ t, 0 ≤ w t) (hwi : Integrable w) :
    Integrable fun t : ℝ => F t ^ s * w t := by
  refine Integrable.mono' (hwi.const_mul (D ^ s)) ?_ ?_
  · refine (Continuous.mul ?_ hwc).aestronglyMeasurable
    refine continuous_iff_continuousAt.mpr fun t => ?_
    exact (Real.continuousAt_rpow_const _ _ (Or.inr hs.le)).comp hFc.continuousAt
  · filter_upwards with t
    have h1 : (0 : ℝ) ≤ F t ^ s := Real.rpow_nonneg (hF0 t) s
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg h1 (hw0 t))]
    exact mul_le_mul_of_nonneg_right (Real.rpow_le_rpow (hF0 t) (hFD t) hs.le) (hw0 t)

/-- The `ℝ≥0∞`-valued form of a weighted power-mean integral. -/
theorem ofReal_integral_rpow_mul {F w : ℝ → ℝ} {s : ℝ} (hs : 0 ≤ s)
    (hF0 : ∀ t, 0 ≤ F t) (hw0 : ∀ t, 0 ≤ w t)
    (h : Integrable fun t : ℝ => F t ^ s * w t) :
    ENNReal.ofReal (∫ t : ℝ, F t ^ s * w t)
      = ∫⁻ t : ℝ, ENNReal.ofReal (F t) ^ s * ENNReal.ofReal (w t) := by
  rw [ofReal_integral_eq_lintegral_ofReal h
    (Filter.Eventually.of_forall fun t => mul_nonneg (Real.rpow_nonneg (hF0 t) s) (hw0 t))]
  refine lintegral_congr fun t => ?_
  rw [ENNReal.ofReal_mul (Real.rpow_nonneg (hF0 t) s), ENNReal.ofReal_rpow_of_nonneg (hF0 t) hs]

/-! ### The normalized harmonic measures as densities in `ℝ≥0∞` -/

/-- The normalized harmonic measure carried by the edge `re z = 0`, as a density. -/
noncomputable def hmLeft (θ t : ℝ) : ℝ≥0∞ := ENNReal.ofReal (poissonStrip θ 1 t / (1 - θ))

/-- The normalized harmonic measure carried by the edge `re z = 1`, as a density. -/
noncomputable def hmRight (θ t : ℝ) : ℝ≥0∞ := ENNReal.ofReal (poissonStrip θ (-1) t / θ)

theorem hmLeft_ne_top (θ t : ℝ) : hmLeft θ t ≠ ⊤ := ENNReal.ofReal_ne_top

theorem hmRight_ne_top (θ t : ℝ) : hmRight θ t ≠ ⊤ := ENNReal.ofReal_ne_top

theorem measurable_hmLeft {θ : ℝ} (hθ : θ ∈ Ioo (0 : ℝ) 1) : Measurable (hmLeft θ) :=
  ENNReal.measurable_ofReal.comp
    ((continuous_poissonStrip hθ (by norm_num : |(1 : ℝ)| ≤ 1)).div_const _).measurable

theorem measurable_hmRight {θ : ℝ} (hθ : θ ∈ Ioo (0 : ℝ) 1) : Measurable (hmRight θ) :=
  ENNReal.measurable_ofReal.comp
    ((continuous_poissonStrip hθ (by norm_num : |(-1 : ℝ)| ≤ 1)).div_const _).measurable

/-- Both normalized harmonic measures are probability densities. -/
theorem lintegral_hmLeft {θ : ℝ} (hθ : θ ∈ Ioo (0 : ℝ) 1) : ∫⁻ t : ℝ, hmLeft θ t = 1 := by
  have h1θ : (0 : ℝ) < 1 - θ := by linarith [hθ.2]
  have hi : Integrable fun t : ℝ => poissonStrip θ 1 t / (1 - θ) :=
    (integrable_poissonStrip hθ (by norm_num : |(1 : ℝ)| ≤ 1)).div_const _
  have h0 : 0 ≤ᵐ[volume] fun t : ℝ => poissonStrip θ 1 t / (1 - θ) :=
    Filter.Eventually.of_forall fun t =>
      (div_pos (poissonStrip_pos hθ (by norm_num : |(1 : ℝ)| ≤ 1) t) h1θ).le
  simp only [hmLeft]
  rw [← ofReal_integral_eq_lintegral_ofReal hi h0, integral_div, integral_poissonStrip_one hθ,
    div_self h1θ.ne', ENNReal.ofReal_one]

theorem lintegral_hmRight {θ : ℝ} (hθ : θ ∈ Ioo (0 : ℝ) 1) : ∫⁻ t : ℝ, hmRight θ t = 1 := by
  have hθ0 : (0 : ℝ) < θ := hθ.1
  have hi : Integrable fun t : ℝ => poissonStrip θ (-1) t / θ :=
    (integrable_poissonStrip hθ (by norm_num : |(-1 : ℝ)| ≤ 1)).div_const _
  have h0 : 0 ≤ᵐ[volume] fun t : ℝ => poissonStrip θ (-1) t / θ :=
    Filter.Eventually.of_forall fun t =>
      (div_pos (poissonStrip_pos hθ (by norm_num : |(-1 : ℝ)| ≤ 1) t) hθ0).le
  simp only [hmRight]
  rw [← ofReal_integral_eq_lintegral_ofReal hi h0, integral_div, integral_poissonStrip_neg_one hθ,
    div_self hθ0.ne', ENNReal.ofReal_one]

/-! ### The scalar inequality in `ℝ≥0∞` -/

/-- Hirschman's lemma for a bounded family, stated with extended nonnegative reals and the two
normalized harmonic measures. -/
theorem enorm_le_geom_mean_strip {H : ℂ → ℂ} {θ s C : ℝ}
    (hθ : θ ∈ Ioo (0 : ℝ) 1) (hs : 0 < s)
    (hHc : ContinuousOn H {z : ℂ | z.re ∈ Icc (0 : ℝ) 1})
    (hHd : DifferentiableOn ℂ H {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1})
    (hC : ∀ z : ℂ, z.re ∈ Icc (0 : ℝ) 1 → ‖H z‖ ≤ C) :
    ‖H (θ : ℂ)‖ₑ
      ≤ (∫⁻ t : ℝ, ‖H ((t : ℂ) * Complex.I)‖ₑ ^ s * hmLeft θ t) ^ ((1 - θ) / s)
        * (∫⁻ t : ℝ, ‖H (1 + (t : ℂ) * Complex.I)‖ₑ ^ s * hmRight θ t) ^ (θ / s) := by
  obtain ⟨hθ0, hθ1⟩ := hθ
  have h1θ : (0 : ℝ) < 1 - θ := by linarith
  have hmemL : ∀ t : ℝ, ((t : ℂ) * Complex.I) ∈ {z : ℂ | z.re ∈ Icc (0 : ℝ) 1} := by
    intro t; simp [Set.mem_Icc]
  have hmemR : ∀ t : ℝ, ((1 : ℂ) + (t : ℂ) * Complex.I) ∈ {z : ℂ | z.re ∈ Icc (0 : ℝ) 1} := by
    intro t; simp [Set.mem_Icc]
  have hF₀c : Continuous fun t : ℝ => ‖H ((t : ℂ) * Complex.I)‖ :=
    (hHc.comp_continuous (by fun_prop) hmemL).norm
  have hF₁c : Continuous fun t : ℝ => ‖H ((1 : ℂ) + (t : ℂ) * Complex.I)‖ :=
    (hHc.comp_continuous (by fun_prop) hmemR).norm
  have hCD : ∀ z : ℂ, z.re ∈ Icc (0 : ℝ) 1 → ‖H z‖ ≤ max C 1 := fun z hz =>
    (hC z hz).trans (le_max_left _ _)
  have hw₀c : Continuous fun t : ℝ => poissonStrip θ 1 t / (1 - θ) :=
    (continuous_poissonStrip ⟨hθ0, hθ1⟩ (by norm_num : |(1 : ℝ)| ≤ 1)).div_const _
  have hw₁c : Continuous fun t : ℝ => poissonStrip θ (-1) t / θ :=
    (continuous_poissonStrip ⟨hθ0, hθ1⟩ (by norm_num : |(-1 : ℝ)| ≤ 1)).div_const _
  have hw₀0 : ∀ t : ℝ, 0 ≤ poissonStrip θ 1 t / (1 - θ) := fun t =>
    (div_pos (poissonStrip_pos ⟨hθ0, hθ1⟩ (by norm_num : |(1 : ℝ)| ≤ 1) t) h1θ).le
  have hw₁0 : ∀ t : ℝ, 0 ≤ poissonStrip θ (-1) t / θ := fun t =>
    (div_pos (poissonStrip_pos ⟨hθ0, hθ1⟩ (by norm_num : |(-1 : ℝ)| ≤ 1) t) hθ0).le
  have hw₀i : Integrable fun t : ℝ => poissonStrip θ 1 t / (1 - θ) :=
    (integrable_poissonStrip ⟨hθ0, hθ1⟩ (by norm_num : |(1 : ℝ)| ≤ 1)).div_const _
  have hw₁i : Integrable fun t : ℝ => poissonStrip θ (-1) t / θ :=
    (integrable_poissonStrip ⟨hθ0, hθ1⟩ (by norm_num : |(-1 : ℝ)| ≤ 1)).div_const _
  have hI₀ : Integrable fun t : ℝ =>
      ‖H ((t : ℂ) * Complex.I)‖ ^ s * (poissonStrip θ 1 t / (1 - θ)) :=
    integrable_rpow_mul_weight hs hF₀c (fun t => norm_nonneg _)
      (fun t => hCD _ (hmemL t)) hw₀c hw₀0 hw₀i
  have hI₁ : Integrable fun t : ℝ =>
      ‖H ((1 : ℂ) + (t : ℂ) * Complex.I)‖ ^ s * (poissonStrip θ (-1) t / θ) :=
    integrable_rpow_mul_weight hs hF₁c (fun t => norm_nonneg _)
      (fun t => hCD _ (hmemR t)) hw₁c hw₁0 hw₁i
  have hnn₀ : (0 : ℝ) ≤ ∫ t : ℝ, ‖H ((t : ℂ) * Complex.I)‖ ^ s * (poissonStrip θ 1 t / (1 - θ)) :=
    integral_nonneg fun t => mul_nonneg (Real.rpow_nonneg (norm_nonneg _) s) (hw₀0 t)
  have hnn₁ : (0 : ℝ) ≤ ∫ t : ℝ,
      ‖H ((1 : ℂ) + (t : ℂ) * Complex.I)‖ ^ s * (poissonStrip θ (-1) t / θ) :=
    integral_nonneg fun t => mul_nonneg (Real.rpow_nonneg (norm_nonneg _) s) (hw₁0 t)
  have hreal := norm_le_geom_mean_strip_bdd ⟨hθ0, hθ1⟩ hs hHc hHd hC
  have he₀ : (0 : ℝ) ≤ (1 - θ) / s := div_nonneg h1θ.le hs.le
  have he₁ : (0 : ℝ) ≤ θ / s := div_nonneg hθ0.le hs.le
  calc ‖H (θ : ℂ)‖ₑ = ENNReal.ofReal ‖H (θ : ℂ)‖ := (ofReal_norm _).symm
    _ ≤ ENNReal.ofReal
        ((∫ t : ℝ, ‖H ((t : ℂ) * Complex.I)‖ ^ s * (poissonStrip θ 1 t / (1 - θ)))
            ^ ((1 - θ) / s)
          * (∫ t : ℝ, ‖H (1 + (t : ℂ) * Complex.I)‖ ^ s * (poissonStrip θ (-1) t / θ))
            ^ (θ / s)) := ENNReal.ofReal_le_ofReal hreal
    _ = ENNReal.ofReal
          ((∫ t : ℝ, ‖H ((t : ℂ) * Complex.I)‖ ^ s * (poissonStrip θ 1 t / (1 - θ)))
            ^ ((1 - θ) / s))
        * ENNReal.ofReal
          ((∫ t : ℝ, ‖H (1 + (t : ℂ) * Complex.I)‖ ^ s * (poissonStrip θ (-1) t / θ))
            ^ (θ / s)) := ENNReal.ofReal_mul (Real.rpow_nonneg hnn₀ _)
    _ = (ENNReal.ofReal
          (∫ t : ℝ, ‖H ((t : ℂ) * Complex.I)‖ ^ s * (poissonStrip θ 1 t / (1 - θ))))
            ^ ((1 - θ) / s)
        * (ENNReal.ofReal
          (∫ t : ℝ, ‖H (1 + (t : ℂ) * Complex.I)‖ ^ s * (poissonStrip θ (-1) t / θ)))
            ^ (θ / s) := by
        rw [ENNReal.ofReal_rpow_of_nonneg hnn₀ he₀, ENNReal.ofReal_rpow_of_nonneg hnn₁ he₁]
    _ = (∫⁻ t : ℝ, ‖H ((t : ℂ) * Complex.I)‖ₑ ^ s * hmLeft θ t) ^ ((1 - θ) / s)
        * (∫⁻ t : ℝ, ‖H (1 + (t : ℂ) * Complex.I)‖ₑ ^ s * hmRight θ t) ^ (θ / s) := by
        rw [ofReal_integral_rpow_mul hs.le (fun t => norm_nonneg _) hw₀0 hI₀,
          ofReal_integral_rpow_mul hs.le (fun t => norm_nonneg _) hw₁0 hI₁]
        simp only [ofReal_norm, hmLeft, hmRight]

/-! ### Jensen's inequality against a probability density -/

/-- For a probability density `w` and an exponent `r ≥ 1`, the `r`-th power of the `w`-average is
at most the `w`-average of the `r`-th power.  This replaces Minkowski's integral inequality in the
interpolation argument, and unlike it is available directly from Hölder's inequality. -/
theorem rpow_lintegral_mul_le {β : Type*} [MeasurableSpace β] {ν : Measure β}
    {g w : β → ℝ≥0∞} (hg : AEMeasurable g ν) (hw : AEMeasurable w ν)
    (hw1 : ∫⁻ t, w t ∂ν = 1) {r : ℝ} (hr : 1 ≤ r) :
    (∫⁻ t, g t * w t ∂ν) ^ r ≤ ∫⁻ t, g t ^ r * w t ∂ν := by
  have hr0 : (0 : ℝ) < r := lt_of_lt_of_le one_pos hr
  have hinv0 : (0 : ℝ) ≤ 1 / r := by positivity
  have hle1 : 1 / r ≤ 1 := by rw [div_le_one hr0]; exact hr
  have hinv1 : (0 : ℝ) ≤ 1 - 1 / r := by linarith
  have hsum : 1 / r + (1 - 1 / r) = 1 := by ring
  have key := ENNReal.lintegral_mul_norm_pow_le (μ := ν)
    (f := fun t => g t ^ r * w t) (g := w) ((hg.pow_const r).mul hw) hw hinv0 hinv1 hsum
  have hlhs : ∀ t : β, (g t ^ r * w t) ^ (1 / r) * w t ^ (1 - 1 / r) = g t * w t := by
    intro t
    rw [ENNReal.mul_rpow_of_nonneg _ _ hinv0, ← ENNReal.rpow_mul, mul_one_div, div_self hr0.ne',
      ENNReal.rpow_one, mul_assoc, ← ENNReal.rpow_add_of_nonneg _ _ hinv0 hinv1, hsum,
      ENNReal.rpow_one]
  have heq : (∫⁻ t, (g t ^ r * w t) ^ (1 / r) * w t ^ (1 - 1 / r) ∂ν) = ∫⁻ t, g t * w t ∂ν :=
    lintegral_congr hlhs
  have key2 : ∫⁻ t, g t * w t ∂ν ≤ (∫⁻ t, g t ^ r * w t ∂ν) ^ (1 / r) := by
    refine le_trans (le_of_eq heq.symm) (le_trans key ?_)
    rw [hw1, ENNReal.one_rpow, mul_one]
  calc (∫⁻ t, g t * w t ∂ν) ^ r ≤ ((∫⁻ t, g t ^ r * w t ∂ν) ^ (1 / r)) ^ r :=
        ENNReal.rpow_le_rpow key2 hr0.le
    _ = ∫⁻ t, g t ^ r * w t ∂ν := by
        rw [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hr0.ne', ENNReal.rpow_one]


/-! ### The edge estimate -/

open scoped ENNReal in
/-- The `L^{q_ℓ}` norm of the `s`-th power mean of an edge family is controlled by the uniform
edge bound.  This is the step for which the blueprint invokes Minkowski's integral inequality;
here it is Jensen's inequality for `u ↦ u ^ (r / s)` followed by Tonelli's theorem. -/
theorem lintegral_edge_mean_le {α : Type*} [MeasurableSpace α] {μ : Measure α} [SFinite μ]
    {G : ℝ → α → ℂ} {w : ℝ → ℝ≥0∞} {s r : ℝ} {M : ℝ≥0∞} (hs : 0 < s) (hsr : s ≤ r) (hr : 0 < r)
    (hw : Measurable w) (hwtop : ∀ t, w t ≠ ⊤) (hw1 : ∫⁻ t : ℝ, w t = 1)
    (hjoint : AEMeasurable (fun p : α × ℝ => ‖G p.2 p.1‖ₑ) (μ.prod volume))
    (hxm : ∀ x : α, AEMeasurable (fun t : ℝ => ‖G t x‖ₑ) volume)
    (hM : ∀ t : ℝ, eLpNorm (G t) (ENNReal.ofReal r) μ ≤ M) :
    ∫⁻ x : α, (∫⁻ t : ℝ, ‖G t x‖ₑ ^ s * w t) ^ (r / s) ∂μ ≤ M ^ r := by
  have hrs : (1 : ℝ) ≤ r / s := (one_le_div hs).mpr hsr
  have hs0 : s ≠ 0 := hs.ne'
  have hswap : AEMeasurable
      (Function.uncurry fun (x : α) (t : ℝ) => ‖G t x‖ₑ ^ r * w t) (μ.prod volume) :=
    (hjoint.pow_const r).mul ((hw.comp measurable_snd).aemeasurable)
  calc ∫⁻ x : α, (∫⁻ t : ℝ, ‖G t x‖ₑ ^ s * w t) ^ (r / s) ∂μ
      ≤ ∫⁻ x : α, (∫⁻ t : ℝ, (‖G t x‖ₑ ^ s) ^ (r / s) * w t) ∂μ :=
        lintegral_mono fun x =>
          rpow_lintegral_mul_le ((hxm x).pow_const s) hw.aemeasurable hw1 hrs
    _ = ∫⁻ x : α, (∫⁻ t : ℝ, ‖G t x‖ₑ ^ r * w t) ∂μ := by
        refine lintegral_congr fun x => lintegral_congr fun t => ?_
        rw [← ENNReal.rpow_mul]
        congr 1
        field_simp
    _ = ∫⁻ t : ℝ, (∫⁻ x : α, ‖G t x‖ₑ ^ r * w t ∂μ) := lintegral_lintegral_swap hswap
    _ = ∫⁻ t : ℝ, (∫⁻ x : α, ‖G t x‖ₑ ^ r ∂μ) * w t :=
        lintegral_congr fun t => lintegral_mul_const' _ _ (hwtop t)
    _ ≤ ∫⁻ t : ℝ, M ^ r * w t := by
        refine lintegral_mono fun t => mul_le_mul' ?_ le_rfl
        rw [lintegral_rpow_enorm_eq_rpow_eLpNorm' hr]
        have hconv : eLpNorm' (G t) r μ = eLpNorm (G t) (ENNReal.ofReal r) μ := by
          rw [eLpNorm_eq_eLpNorm' (ENNReal.ofReal_pos.mpr hr).ne' ENNReal.ofReal_ne_top,
            ENNReal.toReal_ofReal hr.le]
        rw [hconv]
        exact ENNReal.rpow_le_rpow (hM t) hr.le
    _ = M ^ r := by
        rw [lintegral_const_mul'' _ hw.aemeasurable, hw1, mul_one]

/-! ### Stein interpolation for analytic families -/

open scoped ENNReal in
/-- **Stein interpolation for an analytic family of functions, with possibly subunit output
exponents.**  Let `H z` be a family of functions on a measure space, indexed by the closed strip
`0 ≤ re z ≤ 1`, continuous on the closed strip and analytic in the open strip at every point of
the space, and uniformly bounded there.  If `‖H (i t)‖_{L^{q₀}} ≤ M₀` and
`‖H (1 + i t)‖_{L^{q₁}} ≤ M₁` for every `t`, then `‖H θ‖_{L^q} ≤ M₀ ^ (1 - θ) M₁ ^ θ` whenever
`0 < θ < 1` and `1/q = (1-θ)/q₀ + θ/q₁`.  No exponent is required to be at least one.  The two
edge bounds are extended nonnegative reals, so that the theorem may be applied with bounds that
carry the norms of the data and are not known in advance to be finite or nonzero. -/
theorem eLpNorm_le_of_analyticFamily
    {α : Type*} [MeasurableSpace α] {μ : Measure α} [SFinite μ]
    {H : ℂ → α → ℂ} {q₀ q₁ q θ : ℝ} {M₀ M₁ : ℝ≥0∞}
    (hθ : θ ∈ Ioo (0 : ℝ) 1)
    (hq₀ : 0 < q₀) (hq₁ : 0 < q₁) (hq : 0 < q)
    (hqrel : q⁻¹ = (1 - θ) * q₀⁻¹ + θ * q₁⁻¹)
    (hmeas₀ : AEStronglyMeasurable
      (fun p : α × ℝ => H ((p.2 : ℂ) * Complex.I) p.1) (μ.prod volume))
    (hmeas₁ : AEStronglyMeasurable
      (fun p : α × ℝ => H (1 + (p.2 : ℂ) * Complex.I) p.1) (μ.prod volume))
    (hcont : ∀ x : α, ContinuousOn (fun z : ℂ => H z x) {z : ℂ | z.re ∈ Icc (0 : ℝ) 1})
    (hdiff : ∀ x : α, DifferentiableOn ℂ (fun z : ℂ => H z x) {z : ℂ | z.re ∈ Ioo (0 : ℝ) 1})
    (hbdd : ∀ x : α, ∃ C : ℝ, ∀ z : ℂ, z.re ∈ Icc (0 : ℝ) 1 → ‖H z x‖ ≤ C)
    (h₀ : ∀ t : ℝ, eLpNorm (fun x => H ((t : ℂ) * Complex.I) x) (ENNReal.ofReal q₀) μ
      ≤ M₀)
    (h₁ : ∀ t : ℝ, eLpNorm (fun x => H (1 + (t : ℂ) * Complex.I) x) (ENNReal.ofReal q₁) μ
      ≤ M₁) :
    eLpNorm (fun x => H (θ : ℂ) x) (ENNReal.ofReal q) μ ≤ M₀ ^ (1 - θ) * M₁ ^ θ := by
  obtain ⟨hθ0, hθ1⟩ := hθ
  have h1θ : (0 : ℝ) < 1 - θ := by linarith
  have hq00 : q₀ ≠ 0 := hq₀.ne'
  have hq10 : q₁ ≠ 0 := hq₁.ne'
  have hqq0 : q ≠ 0 := hq.ne'
  have hmin : 0 < min q₀ q₁ := lt_min hq₀ hq₁
  set s : ℝ := min q₀ q₁ / 2 with hsdef
  have hs : 0 < s := by rw [hsdef]; linarith
  have hs0 : s ≠ 0 := hs.ne'
  have hsq₀ : s ≤ q₀ := by
    have h := min_le_left q₀ q₁
    rw [hsdef]
    linarith
  have hsq₁ : s ≤ q₁ := by
    have h := min_le_right q₀ q₁
    rw [hsdef]
    linarith
  have hhmL : Measurable (hmLeft θ) := measurable_hmLeft ⟨hθ0, hθ1⟩
  have hhmR : Measurable (hmRight θ) := measurable_hmRight ⟨hθ0, hθ1⟩
  have hL1 : ∫⁻ t : ℝ, hmLeft θ t = 1 := lintegral_hmLeft ⟨hθ0, hθ1⟩
  have hR1 : ∫⁻ t : ℝ, hmRight θ t = 1 := lintegral_hmRight ⟨hθ0, hθ1⟩
  have hcontL : ∀ x : α, Continuous fun t : ℝ => H ((t : ℂ) * Complex.I) x := fun x =>
    (hcont x).comp_continuous (by fun_prop) (fun t => by simp [Set.mem_Icc])
  have hcontR : ∀ x : α, Continuous fun t : ℝ => H (1 + (t : ℂ) * Complex.I) x := fun x =>
    (hcont x).comp_continuous (by fun_prop) (fun t => by simp [Set.mem_Icc])
  set J₀ : α → ℝ≥0∞ :=
    fun x => ∫⁻ t : ℝ, ‖H ((t : ℂ) * Complex.I) x‖ₑ ^ s * hmLeft θ t with hJ₀def
  set J₁ : α → ℝ≥0∞ :=
    fun x => ∫⁻ t : ℝ, ‖H (1 + (t : ℂ) * Complex.I) x‖ₑ ^ s * hmRight θ t with hJ₁def
  have hmeasJ₀ : AEMeasurable J₀ μ := by
    rw [hJ₀def]
    exact ((hmeas₀.enorm.pow_const s).mul
      ((hhmL.comp measurable_snd).aemeasurable)).lintegral_prod_right'
  have hmeasJ₁ : AEMeasurable J₁ μ := by
    rw [hJ₁def]
    exact ((hmeas₁.enorm.pow_const s).mul
      ((hhmR.comp measurable_snd).aemeasurable)).lintegral_prod_right'
  have hpt : ∀ x : α, ‖H (θ : ℂ) x‖ₑ ≤ J₀ x ^ ((1 - θ) / s) * J₁ x ^ (θ / s) := by
    intro x
    obtain ⟨C, hC⟩ := hbdd x
    exact enorm_le_geom_mean_strip ⟨hθ0, hθ1⟩ hs (hcont x) (hdiff x) hC
  have hE₀ : ∫⁻ x : α, J₀ x ^ (q₀ / s) ∂μ ≤ M₀ ^ q₀ := by
    rw [hJ₀def]
    exact lintegral_edge_mean_le hs hsq₀ hq₀ hhmL (hmLeft_ne_top θ) hL1 hmeas₀.enorm
      (fun x => (hcontL x).aestronglyMeasurable.enorm) h₀
  have hE₁ : ∫⁻ x : α, J₁ x ^ (q₁ / s) ∂μ ≤ M₁ ^ q₁ := by
    rw [hJ₁def]
    exact lintegral_edge_mean_le hs hsq₁ hq₁ hhmR (hmRight_ne_top θ) hR1 hmeas₁.enorm
      (fun x => (hcontR x).aestronglyMeasurable.enorm) h₁
  have ha₀ : (0 : ℝ) ≤ q * (1 - θ) / q₀ := div_nonneg (mul_nonneg hq.le h1θ.le) hq₀.le
  have ha₁ : (0 : ℝ) ≤ q * θ / q₁ := div_nonneg (mul_nonneg hq.le hθ0.le) hq₁.le
  have hsum1 : q * (1 - θ) / q₀ + q * θ / q₁ = 1 := by
    have he : q * (1 - θ) / q₀ + q * θ / q₁ = q * ((1 - θ) * q₀⁻¹ + θ * q₁⁻¹) := by
      field_simp
    rw [he, ← hqrel, mul_inv_cancel₀ hqq0]
  have hmain : ∫⁻ x : α, ‖H (θ : ℂ) x‖ₑ ^ q ∂μ
      ≤ (M₀ ^ (1 - θ) * M₁ ^ θ) ^ q := by
    calc ∫⁻ x : α, ‖H (θ : ℂ) x‖ₑ ^ q ∂μ
        ≤ ∫⁻ x : α, (J₀ x ^ ((1 - θ) / s) * J₁ x ^ (θ / s)) ^ q ∂μ :=
          lintegral_mono fun x => ENNReal.rpow_le_rpow (hpt x) hq.le
      _ = ∫⁻ x : α, (J₀ x ^ (q₀ / s)) ^ (q * (1 - θ) / q₀)
            * (J₁ x ^ (q₁ / s)) ^ (q * θ / q₁) ∂μ := by
          refine lintegral_congr fun x => ?_
          have e₀ : (1 - θ) / s * q = q₀ / s * (q * (1 - θ) / q₀) := by
            field_simp
          have e₁ : θ / s * q = q₁ / s * (q * θ / q₁) := by
            field_simp
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le]
          simp only [← ENNReal.rpow_mul]
          rw [e₀, e₁]
      _ ≤ (∫⁻ x : α, J₀ x ^ (q₀ / s) ∂μ) ^ (q * (1 - θ) / q₀)
            * (∫⁻ x : α, J₁ x ^ (q₁ / s) ∂μ) ^ (q * θ / q₁) :=
          ENNReal.lintegral_mul_norm_pow_le (hmeasJ₀.pow_const _) (hmeasJ₁.pow_const _)
            ha₀ ha₁ hsum1
      _ ≤ (M₀ ^ q₀) ^ (q * (1 - θ) / q₀)
            * (M₁ ^ q₁) ^ (q * θ / q₁) :=
          mul_le_mul' (ENNReal.rpow_le_rpow hE₀ ha₀) (ENNReal.rpow_le_rpow hE₁ ha₁)
      _ = (M₀ ^ (1 - θ) * M₁ ^ θ) ^ q := by
          have e₂ : q₀ * (q * (1 - θ) / q₀) = (1 - θ) * q := by
            field_simp
          have e₃ : q₁ * (q * θ / q₁) = θ * q := by
            field_simp
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le]
          simp only [← ENNReal.rpow_mul]
          rw [e₂, e₃]
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (ENNReal.ofReal_pos.mpr hq).ne'
    ENNReal.ofReal_ne_top, ENNReal.toReal_ofReal hq.le]
  calc (∫⁻ x : α, ‖H (θ : ℂ) x‖ₑ ^ q ∂μ) ^ (1 / q)
      ≤ ((M₀ ^ (1 - θ) * M₁ ^ θ) ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmain (by positivity)
    _ = M₀ ^ (1 - θ) * M₁ ^ θ := by
        rw [← ENNReal.rpow_mul, mul_one_div, div_self hqq0, ENNReal.rpow_one]

end Auto
