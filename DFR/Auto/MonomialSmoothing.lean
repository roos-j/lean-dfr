    intro H hH
    refine hH.bdd_mul (c := 1) (Continuous.aestronglyMeasurable (by fun_prop)) ?_
    refine Eventually.of_forall (fun z => ?_)
    rw [Complex.norm_exp]; simp
  unfold mfkF2
  rw [← integral_sub (hb F hF) (hb G hG)]
  congr 1; ext z
  simp only [Pi.sub_apply]; ring

