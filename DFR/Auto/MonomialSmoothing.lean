namespace Auto

noncomputable section

/-! ### Lemma 2.1: the frequency decomposition (lines 206-285) -/

/-- The Fourier energy `E = ∫ |F̂|^2` (line 251). -/
def monoE (F : ℝ → ℂ) : ℝ≥0∞ := ∫⁻ ξ, ‖𝓕 F ξ‖ₑ ^ 2

/-- `n` is selected when `∫_{(n-4)R}^{(n+4)R} |F̂|^2 > ρ E` (lines 251-255). -/
def monoSelP (R ρ : ℝ) (F : ℝ → ℂ) (n : ℤ) : Prop :=
  ENNReal.ofReal ρ * monoE F < ∫⁻ ξ in Icc ((n - 4) * R) ((n + 4) * R), ‖𝓕 F ξ‖ₑ ^ 2

open Classical in
/-- The (finite) set of selected integers. -/
def monoSel (R ρ : ℝ) (F : ℝ → ℂ) : Finset ℤ :=
  if h : {n | monoSelP R ρ F n}.Finite then h.toFinset else ∅

/-- Each point lies in at most nine of the intervals `[(n-4)R, (n+4)R]`. -/
theorem sum_indicator_Icc_le {R : ℝ} (hR : 0 < R) (T : Finset ℤ) (ξ : ℝ) :
    ∑ n ∈ T, (Icc ((n - 4) * R) ((n + 4) * R)).indicator (1 : ℝ → ℝ≥0∞) ξ ≤ 9 := by
  set y := ξ / R
  have hsub : T.filter (fun n : ℤ => ξ ∈ Icc ((n - 4) * R) ((n + 4) * R))
      ⊆ Finset.Icc ⌈y - 4⌉ ⌊y + 4⌋ := by
    intro n hn
    simp only [Finset.mem_filter, mem_Icc] at hn
    obtain ⟨_, h1, h2⟩ := hn
    rw [Finset.mem_Icc]
    constructor
    · rw [Int.ceil_le]
      have : ξ / R ≤ n + 4 := by rw [div_le_iff₀ hR]; linarith
      show ξ / R - 4 ≤ n
      linarith
    · rw [Int.le_floor]
      have : (n : ℝ) - 4 ≤ ξ / R := by rw [le_div_iff₀ hR]; linarith
      show (n : ℝ) ≤ ξ / R + 4
      linarith
  have hcard : (Finset.Icc ⌈y - 4⌉ ⌊y + 4⌋).card ≤ 9 := by
    rw [Int.card_Icc]
    have h1 : (⌊y + 4⌋ : ℝ) ≤ y + 4 := Int.floor_le _
    have h2 : y - 4 ≤ (⌈y - 4⌉ : ℝ) := Int.le_ceil _
    have h3 : ⌊y + 4⌋ - ⌈y - 4⌉ ≤ 8 := by
      have : ((⌊y + 4⌋ - ⌈y - 4⌉ : ℤ) : ℝ) ≤ 8 := by push_cast; linarith
      exact_mod_cast this
    omega
  calc ∑ n ∈ T, (Icc ((n - 4) * R) ((n + 4) * R)).indicator (1 : ℝ → ℝ≥0∞) ξ
      = ((T.filter (fun n : ℤ => ξ ∈ Icc ((n - 4) * R) ((n + 4) * R))).card : ℝ≥0∞) := by
        rw [Finset.card_filter]
        push_cast
        refine Finset.sum_congr rfl fun n _ => ?_
        by_cases h : ξ ∈ Icc ((n - 4) * R) ((n + 4) * R) <;> simp [h]
    _ ≤ ((Finset.Icc ⌈y - 4⌉ ⌊y + 4⌋).card : ℝ≥0∞) := by exact_mod_cast Finset.card_le_card hsub
    _ ≤ 9 := by exact_mod_cast hcard

/-- The interval masses sum to at most `9 E`. -/
theorem sum_lintegral_Icc_le {R : ℝ} (hR : 0 < R) (T : Finset ℤ) (w : ℝ → ℝ≥0∞) (hw : Measurable w) :
    ∑ n ∈ T, ∫⁻ ξ in Icc ((n - 4) * R) ((n + 4) * R), w ξ ≤ 9 * ∫⁻ ξ, w ξ := by
  calc ∑ n ∈ T, ∫⁻ ξ in Icc ((n - 4) * R) ((n + 4) * R), w ξ
      = ∫⁻ ξ, ∑ n ∈ T, (Icc ((n - 4) * R) ((n + 4) * R)).indicator (1 : ℝ → ℝ≥0∞) ξ * w ξ := by
        rw [lintegral_finsetSum (f := fun n ξ =>
          (Icc ((n - 4) * R) ((n + 4) * R)).indicator (1 : ℝ → ℝ≥0∞) ξ * w ξ) T
          fun n _ => (measurable_one.indicator measurableSet_Icc).mul hw]
        refine Finset.sum_congr rfl fun n _ => ?_
        rw [← lintegral_indicator measurableSet_Icc]
        refine lintegral_congr fun ξ => ?_
        by_cases h : ξ ∈ Icc ((n - 4) * R) ((n + 4) * R) <;> simp [h]
    _ ≤ ∫⁻ ξ, 9 * w ξ := by
        refine lintegral_mono fun ξ => ?_
        rw [← Finset.sum_mul]
        exact mul_le_mul' (sum_indicator_Icc_le hR T ξ) le_rfl
    _ = 9 * ∫⁻ ξ, w ξ := lintegral_const_mul _ hw

theorem measurable_fourier_enorm_sq {F : ℝ → ℂ} (hF : Integrable F volume) :
    Measurable fun ξ => ‖𝓕 F ξ‖ₑ ^ 2 :=
  ((VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar continuous_inner hF)
    ).measurable.enorm.pow_const 2

/-- **The count** (lines 256-257): for `0 < E < ∞`, every finite set of selected integers has at
most `9/ρ` elements. -/
theorem card_le_of_selected {R ρ : ℝ} (hR : 0 < R) (hρ : 0 < ρ) {F : ℝ → ℂ}
    (hF : Integrable F volume) (hE : monoE F ≠ ⊤) (T : Finset ℤ)
    (hT : ∀ n ∈ T, monoSelP R ρ F n) : (T.card : ℝ) ≤ 9 / ρ := by
  rcases eq_or_ne (monoE F) 0 with h0 | h0
  · -- no integer is selected
    rcases T.eq_empty_or_nonempty with he | ⟨n, hn⟩
    · simp [he]; positivity
    · exfalso
      have h := hT n hn
      unfold monoSelP at h
      rw [h0, mul_zero] at h
      have : ∫⁻ ξ in Icc ((n - 4) * R) ((n + 4) * R), ‖𝓕 F ξ‖ₑ ^ 2 ≤ monoE F :=
        setLIntegral_le_lintegral _ _
      rw [h0] at this
      exact absurd h (not_lt.mpr this)
  have hsum := sum_lintegral_Icc_le hR T _ (measurable_fourier_enorm_sq hF)
  have hlow : (T.card : ℝ≥0∞) * (ENNReal.ofReal ρ * monoE F)
      ≤ ∑ n ∈ T, ∫⁻ ξ in Icc ((n - 4) * R) ((n + 4) * R), ‖𝓕 F ξ‖ₑ ^ 2 := by
    calc (T.card : ℝ≥0∞) * (ENNReal.ofReal ρ * monoE F)
        = ∑ n ∈ T, ENNReal.ofReal ρ * monoE F := by rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ _ := Finset.sum_le_sum fun n hn => (hT n hn).le
  have h9 := hlow.trans hsum
  rw [show ∫⁻ ξ, ‖𝓕 F ξ‖ₑ ^ 2 = monoE F from rfl] at h9
  have h9' : (T.card : ℝ≥0∞) * ENNReal.ofReal ρ ≤ 9 := by
    rw [← mul_assoc] at h9
    exact (ENNReal.mul_le_mul_iff_left h0 hE).mp h9
  have hreal := ENNReal.toReal_mono (by norm_num) h9'
  rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal hρ.le] at hreal
  simp only [ENNReal.toReal_natCast] at hreal
  rw [le_div_iff₀ hρ]
  norm_num at hreal
  linarith

end

end Auto

