/-! ### Sup and Lipschitz bounds for the coordinate multipliers (1.5) -/

theorem mloc_monoEj_add (j : Fin 2) (s t : ℝ) : monoEj j (s + t) = monoEj j s + monoEj j t := by
  fin_cases j <;> simp [monoEj, monoPt]

theorem mloc_monoEj_neg (j : Fin 2) (s : ℝ) : monoEj j (-s) = -monoEj j s := by
  fin_cases j <;> simp [monoEj, monoPt]

theorem mloc_continuous_monoEj (j : Fin 2) : Continuous (monoEj j) := by
  unfold monoEj
  exact (continuous_monoPt j).comp (continuous_id.prodMk continuous_const)

theorem mloc_meas_shift {u : ℝ × ℝ → ℂ} (hu : Measurable u) (j : Fin 2) (z : ℝ × ℝ) :
    Measurable fun s => u (z - monoEj j s) :=
  hu.comp (continuous_const.sub (mloc_continuous_monoEj j)).measurable

theorem mloc_integrable_conv {K : ℝ → ℂ} (hK : Integrable K) {u : ℝ × ℝ → ℂ} (hu : Measurable u)
    {M : ℝ} (hM : ∀ z, ‖u z‖ ≤ M) (j : Fin 2) (z : ℝ × ℝ) :
    Integrable fun s => K s * u (z - monoEj j s) :=
  hK.mul_bdd (mloc_meas_shift hu j z).aestronglyMeasurable (Eventually.of_forall fun _ => hM _)

/-- The dilated kernel `L κ(L s)`. -/
theorem mloc_integrable_dil (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : L ≠ 0) :
    Integrable fun s => (L : ℂ) * κ (L * s) :=
  (κ.integrable.comp_mul_left' hL).const_mul _

theorem mloc_integral_norm_dil (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L) :
    ∫ s, ‖(L : ℂ) * κ (L * s)‖ = ∫ s, ‖κ s‖ := by
  simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hL]
  rw [integral_const_mul, Measure.integral_comp_mul_left (fun s => ‖κ s‖) L, abs_inv, abs_of_pos hL,
    smul_eq_mul, ← mul_assoc, mul_inv_cancel₀ hL.ne', one_mul]

/-- The sup bound `‖ϑ(D_j/L) u‖_∞ ≤ ‖κ‖_1 ‖u‖_∞`. -/
theorem mloc_P_norm_le (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L) {u : ℝ × ℝ → ℂ} {M : ℝ}
    (hM : ∀ z, ‖u z‖ ≤ M) (z : ℝ × ℝ) : ‖monoP j κ L u z‖ ≤ (∫ s, ‖κ s‖) * M := by
  rw [← mloc_integral_norm_dil κ hL]
  exact norm_monoCConv_le (mloc_integrable_dil κ hL.ne') hM z

theorem mloc_monoCConv_shift (j : Fin 2) (K : ℝ → ℂ) (u : ℝ × ℝ → ℂ) (z : ℝ × ℝ) (a : ℝ) :
    monoCConv j K u (z + monoEj j a) = ∫ s, K (s + a) * u (z - monoEj j s) := by
  unfold monoCConv
  rw [← integral_add_right_eq_self (fun s => K s * u (z + monoEj j a - monoEj j s)) a]
  congr 1; ext s
  rw [mloc_monoEj_add]; congr 2; abel

theorem mloc_kernel_diff_le {K K' : ℝ → ℂ} (hd : ∀ s, HasDerivAt K (K' s) s)
    (hK'c : Continuous K') {a : ℝ} (ha : 0 ≤ a) (s : ℝ) :
    ‖K (s + a) - K s‖ ≤ ∫ t in Ioc 0 a, ‖K' (s + t)‖ := by
  have hI : ∫ t in (0 : ℝ)..a, K' (s + t) = K (s + a) - K (s + 0) := by
    apply intervalIntegral.integral_eq_sub_of_hasDerivAt
    · intro t _; exact (hd (s + t)).comp_const_add s t
    · exact (hK'c.comp (continuous_const.add continuous_id)).intervalIntegrable _ _
  rw [add_zero] at hI
  rw [← hI, ← intervalIntegral.integral_of_le ha]
  exact intervalIntegral.norm_integral_le_integral_norm ha

theorem mloc_prod_integrable {K' : ℝ → ℂ} (hK'c : Continuous K') (hK' : Integrable K') (a : ℝ) :
    Integrable (Function.uncurry fun s t => ‖K' (s + t)‖) (volume.prod (volume.restrict (Ioc 0 a))) := by
  have hc : Continuous (Function.uncurry fun s t : ℝ => ‖K' (s + t)‖) :=
    (hK'c.comp (continuous_fst.add continuous_snd)).norm
  rw [integrable_prod_iff' hc.aestronglyMeasurable]
  refine ⟨Eventually.of_forall fun t => ?_, ?_⟩
  · simpa [Function.uncurry] using (hK'.comp_add_right t).norm
  · have : ∀ t, ∫ s, ‖(Function.uncurry fun s t : ℝ => ‖K' (s + t)‖) (s, t)‖ = ∫ s, ‖K' s‖ := by
      intro t
      simp only [Function.uncurry_apply_pair, norm_norm]
      exact integral_add_right_eq_self (fun s => ‖K' s‖) t
    simp_rw [this]
    exact integrableOn_const measure_Ioc_lt_top.ne

theorem mloc_integral_prod_eq {K' : ℝ → ℂ} (hK'c : Continuous K') (hK' : Integrable K') {a : ℝ}
    (ha : 0 ≤ a) : ∫ s, ∫ t in Ioc 0 a, ‖K' (s + t)‖ = a * ∫ s, ‖K' s‖ := by
  rw [integral_integral_swap (mloc_prod_integrable hK'c hK' a)]
  simp_rw [integral_add_right_eq_self (fun s => ‖K' s‖)]
  rw [setIntegral_const, Real.volume_real_Ioc_of_le ha, sub_zero, smul_eq_mul]

/-- Lipschitz bound for a coordinate convolution with a `C^1` kernel. -/
theorem mloc_conv_lip_nonneg {K K' : ℝ → ℂ} (hK : Integrable K) (hd : ∀ s, HasDerivAt K (K' s) s)
    (hK'c : Continuous K') (hK' : Integrable K') {u : ℝ × ℝ → ℂ} (hu : Measurable u) {M : ℝ}
    (hM : ∀ z, ‖u z‖ ≤ M) (j : Fin 2) (z : ℝ × ℝ) {a : ℝ} (ha : 0 ≤ a) :
    ‖monoCConv j K u (z + monoEj j a) - monoCConv j K u z‖ ≤ (∫ s, ‖K' s‖) * M * a := by
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM z)
  have hKa : Integrable fun s => K (s + a) := hK.comp_add_right a
  rw [mloc_monoCConv_shift, monoCConv, ← integral_sub (mloc_integrable_conv hKa hu hM j z)
    (mloc_integrable_conv hK hu hM j z)]
  have hint := (mloc_prod_integrable hK'c hK' a).integral_prod_left
  refine (norm_integral_le_integral_norm _).trans ?_
  calc ∫ s, ‖K (s + a) * u (z - monoEj j s) - K s * u (z - monoEj j s)‖
      ≤ ∫ s, (∫ t in Ioc 0 a, ‖K' (s + t)‖) * M := by
        refine integral_mono_of_nonneg (Eventually.of_forall fun s => norm_nonneg _)
          (hint.mul_const M) (Eventually.of_forall fun s => ?_)
        dsimp only
        rw [← sub_mul, norm_mul]
        exact mul_le_mul (mloc_kernel_diff_le hd hK'c ha s) (hM _) (norm_nonneg _)
          (integral_nonneg fun _ => norm_nonneg _)
    _ = (∫ s, ‖K' s‖) * M * a := by
        rw [integral_mul_const]
        change (∫ s, ∫ t in Ioc 0 a, ‖K' (s + t)‖) * M = _
        rw [mloc_integral_prod_eq hK'c hK' ha]; ring

theorem mloc_conv_lip {K K' : ℝ → ℂ} (hK : Integrable K) (hd : ∀ s, HasDerivAt K (K' s) s)
    (hK'c : Continuous K') (hK' : Integrable K') {u : ℝ × ℝ → ℂ} (hu : Measurable u) {M : ℝ}
    (hM : ∀ z, ‖u z‖ ≤ M) (j : Fin 2) (z : ℝ × ℝ) (a : ℝ) :
    ‖monoCConv j K u (z + monoEj j a) - monoCConv j K u z‖ ≤ (∫ s, ‖K' s‖) * M * |a| := by
  rcases le_total 0 a with ha | ha
  · rw [abs_of_nonneg ha]; exact mloc_conv_lip_nonneg hK hd hK'c hK' hu hM j z ha
  · have := mloc_conv_lip_nonneg hK hd hK'c hK' hu hM j (z + monoEj j a) (neg_nonneg.mpr ha)
    rw [add_assoc, ← mloc_monoEj_add, add_neg_cancel, show monoEj j 0 = 0 by
      fin_cases j <;> simp [monoEj, monoPt], add_zero, norm_sub_rev] at this
    rwa [abs_of_nonpos ha]

theorem mloc_hasDerivAt_dil (κ : 𝓢(ℝ, ℂ)) (L s : ℝ) :
    HasDerivAt (fun s => (L : ℂ) * κ (L * s)) ((L : ℂ) * ((L : ℂ) * deriv κ (L * s))) s := by
  have h1 : HasDerivAt (fun s : ℝ => L * s) L s := by
    simpa using (hasDerivAt_id s).const_mul L
  have h2 := (κ.differentiableAt (x := L * s)).hasDerivAt.scomp s h1
  have h3 := h2.const_mul (L : ℂ)
  simpa [Function.comp_def, Complex.real_smul] using h3

theorem mloc_integral_norm_ddil (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L) :
    ∫ s, ‖(L : ℂ) * ((L : ℂ) * deriv κ (L * s))‖ = L * ∫ s, ‖deriv κ s‖ := by
  have e : ∀ s, ‖(L : ℂ) * ((L : ℂ) * deriv κ (L * s))‖ = L * ‖(L : ℂ) * deriv κ (L * s)‖ := by
    intro s; rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hL]
  simp_rw [e]
  rw [integral_const_mul]
  congr 1
  have := mloc_integral_norm_dil (SchwartzMap.derivCLM ℝ ℂ κ) hL
  simpa [SchwartzMap.derivCLM_apply] using this

/-- The Lipschitz bound `|ϑ(D_j/L) u(z + a e_j) - ϑ(D_j/L) u(z)| ≤ L ‖κ'‖_1 ‖u‖_∞ |a|`. -/
theorem mloc_P_lip (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L) {u : ℝ × ℝ → ℂ}
    (hu : Measurable u) {M : ℝ} (hM : ∀ z, ‖u z‖ ≤ M) (z : ℝ × ℝ) (a : ℝ) :
    ‖monoP j κ L u (z + monoEj j a) - monoP j κ L u z‖ ≤ L * (∫ s, ‖deriv κ s‖) * M * |a| := by
  have hd := mloc_hasDerivAt_dil κ L
  have hK'c : Continuous fun s => (L : ℂ) * ((L : ℂ) * deriv κ (L * s)) := by
    have e : ⇑(SchwartzMap.derivCLM ℝ ℂ κ) = deriv κ := funext fun x => by
      simp [SchwartzMap.derivCLM_apply]
    have : Continuous (deriv κ) := e ▸ (SchwartzMap.derivCLM ℝ ℂ κ).continuous
    fun_prop
  have hK' : Integrable fun s => (L : ℂ) * ((L : ℂ) * deriv κ (L * s)) := by
    have := (mloc_integrable_dil (SchwartzMap.derivCLM ℝ ℂ κ) hL.ne').const_mul (L : ℂ)
    simpa [SchwartzMap.derivCLM_apply] using this
  have := mloc_conv_lip (mloc_integrable_dil κ hL.ne') hd hK'c hK' hu hM j z a
  rwa [mloc_integral_norm_ddil κ hL] at this

end

