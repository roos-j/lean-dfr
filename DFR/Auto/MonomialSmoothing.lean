/-! ### Interfaces for Proposition 6.1 -/

/-- **Lemma 3.1** (the sublevel estimate, (3.1)) as a proposition. -/
def MonoSublevel (r A B : ℝ) : Prop :=
  ∀ {D : Set (ℝ × ℝ)}, Bornology.IsBounded D → ∀ {c0 : ℝ}, 0 < c0 →
    ∃ C : ℝ, 0 ≤ C ∧ ∀ α β : ℝ × ℝ → ℝ, Measurable α → Measurable β →
      ((∀ z, c0 ≤ |α z|) ∨ (∀ z, c0 ≤ |β z|)) → ∀ ε : ℝ, 0 < ε → ε ≤ 1 →
        volume {p : (ℝ × ℝ) × ℝ | p.1 ∈ D ∧ p.2 ∈ Set.Icc A B ∧
          |α (p.1.1 + p.2, p.1.2) - monoq r p.2 * β (p.1.1, p.1.2 + monoQ r p.2)| ≤ ε}
          ≤ ENNReal.ofReal (C * ε ^ (1 / 39 : ℝ))

/-- **Lemma 5.1** (the local correlation estimate, (5.5)) as a proposition: families `v_{1,m}`,
`v_{2,n}` localized to cubes of side `2 C_0 h` centered at `h m`, bounded by `B_j`, `B_j L`-Lipschitz
in the active coordinate (5.2), with fiber energy (5.3), and the uniformity (5.4) for one family. -/
def MonoLocCorr (r A B : ℝ) : Prop :=
  ∀ χ : ℝ × ℝ → ℝ, ContDiff ℝ ∞ χ → HasCompactSupport χ → ∀ C0 : ℝ, 1 ≤ C0 →
  ∃ C : ℝ, 0 ≤ C ∧ ∀ ψ : ℝ → ℝ, ContDiff ℝ ∞ ψ → tsupport ψ ⊆ Icc A B → monoC20 ψ ≤ 1 →
  ∀ h L K ρ : ℝ, 0 < h → h ≤ 1 → 1 ≤ h * L → 1 ≤ K → 0 < ρ → ρ < 1 →
  ∀ (M₁ M₂ : Finset (ℤ × ℤ)) (v₁ v₂ : ℤ × ℤ → ℝ × ℝ → ℂ) (B₁ B₂ : ℝ),
    (∀ m, Measurable (v₁ m)) → (∀ m, Measurable (v₂ m)) →
    (∀ m z, v₁ m z ≠ 0 → |z.1 - h * m.1| ≤ C0 * h ∧ |z.2 - h * m.2| ≤ C0 * h) →
    (∀ m z, v₂ m z ≠ 0 → |z.1 - h * m.1| ≤ C0 * h ∧ |z.2 - h * m.2| ≤ C0 * h) →
    (∀ m z, ‖v₁ m z‖ ≤ B₁) → (∀ m z, ‖v₂ m z‖ ≤ B₂) →
    (∀ m z a, ‖v₁ m (z + (a, 0)) - v₁ m z‖ ≤ B₁ * L * |a|) →
    (∀ m z a, ‖v₂ m (z + (0, a)) - v₂ m z‖ ≤ B₂ * L * |a|) →
    (∀ m, ∫⁻ y, (∫⁻ x, ‖v₁ m (x, y)‖ₑ ^ 2) ^ 2 ≤ ENNReal.ofReal (C0 * h ^ 3)) →
    (∀ m, ∫⁻ x, (∫⁻ y, ‖v₂ m (x, y)‖ₑ ^ 2) ^ 2 ≤ ENNReal.ofReal (C0 * h ^ 3)) →
    ((∀ m, ∫⁻ y, monoU (K / h) (fun x => v₁ m (x, y)) ≤ ENNReal.ofReal (C0 * ρ * h ^ 3)) ∨
      (∀ m, ∫⁻ x, monoU (K / h) (fun y => v₂ m (x, y)) ≤ ENNReal.ofReal (C0 * ρ * h ^ 3))) →
    eLpNorm (fun z => (χ z : ℂ) *
        monoT r ψ (fun w => ∑ m ∈ M₁, v₁ m w) (fun w => ∑ n ∈ M₂, v₂ n w) z) 1 volume
      ≤ ENNReal.ofReal (C * (B₁ * B₂ * L ^ (1 / 2 : ℝ) * h + (ρ + h + 1 / K) ^ (1 / 4 : ℝ)))

/-- The cutoff `β`, `= 1` on `[-3/4, 3/4]`, supported in `[-3/2, 3/2]`. -/
def monoBeta (x : ℝ) : ℝ := monoPhi (4 * x / 3)

/-- The spatial partition of unity `η_m(z) = ϑ(x/h - m_1) ϑ(y/h - m_2)` (lines 943-950). -/
def monoEta (h : ℝ) (m : ℤ × ℤ) (z : ℝ × ℝ) : ℝ :=
  smoothingPartitionCutoff (z.1 / h - m.1) * smoothingPartitionCutoff (z.2 / h - m.2)

/-- The enlarged cutoffs `χ_m(z) = β(x/h - m_1) β(y/h - m_2)`, `χ_m = 1` on `supp η_m`. -/
def monoChiM (h : ℝ) (m : ℤ × ℤ) (z : ℝ × ℝ) : ℝ :=
  monoBeta (z.1 / h - m.1) * monoBeta (z.2 / h - m.2)

/-- The enlarged ball multiplier `φ(ξ/2)`, `= 1` on `[-2,2]`. -/
def monoPhiE (x : ℝ) : ℝ := monoPhi (x / 2)

/-- The enlarged annular multiplier `φ(ξ/2) - φ(4ξ)`, `= 1` on `{1/2 ≤ |ξ| ≤ 2}`. -/
def monoPsiE (x : ℝ) : ℝ := monoPhi (x / 2) - monoPhi (4 * x)

theorem monoPhiE_contDiff : ContDiff ℝ ∞ monoPhiE :=
  monoPhi_contDiff.comp (contDiff_id.div_const 2)

theorem monoPsiE_contDiff : ContDiff ℝ ∞ monoPsiE :=
  (monoPhi_contDiff.comp (contDiff_id.div_const 2)).sub
    (monoPhi_contDiff.comp (contDiff_const.mul contDiff_id))

theorem monoPhiE_eq_zero {x : ℝ} (hx : 4 ≤ |x|) : monoPhiE x = 0 :=
  monoPhi_eq_zero (by rw [abs_div, abs_two]; linarith)

theorem monoPhiE_hasCompactSupport : HasCompactSupport monoPhiE := by
  refine HasCompactSupport.of_support_subset_isCompact (isCompact_Icc (a := -4) (b := 4)) ?_
  intro x hx
  by_contra h
  apply hx
  apply monoPhiE_eq_zero
  simp only [mem_Icc, not_and_or, not_le] at h
  rcases h with h | h
  · rw [abs_of_neg (by linarith)]; linarith
  · rw [abs_of_pos (by linarith)]; linarith

theorem monoPsiE_hasCompactSupport : HasCompactSupport monoPsiE := by
  refine HasCompactSupport.of_support_subset_isCompact (isCompact_Icc (a := -4) (b := 4)) ?_
  intro x hx
  by_contra h
  apply hx
  have h4 : 4 ≤ |x| := by
    simp only [mem_Icc, not_and_or, not_le] at h
    rcases h with h | h
    · rw [abs_of_neg (by linarith)]; linarith
    · rw [abs_of_pos (by linarith)]; linarith
  have h1 : monoPhi (x / 2) = 0 := monoPhi_eq_zero (by rw [abs_div, abs_two]; linarith)
  have h2 : monoPhi (4 * x) = 0 := monoPhi_eq_zero (by rw [abs_mul]; norm_num; linarith)
  simp [monoPsiE, h1, h2]

/-- The kernel of `φ(ξ/2)`. -/
def monoKPhiE : 𝓢(ℝ, ℂ) := monoMultK monoPhiE_contDiff monoPhiE_hasCompactSupport

/-- The kernel of `φ(ξ/2) - φ(4ξ)`. -/
def monoKPsiE : 𝓢(ℝ, ℂ) := monoMultK monoPsiE_contDiff monoPsiE_hasCompactSupport

end

