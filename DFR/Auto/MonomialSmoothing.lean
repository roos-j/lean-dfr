namespace Auto

noncomputable section

/-- The Fourier transform on `ℝ × ℝ`: `𝓕₂ F(ξ) = ∫ e^{-2πi (z₁ξ₁ + z₂ξ₂)} F(z) dz`. -/
def mfkF2 (F : ℝ × ℝ → ℂ) (ξ : ℝ × ℝ) : ℂ :=
  ∫ z : ℝ × ℝ, Complex.exp (-(2 * Real.pi * Complex.I * (z.1 * ξ.1 + z.2 * ξ.2))) * F z

/-- Partial Fourier transform in the first variable. -/
def mfkG (F : ℝ × ℝ → ℂ) (ξ y : ℝ) : ℂ :=
  ∫ x : ℝ, Complex.exp (-(2 * Real.pi * Complex.I * (x * ξ))) * F (x, y)

theorem mfkG_eq_partial (F : ℝ × ℝ → ℂ) (ξ y : ℝ) :
    mfkG F ξ y = smoothingPartialFourierFirst F ξ y := by
  rw [smoothingPartialFourierFirst, ← mfkF1_eq_fourier]; rfl

theorem mfkG_measurable {F : ℝ × ℝ → ℂ} (hF : Measurable F) :
    Measurable (Function.uncurry (mfkG F)) := by
  have : Function.uncurry (mfkG F) = Function.uncurry (smoothingPartialFourierFirst F) := by
    funext p; exact mfkG_eq_partial F p.1 p.2
  rw [this]; exact smoothingPartialFourierFirst_measurable hF

theorem mfkG_integrable {F : ℝ × ℝ → ℂ} (hFm : Measurable F) (hF : Integrable F) (ξ : ℝ) :
    Integrable (mfkG F ξ) := by
  have : mfkG F ξ = smoothingPartialFourierFirst F ξ := funext (mfkG_eq_partial F ξ)
  rw [this]; exact smoothingPartialFourierFirst_integrable hFm hF ξ

theorem mfkF2_eq_iter {F : ℝ × ℝ → ℂ} (hF : Integrable F) (ξ₁ ξ₂ : ℝ) :
    mfkF2 F (ξ₁, ξ₂) = mfkF1 (mfkG F ξ₁) ξ₂ := by
  let K := fun z : ℝ × ℝ =>
    Complex.exp (-(2 * Real.pi * Complex.I * (z.1 * ξ₁ + z.2 * ξ₂))) * F z
  have hKi : Integrable K := by
    refine hF.bdd_mul (c := 1) ?_ ?_
    · exact (Continuous.aestronglyMeasurable (by fun_prop))
    · refine Eventually.of_forall (fun z => ?_)
      rw [Complex.norm_exp]
      simp
  have hprod : (∫ z : ℝ × ℝ, K z) = ∫ y : ℝ, ∫ x : ℝ, K (x, y) := by
    simpa only [Measure.volume_eq_prod] using!
      (integral_prod_symm K (by simpa only [Measure.volume_eq_prod] using hKi))
  rw [mfkF2]
  change (∫ z : ℝ × ℝ, K z) = _
  rw [hprod, mfkF1]
  congr 1; ext y
  rw [mfkG, ← integral_const_mul]
  congr 1; ext x
  simp only [K]
  rw [← mul_assoc, ← Complex.exp_add]
  congr 2
  ring

theorem mfkF2_measurable_of (F : ℝ × ℝ → ℂ) (hF : Measurable F) : Measurable (mfkF2 F) := by
  have hm : Measurable (fun p : (ℝ × ℝ) × (ℝ × ℝ) =>
      Complex.exp (-(2 * Real.pi * Complex.I * (p.2.1 * p.1.1 + p.2.2 * p.1.2))) * F p.2) := by
    fun_prop
  exact (hm.stronglyMeasurable.integral_prod_right' (ν := (volume : Measure (ℝ × ℝ)))).measurable

end

end Auto

end

