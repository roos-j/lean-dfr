open MeasureTheory Filter Topology Set
open scoped ENNReal

namespace Auto

noncomputable section

/-! ### Lc01: calculus facts for `Q(t) = t^r` and `q = Q'` on `[A,B]` -/

/-- The derivative of `q`. -/
def mlcdq (r t : ℝ) : ℝ := r * ((r - 1) * t ^ (r - 2))

theorem mlc_hasDerivAt_q (r : ℝ) {t : ℝ} (ht : 0 < t) : HasDerivAt (monoq r) (mlcdq r t) t := by
  unfold monoq mlcdq
  have := (Real.hasDerivAt_rpow_const (p := r - 1) (Or.inl ht.ne')).const_mul r
  rw [show r - 2 = r - 1 - 1 by ring]
  exact this

/-- Lower bound for `q'` on `[A,B]`. -/
def mlcCq (r A B : ℝ) : ℝ := r * ((r - 1) * min (A ^ (r - 2)) (B ^ (r - 2)))

/-- Upper bound for `q'` on `[A,B]`. -/
def mlcMq (r A B : ℝ) : ℝ := r * ((r - 1) * max (A ^ (r - 2)) (B ^ (r - 2)))

theorem mlc_rpow_bounds {r A B t : ℝ} (hA : 0 < A) (ht : t ∈ Icc A B) :
    min (A ^ (r - 2)) (B ^ (r - 2)) ≤ t ^ (r - 2) ∧ t ^ (r - 2) ≤ max (A ^ (r - 2)) (B ^ (r - 2)) := by
  rcases le_total 0 (r - 2) with h | h
  · exact ⟨(min_le_left _ _).trans (Real.rpow_le_rpow hA.le ht.1 h),
      (Real.rpow_le_rpow (hA.le.trans ht.1) ht.2 h).trans (le_max_right _ _)⟩
  · exact ⟨(min_le_right _ _).trans (Real.rpow_le_rpow_of_nonpos (hA.trans_le ht.1) ht.2 h),
      (Real.rpow_le_rpow_of_nonpos hA ht.1 h).trans (le_max_left _ _)⟩

theorem mlcCq_pos {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) : 0 < mlcCq r A B := by
  unfold mlcCq
  have hB : 0 < B := hA.trans hAB
  have : 0 < min (A ^ (r - 2)) (B ^ (r - 2)) := lt_min (Real.rpow_pos_of_pos hA _)
    (Real.rpow_pos_of_pos hB _)
  have : 0 < r - 1 := by linarith
  have : 0 < r := by linarith
  positivity

theorem mlcCq_le_dq {r A B t : ℝ} (hr : 1 < r) (hA : 0 < A) (ht : t ∈ Icc A B) :
    mlcCq r A B ≤ mlcdq r t := by
  unfold mlcCq mlcdq
  have : 0 < r - 1 := by linarith
  have := (mlc_rpow_bounds (r := r) hA ht).1
  gcongr

theorem mlc_dq_le_Mq {r A B t : ℝ} (hr : 1 < r) (hA : 0 < A) (ht : t ∈ Icc A B) :
    mlcdq r t ≤ mlcMq r A B := by
  unfold mlcMq mlcdq
  have : 0 < r - 1 := by linarith
  have := (mlc_rpow_bounds (r := r) hA ht).2
  gcongr

theorem mlc_q_contOn {r A : ℝ} (hA : 0 < A) {lo hi : ℝ} (hlo : A ≤ lo) :
    ContinuousOn (monoq r) (Icc lo hi) ∧ DifferentiableOn ℝ (monoq r) (interior (Icc lo hi)) := by
  have hd : ∀ t ∈ Icc lo hi, DifferentiableAt ℝ (monoq r) t := fun t ht =>
    (mlc_hasDerivAt_q r (by linarith [ht.1])).differentiableAt
  refine ⟨fun t ht => (hd t ht).continuousAt.continuousWithinAt, fun t ht => ?_⟩
  exact (hd t (interior_subset ht)).differentiableWithinAt

/-- `q` is `c`-expanding on `[A,B]`. -/
theorem mlc_q_expand {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) :
    ∀ s ∈ Icc A B, ∀ t ∈ Icc A B, s ≤ t → mlcCq r A B * (t - s) ≤ monoq r t - monoq r s := by
  intro s hs t ht hst
  obtain ⟨hc, hd⟩ := mlc_q_contOn (r := r) hA (le_refl A) (hi := B)
  refine (convex_Icc A B).mul_sub_le_image_sub_of_le_deriv hc hd (fun x hx => ?_) s hs t ht hst
  rw [interior_Icc] at hx
  rw [(mlc_hasDerivAt_q r (hA.trans hx.1)).deriv]
  exact mlcCq_le_dq hr hA (Ioo_subset_Icc_self hx)

theorem mlc_q_mono {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) {s t : ℝ}
    (hs : s ∈ Icc A B) (ht : t ∈ Icc A B) (hst : s ≤ t) : monoq r s ≤ monoq r t := by
  have := mlc_q_expand hr hA s hs t ht hst
  have := mlcCq_pos hr hA hAB
  nlinarith

theorem mlc_q_upper {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) :
    ∀ s ∈ Icc A B, ∀ t ∈ Icc A B, s ≤ t → monoq r t - monoq r s ≤ mlcMq r A B * (t - s) := by
  intro s hs t ht hst
  obtain ⟨hc, hd⟩ := mlc_q_contOn (r := r) hA (le_refl A) (hi := B)
  refine (convex_Icc A B).image_sub_le_mul_sub_of_deriv_le hc hd (fun x hx => ?_) s hs t ht hst
  rw [interior_Icc] at hx
  rw [(mlc_hasDerivAt_q r (hA.trans hx.1)).deriv]
  exact mlc_dq_le_Mq hr hA (Ioo_subset_Icc_self hx)

theorem mlc_q_lip {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) {s t : ℝ}
    (hs : s ∈ Icc A B) (ht : t ∈ Icc A B) : |monoq r t - monoq r s| ≤ mlcMq r A B * |t - s| := by
  rcases le_total s t with h | h
  · have h1 := mlc_q_upper hr hA s hs t ht h
    have h2 := mlc_q_mono hr hA hAB hs ht h
    rw [abs_of_nonneg (by linarith), abs_of_nonneg (by linarith)]; exact h1
  · have h1 := mlc_q_upper hr hA t ht s hs h
    have h2 := mlc_q_mono hr hA hAB ht hs h
    rw [abs_of_nonpos (by linarith), abs_of_nonpos (by linarith)]; linarith

theorem mlc_q_pos {r t : ℝ} (hr : 0 < r) (ht : 0 < t) : 0 < monoq r t := by
  unfold monoq; exact mul_pos hr (Real.rpow_pos_of_pos ht _)

theorem mlc_Q_lip {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) {s t : ℝ}
    (hs : s ∈ Icc A B) (ht : t ∈ Icc A B) : |monoQ r t - monoQ r s| ≤ monoq r B * |t - s| := by
  have hd : ∀ lo hi : ℝ, A ≤ lo → hi ≤ B → lo ≤ hi →
      monoQ r hi - monoQ r lo ≤ monoq r B * (hi - lo) ∧ 0 ≤ monoQ r hi - monoQ r lo := by
    intro lo hi hlo hhi hlh
    have hdd : ∀ u ∈ Icc lo hi, HasDerivAt (monoQ r) (monoq r u) u := fun u hu =>
      hasDerivAt_monoQ r (by linarith [hu.1])
    have hc : ContinuousOn (monoQ r) (Icc lo hi) := fun u hu =>
      (hdd u hu).continuousAt.continuousWithinAt
    have hdo : DifferentiableOn ℝ (monoQ r) (interior (Icc lo hi)) := fun u hu =>
      (hdd u (interior_subset hu)).differentiableAt.differentiableWithinAt
    constructor
    · refine (convex_Icc lo hi).image_sub_le_mul_sub_of_deriv_le hc hdo (fun x hx => ?_) lo
        ⟨le_rfl, hlh⟩ hi ⟨hlh, le_rfl⟩ hlh
      rw [interior_Icc] at hx
      rw [(hdd x (Ioo_subset_Icc_self hx)).deriv]
      exact mlc_q_mono hr hA hAB ⟨by linarith [hx.1], by linarith [hx.2]⟩ ⟨hAB.le, le_rfl⟩
        (by linarith [hx.2])
    · have := (convex_Icc lo hi).mul_sub_le_image_sub_of_le_deriv hc hdo (C := 0) (fun x hx => by
        rw [interior_Icc] at hx
        rw [(hdd x (Ioo_subset_Icc_self hx)).deriv]
        exact (mlc_q_pos (by linarith) (by linarith [hx.1])).le) lo
        ⟨le_rfl, hlh⟩ hi ⟨hlh, le_rfl⟩ hlh
      linarith
  rcases le_total s t with h | h
  · obtain ⟨h1, h2⟩ := hd s t hs.1 ht.2 h
    rw [abs_of_nonneg h2, abs_of_nonneg (by linarith)]; exact h1
  · obtain ⟨h1, h2⟩ := hd t s ht.1 hs.2 h
    rw [abs_sub_comm, abs_of_nonneg h2, abs_sub_comm, abs_of_nonneg (by linarith)]; exact h1

theorem mlcMq_nonneg {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) : 0 ≤ mlcMq r A B :=
  ((mlcCq_pos hr hA hAB).le.trans (mlcCq_le_dq hr hA ⟨le_rfl, hAB.le⟩)).trans
    (mlc_dq_le_Mq hr hA ⟨le_rfl, hAB.le⟩)

/-- **Taylor's formula** for `Q` at `t̄`: `|Q(τ) - Q(t̄) - q(t̄)(τ - t̄)| ≤ M (τ - t̄)^2`. -/
theorem mlc_taylor {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) {τ tb : ℝ}
    (hτ : τ ∈ Icc A B) (htb : tb ∈ Icc A B) :
    |monoQ r τ - monoQ r tb - monoq r tb * (τ - tb)| ≤ mlcMq r A B * (τ - tb) ^ 2 := by
  set g : ℝ → ℝ := fun u => monoQ r u - monoq r tb * u
  have hMq : 0 ≤ mlcMq r A B := mlcMq_nonneg hr hA hAB
  have key : ∀ lo hi : ℝ, A ≤ lo → hi ≤ B → lo ≤ hi → (∀ u ∈ Icc lo hi, |monoq r u - monoq r tb| ≤
      mlcMq r A B * (hi - lo)) → |g hi - g lo| ≤ mlcMq r A B * (hi - lo) * (hi - lo) := by
    intro lo hi hlo hhi hlh hb
    have hdd : ∀ u ∈ Icc lo hi, HasDerivAt g (monoq r u - monoq r tb) u := fun u hu => by
      have h1 := hasDerivAt_monoQ r (show 0 < u by linarith [hu.1])
      have h2 := (hasDerivAt_id u).const_mul (monoq r tb)
      have h3 := h1.sub h2
      rw [mul_one] at h3
      exact h3
    have hc : ContinuousOn g (Icc lo hi) := fun u hu => (hdd u hu).continuousAt.continuousWithinAt
    have hdo : DifferentiableOn ℝ g (interior (Icc lo hi)) := fun u hu =>
      (hdd u (interior_subset hu)).differentiableAt.differentiableWithinAt
    have h1 := (convex_Icc lo hi).image_sub_le_mul_sub_of_deriv_le hc hdo
      (C := mlcMq r A B * (hi - lo)) (fun x hx => by
        rw [(hdd x (interior_subset hx)).deriv]
        exact (le_abs_self _).trans (hb x (interior_subset hx))) lo ⟨le_rfl, hlh⟩ hi ⟨hlh, le_rfl⟩ hlh
    have h2 := (convex_Icc lo hi).mul_sub_le_image_sub_of_le_deriv hc hdo
      (C := -(mlcMq r A B * (hi - lo))) (fun x hx => by
        rw [(hdd x (interior_subset hx)).deriv]
        exact neg_le_of_abs_le (hb x (interior_subset hx))) lo ⟨le_rfl, hlh⟩ hi ⟨hlh, le_rfl⟩ hlh
    rw [abs_le]; constructor <;> nlinarith
  have e : monoQ r τ - monoQ r tb - monoq r tb * (τ - tb) = g τ - g tb := by simp only [g]; ring
  rw [e]
  rcases le_total tb τ with h | h
  · have := key tb τ htb.1 hτ.2 h (fun u hu => by
      have := mlc_q_lip hr hA hAB htb ⟨le_trans htb.1 hu.1, le_trans hu.2 hτ.2⟩
      rw [abs_of_nonneg (by linarith [hu.1] : (0:ℝ) ≤ u - tb)] at this
      exact this.trans (mul_le_mul_of_nonneg_left (by linarith [hu.2]) hMq))
    calc _ ≤ _ := this
      _ = _ := by ring
  · have := key τ tb hτ.1 htb.2 h (fun u hu => by
      have := mlc_q_lip hr hA hAB htb ⟨le_trans hτ.1 hu.1, le_trans hu.2 htb.2⟩
      rw [abs_sub_comm u tb, abs_of_nonneg (by linarith [hu.2] : (0:ℝ) ≤ tb - u)] at this
      exact this.trans (mul_le_mul_of_nonneg_left (by linarith [hu.1]) hMq))
    rw [abs_sub_comm]
    calc _ ≤ _ := this
      _ = _ := by ring

end

end Auto

