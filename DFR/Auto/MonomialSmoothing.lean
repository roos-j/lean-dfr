noncomputable section

/-! ### (8.8): `‖ψ̃‖_∞ + ‖ψ̃'‖_1 ≤ C (‖ψ‖_∞ + ‖ψ'‖_1)` -/

theorem ms8_W_nonneg (m : ℕ) {u : ℝ} (hu : 0 ≤ u) : 0 ≤ ms8W m u := by
  unfold ms8W; positivity

theorem ms8_W_le {m : ℕ} (hm : 0 < m) {α u : ℝ} (hα : 0 < α) (hu : α ≤ u) :
    ms8W m u ≤ (1 / m) * α ^ ((1 : ℝ) / m - 1) := by
  unfold ms8W
  have hm1 : (1 : ℝ) ≤ m := by exact_mod_cast hm
  have : (1 : ℝ) / m - 1 ≤ 0 := by
    rw [sub_nonpos, div_le_one (by linarith)]; exact hm1
  exact mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_nonpos hα hu this) (by positivity)

theorem ms8_W'_le {m : ℕ} (hm : 0 < m) {α u : ℝ} (hα : 0 < α) (hu : α ≤ u) :
    |(1 / m) * (((1 : ℝ) / m - 1) * u ^ ((1 : ℝ) / m - 1 - 1))| ≤
      (1 / m) * |(1 : ℝ) / m - 1| * α ^ ((1 : ℝ) / m - 1 - 1) := by
  have hm1 : (1 : ℝ) ≤ m := by exact_mod_cast hm
  have hu0 : 0 < u := hα.trans_le hu
  have : (1 : ℝ) / m - 1 - 1 ≤ 0 := by
    have : (1 : ℝ) / m ≤ 1 := by rw [div_le_one (by linarith)]; exact hm1
    linarith
  rw [abs_mul, abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 1 / m),
    abs_of_pos (Real.rpow_pos_of_pos hu0 _)]
  have h := Real.rpow_le_rpow_of_nonpos hα hu this
  have h0 : 0 ≤ 1 / (m : ℝ) * |(1 : ℝ) / m - 1| := by positivity
  calc _ = (1 / (m : ℝ) * |(1 : ℝ) / m - 1|) * u ^ ((1 : ℝ) / m - 1 - 1) := by ring
    _ ≤ _ := mul_le_mul_of_nonneg_left h h0

theorem ms8_deriv_sub_zero {m : ℕ} (hm : 0 < m) {a b : ℝ} (ha : 0 < a) {ψ : ℝ → ℝ}
    (hsupp : tsupport ψ ⊆ Icc a b) {u : ℝ} (hu : u < a ^ m) : deriv (ms8Sub m ψ) u = 0 := by
  have : ms8Sub m ψ =ᶠ[𝓝 u] fun _ => 0 := by
    filter_upwards [gt_mem_nhds hu] with v hv
    exact ms8_sub_eq_zero_of_lt hm ha hsupp hv
  rw [this.deriv_eq]; simp

theorem ms8_sub_bound {m : ℕ} (hm : 0 < m) {a b : ℝ} (ha : 0 < a) (hab : a < b) :
    ∃ K : ℝ, 0 < K ∧ ∀ ψ : ℝ → ℝ, ContDiff ℝ 1 ψ → tsupport ψ ⊆ Icc a b →
      (⨆ u, |ms8Sub m ψ u|) + ∫ u, |deriv (ms8Sub m ψ) u|
        ≤ K * ((⨆ t, |ψ t|) + ∫ t, |deriv ψ t|) := by
  set α : ℝ := a ^ m
  set β : ℝ := b ^ m
  have hα : 0 < α := pow_pos ha m
  have hαβ : α ≤ β := pow_le_pow_left₀ ha.le hab.le m
  set W : ℝ := (1 / m) * α ^ ((1 : ℝ) / m - 1)
  set W' : ℝ := (1 / m) * |(1 : ℝ) / m - 1| * α ^ ((1 : ℝ) / m - 1 - 1)
  have hW : 0 ≤ W := by positivity
  have hW' : 0 ≤ W' := by positivity
  refine ⟨W + W' * (β - α) + 1, by nlinarith, fun ψ hψ hsupp => ?_⟩
  have hψc : HasCompactSupport ψ := isCompact_Icc.of_isClosed_subset (isClosed_tsupport ψ) hsupp
  have hcont : Continuous ψ := hψ.continuous
  have hD : Continuous (deriv ψ) := hψ.continuous_deriv le_rfl
  have hDI : Integrable (deriv ψ) volume := hD.integrable_of_hasCompactSupport hψc.deriv
  set M := ⨆ t, |ψ t|
  have hM : ∀ t, |ψ t| ≤ M := ms8_abs_le_iSup hcont hψc
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  set V := ∫ t, |deriv ψ t|
  have hV0 : 0 ≤ V := integral_nonneg fun t => abs_nonneg _
  have hDsupp : tsupport (deriv ψ) ⊆ Icc a b := tsupport_deriv_subset.trans hsupp
  -- sup bound
  have hsup : (⨆ u, |ms8Sub m ψ u|) ≤ W * M := by
    refine ciSup_le fun u => ?_
    unfold ms8Sub
    split_ifs with hu
    · by_cases hne : ψ (ms8Rho m u) = 0
      · rw [hne, mul_zero, abs_zero]; positivity
      · have hI := ms8_mem_Icc_of_ne hm ha hsupp hu hne
        rw [abs_mul, abs_of_nonneg (ms8_W_nonneg m hu.le)]
        exact mul_le_mul (ms8_W_le hm hα hI.1) (hM _) (abs_nonneg _) hW
    · rw [abs_zero]; positivity
  -- derivative bound
  set F2 : ℝ → ℝ := fun u => ms8W m u * |deriv ψ (ms8Rho m u)|
  have hpt : ∀ u, |deriv (ms8Sub m ψ) u| ≤
      (Icc α β).indicator (fun _ => W' * M) u + W * (Icc α β).indicator F2 u := by
    intro u
    have hnn : 0 ≤ (Icc α β).indicator (fun _ => W' * M) u + W * (Icc α β).indicator F2 u := by
      refine add_nonneg (indicator_nonneg (fun _ _ => by positivity) u)
        (mul_nonneg hW (indicator_nonneg (fun v hv => ?_) u))
      exact mul_nonneg (ms8_W_nonneg m (hα.le.trans hv.1)) (abs_nonneg _)
    by_cases hu : 0 < u
    · rw [(ms8_hasDerivAt_sub hψ hu).deriv]
      by_cases hI : u ∈ Icc α β
      · rw [indicator_of_mem hI, indicator_of_mem hI]
        refine (abs_add_le _ _).trans (add_le_add ?_ ?_)
        · rw [abs_mul]
          exact mul_le_mul (ms8_W'_le hm hα hI.1) (hM _) (abs_nonneg _) hW'
        · simp only [F2]
          rw [abs_mul, abs_mul, abs_of_nonneg (ms8_W_nonneg m hu.le)]
          have hw := ms8_W_le hm hα hI.1
          have hw0 := ms8_W_nonneg m hu.le
          calc ms8W m u * (|deriv ψ (ms8Rho m u)| * ms8W m u)
              = ms8W m u * (ms8W m u * |deriv ψ (ms8Rho m u)|) := by ring
            _ ≤ W * (ms8W m u * |deriv ψ (ms8Rho m u)|) := by gcongr
      · have h1 : ψ (ms8Rho m u) = 0 := by
          by_contra hne; exact hI (ms8_mem_Icc_of_ne hm ha hsupp hu hne)
        have h2 : deriv ψ (ms8Rho m u) = 0 := by
          by_contra hne; exact hI (ms8_mem_Icc_of_ne hm ha hDsupp hu hne)
        rw [h1, h2]; simpa using hnn
    · rw [ms8_deriv_sub_zero hm ha hsupp (lt_of_le_of_lt (not_lt.mp hu) hα)]
      simpa using hnn
  -- integrability of the majorant
  have hF2c : ContinuousOn F2 (Icc α β) := by
    intro u hu
    have hu0 : 0 < u := hα.trans_le hu.1
    have c1 : ContinuousAt (ms8W m) u := (ms8_hasDerivAt_W m hu0).continuousAt
    have c2 : ContinuousAt (ms8Rho m) u := (ms8_hasDerivAt_rho m hu0).continuousAt
    exact (c1.mul (continuous_abs.continuousAt.comp (hD.continuousAt.comp c2))).continuousWithinAt
  have hF2I : Integrable ((Icc α β).indicator F2) volume :=
    (hF2c.integrableOn_Icc).integrable_indicator measurableSet_Icc
  have hF1I : Integrable ((Icc α β).indicator fun _ : ℝ => W' * M) volume :=
    (integrableOn_const (by simp [Real.volume_Icc])).integrable_indicator measurableSet_Icc
  have hint : ∫ u, |deriv (ms8Sub m ψ) u| ≤ W' * M * (β - α) + W * V := by
    refine (integral_mono_of_nonneg (Eventually.of_forall fun u => abs_nonneg _)
      (hF1I.add (hF2I.const_mul W)) (Eventually.of_forall hpt)).trans ?_
    rw [integral_add' hF1I (hF2I.const_mul W), integral_const_mul,
      integral_indicator_const _ measurableSet_Icc, Real.volume_real_Icc_of_le hαβ, smul_eq_mul]
    have hF2V : ∫ u, (Icc α β).indicator F2 u ≤ V := by
      have e : (Icc α β).indicator F2 = (Ioi (0 : ℝ)).indicator F2 := by
        funext u
        by_cases hI : u ∈ Icc α β
        · rw [indicator_of_mem hI, indicator_of_mem (show u ∈ Ioi (0:ℝ) from hα.trans_le hI.1)]
        · rw [indicator_of_notMem hI]
          by_cases hu : u ∈ Ioi (0 : ℝ)
          · rw [indicator_of_mem hu]
            have h2 : deriv ψ (ms8Rho m u) = 0 := by
              by_contra hne; exact hI (ms8_mem_Icc_of_ne hm ha hDsupp hu hne)
            simp [F2, h2]
          · rw [indicator_of_notMem hu]
      rw [e, integral_indicator measurableSet_Ioi]
      have hp : (1 : ℝ) / m ≠ 0 := by
        have : (0 : ℝ) < m := by exact_mod_cast hm
        positivity
      have hcv := integral_comp_rpow_Ioi (fun t => |deriv ψ t|) hp
      have e2 : ∫ u in Ioi (0 : ℝ), F2 u =
          ∫ x in Ioi (0 : ℝ), (|(1 : ℝ) / m| * x ^ ((1 : ℝ) / m - 1)) • |deriv ψ (x ^ ((1 : ℝ) / m))| := by
        refine setIntegral_congr_fun measurableSet_Ioi fun u _ => ?_
        simp only [F2, ms8W, ms8Rho, smul_eq_mul]
        have hm0 : (0 : ℝ) < m := by exact_mod_cast hm
        rw [abs_of_pos (show (0 : ℝ) < 1 / (m : ℝ) by positivity)]
      rw [e2, hcv]
      exact setIntegral_le_integral hDI.abs (Eventually.of_forall fun t => abs_nonneg _)
    nlinarith
  calc (⨆ u, |ms8Sub m ψ u|) + ∫ u, |deriv (ms8Sub m ψ) u|
      ≤ W * M + (W' * M * (β - α) + W * V) := add_le_add hsup hint
    _ ≤ (W + W' * (β - α) + 1) * (M + V) := by
        have : 0 ≤ W' * (β - α) := mul_nonneg hW' (by linarith)
        nlinarith

end

end Auto

