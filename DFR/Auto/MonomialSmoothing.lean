/-! ### Fiber cutoffs of `χ_m` as Schwartz functions (line 307: constants unchanged by
translation and dilation) -/

theorem monoBeta_contDiff : ContDiff ℝ ∞ monoBeta :=
  monoPhi_contDiff.comp ((contDiff_const.mul contDiff_id).div_const 3)

theorem monoBeta_eq_zero {x : ℝ} (hx : 3 / 2 ≤ |x|) : monoBeta x = 0 :=
  monoPhi_eq_zero (by rw [abs_div, abs_mul]; norm_num; linarith)

theorem monoBeta_bounds (x : ℝ) : 0 ≤ monoBeta x ∧ monoBeta x ≤ 1 :=
  ⟨Real.smoothTransition.nonneg _, Real.smoothTransition.le_one _⟩

/-- A dilated, translated, rescaled copy `c β(x/h - a)` of `β`, as a complex function. -/
def monoBetaFib (h a c : ℝ) (x : ℝ) : ℂ := ((c * monoBeta (x / h - a) : ℝ) : ℂ)

theorem monoBetaFib_contDiff (h a c : ℝ) : ContDiff ℝ ∞ (monoBetaFib h a c) :=
  Complex.ofRealCLM.contDiff.comp (contDiff_const.mul (monoBeta_contDiff.comp
    ((contDiff_id.div_const h).sub contDiff_const)))

theorem monoBetaFib_hasCompactSupport {h : ℝ} (hh : 0 < h) (a c : ℝ) :
    HasCompactSupport (monoBetaFib h a c) := by
  refine HasCompactSupport.of_support_subset_isCompact
    (isCompact_Icc (a := h * (a - 3 / 2)) (b := h * (a + 3 / 2))) ?_
  intro x hx
  by_contra hc
  apply hx
  have : 3 / 2 ≤ |x / h - a| := by
    simp only [mem_Icc, not_and_or, not_le] at hc
    rcases hc with hc | hc
    · have : x / h < a - 3 / 2 := by rw [div_lt_iff₀ hh]; nlinarith
      rw [abs_of_neg (by linarith)]; linarith
    · have : a + 3 / 2 < x / h := by rw [lt_div_iff₀ hh]; nlinarith
      rw [abs_of_pos (by linarith)]; linarith
  simp [monoBetaFib, monoBeta_eq_zero this]

/-- The fiber cutoff as a Schwartz function. -/
def monoBetaFibS {h : ℝ} (hh : 0 < h) (a c : ℝ) : 𝓢(ℝ, ℂ) :=
  (monoBetaFib_hasCompactSupport hh a c).toSchwartzMap (monoBetaFib_contDiff h a c)

theorem monoBetaFibS_apply {h : ℝ} (hh : 0 < h) (a c x : ℝ) :
    monoBetaFibS hh a c x = monoBetaFib h a c x := rfl

theorem norm_monoBetaFibS_le {h : ℝ} (hh : 0 < h) (a : ℝ) {c : ℝ} (hc0 : 0 ≤ c) (hc1 : c ≤ 1)
    (x : ℝ) : ‖monoBetaFibS hh a c x‖ ≤ 1 := by
  rw [monoBetaFibS_apply, monoBetaFib, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (mul_nonneg hc0 (monoBeta_bounds _).1)]
  exact mul_le_one₀ hc1 (monoBeta_bounds _).1 (monoBeta_bounds _).2

/-- `𝓕(c β(·/h - a))(ξ) = c h e(-h a ξ) 𝓕β(h ξ)`. -/
theorem fourier_monoBetaFib {h : ℝ} (hh : 0 < h) (a c ξ : ℝ) :
    𝓕 (monoBetaFib h a c) ξ
      = (c * h : ℂ) * (𝐞 (-(h * a * ξ)) : Circle) * 𝓕 (monoBetaFib 1 0 1) (h * ξ) := by
  rw [Real.fourier_real_eq, Real.fourier_real_eq]
  have e1 : ∀ v : ℝ, 𝐞 (-(v * ξ)) • monoBetaFib h a c v
      = (fun u : ℝ => (c : ℂ) * ((𝐞 (-(h * a * ξ)) : Circle) * (𝐞 (-(u * (h * ξ))) •
          monoBetaFib 1 0 1 u))) (v / h - a) := by
    intro v
    simp only [monoBetaFib, Circle.smul_def, smul_eq_mul, div_one, sub_zero, one_mul]
    have : (𝐞 (-(v * ξ)) : ℂ) = (𝐞 (-(h * a * ξ)) : Circle) * (𝐞 (-((v / h - a) * (h * ξ))) : Circle) := by
      rw [← Circle.coe_mul, ← AddChar.map_add_eq_mul]; congr 2; field_simp; ring
    rw [this]; push_cast; ring
  simp_rw [e1]
  set g : ℝ → ℂ := fun u => (c : ℂ) * ((𝐞 (-(h * a * ξ)) : Circle) *
      (𝐞 (-(u * (h * ξ))) • monoBetaFib 1 0 1 u))
  have h1 : ∫ v : ℝ, g (v / h - a) = ∫ w : ℝ, (fun w => g (w - a)) (w / h) := rfl
  rw [h1, Measure.integral_comp_div (fun w => g (w - a)) h, integral_sub_right_eq_self g a,
    abs_of_pos hh]
  simp only [g, integral_const_mul, Complex.real_smul]
  push_cast; ring

end

end Auto

