  have := (hA.dt p.1.1 p.1.2).2 0 (by norm_num) p.2
  simpa using this

/-- `L²` bound for the trilinear integrand. -/
theorem mfk_tri_lint_bound {Λ h x0 y0 t0 : ℝ} (hΛ : 0 < Λ) (hh : 0 < h) {A : (ℝ × ℝ) × ℝ → ℂ}
    (hA : MfkAmp Λ h x0 y0 t0 A) (c q : ℝ) {f g : ℝ × ℝ → ℂ} (hf : Measurable f) (hg : Measurable g) :
    ∫⁻ p : (ℝ × ℝ) × ℝ, ‖f (p.1.1 + p.2, p.1.2) * g (p.1.1, p.1.2 + c + q * p.2) * A p‖ₑ
      ≤ ENNReal.ofReal (Λ * (2 * (Λ * h))) * eLpNorm f 2 volume * eLpNorm g 2 volume := by
  have hAm := hA.cont.measurable
  set I := Icc (t0 - Λ * h) (t0 + Λ * h)
  set N := eLpNorm f 2 volume * eLpNorm g 2 volume
  rw [show (volume : Measure ((ℝ × ℝ) × ℝ)) = volume.prod volume from rfl,
    lintegral_prod_symm _ (by fun_prop)]
  have hin : ∀ t : ℝ, ∫⁻ z : ℝ × ℝ, ‖f ((z, t).1.1 + (z, t).2, (z, t).1.2) *
      g ((z, t).1.1, (z, t).1.2 + c + q * (z, t).2) * A (z, t)‖ₑ ≤
      I.indicator (fun _ => ENNReal.ofReal Λ * N) t := by
    intro t
    by_cases ht : t ∈ I
    · rw [indicator_of_mem ht]
      calc _ ≤ ∫⁻ z : ℝ × ℝ, ‖f (z + (t, 0))‖ₑ * ‖g (z + (0, c + q * t))‖ₑ * ENNReal.ofReal Λ := by
            apply lintegral_mono
            intro z
            dsimp only
            rw [enorm_mul, enorm_mul]
            have e1 : (z.1 + t, z.2) = z + (t, 0) := by ext <;> simp
            have e2 : (z.1, z.2 + c + q * t) = z + (0, c + q * t) := by ext <;> simp; ring
            rw [e1, e2]
            gcongr
            rw [← ofReal_norm]
            exact ENNReal.ofReal_le_ofReal (hA.norm_le _)
        _ = (∫⁻ z : ℝ × ℝ, ‖f (z + (t, 0))‖ₑ * ‖g (z + (0, c + q * t))‖ₑ) * ENNReal.ofReal Λ :=
            lintegral_mul_const _ (by fun_prop)
        _ ≤ N * ENNReal.ofReal Λ := by gcongr; exact mfk_slice_holder hf hg _ _
        _ = _ := mul_comm _ _
    · rw [indicator_of_notMem ht]
      apply le_of_eq
      apply lintegral_eq_zero_of_ae_eq_zero (ae_of_all _ (fun z => ?_))
      have hA0 : A (z, t) = 0 := by
        by_contra hne
        exact ht (mfk_mem_Icc_of_abs (hA.supp _ hne).2.2)
      simp [hA0]
  calc _ ≤ ∫⁻ t : ℝ, I.indicator (fun _ => ENNReal.ofReal Λ * N) t := lintegral_mono hin
    _ = ENNReal.ofReal Λ * N * volume I := lintegral_indicator_const measurableSet_Icc _
    _ = _ := by
      rw [Real.volume_Icc, show t0 + Λ * h - (t0 - Λ * h) = 2 * (Λ * h) by ring,
        ENNReal.ofReal_mul hΛ.le]
      simp only [N]; ring

end

