theorem mfk_mem_Icc_of_abs {u u0 r : ℝ} (h : |u - u0| ≤ r) : u ∈ Icc (u0 - r) (u0 + r) := by
  rw [abs_le] at h; constructor <;> linarith [h.1, h.2]

theorem mfk_phi_bound_x {Λ h x0 y0 t0 : ℝ} (hΛ : 0 < Λ) (hh : 0 < h) {A : (ℝ × ℝ) × ℝ → ℂ}
    (hA : MfkAmp Λ h x0 y0 t0 A) (c q : ℝ) (ξ η : ℝ × ℝ) :
    ‖mfkPhi A c q ξ η‖ ≤ 2 ^ 13 * Λ ^ 2 * h / (1 + h * |ξ.1 + η.1|) ^ 12 * (2 * (Λ * h)) ^ 2 := by
  have := mfk_dir_bound mfkEX mfkEX_mp _ (mfk_phi_integrand_integrable hA c q ξ η)
    (Icc (y0 - Λ * h) (y0 + Λ * h) ×ˢ Icc (t0 - Λ * h) (t0 + Λ * h)) mfk_box_lt_top
    (B := 2 ^ 13 * Λ ^ 2 * h / (1 + h * |ξ.1 + η.1|) ^ 12) ?_ ?_
  · rwa [mfk_box_vol (by positivity)] at this
  · rintro ⟨y, t⟩
    simp only [mfkEX_apply]
    have hph : ∀ s : ℝ, mfkPh c q ξ η ((s, y), t) =
        (t * ξ.1 + y * ξ.2 + (y + c + q * t) * η.2) + s * (ξ.1 + η.1) := by
      intro s; unfold mfkPh; ring
    simp_rw [hph]
    exact mfk_inner_bound hΛ hh (hA.dx y t).1 (hA.dx y t).2
      (fun s hs => (hA.supp _ hs).1) _ _
  · rintro ⟨y, t⟩ hw s
    simp only [mfkEX_apply]
    by_contra hne
    have hA0 : A ((s, y), t) ≠ 0 := fun h0 => hne (by rw [h0, mul_zero])
    obtain ⟨_, h2, h3⟩ := hA.supp _ hA0
    exact hw ⟨mfk_mem_Icc_of_abs h2, mfk_mem_Icc_of_abs h3⟩

theorem mfk_phi_bound_y {Λ h x0 y0 t0 : ℝ} (hΛ : 0 < Λ) (hh : 0 < h) {A : (ℝ × ℝ) × ℝ → ℂ}
    (hA : MfkAmp Λ h x0 y0 t0 A) (c q : ℝ) (ξ η : ℝ × ℝ) :
    ‖mfkPhi A c q ξ η‖ ≤ 2 ^ 13 * Λ ^ 2 * h / (1 + h * |ξ.2 + η.2|) ^ 12 * (2 * (Λ * h)) ^ 2 := by
  have := mfk_dir_bound mfkEY mfkEY_mp _ (mfk_phi_integrand_integrable hA c q ξ η)
    (Icc (x0 - Λ * h) (x0 + Λ * h) ×ˢ Icc (t0 - Λ * h) (t0 + Λ * h)) mfk_box_lt_top
    (B := 2 ^ 13 * Λ ^ 2 * h / (1 + h * |ξ.2 + η.2|) ^ 12) ?_ ?_
  · rwa [mfk_box_vol (by positivity)] at this
  · rintro ⟨x, t⟩
    simp only [mfkEY_apply]
    have hph : ∀ s : ℝ, mfkPh c q ξ η ((x, s), t) =
        ((x + t) * ξ.1 + x * η.1 + (c + q * t) * η.2) + s * (ξ.2 + η.2) := by
      intro s; unfold mfkPh; ring
    simp_rw [hph]
    exact mfk_inner_bound hΛ hh (hA.dy x t).1 (hA.dy x t).2
      (fun s hs => (hA.supp _ hs).2.1) _ _
  · rintro ⟨x, t⟩ hw s
    simp only [mfkEY_apply]
    by_contra hne
    have hA0 : A ((x, s), t) ≠ 0 := fun h0 => hne (by rw [h0, mul_zero])
    obtain ⟨h1, _, h3⟩ := hA.supp _ hA0
    exact hw ⟨mfk_mem_Icc_of_abs h1, mfk_mem_Icc_of_abs h3⟩

theorem mfk_phi_bound_t {Λ h x0 y0 t0 : ℝ} (hΛ : 0 < Λ) (hh : 0 < h) {A : (ℝ × ℝ) × ℝ → ℂ}
    (hA : MfkAmp Λ h x0 y0 t0 A) (c q : ℝ) (ξ η : ℝ × ℝ) :
    ‖mfkPhi A c q ξ η‖ ≤
      2 ^ 13 * Λ ^ 2 * h / (1 + h * |ξ.1 + q * η.2|) ^ 12 * (2 * (Λ * h)) ^ 2 := by
  have := mfk_dir_bound mfkET mfkET_mp _ (mfk_phi_integrand_integrable hA c q ξ η)
    (Icc (x0 - Λ * h) (x0 + Λ * h) ×ˢ Icc (y0 - Λ * h) (y0 + Λ * h)) mfk_box_lt_top
    (B := 2 ^ 13 * Λ ^ 2 * h / (1 + h * |ξ.1 + q * η.2|) ^ 12) ?_ ?_
  · rwa [mfk_box_vol (by positivity)] at this
  · rintro ⟨x, y⟩
    simp only [mfkET_apply]
    have hph : ∀ s : ℝ, mfkPh c q ξ η ((x, y), s) =
        (x * ξ.1 + y * ξ.2 + x * η.1 + (y + c) * η.2) + s * (ξ.1 + q * η.2) := by
      intro s; unfold mfkPh; ring
    simp_rw [hph]
    exact mfk_inner_bound hΛ hh (hA.dt x y).1 (hA.dt x y).2
      (fun s hs => (hA.supp _ hs).2.2) _ _
  · rintro ⟨x, y⟩ hw s
    simp only [mfkET_apply]
    by_contra hne
    have hA0 : A ((x, y), s) ≠ 0 := fun h0 => hne (by rw [h0, mul_zero])
    obtain ⟨h1, h2, _⟩ := hA.supp _ hA0
    exact hw ⟨mfk_mem_Icc_of_abs h1, mfk_mem_Icc_of_abs h2⟩

end

