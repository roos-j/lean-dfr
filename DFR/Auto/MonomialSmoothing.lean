theorem mfk_iteratedDeriv_zero_outside {g : ℝ → ℂ} {a b : ℝ}
    (hs : ∀ x, g x ≠ 0 → x ∈ Icc a b) (k : ℕ) {x : ℝ} (hx : x ∉ Icc a b) :
    iteratedDeriv k g x = 0 := by
  have ht : tsupport g ⊆ Icc a b := closure_minimal (fun x hx => hs x hx) isClosed_Icc
  have h0 : iteratedFDeriv ℝ k g x = 0 := by
    by_contra hne
    exact hx (ht (support_iteratedFDeriv_subset k hne))
  rw [iteratedDeriv_eq_iteratedFDeriv, h0]
  rfl

theorem mfk_hasCompactSupport_of {g : ℝ → ℂ} {a b : ℝ}
    (hs : ∀ x, g x ≠ 0 → x ∈ Icc a b) : HasCompactSupport g :=
  HasCompactSupport.of_support_subset_isCompact isCompact_Icc (fun x hx => hs x hx)

theorem mfk_integral_norm_iteratedDeriv_le {g : ℝ → ℂ} {a b M : ℝ} (hab : a ≤ b)
    (hg : ContDiff ℝ 12 g) (hs : ∀ x, g x ≠ 0 → x ∈ Icc a b) {k : ℕ} (hk : k ≤ 12)
    (hM : ∀ x, ‖iteratedDeriv k g x‖ ≤ M) :
    ∫ x, ‖iteratedDeriv k g x‖ ≤ M * (b - a) := by
  have h0 : ∀ x, x ∉ Icc a b → ‖iteratedDeriv k g x‖ = 0 := by
    intro x hx; rw [mfk_iteratedDeriv_zero_outside hs k hx, norm_zero]
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero (s := Icc a b) h0]
  have := norm_setIntegral_le_of_norm_le_const (μ := volume) (s := Icc a b)
    (f := fun x => ‖iteratedDeriv k g x‖) (C := M) (by simp)
    (fun x _ => by rw [norm_norm]; exact hM x)
  rw [Real.volume_real_Icc_of_le hab] at this
  exact (le_abs_self _).trans (by simpa [Real.norm_eq_abs] using this)

theorem mfk_integrable_iteratedDeriv {g : ℝ → ℂ} {a b : ℝ}
    (hg : ContDiff ℝ 12 g) (hs : ∀ x, g x ≠ 0 → x ∈ Icc a b) (k : ℕ) (hk : k ≤ 12) :
    Integrable (iteratedDeriv k g) := by
  have hc : Continuous (iteratedDeriv k g) := hg.continuous_iteratedDeriv k (by exact_mod_cast hk)
  apply hc.integrable_of_hasCompactSupport
  exact HasCompactSupport.of_support_subset_isCompact isCompact_Icc
    (fun x hx => by
      by_contra hn
      exact hx (mfk_iteratedDeriv_zero_outside hs k hn))

theorem mfk_fourier_mul_pow_le {g : ℝ → ℂ} {a b : ℝ}
    (hg : ContDiff ℝ 12 g) (hs : ∀ x, g x ≠ 0 → x ∈ Icc a b) (w : ℝ) :
    ‖𝓕 g w‖ * (2 * Real.pi * |w|) ^ 12 ≤ ∫ x, ‖iteratedDeriv 12 g x‖ := by
  have hF := Real.fourier_iteratedDeriv (N := 12) (n := 12) hg
    (fun n hn => mfk_integrable_iteratedDeriv hg hs n (by exact_mod_cast hn)) le_rfl
  have h1 := congrFun hF w
  have h2 : ‖𝓕 (iteratedDeriv 12 g) w‖ ≤ ∫ x, ‖iteratedDeriv 12 g x‖ := by
    rw [Real.fourier_eq]
    refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
    congr 1; ext x
    rw [Circle.norm_smul]
  rw [h1, norm_smul] at h2
  refine le_of_eq_of_le ?_ h2
  rw [mul_comm]
  congr 1
  simp only [norm_pow, norm_mul, Complex.norm_ofNat, Complex.norm_real, Real.norm_eq_abs,
    Complex.norm_I, mul_one, abs_of_pos Real.pi_pos]

end

