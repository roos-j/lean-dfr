/-- `(χ G)^ = χ̂ * Ĝ` for Schwartz `χ` and integrable `G`. -/
theorem fourier_schwartz_mul (χ : 𝓢(ℝ, ℂ)) {G : ℝ → ℂ} (hG : Integrable G volume) (ξ : ℝ) :
    𝓕 (fun x => χ x * G x) ξ = ∫ η, 𝓕 (⇑χ) η * 𝓕 G (ξ - η) := by
