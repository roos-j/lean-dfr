/-! ### Globalization: summing (averaging) the per-`q` bounds -/

theorem ms7_G_L2 (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L R₁ : ℝ) {u : ℝ × ℝ → ℂ} (hu : Measurable u) :
    (∫⁻ z, ms7G j κ L R₁ u z ^ (2 : ℝ)) ^ (1 / 2 : ℝ) ≤
      (∫⁻ s, ms7Tail κ L R₁ s) * eLpNorm u 2 volume :=
  ms7_dom_young j (ms7_measTail κ L R₁) hu

theorem ms7_H_L2 (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L) {u : ℝ × ℝ → ℂ}
    (hu : Measurable u) :
    (∫⁻ z, ms7H j κ L u z ^ (2 : ℝ)) ^ (1 / 2 : ℝ) ≤ (∫⁻ s, ‖κ s‖ₑ) * eLpNorm u 2 volume := by
  rw [← ms7_kerL1 κ hL]
  exact ms7_dom_young j (ms7_measK κ L).enorm hu

/-- **Global bound** from the local `L^2` bound: for every `R_1 ≥ 0`,
`4 ‖T_ψ(P_1u_1,P_2u_2)‖_1 ≤ (M_2 (2(R_0+R_1))^2 + C ‖ψ‖ (τ_1 N_2 + N_1 τ_2)) ‖u_1‖_2 ‖u_2‖_2`,
with `τ_i` the tails of the kernels beyond `R_1`. -/
theorem ms7_glob_bound {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) {C₁ : ℝ}
    (hloc : ∀ ψ : ℝ → ℝ, ContDiff ℝ ∞ ψ → tsupport ψ ⊆ Icc A B →
      ∀ (q : ℝ × ℝ) (f g : ℝ × ℝ → ℂ), Measurable f → Measurable g →
        eLpNorm (fun z => (ms7Chi (z - q) : ℂ) * monoT r ψ f g z) 1 volume ≤
          ENNReal.ofReal (C₁ * monoC20 ψ) *
            eLpNorm ((ms7Box q (ms7R0 r B)).indicator f) (12 / 7 : ℝ≥0∞) volume *
            eLpNorm ((ms7Box q (ms7R0 r B)).indicator g) (12 / 7 : ℝ≥0∞) volume)
    {ψ : ℝ → ℝ} (hψ : ContDiff ℝ ∞ ψ) (hsupp : tsupport ψ ⊆ Icc A B)
    {κ₁ κ₂ : 𝓢(ℝ, ℂ)} {L₁ L₂ : ℝ} (hL₁ : 0 < L₁) (hL₂ : 0 < L₂) {M₂ : ℝ≥0∞}
    (HL2 : ∀ (q : ℝ × ℝ) (u₁ u₂ : ℝ × ℝ → ℂ), Measurable u₁ → Measurable u₂ →
        eLpNorm u₁ 2 volume ≠ ⊤ → eLpNorm u₂ 2 volume ≠ ⊤ →
        eLpNorm (fun z => (ms7Chi (z - q) : ℂ) *
            monoT r ψ (monoP 0 κ₁ L₁ u₁) (monoP 1 κ₂ L₂ u₂) z) 1 volume ≤
          M₂ * eLpNorm u₁ 2 volume * eLpNorm u₂ 2 volume)
    {R₁ : ℝ} (hR₁ : 0 ≤ R₁) {u₁ u₂ : ℝ × ℝ → ℂ} (hu₁ : Measurable u₁) (hu₂ : Measurable u₂)
    (h₁ : eLpNorm u₁ 2 volume ≠ ⊤) (h₂ : eLpNorm u₂ 2 volume ≠ ⊤) :
    ENNReal.ofReal 4 * eLpNorm (monoT r ψ (monoP 0 κ₁ L₁ u₁) (monoP 1 κ₂ L₂ u₂)) 1 volume ≤
      (M₂ * ENNReal.ofReal ((2 * (ms7R0 r B + R₁)) ^ 2) +
        ENNReal.ofReal (C₁ * monoC20 ψ) * ENNReal.ofReal (((2 * ms7R0 r B) ^ 2) ^ (1 / 12 : ℝ)) *
          ENNReal.ofReal (((2 * ms7R0 r B) ^ 2) ^ (1 / 12 : ℝ)) *
          ENNReal.ofReal ((2 * ms7R0 r B) ^ 2) *
          ((∫⁻ s, ms7Tail κ₁ L₁ R₁ s) * (∫⁻ s, ‖κ₂ s‖ₑ) +
            (∫⁻ s, ‖κ₁ s‖ₑ) * (∫⁻ s, ms7Tail κ₂ L₂ R₁ s))) *
        eLpNorm u₁ 2 volume * eLpNorm u₂ 2 volume := by
  have hr0 : 0 < r := by linarith
  have hψm : Measurable ψ := hψ.continuous.measurable
  have hR0 := (ms7R0_pos (r := r) (hA.trans hAB)).le
  set R₀ := ms7R0 r B
  set k := ENNReal.ofReal (C₁ * monoC20 ψ) * ENNReal.ofReal (((2 * R₀) ^ 2) ^ (1 / 12 : ℝ)) *
    ENNReal.ofReal (((2 * R₀) ^ 2) ^ (1 / 12 : ℝ))
  set a := ms7Loc (fun z => ‖u₁ z‖ₑ) (R₀ + R₁)
  set b := ms7Loc (fun z => ‖u₂ z‖ₑ) (R₀ + R₁)
  set g₁ := ms7Loc (ms7G 0 κ₁ L₁ R₁ u₁) R₀
  set g₂ := ms7Loc (ms7G 1 κ₂ L₂ R₁ u₂) R₀
  set h₁' := ms7Loc (ms7H 0 κ₁ L₁ u₁) R₀
  set h₂' := ms7Loc (ms7H 1 κ₂ L₂ u₂) R₀
  have ma : Measurable a := ms7Loc_meas hu₁.enorm _
  have mb : Measurable b := ms7Loc_meas hu₂.enorm _
  have mg₁ : Measurable g₁ := ms7Loc_meas (ms7G_meas 0 κ₁ L₁ R₁ hu₁) _
  have mg₂ : Measurable g₂ := ms7Loc_meas (ms7G_meas 1 κ₂ L₂ R₁ hu₂) _
  have mh₁ : Measurable h₁' := ms7Loc_meas (ms7H_meas 0 κ₁ L₁ hu₁) _
  have mh₂ : Measurable h₂' := ms7Loc_meas (ms7H_meas 1 κ₂ L₂ hu₂) _
  have Iab : ∫⁻ q, a q * b q ≤ ENNReal.ofReal ((2 * (R₀ + R₁)) ^ 2) *
      (eLpNorm u₁ 2 volume * eLpNorm u₂ 2 volume) := by
    have := ms7_avg hu₁.enorm hu₂.enorm (R := R₀ + R₁) (by linarith)
    rwa [← eLpNorm_two_eq_lintegral, ← eLpNorm_two_eq_lintegral] at this
  have Ig : ∫⁻ q, g₁ q * h₂' q ≤ ENNReal.ofReal ((2 * R₀) ^ 2) *
      (((∫⁻ s, ms7Tail κ₁ L₁ R₁ s) * eLpNorm u₁ 2 volume) *
        ((∫⁻ s, ‖κ₂ s‖ₑ) * eLpNorm u₂ 2 volume)) :=
    (ms7_avg (ms7G_meas 0 κ₁ L₁ R₁ hu₁) (ms7H_meas 1 κ₂ L₂ hu₂) hR0).trans
      (ms7_mul_le_left (mul_le_mul' (ms7_G_L2 0 κ₁ L₁ R₁ hu₁) (ms7_H_L2 1 κ₂ hL₂ hu₂)) _)
  have Ih : ∫⁻ q, h₁' q * g₂ q ≤ ENNReal.ofReal ((2 * R₀) ^ 2) *
      (((∫⁻ s, ‖κ₁ s‖ₑ) * eLpNorm u₁ 2 volume) *
        ((∫⁻ s, ms7Tail κ₂ L₂ R₁ s) * eLpNorm u₂ 2 volume)) :=
    (ms7_avg (ms7H_meas 0 κ₁ L₁ hu₁) (ms7G_meas 1 κ₂ L₂ R₁ hu₂) hR0).trans
      (ms7_mul_le_left (mul_le_mul' (ms7_H_L2 0 κ₁ hL₁ hu₁) (ms7_G_L2 1 κ₂ L₂ R₁ hu₂)) _)
  calc ENNReal.ofReal 4 * eLpNorm (monoT r ψ (monoP 0 κ₁ L₁ u₁) (monoP 1 κ₂ L₂ u₂)) 1 volume
      ≤ ∫⁻ q, eLpNorm (fun z => (ms7Chi (z - q) : ℂ) *
          monoT r ψ (monoP 0 κ₁ L₁ u₁) (monoP 1 κ₂ L₂ u₂) z) 1 volume :=
        ms7_cover (ms7_measT hr0 hψm (ms7_measP 0 κ₁ L₁ hu₁) (ms7_measP 1 κ₂ L₂ hu₂))
    _ ≤ ∫⁻ q, (M₂ * (a q * b q) + k * (g₁ q * h₂' q + h₁' q * g₂ q)) := by
        refine lintegral_mono fun q => ?_
        refine (ms7_perq (R₁ := R₁) hr hA hAB hloc hψ hsupp hL₁ hL₂ HL2 hu₁ hu₂ h₁ h₂ q).trans (le_of_eq ?_)
        ring
    _ = M₂ * (∫⁻ q, a q * b q) + k * ((∫⁻ q, g₁ q * h₂' q) + ∫⁻ q, h₁' q * g₂ q) := by
        rw [lintegral_add_left (f := fun q => M₂ * (a q * b q)) (by fun_prop),
          lintegral_const_mul M₂ (f := fun q => a q * b q) (by fun_prop),
          lintegral_const_mul k (f := fun q => g₁ q * h₂' q + h₁' q * g₂ q) (by fun_prop),
          lintegral_add_left (f := fun q => g₁ q * h₂' q) (by fun_prop)]
    _ ≤ M₂ * (ENNReal.ofReal ((2 * (R₀ + R₁)) ^ 2) *
          (eLpNorm u₁ 2 volume * eLpNorm u₂ 2 volume)) +
        k * (ENNReal.ofReal ((2 * R₀) ^ 2) *
          (((∫⁻ s, ms7Tail κ₁ L₁ R₁ s) * eLpNorm u₁ 2 volume) *
            ((∫⁻ s, ‖κ₂ s‖ₑ) * eLpNorm u₂ 2 volume)) +
          ENNReal.ofReal ((2 * R₀) ^ 2) *
          (((∫⁻ s, ‖κ₁ s‖ₑ) * eLpNorm u₁ 2 volume) *
            ((∫⁻ s, ms7Tail κ₂ L₂ R₁ s) * eLpNorm u₂ 2 volume))) := by
        gcongr
    _ = _ := by ring

end

