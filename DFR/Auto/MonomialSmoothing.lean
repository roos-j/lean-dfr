/-! ### (5.13): counting the possible slopes (lines 850-891) -/

/-- Points with bounded multiplicity in intervals of length `h` meet an interval of length `ℓ` in
at most `M₀ (ℓ/h + 2)` points. -/
theorem card_filter_Icc_le {ι : Type*} (T : Finset ι) (t : ι → ℝ) {h M₀ : ℝ} (hh : 0 < h)
    (hmult : ∀ a, ((T.filter fun i => t i ∈ Icc a (a + h)).card : ℝ) ≤ M₀) (a ℓ : ℝ) (hℓ : 0 ≤ ℓ) :
    ((T.filter fun i => t i ∈ Icc a (a + ℓ)).card : ℝ) ≤ M₀ * (ℓ / h + 2) := by
  classical
  obtain ⟨K, hK⟩ : ∃ K : ℕ, ℓ / h ≤ K ∧ (K : ℝ) ≤ ℓ / h + 1 :=
    ⟨⌈ℓ / h⌉₊, Nat.le_ceil _, (Nat.ceil_lt_add_one (by positivity)).le⟩
  have hM0 : 0 ≤ M₀ := (Nat.cast_nonneg _).trans (hmult a)
  have hsub : T.filter (fun i => t i ∈ Icc a (a + ℓ))
      ⊆ (Finset.range (K + 1)).biUnion fun k => T.filter fun i => t i ∈ Icc (a + k * h) (a + k * h + h) := by
    intro i hi
    simp only [Finset.mem_filter, mem_Icc] at hi
    obtain ⟨hiT, h1, h2⟩ := hi
    set k := ⌊(t i - a) / h⌋₊
    have hk1 : (k : ℝ) ≤ (t i - a) / h := Nat.floor_le (div_nonneg (by linarith) hh.le)
    have hk2 : (t i - a) / h < k + 1 := Nat.lt_floor_add_one _
    have hkK : k ≤ K := by
      have : (t i - a) / h ≤ ℓ / h := div_le_div_of_nonneg_right (by linarith) hh.le
      exact_mod_cast (Nat.floor_le_floor this).trans (Nat.floor_le_of_le hK.1) |>.trans le_rfl
    simp only [Finset.mem_biUnion, Finset.mem_range, Finset.mem_filter, mem_Icc]
    refine ⟨k, by omega, hiT, ?_, ?_⟩
    · rw [le_div_iff₀ hh] at hk1; linarith
    · rw [div_lt_iff₀ hh] at hk2; nlinarith
  calc ((T.filter fun i => t i ∈ Icc a (a + ℓ)).card : ℝ)
      ≤ (((Finset.range (K + 1)).biUnion fun k =>
          T.filter fun i => t i ∈ Icc (a + k * h) (a + k * h + h)).card : ℝ) := by
        exact_mod_cast Finset.card_le_card hsub
    _ ≤ ∑ k ∈ Finset.range (K + 1),
          ((T.filter fun i => t i ∈ Icc (a + k * h) (a + k * h + h)).card : ℝ) := by
        exact_mod_cast Finset.card_biUnion_le
    _ ≤ ∑ k ∈ Finset.range (K + 1), M₀ := Finset.sum_le_sum fun k _ => hmult _
    _ = (K + 1) * M₀ := by rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]; push_cast; ring
    _ ≤ M₀ * (ℓ / h + 2) := by nlinarith [hK.2]

/-- The level sets of the slopes: `{t ∈ I : |k₁ - q(t) k₂| ≤ U}` lies in an interval of length
`2U/(c|k₂|)` when `q` is `c`-expanding on `I`. -/
theorem slope_level_interval {q : ℝ → ℝ} {c : ℝ} (hc : 0 < c) {I : Set ℝ}
    (hq : ∀ s ∈ I, ∀ t ∈ I, s ≤ t → c * (t - s) ≤ q t - q s) {k₁ k₂ U : ℝ} (hk : k₂ ≠ 0)
    {s t : ℝ} (hs : s ∈ I) (ht : t ∈ I) (hs' : |k₁ - q s * k₂| ≤ U) (ht' : |k₁ - q t * k₂| ≤ U) :
    |t - s| ≤ 2 * U / (c * |k₂|) := by
  have hk2 : 0 < |k₂| := abs_pos.mpr hk
  have hdiff : |(q t - q s) * k₂| ≤ 2 * U := by
    have : (q t - q s) * k₂ = (k₁ - q s * k₂) - (k₁ - q t * k₂) := by ring
    rw [this]; exact (abs_sub _ _).trans (by linarith)
  rw [abs_mul] at hdiff
  have hqd : c * |t - s| ≤ |q t - q s| := by
    rcases le_total s t with h | h
    · have h1 := hq s hs t ht h
      have h2 : 0 ≤ t - s := by linarith
      have h3 : 0 ≤ q t - q s := le_trans (mul_nonneg hc.le h2) h1
      rw [abs_of_nonneg h2, abs_of_nonneg h3]; exact h1
    · have h1 := hq t ht s hs h
      have h2 : 0 ≤ s - t := by linarith
      have h3 : 0 ≤ q s - q t := le_trans (mul_nonneg hc.le h2) h1
      rw [abs_sub_comm t s, abs_sub_comm (q t) (q s), abs_of_nonneg h2, abs_of_nonneg h3]; exact h1
  rw [le_div_iff₀ (by positivity)]
  nlinarith [abs_nonneg (t - s)]

end

