/-- The weighted Fourier energy appearing in (5.10). -/
def mfkX (h q : ℝ) (F : ℝ × ℝ → ℂ) : ℝ≥0∞ :=
  (∫⁻ ξ, ‖mfkF2 F ξ‖ₑ ^ 2 * ENNReal.ofReal ((1 + |h * (ξ.1 - q * ξ.2)|) ^ (-8 : ℝ))) ^ (1/2 : ℝ)

theorem mfkW_eq (u : ℝ) : mfkW u = (1 + |u|) ^ (-8 : ℝ) := by
  rw [mfkW, Real.rpow_neg (by positivity)]
  norm_cast

/-- The constant of the kernel bound. -/
def mfkC (Λ qhi : ℝ) : ℝ := 3 ^ 12 * (2 ^ 15 * Λ ^ 4) * (2 * max 1 qhi) ^ 8 * mfkJ ^ 2

theorem mfkC_nonneg (Λ qhi : ℝ) : 0 ≤ mfkC Λ qhi := by
  unfold mfkC
  have hJ : 0 ≤ mfkJ := integral_nonneg (fun s => by positivity)
  have : 0 ≤ max 1 qhi := le_trans zero_le_one (le_max_left _ _)
  positivity

theorem mfk_phi_le_K {Λ h x0 y0 t0 : ℝ} (hΛ : 0 < Λ) (hh : 0 < h) {A : (ℝ × ℝ) × ℝ → ℂ}
    (hA : MfkAmp Λ h x0 y0 t0 A) (c q : ℝ) (ξ η : ℝ × ℝ) :
    ‖mfkPhi A c q ξ η‖ₑ ≤ ENNReal.ofReal (3 ^ 12 * (2 ^ 15 * Λ ^ 4 * h ^ 3) * mfkK h q ξ η) := by
  rw [← ofReal_norm]
  apply ENNReal.ofReal_le_ofReal
  have hb := mfk_phi_bound hΛ hh hA c q ξ η
