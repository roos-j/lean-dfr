      ∀ L : ℝ, 1 ≤ L → ∀ u₁ u₂ : ℝ × ℝ → ℂ, Measurable u₁ → Measurable u₂ →
      (∀ z, ‖u₁ z‖ ≤ 1) → (∀ z, ‖u₂ z‖ ≤ 1) →
        eLpNorm (fun z => (χ z : ℂ) * monoT r ψ (monoP 0 monoKPsiA L u₁) (monoP 1 monoKPhi L u₂) z)
            1 volume ≤ ENNReal.ofReal (C * L ^ (-((1 / 39 : ℝ) / 256))) ∧
        eLpNorm (fun z => (χ z : ℂ) *
            monoT r ψ (monoP 0 monoKPhi (L / 2) u₁) (monoP 1 monoKPsiA L u₂) z)
            1 volume ≤ ENNReal.ofReal (C * L ^ (-((1 / 39 : ℝ) / 256))) := by
  set Â := (∫ s, ‖monoKPsiA s‖) + ∫ s, ‖monoKPhi s‖
  have hkA : 0 ≤ ∫ s, ‖monoKPsiA s‖ := integral_nonneg fun _ => norm_nonneg _
  have hkP : 0 ≤ ∫ s, ‖monoKPhi s‖ := integral_nonneg fun _ => norm_nonneg _
  have hÂ : 0 ≤ Â := by positivity
  obtain ⟨C₁, hC₁0, h₁⟩ := mono61_loc hr hA hAB hLC χ hχ hχc monoPsiE_contDiff
    monoPsiE_hasCompactSupport (fun x hx => monoPsiE_eq_zero_large hx) monoPhiE_contDiff
    monoPhiE_hasCompactSupport (fun x hx => monoPhiE_eq_zero' hx) hÂ
  obtain ⟨C₂, hC₂0, h₂⟩ := mono61_loc hr hA hAB hLC χ hχ hχc monoPhiE_contDiff
    monoPhiE_hasCompactSupport (fun x hx => monoPhiE_eq_zero' hx) monoPsiE_contDiff
    monoPsiE_hasCompactSupport (fun x hx => monoPsiE_eq_zero_large hx) hÂ
  set σ : ℝ := (1 / 39 : ℝ) / 256
  set c16 : ℝ := (2 ^ 16 : ℝ) ^ σ
  have hc16 : 0 < c16 := by positivity
  set Iχ := ∫ z, |χ z|
  have hIχ : 0 ≤ Iχ := integral_nonneg fun _ => abs_nonneg _
  have hχi : Integrable χ volume := hχ.continuous.integrable_of_hasCompactSupport hχc
  set Cs := Iχ * (B - A) * Â * Â * c16
  have hCs : 0 ≤ Cs := by have : 0 ≤ B - A := by linarith
                          positivity
  refine ⟨C₁ + C₂ + Cs + 1, by positivity, ?_⟩
  intro ψ hψ hψs hC20 L hL u₁ u₂ hu₁ hu₂ hb₁ hb₂
  have hL0 : 0 < L := by linarith
  have hLσ : 0 ≤ L ^ (-σ) := by positivity
  have hr0 : 0 < r := by linarith
  have hψi := integrable_of_tsupport_Icc hψ hψs
  have hψv := vanish_of_tsupport hψs
  have hbP : ∀ (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L' : ℝ), 0 < L' → (∫ s, ‖κ s‖) ≤ Â →
      ∀ u : ℝ × ℝ → ℂ, (∀ z, ‖u z‖ ≤ 1) → ∀ z, ‖monoP j κ L' u z‖ ≤ Â := fun j κ L' hL' hk u hu z =>
    (mloc_P_norm_le j κ hL' hu z).trans (by rw [mul_one]; exact hk)
  have hkA' : (∫ s, ‖monoKPsiA s‖) ≤ Â := by linarith
  have hkP' : (∫ s, ‖monoKPhi s‖) ≤ Â := by linarith
  -- the small-`L` case
  have hsmall : ∀ f₁ f₂ : ℝ × ℝ → ℂ, (∀ z, ‖f₁ z‖ ≤ Â) → (∀ z, ‖f₂ z‖ ≤ Â) → L < 2 ^ 16 →
      eLpNorm (fun z => (χ z : ℂ) * monoT r ψ f₁ f₂ z) 1 volume
        ≤ ENNReal.ofReal ((C₁ + C₂ + Cs + 1) * L ^ (-σ)) := by
    intro f₁ f₂ hf₁ hf₂ hL16
    refine (eLpNorm_chiT_le hχi hψi hψv hÂ hÂ (fun z _ t _ => hf₁ _) (fun z _ t _ => hf₂ _)).trans ?_
    refine ENNReal.ofReal_le_ofReal ?_
    have hIψ : ∫ t, |ψ t| ≤ 1 * (B - A) :=
      integral_abs_le_of_Icc hAB.le hψv fun t =>
        (abs_le_monoC20 hψ (isCompact_Icc.of_isClosed_subset (isClosed_tsupport ψ) hψs) t).trans hC20
    have h1 : 1 ≤ c16 * L ^ (-σ) := by
      rw [Real.rpow_neg hL0.le, ← div_eq_mul_inv, le_div_iff₀ (by positivity), one_mul]
      exact Real.rpow_le_rpow hL0.le hL16.le (by positivity)
    have h2 : Iχ * (∫ t, |ψ t|) * Â * Â ≤ Iχ * (B - A) * Â * Â := by
      have := hIψ; rw [one_mul] at this; gcongr
    calc Iχ * (∫ t, |ψ t|) * Â * Â ≤ Iχ * (B - A) * Â * Â := h2
      _ ≤ Iχ * (B - A) * Â * Â * (c16 * L ^ (-σ)) := by
          have : 0 ≤ Iχ * (B - A) * Â * Â := by have : 0 ≤ B - A := by linarith
                                                positivity
          nlinarith
      _ = Cs * L ^ (-σ) := by ring
      _ ≤ (C₁ + C₂ + Cs + 1) * L ^ (-σ) := by gcongr; linarith
  have hmP : ∀ (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L' : ℝ) (u : ℝ × ℝ → ℂ), Measurable u →
      Measurable (monoP j κ L' u) := fun j κ L' u hu => measurable_monoP' j κ L' hu
  constructor
  · by_cases hL16 : 2 ^ 16 ≤ L
