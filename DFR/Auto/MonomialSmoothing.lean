/-- The bilinear average `A_ψ(g)(x) = ∫ ψ(t) ∏_n g_n(x + t^{α_n} e_n) dt` on `ℝ^2`. -/
def ms8Average (α : Fin 2 → ℕ) (ψ : ℝ → ℝ) (g : Fin 2 → EuclideanSpace ℝ (Fin 2) → ℂ)
    (x : EuclideanSpace ℝ (Fin 2)) : ℂ :=
  ∫ t : ℝ, (ψ t : ℂ) * ∏ n, g n (x + (t ^ α n) • EuclideanSpace.single n (1 : ℝ))

theorem ms8_E_symm_E (x : EuclideanSpace ℝ (Fin 2)) : ms8E.symm (ms8E x) = x :=
  ms8E.symm_apply_apply x

theorem ms8_add_single0 (x : EuclideanSpace ℝ (Fin 2)) (c : ℝ) :
    x + c • EuclideanSpace.single 0 (1 : ℝ) = ms8E.symm ((ms8E x).1 + c, (ms8E x).2) := by
  ext i
  fin_cases i <;> simp [ms8_E_symm_apply0, ms8_E_symm_apply1, ms8_E_apply]

theorem ms8_add_single1 (x : EuclideanSpace ℝ (Fin 2)) (c : ℝ) :
    x + c • EuclideanSpace.single 1 (1 : ℝ) = ms8E.symm ((ms8E x).1, (ms8E x).2 + c) := by
  ext i
  fin_cases i <;> simp [ms8_E_symm_apply0, ms8_E_symm_apply1, ms8_E_apply]

theorem ms8_average_eq (α : Fin 2 → ℕ) (ψ : ℝ → ℝ) (g : Fin 2 → EuclideanSpace ℝ (Fin 2) → ℂ) :
    ms8Average α ψ g =
      ms8AvgP (α 0) (α 1) ψ (g 0 ∘ ms8E.symm) (g 1 ∘ ms8E.symm) ∘ ms8E := by
  funext x
  simp only [ms8Average, ms8AvgP, Fin.prod_univ_two, Function.comp_apply, ms8_add_single0,
    ms8_add_single1]

theorem ms8_average_eq_swap (α : Fin 2 → ℕ) (ψ : ℝ → ℝ)
    (g : Fin 2 → EuclideanSpace ℝ (Fin 2) → ℂ) :
    ms8Average α ψ g =
      ms8AvgP (α 1) (α 0) ψ (g 1 ∘ ms8E.symm ∘ Prod.swap) (g 0 ∘ ms8E.symm ∘ Prod.swap) ∘
        Prod.swap ∘ ms8E := by
  funext x
  simp only [ms8Average, ms8AvgP, Fin.prod_univ_two, Function.comp_apply, ms8_add_single0,
    ms8_add_single1, Prod.fst_swap, Prod.snd_swap, Prod.swap_prod_mk]
  congr 1; funext t; ring

theorem ms8_fib_swap (f : ℝ × ℝ → ℂ) (j : Fin 2) (p : ℝ) :
    monoFib j (f ∘ Prod.swap) p = monoFib (1 - j) f p := by
  funext a
  fin_cases j <;> simp [monoFib, monoPt]

theorem ms8_measurable_avgP {m n : ℕ} (hm : 0 < m) (hmn : m < n) {a b : ℝ} (ha : 0 < a)
    {ψ : ℝ → ℝ} (hψ : ContDiff ℝ 1 ψ) (hsupp : tsupport ψ ⊆ Icc a b) {f₁ f₂ : ℝ × ℝ → ℂ}
    (hf₁ : Measurable f₁) (hf₂ : Measurable f₂) : Measurable (ms8AvgP m n ψ f₁ f₂) := by
  rw [ms8_avgP_eq hm ha hsupp]
  have hr : (0 : ℝ) < (n : ℝ) / m := by
    have : (0 : ℝ) < m := by exact_mod_cast hm
    have : (0 : ℝ) < n := by exact_mod_cast (hm.trans hmn)
    positivity
  exact ms8_measurable_monoT hr (ms8_sub_contDiff hm ha hψ hsupp).continuous.measurable hf₁ hf₂

theorem ms8_target
    (hG : ∀ r A B : ℝ, 1 < r → 0 < A → A < B → ∃ C s : ℝ, 0 < C ∧ 0 < s ∧ MonoGlobal77 r A B C s)
    (α : Fin 2 → ℕ) (hα : ∀ n, 0 < α n) (hα' : α 0 ≠ α 1) (a b : ℝ) (ha : 0 < a) (hab : a < b) :
    ∃ C δ : ℝ, 0 < C ∧ 0 < δ ∧ ∀ ψ : ℝ → ℝ, ContDiff ℝ 1 ψ → tsupport ψ ⊆ Set.Icc a b →
      ∀ lam : ℝ, 1 ≤ lam → ∀ g : Fin 2 → 𝓢(EuclideanSpace ℝ (Fin 2), ℂ),
        (∃ n, ∀ ξ, 𝓕 (g n : EuclideanSpace ℝ (Fin 2) → ℂ) ξ ≠ 0 → lam ≤ |ξ n|) →
        eLpNorm (ms8Average α ψ fun n => ⇑(g n)) 1 volume
          ≤ ENNReal.ofReal (C * ((⨆ t, |ψ t|) + ∫ t, |deriv ψ t|) * lam ^ (-δ)) *
            (eLpNorm (g 0) 2 volume * eLpNorm (g 1) 2 volume) := by
  rcases lt_or_gt_of_ne hα' with hlt | hgt
  · obtain ⟨C, δ, hC, hδ, hP⟩ := ms8_plane hG (hα 0) hlt ha hab
    refine ⟨C, δ, hC, hδ, fun ψ hψ hsupp lam hlam g hF => ?_⟩
    obtain ⟨c0, ⟨M0, hM0⟩, e0, n0, fib0⟩ := ms8_schwartz_props (g 0)
    obtain ⟨c1, ⟨M1, hM1⟩, e1, n1, fib1⟩ := ms8_schwartz_props (g 1)
    rw [ms8_average_eq, eLpNorm_comp_measurePreserving
      (ms8_measurable_avgP (hα 0) hlt ha hψ hsupp c0.measurable c1.measurable).aestronglyMeasurable
      ms8_E_mp, ← e0, ← e1]
    refine hP ψ hψ hsupp lam hlam _ _ c0.measurable c1.measurable M0 M1 hM0 hM1 (fib0 0) (fib1 1)
      (by rw [e0]; exact n0) (by rw [e1]; exact n1) ?_
    obtain ⟨n, hn⟩ := hF
    fin_cases n
    · exact Or.inl fun p ξ hξ => ms8_fiber_fourier_zero (g 0) 0 hn hξ p
    · exact Or.inr fun p ξ hξ => ms8_fiber_fourier_zero (g 1) 1 hn hξ p
  · obtain ⟨C, δ, hC, hδ, hP⟩ := ms8_plane hG (hα 1) hgt ha hab
    refine ⟨C, δ, hC, hδ, fun ψ hψ hsupp lam hlam g hF => ?_⟩
    obtain ⟨c0, ⟨M0, hM0⟩, e0, n0, fib0⟩ := ms8_schwartz_props (g 0)
    obtain ⟨c1, ⟨M1, hM1⟩, e1, n1, fib1⟩ := ms8_schwartz_props (g 1)
    have hsw : MeasurePreserving (Prod.swap : ℝ × ℝ → ℝ × ℝ) volume volume := by
      rw [Measure.volume_eq_prod]; exact Measure.measurePreserving_swap
    have e0' : eLpNorm (⇑(g 0) ∘ ms8E.symm ∘ Prod.swap) 2 volume = eLpNorm (⇑(g 0)) 2 volume := by
      rw [← e0, ← Function.comp_assoc]
      exact eLpNorm_comp_measurePreserving c0.aestronglyMeasurable hsw
    have e1' : eLpNorm (⇑(g 1) ∘ ms8E.symm ∘ Prod.swap) 2 volume = eLpNorm (⇑(g 1)) 2 volume := by
      rw [← e1, ← Function.comp_assoc]
      exact eLpNorm_comp_measurePreserving c1.aestronglyMeasurable hsw
    have m0 : Measurable (⇑(g 0) ∘ ms8E.symm ∘ Prod.swap) := c0.measurable.comp measurable_swap
    have m1 : Measurable (⇑(g 1) ∘ ms8E.symm ∘ Prod.swap) := c1.measurable.comp measurable_swap
    rw [ms8_average_eq_swap, ← Function.comp_assoc, eLpNorm_comp_measurePreserving
      ((ms8_measurable_avgP (hα 1) hgt ha hψ hsupp m1 m0).comp measurable_swap).aestronglyMeasurable
      ms8_E_mp, eLpNorm_comp_measurePreserving
      (ms8_measurable_avgP (hα 1) hgt ha hψ hsupp m1 m0).aestronglyMeasurable hsw,
      mul_comm (eLpNorm (⇑(g 0)) 2 volume) (eLpNorm (⇑(g 1)) 2 volume),
      ← e0', ← e1']
    have fb1 : ∀ p, monoFib 0 (⇑(g 1) ∘ ms8E.symm ∘ Prod.swap) p = monoFib 1 (⇑(g 1) ∘ ms8E.symm) p :=
      fun p => by rw [← Function.comp_assoc, ms8_fib_swap]; rfl
    have fb0 : ∀ p, monoFib 1 (⇑(g 0) ∘ ms8E.symm ∘ Prod.swap) p = monoFib 0 (⇑(g 0) ∘ ms8E.symm) p :=
      fun p => by rw [← Function.comp_assoc, ms8_fib_swap]; rfl
    refine hP ψ hψ hsupp lam hlam _ _ m1 m0 M1 M0 (fun z => hM1 _) (fun z => hM0 _)
      (fun p => by rw [fb1]; exact fib1 1 p) (fun p => by rw [fb0]; exact fib0 0 p)
      (by rw [e1']; exact n1) (by rw [e0']; exact n0) ?_
    obtain ⟨n, hn⟩ := hF
    fin_cases n
    · exact Or.inr fun p ξ hξ => by rw [fb0]; exact ms8_fiber_fourier_zero (g 0) 0 hn hξ p
    · exact Or.inl fun p ξ hξ => by rw [fb1]; exact ms8_fiber_fourier_zero (g 1) 1 hn hξ p

end

