theorem mfk_inner_plane (z ξ : ℝ × ℝ) :
    inner ℝ (smoothingPlaneEquiv.symm z) (smoothingPlaneEquiv.symm ξ) = z.1 * ξ.1 + z.2 * ξ.2 := by
  obtain ⟨z1, z2⟩ := z
  obtain ⟨x1, x2⟩ := ξ
  change inner ℝ (WithLp.toLp 2 ![z1, z2] : EuclideanSpace ℝ (Fin 2)) (WithLp.toLp 2 ![x1, x2]) = _
  simp [PiLp.inner_apply, Fin.sum_univ_two]
  ring

theorem mfk_plane_mp :
    MeasurePreserving smoothingPlaneEquiv.toHomeomorph.toMeasurableEquiv volume volume :=
  smoothingPlaneEquiv_measurePreserving

/-- `mfkF2` in terms of Mathlib's Fourier transform. -/
theorem mfkF2_eq_fourier (G : ℝ × ℝ → ℂ) (ξ : ℝ × ℝ) :
    mfkF2 G ξ = 𝓕 (fun x => G (smoothingPlaneEquiv x)) (smoothingPlaneEquiv.symm ξ) := by
  rw [Real.fourier_eq]
  rw [mfkF2, ← mfk_plane_mp.integral_comp']
  congr 1; ext x
  change Complex.exp (-(2 * Real.pi * Complex.I * (((smoothingPlaneEquiv x).1 : ℂ) * ξ.1 + ((smoothingPlaneEquiv x).2 : ℂ) * ξ.2))) * G (smoothingPlaneEquiv x) = Real.fourierChar (-(inner ℝ x (smoothingPlaneEquiv.symm ξ))) • G (smoothingPlaneEquiv x)
  rw [Circle.smul_def, smul_eq_mul, Real.fourierChar_apply]
  have hx : x = smoothingPlaneEquiv.symm (smoothingPlaneEquiv x) := by simp
  conv_rhs => rw [hx, mfk_inner_plane]
  simp only [ContinuousLinearEquiv.apply_symm_apply]
  congr 2
  push_cast; ring

end

