theorem monoAct_one' (w : ℝ × ℝ) : monoAct 1 w = w.2 := by simp [monoAct]
theorem monoEj_zero' (a : ℝ) : monoEj 0 a = (a, 0) := by simp [monoEj, monoPt]
theorem monoEj_one' (a : ℝ) : monoEj 1 a = (0, a) := by simp [monoEj, monoPt]

theorem enorm_ofReal_complex {x : ℝ} (hx : 0 ≤ x) : ‖(x : ℂ)‖ₑ = ENNReal.ofReal x := by
  rw [← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg hx]

/-- The count `N = ⌊9/ρ⌋ + 1` of components satisfies `N² ≤ 100 ρ⁻²`. -/
theorem card_sq_le {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ ≤ 1) :
    ((⌊9 / ρ⌋₊ + 1 : ℕ) : ℝ) ^ 2 ≤ 100 * ρ⁻¹ ^ 2 := by
  have h1 : ((⌊9 / ρ⌋₊ + 1 : ℕ) : ℝ) ≤ 10 * ρ⁻¹ := by
    push_cast
    have := Nat.floor_le (a := 9 / ρ) (by positivity)
    have h2 : 1 ≤ ρ⁻¹ := one_le_inv₀ hρ |>.mpr hρ1
    have h3 : 9 / ρ = 9 * ρ⁻¹ := div_eq_mul_inv _ _
    linarith
  calc ((⌊9 / ρ⌋₊ + 1 : ℕ) : ℝ) ^ 2 ≤ (10 * ρ⁻¹) ^ 2 := pow_le_pow_left₀ (by positivity) h1 2
    _ = 100 * ρ⁻¹ ^ 2 := by ring

theorem mono61_ss {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) (χ : ℝ × ℝ → ℝ)
    (hχ : ContDiff ℝ ∞ χ) (hχc : HasCompactSupport χ) {a0 : ℝ} (ha0 : 0 ≤ a0) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ ψ : ℝ → ℝ, ContDiff ℝ ∞ ψ → tsupport ψ ⊆ Icc A B → monoC20 ψ ≤ 1 →
    ∀ L : ℝ, 2 ^ 16 ≤ L → ∀ high₁ high₂ : Bool, (high₁ = true ∨ high₂ = true) →
    ∀ (M₁ E₁ Ω₁ Λ₁ M₂ E₂ Ω₂ Λ₂ : ℝ) (G₁ G₂ : ℤ × ℤ → ℝ × ℝ → ℂ),
      (∀ m, MonoGoodPiece 0 (L ^ (-(3 / 4 : ℝ))) M₁ E₁ Ω₁ Λ₁ m (G₁ m)) →
      (∀ m, MonoGoodPiece 1 (L ^ (-(3 / 4 : ℝ))) M₂ E₂ Ω₂ Λ₂ m (G₂ m)) →
      0 ≤ M₁ → M₁ ≤ a0 → 0 ≤ M₂ → M₂ ≤ a0 →
      (high₁ = true → ∀ m p ξ, |ξ| < L / 4 → 𝓕 (monoFib 0 (G₁ m) p) ξ = 0) →
      (high₂ = true → ∀ m p ξ, |ξ| < L / 4 → 𝓕 (monoFib 1 (G₂ m) p) ξ = 0) →
      ∀ S₁ S₂ : Finset (ℤ × ℤ),
      eLpNorm (fun z => (χ z : ℂ) * monoT r ψ
          (fun w => ∑ m ∈ S₁, monoVSharp 0 (L ^ (-(3 / 4 : ℝ))) (L ^ (13 / 16 : ℝ))
            (L ^ (-((1 / 39 : ℝ) / 64))) m (G₁ m) w)
          (fun w => ∑ m ∈ S₂, monoVSharp 1 (L ^ (-(3 / 4 : ℝ))) (L ^ (13 / 16 : ℝ))
            (L ^ (-((1 / 39 : ℝ) / 64))) m (G₂ m) w) z) 1 volume
        ≤ ENNReal.ofReal (C * L ^ (-((1 / 39 : ℝ) / 256))) := by
  obtain ⟨Cβ, hCβ0, hCβ⟩ := exists_deriv_monoBeta_bound
  have hk0 := monoKappa_L1_nonneg
  have hk1 := monoKappa'_L1_nonneg
  set C0 : ℝ := 2 + Cβ + ∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖ with hC0_def
  have hC0 : 1 ≤ C0 := by linarith
  obtain ⟨Css, hCss0, hss⟩ := mss_sharpsharp hr hA hAB χ hχ hχc C0 (1 / 8) hC0 (by norm_num)
  set Bh : ℝ := ((∫ u, ‖monoKappa u‖) + 1) * (a0 + 1) with hBh_def
  have hBh0 : 0 < Bh := by positivity
  refine ⟨200 * Bh ^ 2 * Css, by positivity, ?_⟩
  intro ψ hψ hψs hC20 L hL high₁ high₂ hhigh M₁ E₁ Ω₁ Λ₁ M₂ E₂ Ω₂ Λ₂ G₁ G₂ hG₁ hG₂ hM₁0 hM₁ hM₂0 hM₂
    hlow₁ hlow₂ S₁ S₂
  have hL1 : 1 ≤ L := le_trans (by norm_num) hL
  have hL0 : 0 < L := by linarith
  obtain ⟨-, -, -, hp4, hp5, -, -⟩ := mono61_params hL1
  obtain ⟨hh, hh1, -, -, -, hR1, hRL8, -, hRh, -, hS0, hS2, hρ0, hρ1⟩ := mono61_facts hL
  set h := L ^ (-(3 / 4 : ℝ)) with hh_def
  set R := L ^ (13 / 16 : ℝ) with hR_def
  set S := L ^ (7 / 8 : ℝ) with hS_def
  set ρ := L ^ (-((1 / 39 : ℝ) / 64)) with hρ_def
  set N := ⌊9 / ρ⌋₊ + 1 with hN_def
  have hR0 : 0 < R := by linarith
  have hBh1 : ∀ M, 0 ≤ M → M ≤ a0 → (∫ u, ‖monoKappa u‖) * M ≤ Bh := fun M hM0 hM => by
    rw [hBh_def]; nlinarith
  have hBh2 : ∀ M, 0 ≤ M → M ≤ a0 → M ≤ Bh := fun M hM0 hM => by rw [hBh_def]; nlinarith
  -- the modulated components
  set H₁ : ℤ × ℤ → ℕ → ℝ × ℝ → ℂ := fun m ν => monoSSH 0 high₁ h R ρ L Bh G₁ m ν
  set H₂ : ℤ × ℤ → ℕ → ℝ × ℝ → ℂ := fun m ν => monoSSH 1 high₂ h R ρ L Bh G₂ m ν
  set ω₁ : ℤ × ℤ → ℕ → ℝ → ℝ := fun m ν => monoSSω 0 high₁ R ρ L G₁ m ν
  set ω₂ : ℤ × ℤ → ℕ → ℝ → ℝ := fun m ν => monoSSω 1 high₂ R ρ L G₂ m ν
  have e₁ : (fun w => ∑ m ∈ S₁, monoVSharp 0 h R ρ m (G₁ m) w) = fun w => (Bh : ℂ) *
      ∑ m ∈ S₁, ∑ ν ∈ Finset.range N,
        H₁ m ν w * Complex.exp (2 * Real.pi * Complex.I * (ω₁ m ν w.2 * w.1)) := by
    funext w
    rw [sum_monoVSharp_eq hG₁ hR1 hρ0 hRL8 hBh0.ne' hlow₁ S₁ w, monoPas_zero', monoAct_zero']
  have e₂ : (fun w => ∑ m ∈ S₂, monoVSharp 1 h R ρ m (G₂ m) w) = fun w => (Bh : ℂ) *
      ∑ m ∈ S₂, ∑ ν ∈ Finset.range N,
        H₂ m ν w * Complex.exp (2 * Real.pi * Complex.I * (ω₂ m ν w.1 * w.2)) := by
    funext w
    rw [sum_monoVSharp_eq hG₂ hR1 hρ0 hRL8 hBh0.ne' hlow₂ S₂ w, monoPas_one', monoAct_one']
  rw [e₁, e₂]
  have eT : (fun z => (χ z : ℂ) * monoT r ψ
      (fun w => (Bh : ℂ) * ∑ m ∈ S₁, ∑ ν ∈ Finset.range N,
        H₁ m ν w * Complex.exp (2 * Real.pi * Complex.I * (ω₁ m ν w.2 * w.1)))
      (fun w => (Bh : ℂ) * ∑ m ∈ S₂, ∑ ν ∈ Finset.range N,
        H₂ m ν w * Complex.exp (2 * Real.pi * Complex.I * (ω₂ m ν w.1 * w.2))) z)
      = ((Bh ^ 2 : ℝ) : ℂ) • fun z => (χ z : ℂ) * monoT r ψ
      (fun w => ∑ m ∈ S₁, ∑ ν ∈ Finset.range N,
        H₁ m ν w * Complex.exp (2 * Real.pi * Complex.I * (ω₁ m ν w.2 * w.1)))
      (fun w => ∑ m ∈ S₂, ∑ ν ∈ Finset.range N,
        H₂ m ν w * Complex.exp (2 * Real.pi * Complex.I * (ω₂ m ν w.1 * w.2))) z := by
    funext z
    simp only [Pi.smul_apply, smul_eq_mul]
    rw [monoT_smul_left, monoT_smul_right]
    push_cast; ring
  rw [eT, eLpNorm_const_smul, enorm_ofReal_complex (by positivity)]
  have hmain := hss ψ hψ hψs hC20 h R S L N hh hh1 hRh hS0 hS2 S₁ S₂ H₁ H₂ ω₁ ω₂
    (fun m ν => measurable_monoSSH hG₁ hR0 hρ0 m ν) (fun m ν => measurable_monoSSH hG₂ hR0 hρ0 m ν)
    (fun m ν => measurable_monoSSω hG₁ hR0 hρ0 m ν) (fun m ν => measurable_monoSSω hG₂ hR0 hρ0 m ν)
    (fun m ν z hz => by
      obtain ⟨a, b⟩ := support_monoSSH hh hz
      exact ⟨a.trans (by gcongr; linarith), b.trans (by gcongr; linarith)⟩)
    (fun m ν z hz => by
      obtain ⟨a, b⟩ := support_monoSSH hh hz
      exact ⟨a.trans (by gcongr; linarith), b.trans (by gcongr; linarith)⟩)
    (fun m ν z => norm_monoSSH_le hG₁ hR0 (hBh1 M₁ hM₁0 hM₁) hBh0 m ν z)
    (fun m ν z => norm_monoSSH_le hG₂ hR0 (hBh1 M₂ hM₂0 hM₂) hBh0 m ν z)
    (fun m ν y => by
      obtain ⟨H', hd, hc, hb⟩ := deriv_monoSSH (high := high₁) (ρ := ρ) (L := L) hG₁ hR1 hh
        hRh (hBh1 M₁ hM₁0 hM₁) (hBh2 M₁ hM₁0 hM₁) hBh0
        hCβ0 hCβ m ν y
      simp only [monoPt_zero'] at hd
      exact ⟨H', hd, hc, fun x => (hb x).trans (by gcongr; linarith)⟩)
    (fun m ν x => by
      obtain ⟨H', hd, hc, hb⟩ := deriv_monoSSH (high := high₂) (ρ := ρ) (L := L) hG₂ hR1 hh
        hRh (hBh1 M₂ hM₂0 hM₂) (hBh2 M₂ hM₂0 hM₂) hBh0
        hCβ0 hCβ m ν x
      simp only [monoPt_one'] at hd
      exact ⟨H', hd, hc, fun x => (hb x).trans (by gcongr; linarith)⟩)
    (by
      rcases hhigh with h1 | h2
      · subst h1
        left; intro m ν y
        have := abs_monoSSω_ge (j := 0) (R := R) (ρ := ρ) (G := G₁) hL0.le m ν y
        linarith
      · subst h2
        right; intro m ν x
        have := abs_monoSSω_ge (j := 1) (R := R) (ρ := ρ) (G := G₂) hL0.le m ν x
        linarith)
  refine (mul_le_mul' le_rfl hmain).trans ?_
  rw [← ENNReal.ofReal_mul (by positivity)]
  refine ENNReal.ofReal_le_ofReal ?_
  have hN := card_sq_le hρ0 hρ1.le
  have hq0 : 0 ≤ R / S + (S / L) ^ (1 / 39 : ℝ) := by
    have : 0 ≤ S / L := by positivity
    positivity
  have key : (N : ℝ) ^ 2 * (R / S + (S / L) ^ (1 / 39 : ℝ)) ≤ 200 * L ^ (-((1 / 39 : ℝ) / 256)) := by
    calc (N : ℝ) ^ 2 * (R / S + (S / L) ^ (1 / 39 : ℝ))
        ≤ 100 * ρ⁻¹ ^ 2 * (R / S + (S / L) ^ (1 / 39 : ℝ)) := mul_le_mul_of_nonneg_right hN hq0
      _ = 100 * (ρ⁻¹ ^ 2 * (R / S) + ρ⁻¹ ^ 2 * (S / L) ^ (1 / 39 : ℝ)) := by ring
      _ ≤ 100 * (L ^ (-((1 / 39 : ℝ) / 256)) + L ^ (-((1 / 39 : ℝ) / 256))) := by gcongr
      _ = 200 * L ^ (-((1 / 39 : ℝ) / 256)) := by ring
  calc Bh ^ 2 * (Css * (N : ℝ) ^ 2 * (R / S + (S / L) ^ (1 / 39 : ℝ)))
      = Bh ^ 2 * Css * ((N : ℝ) ^ 2 * (R / S + (S / L) ^ (1 / 39 : ℝ))) := by ring
    _ ≤ Bh ^ 2 * Css * (200 * L ^ (-((1 / 39 : ℝ) / 256))) := by gcongr
    _ = 200 * Bh ^ 2 * Css * L ^ (-((1 / 39 : ℝ) / 256)) := by ring

end

