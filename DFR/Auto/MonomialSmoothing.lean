/-! ### Lc18: Lemma 5.1 -/

/-- The energy totals: `(H₁ H₂)^{1/4} ≤ (C (ρ + h + 1/K))^{1/4}`. -/
theorem mlc_HH {r A B C0 h K Rχ ρ : ℝ} {χ : ℝ × ℝ → ℝ} {v₁ v₂ : ℤ × ℤ → ℝ × ℝ → ℂ} {B₁ B₂ : ℝ}
    (G : MlcGlob r A B C0 h K Rχ χ v₁ v₂ B₁ B₂) (M₁ M₂ : Finset (ℤ × ℤ)) (hρ : 0 < ρ)
    (hunif : (∀ m, ∫⁻ y, monoU (K / h) (fun x => v₁ m (x, y)) ≤ ENNReal.ofReal (C0 * ρ * h ^ 3)) ∨
      (∀ m, ∫⁻ x, monoU (K / h) (fun y => v₂ m (x, y)) ≤ ENNReal.ofReal (C0 * ρ * h ^ 3))) :
    (∑ p ∈ mlcP r A B C0 h χ M₁ M₂, mlcX1 h (monoq r (mlcTb r A B C0 h p.1 p.2)) (v₁ p.1)) ^ (1 / 4 : ℝ) *
      (∑ p ∈ mlcP r A B C0 h χ M₁ M₂, mlcX2 h (monoq r (mlcTb r A B C0 h p.1 p.2)) (v₂ p.2)) ^ (1 / 4 : ℝ)
      ≤ ENNReal.ofReal ((((2 * mlcR0 r B C0 Rχ + 1) ^ 2 * (2 * mlcCw r A B C0 * C0)) * (ρ + h + 1 / K) *
          ((2 * mlcR0 r B C0 Rχ + 1) ^ 2 * (mlcM0 r B C0 * (B - A + 2) * C0))) ^ (1 / 4 : ℝ)) := by
  have hC00 : 0 ≤ C0 := by linarith [G.hC0]
  have hBA : 0 ≤ B - A + 2 := by linarith [G.hAB]
  have hM₀ := mlcM0_nonneg r B C0
  have hCw : 0 ≤ mlcCw r A B C0 := (mul_nonneg hM₀ hBA).trans (mlcCw_ge G.hr G.hA G.hAB).1
  have hh := G.hh
  have hK0 : 0 < K := by linarith [G.hK]
  have hU0 : 0 ≤ (2 * mlcR0 r B C0 Rχ + 1) ^ 2 * (2 * mlcCw r A B C0 * C0 * (ρ + h + 1 / K)) := by
    positivity
  have hT0 : 0 ≤ (2 * mlcR0 r B C0 Rχ + 1) ^ 2 * (mlcM0 r B C0 * (B - A + 2) * C0) := by positivity
  have e : ((2 * mlcR0 r B C0 Rχ + 1) ^ 2 * (2 * mlcCw r A B C0 * C0)) * (ρ + h + 1 / K) *
      ((2 * mlcR0 r B C0 Rχ + 1) ^ 2 * (mlcM0 r B C0 * (B - A + 2) * C0)) =
      ((2 * mlcR0 r B C0 Rχ + 1) ^ 2 * (2 * mlcCw r A B C0 * C0 * (ρ + h + 1 / K))) *
      ((2 * mlcR0 r B C0 Rχ + 1) ^ 2 * (mlcM0 r B C0 * (B - A + 2) * C0)) := by ring
  rw [e, Real.mul_rpow hU0 hT0, ENNReal.ofReal_mul (by positivity),
    ← ENNReal.ofReal_rpow_of_nonneg hU0 (by norm_num), ← ENNReal.ofReal_rpow_of_nonneg hT0 (by norm_num)]
  have hTriv1 := G.sumX1_triv M₁ M₂
  have hTriv2 := G.sumX2_triv M₁ M₂
  rcases hunif with hU | hU
  · exact mul_le_mul' (ENNReal.rpow_le_rpow (G.sumX1_unif M₁ M₂ hρ hU) (by norm_num))
      (ENNReal.rpow_le_rpow hTriv2 (by norm_num))
  · rw [mul_comm (ENNReal.ofReal _ ^ _)]
    exact mul_le_mul' (ENNReal.rpow_le_rpow hTriv1 (by norm_num))
      (ENNReal.rpow_le_rpow (G.sumX2_unif M₁ M₂ hρ hU) (by norm_num))

/-- **Lemma 5.1** (the local correlation estimate (5.5)). -/
theorem mlc_locCorr {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) : MonoLocCorr r A B := by
  intro χ hχ hχc C0 hC0
  obtain ⟨Rχ, hRχ0, hRχ⟩ := mlc_chi_bdd hχc
  obtain ⟨Mχ', hMχ'⟩ := hχ.continuous.bounded_above_of_compact_support hχc
  have hMχ0 : 0 ≤ max Mχ' 0 := le_max_right _ _
  have hχb : ∀ z, |χ z| ≤ max Mχ' 0 := fun z =>
    (Real.norm_eq_abs (χ z) ▸ hMχ' z).trans (le_max_left _ _)
  obtain ⟨K₁, K₂, hK₁, hK₂, hpair⟩ := mlc_pair_bound hr hA hAB hC0
  have hC00 : 0 ≤ C0 := by linarith
  have hBA : 0 ≤ B - A + 2 := by linarith
  have hR₀ : 0 ≤ mlcR0 r B C0 Rχ := by
    have := mlc_Q_nonneg (r := r) (hA.le.trans hAB.le)
    unfold mlcR0; linarith
  have hM₀ : 0 ≤ mlcM0 r B C0 := mlcM0_nonneg r B C0
  have hCw : 0 ≤ mlcCw r A B C0 := (mul_nonneg hM₀ hBA).trans (mlcCw_ge hr hA hAB).1
  obtain ⟨Np, hNpd⟩ : ∃ Np, Np = (2 * mlcR0 r B C0 Rχ + 1) ^ 2 * (mlcM0 r B C0 * (B - A + 2)) := ⟨_, rfl⟩
  obtain ⟨Tc, hTcd⟩ : ∃ Tc, Tc = (2 * mlcR0 r B C0 Rχ + 1) ^ 2 * (mlcM0 r B C0 * (B - A + 2) * C0) :=
    ⟨_, rfl⟩
  obtain ⟨cu, hcud⟩ : ∃ cu, cu = (2 * mlcR0 r B C0 Rχ + 1) ^ 2 * (2 * mlcCw r A B C0 * C0) := ⟨_, rfl⟩
  have hNp : 0 ≤ Np := by rw [hNpd]; positivity
  have hTc : 0 ≤ Tc := by rw [hTcd]; positivity
  have hcu : 0 ≤ cu := by rw [hcud]; positivity
  refine ⟨max Mχ' 0 * K₁ * Np ^ (1 / 2 : ℝ) * (cu * Tc) ^ (1 / 4 : ℝ) + max Mχ' 0 * Np * K₂,
    by positivity, ?_⟩
  intro ψ hψ hsupp hC20 h L K ρ hh hh1 hhL hK hρ hρ1 M₁ M₂ v₁ v₂ B₁ B₂ hv₁ hv₂ hl₁ hl₂ hb₁ hb₂
    hlip₁ hlip₂ hen₁ hen₂ hunif
  have hψ1 : ∀ t, |ψ t| ≤ 1 := fun t => by
    simpa using mlc_psi_deriv_le hψ hsupp hC20 (k := 0) (by norm_num) t
  have hψs : ∀ t, ψ t ≠ 0 → t ∈ Icc A B := fun t ht => hsupp (subset_tsupport ψ ht)
  have hL0 : 0 ≤ L := by
    by_contra hneg; push_neg at hneg; nlinarith
  have hB₁ : 0 ≤ B₁ := (norm_nonneg _).trans (hb₁ 0 0)
  have hB₂ : 0 ≤ B₂ := (norm_nonneg _).trans (hb₂ 0 0)
  have hK0 : 0 < K := by linarith
  have G : MlcGlob r A B C0 h K Rχ χ v₁ v₂ B₁ B₂ :=
    { hr := hr, hA := hA, hAB := hAB, hC0 := hC0, hh := hh, hh1 := hh1, hK := hK, hRχ0 := hRχ0,
      hRχ := hRχ, loc₁ := fun m => ⟨hv₁ m, hb₁ m, hl₁ m⟩, loc₂ := fun n => ⟨hv₂ n, hb₂ n, hl₂ n⟩,
      en₁ := hen₁, en₂ := hen₂ }
  -- the pair bound for every compatible pair
  have hp : ∀ p ∈ mlcP r A B C0 h χ M₁ M₂, ∫⁻ z, ‖monoT r ψ (v₁ p.1) (v₂ p.2) z‖ₑ ≤
      ENNReal.ofReal (K₁ * h ^ (3 / 2 : ℝ)) *
        (mlcX1 h (monoq r (mlcTb r A B C0 h p.1 p.2)) (v₁ p.1) ^ (1 / 4 : ℝ) *
          mlcX2 h (monoq r (mlcTb r A B C0 h p.1 p.2)) (v₂ p.2) ^ (1 / 4 : ℝ)) +
      ENNReal.ofReal (K₂ * (B₁ * B₂ * L ^ (1 / 2 : ℝ) * h ^ 4)) := by
    intro p hpP
    have hc := (mem_mlcP.mp hpP).2
    obtain ⟨t1, t2, -⟩ := mlcTb_spec hc.2
    have PP : MlcPair r A B C0 h L B₁ B₂ (h * p.1.1) (h * p.1.2) (h * p.2.1) (h * p.2.2)
        (mlcTb r A B C0 h p.1 p.2) ψ (v₁ p.1) (v₂ p.2) :=
      ⟨hr, hA, hAB, hC0, hh, hh1, hL0, hψ, hsupp, hC20, G.loc₁ p.1, G.loc₂ p.2, hlip₂ p.2, t1, t2⟩
    rw [← mul_assoc]
    exact hpair _ _ _ _ _ _ _ _ _ _ _ _ PP
  have hHH := mlc_HH G M₁ M₂ hρ hunif
  rw [← hcud, ← hTcd] at hHH
  have hN := mlc_card_P G M₁ M₂
  rw [show (2 * mlcR0 r B C0 Rχ + 1) ^ 2 * (mlcM0 r B C0 * (B - A + 2) / h ^ 3) = Np / h ^ 3 by
    rw [hNpd]; ring] at hN
  have hfin := mlc_final_ennreal (mlcP r A B C0 h χ M₁ M₂) _ _ _ hMχ0 hK₁ hK₂ hh
    (by positivity : 0 ≤ Np / h ^ 3) (by positivity : 0 ≤ cu * (ρ + h + 1 / K) * Tc)
    (by positivity : 0 ≤ B₁ * B₂ * L ^ (1 / 2 : ℝ) * h ^ 4) hp hN hHH
  refine (mlc_expand (by linarith) hχ.continuous.measurable hχb hψ.continuous.measurable hψ1 hψs
    M₁ M₂ v₁ v₂ hv₁ hv₂ hb₁ hb₂ hl₁ hl₂).trans (hfin.trans (ENNReal.ofReal_le_ofReal ?_))
  exact mlc_final_real hMχ0 hK₁ hK₂ hh hNp hcu hTc hρ hK0 hB₁ hB₂ hL0

end

