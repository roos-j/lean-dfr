        (mloc_P_psiE_psiA 0 hL0 hu₁ hb₁) (mloc_P_phiE_phi 1 hL0 hu₂ hb₂)
        (fun _ m p ξ hξ => monoUjm_psiE_low 0 hL0 hh m (hmP 0 _ L u₁ hu₁) (hbP 0 _ L hL0 hkA' u₁ hb₁)
