    _ = R * (∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖) * M := by
        rw [integral_mul_const, integral_norm_monoKR' hR]

theorem continuous_monoPiece {R : ℝ} (hR : 1 ≤ R) (n : ℤ) {F : ℝ → ℂ}
    (hF : AEStronglyMeasurable F volume) {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) :
    Continuous (monoPiece R n F) := by
  have hH : Continuous (monoH R n F) := continuous_iff_continuousAt.mpr fun x =>
    (hasDerivAt_monoH hR n hF hM x).continuousAt
  have e : monoPiece R n F = fun x => monoH R n F x * (𝐞 (n * R * x) : Circle) :=
    funext (monoPiece_eq_monoH R n F)
  rw [e]
  exact hH.mul (by fun_prop)

theorem norm_monoPiece_le {R : ℝ} (hR : 0 < R) (n : ℤ) {F : ℝ → ℂ}
    (hF : AEStronglyMeasurable F volume) {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) (x : ℝ) :
    ‖monoPiece R n F x‖ ≤ (∫ u, ‖monoKappa u‖) * M := by
  rw [monoPiece_eq_monoH, norm_mul, Circle.norm_coe, mul_one]
  exact norm_monoH_le hR n hF hM x

theorem memLp_two_of_bdd {G : ℝ → ℂ} (hG : Integrable G volume) {M : ℝ} (hM : ∀ x, ‖G x‖ ≤ M) :
    MemLp G 2 volume := by
  refine (memLp_two_iff_integrable_sq_norm hG.1).mpr ?_
  refine (hG.norm.const_mul M).mono' (hG.1.norm.pow 2) (Eventually.of_forall fun x => ?_)
  rw [Real.norm_eq_abs, abs_of_nonneg (by positivity), sq]
  exact mul_le_mul_of_nonneg_right (hM x) (norm_nonneg _)

/-- **(2.5)**, lines 236-239 and 284: a piece whose frequency window misses the support of `f̂`
vanishes identically. -/
theorem monoPiece_eq_zero {R : ℝ} (hR : 1 ≤ R) (n : ℤ) {F : ℝ → ℂ} (hF : Integrable F volume)
    {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) (h : ∀ ξ, |ξ - n * R| < R → 𝓕 F ξ = 0) :
    monoPiece R n F = 0 := by
  have hR0 : 0 < R := by linarith
  have hF0 : ∀ ξ, 𝓕 (monoPiece R n F) ξ = 0 := by
    intro ξ
    rw [fourier_monoPiece hR0 n hF]
    by_cases hφ : smoothingPartitionCutoff (ξ / R - n) = 0
    · simp [hφ]
    · have hlt : |ξ / R - n| < 3 / 4 := by
        by_contra hc; exact hφ (smoothingPartitionCutoff_eq_zero (not_lt.mp hc))
      have : |ξ - n * R| < R := by
        have e : ξ - n * R = R * (ξ / R - n) := by field_simp
        rw [e, abs_mul, abs_of_pos hR0]; nlinarith
      rw [h ξ this, mul_zero]
  have hI := integrable_monoPiece hR0 n hF
  have hB := norm_monoPiece_le hR0 n hF.1 hM
  have h2 := memLp_two_of_bdd hI hB
  have hpl := lintegral_fourier_sq_eq hI h2
  simp only [hF0, enorm_zero, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow,
    lintegral_zero] at hpl
  have hae : monoPiece R n F =ᵐ[volume] 0 := by
    have := (lintegral_eq_zero_iff' (h2.1.enorm.pow_const 2)).mp hpl.symm
    filter_upwards [this] with x hx
    simpa using hx
  exact (continuous_monoPiece hR n hF.1 hM).ae_eq_iff_eq volume continuous_const |>.mp hae

end

