/-! ### Algebra of the operator `T_ψ` and of the multipliers -/

theorem ms8_aesm_shift1 {u : ℝ × ℝ → ℂ} (hu : Measurable u) (z : ℝ × ℝ) :
    AEStronglyMeasurable (fun t : ℝ => u (z.1 + t, z.2)) volume :=
  (hu.comp ((measurable_const.add measurable_id).prodMk measurable_const)).aestronglyMeasurable

theorem ms8_aesm_shift2 {r : ℝ} (hr : 0 < r) {v : ℝ × ℝ → ℂ} (hv : Measurable v) (z : ℝ × ℝ) :
    AEStronglyMeasurable (fun t : ℝ => v (z.1, z.2 + monoQ r t)) volume :=
  (hv.comp (measurable_const.prodMk
    (measurable_const.add (continuous_monoQ hr).measurable))).aestronglyMeasurable

theorem ms8_integrable_integrand {r : ℝ} (hr : 0 < r) {ψ : ℝ → ℝ} (hψ : Integrable ψ volume)
    {u v : ℝ × ℝ → ℂ} (hu : Measurable u) (hv : Measurable v) {M₁ M₂ : ℝ}
    (hM₁ : ∀ z, ‖u z‖ ≤ M₁) (hM₂ : ∀ z, ‖v z‖ ≤ M₂) (z : ℝ × ℝ) :
    Integrable (fun t => (ψ t : ℂ) * (u (z.1 + t, z.2) * v (z.1, z.2 + monoQ r t))) volume := by
  refine hψ.ofReal.mul_bdd (c := M₁ * M₂) ((ms8_aesm_shift1 hu z).mul (ms8_aesm_shift2 hr hv z))
    (Eventually.of_forall fun t => ?_)
  rw [norm_mul]
  exact mul_le_mul (hM₁ _) (hM₂ _) (norm_nonneg _) ((norm_nonneg _).trans (hM₁ z))

theorem ms8_monoT_sub_left {r : ℝ} (hr : 0 < r) {ψ : ℝ → ℝ} (hψ : Integrable ψ volume)
    {u u' v : ℝ × ℝ → ℂ} (hu : Measurable u) (hu' : Measurable u') (hv : Measurable v)
    {M₁ M₁' M₂ : ℝ} (hM₁ : ∀ z, ‖u z‖ ≤ M₁) (hM₁' : ∀ z, ‖u' z‖ ≤ M₁') (hM₂ : ∀ z, ‖v z‖ ≤ M₂) :
    monoT r ψ (fun z => u z - u' z) v = fun z => monoT r ψ u v z - monoT r ψ u' v z := by
  funext z
  unfold monoT
  rw [← integral_sub (ms8_integrable_integrand hr hψ hu hv hM₁ hM₂ z)
    (ms8_integrable_integrand hr hψ hu' hv hM₁' hM₂ z)]
  congr 1; funext t; ring

theorem ms8_monoT_sub_right {r : ℝ} (hr : 0 < r) {ψ : ℝ → ℝ} (hψ : Integrable ψ volume)
    {u v v' : ℝ × ℝ → ℂ} (hu : Measurable u) (hv : Measurable v) (hv' : Measurable v')
    {M₁ M₂ M₂' : ℝ} (hM₁ : ∀ z, ‖u z‖ ≤ M₁) (hM₂ : ∀ z, ‖v z‖ ≤ M₂) (hM₂' : ∀ z, ‖v' z‖ ≤ M₂') :
    monoT r ψ u (fun z => v z - v' z) = fun z => monoT r ψ u v z - monoT r ψ u v' z := by
  funext z
  unfold monoT
  rw [← integral_sub (ms8_integrable_integrand hr hψ hu hv hM₁ hM₂ z)
    (ms8_integrable_integrand hr hψ hu hv' hM₁ hM₂' z)]
  congr 1; funext t; ring

theorem ms8_monoT_sub_psi {r : ℝ} (hr : 0 < r) {ψ ψ' : ℝ → ℝ} (hψ : Integrable ψ volume)
    (hψ' : Integrable ψ' volume)
    {u v : ℝ × ℝ → ℂ} (hu : Measurable u) (hv : Measurable v)
    {M₁ M₂ : ℝ} (hM₁ : ∀ z, ‖u z‖ ≤ M₁) (hM₂ : ∀ z, ‖v z‖ ≤ M₂) :
    monoT r (fun t => ψ t - ψ' t) u v = fun z => monoT r ψ u v z - monoT r ψ' u v z := by
  funext z
  unfold monoT
  rw [← integral_sub (ms8_integrable_integrand hr hψ hu hv hM₁ hM₂ z)
    (ms8_integrable_integrand hr hψ' hu hv hM₁ hM₂ z)]
  congr 1; funext t; push_cast; ring

theorem ms8_measurable_monoT {r : ℝ} (hr : 0 < r) {ψ : ℝ → ℝ} (hψ : Measurable ψ)
    {u v : ℝ × ℝ → ℂ} (hu : Measurable u) (hv : Measurable v) :
    Measurable (monoT r ψ u v) := by
  have h : StronglyMeasurable (Function.uncurry fun (z : ℝ × ℝ) (t : ℝ) =>
      (ψ t : ℂ) * (u (z.1 + t, z.2) * v (z.1, z.2 + monoQ r t))) :=
    ((Complex.measurable_ofReal.comp (hψ.comp measurable_snd)).mul
      ((hu.comp measurable_monoShift1).mul (hv.comp (measurable_monoShift2 hr)))).stronglyMeasurable
  exact h.integral_prod_right'.measurable

/-- The multiplier identity `ψ(D_j/L) = φ(D_j/L) - φ(2 D_j/L)`. -/
theorem ms8_K_PsiA (L s : ℝ) :
    ms8K monoKPsiA L s = ms8K monoKPhi L s - ms8K monoKPhi (L / 2) s := by
  unfold ms8K
  rw [ms8_KPsiA_eq]
  have : L / 2 * s = L * s / 2 := by ring
  rw [this]; push_cast; ring

theorem ms8_monoP_PsiA (j : Fin 2) {L : ℝ} (hL : 0 < L) {u : ℝ × ℝ → ℂ} (hu : Measurable u)
    {M : ℝ} (hM : ∀ z, ‖u z‖ ≤ M) :
    monoP j monoKPsiA L u = fun z => monoP j monoKPhi L u z - monoP j monoKPhi (L / 2) u z := by
  funext z
  simp only [ms8_monoP_eq, monoCConv]
  have hs : Measurable fun s : ℝ => z - monoEj j s := by
    unfold monoEj
    exact measurable_const.sub ((measurable_monoPt j).comp (measurable_id.prodMk measurable_const))
  have hI : ∀ L' : ℝ, 0 < L' → Integrable (fun s => ms8K monoKPhi L' s * u (z - monoEj j s)) volume :=
    fun L' hL' => (ms8_integrable_K _ hL').mul_bdd (c := M) (hu.comp hs).aestronglyMeasurable
      (Eventually.of_forall fun s => hM _)
  rw [← integral_sub (hI L hL) (hI (L / 2) (by positivity))]
  congr 1; funext s; rw [ms8_K_PsiA]; ring

end

end Auto

