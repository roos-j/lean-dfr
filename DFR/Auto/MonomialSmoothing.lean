namespace Auto

noncomputable section

/-! ### `L^2` convergence `φ(D_j/L) u → u` as `L → ∞` -/

theorem ms8_measurable_fibsq (j : Fin 2) {v : ℝ × ℝ → ℂ} (hv : Measurable v) :
    Measurable fun p => ∫⁻ a, ‖monoFib j v p a‖ₑ ^ 2 := by
  have h : Measurable fun q : ℝ × ℝ => ‖v (monoPt j q.2 q.1)‖ₑ ^ 2 :=
    (hv.comp ((measurable_monoPt j).comp (measurable_snd.prodMk measurable_fst))).enorm.pow_const 2
  exact h.lintegral_prod_right'

theorem ms8_tendsto_sq_sub_monoP (j : Fin 2) {u : ℝ × ℝ → ℂ} (hu : Measurable u)
    (hfib : ∀ p, Integrable (monoFib j u p) volume) {M : ℝ} (hM : ∀ z, ‖u z‖ ≤ M)
    (h2 : ∫⁻ z, ‖u z‖ₑ ^ 2 ≠ ⊤) :
    Tendsto (fun L : ℝ => ∫⁻ z, ‖u z - monoP j monoKPhi L u z‖ₑ ^ 2) atTop (𝓝 0) := by
  have key : ∀ L : ℝ, 0 < L → ∫⁻ z, ‖u z - monoP j monoKPhi L u z‖ₑ ^ 2 =
      ∫⁻ p, ∫⁻ a, ‖monoFib j (fun z => u z - monoP j monoKPhi L u z) p a‖ₑ ^ 2 :=
    fun L _ => ms8_lintegral_sq_fib j (hu.sub (ms8_measurable_monoP j _ L hu))
  have hfour : ∀ L : ℝ, 0 < L → ∀ p, ∫⁻ a, ‖monoFib j (fun z => u z - monoP j monoKPhi L u z) p a‖ₑ ^ 2
      = ∫⁻ ξ, ‖((1 : ℂ) - (monoPhi (ξ / L) : ℂ)) * 𝓕 (monoFib j u p) ξ‖ₑ ^ 2 := by
    intro L hL p
    have hi : Integrable (monoFib j (fun z => u z - monoP j monoKPhi L u z) p) volume :=
      (hfib p).sub (ms8_monoP_fib_int j _ hL hfib p)
    have hb : ∀ a, ‖monoFib j (fun z => u z - monoP j monoKPhi L u z) p a‖ ≤
        M + (∫ s, ‖ms8K monoKPhi L s‖) * M := fun a =>
      (norm_sub_le _ _).trans (add_le_add (hM _) (ms8_monoP_bdd j _ hL hM _))
    rw [← lintegral_fourier_sq_eq hi (memLp_two_of_bdd hi hb)]
    refine lintegral_congr fun ξ => ?_
    have e : monoFib j (fun z => u z - monoP j monoKPhi L u z) p =
        fun a => monoFib j u p a - monoFib j (monoP j monoKPhi L u) p a := rfl
    rw [e, fourier_sub' (hfib p) (ms8_monoP_fib_int j _ hL hfib p),
      ms8_fourier_monoP_fib j _ hL hfib, ms8_fourier_KPhi, sub_mul, one_mul]
  have hG : ∫⁻ p, ∫⁻ a, ‖monoFib j u p a‖ₑ ^ 2 ≠ ⊤ := by
    rwa [← ms8_lintegral_sq_fib j hu]
  have hfibsq : ∀ p, ∫⁻ a, ‖monoFib j u p a‖ₑ ^ 2 = ∫⁻ ξ, ‖𝓕 (monoFib j u p) ξ‖ₑ ^ 2 := fun p =>
    (lintegral_fourier_sq_eq (hfib p) (memLp_two_of_bdd (hfib p) fun a => hM _)).symm
  have hmul : ∀ L ξ p, ‖((1 : ℂ) - (monoPhi (ξ / L) : ℂ)) * 𝓕 (monoFib j u p) ξ‖ₑ ^ 2 ≤
      ‖𝓕 (monoFib j u p) ξ‖ₑ ^ 2 := by
    intro L ξ p
    rw [enorm_mul]
    have h1 : ‖(1 : ℂ) - (monoPhi (ξ / L) : ℂ)‖ₑ ≤ 1 := by
      rw [← ofReal_norm]
      apply ENNReal.ofReal_le_one.mpr
      rw [← Complex.ofReal_one, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs, abs_le]
      have := ms8_monoPhi_nonneg (ξ / L); have := ms8_monoPhi_le_one (ξ / L)
      constructor <;> linarith
    calc (‖(1 : ℂ) - (monoPhi (ξ / L) : ℂ)‖ₑ * ‖𝓕 (monoFib j u p) ξ‖ₑ) ^ 2
        ≤ (1 * ‖𝓕 (monoFib j u p) ξ‖ₑ) ^ 2 := by gcongr
      _ = _ := by rw [one_mul]
  have hT : Tendsto (fun L : ℝ => ∫⁻ p, ∫⁻ a,
      ‖monoFib j (fun z => u z - monoP j monoKPhi L u z) p a‖ₑ ^ 2) atTop (𝓝 0) := by
    have := tendsto_lintegral_filter_of_dominated_convergence (μ := volume) (l := atTop)
      (F := fun (L : ℝ) p => ∫⁻ a, ‖monoFib j (fun z => u z - monoP j monoKPhi L u z) p a‖ₑ ^ 2)
      (f := fun _ => 0) (fun p => ∫⁻ a, ‖monoFib j u p a‖ₑ ^ 2)
      (Eventually.of_forall fun L =>
        ms8_measurable_fibsq j (hu.sub (ms8_measurable_monoP j _ L hu)))
      ((eventually_gt_atTop 0).mono fun L hL => Eventually.of_forall fun p => by
        rw [hfour L hL p, hfibsq p]
        exact lintegral_mono fun ξ => hmul L ξ p)
      hG
      (Eventually.of_forall fun p => by
        have hin := tendsto_lintegral_filter_of_dominated_convergence (μ := volume) (l := atTop)
          (F := fun (L : ℝ) ξ => ‖((1 : ℂ) - (monoPhi (ξ / L) : ℂ)) * 𝓕 (monoFib j u p) ξ‖ₑ ^ 2)
          (f := fun _ => 0) (fun ξ => ‖𝓕 (monoFib j u p) ξ‖ₑ ^ 2)
          (Eventually.of_forall fun L => by
            have hc : Continuous fun ξ : ℝ => ((1 : ℂ) - (monoPhi (ξ / L) : ℂ)) *
                𝓕 (monoFib j u p) ξ :=
              (continuous_const.sub (Complex.continuous_ofReal.comp
                (monoPhi_contDiff.continuous.comp (continuous_id.div_const L)))).mul
                (continuous_fourier_real (hfib p))
            exact hc.measurable.enorm.pow_const 2)
          (Eventually.of_forall fun L => Eventually.of_forall fun ξ => hmul L ξ p)
          (by
            rw [← hfibsq p]
            exact lintegral_enorm_sq_ne_top (memLp_two_of_bdd (hfib p) fun a => hM _))
          (Eventually.of_forall fun ξ => by
            refine tendsto_const_nhds.congr' ?_
            filter_upwards [eventually_gt_atTop (|ξ|)] with L hL
            have hL0 : 0 < L := lt_of_le_of_lt (abs_nonneg ξ) hL
            have : |ξ / L| ≤ 1 := by
              rw [abs_div, abs_of_pos hL0, div_le_one hL0]; exact hL.le
            rw [monoPhi_eq_one this]; simp)
        simp only [lintegral_zero] at hin
        refine hin.congr' ?_
        filter_upwards [eventually_gt_atTop 0] with L hL
        rw [hfour L hL p])
    simpa using this
  refine hT.congr' ?_
  filter_upwards [eventually_gt_atTop 0] with L hL
  rw [key L hL]

theorem ms8_tendsto_eLpNorm_sub_monoP (j : Fin 2) {u : ℝ × ℝ → ℂ} (hu : Measurable u)
    (hfib : ∀ p, Integrable (monoFib j u p) volume) {M : ℝ} (hM : ∀ z, ‖u z‖ ≤ M)
    (h2 : ∫⁻ z, ‖u z‖ₑ ^ 2 ≠ ⊤) :
    Tendsto (fun L : ℝ => eLpNorm (fun z => u z - monoP j monoKPhi L u z) 2 volume)
      atTop (𝓝 0) := by
  have h := ms8_tendsto_sq_sub_monoP j hu hfib hM h2
  have hc := (ENNReal.continuous_rpow_const (y := (1 / 2 : ℝ))).tendsto 0
  have := hc.comp h
  rw [ENNReal.zero_rpow_of_pos (by norm_num)] at this
  refine this.congr fun L => ?_
  simp only [Function.comp_apply, ms8_eLpNorm_two]

end

end Auto

