/-! ### Convolution of a decaying kernel with a bounded function -/

theorem mono_schwartz_decay_two (f : 𝓢(ℝ, ℂ)) : ∃ C : ℝ, 0 ≤ C ∧ ∀ u, ‖f u‖ ≤ C / (1 + |u|) ^ 2 := by
  set C : ℝ := 2 ^ 2 * (Finset.Iic ((2 : ℕ), (0 : ℕ))).sup (fun m => SchwartzMap.seminorm ℝ m.1 m.2) f
  refine ⟨C, by positivity, fun u => ?_⟩
  have h := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := ((2 : ℕ), (0 : ℕ)))
    (k := 2) (n := 0) le_rfl le_rfl f u
  rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at h
  rw [le_div_iff₀ (by positivity), mul_comm]
  exact h

theorem integrable_inv_one_add_sq (x0 : ℝ) :
    Integrable (fun t : ℝ => 1 / (1 + |x0 - t|) ^ 2) volume := by
  have h := integrable_one_add_norm (E := ℝ) (μ := volume) (r := 2) (by norm_num)
  have h2 := h.comp_sub_left x0
  refine h2.congr (Eventually.of_forall fun t => ?_)
  simp only [Function.comp_apply, Real.norm_eq_abs]
  rw [Real.rpow_neg (by positivity), one_div, Real.rpow_two]

theorem inv_one_add_sq_shift {x x0 t : ℝ} (hx : |x - x0| < 1) :
    1 / (1 + |x - t|) ^ 2 ≤ 4 / (1 + |x0 - t|) ^ 2 := by
  have h1 : 1 + |x0 - t| ≤ 2 * (1 + |x - t|) := by
    have : |x0 - t| ≤ |x0 - x| + |x - t| := by
      rw [show x0 - t = (x0 - x) + (x - t) by ring]; exact abs_add_le _ _
    rw [abs_sub_comm] at hx
    linarith [abs_nonneg (x - t)]
  rw [div_le_div_iff₀ (by positivity) (by positivity)]
  nlinarith [abs_nonneg (x - t), abs_nonneg (x0 - t)]

/-- **Differentiation under the convolution**: for a `C^1` kernel `K` with `K, K' = O((1+|u|)^{-2})`
and a bounded measurable `g`, `(K * g)' = K' * g`. -/
theorem hasDerivAt_conv_bdd {K K' : ℝ → ℂ} (hK : ∀ u, HasDerivAt K (K' u) u) (hK'c : Continuous K')
    {C0 C1 : ℝ} (hK0 : ∀ u, ‖K u‖ ≤ C0 / (1 + |u|) ^ 2) (hK1 : ∀ u, ‖K' u‖ ≤ C1 / (1 + |u|) ^ 2)
    {g : ℝ → ℂ} (hg : AEStronglyMeasurable g volume) {M : ℝ} (hM : ∀ y, ‖g y‖ ≤ M) (x0 : ℝ) :
    HasDerivAt (fun x => ∫ t, K (x - t) * g t) (∫ t, K' (x0 - t) * g t) x0 := by
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  have hKc : Continuous K := continuous_iff_continuousAt.mpr fun u => (hK u).continuousAt
  have hC1 : 0 ≤ C1 := by
    have := hK1 0; have h0 : (0 : ℝ) < (1 + |0|) ^ 2 := by positivity
    have := (norm_nonneg _).trans this
    exact (div_nonneg_iff.mp this).elim (fun h => h.1) (fun h => absurd h.2 (not_le.mpr h0))
  have hmeas : ∀ x, AEStronglyMeasurable (fun t => K (x - t) * g t) volume := fun x =>
    ((hKc.comp (continuous_const.sub continuous_id)).aestronglyMeasurable).mul hg
  refine (hasDerivAt_integral_of_dominated_loc_of_deriv_le (x₀ := x0) (Metric.ball_mem_nhds x0 one_pos)
    (F := fun x t => K (x - t) * g t) (F' := fun x t => K' (x - t) * g t)
    (bound := fun t => 4 * C1 * M * (1 / (1 + |x0 - t|) ^ 2))
    (Eventually.of_forall hmeas) ?_ ?_ ?_ ?_ ?_).2
  · -- integrability at `x0`
    refine ((integrable_inv_one_add_sq x0).const_mul (C0 * M)).mono' (hmeas x0)
      (Eventually.of_forall fun t => ?_)
    rw [norm_mul]
    calc ‖K (x0 - t)‖ * ‖g t‖ ≤ C0 / (1 + |x0 - t|) ^ 2 * M :=
          mul_le_mul (hK0 _) (hM t) (norm_nonneg _) ((norm_nonneg _).trans (hK0 _))
      _ = C0 * M * (1 / (1 + |x0 - t|) ^ 2) := by ring
  · exact ((hK'c.comp (continuous_const.sub continuous_id)).aestronglyMeasurable).mul hg
  · refine Eventually.of_forall fun t x hx => ?_
    rw [Metric.mem_ball, Real.dist_eq] at hx
    rw [norm_mul]
    calc ‖K' (x - t)‖ * ‖g t‖ ≤ C1 / (1 + |x - t|) ^ 2 * M :=
          mul_le_mul (hK1 _) (hM t) (norm_nonneg _) (div_nonneg hC1 (by positivity))
      _ = C1 * M * (1 / (1 + |x - t|) ^ 2) := by ring
      _ ≤ C1 * M * (4 / (1 + |x0 - t|) ^ 2) := by
          exact mul_le_mul_of_nonneg_left (inv_one_add_sq_shift hx) (by positivity)
      _ = 4 * C1 * M * (1 / (1 + |x0 - t|) ^ 2) := by ring
  · exact (integrable_inv_one_add_sq x0).const_mul _
  · refine Eventually.of_forall fun t x _ => ?_
    have h1 : HasDerivAt (fun x => x - t) 1 x := (hasDerivAt_id x).sub_const t
    have h2 := (hK (x - t)).scomp x h1
    simpa [one_smul, Function.comp_def] using h2.mul_const (g t)

end

