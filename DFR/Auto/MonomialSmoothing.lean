open MeasureTheory Set intervalIntegral

namespace Auto

noncomputable section

/-- One-sided case: `φ' ≥ -2S` on `(a,d]`; split at the first point where `φ' ≥ 2S`. -/
theorem mnst_oneside {c d a : ℝ} {H H' : ℝ → ℂ} {φ φ' φ'' : ℝ → ℝ} {M S : ℝ}
    (hca : c ≤ a) (had : a ≤ d)
    (hH : ∀ t ∈ Icc c d, HasDerivAt H (H' t) t) (hH' : ContinuousOn H' (Icc c d))
    (hM : ∀ t ∈ Icc c d, ‖H t‖ ≤ M)
    (hφ : ∀ t ∈ Icc c d, HasDerivAt φ (φ' t) t) (hφ' : ∀ t ∈ Icc c d, HasDerivAt φ' (φ'' t) t)
    (hφ'' : ContinuousOn φ'' (Icc c d)) (hmono : MonotoneOn φ' (Icc c d)) (hS : 0 < S)
    (hlow : ∀ t ∈ Ioc a d, -(2 * S) ≤ φ' t) :
    ‖∫ t in a..d, Complex.exp (2 * Real.pi * Complex.I * φ t) * H t‖
      ≤ (∫ t in c..d, Set.indicator {t | |φ' t| ≤ 2 * S} (fun t => ‖H t‖) t)
        + 1 / S * ((∫ t in c..d, ‖H' t‖) + M) := by
  have hcd := hca.trans had
  have hφ'c : ContinuousOn φ' (Icc c d) := fun t ht => (hφ' t ht).continuousAt.continuousWithinAt
  have hHc : ContinuousOn H (Icc c d) := fun t ht => (hH t ht).continuousAt.continuousWithinAt
  have hφc : ContinuousOn φ (Icc c d) := fun t ht => (hφ t ht).continuousAt.continuousWithinAt
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM c ⟨le_rfl, hcd⟩)
  have hX0 : 0 ≤ ∫ t in c..d, ‖H' t‖ := integral_nonneg hcd (fun _ _ => norm_nonneg _)
  have hrest : 0 ≤ 1 / S * ((∫ t in c..d, ‖H' t‖) + M) := by positivity
  set R := Icc a d ∩ φ' ⁻¹' Ici (2 * S) with hRdef
  by_cases hR : R.Nonempty
  · set b := sInf R with hbdef
    have hBdd : BddBelow R := ⟨a, fun x hx => hx.1.1⟩
    have hRc : IsClosed R :=
      (hφ'c.mono (Icc_subset_Icc hca le_rfl)).preimage_isClosed_of_isClosed isClosed_Icc
        isClosed_Ici
    have hbR : b ∈ R := hRc.csInf_mem hR hBdd
    have hab : a ≤ b := hbR.1.1
    have hbd : b ≤ d := hbR.1.2
    have hmid : ∀ t ∈ Ioo a b, |φ' t| ≤ 2 * S := by
      intro t ht
      have htR : t ∉ R := notMem_of_lt_csInf ht.2 hBdd
      have htI : t ∈ Icc a d := ⟨ht.1.le, ht.2.le.trans hbd⟩
      have h1 : φ' t < 2 * S := by
        by_contra hh; exact htR ⟨htI, le_of_not_gt hh⟩
      have h2 := hlow t ⟨ht.1, htI.2⟩
      rw [abs_le]; constructor <;> linarith
    have hsgn : ∀ t ∈ Icc b d, 2 * S ≤ φ' t := fun t ht =>
      le_trans hbR.2 (hmono ⟨hca.trans hab, hbd⟩ ⟨(hca.trans hab).trans ht.1, ht.2⟩ ht.1)
    have hsub : Icc b d ⊆ Icc c d := Icc_subset_Icc (hca.trans hab) le_rfl
    have hA := mnst_ibp_piece hbd (fun t ht => hH t (hsub ht)) (hH'.mono hsub)
      (fun t ht => hM t (hsub ht)) (fun t ht => hφ t (hsub ht)) (fun t ht => hφ' t (hsub ht))
      (hφ''.mono hsub) (Or.inl (hmono.mono hsub)) hS (Or.inl hsgn)
    have hB := mnst_mid hca hab hbd hHc hφ'c (φ := φ) hmid
    have hXm := mnst_norm_int_mono (hca.trans hab) hbd le_rfl hH'
    have hcont := mnst_cont_integrand hHc hφc
    rw [← integral_add_adjacent_intervals (b := b)
      ((hcont.mono (Icc_subset_Icc hca hbd)).intervalIntegrable_of_Icc hab)
      ((hcont.mono hsub).intervalIntegrable_of_Icc hbd)]
    refine (norm_add_le _ _).trans ?_
    have : 1 / S * ((∫ t in b..d, ‖H' t‖) + M) ≤ 1 / S * ((∫ t in c..d, ‖H' t‖) + M) := by
      gcongr
    linarith
  · have hmid : ∀ t ∈ Ioo a d, |φ' t| ≤ 2 * S := by
      intro t ht
      have h1 : φ' t < 2 * S := by
        by_contra hh; exact hR ⟨t, ⟨ht.1.le, ht.2.le⟩, le_of_not_gt hh⟩
      have h2 := hlow t ⟨ht.1, ht.2.le⟩
      rw [abs_le]; constructor <;> linarith
    have := mnst_mid hca had le_rfl hHc hφ'c (φ := φ) hmid
    linarith

/-- The monotone case of the nonstationary estimate, with constant `2`. -/
theorem mnst_mono {c d : ℝ} {H H' : ℝ → ℂ} {φ φ' φ'' : ℝ → ℝ} {M S : ℝ} (hcd : c ≤ d)
    (hH : ∀ t ∈ Icc c d, HasDerivAt H (H' t) t) (hH' : ContinuousOn H' (Icc c d))
    (hM : ∀ t ∈ Icc c d, ‖H t‖ ≤ M)
    (hφ : ∀ t ∈ Icc c d, HasDerivAt φ (φ' t) t) (hφ' : ∀ t ∈ Icc c d, HasDerivAt φ' (φ'' t) t)
    (hφ'' : ContinuousOn φ'' (Icc c d)) (hmono : MonotoneOn φ' (Icc c d)) (hS : 0 < S) :
    ‖∫ t in c..d, Complex.exp (2 * Real.pi * Complex.I * φ t) * H t‖
      ≤ (∫ t in c..d, Set.indicator {t | |φ' t| ≤ 2 * S} (fun t => ‖H t‖) t)
        + 2 / S * ((∫ t in c..d, ‖H' t‖) + M) := by
  have hφ'c : ContinuousOn φ' (Icc c d) := fun t ht => (hφ' t ht).continuousAt.continuousWithinAt
  have hHc : ContinuousOn H (Icc c d) := fun t ht => (hH t ht).continuousAt.continuousWithinAt
  have hφc : ContinuousOn φ (Icc c d) := fun t ht => (hφ t ht).continuousAt.continuousWithinAt
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM c ⟨le_rfl, hcd⟩)
  have hX0 : 0 ≤ ∫ t in c..d, ‖H' t‖ := integral_nonneg hcd (fun _ _ => norm_nonneg _)
  have hrest : 0 ≤ 1 / S * ((∫ t in c..d, ‖H' t‖) + M) := by positivity
  have h2 : 2 / S * ((∫ t in c..d, ‖H' t‖) + M) = 2 * (1 / S * ((∫ t in c..d, ‖H' t‖) + M)) := by
    ring
  rw [h2]
  set L := Icc c d ∩ φ' ⁻¹' Iic (-(2 * S)) with hLdef
  by_cases hL : L.Nonempty
  · set a := sSup L with hadef
    have hBdd : BddAbove L := ⟨d, fun x hx => hx.1.2⟩
    have hLc : IsClosed L := hφ'c.preimage_isClosed_of_isClosed isClosed_Icc isClosed_Iic
    have haL : a ∈ L := hLc.csSup_mem hL hBdd
    have hca : c ≤ a := haL.1.1
    have had : a ≤ d := haL.1.2
    have hlow : ∀ t ∈ Ioc a d, -(2 * S) ≤ φ' t := by
      intro t ht
      have htL : t ∉ L := notMem_of_csSup_lt ht.1 hBdd
      by_contra hh
      exact htL ⟨⟨hca.trans ht.1.le, ht.2⟩, (lt_of_not_ge hh).le⟩
    have hsgn : ∀ t ∈ Icc c a, φ' t ≤ -(2 * S) := fun t ht =>
      le_trans (hmono ⟨ht.1, ht.2.trans had⟩ ⟨hca, had⟩ ht.2) haL.2
    have hsub : Icc c a ⊆ Icc c d := Icc_subset_Icc le_rfl had
    have hA := mnst_ibp_piece hca (fun t ht => hH t (hsub ht)) (hH'.mono hsub)
      (fun t ht => hM t (hsub ht)) (fun t ht => hφ t (hsub ht)) (fun t ht => hφ' t (hsub ht))
      (hφ''.mono hsub) (Or.inl (hmono.mono hsub)) hS (Or.inr hsgn)
    have hB := mnst_oneside hca had hH hH' hM hφ hφ' hφ'' hmono hS hlow
    have hXm := mnst_norm_int_mono le_rfl hca had hH'
    have hcont := mnst_cont_integrand hHc hφc
    rw [← integral_add_adjacent_intervals (b := a)
      ((hcont.mono hsub).intervalIntegrable_of_Icc hca)
      ((hcont.mono (Icc_subset_Icc hca le_rfl)).intervalIntegrable_of_Icc had)]
    refine (norm_add_le _ _).trans ?_
    have : 1 / S * ((∫ t in c..a, ‖H' t‖) + M) ≤ 1 / S * ((∫ t in c..d, ‖H' t‖) + M) := by
      gcongr
    linarith
  · have hlow : ∀ t ∈ Ioc c d, -(2 * S) ≤ φ' t := by
      intro t ht
      by_contra hh
      exact hL ⟨t, ⟨ht.1.le, ht.2⟩, (lt_of_not_ge hh).le⟩
    have := mnst_oneside le_rfl hcd hH hH' hM hφ hφ' hφ'' hmono hS hlow
    linarith

end

end Auto

end

section

open MeasureTheory Set intervalIntegral ComplexConjugate

namespace Auto

noncomputable section

theorem mnst_intervalIntegral_conj {a b : ℝ} (hab : a ≤ b) (f : ℝ → ℂ) :
    ∫ t in a..b, conj (f t) = conj (∫ t in a..b, f t) := by
  rw [intervalIntegral.integral_of_le hab, intervalIntegral.integral_of_le hab, integral_conj]

theorem mnst_nonstationary : ∃ C : ℝ, 0 < C ∧ ∀ (c d : ℝ) (H H' : ℝ → ℂ) (φ φ' φ'' : ℝ → ℝ)
    (M S : ℝ),
    c ≤ d → (∀ t ∈ Set.Icc c d, HasDerivAt H (H' t) t) → ContinuousOn H' (Set.Icc c d) →
    H c = 0 → H d = 0 → (∀ t ∈ Set.Icc c d, ‖H t‖ ≤ M) →
    (∀ t ∈ Set.Icc c d, HasDerivAt φ (φ' t) t) → (∀ t ∈ Set.Icc c d, HasDerivAt φ' (φ'' t) t) →
    ContinuousOn φ'' (Set.Icc c d) → (MonotoneOn φ' (Set.Icc c d) ∨ AntitoneOn φ' (Set.Icc c d)) →
    0 < S →
    ‖∫ t in c..d, Complex.exp (2 * Real.pi * Complex.I * φ t) * H t‖
      ≤ (∫ t in c..d, Set.indicator {t | |φ' t| ≤ 2 * S} (fun t => ‖H t‖) t)
        + C / S * ((∫ t in c..d, ‖H' t‖) + M) := by
  refine ⟨2, by norm_num, ?_⟩
  intro c d H H' φ φ' φ'' M S hcd hH hH' _ _ hM hφ hφ' hφ'' hmono hS
  rcases hmono with hm | ha
  · exact mnst_mono hcd hH hH' hM hφ hφ' hφ'' hm hS
  · have key := mnst_mono (H := fun t => conj (H t)) (H' := fun t => conj (H' t))
      (φ := fun t => -φ t) (φ' := fun t => -φ' t) (φ'' := fun t => -φ'' t) (M := M) hcd
      (fun t ht => (hH t ht).star) hH'.star (fun t ht => by simpa using hM t ht)
      (fun t ht => (hφ t ht).neg) (fun t ht => (hφ' t ht).neg) hφ''.neg
      (fun x hx y hy hxy => neg_le_neg (ha hx hy hxy)) hS
    have e1 : ∫ t in c..d, Complex.exp (2 * Real.pi * Complex.I * ((-φ t : ℝ) : ℂ)) * conj (H t)
        = conj (∫ t in c..d, Complex.exp (2 * Real.pi * Complex.I * φ t) * H t) := by
      rw [← mnst_intervalIntegral_conj hcd]
      apply integral_congr
      intro t _
      simp only [map_mul, ← Complex.exp_conj, Complex.conj_ofReal, Complex.conj_I, map_ofNat]
      push_cast; ring_nf
    rw [e1, Complex.norm_conj] at key
    simpa [abs_neg, Complex.norm_conj] using key

end

end Auto

end

section

open MeasureTheory Filter Topology Set
open scoped ENNReal ContDiff

namespace Auto

noncomputable section

/-- The `t`-derivative of the amplitude `H_{mn}(z,t) = ψ(t) f(z_1+t,z_2) g(z_1,z_2+Q(t))`. -/
def mssHd (r : ℝ) (ψ : ℝ → ℝ) (f g : ℝ × ℝ → ℂ) (Du Dv : ℝ → ℂ) (z : ℝ × ℝ) (t : ℝ) : ℂ :=
  ((deriv ψ t : ℝ) : ℂ) * (f (z.1 + t, z.2) * g (z.1, z.2 + monoQ r t)) +
    (ψ t : ℂ) * (Du (z.1 + t) * g (z.1, z.2 + monoQ r t) +
      f (z.1 + t, z.2) * ((monoq r t : ℂ) * Dv (z.2 + monoQ r t)))

theorem mss_continuous_Hd {r : ℝ} (hr : 1 < r) {ψ : ℝ → ℝ} (hψ : ContDiff ℝ ∞ ψ)
    {f g : ℝ × ℝ → ℂ} {z : ℝ × ℝ} {Du Dv : ℝ → ℂ}
    (hDu : ∀ x, HasDerivAt (fun x => f (x, z.2)) (Du x) x) (hDuc : Continuous Du)
    (hDv : ∀ y, HasDerivAt (fun y => g (z.1, y)) (Dv y) y) (hDvc : Continuous Dv) :
    Continuous (mssHd r ψ f g Du Dv z) := by
  have hfc : Continuous fun x => f (x, z.2) :=
    continuous_iff_continuousAt.2 fun x => (hDu x).continuousAt
  have hgc : Continuous fun y => g (z.1, y) :=
    continuous_iff_continuousAt.2 fun y => (hDv y).continuousAt
  have hs1 : Continuous fun t : ℝ => z.1 + t := continuous_const.add continuous_id
  have hs2 : Continuous fun t : ℝ => z.2 + monoQ r t :=
    continuous_const.add (continuous_monoQ (by linarith))
  have hu : Continuous fun t => f (z.1 + t, z.2) := hfc.comp hs1
  have hv : Continuous fun t => g (z.1, z.2 + monoQ r t) := hgc.comp hs2
  have hψc : Continuous fun t => (ψ t : ℂ) := Complex.continuous_ofReal.comp hψ.continuous
  have hdψ : Continuous fun t => ((deriv ψ t : ℝ) : ℂ) :=
    Complex.continuous_ofReal.comp (hψ.continuous_deriv (by simp))
  have hq : Continuous fun t => (monoq r t : ℂ) :=
    Complex.continuous_ofReal.comp (mss_continuous_monoq hr.le)
  unfold mssHd
  exact (hdψ.mul (hu.mul hv)).add (hψc.mul (((hDuc.comp hs1).mul hv).add
    (hu.mul (hq.mul (hDvc.comp hs2)))))

theorem mss_hasDerivAt_Hf {r : ℝ} {ψ : ℝ → ℝ} (hψ : ContDiff ℝ ∞ ψ)
    {f g : ℝ × ℝ → ℂ} {z : ℝ × ℝ} {Du Dv : ℝ → ℂ}
    (hDu : ∀ x, HasDerivAt (fun x => f (x, z.2)) (Du x) x)
    (hDv : ∀ y, HasDerivAt (fun y => g (z.1, y)) (Dv y) y) {t : ℝ} (ht : 0 < t) :
    HasDerivAt (fun t => (ψ t : ℂ) * (f (z.1 + t, z.2) * g (z.1, z.2 + monoQ r t)))
      (mssHd r ψ f g Du Dv z t) t := by
  have hψd : HasDerivAt (fun t => (ψ t : ℂ)) ((deriv ψ t : ℝ) : ℂ) t :=
    ((hψ.differentiable (by simp)) t).hasDerivAt.ofReal_comp
  have hu : HasDerivAt (fun t => f (z.1 + t, z.2)) (Du (z.1 + t)) t :=
    (hDu (z.1 + t)).comp_const_add z.1 t
  have hv : HasDerivAt (fun t => g (z.1, z.2 + monoQ r t))
      ((monoq r t : ℂ) * Dv (z.2 + monoQ r t)) t := by
    have h2 := (hDv (z.2 + monoQ r t)).scomp t ((hasDerivAt_monoQ r ht).const_add z.2)
    rw [Complex.real_smul] at h2
    exact h2
  exact hψd.mul (hu.mul hv)

theorem mss_term : ∃ C : ℝ, 0 < C ∧ ∀ {r A B : ℝ}, 1 < r → 0 < A → A < B →
    ∀ (ψ : ℝ → ℝ), ContDiff ℝ ∞ ψ → tsupport ψ ⊆ Icc A B →
    ∀ (f g : ℝ × ℝ → ℂ) (a b : ℝ) (z : ℝ × ℝ) (Du Dv : ℝ → ℂ),
    (∀ x, HasDerivAt (fun x => f (x, z.2)) (Du x) x) → Continuous Du →
    (∀ y, HasDerivAt (fun y => g (z.1, y)) (Dv y) y) → Continuous Dv → ∀ S : ℝ, 0 < S →
    ‖∫ t, (ψ t : ℂ) * ((f (z.1 + t, z.2) *
        Complex.exp (2 * Real.pi * Complex.I * ((a : ℂ) * ((z.1 + t : ℝ) : ℂ)))) *
      (g (z.1, z.2 + monoQ r t) *
        Complex.exp (2 * Real.pi * Complex.I * ((b : ℂ) * ((z.2 + monoQ r t : ℝ) : ℂ)))))‖
    ≤ (∫ t in A..B, Set.indicator {t | |a + monoq r t * b| ≤ 2 * S}
        (fun t => ‖(ψ t : ℂ) * (f (z.1 + t, z.2) * g (z.1, z.2 + monoQ r t))‖) t)
      + 2 * C / S * ∫ t in A..B, ‖mssHd r ψ f g Du Dv z t‖ := by
  obtain ⟨C, hC, hmain⟩ := mnst_nonstationary
  refine ⟨C, hC, ?_⟩
  intro r A B hr hA hAB ψ hψ hψs f g a b z Du Dv hDu hDuc hDv hDvc S hS
  set Hf : ℝ → ℂ := fun t => (ψ t : ℂ) * (f (z.1 + t, z.2) * g (z.1, z.2 + monoQ r t)) with hHf
  set Hd : ℝ → ℂ := mssHd r ψ f g Du Dv z with hHd
  set φ : ℝ → ℝ := fun t => a * (z.1 + t) + b * (z.2 + monoQ r t) with hφ
  set φ' : ℝ → ℝ := fun t => a + monoq r t * b with hφ'
  set φ'' : ℝ → ℝ := fun t => r * ((r - 1) * t ^ (r - 1 - 1)) * b with hφ''
  have hIcc : ∀ t ∈ Icc A B, 0 < t := fun t ht => lt_of_lt_of_le hA ht.1
  -- rewrite the integrand
  have hpt : ∀ t, (ψ t : ℂ) * ((f (z.1 + t, z.2) *
        Complex.exp (2 * Real.pi * Complex.I * ((a : ℂ) * ((z.1 + t : ℝ) : ℂ)))) *
      (g (z.1, z.2 + monoQ r t) *
        Complex.exp (2 * Real.pi * Complex.I * ((b : ℂ) * ((z.2 + monoQ r t : ℝ) : ℂ)))))
      = Complex.exp (2 * Real.pi * Complex.I * (φ t : ℂ)) * Hf t := by
    intro t
    have he : Complex.exp (2 * Real.pi * Complex.I * (φ t : ℂ)) =
        Complex.exp (2 * Real.pi * Complex.I * ((a : ℂ) * ((z.1 + t : ℝ) : ℂ))) *
          Complex.exp (2 * Real.pi * Complex.I * ((b : ℂ) * ((z.2 + monoQ r t : ℝ) : ℂ))) := by
      rw [← Complex.exp_add]; congr 1; simp only [hφ]; push_cast; ring
    rw [he, hHf]; ring
  simp_rw [hpt]
  have hfull : ∫ t, Complex.exp (2 * Real.pi * Complex.I * (φ t : ℂ)) * Hf t =
      ∫ t in A..B, Complex.exp (2 * Real.pi * Complex.I * (φ t : ℂ)) * Hf t := by
    rw [intervalIntegral.integral_of_le hAB.le]
    refine (setIntegral_eq_integral_of_forall_compl_eq_zero fun t ht => ?_).symm
    have h0 : ψ t = 0 := mss_psi_zero_of_not_mem_Ioo hψ.continuous hψs
      (fun h => ht ⟨h.1, h.2.le⟩)
    simp [hHf, h0]
  rw [hfull]
  -- hypotheses for the nonstationary estimate
  have hHfd : ∀ t ∈ Icc A B, HasDerivAt Hf (Hd t) t := fun t ht =>
    mss_hasDerivAt_Hf hψ hDu hDv (hIcc t ht)
  have hHdc : Continuous Hd := mss_continuous_Hd hr hψ hDu hDuc hDv hDvc
  have hψA := (mss_psi_endpoints hψ.continuous hψs)
  have hHA : Hf A = 0 := by simp [hHf, hψA.1]
  have hHB : Hf B = 0 := by simp [hHf, hψA.2]
  have hM : ∀ t ∈ Icc A B, ‖Hf t‖ ≤ ∫ t in A..B, ‖Hd t‖ := by
    intro t ht
    have hftc : Hf t = ∫ s in A..t, Hd s := by
      rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (f := Hf), hHA, sub_zero]
      · intro s hs
        rw [uIcc_of_le ht.1] at hs
        exact hHfd s ⟨hs.1, hs.2.trans ht.2⟩
      · exact hHdc.intervalIntegrable _ _
    rw [hftc]
    refine (intervalIntegral.norm_integral_le_integral_norm ht.1).trans ?_
    refine intervalIntegral.integral_mono_interval le_rfl ht.1 ht.2
      (Eventually.of_forall fun _ => norm_nonneg _) (hHdc.norm.intervalIntegrable _ _)
  have hφd : ∀ t ∈ Icc A B, HasDerivAt φ (φ' t) t := by
    intro t ht
    have h1 := (((hasDerivAt_id t).const_add z.1).const_mul a).add
      (((hasDerivAt_monoQ r (hIcc t ht)).const_add z.2).const_mul b)
    have h2 : HasDerivAt φ (a * 1 + b * monoq r t) t := h1
    exact h2.congr_deriv (by simp only [hφ']; ring)
  have hφ'd : ∀ t ∈ Icc A B, HasDerivAt φ' (φ'' t) t := by
    intro t ht
    have h1 := (((Real.hasDerivAt_rpow_const (p := r - 1) (Or.inl (hIcc t ht).ne')).const_mul
      r).mul_const b).const_add a
    exact h1
  have hφ''c : ContinuousOn φ'' (Icc A B) := by
    show ContinuousOn (fun t => r * ((r - 1) * t ^ (r - 1 - 1)) * b) _
    refine (continuousOn_const.mul (continuousOn_const.mul
      (continuousOn_id.rpow_const fun x hx => Or.inl (hIcc x hx).ne'))).mul continuousOn_const
  have hmono : MonotoneOn φ' (Icc A B) ∨ AntitoneOn φ' (Icc A B) := by
    by_cases hb : 0 ≤ b
    · left
      intro s hs t ht hst
      simp only [hφ']
      have := mss_monoq_mono hr.le (hIcc s hs).le hst
      nlinarith
    · right
      intro s hs t ht hst
      simp only [hφ']
      have := mss_monoq_mono hr.le (hIcc s hs).le hst
      push Not at hb
      nlinarith
  have key := hmain A B Hf Hd φ φ' φ'' (∫ t in A..B, ‖Hd t‖) S hAB.le hHfd hHdc.continuousOn
    hHA hHB hM hφd hφ'd hφ''c hmono hS
  refine key.trans (le_of_eq ?_)
  simp only [hφ', hHf]
  ring

end

end Auto

end

section

open MeasureTheory Filter Topology Set
open scoped ENNReal ContDiff

namespace Auto

noncomputable section

/-- The stationary set of the pair of cubes `(m, n)`, with frequency functions `a` (first input,
depending on `y`) and `b` (second input, depending on `x`). -/
def mssE (r A B h C0 S : ℝ) (D : Set (ℝ × ℝ)) (m n : ℤ × ℤ) (a b : ℝ → ℝ) :
    Set ((ℝ × ℝ) × ℝ) :=
  {p | p.1 ∈ D ∧ p.2 ∈ Icc A B ∧ |a p.1.2 + monoq r p.2 * b p.1.1| ≤ 2 * S ∧
    (p.1.1 + p.2, p.1.2) ∈ mssBox h C0 m ∧ (p.1.1, p.1.2 + monoQ r p.2) ∈ mssBox h C0 n}

theorem mss_measurableSet_E {r : ℝ} (hr : 0 < r) (A B h C0 S : ℝ) {D : Set (ℝ × ℝ)}
    (hD : MeasurableSet D) (m n : ℤ × ℤ) {a b : ℝ → ℝ} (ha : Measurable a) (hb : Measurable b) :
    MeasurableSet (mssE r A B h C0 S D m n a b) := by
  have e : mssE r A B h C0 S D m n a b = (Prod.fst ⁻¹' D) ∩ ((Prod.snd ⁻¹' Icc A B) ∩
      ({p : (ℝ × ℝ) × ℝ | |a p.1.2 + monoq r p.2 * b p.1.1| ≤ 2 * S} ∩
      (((fun p : (ℝ × ℝ) × ℝ => (p.1.1 + p.2, p.1.2)) ⁻¹' mssBox h C0 m) ∩
      ((fun p : (ℝ × ℝ) × ℝ => (p.1.1, p.1.2 + monoQ r p.2)) ⁻¹' mssBox h C0 n)))) := by
    ext p; rfl
  rw [e]
  have hm : Measurable fun p : (ℝ × ℝ) × ℝ => |a p.1.2 + monoq r p.2 * b p.1.1| :=
    continuous_abs.measurable.comp ((ha.comp (measurable_snd.comp measurable_fst)).add
      (((mss_measurable_monoq r).comp measurable_snd).mul
        (hb.comp (measurable_fst.comp measurable_fst))))
  exact (measurable_fst hD).inter ((measurable_snd measurableSet_Icc).inter
    ((measurableSet_le hm measurable_const).inter
      ((measurable_monoShift1 (mss_measurableSet_box h C0 m)).inter
        (measurable_monoShift2 hr (mss_measurableSet_box h C0 n)))))

theorem mss_slice_subset (r A B h C0 S : ℝ) (D : Set (ℝ × ℝ)) (m n : ℤ × ℤ) (a b : ℝ → ℝ)
    (z : ℝ × ℝ) : Prod.mk z ⁻¹' mssE r A B h C0 S D m n a b ⊆ Icc A B :=
  fun _ ht => ht.2.1

theorem mss_stat_le {r A B h C0 S : ℝ} (hr : 1 < r) {D : Set (ℝ × ℝ)} (hD : MeasurableSet D)
    {ψ : ℝ → ℝ} (hψs : tsupport ψ ⊆ Icc A B) (hψ1 : ∀ t, |ψ t| ≤ 1)
    {f g : ℝ × ℝ → ℂ} {m n : ℤ × ℤ} (hf : ∀ w, f w ≠ 0 → w ∈ mssBox h C0 m)
    (hg : ∀ w, g w ≠ 0 → w ∈ mssBox h C0 n) (hf1 : ∀ w, ‖f w‖ ≤ 1) (hg1 : ∀ w, ‖g w‖ ≤ 1)
    {a b : ℝ → ℝ} (ha : Measurable a) (hb : Measurable b) {z : ℝ × ℝ} (hz : z ∈ D)
    (hAB : A ≤ B) :
    (∫ t in A..B, Set.indicator {t | |a z.2 + monoq r t * b z.1| ≤ 2 * S}
        (fun t => ‖(ψ t : ℂ) * (f (z.1 + t, z.2) * g (z.1, z.2 + monoQ r t))‖) t)
      ≤ (volume (Prod.mk z ⁻¹' mssE r A B h C0 S D m n a b)).toReal := by
  set E := Prod.mk z ⁻¹' mssE r A B h C0 S D m n a b
  have hEm : MeasurableSet E :=
    measurable_prodMk_left (mss_measurableSet_E (by linarith) A B h C0 S hD m n ha hb)
  have hfin : volume E ≠ ⊤ :=
    ((measure_mono (mss_slice_subset r A B h C0 S D m n a b z)).trans_lt measure_Icc_lt_top).ne
  have hint : Integrable (E.indicator fun _ => (1 : ℝ)) volume :=
    (integrable_indicator_iff hEm).2 (integrableOn_const hfin)
  have hpt : ∀ t, Set.indicator {t | |a z.2 + monoq r t * b z.1| ≤ 2 * S}
      (fun t => ‖(ψ t : ℂ) * (f (z.1 + t, z.2) * g (z.1, z.2 + monoQ r t))‖) t
      ≤ E.indicator (fun _ => (1 : ℝ)) t := by
    intro t
    by_cases hst : t ∈ {t | |a z.2 + monoq r t * b z.1| ≤ 2 * S}
    · rw [indicator_of_mem hst]
      by_cases htE : t ∈ E
      · rw [indicator_of_mem htE]
        rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs]
        have := hψ1 t
        have h1 := hf1 (z.1 + t, z.2)
        have h2 := hg1 (z.1, z.2 + monoQ r t)
        calc |ψ t| * (‖f (z.1 + t, z.2)‖ * ‖g (z.1, z.2 + monoQ r t)‖) ≤ 1 * (1 * 1) := by
              gcongr
          _ = 1 := by ring
      · rw [indicator_of_notMem htE]
        have hzero : (ψ t : ℂ) * (f (z.1 + t, z.2) * g (z.1, z.2 + monoQ r t)) = 0 := by
          by_cases ht : t ∈ Icc A B
          · by_cases h1 : (z.1 + t, z.2) ∈ mssBox h C0 m
            · by_cases h2 : (z.1, z.2 + monoQ r t) ∈ mssBox h C0 n
              · exact absurd ⟨hz, ht, hst, h1, h2⟩ htE
              · have : g (z.1, z.2 + monoQ r t) = 0 := by
                  by_contra hne; exact h2 (hg _ hne)
                simp [this]
            · have : f (z.1 + t, z.2) = 0 := by
                by_contra hne; exact h1 (hf _ hne)
              simp [this]
          · simp [mss_psi_zero_of_not_mem hψs ht]
        rw [hzero, norm_zero]
    · rw [indicator_of_notMem hst]
      exact indicator_nonneg (fun _ _ => zero_le_one) t
  rw [intervalIntegral.integral_of_le hAB]
  calc (∫ t in Ioc A B, Set.indicator {t | |a z.2 + monoq r t * b z.1| ≤ 2 * S}
        (fun t => ‖(ψ t : ℂ) * (f (z.1 + t, z.2) * g (z.1, z.2 + monoQ r t))‖) t)
      ≤ ∫ t in Ioc A B, E.indicator (fun _ => (1 : ℝ)) t :=
        integral_mono_of_nonneg (Eventually.of_forall fun t =>
          indicator_nonneg (fun _ _ => norm_nonneg _) t) hint.integrableOn
          (Eventually.of_forall hpt)
    _ ≤ ∫ t, E.indicator (fun _ => (1 : ℝ)) t :=
        setIntegral_le_integral hint (Eventually.of_forall fun t =>
          indicator_nonneg (fun _ _ => zero_le_one) t)
    _ = (volume E).toReal := by
        exact integral_indicator_one hEm

end

