/-- Bilinear expansion of `T_ψ` for finite sums of inputs. -/
theorem mss_expand {ι₁ ι₂ : Type*} (r : ℝ) (ψ : ℝ → ℝ) (P₁ : Finset ι₁) (P₂ : Finset ι₂)
    (G₁ : ι₁ → ℝ × ℝ → ℂ) (G₂ : ι₂ → ℝ × ℝ → ℂ) (z : ℝ × ℝ)
    (hint : ∀ i j, Integrable (fun t => (ψ t : ℂ) * (G₁ i (z.1 + t, z.2) *
      G₂ j (z.1, z.2 + monoQ r t))) volume) :
    ‖monoT r ψ (fun w => ∑ i ∈ P₁, G₁ i w) (fun w => ∑ j ∈ P₂, G₂ j w) z‖ ≤
      ∑ i ∈ P₁, ∑ j ∈ P₂, ‖∫ t, (ψ t : ℂ) * (G₁ i (z.1 + t, z.2) *
        G₂ j (z.1, z.2 + monoQ r t))‖ := by
  unfold monoT
  have e : ∀ t, (ψ t : ℂ) * ((∑ i ∈ P₁, G₁ i (z.1 + t, z.2)) *
      (∑ j ∈ P₂, G₂ j (z.1, z.2 + monoQ r t))) =
      ∑ i ∈ P₁, ∑ j ∈ P₂, (ψ t : ℂ) * (G₁ i (z.1 + t, z.2) * G₂ j (z.1, z.2 + monoQ r t)) := by
    intro t
    rw [Finset.sum_mul_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Finset.mul_sum]
  simp_rw [e]
  rw [integral_finset_sum _ fun i _ => integrable_finset_sum _ fun j _ => hint i j]
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun i _ => ?_)
  rw [integral_finset_sum _ fun j _ => hint i j]
  exact norm_sum_le _ _

theorem mss_sum_rearrange {β : Type*} [AddCommMonoid β] (M₁ M₂ : Finset (ℤ × ℤ)) (N : ℕ)
    (X : (ℤ × ℤ) × ℕ → (ℤ × ℤ) × ℕ → β) :
    ∑ p ∈ M₁ ×ˢ Finset.range N, ∑ q ∈ M₂ ×ˢ Finset.range N, X p q =
      ∑ ν₁ ∈ Finset.range N, ∑ ν₂ ∈ Finset.range N, ∑ m ∈ M₁, ∑ n ∈ M₂, X (m, ν₁) (n, ν₂) := by
  rw [Finset.sum_product_right]
  refine Finset.sum_congr rfl fun ν₁ _ => ?_
  simp_rw [Finset.sum_product_right]
  exact Finset.sum_comm

theorem mss_norm_exp (a b : ℝ) :
    ‖Complex.exp (2 * Real.pi * Complex.I * ((a : ℂ) * (b : ℂ)))‖ = 1 := by
  rw [show 2 * (Real.pi : ℂ) * Complex.I * ((a : ℂ) * (b : ℂ)) =
    ((2 * Real.pi * a * b : ℝ) : ℂ) * Complex.I by push_cast; ring]
  exact Complex.norm_exp_ofReal_mul_I _

end

