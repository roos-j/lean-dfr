/-! ### The sharp parts as sums of modulated components (lines 1081-1133) -/

theorem monoEnum_mem {S : Finset ℤ} {ν : ℕ} (hν : ν < S.card) : monoEnum S ν ∈ S := by
  unfold monoEnum
  have hlen : (S.sort (· ≤ ·)).length = S.card := Finset.length_sort _
  rw [List.getD_eq_getElem _ _ (by rw [hlen]; exact hν)]
  exact (Finset.mem_sort (· ≤ ·)).mp (List.getElem_mem _)

theorem circle_eq_exp (y : ℝ) : ((𝐞 y : Circle) : ℂ) = Complex.exp (2 * π * Complex.I * y) := by
  rw [Real.fourierChar_apply]; push_cast; ring_nf

/-- The sharp sum over a subset `T ⊆ S` of the selected integers, when the other pieces vanish. -/
theorem monoSharp_eq_sum_subset {R ρ : ℝ} {F : ℝ → ℂ} {T : Finset ℤ} (hT : T ⊆ monoSel R ρ F)
    (hz : ∀ n ∈ monoSel R ρ F, n ∉ T → monoPiece R n F = 0) (x : ℝ) :
    monoSharp R ρ F x = ∑ n ∈ T, monoPiece R n F x := by
  unfold monoSharp
  rw [← Finset.sum_subset hT fun n hn hnT => by rw [hz n hn hnT]; rfl]

/-- The components: `H_ν(x) = h_{n_ν}(x)` for `ν < #T`, zero otherwise. -/
def monoCompH (R : ℝ) (T : Finset ℤ) (F : ℝ → ℂ) (ν : ℕ) (x : ℝ) : ℂ :=
  if ν < T.card then monoH R (monoEnum T ν) F x else 0

/-- The frequencies: `ω_ν = n_ν R` for `ν < #T`, the padding value `ω_pad` otherwise. -/
def monoCompω (R ωpad : ℝ) (T : Finset ℤ) (ν : ℕ) : ℝ :=
  if ν < T.card then (monoEnum T ν : ℝ) * R else ωpad

theorem sum_pieces_eq_comp {R : ℝ} (T : Finset ℤ) (F : ℝ → ℂ) {N : ℕ} (hN : T.card ≤ N) (ωpad x : ℝ) :
    ∑ n ∈ T, monoPiece R n F x
      = ∑ ν ∈ Finset.range N, monoCompH R T F ν x *
          Complex.exp (2 * π * Complex.I * (monoCompω R ωpad T ν * x)) := by
  rw [sum_eq_sum_enum T hN]
  refine Finset.sum_congr rfl fun ν _ => ?_
  unfold monoCompH monoCompω
  split_ifs with hν
  · rw [monoPiece_eq_monoH, circle_eq_exp]; push_cast; ring_nf
  · simp

theorem norm_monoCompH_le {R : ℝ} (hR : 0 < R) (T : Finset ℤ) {F : ℝ → ℂ}
    (hF : AEStronglyMeasurable F volume) {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) (ν : ℕ) (x : ℝ) :
    ‖monoCompH R T F ν x‖ ≤ (∫ u, ‖monoKappa u‖) * M := by
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  unfold monoCompH
  split_ifs
  · exact norm_monoH_le hR _ hF hM x
  · rw [norm_zero]; exact mul_nonneg (integral_nonneg fun _ => norm_nonneg _) hM0

theorem hasDerivAt_monoCompH {R : ℝ} (hR : 1 ≤ R) (T : Finset ℤ) {F : ℝ → ℂ}
    (hF : AEStronglyMeasurable F volume) {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) (ν : ℕ) (x : ℝ) :
    HasDerivAt (monoCompH R T F ν) (if ν < T.card then monoH' R (monoEnum T ν) F x else 0) x := by
  by_cases hν : ν < T.card
  · have e : monoCompH R T F ν = monoH R (monoEnum T ν) F := funext fun x => if_pos hν
    rw [e, if_pos hν]; exact hasDerivAt_monoH hR _ hF hM x
  · have e : monoCompH R T F ν = fun _ => 0 := funext fun x => if_neg hν
    rw [e, if_neg hν]; exact hasDerivAt_const x 0

theorem measurable_monoCompω {R ωpad : ℝ} {T : ℝ → Finset ℤ} (hT : ∀ n, MeasurableSet {p | n ∈ T p})
    (ν : ℕ) : Measurable fun p => monoCompω R ωpad (T p) ν :=
  measurable_of_finset_valued hT (fun S => monoCompω R ωpad S ν)

/-- Joint measurability of `(p, a) ↦ H_ν(fiber_p G)(a)` for a measurable family of index sets. -/
theorem measurable_monoCompH_fib (j : Fin 2) {R : ℝ} {G : ℝ × ℝ → ℂ} (hG : Measurable G)
    {T : ℝ → Finset ℤ} (hT : ∀ n, MeasurableSet {p | n ∈ T p}) (ν : ℕ) :
    Measurable fun q : ℝ × ℝ => monoCompH R (T q.1) (monoFib j G q.1) ν q.2 := by
  have hcard : Measurable fun p => (T p).card := measurable_of_finset_valued hT Finset.card
  have hen : Measurable fun p => monoEnum (T p) ν := measurable_of_finset_valued hT (monoEnum · ν)
  have hH : Measurable fun x : (ℝ × ℝ) × ℤ => monoH R x.2 (monoFib j G x.1.1) x.1.2 :=
    measurable_from_prod_countable_left fun n => measurable_monoH_fib j n hG
  have hpair : Measurable fun q : ℝ × ℝ => (q, monoEnum (T q.1) ν) := measurable_id.prodMk
    (hen.comp measurable_fst)
  have hC : MeasurableSet {q : ℝ × ℝ | ν < (T q.1).card} :=
    (measurableSet_lt measurable_const hcard).preimage measurable_fst
  have hm : Measurable fun q : ℝ × ℝ => monoH R (monoEnum (T q.1) ν) (monoFib j G q.1) q.2 := by
    have h2 := hH.comp hpair
    simp only [Function.comp_def] at h2
    exact h2
  have e : (fun q : ℝ × ℝ => monoCompH R (T q.1) (monoFib j G q.1) ν q.2)
      = {q : ℝ × ℝ | ν < (T q.1).card}.piecewise
          (fun q => monoH R (monoEnum (T q.1) ν) (monoFib j G q.1) q.2) (fun _ => 0) := by
    funext q
    simp only [monoCompH, Set.piecewise, mem_setOf_eq]
  rw [e]
  exact Measurable.piecewise hC hm measurable_const

end

