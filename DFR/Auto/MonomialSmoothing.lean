theorem mfk_mul_pow_le_of_le_div {N u M V : ℝ} (hu : 0 < u) (hV : 0 ≤ V)
    (h : N ≤ M / u ^ 12 * V) : N * u ^ 12 ≤ M * V := by
  have hu12 : 0 < u ^ 12 := by positivity
  calc N * u ^ 12 ≤ M / u ^ 12 * V * u ^ 12 := mul_le_mul_of_nonneg_right h hu12.le
    _ = M * V := by field_simp

theorem mfk_phi_bound {Λ h x0 y0 t0 : ℝ} (hΛ : 0 < Λ) (hh : 0 < h) {A : (ℝ × ℝ) × ℝ → ℂ}
    (hA : MfkAmp Λ h x0 y0 t0 A) (c q : ℝ) (ξ η : ℝ × ℝ) :
    ‖mfkPhi A c q ξ η‖ * (1 + h * |ξ.1 + η.1| + h * |ξ.2 + η.2| + h * |ξ.1 + q * η.2|) ^ 12
      ≤ 3 ^ 12 * (2 ^ 15 * Λ ^ 4 * h ^ 3) := by
  set N := ‖mfkPhi A c q ξ η‖
  set u1 := 1 + h * |ξ.1 + η.1|
  set u2 := 1 + h * |ξ.2 + η.2|
  set u3 := 1 + h * |ξ.1 + q * η.2|
  have hu1 : 0 < u1 := by positivity
  have hu2 : 0 < u2 := by positivity
  have hu3 : 0 < u3 := by positivity
  have hM : 2 ^ 13 * Λ ^ 2 * h * (2 * (Λ * h)) ^ 2 = 2 ^ 15 * Λ ^ 4 * h ^ 3 := by ring
  have b1 := mfk_mul_pow_le_of_le_div hu1 (by positivity) (mfk_phi_bound_x hΛ hh hA c q ξ η)
  have b2 := mfk_mul_pow_le_of_le_div hu2 (by positivity) (mfk_phi_bound_y hΛ hh hA c q ξ η)
  have b3 := mfk_mul_pow_le_of_le_div hu3 (by positivity) (mfk_phi_bound_t hΛ hh hA c q ξ η)
  rw [hM] at b1 b2 b3
  set m := max u1 (max u2 u3)
  have hm : N * m ^ 12 ≤ 2 ^ 15 * Λ ^ 4 * h ^ 3 := by
    rcases max_choice u1 (max u2 u3) with h1 | h1
    · rw [show m = u1 from h1]; exact b1
    · rcases max_choice u2 u3 with h2 | h2
      · rw [show m = u2 by rw [show m = max u2 u3 from h1, h2]]; exact b2
      · rw [show m = u3 by rw [show m = max u2 u3 from h1, h2]]; exact b3
  have hS : 1 + h * |ξ.1 + η.1| + h * |ξ.2 + η.2| + h * |ξ.1 + q * η.2| ≤ 3 * m := by
    have e1 : u1 ≤ m := le_max_left _ _
    have e2 : u2 ≤ m := (le_max_left _ _).trans (le_max_right _ _)
    have e3 : u3 ≤ m := (le_max_right _ _).trans (le_max_right _ _)
    simp only [u1, u2, u3] at e1 e2 e3
    linarith
  have hS0 : 0 ≤ 1 + h * |ξ.1 + η.1| + h * |ξ.2 + η.2| + h * |ξ.1 + q * η.2| := by positivity
  calc N * (1 + h * |ξ.1 + η.1| + h * |ξ.2 + η.2| + h * |ξ.1 + q * η.2|) ^ 12
      ≤ N * (3 * m) ^ 12 := mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hS0 hS 12) (norm_nonneg _)
    _ = 3 ^ 12 * (N * m ^ 12) := by ring
    _ ≤ _ := mul_le_mul_of_nonneg_left hm (by positivity)

end

end Auto

