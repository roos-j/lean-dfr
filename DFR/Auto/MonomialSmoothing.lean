namespace Auto
noncomputable section

/-- Logarithmic scalar coordinate: `log ν = (r-1) λ - log r`. -/
def msubLam (t : ℝ × ℝ × ℝ) : ℝ := Real.log t.2.1 - Real.log t.1 - Real.log t.2.2

/-- The alternating coordinates `(θ₁, θ₂)` of (3.2). -/
def msubTh (r : ℝ) (t : ℝ × ℝ × ℝ) : ℝ × ℝ :=
  (-t.1 + t.2.1 - t.2.2, monoQ r t.1 - monoQ r t.2.1 + monoQ r t.2.2)

/-- The flow map `H = (λ, θ₁, θ₂)` (logarithmic version of (3.7)). -/
def msubH (r : ℝ) (t : ℝ × ℝ × ℝ) : ℝ × ℝ × ℝ := (msubLam t, msubTh r t)

/-- The differential of `msubH` at `c`, applied to `v`. -/
def msubM (r : ℝ) (c v : ℝ × ℝ × ℝ) : ℝ × ℝ × ℝ :=
  (-(c.1⁻¹ * v.1) + c.2.1⁻¹ * v.2.1 - c.2.2⁻¹ * v.2.2,
    (-v.1 + v.2.1 - v.2.2, monoq r c.1 * v.1 - monoq r c.2.1 * v.2.1 + monoq r c.2.2 * v.2.2))

theorem msub_norm3 (x : ℝ × ℝ × ℝ) : ‖x‖ = max |x.1| (max |x.2.1| |x.2.2|) := by
  simp [Prod.norm_def, Real.norm_eq_abs]

theorem msub_norm2 (x : ℝ × ℝ) : ‖x‖ = max |x.1| |x.2| := by
  simp [Prod.norm_def, Real.norm_eq_abs]

theorem msub_comb_le {x y z a b c m : ℝ} (hx : |x| ≤ m) (hy : |y| ≤ m) (hz : |z| ≤ m) :
    |x * a + y * b + z * c| ≤ m * (|a| + |b| + |c|) := by
  have h1 := abs_add_le (x * a + y * b) (z * c)
  have h2 := abs_add_le (x * a) (y * b)
  rw [abs_mul] at h1 h2; rw [abs_mul] at h2
  have := mul_le_mul_of_nonneg_right hx (abs_nonneg a)
  have := mul_le_mul_of_nonneg_right hy (abs_nonneg b)
  have := mul_le_mul_of_nonneg_right hz (abs_nonneg c)
  nlinarith

theorem msub_cramer {q0 q1 q2 f0 f1 f2 v0 v1 v2 Q F m : ℝ}
    (hq0 : |q0| ≤ Q) (hq1 : |q1| ≤ Q) (hq2 : |q2| ≤ Q)
    (hf0 : |f0| ≤ F) (hf1 : |f1| ≤ F) (hf2 : |f2| ≤ F)
    (hs1 : |v0 + v1 + v2| ≤ m) (hs2 : |q0 * v0 + q1 * v1 + q2 * v2| ≤ m)
    (hs3 : |f0 * v0 + f1 * v1 + f2 * v2| ≤ m) :
    |(q1 - q0) * (f2 - f0) - (q2 - q0) * (f1 - f0)| * max |v0| (max |v1| |v2|) ≤
      m * (2 * Q * F + 2 * F + 2 * Q) := by
  set D := (q1 - q0) * (f2 - f0) - (q2 - q0) * (f1 - f0)
  set s1 := v0 + v1 + v2
  set s2 := q0 * v0 + q1 * v1 + q2 * v2
  set s3 := f0 * v0 + f1 * v1 + f2 * v2
  have hQ : 0 ≤ Q := (abs_nonneg _).trans hq0
  have hF : 0 ≤ F := (abs_nonneg _).trans hf0
  have hm : 0 ≤ m := (abs_nonneg _).trans hs1
  have pq : ∀ a b c d : ℝ, |a| ≤ Q → |b| ≤ F → |c| ≤ Q → |d| ≤ F →
      |a * b - c * d| ≤ 2 * Q * F := by
    intro a b c d ha hb hc hd
    have := abs_sub (a * b) (c * d)
    rw [abs_mul, abs_mul] at this
    have := mul_le_mul ha hb (abs_nonneg _) hQ
    have := mul_le_mul hc hd (abs_nonneg _) hQ
    linarith
  have df : ∀ a b : ℝ, |a| ≤ F → |b| ≤ F → |a - b| ≤ 2 * F := by
    intro a b ha hb; have := abs_sub a b; linarith
  have dq : ∀ a b : ℝ, |a| ≤ Q → |b| ≤ Q → |a - b| ≤ 2 * Q := by
    intro a b ha hb; have := abs_sub a b; linarith
  have e0 : D * v0 = s1 * (q1 * f2 - q2 * f1) + s2 * (-(f2 - f1)) + s3 * (q2 - q1) := by
    simp only [D, s1, s2, s3]; ring
  have e1 : D * v1 = s1 * (-(q0 * f2 - q2 * f0)) + s2 * (f2 - f0) + s3 * (-(q2 - q0)) := by
    simp only [D, s1, s2, s3]; ring
  have e2 : D * v2 = s1 * (q0 * f1 - q1 * f0) + s2 * (-(f1 - f0)) + s3 * (q1 - q0) := by
    simp only [D, s1, s2, s3]; ring
  have b0 : |D| * |v0| ≤ m * (2 * Q * F + 2 * F + 2 * Q) := by
    rw [← abs_mul, e0]
    refine (msub_comb_le hs1 hs2 hs3).trans (mul_le_mul_of_nonneg_left ?_ hm)
    rw [abs_neg]
    linarith [pq q1 f2 q2 f1 hq1 hf2 hq2 hf1, df f2 f1 hf2 hf1, dq q2 q1 hq2 hq1]
  have b1 : |D| * |v1| ≤ m * (2 * Q * F + 2 * F + 2 * Q) := by
    rw [← abs_mul, e1]
    refine (msub_comb_le hs1 hs2 hs3).trans (mul_le_mul_of_nonneg_left ?_ hm)
    rw [abs_neg, abs_neg]
    linarith [pq q0 f2 q2 f0 hq0 hf2 hq2 hf0, df f2 f0 hf2 hf0, dq q2 q0 hq2 hq0]
  have b2 : |D| * |v2| ≤ m * (2 * Q * F + 2 * F + 2 * Q) := by
    rw [← abs_mul, e2]
    refine (msub_comb_le hs1 hs2 hs3).trans (mul_le_mul_of_nonneg_left ?_ hm)
    rw [abs_neg]
    linarith [pq q0 f1 q1 f0 hq0 hf1 hq1 hf0, df f1 f0 hf1 hf0, dq q1 q0 hq1 hq0]
  rw [mul_max_of_nonneg _ _ (abs_nonneg D), mul_max_of_nonneg _ _ (abs_nonneg D)]
  exact max_le b0 (max_le b1 b2)

/-- (AL1): quantitative invertibility of the differential via the cofactor formula. -/
theorem msub_M_lower {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A ≤ B) :
    ∃ K, 0 < K ∧ ∀ c ∈ msubI3 A B, ∀ v : ℝ × ℝ × ℝ,
      |msubDet r c| * ‖v‖ ≤ K * ‖msubM r c v‖ := by
  obtain ⟨qm, qM, hqm, hq⟩ := msub_q_bounds (by linarith : (0:ℝ) < r) hA hAB
  have hqM : 0 < qM := lt_of_lt_of_le hqm ((hq A ⟨le_rfl, hAB⟩).1.trans (hq A ⟨le_rfl, hAB⟩).2)
  refine ⟨2 * qM * A⁻¹ + 2 * A⁻¹ + 2 * qM, by positivity, ?_⟩
  rintro c ⟨h0, h1, h2⟩ v
  have hqa : ∀ x ∈ Icc A B, |monoq r x| ≤ qM := fun x hx => by
    rw [abs_of_pos (lt_of_lt_of_le hqm (hq x hx).1)]; exact (hq x hx).2
  have hfa : ∀ x ∈ Icc A B, |x⁻¹| ≤ A⁻¹ := fun x hx => by
    have hx0 : 0 < x := lt_of_lt_of_le hA hx.1
    rw [abs_of_pos (inv_pos.mpr hx0)]; exact inv_anti₀ hA hx.1
  have c1 : |-(c.1⁻¹ * v.1) + c.2.1⁻¹ * v.2.1 - c.2.2⁻¹ * v.2.2| ≤ ‖msubM r c v‖ := by
    rw [msub_norm3]; exact le_max_left _ _
  have c2 : |-v.1 + v.2.1 - v.2.2| ≤ ‖msubM r c v‖ := by
    rw [msub_norm3]; exact (le_max_left _ _).trans (le_max_right _ _)
  have c3 : |monoq r c.1 * v.1 - monoq r c.2.1 * v.2.1 + monoq r c.2.2 * v.2.2| ≤
      ‖msubM r c v‖ := by
    rw [msub_norm3]; exact (le_max_right _ _).trans (le_max_right _ _)
  have key := msub_cramer (v0 := -v.1) (v1 := v.2.1) (v2 := -v.2.2)
    (hqa _ h0) (hqa _ h1) (hqa _ h2) (hfa _ h0) (hfa _ h1) (hfa _ h2)
    (m := ‖msubM r c v‖)
    (by rw [show -v.1 + v.2.1 + -v.2.2 = -v.1 + v.2.1 - v.2.2 by ring]; exact c2)
    (by rw [show monoq r c.1 * -v.1 + monoq r c.2.1 * v.2.1 + monoq r c.2.2 * -v.2.2 =
          -(monoq r c.1 * v.1 - monoq r c.2.1 * v.2.1 + monoq r c.2.2 * v.2.2) by ring, abs_neg]
        exact c3)
    (by rw [show c.1⁻¹ * -v.1 + c.2.1⁻¹ * v.2.1 + c.2.2⁻¹ * -v.2.2 =
          -(c.1⁻¹ * v.1) + c.2.1⁻¹ * v.2.1 - c.2.2⁻¹ * v.2.2 by ring]; exact c1)
  rw [abs_neg, abs_neg] at key
  rw [msub_norm3 v]
  have : msubDet r c = (monoq r c.2.1 - monoq r c.1) * (c.2.2⁻¹ - c.1⁻¹) -
      (monoq r c.2.2 - monoq r c.1) * (c.2.1⁻¹ - c.1⁻¹) := rfl
  rw [this]; linarith

end
end Auto

