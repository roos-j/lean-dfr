theorem ms8_monoPhi_nonneg (x : ℝ) : 0 ≤ monoPhi x := Real.smoothTransition.nonneg _
theorem ms8_monoPhi_le_one (x : ℝ) : monoPhi x ≤ 1 := Real.smoothTransition.le_one _

theorem ms8_abs_monoPsiA_le (x : ℝ) : |monoPsiA x| ≤ 1 := by
  unfold monoPsiA
  have := ms8_monoPhi_nonneg x; have := ms8_monoPhi_le_one x
  have := ms8_monoPhi_nonneg (2 * x); have := ms8_monoPhi_le_one (2 * x)
  rw [abs_le]; constructor <;> linarith

theorem ms8_fourier_multK {ϑ : ℝ → ℝ} (hs : ContDiff ℝ ∞ ϑ) (hc : HasCompactSupport ϑ) (ξ : ℝ) :
    𝓕 (⇑(monoMultK hs hc)) ξ = (ϑ ξ : ℂ) := by
  have h : 𝓕 (monoMultK hs hc) = monoMultS hs hc := fourier_fourierInv_eq _
  rw [← SchwartzMap.fourier_coe, h]; rfl

theorem ms8_fourier_KPhi (ξ : ℝ) : 𝓕 (⇑monoKPhi) ξ = (monoPhi ξ : ℂ) := ms8_fourier_multK _ _ ξ
theorem ms8_fourier_KPsiA (ξ : ℝ) : 𝓕 (⇑monoKPsiA) ξ = (monoPsiA ξ : ℂ) := ms8_fourier_multK _ _ ξ

/-- `𝓕(L κ(L ·))(ξ) = 𝓕κ(ξ/L)`. -/
theorem ms8_fourier_scaled (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L) (ξ : ℝ) :
    𝓕 (fun s : ℝ => (L : ℂ) * κ (L * s)) ξ = 𝓕 (⇑κ) (ξ / L) := by
  rw [Real.fourier_real_eq]
  have e1 : ∀ v : ℝ, 𝐞 (-(v * ξ)) • ((L : ℂ) * κ (L * v))
      = (fun u : ℝ => (L : ℂ) * ((𝐞 (-(u * (ξ / L))) : ℂ) * κ u)) (L * v) := by
    intro v
    simp only [Circle.smul_def, smul_eq_mul]
    have : -(v * ξ) = -(L * v * (ξ / L)) := by field_simp
    rw [this]; ring
  simp_rw [e1]
  rw [Measure.integral_comp_mul_left (fun u : ℝ => (L : ℂ) * ((𝐞 (-(u * (ξ / L))) : ℂ) *
    κ u)) L, integral_const_mul, Real.fourier_real_eq]
  simp only [Circle.smul_def, smul_eq_mul]
  rw [abs_inv, abs_of_pos hL, Complex.real_smul, ← mul_assoc, Complex.ofReal_inv,
    inv_mul_cancel₀ (by exact_mod_cast hL.ne'), one_mul]

theorem ms8_integrable_char_smul {f : ℝ → ℂ} (hf : Integrable f volume) (hc : Continuous f) (s : ℝ) :
    Integrable (fun v : ℝ => 𝐞 ⟪v, s⟫ • f v) volume := by
  refine hf.norm.mono' ?_ (Eventually.of_forall fun v => ?_)
  · exact (Continuous.aestronglyMeasurable (by fun_prop))
  · simp [Circle.smul_def, Circle.norm_coe]

/-- The kernel identity `κ_ψ(s) = κ_φ(s) - ½ κ_φ(s/2)`. -/
theorem ms8_KPsiA_eq (s : ℝ) :
    monoKPsiA s = monoKPhi s - (1 / 2 : ℂ) * monoKPhi (s / 2) := by
  have hK : ∀ (ϑ : ℝ → ℝ) (hs : ContDiff ℝ ∞ ϑ) (hc : HasCompactSupport ϑ) (w : ℝ),
      monoMultK hs hc w = ∫ v, 𝐞 ⟪v, w⟫ • (ϑ v : ℂ) := by
    intro ϑ hs hc w
    rw [monoMultK, SchwartzMap.fourierInv_coe, Real.fourierInv_eq]; rfl
  have hI1 : Integrable (fun v : ℝ => 𝐞 ⟪v, s⟫ • ((monoPhi v : ℝ) : ℂ)) volume :=
    ms8_integrable_char_smul (monoMultS monoPhi_contDiff monoPhi_hasCompactSupport).integrable
      (monoMultS monoPhi_contDiff monoPhi_hasCompactSupport).continuous s
  have hc2 : Continuous fun v : ℝ => ((monoPhi (2 * v) : ℝ) : ℂ) :=
    Complex.continuous_ofReal.comp (monoPhi_contDiff.continuous.comp (continuous_const.mul continuous_id))
  have hI2' : Integrable (fun v : ℝ => ((monoPhi (2 * v) : ℝ) : ℂ)) volume := by
    have := (monoMultS monoPhi_contDiff monoPhi_hasCompactSupport).integrable (μ := volume)
    exact this.comp_mul_left' (by norm_num : (2:ℝ) ≠ 0)
  have hI2 := ms8_integrable_char_smul hI2' hc2 s
  rw [monoKPsiA, monoKPhi, hK, hK, hK]
  simp only [monoPsiA, Complex.ofReal_sub, smul_sub]
  rw [integral_sub hI1 hI2]
  congr 1
  have e : ∀ v : ℝ, 𝐞 ⟪v, s⟫ • ((monoPhi (2 * v) : ℝ) : ℂ)
      = (fun u : ℝ => 𝐞 ⟪u, s / 2⟫ • ((monoPhi u : ℝ) : ℂ)) (2 * v) := by
    intro v
    have : ⟪2 * v, s / 2⟫ = ⟪v, s⟫ := by
      simp only [real_inner_eq_re_inner, RCLike.inner_apply, conj_trivial]; ring
    simp only [this]
  simp_rw [e]
  rw [Measure.integral_comp_mul_left (fun u : ℝ => 𝐞 ⟪u, s / 2⟫ • ((monoPhi u : ℝ) : ℂ)) 2]
  norm_num [Complex.real_smul]

end

