    · exact hsmall _ _ (hbP 0 _ (L / 2) (by positivity) hkP' u₁ hb₁) (hbP 1 _ L hL0 hkA' u₂ hb₂)
        (not_le.mp hL16)

/-- **Proposition 6.1** from Lemma 5.1. -/
theorem mono_local61 {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) (hLC : MonoLocCorr r A B) :
    MonoLocal61 r A B := by
  intro χ hχ hχc
  obtain ⟨C, hC0, hN⟩ := mono61_normalized hr hA hAB hLC χ hχ hχc
  refine ⟨C, (1 / 39 : ℝ) / 256, hC0, by norm_num, ?_⟩
  intro ψ hψ hψs L hL u₁ u₂ hu₁ hu₂ B₁ B₂ hb₁ hb₂
  have hB₁ : 0 ≤ B₁ := (norm_nonneg _).trans (hb₁ 0)
  have hB₂ : 0 ≤ B₂ := (norm_nonneg _).trans (hb₂ 0)
  obtain ⟨v₁, hv₁, hbv₁, rfl⟩ := exists_normalize hu₁ hb₁
  obtain ⟨v₂, hv₂, hbv₂, rfl⟩ := exists_normalize hu₂ hb₂
  have hc := monoC20_nonneg ψ
  have hψc : HasCompactSupport ψ := isCompact_Icc.of_isClosed_subset (isClosed_tsupport ψ) hψs
  rcases hc.eq_or_lt with hc0 | hc0
  · have hψ0 := eq_zero_of_monoC20 hψ hψc hc0.symm
    subst hψ0
    have e : ∀ (f₁ f₂ : ℝ × ℝ → ℂ), (fun z => (χ z : ℂ) * monoT r (0 : ℝ → ℝ) f₁ f₂ z) = 0 := by
      intro f₁ f₂; funext z; simp [monoT_zero_psi]
    simp only [e, eLpNorm_zero, zero_le, and_self]
  set c := monoC20 ψ
  set ψ' : ℝ → ℝ := fun t => c⁻¹ * ψ t
  have hψ' : ContDiff ℝ ∞ ψ' := contDiff_const.mul hψ
  have hψ's : tsupport ψ' ⊆ Icc A B :=
    (tsupport_mul_subset_right (f := fun _ => c⁻¹) (g := ψ)).trans hψs
  have hC20' : monoC20 ψ' ≤ 1 := by
    rw [monoC20_const_mul hψ (inv_nonneg.mpr hc), inv_mul_cancel₀ hc0.ne']
  have eψ : ψ = fun t => c * ψ' t := by funext t; simp only [ψ']; field_simp
  obtain ⟨n₁, n₂⟩ := hN ψ' hψ' hψ's hC20' L hL v₁ v₂ hv₁ hv₂ hbv₁ hbv₂
  have hscale : ∀ (f₁ f₂ : ℝ × ℝ → ℂ),
      (fun z => (χ z : ℂ) * monoT r ψ (fun w => (B₁ : ℂ) * f₁ w) (fun w => (B₂ : ℂ) * f₂ w) z)
        = ((c * B₁ * B₂ : ℝ) : ℂ) • fun z => (χ z : ℂ) * monoT r ψ' f₁ f₂ z := by
    intro f₁ f₂; funext z
    simp only [Pi.smul_apply, smul_eq_mul]
    rw [monoT_smul_left, monoT_smul_right, eψ, monoT_const_mul_psi]
    push_cast; ring
  have hfin : ∀ X : ℝ≥0∞, X ≤ ENNReal.ofReal (C * L ^ (-((1 / 39 : ℝ) / 256))) →
      ENNReal.ofReal (c * B₁ * B₂) * X
        ≤ ENNReal.ofReal (C * c * L ^ (-((1 / 39 : ℝ) / 256)) * B₁ * B₂) := by
    intro X hX
    refine (mul_le_mul' le_rfl hX).trans ?_
    rw [← ENNReal.ofReal_mul (by positivity)]
    exact ENNReal.ofReal_le_ofReal (le_of_eq (by ring))
  constructor
  · rw [monoP_smul, monoP_smul, hscale, eLpNorm_const_smul, enorm_ofReal_complex (by positivity)]
    exact hfin _ n₁
  · rw [monoP_smul, monoP_smul, hscale, eLpNorm_const_smul, enorm_ofReal_complex (by positivity)]
    exact hfin _ n₂

end

