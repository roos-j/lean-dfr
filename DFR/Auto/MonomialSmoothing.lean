/-! ### Lemma 2.1 on fibers, measurably (lines 309-313) -/

theorem measurable_monoPt_pair (j : Fin 2) :
    Measurable fun q : (ℝ × ℝ) × ℝ => monoPt j (q.1.2 - q.2) q.1.1 :=
  (measurable_monoPt j).comp ((measurable_snd.comp measurable_fst).sub measurable_snd |>.prodMk
    (measurable_fst.comp measurable_fst))

theorem monoPiece_fib_eq (j : Fin 2) (R : ℝ) (n : ℤ) (G : ℝ × ℝ → ℂ) (q : ℝ × ℝ) :
    monoPiece R n (monoFib j G q.1) q.2 = ∫ t, monoKn R n t * G (monoPt j (q.2 - t) q.1) := by
  rw [monoPiece_apply]; rfl

theorem measurable_monoPiece_fib' (j : Fin 2) {R : ℝ} (n : ℤ) {G : ℝ × ℝ → ℂ} (hG : Measurable G) :
    Measurable fun q : ℝ × ℝ => monoPiece R n (monoFib j G q.1) q.2 := by
  have hk : Measurable (monoKn R n) := by unfold monoKn; fun_prop
  have h : StronglyMeasurable (Function.uncurry fun (q : ℝ × ℝ) (t : ℝ) =>
      monoKn R n t * G (monoPt j (q.2 - t) q.1)) :=
    Measurable.stronglyMeasurable ((hk.comp measurable_snd).mul (hG.comp
      ((measurable_monoPt j).comp (((measurable_snd.comp measurable_fst).sub
        measurable_snd).prodMk (measurable_fst.comp measurable_fst)))))
  have e : (fun q : ℝ × ℝ => monoPiece R n (monoFib j G q.1) q.2)
      = fun q => ∫ t, monoKn R n t * G (monoPt j (q.2 - t) q.1) :=
    funext (monoPiece_fib_eq j R n G)
  rw [e]
  exact h.integral_prod_right'.measurable

/-- `(p, ξ) ↦ (fiber_p G)^(ξ)` is jointly measurable. -/
theorem measurable_fourier_fib (j : Fin 2) {G : ℝ × ℝ → ℂ} (hG : Measurable G) :
    Measurable fun q : ℝ × ℝ => 𝓕 (monoFib j G q.1) q.2 := by
  have h : StronglyMeasurable (Function.uncurry fun (q : ℝ × ℝ) (a : ℝ) =>
      (𝐞 (-(a * q.2)) : ℂ) * G (monoPt j a q.1)) :=
    Measurable.stronglyMeasurable ((by fun_prop : Measurable fun x : (ℝ × ℝ) × ℝ =>
      ((𝐞 (-(x.2 * x.1.2)) : Circle) : ℂ)).mul (hG.comp ((measurable_monoPt j).comp
        (measurable_snd.prodMk (measurable_fst.comp measurable_fst)))))
  have e : (fun q : ℝ × ℝ => 𝓕 (monoFib j G q.1) q.2)
      = fun q => ∫ a, (𝐞 (-(a * q.2)) : ℂ) * G (monoPt j a q.1) := by
    funext q; rw [Real.fourier_real_eq]; rfl
  rw [e]
  exact h.integral_prod_right'.measurable

theorem measurable_monoE_fib (j : Fin 2) {G : ℝ × ℝ → ℂ} (hG : Measurable G) :
    Measurable fun p => monoE (monoFib j G p) := by
  unfold monoE
  exact ((measurable_fourier_fib j hG).enorm.pow_const 2).lintegral_prod_right'

theorem measurable_interval_fib (j : Fin 2) {G : ℝ × ℝ → ℂ} (hG : Measurable G) (a b : ℝ) :
    Measurable fun p => ∫⁻ ξ in Icc a b, ‖𝓕 (monoFib j G p) ξ‖ₑ ^ 2 :=
  ((measurable_fourier_fib j hG).enorm.pow_const 2).lintegral_prod_right'

/-- The selected integers of the fibers form measurable sets of passive coordinates. -/
theorem measurableSet_sel_fib (j : Fin 2) {R ρ : ℝ} (hR : 0 < R) (hρ : 0 < ρ) {G : ℝ × ℝ → ℂ}
    (hG : Measurable G) (hint : ∀ p, Integrable (monoFib j G p) volume)
    (hfin : ∀ p, monoE (monoFib j G p) ≠ ⊤) (n : ℤ) :
    MeasurableSet {p | n ∈ monoSel R ρ (monoFib j G p)} := by
  have e : {p | n ∈ monoSel R ρ (monoFib j G p)} = {p | monoSelP R ρ (monoFib j G p) n} := by
    ext p; exact mem_monoSel hR hρ (hint p) (hfin p) n
  rw [e]
  exact measurableSet_lt ((measurable_monoE_fib j hG).const_mul _)
    (measurable_interval_fib j hG _ _)

/-- The sharp part of `G` along its active coordinate: `G_♯(z) = (fiber G)_♯(active z)`. -/
def monoSharp2 (j : Fin 2) (R ρ : ℝ) (G : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℂ :=
  monoSharp R ρ (monoFib j G (monoPas j z)) (monoAct j z)

/-- The flat part `G_♭ = G - G_♯`. -/
def monoFlat2 (j : Fin 2) (R ρ : ℝ) (G : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℂ :=
  G z - monoSharp2 j R ρ G z

theorem monoFlat2_fib (j : Fin 2) (R ρ : ℝ) (G : ℝ × ℝ → ℂ) (p a : ℝ) :
    monoFib j (monoFlat2 j R ρ G) p a = monoFlat R ρ (monoFib j G p) a := by
  simp [monoFib, monoFlat2, monoFlat, monoSharp2, monoAct_pt, monoPas_pt]

theorem monoSharp2_fib (j : Fin 2) (R ρ : ℝ) (G : ℝ × ℝ → ℂ) (p a : ℝ) :
    monoFib j (monoSharp2 j R ρ G) p a = monoSharp R ρ (monoFib j G p) a := by
  simp [monoFib, monoSharp2, monoAct_pt, monoPas_pt]

/-- The sharp part as a limit of finite sums over `[-N, N]`. -/
theorem tendsto_monoSharp_trunc {R ρ : ℝ} (F : ℝ → ℂ) (a : ℝ) :
    Tendsto (fun N : ℕ => ∑ n ∈ Finset.Icc (-(N : ℤ)) N,
      if n ∈ monoSel R ρ F then monoPiece R n F a else 0) atTop (𝓝 (monoSharp R ρ F a)) := by
  obtain ⟨N0, hN0⟩ : ∃ N0 : ℕ, monoSel R ρ F ⊆ Finset.Icc (-(N0 : ℤ)) N0 := by
    refine ⟨(monoSel R ρ F).sup fun n => n.natAbs, fun n hn => ?_⟩
    have h1 : n.natAbs ≤ (monoSel R ρ F).sup fun n => n.natAbs := Finset.le_sup (f := fun n => n.natAbs) hn
    rw [Finset.mem_Icc]; omega
  refine tendsto_atTop_of_eventually_const (i₀ := N0) fun N hN => ?_
  have hsub : monoSel R ρ F ⊆ Finset.Icc (-(N : ℤ)) N :=
    hN0.trans (Finset.Icc_subset_Icc (by omega) (by omega))
  rw [Finset.sum_ite, Finset.sum_const_zero, add_zero, monoSharp]
  congr 1
  ext n; simp only [Finset.mem_filter]; constructor
  · rintro ⟨_, h⟩; exact h
  · intro h; exact ⟨hsub h, h⟩

theorem measurable_monoSharp2 (j : Fin 2) {R ρ : ℝ} (hR : 0 < R) (hρ : 0 < ρ) {G : ℝ × ℝ → ℂ}
    (hG : Measurable G) (hint : ∀ p, Integrable (monoFib j G p) volume)
    (hfin : ∀ p, monoE (monoFib j G p) ≠ ⊤) : Measurable (monoSharp2 j R ρ G) := by
  have hq : Measurable fun z : ℝ × ℝ => (monoPas j z, monoAct j z) := by
    unfold monoPas monoAct; fin_cases j <;> simp <;> fun_prop
  refine measurable_of_tendsto_metrizable (f := fun N z => ∑ n ∈ Finset.Icc (-(N : ℤ)) N,
    if n ∈ monoSel R ρ (monoFib j G (monoPas j z)) then
      monoPiece R n (monoFib j G (monoPas j z)) (monoAct j z) else 0) (fun N => ?_) ?_
  · refine Finset.measurable_sum _ fun n _ => ?_
    refine Measurable.ite ?_ ((measurable_monoPiece_fib' j n hG).comp hq) measurable_const
    exact (measurableSet_sel_fib j hR hρ hG hint hfin n).preimage
      ((measurable_fst.comp hq))
  · exact tendsto_pi_nhds.mpr fun z => tendsto_monoSharp_trunc _ _

end

