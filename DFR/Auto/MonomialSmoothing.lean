/-! ### Fibers of the coordinate multipliers: Fourier support and `L²` bounds -/

/-- The fiber of `ϑ(D_j/L) g` is the one-dimensional convolution with `L κ(L ·)`. -/
theorem mloc_P_fib (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L : ℝ) (g : ℝ × ℝ → ℂ) (p : ℝ) :
    monoFib j (monoP j κ L g) p =
      (fun s => (L : ℂ) * κ (L * s)) ⋆[ContinuousLinearMap.mul ℂ ℂ] monoFib j g p :=
  funext fun a => monoCConv_fib j _ g p a

/-- The fiber of `ϑ(D_j/L) g` is integrable when the fiber of `g` is. -/
theorem mloc_P_fib_integrable (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : L ≠ 0)
    {g : ℝ × ℝ → ℂ} {p : ℝ} (hg : Integrable (monoFib j g p)) :
    Integrable (monoFib j (monoP j κ L g) p) := by
  rw [mloc_P_fib]
  exact (mloc_integrable_dil κ hL).integrable_convolution _ hg

/-- **Fiber Fourier support**: `𝓕 (fiber of ϑ(D_j/L) g) (ξ) = ϑ(ξ/L) 𝓕 (fiber of g) (ξ)`. -/
theorem mloc_P_fib_fourier (j : Fin 2) {ϑ : ℝ → ℝ} (hs : ContDiff ℝ ∞ ϑ) (hc : HasCompactSupport ϑ)
    {L : ℝ} (hL : 0 < L) {g : ℝ × ℝ → ℂ} {p : ℝ} (hg : Integrable (monoFib j g p)) (ξ : ℝ) :
    𝓕 (monoFib j (monoP j (monoMultK hs hc) L g) p) ξ =
      (ϑ (ξ / L) : ℂ) * 𝓕 (monoFib j g p) ξ := by
  rw [mloc_P_fib, Real.fourier_mul_convolution_eq (mloc_integrable_dil _ hL.ne') hg,
    mloc_fourier_dil _ hL, mloc_fourier_multK]

theorem mloc_half_sq (x : ℝ≥0∞) : (x ^ (1 / 2 : ℝ)) ^ 2 = x := by
  rw [← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]; norm_num

/-- Weighted Cauchy-Schwarz: `(∫ a b)² ≤ (∫ a) (∫ a b²)`. -/
theorem mloc_wcs {a b : ℝ → ℝ≥0∞} (ha : Measurable a) (hb : Measurable b) :
    (∫⁻ s, a s * b s) ^ 2 ≤ (∫⁻ s, a s) * ∫⁻ s, a s * b s ^ 2 := by
  have hH := ENNReal.lintegral_mul_le_Lp_mul_Lq volume Real.HolderConjugate.two_two
    (f := fun s => a s ^ (1 / 2 : ℝ)) (g := fun s => a s ^ (1 / 2 : ℝ) * b s)
    (ha.pow_const _).aemeasurable ((ha.pow_const _).mul hb).aemeasurable
  have e1 : ∀ s, ((fun s => a s ^ (1 / 2 : ℝ)) * fun s => a s ^ (1 / 2 : ℝ) * b s) s =
      a s * b s := by
    intro s
    simp only [Pi.mul_apply, ← mul_assoc, ← pow_two, mloc_half_sq]
  have e2 : ∀ s, (a s ^ (1 / 2 : ℝ)) ^ (2 : ℝ) = a s := by
    intro s; rw [ENNReal.rpow_two, mloc_half_sq]
  have e3 : ∀ s, (a s ^ (1 / 2 : ℝ) * b s) ^ (2 : ℝ) = a s * b s ^ 2 := by
    intro s; rw [ENNReal.rpow_two, mul_pow, mloc_half_sq]
  simp only [e1, e2, e3] at hH
  calc (∫⁻ s, a s * b s) ^ 2
      ≤ ((∫⁻ s, a s) ^ (1 / 2 : ℝ) * (∫⁻ s, a s * b s ^ 2) ^ (1 / 2 : ℝ)) ^ 2 := by gcongr
    _ = _ := by rw [mul_pow, mloc_half_sq, mloc_half_sq]

/-- **The fiber `L²` bound** `‖fiber of ϑ(D_j/L) g‖_2² ≤ ‖κ‖_1² ‖fiber of g‖_2²`. -/
theorem mloc_P_fib_lintegral_sq (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L)
    {g : ℝ × ℝ → ℂ} (hg : Measurable g) (p : ℝ) :
    ∫⁻ a, ‖monoFib j (monoP j κ L g) p a‖ₑ ^ 2 ≤
      ENNReal.ofReal (∫ s, ‖κ s‖) ^ 2 * ∫⁻ a, ‖monoFib j g p a‖ₑ ^ 2 := by
  set k := fun s => (L : ℂ) * κ (L * s)
  set F := monoFib j g p
  have hk : Integrable k := mloc_integrable_dil κ hL.ne'
  have hkm : Measurable fun s => ‖k s‖ₑ := (mloc_continuous_dil κ L).enorm.measurable
  have hF : Measurable F := measurable_monoFib hg p
  have hFm : Measurable fun s => ‖F s‖ₑ := hF.enorm
  have hK : ∫⁻ s, ‖k s‖ₑ = ENNReal.ofReal (∫ s, ‖κ s‖) := by
    rw [← ofReal_integral_norm_eq_lintegral_enorm hk, mloc_integral_norm_dil κ hL]
  have hpt : ∀ a, ‖monoFib j (monoP j κ L g) p a‖ₑ ^ 2 ≤
      (∫⁻ s, ‖k s‖ₑ) * ∫⁻ s, ‖k s‖ₑ * ‖F (a - s)‖ₑ ^ 2 := by
    intro a
    have h1 : ‖monoFib j (monoP j κ L g) p a‖ₑ ≤ ∫⁻ s, ‖k s‖ₑ * ‖F (a - s)‖ₑ := by
      rw [mloc_P_fib, convolution_def]
      refine (enorm_integral_le_lintegral_enorm _).trans (le_of_eq ?_)
      congr 1; ext s
      simp only [ContinuousLinearMap.mul_apply', k, F, enorm_mul]
    calc _ ≤ (∫⁻ s, ‖k s‖ₑ * ‖F (a - s)‖ₑ) ^ 2 := by gcongr
      _ ≤ _ := mloc_wcs hkm (hFm.comp (measurable_const.sub measurable_id))
  have hmeas : Measurable (Function.uncurry fun (a s : ℝ) => ‖k s‖ₑ * ‖F (a - s)‖ₑ ^ 2) :=
    (hkm.comp measurable_snd).mul ((hFm.comp (measurable_fst.sub measurable_snd)).pow_const _)
  calc _ ≤ ∫⁻ a, (∫⁻ s, ‖k s‖ₑ) * ∫⁻ s, ‖k s‖ₑ * ‖F (a - s)‖ₑ ^ 2 := lintegral_mono hpt
    _ = (∫⁻ s, ‖k s‖ₑ) * ∫⁻ s, ∫⁻ a, ‖k s‖ₑ * ‖F (a - s)‖ₑ ^ 2 := by
        rw [lintegral_const_mul' _ _ (by rw [hK]; exact ENNReal.ofReal_ne_top),
          lintegral_lintegral_swap hmeas.aemeasurable]
    _ = (∫⁻ s, ‖k s‖ₑ) * ∫⁻ s, ‖k s‖ₑ * ∫⁻ a, ‖F a‖ₑ ^ 2 := by
        congr 1; congr 1; ext s
        rw [lintegral_const_mul' _ _ (by
            simp only [k, enorm_mul]; exact ENNReal.mul_ne_top enorm_ne_top enorm_ne_top),
          lintegral_sub_right_eq_self (fun a => ‖F a‖ₑ ^ 2) s]
    _ = _ := by
        rw [lintegral_mul_const _ hkm, hK, ← mul_assoc, ← pow_two]

end

end Auto

