open MeasureTheory Filter Topology Set FourierTransform Convolution
open scoped ENNReal SchwartzMap Real ContDiff

namespace Auto

noncomputable section

/-! ### The localized pieces `u_{j,m} = P̃_j(η_m f_j)` (lines 952-982) -/

/-- The active index of `m`. -/
def monoMAct (j : Fin 2) (m : ℤ × ℤ) : ℤ := if j = 0 then m.1 else m.2

/-- The passive index of `m`. -/
def monoMPas (j : Fin 2) (m : ℤ × ℤ) : ℤ := if j = 0 then m.2 else m.1

theorem monoEta_pt (j : Fin 2) (h : ℝ) (m : ℤ × ℤ) (a p : ℝ) :
    monoEta h m (monoPt j a p)
      = smoothingPartitionCutoff (a / h - monoMAct j m) * smoothingPartitionCutoff (p / h - monoMPas j m) := by
  fin_cases j <;> simp [monoEta, monoPt, monoMAct, monoMPas, mul_comm]

theorem monoChiM_pt (j : Fin 2) (h : ℝ) (m : ℤ × ℤ) (a p : ℝ) :
    monoChiM h m (monoPt j a p) = monoBeta (a / h - monoMAct j m) * monoBeta (p / h - monoMPas j m) := by
  fin_cases j <;> simp [monoChiM, monoPt, monoMAct, monoMPas, mul_comm]

/-- A bounded measurable function supported in `[c, d]` is integrable with
`∫ |F|^2 ≤ M^2 (d - c)`. -/
theorem mono_integrable_of_bdd_Icc {F : ℝ → ℂ} (hF : AEStronglyMeasurable F volume) {M c d : ℝ}
    (hM : ∀ a, ‖F a‖ ≤ M) (hS : ∀ a, F a ≠ 0 → a ∈ Icc c d) : Integrable F volume := by
  have hind : F = (Icc c d).indicator F := by
    funext a; by_cases ha : a ∈ Icc c d
    · rw [indicator_of_mem ha]
    · rw [indicator_of_notMem ha]; by_contra h; exact ha (hS a h)
  rw [hind]
  have hI : IntegrableOn F (Icc c d) volume :=
    Measure.integrableOn_of_bounded (M := M) measure_Icc_lt_top.ne hF
      (Eventually.of_forall hM)
  exact hI.integrable_indicator measurableSet_Icc

theorem lintegral_sq_le_of_bdd_Icc {F : ℝ → ℂ} {M c d : ℝ} (hM0 : 0 ≤ M) (hM : ∀ a, ‖F a‖ ≤ M)
    (hS : ∀ a, F a ≠ 0 → a ∈ Icc c d) :
    ∫⁻ a, ‖F a‖ₑ ^ 2 ≤ ENNReal.ofReal (M ^ 2 * (d - c)) := by
  calc ∫⁻ a, ‖F a‖ₑ ^ 2 ≤ ∫⁻ a, (Icc c d).indicator (fun _ => ENNReal.ofReal (M ^ 2)) a := by
        refine lintegral_mono fun a => ?_
        by_cases ha : a ∈ Icc c d
        · rw [indicator_of_mem ha, ← ofReal_norm, ← ENNReal.ofReal_pow (norm_nonneg _)]
          exact ENNReal.ofReal_le_ofReal (pow_le_pow_left₀ (norm_nonneg _) (hM a) 2)
        · have : F a = 0 := by by_contra h; exact ha (hS a h)
          simp [this]
    _ = ENNReal.ofReal (M ^ 2) * volume (Icc c d) := by
        rw [lintegral_indicator measurableSet_Icc, setLIntegral_const]
    _ ≤ ENNReal.ofReal (M ^ 2 * (d - c)) := by
        rw [Real.volume_Icc]
        by_cases hcd : c ≤ d
        · rw [← ENNReal.ofReal_mul (by positivity)]
        · rw [ENNReal.ofReal_of_nonpos (show d - c ≤ 0 by linarith), mul_zero]; exact bot_le

/-- The localized function `η_m f`. -/
def monoEtaF (h : ℝ) (m : ℤ × ℤ) (f : ℝ × ℝ → ℂ) (w : ℝ × ℝ) : ℂ := (monoEta h m w : ℂ) * f w

theorem monoEtaF_fib_ne_zero {j : Fin 2} {h : ℝ} (hh : 0 < h) {m : ℤ × ℤ} {f : ℝ × ℝ → ℂ} {p a : ℝ}
    (hz : monoFib j (monoEtaF h m f) p a ≠ 0) :
    a ∈ Icc (h * (monoMAct j m - 3 / 4)) (h * (monoMAct j m + 3 / 4)) ∧ |p / h - monoMPas j m| < 3 / 4 := by
  have hη : monoEta h m (monoPt j a p) ≠ 0 := by
    intro h0; apply hz; simp [monoFib, monoEtaF, h0]
  rw [monoEta_pt] at hη
  have h1 : smoothingPartitionCutoff (a / h - monoMAct j m) ≠ 0 := left_ne_zero_of_mul hη
  have h2 : smoothingPartitionCutoff (p / h - monoMPas j m) ≠ 0 := right_ne_zero_of_mul hη
  have h1' := mloc_theta_ne_zero h1
  have h2' := mloc_theta_ne_zero h2
  refine ⟨?_, h2'⟩
  obtain ⟨l, u⟩ := abs_lt.mp h1'
  constructor
  · have : monoMAct j m - 3 / 4 < a / h := by linarith
    rw [lt_div_iff₀ hh] at this; linarith
  · have : a / h < monoMAct j m + 3 / 4 := by linarith
    rw [div_lt_iff₀ hh] at this; linarith

theorem norm_monoEtaF_le {h : ℝ} {m : ℤ × ℤ} {f : ℝ × ℝ → ℂ} {M : ℝ} (hM : ∀ z, ‖f z‖ ≤ M)
    (z : ℝ × ℝ) : ‖monoEtaF h m f z‖ ≤ M := by
  rw [monoEtaF, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (mloc_Eta_nonneg _ _ _)]
  calc monoEta h m z * ‖f z‖ ≤ 1 * ‖f z‖ :=
        mul_le_mul_of_nonneg_right (mloc_Eta_le_one _ _ _) (norm_nonneg _)
    _ ≤ M := by rw [one_mul]; exact hM z

theorem measurable_monoEtaF {h : ℝ} {m : ℤ × ℤ} {f : ℝ × ℝ → ℂ} (hf : Measurable f) :
    Measurable (monoEtaF h m f) :=
  (mloc_monoEta_meas h m).mul hf

theorem integrable_monoEtaF_fib {j : Fin 2} {h : ℝ} (hh : 0 < h) {m : ℤ × ℤ} {f : ℝ × ℝ → ℂ}
    (hf : Measurable f) {M : ℝ} (hM : ∀ z, ‖f z‖ ≤ M) (p : ℝ) :
    Integrable (monoFib j (monoEtaF h m f) p) volume :=
  mono_integrable_of_bdd_Icc (measurable_monoFib (measurable_monoEtaF hf) p).aestronglyMeasurable
    (fun a => norm_monoEtaF_le hM _) fun a ha => (monoEtaF_fib_ne_zero hh ha).1

theorem lintegral_monoEtaF_fib_sq {j : Fin 2} {h : ℝ} (hh : 0 < h) {m : ℤ × ℤ} {f : ℝ × ℝ → ℂ}
    {M : ℝ} (hM0 : 0 ≤ M) (hM : ∀ z, ‖f z‖ ≤ M) (p : ℝ) :
    ∫⁻ a, ‖monoFib j (monoEtaF h m f) p a‖ₑ ^ 2 ≤ ENNReal.ofReal (M ^ 2 * (3 / 2 * h)) := by
  refine (lintegral_sq_le_of_bdd_Icc hM0 (fun a => norm_monoEtaF_le hM _)
    fun a ha => (monoEtaF_fib_ne_zero hh ha).1).trans (le_of_eq ?_)
  congr 1; ring

theorem monoEtaF_fib_eq_zero {j : Fin 2} {h : ℝ} (hh : 0 < h) {m : ℤ × ℤ} {f : ℝ × ℝ → ℂ} {p : ℝ}
    (hp : 3 / 4 ≤ |p / h - monoMPas j m|) : monoFib j (monoEtaF h m f) p = 0 := by
  funext a
  by_contra hz
  exact absurd (monoEtaF_fib_ne_zero hh hz).2 (not_lt.mpr hp)

/-- `u_{j,m} = P̃_j(η_m f)`. -/
def monoUjm (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L h : ℝ) (m : ℤ × ℤ) (f : ℝ × ℝ → ℂ) : ℝ × ℝ → ℂ :=
  monoP j κ L (monoEtaF h m f)

theorem measurable_monoUjm (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L h : ℝ) (m : ℤ × ℤ) {f : ℝ × ℝ → ℂ}
    (hf : Measurable f) : Measurable (monoUjm j κ L h m f) :=
  measurable_monoCConv (by fun_prop) (measurable_monoEtaF hf)

theorem norm_monoUjm_le (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L) (h : ℝ) (m : ℤ × ℤ)
    {f : ℝ × ℝ → ℂ} {M : ℝ} (hM : ∀ z, ‖f z‖ ≤ M) (z : ℝ × ℝ) :
    ‖monoUjm j κ L h m f z‖ ≤ (∫ s, ‖κ s‖) * M :=
  mloc_P_norm_le j κ hL (fun z => norm_monoEtaF_le hM z) z

theorem integrable_monoUjm_fib (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) {L h : ℝ} (hL : 0 < L) (hh : 0 < h)
    (m : ℤ × ℤ) {f : ℝ × ℝ → ℂ} (hf : Measurable f) {M : ℝ} (hM : ∀ z, ‖f z‖ ≤ M) (p : ℝ) :
    Integrable (monoFib j (monoUjm j κ L h m f) p) volume :=
  mloc_P_fib_integrable j κ hL.ne' (integrable_monoEtaF_fib hh hf hM p)

theorem lintegral_monoUjm_fib_sq (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) {L h : ℝ} (hL : 0 < L) (hh : 0 < h)
    (m : ℤ × ℤ) {f : ℝ × ℝ → ℂ} (hf : Measurable f) {M : ℝ} (hM0 : 0 ≤ M) (hM : ∀ z, ‖f z‖ ≤ M)
    (p : ℝ) :
    ∫⁻ a, ‖monoFib j (monoUjm j κ L h m f) p a‖ₑ ^ 2
      ≤ ENNReal.ofReal ((∫ s, ‖κ s‖) ^ 2 * (M ^ 2 * (3 / 2 * h))) := by
  refine (mloc_P_fib_lintegral_sq j κ hL (measurable_monoEtaF hf) p).trans ?_
  rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_pow (integral_nonneg fun _ => norm_nonneg _)]
  gcongr
  exact lintegral_monoEtaF_fib_sq hh hM0 hM p

theorem monoUjm_fib_eq_zero (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L : ℝ) {h : ℝ} (hh : 0 < h) (m : ℤ × ℤ)
    {f : ℝ × ℝ → ℂ} {p : ℝ} (hp : 3 / 4 ≤ |p / h - monoMPas j m|) :
    monoFib j (monoUjm j κ L h m f) p = 0 := by
  rw [monoUjm, mloc_P_fib, monoEtaF_fib_eq_zero hh hp]
  funext a
  simp [convolution_def]

end

