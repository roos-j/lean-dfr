theorem mimp_intInt_abs_rpow {B : ℝ} (hB : 0 < B) :
    IntegrableOn (fun x : ℝ => |x| ^ (-(1 / 2 : ℝ))) (Ioc (-B) B) := by
  have h0 : IntervalIntegrable (fun x : ℝ => |x| ^ (-(1 / 2 : ℝ))) volume 0 B := by
    rw [intervalIntegrable_iff_integrableOn_Ioc_of_le hB.le]
    have := (intervalIntegrable_iff_integrableOn_Ioc_of_le hB.le).1
      (intervalIntegral.intervalIntegrable_rpow' (a := 0) (b := B) (r := -(1 / 2 : ℝ)) (by norm_num))
    refine this.congr_fun (fun x hx => ?_) measurableSet_Ioc
    simp [abs_of_pos hx.1]
  have h1 : IntervalIntegrable (fun x : ℝ => |x| ^ (-(1 / 2 : ℝ))) volume (-B) 0 := by
    have := (IntervalIntegrable.iff_comp_neg (by simp)).1 h0
    simpa using this.symm
  rw [← intervalIntegrable_iff_integrableOn_Ioc_of_le (by linarith)]
  exact h1.trans h0

theorem mimp_K_finite {c L B : ℝ} (hc : 0 < c) (hB : 0 < B) :
    ∫⁻ v, mimpK c L B v ^ (3 / 2 : ℝ) < ∞ := by
  set K : ℝ := 2 * L * c ^ (-(3 / 2 : ℝ)) with hK
  have slice : ∀ h : ℝ, ∫⁻ y, mimpK c L B (h, y) ^ (3 / 2 : ℝ) ≤
      (Ioc (-B) B).indicator (fun h => ENNReal.ofReal (K * |h| ^ (-(1 / 2 : ℝ)))) h := by
    intro h
    by_cases hB' : h ∈ Ioc (-B) B
    · rw [indicator_of_mem hB']
      by_cases h0 : h = 0
      · subst h0
        simp [mimpK]
      have e : (fun y => mimpK c L B (h, y) ^ (3 / 2 : ℝ)) =
          (Icc (-(L * |h|)) (L * |h|)).indicator
            (fun _ => ENNReal.ofReal ((c * |h|)⁻¹) ^ (3 / 2 : ℝ)) := by
        ext y
        by_cases hy : |y| ≤ L * |h|
        · have hy' : y ∈ Icc (-(L * |h|)) (L * |h|) := abs_le.1 hy
          simp [mimpK, hB', hy, hy']
        · have hy' : y ∉ Icc (-(L * |h|)) (L * |h|) := fun h' => hy (abs_le.2 h')
          simp [mimpK, hy, hy']
      rw [e, lintegral_indicator_const measurableSet_Icc, Real.volume_Icc,
        ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num),
        ← ENNReal.ofReal_mul (by positivity)]
      apply le_of_eq
      congr 1
      have hh : 0 < |h| := abs_pos.2 h0
      set a := |h| ^ (1 / 2 : ℝ) with ha
      have hapos : 0 < a := Real.rpow_pos_of_pos hh _
      have ha2 : |h| = a ^ 2 := by
        rw [ha, ← Real.rpow_natCast, ← Real.rpow_mul hh.le]; norm_num
      have ha3 : |h| ^ (3 / 2 : ℝ) = a ^ 3 := by
        rw [ha, ← Real.rpow_natCast, ← Real.rpow_mul hh.le]; norm_num
      have hcpos : 0 < c ^ (3 / 2 : ℝ) := Real.rpow_pos_of_pos hc _
      rw [Real.inv_rpow (by positivity), Real.mul_rpow hc.le hh.le, ha3, hK,
        Real.rpow_neg hc.le, Real.rpow_neg hh.le, ← ha]
      rw [ha2]
      field_simp
      ring
    · rw [indicator_of_notMem hB']
      apply le_of_eq
      rw [lintegral_eq_zero_iff (by
        exact ((mimp_measurable_K c L B).comp measurable_prodMk_left).pow_const _)]
      refine Filter.Eventually.of_forall fun y => ?_
      simp [mimpK, hB']
  rw [Measure.volume_eq_prod, lintegral_prod _
    (((mimp_measurable_K c L B).pow_const _).aemeasurable)]
  refine lt_of_le_of_lt (lintegral_mono slice) ?_
  rw [lintegral_indicator measurableSet_Ioc]
  exact ((mimp_intInt_abs_rpow hB).const_mul K).lintegral_lt_top

end

