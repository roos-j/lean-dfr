def msubE3 : (Fin 3 → ℝ) ≃ᵐ ℝ × ℝ × ℝ :=
  (MeasurableEquiv.piFinSuccAbove (fun _ => ℝ) 0).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ) MeasurableEquiv.finTwoArrow)

theorem msubE3_apply (x : Fin 3 → ℝ) : msubE3 x = (x 0, (x 1, x 2)) := rfl

theorem msubE3_mp : MeasurePreserving msubE3 volume volume :=
  (volume_preserving_piFinSuccAbove (fun _ => ℝ) 0).trans
    ((MeasurePreserving.id volume).prod (volume_preserving_finTwoArrow ℝ))

theorem msubE3_isometry : Isometry msubE3 := by
  refine Isometry.of_dist_eq fun x y => ?_
  rw [msubE3_apply, msubE3_apply]
  simp only [Prod.dist_eq]
  apply le_antisymm
  · exact max_le (dist_le_pi_dist x y 0) (max_le (dist_le_pi_dist x y 1) (dist_le_pi_dist x y 2))
  · refine (dist_pi_le_iff (le_max_of_le_left dist_nonneg)).mpr fun i => ?_
    fin_cases i
    · exact le_max_left _ _
    · exact (le_max_left _ _).trans (le_max_right _ _)
    · exact (le_max_right _ _).trans (le_max_right _ _)

theorem msub_vol_eq_hausdorff (s : Set (ℝ × ℝ × ℝ)) : volume s = μH[3] s := by
  rw [← msubE3_mp.measure_preimage_equiv s]
  have h := hausdorffMeasure_pi_real (ι := Fin 3)
  simp only [Fintype.card_fin, Nat.cast_ofNat] at h
  rw [← h, ← msubE3_isometry.hausdorffMeasure_image (Or.inl (by norm_num : (0:ℝ) ≤ 3)),
    image_preimage_eq s msubE3.surjective]

/-- Volume bound for a set on which a map is antilipschitz (substitute for change of variables). -/
theorem msub_vol_le_of_antilip {s : Set (ℝ × ℝ × ℝ)} {f : ℝ × ℝ × ℝ → ℝ × ℝ × ℝ} {m : ℝ}
    (hm : 0 < m) (hf : ∀ x ∈ s, ∀ y ∈ s, m * ‖x - y‖ ≤ ‖f x - f y‖) :
    volume s ≤ ENNReal.ofReal m⁻¹ ^ 3 * volume (f '' s) := by
  have hinj : InjOn f s := by
    intro x hx y hy hxy
    have := hf x hx y hy
    rw [hxy, sub_self, norm_zero] at this
    have : ‖x - y‖ ≤ 0 := by
      by_contra hc; push_neg at hc; nlinarith [mul_pos hm hc]
    exact sub_eq_zero.mp (norm_le_zero_iff.mp this)
  set g := Function.invFunOn f s
  have hg : ∀ x ∈ s, g (f x) = x := fun x hx => hinj.leftInvOn_invFunOn hx
  have hlip : LipschitzOnWith (Real.toNNReal m⁻¹) g (f '' s) := by
    refine LipschitzOnWith.of_dist_le_mul ?_
    rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
    rw [hg x hx, hg y hy, dist_eq_norm, dist_eq_norm, Real.coe_toNNReal _ (inv_nonneg.mpr hm.le)]
    rw [inv_mul_eq_div, le_div_iff₀ hm, mul_comm]
    exact hf x hx y hy
  have hsub : s ⊆ g '' (f '' s) := fun x hx => ⟨f x, ⟨x, hx, rfl⟩, hg x hx⟩
  rw [msub_vol_eq_hausdorff, msub_vol_eq_hausdorff]
  calc μH[3] s ≤ μH[3] (g '' (f '' s)) := measure_mono hsub
    _ ≤ (Real.toNNReal m⁻¹ : ℝ≥0∞) ^ (3:ℝ) * μH[3] (f '' s) :=
        hlip.hausdorffMeasure_image_le (by norm_num)
    _ = ENNReal.ofReal m⁻¹ ^ 3 * μH[3] (f '' s) := by
        rw [show (3:ℝ) = ((3:ℕ):ℝ) by norm_num, ENNReal.rpow_natCast]; rfl

end
end Auto

