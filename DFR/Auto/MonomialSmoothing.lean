theorem continuous_fourier_real {G : ℝ → ℂ} (hG : Integrable G volume) : Continuous (𝓕 G) :=
  VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar continuous_inner hG

theorem monoE_eq {F : ℝ → ℂ} (h1 : Integrable F volume) (h2 : MemLp F 2 volume) :
    monoE F = ∫⁻ x, ‖F x‖ₑ ^ 2 := lintegral_fourier_sq_eq h1 h2

theorem lintegral_enorm_sq_ne_top {F : ℝ → ℂ} (h2 : MemLp F 2 volume) : ∫⁻ x, ‖F x‖ₑ ^ 2 ≠ ⊤ := by
  rw [lintegral_enorm_sq_eq_ofReal h2]; exact ENNReal.ofReal_ne_top

theorem norm_monoSharp_le {R ρ : ℝ} (hR : 0 < R) {F : ℝ → ℂ} (hF : AEStronglyMeasurable F volume)
    {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) (x : ℝ) :
    ‖monoSharp R ρ F x‖ ≤ (monoSel R ρ F).card * ((∫ u, ‖monoKappa u‖) * M) := by
  unfold monoSharp
  refine (norm_sum_le _ _).trans ?_
  calc ∑ n ∈ monoSel R ρ F, ‖monoPiece R n F x‖
      ≤ ∑ n ∈ monoSel R ρ F, (∫ u, ‖monoKappa u‖) * M :=
        Finset.sum_le_sum fun n _ => norm_monoPiece_le hR n hF hM x
    _ = _ := by rw [Finset.sum_const, nsmul_eq_mul]

theorem norm_monoFlat_le {R ρ : ℝ} (hR : 0 < R) {F : ℝ → ℂ} (hF : AEStronglyMeasurable F volume)
    {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) (x : ℝ) :
    ‖monoFlat R ρ F x‖ ≤ M + (monoSel R ρ F).card * ((∫ u, ‖monoKappa u‖) * M) :=
  (norm_sub_le _ _).trans (add_le_add (hM x) (norm_monoSharp_le hR hF hM x))

/-- **(2.7)**, lines 293-307: for a Schwartz cutoff `χ` with `|χ| ≤ 1`,
`U_R(χ f_♭) ≤ ‖χ̂‖_1^2 ρ ‖f‖_2^4`. -/
theorem monoU_flat_local {R ρ : ℝ} (hR : 1 ≤ R) (hρ : 0 < ρ) (χ : 𝓢(ℝ, ℂ))
    (hχ : ∀ x, ‖χ x‖ ≤ 1) {F : ℝ → ℂ} (hF : Integrable F volume) {M : ℝ} (hM : ∀ x, ‖F x‖ ≤ M) :
    monoU R (fun x => χ x * monoFlat R ρ F x)
      ≤ ENNReal.ofReal ((∫ η, ‖𝓕 (⇑χ) η‖) ^ 2 * ρ) * (∫⁻ x, ‖F x‖ₑ ^ 2) ^ 2 := by
  have hR0 : 0 < R := by linarith
  have hF2 : MemLp F 2 volume := memLp_two_of_bdd hF hM
  have hE : monoE F ≠ ⊤ := by rw [monoE_eq hF hF2]; exact lintegral_enorm_sq_ne_top hF2
  set Fb := monoFlat R ρ F
  have hFb1 : Integrable Fb volume := integrable_monoFlat hR0 ρ hF
  have hFb2 : MemLp Fb 2 volume := memLp_two_of_bdd hFb1 (norm_monoFlat_le hR0 hF.1 hM)
  set G : ℝ → ℂ := fun x => χ x * Fb x
  have hGle : ∀ x, ‖G x‖ ≤ ‖Fb x‖ := fun x => by
    simp only [G, norm_mul]; exact mul_le_of_le_one_left (norm_nonneg _) (hχ x)
  have hG1 : Integrable G volume :=
    hFb1.norm.mono' (χ.continuous.aestronglyMeasurable.mul hFb1.1)
      (Eventually.of_forall fun x => hGle x)
  have hG2 : MemLp G 2 volume :=
    memLp_two_of_bdd hG1 fun x => (hGle x).trans (norm_monoFlat_le hR0 hF.1 hM x)
  set W : ℝ := ∫ η, ‖𝓕 (⇑χ) η‖
  have hχ1 : Integrable (𝓕 (⇑χ)) volume := by
    rw [← SchwartzMap.fourier_coe]; exact (𝓕 χ).integrable
  have hW : ∫⁻ η, ‖𝓕 (⇑χ) η‖ₑ = ENNReal.ofReal W := by
    rw [ofReal_integral_eq_lintegral_ofReal hχ1.norm (Eventually.of_forall fun _ => norm_nonneg _)]
    exact lintegral_congr fun η => (ofReal_norm _).symm
  -- the total mass
  have hmass : ∫⁻ x, ‖G x‖ₑ ^ 2 ≤ monoE F := by
    calc ∫⁻ x, ‖G x‖ₑ ^ 2 ≤ ∫⁻ x, ‖Fb x‖ₑ ^ 2 := lintegral_mono fun x => by
          gcongr; rw [← ofReal_norm, ← ofReal_norm]; exact ENNReal.ofReal_le_ofReal (hGle x)
      _ = ∫⁻ ξ, ‖𝓕 Fb ξ‖ₑ ^ 2 := (lintegral_fourier_sq_eq hFb1 hFb2).symm
      _ ≤ monoE F := lintegral_mono fun ξ => by
          gcongr; rw [← ofReal_norm, ← ofReal_norm]
          exact ENNReal.ofReal_le_ofReal (norm_fourier_monoFlat_le hR0 ρ hF ξ)
  -- the interval masses
  have hcF : Continuous (𝓕 Fb) := continuous_fourier_real hFb1
  have hwm : Measurable fun η => ‖𝓕 (⇑χ) η‖ₑ := (continuous_fourier_real χ.integrable).measurable.enorm
  have hint : ∀ a : ℝ, ∫⁻ ξ in Icc (a - R) (a + R), ‖𝓕 G ξ‖ₑ ^ 2
      ≤ ENNReal.ofReal (W ^ 2 * ρ) * monoE F := by
    intro a
    have hpt : ∀ ξ, ‖𝓕 G ξ‖ₑ ^ 2
        ≤ ENNReal.ofReal W * ∫⁻ η, ‖𝓕 (⇑χ) η‖ₑ * ‖𝓕 Fb (ξ - η)‖ₑ ^ 2 := by
      intro ξ
      have h1 : ‖𝓕 G ξ‖ₑ ≤ ∫⁻ η, ‖𝓕 (⇑χ) η‖ₑ * ‖𝓕 Fb (ξ - η)‖ₑ := by
        rw [show 𝓕 G ξ = _ from fourier_schwartz_mul χ hFb1 ξ]
        refine (enorm_integral_le_lintegral_enorm _).trans (le_of_eq ?_)
        exact lintegral_congr fun η => enorm_mul _ _
      calc ‖𝓕 G ξ‖ₑ ^ 2 ≤ (∫⁻ η, ‖𝓕 (⇑χ) η‖ₑ * ‖𝓕 Fb (ξ - η)‖ₑ) ^ 2 := by gcongr
        _ ≤ (∫⁻ η, ‖𝓕 (⇑χ) η‖ₑ) * ∫⁻ η, ‖𝓕 (⇑χ) η‖ₑ * ‖𝓕 Fb (ξ - η)‖ₑ ^ 2 :=
            lintegral_mul_sq_le hwm ((hcF.comp (continuous_const.sub continuous_id)).measurable.enorm)
        _ = _ := by rw [hW]
    have hshift : ∀ η, ∫⁻ ξ in Icc (a - R) (a + R), ‖𝓕 Fb (ξ - η)‖ₑ ^ 2
        ≤ ENNReal.ofReal ρ * monoE F := by
      intro η
      have h1 : ∫⁻ ξ in Icc (a - R) (a + R), ‖𝓕 Fb (ξ - η)‖ₑ ^ 2
          = ∫⁻ ζ in Icc (a - R - η) (a - R - η + 2 * R), ‖𝓕 Fb ζ‖ₑ ^ 2 := by
        rw [← lintegral_indicator measurableSet_Icc, ← lintegral_indicator measurableSet_Icc]
        rw [← lintegral_sub_right_eq_self (fun ζ => (Icc (a - R - η) (a - R - η + 2 * R)).indicator
          (fun ζ => ‖𝓕 Fb ζ‖ₑ ^ 2) ζ) η]
        refine lintegral_congr fun ξ => ?_
        simp only [indicator, mem_Icc]
        congr 1
        apply propext; constructor <;> intro h <;> constructor <;> linarith [h.1, h.2]
      rw [h1]
      exact monoFlat_interval hR0 hρ hF hE (a - R - η)
    have hjm : Measurable (Function.uncurry fun (ξ η : ℝ) => ‖𝓕 (⇑χ) η‖ₑ * ‖𝓕 Fb (ξ - η)‖ₑ ^ 2) :=
      (hwm.comp measurable_snd).mul
        ((hcF.comp (continuous_fst.sub continuous_snd)).measurable.enorm.pow_const 2)
    calc ∫⁻ ξ in Icc (a - R) (a + R), ‖𝓕 G ξ‖ₑ ^ 2
        ≤ ∫⁻ ξ in Icc (a - R) (a + R), ENNReal.ofReal W *
            ∫⁻ η, ‖𝓕 (⇑χ) η‖ₑ * ‖𝓕 Fb (ξ - η)‖ₑ ^ 2 := lintegral_mono fun ξ => hpt ξ
      _ = ENNReal.ofReal W * ∫⁻ η, ‖𝓕 (⇑χ) η‖ₑ *
            ∫⁻ ξ in Icc (a - R) (a + R), ‖𝓕 Fb (ξ - η)‖ₑ ^ 2 := by
          rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, lintegral_lintegral_swap
            hjm.aemeasurable]
          congr 1
          refine lintegral_congr fun η => ?_
          rw [lintegral_const_mul' _ _ enorm_ne_top]
      _ ≤ ENNReal.ofReal W * ∫⁻ η, ‖𝓕 (⇑χ) η‖ₑ * (ENNReal.ofReal ρ * monoE F) := by
          gcongr with η; exact hshift η
      _ = ENNReal.ofReal (W ^ 2 * ρ) * monoE F := by
          rw [lintegral_mul_const _ hwm, hW, ENNReal.ofReal_mul (by positivity), sq,
            ENNReal.ofReal_mul (integral_nonneg fun _ => norm_nonneg _)]
          ring
  have hU := monoU_le hG1 hG2 hint
  refine hU.trans ?_
  rw [← monoE_eq hF hF2]
  calc (∫⁻ x, ‖G x‖ₑ ^ 2) * (ENNReal.ofReal (W ^ 2 * ρ) * monoE F)
      ≤ monoE F * (ENNReal.ofReal (W ^ 2 * ρ) * monoE F) := by gcongr
    _ = _ := by ring

end

