/-! ### Coordinates on the plane: active coordinate `j`, passive coordinate `3 - j` -/

/-- The point with active coordinate `a` and passive coordinate `p` (coordinate `j` active). -/
def monoPt (j : Fin 2) (a p : ℝ) : ℝ × ℝ := if j = 0 then (a, p) else (p, a)

/-- The active coordinate of a point. -/
def monoAct (j : Fin 2) (z : ℝ × ℝ) : ℝ := if j = 0 then z.1 else z.2

/-- The passive coordinate of a point. -/
def monoPas (j : Fin 2) (z : ℝ × ℝ) : ℝ := if j = 0 then z.2 else z.1

/-- The unit vector `e_j` times `s`. -/
def monoEj (j : Fin 2) (s : ℝ) : ℝ × ℝ := monoPt j s 0

theorem monoPt_act_pas (j : Fin 2) (z : ℝ × ℝ) : monoPt j (monoAct j z) (monoPas j z) = z := by
  fin_cases j <;> simp [monoPt, monoAct, monoPas]

theorem monoAct_pt (j : Fin 2) (a p : ℝ) : monoAct j (monoPt j a p) = a := by
  fin_cases j <;> simp [monoPt, monoAct]

theorem monoPas_pt (j : Fin 2) (a p : ℝ) : monoPas j (monoPt j a p) = p := by
  fin_cases j <;> simp [monoPt, monoPas]

theorem monoPt_add_E (j : Fin 2) (a p s : ℝ) : monoPt j a p + monoEj j s = monoPt j (a + s) p := by
  fin_cases j <;> simp [monoPt, monoEj]

theorem monoPt_sub_E (j : Fin 2) (a p s : ℝ) : monoPt j a p - monoEj j s = monoPt j (a - s) p := by
  fin_cases j <;> simp [monoPt, monoEj]

theorem continuous_monoPt (j : Fin 2) : Continuous fun q : ℝ × ℝ => monoPt j q.1 q.2 := by
  fin_cases j
  · simp only [monoPt, Fin.zero_eta, if_true]
    exact continuous_fst.prodMk continuous_snd
  · simp only [monoPt, Fin.mk_one, one_ne_zero, if_false]
    exact continuous_snd.prodMk continuous_fst

theorem measurable_monoPt (j : Fin 2) : Measurable fun q : ℝ × ℝ => monoPt j q.1 q.2 :=
  (continuous_monoPt j).measurable

/-- Lebesgue measure in the (active, passive) coordinates: `∫ F = ∫∫ F(monoPt j a p) da dp`. -/
theorem lintegral_monoPt (j : Fin 2) {F : ℝ × ℝ → ℝ≥0∞} (hF : Measurable F) :
    ∫⁻ z, F z = ∫⁻ p, ∫⁻ a, F (monoPt j a p) := by
  fin_cases j
  · simp only [monoPt, Fin.zero_eta, if_true]
    rw [Measure.volume_eq_prod, lintegral_prod_symm _ hF.aemeasurable]
  · simp only [monoPt, Fin.mk_one, one_ne_zero, if_false]
    rw [Measure.volume_eq_prod, lintegral_prod _ hF.aemeasurable]

/-- The fiber of `f` through passive coordinate `p`. -/
def monoFib (j : Fin 2) (f : ℝ × ℝ → ℂ) (p : ℝ) (a : ℝ) : ℂ := f (monoPt j a p)

theorem measurable_monoFib {j : Fin 2} {f : ℝ × ℝ → ℂ} (hf : Measurable f) (p : ℝ) :
    Measurable (monoFib j f p) :=
  hf.comp ((measurable_monoPt j).comp (measurable_id.prodMk measurable_const))

/-- The convolution in coordinate `j`: `K(D_j) f (z) = ∫ K(s) f(z - s e_j) ds`. -/
def monoCConv (j : Fin 2) (K : ℝ → ℂ) (f : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℂ :=
  ∫ s, K s * f (z - monoEj j s)

/-- On each fiber the coordinate convolution is the one-dimensional convolution. -/
theorem monoCConv_fib (j : Fin 2) (K : ℝ → ℂ) (f : ℝ × ℝ → ℂ) (p a : ℝ) :
    monoFib j (monoCConv j K f) p a = (K ⋆[ContinuousLinearMap.mul ℂ ℂ] monoFib j f p) a := by
  rw [monoFib, monoCConv, convolution_def]
  refine integral_congr_ae (Eventually.of_forall fun s => ?_)
  simp only [ContinuousLinearMap.mul_apply', monoFib, monoPt_sub_E]

theorem measurable_monoCConv {j : Fin 2} {K : ℝ → ℂ} (hK : Measurable K) {f : ℝ × ℝ → ℂ}
    (hf : Measurable f) : Measurable (monoCConv j K f) := by
  have hs : Measurable fun q : (ℝ × ℝ) × ℝ => q.1 - monoEj j q.2 := by
    unfold monoEj
    exact measurable_fst.sub ((measurable_monoPt j).comp (measurable_snd.prodMk measurable_const))
  have h : StronglyMeasurable (Function.uncurry fun (z : ℝ × ℝ) (s : ℝ) => K s * f (z - monoEj j s)) :=
    ((hK.comp measurable_snd).mul (hf.comp hs)).stronglyMeasurable
  exact h.integral_prod_right'.measurable

/-- The sup bound (1.5), `p = ∞`: `|K(D_j) f| ≤ ‖K‖_1 ‖f‖_∞`. -/
theorem norm_monoCConv_le {j : Fin 2} {K : ℝ → ℂ} (hK : Integrable K volume) {f : ℝ × ℝ → ℂ}
    {M : ℝ} (hM : ∀ z, ‖f z‖ ≤ M) (z : ℝ × ℝ) :
    ‖monoCConv j K f z‖ ≤ (∫ s, ‖K s‖) * M := by
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM z)
  unfold monoCConv
  refine (norm_integral_le_integral_norm _).trans ?_
  rw [← integral_mul_const]
  refine integral_mono_of_nonneg (Eventually.of_forall fun s => norm_nonneg _)
    (hK.norm.mul_const M) (Eventually.of_forall fun s => ?_)
  simp only [norm_mul]
  exact mul_le_mul_of_nonneg_left (hM _) (norm_nonneg _)

end

end Auto

