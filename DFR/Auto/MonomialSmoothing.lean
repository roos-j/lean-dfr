/-! ### Lc06: a single compatible pair — setup and Cauchy-Schwarz in `(x,y)` -/

theorem mlc_integrable_of_bdd {α : Type*} [MeasurableSpace α] {μ : Measure α} {f : α → ℂ}
    {S : Set α} (hS : MeasurableSet S) (hSμ : μ S ≠ ⊤) (hf : AEStronglyMeasurable f μ) {M : ℝ}
    (hM : ∀ x, ‖f x‖ ≤ M) (hsupp : ∀ x, f x ≠ 0 → x ∈ S) : Integrable f μ := by
  have h1 : IntegrableOn f S μ :=
    Measure.integrableOn_of_bounded hSμ hf (Eventually.of_forall hM)
  have h2 : S.indicator f = f := by
    funext x
    by_cases hx : f x = 0
    · simp [hx]
    · exact indicator_of_mem (hsupp x hx) f
  rw [← h2]
  exact (integrable_indicator_iff hS).mpr h1

/-- Hypotheses on one compatible pair `(u₁, u₂) = (v_{1,m}, v_{2,n})`. -/
structure MlcPair (r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb : ℝ) (ψ : ℝ → ℝ) (u₁ u₂ : ℝ × ℝ → ℂ) :
    Prop where
  hr : 1 < r
  hA : 0 < A
  hAB : A < B
  hC0 : 1 ≤ C0
  hh : 0 < h
  hh1 : h ≤ 1
  hL : 0 ≤ L
  hψ : ContDiff ℝ ∞ ψ
  hsupp : tsupport ψ ⊆ Icc A B
  hC20 : monoC20 ψ ≤ 1
  hu₁ : MlcLoc u₁ B₁ a₁ b₁ (C0 * h)
  hu₂ : MlcLoc u₂ B₂ a₂ b₂ (C0 * h)
  lip₂ : ∀ z a, ‖u₂ (z + (0, a)) - u₂ z‖ ≤ B₂ * L * |a|
  htb : tb ∈ Icc A B
  htb0 : |tb - (a₁ - a₂)| ≤ 2 * C0 * h

/-- The integrand of `T_ψ(u₁,u₂)`. -/
def mlcF (r : ℝ) (ψ : ℝ → ℝ) (u₁ u₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) (t : ℝ) : ℂ :=
  (ψ t : ℂ) * (u₁ (z.1 + t, z.2) * u₂ (z.1, z.2 + monoQ r t))

theorem monoT_eq_mlcF (r : ℝ) (ψ : ℝ → ℝ) (u₁ u₂ : ℝ × ℝ → ℂ) (z : ℝ × ℝ) :
    monoT r ψ u₁ u₂ z = ∫ t, mlcF r ψ u₁ u₂ z t := rfl

namespace MlcPair

variable {r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb : ℝ} {ψ : ℝ → ℝ} {u₁ u₂ : ℝ × ℝ → ℂ}

theorem B₁_nonneg (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) : 0 ≤ B₁ :=
  (norm_nonneg _).trans (P.hu₁.2.1 0)

theorem B₂_nonneg (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) : 0 ≤ B₂ :=
  (norm_nonneg _).trans (P.hu₂.2.1 0)

theorem psi_le (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) (t : ℝ) : |ψ t| ≤ 1 := by
  simpa using mlc_psi_deriv_le P.hψ P.hsupp P.hC20 (k := 0) (by norm_num) t

theorem psi_mem (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) {t : ℝ} (ht : ψ t ≠ 0) :
    t ∈ Icc A B :=
  P.hsupp (subset_tsupport ψ ht)

theorem meas_F (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) :
    Measurable (fun p : (ℝ × ℝ) × ℝ => mlcF r ψ u₁ u₂ p.1 p.2) := by
  unfold mlcF
  have hQ : Continuous (monoQ r) := continuous_monoQ (by linarith [P.hr])
  refine Measurable.mul ?_ ((P.hu₁.1.comp measurable_monoShift1).mul
    (P.hu₂.1.comp (measurable_monoShift2 (by linarith [P.hr]))))
  exact Complex.measurable_ofReal.comp (P.hψ.continuous.measurable.comp measurable_snd)

theorem norm_F_le (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) (z : ℝ × ℝ) (t : ℝ) :
    ‖mlcF r ψ u₁ u₂ z t‖ ≤ B₁ * B₂ := by
  unfold mlcF
  rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs]
  have := P.psi_le t
  have h1 := P.hu₁.2.1 (z.1 + t, z.2)
  have h2 := P.hu₂.2.1 (z.1, z.2 + monoQ r t)
  calc |ψ t| * (‖u₁ (z.1 + t, z.2)‖ * ‖u₂ (z.1, z.2 + monoQ r t)‖) ≤ 1 * (B₁ * B₂) := by
        gcongr
        exact P.B₁_nonneg
    _ = _ := one_mul _

theorem F_ne_zero (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) {z : ℝ × ℝ} {t : ℝ}
    (hF : mlcF r ψ u₁ u₂ z t ≠ 0) :
    t ∈ Icc A B ∧ |z.1 - a₂| ≤ C0 * h ∧ |z.2 - b₁| ≤ C0 * h ∧ |z.1 + t - a₁| ≤ C0 * h := by
  unfold mlcF at hF
  simp only [ne_eq, mul_eq_zero, Complex.ofReal_eq_zero, not_or] at hF
  obtain ⟨hψ, h1, h2⟩ := hF
  have e1 := P.hu₁.2.2 _ h1
  have e2 := P.hu₂.2.2 _ h2
  exact ⟨P.psi_mem hψ, e2.1, e1.2, e1.1⟩

theorem integrable_F (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) (z : ℝ × ℝ) :
    Integrable (mlcF r ψ u₁ u₂ z) := by
  refine mlc_integrable_of_bdd measurableSet_Icc (measure_Icc_lt_top (a := A) (b := B)).ne
    ((P.meas_F.comp (measurable_const.prodMk measurable_id)).aestronglyMeasurable)
    (P.norm_F_le z) (fun t ht => (P.F_ne_zero ht).1)

theorem meas_T (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) :
    Measurable (monoT r ψ u₁ u₂) :=
  (P.meas_F.stronglyMeasurable.integral_prod_right' (ν := (volume : Measure ℝ))).measurable

theorem loc_T (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) :
    MlcLoc (monoT r ψ u₁ u₂) (B₁ * B₂ * (B - A)) a₂ b₁ (C0 * h) := by
  refine ⟨P.meas_T, fun z => ?_, fun z hz => ?_⟩
  · rw [monoT_eq_mlcF]
    have hb : ∀ t, ‖mlcF r ψ u₁ u₂ z t‖ ≤ (Icc A B).indicator (fun _ => B₁ * B₂) t := by
      intro t
      by_cases ht : mlcF r ψ u₁ u₂ z t = 0
      · rw [ht, norm_zero]
        exact indicator_nonneg (fun _ _ => mul_nonneg P.B₁_nonneg P.B₂_nonneg) t
      · rw [indicator_of_mem (P.F_ne_zero ht).1]
        exact P.norm_F_le z t
    refine (norm_integral_le_of_norm_le ((integrable_indicator_iff measurableSet_Icc).mpr
      (integrableOn_const (measure_Icc_lt_top (a := A) (b := B)).ne)) (Eventually.of_forall hb)).trans (le_of_eq ?_)
    rw [integral_indicator measurableSet_Icc, setIntegral_const, Real.volume_real_Icc_of_le P.hAB.le,
      smul_eq_mul]
    ring
  · rw [monoT_eq_mlcF] at hz
    obtain ⟨t, ht⟩ : ∃ t, mlcF r ψ u₁ u₂ z t ≠ 0 := by
      by_contra hne
      push_neg at hne
      apply hz
      simp [hne]
    obtain ⟨-, h1, h2, -⟩ := P.F_ne_zero ht
    exact ⟨h1, h2⟩

/-- Cauchy-Schwarz for a function supported in a set of finite measure. -/
theorem _root_.Auto.mlc_lintegral_le_sq {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {f : α → ℝ≥0∞} (hf : AEMeasurable f μ) {S : Set α} (hS : MeasurableSet S)
    (hsupp : ∀ x, f x ≠ 0 → x ∈ S) :
    ∫⁻ x, f x ∂μ ≤ (∫⁻ x, f x ^ 2 ∂μ) ^ (1 / 2 : ℝ) * μ S ^ (1 / 2 : ℝ) := by
  have e : f = f * S.indicator (fun _ => (1 : ℝ≥0∞)) := by
    funext x
    by_cases hx : f x = 0
    · simp [hx]
    · simp [indicator_of_mem (hsupp x hx)]
  have h := ENNReal.lintegral_mul_le_Lp_mul_Lq μ Real.HolderConjugate.two_two hf
    (aemeasurable_const (b := (1 : ℝ≥0∞)) |>.indicator hS)
  rw [← e] at h
  refine h.trans (le_of_eq ?_)
  congr 2
  · refine lintegral_congr fun x => ?_
    simp only [ENNReal.rpow_two]
  · have : (fun x => S.indicator (fun _ => (1 : ℝ≥0∞)) x ^ (2 : ℝ)) = S.indicator 1 := by
      funext x
      by_cases hx : x ∈ S
      · simp [indicator_of_mem hx]
      · simp [indicator_of_notMem hx]
    rw [this, lintegral_indicator_one hS]

theorem volume_mlcBox (a b R : ℝ) (hR : 0 ≤ R) :
    volume (mlcBox a b R) = ENNReal.ofReal (2 * R) * ENNReal.ofReal (2 * R) := by
  unfold mlcBox
  rw [Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Icc, Real.volume_Icc]
  congr 1 <;> ring_nf

/-- **Step 1**: Cauchy-Schwarz in `(x,y)`. -/
theorem step1 (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) :
    ∫⁻ z, ‖monoT r ψ u₁ u₂ z‖ₑ ≤
      ENNReal.ofReal (2 * (C0 * h)) * (∫⁻ z, ‖monoT r ψ u₁ u₂ z‖ₑ ^ 2) ^ (1 / 2 : ℝ) := by
  have hR : 0 ≤ C0 * h := by have := P.hh; have := P.hC0; positivity
  have h1 := mlc_lintegral_le_sq (μ := volume) (P.meas_T.enorm.aemeasurable)
    (mlcBox_measurable a₂ b₁ (C0 * h)) (fun z hz => mem_mlcBox (P.loc_T.2.2 z (by
      intro h0; apply hz; rw [h0, enorm_zero])))
  rw [volume_mlcBox _ _ _ hR, ← ENNReal.ofReal_mul (by positivity),
    ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num)] at h1
  rw [mul_comm]
  refine h1.trans (le_of_eq ?_)
  congr 2
  rw [← Real.sqrt_eq_rpow, Real.sqrt_mul_self (by positivity)]

end MlcPair

end

