open MeasureTheory Filter Topology Set
open scoped ENNReal

namespace Auto

noncomputable section

/-! ### Lc12: compatible pairs (5.6), reference parameters and their multiplicity -/

/-- A reference parameter exists: `h n = h m + Γ(t) + O(h)`. -/
def mlcTW (r A B C0 h : ℝ) (m n : ℤ × ℤ) : Prop :=
  ∃ t ∈ Icc A B, |t - (h * m.1 - h * n.1)| ≤ 2 * C0 * h ∧ |monoQ r t - (h * n.2 - h * m.2)| ≤ 2 * C0 * h

/-- Compatibility of `(m,n)`: the cubes meet `supp χ` and are joined by the curve. -/
def mlcCompat (r A B C0 h : ℝ) (χ : ℝ × ℝ → ℝ) (m n : ℤ × ℤ) : Prop :=
  (∃ z : ℝ × ℝ, χ z ≠ 0 ∧ |z.1 - h * n.1| ≤ C0 * h ∧ |z.2 - h * m.2| ≤ C0 * h) ∧ mlcTW r A B C0 h m n

open Classical in
/-- The reference parameter `t̄_{mn}`. -/
def mlcTb (r A B C0 h : ℝ) (m n : ℤ × ℤ) : ℝ := if H : mlcTW r A B C0 h m n then H.choose else A

theorem mlcTb_spec {r A B C0 h : ℝ} {m n : ℤ × ℤ} (H : mlcTW r A B C0 h m n) :
    mlcTb r A B C0 h m n ∈ Icc A B ∧
      |mlcTb r A B C0 h m n - (h * m.1 - h * n.1)| ≤ 2 * C0 * h ∧
      |monoQ r (mlcTb r A B C0 h m n) - (h * n.2 - h * m.2)| ≤ 2 * C0 * h := by
  unfold mlcTb
  rw [dif_pos H]
  exact H.choose_spec

open Classical in
/-- The compatible pairs. -/
def mlcP (r A B C0 h : ℝ) (χ : ℝ × ℝ → ℝ) (M₁ M₂ : Finset (ℤ × ℤ)) : Finset ((ℤ × ℤ) × (ℤ × ℤ)) :=
  (M₁ ×ˢ M₂).filter fun p => mlcCompat r A B C0 h χ p.1 p.2

open Classical in
/-- The partners of `m`. -/
def mlcNm (r A B C0 h : ℝ) (χ : ℝ × ℝ → ℝ) (M₂ : Finset (ℤ × ℤ)) (m : ℤ × ℤ) : Finset (ℤ × ℤ) :=
  M₂.filter fun n => mlcCompat r A B C0 h χ m n

open Classical in
/-- The partners of `n`. -/
def mlcMn (r A B C0 h : ℝ) (χ : ℝ × ℝ → ℝ) (M₁ : Finset (ℤ × ℤ)) (n : ℤ × ℤ) : Finset (ℤ × ℤ) :=
  M₁.filter fun m => mlcCompat r A B C0 h χ m n

theorem mlcP_sum_fst {r A B C0 h : ℝ} {χ : ℝ × ℝ → ℝ} {M₁ M₂ : Finset (ℤ × ℤ)} {β : Type*}
    [AddCommMonoid β] (f : (ℤ × ℤ) × (ℤ × ℤ) → β) :
    ∑ p ∈ mlcP r A B C0 h χ M₁ M₂, f p = ∑ m ∈ M₁, ∑ n ∈ mlcNm r A B C0 h χ M₂ m, f (m, n) := by
  classical
  unfold mlcP mlcNm
  rw [Finset.sum_filter, Finset.sum_product]
  refine Finset.sum_congr rfl fun m _ => ?_
  rw [Finset.sum_filter]

theorem mlcP_sum_snd {r A B C0 h : ℝ} {χ : ℝ × ℝ → ℝ} {M₁ M₂ : Finset (ℤ × ℤ)} {β : Type*}
    [AddCommMonoid β] (f : (ℤ × ℤ) × (ℤ × ℤ) → β) :
    ∑ p ∈ mlcP r A B C0 h χ M₁ M₂, f p = ∑ n ∈ M₂, ∑ m ∈ mlcMn r A B C0 h χ M₁ n, f (m, n) := by
  classical
  unfold mlcP mlcMn
  rw [Finset.sum_filter, Finset.sum_product_right]
  refine Finset.sum_congr rfl fun n _ => ?_
  rw [Finset.sum_filter]

theorem mem_mlcNm {r A B C0 h : ℝ} {χ : ℝ × ℝ → ℝ} {M₂ : Finset (ℤ × ℤ)} {m n : ℤ × ℤ} :
    n ∈ mlcNm r A B C0 h χ M₂ m ↔ n ∈ M₂ ∧ mlcCompat r A B C0 h χ m n := by
  classical
  unfold mlcNm; rw [Finset.mem_filter]

theorem mem_mlcMn {r A B C0 h : ℝ} {χ : ℝ × ℝ → ℝ} {M₁ : Finset (ℤ × ℤ)} {m n : ℤ × ℤ} :
    m ∈ mlcMn r A B C0 h χ M₁ n ↔ m ∈ M₁ ∧ mlcCompat r A B C0 h χ m n := by
  classical
  unfold mlcMn; rw [Finset.mem_filter]

theorem mem_mlcP {r A B C0 h : ℝ} {χ : ℝ × ℝ → ℝ} {M₁ M₂ : Finset (ℤ × ℤ)} {p : (ℤ × ℤ) × (ℤ × ℤ)} :
    p ∈ mlcP r A B C0 h χ M₁ M₂ ↔ (p.1 ∈ M₁ ∧ p.2 ∈ M₂) ∧ mlcCompat r A B C0 h χ p.1 p.2 := by
  classical
  unfold mlcP; rw [Finset.mem_filter, Finset.mem_product]

/-- `supp χ` is bounded. -/
theorem mlc_chi_bdd {χ : ℝ × ℝ → ℝ} (hχ : HasCompactSupport χ) :
    ∃ R : ℝ, 0 ≤ R ∧ ∀ z, χ z ≠ 0 → |z.1| ≤ R ∧ |z.2| ≤ R := by
  obtain ⟨R, hR⟩ := hχ.isCompact.isBounded.exists_norm_le
  refine ⟨max R 0, le_max_right _ _, fun z hz => ?_⟩
  have := hR z (subset_tsupport χ hz)
  constructor
  · exact ((Real.norm_eq_abs z.1).symm ▸ norm_fst_le z).trans (this.trans (le_max_left _ _))
  · exact ((Real.norm_eq_abs z.2).symm ▸ norm_snd_le z).trans (this.trans (le_max_left _ _))

theorem mlc_Q_nonneg {r t : ℝ} (ht : 0 ≤ t) : 0 ≤ monoQ r t := Real.rpow_nonneg ht r

theorem mlc_Q_le {r A B t : ℝ} (hr : 0 < r) (hA : 0 < A) (ht : t ∈ Icc A B) :
    monoQ r t ≤ monoQ r B :=
  Real.rpow_le_rpow (hA.le.trans ht.1) ht.2 hr.le

/-- The radius `R₀` of the region containing all relevant cubes. -/
def mlcR0 (r B C0 Rχ : ℝ) : ℝ := Rχ + 3 * C0 + B + monoQ r B

theorem mlc_compat_bdd {r A B C0 h Rχ : ℝ} {χ : ℝ × ℝ → ℝ} (hr : 1 < r) (hA : 0 < A)
    (hC0 : 1 ≤ C0) (hh : 0 < h) (hh1 : h ≤ 1) (hRχ : ∀ z, χ z ≠ 0 → |z.1| ≤ Rχ ∧ |z.2| ≤ Rχ)
    {m n : ℤ × ℤ} (H : mlcCompat r A B C0 h χ m n) :
    (|h * m.1| ≤ mlcR0 r B C0 Rχ ∧ |h * m.2| ≤ mlcR0 r B C0 Rχ) ∧
      (|h * n.1| ≤ mlcR0 r B C0 Rχ ∧ |h * n.2| ≤ mlcR0 r B C0 Rχ) := by
  obtain ⟨⟨z, hz, h1, h2⟩, ⟨t, ht, h3, h4⟩⟩ := H
  obtain ⟨hz1, hz2⟩ := hRχ z hz
  have hC0h : C0 * h ≤ C0 := by nlinarith
  have hQ0 := mlc_Q_nonneg (r := r) (hA.le.trans ht.1)
  have hQB := mlc_Q_le (r := r) (by linarith) hA ht
  have hQB0 : 0 ≤ monoQ r B := mlc_Q_nonneg (hA.le.trans (ht.1.trans ht.2))
  unfold mlcR0
  rw [abs_le] at hz1 hz2 h1 h2 h3 h4 ⊢
  rw [abs_le, abs_le, abs_le]
  refine ⟨⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩, ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩⟩ <;> nlinarith [ht.1, ht.2]

/-- The multiplicity bound `M₀`. -/
def mlcM0 (r B C0 : ℝ) : ℝ := (2 * (4 * C0 + 1 + monoq r B) + 1) ^ 2

theorem mlcM0_nonneg (r B C0 : ℝ) : 0 ≤ mlcM0 r B C0 := sq_nonneg _

theorem mlc_mult_fst {r A B C0 h : ℝ} {χ : ℝ × ℝ → ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B)
    (hC0 : 1 ≤ C0) (hh : 0 < h) (M₂ : Finset (ℤ × ℤ)) (m : ℤ × ℤ) (a : ℝ) :
    (((mlcNm r A B C0 h χ M₂ m).filter fun n => mlcTb r A B C0 h m n ∈ Icc a (a + h)).card : ℝ)
      ≤ mlcM0 r B C0 := by
  have hqB : 0 ≤ monoq r B := (mlc_q_pos (by linarith) (hA.trans hAB)).le
  refine mlc_card_le_diam _ hh (by positivity) fun n hn n' hn' => ?_
  rw [Finset.mem_filter, mem_mlcNm] at hn hn'
  obtain ⟨⟨-, -, H⟩, ha⟩ := hn
  obtain ⟨⟨-, -, H'⟩, ha'⟩ := hn'
  obtain ⟨t1, t2, t3⟩ := mlcTb_spec H
  obtain ⟨t1', t2', t3'⟩ := mlcTb_spec H'
  have hQ := mlc_Q_lip hr hA hAB t1 t1'
  have hdt : |mlcTb r A B C0 h m n' - mlcTb r A B C0 h m n| ≤ h := by
    rw [abs_le]; constructor <;> linarith [ha.1, ha.2, ha'.1, ha'.2]
  have hQ' : |monoQ r (mlcTb r A B C0 h m n') - monoQ r (mlcTb r A B C0 h m n)| ≤ monoq r B * h :=
    hQ.trans (mul_le_mul_of_nonneg_left hdt hqB)
  rw [abs_le] at t2 t3 t2' t3' hdt hQ'
  rw [abs_le, abs_le]
  refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩ <;> nlinarith

theorem mlc_mult_snd {r A B C0 h : ℝ} {χ : ℝ × ℝ → ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B)
    (hC0 : 1 ≤ C0) (hh : 0 < h) (M₁ : Finset (ℤ × ℤ)) (n : ℤ × ℤ) (a : ℝ) :
    (((mlcMn r A B C0 h χ M₁ n).filter fun m => mlcTb r A B C0 h m n ∈ Icc a (a + h)).card : ℝ)
      ≤ mlcM0 r B C0 := by
  have hqB : 0 ≤ monoq r B := (mlc_q_pos (by linarith) (hA.trans hAB)).le
  refine mlc_card_le_diam _ hh (by positivity) fun m hm m' hm' => ?_
  rw [Finset.mem_filter, mem_mlcMn] at hm hm'
  obtain ⟨⟨-, -, H⟩, ha⟩ := hm
  obtain ⟨⟨-, -, H'⟩, ha'⟩ := hm'
  obtain ⟨t1, t2, t3⟩ := mlcTb_spec H
  obtain ⟨t1', t2', t3'⟩ := mlcTb_spec H'
  have hQ := mlc_Q_lip hr hA hAB t1 t1'
  have hdt : |mlcTb r A B C0 h m' n - mlcTb r A B C0 h m n| ≤ h := by
    rw [abs_le]; constructor <;> linarith [ha.1, ha.2, ha'.1, ha'.2]
  have hQ' : |monoQ r (mlcTb r A B C0 h m' n) - monoQ r (mlcTb r A B C0 h m n)| ≤ monoq r B * h :=
    hQ.trans (mul_le_mul_of_nonneg_left hdt hqB)
  rw [abs_le] at t2 t3 t2' t3' hdt hQ'
  rw [abs_le, abs_le]
  refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩ <;> nlinarith

/-- The trivial partner count `O(h^{-1})`. -/
theorem mlc_card_Nm {r A B C0 h : ℝ} {χ : ℝ × ℝ → ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B)
    (hC0 : 1 ≤ C0) (hh : 0 < h) (hh1 : h ≤ 1) (M₂ : Finset (ℤ × ℤ)) (m : ℤ × ℤ) :
    ((mlcNm r A B C0 h χ M₂ m).card : ℝ) ≤ mlcM0 r B C0 * (B - A + 2) / h := by
  have := card_filter_Icc_le (mlcNm r A B C0 h χ M₂ m) (fun n => mlcTb r A B C0 h m n) hh
    (mlc_mult_fst hr hA hAB hC0 hh M₂ m) A (B - A) (by linarith)
  rw [show A + (B - A) = B by ring, Finset.filter_true_of_mem] at this
  · refine this.trans ?_
    rw [le_div_iff₀ hh]
    have := mlcM0_nonneg r B C0
    have : (B - A) / h * h = B - A := div_mul_cancel₀ _ hh.ne'
    nlinarith
  · intro n hn
    exact (mlcTb_spec (mem_mlcNm.mp hn).2.2).1

theorem mlc_card_Mn {r A B C0 h : ℝ} {χ : ℝ × ℝ → ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B)
    (hC0 : 1 ≤ C0) (hh : 0 < h) (hh1 : h ≤ 1) (M₁ : Finset (ℤ × ℤ)) (n : ℤ × ℤ) :
    ((mlcMn r A B C0 h χ M₁ n).card : ℝ) ≤ mlcM0 r B C0 * (B - A + 2) / h := by
  have := card_filter_Icc_le (mlcMn r A B C0 h χ M₁ n) (fun m => mlcTb r A B C0 h m n) hh
    (mlc_mult_snd hr hA hAB hC0 hh M₁ n) A (B - A) (by linarith)
  rw [show A + (B - A) = B by ring, Finset.filter_true_of_mem] at this
  · refine this.trans ?_
    rw [le_div_iff₀ hh]
    have := mlcM0_nonneg r B C0
    have : (B - A) / h * h = B - A := div_mul_cancel₀ _ hh.ne'
    nlinarith
  · intro m hm
    exact (mlcTb_spec (mem_mlcMn.mp hm).2.2).1

/-- The number of relevant indices `O(h^{-2})`. -/
theorem mlc_card_relevant {h R : ℝ} (hh : 0 < h) (hh1 : h ≤ 1) (hR : 0 ≤ R)
    (S : Finset (ℤ × ℤ)) (hS : ∀ m ∈ S, |h * m.1| ≤ R ∧ |h * m.2| ≤ R) :
    (S.card : ℝ) ≤ (2 * R + 1) ^ 2 / h ^ 2 := by
  refine (mlc_card_le_bounded S hh hR hS).trans ?_
  rw [le_div_iff₀ (by positivity)]
  have e : (2 * (R / h) + 1) * h = 2 * R + h := by field_simp
  calc (2 * (R / h) + 1) ^ 2 * h ^ 2 = (2 * R + h) ^ 2 := by rw [← e]; ring
    _ ≤ (2 * R + 1) ^ 2 := by gcongr

end

end Auto

end

section

open MeasureTheory Filter Topology Set
open scoped ENNReal

namespace Auto

noncomputable section

/-! ### Lc13: counting the possible slopes, (5.13)-(5.14) -/

/-- The real weight `w(h(ξ₁ - q ξ₂))`. -/
def mlcw (h q : ℝ) (ξ : ℝ × ℝ) : ℝ := (1 + |h * (ξ.1 - q * ξ.2)|) ^ (-8 : ℝ)

theorem mlcw_nonneg (h q : ℝ) (ξ : ℝ × ℝ) : 0 ≤ mlcw h q ξ := by
  unfold mlcw; positivity

theorem mlcw_le_one (h q : ℝ) (ξ : ℝ × ℝ) : mlcw h q ξ ≤ 1 := by
  unfold mlcw
  exact Real.rpow_le_one_of_one_le_of_nonpos (by linarith [abs_nonneg (h * (ξ.1 - q * ξ.2))])
    (by norm_num)

theorem mlcW_eq (h q : ℝ) (ξ : ℝ × ℝ) : mlcW h q ξ = ENNReal.ofReal (mlcw h q ξ) := rfl

theorem mlcw_le_inv {h q : ℝ} {ξ : ℝ × ℝ} {x : ℝ} (hx : 0 < x) (hle : x ≤ |h * (ξ.1 - q * ξ.2)|) :
    mlcw h q ξ ≤ 1 / x := by
  unfold mlcw
  set y := |h * (ξ.1 - q * ξ.2)|
  have h1 : (1 + y) ^ (-8 : ℝ) ≤ (1 + y) ^ (-1 : ℝ) :=
    Real.rpow_le_rpow_of_exponent_le (by linarith [abs_nonneg (h * (ξ.1 - q * ξ.2))]) (by norm_num)
  rw [Real.rpow_neg_one] at h1
  refine h1.trans ?_
  rw [one_div]
  exact inv_anti₀ hx (by linarith)

/-- The constant of the slope count. -/
def mlcCw (r A B C0 : ℝ) : ℝ :=
  2 ^ 12 * (1 + 1 / mlcCq r A B) * mlcM0 r B C0 * (1 + 2 * monoq r B) + 2 * mlcM0 r B C0 * (B - A + 2)

theorem mlc_slope {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) {ι : Type*} (T : Finset ι)
    (t : ι → ℝ) (htI : ∀ i ∈ T, t i ∈ Icc A B) {h M₀ : ℝ} (hh : 0 < h)
    (hmult : ∀ a, ((T.filter fun i => t i ∈ Icc a (a + h)).card : ℝ) ≤ M₀) {ξ : ℝ × ℝ}
    (hξ : ξ.2 ≠ 0) :
    ∑ i ∈ T, mlcw h (monoq r (t i)) ξ ≤
      2 ^ 12 * (1 + 1 / mlcCq r A B) * M₀ * (1 + 1 / (h * |h * ξ.2|)) := by
  have hc : 0 < mlcCq r A B := mlcCq_pos hr hA hAB
  have e : ∀ i, mlcw h (monoq r (t i)) ξ = (1 + |h * ξ.1 - monoq r (t i) * (h * ξ.2)|) ^ (-8 : ℝ) := by
    intro i; unfold mlcw; congr 3; ring
  simp_rw [e]
  exact slope_sum_le T t hc (mlc_q_expand hr hA) htI hh hmult (mul_ne_zero hh.ne' hξ)

theorem mlc_sum_w_le_card {ι : Type*} (T : Finset ι) (q : ι → ℝ) (h : ℝ) (ξ : ℝ × ℝ) :
    ∑ i ∈ T, mlcw h (q i) ξ ≤ T.card := by
  calc ∑ i ∈ T, mlcw h (q i) ξ ≤ ∑ i ∈ T, (1 : ℝ) := Finset.sum_le_sum fun i _ => mlcw_le_one _ _ _
    _ = T.card := by simp

theorem mlcCw_ge {r A B C0 : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) :
    mlcM0 r B C0 * (B - A + 2) ≤ mlcCw r A B C0 ∧
      2 ^ 12 * (1 + 1 / mlcCq r A B) * mlcM0 r B C0 * (1 + 2 * monoq r B) ≤ mlcCw r A B C0 := by
  have hM := mlcM0_nonneg r B C0
  have hc := mlcCq_pos hr hA hAB
  have hq := (mlc_q_pos (r := r) (by linarith) (hA.trans hAB)).le
  have h1 : 0 ≤ 2 ^ 12 * (1 + 1 / mlcCq r A B) * mlcM0 r B C0 * (1 + 2 * monoq r B) := by positivity
  have h2 : 0 ≤ mlcM0 r B C0 * (B - A + 2) := mul_nonneg hM (by linarith)
  unfold mlcCw
  constructor <;> nlinarith

/-- **(5.14)** for the first family (sum over the partners `n` of `m`). -/
theorem mlc_W1 {r A B C0 : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) {ι : Type*} (T : Finset ι)
    (t : ι → ℝ) (htI : ∀ i ∈ T, t i ∈ Icc A B) {h K : ℝ} (hh : 0 < h) (hK : 1 ≤ K)
    (hmult : ∀ a, ((T.filter fun i => t i ∈ Icc a (a + h)).card : ℝ) ≤ mlcM0 r B C0)
    (hcard : (T.card : ℝ) ≤ mlcM0 r B C0 * (B - A + 2) / h) (ξ : ℝ × ℝ) :
    ∑ i ∈ T, mlcw h (monoq r (t i)) ξ ≤
      {ξ : ℝ × ℝ | |ξ.1| ≤ K / h}.indicator (fun _ => mlcCw r A B C0 / h) ξ +
        mlcCw r A B C0 * (1 + 1 / (h * K)) := by
  obtain ⟨hC1, hC2⟩ := mlcCw_ge (C0 := C0) hr hA hAB
  have hM := mlcM0_nonneg r B C0
  have hCw0 : 0 ≤ mlcCw r A B C0 := (mul_nonneg hM (by linarith)).trans hC1
  have hK0 : 0 < K := by linarith
  have hpos : 0 ≤ mlcCw r A B C0 * (1 + 1 / (h * K)) := by positivity
  have hqB : 0 < monoq r B := mlc_q_pos (by linarith) (hA.trans hAB)
  by_cases hlow : |ξ.1| ≤ K / h
  · rw [indicator_of_mem (show ξ ∈ {ξ : ℝ × ℝ | |ξ.1| ≤ K / h} from hlow)]
    refine (mlc_sum_w_le_card T _ h ξ).trans (hcard.trans ?_)
    have : mlcM0 r B C0 * (B - A + 2) / h ≤ mlcCw r A B C0 / h := div_le_div_of_nonneg_right hC1 hh.le
    linarith
  · rw [indicator_of_notMem (show ξ ∉ {ξ : ℝ × ℝ | |ξ.1| ≤ K / h} from hlow), zero_add]
    push_neg at hlow
    have hξ1 : K < h * |ξ.1| := by rwa [div_lt_iff₀ hh, mul_comm] at hlow
    by_cases hsl : |ξ.1| / (2 * monoq r B) ≤ |ξ.2|
    · -- steep: the slope count
      have hξ2 : ξ.2 ≠ 0 := by
        intro h0; rw [h0, abs_zero] at hsl
        have : 0 < |ξ.1| / (2 * monoq r B) := div_pos (by
          have : 0 < h * |ξ.1| := by linarith
          exact pos_of_mul_pos_right this hh.le) (by positivity)
        linarith
      refine (mlc_slope hr hA hAB T t htI hh hmult hξ2).trans ?_
      have h2 : K / (2 * monoq r B) ≤ |h * ξ.2| := by
        rw [abs_mul, abs_of_pos hh, div_le_iff₀ (by positivity)]
        have : |ξ.1| ≤ |ξ.2| * (2 * monoq r B) := by rwa [div_le_iff₀ (by positivity)] at hsl
        nlinarith [mul_le_mul_of_nonneg_left this hh.le]
      have hKq : 0 < K / (2 * monoq r B) := by positivity
      have h3 : 1 / (h * |h * ξ.2|) ≤ 2 * monoq r B / (h * K) := by
        rw [div_le_div_iff₀ (mul_pos hh (lt_of_lt_of_le hKq h2)) (by positivity)]
        rw [div_le_iff₀ (by positivity)] at h2
        nlinarith [mul_le_mul_of_nonneg_left h2 hh.le]
      have h4 : 1 + 1 / (h * |h * ξ.2|) ≤ (1 + 2 * monoq r B) * (1 + 1 / (h * K)) := by
        have : 2 * monoq r B / (h * K) = 2 * monoq r B * (1 / (h * K)) := by ring
        have : 0 ≤ 1 / (h * K) := by positivity
        nlinarith
      have hc := mlcCq_pos hr hA hAB
      have h8 : 0 ≤ 2 ^ 12 * (1 + 1 / mlcCq r A B) * mlcM0 r B C0 := by positivity
      calc 2 ^ 12 * (1 + 1 / mlcCq r A B) * mlcM0 r B C0 * (1 + 1 / (h * |h * ξ.2|))
          ≤ 2 ^ 12 * (1 + 1 / mlcCq r A B) * mlcM0 r B C0 * ((1 + 2 * monoq r B) * (1 + 1 / (h * K))) :=
            mul_le_mul_of_nonneg_left h4 h8
        _ = 2 ^ 12 * (1 + 1 / mlcCq r A B) * mlcM0 r B C0 * (1 + 2 * monoq r B) * (1 + 1 / (h * K)) := by
            ring
        _ ≤ _ := by gcongr
    · -- flat: every weight is small
      push_neg at hsl
      have hw : ∀ i ∈ T, mlcw h (monoq r (t i)) ξ ≤ 2 / K := by
        intro i hi
        have hq0 : 0 < monoq r (t i) := mlc_q_pos (by linarith) (hA.trans_le (htI i hi).1)
        have hqle : monoq r (t i) ≤ monoq r B :=
          mlc_q_mono hr hA hAB (htI i hi) ⟨hAB.le, le_rfl⟩ (htI i hi).2
        have hb : K / 2 ≤ |h * (ξ.1 - monoq r (t i) * ξ.2)| := by
          rw [abs_mul, abs_of_pos hh]
          have h5 : |monoq r (t i) * ξ.2| ≤ |ξ.1| / 2 := by
            rw [abs_mul, abs_of_pos hq0]
            rw [lt_div_iff₀ (by positivity)] at hsl
            have : monoq r (t i) * |ξ.2| ≤ monoq r B * |ξ.2| :=
              mul_le_mul_of_nonneg_right hqle (abs_nonneg _)
            nlinarith [abs_nonneg ξ.2]
          have h6 : |ξ.1| / 2 ≤ |ξ.1 - monoq r (t i) * ξ.2| := by
            have := abs_sub_abs_le_abs_sub ξ.1 (monoq r (t i) * ξ.2)
            linarith
          nlinarith
        refine (mlcw_le_inv (by positivity) hb).trans (le_of_eq ?_)
        field_simp
      calc ∑ i ∈ T, mlcw h (monoq r (t i)) ξ ≤ ∑ i ∈ T, 2 / K := Finset.sum_le_sum hw
        _ = T.card * (2 / K) := by rw [Finset.sum_const, nsmul_eq_mul]
        _ ≤ mlcM0 r B C0 * (B - A + 2) / h * (2 / K) := by gcongr
        _ = 2 * (mlcM0 r B C0 * (B - A + 2)) * (1 / (h * K)) := by field_simp
        _ ≤ mlcCw r A B C0 * (1 + 1 / (h * K)) := by
            have : 0 ≤ 1 / (h * K) := by positivity
            unfold mlcCw
            have h7 : 0 ≤ 2 ^ 12 * (1 + 1 / mlcCq r A B) * mlcM0 r B C0 * (1 + 2 * monoq r B) := by
              have := mlcCq_pos hr hA hAB
              positivity
            nlinarith [mul_nonneg h7 this, mul_nonneg (mul_nonneg hM (by linarith : (0:ℝ) ≤ B - A + 2)) this]

/-- **(5.14)** for the second family (sum over the partners `m` of `n`). -/
theorem mlc_W2 {r A B C0 : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) {ι : Type*} (T : Finset ι)
    (t : ι → ℝ) (htI : ∀ i ∈ T, t i ∈ Icc A B) {h K : ℝ} (hh : 0 < h) (hK : 1 ≤ K)
    (hmult : ∀ a, ((T.filter fun i => t i ∈ Icc a (a + h)).card : ℝ) ≤ mlcM0 r B C0)
    (hcard : (T.card : ℝ) ≤ mlcM0 r B C0 * (B - A + 2) / h) (ξ : ℝ × ℝ) :
    ∑ i ∈ T, mlcw h (monoq r (t i)) ξ ≤
      {ξ : ℝ × ℝ | |ξ.2| ≤ K / h}.indicator (fun _ => mlcCw r A B C0 / h) ξ +
        mlcCw r A B C0 * (1 + 1 / (h * K)) := by
  obtain ⟨hC1, hC2⟩ := mlcCw_ge (C0 := C0) hr hA hAB
  have hM := mlcM0_nonneg r B C0
  have hK0 : 0 < K := by linarith
  have hCw0 : 0 ≤ mlcCw r A B C0 := (mul_nonneg hM (by linarith)).trans hC1
  have hpos : 0 ≤ mlcCw r A B C0 * (1 + 1 / (h * K)) := by positivity
  by_cases hlow : |ξ.2| ≤ K / h
  · rw [indicator_of_mem (show ξ ∈ {ξ : ℝ × ℝ | |ξ.2| ≤ K / h} from hlow)]
    refine (mlc_sum_w_le_card T _ h ξ).trans (hcard.trans ?_)
    have : mlcM0 r B C0 * (B - A + 2) / h ≤ mlcCw r A B C0 / h := div_le_div_of_nonneg_right hC1 hh.le
    linarith
  · rw [indicator_of_notMem (show ξ ∉ {ξ : ℝ × ℝ | |ξ.2| ≤ K / h} from hlow), zero_add]
    push_neg at hlow
    have hξ2b : K < h * |ξ.2| := by rwa [div_lt_iff₀ hh, mul_comm] at hlow
    have hξ2 : ξ.2 ≠ 0 := by
      intro h0; rw [h0, abs_zero, mul_zero] at hξ2b; linarith
    refine (mlc_slope hr hA hAB T t htI hh hmult hξ2).trans ?_
    have h3 : 1 / (h * |h * ξ.2|) ≤ 1 / (h * K) := by
      rw [abs_mul, abs_of_pos hh]
      exact one_div_le_one_div_of_le (by positivity) (by nlinarith)
    have hqB : 0 ≤ monoq r B := (mlc_q_pos (by linarith) (hA.trans hAB)).le
    have hc := mlcCq_pos hr hA hAB
    have h8 : 0 ≤ 2 ^ 12 * (1 + 1 / mlcCq r A B) * mlcM0 r B C0 := by positivity
    have h0 : 0 ≤ 1 / (h * K) := by positivity
    have h9 : 1 + 1 / (h * |h * ξ.2|) ≤ (1 + 2 * monoq r B) * (1 + 1 / (h * K)) := by nlinarith
    calc 2 ^ 12 * (1 + 1 / mlcCq r A B) * mlcM0 r B C0 * (1 + 1 / (h * |h * ξ.2|))
        ≤ 2 ^ 12 * (1 + 1 / mlcCq r A B) * mlcM0 r B C0 *
            ((1 + 2 * monoq r B) * (1 + 1 / (h * K))) := mul_le_mul_of_nonneg_left h9 h8
      _ = 2 ^ 12 * (1 + 1 / mlcCq r A B) * mlcM0 r B C0 * (1 + 2 * monoq r B) * (1 + 1 / (h * K)) := by
          ring
      _ ≤ _ := by gcongr

end

end Auto

