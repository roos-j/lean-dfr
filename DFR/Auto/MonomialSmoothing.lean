/-! ### Almost-everywhere linearity of `monoP` and bilinearity of `monoT` -/

/-- A Schwartz kernel at scale `L` is square integrable. -/
theorem ms7_K_sq_lt_top (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L) :
    ∫⁻ s, ‖(L : ℂ) * κ (L * s)‖ₑ ^ (2 : ℝ) < ⊤ := by
  obtain ⟨C, hC, hdec⟩ := mono_schwartz_decay_two κ
  have hb : ∀ s, ‖(L : ℂ) * κ (L * s)‖ₑ ≤ ENNReal.ofReal (L * C) := by
    intro s
    rw [ms7_enorm_K κ hL, ENNReal.ofReal_mul hL.le]
    gcongr
    rw [← ofReal_norm]
    refine ENNReal.ofReal_le_ofReal ((hdec _).trans ?_)
    exact div_le_self hC (one_le_pow₀ (by linarith [abs_nonneg (L * s)]))
  calc ∫⁻ s, ‖(L : ℂ) * κ (L * s)‖ₑ ^ (2 : ℝ)
      ≤ ∫⁻ s, ENNReal.ofReal (L * C) * ‖(L : ℂ) * κ (L * s)‖ₑ := by
        refine lintegral_mono fun s => ?_
        rw [ENNReal.rpow_two, sq]
        gcongr; exact hb s
    _ = ENNReal.ofReal (L * C) * ∫⁻ s, ‖κ s‖ₑ := by
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, ms7_kerL1 κ hL]
    _ < ⊤ := ENNReal.mul_lt_top ENNReal.ofReal_lt_top (ms7_kerL1_lt_top κ)

/-- For almost every passive coordinate the fiber of an `L^2` function is square integrable. -/
theorem ms7_fiber_sq (j : Fin 2) {u : ℝ × ℝ → ℂ} (hu : Measurable u)
    (hu2 : eLpNorm u 2 volume ≠ ⊤) :
    ∀ᵐ p, ∫⁻ a, ‖u (monoPt j a p)‖ₑ ^ (2 : ℝ) < ⊤ := by
  have hF : Measurable fun z => ‖u z‖ₑ ^ (2 : ℝ) := hu.enorm.pow_const _
  have hfin : ∫⁻ z, ‖u z‖ₑ ^ (2 : ℝ) ≠ ⊤ := by
    intro h
    rw [eLpNorm_two_eq_lintegral, h, ENNReal.top_rpow_of_pos (by norm_num)] at hu2
    exact hu2 rfl
  rw [lintegral_monoPt j hF] at hfin
  have hm : Measurable fun q : ℝ × ℝ => ‖u (monoPt j q.2 q.1)‖ₑ ^ (2 : ℝ) :=
    hF.comp ((measurable_monoPt j).comp (measurable_snd.prodMk measurable_fst))
  exact ae_lt_top hm.lintegral_prod_right' hfin

/-- **A.e. linearity of `monoP`** under the splitting `u = 1_S u + 1_{S^c} u`: it holds on every
fiber on which `u` is square integrable. -/
theorem ms7_P_split (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) {L : ℝ} (hL : 0 < L) {u : ℝ × ℝ → ℂ}
    (hu : Measurable u) (hu2 : eLpNorm u 2 volume ≠ ⊤) {S : Set (ℝ × ℝ)} (hS : MeasurableSet S) :
    ∀ᵐ p, ∀ a, monoP j κ L u (monoPt j a p) =
      monoP j κ L (S.indicator u) (monoPt j a p) + monoP j κ L (Sᶜ.indicator u) (monoPt j a p) := by
  filter_upwards [ms7_fiber_sq j hu hu2] with p hp a
  set K : ℝ → ℂ := fun s => (L : ℂ) * κ (L * s)
  have hKm : Measurable K := ms7_measK κ L
  have hv : Measurable fun s => u (monoPt j a p - monoEj j s) :=
    hu.comp (measurable_const.sub ((measurable_monoPt j).comp (measurable_id.prodMk measurable_const)))
  have hint : Integrable (fun s => K s * u (monoPt j a p - monoEj j s)) volume := by
    refine ⟨(hKm.mul hv).aestronglyMeasurable, ?_⟩
    unfold HasFiniteIntegral
    simp only [enorm_mul]
    have hcs := ENNReal.lintegral_mul_le_Lp_mul_Lq volume Real.HolderConjugate.two_two
      hKm.enorm.aemeasurable hv.enorm.aemeasurable
    refine lt_of_le_of_lt hcs (ENNReal.mul_lt_top ?_ ?_)
    · exact ENNReal.rpow_lt_top_of_nonneg (by norm_num) (ms7_K_sq_lt_top κ hL).ne
    · refine ENNReal.rpow_lt_top_of_nonneg (by norm_num) (ne_of_lt ?_)
      have e : ∀ s, u (monoPt j a p - monoEj j s) = u (monoPt j (a - s) p) := fun s => by
        rw [monoPt_sub_E]
      simp only [e]
      rw [lintegral_sub_left_eq_self (fun b => ‖u (monoPt j b p)‖ₑ ^ (2 : ℝ)) a]
      exact hp
  have hsh : Measurable fun s => monoPt j a p - monoEj j s :=
    measurable_const.sub ((measurable_monoPt j).comp (measurable_id.prodMk measurable_const))
  have hint1 : Integrable (fun s => K s * S.indicator u (monoPt j a p - monoEj j s)) volume := by
    refine hint.mono (hKm.mul ((hu.indicator hS).comp hsh)).aestronglyMeasurable
      (Eventually.of_forall fun s => ?_)
    simp only [norm_mul]
    gcongr
    exact norm_indicator_le_norm_self _ _
  have hint2 : Integrable (fun s => K s * Sᶜ.indicator u (monoPt j a p - monoEj j s)) volume := by
    refine hint.mono (hKm.mul ((hu.indicator hS.compl).comp hsh)).aestronglyMeasurable
      (Eventually.of_forall fun s => ?_)
    simp only [norm_mul]
    gcongr
    exact norm_indicator_le_norm_self _ _
  unfold monoP monoCConv
  rw [← integral_add hint1 hint2]
  congr 1; funext s
  rw [← mul_add, indicator_self_add_compl_apply]

end

end Auto

end

