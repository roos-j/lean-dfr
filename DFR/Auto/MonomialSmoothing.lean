/-- The closed spatial cube of side `2 C0 h` centred at `h m`. -/
def mssBox (h C0 : ℝ) (m : ℤ × ℤ) : Set (ℝ × ℝ) :=
  {w | |w.1 - h * m.1| ≤ C0 * h ∧ |w.2 - h * m.2| ≤ C0 * h}

theorem mss_isClosed_box (h C0 : ℝ) (m : ℤ × ℤ) : IsClosed (mssBox h C0 m) := by
  unfold mssBox
  exact (isClosed_le ((continuous_fst.sub continuous_const).abs) continuous_const).inter
    (isClosed_le ((continuous_snd.sub continuous_const).abs) continuous_const)

theorem mss_measurableSet_box (h C0 : ℝ) (m : ℤ × ℤ) : MeasurableSet (mssBox h C0 m) :=
  (mss_isClosed_box h C0 m).measurableSet

theorem mss_toNat_le {a b : ℤ} {x C0 : ℝ} (hC0 : 0 ≤ C0) (ha : x - C0 ≤ a) (hb : (b : ℝ) ≤ x + C0) :
    ((b + 1 - a).toNat : ℝ) ≤ 2 * C0 + 1 := by
  have h1 : (((b + 1 - a).toNat : ℤ) : ℝ) = max ((b + 1 - a : ℤ) : ℝ) 0 := by
    rw [Int.toNat_eq_max]; push_cast; rfl
  have h2 : ((b + 1 - a).toNat : ℝ) = (((b + 1 - a).toNat : ℤ) : ℝ) := by norm_cast
  rw [h2, h1]
  apply max_le
  · push_cast; linarith
  · linarith

theorem mss_card_box {h C0 : ℝ} (hh : 0 < h) (hC0 : 0 ≤ C0) (M : Finset (ℤ × ℤ)) (w : ℝ × ℝ) :
    ((M.filter fun m => w ∈ mssBox h C0 m).card : ℝ) ≤ (2 * C0 + 1) ^ 2 := by
  have hsub : (M.filter fun m => w ∈ mssBox h C0 m) ⊆
      (Finset.Icc ⌈w.1 / h - C0⌉ ⌊w.1 / h + C0⌋) ×ˢ (Finset.Icc ⌈w.2 / h - C0⌉ ⌊w.2 / h + C0⌋) := by
    intro m hm
    rw [Finset.mem_filter] at hm
    simp only [mssBox, mem_setOf_eq] at hm
    obtain ⟨-, h1, h2⟩ := hm
    rw [abs_le] at h1 h2
    simp only [Finset.mem_product, Finset.mem_Icc]
    have k1 : w.1 / h - C0 ≤ m.1 := by
      rw [sub_le_iff_le_add, div_le_iff₀ hh]; nlinarith
    have k2 : (m.1 : ℝ) ≤ w.1 / h + C0 := by
      rw [← sub_le_iff_le_add, le_div_iff₀ hh]; nlinarith
    have k3 : w.2 / h - C0 ≤ m.2 := by
      rw [sub_le_iff_le_add, div_le_iff₀ hh]; nlinarith
    have k4 : (m.2 : ℝ) ≤ w.2 / h + C0 := by
      rw [← sub_le_iff_le_add, le_div_iff₀ hh]; nlinarith
    exact ⟨⟨Int.ceil_le.2 k1, Int.le_floor.2 k2⟩, ⟨Int.ceil_le.2 k3, Int.le_floor.2 k4⟩⟩
  have hc := Finset.card_le_card hsub
  rw [Finset.card_product, Int.card_Icc, Int.card_Icc] at hc
  have hc' : ((M.filter fun m => w ∈ mssBox h C0 m).card : ℝ) ≤
      ((⌊w.1 / h + C0⌋ + 1 - ⌈w.1 / h - C0⌉).toNat : ℝ) *
        ((⌊w.2 / h + C0⌋ + 1 - ⌈w.2 / h - C0⌉).toNat : ℝ) := by exact_mod_cast hc
  refine hc'.trans ?_
  rw [sq]
  exact mul_le_mul (mss_toNat_le hC0 (Int.le_ceil _) (Int.floor_le _))
    (mss_toNat_le hC0 (Int.le_ceil _) (Int.floor_le _)) (by positivity) (by linarith)

theorem mss_box_disjoint {h C0 : ℝ} (hh : 0 < h) {K : ℕ} (hK : 2 * C0 < K) {m m' : ℤ × ℤ}
    (h1 : m.1 % K = m'.1 % K) (h2 : m.2 % K = m'.2 % K) (hne : m ≠ m') :
    Disjoint (mssBox h C0 m) (mssBox h C0 m') := by
  rw [Set.disjoint_left]
  intro w hw hw'
  simp only [mssBox, mem_setOf_eq] at hw hw'
  apply hne
  have key : ∀ (x : ℝ) (a b : ℤ), a % K = b % K → |x - h * (a : ℝ)| ≤ C0 * h →
      |x - h * (b : ℝ)| ≤ C0 * h → a = b := by
    intro x a b hab ha hb
    have hd : (K : ℤ) ∣ a - b := Int.ModEq.dvd (show b ≡ a [ZMOD K] from hab.symm)
    have habs : |((a - b : ℤ) : ℝ)| ≤ 2 * C0 := by
      have : |h * ((a - b : ℤ) : ℝ)| ≤ 2 * C0 * h := by
        push_cast
        calc |h * ((a : ℝ) - b)| = |(x - h * (b : ℝ)) - (x - h * (a : ℝ))| := by ring_nf
          _ ≤ |x - h * (b : ℝ)| + |x - h * (a : ℝ)| := abs_sub _ _
          _ ≤ 2 * C0 * h := by linarith
      rw [abs_mul, abs_of_pos hh] at this
      nlinarith
    have hlt : |a - b| < (K : ℤ) := by
      have : (|a - b| : ℝ) < K := by
        have := habs; push_cast at this ⊢; linarith
      exact_mod_cast this
    exact sub_eq_zero.1 (Int.eq_zero_of_abs_lt_dvd hd hlt)
  exact Prod.ext (key _ _ _ h1 hw.1 hw'.1) (key _ _ _ h2 hw.2 hw'.2)

theorem mss_psi_zero_of_not_mem {ψ : ℝ → ℝ} {A B : ℝ} (hs : tsupport ψ ⊆ Icc A B) {t : ℝ}
    (ht : t ∉ Icc A B) : ψ t = 0 :=
  image_eq_zero_of_notMem_tsupport fun h => ht (hs h)

theorem mss_psi_endpoints {ψ : ℝ → ℝ} (hc : Continuous ψ) {A B : ℝ} (hs : tsupport ψ ⊆ Icc A B) :
    ψ A = 0 ∧ ψ B = 0 := by
  have hopen : IsOpen (Function.support ψ) := isOpen_ne_fun hc continuous_const
  constructor
  · by_contra hne
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hopen A hne
    have hmem : A - ε / 2 ∈ Metric.ball A ε := by
      rw [Metric.mem_ball, Real.dist_eq]; rw [abs_of_neg (by linarith)]; linarith
    have := hs (subset_tsupport _ (hball hmem))
    linarith [this.1]
  · by_contra hne
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hopen B hne
    have hmem : B + ε / 2 ∈ Metric.ball B ε := by
      rw [Metric.mem_ball, Real.dist_eq]; rw [abs_of_pos (by linarith)]; linarith
    have := hs (subset_tsupport _ (hball hmem))
    linarith [this.2]

theorem mss_psi_zero_of_not_mem_Ioo {ψ : ℝ → ℝ} (hc : Continuous ψ) {A B : ℝ}
    (hs : tsupport ψ ⊆ Icc A B) {t : ℝ} (ht : t ∉ Ioo A B) : ψ t = 0 := by
  by_cases h : t ∈ Icc A B
  · have : t = A ∨ t = B := by
      by_contra hne; push_neg at hne
      exact ht ⟨lt_of_le_of_ne h.1 (Ne.symm hne.1), lt_of_le_of_ne h.2 hne.2⟩
    rcases this with rfl | rfl
    · exact (mss_psi_endpoints hc hs).1
    · exact (mss_psi_endpoints hc hs).2
  · exact mss_psi_zero_of_not_mem hs h

theorem mss_iterDeriv_le_C20 {ψ : ℝ → ℝ} {k : ℕ} (hk : k < 21) (hbdd : BddAbove (Set.range fun t => |iteratedDeriv k ψ t|))
    (t : ℝ) : |iteratedDeriv k ψ t| ≤ monoC20 ψ := by
  unfold monoC20
  refine (le_ciSup hbdd t).trans ?_
  exact Finset.single_le_sum (f := fun k => ⨆ t, |iteratedDeriv k ψ t|)
    (fun i _ => Real.iSup_nonneg fun _ => abs_nonneg _) (Finset.mem_range.2 hk)

theorem mss_psi_bounds {ψ : ℝ → ℝ} (hψ : ContDiff ℝ ∞ ψ) {A B : ℝ} (hs : tsupport ψ ⊆ Icc A B)
    (h20 : monoC20 ψ ≤ 1) : (∀ t, |ψ t| ≤ 1) ∧ ∀ t, |deriv ψ t| ≤ 1 := by
  have hcs : HasCompactSupport ψ := isCompact_Icc.of_isClosed_subset (isClosed_tsupport _) hs
  have hc0 : Continuous ψ := hψ.continuous
  have hc1 : Continuous (deriv ψ) := hψ.continuous_deriv (by simp)
  constructor
  · intro t
    have hb : BddAbove (Set.range fun t => |iteratedDeriv 0 ψ t|) := by
      simp only [iteratedDeriv_zero]
      simpa [Real.norm_eq_abs] using hc0.norm.bddAbove_range_of_hasCompactSupport hcs.norm
    have := mss_iterDeriv_le_C20 (by norm_num) hb t
    simp only [iteratedDeriv_zero] at this
    linarith
  · intro t
    have hb : BddAbove (Set.range fun t => |iteratedDeriv 1 ψ t|) := by
      simp only [iteratedDeriv_one]
      simpa [Real.norm_eq_abs] using hc1.norm.bddAbove_range_of_hasCompactSupport hcs.deriv.norm
    have := mss_iterDeriv_le_C20 (by norm_num) hb t
    simp only [iteratedDeriv_one] at this
    linarith

theorem mss_deriv_eq_zero_x {f : ℝ × ℝ → ℂ} {h C0 : ℝ} {m : ℤ × ℤ}
    (hf : ∀ w, f w ≠ 0 → w ∈ mssBox h C0 m) {x y : ℝ} {d : ℂ}
    (hd : HasDerivAt (fun x => f (x, y)) d x) (hx : (x, y) ∉ mssBox h C0 m) : d = 0 := by
  have hopen : IsOpen ((fun x : ℝ => (x, y)) ⁻¹' (mssBox h C0 m)ᶜ) :=
    (mss_isClosed_box h C0 m).isOpen_compl.preimage (continuous_id.prodMk continuous_const)
  have hev : (fun x => f (x, y)) =ᶠ[𝓝 x] fun _ => 0 := by
    filter_upwards [hopen.mem_nhds hx] with x' hx'
    by_contra hne; exact hx' (hf _ hne)
  exact hd.unique ((hasDerivAt_const x (0 : ℂ)).congr_of_eventuallyEq hev)

theorem mss_deriv_eq_zero_y {f : ℝ × ℝ → ℂ} {h C0 : ℝ} {m : ℤ × ℤ}
    (hf : ∀ w, f w ≠ 0 → w ∈ mssBox h C0 m) {x y : ℝ} {d : ℂ}
    (hd : HasDerivAt (fun y => f (x, y)) d y) (hy : (x, y) ∉ mssBox h C0 m) : d = 0 := by
  have hopen : IsOpen ((fun y : ℝ => (x, y)) ⁻¹' (mssBox h C0 m)ᶜ) :=
    (mss_isClosed_box h C0 m).isOpen_compl.preimage (continuous_const.prodMk continuous_id)
  have hev : (fun y => f (x, y)) =ᶠ[𝓝 y] fun _ => 0 := by
    filter_upwards [hopen.mem_nhds hy] with y' hy'
    by_contra hne; exact hy' (hf _ hne)
  exact hd.unique ((hasDerivAt_const y (0 : ℂ)).congr_of_eventuallyEq hev)

theorem mss_measurable_monoq (r : ℝ) : Measurable (monoq r) := by
  unfold monoq; fun_prop

theorem mss_continuous_monoq {r : ℝ} (hr : 1 ≤ r) : Continuous (monoq r) := by
  unfold monoq
  exact continuous_const.mul (Real.continuous_rpow_const (by linarith))

theorem mss_monoq_nonneg {r : ℝ} (hr : 1 ≤ r) {t : ℝ} (ht : 0 ≤ t) : 0 ≤ monoq r t := by
  unfold monoq; have := Real.rpow_nonneg ht (r - 1); positivity

theorem mss_monoq_mono {r : ℝ} (hr : 1 ≤ r) {s t : ℝ} (hs : 0 ≤ s) (hst : s ≤ t) :
    monoq r s ≤ monoq r t := by
  unfold monoq
  exact mul_le_mul_of_nonneg_left (Real.rpow_le_rpow hs hst (by linarith)) (by linarith)

end

end Auto

