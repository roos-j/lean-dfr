open MeasureTheory Filter Topology Set FourierTransform Convolution
open scoped ENNReal SchwartzMap Real ContDiff RealInnerProductSpace

namespace Auto

noncomputable section

/-! ### (8.1): one telescoping step -/

/-- `Φ(L) = T_ψ(φ(D_1/L) f₁, φ(D_2/L) f₂)`. -/
def ms8Phi (r : ℝ) (ψ : ℝ → ℝ) (f₁ f₂ : ℝ × ℝ → ℂ) (L : ℝ) : ℝ × ℝ → ℂ :=
  monoT r ψ (monoP 0 monoKPhi L f₁) (monoP 1 monoKPhi L f₂)

theorem ms8_monoC20_nonneg (ψ : ℝ → ℝ) : 0 ≤ monoC20 ψ :=
  Finset.sum_nonneg fun k _ => Real.iSup_nonneg fun t => abs_nonneg _

/-- The telescoping step `Φ(L) - Φ(L/2) = T(Δ_L f₁, S_L f₂) + T(S_{L/2} f₁, Δ_L f₂)`, estimated by
the global annular estimate (7.7). -/
theorem ms8_step {r A B C s : ℝ} (hr : 1 < r) (hG : MonoGlobal77 r A B C s)
    {ψ : ℝ → ℝ} (hψ : ContDiff ℝ ∞ ψ) (hsupp : tsupport ψ ⊆ Icc A B)
    {f₁ f₂ : ℝ × ℝ → ℂ} (hf₁ : Measurable f₁) (hf₂ : Measurable f₂) {M₁ M₂ : ℝ}
    (hM₁ : ∀ z, ‖f₁ z‖ ≤ M₁) (hM₂ : ∀ z, ‖f₂ z‖ ≤ M₂)
    (h2₁ : eLpNorm f₁ 2 volume ≠ ⊤) (h2₂ : eLpNorm f₂ 2 volume ≠ ⊤) {L : ℝ} (hL : 1 ≤ L) :
    eLpNorm (fun z => ms8Phi r ψ f₁ f₂ L z - ms8Phi r ψ f₁ f₂ (L / 2) z) 1 volume
      ≤ ENNReal.ofReal (C * monoC20 ψ * L ^ (-s)) * (eLpNorm f₁ 2 volume * eLpNorm f₂ 2 volume) +
        ENNReal.ofReal (C * monoC20 ψ * L ^ (-s)) * (eLpNorm f₁ 2 volume * eLpNorm f₂ 2 volume) := by
  have hr0 : 0 < r := by linarith
  have hL0 : 0 < L := by linarith
  have hL2 : 0 < L / 2 := by linarith
  have hψc : HasCompactSupport ψ := isCompact_Icc.of_isClosed_subset (isClosed_tsupport ψ) hsupp
  have hψI : Integrable ψ volume := hψ.continuous.integrable_of_hasCompactSupport hψc
  have hψm : Measurable ψ := hψ.continuous.measurable
  obtain ⟨h1, h2⟩ := hG ψ hψ hsupp L hL f₁ f₂ hf₁ hf₂ h2₁ h2₂
  -- measurability and bounds
  have mS0 := ms8_measurable_monoP 0 monoKPhi L hf₁
  have mS0' := ms8_measurable_monoP 0 monoKPhi (L / 2) hf₁
  have mS1 := ms8_measurable_monoP 1 monoKPhi L hf₂
  have mS1' := ms8_measurable_monoP 1 monoKPhi (L / 2) hf₂
  have bS0 := ms8_monoP_bdd 0 monoKPhi hL0 hM₁
  have bS0' := ms8_monoP_bdd 0 monoKPhi hL2 hM₁
  have bS1 := ms8_monoP_bdd 1 monoKPhi hL0 hM₂
  have bS1' := ms8_monoP_bdd 1 monoKPhi hL2 hM₂
  have e1 : monoT r ψ (monoP 0 monoKPsiA L f₁) (monoP 1 monoKPhi L f₂) = fun z =>
      monoT r ψ (monoP 0 monoKPhi L f₁) (monoP 1 monoKPhi L f₂) z -
        monoT r ψ (monoP 0 monoKPhi (L / 2) f₁) (monoP 1 monoKPhi L f₂) z := by
    rw [ms8_monoP_PsiA 0 hL0 hf₁ hM₁]
    exact ms8_monoT_sub_left hr0 hψI mS0 mS0' mS1 bS0 bS0' bS1
  have e2 : monoT r ψ (monoP 0 monoKPhi (L / 2) f₁) (monoP 1 monoKPsiA L f₂) = fun z =>
      monoT r ψ (monoP 0 monoKPhi (L / 2) f₁) (monoP 1 monoKPhi L f₂) z -
        monoT r ψ (monoP 0 monoKPhi (L / 2) f₁) (monoP 1 monoKPhi (L / 2) f₂) z := by
    rw [ms8_monoP_PsiA 1 hL0 hf₂ hM₂]
    exact ms8_monoT_sub_right hr0 hψI mS0' mS1 mS1' bS0' bS1 bS1'
  have e : (fun z => ms8Phi r ψ f₁ f₂ L z - ms8Phi r ψ f₁ f₂ (L / 2) z) =
      monoT r ψ (monoP 0 monoKPsiA L f₁) (monoP 1 monoKPhi L f₂) +
        monoT r ψ (monoP 0 monoKPhi (L / 2) f₁) (monoP 1 monoKPsiA L f₂) := by
    rw [e1, e2]; funext z; simp only [ms8Phi, Pi.add_apply]; ring
  rw [e]
  refine (eLpNorm_add_le ?_ ?_ le_rfl).trans (add_le_add h1 h2)
  · exact (ms8_measurable_monoT hr0 hψm (ms8_measurable_monoP 0 _ L hf₁)
      (ms8_measurable_monoP 1 _ L hf₂)).aestronglyMeasurable
  · exact (ms8_measurable_monoT hr0 hψm (ms8_measurable_monoP 0 _ _ hf₁)
      (ms8_measurable_monoP 1 _ L hf₂)).aestronglyMeasurable

/-- The geometric series bound: `∑_{i<I} (2^N 2^i)^{-s} ≤ 2^s/(1-2^{-s}) Λ^{-s}` when `Λ < 2^{N+1}`. -/
theorem ms8_geom {s Λ : ℝ} (hs : 0 < s) (N I : ℕ) (hΛ : Λ < 2 ^ (N + 1)) (hΛ1 : 1 ≤ Λ) :
    ∑ i ∈ Finset.range I, ((2 : ℝ) ^ N * 2 ^ i) ^ (-s)
      ≤ 2 ^ s / (1 - 2 ^ (-s)) * Λ ^ (-s) := by
  have hq0 : 0 < (2 : ℝ) ^ (-s) := by positivity
  have hq1 : (2 : ℝ) ^ (-s) < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  have e : ∀ i : ℕ, ((2 : ℝ) ^ N * 2 ^ i) ^ (-s) = ((2 : ℝ) ^ N) ^ (-s) * (2 ^ (-s)) ^ i := by
    intro i
    rw [Real.mul_rpow (by positivity) (by positivity)]
    congr 1
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num), ← Real.rpow_natCast,
      ← Real.rpow_mul (by norm_num), mul_comm]
  simp_rw [e]
  rw [← Finset.mul_sum]
  have hgs : ∑ i ∈ Finset.range I, ((2 : ℝ) ^ (-s)) ^ i ≤ 1 / (1 - 2 ^ (-s)) := by
    rw [geom_sum_eq hq1.ne]
    have : 0 ≤ ((2 : ℝ) ^ (-s)) ^ I := by positivity
    rw [show ((2 : ℝ) ^ (-s)) ^ I - 1 = -(1 - ((2 : ℝ) ^ (-s)) ^ I) by ring,
      show (2 : ℝ) ^ (-s) - 1 = -(1 - 2 ^ (-s)) by ring, neg_div_neg_eq]
    exact div_le_div_of_nonneg_right (by linarith) (by linarith)
  have hN : ((2 : ℝ) ^ N) ^ (-s) ≤ 2 ^ s * Λ ^ (-s) := by
    have h1 : Λ / 2 ≤ (2 : ℝ) ^ N := by rw [pow_succ] at hΛ; linarith
    calc ((2 : ℝ) ^ N) ^ (-s) ≤ (Λ / 2) ^ (-s) :=
          Real.rpow_le_rpow_of_nonpos (by linarith) h1 (by linarith)
      _ = 2 ^ s * Λ ^ (-s) := by
          rw [Real.div_rpow (by linarith) (by norm_num), Real.rpow_neg (by norm_num : (0:ℝ) ≤ 2),
            div_inv_eq_mul, mul_comm]
  calc ((2 : ℝ) ^ N) ^ (-s) * ∑ i ∈ Finset.range I, ((2 : ℝ) ^ (-s)) ^ i
      ≤ (2 ^ s * Λ ^ (-s)) * (1 / (1 - 2 ^ (-s))) :=
        mul_le_mul hN hgs (Finset.sum_nonneg fun i _ => by positivity) (by positivity)
    _ = 2 ^ s / (1 - 2 ^ (-s)) * Λ ^ (-s) := by ring

end

