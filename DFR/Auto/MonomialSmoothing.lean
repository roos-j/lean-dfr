/-! ### (6.6)-(6.8) on a single fiber -/

theorem monoSharp_memLp {R ρ : ℝ} (hR : 0 < R) {F : ℝ → ℂ} (hF : Integrable F volume) {M : ℝ}
    (hM : ∀ t, ‖F t‖ ≤ M) : MemLp (monoSharp R ρ F) 2 volume :=
  memLp_two_of_bdd (integrable_monoSharp hR ρ hF) (norm_monoSharp_le hR hF.1 hM)

/-- `∫ |f_♯|^2 ≤ ∫ |f|^2` (from (2.1) and Plancherel). -/
theorem lintegral_monoSharp_sq_le {R ρ : ℝ} (hR : 0 < R) {F : ℝ → ℂ} (hF : Integrable F volume)
    {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) :
    ∫⁻ x, ‖monoSharp R ρ F x‖ₑ ^ 2 ≤ ∫⁻ x, ‖F x‖ₑ ^ 2 := by
  rw [← lintegral_fourier_sq_eq (integrable_monoSharp hR ρ hF) (monoSharp_memLp hR hF hM),
    ← lintegral_fourier_sq_eq hF (memLp_two_of_bdd hF hM)]
  refine lintegral_mono fun ξ => ?_
  gcongr
  rw [← ofReal_norm, ← ofReal_norm]
  exact ENNReal.ofReal_le_ofReal (norm_fourier_monoSharp_le hR ρ hF ξ)

/-- `∫ |f_♭|^2 ≤ ∫ |f|^2`. -/
theorem lintegral_monoFlat_sq_le {R ρ : ℝ} (hR : 0 < R) {F : ℝ → ℂ} (hF : Integrable F volume)
    {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) :
    ∫⁻ x, ‖monoFlat R ρ F x‖ₑ ^ 2 ≤ ∫⁻ x, ‖F x‖ₑ ^ 2 := by
  have h2 : MemLp (monoFlat R ρ F) 2 volume :=
    memLp_two_of_bdd (integrable_monoFlat hR ρ hF) (norm_monoFlat_le hR hF.1 hM)
  rw [← lintegral_fourier_sq_eq (integrable_monoFlat hR ρ hF) h2,
    ← lintegral_fourier_sq_eq hF (memLp_two_of_bdd hF hM)]
  refine lintegral_mono fun ξ => ?_
  gcongr
  rw [← ofReal_norm, ← ofReal_norm]
  exact ENNReal.ofReal_le_ofReal (norm_fourier_monoFlat_le hR ρ hF ξ)

/-- The sup bound in (6.8): `|f_♯| ≤ (9/ρ) ‖κ‖_1 ‖f‖_∞`. -/
theorem norm_monoSharp_le' {R ρ : ℝ} (hR : 0 < R) (hρ : 0 < ρ) {F : ℝ → ℂ}
    (hF : Integrable F volume) {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) (x : ℝ) :
    ‖monoSharp R ρ F x‖ ≤ 9 / ρ * ((∫ u, ‖monoKappa u‖) * M) := by
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  have hE : monoE F ≠ ⊤ := by
    rw [monoE_eq hF (memLp_two_of_bdd hF hM)]; exact lintegral_enorm_sq_ne_top (memLp_two_of_bdd hF hM)
  refine (norm_monoSharp_le hR hF.1 hM x).trans ?_
  exact mul_le_mul_of_nonneg_right (card_monoSel_le hR hρ hF hE)
    (mul_nonneg (integral_nonneg fun _ => norm_nonneg _) hM0)

/-- **Frequency centers** ((2.5) applied): if `f̂` vanishes for `|ξ| > Ω`, every nonzero piece has
`|nR| ≤ Ω + R`. -/
theorem monoPiece_eq_zero_of_large {R : ℝ} (hR : 1 ≤ R) (n : ℤ) {F : ℝ → ℂ}
    (hF : Integrable F volume) {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) {Ω : ℝ}
    (hΩ : ∀ ξ, Ω < |ξ| → 𝓕 F ξ = 0) (hn : Ω + R < |(n : ℝ) * R|) : monoPiece R n F = 0 := by
  refine monoPiece_eq_zero hR n hF hM fun ξ hξ => hΩ ξ ?_
  have := abs_sub_abs_le_abs_sub (n * R) ξ
  rw [abs_sub_comm] at hξ
  linarith

/-- **Frequency centers** ((2.5) applied): if `f̂` vanishes for `|ξ| < ω₀`, every nonzero piece has
`|nR| ≥ ω₀ - R`. -/
theorem monoPiece_eq_zero_of_small {R : ℝ} (hR : 1 ≤ R) (n : ℤ) {F : ℝ → ℂ}
    (hF : Integrable F volume) {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) {ω₀ : ℝ}
    (hω : ∀ ξ, |ξ| < ω₀ → 𝓕 F ξ = 0) (hn : |(n : ℝ) * R| < ω₀ - R) : monoPiece R n F = 0 := by
  refine monoPiece_eq_zero hR n hF hM fun ξ hξ => hω ξ ?_
  have := abs_sub_abs_le_abs_sub ξ (n * R)
  linarith

/-- The derivative of a piece `h_n(x) e^{2πinRx}`. -/
theorem hasDerivAt_monoPiece {R : ℝ} (hR : 1 ≤ R) (n : ℤ) {F : ℝ → ℂ}
    (hF : AEStronglyMeasurable F volume) {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) (x : ℝ) :
    HasDerivAt (monoPiece R n F)
      (monoH' R n F x * (𝐞 (n * R * x) : Circle) +
        monoH R n F x * ((2 * π * n * R : ℝ) * Complex.I * (𝐞 (n * R * x) : Circle))) x := by
  have e : monoPiece R n F = fun x => monoH R n F x * (𝐞 (n * R * x) : Circle) :=
    funext (monoPiece_eq_monoH R n F)
  rw [e]
  refine (hasDerivAt_monoH hR n hF hM x).mul ?_
  have h1 : HasDerivAt (fun y : ℝ => 2 * π * (n * R * y)) (2 * π * n * R) x := by
    have h := (hasDerivAt_id x).const_mul (2 * π * n * R)
    have e : (fun y : ℝ => 2 * π * n * R * id y) = fun y => 2 * π * (n * R * y) := by
      funext y; simp only [id]; ring
    rw [e, mul_one] at h; exact h
  have h4 : HasDerivAt (fun y : ℝ => Complex.exp (((2 * π * (n * R * y) : ℝ) : ℂ) * Complex.I))
      (Complex.exp (((2 * π * (n * R * x) : ℝ) : ℂ) * Complex.I) * (((2 * π * n * R : ℝ) : ℂ) *
        Complex.I)) x := (h1.ofReal_comp.mul_const Complex.I).cexp
  have h3 : (fun y : ℝ => ((𝐞 (n * R * y) : Circle) : ℂ))
      = fun y => Complex.exp (((2 * π * (n * R * y) : ℝ) : ℂ) * Complex.I) := by
    funext y; rw [Real.fourierChar_apply]
  rw [h3]
  exact h4.congr_deriv (by rw [Real.fourierChar_apply]; ring)

/-- The derivative bound of a piece: `|(ϑ(D/R - n) F)'| ≤ (R ‖κ'‖_1 + 2π|nR| ‖κ‖_1) ‖F‖_∞`. -/
theorem norm_deriv_monoPiece_le {R : ℝ} (hR : 1 ≤ R) (n : ℤ) {F : ℝ → ℂ}
    (hF : AEStronglyMeasurable F volume) {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) (x : ℝ) :
    ‖monoH' R n F x * (𝐞 (n * R * x) : Circle) +
        monoH R n F x * ((2 * π * n * R : ℝ) * Complex.I * (𝐞 (n * R * x) : Circle))‖
      ≤ (R * (∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖) + 2 * π * |(n : ℝ) * R| * (∫ u, ‖monoKappa u‖)) * M := by
  have hR0 : 0 < R := by linarith
  refine (norm_add_le _ _).trans ?_
  rw [norm_mul, Circle.norm_coe, mul_one, norm_mul, norm_mul, norm_mul, Circle.norm_coe, mul_one,
    Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs]
  have h1 := norm_monoH'_le hR0 n hF hM x
  have h2 := norm_monoH_le hR0 n hF hM x
  have habs : |2 * π * n * R| = 2 * π * |(n : ℝ) * R| := by
    rw [show 2 * π * n * R = (2 * π) * (n * R) by ring, abs_mul, abs_of_pos (by positivity)]
  rw [habs]
  have : ‖monoH R n F x‖ * (2 * π * |(n : ℝ) * R|)
      ≤ (∫ u, ‖monoKappa u‖) * M * (2 * π * |(n : ℝ) * R|) :=
    mul_le_mul_of_nonneg_right h2 (by positivity)
  nlinarith

end

