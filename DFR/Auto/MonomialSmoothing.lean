theorem msub_conv {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A ≤ B) :
    ∃ κ, 0 < κ ∧ ConvexOn ℝ (Icc A B) (fun t => t ^ r - κ / 2 * (t * t)) := by
  obtain ⟨m2, hm2, hm2'⟩ := msub_pos_min_of_contOn hAB (msub_rpow_contOn (a := r - 1 - 1) hA)
    (fun x hx => Real.rpow_pos_of_pos (lt_of_lt_of_le hA hx.1) _)
  have hr1 : 0 < r - 1 := by linarith
  refine ⟨r * (r - 1) * m2, by positivity, ?_⟩
  set κ := r * (r - 1) * m2
  have hd : ∀ x, 0 < x → HasDerivAt (fun t : ℝ => t ^ r - κ / 2 * (t * t))
      (r * x ^ (r - 1) - κ / 2 * (1 * x + x * 1)) x := by
    intro x hx
    exact (Real.hasDerivAt_rpow_const (p := r) (Or.inl hx.ne')).sub
      (HasDerivAt.const_mul (κ / 2) ((hasDerivAt_id' x).mul (hasDerivAt_id' x)))
  apply MonotoneOn.convexOn_of_deriv (convex_Icc A B)
  · exact (msub_rpow_contOn hA).sub (continuousOn_const.mul (continuousOn_id.mul continuousOn_id))
  · rw [interior_Icc]
    intro x hx; exact (hd x (lt_trans hA hx.1)).differentiableAt.differentiableWithinAt
  · rw [interior_Icc]
    intro x hx y hy hxy
    rw [(hd x (lt_trans hA hx.1)).deriv, (hd y (lt_trans hA hy.1)).deriv]
    have h := msub_slope_lower (A := A) (B := B) (m := (r - 1) * m2)
      (φ := fun t => t ^ (r - 1)) (φ' := fun t => (r - 1) * t ^ (r - 1 - 1))
      (fun z hz => Real.hasDerivAt_rpow_const (Or.inl (lt_of_lt_of_le hA hz.1).ne'))
      (fun z hz => mul_le_mul_of_nonneg_left (hm2' z hz) (by linarith))
      (Ioo_subset_Icc_self hx) (Ioo_subset_Icc_self hy) hxy
    have hr0 : 0 < r := by linarith
    have := mul_le_mul_of_nonneg_left h hr0.le
    simp only [κ]; nlinarith

/-- The Jacobian determinant `det[(1,1,1),(q(t_i)),(t_i^{-1})]` in the coordinates
`t = (t₀,t₁,t₂)` (blueprint (3.6)-(3.8), up to sign). -/
def msubDet (r : ℝ) (t : ℝ × ℝ × ℝ) : ℝ :=
  (monoq r t.2.1 - monoq r t.1) * (t.2.2⁻¹ - t.1⁻¹) -
    (monoq r t.2.2 - monoq r t.1) * (t.2.1⁻¹ - t.1⁻¹)

theorem msub_det_eq {r : ℝ} {t : ℝ × ℝ × ℝ} (h0 : 0 < t.1) (h1 : 0 < t.2.1) (h2 : 0 < t.2.2) :
    msubDet r t * (t.1 * t.2.1 * t.2.2) = r * msubV (fun x => x ^ r) t.1 t.2.1 t.2.2 := by
  unfold msubDet msubV monoq
  rw [Real.rpow_sub_one h0.ne', Real.rpow_sub_one h1.ne', Real.rpow_sub_one h2.ne']
  field_simp
  ring

def msubI3 (A B : ℝ) : Set (ℝ × ℝ × ℝ) := {t | t.1 ∈ Icc A B ∧ t.2.1 ∈ Icc A B ∧ t.2.2 ∈ Icc A B}

theorem msub_det_lower {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A ≤ B) :
    ∃ κ₁, 0 < κ₁ ∧ ∀ t ∈ msubI3 A B, κ₁ * |msubP t.1 t.2.1 t.2.2| ≤ |msubDet r t| := by
  obtain ⟨κ, hκ, hconv⟩ := msub_conv hr hA hAB
  have hB : 0 < B := lt_of_lt_of_le hA hAB
  have hr0 : 0 < r := by linarith
  refine ⟨r * (κ / 2) / B ^ 3, by positivity, ?_⟩
  rintro t ⟨h0, h1, h2⟩
  have p0 : 0 < t.1 := lt_of_lt_of_le hA h0.1
  have p1 : 0 < t.2.1 := lt_of_lt_of_le hA h1.1
  have p2 : 0 < t.2.2 := lt_of_lt_of_le hA h2.1
  have hV := msub_V_lower hconv h0 h1 h2
  have he := msub_det_eq (r := r) p0 p1 p2
  have hprod : 0 < t.1 * t.2.1 * t.2.2 := by positivity
  have hprodB : t.1 * t.2.1 * t.2.2 ≤ B ^ 3 := by
    have := mul_le_mul (mul_le_mul h0.2 h1.2 p1.le hB.le) h2.2 p2.le (by positivity)
    nlinarith
  have hr0 : 0 < r := by linarith
  have habs : |msubDet r t| * (t.1 * t.2.1 * t.2.2) = r * |msubV (fun x => x ^ r) t.1 t.2.1 t.2.2| := by
    rw [← abs_of_pos hprod, ← abs_mul, he, abs_mul, abs_of_pos hr0]
  have hP0 : 0 ≤ |msubP t.1 t.2.1 t.2.2| := abs_nonneg _
  rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
  calc r * (κ / 2) * |msubP t.1 t.2.1 t.2.2| ≤ r * |msubV (fun x => x ^ r) t.1 t.2.1 t.2.2| := by
        rw [mul_assoc]; exact mul_le_mul_of_nonneg_left hV hr0.le
    _ = |msubDet r t| * (t.1 * t.2.1 * t.2.2) := habs.symm
    _ ≤ |msubDet r t| * B ^ 3 := mul_le_mul_of_nonneg_left hprodB (abs_nonneg _)

end
