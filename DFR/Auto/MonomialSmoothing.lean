namespace Auto

noncomputable section

/-- `J_h = I ∩ (I - h)`. -/
def mimpJ (A B h : ℝ) : Set ℝ := Icc A B ∩ Icc (A - h) (B - h)

theorem mimp_mem_J {A B h t : ℝ} : t ∈ mimpJ A B h ↔ t ∈ Icc A B ∧ t + h ∈ Icc A B := by
  simp only [mimpJ, mem_inter_iff, mem_Icc]
  constructor
  · rintro ⟨h1, h2⟩; exact ⟨h1, by linarith [h2.1], by linarith [h2.2]⟩
  · rintro ⟨h1, h2⟩; exact ⟨h1, by linarith [h2.1], by linarith [h2.2]⟩

theorem mimp_phi_hasDerivAt {r A B h t : ℝ} (hA : 0 < A) (ht : t ∈ mimpJ A B h) :
    HasDerivAt (fun t => monoQ r t - monoQ r (t + h)) (monoq r t - monoq r (t + h)) t := by
  rw [mimp_mem_J] at ht
  have h1 : 0 < t := lt_of_lt_of_le hA ht.1.1
  have h2 : 0 < t + h := lt_of_lt_of_le hA ht.2.1
  have hd2 : HasDerivAt (fun t => monoQ r (t + h)) (monoq r (t + h)) t := by
    exact HasDerivAt.comp_add_const t h (hasDerivAt_monoQ r h2)
  exact (hasDerivAt_monoQ r h1).sub hd2

theorem mimp_phi_injOn {r A B h : ℝ} (hr : 1 < r) (hA : 0 < A) (hh : h ≠ 0) :
    InjOn (fun t => monoQ r t - monoQ r (t + h)) (mimpJ A B h) := by
  have hconv : Convex ℝ (mimpJ A B h) := (convex_Icc _ _).inter (convex_Icc _ _)
  have hcont : ContinuousOn (fun t => monoQ r t - monoQ r (t + h)) (mimpJ A B h) :=
    fun x hx => (mimp_phi_hasDerivAt hA hx).continuousAt.continuousWithinAt
  have hder : ∀ x ∈ interior (mimpJ A B h),
      deriv (fun t => monoQ r t - monoQ r (t + h)) x = monoq r x - monoq r (x + h) :=
    fun x hx => (mimp_phi_hasDerivAt hA (interior_subset hx)).deriv
  rcases lt_or_gt_of_ne hh with hneg | hpos
  · refine (strictMonoOn_of_deriv_pos hconv hcont fun x hx => ?_).injOn
    rw [hder x hx]
    have hx' := mimp_mem_J.1 (interior_subset hx)
    have := mimp_monoq_lt hr (lt_of_lt_of_le hA hx'.2.1) (by linarith : x + h < x)
    linarith
  · refine (strictAntiOn_of_deriv_neg hconv hcont fun x hx => ?_).injOn
    rw [hder x hx]
    have hx' := mimp_mem_J.1 (interior_subset hx)
    have := mimp_monoq_lt hr (lt_of_lt_of_le hA hx'.1.1) (by linarith : x < x + h)
    linarith

/-- The one-dimensional change of variables bound for fixed `h ≠ 0`. -/
theorem mimp_oneD {r A B c h : ℝ} (hr : 1 < r) (hA : 0 < A) (hc : 0 < c)
    (hsep : ∀ a ∈ Icc A B, ∀ b ∈ Icc A B, c * |b - a| ≤ |monoq r b - monoq r a|)
    (hh : h ≠ 0) (g : ℝ → ℝ≥0∞) :
    ∫⁻ t in mimpJ A B h, g (monoQ r t - monoQ r (t + h)) ≤
      ENNReal.ofReal ((c * |h|)⁻¹) *
        ∫⁻ y in Icc (-(monoq r B * |h|)) (monoq r B * |h|), g y := by
  set φ : ℝ → ℝ := fun t => monoQ r t - monoQ r (t + h) with hφ
  have hJ : MeasurableSet (mimpJ A B h) := measurableSet_Icc.inter measurableSet_Icc
  have hch : 0 < c * |h| := mul_pos hc (abs_pos.2 hh)
  have step1 : ∫⁻ t in mimpJ A B h, g (φ t) ≤ ∫⁻ t in mimpJ A B h,
      ENNReal.ofReal ((c * |h|)⁻¹) * (ENNReal.ofReal |monoq r t - monoq r (t + h)| * g (φ t)) := by
    refine setLIntegral_mono' hJ fun t ht => ?_
    rw [← mul_assoc]
    refine le_mul_of_one_le_left zero_le ?_
    rw [← ENNReal.ofReal_mul (inv_nonneg.2 hch.le), ENNReal.one_le_ofReal]
    have ht' := mimp_mem_J.1 ht
    have := hsep t ht'.1 (t + h) ht'.2
    rw [show t + h - t = h by ring, abs_sub_comm] at this
    rw [inv_mul_eq_div, le_div_iff₀ hch, one_mul]
    exact this
  refine step1.trans ?_
  rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine mul_le_mul_right ?_ _
  rw [← lintegral_image_eq_lintegral_abs_deriv_mul hJ
    (fun t ht => (mimp_phi_hasDerivAt hA ht).hasDerivWithinAt) (mimp_phi_injOn hr hA hh) g]
  apply lintegral_mono_set
  rintro _ ⟨t, ht, rfl⟩
  have ht' := mimp_mem_J.1 ht
  have := mimp_monoQ_lip hr hA (t + h) ht'.2 t ht'.1
  rw [show t - (t + h) = -h by ring, abs_neg] at this
  exact abs_le.1 this

end

