/-! ### Level-set truncation, translation of (6.1), triangle inequality for three terms -/

theorem ms7_real_alg {Λ a : ℝ} (hΛ : 0 < Λ) (ha : 0 < a) :
    ((Λ * a) ^ (-(2 / 7) : ℝ) * a ^ (2 : ℝ)) ^ (7 / 12 : ℝ) = Λ ^ (-(1 / 6) : ℝ) * a := by
  rw [Real.mul_rpow hΛ.le ha.le, mul_assoc, ← Real.rpow_add ha,
    Real.mul_rpow (Real.rpow_nonneg hΛ.le _) (Real.rpow_nonneg ha.le _), ← Real.rpow_mul hΛ.le,
    ← Real.rpow_mul ha.le]
  norm_num

/-- **The level-set bound**: `‖u 1_{|u| > Λ ‖u‖_2}‖_{12/7} ≤ Λ^{-1/6} ‖u‖_2`. -/
theorem ms7_levelset {u : ℝ × ℝ → ℂ} (hu : Measurable u) (hu2 : eLpNorm u 2 volume ≠ ⊤)
    {Λ : ℝ} (hΛ : 0 < Λ) :
    eLpNorm ({z | ‖u z‖ ≤ Λ * (eLpNorm u 2 volume).toReal}ᶜ.indicator u) (12 / 7 : ℝ≥0∞) volume
      ≤ ENNReal.ofReal (Λ ^ (-(1 / 6) : ℝ)) * eLpNorm u 2 volume := by
  set a := (eLpNorm u 2 volume).toReal with ha_def
  have hS : MeasurableSet {z | ‖u z‖ ≤ Λ * a} := measurableSet_le hu.norm measurable_const
  rcases (ENNReal.toReal_nonneg (a := eLpNorm u 2 volume)).eq_or_lt with h0 | hpos
  · -- `u = 0` a.e.
    have hz : eLpNorm u 2 volume = 0 := by
      rcases (ENNReal.toReal_eq_zero_iff _).1 h0.symm with h | h
      · exact h
      · exact absurd h hu2
    rw [eLpNorm_eq_zero_iff hu.aestronglyMeasurable (by norm_num)] at hz
    have : {z | ‖u z‖ ≤ Λ * a}ᶜ.indicator u =ᵐ[volume] 0 := by
      filter_upwards [hz] with z hz'
      simp only [indicator_apply, Pi.zero_apply]
      split_ifs <;> simp_all
    rw [eLpNorm_congr_ae this, eLpNorm_zero]
    exact bot_le
  · have hlam : 0 < Λ * a := mul_pos hΛ hpos
    have hpt : ∀ z, ‖{z | ‖u z‖ ≤ Λ * a}ᶜ.indicator u z‖ₑ ^ (12 / 7 : ℝ) ≤
        ENNReal.ofReal ((Λ * a) ^ (-(2 / 7) : ℝ)) * ‖u z‖ₑ ^ (2 : ℝ) := by
      intro z
      by_cases hz : z ∈ {z | ‖u z‖ ≤ Λ * a}ᶜ
      · rw [indicator_of_mem hz, ← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _)
          (by norm_num), ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by norm_num),
          ← ENNReal.ofReal_mul (Real.rpow_nonneg hlam.le _)]
        refine ENNReal.ofReal_le_ofReal ?_
        have hlt : Λ * a < ‖u z‖ := not_le.mp hz
        have hx : 0 < ‖u z‖ := hlam.trans hlt
        have e : ‖u z‖ ^ (12 / 7 : ℝ) = ‖u z‖ ^ (-(2 / 7) : ℝ) * ‖u z‖ ^ (2 : ℝ) := by
          rw [← Real.rpow_add hx]; norm_num
        rw [e]
        exact mul_le_mul_of_nonneg_right
          (Real.rpow_le_rpow_of_nonpos hlam hlt.le (by norm_num : (-(2 / 7) : ℝ) ≤ 0))
          (by positivity)
      · rw [indicator_of_notMem hz, enorm_zero, ENNReal.zero_rpow_of_pos (by norm_num)]
        exact bot_le
    have hint : ∫⁻ z, ‖u z‖ₑ ^ (2 : ℝ) = ENNReal.ofReal (a ^ (2 : ℝ)) := by
      have h1 : eLpNorm u 2 volume = ENNReal.ofReal a := (ENNReal.ofReal_toReal hu2).symm
      rw [eLpNorm_two_eq_lintegral] at h1
      have h2 := congrArg (fun x : ℝ≥0∞ => x ^ (2 : ℝ)) h1
      rw [← ENNReal.rpow_mul, show (1 / 2 : ℝ) * 2 = 1 by norm_num, ENNReal.rpow_one] at h2
      rw [h2, ENNReal.ofReal_rpow_of_nonneg hpos.le (by norm_num)]
    rw [mimp_eLpNorm_12_7]
    calc (∫⁻ z, ‖{z | ‖u z‖ ≤ Λ * a}ᶜ.indicator u z‖ₑ ^ (12 / 7 : ℝ)) ^ (7 / 12 : ℝ)
        ≤ (∫⁻ z, ENNReal.ofReal ((Λ * a) ^ (-(2 / 7) : ℝ)) * ‖u z‖ₑ ^ (2 : ℝ)) ^ (7 / 12 : ℝ) := by
          gcongr with z; exact hpt z
      _ = ENNReal.ofReal (((Λ * a) ^ (-(2 / 7) : ℝ) * a ^ (2 : ℝ)) ^ (7 / 12 : ℝ)) := by
          rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, hint,
            ← ENNReal.ofReal_mul (Real.rpow_nonneg hlam.le _),
            ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num)]
      _ = ENNReal.ofReal (Λ ^ (-(1 / 6) : ℝ)) * eLpNorm u 2 volume := by
          rw [ms7_real_alg hΛ hpos, ENNReal.ofReal_mul (Real.rpow_nonneg hΛ.le _),
            ENNReal.ofReal_toReal hu2]

/-- Translation invariance of the localized `L^1` norm. -/
theorem ms7_eLp1_transl (F : ℝ × ℝ → ℂ) (q : ℝ × ℝ) :
    eLpNorm F 1 volume = eLpNorm (fun w => F (w + q)) 1 volume := by
  rw [eLpNorm_one_eq_lintegral_enorm, eLpNorm_one_eq_lintegral_enorm]
  exact (lintegral_add_right_eq_self (fun z => ‖F z‖ₑ) q).symm

/-- The hypothesis of (6.1) transported to the cutoff `χ(· - q)`. -/
theorem ms7_Hinf_transl {r : ℝ} {ψ : ℝ → ℝ} {κ₁ κ₂ : 𝓢(ℝ, ℂ)} {L₁ L₂ M : ℝ}
    (H : ∀ u₁ u₂ : ℝ × ℝ → ℂ, Measurable u₁ → Measurable u₂ → ∀ B₁ B₂ : ℝ,
      (∀ z, ‖u₁ z‖ ≤ B₁) → (∀ z, ‖u₂ z‖ ≤ B₂) →
      eLpNorm (fun z => (ms7Chi z : ℂ) * monoT r ψ (monoP 0 κ₁ L₁ u₁) (monoP 1 κ₂ L₂ u₂) z)
        1 volume ≤ ENNReal.ofReal (M * B₁ * B₂))
    (q : ℝ × ℝ) {u₁ u₂ : ℝ × ℝ → ℂ} (hu₁ : Measurable u₁) (hu₂ : Measurable u₂) {B₁ B₂ : ℝ}
    (hB₁ : ∀ z, ‖u₁ z‖ ≤ B₁) (hB₂ : ∀ z, ‖u₂ z‖ ≤ B₂) :
    eLpNorm (fun z => (ms7Chi (z - q) : ℂ) * monoT r ψ (monoP 0 κ₁ L₁ u₁) (monoP 1 κ₂ L₂ u₂) z)
      1 volume ≤ ENNReal.ofReal (M * B₁ * B₂) := by
  rw [ms7_eLp1_transl _ q]
  have e : (fun w => (ms7Chi (w + q - q) : ℂ) *
      monoT r ψ (monoP 0 κ₁ L₁ u₁) (monoP 1 κ₂ L₂ u₂) (w + q)) =
      fun w => (ms7Chi w : ℂ) * monoT r ψ (monoP 0 κ₁ L₁ (fun v => u₁ (v + q)))
        (monoP 1 κ₂ L₂ (fun v => u₂ (v + q))) w := by
    funext w
    rw [add_sub_cancel_right, ms7_P_transl', ms7_P_transl', ms7_T_transl]
  rw [e]
  exact H _ _ (hu₁.comp (measurable_add_const q)) (hu₂.comp (measurable_add_const q)) B₁ B₂
    (fun z => hB₁ _) (fun z => hB₂ _)

/-- Triangle inequality in `L^1` for an a.e. decomposition into three terms. -/
theorem ms7_eLp_three {F G₁ G₂ G₃ : ℝ × ℝ → ℂ}
    (h : F =ᵐ[volume] fun z => G₁ z + G₂ z + G₃ z) (h₁ : AEStronglyMeasurable G₁ volume)
    (h₂ : AEStronglyMeasurable G₂ volume) (h₃ : AEStronglyMeasurable G₃ volume) :
    eLpNorm F 1 volume ≤ eLpNorm G₁ 1 volume + eLpNorm G₂ 1 volume + eLpNorm G₃ 1 volume := by
  rw [eLpNorm_congr_ae h]
  refine (eLpNorm_add_le (h₁.add h₂) h₃ le_rfl).trans ?_
  gcongr
  exact eLpNorm_add_le h₁ h₂ le_rfl

end

