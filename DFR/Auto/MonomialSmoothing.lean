theorem mimp_pointwise_split (x y : ℝ≥0∞) :
    (x ^ (8 / 7 : ℝ) * y ^ (6 / 7 : ℝ)) ^ (1 / 2 : ℝ) *
      (x ^ (6 / 7 : ℝ) * y ^ (8 / 7 : ℝ)) ^ (1 / 2 : ℝ) = x * y := by
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ENNReal.mul_rpow_of_nonneg _ _ (by norm_num),
    ← ENNReal.rpow_mul, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul]
  calc x ^ (8 / 7 * (1 / 2) : ℝ) * y ^ (6 / 7 * (1 / 2) : ℝ) *
        (x ^ (6 / 7 * (1 / 2) : ℝ) * y ^ (8 / 7 * (1 / 2) : ℝ))
      = (x ^ (4 / 7 : ℝ) * x ^ (3 / 7 : ℝ)) * (y ^ (3 / 7 : ℝ) * y ^ (4 / 7 : ℝ)) := by
        norm_num; ring
    _ = x * y := by
      rw [← ENNReal.rpow_add_of_nonneg _ _ (by norm_num) (by norm_num),
        ← ENNReal.rpow_add_of_nonneg _ _ (by norm_num) (by norm_num)]
      norm_num

/-- Cauchy–Schwarz splitting with exponents `8/7, 6/7`. -/
theorem mimp_split {S : Set ℝ} {γ : ℝ → ℝ × ℝ} (hγ : Measurable γ)
    {F G : ℝ × ℝ → ℝ≥0∞} (hF : Measurable F) (hG : Measurable G) :
    ∫⁻ z, F z * ∫⁻ t in S, G (z + γ t) ≤
      (∫⁻ z, F z ^ (8 / 7 : ℝ) * ∫⁻ t in S, G (z + γ t) ^ (6 / 7 : ℝ)) ^ (1 / 2 : ℝ) *
      (∫⁻ z, F z ^ (6 / 7 : ℝ) * ∫⁻ t in S, G (z + γ t) ^ (8 / 7 : ℝ)) ^ (1 / 2 : ℝ) := by
  set μ : Measure ((ℝ × ℝ) × ℝ) := (volume : Measure (ℝ × ℝ)).prod (volume.restrict S)
  have conv : ∀ Φ : ℝ≥0∞ → ℝ≥0∞ → ℝ≥0∞, Measurable (Function.uncurry Φ) →
      ∫⁻ p, Φ (F p.1) (G (p.1 + γ p.2)) ∂μ =
        ∫⁻ z, ∫⁻ t in S, Φ (F z) (G (z + γ t)) := by
    intro Φ hΦ
    rw [lintegral_prod _ (by
      apply Measurable.aemeasurable
      exact hΦ.comp ((hF.comp measurable_fst).prodMk
        (hG.comp (measurable_fst.add (hγ.comp measurable_snd)))))]
  have e0 : ∫⁻ z, F z * ∫⁻ t in S, G (z + γ t) = ∫⁻ p, F p.1 * G (p.1 + γ p.2) ∂μ := by
    rw [conv (fun x y => x * y) (by fun_prop)]
    congr 1; ext z; rw [lintegral_const_mul _ (by fun_prop)]
  have e1 : ∀ a b : ℝ, ∫⁻ z, F z ^ a * ∫⁻ t in S, G (z + γ t) ^ b =
      ∫⁻ p, F p.1 ^ a * G (p.1 + γ p.2) ^ b ∂μ := by
    intro a b
    rw [conv (fun x y => x ^ a * y ^ b) (by fun_prop)]
    congr 1; ext z; rw [lintegral_const_mul _ (by fun_prop)]
  rw [e0, e1, e1]
  have h := ENNReal.lintegral_mul_norm_pow_le (μ := μ)
    (f := fun p => F p.1 ^ (8 / 7 : ℝ) * G (p.1 + γ p.2) ^ (6 / 7 : ℝ))
    (g := fun p => F p.1 ^ (6 / 7 : ℝ) * G (p.1 + γ p.2) ^ (8 / 7 : ℝ))
    (by apply Measurable.aemeasurable; fun_prop) (by apply Measurable.aemeasurable; fun_prop)
    (p := 1 / 2) (q := 1 / 2) (by norm_num) (by norm_num) (by norm_num)
  simp_rw [mimp_pointwise_split] at h
  exact h

end

