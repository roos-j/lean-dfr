/-- The reflected curve `-Γ`. -/
def msubGam' (r t : ℝ) : ℝ × ℝ := (t, -monoQ r t)

theorem msub_Gam'_eq (r t : ℝ) : msubGam' r t = -msubGam r t := by
  ext <;> simp [msubGam', msubGam]

theorem msub_Gam'_sum (r : ℝ) (z0 : ℝ × ℝ) (t : ℝ × ℝ × ℝ) :
    z0 + msubGam' r t.1 - msubGam' r t.2.1 + msubGam' r t.2.2 = z0 - msubTh r t := by
  ext <;> simp [msubGam', msubTh] <;> ring

/-- Lemma 3.1 in the case `|β| ≥ c₀` (blueprint lines 578-587). -/
theorem msub_beta_case {r A B R : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) (hR : 0 < R)
    {c0 : ℝ} (hc0 : 0 < c0) :
    ∃ C, 0 ≤ C ∧ ∀ α β : ℝ × ℝ → ℝ, Measurable α → Measurable β → (∀ z, c0 ≤ |β z|) →
      ∀ ε : ℝ, 0 < ε → (volume (msubEset r A B R α β ε)).toReal ≤ C * ε ^ (1 / 39 : ℝ) := by
  obtain ⟨D0, D1, m0, m1, f0, f1, p0, p1, hfacts⟩ := msub_Eset_facts hr hA hAB hR
  obtain ⟨qm, qM, hqm, hq⟩ := msub_q_bounds (by linarith : (0:ℝ) < r) hA hAB.le
  obtain ⟨Cν, hCν, hCν'⟩ := msub_nu_beta hr hA hAB hc0
  have hqM : 0 < qM := lt_of_lt_of_le hqm ((hq A ⟨le_rfl, hAB.le⟩).1.trans
    (hq A ⟨le_rfl, hAB.le⟩).2)
  have hq' : ∀ t ∈ Icc A B, qM⁻¹ ≤ (monoq r t)⁻¹ ∧ (monoq r t)⁻¹ ≤ qm⁻¹ := fun t ht =>
    ⟨inv_anti₀ (lt_of_lt_of_le hqm (hq t ht).1) (hq t ht).2, inv_anti₀ hqm (hq t ht).1⟩
  set Kl := qm⁻¹ / (qM⁻¹ * qM⁻¹) + 2 / qM⁻¹
  have hKl : 0 < Kl := by positivity
  set K := 32 * (volume D1).toReal ^ 2 * (volume D0).toReal * (Cν * (Kl / qm) ^ (1 / 13 : ℝ))
  have hK : 0 ≤ K := by positivity
  refine ⟨K ^ (1 / 3 : ℝ), by positivity, fun α β hα hβ hβc ε hε => ?_⟩
  obtain ⟨hmem, hfin⟩ := hfacts α β ε
  have hEm := msub_Eset_meas r A B R hα hβ ε
  set E := msubEset r A B R α β ε
  have hG' : Measurable (msubGam' r) := by
    unfold msubGam'; exact measurable_id.prodMk (msub_meas_monoQ r).neg
  set E'' := (fun p : (ℝ × ℝ) × ℝ => (p.1 + msubGam' r p.2, p.2)) ⁻¹' E
  have hE''m : MeasurableSet E'' :=
    ((measurable_fst.add (hG'.comp measurable_snd)).prodMk measurable_snd) hEm
  have hvol : volume E'' = volume E := msub_shear hG' hEm
  have hback : ∀ p : (ℝ × ℝ) × ℝ, p.1 + msubGam' r p.2 + msubGam r p.2 = p.1 := by
    intro p; rw [msub_Gam'_eq]; abel
  have h3 := msub_case hG' hE''m m1 m0 f1 f0 p1 p0
    (fun p hp => by have := (hmem _ hp).2; simp only at this; rwa [hback] at this)
    (fun p hp => (hmem _ hp).1) (by rw [hvol]; exact hfin)
    (qg := fun t => (monoq r t)⁻¹) (a := β) (b := α) (ε := ε / qm)
    (inv_pos.mpr hqM) hq' (fun p hp => by
      obtain ⟨-, h2, h3⟩ := hp
      simp only at h2 h3
      rw [hback] at h3
      refine ⟨h2, ?_⟩
      have hq0 : 0 < monoq r p.2 := lt_of_lt_of_le hqm (hq _ h2).1
      have e : β p.1 - (monoq r p.2)⁻¹ * α (p.1 + msubGam' r p.2) =
          -(α (p.1 + msubGam' r p.2) - monoq r p.2 * β p.1) / monoq r p.2 := by
        field_simp; ring
      rw [e, abs_div, abs_neg, abs_of_pos hq0]
      exact div_le_div₀ hε.le h3 hqm (hq _ h2).1)
    (y := Cν * (Kl * (ε / qm)) ^ (1 / 13 : ℝ)) (by positivity) (fun z0 => by
      simp_rw [msub_Gam'_sum]
      exact hCν' (β z0) (hβc z0) (fun u => α (z0 - u))
        (hα.comp (measurable_const.sub measurable_id)) (Kl * (ε / qm)) (by positivity))
  rw [hvol] at h3
  refine msub_final_alg ENNReal.toReal_nonneg hK hε (le_of_le_of_eq h3 ?_)
  rw [show Kl * (ε / qm) = Kl / qm * ε by ring, Real.mul_rpow (by positivity) hε.le]; ring

end
