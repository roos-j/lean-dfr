/-! ### The sharp families as modulated components (lines 1081-1133) -/

theorem exists_deriv_monoBeta_bound : ∃ C : ℝ, 0 ≤ C ∧ ∀ x, |deriv monoBeta x| ≤ C := by
  have hc : Continuous (deriv monoBeta) := monoBeta_contDiff.continuous_deriv (by exact_mod_cast le_top)
  have hs : HasCompactSupport (deriv monoBeta) := by
    have : HasCompactSupport monoBeta :=
      HasCompactSupport.of_support_subset_isCompact (isCompact_Icc (a := -3/2) (b := 3/2)) fun x hx => by
        by_contra h; apply hx; apply monoBeta_eq_zero
        simp only [mem_Icc, not_and_or, not_le] at h
        rcases h with h | h
        · rw [abs_of_neg (by linarith)]; linarith
        · rw [abs_of_pos (by linarith)]; linarith
    exact this.deriv
  obtain ⟨C, hC⟩ := hc.bounded_above_of_compact_support hs
  exact ⟨max C 0, le_max_right _ _, fun x =>
    (show |deriv monoBeta x| ≤ C by simpa [Real.norm_eq_abs] using hC x).trans (le_max_left _ _)⟩

/-- The derivative of `a ↦ χ_m(pt a p)`. -/
theorem hasDerivAt_chiM_pt (j : Fin 2) {h : ℝ} (hh : 0 < h) (m : ℤ × ℤ) (p a : ℝ) :
    HasDerivAt (fun a => monoChiM h m (monoPt j a p))
      (deriv monoBeta (a / h - monoMAct j m) / h * monoBeta (p / h - monoMPas j m)) a := by
  simp_rw [monoChiM_pt]
  have h1 : HasDerivAt (fun a : ℝ => a / h - monoMAct j m) (1 / h) a := by
    simpa using ((hasDerivAt_id a).div_const h).sub_const (monoMAct j m : ℝ)
  have h2 := ((monoBeta_contDiff.differentiable (by simp) _).hasDerivAt).comp a h1
  have h3 := h2.mul_const (monoBeta (p / h - monoMPas j m))
  refine h3.congr_deriv ?_
  ring

/-- The selection sets of a family: filtered by `L/8 ≤ |nR|` for the high-frequency input. -/
def monoTSet (high : Bool) (R ρ L : ℝ) (F : ℝ → ℂ) : Finset ℤ :=
  if high then (monoSel R ρ F).filter fun n => L / 8 ≤ |(n : ℝ) * R| else monoSel R ρ F

theorem monoTSet_subset (high : Bool) (R ρ L : ℝ) (F : ℝ → ℂ) :
    monoTSet high R ρ L F ⊆ monoSel R ρ F := by
  unfold monoTSet; split_ifs
  · exact Finset.filter_subset _ _
  · exact subset_refl _

theorem measurableSet_monoTSet (j : Fin 2) (high : Bool) {R ρ L : ℝ} (hR : 0 < R) (hρ : 0 < ρ)
    {G : ℝ × ℝ → ℂ} (hG : Measurable G) (hint : ∀ p, Integrable (monoFib j G p) volume)
    (hfin : ∀ p, monoE (monoFib j G p) ≠ ⊤) (n : ℤ) :
    MeasurableSet {p | n ∈ monoTSet high R ρ L (monoFib j G p)} := by
  have h0 := measurableSet_sel_fib j hR hρ hG hint hfin n
  cases high
  · simpa [monoTSet] using h0
  · have e : {p | n ∈ monoTSet true R ρ L (monoFib j G p)}
        = {p | n ∈ monoSel R ρ (monoFib j G p)} ∩ {_p : ℝ | L / 8 ≤ |(n : ℝ) * R|} := by
      ext p; simp [monoTSet]
    rw [e]; exact h0.inter (MeasurableSet.const _)

theorem card_monoTSet_lt (high : Bool) {R ρ L : ℝ} (hR : 0 < R) (hρ : 0 < ρ) {F : ℝ → ℂ}
    (hF : Integrable F volume) (hE : monoE F ≠ ⊤) :
    (monoTSet high R ρ L F).card < ⌊9 / ρ⌋₊ + 1 := by
  have h1 := Finset.card_le_card (monoTSet_subset high R ρ L F)
  have h2 := card_monoSel_le hR hρ hF hE
  have h3 : (monoSel R ρ F).card ≤ ⌊9 / ρ⌋₊ := Nat.le_floor h2
  omega

/-- The sharp part is the sum over the selection set, given the vanishing of the dropped pieces. -/
theorem monoSharp_eq_monoTSet (high : Bool) {R ρ L : ℝ} (hR : 1 ≤ R) (hRL : R ≤ L / 8) {F : ℝ → ℂ}
    (hF : Integrable F volume) {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M)
    (hlow : high = true → ∀ ξ, |ξ| < L / 4 → 𝓕 F ξ = 0) (x : ℝ) :
    monoSharp R ρ F x = ∑ n ∈ monoTSet high R ρ L F, monoPiece R n F x := by
  refine monoSharp_eq_sum_subset (monoTSet_subset high R ρ L F) (fun n hn hnT => ?_) x
  cases high
  · simp [monoTSet] at hnT; exact absurd hn hnT
  · simp only [monoTSet, if_true, Finset.mem_filter, not_and, not_le] at hnT
    have hsmall := hnT hn
    exact monoPiece_eq_zero_of_small hR n hF hM (hlow rfl) (by linarith)

end

