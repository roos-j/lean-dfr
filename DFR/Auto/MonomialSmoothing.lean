/-! ### The spatial partition of unity `η_m` and the enlarged cutoffs `χ_m` (lines 939-950) -/

theorem mloc_theta_nonneg (x : ℝ) : 0 ≤ smoothingPartitionCutoff x :=
  (smoothingPartitionCutoff_bounds x).1

theorem mloc_theta_le_one (x : ℝ) : smoothingPartitionCutoff x ≤ 1 :=
  (smoothingPartitionCutoff_bounds x).2

theorem mloc_theta_ne_zero {x : ℝ} (hx : smoothingPartitionCutoff x ≠ 0) : |x| < 3 / 4 :=
  lt_of_not_ge fun h => hx (smoothingPartitionCutoff_eq_zero h)

theorem mloc_phi_nonneg (x : ℝ) : 0 ≤ monoPhi x := Real.smoothTransition.nonneg _

theorem mloc_phi_le_one (x : ℝ) : monoPhi x ≤ 1 := Real.smoothTransition.le_one _

theorem mloc_beta_nonneg (x : ℝ) : 0 ≤ monoBeta x := mloc_phi_nonneg _

theorem mloc_beta_le_one (x : ℝ) : monoBeta x ≤ 1 := mloc_phi_le_one _

theorem mloc_beta_eq_one {x : ℝ} (hx : |x| ≤ 3 / 4) : monoBeta x = 1 := by
  apply monoPhi_eq_one
  rw [mul_div_assoc, abs_mul, abs_div]; norm_num
  linarith

theorem mloc_beta_eq_zero {x : ℝ} (hx : 3 / 2 ≤ |x|) : monoBeta x = 0 := by
  apply monoPhi_eq_zero
  rw [mul_div_assoc, abs_mul, abs_div]; norm_num
  linarith

theorem mloc_beta_ne_zero {x : ℝ} (hx : monoBeta x ≠ 0) : |x| < 3 / 2 :=
  lt_of_not_ge fun h => hx (mloc_beta_eq_zero h)

theorem mloc_Eta_nonneg (h : ℝ) (m : ℤ × ℤ) (z : ℝ × ℝ) : 0 ≤ monoEta h m z :=
  mul_nonneg (mloc_theta_nonneg _) (mloc_theta_nonneg _)

theorem mloc_Eta_le_one (h : ℝ) (m : ℤ × ℤ) (z : ℝ × ℝ) : monoEta h m z ≤ 1 :=
  mul_le_one₀ (mloc_theta_le_one _) (mloc_theta_nonneg _) (mloc_theta_le_one _)

theorem mloc_ChiM_nonneg (h : ℝ) (m : ℤ × ℤ) (z : ℝ × ℝ) : 0 ≤ monoChiM h m z :=
  mul_nonneg (mloc_beta_nonneg _) (mloc_beta_nonneg _)

theorem mloc_ChiM_le_one (h : ℝ) (m : ℤ × ℤ) (z : ℝ × ℝ) : monoChiM h m z ≤ 1 :=
  mul_le_one₀ (mloc_beta_le_one _) (mloc_beta_nonneg _) (mloc_beta_le_one _)

theorem mloc_Eta_ne_zero {h : ℝ} {m : ℤ × ℤ} {z : ℝ × ℝ} (hz : monoEta h m z ≠ 0) :
    |z.1 / h - m.1| < 3 / 4 ∧ |z.2 / h - m.2| < 3 / 4 :=
  ⟨mloc_theta_ne_zero (left_ne_zero_of_mul hz), mloc_theta_ne_zero (right_ne_zero_of_mul hz)⟩

theorem mloc_ChiM_ne_zero {h : ℝ} {m : ℤ × ℤ} {z : ℝ × ℝ} (hz : monoChiM h m z ≠ 0) :
    |z.1 / h - m.1| < 3 / 2 ∧ |z.2 / h - m.2| < 3 / 2 :=
  ⟨mloc_beta_ne_zero (left_ne_zero_of_mul hz), mloc_beta_ne_zero (right_ne_zero_of_mul hz)⟩

theorem mloc_ChiM_eq_one_of_monoEta_ne_zero {h : ℝ} {m : ℤ × ℤ} {z : ℝ × ℝ}
    (hz : monoEta h m z ≠ 0) : monoChiM h m z = 1 := by
  obtain ⟨h1, h2⟩ := mloc_Eta_ne_zero hz
  simp only [monoChiM, mloc_beta_eq_one h1.le, mloc_beta_eq_one h2.le, mul_one]

/-- The integers within distance `3/2` of `x`. -/
def mlocNb1 (x : ℝ) : Finset ℤ := Finset.Icc (⌊x - 3 / 2⌋ + 1) (⌊x - 3 / 2⌋ + 3)

theorem mlocNb1_card (x : ℝ) : (mlocNb1 x).card = 3 := by
  simp only [mlocNb1, Int.card_Icc]; omega

theorem mloc_mem_Nb1 {x : ℝ} {n : ℤ} (hn : |x - n| < 3 / 2) : n ∈ mlocNb1 x := by
  rw [abs_lt] at hn
  simp only [mlocNb1, Finset.mem_Icc]
  constructor
  · have : x - 3 / 2 < n := by linarith
    have := Int.floor_lt.mpr this
    omega
  · have h1 := Int.lt_floor_add_one (x - 3 / 2)
    have : (n : ℝ) < ⌊x - 3 / 2⌋ + 4 := by linarith
    have : n < ⌊x - 3 / 2⌋ + 4 := by exact_mod_cast this
    omega

/-- The (at most nine) indices `m` near `z / h`. -/
def mlocNb (h : ℝ) (z : ℝ × ℝ) : Finset (ℤ × ℤ) := mlocNb1 (z.1 / h) ×ˢ mlocNb1 (z.2 / h)

theorem mlocNb_card (h : ℝ) (z : ℝ × ℝ) : (mlocNb h z).card = 9 := by
  simp [mlocNb, Finset.card_product, mlocNb1_card]

theorem mloc_mem_Nb_of_ChiM {h : ℝ} {m : ℤ × ℤ} {z : ℝ × ℝ} (hz : monoChiM h m z ≠ 0) :
    m ∈ mlocNb h z := by
  obtain ⟨h1, h2⟩ := mloc_ChiM_ne_zero hz
  exact Finset.mem_product.mpr ⟨mloc_mem_Nb1 h1, mloc_mem_Nb1 h2⟩

theorem mloc_mem_Nb_of_Eta {h : ℝ} {m : ℤ × ℤ} {z : ℝ × ℝ} (hz : monoEta h m z ≠ 0) :
    m ∈ mlocNb h z :=
  mloc_mem_Nb_of_ChiM (by rw [mloc_ChiM_eq_one_of_monoEta_ne_zero hz]; exact one_ne_zero)

/-- At most nine `χ_m` are nonzero at any point. -/
theorem mloc_ChiM_card_le {h : ℝ} {z : ℝ × ℝ} (S : Finset (ℤ × ℤ))
    (hS : ∀ m ∈ S, monoChiM h m z ≠ 0) : S.card ≤ 9 := by
  rw [← mlocNb_card h z]
  exact Finset.card_le_card fun m hm => mloc_mem_Nb_of_ChiM (hS m hm)

theorem mloc_Eta_card_le {h : ℝ} {z : ℝ × ℝ} (S : Finset (ℤ × ℤ))
    (hS : ∀ m ∈ S, monoEta h m z ≠ 0) : S.card ≤ 9 := by
  rw [← mlocNb_card h z]
  exact Finset.card_le_card fun m hm => mloc_mem_Nb_of_Eta (hS m hm)

theorem mloc_theta_tsum_sub (x : ℝ) : ∑' n : ℤ, smoothingPartitionCutoff (x - n) = 1 := by
  have hreindex := (Equiv.neg ℤ).tsum_eq (fun n : ℤ => smoothingPartitionCutoff (x + n))
  simp only [Equiv.neg_apply, Int.cast_neg, ← sub_eq_add_neg] at hreindex
  rw [hreindex, smoothingPartitionCutoff_partition]

theorem mloc_theta_sum_nb (x : ℝ) : ∑ n ∈ mlocNb1 x, smoothingPartitionCutoff (x - n) = 1 := by
  rw [← mloc_theta_tsum_sub x, tsum_eq_sum]
  intro n hn
  by_contra h0
  exact hn (mloc_mem_Nb1 (by linarith [mloc_theta_ne_zero h0]))

theorem mloc_Eta_eq_zero_of_not_mem {h : ℝ} {m : ℤ × ℤ} {z : ℝ × ℝ} (hm : m ∉ mlocNb h z) :
    monoEta h m z = 0 := by
  by_contra h0; exact hm (mloc_mem_Nb_of_Eta h0)

theorem mloc_ChiM_eq_zero_of_not_mem {h : ℝ} {m : ℤ × ℤ} {z : ℝ × ℝ} (hm : m ∉ mlocNb h z) :
    monoChiM h m z = 0 := by
  by_contra h0; exact hm (mloc_mem_Nb_of_ChiM h0)

theorem mloc_Eta_sum_nb (h : ℝ) (z : ℝ × ℝ) : ∑ m ∈ mlocNb h z, monoEta h m z = 1 := by
  simp only [mlocNb, monoEta, Finset.sum_product, ← Finset.sum_mul_sum, mloc_theta_sum_nb,
    mul_one]

theorem mloc_Eta_hasSum (h : ℝ) (z : ℝ × ℝ) : HasSum (fun m => monoEta h m z) 1 := by
  rw [← mloc_Eta_sum_nb h z]
  exact hasSum_sum_of_ne_finset_zero fun m hm => mloc_Eta_eq_zero_of_not_mem hm

theorem mloc_Eta_summable (h : ℝ) (z : ℝ × ℝ) : Summable fun m => monoEta h m z :=
  (mloc_Eta_hasSum h z).summable

/-- **Partition of unity** `∑_m η_m = 1` (line 945). -/
theorem mloc_Eta_tsum (h : ℝ) (z : ℝ × ℝ) : ∑' m : ℤ × ℤ, monoEta h m z = 1 :=
  (mloc_Eta_hasSum h z).tsum_eq

/-! #### Smoothness and the Lipschitz bounds `|∇η_m|, |∇χ_m| ≲ 1/h` -/

theorem mloc_Eta_contDiff (h : ℝ) (m : ℤ × ℤ) : ContDiff ℝ ∞ (monoEta h m) := by
  unfold monoEta
  exact (smoothingPartitionCutoff_contDiff.comp ((contDiff_fst.div_const h).sub contDiff_const)).mul
    (smoothingPartitionCutoff_contDiff.comp ((contDiff_snd.div_const h).sub contDiff_const))

theorem mloc_Beta_contDiff : ContDiff ℝ ∞ monoBeta :=
  monoPhi_contDiff.comp ((contDiff_const.mul contDiff_id).div_const 3)

theorem mloc_ChiM_contDiff (h : ℝ) (m : ℤ × ℤ) : ContDiff ℝ ∞ (monoChiM h m) := by
  unfold monoChiM
  exact (mloc_Beta_contDiff.comp ((contDiff_fst.div_const h).sub contDiff_const)).mul
    (mloc_Beta_contDiff.comp ((contDiff_snd.div_const h).sub contDiff_const))

theorem mloc_theta_lip : ∃ K : ℝ, 0 ≤ K ∧ ∀ x y : ℝ,
    |smoothingPartitionCutoff x - smoothingPartitionCutoff y| ≤ K * |x - y| := by
  obtain ⟨C, hC⟩ := ContDiff.lipschitzWith_of_hasCompactSupport
    smoothingPartitionCutoff_hasCompactSupport smoothingPartitionCutoff_contDiff (by simp)
  refine ⟨C, C.2, fun x y => ?_⟩
  have := hC.dist_le_mul x y
  simpa [Real.dist_eq] using this

theorem mloc_beta_lip : ∃ K : ℝ, 0 ≤ K ∧ ∀ x y : ℝ, |monoBeta x - monoBeta y| ≤ K * |x - y| := by
  obtain ⟨C, hC⟩ := ContDiff.lipschitzWith_of_hasCompactSupport
    monoPhi_hasCompactSupport monoPhi_contDiff (by simp)
  refine ⟨C * (4 / 3), by positivity, fun x y => ?_⟩
  have := hC.dist_le_mul (4 * x / 3) (4 * y / 3)
  simp only [Real.dist_eq] at this
  have e : 4 * x / 3 - 4 * y / 3 = (4 / 3) * (x - y) := by ring
  rw [e, abs_mul, abs_of_pos (by norm_num : (0:ℝ) < 4 / 3)] at this
  simp only [monoBeta]
  nlinarith [abs_nonneg (x - y)]

theorem mloc_prod_lip {g : ℝ → ℝ} {K : ℝ} (hg0 : ∀ x, 0 ≤ g x) (hg1 : ∀ x, g x ≤ 1)
    (hg : ∀ x y, |g x - g y| ≤ K * |x - y|) {h : ℝ} (hh : 0 < h) (m : ℤ × ℤ) (j : Fin 2)
    (z : ℝ × ℝ) (a : ℝ) :
    |g ((z + monoEj j a).1 / h - m.1) * g ((z + monoEj j a).2 / h - m.2) -
      g (z.1 / h - m.1) * g (z.2 / h - m.2)| ≤ K / h * |a| := by
  have key : ∀ u v c : ℝ, |g ((u + a) / h - c) * g v - g (u / h - c) * g v| ≤ K / h * |a| := by
    intro u v c
    rw [← sub_mul, abs_mul, abs_of_nonneg (hg0 v)]
    have e : (u + a) / h - c - (u / h - c) = a / h := by ring
    have := hg ((u + a) / h - c) (u / h - c)
    rw [e, abs_div, abs_of_pos hh] at this
    calc _ ≤ |g ((u + a) / h - c) - g (u / h - c)| * 1 :=
          mul_le_mul_of_nonneg_left (hg1 v) (abs_nonneg _)
      _ ≤ K * (|a| / h) := by linarith
      _ = K / h * |a| := by ring
  fin_cases j
  · simpa [monoEj, monoPt] using key z.1 (z.2 / h - m.2) m.1
  · have := key z.2 (z.1 / h - m.1) m.2
    simp only [monoEj, monoPt, Fin.mk_one, one_ne_zero, if_false, Prod.fst_add, Prod.snd_add,
      add_zero]
    rwa [mul_comm (g (z.1 / h - m.1)), mul_comm (g (z.1 / h - m.1))]

/-- The mean value bound for `η_m` in coordinate direction `j`. -/
theorem mloc_Eta_lip : ∃ C : ℝ, 0 ≤ C ∧ ∀ h : ℝ, 0 < h → ∀ (m : ℤ × ℤ) (j : Fin 2) (z : ℝ × ℝ)
    (a : ℝ), |monoEta h m (z + monoEj j a) - monoEta h m z| ≤ C / h * |a| := by
  obtain ⟨K, hK, hl⟩ := mloc_theta_lip
  exact ⟨K, hK, fun h hh m j z a =>
    mloc_prod_lip mloc_theta_nonneg mloc_theta_le_one hl hh m j z a⟩

/-- The mean value bound for `χ_m` in coordinate direction `j`. -/
theorem mloc_ChiM_lip : ∃ C : ℝ, 0 ≤ C ∧ ∀ h : ℝ, 0 < h → ∀ (m : ℤ × ℤ) (j : Fin 2) (z : ℝ × ℝ)
    (a : ℝ), |monoChiM h m (z + monoEj j a) - monoChiM h m z| ≤ C / h * |a| := by
  obtain ⟨K, hK, hl⟩ := mloc_beta_lip
  exact ⟨K, hK, fun h hh m j z a =>
    mloc_prod_lip mloc_beta_nonneg mloc_beta_le_one hl hh m j z a⟩

end

