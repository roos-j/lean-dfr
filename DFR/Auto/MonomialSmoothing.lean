theorem mfk_tri_integrable {Λ h x0 y0 t0 : ℝ} (hΛ : 0 < Λ) (hh : 0 < h) {A : (ℝ × ℝ) × ℝ → ℂ}
    (hA : MfkAmp Λ h x0 y0 t0 A) (c q : ℝ) {f g : ℝ × ℝ → ℂ} (hf : Measurable f) (hg : Measurable g)
    (hf2 : MemLp f 2 volume) (hg2 : MemLp g 2 volume) :
