/-- (3.14): the three relations combine into one relation for `ν`. -/
theorem msub_link {Γ : ℝ → ℝ × ℝ} {E : Set ((ℝ × ℝ) × ℝ)} {A B : ℝ} {qg : ℝ → ℝ}
    {a b : ℝ × ℝ → ℝ} {qm qM ε : ℝ} (hqm : 0 < qm)
    (hq : ∀ t ∈ Icc A B, qm ≤ qg t ∧ qg t ≤ qM)
    (hprop : ∀ p ∈ E, p.2 ∈ Icc A B ∧ |a p.1 - qg p.2 * b (p.1 + Γ p.2)| ≤ ε)
    {z0 : ℝ × ℝ} {t : ℝ × ℝ × ℝ} (ht : t ∈ msubA Γ E z0) :
    t ∈ msubI3 A B ∧ |a z0 * (qg t.2.1 / (qg t.1 * qg t.2.2)) -
      b (z0 + Γ t.1 - Γ t.2.1 + Γ t.2.2)| ≤ (qM / (qm * qm) + 2 / qm) * ε := by
  obtain ⟨h1, h2, h3⟩ := ht
  obtain ⟨i0, r1⟩ := hprop _ h1
  obtain ⟨i1, r2⟩ := hprop _ h2
  obtain ⟨i2, r3⟩ := hprop _ h3
  simp only at i0 i1 i2 r1 r2 r3
  refine ⟨⟨i0, i1, i2⟩, ?_⟩
  rw [sub_add_cancel] at r2
  set q0 := qg t.1
  set q1 := qg t.2.1
  set q2 := qg t.2.2
  set β1 := b (z0 + Γ t.1)
  set α' := a (z0 + Γ t.1 - Γ t.2.1)
  set β3 := b (z0 + Γ t.1 - Γ t.2.1 + Γ t.2.2)
  have p0 : qm ≤ q0 := (hq _ i0).1
  have p1 : qm ≤ q1 := (hq _ i1).1
  have p2 : qm ≤ q2 := (hq _ i2).1
  have u1 : q1 ≤ qM := (hq _ i1).2
  have q00 : 0 < q0 := lt_of_lt_of_le hqm p0
  have q10 : 0 < q1 := lt_of_lt_of_le hqm p1
  have q20 : 0 < q2 := lt_of_lt_of_le hqm p2
  have hε : 0 ≤ ε := (abs_nonneg _).trans r1
  have e : a z0 * (q1 / (q0 * q2)) - β3 = (a z0 - q0 * β1) * q1 / (q0 * q2) -
      (α' - q1 * β1) / q2 + (α' - q2 * β3) / q2 := by
    field_simp; ring
  rw [e]
  have b1 : |(a z0 - q0 * β1) * q1 / (q0 * q2)| ≤ qM / (qm * qm) * ε := by
    rw [abs_div, abs_mul, abs_of_pos q10, abs_of_pos (mul_pos q00 q20),
      div_le_iff₀ (mul_pos q00 q20)]
    have hqq : qm * qm ≤ q0 * q2 := mul_le_mul p0 p2 hqm.le q00.le
    have hk : 0 ≤ qM / (qm * qm) * ε := by
      have : 0 < qM := lt_of_lt_of_le q10 u1
      positivity
    calc |a z0 - q0 * β1| * q1 ≤ ε * qM := mul_le_mul r1 u1 q10.le hε
      _ = qM / (qm * qm) * ε * (qm * qm) := by field_simp
      _ ≤ qM / (qm * qm) * ε * (q0 * q2) := mul_le_mul_of_nonneg_left hqq hk
  have b2 : |(α' - q1 * β1) / q2| ≤ ε / qm := by
    rw [abs_div, abs_of_pos q20]
    exact div_le_div₀ hε r2 hqm p2
  have b3 : |(α' - q2 * β3) / q2| ≤ ε / qm := by
    rw [abs_div, abs_of_pos q20]
    exact div_le_div₀ hε r3 hqm p2
  calc |(a z0 - q0 * β1) * q1 / (q0 * q2) - (α' - q1 * β1) / q2 + (α' - q2 * β3) / q2|
      ≤ |(a z0 - q0 * β1) * q1 / (q0 * q2) - (α' - q1 * β1) / q2| +
          |(α' - q2 * β3) / q2| := abs_add_le _ _
    _ ≤ |(a z0 - q0 * β1) * q1 / (q0 * q2)| + |(α' - q1 * β1) / q2| +
          |(α' - q2 * β3) / q2| := by gcongr; exact abs_sub _ _
    _ ≤ qM / (qm * qm) * ε + ε / qm + ε / qm := by gcongr
    _ = (qM / (qm * qm) + 2 / qm) * ε := by ring

/-- One case of Lemma 3.1, reduced to a sublevel estimate for `ν`. -/
theorem msub_case {Γ : ℝ → ℝ × ℝ} (hΓ : Measurable Γ) {E : Set ((ℝ × ℝ) × ℝ)}
    (hE : MeasurableSet E) {D0 D1 : Set (ℝ × ℝ)} (hD0 : MeasurableSet D0)
    (hD1 : MeasurableSet D1) (hD0f : volume D0 ≠ ∞) (hD1f : volume D1 ≠ ∞)
    (hD0p : 0 < (volume D0).toReal) (hD1p : 0 < (volume D1).toReal)
    (hE0 : ∀ p ∈ E, p.1 ∈ D0) (hE1 : ∀ p ∈ E, p.1 + Γ p.2 ∈ D1) (hEf : volume E ≠ ∞)
    {A B : ℝ} {qg : ℝ → ℝ} {a b : ℝ × ℝ → ℝ} {qm qM ε : ℝ} (hqm : 0 < qm)
    (hq : ∀ t ∈ Icc A B, qm ≤ qg t ∧ qg t ≤ qM)
    (hprop : ∀ p ∈ E, p.2 ∈ Icc A B ∧ |a p.1 - qg p.2 * b (p.1 + Γ p.2)| ≤ ε)
    {y : ℝ} (hy : 0 ≤ y)
    (hsub : ∀ z0 : ℝ × ℝ, volume {t | t ∈ msubI3 A B ∧ |a z0 * (qg t.2.1 / (qg t.1 * qg t.2.2)) -
      b (z0 + Γ t.1 - Γ t.2.1 + Γ t.2.2)| ≤ (qM / (qm * qm) + 2 / qm) * ε} ≤ ENNReal.ofReal y) :
    (volume E).toReal ^ 3 ≤ 32 * (volume D0).toReal ^ 2 * (volume D1).toReal * y :=
  msub_P3 hΓ hE hD0 hD1 hD0f hD1f hD0p hD1p hE0 hE1 hEf hy fun z0 _ =>
    (measure_mono fun _ ht => msub_link hqm hq hprop ht).trans (hsub z0)

theorem msub_final_alg {x K ε : ℝ} (hx : 0 ≤ x) (hK : 0 ≤ K) (hε : 0 < ε)
    (h : x ^ 3 ≤ K * ε ^ (1 / 13 : ℝ)) : x ≤ K ^ (1 / 3 : ℝ) * ε ^ (1 / 39 : ℝ) := by
  have h1 : x = (x ^ 3) ^ (1 / 3 : ℝ) := by
    rw [show (1 / 3 : ℝ) = ((3 : ℕ) : ℝ)⁻¹ by norm_num, Real.pow_rpow_inv_natCast hx (by norm_num)]
  rw [h1]
  calc (x ^ 3) ^ (1 / 3 : ℝ) ≤ (K * ε ^ (1 / 13 : ℝ)) ^ (1 / 3 : ℝ) :=
        Real.rpow_le_rpow (by positivity) h (by norm_num)
    _ = K ^ (1 / 3 : ℝ) * ε ^ (1 / 39 : ℝ) := by
        rw [Real.mul_rpow hK (by positivity), ← Real.rpow_mul hε.le]; norm_num

end
end Auto

