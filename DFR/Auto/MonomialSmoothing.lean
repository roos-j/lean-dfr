/-- **The sharp--sharp term (6.12)-(6.16)**, blueprint `task_1_smoothing_inequality_2.tex`,
lines 1080-1151. -/
theorem mss_sharpsharp {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) (χ : ℝ × ℝ → ℝ)
    (hχ : ContDiff ℝ ∞ χ) (hχc : HasCompactSupport χ) (C0 c1 : ℝ) (hC0 : 1 ≤ C0) (hc1 : 0 < c1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ ψ : ℝ → ℝ, ContDiff ℝ ∞ ψ → tsupport ψ ⊆ Set.Icc A B → monoC20 ψ ≤ 1 →
    ∀ (h R S L : ℝ) (N : ℕ), 0 < h → h ≤ 1 → 1 ≤ R * h → 0 < S → 2 * S ≤ L →
    ∀ (M₁ M₂ : Finset (ℤ × ℤ)) (H₁ H₂ : ℤ × ℤ → ℕ → ℝ × ℝ → ℂ) (ω₁ ω₂ : ℤ × ℤ → ℕ → ℝ → ℝ),
      (∀ m ν, Measurable (H₁ m ν)) → (∀ m ν, Measurable (H₂ m ν)) →
