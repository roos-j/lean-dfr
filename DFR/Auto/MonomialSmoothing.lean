/-! ### (2.3)-(2.5): the modulated pieces (lines 277-284) -/

/-- The unmodulated scaled kernel `K_R(u) = R κ(R u)`. -/
def monoKR (R : ℝ) (u : ℝ) : ℂ := (R : ℂ) * monoKappa (R * u)

/-- Its derivative `K_R'(u) = R^2 κ'(R u)`. -/
def monoKR' (R : ℝ) (u : ℝ) : ℂ := (R : ℂ) ^ 2 * deriv monoKappa (R * u)

theorem hasDerivAt_monoKR (R u : ℝ) : HasDerivAt (monoKR R) (monoKR' R u) u := by
  have h1 : HasDerivAt (fun u : ℝ => R * u) R u := by simpa using (hasDerivAt_id u).const_mul R
  have h2 := (monoKappa.differentiableAt (x := R * u)).hasDerivAt.scomp u h1
  have h3 := h2.const_mul (R : ℂ)
  have h4 : HasDerivAt (monoKR R) ((R : ℂ) * ((R : ℂ) * deriv (monoKappa : ℝ → ℂ) (R * u))) u := by
    have := h3
    simp only [Function.comp_def, Complex.real_smul] at this
    exact this
  convert h4 using 1
  rw [monoKR']; ring

theorem continuous_monoKR' (R : ℝ) : Continuous (monoKR' R) := by
  unfold monoKR'
  have : Continuous (deriv (monoKappa : ℝ → ℂ)) := (monoKappa.smooth 1).continuous_deriv le_rfl
  exact continuous_const.mul (this.comp (continuous_const.mul continuous_id))

theorem monoKR_decay {R : ℝ} (hR : 1 ≤ R) : ∃ C : ℝ, 0 ≤ C ∧ ∀ u, ‖monoKR R u‖ ≤ C / (1 + |u|) ^ 2 := by
  obtain ⟨C, hC, h⟩ := mono_schwartz_decay_two monoKappa
  refine ⟨R * C, by positivity, fun u => ?_⟩
  have hR0 : 0 < R := by linarith
  rw [monoKR, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hR0]
  have hu : 1 + |u| ≤ 1 + |R * u| := by rw [abs_mul, abs_of_pos hR0]; nlinarith [abs_nonneg u]
  calc R * ‖monoKappa (R * u)‖ ≤ R * (C / (1 + |R * u|) ^ 2) :=
        mul_le_mul_of_nonneg_left (h _) hR0.le
    _ ≤ R * (C / (1 + |u|) ^ 2) :=
        mul_le_mul_of_nonneg_left (div_le_div_of_nonneg_left hC (by positivity)
          (pow_le_pow_left₀ (by positivity) hu 2)) hR0.le
    _ = R * C / (1 + |u|) ^ 2 := by ring

theorem monoKR'_decay {R : ℝ} (hR : 1 ≤ R) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ u, ‖monoKR' R u‖ ≤ C / (1 + |u|) ^ 2 := by
  obtain ⟨C, hC, h⟩ := mono_schwartz_decay_two (SchwartzMap.derivCLM ℝ ℂ monoKappa)
  refine ⟨R ^ 2 * C, by positivity, fun u => ?_⟩
  have hR0 : 0 < R := by linarith
  rw [monoKR', norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hR0]
  have h' : ‖deriv (monoKappa : ℝ → ℂ) (R * u)‖ ≤ C / (1 + |R * u|) ^ 2 := by
    simpa [SchwartzMap.derivCLM_apply] using h (R * u)
  have hu : 1 + |u| ≤ 1 + |R * u| := by rw [abs_mul, abs_of_pos hR0]; nlinarith [abs_nonneg u]
  calc R ^ 2 * ‖deriv (monoKappa : ℝ → ℂ) (R * u)‖ ≤ R ^ 2 * (C / (1 + |R * u|) ^ 2) :=
        mul_le_mul_of_nonneg_left h' (by positivity)
    _ ≤ R ^ 2 * (C / (1 + |u|) ^ 2) :=
        mul_le_mul_of_nonneg_left (div_le_div_of_nonneg_left hC (by positivity)
          (pow_le_pow_left₀ (by positivity) hu 2)) (by positivity)
    _ = R ^ 2 * C / (1 + |u|) ^ 2 := by ring

/-- `∫ ‖K_R(x - t)‖ dt = ∫ ‖κ‖`. -/
theorem integral_norm_monoKR {R : ℝ} (hR : 0 < R) (x : ℝ) :
    ∫ t, ‖monoKR R (x - t)‖ = ∫ u, ‖monoKappa u‖ := by
  have h1 : ∫ t, ‖monoKR R (x - t)‖ = ∫ t, ‖monoKR R t‖ :=
    integral_sub_left_eq_self (fun t => ‖monoKR R t‖) (μ := volume) x
  rw [h1]
  simp only [monoKR, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hR]
  rw [integral_const_mul, Measure.integral_comp_mul_left (fun u => ‖monoKappa u‖) R, abs_inv,
    abs_of_pos hR, smul_eq_mul, ← mul_assoc, mul_inv_cancel₀ hR.ne', one_mul]

/-- `∫ ‖K_R'(x - t)‖ dt = R ∫ ‖κ'‖`. -/
theorem integral_norm_monoKR' {R : ℝ} (hR : 0 < R) (x : ℝ) :
    ∫ t, ‖monoKR' R (x - t)‖ = R * ∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖ := by
  have h1 : ∫ t, ‖monoKR' R (x - t)‖ = ∫ t, ‖monoKR' R t‖ :=
    integral_sub_left_eq_self (fun t => ‖monoKR' R t‖) (μ := volume) x
  rw [h1]
  simp only [monoKR', norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hR]
  rw [integral_const_mul, Measure.integral_comp_mul_left (fun u => ‖deriv (monoKappa : ℝ → ℂ) u‖) R,
    abs_inv, abs_of_pos hR, smul_eq_mul]
  field_simp

theorem integrable_norm_monoKR {R : ℝ} (hR : 0 < R) (x : ℝ) :
    Integrable (fun t => ‖monoKR R (x - t)‖) volume := by
  have h := ((integrable_scaled_schwartz monoKappa hR).comp_sub_left x).norm
  simpa [monoKR, Function.comp_def] using h

theorem integrable_norm_monoKR' {R : ℝ} (hR : 0 < R) (x : ℝ) :
    Integrable (fun t => ‖monoKR' R (x - t)‖) volume := by
  have h := ((integrable_scaled_schwartz (SchwartzMap.derivCLM ℝ ℂ monoKappa) hR).comp_sub_left x).norm
  have h2 := h.const_mul R
  refine h2.congr (Eventually.of_forall fun t => ?_)
  simp only [Function.comp_apply, monoKR', SchwartzMap.derivCLM_apply, norm_mul, norm_pow,
    Complex.norm_real, Real.norm_eq_abs, abs_of_pos hR]
  ring

/-- The demodulated piece `h_n(x) = ∫ K_R(x - t) e^{-2πinRt} F(t) dt`, so that
`ϑ(D/R - n) F (x) = h_n(x) e^{2πi nR x}` (2.3). -/
def monoH (R : ℝ) (n : ℤ) (F : ℝ → ℂ) (x : ℝ) : ℂ :=
  ∫ t, monoKR R (x - t) * ((𝐞 (-(n * R * t)) : Circle) * F t)

/-- `h_n'(x) = ∫ K_R'(x - t) e^{-2πinRt} F(t) dt`. -/
def monoH' (R : ℝ) (n : ℤ) (F : ℝ → ℂ) (x : ℝ) : ℂ :=
  ∫ t, monoKR' R (x - t) * ((𝐞 (-(n * R * t)) : Circle) * F t)

theorem monoPiece_eq_monoH (R : ℝ) (n : ℤ) (F : ℝ → ℂ) (x : ℝ) :
    monoPiece R n F x = monoH R n F x * (𝐞 (n * R * x) : Circle) := by
  rw [monoPiece, convolution_eq_swap, monoH, ← integral_mul_const]
  refine integral_congr_ae (Eventually.of_forall fun t => ?_)
  simp only [ContinuousLinearMap.mul_apply', monoKn, monoKR]
  have : ((𝐞 (n * R * (x - t)) : Circle) : ℂ) = (𝐞 (-(n * R * t)) : Circle) * (𝐞 (n * R * x) : Circle) := by
    rw [← Circle.coe_mul, ← AddChar.map_add_eq_mul]; congr 2; ring
  rw [show R * (x - t) = R * (x - t) from rfl, this]
  ring

theorem aesm_modF {R : ℝ} {n : ℤ} {F : ℝ → ℂ} (hF : AEStronglyMeasurable F volume) :
    AEStronglyMeasurable (fun t => ((𝐞 (-(n * R * t)) : Circle) : ℂ) * F t) volume :=
  (Continuous.aestronglyMeasurable (by fun_prop)).mul hF

theorem norm_modF_le {R : ℝ} {n : ℤ} {F : ℝ → ℂ} {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) (t : ℝ) :
    ‖((𝐞 (-(n * R * t)) : Circle) : ℂ) * F t‖ ≤ M := by
  rw [norm_mul, Circle.norm_coe, one_mul]; exact hM t

/-- `h_n` is differentiable with derivative `h_n'` (2.4 with `k = 1`). -/
theorem hasDerivAt_monoH {R : ℝ} (hR : 1 ≤ R) (n : ℤ) {F : ℝ → ℂ}
    (hF : AEStronglyMeasurable F volume) {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) (x : ℝ) :
    HasDerivAt (monoH R n F) (monoH' R n F x) x := by
  obtain ⟨C0, _, h0⟩ := monoKR_decay hR
  obtain ⟨C1, _, h1⟩ := monoKR'_decay hR
  exact hasDerivAt_conv_bdd (hasDerivAt_monoKR R) (continuous_monoKR' R) h0 h1 (aesm_modF hF)
    (norm_modF_le hM) x

/-- **(2.4), `k = 0`**: `‖h_n‖_∞ ≤ ‖κ‖_1 ‖F‖_∞`. -/
theorem norm_monoH_le {R : ℝ} (hR : 0 < R) (n : ℤ) {F : ℝ → ℂ} (hF : AEStronglyMeasurable F volume)
    {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) (x : ℝ) :
    ‖monoH R n F x‖ ≤ (∫ u, ‖monoKappa u‖) * M := by
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  unfold monoH
  refine (norm_integral_le_integral_norm _).trans ?_
  calc ∫ t, ‖monoKR R (x - t) * ((𝐞 (-(n * R * t)) : Circle) * F t)‖
      ≤ ∫ t, ‖monoKR R (x - t)‖ * M := by
        refine integral_mono_of_nonneg (Eventually.of_forall fun t => norm_nonneg _)
          ((integrable_norm_monoKR hR x).mul_const M) (Eventually.of_forall fun t => ?_)
        dsimp only
        rw [norm_mul]
        exact mul_le_mul_of_nonneg_left (norm_modF_le hM t) (norm_nonneg _)
    _ = (∫ u, ‖monoKappa u‖) * M := by rw [integral_mul_const, integral_norm_monoKR hR]

/-- **(2.4), `k = 1`**: `‖h_n'‖_∞ ≤ R ‖κ'‖_1 ‖F‖_∞`. -/
theorem norm_monoH'_le {R : ℝ} (hR : 0 < R) (n : ℤ) {F : ℝ → ℂ} (hF : AEStronglyMeasurable F volume)
    {M : ℝ} (hM : ∀ t, ‖F t‖ ≤ M) (x : ℝ) :
    ‖monoH' R n F x‖ ≤ R * (∫ u, ‖deriv (monoKappa : ℝ → ℂ) u‖) * M := by
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  unfold monoH'
  refine (norm_integral_le_integral_norm _).trans ?_
  calc ∫ t, ‖monoKR' R (x - t) * ((𝐞 (-(n * R * t)) : Circle) * F t)‖
      ≤ ∫ t, ‖monoKR' R (x - t)‖ * M := by
