theorem mnst_indicator_intervalIntegrable {c d S : ℝ} {H : ℝ → ℂ} {φ' : ℝ → ℝ} (hcd : c ≤ d)
    (hHc : ContinuousOn H (Icc c d)) (hφ'c : ContinuousOn φ' (Icc c d)) :
    IntervalIntegrable (fun t => Set.indicator {t | |φ' t| ≤ 2 * S} (fun t => ‖H t‖) t)
      volume c d := by
  set ψ : ℝ → ℝ := fun t => φ' (Set.projIcc c d hcd t) with hψ
  have hψc : Continuous ψ :=
    hφ'c.comp_continuous (continuous_subtype_val.comp continuous_projIcc) (fun t => (Set.projIcc c d hcd t).2)
  have hmeas : MeasurableSet {t | |ψ t| ≤ 2 * S} :=
    (isClosed_le (continuous_abs.comp hψc) continuous_const).measurableSet
  have h1 : IntegrableOn (Set.indicator {t | |ψ t| ≤ 2 * S} (fun t => ‖H t‖)) (Icc c d) :=
    (hHc.norm.integrableOn_Icc).indicator hmeas
  have h2 := h1.congr_fun (g := fun t => Set.indicator {t | |φ' t| ≤ 2 * S} (fun t => ‖H t‖) t)
    (by
      intro t ht
      have : ψ t = φ' t := by simp [hψ, Set.projIcc_of_mem hcd ht]
      simp only [Set.indicator, mem_setOf_eq, this]) measurableSet_Icc
  exact (intervalIntegrable_iff_integrableOn_Icc_of_le hcd).2 h2

theorem mnst_cont_integrand {c d : ℝ} {H : ℝ → ℂ} {φ : ℝ → ℝ}
    (hHc : ContinuousOn H (Icc c d)) (hφc : ContinuousOn φ (Icc c d)) :
    ContinuousOn (fun t => Complex.exp (2 * Real.pi * Complex.I * φ t) * H t) (Icc c d) :=
  (Complex.continuous_exp.comp_continuousOn
    (continuousOn_const.mul (Complex.continuous_ofReal.comp_continuousOn hφc))).mul hHc

/-- The piece where `|φ'| ≤ 2S`. -/
theorem mnst_mid {c d a b S : ℝ} {H : ℝ → ℂ} {φ φ' : ℝ → ℝ} (hca : c ≤ a) (hab : a ≤ b)
    (hbd : b ≤ d) (hHc : ContinuousOn H (Icc c d)) (hφ'c : ContinuousOn φ' (Icc c d))
    (hmid : ∀ t ∈ Ioo a b, |φ' t| ≤ 2 * S) :
    ‖∫ t in a..b, Complex.exp (2 * Real.pi * Complex.I * φ t) * H t‖
      ≤ ∫ t in c..d, Set.indicator {t | |φ' t| ≤ 2 * S} (fun t => ‖H t‖) t := by
  refine (intervalIntegral.norm_integral_le_integral_norm hab).trans ?_
  have e1 : ∫ t in a..b, ‖Complex.exp (2 * Real.pi * Complex.I * φ t) * H t‖
      = ∫ t in a..b, Set.indicator {t | |φ' t| ≤ 2 * S} (fun t => ‖H t‖) t := by
    rw [intervalIntegral.integral_of_le hab, intervalIntegral.integral_of_le hab,
      integral_Ioc_eq_integral_Ioo, integral_Ioc_eq_integral_Ioo]
    apply setIntegral_congr_fun measurableSet_Ioo
    intro t ht
    dsimp only; rw [norm_mul, mnst_norm_expPhase, one_mul]
    simp only [Set.indicator, mem_setOf_eq, hmid t ht, if_true]
  rw [e1]
  exact integral_mono_interval hca hab hbd
    (Filter.Eventually.of_forall fun t => Set.indicator_nonneg (fun _ _ => norm_nonneg _) t)
    (mnst_indicator_intervalIntegrable (hca.trans (hab.trans hbd)) hHc hφ'c)

theorem mnst_norm_int_mono {c d a b : ℝ} {H' : ℝ → ℂ} (hca : c ≤ a) (hab : a ≤ b)
    (hbd : b ≤ d) (hH' : ContinuousOn H' (Icc c d)) :
    ∫ t in a..b, ‖H' t‖ ≤ ∫ t in c..d, ‖H' t‖ :=
  integral_mono_interval hca hab hbd (Filter.Eventually.of_forall fun t => norm_nonneg _)
    (hH'.norm.intervalIntegrable_of_Icc (hca.trans (hab.trans hbd)))

end

end Auto

