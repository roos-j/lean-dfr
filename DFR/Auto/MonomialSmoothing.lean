/-- Sign of the derivative of a monotone/antitone function on `[a,b]`. -/
theorem mnst_deriv_sign {a b : ℝ} {f f' : ℝ → ℝ} (hab : a < b)
    (hf : ∀ t ∈ Icc a b, HasDerivAt f (f' t) t) :
    (MonotoneOn f (Icc a b) → ∀ t ∈ Icc a b, 0 ≤ f' t) ∧
    (AntitoneOn f (Icc a b) → ∀ t ∈ Icc a b, f' t ≤ 0) := by
  have hacc : ∀ t ∈ Icc a b, AccPt t (Filter.principal (Icc a b)) := fun t ht =>
    uniqueDiffWithinAt_iff_accPt.1 (uniqueDiffOn_Icc hab t ht)
  exact ⟨fun hm t ht => (hf t ht).hasDerivWithinAt.nonneg_of_monotoneOn (hacc t ht) hm,
    fun hm t ht => (hf t ht).hasDerivWithinAt.nonpos_of_antitoneOn (hacc t ht) hm⟩

/-- `∫ |(1/φ')'| ≤ 1/(2S)` when `φ'` is monotone and `|φ'| ≥ 2S` with constant sign. -/
theorem mnst_int_abs_inv_deriv {a b : ℝ} {φ' φ'' : ℝ → ℝ} {S : ℝ} (hab : a ≤ b)
    (hφ' : ∀ t ∈ Icc a b, HasDerivAt φ' (φ'' t) t) (hφ'' : ContinuousOn φ'' (Icc a b))
    (hmono : MonotoneOn φ' (Icc a b) ∨ AntitoneOn φ' (Icc a b)) (hS : 0 < S)
    (hsgn : (∀ t ∈ Icc a b, 2 * S ≤ φ' t) ∨ (∀ t ∈ Icc a b, φ' t ≤ -(2 * S))) :
    ∫ t in a..b, |φ'' t / φ' t ^ 2| ≤ 1 / (2 * S) := by
  rcases hab.eq_or_lt with h | hlt
  · subst h; simp; positivity
  have hne : ∀ t ∈ Icc a b, φ' t ≠ 0 := by
    intro t ht; rcases hsgn with h | h
    · have := h t ht; intro h0; linarith
    · have := h t ht; intro h0; linarith
  have hφ'c : ContinuousOn φ' (Icc a b) := fun t ht => (hφ' t ht).continuousAt.continuousWithinAt
  have hcont : ContinuousOn (fun t => φ'' t / φ' t ^ 2) (Icc a b) :=
    hφ''.div (hφ'c.pow 2) (fun t ht => pow_ne_zero 2 (hne t ht))
  have hFTC : ∫ t in a..b, φ'' t / φ' t ^ 2 = (-(φ' b)⁻¹) - (-(φ' a)⁻¹) := by
    apply integral_eq_sub_of_hasDerivAt (f := fun t => -(φ' t)⁻¹)
    · intro t ht
      rw [uIcc_of_le hab] at ht
      exact (((hφ' t ht).inv (hne t ht)).neg).congr_deriv (by ring)
    · exact (hcont.mono (by rw [uIcc_of_le hab])).intervalIntegrable
  have hdiff : |(φ' a)⁻¹ - (φ' b)⁻¹| ≤ 1 / (2 * S) := by
    have ha : a ∈ Icc a b := ⟨le_rfl, hab⟩
    have hb : b ∈ Icc a b := ⟨hab, le_rfl⟩
    rcases hsgn with h | h
    · have h1 : ∀ t ∈ Icc a b, 0 < (φ' t)⁻¹ ∧ (φ' t)⁻¹ ≤ 1 / (2 * S) := fun t ht =>
        ⟨inv_pos.2 (by linarith [h t ht]), by
          rw [one_div]; exact inv_anti₀ (by positivity) (h t ht)⟩
      obtain ⟨p1, p2⟩ := h1 a ha; obtain ⟨q1, q2⟩ := h1 b hb
      rw [abs_le]; constructor <;> linarith
    · have h1 : ∀ t ∈ Icc a b, 0 < (-φ' t)⁻¹ ∧ (-φ' t)⁻¹ ≤ 1 / (2 * S) := fun t ht =>
        ⟨inv_pos.2 (by linarith [h t ht]), by
          rw [one_div]; exact inv_anti₀ (by positivity) (by linarith [h t ht])⟩
      obtain ⟨p1, p2⟩ := h1 a ha; obtain ⟨q1, q2⟩ := h1 b hb
      rw [inv_neg] at p1 p2 q1 q2
      rw [abs_le]; constructor <;> linarith
  obtain ⟨hm, ha⟩ := mnst_deriv_sign hlt hφ'
  rcases hmono with h | h
  · have : ∫ t in a..b, |φ'' t / φ' t ^ 2| = ∫ t in a..b, φ'' t / φ' t ^ 2 := by
      apply integral_congr
      intro t ht; rw [uIcc_of_le hab] at ht
      exact abs_of_nonneg (div_nonneg (hm h t ht) (sq_nonneg _))
    rw [this, hFTC]
    have := (abs_le.1 hdiff).1; have := (abs_le.1 hdiff).2
    linarith
  · have : ∫ t in a..b, |φ'' t / φ' t ^ 2| = -∫ t in a..b, φ'' t / φ' t ^ 2 := by
      rw [← intervalIntegral.integral_neg]
      apply integral_congr
      intro t ht; rw [uIcc_of_le hab] at ht
      exact abs_of_nonpos (div_nonpos_of_nonpos_of_nonneg (ha h t ht) (sq_nonneg _))
    rw [this, hFTC]
    have := (abs_le.1 hdiff).1; have := (abs_le.1 hdiff).2
    linarith

end

end Auto

end

