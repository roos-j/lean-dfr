namespace Auto

noncomputable section

/-! ### Lc07: squaring, `|∫F|^2 = ∫∫ F(t+s) \bar{F(t)} ds dt` -/

/-- The squared integrand `F(z,t+s) \bar{F(z,t)}` on `((z,t),s)`. -/
def mlcPhi (r : ℝ) (ψ : ℝ → ℝ) (u₁ u₂ : ℝ × ℝ → ℂ) (p : ((ℝ × ℝ) × ℝ) × ℝ) : ℂ :=
  mlcF r ψ u₁ u₂ p.1.1 (p.1.2 + p.2) * star (mlcF r ψ u₁ u₂ p.1.1 p.1.2)

namespace MlcPair

variable {r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb : ℝ} {ψ : ℝ → ℝ} {u₁ u₂ : ℝ × ℝ → ℂ}

theorem meas_Phi (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) :
    Measurable (mlcPhi r ψ u₁ u₂) := by
  unfold mlcPhi
  refine Measurable.mul ?_ (continuous_star.measurable.comp ?_)
  · exact P.meas_F.comp ((measurable_fst.comp measurable_fst).prodMk
      ((measurable_snd.comp measurable_fst).add measurable_snd))
  · exact P.meas_F.comp measurable_fst

theorem integrable_Phi (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) :
    Integrable (mlcPhi r ψ u₁ u₂) := by
  have hS : IsCompact ((mlcBox a₂ b₁ (C0 * h) ×ˢ Icc A B) ×ˢ Icc (A - B) (B - A)) :=
    ((isCompact_Icc.prod isCompact_Icc).prod isCompact_Icc).prod isCompact_Icc
  refine mlc_integrable_of_bdd hS.isClosed.measurableSet hS.measure_lt_top.ne
    P.meas_Phi.aestronglyMeasurable (M := B₁ * B₂ * (B₁ * B₂)) (fun p => ?_) (fun p hp => ?_)
  · unfold mlcPhi
    rw [norm_mul, norm_star]
    exact mul_le_mul (P.norm_F_le _ _) (P.norm_F_le _ _) (norm_nonneg _)
      (mul_nonneg P.B₁_nonneg P.B₂_nonneg)
  · unfold mlcPhi at hp
    have h1 : mlcF r ψ u₁ u₂ p.1.1 (p.1.2 + p.2) ≠ 0 := left_ne_zero_of_mul hp
    have h2 : mlcF r ψ u₁ u₂ p.1.1 p.1.2 ≠ 0 := by
      intro h0; apply hp; rw [h0, star_zero, mul_zero]
    obtain ⟨e1, -, -, -⟩ := P.F_ne_zero h1
    obtain ⟨e2, e3, e4, -⟩ := P.F_ne_zero h2
    refine ⟨⟨mem_mlcBox ⟨e3, e4⟩, e2⟩, ?_, ?_⟩
    · linarith [e1.1, e2.2]
    · linarith [e1.2, e2.1]

/-- `T(z) \bar{T(z)} = ∫∫ Φ`. -/
theorem T_mul_star (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) (z : ℝ × ℝ) :
    monoT r ψ u₁ u₂ z * star (monoT r ψ u₁ u₂ z) = ∫ t, ∫ s, mlcPhi r ψ u₁ u₂ ((z, t), s) := by
  rw [monoT_eq_mlcF]
  have hc : star (∫ t, mlcF r ψ u₁ u₂ z t) = ∫ t, star (mlcF r ψ u₁ u₂ z t) :=
    (integral_conj (f := mlcF r ψ u₁ u₂ z)).symm
  rw [hc, ← integral_const_mul]
  refine integral_congr_ae (Eventually.of_forall fun t => ?_)
  simp only [mlcPhi]
  rw [← integral_mul_const]
  exact (integral_add_left_eq_self (fun t' => mlcF r ψ u₁ u₂ z t' * star (mlcF r ψ u₁ u₂ z t)) t).symm

/-- **Step 2**: `‖T‖_2^2 = |∫ Φ|`. -/
theorem step2 (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) :
    ∫⁻ z, ‖monoT r ψ u₁ u₂ z‖ₑ ^ 2 = ‖∫ p, mlcPhi r ψ u₁ u₂ p‖ₑ := by
  have hΦ := P.integrable_Phi
  have hF : ∫ p, mlcPhi r ψ u₁ u₂ p = ∫ z, ∫ t, ∫ s, mlcPhi r ψ u₁ u₂ ((z, t), s) := by
    rw [Measure.volume_eq_prod, integral_prod _ (by rw [← Measure.volume_eq_prod]; exact hΦ)]
    rw [Measure.volume_eq_prod, integral_prod]
    rw [← Measure.volume_eq_prod]
    exact hΦ.integral_prod_left
  have hT : ∀ z, monoT r ψ u₁ u₂ z * star (monoT r ψ u₁ u₂ z) = ((‖monoT r ψ u₁ u₂ z‖ ^ 2 : ℝ) : ℂ) := by
    intro z
    have := Complex.mul_conj (monoT r ψ u₁ u₂ z)
    rw [Complex.normSq_eq_norm_sq] at this
    exact this
  rw [hF]
  simp_rw [← P.T_mul_star, hT]
  rw [integral_complex_ofReal, monoEnorm_ofReal, Real.enorm_of_nonneg (integral_nonneg fun z => by positivity)]
  rw [mfk_lintegral_sq_eq_ofReal (P.loc_T.memLp 2)]

end MlcPair

end

