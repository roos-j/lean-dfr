namespace Auto

noncomputable section

/-! ### Lc08: tangent replacement (5.7) -/

/-- The main term after replacing `Q` by its tangent at `t̄`, with the cutoff `ζ` inserted. -/
def mlcPhiM (r : ℝ) (ψ : ℝ → ℝ) (C0 h a₁ b₁ a₂ tb : ℝ) (u₁ u₂ : ℝ × ℝ → ℂ)
    (p : ((ℝ × ℝ) × ℝ) × ℝ) : ℂ :=
  mlcD1 u₁ p.2 (p.1.1.1 + p.1.2, p.1.1.2) *
    mlcD2 u₂ (monoq r tb * p.2)
      (p.1.1.1, p.1.1.2 + (monoQ r tb - monoq r tb * tb) + monoq r tb * p.1.2) *
    mlcAmp ψ C0 h a₂ b₁ (a₁ - a₂) p.2 p.1

/-- The support of the error term. -/
def mlcSerr (C0 h a₁ b₁ a₂ : ℝ) : Set (((ℝ × ℝ) × ℝ) × ℝ) :=
  (mlcBox a₂ b₁ (C0 * h) ×ˢ Icc (a₁ - a₂ - 2 * (C0 * h)) (a₁ - a₂ + 2 * (C0 * h))) ×ˢ
    Icc (-(2 * (C0 * h))) (2 * (C0 * h))

/-- The pointwise error constant `B₁² B₂² L M (52 C0² h²)`. -/
def mlcKe (r A B C0 h L B₁ B₂ : ℝ) : ℝ := B₁ ^ 2 * B₂ ^ 2 * L * (mlcMq r A B * (52 * (C0 * h) ^ 2))

namespace MlcPair

variable {r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb : ℝ} {ψ : ℝ → ℝ} {u₁ u₂ : ℝ × ℝ → ℂ}

theorem lip₂' (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) (x w w' : ℝ) :
    ‖u₂ (x, w) - u₂ (x, w')‖ ≤ B₂ * L * |w - w'| := by
  have := P.lip₂ (x, w') (w - w')
  rwa [show (x, w') + ((0 : ℝ), w - w') = (x, w) from Prod.ext (by simp) (by simp)] at this

theorem u₂_eq_zero (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) {x : ℝ}
    (hx : ¬ |x - a₂| ≤ C0 * h) (w : ℝ) : u₂ (x, w) = 0 := by
  by_contra h0; exact hx (P.hu₂.2.2 _ h0).1

theorem err_pointwise (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂)
    (p : ((ℝ × ℝ) × ℝ) × ℝ) :
    ‖mlcPhi r ψ u₁ u₂ p - mlcPhiM r ψ C0 h a₁ b₁ a₂ tb u₁ u₂ p‖ ≤
      (mlcSerr C0 h a₁ b₁ a₂).indicator (fun _ => mlcKe r A B C0 h L B₁ B₂) p := by
  obtain ⟨⟨⟨x, y⟩, t⟩, s⟩ := p
  have hKe : 0 ≤ mlcKe r A B C0 h L B₁ B₂ := by
    unfold mlcKe
    have := mlcMq_nonneg P.hr P.hA P.hAB
    have := P.hL
    positivity
  have hass : x + t + s = x + (t + s) := by ring
  by_cases H : u₁ (x + t, y) ≠ 0 ∧ u₁ (x + (t + s), y) ≠ 0 ∧ ψ t ≠ 0 ∧ ψ (t + s) ≠ 0 ∧
      |x - a₂| ≤ C0 * h
  · obtain ⟨H1, H2, H3, H4, H5⟩ := H
    have e1 := P.hu₁.2.2 _ H1
    have e2 := P.hu₁.2.2 _ H2
    simp only at e1 e2
    have ht := P.psi_mem H3
    have hts := P.psi_mem H4
    have hR : 0 < C0 * h := mul_pos (by linarith [P.hC0]) P.hh
    obtain ⟨e1a, e1b⟩ := e1
    obtain ⟨e2a, -⟩ := e2
    rw [abs_le] at e1a e1b e2a H5
    have htt0 : |t - (a₁ - a₂)| ≤ 2 * (C0 * h) := by rw [abs_le]; constructor <;> linarith
    have hs : |s| ≤ 2 * (C0 * h) := by rw [abs_le]; constructor <;> linarith
    have hmem : (((x, y), t), s) ∈ mlcSerr C0 h a₁ b₁ a₂ := by
      refine ⟨⟨mem_mlcBox ⟨abs_le.mpr H5, abs_le.mpr e1b⟩, ?_, ?_⟩, ?_, ?_⟩
      · linarith [(abs_le.mp htt0).1]
      · linarith [(abs_le.mp htt0).2]
      · linarith [(abs_le.mp hs).1]
      · linarith [(abs_le.mp hs).2]
    rw [indicator_of_mem hmem]
    -- the cutoffs equal one
    have hφ1 : monoPhi ((x - a₂) / (C0 * h)) = 1 := monoPhi_eq_one (by
      rw [abs_div, abs_of_pos hR, div_le_one hR, abs_le]; exact H5)
    have hφ2 : monoPhi ((y - b₁) / (C0 * h)) = 1 := monoPhi_eq_one (by
      rw [abs_div, abs_of_pos hR, div_le_one hR, abs_le]; exact e1b)
    have hφ3 : monoPhi ((t - (a₁ - a₂)) / (2 * C0 * h)) = 1 := monoPhi_eq_one (by
      rw [abs_div, abs_of_pos (by linarith : (0:ℝ) < 2 * C0 * h), div_le_one (by linarith)]
      linarith [htt0])
    set qb := monoq r tb
    set Qb := monoQ r tb
    set Y := y + (Qb - qb * tb) + qb * t
    set E := u₂ (x, y + monoQ r (t + s)) * star (u₂ (x, y + monoQ r t)) -
      u₂ (x, Y + qb * s) * star (u₂ (x, Y))
    have key : mlcPhi r ψ u₁ u₂ (((x, y), t), s) - mlcPhiM r ψ C0 h a₁ b₁ a₂ tb u₁ u₂ (((x, y), t), s)
        = ((ψ (t + s) * ψ t : ℝ) : ℂ) * (u₁ (x + (t + s), y) * star (u₁ (x + t, y))) * E := by
      simp only [mlcPhi, mlcPhiM, mlcF, mlcD1, mlcD2, mlcAmp, E, Y, hφ1, hφ2, hφ3, hass]
      simp only [star_mul', Complex.star_def, Complex.conj_ofReal]
      push_cast
      ring
    rw [key, norm_mul, norm_mul, norm_mul, norm_star, Complex.norm_real, Real.norm_eq_abs, abs_mul]
    -- the tangent error
    have hQb := P.htb
    have htb0 := P.htb0
    have d1 : |t - tb| ≤ 4 * (C0 * h) := by
      rw [abs_le] at htt0 htb0 ⊢; constructor <;> linarith
    have d2 : |t + s - tb| ≤ 6 * (C0 * h) := by
      rw [abs_le] at htt0 htb0 hs ⊢; constructor <;> linarith
    have tay1 := mlc_taylor P.hr P.hA P.hAB ht hQb
    have tay2 := mlc_taylor P.hr P.hA P.hAB hts hQb
    have hMq := mlcMq_nonneg P.hr P.hA P.hAB
    have sq1 : (t - tb) ^ 2 ≤ (4 * (C0 * h)) ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) d1 2
    have sq2 : (t + s - tb) ^ 2 ≤ (6 * (C0 * h)) ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) d2 2
    have hE : ‖E‖ ≤ B₂ ^ 2 * L * (mlcMq r A B * (52 * (C0 * h) ^ 2)) := by
      have eE : E = (u₂ (x, y + monoQ r (t + s)) - u₂ (x, Y + qb * s)) * star (u₂ (x, y + monoQ r t))
          + u₂ (x, Y + qb * s) * star (u₂ (x, y + monoQ r t) - u₂ (x, Y)) := by
        simp only [E, star_sub]; ring
      rw [eE]
      refine (norm_add_le _ _).trans ?_
      rw [norm_mul, norm_mul, norm_star, norm_star]
      have l1 := P.lip₂' x (y + monoQ r (t + s)) (Y + qb * s)
      have l2 := P.lip₂' x (y + monoQ r t) Y
      have b1 := P.hu₂.2.1 (x, y + monoQ r t)
      have b2 := P.hu₂.2.1 (x, Y + qb * s)
      have w1 : |y + monoQ r (t + s) - (Y + qb * s)| ≤ mlcMq r A B * (6 * (C0 * h)) ^ 2 := by
        have : y + monoQ r (t + s) - (Y + qb * s) = monoQ r (t + s) - Qb - qb * (t + s - tb) := by
          simp only [Y]; ring
        rw [this]
        exact tay2.trans (mul_le_mul_of_nonneg_left sq2 hMq)
      have w2 : |y + monoQ r t - Y| ≤ mlcMq r A B * (4 * (C0 * h)) ^ 2 := by
        have : y + monoQ r t - Y = monoQ r t - Qb - qb * (t - tb) := by simp only [Y]; ring
        rw [this]
        exact tay1.trans (mul_le_mul_of_nonneg_left sq1 hMq)
      have hB2 := P.B₂_nonneg
      have hL := P.hL
      have hBL : 0 ≤ B₂ * L := mul_nonneg hB2 hL
      calc ‖u₂ (x, y + monoQ r (t + s)) - u₂ (x, Y + qb * s)‖ * ‖u₂ (x, y + monoQ r t)‖ +
            ‖u₂ (x, Y + qb * s)‖ * ‖u₂ (x, y + monoQ r t) - u₂ (x, Y)‖
          ≤ (B₂ * L * (mlcMq r A B * (6 * (C0 * h)) ^ 2)) * B₂ +
            B₂ * (B₂ * L * (mlcMq r A B * (4 * (C0 * h)) ^ 2)) := by
            gcongr
            · exact l1.trans (mul_le_mul_of_nonneg_left w1 hBL)
            · exact l2.trans (mul_le_mul_of_nonneg_left w2 hBL)
        _ = B₂ ^ 2 * L * (mlcMq r A B * (52 * (C0 * h) ^ 2)) := by ring
    have hψ2 : |ψ (t + s)| * |ψ t| ≤ 1 :=
      mul_le_one₀ (P.psi_le _) (abs_nonneg _) (P.psi_le _)
    have hu1 : ‖u₁ (x + (t + s), y)‖ * ‖u₁ (x + t, y)‖ ≤ B₁ ^ 2 := by
      rw [sq]; exact mul_le_mul (P.hu₁.2.1 _) (P.hu₁.2.1 _) (norm_nonneg _) P.B₁_nonneg
    unfold mlcKe
    have hE0 : 0 ≤ ‖E‖ := norm_nonneg _
    calc |ψ (t + s)| * |ψ t| * (‖u₁ (x + (t + s), y)‖ * ‖u₁ (x + t, y)‖) * ‖E‖
        ≤ 1 * B₁ ^ 2 * (B₂ ^ 2 * L * (mlcMq r A B * (52 * (C0 * h) ^ 2))) := by
          gcongr
      _ = _ := by ring
  · -- off the support both terms vanish
    have hz : mlcPhi r ψ u₁ u₂ (((x, y), t), s) = 0 ∧
        mlcPhiM r ψ C0 h a₁ b₁ a₂ tb u₁ u₂ (((x, y), t), s) = 0 := by
      simp only [not_and_or, not_not] at H
      rcases H with H | H | H | H | H
      · simp [mlcPhi, mlcPhiM, mlcF, mlcD1, mlcD2, H]
      · simp [mlcPhi, mlcPhiM, mlcF, mlcD1, mlcD2, H, hass]
      · simp [mlcPhi, mlcPhiM, mlcF, mlcAmp, H]
      · simp [mlcPhi, mlcPhiM, mlcF, mlcAmp, H]
      · simp [mlcPhi, mlcPhiM, mlcF, mlcD1, mlcD2, P.u₂_eq_zero H]
    rw [hz.1, hz.2, sub_zero, norm_zero]
    exact indicator_nonneg (fun _ _ => hKe) _

theorem volume_mlcSerr (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) :
    volume (mlcSerr C0 h a₁ b₁ a₂) = ENNReal.ofReal (64 * (C0 * h) ^ 4) := by
  have hR : 0 ≤ C0 * h := mul_nonneg (by linarith [P.hC0]) P.hh.le
  unfold mlcSerr
  rw [Measure.volume_eq_prod, Measure.prod_prod, Measure.volume_eq_prod, Measure.prod_prod,
    volume_mlcBox _ _ _ hR, Real.volume_Icc, Real.volume_Icc,
    show a₁ - a₂ + 2 * (C0 * h) - (a₁ - a₂ - 2 * (C0 * h)) = 4 * (C0 * h) by ring,
    show 2 * (C0 * h) - -(2 * (C0 * h)) = 4 * (C0 * h) by ring,
    ← ENNReal.ofReal_mul (by linarith), ← ENNReal.ofReal_mul (by nlinarith),
    ← ENNReal.ofReal_mul (by nlinarith)]
  congr 1; ring

/-- **Step 3**: the error of the tangent replacement. -/
theorem step3 (P : MlcPair r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb ψ u₁ u₂) :
    ∫⁻ p, ‖mlcPhi r ψ u₁ u₂ p - mlcPhiM r ψ C0 h a₁ b₁ a₂ tb u₁ u₂ p‖ₑ ≤
      ENNReal.ofReal (mlcKe r A B C0 h L B₁ B₂ * (64 * (C0 * h) ^ 4)) := by
  have hKe : 0 ≤ mlcKe r A B C0 h L B₁ B₂ := by
    unfold mlcKe
    have := mlcMq_nonneg P.hr P.hA P.hAB
    have := P.hL
    positivity
  have hmS : MeasurableSet (mlcSerr C0 h a₁ b₁ a₂) :=
    ((mlcBox_measurable _ _ _).prod measurableSet_Icc).prod measurableSet_Icc
  calc ∫⁻ p, ‖mlcPhi r ψ u₁ u₂ p - mlcPhiM r ψ C0 h a₁ b₁ a₂ tb u₁ u₂ p‖ₑ
      ≤ ∫⁻ p, (mlcSerr C0 h a₁ b₁ a₂).indicator (fun _ => ENNReal.ofReal (mlcKe r A B C0 h L B₁ B₂)) p := by
        refine lintegral_mono fun p => ?_
        have := P.err_pointwise p
        by_cases hp : p ∈ mlcSerr C0 h a₁ b₁ a₂
        · rw [indicator_of_mem hp] at this ⊢
          rw [← ofReal_norm]
          exact ENNReal.ofReal_le_ofReal this
        · rw [indicator_of_notMem hp] at this ⊢
          have h0 : mlcPhi r ψ u₁ u₂ p - mlcPhiM r ψ C0 h a₁ b₁ a₂ tb u₁ u₂ p = 0 :=
            norm_le_zero_iff.mp this
          rw [h0, enorm_zero]
    _ = ENNReal.ofReal (mlcKe r A B C0 h L B₁ B₂) * volume (mlcSerr C0 h a₁ b₁ a₂) :=
        lintegral_indicator_const hmS _
    _ = _ := by
        rw [P.volume_mlcSerr, ← ENNReal.ofReal_mul hKe]

end MlcPair

