/-! ### Proposition 6.1: the assembly for one input configuration -/

theorem norm_monoFTilde_le (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) {L h : ℝ} (M : Finset (ℤ × ℤ))
    {f : ℝ × ℝ → ℂ} {B : ℝ} (hB : ∀ m z, ‖monoUjm j κ L h m f z‖ ≤ B) (hB0 : 0 ≤ B) (z : ℝ × ℝ) :
