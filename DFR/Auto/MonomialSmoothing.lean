/-! ### (6.3): the localization error (lines 961-971) -/

/-- The localized sum `f̃ = ∑_{m ∈ M} χ_m u_{j,m}`. -/
def monoFTilde (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) (L h : ℝ) (M : Finset (ℤ × ℤ)) (f : ℝ × ℝ → ℂ)
    (z : ℝ × ℝ) : ℂ :=
  ∑ m ∈ M, monoVWhole h m (monoUjm j κ L h m f) z

/-- **(6.3)**: if the reproducing identity `P̃ f = f` holds and `M` contains the 9 indices near `z`,
then `|f(z) - f̃(z)| ≤ 9 C ‖f‖_∞ / (L h)`. -/
theorem norm_sub_monoFTilde_le (j : Fin 2) (κ : 𝓢(ℝ, ℂ)) {C : ℝ}
    (hC : ∀ h L : ℝ, 0 < h → 0 < L → ∀ f : ℝ × ℝ → ℂ, Measurable f → ∀ M : ℝ, (∀ z, ‖f z‖ ≤ M) →
      ∀ (m : ℤ × ℤ) (j : Fin 2) (z : ℝ × ℝ),
        ‖(monoEta h m z : ℂ) * monoP j κ L f z - monoP j κ L (fun w => (monoEta h m w : ℂ) * f w) z‖
          ≤ C * M / (L * h))
    {L h : ℝ} (hL : 0 < L) (hh : 0 < h) {f : ℝ × ℝ → ℂ} (hf : Measurable f) {A : ℝ}
    (hA : ∀ z, ‖f z‖ ≤ A) (hrep : monoP j κ L f = f) (M : Finset (ℤ × ℤ)) (z : ℝ × ℝ)
    (hM : mlocNb h z ⊆ M) :
    ‖f z - monoFTilde j κ L h M f z‖ ≤ 9 * (C * A / (L * h)) := by
  have hsum1 : f z = ∑ m ∈ mlocNb h z, (monoChiM h m z : ℂ) * ((monoEta h m z : ℂ) * monoP j κ L f z) := by
    rw [hrep]
    have h1 : ∑ m ∈ mlocNb h z, (monoEta h m z : ℂ) = 1 := by
      rw [← Complex.ofReal_sum, mloc_Eta_sum_nb]; simp
    calc f z = (∑ m ∈ mlocNb h z, (monoEta h m z : ℂ)) * f z := by rw [h1, one_mul]
      _ = _ := by
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl fun m _ => ?_
          by_cases hη : monoEta h m z = 0
          · simp [hη]
          · rw [mloc_ChiM_eq_one_of_monoEta_ne_zero hη]; push_cast; ring
  have hsum2 : monoFTilde j κ L h M f z
      = ∑ m ∈ mlocNb h z, (monoChiM h m z : ℂ) * monoP j κ L (fun w => (monoEta h m w : ℂ) * f w) z := by
    unfold monoFTilde monoVWhole monoUjm monoEtaF
    rw [← Finset.sum_subset hM fun m _ hm => by rw [mloc_ChiM_eq_zero_of_not_mem hm]; simp]
  rw [hsum1, hsum2, ← Finset.sum_sub_distrib]
  refine (norm_sum_le _ _).trans ?_
  calc ∑ m ∈ mlocNb h z, ‖(monoChiM h m z : ℂ) * ((monoEta h m z : ℂ) * monoP j κ L f z) -
        (monoChiM h m z : ℂ) * monoP j κ L (fun w => (monoEta h m w : ℂ) * f w) z‖
      ≤ ∑ m ∈ mlocNb h z, C * A / (L * h) := by
        refine Finset.sum_le_sum fun m _ => ?_
        rw [← mul_sub, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg (mloc_ChiM_nonneg _ _ _)]
        exact (mul_le_of_le_one_left (norm_nonneg _) (mloc_ChiM_le_one _ _ _)).trans
          (hC h L hh hL f hf A hA m j z)
    _ = 9 * (C * A / (L * h)) := by rw [Finset.sum_const, mlocNb_card]; simp

/-- The box of indices `[-N, N]^2`. -/
def monoBox (N : ℕ) : Finset (ℤ × ℤ) := Finset.Icc (-(N : ℤ)) N ×ˢ Finset.Icc (-(N : ℤ)) N

theorem mlocNb_subset_box {h : ℝ} (hh : 0 < h) {ρ0 : ℝ} (hρ0 : 0 ≤ ρ0) {z : ℝ × ℝ}
    (hz : |z.1| ≤ ρ0 ∧ |z.2| ≤ ρ0) : mlocNb h z ⊆ monoBox (⌈ρ0 / h⌉₊ + 3) := by
  intro m hm
  have hχ : ∀ x : ℝ, |x| ≤ ρ0 → ∀ n : ℤ, n ∈ mlocNb1 (x / h) → n ∈ Finset.Icc (-((⌈ρ0 / h⌉₊ + 3 : ℕ) : ℤ)) ((⌈ρ0 / h⌉₊ + 3 : ℕ) : ℤ) := by
    intro x hx n hn
    simp only [mlocNb1, Finset.mem_Icc] at hn
    have h1 : |x / h| ≤ ρ0 / h := by rw [abs_div, abs_of_pos hh]; exact div_le_div_of_nonneg_right hx hh.le
    have h2 : ρ0 / h ≤ ⌈ρ0 / h⌉₊ := Nat.le_ceil _
    have hf1 : (⌊x / h - 3 / 2⌋ : ℝ) ≤ x / h - 3 / 2 := Int.floor_le _
    have hf2 : x / h - 3 / 2 - 1 < (⌊x / h - 3 / 2⌋ : ℝ) := by linarith [Int.lt_floor_add_one (x / h - 3 / 2)]
    obtain ⟨l, u⟩ := abs_le.mp h1
    rw [Finset.mem_Icc]
    constructor
    · have : ((-((⌈ρ0 / h⌉₊ + 3 : ℕ) : ℤ)) : ℝ) ≤ n := by
        have : (n : ℝ) ≥ ⌊x / h - 3 / 2⌋ + 1 := by exact_mod_cast hn.1
        push_cast; linarith
      exact_mod_cast this
    · have : (n : ℝ) ≤ ((⌈ρ0 / h⌉₊ + 3 : ℕ) : ℤ) := by
        have : (n : ℝ) ≤ ⌊x / h - 3 / 2⌋ + 3 := by exact_mod_cast hn.2
        push_cast; linarith
      exact_mod_cast this
  simp only [mlocNb, Finset.mem_product] at hm
  exact Finset.mem_product.mpr ⟨hχ _ hz.1 _ hm.1, hχ _ hz.2 _ hm.2⟩

end

