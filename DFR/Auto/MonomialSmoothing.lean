open MeasureTheory Filter Topology Set FourierTransform Convolution
open scoped ENNReal SchwartzMap Real ContDiff RealInnerProductSpace

namespace Auto

noncomputable section

/-! ### The mollifier and (8.3) -/

/-- A fixed bump with support `(-1,1)`. -/
def ms8Bump : ContDiffBump (0 : ℝ) := ⟨1 / 2, 1, by norm_num, by norm_num⟩

/-- The fixed mollifier `ζ ≥ 0`, `supp ζ ⊆ [-1,1]`, `∫ ζ = 1`. -/
def ms8Zeta : ℝ → ℝ := ms8Bump.normed volume

/-- `ζ_h(s) = h⁻¹ ζ(s/h)`. -/
def ms8ZetaH (h : ℝ) (s : ℝ) : ℝ := h⁻¹ * ms8Zeta (h⁻¹ * s)

/-- The mollified cutoff `ψ_h = ψ * ζ_h`. -/
def ms8Moll (ψ : ℝ → ℝ) (h : ℝ) : ℝ → ℝ := ψ ⋆[ContinuousLinearMap.mul ℝ ℝ] ms8ZetaH h

theorem ms8_zeta_contDiff : ContDiff ℝ ∞ ms8Zeta := ms8Bump.contDiff_normed

theorem ms8_zeta_nonneg (s : ℝ) : 0 ≤ ms8Zeta s := ms8Bump.nonneg_normed s

theorem ms8_zeta_integral : ∫ s, ms8Zeta s = 1 := ms8Bump.integral_normed

theorem ms8_zeta_hasCompactSupport : HasCompactSupport ms8Zeta := ms8Bump.hasCompactSupport_normed

theorem ms8_zeta_eq_zero {s : ℝ} (hs : 1 ≤ |s|) : ms8Zeta s = 0 := by
  by_contra h
  have : s ∈ Function.support ms8Zeta := h
  rw [ms8Zeta, ms8Bump.support_normed_eq, Metric.mem_ball, dist_zero_right,
    Real.norm_eq_abs] at this
  change |s| < 1 at this
  linarith

theorem ms8_zetaH_nonneg {h : ℝ} (hh : 0 < h) (s : ℝ) : 0 ≤ ms8ZetaH h s :=
  mul_nonneg (inv_nonneg.mpr hh.le) (ms8_zeta_nonneg _)

theorem ms8_zetaH_eq_zero {h : ℝ} (hh : 0 < h) {s : ℝ} (hs : h ≤ |s|) : ms8ZetaH h s = 0 := by
  unfold ms8ZetaH
  rw [ms8_zeta_eq_zero, mul_zero]
  rw [abs_mul, abs_inv, abs_of_pos hh, inv_mul_eq_div, le_div_iff₀ hh, one_mul]
  exact hs

theorem ms8_zetaH_contDiff (h : ℝ) : ContDiff ℝ ∞ (ms8ZetaH h) :=
  contDiff_const.mul (ms8_zeta_contDiff.comp (contDiff_const.mul contDiff_id))

theorem ms8_zetaH_hasCompactSupport {h : ℝ} (hh : 0 < h) : HasCompactSupport (ms8ZetaH h) := by
  refine HasCompactSupport.of_support_subset_isCompact (isCompact_Icc (a := -h) (b := h)) ?_
  intro s hs
  by_contra hc
  apply hs
  apply ms8_zetaH_eq_zero hh
  simp only [mem_Icc, not_and_or, not_le] at hc
  rcases hc with hc | hc
  · rw [abs_of_neg (by linarith)]; linarith
  · rw [abs_of_pos (by linarith)]; linarith

theorem ms8_zetaH_integral {h : ℝ} (hh : 0 < h) : ∫ s, ms8ZetaH h s = 1 := by
  unfold ms8ZetaH
  rw [integral_const_mul, Measure.integral_comp_mul_left (fun s => ms8Zeta s) h⁻¹,
    ms8_zeta_integral, inv_inv, abs_of_pos hh, smul_eq_mul, mul_one, inv_mul_cancel₀ hh.ne']

theorem ms8_zetaH_integrable {h : ℝ} (hh : 0 < h) : Integrable (ms8ZetaH h) volume :=
  (ms8_zetaH_contDiff h).continuous.integrable_of_hasCompactSupport (ms8_zetaH_hasCompactSupport hh)

theorem ms8_iteratedDeriv_zetaH (k : ℕ) (h s : ℝ) :
    iteratedDeriv k (ms8ZetaH h) s = h⁻¹ * (h⁻¹ ^ k * iteratedDeriv k ms8Zeta (h⁻¹ * s)) := by
  have e : ms8ZetaH h = fun s => h⁻¹ * (fun s => ms8Zeta (h⁻¹ * s)) s := rfl
  rw [e, iteratedDeriv_const_mul_field,
    iteratedDeriv_comp_const_mul (ms8_zeta_contDiff.of_le (by exact_mod_cast le_top))]

theorem ms8_hcs_iteratedDeriv {g : ℝ → ℝ} (hg : HasCompactSupport g) (k : ℕ) :
    HasCompactSupport (iteratedDeriv k g) := by
  induction k with
  | zero => simpa using hg
  | succ k ih => rw [iteratedDeriv_succ]; exact ih.deriv

theorem ms8_iteratedDeriv_zeta_integrable (k : ℕ) :
    Integrable (iteratedDeriv k ms8Zeta) volume :=
  (ms8_zeta_contDiff.continuous_iteratedDeriv k (by exact_mod_cast le_top)).integrable_of_hasCompactSupport
    (ms8_hcs_iteratedDeriv ms8_zeta_hasCompactSupport k)

theorem ms8_integral_iteratedDeriv_zetaH (k : ℕ) {h : ℝ} (hh : 0 < h) :
    ∫ s, |iteratedDeriv k (ms8ZetaH h) s| = h⁻¹ ^ k * ∫ s, |iteratedDeriv k ms8Zeta s| := by
  simp_rw [ms8_iteratedDeriv_zetaH, abs_mul, abs_inv, abs_pow, abs_inv, abs_of_pos hh]
  rw [integral_const_mul, integral_const_mul,
    Measure.integral_comp_mul_left (fun s => |iteratedDeriv k ms8Zeta s|) h⁻¹, inv_inv,
    abs_of_pos hh, smul_eq_mul]
  field_simp

/-- Derivatives fall on the mollifier: `(ψ * g)^{(k)} = ψ * g^{(k)}`. -/
theorem ms8_iteratedDeriv_conv {ψ : ℝ → ℝ} (hψ : LocallyIntegrable ψ volume) {g : ℝ → ℝ}
    (hg : ContDiff ℝ ∞ g) (hgc : HasCompactSupport g) (k : ℕ) :
    iteratedDeriv k (ψ ⋆[ContinuousLinearMap.mul ℝ ℝ] g) =
      ψ ⋆[ContinuousLinearMap.mul ℝ ℝ] iteratedDeriv k g := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [iteratedDeriv_succ, ih, iteratedDeriv_succ]
    funext x
    exact ((ms8_hcs_iteratedDeriv hgc k).hasDerivAt_convolution_right _ hψ
      (by rw [iteratedDeriv_eq_iterate]; exact (hg.iterate_deriv k).of_le (by exact_mod_cast le_top)) x).deriv

theorem ms8_abs_conv_le {ψ : ℝ → ℝ} {M : ℝ} (hM : ∀ t, |ψ t| ≤ M) {G : ℝ → ℝ}
    (hG : Integrable G volume) (x : ℝ) :
    |(ψ ⋆[ContinuousLinearMap.mul ℝ ℝ] G) x| ≤ M * ∫ s, |G s| := by
  rw [convolution_def]
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  calc |∫ t, (ContinuousLinearMap.mul ℝ ℝ) (ψ t) (G (x - t))|
      ≤ ∫ t, |(ContinuousLinearMap.mul ℝ ℝ) (ψ t) (G (x - t))| := by
        rw [← Real.norm_eq_abs]
        refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
        rfl
    _ ≤ ∫ t, M * |G (x - t)| := by
        refine integral_mono_of_nonneg (Eventually.of_forall fun t => abs_nonneg _)
          ((hG.comp_sub_left x).abs.const_mul M) (Eventually.of_forall fun t => ?_)
        simp only [ContinuousLinearMap.mul_apply', abs_mul]
        exact mul_le_mul_of_nonneg_right (hM t) (abs_nonneg _)
    _ = M * ∫ s, |G s| := by
        rw [integral_const_mul]
        congr 1
        exact integral_sub_left_eq_self (fun s => |G s|) volume x

/-- The constant of (8.3). -/
def ms8CZ : ℝ := ∑ k ∈ Finset.range 21, ∫ s, |iteratedDeriv k ms8Zeta s|

theorem ms8_CZ_nonneg : 0 ≤ ms8CZ :=
  Finset.sum_nonneg fun k _ => integral_nonneg fun s => abs_nonneg _

/-- **(8.3)**: `‖ψ_h‖_{C^20} ≤ C h^{-20} ‖ψ‖_∞` for `0 < h ≤ 1`. -/
theorem ms8_monoC20_moll_le {ψ : ℝ → ℝ} (hψ : Continuous ψ) {M : ℝ} (hM : ∀ t, |ψ t| ≤ M)
    {h : ℝ} (hh : 0 < h) (hh1 : h ≤ 1) :
    monoC20 (ms8Moll ψ h) ≤ ms8CZ * M * h⁻¹ ^ 20 := by
  have hM0 : 0 ≤ M := (abs_nonneg _).trans (hM 0)
  unfold monoC20 ms8CZ
  rw [Finset.sum_mul, Finset.sum_mul]
  refine Finset.sum_le_sum fun k hk => ?_
  have hk20 : k ≤ 20 := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
  refine ciSup_le fun t => ?_
  rw [ms8Moll, ms8_iteratedDeriv_conv hψ.locallyIntegrable (ms8_zetaH_contDiff h)
    (ms8_zetaH_hasCompactSupport hh)]
  have hI : Integrable (iteratedDeriv k (ms8ZetaH h)) volume :=
    ((ms8_zetaH_contDiff h).continuous_iteratedDeriv k
      (by exact_mod_cast le_top)).integrable_of_hasCompactSupport
      (ms8_hcs_iteratedDeriv (ms8_zetaH_hasCompactSupport hh) k)
  refine (ms8_abs_conv_le hM hI t).trans ?_
  rw [ms8_integral_iteratedDeriv_zetaH k hh]
  have hpow : h⁻¹ ^ k ≤ h⁻¹ ^ 20 := pow_le_pow_right₀ (one_le_inv₀ hh |>.mpr hh1) hk20
  have hZ : 0 ≤ ∫ s, |iteratedDeriv k ms8Zeta s| := integral_nonneg fun s => abs_nonneg _
  calc M * (h⁻¹ ^ k * ∫ s, |iteratedDeriv k ms8Zeta s|)
      ≤ M * (h⁻¹ ^ 20 * ∫ s, |iteratedDeriv k ms8Zeta s|) := by gcongr
    _ = (∫ s, |iteratedDeriv k ms8Zeta s|) * M * h⁻¹ ^ 20 := by ring

theorem ms8_moll_contDiff {ψ : ℝ → ℝ} (hψ : Continuous ψ) {h : ℝ} (hh : 0 < h) :
    ContDiff ℝ ∞ (ms8Moll ψ h) :=
  (ms8_zetaH_hasCompactSupport hh).contDiff_convolution_right _ hψ.locallyIntegrable
    (ms8_zetaH_contDiff h)

theorem ms8_moll_tsupport {ψ : ℝ → ℝ} {A B : ℝ} (hsupp : tsupport ψ ⊆ Icc A B) {h : ℝ}
    (hh : 0 < h) : tsupport (ms8Moll ψ h) ⊆ Icc (A - h) (B + h) := by
  refine closure_minimal ?_ isClosed_Icc
  refine (support_convolution_subset _).trans ?_
  rintro _ ⟨x, hx, y, hy, rfl⟩
  have hx' := hsupp (subset_tsupport _ hx)
  have hy' : |y| < h := by
    by_contra hc; exact hy (ms8_zetaH_eq_zero hh (not_lt.mp hc))
  rw [abs_lt] at hy'
  simp only [mem_Icc] at hx' ⊢
  constructor <;> linarith [hx'.1, hx'.2]

end

