theorem mimp_half_mul_self (x : ℝ≥0∞) : x ^ (1 / 2 : ℝ) * x ^ (1 / 2 : ℝ) = x := by
  rw [← ENNReal.rpow_add_of_nonneg _ _ (by norm_num) (by norm_num)]; norm_num

theorem mimp_pow_third_eq (a : ℝ≥0∞) (n : ℕ) : a ^ ((n : ℝ) / 3) = (a ^ n) ^ (1 / 3 : ℝ) := by
  rw [← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]; congr 1; ring

theorem mimp_pointwise3 (x y z : ℝ≥0∞) :
    ((x * y) ^ (3 / 2 : ℝ)) ^ (1 / 3 : ℝ) * ((x * z) ^ (3 / 2 : ℝ)) ^ (1 / 3 : ℝ) *
      ((y * z) ^ (3 / 2 : ℝ)) ^ (1 / 3 : ℝ) = x * y * (z) := by
  simp only [← ENNReal.rpow_mul]
  norm_num
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ENNReal.mul_rpow_of_nonneg _ _ (by norm_num),
    ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]
  calc x ^ (1 / 2 : ℝ) * y ^ (1 / 2 : ℝ) * (x ^ (1 / 2 : ℝ) * z ^ (1 / 2 : ℝ)) *
        (y ^ (1 / 2 : ℝ) * z ^ (1 / 2 : ℝ))
      = (x ^ (1 / 2 : ℝ) * x ^ (1 / 2 : ℝ)) * (y ^ (1 / 2 : ℝ) * y ^ (1 / 2 : ℝ)) *
        (z ^ (1 / 2 : ℝ) * z ^ (1 / 2 : ℝ)) := by ring
    _ = x * y * z := by rw [mimp_half_mul_self, mimp_half_mul_self, mimp_half_mul_self]

/-- Trilinear Young inequality with exponents `3/2, 3/2, 3/2` (the content of (4.3)–(4.4)). -/
theorem mimp_young3 {G k : ℝ × ℝ → ℝ≥0∞} (hG : Measurable G) (hk : Measurable k) :
    ∫⁻ w, G w * ∫⁻ v, G (w + v) * k v ≤
      (∫⁻ w, G w ^ (3 / 2 : ℝ)) ^ (4 / 3 : ℝ) * (∫⁻ v, k v ^ (3 / 2 : ℝ)) ^ (2 / 3 : ℝ) := by
  set a := ∫⁻ w, G w ^ (3 / 2 : ℝ) with ha
  set κ := ∫⁻ v, k v ^ (3 / 2 : ℝ) with hκ
  set μ : Measure ((ℝ × ℝ) × (ℝ × ℝ)) := (volume : Measure (ℝ × ℝ)).prod volume
  have eL : ∫⁻ w, G w * ∫⁻ v, G (w + v) * k v =
      ∫⁻ p, G p.1 * G (p.1 + p.2) * k p.2 ∂μ := by
    rw [lintegral_prod _ (by apply Measurable.aemeasurable; fun_prop)]
    congr 1; ext w
    rw [← lintegral_const_mul _ (by fun_prop)]
    congr 1; ext v; ring
  let f : Fin 3 → (ℝ × ℝ) × (ℝ × ℝ) → ℝ≥0∞ := ![fun p => (G p.1 * G (p.1 + p.2)) ^ (3 / 2 : ℝ),
    fun p => (G p.1 * k p.2) ^ (3 / 2 : ℝ), fun p => (G (p.1 + p.2) * k p.2) ^ (3 / 2 : ℝ)]
  have hf : ∀ i ∈ (Finset.univ : Finset (Fin 3)), AEMeasurable (f i) μ := by
    intro i _
    fin_cases i <;> (apply Measurable.aemeasurable; simp [f]; fun_prop)
  have hH := ENNReal.lintegral_prod_norm_pow_le (μ := μ) Finset.univ hf
    (p := fun _ => (1 / 3 : ℝ)) (by norm_num) (fun _ _ => by norm_num)
  simp only [Fin.prod_univ_three] at hH
  have ep : ∀ p : (ℝ × ℝ) × (ℝ × ℝ), f 0 p ^ (1 / 3 : ℝ) * f 1 p ^ (1 / 3 : ℝ) *
      f 2 p ^ (1 / 3 : ℝ) = G p.1 * G (p.1 + p.2) * k p.2 := by
    intro p
    simp only [f, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons]
    exact mimp_pointwise3 _ _ _
  simp_rw [ep] at hH
  rw [eL]
  refine hH.trans (le_of_eq ?_)
  have I0 : ∫⁻ p, f 0 p ∂μ = a * a := by
    simp only [f, Matrix.cons_val_zero]
    rw [lintegral_prod _ (by apply Measurable.aemeasurable; fun_prop)]
    simp_rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 3 / 2)]
    have : ∀ w : ℝ × ℝ, ∫⁻ v, G w ^ (3 / 2 : ℝ) * G (w + v) ^ (3 / 2 : ℝ) = G w ^ (3 / 2 : ℝ) * a := by
      intro w
      rw [lintegral_const_mul _ (by fun_prop),
        lintegral_add_left_eq_self (fun v => G v ^ (3 / 2 : ℝ)) w]
    simp_rw [this]
    rw [lintegral_mul_const _ (by fun_prop)]
  have I1 : ∫⁻ p, f 1 p ∂μ = a * κ := by
    simp only [f, Matrix.cons_val_one]
    simp_rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 3 / 2)]
    exact lintegral_prod_mul (hG.pow_const _).aemeasurable (hk.pow_const _).aemeasurable
  have I2 : ∫⁻ p, f 2 p ∂μ = κ * a := by
    simp only [f, Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]
    rw [lintegral_prod _ (by apply Measurable.aemeasurable; fun_prop)]
    simp_rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 3 / 2)]
    rw [lintegral_lintegral_swap (by apply Measurable.aemeasurable; fun_prop)]
    have : ∀ v : ℝ × ℝ, ∫⁻ w, G (w + v) ^ (3 / 2 : ℝ) * k v ^ (3 / 2 : ℝ) = k v ^ (3 / 2 : ℝ) * a := by
      intro v
      rw [lintegral_mul_const _ (by fun_prop),
        lintegral_add_right_eq_self (fun v => G v ^ (3 / 2 : ℝ)) v, mul_comm]
    simp_rw [this]
    rw [lintegral_mul_const _ (by fun_prop)]
  rw [I0, I1, I2, ← ENNReal.mul_rpow_of_nonneg _ _ (by norm_num),
    ← ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]
  rw [show (4 / 3 : ℝ) = ((4 : ℕ) : ℝ) / 3 by norm_num, show (2 / 3 : ℝ) = ((2 : ℕ) : ℝ) / 3 by norm_num,
    mimp_pow_third_eq, mimp_pow_third_eq, ← ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]
  congr 1
  ring

end

end Auto

