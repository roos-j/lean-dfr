/-! ### Section 7: the global annular estimate (7.7) -/

/-- **(7.7)**: the local bounded-input estimate (Proposition 6.1) implies the global `L^2`
annular estimate, with `s = σ/39` (level-set truncation for (7.3), continuous averaging of the
translated cutoffs for the globalization). -/
theorem ms7_global {r A B : ℝ} (hr : 1 < r) (hA : 0 < A) (hAB : A < B) (hL : MonoLocal61 r A B) :
    ∃ C s : ℝ, 0 < C ∧ 0 < s ∧ MonoGlobal77 r A B C s := by
  obtain ⟨C, σ, hC, hσ, hloc⟩ := hL ms7Chi ms7Chi_contDiff ms7Chi_hasCompactSupport
  obtain ⟨K₁, hK₁, h₁⟩ := ms7_config hr hA hAB hC hσ monoKPsiA monoKPhi
  obtain ⟨K₂, hK₂, h₂⟩ := ms7_config hr hA hAB hC hσ monoKPhi monoKPsiA
  refine ⟨max K₁ K₂ + 1, σ / 39, by positivity, by positivity, ?_⟩
  intro ψ hψ hsupp L hL u₁ u₂ hu₁ hu₂ hf₁ hf₂
  have hp := ms7_C20_nonneg hψ hsupp
  have hLs : 0 ≤ L ^ (-(σ / 39)) := Real.rpow_nonneg (by linarith) _
  constructor
  · refine (h₁ ψ hψ hsupp L L L hL (by linarith) (by linarith)
      (fun v₁ v₂ hv₁ hv₂ B₁ B₂ hB₁ hB₂ => (hloc ψ hψ hsupp L hL v₁ v₂ hv₁ hv₂ B₁ B₂ hB₁ hB₂).1)
      u₁ u₂ hu₁ hu₂ hf₁ hf₂).trans ?_
    gcongr
    exact (le_max_left _ _).trans (le_add_of_nonneg_right zero_le_one)
  · refine (h₂ ψ hψ hsupp L (L / 2) L hL (by linarith) (by linarith)
      (fun v₁ v₂ hv₁ hv₂ B₁ B₂ hB₁ hB₂ => (hloc ψ hψ hsupp L hL v₁ v₂ hv₁ hv₂ B₁ B₂ hB₁ hB₂).2)
      u₁ u₂ hu₁ hu₂ hf₁ hf₂).trans ?_
    gcongr
    exact (le_max_right _ _).trans (le_add_of_nonneg_right zero_le_one)

end

end Auto

