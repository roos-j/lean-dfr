/-- The kernel majorant. -/
def mfkK (h q : ℝ) (ξ η : ℝ × ℝ) : ℝ :=
  ((1 + h * |ξ.1 + η.1| + h * |ξ.2 + η.2| + h * |ξ.1 + q * η.2|) ^ 12)⁻¹

/-- The weight `(1 + |u|)^{-8}`. -/
def mfkW (u : ℝ) : ℝ := ((1 + |u|) ^ 8)⁻¹

/-- `∫ (1 + |s|)^{-2} ds`. -/
def mfkJ : ℝ := ∫ s : ℝ, ((1 + |s|) ^ 2)⁻¹

theorem mfk_integrable_J : Integrable (fun s : ℝ => ((1 + |s|) ^ 2)⁻¹) := by
  have := integrable_one_add_norm (E := ℝ) (μ := volume) (r := 2) (by simp)
  refine this.congr (Eventually.of_forall (fun s => ?_))
  simp only [Real.norm_eq_abs]
  rw [Real.rpow_neg (by positivity), Real.rpow_two]

theorem mfk_lint_1d {h : ℝ} (hh : 0 < h) :
    ∫⁻ s : ℝ, ENNReal.ofReal (((1 + h * |s|) ^ 2)⁻¹) = ENNReal.ofReal (h⁻¹ * mfkJ) := by
  have hi : Integrable (fun s : ℝ => ((1 + |h * s|) ^ 2)⁻¹) :=
    mfk_integrable_J.comp_mul_left' hh.ne'
  have he : (fun s : ℝ => ((1 + h * |s|) ^ 2)⁻¹) = (fun s : ℝ => ((1 + |h * s|) ^ 2)⁻¹) := by
    funext s; rw [abs_mul, abs_of_pos hh]
  rw [← ofReal_integral_eq_lintegral_ofReal (by rw [he]; exact hi)
    (Eventually.of_forall (fun s => by positivity))]
  congr 1
  rw [he, Measure.integral_comp_mul_left (fun s : ℝ => ((1 + |s|) ^ 2)⁻¹) h,
    abs_of_pos (inv_pos.mpr hh), smul_eq_mul]
  rfl

theorem mfk_lint_2d {h : ℝ} (hh : 0 < h) :
    ∫⁻ η : ℝ × ℝ, ENNReal.ofReal (((1 + h * |η.1|) ^ 2)⁻¹ * ((1 + h * |η.2|) ^ 2)⁻¹)
      = ENNReal.ofReal ((h⁻¹ * mfkJ) ^ 2) := by
  have hJ : 0 ≤ mfkJ := integral_nonneg (fun s => by positivity)
  have hsplit : ∀ η : ℝ × ℝ, ENNReal.ofReal (((1 + h * |η.1|) ^ 2)⁻¹ * ((1 + h * |η.2|) ^ 2)⁻¹) =
      ENNReal.ofReal (((1 + h * |η.1|) ^ 2)⁻¹) * ENNReal.ofReal (((1 + h * |η.2|) ^ 2)⁻¹) :=
    fun η => ENNReal.ofReal_mul (by positivity)
  simp_rw [hsplit]
  rw [Measure.volume_eq_prod]
  rw [lintegral_prod_mul (f := fun s : ℝ => ENNReal.ofReal (((1 + h * |s|) ^ 2)⁻¹))
    (g := fun s : ℝ => ENNReal.ofReal (((1 + h * |s|) ^ 2)⁻¹)) (by fun_prop) (by fun_prop), mfk_lint_1d hh, ← ENNReal.ofReal_mul
    (by positivity), sq]

theorem mfk_pointwise {a b v U M : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hv : 0 ≤ v) (hM : 1 ≤ M)
    (hU : |U| ≤ v + M * (a + b)) :
    ((1 + a + b + v) ^ 12)⁻¹ ≤ (2 * M) ^ 8 * (((1 + a) ^ 2)⁻¹ * ((1 + b) ^ 2)⁻¹ * mfkW U) := by
  unfold mfkW
  set S := 1 + a + b + v
  have hS1 : 1 + a ≤ S := by simp only [S]; linarith
  have hS2 : 1 + b ≤ S := by simp only [S]; linarith
  have hS3 : 1 + |U| ≤ 2 * M * S := by
    simp only [S]; nlinarith [abs_nonneg U]
  have hpos : 0 < S := by positivity
  rw [show (2 * M) ^ 8 * (((1 + a) ^ 2)⁻¹ * ((1 + b) ^ 2)⁻¹ * ((1 + |U|) ^ 8)⁻¹)
      = ((1 + a) ^ 2 * (1 + b) ^ 2 * ((1 + |U|) / (2 * M)) ^ 8)⁻¹ by
    field_simp]
  apply inv_anti₀ (by positivity)
  rw [show S ^ 12 = S ^ 2 * S ^ 2 * S ^ 8 by ring]
  have h3 : (1 + |U|) / (2 * M) ≤ S := by
    rw [div_le_iff₀ (by positivity)]; linarith
  gcongr

end

