/-- The oscillatory factor `exp (i φ)` of a real phase. -/
noncomputable def expPhase (φ : ℝ → ℝ) (x : ℝ) : ℂ := Complex.exp ((φ x : ℂ) * Complex.I)

theorem norm_expPhase (φ : ℝ → ℝ) (x : ℝ) : ‖expPhase φ x‖ = 1 := by
  rw [expPhase, Complex.norm_exp_ofReal_mul_I]

theorem hasDerivAt_expPhase {φ φ' : ℝ → ℝ} {x : ℝ} (hφ : HasDerivAt φ (φ' x) x) :
    HasDerivAt (expPhase φ) (((φ' x : ℂ) * Complex.I) * expPhase φ x) x := by
  have h : HasDerivAt (fun y : ℝ => ((φ y : ℂ) * Complex.I)) ((φ' x : ℂ) * Complex.I) x :=
    (hφ.ofReal_comp).mul_const Complex.I
  have h2 := h.cexp
  rw [mul_comm] at h2
  exact h2

theorem continuous_expPhase {φ : ℝ → ℝ} (hφ : Continuous φ) : Continuous (expPhase φ) :=
  Complex.continuous_exp.comp (Complex.continuous_ofReal.comp hφ |>.mul continuous_const)

theorem intervalIntegral_conj {a b : ℝ} (F : ℝ → ℂ) :
    (starRingEnd ℂ) (∫ y in a..b, F y) = ∫ y in a..b, (starRingEnd ℂ) (F y) := by
  simp only [intervalIntegral, map_sub, ← integral_conj]

theorem expPhase_neg (φ : ℝ → ℝ) (x : ℝ) :
    expPhase (fun y => -φ y) x = (starRingEnd ℂ) (expPhase φ x) := by
  simp only [expPhase, Complex.ofReal_neg, ← Complex.exp_conj]
  congr 1
  simp [Complex.conj_I]

/-- Replacing the phase by its negative conjugates the integral, so the two differ only by the
sign of the second derivative.  This is what lets the order-one estimate be proved for an
increasing derivative and then transferred to a decreasing one. -/
theorem integral_expPhase_neg (φ : ℝ → ℝ) (a b : ℝ) :
    (∫ x in a..b, expPhase (fun y => -φ y) x)
      = (starRingEnd ℂ) (∫ x in a..b, expPhase φ x) := by
  rw [intervalIntegral_conj]
  exact intervalIntegral.integral_congr fun x _ => expPhase_neg φ x


/-! ## The order-one estimate

Integration by parts against `u = -i / φ'`.  The boundary terms are at most `1 / μ` each, and the
remaining integral is the total variation of `1 / φ'`, which telescopes because `φ'` is monotone.
-/

theorem continuous_of_hasDerivAt {φ φ' : ℝ → ℝ} (hφ : ∀ x, HasDerivAt φ (φ' x) x) :
    Continuous φ :=
  continuous_iff_continuousAt.mpr fun x => (hφ x).continuousAt

theorem deriv_ne_zero_of_abs_le {a b μ : ℝ} (hμ : 0 < μ) {φ' : ℝ → ℝ}
    (hlow : ∀ x ∈ Set.Icc a b, μ ≤ |φ' x|) : ∀ x ∈ Set.Icc a b, φ' x ≠ 0 := by
  intro x hx h0
  have h := hlow x hx
  rw [h0, abs_zero] at h
  linarith

/-- **Integration by parts against `u = -i / φ'`.**  The two boundary terms contribute `1 / μ`
each, and what is left is the integral of `|φ''| / φ' ^ 2`, the total variation of `1 / φ'`.  Both
order-one estimates below come from bounding that last integral. -/
theorem norm_integral_expPhase_ibp {a b μ : ℝ} (hab : a ≤ b) (hμ : 0 < μ)
    {φ φ' φ'' : ℝ → ℝ}
    (hφ : ∀ x, HasDerivAt φ (φ' x) x) (hφ' : ∀ x, HasDerivAt φ' (φ'' x) x)
    (hφ''c : Continuous φ'')
    (hlow : ∀ x ∈ Set.Icc a b, μ ≤ |φ' x|) :
    ‖∫ x in a..b, expPhase φ x‖ ≤ 2 / μ + ∫ x in a..b, |φ'' x| / (φ' x) ^ 2 := by
  have hφc : Continuous φ := continuous_of_hasDerivAt hφ
  have hφ'c : Continuous φ' := continuous_of_hasDerivAt hφ'
  have huIcc : Set.uIcc a b = Set.Icc a b := Set.uIcc_of_le hab
  have hne : ∀ x ∈ Set.uIcc a b, φ' x ≠ 0 := by
    rw [huIcc]; exact deriv_ne_zero_of_abs_le hμ hlow
  have hnec : ∀ x ∈ Set.uIcc a b, ((φ' x : ℝ) : ℂ) ≠ 0 := fun x hx =>
    Complex.ofReal_ne_zero.mpr (hne x hx)
  have hinv : ∀ x ∈ Set.uIcc a b, |(φ' x)⁻¹| ≤ μ⁻¹ := by
    intro x hx
    rw [huIcc] at hx
    rw [abs_inv]
    exact inv_anti₀ hμ (hlow x hx)
  set u : ℝ → ℂ := fun x => -Complex.I * (((φ' x : ℝ) : ℂ))⁻¹ with hu
  set u' : ℝ → ℂ := fun x => Complex.I * ((φ'' x : ℝ) : ℂ) / (((φ' x : ℝ) : ℂ)) ^ 2 with hu'
  set v' : ℝ → ℂ := fun x => (((φ' x : ℝ) : ℂ) * Complex.I) * expPhase φ x with hv'
  have hud : ∀ x ∈ Set.uIcc a b, HasDerivAt u (u' x) x := by
    intro x hx
    have h1 : HasDerivAt (fun y : ℝ => ((φ' y : ℝ) : ℂ)) ((φ'' x : ℝ) : ℂ) x :=
      (hφ' x).ofReal_comp
    have h2 := (h1.inv (hnec x hx)).const_mul (-Complex.I)
    have h3 : -Complex.I * (-((φ'' x : ℝ) : ℂ) / (((φ' x : ℝ) : ℂ)) ^ 2) = u' x := by
      rw [hu']
      field_simp
    rw [h3] at h2
    exact h2
  have hvd : ∀ x ∈ Set.uIcc a b, HasDerivAt (expPhase φ) (v' x) x :=
    fun x _ => hasDerivAt_expPhase (hφ x)
  have hu'c : ContinuousOn u' (Set.uIcc a b) := by
    refine ContinuousOn.div ?_ ?_ fun x hx => pow_ne_zero 2 (hnec x hx)
    · exact (continuous_const.mul (Complex.continuous_ofReal.comp hφ''c)).continuousOn
    · exact ((Complex.continuous_ofReal.comp hφ'c).pow 2).continuousOn
  have hv'c : Continuous v' :=
    ((Complex.continuous_ofReal.comp hφ'c).mul continuous_const).mul
      (continuous_expPhase hφc)
  have hu'i : IntervalIntegrable u' volume a b := hu'c.intervalIntegrable
  have hv'i : IntervalIntegrable v' volume a b := hv'c.continuousOn.intervalIntegrable
  have hIBP := intervalIntegral.integral_mul_deriv_eq_deriv_mul hud hvd hu'i hv'i
  have hkey : (∫ x in a..b, u x * v' x) = ∫ x in a..b, expPhase φ x := by
    refine intervalIntegral.integral_congr fun x hx => ?_
    simp only [hu, hv']
    rw [show -Complex.I * (((φ' x : ℝ) : ℂ))⁻¹ * ((((φ' x : ℝ) : ℂ)) * Complex.I * expPhase φ x)
        = (-Complex.I * Complex.I) * ((((φ' x : ℝ) : ℂ))⁻¹ * (((φ' x : ℝ) : ℂ)))
          * expPhase φ x by ring,
      inv_mul_cancel₀ (hnec x hx)]
    simp [neg_mul, Complex.I_mul_I]
  rw [hkey] at hIBP
  have hbdry : ∀ x ∈ Set.uIcc a b, ‖u x * expPhase φ x‖ ≤ μ⁻¹ := by
    intro x hx
    rw [norm_mul, norm_expPhase, mul_one, hu, norm_mul, norm_neg, Complex.norm_I, one_mul,
      norm_inv, Complex.norm_real, Real.norm_eq_abs, ← abs_inv]
    exact hinv x hx
  have hax : a ∈ Set.uIcc a b := Set.left_mem_uIcc
  have hbx : b ∈ Set.uIcc a b := Set.right_mem_uIcc
  have hnu' : ∀ x ∈ Set.uIcc a b, ‖u' x * expPhase φ x‖ = |φ'' x| / (φ' x) ^ 2 := by
    intro x hx
    rw [norm_mul, norm_expPhase, mul_one, hu', norm_div, norm_mul, Complex.norm_I, one_mul,
      Complex.norm_real, Real.norm_eq_abs, norm_pow, Complex.norm_real, Real.norm_eq_abs,
      ← abs_pow, abs_of_nonneg (sq_nonneg (φ' x))]
  have hrem : ‖∫ x in a..b, u' x * expPhase φ x‖ ≤ ∫ x in a..b, |φ'' x| / (φ' x) ^ 2 := by
    have h1 : ‖∫ x in a..b, u' x * expPhase φ x‖ ≤ ∫ x in a..b, ‖u' x * expPhase φ x‖ :=
