  have hB : ‖u b * expPhase φ b‖ ≤ μ⁻¹ := hbdry b hbx
  have h2 : (2 : ℝ) / μ = μ⁻¹ + μ⁻¹ := by
    field_simp
    ring
  rw [h2]
  linarith

/-- The order-one van der Corput estimate, for an increasing derivative. -/
theorem norm_integral_expPhase_le_of_deriv_pos {a b μ : ℝ} (hab : a ≤ b) (hμ : 0 < μ)
    {φ φ' φ'' : ℝ → ℝ}
    (hφ : ∀ x, HasDerivAt φ (φ' x) x) (hφ' : ∀ x, HasDerivAt φ' (φ'' x) x)
    (hφ''c : Continuous φ'')
    (hlow : ∀ x ∈ Set.Icc a b, μ ≤ |φ' x|)
    (hmono : ∀ x ∈ Set.Icc a b, 0 ≤ φ'' x) :
    ‖∫ x in a..b, expPhase φ x‖ ≤ 4 / μ := by
  have hφ'c : Continuous φ' := continuous_of_hasDerivAt hφ'
  have huIcc : Set.uIcc a b = Set.Icc a b := Set.uIcc_of_le hab
  have hne : ∀ x ∈ Set.uIcc a b, φ' x ≠ 0 := by
    rw [huIcc]; exact deriv_ne_zero_of_abs_le hμ hlow
  have hinv : ∀ x ∈ Set.uIcc a b, |(φ' x)⁻¹| ≤ μ⁻¹ := by
    intro x hx
    rw [huIcc] at hx
    rw [abs_inv]
    exact inv_anti₀ hμ (hlow x hx)
  set w : ℝ → ℝ := fun x => -(φ' x)⁻¹ with hw
  have hwd : ∀ x ∈ Set.uIcc a b, HasDerivAt w (φ'' x / (φ' x) ^ 2) x := by
    intro x hx
    have h1 := ((hφ' x).inv (hne x hx)).neg
    have h2 : -(-(φ'' x) / (φ' x) ^ 2) = φ'' x / (φ' x) ^ 2 := by ring
    rw [h2] at h1
    exact h1
  have hqc : ContinuousOn (fun x => φ'' x / (φ' x) ^ 2) (Set.uIcc a b) :=
    ContinuousOn.div hφ''c.continuousOn (hφ'c.pow 2).continuousOn fun x hx =>
      pow_ne_zero 2 (hne x hx)
  have hq : (∫ x in a..b, φ'' x / (φ' x) ^ 2) = w b - w a :=
    intervalIntegral.integral_eq_sub_of_hasDerivAt hwd hqc.intervalIntegrable
  have habs : ∀ x ∈ Set.uIcc a b, |φ'' x| / (φ' x) ^ 2 = φ'' x / (φ' x) ^ 2 := fun x hx => by
    rw [abs_of_nonneg (hmono x (huIcc ▸ hx))]
  have hrem : (∫ x in a..b, |φ'' x| / (φ' x) ^ 2) ≤ 2 * μ⁻¹ := by
    rw [intervalIntegral.integral_congr habs, hq]
    have hwa : |w a| ≤ μ⁻¹ := by rw [hw, abs_neg]; exact hinv a Set.left_mem_uIcc
    have hwb : |w b| ≤ μ⁻¹ := by rw [hw, abs_neg]; exact hinv b Set.right_mem_uIcc
    have h1 := abs_le.mp hwa
    have h2 := abs_le.mp hwb
    linarith
  refine le_trans (norm_integral_expPhase_ibp hab hμ hφ hφ' hφ''c hlow) ?_
  have h4 : (4 : ℝ) / μ = 2 / μ + 2 * μ⁻¹ := by
    field_simp
    ring
  rw [h4]
  linarith

/-- The order-one van der Corput estimate with a bounded second derivative instead of a
monotonicity hypothesis.  This is the form used when the first derivative is the one bounded
below, where no monotonicity is available; the cost is a term proportional to the length of the
interval. -/
theorem norm_integral_expPhase_le_of_deriv_bdd {a b μ M : ℝ} (hab : a ≤ b) (hμ : 0 < μ)
    {φ φ' φ'' : ℝ → ℝ}
    (hφ : ∀ x, HasDerivAt φ (φ' x) x) (hφ' : ∀ x, HasDerivAt φ' (φ'' x) x)
    (hφ''c : Continuous φ'')
    (hlow : ∀ x ∈ Set.Icc a b, μ ≤ |φ' x|)
    (hM : ∀ x ∈ Set.Icc a b, |φ'' x| ≤ M) :
    ‖∫ x in a..b, expPhase φ x‖ ≤ 2 / μ + (b - a) * M / μ ^ 2 := by
  have hφ'c : Continuous φ' := continuous_of_hasDerivAt hφ'
  have huIcc : Set.uIcc a b = Set.Icc a b := Set.uIcc_of_le hab
  have hne : ∀ x ∈ Set.uIcc a b, φ' x ≠ 0 := by
    rw [huIcc]; exact deriv_ne_zero_of_abs_le hμ hlow
  have hqc : ContinuousOn (fun x => |φ'' x| / (φ' x) ^ 2) (Set.uIcc a b) :=
    ContinuousOn.div hφ''c.abs.continuousOn (hφ'c.pow 2).continuousOn fun x hx =>
      pow_ne_zero 2 (hne x hx)
  have hmono : ∀ x ∈ Set.Icc a b, |φ'' x| / (φ' x) ^ 2 ≤ M / μ ^ 2 := by
    intro x hx
    have h1 : μ ^ 2 ≤ (φ' x) ^ 2 := by
      have h := hlow x hx
      nlinarith [abs_nonneg (φ' x), sq_abs (φ' x)]
    have h2 : (0 : ℝ) < μ ^ 2 := by positivity
    have hM0 : (0 : ℝ) ≤ M := le_trans (abs_nonneg _) (hM x hx)
    rw [div_eq_mul_inv, div_eq_mul_inv]
    exact mul_le_mul (hM x hx) (inv_anti₀ h2 h1) (by positivity) hM0
  have hint : (∫ x in a..b, |φ'' x| / (φ' x) ^ 2) ≤ (b - a) * M / μ ^ 2 := by
    have h := intervalIntegral.integral_mono_on hab hqc.intervalIntegrable
      (intervalIntegrable_const (μ := (volume : Measure ℝ)) (a := a) (b := b)
        (c := M / μ ^ 2)) hmono
    rw [intervalIntegral.integral_const, smul_eq_mul] at h
    calc (∫ x in a..b, |φ'' x| / (φ' x) ^ 2) ≤ (b - a) * (M / μ ^ 2) := h
      _ = (b - a) * M / μ ^ 2 := by ring
  refine le_trans (norm_integral_expPhase_ibp hab hμ hφ hφ' hφ''c hlow) ?_
  linarith


/-- **The order-one van der Corput estimate.**  If `|φ'| ≥ μ > 0` on `[a, b]` and `φ'` is monotone
there (equivalently, `φ''` does not change sign), then `‖∫ exp (i φ)‖ ≤ 4 / μ`, with no dependence
on the length of the interval. -/
theorem norm_integral_expPhase_le_of_deriv_monotone {a b μ : ℝ} (hab : a ≤ b) (hμ : 0 < μ)
    {φ φ' φ'' : ℝ → ℝ}
    (hφ : ∀ x, HasDerivAt φ (φ' x) x) (hφ' : ∀ x, HasDerivAt φ' (φ'' x) x)
    (hφ''c : Continuous φ'')
    (hlow : ∀ x ∈ Set.Icc a b, μ ≤ |φ' x|)
    (hmono : (∀ x ∈ Set.Icc a b, 0 ≤ φ'' x) ∨ ∀ x ∈ Set.Icc a b, φ'' x ≤ 0) :
    ‖∫ x in a..b, expPhase φ x‖ ≤ 4 / μ := by
  rcases hmono with h | h
  · exact norm_integral_expPhase_le_of_deriv_pos hab hμ hφ hφ' hφ''c hlow h
  · have hneg := norm_integral_expPhase_le_of_deriv_pos hab hμ
      (φ := fun y => -φ y) (φ' := fun y => -φ' y) (φ'' := fun y => -φ'' y)
      (fun x => (hφ x).neg) (fun x => (hφ' x).neg) hφ''c.neg
      (fun x hx => by simpa using hlow x hx) (fun x hx => by simpa using h x hx)
    rwa [integral_expPhase_neg, RCLike.norm_conj] at hneg


/-! ## The order-`k` estimate

If `φ^(k) ≥ μ > 0` on `[a, b]` then `φ^(k-1)` increases at rate at least `μ`, so it stays away
from zero except on one interval of length `2 δ`; outside that interval `|φ^(k-1)| ≥ μ δ` and the
inductive hypothesis applies.  Taking `δ = μ ^ (-1/k)` balances the two contributions. -/

/-- A function whose derivative is at least `μ > 0` on `[a, b]` has a "centre": a point `c` of
`[a, b]` from which the function grows at rate at least `μ` in each direction, with the correct
sign.  If the function vanishes on `[a, b]` this is its zero; otherwise it is the endpoint on the
side where the function is small. -/
theorem exists_center_of_deriv_ge {a b μ : ℝ} (hab : a ≤ b) {g g' : ℝ → ℝ}
    (hg : ∀ x, HasDerivAt g (g' x) x) (hlow : ∀ x ∈ Set.Icc a b, μ ≤ g' x) :
    ∃ c ∈ Set.Icc a b, (∀ x ∈ Set.Icc a b, c < x → μ * (x - c) ≤ g x)
      ∧ ∀ x ∈ Set.Icc a b, x < c → g x ≤ μ * (x - c) := by
  have hgc : Continuous g := continuous_of_hasDerivAt hg
  -- `x ↦ g x - μ x` is monotone on `[a, b]`
  have hmono : MonotoneOn (fun x => g x - μ * x) (Set.Icc a b) := by
    refine monotoneOn_of_hasDerivWithinAt_nonneg (convex_Icc a b)
      ((hgc.sub (continuous_const.mul continuous_id)).continuousOn)
      (f' := fun x => g' x - μ) (fun x _ => ?_) (fun x hx => ?_)
    · have h := (hg x).sub ((hasDerivAt_id x).const_mul μ)
      simp only [mul_one, id] at h
      exact h.hasDerivWithinAt
    · have := hlow x (interior_subset (by simpa using hx))
      linarith
  have hgrow : ∀ x ∈ Set.Icc a b, ∀ y ∈ Set.Icc a b, x ≤ y → μ * (y - x) ≤ g y - g x := by
    intro x hx y hy hxy
    have := hmono hx hy hxy
    simp only at this
    linarith
  rcases lt_or_ge (g a) 0 with hga | hga
  swap
  · refine ⟨a, Set.left_mem_Icc.mpr hab, ?_, ?_⟩
    · intro x hx hax
      have := hgrow a (Set.left_mem_Icc.mpr hab) x hx hax.le
      linarith
    · intro x hx hxa
      exact absurd hx.1 (not_le.mpr hxa)
  rcases lt_or_ge 0 (g b) with hgb | hgb
  swap
  · refine ⟨b, Set.right_mem_Icc.mpr hab, ?_, ?_⟩
    · intro x hx hbx
      exact absurd hx.2 (not_le.mpr hbx)
    · intro x hx hxb
      have := hgrow x hx b (Set.right_mem_Icc.mpr hab) hxb.le
      have hmul : μ * (b - x) ≤ g b - g x := this
      nlinarith [hmul]
  · have hmem : (0 : ℝ) ∈ Set.Icc (g a) (g b) := ⟨hga.le, hgb.le⟩
    obtain ⟨c, hc, hc0⟩ := intermediate_value_Icc hab hgc.continuousOn hmem
    refine ⟨c, hc, ?_, ?_⟩
    · intro x hx hcx
      have := hgrow c hc x hx hcx.le
      rw [hc0] at this
      linarith
    · intro x hx hxc
      have := hgrow x hx c hc hxc.le
      rw [hc0] at this
      nlinarith [this]


/-- The three-piece split used by the induction: the middle piece, a neighbourhood of the centre
clipped to `[a, b]`, has length at most `2 δ`, and the two outer pieces are estimated by the
inductive hypothesis. -/
theorem norm_integral_expPhase_split {a b c δ K : ℝ} (hab : a ≤ b) (hδ : 0 < δ)
    {φ : ℝ → ℝ} (hφc : Continuous φ)
    (hleft : ‖∫ x in a..(max a (min b (c - δ))), expPhase φ x‖ ≤ K)
    (hright : ‖∫ x in (min b (max a (c + δ)))..b, expPhase φ x‖ ≤ K) :
    ‖∫ x in a..b, expPhase φ x‖ ≤ 2 * K + 2 * δ := by
  set p : ℝ := max a (min b (c - δ)) with hp
  set q : ℝ := min b (max a (c + δ)) with hq
  have hap : a ≤ p := le_max_left _ _
  have hpb : p ≤ b := max_le hab (min_le_left _ _)
  have haq : a ≤ q := le_min hab (le_max_left _ _)
  have hqb : q ≤ b := min_le_left _ _
  have hpq : p ≤ q := by
    rw [hp, hq]
    refine max_le (le_min hab (le_max_left _ _)) (le_min (min_le_left _ _) ?_)
    exact le_trans (min_le_right _ _) (le_trans (by linarith) (le_max_right _ _))
  have hlen : q - p ≤ 2 * δ := by
    rw [hp, hq]
    simp only [min_def, max_def]
    split_ifs <;> linarith
  have hint : ∀ u v : ℝ, IntervalIntegrable (expPhase φ) volume u v := fun u v =>
    (continuous_expPhase hφc).intervalIntegrable u v
  have hsplit1 := intervalIntegral.integral_add_adjacent_intervals
    (a := a) (b := p) (c := q) (hint a p) (hint p q)
  have hsplit2 := intervalIntegral.integral_add_adjacent_intervals
    (a := a) (b := q) (c := b) (hint a q) (hint q b)
  have hmid : ‖∫ x in p..q, expPhase φ x‖ ≤ 2 * δ := by
    have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := p) (b := q)
      (f := expPhase φ) (C := 1) fun x _ => le_of_eq (norm_expPhase φ x)
    rw [one_mul, abs_of_nonneg (by linarith : (0 : ℝ) ≤ q - p)] at h
    linarith
  rw [← hsplit2, ← hsplit1]
  calc ‖(∫ x in a..p, expPhase φ x) + (∫ x in p..q, expPhase φ x)
        + ∫ x in q..b, expPhase φ x‖
      ≤ ‖(∫ x in a..p, expPhase φ x) + ∫ x in p..q, expPhase φ x‖
        + ‖∫ x in q..b, expPhase φ x‖ := norm_add_le _ _
    _ ≤ (‖∫ x in a..p, expPhase φ x‖ + ‖∫ x in p..q, expPhase φ x‖)
        + ‖∫ x in q..b, expPhase φ x‖ := by
        gcongr
        exact norm_add_le _ _
    _ ≤ (K + 2 * δ) + K := by gcongr
    _ = 2 * K + 2 * δ := by ring


/-- The centre splits `[a, b]` into a left piece on which the derivative chain is at most
`-(μ δ)`, a middle piece of length at most `2 δ`, and a right piece on which it is at least
`μ δ`.  These are the two pointwise bounds on the outer pieces. -/
theorem center_bounds {a b c δ μ : ℝ} (hδ : 0 < δ) (hμ : 0 < μ) {g : ℝ → ℝ}
    (hcl : ∀ x ∈ Set.Icc a b, x < c → g x ≤ μ * (x - c))
    (hcr : ∀ x ∈ Set.Icc a b, c < x → μ * (x - c) ≤ g x) :
    (∀ p, a ≤ p → p ≤ b → p ≤ c - δ → ∀ x ∈ Set.Icc a p, g x ≤ -(μ * δ))
      ∧ ∀ q, a ≤ q → q ≤ b → c + δ ≤ q → ∀ x ∈ Set.Icc q b, μ * δ ≤ g x := by
  constructor
  · intro p _ hpb hpc x hx
    have hxb : x ∈ Set.Icc a b := ⟨hx.1, le_trans hx.2 hpb⟩
    have hxc : x < c := by
      have := hx.2
      linarith
    have h := hcl x hxb hxc
    have hxd : x - c ≤ -δ := by
      have := hx.2
      linarith
    nlinarith [mul_le_mul_of_nonneg_left hxd hμ.le]
  · intro q hqa _ hqc x hx
    have hxb : x ∈ Set.Icc a b := ⟨le_trans hqa hx.1, hx.2⟩
    have hcx : c < x := by
      have := hx.1
      linarith
    have h := hcr x hxb hcx
    have hxd : δ ≤ x - c := by
      have := hx.1
      linarith
    nlinarith [mul_le_mul_of_nonneg_left hxd hμ.le]

/-- **The order-`k` van der Corput estimate**, `k ≥ 2`: if the `k`-th derivative of the phase is
at least `μ > 0` on `[a, b]` then `‖∫ exp (i φ)‖ ≤ C k * μ ^ (-1 / k)`, with `C k` depending only
on `k`.  The derivative chain is given as a family `D` with `D 0 = φ` and `D (j+1)` the derivative
of `D j`. -/
theorem exists_vdc_bound : ∀ n : ℕ, ∃ C : ℝ, 1 ≤ C ∧
    ∀ D : ℕ → ℝ → ℝ, (∀ j, j < n + 2 → ∀ x, HasDerivAt (D j) (D (j + 1) x) x) →
      Continuous (D (n + 2)) →
      ∀ a b μ : ℝ, a ≤ b → 0 < μ → (∀ x ∈ Set.Icc a b, μ ≤ D (n + 2) x) →
        ‖∫ x in a..b, expPhase (D 0) x‖ ≤ C * μ ^ (-(1 : ℝ) / (n + 2)) := by
  intro n
  induction n with
  | zero =>
      refine ⟨10, by norm_num, ?_⟩
      intro D hD hDc a b μ hab hμ hlow
      have hφc : Continuous (D 0) := continuous_of_hasDerivAt (hD 0 (by omega))
      set δ : ℝ := μ ^ (-(1 : ℝ) / 2) with hδdef
      have hδ : 0 < δ := Real.rpow_pos_of_pos hμ _
      have hμδ : 0 < μ * δ := mul_pos hμ hδ
      have hprod : μ * δ = μ ^ ((1 : ℝ) / 2) := by
        rw [hδdef]
        nth_rewrite 1 [← Real.rpow_one μ]
        rw [← Real.rpow_add hμ]
        norm_num
      obtain ⟨c, _, hcr, hcl⟩ :=
        exists_center_of_deriv_ge hab (g := D 1) (g' := D 2) (hD 1 (by omega))
          (by simpa using hlow)
      obtain ⟨hbl, hbr⟩ := center_bounds hδ hμ hcl hcr
      set p : ℝ := max a (min b (c - δ)) with hp
      set q : ℝ := min b (max a (c + δ)) with hq
      have hap : a ≤ p := le_max_left _ _
      have hpb : p ≤ b := max_le hab (min_le_left _ _)
      have haq : a ≤ q := le_min hab (le_max_left _ _)
      have hqb : q ≤ b := min_le_left _ _
      have hK0 : (0 : ℝ) ≤ 4 / (μ * δ) := by positivity
      have hmono2 : ∀ u v : ℝ, a ≤ u → v ≤ b → ∀ x ∈ Set.Icc u v, 0 ≤ D 2 x := by
        intro u v hu hv x hx
        have := hlow x ⟨le_trans hu hx.1, le_trans hx.2 hv⟩
        linarith
      have hleft : ‖∫ x in a..p, expPhase (D 0) x‖ ≤ 4 / (μ * δ) := by
        by_cases hlt : a < p
        · have hpc : p ≤ c - δ := by
            rcases max_cases a (min b (c - δ)) with ⟨he, _⟩ | ⟨he, _⟩
            · rw [hp, he] at hlt; exact absurd hlt (lt_irrefl a)
            · rw [hp, he]; exact min_le_right _ _
          refine norm_integral_expPhase_le_of_deriv_monotone hap hμδ
            (hD 0 (by omega)) (hD 1 (by omega)) hDc ?_ (Or.inl ?_)
          · intro x hx
            have h1 := hbl p hap hpb hpc x hx
            calc μ * δ = -(-(μ * δ)) := by ring
              _ ≤ -D 1 x := by linarith
              _ ≤ |D 1 x| := neg_le_abs _
          · exact hmono2 a p le_rfl hpb
        · have hpa : p = a := le_antisymm (not_lt.mp hlt) hap
          rw [hpa, intervalIntegral.integral_same, norm_zero]
          exact hK0
      have hright : ‖∫ x in q..b, expPhase (D 0) x‖ ≤ 4 / (μ * δ) := by
        by_cases hlt : q < b
        · have hqc : c + δ ≤ q := by
            rcases min_cases b (max a (c + δ)) with ⟨he, _⟩ | ⟨he, _⟩
            · rw [hq, he] at hlt; exact absurd hlt (lt_irrefl b)
            · rw [hq, he]; exact le_max_right _ _
          refine norm_integral_expPhase_le_of_deriv_monotone hqb hμδ
            (hD 0 (by omega)) (hD 1 (by omega)) hDc ?_ (Or.inl ?_)
          · intro x hx
            have h1 := hbr q haq hqb hqc x hx
            calc μ * δ ≤ D 1 x := h1
              _ ≤ |D 1 x| := le_abs_self _
          · exact hmono2 q b haq le_rfl
        · have hqbe : q = b := le_antisymm hqb (not_lt.mp hlt)
          rw [hqbe, intervalIntegral.integral_same, norm_zero]
          exact hK0
      have hsplit := norm_integral_expPhase_split (c := c) hab hδ hφc hleft hright
      refine le_trans hsplit ?_
      have hinv : 4 / (μ * δ) = 4 * δ := by
        rw [hprod, hδdef, div_eq_mul_inv, ← Real.rpow_neg_one, ← Real.rpow_mul hμ.le]
        norm_num
      have hrhs : μ ^ (-(1 : ℝ) / (((0 : ℕ) : ℝ) + 2)) = δ := by
        rw [hδdef]
        norm_num
      rw [hinv, hrhs]
      linarith
  | succ n ih =>
      obtain ⟨C, hC1, hC⟩ := ih
      refine ⟨2 * C + 2, by linarith, ?_⟩
      intro D hD hDc a b μ hab hμ hlow
      have hn2 : ((n : ℝ) + 2) ≠ 0 := by positivity
      have hn3 : ((n : ℝ) + 3) ≠ 0 := by positivity
      have hφc : Continuous (D 0) := continuous_of_hasDerivAt (hD 0 (by omega))
      have hDc' : Continuous (D (n + 2)) := continuous_of_hasDerivAt (hD (n + 2) (by omega))
      have hDlow : ∀ j, j < n + 2 → ∀ x, HasDerivAt (D j) (D (j + 1) x) x :=
        fun j hj => hD j (by omega)
      have hlow' : ∀ x ∈ Set.Icc a b, μ ≤ D (n + 3) x := by
        intro x hx
        have := hlow x hx
        simpa using this
      set δ : ℝ := μ ^ (-(1 : ℝ) / ((n : ℝ) + 3)) with hδdef
      have hδ : 0 < δ := Real.rpow_pos_of_pos hμ _
      have hμδ : 0 < μ * δ := mul_pos hμ hδ
      have hprod : μ * δ = μ ^ (((n : ℝ) + 2) / ((n : ℝ) + 3)) := by
        rw [hδdef]
        nth_rewrite 1 [← Real.rpow_one μ]
        rw [← Real.rpow_add hμ]
        congr 1
        field_simp
        ring
      have hKδ : (μ * δ) ^ (-(1 : ℝ) / ((n : ℝ) + 2)) = δ := by
        rw [hprod, ← Real.rpow_mul hμ.le, hδdef]
        congr 1
        field_simp
      have hK0 : (0 : ℝ) ≤ C * (μ * δ) ^ (-(1 : ℝ) / ((n : ℝ) + 2)) := by
        rw [hKδ]
        positivity
      obtain ⟨c, _, hcr, hcl⟩ :=
        exists_center_of_deriv_ge hab (g := D (n + 2)) (g' := D (n + 3))
          (by simpa using hD (n + 2) (by omega)) hlow'
      obtain ⟨hbl, hbr⟩ := center_bounds hδ hμ hcl hcr
      set p : ℝ := max a (min b (c - δ)) with hp
      set q : ℝ := min b (max a (c + δ)) with hq
      have hap : a ≤ p := le_max_left _ _
      have hpb : p ≤ b := max_le hab (min_le_left _ _)
      have haq : a ≤ q := le_min hab (le_max_left _ _)
      have hqb : q ≤ b := min_le_left _ _
      have hnegint : ∀ u v : ℝ, ‖∫ x in u..v, expPhase (fun y => -D 0 y) x‖
          = ‖∫ x in u..v, expPhase (D 0) x‖ := by
        intro u v
        rw [integral_expPhase_neg, RCLike.norm_conj]
      have hleft : ‖∫ x in a..p, expPhase (D 0) x‖
          ≤ C * (μ * δ) ^ (-(1 : ℝ) / ((n : ℝ) + 2)) := by
        by_cases hlt : a < p
        · have hpc : p ≤ c - δ := by
            rcases max_cases a (min b (c - δ)) with ⟨he, _⟩ | ⟨he, _⟩
            · rw [hp, he] at hlt; exact absurd hlt (lt_irrefl a)
            · rw [hp, he]; exact min_le_right _ _
          have hIH := hC (fun j x => -D j x) (fun j _ x => (hD j (by omega) x).neg)
            hDc'.neg a p (μ * δ) hap hμδ (fun x hx => by
              have h := hbl p hap hpb hpc x hx
              exact (by linarith : μ * δ ≤ -D (n + 2) x))
          rw [hnegint] at hIH
          exact hIH
        · have hpa : p = a := le_antisymm (not_lt.mp hlt) hap
          rw [hpa, intervalIntegral.integral_same, norm_zero]
          exact hK0
      have hright : ‖∫ x in q..b, expPhase (D 0) x‖
          ≤ C * (μ * δ) ^ (-(1 : ℝ) / ((n : ℝ) + 2)) := by
        by_cases hlt : q < b
        · have hqc : c + δ ≤ q := by
            rcases min_cases b (max a (c + δ)) with ⟨he, _⟩ | ⟨he, _⟩
            · rw [hq, he] at hlt; exact absurd hlt (lt_irrefl b)
            · rw [hq, he]; exact le_max_right _ _
          exact hC D hDlow hDc' q b (μ * δ) hqb hμδ (fun x hx => hbr q haq hqb hqc x hx)
        · have hqbe : q = b := le_antisymm hqb (not_lt.mp hlt)
          rw [hqbe, intervalIntegral.integral_same, norm_zero]
          exact hK0
      have hsplit := norm_integral_expPhase_split (c := c) hab hδ hφc hleft hright
      rw [hKδ] at hsplit
      have hrhs : μ ^ (-(1 : ℝ) / (((n + 1 : ℕ) : ℝ) + 2)) = δ := by
        rw [hδdef]
        congr 1
        push_cast
        ring
      rw [hrhs]
      linarith


/-! ## Polynomial phases: coefficient bookkeeping

The corollary for polynomial phases needs two facts about coefficients.  First, all derivatives of
a polynomial are bounded on `[-1, 1]` by a fixed multiple of the largest coefficient, which lets a
lower bound on one derivative at a point persist on an interval of a fixed length.  Second, the
coefficients of the shifted polynomial `f (c + ·)`, for `|c| ≤ 1`, dominate those of `f` up to a
fixed factor -- this is the statement that the binomial shift matrix has a bounded inverse, and it
holds because the inverse is the shift by `-c`. -/

theorem abs_eval_le_sum_abs_coeff {p : Polynomial ℝ} {D : ℕ} (hD : p.natDegree ≤ D) {x : ℝ}
    (hx : |x| ≤ 1) : |p.eval x| ≤ ∑ n ∈ Finset.range (D + 1), |p.coeff n| := by
  rw [Polynomial.eval_eq_sum_range' (by omega : p.natDegree < D + 1)]
  refine le_trans (Finset.abs_sum_le_sum_abs _ _) (Finset.sum_le_sum fun n _ => ?_)
  rw [abs_mul, abs_pow]
  calc |p.coeff n| * |x| ^ n ≤ |p.coeff n| * 1 ^ n :=
        mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (abs_nonneg x) hx n) (abs_nonneg _)
    _ = |p.coeff n| := by rw [one_pow, mul_one]

theorem coeff_iterate_derivative_real (f : Polynomial ℝ) (j n : ℕ) :
    (Polynomial.derivative^[j] f).coeff n
      = ((Nat.factorial j : ℕ) : ℝ) * ((n + j).choose j) * f.coeff (n + j) := by
  rw [Polynomial.coeff_iterate_derivative, Nat.descFactorial_eq_factorial_mul_choose,
    nsmul_eq_mul]
  push_cast
  ring

/-- Every coefficient of every derivative of order at least one is bounded by a fixed multiple of
the largest coefficient of index at least one. -/
theorem abs_coeff_iterate_derivative_le {f : Polynomial ℝ} {d : ℕ} (hd : f.natDegree ≤ d)
    {A : ℝ} (hA : ∀ m, 1 ≤ m → |f.coeff m| ≤ A) {j : ℕ} (hj : 1 ≤ j) (n : ℕ) :
    |(Polynomial.derivative^[j] f).coeff n| ≤ ((Nat.factorial d : ℕ) : ℝ) * 2 ^ d * A := by
  have hA0 : (0 : ℝ) ≤ A := le_trans (abs_nonneg _) (hA 1 le_rfl)
  rw [coeff_iterate_derivative_real]
  by_cases hnd : n + j ≤ d
  · have h1 : ((Nat.factorial j : ℕ) : ℝ) ≤ ((Nat.factorial d : ℕ) : ℝ) := by
      exact_mod_cast Nat.factorial_le (by omega)
    have h2 : (((n + j).choose j : ℕ) : ℝ) ≤ (2 : ℝ) ^ d := by
      have h3 : ((n + j).choose j) ≤ 2 ^ (n + j) := Nat.choose_le_two_pow _ _
      have h4 : (2 : ℕ) ^ (n + j) ≤ 2 ^ d := Nat.pow_le_pow_right (by norm_num) hnd
      exact_mod_cast le_trans h3 h4
    have h5 : |f.coeff (n + j)| ≤ A := hA (n + j) (by omega)
    rw [abs_mul, abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ ((Nat.factorial j : ℕ) : ℝ)),
      abs_of_nonneg (by positivity : (0 : ℝ) ≤ (((n + j).choose j : ℕ) : ℝ))]
    have hj0 : (0 : ℝ) ≤ ((Nat.factorial j : ℕ) : ℝ) := by positivity
    have hc0 : (0 : ℝ) ≤ (((n + j).choose j : ℕ) : ℝ) := by positivity
    calc ((Nat.factorial j : ℕ) : ℝ) * (((n + j).choose j : ℕ) : ℝ) * |f.coeff (n + j)|
        ≤ ((Nat.factorial d : ℕ) : ℝ) * (2 : ℝ) ^ d * A := by
          refine mul_le_mul (mul_le_mul h1 h2 hc0 (by positivity)) h5 (abs_nonneg _) (by positivity)
      _ = ((Nat.factorial d : ℕ) : ℝ) * 2 ^ d * A := rfl
  · have hz : f.coeff (n + j) = 0 := Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
    rw [hz, mul_zero, abs_zero]
    positivity

/-- The bound on the derivatives of a polynomial on the unit interval. -/
theorem abs_eval_iterate_derivative_le {f : Polynomial ℝ} {d : ℕ} (hd : f.natDegree ≤ d)
    {A : ℝ} (hA : ∀ m, 1 ≤ m → |f.coeff m| ≤ A) {j : ℕ} (hj : 1 ≤ j) {x : ℝ} (hx : |x| ≤ 1) :
    |(Polynomial.derivative^[j] f).eval x|
      ≤ ((d : ℝ) + 1) * (((Nat.factorial d : ℕ) : ℝ) * 2 ^ d * A) := by
  have hdeg : (Polynomial.derivative^[j] f).natDegree ≤ d :=
    le_trans (le_trans (Polynomial.natDegree_iterate_derivative f j) (Nat.sub_le _ _)) hd
  refine le_trans (abs_eval_le_sum_abs_coeff hdeg hx) ?_
  calc (∑ n ∈ Finset.range (d + 1), |(Polynomial.derivative^[j] f).coeff n|)
      ≤ ∑ _n ∈ Finset.range (d + 1), ((Nat.factorial d : ℕ) : ℝ) * 2 ^ d * A :=
        Finset.sum_le_sum fun n _ => abs_coeff_iterate_derivative_le hd hA hj n
    _ = ((d : ℝ) + 1) * (((Nat.factorial d : ℕ) : ℝ) * 2 ^ d * A) := by
        rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
        push_cast
        ring

theorem taylor_neg_taylor (c : ℝ) (f : Polynomial ℝ) :
    Polynomial.taylor (-c) (Polynomial.taylor c f) = f := by
  refine Polynomial.funext fun x => ?_
  rw [Polynomial.taylor_eval, Polynomial.taylor_eval]
  ring_nf

/-- **The shift has a bounded inverse.**  For `|c| ≤ 1`, every coefficient of `f` of index at
least one is bounded by a fixed multiple of the largest coefficient of index at least one of the
shifted polynomial `f (c + ·)`.  The shift by `-c` inverts the shift by `c`, and its matrix
entries are binomial coefficients times powers of `c`. -/
theorem abs_coeff_le_taylor {f : Polynomial ℝ} {d : ℕ} (hd : f.natDegree ≤ d) {c : ℝ}
    (hc : |c| ≤ 1) {B : ℝ} (hB : ∀ r, 1 ≤ r → |(Polynomial.taylor c f).coeff r| ≤ B)
    {m : ℕ} (hm : 1 ≤ m) : |f.coeff m| ≤ ((d : ℝ) + 1) * 2 ^ d * B := by
  have hB0 : (0 : ℝ) ≤ B := le_trans (abs_nonneg _) (hB 1 le_rfl)
  set g : Polynomial ℝ := Polynomial.taylor c f with hg
  have hgd : g.natDegree ≤ d := by rw [hg, Polynomial.natDegree_taylor]; exact hd
  have hfc : f.coeff m = (Polynomial.hasseDeriv m g).eval (-c) := by
    conv_lhs => rw [← taylor_neg_taylor c f]
    rw [← hg, Polynomial.taylor_coeff]
  have hhd : (Polynomial.hasseDeriv m g).natDegree ≤ d :=
    le_trans (le_trans (Polynomial.natDegree_hasseDeriv_le g m) (Nat.sub_le _ _)) hgd
  rw [hfc, Polynomial.eval_eq_sum_range' (by omega : (Polynomial.hasseDeriv m g).natDegree < d + 1)]
  refine le_trans (Finset.abs_sum_le_sum_abs _ _) ?_
  have hterm : ∀ n ∈ Finset.range (d + 1),
      |(Polynomial.hasseDeriv m g).coeff n * (-c) ^ n| ≤ (2 : ℝ) ^ d * B := by
    intro n _
    rw [abs_mul, abs_pow, abs_neg, Polynomial.hasseDeriv_coeff]
    by_cases hnd : n + m ≤ d
    · have h2 : (((n + m).choose m : ℕ) : ℝ) ≤ (2 : ℝ) ^ d := by
        have h3 : ((n + m).choose m) ≤ 2 ^ (n + m) := Nat.choose_le_two_pow _ _
        have h4 : (2 : ℕ) ^ (n + m) ≤ 2 ^ d := Nat.pow_le_pow_right (by norm_num) hnd
        exact_mod_cast le_trans h3 h4
      have h5 : |g.coeff (n + m)| ≤ B := hB (n + m) (by omega)
      rw [abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ (((n + m).choose m : ℕ) : ℝ))]
      calc (((n + m).choose m : ℕ) : ℝ) * |g.coeff (n + m)| * |c| ^ n
          ≤ (2 : ℝ) ^ d * B * 1 ^ n := by
            refine mul_le_mul (mul_le_mul h2 h5 (abs_nonneg _) (by positivity))
              (pow_le_pow_left₀ (abs_nonneg c) hc n) (by positivity) (by positivity)
        _ = (2 : ℝ) ^ d * B := by rw [one_pow, mul_one]
    · have hz : g.coeff (n + m) = 0 := Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
      rw [hz, mul_zero, abs_zero, zero_mul]
      positivity
  calc (∑ n ∈ Finset.range (d + 1), |(Polynomial.hasseDeriv m g).coeff n * (-c) ^ n|)
      ≤ ∑ _n ∈ Finset.range (d + 1), (2 : ℝ) ^ d * B := Finset.sum_le_sum hterm
    _ = ((d : ℝ) + 1) * 2 ^ d * B := by
        rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
        push_cast
        ring


/-! ## Localization: a lower bound on one derivative on an interval of fixed length

At every point `c` of `[-1, 1]` some derivative of order at least one is bounded below by a fixed
multiple of the largest coefficient; the next derivative is bounded above by a fixed multiple of
the same quantity, so that lower bound survives, halved and with a definite sign, on an interval
of a fixed length. -/

/-- The derivative chain of a polynomial. -/
noncomputable def polyD (f : Polynomial ℝ) (j : ℕ) (x : ℝ) : ℝ :=
  (Polynomial.derivative^[j] f).eval x

theorem hasDerivAt_polyD (f : Polynomial ℝ) (j : ℕ) (x : ℝ) :
    HasDerivAt (polyD f j) (polyD f (j + 1) x) x := by
  have h := (Polynomial.derivative^[j] f).hasDerivAt (𝕜 := ℝ) x
  have he : polyD f (j + 1) x = (Polynomial.derivative^[j] f).derivative.eval x := by
    simp only [polyD, Function.iterate_succ_apply']
  rw [he]
  exact h

theorem continuous_polyD (f : Polynomial ℝ) (j : ℕ) : Continuous (polyD f j) :=
  (Polynomial.derivative^[j] f).continuous

/-- The constant in the bound for the inverse of the binomial shift matrix. -/
noncomputable def vdcShiftConst (d : ℕ) : ℝ := ((d : ℝ) + 1) * 2 ^ d

/-- The constant bounding all derivatives of order at least one on the unit interval. -/
noncomputable def vdcDerivConst (d : ℕ) : ℝ :=
  ((d : ℝ) + 1) * (((Nat.factorial d : ℕ) : ℝ) * 2 ^ d)

theorem vdcShiftConst_pos (d : ℕ) : 0 < vdcShiftConst d := by
  rw [vdcShiftConst]; positivity

theorem vdcDerivConst_pos (d : ℕ) : 0 < vdcDerivConst d := by
  rw [vdcDerivConst]
  have hf : (0 : ℝ) < ((Nat.factorial d : ℕ) : ℝ) := by
    exact_mod_cast Nat.factorial_pos d
  positivity

theorem one_le_vdcShiftConst (d : ℕ) : 1 ≤ vdcShiftConst d := by
  rw [vdcShiftConst]
  have h0 : (0 : ℝ) ≤ (d : ℝ) := Nat.cast_nonneg d
  have h2 : (1 : ℝ) ≤ (2 : ℝ) ^ d := one_le_pow₀ (by norm_num)
  nlinarith

theorem polyD_eq_factorial_mul_taylor_coeff (f : Polynomial ℝ) (r : ℕ) (c : ℝ) :
    polyD f r c = ((Nat.factorial r : ℕ) : ℝ) * (Polynomial.taylor c f).coeff r := by
  rw [Polynomial.taylor_coeff, polyD, ← Polynomial.factorial_smul_hasseDeriv,
    LinearMap.smul_apply, Polynomial.eval_smul, nsmul_eq_mul]

/-- **At every point of the unit interval some derivative of order at least one is large.**
The index `r` lies between `1` and `d`.  This is where the bounded inverse of the shift is used:
the coefficients of `f (c + ·)` cannot all be small if one coefficient of `f` is large. -/
theorem exists_large_deriv {f : Polynomial ℝ} {d : ℕ} (hd : f.natDegree ≤ d) (hd1 : 1 ≤ d)
    {A : ℝ} {m₀ : ℕ} (hm₀ : 1 ≤ m₀) (hm₀A : A ≤ |f.coeff m₀|)
    {c : ℝ} (hc : |c| ≤ 1) :
    ∃ r, 1 ≤ r ∧ r ≤ d ∧ A / vdcShiftConst d ≤ |polyD f r c| := by
  classical
  have hne : (Finset.Icc 1 d).Nonempty := ⟨1, Finset.mem_Icc.mpr ⟨le_rfl, hd1⟩⟩
  set B : ℝ := (Finset.Icc 1 d).sup' hne (fun r => |(Polynomial.taylor c f).coeff r|) with hBdef
  have hgd : (Polynomial.taylor c f).natDegree ≤ d := by
    rw [Polynomial.natDegree_taylor]; exact hd
  have hB1 : |(Polynomial.taylor c f).coeff 1| ≤ B :=
    Finset.le_sup' (f := fun r => |(Polynomial.taylor c f).coeff r|)
      (Finset.mem_Icc.mpr ⟨le_rfl, hd1⟩)
  have hB0 : 0 ≤ B := le_trans (abs_nonneg _) hB1
  have hB : ∀ r, 1 ≤ r → |(Polynomial.taylor c f).coeff r| ≤ B := by
    intro r hr
    by_cases hrd : r ≤ d
    · exact Finset.le_sup' (f := fun r => |(Polynomial.taylor c f).coeff r|)
        (Finset.mem_Icc.mpr ⟨hr, hrd⟩)
    · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), abs_zero]
      exact hB0
  obtain ⟨r, hrmem, hrB⟩ :=
    Finset.exists_mem_eq_sup' hne (fun r => |(Polynomial.taylor c f).coeff r|)
  rw [Finset.mem_Icc] at hrmem
  refine ⟨r, hrmem.1, hrmem.2, ?_⟩
  have hAB : A ≤ vdcShiftConst d * B := by
    refine le_trans hm₀A ?_
    rw [vdcShiftConst]
    exact abs_coeff_le_taylor hd hc hB hm₀
  have hr1 : (1 : ℝ) ≤ ((Nat.factorial r : ℕ) : ℝ) := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Nat.factorial_ne_zero r)
  have hBr : B ≤ |polyD f r c| := by
    rw [polyD_eq_factorial_mul_taylor_coeff, abs_mul,
      abs_of_nonneg (by positivity : (0 : ℝ) ≤ ((Nat.factorial r : ℕ) : ℝ)), ← hrB]
    nlinarith
  rw [div_le_iff₀ (vdcShiftConst_pos d)]
  calc A ≤ vdcShiftConst d * B := hAB
    _ ≤ |polyD f r c| * vdcShiftConst d := by
        rw [mul_comm]
        exact mul_le_mul_of_nonneg_right hBr (vdcShiftConst_pos d).le

/-- The lower bound at a point persists, halved and with a definite sign, on an interval of a
fixed length. -/
theorem polyD_signed_lower {f : Polynomial ℝ} {d : ℕ} (hd : f.natDegree ≤ d)
    {A : ℝ} (hA : ∀ m, 1 ≤ m → |f.coeff m| ≤ A) {r : ℕ} (hr : 1 ≤ r)
    {c ρ μ₀ : ℝ} (hcA : μ₀ ≤ |polyD f r c|)
    (hsmall : vdcDerivConst d * A * ρ ≤ μ₀ / 2)
    (hIcc : ∀ x ∈ Set.Icc c (c + ρ), |x| ≤ 1) :
    (∀ x ∈ Set.Icc c (c + ρ), μ₀ / 2 ≤ polyD f r x)
      ∨ ∀ x ∈ Set.Icc c (c + ρ), μ₀ / 2 ≤ -polyD f r x := by
  have hA0 : (0 : ℝ) ≤ A := le_trans (abs_nonneg _) (hA 1 le_rfl)
  have hbd : ∀ x ∈ Set.Icc c (c + ρ), |polyD f r x - polyD f r c| ≤ μ₀ / 2 := by
    intro x hx
    have hsub : Set.Icc c x ⊆ Set.Icc c (c + ρ) := Set.Icc_subset_Icc le_rfl hx.2
    have hderiv : ∀ y ∈ Set.Icc c x, ‖polyD f (r + 1) y‖ ≤ vdcDerivConst d * A := by
      intro y hy
      have h := abs_eval_iterate_derivative_le (j := r + 1) hd hA (by omega)
        (hIcc y (hsub hy))
      simp only [Real.norm_eq_abs, polyD]
      calc |(Polynomial.derivative^[r + 1] f).eval y|
          ≤ ((d : ℝ) + 1) * (((Nat.factorial d : ℕ) : ℝ) * 2 ^ d * A) := h
        _ = vdcDerivConst d * A := by rw [vdcDerivConst]; ring
    have hmvt := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le
      (f := polyD f r) (f' := fun y => polyD f (r + 1) y) (C := vdcDerivConst d * A)
      (s := Set.Icc c x)
      (fun y _ => (hasDerivAt_polyD f r y).hasDerivWithinAt)
      hderiv (convex_Icc c x)
      (Set.left_mem_Icc.mpr hx.1) (Set.right_mem_Icc.mpr hx.1)
    have hc0 : (0 : ℝ) ≤ x - c := by
      have h := hx.1
      linarith
    have hlen : x - c ≤ ρ := by
      have h := hx.2
      linarith
    have hstep : |polyD f r x - polyD f r c| ≤ vdcDerivConst d * A * (x - c) := by
      simpa [Real.norm_eq_abs, abs_of_nonneg hc0] using hmvt
    have hmono : vdcDerivConst d * A * (x - c) ≤ vdcDerivConst d * A * ρ :=
      mul_le_mul_of_nonneg_left hlen (mul_nonneg (vdcDerivConst_pos d).le hA0)
    linarith
  rcases le_or_gt 0 (polyD f r c) with hpos | hneg
  · left
    intro x hx
    have h1 := abs_le.mp (hbd x hx)
    have h2 : μ₀ ≤ polyD f r c := by rwa [abs_of_nonneg hpos] at hcA
    linarith [h1.1]
  · right
    intro x hx
    have h1 := abs_le.mp (hbd x hx)
    have h2 : μ₀ ≤ -polyD f r c := by rwa [abs_of_neg hneg] at hcA
    linarith [h1.2]


/-! ## The estimate on one subinterval of fixed length

At the left endpoint `c` some derivative of order `r` between `1` and `d` is bounded below by
`A / K`, and the bound persists, halved and signed, on the whole subinterval.  For `r ≥ 2` the
order-`r` estimate applies directly; for `r = 1` there is no monotonicity, and the form with a
bounded second derivative is used instead, which is where the length of the subinterval enters. -/

theorem polyD_zero (f : Polynomial ℝ) : polyD f 0 = fun x => f.eval x := rfl

/-- A choice of constant in the order-`k` van der Corput estimate. -/
noncomputable def vdcConst (n : ℕ) : ℝ := Classical.choose (exists_vdc_bound n)

theorem one_le_vdcConst (n : ℕ) : 1 ≤ vdcConst n :=
  (Classical.choose_spec (exists_vdc_bound n)).1

theorem vdcConst_spec (n : ℕ) (D : ℕ → ℝ → ℝ)
    (hD : ∀ j, j < n + 2 → ∀ x, HasDerivAt (D j) (D (j + 1) x) x)
    (hDc : Continuous (D (n + 2))) (a b μ : ℝ) (hab : a ≤ b) (hμ : 0 < μ)
    (hlow : ∀ x ∈ Set.Icc a b, μ ≤ D (n + 2) x) :
    ‖∫ x in a..b, expPhase (D 0) x‖ ≤ vdcConst n * μ ^ (-(1 : ℝ) / (n + 2)) :=
  (Classical.choose_spec (exists_vdc_bound n)).2 D hD hDc a b μ hab hμ hlow

/-- The largest of the order-`k` constants for `k` at most `d`. -/
noncomputable def vdcMax (d : ℕ) : ℝ :=
  (Finset.range (d + 1)).sup' ⟨0, Finset.mem_range.mpr (Nat.succ_pos d)⟩ vdcConst

theorem one_le_vdcMax (d : ℕ) : 1 ≤ vdcMax d :=
  le_trans (one_le_vdcConst 0) (Finset.le_sup' vdcConst (Finset.mem_range.mpr (by omega)))

theorem vdcConst_le_vdcMax {n d : ℕ} (hn : n ≤ d) : vdcConst n ≤ vdcMax d :=
  Finset.le_sup' vdcConst (Finset.mem_range.mpr (by omega))

/-- The constant in the estimate on one subinterval. -/
noncomputable def vdcPieceConst (d : ℕ) : ℝ :=
  2 * vdcShiftConst d * vdcMax d + 4 * vdcShiftConst d
    + 4 * vdcDerivConst d * vdcShiftConst d ^ 2

theorem one_le_vdcPieceConst (d : ℕ) : 1 ≤ vdcPieceConst d := by
  have h1 := one_le_vdcShiftConst d
  have h2 := one_le_vdcMax d
  have h3 := (vdcDerivConst_pos d).le
  have h4 : (0 : ℝ) ≤ vdcShiftConst d ^ 2 := sq_nonneg _
  rw [vdcPieceConst]
  nlinarith

/-- **The estimate on one subinterval of fixed length.** -/
theorem norm_integral_expPhase_poly_piece {f : Polynomial ℝ} {d : ℕ} (hd : f.natDegree ≤ d)
    (hd1 : 1 ≤ d) {A : ℝ} (hA1 : 1 ≤ A) (hA : ∀ m, 1 ≤ m → |f.coeff m| ≤ A)
    {m₀ : ℕ} (hm₀ : 1 ≤ m₀) (hm₀A : A ≤ |f.coeff m₀|)
    {c ρ : ℝ} (hc0 : 0 ≤ c) (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1) (hcρ : c + ρ ≤ 1)
    (hsmall : vdcDerivConst d * A * ρ ≤ (vdcShiftConst d)⁻¹ * A / 2) :
    ‖∫ x in c..(c + ρ), expPhase (polyD f 0) x‖
      ≤ vdcPieceConst d * A ^ (-(1 : ℝ) / d) := by
  have hA0 : (0 : ℝ) < A := lt_of_lt_of_le zero_lt_one hA1
  have hKpos := vdcShiftConst_pos d
  have hK1 := one_le_vdcShiftConst d
  have hMpos := vdcDerivConst_pos d
  have hd0 : (0 : ℝ) < (d : ℝ) := by exact_mod_cast hd1
  set K : ℝ := vdcShiftConst d with hKdef
  set M : ℝ := vdcDerivConst d with hMdef
  set μ : ℝ := A / K / 2 with hμdef
  have hμpos : 0 < μ := by rw [hμdef]; positivity
  have hμeq : μ = A / (2 * K) := by rw [hμdef]; field_simp
  have hab : c ≤ c + ρ := by linarith
  have hIcc : ∀ x ∈ Set.Icc c (c + ρ), |x| ≤ 1 := by
    intro x hx
    rw [abs_le]
    refine ⟨by have := hx.1; linarith, by have := hx.2; linarith⟩
  have hcabs : |c| ≤ 1 := hIcc c (Set.left_mem_Icc.mpr hab)
  obtain ⟨r, hr1, hrd, hrc⟩ := exists_large_deriv hd hd1 hm₀ hm₀A hcabs
  have hhalf : M * A * ρ ≤ A / K / 2 := by
    rw [hMdef, hKdef]
    calc vdcDerivConst d * A * ρ ≤ (vdcShiftConst d)⁻¹ * A / 2 := hsmall
      _ = A / vdcShiftConst d / 2 := by rw [inv_mul_eq_div]
  have hsigned := polyD_signed_lower hd hA hr1 (μ₀ := A / K) hrc hhalf hIcc
  have hexp : A ^ (-(1 : ℝ) / (r : ℝ)) ≤ A ^ (-(1 : ℝ) / (d : ℝ)) := by
    refine Real.rpow_le_rpow_of_exponent_le hA1 ?_
    have hr0 : (0 : ℝ) < (r : ℝ) := by exact_mod_cast hr1
    have hrd' : (r : ℝ) ≤ (d : ℝ) := by exact_mod_cast hrd
    have h := one_div_le_one_div_of_le hr0 hrd'
    rw [neg_div, neg_div]
    linarith
  have hApow0 : (0 : ℝ) ≤ A ^ (-(1 : ℝ) / (d : ℝ)) := (Real.rpow_pos_of_pos hA0 _).le
  rcases Nat.lt_or_ge r 2 with hr2 | hr2
  · -- the first derivative is the large one: no monotonicity, use the bounded form
    have hre : r = 1 := by omega
    subst hre
    have hlow : ∀ x ∈ Set.Icc c (c + ρ), μ ≤ |polyD f 1 x| := by
      intro x hx
      rcases hsigned with h | h
      · exact le_trans (h x hx) (le_abs_self _)
      · exact le_trans (h x hx) (neg_le_abs _)
    have hM2 : ∀ x ∈ Set.Icc c (c + ρ), |polyD f 2 x| ≤ M * A := by
      intro x hx
      have h := abs_eval_iterate_derivative_le (j := 2) hd hA (by omega) (hIcc x hx)
      calc |polyD f 2 x| ≤ ((d : ℝ) + 1) * (((Nat.factorial d : ℕ) : ℝ) * 2 ^ d * A) := h
        _ = M * A := by rw [hMdef, vdcDerivConst]; ring
    have hbd := norm_integral_expPhase_le_of_deriv_bdd hab hμpos
      (φ := polyD f 0) (φ' := polyD f 1) (φ'' := polyD f 2)
      (fun x => hasDerivAt_polyD f 0 x) (fun x => hasDerivAt_polyD f 1 x)
      (continuous_polyD f 2) hlow hM2
    refine le_trans hbd ?_
    have hlen : c + ρ - c = ρ := by ring
    rw [hlen]
    have h1 : 2 / μ = 4 * K / A := by
      rw [hμeq]
      field_simp
      ring
    have h2 : ρ * (M * A) / μ ^ 2 = 4 * ρ * M * K ^ 2 / A := by
      rw [hμeq]
      field_simp
      ring
    rw [h1, h2]
    have hMK : (0 : ℝ) ≤ M * K ^ 2 := mul_nonneg hMpos.le (sq_nonneg K)
    have hnum : 4 * ρ * M * K ^ 2 ≤ 4 * M * K ^ 2 := by
      nlinarith [mul_nonneg hMK (sub_nonneg.mpr hρ1)]
    have hmono : 4 * ρ * M * K ^ 2 / A ≤ 4 * M * K ^ 2 / A :=
      div_le_div_of_nonneg_right hnum hA0.le
    have hAinv : 1 / A ≤ A ^ (-(1 : ℝ) / (d : ℝ)) := by
      have h3 : A ^ (-(1 : ℝ)) ≤ A ^ (-(1 : ℝ) / (d : ℝ)) := by
        refine Real.rpow_le_rpow_of_exponent_le hA1 ?_
        have h4 : (1 : ℝ) / (d : ℝ) ≤ 1 := by
          rw [div_le_one hd0]
          exact_mod_cast hd1
        rw [neg_div]
        linarith
      rwa [Real.rpow_neg_one, ← one_div] at h3
    have hsum : 4 * K / A + 4 * M * K ^ 2 / A = (4 * K + 4 * M * K ^ 2) * (1 / A) := by
      field_simp
    have hcoef : (0 : ℝ) ≤ 4 * K + 4 * M * K ^ 2 := by nlinarith [sq_nonneg K]
    calc 4 * K / A + 4 * ρ * M * K ^ 2 / A ≤ 4 * K / A + 4 * M * K ^ 2 / A := by linarith
      _ = (4 * K + 4 * M * K ^ 2) * (1 / A) := hsum
      _ ≤ (4 * K + 4 * M * K ^ 2) * A ^ (-(1 : ℝ) / (d : ℝ)) :=
          mul_le_mul_of_nonneg_left hAinv hcoef
      _ ≤ vdcPieceConst d * A ^ (-(1 : ℝ) / (d : ℝ)) := by
          refine mul_le_mul_of_nonneg_right ?_ hApow0
          rw [vdcPieceConst, ← hKdef, ← hMdef]
          nlinarith [one_le_vdcMax d, sq_nonneg K]
  · -- a derivative of order at least two is the large one
    obtain ⟨n, hrn⟩ : ∃ n, r = n + 2 := ⟨r - 2, by omega⟩
    subst hrn
    have hnd : n ≤ d := by omega
    have hcast : ((n : ℝ) + 2) = ((n + 2 : ℕ) : ℝ) := by push_cast; ring
    have hbound : ‖∫ x in c..(c + ρ), expPhase (polyD f 0) x‖
        ≤ vdcConst n * μ ^ (-(1 : ℝ) / ((n : ℝ) + 2)) := by
      rcases hsigned with h | h
      · exact vdcConst_spec n (polyD f) (fun j _ x => hasDerivAt_polyD f j x)
          (continuous_polyD f (n + 2)) c (c + ρ) μ hab hμpos h
      · have hneg := vdcConst_spec n (fun j x => -polyD f j x)
          (fun j _ x => (hasDerivAt_polyD f j x).neg)
          (continuous_polyD f (n + 2)).neg c (c + ρ) μ hab hμpos h
        rwa [integral_expPhase_neg, RCLike.norm_conj] at hneg
    refine le_trans hbound ?_
    -- turn the power of `μ` into a power of `A`
    have hμpow : μ ^ (-(1 : ℝ) / ((n : ℝ) + 2)) ≤ 2 * K * A ^ (-(1 : ℝ) / (d : ℝ)) := by
      have h2K : (1 : ℝ) ≤ 2 * K := by linarith
      have hdiv : μ ^ (-(1 : ℝ) / ((n : ℝ) + 2))
          = A ^ (-(1 : ℝ) / ((n : ℝ) + 2)) / (2 * K) ^ (-(1 : ℝ) / ((n : ℝ) + 2)) := by
        rw [hμeq, Real.div_rpow hA0.le (by linarith)]
      have hden : (2 * K) ^ (-(1 : ℝ) / ((n : ℝ) + 2))
          = ((2 * K) ^ ((1 : ℝ) / ((n : ℝ) + 2)))⁻¹ := by
        rw [← Real.rpow_neg (by linarith)]
        congr 1
        ring
      have hnum : (2 * K) ^ ((1 : ℝ) / ((n : ℝ) + 2)) ≤ 2 * K := by
        have h5 : (2 * K) ^ ((1 : ℝ) / ((n : ℝ) + 2)) ≤ (2 * K) ^ (1 : ℝ) := by
          refine Real.rpow_le_rpow_of_exponent_le h2K ?_
          rw [div_le_one (by positivity)]
          have : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
          linarith
        rwa [Real.rpow_one] at h5
      have hnum0 : (0 : ℝ) < (2 * K) ^ ((1 : ℝ) / ((n : ℝ) + 2)) :=
        Real.rpow_pos_of_pos (by linarith) _
      rw [hdiv, hden, div_eq_mul_inv, inv_inv]
      have hAn : A ^ (-(1 : ℝ) / ((n : ℝ) + 2)) ≤ A ^ (-(1 : ℝ) / (d : ℝ)) := by
        rw [hcast]
        exact hexp
      have hA0' : (0 : ℝ) ≤ A ^ (-(1 : ℝ) / ((n : ℝ) + 2)) :=
        (Real.rpow_pos_of_pos hA0 _).le
      calc A ^ (-(1 : ℝ) / ((n : ℝ) + 2)) * (2 * K) ^ ((1 : ℝ) / ((n : ℝ) + 2))
          ≤ A ^ (-(1 : ℝ) / (d : ℝ)) * (2 * K) :=
            mul_le_mul hAn hnum hnum0.le hApow0
        _ = 2 * K * A ^ (-(1 : ℝ) / (d : ℝ)) := by ring
    calc vdcConst n * μ ^ (-(1 : ℝ) / ((n : ℝ) + 2))
        ≤ vdcConst n * (2 * K * A ^ (-(1 : ℝ) / (d : ℝ))) :=
          mul_le_mul_of_nonneg_left hμpow (le_trans zero_le_one (one_le_vdcConst n))
      _ ≤ vdcMax d * (2 * K * A ^ (-(1 : ℝ) / (d : ℝ))) := by
          refine mul_le_mul_of_nonneg_right (vdcConst_le_vdcMax hnd) ?_
          have : (0 : ℝ) ≤ 2 * K := by linarith
          positivity
      _ = (2 * K * vdcMax d) * A ^ (-(1 : ℝ) / (d : ℝ)) := by ring
      _ ≤ vdcPieceConst d * A ^ (-(1 : ℝ) / (d : ℝ)) := by
          refine mul_le_mul_of_nonneg_right ?_ hApow0
          rw [vdcPieceConst, ← hKdef, ← hMdef]
          nlinarith [sq_nonneg K, (vdcDerivConst_pos d).le]


/-! ## The polynomial-phase estimate

A cover of `[0, 1]` by `⌈1 / ρ⌉` intervals of length at most `ρ`, with `ρ` depending only on `d`,
reduces the estimate to the estimate on one subinterval. -/

theorem norm_integral_expPhase_unit_le (φ : ℝ → ℝ) :
    ‖∫ t in (0 : ℝ)..1, expPhase φ t‖ ≤ 1 := by
  have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := (0 : ℝ)) (b := 1)
    (f := expPhase φ) (C := 1) fun x _ => le_of_eq (norm_expPhase φ x)
  simpa using h

/-- The length of the subintervals of the cover; it depends only on the degree. -/
noncomputable def vdcStep (d : ℕ) : ℝ :=
  min 1 (1 / (2 * vdcShiftConst d * vdcDerivConst d))

theorem vdcStep_pos (d : ℕ) : 0 < vdcStep d := by
  have h1 := vdcShiftConst_pos d
  have h2 := vdcDerivConst_pos d
  rw [vdcStep]
  exact lt_min one_pos (by positivity)

theorem vdcStep_le_one (d : ℕ) : vdcStep d ≤ 1 := min_le_left _ _

theorem vdcStep_small (d : ℕ) {A ρ : ℝ} (hA : 0 < A) (_hρ0 : 0 ≤ ρ) (hρ : ρ ≤ vdcStep d) :
    vdcDerivConst d * A * ρ ≤ (vdcShiftConst d)⁻¹ * A / 2 := by
  have hK := vdcShiftConst_pos d
  have hM := vdcDerivConst_pos d
  have h : ρ ≤ 1 / (2 * vdcShiftConst d * vdcDerivConst d) :=
    le_trans hρ (min_le_right _ _)
  have h2 : vdcDerivConst d * A * ρ
      ≤ vdcDerivConst d * A * (1 / (2 * vdcShiftConst d * vdcDerivConst d)) :=
    mul_le_mul_of_nonneg_left h (by positivity)
  refine le_trans h2 (le_of_eq ?_)
  field_simp

/-- The number of subintervals of the cover. -/
noncomputable def vdcPieces (d : ℕ) : ℕ := ⌈(vdcStep d)⁻¹⌉₊

theorem one_le_vdcPieces_mul (d : ℕ) : 1 ≤ (vdcPieces d : ℝ) * vdcStep d := by
  have hρ := vdcStep_pos d
  have h : (vdcStep d)⁻¹ ≤ (vdcPieces d : ℝ) := Nat.le_ceil _
  calc (1 : ℝ) = (vdcStep d)⁻¹ * vdcStep d := by field_simp
    _ ≤ (vdcPieces d : ℝ) * vdcStep d := mul_le_mul_of_nonneg_right h hρ.le

/-- **Blueprint `lem:real-polynomial-oscillation`, the normalized form.**  For a real polynomial
`f` of degree at most `d` whose largest coefficient of index at least one is `A`,

  `‖∫_0^1 exp (i f)‖ ≤ C d * min 1 (A ^ (-1/d))`,

with `C d` depending only on `d`.  Only the size of the largest coefficient enters, not that of
the leading one. -/
theorem exists_polynomial_oscillation_bound (d : ℕ) : ∃ C : ℝ, 1 ≤ C ∧
    ∀ f : Polynomial ℝ, f.natDegree ≤ d → ∀ A : ℝ, 0 < A →
      (∀ m, 1 ≤ m → |f.coeff m| ≤ A) →
      (∃ m₀, 1 ≤ m₀ ∧ A ≤ |f.coeff m₀|) →
      ‖∫ t in (0 : ℝ)..1, expPhase (fun s => f.eval s) t‖
        ≤ C * min 1 (A ^ (-(1 : ℝ) / d)) := by
  classical
  refine ⟨max 1 ((vdcPieces d : ℝ) * vdcPieceConst d), le_max_left _ _, ?_⟩
  intro f hdeg A hA0 hA hex
  obtain ⟨m₀, hm₀, hm₀A⟩ := hex
  have hC1 : (1 : ℝ) ≤ max 1 ((vdcPieces d : ℝ) * vdcPieceConst d) := le_max_left _ _
  have hmin0 : (0 : ℝ) ≤ min 1 (A ^ (-(1 : ℝ) / d)) :=
    le_min zero_le_one (Real.rpow_pos_of_pos hA0 _).le
  -- the degenerate degree is impossible
  rcases Nat.eq_zero_or_pos d with hd0 | hd1
  · exfalso
    subst hd0
    rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega : f.natDegree < m₀), abs_zero] at hm₀A
    linarith
  by_cases hA1 : A ≤ 1
  · -- the trivial bound
    have hone : (1 : ℝ) ≤ A ^ (-(1 : ℝ) / d) := by
      refine Real.one_le_rpow_of_pos_of_le_one_of_nonpos hA0 hA1 ?_
      have hd0' : (0 : ℝ) < (d : ℝ) := by exact_mod_cast hd1
      rw [neg_div]
      have : (0 : ℝ) < 1 / (d : ℝ) := by positivity
      linarith
    rw [min_eq_left hone]
    calc ‖∫ t in (0 : ℝ)..1, expPhase (fun s => f.eval s) t‖ ≤ 1 :=
          norm_integral_expPhase_unit_le _
      _ = 1 * 1 := by ring
      _ ≤ max 1 ((vdcPieces d : ℝ) * vdcPieceConst d) * 1 := by
          exact mul_le_mul_of_nonneg_right hC1 zero_le_one
  push Not at hA1
  have hA1' : (1 : ℝ) ≤ A := hA1.le
  have hrpow_le_one : A ^ (-(1 : ℝ) / d) ≤ 1 := by
    refine Real.rpow_le_one_of_one_le_of_nonpos hA1' ?_
    have hd0' : (0 : ℝ) < (d : ℝ) := by exact_mod_cast hd1
    rw [neg_div]
    have : (0 : ℝ) < 1 / (d : ℝ) := by positivity
    linarith
  rw [min_eq_right hrpow_le_one]
  have hApow0 : (0 : ℝ) ≤ A ^ (-(1 : ℝ) / d) := (Real.rpow_pos_of_pos hA0 _).le
  -- the cover
  set ρ : ℝ := vdcStep d with hρdef
  set Nd : ℕ := vdcPieces d with hNdef
  have hρpos : 0 < ρ := vdcStep_pos d
  have hρle1 : ρ ≤ 1 := vdcStep_le_one d
  set a : ℕ → ℝ := fun j => min ((j : ℝ) * ρ) 1 with hadef
  have halb : ∀ j, 0 ≤ a j := fun j => le_min (by positivity) zero_le_one
  have haub : ∀ j, a j ≤ 1 := fun j => min_le_right _ _
  have ha0 : a 0 = 0 := by simp [hadef]
  have haN : a Nd = 1 := by
    rw [hadef]
    exact min_eq_right (one_le_vdcPieces_mul d)
  have hstep : ∀ j : ℕ, a (j + 1) - a j ≤ ρ := by
    intro j
    have hj0 : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg j
    simp only [hadef, min_def]
    push_cast
    split_ifs <;> nlinarith
  have hmono : ∀ j : ℕ, a j ≤ a (j + 1) := by
    intro j
    have hj0 : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg j
    simp only [hadef]
    refine min_le_min ?_ le_rfl
    push_cast
    nlinarith
  have hint : ∀ u v : ℝ, IntervalIntegrable (expPhase (polyD f 0)) volume u v := fun u v =>
    (continuous_expPhase (continuous_polyD f 0)).intervalIntegrable u v
  have hsum := intervalIntegral.sum_integral_adjacent_intervals
    (f := expPhase (polyD f 0)) (μ := (volume : Measure ℝ)) (a := a) (n := Nd)
    (fun k _ => hint (a k) (a (k + 1)))
  rw [ha0, haN] at hsum
  have hpiece : ∀ j ∈ Finset.range Nd,
      ‖∫ x in (a j)..(a (j + 1)), expPhase (polyD f 0) x‖
        ≤ vdcPieceConst d * A ^ (-(1 : ℝ) / d) := by
    intro j _
    have hρ' : a (j + 1) - a j ≤ ρ := hstep j
    have hρ'0 : 0 ≤ a (j + 1) - a j := by linarith [hmono j]
    have heq : a j + (a (j + 1) - a j) = a (j + 1) := by ring
    have := norm_integral_expPhase_poly_piece hdeg hd1 hA1' hA hm₀ hm₀A
      (c := a j) (ρ := a (j + 1) - a j) (halb j) hρ'0 (le_trans hρ' hρle1)
      (by rw [heq]; exact haub (j + 1))
      (vdcStep_small d hA0 hρ'0 (by rw [← hρdef]; exact hρ'))
    rwa [heq] at this
  have hfinal : ‖∫ x in (0 : ℝ)..1, expPhase (polyD f 0) x‖
      ≤ (Nd : ℝ) * (vdcPieceConst d * A ^ (-(1 : ℝ) / d)) := by
    rw [← hsum]
    calc ‖∑ k ∈ Finset.range Nd, ∫ x in (a k)..(a (k + 1)), expPhase (polyD f 0) x‖
        ≤ ∑ k ∈ Finset.range Nd, ‖∫ x in (a k)..(a (k + 1)), expPhase (polyD f 0) x‖ :=
          norm_sum_le _ _
      _ ≤ ∑ _k ∈ Finset.range Nd, vdcPieceConst d * A ^ (-(1 : ℝ) / d) :=
          Finset.sum_le_sum hpiece
      _ = (Nd : ℝ) * (vdcPieceConst d * A ^ (-(1 : ℝ) / d)) := by
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  refine le_trans hfinal ?_
  rw [← mul_assoc]
  refine mul_le_mul_of_nonneg_right ?_ hApow0
  rw [hNdef]
  exact le_max_right _ _

end Auto
