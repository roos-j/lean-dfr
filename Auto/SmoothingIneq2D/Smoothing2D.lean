  apply Lp.ext
  filter_upwards [(𝓕 q').coeFn_toLp 2 volume,
    smoothingModulationL2_coe a ((𝓕 q).toLp 2 volume),
    (𝓕 q).coeFn_toLp 2 volume] with ξ hq' hm hq
  rw [hq', hm, hq]
