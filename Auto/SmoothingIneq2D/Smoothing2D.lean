/-- The second unnumbered display of Lemma 3.1: expanding the squared
Fourier modulus as the iterated modulated correlation integral. -/
theorem smoothing_fourier_multiplicativeDifference_norm_sq
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (f : Lp (α := E) ℂ 2 volume) (s ξ : E) :
    (‖(𝓕 (smoothingMultiplicativeDifference (⇑f) s) : E → ℂ) ξ‖ ^ 2 : ℂ) =
      ∫ η', ∫ η, Real.fourierChar (inner ℝ s (η - η')) •
        ((𝓕 f : Lp (α := E) ℂ 2 volume) (ξ + η) *
          star ((𝓕 f : Lp (α := E) ℂ 2 volume) η) *
          star ((𝓕 f : Lp (α := E) ℂ 2 volume) (ξ + η')) *
          (𝓕 f : Lp (α := E) ℂ 2 volume) η') := by
  rw [smoothing_fourier_multiplicativeDifference, ← Complex.mul_conj']
  rw [← integral_conj, ← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [] with η'
  rw [← integral_mul_const]
  apply integral_congr_ae
  filter_upwards [] with η
  have hchar :
      (Real.fourierChar (inner ℝ s (ξ + η)) : ℂ) *
        star (Real.fourierChar (inner ℝ s (ξ + η')) : ℂ) =
      (Real.fourierChar (inner ℝ s (η - η')) : ℂ) := by
    have hn : star (Real.fourierChar (inner ℝ s (ξ + η')) : ℂ) =
        (Real.fourierChar (-inner ℝ s (ξ + η')) : ℂ) := by
      rw [AddChar.map_neg_eq_inv, Circle.coe_inv_eq_conj]
      rfl
    rw [hn, ← Circle.coe_mul, ← Real.fourierChar.map_add_eq_mul]
    congr 2
    simp only [inner_add_right, inner_sub_right]
    ring
  simp only [Circle.smul_def, smul_eq_mul, starRingEnd_apply, star_mul, star_star]
  calc
    _ = ((Real.fourierChar (inner ℝ s (ξ + η)) : ℂ) *
        star (Real.fourierChar (inner ℝ s (ξ + η')) : ℂ)) *
        ((𝓕 f : Lp (α := E) ℂ 2 volume) (ξ + η) *
          star ((𝓕 f : Lp (α := E) ℂ 2 volume) η) *
          star ((𝓕 f : Lp (α := E) ℂ 2 volume) (ξ + η')) *
          (𝓕 f : Lp (α := E) ℂ 2 volume) η') := by ring
    _ = _ := by rw [hchar]

