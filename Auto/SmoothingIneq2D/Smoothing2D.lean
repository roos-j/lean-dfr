  filter_upwards [hfull.prod_right_ae] with ξ hξ
  apply (memLp_two_iff_integrable_sq_norm
    (smoothing_integrable_fourierCorrelation f ξ).1).mpr
  simpa only [norm_mul, norm_star, mul_pow] using hξ

/-- Removing the unit phase expresses the correlation computation in Lemma 3.1
as a Fourier transform evaluated at the negative translation parameter. -/
theorem smoothing_fourier_multiplicativeDifference_norm
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (f : Lp (α := E) ℂ 2 volume) (s ξ : E) :
    ‖(𝓕 (smoothingMultiplicativeDifference (⇑f) s) : E → ℂ) ξ‖ =
      ‖(𝓕 (fun η => (𝓕 f : Lp (α := E) ℂ 2 volume) (ξ + η) *
        star ((𝓕 f : Lp (α := E) ℂ 2 volume) η)) : E → ℂ) (-s)‖ := by
  rw [smoothing_fourier_multiplicativeDifference, Real.fourier_eq]
  have hphase : (∫ η, Real.fourierChar (inner ℝ s (ξ + η)) •
      ((𝓕 f : Lp (α := E) ℂ 2 volume) (ξ + η) *
        star ((𝓕 f : Lp (α := E) ℂ 2 volume) η))) =
      Real.fourierChar (inner ℝ s ξ) • ∫ η,
        Real.fourierChar (-inner ℝ η (-s)) •
          ((𝓕 f : Lp (α := E) ℂ 2 volume) (ξ + η) *
            star ((𝓕 f : Lp (α := E) ℂ 2 volume) η)) := by
    simp only [Circle.smul_def, smul_eq_mul]
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards [] with η
    rw [inner_add_right, Real.fourierChar.map_add_eq_mul, Circle.coe_mul, mul_assoc]
    simp only [inner_neg_right, neg_neg, real_inner_comm η s]
  rw [hphase, Circle.norm_smul]
/-- The third unnumbered display of Lemma 3.1, interpreted almost everywhere
in frequency as required for arbitrary L² inputs: integration in the translation
parameter gives the squared spectral correlation. -/
theorem smoothing_integral_fourier_multiplicativeDifference_norm_sq
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (f : Lp (α := E) ℂ 2 volume) :
    ∀ᵐ ξ ∂volume,
      (∫ s, ‖(𝓕 (smoothingMultiplicativeDifference (⇑f) s) : E → ℂ) ξ‖ ^ 2) =
      ∫ η, ‖(𝓕 f : Lp (α := E) ℂ 2 volume) (ξ + η)‖ ^ 2 *
        ‖(𝓕 f : Lp (α := E) ℂ 2 volume) η‖ ^ 2 := by
  filter_upwards [smoothing_ae_memLp_fourierCorrelation f] with ξ hξ
  simp_rw [smoothing_fourier_multiplicativeDifference_norm]
  rw [integral_neg_eq_self (fun s =>
    ‖(𝓕 (fun η => (𝓕 f : Lp (α := E) ℂ 2 volume) (ξ + η) *
      star ((𝓕 f : Lp (α := E) ℂ 2 volume) η)) : E → ℂ) s‖ ^ 2) volume]
  rw [smoothing_integral_norm_sq_fourier
    (smoothing_integrable_fourierCorrelation f ξ) hξ]
  simp only [norm_mul, norm_star, mul_pow]

#print axioms smoothing_integral_fourier_multiplicativeDifference_norm_sq
/-- Joint measurability justifies the order of integration in the final display
of Lemma 3.1. -/
theorem smoothing_stronglyMeasurable_fourierDifference
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (f : Lp (α := E) ℂ 2 volume) :
    StronglyMeasurable (fun p : E × E =>
      (𝓕 (smoothingMultiplicativeDifference (⇑f) p.1) : E → ℂ) p.2) := by
  simp only [Real.fourier_eq, smoothingMultiplicativeDifference, Circle.smul_def,
    smul_eq_mul]
  apply StronglyMeasurable.integral_prod_right' (f := fun p : (E × E) × E =>
    (Real.fourierChar (-inner ℝ p.2 p.1.2) : ℂ) * (f (p.2 + p.1.1) * star (f p.2)))
  have hf := Lp.stronglyMeasurable f
  exact (continuous_subtype_val.comp (Real.continuous_fourierChar.comp
    (continuous_snd.inner (continuous_snd.comp continuous_fst)).neg)).stronglyMeasurable.mul
    ((hf.comp_measurable (by fun_prop)).mul (hf.comp_measurable measurable_snd).star)

/-- The squared Fourier transform of the multiplicative difference is integrable
jointly in translation and frequency, as used in Lemma 3.1's final display. -/
theorem smoothing_integrable_fourierDifference_energy
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (f : Lp (α := E) ℂ 2 volume) :
    Integrable (fun p : E × E =>
      ‖(𝓕 (smoothingMultiplicativeDifference (⇑f) p.1) : E → ℂ) p.2‖ ^ 2)
      (volume.prod volume) := by
  apply (integrable_prod_iff'
    ((smoothing_stronglyMeasurable_fourierDifference f).norm.pow 2).aestronglyMeasurable).mpr
  constructor
  · filter_upwards [smoothing_ae_memLp_fourierCorrelation f] with ξ hξ
    have hF : MemLp (𝓕 (fun η => (𝓕 f : Lp (α := E) ℂ 2 volume) (ξ + η) *
        star ((𝓕 f : Lp (α := E) ℂ 2 volume) η)) : E → ℂ) 2 volume :=
      (memLp_congr_ae (smoothing_fourier_toLp_ae_eq (smoothing_integrable_fourierCorrelation f ξ) hξ)).mp
        (Lp.memLp (𝓕 (hξ.toLp _)))
    have hFn := hF.comp_measurePreserving (Measure.measurePreserving_neg volume)
    have hsq := (memLp_two_iff_integrable_sq_norm hFn.1).mp hFn
    simpa only [Function.comp_def, Pi.pow_apply, smoothing_fourier_multiplicativeDifference_norm] using hsq
  · have hw : Integrable (fun η => ‖(𝓕 f : Lp (α := E) ℂ 2 volume) η‖ ^ 2) volume :=
      (memLp_two_iff_integrable_sq_norm (Lp.memLp (𝓕 f)).1).mp (Lp.memLp (𝓕 f))
    have hprod := hw.mul_prod hw
    have hfull := ((measurePreserving_add_prod volume volume).integrable_comp
      hprod.aestronglyMeasurable).mpr hprod
    apply hfull.integral_prod_left.congr
    filter_upwards [smoothing_integral_fourier_multiplicativeDifference_norm_sq f] with ξ hξ
    simpa only [Real.norm_eq_abs, Pi.pow_apply, abs_pow, abs_norm, Function.comp_apply] using hξ.symm
/-- Translation of the centered frequency ball in Lemma 3.1. -/
theorem smoothing_integral_ball_translate
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (w : E → ℝ) (η : E) (R : ℝ) :
    (∫ ξ in Metric.closedBall (0 : E) R, w (ξ + η)) =
      ∫ ξ in Metric.closedBall η R, w ξ := by
  rw [← integral_indicator measurableSet_closedBall,
    ← integral_indicator measurableSet_closedBall]
  have ht := integral_add_right_eq_self (μ := volume)
    ((Metric.closedBall η R).indicator w) η
  rw [← ht]
  apply integral_congr_ae
  filter_upwards [] with ξ
  classical
  change (if ξ ∈ Metric.closedBall (0 : E) R then w (ξ + η) else 0) =
    (if ξ + η ∈ Metric.closedBall η R then w (ξ + η) else 0)
  simp only [Metric.mem_closedBall, dist_eq_norm, sub_zero, add_sub_cancel_right]

/-- The equality in the final display of Lemma 3.1: the multiplicative-difference
energy on the centered ball is the spectral-pair energy at distance at most R. -/
theorem smoothing_fourierDifference_ball_energy
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (f : Lp (α := E) ℂ 2 volume) (R : ℝ) :
    (∫ s, ∫ ξ in Metric.closedBall (0 : E) R,
      ‖(𝓕 (smoothingMultiplicativeDifference (⇑f) s) : E → ℂ) ξ‖ ^ 2) =
      ∫ η, ‖(𝓕 f : Lp (α := E) ℂ 2 volume) η‖ ^ 2 *
        ∫ ξ in Metric.closedBall η R, ‖(𝓕 f : Lp (α := E) ℂ 2 volume) ξ‖ ^ 2 := by
  have hp := (smoothing_integrable_fourierDifference_energy f).restrict
    (s := Set.univ ×ˢ Metric.closedBall (0 : E) R)
  rw [← Measure.prod_restrict, Measure.restrict_univ] at hp
  rw [integral_integral_swap hp]
  calc
    _ = ∫ ξ in Metric.closedBall (0 : E) R, ∫ η,
        ‖(𝓕 f : Lp (α := E) ℂ 2 volume) (ξ + η)‖ ^ 2 *
        ‖(𝓕 f : Lp (α := E) ℂ 2 volume) η‖ ^ 2 :=
      integral_congr_ae (ae_restrict_of_ae
        (smoothing_integral_fourier_multiplicativeDifference_norm_sq f))
    _ = ∫ η, ∫ ξ in Metric.closedBall (0 : E) R,
        ‖(𝓕 f : Lp (α := E) ℂ 2 volume) (ξ + η)‖ ^ 2 *
        ‖(𝓕 f : Lp (α := E) ℂ 2 volume) η‖ ^ 2 := by
      apply integral_integral_swap
      have hw : Integrable (fun η => ‖(𝓕 f : Lp (α := E) ℂ 2 volume) η‖ ^ 2) volume :=
        (memLp_two_iff_integrable_sq_norm (Lp.memLp (𝓕 f)).1).mp (Lp.memLp (𝓕 f))
      have hprod := hw.mul_prod hw
      have hfull := ((measurePreserving_add_prod volume volume).integrable_comp
        hprod.aestronglyMeasurable).mpr hprod
      have hr := hfull.restrict (s := Metric.closedBall (0 : E) R ×ˢ Set.univ)
      simpa only [← Measure.prod_restrict, Measure.restrict_univ, Function.comp_def, Function.uncurry_def] using! hr
    _ = _ := by
      apply integral_congr_ae
      filter_upwards [] with η
      rw [integral_mul_const, smoothing_integral_ball_translate
        (fun ξ => ‖(𝓕 f : Lp (α := E) ℂ 2 volume) ξ‖ ^ 2) η R, mul_comm]

#print axioms smoothing_fourierDifference_ball_energy
/-- Restricting an L² function to a measurable set and its complement gives
orthogonal L² vectors. Applied to the Fourier transform and a ball, this is the
projection step in Lemma 3.1 of arXiv:2008.10140v2. -/
theorem smoothing_frequencyRestriction_orthogonal
    {E : Type*} [MeasurableSpace E] {μ : Measure E}
    {f : E → ℂ} (hf : MemLp f 2 μ) {s : Set E} (hs : MeasurableSet s) :
    inner ℂ ((hf.indicator hs).toLp (s.indicator f))
      ((hf.indicator hs.compl).toLp (sᶜ.indicator f)) = 0 := by
  rw [L2.inner_def]
  calc
    (∫ x, inner ℂ ((hf.indicator hs).toLp (s.indicator f) x)
        ((hf.indicator hs.compl).toLp (sᶜ.indicator f) x) ∂μ) =
        ∫ x, (0 : ℂ) ∂μ := by
      apply integral_congr_ae
      filter_upwards [(hf.indicator hs).coeFn_toLp,
        (hf.indicator hs.compl).coeFn_toLp] with x hx hy
      rw [hx, hy]
      by_cases hxs : x ∈ s <;> simp [hxs]
    _ = 0 := integral_zero E ℂ

/-- The orthogonal frequency projection used at the end of Lemma 3.1.
For every measurable frequency set, an L² function splits into a part whose
Fourier transform is its restriction to that set and an orthogonal remainder.
The concentration lower bound selecting the set is a separate obligation. -/
theorem smoothing_frequencyProjection
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (f : Lp (α := E) ℂ 2 volume) {s : Set E} (hs : MeasurableSet s) :
    ∃ g h : Lp (α := E) ℂ 2 volume,
      f = g + h ∧ inner ℂ g h = 0 ∧
      (⇑(𝓕 g : Lp (α := E) ℂ 2 volume) =ᵐ[volume] s.indicator (⇑(𝓕 f : Lp (α := E) ℂ 2 volume))) ∧
      (⇑(𝓕 h : Lp (α := E) ℂ 2 volume) =ᵐ[volume] sᶜ.indicator (⇑(𝓕 f : Lp (α := E) ℂ 2 volume))) := by
  let hf := Lp.memLp (𝓕 f)
  let G := (hf.indicator hs).toLp (s.indicator (⇑(𝓕 f : Lp (α := E) ℂ 2 volume)))
  let H := (hf.indicator hs.compl).toLp (sᶜ.indicator (⇑(𝓕 f : Lp (α := E) ℂ 2 volume)))
  have hG : ⇑G =ᵐ[volume] s.indicator (⇑(𝓕 f : Lp (α := E) ℂ 2 volume)) := (hf.indicator hs).coeFn_toLp
  have hH : ⇑H =ᵐ[volume] sᶜ.indicator (⇑(𝓕 f : Lp (α := E) ℂ 2 volume)) :=
    (hf.indicator hs.compl).coeFn_toLp
  have hsum : G + H = 𝓕 f := by
    apply Lp.ext
    filter_upwards [Lp.coeFn_add G H, hG, hH] with x hadd hx hy
    rw [hadd]
    change G x + H x = (𝓕 f) x
    rw [hx, hy]
    by_cases hxs : x ∈ s <;> simp [hxs]
  refine ⟨𝓕⁻ G, 𝓕⁻ H, ?_, ?_, ?_, ?_⟩
  · rw [← fourierInv_add, hsum, fourierInv_fourier_eq]
  · rw [← Lp.inner_fourier_eq, fourier_fourierInv_eq, fourier_fourierInv_eq]
    exact smoothing_frequencyRestriction_orthogonal hf hs
  · simpa only [fourier_fourierInv_eq] using hG
  · simpa only [fourier_fourierInv_eq] using hH

/-- The averaging step in Lemma 3.1: a large weighted energy forces one
frequency window to capture a definite fraction of the total mass. Here `b`
will be the mass of a translated frequency ball. -/
theorem smoothing_exists_large_window
    {E : Type*} [MeasurableSpace E] {μ : Measure E}
    {w b : E → ℝ} (hw : Integrable w μ)
    (hwb : Integrable (fun x => w x * b x) μ)
    (hw_nonneg : ∀ᵐ x ∂μ, 0 ≤ w x)
    (hmass : 0 < ∫ x, w x ∂μ) {ρ : ℝ} (hρ : 0 < ρ)
    (henergy : ρ * (∫ x, w x ∂μ) ^ 2 ≤ ∫ x, w x * b x ∂μ) :
    ∃ x, (ρ / 2) * (∫ y, w y ∂μ) < b x := by
  by_contra! hsmall
  have hbound : (∫ x, w x * b x ∂μ) ≤
      (∫ x, w x ∂μ) * ((ρ / 2) * (∫ y, w y ∂μ)) := by
    rw [← integral_mul_const]
    apply integral_mono_ae hwb (hw.mul_const _)
    filter_upwards [hw_nonneg] with x hx
    exact mul_le_mul_of_nonneg_left (hsmall x) hx
  have hpos : 0 < ρ * (∫ x, w x ∂μ) ^ 2 := mul_pos hρ (sq_pos_of_pos hmass)
  nlinarith

/-- Quantitative projection step for Lemma 3.1. A lower bound for the Fourier
mass in a measurable window yields an orthogonal summand with that squared
norm, whose Fourier transform vanishes almost everywhere outside the window. -/
theorem smoothing_frequencyProjection_of_mass
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (f : Lp (α := E) ℂ 2 volume) {s : Set E} (hs : MeasurableSet s)
    {m : ℝ} (hm : m ≤ ∫ ξ in s, ‖(𝓕 f : Lp (α := E) ℂ 2 volume) ξ‖ ^ 2) :
    ∃ g h : Lp (α := E) ℂ 2 volume,
      f = g + h ∧ inner ℂ g h = 0 ∧ m ≤ ‖g‖ ^ 2 ∧
      ∀ᵐ ξ ∂volume, ξ ∉ s → (𝓕 g : Lp (α := E) ℂ 2 volume) ξ = 0 := by
  obtain ⟨g, h, hsum, horth, hg, _⟩ := smoothing_frequencyProjection f hs
  have hrestriction :
      ((Lp.memLp (𝓕 f : Lp (α := E) ℂ 2 volume)).indicator hs).toLp
        (s.indicator (⇑(𝓕 f : Lp (α := E) ℂ 2 volume))) = 𝓕 g := by
    apply Lp.ext
    exact ((Lp.memLp (𝓕 f : Lp (α := E) ℂ 2 volume)).indicator hs).coeFn_toLp.trans hg.symm
  have hnorm := smoothing_frequencyRestriction_norm_sq
    (Lp.memLp (𝓕 f : Lp (α := E) ℂ 2 volume)) hs
  rw [hrestriction, Lp.norm_fourier_eq] at hnorm
  refine ⟨g, h, hsum, horth, hnorm.symm ▸ hm, ?_⟩
  filter_upwards [hg] with ξ hξ
  intro hξs
  simpa [hξs] using hξ

/-- The weighted frequency-ball energy is integrable. This supplies the
integrability hypothesis of `smoothing_exists_large_window` without assuming
convergence of the iterated energy integral in Lemma 3.1. -/
theorem smoothing_integrable_ball_energy
    {E : Type*} [PseudoMetricSpace E] [MeasurableSpace E] [BorelSpace E]
    [SecondCountableTopology E] {μ : Measure E} [SFinite μ]
    {w : E → ℝ} (hw : Integrable w μ) (R : ℝ) :
    Integrable (fun x => w x * ∫ y in Metric.closedBall x R, w y ∂μ) μ := by
  let S : Set (E × E) := {p | dist p.2 p.1 ≤ R}
  have hS : MeasurableSet S :=
    (isClosed_le (continuous_snd.dist continuous_fst) continuous_const).measurableSet
  have hprod := (hw.mul_prod hw).indicator hS
  have hsection (x : E) :
      (∫ y, S.indicator (fun p : E × E => w p.1 * w p.2) (x, y) ∂μ) =
        w x * ∫ y in Metric.closedBall x R, w y ∂μ := by
    rw [← integral_const_mul, ← integral_indicator measurableSet_closedBall]
    apply integral_congr_ae
    exact Filter.Eventually.of_forall fun y => by
      by_cases hy : dist y x ≤ R <;> simp [S, Metric.mem_closedBall, hy]
  simpa only [hsection] using hprod.integral_prod_left

/-- The inequality in the final display of Lemma 3.1: total spectral mass
multiplied by the supremum of the spectral mass in a ball bounds the energy. -/
theorem smoothing_fourierDifference_energy_le_ball_mass
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (f : Lp (α := E) ℂ 2 volume) (R : ℝ) :
    (∫ s, ∫ ξ in Metric.closedBall (0 : E) R,
      ‖(𝓕 (smoothingMultiplicativeDifference (⇑f) s) : E → ℂ) ξ‖ ^ 2) ≤
      ‖f‖ ^ 2 * sSup (Set.range (fun c : E =>
        ∫ ξ in Metric.closedBall c R, ‖(𝓕 f : Lp (α := E) ℂ 2 volume) ξ‖ ^ 2)) := by
  let w : E → ℝ := fun ξ => ‖(𝓕 f : Lp (α := E) ℂ 2 volume) ξ‖ ^ 2
  have hw : Integrable w volume :=
    (memLp_two_iff_integrable_sq_norm (Lp.memLp (𝓕 f)).1).mp (Lp.memLp (𝓕 f))
  have hwpos : ∀ᵐ ξ ∂volume, 0 ≤ w ξ := Filter.Eventually.of_forall fun ξ => sq_nonneg _
  have hb : BddAbove (Set.range (fun c : E => ∫ ξ in Metric.closedBall c R, w ξ)) := by
    refine ⟨∫ ξ, w ξ, ?_⟩
    rintro y ⟨c, rfl⟩
    exact setIntegral_le_integral hw hwpos
  have hm : (∫ ξ, w ξ) = ‖f‖ ^ 2 := by
    have h := smoothing_frequencyRestriction_norm_sq (Lp.memLp (𝓕 f)) MeasurableSet.univ
    simpa only [Set.indicator_univ, Lp.toLp_coeFn, Measure.restrict_univ,
      Lp.norm_fourier_eq] using h.symm
  rw [smoothing_fourierDifference_ball_energy]
  change (∫ η, w η * ∫ ξ in Metric.closedBall η R, w ξ) ≤
    ‖f‖ ^ 2 * sSup (Set.range (fun c : E => ∫ ξ in Metric.closedBall c R, w ξ))
  rw [← hm, ← integral_mul_const]
  apply integral_mono_ae (smoothing_integrable_ball_energy hw R) (hw.mul_const _)
  filter_upwards [hwpos] with η hη
  exact mul_le_mul_of_nonneg_left (le_csSup hb (Set.mem_range_self η)) hη

#print axioms smoothing_fourierDifference_energy_le_ball_mass
/-- The frequency concentration conclusion of the averaging argument in
Lemma 3.1, stated for any nonnegative integrable density. The preceding Fourier
energy identity is still needed to apply this to multiplicative differences. -/
theorem smoothing_exists_ball_mass
    {E : Type*} [PseudoMetricSpace E] [MeasurableSpace E] [BorelSpace E]
    [SecondCountableTopology E] {μ : Measure E} [SFinite μ]
    {w : E → ℝ} (hw : Integrable w μ) (hw_nonneg : ∀ᵐ x ∂μ, 0 ≤ w x)
    (hmass : 0 < ∫ x, w x ∂μ) (R : ℝ) {ρ : ℝ} (hρ : 0 < ρ)
    (henergy : ρ * (∫ x, w x ∂μ) ^ 2 ≤
      ∫ x, w x * ∫ y in Metric.closedBall x R, w y ∂μ ∂μ) :
    ∃ x, (ρ / 2) * (∫ y, w y ∂μ) < ∫ y in Metric.closedBall x R, w y ∂μ :=
  smoothing_exists_large_window hw (smoothing_integrable_ball_energy hw R)
    hw_nonneg hmass hρ henergy

/-- Lemma 3.1's concentration and projection argument after the Fourier energy
identity. The hypothesis here is the frequency-pair energy, rather than the
original multiplicative-difference energy; their equality remains to be proved. -/
theorem smoothing_concentration_of_fourier_energy
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (f : Lp (α := E) ℂ 2 volume) (R : ℝ) {ρ : ℝ} (hρ : 0 < ρ)
    (henergy : ρ * ‖f‖ ^ 4 ≤
      ∫ ξ, ‖(𝓕 f : Lp (α := E) ℂ 2 volume) ξ‖ ^ 2 *
        ∫ η in Metric.closedBall ξ R,
          ‖(𝓕 f : Lp (α := E) ℂ 2 volume) η‖ ^ 2) :
    ∃ c : E, ∃ g h : Lp (α := E) ℂ 2 volume,
      f = g + h ∧ inner ℂ g h = 0 ∧
      (1 / 2 : ℝ) * Real.sqrt ρ * ‖f‖ ≤ ‖g‖ ∧
      ∀ᵐ ξ ∂volume, ξ ∉ Metric.closedBall c R →
        (𝓕 g : Lp (α := E) ℂ 2 volume) ξ = 0 := by
  by_cases hf0 : f = 0
  · subst f
    refine ⟨0, 0, 0, by simp, by simp, by simp, ?_⟩
    simp
  let F : Lp (α := E) ℂ 2 volume := 𝓕 f
  let w : E → ℝ := fun ξ => ‖F ξ‖ ^ 2
  have hw : Integrable w volume :=
    (memLp_two_iff_integrable_sq_norm (Lp.memLp F).1).mp (Lp.memLp F)
  have hmass_eq : (∫ ξ, w ξ) = ‖f‖ ^ 2 := by
    have h := smoothing_frequencyRestriction_norm_sq (Lp.memLp F) MeasurableSet.univ
    simp only [Set.indicator_univ, Lp.toLp_coeFn, Measure.restrict_univ] at h
    rw [Lp.norm_fourier_eq] at h
    exact h.symm
  have hmass : 0 < ∫ ξ, w ξ := by
    rw [hmass_eq]
    exact sq_pos_of_pos (norm_pos_iff.mpr hf0)
  have he : ρ * (∫ ξ, w ξ) ^ 2 ≤
      ∫ ξ, w ξ * ∫ η in Metric.closedBall ξ R, w η := by
    rw [hmass_eq]
    simpa only [w, F, ← pow_mul] using henergy
  obtain ⟨c, hc⟩ := smoothing_exists_ball_mass hw
    (Filter.Eventually.of_forall fun ξ => sq_nonneg _) hmass R hρ he
  obtain ⟨g, h, hsum, horth, hnorm, hsupp⟩ :=
    smoothing_frequencyProjection_of_mass f measurableSet_closedBall hc.le
  refine ⟨c, g, h, hsum, horth, ?_, hsupp⟩
  rw [hmass_eq] at hnorm
  have hsqrt := Real.sq_sqrt hρ.le
  have hprod : 0 ≤ Real.sqrt ρ * ‖f‖ := mul_nonneg (Real.sqrt_nonneg _) (norm_nonneg _)
  nlinarith [sq_nonneg (Real.sqrt ρ * ‖f‖), norm_nonneg g, norm_nonneg f]

/-- Lemma 3.1 of arXiv:2008.10140v2. If the multiplicative-difference Fourier
energy in the radius-R ball is at least ρ times the fourth power of the L² norm,
then f has an orthogonal summand whose Fourier transform vanishes almost
everywhere outside a radius-R ball and whose norm is at least √ρ/2 times ‖f‖.
The statement applies to every finite-dimensional real inner product space,
including the source's ℝᵈ. -/
theorem smoothing_lemma3_1
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (f : Lp (α := E) ℂ 2 volume) {ρ R : ℝ}
    (hρ : ρ ∈ Set.Ioo (0 : ℝ) 1) (_hR : 0 < R)
    (henergy : ρ * ‖f‖ ^ 4 ≤
      ∫ s, ∫ ξ in Metric.closedBall (0 : E) R,
        ‖(𝓕 (smoothingMultiplicativeDifference (⇑f) s) : E → ℂ) ξ‖ ^ 2) :
    ∃ (c : E) (g h : Lp (α := E) ℂ 2 volume),
      f = g + h ∧ inner ℂ g h = 0 ∧ (1 / 2 : ℝ) * Real.sqrt ρ * ‖f‖ ≤ ‖g‖ ∧
      ∀ᵐ ξ ∂volume, ξ ∉ Metric.closedBall c R →
        (𝓕 g : Lp (α := E) ℂ 2 volume) ξ = 0 := by
  rw [smoothing_fourierDifference_ball_energy] at henergy
  exact smoothing_concentration_of_fourier_energy f R hρ.1 henergy

#print axioms smoothing_lemma3_1
/-- The cutoff chosen in the first sentence of Lemma 3.2's proof. Its transition
intervals give compact support strictly inside (-1,1) and an integer partition. -/
noncomputable def smoothingPartitionCutoff (x : ℝ) : ℝ :=
  Real.smoothTransition (2 * x + 3 / 2) - Real.smoothTransition (2 * x - 1 / 2)

/-- Smoothness of the cutoff in Lemma 3.2. -/
theorem smoothingPartitionCutoff_contDiff : ContDiff ℝ ∞ smoothingPartitionCutoff := by
  exact (Real.smoothTransition.contDiff.comp
    ((contDiff_const.mul contDiff_id).add contDiff_const)).sub
    (Real.smoothTransition.contDiff.comp
      ((contDiff_const.mul contDiff_id).sub contDiff_const))

/-- Positivity and the unit bound for Lemma 3.2's cutoff. -/
theorem smoothingPartitionCutoff_bounds (x : ℝ) :
    0 ≤ smoothingPartitionCutoff x ∧ smoothingPartitionCutoff x ≤ 1 := by
  constructor
  · exact sub_nonneg.mpr (Real.smoothTransition.monotone (by linarith))
  · unfold smoothingPartitionCutoff
    linarith [Real.smoothTransition.le_one (2 * x + 3 / 2),
      Real.smoothTransition.nonneg (2 * x - 1 / 2)]

/-- The cutoff in Lemma 3.2 vanishes outside the inner interval. -/
theorem smoothingPartitionCutoff_eq_zero {x : ℝ} (hx : 3 / 4 ≤ |x|) :
    smoothingPartitionCutoff x = 0 := by
  unfold smoothingPartitionCutoff
  rcases le_abs.mp hx with h | h
  · rw [Real.smoothTransition.one_of_one_le (by linarith),
      Real.smoothTransition.one_of_one_le (by linarith), sub_self]
  · rw [Real.smoothTransition.zero_of_nonpos (by linarith),
      Real.smoothTransition.zero_of_nonpos (by linarith), sub_self]

/-- Compact support strictly inside the source's interval (-1,1). -/
theorem smoothingPartitionCutoff_tsupport :
    tsupport smoothingPartitionCutoff ⊆ Set.Icc (-3 / 4 : ℝ) (3 / 4) := by
  apply closure_minimal _ isClosed_Icc
  intro x hx
  have h : |x| < 3 / 4 := lt_of_not_ge fun h => hx (smoothingPartitionCutoff_eq_zero h)
  constructor <;> linarith [(abs_lt.mp h).1, (abs_lt.mp h).2]

/-- The source's cutoff belongs to C∞ with compact support. -/
theorem smoothingPartitionCutoff_hasCompactSupport : HasCompactSupport smoothingPartitionCutoff :=
  isCompact_Icc.of_isClosed_subset isClosed_closure smoothingPartitionCutoff_tsupport

/-- Finite telescoping form of the integer partition in Lemma 3.2, reusing
lean-spherical's integer telescoping theorem. -/
theorem smoothingPartitionCutoff_sum (x : ℝ) (M : ℕ) (hM : |x| + 1 ≤ M) :
    ∑ n ∈ Finset.Icc (-(M : ℤ)) (M : ℤ), smoothingPartitionCutoff (x - n) = 1 := by
  let F : ℤ → ℝ := fun n => Real.smoothTransition (2 * (x - n) - 1 / 2)
  have heq (n : ℤ) : smoothingPartitionCutoff (x - n) = F (n - 1) - F n := by
    simp only [smoothingPartitionCutoff, F, Int.cast_sub, Int.cast_one]
    congr 2; ring
  simp_rw [heq]
  rw [CalderonVaillancourt.sum_Icc_telescope]
  have hleft : F (-(M : ℤ) - 1) = 1 := by
    apply Real.smoothTransition.one_of_one_le
    simp only [Int.cast_sub, Int.cast_neg, Int.cast_natCast, Int.cast_one]
    linarith [neg_abs_le x]
  have hright : F (M : ℤ) = 0 := by
    apply Real.smoothTransition.zero_of_nonpos
    simp only [Int.cast_natCast]
    linarith [le_abs_self x]
  rw [hleft, hright, sub_zero]
/-- The integer translates of the smooth cutoff sum to one, as required in the
first sentence of Lemma 3.2's proof. The sum has finite support at every point. -/
theorem smoothingPartitionCutoff_partition (x : ℝ) :
    ∑' n : ℤ, smoothingPartitionCutoff (x + n) = 1 := by
  obtain ⟨M, hM⟩ := exists_nat_gt (|x| + 1)
  have hfinite : ∀ n : ℤ, n ∉ Finset.Icc (-(M : ℤ)) (M : ℤ) →
      smoothingPartitionCutoff (x - n) = 0 := by
    intro n hn
    apply smoothingPartitionCutoff_eq_zero
    simp only [Finset.mem_Icc, not_and_or, not_le] at hn
    rcases hn with hn | hn
    · have hn' : (n : ℝ) < -(M : ℝ) := by exact_mod_cast hn
      apply le_abs.mpr
      left
      linarith [neg_abs_le x]
    · have hn' : (M : ℝ) < (n : ℝ) := by exact_mod_cast hn
      apply le_abs.mpr
      right
      linarith [le_abs_self x]
  have hsum : (∑' n : ℤ, smoothingPartitionCutoff (x - n)) = 1 := by
    rw [tsum_eq_sum hfinite]
    exact smoothingPartitionCutoff_sum x M hM.le
  have hreindex := (Equiv.neg ℤ).tsum_eq (fun n : ℤ => smoothingPartitionCutoff (x - n))
  simpa only [Equiv.neg_apply, Int.cast_neg, sub_neg_eq_add] using hreindex.trans hsum

#print axioms smoothingPartitionCutoff_partition
#print axioms smoothingPartitionCutoff_contDiff
#print axioms smoothingPartitionCutoff_hasCompactSupport
/-- The first sentence of Lemma 3.2's proof: choose a smooth compactly supported
partition cutoff in (-1,1). The nonnegative unit bound also holds for this choice. -/
theorem smoothing_lemma3_2_partition :
    ∃ φ : ℝ → ℝ, ContDiff ℝ ∞ φ ∧ HasCompactSupport φ ∧
      tsupport φ ⊆ Set.Ioo (-1 : ℝ) 1 ∧
      (∀ x, 0 ≤ φ x ∧ φ x ≤ 1) ∧ (∀ x, ∑' n : ℤ, φ (x + n) = 1) := by
  refine ⟨smoothingPartitionCutoff, smoothingPartitionCutoff_contDiff,
    smoothingPartitionCutoff_hasCompactSupport, ?_, smoothingPartitionCutoff_bounds,
    smoothingPartitionCutoff_partition⟩
  intro x hx
  have h := smoothingPartitionCutoff_tsupport hx
  constructor <;> linarith [h.1, h.2]

#print axioms smoothing_lemma3_2_partition
/-- The high-mass index set in Lemma 3.2's proof. The interval has length R
and intersects the support of the corresponding scaled partition cutoff. -/
def smoothingHighMassIndices (w : ℝ → ℝ) (R ρ : ℝ) : Set ℤ :=
  {n | ∃ a : ℝ,
    (Set.Icc a (a + R) ∩ Function.support
      (fun ξ => smoothingPartitionCutoff (ξ / R + n))).Nonempty ∧
    ρ * (∫ ξ, w ξ) ≤ ∫ ξ in Set.Icc a (a + R), w ξ}

/-- An enlarged frequency window contains any length-R interval used to select
its index in Lemma 3.2. -/
def smoothingFrequencyWindow (R : ℝ) (n : ℤ) : Set ℝ :=
  {ξ | |ξ / R + n| ≤ 2}

/-- The enlarged frequency windows used for counting are measurable. -/
theorem smoothingFrequencyWindow_measurable (R : ℝ) (n : ℤ) :
    MeasurableSet (smoothingFrequencyWindow R n) :=
  (isClosed_le ((continuous_id.div_const R).add continuous_const).abs
    continuous_const).measurableSet

/-- The source interval meeting the cutoff support lies in the enlarged window. -/
theorem smoothing_interval_subset_window {R : ℝ} (hR : 0 < R) (n : ℤ) (a : ℝ)
    (hi : (Set.Icc a (a + R) ∩ Function.support
      (fun ξ => smoothingPartitionCutoff (ξ / R + n))).Nonempty) :
    Set.Icc a (a + R) ⊆ smoothingFrequencyWindow R n := by
  obtain ⟨y, hy, hyφ⟩ := hi
  have hybound : |y / R + n| < 3 / 4 :=
    lt_of_not_ge fun h => hyφ (smoothingPartitionCutoff_eq_zero h)
  intro x hx
  change |x / R + n| ≤ 2
  have hxy : -R ≤ x - y ∧ x - y ≤ R := by
    constructor <;> linarith [hx.1, hx.2, hy.1, hy.2]
  have hd : -1 ≤ (x - y) / R ∧ (x - y) / R ≤ 1 := by
    constructor
    · apply (le_div_iff₀ hR).mpr
      linarith [hxy.1]
    · apply (div_le_iff₀ hR).mpr
      linarith [hxy.2]
  rw [abs_le]
  rw [sub_div] at hd
  constructor <;> linarith [(abs_lt.mp hybound).1, (abs_lt.mp hybound).2, hd.1, hd.2]

/-- Each selected high-mass index has at least the threshold mass in its window. -/
theorem smoothing_highMass_window_mass {w : ℝ → ℝ} (hw : Integrable w volume)
    (hwpos : ∀ᵐ ξ ∂volume, 0 ≤ w ξ) {R ρ : ℝ} (hR : 0 < R)
    {n : ℤ} (hn : n ∈ smoothingHighMassIndices w R ρ) :
    ρ * (∫ ξ, w ξ) ≤ ∫ ξ in smoothingFrequencyWindow R n, w ξ := by
  obtain ⟨a, hi, hm⟩ := hn
  apply hm.trans
  exact setIntegral_mono_set hw.integrableOn (ae_restrict_of_ae hwpos)
    (Filter.Eventually.of_forall (smoothing_interval_subset_window hR n a hi))

/-- At most six enlarged windows contain any fixed frequency. -/
theorem smoothingFrequencyWindow_overlap (R x : ℝ) (S : Finset ℤ) :
    (S.filter (fun n : ℤ => |x / R + (n : ℝ)| ≤ 2)).card ≤ 6 := by
  classical
  let k : ℤ := ⌊-x / R⌋
  have hlow : (k : ℝ) ≤ -x / R := Int.floor_le _
  have hupp : -x / R < (k : ℝ) + 1 := Int.lt_floor_add_one _
  simp only [neg_div] at hlow hupp
  have hsub : S.filter (fun n : ℤ => |x / R + (n : ℝ)| ≤ 2) ⊆
      Finset.Icc (k - 2) (k + 3) := by
    intro n hn
    have hn' := (abs_le.mp (Finset.mem_filter.mp hn).2)
    have hlo : (k : ℝ) - 2 ≤ n := by linarith [hn'.1]
    have hhi : (n : ℝ) ≤ (k : ℝ) + 3 := by linarith [hn'.2]
    simp only [Finset.mem_Icc]
    exact ⟨by exact_mod_cast hlo, by exact_mod_cast hhi⟩
  apply (Finset.card_le_card hsub).trans
  rw [Int.card_Icc]
  omega
/-- Bounded overlap bounds the sum of spectral window masses in Lemma 3.2. -/
theorem smoothingFrequencyWindow_sum_integral {w : ℝ → ℝ} (hw : Integrable w volume)
    (hwpos : ∀ᵐ x ∂volume, 0 ≤ w x) (R : ℝ) (S : Finset ℤ) :
    (∑ n ∈ S, ∫ x in smoothingFrequencyWindow R n, w x) ≤ 6 * ∫ x, w x := by
  classical
  simp_rw [← integral_indicator (smoothingFrequencyWindow_measurable R _)]
  rw [← integral_finsetSum S (fun n _ => hw.indicator (smoothingFrequencyWindow_measurable R n)),
    ← integral_const_mul]
  apply integral_mono_ae
    (integrable_finsetSum S (fun n _ => hw.indicator (smoothingFrequencyWindow_measurable R n)))
    (hw.const_mul 6)
  filter_upwards [hwpos] with x hx
  have hsum : (∑ n ∈ S, (smoothingFrequencyWindow R n).indicator w x) =
      ((S.filter (fun n : ℤ => |x / R + (n : ℝ)| ≤ 2)).card : ℝ) * w x := by
    change (∑ n ∈ S, if |x / R + (n : ℝ)| ≤ 2 then w x else 0) = _
    simp only [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
  rw [hsum]
  exact mul_le_mul_of_nonneg_right (by exact_mod_cast smoothingFrequencyWindow_overlap R x S) hx

/-- The finite-subset counting estimate for the high-mass indices of Lemma 3.2. -/
theorem smoothingHighMassIndices_card_bound {w : ℝ → ℝ} (hw : Integrable w volume)
    (hwpos : ∀ᵐ x ∂volume, 0 ≤ w x) (hmass : 0 < ∫ x, w x)
    {R ρ : ℝ} (hR : 0 < R) (hρ : 0 < ρ) (S : Finset ℤ)
    (hS : ∀ n ∈ S, n ∈ smoothingHighMassIndices w R ρ) :
    (S.card : ℝ) ≤ 6 / ρ := by
  have hlow : (S.card : ℝ) * (ρ * ∫ x, w x) ≤
      ∑ n ∈ S, ∫ x in smoothingFrequencyWindow R n, w x := by
    calc
      _ = ∑ n ∈ S, ρ * ∫ x, w x := by simp
      _ ≤ _ := Finset.sum_le_sum fun n hn => smoothing_highMass_window_mass hw hwpos hR (hS n hn)
  have htotal := hlow.trans (smoothingFrequencyWindow_sum_integral hw hwpos R S)
  apply (le_div_iff₀ hρ).mpr
  nlinarith

/-- The high-mass indices in Lemma 3.2 form a finite set of cardinality O(ρ⁻¹).
The source's zero-input case is excluded only from this counting helper. -/
theorem smoothingHighMassIndices_finite {w : ℝ → ℝ} (hw : Integrable w volume)
    (hwpos : ∀ᵐ x ∂volume, 0 ≤ w x) (hmass : 0 < ∫ x, w x)
    {R ρ : ℝ} (hR : 0 < R) (hρ : 0 < ρ) :
    (smoothingHighMassIndices w R ρ).Finite ∧
      ((smoothingHighMassIndices w R ρ).ncard : ℝ) ≤ 6 / ρ := by
  classical
  have hfinite : (smoothingHighMassIndices w R ρ).Finite := by
    by_contra hinf
    obtain ⟨N, hN⟩ := exists_nat_gt (6 / ρ)
    obtain ⟨T, hT, hTf, hTc⟩ := Set.Infinite.exists_subset_ncard_eq hinf N
    have hb := smoothingHighMassIndices_card_bound hw hwpos hmass hR hρ hTf.toFinset
      (fun n hn => hT (hTf.mem_toFinset.mp hn))
    rw [← Set.ncard_eq_toFinset_card T hTf, hTc] at hb
    exact not_le_of_gt hN hb
  refine ⟨hfinite, ?_⟩
  rw [Set.ncard_eq_toFinset_card _ hfinite]
  exact smoothingHighMassIndices_card_bound hw hwpos hmass hR hρ hfinite.toFinset
    (by simp)

#print axioms smoothingHighMassIndices_finite
/-- The finite multiplier defining the sharp part in Lemma 3.2. -/
noncomputable def smoothingSharpMultiplier (R : ℝ) (S : Finset ℤ) (ξ : ℝ) : ℝ :=
  ∑ n ∈ S, smoothingPartitionCutoff (ξ / R + n)

/-- The source's finite multiplier is between zero and one. -/
theorem smoothingSharpMultiplier_bounds (R : ℝ) (S : Finset ℤ) (ξ : ℝ) :
    0 ≤ smoothingSharpMultiplier R S ξ ∧ smoothingSharpMultiplier R S ξ ≤ 1 := by
  constructor
  · exact Finset.sum_nonneg fun n _ => (smoothingPartitionCutoff_bounds _).1
  · have hs : Summable (fun n : ℤ => smoothingPartitionCutoff (ξ / R + n)) :=
      by
        by_contra h
        have hz := tsum_eq_zero_of_not_summable h
        rw [smoothingPartitionCutoff_partition] at hz
        norm_num at hz
    simpa only [smoothingPartitionCutoff_partition, smoothingSharpMultiplier] using!
      hs.sum_le_tsum S (fun n _ => (smoothingPartitionCutoff_bounds _).1)

/-- The finite sharp multiplier is measurable. -/
theorem smoothingSharpMultiplier_continuous (R : ℝ) (S : Finset ℤ) :
    Continuous (smoothingSharpMultiplier R S) := by
  apply continuous_finsetSum
  intro n _
  exact smoothingPartitionCutoff_contDiff.continuous.comp
    ((continuous_id.div_const R).add continuous_const)

/-- The sharp Fourier multiplier acts on every L² input. -/
theorem smoothing_memLp_sharpMultiplier (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (S : Finset ℤ) :
    MemLp (fun ξ => (smoothingSharpMultiplier R S ξ : ℂ) *
      (𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ) 2 volume := by
  apply (Lp.memLp (𝓕 f)).of_le
    (((Complex.continuous_ofReal.comp (smoothingSharpMultiplier_continuous R S)).aestronglyMeasurable).mul
      (Lp.memLp (𝓕 f)).1)
  filter_upwards [] with ξ
  simp only [Pi.mul_apply, Function.comp_apply]
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (smoothingSharpMultiplier_bounds R S ξ).1]
  exact mul_le_of_le_one_left (norm_nonneg _) (smoothingSharpMultiplier_bounds R S ξ).2

/-- The sharp part defined in the displayed formulas of Lemma 3.2's proof. -/
noncomputable def smoothingSharpPart (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (S : Finset ℤ) : Lp (α := ℝ) ℂ 2 volume :=
  𝓕⁻ ((smoothing_memLp_sharpMultiplier f R S).toLp _)

/-- The flat part in the same source display. -/
noncomputable def smoothingFlatPart (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (S : Finset ℤ) : Lp (α := ℝ) ℂ 2 volume :=
  f - smoothingSharpPart f R S

/-- The defining Fourier formula for the sharp part, valid almost everywhere. -/
theorem smoothingSharpPart_fourier (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (S : Finset ℤ) :
    ∀ᵐ ξ ∂volume, (𝓕 (smoothingSharpPart f R S) : Lp (α := ℝ) ℂ 2 volume) ξ =
      (smoothingSharpMultiplier R S ξ : ℂ) * (𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ := by
  rw [smoothingSharpPart, fourier_fourierInv_eq]
  exact (smoothing_memLp_sharpMultiplier f R S).coeFn_toLp

/-- The defining Fourier formula for the flat part, valid almost everywhere. -/
theorem smoothingFlatPart_fourier (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (S : Finset ℤ) :
    ∀ᵐ ξ ∂volume, (𝓕 (smoothingFlatPart f R S) : Lp (α := ℝ) ℂ 2 volume) ξ =
      (1 - (smoothingSharpMultiplier R S ξ : ℂ)) * (𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ := by
  rw [smoothingFlatPart, show 𝓕 (f - smoothingSharpPart f R S) =
    𝓕 f - 𝓕 (smoothingSharpPart f R S) from (Lp.fourierTransformₗᵢ ℝ ℂ).map_sub _ _]
  filter_upwards [Lp.coeFn_sub (𝓕 f) (𝓕 (smoothingSharpPart f R S)),
    smoothingSharpPart_fourier f R S] with ξ hsub hsharp
  rw [hsub, Pi.sub_apply, hsharp]
  ring

/-- The sharp and flat parts give the source's exact decomposition. -/
theorem smoothing_sharp_add_flat (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (S : Finset ℤ) : f = smoothingSharpPart f R S + smoothingFlatPart f R S := by
  simp only [smoothingFlatPart, add_sub_cancel]

#print axioms smoothingSharpPart_fourier
#print axioms smoothingFlatPart_fourier
#print axioms smoothing_sharp_add_flat
/-- Select the source's finite index set for a nonzero L² input; for the zero
input choose the empty set, as required for the trivial decomposition. -/
theorem smoothing_select_highMass_indices (f : Lp (α := ℝ) ℂ 2 volume)
    {R ρ : ℝ} (hR : 0 < R) (hρ : 0 < ρ) :
    ∃ S : Finset ℤ, (S.card : ℝ) ≤ 6 / ρ ∧
      (f = 0 → S = ∅) ∧
      (f ≠ 0 → ∀ n : ℤ, n ∈ S ↔ n ∈ smoothingHighMassIndices
        (fun ξ => ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) R ρ) := by
  classical
  by_cases hf : f = 0
  · refine ⟨∅, ?_, fun _ => rfl, fun h => (h hf).elim⟩
    simp only [Finset.card_empty, Nat.cast_zero]
    positivity
  · let w : ℝ → ℝ := fun ξ => ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2
    have hw : Integrable w volume :=
      (memLp_two_iff_integrable_sq_norm (Lp.memLp (𝓕 f)).1).mp (Lp.memLp (𝓕 f))
    have hm : (∫ ξ, w ξ) = ‖f‖ ^ 2 := by
      have h := smoothing_frequencyRestriction_norm_sq (Lp.memLp (𝓕 f)) MeasurableSet.univ
      simpa only [Set.indicator_univ, Lp.toLp_coeFn, Measure.restrict_univ,
        Lp.norm_fourier_eq] using h.symm
    have hmpos : 0 < ∫ ξ, w ξ := by
      rw [hm]
      exact sq_pos_of_pos (norm_pos_iff.mpr hf)
    obtain ⟨hfinite, hcard⟩ := smoothingHighMassIndices_finite hw
      (Filter.Eventually.of_forall fun ξ => sq_nonneg _) hmpos hR hρ
    refine ⟨hfinite.toFinset, ?_, fun h => (hf h).elim, ?_⟩
    · rwa [← Set.ncard_eq_toFinset_card _ hfinite]
    · intro _ n
      exact hfinite.mem_toFinset

/-- The displayed sharp/flat definitions in Lemma 3.2 produce L² functions
with the selected high-mass index set, exact Fourier formulas and exact sum f. -/
theorem smoothing_lemma3_2_frequency_decomposition (f : Lp (α := ℝ) ℂ 2 volume)
    {R ρ : ℝ} (hR : 0 < R) (hρ : 0 < ρ) :
    ∃ S : Finset ℤ, (S.card : ℝ) ≤ 6 / ρ ∧
      (f = 0 → S = ∅) ∧
      (f ≠ 0 → ∀ n : ℤ, n ∈ S ↔ n ∈ smoothingHighMassIndices
        (fun ξ => ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) R ρ) ∧
      f = smoothingSharpPart f R S + smoothingFlatPart f R S ∧
      (∀ᵐ ξ ∂volume, (𝓕 (smoothingSharpPart f R S) : Lp (α := ℝ) ℂ 2 volume) ξ =
        (smoothingSharpMultiplier R S ξ : ℂ) * (𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ) ∧
      (∀ᵐ ξ ∂volume, (𝓕 (smoothingFlatPart f R S) : Lp (α := ℝ) ℂ 2 volume) ξ =
        (1 - (smoothingSharpMultiplier R S ξ : ℂ)) * (𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ) := by
  obtain ⟨S, hcard, hzero, hselect⟩ := smoothing_select_highMass_indices f hR hρ
  exact ⟨S, hcard, hzero, hselect, smoothing_sharp_add_flat f R S,
    smoothingSharpPart_fourier f R S, smoothingFlatPart_fourier f R S⟩

#print axioms smoothing_lemma3_2_frequency_decomposition
/-- The sharp part's L² bound in Lemma 3.2(1). -/
theorem smoothingSharpPart_norm_le (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (S : Finset ℤ) : ‖smoothingSharpPart f R S‖ ≤ ‖f‖ := by
  rw [← Lp.norm_fourier_eq (smoothingSharpPart f R S), ← Lp.norm_fourier_eq f]
  apply Lp.norm_le_norm_of_ae_le
  filter_upwards [smoothingSharpPart_fourier f R S] with ξ hξ
  rw [hξ, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (smoothingSharpMultiplier_bounds R S ξ).1]
  exact mul_le_of_le_one_left (norm_nonneg _) (smoothingSharpMultiplier_bounds R S ξ).2

/-- The flat part's L² bound in Lemma 3.2(1). -/
theorem smoothingFlatPart_norm_le (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (S : Finset ℤ) : ‖smoothingFlatPart f R S‖ ≤ ‖f‖ := by
  rw [← Lp.norm_fourier_eq (smoothingFlatPart f R S), ← Lp.norm_fourier_eq f]
  apply Lp.norm_le_norm_of_ae_le
  filter_upwards [smoothingFlatPart_fourier f R S] with ξ hξ
  rw [hξ, norm_mul, ← Complex.ofReal_one, ← Complex.ofReal_sub,
    Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (sub_nonneg.mpr (smoothingSharpMultiplier_bounds R S ξ).2)]
  exact mul_le_of_le_one_left (norm_nonneg _) (by linarith [(smoothingSharpMultiplier_bounds R S ξ).1])

/-- Lemma 3.2(1), with the uniform implicit constant made explicit as 2. -/
theorem smoothing_lemma3_2_L2_bounds (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (S : Finset ℤ) :
    ‖smoothingSharpPart f R S‖ + ‖smoothingFlatPart f R S‖ ≤ 2 * ‖f‖ := by
  linarith [smoothingSharpPart_norm_le f R S, smoothingFlatPart_norm_le f R S]

#print axioms smoothing_lemma3_2_L2_bounds
/-- The centered spectral piece whose inverse Fourier transform is h_n in
Lemma 3.2(2). Demodulation moves the selected window to the origin. -/
noncomputable def smoothingPieceSpectrum (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (n : ℤ) (ξ : ℝ) : ℂ :=
  (smoothingPartitionCutoff (ξ / R) : ℂ) *
    (𝓕 f : Lp (α := ℝ) ℂ 2 volume) (ξ - n * R)

/-- The smooth physical piece h_n in Lemma 3.2(2). -/
noncomputable def smoothingPiece (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (n : ℤ) : ℝ → ℂ := 𝓕⁻ (smoothingPieceSpectrum f R n)

/-- Compactness of the centered scaled cutoff supporting each spectral piece. -/
theorem smoothing_scaledCutoff_compact {R : ℝ} (hR : 0 < R) :
    HasCompactSupport (fun ξ : ℝ => smoothingPartitionCutoff (ξ / R)) := by
  apply HasCompactSupport.of_support_subset_isCompact (isCompact_Icc : IsCompact (Set.Icc (-R) R))
  intro ξ hξ
  have hb : |ξ / R| < 3 / 4 :=
    lt_of_not_ge fun h => hξ (smoothingPartitionCutoff_eq_zero h)
  rw [abs_div, abs_of_pos hR, div_lt_iff₀ hR] at hb
  apply abs_le.mp
  linarith

/-- Every spectral moment of a centered piece is integrable; this justifies
all smooth derivatives in Lemma 3.2(2), even for inputs only in L². -/
theorem smoothingPieceSpectrum_moments (f : Lp (α := ℝ) ℂ 2 volume)
    {R : ℝ} (hR : 0 < R) (n : ℤ) (k : ℕ) :
    Integrable (fun ξ : ℝ => ‖ξ‖ ^ k * ‖smoothingPieceSpectrum f R n ξ‖) volume := by
  have hc : Continuous (fun ξ : ℝ => ‖ξ‖ ^ k * smoothingPartitionCutoff (ξ / R)) :=
    (continuous_norm.pow k).mul
      (smoothingPartitionCutoff_contDiff.continuous.comp (continuous_id.div_const R))
  have hcompact : HasCompactSupport (fun ξ : ℝ => ‖ξ‖ ^ k * smoothingPartitionCutoff (ξ / R)) :=
    (smoothing_scaledCutoff_compact hR).mul_left
  have hc2 : MemLp (fun ξ : ℝ => ‖ξ‖ ^ k * smoothingPartitionCutoff (ξ / R)) 2 volume :=
    hc.memLp_of_hasCompactSupport hcompact
  have hF := (Lp.memLp (𝓕 f)).comp_measurePreserving
    (measurePreserving_add_right volume (-(n : ℝ) * R))
  have hprod := hc2.integrable_mul hF.norm
  change Integrable (fun ξ : ℝ => (‖ξ‖ ^ k * smoothingPartitionCutoff (ξ / R)) *
    ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) (ξ + (-(n : ℝ) * R))‖) volume at hprod
  simpa only [smoothingPieceSpectrum, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (smoothingPartitionCutoff_bounds _).1, Function.comp_def,
    sub_eq_add_neg, neg_mul, Pi.mul_apply, mul_assoc] using! hprod

/-- Smoothness of the demodulated functions h_n asserted in Lemma 3.2(2). -/
theorem smoothingPiece_contDiff (f : Lp (α := ℝ) ℂ 2 volume)
    {R : ℝ} (hR : 0 < R) (n : ℤ) : ContDiff ℝ ∞ (smoothingPiece f R n) := by
  have hF : ContDiff ℝ ∞ (𝓕 (smoothingPieceSpectrum f R n)) :=
    Real.contDiff_fourier (fun k _ => smoothingPieceSpectrum_moments f hR n k)
  change ContDiff ℝ ∞ (fun x => (𝓕⁻ (smoothingPieceSpectrum f R n)) x)
  simp_rw [Real.fourierInv_eq_fourier_neg]
  exact hF.comp contDiff_neg

#print axioms smoothingPiece_contDiff
/-- Compatibility of the inverse L² Fourier isometry with the convergent Fourier
integral on L¹ ∩ L², needed to interpret the spectral support of the pieces in Lemma 3.2. -/
theorem smoothing_fourierInv_toLp_ae_eq
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    {f : E → ℂ} (hf1 : Integrable f volume) (hf2 : MemLp f 2 volume) :
    (⇑(𝓕⁻ (hf2.toLp f) : Lp (α := E) ℂ 2 volume)) =ᵐ[volume] (𝓕⁻ f : E → ℂ) := by
  let H : Lp (α := E) ℂ 2 volume := 𝓕⁻ (hf2.toLp f)
  have hcont : Continuous (𝓕⁻ f : E → ℂ) :=
    VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar continuous_inner.neg hf1
  apply ae_eq_of_integral_contDiff_smul_eq
    ((Lp.memLp H).locallyIntegrable (by norm_num)) hcont.locallyIntegrable
  intro q hqs hqc
  have hqc' : HasCompactSupport (Complex.ofRealCLM ∘ q) := hqc.comp_left rfl
  have hqs' : ContDiff ℝ ∞ (Complex.ofRealCLM ∘ q) := by fun_prop
  let Q : SchwartzMap E ℂ := hqc'.toSchwartzMap hqs'
  have hdist := congrArg (fun T : TemperedDistribution E ℂ => T Q)
    (Lp.fourierInv_toTemperedDistribution_eq (hf2.toLp f))
  simp only [TemperedDistribution.fourierInv_apply, Lp.toTemperedDistribution_apply] at hdist
  have hflip := VectorFourier.integral_fourierIntegral_smul_eq_flip
    (μ := volume) (ν := volume) (L := -innerₗ E)
      Real.continuous_fourierChar continuous_inner.neg Q.integrable hf1
  have hfirst : (∫ x, (𝓕⁻ Q) x • (hf2.toLp f) x) = ∫ x, (𝓕⁻ Q) x • f x := by
    apply integral_congr_ae
    filter_upwards [hf2.coeFn_toLp] with x hx
    rw [hx]
  rw [hfirst] at hdist
  have hflip' : (∫ x, (𝓕⁻ Q) x • f x) = ∫ x, Q x • (𝓕⁻ f : E → ℂ) x := by
    have hsym : (-innerₗ E).flip = -innerₗ E := by
      ext x y
      simp [real_inner_comm]
    rw [hsym] at hflip
    simpa only [SchwartzMap.fourierInv_coe] using! hflip
  rw [hflip'] at hdist
  simpa [Q, H, Complex.real_smul] using hdist.symm

/-- The centered spectrum defining h_n belongs to L². -/
theorem smoothingPieceSpectrum_memLp (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (n : ℤ) : MemLp (smoothingPieceSpectrum f R n) 2 volume := by
  have hF := (Lp.memLp (𝓕 f)).comp_measurePreserving
    (measurePreserving_add_right volume (-(n : ℝ) * R))
  unfold smoothingPieceSpectrum
  simp only [sub_eq_add_neg, ← neg_mul]
  apply hF.of_le
    ((Complex.continuous_ofReal.comp (smoothingPartitionCutoff_contDiff.continuous.comp
      (continuous_id.div_const R))).aestronglyMeasurable.mul hF.1)
  filter_upwards [] with ξ
  simp only [Pi.mul_apply, Function.comp_apply, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (smoothingPartitionCutoff_bounds _).1]
  exact mul_le_of_le_one_left (norm_nonneg _) (smoothingPartitionCutoff_bounds _).2

/-- The centered spectrum is also integrable, so its inverse Fourier integral
is a representative of the corresponding inverse L² Fourier transform. -/
theorem smoothingPieceSpectrum_integrable (f : Lp (α := ℝ) ℂ 2 volume)
    {R : ℝ} (hR : 0 < R) (n : ℤ) : Integrable (smoothingPieceSpectrum f R n) volume := by
  apply (integrable_norm_iff (smoothingPieceSpectrum_memLp f R n).1).mp
  simpa only [pow_zero, one_mul] using smoothingPieceSpectrum_moments f hR n 0

/-- The L² class of the smooth piece h_n from Lemma 3.2. -/
noncomputable def smoothingPieceL2 (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (n : ℤ) : Lp (α := ℝ) ℂ 2 volume :=
  𝓕⁻ ((smoothingPieceSpectrum_memLp f R n).toLp _)

/-- The smooth h_n and its L² class agree almost everywhere. -/
theorem smoothingPieceL2_coe (f : Lp (α := ℝ) ℂ 2 volume)
    {R : ℝ} (hR : 0 < R) (n : ℤ) :
    ⇑(smoothingPieceL2 f R n) =ᵐ[volume] smoothingPiece f R n :=
  smoothing_fourierInv_toLp_ae_eq (smoothingPieceSpectrum_integrable f hR n)
    (smoothingPieceSpectrum_memLp f R n)

/-- The defining L² Fourier transform of the smooth piece h_n. -/
theorem smoothingPieceL2_fourier (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (n : ℤ) :
    ⇑(𝓕 (smoothingPieceL2 f R n) : Lp (α := ℝ) ℂ 2 volume) =ᵐ[volume]
      smoothingPieceSpectrum f R n := by
  rw [smoothingPieceL2, fourier_fourierInv_eq]
  exact (smoothingPieceSpectrum_memLp f R n).coeFn_toLp

/-- The Fourier support of h_n lies in [-R,R], as asserted in Lemma 3.2(2). -/
theorem smoothingPieceL2_fourier_support (f : Lp (α := ℝ) ℂ 2 volume)
    {R : ℝ} (hR : 0 < R) (n : ℤ) :
    ∀ᵐ ξ ∂volume, ξ ∉ Set.Icc (-R) R →
      (𝓕 (smoothingPieceL2 f R n) : Lp (α := ℝ) ℂ 2 volume) ξ = 0 := by
  filter_upwards [smoothingPieceL2_fourier f R n] with ξ hξ
  intro hout
  rw [hξ, smoothingPieceSpectrum]
  have habs : R < |ξ| := lt_of_not_ge (fun h => hout (abs_le.mp h))
  have hz : smoothingPartitionCutoff (ξ / R) = 0 := by
    apply smoothingPartitionCutoff_eq_zero
    rw [abs_div, abs_of_pos hR, le_div_iff₀ hR]
    linarith
  rw [hz, Complex.ofReal_zero, zero_mul]

#print axioms smoothingPieceL2_coe
#print axioms smoothingPieceL2_fourier_support
/-- The individual L² bound for h_n in Lemma 3.2(2), with constant one. -/
theorem smoothingPieceL2_norm_le (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (n : ℤ) : ‖smoothingPieceL2 f R n‖ ≤ ‖f‖ := by
  have hbound : ‖(𝓕 (smoothingPieceL2 f R n) : Lp (α := ℝ) ℂ 2 volume)‖ ≤
      ‖smoothingTranslationL2 (-(n : ℝ) * R) (𝓕 f)‖ := by
    apply Lp.norm_le_norm_of_ae_le
    filter_upwards [smoothingPieceL2_fourier f R n,
      smoothingTranslationL2_coe (-(n : ℝ) * R) (𝓕 f)] with ξ hξ ht
    rw [hξ, ht, smoothingPieceSpectrum, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (smoothingPartitionCutoff_bounds _).1]
    simp only [sub_eq_add_neg, neg_mul]
    exact mul_le_of_le_one_left (norm_nonneg _) (smoothingPartitionCutoff_bounds _).2
  simpa only [Lp.norm_fourier_eq, LinearIsometry.norm_map] using hbound

#print axioms smoothingPieceL2_norm_le
/-- Remodulating h_n restores its selected frequency window in Lemma 3.2(2). -/
theorem smoothing_modulatedPiece_fourier (f : Lp (α := ℝ) ℂ 2 volume)
    {R : ℝ} (hR : 0 < R) (n : ℤ) :
    ∀ᵐ ξ ∂volume,
      (𝓕 (smoothingModulationL2 (-(n : ℝ) * R) (smoothingPieceL2 f R n)) :
        Lp (α := ℝ) ℂ 2 volume) ξ =
      (smoothingPartitionCutoff (ξ / R + n) : ℂ) * (𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ := by
  rw [smoothing_fourier_modulation]
  have hspec := (measurePreserving_add_right volume (-(-(n : ℝ) * R))).quasiMeasurePreserving.ae_eq
    (smoothingPieceL2_fourier f R n)
  filter_upwards [smoothingTranslationL2_coe (-(-(n : ℝ) * R))
    (𝓕 (smoothingPieceL2 f R n)), hspec] with ξ ht hs
  simp only [Function.comp_apply] at hs
  rw [ht, hs, smoothingPieceSpectrum]
  simp only [neg_mul, neg_neg, add_sub_cancel_right, add_div, mul_div_cancel_right₀ _ hR.ne']

/-- The L² finite modulated sum in the display of Lemma 3.2(2). -/
theorem smoothingSharpPart_eq_sum_modulation (f : Lp (α := ℝ) ℂ 2 volume)
    {R : ℝ} (hR : 0 < R) (S : Finset ℤ) :
    smoothingSharpPart f R S =
      ∑ n ∈ S, smoothingModulationL2 (-(n : ℝ) * R) (smoothingPieceL2 f R n) := by
  apply (Lp.fourierTransformₗᵢ ℝ ℂ).injective
  change 𝓕 (smoothingSharpPart f R S) = 𝓕 (∑ n ∈ S,
    smoothingModulationL2 (-(n : ℝ) * R) (smoothingPieceL2 f R n))
  rw [fourier_sum]
  apply Lp.ext
  have hall := ae_all_iff.mpr (fun n : ℤ => smoothing_modulatedPiece_fourier f hR n)
  filter_upwards [smoothingSharpPart_fourier f R S,
    Lp.coeFn_fun_finsetSum S (fun n =>
      𝓕 (smoothingModulationL2 (-(n : ℝ) * R) (smoothingPieceL2 f R n))), hall] with ξ hsharp hsum hall
  rw [hsharp, hsum]
  simp_rw [hall]
  simp only [smoothingSharpMultiplier, Complex.ofReal_sum, Finset.sum_mul]

/-- The displayed reconstruction in Lemma 3.2(2), using the smooth representatives
h_n and the Fourier character with frequency -nR. -/
theorem smoothingSharpPart_eq_sum_smoothPieces (f : Lp (α := ℝ) ℂ 2 volume)
    {R : ℝ} (hR : 0 < R) (S : Finset ℤ) :
    ∀ᵐ x ∂volume, smoothingSharpPart f R S x =
      ∑ n ∈ S, Real.fourierChar (inner ℝ (-(n : ℝ) * R) x) • smoothingPiece f R n x := by
  rw [smoothingSharpPart_eq_sum_modulation f hR S]
  have hmod := ae_all_iff.mpr (fun n : ℤ =>
    smoothingModulationL2_coe (-(n : ℝ) * R) (smoothingPieceL2 f R n))
  have hpiece := ae_all_iff.mpr (fun n : ℤ => smoothingPieceL2_coe f hR n)
  filter_upwards [Lp.coeFn_fun_finsetSum S (fun n =>
    smoothingModulationL2 (-(n : ℝ) * R) (smoothingPieceL2 f R n)), hmod, hpiece]
    with x hsum hm hp
  rw [hsum]
  apply Finset.sum_congr rfl
  intro n _
  rw [hm n, hp n]

#print axioms smoothingSharpPart_eq_sum_smoothPieces
/-- The displayed modulated sum of Lemma 3.2(2) in exponential notation,
with real frequencies α_n = -2πnR. -/
theorem smoothingSharpPart_eq_sum_exp (f : Lp (α := ℝ) ℂ 2 volume)
    {R : ℝ} (hR : 0 < R) (S : Finset ℤ) :
    ∀ᵐ x ∂volume, smoothingSharpPart f R S x =
      ∑ n ∈ S, smoothingPiece f R n x *
        Complex.exp (Complex.I * ((-2 * Real.pi * (n : ℝ) * R * x : ℝ) : ℂ)) := by
  filter_upwards [smoothingSharpPart_eq_sum_smoothPieces f hR S] with x hx
  rw [hx]
  apply Finset.sum_congr rfl
  intro n _
  have hc : (Real.fourierChar (inner ℝ (-(n : ℝ) * R) x) : ℂ) =
      Complex.exp (Complex.I * ((-2 * Real.pi * (n : ℝ) * R * x : ℝ) : ℂ)) := by
    rw [Real.fourierChar_apply]
    congr 1
    simp only [RCLike.inner_apply, starRingEnd_apply, star_trivial]
    push_cast
    ring
  rw [Circle.smul_def, smul_eq_mul, hc, mul_comm]

#print axioms smoothingSharpPart_eq_sum_exp
/-- Schwartz-test Fourier duality for arbitrary L² inputs, used for the
uniform derivative bound in Lemma 3.2(2). -/
theorem smoothing_integral_schwartz_mul_fourier (Q : SchwartzMap ℝ ℂ)
    (f : Lp (α := ℝ) ℂ 2 volume) :
    (∫ ξ, Q ξ * (𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ) = ∫ x, (𝓕 Q) x * f x := by
  have hd := congrArg (fun T : TemperedDistribution ℝ ℂ => T Q)
    (Lp.fourier_toTemperedDistribution_eq f)
  simpa only [TemperedDistribution.fourier_apply, Lp.toTemperedDistribution_apply,
    smul_eq_mul] using hd.symm

/-- A physical L∞ bound controls the spectral pairing by the L¹ norm of the
Schwartz kernel. This extends the needed multiplier bound to L² inputs. -/
theorem smoothing_norm_schwartz_pairing_le (Q : SchwartzMap ℝ ℂ)
    (f : Lp (α := ℝ) ℂ 2 volume) {M : ℝ} (hf : ∀ᵐ x ∂volume, ‖f x‖ ≤ M) :
    ‖∫ ξ, Q ξ * (𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ≤
      M * ∫ x, ‖(𝓕 Q) x‖ := by
  rw [smoothing_integral_schwartz_mul_fourier, ← integral_const_mul]
  apply norm_integral_le_of_norm_le ((𝓕 Q).integrable.norm.const_mul M)
  filter_upwards [hf] with x hx
  rw [norm_mul, mul_comm M]
  exact mul_le_mul_of_nonneg_left hx (norm_nonneg _)
/-- The real Fourier scaling identity underlying the uniform derivative
constant in Lemma 3.2(2). -/
theorem smoothing_fourier_scale (ψ : ℝ → ℂ) {R : ℝ} (hR : 0 < R) (y : ℝ) :
    (𝓕 (fun ξ : ℝ => ψ (ξ / R))) y = R • (𝓕 ψ) (R * y) := by
  rw [Real.fourier_eq, Real.fourier_eq]
  calc
    _ = ∫ ξ : ℝ, (fun u : ℝ => Real.fourierChar (-inner ℝ u (R * y)) • ψ u) (ξ / R) := by
      apply integral_congr_ae
      filter_upwards [] with ξ
      congr 2
      simp only [RCLike.inner_apply, starRingEnd_apply, star_trivial]
      field_simp
    _ = _ := by
      simpa only [abs_of_pos hR] using!
        (Measure.integral_comp_div (fun u : ℝ =>
          Real.fourierChar (-inner ℝ u (R * y)) • ψ u) R)

/-- Scaling the frequency cutoff preserves the L¹ norm of its Fourier kernel. -/
theorem smoothing_integral_norm_fourier_scale (ψ : ℝ → ℂ) {R : ℝ} (hR : 0 < R) :
    (∫ y : ℝ, ‖(𝓕 (fun ξ : ℝ => ψ (ξ / R))) y‖) = ∫ y : ℝ, ‖(𝓕 ψ) y‖ := by
  simp_rw [smoothing_fourier_scale ψ hR, norm_smul, Real.norm_eq_abs, abs_of_pos hR]
  rw [integral_const_mul]
  have hs := Measure.integral_comp_mul_left (fun y : ℝ => ‖(𝓕 ψ : ℝ → ℂ) y‖) R
  have hs' : (∫ y : ℝ, ‖(𝓕 ψ : ℝ → ℂ) (R * y)‖) =
      R⁻¹ * ∫ y : ℝ, ‖(𝓕 ψ : ℝ → ℂ) y‖ := by
    simpa only [smul_eq_mul, abs_inv, abs_of_pos hR] using! hs
  rw [hs', ← mul_assoc, mul_inv_cancel₀ hR.ne', one_mul]
/-- The Fourier character is smooth as a complex-valued function. -/
theorem smoothing_fourierChar_contDiff (a : ℝ) :
    ContDiff ℝ ∞ (fun ξ : ℝ => (Real.fourierChar (inner ℝ a ξ) : ℂ)) := by
  simp_rw [Real.fourierChar_apply, RCLike.inner_apply, starRingEnd_apply, star_trivial]
  have hc : ContDiff ℝ ∞ (fun t : ℝ => (t : ℂ)) := Complex.ofRealCLM.contDiff
  fun_prop

/-- A smooth compact frequency multiplier has a scale-uniform L∞ bound on L²
inputs. This is the arbitrary-L² extension needed for Lemma 3.2(2). -/
theorem smoothing_scaled_multiplier_bound (φ : SchwartzMap ℝ ℂ)
    (hφ : HasCompactSupport (φ : ℝ → ℂ)) (f : Lp (α := ℝ) ℂ 2 volume)
    {R : ℝ} (hR : 0 < R) {M : ℝ} (hf : ∀ᵐ x ∂volume, ‖f x‖ ≤ M) (x : ℝ) :
    ‖(𝓕⁻ (fun ξ : ℝ => φ (ξ / R) * (𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ)) x‖ ≤
      M * ∫ y : ℝ, ‖(𝓕 φ) y‖ := by
  have hscaled : HasCompactSupport (fun ξ : ℝ => φ (ξ / R)) := by
    simpa only [Function.comp_def, Homeomorph.coe_mulRight₀, div_eq_mul_inv] using
      hφ.comp_homeomorph (Homeomorph.mulRight₀ R⁻¹ (inv_ne_zero hR.ne'))
  let q : ℝ → ℂ := fun ξ => (Real.fourierChar (inner ℝ x ξ) : ℂ) * φ (ξ / R)
  have hqc : HasCompactSupport q := hscaled.mul_left
  have hqs : ContDiff ℝ ∞ q :=
    (smoothing_fourierChar_contDiff x).mul (φ.smooth ⊤ |>.comp (contDiff_id.div_const R))
  let Q : SchwartzMap ℝ ℂ := hqc.toSchwartzMap hqs
  have hraw : (𝓕⁻ (fun ξ : ℝ => φ (ξ / R) * (𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ)) x =
      ∫ ξ, Q ξ * (𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ := by
    rw [Real.fourierInv_eq]
    apply integral_congr_ae
    filter_upwards [] with ξ
    change Real.fourierChar (inner ℝ ξ x) • (φ (ξ / R) * _) =
      ((Real.fourierChar (inner ℝ x ξ) : ℂ) * φ (ξ / R)) * _
    rw [real_inner_comm ξ x, Circle.smul_def, smul_eq_mul, mul_assoc]
  have hQF (y : ℝ) : (𝓕 Q) y = (𝓕 (fun ξ : ℝ => φ (ξ / R))) (y - x) := by
    rw [SchwartzMap.fourier_coe]
    exact smoothing_fourier_modulation_integral x (fun ξ : ℝ => φ (ξ / R)) y
  have hkernel : (∫ y : ℝ, ‖(𝓕 Q) y‖) = ∫ y : ℝ, ‖(𝓕 φ) y‖ := by
    simp_rw [hQF, sub_eq_add_neg]
    rw [integral_add_right_eq_self
      (fun y : ℝ => ‖(𝓕 (fun ξ : ℝ => φ (ξ / R)) : ℝ → ℂ) y‖) (-x)]
    simpa only [SchwartzMap.fourier_coe] using smoothing_integral_norm_fourier_scale (φ : ℝ → ℂ) hR
  rw [hraw, ← hkernel]
  exact smoothing_norm_schwartz_pairing_le Q f hf
/-- The one-dimensional inverse-Fourier derivative formula needed for the
R^N derivative estimate in Lemma 3.2(2). -/
theorem smoothing_iteratedDeriv_fourierInv {H : ℝ → ℂ}
    (hHm : AEStronglyMeasurable H volume)
    (hH : ∀ k : ℕ, Integrable (fun ξ : ℝ => ‖ξ‖ ^ k * ‖H ξ‖) volume) (N : ℕ) :
    iteratedDeriv N (𝓕⁻ H) =
      𝓕⁻ (fun ξ : ℝ => (2 * Real.pi * Complex.I * ξ) ^ N * H ξ) := by
  have hneg : ∀ k : ℕ, Integrable (fun ξ : ℝ => ξ ^ k • H (-ξ)) volume := by
    intro k
    have hmeas := (continuous_pow k).aestronglyMeasurable.smul
      (hHm.comp_measurePreserving (Measure.measurePreserving_neg volume))
    apply (integrable_norm_iff hmeas).mp
    change Integrable (fun ξ : ℝ => ‖(ξ ^ k : ℝ) • H (-ξ)‖) volume
    have hi := ((Measure.measurePreserving_neg volume).integrable_comp (hH k).1).mpr (hH k)
    simpa only [Function.comp_def, Pi.smul_apply, norm_neg, norm_smul, norm_pow] using hi
  rw [Real.fourierInv_eq_fourier_comp_neg,
    Real.iteratedDeriv_fourier (N := ⊤) (fun k _ => hneg k) (by simp),
    Real.fourierInv_eq_fourier_comp_neg]
  congr 1
  funext ξ
  simp only [smul_eq_mul, Complex.ofReal_neg]
  congr 2
  ring
/-- The fixed derivative cutoff (2πiξ)^N φ(ξ), whose Fourier kernel supplies
the order-dependent constant in Lemma 3.2(2). -/
noncomputable def smoothingDerivativeCutoff (N : ℕ) : SchwartzMap ℝ ℂ := by
  let u : ℝ → ℂ := fun ξ => (2 * Real.pi * Complex.I * ξ) ^ N *
    (smoothingPartitionCutoff ξ : ℂ)
  have hcompact : HasCompactSupport u :=
    (smoothingPartitionCutoff_hasCompactSupport.comp_left (g := Complex.ofReal) rfl).mul_left
  have hc : ContDiff ℝ ∞ (fun t : ℝ => (t : ℂ)) := Complex.ofRealCLM.contDiff
  have hu : ContDiff ℝ ∞ u := by
    unfold u
    have hp : ContDiff ℝ ∞ (fun ξ : ℝ => (2 * Real.pi * Complex.I * ξ) ^ N) := by fun_prop
    exact hp.mul (hc.comp smoothingPartitionCutoff_contDiff)
  exact hcompact.toSchwartzMap hu

/-- Evaluation of the fixed derivative cutoff. -/
theorem smoothingDerivativeCutoff_apply (N : ℕ) (ξ : ℝ) :
    smoothingDerivativeCutoff N ξ = (2 * Real.pi * Complex.I * ξ) ^ N *
      (smoothingPartitionCutoff ξ : ℂ) := rfl

/-- The derivative cutoff has compact support, as required for the uniform
multiplier estimate. -/
theorem smoothingDerivativeCutoff_compact (N : ℕ) :
    HasCompactSupport (smoothingDerivativeCutoff N : ℝ → ℂ) := by
  change HasCompactSupport (fun ξ : ℝ => (2 * Real.pi * Complex.I * ξ) ^ N *
    (smoothingPartitionCutoff ξ : ℂ))
  exact (smoothingPartitionCutoff_hasCompactSupport.comp_left (g := Complex.ofReal) rfl).mul_left

/-- The derivative constant depends only on the order N and the fixed cutoff. -/
noncomputable def smoothingDerivativeConstant (N : ℕ) : ℝ :=
  ∫ x : ℝ, ‖(𝓕 (smoothingDerivativeCutoff N)) x‖

/-- Extracting R^N from the derivative multiplier in Lemma 3.2(2). -/
theorem smoothingDerivativeCutoff_scale (N : ℕ) {R : ℝ} (hR : 0 < R) (ξ : ℝ) :
    (R ^ N : ℝ) • smoothingDerivativeCutoff N (ξ / R) =
      (2 * Real.pi * Complex.I * ξ) ^ N * (smoothingPartitionCutoff (ξ / R) : ℂ) := by
  rw [smoothingDerivativeCutoff_apply, Complex.real_smul, Complex.ofReal_pow, ← mul_assoc, ← mul_pow]
  congr 2
  push_cast
  field_simp [hR.ne']
/-- The derivative of h_n is R^N times a fixed scaled multiplier applied to
a modulation of f. This keeps the derivative constant independent of n and R. -/
theorem smoothingPiece_iteratedDeriv (f : Lp (α := ℝ) ℂ 2 volume)
    {R : ℝ} (hR : 0 < R) (n : ℤ) (N : ℕ) (x : ℝ) :
    iteratedDeriv N (smoothingPiece f R n) x =
      (R ^ N : ℝ) • (𝓕⁻ (fun ξ : ℝ => smoothingDerivativeCutoff N (ξ / R) *
        (𝓕 (smoothingModulationL2 ((n : ℝ) * R) f) : Lp (α := ℝ) ℂ 2 volume) ξ)) x := by
  have hgf : ∀ᵐ ξ ∂volume,
      (𝓕 (smoothingModulationL2 ((n : ℝ) * R) f) : Lp (α := ℝ) ℂ 2 volume) ξ =
        (𝓕 f : Lp (α := ℝ) ℂ 2 volume) (ξ - n * R) := by
    rw [smoothing_fourier_modulation]
    simpa only [sub_eq_add_neg] using! smoothingTranslationL2_coe (-((n : ℝ) * R)) (𝓕 f)
  rw [smoothingPiece, smoothing_iteratedDeriv_fourierInv
    (smoothingPieceSpectrum_memLp f R n).1 (smoothingPieceSpectrum_moments f hR n)]
  rw [Real.fourierInv_eq, Real.fourierInv_eq, ← integral_smul]
  apply integral_congr_ae
  filter_upwards [hgf] with ξ hξ
  rw [hξ, smoothingPieceSpectrum, ← mul_assoc, ← smoothingDerivativeCutoff_scale N hR ξ]
  simp only [Circle.smul_def, Complex.real_smul, smul_eq_mul]
  ring

/-- The uniform derivative inequality in Lemma 3.2(2). Every almost-everywhere
bound M for the input gives the stated bound C_N R^N M for all points x;
C_N depends only on N and the fixed cutoff. -/
theorem smoothingPiece_derivative_bound (f : Lp (α := ℝ) ℂ 2 volume)
    {R : ℝ} (hR : 0 < R) (n : ℤ) (N : ℕ) {M : ℝ}
    (hf : ∀ᵐ x ∂volume, ‖f x‖ ≤ M) (x : ℝ) :
    ‖iteratedDeriv N (smoothingPiece f R n) x‖ ≤
      smoothingDerivativeConstant N * R ^ N * M := by
  have hg : ∀ᵐ y ∂volume, ‖smoothingModulationL2 ((n : ℝ) * R) f y‖ ≤ M := by
    filter_upwards [smoothingModulationL2_coe ((n : ℝ) * R) f, hf] with y hy hfy
    simpa only [hy, Circle.norm_smul] using hfy
  have hb := smoothing_scaled_multiplier_bound (smoothingDerivativeCutoff N)
    (smoothingDerivativeCutoff_compact N) (smoothingModulationL2 ((n : ℝ) * R) f) hR hg x
  rw [smoothingPiece_iteratedDeriv f hR n N x, norm_smul, Real.norm_eq_abs,
    abs_of_nonneg (pow_nonneg hR.le N)]
  calc
    _ ≤ R ^ N * (M * smoothingDerivativeConstant N) :=
      mul_le_mul_of_nonneg_left hb (pow_nonneg hR.le N)
    _ = _ := by ring

#print axioms smoothingPiece_derivative_bound
/-- The final Fourier support inclusion in Lemma 3.2(2), expressed for L²
representatives: wherever the input Fourier transform vanishes, so does the sharp part. -/
theorem smoothingSharpPart_fourier_support (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (S : Finset ℤ) :
    ∀ᵐ ξ ∂volume, (𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ = 0 →
      (𝓕 (smoothingSharpPart f R S) : Lp (α := ℝ) ℂ 2 volume) ξ = 0 := by
  filter_upwards [smoothingSharpPart_fourier f R S] with ξ hξ
  intro hfξ
  rw [hξ, hfξ, mul_zero]

#print axioms smoothingSharpPart_fourier_support
/-- If every cutoff active at a frequency has been selected, the sharp multiplier
is one. This is the covering observation in Lemma 3.2's flat-energy argument. -/
theorem smoothingSharpMultiplier_eq_one (R ξ : ℝ) (S : Finset ℤ)
    (hcover : ∀ n : ℤ, smoothingPartitionCutoff (ξ / R + n) ≠ 0 → n ∈ S) :
    smoothingSharpMultiplier R S ξ = 1 := by
  have hsum := smoothingPartitionCutoff_partition (ξ / R)
  rw [tsum_eq_sum (s := S) (fun n hn => by
    by_contra h
    exact hn (hcover n h))] at hsum
  exact hsum

/-- The flat Fourier multiplier vanishes on any length-R interval whose input
mass meets the threshold in Lemma 3.2's selection. -/
theorem smoothingFlatPart_zero_on_high_interval (f : Lp (α := ℝ) ℂ 2 volume)
    (R ρ a : ℝ) (S : Finset ℤ)
    (hselect : ∀ n : ℤ, n ∈ S ↔ n ∈ smoothingHighMassIndices
      (fun ξ => ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) R ρ)
    (hm : ρ * (∫ ξ, ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) ≤
      ∫ ξ in Set.Icc a (a + R), ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) :
    ∀ᵐ ξ ∂volume.restrict (Set.Icc a (a + R)),
      (𝓕 (smoothingFlatPart f R S) : Lp (α := ℝ) ℂ 2 volume) ξ = 0 := by
  filter_upwards [ae_restrict_mem measurableSet_Icc,
    ae_restrict_of_ae (smoothingFlatPart_fourier f R S)] with ξ hξ hflat
  have hcover : ∀ n : ℤ, smoothingPartitionCutoff (ξ / R + n) ≠ 0 → n ∈ S := by
    intro n hn
    apply (hselect n).mpr
    exact ⟨a, ⟨ξ, hξ, hn⟩, hm⟩
  rw [hflat, smoothingSharpMultiplier_eq_one R ξ S hcover, Complex.ofReal_one, sub_self, zero_mul]

/-- Pointwise spectral domination of the flat part, used on the remaining
low-mass intervals in the proof of (3.25). -/
theorem smoothingFlatPart_fourier_norm_le (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (S : Finset ℤ) :
    ∀ᵐ ξ ∂volume,
      ‖(𝓕 (smoothingFlatPart f R S) : Lp (α := ℝ) ℂ 2 volume) ξ‖ ≤
      ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ := by
  filter_upwards [smoothingFlatPart_fourier f R S] with ξ hξ
  rw [hξ, norm_mul, ← Complex.ofReal_one, ← Complex.ofReal_sub, Complex.norm_real,
    Real.norm_eq_abs, abs_of_nonneg (sub_nonneg.mpr (smoothingSharpMultiplier_bounds R S ξ).2)]
  exact mul_le_of_le_one_left (norm_nonneg _) (by linarith [(smoothingSharpMultiplier_bounds R S ξ).1])

/-- Every length-R interval has small flat Fourier mass, as used in the final
contradiction proving Lemma 3.2(3). -/
theorem smoothingFlatPart_interval_mass (f : Lp (α := ℝ) ℂ 2 volume)
    (R a : ℝ) {ρ : ℝ} (hρ : 0 < ρ) (S : Finset ℤ)
    (hselect : ∀ n : ℤ, n ∈ S ↔ n ∈ smoothingHighMassIndices
      (fun ξ => ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) R ρ) :
    (∫ ξ in Set.Icc a (a + R),
      ‖(𝓕 (smoothingFlatPart f R S) : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) ≤
      ρ * (∫ ξ, ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) := by
  by_cases hm : ρ * (∫ ξ, ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) ≤
      ∫ ξ in Set.Icc a (a + R), ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2
  · have hz := smoothingFlatPart_zero_on_high_interval f R ρ a S hselect hm
    have hint : (∫ ξ in Set.Icc a (a + R),
        ‖(𝓕 (smoothingFlatPart f R S) : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) = 0 := by
      apply integral_eq_zero_of_ae
      filter_upwards [hz] with ξ hξ
      simp only [hξ, norm_zero, zero_pow (by decide : (2 : ℕ) ≠ 0), Pi.zero_apply]
    rw [hint]
    exact mul_nonneg hρ.le (integral_nonneg fun ξ => sq_nonneg _)
  · apply le_trans _ (not_le.mp hm).le
    have hg := (memLp_two_iff_integrable_sq_norm
      (Lp.memLp (𝓕 (smoothingFlatPart f R S))).1).mp (Lp.memLp (𝓕 (smoothingFlatPart f R S)))
    have hf := (memLp_two_iff_integrable_sq_norm (Lp.memLp (𝓕 f)).1).mp (Lp.memLp (𝓕 f))
    apply integral_mono_ae hg.integrableOn hf.integrableOn
    filter_upwards [ae_restrict_of_ae (smoothingFlatPart_fourier_norm_le f R S)] with ξ hξ
    exact pow_le_pow_left₀ (norm_nonneg _) hξ 2
set_option backward.isDefEq.respectTransparency false in
/-- A radius-R ball on the line is covered by two length-R intervals.
The overlap at their common endpoint causes no loss in this nonnegative estimate. -/
theorem smoothing_ball_integral_le_two_intervals {w : ℝ → ℝ}
    (hw : Integrable w volume) (hwpos : ∀ᵐ x ∂volume, 0 ≤ w x) (R c : ℝ) :
    (∫ x in Metric.closedBall c R, w x) ≤
      (∫ x in Set.Icc (c - R) c, w x) + ∫ x in Set.Icc c (c + R), w x := by
  rw [← integral_indicator measurableSet_closedBall,
    ← integral_indicator measurableSet_Icc, ← integral_indicator measurableSet_Icc,
    ← integral_add (hw.indicator measurableSet_Icc) (hw.indicator measurableSet_Icc)]
  apply integral_mono_ae (hw.indicator measurableSet_closedBall)
    ((hw.indicator measurableSet_Icc).add (hw.indicator measurableSet_Icc))
  filter_upwards [hwpos] with x hx
  classical
  simp only [Pi.add_apply]
  simp only [Set.indicator_apply]
  by_cases hb : x ∈ Metric.closedBall c R
  · have hdist : |x - c| ≤ R := by simpa only [Metric.mem_closedBall, Real.dist_eq] using hb
    have hbounds := abs_le.mp hdist
    by_cases hxc : x ≤ c
    · have hl : x ∈ Set.Icc (c - R) c := ⟨by linarith [hbounds.1], hxc⟩
      simp only [hb, hl, if_true]
      split_ifs <;> linarith
    · have hr : x ∈ Set.Icc c (c + R) := ⟨(not_le.mp hxc).le, by linarith [hbounds.2]⟩
      simp only [hb, hr, if_true]
      split_ifs <;> linarith
  · simp only [hb, if_false]
    split_ifs <;> linarith

/-- The flat Fourier mass in any radius-R ball is at most twice the source
interval threshold. This handles the radius versus interval-length conversion. -/
theorem smoothingFlatPart_ball_mass (f : Lp (α := ℝ) ℂ 2 volume)
    (R c : ℝ) {ρ : ℝ} (hρ : 0 < ρ) (S : Finset ℤ)
    (hselect : ∀ n : ℤ, n ∈ S ↔ n ∈ smoothingHighMassIndices
      (fun ξ => ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) R ρ) :
    (∫ ξ in Metric.closedBall c R,
      ‖(𝓕 (smoothingFlatPart f R S) : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) ≤
      2 * ρ * (∫ ξ, ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) := by
  have hg := (memLp_two_iff_integrable_sq_norm
    (Lp.memLp (𝓕 (smoothingFlatPart f R S))).1).mp (Lp.memLp (𝓕 (smoothingFlatPart f R S)))
  have hball := smoothing_ball_integral_le_two_intervals hg
    (Filter.Eventually.of_forall fun ξ => sq_nonneg _) R c
  have hleft := smoothingFlatPart_interval_mass f R (c - R) hρ S hselect
  have hright := smoothingFlatPart_interval_mass f R c hρ S hselect
  simp only [sub_add_cancel] at hleft
  linarith
/-- Equation (3.25) of Lemma 3.2(3), with uniform constant 2. The source's
high-mass interval contradiction is applied to the maximal-ball energy bound
proved in Lemma 3.1, avoiding an unnecessary second orthogonal projection. -/
theorem smoothingFlatPart_energy_bound (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) {ρ : ℝ} (hρ : 0 < ρ) (S : Finset ℤ)
    (hselect : f ≠ 0 → ∀ n : ℤ, n ∈ S ↔ n ∈ smoothingHighMassIndices
      (fun ξ => ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) R ρ) :
    (∫ s : ℝ, ∫ ξ in Metric.closedBall (0 : ℝ) R,
      ‖(𝓕 (smoothingMultiplicativeDifference (⇑(smoothingFlatPart f R S)) s) : ℝ → ℂ) ξ‖ ^ 2) ≤
      2 * ρ * ‖f‖ ^ 4 := by
  by_cases hfzero : f = 0
  · have hgzero : smoothingFlatPart f R S = 0 := by
      apply norm_eq_zero.mp
      exact le_antisymm (by simpa only [hfzero, norm_zero] using smoothingFlatPart_norm_le f R S)
        (norm_nonneg _)
    have he := smoothing_fourierDifference_energy_le_ball_mass (smoothingFlatPart f R S) R
    rw [hgzero] at he ⊢
    simpa only [hfzero, norm_zero, zero_pow (by decide : (2 : ℕ) ≠ 0),
      zero_pow (by decide : (4 : ℕ) ≠ 0), zero_mul, mul_zero] using he
  have hm : (∫ ξ, ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) = ‖f‖ ^ 2 := by
    have h := smoothing_frequencyRestriction_norm_sq (Lp.memLp (𝓕 f)) MeasurableSet.univ
    simpa only [Set.indicator_univ, Lp.toLp_coeFn, Measure.restrict_univ,
      Lp.norm_fourier_eq] using h.symm
  have hball (c : ℝ) : (∫ ξ in Metric.closedBall c R,
      ‖(𝓕 (smoothingFlatPart f R S) : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) ≤ 2 * ρ * ‖f‖ ^ 2 := by
    simpa only [hm] using smoothingFlatPart_ball_mass f R c hρ S (hselect hfzero)
  have hs : sSup (Set.range (fun c : ℝ => ∫ ξ in Metric.closedBall c R,
      ‖(𝓕 (smoothingFlatPart f R S) : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2)) ≤ 2 * ρ * ‖f‖ ^ 2 := by
    apply csSup_le (Set.range_nonempty _)
    rintro y ⟨c, rfl⟩
    exact hball c
  calc
    _ ≤ ‖smoothingFlatPart f R S‖ ^ 2 * sSup (Set.range (fun c : ℝ =>
        ∫ ξ in Metric.closedBall c R,
          ‖(𝓕 (smoothingFlatPart f R S) : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2)) :=
      smoothing_fourierDifference_energy_le_ball_mass (smoothingFlatPart f R S) R
    _ ≤ ‖smoothingFlatPart f R S‖ ^ 2 * (2 * ρ * ‖f‖ ^ 2) :=
      mul_le_mul_of_nonneg_left hs (sq_nonneg _)
    _ ≤ ‖f‖ ^ 2 * (2 * ρ * ‖f‖ ^ 2) :=
      mul_le_mul_of_nonneg_right
        (pow_le_pow_left₀ (norm_nonneg _) (smoothingFlatPart_norm_le f R S) 2) (by positivity)
    _ = _ := by ring

#print axioms smoothingFlatPart_energy_bound
/-- Lemma 3.2 of arXiv:2008.10140v2, with one common decomposition realizing
all three parts. The finite integer set S indexes the source's N terms, with
N ≤ 6/ρ; the norm and flat-energy constants are 2. The smooth pieces have
frequencies -2πnR, Fourier support in [-R,R], and individual L² norm at most ‖f‖.
The L∞ derivative estimate is expressed equivalently through every finite
essential bound M on f; its fixed constant depends only on the derivative order.
All support and reconstruction statements use the standard L² representative
interpretation, with explicit smooth representatives for the pieces. -/
theorem smoothing_lemma3_2 (f : Lp (α := ℝ) ℂ 2 volume)
    {R ρ : ℝ} (hR : 1 ≤ R) (hρ : ρ ∈ Set.Ioo (0 : ℝ) 1) :
    ∃ S : Finset ℤ,
      (S.card : ℝ) ≤ 6 / ρ ∧
      f = smoothingSharpPart f R S + smoothingFlatPart f R S ∧
      ‖smoothingSharpPart f R S‖ + ‖smoothingFlatPart f R S‖ ≤ 2 * ‖f‖ ∧
      (∀ n : ℤ, ContDiff ℝ ∞ (smoothingPiece f R n) ∧
        (⇑(smoothingPieceL2 f R n) =ᵐ[volume] smoothingPiece f R n) ∧
        ‖smoothingPieceL2 f R n‖ ≤ ‖f‖ ∧
        (∀ᵐ ξ ∂volume, ξ ∉ Set.Icc (-R) R →
          (𝓕 (smoothingPieceL2 f R n) : Lp (α := ℝ) ℂ 2 volume) ξ = 0)) ∧
      (∀ᵐ x ∂volume, smoothingSharpPart f R S x =
        ∑ n ∈ S, smoothingPiece f R n x *
          Complex.exp (Complex.I * ((-2 * Real.pi * (n : ℝ) * R * x : ℝ) : ℂ))) ∧
      (∀ (N : ℕ) (M : ℝ), (∀ᵐ x ∂volume, ‖f x‖ ≤ M) → ∀ (n : ℤ) (x : ℝ),
        ‖iteratedDeriv N (smoothingPiece f R n) x‖ ≤ smoothingDerivativeConstant N * R ^ N * M) ∧
      (∀ᵐ ξ ∂volume, (𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ = 0 →
        (𝓕 (smoothingSharpPart f R S) : Lp (α := ℝ) ℂ 2 volume) ξ = 0) ∧
      (∫ s : ℝ, ∫ ξ in Metric.closedBall (0 : ℝ) R,
        ‖(𝓕 (smoothingMultiplicativeDifference (⇑(smoothingFlatPart f R S)) s) : ℝ → ℂ) ξ‖ ^ 2) ≤
          2 * ρ * ‖f‖ ^ 4 := by
  have hRpos : 0 < R := lt_of_lt_of_le (by norm_num) hR
  obtain ⟨S, hcard, _, hselect⟩ := smoothing_select_highMass_indices f hRpos hρ.1
  refine ⟨S, hcard, smoothing_sharp_add_flat f R S, smoothing_lemma3_2_L2_bounds f R S,
    ?_, smoothingSharpPart_eq_sum_exp f hRpos S, ?_, smoothingSharpPart_fourier_support f R S,
    smoothingFlatPart_energy_bound f R hρ.1 S hselect⟩
  · intro n
    exact ⟨smoothingPiece_contDiff f hRpos n, smoothingPieceL2_coe f hRpos n,
      smoothingPieceL2_norm_le f R n, smoothingPieceL2_fourier_support f hRpos n⟩
  · intro N M hf n x
    exact smoothingPiece_derivative_bound f hRpos n N hf x

#print axioms smoothing_lemma3_2
/-- Spatial translation depending on the time coordinate. The opening change
of variables in Section 3.5 uses γ(t)=(-t,0); the fiber refinements use the parabola. -/
def smoothingFiberTranslation (γ : ℝ → ℝ × ℝ) (hγ : Continuous γ) :
    ((ℝ × ℝ) × ℝ) ≃ₜ ((ℝ × ℝ) × ℝ) where
  toFun p := (p.1 + γ p.2, p.2)
  invFun p := (p.1 - γ p.2, p.2)
  left_inv p := by simp
  right_inv p := by simp
  continuous_toFun := by fun_prop
  continuous_invFun := by fun_prop

/-- The source's fiber translations preserve three-dimensional Lebesgue measure. -/
theorem smoothingFiberTranslation_measurePreserving (γ : ℝ → ℝ × ℝ) (hγ : Continuous γ) :
    MeasurePreserving (smoothingFiberTranslation γ hγ)
      (volume : Measure ((ℝ × ℝ) × ℝ)) volume := by
  have hs : MeasurePreserving (fun p : ℝ × (ℝ × ℝ) => (p.1, p.2 + γ p.1))
      (volume.prod volume) (volume.prod volume) := by
    apply (MeasurePreserving.id (volume : Measure ℝ)).skew_product
      (g := fun t (z : ℝ × ℝ) => z + γ t) (by fun_prop)
    exact Filter.Eventually.of_forall fun t => (measurePreserving_add_right volume (γ t)).map_eq
  have ht := Measure.measurePreserving_swap.comp (hs.comp Measure.measurePreserving_swap)
  change MeasurePreserving (fun p : (ℝ × ℝ) × ℝ => (p.1 + γ p.2, p.2)) volume volume
  simpa only [Measure.volume_eq_prod, Function.comp_def, Prod.swap_prod_mk] using! ht

/-- The sublevel set on the left side of (3.40), before the Section 3.5 shear. -/
def smoothingSublevelSet (α β : ℝ × ℝ → ℝ) (K : Set ((ℝ × ℝ) × ℝ)) (ε : ℝ) :
    Set ((ℝ × ℝ) × ℝ) :=
  {p | p ∈ K ∧ |α (p.1.1 + p.2, p.1.2) - 2 * p.2 * β (p.1.1, p.1.2 + p.2 ^ 2)| ≤ ε}

/-- The shifted sublevel set E in (3.41). -/
def smoothingShiftedSublevelSet (α β : ℝ × ℝ → ℝ)
    (K : Set ((ℝ × ℝ) × ℝ)) (ε : ℝ) : Set ((ℝ × ℝ) × ℝ) :=
  {p | p ∈ K ∧ |α p.1 - 2 * p.2 * β (p.1 + (-p.2, p.2 ^ 2))| ≤ ε}

/-- Measurability of the source sublevel set for measurable coefficients. -/
theorem smoothingSublevelSet_measurable {α β : ℝ × ℝ → ℝ}
    (hα : Measurable α) (hβ : Measurable β) {K : Set ((ℝ × ℝ) × ℝ)}
    (hK : MeasurableSet K) (ε : ℝ) : MeasurableSet (smoothingSublevelSet α β K ε) := by
  have hm : Measurable (fun p : (ℝ × ℝ) × ℝ =>
      |α (p.1.1 + p.2, p.1.2) - 2 * p.2 * β (p.1.1, p.1.2 + p.2 ^ 2)|) := by fun_prop
  exact hK.inter (hm measurableSet_Iic)

/-- The set identity in the opening change of variables leading to (3.41). -/
theorem smoothing_sublevel_shear_preimage (α β : ℝ × ℝ → ℝ)
    (K : Set ((ℝ × ℝ) × ℝ)) (ε : ℝ) :
    (smoothingFiberTranslation (fun t => (-t, 0)) (by fun_prop)) ⁻¹'
      smoothingSublevelSet α β K ε =
    smoothingShiftedSublevelSet α β
      ((smoothingFiberTranslation (fun t => (-t, 0)) (by fun_prop)) ⁻¹' K) ε := by
  ext ⟨⟨x, y⟩, t⟩
  simp [smoothingFiberTranslation, smoothingSublevelSet, smoothingShiftedSublevelSet]
/-- The Section 3.5 change of variables preserves the measure of the sublevel
set, giving precisely the shifted expression (3.41). -/
theorem smoothing_sublevel_shear_measure {α β : ℝ × ℝ → ℝ}
    (hα : Measurable α) (hβ : Measurable β) {K : Set ((ℝ × ℝ) × ℝ)}
    (hK : MeasurableSet K) (ε : ℝ) :
    volume (smoothingShiftedSublevelSet α β
      ((smoothingFiberTranslation (fun t => (-t, 0)) (by fun_prop)) ⁻¹' K) ε) =
      volume (smoothingSublevelSet α β K ε) := by
  rw [← smoothing_sublevel_shear_preimage]
  exact (smoothingFiberTranslation_measurePreserving (fun t => (-t, 0)) (by fun_prop)).measure_preimage
    (smoothingSublevelSet_measurable hα hβ hK ε).nullMeasurableSet

/-- The shear in (3.41) preserves compactness and the positive time condition. -/
theorem smoothing_sublevel_shear_domain {K : Set ((ℝ × ℝ) × ℝ)}
    (hK : IsCompact K) (hpos : ∀ p ∈ K, 0 < p.2) :
    IsCompact ((smoothingFiberTranslation (fun t => (-t, 0)) (by fun_prop)) ⁻¹' K) ∧
    ∀ p ∈ (smoothingFiberTranslation (fun t => (-t, 0)) (by fun_prop)) ⁻¹' K, 0 < p.2 := by
  refine ⟨(Homeomorph.isCompact_preimage _).mpr hK, ?_⟩
  intro p hp
  exact hpos ((smoothingFiberTranslation (fun t => (-t, 0)) (by fun_prop)) p) hp

/-- The parabolic affine coordinates used in the normalization after (3.41). -/
def smoothingParabolicAffine (A : ℝ) (b : ℝ × ℝ) (p : (ℝ × ℝ) × ℝ) :
    (ℝ × ℝ) × ℝ := ((A * p.1.1 + b.1, A ^ 2 * p.1.2 + b.2), A * p.2)

/-- The normalization after (3.41) commutes with the parabolic spatial shift,
with the coefficient β multiplied by A. -/
theorem smoothing_sublevel_parabolic_preimage (α β : ℝ × ℝ → ℝ)
    (K : Set ((ℝ × ℝ) × ℝ)) (ε A : ℝ) (b : ℝ × ℝ) :
    smoothingParabolicAffine A b ⁻¹' smoothingShiftedSublevelSet α β K ε =
      smoothingShiftedSublevelSet
        (fun z => α (A * z.1 + b.1, A ^ 2 * z.2 + b.2))
        (fun z => A * β (A * z.1 + b.1, A ^ 2 * z.2 + b.2))
        (smoothingParabolicAffine A b ⁻¹' K) ε := by
  ext ⟨⟨x, y⟩, t⟩
  simp only [smoothingShiftedSublevelSet, smoothingParabolicAffine, Set.mem_preimage,
    Set.mem_setOf_eq, Prod.mk_add_mk]
  ring_nf

/-- Every compact positive-time domain fits inside the parabolic affine image
of the unit square times a positive interval of length one, as used after (3.41). -/
theorem smoothing_compact_parabolic_box {K : Set ((ℝ × ℝ) × ℝ)}
    (hK : IsCompact K) (hpos : ∀ p ∈ K, 0 < p.2) :
    ∃ (A : ℝ) (b : ℝ × ℝ) (a : ℝ), 0 < A ∧ 0 < a ∧
      K ⊆ smoothingParabolicAffine A b ''
        ((Set.Icc (0 : ℝ) 1 ×ˢ Set.Icc (0 : ℝ) 1) ×ˢ Set.Icc a (a + 1)) := by
  by_cases hne : K.Nonempty
  · obtain ⟨B, hB, hbound⟩ := hK.isBounded.exists_pos_norm_le
    obtain ⟨p₀, hp₀, hmin⟩ := hK.exists_isMinOn hne continuous_snd.continuousOn
    let A := 2 * (B + 1)
    have hA : 0 < A := by dsimp [A]; positivity
    have hBA : 2 * B ≤ A := by dsimp [A]; linarith
    have hBA2 : 2 * B ≤ A ^ 2 := by dsimp [A]; nlinarith
    refine ⟨A, (-B, -B), p₀.2 / A, hA, div_pos (hpos p₀ hp₀) hA, ?_⟩
    intro p hp
    have hn := hbound p hp
    have hx : |p.1.1| ≤ B := (norm_fst_le p.1).trans ((norm_fst_le p).trans hn)
    have hy : |p.1.2| ≤ B := (norm_snd_le p.1).trans ((norm_fst_le p).trans hn)
    have ht : p.2 ≤ B := (le_abs_self _).trans ((norm_snd_le p).trans hn)
    refine ⟨(((p.1.1 + B) / A, (p.1.2 + B) / A ^ 2), p.2 / A), ?_, ?_⟩
    · refine ⟨⟨⟨div_nonneg (by linarith [(abs_le.mp hx).1]) hA.le,
          (div_le_one hA).mpr (by linarith [(abs_le.mp hx).2])⟩,
        ⟨div_nonneg (by linarith [(abs_le.mp hy).1]) (sq_nonneg A),
          (div_le_one (sq_pos_of_pos hA)).mpr (by linarith [(abs_le.mp hy).2])⟩⟩,
        ⟨(div_le_div_iff_of_pos_right hA).mpr (hmin hp), ?_⟩⟩
      have : p.2 / A ≤ 1 := (div_le_one hA).mpr (by linarith)
      linarith [div_pos (hpos p₀ hp₀) hA]
    · dsimp [smoothingParabolicAffine]
      field_simp
      simp
  · refine ⟨1, 0, 1, by norm_num, by norm_num, ?_⟩
    simp only [Set.not_nonempty_iff_eq_empty.mp hne, Set.empty_subset]

/-- One-dimensional affine change of Lebesgue measure for the normalization
following (3.41). -/
theorem smoothing_affine_map_volume {A : ℝ} (hA : A ≠ 0) (b : ℝ) :
    Measure.map (fun x : ℝ => A * x + b) volume = ENNReal.ofReal |A⁻¹| • volume := by
  have heq : (fun x : ℝ => A * x + b) = (fun x => x + b) ∘ (fun x => A * x) := rfl
  rw [heq, ← Measure.map_map (by fun_prop) (by fun_prop), Real.map_volume_mul_left hA,
    Measure.map_smul, map_add_right_eq_self]

/-- The Jacobian of the normalization following (3.41) is A⁴. -/
theorem smoothing_parabolic_map_volume {A : ℝ} (hA : 0 < A) (b : ℝ × ℝ) :
    Measure.map (smoothingParabolicAffine A b) volume =
      ENNReal.ofReal (A⁻¹ ^ 4) • (volume : Measure ((ℝ × ℝ) × ℝ)) := by
  have heq : smoothingParabolicAffine A b =
      Prod.map (Prod.map (fun x : ℝ => A * x + b.1) (fun y : ℝ => A ^ 2 * y + b.2))
        (fun t : ℝ => A * t + 0) := by ext p <;> simp [smoothingParabolicAffine]
  rw [heq, Measure.volume_eq_prod, ← Measure.map_prod_map _ _ (by fun_prop) (by fun_prop),
    Measure.volume_eq_prod, ← Measure.map_prod_map _ _ (by fun_prop) (by fun_prop),
    smoothing_affine_map_volume hA.ne', smoothing_affine_map_volume (pow_ne_zero _ hA.ne'),
    smoothing_affine_map_volume hA.ne']
  simp only [Measure.prod_smul_left, Measure.prod_smul_right, smul_smul]
  simp only [inv_pow, abs_of_pos (inv_pos.mpr hA)]
  rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
  congr 2
  rw [abs_of_nonneg (inv_nonneg.mpr (sq_nonneg A))]
  ring

/-- Measurability of (3.41). -/
theorem smoothingShiftedSublevelSet_measurable {α β : ℝ × ℝ → ℝ}
    (hα : Measurable α) (hβ : Measurable β) {K : Set ((ℝ × ℝ) × ℝ)}
    (hK : MeasurableSet K) (ε : ℝ) : MeasurableSet (smoothingShiftedSublevelSet α β K ε) := by
  have hm : Measurable (fun p : (ℝ × ℝ) × ℝ =>
      |α p.1 - 2 * p.2 * β (p.1 + (-p.2, p.2 ^ 2))|) := by fun_prop
  exact hK.inter (hm measurableSet_Iic)

/-- The parabolic affine coordinates are injective when the scale is positive. -/
theorem smoothingParabolicAffine_injective {A : ℝ} (hA : 0 < A) (b : ℝ × ℝ) :
    Function.Injective (smoothingParabolicAffine A b) := by
  intro p q hpq
  have hx := congrArg (fun p : (ℝ × ℝ) × ℝ => p.1.1) hpq
  have hy := congrArg (fun p : (ℝ × ℝ) × ℝ => p.1.2) hpq
  have ht := congrArg (fun p : (ℝ × ℝ) × ℝ => p.2) hpq
  dsimp [smoothingParabolicAffine] at hx hy ht
  exact Prod.ext (Prod.ext (mul_left_cancel₀ hA.ne' (add_right_cancel hx))
    (mul_left_cancel₀ (pow_ne_zero 2 hA.ne') (add_right_cancel hy)))
    (mul_left_cancel₀ hA.ne' ht)

/-- The measure identity for the normalization following (3.41). -/
theorem smoothing_parabolic_preimage_volume {A : ℝ} (hA : 0 < A) (b : ℝ × ℝ)
    {S : Set ((ℝ × ℝ) × ℝ)} (hS : MeasurableSet S) :
    volume S = ENNReal.ofReal (A ^ 4) * volume (smoothingParabolicAffine A b ⁻¹' S) := by
  have hm : Measurable (smoothingParabolicAffine A b) := by
    unfold smoothingParabolicAffine
    fun_prop
  rw [← Measure.map_apply hm hS, smoothing_parabolic_map_volume hA b, Measure.smul_apply,
    smul_eq_mul, ← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
  have heq : A ^ 4 * A⁻¹ ^ 4 = 1 := by field_simp
  rw [heq, ENNReal.ofReal_one, one_mul]

/-- The normalization sentence following (3.41): a compact positive-time domain
reduces to the unit spatial square and a positive unit interval. The scale and
translation depend only on the domain, and the sublevel measure changes by A⁴. -/
theorem smoothing_sublevel_normalization {K : Set ((ℝ × ℝ) × ℝ)}
    (hK : IsCompact K) (hpos : ∀ p ∈ K, 0 < p.2) :
    ∃ (A : ℝ) (b : ℝ × ℝ) (a : ℝ), 0 < A ∧ 0 < a ∧
      ∀ (α β : ℝ × ℝ → ℝ), Measurable α → Measurable β → ∀ ε : ℝ,
        volume (smoothingShiftedSublevelSet α β K ε) ≤
          ENNReal.ofReal (A ^ 4) * volume (smoothingShiftedSublevelSet
            (fun z => α (A * z.1 + b.1, A ^ 2 * z.2 + b.2))
            (fun z => A * β (A * z.1 + b.1, A ^ 2 * z.2 + b.2))
            ((Set.Icc (0 : ℝ) 1 ×ˢ Set.Icc (0 : ℝ) 1) ×ˢ Set.Icc a (a + 1)) ε) := by
  obtain ⟨A, b, a, hA, ha, hbox⟩ := smoothing_compact_parabolic_box hK hpos
  refine ⟨A, b, a, hA, ha, ?_⟩
  intro α β hα hβ ε
  rw [smoothing_parabolic_preimage_volume hA b
    (smoothingShiftedSublevelSet_measurable hα hβ hK.measurableSet ε),
    smoothing_sublevel_parabolic_preimage]
  apply mul_le_mul_right
  apply measure_mono
  intro p hp
  refine ⟨?_, hp.2⟩
  obtain ⟨q, hq, heq⟩ := hbox hp.1
  exact (smoothingParabolicAffine_injective hA b heq) ▸ hq

/-- Section 3.5, the zero-measure case before the refinement claim: every
nonnegative power bound holds when the sublevel set has measure zero. -/
theorem smoothing_sublevel_zero_measure {α β : ℝ × ℝ → ℝ}
    {K : Set ((ℝ × ℝ) × ℝ)} {ε : ℝ}
    (hzero : volume (smoothingShiftedSublevelSet α β K ε) = 0) (C σ : ℝ) :
    volume (smoothingShiftedSublevelSet α β K ε) ≤ ENNReal.ofReal (C * ε ^ σ) := by
  rw [hzero]
  exact zero_le

/-- The source's first spatial refinement E₀′ in the proof of (3.43). -/
def smoothingFirstRefinement (E : Set ((ℝ × ℝ) × ℝ)) : Set (ℝ × ℝ) :=
  {z | volume E / 2 ≤ volume (Prod.mk z ⁻¹' E)}

/-- Measurability of the first spatial refinement in (3.43). -/
theorem smoothingFirstRefinement_measurable {E : Set ((ℝ × ℝ) × ℝ)}
    (hE : MeasurableSet E) : MeasurableSet (smoothingFirstRefinement E) :=
  measurableSet_le measurable_const (measurable_measure_prodMk_left hE)

/-- The fibers in (3.43) have measure at most one because the time interval
has length one. -/
theorem smoothing_fiber_measure_le_one {E : Set ((ℝ × ℝ) × ℝ)}
    {S : Set (ℝ × ℝ)} {I : Set ℝ} (hEI : E ⊆ S ×ˢ I) (hI : volume I = 1)
    (z : ℝ × ℝ) : volume (Prod.mk z ⁻¹' E) ≤ 1 := by
  rw [← hI]
  exact measure_mono (fun t ht => (hEI ht).2)

/-- The Fubini upper bound (3.43), before rearranging to bound |E₀′| below. -/
theorem smoothing_eq3_43_upper {E : Set ((ℝ × ℝ) × ℝ)} (hE : MeasurableSet E)
    {S : Set (ℝ × ℝ)} (hS : MeasurableSet S) (hSvol : volume S = 1)
    {I : Set ℝ} (hIvol : volume I = 1) (hbox : E ⊆ S ×ˢ I) :
    volume E ≤ volume (smoothingFirstRefinement E) + volume E / 2 := by
  let f : (ℝ × ℝ) → ENNReal := fun z => volume (Prod.mk z ⁻¹' E)
  have hH := smoothingFirstRefinement_measurable hE
  have htotal : volume E = ∫⁻ z, f z := by
    rw [Measure.volume_eq_prod, Measure.prod_apply hE]
  conv_lhs => rw [htotal, ← lintegral_add_compl f hH]
  apply add_le_add
  · calc
      ∫⁻ z in smoothingFirstRefinement E, f z ≤ ∫⁻ _z in smoothingFirstRefinement E, 1 :=
        lintegral_mono (smoothing_fiber_measure_le_one hbox hIvol)
      _ = volume (smoothingFirstRefinement E) := by simp
  · calc
      ∫⁻ z in (smoothingFirstRefinement E)ᶜ, f z ≤
          ∫⁻ z, S.indicator (fun _ => volume E / 2) z := by
        rw [← lintegral_indicator hH.compl]
        apply lintegral_mono
        intro z
        by_cases hz : z ∈ smoothingFirstRefinement E
        · simp [hz]
        · by_cases hzS : z ∈ S
          · simp only [Set.indicator_of_mem (Set.mem_compl hz), Set.indicator_of_mem hzS]
            exact le_of_lt (lt_of_not_ge hz)
          · have hf : f z = 0 := by
              have he : Prod.mk z ⁻¹' E = ∅ := by
                apply Set.eq_empty_iff_forall_notMem.mpr
                intro t ht
                exact hzS (hbox ht).1
              simp [f, he]
            simp [hz, hzS, hf]
      _ = volume E / 2 := by rw [lintegral_indicator hS]; simp [hSvol]

/-- Rearranging (3.43) gives |E₀′| ≥ |E|/2. -/
theorem smoothing_eq3_43 {E : Set ((ℝ × ℝ) × ℝ)} (hE : MeasurableSet E)
    {S : Set (ℝ × ℝ)} (hS : MeasurableSet S) (hSvol : volume S = 1)
    {I : Set ℝ} (hIvol : volume I = 1) (hbox : E ⊆ S ×ˢ I) :
    volume E / 2 ≤ volume (smoothingFirstRefinement E) := by
  have hupper := smoothing_eq3_43_upper hE hS hSvol hIvol hbox
  have hfin : volume E ≠ ⊤ := by
    apply ne_top_of_le_ne_top (by rw [Measure.volume_eq_prod, Measure.prod_prod, hSvol, hIvol]; simp :
      volume (S ×ˢ I) ≠ ⊤)
    exact measure_mono hbox
  have hhalf : volume E / 2 ≠ ⊤ := ENNReal.div_ne_top hfin (by norm_num)
  apply (ENNReal.add_le_add_iff_right hhalf).mp
  simpa only [ENNReal.add_halves] using hupper

/-- The first refined set E₁, defined immediately before (3.44). -/
def smoothingFirstRefinedSet (E : Set ((ℝ × ℝ) × ℝ)) : Set ((ℝ × ℝ) × ℝ) :=
  {p | p ∈ E ∧ p.1 ∈ smoothingFirstRefinement E}

/-- Measurability of E₁ in (3.44). -/
theorem smoothingFirstRefinedSet_measurable {E : Set ((ℝ × ℝ) × ℝ)}
    (hE : MeasurableSet E) : MeasurableSet (smoothingFirstRefinedSet E) :=
  hE.inter ((smoothingFirstRefinement_measurable hE).preimage measurable_fst)

/-- The Fubini identity in (3.44). -/
theorem smoothing_eq3_44_identity {E : Set ((ℝ × ℝ) × ℝ)} (hE : MeasurableSet E) :
    volume (smoothingFirstRefinedSet E) =
      ∫⁻ z in smoothingFirstRefinement E, volume (Prod.mk z ⁻¹' E) := by
  rw [Measure.volume_eq_prod, Measure.prod_apply (smoothingFirstRefinedSet_measurable hE),
    ← lintegral_indicator (smoothingFirstRefinement_measurable hE)]
  apply lintegral_congr
  intro z
  by_cases hz : z ∈ smoothingFirstRefinement E
  · simp [smoothingFirstRefinedSet, hz, Set.preimage]
  · simp [smoothingFirstRefinedSet, hz, Set.preimage]

/-- The first lower bound in (3.44), using the defining fiber threshold. -/
theorem smoothing_eq3_44_threshold {E : Set ((ℝ × ℝ) × ℝ)} (hE : MeasurableSet E) :
    volume E / 2 * volume (smoothingFirstRefinement E) ≤ volume (smoothingFirstRefinedSet E) := by
  rw [smoothing_eq3_44_identity hE]
  calc
    volume E / 2 * volume (smoothingFirstRefinement E) =
        ∫⁻ _z in smoothingFirstRefinement E, volume E / 2 := by simp
    _ ≤ ∫⁻ z in smoothingFirstRefinement E, volume (Prod.mk z ⁻¹' E) :=
      setLIntegral_mono' (smoothingFirstRefinement_measurable hE) (fun _ hz => hz)

/-- Equation (3.44): the first refined set has measure at least |E|²/4. -/
theorem smoothing_eq3_44 {E : Set ((ℝ × ℝ) × ℝ)} (hE : MeasurableSet E)
    {S : Set (ℝ × ℝ)} (hS : MeasurableSet S) (hSvol : volume S = 1)
    {I : Set ℝ} (hIvol : volume I = 1) (hbox : E ⊆ S ×ˢ I) :
    volume E ^ 2 / 4 ≤ volume (smoothingFirstRefinedSet E) := by
  calc
    volume E ^ 2 / 4 = (volume E / 2) * (volume E / 2) := by
      have hquarter : (4 : ENNReal)⁻¹ = (2 : ENNReal)⁻¹ ^ 2 := by
        rw [← ENNReal.inv_pow]
        norm_num
      simp only [div_eq_mul_inv, hquarter]
      ring
    _ ≤ (volume E / 2) * volume (smoothingFirstRefinement E) :=
      mul_le_mul_right (smoothing_eq3_43 hE hS hSvol hIvol hbox) _
    _ ≤ volume (smoothingFirstRefinedSet E) := smoothing_eq3_44_threshold hE

/- Source audit, Section 3.5 between (3.44) and (3.45).
The printed second refinement is false, as the diagnostic theorem below shows.
A proposed correction, awaiting scope clarification, is as follows. Write
γ(t)=(-t,t²), I=[a,a+1], S=[0,1]², and m=|E|. The beta projection of S×I lies
in D=[-a-1,1-a]×[a²,(a+1)²+1], of area M=4(a+1).
Keep the verified E₀′ and E₁. Define Hβ by the threshold |E₁|/(2M) for fibers
{t:(w-γ(t),t)∈E₁}. Define E₂={p∈E₁:p.z+γ(p.t)∈Hβ}. Fubini gives
