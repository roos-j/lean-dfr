/-- Fourier modulation covariance for arbitrary L² inputs, a prerequisite of
Lemma 3.1's first unnumbered display. -/
theorem smoothing_fourier_modulation
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (a : E) (f : Lp (α := E) ℂ 2 volume) :
    (𝓕 (smoothingModulationL2 a f) : Lp (α := E) ℂ 2 volume) =
      smoothingTranslationL2 (-a) (𝓕 f) := by
  let P := fun f : Lp (α := E) ℂ 2 volume =>
    (𝓕 (smoothingModulationL2 a f) : Lp (α := E) ℂ 2 volume) =
      smoothingTranslationL2 (-a) (𝓕 f)
  apply DenseRange.induction_on (p := P)
    (SchwartzMap.denseRange_toLpCLM (p := 2) ENNReal.ofNat_ne_top) f
  · exact isClosed_eq
      ((Lp.fourierTransformₗᵢ E ℂ).continuous.comp (smoothingModulationL2 a).continuous)
      ((smoothingTranslationL2 (-a)).continuous.comp (Lp.fourierTransformₗᵢ E ℂ).continuous)
  intro q
  change (𝓕 (smoothingModulationL2 a (q.toLp 2 volume)) : Lp (α := E) ℂ 2 volume) =
    smoothingTranslationL2 (-a) (𝓕 (q.toLp 2 volume))
  let m : E → ℂ := fun x => Real.fourierChar (inner ℝ a x) • q x
  have hm2 : MemLp m 2 volume := smoothing_memLp_modulation (q.memLp 2 volume) a
  have hm1 : Integrable m volume := by
    rw [← integrable_norm_iff hm2.1]
    simpa only [m, Circle.norm_smul] using q.integrable.norm
  have hm : smoothingModulationL2 a (q.toLp 2 volume) = hm2.toLp m := by
    apply Lp.ext
    filter_upwards [smoothingModulationL2_coe a (q.toLp 2 volume),
      q.coeFn_toLp 2 volume, hm2.coeFn_toLp] with x hmod hq hm
    simp only [hmod, hq, hm, m]
  rw [hm, SchwartzMap.toLp_fourier_eq]
  apply Lp.ext
  filter_upwards [smoothing_fourier_toLp_ae_eq hm1 hm2,
    smoothingTranslationL2_coe (-a) ((𝓕 q).toLp 2 volume),
    (measurePreserving_add_right volume (-a)).quasiMeasurePreserving.ae_eq
      ((𝓕 q).coeFn_toLp 2 volume)] with ξ hF ht hq
  simp only [Function.comp_apply] at hq
  rw [hF, ht, hq]
  simpa only [m, sub_eq_add_neg, SchwartzMap.fourier_coe, Function.comp_def] using
    smoothing_fourier_modulation_integral a (q : E → ℂ) ξ
/-- The first unnumbered display in the proof of Lemma 3.1 of
arXiv:2008.10140v2: the Fourier transform of a multiplicative difference is the
modulated correlation of the L² Fourier transform. Both inputs are arbitrary
L² functions; no integrability or smoothness restriction is added. -/
theorem smoothing_fourier_multiplicativeDifference
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (f : Lp (α := E) ℂ 2 volume) (s ξ : E) :
    (𝓕 (smoothingMultiplicativeDifference (⇑f) s) : E → ℂ) ξ =
      ∫ η, Real.fourierChar (inner ℝ s (ξ + η)) •
        ((𝓕 f : Lp (α := E) ℂ 2 volume) (ξ + η) *
          star ((𝓕 f : Lp (α := E) ℂ 2 volume) η)) := by
  have hphysical : (𝓕 (smoothingMultiplicativeDifference (⇑f) s) : E → ℂ) ξ =
      inner ℂ (smoothingModulationL2 ξ f) (smoothingTranslationL2 s f) := by
    rw [Real.fourier_eq, L2.inner_def]
    apply integral_congr_ae
    filter_upwards [smoothingModulationL2_coe ξ f, smoothingTranslationL2_coe s f] with x hm ht
    rw [hm, ht]
    have hchar : star (Real.fourierChar (inner ℝ ξ x) : ℂ) =
        (Real.fourierChar (-inner ℝ x ξ) : ℂ) := by
      rw [real_inner_comm x ξ, AddChar.map_neg_eq_inv, Circle.coe_inv_eq_conj]
      rfl
    simp only [smoothingMultiplicativeDifference, Circle.smul_def, smul_eq_mul,
      RCLike.inner_apply, starRingEnd_apply, star_mul, hchar]
    ring
  rw [hphysical, ← Lp.inner_fourier_eq, smoothing_fourier_modulation,
    smoothing_fourier_translation, L2.inner_def]
  calc
    _ = ∫ η, Real.fourierChar (inner ℝ s η) •
        ((𝓕 f : Lp (α := E) ℂ 2 volume) η *
          star ((𝓕 f : Lp (α := E) ℂ 2 volume) (η - ξ))) := by
      apply integral_congr_ae
      filter_upwards [smoothingModulationL2_coe s (𝓕 f),
        smoothingTranslationL2_coe (-ξ) (𝓕 f)] with η hm ht
      rw [hm, ht]
      simp only [RCLike.inner_apply, Circle.smul_def, smul_eq_mul, sub_eq_add_neg, starRingEnd_apply]
      ring
    _ = _ := by
      have hshift := integral_add_left_eq_self (μ := volume)
        (fun η => Real.fourierChar (inner ℝ s η) •
          ((𝓕 f : Lp (α := E) ℂ 2 volume) η *
            star ((𝓕 f : Lp (α := E) ℂ 2 volume) (η - ξ)))) ξ
      simpa only [add_sub_cancel_left] using hshift.symm

