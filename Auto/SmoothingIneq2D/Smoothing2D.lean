    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (f : Lp (α := E) ℂ 2 volume) (s ξ : E) :
    (𝓕 (smoothingMultiplicativeDifference (⇑f) s) : E → ℂ) ξ =
      ∫ η, Real.fourierChar (inner ℝ s (ξ + η)) •
        ((𝓕 f : Lp (α := E) ℂ 2 volume) (ξ + η) *
          star ((𝓕 f : Lp (α := E) ℂ 2 volume) η)) := by
  have hphysical : (𝓕 (smoothingMultiplicativeDifference (⇑f) s) : E → ℂ) ξ =
      inner ℂ (smoothingModulationL2 ξ f) (smoothingTranslationL2 s f) := by
    rw [Real.fourier_eq, L2.inner_def]
    apply integral_congr_ae
    filter_upwards [smoothingModulationL2_coe ξ f, smoothingTranslationL2_coe s f] with x hm ht
    rw [hm, ht]
