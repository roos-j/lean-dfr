  simpa only [Function.comp_def, innerₗ_apply_apply] using! hraw
/-- Fourier modulation formula for the literal integral, used in Lemma 3.1. -/
theorem smoothing_fourier_modulation_integral
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (a : E) (f : E → ℂ) (ξ : E) :
    (𝓕 (fun x => Real.fourierChar (inner ℝ a x) • f x) : E → ℂ) ξ =
      (𝓕 f : E → ℂ) (ξ - a) := by
