/-- Fourier translation covariance on L², used to justify the first unnumbered
Fourier identity in Lemma 3.1 for arbitrary L² functions. -/
theorem smoothing_fourier_translation
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (a : E) (f : Lp (α := E) ℂ 2 volume) :
    (𝓕 (smoothingTranslationL2 a f) : Lp (α := E) ℂ 2 volume) =
      smoothingModulationL2 a (𝓕 f) := by
