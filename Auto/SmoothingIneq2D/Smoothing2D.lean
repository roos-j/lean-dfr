/-- The multiplicative difference used in Section 3.2, Lemma 3.1 of
arXiv:2008.10140v2. This is a product with a translated function, not a derivative. -/
def smoothingMultiplicativeDifference {E : Type*} [Add E]
    (f : E → ℂ) (s : E) : E → ℂ :=
  fun x => f (x + s) * star (f x)

/-- L² inputs have integrable multiplicative differences, so their Fourier
integrals in Lemma 3.1 are defined by convergent integrals. -/
theorem integrable_smoothingMultiplicativeDifference
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    {f : E → ℂ} (hf : MemLp f 2 volume) (s : E) :
    Integrable (smoothingMultiplicativeDifference f s) volume := by
  have ht : MemLp (fun x => f (x + s)) 2 volume :=
    hf.comp_measurePreserving (measurePreserving_add_right volume s)
  exact ht.integrable_mul hf.star

