    (SchwartzMap.denseRange_toLpCLM (p := 2) ENNReal.ofNat_ne_top) f
  · exact isClosed_eq
      ((Lp.fourierTransformₗᵢ E ℂ).continuous.comp (smoothingTranslationL2 a).continuous)
      ((smoothingModulationL2 a).continuous.comp (Lp.fourierTransformₗᵢ E ℂ).continuous)
