/-- The multiplicative difference used in Section 3.2, Lemma 3.1 of
arXiv:2008.10140v2. This is a product with a translated function, not a derivative. -/
def smoothingMultiplicativeDifference {E : Type*} [Add E]
    (f : E → ℂ) (s : E) : E → ℂ :=
  fun x => f (x + s) * star (f x)

/-- L² inputs have integrable multiplicative differences, so their Fourier
integrals in Lemma 3.1 are defined by convergent integrals. -/
theorem integrable_smoothingMultiplicativeDifference
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    {f : E → ℂ} (hf : MemLp f 2 volume) (s : E) :
    Integrable (smoothingMultiplicativeDifference f s) volume := by
  have ht : MemLp (fun x => f (x + s)) 2 volume :=
    hf.comp_measurePreserving (measurePreserving_add_right volume s)
  exact ht.integrable_mul hf.star

/-- The energy of the restricted L² vector equals the mass of its frequency
window, as used in the concluding norm bound of Lemma 3.1. -/
theorem smoothing_frequencyRestriction_norm_sq
    {E : Type*} [MeasurableSpace E] {μ : Measure E}
    {f : E → ℂ} (hf : MemLp f 2 μ) {s : Set E} (hs : MeasurableSet s) :
    ‖(hf.indicator hs).toLp (s.indicator f)‖ ^ 2 = ∫ x in s, ‖f x‖ ^ 2 ∂μ := by
  let G := (hf.indicator hs).toLp (s.indicator f)
  have hG : ⇑G =ᵐ[μ] s.indicator f := (hf.indicator hs).coeFn_toLp
  change ‖G‖ ^ 2 = _
  rw [@norm_sq_eq_re_inner ℂ, L2.inner_def, ← integral_re (L2.integrable_inner G G),
    ← integral_indicator hs]
  apply integral_congr_ae
  filter_upwards [hG] with x hx
  rw [hx]
  by_cases hxs : x ∈ s <;> simp [hxs, ← Complex.ofReal_pow]

/-- Compatibility of the L² Fourier isometry with the convergent Fourier
integral on L¹ ∩ L², needed to interpret the energy identity of Lemma 3.1. -/
theorem smoothing_fourier_toLp_ae_eq
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    {f : E → ℂ} (hf1 : Integrable f volume) (hf2 : MemLp f 2 volume) :
    (⇑(𝓕 (hf2.toLp f) : Lp (α := E) ℂ 2 volume)) =ᵐ[volume] (𝓕 f : E → ℂ) := by
  let H : Lp (α := E) ℂ 2 volume := 𝓕 (hf2.toLp f)
  have hcont : Continuous (𝓕 f : E → ℂ) :=
    VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar continuous_inner hf1
  apply ae_eq_of_integral_contDiff_smul_eq
    ((Lp.memLp H).locallyIntegrable (by norm_num)) hcont.locallyIntegrable
  intro q hqs hqc
  have hqc' : HasCompactSupport (Complex.ofRealCLM ∘ q) := hqc.comp_left rfl
  have hqs' : ContDiff ℝ ∞ (Complex.ofRealCLM ∘ q) := by fun_prop
  let Q : SchwartzMap E ℂ := hqc'.toSchwartzMap hqs'
  have hdist := congrArg (fun T : TemperedDistribution E ℂ => T Q)
    (Lp.fourier_toTemperedDistribution_eq (hf2.toLp f))
  simp only [TemperedDistribution.fourier_apply, Lp.toTemperedDistribution_apply] at hdist
  have hflip := VectorFourier.integral_fourierIntegral_smul_eq_flip
    (μ := volume) (ν := volume) (L := innerₗ E)
      Real.continuous_fourierChar continuous_inner Q.integrable hf1
  have hfirst : (∫ x, (𝓕 Q) x • (hf2.toLp f) x) = ∫ x, (𝓕 Q) x • f x := by
    apply integral_congr_ae
    filter_upwards [hf2.coeFn_toLp] with x hx
    rw [hx]
  rw [hfirst] at hdist
  have hflip' : (∫ x, (𝓕 Q) x • f x) = ∫ x, Q x • (𝓕 f : E → ℂ) x := by
    simpa only [SchwartzMap.fourier_coe, flip_innerₗ] using! hflip
  rw [hflip'] at hdist
  simpa [Q, H, Complex.real_smul] using hdist.symm

/-- Plancherel for the convergent Fourier integral of an L¹ ∩ L² function.
This bridges the raw Fourier integrals in Lemma 3.1 to the L² isometry. -/
theorem smoothing_integral_norm_sq_fourier
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    {f : E → ℂ} (hf1 : Integrable f volume) (hf2 : MemLp f 2 volume) :
    (∫ ξ, ‖(𝓕 f : E → ℂ) ξ‖ ^ 2) = ∫ x, ‖f x‖ ^ 2 := by
  have hcompat := smoothing_fourier_toLp_ae_eq hf1 hf2
  have hF := smoothing_frequencyRestriction_norm_sq
    (Lp.memLp (𝓕 (hf2.toLp f) : Lp (α := E) ℂ 2 volume)) MeasurableSet.univ
  have hf := smoothing_frequencyRestriction_norm_sq hf2 MeasurableSet.univ
  simp only [Set.indicator_univ, Lp.toLp_coeFn, Measure.restrict_univ] at hF hf
  rw [Lp.norm_fourier_eq, hf] at hF
  calc
    _ = ∫ ξ, ‖(𝓕 (hf2.toLp f) : Lp (α := E) ℂ 2 volume) ξ‖ ^ 2 := by
      apply integral_congr_ae
      filter_upwards [hcompat] with ξ hξ
      rw [hξ]
    _ = _ := hF.symm

/-- Multiplication by the Fourier character preserves L²; used in the first
unnumbered display of the proof of Lemma 3.1. -/
